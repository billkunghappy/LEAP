    have hXn : X ^ (n - 1) * X = X ^ n := by
      rw [← pow_succ, Nat.sub_add_cancel hn]
    calc C₀ * (Real.log X ^ A) ^ 2 * X ^ (n - 1) * Real.log (Real.log X ^ A)
        ≤ C₀ * ((A : ℝ) + 1) * (Real.log X) ^ (2 * A + 1) * X ^ (n - 1) := h_lhs1
      _ ≤ C₀ * ((A : ℝ) + 1) * ((4 * (A : ℝ) + 2) ^ (2 * A + 1) * (X * Real.exp (-Real.log X / 2))) * X ^ (n - 1) := by
          apply mul_le_mul_of_nonneg_right
          · apply mul_le_mul_of_nonneg_left hpow_exp
            positivity
          · positivity
      _ = C₀ * ((A : ℝ) + 1) * (4 * (A : ℝ) + 2) ^ (2 * A + 1) * (X ^ (n - 1) * X) * Real.exp (-Real.log X / 2) := by ring
      _ = C₀ * ((A : ℝ) + 1) * (4 * (A : ℝ) + 2) ^ (2 * A + 1) * X ^ n * Real.exp (-Real.log X / 2) := by rw [hXn]
      _ ≤ c₂ * X ^ n * Real.exp (-Real.sqrt (Real.log X) / c₂) := by
          apply mul_le_mul
          · exact mul_le_mul_of_nonneg_right hc₂_ge_const (by positivity)
          · exact hexp_c2
          · positivity
          · positivity
  
  obtain ⟨c₂, hc₂_pos, hc₂⟩ := h_s4
  refine ⟨c₂, hc₂_pos, ?_⟩
  intro X hX C _ _ hC_bdd q hq hq_norm
  obtain ⟨hq_one, hq_le⟩ := h_s1 q hq
  have hq_one_r : (1 : ℝ) ≤ (Ideal.absNorm q : ℝ) := by exact_mod_cast hq_one
  have hY_gt : 1 < Real.log X ^ A := lt_of_le_of_lt hq_one_r hq_norm
  have hY : 1 ≤ Real.log X ^ A := le_of_lt hY_gt
  have hU_bound : ∀ π : NumberField.RingOfIntegers K, Prime π →
      NumberField.mixedEmbedding K (π : K) ∈ C → ¬ IsUnit (Ideal.Quotient.mk q π) →
      ((Algebra.norm ℤ π).natAbs : ℝ) < Real.log X ^ A := by
    intro π hπ _ hnu
    have hle_nat := hq_le π hπ hnu
    have hle_r : ((Algebra.norm ℤ π).natAbs : ℝ) ≤ (Ideal.absNorm q : ℝ) := by
      exact_mod_cast hle_nat
    exact lt_of_le_of_lt hle_r hq_norm
  have h_diff_le := h_s2 X (Real.log X ^ A) hX hY C hC_bdd
    (fun π => IsUnit (Ideal.Quotient.mk q π)) hU_bound
  have h_card_le := hC₀ X (Real.log X ^ A) hX hY
  have h_mid_le : (Nat.card {x : NumberField.RingOfIntegers K //
      (∀ w : NumberField.InfinitePlace K, w (x : K) < X) ∧
      ((Algebra.norm ℤ x).natAbs : ℝ) < Real.log X ^ A} : ℝ) * Real.log (Real.log X ^ A) ≤
      C₀ * (Real.log X ^ A) ^ 2 * X ^ (Module.finrank ℚ K - 1) * Real.log (Real.log X ^ A) :=
    mul_le_mul_of_nonneg_right h_card_le (Real.log_nonneg hY)
  exact le_trans h_diff_le (le_trans h_mid_le (hc₂ X hX hY_gt))

theorem mitsui_prime_grid_cube_to_ge_one_le {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (m : ℕ) (hm : 1 ≤ m)
    (k : NumberField.mixedEmbedding.index K → Fin (2 * m))
    (hQ_bdd : ∀ z : NumberField.mixedEmbedding.mixedSpace K,
        (∀ i : NumberField.mixedEmbedding.index K,
          (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
            Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) →
        ∀ w : NumberField.InfinitePlace K,
          NumberField.mixedEmbedding.normAtPlace w z < X) :
    |(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          ∀ i : NumberField.mixedEmbedding.index K,
            (NumberField.mixedEmbedding.stdBasis K).repr
                (NumberField.mixedEmbedding K (π : K)) i ∈
              Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      - (∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧
            (∀ i : NumberField.mixedEmbedding.index K,
              (NumberField.mixedEmbedding.stdBasis K).repr
                  (NumberField.mixedEmbedding K (π : K)) i ∈
                Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
            ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K)},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))|
    ≤ |(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      - (∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))| :=
by
  classical
  let B_X : Set K := {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}
  have hB_fin : B_X.Finite := NumberField.Embeddings.finite_of_norm_le K ℂ X
  let S_box : Set (NumberField.RingOfIntegers K) :=
    {x : NumberField.RingOfIntegers K | ∀ w : NumberField.InfinitePlace K, w (x : K) < X}
  have hpre_fin : (algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X).Finite :=
    hB_fin.preimage NumberField.RingOfIntegers.coe_injective.injOn
  have hS_sub : S_box ⊆ algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X := by
    intro x hx
    refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, ?_⟩
    intro φ
    let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
    have hw1 : w (x : K) = ‖φ (x : K)‖ := NumberField.InfinitePlace.apply φ (x : K)
    have hlt : w (x : K) < X := hx w
    change ‖φ (x : K)‖ ≤ X
    linarith
  have hS_fin : S_box.Finite := hpre_fin.subset hS_sub
  let F : Finset (NumberField.RingOfIntegers K) := hS_fin.toFinset
  have hF_mem : ∀ x : NumberField.RingOfIntegers K,
      x ∈ F ↔ ∀ w : NumberField.InfinitePlace K, w (x : K) < X :=
    fun x => hS_fin.mem_toFinset
  let P_cube : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ i : NumberField.mixedEmbedding.index K,
      (NumberField.mixedEmbedding.stdBasis K).repr
          (NumberField.mixedEmbedding K (π : K)) i ∈
        Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
          ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))
  have h_cube_lt : ∀ x : NumberField.RingOfIntegers K,
      P_cube x → ∀ w : NumberField.InfinitePlace K, w (x : K) < X := by
    intro x hx w
    rw [← NumberField.mixedEmbedding.normAtPlace_apply w (x : K)]
    exact hQ_bdd (NumberField.mixedEmbedding K (x : K)) hx w
  let w_real : NumberField.RingOfIntegers K → ℝ :=
    fun π => Real.log ((Algebra.norm ℤ π).natAbs : ℝ)
  have h_nonneg : ∀ π : NumberField.RingOfIntegers K, 0 ≤ w_real π :=
    fun _ => Real.log_natCast_nonneg _
  let P_ge : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K)
  have h_lhs_diff :
      (∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ P_cube π}, w_real π.1)
      - (∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ P_cube π ∧ P_ge π}, w_real π.1)
      = ∑ π ∈ (F.filter (fun π => Prime π ∧ P_cube π)).filter (fun π => ¬ P_ge π), w_real π := by
    have h_iff_lhs1 : ∀ π : NumberField.RingOfIntegers K,
        (Prime π ∧ P_cube π) ↔
          π ∈ F.filter (fun π => Prime π ∧ P_cube π) := by
      intro π
      simp only [Finset.mem_filter, hF_mem]
      exact ⟨fun h => ⟨h_cube_lt π h.2, h⟩, fun h => h.2⟩
    let e_lhs1 : {π : NumberField.RingOfIntegers K // Prime π ∧ P_cube π} ≃
        {π : NumberField.RingOfIntegers K // π ∈ F.filter (fun π => Prime π ∧ P_cube π)} :=
      Equiv.subtypeEquivRight h_iff_lhs1
    have h_tsum_lhs1 :
        (∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ P_cube π}, w_real π.1)
        = ∑ π ∈ F.filter (fun π => Prime π ∧ P_cube π), w_real π := by
      rw [← Equiv.tsum_eq e_lhs1.symm (fun π => w_real π.1)]
      exact Finset.tsum_subtype (F.filter (fun π => Prime π ∧ P_cube π)) w_real
    have h_iff_lhs2 : ∀ π : NumberField.RingOfIntegers K,
        (Prime π ∧ P_cube π ∧ P_ge π) ↔
          π ∈ (F.filter (fun π => Prime π ∧ P_cube π)).filter P_ge := by
      intro π
      simp only [Finset.mem_filter, hF_mem]
      exact ⟨fun h => ⟨⟨h_cube_lt π h.2.1, h.1, h.2.1⟩, h.2.2⟩,
             fun h => ⟨h.1.2.1, h.1.2.2, h.2⟩⟩
    let e_lhs2 : {π : NumberField.RingOfIntegers K // Prime π ∧ P_cube π ∧ P_ge π} ≃
        {π : NumberField.RingOfIntegers K // π ∈ (F.filter (fun π => Prime π ∧ P_cube π)).filter P_ge} :=
      Equiv.subtypeEquivRight h_iff_lhs2
    have h_tsum_lhs2 :
        (∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ P_cube π ∧ P_ge π}, w_real π.1)
        = ∑ π ∈ (F.filter (fun π => Prime π ∧ P_cube π)).filter P_ge, w_real π := by
      rw [← Equiv.tsum_eq e_lhs2.symm (fun π => w_real π.1)]
      exact Finset.tsum_subtype ((F.filter (fun π => Prime π ∧ P_cube π)).filter P_ge) w_real
    have h_split_lhs :
        ∑ π ∈ (F.filter (fun π => Prime π ∧ P_cube π)).filter P_ge, w_real π +
        ∑ π ∈ (F.filter (fun π => Prime π ∧ P_cube π)).filter (fun π => ¬ P_ge π), w_real π =
        ∑ π ∈ F.filter (fun π => Prime π ∧ P_cube π), w_real π :=
      Finset.sum_filter_add_sum_filter_not (F.filter (fun π => Prime π ∧ P_cube π)) P_ge w_real
    rw [h_tsum_lhs1, h_tsum_lhs2, ← h_split_lhs]
    ring
  have h_lhs_abs :
      |(∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ P_cube π}, w_real π.1)
        - (∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ P_cube π ∧ P_ge π}, w_real π.1)|
      = ∑ π ∈ (F.filter (fun π => Prime π ∧ P_cube π)).filter (fun π => ¬ P_ge π), w_real π := by
    rw [h_lhs_diff]
    exact abs_of_nonneg (Finset.sum_nonneg (fun π _ => h_nonneg π))
  have h_rhs_diff :
      (∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
          w_real π.1)
      - (∑' π : {π : NumberField.RingOfIntegers K //
              Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X},
            w_real π.1)
      = ∑ π ∈ (F.filter Prime).filter (fun π => ¬ P_ge π), w_real π := by
    have h_iff1 : ∀ π : NumberField.RingOfIntegers K,
        (Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X) ↔
          π ∈ F.filter Prime := by
      intro π
      simp only [Finset.mem_filter, hF_mem]
      tauto
    let e₁ : {π : NumberField.RingOfIntegers K //
        Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X} ≃
        {π : NumberField.RingOfIntegers K // π ∈ F.filter Prime} :=
      Equiv.subtypeEquivRight h_iff1
    have h_tsum1 :
        (∑' π : {π : NumberField.RingOfIntegers K //
              Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
            w_real π.1)
        = ∑ π ∈ F.filter Prime, w_real π := by
      rw [← Equiv.tsum_eq e₁.symm (fun π => w_real π.1)]
      exact Finset.tsum_subtype (F.filter Prime) w_real
    have h_iff2 : ∀ π : NumberField.RingOfIntegers K,
        (Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X) ↔
          π ∈ (F.filter Prime).filter P_ge := by
      intro π
      simp only [Finset.mem_filter, hF_mem, P_ge, forall_and]
      tauto
    let e₂ : {π : NumberField.RingOfIntegers K //
        Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X} ≃
        {π : NumberField.RingOfIntegers K // π ∈ (F.filter Prime).filter P_ge} :=
      Equiv.subtypeEquivRight h_iff2
    have h_tsum2 :
        (∑' π : {π : NumberField.RingOfIntegers K //
              Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X},
            w_real π.1)
        = ∑ π ∈ (F.filter Prime).filter P_ge, w_real π := by
      rw [← Equiv.tsum_eq e₂.symm (fun π => w_real π.1)]
      exact Finset.tsum_subtype ((F.filter Prime).filter P_ge) w_real
    have h_split :
        ∑ π ∈ (F.filter Prime).filter P_ge, w_real π +
        ∑ π ∈ (F.filter Prime).filter (fun π => ¬ P_ge π), w_real π =
        ∑ π ∈ F.filter Prime, w_real π :=
      Finset.sum_filter_add_sum_filter_not (F.filter Prime) P_ge w_real
    rw [h_tsum1, h_tsum2, ← h_split]
    ring
  rw [h_lhs_abs]
  refine le_trans ?_ (le_abs_self _)
  rw [h_rhs_diff]
  refine Finset.sum_le_sum_of_subset_of_nonneg ?_ (fun π _ _ => h_nonneg π)
  intro π hπ
  simp only [Finset.mem_filter] at hπ ⊢
  exact ⟨⟨hπ.1.1, hπ.1.2.1⟩, hπ.2⟩

theorem mitsui_prime_grid_cube_ge_one_to_place_sectors_le {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (m : ℕ) (hm : 1 ≤ m)
    (k : NumberField.mixedEmbedding.index K → Fin (2 * m))
    (hQ_bdd : ∀ z : NumberField.mixedEmbedding.mixedSpace K,
        (∀ i : NumberField.mixedEmbedding.index K,
          (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
            Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) →
        ∀ w : NumberField.InfinitePlace K,
          NumberField.mixedEmbedding.normAtPlace w z < X) :
    |(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          (∀ i : NumberField.mixedEmbedding.index K,
            (NumberField.mixedEmbedding.stdBasis K).repr
                (NumberField.mixedEmbedding K (π : K)) i ∈
              Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
          ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K)},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      - (∑ w₀ : NumberField.InfinitePlace K,
          ∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧
                (∀ i : NumberField.mixedEmbedding.index K,
                  (NumberField.mixedEmbedding.stdBasis K).repr
                      (NumberField.mixedEmbedding K (π : K)) i ∈
                    Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                      ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
                ∀ w : NumberField.InfinitePlace K,
                  1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))|
    ≤ |(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      - (∑ w₀ : NumberField.InfinitePlace K,
          ∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧
                (∀ w : NumberField.InfinitePlace K,
                  1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
                w₀ (π : K) < X},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))| :=
by
  classical
  let L : NumberField.RingOfIntegers K → ℝ :=
    fun π => Real.log ((Algebra.norm ℤ π).natAbs : ℝ)
  have hL_nonneg : ∀ π : NumberField.RingOfIntegers K, 0 ≤ L π :=
    fun _ => Real.log_natCast_nonneg _
  let P_cube : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ i : NumberField.mixedEmbedding.index K,
      (NumberField.mixedEmbedding.stdBasis K).repr
          (NumberField.mixedEmbedding K (π : K)) i ∈
        Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
          ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))
  have h_cube_lt : ∀ x : NumberField.RingOfIntegers K,
      P_cube x → ∀ w : NumberField.InfinitePlace K, w (x : K) < X := by
    intro x hx w
    rw [← NumberField.mixedEmbedding.normAtPlace_apply w (x : K)]
    exact hQ_bdd (NumberField.mixedEmbedding K (x : K)) hx w
  let P_box : NumberField.RingOfIntegers K → Prop :=
    fun π => Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X
  let P_max : NumberField.InfinitePlace K → NumberField.RingOfIntegers K → Prop :=
    fun w₀ π => ∀ w : NumberField.InfinitePlace K, w (π : K) ≤ w₀ (π : K)
  let B_X : Set K := {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}
  have hB_fin : B_X.Finite := NumberField.Embeddings.finite_of_norm_le K ℂ X
  have hpre_fin : (algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X).Finite :=
    hB_fin.preimage NumberField.RingOfIntegers.coe_injective.injOn
  have hS_sub : {π : NumberField.RingOfIntegers K | P_box π} ⊆
      algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X := by
    intro π hπ
    refine ⟨NumberField.RingOfIntegers.isIntegral_coe π, ?_⟩
    intro φ
    let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
    have hw1 : w (π : K) = ‖φ (π : K)‖ := NumberField.InfinitePlace.apply φ (π : K)
    have hlt : w (π : K) < X := (hπ.2 w).2
    change ‖φ (π : K)‖ ≤ X
    linarith
  have hS_fin : {π : NumberField.RingOfIntegers K | P_box π}.Finite :=
    hpre_fin.subset hS_sub
  let S_uncond := {π : NumberField.RingOfIntegers K //
    Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X}
  letI : Fintype S_uncond := hS_fin.fintype
  let S_cube := {π : NumberField.RingOfIntegers K //
    Prime π ∧
    P_cube π ∧
    ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K)}
  have hScube_fin : {π : NumberField.RingOfIntegers K |
      Prime π ∧
      P_cube π ∧
      ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K)}.Finite :=
    hS_fin.subset (fun x hπ => ⟨hπ.1, fun w => ⟨hπ.2.2 w, h_cube_lt x hπ.2.1 w⟩⟩)
  letI : Fintype S_cube := hScube_fin.fintype
  let M : NumberField.RingOfIntegers K → Finset (NumberField.InfinitePlace K) :=
    fun π => Finset.univ.filter (fun w₀ : NumberField.InfinitePlace K => P_max w₀ π)
  have hM_ge_one : ∀ π : NumberField.RingOfIntegers K, 1 ≤ (M π).card := by
    intro π
    obtain ⟨w₀, _, hw₀⟩ := Finset.exists_max_image Finset.univ
      (fun w : NumberField.InfinitePlace K => w (π : K)) Finset.univ_nonempty
    have hw₀_mem : w₀ ∈ M π := by
      rw [Finset.mem_filter]
      exact ⟨Finset.mem_univ w₀, fun w => hw₀ w (Finset.mem_univ w)⟩
    exact Finset.card_pos.mpr ⟨w₀, hw₀_mem⟩
  have hM_sub_nonneg : ∀ π : NumberField.RingOfIntegers K, 0 ≤ ((M π).card : ℝ) - 1 := by
    intro π
    have h1 : (1 : ℝ) ≤ ((M π).card : ℝ) := by exact_mod_cast hM_ge_one π
    linarith
  have h_lhs1 : (∑' π : S_cube, L π.1) = ∑ x : S_cube, L x.1 :=
    tsum_fintype (fun x : S_cube => L x.1)
  let S_sec_cube (w₀ : NumberField.InfinitePlace K) :=
    {π : NumberField.RingOfIntegers K //
      Prime π ∧
      P_cube π ∧
      ∀ w : NumberField.InfinitePlace K,
        1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)}
  let e_sec_cube (w₀ : NumberField.InfinitePlace K) :
      S_sec_cube w₀ ≃ {x : S_cube // P_max w₀ x.1} :=
    { toFun := fun π =>
        ⟨⟨π.1, π.2.1, π.2.2.1, fun w => (π.2.2.2 w).1⟩,
         fun w => (π.2.2.2 w).2⟩
      invFun := fun x =>
        ⟨x.1.1, x.1.2.1, x.1.2.2.1, fun w => ⟨x.1.2.2.2 w, x.2 w⟩⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun x => by ext; rfl }
  have h_lhs_sec : ∀ w₀ : NumberField.InfinitePlace K,
      (∑' π : S_sec_cube w₀, L π.1) =
      ∑ x : S_cube, (if P_max w₀ x.1 then L x.1 else 0) := by
    intro w₀
    change (∑' π : S_sec_cube w₀, L (e_sec_cube w₀ π).1.1) = _
    rw [Equiv.tsum_eq (e_sec_cube w₀) (fun z : {x : S_cube // P_max w₀ x.1} => L z.1.1), tsum_fintype]
    have hsub : (∑ z : {x : S_cube // P_max w₀ x.1}, L z.1.1) =
        ∑ x ∈ Finset.univ.filter (fun x : S_cube => P_max w₀ x.1), L x.1 :=
      (Finset.sum_subtype (Finset.univ.filter (fun x : S_cube => P_max w₀ x.1))
        (fun _ => by simp) (fun x : S_cube => L x.1)).symm
    rw [hsub, Finset.sum_filter]
  have h_lhs2 :
      (∑ w₀ : NumberField.InfinitePlace K, ∑' π : S_sec_cube w₀, L π.1) =
      ∑ x : S_cube, ((M x.1).card : ℝ) * L x.1 := by
    simp_rw [h_lhs_sec]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
  have h_lhs_diff :
      (∑' π : S_cube, L π.1) -
      (∑ w₀ : NumberField.InfinitePlace K, ∑' π : S_sec_cube w₀, L π.1)
      = - ∑ x : S_cube, (((M x.1).card : ℝ) - 1) * L x.1 := by
    rw [h_lhs1, h_lhs2, ← Finset.sum_sub_distrib, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    ring
  have h_lhs_nonneg :
      0 ≤ ∑ x : S_cube, (((M x.1).card : ℝ) - 1) * L x.1 :=
    Finset.sum_nonneg (fun x _ => mul_nonneg (hM_sub_nonneg x.1) (hL_nonneg x.1))
  let e_cube : S_cube ≃ {y : S_uncond // P_cube y.1} :=
    { toFun := fun x =>
        ⟨⟨x.1, x.2.1, fun w => ⟨x.2.2.2 w, h_cube_lt x.1 x.2.2.1 w⟩⟩,
         x.2.2.1⟩
      invFun := fun y =>
        ⟨y.1.1, y.1.2.1, y.2, fun w => (y.1.2.2 w).1⟩
      left_inv := fun x => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_lhs_abs :
      |(∑' π : S_cube, L π.1) -
        (∑ w₀ : NumberField.InfinitePlace K, ∑' π : S_sec_cube w₀, L π.1)|
      = ∑ y ∈ Finset.univ.filter (fun y : S_uncond => P_cube y.1),
          (((M y.1).card : ℝ) - 1) * L y.1 := by
    rw [h_lhs_diff, abs_neg, abs_of_nonneg h_lhs_nonneg]
    calc (∑ x : S_cube, (((M x.1).card : ℝ) - 1) * L x.1)
      _ = ∑ z : {y : S_uncond // P_cube y.1}, (((M z.1.1).card : ℝ) - 1) * L z.1.1 :=
        Equiv.sum_comp e_cube (fun z : {y : S_uncond // P_cube y.1} =>
          (((M z.1.1).card : ℝ) - 1) * L z.1.1)
      _ = ∑ y ∈ Finset.univ.filter (fun y : S_uncond => P_cube y.1),
            (((M y.1).card : ℝ) - 1) * L y.1 :=
        (Finset.sum_subtype (Finset.univ.filter (fun y : S_uncond => P_cube y.1))
          (fun _ => by simp) (fun y : S_uncond => (((M y.1).card : ℝ) - 1) * L y.1)).symm
  have h_rhs1 : (∑' y : S_uncond, L y.1) = ∑ y : S_uncond, L y.1 :=
    tsum_fintype (fun y : S_uncond => L y.1)
  let S_sec_uncond (w₀ : NumberField.InfinitePlace K) :=
    {π : NumberField.RingOfIntegers K //
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K,
        1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
      w₀ (π : K) < X}
  let e_sec_uncond (w₀ : NumberField.InfinitePlace K) :
      S_sec_uncond w₀ ≃ {y : S_uncond // P_max w₀ y.1} :=
    { toFun := fun π =>
        ⟨⟨π.1, π.2.1, fun w => ⟨(π.2.2.1 w).1, lt_of_le_of_lt (π.2.2.1 w).2 π.2.2.2⟩⟩,
         fun w => (π.2.2.1 w).2⟩
      invFun := fun y =>
        ⟨y.1.1, y.1.2.1, fun w => ⟨(y.1.2.2 w).1, y.2 w⟩, (y.1.2.2 w₀).2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_rhs_sec : ∀ w₀ : NumberField.InfinitePlace K,
      (∑' π : S_sec_uncond w₀, L π.1) =
      ∑ y : S_uncond, (if P_max w₀ y.1 then L y.1 else 0) := by
    intro w₀
    change (∑' π : S_sec_uncond w₀, L (e_sec_uncond w₀ π).1.1) = _
    rw [Equiv.tsum_eq (e_sec_uncond w₀) (fun z : {y : S_uncond // P_max w₀ y.1} => L z.1.1), tsum_fintype]
    have hsub : (∑ z : {y : S_uncond // P_max w₀ y.1}, L z.1.1) =
        ∑ y ∈ Finset.univ.filter (fun y : S_uncond => P_max w₀ y.1), L y.1 :=
      (Finset.sum_subtype (Finset.univ.filter (fun y : S_uncond => P_max w₀ y.1))
        (fun _ => by simp) (fun y : S_uncond => L y.1)).symm
    rw [hsub, Finset.sum_filter]
  have h_rhs2 :
      (∑ w₀ : NumberField.InfinitePlace K, ∑' π : S_sec_uncond w₀, L π.1) =
      ∑ y : S_uncond, ((M y.1).card : ℝ) * L y.1 := by
    simp_rw [h_rhs_sec]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun y _ => ?_)
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
  have h_rhs_diff :
      (∑' y : S_uncond, L y.1) -
      (∑ w₀ : NumberField.InfinitePlace K, ∑' π : S_sec_uncond w₀, L π.1)
      = - ∑ y : S_uncond, (((M y.1).card : ℝ) - 1) * L y.1 := by
    rw [h_rhs1, h_rhs2, ← Finset.sum_sub_distrib, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl (fun y _ => ?_)
    ring
  have h_rhs_nonneg :
      0 ≤ ∑ y : S_uncond, (((M y.1).card : ℝ) - 1) * L y.1 :=
    Finset.sum_nonneg (fun y _ => mul_nonneg (hM_sub_nonneg y.1) (hL_nonneg y.1))
  have h_rhs_abs :
      |(∑' y : S_uncond, L y.1) -
        (∑ w₀ : NumberField.InfinitePlace K, ∑' π : S_sec_uncond w₀, L π.1)|
      = ∑ y : S_uncond, (((M y.1).card : ℝ) - 1) * L y.1 := by
    rw [h_rhs_diff, abs_neg, abs_of_nonneg h_rhs_nonneg]
  change |(∑' π : S_cube, L π.1) -
      (∑ w₀ : NumberField.InfinitePlace K, ∑' π : S_sec_cube w₀, L π.1)|
    ≤ |(∑' y : S_uncond, L y.1) -
      (∑ w₀ : NumberField.InfinitePlace K, ∑' π : S_sec_uncond w₀, L π.1)|
  rw [h_lhs_abs, h_rhs_abs]
  exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
    (fun y _ _ => mul_nonneg (hM_sub_nonneg y.1) (hL_nonneg y.1))

theorem mitsui_prime_fundamentalCone_eq_torsionOrder_mul_principalPrimeIdeals {K : Type u} [Field K] [NumberField K]
    (Y : ℝ) :
    (∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          NumberField.mixedEmbedding K (π : K) ∈
            NumberField.mixedEmbedding.fundamentalCone K ∧
          NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤ Y},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      = (NumberField.Units.torsionOrder K : ℝ) *
        (∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
              p.asIdeal.IsPrincipal ∧
              (Ideal.absNorm p.asIdeal : ℝ) ≤ Y},
            Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal)) :=
by
  classical
  have h_norm_span : ∀ x : NumberField.RingOfIntegers K,
      (Ideal.absNorm (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))) : ℝ) =
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) := by
    intro x
    rw [Ideal.absNorm_span_singleton, NumberField.mixedEmbedding.norm_eq_norm,
      ← Algebra.coe_norm_int x, Nat.cast_natAbs]
    push_cast
    rfl
  let D_cone := {π : NumberField.RingOfIntegers K //
    Prime π ∧
    NumberField.mixedEmbedding K (π : K) ∈
      NumberField.mixedEmbedding.fundamentalCone K ∧
    NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤ Y}
  let D_prin := {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
    p.asIdeal.IsPrincipal ∧
    (Ideal.absNorm p.asIdeal : ℝ) ≤ Y}
  let p₀ : D_cone → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) :=
    fun π => ⟨Ideal.span ({π.1} : Set (NumberField.RingOfIntegers K)),
      (Ideal.span_singleton_prime π.2.1.ne_zero).mpr π.2.1,
      Ideal.span_singleton_eq_bot.not.mpr π.2.1.ne_zero⟩
  have h_prin : ∀ π : D_cone, (p₀ π).asIdeal.IsPrincipal :=
    fun π => ⟨⟨π.1, rfl⟩⟩
  have h_p₀_mem : ∀ π : D_cone,
      (p₀ π).asIdeal.IsPrincipal ∧
      (Ideal.absNorm (p₀ π).asIdeal : ℝ) ≤ Y := by
    intro π
    refine ⟨h_prin π, ?_⟩
    change (Ideal.absNorm (Ideal.span ({π.1} : Set (NumberField.RingOfIntegers K))) : ℝ) ≤ Y
    rw [h_norm_span π.1]
    exact π.2.2.2
  let d_prin : D_cone → D_prin := fun π => ⟨p₀ π, h_p₀_mem π⟩
  let a : D_cone → NumberField.mixedEmbedding.fundamentalCone.integerSet K :=
    fun π => ⟨NumberField.mixedEmbedding K (π.1 : K),
      NumberField.mixedEmbedding.fundamentalCone.mem_integerSet.mpr ⟨π.2.2.1, π.1, rfl⟩⟩
  have ha_pre : ∀ π : D_cone,
      (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet (a π) :
        NumberField.RingOfIntegers K) = π.1 :=
    fun π => NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet_mixedEmbedding (a π).2
  let u_tors : D_cone → NumberField.Units.torsion K :=
    fun π => (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a π)).2
  let b : D_prin → {I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) //
      Submodule.IsPrincipal (I : Ideal (NumberField.RingOfIntegers K))} :=
    fun p => ⟨⟨p.1.asIdeal, mem_nonZeroDivisors_of_ne_zero p.1.ne_bot⟩, p.2.1⟩
  let a' : D_prin × NumberField.Units.torsion K →
      NumberField.mixedEmbedding.fundamentalCone.integerSet K :=
    fun pz => (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K).symm (b pz.1, pz.2)
  let x' : D_prin × NumberField.Units.torsion K → NumberField.RingOfIntegers K :=
    fun pz => (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet (a' pz) :
      NumberField.RingOfIntegers K)
  have h_span : ∀ pz : D_prin × NumberField.Units.torsion K,
      Ideal.span ({x' pz} : Set (NumberField.RingOfIntegers K)) = pz.1.1.asIdeal := by
    intro pz
    have h1 := (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv_apply_fst (a' pz)).symm
    have h2 : NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a' pz) = (b pz.1, pz.2) :=
      (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K).apply_symm_apply (b pz.1, pz.2)
    rw [h2] at h1
    exact h1
  have h_x'_mem : ∀ pz : D_prin × NumberField.Units.torsion K,
      Prime (x' pz) ∧
      NumberField.mixedEmbedding K ((x' pz : NumberField.RingOfIntegers K) : K) ∈
        NumberField.mixedEmbedding.fundamentalCone K ∧
      NumberField.mixedEmbedding.norm
        (NumberField.mixedEmbedding K ((x' pz : NumberField.RingOfIntegers K) : K)) ≤ Y := by
    intro pz
    have hx'_ne : x' pz ≠ 0 :=
      nonZeroDivisors.ne_zero (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet (a' pz)).2
    have h_emb : NumberField.mixedEmbedding K ((x' pz : NumberField.RingOfIntegers K) : K) =
        (a' pz : NumberField.mixedEmbedding.mixedSpace K) :=
      NumberField.mixedEmbedding.fundamentalCone.mixedEmbedding_preimageOfMemIntegerSet (a' pz)
    refine ⟨?_, ?_, ?_⟩
    · have hI_prime : (Ideal.span ({x' pz} : Set (NumberField.RingOfIntegers K))).IsPrime := by
        rw [h_span pz]
        exact pz.1.1.isPrime
      exact (Ideal.span_singleton_prime hx'_ne).mp hI_prime
    · rw [h_emb]
      exact (NumberField.mixedEmbedding.fundamentalCone.mem_integerSet.mp (a' pz).2).1
    · rw [← h_norm_span (x' pz), h_span pz]
      exact pz.1.2.2
  let E : D_cone ≃ D_prin × NumberField.Units.torsion K :=
    { toFun := fun π => (d_prin π, u_tors π)
      invFun := fun pz => ⟨x' pz, h_x'_mem pz⟩
      left_inv := by
        intro π
        apply Subtype.ext
        have h_b_eq : b (d_prin π) = (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a π)).1 := by
          apply Subtype.ext
          apply Subtype.ext
          change Ideal.span ({π.1} : Set (NumberField.RingOfIntegers K)) =
            (((NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a π)).1 :
              nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
              Ideal (NumberField.RingOfIntegers K))
          rw [NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv_apply_fst (a π), ha_pre π]
        have h_pair_eq : (b (d_prin π), u_tors π) =
            NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a π) :=
          Prod.ext h_b_eq rfl
        have ha'_eq : a' (d_prin π, u_tors π) = a π := by
          dsimp [a']
          rw [h_pair_eq, (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K).symm_apply_apply]
        change x' (d_prin π, u_tors π) = π.1
        dsimp [x']
        rw [ha'_eq, ha_pre π]
      right_inv := by
        intro pz
        let π : D_cone := ⟨x' pz, h_x'_mem pz⟩
        have hd_eq : d_prin π = pz.1 := by
          apply Subtype.ext
          apply IsDedekindDomain.HeightOneSpectrum.ext
          exact h_span pz
        have ha_eq : a π = a' pz := by
          apply Subtype.ext
          exact NumberField.mixedEmbedding.fundamentalCone.mixedEmbedding_preimageOfMemIntegerSet (a' pz)
        have hu_eq : u_tors π = pz.2 := by
          dsimp [u_tors]
          rw [ha_eq]
          have h2 : NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a' pz) = (b pz.1, pz.2) :=
            (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K).apply_symm_apply (b pz.1, pz.2)
          rw [h2]
        exact Prod.ext hd_eq hu_eq }
  let F_cone : D_cone → ℝ := fun π =>
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  let F_prin : D_prin → ℝ := fun p =>
    Real.log (Ideal.absNorm p.1.asIdeal)
  have hF_eq : ∀ π : D_cone, F_cone π = F_prin (E π).1 := by
    intro π
    dsimp [F_cone, F_prin, E]
    congr 2
    change (Algebra.norm ℤ π.1).natAbs =
      Ideal.absNorm (Ideal.span ({π.1} : Set (NumberField.RingOfIntegers K)))
    exact (Ideal.absNorm_span_singleton π.1).symm
  have h_tsum_reindex : (∑' π : D_cone, F_cone π) =
      ∑' pz : D_prin × NumberField.Units.torsion K, F_prin pz.1 := by
    rw [tsum_congr hF_eq]
    exact Equiv.tsum_eq E (fun pz : D_prin × NumberField.Units.torsion K => F_prin pz.1)
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊}
  have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Y⌋₊
  haveI : Finite S_id := hSid_fin
  let emb_id : D_prin → S_id :=
    fun p => ⟨p.1.asIdeal, Nat.le_floor p.2.2⟩
  have hemb_inj : Function.Injective emb_id := by
    intro p₁ p₂ hp
    apply Subtype.ext
    apply IsDedekindDomain.HeightOneSpectrum.ext
    exact congrArg Subtype.val hp
  haveI : Finite D_prin := Finite.of_injective emb_id hemb_inj
  letI : Fintype D_prin := Fintype.ofFinite D_prin
  change (∑' π : D_cone, F_cone π) =
    (NumberField.Units.torsionOrder K : ℝ) * (∑' p : D_prin, F_prin p)
  rw [h_tsum_reindex, tsum_fintype, tsum_fintype, Fintype.sum_prod_type]
  dsimp only
  have h_inner : ∀ p : D_prin,
      (∑ _ζ : NumberField.Units.torsion K, F_prin p) =
        (NumberField.Units.torsionOrder K : ℝ) * F_prin p := by
    intro p
    rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    rfl
  simp_rw [h_inner]
  rw [← Finset.mul_sum]

theorem mitsui_prime_place_sector_eq_principalPrimeIdeals {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (w₀ : NumberField.InfinitePlace K) :
    (∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          (∀ w : NumberField.InfinitePlace K,
            1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
          w₀ (π : K) < X},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      = ∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
            p.asIdeal.IsPrincipal ∧
            (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K)},
          (Nat.card {π : NumberField.RingOfIntegers K //
              Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧
              (∀ w : NumberField.InfinitePlace K,
                1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
              w₀ (π : K) < X} : ℝ) *
            Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal) :=
by
  classical
  have h_norm_prod : ∀ x : NumberField.RingOfIntegers K,
      (Ideal.absNorm (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))) : ℝ) =
        ∏ w : NumberField.InfinitePlace K, w (x : K) ^ w.mult := by
    intro x
    rw [NumberField.InfinitePlace.prod_eq_abs_norm, Ideal.absNorm_span_singleton,
      ← Algebra.coe_norm_int x, Nat.cast_natAbs]
    push_cast
    rfl
  have h_norm_le : ∀ x : NumberField.RingOfIntegers K,
      (∀ w : NumberField.InfinitePlace K, 1 ≤ w (x : K) ∧ w (x : K) ≤ w₀ (x : K)) →
      w₀ (x : K) < X →
      (Ideal.absNorm (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))) : ℝ) ≤
        X ^ (Module.finrank ℚ K) := by
    intro x hx_sec hx_lt
    rw [h_norm_prod x]
    have h_prod_le :
        (∏ w : NumberField.InfinitePlace K, w (x : K) ^ w.mult) ≤
          ∏ w : NumberField.InfinitePlace K, X ^ w.mult := by
      refine Finset.prod_le_prod (fun w _ => ?_) (fun w _ => ?_)
      · have hw_nonneg : 0 ≤ w (x : K) := le_trans zero_le_one (hx_sec w).1
        exact pow_nonneg hw_nonneg w.mult
      · have hw_nonneg : 0 ≤ w (x : K) := le_trans zero_le_one (hx_sec w).1
        have hw_le : w (x : K) ≤ X := le_trans (hx_sec w).2 (le_of_lt hx_lt)
        exact pow_le_pow_left₀ hw_nonneg hw_le w.mult
    have h_prod_X :
        (∏ w : NumberField.InfinitePlace K, X ^ w.mult) = X ^ (Module.finrank ℚ K) := by
      rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq]
    exact h_prod_le.trans (le_of_eq h_prod_X)
  let D_sec := {π : NumberField.RingOfIntegers K //
    Prime π ∧
    (∀ w : NumberField.InfinitePlace K,
      1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
    w₀ (π : K) < X}
  let D_prin := {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
    p.asIdeal.IsPrincipal ∧
    (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K)}
  let Fiber (p₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
    {π : NumberField.RingOfIntegers K //
      Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p₀.asIdeal ∧
      (∀ w : NumberField.InfinitePlace K,
        1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
      w₀ (π : K) < X}
  let p₀ : D_sec → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) :=
    fun π => ⟨Ideal.span ({π.1} : Set (NumberField.RingOfIntegers K)),
      (Ideal.span_singleton_prime π.2.1.ne_zero).mpr π.2.1,
      Ideal.span_singleton_eq_bot.not.mpr π.2.1.ne_zero⟩
  have h_prin : ∀ π : D_sec, (p₀ π).asIdeal.IsPrincipal :=
    fun π => ⟨⟨π.1, rfl⟩⟩
  have h_p₀_mem : ∀ π : D_sec,
      (p₀ π).asIdeal.IsPrincipal ∧
      (Ideal.absNorm (p₀ π).asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K) :=
    fun π => ⟨h_prin π, h_norm_le π.1 π.2.2.1 π.2.2.2⟩
  let d_prin : D_sec → D_prin := fun π => ⟨p₀ π, h_p₀_mem π⟩
  have h_y_mem : ∀ (p : D_prin) (y : Fiber p.1),
      Prime y.1 ∧
      (∀ w : NumberField.InfinitePlace K,
        1 ≤ w (y.1 : K) ∧ w (y.1 : K) ≤ w₀ (y.1 : K)) ∧
      w₀ (y.1 : K) < X := by
    intro p y
    have hy_ne : y.1 ≠ 0 := by
      intro h0
      apply p.1.ne_bot
      rw [← y.2.1, Ideal.span_singleton_eq_bot]
      exact h0
    have hI_prime : (Ideal.span ({y.1} : Set (NumberField.RingOfIntegers K))).IsPrime := by
      rw [y.2.1]
      exact p.1.isPrime
    exact ⟨(Ideal.span_singleton_prime hy_ne).mp hI_prime, y.2.2.1, y.2.2.2⟩
  let e_fiber (p : D_prin) : {π : D_sec // d_prin π = p} ≃ Fiber p.1 :=
    { toFun := fun z =>
        ⟨z.1.1, congrArg (fun q : D_prin => q.1.asIdeal) z.2, z.1.2.2.1, z.1.2.2.2⟩
      invFun := fun y =>
        ⟨⟨y.1, h_y_mem p y⟩, by
          apply Subtype.ext
          apply IsDedekindDomain.HeightOneSpectrum.ext
          exact y.2.1⟩
      left_inv := fun z => by
        apply Subtype.ext
        apply Subtype.ext
        rfl
      right_inv := fun y => by
        apply Subtype.ext
        rfl }
  let B_X : Set K := {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}
  have hB_fin : B_X.Finite := NumberField.Embeddings.finite_of_norm_le K ℂ X
  have hpre_fin : (algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X).Finite :=
    hB_fin.preimage NumberField.RingOfIntegers.coe_injective.injOn
  have hDsec_sub : {π : NumberField.RingOfIntegers K |
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K,
        1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
      w₀ (π : K) < X} ⊆
      algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X := by
    intro π hπ
    refine ⟨NumberField.RingOfIntegers.isIntegral_coe π, ?_⟩
    intro φ
    let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
    have hw1 : w (π : K) = ‖φ (π : K)‖ := NumberField.InfinitePlace.apply φ (π : K)
    have hle : w (π : K) ≤ w₀ (π : K) := (hπ.2.1 w).2
    have hlt : w₀ (π : K) < X := hπ.2.2
    change ‖φ (π : K)‖ ≤ X
    linarith
  have hDsec_fin : {π : NumberField.RingOfIntegers K |
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K,
        1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
      w₀ (π : K) < X}.Finite :=
    hpre_fin.subset hDsec_sub
  letI : Fintype D_sec := hDsec_fin.fintype
  let Y : ℝ := X ^ (Module.finrank ℚ K)
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊}
  have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Y⌋₊
  haveI : Finite S_id := hSid_fin
  let emb_id : D_prin → S_id :=
    fun p => ⟨p.1.asIdeal, Nat.le_floor p.2.2⟩
  have hemb_inj : Function.Injective emb_id := by
    intro p₁ p₂ hp
    apply Subtype.ext
    apply IsDedekindDomain.HeightOneSpectrum.ext
    exact congrArg Subtype.val hp
  haveI : Finite D_prin := Finite.of_injective emb_id hemb_inj
  letI : Fintype D_prin := Fintype.ofFinite D_prin
  let F_sec : D_sec → ℝ := fun π =>
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  let F_prin : D_prin → ℝ := fun p =>
    Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal)
  have hF_eq : ∀ π : D_sec, F_sec π = F_prin (d_prin π) := by
    intro π
    dsimp [F_sec, F_prin]
    congr 2
    change (Algebra.norm ℤ π.1).natAbs =
      Ideal.absNorm (Ideal.span ({π.1} : Set (NumberField.RingOfIntegers K)))
    exact (Ideal.absNorm_span_singleton π.1).symm
  have h_tsum_sigma :
      (∑' π : D_sec, F_sec π) =
        ∑ p : D_prin, ∑ z : {π : D_sec // d_prin π = p}, F_sec z.1 := by
    rw [← Equiv.tsum_eq (Equiv.sigmaFiberEquiv d_prin) F_sec, tsum_fintype, Fintype.sum_sigma]
    rfl
  have h_inner : ∀ p : D_prin,
      (∑ z : {π : D_sec // d_prin π = p}, F_sec z.1) =
        (Nat.card (Fiber p.1) : ℝ) * F_prin p := by
    intro p
    have h_const : ∀ z : {π : D_sec // d_prin π = p}, F_sec z.1 = F_prin p := by
      intro z
      rw [hF_eq z.1, z.2]
    have h_sum_const :
        (∑ z : {π : D_sec // d_prin π = p}, F_sec z.1) =
          ∑ _z : {π : D_sec // d_prin π = p}, F_prin p :=
      Finset.sum_congr rfl (fun z _ => h_const z)
    rw [h_sum_const, Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
      ← Nat.card_eq_fintype_card, Nat.card_congr (e_fiber p)]
  change (∑' π : D_sec, F_sec π) =
    ∑' p : D_prin, (Nat.card (Fiber p.1) : ℝ) * F_prin p
  rw [h_tsum_sigma, tsum_fintype]
  exact Finset.sum_congr rfl (fun p _ => h_inner p)

theorem mitsui_principalPrimeIdeals_place_sector_bound_of_rank_eq_zero {K : Type u} [Field K] [NumberField K]
    (h_rank : NumberField.Units.rank K = 0) :
    ∃ c₃₀ : ℝ, 0 < c₃₀ ∧
      ∀ X : ℝ, 1 < X →
        ∀ w₀ : NumberField.InfinitePlace K,
          |(∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
                p.asIdeal.IsPrincipal ∧
                (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K)},
              (Nat.card {π : NumberField.RingOfIntegers K //
                  Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧
                  (∀ w : NumberField.InfinitePlace K,
                    1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
                  w₀ (π : K) < X} : ℝ) *
                Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal))
            - ((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) *
              (NumberField.Units.regulator K)⁻¹ *
              ((NumberField.Units.torsionOrder K : ℝ) *
                (∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
                      p.asIdeal.IsPrincipal ∧
                      (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K)},
                    Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal)))|
            ≤ c₃₀ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃₀) :=
by
  classical
  have h_s1 : ∀ w₀ : NumberField.InfinitePlace K,
      (∀ w : NumberField.InfinitePlace K, w = w₀) ∧
      w₀.mult = Module.finrank ℚ K ∧
      NumberField.Units.regulator K = 1 ∧
      ((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) * (NumberField.Units.regulator K)⁻¹ = 1 := by
    intro w₀
    have h_card : Fintype.card (NumberField.InfinitePlace K) ≤ 1 := by
      have h1 : Fintype.card (NumberField.InfinitePlace K) - 1 = 0 := h_rank
      exact Nat.sub_eq_zero_iff_le.mp h1
    have h_sub : Subsingleton (NumberField.InfinitePlace K) :=
      Fintype.card_le_one_iff_subsingleton.mp h_card
    have hw_eq : ∀ w : NumberField.InfinitePlace K, w = w₀ := fun w => h_sub.elim w w₀
    have h_mult : w₀.mult = Module.finrank ℚ K := by
      letI : Unique (NumberField.InfinitePlace K) := @uniqueOfSubsingleton _ h_sub w₀
      have hsum := NumberField.InfinitePlace.sum_mult_eq (K := K)
      rw [Fintype.sum_unique] at hsum
      exact hsum
    have h_reg : NumberField.Units.regulator K = 1 := by
      rw [NumberField.Units.regulator_eq_det' K]
      haveI : IsEmpty {w : NumberField.InfinitePlace K // w ≠ NumberField.Units.dirichletUnitTheorem.w₀} :=
        ⟨fun w => w.2 (h_sub.elim _ _)⟩
      simp [Matrix.det_isEmpty]
    have h_pref : ((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) * (NumberField.Units.regulator K)⁻¹ = 1 := by
      have hn_pos : (0 : ℝ) < (Module.finrank ℚ K : ℝ) := by
        exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
      rw [h_mult, h_reg, div_self (ne_of_gt hn_pos), inv_one, mul_one]
    exact ⟨hw_eq, h_mult, h_reg, h_pref⟩
  have h_s2 : ∀ (X : ℝ), 1 < X → ∀ (w₀ : NumberField.InfinitePlace K)
      (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (h_prin : p.asIdeal.IsPrincipal),
      ((Ideal.absNorm p.asIdeal : ℝ) < X ^ (Module.finrank ℚ K) →
        Nat.card {π : NumberField.RingOfIntegers K //
          Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.asIdeal ∧
          (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
          w₀ (π : K) < X} = NumberField.Units.torsionOrder K) ∧
      ((Ideal.absNorm p.asIdeal : ℝ) = X ^ (Module.finrank ℚ K) →
        Nat.card {π : NumberField.RingOfIntegers K //
          Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.asIdeal ∧
          (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
          w₀ (π : K) < X} = 0) := by
    intro X hX w₀ p h_prin
    obtain ⟨hw_eq, h_mult, _, _⟩ := h_s1 w₀
    haveI : Subsingleton (NumberField.InfinitePlace K) := ⟨fun a b => (hw_eq a).trans (hw_eq b).symm⟩
    letI : Unique (NumberField.InfinitePlace K) := uniqueOfSubsingleton w₀
    set n := Module.finrank ℚ K
    have hn_pos : 0 < n := Module.finrank_pos (R := ℚ) (M := K)
    have hn_ne : n ≠ 0 := ne_of_gt hn_pos
    have h_gen_pow : ∀ π : NumberField.RingOfIntegers K,
        Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.asIdeal →
        w₀ (π : K) ^ n = (Ideal.absNorm p.asIdeal : ℝ) := by
      intro π hspan
      have h1 : (Ideal.absNorm p.asIdeal : ℝ) = ((Algebra.norm ℤ π).natAbs : ℝ) := by
        rw [← hspan, Ideal.absNorm_span_singleton]
      have h2q : ((Algebra.norm ℤ π).natAbs : ℚ) = |Algebra.norm ℚ (π : K)| := by
        rw [Nat.cast_natAbs, Int.cast_abs, Algebra.coe_norm_int]
      have h2 : ((Algebra.norm ℤ π).natAbs : ℝ) = ((|Algebra.norm ℚ (π : K)| : ℚ) : ℝ) := by
        exact_mod_cast h2q
      have h3 := NumberField.InfinitePlace.prod_eq_abs_norm (π : K)
      rw [Fintype.prod_unique] at h3
      change w₀ (π : K) ^ w₀.mult = ((|Algebra.norm ℚ (π : K)| : ℚ) : ℝ) at h3
      rw [h_mult] at h3
      linarith
    have h_norm_ge_one : (1 : ℝ) ≤ (Ideal.absNorm p.asIdeal : ℝ) := by
      have hne : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
      exact_mod_cast Nat.one_le_iff_ne_zero.mpr hne
    have h_gen_sec : ∀ π : NumberField.RingOfIntegers K,
        Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.asIdeal →
        (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
        (w₀ (π : K) < X ↔ (Ideal.absNorm p.asIdeal : ℝ) < X ^ n) := by
      intro π hspan
      have hpow := h_gen_pow π hspan
      have hw0_ge_one : 1 ≤ w₀ (π : K) := by
        rw [← pow_le_pow_iff_left₀ zero_le_one (apply_nonneg w₀ (π : K)) hn_ne, one_pow, hpow]
        exact h_norm_ge_one
      refine ⟨fun w => ?_, ?_⟩
      · rw [hw_eq w]
        exact ⟨hw0_ge_one, le_rfl⟩
      · rw [← pow_lt_pow_iff_left₀ (apply_nonneg w₀ (π : K)) (by linarith) hn_ne, hpow]
    refine ⟨fun h_lt => ?_, fun h_eq => ?_⟩
    · have h_all_tors : ∀ u : (NumberField.RingOfIntegers K)ˣ, u ∈ NumberField.Units.torsion K := by
        intro u
        obtain ⟨⟨ζ, e⟩, hu_eq, _⟩ := NumberField.Units.exist_unique_eq_mul_prod K u
        haveI : IsEmpty (Fin (NumberField.Units.rank K)) := h_rank ▸ Fin.isEmpty'
        rw [Fintype.prod_empty, mul_one] at hu_eq
        rw [hu_eq]
        exact ζ.2
      let g : NumberField.RingOfIntegers K := @Submodule.IsPrincipal.generator _ _ _ _ _ p.asIdeal h_prin
      have hg_span : Ideal.span ({g} : Set (NumberField.RingOfIntegers K)) = p.asIdeal :=
        @Submodule.IsPrincipal.span_singleton_generator _ _ _ _ _ p.asIdeal h_prin
      have hg_ne : g ≠ 0 := by
        intro hg0
        apply p.ne_bot
        rw [← hg_span, hg0, Ideal.span_singleton_eq_bot]
      let D_sec := {π : NumberField.RingOfIntegers K //
        Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.asIdeal ∧
        (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
        w₀ (π : K) < X}
      let to_sec : NumberField.Units.torsion K → D_sec := fun ζ =>
        ⟨g * ((ζ.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K), by
          have hspan : Ideal.span ({g * ((ζ.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K)} :
              Set (NumberField.RingOfIntegers K)) = p.asIdeal := by
            rw [← hg_span, Ideal.span_singleton_eq_span_singleton]
            exact ⟨ζ.1⁻¹, by simp [mul_assoc]⟩
          exact ⟨hspan, (h_gen_sec _ hspan).1, (h_gen_sec _ hspan).2.mpr h_lt⟩⟩
      have h_bij : Function.Bijective to_sec := by
        refine ⟨fun ζ₁ ζ₂ h => ?_, fun π => ?_⟩
        · have hval : g * ((ζ₁.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) =
              g * ((ζ₂.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) :=
            congrArg Subtype.val h
          have hu := mul_left_cancel₀ hg_ne hval
          exact Subtype.ext (Units.ext hu)
        · have hspan : Ideal.span ({g} : Set (NumberField.RingOfIntegers K)) =
              Ideal.span ({π.1} : Set (NumberField.RingOfIntegers K)) :=
            hg_span.trans π.2.1.symm
          obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp hspan
          refine ⟨⟨u, h_all_tors u⟩, Subtype.ext hu⟩
      rw [← Nat.card_congr (Equiv.ofBijective to_sec h_bij), Nat.card_eq_fintype_card]
      rfl
    · haveI : IsEmpty {π : NumberField.RingOfIntegers K //
          Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.asIdeal ∧
          (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
          w₀ (π : K) < X} := by
        refine ⟨fun π => ?_⟩
        have hlt := (h_gen_sec π.1 π.2.1).2.mp π.2.2.2
        linarith
      exact Nat.card_of_isEmpty
  have h_s3 : ∀ Y : ℝ,
      Nat.card {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
        (Ideal.absNorm p.asIdeal : ℝ) = Y} ≤ Module.finrank ℚ K := by
    intro Y
    let S_Y := {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
      (Ideal.absNorm p.asIdeal : ℝ) = Y}
    let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
      {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊}
    haveI : Finite S_id := Ideal.finite_setOf_absNorm_le ⌊Y⌋₊
    let emb : S_Y → S_id := fun p => ⟨p.1.asIdeal, Nat.le_floor (le_of_eq p.2)⟩
    have hemb_inj : Function.Injective emb := by
      intro p₁ p₂ hp
      exact Subtype.ext (IsDedekindDomain.HeightOneSpectrum.ext (congrArg Subtype.val hp))
    haveI : Finite S_Y := Finite.of_injective emb hemb_inj
    letI : Fintype S_Y := Fintype.ofFinite S_Y
    rw [Nat.card_eq_fintype_card]
    let T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
      (Finset.univ : Finset S_Y).map ⟨Subtype.val, Subtype.val_injective⟩
    have hT_card : Fintype.card S_Y = T.card := (Finset.card_map _).symm
    rw [hT_card]
    rcases T.eq_empty_or_nonempty with hT_emp | hT_ne
    · simp [hT_emp]
    · obtain ⟨p₀, hp₀⟩ := hT_ne
      have hp₀_eq : (Ideal.absNorm p₀.asIdeal : ℝ) = Y := by
        rcases Finset.mem_map.mp hp₀ with ⟨q, _, rfl⟩
        exact q.2
      set m : ℕ := Ideal.absNorm p₀.asIdeal
      have hm_gt_one : 1 < m := by
        have h0 : m ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p₀.ne_bot
        have h1 : m ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p₀.isPrime.ne_top
        omega
      have hp_norm : ∀ p ∈ T, Ideal.absNorm p.asIdeal = m := by
        intro p hp
        rcases Finset.mem_map.mp hp with ⟨q, _, rfl⟩
        exact Nat.cast_injective (q.2.trans hp₀_eq.symm)
      have hp_dvd : ∀ p ∈ T, p.asIdeal ∣ Ideal.span ({(m : NumberField.RingOfIntegers K)} :
          Set (NumberField.RingOfIntegers K)) := by
        intro p hp
        rw [Ideal.dvd_span_singleton, ← hp_norm p hp]
        exact Ideal.absNorm_mem p.asIdeal
      have hp_coprime : (T : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))).Pairwise
          (fun p₁ p₂ => IsCoprime p₁.asIdeal p₂.asIdeal) := by
        intro p₁ _ p₂ _ hne
        rw [Ideal.isCoprime_iff_sup_eq]
        exact Ideal.IsMaximal.coprime_of_ne p₁.isMaximal p₂.isMaximal
          (fun h => hne (IsDedekindDomain.HeightOneSpectrum.ext h))
      have hprod_dvd : (∏ p ∈ T, p.asIdeal) ∣ Ideal.span ({(m : NumberField.RingOfIntegers K)} :
          Set (NumberField.RingOfIntegers K)) :=
        Finset.prod_dvd_of_coprime hp_coprime hp_dvd
      have hnorm_dvd : Ideal.absNorm (∏ p ∈ T, p.asIdeal) ∣
          Ideal.absNorm (Ideal.span ({(m : NumberField.RingOfIntegers K)} :
            Set (NumberField.RingOfIntegers K))) :=
        map_dvd Ideal.absNorm hprod_dvd
      have hprod_norm : Ideal.absNorm (∏ p ∈ T, p.asIdeal) = m ^ T.card := by
        rw [map_prod, Finset.prod_congr rfl hp_norm, Finset.prod_const]
      have hspan_norm : Ideal.absNorm (Ideal.span ({(m : NumberField.RingOfIntegers K)} :
          Set (NumberField.RingOfIntegers K))) = m ^ (Module.finrank ℚ K) := by
        rw [Ideal.absNorm_span_singleton]
        have h1 : ((Algebra.norm ℤ (m : NumberField.RingOfIntegers K)).natAbs : ℚ) =
            (m : ℚ) ^ (Module.finrank ℚ K) := by
          rw [Nat.cast_natAbs, Int.cast_abs, Algebra.coe_norm_int]
          have hcast : ((m : NumberField.RingOfIntegers K) : K) = algebraMap ℚ K (m : ℚ) := by simp
          rw [hcast, Algebra.norm_algebraMap, abs_of_nonneg (by positivity)]
        exact_mod_cast h1
      rw [hprod_norm, hspan_norm] at hnorm_dvd
      have hm_pow_pos : 0 < m ^ (Module.finrank ℚ K) := Nat.pos_of_ne_zero (by positivity)
