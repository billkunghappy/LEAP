      have h2a : HasDerivAt (fun y : ℝ => (y : ℂ) ^ s) (s * (x : ℂ) ^ (s - 1)) x :=
        hasDerivAt_ofReal_cpow_const hx_ne hs_ne
      have h2b : HasDerivAt (fun y : ℝ => (Real.log y : ℂ) / s - 1 / s ^ 2 - 1 / s)
