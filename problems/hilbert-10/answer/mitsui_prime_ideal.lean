    let Φ_α : ℤ → ℤ := fun p => p - K * m_α p
    have hθ_bounds : ∀ p : ℤ, -(1 / 2) ≤ θ_α p ∧ θ_α p < 1 / 2 := by
      intro p
      dsimp [θ_α, m_α]
      have h1 := Int.floor_le ((p : ℝ) * h + α / (2 * Real.pi) + 1 / 2)
      have h2 := Int.lt_floor_add_one ((p : ℝ) * h + α / (2 * Real.pi) + 1 / 2)
      constructor <;> linarith
    have hθ_cos : ∀ p : ℤ,
        Real.cos (2 * Real.pi * θ_α p) = Real.cos (2 * Real.pi * (p : ℝ) * h + α) := by
      intro p
      dsimp [θ_α]
      have h2pi_ne : 2 * Real.pi ≠ 0 := mul_ne_zero two_ne_zero hpi_ne
      have h_arg : 2 * Real.pi * ((p : ℝ) * h + α / (2 * Real.pi) - (m_α p : ℝ)) =
          (2 * Real.pi * (p : ℝ) * h + α) - (m_α p : ℝ) * (2 * Real.pi) := by
        have h_div : 2 * Real.pi * (α / (2 * Real.pi)) = α := mul_div_cancel₀ α h2pi_ne
        calc 2 * Real.pi * ((p : ℝ) * h + α / (2 * Real.pi) - (m_α p : ℝ))
          _ = 2 * Real.pi * (p : ℝ) * h + 2 * Real.pi * (α / (2 * Real.pi)) - (m_α p : ℝ) * (2 * Real.pi) := by ring
          _ = (2 * Real.pi * (p : ℝ) * h + α) - (m_α p : ℝ) * (2 * Real.pi) := by rw [h_div]
      rw [h_arg]
      exact Real.cos_sub_int_mul_two_pi (2 * Real.pi * (p : ℝ) * h + α) (m_α p)
    have hΦ_diff : ∀ p₁ p₂ : ℤ, ((Φ_α p₁ - Φ_α p₂ : ℤ) : ℝ) * h = θ_α p₁ - θ_α p₂ := by
      intro p₁ p₂
      dsimp [Φ_α, θ_α]
      push_cast
      calc ((p₁ : ℝ) - (K : ℝ) * (m_α p₁ : ℝ) - ((p₂ : ℝ) - (K : ℝ) * (m_α p₂ : ℝ))) * h
        _ = (p₁ : ℝ) * h - ((K : ℝ) * h) * (m_α p₁ : ℝ) - ((p₂ : ℝ) * h - ((K : ℝ) * h) * (m_α p₂ : ℝ)) := by ring
        _ = (p₁ : ℝ) * h - 1 * (m_α p₁ : ℝ) - ((p₂ : ℝ) * h - 1 * (m_α p₂ : ℝ)) := by rw [hKh_int]
        _ = (p₁ : ℝ) * h + α / (2 * Real.pi) - (m_α p₁ : ℝ) -
            ((p₂ : ℝ) * h + α / (2 * Real.pi) - (m_α p₂ : ℝ)) := by ring
    have hΦ_inj : Set.InjOn Φ_α (Finset.Ico (0 : ℤ) K : Set ℤ) := by
      intro p₁ hp₁ p₂ hp₂ h_eq
      dsimp [Φ_α] at h_eq
      have h_lin : K * m_α p₂ + p₁ = K * m_α p₁ + p₂ := by linarith
      exact (h_uniq_div (m_α p₂) p₁ (m_α p₁) p₂ hp₁ hp₂ h_lin).2
    set N_ε : ℤ := Int.floor (Real.sqrt ε / h)
    have hN_nonneg : 0 ≤ N_ε := Int.le_floor.mpr (by rw [Int.cast_zero]; positivity)
    have hN_le : (N_ε : ℝ) * h ≤ Real.sqrt ε := by
      calc (N_ε : ℝ) * h ≤ (Real.sqrt ε / h) * h :=
            mul_le_mul_of_nonneg_right (Int.floor_le _) hh_nonneg
        _ = Real.sqrt ε := div_mul_cancel₀ _ (ne_of_gt hh_pos)
    have h_branch_bound : ∀ P : Finset ℤ, P ⊆ T →
        (∀ p ∈ P, 0 ≤ θ_α p) ∨ (∀ p ∈ P, θ_α p ≤ 0) →
        (P.card : ℝ) * h ≤ 6 * Real.sqrt ε + h := by
      intro P hPT hP_sign
      rcases P.eq_empty_or_nonempty with rfl | ⟨p₀, hp₀⟩
      · simp only [Finset.card_empty, Nat.cast_zero, zero_mul]
        positivity
      · have hp₀T : p₀ ∈ T := hPT hp₀
        let I₀ : Finset ℤ := Finset.Icc (Φ_α p₀ - N_ε) (Φ_α p₀ + N_ε)
        have h_maps : Set.MapsTo Φ_α (P : Set ℤ) (I₀ : Set ℤ) := by
          intro p hpP
          have hpT : p ∈ T := hPT hpP
          have hcos_diff : |Real.cos (2 * Real.pi * θ_α p) - Real.cos (2 * Real.pi * θ_α p₀)| ≤ 2 * ε := by
            rw [hθ_cos p, hθ_cos p₀]
            have h1 := (hT p hpT).2
            have h2 := (hT p₀ hp₀T).2
            have h_id : Real.cos (2 * Real.pi * (p : ℝ) * h + α) -
                Real.cos (2 * Real.pi * (p₀ : ℝ) * h + α) =
                (Real.cos (2 * Real.pi * (p : ℝ) * h + α) - γ) -
                (Real.cos (2 * Real.pi * (p₀ : ℝ) * h + α) - γ) := by ring
            rw [h_id]
            have h_tri := abs_sub (Real.cos (2 * Real.pi * (p : ℝ) * h + α) - γ)
              (Real.cos (2 * Real.pi * (p₀ : ℝ) * h + α) - γ)
            linarith
          have h_quad : 8 * (θ_α p - θ_α p₀) ^ 2 ≤
              |Real.cos (2 * Real.pi * θ_α p) - Real.cos (2 * Real.pi * θ_α p₀)| := by
            rcases hP_sign with h_pos | h_neg
            · exact h_cos_pos (θ_α p) (θ_α p₀) (h_pos p hpP) (le_of_lt (hθ_bounds p).2)
                (h_pos p₀ hp₀) (le_of_lt (hθ_bounds p₀).2)
            · exact h_cos_neg (θ_α p) (θ_α p₀) (hθ_bounds p).1 (h_neg p hpP)
                (hθ_bounds p₀).1 (h_neg p₀ hp₀)
          have h_sq_le : (θ_α p - θ_α p₀) ^ 2 ≤ ε := by
            have : 0 ≤ (θ_α p - θ_α p₀) ^ 2 := sq_nonneg _
            linarith
          have h_abs_diff : (((|Φ_α p - Φ_α p₀|) : ℤ) : ℝ) * h = |θ_α p - θ_α p₀| := by
            rw [Int.cast_abs, ← abs_of_pos hh_pos, ← abs_mul, hΦ_diff]
          have h_abs_sq : (((( |Φ_α p - Φ_α p₀| ) : ℤ) : ℝ) * h) ^ 2 ≤ ε := by
            rw [h_abs_diff, sq_abs]
            exact h_sq_le
          have h_le_sqrt : (((|Φ_α p - Φ_α p₀|) : ℤ) : ℝ) * h ≤ Real.sqrt ε :=
            Real.le_sqrt_of_sq_le h_abs_sq
          have h_le_div : (((|Φ_α p - Φ_α p₀|) : ℤ) : ℝ) ≤ Real.sqrt ε / h :=
            (le_div_iff₀ hh_pos).mpr h_le_sqrt
          have h_le_N : |Φ_α p - Φ_α p₀| ≤ N_ε := Int.le_floor.mpr h_le_div
          have h_abs_bounds := abs_le.mp h_le_N
          rw [Finset.mem_coe, Finset.mem_Icc]
          exact ⟨by omega, by omega⟩
        have h_inj_P : Set.InjOn Φ_α (P : Set ℤ) :=
          hΦ_inj.mono (fun p hp => (hT p (hPT hp)).1)
        have h_card_nat : P.card ≤ I₀.card :=
          Finset.card_le_card_of_injOn Φ_α h_maps h_inj_P
        have hI₀_card : (I₀.card : ℤ) = 2 * N_ε + 1 := by
          dsimp [I₀]
          rw [Int.card_Icc, Int.toNat_of_nonneg (by omega)]
          ring
        have h_card_r : (P.card : ℝ) ≤ 2 * (N_ε : ℝ) + 1 := by
          have h_card_z : (P.card : ℤ) ≤ 2 * N_ε + 1 := by
            rw [← hI₀_card]
            exact_mod_cast h_card_nat
          exact_mod_cast h_card_z
        have h_sqrt_nonneg : 0 ≤ Real.sqrt ε := Real.sqrt_nonneg ε
        calc (P.card : ℝ) * h ≤ (2 * (N_ε : ℝ) + 1) * h :=
              mul_le_mul_of_nonneg_right h_card_r hh_nonneg
          _ = 2 * ((N_ε : ℝ) * h) + h := by ring
          _ ≤ 2 * Real.sqrt ε + h := by linarith
          _ ≤ 6 * Real.sqrt ε + h := by linarith
    let P_pos := T.filter (fun p => 0 ≤ θ_α p)
    let P_neg := T.filter (fun p => θ_α p < 0)
    have hT_sub : T ⊆ P_pos ∪ P_neg := by
      intro p hp
      rw [Finset.mem_union, Finset.mem_filter, Finset.mem_filter]
      rcases le_or_gt 0 (θ_α p) with hge | hlt
      · exact Or.inl ⟨hp, hge⟩
      · exact Or.inr ⟨hp, hlt⟩
    have hT_card_nat : T.card ≤ P_pos.card + P_neg.card :=
      le_trans (Finset.card_le_card hT_sub) (Finset.card_union_le P_pos P_neg)
    have hT_card_r : (T.card : ℝ) ≤ (P_pos.card : ℝ) + (P_neg.card : ℝ) := by
      exact_mod_cast hT_card_nat
    have h_pos_bound : (P_pos.card : ℝ) * h ≤ 6 * Real.sqrt ε + h :=
      h_branch_bound P_pos (Finset.filter_subset _ T)
        (Or.inl (fun p hp => (Finset.mem_filter.mp hp).2))
    have h_neg_bound : (P_neg.card : ℝ) * h ≤ 6 * Real.sqrt ε + h :=
      h_branch_bound P_neg (Finset.filter_subset _ T)
        (Or.inr (fun p hp => le_of_lt (Finset.mem_filter.mp hp).2))
    calc (T.card : ℝ) * h ≤ ((P_pos.card : ℝ) + (P_neg.card : ℝ)) * h :=
          mul_le_mul_of_nonneg_right hT_card_r hh_nonneg
      _ = (P_pos.card : ℝ) * h + (P_neg.card : ℝ) * h := by ring
      _ ≤ (6 * Real.sqrt ε + h) + (6 * Real.sqrt ε + h) := add_le_add h_pos_bound h_neg_bound
      _ = 12 * Real.sqrt ε + 2 * h := by ring
  refine ⟨h_pou, ?_⟩
  intro α₀ γ ε hε S hS
  let S_cos := S.filter (fun p : ℤ => |Real.cos (2 * Real.pi * (p : ℝ) * h + α₀) - γ| ≤ ε)
  let S_sin := S.filter (fun p : ℤ => |Real.cos (2 * Real.pi * (p : ℝ) * h + (α₀ - Real.pi / 2)) - γ| ≤ ε)
  have hS_sub : S ⊆ S_cos ∪ S_sin := by
    intro p hp
    rw [Finset.mem_union, Finset.mem_filter, Finset.mem_filter]
    rcases (hS p hp).2 with hcos | hsin
    · exact Or.inl ⟨hp, hcos⟩
    · refine Or.inr ⟨hp, ?_⟩
      have h_eq : 2 * Real.pi * (p : ℝ) * h + (α₀ - Real.pi / 2) =
          (2 * Real.pi * (p : ℝ) * h + α₀) - Real.pi / 2 := by ring
      rw [h_eq, Real.cos_sub_pi_div_two]
      exact hsin
  have hS_card_nat : S.card ≤ S_cos.card + S_sin.card :=
    le_trans (Finset.card_le_card hS_sub) (Finset.card_union_le S_cos S_sin)
  have hS_card_r : (S.card : ℝ) ≤ (S_cos.card : ℝ) + (S_sin.card : ℝ) := by
    exact_mod_cast hS_card_nat
  have h_cos_b : (S_cos.card : ℝ) * h ≤ 12 * Real.sqrt ε + 2 * h :=
    h_cos_collar α₀ γ ε hε S_cos (fun p hp =>
      ⟨(hS p (Finset.mem_filter.mp hp).1).1, (Finset.mem_filter.mp hp).2⟩)
  have h_sin_b : (S_sin.card : ℝ) * h ≤ 12 * Real.sqrt ε + 2 * h :=
    h_cos_collar (α₀ - Real.pi / 2) γ ε hε S_sin (fun p hp =>
      ⟨(hS p (Finset.mem_filter.mp hp).1).1, (Finset.mem_filter.mp hp).2⟩)
  calc (S.card : ℝ) * h ≤ ((S_cos.card : ℝ) + (S_sin.card : ℝ)) * h :=
        mul_le_mul_of_nonneg_right hS_card_r hh_nonneg
    _ = (S_cos.card : ℝ) * h + (S_sin.card : ℝ) * h := by ring
    _ ≤ (12 * Real.sqrt ε + 2 * h) + (12 * Real.sqrt ε + 2 * h) := add_le_add h_cos_b h_sin_b
    _ = 24 * Real.sqrt ε + 4 * h := by ring

theorem mitsui_hat_box_partition_of_unity (r N : ℕ) (hN : 1 ≤ N)
    (h : ℝ) (hh_pos : 0 < h)
    (y : Fin r → ℝ) :
    (∑ p ∈ Fintype.piFinset (fun _ : Fin r => Finset.Icc (-(N : ℤ)) (N : ℤ)),
      ∏ j : Fin r, max (0 : ℝ) (1 - |y j - (p j : ℝ) * h| / h)) ≤ 1 ∧
    ((∀ j : Fin r, |y j| ≤ ((N : ℝ) - 1) * h) →
      ∑ p ∈ Fintype.piFinset (fun _ : Fin r => Finset.Icc (-(N : ℤ)) (N : ℤ)),
        ∏ j : Fin r, max (0 : ℝ) (1 - |y j - (p j : ℝ) * h| / h) = 1) :=
by
  classical
  let I_N : Finset ℤ := Finset.Icc (-(N : ℤ)) (N : ℤ)
  have hh_ne : h ≠ 0 := ne_of_gt hh_pos
  have h1d : ∀ x : ℝ,
      (0 ≤ ∑ p ∈ I_N, max (0 : ℝ) (1 - |x - (p : ℝ) * h| / h)) ∧
      (∑ p ∈ I_N, max (0 : ℝ) (1 - |x - (p : ℝ) * h| / h) ≤ 1) ∧
      (|x| ≤ ((N : ℝ) - 1) * h →
        ∑ p ∈ I_N, max (0 : ℝ) (1 - |x - (p : ℝ) * h| / h) = 1) := by
    intro x
    let t : ℝ := x / h
    let q : ℤ := Int.floor t
    let Λ : ℤ → ℝ := fun p => max (0 : ℝ) (1 - |t - (p : ℝ)|)
    have h_rescale : ∀ p : ℤ, max (0 : ℝ) (1 - |x - (p : ℝ) * h| / h) = Λ p := by
      intro p
      dsimp [Λ, t]
      have h_eq : x - (p : ℝ) * h = (x / h - (p : ℝ)) * h := by
        rw [sub_mul, div_mul_cancel₀ x hh_ne]
      rw [h_eq, abs_mul, abs_of_pos hh_pos, mul_div_cancel_right₀ _ hh_ne]
    have h_sum_eq : (∑ p ∈ I_N, max (0 : ℝ) (1 - |x - (p : ℝ) * h| / h)) = ∑ p ∈ I_N, Λ p :=
      Finset.sum_congr rfl (fun p _ => h_rescale p)
    rw [h_sum_eq]
    have hΛ_nonneg : ∀ p : ℤ, 0 ≤ Λ p := fun p => le_max_left 0 _
    have hq_le : (q : ℝ) ≤ t := Int.floor_le t
    have ht_lt : t < (q : ℝ) + 1 := Int.lt_floor_add_one t
    have hΛ_zero : ∀ p : ℤ, p ∉ ({q, q + 1} : Finset ℤ) → Λ p = 0 := by
      intro p hp
      rw [Finset.mem_insert, Finset.mem_singleton, not_or] at hp
      rcases hp with ⟨hp1, hp2⟩
      have h_cases : p ≤ q - 1 ∨ q + 2 ≤ p := by omega
      dsimp [Λ]
      apply max_eq_left
      rcases h_cases with h_le | h_ge
      · have h_cast : (p : ℝ) ≤ (q : ℝ) - 1 := by
          have := Int.cast_le (R := ℝ).mpr h_le
          push_cast at this
          linarith
        have h_diff : 1 ≤ t - (p : ℝ) := by linarith
        have h_abs : t - (p : ℝ) ≤ |t - (p : ℝ)| := le_abs_self _
        linarith
      · have h_cast : (q : ℝ) + 2 ≤ (p : ℝ) := by
          have := Int.cast_le (R := ℝ).mpr h_ge
          push_cast at this
          linarith
        have h_diff : 1 ≤ (p : ℝ) - t := by linarith
        have h_abs : - (t - (p : ℝ)) ≤ |t - (p : ℝ)| := neg_le_abs _
        linarith
    have hΛ_pair : ∑ p ∈ ({q, q + 1} : Finset ℤ), Λ p = 1 := by
      have h_ne : q ≠ q + 1 := by omega
      rw [Finset.sum_pair h_ne]
      have hΛ_q : Λ q = 1 - (t - (q : ℝ)) := by
        dsimp [Λ]
        have h1 : |t - (q : ℝ)| = t - (q : ℝ) := abs_of_nonneg (by linarith)
        rw [h1]
        exact max_eq_right (by linarith)
      have hΛ_q1 : Λ (q + 1) = t - (q : ℝ) := by
        dsimp [Λ]
        have h_cast : ((q + 1 : ℤ) : ℝ) = (q : ℝ) + 1 := by push_cast; ring
        rw [h_cast]
        have h1 : |t - ((q : ℝ) + 1)| = -(t - ((q : ℝ) + 1)) := abs_of_nonpos (by linarith)
        rw [h1]
        have h2 : 1 - -(t - ((q : ℝ) + 1)) = t - (q : ℝ) := by ring
        rw [h2]
        exact max_eq_right (by linarith)
      rw [hΛ_q, hΛ_q1]
      ring
    refine ⟨Finset.sum_nonneg (fun p _ => hΛ_nonneg p), ?_, ?_⟩
    · calc ∑ p ∈ I_N, Λ p
        _ ≤ ∑ p ∈ I_N ∪ ({q, q + 1} : Finset ℤ), Λ p :=
          Finset.sum_le_sum_of_subset_of_nonneg Finset.subset_union_left (fun p _ _ => hΛ_nonneg p)
        _ = ∑ p ∈ ({q, q + 1} : Finset ℤ), Λ p :=
          (Finset.sum_subset Finset.subset_union_right (fun p _ hp => hΛ_zero p hp)).symm
        _ = 1 := hΛ_pair
    · intro hx
      have hx_bounds := abs_le.mp hx
      have ht_lo : -((N : ℝ) - 1) ≤ t := by
        dsimp [t]
        rw [le_div_iff₀ hh_pos]
        linarith
      have ht_hi : t ≤ (N : ℝ) - 1 := by
        dsimp [t]
        rw [div_le_iff₀ hh_pos]
        linarith
      have hq_lo : -(N : ℤ) + 1 ≤ q := by
        apply Int.le_floor.mpr
        push_cast
        linarith
      have hq_hi : q ≤ (N : ℤ) - 1 := by
        have h_cast : (q : ℝ) ≤ (((N : ℤ) - 1 : ℤ) : ℝ) := by
          push_cast
          linarith
        exact Int.cast_le.mp h_cast
      have h_sub : ({q, q + 1} : Finset ℤ) ⊆ I_N := by
        intro p hp
        rw [Finset.mem_insert, Finset.mem_singleton] at hp
        dsimp [I_N]
        rw [Finset.mem_Icc]
        rcases hp with rfl | rfl <;> omega
      calc ∑ p ∈ I_N, Λ p
        _ = ∑ p ∈ ({q, q + 1} : Finset ℤ), Λ p :=
          (Finset.sum_subset h_sub (fun p _ hp => hΛ_zero p hp)).symm
        _ = 1 := hΛ_pair
  have h_fact :
      (∑ p ∈ Fintype.piFinset (fun _ : Fin r => I_N),
        ∏ j : Fin r, max (0 : ℝ) (1 - |y j - (p j : ℝ) * h| / h)) =
      ∏ j : Fin r, ∑ p ∈ I_N, max (0 : ℝ) (1 - |y j - (p : ℝ) * h| / h) := by
    exact (Finset.prod_univ_sum (fun _ : Fin r => I_N)
      (fun j (p_j : ℤ) => max (0 : ℝ) (1 - |y j - (p_j : ℝ) * h| / h))).symm
  change (∑ p ∈ Fintype.piFinset (fun _ : Fin r => I_N),
      ∏ j : Fin r, max (0 : ℝ) (1 - |y j - (p j : ℝ) * h| / h)) ≤ 1 ∧
    ((∀ j : Fin r, |y j| ≤ ((N : ℝ) - 1) * h) →
      ∑ p ∈ Fintype.piFinset (fun _ : Fin r => I_N),
        ∏ j : Fin r, max (0 : ℝ) (1 - |y j - (p j : ℝ) * h| / h) = 1)
  rw [h_fact]
  refine ⟨?_, ?_⟩
  · exact Finset.prod_le_one (fun j _ => (h1d (y j)).1) (fun j _ => (h1d (y j)).2.1)
  · intro hy
    have h_eq_one : ∀ j ∈ (Finset.univ : Finset (Fin r)),
        (∑ p ∈ I_N, max (0 : ℝ) (1 - |y j - (p : ℝ) * h| / h)) = 1 :=
      fun j _ => (h1d (y j)).2.2 (hy j)
    rw [Finset.prod_congr rfl h_eq_one, Finset.prod_const_one]

theorem mitsui_periodic_hat_eq_unique_int_shift (r : ℕ) (h : ℝ) (hh_pos : 0 < h) (hh_le : h ≤ 1 / 2)
    (v : Fin r → ℝ) (p : Fin r → ℤ) :
    (∏ j : Fin r,
      max (0 : ℝ)
        (1 - |v j + ((-Int.floor (v j - (p j : ℝ) * h + 1 / 2) : ℤ) : ℝ) - (p j : ℝ) * h| / h) =
      ∏ j : Fin r,
        max (0 : ℝ)
          (1 - |v j - (p j : ℝ) * h - (Int.floor (v j - (p j : ℝ) * h + 1 / 2) : ℝ)| / h)) ∧
    (∀ e : Fin r → ℤ,
      e ≠ (fun j => -Int.floor (v j - (p j : ℝ) * h + 1 / 2)) →
      ∏ j : Fin r, max (0 : ℝ) (1 - |v j + (e j : ℝ) - (p j : ℝ) * h| / h) = 0) ∧
    (∀ e : Fin r → ℤ,
      0 < ∏ j : Fin r, max (0 : ℝ) (1 - |v j + (e j : ℝ) - (p j : ℝ) * h| / h) →
      ∀ j : Fin r, |v j + (e j : ℝ) - (p j : ℝ) * h| ≤ h) :=
by
  refine ⟨?_, ?_, ?_⟩
  · refine Finset.prod_congr rfl (fun j _ => ?_)
    have h_eq :
        v j + ((-Int.floor (v j - (p j : ℝ) * h + 1 / 2) : ℤ) : ℝ) - (p j : ℝ) * h =
        v j - (p j : ℝ) * h - (Int.floor (v j - (p j : ℝ) * h + 1 / 2) : ℝ) := by
      push_cast
      ring
    rw [h_eq]
  · intro e he
    obtain ⟨j₀, hj₀⟩ := Function.ne_iff.mp he
    set x₀ : ℝ := v j₀ - (p j₀ : ℝ) * h with hx₀_def
    set q₀ : ℤ := Int.floor (x₀ + 1 / 2)
    have h_ne : e j₀ ≠ -q₀ := hj₀
    have h_fl_le : (q₀ : ℝ) ≤ x₀ + 1 / 2 := Int.floor_le (x₀ + 1 / 2)
    have h_fl_lt : x₀ + 1 / 2 < (q₀ : ℝ) + 1 := Int.lt_floor_add_one (x₀ + 1 / 2)
    have h_cases : e j₀ + q₀ ≤ -1 ∨ 1 ≤ e j₀ + q₀ := by omega
    have h_abs_ge : 1 / 2 ≤ |v j₀ + (e j₀ : ℝ) - (p j₀ : ℝ) * h| := by
      rcases h_cases with h_le | h_ge
      · have h_le_R : ((e j₀ + q₀ : ℤ) : ℝ) ≤ ((-1 : ℤ) : ℝ) := Int.cast_le.mpr h_le
        push_cast at h_le_R
        have h_neg := neg_le_abs (v j₀ + (e j₀ : ℝ) - (p j₀ : ℝ) * h)
        linarith
      · have h_ge_R : ((1 : ℤ) : ℝ) ≤ ((e j₀ + q₀ : ℤ) : ℝ) := Int.cast_le.mpr h_ge
        push_cast at h_ge_R
        have h_pos := le_abs_self (v j₀ + (e j₀ : ℝ) - (p j₀ : ℝ) * h)
        linarith
    have h_div_ge : 1 ≤ |v j₀ + (e j₀ : ℝ) - (p j₀ : ℝ) * h| / h := by
      rw [le_div_iff₀ hh_pos]
      linarith
    have h_fac_zero : max (0 : ℝ) (1 - |v j₀ + (e j₀ : ℝ) - (p j₀ : ℝ) * h| / h) = 0 :=
      max_eq_left (by linarith)
    exact Finset.prod_eq_zero (Finset.mem_univ j₀) h_fac_zero
  · intro e h_prod_pos j
    by_contra h_not_le
    push_neg at h_not_le
    have h_div_gt : 1 < |v j + (e j : ℝ) - (p j : ℝ) * h| / h := by
      rw [lt_div_iff₀ hh_pos]
      linarith
    have h_fac_zero : max (0 : ℝ) (1 - |v j + (e j : ℝ) - (p j : ℝ) * h| / h) = 0 :=
      max_eq_left (by linarith)
    have h_prod_zero : ∏ i : Fin r, max (0 : ℝ) (1 - |v i + (e i : ℝ) - (p i : ℝ) * h| / h) = 0 :=
      Finset.prod_eq_zero (Finset.mem_univ j) h_fac_zero
    linarith

theorem mitsui_hat_grid_main_and_collar_card_bound {α : Type u} [Fintype α] (w₀ : α)
    (r : ℕ) (h_rank : 0 < r)
    (h_card : Nat.card {w : α // w ≠ w₀} = r)
    (M_K C_L B h : ℝ)
    (hM_K_pos : 0 < M_K) (hC_L_pos : 0 < C_L) (hB_pos : 0 < B)
    (hh_pos : 0 < h) (hh_le : h ≤ 1 / 2)
    (L : α → Fin r → ℝ)
    (hM_K : ∀ (y : Fin r → ℝ) (B₀ : ℝ),
      0 ≤ B₀ →
      (∀ w : α, w ≠ w₀ → |∑ j : Fin r, y j * L w j| ≤ B₀) →
      ∀ i : Fin r, |y i| ≤ M_K * B₀)
    (a b : α → ℝ)
    (hab : ∀ w : α, w ≠ w₀ → a w ≤ b w ∧ b w - a w ≤ B)
    (S_main S_collar : Finset (Fin r → ℤ))
    (hS_main : ∀ p ∈ S_main, ∀ w : α, w ≠ w₀ →
      ∑ j : Fin r, (p j : ℝ) * h * L w j ∈ Set.Ioc (a w - C_L * h) (b w + C_L * h))
    (hS_collar : ∀ p ∈ S_collar,
      (∀ w : α, w ≠ w₀ →
        ∑ j : Fin r, (p j : ℝ) * h * L w j ∈ Set.Ioc (a w - C_L * h) (b w + C_L * h)) ∧
      (∃ w : α, w ≠ w₀ ∧
        ∑ j : Fin r, (p j : ℝ) * h * L w j ∉ Set.Ioc (a w + C_L * h) (b w - C_L * h))) :
    (S_main.card : ℝ) * h ^ r ≤ (2 * M_K + 4 * M_K * C_L + 2) ^ r * (B + 1) ^ r ∧
    (S_collar.card : ℝ) * h ^ r ≤
      (r : ℝ) * (8 * M_K * C_L + 4) * (2 * M_K + 4 * M_K * C_L + 2) ^ r * h * (B + 1) ^ r :=
by
  classical
  let ι := {w : α // w ≠ w₀}
  have hcard_ι : (Finset.univ : Finset ι).card = r := by
    rw [Finset.card_univ, ← Nat.card_eq_fintype_card]
    exact h_card
  let ℓ : ℝ := h / (2 * M_K)
  have hℓ_pos : 0 < ℓ := by dsimp [ℓ]; positivity
  have hℓ_nonneg : 0 ≤ ℓ := le_of_lt hℓ_pos
  have hh_nonneg : 0 ≤ h := le_of_lt hh_pos
  have hh_ne : h ≠ 0 := ne_of_gt hh_pos
  have hM_ne : M_K ≠ 0 := ne_of_gt hM_K_pos
  let u : (Fin r → ℤ) → α → ℝ := fun p w => ∑ j : Fin r, (p j : ℝ) * h * L w j
  let Ψ : (Fin r → ℤ) → (ι → ℤ) := fun p w => Int.floor (u p w.1 / ℓ)
  have hΨ_inj : Function.Injective Ψ := by
    intro p p' hΨ
    have h_diff_le : ∀ w : α, w ≠ w₀ →
        |∑ j : Fin r, ((p j : ℝ) * h - (p' j : ℝ) * h) * L w j| ≤ ℓ := by
      intro w hw
      let w' : ι := ⟨w, hw⟩
      have h_fl : Int.floor (u p w / ℓ) = Int.floor (u p' w / ℓ) := congrFun hΨ w'
      have hx1 : (Int.floor (u p w / ℓ) : ℝ) ≤ u p w / ℓ := Int.floor_le (u p w / ℓ)
      have hx2 : u p w / ℓ < (Int.floor (u p w / ℓ) : ℝ) + 1 := Int.lt_floor_add_one (u p w / ℓ)
      have hy1 : (Int.floor (u p' w / ℓ) : ℝ) ≤ u p' w / ℓ := Int.floor_le (u p' w / ℓ)
      have hy2 : u p' w / ℓ < (Int.floor (u p' w / ℓ) : ℝ) + 1 := Int.lt_floor_add_one (u p' w / ℓ)
      have h_fl_R : (Int.floor (u p w / ℓ) : ℝ) = (Int.floor (u p' w / ℓ) : ℝ) := by
        exact_mod_cast h_fl
      have h_sub_div : (u p w - u p' w) / ℓ = u p w / ℓ - u p' w / ℓ := sub_div _ _ _
      have h_div_ge : -1 ≤ (u p w - u p' w) / ℓ := by linarith
      have h_div_le : (u p w - u p' w) / ℓ ≤ 1 := by linarith
      have h_u_ge : -ℓ ≤ u p w - u p' w := by
        have := (le_div_iff₀ hℓ_pos).mp h_div_ge
        linarith
      have h_u_le : u p w - u p' w ≤ ℓ := by
        have := (div_le_iff₀ hℓ_pos).mp h_div_le
        linarith
      have h_sum_eq : ∑ j : Fin r, ((p j : ℝ) * h - (p' j : ℝ) * h) * L w j = u p w - u p' w := by
        dsimp [u]
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        ring
      rw [h_sum_eq]
      exact abs_le.mpr ⟨h_u_ge, h_u_le⟩
    have h_coord := hM_K (fun j => (p j : ℝ) * h - (p' j : ℝ) * h) ℓ hℓ_nonneg h_diff_le
    funext i
    have hi := h_coord i
    have hMℓ : M_K * ℓ = h / 2 := by
      dsimp [ℓ]
      field_simp [hM_ne]
    rw [hMℓ] at hi
    have h_abs_eq : |(p i : ℝ) * h - (p' i : ℝ) * h| = ((|p i - p' i| : ℤ) : ℝ) * h := by
      rw [← sub_mul, ← Int.cast_sub, abs_mul, abs_of_pos hh_pos, Int.cast_abs]
    rw [h_abs_eq] at hi
    have h_lt_h : ((|p i - p' i| : ℤ) : ℝ) * h < ((1 : ℤ) : ℝ) * h := by
      rw [Int.cast_one]
      linarith
    have h_lt_one_R : ((|p i - p' i| : ℤ) : ℝ) < ((1 : ℤ) : ℝ) :=
      lt_of_mul_lt_mul_right h_lt_h hh_nonneg
    have h_lt_one : |p i - p' i| < 1 := Int.cast_lt.mp h_lt_one_R
    have h_le_abs : p i - p' i ≤ |p i - p' i| := le_abs_self _
    have h_neg_le_abs : -(p i - p' i) ≤ |p i - p' i| := neg_le_abs _
    omega
  have h_icc_card : ∀ α₀ β₀ : ℝ, α₀ ≤ β₀ →
      ((Finset.Icc (Int.floor α₀) (Int.floor β₀)).card : ℝ) ≤ (β₀ - α₀) + 2 := by
    intro α₀ β₀ hαβ
    have h_mono : Int.floor α₀ ≤ Int.floor β₀ := Int.floor_mono hαβ
    have h_nonneg : 0 ≤ Int.floor β₀ + 1 - Int.floor α₀ := by omega
    have h_card_Z : ((Finset.Icc (Int.floor α₀) (Int.floor β₀)).card : ℤ) =
        Int.floor β₀ + 1 - Int.floor α₀ := by
      rw [Int.card_Icc, Int.toNat_of_nonneg h_nonneg]
    have h_card_R : ((Finset.Icc (Int.floor α₀) (Int.floor β₀)).card : ℝ) =
        (Int.floor β₀ : ℝ) + 1 - (Int.floor α₀ : ℝ) := by
      exact_mod_cast h_card_Z
    have h1 : (Int.floor β₀ : ℝ) ≤ β₀ := Int.floor_le β₀
    have h2 : α₀ - 1 < (Int.floor α₀ : ℝ) := Int.sub_one_lt_floor α₀
    linarith
  let C_2 : ℝ := 2 * M_K + 4 * M_K * C_L + 2
  let K_end : ℝ := 8 * M_K * C_L + 4
  have hC_2_pos : 0 < C_2 := by dsimp [C_2]; positivity
  have hK_end_pos : 0 < K_end := by dsimp [K_end]; positivity
  let I_full : ι → Finset ℤ := fun w =>
    Finset.Icc (Int.floor ((a w.1 - C_L * h) / ℓ)) (Int.floor ((b w.1 + C_L * h) / ℓ))
  let I_left : ι → Finset ℤ := fun w =>
    Finset.Icc (Int.floor ((a w.1 - C_L * h) / ℓ)) (Int.floor ((a w.1 + C_L * h) / ℓ))
  let I_right : ι → Finset ℤ := fun w =>
    Finset.Icc (Int.floor ((b w.1 - C_L * h) / ℓ)) (Int.floor ((b w.1 + C_L * h) / ℓ))
  let I_end : ι → Finset ℤ := fun w => I_left w ∪ I_right w
  have h_mem_full : ∀ (p : Fin r → ℤ) (w : ι),
      u p w.1 ∈ Set.Ioc (a w.1 - C_L * h) (b w.1 + C_L * h) → Ψ p w ∈ I_full w := by
    intro p w hu
    rw [Set.mem_Ioc] at hu
    dsimp [I_full, Ψ]
    rw [Finset.mem_Icc]
    refine ⟨Int.floor_mono ?_, Int.floor_mono ?_⟩
    · exact div_le_div_of_nonneg_right (le_of_lt hu.1) hℓ_nonneg
    · exact div_le_div_of_nonneg_right hu.2 hℓ_nonneg
  have h_card_full : ∀ w : ι, ((I_full w).card : ℝ) * h ≤ C_2 * (B + 1) := by
    intro w
    have hab_w := hab w.1 w.2
    have h_le : (a w.1 - C_L * h) / ℓ ≤ (b w.1 + C_L * h) / ℓ := by
      apply div_le_div_of_nonneg_right _ hℓ_nonneg
      linarith [hab_w.1, mul_pos hC_L_pos hh_pos]
    have h_icc := h_icc_card ((a w.1 - C_L * h) / ℓ) ((b w.1 + C_L * h) / ℓ) h_le
    have h_mul := mul_le_mul_of_nonneg_right h_icc hh_nonneg
    have h_alg : (((b w.1 + C_L * h) / ℓ - (a w.1 - C_L * h) / ℓ) + 2) * h =
        2 * M_K * (b w.1 - a w.1) + (4 * M_K * C_L + 2) * h := by
      dsimp [ℓ]
      field_simp [hh_ne, hM_ne]
      ring
    rw [h_alg] at h_mul
    have h1 : 2 * M_K * (b w.1 - a w.1) ≤ 2 * M_K * (B + 1) := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      linarith [hab_w.2]
    have h2 : (4 * M_K * C_L + 2) * h ≤ (4 * M_K * C_L + 2) * (B + 1) := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      linarith [hh_le, hB_pos]
    dsimp [C_2]
    linarith
  have h_mem_end : ∀ (p : Fin r → ℤ) (w : ι),
      u p w.1 ∈ Set.Ioc (a w.1 - C_L * h) (b w.1 + C_L * h) →
      u p w.1 ∉ Set.Ioc (a w.1 + C_L * h) (b w.1 - C_L * h) →
      Ψ p w ∈ I_end w := by
    intro p w hu_out hu_in
    rw [Set.mem_Ioc] at hu_out hu_in
    dsimp [I_end]
    rcases le_or_gt (u p w.1) (a w.1 + C_L * h) with h_le | h_gt
    · apply Finset.mem_union_left
      dsimp [I_left, Ψ]
      rw [Finset.mem_Icc]
      refine ⟨Int.floor_mono ?_, Int.floor_mono ?_⟩
      · exact div_le_div_of_nonneg_right (le_of_lt hu_out.1) hℓ_nonneg
      · exact div_le_div_of_nonneg_right h_le hℓ_nonneg
    · apply Finset.mem_union_right
      have h_gt_b : b w.1 - C_L * h < u p w.1 := by
        by_contra h_le_b
        push_neg at h_le_b
        exact hu_in ⟨h_gt, h_le_b⟩
      dsimp [I_right, Ψ]
      rw [Finset.mem_Icc]
      refine ⟨Int.floor_mono ?_, Int.floor_mono ?_⟩
      · exact div_le_div_of_nonneg_right (le_of_lt h_gt_b) hℓ_nonneg
      · exact div_le_div_of_nonneg_right hu_out.2 hℓ_nonneg
  have h_card_end : ∀ w : ι, ((I_end w).card : ℝ) ≤ K_end := by
    intro w
    have h_union : ((I_end w).card : ℝ) ≤ ((I_left w).card : ℝ) + ((I_right w).card : ℝ) := by
      exact_mod_cast Finset.card_union_le (I_left w) (I_right w)
    have h_left_le : (a w.1 - C_L * h) / ℓ ≤ (a w.1 + C_L * h) / ℓ := by
      apply div_le_div_of_nonneg_right _ hℓ_nonneg
      linarith [mul_pos hC_L_pos hh_pos]
    have h_left_card := h_icc_card ((a w.1 - C_L * h) / ℓ) ((a w.1 + C_L * h) / ℓ) h_left_le
    have h_left_alg : ((a w.1 + C_L * h) / ℓ - (a w.1 - C_L * h) / ℓ) + 2 = 4 * M_K * C_L + 2 := by
      dsimp [ℓ]
      field_simp [hh_ne, hM_ne]
      ring
    rw [h_left_alg] at h_left_card
    have h_right_le : (b w.1 - C_L * h) / ℓ ≤ (b w.1 + C_L * h) / ℓ := by
      apply div_le_div_of_nonneg_right _ hℓ_nonneg
      linarith [mul_pos hC_L_pos hh_pos]
    have h_right_card := h_icc_card ((b w.1 - C_L * h) / ℓ) ((b w.1 + C_L * h) / ℓ) h_right_le
    have h_right_alg : ((b w.1 + C_L * h) / ℓ - (b w.1 - C_L * h) / ℓ) + 2 = 4 * M_K * C_L + 2 := by
      dsimp [ℓ]
      field_simp [hh_ne, hM_ne]
      ring
    rw [h_right_alg] at h_right_card
    dsimp [K_end]
    linarith
  have h_main_bound : (S_main.card : ℝ) * h ^ r ≤ C_2 ^ r * (B + 1) ^ r := by
    have h_maps : Set.MapsTo Ψ (S_main : Set (Fin r → ℤ)) (Fintype.piFinset I_full : Set (ι → ℤ)) := by
      intro p hp
      rw [Finset.mem_coe, Fintype.mem_piFinset]
      intro w
      exact h_mem_full p w (hS_main p hp w.1 w.2)
    have h_card_le_nat : S_main.card ≤ (Fintype.piFinset I_full).card :=
      Finset.card_le_card_of_injOn Ψ h_maps hΨ_inj.injOn
    rw [Fintype.card_piFinset] at h_card_le_nat
    have h_card_le : (S_main.card : ℝ) ≤ ∏ w : ι, ((I_full w).card : ℝ) := by
      exact_mod_cast h_card_le_nat
    have hh_pow : (∏ _w : ι, h) = h ^ r := by
      rw [Finset.prod_const, hcard_ι]
    calc (S_main.card : ℝ) * h ^ r
      _ ≤ (∏ w : ι, ((I_full w).card : ℝ)) * h ^ r :=
          mul_le_mul_of_nonneg_right h_card_le (by positivity)
      _ = (∏ w : ι, ((I_full w).card : ℝ)) * (∏ _w : ι, h) := by rw [hh_pow]
      _ = ∏ w : ι, (((I_full w).card : ℝ) * h) := (Finset.prod_mul_distrib).symm
      _ ≤ ∏ _w : ι, (C_2 * (B + 1)) := by
          refine Finset.prod_le_prod (fun w _ => by positivity) (fun w _ => h_card_full w)
      _ = (C_2 * (B + 1)) ^ r := by rw [Finset.prod_const, hcard_ι]
      _ = C_2 ^ r * (B + 1) ^ r := mul_pow C_2 (B + 1) r
  let Slab : ι → Finset (ι → ℤ) := fun w₁ =>
    Fintype.piFinset (fun w : ι => if w = w₁ then I_end w₁ else I_full w)
  have h_collar_bound : (S_collar.card : ℝ) * h ^ r ≤
      (r : ℝ) * K_end * C_2 ^ r * h * (B + 1) ^ r := by
    have h_maps : Set.MapsTo Ψ (S_collar : Set (Fin r → ℤ))
        (Finset.univ.biUnion Slab : Set (ι → ℤ)) := by
      intro p hp
      rw [Finset.mem_coe, Finset.mem_biUnion]
      obtain ⟨h_all, w₁, hw₁_ne, hw₁_not⟩ := hS_collar p hp
      refine ⟨⟨w₁, hw₁_ne⟩, Finset.mem_univ _, ?_⟩
      dsimp [Slab]
      rw [Fintype.mem_piFinset]
      intro w
      split_ifs with hww₁
      · subst hww₁
        exact h_mem_end p ⟨w₁, hw₁_ne⟩ (h_all w₁ hw₁_ne) hw₁_not
      · exact h_mem_full p w (h_all w.1 w.2)
    have h_card_le_nat : S_collar.card ≤ ∑ w₁ : ι, (Slab w₁).card := by
      calc S_collar.card ≤ (Finset.univ.biUnion Slab).card :=
            Finset.card_le_card_of_injOn Ψ h_maps hΨ_inj.injOn
        _ ≤ ∑ w₁ : ι, (Slab w₁).card := Finset.card_biUnion_le
    have h_card_le : (S_collar.card : ℝ) ≤ ∑ w₁ : ι, ((Slab w₁).card : ℝ) := by
      exact_mod_cast h_card_le_nat
    have h_slab_bound : ∀ w₁ : ι, ((Slab w₁).card : ℝ) * h ^ r ≤ K_end * C_2 ^ r * h * (B + 1) ^ r := by
      intro w₁
      let f : ι → ℝ := fun w => (((if w = w₁ then I_end w₁ else I_full w).card : ℕ) : ℝ) * h
      have h_slab_card : ((Slab w₁).card : ℝ) =
          ∏ w : ι, (((if w = w₁ then I_end w₁ else I_full w).card : ℕ) : ℝ) := by
        dsimp [Slab]
        rw [Fintype.card_piFinset]
        push_cast
        rfl
      have hh_pow : (∏ _w : ι, h) = h ^ r := by
        rw [Finset.prod_const, hcard_ι]
      have h_prod_eq : ((Slab w₁).card : ℝ) * h ^ r = ∏ w : ι, f w := by
        rw [h_slab_card, ← hh_pow, ← Finset.prod_mul_distrib]
      have h_erase : (∏ w : ι, f w) = f w₁ * ∏ w ∈ Finset.univ.erase w₁, f w := by
        exact (Finset.mul_prod_erase Finset.univ f (Finset.mem_univ w₁)).symm
      have hfw₁ : f w₁ ≤ K_end * h := by
        dsimp [f]
        rw [if_pos rfl]
        exact mul_le_mul_of_nonneg_right (h_card_end w₁) hh_nonneg
      have h_erase_prod : (∏ w ∈ Finset.univ.erase w₁, f w) ≤ C_2 ^ r * (B + 1) ^ r := by
        have h_le1 : (∏ w ∈ Finset.univ.erase w₁, f w) ≤
            ∏ _w ∈ Finset.univ.erase w₁, (C_2 * (B + 1)) := by
          refine Finset.prod_le_prod (fun w _ => by dsimp [f]; positivity) (fun w hw => ?_)
          have hw_ne : w ≠ w₁ := Finset.ne_of_mem_erase hw
          dsimp [f]
          rw [if_neg hw_ne]
          exact h_card_full w
        rw [Finset.prod_const] at h_le1
        have h_one_le : 1 ≤ C_2 * (B + 1) := by
          have : 1 ≤ C_2 := by dsimp [C_2]; linarith [hM_K_pos, mul_pos hM_K_pos hC_L_pos]
          have : 1 ≤ B + 1 := by linarith [hB_pos]
          nlinarith
        have h_card_erase : (Finset.univ.erase w₁).card ≤ r := by
          calc (Finset.univ.erase w₁).card ≤ (Finset.univ : Finset ι).card := Finset.card_erase_le
            _ = r := hcard_ι
        have h_pow_le : (C_2 * (B + 1)) ^ (Finset.univ.erase w₁).card ≤ (C_2 * (B + 1)) ^ r :=
          pow_le_pow_right₀ h_one_le h_card_erase
        calc (∏ w ∈ Finset.univ.erase w₁, f w)
          _ ≤ (C_2 * (B + 1)) ^ (Finset.univ.erase w₁).card := h_le1
          _ ≤ (C_2 * (B + 1)) ^ r := h_pow_le
          _ = C_2 ^ r * (B + 1) ^ r := mul_pow C_2 (B + 1) r
      have h_erased_nonneg : 0 ≤ ∏ w ∈ Finset.univ.erase w₁, f w := by
        refine Finset.prod_nonneg (fun w _ => by dsimp [f]; positivity)
