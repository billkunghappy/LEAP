          ∫ v in Set.Ioi (0 : ℝ),
            (v : ℂ) ^ (z + ((a_place w_sub.1 : ℝ) / 2 : ℂ) + ((ν_place w_sub.1 : ℝ) / 2 : ℂ) * Complex.I) *
