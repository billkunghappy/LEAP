          Finset.sum_congr rfl (fun v hv_mem => h_ne_dir v (Finset.ne_of_mem_erase hv_mem))
        linarith
      · exact h_ne_dir v hv
    have h_all : ∀ v : NumberField.InfinitePlace K, ℓ x v = r_x v := by
      intro v
