    have h_star := congrArg star h_primal
    have h_star_wz : star ((w z : ℂ)) = (w z : ℂ) := by
      rw [RCLike.star_def, Complex.conj_ofReal]
    rw [star_mul, star_pow, h_star_wz, star_pow, mul_comm] at h_star
    exact h_star
  have h_prod : ∀ (z : K), z ≠ 0 → ∀ (u : NumberField.InfinitePlace K → ℝ),
      (∏ w : NumberField.InfinitePlace K, (w.embedding z / (w z : ℂ)) ^ (l_eff w)) *
        (((∏ w : NumberField.InfinitePlace K, (w z * u w) ^ (a_place w)) : ℝ) : ℂ) =
      (∏ w : NumberField.InfinitePlace K, (Φ_emb w z * (u w : ℂ)) ^ (a_place w)) ∧
      (∏ w : NumberField.InfinitePlace K, star ((w.embedding z / (w z : ℂ)) ^ (l_eff w))) *
