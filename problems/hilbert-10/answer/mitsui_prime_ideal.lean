  obtain ⟨c_low, hc_low_def⟩ : ∃ c_low : ℝ,
      c_low = (c_gen * (2 : ℝ) ^ (NumberField.Units.rank K) * (c₁ + 1) + C_vol) *
        Real.exp 1 * Real.exp 1 := ⟨_, rfl⟩
  have hc_low_pos : 0 < c_low := by rw [hc_low_def]; positivity
  obtain ⟨c₀, hc₀_def⟩ : ∃ c₀ : ℝ, c₀ = c_ray + c_coord + c_low + 1 := ⟨_, rfl⟩
