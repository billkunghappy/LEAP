  have hξ_norm : ∀ pm : D_Y, ‖ξ pm‖ ≤ 1 := by
    intro pm
    dsimp [ξ]
    rw [norm_pow]
    exact pow_le_one₀ (norm_nonneg _) (hχ'_norm ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩)
  have hξw_norm : ∀ pm : D_Y, ‖ξ pm * (w_riesz pm : ℂ)‖ ≤ w_riesz pm := by
    intro pm
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hw_nonneg pm)]
    exact mul_le_of_le_one_left (hw_nonneg pm) (hξ_norm pm)
  let r : ℕ := NumberField.Units.rank K
  let S_M : Finset (Fin r → ℤ) :=
    Fintype.piFinset (fun _ : Fin r => Finset.Icc (-(M : ℤ)) (M : ℤ))
  have h0_mem : (0 : Fin r → ℤ) ∈ S_M := by
    rw [Fintype.mem_piFinset]
    intro j
    rw [Pi.zero_apply, Finset.mem_Icc]
    omega
  have hIcc_card : (Finset.Icc (-(M : ℤ)) (M : ℤ)).card = 2 * M + 1 := by
    rw [Int.card_Icc]
    omega
  have hS_M_card_nat : S_M.card = (2 * M + 1) ^ r := by
    dsimp [S_M]
    rw [Fintype.card_piFinset_const, hIcc_card]
  have hS_M_card : (S_M.card : ℝ) = (2 * (M : ℝ) + 1) ^ r := by
    rw [hS_M_card_nat]
