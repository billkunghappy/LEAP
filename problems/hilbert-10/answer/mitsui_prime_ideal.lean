        Complex.Gammaℂ (z + ((l_cplx p_idx : ℝ) / 2 : ℂ) + ((v_place (e_cplx.symm p_idx).1 : ℝ) / 2 : ℂ) * Complex.I)) =
      (∏ p_idx : Fin (NumberField.InfinitePlace.nrComplexPlaces K),
        Complex.Gammaℂ (z + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)) := by
    refine Finset.prod_congr rfl (fun p_idx _ => ?_)
    congr 1
    dsimp [v_cplx]
    push_cast
    ring
  rw [h_prod_real, h_prod_cplx]

theorem mitsui_grossenchar_series_continuousOn_and_norm_le_of_kernel_exp_bound {K : Type u} [Field K] [NumberField K]
    (ψ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hψ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖ψ I‖ ≤ 1)
    (κ : ℂ) (hκ : ‖κ‖ = 1)
    (W_c : ℝ → ℂ) (W_maj : ℝ → ℝ) (C₀ c α : ℝ) (hC₀ : 0 < C₀) (hc : 0 < c) (hα : 0 < α)
    (hW_cont : ContinuousOn W_c (Set.Ioi (1 : ℝ)))
    (hW_nn : ∀ t : ℝ, 0 ≤ W_maj t)
    (hW_le : ∀ t ∈ Set.Ioi (0 : ℝ), ‖W_c t‖ ≤ W_maj t)
    (hW_bound : ∀ t ∈ Set.Ioi (1 : ℝ), W_maj t ≤ C₀ * Real.exp (-2 * c * t ^ α)) :
    ContinuousOn
      (fun u : ℝ => κ * ∑' m : ℕ,
        (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
          ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
          ((m : ℂ) * W_c ((m : ℝ) * u)))
      (Set.Ioi (1 : ℝ)) ∧
    (∀ u ∈ Set.Ioi (1 : ℝ),
      ‖κ * ∑' m : ℕ,
        (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
          ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
          ((m : ℂ) * W_c ((m : ℝ) * u))‖ ≤
      ∑' m : ℕ,
        (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm I = m} : ℝ) *
          (m : ℝ) * W_maj ((m : ℝ) * u)) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let S : ℕ → Type u := fun m => {I : Ideal R // Ideal.absNorm I = m}
  let S' : ℕ → Type u := fun m => {I : Ideal R // I ≠ ⊥ ∧ Ideal.absNorm I = m}
  let a_K : ℕ → ℕ := fun m => Nat.card (S m)
  let a_ψ : ℕ → ℂ := fun m =>
    ∑' I : S' m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩
  let f : ℕ → ℝ → ℝ := fun m u => (a_K m : ℝ) * (m : ℝ) * W_maj ((m : ℝ) * u)
  let g : ℕ → ℝ → ℂ := fun m u => a_ψ m * ((m : ℂ) * W_c ((m : ℝ) * u))
  have hS_fin : ∀ m : ℕ, Finite (S m) := fun m => Ideal.finite_setOf_absNorm_eq m
  have hS'_fin : ∀ m : ℕ, Finite (S' m) := fun m =>
    (Ideal.finite_setOf_absNorm_eq m).subset (fun _ h => h.2)
  letI : ∀ m, Fintype (S m) := fun m => Fintype.ofFinite (S m)
  letI : ∀ m, Fintype (S' m) := fun m => Fintype.ofFinite (S' m)
  have ha_ψ_bound : ∀ m : ℕ, ‖a_ψ m‖ ≤ (a_K m : ℝ) := by
    intro m
    dsimp [a_ψ, a_K]
    rw [tsum_fintype]
    have h_inj : Function.Injective (fun I : S' m => (⟨I.1, I.2.2⟩ : S m)) :=
      fun a b h => Subtype.ext (congrArg (fun x : S m => x.1) h)
    have h_card : (Nat.card (S' m) : ℝ) ≤ (Nat.card (S m) : ℝ) := by
      exact_mod_cast Nat.card_le_card_of_injective _ h_inj
    calc ‖∑ I : S' m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖
        ≤ ∑ I : S' m, ‖ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖ := norm_sum_le _ _
      _ ≤ ∑ _I : S' m, (1 : ℝ) := Finset.sum_le_sum (fun I _ => hψ_norm _)
      _ = (Nat.card (S' m) : ℝ) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one, ← Nat.card_eq_fintype_card]
      _ ≤ (Nat.card (S m) : ℝ) := h_card
  have hf_nn : ∀ (m : ℕ) (u : ℝ), 0 ≤ f m u := by
    intro m u
    dsimp [f]
    exact mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)) (hW_nn _)
  have hg_norm_le_f : ∀ (m : ℕ), ∀ u ∈ Set.Ioi (1 : ℝ), ‖g m u‖ ≤ f m u := by
    intro m u hu
    by_cases hm0 : m = 0
    · subst hm0
      dsimp [g, f]
      simp
    · have hm_pos : (0 : ℝ) < (m : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hm0)
      have hu_pos : 0 < u := lt_trans zero_lt_one (Set.mem_Ioi.mp hu)
      have hmu_pos : (m : ℝ) * u ∈ Set.Ioi (0 : ℝ) := mul_pos hm_pos hu_pos
      dsimp [g, f]
      rw [norm_mul, norm_mul, Complex.norm_natCast, mul_assoc]
      have h_mW_le : (m : ℝ) * ‖W_c ((m : ℝ) * u)‖ ≤ (m : ℝ) * W_maj ((m : ℝ) * u) :=
        mul_le_mul_of_nonneg_left (hW_le ((m : ℝ) * u) hmu_pos) (le_of_lt hm_pos)
      exact mul_le_mul (ha_ψ_bound m) h_mW_le (by positivity) (Nat.cast_nonneg _)
  have h_ideal_card : ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ x : ℝ, 1 ≤ x →
      (Nat.card {J : Ideal (NumberField.RingOfIntegers K) // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤
        C₁ * x := by
    set L_K : ℝ :=
      2 ^ NumberField.InfinitePlace.nrRealPlaces K *
        (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
        NumberField.Units.regulator K *
        (NumberField.classNumber K : ℝ) /
        ((NumberField.Units.torsionOrder K : ℝ) * Real.sqrt |(NumberField.discr K : ℝ)|)
    have h_tendsto : Filter.Tendsto
        (fun x : ℝ => (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x)
        Filter.atTop (nhds L_K) :=
      NumberField.Ideal.tendsto_norm_le_div_atTop K
    obtain ⟨S₀, hS₀⟩ := (Metric.tendsto_atTop.mp h_tendsto) 1 zero_lt_one
    let S₁ : ℝ := max S₀ 1
    let N₁ : ℕ := Nat.card {J : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm J ≤ ⌊S₁⌋₊}
    let C₁ : ℝ := max (|L_K| + 1) ((N₁ : ℝ) + 1)
    have hC₁_pos : 0 < C₁ := by
      have h1 : 0 ≤ |L_K| := abs_nonneg L_K
      have h2 : |L_K| + 1 ≤ C₁ := le_max_left _ _
      linarith
    refine ⟨C₁, hC₁_pos, ?_⟩
    intro x hx
    have hx_pos : 0 < x := lt_of_lt_of_le zero_lt_one hx
    by_cases hS : S₁ ≤ x
    · have hS₀_le : S₀ ≤ x := le_trans (le_max_left S₀ 1) hS
      have h_dist := hS₀ x hS₀_le
      rw [Real.dist_eq] at h_dist
      have h_sub : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x - L_K < 1 :=
        (abs_sub_lt_iff.mp h_dist).1
      have h_abs : L_K ≤ |L_K| := le_abs_self L_K
      have h_max : |L_K| + 1 ≤ C₁ := le_max_left _ _
      have h_div_le : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x ≤ C₁ := by linarith
      exact (div_le_iff₀ hx_pos).mp h_div_le
    · have hx_le : x ≤ S₁ := le_of_not_ge hS
      have h_sub : {J : Ideal (NumberField.RingOfIntegers K) | (Ideal.absNorm J : ℝ) ≤ x} ⊆
          {J : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm J ≤ ⌊S₁⌋₊} := by
        intro J hJ
        exact Nat.le_floor (le_trans hJ hx_le)
      have h_fin : {J : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm J ≤ ⌊S₁⌋₊}.Finite :=
        Ideal.finite_setOf_absNorm_le ⌊S₁⌋₊
      have h_card_le : Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ x} ≤ N₁ :=
        Nat.card_mono h_fin h_sub
      have h_card_real : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ (N₁ : ℝ) := by exact_mod_cast h_card_le
      have h_max : (N₁ : ℝ) + 1 ≤ C₁ := le_max_right _ _
      have h_le_C₁ : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ := by linarith
      nlinarith
  obtain ⟨C₁, hC₁_pos, hC₁⟩ := h_ideal_card
  have ha_K_bound : ∀ m : ℕ, 1 ≤ m → (a_K m : ℝ) ≤ C₁ * (m : ℝ) := by
    intro m hm
    have hm_real : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
    have h_sub : {I : Ideal R | Ideal.absNorm I = m} ⊆ {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ (m : ℝ)} := by
      intro I hI
      change (Ideal.absNorm I : ℝ) ≤ (m : ℝ)
      rw [Set.mem_setOf_eq.mp hI]
    have h_fin : {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ (m : ℝ)}.Finite := by
      refine Set.Finite.subset (Ideal.finite_setOf_absNorm_le m) ?_
      intro J hJ
      exact_mod_cast hJ
    have h_card_le : a_K m ≤ Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ (m : ℝ)} :=
      Nat.card_mono h_fin h_sub
    have h_card_real : (a_K m : ℝ) ≤ (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ (m : ℝ)} : ℝ) := by
      exact_mod_cast h_card_le
    exact le_trans h_card_real (hC₁ (m : ℝ) hm_real)
  let K₀ : ℝ := (4 / α) * Real.log (4 / (c * α))
  have h_dom : ∀ m : ℕ, 1 ≤ m →
      ((m : ℝ) ^ (2 : ℝ)) * Real.exp (-c * (m : ℝ) ^ α) ≤ Real.exp K₀ * ((m : ℝ) ^ (2 : ℝ))⁻¹ := by
    intro m hm
    have hm_pos : (0 : ℝ) < (m : ℝ) := by exact_mod_cast (by omega : 0 < m)
    let y : ℝ := (c * α / 4) * (m : ℝ) ^ α
    have hmα_pos : 0 < (m : ℝ) ^ α := Real.rpow_pos_of_pos hm_pos α
    have hy_pos : 0 < y := by dsimp [y]; positivity
    have h_log_y : Real.log y ≤ y := by
      have h1 := Real.log_le_sub_one_of_pos hy_pos
      linarith
    have h_mα_eq : (m : ℝ) ^ α = y * (4 / (c * α)) := by
      dsimp [y]
      have hc_ne : c ≠ 0 := ne_of_gt hc
      have hα_ne : α ≠ 0 := ne_of_gt hα
      field_simp [hc_ne, hα_ne]
    have h_log_mα : α * Real.log (m : ℝ) = Real.log y + Real.log (4 / (c * α)) := by
      rw [← Real.log_rpow hm_pos α, h_mα_eq, Real.log_mul (ne_of_gt hy_pos) (by positivity)]
    have h_ineq1 : α * Real.log (m : ℝ) ≤ y + Real.log (4 / (c * α)) := by
      linarith
    have h_ineq2 : (4 / α) * (α * Real.log (m : ℝ)) ≤ (4 / α) * (y + Real.log (4 / (c * α))) :=
      mul_le_mul_of_nonneg_left h_ineq1 (by positivity)
    have h_lhs_simp : (4 / α) * (α * Real.log (m : ℝ)) = 4 * Real.log (m : ℝ) := by
      have hα_ne : α ≠ 0 := ne_of_gt hα
      field_simp [hα_ne]
    have h_rhs_simp : (4 / α) * (y + Real.log (4 / (c * α))) = c * (m : ℝ) ^ α + K₀ := by
      dsimp [y, K₀]
      have hα_ne : α ≠ 0 := ne_of_gt hα
      field_simp [hα_ne]
    have h_ineq3 : Real.log (m : ℝ) * (2 : ℝ) + (-c * (m : ℝ) ^ α) ≤ K₀ + Real.log (m : ℝ) * (-2 : ℝ) := by
      linarith
    have h_exp_ineq : Real.exp (Real.log (m : ℝ) * (2 : ℝ) + (-c * (m : ℝ) ^ α)) ≤
        Real.exp (K₀ + Real.log (m : ℝ) * (-2 : ℝ)) :=
      Real.exp_le_exp.mpr h_ineq3
    rw [Real.exp_add, Real.exp_add, ← Real.rpow_def_of_pos hm_pos (2 : ℝ),
        ← Real.rpow_def_of_pos hm_pos (-2 : ℝ), Real.rpow_neg (le_of_lt hm_pos) (2 : ℝ)] at h_exp_ineq
    exact h_exp_ineq
  let b : ℕ → ℝ := fun m => (C₀ * C₁ * Real.exp K₀) * ((m : ℝ) ^ (2 : ℝ))⁻¹
  have h_term_le : ∀ u ∈ Set.Ioi (1 : ℝ), ∀ m : ℕ, f m u ≤ b m * Real.exp (-c * u ^ α) := by
    intro u hu m
    have hu_gt_one : 1 < u := Set.mem_Ioi.mp hu
    have hu_pos : 0 < u := lt_trans zero_lt_one hu_gt_one
    have hu_ge_one : 1 ≤ u := le_of_lt hu_gt_one
    by_cases hm0 : m = 0
    · subst hm0
      have hf0 : f 0 u = 0 := by dsimp [f]; simp
      have hb0 : b 0 = 0 := by
        dsimp [b]
        rw [Nat.cast_zero, Real.zero_rpow (by norm_num : (2 : ℝ) ≠ 0), inv_zero, mul_zero]
      rw [hf0, hb0, zero_mul]
    · have hm_ge_one_nat : 1 ≤ m := Nat.one_le_iff_ne_zero.mpr hm0
      have hm_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm_ge_one_nat
      have hm_pos : (0 : ℝ) < (m : ℝ) := lt_of_lt_of_le zero_lt_one hm_ge_one
      have hmu_gt_one : 1 < (m : ℝ) * u :=
        lt_of_lt_of_le hu_gt_one (le_mul_of_one_le_left (le_of_lt hu_pos) hm_ge_one)
      have hmα_ge_one : 1 ≤ (m : ℝ) ^ α := Real.one_le_rpow hm_ge_one (le_of_lt hα)
      have huα_ge_one : 1 ≤ u ^ α := Real.one_le_rpow hu_ge_one (le_of_lt hα)
      have hmu_rpow : ((m : ℝ) * u) ^ α = (m : ℝ) ^ α * u ^ α :=
        Real.mul_rpow (le_of_lt hm_pos) (le_of_lt hu_pos)
      have hmα_le : (m : ℝ) ^ α ≤ ((m : ℝ) * u) ^ α := by
        rw [hmu_rpow]
        exact le_mul_of_one_le_right (by positivity) huα_ge_one
      have huα_le : u ^ α ≤ ((m : ℝ) * u) ^ α := by
        rw [hmu_rpow]
        exact le_mul_of_one_le_left (by positivity) hmα_ge_one
      have h_exp_split : Real.exp (-2 * c * ((m : ℝ) * u) ^ α) ≤
          Real.exp (-c * (m : ℝ) ^ α) * Real.exp (-c * u ^ α) := by
        rw [← Real.exp_add, Real.exp_le_exp]
        have h_sum : (m : ℝ) ^ α + u ^ α ≤ 2 * ((m : ℝ) * u) ^ α := by linarith
        nlinarith
      have hW_mu : W_maj ((m : ℝ) * u) ≤ C₀ * Real.exp (-c * (m : ℝ) ^ α) * Real.exp (-c * u ^ α) := by
        calc W_maj ((m : ℝ) * u)
            ≤ C₀ * Real.exp (-2 * c * ((m : ℝ) * u) ^ α) := hW_bound ((m : ℝ) * u) hmu_gt_one
          _ ≤ C₀ * (Real.exp (-c * (m : ℝ) ^ α) * Real.exp (-c * u ^ α)) :=
              mul_le_mul_of_nonneg_left h_exp_split (le_of_lt hC₀)
          _ = C₀ * Real.exp (-c * (m : ℝ) ^ α) * Real.exp (-c * u ^ α) := by ring
      have ha_m : (a_K m : ℝ) * (m : ℝ) ≤ C₁ * (m : ℝ) ^ (2 : ℝ) := by
        calc (a_K m : ℝ) * (m : ℝ)
            ≤ (C₁ * (m : ℝ)) * (m : ℝ) :=
              mul_le_mul_of_nonneg_right (ha_K_bound m hm_ge_one_nat) (le_of_lt hm_pos)
          _ = C₁ * ((m : ℝ) ^ 2) := by ring
          _ = C₁ * (m : ℝ) ^ (2 : ℝ) := by rw [Real.rpow_two]
      have h_dom_m := h_dom m hm_ge_one_nat
      calc f m u
          = ((a_K m : ℝ) * (m : ℝ)) * W_maj ((m : ℝ) * u) := rfl
        _ ≤ (C₁ * (m : ℝ) ^ (2 : ℝ)) * (C₀ * Real.exp (-c * (m : ℝ) ^ α) * Real.exp (-c * u ^ α)) :=
            mul_le_mul ha_m hW_mu (hW_nn _) (by positivity)
        _ = (C₀ * C₁) * (((m : ℝ) ^ (2 : ℝ)) * Real.exp (-c * (m : ℝ) ^ α)) * Real.exp (-c * u ^ α) := by ring
        _ ≤ (C₀ * C₁) * (Real.exp K₀ * ((m : ℝ) ^ (2 : ℝ))⁻¹) * Real.exp (-c * u ^ α) := by
            refine mul_le_mul_of_nonneg_right ?_ (le_of_lt (Real.exp_pos _))
            exact mul_le_mul_of_nonneg_left h_dom_m (by positivity)
        _ = b m * Real.exp (-c * u ^ α) := by dsimp [b]; ring
  have hb_sum : Summable b := by
    dsimp [b]
    exact (Real.summable_nat_rpow_inv.mpr one_lt_two).mul_left (C₀ * C₁ * Real.exp K₀)
  have hb_nn : ∀ m : ℕ, 0 ≤ b m := by
    intro m
    dsimp [b]
    positivity
  have hf_le_b : ∀ m : ℕ, ∀ u ∈ Set.Ioi (1 : ℝ), f m u ≤ b m := by
    intro m u hu
    have hu_gt_one : 1 < u := Set.mem_Ioi.mp hu
    have hu_pos : 0 < u := lt_trans zero_lt_one hu_gt_one
    have huα_nn : 0 ≤ u ^ α := Real.rpow_nonneg (le_of_lt hu_pos) α
    have hexp_le_one : Real.exp (-c * u ^ α) ≤ 1 := by
      rw [Real.exp_le_one_iff]
      nlinarith
    calc f m u
        ≤ b m * Real.exp (-c * u ^ α) := h_term_le u hu m
      _ ≤ b m * 1 := mul_le_mul_of_nonneg_left hexp_le_one (hb_nn m)
      _ = b m := mul_one _
  have hg_le_b : ∀ m : ℕ, ∀ u ∈ Set.Ioi (1 : ℝ), ‖g m u‖ ≤ b m :=
    fun m u hu => le_trans (hg_norm_le_f m u hu) (hf_le_b m u hu)
  have hg_cont : ∀ m : ℕ, ContinuousOn (g m) (Set.Ioi (1 : ℝ)) := by
    intro m
    by_cases hm0 : m = 0
    · subst hm0
      have hg0 : g 0 = fun _ => 0 := by
        ext u
        dsimp [g]
        simp
      rw [hg0]
      exact continuousOn_const
    · have hm_ge_one_nat : 1 ≤ m := Nat.one_le_iff_ne_zero.mpr hm0
      have hm_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm_ge_one_nat
      have h_maps : Set.MapsTo (fun u : ℝ => (m : ℝ) * u) (Set.Ioi (1 : ℝ)) (Set.Ioi (1 : ℝ)) := by
        intro u hu
        have hu_gt_one : 1 < u := Set.mem_Ioi.mp hu
        have hu_pos : 0 < u := lt_trans zero_lt_one hu_gt_one
        exact lt_of_lt_of_le hu_gt_one (le_mul_of_one_le_left (le_of_lt hu_pos) hm_ge_one)
      have hW_m_cont : ContinuousOn (fun u : ℝ => W_c ((m : ℝ) * u)) (Set.Ioi (1 : ℝ)) :=
        hW_cont.comp (continuousOn_const.mul continuousOn_id) h_maps
      have hmW_c_cont : ContinuousOn (fun u : ℝ => (m : ℂ) * W_c ((m : ℝ) * u)) (Set.Ioi (1 : ℝ)) :=
        continuousOn_const.mul hW_m_cont
      exact continuousOn_const.mul hmW_c_cont
  refine ⟨?_, ?_⟩
  · exact continuousOn_const.mul (continuousOn_tsum hg_cont hb_sum hg_le_b)
  · intro u hu
    have hf_sum : Summable (fun m : ℕ => f m u) :=
      Summable.of_nonneg_of_le (fun m => hf_nn m u) (fun m => hf_le_b m u hu) hb_sum
    have hg_norm_sum : Summable (fun m : ℕ => ‖g m u‖) :=
      Summable.of_nonneg_of_le (fun m => norm_nonneg (g m u)) (fun m => hg_norm_le_f m u hu) hf_sum
    calc ‖κ * ∑' m : ℕ, g m u‖
        = ‖κ‖ * ‖∑' m : ℕ, g m u‖ := norm_mul _ _
      _ = ‖∑' m : ℕ, g m u‖ := by rw [hκ, one_mul]
      _ ≤ ∑' m : ℕ, ‖g m u‖ := norm_tsum_le_tsum_norm hg_norm_sum
      _ ≤ ∑' m : ℕ, f m u := hg_norm_sum.tsum_le_tsum (fun m => hg_norm_le_f m u hu) hf_sum

theorem mitsui_grossenchar_mellin_Ioi_zero_of_kernel_unfolding {K : Type u} [Field K] [NumberField K]
    (ψ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hψ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖ψ I‖ ≤ 1)
    (W_c Φ : ℝ → ℂ) (W_maj : ℝ → ℝ) (κ Γ_s : ℂ) (s : ℂ) (hs : 1 < s.re)
    (hW_meas : MeasureTheory.AEStronglyMeasurable W_c (MeasureTheory.volume.restrict (Set.Ioi (0 : ℝ))))
    (hW_nn : ∀ t ∈ Set.Ioi (0 : ℝ), 0 ≤ W_maj t)
    (hW_le : ∀ t ∈ Set.Ioi (0 : ℝ), ‖W_c t‖ ≤ W_maj t)
    (hW_int : MeasureTheory.IntegrableOn (fun t : ℝ => t ^ s.re * W_maj t) (Set.Ioi (0 : ℝ)) MeasureTheory.volume)
    (hW_mellin : (∫ t in Set.Ioi (0 : ℝ), (t : ℂ) ^ s * W_c t) = Γ_s)
    (hΦ_unfold : ∀ u ∈ Set.Ioi (0 : ℝ),
      Φ u = κ * ∑' m : ℕ,
        (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
          ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
          ((m : ℂ) * W_c ((m : ℝ) * u))) :
    κ * Γ_s * LSeries (fun n =>
      ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
        ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s =
      ∫ u in Set.Ioi (0 : ℝ), (u : ℂ) ^ s * Φ u :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let S : ℕ → Type u := fun e => {I : Ideal R // Ideal.absNorm I = e}
  let S' : ℕ → Type u := fun e => {I : Ideal R // I ≠ ⊥ ∧ Ideal.absNorm I = e}
  let a_K : ℕ → ℕ := fun n => Nat.card (S n)
  let a_ψ : ℕ → ℂ := fun n =>
    ∑' I : S' n, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩
  have hS_fin : ∀ e : ℕ, Finite (S e) := fun e => Ideal.finite_setOf_absNorm_eq e
  have hS'_fin : ∀ e : ℕ, Finite (S' e) := fun e =>
    (Ideal.finite_setOf_absNorm_eq e).subset (fun _ h => h.2)
  letI : ∀ e, Fintype (S e) := fun e => Fintype.ofFinite (S e)
  letI : ∀ e, Fintype (S' e) := fun e => Fintype.ofFinite (S' e)
  have ha_nonneg : ∀ n : ℕ, 0 ≤ (a_K n : ℝ) := fun _ => Nat.cast_nonneg _
  have h_ideal_card : ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ x : ℝ, 1 ≤ x →
      (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ * x := by
    set L_K : ℝ :=
      2 ^ NumberField.InfinitePlace.nrRealPlaces K *
        (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
        NumberField.Units.regulator K *
        (NumberField.classNumber K : ℝ) /
        ((NumberField.Units.torsionOrder K : ℝ) * Real.sqrt |(NumberField.discr K : ℝ)|)
    have h_tendsto : Filter.Tendsto
        (fun x : ℝ => (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x)
        Filter.atTop (nhds L_K) :=
      NumberField.Ideal.tendsto_norm_le_div_atTop K
    obtain ⟨S₀, hS₀⟩ := (Metric.tendsto_atTop.mp h_tendsto) 1 zero_lt_one
    let S₁ : ℝ := max S₀ 1
    let N₁ : ℕ := Nat.card {J : Ideal R // Ideal.absNorm J ≤ ⌊S₁⌋₊}
    let C₁ : ℝ := max (|L_K| + 1) ((N₁ : ℝ) + 1)
    have hC₁_pos : 0 < C₁ := by
      have h1 : 0 ≤ |L_K| := abs_nonneg L_K
      have h2 : |L_K| + 1 ≤ C₁ := le_max_left _ _
      linarith
    refine ⟨C₁, hC₁_pos, ?_⟩
    intro x hx
    have hx_pos : 0 < x := lt_of_lt_of_le zero_lt_one hx
    by_cases hS : S₁ ≤ x
    · have hS₀_le : S₀ ≤ x := le_trans (le_max_left S₀ 1) hS
      have h_dist := hS₀ x hS₀_le
      rw [Real.dist_eq] at h_dist
      have h_sub : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x - L_K < 1 :=
        (abs_sub_lt_iff.mp h_dist).1
      have h_abs : L_K ≤ |L_K| := le_abs_self L_K
      have h_max : |L_K| + 1 ≤ C₁ := le_max_left _ _
      have h_div_le : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x ≤ C₁ := by linarith
      exact (div_le_iff₀ hx_pos).mp h_div_le
    · have hx_le : x ≤ S₁ := le_of_not_ge hS
      have h_sub : {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ x} ⊆
          {J : Ideal R | Ideal.absNorm J ≤ ⌊S₁⌋₊} := by
        intro J hJ
        exact Nat.le_floor (le_trans hJ hx_le)
      have h_fin : {J : Ideal R | Ideal.absNorm J ≤ ⌊S₁⌋₊}.Finite :=
        Ideal.finite_setOf_absNorm_le ⌊S₁⌋₊
      have h_card_le : Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} ≤ N₁ :=
        Nat.card_mono h_fin h_sub
      have h_card_real : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ (N₁ : ℝ) := by
        exact_mod_cast h_card_le
      have h_max : (N₁ : ℝ) + 1 ≤ C₁ := le_max_right _ _
      have h_le_C₁ : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ := by linarith
      nlinarith
  obtain ⟨C₁, hC₁_pos, hC₁⟩ := h_ideal_card
  have h_sum_K : Summable (LSeries.term (fun n => (a_K n : ℂ)) s) := by
    have ha_sum_bound : ∀ N : ℕ, 1 ≤ N →
        (∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ)) ≤ C₁ * (N : ℝ) ^ (1 : ℝ) := by
      intro N hN
      have hN_real : (1 : ℝ) ≤ (N : ℝ) := by exact_mod_cast hN
      let S_J := {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ (N : ℝ)}
      have hSJ_fin : {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ (N : ℝ)}.Finite := by
        apply Set.Finite.subset (Ideal.finite_setOf_absNorm_le N)
        intro J hJ
        exact_mod_cast hJ
      haveI : Finite S_J := hSJ_fin
      let S_pos := {J : Ideal R // 1 ≤ Ideal.absNorm J ∧ Ideal.absNorm J ≤ N}
      have hS_pos_fin : {J : Ideal R | 1 ≤ Ideal.absNorm J ∧ Ideal.absNorm J ≤ N}.Finite :=
        (Ideal.finite_setOf_absNorm_le N).subset (fun _ h => h.2)
      haveI : Finite S_pos := hS_pos_fin
      letI : Fintype S_pos := Fintype.ofFinite S_pos
      let g : S_pos → ℕ := fun J => Ideal.absNorm J.1
      have hg : ∀ J ∈ (Finset.univ : Finset S_pos), g J ∈ Finset.Icc 1 N := by
        intro J _
        rw [Finset.mem_Icc]
        exact J.2
      have h_sum_eq : (∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ)) = (Nat.card S_pos : ℝ) := by
        have h1 : (∑ _J : S_pos, (1 : ℝ)) = (Nat.card S_pos : ℝ) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one, ← Nat.card_eq_fintype_card]
        rw [← h1, ← Finset.sum_fiberwise_of_maps_to hg (fun _ => (1 : ℝ))]
        refine Finset.sum_congr rfl (fun k hk => ?_)
        rw [Finset.mem_Icc] at hk
        let e_k : S k ≃ {J : S_pos // g J = k} :=
          { toFun := fun I => ⟨⟨I.1, ⟨by rw [I.2]; exact hk.1, by rw [I.2]; exact hk.2⟩⟩, I.2⟩
            invFun := fun J => ⟨J.1.1, J.2⟩
            left_inv := fun _ => by apply Subtype.ext; rfl
            right_inv := fun _ => by apply Subtype.ext; apply Subtype.ext; rfl }
        rw [Finset.sum_const, nsmul_eq_mul, mul_one]
        have h_card : ((Finset.univ.filter (fun J : S_pos => g J = k)).card : ℝ) =
            (Fintype.card {J : S_pos // g J = k} : ℝ) := by
          rw [Fintype.card_subtype]
        rw [h_card, ← Fintype.card_congr e_k, ← Nat.card_eq_fintype_card]
      let ι : S_pos → S_J := fun J => ⟨J.1, by exact_mod_cast J.2.2⟩
      have hι_inj : Function.Injective ι := fun a b h => Subtype.ext (congrArg (fun x : S_J => x.1) h)
      have h_le_SJ : (Nat.card S_pos : ℝ) ≤ (Nat.card S_J : ℝ) := by
        exact_mod_cast Nat.card_le_card_of_injective ι hι_inj
      rw [h_sum_eq, Real.rpow_one]
      exact le_trans h_le_SJ (hC₁ (N : ℝ) hN_real)
    have h_bigO : (fun N : ℕ => ∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ)) =O[Filter.atTop]
        (fun N : ℕ => (N : ℝ) ^ (1 : ℝ)) := by
      refine Asymptotics.IsBigO.of_bound C₁ ?_
      rw [Filter.eventually_atTop]
      refine ⟨1, fun N hN => ?_⟩
      have h_sum_nonneg : 0 ≤ ∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ) :=
        Finset.sum_nonneg (fun k _ => ha_nonneg k)
      have hN_nonneg : 0 ≤ (N : ℝ) ^ (1 : ℝ) := by positivity
      rw [Real.norm_of_nonneg h_sum_nonneg, Real.norm_of_nonneg hN_nonneg]
      exact ha_sum_bound N hN
    have h_sum_real := LSeriesSummable_of_sum_norm_bigO_and_nonneg h_bigO ha_nonneg zero_le_one hs
    simpa [a_K, S] using h_sum_real
  have ha_ψ_bound : ∀ n : ℕ, ‖a_ψ n‖ ≤ (a_K n : ℝ) := by
    intro n
    dsimp [a_ψ, a_K]
    rw [tsum_fintype]
    have h_inj : Function.Injective (fun I : S' n => (⟨I.1, I.2.2⟩ : S n)) :=
      fun a b h => Subtype.ext (congrArg (fun x : S n => x.1) h)
    have h_card : (Nat.card (S' n) : ℝ) ≤ (Nat.card (S n) : ℝ) := by
      exact_mod_cast Nat.card_le_card_of_injective _ h_inj
    calc ‖∑ I : S' n, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖
        ≤ ∑ I : S' n, ‖ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖ := norm_sum_le _ _
      _ ≤ ∑ _I : S' n, (1 : ℝ) := Finset.sum_le_sum (fun I _ => hψ_norm _)
      _ = (Nat.card (S' n) : ℝ) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one, ← Nat.card_eq_fintype_card]
      _ ≤ (Nat.card (S n) : ℝ) := h_card
  have h_term_ψ_le_s : ∀ n : ℕ,
      ‖LSeries.term a_ψ s n‖ ≤ ‖LSeries.term (fun k => (a_K k : ℂ)) s n‖ := by
    intro n
    by_cases hn : n = 0
    · subst hn; simp [LSeries.term]
    · rw [LSeries.norm_term_eq, LSeries.norm_term_eq, if_neg hn, if_neg hn]
      refine div_le_div_of_nonneg_right ?_ (Real.rpow_nonneg (Nat.cast_nonneg n) s.re)
      rw [Complex.norm_natCast]
      exact ha_ψ_bound n
  have h_sum_ψ_s : Summable (LSeries.term a_ψ s) :=
    Summable.of_norm_bounded h_sum_K.norm h_term_ψ_le_s
  let G : ℝ → ℂ := fun t => (t : ℂ) ^ s * W_c t
  let G_re : ℝ → ℝ := fun t => t ^ s.re * W_maj t
  have h_cpow_cont : ContinuousOn (fun t : ℝ => (t : ℂ) ^ s) (Set.Ioi (0 : ℝ)) :=
    ContinuousOn.cpow_const Complex.continuous_ofReal.continuousOn (fun t ht => Or.inl (by simpa using ht))
  have hG_meas : MeasureTheory.AEStronglyMeasurable G (MeasureTheory.volume.restrict (Set.Ioi (0 : ℝ))) :=
    (h_cpow_cont.aestronglyMeasurable measurableSet_Ioi).mul hW_meas
  have hG_int : MeasureTheory.IntegrableOn G (Set.Ioi (0 : ℝ)) MeasureTheory.volume := by
    refine hW_int.mono' hG_meas ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioi] with t ht
    dsimp [G]
    rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos ht]
    exact mul_le_mul_of_nonneg_left (hW_le t ht) (Real.rpow_nonneg (le_of_lt ht) s.re)
  let F : ℕ → ℝ → ℂ := fun m u =>
    (u : ℂ) ^ s * (κ * (a_ψ m * ((m : ℂ) * W_c ((m : ℝ) * u))))
  let c_m : ℕ → ℂ := fun m => LSeries.term a_ψ s m
  have hF_eq : ∀ (m : ℕ) (u : ℝ), u ∈ Set.Ioi (0 : ℝ) →
      F m u = (κ * c_m m * (m : ℂ)) * G ((m : ℝ) * u) := by
    intro m u hu
    by_cases hm : m = 0
    · subst hm
      simp [F, c_m, LSeries.term]
    · have hm_pos : 0 < (m : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hm)
      have hm_nn : 0 ≤ (m : ℝ) := le_of_lt hm_pos
      have hu_nn : 0 ≤ u := le_of_lt hu
      have hm_c_ne : (m : ℂ) ^ s ≠ 0 := by
        rw [Ne, Complex.cpow_eq_zero_iff]
        intro h
        exact hm (Nat.cast_eq_zero.mp h.1)
      have h_mul_cpow : (((m : ℝ) * u : ℝ) : ℂ) ^ s = (m : ℂ) ^ s * (u : ℂ) ^ s := by
        rw [Complex.ofReal_mul, Complex.mul_cpow_ofReal_nonneg hm_nn hu_nn s, Complex.ofReal_natCast]
      dsimp [F, G, c_m]
      rw [LSeries.term_of_ne_zero hm, h_mul_cpow]
      push_cast
      field_simp [hm_c_ne]
  have hF_norm_le : ∀ (m : ℕ) (u : ℝ), u ∈ Set.Ioi (0 : ℝ) →
      ‖F m u‖ ≤ ((‖κ‖ * ‖c_m m‖) * (m : ℝ)) * G_re ((m : ℝ) * u) := by
    intro m u hu
    by_cases hm : m = 0
    · subst hm
      simp [F, c_m, LSeries.term]
    · have hm_pos : 0 < (m : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hm)
      have hmu_pos : 0 < (m : ℝ) * u := mul_pos hm_pos hu
      rw [hF_eq m u hu, norm_mul, norm_mul, norm_mul, Complex.norm_natCast]
      dsimp [G, G_re]
      rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos hmu_pos]
      refine mul_le_mul_of_nonneg_left ?_ (by positivity)
      exact mul_le_mul_of_nonneg_left (hW_le ((m : ℝ) * u) hmu_pos)
        (Real.rpow_nonneg (le_of_lt hmu_pos) s.re)
  have hF_int : ∀ m : ℕ, MeasureTheory.IntegrableOn (F m) (Set.Ioi (0 : ℝ)) MeasureTheory.volume := by
    intro m
    by_cases hm : m = 0
    · subst hm
      have hF0 : F 0 = fun _ => 0 := by
        ext u
        simp [F]
      rw [hF0]
      exact MeasureTheory.integrableOn_zero
    · have hm_pos : 0 < (m : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hm)
      have h1 : MeasureTheory.IntegrableOn (fun u : ℝ => G ((m : ℝ) * u))
          (Set.Ioi (0 : ℝ)) MeasureTheory.volume := by
        rw [MeasureTheory.integrableOn_Ioi_comp_mul_left_iff G 0 hm_pos, mul_zero]
        exact hG_int
      have h2 : MeasureTheory.IntegrableOn (fun u : ℝ => (κ * c_m m * (m : ℂ)) * G ((m : ℝ) * u))
          (Set.Ioi (0 : ℝ)) MeasureTheory.volume :=
        h1.const_mul (κ * c_m m * (m : ℂ))
      exact h2.congr_fun (fun u hu => (hF_eq m u hu).symm) measurableSet_Ioi
  have hF_integral : ∀ m : ℕ, (∫ u in Set.Ioi (0 : ℝ), F m u) = κ * c_m m * Γ_s := by
    intro m
    by_cases hm : m = 0
    · subst hm
      have hF0 : F 0 = fun _ => 0 := by ext u; simp [F]
      rw [hF0, MeasureTheory.integral_zero]
      simp [c_m, LSeries.term]
    · have hm_pos : 0 < (m : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hm)
      have hm_c_ne : (m : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hm
      rw [MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun u hu => hF_eq m u hu),
        MeasureTheory.integral_const_mul, MeasureTheory.integral_comp_mul_left_Ioi G 0 hm_pos,
        mul_zero, hW_mellin, Complex.real_smul]
      push_cast
      field_simp [hm_c_ne]
  have hF_norm_integral_le : ∀ m : ℕ,
      (∫ u in Set.Ioi (0 : ℝ), ‖F m u‖) ≤ (‖κ‖ * ‖c_m m‖) * ∫ t in Set.Ioi (0 : ℝ), G_re t := by
    intro m
    by_cases hm : m = 0
    · subst hm
      have hF0 : (fun u : ℝ => ‖F 0 u‖) = fun _ => 0 := by ext u; simp [F]
      rw [hF0, MeasureTheory.integral_zero]
      simp [c_m, LSeries.term]
    · have hm_pos : 0 < (m : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hm)
      have hm_r_ne : (m : ℝ) ≠ 0 := ne_of_gt hm_pos
      have h_int_Gre_m : MeasureTheory.IntegrableOn (fun u : ℝ => G_re ((m : ℝ) * u))
          (Set.Ioi (0 : ℝ)) MeasureTheory.volume := by
        rw [MeasureTheory.integrableOn_Ioi_comp_mul_left_iff G_re 0 hm_pos, mul_zero]
        exact hW_int
      have h_int_rhs : MeasureTheory.IntegrableOn
          (fun u : ℝ => ((‖κ‖ * ‖c_m m‖) * (m : ℝ)) * G_re ((m : ℝ) * u))
          (Set.Ioi (0 : ℝ)) MeasureTheory.volume :=
        h_int_Gre_m.const_mul ((‖κ‖ * ‖c_m m‖) * (m : ℝ))
      have h_mono : (∫ u in Set.Ioi (0 : ℝ), ‖F m u‖) ≤
          ∫ u in Set.Ioi (0 : ℝ), ((‖κ‖ * ‖c_m m‖) * (m : ℝ)) * G_re ((m : ℝ) * u) :=
        MeasureTheory.setIntegral_mono_on (hF_int m).norm h_int_rhs measurableSet_Ioi (hF_norm_le m)
      have h_eval : (∫ u in Set.Ioi (0 : ℝ), ((‖κ‖ * ‖c_m m‖) * (m : ℝ)) * G_re ((m : ℝ) * u)) =
          (‖κ‖ * ‖c_m m‖) * ∫ t in Set.Ioi (0 : ℝ), G_re t := by
        rw [MeasureTheory.integral_const_mul, MeasureTheory.integral_comp_mul_left_Ioi G_re 0 hm_pos,
          mul_zero, smul_eq_mul]
        field_simp [hm_r_ne]
      linarith
  have h_summable_int_norm : Summable (fun m : ℕ => ∫ u in Set.Ioi (0 : ℝ), ‖F m u‖) := by
    refine Summable.of_nonneg_of_le
      (fun m => MeasureTheory.integral_nonneg (fun _ => norm_nonneg _))
      hF_norm_integral_le ?_
    exact (h_sum_ψ_s.norm.mul_left ‖κ‖).mul_right _
  have h_int_tsum : (∫ u in Set.Ioi (0 : ℝ), (u : ℂ) ^ s * Φ u) =
      ∑' m : ℕ, ∫ u in Set.Ioi (0 : ℝ), F m u := by
    have h_congr : (∫ u in Set.Ioi (0 : ℝ), (u : ℂ) ^ s * Φ u) =
        ∫ u in Set.Ioi (0 : ℝ), ∑' m : ℕ, F m u := by
      refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun u hu => ?_)
      rw [hΦ_unfold u hu]
      change (u : ℂ) ^ s * (κ * ∑' m : ℕ, a_ψ m * ((m : ℂ) * W_c ((m : ℝ) * u))) =
        ∑' m : ℕ, (u : ℂ) ^ s * (κ * (a_ψ m * ((m : ℂ) * W_c ((m : ℝ) * u))))
      rw [← tsum_mul_left, ← tsum_mul_left]
    rw [h_congr]
    exact (MeasureTheory.integral_tsum_of_summable_integral_norm hF_int h_summable_int_norm).symm
  rw [h_int_tsum]
  have h_tsum_eq : (∑' m : ℕ, ∫ u in Set.Ioi (0 : ℝ), F m u) =
      κ * (∑' m : ℕ, c_m m) * Γ_s := by
    have h1 : (fun m : ℕ => ∫ u in Set.Ioi (0 : ℝ), F m u) = fun m : ℕ => κ * (c_m m * Γ_s) := by
      ext m
      rw [hF_integral m, mul_assoc]
    rw [h1, tsum_mul_left, tsum_mul_right, mul_assoc]
  rw [h_tsum_eq]
  change κ * Γ_s * LSeries a_ψ s = κ * (∑' m : ℕ, c_m m) * Γ_s
  dsimp [LSeries, c_m]
  ring

theorem mitsui_grossenchar_theta_kernels_inversion_and_mellin_unfold {K : Type u} [Field K] [NumberField K] :
    ∃ C_unit : ℝ, 1 ≤ C_unit ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
        ∀ w₀ : NumberField.InfinitePlace K,
          ∀ a₀ : ℕ, a₀ < NumberField.Units.torsionOrder K →
            ∀ θ₀ : Fin (NumberField.Units.rank K) → ℝ,
              (∀ j : Fin (NumberField.Units.rank K), 0 ≤ θ₀ j ∧ θ₀ j < 1) →
              ∀ (m_freq : Fin (NumberField.Units.rank K) → ℤ)
                (l_ang : NumberField.InfinitePlace K → ℤ),
                (∀ ζ ∈ NumberField.Units.torsion K,
                  (∏ w : NumberField.InfinitePlace K,
                    (w.embedding ((ζ : NumberField.RingOfIntegers K) : K)) ^ (l_ang w)) = 1) →
                (1 ≤ a₀ ∨
                  ((∀ w : NumberField.InfinitePlace K, w.IsReal → l_ang w = 0) ∧
                    (m_freq ≠ 0 ∨ ∃ w : NumberField.InfinitePlace K, w.IsComplex ∧ l_ang w ≠ 0))) →
                ∀ M : ℝ, 1 ≤ M →
                  (∀ j : Fin (NumberField.Units.rank K), |(m_freq j : ℝ)| ≤ Real.exp M) →
                  (∀ w : NumberField.InfinitePlace K, |(l_ang w : ℝ)| ≤ Real.exp M) →
                  ∀ χ_gr : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ,
                    (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
                      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ_gr I‖ = 1) ∧
                      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ_gr I = 0)) →
                    (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
                      x - 1 ∈ q →
                      ∃ y : Fin (NumberField.Units.rank K) → ℝ,
                        (∀ w : NumberField.InfinitePlace K,
                          Real.log (w (x : K) / w₀ (x : K)) =
                            ∑ j : Fin (NumberField.Units.rank K),
                              y j *
                                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) ∧
                        χ_gr ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
                          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
                          ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
                            Complex.exp
                              (((∑ j : Fin (NumberField.Units.rank K),
                                  y j *
                                    (2 * Real.pi * (θ₀ j - (m_freq j : ℝ)) +
                                      ∑ w : NumberField.InfinitePlace K,
                                        (l_ang w : ℝ) *
                                          (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg)) : ℝ) * Complex.I)) =
                          ∏ w : NumberField.InfinitePlace K,
                            (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w)) →
                    ∃ (χ_dual : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
                      (M_χ : ℂ → ℂ)
                      (a_real : Fin (NumberField.InfinitePlace.nrRealPlaces K) → ℕ)
                      (v_real : Fin (NumberField.InfinitePlace.nrRealPlaces K) → ℝ)
                      (l_cplx : Fin (NumberField.InfinitePlace.nrComplexPlaces K) → ℕ)
                      (v_cplx : Fin (NumberField.InfinitePlace.nrComplexPlaces K) → ℝ)
                      (Φ₁ Φ₂ : ℝ → ℂ) (Ψ_χ : ℝ → ℝ) (C c α : ℝ),
                      0 < C ∧ 0 < c ∧ 0 < α ∧
                      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ_dual I‖ ≤ 1) ∧
                      Differentiable ℂ M_χ ∧
                      (∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 → ‖M_χ s‖ ≤ (Ideal.absNorm q : ℝ) ^ 2) ∧
                      (∀ q_idx : Fin (NumberField.InfinitePlace.nrRealPlaces K), a_real q_idx ≤ 1) ∧
                      (∀ q_idx : Fin (NumberField.InfinitePlace.nrRealPlaces K), |v_real q_idx| ≤ C_unit * Real.exp M) ∧
                      (∀ p_idx : Fin (NumberField.InfinitePlace.nrComplexPlaces K), (l_cplx p_idx : ℝ) ≤ C_unit * Real.exp M) ∧
                      (∀ p_idx : Fin (NumberField.InfinitePlace.nrComplexPlaces K), |v_cplx p_idx| ≤ C_unit * Real.exp M) ∧
                      ContinuousOn Φ₁ (Set.Ioi (1 : ℝ)) ∧
                      ContinuousOn Φ₂ (Set.Ioi (1 : ℝ)) ∧
                      MeasureTheory.AEStronglyMeasurable Ψ_χ (MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))) ∧
                      (∀ u ∈ Set.Ioi (1 : ℝ), 0 ≤ Ψ_χ u) ∧
                      (∀ u ∈ Set.Ioi (1 : ℝ), ‖Φ₁ u‖ ≤ Ψ_χ u ∧ ‖Φ₂ u‖ ≤ Ψ_χ u) ∧
                      (∀ u ∈ Set.Ioi (1 : ℝ), Ψ_χ u ≤ C * Real.exp (-c * u ^ α)) ∧
                      (∀ u ∈ Set.Ioi (1 : ℝ),
                        ((u ^ (-3 : ℝ) : ℝ) : ℂ) * Φ₁ u⁻¹ = Φ₂ u ∧
                        ((u ^ (-3 : ℝ) : ℝ) : ℂ) * Φ₂ u⁻¹ = Φ₁ u) ∧
                      (∀ s : ℂ, 1 < s.re →
                        (((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ (s / 2) *
                          (∏ q_idx : Fin (NumberField.InfinitePlace.nrRealPlaces K),
                            Complex.Gammaℝ (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I)) *
                          (∏ p_idx : Fin (NumberField.InfinitePlace.nrComplexPlaces K),
                            Complex.Gammaℂ (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I))) *
                          LSeries (fun n =>
                            ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
                              χ_gr ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s =
                        M_χ s * ∫ u in Set.Ioi (0 : ℝ), (u : ℂ) ^ s * Φ₁ u) ∧
                      (∀ s : ℂ, s.re = -1 / 2 →
                        ‖∫ u in Set.Ioi (0 : ℝ), (u : ℂ) ^ (1 - s) * Φ₂ u‖ =
                          ‖(((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ ((1 - s) / 2) *
                              (∏ q_idx : Fin (NumberField.InfinitePlace.nrRealPlaces K),
                                Complex.Gammaℝ ((1 - s) + (a_real q_idx : ℂ) + (v_real q_idx : ℂ) * Complex.I)) *
                              (∏ p_idx : Fin (NumberField.InfinitePlace.nrComplexPlaces K),
                                Complex.Gammaℂ ((1 - s) + ((l_cplx p_idx : ℝ) / 2 : ℂ) + ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I))) *
                            LSeries (fun n =>
                              ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
                                χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) (1 - s)‖) :=
by
  classical
  obtain ⟨C_unit, hC_unit_ge_one, h_prim_theta⟩ :=
    mitsui_primitive_grossenchar_theta_kernels_and_mellin_identities (K := K)
  refine ⟨C_unit, hC_unit_ge_one, ?_⟩
  intro q hq w₀ a₀ ha₀_lt θ₀ hθ₀_bdd m_freq l_ang h_tors h_nonprin M hM hm_M hl_M χ_gr hχ_norm_supp hχ_prin
  obtain ⟨f, χ₀, hqf, hχ₀_norm_supp, hχ₀_prin, hχ₀_prim, hχ_eq⟩ :=
    mitsui_grossenchar_primitive_conductor_reduction
      q hq w₀ a₀ ha₀_lt θ₀ hθ₀_bdd m_freq l_ang h_tors h_nonprin χ_gr hχ_norm_supp hχ_prin
  obtain ⟨c_ideal, hc_mul⟩ := Ideal.dvd_iff_le.mpr hqf
  have hf_ne : f ≠ 0 := left_ne_zero_of_mul (hc_mul ▸ hq)
  have hc_ne : c_ideal ≠ 0 := right_ne_zero_of_mul (hc_mul ▸ hq)
  have h_coprime_iff : ∀ J : Ideal (NumberField.RingOfIntegers K),
      J ⊔ q = ⊤ ↔ (J ⊔ f = ⊤ ∧ J ⊔ c_ideal = ⊤) := by
    intro J
    rw [hc_mul, ← Ideal.isCoprime_iff_sup_eq, ← Ideal.isCoprime_iff_sup_eq,
      ← Ideal.isCoprime_iff_sup_eq]
    exact IsCoprime.mul_right_iff
  have hχ₀_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ₀ I‖ ≤ 1 := by
    intro I
    by_cases hIf : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤
    · rw [(hχ₀_norm_supp I).1 hIf]
    · rw [(hχ₀_norm_supp I).2 hIf, norm_zero]
      exact zero_le_one
  have h_coprime_eq : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I : Ideal (NumberField.RingOfIntegers K)) ⊔ c_ideal = ⊤ → χ_gr I = χ₀ I := by
    intro I hIc
    by_cases hIf : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤
    · exact hχ_eq I ((h_coprime_iff I).mpr ⟨hIf, hIc⟩)
    · have hnIq : ¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) :=
        fun hIq => hIf ((h_coprime_iff I).mp hIq).1
      rw [(hχ_norm_supp I).2 hnIq, (hχ₀_norm_supp I).2 hIf]
  have h_not_coprime_zero : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ c_ideal = ⊤) → χ_gr I = 0 := by
    intro I hnIc
    have hnIq : ¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) :=
      fun hIq => hnIc ((h_coprime_iff I).mp hIq).2
    exact (hχ_norm_supp I).2 hnIq
  obtain ⟨E, hE_diff, hE_bound, hE_LSeries⟩ :=
    mitsui_ideal_coprime_restriction_euler_factor_LSeries
      c_ideal hc_ne χ_gr χ₀ hχ₀_norm h_coprime_eq h_not_coprime_zero
  have hf_norm_ne_zero : Ideal.absNorm f ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hf_ne
  set N_f : ℝ := (Ideal.absNorm f : ℝ)
  have hNf_ge_one : (1 : ℝ) ≤ N_f := by
    dsimp [N_f]
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr hf_norm_ne_zero
  have hNf_pos : 0 < N_f := lt_of_lt_of_le zero_lt_one hNf_ge_one
  have hNf_c_ne : (N_f : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hNf_pos)
  let M_χ : ℂ → ℂ := fun s => E s * (N_f : ℂ) ^ ((3 / 4 : ℂ) - s / 2)
  have h_cpow_diff : Differentiable ℂ (fun s : ℂ => (N_f : ℂ) ^ ((3 / 4 : ℂ) - s / 2)) := by
    refine Differentiable.const_cpow ?_ (Or.inl hNf_c_ne)
    exact (differentiable_const (3 / 4 : ℂ)).sub (differentiable_id.div_const (2 : ℂ))
  have hM_diff : Differentiable ℂ M_χ := hE_diff.mul h_cpow_diff
  have hM_bound : ∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 → ‖M_χ s‖ ≤ (Ideal.absNorm q : ℝ) ^ 2 := by
    intro s hs1 hs2
    dsimp [M_χ]
    rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos hNf_pos]
    have h_re_le : ((3 / 4 : ℂ) - s / 2).re ≤ (2 : ℝ) := by
      simp only [Complex.sub_re, Complex.div_ofNat_re, Complex.re_ofNat]
      linarith
    have h_rpow_le : N_f ^ (((3 / 4 : ℂ) - s / 2).re) ≤ N_f ^ (2 : ℕ) := by
      rw [← Real.rpow_natCast N_f 2]
      exact Real.rpow_le_rpow_of_exponent_le hNf_ge_one h_re_le
    have h_norm_q : (Ideal.absNorm c_ideal : ℝ) ^ 2 * N_f ^ 2 = (Ideal.absNorm q : ℝ) ^ 2 := by
      dsimp [N_f]
      rw [hc_mul, map_mul, Nat.cast_mul]
      ring
    calc ‖E s‖ * N_f ^ (((3 / 4 : ℂ) - s / 2).re)
        ≤ (Ideal.absNorm c_ideal : ℝ) ^ 2 * N_f ^ 2 :=
          mul_le_mul (hE_bound s hs1 hs2) h_rpow_le (by positivity) (by positivity)
      _ = (Ideal.absNorm q : ℝ) ^ 2 := h_norm_q
  have hM_eq : ∀ s : ℂ, M_χ s * (N_f : ℂ) ^ (s / 2 - (3 / 4 : ℂ)) = E s := by
    intro s
    dsimp [M_χ]
    rw [mul_assoc, ← Complex.cpow_add _ _ hNf_c_ne]
    have h_exp : ((3 / 4 : ℂ) - s / 2) + (s / 2 - (3 / 4 : ℂ)) = 0 := by ring
    rw [h_exp, Complex.cpow_zero, mul_one]
  obtain ⟨a_real, v_real, l_cplx, v_cplx, ω_χ, W₁, W₂, W_maj, C₀, c, α,
    hC₀_pos, hc_pos, hα_pos, hω_norm,
    ha_real, hv_real, hl_cplx, hv_cplx,
    hW_maj_meas, hW_maj_nn, hW₁_meas, hW₂_meas,
    hW₁_cont, hW₂_cont, hW_le, hW_maj_bound, hW_mellin, h_inv⟩ :=
    h_prim_theta f hf_ne w₀ a₀ ha₀_lt θ₀ hθ₀_bdd m_freq l_ang h_tors h_nonprin
      M hM hm_M hl_M χ₀ hχ₀_norm_supp hχ₀_prin hχ₀_prim
  let χ_dual : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ :=
    (starRingEnd ℂ).toMonoidHom.comp χ₀
  have hχ_dual_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ_dual I‖ ≤ 1 := by
    intro I
    change ‖starRingEnd ℂ (χ₀ I)‖ ≤ 1
    rw [Complex.norm_conj]
    exact hχ₀_norm I
  let Φ₁ : ℝ → ℂ := fun u => (1 : ℂ) * ∑' m : ℕ,
    (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
      χ₀ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
      ((m : ℂ) * W₁ ((m : ℝ) * u))
  let Φ₂ : ℝ → ℂ := fun u => ω_χ * ∑' m : ℕ,
    (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
      χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
      ((m : ℂ) * W₂ ((m : ℝ) * u))
  let Ψ_χ : ℝ → ℝ := fun u => ∑' m : ℕ,
    (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm I = m} : ℝ) *
      (m : ℝ) * W_maj ((m : ℝ) * u)
  obtain ⟨C, hC_pos, hΨ_meas, hΨ_nn, hΨ_bound⟩ :=
    mitsui_ideal_norm_tsum_measurable_and_exp_bound_of_kernel_exp_bound
      (K := K) W_maj C₀ c α hC₀_pos hc_pos hα_pos hW_maj_meas hW_maj_nn hW_maj_bound
  obtain ⟨hΦ₁_cont, hΦ₁_le⟩ :=
    mitsui_grossenchar_series_continuousOn_and_norm_le_of_kernel_exp_bound
      χ₀ hχ₀_norm 1 norm_one W₁ W_maj C₀ c α hC₀_pos hc_pos hα_pos
      hW₁_cont hW_maj_nn (fun t ht => (hW_le t ht).1) hW_maj_bound
  obtain ⟨hΦ₂_cont, hΦ₂_le⟩ :=
    mitsui_grossenchar_series_continuousOn_and_norm_le_of_kernel_exp_bound
      χ_dual hχ_dual_norm ω_χ hω_norm W₂ W_maj C₀ c α hC₀_pos hc_pos hα_pos
      hW₂_cont hW_maj_nn (fun t ht => (hW_le t ht).2) hW_maj_bound
  refine ⟨χ_dual, M_χ, a_real, v_real, l_cplx, v_cplx, Φ₁, Φ₂, Ψ_χ, C, c, α,
    hC_pos, hc_pos, hα_pos, hχ_dual_norm, hM_diff, hM_bound,
    ha_real, hv_real, hl_cplx, hv_cplx,
    hΦ₁_cont, hΦ₂_cont, hΨ_meas, hΨ_nn,
    fun u hu => ⟨hΦ₁_le u hu, hΦ₂_le u hu⟩, hΨ_bound, h_inv, ?_, ?_⟩
  · intro s hs
    obtain ⟨hW_int_s, hW₁_mellin_s, _⟩ := hW_mellin s hs
    set Γ_shift_s : ℂ :=
      (((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ (s / 2) *
        (∏ q_idx : Fin (NumberField.InfinitePlace.nrRealPlaces K),
          Complex.Gammaℝ (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I)) *
        (∏ p_idx : Fin (NumberField.InfinitePlace.nrComplexPlaces K),
          Complex.Gammaℂ (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)))
    set L_χ₀_s : ℂ := LSeries (fun n =>
      ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
        χ₀ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s
    set L_χ_gr_s : ℂ := LSeries (fun n =>
      ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
        χ_gr ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s
    have h_unfold_1 :
        (1 : ℂ) * ((N_f : ℂ) ^ (s / 2 - (3 / 4 : ℂ)) * Γ_shift_s) * L_χ₀_s =
          ∫ u in Set.Ioi (0 : ℝ), (u : ℂ) ^ s * Φ₁ u :=
      mitsui_grossenchar_mellin_Ioi_zero_of_kernel_unfolding
        χ₀ hχ₀_norm W₁ Φ₁ W_maj 1 ((N_f : ℂ) ^ (s / 2 - (3 / 4 : ℂ)) * Γ_shift_s) s hs
        hW₁_meas (fun t _ => hW_maj_nn t) (fun t ht => (hW_le t ht).1)
        hW_int_s hW₁_mellin_s (fun _ _ => rfl)
    have hE_s : E s * L_χ₀_s = L_χ_gr_s := hE_LSeries s hs
    calc Γ_shift_s * L_χ_gr_s
        = Γ_shift_s * (E s * L_χ₀_s) := by rw [← hE_s]
      _ = Γ_shift_s * ((M_χ s * (N_f : ℂ) ^ (s / 2 - (3 / 4 : ℂ))) * L_χ₀_s) := by rw [hM_eq s]
      _ = M_χ s * ((1 : ℂ) * ((N_f : ℂ) ^ (s / 2 - (3 / 4 : ℂ)) * Γ_shift_s) * L_χ₀_s) := by ring
      _ = M_χ s * ∫ u in Set.Ioi (0 : ℝ), (u : ℂ) ^ s * Φ₁ u := by rw [h_unfold_1]
  · intro s hs
    have h1s_re : 1 < (1 - s).re := by
      rw [Complex.sub_re, Complex.one_re, hs]
      norm_num
    obtain ⟨hW_int_1s, _, hW₂_mellin_1s⟩ := hW_mellin (1 - s) h1s_re
    set Γ_shift_1s : ℂ :=
      (((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ ((1 - s) / 2) *
        (∏ q_idx : Fin (NumberField.InfinitePlace.nrRealPlaces K),
          Complex.Gammaℝ ((1 - s) + (a_real q_idx : ℂ) + (v_real q_idx : ℂ) * Complex.I)) *
        (∏ p_idx : Fin (NumberField.InfinitePlace.nrComplexPlaces K),
          Complex.Gammaℂ ((1 - s) + ((l_cplx p_idx : ℝ) / 2 : ℂ) + ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)))
    set L_dual_1s : ℂ := LSeries (fun n =>
      ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
        χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) (1 - s)
    have h_unfold_2 :
        ω_χ * ((N_f : ℂ) ^ ((1 - s) / 2 - (3 / 4 : ℂ)) * Γ_shift_1s) * L_dual_1s =
          ∫ u in Set.Ioi (0 : ℝ), (u : ℂ) ^ (1 - s) * Φ₂ u :=
      mitsui_grossenchar_mellin_Ioi_zero_of_kernel_unfolding
        χ_dual hχ_dual_norm W₂ Φ₂ W_maj ω_χ
        ((N_f : ℂ) ^ ((1 - s) / 2 - (3 / 4 : ℂ)) * Γ_shift_1s) (1 - s) h1s_re
        hW₂_meas (fun t _ => hW_maj_nn t) (fun t ht => (hW_le t ht).2)
        hW_int_1s hW₂_mellin_1s (fun _ _ => rfl)
    have h_exp_re : ((1 - s) / 2 - (3 / 4 : ℂ)).re = 0 := by
      simp only [Complex.sub_re, Complex.div_ofNat_re, Complex.one_re, Complex.re_ofNat, hs]
      ring
    have hNf_norm_one : ‖(N_f : ℂ) ^ ((1 - s) / 2 - (3 / 4 : ℂ))‖ = 1 := by
      rw [Complex.norm_cpow_eq_rpow_re_of_pos hNf_pos, h_exp_re, Real.rpow_zero]
    rw [← h_unfold_2, norm_mul, norm_mul, norm_mul, hω_norm, hNf_norm_one, one_mul, one_mul,
      ← norm_mul]

theorem mitsui_complex_gamma_norm_le_of_re_ge_two_add_nonneg_real (w : ℂ) (α : ℝ)
    (hw_re : 2 ≤ w.re) (hα : 0 ≤ α) :
    ‖Complex.Gamma w‖ ≤ ‖Complex.Gamma (w + (α : ℂ))‖ :=
by
  set σ : ℝ := w.re
  set τ : ℝ := w.im
  
  have hσ_mem : σ ∈ Set.Ici (2 : ℝ) := hw_re
  have hσα_mem : σ + α ∈ Set.Ici (2 : ℝ) := by
    simp only [Set.mem_Ici]
    dsimp [σ]
    linarith
  have hσ_le_σα : σ ≤ σ + α := by linarith
  have h_Γ_mono : Real.Gamma σ ≤ Real.Gamma (σ + α) :=
    Real.Gamma_strictMonoOn_Ici.monotoneOn hσ_mem hσα_mem hσ_le_σα
  have hσα_pos : 0 < σ + α := by dsimp [σ]; linarith
  have h_Γ_pos : 0 < Real.Gamma (σ + α) := Real.Gamma_pos_of_pos hσα_pos
  
  have h_factor : ∀ j : ℕ,
      0 < σ + (j : ℝ) ∧
      0 < σ + α + (j : ℝ) ∧
      0 < ‖w + (j : ℂ)‖ ∧
      0 < ‖w + (α : ℂ) + (j : ℂ)‖ ∧
      ‖w + (α : ℂ) + (j : ℂ)‖ * (σ + (j : ℝ)) ≤ ‖w + (j : ℂ)‖ * (σ + α + (j : ℝ)) := by
    intro j
    set x : ℝ := σ + (j : ℝ)
    set y : ℝ := σ + α + (j : ℝ)
    have hj_nn : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
    have hx_pos : 0 < x := by dsimp [x, σ]; linarith
    have hy_pos : 0 < y := by dsimp [y, σ]; linarith
    have hx_le_y : x ≤ y := by dsimp [x, y]; linarith
    have hwj_re : (w + (j : ℂ)).re = x := by simp [x, σ]
    have hwj_im : (w + (j : ℂ)).im = τ := by simp [τ]
    have hwαj_re : (w + (α : ℂ) + (j : ℂ)).re = y := by simp [y, σ]
    have hwαj_im : (w + (α : ℂ) + (j : ℂ)).im = τ := by simp [τ]
    have hwj_pos : 0 < ‖w + (j : ℂ)‖ := by
      have h1 : x ≤ |(w + (j : ℂ)).re| := by rw [hwj_re]; exact le_abs_self x
      have h2 : |(w + (j : ℂ)).re| ≤ ‖w + (j : ℂ)‖ := Complex.abs_re_le_norm (w + (j : ℂ))
      linarith
    have hwαj_pos : 0 < ‖w + (α : ℂ) + (j : ℂ)‖ := by
      have h1 : y ≤ |(w + (α : ℂ) + (j : ℂ)).re| := by rw [hwαj_re]; exact le_abs_self y
      have h2 : |(w + (α : ℂ) + (j : ℂ)).re| ≤ ‖w + (α : ℂ) + (j : ℂ)‖ :=
        Complex.abs_re_le_norm (w + (α : ℂ) + (j : ℂ))
      linarith
    have h_lhs_sq : (‖w + (α : ℂ) + (j : ℂ)‖ * x) ^ 2 = (y * y + τ * τ) * x ^ 2 := by
      rw [mul_pow, Complex.sq_norm, Complex.normSq_apply, hwαj_re, hwαj_im]
    have h_rhs_sq : (‖w + (j : ℂ)‖ * y) ^ 2 = (x * x + τ * τ) * y ^ 2 := by
      rw [mul_pow, Complex.sq_norm, Complex.normSq_apply, hwj_re, hwj_im]
    have h_sq_le : (‖w + (α : ℂ) + (j : ℂ)‖ * x) ^ 2 ≤ (‖w + (j : ℂ)‖ * y) ^ 2 := by
      rw [h_lhs_sq, h_rhs_sq]
      have h_diff : (x * x + τ * τ) * y ^ 2 - (y * y + τ * τ) * x ^ 2 =
          (τ * τ) * ((y - x) * (y + x)) := by ring
      have h_diff_nn : 0 ≤ (x * x + τ * τ) * y ^ 2 - (y * y + τ * τ) * x ^ 2 := by
        rw [h_diff]
        have hτ2 : 0 ≤ τ * τ := mul_self_nonneg τ
        have hyx1 : 0 ≤ y - x := by linarith
        have hyx2 : 0 ≤ y + x := by linarith
        positivity
      linarith
    have h_ineq : ‖w + (α : ℂ) + (j : ℂ)‖ * x ≤ ‖w + (j : ℂ)‖ * y :=
      (abs_le_of_sq_le_sq' h_sq_le (mul_nonneg (norm_nonneg _) (le_of_lt hy_pos))).2
    exact ⟨hx_pos, hy_pos, hwj_pos, hwαj_pos, h_ineq⟩
  
  have h_seq_le : ∀ n : ℕ, 1 ≤ n →
      ‖Complex.GammaSeq w n‖ * Real.GammaSeq (σ + α) n ≤
        ‖Complex.GammaSeq (w + (α : ℂ)) n‖ * Real.GammaSeq σ n := by
    intro n hn
    have hn_pos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
    set P_w : ℝ := ∏ j ∈ Finset.range (n + 1), ‖w + (j : ℂ)‖
    set P_wα : ℝ := ∏ j ∈ Finset.range (n + 1), ‖w + (α : ℂ) + (j : ℂ)‖
    set Q_σ : ℝ := ∏ j ∈ Finset.range (n + 1), (σ + (j : ℝ))
    set Q_σα : ℝ := ∏ j ∈ Finset.range (n + 1), (σ + α + (j : ℝ))
    have hP_wα_pos : 0 < P_wα := Finset.prod_pos (fun j _ => (h_factor j).2.2.2.1)
    have hQ_σ_pos : 0 < Q_σ := Finset.prod_pos (fun j _ => (h_factor j).1)
    have h_denom_pos : 0 < P_wα * Q_σ := mul_pos hP_wα_pos hQ_σ_pos
    have h_denom_le : P_wα * Q_σ ≤ P_w * Q_σα := by
      dsimp [P_wα, Q_σ, P_w, Q_σα]
      rw [← Finset.prod_mul_distrib, ← Finset.prod_mul_distrib]
      apply Finset.prod_le_prod
      · intro j _
        exact mul_nonneg (norm_nonneg _) (le_of_lt (h_factor j).1)
      · intro j _
        exact (h_factor j).2.2.2.2
    have h_wα_re : (w + (α : ℂ)).re = σ + α := by simp [σ]
    have hn_cpow : ∀ s : ℂ, ‖(n : ℂ) ^ s‖ = (n : ℝ) ^ s.re := by
      intro s
      rw [← Complex.ofReal_natCast, Complex.norm_cpow_eq_rpow_re_of_pos hn_pos]
    have h_norm_Gw : ‖Complex.GammaSeq w n‖ = ((n : ℝ) ^ σ * (n.factorial : ℝ)) / P_w := by
      dsimp [Complex.GammaSeq, P_w]
      rw [norm_div, norm_mul, hn_cpow w, Complex.norm_natCast, norm_prod]
    have h_norm_Gwα : ‖Complex.GammaSeq (w + (α : ℂ)) n‖ =
        ((n : ℝ) ^ (σ + α) * (n.factorial : ℝ)) / P_wα := by
      dsimp [Complex.GammaSeq, P_wα]
      rw [norm_div, norm_mul, hn_cpow (w + (α : ℂ)), h_wα_re,
          Complex.norm_natCast, norm_prod]
    have h_Rσ : Real.GammaSeq σ n = ((n : ℝ) ^ σ * (n.factorial : ℝ)) / Q_σ := rfl
    have h_Rσα : Real.GammaSeq (σ + α) n = ((n : ℝ) ^ (σ + α) * (n.factorial : ℝ)) / Q_σα := rfl
    rw [h_norm_Gw, h_norm_Gwα, h_Rσ, h_Rσα, div_mul_div_comm, div_mul_div_comm]
    set N : ℝ := ((n : ℝ) ^ σ * (n.factorial : ℝ)) * ((n : ℝ) ^ (σ + α) * (n.factorial : ℝ))
    have hN_nn : 0 ≤ N := by dsimp [N]; positivity
    have h_num_comm :
        ((n : ℝ) ^ (σ + α) * (n.factorial : ℝ)) * ((n : ℝ) ^ σ * (n.factorial : ℝ)) = N := by
      dsimp [N]; ring
    rw [h_num_comm]
    exact div_le_div_of_nonneg_left hN_nn h_denom_pos h_denom_le
  
  have h_tendsto_lhs : Filter.Tendsto
      (fun n : ℕ => ‖Complex.GammaSeq w n‖ * Real.GammaSeq (σ + α) n)
      Filter.atTop
      (nhds (‖Complex.Gamma w‖ * Real.Gamma (σ + α))) :=
    (Complex.GammaSeq_tendsto_Gamma w).norm.mul (Real.GammaSeq_tendsto_Gamma (σ + α))
  have h_tendsto_rhs : Filter.Tendsto
      (fun n : ℕ => ‖Complex.GammaSeq (w + (α : ℂ)) n‖ * Real.GammaSeq σ n)
      Filter.atTop
      (nhds (‖Complex.Gamma (w + (α : ℂ))‖ * Real.Gamma σ)) :=
    (Complex.GammaSeq_tendsto_Gamma (w + (α : ℂ))).norm.mul (Real.GammaSeq_tendsto_Gamma σ)
  have h_ev : ∀ᶠ n : ℕ in Filter.atTop,
      ‖Complex.GammaSeq w n‖ * Real.GammaSeq (σ + α) n ≤
        ‖Complex.GammaSeq (w + (α : ℂ)) n‖ * Real.GammaSeq σ n :=
    Filter.eventually_atTop.mpr ⟨1, h_seq_le⟩
  have h_lim_le :
      ‖Complex.Gamma w‖ * Real.Gamma (σ + α) ≤
        ‖Complex.Gamma (w + (α : ℂ))‖ * Real.Gamma σ :=
    le_of_tendsto_of_tendsto h_tendsto_lhs h_tendsto_rhs h_ev
  have h_rhs_le :
      ‖Complex.Gamma (w + (α : ℂ))‖ * Real.Gamma σ ≤
        ‖Complex.Gamma (w + (α : ℂ))‖ * Real.Gamma (σ + α) :=
    mul_le_mul_of_nonneg_left h_Γ_mono (norm_nonneg _)
  exact le_of_mul_le_mul_right (le_trans h_lim_le h_rhs_le) h_Γ_pos

theorem mitsui_complex_gamma_norm_le_of_re_ge_one_sub_im (u : ℂ) (β : ℝ)
    (hu_re : 1 ≤ u.re) (hu_im : 1 / 2 ≤ |u.im|) :
    ‖Complex.Gamma u‖ ≤
      Real.exp (2 * (|β| + β ^ 2)) * ‖Complex.Gamma (u - (β : ℂ) * Complex.I)‖ :=
by
  set u' : ℂ := u - (β : ℂ) * Complex.I
  set σ : ℝ := u.re
  set t : ℝ := u.im
  set T : ℝ := |t|
  set C_β : ℝ := 2 * (|β| + β ^ 2)
  set f : ℕ → ℝ := fun k => T / ((k : ℝ) + T)
  set δ : ℕ → ℝ := fun j => C_β * (f j - f (j + 1))
  have hT_ge : 1 / 2 ≤ T := hu_im
  have hT_pos : 0 < T := by linarith
  have h2T : 1 ≤ 2 * T := by linarith
  have hσ_ge : 1 ≤ σ := hu_re
  have hC_β_nn : 0 ≤ C_β := by dsimp [C_β]; positivity
  have hu'_re : u'.re = σ := by simp [u', σ]
  have hu'_im : u'.im = t - β := by simp [u', t]
  have h_s2 : ∀ j : ℕ,
      0 < ‖u + (j : ℂ)‖ ∧
      0 < ‖u' + (j : ℂ)‖ ∧
      ‖u' + (j : ℂ)‖ ≤ Real.exp (δ j) * ‖u + (j : ℂ)‖ := by
    intro j
    set x : ℝ := σ + (j : ℝ)
    have hj_nn : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
    have hx_ge : 1 + (j : ℝ) ≤ x := by dsimp [x]; linarith
    have hx_pos : 0 < x := by linarith
    have hu_j_re : (u + (j : ℂ)).re = x := by simp [x, σ]
    have hu_j_im : (u + (j : ℂ)).im = t := by simp [t]
    have hu'_j_re : (u' + (j : ℂ)).re = x := by simp [u', x, σ]
    have hu'_j_im : (u' + (j : ℂ)).im = t - β := by simp [u', t]
    have hu_j_pos : 0 < ‖u + (j : ℂ)‖ := by
      have h1 := Complex.abs_re_le_norm (u + (j : ℂ))
      rw [hu_j_re] at h1
      have h2 : x ≤ |x| := le_abs_self x
      linarith
    have hu'_j_pos : 0 < ‖u' + (j : ℂ)‖ := by
      have h1 := Complex.abs_re_le_norm (u' + (j : ℂ))
      rw [hu'_j_re] at h1
      have h2 : x ≤ |x| := le_abs_self x
      linarith
    set D_j : ℝ := ((j : ℝ) + T) * ((j : ℝ) + 1 + T)
    have hDj_pos : 0 < D_j := by dsimp [D_j]; positivity
    have hf_diff : f j - f (j + 1) = T / D_j := by
      dsimp [f, D_j]
      rw [Nat.cast_add_one]
      have h1 : (j : ℝ) + T ≠ 0 := by positivity
      have h2 : (j : ℝ) + 1 + T ≠ 0 := by positivity
      field_simp [h1, h2]
      ring
    have hδ_eq : δ j = (C_β * T) / D_j := by
      dsimp [δ]
      rw [hf_diff, mul_div_assoc]
    have hδ_nn : 0 ≤ δ j := by
      rw [hδ_eq]; positivity
    have hu_sq : ‖u + (j : ℂ)‖ ^ 2 = x ^ 2 + t ^ 2 := by
      rw [Complex.sq_norm, Complex.normSq_apply, hu_j_re, hu_j_im]
      ring
    have hu'_sq : ‖u' + (j : ℂ)‖ ^ 2 = (x ^ 2 + t ^ 2) + (-2 * β * t + β ^ 2) := by
      rw [Complex.sq_norm, Complex.normSq_apply, hu'_j_re, hu'_j_im]
      ring
    have h_bt : -β * t ≤ |β| * T := by
      calc -β * t ≤ |-β * t| := le_abs_self (-β * t)
        _ = |-(β * t)| := by ring_nf
        _ = |β * t| := abs_neg (β * t)
        _ = |β| * T := abs_mul β t
    have h_b2 : β ^ 2 ≤ 2 * β ^ 2 * T := by
      have h1 : 0 ≤ β ^ 2 * (2 * T - 1) := mul_nonneg (sq_nonneg β) (by linarith)
      linarith
    have h_pert_le : -2 * β * t + β ^ 2 ≤ C_β * T := by
      dsimp [C_β]
      linarith
    have h_poly_id : 2 * ((1 + (j : ℝ)) ^ 2 + T ^ 2) - D_j =
        ((j : ℝ) - T + 1 / 2) ^ 2 + 2 * (j : ℝ) + 7 / 4 := by
      dsimp [D_j]; ring
    have h_poly_nn : 0 ≤ ((j : ℝ) - T + 1 / 2) ^ 2 + 2 * (j : ℝ) + 7 / 4 := by positivity
    have hDj_le1 : D_j ≤ 2 * ((1 + (j : ℝ)) ^ 2 + T ^ 2) := by linarith
    have hx_sq_ge : (1 + (j : ℝ)) ^ 2 ≤ x ^ 2 := by nlinarith
    have hT_sq_eq : T ^ 2 = t ^ 2 := sq_abs t
    have hDj_le : D_j ≤ 2 * (x ^ 2 + t ^ 2) := by linarith
    have h_pert_le_δ : C_β * T ≤ (x ^ 2 + t ^ 2) * (2 * δ j) := by
      rw [hδ_eq]
      have h_rhs_eq : (x ^ 2 + t ^ 2) * (2 * (C_β * T / D_j)) =
          ((C_β * T) * (2 * (x ^ 2 + t ^ 2))) / D_j := by ring
      rw [h_rhs_eq, le_div_iff₀ hDj_pos]
      exact mul_le_mul_of_nonneg_left hDj_le (by positivity)
    have h_sq_le1 : ‖u' + (j : ℂ)‖ ^ 2 ≤ (x ^ 2 + t ^ 2) * (1 + 2 * δ j) := by
      linarith [hu'_sq, h_pert_le, h_pert_le_δ]
    have h_exp_sq : 1 + 2 * δ j ≤ (Real.exp (δ j)) ^ 2 := by
      calc 1 + 2 * δ j = 2 * δ j + 1 := by ring
        _ ≤ Real.exp (2 * δ j) := Real.add_one_le_exp (2 * δ j)
        _ = Real.exp (δ j + δ j) := by congr 1; ring
        _ = Real.exp (δ j) * Real.exp (δ j) := Real.exp_add (δ j) (δ j)
        _ = (Real.exp (δ j)) ^ 2 := (sq (Real.exp (δ j))).symm
    have h_sq_le2 : ‖u' + (j : ℂ)‖ ^ 2 ≤ (Real.exp (δ j) * ‖u + (j : ℂ)‖) ^ 2 := by
      calc ‖u' + (j : ℂ)‖ ^ 2
          ≤ (x ^ 2 + t ^ 2) * (1 + 2 * δ j) := h_sq_le1
        _ = ‖u + (j : ℂ)‖ ^ 2 * (1 + 2 * δ j) := by rw [hu_sq]
        _ ≤ ‖u + (j : ℂ)‖ ^ 2 * (Real.exp (δ j)) ^ 2 :=
            mul_le_mul_of_nonneg_left h_exp_sq (by positivity)
        _ = (Real.exp (δ j) * ‖u + (j : ℂ)‖) ^ 2 := by ring
    have h_norm_le : ‖u' + (j : ℂ)‖ ≤ Real.exp (δ j) * ‖u + (j : ℂ)‖ :=
      (abs_le_of_sq_le_sq' h_sq_le2 (by positivity)).2
    exact ⟨hu_j_pos, hu'_j_pos, h_norm_le⟩
  have h_s4 : ∀ n : ℕ,
      (∏ j ∈ Finset.range (n + 1), ‖u' + (j : ℂ)‖) ≤
        Real.exp C_β * (∏ j ∈ Finset.range (n + 1), ‖u + (j : ℂ)‖) := by
    intro n
    have h_prod1 :
        (∏ j ∈ Finset.range (n + 1), ‖u' + (j : ℂ)‖) ≤
          ∏ j ∈ Finset.range (n + 1), (Real.exp (δ j) * ‖u + (j : ℂ)‖) := by
      apply Finset.prod_le_prod
      · intro j _; exact norm_nonneg _
      · intro j _; exact (h_s2 j).2.2
    rw [Finset.prod_mul_distrib, ← Real.exp_sum] at h_prod1
    have h_sum_δ : (∑ j ∈ Finset.range (n + 1), δ j) = C_β * (f 0 - f (n + 1)) := by
      dsimp [δ]
      rw [← Finset.mul_sum, Finset.sum_range_sub' f (n + 1)]
    have hf0 : f 0 = 1 := by
      dsimp [f]
      rw [Nat.cast_zero, zero_add, div_self (ne_of_gt hT_pos)]
    have hfn_nn : 0 ≤ f (n + 1) := by
      dsimp [f]; positivity
    have h_sum_le : (∑ j ∈ Finset.range (n + 1), δ j) ≤ C_β := by
      rw [h_sum_δ, hf0]
      have h1 : 0 ≤ C_β * f (n + 1) := mul_nonneg hC_β_nn hfn_nn
      linarith
    have hexp_le : Real.exp (∑ j ∈ Finset.range (n + 1), δ j) ≤ Real.exp C_β :=
      Real.exp_le_exp.mpr h_sum_le
    calc (∏ j ∈ Finset.range (n + 1), ‖u' + (j : ℂ)‖)
        ≤ Real.exp (∑ j ∈ Finset.range (n + 1), δ j) *
            (∏ j ∈ Finset.range (n + 1), ‖u + (j : ℂ)‖) := h_prod1
      _ ≤ Real.exp C_β * (∏ j ∈ Finset.range (n + 1), ‖u + (j : ℂ)‖) :=
          mul_le_mul_of_nonneg_right hexp_le (Finset.prod_nonneg (fun _ _ => norm_nonneg _))
  have h_s6 : ∀ n : ℕ, 1 ≤ n →
      ‖u.GammaSeq n‖ ≤ Real.exp C_β * ‖u'.GammaSeq n‖ := by
    intro n hn
    have hn_pos : 0 < (n : ℝ) := Nat.cast_pos.mpr hn
    set E : ℝ := Real.exp C_β
    have hE_pos : 0 < E := Real.exp_pos C_β
    set P_u : ℝ := ∏ j ∈ Finset.range (n + 1), ‖u + (j : ℂ)‖
    set P_u' : ℝ := ∏ j ∈ Finset.range (n + 1), ‖u' + (j : ℂ)‖
    have hPu_pos : 0 < P_u := Finset.prod_pos (fun j _ => (h_s2 j).1)
    have hPu'_pos : 0 < P_u' := Finset.prod_pos (fun j _ => (h_s2 j).2.1)
    have h_norm_cpow_u : ‖(n : ℂ) ^ u‖ = (n : ℝ) ^ σ := by
      rw [← Complex.ofReal_natCast n, Complex.norm_cpow_eq_rpow_re_of_pos hn_pos]
    have h_norm_cpow_u' : ‖(n : ℂ) ^ u'‖ = (n : ℝ) ^ σ := by
      rw [← Complex.ofReal_natCast n, Complex.norm_cpow_eq_rpow_re_of_pos hn_pos, hu'_re]
    set N_num : ℝ := (n : ℝ) ^ σ * ‖(n.factorial : ℂ)‖
    have hN_nn : 0 ≤ N_num := by dsimp [N_num]; positivity
    have h_gs_u : ‖u.GammaSeq n‖ = N_num / P_u := by
      rw [Complex.GammaSeq.eq_def, norm_div, norm_mul, norm_prod, h_norm_cpow_u]
    have h_gs_u' : ‖u'.GammaSeq n‖ = N_num / P_u' := by
      rw [Complex.GammaSeq.eq_def, norm_div, norm_mul, norm_prod, h_norm_cpow_u']
    have h_div_le : N_num / (E * P_u) ≤ N_num / P_u' :=
      div_le_div_of_nonneg_left hN_nn hPu'_pos (h_s4 n)
    have h_mul_le : E * (N_num / (E * P_u)) ≤ E * (N_num / P_u') :=
      mul_le_mul_of_nonneg_left h_div_le (le_of_lt hE_pos)
    have h_cancel : E * (N_num / (E * P_u)) = N_num / P_u := by
      have hE_ne : E ≠ 0 := ne_of_gt hE_pos
      have hPu_ne : P_u ≠ 0 := ne_of_gt hPu_pos
      field_simp [hE_ne, hPu_ne]
    rw [h_gs_u, h_gs_u']
    linarith [h_mul_le, h_cancel]
  have h_tend_lhs : Filter.Tendsto (fun n => ‖u.GammaSeq n‖) Filter.atTop (nhds ‖Complex.Gamma u‖) :=
    (Complex.GammaSeq_tendsto_Gamma u).norm
  have h_tend_rhs : Filter.Tendsto (fun n => Real.exp C_β * ‖u'.GammaSeq n‖) Filter.atTop
      (nhds (Real.exp C_β * ‖Complex.Gamma u'‖)) :=
    ((Complex.GammaSeq_tendsto_Gamma u').norm).const_mul (Real.exp C_β)
  have h_ev : (fun n => ‖u.GammaSeq n‖) ≤ᶠ[Filter.atTop] (fun n => Real.exp C_β * ‖u'.GammaSeq n‖) :=
    Filter.eventually_atTop.mpr ⟨1, h_s6⟩
  exact le_of_tendsto_of_tendsto h_tend_lhs h_tend_rhs h_ev

theorem mitsui_complex_gamma_ratio_step_three_norm_le (z : ℂ) (α β : ℝ)
    (hz_im : 1 / 2 ≤ |z.im|) (hα : 0 ≤ α) :
    ‖Complex.Gamma z * (Complex.Gamma (z + (α : ℂ) - (β : ℂ) * Complex.I))⁻¹‖ ≤
      (1 + 2 * (α + |β|)) ^ 3 *
        ‖Complex.Gamma (z + 3) * (Complex.Gamma (z + 3 + (α : ℂ) - (β : ℂ) * Complex.I))⁻¹‖ :=
by
  set Δ : ℂ := (α : ℂ) - (β : ℂ) * Complex.I
  set C : ℝ := 1 + 2 * (α + |β|)
  have hαβ_nn : 0 ≤ α + |β| := by positivity
  have hC_nn : 0 ≤ C := by dsimp [C]; positivity
  have hΔ_norm : ‖Δ‖ ≤ α + |β| := by
    dsimp [Δ]
    calc ‖(α : ℂ) - (β : ℂ) * Complex.I‖
        ≤ ‖(α : ℂ)‖ + ‖(β : ℂ) * Complex.I‖ := norm_sub_le _ _
      _ = |α| + |β| * 1 := by
          rw [norm_mul, Complex.norm_real, Complex.norm_real, Complex.norm_I,
              Real.norm_eq_abs, Real.norm_eq_abs]
      _ = α + |β| := by rw [abs_of_nonneg hα, mul_one]
  have h_step : ∀ u : ℂ, 1 / 2 ≤ |u.im| →
      ‖Complex.Gamma u * (Complex.Gamma (u + (α : ℂ) - (β : ℂ) * Complex.I))⁻¹‖ ≤
        C * ‖Complex.Gamma (u + 1) * (Complex.Gamma (u + 1 + (α : ℂ) - (β : ℂ) * Complex.I))⁻¹‖ := by
    intro u hu_im
    have hu_norm : 1 / 2 ≤ ‖u‖ := le_trans hu_im (Complex.abs_im_le_norm u)
    have hu_pos : 0 < ‖u‖ := by linarith
    have hu_ne : u ≠ 0 := norm_pos_iff.mp hu_pos
    have huΔ : u + (α : ℂ) - (β : ℂ) * Complex.I = u + Δ := by dsimp [Δ]; ring
    have hu1Δ : u + 1 + (α : ℂ) - (β : ℂ) * Complex.I = u + 1 + Δ := by dsimp [Δ]; ring
    have h_add_one : u + Δ + 1 = u + 1 + Δ := by ring
    have h_id :
        u * (Complex.Gamma u * (Complex.Gamma (u + Δ))⁻¹) =
          (u + Δ) * (Complex.Gamma (u + 1) * (Complex.Gamma (u + 1 + Δ))⁻¹) := by
      calc u * (Complex.Gamma u * (Complex.Gamma (u + Δ))⁻¹)
          = (u * Complex.Gamma u) * ((u + Δ) * (Complex.Gamma (u + Δ + 1))⁻¹) := by
              rw [Complex.one_div_Gamma_eq_self_mul_one_div_Gamma_add_one (u + Δ)]
              ring
        _ = (u + Δ) * (Complex.Gamma (u + 1) * (Complex.Gamma (u + 1 + Δ))⁻¹) := by
              rw [← Complex.Gamma_add_one u hu_ne, h_add_one]
              ring
    have h_norm_id :
        ‖u‖ * ‖Complex.Gamma u * (Complex.Gamma (u + Δ))⁻¹‖ =
          ‖u + Δ‖ * ‖Complex.Gamma (u + 1) * (Complex.Gamma (u + 1 + Δ))⁻¹‖ := by
      have h1 := congrArg norm h_id
      simpa only [norm_mul] using h1
    have huΔ_le : ‖u + Δ‖ ≤ ‖u‖ * C := by
      have h_tri := norm_add_le u Δ
      have h_scale : α + |β| ≤ 2 * (α + |β|) * ‖u‖ := by nlinarith
      dsimp [C]
      linarith
    have h_mul_le :
        ‖u‖ * ‖Complex.Gamma u * (Complex.Gamma (u + Δ))⁻¹‖ ≤
          ‖u‖ * (C * ‖Complex.Gamma (u + 1) * (Complex.Gamma (u + 1 + Δ))⁻¹‖) := by
      calc ‖u‖ * ‖Complex.Gamma u * (Complex.Gamma (u + Δ))⁻¹‖
          = ‖u + Δ‖ * ‖Complex.Gamma (u + 1) * (Complex.Gamma (u + 1 + Δ))⁻¹‖ := h_norm_id
        _ ≤ (‖u‖ * C) * ‖Complex.Gamma (u + 1) * (Complex.Gamma (u + 1 + Δ))⁻¹‖ :=
            mul_le_mul_of_nonneg_right huΔ_le (norm_nonneg _)
        _ = ‖u‖ * (C * ‖Complex.Gamma (u + 1) * (Complex.Gamma (u + 1 + Δ))⁻¹‖) := by ring
    rw [huΔ, hu1Δ]
    exact le_of_mul_le_mul_left h_mul_le hu_pos
  have hz1_im : 1 / 2 ≤ |(z + 1).im| := by simpa using hz_im
  have hz2_im : 1 / 2 ≤ |(z + 2).im| := by simpa using hz_im
  have h1 := h_step z hz_im
  have h2 := h_step (z + 1) hz1_im
  have h3 := h_step (z + 2) hz2_im
  have hz11 : z + 1 + 1 = z + 2 := by ring
  have hz21 : z + 2 + 1 = z + 3 := by ring
  rw [hz11] at h2
  rw [hz21] at h3
  calc ‖Complex.Gamma z * (Complex.Gamma (z + (α : ℂ) - (β : ℂ) * Complex.I))⁻¹‖
      ≤ C * ‖Complex.Gamma (z + 1) * (Complex.Gamma (z + 1 + (α : ℂ) - (β : ℂ) * Complex.I))⁻¹‖ := h1
    _ ≤ C * (C * ‖Complex.Gamma (z + 2) * (Complex.Gamma (z + 2 + (α : ℂ) - (β : ℂ) * Complex.I))⁻¹‖) :=
        mul_le_mul_of_nonneg_left h2 hC_nn
    _ ≤ C * (C * (C * ‖Complex.Gamma (z + 3) * (Complex.Gamma (z + 3 + (α : ℂ) - (β : ℂ) * Complex.I))⁻¹‖)) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left h3 hC_nn) hC_nn
    _ = C ^ 3 * ‖Complex.Gamma (z + 3) * (Complex.Gamma (z + 3 + (α : ℂ) - (β : ℂ) * Complex.I))⁻¹‖ := by ring

theorem mitsui_shifted_gammaR_and_gammaC_norm_le_of_gamma_ratio (V : ℝ) (hV : 1 ≤ V) (s : ℂ) :
    (∀ (a : ℕ) (v : ℝ), a ≤ 1 →
      ‖Complex.Gammaℝ s * (Complex.Gammaℝ (s + (a : ℂ) - (v : ℂ) * Complex.I))⁻¹‖ ≤
        (2 * Real.pi) ^ V *
          ‖Complex.Gamma (s / 2) *
            (Complex.Gamma (s / 2 + (((a : ℝ) / 2 : ℝ) : ℂ) - ((v / 2 : ℝ) : ℂ) * Complex.I))⁻¹‖) ∧
    (∀ (l : ℕ) (v : ℝ), (l : ℝ) ≤ V →
      ‖Complex.Gammaℂ s *
          ((1 / 2 : ℂ) * (2 * (Real.pi : ℂ)) ^ (s + ((l : ℝ) / 2 : ℂ) - ((v : ℝ) / 2 : ℂ) * Complex.I) *
            (Complex.Gamma (s + ((l : ℝ) / 2 : ℂ) - ((v : ℝ) / 2 : ℂ) * Complex.I))⁻¹)‖ ≤
        (2 * Real.pi) ^ V *
          ‖Complex.Gamma s *
            (Complex.Gamma (s + (((l : ℝ) / 2 : ℝ) : ℂ) - ((v / 2 : ℝ) : ℂ) * Complex.I))⁻¹‖) :=
by
  have h_pi_pos : 0 < Real.pi := Real.pi_pos
  have h_pi_gt_three : 3 < Real.pi := Real.pi_gt_three
  have h_2pi_pos : 0 < 2 * Real.pi := by positivity
  have h_2pi_ge_one : 1 ≤ 2 * Real.pi := by linarith
  have h_2pi_cast : (2 : ℂ) * (Real.pi : ℂ) = ((2 * Real.pi : ℝ) : ℂ) := by push_cast; ring
  refine ⟨?_, ?_⟩
  · intro a v ha
    set z_q : ℂ := s + (a : ℂ) - (v : ℂ) * Complex.I
    have hz_q_div : z_q / 2 = s / 2 + (((a : ℝ) / 2 : ℝ) : ℂ) - ((v / 2 : ℝ) : ℂ) * Complex.I := by
      dsimp [z_q]; push_cast; ring
    have h_factor_R :
        Complex.Gammaℝ s * (Complex.Gammaℝ z_q)⁻¹ =
          ((Real.pi : ℂ) ^ (-s / 2) * ((Real.pi : ℂ) ^ (-z_q / 2))⁻¹) *
            (Complex.Gamma (s / 2) * (Complex.Gamma (z_q / 2))⁻¹) := by
      rw [Complex.Gammaℝ_def s, Complex.Gammaℝ_def z_q, mul_inv]
      ring
    have h_re_sub : (-s / 2).re - (-z_q / 2).re = (a : ℝ) / 2 := by
      simp [z_q]; ring
    have h_pref_R :
        ‖(Real.pi : ℂ) ^ (-s / 2) * ((Real.pi : ℂ) ^ (-z_q / 2))⁻¹‖ = Real.pi ^ ((a : ℝ) / 2) := by
      rw [norm_mul, norm_inv,
          Complex.norm_cpow_eq_rpow_re_of_pos h_pi_pos,
          Complex.norm_cpow_eq_rpow_re_of_pos h_pi_pos,
          ← div_eq_mul_inv, ← Real.rpow_sub h_pi_pos, h_re_sub]
    have ha_cast : (a : ℝ) ≤ 1 := by exact_mod_cast ha
    have ha_div_nn : 0 ≤ (a : ℝ) / 2 := by positivity
    have ha_div_le_V : (a : ℝ) / 2 ≤ V := by linarith
    have h_pi_pow_le : Real.pi ^ ((a : ℝ) / 2) ≤ (2 * Real.pi) ^ V := by
      calc Real.pi ^ ((a : ℝ) / 2)
          ≤ (2 * Real.pi) ^ ((a : ℝ) / 2) :=
            Real.rpow_le_rpow (le_of_lt h_pi_pos) (by linarith) ha_div_nn
        _ ≤ (2 * Real.pi) ^ V :=
            Real.rpow_le_rpow_of_exponent_le h_2pi_ge_one ha_div_le_V
    change ‖Complex.Gammaℝ s * (Complex.Gammaℝ z_q)⁻¹‖ ≤ _
    rw [h_factor_R, norm_mul, h_pref_R, ← hz_q_div]
    exact mul_le_mul_of_nonneg_right h_pi_pow_le (norm_nonneg _)
  · intro l v hl
    set z_p : ℂ := s + ((l : ℝ) / 2 : ℂ) - ((v : ℝ) / 2 : ℂ) * Complex.I
    have hz_p_eq : z_p = s + (((l : ℝ) / 2 : ℝ) : ℂ) - ((v / 2 : ℝ) : ℂ) * Complex.I := by
      dsimp [z_p]; push_cast; ring
    have h_factor_C :
        Complex.Gammaℂ s *
          ((1 / 2 : ℂ) * (2 * (Real.pi : ℂ)) ^ z_p * (Complex.Gamma z_p)⁻¹) =
        ((2 * (Real.pi : ℂ)) ^ (-s) * (2 * (Real.pi : ℂ)) ^ z_p) *
          (Complex.Gamma s * (Complex.Gamma z_p)⁻¹) := by
      rw [Complex.Gammaℂ_def s]
      ring
    have h_re_add : (-s).re + z_p.re = (l : ℝ) / 2 := by
      simp [z_p]
    have h_pref_C :
        ‖(2 * (Real.pi : ℂ)) ^ (-s) * (2 * (Real.pi : ℂ)) ^ z_p‖ = (2 * Real.pi) ^ ((l : ℝ) / 2) := by
      rw [norm_mul, h_2pi_cast,
          Complex.norm_cpow_eq_rpow_re_of_pos h_2pi_pos,
          Complex.norm_cpow_eq_rpow_re_of_pos h_2pi_pos,
          ← Real.rpow_add h_2pi_pos, h_re_add]
    have hl_nn : (0 : ℝ) ≤ (l : ℝ) := Nat.cast_nonneg l
    have hl_div_le_V : (l : ℝ) / 2 ≤ V := by linarith
    have h_2pi_pow_le : (2 * Real.pi) ^ ((l : ℝ) / 2) ≤ (2 * Real.pi) ^ V :=
      Real.rpow_le_rpow_of_exponent_le h_2pi_ge_one hl_div_le_V
    change ‖Complex.Gammaℂ s * ((1 / 2 : ℂ) * (2 * (Real.pi : ℂ)) ^ z_p * (Complex.Gamma z_p)⁻¹)‖ ≤ _
    rw [h_factor_C, norm_mul, h_pref_C, ← hz_p_eq]
    exact mul_le_mul_of_nonneg_right h_2pi_pow_le (norm_nonneg _)

theorem mitsui_shifted_gammaR_and_gammaC_neg_half_re_factor_bounds (V : ℝ) (hV : 1 ≤ V) (s : ℂ) (hs : s.re = -1 / 2) :
    (∀ (a : ℕ) (v : ℝ), a ≤ 1 → |v| ≤ V →
      ‖(Complex.Gammaℝ (s + (a : ℂ) - (v : ℂ) * Complex.I))⁻¹ *
        Complex.Gammaℝ ((1 - s) + (a : ℂ) + (v : ℂ) * Complex.I)‖ ≤
        (16 * Real.pi) * V * (‖s‖ / (2 * Real.pi))) ∧
    (∀ (l : ℕ) (v : ℝ), (l : ℝ) ≤ V → |v| ≤ V →
      ‖((1 / 2 : ℂ) * (2 * (Real.pi : ℂ)) ^ (s + ((l : ℝ) / 2 : ℂ) - ((v : ℝ) / 2 : ℂ) * Complex.I) *
          (Complex.Gamma (s + ((l : ℝ) / 2 : ℂ) - ((v : ℝ) / 2 : ℂ) * Complex.I))⁻¹) *
        Complex.Gammaℂ ((1 - s) + ((l : ℝ) / 2 : ℂ) + ((v : ℝ) / 2 : ℂ) * Complex.I)‖ ≤
        ((16 * Real.pi) * V * (‖s‖ / (2 * Real.pi))) ^ 2) :=
by
  have h_pi_pos : 0 < Real.pi := Real.pi_pos
  have h_2pi_pos : 0 < 2 * Real.pi := by positivity
  have h_two_le_pi : 2 ≤ Real.pi := Real.two_le_pi
  have hV_pos : 0 < V := by linarith
  have hs_norm_half : 1 / 2 ≤ ‖s‖ := by
    have h1 : |s.re| ≤ ‖s‖ := Complex.abs_re_le_norm s
    rw [hs, abs_of_neg (by norm_num)] at h1
    linarith
  have hs_two_norm : 1 ≤ 2 * ‖s‖ := by linarith
  have hs_norm_pos : 0 < ‖s‖ := by linarith
  have h_s_le_Vs : ‖s‖ ≤ V * ‖s‖ := by nlinarith
  have h_V_le_2Vs : V ≤ 2 * V * ‖s‖ := by nlinarith
  have h_one_le_2Vs : 1 ≤ 2 * V * ‖s‖ := by linarith
  refine ⟨?_, ?_⟩
  · intro a v ha hv
    set z_q : ℂ := s + (a : ℂ) - (v : ℂ) * Complex.I
    set w_q : ℂ := (1 - s) + (a : ℂ) + (v : ℂ) * Complex.I
    have h_shift_q : w_q / 2 = starRingEnd ℂ (z_q / 2) + 1 := by
      apply Complex.ext
      · simp [w_q, z_q, hs, map_ofNat]; ring
      · simp [w_q, z_q, map_ofNat]
    have h_zq_conj_ne : starRingEnd ℂ (z_q / 2) ≠ 0 := by
      intro h_zero
      have h_re_zero : (starRingEnd ℂ (z_q / 2)).re = 0 := by rw [h_zero, Complex.zero_re]
      simp [z_q, hs, map_ofNat] at h_re_zero
      rcases Nat.le_one_iff_eq_zero_or_eq_one.mp ha with rfl | rfl <;> norm_num at h_re_zero
    have h_gamma_q : Complex.Gamma (w_q / 2) =
        starRingEnd ℂ (z_q / 2) * starRingEnd ℂ (Complex.Gamma (z_q / 2)) := by
      rw [h_shift_q, Complex.Gamma_add_one _ h_zq_conj_ne, Complex.Gamma_conj]
    have h_norm_gamma_q : ‖Complex.Gamma (w_q / 2)‖ = (‖z_q‖ / 2) * ‖Complex.Gamma (z_q / 2)‖ := by
      rw [h_gamma_q, norm_mul, RingHomIsometric.norm_map, RingHomIsometric.norm_map,
        norm_div, Complex.norm_ofNat]
    have h_re_wq_half : 0 < (w_q / 2).re := by
      have ha_nn : (0 : ℝ) ≤ (a : ℝ) := Nat.cast_nonneg a
      simp [w_q, hs]
      linarith
    have h_gamma_wq_pos : 0 < ‖Complex.Gamma (w_q / 2)‖ :=
      norm_pos_iff.mpr (Complex.Gamma_ne_zero_of_re_pos h_re_wq_half)
    have h_gamma_zq_ne : ‖Complex.Gamma (z_q / 2)‖ ≠ 0 := by
      intro h_zero
      rw [h_zero, mul_zero] at h_norm_gamma_q
      linarith
    have h_re_diff_q : (-w_q / 2).re = -1 + (-z_q / 2).re := by
      simp [w_q, z_q, hs]; ring
    have h_rpow_q : Real.pi ^ ((-w_q / 2).re) = Real.pi⁻¹ * Real.pi ^ ((-z_q / 2).re) := by
      rw [h_re_diff_q, Real.rpow_add h_pi_pos, Real.rpow_neg_one]
    have h_pi_zq_ne : Real.pi ^ ((-z_q / 2).re) ≠ 0 :=
      ne_of_gt (Real.rpow_pos_of_pos h_pi_pos _)
    have h_lhs_q : ‖(Complex.Gammaℝ z_q)⁻¹ * Complex.Gammaℝ w_q‖ = ‖z_q‖ / (2 * Real.pi) := by
      rw [norm_mul, norm_inv, Complex.Gammaℝ_def, Complex.Gammaℝ_def,
        norm_mul, norm_mul,
        Complex.norm_cpow_eq_rpow_re_of_pos h_pi_pos,
        Complex.norm_cpow_eq_rpow_re_of_pos h_pi_pos,
        h_rpow_q, h_norm_gamma_q]
      have h_cancel :
          (Real.pi ^ (-z_q / 2).re * ‖Complex.Gamma (z_q / 2)‖)⁻¹ *
            (Real.pi⁻¹ * Real.pi ^ (-z_q / 2).re * (‖z_q‖ / 2 * ‖Complex.Gamma (z_q / 2)‖)) =
          Real.pi⁻¹ * (‖z_q‖ / 2) *
            ((Real.pi ^ (-z_q / 2).re)⁻¹ * Real.pi ^ (-z_q / 2).re) *
            (‖Complex.Gamma (z_q / 2)‖⁻¹ * ‖Complex.Gamma (z_q / 2)‖) := by
        rw [mul_inv]
        ring
      rw [h_cancel, inv_mul_cancel₀ h_pi_zq_ne, inv_mul_cancel₀ h_gamma_zq_ne]
      ring
    have hz_q_tri : ‖z_q‖ ≤ ‖s‖ + (a : ℝ) + |v| := by
      have ht1 := norm_sub_le (s + (a : ℂ)) ((v : ℂ) * Complex.I)
      have ht2 := norm_add_le s (a : ℂ)
      rw [Complex.norm_natCast] at ht2
      rw [norm_mul, Complex.norm_real, Complex.norm_I, mul_one, Real.norm_eq_abs] at ht1
      dsimp [z_q]
      linarith
    have ha_real_le : (a : ℝ) ≤ 1 := by exact_mod_cast ha
    have hz_q_le : ‖z_q‖ ≤ (16 * Real.pi) * V * ‖s‖ := by
      nlinarith [hz_q_tri, ha_real_le, hv, h_s_le_Vs, h_V_le_2Vs, h_one_le_2Vs, h_two_le_pi]
    rw [h_lhs_q]
