    exact Prod.ext (Prod.ext_iff.mp hp).1 (Subtype.ext (Prod.ext_iff.mp hp).2)
  have hΨ_surj : Function.Surjective Ψ := by
    intro x
    obtain ⟨⟨ζ, e⟩, hΦ⟩ := hΦ_surj ⟨x.1, x.2.1⟩
    have hΦ_val : (Φ_I (ζ, e)).1 = x.1 := congrArg Subtype.val hΦ
