    let a_arg : ℕ → ℝ := fun m => c * (m : ℝ) ^ (2 / (n : ℝ))
    refine Summable.of_nonneg_of_le
      (fun m => mul_nonneg (Nat.cast_nonneg _) (hJK_nn (a_arg m)))
      (fun m => ?_) h_maj_sum
    by_cases hm0 : m = 0
    · subst hm0
      haveI h_empty : IsEmpty (S_all 0) :=
        ⟨fun I => I.2.1 (Ideal.absNorm_eq_zero_iff.mp I.2.2)⟩
      rw [Nat.card_of_isEmpty, Nat.cast_zero, zero_mul]
      dsimp [maj]
      positivity
    · have hm_ge_one_nat : 1 ≤ m := Nat.one_le_iff_ne_zero.mpr hm0
      have hm_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm_ge_one_nat
      have hmα_ge_one : 1 ≤ (m : ℝ) ^ α := Real.one_le_rpow hm_ge_one (le_of_lt hα_pos)
      have ha_eq : a_arg m = a₀ * (m : ℝ) ^ α := rfl
      have ha_ge : a₀ ≤ a_arg m := by
        rw [ha_eq]
        exact le_mul_of_one_le_right (le_of_lt ha₀_pos) hmα_ge_one
      have hJK_m : J_K (a_arg m) ≤ M₀ * Real.exp (-c_decay * (m : ℝ) ^ α) := by
        have h1 := hJK_bound (a_arg m) ha_ge
        have h_exp_eq : -((n : ℝ) / 2) * a_arg m = -c_decay * (m : ℝ) ^ α := by
          rw [ha_eq]
          dsimp [c_decay]
          ring
        rwa [h_exp_eq] at h1
      have hm_le_sq : (m : ℝ) ≤ (m : ℝ) ^ (2 : ℝ) := by
        rw [Real.rpow_two]
        nlinarith
      have h_card_m : (Nat.card (S_all m) : ℝ) ≤ C₁ * (m : ℝ) ^ (2 : ℝ) := by
        calc (Nat.card (S_all m) : ℝ)
            ≤ C₁ * (m : ℝ) := ha_K_bound m hm_ge_one_nat
          _ ≤ C₁ * (m : ℝ) ^ (2 : ℝ) := mul_le_mul_of_nonneg_left hm_le_sq (le_of_lt hC₁_pos)
      have h_dom_m := h_dom m hm_ge_one_nat
      calc (Nat.card (S_all m) : ℝ) * J_K (a_arg m)
          ≤ (C₁ * (m : ℝ) ^ (2 : ℝ)) * (M₀ * Real.exp (-c_decay * (m : ℝ) ^ α)) :=
            mul_le_mul h_card_m hJK_m (hJK_nn _) (by positivity)
        _ = (M₀ * C₁) * (((m : ℝ) ^ (2 : ℝ)) * Real.exp (-c_decay * (m : ℝ) ^ α)) := by ring
        _ ≤ (M₀ * C₁) * (Real.exp K₀ * ((m : ℝ) ^ (2 : ℝ))⁻¹) :=
            mul_le_mul_of_nonneg_left h_dom_m (by positivity)
        _ = maj m := by dsimp [maj]; ring
  let E_fn : R → (Fin r → ℝ) → ℝ := fun x y =>
    Real.exp (-c *
      ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * (w (x : K)) ^ 2 *
          ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i))
  let G_int : R → ℝ := fun x => ∫ y in Cube, E_fn x y
  have h_meas_Cube : MeasurableSet Cube :=
    MeasurableSet.univ_pi (fun _ => measurableSet_Ico)
  have hG_nn : ∀ x : R, 0 ≤ G_int x := fun x =>
    MeasureTheory.setIntegral_nonneg h_meas_Cube (fun _ _ => Real.exp_nonneg _)
  have hG_prin : ∀ (I : Ideal R), I ≠ ⊥ → I ≤ (J : Ideal R) → I.IsPrincipal →
      Summable (fun x : Gen I => G_int x.1) :=
    fun I hI_ne _ hI_prin => (h_s2 I hI_ne hI_prin).1
  have hG_prin_eq : ∀ (I : Ideal R) (hI_ne : I ≠ ⊥) (hI_prin : I.IsPrincipal),
      (∑' x : Gen I, G_int x.1) =
        (NumberField.Units.torsionOrder K : ℝ) *
          J_K (c * (Ideal.absNorm I : ℝ) ^ (2 / (n : ℝ))) :=
    fun I hI_ne hI_prin => (h_s2 I hI_ne hI_prin).2
  clear h_gauss_int h_s2
  let maj_G : ℕ → ℝ := fun m =>
    (NumberField.Units.torsionOrder K : ℝ) *
      ((Nat.card (S_all (m * N_J)) : ℝ) *
        J_K (c * ((m * N_J : ℕ) : ℝ) ^ (2 / (n : ℝ))))
  have h_maj_sum : Summable maj_G := by
    have h1 := h_s4.comp_injective (mul_left_injective₀ hNJ_ne)
    exact h1.mul_left (NumberField.Units.torsionOrder K : ℝ)
  have hG_sum : Summable (fun m : ℕ =>
      ∑' I : S_prin m, ∑' x : Gen I.1, G_int x.1) := by
    refine Summable.of_nonneg_of_le (fun m => ?_) (fun m => ?_) h_maj_sum
    · exact tsum_nonneg (fun I => tsum_nonneg (fun x => hG_nn x.1))
    · have h_fib_eq : ∀ I : S_prin m,
          (∑' x : Gen I.1, G_int x.1) =
            (NumberField.Units.torsionOrder K : ℝ) *
              J_K (c * ((m * N_J : ℕ) : ℝ) ^ (2 / (n : ℝ))) := by
        intro I
        rw [hG_prin_eq I.1 I.2.1 I.2.2.2.1, I.2.2.2.2]
      simp_rw [h_fib_eq]
      rw [tsum_fintype, Finset.sum_const, nsmul_eq_mul, Finset.card_univ, ← Nat.card_eq_fintype_card]
      let ι_m : S_prin m → S_all (m * N_J) :=
        fun I => ⟨I.1, ⟨I.2.1, I.2.2.2.2⟩⟩
      have hι_inj : Function.Injective ι_m :=
        fun _ _ h => Subtype.ext (congrArg (Subtype.val : S_all (m * N_J) → Ideal R) h)
      have h_card : (Nat.card (S_prin m) : ℝ) ≤ (Nat.card (S_all (m * N_J)) : ℝ) := by
        exact_mod_cast Nat.card_le_card_of_injective ι_m hι_inj
      dsimp [maj_G]
      calc (Nat.card (S_prin m) : ℝ) *
            ((NumberField.Units.torsionOrder K : ℝ) *
              J_K (c * ((m * N_J : ℕ) : ℝ) ^ (2 / (n : ℝ))))
          = (NumberField.Units.torsionOrder K : ℝ) *
              ((Nat.card (S_prin m) : ℝ) *
                J_K (c * ((m * N_J : ℕ) : ℝ) ^ (2 / (n : ℝ)))) := by ring
        _ ≤ (NumberField.Units.torsionOrder K : ℝ) *
              ((Nat.card (S_all (m * N_J)) : ℝ) *
                J_K (c * ((m * N_J : ℕ) : ℝ) ^ (2 / (n : ℝ)))) := by
            refine mul_le_mul_of_nonneg_left ?_ (Nat.cast_nonneg _)
            exact mul_le_mul_of_nonneg_right h_card (hJK_nn _)
  have h_lat_sum : Summable (fun x : Lat_J => G_int x.1) :=
    h_s3 G_int hG_nn hG_prin hG_sum
  clear h_s3 h_s4 hG_prin hG_prin_eq h_maj_sum hG_sum
  let Box : Set (Fin r → ℝ) := Set.pi Set.univ (fun _ => Set.Icc (0 : ℝ) 1)
  have hBox_compact : IsCompact Box := isCompact_univ_pi (fun _ => isCompact_Icc)
  have hCube_sub_Box : Cube ⊆ Box := Set.pi_mono (fun _ _ => Set.Ico_subset_Icc_self)
  have h_E_cont : ∀ x : R, Continuous (E_fn x) := by
    intro x
    dsimp [E_fn]
    refine Real.continuous_exp.comp (continuous_const.mul ?_)
    refine continuous_finset_sum Finset.univ (fun w _ => ?_)
    refine continuous_const.mul (continuous_finset_prod Finset.univ (fun i _ => ?_))
    exact continuous_const.rpow
      (continuous_const.mul (continuous_apply i))
      (fun _ => Or.inl (ne_of_gt (hw_ε_pos w i)))
  have h_E_int : ∀ x : Lat_J, MeasureTheory.Integrable (E_fn x.1) (MeasureTheory.volume.restrict Cube) := by
    intro x
    exact ((h_E_cont x.1).continuousOn.integrableOn_compact hBox_compact).mono_set hCube_sub_Box
  have h_sum_int_norm : Summable (fun x : Lat_J => ∫ y in Cube, ‖E_fn x.1 y‖) := by
    have h_eq : (fun x : Lat_J => ∫ y in Cube, ‖E_fn x.1 y‖) = (fun x : Lat_J => G_int x.1) := by
      ext x
      dsimp [G_int]
      refine MeasureTheory.setIntegral_congr_fun h_meas_Cube (fun y _ => ?_)
      exact Real.norm_of_nonneg (Real.exp_nonneg _)
    rw [h_eq]
    exact h_lat_sum
  have h_int_tsum : (∑' x : Lat_J, G_int x.1) = ∫ y in Cube, F y :=
    MeasureTheory.integral_tsum_of_summable_integral_norm h_E_int h_sum_int_norm
  have hvol_Cube : MeasureTheory.volume Cube = 1 := by
    dsimp [Cube]
    rw [MeasureTheory.volume_pi, MeasureTheory.Measure.pi_pi]
    have h_ico : MeasureTheory.volume (Set.Ico (0 : ℝ) 1) = 1 := by
      rw [Real.volume_Ico, sub_zero, ENNReal.ofReal_one]
    simp [h_ico]
  let x₀ : Lat_J :=
    ⟨(N_J : R),
      ⟨Nat.cast_ne_zero.mpr hNJ_ne, Ideal.absNorm_mem (J : Ideal R)⟩⟩
  have hx₀_pos : 0 < G_int x₀.1 := by
    change 0 < ∫ y in Cube, E_fn x₀.1 y
    rw [MeasureTheory.integral_pos_iff_support_of_nonneg_ae
      (Filter.Eventually.of_forall (fun _ => Real.exp_nonneg _)) (h_E_int x₀)]
    have h_supp : Function.support (E_fn x₀.1) = Set.univ :=
      Set.eq_univ_of_forall (fun y => ne_of_gt (Real.exp_pos _))
    rw [h_supp, MeasureTheory.Measure.restrict_apply_univ, hvol_Cube]
    exact zero_lt_one
  have h_F_int_pos : 0 < ∫ y in Cube, F y := by
    rw [← h_int_tsum]
    exact Summable.tsum_pos h_lat_sum (fun x => hG_nn x.1) x₀ hx₀_pos
  have hF_int : MeasureTheory.IntegrableOn F Cube MeasureTheory.volume := by
    by_contra h_not
    have h_zero : (∫ y in Cube, F y) = 0 := MeasureTheory.integral_undef h_not
    linarith
  
  have hCube_lt_top : MeasureTheory.volume Cube < ⊤ := by
    rw [hvol_Cube]
    exact ENNReal.one_lt_top
  have h_const_int : MeasureTheory.IntegrableOn (fun _ : Fin r → ℝ => u - 1) Cube MeasureTheory.volume :=
    MeasureTheory.integrableOn_const (hs := hCube_lt_top.ne)
  have h_const_eq : (∫ _ : Fin r → ℝ in Cube, (u - 1)) = u - 1 := by
    rw [MeasureTheory.setIntegral_const, MeasureTheory.measureReal_def, hvol_Cube,
      ENNReal.toReal_one, one_smul]
  change (∫ y in Cube, G (fun i => y i + y₀ i)) = u * (∫ y in Cube, F y) + (u - 1)
  rw [h_shift_eq]
  dsimp [G]
  rw [MeasureTheory.integral_add (hF_int.const_mul u) h_const_int,
    MeasureTheory.integral_const_mul u F, h_const_eq]

theorem mitsui_classGroup_differentIdeal_involution_and_unitLog_scale {K : Type u} [Field K] [NumberField K]
    (J_rep : ClassGroup (NumberField.RingOfIntegers K) → nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))
    (hJ_cls : ∀ C : ClassGroup (NumberField.RingOfIntegers K), ClassGroup.mk0 (J_rep C) = C⁻¹) :
    let R := NumberField.RingOfIntegers K
    let n : ℕ := Module.finrank ℚ K
    let r : ℕ := NumberField.Units.rank K
    let D : ℝ := |(NumberField.discr K : ℝ)|
    ∃ (σ : ClassGroup R ≃ ClassGroup R)
      (γ : ClassGroup R → R)
      (y_γ : ClassGroup R → Fin r → ℝ),
      (∀ C : ClassGroup R, γ C ≠ 0) ∧
      (∀ C : ClassGroup R,
        differentIdeal ℤ R * (J_rep C : Ideal R) * (J_rep (σ C) : Ideal R) =
          Ideal.span ({γ C} : Set R)) ∧
      (∀ (C : ClassGroup R) (u : ℝ), 0 < u → ∀ y : Fin r → ℝ,
        let c_w : NumberField.InfinitePlace K → ℝ := fun w =>
          ((D ^ (-1 / 2 : ℝ) * u⁻¹) / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (1 / (n : ℝ)) *
            ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (y i)
        (∀ w : NumberField.InfinitePlace K, 0 < c_w w) ∧
        (D ^ (1 / 2 : ℝ) * (Ideal.absNorm (J_rep C : Ideal R) : ℝ) *
          ∏ w : NumberField.InfinitePlace K, (c_w w) ^ w.mult)⁻¹ = u ∧
        (∀ (x₁ : R) (w : NumberField.InfinitePlace K),
          (c_w w) ^ 2 * (w (x₁ : K)) ^ 2 =
            ((D ^ (-1 / 2 : ℝ) * u⁻¹) / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
              (w (x₁ : K)) ^ 2 *
              ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) ∧
        (∀ (x₂ : R) (w : NumberField.InfinitePlace K),
          (c_w w) ^ (-2 : ℤ) * (w ((x₂ : K) / (γ C : K))) ^ 2 =
            ((D ^ (-1 / 2 : ℝ) * u) / (Ideal.absNorm (J_rep (σ C) : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
              (w (x₂ : K)) ^ 2 *
              ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * (y i + y_γ C i)))) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let n : ℕ := Module.finrank ℚ K
  let r : ℕ := NumberField.Units.rank K
  let D : ℝ := |(NumberField.discr K : ℝ)|
  have hd_norm : Ideal.absNorm (differentIdeal ℤ R) = (NumberField.discr K).natAbs :=
    NumberField.absNorm_differentIdeal K R
  have hd_ne : differentIdeal ℤ R ≠ 0 := by
    intro h0
    have h_abs : Ideal.absNorm (differentIdeal ℤ R) = 0 :=
      Ideal.absNorm_eq_zero_iff.mpr h0
    rw [hd_norm] at h_abs
    exact Int.natAbs_ne_zero.mpr (NumberField.discr_ne_zero K) h_abs
  have hd_norm_real : (Ideal.absNorm (differentIdeal ℤ R) : ℝ) = D := by
    dsimp [D]
    rw [hd_norm]
    exact (Nat.cast_natAbs (α := ℝ) (NumberField.discr K)).trans (Int.cast_abs (R := ℝ))
  have hD_pos : 0 < D := by
    dsimp [D]
    exact abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  let d_K : nonZeroDivisors (Ideal R) :=
    ⟨differentIdeal ℤ R, mem_nonZeroDivisors_of_ne_zero hd_ne⟩
  let C₀ : ClassGroup R := ClassGroup.mk0 d_K
  let σ : ClassGroup R ≃ ClassGroup R :=
    (Equiv.inv (ClassGroup R)).trans (Equiv.mulLeft C₀)
  let P_C : ClassGroup R → nonZeroDivisors (Ideal R) :=
    fun C => d_K * J_rep C * J_rep (σ C)
  have h_mk0_P : ∀ C : ClassGroup R, ClassGroup.mk0 (P_C C) = 1 := by
    intro C
    dsimp [P_C]
    rw [map_mul, map_mul, hJ_cls C, hJ_cls (σ C)]
    change C₀ * C⁻¹ * (C₀ * C⁻¹)⁻¹ = 1
    exact mul_inv_cancel (C₀ * C⁻¹)
  have h_prin : ∀ C : ClassGroup R, ((P_C C : nonZeroDivisors (Ideal R)) : Ideal R).IsPrincipal :=
    fun C => (ClassGroup.mk0_eq_one_iff (P_C C).2).mp (h_mk0_P C)
  let γ : ClassGroup R → R := fun C =>
    @Submodule.IsPrincipal.generator _ _ _ _ _ ((P_C C : nonZeroDivisors (Ideal R)) : Ideal R) (h_prin C)
  have h_span : ∀ C : ClassGroup R,
      differentIdeal ℤ R * (J_rep C : Ideal R) * (J_rep (σ C) : Ideal R) =
        Ideal.span ({γ C} : Set R) := by
    intro C
    exact (@Submodule.IsPrincipal.span_singleton_generator _ _ _ _ _
      ((P_C C : nonZeroDivisors (Ideal R)) : Ideal R) (h_prin C)).symm
  have hγ_ne : ∀ C : ClassGroup R, γ C ≠ 0 := by
    intro C h0
    have hP_ne : ((P_C C : nonZeroDivisors (Ideal R)) : Ideal R) ≠ 0 :=
      nonZeroDivisors.coe_ne_zero (P_C C)
    apply hP_ne
    change differentIdeal ℤ R * (J_rep C : Ideal R) * (J_rep (σ C) : Ideal R) = ⊥
    rw [h_span C, h0, Ideal.span_singleton_zero]
  have hNγ_eq : ∀ C : ClassGroup R,
      (Ideal.absNorm (Ideal.span ({γ C} : Set R)) : ℝ) =
        D * (Ideal.absNorm (J_rep C : Ideal R) : ℝ) * (Ideal.absNorm (J_rep (σ C) : Ideal R) : ℝ) := by
    intro C
    rw [← h_span C, map_mul, map_mul, Nat.cast_mul, Nat.cast_mul, hd_norm_real]
  let ε : Fin r → Rˣ := NumberField.Units.fundSystem K
  have hw_ε_pos : ∀ (w : NumberField.InfinitePlace K) (i : Fin r),
      0 < w ((ε i : R) : K) := by
    intro w i
    exact w.pos_iff.mpr (NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero (ε i)))
  have hγ_coe : ∀ C : ClassGroup R, (γ C : K) ≠ 0 :=
    fun C => NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (hγ_ne C)
  have hw_γ_pos : ∀ (C : ClassGroup R) (w : NumberField.InfinitePlace K),
      0 < w (γ C : K) :=
    fun C w => w.pos_iff.mpr (hγ_coe C)
  let B_R : Module.Basis (Fin r) ℝ (NumberField.Units.dirichletUnitTheorem.logSpace K) :=
    Module.Basis.ofZLatticeBasis ℝ
      (NumberField.Units.unitLattice K)
      (NumberField.Units.basisUnitLattice K)
  let S_g : ClassGroup R → ℝ := fun C =>
    ∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * Real.log (v (γ C : K))
  let ℓ_g : ClassGroup R → NumberField.InfinitePlace K → ℝ :=
    fun C w => Real.log (w (γ C : K)) - S_g C / (n : ℝ)
  let L_vec : ClassGroup R → NumberField.Units.dirichletUnitTheorem.logSpace K :=
    fun C w => (w.1.mult : ℝ) * ℓ_g C w.1
  let y_γ : ClassGroup R → Fin r → ℝ := fun C j => B_R.repr (L_vec C) j
  let r_g : ClassGroup R → NumberField.InfinitePlace K → ℝ :=
    fun C v => ∑ j : Fin r, y_γ C j * Real.log (v ((ε j : R) : K))
  let w_dir : NumberField.InfinitePlace K := NumberField.Units.dirichletUnitTheorem.w₀
  have hn_pos : (0 : ℝ) < (n : ℝ) := by
    dsimp [n]
    exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
  have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  have h_sum_mult : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ)) = (n : ℝ) := by
    dsimp [n]
    exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
  have h_wγ_sq : ∀ (C : ClassGroup R) (w : NumberField.InfinitePlace K),
      (w (γ C : K)) ^ 2 =
        (D * (Ideal.absNorm (J_rep C : Ideal R) : ℝ) *
          (Ideal.absNorm (J_rep (σ C) : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
          ∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * y_γ C i) := by
    intro C w
    have h_ne_dir : ∀ v : NumberField.InfinitePlace K, v ≠ w_dir →
        (v.mult : ℝ) * ℓ_g C v = (v.mult : ℝ) * r_g C v := by
      intro v hv
      let v_sub : {v : NumberField.InfinitePlace K // v ≠ w_dir} := ⟨v, hv⟩
      have h_basis := congr_fun (Module.Basis.sum_repr B_R (L_vec C)).symm v_sub
      change (v.mult : ℝ) * ℓ_g C v = (∑ j : Fin r, (y_γ C j) • B_R j) v_sub at h_basis
      rw [h_basis]
      have h_eval : (∑ j : Fin r, (y_γ C j) • B_R j) v_sub =
          ∑ j : Fin r, y_γ C j * (B_R j v_sub) := by
        simp [Finset.sum_apply]
      rw [h_eval]
      dsimp [r_g]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      have hB_j : B_R j v_sub = (v.mult : ℝ) * Real.log (v ((ε j : R) : K)) := by
        dsimp [B_R, ε]
        rw [Module.Basis.ofZLatticeBasis_apply, ← NumberField.Units.logEmbedding_fundSystem,
          NumberField.Units.dirichletUnitTheorem.logEmbedding_component]
      rw [hB_j]
      ring
    have h_sum_ℓ : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * ℓ_g C v) = 0 := by
      dsimp [ℓ_g]
      simp_rw [mul_sub]
      rw [Finset.sum_sub_distrib, ← Finset.sum_mul, h_sum_mult, mul_div_cancel₀ _ hn_ne, sub_self]
    have h_sum_r : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * r_g C v) = 0 := by
      dsimp [r_g]
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_eq_zero (fun j _ => ?_)
      have h_comm : (∑ v : NumberField.InfinitePlace K,
          (v.mult : ℝ) * (y_γ C j * Real.log (v ((ε j : R) : K)))) =
          y_γ C j * (∑ v : NumberField.InfinitePlace K,
            (v.mult : ℝ) * Real.log (v ((ε j : R) : K))) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun v _ => by ring)
      rw [h_comm]
      have h_unit_sum : (∑ v : NumberField.InfinitePlace K,
          (v.mult : ℝ) * Real.log (v ((ε j : R) : K))) = 0 := by
        simpa [ε] using NumberField.Units.sum_mult_mul_log (NumberField.Units.fundSystem K j)
      rw [h_unit_sum, mul_zero]
    have h_all_mult : ∀ v : NumberField.InfinitePlace K,
        (v.mult : ℝ) * ℓ_g C v = (v.mult : ℝ) * r_g C v := by
      intro v
      by_cases hv : v = w_dir
      · subst hv
        have h1 := (Finset.add_sum_erase Finset.univ (fun v : NumberField.InfinitePlace K => (v.mult : ℝ) * ℓ_g C v) (Finset.mem_univ w_dir)).symm
        have h2 := (Finset.add_sum_erase Finset.univ (fun v : NumberField.InfinitePlace K => (v.mult : ℝ) * r_g C v) (Finset.mem_univ w_dir)).symm
        have h_erase : (∑ v ∈ Finset.univ.erase w_dir, (v.mult : ℝ) * ℓ_g C v) =
            (∑ v ∈ Finset.univ.erase w_dir, (v.mult : ℝ) * r_g C v) :=
          Finset.sum_congr rfl (fun v hv_mem => h_ne_dir v (Finset.ne_of_mem_erase hv_mem))
        linarith
      · exact h_ne_dir v hv
    have h_all : ∀ v : NumberField.InfinitePlace K, ℓ_g C v = r_g C v := by
      intro v
      have h_mult_pos : (0 : ℝ) < (v.mult : ℝ) := by
        exact_mod_cast NumberField.InfinitePlace.mult_pos (w := v)
      exact mul_left_cancel₀ (ne_of_gt h_mult_pos) (h_all_mult v)
    have h_Sg_eq : S_g C = Real.log (Ideal.absNorm (Ideal.span ({γ C} : Set R)) : ℝ) := by
      dsimp [S_g]
      have h_prod : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * Real.log (v (γ C : K))) =
          Real.log (∏ v : NumberField.InfinitePlace K, (v (γ C : K)) ^ v.mult) := by
        rw [Real.log_prod (fun v _ => pow_ne_zero v.mult (ne_of_gt (hw_γ_pos C v)))]
        refine Finset.sum_congr rfl (fun v _ => ?_)
        rw [Real.log_pow]
      rw [h_prod, NumberField.InfinitePlace.prod_eq_abs_norm]
      congr 1
      rw [Ideal.absNorm_span_singleton]
      have h_coe_norm : ((Algebra.norm ℤ (γ C) : ℤ) : ℚ) = Algebra.norm ℚ (γ C : K) :=
        Algebra.coe_norm_int (γ C)
      rw [← h_coe_norm]
      exact_mod_cast (Nat.cast_natAbs (Algebra.norm ℤ (γ C))).symm
    have hN_span_pos : (0 : ℝ) < (Ideal.absNorm (Ideal.span ({γ C} : Set R)) : ℝ) := by
      have h_span_ne : Ideal.span ({γ C} : Set R) ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr (hγ_ne C)
      exact_mod_cast Nat.pos_of_ne_zero (Ideal.absNorm_eq_zero_iff.not.mpr h_span_ne)
    have h_log_g : Real.log (w (γ C : K)) =
        Real.log (Ideal.absNorm (Ideal.span ({γ C} : Set R)) : ℝ) / (n : ℝ) + r_g C w := by
      have h1 := h_all w
      dsimp [ℓ_g] at h1
      rw [h_Sg_eq] at h1
      linarith
    have h2 : 2 * Real.log (w (γ C : K)) =
        Real.log (Ideal.absNorm (Ideal.span ({γ C} : Set R)) : ℝ) * (2 / (n : ℝ)) +
          ∑ i : Fin r, Real.log (w ((ε i : R) : K)) * (2 * y_γ C i) := by
      rw [h_log_g]
      dsimp [r_g]
      rw [mul_add, Finset.mul_sum]
      congr 1
      · ring
      · refine Finset.sum_congr rfl (fun i _ => by ring)
    have h_exp := congrArg Real.exp h2
    have h_lhs : Real.exp (2 * Real.log (w (γ C : K))) = (w (γ C : K)) ^ 2 := by
      rw [mul_comm, ← Real.rpow_def_of_pos (hw_γ_pos C w) 2, Real.rpow_two]
    have h_rhs : Real.exp (Real.log (Ideal.absNorm (Ideal.span ({γ C} : Set R)) : ℝ) * (2 / (n : ℝ)) +
        ∑ i : Fin r, Real.log (w ((ε i : R) : K)) * (2 * y_γ C i)) =
        (D * (Ideal.absNorm (J_rep C : Ideal R) : ℝ) *
          (Ideal.absNorm (J_rep (σ C) : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
          ∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * y_γ C i) := by
      rw [Real.exp_add, ← Real.rpow_def_of_pos hN_span_pos, hNγ_eq C, Real.exp_sum]
      congr 1
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [← Real.rpow_def_of_pos (hw_ε_pos w i)]
    linarith
  have hD_prod : D ^ (1 / 2 : ℝ) * D ^ (-1 / 2 : ℝ) = 1 := by
    rw [← Real.rpow_add hD_pos]; norm_num
  have hD_inv : (D ^ (1 / 2 : ℝ))⁻¹ = D ^ (-1 / 2 : ℝ) := by
    rw [← Real.rpow_neg (le_of_lt hD_pos)]; norm_num
  have hD_neg_inv : (D ^ (-1 / 2 : ℝ))⁻¹ = D ^ (1 / 2 : ℝ) := by
    rw [← hD_inv, inv_inv]
  have hD_inv_sq : D⁻¹ = D ^ (-1 / 2 : ℝ) * D ^ (-1 / 2 : ℝ) := by
    rw [← Real.rpow_add hD_pos, ← Real.rpow_neg_one]
    congr 1; norm_num
  have h_unit_prod : ∀ (u_unit : Rˣ) (t : ℝ),
      (∏ w : NumberField.InfinitePlace K,
        (w ((u_unit : R) : K)) ^ ((w.mult : ℝ) * t)) = 1 := by
    intro u_unit t
    have h_pos : ∀ w : NumberField.InfinitePlace K, 0 < w ((u_unit : R) : K) := by
      intro w
      exact w.pos_iff.mpr (NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero u_unit))
    have h_step : ∀ w : NumberField.InfinitePlace K,
        (w ((u_unit : R) : K)) ^ ((w.mult : ℝ) * t) =
        ((w ((u_unit : R) : K)) ^ w.mult) ^ t := by
      intro w
      rw [← Real.rpow_natCast, ← Real.rpow_mul (le_of_lt (h_pos w))]
    have h_congr : (∏ w : NumberField.InfinitePlace K, (w ((u_unit : R) : K)) ^ ((w.mult : ℝ) * t)) =
        ∏ w : NumberField.InfinitePlace K, ((w ((u_unit : R) : K)) ^ w.mult) ^ t :=
      Finset.prod_congr rfl (fun w _ => h_step w)
    rw [h_congr, Real.finset_prod_rpow _ _ (fun w _ => pow_nonneg (le_of_lt (h_pos w)) _)]
    have h_prod : (∏ w : NumberField.InfinitePlace K, (w ((u_unit : R) : K)) ^ w.mult) = 1 := by
      rw [NumberField.InfinitePlace.prod_eq_abs_norm]
      have h_norm := NumberField.Units.norm K u_unit
      exact_mod_cast h_norm
    rw [h_prod, Real.one_rpow]
  refine ⟨σ, γ, y_γ, hγ_ne, h_span, ?_⟩
  intro C u hu_pos y c_w
  set N_JC : ℝ := (Ideal.absNorm (J_rep C : Ideal R) : ℝ)
  set N_JσC : ℝ := (Ideal.absNorm (J_rep (σ C) : Ideal R) : ℝ)
  have hJC_ne : (J_rep C : Ideal R) ≠ 0 := nonZeroDivisors.coe_ne_zero (J_rep C)
  have hJσC_ne : (J_rep (σ C) : Ideal R) ≠ 0 := nonZeroDivisors.coe_ne_zero (J_rep (σ C))
  have hNJC_pos : 0 < N_JC := by
    dsimp [N_JC]
    exact_mod_cast Nat.pos_of_ne_zero (Ideal.absNorm_eq_zero_iff.not.mpr hJC_ne)
  have hNJσC_pos : 0 < N_JσC := by
    dsimp [N_JσC]
    exact_mod_cast Nat.pos_of_ne_zero (Ideal.absNorm_eq_zero_iff.not.mpr hJσC_ne)
  set A : ℝ := (D ^ (-1 / 2 : ℝ) * u⁻¹) / N_JC
  have hA_pos : 0 < A := by dsimp [A]; positivity
  have hc_w_pos : ∀ w : NumberField.InfinitePlace K, 0 < c_w w := by
    intro w
    dsimp [c_w]
    exact mul_pos (Real.rpow_pos_of_pos hA_pos _)
      (Finset.prod_pos (fun i _ => Real.rpow_pos_of_pos (hw_ε_pos w i) _))
  have hc_w_sq : ∀ w : NumberField.InfinitePlace K,
      (c_w w) ^ 2 =
        A ^ (2 / (n : ℝ)) *
          ∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * y i) := by
    intro w
    dsimp [c_w, A, N_JC, ε]
    rw [mul_pow, ← Finset.prod_pow]
    congr 1
    · rw [← Real.rpow_natCast, ← Real.rpow_mul (le_of_lt hA_pos)]
      congr 1
      ring
    · refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [← Real.rpow_natCast, ← Real.rpow_mul (le_of_lt (hw_ε_pos w i))]
      congr 1
      ring
  have h_prod_cw : (∏ w : NumberField.InfinitePlace K, (c_w w) ^ w.mult) = A := by
    have h_term : ∀ w : NumberField.InfinitePlace K,
        (c_w w) ^ w.mult =
          (A ^ (1 / (n : ℝ))) ^ w.mult *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ ((w.mult : ℝ) * y i) := by
      intro w
      dsimp [c_w, A, N_JC, ε]
      rw [mul_pow, ← Finset.prod_pow]
      congr 1
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [← Real.rpow_natCast, ← Real.rpow_mul (le_of_lt (hw_ε_pos w i))]
      congr 1
      ring
    have h_congr : (∏ w : NumberField.InfinitePlace K, (c_w w) ^ w.mult) =
        ∏ w : NumberField.InfinitePlace K,
          ((A ^ (1 / (n : ℝ))) ^ w.mult *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ ((w.mult : ℝ) * y i)) :=
      Finset.prod_congr rfl (fun w _ => h_term w)
    rw [h_congr, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq]
    have h_first : (A ^ (1 / (n : ℝ))) ^ n = A := by
      change (A ^ (1 / (n : ℝ))) ^ n = A
      rw [← Real.rpow_natCast, ← Real.rpow_mul (le_of_lt hA_pos),
        one_div_mul_cancel hn_ne, Real.rpow_one]
    have h_second : (∏ w : NumberField.InfinitePlace K,
        ∏ i : Fin r, (w ((ε i : R) : K)) ^ ((w.mult : ℝ) * y i)) = 1 := by
      rw [Finset.prod_comm]
      refine Finset.prod_eq_one (fun i _ => ?_)
      exact h_unit_prod (ε i) (y i)
    rw [h_first, h_second, mul_one]
  have h_inv_eq : (D ^ (1 / 2 : ℝ) * N_JC *
      ∏ w : NumberField.InfinitePlace K, (c_w w) ^ w.mult)⁻¹ = u := by
    rw [h_prod_cw]
    have hNJC_ne : N_JC ≠ 0 := ne_of_gt hNJC_pos
    have h_inner : D ^ (1 / 2 : ℝ) * N_JC * A = u⁻¹ := by
      dsimp [A]
      calc D ^ (1 / 2 : ℝ) * N_JC * ((D ^ (-1 / 2 : ℝ) * u⁻¹) / N_JC)
        _ = (D ^ (1 / 2 : ℝ) * D ^ (-1 / 2 : ℝ)) * (N_JC / N_JC) * u⁻¹ := by ring
        _ = 1 * 1 * u⁻¹ := by rw [hD_prod, div_self hNJC_ne]
        _ = u⁻¹ := by ring
    rw [h_inner, inv_inv]
  have h_sq1 : ∀ (x₁ : R) (w : NumberField.InfinitePlace K),
      (c_w w) ^ 2 * (w (x₁ : K)) ^ 2 =
        A ^ (2 / (n : ℝ)) * (w (x₁ : K)) ^ 2 *
          ∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * y i) := by
    intro x₁ w
    rw [hc_w_sq w]
    ring
  have h_sq2 : ∀ (x₂ : R) (w : NumberField.InfinitePlace K),
      (c_w w) ^ (-2 : ℤ) * (w ((x₂ : K) / (γ C : K))) ^ 2 =
        ((D ^ (-1 / 2 : ℝ) * u) / N_JσC) ^ (2 / (n : ℝ)) *
          (w (x₂ : K)) ^ 2 *
          ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (y i + y_γ C i)) := by
    intro x₂ w
    have h_cw_zpow : (c_w w) ^ (-2 : ℤ) = ((c_w w) ^ 2)⁻¹ := by
      rw [zpow_neg, zpow_two, sq]
    have h_w_div : (w ((x₂ : K) / (γ C : K))) ^ 2 =
        (w (x₂ : K)) ^ 2 * ((w (γ C : K)) ^ 2)⁻¹ := by
      rw [map_div₀, div_pow, div_eq_mul_inv]
    rw [h_cw_zpow, hc_w_sq w, mul_inv, h_w_div, h_wγ_sq C w, mul_inv]
    have h_scalar_prod : (A ^ (2 / (n : ℝ)))⁻¹ *
        ((D * N_JC * N_JσC) ^ (2 / (n : ℝ)))⁻¹ =
        ((D ^ (-1 / 2 : ℝ) * u) / N_JσC) ^ (2 / (n : ℝ)) := by
      have hDN_pos : 0 < D * N_JC * N_JσC := by positivity
      rw [← Real.inv_rpow (le_of_lt hA_pos), ← Real.inv_rpow (le_of_lt hDN_pos),
        ← Real.mul_rpow (inv_nonneg.mpr (le_of_lt hA_pos)) (inv_nonneg.mpr (le_of_lt hDN_pos))]
      congr 1
      have hNJC_ne : N_JC ≠ 0 := ne_of_gt hNJC_pos
      have hA_inv : A⁻¹ = N_JC * (D ^ (1 / 2 : ℝ) * u) := by
        dsimp [A]
        rw [inv_div, div_eq_mul_inv, mul_inv, inv_inv, hD_neg_inv]
      have hDN_inv : (D * N_JC * N_JσC)⁻¹ = D⁻¹ * N_JC⁻¹ * N_JσC⁻¹ := by
        rw [mul_inv, mul_inv]
      rw [hA_inv, hDN_inv, hD_inv_sq]
      calc N_JC * (D ^ (1 / 2 : ℝ) * u) * ((D ^ (-1 / 2 : ℝ) * D ^ (-1 / 2 : ℝ)) * N_JC⁻¹ * N_JσC⁻¹)
        _ = (N_JC * N_JC⁻¹) * (D ^ (1 / 2 : ℝ) * D ^ (-1 / 2 : ℝ)) * ((D ^ (-1 / 2 : ℝ) * u) * N_JσC⁻¹) := by ring
        _ = 1 * 1 * ((D ^ (-1 / 2 : ℝ) * u) / N_JσC) := by
            rw [mul_inv_cancel₀ hNJC_ne, hD_prod]
            ring
        _ = (D ^ (-1 / 2 : ℝ) * u) / N_JσC := by ring
    have h_unit_prod_inv :
        (∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * y i))⁻¹ *
          (∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * y_γ C i))⁻¹ =
        ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (y i + y_γ C i)) := by
      rw [← Finset.prod_inv_distrib, ← Finset.prod_inv_distrib, ← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [← Real.rpow_neg (le_of_lt (hw_ε_pos w i)), ← Real.rpow_neg (le_of_lt (hw_ε_pos w i)),
        ← Real.rpow_add (hw_ε_pos w i)]
      congr 1
      ring
    calc (A ^ (2 / (n : ℝ)))⁻¹ * (∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * y i))⁻¹ *
          ((w (x₂ : K)) ^ 2 * (((D * N_JC * N_JσC) ^ (2 / (n : ℝ)))⁻¹ *
            (∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * y_γ C i))⁻¹))
      _ = ((A ^ (2 / (n : ℝ)))⁻¹ * ((D * N_JC * N_JσC) ^ (2 / (n : ℝ)))⁻¹) *
            (w (x₂ : K)) ^ 2 *
            ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * y i))⁻¹ *
              (∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * y_γ C i))⁻¹) := by ring
      _ = ((D ^ (-1 / 2 : ℝ) * u) / N_JσC) ^ (2 / (n : ℝ)) *
            (w (x₂ : K)) ^ 2 *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (y i + y_γ C i)) := by
          rw [h_scalar_prod, h_unit_prod_inv]
  exact ⟨hc_w_pos, h_inv_eq, h_sq1, h_sq2⟩

theorem mitsui_ideal_lattice_trace_dual_zbasis_and_det {K : Type u} [Field K] [NumberField K]
    (J₁ J₂ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))
    (γ : NumberField.RingOfIntegers K) (hγ : γ ≠ 0)
    (h_span : differentIdeal ℤ (NumberField.RingOfIntegers K) *
      (J₁ : Ideal (NumberField.RingOfIntegers K)) *
      (J₂ : Ideal (NumberField.RingOfIntegers K)) =
      Ideal.span ({γ} : Set (NumberField.RingOfIntegers K))) :
    let R := NumberField.RingOfIntegers K
    let n : ℕ := Module.finrank ℚ K
    let D : ℝ := |(NumberField.discr K : ℝ)|
    ∃ (v₁ v₂ : Fin n → R)
      (e₁ : {k : Fin n → ℤ // k ≠ 0} ≃ {x : R // x ≠ 0 ∧ x ∈ (J₁ : Ideal R)})
      (e₂ : {m : Fin n → ℤ // m ≠ 0} ≃ {x : R // x ≠ 0 ∧ x ∈ (J₂ : Ideal R)}),
      (∀ k : {k : Fin n → ℤ // k ≠ 0},
        (((e₁ k).1 : R) : K) = ∑ i : Fin n, (k.1 i : K) * (v₁ i : K)) ∧
      (∀ m : {m : Fin n → ℤ // m ≠ 0},
        (((e₂ m).1 : R) : K) / (γ : K) = ∑ i : Fin n, (m.1 i : K) * ((v₂ i : K) / (γ : K))) ∧
      (∀ i j : Fin n,
        (Algebra.trace ℚ K ((v₁ i : K) * ((v₂ j : K) / (γ : K))) : ℝ) =
          if i = j then 1 else 0) ∧
      |(Matrix.of (fun i j : Fin n =>
          (Algebra.trace ℚ K ((v₁ i : K) * (v₁ j : K)) : ℝ))).det| =
        D * (Ideal.absNorm (J₁ : Ideal R) : ℝ) ^ 2 :=
by
  classical
  intro R n D
  have h_s1 : ∃ b₁ : Module.Basis (Fin n) ℚ K,
      (∀ x : K,
        x ∈ Submodule.span ℤ (Set.range ⇑b₁) ↔
          x ∈ ((J₁ : Ideal R) : FractionalIdeal (nonZeroDivisors R) K)) ∧
      |(Matrix.of (fun i j : Fin n =>
          (Algebra.trace ℚ K (b₁ i * b₁ j) : ℝ))).det| =
        D * (Ideal.absNorm (J₁ : Ideal R) : ℝ) ^ 2 := by
    have hJ₁_ne : (J₁ : Ideal R) ≠ ⊥ := nonZeroDivisors.coe_ne_zero J₁
    let I₁ : FractionalIdeal (nonZeroDivisors R) K := ↑(J₁ : Ideal R)
    have hI₁_ne : I₁ ≠ 0 := FractionalIdeal.coeIdeal_ne_zero.mpr hJ₁_ne
    let I₁_unit : (FractionalIdeal (nonZeroDivisors R) K)ˣ := Units.mk0 I₁ hI₁_ne
    let b_int := NumberField.integralBasis K
    let b_frac := NumberField.basisOfFractionalIdeal K I₁_unit
    have h_card_int : Fintype.card (Module.Free.ChooseBasisIndex ℤ R) = n := by
      rw [← Module.finrank_eq_card_basis b_int]
    have h_card_frac :
        Fintype.card (Module.Free.ChooseBasisIndex ℤ ↥((I₁_unit : FractionalIdeal (nonZeroDivisors R) K) : Submodule R K)) = n := by
      rw [← Module.finrank_eq_card_basis b_frac]
    let e₀ : Module.Free.ChooseBasisIndex ℤ R ≃ Fin n :=
      Fintype.equivOfCardEq (h_card_int.trans (Fintype.card_fin n).symm)
    let e₁ : Module.Free.ChooseBasisIndex ℤ ↥((I₁_unit : FractionalIdeal (nonZeroDivisors R) K) : Submodule R K) ≃ Fin n :=
      Fintype.equivOfCardEq (h_card_frac.trans (Fintype.card_fin n).symm)
    let e₀₁ : Module.Free.ChooseBasisIndex ℤ R ≃
        Module.Free.ChooseBasisIndex ℤ ↥((I₁_unit : FractionalIdeal (nonZeroDivisors R) K) : Submodule R K) :=
      e₀.trans e₁.symm
    let b₁ : Module.Basis (Fin n) ℚ K := b_frac.reindex e₁
    refine ⟨b₁, ?_, ?_⟩
    · intro x
      have h_range : Set.range ⇑b₁ = Set.range ⇑b_frac := by
        ext y
        simp [b₁]
      rw [h_range, NumberField.mem_span_basisOfFractionalIdeal]
      rfl
    · let b₁₀ : Module.Basis (Module.Free.ChooseBasisIndex ℤ R) ℚ K := b_frac.reindex e₀₁.symm
      have hb₁₀_coe : ⇑b₁₀ = ⇑b₁ ∘ ⇑(e₀.symm).symm := by
        ext i
        dsimp [b₁₀, b₁, e₀₁]
        simp [Module.Basis.reindex_apply]
      have h_discr_reindex : Algebra.discr ℚ ⇑b₁₀ = Algebra.discr ℚ ⇑b₁ := by
        rw [hb₁₀_coe]
        exact Algebra.discr_reindex ℚ b₁ e₀.symm
      let P := b_int.toMatrix ⇑b₁₀
      have h_vecMul : Matrix.vecMul ⇑b_int (P.map (algebraMap ℚ K)) = ⇑b₁₀ := by
        ext j
        rw [Matrix.vecMul_eq_sum, Finset.sum_apply]
        have h_sum : (∑ i, (b_int i • P.map (algebraMap ℚ K) i) j) = ∑ i, P i j • b_int i := by
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [Pi.smul_apply, Matrix.map_apply, smul_eq_mul, Algebra.smul_def, mul_comm]
        rw [h_sum]
        exact b_int.sum_toMatrix_smul_self ⇑b₁₀ j
      have h_discr_vecMul : Algebra.discr ℚ ⇑b₁₀ = P.det ^ 2 * Algebra.discr ℚ ⇑b_int := by
        rw [← h_vecMul]
        exact Algebra.discr_of_matrix_vecMul ⇑b_int P
      have h_det_abs : |P.det| = (Ideal.absNorm (J₁ : Ideal R) : ℚ) := by
        have h1 : P.det = b_int.det ⇑b₁₀ := (b_int.det_apply ⇑b₁₀).symm
        rw [h1]
        have h2 := NumberField.det_basisOfFractionalIdeal_eq_absNorm K I₁_unit e₀₁
        have h3 : FractionalIdeal.absNorm (I₁_unit : FractionalIdeal (nonZeroDivisors R) K) =
            (Ideal.absNorm (J₁ : Ideal R) : ℚ) :=
          FractionalIdeal.coeIdeal_absNorm (J₁ : Ideal R)
        exact h2.trans h3
      have h_det_sq : P.det ^ 2 = (Ideal.absNorm (J₁ : Ideal R) : ℚ) ^ 2 := by
        rw [← sq_abs P.det, h_det_abs]
      have h_discr_eq :
          (Algebra.traceMatrix ℚ ⇑b₁).det =
            (Ideal.absNorm (J₁ : Ideal R) : ℚ) ^ 2 * (NumberField.discr K : ℚ) := by
        rw [← Algebra.discr_def ℚ ⇑b₁, ← h_discr_reindex, h_discr_vecMul, h_det_sq, NumberField.coe_discr K]
      have h_mat_eq :
          Matrix.of (fun i j : Fin n => (Algebra.trace ℚ K (b₁ i * b₁ j) : ℝ)) =
            (algebraMap ℚ ℝ).mapMatrix (Algebra.traceMatrix ℚ ⇑b₁) := by
        ext i j
        simp [Algebra.traceMatrix_apply]
      rw [h_mat_eq, ← RingHom.map_det (algebraMap ℚ ℝ)]
      change |(((Algebra.traceMatrix ℚ ⇑b₁).det : ℚ) : ℝ)| = D * (Ideal.absNorm (J₁ : Ideal R) : ℝ) ^ 2
      rw [h_discr_eq]
      push_cast
      rw [abs_mul, abs_pow, Nat.abs_cast, mul_comm]
  obtain ⟨b₁, hb₁_span, hb₁_det⟩ := h_s1
  have h_s2 :
      (∀ i j : Fin n,
        (Algebra.trace ℚ K (b₁ i * b₁.traceDual j) : ℝ) =
          if i = j then 1 else 0) ∧
      (∀ x : K,
        x ∈ Submodule.span ℤ (Set.range ⇑b₁.traceDual) ↔
          (γ : K) * x ∈ ((J₂ : Ideal R) : FractionalIdeal (nonZeroDivisors R) K)) := by
    refine ⟨?_, ?_⟩
    · intro i j
      rw [b₁.trace_mul_traceDual i j]
      split_ifs <;> simp
    · intro x
      have hJ₁_ne : (J₁ : Ideal R) ≠ ⊥ := nonZeroDivisors.coe_ne_zero J₁
      let I₁ : FractionalIdeal (nonZeroDivisors R) K := ↑(J₁ : Ideal R)
      let I₂ : FractionalIdeal (nonZeroDivisors R) K := ↑(J₂ : Ideal R)
      let I_D : FractionalIdeal (nonZeroDivisors R) K := ↑(differentIdeal ℤ R : Ideal R)
      have hI₁_ne : I₁ ≠ 0 := FractionalIdeal.coeIdeal_ne_zero.mpr hJ₁_ne
      have h_sub_eq : Submodule.restrictScalars ℤ (I₁ : Submodule R K) = Submodule.span ℤ (Set.range ⇑b₁) := by
        ext y
        exact (hb₁_span y).symm
      have h_dual_span := Submodule.traceDual_span_of_basis ℤ (I₁ : Submodule R K) b₁ h_sub_eq
      have h_coe_dual : ((FractionalIdeal.dual ℤ ℚ I₁ : FractionalIdeal (nonZeroDivisors R) K) : Submodule R K) =
          Submodule.traceDual ℤ ℚ (I₁ : Submodule R K) :=
        FractionalIdeal.coe_dual ℤ ℚ hI₁_ne
      have h_mem_dual : x ∈ Submodule.span ℤ (Set.range ⇑b₁.traceDual) ↔ x ∈ FractionalIdeal.dual ℤ ℚ I₁ := by
        rw [← h_dual_span, ← h_coe_dual]
        rfl
      rw [h_mem_dual]
      have h_diff : I_D = (FractionalIdeal.dual ℤ ℚ (1 : FractionalIdeal (nonZeroDivisors R) K))⁻¹ :=
        coeIdeal_differentIdeal ℤ ℚ K R
      have h_dual_one : FractionalIdeal.dual ℤ ℚ (1 : FractionalIdeal (nonZeroDivisors R) K) = I_D⁻¹ := by
        rw [h_diff, inv_inv]
      have h_dual_I₁ : FractionalIdeal.dual ℤ ℚ I₁ = (I_D * I₁)⁻¹ := by
        rw [FractionalIdeal.dual_eq_mul_inv ℤ ℚ I₁, h_dual_one, mul_inv_rev, mul_comm]
      let S_γ : FractionalIdeal (nonZeroDivisors R) K :=
        FractionalIdeal.spanSingleton (nonZeroDivisors R) (γ : K)
      have h_coe_span : (I_D * I₁) * I₂ = S_γ := by
        have h1 := congr_arg ((↑) : Ideal R → FractionalIdeal (nonZeroDivisors R) K) h_span
        rw [FractionalIdeal.coeIdeal_mul, FractionalIdeal.coeIdeal_mul,
            FractionalIdeal.coeIdeal_span_singleton] at h1
        exact h1
      have hγ_K : (γ : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hγ
      have hSγ_ne : S_γ ≠ 0 := FractionalIdeal.spanSingleton_eq_zero_iff.not.mpr hγ_K
      have hI_D_I₁_ne : I_D * I₁ ≠ 0 := by
        intro h_zero
        rw [h_zero, zero_mul] at h_coe_span
        exact hSγ_ne h_coe_span.symm
      have h_dual_eq_span_mul :
          FractionalIdeal.dual ℤ ℚ I₁ =
            FractionalIdeal.spanSingleton (nonZeroDivisors R) (γ : K)⁻¹ * I₂ := by
        rw [h_dual_I₁, ← FractionalIdeal.spanSingleton_inv K (γ : K)]
        calc (I_D * I₁)⁻¹
            = (I_D * I₁)⁻¹ * (S_γ * S_γ⁻¹) := by rw [mul_inv_cancel₀ hSγ_ne, mul_one]
          _ = (I_D * I₁)⁻¹ * (((I_D * I₁) * I₂) * S_γ⁻¹) := by rw [h_coe_span]
          _ = ((I_D * I₁)⁻¹ * (I_D * I₁)) * (I₂ * S_γ⁻¹) := by ring
          _ = S_γ⁻¹ * I₂ := by rw [inv_mul_cancel₀ hI_D_I₁_ne, one_mul, mul_comm]
      rw [h_dual_eq_span_mul, FractionalIdeal.mem_singleton_mul]
      constructor
      · rintro ⟨y', hy', rfl⟩
        rw [mul_inv_cancel_left₀ hγ_K]
        exact hy'
      · intro hx
        exact ⟨(γ : K) * x, hx, (inv_mul_cancel_left₀ hγ_K x).symm⟩
  obtain ⟨h_dual_b₁, hb₂_span⟩ := h_s2
  have h_s3 : ∀ (J : Ideal R) (γ₀ : R) (hγ₀ : γ₀ ≠ 0) (b : Module.Basis (Fin n) ℚ K),
      (∀ x : K,
        x ∈ Submodule.span ℤ (Set.range ⇑b) ↔
          (γ₀ : K) * x ∈ (J : FractionalIdeal (nonZeroDivisors R) K)) →
      ∃ (v : Fin n → R)
        (e : {m : Fin n → ℤ // m ≠ 0} ≃ {x : R // x ≠ 0 ∧ x ∈ J}),
        (∀ i : Fin n, (v i : K) / (γ₀ : K) = b i) ∧
        (∀ m : {m : Fin n → ℤ // m ≠ 0},
          (((e m).1 : R) : K) / (γ₀ : K) = ∑ i : Fin n, (m.1 i : K) * ((v i : K) / (γ₀ : K))) := by
    intro J γ₀ hγ₀ b hb_span
    have hγ₀_K : (γ₀ : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hγ₀
    have hv_ex : ∀ i : Fin n, ∃ r : R, r ∈ J ∧ (r : K) = (γ₀ : K) * b i := by
      intro i
      have hb_mem : b i ∈ Submodule.span ℤ (Set.range ⇑b) :=
        Submodule.subset_span (Set.mem_range_self i)
      have h_coe_mem : (γ₀ : K) * b i ∈ (J : FractionalIdeal (nonZeroDivisors R) K) :=
        (hb_span (b i)).mp hb_mem
      rwa [FractionalIdeal.mem_coeIdeal] at h_coe_mem
    let v : Fin n → R := fun i => Classical.choose (hv_ex i)
    have hv_mem : ∀ i : Fin n, v i ∈ J := fun i => (Classical.choose_spec (hv_ex i)).1
    have hv_eq : ∀ i : Fin n, (v i : K) = (γ₀ : K) * b i := fun i => (Classical.choose_spec (hv_ex i)).2
    have hv_div : ∀ i : Fin n, (v i : K) / (γ₀ : K) = b i := by
      intro i
      rw [hv_eq i, mul_div_cancel_left₀ (b i) hγ₀_K]
    let F : (Fin n → ℤ) → R := fun m => ∑ i : Fin n, m i • v i
    have hF_mem : ∀ m : Fin n → ℤ, F m ∈ J :=
      fun m => Submodule.sum_smul_mem (J.restrictScalars ℤ) m (fun i _ => hv_mem i)
    have hF_div : ∀ m : Fin n → ℤ, ((F m : R) : K) / (γ₀ : K) = ∑ i : Fin n, (m i : K) * b i := by
      intro m
      have hF_coe : ((F m : R) : K) = (γ₀ : K) * ∑ i : Fin n, (m i : K) * b i := by
        dsimp [F]
        push_cast
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        change m i • (v i : K) = (γ₀ : K) * ((m i : K) * b i)
        rw [hv_eq i, zsmul_eq_mul, mul_left_comm]
      rw [hF_coe, mul_div_cancel_left₀ _ hγ₀_K]
    have hF_repr : ∀ (m : Fin n → ℤ) (j : Fin n),
        b.repr (((F m : R) : K) / (γ₀ : K)) j = (m j : ℚ) := by
      intro m j
      rw [hF_div m]
      have h_smul : (∑ i : Fin n, (m i : K) * b i) = ∑ i : Fin n, (m i : ℚ) • b i := by
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Algebra.smul_def, eq_ratCast, Rat.cast_intCast]
      rw [h_smul, map_sum]
      simp [Module.Basis.repr_self, Finsupp.single_apply]
    have hF_inj : Function.Injective F := by
      intro m₁ m₂ hm
      ext j
      have h_eq : (m₁ j : ℚ) = (m₂ j : ℚ) := by
        rw [← hF_repr m₁ j, ← hF_repr m₂ j, hm]
      exact Int.cast_injective h_eq
    have hF_zero : F 0 = 0 := by
      dsimp [F]
      simp
    have hF_ne_zero : ∀ {m : Fin n → ℤ}, m ≠ 0 → F m ≠ 0 := by
      intro m hm h0
      apply hm
      apply hF_inj
      rw [h0, hF_zero]
    let f_sub : {m : Fin n → ℤ // m ≠ 0} → {x : R // x ≠ 0 ∧ x ∈ J} :=
      fun m => ⟨F m.1, ⟨hF_ne_zero m.2, hF_mem m.1⟩⟩
    have hf_bij : Function.Bijective f_sub := by
      refine ⟨?_, ?_⟩
      · intro m₁ m₂ hm
        ext1
        exact hF_inj (Subtype.ext_iff.mp hm)
      · rintro ⟨x, hx_ne, hx_mem⟩
        have hx_coe_mem : (γ₀ : K) * ((x : K) / (γ₀ : K)) ∈ (J : FractionalIdeal (nonZeroDivisors R) K) := by
          rw [mul_div_cancel₀ _ hγ₀_K]
          exact (FractionalIdeal.mem_coeIdeal (nonZeroDivisors R)).mpr ⟨x, hx_mem, rfl⟩
        have hx_span : (x : K) / (γ₀ : K) ∈ Submodule.span ℤ (Set.range ⇑b) :=
          (hb_span ((x : K) / (γ₀ : K))).mpr hx_coe_mem
        rw [Submodule.mem_span_range_iff_exists_fun ℤ] at hx_span
        obtain ⟨m, hm⟩ := hx_span
        have hF_x_div : ((F m : R) : K) / (γ₀ : K) = (x : K) / (γ₀ : K) := by
          rw [hF_div m, ← hm]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [zsmul_eq_mul]
        have hF_x_coe : ((F m : R) : K) = (x : K) := (div_left_inj' hγ₀_K).mp hF_x_div
        have hF_x : F m = x := NumberField.RingOfIntegers.ext_iff.mpr hF_x_coe
        have hm_ne : m ≠ 0 := by
          intro hm0
          apply hx_ne
          rw [← hF_x, hm0, hF_zero]
        exact ⟨⟨m, hm_ne⟩, Subtype.ext hF_x⟩
    let e := Equiv.ofBijective f_sub hf_bij
    refine ⟨v, e, hv_div, ?_⟩
    intro m
    change ((F m.1 : R) : K) / (γ₀ : K) = ∑ i : Fin n, (m.1 i : K) * ((v i : K) / (γ₀ : K))
    rw [hF_div m.1]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hv_div i]
  have h_one_K : ((1 : R) : K) = 1 := rfl
  have hb₁_span' : ∀ x : K,
      x ∈ Submodule.span ℤ (Set.range ⇑b₁) ↔
        ((1 : R) : K) * x ∈ ((J₁ : Ideal R) : FractionalIdeal (nonZeroDivisors R) K) := by
    intro x
    rw [h_one_K, one_mul]
    exact hb₁_span x
  obtain ⟨v₁, e₁, hv₁_eq, he₁_lin⟩ :=
    h_s3 (J₁ : Ideal R) 1 one_ne_zero b₁ hb₁_span'
  obtain ⟨v₂, e₂, hv₂_eq, he₂_lin⟩ :=
    h_s3 (J₂ : Ideal R) γ hγ b₁.traceDual hb₂_span
  have hv₁_b₁ : ∀ i : Fin n, (v₁ i : K) = b₁ i := by
    intro i
    have h1 := hv₁_eq i
    rwa [h_one_K, div_one] at h1
  refine ⟨v₁, v₂, e₁, e₂, ?_, he₂_lin, ?_, ?_⟩
  · intro k
    have h1 := he₁_lin k
    simp only [h_one_K, div_one] at h1
    exact h1
  · intro i j
    rw [hv₁_b₁ i, hv₂_eq j]
    exact h_dual_b₁ i j
  · simp_rw [hv₁_b₁]
    exact hb₁_det

theorem mitsui_infinitePlace_weighted_euclidean_trace_duality {K : Type u} [Field K] [NumberField K]
    (v₁ v₂ : Fin (Module.finrank ℚ K) → K)
    (Δ : ℝ) (hΔ : 0 < Δ)
    (h_dual : ∀ i j : Fin (Module.finrank ℚ K),
      (Algebra.trace ℚ K (v₁ i * v₂ j) : ℝ) = if i = j then 1 else 0)
    (h_det : |(Matrix.of (fun i j : Fin (Module.finrank ℚ K) =>
        (Algebra.trace ℚ K (v₁ i * v₁ j) : ℝ))).det| = Δ ^ 2)
    (c : NumberField.InfinitePlace K → ℝ) (hc : ∀ w : NumberField.InfinitePlace K, 0 < c w) :
    let n : ℕ := Module.finrank ℚ K
    ∃ M : Matrix (Fin n) (Fin n) ℝ,
      M.det ≠ 0 ∧
      |M.det| = Δ * ∏ w : NumberField.InfinitePlace K, (c w) ^ w.mult ∧
      (∀ k : Fin n → ℤ,
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (c w) ^ 2 * (w (∑ i : Fin n, (k i : K) * v₁ i)) ^ 2) =
        ∑ j : Fin n, (M.mulVec (fun i => (k i : ℝ)) j) ^ 2) ∧
      (∀ m : Fin n → ℤ,
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (c w) ^ (-2 : ℤ) * (w (∑ i : Fin n, (m i : K) * v₂ i)) ^ 2) =
        ∑ j : Fin n, (M.transpose⁻¹.mulVec (fun i => (m i : ℝ)) j) ^ 2) :=
by
  classical
  intro n
  have h_s1 : ∀ x y : K,
      (Algebra.trace ℚ K (x * y) : ℝ) =
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) *
            ((w.embedding x).re * (w.embedding y).re -
              (w.embedding x).im * (w.embedding y).im) := by
    intro x y
    set z : K := x * y
    have h1 : (algebraMap ℚ ℂ) (Algebra.trace ℚ K z) = ∑ σ : K →ₐ[ℚ] ℂ, σ z :=
      trace_eq_sum_embeddings ℂ
    have h2 : (Algebra.trace ℚ K z : ℝ) = ∑ σ : K →ₐ[ℚ] ℂ, (σ z).re := by
      have hre := congr_arg Complex.re h1
      simpa [Complex.re_sum] using hre
    have h3 : (∑ σ : K →ₐ[ℚ] ℂ, (σ z).re) = ∑ φ : K →+* ℂ, (φ z).re := by
      rw [← Equiv.sum_comp (RingHom.equivRatAlgHom (R := K) (S := ℂ)) (fun σ : K →ₐ[ℚ] ℂ => (σ z).re)]
      rfl
    have h4 : (∑ φ : K →+* ℂ, (φ z).re) =
        ∑ idx : NumberField.mixedEmbedding.index K, ((NumberField.mixedEmbedding.indexEquiv K idx) z).re := by
      rw [← Equiv.sum_comp (NumberField.mixedEmbedding.indexEquiv K) (fun φ : K →+* ℂ => (φ z).re)]
    have h5 : (∑ idx : NumberField.mixedEmbedding.index K, ((NumberField.mixedEmbedding.indexEquiv K idx) z).re) =
        ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * (w.embedding z).re := by
      dsimp [NumberField.mixedEmbedding.index]
      rw [Fintype.sum_sum_type, Fintype.sum_prod_type]
      have h_real : (∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
          ((NumberField.mixedEmbedding.indexEquiv K (Sum.inl w)) z).re) =
          ∑ w : {w : NumberField.InfinitePlace K // w.IsReal}, (w.1.mult : ℝ) * (w.1.embedding z).re := by
        refine Finset.sum_congr rfl (fun w _ => ?_)
        rw [NumberField.mixedEmbedding.indexEquiv_apply_isReal w, NumberField.InfinitePlace.mult_isReal w]
        ring
      have h_cplx : (∑ w : {w : NumberField.InfinitePlace K // w.IsComplex},
          ∑ p : Fin 2, ((NumberField.mixedEmbedding.indexEquiv K (Sum.inr (w, p))) z).re) =
          ∑ w : {w : NumberField.InfinitePlace K // w.IsComplex}, (w.1.mult : ℝ) * (w.1.embedding z).re := by
        refine Finset.sum_congr rfl (fun w _ => ?_)
        rw [Fin.sum_univ_two,
          NumberField.mixedEmbedding.indexEquiv_apply_isComplex_fst w,
          NumberField.mixedEmbedding.indexEquiv_apply_isComplex_snd w,
          NumberField.ComplexEmbedding.conjugate_coe_eq,
          Complex.conj_re,
          NumberField.InfinitePlace.mult_isComplex w]
        push_cast
        ring
      rw [h_real, h_cplx, ← NumberField.InfinitePlace.sum_eq_sum_add_sum
        (fun w : NumberField.InfinitePlace K => (w.mult : ℝ) * (w.embedding z).re)]
    rw [h2, h3, h4, h5]
    refine Finset.sum_congr rfl (fun w _ => ?_)
    dsimp [z]
    rw [map_mul, Complex.mul_re]
  have h_card : Fintype.card (NumberField.mixedEmbedding.index K) = n := by
    rw [Fintype.card_congr (NumberField.mixedEmbedding.indexEquiv K)]
    exact NumberField.Embeddings.card K ℂ
  let ι_idx : NumberField.mixedEmbedding.index K ≃ Fin n := Fintype.equivFinOfCardEq h_card
  let Ψ₀ : K → NumberField.mixedEmbedding.index K → ℝ := fun x idx =>
    match idx with
    | Sum.inl w => (w.1.embedding x).re
    | Sum.inr (w, p) =>
        if p = 0 then Real.sqrt 2 * (w.1.embedding x).re
        else Real.sqrt 2 * (w.1.embedding x).im
  let d₀ : NumberField.mixedEmbedding.index K → ℝ := fun idx =>
    match idx with
    | Sum.inl w => c w.1
    | Sum.inr (w, _) => c w.1
  let s₀ : NumberField.mixedEmbedding.index K → ℝ := fun idx =>
    match idx with
    | Sum.inl _ => 1
    | Sum.inr (_, p) => if p = 0 then 1 else -1
  let Φ₀ : K → Fin n → ℝ := fun x j => Ψ₀ x (ι_idx.symm j)
  let d : Fin n → ℝ := fun j => d₀ (ι_idx.symm j)
  let s : Fin n → ℝ := fun j => s₀ (ι_idx.symm j)
  have h_im_real : ∀ (w : NumberField.InfinitePlace K) (hw : w.IsReal) (x : K),
      (w.embedding x).im = 0 := by
    intro w hw x
    rw [← NumberField.InfinitePlace.embedding_of_isReal_apply hw x, Complex.ofReal_im]
  have h_normSq : ∀ (w : NumberField.InfinitePlace K) (x : K),
      (w x) ^ 2 = (w.embedding x).re ^ 2 + (w.embedding x).im ^ 2 := by
    intro w x
    have hw_eq : w x = ‖w.embedding x‖ := by
      conv_lhs => rw [← NumberField.InfinitePlace.mk_embedding w]
      exact NumberField.InfinitePlace.apply w.embedding x
    rw [hw_eq, Complex.sq_norm, Complex.normSq_apply]
    ring
  have h_sqrt2_sq : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have h_sqrt2_mul : Real.sqrt 2 * Real.sqrt 2 = 2 := Real.mul_self_sqrt (by norm_num)
  have hd_pos : ∀ j : Fin n, 0 < d j := by
    intro j
    dsimp [d, d₀]
    rcases ι_idx.symm j with w | ⟨w, p⟩
    · exact hc w.1
    · exact hc w.1
  have hs_abs : ∀ j : Fin n, |s j| = 1 := by
    intro j
    dsimp [s, s₀]
    rcases ι_idx.symm j with w | ⟨w, p⟩
    · exact abs_one
    · dsimp
      split_ifs
      · exact abs_one
      · rw [abs_neg, abs_one]
  have hd_prod : (∏ j : Fin n, d j) = ∏ w : NumberField.InfinitePlace K, (c w) ^ w.mult := by
    dsimp [d]
    rw [Equiv.prod_comp ι_idx.symm d₀]
    dsimp [NumberField.mixedEmbedding.index]
    rw [Fintype.prod_sum_type, Fintype.prod_prod_type]
    have h_real : (∏ w : {w : NumberField.InfinitePlace K // w.IsReal}, d₀ (Sum.inl w)) =
        ∏ w : {w : NumberField.InfinitePlace K // w.IsReal}, (c w.1) ^ w.1.mult := by
      refine Finset.prod_congr rfl (fun w _ => ?_)
      rw [NumberField.InfinitePlace.mult_isReal w, pow_one]
    have h_cplx : (∏ w : {w : NumberField.InfinitePlace K // w.IsComplex},
        ∏ p : Fin 2, d₀ (Sum.inr (w, p))) =
        ∏ w : {w : NumberField.InfinitePlace K // w.IsComplex}, (c w.1) ^ w.1.mult := by
      refine Finset.prod_congr rfl (fun w _ => ?_)
      rw [Fin.prod_univ_two, NumberField.InfinitePlace.mult_isComplex w]
      dsimp [d₀]
      ring
    rw [h_real, h_cplx, ← NumberField.InfinitePlace.prod_eq_prod_mul_prod
      (fun w : NumberField.InfinitePlace K => (c w) ^ w.mult)]
  have h_pair : ∀ x y : K,
      (∑ j : Fin n, Φ₀ x j * (s j * Φ₀ y j)) =
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) *
            ((w.embedding x).re * (w.embedding y).re -
              (w.embedding x).im * (w.embedding y).im) := by
    intro x y
    dsimp [Φ₀, s]
    rw [Equiv.sum_comp ι_idx.symm (fun idx => Ψ₀ x idx * (s₀ idx * Ψ₀ y idx))]
    dsimp [NumberField.mixedEmbedding.index]
    rw [Fintype.sum_sum_type, Fintype.sum_prod_type]
    have h_real : (∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
        Ψ₀ x (Sum.inl w) * (s₀ (Sum.inl w) * Ψ₀ y (Sum.inl w))) =
        ∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
          (w.1.mult : ℝ) * ((w.1.embedding x).re * (w.1.embedding y).re -
            (w.1.embedding x).im * (w.1.embedding y).im) := by
      refine Finset.sum_congr rfl (fun w _ => ?_)
      dsimp [Ψ₀, s₀]
      rw [h_im_real w.1 w.2 x, NumberField.InfinitePlace.mult_isReal w]
      ring
    have h_cplx : (∑ w : {w : NumberField.InfinitePlace K // w.IsComplex},
        ∑ p : Fin 2, Ψ₀ x (Sum.inr (w, p)) * (s₀ (Sum.inr (w, p)) * Ψ₀ y (Sum.inr (w, p)))) =
        ∑ w : {w : NumberField.InfinitePlace K // w.IsComplex},
          (w.1.mult : ℝ) * ((w.1.embedding x).re * (w.1.embedding y).re -
            (w.1.embedding x).im * (w.1.embedding y).im) := by
      refine Finset.sum_congr rfl (fun w _ => ?_)
      rw [Fin.sum_univ_two, NumberField.InfinitePlace.mult_isComplex w]
      dsimp [Ψ₀, s₀]
      linear_combination (w.1.embedding x).re * (w.1.embedding y).re * h_sqrt2_mul -
        (w.1.embedding x).im * (w.1.embedding y).im * h_sqrt2_mul
    rw [h_real, h_cplx, ← NumberField.InfinitePlace.sum_eq_sum_add_sum
      (fun w : NumberField.InfinitePlace K =>
        (w.mult : ℝ) * ((w.embedding x).re * (w.embedding y).re -
          (w.embedding x).im * (w.embedding y).im))]
  have h_norm₁ : ∀ x : K,
      (∑ j : Fin n, (d j * Φ₀ x j) ^ 2) =
        ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * (c w) ^ 2 * (w x) ^ 2 := by
    intro x
    dsimp [Φ₀, d]
    rw [Equiv.sum_comp ι_idx.symm (fun idx => (d₀ idx * Ψ₀ x idx) ^ 2)]
    dsimp [NumberField.mixedEmbedding.index]
    rw [Fintype.sum_sum_type, Fintype.sum_prod_type]
    have h_real : (∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
        (d₀ (Sum.inl w) * Ψ₀ x (Sum.inl w)) ^ 2) =
        ∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
          (w.1.mult : ℝ) * (c w.1) ^ 2 * (w.1 x) ^ 2 := by
      refine Finset.sum_congr rfl (fun w _ => ?_)
      dsimp [d₀, Ψ₀]
      rw [h_normSq w.1 x, h_im_real w.1 w.2 x, NumberField.InfinitePlace.mult_isReal w]
      ring
    have h_cplx : (∑ w : {w : NumberField.InfinitePlace K // w.IsComplex},
        ∑ p : Fin 2, (d₀ (Sum.inr (w, p)) * Ψ₀ x (Sum.inr (w, p))) ^ 2) =
        ∑ w : {w : NumberField.InfinitePlace K // w.IsComplex},
          (w.1.mult : ℝ) * (c w.1) ^ 2 * (w.1 x) ^ 2 := by
      refine Finset.sum_congr rfl (fun w _ => ?_)
      rw [Fin.sum_univ_two, h_normSq w.1 x, NumberField.InfinitePlace.mult_isComplex w]
      dsimp [d₀, Ψ₀]
      linear_combination (c w.1) ^ 2 * ((w.1.embedding x).re ^ 2 + (w.1.embedding x).im ^ 2) * h_sqrt2_sq
    rw [h_real, h_cplx, ← NumberField.InfinitePlace.sum_eq_sum_add_sum
      (fun w : NumberField.InfinitePlace K => (w.mult : ℝ) * (c w) ^ 2 * (w x) ^ 2)]
  have h_norm₂ : ∀ y : K,
      (∑ j : Fin n, ((d j)⁻¹ * s j * Φ₀ y j) ^ 2) =
        ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * (c w) ^ (-2 : ℤ) * (w y) ^ 2 := by
    intro y
    dsimp [Φ₀, d, s]
    rw [Equiv.sum_comp ι_idx.symm (fun idx => ((d₀ idx)⁻¹ * s₀ idx * Ψ₀ y idx) ^ 2)]
    dsimp [NumberField.mixedEmbedding.index]
    rw [Fintype.sum_sum_type, Fintype.sum_prod_type]
    have h_zpow : ∀ w : NumberField.InfinitePlace K, ((c w)⁻¹) ^ 2 = (c w) ^ (-2 : ℤ) := by
      intro w
      rw [inv_pow, zpow_neg, zpow_two, sq]
    have h_real : (∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
        ((d₀ (Sum.inl w))⁻¹ * s₀ (Sum.inl w) * Ψ₀ y (Sum.inl w)) ^ 2) =
        ∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
          (w.1.mult : ℝ) * (c w.1) ^ (-2 : ℤ) * (w.1 y) ^ 2 := by
      refine Finset.sum_congr rfl (fun w _ => ?_)
      dsimp [d₀, s₀, Ψ₀]
      rw [← h_zpow w.1, h_normSq w.1 y, h_im_real w.1 w.2 y, NumberField.InfinitePlace.mult_isReal w]
      ring
    have h_cplx : (∑ w : {w : NumberField.InfinitePlace K // w.IsComplex},
        ∑ p : Fin 2, ((d₀ (Sum.inr (w, p)))⁻¹ * s₀ (Sum.inr (w, p)) * Ψ₀ y (Sum.inr (w, p))) ^ 2) =
        ∑ w : {w : NumberField.InfinitePlace K // w.IsComplex},
          (w.1.mult : ℝ) * (c w.1) ^ (-2 : ℤ) * (w.1 y) ^ 2 := by
      refine Finset.sum_congr rfl (fun w _ => ?_)
      rw [Fin.sum_univ_two, ← h_zpow w.1, h_normSq w.1 y, NumberField.InfinitePlace.mult_isComplex w]
      dsimp [d₀, s₀, Ψ₀]
      linear_combination ((c w.1)⁻¹) ^ 2 * ((w.1.embedding y).re ^ 2 + (w.1.embedding y).im ^ 2) * h_sqrt2_sq
    rw [h_real, h_cplx, ← NumberField.InfinitePlace.sum_eq_sum_add_sum
      (fun w : NumberField.InfinitePlace K => (w.mult : ℝ) * (c w) ^ (-2 : ℤ) * (w y) ^ 2)]
  have h_lin : ∀ (v : Fin n → K) (k : Fin n → ℤ) (j : Fin n),
      Φ₀ (∑ i : Fin n, (k i : K) * v i) j = ∑ i : Fin n, Φ₀ (v i) j * (k i : ℝ) := by
    intro v k j
    dsimp [Φ₀]
    have h_re_lin : ∀ w : NumberField.InfinitePlace K,
        (w.embedding (∑ i : Fin n, (k i : K) * v i)).re =
        ∑ i : Fin n, (w.embedding (v i)).re * (k i : ℝ) := by
      intro w
      rw [map_sum, Complex.re_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, map_intCast, Complex.mul_re, Complex.intCast_re, Complex.intCast_im]
      ring
    have h_im_lin : ∀ w : NumberField.InfinitePlace K,
        (w.embedding (∑ i : Fin n, (k i : K) * v i)).im =
        ∑ i : Fin n, (w.embedding (v i)).im * (k i : ℝ) := by
      intro w
      rw [map_sum, Complex.im_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, map_intCast, Complex.mul_im, Complex.intCast_re, Complex.intCast_im]
      ring
    rcases ι_idx.symm j with w | ⟨w, p⟩
    · dsimp [Ψ₀]
      exact h_re_lin w.1
    · dsimp [Ψ₀]
      split_ifs with hp
      · rw [h_re_lin w.1, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => by ring)
      · rw [h_im_lin w.1, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => by ring)
  let M₀ : Matrix (Fin n) (Fin n) ℝ := Matrix.of (fun j i => Φ₀ (v₁ i) j)
  let B₀ : Matrix (Fin n) (Fin n) ℝ := Matrix.of (fun j i => Φ₀ (v₂ i) j)
  have h_tr : ∀ x y : K,
      (∑ j : Fin n, Φ₀ x j * (s j * Φ₀ y j)) = (Algebra.trace ℚ K (x * y) : ℝ) := by
    intro x y
    exact (h_pair x y).trans (h_s1 x y).symm
  have h_dual' : ∀ i l : Fin n,
      (∑ j : Fin n, M₀ j i * (s j * B₀ j l)) = if i = l then 1 else 0 := by
    intro i l
    dsimp [M₀, B₀]
    rw [h_tr (v₁ i) (v₂ l)]
    exact h_dual i l
  have h_det' : |(Matrix.of (fun i l : Fin n =>
      ∑ j : Fin n, M₀ j i * (s j * M₀ j l))).det| = Δ ^ 2 := by
    have h_mat_eq : Matrix.of (fun i l : Fin n => ∑ j : Fin n, M₀ j i * (s j * M₀ j l)) =
        Matrix.of (fun i l : Fin n => (Algebra.trace ℚ K (v₁ i * v₁ l) : ℝ)) := by
      ext i l
      dsimp [M₀]
      exact h_tr (v₁ i) (v₁ l)
    rw [h_mat_eq]
    exact h_det
  let M : Matrix (Fin n) (Fin n) ℝ := Matrix.of (fun j i => d j * M₀ j i)
  let N : Matrix (Fin n) (Fin n) ℝ := Matrix.of (fun j i => (d j)⁻¹ * s j * B₀ j i)
  have hMN : M.transpose * N = 1 := by
    ext i l
    rw [Matrix.mul_apply, Matrix.one_apply, ← h_dual' i l]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    dsimp [M, N]
    have hdj : d j ≠ 0 := ne_of_gt (hd_pos j)
    calc (d j * M₀ j i) * ((d j)⁻¹ * s j * B₀ j l)
      _ = (d j * (d j)⁻¹) * (M₀ j i * (s j * B₀ j l)) := by ring
      _ = 1 * (M₀ j i * (s j * B₀ j l)) := by rw [mul_inv_cancel₀ hdj]
      _ = M₀ j i * (s j * B₀ j l) := one_mul _
  have hMinvT : M.transpose⁻¹ = N := Matrix.inv_eq_right_inv hMN
  have hM_det_ne : M.det ≠ 0 := by
    have hdet : M.det * N.det = 1 := by
      have h1 := congr_arg Matrix.det hMN
      rwa [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one] at h1
    exact left_ne_zero_of_mul_eq_one hdet
  have h_T_eq : Matrix.of (fun i l : Fin n => ∑ j : Fin n, M₀ j i * (s j * M₀ j l)) =
      M₀.transpose * (Matrix.diagonal s * M₀) := by
    ext i l
    rw [Matrix.of_apply, Matrix.mul_apply]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Matrix.transpose_apply, Matrix.diagonal_mul]
  have hs_prod : (∏ j : Fin n, |s j|) = 1 := by
    simp [hs_abs]
  have hM0_sq : |M₀.det| ^ 2 = Δ ^ 2 := by
    rw [← h_det', h_T_eq, Matrix.det_mul, Matrix.det_transpose, Matrix.det_mul,
      Matrix.det_diagonal, abs_mul, abs_mul, Finset.abs_prod, hs_prod]
    ring
  have hM0_abs : |M₀.det| = Δ :=
    (sq_eq_sq₀ (abs_nonneg _) (le_of_lt hΔ)).mp hM0_sq
  have hM_eq_diag : M = Matrix.diagonal d * M₀ := by
    ext j i
    dsimp [M]
    rw [Matrix.diagonal_mul]
  have hd_prod_pos : 0 < ∏ j : Fin n, d j :=
    Finset.prod_pos (fun j _ => hd_pos j)
  have hM_det_abs : |M.det| = Δ * ∏ w : NumberField.InfinitePlace K, (c w) ^ w.mult := by
    rw [hM_eq_diag, Matrix.det_mul, Matrix.det_diagonal, abs_mul,
      abs_of_pos hd_prod_pos, hM0_abs, mul_comm, hd_prod]
  refine ⟨M, hM_det_ne, hM_det_abs, ?_, ?_⟩
  · intro k
    have h_vec : ∀ j : Fin n,
        M.mulVec (fun i => (k i : ℝ)) j = d j * Φ₀ (∑ i : Fin n, (k i : K) * v₁ i) j := by
      intro j
      dsimp [M, M₀, Matrix.mulVec, dotProduct]
      rw [h_lin v₁ k j, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => by ring)
    simp_rw [h_vec]
    exact (h_norm₁ (∑ i : Fin n, (k i : K) * v₁ i)).symm
  · intro m
    rw [hMinvT]
    have h_vec : ∀ j : Fin n,
        N.mulVec (fun i => (m i : ℝ)) j = (d j)⁻¹ * s j * Φ₀ (∑ i : Fin n, (m i : K) * v₂ i) j := by
      intro j
      dsimp [N, B₀, Matrix.mulVec, dotProduct]
      rw [h_lin v₂ m j, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => by ring)
    simp_rw [h_vec]
    exact (h_norm₂ (∑ i : Fin n, (m i : K) * v₂ i)).symm

theorem mitsui_matrix_lattice_shifted_gaussian_summable (n : ℕ)
    (M : Matrix (Fin n) (Fin n) ℝ) (hM : M.det ≠ 0)
    (y : Fin n → ℝ) :
    Summable (fun k : Fin n → ℤ =>
      Real.exp (-Real.pi *
        ∑ j : Fin n, (M.mulVec (fun i => (k i : ℝ) + y i) j) ^ 2)) :=
by
  set F : ℝ := ∑ i : Fin n, ∑ j : Fin n, (M⁻¹ i j) ^ 2
  set C : ℝ := 1 + F
  set a₀ : ℝ := C⁻¹
  have hF_nonneg : 0 ≤ F :=
    Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun j _ => sq_nonneg (M⁻¹ i j)))
  have hC_pos : 0 < C := by dsimp [C]; linarith
  have hC_ne : C ≠ 0 := ne_of_gt hC_pos
  have ha₀_pos : 0 < a₀ := inv_pos.mpr hC_pos
  have h_unit : IsUnit M.det := isUnit_iff_ne_zero.mpr hM
  have h_inv_mul : M⁻¹ * M = 1 := Matrix.nonsing_inv_mul M h_unit
  have h_coercive : ∀ v : Fin n → ℝ, a₀ * ∑ i : Fin n, (v i) ^ 2 ≤ ∑ j : Fin n, (M.mulVec v j) ^ 2 := by
    intro v
    have hv_vec : M⁻¹.mulVec (M.mulVec v) = v := by
      rw [Matrix.mulVec_mulVec, h_inv_mul, Matrix.one_mulVec]
    have hv_coord : ∀ i : Fin n,
        (v i) ^ 2 ≤ (∑ j : Fin n, (M⁻¹ i j) ^ 2) * (∑ j : Fin n, (M.mulVec v j) ^ 2) := by
      intro i
      have hv_i : v i = ∑ j : Fin n, M⁻¹ i j * M.mulVec v j := by
        have h1 := (congr_fun hv_vec i).symm
        exact h1
      rw [hv_i]
      exact Finset.sum_mul_sq_le_sq_mul_sq Finset.univ
        (fun j : Fin n => M⁻¹ i j) (fun j : Fin n => M.mulVec v j)
    have h_sum_i : ∑ i : Fin n, (v i) ^ 2 ≤ F * (∑ j : Fin n, (M.mulVec v j) ^ 2) := by
      calc ∑ i : Fin n, (v i) ^ 2
        _ ≤ ∑ i : Fin n, (∑ j : Fin n, (M⁻¹ i j) ^ 2) * (∑ j : Fin n, (M.mulVec v j) ^ 2) :=
          Finset.sum_le_sum (fun i _ => hv_coord i)
        _ = F * (∑ j : Fin n, (M.mulVec v j) ^ 2) := by
          dsimp [F]
          rw [← Finset.sum_mul]
    have h_mv_nonneg : 0 ≤ ∑ j : Fin n, (M.mulVec v j) ^ 2 :=
      Finset.sum_nonneg (fun j _ => sq_nonneg _)
    have h_sum_C : ∑ i : Fin n, (v i) ^ 2 ≤ C * (∑ j : Fin n, (M.mulVec v j) ^ 2) := by
      have hFC : F ≤ C := by dsimp [C]; linarith
      exact le_trans h_sum_i (mul_le_mul_of_nonneg_right hFC h_mv_nonneg)
    calc a₀ * ∑ i : Fin n, (v i) ^ 2
      _ ≤ a₀ * (C * (∑ j : Fin n, (M.mulVec v j) ^ 2)) :=
        mul_le_mul_of_nonneg_left h_sum_C (le_of_lt ha₀_pos)
      _ = (a₀ * C) * (∑ j : Fin n, (M.mulVec v j) ^ 2) := by ring
      _ = 1 * (∑ j : Fin n, (M.mulVec v j) ^ 2) := by
        dsimp [a₀]
        rw [inv_mul_cancel₀ hC_ne]
      _ = ∑ j : Fin n, (M.mulVec v j) ^ 2 := one_mul _
  set g : ℝ → ℤ → ℝ := fun t z => Real.exp (-Real.pi * a₀ * ((z : ℝ) + t) ^ 2)
  have hg_nn : ∀ t z, 0 ≤ g t z := fun t z => Real.exp_nonneg _
  have hg : ∀ t : ℝ, Summable (g t) := by
    intro t
    have h_jacobi := summable_pow_mul_jacobiTheta₂_term_bound (a₀ * |t|) ha₀_pos 0
    have h_maj := h_jacobi.mul_left (Real.exp (-Real.pi * a₀ * t ^ 2))
    refine Summable.of_nonneg_of_le (fun z => Real.exp_nonneg _) (fun z => ?_) h_maj
    dsimp [g]
    rw [pow_zero, one_mul, ← Real.exp_add, Int.cast_abs, Real.exp_le_exp]
    have h_abs : -(|t| * |(z : ℝ)|) ≤ t * (z : ℝ) := by
      rw [← abs_mul]
      exact neg_abs_le (t * (z : ℝ))
    have h_quad : (z : ℝ) ^ 2 - 2 * |t| * |(z : ℝ)| + t ^ 2 ≤ ((z : ℝ) + t) ^ 2 := by
      calc (z : ℝ) ^ 2 - 2 * |t| * |(z : ℝ)| + t ^ 2
        _ ≤ (z : ℝ) ^ 2 + 2 * (t * (z : ℝ)) + t ^ 2 := by linarith
        _ = ((z : ℝ) + t) ^ 2 := by ring
    have h_pi_a0_nonneg : 0 ≤ Real.pi * a₀ := by
      have := Real.pi_pos
      positivity
    have h_mul := mul_le_mul_of_nonneg_left h_quad h_pi_a0_nonneg
    linarith
  have h_prod : ∀ (m : ℕ) (y' : Fin m → ℝ),
      Summable (fun k : Fin m → ℤ => ∏ i : Fin m, g (y' i) (k i)) := by
    intro m
    induction' m with m ih
    · intro y'
      exact (hasSum_fintype (fun k : Fin 0 → ℤ => ∏ i : Fin 0, g (y' i) (k i))).summable
    · intro y'
      let f : ℤ → ℝ := g (y' 0)
      let f' : (Fin m → ℤ) → ℝ := fun k' => ∏ i : Fin m, g (y' i.succ) (k' i)
      have hf : Summable f := hg (y' 0)
      have hf' : Summable f' := ih (fun i : Fin m => y' i.succ)
      have hf_nn : ∀ z, 0 ≤ f z := fun z => hg_nn (y' 0) z
      have hf'_nn : ∀ k', 0 ≤ f' k' :=
        fun k' => Finset.prod_nonneg (fun i _ => hg_nn (y' i.succ) (k' i))
      have h_pair : Summable (fun p : ℤ × (Fin m → ℤ) => f p.1 * f' p.2) :=
        @Summable.mul_of_nonneg ℤ (Fin m → ℤ) f f' hf hf' hf_nn hf'_nn
      let e : ℤ × (Fin m → ℤ) ≃ (Fin (m + 1) → ℤ) :=
        Fin.consEquiv (fun _ : Fin (m + 1) => ℤ)
      have h_comp : Summable (fun p : ℤ × (Fin m → ℤ) =>
          ∏ i : Fin (m + 1), g (y' i) (e p i)) := by
        refine h_pair.congr (fun p => ?_)
        rw [Fin.prod_univ_succ]
        rfl
      exact (Equiv.summable_iff e).mp h_comp
  refine Summable.of_nonneg_of_le (fun k => Real.exp_nonneg _) (fun k => ?_) (h_prod n y)
  set v : Fin n → ℝ := fun i => (k i : ℝ) + y i
  have h_prod_eq : (∏ i : Fin n, g (y i) (k i)) =
      Real.exp (-Real.pi * (a₀ * ∑ i : Fin n, (v i) ^ 2)) := by
    dsimp [g, v]
    rw [← Real.exp_sum]
    congr 1
    calc ∑ i : Fin n, -Real.pi * a₀ * ((k i : ℝ) + y i) ^ 2
      _ = ∑ i : Fin n, (-Real.pi * a₀) * ((k i : ℝ) + y i) ^ 2 := by rfl
      _ = (-Real.pi * a₀) * ∑ i : Fin n, ((k i : ℝ) + y i) ^ 2 := by rw [← Finset.mul_sum]
      _ = -Real.pi * (a₀ * ∑ i : Fin n, ((k i : ℝ) + y i) ^ 2) := by ring
  rw [h_prod_eq, Real.exp_le_exp]
  have h_c := h_coercive v
  have h_pi_nonneg : 0 ≤ Real.pi := le_of_lt Real.pi_pos
  have h_mul := mul_le_mul_of_nonneg_left h_c h_pi_nonneg
  dsimp [v] at h_mul ⊢
  linarith

theorem mitsui_matrix_succ_orthogonal_column_split (n : ℕ)
    (M : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ) (hM : M.det ≠ 0) :
    ∃ (d : ℝ) (c : Fin n → ℝ) (M' : Matrix (Fin n) (Fin n) ℝ),
      d ≠ 0 ∧
      M'.det ≠ 0 ∧
      |M.det| = |d| * |M'.det| ∧
      (∀ v : Fin (n + 1) → ℝ,
        (∑ j : Fin (n + 1), (M.mulVec v j) ^ 2) =
          d ^ 2 * (v 0 + ∑ i : Fin n, c i * v i.succ) ^ 2 +
            ∑ i : Fin n, (M'.mulVec (fun l => v l.succ) i) ^ 2) ∧
      (∀ w : Fin (n + 1) → ℝ,
        (∑ j : Fin (n + 1), (M.transpose⁻¹.mulVec w j) ^ 2) =
          (d⁻¹) ^ 2 * (w 0) ^ 2 +
            ∑ i : Fin n, (M'.transpose⁻¹.mulVec (fun l => w l.succ - w 0 * c l) i) ^ 2) :=
by
  let u₀ : Fin (n + 1) → ℝ := fun j => M j 0
  have hu₀ : ∃ j : Fin (n + 1), u₀ j ≠ 0 := by
    by_contra h_all
    push_neg at h_all
    exact hM (Matrix.det_eq_zero_of_column_eq_zero 0 h_all)
  obtain ⟨j₀, hj₀⟩ := hu₀
  let S : ℝ := ∑ j : Fin (n + 1), (u₀ j) ^ 2
  have hS_pos : 0 < S := by
    have hj₀_pos : 0 < (u₀ j₀) ^ 2 := sq_pos_of_ne_zero hj₀
    have hj₀_le : (u₀ j₀) ^ 2 ≤ S :=
      Finset.single_le_sum (fun j _ => sq_nonneg (u₀ j)) (Finset.mem_univ j₀)
    linarith
  let r : ℝ := Real.sqrt S
  have hr_pos : 0 < r := Real.sqrt_pos.mpr hS_pos
  have hr_sq : r ^ 2 = S := Real.sq_sqrt (le_of_lt hS_pos)
  let d : ℝ := if 0 ≤ u₀ 0 then -r else r
  have hd_ne : d ≠ 0 := by
    dsimp [d]
    split_ifs <;> linarith
  have hd_sq : d ^ 2 = S := by
    dsimp [d]
    split_ifs <;> nlinarith [hr_sq]
  have h_du0 : d * u₀ 0 ≤ 0 := by
    dsimp [d]
    split_ifs with h_sign
    · exact mul_nonpos_of_nonpos_of_nonneg (by linarith) h_sign
    · push_neg at h_sign
      exact mul_nonpos_of_nonneg_of_nonpos (le_of_lt hr_pos) (le_of_lt h_sign)
  let w_H : Fin (n + 1) → ℝ := fun j => u₀ j - if j = 0 then d else 0
  let W : ℝ := ∑ j : Fin (n + 1), (w_H j) ^ 2
  have hw_H_zero : w_H 0 = u₀ 0 - d := by dsimp [w_H]
  have hw_H_succ : ∀ i : Fin n, w_H i.succ = u₀ i.succ := by
    intro i
    dsimp [w_H]
    exact sub_zero (u₀ i.succ)
  have hS_expand : S = (u₀ 0) ^ 2 + ∑ i : Fin n, (u₀ i.succ) ^ 2 := by
    dsimp [S]
    exact Fin.sum_univ_succ (fun j => (u₀ j) ^ 2)
  have hW_expand : W = (u₀ 0 - d) ^ 2 + ∑ i : Fin n, (u₀ i.succ) ^ 2 := by
    dsimp [W]
    rw [Fin.sum_univ_succ, hw_H_zero]
    congr 1
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hw_H_succ i]
  have hW_eq : W = 2 * (S - d * u₀ 0) := by
    linarith [hS_expand, hW_expand, hd_sq]
  have hW_pos : 0 < W := by linarith
  have hW_ne : W ≠ 0 := ne_of_gt hW_pos
  have h_wH_u0 : (∑ j : Fin (n + 1), w_H j * u₀ j) = S - d * u₀ 0 := by
    rw [Fin.sum_univ_succ, hw_H_zero]
    have h_tail : (∑ i : Fin n, w_H i.succ * u₀ i.succ) = ∑ i : Fin n, (u₀ i.succ) ^ 2 := by
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hw_H_succ i, sq]
    rw [h_tail]
    linarith [hS_expand]
  let H : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ :=
    Matrix.of (fun j l => (if j = l then (1 : ℝ) else 0) - 2 * W⁻¹ * w_H j * w_H l)
  have hH_symm : H.transpose = H := by
    ext j l
    dsimp [H, Matrix.transpose_apply]
    by_cases hjl : j = l
    · subst hjl; ring
    · have hlj : l ≠ j := Ne.symm hjl
      rw [if_neg hjl, if_neg hlj]
      ring
  have hH_mulVec : ∀ (x : Fin (n + 1) → ℝ) (j : Fin (n + 1)),
      H.mulVec x j = x j - 2 * W⁻¹ * (∑ l : Fin (n + 1), w_H l * x l) * w_H j := by
    intro x j
    dsimp [H, Matrix.mulVec, dotProduct]
    have h_term : ∀ l : Fin (n + 1),
        ((if j = l then (1 : ℝ) else 0) - 2 * W⁻¹ * w_H j * w_H l) * x l =
          (if l = j then x l else 0) - (2 * W⁻¹ * w_H j) * (w_H l * x l) := by
      intro l
      by_cases hlj : l = j
      · subst hlj; simp; ring
      · have hjl : j ≠ l := Ne.symm hlj
        rw [if_neg hjl, if_neg hlj]
        ring
    simp_rw [h_term]
    rw [Finset.sum_sub_distrib, Finset.sum_ite_eq' Finset.univ j x, if_pos (Finset.mem_univ j),
      ← Finset.mul_sum]
    ring
  have hH_dot : ∀ x : Fin (n + 1) → ℝ,
      (∑ j : Fin (n + 1), w_H j * H.mulVec x j) = - (∑ j : Fin (n + 1), w_H j * x j) := by
    intro x
    set t : ℝ := ∑ l : Fin (n + 1), w_H l * x l
    have h_term : ∀ j : Fin (n + 1),
        w_H j * H.mulVec x j = w_H j * x j - (2 * W⁻¹ * t) * (w_H j) ^ 2 := by
      intro j
      rw [hH_mulVec x j]
      ring
    simp_rw [h_term]
    rw [Finset.sum_sub_distrib, ← Finset.mul_sum]
    change t - (2 * W⁻¹ * t) * W = -t
    have hWW : W⁻¹ * W = 1 := inv_mul_cancel₀ hW_ne
    calc t - (2 * W⁻¹ * t) * W = t - 2 * t * (W⁻¹ * W) := by ring
      _ = t - 2 * t * 1 := by rw [hWW]
      _ = -t := by ring
  have hH_inv : ∀ (x : Fin (n + 1) → ℝ) (j : Fin (n + 1)),
      H.mulVec (H.mulVec x) j = x j := by
    intro x j
    rw [hH_mulVec (H.mulVec x) j, hH_dot x, hH_mulVec x j]
    ring
  have hH_sq : H * H = 1 := by
    ext j k
    let e_k : Fin (n + 1) → ℝ := fun l => if l = k then 1 else 0
    have h_mulVec_ek : ∀ (B : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ) (i : Fin (n + 1)),
        B.mulVec e_k i = B i k := by
      intro B i
      dsimp [Matrix.mulVec, dotProduct, e_k]
      simp [mul_ite, Finset.sum_ite_eq']
    rw [← h_mulVec_ek (H * H) j, ← Matrix.mulVec_mulVec, hH_inv e_k j]
    dsimp [e_k, Matrix.one_apply]
  have hH_det : |H.det| = 1 := by
    have h_det_sq : H.det * H.det = 1 := by
      rw [← Matrix.det_mul, hH_sq, Matrix.det_one]
    have h_abs_sq : |H.det| * |H.det| = 1 := by
      rw [← abs_mul, h_det_sq, abs_one]
    nlinarith [abs_nonneg H.det]
  have hH_norm : ∀ x : Fin (n + 1) → ℝ,
      (∑ j : Fin (n + 1), (H.mulVec x j) ^ 2) = ∑ j : Fin (n + 1), (x j) ^ 2 := by
    intro x
    set t : ℝ := ∑ l : Fin (n + 1), w_H l * x l
    have h_term : ∀ j : Fin (n + 1),
        (H.mulVec x j) ^ 2 =
          (x j) ^ 2 - (4 * W⁻¹ * t) * (w_H j * x j) + (4 * (W⁻¹) ^ 2 * t ^ 2) * (w_H j) ^ 2 := by
      intro j
      rw [hH_mulVec x j]
      ring
    simp_rw [h_term]
    rw [Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    change (∑ j : Fin (n + 1), (x j) ^ 2) - (4 * W⁻¹ * t) * t + (4 * (W⁻¹) ^ 2 * t ^ 2) * W =
      ∑ j : Fin (n + 1), (x j) ^ 2
    have hWW : W⁻¹ * W = 1 := inv_mul_cancel₀ hW_ne
    calc (∑ j : Fin (n + 1), (x j) ^ 2) - (4 * W⁻¹ * t) * t + (4 * (W⁻¹) ^ 2 * t ^ 2) * W
      _ = (∑ j : Fin (n + 1), (x j) ^ 2) - 4 * W⁻¹ * t ^ 2 + 4 * W⁻¹ * t ^ 2 * (W⁻¹ * W) := by ring
      _ = (∑ j : Fin (n + 1), (x j) ^ 2) - 4 * W⁻¹ * t ^ 2 + 4 * W⁻¹ * t ^ 2 * 1 := by rw [hWW]
      _ = ∑ j : Fin (n + 1), (x j) ^ 2 := by ring
  have hH_u0 : ∀ j : Fin (n + 1), H.mulVec u₀ j = if j = 0 then d else 0 := by
    intro j
    rw [hH_mulVec u₀ j, h_wH_u0]
    have h2 : 2 * W⁻¹ * (S - d * u₀ 0) = 1 := by
      have : 2 * (S - d * u₀ 0) = W := hW_eq.symm
      calc 2 * W⁻¹ * (S - d * u₀ 0) = W⁻¹ * (2 * (S - d * u₀ 0)) := by ring
        _ = W⁻¹ * W := by rw [this]
        _ = 1 := inv_mul_cancel₀ hW_ne
    rw [h2, one_mul]
    dsimp [w_H]
    ring
  let A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ := H * M
  let c : Fin n → ℝ := fun i => d⁻¹ * A 0 i.succ
  let M' : Matrix (Fin n) (Fin n) ℝ := A.submatrix Fin.succ Fin.succ
  have hA_col0 : ∀ j : Fin (n + 1), A j 0 = H.mulVec u₀ j := by
    intro j
    dsimp [A, u₀, Matrix.mul_apply, Matrix.mulVec, dotProduct]
  have hA0 : A 0 0 = d := by
    rw [hA_col0 0, hH_u0 0, if_pos rfl]
  have hA_sub : ∀ i : Fin n, A i.succ 0 = 0 := by
    intro i
    rw [hA_col0 i.succ, hH_u0 i.succ, if_neg (Fin.succ_ne_zero i)]
  have hHA : H * A = M := by
    dsimp [A]
    rw [← Matrix.mul_assoc, hH_sq, Matrix.one_mul]
  have hA_det : A.det = d * M'.det := by
    rw [Matrix.det_succ_column_zero A, Fin.sum_univ_succ]
    have h_tail : (∑ i : Fin n, (-1 : ℝ) ^ (i.succ : ℕ) * A i.succ 0 *
        (A.submatrix i.succ.succAbove Fin.succ).det) = 0 := by
      refine Finset.sum_eq_zero (fun i _ => ?_)
      rw [hA_sub i, mul_zero, zero_mul]
    rw [h_tail, add_zero, Fin.val_zero, pow_zero, one_mul, hA0, Fin.succAbove_zero]
  have hM_det_abs : |M.det| = |d| * |M'.det| := by
    calc |M.det| = |(H * A).det| := by rw [hHA]
      _ = |H.det * A.det| := by rw [Matrix.det_mul]
      _ = |H.det| * |A.det| := abs_mul H.det A.det
      _ = 1 * |d * M'.det| := by rw [hH_det, hA_det]
      _ = |d| * |M'.det| := by rw [one_mul, abs_mul]
  have hM'_det : M'.det ≠ 0 := by
    intro h_zero
    have hM_abs_ne : |M.det| ≠ 0 := abs_ne_zero.mpr hM
    rw [hM_det_abs, h_zero, abs_zero, mul_zero] at hM_abs_ne
    exact hM_abs_ne rfl
  have h_primal : ∀ v : Fin (n + 1) → ℝ,
      (∑ j : Fin (n + 1), (M.mulVec v j) ^ 2) =
        d ^ 2 * (v 0 + ∑ i : Fin n, c i * v i.succ) ^ 2 +
          ∑ i : Fin n, (M'.mulVec (fun l => v l.succ) i) ^ 2 := by
    intro v
    have hMA_v : M.mulVec v = H.mulVec (A.mulVec v) := by
      rw [Matrix.mulVec_mulVec, hHA]
    rw [hMA_v, hH_norm (A.mulVec v), Fin.sum_univ_succ]
    have hA_v0 : A.mulVec v 0 = d * (v 0 + ∑ i : Fin n, c i * v i.succ) := by
      dsimp [Matrix.mulVec, dotProduct]
      rw [Fin.sum_univ_succ, hA0, mul_add, Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl (fun i _ => ?_)
      dsimp [c]
      rw [← mul_assoc, ← mul_assoc, mul_inv_cancel₀ hd_ne, one_mul]
    have hA_vsucc : ∀ i : Fin n, A.mulVec v i.succ = M'.mulVec (fun l => v l.succ) i := by
      intro i
      dsimp [M', Matrix.mulVec, dotProduct]
      rw [Fin.sum_univ_succ, hA_sub i, zero_mul, zero_add]
    rw [hA_v0, mul_pow]
    congr 1
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hA_vsucc i]
  have h_dual : ∀ w : Fin (n + 1) → ℝ,
      (∑ j : Fin (n + 1), (M.transpose⁻¹.mulVec w j) ^ 2) =
        (d⁻¹) ^ 2 * (w 0) ^ 2 +
          ∑ i : Fin n, (M'.transpose⁻¹.mulVec (fun l => w l.succ - w 0 * c l) i) ^ 2 := by
    intro w
    let w' : Fin n → ℝ := fun l => w l.succ - w 0 * c l
    let z' : Fin n → ℝ := M'.transpose⁻¹.mulVec w'
    let u : Fin (n + 1) → ℝ := Fin.cons (d⁻¹ * w 0) z'
    have hu0 : u 0 = d⁻¹ * w 0 := rfl
    have hu_succ : ∀ i : Fin n, u i.succ = z' i := fun _ => rfl
    have hM'T_unit : IsUnit M'.transpose.det := by
      rw [Matrix.det_transpose]
      exact isUnit_iff_ne_zero.mpr hM'_det
    have hM'T_z' : M'.transpose.mulVec z' = w' := by
      dsimp [z']
      rw [Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv M'.transpose hM'T_unit, Matrix.one_mulVec]
    have hAT_u : A.transpose.mulVec u = w := by
      ext k
      refine Fin.cases ?_ ?_ k
      · dsimp [Matrix.mulVec, dotProduct]
        rw [Fin.sum_univ_succ, hA0, hu0]
        have h_tail : (∑ i : Fin n, A i.succ 0 * u i.succ) = 0 := by
          refine Finset.sum_eq_zero (fun i _ => ?_)
          rw [hA_sub i, zero_mul]
        rw [h_tail, add_zero, ← mul_assoc, mul_inv_cancel₀ hd_ne, one_mul]
      · intro l
        dsimp [Matrix.mulVec, dotProduct]
        rw [Fin.sum_univ_succ, hu0]
        have h_tail : (∑ i : Fin n, A i.succ l.succ * u i.succ) =
            M'.transpose.mulVec z' l := by
          dsimp [M', Matrix.mulVec, dotProduct]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [hu_succ i]
        rw [h_tail, hM'T_z']
        dsimp [w', c]
        ring
    have hMT_Hu : M.transpose.mulVec (H.mulVec u) = w := by
      have hAT_eq : A.transpose = M.transpose * H := by
        dsimp [A]
        rw [Matrix.transpose_mul, hH_symm]
      rw [Matrix.mulVec_mulVec, ← hAT_eq, hAT_u]
    have hMT_unit : IsUnit M.transpose.det := by
      rw [Matrix.det_transpose]
      exact isUnit_iff_ne_zero.mpr hM
    have hMT_inv_w : M.transpose⁻¹.mulVec w = H.mulVec u := by
      rw [← hMT_Hu, Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul M.transpose hMT_unit, Matrix.one_mulVec]
    rw [hMT_inv_w, hH_norm u, Fin.sum_univ_succ, hu0, mul_pow]
    congr 1
  exact ⟨d, c, M', hd_ne, hM'_det, hM_det_abs, h_primal, h_dual⟩

theorem mitsui_block_quadratic_phased_gaussian_poisson_step (n : ℕ)
    (d : ℝ) (hd : d ≠ 0) (c : Fin n → ℝ)
    (M' : Matrix (Fin n) (Fin n) ℝ) (hM' : M'.det ≠ 0)
    (h_sum : Summable (fun k : Fin (n + 1) → ℤ =>
      Real.exp (-Real.pi *
        (d ^ 2 * ((k 0 : ℝ) + ∑ i : Fin n, c i * (k i.succ : ℝ)) ^ 2 +
          ∑ i : Fin n, (M'.mulVec (fun l => (k l.succ : ℝ)) i) ^ 2))))
    (h_sum' : Summable (fun k' : Fin n → ℤ =>
      Real.exp (-Real.pi * ∑ i : Fin n, (M'.mulVec (fun l => (k' l : ℝ)) i) ^ 2)))
    (h_dual' : ∀ w' : Fin n → ℝ,
      Summable (fun m' : Fin n → ℤ =>
        Real.exp (-Real.pi * ∑ i : Fin n,
          (M'.transpose⁻¹.mulVec (fun l => (m' l : ℝ) - w' l) i) ^ 2)))
    (h_IH : ∀ y' : Fin n → ℝ,
      (∑' k' : Fin n → ℤ,
        Complex.exp ((-Real.pi * ∑ i : Fin n, (M'.mulVec (fun l => (k' l : ℝ)) i) ^ 2 : ℝ) +
          2 * Real.pi * Complex.I * ∑ l : Fin n, (y' l * (k' l : ℝ) : ℂ))) =
      ((|M'.det|⁻¹ : ℝ) : ℂ) *
        ∑' m' : Fin n → ℤ,
          (Real.exp (-Real.pi * ∑ i : Fin n,
            (M'.transpose⁻¹.mulVec (fun l => (m' l : ℝ) - y' l) i) ^ 2) : ℂ))
    (y : Fin (n + 1) → ℝ) :
    (∑' k : Fin (n + 1) → ℤ,
      Complex.exp
        ((-Real.pi *
            (d ^ 2 * ((k 0 : ℝ) + ∑ i : Fin n, c i * (k i.succ : ℝ)) ^ 2 +
              ∑ i : Fin n, (M'.mulVec (fun l => (k l.succ : ℝ)) i) ^ 2) : ℝ) +
          2 * Real.pi * Complex.I * ∑ j : Fin (n + 1), (y j * (k j : ℝ) : ℂ))) =
    (((|d| * |M'.det|)⁻¹ : ℝ) : ℂ) *
      ∑' m : Fin (n + 1) → ℤ,
        (Real.exp
          (-Real.pi *
            ((d⁻¹) ^ 2 * ((m 0 : ℝ) - y 0) ^ 2 +
              ∑ i : Fin n,
                (M'.transpose⁻¹.mulVec
                  (fun l => ((m l.succ : ℝ) - y l.succ) - ((m 0 : ℝ) - y 0) * c l) i) ^ 2)) : ℂ) :=
by
  have h_s1 :
      Summable (fun m₀ : ℤ =>
        Real.exp (-Real.pi * (d⁻¹) ^ 2 * ((m₀ : ℝ) - y 0) ^ 2)) ∧
      ∀ x₀ : ℝ,
        (∑' k₀ : ℤ,
          Complex.exp
            ((-Real.pi * (d ^ 2 * ((k₀ : ℝ) + x₀) ^ 2) : ℝ) +
              2 * Real.pi * Complex.I * (y 0 * (k₀ : ℝ) : ℂ))) =
        ((|d|⁻¹ : ℝ) : ℂ) *
          ∑' m₀ : ℤ,
            Complex.exp
              ((-Real.pi * ((d⁻¹) ^ 2 * ((m₀ : ℝ) - y 0) ^ 2) : ℝ) +
                2 * Real.pi * Complex.I * (((m₀ : ℝ) - y 0) * x₀ : ℂ)) := by
    refine ⟨?_, ?_⟩
    · set T : ℝ := (d⁻¹) ^ 2
      set S : ℝ := T * |y 0|
      have hT : 0 < T := sq_pos_of_ne_zero (inv_ne_zero hd)
      have h_jac := (summable_pow_mul_jacobiTheta₂_term_bound S hT 0).mul_left
        (Real.exp (-Real.pi * T * (y 0) ^ 2))
      refine Summable.of_nonneg_of_le (fun m₀ => le_of_lt (Real.exp_pos _)) (fun m₀ => ?_) h_jac
      dsimp only
      rw [pow_zero, one_mul, ← Real.exp_add, Int.cast_abs]
      rw [Real.exp_le_exp]
      have h_le_abs : y 0 * (m₀ : ℝ) ≤ |y 0| * |(m₀ : ℝ)| := by
        rw [← abs_mul]
        exact le_abs_self (y 0 * (m₀ : ℝ))
      have h_mul : 2 * Real.pi * T * (y 0 * (m₀ : ℝ)) ≤ 2 * Real.pi * T * (|y 0| * |(m₀ : ℝ)|) :=
        mul_le_mul_of_nonneg_left h_le_abs (by positivity)
      have h_ring1 : -Real.pi * T * ((m₀ : ℝ) - y 0) ^ 2 =
          -Real.pi * T * (y 0) ^ 2 - Real.pi * T * (m₀ : ℝ) ^ 2 + 2 * Real.pi * T * (y 0 * (m₀ : ℝ)) := by
        ring
      have h_ring2 : -Real.pi * T * (y 0) ^ 2 + -Real.pi * (T * (m₀ : ℝ) ^ 2 - 2 * S * |(m₀ : ℝ)|) =
          -Real.pi * T * (y 0) ^ 2 - Real.pi * T * (m₀ : ℝ) ^ 2 + 2 * Real.pi * T * (|y 0| * |(m₀ : ℝ)|) := by
        dsimp [S]
        ring
      linarith
    · intro x₀
      let a : ℂ := ((d ^ 2 : ℝ) : ℂ)
      let b : ℂ := -((d ^ 2 * x₀ : ℝ) : ℂ) + Complex.I * (y 0 : ℂ)
      have ha : 0 < a.re := by
        dsimp [a]
        exact sq_pos_of_ne_zero hd
      have h_quad := Complex.tsum_exp_neg_quadratic ha b
      have h_half : (1 / 2 : ℂ) = ((1 / 2 : ℝ) : ℂ) := by push_cast; ring
      have h_cpow : a ^ (1 / 2 : ℂ) = ((|d| : ℝ) : ℂ) := by
        dsimp [a]
        rw [h_half, ← Complex.ofReal_cpow (sq_nonneg d), ← Real.sqrt_eq_rpow, Real.sqrt_sq_eq_abs]
      have h_pref : 1 / a ^ (1 / 2 : ℂ) = ((|d|⁻¹ : ℝ) : ℂ) := by
        rw [h_cpow]
        push_cast
        ring
      let C₀ : ℂ := Complex.exp ((-Real.pi * d ^ 2 * x₀ ^ 2 : ℝ) : ℂ)
      have h_lhs_term : ∀ k₀ : ℤ,
          C₀ * Complex.exp (-Real.pi * a * (k₀ : ℂ) ^ 2 + 2 * Real.pi * b * (k₀ : ℂ)) =
            Complex.exp
              ((-Real.pi * (d ^ 2 * ((k₀ : ℝ) + x₀) ^ 2) : ℝ) +
                2 * Real.pi * Complex.I * (y 0 * (k₀ : ℝ) : ℂ)) := by
        intro k₀
        dsimp [C₀, a, b]
        rw [← Complex.exp_add]
        congr 1
        push_cast
        ring
      have hd_c : (d : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hd
      have h_rhs_term : ∀ m₀ : ℤ,
          C₀ * Complex.exp (-Real.pi / a * ((m₀ : ℂ) + Complex.I * b) ^ 2) =
            Complex.exp
              ((-Real.pi * ((d⁻¹) ^ 2 * ((m₀ : ℝ) - y 0) ^ 2) : ℝ) +
                2 * Real.pi * Complex.I * (((m₀ : ℝ) - y 0) * x₀ : ℂ)) := by
        intro m₀
        dsimp [C₀, a, b]
        rw [← Complex.exp_add]
        congr 1
        push_cast
        have h_ib : (m₀ : ℂ) + Complex.I * (-((d : ℂ) ^ 2 * (x₀ : ℂ)) + Complex.I * (y 0 : ℂ)) =
            ((m₀ : ℂ) - (y 0 : ℂ)) - Complex.I * (d : ℂ) ^ 2 * (x₀ : ℂ) := by
          calc (m₀ : ℂ) + Complex.I * (-((d : ℂ) ^ 2 * (x₀ : ℂ)) + Complex.I * (y 0 : ℂ))
            _ = (m₀ : ℂ) - Complex.I * (d : ℂ) ^ 2 * (x₀ : ℂ) + Complex.I ^ 2 * (y 0 : ℂ) := by ring
            _ = ((m₀ : ℂ) - (y 0 : ℂ)) - Complex.I * (d : ℂ) ^ 2 * (x₀ : ℂ) := by
              rw [Complex.I_sq]; ring
        rw [h_ib]
        have h_sq : (((m₀ : ℂ) - (y 0 : ℂ)) - Complex.I * (d : ℂ) ^ 2 * (x₀ : ℂ)) ^ 2 =
