    rw [← hxy_mk, ← hψ_span_F (x * y) (mul_ne_zero hx hy), hF_mul x y hx hy]
  have hψ_unit : ∀ a : R ⧸ f, (IsUnit a → ‖ψ_f a‖ = 1) ∧ (¬ IsUnit a → ψ_f a = 0) := by
    intro a
    have h_iff : IsUnit a ↔ (P (lift_nz a) (hlift_ne a) : Ideal R) ⊔ f = ⊤ := by
      conv_lhs => rw [← hlift_mk a]
      exact h_unit_iff_sup (lift_nz a)
    constructor
    · intro ha
      exact (hF_norm_supp (lift_nz a) (hlift_ne a)).1 (h_iff.mp ha)
    · intro ha
      exact (hF_norm_supp (lift_nz a) (hlift_ne a)).2 (fun h_top => ha (h_iff.mpr h_top))
  have hψ_prim : ∀ f' : Ideal R, f ≤ f' → f' ≠ f →
      ∃ x : R, IsUnit (Ideal.Quotient.mk f x) ∧ x - 1 ∈ f' ∧ ψ_f (Ideal.Quotient.mk f x) ≠ 1 := by
    intro f' hf_le hf'_ne
    obtain ⟨x, hx_ne, hx_cop, hx_sub, hx_ne_ang⟩ := hχ₀_prim_eff f' hf_le hf'_ne
    refine ⟨x, (h_unit_iff_sup x).mpr hx_cop, hx_sub, ?_⟩
    intro hψ_eq_one
    apply hx_ne_ang
    have h1 := hψ_span x hx_ne
    rw [hψ_eq_one, one_mul] at h1
