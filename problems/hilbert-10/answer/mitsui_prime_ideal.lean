theorem mitsui_mellin_Ioi_zero_eq_Ioo_add_Ioi_of_theta_inversion (R_K : ℝ) (Ψ : ℝ → ℝ)
    (hΨ_nn : ∀ u ∈ Set.Ioi (1 : ℝ), 0 ≤ Ψ u)
    (hΨ_int : ∀ σ : ℝ, MeasureTheory.IntegrableOn (fun u : ℝ => u ^ σ * Ψ u) (Set.Ioi (1 : ℝ)) MeasureTheory.volume)
    (hΨ_inv : ∀ u ∈ Set.Ioi (1 : ℝ),
      u ^ (-3 : ℝ) * Ψ u⁻¹ = Ψ u + R_K * (u ^ (-1 : ℝ) - u ^ (-2 : ℝ)))
    (s : ℂ) (hs : 1 < s.re) :
    (∫ u in Set.Ioi (0 : ℝ), (u : ℂ) ^ s * (Ψ u : ℂ)) =
      (∫ u in Set.Ioo (0 : ℝ) 1, (u : ℂ) ^ s * (Ψ u : ℂ)) +
        (∫ u in Set.Ioi (1 : ℝ), (u : ℂ) ^ s * (Ψ u : ℂ)) :=
by
  set g : ℝ → ℂ := fun u => (u : ℂ) ^ s * (Ψ u : ℂ)
  have hΨ_meas : MeasureTheory.AEStronglyMeasurable (fun u : ℝ => (Ψ u : ℂ))
      (MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))) := by
    have h0 := (hΨ_int 0).aestronglyMeasurable
    have h0' : MeasureTheory.AEStronglyMeasurable Ψ (MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))) := by
      refine h0.congr ?_
      filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioi] with u _
      simp
    exact Complex.continuous_ofReal.comp_aestronglyMeasurable h0'
  have h_int_cpow : ∀ z : ℂ, MeasureTheory.IntegrableOn
      (fun u : ℝ => (u : ℂ) ^ z * (Ψ u : ℂ)) (Set.Ioi (1 : ℝ)) MeasureTheory.volume := by
    intro z
    have h_cont : ContinuousOn (fun u : ℝ => (u : ℂ) ^ z) (Set.Ioi (1 : ℝ)) := by
      refine ContinuousOn.cpow_const Complex.continuous_ofReal.continuousOn ?_
      intro u hu
      exact Or.inl (by simpa using lt_trans zero_lt_one hu)
    have h_meas : MeasureTheory.AEStronglyMeasurable (fun u : ℝ => (u : ℂ) ^ z * (Ψ u : ℂ))
        (MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))) :=
      (h_cont.aestronglyMeasurable measurableSet_Ioi).mul hΨ_meas
    refine (hΨ_int z.re).mono' h_meas ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioi] with u hu
    have hu_pos : 0 < u := lt_trans zero_lt_one hu
    rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos hu_pos, Complex.norm_of_nonneg (hΨ_nn u hu)]
  have h_int_Ioi : MeasureTheory.IntegrableOn g (Set.Ioi (1 : ℝ)) MeasureTheory.volume :=
    h_int_cpow s
  have h_int_1s : MeasureTheory.IntegrableOn
      (fun u : ℝ => (u : ℂ) ^ (1 - s) * (Ψ u : ℂ)) (Set.Ioi (1 : ℝ)) MeasureTheory.volume :=
    h_int_cpow (1 - s)
  have h_re_neg_s : (-s).re < -1 := by simp; linarith
  have h_re_neg_1s : (-1 - s).re < -1 := by simp; linarith
  have h_int_p1 : MeasureTheory.IntegrableOn (fun u : ℝ => (u : ℂ) ^ (-s)) (Set.Ioi (1 : ℝ)) MeasureTheory.volume :=
    integrableOn_Ioi_cpow_of_lt h_re_neg_s zero_lt_one
  have h_int_p2 : MeasureTheory.IntegrableOn (fun u : ℝ => (u : ℂ) ^ (-1 - s)) (Set.Ioi (1 : ℝ)) MeasureTheory.volume :=
    integrableOn_Ioi_cpow_of_lt h_re_neg_1s zero_lt_one
  have h_int_rhs : MeasureTheory.IntegrableOn
      (fun u : ℝ => (u : ℂ) ^ (1 - s) * (Ψ u : ℂ) +
        (R_K : ℂ) * ((u : ℂ) ^ (-s) - (u : ℂ) ^ (-1 - s)))
      (Set.Ioi (1 : ℝ)) MeasureTheory.volume :=
    h_int_1s.add ((h_int_p1.sub h_int_p2).const_mul (R_K : ℂ))
  have h_img : (fun u : ℝ => u⁻¹) '' Set.Ioi (1 : ℝ) = Set.Ioo (0 : ℝ) 1 := by
    rw [Set.image_inv_eq_inv, Set.inv_Ioi₀ zero_lt_one, inv_one]
  have h_deriv : ∀ u ∈ Set.Ioi (1 : ℝ),
      HasDerivWithinAt (fun x : ℝ => x⁻¹) (-(u ^ 2)⁻¹) (Set.Ioi (1 : ℝ)) u := by
    intro u hu
    have hu_pos : 0 < u := lt_trans zero_lt_one hu
    exact (hasDerivAt_inv (ne_of_gt hu_pos)).hasDerivWithinAt
  have h_int_Ioo : MeasureTheory.IntegrableOn g (Set.Ioo (0 : ℝ) 1) MeasureTheory.volume := by
    rw [← h_img, MeasureTheory.integrableOn_image_iff_integrableOn_abs_deriv_smul
      measurableSet_Ioi h_deriv inv_injective.injOn]
    refine h_int_rhs.congr_fun (fun u hu => ?_) measurableSet_Ioi
    symm
    dsimp [g]
    have hu_pos : 0 < u := lt_trans zero_lt_one hu
    have hu_nn : 0 ≤ u := le_of_lt hu_pos
    have hu_c_ne : (u : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hu_pos)
    have h_abs : |-(u ^ 2)⁻¹| = u ^ (1 : ℝ) * u ^ (-3 : ℝ) := by
      rw [abs_neg, abs_of_pos (inv_pos.mpr (sq_pos_of_pos hu_pos))]
      rw [← Real.rpow_add hu_pos]
      have h13 : (1 : ℝ) + (-3 : ℝ) = -2 := by norm_num
      rw [h13]
      have h2 : (-2 : ℝ) = ((-2 : ℤ) : ℝ) := by norm_num
      rw [h2, Real.rpow_intCast, zpow_neg, zpow_two, sq]
    rw [h_abs]
    have h_inv_cpow : ((u⁻¹ : ℝ) : ℂ) ^ s = (u : ℂ) ^ (-s) := by
      rw [Complex.ofReal_inv, Complex.inv_cpow _ s, ← Complex.cpow_neg]
      rw [Complex.arg_ofReal_of_nonneg hu_nn]
      exact Real.pi_ne_zero.symm
    rw [h_inv_cpow]
    have h_rearrange : (((u ^ (1 : ℝ) * u ^ (-3 : ℝ) : ℝ) : ℂ) * ((u : ℂ) ^ (-s) * (Ψ u⁻¹ : ℂ))) =
        ((u : ℂ) ^ (-s) * ((u ^ (1 : ℝ) : ℝ) : ℂ)) * (((u ^ (-3 : ℝ) * Ψ u⁻¹ : ℝ) : ℂ)) := by
      push_cast
      ring
    rw [h_rearrange, hΨ_inv u hu]
    have h_u1 : ((u ^ (1 : ℝ) : ℝ) : ℂ) = (u : ℂ) ^ (1 : ℂ) := by
      rw [Complex.ofReal_cpow hu_nn]; simp
    have h_um1 : ((u ^ (-1 : ℝ) : ℝ) : ℂ) = (u : ℂ) ^ (-1 : ℂ) := by
      rw [Complex.ofReal_cpow hu_nn]; push_cast; rfl
    have h_um2 : ((u ^ (-2 : ℝ) : ℝ) : ℂ) = (u : ℂ) ^ (-2 : ℂ) := by
      rw [Complex.ofReal_cpow hu_nn]; push_cast; rfl
    have h_cast_rhs : ((Ψ u + R_K * (u ^ (-1 : ℝ) - u ^ (-2 : ℝ)) : ℝ) : ℂ) =
        (Ψ u : ℂ) + (R_K : ℂ) * ((u : ℂ) ^ (-1 : ℂ) - (u : ℂ) ^ (-2 : ℂ)) := by
      push_cast
      rw [h_um1, h_um2]
    rw [h_u1, h_cast_rhs]
    have h_exp1 : (u : ℂ) ^ (-s) * (u : ℂ) ^ (1 : ℂ) = (u : ℂ) ^ (1 - s) := by
      rw [← Complex.cpow_add _ _ hu_c_ne]
      congr 1; ring
    rw [h_exp1]
    have h_exp2 : (u : ℂ) ^ (1 - s) * (u : ℂ) ^ (-1 : ℂ) = (u : ℂ) ^ (-s) := by
      rw [← Complex.cpow_add _ _ hu_c_ne]
      congr 1; ring
    have h_exp3 : (u : ℂ) ^ (1 - s) * (u : ℂ) ^ (-2 : ℂ) = (u : ℂ) ^ (-1 - s) := by
      rw [← Complex.cpow_add _ _ hu_c_ne]
      congr 1; ring
    calc (u : ℂ) ^ (1 - s) * ((Ψ u : ℂ) + (R_K : ℂ) * ((u : ℂ) ^ (-1 : ℂ) - (u : ℂ) ^ (-2 : ℂ)))
        = (u : ℂ) ^ (1 - s) * (Ψ u : ℂ) +
            (R_K : ℂ) * ((u : ℂ) ^ (1 - s) * (u : ℂ) ^ (-1 : ℂ) - (u : ℂ) ^ (1 - s) * (u : ℂ) ^ (-2 : ℂ)) := by ring
      _ = (u : ℂ) ^ (1 - s) * (Ψ u : ℂ) + (R_K : ℂ) * ((u : ℂ) ^ (-s) - (u : ℂ) ^ (-1 - s)) := by
          rw [h_exp2, h_exp3]
  have h_int_Ioc : MeasureTheory.IntegrableOn g (Set.Ioc (0 : ℝ) 1) MeasureTheory.volume :=
    (MeasureTheory.integrableOn_congr_set_ae MeasureTheory.Ioo_ae_eq_Ioc).mp h_int_Ioo
  have h_union : Set.Ioc (0 : ℝ) 1 ∪ Set.Ioi (1 : ℝ) = Set.Ioi (0 : ℝ) :=
    Set.Ioc_union_Ioi_eq_Ioi zero_le_one
  rw [← h_union, MeasureTheory.setIntegral_union Set.Ioc_disjoint_Ioi_same measurableSet_Ioi h_int_Ioc h_int_Ioi]
  rw [MeasureTheory.setIntegral_congr_set MeasureTheory.Ioo_ae_eq_Ioc]

theorem mitsui_dedekindZeta_unfolded_mellin_and_theta_inversion {K : Type u} [Field K] [NumberField K] :
    ∃ Ψ_K : ℝ → ℝ,
      (∀ u ∈ Set.Ioi (1 : ℝ), 0 ≤ Ψ_K u) ∧
      (∀ σ : ℝ, MeasureTheory.IntegrableOn (fun u : ℝ => u ^ σ * Ψ_K u) (Set.Ioi (1 : ℝ)) MeasureTheory.volume) ∧
      (∀ u ∈ Set.Ioi (1 : ℝ),
        u ^ (-3 : ℝ) * Ψ_K u⁻¹ =
          Ψ_K u +
            ((2 : ℝ) ^ (NumberField.InfinitePlace.nrRealPlaces K + NumberField.InfinitePlace.nrComplexPlaces K) *
              NumberField.Units.regulator K *
              (NumberField.classNumber K : ℝ) /
