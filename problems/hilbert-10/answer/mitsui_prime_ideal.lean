        Subtype.ext hN_mul
      have hM₂N_eq : M₂ * N = ⟨Ideal.span ({e} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr he_ne)⟩ :=
        Subtype.ext hM₂N_mul
