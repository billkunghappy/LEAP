        · rw [if_pos h_nonneg, norm_star, NumberField.InfinitePlace.norm_embedding_eq]
        · rw [if_neg h_nonneg, NumberField.InfinitePlace.norm_embedding_eq]
      let κ_a : ℂ := (-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
        ∏ w : NumberField.InfinitePlace K,
          (w.embedding (γ_C C : K) / (w (γ_C C : K) : ℂ)) ^ (l_eff w)
      have h_step_poiss : ∀ a : R ⧸ f,
          (∑' m : M_C, E_primal a m) =
          (κ_a * ((u * N_f ^ (-1 / 2 : ℝ) : ℝ) : ℂ)) *
            ∑' x_star : J_σC,
              (ψ_f a *
                Complex.exp (2 * Real.pi * Complex.I *
                  (Algebra.trace ℚ K ((α_C C a : K) * (x_star.1 : K) / (γ_C C : K)) : ℂ))) *
                P_dual x_star := by
        intro a
        dsimp only [E_primal]
        rw [tsum_mul_left, (h_poiss a).2.2, h_pref_eq]
        dsimp only [κ_a, P_dual]
        rw [← mul_assoc (ψ_f a), mul_comm (ψ_f a), mul_assoc (κ_a * ((u * N_f ^ (-1 / 2 : ℝ) : ℝ) : ℂ)),
