        have h2m_real : (2 : ℝ) ^ m ≤ (N : ℝ) := by exact_mod_cast (le_trans h2m_le_km h_pow)
        have h_log_2m : Real.log ((2 : ℝ) ^ m) ≤ Real.log (N : ℝ) :=
