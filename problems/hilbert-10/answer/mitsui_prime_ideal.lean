            mul_div_mul_right (star (w.embedding z)) (w z : ℂ) hemb_ne
    have h_primal : ((w.embedding z / (w z : ℂ)) ^ (l_eff w)) * ((w z : ℂ) ^ (a_place w)) =
        (Φ_emb w z) ^ (a_place w) := by
