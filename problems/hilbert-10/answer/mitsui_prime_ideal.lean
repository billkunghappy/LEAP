    have h_card_erase : (Finset.univ.erase w₀).card = r := by
      rw [Finset.card_erase_of_mem (Finset.mem_univ w₀), Finset.card_univ]
      rfl
    have h_delta_pow : δ ^ r = ∏ _w ∈ Finset.univ.erase w₀, δ := by
      rw [Finset.prod_const, h_card_erase]
    have h_erase_prod :
        δ ^ r * (∏ w ∈ Finset.univ.erase w₀, ∑ j : Fin m, f_place w j) =
        ∏ w ∈ Finset.univ.erase w₀, ∑ j : Fin m, h_step w * g_exp w j := by
      rw [h_delta_pow, ← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun w hw => ?_)
