      rw [← tsum_mul_left, ← tsum_mul_left]
    rw [h_congr]
    exact (MeasureTheory.integral_tsum_of_summable_integral_norm hF_int h_summable_int_norm).symm
  rw [h_int_tsum]
  have h_tsum_eq : (∑' m : ℕ, ∫ u in Set.Ioi (0 : ℝ), F m u) =
      κ * (∑' m : ℕ, c_m m) * Γ_s := by
    have h1 : (fun m : ℕ => ∫ u in Set.Ioi (0 : ℝ), F m u) = fun m : ℕ => κ * (c_m m * Γ_s) := by
      ext m
      rw [hF_integral m, mul_assoc]
    rw [h1, tsum_mul_left, tsum_mul_right, mul_assoc]
  rw [h_tsum_eq]
  change κ * Γ_s * LSeries a_ψ s = κ * (∑' m : ℕ, c_m m) * Γ_s
  dsimp [LSeries, c_m]
  ring

theorem mitsui_narrow_ray_char_heckeL_entire_functional_le_and_exp_bound {K : Type u} [Field K] [NumberField K]
    (b : Ideal (NumberField.RingOfIntegers K)) (hb : b ≠ 0)
    (ψ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hψ_narrow : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ b →
      (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (x : K)).re) →
      ψ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1)
    (hψ_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ b = ⊤ → ‖ψ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ b = ⊤) → ψ I = 0))
    (hψ_nonprin : ∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ b = ⊤ ∧ ψ I₀ ≠ 1) :
    ∃ (B : ℝ) (χ_dual : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ) (g_ψ : ℂ → ℂ),
      0 < B ∧
      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ_dual I‖ ≤ 1) ∧
      Differentiable ℂ g_ψ ∧
      (∀ s : ℂ, 1 < s.re →
        g_ψ s = LSeries (fun n =>
          ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
            ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s) ∧
      (∀ s : ℂ, s.re = -1 / 2 →
        ‖(((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ (s / 2) *
            (Complex.Gammaℝ s) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
            (Complex.Gammaℂ s) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) * g_ψ s‖ ≤
          (Ideal.absNorm b : ℝ) ^ (Module.finrank ℚ K + 1) *
            ‖(((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ ((1 - s) / 2) *
                (Complex.Gammaℝ (1 - s)) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
                (Complex.Gammaℂ (1 - s)) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) *
              LSeries (fun n =>
                ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
                  χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) (1 - s)‖) ∧
      (∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 →
        ‖g_ψ s‖ ≤ Real.exp (B * (4 + |s.im|))) :=
by
  obtain ⟨q₀, q₁, ψ₀, χ_dual, M_ψ, ω_ψ, N_f, Φ₁, Φ₂, W_ψ, Ψ_ψ, C, c, α,
    hq_sum, hNf_pos, hC, hc, hα, hω_norm, hψ₀_norm, hχ_dual_norm,
    hM_diff, hM_bound, hΦ₁_cont, hΦ₂_cont,
    hΨ_meas, hΨ_nn, hΦ_le, hΨ_bound,
    h_inv, hW_meas, hW_nn, hW_mellin,
    hΦ₁_unfold, hΦ₂_unfold, h_euler_LSeries⟩ :=
    mitsui_narrow_ray_char_theta_kernels_inversion_and_unfolding b hb ψ hψ_narrow hψ_norm_supp hψ_nonprin
  set D : ℝ := |(NumberField.discr K : ℝ)|
  set r₁ : ℕ := NumberField.InfinitePlace.nrRealPlaces K
  set r₂ : ℕ := NumberField.InfinitePlace.nrComplexPlaces K
  have hD_ge_one : (1 : ℝ) ≤ D := by
    dsimp [D]
    exact_mod_cast Int.one_le_abs (NumberField.discr_ne_zero K)
  have hD_pos : 0 < D := lt_of_lt_of_le zero_lt_one hD_ge_one
  obtain ⟨G_inv, hG_inv_diff, hG_inv_rhp, hG_inv_neg_half, hG_inv_high⟩ :=
    mitsui_narrow_archimedean_gamma_inv_and_strip_bounds D q₀ q₁ r₂ hD_ge_one
  have hΨ_int : ∀ σ : ℝ, MeasureTheory.IntegrableOn (fun u : ℝ => u ^ σ * Ψ_ψ u) (Set.Ioi (1 : ℝ)) MeasureTheory.volume :=
    fun σ => mitsui_theta_kernel_moments_integrable_of_exp_bound Ψ_ψ C c α hC hc hα hΨ_meas hΨ_nn hΨ_bound σ
  obtain ⟨hJ_diff, hJ_bound⟩ :=
    mitsui_hecke_char_theta_integral_differentiable_and_strip_norm_le
      Φ₁ Φ₂ Ψ_ψ hΦ₁_cont hΦ₂_cont hΨ_nn hΦ_le hΨ_int
  let J_ψ : ℂ → ℂ := fun s =>
    ∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s * Φ₁ u + (u : ℂ) ^ (1 - s) * Φ₂ u)
  let g_ψ : ℂ → ℂ := fun s => G_inv s * (M_ψ s * J_ψ s)
  have hg_diff : Differentiable ℂ g_ψ := hG_inv_diff.mul (hM_diff.mul hJ_diff)
  set I₀ : ℝ := 2 * ∫ u in Set.Ioi (1 : ℝ), u ^ (2 : ℝ) * Ψ_ψ u
  have h_int_nn : 0 ≤ ∫ u in Set.Ioi (1 : ℝ), u ^ (2 : ℝ) * Ψ_ψ u := by
    apply MeasureTheory.setIntegral_nonneg measurableSet_Ioi
    intro u hu
    have hu_nn : 0 ≤ u := by linarith [Set.mem_Ioi.mp hu]
    exact mul_nonneg (Real.rpow_nonneg hu_nn 2) (hΨ_nn u hu)
  have hI₀_nn : 0 ≤ I₀ := by dsimp [I₀]; positivity
  let C₀ : ℝ := (Ideal.absNorm b : ℝ) ^ 2 * I₀ + 1
  have hC₀_pos : 0 < C₀ := by dsimp [C₀]; positivity
  let C₁ : ℝ := D ^ (1 / 4 : ℝ) * C₀
  have hC₁_pos : 0 < C₁ := by dsimp [C₁]; positivity
  let B₁ : ℝ := 8 * ((q₀ : ℝ) + (q₁ : ℝ) + (r₂ : ℝ))
  have hB₁_nonneg : 0 ≤ B₁ := by dsimp [B₁]; positivity
  have h_high : ∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 → 1 ≤ |s.im| →
      ‖g_ψ s‖ ≤ C₁ * (4 + |s.im|) * Real.exp (B₁ * (4 + |s.im|)) := by
    intro s hs1 hs2 hs_im
    set L : ℝ := 4 + |s.im|
    have h4_ge_one : 1 ≤ L := by dsimp [L]; linarith [abs_nonneg s.im]
    have hG_s : ‖G_inv s‖ ≤ D ^ (1 / 4 : ℝ) * Real.exp (B₁ * L) := hG_inv_high s hs1 hs2 hs_im
    have hMJ_s : ‖M_ψ s * J_ψ s‖ ≤ C₀ := by
      rw [norm_mul]
      have h1 : ‖M_ψ s‖ * ‖J_ψ s‖ ≤ (Ideal.absNorm b : ℝ) ^ 2 * I₀ :=
        mul_le_mul (hM_bound s hs1 hs2) (hJ_bound s hs1 hs2) (norm_nonneg _) (by positivity)
      dsimp [C₀]; linarith
    calc ‖g_ψ s‖
        = ‖G_inv s‖ * ‖M_ψ s * J_ψ s‖ := norm_mul _ _
      _ ≤ (D ^ (1 / 4 : ℝ) * Real.exp (B₁ * L)) * C₀ :=
          mul_le_mul hG_s hMJ_s (norm_nonneg _) (by positivity)
