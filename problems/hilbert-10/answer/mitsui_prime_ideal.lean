    let L : NumberField.InfinitePlace K → (Fin r → ℝ) → ℝ := fun w y =>
      ∑ i : Fin r, y i * ((w.mult : ℝ) * Real.log (w ((ε i : R) : K)))
    have hQ_nn : ∀ y : Fin r → ℝ, 0 ≤ Q_K y := by
      intro y
      refine Finset.sum_nonneg (fun w _ => ?_)
      exact mul_nonneg (Nat.cast_nonneg _)
        (Finset.prod_nonneg (fun i _ => Real.rpow_nonneg (le_of_lt (hw_ε_pos w i)) _))
    have hL_le : ∀ (w : NumberField.InfinitePlace K) (y : Fin r → ℝ),
