            have h_sum_split :
                (∑ j : Fin r,
                  (y j : ℂ) * (2 * (Real.pi : ℂ) * ((θ₀ j : ℂ) - (m_freq j : ℂ)))) =
                2 * (Real.pi : ℂ) * (∑ j : Fin r, (θ₀ j : ℂ) * (y j : ℂ)) -
