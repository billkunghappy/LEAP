        rw [map_zpow, hψ_fund j, ← Complex.exp_int_mul]
        congr 1
        push_cast
        ring
      rw [hprod, ← Complex.exp_sum]
      congr 1
      push_cast
      rw [Finset.sum_mul]
    have hW_sum : (∑ j : Fin r, W₀ (u : NumberField.RingOfIntegers K) j * α w j) =
        ∑ j : Fin r, (d j : ℝ) * α w j := by
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [hW₀_u j]
    change ψ_w u * Complex.exp (((- ∑ j : Fin r, W₀ (u : NumberField.RingOfIntegers K) j * α w j) : ℝ) * Complex.I) = _
    rw [hu_ψ, hW_sum, mul_assoc, ← Complex.exp_add]
    have h_cancel : (((∑ j : Fin r, (d j : ℝ) * α w j) : ℝ) : ℂ) * Complex.I +
