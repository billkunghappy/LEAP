      Real.log (w₀ (x : K) / w₀ (x : K)) ∈
        Set.Ioc (Real.log X * ((((k w₀ : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
          (Real.log X * ((((k w₀ : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))) := by
    intro x hx
    have hx_coe : (x : K) ≠ 0 := by exact_mod_cast hx
    have hw₀_ne : w₀ (x : K) ≠ 0 := ne_of_gt (w₀.pos_iff.mpr hx_coe)
    rw [div_self hw₀_ne, Real.log_one, Set.mem_Ioc]
    have hkw₀ : ((k w₀ : ℕ) : ℝ) + 1 = (m : ℝ) := by exact_mod_cast hk₀
    have hlogX_pos : 0 < Real.log X := Real.log_pos hX
    have hm_pos : (0 : ℝ) < (m : ℝ) := Nat.cast_pos.mpr hm
    have h_sub1 : ((k w₀ : ℕ) : ℝ) - (m : ℝ) = -1 := by linarith
    have h_sub0 : ((k w₀ : ℕ) : ℝ) + 1 - (m : ℝ) = 0 := by linarith
    rw [h_sub1, h_sub0, zero_div, mul_zero]
    refine ⟨?_, le_refl 0⟩
    have h_eq : Real.log X * (-1 / (m : ℝ)) = -(Real.log X / (m : ℝ)) := by ring
    rw [h_eq, neg_lt_zero]
    exact div_pos hlogX_pos hm_pos
  let U_map : NumberField.Units.torsion K × (Fin (NumberField.Units.rank K) → ℤ) →
      (NumberField.RingOfIntegers K)ˣ :=
    fun ζe => (ζe.1 : (NumberField.RingOfIntegers K)ˣ) *
      ∏ j : Fin (NumberField.Units.rank K), (NumberField.Units.fundSystem K j) ^ (ζe.2 j)
  have h_s2 : ∀ (w : NumberField.InfinitePlace K)
      (ζe : NumberField.Units.torsion K × (Fin (NumberField.Units.rank K) → ℤ)),
      Real.log (w (((U_map ζe : NumberField.RingOfIntegers K) * g : NumberField.RingOfIntegers K) : K) /
          w₀ (((U_map ζe : NumberField.RingOfIntegers K) * g : NumberField.RingOfIntegers K) : K)) =
        Real.log (w (g : K) / w₀ (g : K)) +
