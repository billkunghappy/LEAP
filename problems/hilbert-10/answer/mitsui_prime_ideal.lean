theorem mitsui_riesz_primePower_unitLogCoord_fract_le_of_trigPoly_approx {K : Type u} [Field K] [NumberField K]
    (θ₀ : Fin (NumberField.Units.rank K) → ℝ)
    (Φ_W : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →
      Fin (NumberField.Units.rank K) → ℝ)
    (Y : ℝ) (hY : 0 < Y)
    (χ' : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
