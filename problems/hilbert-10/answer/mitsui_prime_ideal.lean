    obtain ⟨B, χ_dual, g_ψ, hB_pos, hχ_dual_norm, hg_diff, hg_eq, hg_feq_le, hg_exp⟩ :=
      mitsui_narrow_ray_char_heckeL_entire_functional_le_and_exp_bound b hb ψ hψ_narrow hψ_norm_supp hψ_nonprin
    set N_b : ℝ := (Ideal.absNorm b : ℝ)
    have hb_norm_ne_zero : Ideal.absNorm b ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hb
    have hNb_ge_one : 1 ≤ N_b := by
      dsimp [N_b]
