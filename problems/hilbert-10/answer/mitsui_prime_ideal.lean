    Y ^ (1 - B / Real.log (4 + |t|)) * (Real.log (4 + |t|) / (1 / 4 + t ^ 2))
  set E_horiz : ℝ → ℝ := fun T =>
    ‖∫ x in (1 - B / Real.log (4 + |T|))..2,
