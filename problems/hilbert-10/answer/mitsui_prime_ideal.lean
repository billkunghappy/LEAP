    dsimp [D]
    exact_mod_cast Int.one_le_abs (NumberField.discr_ne_zero K)
  have hD_pos : 0 < D := lt_of_lt_of_le zero_lt_one hD_ge_one
  refine ⟨C₀, hC₀_pos, ?_⟩
  intro q hq w₀ a₀ ha₀_lt θ₀ hθ₀_bdd j₀ hθ₀_j₀_pos m_freq l_ang h_tors M hM hm_M hl_M χ_gr hχ_norm_supp hχ_prin
  obtain ⟨B₀, χ_dual, g_χ, hB₀_pos, hχ_dual_norm, hg_diff, hg_eq, hg_feq_sharp, hg_mellin⟩ :=
