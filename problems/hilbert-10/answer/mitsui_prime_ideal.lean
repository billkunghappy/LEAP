      (hasSum_geometric_of_lt_one (by norm_num : (0 : ℝ) ≤ 11 / 15) (by norm_num : (11 / 15 : ℝ) < 1)).mul_left
        (M * (11 / 15 : ℝ) ^ m₀)
    have h_term_le : ∀ k : ℕ, -f (k + m₀) ≤ M * (11 / 15 : ℝ) ^ m₀ * (11 / 15 : ℝ) ^ k := by
      intro k
      have h1 : -f (k + m₀) ≤ (M * (2 / 3 : ℝ) ^ (k + m₀)) * u ^ (k + m₀) := by
        dsimp [f]
        rw [← neg_mul]
