        have h1 := @Finset.sum_powerset_neg_one_pow_card (Ideal R) _ ((f_I I).toFinset)
        have h2 := congrArg (Int.cast : ℤ → ℝ) h1
        push_cast at h2
        rw [h2]
      rw [h_powerset]
      by_cases hn1 : n = 1
      · subst hn1
        have h_delta : LSeries.delta 1 = (1 : ℂ) := rfl
        rw [h_delta]
        let I_top : S 1 := ⟨⊤, Ideal.absNorm_top⟩
        have h_single : (∑ I : S 1, if (f_I I).toFinset = ∅ then (1 : ℝ) else 0) =
            if (f_I I_top).toFinset = ∅ then (1 : ℝ) else 0 := by
          refine Finset.sum_eq_single I_top (fun I _ hI_ne_top => ?_) (fun h_abs => False.elim (h_abs (Finset.mem_univ I_top)))
          exfalso
          apply hI_ne_top
          exact Subtype.ext (Ideal.absNorm_eq_one_iff.mp I.2)
        rw [h_single]
        have h_top_ne : (⊤ : Ideal R) ≠ ⊥ := top_ne_bot
        have h_top_unit : IsUnit (⊤ : Ideal R) := Ideal.isUnit_iff.mpr rfl
        have h_top_nf : f_I I_top = 0 :=
          (UniqueFactorizationMonoid.normalizedFactors_eq_zero_iff h_top_ne).mpr h_top_unit
        rw [h_top_nf, Multiset.toFinset_zero, if_pos rfl, Complex.ofReal_one]
      · have h_delta : LSeries.delta n = 0 := if_neg hn1
        rw [h_delta]
        have h_zero : (∑ I : S n, if (f_I I).toFinset = ∅ then (1 : ℝ) else 0) = 0 := by
          refine Finset.sum_eq_zero (fun I _ => ?_)
          have hI_ne : I.1 ≠ ⊥ := Ideal.absNorm_eq_zero_iff.not.mp (by rw [I.2]; exact hn)
          have hI_not_top : I.1 ≠ ⊤ := by
            intro htop
            have h1 : Ideal.absNorm I.1 = 1 := Ideal.absNorm_eq_one_iff.mpr htop
            rw [I.2] at h1
            exact hn1 h1
          have h_not_empty : (f_I I).toFinset ≠ ∅ := by
            dsimp [f_I]
            rw [Multiset.toFinset_eq_empty,
              UniqueFactorizationMonoid.normalizedFactors_eq_zero_iff hI_ne, Ideal.isUnit_iff]
            exact hI_not_top
          exact if_neg h_not_empty
