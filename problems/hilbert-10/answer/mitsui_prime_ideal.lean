      ∀ j : Fin r, W₀ (x * y) j = W₀ x j + W₀ y j := by
    intro x y hx hy j
    have hxK : (x : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx
    have hyK : (y : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hy
    have hlog_mul : ∀ v : NumberField.InfinitePlace K,
        Real.log (v ((x * y : NumberField.RingOfIntegers K) : K)) =
          Real.log (v (x : K)) + Real.log (v (y : K)) := by
      intro v
      push_cast
      rw [map_mul, Real.log_mul (ne_of_gt (v.pos_iff.mpr hxK)) (ne_of_gt (v.pos_iff.mpr hyK))]
    have hℓ_mul : ∀ v : NumberField.InfinitePlace K, ℓ (x * y) v = ℓ x v + ℓ y v := by
      intro v
      dsimp [ℓ]
      rw [hlog_mul v]
      have hsum : (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * Real.log (w ((x * y : NumberField.RingOfIntegers K) : K))) =
          (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * Real.log (w (x : K))) +
          (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * Real.log (w (y : K))) := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun w _ => ?_)
        rw [hlog_mul w, mul_add]
      rw [hsum]
      ring
    have hL_mul : L_vec (x * y) = L_vec x + L_vec y := by
      ext w
      change (w.1.mult : ℝ) * ℓ (x * y) w.1 = (w.1.mult : ℝ) * ℓ x w.1 + (w.1.mult : ℝ) * ℓ y w.1
      rw [hℓ_mul w.1, mul_add]
    dsimp [W₀]
    rw [hL_mul, map_add, Finsupp.add_apply]
  have hτ₀_norm : ∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
      ∀ w : NumberField.InfinitePlace K, ‖τ₀ x w‖ = 1 := by
    intro x hx w
    have hxK : (x : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx
    have hwx_pos : 0 < w (x : K) := w.pos_iff.mpr hxK
    dsimp [τ₀]
    rw [norm_mul, norm_div, NumberField.InfinitePlace.norm_embedding_eq,
      Complex.norm_real, Real.norm_eq_abs, abs_of_pos hwx_pos,
      div_self (ne_of_gt hwx_pos), Complex.norm_exp_ofReal_mul_I, mul_one]
  have hτ₀_mul : ∀ (x y : NumberField.RingOfIntegers K), x ≠ 0 → y ≠ 0 →
