    have ht2 := norm_sub_le (Ψ₁_cone (Real.exp δ * Y)) (Ψ₁_cone Y)
    linarith
  have h_δ_ψ_le_c2 : δ * ‖ψ_cone Y‖ ≤ c₂ * Y * δ ^ 2 := by
    have h_c2_ge : 2 * c * Real.exp 1 + 3 * c + c * Real.exp (1 / c) + 2 * W ≤ c₂ := by
      have : 0 ≤ 2 * c := by positivity
      dsimp [c₂]; linarith
    have hYδ2_nonneg : 0 ≤ Y * δ ^ 2 := by positivity
    have h_bound : (2 * c * Real.exp 1 + 3 * c + c * Real.exp (1 / c) + 2 * W) * (Y * δ ^ 2) ≤
        c₂ * Y * δ ^ 2 := by
      calc (2 * c * Real.exp 1 + 3 * c + c * Real.exp (1 / c) + 2 * W) * (Y * δ ^ 2)
        _ ≤ c₂ * (Y * δ ^ 2) := mul_le_mul_of_nonneg_right h_c2_ge hYδ2_nonneg
        _ = c₂ * Y * δ ^ 2 := by ring
    linarith
  have h_ψ_le_δ : ‖ψ_cone Y‖ ≤ c₂ * Y * δ := by
    apply le_of_mul_le_mul_left _ hδ_pos
    calc δ * ‖ψ_cone Y‖ ≤ c₂ * Y * δ ^ 2 := h_δ_ψ_le_c2
      _ = δ * (c₂ * Y * δ) := by ring
  have h_δ_le_final : δ ≤ Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    dsimp [δ]
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    have h1 : Real.sqrt (Real.log X) / c₂ ≤ Real.sqrt (Real.log Y) / c₂ :=
      div_le_div_of_nonneg_right hsqrtX_le_sqrtY (le_of_lt hc₂_pos)
    have h2c_le_c2 : 2 * c ≤ c₂ := by
      have : 0 ≤ 2 * c * Real.exp 1 + 3 * c + c * Real.exp (1 / c) + 2 * W := by positivity
      dsimp [c₂]; linarith
    have h2 : Real.sqrt (Real.log Y) / c₂ ≤ Real.sqrt (Real.log Y) / (2 * c) :=
      div_le_div_of_nonneg_left (Real.sqrt_nonneg _) (by positivity) h2c_le_c2
    linarith
  calc ‖ψ_cone Y‖ ≤ c₂ * Y * δ := h_ψ_le_δ
    _ ≤ c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
        mul_le_mul_of_nonneg_left h_δ_le_final (by positivity)

theorem mitsui_prime_char_fundamentalCone_bound_of_torsion_eq_one_of_units_ne_one {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c₂ : ℝ, 0 < c₂ ∧
      ∀ X : ℝ, 1 < X →
        ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
          (Ideal.absNorm q : ℝ) < Real.log X ^ A →
          ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
            (∀ u ∈ NumberField.Units.torsion K,
              ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) →
            (∃ u : (NumberField.RingOfIntegers K)ˣ,
              ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) ≠ 1) →
            ‖∑' π : {π : NumberField.RingOfIntegers K //
                  Prime π ∧
                  NumberField.mixedEmbedding K (π : K) ∈
                    NumberField.mixedEmbedding.fundamentalCone K ∧
                  NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤
                    X ^ (Module.finrank ℚ K) ∧
                  IsUnit (Ideal.Quotient.mk q π)},
                ψ (Additive.ofMul π.2.2.2.2.unit) *
                  (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)‖
              ≤ c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
by
  obtain ⟨c₀, hc₀_pos, hc₀⟩ := mitsui_higher_primePower_chebyshev_bound (K := K)
  obtain ⟨c₁, hc₁_pos, hc₁⟩ :=
    mitsui_primePower_char_fundamentalCone_bound_of_fundSystem_ne_one (K := K) A hA
  set W : ℝ := (NumberField.Units.torsionOrder K : ℝ)
  have hW_nat_pos : 0 < NumberField.Units.torsionOrder K :=
    NumberField.Units.torsionOrder_pos K
  have hW_pos : 0 < W := by
    dsimp [W]
    exact_mod_cast hW_nat_pos
  have hW_ge_one : 1 ≤ W := by
    dsimp [W]
    exact_mod_cast hW_nat_pos
  let c₂ : ℝ := W * c₀ + c₁
  have hc₂_pos : 0 < c₂ := by
    dsimp [c₂]
    positivity
  have hc₀_le : c₀ ≤ c₂ := by
    dsimp [c₂]
    nlinarith
  have hc₁_le : c₁ ≤ c₂ := by
    dsimp [c₂]
    nlinarith
  refine ⟨c₂, hc₂_pos, ?_⟩
  intro X hX q hq hq_norm ψ hψ hψ_tors hψ_units
  obtain ⟨i₀, hi₀⟩ := mitsui_exists_fundSystem_char_ne_one q ψ hψ_tors hψ_units
  set Y : ℝ := X ^ (Module.finrank ℚ K)
  have hX_pos : (0 : ℝ) < X := by linarith
  have hY_nonneg : 0 ≤ Y := by dsimp [Y]; positivity
  have hsqrt_nonneg : 0 ≤ Real.sqrt (Real.log X) := Real.sqrt_nonneg _
  have hexp₀ : Real.exp (-Real.sqrt (Real.log X) / c₀) ≤ Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₀_pos hc₀_le
  have hexp₁ : Real.exp (-Real.sqrt (Real.log X) / c₁) ≤ Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₁_pos hc₁_le
  set S₁ : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
        Prime π ∧
        NumberField.mixedEmbedding K (π : K) ∈
          NumberField.mixedEmbedding.fundamentalCone K ∧
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤ Y ∧
        IsUnit (Ideal.Quotient.mk q π)},
      ψ (Additive.ofMul π.2.2.2.2.unit) *
        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S₂ : ℂ := ∑' xpm : {xpm : NumberField.RingOfIntegers K ×
          IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ xpm.2.2 ∧
        Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
        NumberField.mixedEmbedding K (xpm.1 : K) ∈
          NumberField.mixedEmbedding.fundamentalCone K ∧
        (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Y ∧
        IsUnit (Ideal.Quotient.mk q xpm.1)},
      ψ (Additive.ofMul xpm.2.2.2.2.2.unit) *
        (Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) : ℂ)
  have h_tri : ‖S₁‖ ≤ ‖S₁ - S₂‖ + ‖S₂‖ := norm_le_norm_sub_add S₁ S₂
  have h_sub₁ : ‖S₁ - S₂‖ ≤ W * (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
      Real.log (Ideal.absNorm pm.1.1.asIdeal)) :=
    mitsui_prime_char_fundamentalCone_sub_primePower_le Y q hq ψ
  have h_sub₂ : W * (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
      Real.log (Ideal.absNorm pm.1.1.asIdeal)) ≤
      W * (c₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₀)) :=
    mul_le_mul_of_nonneg_left (hc₀ X hX) (le_of_lt hW_pos)
  have h_sub : ‖S₁ - S₂‖ ≤ W * (c₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₀)) :=
    le_trans h_sub₁ h_sub₂
  have h_main : ‖S₂‖ ≤ c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) :=
    hc₁ X hX q hq hq_norm ψ hψ hψ_tors i₀ hi₀
  have hterm₀ : W * (c₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₀)) ≤
      (W * c₀) * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    calc W * (c₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₀))
      _ ≤ W * (c₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂)) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp₀ (by positivity)) (le_of_lt hW_pos)
      _ = (W * c₀) * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := by ring
  have hterm₁ : c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) ≤
      c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
    mul_le_mul_of_nonneg_left hexp₁ (by positivity)
  have h_sum_eq :
      (W * c₀) * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) +
      c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) =
      c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    dsimp [c₂]
    ring
  linarith

theorem mitsui_prime_char_box_to_fundamentalCone {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c_bf : ℝ, 0 < c_bf ∧
      ∀ X : ℝ, 1 < X →
        ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
          (Ideal.absNorm q : ℝ) < Real.log X ^ A →
          ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
            ‖(∑' π : {π : NumberField.RingOfIntegers K //
                  Prime π ∧
                  (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
                  IsUnit (Ideal.Quotient.mk q π)},
                ψ (Additive.ofMul π.2.2.2.unit) *
                  (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
              - (((NumberField.Units.regulator K)⁻¹ : ℝ) : ℂ) *
                (∑' π : {π : NumberField.RingOfIntegers K //
                      Prime π ∧
                      NumberField.mixedEmbedding K (π : K) ∈
                        NumberField.mixedEmbedding.fundamentalCone K ∧
                      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤
                        X ^ (Module.finrank ℚ K) ∧
                      IsUnit (Ideal.Quotient.mk q π)},
                    ψ (Additive.ofMul π.2.2.2.2.unit) *
                      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
              ≤ c_bf * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_bf) :=
by
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_prime_char_box_to_fundamentalCone_of_units_eq_one (K := K) A hA
  obtain ⟨c₂, hc₂_pos, hc₂⟩ := mitsui_prime_char_box_bound_of_torsion_eq_one_of_units_ne_one (K := K) A hA
  obtain ⟨c₃, hc₃_pos, hc₃⟩ := mitsui_prime_char_fundamentalCone_bound_of_torsion_eq_one_of_units_ne_one (K := K) A hA
  set R : ℝ := NumberField.Units.regulator K
  have hR_pos : 0 < R := NumberField.Units.regulator_pos K
  have hR_inv_nonneg : 0 ≤ R⁻¹ := by positivity
  let c_bf : ℝ := c₁ + c₂ + c₃ + R⁻¹ * c₃
  have hc_bf_pos : 0 < c_bf := by dsimp [c_bf]; positivity
  refine ⟨c_bf, hc_bf_pos, ?_⟩
  intro X hX q hq hq_norm ψ hψ
  set Y : ℝ := X ^ (Module.finrank ℚ K)
  have hX_pos : (0 : ℝ) < X := by linarith
  have hY_nonneg : 0 ≤ Y := by dsimp [Y]; positivity
  have hsqrt_nonneg : 0 ≤ Real.sqrt (Real.log X) := Real.sqrt_nonneg _
  have hc₁_le : c₁ ≤ c_bf := by
    have : 0 ≤ c₂ + c₃ + R⁻¹ * c₃ := by positivity
    dsimp [c_bf]; linarith
  have hc₂_le : c₂ ≤ c_bf := by
    have : 0 ≤ c₁ + c₃ + R⁻¹ * c₃ := by positivity
    dsimp [c_bf]; linarith
  have hc₃_le : c₃ ≤ c_bf := by
    have : 0 ≤ c₁ + c₂ + R⁻¹ * c₃ := by positivity
    dsimp [c_bf]; linarith
  have hexp₁ : Real.exp (-Real.sqrt (Real.log X) / c₁) ≤ Real.exp (-Real.sqrt (Real.log X) / c_bf) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₁_pos hc₁_le
  have hexp₂ : Real.exp (-Real.sqrt (Real.log X) / c₂) ≤ Real.exp (-Real.sqrt (Real.log X) / c_bf) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₂_pos hc₂_le
  have hexp₃ : Real.exp (-Real.sqrt (Real.log X) / c₃) ≤ Real.exp (-Real.sqrt (Real.log X) / c_bf) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₃_pos hc₃_le
  by_cases h_tors : ∃ u ∈ NumberField.Units.torsion K,
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) ≠ 1
  · obtain ⟨u, hu_tors, hu_ne⟩ := h_tors
    let D_box := {π : NumberField.RingOfIntegers K //
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
      IsUnit (Ideal.Quotient.mk q π)}
    have h_box_closed : ∀ (v : (NumberField.RingOfIntegers K)ˣ), v ∈ NumberField.Units.torsion K →
        ∀ π : D_box, Prime ((v : NumberField.RingOfIntegers K) * π.1) ∧
          (∀ w : NumberField.InfinitePlace K,
            w (((v : NumberField.RingOfIntegers K) * π.1 : NumberField.RingOfIntegers K) : K) < X) ∧
          IsUnit (Ideal.Quotient.mk q ((v : NumberField.RingOfIntegers K) * π.1)) := by
      intro v hv π
      refine ⟨?_, ?_, ?_⟩
      · exact (associated_unit_mul_left π.1 (v : NumberField.RingOfIntegers K) v.isUnit).prime_iff.mpr π.2.1
      · intro w
        have hw : w ((v : NumberField.RingOfIntegers K) : K) = 1 := (NumberField.Units.mem_torsion K).mp hv w
        push_cast
        rw [map_mul, hw, one_mul]
        exact π.2.2.1 w
      · rw [map_mul]
        exact (v.isUnit.map (Ideal.Quotient.mk q)).mul π.2.2.2
    let e_box : D_box ≃ D_box :=
      { toFun := fun π => ⟨(u : NumberField.RingOfIntegers K) * π.1, h_box_closed u hu_tors π⟩
        invFun := fun π => ⟨((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * π.1,
          h_box_closed u⁻¹ ((NumberField.Units.torsion K).inv_mem hu_tors) π⟩
        left_inv := fun π => by ext; simp [← mul_assoc]
        right_inv := fun π => by ext; simp [← mul_assoc] }
    let F_box : D_box → ℂ := fun π =>
      ψ (Additive.ofMul π.2.2.2.unit) *
        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
    let c_u : ℂ := ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u))
    have hF_box : ∀ π : D_box, F_box (e_box π) = c_u * F_box π := by
      intro π
      dsimp [F_box, e_box, c_u]
      have h_unit : (h_box_closed u hu_tors π).2.2.unit =
          Units.map (Ideal.Quotient.mk q).toMonoidHom u * π.2.2.2.unit := by
        ext; simp
      have h_norm : (Algebra.norm ℤ ((u : NumberField.RingOfIntegers K) * π.1)).natAbs =
          (Algebra.norm ℤ π.1).natAbs := by
        rw [map_mul, Int.natAbs_mul, Int.natAbs_of_isUnit (u.isUnit.map (Algebra.norm ℤ)), one_mul]
      rw [h_unit, ofMul_mul, AddChar.map_add_eq_mul, h_norm, mul_assoc]
      rfl
    have h_box_zero : ∑' π : D_box, F_box π = 0 := by
      have h_sum : ∑' π : D_box, F_box π = c_u * ∑' π : D_box, F_box π := by
        calc ∑' π : D_box, F_box π
          _ = ∑' π : D_box, F_box (e_box π) := (Equiv.tsum_eq e_box F_box).symm
          _ = ∑' π : D_box, (c_u * F_box π) := tsum_congr hF_box
          _ = c_u * ∑' π : D_box, F_box π := tsum_mul_left
      have h_sub : (c_u - 1) * ∑' π : D_box, F_box π = 0 := by linear_combination -h_sum
      rcases mul_eq_zero.mp h_sub with hc | h0
      · exfalso; exact hu_ne (sub_eq_zero.mp hc)
      · exact h0
    let D_cone := {π : NumberField.RingOfIntegers K //
      Prime π ∧
      NumberField.mixedEmbedding K (π : K) ∈
        NumberField.mixedEmbedding.fundamentalCone K ∧
      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤ Y ∧
      IsUnit (Ideal.Quotient.mk q π)}
    have h_cone_closed : ∀ (v : (NumberField.RingOfIntegers K)ˣ), v ∈ NumberField.Units.torsion K →
        ∀ π : D_cone, Prime ((v : NumberField.RingOfIntegers K) * π.1) ∧
          NumberField.mixedEmbedding K (((v : NumberField.RingOfIntegers K) * π.1 : NumberField.RingOfIntegers K) : K) ∈
            NumberField.mixedEmbedding.fundamentalCone K ∧
          NumberField.mixedEmbedding.norm
            (NumberField.mixedEmbedding K (((v : NumberField.RingOfIntegers K) * π.1 : NumberField.RingOfIntegers K) : K)) ≤ Y ∧
          IsUnit (Ideal.Quotient.mk q ((v : NumberField.RingOfIntegers K) * π.1)) := by
      intro v hv π
      have hw_eq : ∀ w : NumberField.InfinitePlace K,
          NumberField.mixedEmbedding.normAtPlace w
            (NumberField.mixedEmbedding K (((v : NumberField.RingOfIntegers K) * π.1 : NumberField.RingOfIntegers K) : K)) =
          NumberField.mixedEmbedding.normAtPlace w (NumberField.mixedEmbedding K (π.1 : K)) := by
        intro w
        rw [NumberField.mixedEmbedding.normAtPlace_apply, NumberField.mixedEmbedding.normAtPlace_apply]
        have hw : w ((v : NumberField.RingOfIntegers K) : K) = 1 := (NumberField.Units.mem_torsion K).mp hv w
        push_cast
        rw [map_mul, hw, one_mul]
      refine ⟨?_, ?_, ?_, ?_⟩
      · exact (associated_unit_mul_left π.1 (v : NumberField.RingOfIntegers K) v.isUnit).prime_iff.mpr π.2.1
      · exact NumberField.mixedEmbedding.fundamentalCone.mem_of_normAtPlace_eq π.2.2.1 hw_eq
      · have h_norm_v : NumberField.mixedEmbedding.norm
            (NumberField.mixedEmbedding K ((v : NumberField.RingOfIntegers K) : K)) = 1 := by
          simpa [NumberField.mixedEmbedding.norm] using
            Finset.prod_eq_one (fun w _ => by
              rw [(NumberField.Units.mem_torsion K).mp hv w, one_pow])
        push_cast
        rw [map_mul, map_mul, h_norm_v, one_mul]
        exact π.2.2.2.1
      · rw [map_mul]
        exact (v.isUnit.map (Ideal.Quotient.mk q)).mul π.2.2.2.2
    let e_cone : D_cone ≃ D_cone :=
      { toFun := fun π => ⟨(u : NumberField.RingOfIntegers K) * π.1, h_cone_closed u hu_tors π⟩
        invFun := fun π => ⟨((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * π.1,
          h_cone_closed u⁻¹ ((NumberField.Units.torsion K).inv_mem hu_tors) π⟩
        left_inv := fun π => by ext; simp [← mul_assoc]
        right_inv := fun π => by ext; simp [← mul_assoc] }
    let F_cone : D_cone → ℂ := fun π =>
      ψ (Additive.ofMul π.2.2.2.2.unit) *
        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
    have hF_cone : ∀ π : D_cone, F_cone (e_cone π) = c_u * F_cone π := by
      intro π
      dsimp [F_cone, e_cone, c_u]
      have h_unit : (h_cone_closed u hu_tors π).2.2.2.unit =
          Units.map (Ideal.Quotient.mk q).toMonoidHom u * π.2.2.2.2.unit := by
        ext; simp
      have h_norm : (Algebra.norm ℤ ((u : NumberField.RingOfIntegers K) * π.1)).natAbs =
          (Algebra.norm ℤ π.1).natAbs := by
        rw [map_mul, Int.natAbs_mul, Int.natAbs_of_isUnit (u.isUnit.map (Algebra.norm ℤ)), one_mul]
      rw [h_unit, ofMul_mul, AddChar.map_add_eq_mul, h_norm, mul_assoc]
      rfl
    have h_cone_zero : ∑' π : D_cone, F_cone π = 0 := by
      have h_sum : ∑' π : D_cone, F_cone π = c_u * ∑' π : D_cone, F_cone π := by
        calc ∑' π : D_cone, F_cone π
          _ = ∑' π : D_cone, F_cone (e_cone π) := (Equiv.tsum_eq e_cone F_cone).symm
          _ = ∑' π : D_cone, (c_u * F_cone π) := tsum_congr hF_cone
          _ = c_u * ∑' π : D_cone, F_cone π := tsum_mul_left
      have h_sub : (c_u - 1) * ∑' π : D_cone, F_cone π = 0 := by linear_combination -h_sum
      rcases mul_eq_zero.mp h_sub with hc | h0
      · exfalso; exact hu_ne (sub_eq_zero.mp hc)
      · exact h0
    change ‖(∑' π : D_box, F_box π) - ((R⁻¹ : ℝ) : ℂ) * (∑' π : D_cone, F_cone π)‖ ≤
      c_bf * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf)
    rw [h_box_zero, h_cone_zero, mul_zero, sub_zero, norm_zero]
    positivity
  · push_neg at h_tors
    by_cases h_units : ∀ u : (NumberField.RingOfIntegers K)ˣ,
        ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1
    · have h1 := hc₁ X hX q hq hq_norm ψ hψ h_units
      have hterm₁ : c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) ≤
          c_bf * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) := by
        calc c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁)
          _ ≤ c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) :=
            mul_le_mul_of_nonneg_left hexp₁ (by positivity)
          _ ≤ c_bf * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) := by
            have : 0 ≤ Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) := by positivity
            nlinarith
      exact le_trans h1 hterm₁
    · push_neg at h_units
      have h2 := hc₂ X hX q hq hq_norm ψ hψ h_tors h_units
      have h3 := hc₃ X hX q hq hq_norm ψ hψ h_tors h_units
      set S_box : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
      set S_cone : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          NumberField.mixedEmbedding K (π : K) ∈
            NumberField.mixedEmbedding.fundamentalCone K ∧
          NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤ Y ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
      have h_tri : ‖S_box - ((R⁻¹ : ℝ) : ℂ) * S_cone‖ ≤ ‖S_box‖ + R⁻¹ * ‖S_cone‖ := by
        have ht := norm_sub_le S_box (((R⁻¹ : ℝ) : ℂ) * S_cone)
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hR_inv_nonneg] at ht
        exact ht
      have hterm₂ : ‖S_box‖ ≤ c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) := by
        calc ‖S_box‖ ≤ c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := h2
          _ ≤ c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) :=
            mul_le_mul_of_nonneg_left hexp₂ (by positivity)
      have hterm₃ : R⁻¹ * ‖S_cone‖ ≤ (R⁻¹ * c₃) * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) := by
        calc R⁻¹ * ‖S_cone‖ ≤ R⁻¹ * (c₃ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃)) :=
              mul_le_mul_of_nonneg_left h3 hR_inv_nonneg
          _ ≤ R⁻¹ * (c₃ * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf)) :=
              mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp₃ (by positivity)) hR_inv_nonneg
          _ = (R⁻¹ * c₃) * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) := by ring
      have h_sum_le :
          c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) +
          (R⁻¹ * c₃) * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) ≤
          c_bf * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) := by
        have h_coeff : c₂ + R⁻¹ * c₃ ≤ c_bf := by
          have : 0 ≤ c₁ + c₃ := by positivity
          dsimp [c_bf]; linarith
        have hYE_nonneg : 0 ≤ Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) := by positivity
        calc c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) +
            (R⁻¹ * c₃) * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf)
          _ = (c₂ + R⁻¹ * c₃) * (Y * Real.exp (-Real.sqrt (Real.log X) / c_bf)) := by ring
          _ ≤ c_bf * (Y * Real.exp (-Real.sqrt (Real.log X) / c_bf)) :=
            mul_le_mul_of_nonneg_right h_coeff hYE_nonneg
          _ = c_bf * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) := by ring
      linarith

theorem mitsui_vonMangoldt_char_cone_to_prime {K : Type u} [Field K] [NumberField K] :
    ∃ c₂ : ℝ, 0 < c₂ ∧
      ∀ X : ℝ, 1 < X →
        ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
          ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ,
            ‖(∑' x : {x : NumberField.RingOfIntegers K //
                  NumberField.mixedEmbedding K (x : K) ∈
                    NumberField.mixedEmbedding.fundamentalCone K ∧
                  NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤
                    X ^ (Module.finrank ℚ K) ∧
                  IsUnit (Ideal.Quotient.mk q x)},
                ψ (Additive.ofMul x.2.2.2.unit) *
                  (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ))
              - (∑' π : {π : NumberField.RingOfIntegers K //
                    Prime π ∧
                    NumberField.mixedEmbedding K (π : K) ∈
                      NumberField.mixedEmbedding.fundamentalCone K ∧
                    NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤
                      X ^ (Module.finrank ℚ K) ∧
                    IsUnit (Ideal.Quotient.mk q π)},
                  ψ (Additive.ofMul π.2.2.2.2.unit) *
                    (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
              ≤ c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
by
  classical
  have h_norm_span : ∀ x : NumberField.RingOfIntegers K,
      (Ideal.absNorm (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))) : ℝ) =
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) := by
    intro x
    rw [Ideal.absNorm_span_singleton, NumberField.mixedEmbedding.norm_eq_norm,
      ← Algebra.coe_norm_int x, Nat.cast_natAbs]
    push_cast
    rfl
  have h_cone_fin : ∀ Y : ℝ,
      {x : NumberField.RingOfIntegers K |
        NumberField.mixedEmbedding K (x : K) ∈ NumberField.mixedEmbedding.fundamentalCone K ∧
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤ Y}.Finite := by
    intro Y
    let S_cone : Set (NumberField.RingOfIntegers K) :=
      {x : NumberField.RingOfIntegers K |
        NumberField.mixedEmbedding K (x : K) ∈ NumberField.mixedEmbedding.fundamentalCone K ∧
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤ Y}
    let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
      {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊}
    have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Y⌋₊
    haveI : Finite S_id := hSid_fin
    let a : S_cone → NumberField.mixedEmbedding.fundamentalCone.integerSet K :=
      fun x => ⟨NumberField.mixedEmbedding K (x.1 : K),
        NumberField.mixedEmbedding.fundamentalCone.mem_integerSet.mpr ⟨x.2.1, x.1, rfl⟩⟩
    have ha_pre : ∀ x : S_cone,
        (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet (a x) :
          NumberField.RingOfIntegers K) = x.1 :=
      fun x => NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet_mixedEmbedding (a x).2
    have h_span_mem : ∀ x : S_cone,
        Ideal.span ({x.1} : Set (NumberField.RingOfIntegers K)) ∈ S_id := by
      intro x
      show Ideal.absNorm (Ideal.span ({x.1} : Set (NumberField.RingOfIntegers K))) ≤ ⌊Y⌋₊
      apply Nat.le_floor
      rw [h_norm_span x.1]
      exact x.2.2
    let φ : S_cone → S_id × NumberField.Units.torsion K :=
      fun x => (⟨Ideal.span {x.1}, h_span_mem x⟩,
        (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a x)).2)
    have hφ_inj : Function.Injective φ := by
      intro x₁ x₂ hφ
      have h1 : Ideal.span ({x₁.1} : Set (NumberField.RingOfIntegers K)) =
          Ideal.span ({x₂.1} : Set (NumberField.RingOfIntegers K)) :=
        congrArg Subtype.val (Prod.ext_iff.mp hφ).1
      have h2 : (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a x₁)).2 =
          (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a x₂)).2 :=
        (Prod.ext_iff.mp hφ).2
      have hfst1 : (((NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a x₁)).1 :
          nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
          Ideal (NumberField.RingOfIntegers K)) =
          Ideal.span ({x₁.1} : Set (NumberField.RingOfIntegers K)) := by
        rw [NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv_apply_fst, ha_pre x₁]
      have hfst2 : (((NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a x₂)).1 :
          nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
          Ideal (NumberField.RingOfIntegers K)) =
          Ideal.span ({x₂.1} : Set (NumberField.RingOfIntegers K)) := by
        rw [NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv_apply_fst, ha_pre x₂]
      have hfst_eq : (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a x₁)).1 =
          (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a x₂)).1 := by
        apply Subtype.ext
        apply Subtype.ext
        rw [hfst1, hfst2, h1]
      have heq_equiv : NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a x₁) =
          NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a x₂) :=
        Prod.ext hfst_eq h2
      have ha_eq : a x₁ = a x₂ :=
        (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K).injective heq_equiv
      have hx_val : x₁.1 = x₂.1 := by
        rw [← ha_pre x₁, ← ha_pre x₂]
        exact congrArg (fun z : NumberField.mixedEmbedding.fundamentalCone.integerSet K =>
          (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet z :
            NumberField.RingOfIntegers K)) ha_eq
      exact Subtype.ext hx_val
    exact Finite.of_injective φ hφ_inj
  have h_s1 : ∀ (X : ℝ), 1 < X →
      ∀ (q : Ideal (NumberField.RingOfIntegers K)), q ≠ 0 →
      ∀ (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ),
        ‖(∑' x : {x : NumberField.RingOfIntegers K //
              NumberField.mixedEmbedding K (x : K) ∈
                NumberField.mixedEmbedding.fundamentalCone K ∧
              NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤
                X ^ (Module.finrank ℚ K) ∧
              IsUnit (Ideal.Quotient.mk q x)},
            ψ (Additive.ofMul x.2.2.2.unit) *
              (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ))
          - (∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧
                NumberField.mixedEmbedding K (π : K) ∈
                  NumberField.mixedEmbedding.fundamentalCone K ∧
                NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤
                  X ^ (Module.finrank ℚ K) ∧
                IsUnit (Ideal.Quotient.mk q π)},
              ψ (Additive.ofMul π.2.2.2.2.unit) *
                (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
          ≤ (Module.finrank ℚ K : ℝ) * Real.log X *
            (Nat.card {x : NumberField.RingOfIntegers K //
              NumberField.mixedEmbedding K (x : K) ∈
                NumberField.mixedEmbedding.fundamentalCone K ∧
              NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤
                X ^ (Module.finrank ℚ K) ∧
              ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
                ∃ m : ℕ, 2 ≤ m ∧ Ideal.span {x} = p.asIdeal ^ m} : ℝ) := by
    intro X hX q hq ψ
    set Y : ℝ := X ^ (Module.finrank ℚ K)
    have hScone_fin : {x : NumberField.RingOfIntegers K |
        NumberField.mixedEmbedding K (x : K) ∈ NumberField.mixedEmbedding.fundamentalCone K ∧
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤ Y}.Finite :=
      h_cone_fin Y
    let Q : NumberField.RingOfIntegers K → Prop :=
      fun x =>
        NumberField.mixedEmbedding K (x : K) ∈ NumberField.mixedEmbedding.fundamentalCone K ∧
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤ Y ∧
        IsUnit (Ideal.Quotient.mk q x)
    have hSQ_fin : {x : NumberField.RingOfIntegers K | Q x}.Finite :=
      hScone_fin.subset (fun _ hx => ⟨hx.1, hx.2.1⟩)
    letI : Fintype {x : NumberField.RingOfIntegers K // Q x} := hSQ_fin.fintype
    let S_pp : Set (NumberField.RingOfIntegers K) :=
      {x : NumberField.RingOfIntegers K |
        NumberField.mixedEmbedding K (x : K) ∈ NumberField.mixedEmbedding.fundamentalCone K ∧
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤ Y ∧
        ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          ∃ m : ℕ, 2 ≤ m ∧ Ideal.span {x} = p.asIdeal ^ m}
    have hSpp_fin : S_pp.Finite := hScone_fin.subset (fun _ hx => ⟨hx.1, hx.2.1⟩)
    let F_pp : Finset (NumberField.RingOfIntegers K) := hSpp_fin.toFinset
    have hFpp_mem : ∀ x : NumberField.RingOfIntegers K, x ∈ F_pp ↔ x ∈ S_pp :=
      fun x => hSpp_fin.mem_toFinset
    have hcard_Spp : F_pp.card = Nat.card S_pp := by
      letI : Fintype S_pp := hSpp_fin.fintype
      rw [Nat.card_eq_fintype_card, hSpp_fin.card_toFinset]
    have h_nonneg : ∀ x : NumberField.RingOfIntegers K, 0 ≤ vonMangoldtO x := by
      intro x
      dsimp [vonMangoldtO]
      split_ifs with h
      · exact Real.log_natCast_nonneg _
      · exact le_rfl
    have h_prime_eq : ∀ π : NumberField.RingOfIntegers K, Prime π →
        vonMangoldtO π = Real.log ((Algebra.norm ℤ π).natAbs : ℝ) := by
      intro π hπ
      have hπ_ne : π ≠ 0 := hπ.ne_zero
      have hI_ne_bot : Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) ≠ ⊥ :=
        Ideal.span_singleton_eq_bot.not.mpr hπ_ne
      have hI_prime : (Ideal.span ({π} : Set (NumberField.RingOfIntegers K))).IsPrime :=
        (Ideal.span_singleton_prime hπ_ne).mpr hπ
      let p₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) :=
        ⟨Ideal.span {π}, hI_prime, hI_ne_bot⟩
      have hex : ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          ∃ m : ℕ, 0 < m ∧ Ideal.span {π} = p.asIdeal ^ m :=
        ⟨p₀, 1, zero_lt_one, (pow_one _).symm⟩
      have h_unfold : vonMangoldtO π = Real.log (Ideal.absNorm hex.choose.asIdeal) := by
        dsimp [vonMangoldtO]
        exact dif_pos hex
      obtain ⟨m, hm_pos, hm_eq⟩ := hex.choose_spec
      have h_le : p₀.asIdeal ≤ hex.choose.asIdeal :=
        hm_eq.le.trans (Ideal.pow_le_self hm_pos.ne')
      have h_max : p₀.asIdeal.IsMaximal := IsDedekindDomain.HeightOneSpectrum.isMaximal p₀
      have h_ne_top : hex.choose.asIdeal ≠ ⊤ := hex.choose.isPrime.ne_top
      have h_ideal_eq : hex.choose.asIdeal = Ideal.span {π} :=
        (h_max.eq_of_le h_ne_top h_le).symm
      rw [h_unfold, h_ideal_eq, Ideal.absNorm_span_singleton]
    let g : {x : NumberField.RingOfIntegers K // Q x} → ℂ :=
      fun x => ψ (Additive.ofMul x.2.2.2.unit) * (vonMangoldtO x.1 : ℂ)
    have h_tsum1 : (∑' x : {x : NumberField.RingOfIntegers K // Q x}, g x) =
        ∑ x ∈ (Finset.univ : Finset {x : NumberField.RingOfIntegers K // Q x}), g x :=
      tsum_fintype g
    let e : {π : NumberField.RingOfIntegers K // Prime π ∧ Q π} ≃
        {x : {x : NumberField.RingOfIntegers K // Q x} // Prime x.1} :=
      { toFun := fun π => ⟨⟨π.1, π.2.2⟩, π.2.1⟩
        invFun := fun x => ⟨x.1.1, x.2, x.1.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }
    have h_tsum2 :
        (∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ Q π},
          ψ (Additive.ofMul π.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) =
        ∑ x ∈ Finset.univ.filter (fun x : {x : NumberField.RingOfIntegers K // Q x} => Prime x.1), g x := by
      have h_congr :
          (∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ Q π},
            ψ (Additive.ofMul π.2.2.2.2.unit) *
              (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) =
          ∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ Q π}, g (e π).1 := by
        refine tsum_congr (fun π => ?_)
        dsimp [g, e]
        rw [h_prime_eq π.1 π.2.1]
      rw [h_congr, Equiv.tsum_eq e (fun y : {x : {x : NumberField.RingOfIntegers K // Q x} // Prime x.1} => g y.1)]
      rw [tsum_fintype]
      exact (Finset.sum_subtype (Finset.univ.filter (fun x : {x : NumberField.RingOfIntegers K // Q x} => Prime x.1))
        (fun _ => Finset.mem_filter.trans (and_iff_right (Finset.mem_univ _))) g).symm
    have h_diff_eq :
        (∑' x : {x : NumberField.RingOfIntegers K // Q x}, g x) -
        (∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ Q π},
          ψ (Additive.ofMul π.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) =
        ∑ x ∈ Finset.univ.filter (fun x : {x : NumberField.RingOfIntegers K // Q x} => ¬ Prime x.1), g x := by
      rw [h_tsum1, h_tsum2, ← Finset.sum_filter_add_sum_filter_not Finset.univ
        (fun x : {x : NumberField.RingOfIntegers K // Q x} => Prime x.1) g]
      ring
    have hq_bot : q ≠ ⊥ := hq
    haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
      Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
    have h_norm_le1 :
        ‖∑ x ∈ Finset.univ.filter (fun x : {x : NumberField.RingOfIntegers K // Q x} => ¬ Prime x.1), g x‖ ≤
        ∑ x ∈ Finset.univ.filter (fun x : {x : NumberField.RingOfIntegers K // Q x} => ¬ Prime x.1),
          vonMangoldtO x.1 := by
      calc ‖∑ x ∈ Finset.univ.filter (fun x : {x : NumberField.RingOfIntegers K // Q x} => ¬ Prime x.1), g x‖
          ≤ ∑ x ∈ Finset.univ.filter (fun x : {x : NumberField.RingOfIntegers K // Q x} => ¬ Prime x.1), ‖g x‖ :=
            norm_sum_le _ _
        _ = ∑ x ∈ Finset.univ.filter (fun x : {x : NumberField.RingOfIntegers K // Q x} => ¬ Prime x.1),
            vonMangoldtO x.1 := by
            refine Finset.sum_congr rfl (fun x _ => ?_)
            dsimp [g]
            rw [norm_mul, AddChar.norm_apply, one_mul, Complex.norm_real, Real.norm_eq_abs,
              abs_of_nonneg (h_nonneg x.1)]
    let emb : {x : NumberField.RingOfIntegers K // Q x} ↪ NumberField.RingOfIntegers K :=
      Function.Embedding.subtype _
    let F_rem : Finset (NumberField.RingOfIntegers K) :=
      (Finset.univ.filter (fun x : {x : NumberField.RingOfIntegers K // Q x} => ¬ Prime x.1)).map emb
    have h_sum_map :
        (∑ x ∈ Finset.univ.filter (fun x : {x : NumberField.RingOfIntegers K // Q x} => ¬ Prime x.1),
          vonMangoldtO x.1) =
        ∑ x ∈ F_rem, vonMangoldtO x :=
      (Finset.sum_map _ emb vonMangoldtO).symm
    let P_supp : NumberField.RingOfIntegers K → Prop :=
      fun x => ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ∃ m : ℕ, 0 < m ∧ Ideal.span {x} = p.asIdeal ^ m
    let F_supp : Finset (NumberField.RingOfIntegers K) := F_rem.filter P_supp
    have h_supp_split :
        ∑ x ∈ F_supp, vonMangoldtO x +
        ∑ x ∈ F_rem.filter (fun x => ¬ P_supp x), vonMangoldtO x =
        ∑ x ∈ F_rem, vonMangoldtO x :=
      Finset.sum_filter_add_sum_filter_not F_rem P_supp vonMangoldtO
    have h_not_supp_zero :
        ∑ x ∈ F_rem.filter (fun x => ¬ P_supp x), vonMangoldtO x = 0 := by
      refine Finset.sum_eq_zero (fun x hx => ?_)
      simp only [Finset.mem_filter] at hx
      dsimp [vonMangoldtO]
      exact dif_neg hx.2
    have h_sub_pp : F_supp ⊆ F_pp := by
      intro x hx
      simp only [F_supp, F_rem, Finset.mem_filter, Finset.mem_map, Finset.mem_univ, true_and] at hx
      rcases hx with ⟨⟨y, hnprime, rfl⟩, p, m, hm_pos, hm_eq⟩
      change Ideal.span ({y.1} : Set (NumberField.RingOfIntegers K)) = p.asIdeal ^ m at hm_eq
      rw [hFpp_mem]
      refine ⟨y.2.1, y.2.2.1, p, m, ?_, hm_eq⟩
      by_contra! hm_lt
      have hm1 : m = 1 := by omega
      have h_span : Ideal.span ({y.1} : Set (NumberField.RingOfIntegers K)) = p.asIdeal := by
        rw [hm_eq, hm1, pow_one]
      have hy_ne : y.1 ≠ 0 := by
        intro hy0
        apply p.ne_bot
        rw [← h_span, Ideal.span_singleton_eq_bot.mpr hy0]
      have hI_prime : (Ideal.span ({y.1} : Set (NumberField.RingOfIntegers K))).IsPrime := by
        rw [h_span]
        exact p.isPrime
      exact hnprime ((Ideal.span_singleton_prime hy_ne).mp hI_prime)
    have h_le_pp : ∑ x ∈ F_supp, vonMangoldtO x ≤ ∑ x ∈ F_pp, vonMangoldtO x :=
      Finset.sum_le_sum_of_subset_of_nonneg h_sub_pp (fun x _ _ => h_nonneg x)
    have h_ptwise : ∀ x ∈ F_pp,
        vonMangoldtO x ≤ (Module.finrank ℚ K : ℝ) * Real.log X := by
      intro x hx
      have hx_norm : NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤ Y :=
        ((hFpp_mem x).mp hx).2.1
      dsimp [vonMangoldtO]
      split_ifs with hex
      · let p := hex.choose
        obtain ⟨m, hm_pos, hm_eq⟩ := hex.choose_spec
        have hp_ne_zero : Ideal.absNorm p.asIdeal ≠ 0 :=
          Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
        have hp_pos : 0 < (Ideal.absNorm p.asIdeal : ℝ) := by
          exact_mod_cast Nat.pos_of_ne_zero hp_ne_zero
        have h_pow_eq : Ideal.absNorm (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))) =
            (Ideal.absNorm p.asIdeal) ^ m := by
          rw [hm_eq, map_pow]
        have h_nat_le : Ideal.absNorm p.asIdeal ≤
            Ideal.absNorm (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))) := by
          rw [h_pow_eq]
          exact Nat.le_self_pow hm_pos.ne' _
        have h_real_le1 : (Ideal.absNorm p.asIdeal : ℝ) ≤
            (Ideal.absNorm (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))) : ℝ) := by
          exact_mod_cast h_nat_le
        have h_real_le2 : (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K) := by
          rw [h_norm_span x] at h_real_le1
          exact le_trans h_real_le1 hx_norm
        have h_log_le : Real.log (Ideal.absNorm p.asIdeal : ℝ) ≤
            Real.log (X ^ (Module.finrank ℚ K)) :=
          Real.log_le_log hp_pos h_real_le2
        rw [Real.log_pow] at h_log_le
        exact h_log_le
      · have hlog_pos : 0 < Real.log X := Real.log_pos hX
        positivity
    have h_sum_le : ∑ x ∈ F_pp, vonMangoldtO x ≤
        (Module.finrank ℚ K : ℝ) * Real.log X * (Nat.card S_pp : ℝ) := by
      calc ∑ x ∈ F_pp, vonMangoldtO x
          ≤ ∑ _x ∈ F_pp, (Module.finrank ℚ K : ℝ) * Real.log X :=
            Finset.sum_le_sum h_ptwise
        _ = (F_pp.card : ℝ) * ((Module.finrank ℚ K : ℝ) * Real.log X) := by
            rw [Finset.sum_const, nsmul_eq_mul]
        _ = (Module.finrank ℚ K : ℝ) * Real.log X * (Nat.card S_pp : ℝ) := by
            rw [hcard_Spp]
            ring
    change ‖(∑' x : {x : NumberField.RingOfIntegers K // Q x}, g x) -
        (∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ Q π},
          ψ (Additive.ofMul π.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖ ≤
      (Module.finrank ℚ K : ℝ) * Real.log X * (Nat.card S_pp : ℝ)
    rw [h_diff_eq]
    linarith
  have h_s2 : ∀ (X : ℝ), 1 < X →
      (Nat.card {x : NumberField.RingOfIntegers K //
        NumberField.mixedEmbedding K (x : K) ∈
          NumberField.mixedEmbedding.fundamentalCone K ∧
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤
          X ^ (Module.finrank ℚ K) ∧
        ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          ∃ m : ℕ, 2 ≤ m ∧ Ideal.span {x} = p.asIdeal ^ m} : ℝ) ≤
