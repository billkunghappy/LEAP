    intro u
    have h_congr : (∫ y : Fin (NumberField.Units.rank K) → ℝ, G_maj (Ψ_K u y)) =
        ∫ y : Fin (NumberField.Units.rank K) → ℝ,
          (Real.exp ((n : ℝ) * u * z.re) * (2 : ℝ) ^ (r₁ + r₂) * (Real.exp u) ^ A_sum) *
            (U_K y * Real.exp (-(Real.pi * Real.exp (2 * u)) * Q_K y)) := by
      refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall (fun y => ?_))
      dsimp only
      have h4 := (h_s4 z u y).1
      have h_neg : -(Real.pi * Real.exp (2 * u)) * Q_K y = -Real.pi * Real.exp (2 * u) * Q_K y := by ring
      rw [h_neg]
      exact h4
    rw [h_congr, MeasureTheory.integral_const_mul]
  have h_y_c : ∀ u : ℝ,
      (∫ y : Fin (NumberField.Units.rank K) → ℝ, G_c (Ψ_K u y)) =
        (Complex.exp (((n : ℝ) * u : ℂ) * z) *
          (((2 : ℝ) ^ (r₁ + r₂) * (Real.exp u) ^ A_sum : ℝ) : ℂ)) *
          J_c (Real.pi * Real.exp (2 * u)) := by
    intro u
    have h_congr : (∫ y : Fin (NumberField.Units.rank K) → ℝ, G_c (Ψ_K u y)) =
        ∫ y : Fin (NumberField.Units.rank K) → ℝ,
          (Complex.exp (((n : ℝ) * u : ℂ) * z) *
            (((2 : ℝ) ^ (r₁ + r₂) * (Real.exp u) ^ A_sum : ℝ) : ℂ)) *
            (((U_K y * Real.exp (-(Real.pi * Real.exp (2 * u)) * Q_K y) : ℝ) : ℂ) *
              Complex.exp
                (((∑ w : NumberField.InfinitePlace K,
                    ν_place w *
                      ∑ i : Fin (NumberField.Units.rank K),
                        y i * Real.log (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K))) : ℝ) *
                  Complex.I)) := by
      refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall (fun y => ?_))
      dsimp only
      have h4 := (h_s4 z u y).2
      have h_neg : -(Real.pi * Real.exp (2 * u)) * Q_K y = -Real.pi * Real.exp (2 * u) * Q_K y := by ring
      rw [h_neg]
      exact h4
    rw [h_congr, MeasureTheory.integral_const_mul]
  let f_re : ℝ → ℝ := fun τ =>
    τ ^ z.re *
      ((2 : ℝ) ^ (r₁ + r₂) * Reg * (τ ^ (1 / (n : ℝ))) ^ A_sum *
        J_maj (Real.pi * τ ^ (2 / (n : ℝ))))
  let f_c : ℝ → ℂ := fun τ =>
    (τ : ℂ) ^ z *
