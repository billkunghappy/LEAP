          star (ψ₀ (J_rep C)) * (∫ y in Cube, (1 : ℂ)) +
          star (ψ₀ (J_rep C)) *
            (∫ y in Cube,
              (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
                (Real.exp (-Real.pi * (b / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                  ∑ w : NumberField.InfinitePlace K,
                    (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                      ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (1 * (2 * y i))) : ℂ))) := by
        intro C
        rw [h_s2 (J_rep C : Ideal R) _ (hc_C_pos C) 1, mul_add]
      simp_rw [h_per_C]
      rw [Finset.sum_add_distrib, ← Finset.sum_mul, h_sum_star, zero_mul, zero_add]
    · simp_rw [h_term2]
      have h_per_C : ∀ C : ClassGroup R,
          ψ₀ (J_rep C) *
            (∫ y in Cube,
              (∑' x : (J_rep C : Ideal R),
