        ((c_gen * C_diff + C_vol) * (Real.log X + 1) ^ (NumberField.Units.rank K)) * Y₀ * δ ^ 2 := by
      rw [hB_def]; ring
    linarith
  have h_ψ_le_δ : |ψ_free Y - M_coeff * Y| ≤
      2 * c * Y₀ * δ +
        (c_gen * C_diff + C_vol) * (Real.log X + 1) ^ (NumberField.Units.rank K) * Y₀ * δ := by
    apply le_of_mul_le_mul_left _ hδ_pos
    calc δ * |ψ_free Y - M_coeff * Y|
      _ ≤ (2 * c + (c_gen * C_diff + C_vol) * (Real.log X + 1) ^ (NumberField.Units.rank K)) * Y₀ * δ ^ 2 :=
          h_δ_ψ_le
      _ = δ * (2 * c * Y₀ * δ +
            (c_gen * C_diff + C_vol) * (Real.log X + 1) ^ (NumberField.Units.rank K) * Y₀ * δ) := by
          ring
  have hu_exp : c' * t / 4 + 1 ≤ Real.exp (c' * t / 4) := Real.add_one_le_exp (c' * t / 4)
  have hu_sq : (c' * t / 4) ^ 2 ≤ Real.exp (c' * t / 2) := by
    have h1 : c' * t / 4 ≤ c' * t / 4 + 1 := by linarith
    have h2 : c' * t / 4 ≤ Real.exp (c' * t / 4) := le_trans h1 hu_exp
    calc (c' * t / 4) ^ 2
      _ = (c' * t / 4) * (c' * t / 4) := sq _
      _ ≤ Real.exp (c' * t / 4) * Real.exp (c' * t / 4) :=
        mul_le_mul h2 h2 (by positivity) (by positivity)
      _ = Real.exp (c' * t / 2) := by
        rw [← Real.exp_add]
        ring_nf
  have hlog_le_exp : Real.log X ≤ (16 / c' ^ 2) * Real.exp (c' * t / 2) := by
    have h1 : (c' ^ 2 / 16) * Real.log X = (c' * t / 4) ^ 2 := by
      rw [← ht_sq]
      ring
    rw [div_mul_eq_mul_div, le_div_iff₀ (by positivity)]
    linarith
  have hexp_half_ge_one : 1 ≤ Real.exp (c' * t / 2) := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by positivity)
  have hlog1_le_K₀_half : Real.log X + 1 ≤ K₀ * Real.exp (c' * t / 2) := by
    rw [hK₀_def]
    linarith
  have hexp_half_le : Real.exp (c' * t / 2) ≤ Real.exp (c' * t) := by
    rw [Real.exp_le_exp]
    have : 0 ≤ c' * t := by positivity
    linarith
  have hlog1_le_K₀ : Real.log X + 1 ≤ K₀ * Real.exp (c' * t) :=
    le_trans hlog1_le_K₀_half (mul_le_mul_of_nonneg_left hexp_half_le (le_of_lt hK₀_pos))
  have hexp_r_eq : (NumberField.Units.rank K : ℝ) * (c' * t) = t / (4 * c) := by
    rw [hc'_def]
    field_simp [hr_ne, hc_ne]
  have hlog1_pow_le :
      (Real.log X + 1) ^ (NumberField.Units.rank K) ≤
        K₀ ^ (NumberField.Units.rank K) * Real.exp (t / (4 * c)) := by
    calc (Real.log X + 1) ^ (NumberField.Units.rank K)
      _ ≤ (K₀ * Real.exp (c' * t)) ^ (NumberField.Units.rank K) :=
        pow_le_pow_left₀ (by positivity) hlog1_le_K₀ (NumberField.Units.rank K)
      _ = K₀ ^ (NumberField.Units.rank K) * (Real.exp (c' * t)) ^ (NumberField.Units.rank K) :=
        mul_pow _ _ _
      _ = K₀ ^ (NumberField.Units.rank K) * Real.exp ((NumberField.Units.rank K : ℝ) * (c' * t)) := by
        rw [← Real.exp_nat_mul]
      _ = K₀ ^ (NumberField.Units.rank K) * Real.exp (t / (4 * c)) := by rw [hexp_r_eq]
  have hexp_combine : Real.exp (t / (4 * c)) * δ = Real.exp (-t / (4 * c)) := by
    rw [hδ_def, ← Real.exp_add]
    congr 1
    field_simp [hc_ne]
    ring
  have h_AC_bound :
      (c_gen * C_diff + C_vol) * (Real.log X + 1) ^ (NumberField.Units.rank K) * Y₀ * δ ≤
      A_diff * Y₀ * Real.exp (-t / (4 * c)) := by
    calc (c_gen * C_diff + C_vol) * (Real.log X + 1) ^ (NumberField.Units.rank K) * Y₀ * δ
      _ = (c_gen * C_diff + C_vol) *
            ((Real.log X + 1) ^ (NumberField.Units.rank K) * (Y₀ * δ)) := by ring
      _ ≤ (c_gen * C_diff + C_vol) *
            ((K₀ ^ (NumberField.Units.rank K) * Real.exp (t / (4 * c))) * (Y₀ * δ)) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_right hlog1_pow_le (by positivity))
            (by positivity)
      _ = A_diff * Y₀ * (Real.exp (t / (4 * c)) * δ) := by rw [hA_diff_def]; ring
      _ = A_diff * Y₀ * Real.exp (-t / (4 * c)) := by rw [hexp_combine]
  have h4c_pos : 0 < 4 * c := by positivity
  have h2c_pos : 0 < 2 * c := by positivity
  have h2c_le_4c : 2 * c ≤ 4 * c := by linarith
  have hδ_le_4c : δ ≤ Real.exp (-t / (4 * c)) := by
    rw [hδ_def, Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg h2c_pos h2c_le_4c
  have h_2c_bound : 2 * c * Y₀ * δ ≤ 2 * c * Y₀ * Real.exp (-t / (4 * c)) :=
    mul_le_mul_of_nonneg_left hδ_le_4c (by positivity)
  have h_ψ_free_bound :
      |ψ_free Y - M_coeff * Y| ≤ (2 * c + A_diff) * Y₀ * Real.exp (-t / (4 * c)) := by
    linarith
  have hexp_4c_le : Real.exp (-t / (4 * c)) ≤ Real.exp (-t / c_free) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg h4c_pos h4c_le_c_free
  have h_final : |ψ_free Y - M_coeff * Y| ≤ c_free * Y₀ * Real.exp (-t / c_free) := by
    calc |ψ_free Y - M_coeff * Y|
      _ ≤ (2 * c + A_diff) * Y₀ * Real.exp (-t / (4 * c)) := h_ψ_free_bound
      _ ≤ (2 * c + A_diff) * Y₀ * Real.exp (-t / c_free) :=
          mul_le_mul_of_nonneg_left hexp_4c_le (by positivity)
      _ = (2 * c + A_diff) * (Y₀ * Real.exp (-t / c_free)) := by ring
      _ ≤ c_free * (Y₀ * Real.exp (-t / c_free)) :=
          mul_le_mul_of_nonneg_right h2c_A_le_c_free (by positivity)
      _ = c_free * Y₀ * Real.exp (-t / c_free) := by ring
  rwa [hψ_free_def Y, hM_coeff_def, hC_vol_def, hY₀_def, ht_def] at h_final

theorem mitsui_principalPrimeIdeals_decoupled_log_cell_bound_of_rank_pos {K : Type u} [Field K] [NumberField K]
    (h_rank : 0 < NumberField.Units.rank K) :
    ∃ c_cell : ℝ, 0 < c_cell ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m →
          ∀ w₀ : NumberField.InfinitePlace K,
            ∀ k : NumberField.InfinitePlace K → Fin m,
              |(∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
                    p.asIdeal.IsPrincipal ∧
                    (Ideal.absNorm p.asIdeal : ℝ) ≤
                      X ^ (Module.finrank ℚ K) *
                        Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
                          (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))},
                  (Nat.card {π : NumberField.RingOfIntegers K //
                      Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧
                      ∀ w : NumberField.InfinitePlace K,
                        Real.log (w (π : K) / w₀ (π : K)) ∈
                          Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                            (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℝ) *
                    Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal))
                - (if (k w₀ : ℕ) + 1 = m then (1 : ℝ) else 0) *
                    ((∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) /
                      ((Module.finrank ℚ K : ℝ) *
                        NumberField.Units.regulator K *
                        (NumberField.classNumber K : ℝ))) *
                    (NumberField.Units.torsionOrder K : ℝ) *
                    (Real.log X / (m : ℝ)) ^ (NumberField.Units.rank K) *
                    (X ^ (Module.finrank ℚ K) *
                      Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
                        (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))))|
                ≤ c_cell * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cell) :=
by
  classical
  obtain ⟨c_gen, hc_gen_pos, hc_gen⟩ := mitsui_decoupled_log_cell_generator_card_bound (K := K)
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_higher_primePower_chebyshev_bound (K := K)
  obtain ⟨c_free, hc_free_pos, hc_free⟩ :=
    mitsui_principalPrimePower_freeUnit_cell_bound_of_rank_pos (K := K) h_rank
  set n : ℕ := Module.finrank ℚ K
  have hn_pos : 0 < n := Module.finrank_pos
  set r : ℕ := NumberField.Units.rank K
  have hr_pos : 0 < r := h_rank
  have hr_rpos : (0 : ℝ) < (r : ℝ) := Nat.cast_pos.mpr hr_pos
  set W : ℝ := (NumberField.Units.torsionOrder K : ℝ)
  have hW_nat_pos : 0 < NumberField.Units.torsionOrder K := NumberField.Units.torsionOrder_pos K
  have hW_pos : 0 < W := by dsimp [W]; exact_mod_cast hW_nat_pos
  set c' : ℝ := 1 / (2 * (r : ℝ) * c₁)
  have hc'_pos : 0 < c' := by dsimp [c']; positivity
  set K₀ : ℝ := 16 / c' ^ 2 + 1
  have hK₀_pos : 0 < K₀ := by dsimp [K₀]; positivity
  set A_hpp : ℝ := c_gen * K₀ ^ r * c₁
  have hA_hpp_pos : 0 < A_hpp := by dsimp [A_hpp]; positivity
  let c_cell : ℝ := A_hpp + W * c_free + 2 * c₁ + c_free
  have hc_cell_pos : 0 < c_cell := by dsimp [c_cell]; positivity
  refine ⟨c_cell, hc_cell_pos, ?_⟩
  intro X hX m hm w₀ k
  set Y₀ : ℝ := X ^ n
  have hX_pos : (0 : ℝ) < X := by linarith
  have hY₀_pos : 0 < Y₀ := by dsimp [Y₀]; positivity
  have hlog_pos : 0 < Real.log X := Real.log_pos hX
  have hm_rpos : (0 : ℝ) < (m : ℝ) := Nat.cast_pos.mpr hm
  set t : ℝ := Real.sqrt (Real.log X)
  have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg _
  have ht_sq : t ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlog_pos)
  set S_exp : ℝ := ∑ w : NumberField.InfinitePlace K,
      (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))
  set Y : ℝ := Y₀ * Real.exp (Real.log X * S_exp)
  by_cases hk₀ : (k w₀ : ℕ) + 1 = m
  · have h_sum_nonpos : S_exp ≤ 0 := by
      refine Finset.sum_nonpos (fun w _ => ?_)
      have hkw_lt : (k w : ℕ) < m := (k w).isLt
      have hkw_le : (k w : ℕ) + 1 ≤ m := hkw_lt
      have hkw_rle : ((k w : ℕ) : ℝ) + 1 ≤ (m : ℝ) := by exact_mod_cast hkw_le
      have hnum_nonpos : ((k w : ℕ) : ℝ) + 1 - (m : ℝ) ≤ 0 := by linarith
      have hdiv_nonpos : (((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ) ≤ 0 :=
        div_nonpos_of_nonpos_of_nonneg hnum_nonpos (le_of_lt hm_rpos)
      have hmult_nonneg : (0 : ℝ) ≤ (w.mult : ℝ) := Nat.cast_nonneg w.mult
      exact mul_nonpos_of_nonneg_of_nonpos hmult_nonneg hdiv_nonpos
    have hexp_arg_nonpos : Real.log X * S_exp ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos (le_of_lt hlog_pos) h_sum_nonpos
    have hexp_le_one : Real.exp (Real.log X * S_exp) ≤ 1 :=
      Real.exp_le_one_iff.mpr hexp_arg_nonpos
    have hY_le_Y₀ : Y ≤ Y₀ := by
      dsimp [Y]
      exact mul_le_of_le_one_right (le_of_lt hY₀_pos) hexp_le_one
    have h_sum_lower : 1 - (n : ℝ) ≤ S_exp := by
      have h_split : S_exp =
          (w₀.mult : ℝ) * ((((k w₀ : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)) +
          ∑ w ∈ Finset.univ.erase w₀,
            (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)) := by
        dsimp [S_exp]
        exact (Finset.add_sum_erase _ _ (Finset.mem_univ w₀)).symm
      have hkw₀_r : ((k w₀ : ℕ) : ℝ) + 1 = (m : ℝ) := by exact_mod_cast hk₀
      have hw₀_term : (w₀.mult : ℝ) * ((((k w₀ : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)) = 0 := by
        rw [hkw₀_r, sub_self, zero_div, mul_zero]
      have h_erase_ge : ∑ w ∈ Finset.univ.erase w₀, (-(w.mult : ℝ)) ≤
          ∑ w ∈ Finset.univ.erase w₀,
            (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)) := by
        refine Finset.sum_le_sum (fun w _ => ?_)
        have hkw_nonneg : (0 : ℝ) ≤ ((k w : ℕ) : ℝ) := Nat.cast_nonneg _
        have hnum_ge : -(m : ℝ) ≤ ((k w : ℕ) : ℝ) + 1 - (m : ℝ) := by linarith
        have hdiv_ge : -1 ≤ (((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ) := by
          rw [le_div_iff₀ hm_rpos]
          linarith
        have hmult_nonneg : (0 : ℝ) ≤ (w.mult : ℝ) := Nat.cast_nonneg w.mult
        have hmul := mul_le_mul_of_nonneg_left hdiv_ge hmult_nonneg
        linarith
      have h_mult_split : (w₀.mult : ℝ) + ∑ w ∈ Finset.univ.erase w₀, (w.mult : ℝ) = (n : ℝ) := by
        rw [Finset.add_sum_erase Finset.univ (fun w : NumberField.InfinitePlace K => (w.mult : ℝ)) (Finset.mem_univ w₀)]
        exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
      have hw₀_mult_pos : 0 < w₀.mult := NumberField.InfinitePlace.mult_pos
      have hw₀_mult_ge_one : (1 : ℝ) ≤ (w₀.mult : ℝ) := by exact_mod_cast hw₀_mult_pos
      rw [Finset.sum_neg_distrib] at h_erase_ge
      linarith
    have hX_le_Y : X ≤ Y := by
      have hY₀_exp : Y₀ = Real.exp ((n : ℝ) * Real.log X) := by
        dsimp [Y₀]
        rw [← Real.exp_log hX_pos, ← Real.exp_nat_mul, Real.exp_log hX_pos]
      have hY_exp : Y = Real.exp ((n : ℝ) * Real.log X + Real.log X * S_exp) := by
        dsimp [Y]
        rw [hY₀_exp, ← Real.exp_add]
      have h_arg_ge : Real.log X ≤ (n : ℝ) * Real.log X + Real.log X * S_exp := by
        have h1 : Real.log X * (1 - (n : ℝ)) ≤ Real.log X * S_exp :=
          mul_le_mul_of_nonneg_left h_sum_lower (le_of_lt hlog_pos)
        linarith
      calc X = Real.exp (Real.log X) := (Real.exp_log hX_pos).symm
        _ ≤ Real.exp ((n : ℝ) * Real.log X + Real.log X * S_exp) := Real.exp_le_exp.mpr h_arg_ge
        _ = Y := hY_exp.symm
    set B : ℝ := c_gen * (Real.log X + 1) ^ r
    have hB₀ : 0 ≤ B := by dsimp [B]; positivity
    have hB : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (ν : ℕ),
        2 ≤ ν →
        (Nat.card {x : NumberField.RingOfIntegers K //
            Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = p.asIdeal ^ ν ∧
            ∀ w : NumberField.InfinitePlace K,
              Real.log (w (x : K) / w₀ (x : K)) ∈
                Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                  (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℝ) ≤ B := by
      intro p ν _hν
      exact hc_gen X hX m hm w₀ k (p.asIdeal ^ ν) (pow_ne_zero ν p.ne_bot)
    let M_free (I : Ideal (NumberField.RingOfIntegers K)) (hI : I.IsPrincipal) : ℕ :=
      Nat.card {e : Fin (NumberField.Units.rank K) → ℤ //
        ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
          Real.log (w ((@Submodule.IsPrincipal.generator _ _ _ _ _ I hI : NumberField.RingOfIntegers K) : K) /
              w₀ ((@Submodule.IsPrincipal.generator _ _ _ _ _ I hI : NumberField.RingOfIntegers K) : K)) +
            ∑ j : Fin (NumberField.Units.rank K),
              (e j : ℝ) *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ∈
            Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
              (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))}
    set S_prime : ℝ := ∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
          p.asIdeal.IsPrincipal ∧
          (Ideal.absNorm p.asIdeal : ℝ) ≤ Y},
        (Nat.card {π : NumberField.RingOfIntegers K //
            Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧
            ∀ w : NumberField.InfinitePlace K,
              Real.log (w (π : K) / w₀ (π : K)) ∈
                Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                  (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℝ) *
          Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal)
    set S_pp : ℝ := ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          1 ≤ pm.2 ∧
          (pm.1.asIdeal ^ pm.2).IsPrincipal ∧
          (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
        (Nat.card {x : NumberField.RingOfIntegers K //
            Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = pm.1.1.asIdeal ^ pm.1.2 ∧
            ∀ w : NumberField.InfinitePlace K,
              Real.log (w (x : K) / w₀ (x : K)) ∈
                Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                  (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℝ) *
          Real.log (Ideal.absNorm pm.1.1.asIdeal)
    set S_free : ℝ := ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          1 ≤ pm.2 ∧
          (pm.1.asIdeal ^ pm.2).IsPrincipal ∧
          (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
        (M_free (pm.1.1.asIdeal ^ pm.1.2) pm.2.2.1 : ℝ) *
          Real.log (Ideal.absNorm pm.1.1.asIdeal)
    set S_high : ℝ := ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y₀},
        Real.log (Ideal.absNorm pm.1.1.asIdeal)
    set M_vol : ℝ :=
      ((∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) /
        ((Module.finrank ℚ K : ℝ) *
          NumberField.Units.regulator K *
          (NumberField.classNumber K : ℝ))) *
      (Real.log X / (m : ℝ)) ^ (NumberField.Units.rank K) *
      Y
    have hS_pp_eq : S_pp = W * S_free := by
      dsimp [S_pp, S_free, W]
      rw [← tsum_mul_left]
      refine tsum_congr (fun pm => ?_)
      have h_card := mitsui_decoupled_log_cell_generator_card_eq_torsionOrder_mul_freeUnit_card
        X hX m hm w₀ k hk₀ (pm.1.1.asIdeal ^ pm.1.2) (pow_ne_zero pm.1.2 pm.1.1.ne_bot) pm.2.2.1
      rw [h_card, Nat.cast_mul, mul_assoc]
    have h_main_eq :
        (if (k w₀ : ℕ) + 1 = m then (1 : ℝ) else 0) *
          ((∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) /
            ((Module.finrank ℚ K : ℝ) *
              NumberField.Units.regulator K *
              (NumberField.classNumber K : ℝ))) *
          (NumberField.Units.torsionOrder K : ℝ) *
          (Real.log X / (m : ℝ)) ^ (NumberField.Units.rank K) *
          Y = W * M_vol := by
      rw [if_pos hk₀]
      dsimp [W, M_vol]
      ring
    have h_tri : |S_prime - W * M_vol| ≤ |S_prime - S_pp| + W * |S_free - M_vol| := by
      have ht1 := abs_sub_le S_prime S_pp (W * M_vol)
