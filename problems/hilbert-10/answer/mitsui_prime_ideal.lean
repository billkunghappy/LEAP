      F m u = (κ * c_m m * (m : ℂ)) * G ((m : ℝ) * u) := by
    intro m u hu
    by_cases hm : m = 0
    · subst hm
      simp [F, c_m, LSeries.term]
    · have hm_pos : 0 < (m : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hm)
