      rw [(hF_norm_supp x hx).2 hx_not_top, (hF_norm_supp y hy).2 hy_not_top]
  let ψ_f : (R ⧸ f) → ℂ := fun a => F (lift_nz a) (hlift_ne a)
  have hψ_span_F : ∀ (x : R) (hx_ne : x ≠ 0),
      F x hx_ne = ψ_f (Ideal.Quotient.mk f x) := by
    intro x hx_ne
    exact h_congr x (lift_nz (Ideal.Quotient.mk f x)) hx_ne (hlift_ne _) (hlift_mk _).symm
  have hψ_span : ∀ (x : R) (hx_ne : x ≠ 0),
      χ₀ (P x hx_ne) * E_log x = ψ_f (Ideal.Quotient.mk f x) * A_ang x := by
    intro x hx_ne
    calc χ₀ (P x hx_ne) * E_log x
      _ = F x hx_ne * A_ang x := by
          dsimp [F]
          exact (inv_mul_cancel_right₀ (hA_ne x hx_ne) (χ₀ (P x hx_ne) * E_log x)).symm
