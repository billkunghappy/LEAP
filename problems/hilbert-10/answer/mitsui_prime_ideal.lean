    2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y}
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊}
  let S_prod : Set (Ideal (NumberField.RingOfIntegers K) × ℕ) :=
    S_id ×ˢ {m : ℕ | m ≤ ⌊Y⌋₊}
  have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Y⌋₊
  have hSprod_fin : S_prod.Finite := hSid_fin.prod (Set.finite_le_nat ⌊Y⌋₊)
  haveI : Finite S_id := hSid_fin
  haveI : Finite S_prod := hSprod_fin
  let f_1 : D_1 → S_id := fun p => ⟨p.1.asIdeal, Nat.le_floor p.2.choose_spec.1⟩
  have hf_1_inj : Function.Injective f_1 := by
    intro a b hab
    apply Subtype.ext
    apply IsDedekindDomain.HeightOneSpectrum.ext
    exact congrArg Subtype.val hab
  haveI : Finite D_1 := Finite.of_injective f_1 hf_1_inj
  letI : Fintype D_1 := Fintype.ofFinite D_1
  let f_ge1 : D_ge1 → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2), h_pm_bounds pm.1.1 pm.1.2 pm.2.1 pm.2.2.choose_spec.1⟩
  have hf_ge1_inj : Function.Injective f_ge1 := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    have h1 := congrArg Prod.fst hval
    have h2 := congrArg Prod.snd hval
    apply Subtype.ext
    apply Prod.ext
    · exact IsDedekindDomain.HeightOneSpectrum.ext h1
    · exact h2
  haveI : Finite D_ge1 := Finite.of_injective f_ge1 hf_ge1_inj
  letI : Fintype D_ge1 := Fintype.ofFinite D_ge1
  let f_ge2 : D_ge2 → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2), h_pm_bounds pm.1.1 pm.1.2 (by have := pm.2.1; omega) pm.2.2⟩
  have hf_ge2_inj : Function.Injective f_ge2 := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    have h1 := congrArg Prod.fst hval
    have h2 := congrArg Prod.snd hval
    apply Subtype.ext
    apply Prod.ext
    · exact IsDedekindDomain.HeightOneSpectrum.ext h1
    · exact h2
  haveI : Finite D_ge2 := Finite.of_injective f_ge2 hf_ge2_inj
  letI : Fintype D_ge2 := Fintype.ofFinite D_ge2
