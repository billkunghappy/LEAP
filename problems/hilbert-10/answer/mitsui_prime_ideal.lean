      rw [h_scale_c]
      have hb_rhs_ratio_pos : 0 < b_RHS / (Ideal.absNorm J_σC : ℝ) := div_pos hb_RHS_pos hNJσC_pos
      rw [← Real.rpow_natCast, ← Real.rpow_mul (le_of_lt hb_rhs_ratio_pos)]
      congr 1; ring
    rw [h_scale_sq, h_scale_c, mul_assoc]
  have h_sum_per_C :
      (∑ C : ClassGroup R,
        star (χ₀ (J_rep C)) *
          (∫ y in Cube,
            (∑' x : (J_rep C : Ideal R),
