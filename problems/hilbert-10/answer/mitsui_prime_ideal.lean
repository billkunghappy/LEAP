    have h_R_inv_both : ∀ (j_r : Fin n), (j_r = j₀ ∨ j_r = p j₀) →
        ∀ (v : Fin n → ℝ) (τ : ℝ), R (fun j => v j - τ * (Pi.single j_r 1 : Fin n → ℝ) j) = R v := by
      intro j_r hj_r v τ
      dsimp [R]
      congr 1
      · congr 1
        refine Finset.prod_congr rfl (fun j _ => ?_)
        by_cases hj : j = j_r
        · subst hj
          rcases hj_r with rfl | rfl
          · rw [hd₀, pow_zero, pow_zero]
          · rw [hdp₀, pow_zero, pow_zero]
        · rw [Pi.single_eq_of_ne hj, mul_zero, sub_zero]
      · refine Finset.prod_congr rfl (fun j hj => ?_)
        have hj_ne_j0 : j ≠ j₀ := Finset.ne_of_mem_erase hj
        by_cases hc1_j : c₁ j = 0
        · rw [hc1_j, pow_zero, pow_zero]
        · obtain ⟨hj_ne_pj0, hpj_ne_j0, hpj_ne_pj0⟩ := hc₀ j hc1_j hj_ne_j0
          have hj_ne_jr : j ≠ j_r := by
            rcases hj_r with rfl | rfl
            · exact hj_ne_j0
            · exact hj_ne_pj0
          have hpj_ne_jr : p j ≠ j_r := by
            rcases hj_r with rfl | rfl
            · exact hpj_ne_j0
            · exact hpj_ne_pj0
          congr 1
          dsimp [Z]
          rw [Pi.single_eq_of_ne hj_ne_jr, Pi.single_eq_of_ne hpj_ne_jr, mul_zero, sub_zero, sub_zero]
    have h_Z_shift_1 : ∀ (v : Fin n → ℝ) (t : ℝ),
        Z (fun j => v j - t * (Pi.single j₀ 1 : Fin n → ℝ) j) j₀ = Z v j₀ - (1 : ℂ) * (t : ℂ) := by
      intro v t
      dsimp [Z]
      rw [Pi.single_eq_same, Pi.single_eq_of_ne hp₀]
      push_cast
      ring
    have h_Z_shift_2 : ∀ (v : Fin n → ℝ) (t : ℝ),
        Z (fun j => v j - t * (Pi.single (p j₀) 1 : Fin n → ℝ) j) j₀ =
        Z v j₀ - ((ε j₀ : ℂ) * Complex.I) * (t : ℂ) := by
      intro v t
      dsimp [Z]
      rw [Pi.single_eq_of_ne hp₀.symm, Pi.single_eq_same]
      push_cast
      ring
    have hε₀_abs : |ε j₀| = 1 := by
      rcases sq_eq_one_iff.mp hε₀ with h | h <;> simp [h]
    have h_Z_rect : ∀ v : Fin n → ℝ,
        Z v j₀ = ((v j₀ : ℝ) : ℂ) + ((ε j₀ * v (p j₀) : ℝ) : ℂ) * Complex.I := by
      intro v
      dsimp [Z]
      push_cast
      ring
    have h_jr_le_1 : ∀ v : Fin n → ℝ, |v j₀| ≤ ‖Z v j₀‖ := by
      intro v
      have h_re : (Z v j₀).re = v j₀ := by
        rw [h_Z_rect v, Complex.add_re, Complex.ofReal_re, Complex.mul_re, Complex.ofReal_re,
          Complex.I_re, mul_zero, Complex.ofReal_im, Complex.I_im, mul_one, sub_zero, add_zero]
      have h_le := Complex.abs_re_le_norm (Z v j₀)
      rwa [h_re] at h_le
    have h_jr_le_2 : ∀ v : Fin n → ℝ, |v (p j₀)| ≤ ‖Z v j₀‖ := by
      intro v
      have h_im : (Z v j₀).im = ε j₀ * v (p j₀) := by
        rw [h_Z_rect v, Complex.add_im, Complex.ofReal_im, zero_add, Complex.mul_im,
          Complex.ofReal_re, Complex.I_im, mul_one, Complex.ofReal_im, Complex.I_re, mul_zero, add_zero]
      have h_le := Complex.abs_im_le_norm (Z v j₀)
      rw [h_im, abs_mul, hε₀_abs, one_mul] at h_le
      exact h_le
    have hc2_norm : ‖(ε j₀ : ℂ) * Complex.I‖ = 1 := by
      rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs, hε₀_abs]
    obtain ⟨h_sum_F1, h_sum_G1, h_eq1⟩ :=
      h_dir_deriv j₀ 1 (h_R_inv_both j₀ (Or.inl rfl)) h_Z_shift_1 h_jr_le_1 norm_one
    obtain ⟨h_sum_F2, h_sum_G2, h_eq2⟩ :=
      h_dir_deriv (p j₀) ((ε j₀ : ℂ) * Complex.I)
        (h_R_inv_both (p j₀) (Or.inr rfl)) h_Z_shift_2 h_jr_le_2 hc2_norm
    
    set w_comb : ℂ := (ε j₀ : ℂ) * Complex.I
    have h_comb_lhs :
        (∑' k : Fin n → ℤ,
          (R (y k) *
            (-(a : ℂ) * 1 * (Z (y k) j₀) ^ (a - 1) +
              (2 * Real.pi : ℂ) * (y k j₀ : ℂ) * (Z (y k) j₀) ^ a) *
            (Real.exp (-Real.pi * ∑ j : Fin n, (y k j) ^ 2) : ℂ) +
          w_comb *
            (R (y k) *
              (-(a : ℂ) * w_comb * (Z (y k) j₀) ^ (a - 1) +
                (2 * Real.pi : ℂ) * (y k (p j₀) : ℂ) * (Z (y k) j₀) ^ a) *
              (Real.exp (-Real.pi * ∑ j : Fin n, (y k j) ^ 2) : ℂ)))) =
        (2 * Real.pi : ℂ) *
          ∑' k : Fin n → ℤ,
            ((((∏ j : Fin n, (y k j) ^ (d_real j) : ℝ) : ℂ) * ∏ j : Fin n, (Z (y k) j) ^ (c' j)) *
            (Real.exp (-Real.pi * ∑ j : Fin n, (y k j) ^ 2) : ℂ)) := by
      rw [← tsum_mul_left]
      refine tsum_congr (fun k => ?_)
      rw [h_poly_c' (y k), pow_succ (Z (y k) j₀) a]
      have hw_sq : w_comb ^ 2 = -1 := by
        dsimp [w_comb]
        have hε₀_C : (ε j₀ : ℂ) ^ 2 = 1 := by exact_mod_cast hε₀
        calc ((ε j₀ : ℂ) * Complex.I) ^ 2
          _ = (ε j₀ : ℂ) ^ 2 * Complex.I ^ 2 := mul_pow _ _ 2
          _ = 1 * (-1) := by rw [hε₀_C, Complex.I_sq]
          _ = -1 := one_mul _
      have h_Z_yk : (y k j₀ : ℂ) + w_comb * (y k (p j₀) : ℂ) = Z (y k) j₀ := rfl
      linear_combination
        -(R (y k) * (a : ℂ) * (Z (y k) j₀) ^ (a - 1) *
          (Real.exp (-Real.pi * ∑ j : Fin n, (y k j) ^ 2) : ℂ)) * hw_sq +
        (R (y k) * (2 * Real.pi : ℂ) * (Z (y k) j₀) ^ a *
          (Real.exp (-Real.pi * ∑ j : Fin n, (y k j) ^ 2) : ℂ)) * h_Z_yk
    have h_comb_rhs :
        (∑' l : Fin n → ℤ,
          (((2 * Real.pi : ℂ) * (-Complex.I) * (ξ l j₀ : ℂ)) *
            Complex.exp (2 * Real.pi * Complex.I * (∑ i : Fin n, u₀ i * (l i : ℝ) : ℂ)) *
            (R (ξ l) * (Z (ξ l) j₀) ^ a) *
            (Real.exp (-Real.pi * ∑ j : Fin n, (ξ l j) ^ 2) : ℂ) +
          w_comb *
            (((2 * Real.pi : ℂ) * (-Complex.I) * (ξ l (p j₀) : ℂ)) *
              Complex.exp (2 * Real.pi * Complex.I * (∑ i : Fin n, u₀ i * (l i : ℝ) : ℂ)) *
              (R (ξ l) * (Z (ξ l) j₀) ^ a) *
              (Real.exp (-Real.pi * ∑ j : Fin n, (ξ l j) ^ 2) : ℂ)))) =
        ((2 * Real.pi : ℂ) * (-Complex.I)) *
          ∑' l : Fin n → ℤ,
            Complex.exp (2 * Real.pi * Complex.I * (∑ i : Fin n, u₀ i * (l i : ℝ) : ℂ)) *
              ((((∏ j : Fin n, (ξ l j) ^ (d_real j) : ℝ) : ℂ) * ∏ j : Fin n, (Z (ξ l) j) ^ (c' j)) *
              (Real.exp (-Real.pi * ∑ j : Fin n, (ξ l j) ^ 2) : ℂ)) := by
      rw [← tsum_mul_left]
      refine tsum_congr (fun l => ?_)
      rw [h_poly_c' (ξ l), pow_succ (Z (ξ l) j₀) a]
      have h_Z_ξl : (ξ l j₀ : ℂ) + w_comb * (ξ l (p j₀) : ℂ) = Z (ξ l) j₀ := rfl
      linear_combination
        ((2 * Real.pi : ℂ) * (-Complex.I) *
          Complex.exp (2 * Real.pi * Complex.I * (∑ i : Fin n, u₀ i * (l i : ℝ) : ℂ)) *
          (R (ξ l) * (Z (ξ l) j₀) ^ a) *
          (Real.exp (-Real.pi * ∑ j : Fin n, (ξ l j) ^ 2) : ℂ)) * h_Z_ξl
    have h_tsum_lhs := (h_sum_F1.tsum_add (h_sum_F2.mul_left w_comb)).symm
    rw [tsum_mul_left] at h_tsum_lhs
    have h_tsum_rhs := (h_sum_G1.tsum_add (h_sum_G2.mul_left w_comb)).symm
    rw [tsum_mul_left] at h_tsum_rhs
    have h_total :
        (2 * Real.pi : ℂ) *
          ∑' k : Fin n → ℤ,
            ((((∏ j : Fin n, (y k j) ^ (d_real j) : ℝ) : ℂ) * ∏ j : Fin n, (Z (y k) j) ^ (c' j)) *
            (Real.exp (-Real.pi * ∑ j : Fin n, (y k j) ^ 2) : ℂ)) =
        (2 * Real.pi : ℂ) *
          (((-Complex.I) ^ ((∑ j : Fin n, d_real j) + (∑ j : Fin n, c' j)) *
            ((|A.det|⁻¹ : ℝ) : ℂ)) *
            ∑' l : Fin n → ℤ,
              Complex.exp (2 * Real.pi * Complex.I * (∑ i : Fin n, u₀ i * (l i : ℝ) : ℂ)) *
                ((((∏ j : Fin n, (ξ l j) ^ (d_real j) : ℝ) : ℂ) * ∏ j : Fin n, (Z (ξ l) j) ^ (c' j)) *
                (Real.exp (-Real.pi * ∑ j : Fin n, (ξ l j) ^ 2) : ℂ))) := by
      rw [← h_comb_lhs, ← h_tsum_lhs, h_eq1, h_eq2, ← mul_left_comm C_const w_comb,
        ← mul_add, h_tsum_rhs, h_comb_rhs, h_sum_c', ← add_assoc, pow_succ]
      dsimp [C_const]
      ring
    have h2pi_ne : (2 * Real.pi : ℂ) ≠ 0 :=
      mul_ne_zero (by norm_num) (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero)
    exact mul_left_cancel₀ h2pi_ne h_total
  
  have hc_disj : ∀ j₁ j₂ : Fin n, d_cplx j₁ ≠ 0 → d_cplx j₂ ≠ 0 → j₁ ≠ j₂ →
      j₁ ≠ p j₂ ∧ p j₁ ≠ j₂ ∧ p j₁ ≠ p j₂ := by
    intro j₁ j₂ h1 h2 hne
    refine ⟨?_, ?_, ?_⟩
    · intro h_eq
      have hp2 := (hd_cplx_supp j₂ h2).2.2.2
      rw [← h_eq] at hp2
      exact h1 hp2
    · intro h_eq
      have hp1 := (hd_cplx_supp j₁ h1).2.2.2
      rw [h_eq] at hp1
      exact h2 hp1
    · intro h_eq
      have h_inv := congrArg p h_eq
      rw [hp_inv j₁, hp_inv j₂] at h_inv
      exact hne h_inv
  
  have h_ind : ∀ (m : ℕ) (c₁ : Fin n → ℕ),
      (∀ j : Fin n, c₁ j ≤ d_cplx j) →
      (∑ j : Fin n, c₁ j) = m →
      ∀ u₀ : Fin n → ℝ,
        (∑' k : Fin n → ℤ,
          ((((∏ j : Fin n, (A.mulVec (fun i => u₀ i + (k i : ℝ)) j) ^ (d_real j) : ℝ) : ℂ) *
            ∏ j : Fin n, (Z (A.mulVec (fun i => u₀ i + (k i : ℝ))) j) ^ (c₁ j)) *
          (Real.exp (-Real.pi *
            ∑ j : Fin n, (A.mulVec (fun i => u₀ i + (k i : ℝ)) j) ^ 2) : ℂ))) =
          ((-Complex.I) ^ ((∑ j : Fin n, d_real j) + (∑ j : Fin n, c₁ j)) *
            ((|A.det|⁻¹ : ℝ) : ℂ)) *
            ∑' l : Fin n → ℤ,
              Complex.exp (2 * Real.pi * Complex.I *
                (∑ i : Fin n, u₀ i * (l i : ℝ) : ℂ)) *
                ((((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d_real j) : ℝ) : ℂ) *
                  ∏ j : Fin n, (Z (A.transpose⁻¹.mulVec (fun i => (l i : ℝ))) j) ^ (c₁ j)) *
                (Real.exp (-Real.pi *
                  ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ)) := by
    intro m
    induction' m with m ih
    · intro c₁ _hc₁ hm u₀
      have hc₀_all : ∀ j : Fin n, c₁ j = 0 := by
        intro j
        exact Finset.sum_eq_zero_iff.mp hm j (Finset.mem_univ j)
      have h_lhs0 :
          (∑' k : Fin n → ℤ,
            ((((∏ j : Fin n, (A.mulVec (fun i => u₀ i + (k i : ℝ)) j) ^ (d_real j) : ℝ) : ℂ) *
              ∏ j : Fin n, (Z (A.mulVec (fun i => u₀ i + (k i : ℝ))) j) ^ (c₁ j)) *
            (Real.exp (-Real.pi *
              ∑ j : Fin n, (A.mulVec (fun i => u₀ i + (k i : ℝ)) j) ^ 2) : ℂ))) =
          ∑' k : Fin n → ℤ,
            (((∏ j : Fin n, (A.mulVec (fun i => u₀ i + (k i : ℝ)) j) ^ (d_real j) : ℝ) : ℂ) *
            (Real.exp (-Real.pi *
              ∑ j : Fin n, (A.mulVec (fun i => u₀ i + (k i : ℝ)) j) ^ 2) : ℂ)) := by
        refine tsum_congr (fun k => ?_)
        have hp : (∏ j : Fin n, (Z (A.mulVec (fun i => u₀ i + (k i : ℝ))) j) ^ (c₁ j)) = 1 := by
          refine Finset.prod_eq_one (fun j _ => ?_)
          rw [hc₀_all j, pow_zero]
        rw [hp, mul_one]
      have h_rhs0 :
          (∑' l : Fin n → ℤ,
            Complex.exp (2 * Real.pi * Complex.I *
              (∑ i : Fin n, u₀ i * (l i : ℝ) : ℂ)) *
              ((((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d_real j) : ℝ) : ℂ) *
                ∏ j : Fin n, (Z (A.transpose⁻¹.mulVec (fun i => (l i : ℝ))) j) ^ (c₁ j)) *
              (Real.exp (-Real.pi *
                ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ))) =
          ∑' l : Fin n → ℤ,
            Complex.exp (2 * Real.pi * Complex.I *
              (∑ i : Fin n, u₀ i * (l i : ℝ) : ℂ)) *
              (((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d_real j) : ℝ) : ℂ) *
              (Real.exp (-Real.pi *
                ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ)) := by
        refine tsum_congr (fun l => ?_)
        have hp : (∏ j : Fin n, (Z (A.transpose⁻¹.mulVec (fun i => (l i : ℝ))) j) ^ (c₁ j)) = 1 := by
          refine Finset.prod_eq_one (fun j _ => ?_)
          rw [hc₀_all j, pow_zero]
        rw [hp, mul_one]
      rw [h_lhs0, h_rhs0, hm, add_zero]
      exact h_base u₀
    · intro c₁ hc₁_le hm u₀
      have h_ne : (∑ j ∈ Finset.univ, c₁ j) ≠ 0 := by omega
      obtain ⟨j₀, _, hj₀_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero h_ne
      have hd_cplx_j₀ : d_cplx j₀ ≠ 0 := by
        have := hc₁_le j₀
        omega
      let c₀ : Fin n → ℕ := Function.update c₁ j₀ (c₁ j₀ - 1)
      have hc₀_le : ∀ j : Fin n, c₀ j ≤ d_cplx j := by
        intro j
        by_cases hj : j = j₀
        · subst hj
          dsimp [c₀]
          rw [Function.update_self]
          have := hc₁_le j
          omega
        · dsimp [c₀]
          rw [Function.update_of_ne hj]
          exact hc₁_le j
      have h_upd : Function.update c₀ j₀ (c₀ j₀ + 1) = c₁ := by
        ext j
        by_cases hj : j = j₀
        · subst hj
          dsimp [c₀]
          rw [Function.update_self, Function.update_self]
          omega
        · dsimp [c₀]
          rw [Function.update_of_ne hj, Function.update_of_ne hj]
      have hm₀ : (∑ j : Fin n, c₀ j) = m := by
        have h1 := (Finset.add_sum_erase Finset.univ c₀ (Finset.mem_univ j₀)).symm
        have h2 := (Finset.add_sum_erase Finset.univ c₁ (Finset.mem_univ j₀)).symm
        have h_er : (∑ j ∈ Finset.univ.erase j₀, c₀ j) = ∑ j ∈ Finset.univ.erase j₀, c₁ j := by
          refine Finset.sum_congr rfl (fun j hj => ?_)
          dsimp [c₀]
          exact Function.update_of_ne (Finset.ne_of_mem_erase hj) (c₁ j₀ - 1) c₁
        have hc₀_j0 : c₀ j₀ = c₁ j₀ - 1 := Function.update_self j₀ (c₁ j₀ - 1) c₁
        rw [h2] at hm
        rw [h1, h_er, hc₀_j0]
        omega
      have hc₀_disj : ∀ j : Fin n, c₀ j ≠ 0 → j ≠ j₀ → j ≠ p j₀ ∧ p j ≠ j₀ ∧ p j ≠ p j₀ := by
        intro j hj_ne hj_ne_j0
        have hd_cplx_j : d_cplx j ≠ 0 := by
          have := hc₀_le j
          omega
        exact hc_disj j j₀ hd_cplx_j hd_cplx_j₀ hj_ne_j0
      obtain ⟨hp₀, hdr₀, hdr_p₀, _⟩ := hd_cplx_supp j₀ hd_cplx_j₀
      rw [← h_upd]
      exact h_s3 c₀ j₀ hp₀ (hε_sq j₀) hdr₀ hdr_p₀ hc₀_disj (ih c₀ hc₀_le hm₀) u₀
  exact h_ind (∑ j : Fin n, d_cplx j) d_cplx (fun j => le_rfl) rfl u

theorem mitsui_shifted_ideal_lattice_grossenchar_harmonic_poisson_summation {K : Type u} [Field K] [NumberField K]
    (M J_star : Ideal (NumberField.RingOfIntegers K)) (hM : M ≠ 0) (hJ_star : J_star ≠ 0)
    (γ : NumberField.RingOfIntegers K) (hγ : γ ≠ 0)
    (h_dual : differentIdeal ℤ (NumberField.RingOfIntegers K) * M * J_star =
      Ideal.span ({γ} : Set (NumberField.RingOfIntegers K)))
    (l_eff : NumberField.InfinitePlace K → ℤ)
    (hl_eff_real : ∀ w : NumberField.InfinitePlace K, w.IsReal → (l_eff w = 0 ∨ l_eff w = 1))
    (α : NumberField.RingOfIntegers K)
    (t : NumberField.InfinitePlace K → ℝ) (ht : ∀ w : NumberField.InfinitePlace K, 0 < t w) :
    let R := NumberField.RingOfIntegers K
    let D : ℝ := |(NumberField.discr K : ℝ)|
    let a_place : NumberField.InfinitePlace K → ℕ := fun w => (l_eff w).natAbs
    Summable (fun m : M =>
      (∏ w : NumberField.InfinitePlace K,
        (w ((α + m.1 : R) : K) * (t w) ^ (1 / 2 : ℝ)) ^ (a_place w)) *
      Real.exp (-Real.pi *
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * t w * (w ((α + m.1 : R) : K)) ^ 2)) ∧
    Summable (fun x_star : J_star =>
      (∏ w : NumberField.InfinitePlace K,
        ((w ((x_star.1 : R) : K) / w (γ : K)) * (t w) ^ (-1 / 2 : ℝ)) ^ (a_place w)) *
      Real.exp (-Real.pi *
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (t w)⁻¹ * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2)) ∧
    (∑' m : M,
      (∏ w : NumberField.InfinitePlace K,
        ((if 0 ≤ l_eff w then w.embedding ((α + m.1 : R) : K) else star (w.embedding ((α + m.1 : R) : K))) *
          (((t w) ^ (1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) *
      (Real.exp (-Real.pi *
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * t w * (w ((α + m.1 : R) : K)) ^ 2) : ℂ)) =
      ((-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
        (∏ w : NumberField.InfinitePlace K,
          (w.embedding (γ : K) / (w (γ : K) : ℂ)) ^ (l_eff w)) *
        (((D ^ (1 / 2 : ℝ) * (Ideal.absNorm M : ℝ) *
            ∏ w : NumberField.InfinitePlace K, (t w) ^ ((w.mult : ℝ) / 2))⁻¹ : ℝ) : ℂ)) *
        ∑' x_star : J_star,
          Complex.exp (2 * Real.pi * Complex.I *
            (Algebra.trace ℚ K ((α : K) * (x_star.1 : K) / (γ : K)) : ℂ)) *
            (∏ w : NumberField.InfinitePlace K,
              ((star (if 0 ≤ l_eff w then w.embedding ((x_star.1 : R) : K) else star (w.embedding ((x_star.1 : R) : K))) /
                (w (γ : K) : ℂ)) *
                (((t w) ^ (-1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) *
            (Real.exp (-Real.pi *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (t w)⁻¹ * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2) : ℂ) :=
by
  intro R D a_place
  set n : ℕ := Module.finrank ℚ K
  obtain ⟨v₁, v₂, e₁, e₂, u, h_lin₁, h_lin₂, h_tr, h_dual_v, h_det⟩ :=
    mitsui_shifted_ideal_lattice_trace_dual_zbasis_and_det M J_star hM hJ_star γ hγ h_dual α
  have hD_pos : 0 < D := by
    dsimp [D]
    exact abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  have hM_bot : M ≠ ⊥ := hM
  have hNM_pos : 0 < (Ideal.absNorm M : ℝ) := by
    exact_mod_cast Nat.pos_of_ne_zero (Ideal.absNorm_eq_zero_iff.not.mpr hM_bot)
  set Δ : ℝ := D ^ (1 / 2 : ℝ) * (Ideal.absNorm M : ℝ)
  have hΔ_pos : 0 < Δ := by dsimp [Δ]; positivity
  have hΔ_sq : Δ ^ 2 = D * (Ideal.absNorm M : ℝ) ^ 2 := by
    dsimp [Δ]
    rw [mul_pow, ← Real.rpow_natCast (D ^ (1 / 2 : ℝ)) 2, ← Real.rpow_mul (le_of_lt hD_pos)]
    norm_num
  have hγ_K : (γ : K) ≠ 0 := by exact_mod_cast hγ
  obtain ⟨A, d_real, d_cplx, p, ε, hA_ne, hA_det, hd_real, hε_sq, hp_inv, hd_cplx_supp,
      hd_sum, hP_norm, hP_cplx, hP_quad, hD_norm, hD_cplx, hD_quad⟩ :=
    mitsui_infinitePlace_grossenchar_harmonic_euclidean_trace_duality
      (fun i => (v₁ i : K)) (fun i => (v₂ i : K)) (γ : K) hγ_K
      Δ hΔ_pos h_dual_v (h_det.trans hΔ_sq.symm) l_eff hl_eff_real t ht
  have h_gauss_sum : ∀ (B : Matrix (Fin n) (Fin n) ℝ), B.det ≠ 0 → ∀ (v : Fin n → ℝ),
      Summable (fun k : Fin n → ℤ =>
        Real.exp (-Real.pi *
          ∑ j : Fin n, (B.mulVec (fun i => v i + (k i : ℝ)) j) ^ 2)) := by
    intro B hB v
    have h0 := (mitsui_matrix_shifted_harmonic_gaussian_poisson_summation
      n B hB v (fun _ => 0) (fun _ => Nat.zero_le 1)).1
    refine h0.congr (fun k => ?_)
    simp
  have h_base : ∀ (u' : Fin n → ℝ),
      (∑' k : Fin n → ℤ,
        (((∏ j : Fin n, (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ (d_real j) : ℝ) : ℂ) *
        (Real.exp (-Real.pi *
          ∑ j : Fin n, (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ 2) : ℂ))) =
        ((-Complex.I) ^ (∑ j : Fin n, d_real j) *
          ((|A.det|⁻¹ : ℝ) : ℂ)) *
          ∑' l : Fin n → ℤ,
            Complex.exp (2 * Real.pi * Complex.I *
              (∑ i : Fin n, u' i * (l i : ℝ) : ℂ)) *
              (((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d_real j) : ℝ) : ℂ) *
              (Real.exp (-Real.pi *
                ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ)) :=
    fun u' => (mitsui_matrix_shifted_harmonic_gaussian_poisson_summation n A hA_ne u' d_real hd_real).2.2
  obtain ⟨h_sum_k, h_sum_l, h_poisson⟩ :=
    mitsui_matrix_involution_harmonic_gaussian_degree_extension_of_real_base
      n A hA_ne (fun i => (u i : ℝ)) d_real d_cplx p ε
      hd_real hε_sq hp_inv hd_cplx_supp h_gauss_sum h_base
  set S₂ : ℝ := (Real.sqrt 2) ^ (∑ j : Fin n, d_cplx j)
  have hS₂_pos : 0 < S₂ := by dsimp [S₂]; positivity
  have hS₂_ne : S₂ ≠ 0 := ne_of_gt hS₂_pos
  have hS₂_C_ne : (S₂ : ℂ) ≠ 0 := by exact_mod_cast hS₂_ne
  have hq_cast : ∀ k : Fin n → ℤ,
      (fun i : Fin n => ((u i + (k i : ℚ) : ℚ) : ℝ)) = (fun i : Fin n => (u i : ℝ) + (k i : ℝ)) := by
    intro k
    ext i
    push_cast
    rfl
  have hP_norm_k : ∀ k : Fin n → ℤ,
      S₂ * (∏ w : NumberField.InfinitePlace K,
        (w ((α + (e₁ k).1 : R) : K) * (t w) ^ (1 / 2 : ℝ)) ^ (a_place w)) =
      (∏ j : Fin n, |A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) j| ^ (d_real j)) *
      (∏ j : Fin n,
        ‖((A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) j : ℝ) : ℂ) +
          (ε j : ℂ) * Complex.I * ((A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) (p j) : ℝ) : ℂ)‖ ^ (d_cplx j)) := by
    intro k
    rw [h_lin₁ k, ← hP_norm (fun i => u i + (k i : ℚ)), hq_cast k]
  have hP_cplx_k : ∀ k : Fin n → ℤ,
      (S₂ : ℂ) * (∏ w : NumberField.InfinitePlace K,
        ((if 0 ≤ l_eff w then w.embedding ((α + (e₁ k).1 : R) : K) else star (w.embedding ((α + (e₁ k).1 : R) : K))) *
          (((t w) ^ (1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) =
      (((∏ j : Fin n, (A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) j) ^ (d_real j) : ℝ) : ℂ) *
      (∏ j : Fin n,
        (((A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) j : ℝ) : ℂ) +
          (ε j : ℂ) * Complex.I * ((A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) (p j) : ℝ) : ℂ)) ^ (d_cplx j))) := by
    intro k
    rw [h_lin₁ k, ← hP_cplx (fun i => u i + (k i : ℚ)), hq_cast k]
  have hP_quad_k : ∀ k : Fin n → ℤ,
      (∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * t w * (w ((α + (e₁ k).1 : R) : K)) ^ 2) =
      ∑ j : Fin n, (A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) j) ^ 2 := by
    intro k
    rw [h_lin₁ k, hP_quad (fun i => u i + (k i : ℚ)), hq_cast k]
  have hD_norm_l : ∀ l : Fin n → ℤ,
      S₂ * (∏ w : NumberField.InfinitePlace K,
        ((w (((e₂ l).1 : R) : K) / w (γ : K)) * (t w) ^ (-1 / 2 : ℝ)) ^ (a_place w)) =
      (∏ j : Fin n, |A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j| ^ (d_real j)) *
      (∏ j : Fin n,
        ‖((A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j : ℝ) : ℂ) +
          (ε j : ℂ) * Complex.I * ((A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) (p j) : ℝ) : ℂ)‖ ^ (d_cplx j)) := by
    intro l
    rw [h_lin₂ l, ← hD_norm l]
  have hD_cplx_l : ∀ l : Fin n → ℤ,
      (((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d_real j) : ℝ) : ℂ) *
      (∏ j : Fin n,
        (((A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j : ℝ) : ℂ) +
          (ε j : ℂ) * Complex.I * ((A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) (p j) : ℝ) : ℂ)) ^ (d_cplx j))) =
      (S₂ : ℂ) *
      (∏ w : NumberField.InfinitePlace K,
        (w.embedding (γ : K) / (w (γ : K) : ℂ)) ^ (l_eff w)) *
      (∏ w : NumberField.InfinitePlace K,
        ((star (if 0 ≤ l_eff w then w.embedding (((e₂ l).1 : R) : K) else star (w.embedding (((e₂ l).1 : R) : K))) /
          (w (γ : K) : ℂ)) *
          (((t w) ^ (-1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) := by
    intro l
    rw [h_lin₂ l, ← hD_cplx l]
  have hD_quad_l : ∀ l : Fin n → ℤ,
      (∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * (t w)⁻¹ * (w (((e₂ l).1 : R) : K) / w (γ : K)) ^ 2) =
      ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2 := by
    intro l
    rw [h_lin₂ l, hD_quad l]
  have h_tr_l : ∀ l : Fin n → ℤ,
      (Algebra.trace ℚ K ((α : K) * (((e₂ l).1 : R) : K) / (γ : K)) : ℂ) =
      (∑ i : Fin n, (u i : ℝ) * (l i : ℝ) : ℂ) := by
    intro l
    rw [h_tr l]
    push_cast
    rfl
  have h_summable_M : Summable (fun m : M =>
      (∏ w : NumberField.InfinitePlace K,
        (w ((α + m.1 : R) : K) * (t w) ^ (1 / 2 : ℝ)) ^ (a_place w)) *
      Real.exp (-Real.pi *
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * t w * (w ((α + m.1 : R) : K)) ^ 2)) := by
    rw [← e₁.summable_iff]
    refine (h_sum_k.mul_left S₂⁻¹).congr (fun k => ?_)
    dsimp [Function.comp]
    rw [← mul_assoc, ← hP_norm_k k, ← hP_quad_k k, inv_mul_cancel_left₀ hS₂_ne]
  have h_summable_J : Summable (fun x_star : J_star =>
      (∏ w : NumberField.InfinitePlace K,
        ((w ((x_star.1 : R) : K) / w (γ : K)) * (t w) ^ (-1 / 2 : ℝ)) ^ (a_place w)) *
      Real.exp (-Real.pi *
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (t w)⁻¹ * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2)) := by
    rw [← e₂.summable_iff]
    refine (h_sum_l.mul_left S₂⁻¹).congr (fun l => ?_)
    dsimp [Function.comp]
    rw [← mul_assoc, ← hD_norm_l l, ← hD_quad_l l, inv_mul_cancel_left₀ hS₂_ne]
  refine ⟨h_summable_M, h_summable_J, ?_⟩
  apply mul_left_cancel₀ hS₂_C_ne
  have h_lhs :
      (S₂ : ℂ) * (∑' m : M,
        (∏ w : NumberField.InfinitePlace K,
          ((if 0 ≤ l_eff w then w.embedding ((α + m.1 : R) : K) else star (w.embedding ((α + m.1 : R) : K))) *
            (((t w) ^ (1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) *
        (Real.exp (-Real.pi *
          ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * t w * (w ((α + m.1 : R) : K)) ^ 2) : ℂ)) =
      (∑' k : Fin n → ℤ,
        (((∏ j : Fin n, (A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) j) ^ (d_real j) : ℝ) : ℂ) *
        (∏ j : Fin n,
          (((A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) j : ℝ) : ℂ) +
            (ε j : ℂ) * Complex.I * ((A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) (p j) : ℝ) : ℂ)) ^ (d_cplx j)) *
        (Real.exp (-Real.pi *
          ∑ j : Fin n, (A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) j) ^ 2) : ℂ))) := by
    rw [← Equiv.tsum_eq e₁, ← tsum_mul_left]
    refine tsum_congr (fun k => ?_)
    rw [← mul_assoc, hP_cplx_k k, hP_quad_k k]
  set sgn_γ : ℂ := ∏ w : NumberField.InfinitePlace K,
    (w.embedding (γ : K) / (w (γ : K) : ℂ)) ^ (l_eff w)
  have h_rhs_tsum :
      (∑' l : Fin n → ℤ,
        Complex.exp (2 * Real.pi * Complex.I *
          (∑ i : Fin n, (u i : ℝ) * (l i : ℝ) : ℂ)) *
          (((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d_real j) : ℝ) : ℂ) *
          (∏ j : Fin n,
            (((A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j : ℝ) : ℂ) +
              (ε j : ℂ) * Complex.I * ((A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) (p j) : ℝ) : ℂ)) ^ (d_cplx j)) *
          (Real.exp (-Real.pi *
            ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ))) =
      (S₂ : ℂ) * sgn_γ *
        ∑' x_star : J_star,
          Complex.exp (2 * Real.pi * Complex.I *
            (Algebra.trace ℚ K ((α : K) * (x_star.1 : K) / (γ : K)) : ℂ)) *
            (∏ w : NumberField.InfinitePlace K,
              ((star (if 0 ≤ l_eff w then w.embedding ((x_star.1 : R) : K) else star (w.embedding ((x_star.1 : R) : K))) /
                (w (γ : K) : ℂ)) *
                (((t w) ^ (-1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) *
            (Real.exp (-Real.pi *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (t w)⁻¹ * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2) : ℂ) := by
    rw [← Equiv.tsum_eq e₂, ← tsum_mul_left]
    refine tsum_congr (fun l => ?_)
    rw [hD_cplx_l l, ← h_tr_l l, ← hD_quad_l l]
    dsimp [sgn_γ]
    ring
  rw [h_lhs, h_poisson, h_rhs_tsum, hd_sum, hA_det]
  dsimp [Δ, sgn_γ]
  ring

theorem mitsui_grossenchar_generator_unitLog_shift_cube_integral_eq {K : Type u} [Field K] [NumberField K]
    (f J_star : Ideal (NumberField.RingOfIntegers K))
    (γ : NumberField.RingOfIntegers K) (hγ : γ ≠ 0)
    (l_eff : NumberField.InfinitePlace K → ℤ)
    (v_place : NumberField.InfinitePlace K → ℝ)
    (hv_sum : (∑ w : NumberField.InfinitePlace K, v_place w) = 0)
    (ψ_f : (NumberField.RingOfIntegers K ⧸ f) → ℂ)
    (hψ_mul : ∀ a b : NumberField.RingOfIntegers K ⧸ f, ψ_f (a * b) = ψ_f a * ψ_f b)
    (hψ_units : ∀ u : (NumberField.RingOfIntegers K)ˣ,
      ψ_f (Ideal.Quotient.mk f (u : NumberField.RingOfIntegers K)) *
        (∏ w : NumberField.InfinitePlace K,
          (w.embedding ((u : NumberField.RingOfIntegers K) : K) /
            (w ((u : NumberField.RingOfIntegers K) : K) : ℂ)) ^ (l_eff w)) =
        Complex.exp (((∑ w : NumberField.InfinitePlace K,
          v_place w * Real.log (w ((u : NumberField.RingOfIntegers K) : K))) : ℝ) * Complex.I))
    (c : ℝ) (hc : 0 < c) :
    let R := NumberField.RingOfIntegers K
    let n : ℕ := Module.finrank ℚ K
    let r : ℕ := NumberField.Units.rank K
    let a_place : NumberField.InfinitePlace K → ℕ := fun w => (l_eff w).natAbs
    let Cube : Set (Fin r → ℝ) := Set.pi Set.univ (fun _ => Set.Ico (0 : ℝ) 1)
    let N_γ : ℝ := (Ideal.absNorm (Ideal.span ({γ} : Set R)) : ℝ)
    (∫ y in Cube,
      (∑' x_star : J_star,
        star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
          (∏ w : NumberField.InfinitePlace K,
            ((star (if 0 ≤ l_eff w then w.embedding ((x_star.1 : R) : K) else star (w.embedding ((x_star.1 : R) : K))) /
              (w (γ : K) : ℂ)) *
              ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) *
          (((c ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
            Real.exp (-Real.pi * c ^ 2 *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2 *
                  ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ)) *
          (Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (γ : K))) : ℝ) * Complex.I) *
            Complex.exp
              (((∑ w : NumberField.InfinitePlace K,
                  v_place w *
                    ∑ i : Fin r,
                      y i * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) : ℝ) *
                Complex.I)))) =
    (∫ y in Cube,
      (∑' x_star : J_star,
        star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
          (∏ w : NumberField.InfinitePlace K,
            (star (if 0 ≤ l_eff w then w.embedding ((x_star.1 : R) : K) else star (w.embedding ((x_star.1 : R) : K))) *
              ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) *
          ((((c * N_γ ^ (-1 / (n : ℝ))) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
            Real.exp (-Real.pi * (c * N_γ ^ (-1 / (n : ℝ))) ^ 2 *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
                  ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ)) *
          Complex.exp
            (((∑ w : NumberField.InfinitePlace K,
                v_place w *
                  ∑ i : Fin r,
                    y i * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) : ℝ) *
              Complex.I))) :=
by
  classical
  intro R n r a_place Cube N_γ
  let ε : Fin r → Rˣ := NumberField.Units.fundSystem K
  have hw_ε_pos : ∀ (w : NumberField.InfinitePlace K) (i : Fin r),
      0 < w ((ε i : R) : K) := by
    intro w i
    exact w.pos_iff.mpr (NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero (ε i)))
  have hγ_coe : (γ : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hγ
  have hw_γ_pos : ∀ w : NumberField.InfinitePlace K, 0 < w (γ : K) :=
    fun w => w.pos_iff.mpr hγ_coe
  have hNγ_pos : 0 < N_γ := by
    dsimp [N_γ]
    have h_span_ne : Ideal.span ({γ} : Set R) ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr hγ
    exact_mod_cast Nat.pos_of_ne_zero (Ideal.absNorm_eq_zero_iff.not.mpr h_span_ne)
  have hn_pos : (0 : ℝ) < (n : ℝ) := by
    dsimp [n]
    exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
  have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  
  let B_R : Module.Basis (Fin r) ℝ (NumberField.Units.dirichletUnitTheorem.logSpace K) :=
    Module.Basis.ofZLatticeBasis ℝ
      (NumberField.Units.unitLattice K)
      (NumberField.Units.basisUnitLattice K)
  let S_γ : ℝ := ∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * Real.log (v (γ : K))
  let ℓ_γ : NumberField.InfinitePlace K → ℝ :=
    fun w => Real.log (w (γ : K)) - S_γ / (n : ℝ)
  let L_vec : NumberField.Units.dirichletUnitTheorem.logSpace K :=
    fun w => (w.1.mult : ℝ) * ℓ_γ w.1
  let v_γ : Fin r → ℝ := fun j => B_R.repr L_vec j
  let r_γ : NumberField.InfinitePlace K → ℝ :=
    fun v => ∑ j : Fin r, v_γ j * Real.log (v ((ε j : R) : K))
  let w_dir : NumberField.InfinitePlace K := NumberField.Units.dirichletUnitTheorem.w₀
  have h_ne_dir : ∀ v : NumberField.InfinitePlace K, v ≠ w_dir →
      (v.mult : ℝ) * ℓ_γ v = (v.mult : ℝ) * r_γ v := by
    intro v hv
    let v_sub : {v : NumberField.InfinitePlace K // v ≠ w_dir} := ⟨v, hv⟩
    have h_basis := congr_fun (Module.Basis.sum_repr B_R L_vec).symm v_sub
    change (v.mult : ℝ) * ℓ_γ v = (∑ j : Fin r, (v_γ j) • B_R j) v_sub at h_basis
    rw [h_basis]
    have h_eval : (∑ j : Fin r, (v_γ j) • B_R j) v_sub =
        ∑ j : Fin r, v_γ j * (B_R j v_sub) := by
      simp [Finset.sum_apply]
    rw [h_eval]
    dsimp [r_γ]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    have hB_j : B_R j v_sub = (v.mult : ℝ) * Real.log (v ((ε j : R) : K)) := by
      dsimp [B_R, ε]
      rw [Module.Basis.ofZLatticeBasis_apply, ← NumberField.Units.logEmbedding_fundSystem,
        NumberField.Units.dirichletUnitTheorem.logEmbedding_component]
    rw [hB_j]
    ring
  have h_sum_mult : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ)) = (n : ℝ) := by
    dsimp [n]
    exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
  have h_sum_ℓ : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * ℓ_γ v) = 0 := by
    dsimp [ℓ_γ]
    simp_rw [mul_sub]
    rw [Finset.sum_sub_distrib, ← Finset.sum_mul, h_sum_mult, mul_div_cancel₀ _ hn_ne, sub_self]
  have h_sum_r : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * r_γ v) = 0 := by
    dsimp [r_γ]
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
