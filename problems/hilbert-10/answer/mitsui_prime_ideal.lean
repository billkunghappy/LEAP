          _ = (1 / ‖s‖) * t ^ (s.re - 1) + ‖1 / s ^ 2 + 1 / s‖ * t ^ s.re := by rw [h_rpow]
      have h_add := norm_add_le ((t : ℂ) ^ (s - 1) * (1 / (s - 1)))
        ((t : ℂ) ^ s * ((Real.log t : ℂ) / s - 1 / s ^ 2 - 1 / s))
      linarith
    have hG_tendsto_one : Filter.Tendsto G (nhdsWithin 1 (Set.Iio 1)) (nhds ((1 / s ^ 2) * (1 / (s - 1)))) := by
      have hG_cont : ContinuousAt G 1 := by
        refine ContinuousAt.add ?_ ?_
        · refine (ContinuousAt.cpow Complex.continuous_ofReal.continuousAt continuousAt_const ?_).mul continuousAt_const
          rw [Complex.mem_slitPlane_iff]; exact Or.inl zero_lt_one
        · refine (ContinuousAt.cpow Complex.continuous_ofReal.continuousAt continuousAt_const ?_).mul ?_
          · rw [Complex.mem_slitPlane_iff]; exact Or.inl zero_lt_one
          · refine (((Complex.continuous_ofReal.continuousAt.comp (Real.continuousAt_log one_ne_zero)).div_const s).sub continuousAt_const).sub continuousAt_const
      have hG1 : G 1 = (1 / s ^ 2) * (1 / (s - 1)) := by
        dsimp [G]
