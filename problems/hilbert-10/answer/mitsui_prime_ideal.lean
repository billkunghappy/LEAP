      (A_collar + ε_tail) * (∑' pm : D_Z, w_riesz pm)
  rw [tsum_fintype, tsum_fintype, h_lhs_split]
  have h_tri := norm_add_le
    (∑ pm : D_Z, T_main (v pm) * (ξ pm * (w_riesz pm : ℂ)))
    (∑ pm : D_Z, (W_cell (v pm) - T_main (v pm)) * (ξ pm * (w_riesz pm : ℂ)))
  linarith

theorem mitsui_riesz_primePower_ray_char_unitLogCoord_phase_freq_bound {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A)
    (Φ_W : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →
      Fin (NumberField.Units.rank K) → ℝ)
    (hΦ_W_mul : ∀ I J : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ∃ d : Fin (NumberField.Units.rank K) → ℤ,
        ∀ j : Fin (NumberField.Units.rank K),
          Φ_W (I * J) j = Φ_W I j + Φ_W J j + (d j : ℝ))
    (hΦ_W_pow : ∀ (I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) (ν : ℕ),
      ∃ d : Fin (NumberField.Units.rank K) → ℤ,
        ∀ j : Fin (NumberField.Units.rank K),
          Φ_W (I ^ ν) j = (ν : ℝ) * Φ_W I j + (d j : ℝ))
    (hΦ_W_prin : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      ∃ d : Fin (NumberField.Units.rank K) → ℤ,
        ∀ (w w₀ : NumberField.InfinitePlace K),
          Real.log (w (x : K) / w₀ (x : K)) =
            ∑ j : Fin (NumberField.Units.rank K),
              (Φ_W ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
                mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ j + (d j : ℝ)) *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) :
    ∃ c_gr : ℝ, 0 < c_gr ∧
      ∀ Y : ℝ, 1 < Y →
        ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
          (Ideal.absNorm q : ℝ) < Real.log Y ^ A →
          ∀ w₀ : NumberField.InfinitePlace K,
            ∀ θ₀ : Fin (NumberField.Units.rank K) → ℝ,
              (∀ j : Fin (NumberField.Units.rank K), 0 ≤ θ₀ j ∧ θ₀ j < 1) →
              ∀ χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ,
                (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
                  x - 1 ∈ q →
                  ∀ d : Fin (NumberField.Units.rank K) → ℤ,
                    (∀ w : NumberField.InfinitePlace K,
                      Real.log (w (x : K) / w₀ (x : K)) =
                        ∑ j : Fin (NumberField.Units.rank K),
                          (Φ_W ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
                            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ j + (d j : ℝ)) *
                            Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                              w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) →
                    χ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
                      mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
                      Complex.exp
                        (2 * Real.pi * Complex.I *
                          ∑ j : Fin (NumberField.Units.rank K),
                            (θ₀ j : ℂ) *
                              ((Φ_W ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
                                mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ j + (d j : ℝ) : ℝ) : ℂ)) = 1) →
                (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
                  ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ I‖ = 1) ∧
                  (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ I = 0)) →
                ∀ m_freq : Fin (NumberField.Units.rank K) → ℤ,
                  (m_freq ≠ 0 ∨ ∃ j₀ : Fin (NumberField.Units.rank K), θ₀ j₀ ≠ 0) →
                  (∀ j : Fin (NumberField.Units.rank K),
                    |(m_freq j : ℝ)| ≤ Real.exp (Real.sqrt (Real.log Y))) →
                  ‖∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                        1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
                      Complex.exp (2 * Real.pi * Complex.I *
                        ∑ j : Fin (NumberField.Units.rank K),
                          (m_freq j : ℝ) *
                            ((pm.1.2 : ℝ) * Φ_W ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩ j)) *
                        ((χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
                          ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                            Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ))‖
                    ≤ c_gr * Y * Real.exp (-Real.sqrt (Real.log Y) / c_gr) :=
by
  classical
  obtain ⟨B, C, hB_pos, hB_le, hC_pos, h_cont⟩ :=
    mitsui_grossenchar_LSeries_analytic_continuation_bound (K := K) A hA
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_landauPage_integral_bound B hB_pos
  let c_gr : ℝ := C * c₁ + c₁
  have hc_gr_pos : 0 < c_gr := by dsimp [c_gr]; positivity
  refine ⟨c_gr, hc_gr_pos, ?_⟩
  intro Y hY q hq hq_norm w₀ θ₀ hθ₀_bdd χ hχ_ray hχ_norm_supp m_freq h_nonprin hm_bound
  let r : ℕ := NumberField.Units.rank K
  have h_s1 :
      ∃ (θ'_0 : Fin r → ℝ)
        (m'_freq : Fin r → ℤ)
        (χ_gr : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ),
        (‖∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
            Complex.exp (2 * Real.pi * Complex.I *
              ∑ j : Fin r,
                (m_freq j : ℝ) *
                  ((pm.1.2 : ℝ) * Φ_W ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩ j)) *
              ((χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
                ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                  Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ))‖ =
          ‖∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
              (χ_gr ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
                ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                  Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)‖) ∧
        (∀ j : Fin r, 0 ≤ θ'_0 j ∧ θ'_0 j < 1) ∧
        m'_freq ≠ 0 ∧
        (∀ j : Fin r,
          |(m'_freq j : ℝ)| ≤ Real.exp (Real.sqrt (Real.log Y))) ∧
        (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
          ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ_gr I‖ = 1) ∧
          (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ_gr I = 0)) ∧
        (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
          x - 1 ∈ q →
          ∃ y : Fin r → ℝ,
            (∀ w : NumberField.InfinitePlace K,
              Real.log (w (x : K) / w₀ (x : K)) =
                ∑ j : Fin r,
                  y j *
                    Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                      w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) ∧
            χ_gr ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
              mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
              Complex.exp
                (((∑ j : Fin r,
                    y j * (2 * Real.pi * (θ'_0 j - (m'_freq j : ℝ)))) : ℝ) * Complex.I) = 1) := by
    by_cases hm_ne : m_freq ≠ 0
    · let f_W : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) → ℂ := fun I =>
        Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℂ) * (Φ_W I j : ℂ))
      have hf_W_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖f_W I‖ = 1 := by
        intro I
        dsimp [f_W]
        have h_eq :
            2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℂ) * (Φ_W I j : ℂ) =
              (((2 * Real.pi * ∑ j : Fin r, (m_freq j : ℝ) * Φ_W I j) : ℝ) : ℂ) * Complex.I := by
          push_cast
          ring
        rw [h_eq]
        exact Complex.norm_exp_ofReal_mul_I _
      have hf_W_mul : ∀ I J : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
          f_W (I * J) = f_W I * f_W J := by
        intro I J
        obtain ⟨d, hd⟩ := hΦ_W_mul I J
        dsimp [f_W]
        have h_arg :
            2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℂ) * (Φ_W (I * J) j : ℂ) =
              (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℂ) * (Φ_W I j : ℂ) +
                2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℂ) * (Φ_W J j : ℂ)) +
              ((∑ j : Fin r, m_freq j * d j : ℤ) : ℂ) * (2 * Real.pi * Complex.I) := by
          have h_sum :
              (∑ j : Fin r, (m_freq j : ℂ) * (Φ_W (I * J) j : ℂ)) =
                (∑ j : Fin r, (m_freq j : ℂ) * (Φ_W I j : ℂ)) +
                (∑ j : Fin r, (m_freq j : ℂ) * (Φ_W J j : ℂ)) +
                (∑ j : Fin r, (m_freq j : ℂ) * (d j : ℂ)) := by
            rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
            refine Finset.sum_congr rfl (fun j _ => ?_)
            rw [hd j]
            push_cast
            ring
          rw [h_sum]
          push_cast
          ring
        rw [h_arg, Complex.exp_add, Complex.exp_add,
          Complex.exp_int_mul_two_pi_mul_I (∑ j : Fin r, m_freq j * d j), mul_one]
      have hf_W_one : f_W 1 = 1 := by
        have h1 : f_W (1 * 1) = f_W 1 * f_W 1 := hf_W_mul 1 1
        rw [mul_one] at h1
        have h_norm : ‖f_W 1‖ ≠ 0 := by rw [hf_W_norm 1]; exact one_ne_zero
        have h_ne : f_W 1 ≠ 0 := norm_ne_zero_iff.mp h_norm
        exact mul_left_cancel₀ h_ne (h1.symm.trans (mul_one (f_W 1)).symm)
      let lam_hom : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ :=
        { toFun := f_W
          map_one' := hf_W_one
          map_mul' := hf_W_mul }
      let χ_gr : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ := lam_hom * χ
      refine ⟨θ₀, m_freq, χ_gr, ?_, hθ₀_bdd, hm_ne, hm_bound, ?_, ?_⟩
      · refine congrArg norm (tsum_congr (fun pm => ?_))
        let p_nz : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
          ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩
        let ν : ℕ := pm.1.2
        have h_exp_pow :
            Complex.exp (2 * Real.pi * Complex.I *
              ∑ j : Fin r, (m_freq j : ℝ) * ((ν : ℝ) * Φ_W p_nz j)) =
              (f_W p_nz) ^ ν := by
          dsimp [f_W]
          rw [← Complex.exp_nat_mul]
          congr 1
          have h_sum_nu :
              (∑ j : Fin r, (m_freq j : ℂ) * ((ν : ℂ) * (Φ_W p_nz j : ℂ))) =
                (ν : ℂ) * ∑ j : Fin r, (m_freq j : ℂ) * (Φ_W p_nz j : ℂ) := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl (fun j _ => by ring)
          push_cast
          rw [h_sum_nu]
          ring
        change Complex.exp (2 * Real.pi * Complex.I *
              ∑ j : Fin r, (m_freq j : ℝ) * ((ν : ℝ) * Φ_W p_nz j)) *
            ((χ p_nz) ^ ν *
              ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ ν)) : ℝ) : ℂ)) =
          (f_W p_nz * χ p_nz) ^ ν *
            ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
              Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ ν)) : ℝ) : ℂ)
        rw [h_exp_pow, mul_pow]
        ring
      · intro I
        refine ⟨fun hI => ?_, fun hI => ?_⟩
        · change ‖f_W I * χ I‖ = 1
          rw [norm_mul, hf_W_norm I, (hχ_norm_supp I).1 hI, mul_one]
        · change f_W I * χ I = 0
          rw [(hχ_norm_supp I).2 hI, mul_zero]
      · intro x hx_ne hx_q
        let I_x : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
          ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩
        obtain ⟨d, hd_log⟩ := hΦ_W_prin x hx_ne
        let y : Fin r → ℝ := fun j => Φ_W I_x j + (d j : ℝ)
        refine ⟨y, fun w => hd_log w w₀, ?_⟩
        have h_ray :
            χ I_x *
              Complex.exp
                (2 * Real.pi * Complex.I * ∑ j : Fin r, (θ₀ j : ℂ) * (y j : ℂ)) = 1 :=
