              ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ ((-1 : ℝ) * (2 * y i))) : ℂ) := by
      intro C x y
      have h_prod :
          (∏ w : NumberField.InfinitePlace K,
