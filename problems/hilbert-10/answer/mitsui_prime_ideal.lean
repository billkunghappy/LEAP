  have hD_pos : 0 < D := lt_of_lt_of_le zero_lt_one hD_ge_one
  refine ⟨C₀, hC₀_pos, ?_⟩
  intro q hq w₀ a₀ ha₀_lt θ₀ hθ₀_bdd m_freq l_ang h_tors M hM hm_M hl_M χ_gr hχ_norm_supp hχ_prin h_sq_nonprin
  obtain ⟨B₀, χ_dual, g_sq, hB₀_pos, hχ_dual_norm, hg_diff, hg_eq, hg_feq_sharp, hg_mellin⟩ :=
    h_comp q hq w₀ a₀ ha₀_lt θ₀ hθ₀_bdd m_freq l_ang h_tors M hM hm_M hl_M χ_gr hχ_norm_supp hχ_prin h_sq_nonprin
  let C₁ : ℝ := B₀ * D ^ (1 / 4 : ℝ)
  have hC₁_pos : 0 < C₁ := by dsimp [C₁]; positivity
