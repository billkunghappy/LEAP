      have h_congr_g : (∏ w : NumberField.InfinitePlace K,
          (w.embedding (x_g : K) / (w (x_g : K) : ℂ)) ^ (l_ang w)) =
          ∏ w : NumberField.InfinitePlace K,
            (w.embedding (x_g : K)) ^ (l_ang w) := by
        refine Finset.prod_congr rfl (fun w _ => ?_)
        rw [hw_g w, Complex.ofReal_one, div_one]
