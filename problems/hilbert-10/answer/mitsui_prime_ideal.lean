    have hSrem_le_n : (∑ w ∈ S_rem, w.mult) ≤ n := by omega
    have h_exp_sum : (w₁.mult - 1) + (w₂.mult - 1) + (∑ w ∈ S_rem, w.mult) = n - 2 := by omega
