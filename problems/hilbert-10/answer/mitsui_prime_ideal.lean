    have hk_le_km : Ideal.absNorm p.asIdeal ≤ Ideal.absNorm p.asIdeal ^ ν :=
      Nat.le_self_pow hν_ne (Ideal.absNorm p.asIdeal)
    have hν_le_2ν : ν ≤ 2 ^ ν := (Nat.lt_pow_self (by decide : 1 < 2)).le
    have h2ν_le_km : 2 ^ ν ≤ Ideal.absNorm p.asIdeal ^ ν := Nat.pow_le_pow_left hk2 ν
    exact ⟨le_trans hk_le_km h_km_le, le_trans (le_trans hν_le_2ν h2ν_le_km) h_km_le⟩
  let D_prin_Z := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧
    (pm.1.asIdeal ^ pm.2).IsPrincipal ∧
    (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Real.exp δ * Y}
  let D_prin_Y := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧
    (pm.1.asIdeal ^ pm.2).IsPrincipal ∧
    (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y}
  let D_all_Z := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Real.exp δ * Y}
  let D_all_Y := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y}
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Z_plus⌋₊}
  let S_prod : Set (Ideal (NumberField.RingOfIntegers K) × ℕ) :=
    S_id ×ˢ {ν : ℕ | ν ≤ ⌊Z_plus⌋₊}
  have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Z_plus⌋₊
  have hSprod_fin : S_prod.Finite := hSid_fin.prod (Set.finite_le_nat ⌊Z_plus⌋₊)
  haveI : Finite S_prod := hSprod_fin
  let f_prin_Z : D_prin_Z → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2), h_pm_bounds pm.1.1 pm.1.2 pm.2.1 pm.2.2.2⟩
  have hf_prin_Z_inj : Function.Injective f_prin_Z := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    dsimp [f_prin_Z] at hval
    exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext (Prod.mk.inj hval).1) (Prod.mk.inj hval).2)
  haveI : Finite D_prin_Z := Finite.of_injective f_prin_Z hf_prin_Z_inj
  letI : Fintype D_prin_Z := Fintype.ofFinite D_prin_Z
  let f_prin_Y : D_prin_Y → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2),
      h_pm_bounds pm.1.1 pm.1.2 pm.2.1 (le_trans pm.2.2.2 hY_le_Z)⟩
  have hf_prin_Y_inj : Function.Injective f_prin_Y := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    dsimp [f_prin_Y] at hval
    exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext (Prod.mk.inj hval).1) (Prod.mk.inj hval).2)
  haveI : Finite D_prin_Y := Finite.of_injective f_prin_Y hf_prin_Y_inj
  letI : Fintype D_prin_Y := Fintype.ofFinite D_prin_Y
  let f_all_Z : D_all_Z → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2), h_pm_bounds pm.1.1 pm.1.2 pm.2.1 pm.2.2⟩
  have hf_all_Z_inj : Function.Injective f_all_Z := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    dsimp [f_all_Z] at hval
    exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext (Prod.mk.inj hval).1) (Prod.mk.inj hval).2)
  haveI : Finite D_all_Z := Finite.of_injective f_all_Z hf_all_Z_inj
  letI : Fintype D_all_Z := Fintype.ofFinite D_all_Z
  let f_all_Y : D_all_Y → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2),
      h_pm_bounds pm.1.1 pm.1.2 pm.2.1 (le_trans pm.2.2 hY_le_Z)⟩
  have hf_all_Y_inj : Function.Injective f_all_Y := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    dsimp [f_all_Y] at hval
    exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext (Prod.mk.inj hval).1) (Prod.mk.inj hval).2)
  haveI : Finite D_all_Y := Finite.of_injective f_all_Y hf_all_Y_inj
  letI : Fintype D_all_Y := Fintype.ofFinite D_all_Y
  let M_free (I : Ideal (NumberField.RingOfIntegers K)) (hI : I.IsPrincipal) : ℕ :=
    Nat.card {e : Fin (NumberField.Units.rank K) → ℤ //
      ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
        Real.log (w ((@Submodule.IsPrincipal.generator _ _ _ _ _ I hI : NumberField.RingOfIntegers K) : K) /
            w₀ ((@Submodule.IsPrincipal.generator _ _ _ _ _ I hI : NumberField.RingOfIntegers K) : K)) +
          ∑ j : Fin (NumberField.Units.rank K),
            (e j : ℝ) *
              Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ∈
          Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
            (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))}
  let term_prin_Z : D_prin_Z → ℝ := fun pm =>
    (M_free (pm.1.1.asIdeal ^ pm.1.2) pm.2.2.1 : ℝ) *
      (Real.log (Ideal.absNorm pm.1.1.asIdeal) *
        Real.log ((Real.exp δ * Y) / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)))
  let term_prin_Y : D_prin_Y → ℝ := fun pm =>
    (M_free (pm.1.1.asIdeal ^ pm.1.2) pm.2.2.1 : ℝ) *
      (Real.log (Ideal.absNorm pm.1.1.asIdeal) *
        Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)))
  let term_ψ_prin_Y : D_prin_Y → ℝ := fun pm =>
    (M_free (pm.1.1.asIdeal ^ pm.1.2) pm.2.2.1 : ℝ) *
      Real.log (Ideal.absNorm pm.1.1.asIdeal)
  let term_all_Z : D_all_Z → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal) *
      Real.log ((Real.exp δ * Y) / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
  let term_all_Y : D_all_Y → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal) *
      Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
  let term_ψ_all_Y : D_all_Y → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal)
  have h_term_all_Y_nonneg : ∀ pm : D_all_Y, 0 ≤ term_all_Y pm := by
    intro pm
    dsimp [term_all_Y]
    apply mul_nonneg (Real.log_natCast_nonneg _)
    apply Real.log_nonneg
    have hk_pos : (0 : ℝ) < (Ideal.absNorm pm.1.1.asIdeal : ℝ) := by
      have := h_norm_ge_two pm.1.1
      positivity
    have hpow_pos : (0 : ℝ) < (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 :=
      pow_pos hk_pos pm.1.2
    exact (one_le_div₀ hpow_pos).mpr pm.2.2
  have h_term_prin_Y_nonneg : ∀ pm : D_prin_Y, 0 ≤ term_prin_Y pm := by
    intro pm
    exact mul_nonneg (Nat.cast_nonneg _) (h_term_all_Y_nonneg ⟨pm.1, ⟨pm.2.1, pm.2.2.2⟩⟩)
  have h_term_prin_Y_le : ∀ pm : D_prin_Y,
      term_prin_Y pm ≤ B * term_all_Y ⟨pm.1, ⟨pm.2.1, pm.2.2.2⟩⟩ := by
    intro pm
    exact mul_le_mul_of_nonneg_right (hB pm.1.1 pm.1.2 pm.2.1 pm.2.2.1)
      (h_term_all_Y_nonneg ⟨pm.1, ⟨pm.2.1, pm.2.2.2⟩⟩)
  let emb_Y : D_prin_Y ↪ D_all_Y :=
    { toFun := fun pm => ⟨pm.1, ⟨pm.2.1, pm.2.2.2⟩⟩
      inj' := fun a b hab => by
        have hval := congrArg Subtype.val hab
        exact Subtype.ext hval }
  have h_part1_nonneg : 0 ≤ ∑' pm : D_prin_Y, term_prin_Y pm :=
    tsum_nonneg h_term_prin_Y_nonneg
  have h_part1_le : (∑' pm : D_prin_Y, term_prin_Y pm) ≤ B * ∑' pm : D_all_Y, term_all_Y pm := by
    rw [tsum_fintype, tsum_fintype]
    calc ∑ pm : D_prin_Y, term_prin_Y pm
      _ ≤ ∑ pm : D_prin_Y, B * term_all_Y (emb_Y pm) :=
        Finset.sum_le_sum (fun pm _ => h_term_prin_Y_le pm)
      _ = B * ∑ pm : D_prin_Y, term_all_Y (emb_Y pm) :=
        (Finset.mul_sum _ _ B).symm
      _ = B * ∑ pm ∈ Finset.map emb_Y Finset.univ, term_all_Y pm := by
        rw [Finset.sum_map]
      _ ≤ B * ∑ pm : D_all_Y, term_all_Y pm :=
        mul_le_mul_of_nonneg_left
          (Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
            (fun pm _ _ => h_term_all_Y_nonneg pm))
          hB₀
  have h_log_split : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (ν : ℕ),
      Real.log ((Real.exp δ * Y) / ((Ideal.absNorm p.asIdeal : ℝ) ^ ν)) =
      Real.log (Y / ((Ideal.absNorm p.asIdeal : ℝ) ^ ν)) + δ := by
    intro p ν
    have hk_pos : (0 : ℝ) < (Ideal.absNorm p.asIdeal : ℝ) := by
      have := h_norm_ge_two p
      positivity
    have hpow_pos : (0 : ℝ) < (Ideal.absNorm p.asIdeal : ℝ) ^ ν := pow_pos hk_pos ν
    rw [Real.log_div (ne_of_gt hZ_pos) (ne_of_gt hpow_pos),
      Real.log_mul (ne_of_gt (Real.exp_pos δ)) (ne_of_gt hY),
      Real.log_exp,
      Real.log_div (ne_of_gt hY) (ne_of_gt hpow_pos)]
    ring
  let P_prin : D_prin_Z → Prop := fun pm =>
    (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 ≤ Y
  let P_all : D_all_Z → Prop := fun pm =>
    (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 ≤ Y
  let e_prin : D_prin_Y ≃ {pm : D_prin_Z // P_prin pm} :=
    { toFun := fun pm =>
        ⟨⟨pm.1, ⟨pm.2.1, ⟨pm.2.2.1, le_trans pm.2.2.2 hY_le_Z⟩⟩⟩, pm.2.2.2⟩
      invFun := fun pm =>
        ⟨pm.1.1, ⟨pm.1.2.1, ⟨pm.1.2.2.1, pm.2⟩⟩⟩
      left_inv := fun pm => by apply Subtype.ext; rfl
      right_inv := fun pm => by apply Subtype.ext; apply Subtype.ext; rfl }
  let e_all : D_all_Y ≃ {pm : D_all_Z // P_all pm} :=
    { toFun := fun pm =>
        ⟨⟨pm.1, ⟨pm.2.1, le_trans pm.2.2 hY_le_Z⟩⟩, pm.2.2⟩
      invFun := fun pm => ⟨pm.1.1, ⟨pm.1.2.1, pm.2⟩⟩
      left_inv := fun pm => by apply Subtype.ext; rfl
      right_inv := fun pm => by apply Subtype.ext; apply Subtype.ext; rfl }
  have h_term_prin_split : ∀ pm : D_prin_Y,
      term_prin_Z (e_prin pm).1 = term_prin_Y pm + δ * term_ψ_prin_Y pm := by
    intro pm
    dsimp [term_prin_Z, term_prin_Y, term_ψ_prin_Y, e_prin]
    rw [h_log_split pm.1.1 pm.1.2]
    ring
  have h_sum_prin_filter :
      ∑ pm ∈ Finset.univ.filter P_prin, term_prin_Z pm =
      (∑' pm : D_prin_Y, term_prin_Y pm) +
        δ * (∑' pm : D_prin_Y, term_ψ_prin_Y pm) := by
    have h1 : ∑ pm ∈ Finset.univ.filter P_prin, term_prin_Z pm =
        ∑' pm : {pm : D_prin_Z // P_prin pm}, term_prin_Z pm.1 := by
      rw [tsum_fintype]
      exact Finset.sum_subtype (Finset.univ.filter P_prin) (fun _ => by simp) term_prin_Z
    have h2 : (∑' pm : {pm : D_prin_Z // P_prin pm}, term_prin_Z pm.1) =
        ∑' pm : D_prin_Y, term_prin_Z (e_prin pm).1 :=
      (Equiv.tsum_eq e_prin (fun pm : {pm : D_prin_Z // P_prin pm} => term_prin_Z pm.1)).symm
    rw [h1, h2, tsum_congr h_term_prin_split, tsum_fintype, tsum_fintype, tsum_fintype,
      Finset.sum_add_distrib, ← Finset.mul_sum]
  have h_sum_prin_Z : (∑' pm : D_prin_Z, term_prin_Z pm) =
      (∑ pm ∈ Finset.univ.filter P_prin, term_prin_Z pm) +
      (∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm), term_prin_Z pm) := by
    rw [tsum_fintype]
    exact (Finset.sum_filter_add_sum_filter_not Finset.univ P_prin term_prin_Z).symm
  have h_lhs_eq :
      ((∑' pm : D_prin_Z, term_prin_Z pm) - (∑' pm : D_prin_Y, term_prin_Y pm)) -
        δ * (∑' pm : D_prin_Y, term_ψ_prin_Y pm) =
      ∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm), term_prin_Z pm := by
    rw [h_sum_prin_Z, h_sum_prin_filter]
    ring
  have h_term_all_split : ∀ pm : D_all_Y,
      term_all_Z (e_all pm).1 = term_all_Y pm + δ * term_ψ_all_Y pm := by
    intro pm
    dsimp [term_all_Z, term_all_Y, term_ψ_all_Y, e_all]
    rw [h_log_split pm.1.1 pm.1.2]
    ring
  have h_sum_all_filter :
      ∑ pm ∈ Finset.univ.filter P_all, term_all_Z pm =
      (∑' pm : D_all_Y, term_all_Y pm) +
        δ * (∑' pm : D_all_Y, term_ψ_all_Y pm) := by
    have h1 : ∑ pm ∈ Finset.univ.filter P_all, term_all_Z pm =
        ∑' pm : {pm : D_all_Z // P_all pm}, term_all_Z pm.1 := by
      rw [tsum_fintype]
      exact Finset.sum_subtype (Finset.univ.filter P_all) (fun _ => by simp) term_all_Z
    have h2 : (∑' pm : {pm : D_all_Z // P_all pm}, term_all_Z pm.1) =
        ∑' pm : D_all_Y, term_all_Z (e_all pm).1 :=
      (Equiv.tsum_eq e_all (fun pm : {pm : D_all_Z // P_all pm} => term_all_Z pm.1)).symm
    rw [h1, h2, tsum_congr h_term_all_split, tsum_fintype, tsum_fintype, tsum_fintype,
      Finset.sum_add_distrib, ← Finset.mul_sum]
  have h_sum_all_Z : (∑' pm : D_all_Z, term_all_Z pm) =
      (∑ pm ∈ Finset.univ.filter P_all, term_all_Z pm) +
      (∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_all_Z pm) := by
    rw [tsum_fintype]
    exact (Finset.sum_filter_add_sum_filter_not Finset.univ P_all term_all_Z).symm
  have h_rhs_eq :
      ((∑' pm : D_all_Z, term_all_Z pm) - (∑' pm : D_all_Y, term_all_Y pm)) -
        δ * (∑' pm : D_all_Y, term_ψ_all_Y pm) =
      ∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_all_Z pm := by
    rw [h_sum_all_Z, h_sum_all_filter]
    ring
  have h_term_all_Z_nonneg : ∀ pm : D_all_Z, 0 ≤ term_all_Z pm := by
    intro pm
    dsimp [term_all_Z]
    apply mul_nonneg (Real.log_natCast_nonneg _)
    apply Real.log_nonneg
    have hk_pos : (0 : ℝ) < (Ideal.absNorm pm.1.1.asIdeal : ℝ) := by
      have := h_norm_ge_two pm.1.1
      positivity
    have hpow_pos : (0 : ℝ) < (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 :=
      pow_pos hk_pos pm.1.2
    exact (one_le_div₀ hpow_pos).mpr pm.2.2
  have h_term_prin_Z_nonneg : ∀ pm : D_prin_Z, 0 ≤ term_prin_Z pm := by
    intro pm
    exact mul_nonneg (Nat.cast_nonneg _) (h_term_all_Z_nonneg ⟨pm.1, ⟨pm.2.1, pm.2.2.2⟩⟩)
  have h_term_prin_Z_le : ∀ pm : D_prin_Z,
      term_prin_Z pm ≤ B * term_all_Z ⟨pm.1, ⟨pm.2.1, pm.2.2.2⟩⟩ := by
    intro pm
    exact mul_le_mul_of_nonneg_right (hB pm.1.1 pm.1.2 pm.2.1 pm.2.2.1)
      (h_term_all_Z_nonneg ⟨pm.1, ⟨pm.2.1, pm.2.2.2⟩⟩)
  let emb_short : {pm : D_prin_Z // ¬ P_prin pm} ↪ {pm : D_all_Z // ¬ P_all pm} :=
    { toFun := fun pm => ⟨⟨pm.1.1, ⟨pm.1.2.1, pm.1.2.2.2⟩⟩, pm.2⟩
      inj' := fun a b hab => by
        have hval := congrArg Subtype.val (congrArg Subtype.val hab)
        apply Subtype.ext; apply Subtype.ext; exact hval }
  let F_short : {pm : D_all_Z // ¬ P_all pm} → ℝ := fun pm => term_all_Z pm.1
  have h_short_le :
      (∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm),
          term_all_Z ⟨pm.1, ⟨pm.2.1, pm.2.2.2⟩⟩) ≤
      ∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_all_Z pm := by
    calc ∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm),
            term_all_Z ⟨pm.1, ⟨pm.2.1, pm.2.2.2⟩⟩
      _ = ∑ pm : {pm : D_prin_Z // ¬ P_prin pm}, F_short (emb_short pm) :=
        Finset.sum_subtype (Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm))
          (fun _ => by simp) (fun pm : D_prin_Z => term_all_Z ⟨pm.1, ⟨pm.2.1, pm.2.2.2⟩⟩)
      _ = ∑ pm ∈ Finset.map emb_short Finset.univ, F_short pm :=
        (Finset.sum_map Finset.univ emb_short F_short).symm
      _ ≤ ∑ pm : {pm : D_all_Z // ¬ P_all pm}, F_short pm :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
          (fun pm _ _ => h_term_all_Z_nonneg pm.1)
      _ = ∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_all_Z pm :=
        (Finset.sum_subtype (Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm))
          (fun _ => by simp) term_all_Z).symm
  have h_part2 :
      |((∑' pm : D_prin_Z, term_prin_Z pm) - (∑' pm : D_prin_Y, term_prin_Y pm)) -
        δ * (∑' pm : D_prin_Y, term_ψ_prin_Y pm)| ≤
      B * (((∑' pm : D_all_Z, term_all_Z pm) - (∑' pm : D_all_Y, term_all_Y pm)) -
        δ * (∑' pm : D_all_Y, term_ψ_all_Y pm)) := by
    rw [h_lhs_eq, h_rhs_eq,
      abs_of_nonneg (Finset.sum_nonneg (fun pm _ => h_term_prin_Z_nonneg pm))]
    calc ∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm), term_prin_Z pm
      _ ≤ ∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm),
            (B * term_all_Z ⟨pm.1, ⟨pm.2.1, pm.2.2.2⟩⟩) :=
        Finset.sum_le_sum (fun pm _ => h_term_prin_Z_le pm)
      _ = B * ∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm),
            term_all_Z ⟨pm.1, ⟨pm.2.1, pm.2.2.2⟩⟩ :=
        (Finset.mul_sum _ _ B).symm
      _ ≤ B * ∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_all_Z pm :=
        mul_le_mul_of_nonneg_left h_short_le hB₀
  exact ⟨⟨h_part1_nonneg, h_part1_le⟩, h_part2⟩

theorem mitsui_riesz_principalPrimePower_of_classGroup_char_bound {K : Type u} [Field K] [NumberField K]
    (Z : ℝ)
    (M : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℕ → ℝ)
    (B : ℝ) (hB : 0 ≤ B)
    (hchar : ∀ χ : AddChar (Additive (ClassGroup (NumberField.RingOfIntegers K))) ℂ, χ ≠ 0 →
      ‖∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Z},
          (M pm.1.1 pm.1.2 : ℂ) *
            ((χ (Additive.ofMul (ClassGroup.mk0 ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩))) ^ pm.1.2 *
              ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                Real.log (Z / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ))‖ ≤ B) :
    |(∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          1 ≤ pm.2 ∧
          (pm.1.asIdeal ^ pm.2).IsPrincipal ∧
          (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Z},
        M pm.1.1 pm.1.2 *
          (Real.log (Ideal.absNorm pm.1.1.asIdeal) *
            Real.log (Z / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))))
      - ((NumberField.classNumber K : ℝ))⁻¹ *
        (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Z},
            M pm.1.1 pm.1.2 *
              (Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                Real.log (Z / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))))| ≤ B :=
by
  classical
  let G := Additive (ClassGroup (NumberField.RingOfIntegers K))
  let H : ℕ := Fintype.card G
  have hH_eq : H = NumberField.classNumber K :=
    Fintype.card_congr Additive.ofMul.symm
  have hH_pos : 0 < H := by
    rw [hH_eq]
    exact NumberField.classNumber_pos K
  have hHR_pos : (0 : ℝ) < (H : ℝ) := Nat.cast_pos.mpr hH_pos
  have hHR_ne : (H : ℝ) ≠ 0 := ne_of_gt hHR_pos
  have hHC_ne : (H : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hH_pos)
  have h_card_char : Fintype.card (AddChar G ℂ) = H := AddChar.card_eq
  have h_card_erase : (Finset.univ.erase (0 : AddChar G ℂ)).card = H - 1 := by
    rw [Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, h_card_char]
  have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p.asIdeal := by
    intro p
    have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    omega
  have h_bounds : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (ν : ℕ),
      1 ≤ ν → (Ideal.absNorm p.asIdeal : ℝ) ^ ν ≤ Z →
      Ideal.absNorm p.asIdeal ≤ ⌊Z⌋₊ ∧ ν ≤ ⌊Z⌋₊ := by
    intro p ν hν hpow
    have hpow_nat : ((Ideal.absNorm p.asIdeal ^ ν : ℕ) : ℝ) ≤ Z := by exact_mod_cast hpow
    have hpow_le : Ideal.absNorm p.asIdeal ^ ν ≤ ⌊Z⌋₊ := Nat.le_floor hpow_nat
    have hν_ne : ν ≠ 0 := by omega
    have hp_le : Ideal.absNorm p.asIdeal ≤ Ideal.absNorm p.asIdeal ^ ν :=
      Nat.le_self_pow hν_ne (Ideal.absNorm p.asIdeal)
    have hν_lt_two : ν < 2 ^ ν := Nat.lt_pow_self (by decide : 1 < 2)
    have htwo_le : 2 ^ ν ≤ Ideal.absNorm p.asIdeal ^ ν :=
      Nat.pow_le_pow_left (h_norm_ge_two p) ν
    exact ⟨le_trans hp_le hpow_le, le_trans (le_of_lt hν_lt_two) (le_trans htwo_le hpow_le)⟩
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Z⌋₊}
  let S_nat : Set ℕ := {ν : ℕ | ν ≤ ⌊Z⌋₊}
  let S_prod : Set (Ideal (NumberField.RingOfIntegers K) × ℕ) := S_id ×ˢ S_nat
  have h_fin_prod : S_prod.Finite :=
    (Ideal.finite_setOf_absNorm_le ⌊Z⌋₊).prod (Set.finite_le_nat ⌊Z⌋₊)
  haveI : Finite S_prod := h_fin_prod
  let S_all := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Z}
  let S_prin := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧ (pm.1.asIdeal ^ pm.2).IsPrincipal ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Z}
  let f_all : S_all → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2), h_bounds pm.1.1 pm.1.2 pm.2.1 pm.2.2⟩
  have hf_all_inj : Function.Injective f_all := by
    intro pm₁ pm₂ h
    have h1 : pm₁.1.1.asIdeal = pm₂.1.1.asIdeal := congrArg (fun x => x.1.1) h
    have h2 : pm₁.1.2 = pm₂.1.2 := congrArg (fun x => x.1.2) h
    ext1
    exact Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext h1) h2
  haveI : Finite S_all := Finite.of_injective f_all hf_all_inj
  letI : Fintype S_all := Fintype.ofFinite S_all
  let f_prin : S_prin → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2), h_bounds pm.1.1 pm.1.2 pm.2.1 pm.2.2.2⟩
  have hf_prin_inj : Function.Injective f_prin := by
    intro pm₁ pm₂ h
    have h1 : pm₁.1.1.asIdeal = pm₂.1.1.asIdeal := congrArg (fun x => x.1.1) h
    have h2 : pm₁.1.2 = pm₂.1.2 := congrArg (fun x => x.1.2) h
    ext1
    exact Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext h1) h2
  haveI : Finite S_prin := Finite.of_injective f_prin hf_prin_inj
  letI : Fintype S_prin := Fintype.ofFinite S_prin
  let p_nz : S_all → nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) := fun pm =>
    ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩
  let g : S_all → G := fun pm =>
    pm.1.2 • Additive.ofMul (ClassGroup.mk0 (p_nz pm))
  have h_prin_iff : ∀ pm : S_all, g pm = 0 ↔ (pm.1.1.asIdeal ^ pm.1.2).IsPrincipal := by
    intro pm
    dsimp [g]
    rw [← ofMul_pow, ← map_pow, ofMul_eq_zero]
    have h_mk0 := ClassGroup.mk0_eq_one_iff (p_nz pm ^ pm.1.2).2
    have h_coe : ((p_nz pm ^ pm.1.2 : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
        Ideal (NumberField.RingOfIntegers K)) = pm.1.1.asIdeal ^ pm.1.2 := by
      rw [SubmonoidClass.coe_pow]
    rw [h_mk0, h_coe]
  let W : S_all → ℝ := fun pm =>
    M pm.1.1 pm.1.2 *
      (Real.log (Ideal.absNorm pm.1.1.asIdeal) *
        Real.log (Z / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)))
  let e : S_prin ≃ {pm : S_all // g pm = 0} :=
    { toFun := fun pm => ⟨⟨pm.1, ⟨pm.2.1, pm.2.2.2⟩⟩, (h_prin_iff ⟨pm.1, ⟨pm.2.1, pm.2.2.2⟩⟩).mpr pm.2.2.1⟩
      invFun := fun pm => ⟨pm.1.1, ⟨pm.1.2.1, (h_prin_iff pm.1).mp pm.2, pm.1.2.2⟩⟩
      left_inv := fun _ => by ext <;> rfl
      right_inv := fun _ => by ext <;> rfl }
  have h_sum_prin :
      (∑' pm : S_prin, W ⟨pm.1, ⟨pm.2.1, pm.2.2.2⟩⟩) =
        ∑ pm : S_all, (if g pm = 0 then (1 : ℝ) else 0) * W pm := by
    have he :
        (∑' pm : S_prin, W ⟨pm.1, ⟨pm.2.1, pm.2.2.2⟩⟩) =
          ∑' q : {pm : S_all // g pm = 0}, W q.1 :=
      Equiv.tsum_eq e (fun q => W q.1)
    rw [he, tsum_fintype]
    have h_sub :
        (∑ q : {pm : S_all // g pm = 0}, W q.1) =
          ∑ pm ∈ Finset.univ.filter (fun pm : S_all => g pm = 0), W pm :=
      (Finset.sum_subtype (Finset.univ.filter (fun pm : S_all => g pm = 0))
        (fun _ => by simp) W).symm
    rw [h_sub, Finset.sum_filter]
    refine Finset.sum_congr rfl (fun pm _ => ?_)
    split_ifs <;> ring
  have h_sum_all :
      (∑' pm : S_all, W pm) = ∑ pm : S_all, W pm :=
    tsum_fintype _
  have h_sum_char : ∀ χ : AddChar G ℂ,
      (∑' pm : S_all,
        (M pm.1.1 pm.1.2 : ℂ) *
          ((χ (Additive.ofMul (ClassGroup.mk0 ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩))) ^ pm.1.2 *
            ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
              Real.log (Z / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ))) =
        ∑ pm : S_all, χ (g pm) * (W pm : ℂ) := by
    intro χ
    rw [tsum_fintype]
    refine Finset.sum_congr rfl (fun pm _ => ?_)
    dsimp [g, p_nz, W]
    rw [AddChar.map_nsmul_eq_pow]
    push_cast
    ring
  have h_ortho : ∀ pm : S_all,
      ((if g pm = 0 then (1 : ℂ) else 0) - (H : ℂ)⁻¹) =
        (H : ℂ)⁻¹ * ∑ χ ∈ Finset.univ.erase (0 : AddChar G ℂ), χ (g pm) := by
    intro pm
    have h1 : ∑ χ : AddChar G ℂ, χ (g pm) = if g pm = 0 then (H : ℂ) else 0 :=
      AddChar.sum_apply_eq_ite (g pm)
    have h2 : (0 : AddChar G ℂ) (g pm) + ∑ χ ∈ Finset.univ.erase (0 : AddChar G ℂ), χ (g pm) =
        ∑ χ : AddChar G ℂ, χ (g pm) :=
      Finset.add_sum_erase Finset.univ (fun χ : AddChar G ℂ => χ (g pm)) (Finset.mem_univ _)
    rw [AddChar.zero_apply] at h2
    have h3 : ∑ χ ∈ Finset.univ.erase (0 : AddChar G ℂ), χ (g pm) =
        (if g pm = 0 then (H : ℂ) else 0) - 1 := by
      rw [← h1, ← h2]
      ring
    rw [h3]
    split_ifs with hgpm
    · rw [mul_sub, mul_one, inv_mul_cancel₀ hHC_ne]
    · ring
  set Δ : ℝ :=
    (∑' pm : S_prin, W ⟨pm.1, ⟨pm.2.1, pm.2.2.2⟩⟩) -
      (H : ℝ)⁻¹ * (∑' pm : S_all, W pm)
  have hΔ_real :
      Δ = ∑ pm : S_all, ((if g pm = 0 then (1 : ℝ) else 0) - (H : ℝ)⁻¹) * W pm := by
    dsimp [Δ]
    rw [h_sum_prin, h_sum_all, Finset.mul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun pm _ => ?_)
    ring
  have hΔ_complex :
      (Δ : ℂ) = (H : ℂ)⁻¹ * ∑ χ ∈ Finset.univ.erase (0 : AddChar G ℂ),
        ∑ pm : S_all, χ (g pm) * (W pm : ℂ) := by
    rw [hΔ_real]
    simp only [Complex.ofReal_sum, Complex.ofReal_mul, Complex.ofReal_sub,
      Complex.ofReal_inv, Complex.ofReal_natCast]
    rw [Finset.sum_comm, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun pm _ => ?_)
    rw [← Finset.sum_mul, ← mul_assoc, ← h_ortho pm]
    split_ifs <;> simp
  have h_norm_Δ : |Δ| = ‖(Δ : ℂ)‖ := (Complex.norm_real Δ).symm
  have h_goal_eq :
      |(∑' pm : S_prin,
          M pm.1.1 pm.1.2 *
            (Real.log (Ideal.absNorm pm.1.1.asIdeal) *
              Real.log (Z / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)))) -
        ((NumberField.classNumber K : ℝ))⁻¹ *
          (∑' pm : S_all,
            M pm.1.1 pm.1.2 *
              (Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                Real.log (Z / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))))| = |Δ| := by
    dsimp [Δ, W]
    rw [hH_eq]
  rw [h_goal_eq, h_norm_Δ, hΔ_complex, norm_mul, norm_inv, Complex.norm_natCast]
  have h_sum_bound :
      ‖∑ χ ∈ Finset.univ.erase (0 : AddChar G ℂ),
          ∑ pm : S_all, χ (g pm) * (W pm : ℂ)‖ ≤
        ((H - 1 : ℕ) : ℝ) * B := by
    calc
      ‖∑ χ ∈ Finset.univ.erase (0 : AddChar G ℂ),
          ∑ pm : S_all, χ (g pm) * (W pm : ℂ)‖
        ≤ ∑ χ ∈ Finset.univ.erase (0 : AddChar G ℂ),
            ‖∑ pm : S_all, χ (g pm) * (W pm : ℂ)‖ :=
          norm_sum_le _ _
      _ ≤ (Finset.univ.erase (0 : AddChar G ℂ)).card • B := by
          refine Finset.sum_le_card_nsmul _ _ B (fun χ hχ => ?_)
          rw [← h_sum_char χ]
          exact hchar χ (Finset.ne_of_mem_erase hχ)
      _ = ((H - 1 : ℕ) : ℝ) * B := by
          rw [h_card_erase, nsmul_eq_mul]
  have h_H_sub_le : ((H - 1 : ℕ) : ℝ) ≤ (H : ℝ) := by
    exact_mod_cast Nat.sub_le H 1
  calc
    (H : ℝ)⁻¹ * ‖∑ χ ∈ Finset.univ.erase (0 : AddChar G ℂ),
        ∑ pm : S_all, χ (g pm) * (W pm : ℂ)‖
      ≤ (H : ℝ)⁻¹ * (((H - 1 : ℕ) : ℝ) * B) :=
        mul_le_mul_of_nonneg_left h_sum_bound (inv_nonneg.mpr (le_of_lt hHR_pos))
    _ ≤ (H : ℝ)⁻¹ * ((H : ℝ) * B) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right h_H_sub_le hB)
          (inv_nonneg.mpr (le_of_lt hHR_pos))
    _ = B := by
        rw [← mul_assoc, inv_mul_cancel₀ hHR_ne, one_mul]

theorem mitsui_classGroup_char_exists_ray_char_top {K : Type u} [Field K] [NumberField K]
    (χ : AddChar (Additive (ClassGroup (NumberField.RingOfIntegers K))) ℂ) (hχ : χ ≠ 0) :
    (⊤ : Ideal (NumberField.RingOfIntegers K)) ≠ 0 ∧
    Ideal.absNorm (⊤ : Ideal (NumberField.RingOfIntegers K)) = 1 ∧
    ∃ χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ,
      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
        χ₀ I = χ (Additive.ofMul (ClassGroup.mk0 I))) ∧
      (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        x - 1 ∈ (⊤ : Ideal (NumberField.RingOfIntegers K)) →
        χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1) ∧
      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
        ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ ⊤ = ⊤ → ‖χ₀ I‖ = 1) ∧
        (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ ⊤ = ⊤) → χ₀ I = 0)) ∧
      (∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
        (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ ⊤ = ⊤ ∧ χ₀ I₀ ≠ 1) :=
by
  have htop_ne : (⊤ : Ideal (NumberField.RingOfIntegers K)) ≠ 0 := top_ne_bot
  have htop_norm : Ideal.absNorm (⊤ : Ideal (NumberField.RingOfIntegers K)) = 1 :=
    Ideal.absNorm_top
  let χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ :=
    { toFun := fun I => χ (Additive.ofMul (ClassGroup.mk0 I))
      map_one' := by rw [map_one, ofMul_one, AddChar.map_zero_eq_one]
      map_mul' := fun I J => by rw [map_mul, ofMul_mul, AddChar.map_add_eq_mul] }
  have hχ₀_eq : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      χ₀ I = χ (Additive.ofMul (ClassGroup.mk0 I)) := fun _ => rfl
  have hχ₀_ray : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ (⊤ : Ideal (NumberField.RingOfIntegers K)) →
      χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1 := by
    intro x hx_ne _
    rw [hχ₀_eq]
    have h_prin : (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))).IsPrincipal :=
      ⟨⟨x, rfl⟩⟩
    have h_mk0 : ClassGroup.mk0 ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1 :=
      (ClassGroup.mk0_eq_one_iff _).mpr h_prin
    rw [h_mk0, ofMul_one, AddChar.map_zero_eq_one]
  have hχ₀_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ ⊤ = ⊤ → ‖χ₀ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ ⊤ = ⊤) → χ₀ I = 0) := by
    intro I
    refine ⟨fun _ => ?_, fun h_not => False.elim (h_not (sup_top_eq _))⟩
    rw [hχ₀_eq]
    exact AddChar.norm_apply χ (Additive.ofMul (ClassGroup.mk0 I))
  have hχ₀_nonprin : ∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ ⊤ = ⊤ ∧ χ₀ I₀ ≠ 1 := by
    obtain ⟨g, hg⟩ := DFunLike.ne_iff.mp hχ
    rw [AddChar.zero_apply] at hg
    obtain ⟨I₀, hI₀⟩ := ClassGroup.mk0_surjective (Additive.toMul g)
    refine ⟨I₀, sup_top_eq _, ?_⟩
    rw [hχ₀_eq, hI₀, ofMul_toMul]
    exact hg
  exact ⟨htop_ne, htop_norm, χ₀, hχ₀_eq, hχ₀_ray, hχ₀_norm, hχ₀_nonprin⟩

theorem mitsui_riesz_primePower_unitLogCoord_cell_sub_zero_mode_le_of_trigPoly_approx {K : Type u} [Field K] [NumberField K]
    (X : ℝ)
    (m : ℕ)
    (w₀ : NumberField.InfinitePlace K)
    (k : NumberField.InfinitePlace K → Fin m)
    (Φ_W : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →
      Fin (NumberField.Units.rank K) → ℝ)
    (Z : ℝ) (hZ : 0 < Z)
    (M : ℕ)
    (c_main c_collar : (Fin (NumberField.Units.rank K) → ℤ) → ℂ)
    (A_main A_collar ε_tail B_osc : ℝ)
    (hA_main : 0 ≤ A_main) (hB_osc : 0 ≤ B_osc)
    (h_approx : ∀ v : Fin (NumberField.Units.rank K) → ℝ,
      ‖(Nat.card {e : Fin (NumberField.Units.rank K) → ℤ //
          ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
            ∑ j : Fin (NumberField.Units.rank K),
              (v j + (e j : ℝ)) *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ∈
              Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℂ) -
        ∑ m_freq ∈ Fintype.piFinset (fun _ : Fin (NumberField.Units.rank K) => Finset.Icc (-(M : ℤ)) (M : ℤ)),
          c_main m_freq *
            Complex.exp (2 * Real.pi * Complex.I *
              ∑ j : Fin (NumberField.Units.rank K), (m_freq j : ℝ) * v j)‖ ≤
      (∑ m_freq ∈ Fintype.piFinset (fun _ : Fin (NumberField.Units.rank K) => Finset.Icc (-(M : ℤ)) (M : ℤ)),
        c_collar m_freq *
          Complex.exp (2 * Real.pi * Complex.I *
            ∑ j : Fin (NumberField.Units.rank K), (m_freq j : ℝ) * v j)).re + ε_tail)
    (hc_collar_zero : ‖c_collar 0‖ ≤ A_collar)
    (hc_coeff : ∀ m_freq : Fin (NumberField.Units.rank K) → ℤ,
      ‖c_main m_freq‖ ≤ A_main ∧ ‖c_collar m_freq‖ ≤ A_main)
    (h_osc : ∀ m_freq ∈ Fintype.piFinset (fun _ : Fin (NumberField.Units.rank K) => Finset.Icc (-(M : ℤ)) (M : ℤ)),
      m_freq ≠ 0 →
