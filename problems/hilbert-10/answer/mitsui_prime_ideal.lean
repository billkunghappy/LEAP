      le_trans (Finset.card_le_card h_sub_union) (Finset.card_union_le _ _)
    exact_mod_cast h_nat
  have h_sum_outer_le :
      (U_outer.card : ℝ) ≤
        (U_main.card : ℝ) + (2 : ℝ) ^ r₁ * (S_collar.card : ℝ) := by
    rw [h_card_outer, h_card_main]
    calc ∑ ξ : ι_real → Fin 2, ((S'_outer ξ).card : ℝ)
      _ ≤ ∑ ξ : ι_real → Fin 2, (((S_main_slice ξ).card : ℝ) + (S_collar.card : ℝ)) :=
        Finset.sum_le_sum (fun ξ _ => h_slice_card_le ξ)
      _ = (∑ ξ : ι_real → Fin 2, ((S_main_slice ξ).card : ℝ)) +
            ∑ _ξ : ι_real → Fin 2, (S_collar.card : ℝ) := Finset.sum_add_distrib
      _ = (∑ ξ : ι_real → Fin 2, ((S_main_slice ξ).card : ℝ)) +
            (2 : ℝ) ^ r₁ * (S_collar.card : ℝ) := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_fin,
          nsmul_eq_mul, Nat.cast_pow, Nat.cast_ofNat]
  let c_scale : ℝ := ((2 : ℝ) ^ r₁)⁻¹ * ((2 * Real.pi) ^ r₂)⁻¹
  have hc_scale_nonneg : 0 ≤ c_scale := by dsimp [c_scale]; positivity
  have h2r1_ne : (2 : ℝ) ^ r₁ ≠ 0 := by positivity
  have h2pir2_ne : (2 * Real.pi) ^ r₂ ≠ 0 := by positivity
  have hc_scale_vbox : c_scale * v_box = ((2 : ℝ) ^ r₁)⁻¹ * h ^ (r + r₂) := by
    dsimp [c_scale, v_box]
    calc ((2 : ℝ) ^ r₁)⁻¹ * ((2 * Real.pi) ^ r₂)⁻¹ * ((2 * Real.pi) ^ r₂ * h ^ (r + r₂))
      _ = ((2 : ℝ) ^ r₁)⁻¹ * (((2 * Real.pi) ^ r₂)⁻¹ * (2 * Real.pi) ^ r₂) * h ^ (r + r₂) := by ring
      _ = ((2 : ℝ) ^ r₁)⁻¹ * 1 * h ^ (r + r₂) := by rw [inv_mul_cancel₀ h2pir2_ne]
      _ = ((2 : ℝ) ^ r₁)⁻¹ * h ^ (r + r₂) := by ring
  have h_lhs_eq :
      ((2 : ℝ) ^ r₁)⁻¹ *
        (∑ ξ : ι_real → Fin 2, ((S_main_slice ξ).card : ℝ) * h ^ (r + r₂)) =
        (U_main.card : ℝ) * (((2 : ℝ) ^ r₁)⁻¹ * h ^ (r + r₂)) := by
    rw [← Finset.sum_mul, ← h_card_main]
    ring
  have h_vol_scaled_lo :
      (U_main.card : ℝ) * (((2 : ℝ) ^ r₁)⁻¹ * h ^ (r + r₂)) ≤
        c_scale * (MeasureTheory.volume Ω).toReal := by
    calc (U_main.card : ℝ) * (((2 : ℝ) ^ r₁)⁻¹ * h ^ (r + r₂))
      _ = c_scale * ((U_main.card : ℝ) * v_box) := by
        rw [← hc_scale_vbox]
        ring
      _ ≤ c_scale * (MeasureTheory.volume Ω).toReal :=
        mul_le_mul_of_nonneg_left h_vol_lo hc_scale_nonneg
  have h_vol_scaled_hi :
      c_scale * (MeasureTheory.volume Ω).toReal ≤
        (U_main.card : ℝ) * (((2 : ℝ) ^ r₁)⁻¹ * h ^ (r + r₂)) +
          (S_collar.card : ℝ) * h ^ (r + r₂) := by
    have h_outer_vbox :
        (U_outer.card : ℝ) * (((2 : ℝ) ^ r₁)⁻¹ * h ^ (r + r₂)) ≤
          ((U_main.card : ℝ) + (2 : ℝ) ^ r₁ * (S_collar.card : ℝ)) *
            (((2 : ℝ) ^ r₁)⁻¹ * h ^ (r + r₂)) :=
      mul_le_mul_of_nonneg_right h_sum_outer_le (by positivity)
    have h_cancel :
        ((U_main.card : ℝ) + (2 : ℝ) ^ r₁ * (S_collar.card : ℝ)) *
