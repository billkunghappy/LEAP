  have hc₁_ne : c₁ ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at hc₁_eq
    exact mul_ne_zero hγ₀_ne hc₂_ne hc₁_eq
  have hc₁_span : (B₀ : Ideal R) * (M₀ : Ideal R) = Ideal.span ({c₁} : Set R) := by
    have h_eq : Ideal.span ({γ} : Set R) * ((B₀ : Ideal R) * (M₀ : Ideal R)) =
        Ideal.span ({γ} : Set R) * Ideal.span ({c₁} : Set R) := by
      rw [← h_span_mul, Ideal.span_singleton_mul_span_singleton, hc₁_eq]
    exact mul_left_cancel₀ (Ideal.span_singleton_eq_bot.not.mpr hγ_ne_C) h_eq
  have hc₁_B₀ : c₁ ∈ (B₀ : Ideal R) := by
    have h1 : c₁ ∈ Ideal.span ({c₁} : Set R) := Ideal.mem_span_singleton_self c₁
    rw [← hc₁_span] at h1
    exact Ideal.mul_le_right h1
  have he_JC_congr : ∀ (z₁ z₂ : R),
      z₁ - z₂ ∈ (J_C : Ideal R) → Ideal.Quotient.mk f z₁ = Ideal.Quotient.mk f z₂ →
      e_K ((z₁ : K) * (x_star.1 : K) / (γ : K)) = e_K ((z₂ : K) * (x_star.1 : K) / (γ : K)) := by
    intro z₁ z₂ hz_JC hz_mk
    apply he_eq_of_sub
    have h_sub_eq : (z₁ : K) * (x_star.1 : K) / (γ : K) - (z₂ : K) * (x_star.1 : K) / (γ : K) =
        (((z₁ - z₂) * x_star.1 : R) : K) / (γ : K) := by push_cast; ring
    rw [h_sub_eq]
    apply h_trace_int γ ((z₁ - z₂) * x_star.1) hγ_ne_C
    have hz_f : z₁ - z₂ ∈ f := (Ideal.Quotient.mk_eq_mk_iff_sub_mem z₁ z₂).mp hz_mk
    have hz_fJC : z₁ - z₂ ∈ f * (J_C : Ideal R) := by
      rw [Ideal.mul_eq_inf_of_coprime (sup_comm (J_C : Ideal R) f ▸ hJC_cop)]
      exact ⟨hz_f, hz_JC⟩
    intro d hd
    rw [← hγ_span_C]
    have hd_z : d * (z₁ - z₂) ∈ differentIdeal ℤ R * f * (J_C : Ideal R) := by
      rw [mul_assoc]
      exact Ideal.mul_mem_mul hd hz_fJC
    rw [← mul_assoc]
    exact Ideal.mul_mem_mul hd_z x_star.2
  let u₁ : R ⧸ f := Ideal.Quotient.mk f c₁
  let u₂ : R ⧸ f := Ideal.Quotient.mk f c₂
  have he_align : ∀ a : R ⧸ f,
      e_K ((α (u₂ * a) : K) * (x_star.1 : K) / (γ : K)) =
        e_K ((β (u₁ * a) : K) * (x_star.1 : K) / (γ₀ : K)) := by
    intro a
    have h1 : e_K ((α (u₂ * a) : K) * (x_star.1 : K) / (γ : K)) =
        e_K (((c₂ * α a : R) : K) * (x_star.1 : K) / (γ : K)) := by
      refine he_JC_congr (α (u₂ * a)) (c₂ * α a) ?_ ?_
      · exact sub_mem (hα_mem_C (u₂ * a)) (Ideal.mul_mem_left _ c₂ (hα_mem_C a))
      · rw [hα_mk_C (u₂ * a), map_mul, hα_mk_C a]
    have h2 : (((c₂ * α a : R) : K) * (x_star.1 : K)) / (γ : K) =
        (((c₁ * α a : R) : K) * (x_star.1 : K)) / (γ₀ : K) := by
      have hγK_ne : (γ : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hγ_ne_C
      have hγ₀K_ne : (γ₀ : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hγ₀_ne
      have hc₁K_eq : (γ₀ : K) * (c₂ : K) = (γ : K) * (c₁ : K) := by exact_mod_cast hc₁_eq
      rw [div_eq_div_iff hγK_ne hγ₀K_ne]
      push_cast
      linear_combination (α a : K) * (x_star.1 : K) * hc₁K_eq
    have h3 : e_K (((c₁ * α a : R) : K) * (x_star.1 : K) / (γ₀ : K)) =
        e_K ((β (u₁ * a) : K) * (x_star.1 : K) / (γ₀ : K)) := by
      have h3a : ((c₁ * α a : R) : K) * (x_star.1 : K) = (((c₁ * α a) * x_star.1 : R) : K) := by
        push_cast; rfl
      have h3b : (β (u₁ * a) : K) * (x_star.1 : K) = ((β (u₁ * a) * x_star.1 : R) : K) := by
        push_cast; rfl
      rw [h3a, h3b]
      refine he_B₀_congr ((c₁ * α a) * x_star.1) (β (u₁ * a) * x_star.1) ?_ ?_
      · rw [← sub_mul]
        refine Ideal.mul_mem_right _ (B₀ : Ideal R) (sub_mem ?_ (hβ (u₁ * a)).1)
        exact Ideal.mul_mem_right _ (B₀ : Ideal R) hc₁_B₀
      · rw [map_mul, map_mul, map_mul, hα_mk_C a, (hβ (u₁ * a)).2]
    rw [h1, h2, h3]
  have hc₁_cop : Ideal.span ({c₁} : Set R) ⊔ f = ⊤ := by
    rw [← hc₁_span]
    exact h_cop_mul _ _ hB₀_cop hM₀_cop
  have hc₂_cop : Ideal.span ({c₂} : Set R) ⊔ f = ⊤ := by
    rw [← hc₂_span']
    exact h_cop_mul _ _ (h_cop_mul _ _ hJC_cop hJstar_cop) hM₀_cop
  have hu₁ : IsUnit u₁ := (h_unit_iff_sup c₁).mpr hc₁_cop
  have hu₂ : IsUnit u₂ := (h_unit_iff_sup c₂).mpr hc₂_cop
  let u₁_unit : (R ⧸ f)ˣ := hu₁.unit
  have hu₁_eq : (u₁_unit : R ⧸ f) = u₁ := hu₁.unit_spec
  let equiv₁ : (R ⧸ f) ≃ (R ⧸ f) :=
    { toFun := fun a => u₁ * a
      invFun := fun a => ↑(u₁_unit⁻¹) * a
      left_inv := fun a => by dsimp; rw [← mul_assoc, ← hu₁_eq, Units.inv_mul, one_mul]
      right_inv := fun a => by dsimp; rw [← mul_assoc, ← hu₁_eq, Units.mul_inv, one_mul] }
  let u₂_unit : (R ⧸ f)ˣ := hu₂.unit
  have hu₂_eq : (u₂_unit : R ⧸ f) = u₂ := hu₂.unit_spec
  let equiv₂ : (R ⧸ f) ≃ (R ⧸ f) :=
    { toFun := fun a => u₂ * a
      invFun := fun a => ↑(u₂_unit⁻¹) * a
      left_inv := fun a => by dsimp; rw [← mul_assoc, ← hu₂_eq, Units.inv_mul, one_mul]
      right_inv := fun a => by dsimp; rw [← mul_assoc, ← hu₂_eq, Units.mul_inv, one_mul] }
  let G_C : ℂ := ∑ a : R ⧸ f, ψ_f a * e_K ((α a : K) * (x_star.1 : K) / (γ : K))
  have h_GC_reindex : G_C = ψ_f u₂ * ∑ a : R ⧸ f,
      ψ_f a * e_K ((β (u₁ * a) : K) * (x_star.1 : K) / (γ₀ : K)) := by
    have h_eq1 : (∑ a : R ⧸ f, ψ_f (u₂ * a) * e_K ((α (u₂ * a) : K) * (x_star.1 : K) / (γ : K))) = G_C :=
      Fintype.sum_equiv equiv₂
        (fun a => ψ_f (u₂ * a) * e_K ((α (u₂ * a) : K) * (x_star.1 : K) / (γ : K)))
        (fun a => ψ_f a * e_K ((α a : K) * (x_star.1 : K) / (γ : K)))
        (fun _ => rfl)
    rw [← h_eq1, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [hψ_mul u₂ a, he_align a, mul_assoc]
  have h_G0_reindex : G₀ x_star.1 = ψ_f u₁ * ∑ a : R ⧸ f,
      ψ_f a * e_K ((β (u₁ * a) : K) * (x_star.1 : K) / (γ₀ : K)) := by
    have h_eq1 : (∑ a : R ⧸ f, ψ_f (u₁ * a) * e_K ((β (u₁ * a) : K) * (x_star.1 : K) / (γ₀ : K))) = G₀ x_star.1 :=
      Fintype.sum_equiv equiv₁
        (fun a => ψ_f (u₁ * a) * e_K ((β (u₁ * a) : K) * (x_star.1 : K) / (γ₀ : K)))
        (fun a => ψ_f a * e_K ((β a : K) * (x_star.1 : K) / (γ₀ : K)))
        (fun _ => rfl)
    rw [← h_eq1, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [hψ_mul u₁ a, mul_assoc]
  have h_u1_GC : ψ_f u₁ * G_C = ψ_f u₂ * G₀ x_star.1 := by
    rw [h_GC_reindex, h_G0_reindex]
    ring
  have h_span_c₁ : χ₀ B₀ * χ₀ M₀ * E_v c₁ = ψ_f u₁ * S_ang c₁ := by
    rw [← map_mul]
    have h_sub : B₀ * M₀ = ⟨Ideal.span ({c₁} : Set R),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hc₁_ne)⟩ :=
      Subtype.ext hc₁_span
    rw [h_sub]
    exact hψ_span c₁ hc₁_ne
  have h_span_c₂ : χ₀ J_C * χ₀ J_star * χ₀ M₀ * E_v c₂ = ψ_f u₂ * S_ang c₂ := by
    rw [← map_mul, ← map_mul]
    have h_sub : J_C * J_star * M₀ = ⟨Ideal.span ({c₂} : Set R),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hc₂_ne)⟩ :=
      Subtype.ext hc₂_span'
    rw [h_sub]
    exact hψ_span c₂ hc₂_ne
  have h_S_cross : S_ang γ₀ * S_ang c₂ = S_ang γ * S_ang c₁ := by
    rw [← hS_mul, ← hS_mul, hc₁_eq]
  have h_E_cross : E_v γ₀ * E_v c₂ = E_v γ * E_v c₁ := by
    rw [← hE_mul γ₀ c₂ hγ₀_ne hc₂_ne, ← hE_mul γ c₁ hγ_ne_C hc₁_ne, hc₁_eq]
  have h_S_c₁_conj : star (S_ang c₁) * S_ang c₁ = 1 :=
    h_star_mul_eq_one (S_ang c₁) (hS_norm c₁ hc₁_ne)
  have h_S_c₂_conj : star (S_ang c₂) * S_ang c₂ = 1 :=
    h_star_mul_eq_one (S_ang c₂) (hS_norm c₂ hc₂_ne)
  have h_E_c₁_conj : star (E_v c₁) * E_v c₁ = 1 :=
    h_star_mul_eq_one (E_v c₁) (hE_norm c₁)
  have h_E_γ₀_conj : star (E_v γ₀) * E_v γ₀ = 1 :=
    h_star_mul_eq_one (E_v γ₀) (hE_norm γ₀)
  have h_B₀_conj : star (χ₀ B₀) * χ₀ B₀ = 1 :=
    h_star_mul_eq_one (χ₀ B₀) ((hχ₀_norm_supp B₀).1 hB₀_cop)
  have h_M₀_conj : star (χ₀ M₀) * χ₀ M₀ = 1 :=
    h_star_mul_eq_one (χ₀ M₀) ((hχ₀_norm_supp M₀).1 hM₀_cop)
  have h_JC_conj : star (χ₀ J_C) * χ₀ J_C = 1 :=
    h_star_mul_eq_one (χ₀ J_C) ((hχ₀_norm_supp J_C).1 hJC_cop)
  have h_s3 : star (χ₀ J_C) * (S_ang γ * G_C) =
      S_ang γ₀ * star (E_v γ₀) * star (χ₀ B₀) * χ₀ J_star * E_v γ * G₀ x_star.1 := by
    have h_u1_eq : ψ_f u₁ = χ₀ B₀ * χ₀ M₀ * E_v c₁ * star (S_ang c₁) := by
      calc ψ_f u₁ = (ψ_f u₁ * S_ang c₁) * star (S_ang c₁) := by
            linear_combination -ψ_f u₁ * h_S_c₁_conj
        _ = χ₀ B₀ * χ₀ M₀ * E_v c₁ * star (S_ang c₁) := by rw [← h_span_c₁]
    have h_u2_eq : ψ_f u₂ = χ₀ J_C * χ₀ J_star * χ₀ M₀ * E_v c₂ * star (S_ang c₂) := by
      calc ψ_f u₂ = (ψ_f u₂ * S_ang c₂) * star (S_ang c₂) := by
            linear_combination -ψ_f u₂ * h_S_c₂_conj
        _ = χ₀ J_C * χ₀ J_star * χ₀ M₀ * E_v c₂ * star (S_ang c₂) := by rw [← h_span_c₂]
    have h_Sγ_eq : S_ang γ = S_ang γ₀ * S_ang c₂ * star (S_ang c₁) := by
      calc S_ang γ = (S_ang γ * S_ang c₁) * star (S_ang c₁) := by
            linear_combination -S_ang γ * h_S_c₁_conj
        _ = S_ang γ₀ * S_ang c₂ * star (S_ang c₁) := by rw [← h_S_cross]
    have h_Ec₂_eq : E_v c₂ * star (E_v c₁) = star (E_v γ₀) * E_v γ := by
      calc E_v c₂ * star (E_v c₁)
        _ = (star (E_v γ₀) * E_v γ₀) * E_v c₂ * star (E_v c₁) := by
            rw [h_E_γ₀_conj, one_mul]
        _ = star (E_v γ₀) * (E_v γ₀ * E_v c₂) * star (E_v c₁) := by ring
        _ = star (E_v γ₀) * (E_v γ * E_v c₁) * star (E_v c₁) := by rw [h_E_cross]
        _ = star (E_v γ₀) * E_v γ * (star (E_v c₁) * E_v c₁) := by ring
        _ = star (E_v γ₀) * E_v γ := by rw [h_E_c₁_conj, mul_one]
    have h_u1_inv : (star (χ₀ B₀) * star (χ₀ M₀) * star (E_v c₁) * S_ang c₁) * ψ_f u₁ = 1 := by
      calc (star (χ₀ B₀) * star (χ₀ M₀) * star (E_v c₁) * S_ang c₁) * ψ_f u₁
        _ = (star (χ₀ B₀) * χ₀ B₀) * (star (χ₀ M₀) * χ₀ M₀) *
              (star (E_v c₁) * E_v c₁) * (star (S_ang c₁) * S_ang c₁) := by
            rw [h_u1_eq]; ring
        _ = 1 := by
            rw [h_B₀_conj, h_M₀_conj, h_E_c₁_conj, h_S_c₁_conj]; ring
    calc star (χ₀ J_C) * (S_ang γ * G_C)
      _ = star (χ₀ J_C) * S_ang γ *
            ((star (χ₀ B₀) * star (χ₀ M₀) * star (E_v c₁) * S_ang c₁) * ψ_f u₁) * G_C := by
          rw [h_u1_inv]; ring
      _ = star (χ₀ J_C) * S_ang γ *
            (star (χ₀ B₀) * star (χ₀ M₀) * star (E_v c₁) * S_ang c₁) * (ψ_f u₁ * G_C) := by ring
      _ = star (χ₀ J_C) * S_ang γ *
            (star (χ₀ B₀) * star (χ₀ M₀) * star (E_v c₁) * S_ang c₁) * (ψ_f u₂ * G₀ x_star.1) := by
          rw [h_u1_GC]
      _ = S_ang γ₀ * star (χ₀ B₀) * χ₀ J_star * (E_v c₂ * star (E_v c₁)) * G₀ x_star.1 *
            (star (S_ang c₁) * S_ang c₁) * (star (χ₀ J_C) * χ₀ J_C) *
            (star (χ₀ M₀) * χ₀ M₀) * (star (S_ang c₂) * S_ang c₂) := by
          rw [h_Sγ_eq, h_u2_eq]; ring
      _ = S_ang γ₀ * star (χ₀ B₀) * χ₀ J_star * (E_v c₂ * star (E_v c₁)) * G₀ x_star.1 := by
          rw [h_S_c₁_conj, h_JC_conj, h_M₀_conj, h_S_c₂_conj]; ring
      _ = S_ang γ₀ * star (E_v γ₀) * star (χ₀ B₀) * χ₀ J_star * E_v γ * G₀ x_star.1 := by
          rw [h_Ec₂_eq]; ring
  rw [tsum_fintype]
  change star (χ₀ J_C) *
      ((-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
        S_ang γ * ((N_f_inv_sqrt : ℂ) * G_C)) =
    ω_χ * χ₀ J_star * E_v γ * star (ψ_f (Ideal.Quotient.mk f x_star.1))
  calc star (χ₀ J_C) *
      ((-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
        S_ang γ * ((N_f_inv_sqrt : ℂ) * G_C))
    _ = (-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
          (N_f_inv_sqrt : ℂ) * (star (χ₀ J_C) * (S_ang γ * G_C)) := by ring
    _ = (-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
          (N_f_inv_sqrt : ℂ) *
          (S_ang γ₀ * star (E_v γ₀) * star (χ₀ B₀) * χ₀ J_star * E_v γ * G₀ x_star.1) := by
        rw [h_s3]
    _ = (-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
          S_ang γ₀ * star (E_v γ₀) * star (χ₀ B₀) *
          ((N_f_inv_sqrt : ℂ) * (τ_sum * star (ψ_f (Ideal.Quotient.mk f x_star.1)))) *
          χ₀ J_star * E_v γ := by
        rw [hG₀_eval x_star.1]
        ring
    _ = ω_χ * χ₀ J_star * E_v γ * star (ψ_f (Ideal.Quotient.mk f x_star.1)) := by
        dsimp [ω_χ, τ₀]
        ring

theorem mitsui_infinitePlace_complex_harmonic_euclidean_trace_duality {K : Type u} [Field K] [NumberField K]
    (v₁ v₂ : Fin (Module.finrank ℚ K) → K)
    (γ : K) (hγ : γ ≠ 0)
    (Δ : ℝ) (hΔ : 0 < Δ)
    (h_dual : ∀ i j : Fin (Module.finrank ℚ K),
      (Algebra.trace ℚ K (v₁ i * (v₂ j / γ)) : ℝ) = if i = j then 1 else 0)
    (h_det : |(Matrix.of (fun i j : Fin (Module.finrank ℚ K) =>
        (Algebra.trace ℚ K (v₁ i * v₁ j) : ℝ))).det| = Δ ^ 2)
    (l_eff : NumberField.InfinitePlace K → ℤ)
    (hl_eff_real : ∀ w : NumberField.InfinitePlace K, w.IsReal → (l_eff w = 0 ∨ l_eff w = 1))
    (t : NumberField.InfinitePlace K → ℝ) (ht : ∀ w : NumberField.InfinitePlace K, 0 < t w) :
    let n : ℕ := Module.finrank ℚ K
    let a_place : NumberField.InfinitePlace K → ℕ := fun w => (l_eff w).natAbs
    ∃ (A : Matrix (Fin n) (Fin n) ℝ)
      (d : Fin n → ℕ)
      (p : Fin n → Fin n)
      (s : Fin n → ℝ)
      (c_deg : Fin n → ℕ),
      A.det ≠ 0 ∧
      |A.det| = Δ * ∏ w : NumberField.InfinitePlace K, (t w) ^ ((w.mult : ℝ) / 2) ∧
      (∀ j : Fin n, d j ≤ 1) ∧
      (∀ j : Fin n, c_deg j ≠ 0 → p j ≠ j) ∧
      (∀ j : Fin n, c_deg j ≠ 0 → s j ^ 2 = 1) ∧
      (∀ j : Fin n, c_deg j ≠ 0 → d j = 0 ∧ d (p j) = 0) ∧
      (∀ j₁ j₂ : Fin n, c_deg j₁ ≠ 0 → c_deg j₂ ≠ 0 → j₁ ≠ j₂ →
        j₁ ≠ p j₂ ∧ p j₁ ≠ j₂ ∧ p j₁ ≠ p j₂) ∧
      (∑ j : Fin n, d j) + (∑ j : Fin n, c_deg j) = ∑ w : NumberField.InfinitePlace K, a_place w ∧
      (∀ q : Fin n → ℚ,
        (∏ w : NumberField.InfinitePlace K,
          (w (∑ i : Fin n, (q i : K) * v₁ i) * (t w) ^ (1 / 2 : ℝ)) ^ (a_place w)) =
        (∏ j : Fin n, |A.mulVec (fun i => (q i : ℝ)) j| ^ (d j)) *
          ∏ j : Fin n,
            ‖(((A.mulVec (fun i => (q i : ℝ)) j : ℂ) +
                (s j : ℂ) * (A.mulVec (fun i => (q i : ℝ)) (p j) : ℂ) * Complex.I) /
              (Real.sqrt 2 : ℂ))‖ ^ (c_deg j)) ∧
      (∀ q : Fin n → ℚ,
        (∏ w : NumberField.InfinitePlace K,
          ((if 0 ≤ l_eff w then w.embedding (∑ i : Fin n, (q i : K) * v₁ i)
            else star (w.embedding (∑ i : Fin n, (q i : K) * v₁ i))) *
            (((t w) ^ (1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) =
        (((∏ j : Fin n, (A.mulVec (fun i => (q i : ℝ)) j) ^ (d j) : ℝ) : ℂ)) *
          ∏ j : Fin n,
            (((A.mulVec (fun i => (q i : ℝ)) j : ℂ) +
                (s j : ℂ) * (A.mulVec (fun i => (q i : ℝ)) (p j) : ℂ) * Complex.I) /
              (Real.sqrt 2 : ℂ)) ^ (c_deg j)) ∧
      (∀ q : Fin n → ℚ,
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * t w * (w (∑ i : Fin n, (q i : K) * v₁ i)) ^ 2) =
        ∑ j : Fin n, (A.mulVec (fun i => (q i : ℝ)) j) ^ 2) ∧
      (∀ l : Fin n → ℤ,
        (∏ w : NumberField.InfinitePlace K,
          ((w (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / w γ) * (t w) ^ (-1 / 2 : ℝ)) ^ (a_place w)) =
        (∏ j : Fin n, |A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j| ^ (d j)) *
          ∏ j : Fin n,
