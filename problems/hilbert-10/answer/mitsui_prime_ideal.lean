    let x_g : R := (u_g : R)
    have hx_g : x_g ≠ 0 := Units.ne_zero u_g
    have hw_g : ∀ w : NumberField.InfinitePlace K, w (x_g : K) = 1 :=
      fun w => (NumberField.Units.mem_torsion K).mp g₀.2 w
    have hP_g : P x_g hx_g = 1 := by
      apply Subtype.ext
      change Ideal.span ({x_g} : Set R) = 1
      rw [Ideal.one_eq_top]
      exact Ideal.span_singleton_eq_top.mpr u_g.isUnit
    have hχ_g : χ₀ (P x_g hx_g) = 1 := by rw [hP_g, map_one]
    have hE_g : E_log x_g = 1 := by
      dsimp [E_log]
      have h_sum_zero : (∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x_g : K))) = 0 :=
