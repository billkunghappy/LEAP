            ((w.embedding (((ζ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ^ (l_ang w) *
              (Φ_τ I_x w) ^ (l_ang w)) *
              Complex.exp
                ((l_ang w : ℂ) *
                  (((∑ j : Fin r, y j * (w.embedding (η j)).arg) : ℝ) * Complex.I)) := by
        intro w
