        (MeasureTheory.volume (U ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) w₀ w)).toReal)
  have h_shell_each : ∀ (w₀ : NumberField.InfinitePlace K) (j : Fin L),
      |S_shell w₀ j - κ₀ * W_shell w₀ j| ≤ c_shell * Y * Real.exp (-t / c_shell) := by
    intro w₀ j
    let R₁ : ℝ := (X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)
    let R₀ : ℝ := (X / (L : ℝ)) * ((j : ℕ) : ℝ)
    have hR₁_pos : 0 < R₁ := by dsimp [R₁]; positivity
    have hR₁_ne : R₁ ≠ 0 := ne_of_gt hR₁_pos
    have hR₀₁ : R₀ ≤ R₁ := by
      dsimp [R₀, R₁]
      exact mul_le_mul_of_nonneg_left (by linarith) (by positivity)
    have hj_le : ((j : ℕ) : ℝ) + 1 ≤ (L : ℝ) := by
      have hj_nat : (j : ℕ) + 1 ≤ L := j.2
      exact_mod_cast hj_nat
    have hR₁_le : R₁ ≤ X := by
      dsimp [R₁]
      rw [div_mul_eq_mul_div, div_le_iff₀ hL_rpos]
      exact mul_le_mul_of_nonneg_left hj_le (le_of_lt hX_pos)
    let S_cone : ℝ → ℝ := fun R =>
      ∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧
            (∀ i : NumberField.mixedEmbedding.index K,
              R₁ *
                ((NumberField.mixedEmbedding.stdBasis K).repr
                    (NumberField.mixedEmbedding K (π : K)) i / w₀ (π : K)) ∈
                Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
            (∀ w : NumberField.InfinitePlace K,
              1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
            w₀ (π : K) < R},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
    let M_cone : ℝ → ℝ := fun R =>
      if 1 < R then
        κ₀ * ((Module.finrank ℚ K : ℝ)⁻¹ * ((R / R₁) ^ (Module.finrank ℚ K)) *
          ∏ w : NumberField.InfinitePlace K, (MeasureTheory.volume (U R₁ w₀ w)).toReal)
      else 0
    have h_eq_c :=
      mitsui_prime_char_decoupled_conical_shell_eq_sub_cone X hX m hm R₁ R₀ hR₀₁ hR₁_le k w₀ q₀ ψ₀
    have h_sh_c :
        (∑' π : {π : NumberField.RingOfIntegers K //
              Prime π ∧
              (∀ i : NumberField.mixedEmbedding.index K,
                R₁ *
                  ((NumberField.mixedEmbedding.stdBasis K).repr
                      (NumberField.mixedEmbedding K (π : K)) i / w₀ (π : K)) ∈
                  Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                    ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
              (∀ w : NumberField.InfinitePlace K,
                1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
              w₀ (π : K) ∈ Set.Ico R₀ R₁ ∧
              IsUnit (Ideal.Quotient.mk q₀ π)},
            ψ₀ (Additive.ofMul π.2.2.2.2.2.unit) *
              (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) =
        (S_shell w₀ j : ℂ) :=
      h_tsum_cast _ _
        (fun x => ⟨fun ⟨h1, h2, h3, h4, _⟩ => ⟨h1, h2, h3, h4⟩,
          fun ⟨h1, h2, h3, h4⟩ => ⟨h1, h2, h3, h4, h_unit x⟩⟩) _
    have h_cone_c : ∀ R : ℝ,
        (∑' π : {π : NumberField.RingOfIntegers K //
              Prime π ∧
              (∀ i : NumberField.mixedEmbedding.index K,
                R₁ *
                  ((NumberField.mixedEmbedding.stdBasis K).repr
                      (NumberField.mixedEmbedding K (π : K)) i / w₀ (π : K)) ∈
                  Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                    ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
              (∀ w : NumberField.InfinitePlace K,
                1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
              w₀ (π : K) < R ∧
              IsUnit (Ideal.Quotient.mk q₀ π)},
            ψ₀ (Additive.ofMul π.2.2.2.2.2.unit) *
              (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) =
        (S_cone R : ℂ) :=
      fun R => h_tsum_cast _ _
        (fun x => ⟨fun ⟨h1, h2, h3, h4, _⟩ => ⟨h1, h2, h3, h4⟩,
          fun ⟨h1, h2, h3, h4⟩ => ⟨h1, h2, h3, h4, h_unit x⟩⟩) _
    rw [h_sh_c, h_cone_c R₁, h_cone_c R₀, ← Complex.ofReal_sub] at h_eq_c
    have h_eq : S_shell w₀ j = S_cone R₁ - S_cone R₀ := Complex.ofReal_injective h_eq_c
    have h_M_eq : M_cone R₁ - M_cone R₀ = κ₀ * W_shell w₀ j := by
      dsimp [M_cone, W_shell, R₁, R₀]
      rw [div_self hR₁_ne, one_pow]
      split_ifs <;> ring
    have h_cone_le : ∀ R : ℝ, R ≤ R₁ →
        |S_cone R - M_cone R| ≤ c_cone * Y * Real.exp (-t / c_shell) := by
      intro R hR_le
      by_cases hR_gt : 1 < R
      · have hR₁_gt : 1 < R₁ := lt_of_lt_of_le hR_gt hR_le
        have h_c := hc_cone X hX m hm hm_coarse R₁ hR₁_gt hR₁_le R hR_gt hR_le k w₀
        have hexp_cone : Real.exp (-t / c_cone) ≤ Real.exp (-t / c_shell) := by
          rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
          exact div_le_div_of_nonneg_left ht_nonneg hc_cone_pos (by dsimp [c_shell]; linarith)
        have hM_pos : M_cone R =
            κ₀ * ((Module.finrank ℚ K : ℝ)⁻¹ * ((R / R₁) ^ (Module.finrank ℚ K)) *
              ∏ w : NumberField.InfinitePlace K, (MeasureTheory.volume (U R₁ w₀ w)).toReal) :=
          if_pos hR_gt
        rw [hM_pos]
        calc |S_cone R -
              κ₀ * ((Module.finrank ℚ K : ℝ)⁻¹ * ((R / R₁) ^ (Module.finrank ℚ K)) *
                ∏ w : NumberField.InfinitePlace K, (MeasureTheory.volume (U R₁ w₀ w)).toReal)|
          _ ≤ c_cone * Y * Real.exp (-t / c_cone) := h_c
          _ ≤ c_cone * Y * Real.exp (-t / c_shell) :=
              mul_le_mul_of_nonneg_left hexp_cone (by positivity)
      · have h_emp : IsEmpty {π : NumberField.RingOfIntegers K //
              Prime π ∧
              (∀ i : NumberField.mixedEmbedding.index K,
                R₁ *
                  ((NumberField.mixedEmbedding.stdBasis K).repr
                      (NumberField.mixedEmbedding K (π : K)) i / w₀ (π : K)) ∈
                  Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                    ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
              (∀ w : NumberField.InfinitePlace K,
                1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
              w₀ (π : K) < R} := by
          refine ⟨fun π => ?_⟩
          have hw1 : 1 ≤ w₀ (π.1 : K) := (π.2.2.2.1 w₀).1
          have hw2 : w₀ (π.1 : K) < R := π.2.2.2.2
          linarith
        have h_zero : S_cone R = 0 := by
          dsimp [S_cone]
          exact @tsum_empty _ _ _ _ _ _ h_emp
        have hM_neg : M_cone R = 0 := if_neg hR_gt
        rw [h_zero, hM_neg, sub_self, abs_zero]
        positivity
    rw [h_eq, ← h_M_eq]
    have h_ident_cone : (S_cone R₁ - S_cone R₀) - (M_cone R₁ - M_cone R₀) =
        (S_cone R₁ - M_cone R₁) - (S_cone R₀ - M_cone R₀) := by ring
    rw [h_ident_cone]
    calc |(S_cone R₁ - M_cone R₁) - (S_cone R₀ - M_cone R₀)|
      _ ≤ |S_cone R₁ - M_cone R₁| + |S_cone R₀ - M_cone R₀| := abs_sub _ _
      _ ≤ c_cone * Y * Real.exp (-t / c_shell) + c_cone * Y * Real.exp (-t / c_shell) :=
          add_le_add (h_cone_le R₁ (le_refl R₁)) (h_cone_le R₀ hR₀₁)
      _ = c_shell * Y * Real.exp (-t / c_shell) := by
          dsimp [c_shell]; ring
  set W_tot : ℝ := ∑ w₀ : NumberField.InfinitePlace K, ∑ j : Fin L, W_shell w₀ j
  have h_diff2_raw : |S_shell_tot - κ₀ * W_tot| ≤
      (M : ℝ) * (L : ℝ) * (c_shell * Y * Real.exp (-t / c_shell)) := by
    have h_sub : S_shell_tot - κ₀ * W_tot =
        ∑ w₀ : NumberField.InfinitePlace K, ∑ j : Fin L, (S_shell w₀ j - κ₀ * W_shell w₀ j) := by
      dsimp [S_shell_tot, W_tot]
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun w₀ _ => ?_)
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
    rw [h_sub]
    calc |∑ w₀ : NumberField.InfinitePlace K, ∑ j : Fin L, (S_shell w₀ j - κ₀ * W_shell w₀ j)|
      _ ≤ ∑ w₀ : NumberField.InfinitePlace K, |∑ j : Fin L, (S_shell w₀ j - κ₀ * W_shell w₀ j)| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ w₀ : NumberField.InfinitePlace K, ∑ j : Fin L, |S_shell w₀ j - κ₀ * W_shell w₀ j| :=
          Finset.sum_le_sum (fun w₀ _ => Finset.abs_sum_le_sum_abs _ _)
      _ ≤ ∑ _w₀ : NumberField.InfinitePlace K, ∑ _j : Fin L,
            (c_shell * Y * Real.exp (-t / c_shell)) :=
          Finset.sum_le_sum (fun w₀ _ => Finset.sum_le_sum (fun j _ => h_shell_each w₀ j))
      _ = (M : ℝ) * (L : ℝ) * (c_shell * Y * Real.exp (-t / c_shell)) := by
          simp [M, Finset.sum_const, nsmul_eq_mul, Fintype.card_fin, mul_assoc]
  have h_diff2_bound : |S_shell_tot - κ₀ * W_tot| ≤
      A_shell * Y * Real.exp (-t / (2 * c_shell)) := by
    calc |S_shell_tot - κ₀ * W_tot|
      _ ≤ (M : ℝ) * (L : ℝ) * (c_shell * Y * Real.exp (-t / c_shell)) := h_diff2_raw
      _ ≤ (M : ℝ) * (K₀ * Real.exp (t / (2 * c_shell))) *
            (c_shell * Y * Real.exp (-t / c_shell)) := by
          gcongr
      _ = A_shell * Y * (Real.exp (t / (2 * c_shell)) * Real.exp (-t / c_shell)) := by
          dsimp [A_shell]; ring
      _ = A_shell * Y * Real.exp (-t / (2 * c_shell)) := by
          rw [← Real.exp_add]
          congr 2
          ring
  have h_wsum := hc_sum X hX m hm L hL k hQ_bdd
  have h_wsum_le : |W_tot - (X / (m : ℝ)) ^ (Module.finrank ℚ K)| ≤
      2 * c_sum * Y * Real.exp (-c' * t) + c_sum * Y * Real.exp (-t / c_sum) := by
    change |W_tot - (X / (m : ℝ)) ^ (Module.finrank ℚ K)| ≤ _ at h_wsum
    have h1 : c_sum * Y * ((Real.log X + 1) / (L : ℝ)) ≤
        c_sum * Y * (2 * Real.exp (-c' * t)) :=
      mul_le_mul_of_nonneg_left h_ratio (by positivity)
    linarith
  have h_diff3_bound : |κ₀ * W_tot - κ₀ * (X / (m : ℝ)) ^ (Module.finrank ℚ K)| ≤
      2 * κ₀ * c_sum * Y * Real.exp (-c' * t) + κ₀ * c_sum * Y * Real.exp (-t / c_sum) := by
    rw [← mul_sub, abs_mul, abs_of_pos hκ₀_pos]
    calc κ₀ * |W_tot - (X / (m : ℝ)) ^ (Module.finrank ℚ K)|
      _ ≤ κ₀ * (2 * c_sum * Y * Real.exp (-c' * t) + c_sum * Y * Real.exp (-t / c_sum)) :=
          mul_le_mul_of_nonneg_left h_wsum_le (le_of_lt hκ₀_pos)
      _ = 2 * κ₀ * c_sum * Y * Real.exp (-c' * t) + κ₀ * c_sum * Y * Real.exp (-t / c_sum) := by
          ring
  have h_ident :
      S_tot - κ₀ * (X / (m : ℝ)) ^ (Module.finrank ℚ K) =
      (S_tot - S_shell_tot) + (S_shell_tot - κ₀ * W_tot) +
        (κ₀ * W_tot - κ₀ * (X / (m : ℝ)) ^ (Module.finrank ℚ K)) := by ring
  have h_tri :
      |S_tot - κ₀ * (X / (m : ℝ)) ^ (Module.finrank ℚ K)| ≤
      |S_tot - S_shell_tot| + |S_shell_tot - κ₀ * W_tot| +
        |κ₀ * W_tot - κ₀ * (X / (m : ℝ)) ^ (Module.finrank ℚ K)| := by
    rw [h_ident]
    have ht1 := abs_add_le
      ((S_tot - S_shell_tot) + (S_shell_tot - κ₀ * W_tot))
      (κ₀ * W_tot - κ₀ * (X / (m : ℝ)) ^ (Module.finrank ℚ K))
    have ht2 := abs_add_le
      (S_tot - S_shell_tot)
      (S_shell_tot - κ₀ * W_tot)
    linarith
  have hc'_inv_le : 1 / c' ≤ c_sec := by
    have : 0 ≤ 3 * (M : ℝ) * c_col + A_shell + 3 * κ₀ * c_sum + c_col + 2 * c_shell + c_sum := by
      positivity
    dsimp [c_sec]; linarith
  have hc_col_le : c_col ≤ c_sec := by
    have : 0 ≤ 3 * (M : ℝ) * c_col + A_shell + 3 * κ₀ * c_sum + 1 / c' + 2 * c_shell + c_sum := by
      positivity
    dsimp [c_sec]; linarith
  have h2c_shell_le : 2 * c_shell ≤ c_sec := by
    have : 0 ≤ 3 * (M : ℝ) * c_col + A_shell + 3 * κ₀ * c_sum + c_col + 1 / c' + c_sum := by
      positivity
    dsimp [c_sec]; linarith
  have hc_sum_le : c_sum ≤ c_sec := by
    have : 0 ≤ 3 * (M : ℝ) * c_col + A_shell + 3 * κ₀ * c_sum + c_col + 1 / c' + 2 * c_shell := by
      positivity
    dsimp [c_sec]; linarith
  have hexp_c' : Real.exp (-c' * t) ≤ Real.exp (-t / c_sec) := by
    have h_eq : -c' * t = -t / (1 / c') := by
      have hc'_ne : c' ≠ 0 := ne_of_gt hc'_pos
      field_simp [hc'_ne]
    rw [h_eq, Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg (by positivity) hc'_inv_le
  have hexp_col : Real.exp (-t / c_col) ≤ Real.exp (-t / c_sec) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg hc_col_pos hc_col_le
  have hexp_shell : Real.exp (-t / (2 * c_shell)) ≤ Real.exp (-t / c_sec) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg (by positivity) h2c_shell_le
  have hexp_sum : Real.exp (-t / c_sum) ≤ Real.exp (-t / c_sec) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg hc_sum_pos hc_sum_le
  have hterm₁ : 2 * (M : ℝ) * c_col * Y * Real.exp (-c' * t) ≤
      2 * (M : ℝ) * c_col * Y * Real.exp (-t / c_sec) :=
    mul_le_mul_of_nonneg_left hexp_c' (by positivity)
  have hterm₂ : (M : ℝ) * c_col * Y * Real.exp (-t / c_col) ≤
      (M : ℝ) * c_col * Y * Real.exp (-t / c_sec) :=
    mul_le_mul_of_nonneg_left hexp_col (by positivity)
  have hterm₃ : A_shell * Y * Real.exp (-t / (2 * c_shell)) ≤
      A_shell * Y * Real.exp (-t / c_sec) :=
    mul_le_mul_of_nonneg_left hexp_shell (by positivity)
  have hterm₄ : 2 * κ₀ * c_sum * Y * Real.exp (-c' * t) ≤
      2 * κ₀ * c_sum * Y * Real.exp (-t / c_sec) :=
    mul_le_mul_of_nonneg_left hexp_c' (by positivity)
  have hterm₅ : κ₀ * c_sum * Y * Real.exp (-t / c_sum) ≤
      κ₀ * c_sum * Y * Real.exp (-t / c_sec) :=
    mul_le_mul_of_nonneg_left hexp_sum (by positivity)
  have h_sum_all_le :
      2 * (M : ℝ) * c_col * Y * Real.exp (-t / c_sec) +
      (M : ℝ) * c_col * Y * Real.exp (-t / c_sec) +
      A_shell * Y * Real.exp (-t / c_sec) +
      2 * κ₀ * c_sum * Y * Real.exp (-t / c_sec) +
      κ₀ * c_sum * Y * Real.exp (-t / c_sec) ≤
      c_sec * Y * Real.exp (-t / c_sec) := by
    have h_coeff :
        2 * (M : ℝ) * c_col + (M : ℝ) * c_col + A_shell + 2 * κ₀ * c_sum + κ₀ * c_sum ≤ c_sec := by
      have : 0 ≤ c_col + 1 / c' + 2 * c_shell + c_sum := by positivity
      dsimp [c_sec]; linarith
    have hYE_nonneg : 0 ≤ Y * Real.exp (-t / c_sec) := by positivity
    calc 2 * (M : ℝ) * c_col * Y * Real.exp (-t / c_sec) +
        (M : ℝ) * c_col * Y * Real.exp (-t / c_sec) +
        A_shell * Y * Real.exp (-t / c_sec) +
        2 * κ₀ * c_sum * Y * Real.exp (-t / c_sec) +
        κ₀ * c_sum * Y * Real.exp (-t / c_sec)
      _ = (2 * (M : ℝ) * c_col + (M : ℝ) * c_col + A_shell + 2 * κ₀ * c_sum + κ₀ * c_sum) *
            (Y * Real.exp (-t / c_sec)) := by ring
      _ ≤ c_sec * (Y * Real.exp (-t / c_sec)) := mul_le_mul_of_nonneg_right h_coeff hYE_nonneg
      _ = c_sec * Y * Real.exp (-t / c_sec) := by ring
  change |S_tot - κ₀ * (X / (m : ℝ)) ^ (Module.finrank ℚ K)| ≤ c_sec * Y * Real.exp (-t / c_sec)
  linarith

theorem mitsui_vonMangoldt_cone_to_prime {K : Type u} [Field K] [NumberField K] :
    ∃ c_cp : ℝ, 0 < c_cp ∧
      ∀ X : ℝ, 1 < X →
        |(∑' x : {x : NumberField.RingOfIntegers K //
              NumberField.mixedEmbedding K (x : K) ∈
                NumberField.mixedEmbedding.fundamentalCone K ∧
              NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤
                X ^ (Module.finrank ℚ K)},
            vonMangoldtO (x : NumberField.RingOfIntegers K))
          - (∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧
                NumberField.mixedEmbedding K (π : K) ∈
                  NumberField.mixedEmbedding.fundamentalCone K ∧
                NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤
                  X ^ (Module.finrank ℚ K)},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))|
          ≤ c_cp * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cp) :=
by
  classical
  have h_norm_span : ∀ x : NumberField.RingOfIntegers K,
      (Ideal.absNorm (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))) : ℝ) =
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) := by
    intro x
    rw [Ideal.absNorm_span_singleton, NumberField.mixedEmbedding.norm_eq_norm,
      ← Algebra.coe_norm_int x, Nat.cast_natAbs]
    push_cast
    rfl
  have h_cone_fin : ∀ Y : ℝ,
      {x : NumberField.RingOfIntegers K |
        NumberField.mixedEmbedding K (x : K) ∈ NumberField.mixedEmbedding.fundamentalCone K ∧
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤ Y}.Finite := by
    intro Y
    let S_cone : Set (NumberField.RingOfIntegers K) :=
      {x : NumberField.RingOfIntegers K |
        NumberField.mixedEmbedding K (x : K) ∈ NumberField.mixedEmbedding.fundamentalCone K ∧
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤ Y}
    let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
      {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊}
    have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Y⌋₊
    haveI : Finite S_id := hSid_fin
    let a : S_cone → NumberField.mixedEmbedding.fundamentalCone.integerSet K :=
      fun x => ⟨NumberField.mixedEmbedding K (x.1 : K),
        NumberField.mixedEmbedding.fundamentalCone.mem_integerSet.mpr ⟨x.2.1, x.1, rfl⟩⟩
    have ha_pre : ∀ x : S_cone,
        (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet (a x) :
          NumberField.RingOfIntegers K) = x.1 :=
      fun x => NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet_mixedEmbedding (a x).2
    have h_span_mem : ∀ x : S_cone,
        Ideal.span ({x.1} : Set (NumberField.RingOfIntegers K)) ∈ S_id := by
      intro x
      show Ideal.absNorm (Ideal.span ({x.1} : Set (NumberField.RingOfIntegers K))) ≤ ⌊Y⌋₊
      apply Nat.le_floor
      rw [h_norm_span x.1]
      exact x.2.2
    let φ : S_cone → S_id × NumberField.Units.torsion K :=
      fun x => (⟨Ideal.span {x.1}, h_span_mem x⟩,
