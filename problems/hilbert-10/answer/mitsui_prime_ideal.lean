          _ = (5 / (4 * δ₀)) * L_q := by ring
      have hσ_sub_β_ge : δ₀ / L_q ≤ σ - β := by
        have : σ - 1 = δ₀ / L_q := by dsimp [σ]; ring
        linarith
      have hσ_sub_β_pos : 0 < σ - β := lt_of_lt_of_le (div_pos hδ₀_pos hLq_pos) hσ_sub_β_ge
      have hσ_sub_β_le : σ - β ≤ (6 * δ₀) / (5 * L_q) := by
        have h2 : B₁_eff / L_q ≤ (δ₀ / 5) / L_q :=
          div_le_div_of_nonneg_right hB₁_le_δ₀ (le_of_lt hLq_pos)
        have h3 : σ - β = δ₀ / L_q + (1 - β) := by dsimp [σ]; ring
        have h4 : δ₀ / L_q + (δ₀ / 5) / L_q = (6 * δ₀) / (5 * L_q) := by ring
        linarith
      have hγ_le_diff : |γ| ≤ (σ - β) / 5 := by
        have h1 : c₀ / L_q = (δ₀ / L_q) / 5 := by dsimp [c₀]; ring
        linarith
      have hγ_sq_le : γ ^ 2 ≤ (σ - β) ^ 2 / 25 := by
        nlinarith [abs_nonneg γ, sq_abs γ, hγ_le_diff]
      have h_denom_pos : 0 < (σ - β) ^ 2 + γ ^ 2 := by positivity
      have h_denom_le : (σ - β) ^ 2 + γ ^ 2 ≤ (5 / 4) * (σ - β) ^ 2 := by
        have : 0 ≤ (σ - β) ^ 2 := sq_nonneg _
        linarith
      have h_mul1 : 2 * (σ - β) ≤ (5 / (4 * δ₀)) * L_q * ((5 / 4) * (σ - β) ^ 2) := by
        calc 2 * (σ - β)
            ≤ (5 / (4 * δ₀)) * L_q * ((σ - β) ^ 2 + γ ^ 2) :=
              (div_le_iff₀ h_denom_pos).mp h_rep_upper
          _ ≤ (5 / (4 * δ₀)) * L_q * ((5 / 4) * (σ - β) ^ 2) :=
              mul_le_mul_of_nonneg_left h_denom_le (by positivity)
      have h_cancel : 2 ≤ (25 / (16 * δ₀)) * L_q * (σ - β) := by
        apply le_of_mul_le_mul_left _ hσ_sub_β_pos
        calc (σ - β) * 2
            = 2 * (σ - β) := by ring
          _ ≤ (5 / (4 * δ₀)) * L_q * ((5 / 4) * (σ - β) ^ 2) := h_mul1
          _ = (σ - β) * ((25 / (16 * δ₀)) * L_q * (σ - β)) := by ring
      have h_upper_final : (25 / (16 * δ₀)) * L_q * (σ - β) ≤ 15 / 8 := by
        calc (25 / (16 * δ₀)) * L_q * (σ - β)
            ≤ (25 / (16 * δ₀)) * L_q * ((6 * δ₀) / (5 * L_q)) :=
              mul_le_mul_of_nonneg_left hσ_sub_β_le (by positivity)
          _ = 15 / 8 := by
              field_simp [ne_of_gt hδ₀_pos, ne_of_gt hLq_pos]
              ring
      linarith

theorem mitsui_grossenchar_real_narrow_ray_and_nonprincipal_of_units_eq_one {K : Type u} [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (w₀ : NumberField.InfinitePlace K)
    (m_freq : Fin (NumberField.Units.rank K) → ℤ)
    (l_ang : NumberField.InfinitePlace K → ℤ)
    (h_tors : ∀ ζ ∈ NumberField.Units.torsion K,
      (∏ w : NumberField.InfinitePlace K,
        (w.embedding ((ζ : NumberField.RingOfIntegers K) : K)) ^ (l_ang w)) = 1)
    (h_nonprin :
      (∃ j : Fin (NumberField.Units.rank K),
        -2 * Real.pi * (m_freq j : ℝ) +
          ∑ w : NumberField.InfinitePlace K,
            (l_ang w : ℝ) *
              (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg ≠ 0) ∨
      (∃ w : NumberField.InfinitePlace K, w.IsComplex ∧ l_ang w ≠ 0) ∨
      (∃ w : NumberField.InfinitePlace K, w.IsReal ∧ Odd (l_ang w)))
    (χ_gr : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ_gr_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ_gr I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ_gr I = 0))
    (hχ_gr_prin : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ q →
      ∃ y : Fin (NumberField.Units.rank K) → ℝ,
        (∀ w : NumberField.InfinitePlace K,
          Real.log (w (x : K) / w₀ (x : K)) =
            ∑ j : Fin (NumberField.Units.rank K),
              y j *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) ∧
        χ_gr ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
          Complex.exp
            (((∑ j : Fin (NumberField.Units.rank K),
                y j *
                  (-2 * Real.pi * (m_freq j : ℝ) +
                    ∑ w : NumberField.InfinitePlace K,
                      (l_ang w : ℝ) *
                        (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg)) : ℝ) * Complex.I) =
          ∏ w : NumberField.InfinitePlace K,
            (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w))
    (hχ_real : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → (χ_gr I) ^ 2 = 1) :
    (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ q →
      (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (x : K)).re) →
      χ_gr ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1) ∧
    (∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ ∧ χ_gr I₀ ≠ 1) :=
by
  classical
  let _ := h_tors
  let _ := hχ_gr_norm_supp
  let n : ℕ := Module.finrank ℚ K
  let r : ℕ := NumberField.Units.rank K
  let Ω : Fin r → ℝ := fun j =>
    -2 * Real.pi * (m_freq j : ℝ) +
      ∑ w : NumberField.InfinitePlace K,
        (l_ang w : ℝ) *
          (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg
  let L : NumberField.InfinitePlace K → ℤ := l_ang
  have h_coprime : ∀ x : NumberField.RingOfIntegers K, x - 1 ∈ q →
      Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ q = ⊤ := by
    intro x hx_q
    rw [Ideal.eq_top_iff_one, Submodule.mem_sup]
    refine ⟨x, Ideal.mem_span_singleton_self x, 1 - x, ?_, by ring⟩
    have h_neg : 1 - x = -(x - 1) := by ring
    rw [h_neg]
    exact q.neg_mem hx_q
  have h_emb_real : ∀ (x : NumberField.RingOfIntegers K) (w : NumberField.InfinitePlace K),
      w.IsReal → w.embedding (x : K) = ((w.embedding (x : K)).re : ℂ) := by
    intro x w hw
    have h1 := NumberField.InfinitePlace.embedding_of_isReal_apply hw (x : K)
    have h2 : NumberField.InfinitePlace.embedding_of_isReal hw (x : K) = (w.embedding (x : K)).re := by
      rw [← h1, Complex.ofReal_re]
    rw [← h2, h1]
  have h_norm_real : ∀ (x : NumberField.RingOfIntegers K) (w : NumberField.InfinitePlace K),
      w.IsReal → w (x : K) = |(w.embedding (x : K)).re| := by
    intro x w hw
    conv_lhs =>
      rw [← NumberField.InfinitePlace.norm_embedding_eq, h_emb_real x w hw,
        Complex.norm_real, Real.norm_eq_abs]
  have h_real_pos : ∀ (x : NumberField.RingOfIntegers K) (w : NumberField.InfinitePlace K),
      w.IsReal → 0 < (w.embedding (x : K)).re →
      w.embedding (x : K) / (w (x : K) : ℂ) = 1 := by
    intro x w hw hpos
    rw [h_emb_real x w hw, h_norm_real x w hw, abs_of_pos hpos]
    have hne : ((w.embedding (x : K)).re : ℂ) ≠ 0 :=
      Complex.ofReal_ne_zero.mpr (ne_of_gt hpos)
    exact div_self hne
  have h_real_neg : ∀ (x : NumberField.RingOfIntegers K) (w : NumberField.InfinitePlace K),
      w.IsReal → (w.embedding (x : K)).re < 0 →
      w.embedding (x : K) / (w (x : K) : ℂ) = -1 := by
    intro x w hw hneg
    rw [h_emb_real x w hw, h_norm_real x w hw, abs_of_neg hneg, Complex.ofReal_neg, div_neg]
    have hne : ((w.embedding (x : K)).re : ℂ) ≠ 0 :=
      Complex.ofReal_ne_zero.mpr (ne_of_lt hneg)
    rw [div_self hne]
  have h_s1 : ∃ β : NumberField.InfinitePlace K → ℝ,
      (∑ w : NumberField.InfinitePlace K, β w) = 0 ∧
      (∀ j : Fin r,
        (∑ w : NumberField.InfinitePlace K,
          β w *
            Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
              w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) = Ω j) ∧
      (∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
        ∀ y : Fin r → ℝ,
          (∀ w : NumberField.InfinitePlace K,
            Real.log (w (x : K) / w₀ (x : K)) =
              ∑ j : Fin r,
                y j *
                  Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                    w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) →
          (∑ j : Fin r, y j * Ω j) =
            ∑ w : NumberField.InfinitePlace K, β w * Real.log (w (x : K))) := by
    let B_R : Module.Basis (Fin r) ℝ (NumberField.Units.dirichletUnitTheorem.logSpace K) :=
      Module.Basis.ofZLatticeBasis ℝ
        (NumberField.Units.unitLattice K)
        (NumberField.Units.basisUnitLattice K)
    let T_log : (NumberField.InfinitePlace K → ℝ) → NumberField.Units.dirichletUnitTheorem.logSpace K :=
      fun z w => (w.1.mult : ℝ) *
        (z w.1 - (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * z v) / (n : ℝ))
    have hT_add : ∀ z₁ z₂ : NumberField.InfinitePlace K → ℝ,
        T_log (z₁ + z₂) = T_log z₁ + T_log z₂ := by
      intro z₁ z₂
      ext w
      change (w.1.mult : ℝ) *
          ((z₁ + z₂) w.1 - (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * (z₁ + z₂) v) / (n : ℝ)) =
        T_log z₁ w + T_log z₂ w
      dsimp [T_log]
      simp only [mul_add, Finset.sum_add_distrib]
      ring
    have hT_smul : ∀ (c : ℝ) (z : NumberField.InfinitePlace K → ℝ),
        T_log (c • z) = c • T_log z := by
      intro c z
      ext w
      change (w.1.mult : ℝ) *
          (c * z w.1 - (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * (c * z v)) / (n : ℝ)) =
        c * T_log z w
      dsimp [T_log]
      have h_sum_smul : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * (c * z v)) =
          c * ∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * z v := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun v _ => by ring)
      rw [h_sum_smul]
      ring
    let F_lin : (NumberField.InfinitePlace K → ℝ) →ₗ[ℝ] ℝ :=
      { toFun := fun z => ∑ i : Fin r, (B_R.repr (T_log z) i) * Ω i
        map_add' := fun z₁ z₂ => by
          rw [hT_add, map_add]
          simp only [Finsupp.add_apply, add_mul, Finset.sum_add_distrib]
        map_smul' := fun c z => by
          rw [hT_smul, map_smul]
          simp only [Finsupp.smul_apply, smul_eq_mul, mul_assoc, ← Finset.mul_sum, RingHom.id_apply] }
    let β : NumberField.InfinitePlace K → ℝ :=
      fun w => F_lin (fun v => if w = v then 1 else 0)
    have hF_eq : ∀ z : NumberField.InfinitePlace K → ℝ,
        (∑ w : NumberField.InfinitePlace K, β w * z w) = F_lin z := by
      intro z
      conv_rhs => rw [pi_eq_sum_univ z]
      rw [map_sum]
      refine Finset.sum_congr rfl (fun w _ => ?_)
      rw [map_smul, smul_eq_mul, mul_comm]
    have hn_pos : (0 : ℝ) < (n : ℝ) := by
      dsimp [n]
      exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
    have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
    have h_sum_mult : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ)) = (n : ℝ) := by
      dsimp [n]
      exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
    have hβ_sum : (∑ w : NumberField.InfinitePlace K, β w) = 0 := by
      have h1 : (∑ w : NumberField.InfinitePlace K, β w) =
          ∑ w : NumberField.InfinitePlace K, β w * (1 : ℝ) := by
        refine Finset.sum_congr rfl (fun w _ => by ring)
      rw [h1, hF_eq (fun _ => 1)]
      have hT_one : T_log (fun _ => 1) = 0 := by
        ext w
        change (w.1.mult : ℝ) * (1 - (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * 1) / (n : ℝ)) = 0
        simp only [mul_one, h_sum_mult, div_self hn_ne, sub_self, mul_zero]
      change (∑ i : Fin r, (B_R.repr (T_log (fun _ => 1)) i) * Ω i) = 0
      rw [hT_one, map_zero]
      simp
    have hβ_fund : ∀ j : Fin r,
        (∑ w : NumberField.InfinitePlace K,
          β w * Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
            w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) = Ω j := by
      intro j
      let η_j : (NumberField.RingOfIntegers K)ˣ := NumberField.Units.fundSystem K j
      let z_j : NumberField.InfinitePlace K → ℝ :=
        fun w => Real.log (w ((η_j : NumberField.RingOfIntegers K) : K) /
          w₀ ((η_j : NumberField.RingOfIntegers K) : K))
      rw [hF_eq z_j]
      have hη_ne : ((η_j : NumberField.RingOfIntegers K) : K) ≠ 0 :=
        NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero η_j)
      have hw₀_ne : w₀ ((η_j : NumberField.RingOfIntegers K) : K) ≠ 0 :=
        ne_of_gt (w₀.pos_iff.mpr hη_ne)
      have hz_j : ∀ v : NumberField.InfinitePlace K,
          z_j v = Real.log (v ((η_j : NumberField.RingOfIntegers K) : K)) -
            Real.log (w₀ ((η_j : NumberField.RingOfIntegers K) : K)) := by
        intro v
        dsimp [z_j]
        exact Real.log_div (ne_of_gt (v.pos_iff.mpr hη_ne)) hw₀_ne
      have h_unit_sum : (∑ v : NumberField.InfinitePlace K,
          (v.mult : ℝ) * Real.log (v ((η_j : NumberField.RingOfIntegers K) : K))) = 0 := by
        simpa using NumberField.Units.sum_mult_mul_log η_j
      have h_sum_zj : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * z_j v) =
          -(n : ℝ) * Real.log (w₀ ((η_j : NumberField.RingOfIntegers K) : K)) := by
        have h1 : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * z_j v) =
            (∑ v : NumberField.InfinitePlace K,
              (v.mult : ℝ) * Real.log (v ((η_j : NumberField.RingOfIntegers K) : K))) -
            (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ)) *
              Real.log (w₀ ((η_j : NumberField.RingOfIntegers K) : K)) := by
          rw [Finset.sum_mul, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun v _ => ?_)
          rw [hz_j v, mul_sub]
        rw [h1, h_unit_sum, h_sum_mult]
        ring
      have hT_zj : T_log z_j = B_R j := by
        ext w
        dsimp [T_log, B_R]
        rw [Module.Basis.ofZLatticeBasis_apply, ← NumberField.Units.logEmbedding_fundSystem,
          NumberField.Units.dirichletUnitTheorem.logEmbedding_component]
        rw [hz_j w.1, h_sum_zj]
        have h_alg : (algebraMap (NumberField.RingOfIntegers K) K) (η_j : NumberField.RingOfIntegers K) =
            ((η_j : NumberField.RingOfIntegers K) : K) := rfl
        rw [h_alg]
        have h_div : -(n : ℝ) * Real.log (w₀ ((η_j : NumberField.RingOfIntegers K) : K)) / (n : ℝ) =
            -Real.log (w₀ ((η_j : NumberField.RingOfIntegers K) : K)) := by
          field_simp [hn_ne]
        rw [h_div]
        ring
      change (∑ i : Fin r, (B_R.repr (T_log z_j) i) * Ω i) = Ω j
      rw [hT_zj, Module.Basis.repr_self]
      simp [Finsupp.single_apply]
    refine ⟨β, hβ_sum, hβ_fund, ?_⟩
    intro x hx_ne y hy
    have hxK_ne : (x : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx_ne
    have hw₀x_ne : w₀ (x : K) ≠ 0 := ne_of_gt (w₀.pos_iff.mpr hxK_ne)
    calc (∑ j : Fin r, y j * Ω j)
      _ = ∑ j : Fin r, y j *
            (∑ w : NumberField.InfinitePlace K,
              β w * Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) := by
          refine Finset.sum_congr rfl (fun j _ => by rw [hβ_fund j])
      _ = ∑ w : NumberField.InfinitePlace K,
            β w * (∑ j : Fin r, y j *
              Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) := by
          simp_rw [Finset.mul_sum]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun w _ => Finset.sum_congr rfl (fun j _ => by ring))
      _ = ∑ w : NumberField.InfinitePlace K, β w * Real.log (w (x : K) / w₀ (x : K)) := by
          refine Finset.sum_congr rfl (fun w _ => by rw [← hy w])
      _ = (∑ w : NumberField.InfinitePlace K, β w * Real.log (w (x : K))) -
            (∑ w : NumberField.InfinitePlace K, β w) * Real.log (w₀ (x : K)) := by
          rw [Finset.sum_mul, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun w _ => ?_)
          have hwx_ne : w (x : K) ≠ 0 := ne_of_gt (w.pos_iff.mpr hxK_ne)
          rw [Real.log_div hwx_ne hw₀x_ne, mul_sub]
      _ = ∑ w : NumberField.InfinitePlace K, β w * Real.log (w (x : K)) := by
          rw [hβ_sum, zero_mul, sub_zero]
  obtain ⟨β, hβ_sum, hβ_fund, hβ_lin⟩ := h_s1
  have h_prin_L : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ q →
      χ_gr ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
        Complex.exp (((∑ w : NumberField.InfinitePlace K, β w * Real.log (w (x : K))) : ℝ) * Complex.I) =
      ∏ w : NumberField.InfinitePlace K,
        (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (L w) := by
    intro x hx_ne hx_q
    obtain ⟨y, hy_log, hy_prin⟩ := hχ_gr_prin x hx_ne hx_q
    have hy_Ω : (∑ j : Fin r, y j * Ω j) =
        ∑ w : NumberField.InfinitePlace K, β w * Real.log (w (x : K)) :=
      hβ_lin x hx_ne y hy_log
    change χ_gr _ * Complex.exp (((∑ j : Fin r, y j * Ω j) : ℝ) * Complex.I) =
      ∏ w : NumberField.InfinitePlace K, (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (L w) at hy_prin
    rw [hy_Ω] at hy_prin
    exact hy_prin
  have h_sq : ∀ (x : NumberField.RingOfIntegers K), x ≠ 0 → x - 1 ∈ q →
      Complex.exp (((2 * ∑ w : NumberField.InfinitePlace K, β w * Real.log (w (x : K))) : ℝ) * Complex.I) =
        ∏ w : NumberField.InfinitePlace K,
          (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (2 * L w) := by
    intro x hx_ne hx_q
    have h1 := congrArg (fun z : ℂ => z ^ 2) (h_prin_L x hx_ne hx_q)
    dsimp at h1
    have hχ_sq : (χ_gr ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
