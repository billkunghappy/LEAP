      rw [h_lhs, h_rhs]
      refine Finset.sum_bij (fun y hy => ⟨⟨y.2.1.1.1.asIdeal ^ y.2.1.1.2 * y.2.2.1, by
          rw [map_mul, map_pow, y.2.1.2.2, y.2.2.2]
          exact Nat.mem_divisorsAntidiagonal.mp (Finset.mem_sigma.mp hy).1 |>.1⟩,
        ⟨y.2.1.1.1.asIdeal, y.2.1.1.2⟩⟩) ?_ ?_ ?_ ?_
      · intro y hy
        dsimp [G, f_I]
        rw [Finset.mem_sigma]
        refine ⟨Finset.mem_univ _, Finset.mem_sigma.mpr ⟨?_, ?_⟩⟩
        · set I_val : Ideal R := y.2.1.1.1.asIdeal ^ y.2.1.1.2 * y.2.2.1
          have hI_norm : Ideal.absNorm I_val = n := by
            dsimp [I_val]
            rw [map_mul, map_pow, y.2.1.2.2, y.2.2.2]
            exact (Nat.mem_divisorsAntidiagonal.mp (Finset.mem_sigma.mp hy).1).1
          have hI_ne : I_val ≠ ⊥ := Ideal.absNorm_eq_zero_iff.not.mp (by rw [hI_norm]; exact hn)
          have hdvd : y.2.1.1.1.asIdeal ^ y.2.1.1.2 ∣ I_val := dvd_mul_right _ _
          have h_le := (h_pow_dvd_iff I_val hI_ne y.2.1.1.1 y.2.1.1.2).mp hdvd
          have hm1 : 1 ≤ y.2.1.1.2 := y.2.1.2.1
          rw [Multiset.mem_toFinset, ← Multiset.count_pos]
          exact lt_of_lt_of_le Nat.zero_lt_one (le_trans hm1 h_le)
        · set I_val : Ideal R := y.2.1.1.1.asIdeal ^ y.2.1.1.2 * y.2.2.1
          have hI_norm : Ideal.absNorm I_val = n := by
            dsimp [I_val]
            rw [map_mul, map_pow, y.2.1.2.2, y.2.2.2]
            exact (Nat.mem_divisorsAntidiagonal.mp (Finset.mem_sigma.mp hy).1).1
          have hI_ne : I_val ≠ ⊥ := Ideal.absNorm_eq_zero_iff.not.mp (by rw [hI_norm]; exact hn)
          have hdvd : y.2.1.1.1.asIdeal ^ y.2.1.1.2 ∣ I_val := dvd_mul_right _ _
          have h_le := (h_pow_dvd_iff I_val hI_ne y.2.1.1.1 y.2.1.1.2).mp hdvd
          rw [Finset.mem_Icc]
          exact ⟨y.2.1.2.1, h_le⟩
      · intro y₁ hy₁ y₂ hy₂ h_eq
        have hI_eq : y₁.2.1.1.1.asIdeal ^ y₁.2.1.1.2 * y₁.2.2.1 =
            y₂.2.1.1.1.asIdeal ^ y₂.2.1.1.2 * y₂.2.2.1 :=
          congrArg (fun x : Σ I : S n, Σ _P : Ideal R, ℕ => x.1.1) h_eq
        have hP_eq : y₁.2.1.1.1.asIdeal = y₂.2.1.1.1.asIdeal :=
          congrArg (fun x : Σ I : S n, Σ _P : Ideal R, ℕ => x.2.1) h_eq
        have hm_eq : y₁.2.1.1.2 = y₂.2.1.1.2 :=
          congrArg (fun x : Σ I : S n, Σ _P : Ideal R, ℕ => x.2.2) h_eq
        have hp_eq : y₁.2.1.1.1 = y₂.2.1.1.1 := IsDedekindDomain.HeightOneSpectrum.ext hP_eq
        have hpm_val_eq : y₁.2.1.1 = y₂.2.1.1 := Prod.ext hp_eq hm_eq
        have hd_eq : y₁.1.1 = y₂.1.1 := by
          rw [← y₁.2.1.2.2, ← y₂.2.1.2.2, hP_eq, hm_eq]
        have h_pow_ne : y₁.2.1.1.1.asIdeal ^ y₁.2.1.1.2 ≠ 0 :=
          pow_ne_zero _ y₁.2.1.1.1.ne_bot
        have hJ_val_eq : y₁.2.2.1 = y₂.2.2.1 := by
          rw [← hP_eq, ← hm_eq] at hI_eq
          exact mul_left_cancel₀ h_pow_ne hI_eq
        have he_eq : y₁.1.2 = y₂.1.2 := by
          rw [← y₁.2.2.2, ← y₂.2.2.2, hJ_val_eq]
        have huv_eq : y₁.1 = y₂.1 := Prod.ext hd_eq he_eq
        rcases y₁ with ⟨uv₁, pm₁, J₁⟩
        rcases y₂ with ⟨uv₂, pm₂, J₂⟩
        dsimp at huv_eq hpm_val_eq hJ_val_eq
        subst huv_eq
        congr 1
        exact Prod.ext (Subtype.ext hpm_val_eq) (Subtype.ext hJ_val_eq)
