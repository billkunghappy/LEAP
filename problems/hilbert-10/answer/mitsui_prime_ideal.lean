        simp
      let A_exact : Set (ℝ × ℝ) :=
        {q : ℝ × ℝ | q.1 ∈ Set.Ico R₀ R₁ ∧ q.2 ∈ Set.Ioo (-Real.pi) Real.pi ∧
          q.1 * Real.cos q.2 ∈ Set.Ico a₀ b₀ ∧ q.1 * Real.sin q.2 ∈ Set.Ico a₁ b₁}
      let A_cyl : Set (ℝ × ℝ) := Set.Ico R₀ R₁ ×ˢ S_cplx
      have h_f_diff_eq : f_polar (V_cplx R₁ \ V_cplx R₀) =
          A_exact.indicator (fun q => ENNReal.ofReal q.1) := by
        ext q
        change polarCoord.target.indicator
          (fun q => ENNReal.ofReal q.1 * (V_cplx R₁ \ V_cplx R₀).indicator 1 (polarCoord.symm q)) q =
          A_exact.indicator (fun q => ENNReal.ofReal q.1) q
        by_cases hr : 0 < q.1
        · have h_r_sq : (q.1 * Real.cos q.2) ^ 2 + (q.1 * Real.sin q.2) ^ 2 = q.1 ^ 2 := by
            calc (q.1 * Real.cos q.2) ^ 2 + (q.1 * Real.sin q.2) ^ 2
              _ = q.1 ^ 2 * (Real.cos q.2 ^ 2 + Real.sin q.2 ^ 2) := by ring
              _ = q.1 ^ 2 * 1 := by rw [Real.cos_sq_add_sin_sq]
              _ = q.1 ^ 2 := mul_one _
          have h_lt_iff : ∀ (R : ℝ), 0 ≤ R → (q.1 ^ 2 < R ^ 2 ↔ q.1 < R) := by
            intro R hR
            constructor
            · intro hlt
              nlinarith [sq_nonneg (q.1 + R)]
            · intro hlt
              exact pow_lt_pow_left₀ hlt (le_of_lt hr) (by decide)
          have h_mem_iff : (q ∈ polarCoord.target ∧ polarCoord.symm q ∈ V_cplx R₁ \ V_cplx R₀) ↔
