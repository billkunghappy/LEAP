  have hΨ₁_K_Y_lower : -(c * Y * δ ^ 2) ≤ W * (Ψ₁_K Y - Y) := by
    have h1 : -(Ψ₁_K Y - Y) ≤ |Ψ₁_K Y - Y| := neg_le_abs _
    have h2 : W * (-(Ψ₁_K Y - Y)) ≤ W * |Ψ₁_K Y - Y| :=
      mul_le_mul_of_nonneg_left h1 (le_of_lt hW_pos)
    linarith
  have hΨ₁_K_Z_plus_upper : W * (Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y) ≤ (c * Real.exp 1) * Y * δ ^ 2 := by
    have h1 : Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y ≤ |Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y| :=
      le_abs_self _
    have h2 : W * (Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y) ≤ W * |Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y| :=
      mul_le_mul_of_nonneg_left h1 (le_of_lt hW_pos)
    linarith
  have hΨ₁_K_Z_minus_upper : W * (Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y) ≤
      (c * Real.exp (1 / c)) * Y * δ ^ 2 := by
    have h1 : Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y ≤ |Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y| :=
      le_abs_self _
    have h2 : W * (Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y) ≤
        W * |Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y| :=
      mul_le_mul_of_nonneg_left h1 (le_of_lt hW_pos)
    linarith
  have h_rem_le : ‖(Ψ₁_cone (Real.exp δ * Y) - Ψ₁_cone Y) - (δ : ℂ) * ψ_cone Y‖ ≤
      (c * Real.exp 1 + 2 * c + c * Real.exp (1 / c) + 2 * W) * Y * δ ^ 2 := by
    have h_ident : W * ((Ψ₁_K (Real.exp δ * Y) - Ψ₁_K Y) - (Ψ₁_K Y - Ψ₁_K (Real.exp (-δ) * Y))) =
        W * (Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y) - 2 * (W * (Ψ₁_K Y - Y)) +
        W * (Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y) +
        W * ((Real.exp δ - 1 - δ) * Y) + W * ((Real.exp (-δ) - 1 + δ) * Y) := by ring
    linarith
  have h_norm_δ_ψ : δ * ‖ψ_cone Y‖ ≤
      ‖Ψ₁_cone (Real.exp δ * Y)‖ + ‖Ψ₁_cone Y‖ +
      ‖(Ψ₁_cone (Real.exp δ * Y) - Ψ₁_cone Y) - (δ : ℂ) * ψ_cone Y‖ := by
    have h_eq : (δ : ℂ) * ψ_cone Y =
        (Ψ₁_cone (Real.exp δ * Y) - Ψ₁_cone Y) -
        ((Ψ₁_cone (Real.exp δ * Y) - Ψ₁_cone Y) - (δ : ℂ) * ψ_cone Y) := by ring
    have h_norm_eq : δ * ‖ψ_cone Y‖ =
        ‖(Ψ₁_cone (Real.exp δ * Y) - Ψ₁_cone Y) -
          ((Ψ₁_cone (Real.exp δ * Y) - Ψ₁_cone Y) - (δ : ℂ) * ψ_cone Y)‖ := by
      rw [← h_eq, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hδ_pos]
    have ht1 := norm_sub_le (Ψ₁_cone (Real.exp δ * Y) - Ψ₁_cone Y)
