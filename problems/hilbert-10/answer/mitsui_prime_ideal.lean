          ψ₀ (J_rep C) * (∫ y in Cube, (1 : ℂ)) +
          ψ₀ (J_rep C) *
            (∫ y in Cube,
              (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
