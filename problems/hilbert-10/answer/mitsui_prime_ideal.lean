    mitsui_riesz_vertical_integral_eq_add_pole_integral B C D hB_pos hB_le hC_pos hD_eq hD_dlvp Y hY
  have h_poleFree :=
    mitsui_riesz_poleFree_vertical_integral_le_boundary_integral B C D hB_pos hB_le hC_pos hD_dlvp Y hY
