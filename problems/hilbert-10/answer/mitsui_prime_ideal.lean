    have h_lt := hf k z' hz'_C
    linarith
  let Φ : ℬ → (ι → Bool) × ({i : ι // i ≠ i₀} → Fin (4 * m)) :=
    fun k => (ε k, fun i => ⟨if ε k i.1 = ε k i₀
      then (k.1 i.1 : ℕ) + 2 * m - (k.1 i₀ : ℕ)
      else (k.1 i.1 : ℕ) + (k.1 i₀ : ℕ), by
        have := (k.1 i.1).isLt
        have := (k.1 i₀).isLt
