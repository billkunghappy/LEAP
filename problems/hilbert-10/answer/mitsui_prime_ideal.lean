  have h_sum_fintype : S_sum = ∑ p : NumberField.InfinitePlace K → Fin l, S_cell p :=
    tsum_fintype S_cell
  have h_sum_norm_le : ‖S_sum‖ ≤
      (l : ℝ) ^ M * (c_cell * Y₀ * Real.exp (-t / c_cell)) := by
    rw [h_sum_fintype]
    calc ‖∑ p : NumberField.InfinitePlace K → Fin l, S_cell p‖
      _ ≤ ∑ p : NumberField.InfinitePlace K → Fin l, ‖S_cell p‖ :=
