      have h_cyl_int : (∫⁻ q : ℝ × ℝ, A_cyl.indicator (fun q => ENNReal.ofReal q.1) q) =
          ENNReal.ofReal ((R₁ ^ 2 - R₀ ^ 2) / 2) * MeasureTheory.volume S_cplx :=
        h_prod_int S_cplx hS_meas
      have h_cyl_ne_top : ENNReal.ofReal ((R₁ ^ 2 - R₀ ^ 2) / 2) * MeasureTheory.volume S_cplx ≠ ⊤ :=
        ENNReal.mul_ne_top ENNReal.ofReal_ne_top hS_ne_top
      have h_exact_ne_top : MeasureTheory.volume (V_cplx R₁ \ V_cplx R₀) ≠ ⊤ :=
        ne_top_of_le_ne_top (hV_ne_top R₁ hR₁) (MeasureTheory.measure_mono Set.diff_subset)
