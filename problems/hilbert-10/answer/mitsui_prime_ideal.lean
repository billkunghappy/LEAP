theorem mitsui_riemannZeta_zeroFree_of_four_le_im : ∃ B₁ : ℝ, 0 < B₁ ∧ B₁ ≤ 1 / 2 ∧
      ∀ s : ℂ, 4 ≤ |s.im| → 1 - B₁ / Real.log (4 + |s.im|) ≤ s.re →
        riemannZeta s ≠ 0 :=
by
  obtain ⟨C₁, hC₁_pos, h_real⟩ := mitsui_riemannZeta_real_logDeriv_le_of_one_lt_le_two
  obtain ⟨A₁, hA₁_pos, h_growth⟩ := mitsui_riemannZeta_norm_le_of_half_le_re_of_two_le_im
  obtain ⟨C₂, hC₂_pos, h_uncond, h_zero⟩ :=
    mitsui_riemannZeta_re_logDeriv_bounds_of_norm_bound A₁ hA₁_pos h_growth
  let M : ℝ := 3 * C₁ + 6 * C₂
  have hM_pos : 0 < M := by dsimp [M]; positivity
  let α : ℝ := min (1 / (2 * M)) 1
  have hα_pos : 0 < α := lt_min (by positivity) zero_lt_one
  have hα_le_inv : α ≤ 1 / (2 * M) := min_le_left _ _
  have hα_le_one : α ≤ 1 := min_le_right _ _
  let B₁ : ℝ := min (α / 14) (1 / 2)
  have hB₁_pos : 0 < B₁ := lt_min (by positivity) (by norm_num)
  have hB₁_le_α : B₁ ≤ α / 14 := min_le_left _ _
  have hB₁_le : B₁ ≤ 1 / 2 := min_le_right _ _
  refine ⟨B₁, hB₁_pos, hB₁_le, ?_⟩
  intro s hs_im hs_re hs_zero
  set β : ℝ := s.re
  set γ : ℝ := s.im
  have hs_eq : (β : ℂ) + (γ : ℂ) * Complex.I = s := Complex.re_add_im s
  have h_zeta_zero : riemannZeta ((β : ℂ) + (γ : ℂ) * Complex.I) = 0 := by
    rw [hs_eq]
    exact hs_zero
  have hβ_lt_one : β < 1 := by
    by_contra h_ge
    push_neg at h_ge
    exact riemannZeta_ne_zero_of_one_le_re h_ge hs_zero
  set L : ℝ := Real.log (4 + |γ|)
  have hexp1_lt_four : Real.exp 1 < 4 := by linarith [Real.exp_one_lt_d9]
  have h_four_le : (4 : ℝ) ≤ 4 + |γ| := by linarith [abs_nonneg γ]
  have hexp1_le : Real.exp 1 ≤ 4 + |γ| := by linarith
  have hL_ge_one : 1 ≤ L := by
    dsimp [L]
    rw [← Real.log_exp 1]
    exact Real.log_le_log (Real.exp_pos 1) hexp1_le
  have hL_pos : 0 < L := lt_of_lt_of_le zero_lt_one hL_ge_one
  have habs_2γ : |2 * γ| = 2 * |γ| := by
    rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
  have h4_le_2γ : 4 ≤ |2 * γ| := by linarith
  have hL2_le : Real.log (4 + |2 * γ|) ≤ 2 * L := by
    have h_ineq : 4 + |2 * γ| ≤ (4 + |γ|) ^ 2 := by
      rw [habs_2γ]
      nlinarith
    have h_log : Real.log (4 + |2 * γ|) ≤ Real.log ((4 + |γ|) ^ 2) :=
      Real.log_le_log (by linarith) h_ineq
    rw [Real.log_pow] at h_log
    exact_mod_cast h_log
  set σ : ℝ := 1 + α / L
  have hαL_pos : 0 < α / L := div_pos hα_pos hL_pos
  have hσ_gt_one : 1 < σ := by dsimp [σ]; linarith
  have hαL_le_one : α / L ≤ 1 := by
    rw [div_le_iff₀ hL_pos]
    linarith
  have hσ_le_two : σ ≤ 2 := by dsimp [σ]; linarith
  have hσ_sub_β_pos : 0 < σ - β := by linarith
  have hσ_sub_one : σ - 1 = α / L := by dsimp [σ]; ring
  have h_inv_σ : 1 / (σ - 1) = L / α := by
    rw [hσ_sub_one, one_div_div]
  have h0 := mitsui_riemannZeta_trig_logDeriv_nonneg σ γ hσ_gt_one
  have h1 := h_real σ hσ_gt_one hσ_le_two
  rw [h_inv_σ] at h1
  have h2 := h_zero σ β γ hσ_gt_one hσ_le_two hs_im h_zeta_zero
  have h3 := h_uncond σ (2 * γ) hσ_gt_one hσ_le_two h4_le_2γ
  have h3' : (-deriv riemannZeta ((σ : ℂ) + ((2 * γ : ℝ) : ℂ) * Complex.I) /
      riemannZeta ((σ : ℂ) + ((2 * γ : ℝ) : ℂ) * Complex.I)).re ≤ 2 * C₂ * L := by
    have h_mul : C₂ * Real.log (4 + |2 * γ|) ≤ C₂ * (2 * L) :=
      mul_le_mul_of_nonneg_left hL2_le (le_of_lt hC₂_pos)
    linarith
  have h_comb1 : 4 * (1 / (σ - β)) ≤ 3 * (L / α) + 3 * C₁ + 6 * C₂ * L := by
    linarith
  have hC₁_le_C₁L : C₁ ≤ C₁ * L := le_mul_of_one_le_right (le_of_lt hC₁_pos) hL_ge_one
  have h_comb2 : 4 / (σ - β) ≤ 3 * (L / α) + M * L := by
    have h_eq4 : 4 / (σ - β) = 4 * (1 / (σ - β)) := by ring
    have : 3 * C₁ + 6 * C₂ * L ≤ M * L := by
      dsimp [M]
      linarith
    linarith
  have hM_le : M ≤ 1 / (2 * α) := by
    rw [le_div_iff₀ (by positivity)]
    have h_mul : α * (2 * M) ≤ 1 := (le_div_iff₀ (by positivity)).mp hα_le_inv
    linarith
  have hML_le : M * L ≤ L / (2 * α) := by
    calc M * L ≤ (1 / (2 * α)) * L := mul_le_mul_of_nonneg_right hM_le (le_of_lt hL_pos)
      _ = L / (2 * α) := by ring
  have h_comb3 : 4 / (σ - β) ≤ (7 * L) / (2 * α) := by
    have h_id : 3 * (L / α) + L / (2 * α) = (7 * L) / (2 * α) := by ring
    linarith
  have h_clear1 : 4 ≤ ((7 * L) / (2 * α)) * (σ - β) :=
    (div_le_iff₀ hσ_sub_β_pos).mp h_comb3
  have h_clear2 : 8 * α ≤ 7 * L * (σ - β) := by
    have h_mul := mul_le_mul_of_nonneg_right h_clear1 (by positivity : 0 ≤ 2 * α)
    have h_rhs : ((7 * L) / (2 * α)) * (σ - β) * (2 * α) = 7 * L * (σ - β) := by
      have hα_ne : α ≠ 0 := ne_of_gt hα_pos
      field_simp [hα_ne]
    linarith
  have h_expand : 7 * L * (σ - β) = 7 * α + 7 * L * (1 - β) := by
    have hL_ne : L ≠ 0 := ne_of_gt hL_pos
    dsimp [σ]
    field_simp [hL_ne]
    ring
  have h_lower : α ≤ 7 * L * (1 - β) := by linarith
  have h_re_bound : 1 - β ≤ B₁ / L := by
    change 1 - B₁ / L ≤ β at hs_re
    linarith
  have h_re_mul : L * (1 - β) ≤ B₁ := by
    have h_mul := mul_le_mul_of_nonneg_left h_re_bound (le_of_lt hL_pos)
    have h_rhs : L * (B₁ / L) = B₁ := mul_div_cancel₀ B₁ (ne_of_gt hL_pos)
    linarith
  linarith

theorem mitsui_riemannZeta_logDeriv_bound_of_one_lt_re_le_two : ∃ M₁ : ℝ, 0 < M₁ ∧
      ∀ s : ℂ, 1 < s.re → s.re ≤ 2 →
        ‖-deriv riemannZeta s / riemannZeta s‖ ≤ M₁ + 1 / (s.re - 1) :=
by
  let g₀ : ℂ → ℂ := fun w => (w - 1) * riemannZeta w
  let g : ℂ → ℂ := Function.update g₀ 1 (limUnder (nhdsWithin (1 : ℂ) {(1 : ℂ)}ᶜ) g₀)
  have hg_one : g 1 = 1 := by
    dsimp [g, g₀]
    rw [Function.update_self]
    exact riemannZeta_residue_one.limUnder_eq
  have hg_ne : ∀ z : ℂ, z ≠ 1 → g z = g₀ z := fun z hz => Function.update_of_ne hz _ g₀
  have hg_ev : ∀ z : ℂ, z ≠ 1 → g =ᶠ[nhds z] g₀ := by
    intro z hz
    filter_upwards [isOpen_compl_singleton.mem_nhds hz] with w hw
    exact hg_ne w hw
  have hg₀_diff : ∀ z : ℂ, z ≠ 1 → DifferentiableAt ℂ g₀ z := by
    intro z hz
    dsimp [g₀]
    exact (differentiableAt_id.sub (differentiableAt_const (1 : ℂ))).mul
      (differentiableAt_riemannZeta hz)
  obtain ⟨r, hr_pos, hr⟩ :=
    Metric.tendsto_nhdsWithin_nhds.mp riemannZeta_residue_one 1 zero_lt_one
  let V : Set ℂ := Metric.ball (1 : ℂ) r
  have hV_nhds : V ∈ nhds (1 : ℂ) := Metric.ball_mem_nhds (1 : ℂ) hr_pos
  have hg₀_diffOn : DifferentiableOn ℂ g₀ (V \ {(1 : ℂ)}) :=
    fun z hz => (hg₀_diff z hz.2).differentiableWithinAt
  have hg₀_bdd : BddAbove (norm ∘ g₀ '' (V \ {(1 : ℂ)})) := by
    refine ⟨2, ?_⟩
    rintro y ⟨z, ⟨hzV, hz1⟩, rfl⟩
    rw [Metric.mem_ball] at hzV
    have h_dist : dist (g₀ z) 1 < 1 := hr hz1 hzV
    rw [dist_eq_norm] at h_dist
    have h_tri : ‖g₀ z‖ ≤ ‖g₀ z - 1‖ + ‖(1 : ℂ)‖ := by
      simpa using norm_add_le (g₀ z - 1) (1 : ℂ)
    rw [norm_one] at h_tri
    dsimp [Function.comp]
    linarith
  have hg_diff_one : DifferentiableAt ℂ g 1 :=
    (Complex.differentiableOn_update_limUnder_of_bddAbove hV_nhds hg₀_diffOn hg₀_bdd).differentiableAt hV_nhds
  have hg_diff : Differentiable ℂ g := by
    intro z
    by_cases hz : z = 1
    · subst hz; exact hg_diff_one
    · exact (hg₀_diff z hz).congr_of_eventuallyEq (hg_ev z hz)
  have hg_cont : Continuous g := hg_diff.continuous
  have h_deriv_g_diff : Differentiable ℂ (deriv g) := by
    rw [← differentiableOn_univ]
    exact hg_diff.differentiableOn.deriv isOpen_univ
  have h_deriv_g_cont : Continuous (deriv g) := h_deriv_g_diff.continuous
  have hg_σ_ne : ∀ σ ∈ Set.Icc (1 : ℝ) 2, g (σ : ℂ) ≠ 0 := by
    intro σ hσ
    by_cases h1 : (σ : ℂ) = 1
    · rw [h1, hg_one]; exact one_ne_zero
    · rw [hg_ne (σ : ℂ) h1]
      dsimp [g₀]
      refine mul_ne_zero (sub_ne_zero.mpr h1) (riemannZeta_ne_zero_of_one_le_re ?_)
      simpa using hσ.1
  have h_cont_Icc : ContinuousOn (fun σ : ℝ => ‖-deriv g (σ : ℂ) / g (σ : ℂ)‖) (Set.Icc 1 2) := by
    refine ContinuousOn.norm ?_
    refine ContinuousOn.div ?_ ?_ (fun σ hσ => hg_σ_ne σ hσ)
    · exact (h_deriv_g_cont.comp Complex.continuous_ofReal).continuousOn.neg
