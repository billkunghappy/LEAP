    exact Ideal.mul_mem_mul hd hz_fB₀
  let G₀ : R → ℂ := fun y =>
    ∑ a : R ⧸ f, ψ_f a * e_K ((β a : K) * (y : K) / (γ₀ : K))
  have hG₀_congr : ∀ (y₁ y₂ : R),
