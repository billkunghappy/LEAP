    have hlogX_pos : 0 < Real.log X := Real.log_pos hX
    have hnlogX_nonneg : 0 ≤ 2 * (n : ℝ) * Real.log X := by positivity
    let U₂ := {u : (NumberField.RingOfIntegers K)ˣ //
      ∀ w : NumberField.InfinitePlace K,
        |(w.mult : ℝ) * Real.log (w ((u : NumberField.RingOfIntegers K) : K))| ≤
          2 * (n : ℝ) * Real.log X}
