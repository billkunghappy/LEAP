      (∑' m : ℕ,
        (Nat.card {I : Ideal R // I ≠ 0 ∧ Ideal.absNorm I = m} : ℝ) *
          J_K (Real.pi * (D ^ (-1 / 2 : ℝ) * ((m : ℝ) * u)) ^ (2 / (n : ℝ)))) +
      ((NumberField.classNumber K : ℝ) / (NumberField.Units.torsionOrder K : ℝ)) * (u - 1)
  rw [h_lhs_eq, h_rhs_eq, h_sum_cls]
  ring

theorem mitsui_unitDiscr_archimedean_kernel_fubini_and_theta_inversion {K : Type u} [Field K] [NumberField K] :
    ∃ (W₀ : ℝ → ℝ) (C₀ c α : ℝ),
      0 < C₀ ∧ 0 < c ∧ 0 < α ∧
      Measurable W₀ ∧
      (∀ τ : ℝ, 0 ≤ W₀ τ) ∧
      (∀ s : ℂ, 1 < s.re →
        MeasureTheory.IntegrableOn (fun τ : ℝ => τ ^ s.re * W₀ τ) (Set.Ioi (0 : ℝ)) MeasureTheory.volume ∧
        (∫ τ in Set.Ioi (0 : ℝ), (τ : ℂ) ^ s * (W₀ τ : ℂ)) =
          (∫ v in Set.Ioi (0 : ℝ), (v : ℂ) ^ s * ((2 * v⁻¹ * Real.exp (-Real.pi * v ^ 2) : ℝ) : ℂ)) ^
            (NumberField.InfinitePlace.nrRealPlaces K) *
          (∫ v in Set.Ioi (0 : ℝ), (v : ℂ) ^ s * ((2 * v⁻¹ * Real.exp (-2 * Real.pi * v) : ℝ) : ℂ)) ^
            (NumberField.InfinitePlace.nrComplexPlaces K)) ∧
      (∀ t ∈ Set.Ioi (1 : ℝ),
        |(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) * W₀ (|(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) * t) ≤
          C₀ * Real.exp (-2 * c * t ^ α)) ∧
      (∀ u ∈ Set.Ioi (1 : ℝ),
        u ^ (-3 : ℝ) *
          (∑' m : ℕ,
            (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm I = m} : ℝ) *
              (m : ℝ) *
              (|(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) *
                W₀ (|(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) * ((m : ℝ) * u⁻¹)))) =
          (∑' m : ℕ,
            (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm I = m} : ℝ) *
              (m : ℝ) *
              (|(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) *
                W₀ (|(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) * ((m : ℝ) * u)))) +
            ((2 : ℝ) ^ (NumberField.InfinitePlace.nrRealPlaces K + NumberField.InfinitePlace.nrComplexPlaces K) *
              NumberField.Units.regulator K *
              (NumberField.classNumber K : ℝ) /
              (NumberField.Units.torsionOrder K : ℝ)) *
              (u ^ (-1 : ℝ) - u ^ (-2 : ℝ))) :=
by
  set Q_K : (Fin (NumberField.Units.rank K) → ℝ) → ℝ := fun y =>
    ∑ w : NumberField.InfinitePlace K,
      (w.mult : ℝ) * ∏ i : Fin (NumberField.Units.rank K),
        (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i)
  let J_K : ℝ → ℝ := fun a => ∫ y : Fin (NumberField.Units.rank K) → ℝ, Real.exp (-a * Q_K y)
  set n : ℕ := Module.finrank ℚ K
  set r₁ : ℕ := NumberField.InfinitePlace.nrRealPlaces K
  set r₂ : ℕ := NumberField.InfinitePlace.nrComplexPlaces K
  set D : ℝ := |(NumberField.discr K : ℝ)|
  set Reg_K : ℝ := NumberField.Units.regulator K
  set P_K : ℝ := (2 : ℝ) ^ (r₁ + r₂) * Reg_K
  have hn_pos : 0 < (n : ℝ) := by exact_mod_cast Module.finrank_pos
  have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  have hD_pos : 0 < D := by
    dsimp [D]
    exact abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  have hReg_pos : 0 < Reg_K := NumberField.Units.regulator_pos K
  have hPK_pos : 0 < P_K := by dsimp [P_K]; positivity
  let α : ℝ := 2 / (n : ℝ)
  have hα_pos : 0 < α := by dsimp [α]; positivity
  let a₀ : ℝ := Real.pi * D ^ (-1 / (n : ℝ))
  have ha₀_pos : 0 < a₀ := by dsimp [a₀]; positivity
  have hQ_meas : Measurable Q_K := by
    refine Finset.measurable_sum Finset.univ (fun w _ => ?_)
    refine measurable_const.mul (Finset.measurable_prod Finset.univ (fun i _ => ?_))
    exact Measurable.const_pow (measurable_const.mul (measurable_pi_apply i)) _
  have hF_meas : Measurable (fun p : ℝ × (Fin (NumberField.Units.rank K) → ℝ) =>
      Real.exp (-p.1 * Q_K p.2)) :=
    Real.measurable_exp.comp ((measurable_fst.neg).mul (hQ_meas.comp measurable_snd))
  have hJK_meas : Measurable J_K :=
    hF_meas.stronglyMeasurable.integral_prod_right'.measurable
  have hJK_nn : ∀ a : ℝ, 0 ≤ J_K a :=
    fun a => MeasureTheory.integral_nonneg (fun y => Real.exp_nonneg _)
  have hQ_amgm : ∀ y : Fin (NumberField.Units.rank K) → ℝ, (n : ℝ) ≤ Q_K y := by
    intro y
    set ω : NumberField.InfinitePlace K → ℝ := fun w => (w.mult : ℝ) / (n : ℝ)
    set z : NumberField.InfinitePlace K → ℝ := fun w =>
      ∏ i : Fin (NumberField.Units.rank K),
        (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i)
    have hω_nn : ∀ w ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)), 0 ≤ ω w := by
      intro w _
      dsimp [ω]
      positivity
    have hω_sum : ∑ w ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)), ω w = 1 := by
      dsimp [ω]
      rw [← Finset.sum_div]
      have hsum : (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ)) = (n : ℝ) := by
        exact_mod_cast NumberField.InfinitePlace.sum_mult_eq
      rw [hsum, div_self hn_ne]
    have hz_nn : ∀ w ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)), 0 ≤ z w := by
      intro w _
      dsimp [z]
      refine Finset.prod_nonneg (fun i _ => ?_)
      exact Real.rpow_nonneg (apply_nonneg w _) _
    have h_prod_one : ∏ w ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)), (z w) ^ (ω w) = 1 := by
      have h_step1 : ∀ w : NumberField.InfinitePlace K,
          (z w) ^ (ω w) = ∏ i : Fin (NumberField.Units.rank K),
            ((w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ w.mult) ^ (2 * y i / (n : ℝ)) := by
        intro w
        dsimp [z, ω]
        rw [← Real.finset_prod_rpow _ _ (fun i _ => Real.rpow_nonneg (apply_nonneg w _) _)]
        refine Finset.prod_congr rfl (fun i _ => ?_)
        have hw_nn : 0 ≤ w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K) := apply_nonneg w _
        rw [← Real.rpow_natCast, ← Real.rpow_mul hw_nn, ← Real.rpow_mul hw_nn]
        congr 1
        ring
      simp_rw [h_step1]
      rw [Finset.prod_comm]
      refine Finset.prod_eq_one (fun i _ => ?_)
      rw [Real.finset_prod_rpow _ _ (fun w _ => pow_nonneg (apply_nonneg w _) _)]
      have h_norm : ∏ w : NumberField.InfinitePlace K,
          (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ w.mult = 1 := by
        rw [NumberField.InfinitePlace.prod_eq_abs_norm]
        exact_mod_cast NumberField.Units.norm K (NumberField.Units.fundSystem K i)
      rw [h_norm, Real.one_rpow]
    have h_amgm := Real.geom_mean_le_arith_mean_weighted Finset.univ ω z hω_nn hω_sum hz_nn
    rw [h_prod_one] at h_amgm
    dsimp [ω, z] at h_amgm
    simp_rw [div_mul_eq_mul_div] at h_amgm
    rw [← Finset.sum_div, le_div_iff₀ hn_pos, one_mul] at h_amgm
    exact h_amgm
  let M₀ : ℝ := J_K (a₀ / 2) + 1
  have hM₀_pos : 0 < M₀ := by
    have : 0 ≤ J_K (a₀ / 2) := hJK_nn (a₀ / 2)
    dsimp [M₀]; linarith
  have hJK_bound : ∀ a : ℝ, a₀ ≤ a → J_K a ≤ M₀ * Real.exp (-((n : ℝ) / 2) * a) := by
    intro a ha
    have ha_pos : 0 < a := lt_of_lt_of_le ha₀_pos ha
    have ha02_pos : 0 < a₀ / 2 := by positivity
    have h_int_a : MeasureTheory.Integrable (fun y => Real.exp (-a * Q_K y)) MeasureTheory.volume :=
      mitsui_unitRank_gaussian_integrable (K := K) a ha_pos
    have h_int_a0 : MeasureTheory.Integrable (fun y => Real.exp (-(a₀ / 2) * Q_K y)) MeasureTheory.volume :=
      mitsui_unitRank_gaussian_integrable (K := K) (a₀ / 2) ha02_pos
    have h_int_rhs : MeasureTheory.Integrable
        (fun y => Real.exp (-((n : ℝ) / 2) * a) * Real.exp (-(a₀ / 2) * Q_K y)) MeasureTheory.volume :=
      h_int_a0.const_mul _
    have h_pw : ∀ y : Fin (NumberField.Units.rank K) → ℝ,
        Real.exp (-a * Q_K y) ≤ Real.exp (-((n : ℝ) / 2) * a) * Real.exp (-(a₀ / 2) * Q_K y) := by
      intro y
      rw [← Real.exp_add, Real.exp_le_exp]
      have hQy : (n : ℝ) ≤ Q_K y := hQ_amgm y
      have hQy_nn : 0 ≤ Q_K y := le_trans (le_of_lt hn_pos) hQy
      have h1 : (a / 2) * (n : ℝ) ≤ (a / 2) * Q_K y :=
        mul_le_mul_of_nonneg_left hQy (by positivity)
      have h2 : (a₀ / 2) * Q_K y ≤ (a / 2) * Q_K y :=
        mul_le_mul_of_nonneg_right (by linarith) hQy_nn
      linarith
    have h_mono := MeasureTheory.integral_mono h_int_a h_int_rhs h_pw
    rw [MeasureTheory.integral_const_mul] at h_mono
    have hM_le : J_K (a₀ / 2) ≤ M₀ := by dsimp [M₀]; linarith
    calc J_K a
        ≤ Real.exp (-((n : ℝ) / 2) * a) * J_K (a₀ / 2) := h_mono
      _ ≤ Real.exp (-((n : ℝ) / 2) * a) * M₀ :=
          mul_le_mul_of_nonneg_left hM_le (Real.exp_nonneg _)
      _ = M₀ * Real.exp (-((n : ℝ) / 2) * a) := by ring
  let C₀ : ℝ := P_K * M₀
  let c : ℝ := ((n : ℝ) / 4) * a₀
  have hC₀_pos : 0 < C₀ := by dsimp [C₀]; positivity
  have hc_pos : 0 < c := by dsimp [c]; positivity
  let W₀ : ℝ → ℝ := fun τ =>
    if 0 < τ then P_K * τ⁻¹ * J_K (Real.pi * τ ^ α) else 0
  have hW₀_meas : Measurable W₀ := by
    refine Measurable.ite measurableSet_Ioi ?_ measurable_const
    exact ((measurable_const.mul measurable_id.inv).mul
      (hJK_meas.comp (measurable_const.mul (measurable_id.pow_const α))))
  have hW₀_nn : ∀ τ : ℝ, 0 ≤ W₀ τ := by
    intro τ
    dsimp [W₀]
    split_ifs with hτ
    · have : 0 ≤ J_K (Real.pi * τ ^ α) := hJK_nn _
      positivity
    · exact le_rfl
  refine ⟨W₀, C₀, c, α, hC₀_pos, hc_pos, hα_pos, hW₀_meas, hW₀_nn, ?_, ?_, ?_⟩
  · intro s hs
    obtain ⟨h_int_s, h_eq_s⟩ := mitsui_unitRank_archimedean_mellin_eq_prod_places (K := K) s hs
    have h_int_W₀ : MeasureTheory.IntegrableOn (fun τ : ℝ => τ ^ s.re * W₀ τ) (Set.Ioi (0 : ℝ)) MeasureTheory.volume := by
      refine h_int_s.congr_fun (fun τ hτ => ?_) measurableSet_Ioi
      dsimp [W₀, P_K, r₁, r₂, Reg_K, α, n]
      rw [if_pos (Set.mem_Ioi.mp hτ)]
    have h_int_eq : (∫ τ in Set.Ioi (0 : ℝ), (τ : ℂ) ^ s * (W₀ τ : ℂ)) =
        ∏ w : NumberField.InfinitePlace K,
          (∫ v in Set.Ioi (0 : ℝ),
            (v : ℂ) ^ s *
              ((2 * v⁻¹ * Real.exp (-Real.pi * (w.mult : ℝ) * v ^ (2 / (w.mult : ℝ))) : ℝ) : ℂ)) := by
      rw [← h_eq_s]
      refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun τ hτ => ?_)
      dsimp [W₀, P_K, r₁, r₂, Reg_K, α, n]
      rw [if_pos (Set.mem_Ioi.mp hτ)]
    refine ⟨h_int_W₀, ?_⟩
    rw [h_int_eq]
    classical
    set F : NumberField.InfinitePlace K → ℂ := fun w =>
      ∫ v in Set.Ioi (0 : ℝ),
        (v : ℂ) ^ s *
          ((2 * v⁻¹ * Real.exp (-Real.pi * (w.mult : ℝ) * v ^ (2 / (w.mult : ℝ))) : ℝ) : ℂ)
    set I_R : ℂ := ∫ v in Set.Ioi (0 : ℝ), (v : ℂ) ^ s * ((2 * v⁻¹ * Real.exp (-Real.pi * v ^ 2) : ℝ) : ℂ)
    set I_C : ℂ := ∫ v in Set.Ioi (0 : ℝ), (v : ℂ) ^ s * ((2 * v⁻¹ * Real.exp (-2 * Real.pi * v) : ℝ) : ℂ)
    rw [← Finset.prod_filter_mul_prod_filter_not Finset.univ (fun w : NumberField.InfinitePlace K => w.IsReal) F]
    have h_real : (∏ w ∈ Finset.univ.filter (fun w : NumberField.InfinitePlace K => w.IsReal), F w) =
        I_R ^ r₁ := by
      have h_eq : ∀ w ∈ Finset.univ.filter (fun w : NumberField.InfinitePlace K => w.IsReal), F w = I_R := by
        intro w hw
        rw [Finset.mem_filter] at hw
        have hm : (w.mult : ℝ) = 1 := by exact_mod_cast NumberField.InfinitePlace.mult_isReal ⟨w, hw.2⟩
        dsimp [F, I_R]
        rw [hm]
        have h21 : (2 : ℝ) / 1 = 2 := by ring
        rw [h21]
        refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun v _ => ?_)
        rw [Real.rpow_two, mul_one]
      rw [Finset.prod_congr rfl h_eq, Finset.prod_const, ← Fintype.card_subtype]
    have h_cplx : (∏ w ∈ Finset.univ.filter (fun w : NumberField.InfinitePlace K => ¬w.IsReal), F w) =
        I_C ^ r₂ := by
      have h_filt : Finset.univ.filter (fun w : NumberField.InfinitePlace K => ¬w.IsReal) =
          Finset.univ.filter (fun w : NumberField.InfinitePlace K => w.IsComplex) := by
        ext w
        simp [NumberField.InfinitePlace.not_isReal_iff_isComplex]
      rw [h_filt]
      have h_eq : ∀ w ∈ Finset.univ.filter (fun w : NumberField.InfinitePlace K => w.IsComplex), F w = I_C := by
        intro w hw
        rw [Finset.mem_filter] at hw
        have hm : (w.mult : ℝ) = 2 := by exact_mod_cast NumberField.InfinitePlace.mult_isComplex ⟨w, hw.2⟩
        dsimp [F, I_C]
        rw [hm]
        have h22 : (2 : ℝ) / 2 = 1 := by ring
        rw [h22]
        refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun v _ => ?_)
        rw [Real.rpow_one]
        have hpi : -Real.pi * 2 * v = -2 * Real.pi * v := by ring
        rw [hpi]
      rw [Finset.prod_congr rfl h_eq, Finset.prod_const, ← Fintype.card_subtype]
    rw [h_real, h_cplx]
  · intro t ht
    have ht1 : 1 < t := Set.mem_Ioi.mp ht
    have ht_pos : 0 < t := lt_trans zero_lt_one ht1
    have hD_rpow_pos : 0 < D ^ (-1 / 2 : ℝ) := Real.rpow_pos_of_pos hD_pos _
    have hτ_pos : 0 < D ^ (-1 / 2 : ℝ) * t := mul_pos hD_rpow_pos ht_pos
    dsimp [W₀]
    rw [if_pos hτ_pos]
    have h_arg : Real.pi * (D ^ (-1 / 2 : ℝ) * t) ^ α = a₀ * t ^ α := by
      rw [Real.mul_rpow (le_of_lt hD_rpow_pos) (le_of_lt ht_pos), ← Real.rpow_mul (le_of_lt hD_pos)]
      have hexp : (-1 / 2 : ℝ) * α = -1 / (n : ℝ) := by dsimp [α]; ring
      rw [hexp]
      dsimp [a₀]
      ring
    rw [h_arg]
    have htα_ge_one : 1 ≤ t ^ α := Real.one_le_rpow (le_of_lt ht1) (le_of_lt hα_pos)
    have ha_ge : a₀ ≤ a₀ * t ^ α := le_mul_of_one_le_right (le_of_lt ha₀_pos) htα_ge_one
    have hJ_le := hJK_bound (a₀ * t ^ α) ha_ge
    have h_exp_eq : -((n : ℝ) / 2) * (a₀ * t ^ α) = -2 * c * t ^ α := by
      dsimp [c]
      ring
    rw [h_exp_eq] at hJ_le
    have h_pref : D ^ (-1 / 2 : ℝ) * (P_K * (D ^ (-1 / 2 : ℝ) * t)⁻¹ * J_K (a₀ * t ^ α)) =
        t⁻¹ * (P_K * J_K (a₀ * t ^ α)) := by
      have hD_ne : D ^ (-1 / 2 : ℝ) ≠ 0 := ne_of_gt hD_rpow_pos
      have ht_ne : t ≠ 0 := ne_of_gt ht_pos
      field_simp [hD_ne, ht_ne]
    rw [h_pref]
    have ht_inv_le : t⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (le_of_lt ht1)
    have hPJ_nn : 0 ≤ P_K * J_K (a₀ * t ^ α) := mul_nonneg (le_of_lt hPK_pos) (hJK_nn _)
    calc t⁻¹ * (P_K * J_K (a₀ * t ^ α))
        ≤ 1 * (P_K * J_K (a₀ * t ^ α)) := mul_le_mul_of_nonneg_right ht_inv_le hPJ_nn
      _ = P_K * J_K (a₀ * t ^ α) := one_mul _
      _ ≤ P_K * (M₀ * Real.exp (-2 * c * t ^ α)) := mul_le_mul_of_nonneg_left hJ_le (le_of_lt hPK_pos)
      _ = C₀ * Real.exp (-2 * c * t ^ α) := by dsimp [C₀]; ring
  · intro u hu
    have hu1 : 1 < u := Set.mem_Ioi.mp hu
    have hu_pos : 0 < u := lt_trans zero_lt_one hu1
    have hu_ne : u ≠ 0 := ne_of_gt hu_pos
    have hD_rpow_pos : 0 < D ^ (-1 / 2 : ℝ) := Real.rpow_pos_of_pos hD_pos _
    have hD_rpow_ne : D ^ (-1 / 2 : ℝ) ≠ 0 := ne_of_gt hD_rpow_pos
    have h_term : ∀ (v : ℝ), 0 < v → ∀ m : ℕ,
        (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm I = m} : ℝ) *
          (m : ℝ) * (D ^ (-1 / 2 : ℝ) * W₀ (D ^ (-1 / 2 : ℝ) * ((m : ℝ) * v))) =
        (P_K * v⁻¹) *
          ((Nat.card {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0 ∧ Ideal.absNorm I = m} : ℝ) *
            J_K (Real.pi * (D ^ (-1 / 2 : ℝ) * ((m : ℝ) * v)) ^ α)) := by
      intro v hv m
      by_cases hm : m = 0
      · subst hm
        have h_empty : IsEmpty {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0 ∧ Ideal.absNorm I = 0} :=
          ⟨fun ⟨I, hI_ne, hI_norm⟩ => hI_ne (Ideal.absNorm_eq_zero_iff.mp hI_norm)⟩
        rw [@Nat.card_of_isEmpty _ h_empty]
        simp
      · have hm_pos : 0 < (m : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hm)
        have hm_ne : (m : ℝ) ≠ 0 := ne_of_gt hm_pos
        have h_equiv : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0 ∧ Ideal.absNorm I = m} ≃
            {I : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm I = m} :=
          Equiv.subtypeEquivRight (fun I =>
            ⟨fun h => h.2, fun h => ⟨fun h0 => hm (h.symm.trans (Ideal.absNorm_eq_zero_iff.mpr h0)), h⟩⟩)
        rw [Nat.card_congr h_equiv]
        have hτ_pos : 0 < D ^ (-1 / 2 : ℝ) * ((m : ℝ) * v) := by positivity
        dsimp [W₀]
        rw [if_pos hτ_pos]
        have hv_ne : v ≠ 0 := ne_of_gt hv
        field_simp [hD_rpow_ne, hm_ne, hv_ne]
    have h_lhs_sum :
        (∑' m : ℕ,
          (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm I = m} : ℝ) *
            (m : ℝ) * (D ^ (-1 / 2 : ℝ) * W₀ (D ^ (-1 / 2 : ℝ) * ((m : ℝ) * u⁻¹)))) =
        (P_K * (u⁻¹)⁻¹) *
          (∑' m : ℕ,
            (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0 ∧ Ideal.absNorm I = m} : ℝ) *
              J_K (Real.pi * (D ^ (-1 / 2 : ℝ) * ((m : ℝ) * u⁻¹)) ^ α)) := by
      simp_rw [h_term u⁻¹ (inv_pos.mpr hu_pos)]
      exact tsum_mul_left
    have h_rhs_sum :
        (∑' m : ℕ,
          (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm I = m} : ℝ) *
            (m : ℝ) * (D ^ (-1 / 2 : ℝ) * W₀ (D ^ (-1 / 2 : ℝ) * ((m : ℝ) * u)))) =
        (P_K * u⁻¹) *
          (∑' m : ℕ,
            (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0 ∧ Ideal.absNorm I = m} : ℝ) *
              J_K (Real.pi * (D ^ (-1 / 2 : ℝ) * ((m : ℝ) * u)) ^ α)) := by
      simp_rw [h_term u hu_pos]
      exact tsum_mul_left
    rw [h_lhs_sum, h_rhs_sum]
    have h_s4 := mitsui_unitRank_ideal_norm_theta_inversion (K := K) u hu
    dsimp [J_K, Q_K, D, α, n] at h_s4 ⊢
    rw [h_s4]
    have hu3 : u ^ (-3 : ℝ) = (u ^ 3)⁻¹ := by
      rw [Real.rpow_neg (le_of_lt hu_pos)]
      norm_num
    have hu1_rpow : u ^ (-1 : ℝ) = u⁻¹ := Real.rpow_neg_one u
    have hu2_rpow : u ^ (-2 : ℝ) = (u ^ 2)⁻¹ := by
      rw [Real.rpow_neg (le_of_lt hu_pos)]
      norm_num
    rw [hu3, hu1_rpow, hu2_rpow]
    dsimp [P_K, r₁, r₂, Reg_K]
    have htors_ne : (NumberField.Units.torsionOrder K : ℝ) ≠ 0 := by
      exact_mod_cast ne_of_gt (NumberField.Units.torsionOrder_pos K)
    field_simp [hu_ne, htors_ne]

theorem mitsui_archimedean_place_gamma_mellin_identities (s : ℂ) (hs : 1 < s.re) :
    (∫ v in Set.Ioi (0 : ℝ), (v : ℂ) ^ s * ((2 * v⁻¹ * Real.exp (-Real.pi * v ^ 2) : ℝ) : ℂ)) =
      Complex.Gammaℝ s ∧
    (∫ v in Set.Ioi (0 : ℝ), (v : ℂ) ^ s * ((2 * v⁻¹ * Real.exp (-2 * Real.pi * v) : ℝ) : ℂ)) =
      Complex.Gammaℂ s :=
by
  have hs_pos : 0 < s.re := by linarith
  have hs2_pos : 0 < (s / 2).re := by
    rw [Complex.div_ofNat_re]
    linarith
  have h_cpow : ∀ v ∈ Set.Ioi (0 : ℝ), (v : ℂ) ^ s * ((v⁻¹ : ℝ) : ℂ) = (v : ℂ) ^ (s - 1) := by
    intro v hv
    have hv_ne : (v : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hv)
    rw [Complex.ofReal_inv, ← Complex.cpow_neg_one, ← Complex.cpow_add _ _ hv_ne, sub_eq_add_neg]
  refine ⟨?_, ?_⟩
  · have h_real_eq : Set.EqOn
        (fun v : ℝ => (v : ℂ) ^ s * ((2 * v⁻¹ * Real.exp (-Real.pi * v ^ 2) : ℝ) : ℂ))
        (fun v : ℝ => (2 : ℂ) * ((v : ℂ) ^ (s - 1) • (Real.exp (-Real.pi * (v ^ (2 : ℝ))) : ℂ)))
        (Set.Ioi (0 : ℝ)) := by
      intro v hv
      dsimp only
      rw [smul_eq_mul, Real.rpow_two, Complex.ofReal_mul, Complex.ofReal_mul, Complex.ofReal_ofNat]
      linear_combination (2 * (Real.exp (-Real.pi * v ^ 2) : ℂ)) * (h_cpow v hv)
    rw [MeasureTheory.setIntegral_congr_fun measurableSet_Ioi h_real_eq,
      MeasureTheory.integral_const_mul]
    change (2 : ℂ) * mellin (fun v : ℝ => (Real.exp (-Real.pi * (v ^ (2 : ℝ))) : ℂ)) s =
      Complex.Gammaℝ s
    have h_m1 := mellin_comp_rpow (fun u : ℝ => (Real.exp (-Real.pi * u) : ℂ)) s 2
    have h_neg : (fun u : ℝ => (Real.exp (-Real.pi * u) : ℂ)) =
        (fun u : ℝ => (Real.exp (-(Real.pi * u)) : ℂ)) := by
      ext u; congr 1; congr 1; ring
    rw [h_m1, h_neg, Complex.ofReal_ofNat,
      mellin_comp_mul_left (fun x : ℝ => (Real.exp (-x) : ℂ)) (s / 2) Real.pi_pos,
      ← Complex.GammaIntegral_eq_mellin, ← Complex.Gamma_eq_integral hs2_pos,
      Complex.Gammaℝ_def, Complex.real_smul, smul_eq_mul,
      abs_of_pos (by norm_num : (0 : ℝ) < 2)]
    have h_exp_eq : -(s / 2) = -s / 2 := by ring
    rw [h_exp_eq]
    push_cast
    ring
  · have h_cplx_eq : Set.EqOn
        (fun v : ℝ => (v : ℂ) ^ s * ((2 * v⁻¹ * Real.exp (-2 * Real.pi * v) : ℝ) : ℂ))
        (fun v : ℝ => (2 : ℂ) * ((v : ℂ) ^ (s - 1) • (Real.exp (-((2 * Real.pi) * v)) : ℂ)))
        (Set.Ioi (0 : ℝ)) := by
      intro v hv
      dsimp only
      have h_arg : -2 * Real.pi * v = -(2 * Real.pi * v) := by ring
      rw [smul_eq_mul, h_arg, Complex.ofReal_mul, Complex.ofReal_mul, Complex.ofReal_ofNat]
      linear_combination (2 * (Real.exp (-(2 * Real.pi * v)) : ℂ)) * (h_cpow v hv)
    rw [MeasureTheory.setIntegral_congr_fun measurableSet_Ioi h_cplx_eq,
      MeasureTheory.integral_const_mul]
    change (2 : ℂ) * mellin (fun v : ℝ => (Real.exp (-((2 * Real.pi) * v)) : ℂ)) s =
      Complex.Gammaℂ s
    have h2pi_pos : 0 < 2 * Real.pi := by positivity
    rw [mellin_comp_mul_left (fun x : ℝ => (Real.exp (-x) : ℂ)) s h2pi_pos,
      ← Complex.GammaIntegral_eq_mellin, ← Complex.Gamma_eq_integral hs_pos,
      Complex.Gammaℂ_def, smul_eq_mul]
    push_cast
    ring

theorem mitsui_mellin_Ioi_zero_comp_mul_left_and_integrableOn (W₀ : ℝ → ℝ) (D : ℝ) (hD_pos : 0 < D)
    (hW₀_meas : Measurable W₀)
    (hW₀_nn : ∀ τ : ℝ, 0 ≤ W₀ τ) :
    MeasureTheory.AEStronglyMeasurable
      (fun t : ℝ => D ^ (-1 / 2 : ℝ) * W₀ (D ^ (-1 / 2 : ℝ) * t))
      (MeasureTheory.volume.restrict (Set.Ioi (0 : ℝ))) ∧
    (∀ t ∈ Set.Ioi (0 : ℝ), 0 ≤ D ^ (-1 / 2 : ℝ) * W₀ (D ^ (-1 / 2 : ℝ) * t)) ∧
    (∀ (s : ℂ) (Γ₀ : ℂ),
      MeasureTheory.IntegrableOn (fun τ : ℝ => τ ^ s.re * W₀ τ) (Set.Ioi (0 : ℝ)) MeasureTheory.volume →
      (∫ τ in Set.Ioi (0 : ℝ), (τ : ℂ) ^ s * (W₀ τ : ℂ)) = Γ₀ →
      MeasureTheory.IntegrableOn
        (fun t : ℝ => t ^ s.re * (D ^ (-1 / 2 : ℝ) * W₀ (D ^ (-1 / 2 : ℝ) * t)))
        (Set.Ioi (0 : ℝ)) MeasureTheory.volume ∧
      (∫ t in Set.Ioi (0 : ℝ), (t : ℂ) ^ s * ((D ^ (-1 / 2 : ℝ) * W₀ (D ^ (-1 / 2 : ℝ) * t) : ℝ) : ℂ)) =
        (D : ℂ) ^ (s / 2) * Γ₀) :=
by
  set a : ℝ := D ^ (-1 / 2 : ℝ)
  have ha_pos : 0 < a := Real.rpow_pos_of_pos hD_pos (-1 / 2 : ℝ)
  have ha_nn : 0 ≤ a := le_of_lt ha_pos
  have ha_ne : a ≠ 0 := ne_of_gt ha_pos
  have hD_nn : 0 ≤ D := le_of_lt hD_pos
  have h_meas : Measurable (fun t : ℝ => a * W₀ (a * t)) :=
    measurable_const.mul (hW₀_meas.comp (measurable_const.mul measurable_id))
  refine ⟨h_meas.aestronglyMeasurable, fun t _ => mul_nonneg ha_nn (hW₀_nn (a * t)), ?_⟩
  intro s Γ₀ hW₀_int hW₀_mellin
  let G_re : ℝ → ℝ := fun τ => τ ^ s.re * W₀ τ
  have h_comp_int : MeasureTheory.IntegrableOn (fun t : ℝ => G_re (a * t)) (Set.Ioi (0 : ℝ)) MeasureTheory.volume := by
    rw [MeasureTheory.integrableOn_Ioi_comp_mul_left_iff G_re (0 : ℝ) ha_pos, mul_zero]
    exact hW₀_int
  have h_scaled_int : MeasureTheory.IntegrableOn
      (fun t : ℝ => (D ^ (s.re / 2) * a) * G_re (a * t)) (Set.Ioi (0 : ℝ)) MeasureTheory.volume :=
    h_comp_int.const_mul (D ^ (s.re / 2) * a)
  have h_int : MeasureTheory.IntegrableOn
      (fun t : ℝ => t ^ s.re * (a * W₀ (a * t))) (Set.Ioi (0 : ℝ)) MeasureTheory.volume := by
    refine h_scaled_int.congr_fun (fun t ht => ?_) measurableSet_Ioi
    have ht_nn : 0 ≤ t := le_of_lt (Set.mem_Ioi.mp ht)
    dsimp [G_re]
    have h_mul_rpow : (a * t) ^ s.re = a ^ s.re * t ^ s.re := Real.mul_rpow ha_nn ht_nn
    have h_a_rpow : a ^ s.re = D ^ ((-1 / 2 : ℝ) * s.re) := by
      dsimp [a]
      rw [← Real.rpow_mul hD_nn]
    have h_D_cancel : D ^ (s.re / 2) * a ^ s.re = 1 := by
      rw [h_a_rpow, ← Real.rpow_add hD_pos]
      have h_exp : s.re / 2 + (-1 / 2 : ℝ) * s.re = 0 := by ring
      rw [h_exp, Real.rpow_zero]
    calc (D ^ (s.re / 2) * a) * ((a * t) ^ s.re * W₀ (a * t))
        = (D ^ (s.re / 2) * a ^ s.re) * t ^ s.re * (a * W₀ (a * t)) := by
          rw [h_mul_rpow]; ring
      _ = 1 * t ^ s.re * (a * W₀ (a * t)) := by rw [h_D_cancel]
      _ = t ^ s.re * (a * W₀ (a * t)) := by ring
  refine ⟨h_int, ?_⟩
  set b : ℝ := D ^ (1 / 2 : ℝ)
  have hb_nn : 0 ≤ b := Real.rpow_nonneg hD_nn (1 / 2 : ℝ)
  have hba : b * a = 1 := by
    dsimp [b, a]
    rw [← Real.rpow_add hD_pos]
    norm_num
  have hb_cpow : (b : ℂ) ^ s = (D : ℂ) ^ (s / 2) := by
    dsimp [b]
    rw [← Complex.cpow_mul_ofReal_nonneg hD_nn]
    congr 1
    push_cast
    ring
  let G : ℝ → ℂ := fun τ => (τ : ℂ) ^ s * (W₀ τ : ℂ)
  have h_congr : ∀ t ∈ Set.Ioi (0 : ℝ),
      (t : ℂ) ^ s * ((a * W₀ (a * t) : ℝ) : ℂ) = ((D : ℂ) ^ (s / 2) * (a : ℂ)) * G (a * t) := by
    intro t ht
    have ht_nn : 0 ≤ t := le_of_lt (Set.mem_Ioi.mp ht)
    have hat_nn : 0 ≤ a * t := mul_nonneg ha_nn ht_nn
    have ht_eq : t = b * (a * t) := by
      calc t = 1 * t := (one_mul t).symm
        _ = (b * a) * t := by rw [hba]
        _ = b * (a * t) := mul_assoc b a t
    have ht_cpow : (t : ℂ) ^ s = (D : ℂ) ^ (s / 2) * ((a * t : ℝ) : ℂ) ^ s := by
      conv_lhs => rw [ht_eq]
      rw [Complex.ofReal_mul b (a * t), Complex.mul_cpow_ofReal_nonneg hb_nn hat_nn, hb_cpow]
    dsimp [G]
    rw [ht_cpow, Complex.ofReal_mul a (W₀ (a * t))]
    ring
  have h_set_int : (∫ t in Set.Ioi (0 : ℝ), (t : ℂ) ^ s * ((a * W₀ (a * t) : ℝ) : ℂ)) =
      (∫ t in Set.Ioi (0 : ℝ), ((D : ℂ) ^ (s / 2) * (a : ℂ)) * G (a * t)) :=
    MeasureTheory.setIntegral_congr_fun measurableSet_Ioi h_congr
  rw [h_set_int, MeasureTheory.integral_const_mul, MeasureTheory.integral_comp_mul_left_Ioi G (0 : ℝ) ha_pos,
    mul_zero]
  change ((D : ℂ) ^ (s / 2) * (a : ℂ)) * (a⁻¹ • ∫ τ in Set.Ioi (0 : ℝ), (τ : ℂ) ^ s * (W₀ τ : ℂ)) =
    (D : ℂ) ^ (s / 2) * Γ₀
  rw [hW₀_mellin, Complex.real_smul, Complex.ofReal_inv]
  have ha_c_ne : (a : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr ha_ne
  calc ((D : ℂ) ^ (s / 2) * (a : ℂ)) * ((a : ℂ)⁻¹ * Γ₀)
      = (D : ℂ) ^ (s / 2) * ((a : ℂ) * (a : ℂ)⁻¹) * Γ₀ := by ring
    _ = (D : ℂ) ^ (s / 2) * 1 * Γ₀ := by rw [mul_inv_cancel₀ ha_c_ne]
    _ = (D : ℂ) ^ (s / 2) * Γ₀ := by ring

theorem mitsui_ideal_norm_tsum_measurable_and_exp_bound_of_kernel_exp_bound {K : Type u} [Field K] [NumberField K]
    (W : ℝ → ℝ) (C₀ c α : ℝ) (hC₀ : 0 < C₀) (hc : 0 < c) (hα : 0 < α)
    (hW_meas : Measurable W)
    (hW_nn : ∀ t : ℝ, 0 ≤ W t)
    (hW_bound : ∀ t ∈ Set.Ioi (1 : ℝ), W t ≤ C₀ * Real.exp (-2 * c * t ^ α)) :
    ∃ C : ℝ, 0 < C ∧
      MeasureTheory.AEStronglyMeasurable
        (fun u : ℝ => ∑' m : ℕ,
          (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm I = m} : ℝ) *
            (m : ℝ) * W ((m : ℝ) * u))
        (MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))) ∧
      (∀ u ∈ Set.Ioi (1 : ℝ),
        0 ≤ ∑' m : ℕ,
          (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm I = m} : ℝ) *
            (m : ℝ) * W ((m : ℝ) * u)) ∧
      (∀ u ∈ Set.Ioi (1 : ℝ),
        (∑' m : ℕ,
          (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm I = m} : ℝ) *
            (m : ℝ) * W ((m : ℝ) * u)) ≤
          C * Real.exp (-c * u ^ α)) :=
by
  let R := NumberField.RingOfIntegers K
  let a_K : ℕ → ℕ := fun m => Nat.card {I : Ideal R // Ideal.absNorm I = m}
  let f : ℕ → ℝ → ℝ := fun m u => (a_K m : ℝ) * (m : ℝ) * W ((m : ℝ) * u)
  have hf_nn : ∀ (m : ℕ) (u : ℝ), 0 ≤ f m u := by
    intro m u
    dsimp [f]
    exact mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)) (hW_nn _)
  have hΨ_nn : ∀ u ∈ Set.Ioi (1 : ℝ), 0 ≤ ∑' m : ℕ, f m u := by
    intro u _
    exact tsum_nonneg (fun m => hf_nn m u)
  have hf_meas : ∀ m : ℕ, Measurable (f m) := by
    intro m
    dsimp [f]
    exact (measurable_const.mul measurable_const).mul (hW_meas.comp (measurable_const.mul measurable_id))
  let f_nn : ℕ → ℝ → NNReal := fun m u => ⟨f m u, hf_nn m u⟩
  have hf_nn_meas : ∀ m : ℕ, Measurable (f_nn m) := fun m => (hf_meas m).subtype_mk
  have hΨ_meas_global : Measurable (fun u : ℝ => ∑' m : ℕ, f m u) := by
    have h1 : Measurable (fun u : ℝ => ((∑' m : ℕ, f_nn m u : NNReal) : ℝ)) :=
      (Measurable.nnreal_tsum hf_nn_meas).coe_nnreal_real
    have h2 : (fun u : ℝ => ((∑' m : ℕ, f_nn m u : NNReal) : ℝ)) = (fun u : ℝ => ∑' m : ℕ, f m u) := by
      ext u
      exact NNReal.coe_tsum
    rwa [h2] at h1
  have hΨ_meas : MeasureTheory.AEStronglyMeasurable (fun u : ℝ => ∑' m : ℕ, f m u)
      (MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))) :=
    hΨ_meas_global.aestronglyMeasurable
  have h_ideal_card : ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ x : ℝ, 1 ≤ x →
      (Nat.card {J : Ideal (NumberField.RingOfIntegers K) // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤
        C₁ * x := by
    set L_K : ℝ :=
      2 ^ NumberField.InfinitePlace.nrRealPlaces K *
        (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
        NumberField.Units.regulator K *
        (NumberField.classNumber K : ℝ) /
        ((NumberField.Units.torsionOrder K : ℝ) * Real.sqrt |(NumberField.discr K : ℝ)|)
    have h_tendsto : Filter.Tendsto
        (fun x : ℝ => (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x)
        Filter.atTop (nhds L_K) :=
      NumberField.Ideal.tendsto_norm_le_div_atTop K
    obtain ⟨S₀, hS₀⟩ := (Metric.tendsto_atTop.mp h_tendsto) 1 zero_lt_one
    let S₁ : ℝ := max S₀ 1
    let N₁ : ℕ := Nat.card {J : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm J ≤ ⌊S₁⌋₊}
    let C₁ : ℝ := max (|L_K| + 1) ((N₁ : ℝ) + 1)
    have hC₁_pos : 0 < C₁ := by
      have h1 : 0 ≤ |L_K| := abs_nonneg L_K
      have h2 : |L_K| + 1 ≤ C₁ := le_max_left _ _
      linarith
    refine ⟨C₁, hC₁_pos, ?_⟩
    intro x hx
    have hx_pos : 0 < x := lt_of_lt_of_le zero_lt_one hx
    by_cases hS : S₁ ≤ x
    · have hS₀_le : S₀ ≤ x := le_trans (le_max_left S₀ 1) hS
      have h_dist := hS₀ x hS₀_le
      rw [Real.dist_eq] at h_dist
      have h_sub : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x - L_K < 1 :=
        (abs_sub_lt_iff.mp h_dist).1
      have h_abs : L_K ≤ |L_K| := le_abs_self L_K
      have h_max : |L_K| + 1 ≤ C₁ := le_max_left _ _
      have h_div_le : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x ≤ C₁ := by linarith
      exact (div_le_iff₀ hx_pos).mp h_div_le
    · have hx_le : x ≤ S₁ := le_of_not_ge hS
      have h_sub : {J : Ideal (NumberField.RingOfIntegers K) | (Ideal.absNorm J : ℝ) ≤ x} ⊆
          {J : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm J ≤ ⌊S₁⌋₊} := by
        intro J hJ
        exact Nat.le_floor (le_trans hJ hx_le)
      have h_fin : {J : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm J ≤ ⌊S₁⌋₊}.Finite :=
        Ideal.finite_setOf_absNorm_le ⌊S₁⌋₊
      have h_card_le : Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ x} ≤ N₁ :=
        Nat.card_mono h_fin h_sub
      have h_card_real : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ (N₁ : ℝ) := by exact_mod_cast h_card_le
      have h_max : (N₁ : ℝ) + 1 ≤ C₁ := le_max_right _ _
      have h_le_C₁ : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ := by linarith
      nlinarith
  obtain ⟨C₁, hC₁_pos, hC₁⟩ := h_ideal_card
  have ha_K_bound : ∀ m : ℕ, 1 ≤ m → (a_K m : ℝ) ≤ C₁ * (m : ℝ) := by
    intro m hm
    have hm_real : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
    have h_sub : {I : Ideal R | Ideal.absNorm I = m} ⊆ {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ (m : ℝ)} := by
      intro I hI
      change (Ideal.absNorm I : ℝ) ≤ (m : ℝ)
      rw [Set.mem_setOf_eq.mp hI]
    have h_fin : {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ (m : ℝ)}.Finite := by
      refine Set.Finite.subset (Ideal.finite_setOf_absNorm_le m) ?_
      intro J hJ
      exact_mod_cast hJ
    have h_card_le : a_K m ≤ Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ (m : ℝ)} :=
      Nat.card_mono h_fin h_sub
    have h_card_real : (a_K m : ℝ) ≤ (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ (m : ℝ)} : ℝ) := by
      exact_mod_cast h_card_le
    exact le_trans h_card_real (hC₁ (m : ℝ) hm_real)
  let K₀ : ℝ := (4 / α) * Real.log (4 / (c * α))
  have h_dom : ∀ m : ℕ, 1 ≤ m →
      ((m : ℝ) ^ (2 : ℝ)) * Real.exp (-c * (m : ℝ) ^ α) ≤ Real.exp K₀ * ((m : ℝ) ^ (2 : ℝ))⁻¹ := by
    intro m hm
    have hm_pos : (0 : ℝ) < (m : ℝ) := by exact_mod_cast (by omega : 0 < m)
    let y : ℝ := (c * α / 4) * (m : ℝ) ^ α
    have hmα_pos : 0 < (m : ℝ) ^ α := Real.rpow_pos_of_pos hm_pos α
    have hy_pos : 0 < y := by dsimp [y]; positivity
    have h_log_y : Real.log y ≤ y := by
      have h1 := Real.log_le_sub_one_of_pos hy_pos
      linarith
    have h_mα_eq : (m : ℝ) ^ α = y * (4 / (c * α)) := by
      dsimp [y]
      have hc_ne : c ≠ 0 := ne_of_gt hc
      have hα_ne : α ≠ 0 := ne_of_gt hα
      field_simp [hc_ne, hα_ne]
    have h_log_mα : α * Real.log (m : ℝ) = Real.log y + Real.log (4 / (c * α)) := by
      rw [← Real.log_rpow hm_pos α, h_mα_eq, Real.log_mul (ne_of_gt hy_pos) (by positivity)]
    have h_ineq1 : α * Real.log (m : ℝ) ≤ y + Real.log (4 / (c * α)) := by
      linarith
    have h_ineq2 : (4 / α) * (α * Real.log (m : ℝ)) ≤ (4 / α) * (y + Real.log (4 / (c * α))) :=
      mul_le_mul_of_nonneg_left h_ineq1 (by positivity)
    have h_lhs_simp : (4 / α) * (α * Real.log (m : ℝ)) = 4 * Real.log (m : ℝ) := by
      have hα_ne : α ≠ 0 := ne_of_gt hα
      field_simp [hα_ne]
    have h_rhs_simp : (4 / α) * (y + Real.log (4 / (c * α))) = c * (m : ℝ) ^ α + K₀ := by
      dsimp [y, K₀]
      have hα_ne : α ≠ 0 := ne_of_gt hα
      field_simp [hα_ne]
    have h_ineq3 : Real.log (m : ℝ) * (2 : ℝ) + (-c * (m : ℝ) ^ α) ≤ K₀ + Real.log (m : ℝ) * (-2 : ℝ) := by
      linarith
    have h_exp_ineq : Real.exp (Real.log (m : ℝ) * (2 : ℝ) + (-c * (m : ℝ) ^ α)) ≤
        Real.exp (K₀ + Real.log (m : ℝ) * (-2 : ℝ)) :=
      Real.exp_le_exp.mpr h_ineq3
    rw [Real.exp_add, Real.exp_add, ← Real.rpow_def_of_pos hm_pos (2 : ℝ),
        ← Real.rpow_def_of_pos hm_pos (-2 : ℝ), Real.rpow_neg (le_of_lt hm_pos) (2 : ℝ)] at h_exp_ineq
    exact h_exp_ineq
  let b : ℕ → ℝ := fun m => (C₀ * C₁ * Real.exp K₀) * ((m : ℝ) ^ (2 : ℝ))⁻¹
  have h_term_le : ∀ u ∈ Set.Ioi (1 : ℝ), ∀ m : ℕ, f m u ≤ b m * Real.exp (-c * u ^ α) := by
    intro u hu m
    have hu_gt_one : 1 < u := Set.mem_Ioi.mp hu
    have hu_pos : 0 < u := lt_trans zero_lt_one hu_gt_one
    have hu_ge_one : 1 ≤ u := le_of_lt hu_gt_one
    by_cases hm0 : m = 0
    · subst hm0
      have hf0 : f 0 u = 0 := by dsimp [f]; simp
      have hb0 : b 0 = 0 := by
        dsimp [b]
        rw [Nat.cast_zero, Real.zero_rpow (by norm_num : (2 : ℝ) ≠ 0), inv_zero, mul_zero]
      rw [hf0, hb0, zero_mul]
    · have hm_ge_one_nat : 1 ≤ m := Nat.one_le_iff_ne_zero.mpr hm0
      have hm_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm_ge_one_nat
      have hm_pos : (0 : ℝ) < (m : ℝ) := lt_of_lt_of_le zero_lt_one hm_ge_one
      have hmu_gt_one : 1 < (m : ℝ) * u :=
        lt_of_lt_of_le hu_gt_one (le_mul_of_one_le_left (le_of_lt hu_pos) hm_ge_one)
      have hmα_ge_one : 1 ≤ (m : ℝ) ^ α := Real.one_le_rpow hm_ge_one (le_of_lt hα)
      have huα_ge_one : 1 ≤ u ^ α := Real.one_le_rpow hu_ge_one (le_of_lt hα)
      have hmu_rpow : ((m : ℝ) * u) ^ α = (m : ℝ) ^ α * u ^ α :=
        Real.mul_rpow (le_of_lt hm_pos) (le_of_lt hu_pos)
      have hmα_le : (m : ℝ) ^ α ≤ ((m : ℝ) * u) ^ α := by
        rw [hmu_rpow]
        exact le_mul_of_one_le_right (by positivity) huα_ge_one
      have huα_le : u ^ α ≤ ((m : ℝ) * u) ^ α := by
        rw [hmu_rpow]
        exact le_mul_of_one_le_left (by positivity) hmα_ge_one
      have h_exp_split : Real.exp (-2 * c * ((m : ℝ) * u) ^ α) ≤
          Real.exp (-c * (m : ℝ) ^ α) * Real.exp (-c * u ^ α) := by
        rw [← Real.exp_add, Real.exp_le_exp]
        have h_sum : (m : ℝ) ^ α + u ^ α ≤ 2 * ((m : ℝ) * u) ^ α := by linarith
        nlinarith
      have hW_mu : W ((m : ℝ) * u) ≤ C₀ * Real.exp (-c * (m : ℝ) ^ α) * Real.exp (-c * u ^ α) := by
        calc W ((m : ℝ) * u)
            ≤ C₀ * Real.exp (-2 * c * ((m : ℝ) * u) ^ α) := hW_bound ((m : ℝ) * u) hmu_gt_one
          _ ≤ C₀ * (Real.exp (-c * (m : ℝ) ^ α) * Real.exp (-c * u ^ α)) :=
              mul_le_mul_of_nonneg_left h_exp_split (le_of_lt hC₀)
          _ = C₀ * Real.exp (-c * (m : ℝ) ^ α) * Real.exp (-c * u ^ α) := by ring
      have ha_m : (a_K m : ℝ) * (m : ℝ) ≤ C₁ * (m : ℝ) ^ (2 : ℝ) := by
        calc (a_K m : ℝ) * (m : ℝ)
            ≤ (C₁ * (m : ℝ)) * (m : ℝ) :=
              mul_le_mul_of_nonneg_right (ha_K_bound m hm_ge_one_nat) (le_of_lt hm_pos)
          _ = C₁ * ((m : ℝ) ^ 2) := by ring
          _ = C₁ * (m : ℝ) ^ (2 : ℝ) := by rw [Real.rpow_two]
      have h_dom_m := h_dom m hm_ge_one_nat
      calc f m u
          = ((a_K m : ℝ) * (m : ℝ)) * W ((m : ℝ) * u) := rfl
        _ ≤ (C₁ * (m : ℝ) ^ (2 : ℝ)) * (C₀ * Real.exp (-c * (m : ℝ) ^ α) * Real.exp (-c * u ^ α)) :=
            mul_le_mul ha_m hW_mu (hW_nn _) (by positivity)
        _ = (C₀ * C₁) * (((m : ℝ) ^ (2 : ℝ)) * Real.exp (-c * (m : ℝ) ^ α)) * Real.exp (-c * u ^ α) := by ring
        _ ≤ (C₀ * C₁) * (Real.exp K₀ * ((m : ℝ) ^ (2 : ℝ))⁻¹) * Real.exp (-c * u ^ α) := by
            refine mul_le_mul_of_nonneg_right ?_ (le_of_lt (Real.exp_pos _))
            exact mul_le_mul_of_nonneg_left h_dom_m (by positivity)
        _ = b m * Real.exp (-c * u ^ α) := by dsimp [b]; ring
  have hb_sum : Summable b := by
    dsimp [b]
    exact (Real.summable_nat_rpow_inv.mpr one_lt_two).mul_left (C₀ * C₁ * Real.exp K₀)
  have hb_nn : ∀ m : ℕ, 0 ≤ b m := by
    intro m
    dsimp [b]
    positivity
  have h_tsum_b_nn : 0 ≤ ∑' m : ℕ, b m := tsum_nonneg hb_nn
  let C : ℝ := (∑' m : ℕ, b m) + 1
  have hC_pos : 0 < C := by dsimp [C]; linarith
  have h_sum_le_C : (∑' m : ℕ, b m) ≤ C := by dsimp [C]; linarith
  refine ⟨C, hC_pos, hΨ_meas, hΨ_nn, ?_⟩
  intro u hu
  have h_maj_sum : Summable (fun m : ℕ => b m * Real.exp (-c * u ^ α)) :=
    hb_sum.mul_right (Real.exp (-c * u ^ α))
  have hf_sum : Summable (fun m : ℕ => f m u) :=
    Summable.of_nonneg_of_le (fun m => hf_nn m u) (h_term_le u hu) h_maj_sum
  calc (∑' m : ℕ, f m u)
      ≤ ∑' m : ℕ, b m * Real.exp (-c * u ^ α) :=
        hf_sum.tsum_le_tsum (h_term_le u hu) h_maj_sum
    _ = (∑' m : ℕ, b m) * Real.exp (-c * u ^ α) := tsum_mul_right
    _ ≤ C * Real.exp (-c * u ^ α) :=
        mul_le_mul_of_nonneg_right h_sum_le_C (le_of_lt (Real.exp_pos _))

theorem mitsui_dedekindZeta_theta_kernel_inversion_and_archimedean_unfolding {K : Type u} [Field K] [NumberField K] :
    ∃ (W_K Ψ_K : ℝ → ℝ) (C c α : ℝ),
      0 < C ∧ 0 < c ∧ 0 < α ∧
      MeasureTheory.AEStronglyMeasurable Ψ_K (MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))) ∧
      (∀ u ∈ Set.Ioi (1 : ℝ), 0 ≤ Ψ_K u) ∧
      (∀ u ∈ Set.Ioi (1 : ℝ), Ψ_K u ≤ C * Real.exp (-c * u ^ α)) ∧
      (∀ u ∈ Set.Ioi (1 : ℝ),
        u ^ (-3 : ℝ) * Ψ_K u⁻¹ =
          Ψ_K u +
            ((2 : ℝ) ^ (NumberField.InfinitePlace.nrRealPlaces K + NumberField.InfinitePlace.nrComplexPlaces K) *
              NumberField.Units.regulator K *
              (NumberField.classNumber K : ℝ) /
              (NumberField.Units.torsionOrder K : ℝ)) *
              (u ^ (-1 : ℝ) - u ^ (-2 : ℝ))) ∧
      MeasureTheory.AEStronglyMeasurable W_K (MeasureTheory.volume.restrict (Set.Ioi (0 : ℝ))) ∧
      (∀ t ∈ Set.Ioi (0 : ℝ), 0 ≤ W_K t) ∧
      (∀ s : ℂ, 1 < s.re →
        MeasureTheory.IntegrableOn (fun t : ℝ => t ^ s.re * W_K t) (Set.Ioi (0 : ℝ)) MeasureTheory.volume ∧
        (∫ t in Set.Ioi (0 : ℝ), (t : ℂ) ^ s * (W_K t : ℂ)) =
          (((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ (s / 2) *
            (Complex.Gammaℝ s) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
            (Complex.Gammaℂ s) ^ (NumberField.InfinitePlace.nrComplexPlaces K))) ∧
      (∀ u ∈ Set.Ioi (0 : ℝ),
        Ψ_K u = ∑' m : ℕ,
          (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm I = m} : ℝ) *
            (m : ℝ) * W_K ((m : ℝ) * u)) :=
by
  obtain ⟨W₀, C₀, c, α, hC₀_pos, hc_pos, hα_pos, hW₀_meas, hW₀_nn, hW₀_mellin, hWK_bound, hΨ_inv⟩ :=
    mitsui_unitDiscr_archimedean_kernel_fubini_and_theta_inversion (K := K)
  set D : ℝ := |(NumberField.discr K : ℝ)|
  have hD_pos : 0 < D := by
    dsimp [D]
    exact abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  let W_K : ℝ → ℝ := fun t => D ^ (-1 / 2 : ℝ) * W₀ (D ^ (-1 / 2 : ℝ) * t)
  let Ψ_K : ℝ → ℝ := fun u => ∑' m : ℕ,
    (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm I = m} : ℝ) *
      (m : ℝ) * W_K ((m : ℝ) * u)
  have hWK_meas : Measurable W_K :=
    measurable_const.mul (hW₀_meas.comp (measurable_const.mul measurable_id))
  have hWK_nn_all : ∀ t : ℝ, 0 ≤ W_K t :=
    fun t => mul_nonneg (Real.rpow_nonneg (le_of_lt hD_pos) _) (hW₀_nn _)
  obtain ⟨hWK_aemeas, hWK_nn, hWK_rescale⟩ :=
    mitsui_mellin_Ioi_zero_comp_mul_left_and_integrableOn W₀ D hD_pos hW₀_meas hW₀_nn
  obtain ⟨C, hC_pos, hΨ_meas, hΨ_nn, hΨ_bound⟩ :=
    mitsui_ideal_norm_tsum_measurable_and_exp_bound_of_kernel_exp_bound
      (K := K) W_K C₀ c α hC₀_pos hc_pos hα_pos hWK_meas hWK_nn_all hWK_bound
  refine ⟨W_K, Ψ_K, C, c, α, hC_pos, hc_pos, hα_pos, hΨ_meas, hΨ_nn, hΨ_bound, hΨ_inv,
    hWK_aemeas, hWK_nn, ?_, fun _ _ => rfl⟩
  intro s hs
  obtain ⟨hW₀_int_s, hW₀_eq_s⟩ := hW₀_mellin s hs
  obtain ⟨h_real_s, h_cplx_s⟩ := mitsui_archimedean_place_gamma_mellin_identities s hs
  rw [h_real_s, h_cplx_s] at hW₀_eq_s
  obtain ⟨hWK_int_s, hWK_eq_s⟩ := hWK_rescale s
    ((Complex.Gammaℝ s) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
      (Complex.Gammaℂ s) ^ (NumberField.InfinitePlace.nrComplexPlaces K))
    hW₀_int_s hW₀_eq_s
  refine ⟨hWK_int_s, ?_⟩
  rw [hWK_eq_s]
  ring

theorem mitsui_theta_kernel_moments_integrable_of_exp_bound (Ψ : ℝ → ℝ) (C c α : ℝ) (hC : 0 < C) (hc : 0 < c) (hα : 0 < α)
    (hΨ_meas : MeasureTheory.AEStronglyMeasurable Ψ (MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))))
    (hΨ_nn : ∀ u ∈ Set.Ioi (1 : ℝ), 0 ≤ Ψ u)
    (hΨ_bound : ∀ u ∈ Set.Ioi (1 : ℝ), Ψ u ≤ C * Real.exp (-c * u ^ α))
    (σ : ℝ) :
    MeasureTheory.IntegrableOn (fun u : ℝ => u ^ σ * Ψ u) (Set.Ioi (1 : ℝ)) MeasureTheory.volume :=
by
  let M : ℝ := max (|σ| + 2) 1
  have hM_pos : 0 < M := lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  have hσ_le : σ + 2 ≤ M := by
    have h1 : σ + 2 ≤ |σ| + 2 := by linarith [le_abs_self σ]
    exact le_trans h1 (le_max_left _ _)
  let K_σ : ℝ := (M / α) * Real.log (M / (c * α))
  have h_rpow_int : MeasureTheory.IntegrableOn (fun u : ℝ => u ^ (-2 : ℝ)) (Set.Ioi (1 : ℝ)) MeasureTheory.volume :=
    integrableOn_Ioi_rpow_of_lt (by norm_num : (-2 : ℝ) < -1) zero_lt_one
  have hg_int : MeasureTheory.IntegrableOn (fun u : ℝ => (C * Real.exp K_σ) * u ^ (-2 : ℝ))
      (Set.Ioi (1 : ℝ)) MeasureTheory.volume :=
    h_rpow_int.const_mul (C * Real.exp K_σ)
  have h_cont : ContinuousOn (fun u : ℝ => u ^ σ) (Set.Ioi (1 : ℝ)) :=
    ContinuousOn.rpow_const continuousOn_id (fun u hu => Or.inl (ne_of_gt (lt_trans zero_lt_one hu)))
  have h_meas : MeasureTheory.AEStronglyMeasurable (fun u : ℝ => u ^ σ * Ψ u)
      (MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))) :=
    (h_cont.aestronglyMeasurable measurableSet_Ioi).mul hΨ_meas
  refine hg_int.mono' h_meas ?_
  filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioi] with u hu
  have hu_gt_one : 1 < u := hu
  have hu_pos : 0 < u := lt_trans zero_lt_one hu_gt_one
  have hlog_pos : 0 < Real.log u := Real.log_pos hu_gt_one
  have huα_pos : 0 < u ^ α := Real.rpow_pos_of_pos hu_pos α
  set y : ℝ := (c * α / M) * u ^ α
  have hy_pos : 0 < y := by dsimp [y]; positivity
  have h_log_y : Real.log y ≤ y :=
    le_trans (Real.log_le_sub_one_of_pos hy_pos) (by linarith)
  have hy_eq : u ^ α = y * (M / (c * α)) := by
    dsimp [y]
    field_simp [ne_of_gt hc, ne_of_gt hα, ne_of_gt hM_pos]
  have h_log_uα : α * Real.log u = Real.log y + Real.log (M / (c * α)) := by
    rw [← Real.log_rpow hu_pos, hy_eq, Real.log_mul (ne_of_gt hy_pos) (by positivity)]
  have h_M_log : M * Real.log u ≤ c * u ^ α + K_σ := by
    have h1 : α * Real.log u ≤ y + Real.log (M / (c * α)) := by linarith
    have h2 : (M / α) * (α * Real.log u) ≤ (M / α) * (y + Real.log (M / (c * α))) :=
      mul_le_mul_of_nonneg_left h1 (by positivity)
    have h_lhs : (M / α) * (α * Real.log u) = M * Real.log u := by
      field_simp [ne_of_gt hα]
    have h_rhs : (M / α) * (y + Real.log (M / (c * α))) = c * u ^ α + K_σ := by
      dsimp [y, K_σ]
      field_simp [ne_of_gt hα, ne_of_gt hM_pos]
    linarith
  have h_σ2_log : (σ + 2) * Real.log u ≤ c * u ^ α + K_σ :=
    le_trans (mul_le_mul_of_nonneg_right hσ_le (le_of_lt hlog_pos)) h_M_log
  have h_exp_ineq : Real.exp (Real.log u * σ + (-c * u ^ α)) ≤
      Real.exp (K_σ + Real.log u * (-2 : ℝ)) := by
    rw [Real.exp_le_exp]
    linarith
  rw [Real.exp_add, Real.exp_add, ← Real.rpow_def_of_pos hu_pos σ,
      ← Real.rpow_def_of_pos hu_pos (-2 : ℝ)] at h_exp_ineq
  have h_nonneg : 0 ≤ u ^ σ * Ψ u := mul_nonneg (Real.rpow_nonneg (le_of_lt hu_pos) σ) (hΨ_nn u hu)
  rw [Real.norm_of_nonneg h_nonneg]
  calc u ^ σ * Ψ u
      ≤ u ^ σ * (C * Real.exp (-c * u ^ α)) :=
        mul_le_mul_of_nonneg_left (hΨ_bound u hu) (Real.rpow_nonneg (le_of_lt hu_pos) σ)
    _ = C * (u ^ σ * Real.exp (-c * u ^ α)) := by ring
    _ ≤ C * (Real.exp K_σ * u ^ (-2 : ℝ)) :=
        mul_le_mul_of_nonneg_left h_exp_ineq (le_of_lt hC)
    _ = (C * Real.exp K_σ) * u ^ (-2 : ℝ) := by ring

theorem mitsui_dedekindZeta_mellin_Ioi_zero_of_kernel_unfolding {K : Type u} [Field K] [NumberField K]
    (W Ψ : ℝ → ℝ) (Γ_s : ℂ) (s : ℂ) (hs : 1 < s.re)
    (hW_meas : MeasureTheory.AEStronglyMeasurable W (MeasureTheory.volume.restrict (Set.Ioi (0 : ℝ))))
    (hW_nn : ∀ t ∈ Set.Ioi (0 : ℝ), 0 ≤ W t)
    (hW_int : MeasureTheory.IntegrableOn (fun t : ℝ => t ^ s.re * W t) (Set.Ioi (0 : ℝ)) MeasureTheory.volume)
    (hW_mellin : (∫ t in Set.Ioi (0 : ℝ), (t : ℂ) ^ s * (W t : ℂ)) = Γ_s)
    (hΨ_unfold : ∀ u ∈ Set.Ioi (0 : ℝ),
      Ψ u = ∑' m : ℕ,
        (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm I = m} : ℝ) *
          (m : ℝ) * W ((m : ℝ) * u)) :
    Γ_s * NumberField.dedekindZeta K s =
      ∫ u in Set.Ioi (0 : ℝ), (u : ℂ) ^ s * (Ψ u : ℂ) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let S : ℕ → Type u := fun e => {I : Ideal R // Ideal.absNorm I = e}
  let a_K : ℕ → ℕ := fun n => Nat.card (S n)
  have hS_fin : ∀ e : ℕ, Finite (S e) := fun e => Ideal.finite_setOf_absNorm_eq e
  letI : ∀ e, Fintype (S e) := fun e => Fintype.ofFinite (S e)
  have ha_nonneg : ∀ n : ℕ, 0 ≤ (a_K n : ℝ) := fun _ => Nat.cast_nonneg _
  have h_ideal_card : ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ x : ℝ, 1 ≤ x →
      (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ * x := by
    set L_K : ℝ :=
      2 ^ NumberField.InfinitePlace.nrRealPlaces K *
        (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
        NumberField.Units.regulator K *
        (NumberField.classNumber K : ℝ) /
        ((NumberField.Units.torsionOrder K : ℝ) * Real.sqrt |(NumberField.discr K : ℝ)|)
    have h_tendsto : Filter.Tendsto
        (fun x : ℝ => (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x)
        Filter.atTop (nhds L_K) :=
      NumberField.Ideal.tendsto_norm_le_div_atTop K
    obtain ⟨S₀, hS₀⟩ := (Metric.tendsto_atTop.mp h_tendsto) 1 zero_lt_one
    let S₁ : ℝ := max S₀ 1
    let N₁ : ℕ := Nat.card {J : Ideal R // Ideal.absNorm J ≤ ⌊S₁⌋₊}
    let C₁ : ℝ := max (|L_K| + 1) ((N₁ : ℝ) + 1)
    have hC₁_pos : 0 < C₁ := by
      have h1 : 0 ≤ |L_K| := abs_nonneg L_K
      have h2 : |L_K| + 1 ≤ C₁ := le_max_left _ _
      linarith
    refine ⟨C₁, hC₁_pos, ?_⟩
    intro x hx
    have hx_pos : 0 < x := lt_of_lt_of_le zero_lt_one hx
    by_cases hS : S₁ ≤ x
    · have hS₀_le : S₀ ≤ x := le_trans (le_max_left S₀ 1) hS
      have h_dist := hS₀ x hS₀_le
      rw [Real.dist_eq] at h_dist
      have h_sub : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x - L_K < 1 :=
        (abs_sub_lt_iff.mp h_dist).1
      have h_abs : L_K ≤ |L_K| := le_abs_self L_K
      have h_max : |L_K| + 1 ≤ C₁ := le_max_left _ _
      have h_div_le : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x ≤ C₁ := by linarith
      exact (div_le_iff₀ hx_pos).mp h_div_le
    · have hx_le : x ≤ S₁ := le_of_not_ge hS
      have h_sub : {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ x} ⊆
          {J : Ideal R | Ideal.absNorm J ≤ ⌊S₁⌋₊} := by
        intro J hJ
        exact Nat.le_floor (le_trans hJ hx_le)
      have h_fin : {J : Ideal R | Ideal.absNorm J ≤ ⌊S₁⌋₊}.Finite :=
        Ideal.finite_setOf_absNorm_le ⌊S₁⌋₊
      have h_card_le : Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} ≤ N₁ :=
        Nat.card_mono h_fin h_sub
      have h_card_real : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ (N₁ : ℝ) := by
        exact_mod_cast h_card_le
      have h_max : (N₁ : ℝ) + 1 ≤ C₁ := le_max_right _ _
      have h_le_C₁ : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ := by linarith
      nlinarith
  obtain ⟨C₁, hC₁_pos, hC₁⟩ := h_ideal_card
  have h_sum_s : Summable (LSeries.term (fun n => (a_K n : ℂ)) s) := by
    have ha_sum_bound : ∀ N : ℕ, 1 ≤ N →
        (∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ)) ≤ C₁ * (N : ℝ) ^ (1 : ℝ) := by
      intro N hN
      have hN_real : (1 : ℝ) ≤ (N : ℝ) := by exact_mod_cast hN
      let S_J := {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ (N : ℝ)}
