        refine (((Real.hasDerivAt_log hx_ne).ofReal_comp.div_const s).sub (hasDerivAt_const x (1 / s ^ 2))).sub
          (hasDerivAt_const x (1 / s))
      have hsum := h1.add (h2a.mul h2b)
      convert hsum using 1
      dsimp [g]
      have h_cpow1 : (x : ℂ) ^ (s - 1) = (x : ℂ) ^ (s - 1 - 1) * (x : ℂ) := by
        conv_lhs => rw [show s - 1 = (s - 1 - 1) + 1 by ring, Complex.cpow_add _ _ hx_ne_C, Complex.cpow_one]
      have h_cpow2 : (x : ℂ) ^ s = (x : ℂ) ^ (s - 1 - 1) * (x : ℂ) * (x : ℂ) := by
        rw [← h_cpow1]
        conv_lhs => rw [show s = (s - 1) + 1 by ring, Complex.cpow_add _ _ hx_ne_C, Complex.cpow_one]
      push_cast
      rw [h_cpow1, h_cpow2]
      field_simp [hs_ne, hs_sub_ne, hx_ne_C]
      ring
    have hG_tendsto_zero : Filter.Tendsto G (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
      rw [tendsto_zero_iff_norm_tendsto_zero]
      let B_dom : ℝ → ℝ := fun t =>
        (‖1 / (s - 1)‖ + 1 / ‖s‖) * t ^ (s.re - 1) + ‖1 / s ^ 2 + 1 / s‖ * t ^ s.re
      have hB_tendsto : Filter.Tendsto B_dom (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
        have h1 : Filter.Tendsto (fun t : ℝ => t ^ (s.re - 1)) (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
          have hc : Filter.Tendsto (fun t : ℝ => t ^ (s.re - 1)) (nhdsWithin 0 (Set.Ioi 0)) (nhds ((0 : ℝ) ^ (s.re - 1))) :=
            (Real.continuousAt_rpow_const 0 (s.re - 1) (Or.inr (le_of_lt hs_sub_pos))).continuousWithinAt.tendsto
          rwa [Real.zero_rpow (ne_of_gt hs_sub_pos)] at hc
        have h2 : Filter.Tendsto (fun t : ℝ => t ^ s.re) (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
          have hc : Filter.Tendsto (fun t : ℝ => t ^ s.re) (nhdsWithin 0 (Set.Ioi 0)) (nhds ((0 : ℝ) ^ s.re)) :=
            (Real.continuousAt_rpow_const 0 s.re (Or.inr (le_of_lt hs_pos))).continuousWithinAt.tendsto
          rwa [Real.zero_rpow (ne_of_gt hs_pos)] at hc
        have h3 := (h1.const_mul (‖1 / (s - 1)‖ + 1 / ‖s‖)).add (h2.const_mul ‖1 / s ^ 2 + 1 / s‖)
        rwa [mul_zero, mul_zero, add_zero] at h3
      refine squeeze_zero' (Filter.Eventually.of_forall (fun t => norm_nonneg (G t))) ?_ hB_tendsto
      filter_upwards [Ioo_mem_nhdsGT zero_lt_one] with t ht
      dsimp [G, B_dom]
      have ht_log_nonpos : Real.log t ≤ 0 := Real.log_nonpos (le_of_lt ht.1) (le_of_lt ht.2)
      have ht_log_le_inv : -Real.log t ≤ t⁻¹ := by linarith [h_log_inv_le ht.1]
      have h_term1 : ‖(t : ℂ) ^ (s - 1) * (1 / (s - 1))‖ = ‖1 / (s - 1)‖ * t ^ (s.re - 1) := by
        rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos ht.1, Complex.sub_re, Complex.one_re, mul_comm]
      have h_term2_split : (Real.log t : ℂ) / s - 1 / s ^ 2 - 1 / s =
