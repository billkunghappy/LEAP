    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊}
  have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Y⌋₊
  haveI : Finite S_id := hSid_fin
  let f_Y : D_Y → S_id := fun p => ⟨p.1.asIdeal, Nat.le_floor p.2⟩
  have hf_Y_inj : Function.Injective f_Y := by
    intro a b hab
    apply Subtype.ext
    exact IsDedekindDomain.HeightOneSpectrum.ext (congrArg Subtype.val hab)
  haveI : Finite D_Y := Finite.of_injective f_Y hf_Y_inj
  letI : Fintype D_Y := Fintype.ofFinite D_Y
  let f_Z : D_Z → S_id := fun p => ⟨p.1.asIdeal, Nat.le_floor (le_trans p.2 hZ_le_Y)⟩
  have hf_Z_inj : Function.Injective f_Z := by
    intro a b hab
    apply Subtype.ext
    exact IsDedekindDomain.HeightOneSpectrum.ext (congrArg Subtype.val hab)
  haveI : Finite D_Z := Finite.of_injective f_Z hf_Z_inj
  letI : Fintype D_Z := Fintype.ofFinite D_Z
  have h_log_split : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
