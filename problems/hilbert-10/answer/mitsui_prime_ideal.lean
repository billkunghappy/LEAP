              (ξ ≠ ξ₀ →
                ∑ b : ι_b,
                  c_ind ξ b * χ_real u (l_emb b) *
                    Complex.exp (((∑ j : Fin r, (v j + (e j : ℝ)) * Ω b j) : ℝ) * Complex.I) = 0))
