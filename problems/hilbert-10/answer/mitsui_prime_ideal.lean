        ∑ i : Fin n, (w.embedding (v i)).re * (q i : ℝ) := by
      intro w
      rw [map_sum, Complex.re_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, map_ratCast, Complex.mul_re, Complex.ratCast_re, Complex.ratCast_im]
      ring
    have h_im_lin : ∀ w : NumberField.InfinitePlace K,
        (w.embedding (∑ i : Fin n, (q i : K) * v i)).im =
        ∑ i : Fin n, (w.embedding (v i)).im * (q i : ℝ) := by
      intro w
      rw [map_sum, Complex.im_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, map_ratCast, Complex.mul_im, Complex.ratCast_re, Complex.ratCast_im]
      ring
    rcases ι_idx.symm j with w | ⟨w, p⟩
    · dsimp [Ψ₀]
      exact h_re_lin w.1
    · dsimp [Ψ₀]
      split_ifs with hp
      · rw [h_re_lin w.1, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => by ring)
      · rw [h_im_lin w.1, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => by ring)
  let M₀ : Matrix (Fin n) (Fin n) ℝ := Matrix.of (fun j i => Φ₀ (v₁ i) j)
  let B₀ : Matrix (Fin n) (Fin n) ℝ := Matrix.of (fun j i => Φ₀ (v₂ i / γ) j)
  have h_tr : ∀ x y : K,
      (∑ j : Fin n, Φ₀ x j * (s j * Φ₀ y j)) = (Algebra.trace ℚ K (x * y) : ℝ) := by
    intro x y
    exact (h_pair x y).trans (h_s1 x y).symm
  have h_dual' : ∀ i l : Fin n,
      (∑ j : Fin n, M₀ j i * (s j * B₀ j l)) = if i = l then 1 else 0 := by
    intro i l
    dsimp [M₀, B₀]
    rw [h_tr (v₁ i) (v₂ l / γ)]
    exact h_dual i l
  have h_det' : |(Matrix.of (fun i l : Fin n =>
      ∑ j : Fin n, M₀ j i * (s j * M₀ j l))).det| = Δ ^ 2 := by
    have h_mat_eq : Matrix.of (fun i l : Fin n => ∑ j : Fin n, M₀ j i * (s j * M₀ j l)) =
        Matrix.of (fun i l : Fin n => (Algebra.trace ℚ K (v₁ i * v₁ l) : ℝ)) := by
      ext i l
      dsimp [M₀]
      exact h_tr (v₁ i) (v₁ l)
    rw [h_mat_eq]
    exact h_det
  let A : Matrix (Fin n) (Fin n) ℝ := Matrix.of (fun j i => c j * M₀ j i)
  let N : Matrix (Fin n) (Fin n) ℝ := Matrix.of (fun j i => (c j)⁻¹ * s j * B₀ j i)
  have hAN : A.transpose * N = 1 := by
    ext i l
    rw [Matrix.mul_apply, Matrix.one_apply, ← h_dual' i l]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    dsimp [A, N]
    have hcj : c j ≠ 0 := ne_of_gt (hc_pos j)
    calc (c j * M₀ j i) * ((c j)⁻¹ * s j * B₀ j l)
      _ = (c j * (c j)⁻¹) * (M₀ j i * (s j * B₀ j l)) := by ring
      _ = 1 * (M₀ j i * (s j * B₀ j l)) := by rw [mul_inv_cancel₀ hcj]
      _ = M₀ j i * (s j * B₀ j l) := one_mul _
  have hAinvT : A.transpose⁻¹ = N := Matrix.inv_eq_right_inv hAN
  have hA_det_ne : A.det ≠ 0 := by
    have hdet : A.det * N.det = 1 := by
      have h1 := congr_arg Matrix.det hAN
      rwa [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one] at h1
    exact left_ne_zero_of_mul_eq_one hdet
  have h_T_eq : Matrix.of (fun i l : Fin n => ∑ j : Fin n, M₀ j i * (s j * M₀ j l)) =
      M₀.transpose * (Matrix.diagonal s * M₀) := by
    ext i l
    rw [Matrix.of_apply, Matrix.mul_apply]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Matrix.transpose_apply, Matrix.diagonal_mul]
  have hs_prod : (∏ j : Fin n, |s j|) = 1 := by
    simp [hs_abs]
  have hM0_sq : |M₀.det| ^ 2 = Δ ^ 2 := by
    rw [← h_det', h_T_eq, Matrix.det_mul, Matrix.det_transpose, Matrix.det_mul,
      Matrix.det_diagonal, abs_mul, abs_mul, Finset.abs_prod, hs_prod]
    ring
  have hM0_abs : |M₀.det| = Δ :=
    (sq_eq_sq₀ (abs_nonneg _) (le_of_lt hΔ)).mp hM0_sq
  have hA_eq_diag : A = Matrix.diagonal c * M₀ := by
    ext j i
    dsimp [A]
    rw [Matrix.diagonal_mul]
  have hc_prod_pos : 0 < ∏ j : Fin n, c j :=
    Finset.prod_pos (fun j _ => hc_pos j)
  have hA_det_abs : |A.det| = Δ * ∏ w : NumberField.InfinitePlace K, (t w) ^ ((w.mult : ℝ) / 2) := by
    rw [hA_eq_diag, Matrix.det_mul, Matrix.det_diagonal, abs_mul,
      abs_of_pos hc_prod_pos, hM0_abs, mul_comm, hc_prod]
  have h_vec_A : ∀ (q : Fin n → ℚ) (j : Fin n),
      A.mulVec (fun i => (q i : ℝ)) j = c j * Φ₀ (∑ i : Fin n, (q i : K) * v₁ i) j := by
    intro q j
    dsimp [A, M₀, Matrix.mulVec, dotProduct]
    rw [h_lin v₁ q j, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => by ring)
  have h_vec_N : ∀ (l : Fin n → ℤ) (j : Fin n),
      A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j =
        (c j)⁻¹ * s j * Φ₀ ((∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / γ) j := by
    intro l j
    rw [hAinvT]
    dsimp [N, B₀, Matrix.mulVec, dotProduct]
    have h_div_sum : (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / γ =
        ∑ i : Fin n, ((l i : ℚ) : K) * (v₂ i / γ) := by
      rw [Finset.sum_div]
      refine Finset.sum_congr rfl (fun i _ => mul_div_assoc _ _ _)
    rw [h_div_sum, h_lin (fun i => v₂ i / γ) (fun i => (l i : ℚ)) j, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Rat.cast_intCast]
    ring
  refine ⟨A, d, hA_det_ne, hA_det_abs, hd_le, hd_sum, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro q
    simp_rw [h_vec_A q]
    exact hP_norm (∑ i : Fin n, (q i : K) * v₁ i)
  · intro q
    simp_rw [h_vec_A q]
    exact hP_cplx (∑ i : Fin n, (q i : K) * v₁ i)
  · intro q
    simp_rw [h_vec_A q]
    exact hP_quad (∑ i : Fin n, (q i : K) * v₁ i)
  · intro l
    simp_rw [h_vec_N l]
    have hs2 := (h_s2 (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i)).1
    exact hs2.symm.trans (hD_norm ((∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / γ))
  · intro l
    simp_rw [h_vec_N l]
    have hs2 := (h_s2 (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i)).2.1
    exact (hD_cplx ((∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / γ)).trans hs2
  · intro l
    simp_rw [h_vec_N l]
    have hs2 := (h_s2 (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i)).2.2
    exact hs2.symm.trans (hD_quad ((∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / γ))

theorem mitsui_shifted_ideal_lattice_harmonic_poisson_summation {K : Type u} [Field K] [NumberField K]
    (M J_star : Ideal (NumberField.RingOfIntegers K)) (hM : M ≠ 0) (hJ_star : J_star ≠ 0)
    (γ : NumberField.RingOfIntegers K) (hγ : γ ≠ 0)
    (h_dual : differentIdeal ℤ (NumberField.RingOfIntegers K) * M * J_star =
      Ideal.span ({γ} : Set (NumberField.RingOfIntegers K)))
    (a_place : NumberField.InfinitePlace K → ℕ)
    (ha_real : ∀ w : NumberField.InfinitePlace K, w.IsReal → a_place w ≤ 1)
    (ha_cplx : ∀ w : NumberField.InfinitePlace K, w.IsComplex → a_place w = 0)
    (α : NumberField.RingOfIntegers K)
    (t : NumberField.InfinitePlace K → ℝ) (ht : ∀ w : NumberField.InfinitePlace K, 0 < t w) :
    let R := NumberField.RingOfIntegers K
    let D : ℝ := |(NumberField.discr K : ℝ)|
    Summable (fun m : M =>
      (∏ w : NumberField.InfinitePlace K,
        (w ((α + m.1 : R) : K) * (t w) ^ (1 / 2 : ℝ)) ^ (a_place w)) *
      Real.exp (-Real.pi *
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * t w * (w ((α + m.1 : R) : K)) ^ 2)) ∧
    Summable (fun x_star : J_star =>
      (∏ w : NumberField.InfinitePlace K,
        ((w ((x_star.1 : R) : K) / w (γ : K)) * (t w) ^ (-1 / 2 : ℝ)) ^ (a_place w)) *
      Real.exp (-Real.pi *
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (t w)⁻¹ * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2)) ∧
    (∑' m : M,
      (∏ w : NumberField.InfinitePlace K,
        (w.embedding ((α + m.1 : R) : K) * (((t w) ^ (1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) *
      (Real.exp (-Real.pi *
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * t w * (w ((α + m.1 : R) : K)) ^ 2) : ℂ)) =
      ((-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
        (∏ w : NumberField.InfinitePlace K,
          (w.embedding (γ : K) / (w (γ : K) : ℂ)) ^ (a_place w)) *
        (((D ^ (1 / 2 : ℝ) * (Ideal.absNorm M : ℝ) *
            ∏ w : NumberField.InfinitePlace K, (t w) ^ ((w.mult : ℝ) / 2))⁻¹ : ℝ) : ℂ)) *
        ∑' x_star : J_star,
          Complex.exp (2 * Real.pi * Complex.I *
            (Algebra.trace ℚ K ((α : K) * (x_star.1 : K) / (γ : K)) : ℂ)) *
            (∏ w : NumberField.InfinitePlace K,
              ((w.embedding ((x_star.1 : R) : K) / (w (γ : K) : ℂ)) *
                (((t w) ^ (-1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) *
            (Real.exp (-Real.pi *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (t w)⁻¹ * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2) : ℂ) :=
by
  intro R D
  set n : ℕ := Module.finrank ℚ K
  obtain ⟨v₁, v₂, e₁, e₂, u, h_lin₁, h_lin₂, h_tr, h_dual_v, h_det⟩ :=
    mitsui_shifted_ideal_lattice_trace_dual_zbasis_and_det M J_star hM hJ_star γ hγ h_dual α
  have hD_pos : 0 < D := by
    dsimp [D]
    exact abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  have hM_bot : M ≠ ⊥ := hM
  have hNM_pos : 0 < (Ideal.absNorm M : ℝ) := by
    exact_mod_cast Nat.pos_of_ne_zero (Ideal.absNorm_eq_zero_iff.not.mpr hM_bot)
  set Δ : ℝ := D ^ (1 / 2 : ℝ) * (Ideal.absNorm M : ℝ)
  have hΔ_pos : 0 < Δ := by dsimp [Δ]; positivity
  have hΔ_sq : Δ ^ 2 = D * (Ideal.absNorm M : ℝ) ^ 2 := by
    dsimp [Δ]
    rw [mul_pow, ← Real.rpow_natCast (D ^ (1 / 2 : ℝ)) 2, ← Real.rpow_mul (le_of_lt hD_pos)]
    norm_num
  have hγ_K : (γ : K) ≠ 0 := by exact_mod_cast hγ
  obtain ⟨A, d, hA_ne, hA_det, hd_le, hd_sum, hP_norm, hP_cplx, hP_quad, hD_norm, hD_cplx, hD_quad⟩ :=
    mitsui_infinitePlace_harmonic_euclidean_trace_duality
      (fun i => (v₁ i : K)) (fun i => (v₂ i : K)) (γ : K) hγ_K
      Δ hΔ_pos h_dual_v (h_det.trans hΔ_sq.symm) a_place ha_real ha_cplx t ht
  obtain ⟨h_sum_k, h_sum_l, h_poisson⟩ :=
    mitsui_matrix_shifted_harmonic_gaussian_poisson_summation n A hA_ne (fun i => (u i : ℝ)) d hd_le
  have hq_cast : ∀ k : Fin n → ℤ,
      (fun i : Fin n => ((u i + (k i : ℚ) : ℚ) : ℝ)) = (fun i : Fin n => (u i : ℝ) + (k i : ℝ)) := by
    intro k
    ext i
    push_cast
    rfl
  have hP_norm_k : ∀ k : Fin n → ℤ,
      (∏ w : NumberField.InfinitePlace K,
        (w ((α + (e₁ k).1 : R) : K) * (t w) ^ (1 / 2 : ℝ)) ^ (a_place w)) =
      ∏ j : Fin n, |A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) j| ^ (d j) := by
    intro k
    rw [h_lin₁ k, hP_norm (fun i => u i + (k i : ℚ)), hq_cast k]
  have hP_cplx_k : ∀ k : Fin n → ℤ,
      (∏ w : NumberField.InfinitePlace K,
        (w.embedding ((α + (e₁ k).1 : R) : K) * (((t w) ^ (1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) =
      (((∏ j : Fin n, (A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) j) ^ (d j) : ℝ) : ℂ)) := by
    intro k
    rw [h_lin₁ k, hP_cplx (fun i => u i + (k i : ℚ)), hq_cast k]
  have hP_quad_k : ∀ k : Fin n → ℤ,
      (∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * t w * (w ((α + (e₁ k).1 : R) : K)) ^ 2) =
      ∑ j : Fin n, (A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) j) ^ 2 := by
    intro k
    rw [h_lin₁ k, hP_quad (fun i => u i + (k i : ℚ)), hq_cast k]
  have hD_norm_l : ∀ l : Fin n → ℤ,
      (∏ w : NumberField.InfinitePlace K,
        ((w (((e₂ l).1 : R) : K) / w (γ : K)) * (t w) ^ (-1 / 2 : ℝ)) ^ (a_place w)) =
      ∏ j : Fin n, |A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j| ^ (d j) := by
    intro l
    rw [h_lin₂ l, hD_norm l]
  have hD_cplx_l : ∀ l : Fin n → ℤ,
      (((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d j) : ℝ) : ℂ)) =
      (∏ w : NumberField.InfinitePlace K,
        (w.embedding (γ : K) / (w (γ : K) : ℂ)) ^ (a_place w)) *
      (∏ w : NumberField.InfinitePlace K,
        ((w.embedding (((e₂ l).1 : R) : K) / (w (γ : K) : ℂ)) *
          (((t w) ^ (-1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) := by
    intro l
    rw [h_lin₂ l, hD_cplx l]
  have hD_quad_l : ∀ l : Fin n → ℤ,
      (∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * (t w)⁻¹ * (w (((e₂ l).1 : R) : K) / w (γ : K)) ^ 2) =
      ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2 := by
    intro l
    rw [h_lin₂ l, hD_quad l]
  have h_tr_l : ∀ l : Fin n → ℤ,
      (Algebra.trace ℚ K ((α : K) * (((e₂ l).1 : R) : K) / (γ : K)) : ℂ) =
      (∑ i : Fin n, (u i : ℝ) * (l i : ℝ) : ℂ) := by
    intro l
    rw [h_tr l]
    push_cast
    rfl
  have h_summable_M : Summable (fun m : M =>
      (∏ w : NumberField.InfinitePlace K,
        (w ((α + m.1 : R) : K) * (t w) ^ (1 / 2 : ℝ)) ^ (a_place w)) *
      Real.exp (-Real.pi *
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * t w * (w ((α + m.1 : R) : K)) ^ 2)) := by
    rw [← e₁.summable_iff]
    have h_eq :
        ((fun m : M =>
          (∏ w : NumberField.InfinitePlace K,
            (w ((α + m.1 : R) : K) * (t w) ^ (1 / 2 : ℝ)) ^ (a_place w)) *
          Real.exp (-Real.pi *
            ∑ w : NumberField.InfinitePlace K,
              (w.mult : ℝ) * t w * (w ((α + m.1 : R) : K)) ^ 2)) ∘ ⇑e₁) =
        (fun k : Fin n → ℤ =>
          (∏ j : Fin n, |A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) j| ^ (d j)) *
          Real.exp (-Real.pi *
            ∑ j : Fin n, (A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) j) ^ 2)) := by
      ext k
      dsimp [Function.comp]
      rw [hP_norm_k k, hP_quad_k k]
    rw [h_eq]
    exact h_sum_k
  have h_summable_J : Summable (fun x_star : J_star =>
      (∏ w : NumberField.InfinitePlace K,
        ((w ((x_star.1 : R) : K) / w (γ : K)) * (t w) ^ (-1 / 2 : ℝ)) ^ (a_place w)) *
      Real.exp (-Real.pi *
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (t w)⁻¹ * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2)) := by
    rw [← e₂.summable_iff]
    have h_eq :
        ((fun x_star : J_star =>
          (∏ w : NumberField.InfinitePlace K,
            ((w ((x_star.1 : R) : K) / w (γ : K)) * (t w) ^ (-1 / 2 : ℝ)) ^ (a_place w)) *
          Real.exp (-Real.pi *
            ∑ w : NumberField.InfinitePlace K,
              (w.mult : ℝ) * (t w)⁻¹ * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2)) ∘ ⇑e₂) =
        (fun l : Fin n → ℤ =>
          (∏ j : Fin n, |A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j| ^ (d j)) *
          Real.exp (-Real.pi *
            ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2)) := by
      ext l
      dsimp [Function.comp]
      rw [hD_norm_l l, hD_quad_l l]
    rw [h_eq]
    exact h_sum_l
  refine ⟨h_summable_M, h_summable_J, ?_⟩
  have h_lhs :
      (∑' m : M,
        (∏ w : NumberField.InfinitePlace K,
          (w.embedding ((α + m.1 : R) : K) * (((t w) ^ (1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) *
        (Real.exp (-Real.pi *
          ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * t w * (w ((α + m.1 : R) : K)) ^ 2) : ℂ)) =
      (∑' k : Fin n → ℤ,
        (((∏ j : Fin n, (A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) j) ^ (d j) : ℝ) : ℂ) *
        (Real.exp (-Real.pi *
          ∑ j : Fin n, (A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) j) ^ 2) : ℂ))) := by
    rw [← Equiv.tsum_eq e₁]
    refine tsum_congr (fun k => ?_)
    rw [hP_cplx_k k, hP_quad_k k]
  set sgn_γ : ℂ := ∏ w : NumberField.InfinitePlace K,
    (w.embedding (γ : K) / (w (γ : K) : ℂ)) ^ (a_place w)
  have h_rhs_tsum :
      (∑' l : Fin n → ℤ,
        Complex.exp (2 * Real.pi * Complex.I *
          (∑ i : Fin n, (u i : ℝ) * (l i : ℝ) : ℂ)) *
          (((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d j) : ℝ) : ℂ) *
          (Real.exp (-Real.pi *
            ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ))) =
      sgn_γ *
        ∑' x_star : J_star,
          Complex.exp (2 * Real.pi * Complex.I *
            (Algebra.trace ℚ K ((α : K) * (x_star.1 : K) / (γ : K)) : ℂ)) *
            (∏ w : NumberField.InfinitePlace K,
              ((w.embedding ((x_star.1 : R) : K) / (w (γ : K) : ℂ)) *
                (((t w) ^ (-1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) *
            (Real.exp (-Real.pi *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (t w)⁻¹ * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2) : ℂ) := by
    rw [← Equiv.tsum_eq e₂, ← tsum_mul_left]
    refine tsum_congr (fun l => ?_)
    rw [hD_cplx_l l, ← h_tr_l l, ← hD_quad_l l]
    dsimp [sgn_γ]
    ring
  rw [h_lhs, h_poisson, h_rhs_tsum, hd_sum, hA_det]
  dsimp [Δ, sgn_γ]
  ring

theorem mitsui_narrow_generator_unitLog_shift_cube_integral_eq {K : Type u} [Field K] [NumberField K]
    (f J_star : Ideal (NumberField.RingOfIntegers K))
    (γ : NumberField.RingOfIntegers K) (hγ : γ ≠ 0)
    (a_place : NumberField.InfinitePlace K → ℕ)
    (ha_real : ∀ w : NumberField.InfinitePlace K, w.IsReal → a_place w ≤ 1)
    (ha_cplx : ∀ w : NumberField.InfinitePlace K, w.IsComplex → a_place w = 0)
    (ψ_f : (NumberField.RingOfIntegers K ⧸ f) → ℂ)
    (hψ_mul : ∀ a b : NumberField.RingOfIntegers K ⧸ f, ψ_f (a * b) = ψ_f a * ψ_f b)
    (hψ_units : ∀ u : (NumberField.RingOfIntegers K)ˣ,
      ψ_f (Ideal.Quotient.mk f (u : NumberField.RingOfIntegers K)) *
        ∏ w : NumberField.InfinitePlace K,
          (w.embedding ((u : NumberField.RingOfIntegers K) : K) /
            (w ((u : NumberField.RingOfIntegers K) : K) : ℂ)) ^ (a_place w) = 1)
    (c : ℝ) (hc : 0 < c) :
    let R := NumberField.RingOfIntegers K
    let n : ℕ := Module.finrank ℚ K
    let r : ℕ := NumberField.Units.rank K
    let Cube : Set (Fin r → ℝ) := Set.pi Set.univ (fun _ => Set.Ico (0 : ℝ) 1)
    let N_γ : ℝ := (Ideal.absNorm (Ideal.span ({γ} : Set R)) : ℝ)
    (∫ y in Cube,
      (∑' x_star : J_star,
        star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
          (∏ w : NumberField.InfinitePlace K,
            ((w.embedding ((x_star.1 : R) : K) / (w (γ : K) : ℂ)) *
              ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) *
          ((((c ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
            Real.exp (-Real.pi * c ^ 2 *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2 *
                  ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ))))) =
    (∫ y in Cube,
      (∑' x_star : J_star,
        star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
          (∏ w : NumberField.InfinitePlace K,
            (w.embedding ((x_star.1 : R) : K) *
              ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) *
          (((((c * N_γ ^ (-1 / (n : ℝ))) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
            Real.exp (-Real.pi * (c * N_γ ^ (-1 / (n : ℝ))) ^ 2 *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
                  ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ))))) :=
by
  classical
  intro R n r Cube N_γ
  let ε : Fin r → Rˣ := NumberField.Units.fundSystem K
  have hw_ε_pos : ∀ (w : NumberField.InfinitePlace K) (i : Fin r),
      0 < w ((ε i : R) : K) := by
    intro w i
    exact w.pos_iff.mpr (NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero (ε i)))
  have hγ_coe : (γ : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hγ
  have hw_γ_pos : ∀ w : NumberField.InfinitePlace K, 0 < w (γ : K) :=
    fun w => w.pos_iff.mpr hγ_coe
  have hNγ_pos : 0 < N_γ := by
    dsimp [N_γ]
    have h_span_ne : Ideal.span ({γ} : Set R) ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr hγ
    exact_mod_cast Nat.pos_of_ne_zero (Ideal.absNorm_eq_zero_iff.not.mpr h_span_ne)
  have hn_pos : (0 : ℝ) < (n : ℝ) := by
    dsimp [n]
    exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
  have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  
  let B_R : Module.Basis (Fin r) ℝ (NumberField.Units.dirichletUnitTheorem.logSpace K) :=
    Module.Basis.ofZLatticeBasis ℝ
      (NumberField.Units.unitLattice K)
      (NumberField.Units.basisUnitLattice K)
  let S_γ : ℝ := ∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * Real.log (v (γ : K))
  let ℓ_γ : NumberField.InfinitePlace K → ℝ :=
    fun w => Real.log (w (γ : K)) - S_γ / (n : ℝ)
  let L_vec : NumberField.Units.dirichletUnitTheorem.logSpace K :=
    fun w => (w.1.mult : ℝ) * ℓ_γ w.1
  let v_γ : Fin r → ℝ := fun j => B_R.repr L_vec j
  let r_γ : NumberField.InfinitePlace K → ℝ :=
    fun v => ∑ j : Fin r, v_γ j * Real.log (v ((ε j : R) : K))
  let w_dir : NumberField.InfinitePlace K := NumberField.Units.dirichletUnitTheorem.w₀
  have h_ne_dir : ∀ v : NumberField.InfinitePlace K, v ≠ w_dir →
      (v.mult : ℝ) * ℓ_γ v = (v.mult : ℝ) * r_γ v := by
    intro v hv
    let v_sub : {v : NumberField.InfinitePlace K // v ≠ w_dir} := ⟨v, hv⟩
    have h_basis := congr_fun (Module.Basis.sum_repr B_R L_vec).symm v_sub
    change (v.mult : ℝ) * ℓ_γ v = (∑ j : Fin r, (v_γ j) • B_R j) v_sub at h_basis
    rw [h_basis]
    have h_eval : (∑ j : Fin r, (v_γ j) • B_R j) v_sub =
        ∑ j : Fin r, v_γ j * (B_R j v_sub) := by
      simp [Finset.sum_apply]
    rw [h_eval]
    dsimp [r_γ]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    have hB_j : B_R j v_sub = (v.mult : ℝ) * Real.log (v ((ε j : R) : K)) := by
      dsimp [B_R, ε]
      rw [Module.Basis.ofZLatticeBasis_apply, ← NumberField.Units.logEmbedding_fundSystem,
        NumberField.Units.dirichletUnitTheorem.logEmbedding_component]
    rw [hB_j]
    ring
  have h_sum_mult : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ)) = (n : ℝ) := by
    dsimp [n]
    exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
  have h_sum_ℓ : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * ℓ_γ v) = 0 := by
    dsimp [ℓ_γ]
    simp_rw [mul_sub]
    rw [Finset.sum_sub_distrib, ← Finset.sum_mul, h_sum_mult, mul_div_cancel₀ _ hn_ne, sub_self]
  have h_sum_r : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * r_γ v) = 0 := by
    dsimp [r_γ]
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_eq_zero (fun j _ => ?_)
    have h_comm : (∑ v : NumberField.InfinitePlace K,
        (v.mult : ℝ) * (v_γ j * Real.log (v ((ε j : R) : K)))) =
        v_γ j * (∑ v : NumberField.InfinitePlace K,
          (v.mult : ℝ) * Real.log (v ((ε j : R) : K))) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun v _ => by ring)
    rw [h_comm]
    have h_unit_sum : (∑ v : NumberField.InfinitePlace K,
        (v.mult : ℝ) * Real.log (v ((ε j : R) : K))) = 0 := by
      simpa [ε] using NumberField.Units.sum_mult_mul_log (NumberField.Units.fundSystem K j)
    rw [h_unit_sum, mul_zero]
  have h_all_mult : ∀ v : NumberField.InfinitePlace K,
      (v.mult : ℝ) * ℓ_γ v = (v.mult : ℝ) * r_γ v := by
    intro v
    by_cases hv : v = w_dir
    · subst hv
      have h1 := (Finset.add_sum_erase Finset.univ
        (fun v : NumberField.InfinitePlace K => (v.mult : ℝ) * ℓ_γ v)
        (Finset.mem_univ w_dir)).symm
      have h2 := (Finset.add_sum_erase Finset.univ
        (fun v : NumberField.InfinitePlace K => (v.mult : ℝ) * r_γ v)
        (Finset.mem_univ w_dir)).symm
      have h_erase : (∑ v ∈ Finset.univ.erase w_dir, (v.mult : ℝ) * ℓ_γ v) =
          (∑ v ∈ Finset.univ.erase w_dir, (v.mult : ℝ) * r_γ v) :=
        Finset.sum_congr rfl (fun v hv_mem => h_ne_dir v (Finset.ne_of_mem_erase hv_mem))
      linarith
    · exact h_ne_dir v hv
  have h_all : ∀ v : NumberField.InfinitePlace K, ℓ_γ v = r_γ v := by
    intro v
    have h_mult_pos : (0 : ℝ) < (v.mult : ℝ) := by
      exact_mod_cast NumberField.InfinitePlace.mult_pos (w := v)
    exact mul_left_cancel₀ (ne_of_gt h_mult_pos) (h_all_mult v)
  have h_Sγ_eq : S_γ = Real.log N_γ := by
    dsimp [S_γ, N_γ]
    have h_prod : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * Real.log (v (γ : K))) =
        Real.log (∏ v : NumberField.InfinitePlace K, (v (γ : K)) ^ v.mult) := by
      rw [Real.log_prod (fun v _ => pow_ne_zero v.mult (ne_of_gt (hw_γ_pos v)))]
      refine Finset.sum_congr rfl (fun v _ => ?_)
      rw [Real.log_pow]
    rw [h_prod, NumberField.InfinitePlace.prod_eq_abs_norm]
    congr 1
    rw [Ideal.absNorm_span_singleton]
    have h_coe_norm : ((Algebra.norm ℤ γ : ℤ) : ℚ) = Algebra.norm ℚ (γ : K) :=
      Algebra.coe_norm_int γ
    rw [← h_coe_norm]
    exact_mod_cast (Nat.cast_natAbs (Algebra.norm ℤ γ)).symm
  have h_log_γ : ∀ w : NumberField.InfinitePlace K,
      Real.log (w (γ : K)) = Real.log N_γ / (n : ℝ) + r_γ w := by
    intro w
    have h1 := h_all w
    dsimp [ℓ_γ] at h1
    rw [h_Sγ_eq] at h1
    linarith
  have h_wγ_lin : ∀ w : NumberField.InfinitePlace K,
      w (γ : K) = N_γ ^ (1 / (n : ℝ)) * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (v_γ i) := by
    intro w
    have h1_log : Real.log (w (γ : K)) =
        Real.log N_γ * (1 / (n : ℝ)) +
          ∑ i : Fin r, Real.log (w ((ε i : R) : K)) * v_γ i := by
      rw [h_log_γ w]
      dsimp [r_γ]
      congr 1
      · ring
      · refine Finset.sum_congr rfl (fun i _ => by ring)
    have h_exp := congrArg Real.exp h1_log
    rw [Real.exp_log (hw_γ_pos w), Real.exp_add, ← Real.rpow_def_of_pos hNγ_pos, Real.exp_sum] at h_exp
    rw [h_exp]
    congr 1
    refine Finset.prod_congr rfl (fun i _ => ?_)
    rw [← Real.rpow_def_of_pos (hw_ε_pos w i)]
  have h_wγ_sq : ∀ w : NumberField.InfinitePlace K,
      (w (γ : K)) ^ 2 = N_γ ^ (2 / (n : ℝ)) * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * v_γ i) := by
    intro w
    have h2_log : 2 * Real.log (w (γ : K)) =
        Real.log N_γ * (2 / (n : ℝ)) +
          ∑ i : Fin r, Real.log (w ((ε i : R) : K)) * (2 * v_γ i) := by
      rw [h_log_γ w]
      dsimp [r_γ]
      rw [mul_add, Finset.mul_sum]
      congr 1
      · ring
      · refine Finset.sum_congr rfl (fun i _ => by ring)
    have h_exp := congrArg Real.exp h2_log
    have h_lhs : Real.exp (2 * Real.log (w (γ : K))) = (w (γ : K)) ^ 2 := by
      rw [mul_comm, ← Real.rpow_def_of_pos (hw_γ_pos w) 2, Real.rpow_two]
    have h_rhs : Real.exp (Real.log N_γ * (2 / (n : ℝ)) +
        ∑ i : Fin r, Real.log (w ((ε i : R) : K)) * (2 * v_γ i)) =
        N_γ ^ (2 / (n : ℝ)) * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * v_γ i) := by
      rw [Real.exp_add, ← Real.rpow_def_of_pos hNγ_pos, Real.exp_sum]
      congr 1
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [← Real.rpow_def_of_pos (hw_ε_pos w i)]
    linarith
  
  let A_exp : ℕ := ∑ w : NumberField.InfinitePlace K, a_place w
  let c_scaled : ℝ := c * N_γ ^ (-1 / (n : ℝ))
  let Θ : (Fin r → ℝ) → ℂ := fun y =>
    ∑' x_star : J_star,
      star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
        (∏ w : NumberField.InfinitePlace K,
          (w.embedding ((x_star.1 : R) : K) *
            ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) *
        (((c_scaled ^ A_exp *
          Real.exp (-Real.pi * c_scaled ^ 2 *
            ∑ w : NumberField.InfinitePlace K,
              (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
                ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ))
  have h_inv_lin : ∀ (w : NumberField.InfinitePlace K) (y : Fin r → ℝ),
      (w (γ : K))⁻¹ * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) =
        N_γ ^ (-1 / (n : ℝ)) * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(y + v_γ) i) := by
    intro w y
    rw [h_wγ_lin w, mul_inv, mul_assoc]
    congr 1
    · rw [← Real.rpow_neg (le_of_lt hNγ_pos), neg_div]
    · rw [← Finset.prod_inv_distrib, ← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [← Real.rpow_neg (le_of_lt (hw_ε_pos w i)), ← Real.rpow_add (hw_ε_pos w i)]
      congr 1
      change -v_γ i + -y i = -(y i + v_γ i)
      ring
  have h_inv_sq : ∀ (w : NumberField.InfinitePlace K) (y : Fin r → ℝ),
      ((w (γ : K)) ^ 2)⁻¹ * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i) =
        N_γ ^ (-2 / (n : ℝ)) * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (y + v_γ) i) := by
    intro w y
    rw [h_wγ_sq w, mul_inv, mul_assoc]
    congr 1
    · rw [← Real.rpow_neg (le_of_lt hNγ_pos), neg_div]
    · rw [← Finset.prod_inv_distrib, ← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [← Real.rpow_neg (le_of_lt (hw_ε_pos w i)), ← Real.rpow_add (hw_ε_pos w i)]
      congr 1
      change -(2 * v_γ i) + -2 * y i = -2 * (y i + v_γ i)
      ring
  have h_poly_w : ∀ (w : NumberField.InfinitePlace K) (y : Fin r → ℝ) (x_star : J_star),
      ((w.embedding ((x_star.1 : R) : K) / (w (γ : K) : ℂ)) *
        ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w) =
      (w.embedding ((x_star.1 : R) : K) *
        ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(y + v_γ) i) : ℝ) : ℂ)) ^ (a_place w) *
        (((N_γ ^ (-1 / (n : ℝ))) ^ (a_place w) : ℝ) : ℂ) := by
    intro w y x_star
    have h_inner :
        (w.embedding ((x_star.1 : R) : K) / (w (γ : K) : ℂ)) *
          ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ) =
        (w.embedding ((x_star.1 : R) : K) *
          ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(y + v_γ) i) : ℝ) : ℂ)) *
          ((N_γ ^ (-1 / (n : ℝ)) : ℝ) : ℂ) := by
      have h_coe :
          (w (γ : K) : ℂ)⁻¹ * ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ) =
          ((N_γ ^ (-1 / (n : ℝ)) : ℝ) : ℂ) *
            ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(y + v_γ) i) : ℝ) : ℂ) := by
        rw [← Complex.ofReal_inv, ← Complex.ofReal_mul, ← Complex.ofReal_mul, h_inv_lin w y]
      calc (w.embedding ((x_star.1 : R) : K) / (w (γ : K) : ℂ)) *
            ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ)
        _ = w.embedding ((x_star.1 : R) : K) *
            ((w (γ : K) : ℂ)⁻¹ * ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ)) := by
            rw [div_eq_mul_inv, mul_assoc]
        _ = w.embedding ((x_star.1 : R) : K) *
            (((N_γ ^ (-1 / (n : ℝ)) : ℝ) : ℂ) *
              ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(y + v_γ) i) : ℝ) : ℂ)) := by
            rw [h_coe]
        _ = (w.embedding ((x_star.1 : R) : K) *
            ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(y + v_γ) i) : ℝ) : ℂ)) *
            ((N_γ ^ (-1 / (n : ℝ)) : ℝ) : ℂ) := by ring
    rw [h_inner, mul_pow, Complex.ofReal_pow]
  have h_poly_prod : ∀ (y : Fin r → ℝ) (x_star : J_star),
      (∏ w : NumberField.InfinitePlace K,
        ((w.embedding ((x_star.1 : R) : K) / (w (γ : K) : ℂ)) *
          ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) =
      (∏ w : NumberField.InfinitePlace K,
        (w.embedding ((x_star.1 : R) : K) *
          ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(y + v_γ) i) : ℝ) : ℂ)) ^ (a_place w)) *
        (((N_γ ^ (-1 / (n : ℝ))) ^ A_exp : ℝ) : ℂ) := by
    intro y x_star
    simp_rw [h_poly_w _ y x_star]
    rw [Finset.prod_mul_distrib]
    congr 1
    rw [← Complex.ofReal_prod, Finset.prod_pow_eq_pow_sum]
  have h_gauss_exp : ∀ (y : Fin r → ℝ) (x_star : J_star),
      -Real.pi * c ^ 2 *
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2 *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)) =
      -Real.pi * c_scaled ^ 2 *
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (y + v_γ) i)) := by
    intro y x_star
    have hc_scaled_sq : c_scaled ^ 2 = c ^ 2 * N_γ ^ (-2 / (n : ℝ)) := by
      dsimp [c_scaled]
      rw [mul_pow, ← Real.rpow_natCast (N_γ ^ (-1 / (n : ℝ))) 2,
        ← Real.rpow_mul (le_of_lt hNγ_pos)]
      congr 2
      ring
    rw [hc_scaled_sq]
    have h_sum_eq :
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2 *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)) =
        N_γ ^ (-2 / (n : ℝ)) *
          (∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
              ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (y + v_γ) i)) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun w _ => ?_)
      calc (w.mult : ℝ) * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2 *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)
        _ = (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
            (((w (γ : K)) ^ 2)⁻¹ * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)) := by
            rw [div_pow, div_eq_mul_inv]
            ring
        _ = (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
            (N_γ ^ (-2 / (n : ℝ)) * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (y + v_γ) i)) := by
            rw [h_inv_sq w y]
        _ = N_γ ^ (-2 / (n : ℝ)) *
            ((w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
              ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (y + v_γ) i)) := by ring
    rw [h_sum_eq]
    ring
  have h_lhs_eq :
      (∫ y in Cube,
        (∑' x_star : J_star,
          star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
            (∏ w : NumberField.InfinitePlace K,
              ((w.embedding ((x_star.1 : R) : K) / (w (γ : K) : ℂ)) *
                ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) *
            ((((c ^ A_exp *
              Real.exp (-Real.pi * c ^ 2 *
                ∑ w : NumberField.InfinitePlace K,
                  (w.mult : ℝ) * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2 *
                    ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ))))) =
      ∫ y in Cube, Θ (y + v_γ) := by
    congr 1
    ext y
    dsimp only [Θ]
    refine tsum_congr (fun x_star => ?_)
    rw [h_poly_prod y x_star, h_gauss_exp y x_star]
    have h_exp_c :
        (((N_γ ^ (-1 / (n : ℝ))) ^ A_exp : ℝ) : ℂ) *
          (((c ^ A_exp *
            Real.exp (-Real.pi * c_scaled ^ 2 *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
                  ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (y + v_γ) i)) : ℝ) : ℂ)) =
        (((c_scaled ^ A_exp *
          Real.exp (-Real.pi * c_scaled ^ 2 *
            ∑ w : NumberField.InfinitePlace K,
              (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
                ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (y + v_γ) i)) : ℝ) : ℂ)) := by
      rw [← Complex.ofReal_mul]
      congr 1
      dsimp [c_scaled]
      rw [mul_pow]
      ring
    rw [mul_assoc, mul_assoc, h_exp_c, ← mul_assoc]
  
  have h_unit_star_cancel : ∀ u : Rˣ,
      star (ψ_f (Ideal.Quotient.mk f (u : R))) *
        (∏ w : NumberField.InfinitePlace K,
          (w.embedding ((u : R) : K) / (w ((u : R) : K) : ℂ)) ^ (a_place w)) = 1 := by
    intro u
    have h_prod_star :
        star (∏ w : NumberField.InfinitePlace K,
          (w.embedding ((u : R) : K) / (w ((u : R) : K) : ℂ)) ^ (a_place w)) =
        ∏ w : NumberField.InfinitePlace K,
          (w.embedding ((u : R) : K) / (w ((u : R) : K) : ℂ)) ^ (a_place w) := by
      rw [star_prod]
      refine Finset.prod_congr rfl (fun w _ => ?_)
      rw [star_pow]
      by_cases hw : w.IsReal
      · have h_emb : w.embedding ((u : R) : K) =
            ((NumberField.InfinitePlace.embedding_of_isReal hw ((u : R) : K) : ℝ) : ℂ) :=
          (NumberField.InfinitePlace.embedding_of_isReal_apply hw ((u : R) : K)).symm
        rw [h_emb, star_div₀, Complex.star_def, Complex.conj_ofReal, Complex.conj_ofReal]
      · have hw_cplx : w.IsComplex := NumberField.InfinitePlace.not_isReal_iff_isComplex.mp hw
        rw [ha_cplx w hw_cplx, pow_zero, pow_zero]
    rw [← h_prod_star, ← star_mul, mul_comm, hψ_units u, star_one]
  let b₀ : Module.Basis (Fin r) ℝ (Fin r → ℝ) := Pi.basisFun ℝ (Fin r)
  let L_ℤ : Submodule ℤ (Fin r → ℝ) := Submodule.span ℤ (Set.range ⇑b₀)
  have h_per : ∀ (g : L_ℤ) (y : Fin r → ℝ), Θ (g +ᵥ y) = Θ y := by
    intro g y
    obtain ⟨e, he⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ).mp g.2
    have hg_coord : ∀ i : Fin r, (g +ᵥ y) i = (e i : ℝ) + y i := by
      intro i
      change g.1 i + y i = (e i : ℝ) + y i
      have hg_i : g.1 i = (e i : ℝ) := by
        rw [← he]
        simp [b₀, Finset.sum_apply, Pi.basisFun_apply, Pi.single_apply]
      rw [hg_i]
    let u_e : Rˣ := ∏ i : Fin r, (ε i) ^ (-(e i))
    let φ_e : J_star ≃ J_star :=
      { toFun := fun x => ⟨(u_e : R) * x.1, J_star.mul_mem_left (u_e : R) x.2⟩
        invFun := fun x => ⟨((u_e⁻¹ : Rˣ) : R) * x.1, J_star.mul_mem_left ((u_e⁻¹ : Rˣ) : R) x.2⟩
        left_inv := fun x => Subtype.ext (by
          change ((u_e⁻¹ : Rˣ) : R) * ((u_e : R) * x.1) = x.1
          rw [← mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul])
        right_inv := fun x => Subtype.ext (by
          change (u_e : R) * (((u_e⁻¹ : Rˣ) : R) * x.1) = x.1
          rw [← mul_assoc, ← Units.val_mul, mul_inv_cancel, Units.val_one, one_mul]) }
    have hw_ue : ∀ w : NumberField.InfinitePlace K,
        w ((u_e : R) : K) = ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(e i : ℝ)) := by
      intro w
      let ψ_w : Rˣ →* ℝ :=
        { toFun := fun u => w ((u : R) : K)
          map_one' := by push_cast; exact map_one w
          map_mul' := fun u v => by push_cast; exact map_mul w _ _ }
      change ψ_w u_e = _
      dsimp [u_e]
      rw [map_prod]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [map_zpow ψ_w (ε i) (-(e i))]
      change (w ((ε i : R) : K)) ^ (-(e i)) = _
      rw [← Real.rpow_intCast, Int.cast_neg]
    have h_ue_lin : ∀ w : NumberField.InfinitePlace K,
        w ((u_e : R) : K) * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) =
          ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(g +ᵥ y) i) := by
      intro w
      rw [hw_ue w, ← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [← Real.rpow_add (hw_ε_pos w i), hg_coord i]
      congr 1
      ring
    have h_ue_sq : ∀ w : NumberField.InfinitePlace K,
        (w ((u_e : R) : K)) ^ 2 * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i) =
          ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (g +ᵥ y) i) := by
      intro w
      rw [hw_ue w, ← Finset.prod_pow, ← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [← Real.rpow_natCast, ← Real.rpow_mul (le_of_lt (hw_ε_pos w i)),
        ← Real.rpow_add (hw_ε_pos w i), hg_coord i]
      congr 1
      push_cast
      ring
    have h_ue_poly_w : ∀ (w : NumberField.InfinitePlace K) (x_star : J_star),
        (w.embedding (((φ_e x_star).1 : R) : K) *
          ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w) =
        (w.embedding ((u_e : R) : K) / (w ((u_e : R) : K) : ℂ)) ^ (a_place w) *
          (w.embedding ((x_star.1 : R) : K) *
            ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(g +ᵥ y) i) : ℝ) : ℂ)) ^ (a_place w) := by
      intro w x_star
      have hw_ue_ne : (w ((u_e : R) : K) : ℂ) ≠ 0 := by
        exact_mod_cast ne_of_gt
          (w.pos_iff.mpr (NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero u_e)))
      have h_coe_lin :
          (w ((u_e : R) : K) : ℂ) * ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ) =
          ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(g +ᵥ y) i) : ℝ) : ℂ) := by
        rw [← Complex.ofReal_mul, h_ue_lin w]
      have h_emb_mul : w.embedding (((φ_e x_star).1 : R) : K) =
          w.embedding ((u_e : R) : K) * w.embedding ((x_star.1 : R) : K) := by
        change w.embedding ((((u_e : R) * x_star.1 : R) : K)) = _
        push_cast
        exact map_mul w.embedding _ _
      rw [h_emb_mul, ← mul_pow]
      congr 1
      rw [← h_coe_lin]
      calc w.embedding ((u_e : R) : K) * w.embedding ((x_star.1 : R) : K) *
            ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ)
        _ = (w.embedding ((u_e : R) : K) / (w ((u_e : R) : K) : ℂ) * (w ((u_e : R) : K) : ℂ)) *
            w.embedding ((x_star.1 : R) : K) *
            ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ) := by
            rw [div_mul_cancel₀ _ hw_ue_ne]
        _ = (w.embedding ((u_e : R) : K) / (w ((u_e : R) : K) : ℂ)) *
            (w.embedding ((x_star.1 : R) : K) *
              ((w ((u_e : R) : K) : ℂ) * ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ))) := by
            ring
    have h_ue_poly_prod : ∀ x_star : J_star,
        (∏ w : NumberField.InfinitePlace K,
          (w.embedding (((φ_e x_star).1 : R) : K) *
            ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) =
        (∏ w : NumberField.InfinitePlace K,
          (w.embedding ((u_e : R) : K) / (w ((u_e : R) : K) : ℂ)) ^ (a_place w)) *
          (∏ w : NumberField.InfinitePlace K,
            (w.embedding ((x_star.1 : R) : K) *
              ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(g +ᵥ y) i) : ℝ) : ℂ)) ^ (a_place w)) := by
      intro x_star
      simp_rw [h_ue_poly_w _ x_star]
      exact Finset.prod_mul_distrib
    have h_ue_char : ∀ x_star : J_star,
        star (ψ_f (Ideal.Quotient.mk f (φ_e x_star).1)) =
        star (ψ_f (Ideal.Quotient.mk f (u_e : R))) * star (ψ_f (Ideal.Quotient.mk f x_star.1)) := by
      intro x_star
      change star (ψ_f (Ideal.Quotient.mk f ((u_e : R) * x_star.1))) = _
      rw [map_mul, hψ_mul, star_mul, mul_comm]
    have h_ue_char_poly : ∀ x_star : J_star,
        star (ψ_f (Ideal.Quotient.mk f (φ_e x_star).1)) *
          (∏ w : NumberField.InfinitePlace K,
            (w.embedding (((φ_e x_star).1 : R) : K) *
              ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) =
        star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
          (∏ w : NumberField.InfinitePlace K,
            (w.embedding ((x_star.1 : R) : K) *
              ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(g +ᵥ y) i) : ℝ) : ℂ)) ^ (a_place w)) := by
      intro x_star
      rw [h_ue_char x_star, h_ue_poly_prod x_star]
      calc (star (ψ_f (Ideal.Quotient.mk f (u_e : R))) * star (ψ_f (Ideal.Quotient.mk f x_star.1))) *
            ((∏ w : NumberField.InfinitePlace K,
              (w.embedding ((u_e : R) : K) / (w ((u_e : R) : K) : ℂ)) ^ (a_place w)) *
              (∏ w : NumberField.InfinitePlace K,
                (w.embedding ((x_star.1 : R) : K) *
                  ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(g +ᵥ y) i) : ℝ) : ℂ)) ^ (a_place w)))
        _ = (star (ψ_f (Ideal.Quotient.mk f (u_e : R))) *
              (∏ w : NumberField.InfinitePlace K,
                (w.embedding ((u_e : R) : K) / (w ((u_e : R) : K) : ℂ)) ^ (a_place w))) *
            (star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
              (∏ w : NumberField.InfinitePlace K,
                (w.embedding ((x_star.1 : R) : K) *
                  ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(g +ᵥ y) i) : ℝ) : ℂ)) ^ (a_place w))) := by
            ring
        _ = 1 * (star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
              (∏ w : NumberField.InfinitePlace K,
                (w.embedding ((x_star.1 : R) : K) *
                  ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(g +ᵥ y) i) : ℝ) : ℂ)) ^ (a_place w))) := by
            rw [h_unit_star_cancel u_e]
        _ = _ := one_mul _
    have h_ue_gauss : ∀ x_star : J_star,
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (w (((φ_e x_star).1 : R) : K)) ^ 2 *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)) =
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (g +ᵥ y) i)) := by
      intro x_star
      refine Finset.sum_congr rfl (fun w _ => ?_)
      have hw_mul : w (((φ_e x_star).1 : R) : K) = w ((u_e : R) : K) * w ((x_star.1 : R) : K) := by
        change w ((((u_e : R) * x_star.1 : R) : K)) = _
        push_cast
        exact map_mul w _ _
      rw [hw_mul, mul_pow]
      calc (w.mult : ℝ) * ((w ((u_e : R) : K)) ^ 2 * (w ((x_star.1 : R) : K)) ^ 2) *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)
        _ = (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
            ((w ((u_e : R) : K)) ^ 2 * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)) := by ring
        _ = (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (g +ᵥ y) i) := by rw [h_ue_sq w]
    symm
    dsimp only [Θ]
    rw [← Equiv.tsum_eq φ_e]
    refine tsum_congr (fun x_star => ?_)
    rw [h_ue_char_poly x_star, h_ue_gauss x_star]
  
  haveI : MeasureTheory.VAddInvariantMeasure L_ℤ (Fin r → ℝ) MeasureTheory.volume :=
    ⟨fun z t _ => MeasureTheory.measure_preimage_add MeasureTheory.volume z.1 t⟩
  have h_fund_Cube : MeasureTheory.IsAddFundamentalDomain L_ℤ Cube MeasureTheory.volume := by
    dsimp [Cube]
    rw [← ZSpan.fundamentalDomain_pi_basisFun]
    exact ZSpan.isAddFundamentalDomain b₀ MeasureTheory.volume
  let t_Cube : Set (Fin r → ℝ) := (fun y => y + v_γ) '' Cube
  have hCube_meas : MeasurableSet Cube :=
    MeasurableSet.univ_pi (fun _ => measurableSet_Ico)
  have ht_Cube_meas : MeasurableSet t_Cube :=
    (measurableEmbedding_addRight v_γ).measurableSet_image.mpr hCube_meas
  have h_fund_trans : MeasureTheory.IsAddFundamentalDomain L_ℤ t_Cube MeasureTheory.volume := by
    refine MeasureTheory.IsAddFundamentalDomain.mk' ht_Cube_meas.nullMeasurableSet (fun x => ?_)
    have h_iff : ∀ g : L_ℤ, g +ᵥ x ∈ t_Cube ↔ g +ᵥ (x - v_γ) ∈ ZSpan.fundamentalDomain b₀ := by
      intro g
      rw [ZSpan.fundamentalDomain_pi_basisFun]
      change (∃ y ∈ Cube, y + v_γ = g.1 + x) ↔ g.1 + (x - v_γ) ∈ Cube
      constructor
      · rintro ⟨y, hy, hy_eq⟩
        have h_eq : g.1 + (x - v_γ) = y := by
          calc g.1 + (x - v_γ) = (g.1 + x) - v_γ := by abel
            _ = (y + v_γ) - v_γ := by rw [← hy_eq]
            _ = y := add_sub_cancel_right y v_γ
        rwa [h_eq]
      · intro h_mem
        refine ⟨g.1 + (x - v_γ), h_mem, ?_⟩
        abel
    simp_rw [h_iff]
    exact ZSpan.exist_unique_vadd_mem_fundamentalDomain b₀ (x - v_γ)
  have h_img := (MeasureTheory.MeasurePreserving.setIntegral_image_emb
    (MeasureTheory.measurePreserving_add_right MeasureTheory.volume v_γ)
    (measurableEmbedding_addRight v_γ) Θ Cube).symm
  have h_eq_fund := MeasureTheory.IsAddFundamentalDomain.setIntegral_eq
    h_fund_trans h_fund_Cube h_per
  exact h_lhs_eq.trans (h_img.trans h_eq_fund)

theorem mitsui_primitive_narrow_ray_char_classGroup_cube_lattice_theta_inversion {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (ψ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hψ₀_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖ψ₀ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → ψ₀ I = 0))
    (a_place : NumberField.InfinitePlace K → ℕ)
    (ha_real : ∀ w : NumberField.InfinitePlace K, w.IsReal → a_place w ≤ 1)
    (ha_cplx : ∀ w : NumberField.InfinitePlace K, w.IsComplex → a_place w = 0)
    (J_rep : ClassGroup (NumberField.RingOfIntegers K) → nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))
    (hJ_cls : ∀ C : ClassGroup (NumberField.RingOfIntegers K), ClassGroup.mk0 (J_rep C) = C⁻¹)
    (hJ_cop : ∀ C : ClassGroup (NumberField.RingOfIntegers K), (J_rep C : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤)
    (ψ_f : (NumberField.RingOfIntegers K ⧸ f) → ℂ)
    (hψ_one : ψ_f 1 = 1)
    (hψ_mul : ∀ a b : NumberField.RingOfIntegers K ⧸ f, ψ_f (a * b) = ψ_f a * ψ_f b)
    (hψ_unit : ∀ a : NumberField.RingOfIntegers K ⧸ f, (IsUnit a → ‖ψ_f a‖ = 1) ∧ (¬ IsUnit a → ψ_f a = 0))
    (hψ_span : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      ψ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
        ψ_f (Ideal.Quotient.mk f x) *
          ∏ w : NumberField.InfinitePlace K,
            (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (a_place w))
    (hψ_prim : ∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
      ∃ x : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk f x) ∧ x - 1 ∈ f' ∧ ψ_f (Ideal.Quotient.mk f x) ≠ 1)
    (hψ_zero : (f ≠ ⊤ ∧ ψ_f 0 = 0 ∧
        ∀ (h_fin : Fintype (NumberField.RingOfIntegers K ⧸ f)),
          @Finset.sum (NumberField.RingOfIntegers K ⧸ f) ℂ _ (@Finset.univ (NumberField.RingOfIntegers K ⧸ f) h_fin) ψ_f = 0) ∨
      (f = ⊤ ∧ (∀ a : NumberField.RingOfIntegers K ⧸ f, ψ_f a = 1) ∧
        ((∃ w : NumberField.InfinitePlace K, a_place w ≠ 0) ∨
          ((∀ w : NumberField.InfinitePlace K, a_place w = 0) ∧
            (∑ C : ClassGroup (NumberField.RingOfIntegers K), star (ψ₀ (J_rep C))) = 0 ∧
            (∑ C : ClassGroup (NumberField.RingOfIntegers K), ψ₀ (J_rep C)) = 0)))) :
    let R := NumberField.RingOfIntegers K
    let n : ℕ := Module.finrank ℚ K
    let r : ℕ := NumberField.Units.rank K
    let S_f : ℝ := |(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) * (Ideal.absNorm f : ℝ) ^ (-1 / 2 : ℝ)
    let Cube : Set (Fin r → ℝ) := Set.pi Set.univ (fun _ => Set.Ico (0 : ℝ) 1)
    ∃ ω_ψ : ℂ, ‖ω_ψ‖ = 1 ∧
      ∀ u ∈ Set.Ioi (0 : ℝ),
        (∑ C : ClassGroup R,
          star (ψ₀ (J_rep C)) *
            (∫ y in Cube,
              (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
                ψ_f (Ideal.Quotient.mk f x.1) *
                  (∏ w : NumberField.InfinitePlace K,
                    (w.embedding (x.1 : K) *
                      ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (y i) : ℝ) : ℂ)) ^ (a_place w)) *
                  (((((S_f * u⁻¹ / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
                      (∑ w : NumberField.InfinitePlace K, a_place w) *
                    Real.exp (-Real.pi * (S_f * u⁻¹ / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                      ∑ w : NumberField.InfinitePlace K,
                        (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                          ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) : ℝ) : ℂ))))) =
        (u : ℂ) * ω_ψ *
          (∑ C : ClassGroup R,
            ψ₀ (J_rep C) *
              (∫ y in Cube,
                (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
                  star (ψ_f (Ideal.Quotient.mk f x.1)) *
                    (∏ w : NumberField.InfinitePlace K,
                      (w.embedding (x.1 : K) *
                        ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) *
                    (((((S_f * u / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
                        (∑ w : NumberField.InfinitePlace K, a_place w) *
                      Real.exp (-Real.pi * (S_f * u / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                        ∑ w : NumberField.InfinitePlace K,
                          (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                            ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ))))) :=
by
  classical
  intro R n r S_f Cube
  let D : ℝ := |(NumberField.discr K : ℝ)|
  let N_f : ℝ := (Ideal.absNorm f : ℝ)
  haveI : Finite (R ⧸ f) := Ideal.finiteQuotientOfFreeOfNeBot f hf
  letI : Fintype (R ⧸ f) := Fintype.ofFinite (R ⧸ f)
  obtain ⟨σ, γ_C, α_C, Φ_C, ω_ψ, hω_norm, hγ_C, hα_Φ, h_gauss⟩ :=
    mitsui_primitive_narrow_ray_char_dual_class_and_gauss_sum
