      exact (mitsui_archimedean_place_gamma_mellin_identities _ hs_re).1
    have h_cplx : (∏ w ∈ Finset.univ.filter (fun w : NumberField.InfinitePlace K => ¬w.IsReal), F w) =
        ∏ p_idx : Fin (NumberField.InfinitePlace.nrComplexPlaces K),
          Complex.Gammaℂ (z + ((l_cplx p_idx : ℝ) / 2 : ℂ) + ((ν_place (e_cplx.symm p_idx).1 : ℝ) / 2 : ℂ) * Complex.I) := by
      have h_filt : Finset.univ.filter (fun w : NumberField.InfinitePlace K => ¬w.IsReal) =
          Finset.univ.filter (fun w : NumberField.InfinitePlace K => w.IsComplex) := by
        ext w
        simp [NumberField.InfinitePlace.not_isReal_iff_isComplex]
      rw [h_filt]
      have h_sub : (∏ w ∈ Finset.univ.filter (fun w : NumberField.InfinitePlace K => w.IsComplex), F w) =
          ∏ w : {w : NumberField.InfinitePlace K // w.IsComplex}, F w.1 :=
        Finset.prod_subtype (Finset.univ.filter (fun w : NumberField.InfinitePlace K => w.IsComplex))
          (fun _ => by simp) F
      rw [h_sub, ← Equiv.prod_comp e_cplx.symm]
      refine Finset.prod_congr rfl (fun p_idx _ => ?_)
      set w_sub : {w : NumberField.InfinitePlace K // w.IsComplex} := e_cplx.symm p_idx
      have hm_r : (w_sub.1.mult : ℝ) = 2 := by exact_mod_cast NumberField.InfinitePlace.mult_isComplex w_sub
      have hm_c : (w_sub.1.mult : ℂ) = 2 := by exact_mod_cast NumberField.InfinitePlace.mult_isComplex w_sub
      dsimp [F, l_cplx]
      rw [hm_r, hm_c]
      have h22 : (2 : ℝ) / 2 = 1 := by ring
      rw [h22]
      have h_exp_eq : z + ((a_place w_sub.1 : ℂ) + (ν_place w_sub.1 : ℂ) * Complex.I) / 2 =
          z + ((a_place w_sub.1 : ℝ) / 2 : ℂ) + ((ν_place w_sub.1 : ℝ) / 2 : ℂ) * Complex.I := by
        push_cast
        ring
