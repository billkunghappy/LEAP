        norm_pos_iff.mpr (h_sin_ne ((Real.pi : ℂ) * z) h_pz_im_ne)
      have h_prod_ge : (1 / 4 : ℝ) ≤ ‖2 - z‖ * ‖1 - z‖ := by
        calc (1 / 4 : ℝ) = (1 / 2) * (1 / 2) := by ring
          _ ≤ ‖2 - z‖ * ‖1 - z‖ := mul_le_mul h2z_norm h1z_norm (by norm_num) (norm_nonneg _)
      have h_rhs_ge : (3 / 4 : ℝ) * Real.exp (-4 * |z.im|) ≤
          ‖2 - z‖ * ‖1 - z‖ * (Real.pi / ‖Complex.sin ((Real.pi : ℂ) * z)‖) := by
        have h_pi_div : 3 * Real.exp (-4 * |z.im|) ≤ Real.pi / ‖Complex.sin ((Real.pi : ℂ) * z)‖ := by
          rw [le_div_iff₀ h_sin_pos]
          calc 3 * Real.exp (-4 * |z.im|) * ‖Complex.sin ((Real.pi : ℂ) * z)‖
              ≤ 3 * Real.exp (-4 * |z.im|) * Real.exp (4 * |z.im|) :=
                mul_le_mul_of_nonneg_left h_sin_pz (by positivity)
            _ = 3 * (Real.exp (-4 * |z.im|) * Real.exp (4 * |z.im|)) := by ring
            _ = 3 := by rw [← Real.exp_add]; simp
            _ ≤ Real.pi := le_of_lt Real.pi_gt_three
        calc (3 / 4 : ℝ) * Real.exp (-4 * |z.im|)
            = (1 / 4) * (3 * Real.exp (-4 * |z.im|)) := by ring
          _ ≤ (‖2 - z‖ * ‖1 - z‖) * (Real.pi / ‖Complex.sin ((Real.pi : ℂ) * z)‖) :=
              mul_le_mul h_prod_ge h_pi_div (by positivity) (by positivity)
      have h_7_gz : (3 / 4 : ℝ) * Real.exp (-4 * |z.im|) ≤ 7 * ‖Complex.Gamma z‖ := by
        calc (3 / 4 : ℝ) * Real.exp (-4 * |z.im|)
            ≤ ‖2 - z‖ * ‖1 - z‖ * (Real.pi / ‖Complex.sin ((Real.pi : ℂ) * z)‖) := h_rhs_ge
          _ = ‖Complex.Gamma z‖ * ‖Complex.Gamma (3 - z)‖ := h_refl_norm.symm
          _ ≤ ‖Complex.Gamma z‖ * 7 := mul_le_mul_of_nonneg_left h_g3z_le (norm_nonneg _)
          _ = 7 * ‖Complex.Gamma z‖ := by ring
      have hexp_16 : Real.exp (-16) ≤ 3 / 28 := by
        have h1 : (11 : ℝ) ≤ Real.exp 16 := by
          have h2 := Real.add_one_le_exp 10
          have h3 : Real.exp 10 ≤ Real.exp 16 := Real.exp_le_exp.mpr (by norm_num)
          linarith
        rw [Real.exp_neg, inv_le_iff_one_le_mul₀ (Real.exp_pos 16)]
        linarith
      have h_exp_split : Real.exp (-4 * (4 + |z.im|)) = Real.exp (-16) * Real.exp (-4 * |z.im|) := by
        rw [← Real.exp_add]
        congr 1; ring
      rw [h_exp_split]
      have h_le_3_28 : Real.exp (-16) * Real.exp (-4 * |z.im|) ≤ (3 / 28 : ℝ) * Real.exp (-4 * |z.im|) :=
        mul_le_mul_of_nonneg_right hexp_16 (le_of_lt (Real.exp_pos _))
      linarith
    intro s hs_re1 hs_re2 hs_im
    set L : ℝ := 4 + |s.im|
    have hL_ge_four : 4 ≤ L := by dsimp [L]; linarith [abs_nonneg s.im]
    have h_gammaR : Real.exp (-8 * L) ≤ ‖Complex.Gammaℝ s‖ := by
      rw [Complex.Gammaℝ_def, norm_mul]
      have hs2_re1 : -1 / 2 ≤ (s / 2).re := by
        rw [Complex.div_ofNat_re]; linarith
      have hs2_re2 : (s / 2).re ≤ 2 := by
        rw [Complex.div_ofNat_re]; linarith
      have hs2_im : 1 / 2 ≤ |(s / 2).im| := by
        rw [Complex.div_ofNat_im, abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
        linarith
      have h_g_s2 := h_gamma_lower (s / 2) hs2_re1 hs2_re2 hs2_im
      have h_g_s2_L : Real.exp (-4 * L) ≤ ‖Complex.Gamma (s / 2)‖ := by
        have h1 : -4 * L ≤ -4 * (4 + |(s / 2).im|) := by
          rw [Complex.div_ofNat_im, abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
          dsimp [L]; linarith [abs_nonneg s.im]
        exact le_trans (Real.exp_le_exp.mpr h1) h_g_s2
      have h_pi_pow : Real.exp (-4 * L) ≤ ‖(Real.pi : ℂ) ^ (-s / 2)‖ := by
        rw [Complex.norm_cpow_eq_rpow_re_of_pos Real.pi_pos]
        have h_re : (-s / 2).re = -s.re / 2 := by
          rw [Complex.div_ofNat_re, Complex.neg_re]
        rw [h_re]
        have h_rpow1 : Real.pi ^ (-1 : ℝ) ≤ Real.pi ^ (-s.re / 2) :=
          Real.rpow_le_rpow_of_exponent_le (by linarith [Real.pi_gt_three]) (by linarith)
        have h_pi_inv : (1 / 4 : ℝ) ≤ Real.pi ^ (-1 : ℝ) := by
          rw [Real.rpow_neg_one, one_div]
          exact inv_anti₀ Real.pi_pos (le_of_lt Real.pi_lt_four)
        have hexp_4L : Real.exp (-4 * L) ≤ 1 / 4 := by
          have h1 : (4 : ℝ) ≤ Real.exp (4 * L) := by
            have h2 := Real.add_one_le_exp (4 * L)
            linarith
          rw [show -4 * L = -(4 * L) by ring, Real.exp_neg, one_div]
          exact inv_anti₀ (by norm_num) h1
        exact le_trans hexp_4L (le_trans h_pi_inv h_rpow1)
      calc Real.exp (-8 * L)
          = Real.exp (-4 * L) * Real.exp (-4 * L) := by
            rw [← Real.exp_add]; congr 1; ring
        _ ≤ ‖(Real.pi : ℂ) ^ (-s / 2)‖ * ‖Complex.Gamma (s / 2)‖ :=
            mul_le_mul h_pi_pow h_g_s2_L (le_of_lt (Real.exp_pos _)) (norm_nonneg _)
    have h_gammaR_shift : Real.exp (-8 * L) ≤ ‖Complex.Gammaℝ (s + 1)‖ := by
      rw [Complex.Gammaℝ_def, norm_mul]
      have hs1_2_re1 : -1 / 2 ≤ ((s + 1) / 2).re := by
        rw [Complex.div_ofNat_re, Complex.add_re, Complex.one_re]; linarith
      have hs1_2_re2 : ((s + 1) / 2).re ≤ 2 := by
        rw [Complex.div_ofNat_re, Complex.add_re, Complex.one_re]; linarith
      have hs1_2_im : 1 / 2 ≤ |((s + 1) / 2).im| := by
        rw [Complex.div_ofNat_im, Complex.add_im, Complex.one_im, add_zero,
          abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
        linarith
      have h_g_s1_2 := h_gamma_lower ((s + 1) / 2) hs1_2_re1 hs1_2_re2 hs1_2_im
      have h_g_s1_2_L : Real.exp (-4 * L) ≤ ‖Complex.Gamma ((s + 1) / 2)‖ := by
        have h1 : -4 * L ≤ -4 * (4 + |((s + 1) / 2).im|) := by
          rw [Complex.div_ofNat_im, Complex.add_im, Complex.one_im, add_zero,
            abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
          dsimp [L]; linarith [abs_nonneg s.im]
        exact le_trans (Real.exp_le_exp.mpr h1) h_g_s1_2
      have h_pi_pow : Real.exp (-4 * L) ≤ ‖(Real.pi : ℂ) ^ (-(s + 1) / 2)‖ := by
        rw [Complex.norm_cpow_eq_rpow_re_of_pos Real.pi_pos]
        have h_re : (-(s + 1) / 2).re = -(s.re + 1) / 2 := by
          rw [Complex.div_ofNat_re, Complex.neg_re, Complex.add_re, Complex.one_re]
        rw [h_re]
        have h_rpow2 : Real.pi ^ (-2 : ℝ) ≤ Real.pi ^ (-(s.re + 1) / 2) :=
          Real.rpow_le_rpow_of_exponent_le (by linarith [Real.pi_gt_three]) (by linarith)
        have h_pi_inv_sq : (1 / 16 : ℝ) ≤ Real.pi ^ (-2 : ℝ) := by
          have h_eq : Real.pi ^ (-2 : ℝ) = (Real.pi ^ 2)⁻¹ := by
            rw [show (-2 : ℝ) = -((2 : ℕ) : ℝ) by norm_num,
              Real.rpow_neg (le_of_lt Real.pi_pos), Real.rpow_natCast]
          rw [h_eq, one_div]
          have h_sq_le : Real.pi ^ 2 ≤ 16 := by nlinarith [Real.pi_pos, Real.pi_lt_four]
          exact inv_anti₀ (by positivity) h_sq_le
        have hexp_4L : Real.exp (-4 * L) ≤ 1 / 16 := by
          have h1 : (16 : ℝ) ≤ Real.exp (4 * L) := by
            have h2 := Real.add_one_le_exp (4 * L)
            linarith
          rw [show -4 * L = -(4 * L) by ring, Real.exp_neg, one_div]
          exact inv_anti₀ (by norm_num) h1
        exact le_trans hexp_4L (le_trans h_pi_inv_sq h_rpow2)
      calc Real.exp (-8 * L)
          = Real.exp (-4 * L) * Real.exp (-4 * L) := by
            rw [← Real.exp_add]; congr 1; ring
        _ ≤ ‖(Real.pi : ℂ) ^ (-(s + 1) / 2)‖ * ‖Complex.Gamma ((s + 1) / 2)‖ :=
            mul_le_mul h_pi_pow h_g_s1_2_L (le_of_lt (Real.exp_pos _)) (norm_nonneg _)
    have h_gammaC : Real.exp (-8 * L) ≤ ‖Complex.Gammaℂ s‖ := by
      rw [Complex.Gammaℂ_def, norm_mul, norm_mul, Complex.norm_ofNat]
      have h_g_s : Real.exp (-4 * L) ≤ ‖Complex.Gamma s‖ :=
        h_gamma_lower s hs_re1 hs_re2 (by linarith)
      have h_2pi_pos : 0 < 2 * Real.pi := by positivity
      have h_2pi_cast : (2 * (Real.pi : ℂ)) = ((2 * Real.pi : ℝ) : ℂ) := by push_cast; ring
      have h_2pi_pow : Real.exp (-4 * L) ≤ 2 * ‖(2 * (Real.pi : ℂ)) ^ (-s)‖ := by
        rw [h_2pi_cast, Complex.norm_cpow_eq_rpow_re_of_pos h_2pi_pos, Complex.neg_re]
        have h_rpow2 : (2 * Real.pi) ^ (-2 : ℝ) ≤ (2 * Real.pi) ^ (-s.re) :=
          Real.rpow_le_rpow_of_exponent_le (by linarith [Real.pi_gt_three]) (by linarith)
        have h_inv_sq : (1 / 64 : ℝ) ≤ (2 * Real.pi) ^ (-2 : ℝ) := by
          have h_eq : (2 * Real.pi) ^ (-2 : ℝ) = ((2 * Real.pi) ^ 2)⁻¹ := by
            rw [show (-2 : ℝ) = -((2 : ℕ) : ℝ) by norm_num, Real.rpow_neg (le_of_lt h_2pi_pos),
              Real.rpow_natCast]
          rw [h_eq, one_div]
          have h_sq_le : (2 * Real.pi) ^ 2 ≤ 64 := by nlinarith [Real.pi_pos, Real.pi_lt_four]
          exact inv_anti₀ (by positivity) h_sq_le
        have hexp_4L : Real.exp (-4 * L) ≤ 1 / 32 := by
          have h_e2 : (3 : ℝ) ≤ Real.exp 2 := by linarith [Real.add_one_le_exp 2]
          have h_e8 : (3 : ℝ) ^ 4 ≤ (Real.exp 2) ^ 4 := pow_le_pow_left₀ (by norm_num) h_e2 4
          have h_e8_eq : (Real.exp 2) ^ 4 = Real.exp 8 := by
            rw [← Real.exp_nat_mul]; norm_num
          have h_e16 : Real.exp 8 ≤ Real.exp (4 * L) := Real.exp_le_exp.mpr (by linarith)
          have h_32 : (32 : ℝ) ≤ Real.exp (4 * L) := by linarith [show (3 : ℝ) ^ 4 = 81 by norm_num]
          rw [show -4 * L = -(4 * L) by ring, Real.exp_neg, one_div]
          exact inv_anti₀ (by norm_num) h_32
        calc Real.exp (-4 * L) ≤ 1 / 32 := hexp_4L
          _ = 2 * (1 / 64) := by ring
          _ ≤ 2 * (2 * Real.pi) ^ (-2 : ℝ) := mul_le_mul_of_nonneg_left h_inv_sq (by norm_num)
          _ ≤ 2 * (2 * Real.pi) ^ (-s.re) := mul_le_mul_of_nonneg_left h_rpow2 (by norm_num)
      calc Real.exp (-8 * L)
          = Real.exp (-4 * L) * Real.exp (-4 * L) := by
            rw [← Real.exp_add]; congr 1; ring
        _ ≤ (2 * ‖(2 * (Real.pi : ℂ)) ^ (-s)‖) * ‖Complex.Gamma s‖ :=
            mul_le_mul h_2pi_pow h_g_s (le_of_lt (Real.exp_pos _)) (by positivity)
    have hgR_inv_le : ‖gR_inv s‖ ≤ Real.exp (8 * L) := by
      dsimp [gR_inv]
      rw [norm_inv, show 8 * L = -(-8 * L) by ring, Real.exp_neg]
      exact inv_anti₀ (Real.exp_pos (-8 * L)) h_gammaR
    have hgR1_inv_le : ‖gR1_inv s‖ ≤ Real.exp (8 * L) := by
      dsimp [gR1_inv]
      rw [norm_inv, show 8 * L = -(-8 * L) by ring, Real.exp_neg]
      exact inv_anti₀ (Real.exp_pos (-8 * L)) h_gammaR_shift
    have hgC_inv_le : ‖gC_inv s‖ ≤ Real.exp (8 * L) := by
      rw [hgC_inv_eq s, norm_inv, show 8 * L = -(-8 * L) by ring, Real.exp_neg]
      exact inv_anti₀ (Real.exp_pos (-8 * L)) h_gammaC
    have hd_inv_le : ‖d_inv s‖ ≤ D ^ (1 / 4 : ℝ) := by
      dsimp [d_inv]
      rw [Complex.norm_cpow_eq_rpow_re_of_pos hD_pos, Complex.div_ofNat_re, Complex.neg_re]
      exact Real.rpow_le_rpow_of_exponent_le hD_ge_one (by linarith)
    have hq₀_pow : ‖gR_inv s‖ ^ q₀ ≤ Real.exp (8 * (q₀ : ℝ) * L) := by
      calc ‖gR_inv s‖ ^ q₀
          ≤ (Real.exp (8 * L)) ^ q₀ := pow_le_pow_left₀ (norm_nonneg _) hgR_inv_le q₀
        _ = Real.exp (8 * (q₀ : ℝ) * L) := by
          rw [← Real.exp_nat_mul]; congr 1; ring
    have hq₁_pow : ‖gR1_inv s‖ ^ q₁ ≤ Real.exp (8 * (q₁ : ℝ) * L) := by
      calc ‖gR1_inv s‖ ^ q₁
          ≤ (Real.exp (8 * L)) ^ q₁ := pow_le_pow_left₀ (norm_nonneg _) hgR1_inv_le q₁
        _ = Real.exp (8 * (q₁ : ℝ) * L) := by
          rw [← Real.exp_nat_mul]; congr 1; ring
    have hr₂_pow : ‖gC_inv s‖ ^ r₂ ≤ Real.exp (8 * (r₂ : ℝ) * L) := by
      calc ‖gC_inv s‖ ^ r₂
          ≤ (Real.exp (8 * L)) ^ r₂ := pow_le_pow_left₀ (norm_nonneg _) hgC_inv_le r₂
        _ = Real.exp (8 * (r₂ : ℝ) * L) := by
          rw [← Real.exp_nat_mul]; congr 1; ring
    dsimp [G_inv]
    simp only [norm_mul, norm_pow]
    have h_prod1 : ‖d_inv s‖ * ‖gR_inv s‖ ^ q₀ ≤ D ^ (1 / 4 : ℝ) * Real.exp (8 * (q₀ : ℝ) * L) :=
      mul_le_mul hd_inv_le hq₀_pow (by positivity) (by positivity)
    have h_prod2 : ‖d_inv s‖ * ‖gR_inv s‖ ^ q₀ * ‖gR1_inv s‖ ^ q₁ ≤
        D ^ (1 / 4 : ℝ) * Real.exp (8 * (q₀ : ℝ) * L) * Real.exp (8 * (q₁ : ℝ) * L) :=
      mul_le_mul h_prod1 hq₁_pow (by positivity) (by positivity)
    calc ‖d_inv s‖ * ‖gR_inv s‖ ^ q₀ * ‖gR1_inv s‖ ^ q₁ * ‖gC_inv s‖ ^ r₂
        ≤ D ^ (1 / 4 : ℝ) * Real.exp (8 * (q₀ : ℝ) * L) * Real.exp (8 * (q₁ : ℝ) * L) *
            Real.exp (8 * (r₂ : ℝ) * L) :=
          mul_le_mul h_prod2 hr₂_pow (by positivity) (by positivity)
      _ = D ^ (1 / 4 : ℝ) *
            (Real.exp (8 * (q₀ : ℝ) * L) * Real.exp (8 * (q₁ : ℝ) * L) * Real.exp (8 * (r₂ : ℝ) * L)) := by
          ring
      _ = D ^ (1 / 4 : ℝ) * Real.exp (8 * ((q₀ : ℝ) + (q₁ : ℝ) + (r₂ : ℝ)) * L) := by
          rw [← Real.exp_add, ← Real.exp_add]
          congr 2
          ring

theorem mitsui_ray_char_mellin_Ioi_zero_of_kernel_unfolding {K : Type u} [Field K] [NumberField K]
    (ψ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hψ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖ψ I‖ ≤ 1)
    (W : ℝ → ℝ) (Φ : ℝ → ℂ) (κ Γ_s : ℂ) (s : ℂ) (hs : 1 < s.re)
    (hW_meas : MeasureTheory.AEStronglyMeasurable W (MeasureTheory.volume.restrict (Set.Ioi (0 : ℝ))))
    (hW_nn : ∀ t ∈ Set.Ioi (0 : ℝ), 0 ≤ W t)
    (hW_int : MeasureTheory.IntegrableOn (fun t : ℝ => t ^ s.re * W t) (Set.Ioi (0 : ℝ)) MeasureTheory.volume)
    (hW_mellin : (∫ t in Set.Ioi (0 : ℝ), (t : ℂ) ^ s * (W t : ℂ)) = Γ_s)
    (hΦ_unfold : ∀ u ∈ Set.Ioi (0 : ℝ),
      Φ u = κ * ∑' m : ℕ,
        (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
          ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
          (((m : ℝ) * W ((m : ℝ) * u) : ℝ) : ℂ)) :
    κ * Γ_s * LSeries (fun n =>
      ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
        ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s =
      ∫ u in Set.Ioi (0 : ℝ), (u : ℂ) ^ s * Φ u :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let S : ℕ → Type u := fun e => {I : Ideal R // Ideal.absNorm I = e}
  let S' : ℕ → Type u := fun e => {I : Ideal R // I ≠ ⊥ ∧ Ideal.absNorm I = e}
  let a_K : ℕ → ℕ := fun n => Nat.card (S n)
  let a_ψ : ℕ → ℂ := fun n =>
    ∑' I : S' n, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩
  have hS_fin : ∀ e : ℕ, Finite (S e) := fun e => Ideal.finite_setOf_absNorm_eq e
  have hS'_fin : ∀ e : ℕ, Finite (S' e) := fun e =>
    (Ideal.finite_setOf_absNorm_eq e).subset (fun _ h => h.2)
  letI : ∀ e, Fintype (S e) := fun e => Fintype.ofFinite (S e)
  letI : ∀ e, Fintype (S' e) := fun e => Fintype.ofFinite (S' e)
  have ha_nonneg : ∀ n : ℕ, 0 ≤ (a_K n : ℝ) := fun _ => Nat.cast_nonneg _
  have h_ideal_card : ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ x : ℝ, 1 ≤ x →
      (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ * x := by
    set L_K : ℝ :=
      2 ^ NumberField.InfinitePlace.nrRealPlaces K *
        (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
        NumberField.Units.regulator K *
        (NumberField.classNumber K : ℝ) /
        ((NumberField.Units.torsionOrder K : ℝ) * Real.sqrt |(NumberField.discr K : ℝ)|)
    have h_tendsto : Filter.Tendsto
        (fun x : ℝ => (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x)
        Filter.atTop (nhds L_K) :=
      NumberField.Ideal.tendsto_norm_le_div_atTop K
    obtain ⟨S₀, hS₀⟩ := (Metric.tendsto_atTop.mp h_tendsto) 1 zero_lt_one
    let S₁ : ℝ := max S₀ 1
    let N₁ : ℕ := Nat.card {J : Ideal R // Ideal.absNorm J ≤ ⌊S₁⌋₊}
    let C₁ : ℝ := max (|L_K| + 1) ((N₁ : ℝ) + 1)
    have hC₁_pos : 0 < C₁ := by
      have h1 : 0 ≤ |L_K| := abs_nonneg L_K
      have h2 : |L_K| + 1 ≤ C₁ := le_max_left _ _
      linarith
    refine ⟨C₁, hC₁_pos, ?_⟩
    intro x hx
    have hx_pos : 0 < x := lt_of_lt_of_le zero_lt_one hx
    by_cases hS : S₁ ≤ x
    · have hS₀_le : S₀ ≤ x := le_trans (le_max_left S₀ 1) hS
      have h_dist := hS₀ x hS₀_le
      rw [Real.dist_eq] at h_dist
      have h_sub : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x - L_K < 1 :=
        (abs_sub_lt_iff.mp h_dist).1
      have h_abs : L_K ≤ |L_K| := le_abs_self L_K
      have h_max : |L_K| + 1 ≤ C₁ := le_max_left _ _
      have h_div_le : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x ≤ C₁ := by linarith
      exact (div_le_iff₀ hx_pos).mp h_div_le
    · have hx_le : x ≤ S₁ := le_of_not_ge hS
      have h_sub : {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ x} ⊆
          {J : Ideal R | Ideal.absNorm J ≤ ⌊S₁⌋₊} := by
        intro J hJ
        exact Nat.le_floor (le_trans hJ hx_le)
      have h_fin : {J : Ideal R | Ideal.absNorm J ≤ ⌊S₁⌋₊}.Finite :=
        Ideal.finite_setOf_absNorm_le ⌊S₁⌋₊
      have h_card_le : Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} ≤ N₁ :=
        Nat.card_mono h_fin h_sub
      have h_card_real : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ (N₁ : ℝ) := by
        exact_mod_cast h_card_le
      have h_max : (N₁ : ℝ) + 1 ≤ C₁ := le_max_right _ _
      have h_le_C₁ : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ := by linarith
      nlinarith
  obtain ⟨C₁, hC₁_pos, hC₁⟩ := h_ideal_card
  have h_sum_K : Summable (LSeries.term (fun n => (a_K n : ℂ)) s) := by
    have ha_sum_bound : ∀ N : ℕ, 1 ≤ N →
        (∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ)) ≤ C₁ * (N : ℝ) ^ (1 : ℝ) := by
      intro N hN
      have hN_real : (1 : ℝ) ≤ (N : ℝ) := by exact_mod_cast hN
      let S_J := {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ (N : ℝ)}
      have hSJ_fin : {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ (N : ℝ)}.Finite := by
        apply Set.Finite.subset (Ideal.finite_setOf_absNorm_le N)
        intro J hJ
        exact_mod_cast hJ
      haveI : Finite S_J := hSJ_fin
      let S_pos := {J : Ideal R // 1 ≤ Ideal.absNorm J ∧ Ideal.absNorm J ≤ N}
      have hS_pos_fin : {J : Ideal R | 1 ≤ Ideal.absNorm J ∧ Ideal.absNorm J ≤ N}.Finite :=
        (Ideal.finite_setOf_absNorm_le N).subset (fun _ h => h.2)
      haveI : Finite S_pos := hS_pos_fin
      letI : Fintype S_pos := Fintype.ofFinite S_pos
      let g : S_pos → ℕ := fun J => Ideal.absNorm J.1
      have hg : ∀ J ∈ (Finset.univ : Finset S_pos), g J ∈ Finset.Icc 1 N := by
        intro J _
        rw [Finset.mem_Icc]
        exact J.2
