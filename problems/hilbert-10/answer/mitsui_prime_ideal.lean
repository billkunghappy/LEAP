        intro x_star
        congr 1
        rw [hc_C_inv_sq]
        have h_inv_ty : ∀ w : NumberField.InfinitePlace K,
            (t_y w)⁻¹ = a_C⁻¹ * ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i) := by
