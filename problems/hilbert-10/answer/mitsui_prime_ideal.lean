                mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ w *
              Complex.exp
                (((∑ j : Fin (NumberField.Units.rank K),
                    (Φ_W ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
                      mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ j + (d j : ℝ)) *
                      (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg) : ℝ) * Complex.I))) :
    ∃ c_gr : ℝ, 0 < c_gr ∧
      ∀ Y : ℝ, 1 < Y →
        ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
          (Ideal.absNorm q : ℝ) < (2 * Real.log Y) ^ A →
