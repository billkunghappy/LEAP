      Ideal.span ({((U_map ζe : NumberField.RingOfIntegers K) * g)} : Set (NumberField.RingOfIntegers K)) = I := by
    intro ζe
    rw [Ideal.span_singleton_mul_left_unit (U_map ζe).isUnit g, hg_span]
  let Φ_I : NumberField.Units.torsion K × (Fin (NumberField.Units.rank K) → ℤ) →
      {x : NumberField.RingOfIntegers K // Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = I} :=
    fun ζe => ⟨(U_map ζe : NumberField.RingOfIntegers K) * g, h_span ζe⟩
  have hΦ_inj : Function.Injective Φ_I := by
    intro p₁ p₂ hΦ
    have h_val : (U_map p₁ : NumberField.RingOfIntegers K) * g =
        (U_map p₂ : NumberField.RingOfIntegers K) * g := congrArg Subtype.val hΦ
    have h_coe : (U_map p₁ : NumberField.RingOfIntegers K) = (U_map p₂ : NumberField.RingOfIntegers K) :=
      mul_right_cancel₀ hg_ne h_val
    have hU_eq : U_map p₁ = U_map p₂ := Units.ext h_coe
    exact (NumberField.Units.exist_unique_eq_mul_prod K (U_map p₁)).unique rfl hU_eq
  have hΦ_surj : Function.Surjective Φ_I := by
    intro x
