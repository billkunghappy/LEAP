        have hz_re1 : 1 - (2 / 3) * L⁻¹ ≤ z.re := by linarith [(abs_le.mp h_re_abs).1]
        have hz_re2 : z.re ≤ 1 + L⁻¹ := by linarith [(abs_le.mp h_re_abs).2]
        have hz_im : |z.im| ≤ 1 := by linarith
        exact hg_box z hz_re1 hz_re2 hz_im
      have h_cauchy := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le
        hR_pos hg_diff.diffContOnCl h_sphere
      have h_div_eq : (B * L) / R = (6 * B) * L ^ 2 := by
        dsimp [R]
        have hL_ne : L ≠ 0 := ne_of_gt hL_pos
        field_simp [hL_ne]
      rwa [h_div_eq] at h_cauchy
    intro σ hσ1 hσ2
    let S_ball : Set ℂ := Metric.closedBall (1 : ℂ) (2 * L)⁻¹
    have h1_mem : (1 : ℂ) ∈ S_ball := Metric.mem_closedBall_self (by positivity)
    have h_norm_sub : ‖(1 : ℂ) - (σ : ℂ)‖ = 1 - σ := by
      have h_cast : (1 : ℂ) - (σ : ℂ) = ((1 - σ : ℝ) : ℂ) := by push_cast; ring
      rw [h_cast, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by linarith)]
    have hσ_mem : (σ : ℂ) ∈ S_ball := by
      rw [Metric.mem_closedBall, dist_eq_norm, norm_sub_rev, h_norm_sub]
      linarith
    have h_mvt := Convex.norm_image_sub_le_of_norm_deriv_le
      (fun z _ => hg_diff z) h_deriv_ball (convex_closedBall (1 : ℂ) (2 * L)⁻¹) hσ_mem h1_mem
    rw [h_norm_sub] at h_mvt
    calc ‖g 1 - g (σ : ℂ)‖
        ≤ (6 * B) * L ^ 2 * (1 - σ) := h_mvt
      _ = (1 - σ) * (6 * B) * L ^ 2 := by ring
  obtain ⟨C_ζ, hC_ζ_pos, h_s1_bound⟩ := h_s1
  set m : ℕ := Module.finrank ℚ K + 1
  let K₁ : ℝ := max A₁ 1
  have hK₁_ge_one : 1 ≤ K₁ := le_max_right A₁ 1
  have hA₁_le_K₁ : A₁ ≤ K₁ := le_max_left A₁ 1
  let K₂ : ℝ := max C_ζ 1
  have hK₂_ge_one : 1 ≤ K₂ := le_max_right C_ζ 1
  have hC_ζ_le_K₂ : C_ζ ≤ K₂ := le_max_left C_ζ 1
  let B : ℝ := 10 ^ m * (2 ^ m * K₁) ^ (4 : ℝ) * Real.exp (4 * (m : ℝ)) * K₂
  have hB_pos : 0 < B := by dsimp [B]; positivity
  let C_deriv : ℝ := 6 * B
  have hC_deriv_pos : 0 < C_deriv := by dsimp [C_deriv]; positivity
  have hlog4_gt : 4 / 3 < Real.log 4 := by
    have h_exp4 : Real.exp 4 < (4 : ℝ) ^ (3 : ℕ) := by
      have he : Real.exp 4 = (Real.exp 1) ^ (4 : ℕ) := by
        rw [← Real.exp_nat_mul]
        norm_num
      rw [he]
      have h1 : (Real.exp 1) ^ (4 : ℕ) < (2.7182818286 : ℝ) ^ (4 : ℕ) :=
        pow_lt_pow_left₀ Real.exp_one_lt_d9 (le_of_lt (Real.exp_pos 1)) (by omega)
      linarith
    have h_log := Real.log_lt_log (Real.exp_pos 4) h_exp4
    rw [Real.log_exp, Real.log_pow] at h_log
    push_cast at h_log
    linarith
  refine ⟨C_deriv, hC_deriv_pos, ?_⟩
  intro q hq χ hχ_norm g_χ hg_diff hg_eq hg_growth
  set N_q : ℝ := (Ideal.absNorm q : ℝ)
  set L_q : ℝ := Real.log N_q + Real.log 4
  have hq_norm_ne : Ideal.absNorm q ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hq
  have hNq_ge_one : 1 ≤ N_q := by
    dsimp [N_q]
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr hq_norm_ne
  have hNq_pos : 0 < N_q := lt_of_lt_of_le zero_lt_one hNq_ge_one
  have hlog_Nq_nonneg : 0 ≤ Real.log N_q := Real.log_nonneg hNq_ge_one
  have hLq_ge_43 : 4 / 3 ≤ L_q := by dsimp [L_q]; linarith
  have hLq_gt_one : 1 < L_q := by linarith
  have hLq_pos : 0 < L_q := by linarith
  have hLq_inv_pos : 0 < L_q⁻¹ := inv_pos.mpr hLq_pos
  have hLq_inv_le_34 : L_q⁻¹ ≤ 3 / 4 := by
    have h1 := inv_anti₀ (by norm_num : (0 : ℝ) < 4 / 3) hLq_ge_43
    have h2 : ((4 / 3 : ℝ))⁻¹ = 3 / 4 := by norm_num
    rwa [h2] at h1
  have hLq_inv_le_one : L_q⁻¹ ≤ 1 := by linarith
  set u : ℝ := 1 + L_q⁻¹
  set M₁ : ℝ := K₁ * N_q ^ m
  set M₂ : ℝ := K₂ * L_q
  have hu_gt : 1 < u := by dsimp [u]; linarith
  have hu_le : u ≤ 2 := by dsimp [u]; linarith
  have hNqm_ge_one : 1 ≤ N_q ^ m := one_le_pow₀ hNq_ge_one
  have hNqm_pos : 0 < N_q ^ m := lt_of_lt_of_le zero_lt_one hNqm_ge_one
  have hM₁_ge_one : 1 ≤ M₁ := by dsimp [M₁]; nlinarith
  have hM₂_ge_one : 1 ≤ M₂ := by dsimp [M₂]; nlinarith
  have hg_strip : ∀ s : ℂ, 1 / 2 ≤ s.re → s.re ≤ 2 → ‖g_χ s‖ ≤ M₁ * (4 + |s.im|) ^ m := by
    intro s hs1 hs2
    calc ‖g_χ s‖
        ≤ A₁ * (N_q * (4 + |s.im|)) ^ m := hg_growth s hs1 hs2
      _ = (A₁ * N_q ^ m) * (4 + |s.im|) ^ m := by rw [mul_pow, mul_assoc]
      _ ≤ M₁ * (4 + |s.im|) ^ m := by
          dsimp [M₁]
          exact mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_right hA₁_le_K₁ (by positivity))
            (pow_nonneg (by linarith [abs_nonneg s.im]) m)
  have hg_right : ∀ s : ℂ, s.re = u → ‖g_χ s‖ ≤ M₂ := by
    intro s hs_re
    have hs_gt : 1 < s.re := by linarith
    rw [hg_eq s hs_gt]
    have h1 := h_s1_bound χ hχ_norm s u hu_gt hu_le (le_of_eq hs_re.symm)
    have h_div : C_ζ / (u - 1) = C_ζ * L_q := by
      dsimp [u]
      rw [add_sub_cancel_left, div_inv_eq_mul]
    rw [h_div] at h1
    exact le_trans h1 (mul_le_mul_of_nonneg_right hC_ζ_le_K₂ (le_of_lt hLq_pos))
  have hg_box : ∀ z : ℂ, 1 - (2 / 3) * L_q⁻¹ ≤ z.re → z.re ≤ 1 + L_q⁻¹ → |z.im| ≤ 1 →
      ‖g_χ z‖ ≤ B * L_q := by
    intro z hz1 hz2 hz_im
    have hz_half : 1 / 2 ≤ z.re := by linarith
    have h_had := h_s3 g_χ m u M₁ M₂ hu_gt hu_le hM₁_ge_one hM₂_ge_one
      hg_diff hg_strip hg_right z hz_half hz2 hz_im
    have h_exp_le : 2 * (u - z.re) ≤ 4 * L_q⁻¹ := by
      dsimp [u]
      linarith
    have h2mM₁_ge_one : 1 ≤ 2 ^ m * M₁ := by
      have : (1 : ℝ) ≤ (2 : ℝ) ^ m := one_le_pow₀ (by norm_num)
      nlinarith
    have h2mK₁_ge_one : 1 ≤ 2 ^ m * K₁ := by
      have : (1 : ℝ) ≤ (2 : ℝ) ^ m := one_le_pow₀ (by norm_num)
      nlinarith
    have h_rpow_step1 : (2 ^ m * M₁) ^ (2 * (u - z.re)) ≤ (2 ^ m * M₁) ^ (4 * L_q⁻¹) :=
      Real.rpow_le_rpow_of_exponent_le h2mM₁_ge_one h_exp_le
    have h_rpow_mul : (2 ^ m * M₁) ^ (4 * L_q⁻¹) =
        (2 ^ m * K₁) ^ (4 * L_q⁻¹) * (N_q ^ m) ^ (4 * L_q⁻¹) := by
      have h_eq : 2 ^ m * M₁ = (2 ^ m * K₁) * N_q ^ m := by dsimp [M₁]; ring
      rw [h_eq, Real.mul_rpow (by positivity) (by positivity)]
    have h_rpow_K₁ : (2 ^ m * K₁) ^ (4 * L_q⁻¹) ≤ (2 ^ m * K₁) ^ (4 : ℝ) :=
      Real.rpow_le_rpow_of_exponent_le h2mK₁_ge_one (by linarith)
    have h_rpow_Nq : (N_q ^ m) ^ (4 * L_q⁻¹) ≤ Real.exp (4 * (m : ℝ)) := by
      rw [Real.rpow_def_of_pos hNqm_pos, Real.log_pow, Real.exp_le_exp]
      have h_log_div : Real.log N_q * L_q⁻¹ ≤ 1 := by
        rw [← div_eq_mul_inv, div_le_one hLq_pos]
        dsimp [L_q]; linarith
      calc ((m : ℝ) * Real.log N_q) * (4 * L_q⁻¹)
          = (4 * (m : ℝ)) * (Real.log N_q * L_q⁻¹) := by ring
        _ ≤ (4 * (m : ℝ)) * 1 := mul_le_mul_of_nonneg_left h_log_div (by positivity)
        _ = 4 * (m : ℝ) := mul_one _
    have h_rpow_comb : (2 ^ m * M₁) ^ (2 * (u - z.re)) ≤
        (2 ^ m * K₁) ^ (4 : ℝ) * Real.exp (4 * (m : ℝ)) := by
      calc (2 ^ m * M₁) ^ (2 * (u - z.re))
          ≤ (2 ^ m * M₁) ^ (4 * L_q⁻¹) := h_rpow_step1
        _ = (2 ^ m * K₁) ^ (4 * L_q⁻¹) * (N_q ^ m) ^ (4 * L_q⁻¹) := h_rpow_mul
        _ ≤ (2 ^ m * K₁) ^ (4 : ℝ) * Real.exp (4 * (m : ℝ)) :=
          mul_le_mul h_rpow_K₁ h_rpow_Nq (by positivity) (by positivity)
    calc ‖g_χ z‖
        ≤ 10 ^ m * (2 ^ m * M₁) ^ (2 * (u - z.re)) * M₂ := h_had
      _ ≤ 10 ^ m * ((2 ^ m * K₁) ^ (4 : ℝ) * Real.exp (4 * (m : ℝ))) * M₂ := by
          apply mul_le_mul_of_nonneg_right
          · exact mul_le_mul_of_nonneg_left h_rpow_comb (by positivity)
          · positivity
      _ = B * L_q := by dsimp [B, M₂]; ring
  exact h_s4 g_χ L_q B hLq_ge_43 (le_of_lt hB_pos) hg_diff hg_box

theorem mitsui_ray_char_primePowers_two_factor_domination {K : Type u} [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K))
    (χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ I = 0))
    (hχ_real : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → (χ I) ^ 2 = 1) :
    ∃ Λ₂ : ℕ → ℝ,
      (∀ n : ℕ, 0 ≤ Λ₂ n) ∧
      (∀ s : ℂ, 1 < s.re →
        LSeriesSummable (fun n => (Λ₂ n : ℂ)) s ∧
        LSeries (fun n => (Λ₂ n : ℂ)) s =
          LSeries (fun n =>
            ((∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                  1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
                Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℝ) : ℂ)) s +
          LSeries (fun n =>
            ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                  1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
              (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
                (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)) s) ∧
      (∀ (σ M : ℝ), 1 < σ →
        (∀ N : ℕ, (∑ n ∈ Finset.Icc 1 N, Λ₂ n * (n : ℝ) ^ (-(1 / 2 : ℝ))) ≤ M) →
        (LSeries (fun n =>
          ((∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
              Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℝ) : ℂ)) (σ : ℂ)).re ≤ M) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let F : ℕ → Type u := fun d =>
    {pm : IsDedekindDomain.HeightOneSpectrum R × ℕ //
      1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = d}
  let Λ_K : ℕ → ℝ := fun n =>
    ∑' pm : F n, Real.log (Ideal.absNorm pm.1.1.asIdeal)
  let f₀ : ℕ → ℂ := fun n => (Λ_K n : ℂ)
  let Λ_χ : ℕ → ℂ := fun n =>
    ∑' pm : F n,
      (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
        (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)
  have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum R,
      2 ≤ Ideal.absNorm p.asIdeal := by
    intro p
    have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    omega
  have hF_fin : ∀ d : ℕ, Finite (F d) := by
    intro d
    let S_le := {J : Ideal R // Ideal.absNorm J ≤ d}
    haveI : Finite S_le := Ideal.finite_setOf_absNorm_le d
    have h_bounds : ∀ pm : F d, Ideal.absNorm pm.1.1.asIdeal ≤ d ∧ pm.1.2 < d + 1 := by
      intro pm
      have hm : 1 ≤ pm.1.2 := pm.2.1
      have hd : Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2 = d := pm.2.2
      have hk2 : 2 ≤ Ideal.absNorm pm.1.1.asIdeal := h_norm_ge_two pm.1.1
      have hk_pow : Ideal.absNorm pm.1.1.asIdeal ≤ Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2 :=
        Nat.le_self_pow (by omega) _
      have hk_le : Ideal.absNorm pm.1.1.asIdeal ≤ d := by omega
      have hm_lt : pm.1.2 < d + 1 := by
        have h1 : pm.1.2 < 2 ^ pm.1.2 := Nat.lt_two_pow_self
        have h2 : 2 ^ pm.1.2 ≤ Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2 := Nat.pow_le_pow_left hk2 _
        omega
      exact ⟨hk_le, hm_lt⟩
    let ψ : F d → S_le × Fin (d + 1) := fun pm =>
      (⟨pm.1.1.asIdeal, (h_bounds pm).1⟩, ⟨pm.1.2, (h_bounds pm).2⟩)
    have hψ_inj : Function.Injective ψ := by
      intro a b hab
      have h1 : a.1.1.asIdeal = b.1.1.asIdeal :=
        congrArg (fun x : S_le => x.1) (Prod.ext_iff.mp hab).1
      have h2 : a.1.2 = b.1.2 := congrArg Fin.val (Prod.ext_iff.mp hab).2
      exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext h1) h2)
    exact Finite.of_injective ψ hψ_inj
  letI : ∀ d, Fintype (F d) := fun d => Fintype.ofFinite (F d)
  have hΛ_nonneg : ∀ n : ℕ, 0 ≤ Λ_K n := by
    intro n
    dsimp [Λ_K]
    refine tsum_nonneg (fun pm => Real.log_nonneg ?_)
    have h2 := h_norm_ge_two pm.1.1
    exact_mod_cast (by omega : 1 ≤ Ideal.absNorm pm.1.1.asIdeal)
  have hχ_norm : ∀ I : nonZeroDivisors (Ideal R), ‖χ I‖ ≤ 1 := by
    intro I
    by_cases hI : (I : Ideal R) ⊔ q = ⊤
    · rw [(hχ_norm_supp I).1 hI]
    · rw [(hχ_norm_supp I).2 hI, norm_zero]
      exact zero_le_one
  have hχ_im : ∀ I : nonZeroDivisors (Ideal R), (χ I).im = 0 := by
    intro I
    by_cases hI : (I : Ideal R) ⊔ q = ⊤
    · rcases sq_eq_one_iff.mp (hχ_real I hI) with h | h <;> simp [h]
    · simp [(hχ_norm_supp I).2 hI]
  have hχ_eq_re : ∀ I : nonZeroDivisors (Ideal R), χ I = ((χ I).re : ℂ) := by
    intro I
    exact Complex.ext rfl (by simp [hχ_im I])
  have hχ_re_abs : ∀ I : nonZeroDivisors (Ideal R), |(χ I).re| ≤ 1 := by
    intro I
    exact le_trans (Complex.abs_re_le_norm (χ I)) (hχ_norm I)
  let Λ₂ : ℕ → ℝ := fun n => Λ_K n + (Λ_χ n).re
  let term₂ : ∀ {d : ℕ}, F d → ℝ := fun pm =>
    (1 + (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩).re ^ pm.1.2) *
      Real.log (Ideal.absNorm pm.1.1.asIdeal)
  have hΛ_χ_eq_re : ∀ n : ℕ,
      Λ_χ n = ((∑ pm : F n,
        (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩).re ^ pm.1.2 *
          Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℝ) : ℂ) := by
    intro n
    dsimp [Λ_χ]
    rw [tsum_fintype, Complex.ofReal_sum]
    refine Finset.sum_congr rfl (fun pm _ => ?_)
    set I_pm : nonZeroDivisors (Ideal R) :=
      ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩
    rw [Complex.ofReal_mul, Complex.ofReal_pow, ← hχ_eq_re I_pm]
  have hΛ_χ_re : ∀ n : ℕ,
      (Λ_χ n).re = ∑ pm : F n,
        (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩).re ^ pm.1.2 *
          Real.log (Ideal.absNorm pm.1.1.asIdeal) := by
    intro n
    rw [hΛ_χ_eq_re n, Complex.ofReal_re]
  have hΛ_χ_ofReal_re : ∀ n : ℕ, ((Λ_χ n).re : ℂ) = Λ_χ n := by
    intro n
    rw [hΛ_χ_re n, ← hΛ_χ_eq_re n]
  have hΛ₂_ofReal : ∀ n : ℕ, (Λ₂ n : ℂ) = f₀ n + Λ_χ n := by
    intro n
    dsimp [Λ₂, f₀]
    rw [Complex.ofReal_add, hΛ_χ_ofReal_re n]
  have hΛ₂_eq_sum : ∀ n : ℕ, Λ₂ n = ∑ pm : F n, term₂ pm := by
    intro n
    dsimp [Λ₂, Λ_K, term₂]
    rw [tsum_fintype, hΛ_χ_re n, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun pm _ => ?_)
    ring
  have h_term₂_nonneg : ∀ {d : ℕ} (pm : F d), 0 ≤ term₂ pm := by
    intro d pm
    dsimp [term₂]
    set I_pm : nonZeroDivisors (Ideal R) :=
      ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩
    have h_pow_abs : |(χ I_pm).re ^ pm.1.2| ≤ 1 := by
      rw [abs_pow]
      exact pow_le_one₀ (abs_nonneg _) (hχ_re_abs I_pm)
    have h_ge_neg_one : -1 ≤ (χ I_pm).re ^ pm.1.2 := neg_le_of_abs_le h_pow_abs
    have h1_nonneg : 0 ≤ 1 + (χ I_pm).re ^ pm.1.2 := by linarith
    have h2 := h_norm_ge_two pm.1.1
    have hlog_nonneg : 0 ≤ Real.log (Ideal.absNorm pm.1.1.asIdeal) :=
      Real.log_nonneg (by exact_mod_cast (by omega : 1 ≤ Ideal.absNorm pm.1.1.asIdeal))
    exact mul_nonneg h1_nonneg hlog_nonneg
  have hΛ₂_nonneg : ∀ n : ℕ, 0 ≤ Λ₂ n := by
    intro n
    rw [hΛ₂_eq_sum n]
    exact Finset.sum_nonneg (fun pm _ => h_term₂_nonneg pm)
  have h_ideal_card : ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ x : ℝ, 1 ≤ x →
      (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ * x := by
    set L_K : ℝ :=
      2 ^ NumberField.InfinitePlace.nrRealPlaces K *
        (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
        NumberField.Units.regulator K *
        (NumberField.classNumber K : ℝ) /
        ((NumberField.Units.torsionOrder K : ℝ) * Real.sqrt |(NumberField.discr K : ℝ)|)
    have h_tendsto : Filter.Tendsto
        (fun x : ℝ => (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x)
        Filter.atTop (nhds L_K) :=
      NumberField.Ideal.tendsto_norm_le_div_atTop K
    obtain ⟨S₀, hS₀⟩ := (Metric.tendsto_atTop.mp h_tendsto) 1 zero_lt_one
    let S₁ : ℝ := max S₀ 1
    let N₁ : ℕ := Nat.card {J : Ideal R // Ideal.absNorm J ≤ ⌊S₁⌋₊}
    let C₁ : ℝ := max (|L_K| + 1) ((N₁ : ℝ) + 1)
    have hC₁_pos : 0 < C₁ := by
      have h1 : 0 ≤ |L_K| := abs_nonneg L_K
      have h2 : |L_K| + 1 ≤ C₁ := le_max_left _ _
      linarith
    refine ⟨C₁, hC₁_pos, ?_⟩
    intro x hx
