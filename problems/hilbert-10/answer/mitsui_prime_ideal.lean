      ((A_collar + ε_tail) + C_grid * δ * (Real.log X + 1) ^ (NumberField.Units.rank K)) * Ψ₁_K :=
    mul_le_mul_of_nonneg_right h_c0_sub_vol hΨ₁_K_nonneg
  have h_sum_le :
      (Real.exp 1 * (C_coeff * (2 * (3 : ℝ) ^ (NumberField.Units.rank K) * c_base))) *
        Y₀ * Real.exp (-t / c_coord) +
      (Real.exp 1 * ((6 * C_coeff + C_gcoeff) * (1 + c_base))) * Y₀ * Real.exp (-t / c_coord) +
      (Real.exp 1 * (C_vcoeff * c_base)) * Y₀ * Real.exp (-t / c_coord) ≤
