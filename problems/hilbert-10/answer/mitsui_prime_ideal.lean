                (∑ l_ang ∈ S_ang_M,
                  if l_ang = 0 then
                    (A_phase : ℂ) *
                      ((∏ w : NumberField.InfinitePlace K,
                          (w.embedding (((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
                            τ w) ^ (l_ang w)) *
                        Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v j))
