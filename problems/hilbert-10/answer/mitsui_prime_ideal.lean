theorem mitsui_conical_sector_log_cell_main_term_sum_bound {K : Type u} [Field K] [NumberField K] :
    ∃ c_sum : ℝ, 0 < c_sum ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m →
          ∀ R₁ : ℝ, 1 < R₁ → R₁ ≤ X →
            ∀ k : NumberField.mixedEmbedding.index K → Fin (2 * m),
              ∀ w₀ : NumberField.InfinitePlace K,
