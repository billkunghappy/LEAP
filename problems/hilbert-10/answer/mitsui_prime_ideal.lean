            · exact Or.inl ⟨Or.inl ⟨by linarith, by linarith⟩, hy_Icc⟩
        dsimp [D_col]
        rw [h_r_sq]
        exact ⟨h_strip, h_sq_lo, h_sq_hi⟩
      have h_pt_le1 : A_cyl.indicator (fun q : ℝ × ℝ => ENNReal.ofReal q.1) ≤
