      have hc_ne : c ≠ 0 := ne_of_gt hc_pos
      field_simp [hr1_ne, hc_ne]
    linarith
  have hlog1_pow_le : (Real.log X + 1) ^ r ≤ K₀ ^ r * Real.exp (t / (4 * c)) := by
    calc (Real.log X + 1) ^ r
      _ ≤ (K₀ * Real.exp (c' * t)) ^ r :=
        pow_le_pow_left₀ (by positivity) hlog1_le_K₀ r
      _ = K₀ ^ r * (Real.exp (c' * t)) ^ r := mul_pow _ _ _
      _ = K₀ ^ r * Real.exp ((r : ℝ) * (c' * t)) := by rw [← Real.exp_nat_mul]
      _ ≤ K₀ ^ r * Real.exp (t / (4 * c)) :=
        mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hexp_r_le) (by positivity)
  have hB_le : B ≤ c_gen * (K₀ ^ r * Real.exp (t / (4 * c))) :=
    mul_le_mul_of_nonneg_left hlog1_pow_le (le_of_lt hc_gen_pos)
  have hexp_combine : Real.exp (t / (4 * c)) * δ = Real.exp (-t / (4 * c)) := by
    dsimp [δ]
    rw [← Real.exp_add]
    congr 1
    have hc_ne : c ≠ 0 := ne_of_gt hc_pos
    field_simp [hc_ne]
    ring
  have h_BC_bound : B * C_diff * Y₀ * δ ≤ A_diff * Y₀ * Real.exp (-t / (4 * c)) := by
    calc B * C_diff * Y₀ * δ
      _ ≤ (c_gen * (K₀ ^ r * Real.exp (t / (4 * c)))) * C_diff * Y₀ * δ := by
        have : 0 ≤ C_diff * Y₀ * δ := by positivity
        calc B * C_diff * Y₀ * δ = B * (C_diff * Y₀ * δ) := by ring
          _ ≤ (c_gen * (K₀ ^ r * Real.exp (t / (4 * c)))) * (C_diff * Y₀ * δ) :=
            mul_le_mul_of_nonneg_right hB_le this
          _ = (c_gen * (K₀ ^ r * Real.exp (t / (4 * c)))) * C_diff * Y₀ * δ := by ring
      _ = A_diff * Y₀ * (Real.exp (t / (4 * c)) * δ) := by
        dsimp [A_diff]; ring
      _ = A_diff * Y₀ * Real.exp (-t / (4 * c)) := by rw [hexp_combine]
  have h4c_pos : 0 < 4 * c := by positivity
  have h2c_pos : 0 < 2 * c := by positivity
  have h4c_le : 4 * c ≤ c_pp := by dsimp [c_pp]; linarith
  have h2c_le_4c : 2 * c ≤ 4 * c := by linarith
  have hδ_le_4c : δ ≤ Real.exp (-t / (4 * c)) := by
    dsimp [δ]
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg h2c_pos h2c_le_4c
  have h_2c_bound : 2 * c * Y₀ * δ ≤ 2 * c * Y₀ * Real.exp (-t / (4 * c)) :=
    mul_le_mul_of_nonneg_left hδ_le_4c (by positivity)
  have h_ψ_cell_bound : ‖ψ_cell Y‖ ≤ (2 * c + A_diff) * Y₀ * Real.exp (-t / (4 * c)) := by
    linarith
  have hexp_4c_le : Real.exp (-t / (4 * c)) ≤ Real.exp (-t / c_pp) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg h4c_pos h4c_le
  have h_coeff : 2 * c + A_diff ≤ c_pp := by dsimp [c_pp]; linarith
  change ‖ψ_box Y‖ ≤ c_pp * Y₀ * Real.exp (-t / c_pp)
  rw [hψ_box_eq Y]
  calc ‖ψ_cell Y‖
    _ ≤ (2 * c + A_diff) * Y₀ * Real.exp (-t / (4 * c)) := h_ψ_cell_bound
    _ ≤ (2 * c + A_diff) * Y₀ * Real.exp (-t / c_pp) :=
      mul_le_mul_of_nonneg_left hexp_4c_le (by positivity)
    _ = (2 * c + A_diff) * (Y₀ * Real.exp (-t / c_pp)) := by ring
    _ ≤ c_pp * (Y₀ * Real.exp (-t / c_pp)) :=
      mul_le_mul_of_nonneg_right h_coeff (by positivity)
    _ = c_pp * Y₀ * Real.exp (-t / c_pp) := by ring

theorem mitsui_prime_char_decoupled_log_box_bound_of_fundSystem_ne_one {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c_cell : ℝ, 0 < c_cell ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m →
          ∀ w₀ : NumberField.InfinitePlace K,
            ∀ k : NumberField.InfinitePlace K → Fin m,
              ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
                (Ideal.absNorm q : ℝ) < Real.log X ^ A →
                ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
                  (∀ u ∈ NumberField.Units.torsion K,
                    ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) →
                  (∃ j₀ : Fin (NumberField.Units.rank K),
                    ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom
                      (NumberField.Units.fundSystem K j₀))) ≠ 1) →
                  ‖∑' π : {π : NumberField.RingOfIntegers K //
                        Prime π ∧
                        ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) ≤
                          X ^ (Module.finrank ℚ K) *
                            Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
                              (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))) ∧
                        (∀ w : NumberField.InfinitePlace K,
                          Real.log (w (π : K) / w₀ (π : K)) ∈
                            Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                              (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))) ∧
                        IsUnit (Ideal.Quotient.mk q π)},
                      ψ (Additive.ofMul π.2.2.2.2.unit) *
                        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)‖
                    ≤ c_cell * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cell) :=
by
  obtain ⟨c_hpp, hc_hpp_pos, hc_hpp⟩ := mitsui_higher_primePower_log_sector_bound (K := K)
  obtain ⟨c_pp, hc_pp_pos, hc_pp⟩ :=
    mitsui_primePower_char_decoupled_log_box_bound_of_fundSystem_ne_one (K := K) A hA
  let c_cell : ℝ := c_hpp + c_pp
  have hc_cell_pos : 0 < c_cell := by dsimp [c_cell]; positivity
  refine ⟨c_cell, hc_cell_pos, ?_⟩
  intro X hX m hm w₀ k q hq hq_norm ψ hψ hψ_tors hψ_fund
  obtain ⟨j₀, hj₀⟩ := hψ_fund
  set Y₀ : ℝ := X ^ (Module.finrank ℚ K)
  have hX_pos : (0 : ℝ) < X := by linarith
  have hY₀_pos : 0 < Y₀ := by dsimp [Y₀]; positivity
  have hlog_pos : 0 < Real.log X := Real.log_pos hX
  have hm_rpos : (0 : ℝ) < (m : ℝ) := Nat.cast_pos.mpr hm
  by_cases hk₀ : (k w₀ : ℕ) + 1 = m
  · set Y : ℝ := Y₀ * Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))
    have h_sum_nonpos : (∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))) ≤ 0 := by
      refine Finset.sum_nonpos (fun w _ => ?_)
      have hkw_lt : (k w : ℕ) < m := (k w).isLt
      have hkw_le : (k w : ℕ) + 1 ≤ m := hkw_lt
      have hkw_rle : ((k w : ℕ) : ℝ) + 1 ≤ (m : ℝ) := by exact_mod_cast hkw_le
      have hnum_nonpos : ((k w : ℕ) : ℝ) + 1 - (m : ℝ) ≤ 0 := by linarith
      have hdiv_nonpos : (((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ) ≤ 0 :=
        div_nonpos_of_nonpos_of_nonneg hnum_nonpos (le_of_lt hm_rpos)
      have hmult_nonneg : (0 : ℝ) ≤ (w.mult : ℝ) := Nat.cast_nonneg w.mult
      exact mul_nonpos_of_nonneg_of_nonpos hmult_nonneg hdiv_nonpos
    have hexp_arg_nonpos :
        Real.log X * (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos (le_of_lt hlog_pos) h_sum_nonpos
    have hexp_le_one :
        Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))) ≤ 1 :=
      Real.exp_le_one_iff.mpr hexp_arg_nonpos
    have hY : Y ≤ Y₀ := by
      dsimp [Y]
      exact mul_le_of_le_one_right (le_of_lt hY₀_pos) hexp_le_one
    set S_prime : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) ≤ Y ∧
          (∀ w : NumberField.InfinitePlace K,
            Real.log (w (π : K) / w₀ (π : K)) ∈
              Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))) ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
    set S_pp : ℂ := ∑' xpm : {xpm : NumberField.RingOfIntegers K ×
            IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          1 ≤ xpm.2.2 ∧
          Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
          (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Y ∧
          (∀ w : NumberField.InfinitePlace K,
            Real.log (w (xpm.1 : K) / w₀ (xpm.1 : K)) ∈
              Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))) ∧
          IsUnit (Ideal.Quotient.mk q xpm.1)},
        ψ (Additive.ofMul xpm.2.2.2.2.2.unit) *
          (Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) : ℂ)
    set S_high : ℝ := ∑' xpm : {xpm : NumberField.RingOfIntegers K ×
            IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          2 ≤ xpm.2.2 ∧
          Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
          (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Y₀ ∧
          ∀ w : NumberField.InfinitePlace K,
            Real.log (w (xpm.1 : K) / w₀ (xpm.1 : K)) ∈ Set.Ioc (-Real.log X) 0},
        Real.log (Ideal.absNorm xpm.1.2.1.asIdeal)
    have h_tri : ‖S_prime‖ ≤ ‖S_prime - S_pp‖ + ‖S_pp‖ := norm_le_norm_sub_add S_prime S_pp
    have h_sub : ‖S_prime - S_pp‖ ≤ S_high :=
      mitsui_prime_char_decoupled_log_box_sub_primePower_le X hX m hm w₀ k Y hY q hq ψ
    have h_high : S_high ≤ c_hpp * Y₀ * Real.exp (-Real.sqrt (Real.log X) / c_hpp) :=
      hc_hpp X hX w₀
    have h_pp : ‖S_pp‖ ≤ c_pp * Y₀ * Real.exp (-Real.sqrt (Real.log X) / c_pp) :=
      hc_pp X hX m hm w₀ k hk₀ q hq hq_norm ψ hψ hψ_tors j₀ hj₀
    set t : ℝ := Real.sqrt (Real.log X)
    have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg _
    have hc_hpp_le : c_hpp ≤ c_cell := by dsimp [c_cell]; linarith
    have hc_pp_le : c_pp ≤ c_cell := by dsimp [c_cell]; linarith
    have hexp_hpp : Real.exp (-t / c_hpp) ≤ Real.exp (-t / c_cell) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left ht_nonneg hc_hpp_pos hc_hpp_le
    have hexp_pp : Real.exp (-t / c_pp) ≤ Real.exp (-t / c_cell) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left ht_nonneg hc_pp_pos hc_pp_le
    have hterm_hpp : c_hpp * Y₀ * Real.exp (-t / c_hpp) ≤ c_hpp * Y₀ * Real.exp (-t / c_cell) :=
      mul_le_mul_of_nonneg_left hexp_hpp (by positivity)
    have hterm_pp : c_pp * Y₀ * Real.exp (-t / c_pp) ≤ c_pp * Y₀ * Real.exp (-t / c_cell) :=
      mul_le_mul_of_nonneg_left hexp_pp (by positivity)
    have h_sum_eq :
        c_hpp * Y₀ * Real.exp (-t / c_cell) + c_pp * Y₀ * Real.exp (-t / c_cell) =
        c_cell * Y₀ * Real.exp (-t / c_cell) := by
      dsimp [c_cell]; ring
    change ‖S_prime‖ ≤ c_cell * Y₀ * Real.exp (-t / c_cell)
    linarith
  · let D_cell := {π : NumberField.RingOfIntegers K //
        Prime π ∧
        ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) ≤
          X ^ (Module.finrank ℚ K) *
            Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
              (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))) ∧
        (∀ w : NumberField.InfinitePlace K,
          Real.log (w (π : K) / w₀ (π : K)) ∈
            Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
              (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))) ∧
        IsUnit (Ideal.Quotient.mk q π)}
    haveI : IsEmpty D_cell := by
      refine ⟨fun π => ?_⟩
      have hπ_ne : (π.1 : NumberField.RingOfIntegers K) ≠ 0 := π.2.1.ne_zero
      have hπK_ne : ((π.1 : NumberField.RingOfIntegers K) : K) ≠ 0 :=
        NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hπ_ne
      have hw₀_pos : 0 < w₀ (π.1 : K) := w₀.pos_iff.mpr hπK_ne
      have h_div : w₀ (π.1 : K) / w₀ (π.1 : K) = 1 := div_self (ne_of_gt hw₀_pos)
      have h_log : Real.log (w₀ (π.1 : K) / w₀ (π.1 : K)) = 0 := by
        rw [h_div, Real.log_one]
      have h_mem := (π.2.2.2.1 w₀).2
      rw [h_log] at h_mem
      have hkw₀_lt : (k w₀ : ℕ) < m := (k w₀).isLt
      have hkw₀_lt' : (k w₀ : ℕ) + 1 < m := by omega
      have hkw₀_rlt : ((k w₀ : ℕ) : ℝ) + 1 < (m : ℝ) := by exact_mod_cast hkw₀_lt'
      have hnum_neg : ((k w₀ : ℕ) : ℝ) + 1 - (m : ℝ) < 0 := by linarith
      have hdiv_neg : (((k w₀ : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ) < 0 :=
        div_neg_of_neg_of_pos hnum_neg hm_rpos
      have hrhs_neg : Real.log X * ((((k w₀ : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)) < 0 :=
        mul_neg_of_pos_of_neg hlog_pos hdiv_neg
      linarith
    have h_tsum_zero : (∑' π : D_cell,
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) = 0 :=
      tsum_empty
    change ‖∑' π : D_cell,
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)‖ ≤ _
    rw [h_tsum_zero, norm_zero]
    positivity

theorem mitsui_prime_char_place_sector_bound_of_torsion_eq_one_of_units_ne_one {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c₃ : ℝ, 0 < c₃ ∧
      ∀ X : ℝ, 1 < X →
        ∀ w₀ : NumberField.InfinitePlace K,
          ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
            (Ideal.absNorm q : ℝ) < Real.log X ^ A →
            ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
              (∀ u ∈ NumberField.Units.torsion K,
                ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) →
              (∃ u : (NumberField.RingOfIntegers K)ˣ,
                ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) ≠ 1) →
              ‖∑' π : {π : NumberField.RingOfIntegers K //
                    Prime π ∧
                    (∀ w : NumberField.InfinitePlace K,
                      1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
                    w₀ (π : K) < X ∧
                    IsUnit (Ideal.Quotient.mk q π)},
                  ψ (Additive.ofMul π.2.2.2.2.unit) *
                    (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)‖
                ≤ c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃) :=
by
  classical
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_prime_box_to_ge_one (K := K)
  obtain ⟨c_shell, hc_shell_pos, hc_shell⟩ := mitsui_prime_box_shell_diff_bound (K := K)
  obtain ⟨c_cell, hc_cell_pos, hc_cell⟩ :=
    mitsui_prime_char_decoupled_log_box_bound_of_fundSystem_ne_one (K := K) A hA
  set M : ℕ := Fintype.card (NumberField.InfinitePlace K)
  have hM_pos : 0 < M := Fintype.card_pos
  have hM_rpos : (0 : ℝ) < (M : ℝ) := Nat.cast_pos.mpr hM_pos
  set c' : ℝ := 1 / (4 * (M : ℝ) * c_cell)
  have hc'_pos : 0 < c' := by dsimp [c']; positivity
  set K₀ : ℝ := 16 / c' ^ 2 + 1
  have hK₀_pos : 0 < K₀ := by dsimp [K₀]; positivity
  set A_cell : ℝ := K₀ ^ (2 * M) * c_cell
  have hA_cell_pos : 0 < A_cell := by dsimp [A_cell]; positivity
  let c₃ : ℝ := c₁ + 3 * c_shell + A_cell + 1 / c' + 2 * c_cell
  have hc₃_pos : 0 < c₃ := by dsimp [c₃]; positivity
  refine ⟨c₃, hc₃_pos, ?_⟩
  intro X hX w₀ q hq hq_norm ψ hψ hψ_tors hψ_units
  have hψ_fund := mitsui_exists_fundSystem_char_ne_one q ψ hψ_tors hψ_units
  set Y : ℝ := X ^ (Module.finrank ℚ K)
  have hX_pos : (0 : ℝ) < X := by linarith
  have hY_nonneg : 0 ≤ Y := by dsimp [Y]; positivity
  have hlog_pos : 0 < Real.log X := Real.log_pos hX
  set t : ℝ := Real.sqrt (Real.log X)
  have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg _
  have ht_sq : t ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlog_pos)
  set z : ℝ := (Real.log X + 1) ^ 2 * Real.exp (c' * t)
  set m : ℕ := ⌊z⌋₊
  have hexp_ge_one : 1 ≤ Real.exp (c' * t) := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by positivity)
  have hlog1_le_sq : Real.log X + 1 ≤ (Real.log X + 1) ^ 2 := by nlinarith
  have hz_ge : Real.log X + 1 ≤ z := by
    dsimp [z]
    calc Real.log X + 1
      _ = (Real.log X + 1) * 1 := (mul_one _).symm
      _ ≤ (Real.log X + 1) ^ 2 * Real.exp (c' * t) :=
        mul_le_mul hlog1_le_sq hexp_ge_one zero_le_one (by positivity)
  have hz_lt : z < (m : ℝ) + 1 := Nat.lt_floor_add_one z
  have hlog_lt_m : Real.log X < (m : ℝ) := by linarith
  have hm_log : Real.log X ≤ (m : ℝ) := le_of_lt hlog_lt_m
  have hm_rpos : (0 : ℝ) < (m : ℝ) := lt_trans hlog_pos hlog_lt_m
  have hm_pos : 0 < m := Nat.cast_pos.mp hm_rpos
  have hm : 1 ≤ m := hm_pos
  have hm_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  have hz_le_2m : z ≤ 2 * (m : ℝ) := by linarith
  have h_ratio : (Real.log X + 1) ^ 2 / (m : ℝ) ≤ 2 * Real.exp (-c' * t) := by
    rw [div_le_iff₀ hm_rpos]
    calc (Real.log X + 1) ^ 2
      _ = z * Real.exp (-c' * t) := by
        dsimp [z]
        rw [mul_assoc, ← Real.exp_add]
        have h0 : c' * t + -c' * t = 0 := by ring
        rw [h0, Real.exp_zero, mul_one]
      _ ≤ (2 * (m : ℝ)) * Real.exp (-c' * t) :=
        mul_le_mul_of_nonneg_right hz_le_2m (by positivity)
      _ = 2 * Real.exp (-c' * t) * (m : ℝ) := by ring
  have hm_le_z : (m : ℝ) ≤ z := Nat.floor_le (by dsimp [z]; positivity)
  have hu_exp : c' * t / 4 + 1 ≤ Real.exp (c' * t / 4) := Real.add_one_le_exp (c' * t / 4)
  have hu_sq : (c' * t / 4) ^ 2 ≤ Real.exp (c' * t / 2) := by
    have h1 : c' * t / 4 ≤ c' * t / 4 + 1 := by linarith
    have h2 : c' * t / 4 ≤ Real.exp (c' * t / 4) := le_trans h1 hu_exp
    calc (c' * t / 4) ^ 2
      _ = (c' * t / 4) * (c' * t / 4) := sq _
      _ ≤ Real.exp (c' * t / 4) * Real.exp (c' * t / 4) :=
        mul_le_mul h2 h2 (by positivity) (by positivity)
      _ = Real.exp (c' * t / 2) := by
        rw [← Real.exp_add]
        ring_nf
  have hlog_le_exp : Real.log X ≤ (16 / c' ^ 2) * Real.exp (c' * t / 2) := by
    have h1 : (c' ^ 2 / 16) * Real.log X = (c' * t / 4) ^ 2 := by
      rw [← ht_sq]
      ring
    rw [div_mul_eq_mul_div, le_div_iff₀ (by positivity)]
    linarith
  have hexp_half_ge_one : 1 ≤ Real.exp (c' * t / 2) := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by positivity)
  have hlog1_le_K₀ : Real.log X + 1 ≤ K₀ * Real.exp (c' * t / 2) := by
    dsimp [K₀]
    linarith
  have hlog1_sq_le : (Real.log X + 1) ^ 2 ≤ K₀ ^ 2 * Real.exp (c' * t) := by
    calc (Real.log X + 1) ^ 2
      _ = (Real.log X + 1) * (Real.log X + 1) := sq _
      _ ≤ (K₀ * Real.exp (c' * t / 2)) * (K₀ * Real.exp (c' * t / 2)) :=
        mul_le_mul hlog1_le_K₀ hlog1_le_K₀ (by positivity) (by positivity)
      _ = K₀ ^ 2 * (Real.exp (c' * t / 2) * Real.exp (c' * t / 2)) := by ring
      _ = K₀ ^ 2 * Real.exp (c' * t) := by
        rw [← Real.exp_add]
        ring_nf
  have hm_le_K₀ : (m : ℝ) ≤ K₀ ^ 2 * Real.exp (2 * c' * t) := by
    calc (m : ℝ)
      _ ≤ z := hm_le_z
      _ = (Real.log X + 1) ^ 2 * Real.exp (c' * t) := rfl
      _ ≤ (K₀ ^ 2 * Real.exp (c' * t)) * Real.exp (c' * t) :=
        mul_le_mul_of_nonneg_right hlog1_sq_le (by positivity)
      _ = K₀ ^ 2 * (Real.exp (c' * t) * Real.exp (c' * t)) := by ring
      _ = K₀ ^ 2 * Real.exp (2 * c' * t) := by
        rw [← Real.exp_add]
        ring_nf
  have hexp_M_eq : (M : ℝ) * (2 * c' * t) = t / (2 * c_cell) := by
    dsimp [c']
    have hM_ne : (M : ℝ) ≠ 0 := ne_of_gt hM_rpos
    have hc_ne : c_cell ≠ 0 := ne_of_gt hc_cell_pos
    field_simp [hM_ne, hc_ne]
    ring
  have hm_pow_le : (m : ℝ) ^ M ≤ K₀ ^ (2 * M) * Real.exp (t / (2 * c_cell)) := by
    calc (m : ℝ) ^ M
      _ ≤ (K₀ ^ 2 * Real.exp (2 * c' * t)) ^ M :=
        pow_le_pow_left₀ (by positivity) hm_le_K₀ M
      _ = K₀ ^ (2 * M) * (Real.exp (2 * c' * t)) ^ M := by
        rw [mul_pow, ← pow_mul]
      _ = K₀ ^ (2 * M) * Real.exp ((M : ℝ) * (2 * c' * t)) := by
        rw [← Real.exp_nat_mul]
      _ = K₀ ^ (2 * M) * Real.exp (t / (2 * c_cell)) := by
        rw [hexp_M_eq]
  set S_sec : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
        Prime π ∧
        (∀ w : NumberField.InfinitePlace K,
          1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
        w₀ (π : K) < X ∧
        IsUnit (Ideal.Quotient.mk q π)},
      ψ (Additive.ofMul π.2.2.2.2.unit) *
        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  let S_cell : (NumberField.InfinitePlace K → Fin m) → ℂ := fun k =>
    ∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) ≤
            X ^ (Module.finrank ℚ K) *
              Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))) ∧
          (∀ w : NumberField.InfinitePlace K,
            Real.log (w (π : K) / w₀ (π : K)) ∈
              Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))) ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S_sum : ℂ := ∑' k : NumberField.InfinitePlace K → Fin m, S_cell k
  have h_sub_diff := mitsui_prime_char_place_sector_sub_box_diff_le X hX m hm w₀ q hq ψ
  have h_ge_one := hc₁ X hX
  have h_shell := hc_shell X hX m hm hm_log
  have h_shell_le :
      c_shell * Y * ((Real.log X + 1) ^ 2 / (m : ℝ)) + c_shell * Y * Real.exp (-t / c_shell) ≤
      2 * c_shell * Y * Real.exp (-c' * t) + c_shell * Y * Real.exp (-t / c_shell) := by
    have h1 : c_shell * Y * ((Real.log X + 1) ^ 2 / (m : ℝ)) ≤
        c_shell * Y * (2 * Real.exp (-c' * t)) :=
      mul_le_mul_of_nonneg_left h_ratio (by positivity)
    linarith
  have h_diff_bound : ‖S_sec - S_sum‖ ≤
      c₁ * Y * Real.exp (-t / c₁) +
      2 * c_shell * Y * Real.exp (-c' * t) +
      c_shell * Y * Real.exp (-t / c_shell) := by
    change ‖S_sec - S_sum‖ ≤ _ at h_sub_diff
    linarith
  have h_cell_each : ∀ k : NumberField.InfinitePlace K → Fin m,
      ‖S_cell k‖ ≤ c_cell * Y * Real.exp (-t / c_cell) :=
    fun k => hc_cell X hX m hm w₀ k q hq hq_norm ψ hψ hψ_tors hψ_fund
  have h_sum_fintype : S_sum = ∑ k : NumberField.InfinitePlace K → Fin m, S_cell k :=
    tsum_fintype S_cell
  have h_sum_norm_le : ‖S_sum‖ ≤
      (m : ℝ) ^ M * (c_cell * Y * Real.exp (-t / c_cell)) := by
    rw [h_sum_fintype]
    calc ‖∑ k : NumberField.InfinitePlace K → Fin m, S_cell k‖
      _ ≤ ∑ k : NumberField.InfinitePlace K → Fin m, ‖S_cell k‖ :=
          norm_sum_le _ _
      _ ≤ ∑ _k : NumberField.InfinitePlace K → Fin m,
            (c_cell * Y * Real.exp (-t / c_cell)) :=
          Finset.sum_le_sum (fun k _ => h_cell_each k)
      _ = (m : ℝ) ^ M * (c_cell * Y * Real.exp (-t / c_cell)) := by
          simp [M, Finset.sum_const, nsmul_eq_mul, Fintype.card_fin]
  have h_sum_bound : ‖S_sum‖ ≤ A_cell * Y * Real.exp (-t / (2 * c_cell)) := by
    calc ‖S_sum‖
      _ ≤ (m : ℝ) ^ M * (c_cell * Y * Real.exp (-t / c_cell)) := h_sum_norm_le
      _ ≤ (K₀ ^ (2 * M) * Real.exp (t / (2 * c_cell))) *
            (c_cell * Y * Real.exp (-t / c_cell)) :=
          mul_le_mul_of_nonneg_right hm_pow_le (by positivity)
      _ = A_cell * Y * (Real.exp (t / (2 * c_cell)) * Real.exp (-t / c_cell)) := by
          dsimp [A_cell]; ring
      _ = A_cell * Y * Real.exp (-t / (2 * c_cell)) := by
          rw [← Real.exp_add]
          congr 2
          ring
  have h_ident : S_sec = (S_sec - S_sum) + S_sum := by ring
  have h_tri : ‖S_sec‖ ≤ ‖S_sec - S_sum‖ + ‖S_sum‖ := by
    rw [congrArg norm h_ident]
    exact norm_add_le (S_sec - S_sum) S_sum
  have hc₁_le : c₁ ≤ c₃ := by
    have : 0 ≤ 3 * c_shell + A_cell + 1 / c' + 2 * c_cell := by positivity
    dsimp [c₃]; linarith
  have hc'_inv_le : 1 / c' ≤ c₃ := by
    have : 0 ≤ c₁ + 3 * c_shell + A_cell + 2 * c_cell := by positivity
    dsimp [c₃]; linarith
  have hc_shell_le : c_shell ≤ c₃ := by
    have : 0 ≤ c₁ + 2 * c_shell + A_cell + 1 / c' + 2 * c_cell := by positivity
    dsimp [c₃]; linarith
  have h2c_cell_le : 2 * c_cell ≤ c₃ := by
    have : 0 ≤ c₁ + 3 * c_shell + A_cell + 1 / c' := by positivity
    dsimp [c₃]; linarith
  have hexp₁ : Real.exp (-t / c₁) ≤ Real.exp (-t / c₃) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg hc₁_pos hc₁_le
  have hexp_c' : Real.exp (-c' * t) ≤ Real.exp (-t / c₃) := by
    have h_eq : -c' * t = -t / (1 / c') := by
      have hc'_ne : c' ≠ 0 := ne_of_gt hc'_pos
      field_simp [hc'_ne]
    rw [h_eq, Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg (by positivity) hc'_inv_le
  have hexp_shell : Real.exp (-t / c_shell) ≤ Real.exp (-t / c₃) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg hc_shell_pos hc_shell_le
  have hexp_cell : Real.exp (-t / (2 * c_cell)) ≤ Real.exp (-t / c₃) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg (by positivity) h2c_cell_le
  have hterm₁ : c₁ * Y * Real.exp (-t / c₁) ≤ c₁ * Y * Real.exp (-t / c₃) :=
    mul_le_mul_of_nonneg_left hexp₁ (by positivity)
  have hterm₂ : 2 * c_shell * Y * Real.exp (-c' * t) ≤ 2 * c_shell * Y * Real.exp (-t / c₃) :=
    mul_le_mul_of_nonneg_left hexp_c' (by positivity)
  have hterm₃ : c_shell * Y * Real.exp (-t / c_shell) ≤ c_shell * Y * Real.exp (-t / c₃) :=
    mul_le_mul_of_nonneg_left hexp_shell (by positivity)
  have hterm₄ : A_cell * Y * Real.exp (-t / (2 * c_cell)) ≤ A_cell * Y * Real.exp (-t / c₃) :=
    mul_le_mul_of_nonneg_left hexp_cell (by positivity)
  have h_sum_all_le :
      c₁ * Y * Real.exp (-t / c₃) +
      2 * c_shell * Y * Real.exp (-t / c₃) +
      c_shell * Y * Real.exp (-t / c₃) +
      A_cell * Y * Real.exp (-t / c₃) ≤
      c₃ * Y * Real.exp (-t / c₃) := by
    have h_coeff : c₁ + 2 * c_shell + c_shell + A_cell ≤ c₃ := by
      have : 0 ≤ 1 / c' + 2 * c_cell := by positivity
      dsimp [c₃]; linarith
    have hYE_nonneg : 0 ≤ Y * Real.exp (-t / c₃) := by positivity
    calc c₁ * Y * Real.exp (-t / c₃) +
        2 * c_shell * Y * Real.exp (-t / c₃) +
        c_shell * Y * Real.exp (-t / c₃) +
        A_cell * Y * Real.exp (-t / c₃)
      _ = (c₁ + 2 * c_shell + c_shell + A_cell) * (Y * Real.exp (-t / c₃)) := by ring
      _ ≤ c₃ * (Y * Real.exp (-t / c₃)) := mul_le_mul_of_nonneg_right h_coeff hYE_nonneg
      _ = c₃ * Y * Real.exp (-t / c₃) := by ring
  linarith

theorem mitsui_prime_char_box_bound_of_torsion_eq_one_of_units_ne_one {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c₂ : ℝ, 0 < c₂ ∧
      ∀ X : ℝ, 1 < X →
        ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
          (Ideal.absNorm q : ℝ) < Real.log X ^ A →
          ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
            (∀ u ∈ NumberField.Units.torsion K,
              ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) →
            (∃ u : (NumberField.RingOfIntegers K)ˣ,
              ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) ≠ 1) →
            ‖∑' π : {π : NumberField.RingOfIntegers K //
                  Prime π ∧
                  (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
                  IsUnit (Ideal.Quotient.mk q π)},
                ψ (Additive.ofMul π.2.2.2.unit) *
                  (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)‖
              ≤ c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
by
  obtain ⟨c₁₀, hc₁₀_pos, hc₁₀⟩ := mitsui_prime_box_to_ge_one (K := K)
  obtain ⟨c₂₀, hc₂₀_pos, hc₂₀⟩ := mitsui_prime_box_ge_one_to_place_sectors (K := K)
  obtain ⟨c₃₀, hc₃₀_pos, hc₃₀⟩ :=
    mitsui_prime_char_place_sector_bound_of_torsion_eq_one_of_units_ne_one (K := K) A hA
  set M_card : ℝ := (Fintype.card (NumberField.InfinitePlace K) : ℝ)
  have hM_nonneg : 0 ≤ M_card := by dsimp [M_card]; positivity
  let c₂ : ℝ := c₁₀ + c₂₀ + M_card * c₃₀ + c₃₀
  have hc₂_pos : 0 < c₂ := by dsimp [c₂]; positivity
  refine ⟨c₂, hc₂_pos, ?_⟩
  intro X hX q hq hq_norm ψ hψ hψ_tors hψ_units
  set Y : ℝ := X ^ (Module.finrank ℚ K)
  have hX_pos : 0 < X := by linarith
  have hY_nonneg : 0 ≤ Y := by dsimp [Y]; positivity
  set S₁ : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
      IsUnit (Ideal.Quotient.mk q π)},
    ψ (Additive.ofMul π.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S₂ : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X) ∧
      IsUnit (Ideal.Quotient.mk q π)},
    ψ (Additive.ofMul π.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  let S_sec : NumberField.InfinitePlace K → ℂ := fun w₀ =>
    ∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          (∀ w : NumberField.InfinitePlace K,
            1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
          w₀ (π : K) < X ∧
          IsUnit (Ideal.Quotient.mk q π)},
      ψ (Additive.ofMul π.2.2.2.2.unit) *
        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S₃ : ℂ := ∑ w₀ : NumberField.InfinitePlace K, S_sec w₀
  have h1_le := mitsui_prime_char_box_to_ge_one_le (K := K) X hX q hq ψ
  have h1_uncond := hc₁₀ X hX
  have h1 : ‖S₁ - S₂‖ ≤ c₁₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁₀) :=
    le_trans h1_le h1_uncond
  have h2_le := mitsui_prime_char_box_ge_one_to_place_sectors_le (K := K) X hX q hq ψ
  have h2_uncond := hc₂₀ X hX
  have h2 : ‖S₂ - S₃‖ ≤ c₂₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂₀) :=
    le_trans h2_le h2_uncond
  have h3 : ∀ w₀ : NumberField.InfinitePlace K,
      ‖S_sec w₀‖ ≤ c₃₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃₀) :=
    fun w₀ => hc₃₀ X hX w₀ q hq hq_norm ψ hψ hψ_tors hψ_units
  have h_norm3 : ‖S₃‖ ≤
      M_card * (c₃₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃₀)) := by
    dsimp [S₃]
    calc ‖∑ w₀ : NumberField.InfinitePlace K, S_sec w₀‖
      _ ≤ ∑ w₀ : NumberField.InfinitePlace K, ‖S_sec w₀‖ :=
          norm_sum_le _ _
      _ ≤ ∑ _w₀ : NumberField.InfinitePlace K,
            (c₃₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃₀)) :=
          Finset.sum_le_sum (fun w₀ _ => h3 w₀)
      _ = M_card * (c₃₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃₀)) := by
          simp [M_card, Finset.sum_const, nsmul_eq_mul]
  have h_ident : S₁ = (S₁ - S₂) + (S₂ - S₃) + S₃ := by ring
  have h_tri : ‖S₁‖ ≤ ‖S₁ - S₂‖ + ‖S₂ - S₃‖ + ‖S₃‖ := by
    rw [congrArg norm h_ident]
    have ht1 := norm_add_le ((S₁ - S₂) + (S₂ - S₃)) S₃
    have ht2 := norm_add_le (S₁ - S₂) (S₂ - S₃)
    linarith
  have hsqrt_nonneg : 0 ≤ Real.sqrt (Real.log X) := Real.sqrt_nonneg _
  have hc₁₀_le : c₁₀ ≤ c₂ := by
    have : 0 ≤ c₂₀ + M_card * c₃₀ + c₃₀ := by positivity
    dsimp [c₂]; linarith
  have hc₂₀_le : c₂₀ ≤ c₂ := by
    have : 0 ≤ c₁₀ + M_card * c₃₀ + c₃₀ := by positivity
    dsimp [c₂]; linarith
  have hc₃₀_le : c₃₀ ≤ c₂ := by
    have : 0 ≤ c₁₀ + c₂₀ + M_card * c₃₀ := by positivity
    dsimp [c₂]; linarith
  have hexp1 : Real.exp (-Real.sqrt (Real.log X) / c₁₀) ≤ Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₁₀_pos hc₁₀_le
  have hexp2 : Real.exp (-Real.sqrt (Real.log X) / c₂₀) ≤ Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₂₀_pos hc₂₀_le
  have hexp3 : Real.exp (-Real.sqrt (Real.log X) / c₃₀) ≤ Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₃₀_pos hc₃₀_le
  have hterm1 : ‖S₁ - S₂‖ ≤ c₁₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    calc ‖S₁ - S₂‖ ≤ c₁₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁₀) := h1
      _ ≤ c₁₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
        mul_le_mul_of_nonneg_left hexp1 (by positivity)
  have hterm2 : ‖S₂ - S₃‖ ≤ c₂₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    calc ‖S₂ - S₃‖ ≤ c₂₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂₀) := h2
      _ ≤ c₂₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
        mul_le_mul_of_nonneg_left hexp2 (by positivity)
  have hterm3 : ‖S₃‖ ≤ (M_card * c₃₀) * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    calc ‖S₃‖ ≤ M_card * (c₃₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃₀)) := h_norm3
      _ ≤ M_card * (c₃₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂)) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp3 (by positivity)) hM_nonneg
      _ = (M_card * c₃₀) * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := by ring
  have h_sum_le :
      c₁₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) +
      c₂₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) +
      (M_card * c₃₀) * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) ≤
      c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    have h_coeff : c₁₀ + c₂₀ + M_card * c₃₀ ≤ c₂ := by
      have : 0 ≤ c₃₀ := by positivity
      dsimp [c₂]; linarith
    have hYE_nonneg : 0 ≤ Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := by positivity
    calc c₁₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) +
        c₂₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) +
        (M_card * c₃₀) * Y * Real.exp (-Real.sqrt (Real.log X) / c₂)
      _ = (c₁₀ + c₂₀ + M_card * c₃₀) * (Y * Real.exp (-Real.sqrt (Real.log X) / c₂)) := by ring
      _ ≤ c₂ * (Y * Real.exp (-Real.sqrt (Real.log X) / c₂)) :=
        mul_le_mul_of_nonneg_right h_coeff hYE_nonneg
      _ = c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := by ring
  linarith

theorem mitsui_prime_char_convex_to_box_of_torsion_eq_one_of_units_ne_one {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (A : ℕ) (hA : 1 < A) :
    ∃ c₃ : ℝ, 0 < c₃ ∧
      ∀ X : ℝ, 1 < X →
        ∀ C : Set (NumberField.mixedEmbedding.mixedSpace K), Convex ℝ C → IsOpen C →
          (∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
              NumberField.mixedEmbedding.normAtPlace w z < X) →
          ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
            (Ideal.absNorm q : ℝ) < Real.log X ^ A →
            ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
              (∀ u ∈ NumberField.Units.torsion K,
                ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) →
              (∃ u : (NumberField.RingOfIntegers K)ˣ,
                ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) ≠ 1) →
              ‖(∑' π : {π : NumberField.RingOfIntegers K //
                    Prime π ∧
                    NumberField.mixedEmbedding K (π : K) ∈ C ∧
                    IsUnit (Ideal.Quotient.mk q π)},
                  ψ (Additive.ofMul π.2.2.2.unit) *
                    (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
                - (((MeasureTheory.volume C).toReal /
                    ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) *
                      X ^ (Module.finrank ℚ K)) : ℝ) : ℂ) *
                  (∑' π : {π : NumberField.RingOfIntegers K //
                        Prime π ∧
                        (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
                        IsUnit (Ideal.Quotient.mk q π)},
                      ψ (Additive.ofMul π.2.2.2.unit) *
                        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
                ≤ c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃) :=
by
  obtain ⟨c_pack, hc_pack_pos, hc_pack⟩ := mitsui_prime_grid_partition_diff_le_boundary (K := K)
  obtain ⟨c_cube, hc_cube_pos, hc_cube⟩ :=
    mitsui_prime_char_grid_cube_bound_of_torsion_eq_one_of_units_ne_one (K := K) A hA
  obtain ⟨c₂, hc₂_pos, hc₂⟩ :=
    mitsui_prime_char_box_bound_of_torsion_eq_one_of_units_ne_one (K := K) A hA
  set n : ℕ := Module.finrank ℚ K
  set F : ℝ := (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
  have hn_pos : 0 < n := Module.finrank_pos
  have hn_ge_one : 1 ≤ n := hn_pos
  have hnR_pos : (0 : ℝ) < (n : ℝ) := Nat.cast_pos.mpr hn_pos
  have hnR_ge_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn_ge_one
  have hF_ge_one : 1 ≤ F := by
    change (1 : ℝ) ≤ (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
    exact_mod_cast NumberField.mixedEmbedding.one_le_convexBodyLTFactor K
  have hF_pos : 0 < F := lt_of_lt_of_le zero_lt_one hF_ge_one
  let c' : ℝ := min (1 / 2) (1 / (2 * (n : ℝ) * c_cube))
  have hc'_pos : 0 < c' := lt_min (by norm_num) (by positivity)
  have hc'_le_half : c' ≤ 1 / 2 := min_le_left _ _
  have hc'_le_cube : c' ≤ 1 / (2 * (n : ℝ) * c_cube) := min_le_right _ _
  let A_bdry : ℝ := 2 * c_pack * (2 : ℝ) ^ (3 * n) * (16 / c' ^ 2 + 1)
  have hA_bdry_pos : 0 < A_bdry := by dsimp [A_bdry]; positivity
  let A_int : ℝ := (2 : ℝ) ^ n * c_cube
  have hA_int_pos : 0 < A_int := by dsimp [A_int]; positivity
  let c₃ : ℝ := max (max (2 / c') c₂) (A_bdry + A_int + c₂)
  have h_2c'_le_c₃ : 2 / c' ≤ c₃ := le_trans (le_max_left _ _) (le_max_left _ _)
  have hc₂_le_c₃ : c₂ ≤ c₃ := le_trans (le_max_right _ _) (le_max_left _ _)
  have h_sum_le_c₃ : A_bdry + A_int + c₂ ≤ c₃ := le_max_right _ _
  have hc₃_pos : 0 < c₃ := lt_of_lt_of_le (by positivity) h_2c'_le_c₃
  refine ⟨c₃, hc₃_pos, ?_⟩
  intro X hX C hC_conv hC_open hC_bdd q hq hq_norm ψ hψ hψ_tors hψ_units
  have hX_pos : 0 < X := by linarith
  have hX0 : 0 ≤ X := le_of_lt hX_pos
  have hYn_pos : 0 < X ^ n := by positivity
  have hlogX_pos : 0 < Real.log X := Real.log_pos hX
  set u : ℝ := Real.sqrt (Real.log X)
  have hu_pos : 0 < u := Real.sqrt_pos.mpr hlogX_pos
  have hu_nonneg : 0 ≤ u := le_of_lt hu_pos
  have hu_sq : u ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlogX_pos)
  let f_vol : NumberField.InfinitePlace K → NNReal := fun _ => ⟨X, hX0⟩
  have hC_sub : C ⊆ NumberField.mixedEmbedding.convexBodyLT K f_vol := by
    intro z hz
    rw [NumberField.mixedEmbedding.convexBodyLT, Set.mem_prod, Set.mem_univ_pi, Set.mem_univ_pi]
    refine ⟨fun w => ?_, fun w => ?_⟩
    · rw [Metric.mem_ball, dist_zero_right, ← NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2]
      exact hC_bdd z hz w.1
    · rw [Metric.mem_ball, dist_zero_right, ← NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex w.2]
      exact hC_bdd z hz w.1
  have hvol_le : MeasureTheory.volume C ≤
      MeasureTheory.volume (NumberField.mixedEmbedding.convexBodyLT K f_vol) :=
    MeasureTheory.measure_mono hC_sub
  have hvol_eq : MeasureTheory.volume (NumberField.mixedEmbedding.convexBodyLT K f_vol) =
      ↑(NumberField.mixedEmbedding.convexBodyLTFactor K) * ↑(∏ w, f_vol w ^ w.mult) := by
    convert NumberField.mixedEmbedding.convexBodyLT_volume K f_vol
  rw [hvol_eq] at hvol_le
  have hprod : (∏ w : NumberField.InfinitePlace K, f_vol w ^ w.mult) =
      ⟨X, hX0⟩ ^ n := by
    dsimp [f_vol, n]
    rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq]
  rw [hprod] at hvol_le
  have hne_top : (↑(NumberField.mixedEmbedding.convexBodyLTFactor K) *
      ↑(⟨X, hX0⟩ ^ n : NNReal) : ENNReal) ≠ ⊤ :=
    ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.coe_ne_top
  have hV_le : (MeasureTheory.volume C).toReal ≤ F * X ^ n := by
    have htoReal := ENNReal.toReal_mono hne_top hvol_le
    rw [ENNReal.toReal_mul, ENNReal.coe_toReal, ENNReal.coe_toReal, NNReal.coe_pow, NNReal.coe_mk] at htoReal
    exact htoReal
  set V : ℝ := (MeasureTheory.volume C).toReal
  have hV_nonneg : 0 ≤ V := ENNReal.toReal_nonneg
  set τ : ℝ := V / (F * X ^ n)
  have hτ_nonneg : 0 ≤ τ := by dsimp [τ]; positivity
  have hτ_le_one : τ ≤ 1 := by
    dsimp [τ]
    exact div_le_one_of_le₀ hV_le (by positivity)
  set m : ℕ := ⌊Real.exp (c' * u)⌋₊
  have hcu_pos : 0 < c' * u := mul_pos hc'_pos hu_pos
  have hexp_gt_one : 1 < Real.exp (c' * u) := Real.one_lt_exp_iff.mpr hcu_pos
  have hm_ge_one : 1 ≤ m := Nat.floor_pos.mpr (le_of_lt hexp_gt_one)
  have hmR_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm_ge_one
  have hmR_pos : (0 : ℝ) < (m : ℝ) := lt_of_lt_of_le zero_lt_one hmR_ge_one
  have hmR_ne : (m : ℝ) ≠ 0 := ne_of_gt hmR_pos
  have hm_le_exp : (m : ℝ) ≤ Real.exp (c' * u) := Nat.floor_le (Real.exp_nonneg _)
  have hexp_lt_m1 : Real.exp (c' * u) < (m : ℝ) + 1 := Nat.lt_floor_add_one _
  have hexp_le_2m : Real.exp (c' * u) ≤ 2 * (m : ℝ) := by linarith
  have h_minv_le : (m : ℝ)⁻¹ ≤ 2 * Real.exp (-c' * u) := by
    rw [inv_eq_one_div, div_le_iff₀ hmR_pos]
    calc (1 : ℝ) = Real.exp (c' * u) * Real.exp (-c' * u) := by
          rw [← Real.exp_add, neg_mul, add_neg_cancel, Real.exp_zero]
      _ ≤ (2 * (m : ℝ)) * Real.exp (-c' * u) :=
          mul_le_mul_of_nonneg_right hexp_le_2m (Real.exp_nonneg _)
      _ = 2 * Real.exp (-c' * u) * (m : ℝ) := by ring
  have hm_le_X : (m : ℝ) ≤ X := by
    rcases lt_or_ge u 1 with hu_lt | hu_ge
    · have hcu_lt : c' * u < Real.log 2 := by
        have h1 : c' * u < (1 / 2 : ℝ) * 1 := by
          calc c' * u ≤ (1 / 2) * u := mul_le_mul_of_nonneg_right hc'_le_half hu_nonneg
            _ < (1 / 2) * 1 := mul_lt_mul_of_pos_left hu_lt (by norm_num)
        have h2 := Real.log_two_gt_d9
        linarith
      have hexp_lt_two : Real.exp (c' * u) < 2 := by
        calc Real.exp (c' * u) < Real.exp (Real.log 2) := Real.exp_lt_exp.mpr hcu_lt
          _ = 2 := Real.exp_log (by norm_num)
      have hm_lt_two : m < 2 := (Nat.floor_lt (Real.exp_nonneg _)).mpr hexp_lt_two
      have hm_eq_one : m = 1 := by omega
      rw [hm_eq_one, Nat.cast_one]
      exact le_of_lt hX
    · have hcu_le_log : c' * u ≤ Real.log X := by
        calc c' * u ≤ (1 / 2) * u := mul_le_mul_of_nonneg_right hc'_le_half hu_nonneg
          _ ≤ 1 * u := by linarith
          _ = u * 1 := by ring
          _ ≤ u * u := mul_le_mul_of_nonneg_left hu_ge hu_nonneg
          _ = u ^ 2 := by ring
          _ = Real.log X := hu_sq
      calc (m : ℝ) ≤ Real.exp (c' * u) := hm_le_exp
        _ ≤ Real.exp (Real.log X) := Real.exp_le_exp.mpr hcu_le_log
        _ = X := Real.exp_log hX_pos
  have h1 := mitsui_convex_grid_boundary_card_bound X hX m hm_ge_one C hC_conv hC_open
  have h2 := hc_pack X hX m hm_ge_one hm_le_X C hC_bdd
  have h3 := mitsui_prime_char_grid_partition_diff_le_uncond X hX m hm_ge_one C hC_bdd q hq ψ
  have h5 := hc₂ X hX q hq hq_norm ψ hψ hψ_tors hψ_units
  set Q : (NumberField.mixedEmbedding.index K → Fin (2 * m)) →
      Set (NumberField.mixedEmbedding.mixedSpace K) :=
    fun k => {z : NumberField.mixedEmbedding.mixedSpace K |
      ∀ i : NumberField.mixedEmbedding.index K,
        (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
          Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
            ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))}
  set S_C : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      NumberField.mixedEmbedding K (π : K) ∈ C ∧
      IsUnit (Ideal.Quotient.mk q π)},
    ψ (Additive.ofMul π.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S_B : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
      IsUnit (Ideal.Quotient.mk q π)},
    ψ (Additive.ofMul π.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S_Q : (NumberField.mixedEmbedding.index K → Fin (2 * m)) → ℂ :=
    fun k => ∑' π : {π : NumberField.RingOfIntegers K //
        Prime π ∧
        (∀ i : NumberField.mixedEmbedding.index K,
          (NumberField.mixedEmbedding.stdBasis K).repr
              (NumberField.mixedEmbedding K (π : K)) i ∈
            Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
        IsUnit (Ideal.Quotient.mk q π)},
      ψ (Additive.ofMul π.2.2.2.unit) *
        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S_grid : ℂ := ∑' k : {k : NumberField.mixedEmbedding.index K → Fin (2 * m) // Q k ⊆ C},
    S_Q k.1
  set B_card : ℝ := (Nat.card {k : NumberField.mixedEmbedding.index K → Fin (2 * m) //
    (Q k ∩ C).Nonempty ∧ ¬ (Q k ⊆ C)} : ℝ)
  have h1' : B_card ≤ (2 : ℝ) ^ (3 * n) * (m : ℝ) ^ (n - 1) := h1
  have h3' : ‖S_C - S_grid‖ ≤ c_pack * B_card * (X / (m : ℝ)) ^ n * (Real.log X + 1) :=
    le_trans h3 h2
  have h_pow_cancel : (m : ℝ) ^ (n - 1) * (X / (m : ℝ)) ^ n = X ^ n * (m : ℝ)⁻¹ := by
    have hm_pow : (m : ℝ) ^ n = (m : ℝ) ^ (n - 1) * (m : ℝ) := by
      rw [← pow_succ, Nat.sub_add_cancel hn_ge_one]
    rw [div_pow, hm_pow]
    field_simp [hmR_ne]
  have h_bdry_vol : B_card * (X / (m : ℝ)) ^ n ≤ (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ := by
    calc B_card * (X / (m : ℝ)) ^ n
      _ ≤ ((2 : ℝ) ^ (3 * n) * (m : ℝ) ^ (n - 1)) * (X / (m : ℝ)) ^ n :=
          mul_le_mul_of_nonneg_right h1' (by positivity)
      _ = (2 : ℝ) ^ (3 * n) * ((m : ℝ) ^ (n - 1) * (X / (m : ℝ)) ^ n) := by ring
      _ = (2 : ℝ) ^ (3 * n) * (X ^ n * (m : ℝ)⁻¹) := by rw [h_pow_cancel]
      _ = (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ := by ring
  have h_bdry1 : ‖S_C - S_grid‖ ≤
      c_pack * (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ * (Real.log X + 1) := by
    calc ‖S_C - S_grid‖ ≤ c_pack * (B_card * (X / (m : ℝ)) ^ n) * (Real.log X + 1) := by
          linarith [h3']
      _ ≤ c_pack * ((2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹) * (Real.log X + 1) := by
          gcongr
      _ = c_pack * (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ * (Real.log X + 1) := by ring
  have h_log_le : Real.log X + 1 ≤ (16 / c' ^ 2 + 1) * Real.exp (c' * u / 2) := by
    have h_exp4 : c' * u / 4 ≤ Real.exp (c' * u / 4) := by
      have h := Real.add_one_le_exp (c' * u / 4)
      linarith
    have h_sq4 : (c' * u / 4) ^ 2 ≤ (Real.exp (c' * u / 4)) ^ 2 :=
      pow_le_pow_left₀ (by positivity) h_exp4 2
    have h_exp_sq : (Real.exp (c' * u / 4)) ^ 2 = Real.exp (c' * u / 2) := by
      rw [sq, ← Real.exp_add]
      ring_nf
    rw [h_exp_sq] at h_sq4
    have hc'_sq_pos : 0 < c' ^ 2 := by positivity
    have h_u_sq_le : Real.log X ≤ (16 / c' ^ 2) * Real.exp (c' * u / 2) := by
      rw [← hu_sq, div_mul_eq_mul_div, le_div_iff₀ hc'_sq_pos]
      calc u ^ 2 * c' ^ 2 = 16 * (c' * u / 4) ^ 2 := by ring
        _ ≤ 16 * Real.exp (c' * u / 2) := mul_le_mul_of_nonneg_left h_sq4 (by norm_num)
    have h_one_le : 1 ≤ Real.exp (c' * u / 2) :=
      Real.one_le_exp (by positivity)
    linarith
  have h_minv_log : (m : ℝ)⁻¹ * (Real.log X + 1) ≤
      2 * (16 / c' ^ 2 + 1) * Real.exp (-u / c₃) := by
    have hexp_prod : Real.exp (-c' * u) * Real.exp (c' * u / 2) = Real.exp (-c' * u / 2) := by
      rw [← Real.exp_add]
      ring_nf
    have h_exp_cb : Real.exp (-c' * u / 2) ≤ Real.exp (-u / c₃) := by
      rw [Real.exp_le_exp]
      have h_div_le : u / c₃ ≤ u / (2 / c') :=
        div_le_div_of_nonneg_left hu_nonneg (by positivity) h_2c'_le_c₃
      have hc'_ne : c' ≠ 0 := ne_of_gt hc'_pos
      have h_eq : u / (2 / c') = c' * u / 2 := by field_simp [hc'_ne]
      have h_neg1 : -c' * u / 2 = -(c' * u / 2) := by ring
      have h_neg2 : -u / c₃ = -(u / c₃) := by ring
      linarith
    calc (m : ℝ)⁻¹ * (Real.log X + 1)
      _ ≤ (2 * Real.exp (-c' * u)) * ((16 / c' ^ 2 + 1) * Real.exp (c' * u / 2)) :=
          mul_le_mul h_minv_le h_log_le (by positivity) (by positivity)
      _ = 2 * (16 / c' ^ 2 + 1) * (Real.exp (-c' * u) * Real.exp (c' * u / 2)) := by ring
      _ = 2 * (16 / c' ^ 2 + 1) * Real.exp (-c' * u / 2) := by rw [hexp_prod]
      _ ≤ 2 * (16 / c' ^ 2 + 1) * Real.exp (-u / c₃) :=
          mul_le_mul_of_nonneg_left h_exp_cb (by positivity)
  have h_bdry_bound : ‖S_C - S_grid‖ ≤ A_bdry * X ^ n * Real.exp (-u / c₃) := by
    calc ‖S_C - S_grid‖
      _ ≤ c_pack * (2 : ℝ) ^ (3 * n) * X ^ n * ((m : ℝ)⁻¹ * (Real.log X + 1)) := by
          linarith [h_bdry1]
      _ ≤ c_pack * (2 : ℝ) ^ (3 * n) * X ^ n *
            (2 * (16 / c' ^ 2 + 1) * Real.exp (-u / c₃)) :=
          mul_le_mul_of_nonneg_left h_minv_log (by positivity)
      _ = A_bdry * X ^ n * Real.exp (-u / c₃) := by
          dsimp [A_bdry]
          ring
  have h_int : ‖S_grid‖ ≤ A_int * X ^ n * Real.exp (-u / c₃) := by
    classical
    set I_sub := {k : NumberField.mixedEmbedding.index K → Fin (2 * m) // Q k ⊆ C}
    have hS_grid_eq : S_grid = ∑ k : I_sub, S_Q k.1 := tsum_fintype _
    have h_term_le : ∀ k ∈ (Finset.univ : Finset I_sub),
        ‖S_Q k.1‖ ≤ c_cube * X ^ n * Real.exp (-u / c_cube) := by
      intro k _
      exact hc_cube X hX m hm_ge_one hm_le_X k.1 (fun z hz w => hC_bdd z (k.2 hz) w)
        q hq hq_norm ψ hψ hψ_tors hψ_units
    have h_norm_sum : ‖S_grid‖ ≤
        (Fintype.card I_sub : ℝ) * (c_cube * X ^ n * Real.exp (-u / c_cube)) := by
      rw [hS_grid_eq]
      calc ‖∑ k : I_sub, S_Q k.1‖
        _ ≤ ∑ k : I_sub, ‖S_Q k.1‖ := norm_sum_le _ _
        _ ≤ ∑ _k : I_sub, (c_cube * X ^ n * Real.exp (-u / c_cube)) :=
            Finset.sum_le_sum h_term_le
        _ = (Fintype.card I_sub : ℝ) * (c_cube * X ^ n * Real.exp (-u / c_cube)) := by
            simp
    have hcard_idx : Fintype.card (NumberField.mixedEmbedding.index K) = n := by
      rw [← Module.finrank_eq_card_basis (NumberField.mixedEmbedding.stdBasis K),
          NumberField.mixedEmbedding.finrank K]
    have hcard_le : Fintype.card I_sub ≤ (2 * m) ^ n := by
      calc Fintype.card I_sub
        _ ≤ Fintype.card (NumberField.mixedEmbedding.index K → Fin (2 * m)) :=
            Fintype.card_subtype_le _
        _ = (2 * m) ^ n := by
            rw [Fintype.card_fun, Fintype.card_fin, hcard_idx]
    have hcardR_le : (Fintype.card I_sub : ℝ) ≤ (2 : ℝ) ^ n * Real.exp ((n : ℝ) * (c' * u)) := by
      calc (Fintype.card I_sub : ℝ)
        _ ≤ ((2 * m : ℕ) : ℝ) ^ n := by exact_mod_cast hcard_le
        _ = (2 : ℝ) ^ n * (m : ℝ) ^ n := by push_cast; rw [mul_pow]
        _ ≤ (2 : ℝ) ^ n * (Real.exp (c' * u)) ^ n :=
            mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) hm_le_exp n) (by positivity)
        _ = (2 : ℝ) ^ n * Real.exp ((n : ℝ) * (c' * u)) := by
            rw [← Real.exp_nat_mul]
    have h_exp_int : Real.exp ((n : ℝ) * (c' * u)) * Real.exp (-u / c_cube) ≤
        Real.exp (-u / c₃) := by
      rw [← Real.exp_add, Real.exp_le_exp]
      have h_nc' : (n : ℝ) * c' ≤ 1 / (2 * c_cube) := by
        calc (n : ℝ) * c' ≤ (n : ℝ) * (1 / (2 * (n : ℝ) * c_cube)) :=
              mul_le_mul_of_nonneg_left hc'_le_cube (by positivity)
          _ = 1 / (2 * c_cube) := by
              have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
              field_simp [hn_ne]
      have h_nc'u : (n : ℝ) * (c' * u) ≤ u / (2 * c_cube) := by
        calc (n : ℝ) * (c' * u) = ((n : ℝ) * c') * u := by ring
          _ ≤ (1 / (2 * c_cube)) * u := mul_le_mul_of_nonneg_right h_nc' hu_nonneg
          _ = u / (2 * c_cube) := by ring
      have h_cb_ge : 2 * c_cube ≤ c₃ := by
        have h1 : 2 * c_cube ≤ 2 * (n : ℝ) * c_cube := by
          calc 2 * c_cube = 2 * 1 * c_cube := by ring
            _ ≤ 2 * (n : ℝ) * c_cube := by gcongr
        have h2 : 2 * (n : ℝ) * c_cube ≤ 2 / c' := by
          rw [le_div_iff₀ hc'_pos]
          have h3 : 2 * (n : ℝ) * c_cube * c' ≤ 2 * (n : ℝ) * c_cube * (1 / (2 * (n : ℝ) * c_cube)) :=
            mul_le_mul_of_nonneg_left hc'_le_cube (by positivity)
          have h4 : 2 * (n : ℝ) * c_cube * (1 / (2 * (n : ℝ) * c_cube)) = 1 := by
            have h_ne : 2 * (n : ℝ) * c_cube ≠ 0 := by positivity
            field_simp [h_ne]
          linarith
        exact le_trans (le_trans h1 h2) h_2c'_le_c₃
      have h_div_cb : u / c₃ ≤ u / (2 * c_cube) :=
        div_le_div_of_nonneg_left hu_nonneg (by positivity) h_cb_ge
      have h_sub_eq : u / (2 * c_cube) + -u / c_cube = -(u / (2 * c_cube)) := by ring
      have h_neg_cb : -u / c₃ = -(u / c₃) := by ring
      linarith
    calc ‖S_grid‖
      _ ≤ (Fintype.card I_sub : ℝ) * (c_cube * X ^ n * Real.exp (-u / c_cube)) := h_norm_sum
      _ ≤ ((2 : ℝ) ^ n * Real.exp ((n : ℝ) * (c' * u))) *
            (c_cube * X ^ n * Real.exp (-u / c_cube)) :=
          mul_le_mul_of_nonneg_right hcardR_le (by positivity)
      _ = A_int * X ^ n * (Real.exp ((n : ℝ) * (c' * u)) * Real.exp (-u / c_cube)) := by
          dsimp [A_int]; ring
      _ ≤ A_int * X ^ n * Real.exp (-u / c₃) :=
          mul_le_mul_of_nonneg_left h_exp_int (by positivity)
  have h_box_bound : ‖(τ : ℂ) * S_B‖ ≤ c₂ * X ^ n * Real.exp (-u / c₃) := by
    have h_tau_norm : ‖(τ : ℂ) * S_B‖ ≤ ‖S_B‖ := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hτ_nonneg]
      exact mul_le_of_le_one_left (norm_nonneg _) hτ_le_one
    have h_exp₂ : Real.exp (-u / c₂) ≤ Real.exp (-u / c₃) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left hu_nonneg hc₂_pos hc₂_le_c₃
    calc ‖(τ : ℂ) * S_B‖ ≤ ‖S_B‖ := h_tau_norm
      _ ≤ c₂ * X ^ n * Real.exp (-u / c₂) := h5
      _ ≤ c₂ * X ^ n * Real.exp (-u / c₃) :=
          mul_le_mul_of_nonneg_left h_exp₂ (by positivity)
  have h_ident : S_C - (τ : ℂ) * S_B =
      (S_C - S_grid) + S_grid - (τ : ℂ) * S_B := by ring
  have h_tri : ‖S_C - (τ : ℂ) * S_B‖ ≤
      ‖S_C - S_grid‖ + ‖S_grid‖ + ‖(τ : ℂ) * S_B‖ := by
    rw [congrArg norm h_ident]
    have ht1 := norm_sub_le ((S_C - S_grid) + S_grid) ((τ : ℂ) * S_B)
    have ht2 := norm_add_le (S_C - S_grid) S_grid
    linarith
  calc ‖S_C - (τ : ℂ) * S_B‖
    _ ≤ ‖S_C - S_grid‖ + ‖S_grid‖ + ‖(τ : ℂ) * S_B‖ := h_tri
    _ ≤ A_bdry * X ^ n * Real.exp (-u / c₃) +
          A_int * X ^ n * Real.exp (-u / c₃) +
          c₂ * X ^ n * Real.exp (-u / c₃) :=
        add_le_add (add_le_add h_bdry_bound h_int) h_box_bound
    _ = (A_bdry + A_int + c₂) * (X ^ n * Real.exp (-u / c₃)) := by ring
    _ ≤ c₃ * (X ^ n * Real.exp (-u / c₃)) :=
        mul_le_mul_of_nonneg_right h_sum_le_c₃ (by positivity)
    _ = c₃ * X ^ n * Real.exp (-u / c₃) := by ring

theorem mitsui_prime_char_convex_to_box {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (A : ℕ) (hA : 1 < A) :
    ∃ c_cb : ℝ, 0 < c_cb ∧
      ∀ X : ℝ, 1 < X →
        ∀ C : Set (NumberField.mixedEmbedding.mixedSpace K), Convex ℝ C → IsOpen C →
          (∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
              NumberField.mixedEmbedding.normAtPlace w z < X) →
          ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
            (Ideal.absNorm q : ℝ) < Real.log X ^ A →
            ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
              ‖(∑' π : {π : NumberField.RingOfIntegers K //
                    Prime π ∧
                    NumberField.mixedEmbedding K (π : K) ∈ C ∧
                    IsUnit (Ideal.Quotient.mk q π)},
                  ψ (Additive.ofMul π.2.2.2.unit) *
                    (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
                - (((MeasureTheory.volume C).toReal /
                    ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) *
                      X ^ (Module.finrank ℚ K)) : ℝ) : ℂ) *
                  (∑' π : {π : NumberField.RingOfIntegers K //
                        Prime π ∧
                        (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
                        IsUnit (Ideal.Quotient.mk q π)},
                      ψ (Additive.ofMul π.2.2.2.unit) *
                        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
                ≤ c_cb * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cb) :=
by
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_prime_char_convex_bound_of_torsion_ne_one (K := K) A hA
  obtain ⟨c₂, hc₂_pos, hc₂⟩ := mitsui_prime_char_convex_to_box_of_units_eq_one (K := K) A hA
  obtain ⟨c₃, hc₃_pos, hc₃⟩ := mitsui_prime_char_convex_to_box_of_torsion_eq_one_of_units_ne_one (K := K) A hA
  let c_cb : ℝ := c₁ + c₂ + c₃
  have hc_cb_pos : 0 < c_cb := by dsimp [c_cb]; positivity
  refine ⟨c_cb, hc_cb_pos, ?_⟩
  intro X hX C hC_conv hC_open hC_bdd q hq hq_norm ψ hψ
  have hX_pos : (0 : ℝ) < X := by linarith
  have hY_nonneg : 0 ≤ X ^ (Module.finrank ℚ K) := by positivity
  have hsqrt_nonneg : 0 ≤ Real.sqrt (Real.log X) := Real.sqrt_nonneg _
  have hc₁_le : c₁ ≤ c_cb := by dsimp [c_cb]; linarith
  have hc₂_le : c₂ ≤ c_cb := by dsimp [c_cb]; linarith
  have hc₃_le : c₃ ≤ c_cb := by dsimp [c_cb]; linarith
  have hexp₁ : Real.exp (-Real.sqrt (Real.log X) / c₁) ≤ Real.exp (-Real.sqrt (Real.log X) / c_cb) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₁_pos hc₁_le
  have hexp₂ : Real.exp (-Real.sqrt (Real.log X) / c₂) ≤ Real.exp (-Real.sqrt (Real.log X) / c_cb) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₂_pos hc₂_le
  have hexp₃ : Real.exp (-Real.sqrt (Real.log X) / c₃) ≤ Real.exp (-Real.sqrt (Real.log X) / c_cb) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₃_pos hc₃_le
  by_cases h_tors : ∃ u ∈ NumberField.Units.torsion K,
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) ≠ 1
  · rw [mitsui_prime_char_box_eq_zero_of_torsion_ne_one X q ψ h_tors, mul_zero, sub_zero]
    have h1 := hc₁ X hX C hC_conv hC_open hC_bdd q hq hq_norm ψ hψ h_tors
    have hterm₁ : c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁) ≤
        c_cb * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cb) := by
      calc c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁)
        _ ≤ c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cb) :=
          mul_le_mul_of_nonneg_left hexp₁ (by positivity)
        _ ≤ c_cb * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cb) := by
          have : 0 ≤ X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cb) := by positivity
          nlinarith
    exact le_trans h1 hterm₁
  · push_neg at h_tors
    by_cases h_units : ∀ u : (NumberField.RingOfIntegers K)ˣ,
        ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1
    · have h2 := hc₂ X hX C hC_conv hC_open hC_bdd q hq hq_norm ψ hψ h_units
      have hterm₂ : c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₂) ≤
          c_cb * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cb) := by
        calc c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₂)
          _ ≤ c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cb) :=
            mul_le_mul_of_nonneg_left hexp₂ (by positivity)
          _ ≤ c_cb * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cb) := by
            have : 0 ≤ X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cb) := by positivity
            nlinarith
      exact le_trans h2 hterm₂
    · push_neg at h_units
      have h3 := hc₃ X hX C hC_conv hC_open hC_bdd q hq hq_norm ψ hψ h_tors h_units
      have hterm₃ : c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃) ≤
          c_cb * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cb) := by
        calc c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃)
          _ ≤ c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cb) :=
            mul_le_mul_of_nonneg_left hexp₃ (by positivity)
          _ ≤ c_cb * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cb) := by
            have : 0 ≤ X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cb) := by positivity
            nlinarith
      exact le_trans h3 hterm₃

theorem mitsui_prime_char_fundamentalCone_sub_primePower_le {K : Type u} [Field K] [NumberField K]
    (Y : ℝ)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ) :
    ‖(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          NumberField.mixedEmbedding K (π : K) ∈
            NumberField.mixedEmbedding.fundamentalCone K ∧
          NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤ Y ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      - (∑' xpm : {xpm : NumberField.RingOfIntegers K ×
              IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            1 ≤ xpm.2.2 ∧
            Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
            NumberField.mixedEmbedding K (xpm.1 : K) ∈
              NumberField.mixedEmbedding.fundamentalCone K ∧
            (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Y ∧
            IsUnit (Ideal.Quotient.mk q xpm.1)},
          ψ (Additive.ofMul xpm.2.2.2.2.2.unit) *
            (Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) : ℂ))‖
      ≤ (NumberField.Units.torsionOrder K : ℝ) *
        (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
            Real.log (Ideal.absNorm pm.1.1.asIdeal)) :=
by
  classical
  have hq_bot : q ≠ ⊥ := hq
  haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
    Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
  have h_norm_span : ∀ x : NumberField.RingOfIntegers K,
      (Ideal.absNorm (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))) : ℝ) =
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) := by
    intro x
    rw [Ideal.absNorm_span_singleton, NumberField.mixedEmbedding.norm_eq_norm,
      ← Algebra.coe_norm_int x, Nat.cast_natAbs]
    push_cast
    rfl
  have h_span_norm_pow : ∀ (x : NumberField.RingOfIntegers K)
      (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
      Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = p.asIdeal ^ m →
      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) =
        (Ideal.absNorm p.asIdeal : ℝ) ^ m := by
    intro x p m h_span
    rw [← h_norm_span x, h_span, map_pow, Nat.cast_pow]
  have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p.asIdeal := by
    intro p
    have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    omega
  have h_pm_bounds : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
      1 ≤ m → (Ideal.absNorm p.asIdeal : ℝ) ^ m ≤ Y →
      Ideal.absNorm p.asIdeal ≤ ⌊Y⌋₊ ∧ m ≤ ⌊Y⌋₊ := by
    intro p m hm h_pow
    have hk2 : 2 ≤ Ideal.absNorm p.asIdeal := h_norm_ge_two p
    have h_pow_nat : ((Ideal.absNorm p.asIdeal ^ m : ℕ) : ℝ) ≤ Y := by exact_mod_cast h_pow
    have h_km_le : Ideal.absNorm p.asIdeal ^ m ≤ ⌊Y⌋₊ := Nat.le_floor h_pow_nat
    have hm_ne : m ≠ 0 := by omega
    have hk_le_km : Ideal.absNorm p.asIdeal ≤ Ideal.absNorm p.asIdeal ^ m :=
      Nat.le_self_pow hm_ne (Ideal.absNorm p.asIdeal)
    have hm_le_2m : m ≤ 2 ^ m := (Nat.lt_pow_self (by decide : 1 < 2)).le
    have h2m_le_km : 2 ^ m ≤ Ideal.absNorm p.asIdeal ^ m := Nat.pow_le_pow_left hk2 m
    exact ⟨le_trans hk_le_km h_km_le, le_trans (le_trans hm_le_2m h2m_le_km) h_km_le⟩
  let S_cone : Set (NumberField.RingOfIntegers K) :=
    {x : NumberField.RingOfIntegers K |
      NumberField.mixedEmbedding K (x : K) ∈ NumberField.mixedEmbedding.fundamentalCone K ∧
      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤ Y}
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊}
  have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Y⌋₊
  haveI : Finite S_id := hSid_fin
  let a_cone : S_cone → NumberField.mixedEmbedding.fundamentalCone.integerSet K :=
    fun x => ⟨NumberField.mixedEmbedding K (x.1 : K),
      NumberField.mixedEmbedding.fundamentalCone.mem_integerSet.mpr ⟨x.2.1, x.1, rfl⟩⟩
  have ha_cone_pre : ∀ x : S_cone,
      (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet (a_cone x) :
        NumberField.RingOfIntegers K) = x.1 :=
    fun x => NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet_mixedEmbedding (a_cone x).2
  have h_span_mem_cone : ∀ x : S_cone,
      Ideal.span ({x.1} : Set (NumberField.RingOfIntegers K)) ∈ S_id := by
    intro x
    show Ideal.absNorm (Ideal.span ({x.1} : Set (NumberField.RingOfIntegers K))) ≤ ⌊Y⌋₊
    apply Nat.le_floor
    rw [h_norm_span x.1]
    exact x.2.2
  let φ_cone : S_cone → S_id × NumberField.Units.torsion K :=
    fun x => (⟨Ideal.span {x.1}, h_span_mem_cone x⟩,
      (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a_cone x)).2)
  have hφ_cone_inj : Function.Injective φ_cone := by
    intro x₁ x₂ hφ
    have h1 : Ideal.span ({x₁.1} : Set (NumberField.RingOfIntegers K)) =
        Ideal.span ({x₂.1} : Set (NumberField.RingOfIntegers K)) :=
      congrArg Subtype.val (Prod.ext_iff.mp hφ).1
    have h2 : (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a_cone x₁)).2 =
        (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a_cone x₂)).2 :=
      (Prod.ext_iff.mp hφ).2
    have hfst1 : (((NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a_cone x₁)).1 :
        nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
        Ideal (NumberField.RingOfIntegers K)) =
        Ideal.span ({x₁.1} : Set (NumberField.RingOfIntegers K)) := by
      rw [NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv_apply_fst, ha_cone_pre x₁]
    have hfst2 : (((NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a_cone x₂)).1 :
        nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
        Ideal (NumberField.RingOfIntegers K)) =
        Ideal.span ({x₂.1} : Set (NumberField.RingOfIntegers K)) := by
      rw [NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv_apply_fst, ha_cone_pre x₂]
    have hfst_eq : (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a_cone x₁)).1 =
        (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a_cone x₂)).1 := by
      apply Subtype.ext
      apply Subtype.ext
      rw [hfst1, hfst2, h1]
    have heq_equiv : NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a_cone x₁) =
        NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a_cone x₂) :=
      Prod.ext hfst_eq h2
    have ha_eq : a_cone x₁ = a_cone x₂ :=
      (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K).injective heq_equiv
    have hx_val : x₁.1 = x₂.1 := by
      rw [← ha_cone_pre x₁, ← ha_cone_pre x₂]
      exact congrArg (fun z : NumberField.mixedEmbedding.fundamentalCone.integerSet K =>
        (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet z :
          NumberField.RingOfIntegers K)) ha_eq
    exact Subtype.ext hx_val
  haveI : Finite S_cone := Finite.of_injective φ_cone hφ_cone_inj
  have hScone_fin : S_cone.Finite := Set.toFinite S_cone
  let S_pm : Set (Ideal (NumberField.RingOfIntegers K) × ℕ) :=
    S_id ×ˢ {m : ℕ | m ≤ ⌊Y⌋₊}
  let S_xpm : Set (NumberField.RingOfIntegers K × Ideal (NumberField.RingOfIntegers K) × ℕ) :=
    S_cone ×ˢ S_pm
  have hSpm_fin : S_pm.Finite := hSid_fin.prod (Set.finite_le_nat ⌊Y⌋₊)
  have hSxpm_fin : S_xpm.Finite := hScone_fin.prod hSpm_fin
  haveI : Finite S_pm := hSpm_fin
  haveI : Finite S_xpm := hSxpm_fin
  let D_prime := {π : NumberField.RingOfIntegers K //
    Prime π ∧
    NumberField.mixedEmbedding K (π : K) ∈
      NumberField.mixedEmbedding.fundamentalCone K ∧
    NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤ Y ∧
    IsUnit (Ideal.Quotient.mk q π)}
  let D_ge1 := {xpm : NumberField.RingOfIntegers K ×
          IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ xpm.2.2 ∧
        Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
        NumberField.mixedEmbedding K (xpm.1 : K) ∈
          NumberField.mixedEmbedding.fundamentalCone K ∧
        (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Y ∧
        IsUnit (Ideal.Quotient.mk q xpm.1)}
