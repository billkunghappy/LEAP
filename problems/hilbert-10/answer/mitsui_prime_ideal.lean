    _ ≤ ‖(∑ pm : D_Z, T_main (v pm) * (w_riesz pm : ℂ)) - c_main 0 * (∑ pm : D_Z, (w_riesz pm : ℂ))‖ +
        ‖∑ pm : D_Z, (N_cell (v pm) - T_main (v pm)) * (w_riesz pm : ℂ)‖ :=
      norm_add_le _ _
    _ ≤ A_main * (2 * (M : ℝ) + 1) ^ r * B_osc +
        (‖∑ pm : D_Z, T_collar (v pm) * (w_riesz pm : ℂ)‖ + ε_tail * (∑ pm : D_Z, w_riesz pm)) :=
      add_le_add h_main_sub_zero_bound h_err_sum
    _ ≤ A_main * (2 * (M : ℝ) + 1) ^ r * B_osc +
        ((A_collar * (∑ pm : D_Z, w_riesz pm) + A_main * (2 * (M : ℝ) + 1) ^ r * B_osc) +
          ε_tail * (∑ pm : D_Z, w_riesz pm)) := by
      linarith [h_collar_bound]
    _ = 2 * A_main * (2 * (M : ℝ) + 1) ^ r * B_osc +
        (A_collar + ε_tail) * (∑ pm : D_Z, w_riesz pm) := by ring
    _ = 2 * A_main * (2 * (M : ℝ) + 1) ^ r * B_osc +
        (A_collar + ε_tail) * (∑' pm : D_Z, w_riesz pm) := by
      rw [tsum_fintype]

theorem mitsui_trigPoly_zero_mode_sub_grid_card_le {α : Type u} [Fintype α] (w₀ : α)
    (r M L N : ℕ) (hML : M < L)
    (L_mat : α → Fin r → ℝ)
    (a b : α → ℝ)
    (c_main c_collar : (Fin r → ℤ) → ℂ)
    (ε_tail : ℝ)
    (h_approx : ∀ v : Fin r → ℝ,
      ‖(Nat.card {e : Fin r → ℤ //
          ∀ w : α, w ≠ w₀ →
            ∑ j : Fin r, (v j + (e j : ℝ)) * L_mat w j ∈ Set.Ioc (a w) (b w)} : ℂ) -
        ∑ m_freq ∈ Fintype.piFinset (fun _ : Fin r => Finset.Icc (-(M : ℤ)) (M : ℤ)),
          c_main m_freq *
            Complex.exp (2 * Real.pi * Complex.I *
              ∑ j : Fin r, (m_freq j : ℝ) * v j)‖ ≤
      (∑ m_freq ∈ Fintype.piFinset (fun _ : Fin r => Finset.Icc (-(M : ℤ)) (M : ℤ)),
        c_collar m_freq *
          Complex.exp (2 * Real.pi * Complex.I *
            ∑ j : Fin r, (m_freq j : ℝ) * v j)).re + ε_tail)
    (h_bdd : ∀ y : Fin r → ℝ,
      (∀ w : α, w ≠ w₀ → ∑ j : Fin r, y j * L_mat w j ∈ Set.Ioc (a w) (b w)) →
      ∀ j : Fin r, |y j| ≤ ((N : ℝ) - 1) * (L : ℝ)⁻¹) :
    |(c_main 0).re -
      ((L : ℝ) ^ r)⁻¹ *
        (Nat.card {q : Fin r → ℤ //
          ∀ w : α, w ≠ w₀ →
            ∑ j : Fin r, (q j : ℝ) * (L : ℝ)⁻¹ * L_mat w j ∈ Set.Ioc (a w) (b w)} : ℝ)| ≤
      ‖c_collar 0‖ + ε_tail :=
by
  classical
  have hL_pos : 0 < L := Nat.zero_lt_of_lt hML
  have hL_rpos : (0 : ℝ) < (L : ℝ) := Nat.cast_pos.mpr hL_pos
  have hL_rne : (L : ℝ) ≠ 0 := ne_of_gt hL_rpos
  have hL_cne : (L : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hL_pos)
  have hL_zpos : (0 : ℤ) < (L : ℤ) := Nat.cast_pos.mpr hL_pos
  have hL_zne : (L : ℤ) ≠ 0 := ne_of_gt hL_zpos
  have hLr_pos : (0 : ℝ) < (L : ℝ) ^ r := pow_pos hL_rpos r
  have hLr_ne : (L : ℝ) ^ r ≠ 0 := ne_of_gt hLr_pos
  let I_M : Finset ℤ := Finset.Icc (-(M : ℤ)) (M : ℤ)
  let S_M : Finset (Fin r → ℤ) := Fintype.piFinset (fun _ : Fin r => I_M)
  let ζ : ℤ → ℂ := fun m =>
    Complex.exp (2 * Real.pi * Complex.I * (m : ℝ) * (L : ℝ)⁻¹)
  let v_p : (Fin r → Fin L) → Fin r → ℝ := fun p j => ((p j : ℕ) : ℝ) * (L : ℝ)⁻¹
  
  have h_orthog_1d_zero : ∑ k : Fin L, ζ 0 ^ (k : ℕ) = ((L : ℝ) : ℂ) := by
    have hζ0 : ζ 0 = 1 := by
      dsimp [ζ]
      simp
    simp [hζ0, Finset.sum_const, Finset.card_univ, Fintype.card_fin]
  have h_orthog_1d_ne_zero : ∀ m ∈ I_M, m ≠ 0 → ∑ k : Fin L, ζ m ^ (k : ℕ) = 0 := by
    intro m hm_mem hm_ne
    have hζ_pow_L : ζ m ^ L = 1 := by
      dsimp [ζ]
      rw [← Complex.exp_nat_mul]
      have h_exp_arg :
          (L : ℂ) * (2 * Real.pi * Complex.I * (m : ℂ) * (L : ℝ)⁻¹) =
            (m : ℂ) * (2 * Real.pi * Complex.I) := by
        push_cast
        field_simp [hL_cne]
      rw [h_exp_arg]
      exact Complex.exp_int_mul_two_pi_mul_I m
    have hζ_ne_one : ζ m ≠ 1 := by
      intro h_eq_one
      dsimp [ζ] at h_eq_one
      rcases Complex.exp_eq_one_iff.mp h_eq_one with ⟨n, hn⟩
      have h_mul_L :
          (2 * Real.pi * Complex.I) * ((m : ℝ) : ℂ) =
            (2 * Real.pi * Complex.I) * (((n * (L : ℤ) : ℤ) : ℝ) : ℂ) := by
        calc (2 * Real.pi * Complex.I) * ((m : ℝ) : ℂ)
          _ = (2 * Real.pi * Complex.I * (m : ℂ) * (L : ℝ)⁻¹) * (L : ℂ) := by
            push_cast
            field_simp [hL_cne]
          _ = ((n : ℂ) * (2 * Real.pi * Complex.I)) * (L : ℂ) := by rw [hn]
          _ = (2 * Real.pi * Complex.I) * (((n * (L : ℤ) : ℤ) : ℝ) : ℂ) := by
            push_cast
            ring
      have h2piI_ne : (2 * Real.pi * Complex.I : ℂ) ≠ 0 :=
        mul_ne_zero (mul_ne_zero two_ne_zero (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero))
          Complex.I_ne_zero
      have h_c_eq : ((m : ℝ) : ℂ) = (((n * (L : ℤ) : ℤ) : ℝ) : ℂ) :=
        mul_left_cancel₀ h2piI_ne h_mul_L
      have h_r_eq : (m : ℝ) = ((n * (L : ℤ) : ℤ) : ℝ) := Complex.ofReal_inj.mp h_c_eq
      have hm_eq : m = n * (L : ℤ) := Int.cast_injective h_r_eq
      have hn_ne : n ≠ 0 := by
        intro hn0
        apply hm_ne
        rw [hm_eq, hn0, zero_mul]
      have hn_abs : 1 ≤ |n| := Int.one_le_abs hn_ne
      have h_abs_ge : (L : ℤ) ≤ |m| := by
        calc (L : ℤ)
          _ = 1 * (L : ℤ) := (one_mul _).symm
          _ ≤ |n| * (L : ℤ) := mul_le_mul_of_nonneg_right hn_abs (le_of_lt hL_zpos)
          _ = |n * (L : ℤ)| := by rw [abs_mul, abs_of_pos hL_zpos]
          _ = |m| := by rw [← hm_eq]
      rcases Finset.mem_Icc.mp hm_mem with ⟨hm_lo, hm_hi⟩
      have h_abs_le : |m| ≤ (M : ℤ) := abs_le.mpr ⟨hm_lo, hm_hi⟩
      have hML_z : (M : ℤ) < (L : ℤ) := Nat.cast_lt.mpr hML
      omega
    have h_geom : (∑ k : Fin L, ζ m ^ (k : ℕ)) * (ζ m - 1) = 0 := by
      rw [Fin.sum_univ_eq_sum_range (fun k : ℕ => ζ m ^ k) L, geom_sum_mul, hζ_pow_L, sub_self]
    rcases mul_eq_zero.mp h_geom with h_sum_zero | h_sub_zero
    · exact h_sum_zero
    · exfalso
      exact hζ_ne_one (sub_eq_zero.mp h_sub_zero)
  
  have h0_mem_SM : (0 : Fin r → ℤ) ∈ S_M := by
    refine Fintype.mem_piFinset.mpr (fun _ => Finset.mem_Icc.mpr ?_)
    exact ⟨neg_nonpos.mpr (Nat.cast_nonneg M), Nat.cast_nonneg M⟩
  have h_exp_prod : ∀ (p : Fin r → Fin L) (m_freq : Fin r → ℤ),
      Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v_p p j) =
        ∏ j : Fin r, ζ (m_freq j) ^ (p j : ℕ) := by
    intro p m_freq
    rw [Complex.ofReal_sum, Finset.mul_sum, Complex.exp_sum]
    refine Finset.prod_congr rfl (fun j _ => ?_)
    dsimp [ζ, v_p]
    rw [← Complex.exp_nat_mul]
    congr 1
    push_cast
    ring
  have h_grid_exp_sum : ∀ m_freq ∈ S_M,
      (∑ p : Fin r → Fin L,
        Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v_p p j)) =
      if m_freq = 0 then (((L : ℝ) ^ r : ℝ) : ℂ) else 0 := by
    intro m_freq hm_mem
    have h_prod_sum :
        (∑ p : Fin r → Fin L,
          Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v_p p j)) =
        ∏ j : Fin r, ∑ k : Fin L, ζ (m_freq j) ^ (k : ℕ) := by
      simp_rw [h_exp_prod]
      change (∑ p ∈ (Finset.univ : Finset (Fin r → Fin L)),
          ∏ j : Fin r, ζ (m_freq j) ^ (p j : ℕ)) =
        ∏ j : Fin r, ∑ k ∈ (Finset.univ : Finset (Fin L)), ζ (m_freq j) ^ (k : ℕ)
      rw [← Fintype.piFinset_univ]
      exact (Finset.prod_univ_sum (t := fun _ : Fin r => (Finset.univ : Finset (Fin L)))
        (f := fun (j : Fin r) (k : Fin L) => ζ (m_freq j) ^ (k : ℕ))).symm
    rw [h_prod_sum]
    split_ifs with hm_zero
    · subst hm_zero
      have h_each : ∀ j : Fin r, (∑ k : Fin L, ζ ((0 : Fin r → ℤ) j) ^ (k : ℕ)) = ((L : ℝ) : ℂ) :=
        fun _ => h_orthog_1d_zero
      simp_rw [h_each]
      rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin, ← Complex.ofReal_pow]
    · obtain ⟨j₀, hj₀⟩ := Function.ne_iff.mp hm_zero
      have hj₀_mem : m_freq j₀ ∈ I_M := Fintype.mem_piFinset.mp hm_mem j₀
      exact Finset.prod_eq_zero (Finset.mem_univ j₀) (h_orthog_1d_ne_zero (m_freq j₀) hj₀_mem hj₀)
  have h_trig_grid_sum : ∀ c : (Fin r → ℤ) → ℂ,
      (∑ p : Fin r → Fin L,
        ∑ m_freq ∈ S_M,
          c m_freq *
            Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v_p p j)) =
      c 0 * (((L : ℝ) ^ r : ℝ) : ℂ) := by
    intro c
    rw [Finset.sum_comm]
    have h_inner : ∀ m_freq ∈ S_M,
        (∑ p : Fin r → Fin L,
          c m_freq *
            Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v_p p j)) =
        if m_freq = 0 then c 0 * (((L : ℝ) ^ r : ℝ) : ℂ) else 0 := by
      intro m_freq hm_mem
      rw [← Finset.mul_sum, h_grid_exp_sum m_freq hm_mem]
      split_ifs with hm_zero
      · subst hm_zero; rfl
      · exact mul_zero _
    rw [Finset.sum_congr rfl h_inner]
    rw [Finset.sum_eq_single 0]
    · simp
    · intro m_freq _ hm_ne
      exact if_neg hm_ne
    · intro h0_not_mem
      exact False.elim (h0_not_mem h0_mem_SM)
  have h_trig_grid_re : ∀ c : (Fin r → ℤ) → ℂ,
      (∑ p : Fin r → Fin L,
        (∑ m_freq ∈ S_M,
          c m_freq *
            Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v_p p j)).re) =
      (c 0).re * (L : ℝ) ^ r := by
    intro c
    rw [← Complex.re_sum, h_trig_grid_sum c, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
      mul_zero, sub_zero]
  
  let B_N : Finset (Fin r → ℤ) :=
    Fintype.piFinset (fun _ : Fin r => Finset.Icc (-(N : ℤ)) (N : ℤ))
  let P_q : (Fin r → ℤ) → Prop := fun q =>
    ∀ w : α, w ≠ w₀ →
      ∑ j : Fin r, (q j : ℝ) * (L : ℝ)⁻¹ * L_mat w j ∈ Set.Ioc (a w) (b w)
  let S_cell : Finset (Fin r → ℤ) := B_N.filter P_q
  have hS_cell_iff : ∀ q : Fin r → ℤ, q ∈ S_cell ↔ P_q q := by
    intro q
    rw [Finset.mem_filter]
    refine ⟨fun h => h.2, fun hq => ⟨?_, hq⟩⟩
    rw [Fintype.mem_piFinset]
    intro j
    have hy := h_bdd (fun j₁ => (q j₁ : ℝ) * (L : ℝ)⁻¹) hq j
    have hL_inv_pos : (0 : ℝ) < (L : ℝ)⁻¹ := inv_pos.mpr hL_rpos
    rw [abs_mul, abs_of_pos hL_inv_pos] at hy
    have hq_abs : |(q j : ℝ)| ≤ (N : ℝ) - 1 := le_of_mul_le_mul_right hy hL_inv_pos
    have hq_abs_N : |(q j : ℝ)| ≤ ((N : ℤ) : ℝ) := by
      rw [Int.cast_natCast]
      linarith
    rcases abs_le.mp hq_abs_N with ⟨h_lo, h_hi⟩
    rw [← Int.cast_neg] at h_lo
    exact Finset.mem_Icc.mpr ⟨Int.cast_le.mp h_lo, Int.cast_le.mp h_hi⟩
  have hS_cell_card : Nat.card {q : Fin r → ℤ // P_q q} = S_cell.card :=
    (@Nat.card_eq_fintype_card {q : Fin r → ℤ // P_q q}
      (Fintype.ofFinset S_cell hS_cell_iff)).trans
      (@Fintype.card_ofFinset (Fin r → ℤ) P_q S_cell hS_cell_iff)
  
  let Phi_p : (Fin r → Fin L) → (Fin r → ℤ) → (Fin r → ℤ) :=
    fun p e j => ((p j : ℕ) : ℤ) + (L : ℤ) * e j
  let rem : (Fin r → ℤ) → (Fin r → Fin L) :=
    fun q j => ⟨(q j % (L : ℤ)).toNat, by
      have h_nonneg : 0 ≤ q j % (L : ℤ) := Int.emod_nonneg (q j) hL_zne
      have h_lt : q j % (L : ℤ) < (L : ℤ) := Int.emod_lt_of_pos (q j) hL_zpos
      exact (Int.toNat_lt h_nonneg).mpr h_lt⟩
  let quot : (Fin r → ℤ) → (Fin r → ℤ) := fun q j => q j / (L : ℤ)
  have h_rem_Phi : ∀ (p : Fin r → Fin L) (e : Fin r → ℤ), rem (Phi_p p e) = p := by
    intro p e
    ext j
    dsimp [rem, Phi_p]
    have hp_nonneg : (0 : ℤ) ≤ ((p j : ℕ) : ℤ) := Nat.cast_nonneg _
    have hp_lt : ((p j : ℕ) : ℤ) < (L : ℤ) := Nat.cast_lt.mpr (p j).isLt
    rw [Int.add_mul_emod_self_left, Int.emod_eq_of_lt hp_nonneg hp_lt, Int.toNat_natCast]
  have h_quot_Phi : ∀ (p : Fin r → Fin L) (e : Fin r → ℤ), quot (Phi_p p e) = e := by
    intro p e
    ext j
    dsimp [quot, Phi_p]
    have hp_nonneg : (0 : ℤ) ≤ ((p j : ℕ) : ℤ) := Nat.cast_nonneg _
    have hp_lt : ((p j : ℕ) : ℤ) < (L : ℤ) := Nat.cast_lt.mpr (p j).isLt
    rw [Int.add_mul_ediv_left _ _ hL_zne, Int.ediv_eq_zero_of_lt hp_nonneg hp_lt, zero_add]
  have h_Phi_quot : ∀ q : Fin r → ℤ, Phi_p (rem q) (quot q) = q := by
    intro q
    ext j
    dsimp [Phi_p, rem, quot]
    have h_nonneg : 0 ≤ q j % (L : ℤ) := Int.emod_nonneg (q j) hL_zne
    rw [Int.toNat_of_nonneg h_nonneg]
    exact Int.emod_add_mul_ediv (q j) (L : ℤ)
  let P_e : (Fin r → Fin L) → (Fin r → ℤ) → Prop := fun p e =>
    ∀ w : α, w ≠ w₀ →
      ∑ j : Fin r, (v_p p j + (e j : ℝ)) * L_mat w j ∈ Set.Ioc (a w) (b w)
  have hPe_iff_Pq : ∀ (p : Fin r → Fin L) (e : Fin r → ℤ),
      P_e p e ↔ P_q (Phi_p p e) := by
    intro p e
    dsimp [P_e, P_q]
    have h_coord : ∀ j : Fin r, (Phi_p p e j : ℝ) * (L : ℝ)⁻¹ = v_p p j + (e j : ℝ) := by
      intro j
      dsimp [Phi_p, v_p]
      push_cast
      field_simp [hL_rne]
    simp_rw [h_coord]
  let S_fiber : (Fin r → Fin L) → Finset (Fin r → ℤ) :=
    fun p => S_cell.filter (fun q => rem q = p)
  let E_fin : (Fin r → Fin L) → Finset (Fin r → ℤ) :=
    fun p => (S_fiber p).image quot
  have hE_iff : ∀ (p : Fin r → Fin L) (e : Fin r → ℤ), e ∈ E_fin p ↔ P_e p e := by
    intro p e
    dsimp [E_fin, S_fiber]
    rw [Finset.mem_image]
    constructor
    · rintro ⟨q, hq_fib, rfl⟩
      rcases Finset.mem_filter.mp hq_fib with ⟨hq_cell, hq_rem⟩
      rw [hPe_iff_Pq, ← hq_rem, h_Phi_quot q]
      exact (hS_cell_iff q).mp hq_cell
    · intro he
      refine ⟨Phi_p p e, Finset.mem_filter.mpr ⟨?_, h_rem_Phi p e⟩, h_quot_Phi p e⟩
      exact (hS_cell_iff (Phi_p p e)).mpr ((hPe_iff_Pq p e).mp he)
  have h_card_fiber : ∀ p : Fin r → Fin L,
      Nat.card {e : Fin r → ℤ // P_e p e} = (S_fiber p).card := by
    intro p
    have h_card_E : Nat.card {e : Fin r → ℤ // P_e p e} = (E_fin p).card :=
      (@Nat.card_eq_fintype_card {e : Fin r → ℤ // P_e p e}
        (Fintype.ofFinset (E_fin p) (hE_iff p))).trans
        (@Fintype.card_ofFinset (Fin r → ℤ) (P_e p) (E_fin p) (hE_iff p))
    rw [h_card_E]
    dsimp [E_fin]
    refine Finset.card_image_of_injOn (fun q₁ hq₁ q₂ hq₂ h_eq => ?_)
    have hrem₁ : rem q₁ = p := (Finset.mem_filter.mp hq₁).2
    have hrem₂ : rem q₂ = p := (Finset.mem_filter.mp hq₂).2
    calc q₁ = Phi_p (rem q₁) (quot q₁) := (h_Phi_quot q₁).symm
      _ = Phi_p p (quot q₂) := by rw [hrem₁, h_eq]
      _ = Phi_p (rem q₂) (quot q₂) := by rw [hrem₂]
      _ = q₂ := h_Phi_quot q₂
  have h_grid_partition_nat :
      (∑ p : Fin r → Fin L, Nat.card {e : Fin r → ℤ // P_e p e}) =
        Nat.card {q : Fin r → ℤ // P_q q} := by
    simp_rw [h_card_fiber, hS_cell_card]
    dsimp [S_fiber]
    exact (Finset.card_eq_sum_card_fiberwise
      (f := rem) (s := S_cell) (t := Finset.univ) (fun q _ => Finset.mem_univ (rem q))).symm
  have h_grid_partition :
      (∑ p : Fin r → Fin L, (Nat.card {e : Fin r → ℤ // P_e p e} : ℝ)) =
        (Nat.card {q : Fin r → ℤ // P_q q} : ℝ) := by
    exact_mod_cast h_grid_partition_nat
  
  let G_card : ℝ := (Nat.card {q : Fin r → ℤ // P_q q} : ℝ)
  let N_p : (Fin r → Fin L) → ℝ := fun p => (Nat.card {e : Fin r → ℤ // P_e p e} : ℝ)
  have h_pointwise_re : ∀ p : Fin r → Fin L,
      |(∑ m_freq ∈ S_M,
          c_main m_freq *
            Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v_p p j)).re -
        N_p p| ≤
      (∑ m_freq ∈ S_M,
        c_collar m_freq *
          Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v_p p j)).re +
        ε_tail := by
    intro p
    rw [abs_sub_comm]
    have h_re_eq :
        N_p p -
          (∑ m_freq ∈ S_M,
            c_main m_freq *
              Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v_p p j)).re =
        ((Nat.card {e : Fin r → ℤ // P_e p e} : ℂ) -
          ∑ m_freq ∈ S_M,
            c_main m_freq *
              Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v_p p j)).re := by
      dsimp [N_p]
    rw [h_re_eq]
    exact le_trans (Complex.abs_re_le_norm _) (h_approx (v_p p))
  have h_sum_lhs :
      (∑ p : Fin r → Fin L,
        ((∑ m_freq ∈ S_M,
            c_main m_freq *
              Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v_p p j)).re -
          N_p p)) =
      (c_main 0).re * (L : ℝ) ^ r - G_card := by
    rw [Finset.sum_sub_distrib, h_trig_grid_re c_main, h_grid_partition]
  have h_sum_rhs :
      (∑ p : Fin r → Fin L,
        ((∑ m_freq ∈ S_M,
            c_collar m_freq *
              Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v_p p j)).re +
          ε_tail)) =
      (c_collar 0).re * (L : ℝ) ^ r + (L : ℝ) ^ r * ε_tail := by
    rw [Finset.sum_add_distrib, h_trig_grid_re c_collar]
    congr 1
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fun, Fintype.card_fin, Fintype.card_fin,
      nsmul_eq_mul, Nat.cast_pow]
  have h_collar_re_le : (c_collar 0).re ≤ ‖c_collar 0‖ :=
    le_trans (le_abs_self _) (Complex.abs_re_le_norm _)
  have h_scaled_bound :
      |(c_main 0).re * (L : ℝ) ^ r - G_card| ≤ (‖c_collar 0‖ + ε_tail) * (L : ℝ) ^ r := by
    calc |(c_main 0).re * (L : ℝ) ^ r - G_card|
      _ = |∑ p : Fin r → Fin L,
            ((∑ m_freq ∈ S_M,
                c_main m_freq *
                  Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v_p p j)).re -
              N_p p)| := by rw [h_sum_lhs]
      _ ≤ ∑ p : Fin r → Fin L,
            |(∑ m_freq ∈ S_M,
                c_main m_freq *
                  Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v_p p j)).re -
              N_p p| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ p : Fin r → Fin L,
            ((∑ m_freq ∈ S_M,
                c_collar m_freq *
                  Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v_p p j)).re +
              ε_tail) := Finset.sum_le_sum (fun p _ => h_pointwise_re p)
      _ = (c_collar 0).re * (L : ℝ) ^ r + (L : ℝ) ^ r * ε_tail := h_sum_rhs
      _ ≤ ‖c_collar 0‖ * (L : ℝ) ^ r + (L : ℝ) ^ r * ε_tail := by
          have h1 : (c_collar 0).re * (L : ℝ) ^ r ≤ ‖c_collar 0‖ * (L : ℝ) ^ r :=
            mul_le_mul_of_nonneg_right h_collar_re_le (le_of_lt hLr_pos)
          linarith
      _ = (‖c_collar 0‖ + ε_tail) * (L : ℝ) ^ r := by ring
  have hLr_inv_pos : (0 : ℝ) < ((L : ℝ) ^ r)⁻¹ := inv_pos.mpr hLr_pos
  calc |(c_main 0).re - ((L : ℝ) ^ r)⁻¹ * G_card|
    _ = |((L : ℝ) ^ r)⁻¹ * ((c_main 0).re * (L : ℝ) ^ r - G_card)| := by
        congr 1
        field_simp [hLr_ne]
    _ = ((L : ℝ) ^ r)⁻¹ * |(c_main 0).re * (L : ℝ) ^ r - G_card| := by
        rw [abs_mul, abs_of_pos hLr_inv_pos]
    _ ≤ ((L : ℝ) ^ r)⁻¹ * ((‖c_collar 0‖ + ε_tail) * (L : ℝ) ^ r) :=
        mul_le_mul_of_nonneg_left h_scaled_bound (le_of_lt hLr_inv_pos)
    _ = ‖c_collar 0‖ + ε_tail := by
        field_simp [hLr_ne]

theorem mitsui_grid_card_sub_cell_volume_le {α : Type u} [Fintype α] (w₀ : α)
    (r N : ℕ) (h C_L : ℝ) (hh_pos : 0 < h)
    (L_mat : α → Fin r → ℝ) (hC_L : ∀ w : α, w ≠ w₀ → ∑ j : Fin r, |L_mat w j| ≤ C_L)
    (a b : α → ℝ)
    (S_main S_outer S_collar : Finset (Fin r → ℤ))
    (hS_main : ∀ q : Fin r → ℤ, q ∈ S_main ↔
      q ∈ Fintype.piFinset (fun _ : Fin r => Finset.Icc (-(N : ℤ)) (N : ℤ)) ∧
      ∀ w : α, w ≠ w₀ →
        ∑ j : Fin r, (q j : ℝ) * h * L_mat w j ∈ Set.Ioc (a w + C_L * h) (b w - C_L * h))
    (hS_outer : ∀ q : Fin r → ℤ, q ∈ S_outer ↔
      q ∈ Fintype.piFinset (fun _ : Fin r => Finset.Icc (-(N : ℤ)) (N : ℤ)) ∧
      ∀ w : α, w ≠ w₀ →
        ∑ j : Fin r, (q j : ℝ) * h * L_mat w j ∈ Set.Ioc (a w - C_L * h) (b w + C_L * h))
    (hS_collar_card : S_main.card + S_collar.card = S_outer.card)
    (h_bdd : ∀ y : Fin r → ℝ,
      (∀ w : α, w ≠ w₀ → ∑ j : Fin r, y j * L_mat w j ∈ Set.Ioc (a w) (b w)) →
      ∀ j : Fin r, |y j| ≤ ((N : ℝ) - 1) * h) :
    |(Nat.card {q : Fin r → ℤ //
        ∀ w : α, w ≠ w₀ →
          ∑ j : Fin r, (q j : ℝ) * h * L_mat w j ∈ Set.Ioc (a w) (b w)} : ℝ) * h ^ r -
      (MeasureTheory.volume {y : Fin r → ℝ |
        ∀ w : α, w ≠ w₀ →
          ∑ j : Fin r, y j * L_mat w j ∈ Set.Ioc (a w) (b w)}).toReal| ≤
      (S_collar.card : ℝ) * h ^ r :=
by
  classical
  have hh_nonneg : 0 ≤ h := le_of_lt hh_pos
  have hh_pow_nonneg : 0 ≤ h ^ r := pow_nonneg hh_nonneg r
  let B_N : Finset (Fin r → ℤ) :=
    Fintype.piFinset (fun _ : Fin r => Finset.Icc (-(N : ℤ)) (N : ℤ))
  let P_cell : (Fin r → ℤ) → Prop :=
    fun q => ∀ w : α, w ≠ w₀ →
      ∑ j : Fin r, (q j : ℝ) * h * L_mat w j ∈ Set.Ioc (a w) (b w)
  let S_cell : Finset (Fin r → ℤ) := B_N.filter P_cell
  have hS_cell_iff : ∀ q : Fin r → ℤ, q ∈ S_cell ↔ P_cell q := by
    intro q
    rw [Finset.mem_filter]
    refine ⟨fun hq => hq.2, fun hq => ⟨?_, hq⟩⟩
    rw [Fintype.mem_piFinset]
    intro j
    rw [Finset.mem_Icc]
    have h_abs := h_bdd (fun i => (q i : ℝ) * h) hq j
    rcases abs_le.mp h_abs with ⟨h_lo, h_hi⟩
    have h1 : ((- (N : ℤ) : ℤ) : ℝ) * h ≤ (q j : ℝ) * h := by
      push_cast
      linarith
    have h2 : (q j : ℝ) * h ≤ ((N : ℤ) : ℝ) * h := by
      push_cast
      linarith
    have h1' : ((- (N : ℤ) : ℤ) : ℝ) ≤ (q j : ℝ) := le_of_mul_le_mul_right h1 hh_pos
    have h2' : (q j : ℝ) ≤ ((N : ℤ) : ℝ) := le_of_mul_le_mul_right h2 hh_pos
    exact ⟨Int.cast_le.mp h1', Int.cast_le.mp h2'⟩
  have h_card_nat : Nat.card {q : Fin r → ℤ // P_cell q} = S_cell.card := by
    letI : Fintype {q : Fin r → ℤ // P_cell q} := Fintype.ofFinset S_cell hS_cell_iff
    rw [Nat.card_eq_fintype_card]
    exact Fintype.card_ofFinset S_cell hS_cell_iff
  have h_card_real : (Nat.card {q : Fin r → ℤ // P_cell q} : ℝ) = (S_cell.card : ℝ) :=
    congrArg Nat.cast h_card_nat
  have hCL_h_nonneg : ∀ w : α, w ≠ w₀ → 0 ≤ C_L * h := by
    intro w hw
    have h_sum_nonneg : 0 ≤ ∑ j : Fin r, |L_mat w j| :=
      Finset.sum_nonneg (fun _ _ => abs_nonneg _)
    have hCL_nonneg : 0 ≤ C_L := le_trans h_sum_nonneg (hC_L w hw)
    exact mul_nonneg hCL_nonneg hh_nonneg
  have hS_main_sub_cell : S_main ⊆ S_cell := by
    intro q hq
    rcases (hS_main q).mp hq with ⟨hq_box, hq_in⟩
    rw [Finset.mem_filter]
    refine ⟨hq_box, fun w hw => ?_⟩
    have h_nonneg := hCL_h_nonneg w hw
    rcases hq_in w hw with ⟨h_gt, h_le⟩
    exact ⟨by linarith, by linarith⟩
  have hS_cell_sub_outer : S_cell ⊆ S_outer := by
    intro q hq
    rcases Finset.mem_filter.mp hq with ⟨hq_box, hq_in⟩
    refine (hS_outer q).mpr ⟨hq_box, fun w hw => ?_⟩
    have h_nonneg := hCL_h_nonneg w hw
    rcases hq_in w hw with ⟨h_gt, h_le⟩
    exact ⟨by linarith, by linarith⟩
  have h_grid_lo : (S_main.card : ℝ) * h ^ r ≤ (S_cell.card : ℝ) * h ^ r := by
    have h_le : (S_main.card : ℝ) ≤ (S_cell.card : ℝ) := by
      exact_mod_cast Finset.card_le_card hS_main_sub_cell
    exact mul_le_mul_of_nonneg_right h_le hh_pow_nonneg
  have h_grid_hi : (S_cell.card : ℝ) * h ^ r ≤ (S_outer.card : ℝ) * h ^ r := by
    have h_le : (S_cell.card : ℝ) ≤ (S_outer.card : ℝ) := by
      exact_mod_cast Finset.card_le_card hS_cell_sub_outer
    exact mul_le_mul_of_nonneg_right h_le hh_pow_nonneg
  let Q : (Fin r → ℤ) → Set (Fin r → ℝ) :=
    fun q => Set.univ.pi (fun j : Fin r => Set.Ico ((q j : ℝ) * h) (((q j : ℝ) + 1) * h))
  let Ω : Set (Fin r → ℝ) :=
    {y : Fin r → ℝ | ∀ w : α, w ≠ w₀ → ∑ j : Fin r, y j * L_mat w j ∈ Set.Ioc (a w) (b w)}
  have hQ_meas : ∀ q : Fin r → ℤ, MeasurableSet (Q q) :=
    fun _ => MeasurableSet.univ_pi (fun _ => measurableSet_Ico)
  have hQ_vol : ∀ q : Fin r → ℤ, MeasureTheory.volume (Q q) = ENNReal.ofReal (h ^ r) := by
    intro q
    dsimp [Q]
    rw [Real.volume_pi_Ico]
    have h_diff : ∀ j : Fin r, ((q j : ℝ) + 1) * h - (q j : ℝ) * h = h := fun _ => by ring
    simp_rw [h_diff]
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin, ← ENNReal.ofReal_pow hh_nonneg]
  have hQ_disj : (↑S_main : Set (Fin r → ℤ)).PairwiseDisjoint Q := by
    intro q _ q' _ hne
    rw [Function.onFun, Set.disjoint_left]
    intro y hyq hyq'
    apply hne
    funext j
    have hj1 : y j ∈ Set.Ico ((q j : ℝ) * h) (((q j : ℝ) + 1) * h) := hyq j (Set.mem_univ j)
    have hj2 : y j ∈ Set.Ico ((q' j : ℝ) * h) (((q' j : ℝ) + 1) * h) := hyq' j (Set.mem_univ j)
    rcases hj1 with ⟨h_q_le, h_lt_q1⟩
    rcases hj2 with ⟨h_q'_le, h_lt_q'1⟩
    have h_lt1 : (q j : ℝ) * h < ((q' j + 1 : ℤ) : ℝ) * h := by
      push_cast
      linarith
    have h_lt2 : (q' j : ℝ) * h < ((q j + 1 : ℤ) : ℝ) * h := by
      push_cast
      linarith
    have h_lt1' : (q j : ℝ) < ((q' j + 1 : ℤ) : ℝ) := lt_of_mul_lt_mul_right h_lt1 hh_nonneg
    have h_lt2' : (q' j : ℝ) < ((q j + 1 : ℤ) : ℝ) := lt_of_mul_lt_mul_right h_lt2 hh_nonneg
    have h_z1 : q j < q' j + 1 := Int.cast_lt.mp h_lt1'
    have h_z2 : q' j < q j + 1 := Int.cast_lt.mp h_lt2'
    omega
  have hQ_lip : ∀ (q : Fin r → ℤ) (y : Fin r → ℝ), y ∈ Q q →
      ∀ w : α, w ≠ w₀ →
        |∑ j : Fin r, y j * L_mat w j - ∑ j : Fin r, (q j : ℝ) * h * L_mat w j| ≤ C_L * h := by
    intro q y hyQ w hw
    have h_coord : ∀ j : Fin r, |y j - (q j : ℝ) * h| ≤ h := by
      intro j
      rcases hyQ j (Set.mem_univ j) with ⟨h_lo, h_hi⟩
      exact abs_le.mpr ⟨by linarith, by linarith⟩
    calc |∑ j : Fin r, y j * L_mat w j - ∑ j : Fin r, (q j : ℝ) * h * L_mat w j|
      _ = |∑ j : Fin r, (y j - (q j : ℝ) * h) * L_mat w j| := by
          rw [← Finset.sum_sub_distrib]
          congr 1
          refine Finset.sum_congr rfl (fun j _ => by ring)
      _ ≤ ∑ j : Fin r, |(y j - (q j : ℝ) * h) * L_mat w j| :=
          Finset.abs_sum_le_sum_abs _ _
      _ = ∑ j : Fin r, |y j - (q j : ℝ) * h| * |L_mat w j| := by
          refine Finset.sum_congr rfl (fun j _ => abs_mul _ _)
      _ ≤ ∑ j : Fin r, h * |L_mat w j| := by
          refine Finset.sum_le_sum (fun j _ => ?_)
          exact mul_le_mul_of_nonneg_right (h_coord j) (abs_nonneg _)
      _ = h * ∑ j : Fin r, |L_mat w j| := (Finset.mul_sum _ _ _).symm
      _ ≤ C_L * h := by
          have h1 := mul_le_mul_of_nonneg_left (hC_L w hw) hh_nonneg
          linarith
  have h_inner_sub : (⋃ q ∈ S_main, Q q) ⊆ Ω := by
    intro y hy
    rw [Set.mem_iUnion₂] at hy
    rcases hy with ⟨q, hq_main, hyQ⟩
    intro w hw
    rcases ((hS_main q).mp hq_main).2 w hw with ⟨h_gt, h_le⟩
    rcases abs_le.mp (hQ_lip q y hyQ w hw) with ⟨h_diff_lo, h_diff_hi⟩
    exact ⟨by linarith, by linarith⟩
  have h_outer_sub : Ω ⊆ (⋃ q ∈ S_outer, Q q) := by
    intro y hy
    let q : Fin r → ℤ := fun j => Int.floor (y j / h)
    have hyQ : y ∈ Q q := by
      intro j _
      rw [Set.mem_Ico]
      have h_fl_le : (q j : ℝ) ≤ y j / h := Int.floor_le (y j / h)
      have h_lt_fl : y j / h < (q j : ℝ) + 1 := Int.lt_floor_add_one (y j / h)
      exact ⟨(le_div_iff₀ hh_pos).mp h_fl_le, (div_lt_iff₀ hh_pos).mp h_lt_fl⟩
    have hq_box : q ∈ B_N := by
      rw [Fintype.mem_piFinset]
      intro j
      rw [Finset.mem_Icc]
      rcases abs_le.mp (h_bdd y hy j) with ⟨hy_lo, hy_hi⟩
      rcases hyQ j (Set.mem_univ j) with ⟨hq_le_y, hy_lt_q1⟩
      have h1 : ((- (N : ℤ) : ℤ) : ℝ) * h ≤ (q j : ℝ) * h := by
        push_cast
        linarith
      have h2 : (q j : ℝ) * h ≤ ((N : ℤ) : ℝ) * h := by
        push_cast
        linarith
      have h1' : ((- (N : ℤ) : ℤ) : ℝ) ≤ (q j : ℝ) := le_of_mul_le_mul_right h1 hh_pos
      have h2' : (q j : ℝ) ≤ ((N : ℤ) : ℝ) := le_of_mul_le_mul_right h2 hh_pos
      exact ⟨Int.cast_le.mp h1', Int.cast_le.mp h2'⟩
    have hq_outer : q ∈ S_outer := by
      refine (hS_outer q).mpr ⟨hq_box, fun w hw => ?_⟩
      rcases hy w hw with ⟨hy_gt, hy_le⟩
      rcases abs_le.mp (hQ_lip q y hyQ w hw) with ⟨h_diff_lo, h_diff_hi⟩
      exact ⟨by linarith, by linarith⟩
    exact Set.mem_iUnion₂.mpr ⟨q, hq_outer, hyQ⟩
  have h_vol_inner_eq :
      MeasureTheory.volume (⋃ q ∈ S_main, Q q) =
        (S_main.card : ENNReal) * ENNReal.ofReal (h ^ r) := by
    rw [MeasureTheory.measure_biUnion_finset hQ_disj (fun q _ => hQ_meas q)]
    simp_rw [hQ_vol]
    rw [Finset.sum_const, nsmul_eq_mul]
  have h_vol_lo_enn :
      (S_main.card : ENNReal) * ENNReal.ofReal (h ^ r) ≤ MeasureTheory.volume Ω := by
    rw [← h_vol_inner_eq]
    exact MeasureTheory.measure_mono h_inner_sub
  have h_vol_hi_enn :
      MeasureTheory.volume Ω ≤ (S_outer.card : ENNReal) * ENNReal.ofReal (h ^ r) := by
    calc MeasureTheory.volume Ω
      _ ≤ MeasureTheory.volume (⋃ q ∈ S_outer, Q q) := MeasureTheory.measure_mono h_outer_sub
      _ ≤ ∑ q ∈ S_outer, MeasureTheory.volume (Q q) := MeasureTheory.measure_biUnion_finset_le S_outer Q
      _ = (S_outer.card : ENNReal) * ENNReal.ofReal (h ^ r) := by
          simp_rw [hQ_vol]
          rw [Finset.sum_const, nsmul_eq_mul]
  have h_outer_ne_top :
      (S_outer.card : ENNReal) * ENNReal.ofReal (h ^ r) ≠ ⊤ :=
    ENNReal.mul_ne_top (ENNReal.natCast_ne_top _) ENNReal.ofReal_ne_top
  have h_vol_ne_top : MeasureTheory.volume Ω ≠ ⊤ :=
    ne_top_of_le_ne_top h_outer_ne_top h_vol_hi_enn
  have h_vol_lo : (S_main.card : ℝ) * h ^ r ≤ (MeasureTheory.volume Ω).toReal := by
    have h1 := ENNReal.toReal_mono h_vol_ne_top h_vol_lo_enn
    rw [ENNReal.toReal_mul, ENNReal.toReal_natCast, ENNReal.toReal_ofReal hh_pow_nonneg] at h1
    exact h1
  have h_vol_hi : (MeasureTheory.volume Ω).toReal ≤ (S_outer.card : ℝ) * h ^ r := by
    have h1 := ENNReal.toReal_mono h_outer_ne_top h_vol_hi_enn
    rw [ENNReal.toReal_mul, ENNReal.toReal_natCast, ENNReal.toReal_ofReal hh_pow_nonneg] at h1
    exact h1
  have h_collar_real : (S_main.card : ℝ) + (S_collar.card : ℝ) = (S_outer.card : ℝ) := by
    exact_mod_cast hS_collar_card
  have h_collar_vol :
      (S_main.card : ℝ) * h ^ r + (S_collar.card : ℝ) * h ^ r = (S_outer.card : ℝ) * h ^ r := by
    rw [← add_mul, h_collar_real]
  change |(Nat.card {q : Fin r → ℤ // P_cell q} : ℝ) * h ^ r - (MeasureTheory.volume Ω).toReal| ≤
    (S_collar.card : ℝ) * h ^ r
  rw [h_card_real]
  exact abs_le.mpr ⟨by linarith, by linarith⟩

theorem mitsui_unitLogCoord_cell_volume_eq {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 ≤ X)
    (m : ℕ) (hm : 1 ≤ m)
    (w₀ : NumberField.InfinitePlace K)
    (k : NumberField.InfinitePlace K → Fin m) :
    (MeasureTheory.volume {y : Fin (NumberField.Units.rank K) → ℝ |
      ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
        ∑ j : Fin (NumberField.Units.rank K),
          y j *
            Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
              w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ∈
          Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
            (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))}).toReal =
      ((∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) /
        ((Module.finrank ℚ K : ℝ) * NumberField.Units.regulator K)) *
        (Real.log X / (m : ℝ)) ^ (NumberField.Units.rank K) :=
by
  classical
  let n : ℕ := Module.finrank ℚ K
  let r : ℕ := NumberField.Units.rank K
  let ι := {w : NumberField.InfinitePlace K // w ≠ w₀}
  have h_card : Fintype.card ι = Fintype.card (Fin r) := by
    dsimp [ι, r, NumberField.Units.rank]
    rw [Fintype.card_subtype_compl (fun w : NumberField.InfinitePlace K => w = w₀),
      Fintype.card_subtype_eq w₀, Fintype.card_fin]
  let e : ι ≃ Fin r := Fintype.equivOfCardEq h_card
  have hn_pos : (0 : ℝ) < (n : ℝ) := by
    dsimp [n]
    exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
  have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  have hR_pos : 0 < NumberField.Units.regulator K := NumberField.Units.regulator_pos K
  have hR_ne : NumberField.Units.regulator K ≠ 0 := ne_of_gt hR_pos
  have hw₀_mult_pos : (0 : ℝ) < (w₀.mult : ℝ) := by
    exact_mod_cast NumberField.InfinitePlace.mult_pos (w := w₀)
  have hw₀_mult_ne : (w₀.mult : ℝ) ≠ 0 := ne_of_gt hw₀_mult_pos
  have hprod_mult_pos : 0 < (∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) := by
    refine Finset.prod_pos (fun w _ => ?_)
    exact_mod_cast NumberField.InfinitePlace.mult_pos (w := w)
  let η : Fin r → K :=
    fun j => (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)
  have hη_ne : ∀ j : Fin r, η j ≠ 0 :=
    fun j => NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero _)
  have hw_η_ne : ∀ (w : NumberField.InfinitePlace K) (j : Fin r), w (η j) ≠ 0 :=
    fun w j => ne_of_gt (w.pos_iff.mpr (hη_ne j))
  let M_rel : Matrix ι ι ℝ :=
    Matrix.of (fun i w => Real.log (w.1 (η (e i)) / w₀ (η (e i))))
  let A_reg : Matrix ι ι ℝ :=
    Matrix.of (fun i w => (w.1.mult : ℝ) * Real.log (w.1 (η (e i))))
  have hA_reg_det : |A_reg.det| = NumberField.Units.regulator K := by
    simpa [A_reg, η] using (NumberField.Units.regulator_eq_det K w₀ e).symm
  have h_sum_row : ∀ i : ι,
      (w₀.mult : ℝ) * Real.log (w₀ (η (e i))) + ∑ u : ι, A_reg i u = 0 := by
    intro i
    have h1 : (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * Real.log (w (η (e i)))) = 0 := by
      simpa [η] using NumberField.Units.sum_mult_mul_log (NumberField.Units.fundSystem K (e i))
    rw [Fintype.sum_eq_add_sum_subtype_ne
      (fun w : NumberField.InfinitePlace K => (w.mult : ℝ) * Real.log (w (η (e i)))) w₀] at h1
    exact h1
  let u_1 : ι → ℝ := fun _ => 1
  let v_mult : ι → ℝ := fun w => (w.1.mult : ℝ) / (w₀.mult : ℝ)
  have h_mat_eq :
      Matrix.of (fun i w : ι => (w.1.mult : ℝ) * M_rel i w) =
        A_reg * (1 + Matrix.replicateCol Unit u_1 * Matrix.replicateRow Unit v_mult) := by
    ext i w
    rw [Matrix.mul_add, Matrix.mul_one, Matrix.add_apply, Matrix.mul_apply]
    have h_rank1 :
        ∑ u : ι, A_reg i u * (Matrix.replicateCol Unit u_1 * Matrix.replicateRow Unit v_mult) u w =
          (∑ u : ι, A_reg i u) * v_mult w := by
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl (fun u _ => ?_)
      rw [Matrix.mul_apply, Fintype.sum_unique, Matrix.replicateCol_apply, Matrix.replicateRow_apply]
      dsimp [u_1]
      ring
    rw [h_rank1]
    dsimp [M_rel, A_reg, v_mult]
    rw [Real.log_div (hw_η_ne w.1 (e i)) (hw_η_ne w₀ (e i))]
    have h_row := h_sum_row i
    simp only [A_reg, Matrix.of_apply] at h_row
    have h_sum_eq :
        ∑ u : ι, (u.1.mult : ℝ) * Real.log (u.1 (η (e i))) =
          -(w₀.mult : ℝ) * Real.log (w₀ (η (e i))) := by
      linarith
    rw [h_sum_eq]
    field_simp [hw₀_mult_ne]
    ring
  have h_det_scaled :
      (∏ w : ι, (w.1.mult : ℝ)) * M_rel.det =
        A_reg.det * (1 + v_mult ⬝ᵥ u_1) := by
    have h1 := congrArg Matrix.det h_mat_eq
    rw [Matrix.det_mul_row (fun w : ι => (w.1.mult : ℝ)) M_rel,
      Matrix.det_mul, Matrix.det_one_add_replicateCol_mul_replicateRow u_1 v_mult] at h1
    exact h1
  have h_dot :
      (w₀.mult : ℝ) * (1 + v_mult ⬝ᵥ u_1) = (n : ℝ) := by
    have h_sum_mult : (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ)) = (n : ℝ) := by
      dsimp [n]
      exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
    rw [Fintype.sum_eq_add_sum_subtype_ne
      (fun w : NumberField.InfinitePlace K => (w.mult : ℝ)) w₀] at h_sum_mult
    have h_vp : v_mult ⬝ᵥ u_1 = (∑ w : ι, (w.1.mult : ℝ)) / (w₀.mult : ℝ) := by
      dsimp [dotProduct, v_mult, u_1]
      simp_rw [mul_one]
      rw [← Finset.sum_div]
    rw [h_vp]
    field_simp [hw₀_mult_ne]
    linarith
  have h_prod_mult :
      (∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) =
        (w₀.mult : ℝ) * ∏ w : ι, (w.1.mult : ℝ) :=
    Fintype.prod_eq_mul_prod_subtype_ne
      (fun w : NumberField.InfinitePlace K => (w.mult : ℝ)) w₀
  have h_det_prod :
      (∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) * M_rel.det =
        A_reg.det * (n : ℝ) := by
    calc (∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) * M_rel.det
      _ = (w₀.mult : ℝ) * ((∏ w : ι, (w.1.mult : ℝ)) * M_rel.det) := by
          rw [h_prod_mult, mul_assoc]
      _ = (w₀.mult : ℝ) * (A_reg.det * (1 + v_mult ⬝ᵥ u_1)) := by
          rw [h_det_scaled]
      _ = A_reg.det * ((w₀.mult : ℝ) * (1 + v_mult ⬝ᵥ u_1)) := by ring
      _ = A_reg.det * (n : ℝ) := by rw [h_dot]
  have h_abs_det_prod :
      (∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) * |M_rel.det| =
        (n : ℝ) * NumberField.Units.regulator K := by
    have h1 := congrArg abs h_det_prod
    rw [abs_mul, abs_of_pos hprod_mult_pos, abs_mul, hA_reg_det, abs_of_pos hn_pos] at h1
    linarith
  have hM_abs_pos : 0 < |M_rel.det| := by
    by_contra h_le
    push_neg at h_le
    have h_zero : |M_rel.det| = 0 := le_antisymm h_le (abs_nonneg _)
    have h_lhs : (∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) * |M_rel.det| = 0 := by
      rw [h_zero, mul_zero]
    have h_rhs : 0 < (n : ℝ) * NumberField.Units.regulator K := mul_pos hn_pos hR_pos
    linarith
  have hM_det_ne : M_rel.det ≠ 0 := abs_pos.mp hM_abs_pos
  have hM_inv_abs :
      |(M_rel.det)⁻¹| =
        (∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) /
          ((n : ℝ) * NumberField.Units.regulator K) := by
    rw [abs_inv]
    have hM_abs_ne : |M_rel.det| ≠ 0 := ne_of_gt hM_abs_pos
    rw [← h_abs_det_prod]
    field_simp [hM_abs_ne, ne_of_gt hprod_mult_pos]
  let N_mat : Matrix (Fin r) (Fin r) ℝ := Matrix.reindex e e M_rel.transpose
  let f : (Fin r → ℝ) →ₗ[ℝ] (Fin r → ℝ) := Matrix.toLin' N_mat
  have hf_det : LinearMap.det f = M_rel.det := by
    change LinearMap.det (Matrix.toLin' (Matrix.reindex e e M_rel.transpose)) = M_rel.det
    rw [LinearMap.det_toLin', Matrix.det_reindex_self, Matrix.det_transpose]
  have hf_det_ne : LinearMap.det f ≠ 0 := by
    rw [hf_det]
    exact hM_det_ne
  have hf_apply : ∀ (y : Fin r → ℝ) (i : Fin r),
      f y i = ∑ j : Fin r, y j * Real.log ((e.symm i).1 (η j) / w₀ (η j)) := by
    intro y i
    change (Matrix.toLin' N_mat y) i = _
    rw [Matrix.toLin'_apply, Matrix.mulVec, dotProduct]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    dsimp [N_mat, M_rel]
    simp only [Equiv.apply_symm_apply]
    ring
  let a : Fin r → ℝ :=
    fun i => Real.log X * ((((k (e.symm i).1 : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ))
  let b : Fin r → ℝ :=
    fun i => Real.log X * ((((k (e.symm i).1 : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))
  let B_box : Set (Fin r → ℝ) := Set.univ.pi (fun i : Fin r => Set.Ioc (a i) (b i))
  have h_cell_eq :
      {y : Fin r → ℝ |
        ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
          ∑ j : Fin r, y j * Real.log (w (η j) / w₀ (η j)) ∈
            Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
              (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} =
        f ⁻¹' B_box := by
    ext y
    simp only [Set.mem_setOf_eq, Set.mem_preimage, B_box, Set.mem_univ_pi]
    constructor
    · intro hy i
      rw [hf_apply y i]
      exact hy (e.symm i).1 (e.symm i).2
    · intro hy w hw
      have hi := hy (e ⟨w, hw⟩)
      rw [hf_apply y (e ⟨w, hw⟩)] at hi
      dsimp [a, b] at hi
      rwa [e.symm_apply_apply] at hi
  have h_vol_preimage :
      MeasureTheory.volume (f ⁻¹' B_box) =
        ENNReal.ofReal |(LinearMap.det f)⁻¹| * MeasureTheory.volume B_box :=
    MeasureTheory.Measure.addHaar_preimage_linearMap MeasureTheory.volume hf_det_ne B_box
  have h_vol_box :
      MeasureTheory.volume B_box = ∏ i : Fin r, ENNReal.ofReal (b i - a i) := by
    dsimp [B_box]
    exact Real.volume_pi_Ioc
  have hm_pos : (0 : ℝ) < (m : ℝ) := by exact_mod_cast hm
  have hm_ne : (m : ℝ) ≠ 0 := ne_of_gt hm_pos
  have h_ba_eq : ∀ i : Fin r, b i - a i = Real.log X / (m : ℝ) := by
    intro i
    dsimp [a, b]
    field_simp [hm_ne]
    ring
  have h_side_nn : 0 ≤ Real.log X / (m : ℝ) :=
    div_nonneg (Real.log_nonneg hX) (le_of_lt hm_pos)
  change (MeasureTheory.volume {y : Fin r → ℝ |
    ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
      ∑ j : Fin r, y j * Real.log (w (η j) / w₀ (η j)) ∈
        Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
          (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))}).toReal =
    ((∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) /
      ((n : ℝ) * NumberField.Units.regulator K)) *
      (Real.log X / (m : ℝ)) ^ r
  rw [h_cell_eq, h_vol_preimage, h_vol_box, ENNReal.toReal_mul,
    ENNReal.toReal_ofReal (abs_nonneg _), ENNReal.toReal_prod]
  simp_rw [h_ba_eq, ENNReal.toReal_ofReal h_side_nn]
  rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin, hf_det, hM_inv_abs]

theorem mitsui_riesz_primePower_unitLogCoord_cell_bound_of_rank_pos {K : Type u} [Field K] [NumberField K]
    (h_rank : 0 < NumberField.Units.rank K)
    (Φ_W : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →
      Fin (NumberField.Units.rank K) → ℝ)
    (hΦ_W_mul : ∀ I J : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ∃ d : Fin (NumberField.Units.rank K) → ℤ,
        ∀ j : Fin (NumberField.Units.rank K),
          Φ_W (I * J) j = Φ_W I j + Φ_W J j + (d j : ℝ))
    (hΦ_W_pow : ∀ (I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) (ν : ℕ),
      ∃ d : Fin (NumberField.Units.rank K) → ℤ,
        ∀ j : Fin (NumberField.Units.rank K),
          Φ_W (I ^ ν) j = (ν : ℝ) * Φ_W I j + (d j : ℝ))
    (hΦ_W_prin : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      ∃ d : Fin (NumberField.Units.rank K) → ℤ,
        ∀ (w w₀ : NumberField.InfinitePlace K),
          Real.log (w (x : K) / w₀ (x : K)) =
            ∑ j : Fin (NumberField.Units.rank K),
              (Φ_W ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
                mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ j + (d j : ℝ)) *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) :
    ∃ c_coord : ℝ, 0 < c_coord ∧
      ∀ X : ℝ, 1 < X → 1 < Real.log X →
        ∀ m : ℕ, 1 ≤ m →
          ∀ w₀ : NumberField.InfinitePlace K,
            ∀ k : NumberField.InfinitePlace K → Fin m,
              ∀ Z : ℝ, X ≤ Z → Z ≤ Real.exp 1 * X ^ (Module.finrank ℚ K) →
                |(∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                      1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Z},
                    (Nat.card {e : Fin (NumberField.Units.rank K) → ℤ //
                        ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
                          ∑ j : Fin (NumberField.Units.rank K),
                            ((pm.1.2 : ℝ) * Φ_W ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩ j + (e j : ℝ)) *
                              Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                                w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ∈
                            Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                              (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℝ) *
                      (Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                        Real.log (Z / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))))
                  - ((∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) /
                      ((Module.finrank ℚ K : ℝ) *
                        NumberField.Units.regulator K)) *
                    (Real.log X / (m : ℝ)) ^ (NumberField.Units.rank K) *
                    Z|
                  ≤ c_coord * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_coord) :=
by
  classical
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_riesz_primePowers_asymptotic (K := K)
  obtain ⟨c_gr, hc_gr_pos, hc_gr⟩ :=
    mitsui_riesz_primePower_ray_char_unitLogCoord_freq_bound_of_ne_zero
      (K := K) 2 (by decide) h_rank Φ_W hΦ_W_mul hΦ_W_pow hΦ_W_prin
  obtain ⟨C_trig, hC_trig_pos, h_trig⟩ := mitsui_unitLogCoord_cell_trigPoly_approx (K := K) h_rank
  obtain ⟨M_K, hM_K_pos, hM_K⟩ := mitsui_unitLogCoord_le_of_place_log_le (K := K)
  have hn_pos : 0 < Module.finrank ℚ K := Module.finrank_pos
  have hn_rpos : (0 : ℝ) < (Module.finrank ℚ K : ℝ) := Nat.cast_pos.mpr hn_pos
  have hr_rpos : (0 : ℝ) < (NumberField.Units.rank K : ℝ) := Nat.cast_pos.mpr h_rank
  have hr_ne : (NumberField.Units.rank K : ℝ) ≠ 0 := ne_of_gt hr_rpos
  have hr_ge_one : (1 : ℝ) ≤ (NumberField.Units.rank K : ℝ) := by exact_mod_cast h_rank
  have hR_K_pos : 0 < NumberField.Units.regulator K := NumberField.Units.regulator_pos K
  have hP_pos : 0 < (∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) := by
    refine Finset.prod_pos (fun w _ => ?_)
    exact_mod_cast NumberField.InfinitePlace.mult_pos
  obtain ⟨C_vol, hC_vol_def⟩ : ∃ C_vol : ℝ,
      C_vol = (∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) /
        ((Module.finrank ℚ K : ℝ) * NumberField.Units.regulator K) := ⟨_, rfl⟩
  have hC_vol_pos : 0 < C_vol := by rw [hC_vol_def]; positivity
  obtain ⟨C_L, hC_L_def⟩ : ∃ C_L : ℝ,
      C_L = (∑ w : NumberField.InfinitePlace K,
        ∑ w' : NumberField.InfinitePlace K,
          ∑ j : Fin (NumberField.Units.rank K),
            |Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
              w' (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))|) + 1 :=
    ⟨_, rfl⟩
  have hC_L_pos : 0 < C_L := by
    rw [hC_L_def]
    have h_sum_nonneg : 0 ≤ ∑ w : NumberField.InfinitePlace K,
        ∑ w' : NumberField.InfinitePlace K,
          ∑ j : Fin (NumberField.Units.rank K),
            |Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
              w' (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))| :=
      Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => abs_nonneg _)))
    linarith
  obtain ⟨C_2, hC_2_def⟩ : ∃ C_2 : ℝ, C_2 = 2 * M_K + 4 * M_K * C_L + 2 := ⟨_, rfl⟩
  have hC_2_pos : 0 < C_2 := by rw [hC_2_def]; positivity
  obtain ⟨K_end, hK_end_def⟩ : ∃ K_end : ℝ, K_end = 8 * M_K * C_L + 4 := ⟨_, rfl⟩
  have hK_end_pos : 0 < K_end := by rw [hK_end_def]; positivity
  obtain ⟨C_grid, hC_grid_def⟩ : ∃ C_grid : ℝ,
      C_grid = (NumberField.Units.rank K : ℝ) * K_end * C_2 ^ (NumberField.Units.rank K) := ⟨_, rfl⟩
  have hC_grid_pos : 0 < C_grid := by rw [hC_grid_def]; positivity
  obtain ⟨c_base, hc_base_def⟩ : ∃ c_base : ℝ, c_base = c_gr + c₁ + 1 := ⟨_, rfl⟩
  have hc_base_pos : 0 < c_base := by linarith [hc_base_def, hc_gr_pos, hc₁_pos]
  have hc_base_ne : c_base ≠ 0 := ne_of_gt hc_base_pos
  have hc_base_ge_one : 1 ≤ c_base := by linarith [hc_base_def, hc_gr_pos, hc₁_pos]
  have hc_gr_le : c_gr ≤ c_base := by linarith [hc_base_def, hc₁_pos]
  have hc₁_le : c₁ ≤ c_base := by linarith [hc_base_def, hc_gr_pos]
  obtain ⟨c', hc'_def⟩ : ∃ c' : ℝ,
      c' = 1 / (8 * (NumberField.Units.rank K : ℝ) * (2 * (NumberField.Units.rank K : ℝ) + 1) * c_base) :=
    ⟨_, rfl⟩
  have hc'_pos : 0 < c' := by rw [hc'_def]; positivity
  have hc'_ne : c' ≠ 0 := ne_of_gt hc'_pos
  obtain ⟨c'', hc''_def⟩ : ∃ c'' : ℝ, c'' = c' / (2 * (NumberField.Units.rank K : ℝ)) := ⟨_, rfl⟩
  have hc''_pos : 0 < c'' := by rw [hc''_def]; positivity
  obtain ⟨K₀, hK₀_def⟩ : ∃ K₀ : ℝ, K₀ = 16 / c'' ^ 2 + 1 := ⟨_, rfl⟩
  have hK₀_pos : 0 < K₀ := by rw [hK₀_def]; positivity
  obtain ⟨C_coeff, hC_coeff_def⟩ : ∃ C_coeff : ℝ,
      C_coeff = C_trig * K₀ ^ (NumberField.Units.rank K) := ⟨_, rfl⟩
  have hC_coeff_pos : 0 < C_coeff := by rw [hC_coeff_def]; positivity
  obtain ⟨C_gcoeff, hC_gcoeff_def⟩ : ∃ C_gcoeff : ℝ,
      C_gcoeff = C_grid * K₀ ^ (NumberField.Units.rank K) := ⟨_, rfl⟩
  have hC_gcoeff_pos : 0 < C_gcoeff := by rw [hC_gcoeff_def]; positivity
  obtain ⟨C_vcoeff, hC_vcoeff_def⟩ : ∃ C_vcoeff : ℝ,
      C_vcoeff = C_vol * K₀ ^ (NumberField.Units.rank K) := ⟨_, rfl⟩
  have hC_vcoeff_pos : 0 < C_vcoeff := by rw [hC_vcoeff_def]; positivity
  obtain ⟨c_coord, hc_coord_def⟩ : ∃ c_coord : ℝ,
      c_coord =
        Real.exp 1 *
          (C_coeff * (2 * (3 : ℝ) ^ (NumberField.Units.rank K) * c_base) +
            (6 * C_coeff + C_gcoeff) * (1 + c_base) +
            C_vcoeff * c_base) +
          2 / c' + 2 * c_base := ⟨_, rfl⟩
  have hc_coord_pos : 0 < c_coord := by rw [hc_coord_def]; positivity
  have h2cb_le_c_coord : 2 * c_base ≤ c_coord := by
    have : 0 ≤ Real.exp 1 *
        (C_coeff * (2 * (3 : ℝ) ^ (NumberField.Units.rank K) * c_base) +
          (6 * C_coeff + C_gcoeff) * (1 + c_base) +
          C_vcoeff * c_base) + 2 / c' := by positivity
    linarith [hc_coord_def]
  have h2c'_le_c_coord : 2 / c' ≤ c_coord := by
    have : 0 ≤ Real.exp 1 *
        (C_coeff * (2 * (3 : ℝ) ^ (NumberField.Units.rank K) * c_base) +
          (6 * C_coeff + C_gcoeff) * (1 + c_base) +
          C_vcoeff * c_base) + 2 * c_base := by positivity
    linarith [hc_coord_def]
  refine ⟨c_coord, hc_coord_pos, ?_⟩
  intro X hX hlogX_gt m hm w₀ k Z hXZ hZ_le
  obtain ⟨Y₀, hY₀_def⟩ : ∃ Y₀ : ℝ, Y₀ = X ^ (Module.finrank ℚ K) := ⟨_, rfl⟩
  rw [← hY₀_def] at hZ_le
  have hX_pos : (0 : ℝ) < X := by linarith
  have hX_ge_one : (1 : ℝ) ≤ X := le_of_lt hX
  have hY₀_pos : 0 < Y₀ := by rw [hY₀_def]; positivity
  have hZ_gt_one : 1 < Z := lt_of_lt_of_le hX hXZ
  have hZ_pos : 0 < Z := lt_trans zero_lt_one hZ_gt_one
