          _ = 1 * χ₂ I := by rw [h_sq_one]
          _ = χ₂ I := one_mul _
      · have hS₂_not : ¬ (∀ p ∈ S₂, ¬ ((I : Ideal R) ≤ p.asIdeal)) :=
          mt (hS₂ (I : Ideal R)).mpr hI₂
        rw [if_neg hS₂_not, (hχ₂_norm_supp I).2 hI₂]
        split_ifs <;> rfl
    · have hS₁_not : ¬ (∀ p ∈ S₁, ¬ ((I : Ideal R) ≤ p.asIdeal)) :=
        mt (hS₁ (I : Ideal R)).mpr hI₁
      rw [if_neg hS₁_not, (hχ₁_norm_supp I).2 hI₁]
      split_ifs <;> rfl
  let E₁₂ : ℂ → ℂ := fun s =>
    ∏ p ∈ S₂, (1 - χ₁ ⟨p.asIdeal, mem_nonZeroDivisors_of_ne_zero p.ne_bot⟩ *
      (Ideal.absNorm p.asIdeal : ℂ) ^ (-s))
  let E₂₁ : ℂ → ℂ := fun s =>
    ∏ p ∈ S₁, (1 - χ₂ ⟨p.asIdeal, mem_nonZeroDivisors_of_ne_zero p.ne_bot⟩ *
      (Ideal.absNorm p.asIdeal : ℂ) ^ (-s))
  obtain ⟨hE₁₂_diff, hE₁₂_ne⟩ := h_euler_prod χ₁ hχ₁_norm S₂
  obtain ⟨hE₂₁_diff, hE₂₁_ne⟩ := h_euler_prod χ₂ hχ₂_norm S₁
  let F₁ : ℂ → ℂ := fun s => g₁ s * E₁₂ s
  let F₂ : ℂ → ℂ := fun s => g₂ s * E₂₁ s
  have hF₁_anal : AnalyticOnNhd ℂ F₁ Set.univ :=
    (hg₁_diff.mul hE₁₂_diff).differentiableOn.analyticOnNhd isOpen_univ
  have hF₂_anal : AnalyticOnNhd ℂ F₂ Set.univ :=
    (hg₂_diff.mul hE₂₁_diff).differentiableOn.analyticOnNhd isOpen_univ
  have h_ev : F₁ =ᶠ[nhds (2 : ℂ)] F₂ := by
    have hU : {s : ℂ | 1 < s.re} ∈ nhds (2 : ℂ) :=
      (isOpen_lt continuous_const Complex.continuous_re).mem_nhds (by norm_num)
    filter_upwards [hU] with s hs
    dsimp [F₁, F₂, E₁₂, E₂₁]
    rw [hg₁_eq s hs, hg₂_eq s hs]
    change LSeries (a_char χ₁) s * E₁₂ s = LSeries (a_char χ₂) s * E₂₁ s
    rw [← h_finset_euler S₂ χ₁ hχ₁_norm s hs, ← h_finset_euler S₁ χ₂ hχ₂_norm s hs, h_res_eq]
  have h_eq_on : Set.EqOn F₁ F₂ Set.univ :=
    hF₁_anal.eqOn_of_preconnected_of_eventuallyEq hF₂_anal isPreconnected_univ
      (Set.mem_univ (2 : ℂ)) h_ev
  have h_eq_σ : g₁ (σ : ℂ) * E₁₂ (σ : ℂ) = g₂ (σ : ℂ) * E₂₁ (σ : ℂ) :=
    h_eq_on (Set.mem_univ (σ : ℂ))
  have hE₁₂_σ_ne : E₁₂ (σ : ℂ) ≠ 0 := hE₁₂_ne σ hσ
  have hE₂₁_σ_ne : E₂₁ (σ : ℂ) ≠ 0 := hE₂₁_ne σ hσ
  refine ⟨fun h1 => ?_, fun h2 => ?_⟩
  · have h_prod_zero : g₂ (σ : ℂ) * E₂₁ (σ : ℂ) = 0 := by
      rw [← h_eq_σ, h1, zero_mul]
    rcases mul_eq_zero.mp h_prod_zero with h2 | h_abs
    · exact h2
    · exact False.elim (hE₂₁_σ_ne h_abs)
  · have h_prod_zero : g₁ (σ : ℂ) * E₁₂ (σ : ℂ) = 0 := by
      rw [h_eq_σ, h2, zero_mul]
    rcases mul_eq_zero.mp h_prod_zero with h1 | h_abs
    · exact h1
    · exact False.elim (hE₁₂_σ_ne h_abs)

theorem mitsui_ray_char_LSeries_norm_mul_dedekindZeta_ge_one {K : Type u} [Field K] [NumberField K]
    (χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ I‖ ≤ 1)
    (s : ℂ) (σ₀ : ℝ) (hσ₀ : 1 < σ₀) (hs : σ₀ ≤ s.re) :
    1 ≤ ‖LSeries (fun n =>
      ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
        χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s‖ *
      ‖NumberField.dedekindZeta K (σ₀ : ℂ)‖ :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let S : ℕ → Type u := fun e => {I : Ideal R // Ideal.absNorm I = e}
  let S' : ℕ → Type u := fun e => {I : Ideal R // I ≠ ⊥ ∧ Ideal.absNorm I = e}
  let S_sq' : ℕ → Type u := fun e =>
    {B : Ideal R // B ≠ ⊥ ∧ Ideal.absNorm B = e ∧ (UniqueFactorizationMonoid.normalizedFactors B).Nodup}
  let a_K : ℕ → ℕ := fun n => Nat.card (S n)
  let a_χ : ℕ → ℂ := fun n =>
    ∑' I : S' n, χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩
  have hS_fin : ∀ e : ℕ, Finite (S e) := fun e => Ideal.finite_setOf_absNorm_eq e
  have hS'_fin : ∀ e : ℕ, Finite (S' e) := fun e =>
    (Ideal.finite_setOf_absNorm_eq e).subset (fun _ h => h.2)
  have hS_sq'_fin : ∀ e : ℕ, Finite (S_sq' e) := fun e =>
    (Ideal.finite_setOf_absNorm_eq e).subset (fun _ h => h.2.1)
  letI : ∀ e, Fintype (S e) := fun e => Fintype.ofFinite (S e)
  letI : ∀ e, Fintype (S' e) := fun e => Fintype.ofFinite (S' e)
  letI : ∀ e, Fintype (S_sq' e) := fun e => Fintype.ofFinite (S_sq' e)
  have ha_nonneg : ∀ n : ℕ, 0 ≤ (a_K n : ℝ) := fun _ => Nat.cast_nonneg _
  have h_ideal_card : ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ x : ℝ, 1 ≤ x →
      (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ * x := by
    set L_K : ℝ :=
      2 ^ NumberField.InfinitePlace.nrRealPlaces K *
        (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
        NumberField.Units.regulator K *
        (NumberField.classNumber K : ℝ) /
        ((NumberField.Units.torsionOrder K : ℝ) * Real.sqrt |(NumberField.discr K : ℝ)|)
    have h_tendsto : Filter.Tendsto
        (fun x : ℝ => (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x)
        Filter.atTop (nhds L_K) :=
      NumberField.Ideal.tendsto_norm_le_div_atTop K
    obtain ⟨S₀, hS₀⟩ := (Metric.tendsto_atTop.mp h_tendsto) 1 zero_lt_one
    let S₁ : ℝ := max S₀ 1
    let N₁ : ℕ := Nat.card {J : Ideal R // Ideal.absNorm J ≤ ⌊S₁⌋₊}
    let C₁ : ℝ := max (|L_K| + 1) ((N₁ : ℝ) + 1)
    have hC₁_pos : 0 < C₁ := by
      have h1 : 0 ≤ |L_K| := abs_nonneg L_K
      have h2 : |L_K| + 1 ≤ C₁ := le_max_left _ _
      linarith
    refine ⟨C₁, hC₁_pos, ?_⟩
    intro x hx
    have hx_pos : 0 < x := lt_of_lt_of_le zero_lt_one hx
    by_cases hS : S₁ ≤ x
    · have hS₀_le : S₀ ≤ x := le_trans (le_max_left S₀ 1) hS
      have h_dist := hS₀ x hS₀_le
      rw [Real.dist_eq] at h_dist
      have h_sub : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x - L_K < 1 :=
        (abs_sub_lt_iff.mp h_dist).1
      have h_abs : L_K ≤ |L_K| := le_abs_self L_K
      have h_max : |L_K| + 1 ≤ C₁ := le_max_left _ _
      have h_div_le : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x ≤ C₁ := by linarith
      exact (div_le_iff₀ hx_pos).mp h_div_le
    · have hx_le : x ≤ S₁ := le_of_not_ge hS
      have h_sub : {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ x} ⊆
          {J : Ideal R | Ideal.absNorm J ≤ ⌊S₁⌋₊} := by
        intro J hJ
        exact Nat.le_floor (le_trans hJ hx_le)
      have h_fin : {J : Ideal R | Ideal.absNorm J ≤ ⌊S₁⌋₊}.Finite :=
        Ideal.finite_setOf_absNorm_le ⌊S₁⌋₊
      have h_card_le : Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} ≤ N₁ :=
        Nat.card_mono h_fin h_sub
      have h_card_real : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ (N₁ : ℝ) := by
        exact_mod_cast h_card_le
      have h_max : (N₁ : ℝ) + 1 ≤ C₁ := le_max_right _ _
      have h_le_C₁ : (Nat.card {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ := by linarith
      nlinarith
  obtain ⟨C₁, hC₁_pos, hC₁⟩ := h_ideal_card
  have ha_summable_all : ∀ w : ℂ, 1 < w.re → LSeriesSummable (fun n => (a_K n : ℂ)) w := by
    intro w hw
    have ha_sum_bound : ∀ N : ℕ, 1 ≤ N →
        (∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ)) ≤ C₁ * (N : ℝ) ^ (1 : ℝ) := by
      intro N hN
      have hN_real : (1 : ℝ) ≤ (N : ℝ) := by exact_mod_cast hN
      let S_J := {J : Ideal R // (Ideal.absNorm J : ℝ) ≤ (N : ℝ)}
      have hSJ_fin : {J : Ideal R | (Ideal.absNorm J : ℝ) ≤ (N : ℝ)}.Finite := by
        apply Set.Finite.subset (Ideal.finite_setOf_absNorm_le N)
        intro J hJ
        exact_mod_cast hJ
      haveI : Finite S_J := hSJ_fin
      let S_pos := {J : Ideal R // 1 ≤ Ideal.absNorm J ∧ Ideal.absNorm J ≤ N}
      have hS_pos_fin : {J : Ideal R | 1 ≤ Ideal.absNorm J ∧ Ideal.absNorm J ≤ N}.Finite :=
        (Ideal.finite_setOf_absNorm_le N).subset (fun _ h => h.2)
      haveI : Finite S_pos := hS_pos_fin
      letI : Fintype S_pos := Fintype.ofFinite S_pos
      let g : S_pos → ℕ := fun J => Ideal.absNorm J.1
      have hg : ∀ J ∈ (Finset.univ : Finset S_pos), g J ∈ Finset.Icc 1 N := by
        intro J _
        rw [Finset.mem_Icc]
        exact J.2
      have h_sum_eq : (∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ)) = (Nat.card S_pos : ℝ) := by
        have h1 : (∑ _J : S_pos, (1 : ℝ)) = (Nat.card S_pos : ℝ) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one, ← Nat.card_eq_fintype_card]
        rw [← h1, ← Finset.sum_fiberwise_of_maps_to hg (fun _ => (1 : ℝ))]
        refine Finset.sum_congr rfl (fun k hk => ?_)
        rw [Finset.mem_Icc] at hk
        let e_k : S k ≃ {J : S_pos // g J = k} :=
          { toFun := fun I => ⟨⟨I.1, ⟨by rw [I.2]; exact hk.1, by rw [I.2]; exact hk.2⟩⟩, I.2⟩
            invFun := fun J => ⟨J.1.1, J.2⟩
            left_inv := fun _ => by apply Subtype.ext; rfl
            right_inv := fun _ => by apply Subtype.ext; apply Subtype.ext; rfl }
        rw [Finset.sum_const, nsmul_eq_mul, mul_one]
        have h_card : ((Finset.univ.filter (fun J : S_pos => g J = k)).card : ℝ) =
            (Fintype.card {J : S_pos // g J = k} : ℝ) := by
          rw [Fintype.card_subtype]
        rw [h_card, ← Fintype.card_congr e_k, ← Nat.card_eq_fintype_card]
      let ι : S_pos → S_J := fun J => ⟨J.1, by exact_mod_cast J.2.2⟩
      have hι_inj : Function.Injective ι := fun a b h => Subtype.ext (congrArg (fun x : S_J => x.1) h)
      have h_le_SJ : (Nat.card S_pos : ℝ) ≤ (Nat.card S_J : ℝ) := by
        exact_mod_cast Nat.card_le_card_of_injective ι hι_inj
      rw [h_sum_eq, Real.rpow_one]
      exact le_trans h_le_SJ (hC₁ (N : ℝ) hN_real)
    have h_bigO : (fun N : ℕ => ∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ)) =O[Filter.atTop]
        (fun N : ℕ => (N : ℝ) ^ (1 : ℝ)) := by
      refine Asymptotics.IsBigO.of_bound C₁ ?_
      rw [Filter.eventually_atTop]
      refine ⟨1, fun N hN => ?_⟩
      have h_sum_nonneg : 0 ≤ ∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ) :=
        Finset.sum_nonneg (fun k _ => ha_nonneg k)
      have hN_nonneg : 0 ≤ (N : ℝ) ^ (1 : ℝ) := by positivity
      rw [Real.norm_of_nonneg h_sum_nonneg, Real.norm_of_nonneg hN_nonneg]
      exact ha_sum_bound N hN
    have h_sum_real := LSeriesSummable_of_sum_norm_bigO_and_nonneg h_bigO ha_nonneg zero_le_one hw
    simpa [a_K, S] using h_sum_real
  have ha_χ_bound : ∀ n : ℕ, ‖a_χ n‖ ≤ (a_K n : ℝ) := by
    intro n
    dsimp [a_χ, a_K]
    rw [tsum_fintype]
    have h_inj : Function.Injective (fun I : S' n => (⟨I.1, I.2.2⟩ : S n)) :=
      fun a b h => Subtype.ext (congrArg (fun x : S n => x.1) h)
    have h_card : (Nat.card (S' n) : ℝ) ≤ (Nat.card (S n) : ℝ) := by
      exact_mod_cast Nat.card_le_card_of_injective _ h_inj
    calc ‖∑ I : S' n, χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖
        ≤ ∑ I : S' n, ‖χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖ := norm_sum_le _ _
      _ ≤ ∑ _I : S' n, (1 : ℝ) := Finset.sum_le_sum (fun I _ => hχ_norm _)
      _ = (Nat.card (S' n) : ℝ) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one, ← Nat.card_eq_fintype_card]
      _ ≤ (Nat.card (S n) : ℝ) := h_card
  let m_χ : ℕ → ℂ := fun e =>
    ∑ B : S_sq' e,
      (-1 : ℂ) ^ (UniqueFactorizationMonoid.normalizedFactors B.1).card *
        χ ⟨B.1, mem_nonZeroDivisors_of_ne_zero B.2.1⟩
  have hm_χ_bound : ∀ n : ℕ, ‖m_χ n‖ ≤ (a_K n : ℝ) := by
    intro n
    dsimp [m_χ, a_K]
    have h_abs : ∀ B : S_sq' n,
        ‖(-1 : ℂ) ^ (UniqueFactorizationMonoid.normalizedFactors B.1).card *
          χ ⟨B.1, mem_nonZeroDivisors_of_ne_zero B.2.1⟩‖ ≤ (1 : ℝ) := by
      intro B
      rw [norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
      exact hχ_norm _
    have h_inj : Function.Injective (fun B : S_sq' n => (⟨B.1, B.2.2.1⟩ : S n)) :=
      fun a b h => Subtype.ext (congrArg (fun x : S n => x.1) h)
    have h_card : (Nat.card (S_sq' n) : ℝ) ≤ (Nat.card (S n) : ℝ) := by
      exact_mod_cast Nat.card_le_card_of_injective _ h_inj
    calc ‖∑ B : S_sq' n,
          (-1 : ℂ) ^ (UniqueFactorizationMonoid.normalizedFactors B.1).card *
            χ ⟨B.1, mem_nonZeroDivisors_of_ne_zero B.2.1⟩‖
        ≤ ∑ B : S_sq' n,
            ‖(-1 : ℂ) ^ (UniqueFactorizationMonoid.normalizedFactors B.1).card *
              χ ⟨B.1, mem_nonZeroDivisors_of_ne_zero B.2.1⟩‖ := norm_sum_le _ _
      _ ≤ ∑ _B : S_sq' n, (1 : ℝ) := Finset.sum_le_sum (fun B _ => h_abs B)
      _ = (Nat.card (S_sq' n) : ℝ) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one, ← Nat.card_eq_fintype_card]
      _ ≤ (Nat.card (S n) : ℝ) := h_card
  have hm_conv : LSeries.convolution a_χ m_χ = LSeries.delta := by
    funext n
    rw [LSeries.convolution_def]
    by_cases hn : n = 0
    · subst hn
      simp [LSeries.delta]
    · change (∑ p ∈ n.divisorsAntidiagonal, a_χ p.1 * m_χ p.2) = LSeries.delta n
      let f_I : S' n → Multiset (Ideal R) := fun I => UniqueFactorizationMonoid.normalizedFactors I.1
      let H₂ : Finset (Σ uv : ℕ × ℕ, S' uv.1 × S_sq' uv.2) :=
        n.divisorsAntidiagonal.sigma (fun uv =>
          (Finset.univ : Finset (S' uv.1)) ×ˢ (Finset.univ : Finset (S_sq' uv.2)))
      let G₂ : Finset (Σ I : S' n, Finset (Ideal R)) :=
        (Finset.univ : Finset (S' n)).sigma (fun I => (f_I I).toFinset.powerset)
      have h_lhs : (∑ p ∈ n.divisorsAntidiagonal, a_χ p.1 * m_χ p.2) =
          ∑ y ∈ H₂,
            χ ⟨y.2.1.1, mem_nonZeroDivisors_of_ne_zero y.2.1.2.1⟩ *
              ((-1 : ℂ) ^ (UniqueFactorizationMonoid.normalizedFactors y.2.2.1).card *
                χ ⟨y.2.2.1, mem_nonZeroDivisors_of_ne_zero y.2.2.2.1⟩) := by
        dsimp [H₂]
        rw [Finset.sum_sigma]
        refine Finset.sum_congr rfl (fun uv _ => ?_)
        have h1 : a_χ uv.1 = ∑ A : S' uv.1, χ ⟨A.1, mem_nonZeroDivisors_of_ne_zero A.2.1⟩ :=
          tsum_fintype _
        rw [h1]
        dsimp [m_χ]
        rw [Finset.sum_mul_sum, ← Finset.sum_product']
        refine Finset.sum_congr (by ext; simp) (fun _ _ => rfl)
      have h_bij :
          (∑ y ∈ H₂,
            χ ⟨y.2.1.1, mem_nonZeroDivisors_of_ne_zero y.2.1.2.1⟩ *
              ((-1 : ℂ) ^ (UniqueFactorizationMonoid.normalizedFactors y.2.2.1).card *
                χ ⟨y.2.2.1, mem_nonZeroDivisors_of_ne_zero y.2.2.2.1⟩)) =
          ∑ x ∈ G₂,
            (-1 : ℂ) ^ x.2.card * χ ⟨x.1.1, mem_nonZeroDivisors_of_ne_zero x.1.2.1⟩ := by
        refine Finset.sum_bij (fun y hy => ⟨⟨y.2.1.1 * y.2.2.1,
            ⟨mul_ne_zero y.2.1.2.1 y.2.2.2.1, by
              rw [map_mul, y.2.1.2.2, y.2.2.2.2.1]
              exact (Nat.mem_divisorsAntidiagonal.mp (Finset.mem_sigma.mp hy).1).1⟩⟩,
          (UniqueFactorizationMonoid.normalizedFactors y.2.2.1).toFinset⟩) ?_ ?_ ?_ ?_
        · intro y hy
          dsimp [G₂, f_I]
          rw [Finset.mem_sigma]
          refine ⟨Finset.mem_univ _, Finset.mem_powerset.mpr ?_⟩
          have hA_ne : y.2.1.1 ≠ 0 := y.2.1.2.1
          have hB_ne : y.2.2.1 ≠ 0 := y.2.2.2.1
          have h_add : UniqueFactorizationMonoid.normalizedFactors (y.2.1.1 * y.2.2.1) =
              UniqueFactorizationMonoid.normalizedFactors y.2.1.1 +
              UniqueFactorizationMonoid.normalizedFactors y.2.2.1 :=
            UniqueFactorizationMonoid.normalizedFactors_mul hA_ne hB_ne
          intro P hP
          rw [Multiset.mem_toFinset] at hP ⊢
          rw [h_add, Multiset.mem_add]
          exact Or.inr hP
        · intro y₁ hy₁ y₂ hy₂ h_eq
          have hI_eq : y₁.2.1.1 * y₁.2.2.1 = y₂.2.1.1 * y₂.2.2.1 :=
            congrArg (fun x : Σ I : S' n, Finset (Ideal R) => x.1.1) h_eq
          have hT_eq : (UniqueFactorizationMonoid.normalizedFactors y₁.2.2.1).toFinset =
              (UniqueFactorizationMonoid.normalizedFactors y₂.2.2.1).toFinset :=
            congrArg (fun x : Σ I : S' n, Finset (Ideal R) => x.2) h_eq
          have hf_eq : UniqueFactorizationMonoid.normalizedFactors y₁.2.2.1 =
              UniqueFactorizationMonoid.normalizedFactors y₂.2.2.1 := by
            have h1 : (UniqueFactorizationMonoid.normalizedFactors y₁.2.2.1).toFinset.val =
                UniqueFactorizationMonoid.normalizedFactors y₁.2.2.1 :=
              Multiset.dedup_eq_self.mpr y₁.2.2.2.2.2
            have h2 : (UniqueFactorizationMonoid.normalizedFactors y₂.2.2.1).toFinset.val =
                UniqueFactorizationMonoid.normalizedFactors y₂.2.2.1 :=
              Multiset.dedup_eq_self.mpr y₂.2.2.2.2.2
            rw [← h1, ← h2, hT_eq]
          have hB₁_ne : y₁.2.2.1 ≠ ⊥ := y₁.2.2.2.1
          have hB₂_ne : y₂.2.2.1 ≠ ⊥ := y₂.2.2.2.1
          have hB_val_eq : y₁.2.2.1 = y₂.2.2.1 := by
            rw [← prod_normalizedFactors_eq_self hB₁_ne, ← prod_normalizedFactors_eq_self hB₂_ne]
            exact congrArg Multiset.prod hf_eq
          have hA_val_eq : y₁.2.1.1 = y₂.2.1.1 := by
            rw [← hB_val_eq] at hI_eq
            exact mul_right_cancel₀ hB₁_ne hI_eq
          have hd_eq : y₁.1.1 = y₂.1.1 := by
            rw [← y₁.2.1.2.2, ← y₂.2.1.2.2, hA_val_eq]
          have he_eq : y₁.1.2 = y₂.1.2 := by
            rw [← y₁.2.2.2.2.1, ← y₂.2.2.2.2.1, hB_val_eq]
          have huv_eq : y₁.1 = y₂.1 := Prod.ext hd_eq he_eq
          rcases y₁ with ⟨uv₁, A₁, B₁⟩
          rcases y₂ with ⟨uv₂, A₂, B₂⟩
          dsimp at huv_eq hA_val_eq hB_val_eq
          subst huv_eq
          congr 1
          exact Prod.ext (Subtype.ext hA_val_eq) (Subtype.ext hB_val_eq)
        · intro x hx
          rcases x with ⟨I, T⟩
          have hT_sub : T ⊆ (f_I I).toFinset := Finset.mem_powerset.mp (Finset.mem_sigma.mp hx).2
          have hI_ne : I.1 ≠ ⊥ := I.2.1
          have hT_le : T.val ≤ f_I I :=
            le_trans (Finset.val_le_iff.mpr hT_sub) (Multiset.dedup_le (f_I I))
          have hT_prime : ∀ P ∈ T.val, Prime P := by
            intro P hP
            have hP_mem : P ∈ f_I I := Multiset.mem_of_le hT_le hP
            have hP_info := (Ideal.mem_normalizedFactors_iff hI_ne).mp hP_mem
            have hP_ne : P ≠ ⊥ := by
              intro hbot
              rw [hbot, le_bot_iff] at hP_info
              exact hI_ne hP_info.2
            exact Ideal.prime_of_isPrime hP_ne hP_info.1
          let A_val : Ideal R := (f_I I - T.val).prod
          let B_val : Ideal R := T.val.prod
          have hAB_mul : A_val * B_val = I.1 := by
            dsimp [A_val, B_val, f_I]
            rw [← Multiset.prod_add, Multiset.sub_add_cancel hT_le, prod_normalizedFactors_eq_self hI_ne]
          have hA_ne : A_val ≠ ⊥ := left_ne_zero_of_mul (by rw [hAB_mul]; exact hI_ne)
          have hB_ne : B_val ≠ ⊥ := right_ne_zero_of_mul (by rw [hAB_mul]; exact hI_ne)
          have hf_B : UniqueFactorizationMonoid.normalizedFactors B_val = T.val :=
            UniqueFactorizationMonoid.normalizedFactors_prod_of_prime hT_prime
          let d : ℕ := Ideal.absNorm A_val
          let e : ℕ := Ideal.absNorm B_val
          have hde : d * e = n := by
            dsimp [d, e]
            rw [← map_mul, hAB_mul, I.2.2]
          let uv : ℕ × ℕ := (d, e)
          let A : S' d := ⟨A_val, ⟨hA_ne, rfl⟩⟩
          let B : S_sq' e := ⟨B_val, ⟨hB_ne, rfl, by rw [hf_B]; exact T.nodup⟩⟩
          refine ⟨⟨uv, (A, B)⟩, ?_, ?_⟩
          · dsimp [H₂]
            rw [Finset.mem_sigma]
            exact ⟨Nat.mem_divisorsAntidiagonal.mpr ⟨hde, hn⟩,
              Finset.mem_product.mpr ⟨Finset.mem_univ _, Finset.mem_univ _⟩⟩
          · refine Sigma.ext (Subtype.ext hAB_mul) ?_
            apply heq_of_eq
            dsimp [B]
            rw [hf_B]
            exact Finset.ext (fun _ => Multiset.mem_toFinset)
        · intro y _
          dsimp
          rw [Multiset.toFinset_card_of_nodup y.2.2.2.2.2, mul_left_comm]
          congr 1
          rw [← map_mul]
          exact congrArg χ (Subtype.ext rfl)
      rw [h_lhs, h_bij]
      dsimp [G₂]
      rw [Finset.sum_sigma]
      have h_powerset :
          (∑ I : S' n, ∑ T ∈ (f_I I).toFinset.powerset,
            (-1 : ℂ) ^ T.card * χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) =
          ∑ I : S' n,
            (if (f_I I).toFinset = ∅ then (1 : ℂ) else 0) *
              χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩ := by
        refine Finset.sum_congr rfl (fun I _ => ?_)
        rw [← Finset.sum_mul]
        congr 1
        have h1 := @Finset.sum_powerset_neg_one_pow_card (Ideal R) _ ((f_I I).toFinset)
        have h2 := congrArg (Int.cast : ℤ → ℂ) h1
        push_cast at h2
        exact h2
      rw [h_powerset]
      by_cases hn1 : n = 1
      · subst hn1
        have h_delta : LSeries.delta 1 = (1 : ℂ) := rfl
        rw [h_delta]
        let I_top : S' 1 := ⟨⊤, ⟨top_ne_bot, Ideal.absNorm_top⟩⟩
        have h_single :
            (∑ I : S' 1,
              (if (f_I I).toFinset = ∅ then (1 : ℂ) else 0) *
                χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) =
            (if (f_I I_top).toFinset = ∅ then (1 : ℂ) else 0) *
              χ ⟨I_top.1, mem_nonZeroDivisors_of_ne_zero I_top.2.1⟩ := by
          refine Finset.sum_eq_single I_top (fun I _ hI_ne_top => ?_)
            (fun h_abs => False.elim (h_abs (Finset.mem_univ I_top)))
          exfalso
          apply hI_ne_top
          exact Subtype.ext (Ideal.absNorm_eq_one_iff.mp I.2.2)
        rw [h_single]
        have h_top_ne : (⊤ : Ideal R) ≠ ⊥ := top_ne_bot
        have h_top_unit : IsUnit (⊤ : Ideal R) := Ideal.isUnit_iff.mpr rfl
        have h_top_nf : f_I I_top = 0 :=
          (UniqueFactorizationMonoid.normalizedFactors_eq_zero_iff h_top_ne).mpr h_top_unit
        have h_top_one :
            (⟨I_top.1, mem_nonZeroDivisors_of_ne_zero I_top.2.1⟩ : nonZeroDivisors (Ideal R)) = 1 :=
          Subtype.ext Ideal.one_eq_top.symm
        rw [h_top_nf, Multiset.toFinset_zero, if_pos rfl, one_mul, h_top_one, map_one]
      · have h_delta : LSeries.delta n = 0 := if_neg hn1
        rw [h_delta]
        refine Finset.sum_eq_zero (fun I _ => ?_)
        have hI_ne : I.1 ≠ ⊥ := I.2.1
        have hI_not_top : I.1 ≠ ⊤ := by
          intro htop
          have h1 : Ideal.absNorm I.1 = 1 := Ideal.absNorm_eq_one_iff.mpr htop
          rw [I.2.2] at h1
          exact hn1 h1
        have h_not_empty : (f_I I).toFinset ≠ ∅ := by
          dsimp [f_I]
          rw [Multiset.toFinset_eq_empty,
            UniqueFactorizationMonoid.normalizedFactors_eq_zero_iff hI_ne, Ideal.isUnit_iff]
          exact hI_not_top
        rw [if_neg h_not_empty, zero_mul]
  have hs_re : 1 < s.re := lt_of_lt_of_le hσ₀ hs
  have hσ₀_re : 1 < (σ₀ : ℂ).re := by simpa using hσ₀
  have h_sum_s : Summable (LSeries.term (fun n => (a_K n : ℂ)) s) := ha_summable_all s hs_re
  have h_sum_σ₀ : Summable (LSeries.term (fun n => (a_K n : ℂ)) (σ₀ : ℂ)) :=
    ha_summable_all (σ₀ : ℂ) hσ₀_re
  have h_term_a_le_s : ∀ n : ℕ,
      ‖LSeries.term a_χ s n‖ ≤ ‖LSeries.term (fun k => (a_K k : ℂ)) s n‖ := by
    intro n
    by_cases hn : n = 0
    · subst hn; simp [LSeries.term]
    · rw [LSeries.norm_term_eq, LSeries.norm_term_eq, if_neg hn, if_neg hn]
      refine div_le_div_of_nonneg_right ?_ (Real.rpow_nonneg (Nat.cast_nonneg n) s.re)
      rw [Complex.norm_natCast]
      exact ha_χ_bound n
  have h_term_m_le_s : ∀ n : ℕ,
      ‖LSeries.term m_χ s n‖ ≤ ‖LSeries.term (fun k => (a_K k : ℂ)) s n‖ := by
    intro n
    by_cases hn : n = 0
    · subst hn; simp [LSeries.term]
    · rw [LSeries.norm_term_eq, LSeries.norm_term_eq, if_neg hn, if_neg hn]
      refine div_le_div_of_nonneg_right ?_ (Real.rpow_nonneg (Nat.cast_nonneg n) s.re)
      rw [Complex.norm_natCast]
      exact hm_χ_bound n
  have ha_χ_sum : LSeriesSummable a_χ s :=
    Summable.of_norm_bounded h_sum_s.norm h_term_a_le_s
  have hm_χ_sum : LSeriesSummable m_χ s :=
    Summable.of_norm_bounded h_sum_s.norm h_term_m_le_s
  have hL_mul_one : LSeries a_χ s * LSeries m_χ s = 1 := by
    rw [← LSeries_convolution' ha_χ_sum hm_χ_sum, hm_conv, LSeries_delta, Pi.one_apply]
  have hζ_def : NumberField.dedekindZeta K = LSeries (fun n => (a_K n : ℂ)) := rfl
  have h_term_le_s_σ₀ : ∀ n : ℕ,
      ‖LSeries.term (fun k => (a_K k : ℂ)) s n‖ ≤
        ‖LSeries.term (fun k => (a_K k : ℂ)) (σ₀ : ℂ) n‖ :=
    LSeries.norm_term_le_of_re_le_re (fun k => (a_K k : ℂ)) (by simpa using hs)
  have h_term_m_le : ∀ n : ℕ,
      ‖LSeries.term m_χ s n‖ ≤ ‖LSeries.term (fun k => (a_K k : ℂ)) (σ₀ : ℂ) n‖ :=
    fun n => le_trans (h_term_m_le_s n) (h_term_le_s_σ₀ n)
  have h_term_re : ∀ n : ℕ,
      ‖LSeries.term (fun k => (a_K k : ℂ)) (σ₀ : ℂ) n‖ =
        (LSeries.term (fun k => (a_K k : ℂ)) (σ₀ : ℂ) n).re := by
    intro n
    by_cases hn : n = 0
    · subst hn; simp [LSeries.term]
    · rw [LSeries.norm_term_eq, if_neg hn, LSeries.term_of_ne_zero hn]
      have hn_nonneg : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
      have h_cpow : (n : ℂ) ^ (σ₀ : ℂ) = (((n : ℝ) ^ σ₀ : ℝ) : ℂ) := by
        rw [← Complex.ofReal_natCast, Complex.ofReal_cpow hn_nonneg]
      have ha_cast : (a_K n : ℂ) = ((a_K n : ℝ) : ℂ) := (Complex.ofReal_natCast (a_K n)).symm
      rw [Complex.norm_natCast, ha_cast, h_cpow, ← Complex.ofReal_div, Complex.ofReal_re,
        Complex.ofReal_re]
  have hm_le_ζ : ‖LSeries m_χ s‖ ≤ ‖NumberField.dedekindZeta K (σ₀ : ℂ)‖ := by
    rw [hζ_def]
    calc ‖LSeries m_χ s‖
        ≤ ∑' n : ℕ, ‖LSeries.term m_χ s n‖ :=
          norm_tsum_le_tsum_norm hm_χ_sum.norm
      _ ≤ ∑' n : ℕ, ‖LSeries.term (fun k => (a_K k : ℂ)) (σ₀ : ℂ) n‖ :=
          hm_χ_sum.norm.tsum_le_tsum h_term_m_le h_sum_σ₀.norm
      _ = ∑' n : ℕ, (LSeries.term (fun k => (a_K k : ℂ)) (σ₀ : ℂ) n).re := by
          congr 1; ext n; exact h_term_re n
      _ = (LSeries (fun n => (a_K n : ℂ)) (σ₀ : ℂ)).re :=
          (Complex.re_tsum h_sum_σ₀).symm
      _ ≤ ‖LSeries (fun n => (a_K n : ℂ)) (σ₀ : ℂ)‖ :=
          le_trans (le_abs_self _) (Complex.abs_re_le_norm _)
  calc (1 : ℝ)
      = ‖(1 : ℂ)‖ := norm_one.symm
    _ = ‖LSeries a_χ s * LSeries m_χ s‖ := by rw [hL_mul_one]
    _ = ‖LSeries a_χ s‖ * ‖LSeries m_χ s‖ := norm_mul _ _
    _ ≤ ‖LSeries a_χ s‖ * ‖NumberField.dedekindZeta K (σ₀ : ℂ)‖ :=
        mul_le_mul_of_nonneg_left hm_le_ζ (norm_nonneg _)

theorem mitsui_ray_char_primePowers_four_factor_nonneg_and_LSeries_eq {K : Type u} [Field K] [NumberField K]
    (q₁ q₂ : Ideal (NumberField.RingOfIntegers K))
    (χ₁ χ₂ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ₁_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ → ‖χ₁ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤) → χ₁ I = 0))
    (hχ₁_real : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₁ = ⊤ → (χ₁ I) ^ 2 = 1)
    (hχ₂_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₂ = ⊤ → ‖χ₂ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₂ = ⊤) → χ₂ I = 0))
    (hχ₂_real : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q₂ = ⊤ → (χ₂ I) ^ 2 = 1) :
    ∃ Λ₄ : ℕ → ℝ,
      (∀ n : ℕ, 0 ≤ Λ₄ n) ∧
      (∀ s : ℂ, 1 < s.re →
        LSeriesSummable (fun n => (Λ₄ n : ℂ)) s ∧
        LSeries (fun n => (Λ₄ n : ℂ)) s =
          LSeries (fun n =>
            ((∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                  1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
                Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℝ) : ℂ)) s +
          LSeries (fun n =>
            ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                  1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
              (χ₁ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
                (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)) s +
          LSeries (fun n =>
            ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                  1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
              (χ₂ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
                (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)) s +
          LSeries (fun n =>
            ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                  1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
              ((χ₁ * χ₂) ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
                (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)) s) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let F : ℕ → Type u := fun d =>
    {pm : IsDedekindDomain.HeightOneSpectrum R × ℕ //
      1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = d}
  let Λ_K : ℕ → ℝ := fun n =>
    ∑' pm : F n, Real.log (Ideal.absNorm pm.1.1.asIdeal)
  let f₀ : ℕ → ℂ := fun n => (Λ_K n : ℂ)
  let Λ_char : (nonZeroDivisors (Ideal R) →* ℂ) → ℕ → ℂ := fun ψ n =>
    ∑' pm : F n,
      (ψ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
        (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)
  have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum R,
      2 ≤ Ideal.absNorm p.asIdeal := by
    intro p
    have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    omega
  have hF_fin : ∀ d : ℕ, Finite (F d) := by
    intro d
    let S_le := {J : Ideal R // Ideal.absNorm J ≤ d}
    haveI : Finite S_le := Ideal.finite_setOf_absNorm_le d
    have h_bounds : ∀ pm : F d, Ideal.absNorm pm.1.1.asIdeal ≤ d ∧ pm.1.2 < d + 1 := by
      intro pm
      have hm : 1 ≤ pm.1.2 := pm.2.1
      have hd : Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2 = d := pm.2.2
      have hk2 : 2 ≤ Ideal.absNorm pm.1.1.asIdeal := h_norm_ge_two pm.1.1
      have hk_pow : Ideal.absNorm pm.1.1.asIdeal ≤ Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2 :=
        Nat.le_self_pow (by omega) _
      have hk_le : Ideal.absNorm pm.1.1.asIdeal ≤ d := by omega
      have hm_lt : pm.1.2 < d + 1 := by
        have h1 : pm.1.2 < 2 ^ pm.1.2 := Nat.lt_two_pow_self
        have h2 : 2 ^ pm.1.2 ≤ Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2 := Nat.pow_le_pow_left hk2 _
        omega
      exact ⟨hk_le, hm_lt⟩
    let ψ : F d → S_le × Fin (d + 1) := fun pm =>
      (⟨pm.1.1.asIdeal, (h_bounds pm).1⟩, ⟨pm.1.2, (h_bounds pm).2⟩)
    have hψ_inj : Function.Injective ψ := by
      intro a b hab
      have h1 : a.1.1.asIdeal = b.1.1.asIdeal :=
        congrArg (fun x : S_le => x.1) (Prod.ext_iff.mp hab).1
      have h2 : a.1.2 = b.1.2 := congrArg Fin.val (Prod.ext_iff.mp hab).2
      exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext h1) h2)
    exact Finite.of_injective ψ hψ_inj
  letI : ∀ d, Fintype (F d) := fun d => Fintype.ofFinite (F d)
  have hΛ_nonneg : ∀ n : ℕ, 0 ≤ Λ_K n := by
    intro n
    dsimp [Λ_K]
    refine tsum_nonneg (fun pm => Real.log_nonneg ?_)
    have h2 := h_norm_ge_two pm.1.1
    exact_mod_cast (by omega : 1 ≤ Ideal.absNorm pm.1.1.asIdeal)
  have h_real_char : ∀ (q : Ideal R) (χ : nonZeroDivisors (Ideal R) →* ℂ),
      (∀ I : nonZeroDivisors (Ideal R),
        ((I : Ideal R) ⊔ q = ⊤ → ‖χ I‖ = 1) ∧
        (¬ ((I : Ideal R) ⊔ q = ⊤) → χ I = 0)) →
      (∀ I : nonZeroDivisors (Ideal R), (I : Ideal R) ⊔ q = ⊤ → (χ I) ^ 2 = 1) →
      (∀ I : nonZeroDivisors (Ideal R), ‖χ I‖ ≤ 1) ∧
      (∀ I : nonZeroDivisors (Ideal R), χ I = ((χ I).re : ℂ)) ∧
      (∀ I : nonZeroDivisors (Ideal R), |(χ I).re| ≤ 1) := by
    intro q χ h_supp h_sq
    have h_norm : ∀ I : nonZeroDivisors (Ideal R), ‖χ I‖ ≤ 1 := by
      intro I
      by_cases hI : (I : Ideal R) ⊔ q = ⊤
      · rw [(h_supp I).1 hI]
      · rw [(h_supp I).2 hI, norm_zero]
        exact zero_le_one
    have h_im : ∀ I : nonZeroDivisors (Ideal R), (χ I).im = 0 := by
      intro I
      by_cases hI : (I : Ideal R) ⊔ q = ⊤
      · rcases sq_eq_one_iff.mp (h_sq I hI) with h | h <;> simp [h]
      · simp [(h_supp I).2 hI]
    have h_eq_re : ∀ I : nonZeroDivisors (Ideal R), χ I = ((χ I).re : ℂ) := by
      intro I
      exact Complex.ext rfl (by simp [h_im I])
    have h_re_abs : ∀ I : nonZeroDivisors (Ideal R), |(χ I).re| ≤ 1 := by
      intro I
      exact le_trans (Complex.abs_re_le_norm (χ I)) (h_norm I)
    exact ⟨h_norm, h_eq_re, h_re_abs⟩
  obtain ⟨hχ₁_norm, hχ₁_eq_re, hχ₁_re_abs⟩ := h_real_char q₁ χ₁ hχ₁_norm_supp hχ₁_real
  obtain ⟨hχ₂_norm, hχ₂_eq_re, hχ₂_re_abs⟩ := h_real_char q₂ χ₂ hχ₂_norm_supp hχ₂_real
  have hχ₁₂_norm : ∀ I : nonZeroDivisors (Ideal R), ‖(χ₁ * χ₂) I‖ ≤ 1 := by
    intro I
    rw [MonoidHom.mul_apply, norm_mul]
    exact mul_le_one₀ (hχ₁_norm I) (norm_nonneg _) (hχ₂_norm I)
  have hχ₁₂_re_mul : ∀ I : nonZeroDivisors (Ideal R), ((χ₁ * χ₂) I).re = (χ₁ I).re * (χ₂ I).re := by
    intro I
    have h_eq : (χ₁ * χ₂) I = (((χ₁ I).re * (χ₂ I).re : ℝ) : ℂ) := by
      calc (χ₁ * χ₂) I
          = χ₁ I * χ₂ I := MonoidHom.mul_apply χ₁ χ₂ I
        _ = ((χ₁ I).re : ℂ) * ((χ₂ I).re : ℂ) := by rw [← hχ₁_eq_re I, ← hχ₂_eq_re I]
        _ = (((χ₁ I).re * (χ₂ I).re : ℝ) : ℂ) := (Complex.ofReal_mul _ _).symm
    rw [h_eq, Complex.ofReal_re]
  have hχ₁₂_eq_re : ∀ I : nonZeroDivisors (Ideal R), (χ₁ * χ₂) I = (((χ₁ * χ₂) I).re : ℂ) := by
    intro I
    calc (χ₁ * χ₂) I
        = χ₁ I * χ₂ I := MonoidHom.mul_apply χ₁ χ₂ I
