      rw [if_pos h0, if_pos h_prin]
      ring
    · have h0 : Additive.ofMul (ClassGroup.mk0 (I_pm pm)) ≠ 0 := fun hc => h_prin (h_iff.mp hc)
      rw [if_neg h0, if_neg h_prin, mul_zero]
  have h_inner_sum (pm : D_all) :
      (∑ η : AddChar G ℂ, (χ_twist η (p_nz pm)) ^ pm.1.2 * w pm) =
        if hp : P_prin pm then
          (Fintype.card G : ℂ) * (ψ (Additive.ofMul hp.choose_spec.unit) * w pm)
        else 0 := by
    rw [h_sum_eta_orth pm]
    by_cases h_prin : (pm.1.1.asIdeal ^ pm.1.2).IsPrincipal
    · rw [if_pos h_prin]
      let g : NumberField.RingOfIntegers K :=
        @Submodule.IsPrincipal.generator _ _ _ _ _ (pm.1.1.asIdeal ^ pm.1.2) h_prin
      have h_span : Ideal.span ({g} : Set (NumberField.RingOfIntegers K)) =
          pm.1.1.asIdeal ^ pm.1.2 :=
        @Submodule.IsPrincipal.span_singleton_generator _ _ _ _ _ (pm.1.1.asIdeal ^ pm.1.2) h_prin
      have h_I_ne_zero : (I_pm pm : Ideal (NumberField.RingOfIntegers K)) ≠ 0 :=
        nonZeroDivisors.ne_zero (I_pm pm).2
      have h_span_ne_bot : Ideal.span ({g} : Set (NumberField.RingOfIntegers K)) ≠ ⊥ := by
        rw [h_span, ← h_I_pm_coe pm]
        exact h_I_ne_zero
      have hg_ne : g ≠ 0 := Ideal.span_singleton_eq_bot.not.mp h_span_ne_bot
      have h_I_eq : I_pm pm = ⟨Ideal.span ({g} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hg_ne)⟩ := by
        apply Subtype.ext
        exact (h_I_pm_coe pm).trans h_span.symm
      by_cases hg_unit : IsUnit (Ideal.Quotient.mk q g)
      · have hp : P_prin pm := ⟨h_prin, hg_unit⟩
        rw [dif_pos hp, h_I_eq, hχ₀_unit g hg_ne hg_unit]
      · have hnp : ¬ P_prin pm := by
          rintro ⟨h_prin', hg_unit'⟩
          exact hg_unit hg_unit'
        rw [dif_neg hnp, h_I_eq, hχ₀_not_unit g hg_ne hg_unit, zero_mul, mul_zero]
    · have hnp : ¬ P_prin pm := fun ⟨h_prin', _⟩ => h_prin h_prin'
      rw [if_neg h_prin, dif_neg hnp]
  let term_prin (pm : D_prin) : ℂ :=
    ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
      ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
        Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)
  let term_all_prin (pm : D_all) : ℂ :=
    if hp : P_prin pm then
      ψ (Additive.ofMul hp.choose_spec.unit) * w pm
    else 0
  let e_prin : D_prin ≃ {pm : D_all // P_prin pm} :=
    { toFun := fun pm =>
        ⟨⟨pm.1, ⟨pm.2.1, pm.2.2.choose_spec.1⟩⟩,
          ⟨pm.2.2.choose, pm.2.2.choose_spec.2⟩⟩
      invFun := fun pm =>
        ⟨pm.1.1, ⟨pm.1.2.1, ⟨pm.2.choose, pm.1.2.2, pm.2.choose_spec⟩⟩⟩
      left_inv := fun pm => by apply Subtype.ext; rfl
      right_inv := fun pm => by apply Subtype.ext; apply Subtype.ext; rfl }
  have h_term_e_prin (pm : D_prin) :
      term_prin pm = term_all_prin (e_prin pm).1 := by
    dsimp [term_prin, term_all_prin, w]
    rw [dif_pos (e_prin pm).2]
    rfl
  have h_sum_prin :
      (∑' pm : D_prin, term_prin pm) = ∑ pm : D_all, term_all_prin pm := by
    have h1 : (∑' pm : D_prin, term_prin pm) = ∑' pm : D_prin, term_all_prin (e_prin pm).1 :=
      tsum_congr h_term_e_prin
    have h2 : (∑' pm : D_prin, term_all_prin (e_prin pm).1) =
        ∑' pm : {pm : D_all // P_prin pm}, term_all_prin pm.1 :=
      Equiv.tsum_eq e_prin (fun pm : {pm : D_all // P_prin pm} => term_all_prin pm.1)
    rw [h1, h2, tsum_fintype]
    have h3 : (∑ pm : {pm : D_all // P_prin pm}, term_all_prin pm.1) =
        ∑ pm ∈ Finset.univ.filter (fun pm : D_all => P_prin pm), term_all_prin pm :=
      (Finset.sum_subtype (Finset.univ.filter (fun pm : D_all => P_prin pm))
        (fun _ => by simp) term_all_prin).symm
    have h4 : (∑ pm : D_all, term_all_prin pm) =
        (∑ pm ∈ Finset.univ.filter (fun pm : D_all => P_prin pm), term_all_prin pm) +
        (∑ pm ∈ Finset.univ.filter (fun pm : D_all => ¬ P_prin pm), term_all_prin pm) :=
      (Finset.sum_filter_add_sum_filter_not Finset.univ
        (fun pm : D_all => P_prin pm) term_all_prin).symm
    have h5 : (∑ pm ∈ Finset.univ.filter (fun pm : D_all => ¬ P_prin pm), term_all_prin pm) = 0 := by
      apply Finset.sum_eq_zero
      intro pm hpm
      have hnp : ¬ P_prin pm := (Finset.mem_filter.mp hpm).2
      dsimp [term_all_prin]
      rw [dif_neg hnp]
    rw [h3, h4, h5, add_zero]
  have h_double_sum :
      (Fintype.card G : ℂ) * (∑' pm : D_prin, term_prin pm) =
        ∑ η : AddChar G ℂ, ∑' pm : D_all, (χ_twist η (p_nz pm)) ^ pm.1.2 * w pm := by
    rw [h_sum_prin, Finset.mul_sum]
    have h_each (pm : D_all) :
        (Fintype.card G : ℂ) * term_all_prin pm =
          ∑ η : AddChar G ℂ, (χ_twist η (p_nz pm)) ^ pm.1.2 * w pm := by
      rw [h_inner_sum pm]
      dsimp [term_all_prin]
      split_ifs <;> ring
    simp_rw [h_each]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro η _
    exact (tsum_fintype _).symm
  have h_norm_double :
      (Fintype.card G : ℝ) * ‖∑' pm : D_prin, term_prin pm‖ ≤
        (Fintype.card G : ℝ) * B := by
    have h_lhs : (Fintype.card G : ℝ) * ‖∑' pm : D_prin, term_prin pm‖ =
        ‖(Fintype.card G : ℂ) * (∑' pm : D_prin, term_prin pm)‖ := by
      rw [norm_mul, Complex.norm_natCast]
    rw [h_lhs, h_double_sum]
    calc ‖∑ η : AddChar G ℂ, ∑' pm : D_all, (χ_twist η (p_nz pm)) ^ pm.1.2 * w pm‖
      _ ≤ ∑ η : AddChar G ℂ, ‖∑' pm : D_all, (χ_twist η (p_nz pm)) ^ pm.1.2 * w pm‖ :=
          norm_sum_le _ _
      _ ≤ (Finset.univ : Finset (AddChar G ℂ)).card • B :=
          Finset.sum_le_card_nsmul _ _ B (fun η _ => h_eta_bound η)
      _ = (Fintype.card G : ℝ) * B := by
          rw [Finset.card_univ, AddChar.card_eq, nsmul_eq_mul]
  have h_card_pos : (0 : ℝ) < (Fintype.card G : ℝ) := by
    exact_mod_cast Fintype.card_pos (α := G)
  exact le_of_mul_le_mul_left h_norm_double h_card_pos

theorem mitsui_riesz_principalPrimePower_char_bound_of_units_eq_one {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c₀ : ℝ, 0 < c₀ ∧
      ∀ Y : ℝ, 1 < Y →
        ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
          (Ideal.absNorm q : ℝ) < Real.log Y ^ A →
          ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
            (∀ u : (NumberField.RingOfIntegers K)ˣ,
              ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) →
            ‖∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                  1 ≤ pm.2 ∧
                  ∃ h : (pm.1.asIdeal ^ pm.2).IsPrincipal,
                  (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y ∧
                  IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ (pm.1.asIdeal ^ pm.2) h))},
                ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
                  ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                    Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)‖
              ≤ c₀ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₀) :=
by
  obtain ⟨c₀, hc₀_pos, hc₀⟩ := mitsui_riesz_primePower_ray_char_bound (K := K) A hA
  refine ⟨c₀, hc₀_pos, ?_⟩
  intro Y hY q hq hq_norm ψ hψ hψ_units
  have hY_pos : (0 : ℝ) < Y := by linarith
  set B : ℝ := c₀ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₀)
  have hB : 0 ≤ B := by
    dsimp [B]
    positivity
  obtain ⟨χ₀, hχ₀_unit, hχ₀_not_unit⟩ :=
    mitsui_exists_ideal_monoidHom_extending_unit_trivial_char q hq ψ hψ_units
  refine mitsui_riesz_principalPrimePower_le_of_ideal_monoidHom_bound
    Y q ψ B hB χ₀ hχ₀_unit hχ₀_not_unit ?_
  intro χ hχ_unit hχ_not_unit
  obtain ⟨hχ_ray, hχ_norm, hχ_nonprin⟩ :=
    mitsui_ideal_monoidHom_ray_properties_of_extending_char q hq ψ hψ χ hχ_unit hχ_not_unit
  exact hc₀ Y hY q hq hq_norm χ hχ_ray hχ_norm hχ_nonprin

theorem mitsui_principalPrimePower_char_riesz_forward_diff_le_uncond {K : Type u} [Field K] [NumberField K]
    (Y δ : ℝ) (hY : 0 < Y) (hδ : 0 < δ)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ) :
    ‖((∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            1 ≤ pm.2 ∧
            ∃ h : (pm.1.asIdeal ^ pm.2).IsPrincipal,
            (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Real.exp δ * Y ∧
            IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ (pm.1.asIdeal ^ pm.2) h))},
          ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
            ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
              Real.log ((Real.exp δ * Y) / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ))
        - (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              1 ≤ pm.2 ∧
              ∃ h : (pm.1.asIdeal ^ pm.2).IsPrincipal,
              (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y ∧
              IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ (pm.1.asIdeal ^ pm.2) h))},
            ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
              ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)))
      - (δ : ℂ) *
        (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              1 ≤ pm.2 ∧
              ∃ h : (pm.1.asIdeal ^ pm.2).IsPrincipal,
              (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y ∧
              IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ (pm.1.asIdeal ^ pm.2) h))},
            ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
              (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ))‖
      ≤ ((∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Real.exp δ * Y},
            Real.log (Ideal.absNorm pm.1.1.asIdeal) *
              Real.log ((Real.exp δ * Y) / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)))
          - (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
              Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))))
        - δ *
          (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
              Real.log (Ideal.absNorm pm.1.1.asIdeal)) :=
by
  classical
  have hq_bot : q ≠ ⊥ := hq
  haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
    Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
  set Z_plus : ℝ := Real.exp δ * Y
  have hexp_gt_one : 1 < Real.exp δ := Real.one_lt_exp_iff.mpr hδ
  have hY_le_Z : Y ≤ Z_plus :=
    le_mul_of_one_le_left (le_of_lt hY) (le_of_lt hexp_gt_one)
  have hZ_pos : 0 < Z_plus := mul_pos (Real.exp_pos δ) hY
  have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p.asIdeal := by
    intro p
    have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    omega
  have h_pm_bounds : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
      1 ≤ m → (Ideal.absNorm p.asIdeal : ℝ) ^ m ≤ Z_plus →
      Ideal.absNorm p.asIdeal ≤ ⌊Z_plus⌋₊ ∧ m ≤ ⌊Z_plus⌋₊ := by
    intro p m hm h_pow
    have hk2 : 2 ≤ Ideal.absNorm p.asIdeal := h_norm_ge_two p
    have h_pow_nat : ((Ideal.absNorm p.asIdeal ^ m : ℕ) : ℝ) ≤ Z_plus := by exact_mod_cast h_pow
    have h_km_le : Ideal.absNorm p.asIdeal ^ m ≤ ⌊Z_plus⌋₊ := Nat.le_floor h_pow_nat
    have hm_ne : m ≠ 0 := by omega
    have hk_le_km : Ideal.absNorm p.asIdeal ≤ Ideal.absNorm p.asIdeal ^ m :=
      Nat.le_self_pow hm_ne (Ideal.absNorm p.asIdeal)
    have hm_le_2m : m ≤ 2 ^ m := (Nat.lt_pow_self (by decide : 1 < 2)).le
    have h2m_le_km : 2 ^ m ≤ Ideal.absNorm p.asIdeal ^ m := Nat.pow_le_pow_left hk2 m
    exact ⟨le_trans hk_le_km h_km_le, le_trans (le_trans hm_le_2m h2m_le_km) h_km_le⟩
  let D_prin_Z := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧
    ∃ h : (pm.1.asIdeal ^ pm.2).IsPrincipal,
    (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Real.exp δ * Y ∧
    IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ (pm.1.asIdeal ^ pm.2) h))}
  let D_prin_Y := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧
    ∃ h : (pm.1.asIdeal ^ pm.2).IsPrincipal,
    (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y ∧
    IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ (pm.1.asIdeal ^ pm.2) h))}
  let D_all_Z := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Real.exp δ * Y}
  let D_all_Y := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y}
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Z_plus⌋₊}
  let S_prod : Set (Ideal (NumberField.RingOfIntegers K) × ℕ) :=
    S_id ×ˢ {m : ℕ | m ≤ ⌊Z_plus⌋₊}
  have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Z_plus⌋₊
  have hSprod_fin : S_prod.Finite := hSid_fin.prod (Set.finite_le_nat ⌊Z_plus⌋₊)
  haveI : Finite S_prod := hSprod_fin
  let f_prin_Z : D_prin_Z → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2), h_pm_bounds pm.1.1 pm.1.2 pm.2.1 pm.2.2.choose_spec.1⟩
  have hf_prin_Z_inj : Function.Injective f_prin_Z := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    dsimp [f_prin_Z] at hval
    exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext (Prod.mk.inj hval).1) (Prod.mk.inj hval).2)
  haveI : Finite D_prin_Z := Finite.of_injective f_prin_Z hf_prin_Z_inj
  letI : Fintype D_prin_Z := Fintype.ofFinite D_prin_Z
  let f_prin_Y : D_prin_Y → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2),
      h_pm_bounds pm.1.1 pm.1.2 pm.2.1 (le_trans pm.2.2.choose_spec.1 hY_le_Z)⟩
  have hf_prin_Y_inj : Function.Injective f_prin_Y := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    dsimp [f_prin_Y] at hval
    exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext (Prod.mk.inj hval).1) (Prod.mk.inj hval).2)
  haveI : Finite D_prin_Y := Finite.of_injective f_prin_Y hf_prin_Y_inj
  letI : Fintype D_prin_Y := Fintype.ofFinite D_prin_Y
  let f_all_Z : D_all_Z → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2), h_pm_bounds pm.1.1 pm.1.2 pm.2.1 pm.2.2⟩
  have hf_all_Z_inj : Function.Injective f_all_Z := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    dsimp [f_all_Z] at hval
    exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext (Prod.mk.inj hval).1) (Prod.mk.inj hval).2)
  haveI : Finite D_all_Z := Finite.of_injective f_all_Z hf_all_Z_inj
  letI : Fintype D_all_Z := Fintype.ofFinite D_all_Z
  let f_all_Y : D_all_Y → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2),
      h_pm_bounds pm.1.1 pm.1.2 pm.2.1 (le_trans pm.2.2 hY_le_Z)⟩
  have hf_all_Y_inj : Function.Injective f_all_Y := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    dsimp [f_all_Y] at hval
    exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext (Prod.mk.inj hval).1) (Prod.mk.inj hval).2)
  haveI : Finite D_all_Y := Finite.of_injective f_all_Y hf_all_Y_inj
  letI : Fintype D_all_Y := Fintype.ofFinite D_all_Y
  have h_log_split : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
      Real.log ((Real.exp δ * Y) / ((Ideal.absNorm p.asIdeal : ℝ) ^ m)) =
      Real.log (Y / ((Ideal.absNorm p.asIdeal : ℝ) ^ m)) + δ := by
    intro p m
    have hk_pos : (0 : ℝ) < (Ideal.absNorm p.asIdeal : ℝ) := by
      have := h_norm_ge_two p
      positivity
    have hpow_pos : (0 : ℝ) < (Ideal.absNorm p.asIdeal : ℝ) ^ m := pow_pos hk_pos m
    rw [Real.log_div (ne_of_gt hZ_pos) (ne_of_gt hpow_pos),
      Real.log_mul (ne_of_gt (Real.exp_pos δ)) (ne_of_gt hY),
      Real.log_exp,
      Real.log_div (ne_of_gt hY) (ne_of_gt hpow_pos)]
    ring
  let P_prin : D_prin_Z → Prop := fun pm =>
    (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 ≤ Y
  let P_all : D_all_Z → Prop := fun pm =>
    (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 ≤ Y
  let e_prin : D_prin_Y ≃ {pm : D_prin_Z // P_prin pm} :=
    { toFun := fun pm =>
        ⟨⟨pm.1, ⟨pm.2.1, ⟨pm.2.2.choose,
          le_trans pm.2.2.choose_spec.1 hY_le_Z, pm.2.2.choose_spec.2⟩⟩⟩,
          pm.2.2.choose_spec.1⟩
      invFun := fun pm =>
        ⟨pm.1.1, ⟨pm.1.2.1, ⟨pm.1.2.2.choose, pm.2, pm.1.2.2.choose_spec.2⟩⟩⟩
      left_inv := fun pm => by apply Subtype.ext; rfl
      right_inv := fun pm => by apply Subtype.ext; apply Subtype.ext; rfl }
  let e_all : D_all_Y ≃ {pm : D_all_Z // P_all pm} :=
    { toFun := fun pm =>
        ⟨⟨pm.1, ⟨pm.2.1, le_trans pm.2.2 hY_le_Z⟩⟩, pm.2.2⟩
      invFun := fun pm => ⟨pm.1.1, ⟨pm.1.2.1, pm.2⟩⟩
      left_inv := fun pm => by apply Subtype.ext; rfl
      right_inv := fun pm => by apply Subtype.ext; apply Subtype.ext; rfl }
  let term_prin_Z : D_prin_Z → ℂ := fun pm =>
    ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
      ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
        Real.log ((Real.exp δ * Y) / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)
  let term_prin_Y : D_prin_Y → ℂ := fun pm =>
    ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
      ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
        Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)
  let term_ψ_prin_Y : D_prin_Y → ℂ := fun pm =>
    ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
      (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)
  have h_term_prin_split : ∀ pm : D_prin_Y,
      term_prin_Z (e_prin pm).1 = term_prin_Y pm + (δ : ℂ) * term_ψ_prin_Y pm := by
    intro pm
    have hU : (e_prin pm).1.2.2.choose_spec.2.unit = pm.2.2.choose_spec.2.unit := by
      apply Units.ext
      simp only [IsUnit.unit_spec]
      rfl
    dsimp [term_prin_Z, term_prin_Y, term_ψ_prin_Y]
    rw [hU]
    change ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
        ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
          Real.log ((Real.exp δ * Y) / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ) =
      ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
        ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
          Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ) +
      (δ : ℂ) * (ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
        (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ))
    rw [h_log_split pm.1.1 pm.1.2]
    push_cast
    ring
  have h_sum_prin_filter :
      ∑ pm ∈ Finset.univ.filter P_prin, term_prin_Z pm =
      (∑' pm : D_prin_Y, term_prin_Y pm) +
        (δ : ℂ) * (∑' pm : D_prin_Y, term_ψ_prin_Y pm) := by
    have h1 : ∑ pm ∈ Finset.univ.filter P_prin, term_prin_Z pm =
        ∑' pm : {pm : D_prin_Z // P_prin pm}, term_prin_Z pm.1 := by
      rw [tsum_fintype]
      exact Finset.sum_subtype (Finset.univ.filter P_prin) (fun _ => by simp) term_prin_Z
    have h2 : (∑' pm : {pm : D_prin_Z // P_prin pm}, term_prin_Z pm.1) =
        ∑' pm : D_prin_Y, term_prin_Z (e_prin pm).1 :=
      (Equiv.tsum_eq e_prin (fun pm : {pm : D_prin_Z // P_prin pm} => term_prin_Z pm.1)).symm
    rw [h1, h2, tsum_congr h_term_prin_split, tsum_fintype, tsum_fintype, tsum_fintype,
      Finset.sum_add_distrib, ← Finset.mul_sum]
  have h_sum_prin_Z : (∑' pm : D_prin_Z, term_prin_Z pm) =
      (∑ pm ∈ Finset.univ.filter P_prin, term_prin_Z pm) +
      (∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm), term_prin_Z pm) := by
    rw [tsum_fintype]
    exact (Finset.sum_filter_add_sum_filter_not Finset.univ P_prin term_prin_Z).symm
  have h_lhs_eq :
      ((∑' pm : D_prin_Z, term_prin_Z pm) - (∑' pm : D_prin_Y, term_prin_Y pm)) -
        (δ : ℂ) * (∑' pm : D_prin_Y, term_ψ_prin_Y pm) =
      ∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm), term_prin_Z pm := by
    rw [h_sum_prin_Z, h_sum_prin_filter]
    ring
  let term_all_Z : D_all_Z → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal) *
      Real.log ((Real.exp δ * Y) / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
  let term_all_Y : D_all_Y → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal) *
      Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
  let term_ψ_all_Y : D_all_Y → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal)
  have h_term_all_split : ∀ pm : D_all_Y,
      term_all_Z (e_all pm).1 = term_all_Y pm + δ * term_ψ_all_Y pm := by
    intro pm
    dsimp [term_all_Z, term_all_Y, term_ψ_all_Y, e_all]
    rw [h_log_split pm.1.1 pm.1.2]
    ring
  have h_sum_all_filter :
      ∑ pm ∈ Finset.univ.filter P_all, term_all_Z pm =
      (∑' pm : D_all_Y, term_all_Y pm) +
        δ * (∑' pm : D_all_Y, term_ψ_all_Y pm) := by
    have h1 : ∑ pm ∈ Finset.univ.filter P_all, term_all_Z pm =
        ∑' pm : {pm : D_all_Z // P_all pm}, term_all_Z pm.1 := by
      rw [tsum_fintype]
      exact Finset.sum_subtype (Finset.univ.filter P_all) (fun _ => by simp) term_all_Z
    have h2 : (∑' pm : {pm : D_all_Z // P_all pm}, term_all_Z pm.1) =
        ∑' pm : D_all_Y, term_all_Z (e_all pm).1 :=
      (Equiv.tsum_eq e_all (fun pm : {pm : D_all_Z // P_all pm} => term_all_Z pm.1)).symm
    rw [h1, h2, tsum_congr h_term_all_split, tsum_fintype, tsum_fintype, tsum_fintype,
      Finset.sum_add_distrib, ← Finset.mul_sum]
  have h_sum_all_Z : (∑' pm : D_all_Z, term_all_Z pm) =
      (∑ pm ∈ Finset.univ.filter P_all, term_all_Z pm) +
      (∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_all_Z pm) := by
    rw [tsum_fintype]
    exact (Finset.sum_filter_add_sum_filter_not Finset.univ P_all term_all_Z).symm
  have h_rhs_eq :
      ((∑' pm : D_all_Z, term_all_Z pm) - (∑' pm : D_all_Y, term_all_Y pm)) -
        δ * (∑' pm : D_all_Y, term_ψ_all_Y pm) =
      ∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_all_Z pm := by
    rw [h_sum_all_Z, h_sum_all_filter]
    ring
  have h_term_all_Z_nonneg : ∀ pm : D_all_Z, 0 ≤ term_all_Z pm := by
    intro pm
    dsimp [term_all_Z]
    apply mul_nonneg (Real.log_natCast_nonneg _)
    apply Real.log_nonneg
    have hk_pos : (0 : ℝ) < (Ideal.absNorm pm.1.1.asIdeal : ℝ) := by
      have := h_norm_ge_two pm.1.1
      positivity
    have hpow_pos : (0 : ℝ) < (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 :=
      pow_pos hk_pos pm.1.2
    exact (one_le_div₀ hpow_pos).mpr pm.2.2
  let emb_short : {pm : D_prin_Z // ¬ P_prin pm} ↪ {pm : D_all_Z // ¬ P_all pm} :=
    { toFun := fun pm => ⟨⟨pm.1.1, ⟨pm.1.2.1, pm.1.2.2.choose_spec.1⟩⟩, pm.2⟩
      inj' := fun a b hab => by
        have hval := congrArg Subtype.val (congrArg Subtype.val hab)
        apply Subtype.ext; apply Subtype.ext; exact hval }
  have h_term_prin_norm : ∀ pm : D_prin_Z,
      ‖term_prin_Z pm‖ = term_all_Z ⟨pm.1, ⟨pm.2.1, pm.2.2.choose_spec.1⟩⟩ := by
    intro pm
    have h_nonneg : 0 ≤ term_all_Z ⟨pm.1, ⟨pm.2.1, pm.2.2.choose_spec.1⟩⟩ :=
      h_term_all_Z_nonneg ⟨pm.1, ⟨pm.2.1, pm.2.2.choose_spec.1⟩⟩
    dsimp [term_prin_Z, term_all_Z] at h_nonneg ⊢
    rw [norm_mul, AddChar.norm_apply, one_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg h_nonneg]
  let F_short : {pm : D_all_Z // ¬ P_all pm} → ℝ := fun pm => term_all_Z pm.1
  rw [h_lhs_eq, h_rhs_eq]
  calc ‖∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm), term_prin_Z pm‖
    _ ≤ ∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm), ‖term_prin_Z pm‖ :=
      norm_sum_le _ _
    _ = ∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm),
          term_all_Z ⟨pm.1, ⟨pm.2.1, pm.2.2.choose_spec.1⟩⟩ :=
      Finset.sum_congr rfl (fun pm _ => h_term_prin_norm pm)
    _ = ∑ pm : {pm : D_prin_Z // ¬ P_prin pm}, F_short (emb_short pm) :=
      Finset.sum_subtype (Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm))
        (fun _ => by simp) (fun pm : D_prin_Z => term_all_Z ⟨pm.1, ⟨pm.2.1, pm.2.2.choose_spec.1⟩⟩)
    _ = ∑ pm ∈ Finset.map emb_short Finset.univ, F_short pm :=
      (Finset.sum_map Finset.univ emb_short F_short).symm
    _ ≤ ∑ pm : {pm : D_all_Z // ¬ P_all pm}, F_short pm :=
      Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
        (fun pm _ _ => h_term_all_Z_nonneg pm.1)
    _ = ∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_all_Z pm :=
      (Finset.sum_subtype (Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm))
        (fun _ => by simp) term_all_Z).symm

theorem mitsui_principalPrimePower_char_bound_of_units_eq_one {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c₂ : ℝ, 0 < c₂ ∧
      ∀ X : ℝ, 1 < X →
        ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
          (Ideal.absNorm q : ℝ) < Real.log X ^ A →
          ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
            (∀ u : (NumberField.RingOfIntegers K)ˣ,
              ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) →
            ‖∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                  1 ≤ pm.2 ∧
                  ∃ h : (pm.1.asIdeal ^ pm.2).IsPrincipal,
                  (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ X ^ (Module.finrank ℚ K) ∧
                  IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ (pm.1.asIdeal ^ pm.2) h))},
                ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
                  (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)‖
              ≤ c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
by
  obtain ⟨c₀, hc₀_pos, hc₀⟩ :=
    mitsui_riesz_principalPrimePower_char_bound_of_units_eq_one (K := K) A hA
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_riesz_primePowers_asymptotic (K := K)
  let c : ℝ := c₀ + c₁
  have hc_pos : 0 < c := by dsimp [c]; linarith
  have hc₀_le : c₀ ≤ c := by dsimp [c]; linarith
  have hc₁_le : c₁ ≤ c := by dsimp [c]; linarith
  let c₂ : ℝ := 2 * c + 2 * c * Real.exp 1 + 3 * c + c * Real.exp (1 / c) + 2
  have hc₂_pos : 0 < c₂ := by dsimp [c₂]; positivity
  refine ⟨c₂, hc₂_pos, ?_⟩
  intro X hX q hq hq_norm ψ hψ hψ_units
  let Ψ₁_prin : ℝ → ℂ := fun Z =>
    ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ pm.2 ∧
        ∃ h : (pm.1.asIdeal ^ pm.2).IsPrincipal,
        (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Z ∧
        IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ (pm.1.asIdeal ^ pm.2) h))},
      ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
        ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
          Real.log (Z / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)
  let ψ_prin : ℝ → ℂ := fun Z =>
    ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ pm.2 ∧
        ∃ h : (pm.1.asIdeal ^ pm.2).IsPrincipal,
        (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Z ∧
        IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ (pm.1.asIdeal ^ pm.2) h))},
      ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
        (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)
  let Ψ₁_K : ℝ → ℝ := fun Z =>
    ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Z},
      Real.log (Ideal.absNorm pm.1.1.asIdeal) *
        Real.log (Z / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
  let ψ_K : ℝ → ℝ := fun Z =>
    ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Z},
      Real.log (Ideal.absNorm pm.1.1.asIdeal)
  set n : ℕ := Module.finrank ℚ K
  have hn_pos : 0 < n := Module.finrank_pos
  have hn_ge_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn_pos
  set Y : ℝ := X ^ n
  have hX_pos : 0 < X := by linarith
  have hY_gt_one : 1 < Y := one_lt_pow₀ hX (ne_of_gt hn_pos)
  have hY_pos : 0 < Y := by linarith
  have hlogX_pos : 0 < Real.log X := Real.log_pos hX
  have hlogY_eq : Real.log Y = (n : ℝ) * Real.log X := by
    dsimp [Y]
    exact Real.log_pow X n
  have hlogX_le_logY : Real.log X ≤ Real.log Y := by
    rw [hlogY_eq]
    exact le_mul_of_one_le_left (le_of_lt hlogX_pos) hn_ge_one
  have hsqrtX_le_sqrtY : Real.sqrt (Real.log X) ≤ Real.sqrt (Real.log Y) :=
    Real.sqrt_le_sqrt hlogX_le_logY
  have hq_norm_Y : (Ideal.absNorm q : ℝ) < Real.log Y ^ A :=
    lt_of_lt_of_le hq_norm (pow_le_pow_left₀ (le_of_lt hlogX_pos) hlogX_le_logY A)
  set δ : ℝ := Real.exp (-Real.sqrt (Real.log Y) / (2 * c))
  have hδ_pos : 0 < δ := Real.exp_pos _
  have hδ_le_one : δ ≤ 1 := by
    dsimp [δ]
    rw [Real.exp_le_one_iff, neg_div, neg_nonpos]
    exact div_nonneg (Real.sqrt_nonneg _) (by positivity)
  have hδ_sq : δ ^ 2 = Real.exp (-Real.sqrt (Real.log Y) / c) := by
    dsimp [δ]
    rw [sq, ← Real.exp_add]
    congr 1
    ring
  have hΨ₁_prin_Y : ‖Ψ₁_prin Y‖ ≤ c * Y * δ ^ 2 := by
    have h1 : ‖Ψ₁_prin Y‖ ≤ c₀ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₀) :=
      hc₀ Y hY_gt_one q hq hq_norm_Y ψ hψ hψ_units
    have hexp : Real.exp (-Real.sqrt (Real.log Y) / c₀) ≤ δ ^ 2 := by
      rw [hδ_sq, Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left (Real.sqrt_nonneg _) hc₀_pos hc₀_le
    calc ‖Ψ₁_prin Y‖
      _ ≤ c₀ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₀) := h1
      _ ≤ c₀ * Y * δ ^ 2 := mul_le_mul_of_nonneg_left hexp (by positivity)
      _ ≤ c * Y * δ ^ 2 := by
          have : 0 ≤ Y * δ ^ 2 := by positivity
          nlinarith
  have hΨ₁_K_Y : |Ψ₁_K Y - Y| ≤ c * Y * δ ^ 2 := by
    have h1 : |Ψ₁_K Y - Y| ≤ c₁ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁) :=
      hc₁ Y hY_pos
    have hexp : Real.exp (-Real.sqrt (Real.log Y) / c₁) ≤ δ ^ 2 := by
      rw [hδ_sq, Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left (Real.sqrt_nonneg _) hc₁_pos hc₁_le
    calc |Ψ₁_K Y - Y|
      _ ≤ c₁ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁) := h1
      _ ≤ c₁ * Y * δ ^ 2 := mul_le_mul_of_nonneg_left hexp (by positivity)
      _ ≤ c * Y * δ ^ 2 := by
          have : 0 ≤ Y * δ ^ 2 := by positivity
          nlinarith
  have hexpδ_gt_one : 1 < Real.exp δ := Real.one_lt_exp_iff.mpr hδ_pos
  have hexpδ_le_e : Real.exp δ ≤ Real.exp 1 := Real.exp_le_exp.mpr hδ_le_one
  have hZ_plus_gt_Y : Y < Real.exp δ * Y := lt_mul_of_one_lt_left hY_pos hexpδ_gt_one
  have hZ_plus_gt_one : 1 < Real.exp δ * Y := lt_trans hY_gt_one hZ_plus_gt_Y
  have hZ_plus_pos : 0 < Real.exp δ * Y := mul_pos (Real.exp_pos δ) hY_pos
  have hlog_Z_plus_ge : Real.log Y ≤ Real.log (Real.exp δ * Y) := by
    rw [Real.log_mul (ne_of_gt (Real.exp_pos δ)) (ne_of_gt hY_pos), Real.log_exp]
    linarith
  have hsqrt_Z_plus_ge : Real.sqrt (Real.log Y) ≤ Real.sqrt (Real.log (Real.exp δ * Y)) :=
    Real.sqrt_le_sqrt hlog_Z_plus_ge
  have hlogY_pos : 0 < Real.log Y := lt_of_lt_of_le hlogX_pos hlogX_le_logY
  have hq_norm_Z_plus : (Ideal.absNorm q : ℝ) < Real.log (Real.exp δ * Y) ^ A :=
    lt_of_lt_of_le hq_norm_Y (pow_le_pow_left₀ (le_of_lt hlogY_pos) hlog_Z_plus_ge A)
  have hΨ₁_prin_Z_plus : ‖Ψ₁_prin (Real.exp δ * Y)‖ ≤ (c * Real.exp 1) * Y * δ ^ 2 := by
    have h1 : ‖Ψ₁_prin (Real.exp δ * Y)‖ ≤
        c₀ * (Real.exp δ * Y) * Real.exp (-Real.sqrt (Real.log (Real.exp δ * Y)) / c₀) :=
      hc₀ (Real.exp δ * Y) hZ_plus_gt_one q hq hq_norm_Z_plus ψ hψ hψ_units
    have hexp_le : Real.exp (-Real.sqrt (Real.log (Real.exp δ * Y)) / c₀) ≤ δ ^ 2 := by
      rw [hδ_sq, Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      have h_step1 : Real.sqrt (Real.log Y) / c ≤ Real.sqrt (Real.log (Real.exp δ * Y)) / c :=
        div_le_div_of_nonneg_right hsqrt_Z_plus_ge (le_of_lt hc_pos)
      have h_step2 : Real.sqrt (Real.log (Real.exp δ * Y)) / c ≤
          Real.sqrt (Real.log (Real.exp δ * Y)) / c₀ :=
        div_le_div_of_nonneg_left (Real.sqrt_nonneg _) hc₀_pos hc₀_le
      linarith
    have hc0_exp_le : c₀ * Real.exp δ ≤ c * Real.exp 1 :=
      mul_le_mul hc₀_le hexpδ_le_e (le_of_lt (Real.exp_pos δ)) (le_of_lt hc_pos)
    calc ‖Ψ₁_prin (Real.exp δ * Y)‖
      _ ≤ c₀ * (Real.exp δ * Y) * Real.exp (-Real.sqrt (Real.log (Real.exp δ * Y)) / c₀) := h1
      _ ≤ c₀ * (Real.exp δ * Y) * δ ^ 2 := mul_le_mul_of_nonneg_left hexp_le (by positivity)
      _ = (c₀ * Real.exp δ) * (Y * δ ^ 2) := by ring
      _ ≤ (c * Real.exp 1) * (Y * δ ^ 2) := mul_le_mul_of_nonneg_right hc0_exp_le (by positivity)
      _ = (c * Real.exp 1) * Y * δ ^ 2 := by ring
  have hΨ₁_K_Z_plus : |Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y| ≤ (c * Real.exp 1) * Y * δ ^ 2 := by
    have h1 : |Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y| ≤
        c₁ * (Real.exp δ * Y) * Real.exp (-Real.sqrt (Real.log (Real.exp δ * Y)) / c₁) :=
      hc₁ (Real.exp δ * Y) hZ_plus_pos
    have hexp_le : Real.exp (-Real.sqrt (Real.log (Real.exp δ * Y)) / c₁) ≤ δ ^ 2 := by
      rw [hδ_sq, Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      have h_step1 : Real.sqrt (Real.log Y) / c ≤ Real.sqrt (Real.log (Real.exp δ * Y)) / c :=
        div_le_div_of_nonneg_right hsqrt_Z_plus_ge (le_of_lt hc_pos)
      have h_step2 : Real.sqrt (Real.log (Real.exp δ * Y)) / c ≤
          Real.sqrt (Real.log (Real.exp δ * Y)) / c₁ :=
        div_le_div_of_nonneg_left (Real.sqrt_nonneg _) hc₁_pos hc₁_le
      linarith
    have hc1_exp_le : c₁ * Real.exp δ ≤ c * Real.exp 1 :=
      mul_le_mul hc₁_le hexpδ_le_e (le_of_lt (Real.exp_pos δ)) (le_of_lt hc_pos)
    calc |Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y|
      _ ≤ c₁ * (Real.exp δ * Y) * Real.exp (-Real.sqrt (Real.log (Real.exp δ * Y)) / c₁) := h1
      _ ≤ c₁ * (Real.exp δ * Y) * δ ^ 2 := mul_le_mul_of_nonneg_left hexp_le (by positivity)
      _ = (c₁ * Real.exp δ) * (Y * δ ^ 2) := by ring
      _ ≤ (c * Real.exp 1) * (Y * δ ^ 2) := mul_le_mul_of_nonneg_right hc1_exp_le (by positivity)
      _ = (c * Real.exp 1) * Y * δ ^ 2 := by ring
  have hZ_minus_pos : 0 < Real.exp (-δ) * Y := mul_pos (Real.exp_pos (-δ)) hY_pos
  have hΨ₁_K_Z_minus : |Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y| ≤
      (c * Real.exp (1 / c)) * Y * δ ^ 2 := by
    have h1 : |Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y| ≤
        c₁ * (Real.exp (-δ) * Y) * Real.exp (-Real.sqrt (Real.log (Real.exp (-δ) * Y)) / c₁) :=
      hc₁ (Real.exp (-δ) * Y) hZ_minus_pos
    have hlog_eq : Real.log (Real.exp (-δ) * Y) = Real.log Y - δ := by
      rw [Real.log_mul (ne_of_gt (Real.exp_pos (-δ))) (ne_of_gt hY_pos), Real.log_exp]
      ring
    set u : ℝ := Real.log (Real.exp (-δ) * Y)
    have hu_le_sq : u ≤ Real.sqrt u ^ 2 := by
      rcases le_or_gt 0 u with hu | hu
      · rw [Real.sq_sqrt hu]
      · have : 0 ≤ Real.sqrt u ^ 2 := sq_nonneg _
        linarith
    have hsqrt_u_nonneg : 0 ≤ Real.sqrt u := Real.sqrt_nonneg u
    have hlogY_le_sq : Real.log Y ≤ (Real.sqrt u + 1) ^ 2 := by
      have : Real.log Y = u + δ := by dsimp [u]; linarith [hlog_eq]
      calc Real.log Y = u + δ := this
        _ ≤ Real.sqrt u ^ 2 + 1 := by linarith
        _ ≤ Real.sqrt u ^ 2 + 2 * Real.sqrt u + 1 := by linarith
        _ = (Real.sqrt u + 1) ^ 2 := by ring
    have hsqrtY_le : Real.sqrt (Real.log Y) ≤ Real.sqrt u + 1 := by
      have h2 := Real.sqrt_le_sqrt hlogY_le_sq
      rwa [Real.sqrt_sq (by linarith)] at h2
    have hexp_c1_le_c : Real.exp (-Real.sqrt u / c₁) ≤ Real.exp (-Real.sqrt u / c) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left hsqrt_u_nonneg hc₁_pos hc₁_le
    have hexp_le : Real.exp (-Real.sqrt u / c) ≤ Real.exp (1 / c) * δ ^ 2 := by
      rw [hδ_sq, ← Real.exp_add, Real.exp_le_exp]
      have h_num : -Real.sqrt u ≤ 1 - Real.sqrt (Real.log Y) := by linarith
      have h_div : -Real.sqrt u / c ≤ (1 - Real.sqrt (Real.log Y)) / c :=
        div_le_div_of_nonneg_right h_num (le_of_lt hc_pos)
      have h_eq : (1 - Real.sqrt (Real.log Y)) / c = 1 / c + -Real.sqrt (Real.log Y) / c := by ring
      linarith
    have hexp_c1_le : Real.exp (-Real.sqrt u / c₁) ≤ Real.exp (1 / c) * δ ^ 2 :=
      le_trans hexp_c1_le_c hexp_le
    have hexp_negδ_le : Real.exp (-δ) ≤ 1 := by
      rw [Real.exp_le_one_iff]
      linarith
    have hc1_exp_le : c₁ * Real.exp (-δ) ≤ c * 1 :=
      mul_le_mul hc₁_le hexp_negδ_le (le_of_lt (Real.exp_pos (-δ))) (le_of_lt hc_pos)
    calc |Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y|
      _ ≤ c₁ * (Real.exp (-δ) * Y) * Real.exp (-Real.sqrt u / c₁) := h1
      _ ≤ c₁ * (Real.exp (-δ) * Y) * (Real.exp (1 / c) * δ ^ 2) :=
          mul_le_mul_of_nonneg_left hexp_c1_le (by positivity)
      _ = (c₁ * Real.exp (-δ)) * (Real.exp (1 / c) * Y * δ ^ 2) := by ring
      _ ≤ (c * 1) * (Real.exp (1 / c) * Y * δ ^ 2) :=
          mul_le_mul_of_nonneg_right hc1_exp_le (by positivity)
      _ = (c * Real.exp (1 / c)) * Y * δ ^ 2 := by ring
  have hexp_pos_taylor : Real.exp δ - 1 - δ ≤ δ ^ 2 := by
    have habs : |δ| ≤ 1 := by rw [abs_of_pos hδ_pos]; exact hδ_le_one
    have h1 := Real.abs_exp_sub_one_sub_id_le habs
    exact le_trans (le_abs_self _) h1
  have hexp_neg_taylor : Real.exp (-δ) - 1 + δ ≤ δ ^ 2 := by
    have habs : |-δ| ≤ 1 := by rw [abs_neg, abs_of_pos hδ_pos]; exact hδ_le_one
    have h1 := Real.abs_exp_sub_one_sub_id_le habs
    have h2 : Real.exp (-δ) - 1 - (-δ) ≤ (-δ) ^ 2 := le_trans (le_abs_self _) h1
    linarith
  have h_taylor_pos_Y : (Real.exp δ - 1 - δ) * Y ≤ Y * δ ^ 2 := by
    calc (Real.exp δ - 1 - δ) * Y ≤ δ ^ 2 * Y :=
          mul_le_mul_of_nonneg_right hexp_pos_taylor (le_of_lt hY_pos)
      _ = Y * δ ^ 2 := by ring
  have h_taylor_neg_Y : (Real.exp (-δ) - 1 + δ) * Y ≤ Y * δ ^ 2 := by
    calc (Real.exp (-δ) - 1 + δ) * Y ≤ δ ^ 2 * Y :=
          mul_le_mul_of_nonneg_right hexp_neg_taylor (le_of_lt hY_pos)
      _ = Y * δ ^ 2 := by ring
  have h_fwd : ‖(Ψ₁_prin (Real.exp δ * Y) - Ψ₁_prin Y) - (δ : ℂ) * ψ_prin Y‖ ≤
      (Ψ₁_K (Real.exp δ * Y) - Ψ₁_K Y) - δ * ψ_K Y :=
    mitsui_principalPrimePower_char_riesz_forward_diff_le_uncond Y δ hY_pos hδ_pos q hq ψ
  have h_bwd : Ψ₁_K Y - Ψ₁_K (Real.exp (-δ) * Y) ≤ δ * ψ_K Y :=
    mitsui_primePowers_ge_riesz_backward_diff Y δ hY_pos hδ_pos
  have hΨ₁_K_Y_lower : -(c * Y * δ ^ 2) ≤ Ψ₁_K Y - Y := (abs_le.mp hΨ₁_K_Y).1
  have hΨ₁_K_Z_plus_upper : Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y ≤ (c * Real.exp 1) * Y * δ ^ 2 :=
    (abs_le.mp hΨ₁_K_Z_plus).2
  have hΨ₁_K_Z_minus_upper : Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y ≤
      (c * Real.exp (1 / c)) * Y * δ ^ 2 :=
    (abs_le.mp hΨ₁_K_Z_minus).2
  have h_rem_le : ‖(Ψ₁_prin (Real.exp δ * Y) - Ψ₁_prin Y) - (δ : ℂ) * ψ_prin Y‖ ≤
      (c * Real.exp 1 + 2 * c + c * Real.exp (1 / c) + 2) * Y * δ ^ 2 := by
    have h_ident : (Ψ₁_K (Real.exp δ * Y) - Ψ₁_K Y) - (Ψ₁_K Y - Ψ₁_K (Real.exp (-δ) * Y)) =
        (Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y) - 2 * (Ψ₁_K Y - Y) +
        (Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y) +
        (Real.exp δ - 1 - δ) * Y + (Real.exp (-δ) - 1 + δ) * Y := by ring
    linarith
  have h_norm_δ_ψ : δ * ‖ψ_prin Y‖ ≤
      ‖Ψ₁_prin (Real.exp δ * Y)‖ + ‖Ψ₁_prin Y‖ +
      ‖(Ψ₁_prin (Real.exp δ * Y) - Ψ₁_prin Y) - (δ : ℂ) * ψ_prin Y‖ := by
    have h_eq : (δ : ℂ) * ψ_prin Y =
        (Ψ₁_prin (Real.exp δ * Y) - Ψ₁_prin Y) -
        ((Ψ₁_prin (Real.exp δ * Y) - Ψ₁_prin Y) - (δ : ℂ) * ψ_prin Y) := by ring
    have h_norm_eq : δ * ‖ψ_prin Y‖ =
        ‖(Ψ₁_prin (Real.exp δ * Y) - Ψ₁_prin Y) -
          ((Ψ₁_prin (Real.exp δ * Y) - Ψ₁_prin Y) - (δ : ℂ) * ψ_prin Y)‖ := by
      rw [← h_eq, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hδ_pos]
    have ht1 := norm_sub_le (Ψ₁_prin (Real.exp δ * Y) - Ψ₁_prin Y)
      ((Ψ₁_prin (Real.exp δ * Y) - Ψ₁_prin Y) - (δ : ℂ) * ψ_prin Y)
    have ht2 := norm_sub_le (Ψ₁_prin (Real.exp δ * Y)) (Ψ₁_prin Y)
    linarith
  have h_δ_ψ_le_c2 : δ * ‖ψ_prin Y‖ ≤ c₂ * Y * δ ^ 2 := by
    have h_c2_ge : 2 * c * Real.exp 1 + 3 * c + c * Real.exp (1 / c) + 2 ≤ c₂ := by
      have : 0 ≤ 2 * c := by positivity
      dsimp [c₂]; linarith
    have hYδ2_nonneg : 0 ≤ Y * δ ^ 2 := by positivity
    have h_bound : (2 * c * Real.exp 1 + 3 * c + c * Real.exp (1 / c) + 2) * (Y * δ ^ 2) ≤
        c₂ * Y * δ ^ 2 := by
      calc (2 * c * Real.exp 1 + 3 * c + c * Real.exp (1 / c) + 2) * (Y * δ ^ 2)
        _ ≤ c₂ * (Y * δ ^ 2) := mul_le_mul_of_nonneg_right h_c2_ge hYδ2_nonneg
        _ = c₂ * Y * δ ^ 2 := by ring
    linarith
  have h_ψ_le_δ : ‖ψ_prin Y‖ ≤ c₂ * Y * δ := by
    apply le_of_mul_le_mul_left _ hδ_pos
    calc δ * ‖ψ_prin Y‖ ≤ c₂ * Y * δ ^ 2 := h_δ_ψ_le_c2
      _ = δ * (c₂ * Y * δ) := by ring
  have h_δ_le_final : δ ≤ Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    dsimp [δ]
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    have h1 : Real.sqrt (Real.log X) / c₂ ≤ Real.sqrt (Real.log Y) / c₂ :=
      div_le_div_of_nonneg_right hsqrtX_le_sqrtY (le_of_lt hc₂_pos)
    have h2c_le_c2 : 2 * c ≤ c₂ := by
      have : 0 ≤ 2 * c * Real.exp 1 + 3 * c + c * Real.exp (1 / c) + 2 := by positivity
      dsimp [c₂]; linarith
    have h2 : Real.sqrt (Real.log Y) / c₂ ≤ Real.sqrt (Real.log Y) / (2 * c) :=
      div_le_div_of_nonneg_left (Real.sqrt_nonneg _) (by positivity) h2c_le_c2
    linarith
  calc ‖ψ_prin Y‖ ≤ c₂ * Y * δ := h_ψ_le_δ
    _ ≤ c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
        mul_le_mul_of_nonneg_left h_δ_le_final (by positivity)

theorem mitsui_principalPrimeIdeals_char_place_sector_bound_of_rank_pos {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A)
    (h_rank : 0 < NumberField.Units.rank K) :
    ∃ c₃₁ : ℝ, 0 < c₃₁ ∧
      ∀ X : ℝ, 1 < X →
        ∀ w₀ : NumberField.InfinitePlace K,
          ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
            (Ideal.absNorm q : ℝ) < Real.log X ^ A →
            ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
              (∀ u : (NumberField.RingOfIntegers K)ˣ,
                ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) →
              ‖(∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
                    ∃ h : p.asIdeal.IsPrincipal,
                    (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K) ∧
                    IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ p.asIdeal h))},
                  (Nat.card {π : NumberField.RingOfIntegers K //
                      Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧
                      (∀ w : NumberField.InfinitePlace K,
                        1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
                      w₀ (π : K) < X} : ℂ) *
                    (ψ (Additive.ofMul p.2.choose_spec.2.unit) *
                      (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)))
                - ((((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) *
                    (NumberField.Units.regulator K)⁻¹ : ℝ) : ℂ) *
                  ((NumberField.Units.torsionOrder K : ℂ) *
                    (∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
                          ∃ h : p.asIdeal.IsPrincipal,
                          (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K) ∧
                          IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ p.asIdeal h))},
                        ψ (Additive.ofMul p.2.choose_spec.2.unit) *
                          (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)))‖
                ≤ c₃₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃₁) :=
by
  classical
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_prime_box_to_ge_one (K := K)
  obtain ⟨c_shell, hc_shell_pos, hc_shell⟩ := mitsui_prime_box_shell_diff_bound (K := K)
  obtain ⟨c_cell, hc_cell_pos, hc_cell⟩ :=
    mitsui_principalPrimeIdeals_char_decoupled_log_cell_bound_of_rank_pos (K := K) A hA h_rank
  obtain ⟨c_hpp, hc_hpp_pos, hc_hpp⟩ := mitsui_higher_primePower_chebyshev_bound (K := K)
  obtain ⟨c_pp, hc_pp_pos, hc_pp⟩ := mitsui_principalPrimePower_char_bound_of_units_eq_one (K := K) A hA
  set M : ℕ := Fintype.card (NumberField.InfinitePlace K)
  have hM_pos : 0 < M := Fintype.card_pos
  have hM_rpos : (0 : ℝ) < (M : ℝ) := Nat.cast_pos.mpr hM_pos
  set R : ℝ := NumberField.Units.regulator K
  have hR_pos : 0 < R := NumberField.Units.regulator_pos K
  have hR_inv_nonneg : 0 ≤ R⁻¹ := by positivity
  set W : ℝ := (NumberField.Units.torsionOrder K : ℝ)
  have hW_nat_pos : 0 < NumberField.Units.torsionOrder K :=
    NumberField.Units.torsionOrder_pos K
  have hW_pos : 0 < W := by
    dsimp [W]
    exact_mod_cast hW_nat_pos
  set c' : ℝ := 1 / (4 * (M : ℝ) * c_cell)
  have hc'_pos : 0 < c' := by dsimp [c']; positivity
  set K₀ : ℝ := 16 / c' ^ 2 + 1
  have hK₀_pos : 0 < K₀ := by dsimp [K₀]; positivity
  set A_cell : ℝ := K₀ ^ (2 * M) * c_cell
  have hA_cell_pos : 0 < A_cell := by dsimp [A_cell]; positivity
  set A_cone : ℝ := R⁻¹ * W
  have hA_cone_pos : 0 < A_cone := by dsimp [A_cone]; positivity
  let c₃₁ : ℝ := c₁ + 3 * c_shell + A_cell + A_cone * (c_hpp + c_pp) + 1 / c' + 2 * c_cell + c_hpp + c_pp
  have hc₃₁_pos : 0 < c₃₁ := by dsimp [c₃₁]; positivity
  refine ⟨c₃₁, hc₃₁_pos, ?_⟩
  intro X hX w₀ q hq hq_norm ψ hψ hψ_units
  set Y : ℝ := X ^ (Module.finrank ℚ K)
  have hX_pos : (0 : ℝ) < X := by linarith
  have hY_nonneg : 0 ≤ Y := by dsimp [Y]; positivity
  have hlog_pos : 0 < Real.log X := Real.log_pos hX
  set t : ℝ := Real.sqrt (Real.log X)
  have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg _
  have ht_sq : t ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlog_pos)
  set z : ℝ := (Real.log X + 1) ^ 2 * Real.exp (c' * t)
  set m : ℕ := ⌊z⌋₊
  have hexp_ge_one : 1 ≤ Real.exp (c' * t) := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by positivity)
  have hlog1_le_sq : Real.log X + 1 ≤ (Real.log X + 1) ^ 2 := by nlinarith
  have hz_ge : Real.log X + 1 ≤ z := by
    dsimp [z]
    calc Real.log X + 1
      _ = (Real.log X + 1) * 1 := (mul_one _).symm
      _ ≤ (Real.log X + 1) ^ 2 * Real.exp (c' * t) :=
        mul_le_mul hlog1_le_sq hexp_ge_one zero_le_one (by positivity)
  have hz_lt : z < (m : ℝ) + 1 := Nat.lt_floor_add_one z
  have hlog_lt_m : Real.log X < (m : ℝ) := by linarith
  have hm_log : Real.log X ≤ (m : ℝ) := le_of_lt hlog_lt_m
  have hm_rpos : (0 : ℝ) < (m : ℝ) := lt_trans hlog_pos hlog_lt_m
  have hm_pos : 0 < m := Nat.cast_pos.mp hm_rpos
  have hm : 1 ≤ m := hm_pos
  have hm_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  have hz_le_2m : z ≤ 2 * (m : ℝ) := by linarith
  have h_ratio : (Real.log X + 1) ^ 2 / (m : ℝ) ≤ 2 * Real.exp (-c' * t) := by
    rw [div_le_iff₀ hm_rpos]
    calc (Real.log X + 1) ^ 2
      _ = z * Real.exp (-c' * t) := by
        dsimp [z]
        rw [mul_assoc, ← Real.exp_add]
        have h0 : c' * t + -c' * t = 0 := by ring
        rw [h0, Real.exp_zero, mul_one]
      _ ≤ (2 * (m : ℝ)) * Real.exp (-c' * t) :=
        mul_le_mul_of_nonneg_right hz_le_2m (by positivity)
      _ = 2 * Real.exp (-c' * t) * (m : ℝ) := by ring
  have hm_le_z : (m : ℝ) ≤ z := Nat.floor_le (by dsimp [z]; positivity)
  have hu_exp : c' * t / 4 + 1 ≤ Real.exp (c' * t / 4) := Real.add_one_le_exp (c' * t / 4)
  have hu_sq : (c' * t / 4) ^ 2 ≤ Real.exp (c' * t / 2) := by
    have h1 : c' * t / 4 ≤ c' * t / 4 + 1 := by linarith
    have h2 : c' * t / 4 ≤ Real.exp (c' * t / 4) := le_trans h1 hu_exp
    calc (c' * t / 4) ^ 2
      _ = (c' * t / 4) * (c' * t / 4) := sq _
      _ ≤ Real.exp (c' * t / 4) * Real.exp (c' * t / 4) :=
        mul_le_mul h2 h2 (by positivity) (by positivity)
      _ = Real.exp (c' * t / 2) := by
        rw [← Real.exp_add]
        ring_nf
  have hlog_le_exp : Real.log X ≤ (16 / c' ^ 2) * Real.exp (c' * t / 2) := by
    have h1 : (c' ^ 2 / 16) * Real.log X = (c' * t / 4) ^ 2 := by
      rw [← ht_sq]
      ring
    rw [div_mul_eq_mul_div, le_div_iff₀ (by positivity)]
    linarith
  have hexp_half_ge_one : 1 ≤ Real.exp (c' * t / 2) := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by positivity)
  have hlog1_le_K₀ : Real.log X + 1 ≤ K₀ * Real.exp (c' * t / 2) := by
    dsimp [K₀]
    linarith
  have hlog1_sq_le : (Real.log X + 1) ^ 2 ≤ K₀ ^ 2 * Real.exp (c' * t) := by
    calc (Real.log X + 1) ^ 2
      _ = (Real.log X + 1) * (Real.log X + 1) := sq _
      _ ≤ (K₀ * Real.exp (c' * t / 2)) * (K₀ * Real.exp (c' * t / 2)) :=
        mul_le_mul hlog1_le_K₀ hlog1_le_K₀ (by positivity) (by positivity)
      _ = K₀ ^ 2 * (Real.exp (c' * t / 2) * Real.exp (c' * t / 2)) := by ring
      _ = K₀ ^ 2 * Real.exp (c' * t) := by
        rw [← Real.exp_add]
        ring_nf
  have hm_le_K₀ : (m : ℝ) ≤ K₀ ^ 2 * Real.exp (2 * c' * t) := by
    calc (m : ℝ)
      _ ≤ z := hm_le_z
      _ = (Real.log X + 1) ^ 2 * Real.exp (c' * t) := rfl
      _ ≤ (K₀ ^ 2 * Real.exp (c' * t)) * Real.exp (c' * t) :=
        mul_le_mul_of_nonneg_right hlog1_sq_le (by positivity)
      _ = K₀ ^ 2 * (Real.exp (c' * t) * Real.exp (c' * t)) := by ring
      _ = K₀ ^ 2 * Real.exp (2 * c' * t) := by
        rw [← Real.exp_add]
        ring_nf
  have hexp_M_eq : (M : ℝ) * (2 * c' * t) = t / (2 * c_cell) := by
    dsimp [c']
    have hM_ne : (M : ℝ) ≠ 0 := ne_of_gt hM_rpos
    have hc_ne : c_cell ≠ 0 := ne_of_gt hc_cell_pos
    field_simp [hM_ne, hc_ne]
    ring
  have hm_pow_le : (m : ℝ) ^ M ≤ K₀ ^ (2 * M) * Real.exp (t / (2 * c_cell)) := by
    calc (m : ℝ) ^ M
      _ ≤ (K₀ ^ 2 * Real.exp (2 * c' * t)) ^ M :=
        pow_le_pow_left₀ (by positivity) hm_le_K₀ M
      _ = K₀ ^ (2 * M) * (Real.exp (2 * c' * t)) ^ M := by
        rw [mul_pow, ← pow_mul]
      _ = K₀ ^ (2 * M) * Real.exp ((M : ℝ) * (2 * c' * t)) := by
        rw [← Real.exp_nat_mul]
      _ = K₀ ^ (2 * M) * Real.exp (t / (2 * c_cell)) := by
        rw [hexp_M_eq]
