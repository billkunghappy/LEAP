    intro u
    rw [← Real.exp_mul]
    congr 1
    field_simp [hn_ne]
  have h_exp_2n : ∀ u : ℝ, (Real.exp ((n : ℝ) * u)) ^ (2 / (n : ℝ)) = Real.exp (2 * u) := by
    intro u
    rw [← Real.exp_mul]
    congr 1
    field_simp [hn_ne]
  refine ⟨?_, ?_⟩
  · have h_u_int2 : MeasureTheory.Integrable (fun u : ℝ => (n : ℝ) * f_re (Real.exp ((n : ℝ) * u))) MeasureTheory.volume := by
      refine h_u_maj_int.congr (Filter.Eventually.of_forall (fun u => ?_))
      dsimp [f_re]
      rw [h_y_maj u, h_exp_1n u, h_exp_2n u, ← Real.exp_mul]
      ring
    have h_tau_int := hs1.1.mpr h_u_int2
    refine h_tau_int.congr_fun (fun τ _ => ?_) measurableSet_Ioi
    dsimp [f_re]
    ring
  · have h_lhs_congr :
        (∫ τ in Set.Ioi (0 : ℝ),
          (τ : ℂ) ^ z *
            ((((2 : ℝ) ^ (r₁ + r₂) * Reg * τ⁻¹ *
              (τ ^ (1 / (n : ℝ))) ^ A_sum : ℝ) : ℂ) *
              J_c (Real.pi * τ ^ (2 / (n : ℝ))))) =
        ∫ τ in Set.Ioi (0 : ℝ), ((τ⁻¹ : ℝ) : ℂ) * f_c τ := by
      refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun τ _ => ?_)
