  have h2A1_ne : 2 * (A : ℝ) + 1 ≠ 0 := ne_of_gt h2A1_pos
  let C_scale : ℝ := 2 * (A : ℝ) + 4 * Real.log (Ideal.absNorm I₂ : ℝ)
