    intro I
    by_cases hI : (I : Ideal R) ⊔ q₁ = ⊤
    · rw [(hχ₁_norm_supp I).1 hI]
    · rw [(hχ₁_norm_supp I).2 hI, norm_zero]
      exact zero_le_one
  have hχ₂_norm : ∀ I : nonZeroDivisors (Ideal R), ‖χ₂ I‖ ≤ 1 := by
    intro I
    by_cases hI : (I : Ideal R) ⊔ q₂ = ⊤
    · rw [(hχ₂_norm_supp I).1 hI]
    · rw [(hχ₂_norm_supp I).2 hI, norm_zero]
      exact zero_le_one
