    let E_K : NumberField.InfinitePlace K → Fin r → ℝ :=
      fun w i => B_R.repr (T_log (fun v => if w = v then 1 else 0)) i
    let E_max : ℝ := ∑ w : NumberField.InfinitePlace K, ∑ i : Fin r, |E_K w i|
    have hE_max_nn : 0 ≤ E_max :=
      Finset.sum_nonneg (fun w _ => Finset.sum_nonneg (fun i _ => abs_nonneg _))
    let C_freq : ℝ := 4 * Real.pi + (Fintype.card (NumberField.InfinitePlace K) : ℝ) * Real.pi
    have hC_freq_pos : 0 < C_freq := by dsimp [C_freq]; positivity
    let C_unit : ℝ := 1 + (NumberField.Units.torsionOrder K : ℝ) + E_max * C_freq
    have hEC_nn : 0 ≤ E_max * C_freq := mul_nonneg hE_max_nn (le_of_lt hC_freq_pos)
    have htors_nn : (0 : ℝ) ≤ (NumberField.Units.torsionOrder K : ℝ) := Nat.cast_nonneg _
