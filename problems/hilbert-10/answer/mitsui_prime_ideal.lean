      (∏ p_idx : Fin (NumberField.InfinitePlace.nrComplexPlaces K),
        Complex.Gammaℂ (z + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)) := by
