  let B₁' : ℝ := min (B₁ / (2 * (A : ℝ) + 1)) B₂
  have hB₁'_pos : 0 < B₁' := lt_min (by positivity) hB₂_pos
  have hB₁'_le_B₁_div : B₁' ≤ B₁ / (2 * (A : ℝ) + 1) := min_le_left _ _
  have hB₁'_le_B₂ : B₁' ≤ B₂ := min_le_right _ _
  let B₀ : ℝ := min (B₁' / 2) (1 / 8)
  have hB₀_pos : 0 < B₀ := lt_min (half_pos hB₁'_pos) (by norm_num)
  have hB₀_le_half : B₀ ≤ 1 / 2 := le_trans (min_le_right _ _) (by norm_num)
  have hB₀_le_half_B₁' : B₀ ≤ B₁' / 2 := min_le_left _ _
  have hB₀_le_eight : B₀ ≤ 1 / 8 := min_le_right _ _
  let A₀ : ℝ := C_scale * C₂ + 4 * M₀
  have hA₀_pos : 0 < A₀ := by dsimp [A₀]; positivity
  have hlog4_gt_one : 1 < Real.log 4 := by
    rw [← Real.log_exp 1]
    exact Real.log_lt_log (Real.exp_pos 1) (by linarith [Real.exp_one_lt_d9])
  have h_log_ge_one : ∀ t : ℝ, 1 ≤ Real.log (4 + |t|) := by
    intro t
    have ht : 4 ≤ 4 + |t| := by linarith [abs_nonneg t]
    exact le_trans (le_of_lt hlog4_gt_one) (Real.log_le_log (by norm_num) ht)
  have h_log_pos : ∀ t : ℝ, 0 < Real.log (4 + |t|) :=
    fun t => lt_of_lt_of_le zero_lt_one (h_log_ge_one t)
  refine ⟨B₀, A₀, hB₀_pos, hB₀_le_half, hA₀_pos, ?_⟩
  intro q hq w₀ a₀ ha₀_lt θ₀ hθ₀_bdd m_freq l_ang h_tors h_nonprin M hM hq_M hm_M hl_M χ_gr hχ_gr_norm_supp hχ_gr_prin
  have hχ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ_gr I‖ ≤ 1 := by
    intro I
    by_cases hI : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤
    · rw [(hχ_gr_norm_supp I).1 hI]
    · rw [(hχ_gr_norm_supp I).2 hI, norm_zero]
      linarith
  obtain ⟨g_χ, hg_diff, hg_eq, hg_growth⟩ :=
    h_entire_growth q hq w₀ a₀ ha₀_lt θ₀ hθ₀_bdd m_freq l_ang h_tors h_nonprin M hM hm_M hl_M χ_gr hχ_gr_norm_supp hχ_gr_prin
  refine ⟨g_χ, hg_diff, hg_eq, ?_⟩
  set N_q : ℝ := (Ideal.absNorm q : ℝ)
