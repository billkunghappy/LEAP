        (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w)
    calc ((f_τ I_x * f_W I_x) * χ I_x) *
          ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
            Complex.exp
              (((∑ j : Fin r,
                  y j * (2 * Real.pi * (θ₀ j - (m_freq j : ℝ)) + A_arg j)) : ℝ) * Complex.I))
      _ = f_τ I_x *
            ((f_W I_x *
              Complex.exp
                (((∑ j : Fin r,
                    y j * (2 * Real.pi * (θ₀ j - (m_freq j : ℝ)) + A_arg j)) : ℝ) * Complex.I)) *
              (χ I_x * (w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀)) := by ring
      _ = f_τ I_x *
            ((Complex.exp
                (2 * Real.pi * Complex.I * ∑ j : Fin r, (θ₀ j : ℂ) * (y j : ℂ)) *
              Complex.exp
                (((∑ j : Fin r, y j * A_arg j) : ℝ) * Complex.I)) *
              (χ I_x * (w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀)) := by rw [h_exp_W]
      _ = (χ I_x *
            ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
              Complex.exp
                (2 * Real.pi * Complex.I * ∑ j : Fin r, (θ₀ j : ℂ) * (y j : ℂ)))) *
          (f_τ I_x *
            Complex.exp
              (((∑ j : Fin r, y j * A_arg j) : ℝ) * Complex.I)) := by ring
      _ = f_τ I_x *
            Complex.exp
              (((∑ j : Fin r, y j * A_arg j) : ℝ) * Complex.I) := by rw [h_ray, one_mul]
      _ = ∏ w : NumberField.InfinitePlace K,
            (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w) := h_phase_prod.symm

theorem mitsui_riesz_primePower_char_eq_sum_Icc {K : Type u} [Field K] [NumberField K]
    (Y : ℝ) (hY : 0 < Y)
    (χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ) :
    (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
        (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
          ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
            Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)) =
      ∑ n ∈ Finset.Icc 1 ⌊Y⌋₊,
        (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
            (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
              (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)) *
          (Real.log (Y / (n : ℝ)) : ℂ) :=
by
  classical
  have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p.asIdeal := by
    intro p
    have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    omega
  have h_nat_bounds : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (m N : ℕ), 1 ≤ m → Ideal.absNorm p.asIdeal ^ m ≤ N →
      (Ideal.absNorm p.asIdeal ≤ N ∧ m ≤ N) ∧ 1 ≤ Ideal.absNorm p.asIdeal ^ m := by
    intro p m N hm h_pow
    have hk2 : 2 ≤ Ideal.absNorm p.asIdeal := h_norm_ge_two p
    have hm_ne : m ≠ 0 := by omega
    have hk_le_km : Ideal.absNorm p.asIdeal ≤ Ideal.absNorm p.asIdeal ^ m :=
      Nat.le_self_pow hm_ne (Ideal.absNorm p.asIdeal)
    have hm_le_2m : m ≤ 2 ^ m := (Nat.lt_pow_self (by decide : 1 < 2)).le
    have h2m_le_km : 2 ^ m ≤ Ideal.absNorm p.asIdeal ^ m := Nat.pow_le_pow_left hk2 m
    exact ⟨⟨le_trans hk_le_km h_pow, le_trans (le_trans hm_le_2m h2m_le_km) h_pow⟩,
      le_trans hm (le_trans hm_le_2m h2m_le_km)⟩
  let D_Y := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y}
  let F (n : ℕ) := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n}
  let S_prod : Set (Ideal (NumberField.RingOfIntegers K) × ℕ) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊} ×ˢ {m : ℕ | m ≤ ⌊Y⌋₊}
  have hSprod_fin : S_prod.Finite :=
    (Ideal.finite_setOf_absNorm_le ⌊Y⌋₊).prod (Set.finite_le_nat ⌊Y⌋₊)
  have h_pm_floor : ∀ pm : D_Y, Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2 ≤ ⌊Y⌋₊ := by
    intro pm
    have h_pow_nat : ((Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2 : ℕ) : ℝ) ≤ Y := by
      exact_mod_cast pm.2.2
    exact Nat.le_floor h_pow_nat
  haveI : Finite S_prod := hSprod_fin
  let f_Y : D_Y → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2), (h_nat_bounds pm.1.1 pm.1.2 ⌊Y⌋₊ pm.2.1 (h_pm_floor pm)).1⟩
  have hf_Y_inj : Function.Injective f_Y := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    dsimp [f_Y] at hval
    apply Subtype.ext; apply Prod.ext
    · exact IsDedekindDomain.HeightOneSpectrum.ext (congrArg Prod.fst hval)
    · exact congrArg (Prod.snd : Ideal (NumberField.RingOfIntegers K) × ℕ → ℕ) hval
  haveI : Finite D_Y := Finite.of_injective f_Y hf_Y_inj
  letI : Fintype D_Y := Fintype.ofFinite D_Y
  let g : D_Y → ℕ := fun pm => Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2
  let term_Y : D_Y → ℂ := fun pm =>
    (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
      ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
        Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)
  let term_ψ_Y : D_Y → ℂ := fun pm =>
    (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
      (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)
  have hg : ∀ pm ∈ (Finset.univ : Finset D_Y), g pm ∈ Finset.Icc 1 ⌊Y⌋₊ := by
    intro pm _
    rw [Finset.mem_Icc]
    exact ⟨(h_nat_bounds pm.1.1 pm.1.2 ⌊Y⌋₊ pm.2.1 (h_pm_floor pm)).2, h_pm_floor pm⟩
  have h_lhs : (∑' pm : D_Y, term_Y pm) =
      ∑ n ∈ Finset.Icc 1 ⌊Y⌋₊, ∑ pm ∈ Finset.univ with g pm = n, term_Y pm := by
    rw [tsum_fintype]
    exact (Finset.sum_fiberwise_of_maps_to hg term_Y).symm
  change (∑' pm : D_Y, term_Y pm) =
    ∑ n ∈ Finset.Icc 1 ⌊Y⌋₊,
      (∑' pm : F n,
        (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
          (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)) *
        (Real.log (Y / (n : ℝ)) : ℂ)
  rw [h_lhs]
  refine Finset.sum_congr rfl (fun n hn => ?_)
  have hn_le_floor : n ≤ ⌊Y⌋₊ := (Finset.mem_Icc.mp hn).2
  have hn_le_Y : (n : ℝ) ≤ Y := by
    have h1 : (n : ℝ) ≤ (⌊Y⌋₊ : ℝ) := by exact_mod_cast hn_le_floor
    exact le_trans h1 (Nat.floor_le (le_of_lt hY))
  have h_factor :
      (∑ pm ∈ Finset.univ with g pm = n, term_Y pm) =
      (∑ pm ∈ Finset.univ with g pm = n, term_ψ_Y pm) * (Real.log (Y / (n : ℝ)) : ℂ) := by
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl (fun pm hpm => ?_)
    have hg_eq : g pm = n := (Finset.mem_filter.mp hpm).2
    have h_cast : ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2) = (n : ℝ) := by
      exact_mod_cast hg_eq
    dsimp [term_Y, term_ψ_Y]
    rw [h_cast, Complex.ofReal_mul, ← mul_assoc]
  rw [h_factor]
  congr 1
  let e_n : F n ≃ {pm : D_Y // g pm = n} :=
    { toFun := fun pm => ⟨⟨pm.1, ⟨pm.2.1, by
        have h_cast : ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2) = (n : ℝ) := by
          exact_mod_cast pm.2.2
        linarith⟩⟩, pm.2.2⟩
      invFun := fun q => ⟨q.1.1, ⟨q.1.2.1, q.2⟩⟩
      left_inv := fun pm => by apply Subtype.ext; rfl
      right_inv := fun q => by apply Subtype.ext; apply Subtype.ext; rfl }
  have h_sub : (∑ pm ∈ Finset.univ with g pm = n, term_ψ_Y pm) =
      ∑' q : {pm : D_Y // g pm = n}, term_ψ_Y q.1 := by
    rw [tsum_fintype]
    exact Finset.sum_subtype (Finset.univ.filter (fun pm : D_Y => g pm = n))
      (fun _ => by simp) term_ψ_Y
  rw [h_sub]
  exact (Equiv.tsum_eq e_n (fun q : {pm : D_Y // g pm = n} => term_ψ_Y q.1)).symm

theorem mitsui_riesz_primePower_char_eq_vertical_integral {K : Type u} [Field K] [NumberField K]
    (Y : ℝ) (hY : 1 < Y)
    (χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ I‖ ≤ 1) :
    (∑ n ∈ Finset.Icc 1 ⌊Y⌋₊,
        (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
            (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
              (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)) *
          (Real.log (Y / (n : ℝ)) : ℂ)) =
      ((1 / (2 * Real.pi) : ℝ) : ℂ) *
        (∫ t : ℝ,
          ((Y : ℂ) ^ (2 + (t : ℂ) * Complex.I) / (2 + (t : ℂ) * Complex.I) ^ 2) *
            LSeries (fun n =>
              ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                    1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
                (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
                  (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ))
              (2 + (t : ℂ) * Complex.I)) :=
by
  have hY_pos : 0 < Y := by linarith
  have h_general : ∀ (a : ℕ → ℂ), a 0 = 0 → LSeriesSummable a 2 →
      (∑ n ∈ Finset.Icc 1 ⌊Y⌋₊, a n * (Real.log (Y / (n : ℝ)) : ℂ)) =
        ((1 / (2 * Real.pi) : ℝ) : ℂ) *
          (∫ t : ℝ,
            ((Y : ℂ) ^ (2 + (t : ℂ) * Complex.I) / (2 + (t : ℂ) * Complex.I) ^ 2) *
              LSeries a (2 + (t : ℂ) * Complex.I)) := by
    intro a ha0 ha_sum
    have h_int_four_add_sq : MeasureTheory.Integrable (fun t : ℝ => (4 + t ^ 2)⁻¹) := by
      refine integrable_inv_one_add_sq.mono' ?_ ?_
      · exact (continuous_const.add (continuous_pow 2)).inv₀ (fun t => by positivity) |>.aestronglyMeasurable
      · refine Filter.Eventually.of_forall (fun t => ?_)
        rw [Real.norm_of_nonneg (by positivity)]
        exact inv_anti₀ (by positivity) (by linarith)
    have h_norm_sq : ∀ t : ℝ, ‖(2 + (t : ℂ) * Complex.I) ^ 2‖ = 4 + t ^ 2 := by
      intro t
      rw [norm_pow, ← Complex.normSq_eq_norm_sq]
      have hre : (2 + (t : ℂ) * Complex.I).re = 2 := by simp
      have him : (2 + (t : ℂ) * Complex.I).im = t := by simp
      rw [Complex.normSq_apply, hre, him]
      ring
    have h_neg_log_le_rpow : ∀ {t r : ℝ}, 0 < t → 0 < r → -Real.log t ≤ (1 / r) * t ^ (-r) := by
      intro t r ht hr
      have h1 : Real.log (t ^ (-r)) ≤ t ^ (-r) - 1 :=
        Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos ht (-r))
      have h2 : Real.log (t ^ (-r)) = r * (-Real.log t) := by
        rw [Real.log_rpow ht]
        ring
      rw [h2] at h1
      have h3 : r * (-Real.log t) ≤ t ^ (-r) := by linarith
      rw [← le_div_iff₀' hr] at h3
      linarith [show t ^ (-r) / r = (1 / r) * t ^ (-r) by ring]
    have h_mellin : ∀ s : ℂ, 0 < s.re →
        HasMellin (fun t : ℝ => ((max 0 (-Real.log t) : ℝ) : ℂ)) s (1 / s ^ 2) := by
      intro s hs
      let f : ℝ → ℂ := fun t => ((max 0 (-Real.log t) : ℝ) : ℂ)
      let g : ℝ → ℂ := fun t => (t : ℂ) ^ (s - 1) * ((-Real.log t : ℝ) : ℂ)
      have hs_ne : s ≠ 0 := by
        intro h; rw [h] at hs; simp at hs
      have hf_Ioc : ∀ t ∈ Set.Ioc (0 : ℝ) 1, (t : ℂ) ^ (s - 1) • f t = g t := by
        intro t ht
        dsimp [f, g]
        rw [max_eq_right]
        linarith [Real.log_nonpos (le_of_lt ht.1) ht.2]
      have hf_Ioi : ∀ t ∈ Set.Ioi (1 : ℝ), (t : ℂ) ^ (s - 1) • f t = 0 := by
        intro t ht
        dsimp [f]
        have hlog : 0 ≤ Real.log t := Real.log_nonneg (le_of_lt ht)
        rw [max_eq_left (by linarith), Complex.ofReal_zero, mul_zero]
      have hg_norm_le : ∀ t ∈ Set.Ioc (0 : ℝ) 1,
          ‖g t‖ ≤ (2 / s.re) * t ^ (s.re / 2 - 1) := by
        intro t ht
        dsimp [g]
        rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos ht.1, Complex.sub_re, Complex.one_re,
          Complex.norm_real, Real.norm_of_nonneg (by linarith [Real.log_nonpos (le_of_lt ht.1) ht.2])]
        have h_log := h_neg_log_le_rpow ht.1 (half_pos hs)
        have h_mul := mul_le_mul_of_nonneg_left h_log (Real.rpow_nonneg (le_of_lt ht.1) (s.re - 1))
        have h_rpow : t ^ (s.re - 1) * ((1 / (s.re / 2)) * t ^ (-(s.re / 2))) =
            (2 / s.re) * (t ^ (s.re - 1) * t ^ (-(s.re / 2))) := by ring
        rw [h_rpow, ← Real.rpow_add ht.1] at h_mul
        convert h_mul using 2
        ring
      have hg_contOn : ContinuousOn g (Set.Ioc 0 1) := by
        intro t ht
        refine ContinuousAt.continuousWithinAt ?_
        refine (ContinuousAt.cpow Complex.continuous_ofReal.continuousAt continuousAt_const ?_).mul ?_
        · rw [Complex.mem_slitPlane_iff]; exact Or.inl ht.1
        · exact Complex.continuous_ofReal.continuousAt.comp (Real.continuousAt_log (ne_of_gt ht.1)).neg
      have hg_int_Ioc : MeasureTheory.IntegrableOn g (Set.Ioc 0 1) MeasureTheory.volume := by
        have h_dom : IntervalIntegrable (fun t : ℝ => (2 / s.re) * t ^ (s.re / 2 - 1)) MeasureTheory.volume 0 1 :=
          (intervalIntegral.intervalIntegrable_rpow' (by linarith : -1 < s.re / 2 - 1)).const_mul (2 / s.re)
        rw [intervalIntegrable_iff_integrableOn_Ioc_of_le zero_le_one] at h_dom
        refine h_dom.mono' (hg_contOn.aestronglyMeasurable measurableSet_Ioc) ?_
        exact MeasureTheory.ae_restrict_of_forall_mem measurableSet_Ioc hg_norm_le
      have h_int_Ioc : MeasureTheory.IntegrableOn (fun t : ℝ => (t : ℂ) ^ (s - 1) • f t) (Set.Ioc 0 1) MeasureTheory.volume :=
        hg_int_Ioc.congr_fun (fun t ht => (hf_Ioc t ht).symm) measurableSet_Ioc
      have h_int_Ioi : MeasureTheory.IntegrableOn (fun t : ℝ => (t : ℂ) ^ (s - 1) • f t) (Set.Ioi 1) MeasureTheory.volume :=
        (MeasureTheory.integrableOn_zero).congr_fun (fun t ht => (hf_Ioi t ht).symm) measurableSet_Ioi
      have h_mc : MellinConvergent f s := by
        rw [MellinConvergent, ← Set.Ioc_union_Ioi_eq_Ioi zero_le_one]
        exact h_int_Ioc.union h_int_Ioi
      let G : ℝ → ℂ := fun t => (t : ℂ) ^ s * (1 / s ^ 2 - (Real.log t : ℂ) / s)
      have hG_deriv : ∀ x ∈ Set.Ioo (0 : ℝ) 1, HasDerivAt G (g x) x := by
        intro x hx
        have hx_ne : x ≠ 0 := ne_of_gt hx.1
        have hx_ne_C : (x : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hx_ne
        have h1 : HasDerivAt (fun y : ℝ => (y : ℂ) ^ s) (s * (x : ℂ) ^ (s - 1)) x :=
          hasDerivAt_ofReal_cpow_const hx_ne hs_ne
        have h2 : HasDerivAt (fun y : ℝ => 1 / s ^ 2 - (Real.log y : ℂ) / s) (0 - ((x⁻¹ : ℝ) : ℂ) / s) x := by
          refine (hasDerivAt_const x (1 / s ^ 2)).sub ?_
          exact ((Real.hasDerivAt_log hx_ne).ofReal_comp).div_const s
        have hmul := h1.mul h2
        convert hmul using 1
        dsimp [g]
        have h_cpow : (x : ℂ) ^ s = (x : ℂ) ^ (s - 1) * (x : ℂ) := by
          conv_lhs => rw [show s = (s - 1) + 1 by ring, Complex.cpow_add _ _ hx_ne_C, Complex.cpow_one]
        rw [h_cpow, Complex.ofReal_inv, Complex.ofReal_neg]
        field_simp [hs_ne, hx_ne_C]
        ring
      have hG_tendsto_zero : Filter.Tendsto G (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
        rw [tendsto_zero_iff_norm_tendsto_zero]
        let B : ℝ → ℝ := fun t => ‖1 / s ^ 2‖ * t ^ s.re + (2 / s.re / ‖s‖) * t ^ (s.re / 2)
        have hB_tendsto : Filter.Tendsto B (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
          have h1 : Filter.Tendsto (fun t : ℝ => t ^ s.re) (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
            have hc : Filter.Tendsto (fun t : ℝ => t ^ s.re) (nhdsWithin 0 (Set.Ioi 0)) (nhds ((0 : ℝ) ^ s.re)) :=
              (Real.continuousAt_rpow_const 0 s.re (Or.inr (le_of_lt hs))).continuousWithinAt.tendsto
            rwa [Real.zero_rpow (ne_of_gt hs)] at hc
          have h2 : Filter.Tendsto (fun t : ℝ => t ^ (s.re / 2)) (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
            have hc : Filter.Tendsto (fun t : ℝ => t ^ (s.re / 2)) (nhdsWithin 0 (Set.Ioi 0)) (nhds ((0 : ℝ) ^ (s.re / 2))) :=
              (Real.continuousAt_rpow_const 0 (s.re / 2) (Or.inr (le_of_lt (half_pos hs)))).continuousWithinAt.tendsto
            rwa [Real.zero_rpow (ne_of_gt (half_pos hs))] at hc
          have h3 := (h1.const_mul ‖1 / s ^ 2‖).add (h2.const_mul (2 / s.re / ‖s‖))
          rwa [mul_zero, mul_zero, add_zero] at h3
        refine squeeze_zero' (Filter.Eventually.of_forall (fun t => norm_nonneg (G t))) ?_ hB_tendsto
        filter_upwards [Ioo_mem_nhdsGT zero_lt_one] with t ht
        dsimp [G, B]
        rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos ht.1]
        have h_sub : ‖1 / s ^ 2 - (Real.log t : ℂ) / s‖ ≤ ‖1 / s ^ 2‖ + (-Real.log t) / ‖s‖ := by
          calc ‖1 / s ^ 2 - (Real.log t : ℂ) / s‖
            _ ≤ ‖1 / s ^ 2‖ + ‖(Real.log t : ℂ) / s‖ := norm_sub_le _ _
            _ = ‖1 / s ^ 2‖ + (-Real.log t) / ‖s‖ := by
              rw [norm_div (Real.log t : ℂ) s, Complex.norm_real,
                Real.norm_of_nonpos (Real.log_nonpos (le_of_lt ht.1) (le_of_lt ht.2))]
        have h_log := h_neg_log_le_rpow ht.1 (half_pos hs)
        have h_div : (-Real.log t) / ‖s‖ ≤ ((2 / s.re) / ‖s‖) * t ^ (-(s.re / 2)) := by
          calc (-Real.log t) / ‖s‖ ≤ ((1 / (s.re / 2)) * t ^ (-(s.re / 2))) / ‖s‖ :=
