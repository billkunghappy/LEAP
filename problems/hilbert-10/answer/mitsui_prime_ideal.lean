  have h_lin : ∀ (v : Fin n → K) (q : Fin n → ℚ) (j : Fin n),
      Φ₀ (∑ i : Fin n, (q i : K) * v i) j = ∑ i : Fin n, Φ₀ (v i) j * (q i : ℝ) := by
    intro v q j
    dsimp [Φ₀]
    have h_re_lin : ∀ w : NumberField.InfinitePlace K,
        (w.embedding (∑ i : Fin n, (q i : K) * v i)).re =
        ∑ i : Fin n, (w.embedding (v i)).re * (q i : ℝ) := by
      intro w
      rw [map_sum, Complex.re_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, map_ratCast, Complex.mul_re, Complex.ratCast_re, Complex.ratCast_im]
      ring
    have h_im_lin : ∀ w : NumberField.InfinitePlace K,
        (w.embedding (∑ i : Fin n, (q i : K) * v i)).im =
        ∑ i : Fin n, (w.embedding (v i)).im * (q i : ℝ) := by
      intro w
      rw [map_sum, Complex.im_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, map_ratCast, Complex.mul_im, Complex.ratCast_re, Complex.ratCast_im]
      ring
    rcases ι_idx.symm j with w | ⟨w, q_idx⟩
    · dsimp [Ψ₀]
      exact h_re_lin w.1
    · dsimp [Ψ₀]
      split_ifs with hp
      · rw [h_re_lin w.1, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => by ring)
      · rw [h_im_lin w.1, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => by ring)
  let M₀ : Matrix (Fin n) (Fin n) ℝ := Matrix.of (fun j i => Φ₀ (v₁ i) j)
  let B₀ : Matrix (Fin n) (Fin n) ℝ := Matrix.of (fun j i => Φ₀ (v₂ i / γ) j)
  have h_tr : ∀ x y : K,
      (∑ j : Fin n, Φ₀ x j * (s_dual j * Φ₀ y j)) = (Algebra.trace ℚ K (x * y) : ℝ) := by
    intro x y
    exact (h_pair x y).trans (h_s1 x y).symm
  have h_dual' : ∀ i l : Fin n,
      (∑ j : Fin n, M₀ j i * (s_dual j * B₀ j l)) = if i = l then 1 else 0 := by
    intro i l
    dsimp [M₀, B₀]
    rw [h_tr (v₁ i) (v₂ l / γ)]
    exact h_dual i l
  have h_det' : |(Matrix.of (fun i l : Fin n =>
      ∑ j : Fin n, M₀ j i * (s_dual j * M₀ j l))).det| = Δ ^ 2 := by
    have h_mat_eq : Matrix.of (fun i l : Fin n => ∑ j : Fin n, M₀ j i * (s_dual j * M₀ j l)) =
        Matrix.of (fun i l : Fin n => (Algebra.trace ℚ K (v₁ i * v₁ l) : ℝ)) := by
      ext i l
      dsimp [M₀]
      exact h_tr (v₁ i) (v₁ l)
    rw [h_mat_eq]
    exact h_det
  let A : Matrix (Fin n) (Fin n) ℝ := Matrix.of (fun j i => c j * M₀ j i)
  let N : Matrix (Fin n) (Fin n) ℝ := Matrix.of (fun j i => (c j)⁻¹ * s_dual j * B₀ j i)
  have hAN : A.transpose * N = 1 := by
    ext i l
    rw [Matrix.mul_apply, Matrix.one_apply, ← h_dual' i l]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    dsimp [A, N]
    have hcj : c j ≠ 0 := ne_of_gt (hc_pos j)
    calc (c j * M₀ j i) * ((c j)⁻¹ * s_dual j * B₀ j l)
      _ = (c j * (c j)⁻¹) * (M₀ j i * (s_dual j * B₀ j l)) := by ring
      _ = 1 * (M₀ j i * (s_dual j * B₀ j l)) := by rw [mul_inv_cancel₀ hcj]
      _ = M₀ j i * (s_dual j * B₀ j l) := one_mul _
  have hAinvT : A.transpose⁻¹ = N := Matrix.inv_eq_right_inv hAN
  have hA_det_ne : A.det ≠ 0 := by
    have hdet : A.det * N.det = 1 := by
      have h1 := congr_arg Matrix.det hAN
      rwa [Matrix.det_mul, Matrix.det_transpose, Matrix.det_one] at h1
    exact left_ne_zero_of_mul_eq_one hdet
  have h_T_eq : Matrix.of (fun i l : Fin n => ∑ j : Fin n, M₀ j i * (s_dual j * M₀ j l)) =
      M₀.transpose * (Matrix.diagonal s_dual * M₀) := by
    ext i l
    rw [Matrix.of_apply, Matrix.mul_apply]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Matrix.transpose_apply, Matrix.diagonal_mul]
  have hs_prod : (∏ j : Fin n, |s_dual j|) = 1 := by
    simp [hs_dual_abs]
  have hM0_sq : |M₀.det| ^ 2 = Δ ^ 2 := by
    rw [← h_det', h_T_eq, Matrix.det_mul, Matrix.det_transpose, Matrix.det_mul,
      Matrix.det_diagonal, abs_mul, abs_mul, Finset.abs_prod, hs_prod]
    ring
  have hM0_abs : |M₀.det| = Δ :=
    (sq_eq_sq₀ (abs_nonneg _) (le_of_lt hΔ)).mp hM0_sq
  have hA_eq_diag : A = Matrix.diagonal c * M₀ := by
    ext j i
    dsimp [A]
    rw [Matrix.diagonal_mul]
  have hc_prod_pos : 0 < ∏ j : Fin n, c j :=
    Finset.prod_pos (fun j _ => hc_pos j)
  have hA_det_abs : |A.det| = Δ * ∏ w : NumberField.InfinitePlace K, (t w) ^ ((w.mult : ℝ) / 2) := by
    rw [hA_eq_diag, Matrix.det_mul, Matrix.det_diagonal, abs_mul,
      abs_of_pos hc_prod_pos, hM0_abs, mul_comm, hc_prod]
  have h_vec_A : ∀ (q : Fin n → ℚ) (j : Fin n),
      A.mulVec (fun i => (q i : ℝ)) j = c j * Φ₀ (∑ i : Fin n, (q i : K) * v₁ i) j := by
    intro q j
    dsimp [A, M₀, Matrix.mulVec, dotProduct]
    rw [h_lin v₁ q j, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => by ring)
  have h_vec_N : ∀ (l : Fin n → ℤ) (j : Fin n),
      A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j =
        (c j)⁻¹ * s_dual j * Φ₀ ((∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / γ) j := by
    intro l j
    rw [hAinvT]
    dsimp [N, B₀, Matrix.mulVec, dotProduct]
    have h_div_sum : (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / γ =
        ∑ i : Fin n, ((l i : ℚ) : K) * (v₂ i / γ) := by
      rw [Finset.sum_div]
      refine Finset.sum_congr rfl (fun i _ => mul_div_assoc _ _ _)
    rw [h_div_sum, h_lin (fun i => v₂ i / γ) (fun i => (l i : ℚ)) j, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Rat.cast_intCast]
    ring
  refine ⟨A, d, p, s, c_deg, hA_det_ne, hA_det_abs, hd_le, hp_ne, hs_sq, hd_disj, hc_disj, hd_sum, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro q
    simp_rw [h_vec_A q]
    exact hP_norm (∑ i : Fin n, (q i : K) * v₁ i)
  · intro q
    simp_rw [h_vec_A q]
    exact hP_cplx (∑ i : Fin n, (q i : K) * v₁ i)
  · intro q
    simp_rw [h_vec_A q]
    exact hP_quad (∑ i : Fin n, (q i : K) * v₁ i)
  · intro l
    simp_rw [h_vec_N l]
    have hs2 := (h_s2 (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i)).1
    exact hs2.symm.trans (hD_norm ((∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / γ))
  · intro l
    simp_rw [h_vec_N l]
    have hs2 := (h_s2 (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i)).2.1
    exact (hD_cplx ((∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / γ)).trans hs2
  · intro l
    simp_rw [h_vec_N l]
    have hs2 := (h_s2 (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i)).2.2
    exact hs2.symm.trans (hD_quad ((∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / γ))

theorem mitsui_matrix_shifted_complex_harmonic_gaussian_poisson_summation (n : ℕ)
    (A : Matrix (Fin n) (Fin n) ℝ) (hA : A.det ≠ 0)
    (u : Fin n → ℝ)
    (d : Fin n → ℕ) (hd : ∀ j : Fin n, d j ≤ 1)
    (p : Fin n → Fin n)
    (s : Fin n → ℝ)
    (c_deg : Fin n → ℕ)
    (hp_ne : ∀ j : Fin n, c_deg j ≠ 0 → p j ≠ j)
    (hs_sq : ∀ j : Fin n, c_deg j ≠ 0 → s j ^ 2 = 1)
    (hd_disj : ∀ j : Fin n, c_deg j ≠ 0 → d j = 0 ∧ d (p j) = 0)
    (hc_disj : ∀ j₁ j₂ : Fin n, c_deg j₁ ≠ 0 → c_deg j₂ ≠ 0 → j₁ ≠ j₂ →
      j₁ ≠ p j₂ ∧ p j₁ ≠ j₂ ∧ p j₁ ≠ p j₂) :
    Summable (fun k : Fin n → ℤ =>
      ((∏ j : Fin n, |A.mulVec (fun i => u i + (k i : ℝ)) j| ^ (d j)) *
        ∏ j : Fin n,
          ‖(((A.mulVec (fun i => u i + (k i : ℝ)) j : ℂ) +
              (s j : ℂ) * (A.mulVec (fun i => u i + (k i : ℝ)) (p j) : ℂ) * Complex.I) /
            (Real.sqrt 2 : ℂ))‖ ^ (c_deg j)) *
      Real.exp (-Real.pi *
        ∑ j : Fin n, (A.mulVec (fun i => u i + (k i : ℝ)) j) ^ 2)) ∧
    Summable (fun l : Fin n → ℤ =>
      ((∏ j : Fin n, |A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j| ^ (d j)) *
        ∏ j : Fin n,
          ‖(((A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j : ℂ) +
              (s j : ℂ) * (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) (p j) : ℂ) * Complex.I) /
            (Real.sqrt 2 : ℂ))‖ ^ (c_deg j)) *
      Real.exp (-Real.pi *
        ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2)) ∧
    (∑' k : Fin n → ℤ,
      ((((∏ j : Fin n, (A.mulVec (fun i => u i + (k i : ℝ)) j) ^ (d j) : ℝ) : ℂ) *
        ∏ j : Fin n,
          (((A.mulVec (fun i => u i + (k i : ℝ)) j : ℂ) +
              (s j : ℂ) * (A.mulVec (fun i => u i + (k i : ℝ)) (p j) : ℂ) * Complex.I) /
            (Real.sqrt 2 : ℂ)) ^ (c_deg j)) *
      (Real.exp (-Real.pi *
        ∑ j : Fin n, (A.mulVec (fun i => u i + (k i : ℝ)) j) ^ 2) : ℂ))) =
      ((-Complex.I) ^ ((∑ j : Fin n, d j) + (∑ j : Fin n, c_deg j)) *
        ((|A.det|⁻¹ : ℝ) : ℂ)) *
        ∑' l : Fin n → ℤ,
          Complex.exp (2 * Real.pi * Complex.I *
            (∑ i : Fin n, u i * (l i : ℝ) : ℂ)) *
            ((((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d j) : ℝ) : ℂ) *
              ∏ j : Fin n,
                (((A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j : ℂ) +
                    (s j : ℂ) * (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) (p j) : ℂ) * Complex.I) /
                  (Real.sqrt 2 : ℂ)) ^ (c_deg j)) *
            (Real.exp (-Real.pi *
              ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ)) :=
by
  classical
  have h_det_dual : ∀ {N : ℕ} (B : Matrix (Fin N) (Fin N) ℝ), B.det ≠ 0 → B.transpose⁻¹.det ≠ 0 := by
    intro N B hB
    rw [Matrix.det_nonsing_inv, Matrix.det_transpose, Ring.inverse_eq_inv]
    exact inv_ne_zero hB
  have h_det_smul : ∀ {N : ℕ} (c : ℝ), c ≠ 0 → ∀ (B : Matrix (Fin N) (Fin N) ℝ), B.det ≠ 0 → (c • B).det ≠ 0 := by
    intro N c hc B hB
    rw [Matrix.det_smul, Fintype.card_fin]
    exact mul_ne_zero (pow_ne_zero N hc) hB
  let Z : (Fin n → ℝ) → Fin n → ℂ := fun v j =>
    (((v j : ℂ) + (s j : ℂ) * (v (p j) : ℂ) * Complex.I) / (Real.sqrt 2 : ℂ))
  
  have h_poly_exp_bound : ∀ (c₁ : Fin n → ℕ),
      ∃ C_poly : ℝ, 0 < C_poly ∧ ∀ v : Fin n → ℝ,
        ((∏ j : Fin n, |v j| ^ (d j)) *
          ∏ j : Fin n, ‖Z v j‖ ^ (c₁ j)) ≤
        C_poly * Real.exp (3 * Real.pi / 4 * ∑ j : Fin n, (v j) ^ 2) := by
    intro c₁
    have h_abs_le : ∀ x : ℝ, |x| ≤ 1 + x ^ 2 := by
      intro x
      have h1 : 0 ≤ (|x| - 1) ^ 2 := sq_nonneg (|x| - 1)
      have h2 : |x| ^ 2 = x ^ 2 := sq_abs x
      nlinarith
    have h_coord_le : ∀ (v : Fin n → ℝ) (j : Fin n), |v j| ≤ 1 + ∑ i : Fin n, (v i) ^ 2 := by
      intro v j
      have h1 := h_abs_le (v j)
      have h2 : (v j) ^ 2 ≤ ∑ i : Fin n, (v i) ^ 2 :=
        Finset.single_le_sum (fun i _ => sq_nonneg (v i)) (Finset.mem_univ j)
      linarith
    have h_sqrt2_ge_one : (1 : ℝ) ≤ Real.sqrt 2 := by
      rw [← Real.sqrt_one]
      exact Real.sqrt_le_sqrt (by norm_num)
    have h_Z_le : ∀ (v : Fin n → ℝ) (j : Fin n),
        ‖Z v j‖ ≤ (1 + |s j|) * (1 + ∑ i : Fin n, (v i) ^ 2) := by
      intro v j
      dsimp [Z]
      rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg 2)]
      have h_div : ‖(v j : ℂ) + (s j : ℂ) * (v (p j) : ℂ) * Complex.I‖ / Real.sqrt 2 ≤
          ‖(v j : ℂ) + (s j : ℂ) * (v (p j) : ℂ) * Complex.I‖ :=
        div_le_self (norm_nonneg _) h_sqrt2_ge_one
      have h_tri := norm_add_le (v j : ℂ) ((s j : ℂ) * (v (p j) : ℂ) * Complex.I)
      rw [norm_mul, norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Complex.norm_real,
        Complex.norm_real, Real.norm_eq_abs, Real.norm_eq_abs, Real.norm_eq_abs] at h_tri
      have hj1 := h_coord_le v j
      have hj2 := h_coord_le v (p j)
      have hs_nn : 0 ≤ |s j| := abs_nonneg (s j)
      nlinarith
    let M : ℕ := (∑ j : Fin n, d j) + (∑ j : Fin n, c₁ j)
    let ε : ℝ := 3 * Real.pi / 4
    have hε_pos : 0 < ε := by dsimp [ε]; positivity
    let η : ℝ := ε / ((M : ℝ) + 1)
    have hη_pos : 0 < η := by dsimp [η]; positivity
    let C_poly : ℝ := (∏ j : Fin n, (1 + |s j|) ^ (c₁ j)) * (1 + η⁻¹) ^ M
    have hC_pos : 0 < C_poly := by
      dsimp [C_poly]
      exact mul_pos (Finset.prod_pos (fun j _ => by positivity)) (by positivity)
    refine ⟨C_poly, hC_pos, fun v => ?_⟩
    set S : ℝ := ∑ i : Fin n, (v i) ^ 2
    have hS_nn : 0 ≤ S := Finset.sum_nonneg (fun i _ => sq_nonneg (v i))
    have h_prod_d : (∏ j : Fin n, |v j| ^ (d j)) ≤ (1 + S) ^ (∑ j : Fin n, d j) := by
      calc (∏ j : Fin n, |v j| ^ (d j))
        _ ≤ ∏ j : Fin n, (1 + S) ^ (d j) :=
            Finset.prod_le_prod (fun j _ => by positivity)
              (fun j _ => pow_le_pow_left₀ (abs_nonneg _) (h_coord_le v j) (d j))
        _ = (1 + S) ^ (∑ j : Fin n, d j) := Finset.prod_pow_eq_pow_sum _ _ _
    have h_prod_c : (∏ j : Fin n, ‖Z v j‖ ^ (c₁ j)) ≤
        (∏ j : Fin n, (1 + |s j|) ^ (c₁ j)) * (1 + S) ^ (∑ j : Fin n, c₁ j) := by
      calc (∏ j : Fin n, ‖Z v j‖ ^ (c₁ j))
        _ ≤ ∏ j : Fin n, ((1 + |s j|) * (1 + S)) ^ (c₁ j) :=
            Finset.prod_le_prod (fun j _ => by positivity)
              (fun j _ => pow_le_pow_left₀ (norm_nonneg _) (h_Z_le v j) (c₁ j))
        _ = ∏ j : Fin n, ((1 + |s j|) ^ (c₁ j) * (1 + S) ^ (c₁ j)) :=
            Finset.prod_congr rfl (fun j _ => mul_pow _ _ _)
        _ = (∏ j : Fin n, (1 + |s j|) ^ (c₁ j)) * ∏ j : Fin n, (1 + S) ^ (c₁ j) :=
            Finset.prod_mul_distrib
        _ = (∏ j : Fin n, (1 + |s j|) ^ (c₁ j)) * (1 + S) ^ (∑ j : Fin n, c₁ j) := by
            rw [Finset.prod_pow_eq_pow_sum]
    have h_one_add_S : 1 + S ≤ (1 + η⁻¹) * Real.exp (η * S) := by
      have h_inv : η⁻¹ * (η * S) = S := inv_mul_cancel_left₀ (ne_of_gt hη_pos) S
      have h_exp := Real.add_one_le_exp (η * S)
      have h_η_inv_nn : 0 ≤ η⁻¹ := by positivity
      have h_ηS_nn : 0 ≤ η * S := by positivity
      nlinarith
    have h_pow_M : (1 + S) ^ M ≤ (1 + η⁻¹) ^ M * Real.exp (ε * S) := by
      calc (1 + S) ^ M
        _ ≤ ((1 + η⁻¹) * Real.exp (η * S)) ^ M :=
            pow_le_pow_left₀ (by positivity) h_one_add_S M
        _ = (1 + η⁻¹) ^ M * (Real.exp (η * S)) ^ M := mul_pow _ _ _
        _ = (1 + η⁻¹) ^ M * Real.exp ((M : ℝ) * (η * S)) := by rw [← Real.exp_nat_mul]
        _ ≤ (1 + η⁻¹) ^ M * Real.exp (ε * S) := by
            refine mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr ?_) (by positivity)
            have h_eq : (M : ℝ) * (η * S) = ((M : ℝ) / ((M : ℝ) + 1)) * (ε * S) := by
              dsimp [η]; ring
            rw [h_eq]
            exact mul_le_of_le_one_left (by positivity)
              (div_le_one_of_le₀ (by linarith) (by positivity))
    have h_prod_comb :
        (∏ j : Fin n, |v j| ^ (d j)) * (∏ j : Fin n, ‖Z v j‖ ^ (c₁ j)) ≤
        (∏ j : Fin n, (1 + |s j|) ^ (c₁ j)) * (1 + S) ^ M := by
      calc (∏ j : Fin n, |v j| ^ (d j)) * (∏ j : Fin n, ‖Z v j‖ ^ (c₁ j))
        _ ≤ (1 + S) ^ (∑ j : Fin n, d j) *
              ((∏ j : Fin n, (1 + |s j|) ^ (c₁ j)) * (1 + S) ^ (∑ j : Fin n, c₁ j)) :=
            mul_le_mul h_prod_d h_prod_c (by positivity) (by positivity)
        _ = (∏ j : Fin n, (1 + |s j|) ^ (c₁ j)) *
              ((1 + S) ^ (∑ j : Fin n, d j) * (1 + S) ^ (∑ j : Fin n, c₁ j)) := by ring
        _ = (∏ j : Fin n, (1 + |s j|) ^ (c₁ j)) * (1 + S) ^ M := by
            dsimp [M]; rw [pow_add]
    calc (∏ j : Fin n, |v j| ^ (d j)) * (∏ j : Fin n, ‖Z v j‖ ^ (c₁ j))
      _ ≤ (∏ j : Fin n, (1 + |s j|) ^ (c₁ j)) * (1 + S) ^ M := h_prod_comb
      _ ≤ (∏ j : Fin n, (1 + |s j|) ^ (c₁ j)) * ((1 + η⁻¹) ^ M * Real.exp (ε * S)) :=
          mul_le_mul_of_nonneg_left h_pow_M (Finset.prod_nonneg (fun j _ => by positivity))
      _ = C_poly * Real.exp (3 * Real.pi / 4 * ∑ j : Fin n, (v j) ^ 2) := by
          dsimp [C_poly, ε, S]; ring
  have h_s3_summable : ∀ (B : Matrix (Fin n) (Fin n) ℝ) (v : Fin n → ℝ) (c₁ : Fin n → ℕ),
      Summable (fun k : Fin n → ℤ =>
        Real.exp (-Real.pi *
          ∑ j : Fin n, (((1 / 2 : ℝ) • B).mulVec (fun i => (k i : ℝ) + v i) j) ^ 2)) →
      Summable (fun k : Fin n → ℤ =>
        ((∏ j : Fin n, |B.mulVec (fun i => v i + (k i : ℝ)) j| ^ (d j)) *
          ∏ j : Fin n, ‖Z (B.mulVec (fun i => v i + (k i : ℝ))) j‖ ^ (c₁ j)) *
        Real.exp (-Real.pi *
          ∑ j : Fin n, (B.mulVec (fun i => v i + (k i : ℝ)) j) ^ 2)) := by
    intro B v c₁ h_gauss
    obtain ⟨C_poly, hC_pos, h_bound⟩ := h_poly_exp_bound c₁
    refine Summable.of_nonneg_of_le (fun k => by positivity) (fun k => ?_) (h_gauss.mul_left C_poly)
    set y : Fin n → ℝ := B.mulVec (fun i => v i + (k i : ℝ))
    have h_vec : (fun i : Fin n => (k i : ℝ) + v i) = (fun i : Fin n => v i + (k i : ℝ)) := by
      ext i; exact add_comm _ _
    have h_sum_sq : (∑ j : Fin n, (((1 / 2 : ℝ) • B).mulVec (fun i => (k i : ℝ) + v i) j) ^ 2) =
        (1 / 4 : ℝ) * ∑ j : Fin n, (y j) ^ 2 := by
      rw [h_vec, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [Matrix.smul_mulVec]
