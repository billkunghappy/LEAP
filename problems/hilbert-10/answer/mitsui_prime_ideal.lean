theorem mitsui_narrow_archimedean_gamma_inv_and_strip_bounds (D : ℝ) (q₀ q₁ r₂ : ℕ) (hD_ge_one : 1 ≤ D) :
    ∃ G_inv : ℂ → ℂ,
      Differentiable ℂ G_inv ∧
      (∀ s : ℂ, 1 < s.re →
        ((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ q₀ * (Complex.Gammaℝ (s + 1)) ^ q₁ * (Complex.Gammaℂ s) ^ r₂) *
          G_inv s = 1) ∧
      (∀ s : ℂ, s.re = -1 / 2 →
        ‖((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ (q₀ + q₁) * (Complex.Gammaℂ s) ^ r₂) * G_inv s‖ *
          ‖(D : ℂ) ^ ((1 - s) / 2) * (Complex.Gammaℝ (1 - s)) ^ q₀ *
            (Complex.Gammaℝ ((1 - s) + 1)) ^ q₁ * (Complex.Gammaℂ (1 - s)) ^ r₂‖ =
        ‖(D : ℂ) ^ ((1 - s) / 2) * (Complex.Gammaℝ (1 - s)) ^ (q₀ + q₁) * (Complex.Gammaℂ (1 - s)) ^ r₂‖) ∧
      (∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 → 1 ≤ |s.im| →
        ‖G_inv s‖ ≤ D ^ (1 / 4 : ℝ) * Real.exp (8 * ((q₀ : ℝ) + (q₁ : ℝ) + (r₂ : ℝ)) * (4 + |s.im|))) :=
by
  have hD_pos : 0 < D := lt_of_lt_of_le zero_lt_one hD_ge_one
  have hD_ne : (D : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hD_pos)
  have hpi_ne : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  have h2pi_ne : (2 : ℂ) * (Real.pi : ℂ) ≠ 0 := mul_ne_zero two_ne_zero hpi_ne
  let d_inv : ℂ → ℂ := fun s => (D : ℂ) ^ (-s / 2)
  let gR_inv : ℂ → ℂ := fun s => (Complex.Gammaℝ s)⁻¹
  let gR1_inv : ℂ → ℂ := fun s => (Complex.Gammaℝ (s + 1))⁻¹
  let gC_inv : ℂ → ℂ := fun s => (1 / 2 : ℂ) * (2 * (Real.pi : ℂ)) ^ s * (Complex.Gamma s)⁻¹
  let G_inv : ℂ → ℂ := fun s =>
    d_inv s * (gR_inv s) ^ q₀ * (gR1_inv s) ^ q₁ * (gC_inv s) ^ r₂
  have hd_inv_diff : Differentiable ℂ d_inv :=
    ((differentiable_id.neg).div_const (2 : ℂ)).const_cpow (Or.inl hD_ne)
  have hgR_inv_diff : Differentiable ℂ gR_inv :=
    Complex.differentiable_Gammaℝ_inv
  have hgR1_inv_diff : Differentiable ℂ gR1_inv :=
    Complex.differentiable_Gammaℝ_inv.comp (differentiable_id.add (differentiable_const (1 : ℂ)))
  have hgC_inv_diff : Differentiable ℂ gC_inv :=
    ((differentiable_const (1 / 2 : ℂ)).mul (differentiable_id.const_cpow (Or.inl h2pi_ne))).mul
      Complex.differentiable_one_div_Gamma
  have hG_inv_diff : Differentiable ℂ G_inv :=
    ((hd_inv_diff.mul (hgR_inv_diff.pow q₀)).mul (hgR1_inv_diff.pow q₁)).mul (hgC_inv_diff.pow r₂)
  have hgC_inv_eq : ∀ s : ℂ, gC_inv s = (Complex.Gammaℂ s)⁻¹ := by
    intro s
    dsimp [gC_inv]
    rw [Complex.Gammaℂ_def, Complex.cpow_neg, mul_inv, mul_inv, inv_inv]
    ring
  have h_factors : ∀ s : ℂ, -1 / 2 ≤ s.re → s ≠ 0 →
      (D : ℂ) ^ (s / 2) * d_inv s = 1 ∧
      Complex.Gammaℝ s * gR_inv s = 1 ∧
      Complex.Gammaℝ (s + 1) * gR1_inv s = 1 ∧
      Complex.Gammaℂ s * gC_inv s = 1 := by
    intro s hs_re hs_ne
    have hDs_ne : (D : ℂ) ^ (s / 2) ≠ 0 := Complex.cpow_ne_zero_iff.mpr (Or.inl hD_ne)
    have hd_eq : d_inv s = ((D : ℂ) ^ (s / 2))⁻¹ := by
      dsimp [d_inv]
      rw [neg_div, Complex.cpow_neg]
    have h1 : (D : ℂ) ^ (s / 2) * d_inv s = 1 := by
      rw [hd_eq]
      exact mul_inv_cancel₀ hDs_ne
    have hs2_ne : s / 2 ≠ 0 := div_ne_zero hs_ne two_ne_zero
    have hs2_re : 0 < (s / 2 + 1).re := by
      simp only [Complex.add_re, Complex.div_ofNat_re, Complex.one_re]
      linarith
    have hG_s2_1_ne : Complex.Gamma (s / 2 + 1) ≠ 0 := Complex.Gamma_ne_zero_of_re_pos hs2_re
    rw [Complex.Gamma_add_one (s / 2) hs2_ne] at hG_s2_1_ne
    have hG_s2_ne : Complex.Gamma (s / 2) ≠ 0 := right_ne_zero_of_mul hG_s2_1_ne
    have hpi_pow_ne : (Real.pi : ℂ) ^ (-s / 2) ≠ 0 := Complex.cpow_ne_zero_iff.mpr (Or.inl hpi_ne)
    have hGR_ne : Complex.Gammaℝ s ≠ 0 := by
      rw [Complex.Gammaℝ_def]
      exact mul_ne_zero hpi_pow_ne hG_s2_ne
    have h2 : Complex.Gammaℝ s * gR_inv s = 1 := mul_inv_cancel₀ hGR_ne
    have hs1_re : 0 < (s + 1).re := by
      simp only [Complex.add_re, Complex.one_re]
      linarith
    have hGR1_ne : Complex.Gammaℝ (s + 1) ≠ 0 := Complex.Gammaℝ_ne_zero_of_re_pos hs1_re
    have h3 : Complex.Gammaℝ (s + 1) * gR1_inv s = 1 := mul_inv_cancel₀ hGR1_ne
    have hG_s1_ne : Complex.Gamma (s + 1) ≠ 0 := Complex.Gamma_ne_zero_of_re_pos hs1_re
    rw [Complex.Gamma_add_one s hs_ne] at hG_s1_ne
    have hG_s_ne : Complex.Gamma s ≠ 0 := right_ne_zero_of_mul hG_s1_ne
    have h2pi_pow_ne : (2 * (Real.pi : ℂ)) ^ (-s) ≠ 0 := Complex.cpow_ne_zero_iff.mpr (Or.inl h2pi_ne)
    have hGC_ne : Complex.Gammaℂ s ≠ 0 := by
      rw [Complex.Gammaℂ_def]
      exact mul_ne_zero (mul_ne_zero two_ne_zero h2pi_pow_ne) hG_s_ne
    have h4 : Complex.Gammaℂ s * gC_inv s = 1 := by
      rw [hgC_inv_eq s]
      exact mul_inv_cancel₀ hGC_ne
    exact ⟨h1, h2, h3, h4⟩
  refine ⟨G_inv, hG_inv_diff, ?_, ?_, ?_⟩
  · intro s hs
    have hs_re : -1 / 2 ≤ s.re := by linarith
    have hs_ne : s ≠ 0 := by
      intro h0
      rw [h0, Complex.zero_re] at hs
      linarith
    obtain ⟨h1, h2, h3, h4⟩ := h_factors s hs_re hs_ne
