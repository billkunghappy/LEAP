    calc 2 * A_main * (2 * (M : ℝ) + 1) ^ (NumberField.Units.rank K) * B_osc
      _ = 2 * ((A_main * (2 * (M : ℝ) + 1) ^ (NumberField.Units.rank K)) * B_osc) := by ring
      _ ≤ 2 * (((C_coeff * Real.exp (c' * t / 2)) *
            ((3 : ℝ) ^ (NumberField.Units.rank K) * Real.exp (t / (8 * c_base)))) *
            (c_base * Real.exp 1 * Y₀ * Real.exp (-t / c_base))) :=
        mul_le_mul_of_nonneg_left
