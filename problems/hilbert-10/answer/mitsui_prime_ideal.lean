  have hsqrt_Z_plus_ge : Real.sqrt (Real.log Y) ≤ Real.sqrt (Real.log (Real.exp δ * Y)) :=
    Real.sqrt_le_sqrt hlog_Z_plus_ge
  have hlogY_pos : 0 < Real.log Y := lt_of_lt_of_le hlogX_pos hlogX_le_logY
  have hq_norm_Z_plus : (Ideal.absNorm q : ℝ) < Real.log (Real.exp δ * Y) ^ A :=
    lt_of_lt_of_le hq_norm_Y (pow_le_pow_left₀ (le_of_lt hlogY_pos) hlog_Z_plus_ge A)
  have hΨ₁_cone_Z_plus : ‖Ψ₁_cone (Real.exp δ * Y)‖ ≤ (c * Real.exp 1) * Y * δ ^ 2 := by
    have h1 := hΨ₁_cone_le (Real.exp δ * Y) hZ_plus_gt_one hq_norm_Z_plus
    have hexp_le : Real.exp (-Real.sqrt (Real.log (Real.exp δ * Y)) / c₀) ≤ δ ^ 2 := by
      rw [hδ_sq, Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      have h_step1 : Real.sqrt (Real.log Y) / c ≤ Real.sqrt (Real.log (Real.exp δ * Y)) / c :=
        div_le_div_of_nonneg_right hsqrt_Z_plus_ge (le_of_lt hc_pos)
      have h_step2 : Real.sqrt (Real.log (Real.exp δ * Y)) / c ≤
          Real.sqrt (Real.log (Real.exp δ * Y)) / c₀ :=
        div_le_div_of_nonneg_left (Real.sqrt_nonneg _) hc₀_pos hc₀_le
      linarith
    have hWc0_exp_le : (W * c₀) * Real.exp δ ≤ c * Real.exp 1 :=
      mul_le_mul hWc₀_le hexpδ_le_e (le_of_lt (Real.exp_pos δ)) (le_of_lt hc_pos)
    calc ‖Ψ₁_cone (Real.exp δ * Y)‖
      _ ≤ (W * c₀) * (Real.exp δ * Y) * Real.exp (-Real.sqrt (Real.log (Real.exp δ * Y)) / c₀) := h1
      _ ≤ (W * c₀) * (Real.exp δ * Y) * δ ^ 2 := mul_le_mul_of_nonneg_left hexp_le (by positivity)
      _ = ((W * c₀) * Real.exp δ) * (Y * δ ^ 2) := by ring
      _ ≤ (c * Real.exp 1) * (Y * δ ^ 2) := mul_le_mul_of_nonneg_right hWc0_exp_le (by positivity)
      _ = (c * Real.exp 1) * Y * δ ^ 2 := by ring
  have hΨ₁_K_Z_plus : W * |Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y| ≤ (c * Real.exp 1) * Y * δ ^ 2 := by
    have h1 : |Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y| ≤
