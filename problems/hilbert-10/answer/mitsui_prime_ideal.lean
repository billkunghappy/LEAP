        (div_lt_iff₀ hh_pos).mp (Int.lt_floor_add_one ((z (e.symm j).1).1 / h))⟩
    have hq₁_near : ∀ j : Fin r,
        |(z (e.symm j).1).1 - (q₁ j : ℝ) * (K_δ : ℝ)⁻¹| ≤ (K_δ : ℝ)⁻¹ := by
      intro j
