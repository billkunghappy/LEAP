      rw [LSeries.term_of_ne_zero hm, h_mul_cpow]
      push_cast
      field_simp [hm_c_ne]
  have hF_norm_eq : ∀ (m : ℕ) (u : ℝ), u ∈ Set.Ioi (0 : ℝ) →
