  have h_term_norm : ∀ pm : D_ge1,
      ‖term_ge1 pm‖ = Real.log (Ideal.absNorm pm.1.1.asIdeal) := by
    intro pm
    dsimp [term_ge1]
    rw [norm_mul, AddChar.norm_apply, one_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (Real.log_natCast_nonneg _)]
  have h_norm_diff : ‖(∑' p : D_1, term_1 p) - (∑' pm : D_ge1, term_ge1 pm)‖ ≤
      ∑ pm : {pm : D_ge1 // ¬ (pm.1.2 = 1)}, Real.log (Ideal.absNorm pm.1.1.1.asIdeal) := by
    rw [h_diff, norm_neg]
    calc ‖∑ pm ∈ Finset.univ.filter (fun pm : D_ge1 => ¬ (pm.1.2 = 1)), term_ge1 pm‖
      _ ≤ ∑ pm ∈ Finset.univ.filter (fun pm : D_ge1 => ¬ (pm.1.2 = 1)), ‖term_ge1 pm‖ :=
