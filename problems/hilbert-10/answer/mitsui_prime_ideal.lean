      have h_diff_σ : DifferentiableAt ℂ D_K (σ : ℂ) :=
        hDK_diff_of_ne (σ : ℂ) (hg_dlvp (σ : ℂ) hσ_re).1
      exact (h_diff_σ.continuousAt.comp Complex.continuous_ofReal.continuousAt).continuousWithinAt
    obtain ⟨M₁', hM₁'⟩ := isCompact_Icc.bddAbove_image h_cont
    refine ⟨max M₁' 1, lt_of_lt_of_le zero_lt_one (le_max_right M₁' 1), ?_⟩
    intro σ hσ
    exact le_trans (hM₁' (Set.mem_image_of_mem _ hσ)) (le_max_left M₁' 1)
  obtain ⟨M₁, hM₁_pos, hM₁⟩ := h_compact_Icc
  let σ₀ : ℝ → ℝ := fun t => 1 + B₀ / (4 * Real.log (4 + |t|))
  let M₀ : ℝ := M₁ + 8 / B₀
  have hM₀_pos : 0 < M₀ := by dsimp [M₀]; positivity
  have h_rhp_bound : ∀ s : ℂ, σ₀ s.im ≤ s.re → ‖D_K s‖ ≤ M₀ * Real.log (4 + |s.im|) := by
    intro s hs_re
    set t : ℝ := s.im
    set L : ℝ := Real.log (4 + |t|)
    have hL_ge_one : 1 ≤ L := h_log_ge_one t
    have hL_pos : 0 < L := h_log_pos t
    have hσ₀_gt_one : 1 < σ₀ t := by
      dsimp [σ₀]
      have : 0 < B₀ / (4 * L) := by positivity
      linarith
    have hσ₀_le_two : σ₀ t ≤ 2 := by
      dsimp [σ₀]
      have h1 : B₀ ≤ 4 * L := by linarith
      have h2 : B₀ / (4 * L) ≤ 1 := (div_le_one (by positivity)).mpr h1
      linarith
    have hs_gt_one : 1 < s.re := lt_of_lt_of_le hσ₀_gt_one hs_re
    have hσ₀_c_gt_one : 1 < (σ₀ t : ℂ).re := by simpa using hσ₀_gt_one
    have hDK_s := hDK_eq s hs_gt_one
    have hDK_σ₀ := hDK_eq (σ₀ t : ℂ) hσ₀_c_gt_one
    have hΛ_σ₀_eq : LSeries (fun n => (Λ_K n : ℂ)) (σ₀ t : ℂ) =
        D_K (σ₀ t : ℂ) + 1 / ((σ₀ t : ℂ) - 1) := by
      linear_combination -hDK_σ₀
    have h_pole_σ₀ : ‖(1 : ℂ) / ((σ₀ t : ℂ) - 1)‖ = (4 / B₀) * L := by
      have h_sub : (σ₀ t : ℂ) - 1 = ((B₀ / (4 * L) : ℝ) : ℂ) := by
        dsimp [σ₀]; push_cast; ring
      rw [h_sub, one_div, norm_inv, Complex.norm_of_nonneg (by positivity)]
      field_simp [ne_of_gt hB₀_pos, ne_of_gt hL_pos]
    have h_pole_s : ‖(1 : ℂ) / (s - 1)‖ ≤ (4 / B₀) * L := by
      have h_re_sub : B₀ / (4 * L) ≤ (s - 1).re := by
        rw [Complex.sub_re, Complex.one_re]
        dsimp [σ₀] at hs_re
        linarith
      have h_norm_sub : B₀ / (4 * L) ≤ ‖s - 1‖ :=
        le_trans h_re_sub (le_trans (le_abs_self _) (Complex.abs_re_le_norm (s - 1)))
      rw [one_div, norm_inv]
      have h_inv := inv_anti₀ (by positivity : 0 < B₀ / (4 * L)) h_norm_sub
      have h_eq : (B₀ / (4 * L))⁻¹ = (4 / B₀) * L := by
        field_simp [ne_of_gt hB₀_pos, ne_of_gt hL_pos]
      linarith
    have hDK_σ₀_le : ‖D_K (σ₀ t : ℂ)‖ ≤ M₁ := hM₁ (σ₀ t) ⟨le_of_lt hσ₀_gt_one, hσ₀_le_two⟩
    have hΛ_σ₀_le : ‖LSeries (fun n => (Λ_K n : ℂ)) (σ₀ t : ℂ)‖ ≤ M₁ + (4 / B₀) * L := by
      rw [hΛ_σ₀_eq]
      calc ‖D_K (σ₀ t : ℂ) + 1 / ((σ₀ t : ℂ) - 1)‖
          ≤ ‖D_K (σ₀ t : ℂ)‖ + ‖(1 : ℂ) / ((σ₀ t : ℂ) - 1)‖ := norm_add_le _ _
        _ ≤ M₁ + (4 / B₀) * L := by linarith [hDK_σ₀_le, h_pole_σ₀]
    have hΛ_s_le : ‖LSeries (fun n => (Λ_K n : ℂ)) s‖ ≤ M₁ + (4 / B₀) * L :=
      le_trans (h_s2 s (σ₀ t) hσ₀_gt_one hs_re) hΛ_σ₀_le
    have hM₁_le : M₁ ≤ M₁ * L := le_mul_of_one_le_right (le_of_lt hM₁_pos) hL_ge_one
    calc ‖D_K s‖
        = ‖LSeries (fun n => (Λ_K n : ℂ)) s - 1 / (s - 1)‖ := by rw [hDK_eq s hs_gt_one]
      _ ≤ ‖LSeries (fun n => (Λ_K n : ℂ)) s‖ + ‖(1 : ℂ) / (s - 1)‖ := norm_sub_le _ _
      _ ≤ (M₁ + (4 / B₀) * L) + (4 / B₀) * L := add_le_add hΛ_s_le h_pole_s
      _ = M₁ + (8 / B₀) * L := by ring
      _ ≤ M₁ * L + (8 / B₀) * L := by linarith
      _ = M₀ * L := by dsimp [M₀]; ring
  let B : ℝ := B₀ / 8
  let C : ℝ := 4 * A₀ + 3 * M₀
  have hB_pos : 0 < B := by dsimp [B]; positivity
  have hB_le : B ≤ 1 / 2 := by dsimp [B]; linarith
  have hC_pos : 0 < C := by dsimp [C]; positivity
  refine ⟨B, C, D_K, hB_pos, hB_le, hC_pos, hDK_eq, ?_⟩
  intro s hs
  set t : ℝ := s.im
  set L : ℝ := Real.log (4 + |t|)
  have hL_ge_one : 1 ≤ L := h_log_ge_one t
  have hL_pos : 0 < L := h_log_pos t
  have hs_B₀ : 1 - B₀ / L ≤ s.re := by
    have hB_le_B₀ : B ≤ B₀ := by dsimp [B]; linarith
    have h_div : B / L ≤ B₀ / L := div_le_div_of_nonneg_right hB_le_B₀ (le_of_lt hL_pos)
    linarith
  have hDK_diff_s : DifferentiableAt ℂ D_K s := hDK_diff_of_ne s (hg_dlvp s hs_B₀).1
  refine ⟨hDK_diff_s, ?_⟩
  rcases le_or_gt (σ₀ t) s.re with hs_rhp | hs_collar
  · have h1 := h_rhp_bound s hs_rhp
    have hM₀_le_C : M₀ ≤ C := by dsimp [C]; linarith
    calc ‖D_K s‖
        ≤ M₀ * L := h1
      _ ≤ C * L := mul_le_mul_of_nonneg_right hM₀_le_C (le_of_lt hL_pos)
  · let s₀ : ℂ := (σ₀ t : ℂ) + (t : ℂ) * Complex.I
    let R : ℝ := (3 * B₀) / (4 * L)
    have hR_pos : 0 < R := by dsimp [R]; positivity
    have hR_le_half : R ≤ 1 / 2 := by
      dsimp [R]
      have h1 : 3 * B₀ ≤ 2 * L := by linarith
      rw [div_le_iff₀ (by positivity)]
      linarith
    have hs₀_re : s₀.re = σ₀ t := by simp [s₀]
    have hs₀_im : s₀.im = t := by simp [s₀]
    have h_ball_dlvp : ∀ w ∈ Metric.closedBall s₀ R,
        DifferentiableAt ℂ D_K w ∧ (D_K w).re ≤ (2 * A₀) * L := by
      intro w hw
      have hw_norm : ‖w - s₀‖ ≤ R := by simpa [Metric.mem_closedBall, dist_eq_norm] using hw
      have hw_im_diff : |w.im - t| ≤ R := by
        have h1 : |w.im - s₀.im| ≤ ‖w - s₀‖ := by
          rw [← Complex.sub_im]
          exact Complex.abs_im_le_norm (w - s₀)
        rw [hs₀_im] at h1
        exact le_trans h1 hw_norm
      have hw_im_le : |w.im| ≤ |t| + 1 / 2 := by
        have h1 : |w.im| - |t| ≤ |w.im - t| := abs_sub_abs_le_abs_sub w.im t
        linarith
      have h_sq_ge : 4 + |w.im| ≤ (4 + |t|) ^ 2 := by
        have ht_nn : 0 ≤ |t| := abs_nonneg t
        nlinarith
      have h_log_w_le : Real.log (4 + |w.im|) ≤ 2 * L := by
        have h1 : Real.log (4 + |w.im|) ≤ Real.log ((4 + |t|) ^ 2) :=
          Real.log_le_log (by positivity) h_sq_ge
        rw [Real.log_pow] at h1
        push_cast at h1
        dsimp [L]; linarith
      have h_log_w_pos : 0 < Real.log (4 + |w.im|) := h_log_pos w.im
      have hw_re_ge : 1 - B₀ / (2 * L) ≤ w.re := by
        have h1 : s₀.re - w.re ≤ ‖w - s₀‖ := by
          have h2 : -(w - s₀).re ≤ ‖w - s₀‖ :=
            le_trans (neg_le_abs _) (Complex.abs_re_le_norm (w - s₀))
          simpa using h2
        rw [hs₀_re] at h1
        dsimp [σ₀, R] at h1 hw_norm
        have h_eq : 1 + B₀ / (4 * L) - (3 * B₀) / (4 * L) = 1 - B₀ / (2 * L) := by ring
        linarith
      have hw_dlvp_cond : 1 - B₀ / Real.log (4 + |w.im|) ≤ w.re := by
        have h_div : B₀ / (2 * L) ≤ B₀ / Real.log (4 + |w.im|) :=
          div_le_div_of_nonneg_left (le_of_lt hB₀_pos) h_log_w_pos h_log_w_le
        linarith
      obtain ⟨hw_ne, hw_re_bound⟩ := hg_dlvp w hw_dlvp_cond
      refine ⟨hDK_diff_of_ne w hw_ne, ?_⟩
      dsimp [D_K]
      calc (-deriv g_K w / g_K w).re
          ≤ A₀ * Real.log (4 + |w.im|) := hw_re_bound
        _ ≤ A₀ * (2 * L) := mul_le_mul_of_nonneg_left h_log_w_le (le_of_lt hA₀_pos)
        _ = (2 * A₀) * L := by ring
    have hs_in_half : s ∈ Metric.closedBall s₀ (R / 2) := by
      rw [Metric.mem_closedBall, dist_eq_norm]
      have h_diff_eq : s - s₀ = ((s.re - σ₀ t : ℝ) : ℂ) := by
        apply Complex.ext
        · simp [s₀]
        · simp [s₀, t]
      rw [h_diff_eq, Complex.norm_real, Real.norm_eq_abs, abs_of_neg (by linarith)]
      dsimp [σ₀, R, B] at hs ⊢
      have h_alg : -(s.re - (1 + B₀ / (4 * L))) = 1 - s.re + B₀ / (4 * L) := by ring
      have h_R2 : (3 * B₀) / (4 * L) / 2 = B₀ / 8 / L + B₀ / (4 * L) := by ring
      linarith
    have h_bc_s := h_bc D_K s₀ R ((2 * A₀) * L) hR_pos (by positivity)
      (fun w hw => (h_ball_dlvp w hw).1) (fun w hw => (h_ball_dlvp w hw).2) s hs_in_half
    have hs₀_rhp : σ₀ s₀.im ≤ s₀.re := by
      rw [hs₀_re, hs₀_im]
    have hDK_s₀_le : ‖D_K s₀‖ ≤ M₀ * L := by
      have h1 := h_rhp_bound s₀ hs₀_rhp
      rwa [hs₀_im] at h1
    calc ‖D_K s‖
        ≤ 2 * ((2 * A₀) * L) + 3 * ‖D_K s₀‖ := h_bc_s
      _ ≤ 2 * ((2 * A₀) * L) + 3 * (M₀ * L) := by linarith
      _ = C * L := by dsimp [C]; ring

theorem mitsui_primePowers_sub_vonMangoldt_analytic_continuation_bound {K : Type u} [Field K] [NumberField K] :
    ∃ (B C : ℝ) (D : ℂ → ℂ), 0 < B ∧ B ≤ 1 / 2 ∧ 0 < C ∧
      (∀ s : ℂ, 1 < s.re →
        D s = LSeries (fun n =>
          (((∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
              Real.log (Ideal.absNorm pm.1.1.asIdeal))
            - ArithmeticFunction.vonMangoldt n : ℝ) : ℂ)) s) ∧
      (∀ s : ℂ, 1 - B / Real.log (4 + |s.im|) ≤ s.re →
        DifferentiableAt ℂ D s ∧
        ‖D s‖ ≤ C * Real.log (4 + |s.im|)) :=
by
  have h_s1 : ∀ s : ℂ, 1 < s.re →
      LSeries (fun n =>
        (((∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
            Real.log (Ideal.absNorm pm.1.1.asIdeal))
          - ArithmeticFunction.vonMangoldt n : ℝ) : ℂ)) s =
        LSeries (fun n =>
          ((∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
              Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℝ) : ℂ)) s -
        (-deriv riemannZeta s / riemannZeta s) := by
    intro s hs
    classical
    let Λ_K : ℕ → ℝ := fun n =>
      ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
        Real.log (Ideal.absNorm pm.1.1.asIdeal)
    have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        2 ≤ Ideal.absNorm p.asIdeal := by
      intro p
      have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
      have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
      omega
    have hΛ_nonneg : ∀ n : ℕ, 0 ≤ Λ_K n := by
      intro n
      dsimp [Λ_K]
      refine tsum_nonneg (fun pm => Real.log_nonneg ?_)
      have h2 := h_norm_ge_two pm.1.1
      exact_mod_cast (by omega : 1 ≤ Ideal.absNorm pm.1.1.asIdeal)
    have h_ideal_card : ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ x : ℝ, 1 ≤ x →
        (Nat.card {J : Ideal (NumberField.RingOfIntegers K) // (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤
          C₁ * x := by
      set L_K : ℝ :=
        2 ^ NumberField.InfinitePlace.nrRealPlaces K *
          (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
          NumberField.Units.regulator K *
          (NumberField.classNumber K : ℝ) /
          ((NumberField.Units.torsionOrder K : ℝ) * Real.sqrt |(NumberField.discr K : ℝ)|)
      have h_tendsto : Filter.Tendsto
          (fun x : ℝ => (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
            (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x)
          Filter.atTop (nhds L_K) :=
        NumberField.Ideal.tendsto_norm_le_div_atTop K
      obtain ⟨S₀, hS₀⟩ := (Metric.tendsto_atTop.mp h_tendsto) 1 zero_lt_one
      let S₁ : ℝ := max S₀ 1
      let N₁ : ℕ := Nat.card {J : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm J ≤ ⌊S₁⌋₊}
      let C₁ : ℝ := max (|L_K| + 1) ((N₁ : ℝ) + 1)
      have hC₁_pos : 0 < C₁ := by
        have h1 : 0 ≤ |L_K| := abs_nonneg L_K
        have h2 : |L_K| + 1 ≤ C₁ := le_max_left _ _
        linarith
      refine ⟨C₁, hC₁_pos, ?_⟩
      intro x hx
      have hx_pos : 0 < x := lt_of_lt_of_le zero_lt_one hx
      by_cases hS : S₁ ≤ x
      · have hS₀_le : S₀ ≤ x := le_trans (le_max_left S₀ 1) hS
        have h_dist := hS₀ x hS₀_le
        rw [Real.dist_eq] at h_dist
        have h_sub : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
            (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x - L_K < 1 :=
          (abs_sub_lt_iff.mp h_dist).1
        have h_abs : L_K ≤ |L_K| := le_abs_self L_K
        have h_max : |L_K| + 1 ≤ C₁ := le_max_left _ _
        have h_div_le : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
            (Ideal.absNorm J : ℝ) ≤ x} : ℝ) / x ≤ C₁ := by linarith
        exact (div_le_iff₀ hx_pos).mp h_div_le
      · have hx_le : x ≤ S₁ := le_of_not_ge hS
        have h_sub : {J : Ideal (NumberField.RingOfIntegers K) | (Ideal.absNorm J : ℝ) ≤ x} ⊆
            {J : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm J ≤ ⌊S₁⌋₊} := by
          intro J hJ
          exact Nat.le_floor (le_trans hJ hx_le)
        have h_fin : {J : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm J ≤ ⌊S₁⌋₊}.Finite :=
          Ideal.finite_setOf_absNorm_le ⌊S₁⌋₊
        have h_card_le : Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
            (Ideal.absNorm J : ℝ) ≤ x} ≤ N₁ :=
          Nat.card_mono h_fin h_sub
        have h_card_real : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
            (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ (N₁ : ℝ) := by exact_mod_cast h_card_le
        have h_max : (N₁ : ℝ) + 1 ≤ C₁ := le_max_right _ _
        have h_le_C₁ : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
            (Ideal.absNorm J : ℝ) ≤ x} : ℝ) ≤ C₁ := by linarith
        nlinarith
    obtain ⟨C₁, hC₁_pos, hC₁⟩ := h_ideal_card
    let r : ℝ := (1 + s.re) / 2
    let δ : ℝ := (s.re - 1) / 4
    have hδ_pos : 0 < δ := by dsimp [δ]; linarith
    have hr_nonneg : 0 ≤ r := by dsimp [r]; linarith
    have hr_lt : r < s.re := by dsimp [r]; linarith
    have hlog2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num : (1 : ℝ) < 2)
    have h_log_le_rpow : ∀ x : ℝ, 0 < x → Real.log x ≤ (1 / δ) * x ^ δ := by
      intro x hx
      have h1 : Real.log (x ^ δ) ≤ x ^ δ - 1 :=
        Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos hx δ)
      rw [Real.log_rpow hx] at h1
      have h2 : δ * Real.log x ≤ x ^ δ := by linarith
      rw [← le_div_iff₀' hδ_pos] at h2
      linarith [show x ^ δ / δ = (1 / δ) * x ^ δ by ring]
    have h_sum_bound : ∀ N : ℕ, 1 ≤ N →
        (∑ k ∈ Finset.Icc 1 N, Λ_K k) ≤
          (C₁ * ((1 / δ) / Real.log 2 + 1) * (1 / δ)) * (N : ℝ) ^ r := by
      intro N hN
      have hN_real : (1 : ℝ) ≤ (N : ℝ) := by exact_mod_cast hN
      have hN_pos : (0 : ℝ) < (N : ℝ) := lt_of_lt_of_le zero_lt_one hN_real
      let D_N := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 ≤ N}
      let F (k : ℕ) := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = k}
      let M : ℕ := ⌊Real.log (N : ℝ) / Real.log 2⌋₊
      let S_J := {J : Ideal (NumberField.RingOfIntegers K) // (Ideal.absNorm J : ℝ) ≤ (N : ℝ)}
      have hSJ_fin : {J : Ideal (NumberField.RingOfIntegers K) | (Ideal.absNorm J : ℝ) ≤ (N : ℝ)}.Finite := by
        apply Set.Finite.subset (Ideal.finite_setOf_absNorm_le N)
        intro J hJ
        exact_mod_cast hJ
      haveI : Finite S_J := hSJ_fin
      have h_pm_bounds : ∀ pm : D_N,
          (Ideal.absNorm pm.1.1.asIdeal : ℝ) ≤ (N : ℝ) ∧
          pm.1.2 < M + 1 ∧
          Real.log (Ideal.absNorm pm.1.1.asIdeal) ≤ Real.log (N : ℝ) ∧
          1 ≤ Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2 := by
        intro pm
        set k : ℕ := Ideal.absNorm pm.1.1.asIdeal
        set m : ℕ := pm.1.2
        have hm : 1 ≤ m := pm.2.1
        have h_pow : k ^ m ≤ N := pm.2.2
        have hk2 : 2 ≤ k := h_norm_ge_two pm.1.1
        have hm_ne : m ≠ 0 := by omega
        have hk_le_km : k ≤ k ^ m := Nat.le_self_pow hm_ne k
        have hk_le_N : k ≤ N := le_trans hk_le_km h_pow
        have hk_real : (k : ℝ) ≤ (N : ℝ) := by exact_mod_cast hk_le_N
        have h2m_le_km : 2 ^ m ≤ k ^ m := Nat.pow_le_pow_left hk2 m
        have h2m_real : (2 : ℝ) ^ m ≤ (N : ℝ) := by exact_mod_cast (le_trans h2m_le_km h_pow)
        have h_log_2m : Real.log ((2 : ℝ) ^ m) ≤ Real.log (N : ℝ) :=
          Real.log_le_log (by positivity) h2m_real
        rw [Real.log_pow] at h_log_2m
        have hm_le_div : (m : ℝ) ≤ Real.log (N : ℝ) / Real.log 2 :=
          (le_div_iff₀ hlog2_pos).mpr h_log_2m
        have hm_lt : m < M + 1 := Nat.lt_add_one_of_le (Nat.le_floor hm_le_div)
        have hk_pos : (0 : ℝ) < (k : ℝ) := by exact_mod_cast (by omega : 0 < k)
        have h_log_k : Real.log (k : ℝ) ≤ Real.log (N : ℝ) := Real.log_le_log hk_pos hk_real
        have h1_le_km : 1 ≤ k ^ m := le_trans (by omega : 1 ≤ k) hk_le_km
        exact ⟨hk_real, hm_lt, h_log_k, h1_le_km⟩
      let ψ : D_N → S_J × Fin (M + 1) := fun pm =>
        (⟨pm.1.1.asIdeal, (h_pm_bounds pm).1⟩, ⟨pm.1.2, (h_pm_bounds pm).2.1⟩)
      have hψ_inj : Function.Injective ψ := by
        intro a b hab
        have h1 : a.1.1.asIdeal = b.1.1.asIdeal := congrArg Subtype.val (Prod.ext_iff.mp hab).1
        have h2 : a.1.2 = b.1.2 := congrArg Fin.val (Prod.ext_iff.mp hab).2
        exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext h1) h2)
      haveI : Finite D_N := Finite.of_injective ψ hψ_inj
      letI : Fintype D_N := Fintype.ofFinite D_N
      let g : D_N → ℕ := fun pm => Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2
      let term : D_N → ℝ := fun pm => Real.log (Ideal.absNorm pm.1.1.asIdeal)
      have hg : ∀ pm ∈ (Finset.univ : Finset D_N), g pm ∈ Finset.Icc 1 N := by
        intro pm _
        rw [Finset.mem_Icc]
        exact ⟨(h_pm_bounds pm).2.2.2, pm.2.2⟩
      have h_sum_eq : (∑ k ∈ Finset.Icc 1 N, Λ_K k) = ∑ pm : D_N, term pm := by
        rw [← Finset.sum_fiberwise_of_maps_to hg term]
        refine Finset.sum_congr rfl (fun k hk => ?_)
        have hk_le_N : k ≤ N := (Finset.mem_Icc.mp hk).2
        let e_k : F k ≃ {pm : D_N // g pm = k} :=
          { toFun := fun pm => ⟨⟨pm.1, ⟨pm.2.1, by rw [pm.2.2]; exact hk_le_N⟩⟩, pm.2.2⟩
            invFun := fun q => ⟨q.1.1, ⟨q.1.2.1, q.2⟩⟩
            left_inv := fun pm => by apply Subtype.ext; rfl
            right_inv := fun q => by apply Subtype.ext; apply Subtype.ext; rfl }
        have h_sub : (∑ pm ∈ Finset.univ with g pm = k, term pm) =
            ∑' q : {pm : D_N // g pm = k}, term q.1 := by
          rw [tsum_fintype]
          exact Finset.sum_subtype (Finset.univ.filter (fun pm : D_N => g pm = k))
            (fun _ => by simp) term
        rw [h_sub]
        exact Equiv.tsum_eq e_k (fun q : {pm : D_N // g pm = k} => term q.1)
      have hcard_le : Nat.card D_N ≤ Nat.card S_J * (M + 1) := by
        calc Nat.card D_N
            ≤ Nat.card (S_J × Fin (M + 1)) := Nat.card_le_card_of_injective ψ hψ_inj
          _ = Nat.card S_J * Nat.card (Fin (M + 1)) := Nat.card_prod S_J (Fin (M + 1))
          _ = Nat.card S_J * (M + 1) := by rw [Nat.card_fin]
      have hcard_real : (Nat.card D_N : ℝ) ≤ (Nat.card S_J : ℝ) * ((M + 1 : ℕ) : ℝ) := by
        exact_mod_cast hcard_le
      have hlogN_nonneg : 0 ≤ Real.log (N : ℝ) := Real.log_nonneg hN_real
      have h_M_le : ((M + 1 : ℕ) : ℝ) ≤ ((1 / δ) / Real.log 2 + 1) * (N : ℝ) ^ δ := by
        have hM_floor : (M : ℝ) ≤ Real.log (N : ℝ) / Real.log 2 :=
          Nat.floor_le (div_nonneg hlogN_nonneg (le_of_lt hlog2_pos))
        have hlogδ := h_log_le_rpow (N : ℝ) hN_pos
        have h_div : Real.log (N : ℝ) / Real.log 2 ≤ ((1 / δ) / Real.log 2) * (N : ℝ) ^ δ := by
          calc Real.log (N : ℝ) / Real.log 2
              ≤ ((1 / δ) * (N : ℝ) ^ δ) / Real.log 2 :=
                div_le_div_of_nonneg_right hlogδ (le_of_lt hlog2_pos)
            _ = ((1 / δ) / Real.log 2) * (N : ℝ) ^ δ := by ring
        have h1_le : (1 : ℝ) ≤ (N : ℝ) ^ δ := Real.one_le_rpow hN_real (le_of_lt hδ_pos)
        push_cast
        linarith
      have hlogN_le : Real.log (N : ℝ) ≤ (1 / δ) * (N : ℝ) ^ δ := h_log_le_rpow (N : ℝ) hN_pos
      have hSJ_le : (Nat.card S_J : ℝ) ≤ C₁ * (N : ℝ) := hC₁ (N : ℝ) hN_real
      have h_rpow_combine : (N : ℝ) * (N : ℝ) ^ δ * (N : ℝ) ^ δ = (N : ℝ) ^ r := by
        have h1 : (N : ℝ) ^ δ * (N : ℝ) ^ δ = (N : ℝ) ^ (2 * δ) := by
          rw [← Real.rpow_add hN_pos]
          congr 1; ring
        have h2 : (N : ℝ) * (N : ℝ) ^ (2 * δ) = (N : ℝ) ^ (1 : ℝ) * (N : ℝ) ^ (2 * δ) := by
          rw [Real.rpow_one]
        rw [mul_assoc, h1, h2, ← Real.rpow_add hN_pos]
        congr 1
        dsimp [r, δ]; ring
      calc (∑ k ∈ Finset.Icc 1 N, Λ_K k)
          = ∑ pm : D_N, term pm := h_sum_eq
        _ ≤ ∑ _pm : D_N, Real.log (N : ℝ) :=
            Finset.sum_le_sum (fun pm _ => (h_pm_bounds pm).2.2.1)
        _ = (Nat.card D_N : ℝ) * Real.log (N : ℝ) := by
            rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, ← Nat.card_eq_fintype_card]
        _ ≤ ((Nat.card S_J : ℝ) * ((M + 1 : ℕ) : ℝ)) * Real.log (N : ℝ) :=
            mul_le_mul_of_nonneg_right hcard_real hlogN_nonneg
        _ ≤ ((C₁ * (N : ℝ)) * (((1 / δ) / Real.log 2 + 1) * (N : ℝ) ^ δ)) *
              ((1 / δ) * (N : ℝ) ^ δ) := by
            refine mul_le_mul (mul_le_mul hSJ_le h_M_le (by positivity) (by positivity))
              hlogN_le hlogN_nonneg (by positivity)
        _ = (C₁ * ((1 / δ) / Real.log 2 + 1) * (1 / δ)) *
              ((N : ℝ) * (N : ℝ) ^ δ * (N : ℝ) ^ δ) := by ring
        _ = (C₁ * ((1 / δ) / Real.log 2 + 1) * (1 / δ)) * (N : ℝ) ^ r := by rw [h_rpow_combine]
    have h_bigO : (fun N : ℕ => ∑ k ∈ Finset.Icc 1 N, Λ_K k) =O[Filter.atTop]
        (fun N : ℕ => (N : ℝ) ^ r) := by
      refine Asymptotics.IsBigO.of_bound (C₁ * ((1 / δ) / Real.log 2 + 1) * (1 / δ)) ?_
      rw [Filter.eventually_atTop]
      refine ⟨1, fun N hN => ?_⟩
      have h_sum_nonneg : 0 ≤ ∑ k ∈ Finset.Icc 1 N, Λ_K k :=
        Finset.sum_nonneg (fun k _ => hΛ_nonneg k)
      have hN_nonneg : 0 ≤ (N : ℝ) ^ r := by positivity
      rw [Real.norm_of_nonneg h_sum_nonneg, Real.norm_of_nonneg hN_nonneg]
      exact h_sum_bound N hN
    have hΛ_sum : LSeriesSummable (fun n => (Λ_K n : ℂ)) s :=
      LSeriesSummable_of_sum_norm_bigO_and_nonneg h_bigO hΛ_nonneg hr_nonneg hr_lt
    have h_vm_sum : LSeriesSummable (fun n => (ArithmeticFunction.vonMangoldt n : ℂ)) s :=
      ArithmeticFunction.LSeriesSummable_vonMangoldt hs
    have h_fun_eq : (fun n => ((Λ_K n - ArithmeticFunction.vonMangoldt n : ℝ) : ℂ)) =
        (fun n => (Λ_K n : ℂ)) - (fun n => (ArithmeticFunction.vonMangoldt n : ℂ)) := by
      ext n
      exact Complex.ofReal_sub (Λ_K n) (ArithmeticFunction.vonMangoldt n)
    rw [h_fun_eq, LSeries_sub hΛ_sum h_vm_sum,
      ArithmeticFunction.LSeries_vonMangoldt_eq_deriv_riemannZeta_div hs]
  obtain ⟨B₁, C₁, hB₁_pos, hB₁_le, hC₁_pos, h_dlvp₁⟩ :=
    mitsui_riemannZeta_zeroFree_and_logDeriv_bound
  obtain ⟨D_Q, hDQ_eq, hDQ_dlvp⟩ :=
    mitsui_riemannZeta_logDeriv_sub_pole_extension B₁ C₁ hB₁_pos hB₁_le hC₁_pos h_dlvp₁
  obtain ⟨B₂, C₂, D_K, hB₂_pos, hB₂_le, hC₂_pos, hDK_eq, hDK_dlvp⟩ :=
    mitsui_primePowers_sub_pole_analytic_continuation_bound (K := K)
  let B : ℝ := min B₁ B₂
  let C : ℝ := C₂ + C₁
  let D : ℂ → ℂ := fun s => D_K s - D_Q s
  have hB_pos : 0 < B := lt_min hB₁_pos hB₂_pos
  have hB_le : B ≤ 1 / 2 := le_trans (min_le_left B₁ B₂) hB₁_le
  have hC_pos : 0 < C := add_pos hC₂_pos hC₁_pos
  refine ⟨B, C, D, hB_pos, hB_le, hC_pos, ?_, ?_⟩
  · intro s hs
    have hs_ne : s ≠ 1 := by
      intro h
      rw [h] at hs
      norm_num at hs
    dsimp [D]
    rw [hDK_eq s hs, hDQ_eq s hs_ne, h_s1 s hs]
    ring
  · intro s hs
    have h_abs : 0 ≤ |s.im| := abs_nonneg s.im
    have h_log_pos : 0 < Real.log (4 + |s.im|) :=
      Real.log_pos (by linarith)
    have h_log_nonneg : 0 ≤ Real.log (4 + |s.im|) := le_of_lt h_log_pos
    have hB_le_B₁ : B ≤ B₁ := min_le_left B₁ B₂
    have hB_le_B₂ : B ≤ B₂ := min_le_right B₁ B₂
    have h_div₁ : B / Real.log (4 + |s.im|) ≤ B₁ / Real.log (4 + |s.im|) :=
      div_le_div_of_nonneg_right hB_le_B₁ h_log_nonneg
    have h_div₂ : B / Real.log (4 + |s.im|) ≤ B₂ / Real.log (4 + |s.im|) :=
      div_le_div_of_nonneg_right hB_le_B₂ h_log_nonneg
    have hs₁ : 1 - B₁ / Real.log (4 + |s.im|) ≤ s.re := by linarith
    have hs₂ : 1 - B₂ / Real.log (4 + |s.im|) ≤ s.re := by linarith
    have h1 := hDQ_dlvp s hs₁
    have h2 := hDK_dlvp s hs₂
    refine ⟨h2.1.sub h1.1, ?_⟩
    dsimp [D, C]
    have h_norm : ‖D_K s - D_Q s‖ ≤ ‖D_K s‖ + ‖D_Q s‖ := norm_sub_le (D_K s) (D_Q s)
    linarith [h1.2, h2.2]

theorem mitsui_riesz_primePowers_sub_vonMangoldt_nat_bound {K : Type u} [Field K] [NumberField K] :
    ∃ c₂ : ℝ, 0 < c₂ ∧
      ∀ Y : ℝ, 1 < Y →
        |∑ n ∈ Finset.Icc 1 ⌊Y⌋₊,
            ((∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                  1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
                Real.log (Ideal.absNorm pm.1.1.asIdeal))
              - ArithmeticFunction.vonMangoldt n) *
              Real.log (Y / (n : ℝ))|
          ≤ c₂ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₂) :=
by
  obtain ⟨B, C, D, hB_pos, hB_le, hC_pos, hD_LSeries, hD_dlvp⟩ :=
    mitsui_primePowers_sub_vonMangoldt_analytic_continuation_bound (K := K)
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_deLaValleePoussin_integral_bound B hB_pos
  let c₂ : ℝ := C * c₁ + c₁
  have hc₂_pos : 0 < c₂ := by dsimp [c₂]; positivity
  refine ⟨c₂, hc₂_pos, ?_⟩
  intro Y hY
  have hY_pos : 0 < Y := by linarith
  rw [mitsui_riesz_primePowers_sub_vonMangoldt_eq_vertical_integral Y hY]
  have h_int_eq :
      (∫ t : ℝ,
        ((Y : ℂ) ^ (2 + (t : ℂ) * Complex.I) / (2 + (t : ℂ) * Complex.I) ^ 2) *
          LSeries (fun n =>
            (((∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                  1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
                Real.log (Ideal.absNorm pm.1.1.asIdeal))
              - ArithmeticFunction.vonMangoldt n : ℝ) : ℂ))
            (2 + (t : ℂ) * Complex.I)) =
      ∫ t : ℝ,
        ((Y : ℂ) ^ (2 + (t : ℂ) * Complex.I) / (2 + (t : ℂ) * Complex.I) ^ 2) *
          D (2 + (t : ℂ) * Complex.I) := by
    congr 1
    ext t
    have h_re : 1 < (2 + (t : ℂ) * Complex.I).re := by simp
    rw [hD_LSeries (2 + (t : ℂ) * Complex.I) h_re]
  rw [h_int_eq]
  have h_contour :=
    mitsui_riesz_poleFree_vertical_integral_le_boundary_integral B C D hB_pos hB_le hC_pos hD_dlvp Y hY
  have h_bound1 :
      C * (∫ t : ℝ, Y ^ (1 - B / Real.log (4 + |t|)) * (Real.log (4 + |t|) / (1 / 4 + t ^ 2))) ≤
        (C * c₁) * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁) := by
    calc C * (∫ t : ℝ, Y ^ (1 - B / Real.log (4 + |t|)) * (Real.log (4 + |t|) / (1 / 4 + t ^ 2)))
      _ ≤ C * (c₁ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁)) :=
          mul_le_mul_of_nonneg_left (hc₁ Y hY) (le_of_lt hC_pos)
      _ = (C * c₁) * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁) := by ring
  have hc₁_le_c₂ : c₁ ≤ c₂ := by
    have : 0 ≤ C * c₁ := by positivity
    dsimp [c₂]; linarith
  have hCc₁_le_c₂ : C * c₁ ≤ c₂ := by
    dsimp [c₂]; linarith
  have hexp_le :
      Real.exp (-Real.sqrt (Real.log Y) / c₁) ≤ Real.exp (-Real.sqrt (Real.log Y) / c₂) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left (Real.sqrt_nonneg _) hc₁_pos hc₁_le_c₂
  have h_bound2 :
      (C * c₁) * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁) ≤
        c₂ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₂) := by
    calc (C * c₁) * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁)
      _ ≤ (C * c₁) * Y * Real.exp (-Real.sqrt (Real.log Y) / c₂) :=
          mul_le_mul_of_nonneg_left hexp_le (by positivity)
      _ ≤ c₂ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₂) := by
          apply mul_le_mul_of_nonneg_right
          · exact mul_le_mul_of_nonneg_right hCc₁_le_c₂ (le_of_lt hY_pos)
          · positivity
  linarith

theorem mitsui_riesz_primePowers_asymptotic {K : Type u} [Field K] [NumberField K] :
    ∃ c₁ : ℝ, 0 < c₁ ∧
      ∀ Y : ℝ, 0 < Y →
        |(∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
            Real.log (Ideal.absNorm pm.1.1.asIdeal) *
              Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)))
          - Y|
          ≤ c₁ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁) :=
by
  obtain ⟨c₀, hc₀_pos, hc₀⟩ := mitsui_riesz_vonMangoldt_nat_asymptotic
  obtain ⟨c₂, hc₂_pos, hc₂⟩ := mitsui_riesz_primePowers_sub_vonMangoldt_nat_bound (K := K)
  let c₁ : ℝ := c₀ + c₂
  have hc₁_pos : 0 < c₁ := by dsimp [c₁]; linarith
  refine ⟨c₁, hc₁_pos, ?_⟩
  intro Y hY
  rw [mitsui_riesz_primePowers_eq_sum_Icc Y hY]
  set Λ_K : ℕ → ℝ := fun n =>
    ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
      Real.log (Ideal.absNorm pm.1.1.asIdeal)
  set S_K : ℝ := ∑ n ∈ Finset.Icc 1 ⌊Y⌋₊, Λ_K n * Real.log (Y / (n : ℝ))
  set S_Q : ℝ := ∑ n ∈ Finset.Icc 1 ⌊Y⌋₊, ArithmeticFunction.vonMangoldt n * Real.log (Y / (n : ℝ))
  set D : ℝ := ∑ n ∈ Finset.Icc 1 ⌊Y⌋₊, (Λ_K n - ArithmeticFunction.vonMangoldt n) * Real.log (Y / (n : ℝ))
  have hD_eq : D = S_K - S_Q := by
    dsimp [D, S_K, S_Q]
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun n _ => ?_)
    ring
  have h_ident : S_K - Y = D + (S_Q - Y) := by
    rw [hD_eq]
    ring
  have h_tri : |S_K - Y| ≤ |D| + |S_Q - Y| := by
    rw [h_ident]
    exact abs_add_le D (S_Q - Y)
  have hD_bound : |D| ≤ c₂ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₂) := by
    rcases le_or_gt Y 1 with hY_le | hY_gt
    · have hD_zero : D = 0 := by
        dsimp [D]
        apply Finset.sum_eq_zero
        intro n hn
        rw [Finset.mem_Icc] at hn
        have hn1 : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn.1
        have hnY : (n : ℝ) ≤ Y := by
          have h_le : (n : ℝ) ≤ (⌊Y⌋₊ : ℝ) := by exact_mod_cast hn.2
          exact le_trans h_le (Nat.floor_le (le_of_lt hY))
        have hYn : Y / (n : ℝ) = 1 := by
          have hY1 : Y = 1 := by linarith
          have hn1' : (n : ℝ) = 1 := by linarith
          rw [hY1, hn1', div_one]
        rw [hYn, Real.log_one, mul_zero]
      rw [hD_zero, abs_zero]
      positivity
    · exact hc₂ Y hY_gt
  have hQ_bound : |S_Q - Y| ≤ c₀ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₀) := hc₀ Y hY
  have hsqrt_nonneg : 0 ≤ Real.sqrt (Real.log Y) := Real.sqrt_nonneg _
  have hexp0 : Real.exp (-Real.sqrt (Real.log Y) / c₀) ≤ Real.exp (-Real.sqrt (Real.log Y) / c₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₀_pos (by dsimp [c₁]; linarith)
  have hexp2 : Real.exp (-Real.sqrt (Real.log Y) / c₂) ≤ Real.exp (-Real.sqrt (Real.log Y) / c₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₂_pos (by dsimp [c₁]; linarith)
  have hterm0 : c₀ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₀) ≤
      c₀ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁) :=
    mul_le_mul_of_nonneg_left hexp0 (by positivity)
  have hterm2 : c₂ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₂) ≤
      c₂ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁) :=
    mul_le_mul_of_nonneg_left hexp2 (by positivity)
  have hsum : c₂ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁) +
      c₀ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁) =
      c₁ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁) := by
    dsimp [c₁]
    ring
  linarith

theorem mitsui_riesz_primePower_char_decoupled_norm_dir_log_cell_le_uncond {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (m : ℕ)
    (R₁ : ℝ)
    (k : NumberField.mixedEmbedding.index K → Fin (2 * m))
    (w₀ : NumberField.InfinitePlace K)
    (l : ℕ) (hl : 1 ≤ l)
    (p : NumberField.InfinitePlace K → Fin l)
    (Z : ℝ) (hZ : 0 < Z)
    (B : ℝ) (hB₀ : 0 ≤ B)
    (hB : ∀ (p_id : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (ν : ℕ),
      1 ≤ ν →
      (Nat.card {x : NumberField.RingOfIntegers K //
          Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = p_id.asIdeal ^ ν ∧
          ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
            Real.log (w (x : K) / w₀ (x : K)) ∈
              Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
                (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))} : ℝ) ≤ B)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ) :
    ‖∑' xpm : {xpm : NumberField.RingOfIntegers K ×
            IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          1 ≤ xpm.2.2 ∧
          Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
          (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Z ∧
          (∀ i : NumberField.mixedEmbedding.index K,
            R₁ *
              ((NumberField.mixedEmbedding.stdBasis K).repr
