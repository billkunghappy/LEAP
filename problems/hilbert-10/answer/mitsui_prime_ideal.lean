      rw [← map_pow, hI_pow_eq]
    have h_span_eq_pow : Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) =
        (I : Ideal (NumberField.RingOfIntegers K)) ^ h_K := by
      rw [← hx_span', SubmonoidClass.coe_pow]
    have h_unit_iff_I : IsUnit (Ideal.Quotient.mk q x) ↔
        (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ := by
      rw [h_unit_iff x, h_span_eq_pow, ← Ideal.isCoprime_iff_sup_eq,
        IsCoprime.pow_left_iff hh_K_pos, Ideal.isCoprime_iff_sup_eq]
