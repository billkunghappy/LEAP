theorem mitsui_primitive_grossenchar_classGroup_cube_lattice_posNeg_theta_inversion_of_units_eq_one {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (l_eff : NumberField.InfinitePlace K → ℤ)
    (hl_eff_real : ∀ w : NumberField.InfinitePlace K, w.IsReal → (l_eff w = 0 ∨ l_eff w = 1))
    (v_place : NumberField.InfinitePlace K → ℝ)
    (hv_sum : (∑ w : NumberField.InfinitePlace K, v_place w) = 0)
    (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ₀_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖χ₀ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → χ₀ I = 0))
    (J_rep : ClassGroup (NumberField.RingOfIntegers K) → nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))
    (hJ_cls : ∀ C : ClassGroup (NumberField.RingOfIntegers K), ClassGroup.mk0 (J_rep C) = C⁻¹)
    (hJ_cop : ∀ C : ClassGroup (NumberField.RingOfIntegers K), (J_rep C : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤)
    (ψ_f : (NumberField.RingOfIntegers K ⧸ f) → ℂ)
    (hψ_one : ψ_f 1 = 1)
    (hψ_mul : ∀ a b : NumberField.RingOfIntegers K ⧸ f, ψ_f (a * b) = ψ_f a * ψ_f b)
    (hψ_unit : ∀ a : NumberField.RingOfIntegers K ⧸ f, (IsUnit a → ‖ψ_f a‖ = 1) ∧ (¬ IsUnit a → ψ_f a = 0))
    (hψ_span : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
        Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I) =
      ψ_f (Ideal.Quotient.mk f x) *
        ∏ w : NumberField.InfinitePlace K,
          (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_eff w))
    (hψ_prim : ∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
      ∃ x : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk f x) ∧ x - 1 ∈ f' ∧ ψ_f (Ideal.Quotient.mk f x) ≠ 1)
    (hψ_zero : (f ≠ ⊤ ∧ ψ_f 0 = 0 ∧
        ∀ (h_fin : Fintype (NumberField.RingOfIntegers K ⧸ f)),
          @Finset.sum (NumberField.RingOfIntegers K ⧸ f) ℂ _ (@Finset.univ (NumberField.RingOfIntegers K ⧸ f) h_fin) ψ_f = 0) ∨
      (f = ⊤ ∧ (∀ a : NumberField.RingOfIntegers K ⧸ f, ψ_f a = 1) ∧
        ((∃ w : NumberField.InfinitePlace K, l_eff w ≠ 0) ∨
          ((∀ w : NumberField.InfinitePlace K, l_eff w = 0) ∧
            ∃ i : Fin (NumberField.Units.rank K),
              ∃ k : ℤ, k ≠ 0 ∧
                (∑ w : NumberField.InfinitePlace K,
                  v_place w * Real.log (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K))) =
                  2 * Real.pi * (k : ℝ))))) :
    let R := NumberField.RingOfIntegers K
    let n : ℕ := Module.finrank ℚ K
    let r : ℕ := NumberField.Units.rank K
    let a_place : NumberField.InfinitePlace K → ℕ := fun w => (l_eff w).natAbs
    let S_f : ℝ := |(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) * (Ideal.absNorm f : ℝ) ^ (-1 / 2 : ℝ)
    let Cube : Set (Fin r → ℝ) := Set.pi Set.univ (fun _ => Set.Ico (0 : ℝ) 1)
    ∃ ω_χ : ℂ, ‖ω_χ‖ = 1 ∧
      ∀ u ∈ Set.Ioi (0 : ℝ),
        (∑ C : ClassGroup R,
          star (χ₀ (J_rep C)) *
            (∫ y in Cube,
              (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
                χ₀ ⟨Ideal.span ({x.1} : Set R),
                  mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr x.2.1)⟩ *
                  Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x.1 : K))) : ℝ) * Complex.I) *
                  ((((S_f * u⁻¹ / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
                      (∑ w : NumberField.InfinitePlace K, a_place w) *
                    (∏ w : NumberField.InfinitePlace K,
                      (w (x.1 : K) * ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (y i)) ^ (a_place w)) *
                    Real.exp (-Real.pi * (S_f * u⁻¹ / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                      ∑ w : NumberField.InfinitePlace K,
                        (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                          ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) : ℝ) : ℂ) *
                  Complex.exp
                    (((∑ w : NumberField.InfinitePlace K,
                        v_place w *
                          ∑ i : Fin r,
                            y i * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) : ℝ) *
                      Complex.I)))) =
        (u : ℂ) * ω_χ *
          (∑ C : ClassGroup R,
            χ₀ (J_rep C) *
              (∫ y in Cube,
                (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
                  ((starRingEnd ℂ).toMonoidHom.comp χ₀) ⟨Ideal.span ({x.1} : Set R),
                    mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr x.2.1)⟩ *
                    Complex.exp (((∑ w : NumberField.InfinitePlace K, (-v_place) w * Real.log (w (x.1 : K))) : ℝ) * Complex.I) *
                    ((((S_f * u / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
                        (∑ w : NumberField.InfinitePlace K, a_place w) *
                      (∏ w : NumberField.InfinitePlace K,
                        (w (x.1 : K) * ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i)) ^ (a_place w)) *
                      Real.exp (-Real.pi * (S_f * u / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                        ∑ w : NumberField.InfinitePlace K,
                          (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                            ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ) *
                    Complex.exp
                      (((-∑ w : NumberField.InfinitePlace K,
                          (-v_place) w *
                            ∑ i : Fin r,
                              y i * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) : ℝ) *
                        Complex.I)))) :=
by
  classical
  intro R n r a_place S_f Cube
  let D : ℝ := |(NumberField.discr K : ℝ)|
  let N_f : ℝ := (Ideal.absNorm f : ℝ)
  haveI : Finite (R ⧸ f) := Ideal.finiteQuotientOfFreeOfNeBot f hf
  letI : Fintype (R ⧸ f) := Fintype.ofFinite (R ⧸ f)
  obtain ⟨σ, γ_C, α_C, Φ_C, ω_χ, hω_norm, hγ_C, hα_Φ, h_gauss⟩ :=
    mitsui_primitive_grossenchar_dual_class_and_gauss_sum
      f hf l_eff v_place χ₀ hχ₀_norm_supp J_rep hJ_cls hJ_cop ψ_f hψ_one hψ_mul hψ_unit hψ_span hψ_prim
  have hψ_units : ∀ u_unit : Rˣ,
      ψ_f (Ideal.Quotient.mk f (u_unit : R)) *
        (∏ w : NumberField.InfinitePlace K,
          (w.embedding ((u_unit : R) : K) /
            (w ((u_unit : R) : K) : ℂ)) ^ (l_eff w)) =
        Complex.exp (((∑ w : NumberField.InfinitePlace K,
          v_place w * Real.log (w ((u_unit : R) : K))) : ℝ) * Complex.I) := by
    intro u_unit
    have hu_ne : (u_unit : R) ≠ 0 := Units.ne_zero u_unit
    rw [← hψ_span (u_unit : R) hu_ne]
    have h_span : Ideal.span ({(u_unit : R)} : Set R) = ⊤ :=
      Ideal.span_singleton_eq_top.mpr u_unit.isUnit
    have h_one : (⟨Ideal.span ({(u_unit : R)} : Set R),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hu_ne)⟩ :
          nonZeroDivisors (Ideal R)) = 1 :=
      Subtype.ext (h_span.trans Ideal.one_eq_top.symm)
    rw [h_one, map_one, one_mul]
  have h_unit_prod : ∀ (u_unit : Rˣ) (t : ℝ),
      (∏ w : NumberField.InfinitePlace K,
        (w ((u_unit : R) : K)) ^ ((w.mult : ℝ) * t)) = 1 := by
    intro u_unit t
    have h_pos : ∀ w : NumberField.InfinitePlace K, 0 < w ((u_unit : R) : K) := by
      intro w
      exact w.pos_iff.mpr (NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero u_unit))
    have h_step : ∀ w : NumberField.InfinitePlace K,
        (w ((u_unit : R) : K)) ^ ((w.mult : ℝ) * t) =
        ((w ((u_unit : R) : K)) ^ w.mult) ^ t := by
      intro w
      rw [← Real.rpow_natCast, ← Real.rpow_mul (le_of_lt (h_pos w))]
    have h_congr : (∏ w : NumberField.InfinitePlace K, (w ((u_unit : R) : K)) ^ ((w.mult : ℝ) * t)) =
        ∏ w : NumberField.InfinitePlace K, ((w ((u_unit : R) : K)) ^ w.mult) ^ t :=
      Finset.prod_congr rfl (fun w _ => h_step w)
    rw [h_congr, Real.finset_prod_rpow _ _ (fun w _ => pow_nonneg (le_of_lt (h_pos w)) _)]
    have h_prod : (∏ w : NumberField.InfinitePlace K, (w ((u_unit : R) : K)) ^ w.mult) = 1 := by
      rw [NumberField.InfinitePlace.prod_eq_abs_norm]
      have h_norm := NumberField.Units.norm K u_unit
      exact_mod_cast h_norm
    rw [h_prod, Real.one_rpow]
  have h_norm_Φ_emb : ∀ (w : NumberField.InfinitePlace K) (z : K),
      ‖if 0 ≤ l_eff w then w.embedding z else star (w.embedding z)‖ = w z := by
    intro w z
    split_ifs
    · exact NumberField.InfinitePlace.norm_embedding_eq w z
