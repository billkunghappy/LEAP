by
  classical
  let ψ₀ : ι_b → ((Fin r → ℤ) × (ι_complex → ℤ)) → ℂ :=
    fun b q => Complex.exp (((∑ j : Fin r, (q.1 j : ℝ) * h * Ω b j) : ℝ) * Complex.I)
  let w_b : ι_b → ((Fin r → ℤ) × (ι_complex → ℤ)) → ℂ :=
    fun b q => (∑ ξ : ι_ξ, if q ∈ S_main_slice ξ then c_ind ξ b else 0) * ψ₀ b q
  let w_main : β_real → ((Fin r → ℤ) × (ι_complex → ℤ)) → ℂ :=
    fun l_real q => ∑ b : ι_b, if l_emb b = l_real then w_b b q else 0
  have hw_b_norm : ∀ b q, ‖w_b b q‖ ≤ 1 := by
    intro b q
    dsimp [w_b, ψ₀]
    rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]
    calc ‖∑ ξ : ι_ξ, if q ∈ S_main_slice ξ then c_ind ξ b else 0‖
      _ ≤ ∑ ξ : ι_ξ, ‖if q ∈ S_main_slice ξ then c_ind ξ b else 0‖ := norm_sum_le _ _
      _ ≤ ∑ ξ : ι_ξ, ‖c_ind ξ b‖ := by
        refine Finset.sum_le_sum (fun ξ _ => ?_)
        split_ifs
        · exact le_rfl
        · rw [norm_zero]; exact norm_nonneg _
      _ ≤ 1 := hc_ind_sum b
  have hw_main_norm : ∀ l_real q, ‖w_main l_real q‖ ≤ 1 := by
    intro l_real q
    dsimp [w_main]
    by_cases hex : ∃ b₀ : ι_b, l_emb b₀ = l_real
    · rcases hex with ⟨b₀, hb₀⟩
      have h_single : (∑ b : ι_b, if l_emb b = l_real then w_b b q else 0) = w_b b₀ q := by
        rw [Finset.sum_eq_single b₀]
        · rw [if_pos hb₀]
        · intro b _ hb_ne
          rw [if_neg]
          intro h_eq
          exact hb_ne (hl_emb_inj (h_eq.trans hb₀.symm))
        · intro hb₀_mem
          exact False.elim (hb₀_mem (Finset.mem_univ b₀))
      rw [h_single]
      exact hw_b_norm b₀ q
    · push_neg at hex
      have h_zero : (∑ b : ι_b, if l_emb b = l_real then w_b b q else 0) = 0 := by
        refine Finset.sum_eq_zero (fun b _ => ?_)
        rw [if_neg (hex b)]
      rw [h_zero, norm_zero]
      exact zero_le_one
  have hw_main_reind : ∀ (χ : β_real → ℂ)
      (Hat_q : ((Fin r → ℤ) × (ι_complex → ℤ)) → ℝ),
      (∑ l_real ∈ B_real,
        χ l_real *
          ∑ q ∈ S_main,
            w_main l_real q * (Hat_q q : ℂ)) =
      ∑ ξ : ι_ξ,
        ∑ q ∈ S_main_slice ξ,
