    refine ⟨Finset.prod_congr rfl (fun w _ => ?_), Finset.prod_congr rfl (fun w _ => ?_)⟩
    · rw [Complex.ofReal_pow, Complex.ofReal_mul, mul_pow, ← mul_assoc, (h_single w z hz).1, mul_pow]
    · rw [Complex.ofReal_pow, Complex.ofReal_mul, mul_pow, ← mul_assoc, (h_single w z hz).2, mul_pow]
  have h_s1 : ∀ y : Fin r → ℝ,
      (∑' x : {x : R // x ≠ 0 ∧ x ∈ J},
