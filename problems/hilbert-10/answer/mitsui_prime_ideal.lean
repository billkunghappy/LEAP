    rw [hF'0, hG'0] at h_deriv_eq
    have h2pi_ne : (2 * Real.pi : ℂ) ≠ 0 := by
      exact mul_ne_zero two_ne_zero (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero)
    exact mul_left_cancel₀ h2pi_ne h_deriv_eq
  have h_ind : ∀ (m : ℕ) (d₁ : Fin n → ℕ), (∀ j : Fin n, d₁ j ≤ 1) →
      (∑ j : Fin n, d₁ j) = m → ∀ u₀ : Fin n → ℝ,
      (∑' k : Fin n → ℤ,
        (((∏ j : Fin n, (A.mulVec (fun i => u₀ i + (k i : ℝ)) j) ^ (d₁ j) : ℝ) : ℂ) *
        (Real.exp (-Real.pi *
          ∑ j : Fin n, (A.mulVec (fun i => u₀ i + (k i : ℝ)) j) ^ 2) : ℂ))) =
        ((-Complex.I) ^ (∑ j : Fin n, d₁ j) *
          ((|A.det|⁻¹ : ℝ) : ℂ)) *
          ∑' l : Fin n → ℤ,
            Complex.exp (2 * Real.pi * Complex.I *
              (∑ i : Fin n, u₀ i * (l i : ℝ) : ℂ)) *
              (((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d₁ j) : ℝ) : ℂ) *
              (Real.exp (-Real.pi *
                ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ)) := by
    intro m
    induction' m with m ih
    · intro d₁ _hd₁ hm u₀
      have hd₀_all : ∀ j : Fin n, d₁ j = 0 := by
        intro j
        exact Finset.sum_eq_zero_iff.mp hm j (Finset.mem_univ j)
      have h_lhs0 :
          (∑' k : Fin n → ℤ,
            (((∏ j : Fin n, (A.mulVec (fun i => u₀ i + (k i : ℝ)) j) ^ (d₁ j) : ℝ) : ℂ) *
            (Real.exp (-Real.pi *
              ∑ j : Fin n, (A.mulVec (fun i => u₀ i + (k i : ℝ)) j) ^ 2) : ℂ))) =
          ∑' k : Fin n → ℤ,
            (Real.exp (-Real.pi *
              ∑ j : Fin n, (A.mulVec (fun i => u₀ i + (k i : ℝ)) j) ^ 2) : ℂ) := by
        refine tsum_congr (fun k => ?_)
        have hp : (∏ j : Fin n, (A.mulVec (fun i => u₀ i + (k i : ℝ)) j) ^ (d₁ j)) = 1 := by
          refine Finset.prod_eq_one (fun j _ => ?_)
          rw [hd₀_all j, pow_zero]
        rw [hp, Complex.ofReal_one, one_mul]
      have h_rhs0 :
          (∑' l : Fin n → ℤ,
            Complex.exp (2 * Real.pi * Complex.I *
              (∑ i : Fin n, u₀ i * (l i : ℝ) : ℂ)) *
              (((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d₁ j) : ℝ) : ℂ) *
              (Real.exp (-Real.pi *
                ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ))) =
          ∑' l : Fin n → ℤ,
            Complex.exp (2 * Real.pi * Complex.I *
              (∑ i : Fin n, u₀ i * (l i : ℝ) : ℂ)) *
              (Real.exp (-Real.pi *
                ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ) := by
        refine tsum_congr (fun l => ?_)
        have hp : (∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d₁ j)) = 1 := by
          refine Finset.prod_eq_one (fun j _ => ?_)
          rw [hd₀_all j, pow_zero]
        rw [hp, Complex.ofReal_one, one_mul]
      rw [h_lhs0, h_rhs0, hm, pow_zero, one_mul]
      exact h_base u₀
    · intro d₁ hd₁ hm u₀
      have h_ne : (∑ j ∈ Finset.univ, d₁ j) ≠ 0 := by omega
      obtain ⟨j₀, _, hj₀_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero h_ne
      have hj₀_le : d₁ j₀ ≤ 1 := hd₁ j₀
      have hj₀_eq : d₁ j₀ = 1 := by omega
      let d₀ : Fin n → ℕ := Function.update d₁ j₀ 0
      have hd₀_le : ∀ j : Fin n, d₀ j ≤ 1 := by
        intro j
        by_cases hj : j = j₀
        · subst hj; simp [d₀]
        · dsimp [d₀]; rw [Function.update_of_ne hj]; exact hd₁ j
      have hd₀_zero : d₀ j₀ = 0 := Function.update_self j₀ 0 d₁
      have h_upd : Function.update d₀ j₀ 1 = d₁ := by
        ext j
        by_cases hj : j = j₀
