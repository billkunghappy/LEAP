      rw [hδ_sq, Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      have h_step1 : t / c ≤ Real.sqrt (Real.log Y) / c :=
        div_le_div_of_nonneg_right ht_le_sqrtY (le_of_lt hc_pos)
      have h_step2 : Real.sqrt (Real.log Y) / c ≤ Real.sqrt (Real.log Y) / c₁ :=
        div_le_div_of_nonneg_left (Real.sqrt_nonneg _) hc₁_pos hc₁_le
      linarith
    calc |Ψ₁_K Y - Y|
      _ ≤ c₁ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁) := h1
      _ ≤ c₁ * Y * δ ^ 2 := mul_le_mul_of_nonneg_left hexp (by positivity)
      _ ≤ c * Y₀ * δ ^ 2 := by
          have h_cY : c₁ * Y ≤ c * Y₀ :=
            mul_le_mul hc₁_le hY_le_Y₀ (le_of_lt hY_pos) (le_of_lt hc_pos)
          calc c₁ * Y * δ ^ 2 = (c₁ * Y) * δ ^ 2 := rfl
            _ ≤ (c * Y₀) * δ ^ 2 := mul_le_mul_of_nonneg_right h_cY (by positivity)
  have hlog_Z_plus_ge : Real.log Y ≤ Real.log (Real.exp δ * Y) := by
    rw [Real.log_mul (ne_of_gt (Real.exp_pos δ)) (ne_of_gt hY_pos), Real.log_exp]
    linarith
  have ht_le_sqrt_Z_plus : t ≤ Real.sqrt (Real.log (Real.exp δ * Y)) :=
    le_trans ht_le_sqrtY (Real.sqrt_le_sqrt hlog_Z_plus_ge)
  have hΨ₁_K_Z_plus : |Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y| ≤ (c * Real.exp 1) * Y₀ * δ ^ 2 := by
    have h1 : |Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y| ≤
        c₁ * (Real.exp δ * Y) * Real.exp (-Real.sqrt (Real.log (Real.exp δ * Y)) / c₁) :=
      hc₁ (Real.exp δ * Y) hZ_plus_pos
    have hexp_le : Real.exp (-Real.sqrt (Real.log (Real.exp δ * Y)) / c₁) ≤ δ ^ 2 := by
      rw [hδ_sq, Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      have h_step1 : t / c ≤ Real.sqrt (Real.log (Real.exp δ * Y)) / c :=
        div_le_div_of_nonneg_right ht_le_sqrt_Z_plus (le_of_lt hc_pos)
      have h_step2 : Real.sqrt (Real.log (Real.exp δ * Y)) / c ≤
          Real.sqrt (Real.log (Real.exp δ * Y)) / c₁ :=
        div_le_div_of_nonneg_left (Real.sqrt_nonneg _) hc₁_pos hc₁_le
      linarith
    have hc1_exp_le : c₁ * (Real.exp δ * Y) ≤ (c * Real.exp 1) * Y₀ := by
      calc c₁ * (Real.exp δ * Y) ≤ c * (Real.exp 1 * Y₀) :=
            mul_le_mul hc₁_le hZ_plus_le_eY₀ (le_of_lt hZ_plus_pos) (le_of_lt hc_pos)
        _ = (c * Real.exp 1) * Y₀ := by ring
    calc |Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y|
      _ ≤ c₁ * (Real.exp δ * Y) * Real.exp (-Real.sqrt (Real.log (Real.exp δ * Y)) / c₁) := h1
      _ ≤ c₁ * (Real.exp δ * Y) * δ ^ 2 := mul_le_mul_of_nonneg_left hexp_le (by positivity)
      _ ≤ ((c * Real.exp 1) * Y₀) * δ ^ 2 := mul_le_mul_of_nonneg_right hc1_exp_le (by positivity)
  have hZ_minus_pos : 0 < Real.exp (-δ) * Y := mul_pos (Real.exp_pos (-δ)) hY_pos
  have hΨ₁_K_Z_minus : |Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y| ≤
      (c * Real.exp (1 / c)) * Y₀ * δ ^ 2 := by
    have h1 : |Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y| ≤
        c₁ * (Real.exp (-δ) * Y) * Real.exp (-Real.sqrt (Real.log (Real.exp (-δ) * Y)) / c₁) :=
      hc₁ (Real.exp (-δ) * Y) hZ_minus_pos
    have hlog_eq : Real.log (Real.exp (-δ) * Y) = Real.log Y - δ := by
      rw [Real.log_mul (ne_of_gt (Real.exp_pos (-δ))) (ne_of_gt hY_pos), Real.log_exp]
      ring
    set u : ℝ := Real.log (Real.exp (-δ) * Y)
    have hu_le_sq : u ≤ Real.sqrt u ^ 2 := by
      rcases le_or_gt 0 u with hu | hu
      · rw [Real.sq_sqrt hu]
      · have : 0 ≤ Real.sqrt u ^ 2 := sq_nonneg _
        linarith
    have hsqrt_u_nonneg : 0 ≤ Real.sqrt u := Real.sqrt_nonneg u
    have hlogX_le_sq : Real.log X ≤ (Real.sqrt u + 1) ^ 2 := by
      have h_u_δ : Real.log Y = u + δ := by dsimp [u]; linarith [hlog_eq]
      calc Real.log X ≤ Real.log Y := hlogX_le_logY
        _ = u + δ := h_u_δ
        _ ≤ Real.sqrt u ^ 2 + 1 := by linarith
        _ ≤ Real.sqrt u ^ 2 + 2 * Real.sqrt u + 1 := by linarith
        _ = (Real.sqrt u + 1) ^ 2 := by ring
    have ht_le : t ≤ Real.sqrt u + 1 := by
      have h2 := Real.sqrt_le_sqrt hlogX_le_sq
      rwa [Real.sqrt_sq (by linarith)] at h2
    have hexp_c1_le_c : Real.exp (-Real.sqrt u / c₁) ≤ Real.exp (-Real.sqrt u / c) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left hsqrt_u_nonneg hc₁_pos hc₁_le
    have hexp_le : Real.exp (-Real.sqrt u / c) ≤ Real.exp (1 / c) * δ ^ 2 := by
      rw [hδ_sq, ← Real.exp_add, Real.exp_le_exp]
      have h_num : -Real.sqrt u ≤ 1 - t := by linarith
      have h_div : -Real.sqrt u / c ≤ (1 - t) / c :=
        div_le_div_of_nonneg_right h_num (le_of_lt hc_pos)
      have h_eq : (1 - t) / c = 1 / c + -t / c := by ring
      linarith
    have hexp_c1_le : Real.exp (-Real.sqrt u / c₁) ≤ Real.exp (1 / c) * δ ^ 2 :=
      le_trans hexp_c1_le_c hexp_le
    have hexp_negδ_le : Real.exp (-δ) ≤ 1 := by
      rw [Real.exp_le_one_iff]
      linarith
    have hc1_exp_le : c₁ * (Real.exp (-δ) * Y) ≤ c * Y₀ := by
      have h_expY : Real.exp (-δ) * Y ≤ Y₀ := by
        calc Real.exp (-δ) * Y ≤ 1 * Y := mul_le_mul_of_nonneg_right hexp_negδ_le (le_of_lt hY_pos)
          _ = Y := one_mul Y
          _ ≤ Y₀ := hY_le_Y₀
      exact mul_le_mul hc₁_le h_expY (le_of_lt hZ_minus_pos) (le_of_lt hc_pos)
    calc |Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y|
      _ ≤ c₁ * (Real.exp (-δ) * Y) * Real.exp (-Real.sqrt u / c₁) := h1
      _ ≤ c₁ * (Real.exp (-δ) * Y) * (Real.exp (1 / c) * δ ^ 2) :=
          mul_le_mul_of_nonneg_left hexp_c1_le (by positivity)
      _ = (c₁ * (Real.exp (-δ) * Y)) * (Real.exp (1 / c) * δ ^ 2) := by ring
      _ ≤ (c * Y₀) * (Real.exp (1 / c) * δ ^ 2) :=
          mul_le_mul_of_nonneg_right hc1_exp_le (by positivity)
      _ = (c * Real.exp (1 / c)) * Y₀ * δ ^ 2 := by ring
  have hexp_pos_taylor : Real.exp δ - 1 - δ ≤ δ ^ 2 := by
    have habs : |δ| ≤ 1 := by rw [abs_of_pos hδ_pos]; exact hδ_le_one
    have h1 := Real.abs_exp_sub_one_sub_id_le habs
    exact le_trans (le_abs_self _) h1
  have hexp_neg_taylor : Real.exp (-δ) - 1 + δ ≤ δ ^ 2 := by
    have habs : |-δ| ≤ 1 := by rw [abs_neg, abs_of_pos hδ_pos]; exact hδ_le_one
    have h1 := Real.abs_exp_sub_one_sub_id_le habs
    have h2 : Real.exp (-δ) - 1 - (-δ) ≤ (-δ) ^ 2 := le_trans (le_abs_self _) h1
    linarith
  have h_taylor_pos_Y : (Real.exp δ - 1 - δ) * Y ≤ Y₀ * δ ^ 2 := by
    calc (Real.exp δ - 1 - δ) * Y ≤ δ ^ 2 * Y :=
          mul_le_mul_of_nonneg_right hexp_pos_taylor (le_of_lt hY_pos)
      _ ≤ δ ^ 2 * Y₀ := mul_le_mul_of_nonneg_left hY_le_Y₀ (by positivity)
      _ = Y₀ * δ ^ 2 := by ring
  have h_taylor_neg_Y : (Real.exp (-δ) - 1 + δ) * Y ≤ Y₀ * δ ^ 2 := by
    calc (Real.exp (-δ) - 1 + δ) * Y ≤ δ ^ 2 * Y :=
          mul_le_mul_of_nonneg_right hexp_neg_taylor (le_of_lt hY_pos)
      _ ≤ δ ^ 2 * Y₀ := mul_le_mul_of_nonneg_left hY_le_Y₀ (by positivity)
      _ = Y₀ * δ ^ 2 := by ring
  have h_fwd : ‖(Ψ₁_free (Real.exp δ * Y) - Ψ₁_free Y) - (δ : ℂ) * ψ_free Y‖ ≤
      B * ((Ψ₁_K (Real.exp δ * Y) - Ψ₁_K Y) - δ * ψ_K Y) :=
    mitsui_principalPrimePower_char_freeUnit_cell_riesz_forward_diff_le
      X m w₀ k Y δ hY_pos hδ_pos B hB₀ hB q hq ψ
  have h_bwd : Ψ₁_K Y - Ψ₁_K (Real.exp (-δ) * Y) ≤ δ * ψ_K Y :=
    mitsui_primePowers_ge_riesz_backward_diff Y δ hY_pos hδ_pos
  have hΨ₁_K_Y_lower : -(c * Y₀ * δ ^ 2) ≤ Ψ₁_K Y - Y := (abs_le.mp hΨ₁_K_Y).1
  have hΨ₁_K_Z_plus_upper : Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y ≤ (c * Real.exp 1) * Y₀ * δ ^ 2 :=
    (abs_le.mp hΨ₁_K_Z_plus).2
  have hΨ₁_K_Z_minus_upper : Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y ≤
      (c * Real.exp (1 / c)) * Y₀ * δ ^ 2 :=
    (abs_le.mp hΨ₁_K_Z_minus).2
  have h_second_diff : (Ψ₁_K (Real.exp δ * Y) - Ψ₁_K Y) - δ * ψ_K Y ≤ C_diff * Y₀ * δ ^ 2 := by
    have h_ident : (Ψ₁_K (Real.exp δ * Y) - Ψ₁_K Y) - (Ψ₁_K Y - Ψ₁_K (Real.exp (-δ) * Y)) =
        (Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y) - 2 * (Ψ₁_K Y - Y) +
        (Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y) +
        (Real.exp δ - 1 - δ) * Y + (Real.exp (-δ) - 1 + δ) * Y := by ring
    dsimp [C_diff]
    linarith
  have h_rem_le : ‖(Ψ₁_free (Real.exp δ * Y) - Ψ₁_free Y) - (δ : ℂ) * ψ_free Y‖ ≤
      B * C_diff * Y₀ * δ ^ 2 := by
    calc ‖(Ψ₁_free (Real.exp δ * Y) - Ψ₁_free Y) - (δ : ℂ) * ψ_free Y‖
      _ ≤ B * ((Ψ₁_K (Real.exp δ * Y) - Ψ₁_K Y) - δ * ψ_K Y) := h_fwd
      _ ≤ B * (C_diff * Y₀ * δ ^ 2) := mul_le_mul_of_nonneg_left h_second_diff hB₀
      _ = B * C_diff * Y₀ * δ ^ 2 := by ring
  have h_norm_δ_ψ : δ * ‖ψ_free Y‖ ≤
      ‖Ψ₁_free (Real.exp δ * Y)‖ + ‖Ψ₁_free Y‖ +
      ‖(Ψ₁_free (Real.exp δ * Y) - Ψ₁_free Y) - (δ : ℂ) * ψ_free Y‖ := by
    have h_eq : (δ : ℂ) * ψ_free Y =
        (Ψ₁_free (Real.exp δ * Y) - Ψ₁_free Y) -
        ((Ψ₁_free (Real.exp δ * Y) - Ψ₁_free Y) - (δ : ℂ) * ψ_free Y) := by ring
    have h_norm_eq : δ * ‖ψ_free Y‖ =
        ‖(Ψ₁_free (Real.exp δ * Y) - Ψ₁_free Y) -
          ((Ψ₁_free (Real.exp δ * Y) - Ψ₁_free Y) - (δ : ℂ) * ψ_free Y)‖ := by
      rw [← h_eq, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hδ_pos]
    have ht1 := norm_sub_le (Ψ₁_free (Real.exp δ * Y) - Ψ₁_free Y)
      ((Ψ₁_free (Real.exp δ * Y) - Ψ₁_free Y) - (δ : ℂ) * ψ_free Y)
    have ht2 := norm_sub_le (Ψ₁_free (Real.exp δ * Y)) (Ψ₁_free Y)
    linarith
  have h_δ_ψ_le : δ * ‖ψ_free Y‖ ≤ (2 * c + B * C_diff) * Y₀ * δ ^ 2 := by
    linarith
  have h_ψ_le_δ : ‖ψ_free Y‖ ≤ 2 * c * Y₀ * δ + B * C_diff * Y₀ * δ := by
    apply le_of_mul_le_mul_left _ hδ_pos
    calc δ * ‖ψ_free Y‖ ≤ (2 * c + B * C_diff) * Y₀ * δ ^ 2 := h_δ_ψ_le
      _ = δ * (2 * c * Y₀ * δ + B * C_diff * Y₀ * δ) := by ring
  have hu_exp : c' * t / 4 + 1 ≤ Real.exp (c' * t / 4) := Real.add_one_le_exp (c' * t / 4)
  have hu_sq : (c' * t / 4) ^ 2 ≤ Real.exp (c' * t / 2) := by
    have h1 : c' * t / 4 ≤ c' * t / 4 + 1 := by linarith
    have h2 : c' * t / 4 ≤ Real.exp (c' * t / 4) := le_trans h1 hu_exp
    calc (c' * t / 4) ^ 2
      _ = (c' * t / 4) * (c' * t / 4) := sq _
      _ ≤ Real.exp (c' * t / 4) * Real.exp (c' * t / 4) :=
        mul_le_mul h2 h2 (by positivity) (by positivity)
      _ = Real.exp (c' * t / 2) := by
        rw [← Real.exp_add]
        ring_nf
  have hlog_le_exp : Real.log X ≤ (16 / c' ^ 2) * Real.exp (c' * t / 2) := by
    have h1 : (c' ^ 2 / 16) * Real.log X = (c' * t / 4) ^ 2 := by
      rw [← ht_sq]
      ring
    rw [div_mul_eq_mul_div, le_div_iff₀ (by positivity)]
    linarith
  have hexp_half_ge_one : 1 ≤ Real.exp (c' * t / 2) := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by positivity)
  have hlog1_le_K₀_half : Real.log X + 1 ≤ K₀ * Real.exp (c' * t / 2) := by
    dsimp [K₀]
    linarith
  have hexp_half_le : Real.exp (c' * t / 2) ≤ Real.exp (c' * t) := by
    rw [Real.exp_le_exp]
    have : 0 ≤ c' * t := by positivity
    linarith
  have hlog1_le_K₀ : Real.log X + 1 ≤ K₀ * Real.exp (c' * t) :=
    le_trans hlog1_le_K₀_half (mul_le_mul_of_nonneg_left hexp_half_le (le_of_lt hK₀_pos))
  have hexp_r_eq : (r : ℝ) * (c' * t) = t / (4 * c) := by
    dsimp [c']
    have hr_ne : (r : ℝ) ≠ 0 := ne_of_gt hr_rpos
    have hc_ne : c ≠ 0 := ne_of_gt hc_pos
    field_simp [hr_ne, hc_ne]
  have hlog1_pow_le : (Real.log X + 1) ^ r ≤ K₀ ^ r * Real.exp (t / (4 * c)) := by
    calc (Real.log X + 1) ^ r
      _ ≤ (K₀ * Real.exp (c' * t)) ^ r :=
        pow_le_pow_left₀ (by positivity) hlog1_le_K₀ r
      _ = K₀ ^ r * (Real.exp (c' * t)) ^ r := mul_pow _ _ _
      _ = K₀ ^ r * Real.exp ((r : ℝ) * (c' * t)) := by rw [← Real.exp_nat_mul]
      _ = K₀ ^ r * Real.exp (t / (4 * c)) := by rw [hexp_r_eq]
  have hB_le : B ≤ c_gen * (K₀ ^ r * Real.exp (t / (4 * c))) :=
    mul_le_mul_of_nonneg_left hlog1_pow_le (le_of_lt hc_gen_pos)
  have hexp_combine : Real.exp (t / (4 * c)) * δ = Real.exp (-t / (4 * c)) := by
    dsimp [δ]
    rw [← Real.exp_add]
    congr 1
    have hc_ne : c ≠ 0 := ne_of_gt hc_pos
    field_simp [hc_ne]
    ring
  have h_BC_bound : B * C_diff * Y₀ * δ ≤ A_diff * Y₀ * Real.exp (-t / (4 * c)) := by
    calc B * C_diff * Y₀ * δ
      _ ≤ (c_gen * (K₀ ^ r * Real.exp (t / (4 * c)))) * C_diff * Y₀ * δ := by
        have : 0 ≤ C_diff * Y₀ * δ := by positivity
        calc B * C_diff * Y₀ * δ = B * (C_diff * Y₀ * δ) := by ring
          _ ≤ (c_gen * (K₀ ^ r * Real.exp (t / (4 * c)))) * (C_diff * Y₀ * δ) :=
            mul_le_mul_of_nonneg_right hB_le this
          _ = (c_gen * (K₀ ^ r * Real.exp (t / (4 * c)))) * C_diff * Y₀ * δ := by ring
      _ = A_diff * Y₀ * (Real.exp (t / (4 * c)) * δ) := by
        dsimp [A_diff]; ring
      _ = A_diff * Y₀ * Real.exp (-t / (4 * c)) := by rw [hexp_combine]
  have h4c_pos : 0 < 4 * c := by positivity
  have h2c_pos : 0 < 2 * c := by positivity
  have h4c_le : 4 * c ≤ c_pp := by dsimp [c_pp]; linarith [mul_pos hW_pos (by positivity : 0 < 2 * c + A_diff)]
  have h2c_le_4c : 2 * c ≤ 4 * c := by linarith
  have hδ_le_4c : δ ≤ Real.exp (-t / (4 * c)) := by
    dsimp [δ]
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg h2c_pos h2c_le_4c
  have h_2c_bound : 2 * c * Y₀ * δ ≤ 2 * c * Y₀ * Real.exp (-t / (4 * c)) :=
    mul_le_mul_of_nonneg_left hδ_le_4c (by positivity)
  have h_ψ_free_bound : ‖ψ_free Y‖ ≤ (2 * c + A_diff) * Y₀ * Real.exp (-t / (4 * c)) := by
    linarith
  have hexp_4c_le : Real.exp (-t / (4 * c)) ≤ Real.exp (-t / c_pp) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg h4c_pos h4c_le
  have h_target_bound : ‖S_target‖ ≤ c_pp * Y₀ * Real.exp (-t / c_pp) := by
    rw [hS_target_norm]
    have h_coeff : W * (2 * c + A_diff) ≤ c_pp := by dsimp [c_pp]; linarith
    calc W * ‖ψ_free Y‖
      _ ≤ W * ((2 * c + A_diff) * Y₀ * Real.exp (-t / (4 * c))) :=
        mul_le_mul_of_nonneg_left h_ψ_free_bound (le_of_lt hW_pos)
      _ ≤ W * ((2 * c + A_diff) * Y₀ * Real.exp (-t / c_pp)) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp_4c_le (by positivity)) (le_of_lt hW_pos)
      _ = (W * (2 * c + A_diff)) * (Y₀ * Real.exp (-t / c_pp)) := by ring
      _ ≤ c_pp * (Y₀ * Real.exp (-t / c_pp)) :=
        mul_le_mul_of_nonneg_right h_coeff (by positivity)
      _ = c_pp * Y₀ * Real.exp (-t / c_pp) := by ring
  exact h_target_bound

theorem mitsui_principalPrimeIdeals_char_decoupled_log_cell_bound_of_rank_pos {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A)
    (h_rank : 0 < NumberField.Units.rank K) :
    ∃ c_cell : ℝ, 0 < c_cell ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m →
          ∀ w₀ : NumberField.InfinitePlace K,
            ∀ k : NumberField.InfinitePlace K → Fin m,
              ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
                (Ideal.absNorm q : ℝ) < Real.log X ^ A →
                ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
                  (∀ u : (NumberField.RingOfIntegers K)ˣ,
                    ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) →
                  ‖∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
                        ∃ h : p.asIdeal.IsPrincipal,
                        (Ideal.absNorm p.asIdeal : ℝ) ≤
                          X ^ (Module.finrank ℚ K) *
                            Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
                              (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))) ∧
                        IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ p.asIdeal h))},
                      (Nat.card {π : NumberField.RingOfIntegers K //
                          Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧
                          ∀ w : NumberField.InfinitePlace K,
                            Real.log (w (π : K) / w₀ (π : K)) ∈
                              Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                                (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℂ) *
                        (ψ (Additive.ofMul p.2.choose_spec.2.unit) *
                          (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ))‖
                    ≤ c_cell * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cell) :=
by
  obtain ⟨c_gen, hc_gen_pos, hc_gen⟩ := mitsui_decoupled_log_cell_generator_card_bound (K := K)
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_higher_primePower_chebyshev_bound (K := K)
  obtain ⟨c_pp, hc_pp_pos, hc_pp⟩ :=
    mitsui_principalPrimePower_char_decoupled_log_cell_bound_of_rank_pos (K := K) A hA h_rank
  set r : ℕ := NumberField.Units.rank K
  have hr_pos : 0 < r := h_rank
  have hr_rpos : (0 : ℝ) < (r : ℝ) := Nat.cast_pos.mpr hr_pos
  set c' : ℝ := 1 / (2 * (r : ℝ) * c₁)
  have hc'_pos : 0 < c' := by dsimp [c']; positivity
  set K₀ : ℝ := 16 / c' ^ 2 + 1
  have hK₀_pos : 0 < K₀ := by dsimp [K₀]; positivity
  set A_hpp : ℝ := c_gen * K₀ ^ r * c₁
  have hA_hpp_pos : 0 < A_hpp := by dsimp [A_hpp]; positivity
  let c_cell : ℝ := A_hpp + 2 * c₁ + c_pp
