        simp [F]
      rw [hF0]
      exact MeasureTheory.integrableOn_zero
    · have hm_pos : 0 < (m : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hm)
      have h1 : MeasureTheory.IntegrableOn (fun u : ℝ => G ((m : ℝ) * u))
