  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_riesz_primePowers_asymptotic (K := K)
  obtain ⟨Φ_W, hΦ_W_mul, hΦ_W_pow, hΦ_W_prin⟩ :=
    mitsui_exists_ideal_unitLogCoord_extending_principal (K := K)
  obtain ⟨c₀, hc₀_pos, hc₀⟩ :=
    mitsui_riesz_primePower_ray_char_unitLogCoord_phase_cell_bound_of_fundSystem_ne_one
      (K := K) A hA Φ_W hΦ_W_mul hΦ_W_pow hΦ_W_prin
  set W : ℝ := (N_tors : ℝ)
  have hW_pos : 0 < W := by dsimp [W]; exact_mod_cast hN_tors_pos
  have hW_ge_one : 1 ≤ W := by dsimp [W]; exact_mod_cast hN_tors_pos
  set c_R : ℝ := W * c₀
  have hc_R_pos : 0 < c_R := by dsimp [c_R]; positivity
  set c : ℝ := c_R + c₁
