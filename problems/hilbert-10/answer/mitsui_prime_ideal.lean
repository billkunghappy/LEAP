theorem mitsui_grossenchar_heckeL_real_zeroFree_of_vertical_growth {K : Type u} [Field K] [NumberField K] (A : ℕ) (hA : 1 < A) (A₁ : ℝ) (hA₁_pos : 0 < A₁) :
