        (U_main.card : ℝ) * (((2 : ℝ) ^ r₁)⁻¹ * h ^ (r + r₂)) +
          (S_collar.card : ℝ) * h ^ (r + r₂) := by
      calc ((U_main.card : ℝ) + (2 : ℝ) ^ r₁ * (S_collar.card : ℝ)) *
            (((2 : ℝ) ^ r₁)⁻¹ * h ^ (r + r₂))
        _ = (U_main.card : ℝ) * (((2 : ℝ) ^ r₁)⁻¹ * h ^ (r + r₂)) +
            ((2 : ℝ) ^ r₁ * ((2 : ℝ) ^ r₁)⁻¹) * ((S_collar.card : ℝ) * h ^ (r + r₂)) := by ring
        _ = (U_main.card : ℝ) * (((2 : ℝ) ^ r₁)⁻¹ * h ^ (r + r₂)) +
            1 * ((S_collar.card : ℝ) * h ^ (r + r₂)) := by rw [mul_inv_cancel₀ h2r1_ne]
        _ = (U_main.card : ℝ) * (((2 : ℝ) ^ r₁)⁻¹ * h ^ (r + r₂)) +
            (S_collar.card : ℝ) * h ^ (r + r₂) := by ring
    calc c_scale * (MeasureTheory.volume Ω).toReal
      _ ≤ c_scale * ((U_outer.card : ℝ) * v_box) :=
        mul_le_mul_of_nonneg_left h_vol_hi hc_scale_nonneg
      _ = (U_outer.card : ℝ) * (c_scale * v_box) := by ring
      _ = (U_outer.card : ℝ) * (((2 : ℝ) ^ r₁)⁻¹ * h ^ (r + r₂)) := by rw [hc_scale_vbox]
      _ ≤ ((U_main.card : ℝ) + (2 : ℝ) ^ r₁ * (S_collar.card : ℝ)) *
            (((2 : ℝ) ^ r₁)⁻¹ * h ^ (r + r₂)) := h_outer_vbox
      _ = (U_main.card : ℝ) * (((2 : ℝ) ^ r₁)⁻¹ * h ^ (r + r₂)) +
            (S_collar.card : ℝ) * h ^ (r + r₂) := h_cancel
  change |((2 : ℝ) ^ r₁)⁻¹ *
      (∑ ξ : ι_real → Fin 2, ((S_main_slice ξ).card : ℝ) * h ^ (r + r₂)) -
    c_scale * (MeasureTheory.volume Ω).toReal| ≤
      (S_collar.card : ℝ) * h ^ (r + r₂)
  rw [h_lhs_eq]
  exact abs_le.mpr ⟨by linarith, by linarith⟩

theorem mitsui_archimedeanCoord_preimage_volume_eq_place_volume_prod {K : Type u} [Field K] [NumberField K]
