        _ ≤ (C_coeff * Real.exp 1 * (2 * (3 : ℝ) ^ r * c_base)) * Y₀ * Real.exp (-t / c₀) :=
          mul_le_mul_of_nonneg_left hexp_2cb_le_c₀ (by positivity)
    have h_term3 :
        (A_collar + ε_tail) * Ψ₁_K ≤
        (C_coeff * Real.exp 1 * (3 * (1 + c_base))) * Y₀ * Real.exp (-t / c₀) := by
      calc (A_collar + ε_tail) * Ψ₁_K
        _ ≤ (3 * C_coeff * Real.exp (-t / (2 / c'))) * ((1 + c_base) * Real.exp 1 * Y₀) :=
          mul_le_mul h_collar_tail_le hΨ₁_K_bound hΨ₁_K_nonneg (by positivity)
        _ = (C_coeff * Real.exp 1 * (3 * (1 + c_base))) * Y₀ * Real.exp (-t / (2 / c')) := by ring
        _ ≤ (C_coeff * Real.exp 1 * (3 * (1 + c_base))) * Y₀ * Real.exp (-t / c₀) :=
          mul_le_mul_of_nonneg_left hexp_2c'_le_c₀ (by positivity)
    have h_sum_le :
        (C_coeff * Real.exp 1 * (2 * (3 : ℝ) ^ r * c_base)) * Y₀ * Real.exp (-t / c₀) +
        (C_coeff * Real.exp 1 * (3 * (1 + c_base))) * Y₀ * Real.exp (-t / c₀) ≤
        c₀ * Y₀ * Real.exp (-t / c₀) := by
      have h_coeff :
          C_coeff * Real.exp 1 * (2 * (3 : ℝ) ^ r * c_base) +
          C_coeff * Real.exp 1 * (3 * (1 + c_base)) ≤ c₀ := by
        have : 0 ≤ 2 / c' + 2 * c_base := by positivity
        dsimp [c₀]; linarith
      have hYE_nonneg : 0 ≤ Y₀ * Real.exp (-t / c₀) := by positivity
      calc (C_coeff * Real.exp 1 * (2 * (3 : ℝ) ^ r * c_base)) * Y₀ * Real.exp (-t / c₀) +
          (C_coeff * Real.exp 1 * (3 * (1 + c_base))) * Y₀ * Real.exp (-t / c₀)
        _ = (C_coeff * Real.exp 1 * (2 * (3 : ℝ) ^ r * c_base) +
              C_coeff * Real.exp 1 * (3 * (1 + c_base))) * (Y₀ * Real.exp (-t / c₀)) := by ring
        _ ≤ c₀ * (Y₀ * Real.exp (-t / c₀)) := mul_le_mul_of_nonneg_right h_coeff hYE_nonneg
        _ = c₀ * Y₀ * Real.exp (-t / c₀) := by ring
    exact le_trans h_s3 (by linarith)
  · refine ⟨1, zero_lt_one, ?_⟩
    intro X _ m _ w₀ k Z _ _ q _ _ β j₀
    exact False.elim (h_rank j₀.pos)

theorem mitsui_primePower_char_decoupled_log_box_bound_of_fundSystem_ne_one {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c_pp : ℝ, 0 < c_pp ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m →
          ∀ w₀ : NumberField.InfinitePlace K,
            ∀ k : NumberField.InfinitePlace K → Fin m,
              (k w₀ : ℕ) + 1 = m →
              ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
                (Ideal.absNorm q : ℝ) < Real.log X ^ A →
                ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
                  (∀ u ∈ NumberField.Units.torsion K,
                    ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) →
                  ∀ j₀ : Fin (NumberField.Units.rank K),
                    ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom
                      (NumberField.Units.fundSystem K j₀))) ≠ 1 →
                    ‖∑' xpm : {xpm : NumberField.RingOfIntegers K ×
                          IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                        1 ≤ xpm.2.2 ∧
                        Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
                        (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤
                          X ^ (Module.finrank ℚ K) *
                            Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
                              (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))) ∧
                        (∀ w : NumberField.InfinitePlace K,
                          Real.log (w (xpm.1 : K) / w₀ (xpm.1 : K)) ∈
                            Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                              (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))) ∧
                        IsUnit (Ideal.Quotient.mk q xpm.1)},
                      ψ (Additive.ofMul xpm.2.2.2.2.2.unit) *
                        (Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) : ℂ)‖
                    ≤ c_pp * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_pp) :=
by
  classical
