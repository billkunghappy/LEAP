        dsimp [g]
        rw [dif_pos hIf', norm_mul, norm_inv]
        set M₀ := (h_ex I hIf').choose
        set c₀ := (h_ex I hIf').choose_spec.choose
        obtain ⟨hc₀_ne, hM₀_cop, _, _⟩ := (h_ex I hIf').choose_spec.choose_spec
