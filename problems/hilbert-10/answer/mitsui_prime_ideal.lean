    have : 0 ≤ c₁ + 3 * c_sub + A_cell + 1 / c' := by positivity
    dsimp [c_cone]; linarith
  have hexp₁ : Real.exp (-t / c₁) ≤ Real.exp (-t / c_cone) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
