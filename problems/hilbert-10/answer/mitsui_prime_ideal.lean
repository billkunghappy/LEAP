      rw [h_mul_u, h_phase w₀]
      rw [← mul_assoc, ← mul_assoc, huζ]
    refine ⟨h_part1, fun i => ?_⟩
    have h_z_ray : ∀ w : NumberField.InfinitePlace K,
        w.embedding ((((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * x_shift ζ e : NumberField.RingOfIntegers K) : K) /
          (w₀ (x_shift ζ e : K) : ℂ) =
        w.embedding ((((u * ζ : NumberField.Units.torsion K) : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
          τ w *
          Complex.exp
            (((∑ j : Fin (NumberField.Units.rank K),
                (v j + (e j : ℝ)) *
                  (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg) : ℝ) * Complex.I) *
          (Real.exp
            (∑ j : Fin (NumberField.Units.rank K),
              (v j + (e j : ℝ)) *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) : ℂ) := by
      intro w
      have hw_x_pos : 0 < w (x_shift ζ e : K) := w.pos_iff.mpr hx_coe
      have hw₀_x_pos : 0 < w₀ (x_shift ζ e : K) := w₀.pos_iff.mpr hx_coe
      have hw_x_ne_c : (w (x_shift ζ e : K) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hw_x_pos)
      have h_ratio : w (x_shift ζ e : K) / w₀ (x_shift ζ e : K) =
          Real.exp
            (∑ j : Fin (NumberField.Units.rank K),
              (v j + (e j : ℝ)) *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) := by
        rw [← h_log_shift ζ e w]
        exact (Real.exp_log (div_pos hw_x_pos hw₀_x_pos)).symm
      have h_split :
          w.embedding ((((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * x_shift ζ e : NumberField.RingOfIntegers K) : K) /
            (w₀ (x_shift ζ e : K) : ℂ) =
          w.embedding (((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
            (w.embedding (x_shift ζ e : K) / (w (x_shift ζ e : K) : ℂ)) *
            ((w (x_shift ζ e : K) / w₀ (x_shift ζ e : K) : ℝ) : ℂ) := by
        push_cast
        rw [map_mul, mul_assoc (w.embedding _), div_mul_div_cancel₀ hw_x_ne_c, mul_div_assoc']
      have huζ :
          w.embedding (((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
            w.embedding (((ζ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) =
          w.embedding ((((u * ζ : NumberField.Units.torsion K) : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) := by
        rw [← map_mul]
        rfl
      rw [h_split, h_phase w, h_ratio]
      rw [← mul_assoc, ← mul_assoc, huζ]
    have h_vec :
        (w₀ (x_shift ζ e : K))⁻¹ •
          NumberField.mixedEmbedding K ((((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * x_shift ζ e : NumberField.RingOfIntegers K) : K) =
        (fun w : {w : NumberField.InfinitePlace K // w.IsReal} =>
          (w.1.embedding ((((u * ζ : NumberField.Units.torsion K) : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
            τ w.1 *
            Complex.exp
              (((∑ j : Fin (NumberField.Units.rank K),
                  (v j + (e j : ℝ)) *
                    (w.1.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg) : ℝ) * Complex.I) *
            (Real.exp
              (∑ j : Fin (NumberField.Units.rank K),
                (v j + (e j : ℝ)) *
                  Real.log (w.1 (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                    w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) : ℂ)).re,
         fun w : {w : NumberField.InfinitePlace K // w.IsComplex} =>
          w.1.embedding ((((u * ζ : NumberField.Units.torsion K) : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
            τ w.1 *
            Complex.exp
              (((∑ j : Fin (NumberField.Units.rank K),
                  (v j + (e j : ℝ)) *
                    (w.1.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg) : ℝ) * Complex.I) *
            (Real.exp
              (∑ j : Fin (NumberField.Units.rank K),
                (v j + (e j : ℝ)) *
                  Real.log (w.1 (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                    w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) : ℂ)) := by
      apply Prod.ext
      · funext w
        change (w₀ (x_shift ζ e : K))⁻¹ * (NumberField.mixedEmbedding K ((((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * x_shift ζ e : NumberField.RingOfIntegers K) : K)).1 w = _
        rw [inv_mul_eq_div, NumberField.mixedEmbedding.mixedEmbedding_apply_isReal]
        rw [← Complex.ofReal_re (NumberField.InfinitePlace.embedding_of_isReal w.2 _)]
        rw [NumberField.InfinitePlace.embedding_of_isReal_apply]
        rw [← Complex.div_ofReal_re, h_z_ray w.1]
      · funext w
        change (w₀ (x_shift ζ e : K))⁻¹ • (NumberField.mixedEmbedding K ((((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * x_shift ζ e : NumberField.RingOfIntegers K) : K)).2 w = _
        rw [Complex.real_smul, Complex.ofReal_inv, inv_mul_eq_div,
          NumberField.mixedEmbedding.mixedEmbedding_apply_isComplex, h_z_ray w.1]
    have h_repr := congrArg (fun z => (NumberField.mixedEmbedding.stdBasis K).repr z i) h_vec
    dsimp only at h_repr
    rw [LinearEquiv.map_smul, Finsupp.smul_apply, smul_eq_mul, inv_mul_eq_div] at h_repr
    exact h_repr
  let P_lhs (x : NumberField.RingOfIntegers K) (u : NumberField.Units.torsion K) : Prop :=
    ∀ i : NumberField.mixedEmbedding.index K,
      R₁ *
        ((NumberField.mixedEmbedding.stdBasis K).repr
            (NumberField.mixedEmbedding K ((((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * x : NumberField.RingOfIntegers K) : K)) i /
          w₀ (x : K)) ∈ I_dir i
  let P_rhs (e_val : Fin (NumberField.Units.rank K) → ℤ) (u : NumberField.Units.torsion K) : Prop :=
    ∀ i : NumberField.mixedEmbedding.index K,
      R₁ *
        (NumberField.mixedEmbedding.stdBasis K).repr
          (fun w : {w : NumberField.InfinitePlace K // w.IsReal} =>
            (w.1.embedding (((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
              τ w.1 *
              Complex.exp
                (((∑ j : Fin (NumberField.Units.rank K),
                    (v j + (e_val j : ℝ)) *
                      (w.1.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg) : ℝ) * Complex.I) *
              (Real.exp
                (∑ j : Fin (NumberField.Units.rank K),
                  (v j + (e_val j : ℝ)) *
                    Real.log (w.1 (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                      w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) : ℂ)).re,
           fun w : {w : NumberField.InfinitePlace K // w.IsComplex} =>
            w.1.embedding (((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
              τ w.1 *
              Complex.exp
                (((∑ j : Fin (NumberField.Units.rank K),
                    (v j + (e_val j : ℝ)) *
                      (w.1.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg) : ℝ) * Complex.I) *
              (Real.exp
                (∑ j : Fin (NumberField.Units.rank K),
                  (v j + (e_val j : ℝ)) *
                    Real.log (w.1 (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                      w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) : ℂ)) i ∈ I_dir i
  let F_lhs (x : CellGen) : ℂ :=
    (∑' u : {u : NumberField.Units.torsion K // P_lhs x.1 u},
      (w₀.embedding ((((u.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * x.1 : NumberField.RingOfIntegers K) : K) /
        (w₀ (x.1 : K) : ℂ)) ^ a₀) *
      Complex.exp
        (((∑ w : NumberField.InfinitePlace K,
            β w * Real.log (w (x.1 : K) / w₀ (x.1 : K))) : ℝ) * Complex.I)
  let F_rhs (e : FreeCell) : ℂ :=
    (∑' u : {u : NumberField.Units.torsion K // P_rhs e.1 u},
      (w₀.embedding (((u.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
        τ w₀ *
        Complex.exp
          (((∑ j : Fin (NumberField.Units.rank K),
              (v j + (e.1 j : ℝ)) *
                (w₀.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg) : ℝ) * Complex.I)) ^ a₀) *
      Complex.exp
        (((∑ w : NumberField.InfinitePlace K,
            β w *
              ∑ j : Fin (NumberField.Units.rank K),
                (v j + (e.1 j : ℝ)) *
                  Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                    w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) : ℝ) * Complex.I)
  have h_summand_eq : ∀ (ζ : NumberField.Units.torsion K) (e : FreeCell),
      F_lhs (E_gen (ζ, e)) = F_rhs e := by
    intro ζ e
    have hE_val : (E_gen (ζ, e)).1 = x_shift ζ e.1 := rfl
    have h_ray_phase := fun u : NumberField.Units.torsion K => h_ray_and_phase ζ u e.1
    have h_iff : ∀ u : NumberField.Units.torsion K,
        P_lhs (x_shift ζ e.1) u ↔ P_rhs e.1 (Equiv.mulRight ζ u) := by
      intro u
      refine forall_congr' (fun i => ?_)
      dsimp only [P_lhs, P_rhs, Equiv.coe_mulRight]
      rw [(h_ray_phase u).2 i]
    let e_tors : {u : NumberField.Units.torsion K // P_lhs (x_shift ζ e.1) u} ≃
        {u : NumberField.Units.torsion K // P_rhs e.1 u} :=
      Equiv.subtypeEquiv (Equiv.mulRight ζ) h_iff
    have h_inner_eq :
        (∑' u : {u : NumberField.Units.torsion K // P_lhs (x_shift ζ e.1) u},
          (w₀.embedding ((((u.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * x_shift ζ e.1 : NumberField.RingOfIntegers K) : K) /
            (w₀ (x_shift ζ e.1 : K) : ℂ)) ^ a₀) =
        ∑' u : {u : NumberField.Units.torsion K // P_rhs e.1 u},
          (w₀.embedding (((u.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
            τ w₀ *
            Complex.exp
              (((∑ j : Fin (NumberField.Units.rank K),
                  (v j + (e.1 j : ℝ)) *
                    (w₀.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg) : ℝ) * Complex.I)) ^ a₀ := by
      rw [← Equiv.tsum_eq e_tors]
      refine tsum_congr (fun u => ?_)
      dsimp only [e_tors, Equiv.subtypeEquiv_apply, Equiv.coe_mulRight]
      rw [(h_ray_phase u.1).1]
    have h_exp_eq :
        (∑ w : NumberField.InfinitePlace K,
          β w * Real.log (w (x_shift ζ e.1 : K) / w₀ (x_shift ζ e.1 : K))) =
        ∑ w : NumberField.InfinitePlace K,
          β w *
            ∑ j : Fin (NumberField.Units.rank K),
              (v j + (e.1 j : ℝ)) *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) := by
      refine Finset.sum_congr rfl (fun w _ => ?_)
      rw [h_log_shift ζ e.1 w]
    dsimp only [F_lhs, F_rhs]
    rw [hE_val, h_inner_eq, h_exp_eq]
  change (∑' x : CellGen, F_lhs x) =
    (NumberField.Units.torsionOrder K : ℂ) * ∑' e : FreeCell, F_rhs e
  rw [← Equiv.tsum_eq E_gen]
  calc ∑' p : NumberField.Units.torsion K × FreeCell, F_lhs (E_gen p)
    _ = ∑' p : NumberField.Units.torsion K × FreeCell, F_rhs p.2 :=
        tsum_congr (fun p => h_summand_eq p.1 p.2)
    _ = ∑ p : NumberField.Units.torsion K × FreeCell, F_rhs p.2 :=
        tsum_fintype _
    _ = ∑ _ζ : NumberField.Units.torsion K, ∑ e : FreeCell, F_rhs e :=
        Fintype.sum_prod_type _
    _ = (NumberField.Units.torsionOrder K : ℂ) * ∑ e : FreeCell, F_rhs e := by
        rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
        rfl
    _ = (NumberField.Units.torsionOrder K : ℂ) * ∑' e : FreeCell, F_rhs e := by
        rw [tsum_fintype]

theorem mitsui_riesz_primePower_log_cell_le_of_ideal_monoidHom_bound {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (w₀ : NumberField.InfinitePlace K)
    (l : ℕ) (hl : 1 ≤ l)
    (p : NumberField.InfinitePlace K → Fin l)
    (Z : ℝ) (hZ : 0 < Z)
    (W_arch : NumberField.RingOfIntegers K → ℂ)
    (M : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℕ → ℂ)
    (hM : ∀ (p_id : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (ν : ℕ),
      1 ≤ ν → (p_id.asIdeal ^ ν).IsPrincipal →
      (∑' x : {x : NumberField.RingOfIntegers K //
          Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = p_id.asIdeal ^ ν ∧
          ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
            Real.log (w (x : K) / w₀ (x : K)) ∈
              Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
                (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))},
        W_arch x.1) = M p_id ν)
    (B : ℝ) (hB : 0 ≤ B)
    (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (h_bound : ∀ χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ,
      (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        χ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
        χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩) →
      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
        ‖χ I‖ = ‖χ₀ I‖ ∧ (χ I = 0 ↔ χ₀ I = 0)) →
      ‖∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Z},
          M pm.1.1 pm.1.2 *
            ((χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
              ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                Real.log (Z / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ))‖ ≤ B) :
    ‖∑' xpm : {xpm : NumberField.RingOfIntegers K ×
            IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          1 ≤ xpm.2.2 ∧
          Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
          (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Z ∧
          ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
            Real.log (w (xpm.1 : K) / w₀ (xpm.1 : K)) ∈
              Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
                (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))},
        W_arch xpm.1.1 *
          ((χ₀ ⟨xpm.1.2.1.asIdeal, mem_nonZeroDivisors_of_ne_zero xpm.1.2.1.ne_bot⟩) ^ xpm.1.2.2 *
            ((Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) *
              Real.log (Z / ((Ideal.absNorm xpm.1.2.1.asIdeal : ℝ) ^ xpm.1.2.2)) : ℝ) : ℂ))‖ ≤ B :=
by
  classical
  set n : ℕ := Module.finrank ℚ K
  have hn_pos : 0 < n := Module.finrank_pos
  have hX_pos : 0 < X := lt_trans zero_lt_one hX
  have hlog_pos : 0 < Real.log X := Real.log_pos hX
  have hl_pos_nat : 0 < l := hl
  have hl_pos : (0 : ℝ) < (l : ℝ) := Nat.cast_pos.mpr hl_pos_nat
  have h_norm_ge_two : ∀ p_id : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p_id.asIdeal := by
    intro p_id
    have h0 : Ideal.absNorm p_id.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p_id.ne_bot
    have h1 : Ideal.absNorm p_id.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p_id.isPrime.ne_top
    omega
  have h_pm_bounds : ∀ (p_id : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (ν : ℕ),
      1 ≤ ν → (Ideal.absNorm p_id.asIdeal : ℝ) ^ ν ≤ Z →
      Ideal.absNorm p_id.asIdeal ≤ ⌊Z⌋₊ ∧ ν ≤ ⌊Z⌋₊ := by
    intro p_id ν hν h_pow
    have hk2 : 2 ≤ Ideal.absNorm p_id.asIdeal := h_norm_ge_two p_id
    have h_pow_nat : ((Ideal.absNorm p_id.asIdeal ^ ν : ℕ) : ℝ) ≤ Z := by exact_mod_cast h_pow
    have h_km_le : Ideal.absNorm p_id.asIdeal ^ ν ≤ ⌊Z⌋₊ := Nat.le_floor h_pow_nat
    have hν_ne : ν ≠ 0 := by omega
    have hk_le_km : Ideal.absNorm p_id.asIdeal ≤ Ideal.absNorm p_id.asIdeal ^ ν :=
      Nat.le_self_pow hν_ne (Ideal.absNorm p_id.asIdeal)
    have hν_le_2ν : ν ≤ 2 ^ ν := (Nat.lt_pow_self (by decide : 1 < 2)).le
    have h2ν_le_km : 2 ^ ν ≤ Ideal.absNorm p_id.asIdeal ^ ν := Nat.pow_le_pow_left hk2 ν
    exact ⟨le_trans hk_le_km h_km_le, le_trans (le_trans hν_le_2ν h2ν_le_km) h_km_le⟩
  have h_prod_norm : ∀ x : NumberField.RingOfIntegers K,
      (∏ v : NumberField.InfinitePlace K, v (x : K) ^ v.mult) =
        ((Algebra.norm ℤ x).natAbs : ℝ) := by
    intro x
    rw [NumberField.InfinitePlace.prod_eq_abs_norm]
    have h_coe : Algebra.norm ℚ (x : K) = (Algebra.norm ℤ x : ℚ) :=
      (Algebra.coe_norm_int x).symm
    rw [h_coe]
    push_cast
    rw [← Int.cast_abs]
    exact (Int.cast_natAbs (Algebra.norm ℤ x)).symm
  have h_cell_place_le : ∀ (x : NumberField.RingOfIntegers K)
      (p_id : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (ν : ℕ),
      1 ≤ ν →
      Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = p_id.asIdeal ^ ν →
      (Ideal.absNorm p_id.asIdeal : ℝ) ^ ν ≤ Z →
      (∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
        Real.log (w (x : K) / w₀ (x : K)) ∈
          Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
            (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))) →
      ∀ v : NumberField.InfinitePlace K, v (x : K) ≤ X * Z := by
    intro x p_id ν hν h_span h_pow hx_log v
    have h_span_ne : Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ≠ ⊥ :=
      h_span.symm ▸ pow_ne_zero ν p_id.ne_bot
    have hx_ne : x ≠ 0 := Ideal.span_singleton_eq_bot.not.mp h_span_ne
