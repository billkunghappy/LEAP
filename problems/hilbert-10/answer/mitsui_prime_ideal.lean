        ≤ ‖(b m : ℂ) - ρ‖ := h_re_le
      _ = (m.factorial : ℝ)⁻¹ * ‖iteratedDeriv m H 2‖ := h_norm_taylor
      _ ≤ (m.factorial : ℝ)⁻¹ * ((m.factorial : ℝ) * (M * (2 / 3 : ℝ) ^ m)) :=
          mul_le_mul_of_nonneg_left h_cauchy (inv_nonneg.mpr (le_of_lt hfact_pos))
      _ = M * (2 / 3 : ℝ) ^ m := inv_mul_cancel_left₀ (ne_of_gt hfact_pos) _
  have hb_rho_neg : ∀ m : ℕ, -(b m - ρ.re) ≤ M * (2 / 3 : ℝ) ^ m := by
    intro m
    calc -(b m - ρ.re)
        ≤ |-(b m - ρ.re)| := le_abs_self _
      _ = |b m - ρ.re| := abs_neg _
      _ ≤ M * (2 / 3 : ℝ) ^ m := hb_rho_abs m
  set u : ℝ := 2 - α₁
  set f : ℕ → ℝ := fun m => (b m - ρ.re) * u ^ m
  set S : ℝ := ρ.re / (1 - α₁)
