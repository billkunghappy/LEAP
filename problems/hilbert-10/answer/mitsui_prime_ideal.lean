      have h₀ := (hT_V_w₀ z).mp (h_pi w₀)
      have h_ne : ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
          L_z z w ∈ I_log w ∧ P_ang w (R₁ * Real.exp (L_z z w)) (z w).2 :=
        fun w hw => (hT_V_ne z w hw).mp (h_pi w)
      have hP_all : ∀ w : NumberField.InfinitePlace K,
          P_ang w (R₁ * Real.exp (L_z z w)) (z w).2 := by
        intro w
        by_cases hw : w = w₀
        · subst hw; exact h₀.2
        · exact (h_ne w hw).2
      refine ⟨h₀.1, fun w hw => (h_ne w hw).1,
        fun w => (hP_real w _ _).mp (hP_all w.1),
        fun w => (hP_complex w _ _).mp (hP_all w.1)⟩
  have h_vol_preimage :
      MeasureTheory.volume Ω_pre =
        ENNReal.ofReal |(LinearMap.det T_log)⁻¹| *
          ∏ w : NumberField.InfinitePlace K, MeasureTheory.volume (V w) := by
    have h_pi_vol :
        MeasureTheory.volume (Set.univ.pi V) =
          ∏ w : NumberField.InfinitePlace K, MeasureTheory.volume (V w) :=
      MeasureTheory.Measure.pi_pi (fun _ => MeasureTheory.volume) V
    rw [h_pre_eq,
      MeasureTheory.Measure.addHaar_preimage_linearMap MeasureTheory.volume hT_det_ne (Set.univ.pi V),
      h_pi_vol]
  have h_vol_toReal :
      (MeasureTheory.volume Ω_pre).toReal =
        |(M_rel.det)⁻¹| *
          ∏ w : NumberField.InfinitePlace K, (MeasureTheory.volume (V w)).toReal := by
    rw [h_vol_preimage, hT_det, ENNReal.toReal_mul,
      ENNReal.toReal_ofReal (abs_nonneg _), ENNReal.toReal_prod]
  have h_card_real_eq : ∀ (inst : Fintype {w : NumberField.InfinitePlace K // w.IsReal}),
      @Fintype.card {w : NumberField.InfinitePlace K // w.IsReal} inst =
        NumberField.InfinitePlace.nrRealPlaces K :=
    fun inst => congrArg (@Fintype.card {w : NumberField.InfinitePlace K // w.IsReal})
      (Subsingleton.elim inst _)
  have h_card_complex_eq : ∀ (inst : Fintype {w : NumberField.InfinitePlace K // w.IsComplex}),
      @Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex} inst =
        NumberField.InfinitePlace.nrComplexPlaces K :=
    fun inst => congrArg (@Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex})
      (Subsingleton.elim inst _)
  let r₁ : ℕ := NumberField.InfinitePlace.nrRealPlaces K
  let r₂ : ℕ := NumberField.InfinitePlace.nrComplexPlaces K
  have h_prod_mult_eq :
      (∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) = (2 : ℝ) ^ r₂ := by
    rw [NumberField.InfinitePlace.prod_eq_prod_mul_prod
      (fun w : NumberField.InfinitePlace K => (w.mult : ℝ))]
    simp_rw [NumberField.InfinitePlace.mult_isReal, Nat.cast_one, Finset.prod_const_one, one_mul,
      NumberField.InfinitePlace.mult_isComplex, Nat.cast_ofNat, Finset.prod_const, Finset.card_univ,
      h_card_complex_eq]
    rfl
  have h_F_eq :
      (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) =
        (2 : ℝ) ^ r₁ * Real.pi ^ r₂ := by
    have h_def : NumberField.mixedEmbedding.convexBodyLTFactor K =
        (2 : NNReal) ^ r₁ * NNReal.pi ^ r₂ := rfl
    rw [h_def, NNReal.coe_mul, NNReal.coe_pow, NNReal.coe_pow, NNReal.coe_ofNat, NNReal.coe_real_pi]
  change ((2 : ℝ) ^ (Fintype.card {w : NumberField.InfinitePlace K // w.IsReal}))⁻¹ *
      ((2 * Real.pi) ^ (Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex}))⁻¹ *
      (MeasureTheory.volume Ω_pre).toReal =
    ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) * (n : ℝ) *
      NumberField.Units.regulator K)⁻¹ *
      ∏ w : NumberField.InfinitePlace K, (MeasureTheory.volume (V w)).toReal
  rw [h_card_real_eq, h_card_complex_eq]
  change ((2 : ℝ) ^ r₁)⁻¹ * ((2 * Real.pi) ^ r₂)⁻¹ * (MeasureTheory.volume Ω_pre).toReal =
    ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) * (n : ℝ) *
      NumberField.Units.regulator K)⁻¹ *
      ∏ w : NumberField.InfinitePlace K, (MeasureTheory.volume (V w)).toReal
  rw [h_vol_toReal, hM_inv_abs, h_prod_mult_eq, h_F_eq, mul_pow]
  have h2r1_ne : (2 : ℝ) ^ r₁ ≠ 0 := by positivity
  have h2r2_ne : (2 : ℝ) ^ r₂ ≠ 0 := by positivity
  have hpir2_ne : Real.pi ^ r₂ ≠ 0 := by positivity
  field_simp [h2r1_ne, h2r2_ne, hpir2_ne, hn_ne, hR_ne]

theorem mitsui_riesz_primePower_decoupled_norm_dir_log_cell_asymptotic_of_large_Z {K : Type u} [Field K] [NumberField K] :
    ∃ c_large : ℝ, 0 < c_large ∧
      ∀ X : ℝ, 1 < X → 1 < Real.log X →
        ∀ m : ℕ, 1 ≤ m → (m : ℝ) ≤ Real.exp (Real.sqrt (Real.log X)) →
          ∀ R₁ : ℝ, 1 < R₁ → R₁ ≤ X →
            ∀ k : NumberField.mixedEmbedding.index K → Fin (2 * m),
              ∀ w₀ : NumberField.InfinitePlace K,
                ∀ l : ℕ, 1 ≤ l →
                  ∀ p : NumberField.InfinitePlace K → Fin l,
                    ∀ Z : ℝ,
                      X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / 2) ≤ Z →
                      Z ≤ Real.exp 1 * X ^ (Module.finrank ℚ K) →
                      |(∑' xpm : {xpm : NumberField.RingOfIntegers K ×
                              IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                            1 ≤ xpm.2.2 ∧
                            Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
                            (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Z ∧
                            (∀ i : NumberField.mixedEmbedding.index K,
                              R₁ *
                                ((NumberField.mixedEmbedding.stdBasis K).repr
                                    (NumberField.mixedEmbedding K (xpm.1 : K)) i / w₀ (xpm.1 : K)) ∈
                                Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                                  ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
                            (∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
                              Real.log (w (xpm.1 : K) / w₀ (xpm.1 : K)) ∈
                                Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
                                  (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ))))},
                          Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) *
                            Real.log (Z / ((Ideal.absNorm xpm.1.2.1.asIdeal : ℝ) ^ xpm.1.2.2)))
                        - ((NumberField.Units.torsionOrder K : ℝ) /
                            ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) *
                              (NumberField.classNumber K : ℝ) *
                              NumberField.Units.regulator K)) *
                          ((Module.finrank ℚ K : ℝ)⁻¹ *
                            (∏ w : NumberField.InfinitePlace K,
                              (MeasureTheory.volume {q : ℝ × ℝ |
                                (w = w₀ ∧
                                  q.1 ∈ Set.Ioo (0 : ℝ) 1 ∧
                                  ((∃ hw : w.IsReal,
                                      (q.2 ∈ Set.Ioo (0 : ℝ) 1 ∧
                                        R₁ ∈
                                          Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                            ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1))) ∨
                                      (q.2 ∈ Set.Ioo (1 : ℝ) 2 ∧
                                        -R₁ ∈
                                          Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                            ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)))) ∨
                                    (∃ hc : w.IsComplex,
                                      q.2 ∈ Set.Ioo (-Real.pi) Real.pi ∧
                                      R₁ * Real.cos q.2 ∈
                                        Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                                          ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
                                      R₁ * Real.sin q.2 ∈
                                        Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                                          ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1))))) ∨
                                (w ≠ w₀ ∧
                                  q.1 ∈
                                    Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
                                      (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ))) ∧
                                  ((∃ hw : w.IsReal,
                                      (q.2 ∈ Set.Ioo (0 : ℝ) 1 ∧
                                        R₁ * Real.exp q.1 ∈
                                          Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                            ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1))) ∨
                                      (q.2 ∈ Set.Ioo (1 : ℝ) 2 ∧
                                        -(R₁ * Real.exp q.1) ∈
                                          Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                            ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)))) ∨
                                    (∃ hc : w.IsComplex,
                                      q.2 ∈ Set.Ioo (-Real.pi) Real.pi ∧
                                      (R₁ * Real.exp q.1) * Real.cos q.2 ∈
                                        Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                                          ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
                                      (R₁ * Real.exp q.1) * Real.sin q.2 ∈
                                        Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                                          ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1)))))}).toReal) *
                            Z)|
                        ≤ c_large * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_large) :=
by
  classical
  obtain ⟨c_gen, hc_gen_pos, hc_gen⟩ := mitsui_decoupled_log_cell_generator_card_bound (K := K)
  obtain ⟨c_ray, hc_ray_pos, hc_ray⟩ := mitsui_riesz_primePower_ray_char_bound (K := K) 2 (by decide)
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_riesz_primePowers_asymptotic (K := K)
  obtain ⟨Φ_W, hΦ_W_mul, hΦ_W_pow, hΦ_W_prin⟩ :=
    mitsui_exists_ideal_unitLogCoord_extending_principal (K := K)
  obtain ⟨Φ_τ, hΦ_τ_norm, hΦ_τ_mul, hΦ_τ_pow, hΦ_τ_prin⟩ :=
    mitsui_exists_ideal_phaseCoord_extending_principal Φ_W hΦ_W_prin
  obtain ⟨c_gr, hc_gr_pos, hc_gr⟩ :=
    mitsui_riesz_primePower_archimedeanCoord_freq_bound_of_ne_zero_of_isReal_zero_or_one
      Φ_W hΦ_W_mul Φ_τ hΦ_τ_norm hΦ_τ_mul hΦ_τ_prin
  obtain ⟨C_trig, hC_trig_pos, h_trig⟩ :=
    mitsui_archimedeanCoord_principal_cell_grid_trigPoly_approx (K := K)
  let n : ℕ := Module.finrank ℚ K
  have hn_pos : 0 < n := Module.finrank_pos
  have hn_rpos : (0 : ℝ) < (n : ℝ) := Nat.cast_pos.mpr hn_pos
  have hn_ge_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn_pos
  let r : ℕ := NumberField.Units.rank K
  let r₁ : ℕ := Fintype.card {w : NumberField.InfinitePlace K // w.IsReal}
  let r₂ : ℕ := Fintype.card {w : NumberField.InfinitePlace K // w.IsComplex}
  let M_places : ℕ := Fintype.card (NumberField.InfinitePlace K)
  let d_tot : ℕ := r + M_places
  let W : ℝ := (NumberField.Units.torsionOrder K : ℝ)
  have hW_pos : 0 < W := by dsimp [W]; exact_mod_cast NumberField.Units.torsionOrder_pos K
  have hW_ge_one : 1 ≤ W := by dsimp [W]; exact_mod_cast NumberField.Units.torsionOrder_pos K
  have hW_sq_pos : 0 < W ^ 2 := by positivity
  have hW_sq_ge_one : 1 ≤ W ^ 2 := by nlinarith
  let F : ℝ := (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
  have hF_ge_one : 1 ≤ F := by exact_mod_cast NumberField.mixedEmbedding.one_le_convexBodyLTFactor K
  have hF_pos : 0 < F := lt_of_lt_of_le zero_lt_one hF_ge_one
  let H : ℝ := (NumberField.classNumber K : ℝ)
  have hH_pos : 0 < H := by dsimp [H]; exact_mod_cast NumberField.classNumber_pos K
  have hH_ge_one : 1 ≤ H := by dsimp [H]; exact_mod_cast NumberField.classNumber_pos K
  have hH_inv_nonneg : 0 ≤ H⁻¹ := inv_nonneg.mpr (le_of_lt hH_pos)
  have hH_inv_le_one : H⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hH_ge_one
  let R_reg : ℝ := NumberField.Units.regulator K
  have hR_reg_pos : 0 < R_reg := NumberField.Units.regulator_pos K
  let κ₀ : ℝ := W / (F * H * R_reg)
  have hκ₀_pos : 0 < κ₀ := by dsimp [κ₀]; positivity
  let C_vol : ℝ := κ₀ * (n : ℝ)⁻¹ * (2 * Real.pi) ^ M_places
  have hC_vol_pos : 0 < C_vol := by dsimp [C_vol]; positivity
  obtain ⟨c_base, hc_base_def⟩ : ∃ c_base : ℝ,
      c_base = 2 * c_gr + 2 * c_ray + 2 * c₁ + 2 := ⟨_, rfl⟩
  have hc_base_pos : 0 < c_base := by rw [hc_base_def]; linarith only [hc_gr_pos, hc_ray_pos, hc₁_pos]
  have hc_base_ge_two : 2 ≤ c_base := by rw [hc_base_def]; linarith only [hc_gr_pos, hc_ray_pos, hc₁_pos]
  have h2c_gr_le : 2 * c_gr ≤ c_base := by rw [hc_base_def]; linarith only [hc_ray_pos, hc₁_pos]
  have h2c_ray_le : 2 * c_ray ≤ c_base := by rw [hc_base_def]; linarith only [hc_gr_pos, hc₁_pos]
  have h2c₁_le : 2 * c₁ ≤ c_base := by rw [hc_base_def]; linarith only [hc_gr_pos, hc_ray_pos]
  have hc_gr_le : c_gr ≤ c_base := by rw [hc_base_def]; linarith only [hc_gr_pos, hc_ray_pos, hc₁_pos]
  have hc_ray_le : c_ray ≤ c_base := by rw [hc_base_def]; linarith only [hc_gr_pos, hc_ray_pos, hc₁_pos]
  have hc₁_le : c₁ ≤ c_base := by rw [hc_base_def]; linarith only [hc_gr_pos, hc_ray_pos, hc₁_pos]
  obtain ⟨c', hc'_def⟩ : ∃ c' : ℝ,
      c' = 1 / (8 * ((d_tot : ℝ) + 1) * (2 * (n : ℝ) + 1) * c_base) := ⟨_, rfl⟩
  have hc'_pos : 0 < c' := by rw [hc'_def]; positivity
  obtain ⟨c'', hc''_def⟩ : ∃ c'' : ℝ, c'' = c' / (4 * ((d_tot : ℝ) + 1)) := ⟨_, rfl⟩
  have hc''_pos : 0 < c'' := by rw [hc''_def]; positivity
  obtain ⟨K₀, hK₀_def⟩ : ∃ K₀ : ℝ, K₀ = 16 / c'' ^ 2 + 1 := ⟨_, rfl⟩
  have hK₀_pos : 0 < K₀ := by rw [hK₀_def]; positivity
  obtain ⟨C_coeff, hC_coeff_def⟩ : ∃ C_coeff : ℝ, C_coeff = C_trig * K₀ ^ d_tot := ⟨_, rfl⟩
  have hC_coeff_pos : 0 < C_coeff := by rw [hC_coeff_def]; positivity
  obtain ⟨C_vcoeff, hC_vcoeff_def⟩ : ∃ C_vcoeff : ℝ, C_vcoeff = C_vol * K₀ ^ d_tot := ⟨_, rfl⟩
  have hC_vcoeff_pos : 0 < C_vcoeff := by rw [hC_vcoeff_def]; positivity
  obtain ⟨c_low, hc_low_def⟩ : ∃ c_low : ℝ,
      c_low = (c_gen * (1 + c₁) + C_vol) * (5 : ℝ) ^ d_tot * (Real.exp 1) ^ 2 := ⟨_, rfl⟩
  have hc_low_pos : 0 < c_low := by rw [hc_low_def]; positivity
  obtain ⟨c_large, hc_large_def⟩ : ∃ c_large : ℝ,
      c_large =
        c_low +
        C_coeff * Real.exp 1 * (2 * (3 : ℝ) ^ d_tot * c_base + 3 * (1 + c_base)) +
        W ^ 2 * C_coeff * Real.exp 1 * (3 * (1 + 2 * c_base)) +
        W * H * C_vcoeff * Real.exp 1 * (2 * c_base) +
        4 / c' + 2 * c_base := ⟨_, rfl⟩
  have hc_large_pos : 0 < c_large := by rw [hc_large_def]; positivity
  have h2cb_le_c_large : 2 * c_base ≤ c_large := by
    have h0 : 0 ≤
        c_low +
        C_coeff * Real.exp 1 * (2 * (3 : ℝ) ^ d_tot * c_base + 3 * (1 + c_base)) +
        W ^ 2 * C_coeff * Real.exp 1 * (3 * (1 + 2 * c_base)) +
        W * H * C_vcoeff * Real.exp 1 * (2 * c_base) +
        4 / c' := by positivity
    rw [hc_large_def]; linarith only [h0]
  have hc_large_ge_two : 2 ≤ c_large := by linarith only [hc_base_ge_two, h2cb_le_c_large]
  have h4c'_le_c_large : 4 / c' ≤ c_large := by
    have h0 : 0 ≤
        c_low +
        C_coeff * Real.exp 1 * (2 * (3 : ℝ) ^ d_tot * c_base + 3 * (1 + c_base)) +
        W ^ 2 * C_coeff * Real.exp 1 * (3 * (1 + 2 * c_base)) +
        W * H * C_vcoeff * Real.exp 1 * (2 * c_base) +
        2 * c_base := by positivity
    rw [hc_large_def]; linarith only [h0]
  have hc_low_le_c_large : c_low ≤ c_large := by
    have h0 : 0 ≤
        C_coeff * Real.exp 1 * (2 * (3 : ℝ) ^ d_tot * c_base + 3 * (1 + c_base)) +
        W ^ 2 * C_coeff * Real.exp 1 * (3 * (1 + 2 * c_base)) +
        W * H * C_vcoeff * Real.exp 1 * (2 * c_base) +
        4 / c' + 2 * c_base := by positivity
    rw [hc_large_def]; linarith only [h0]
  refine ⟨c_large, hc_large_pos, ?_⟩
  intro X hX hlogX_gt m hm _hm_coarse R₁ hR₁_gt _hR₁_le k w₀ l hl p Z hZ_large hZ_le
  let Y₀ : ℝ := X ^ n
  have hX_pos : (0 : ℝ) < X := lt_trans zero_lt_one hX
  have hY₀_pos : 0 < Y₀ := pow_pos hX_pos n
  have hZ_pos : 0 < Z := lt_of_lt_of_le (by positivity) hZ_large
  have hlogX_pos : 0 < Real.log X := lt_trans zero_lt_one hlogX_gt
  have hl_rpos : (0 : ℝ) < (l : ℝ) := Nat.cast_pos.mpr hl
  let t : ℝ := Real.sqrt (Real.log X)
  have ht_pos : 0 < t := Real.sqrt_pos.mpr hlogX_pos
  have ht_nonneg : 0 ≤ t := le_of_lt ht_pos
  have ht_sq : t ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlogX_pos)
  let V : NumberField.InfinitePlace K → Set (ℝ × ℝ) := fun w =>
    {q : ℝ × ℝ |
      (w = w₀ ∧
        q.1 ∈ Set.Ioo (0 : ℝ) 1 ∧
        ((∃ hw : w.IsReal,
            (q.2 ∈ Set.Ioo (0 : ℝ) 1 ∧
              R₁ ∈
                Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1))) ∨
            (q.2 ∈ Set.Ioo (1 : ℝ) 2 ∧
              -R₁ ∈
                Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)))) ∨
          (∃ hc : w.IsComplex,
            q.2 ∈ Set.Ioo (-Real.pi) Real.pi ∧
            R₁ * Real.cos q.2 ∈
              Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
