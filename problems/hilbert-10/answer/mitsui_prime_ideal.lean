      calc (∏ w : NumberField.InfinitePlace K,
            (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w))
        _ = ∏ w : NumberField.InfinitePlace K,
              (((w.embedding (((ζ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ^ (l_ang w) *
