  let Ψ₁_cell : ℝ → ℝ := fun Z =>
    ∑' xpm : D_all Z,
      Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) *
        Real.log (Z / ((Ideal.absNorm xpm.1.2.1.asIdeal : ℝ) ^ xpm.1.2.2))
  let Ψ₁_cell_ne : ℝ → ℝ := fun Z =>
    ∑' xpm : D_ne Z,
      Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) *
        Real.log (Z / ((Ideal.absNorm xpm.1.2.1.asIdeal : ℝ) ^ xpm.1.2.2))
  let Ψ₁_K : ℝ → ℝ := fun Z =>
    ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
