      let f_polar : Set (ℝ × ℝ) → (ℝ × ℝ) → ENNReal := fun s q =>
        polarCoord.target.indicator (fun q => ENNReal.ofReal q.1 * s.indicator 1 (polarCoord.symm q)) q
      have h_target_meas : MeasurableSet polarCoord.target := by
        rw [polarCoord_target]
        exact measurableSet_Ioi.prod measurableSet_Ioo
      have h_vol_polar : ∀ (s : Set (ℝ × ℝ)), MeasurableSet s →
          MeasureTheory.volume s = ∫⁻ q : ℝ × ℝ, f_polar s q := by
        intro s hs
        have h_polar := lintegral_comp_polarCoord_symm (s.indicator 1)
        simp only [smul_eq_mul] at h_polar
        change MeasureTheory.volume s = ∫⁻ q : ℝ × ℝ,
          polarCoord.target.indicator (fun q => ENNReal.ofReal q.1 * s.indicator 1 (polarCoord.symm q)) q
