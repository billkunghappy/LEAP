    let n : ℕ := Module.finrank ℚ K
    have hn_pos : 0 < n := Module.finrank_pos
    let C₀ : ℝ := max 1 ((Fintype.card (NumberField.InfinitePlace K) : ℝ) *
      ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) * (1 + D) ^ (n + 1) / V_K))
    have hC₀_pos : 0 < C₀ := lt_of_lt_of_le zero_lt_one (le_max_left _ _)
    refine ⟨C₀, hC₀_pos, ?_⟩
    intro X Y hX hY
    let M : ℝ := max X Y
    let B_M : Set (NumberField.RingOfIntegers K) :=
      {x | ∀ w : NumberField.InfinitePlace K, w (x : K) < M}
    have hBM_fin : B_M.Finite := by
      have hBK_fin : {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ M}.Finite :=
        NumberField.Embeddings.finite_of_norm_le K ℂ M
      have hsub : B_M ⊆ (Subtype.val : NumberField.RingOfIntegers K → K) ⁻¹'
          {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ M} := by
        intro x hx
        refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, fun φ => ?_⟩
        have hφ : (NumberField.InfinitePlace.mk φ) (x : K) = ‖φ (x : K)‖ :=
          NumberField.InfinitePlace.apply φ (x : K)
        have hxφ : (NumberField.InfinitePlace.mk φ) (x : K) < M := hx (NumberField.InfinitePlace.mk φ)
        change ‖φ (x : K)‖ ≤ M
        linarith
      exact (hBK_fin.preimage Subtype.val_injective.injOn).subset hsub
    let S : Set (NumberField.RingOfIntegers K) :=
      {x | (∀ w : NumberField.InfinitePlace K, w (x : K) < X) ∧ ((Algebra.norm ℤ x).natAbs : ℝ) < Y}
    let B : NumberField.InfinitePlace K → Set (NumberField.RingOfIntegers K) :=
      fun w₀ => {x | w₀ (x : K) < Y ∧ ∀ w : NumberField.InfinitePlace K, w ≠ w₀ → w (x : K) < X}
    have hS_fin : S.Finite := hBM_fin.subset (fun x hx w => lt_of_lt_of_le (hx.1 w) (le_max_left X Y))
    have hB_fin : ∀ w₀, (B w₀).Finite := by
      intro w₀
      refine hBM_fin.subset (fun x hx w => ?_)
