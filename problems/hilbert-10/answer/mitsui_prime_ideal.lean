    change ((B_f : ℂ) ^ z * (P_f : ℂ)) * (S_f⁻¹ • ∫ τ in Set.Ioi (0 : ℝ), (τ : ℂ) ^ z * W₀_c ν_place τ) = _
    rw [h_mellin₀, Complex.real_smul, Complex.ofReal_inv]
    have hPf_div : (P_f : ℂ) * (S_f : ℂ)⁻¹ = (N_f : ℂ) ^ ((-3 / 4 : ℝ) : ℂ) := by
      have hSf_c_ne : (S_f : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hSf_ne
      have hPf_c : (P_f : ℂ) = ((N_f ^ (-3 / 4 : ℝ) : ℝ) : ℂ) * (S_f : ℂ) := by
        dsimp [P_f, N_f]
        push_cast
