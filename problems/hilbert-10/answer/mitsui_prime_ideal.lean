        rw [hσ_i, mul_one] at h_step_i
        have h_ki_le : (k.1 i : ℕ) + 1 ≤ (k'.1 i : ℕ) := by omega
        have h_ki_le_R : ((k.1 i : ℕ) : ℝ) + 1 ≤ ((k'.1 i : ℕ) : ℝ) := by exact_mod_cast h_ki_le
        have h_mid : δ * (((k.1 i : ℕ) : ℝ) - (m : ℝ) + 1) ≤
            δ * (((k'.1 i : ℕ) : ℝ) - (m : ℝ)) := by
          apply mul_le_mul_of_nonneg_left _ (le_of_lt hδ_pos)
          linarith
        have h_diff_nonneg : 0 ≤ b.repr z' i - b.repr (y k) i := by
          linarith [hy_i.2, hz'_i.1, h_mid]
