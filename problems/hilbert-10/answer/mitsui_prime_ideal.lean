      intro d hd w hw
      obtain ⟨s, rfl⟩ := Ideal.mem_span_singleton.mp hw
      have hd_mem : (algebraMap R K d) ∈ ((differentIdeal ℤ R : Ideal R) : FractionalIdeal S₀ K) :=
