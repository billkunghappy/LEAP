        field_simp [hA_ne]
      rw [hexp, ← Real.sqrt_eq_rpow]
    linarith
  have hχ_le_one : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ I‖ ≤ 1 := by
    intro I
    by_cases hI : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤
