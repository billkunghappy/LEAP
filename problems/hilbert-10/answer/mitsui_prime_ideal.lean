    have h_sum_real := LSeriesSummable_of_sum_norm_bigO_and_nonneg h_bigO ha_nonneg zero_le_one hs
    simpa [a_K, S] using h_sum_real
  have ha_ψ_bound : ∀ n : ℕ, ‖a_ψ n‖ ≤ (a_K n : ℝ) := by
    intro n
    dsimp [a_ψ, a_K]
    rw [tsum_fintype]
    have h_inj : Function.Injective (fun I : S' n => (⟨I.1, I.2.2⟩ : S n)) :=
      fun a b h => Subtype.ext (congrArg (fun x : S n => x.1) h)
    have h_card : (Nat.card (S' n) : ℝ) ≤ (Nat.card (S n) : ℝ) := by
      exact_mod_cast Nat.card_le_card_of_injective _ h_inj
    calc ‖∑ I : S' n, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖
        ≤ ∑ I : S' n, ‖ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖ := norm_sum_le _ _
      _ ≤ ∑ _I : S' n, (1 : ℝ) := Finset.sum_le_sum (fun I _ => hψ_norm _)
      _ = (Nat.card (S' n) : ℝ) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one, ← Nat.card_eq_fintype_card]
      _ ≤ (Nat.card (S n) : ℝ) := h_card
  have h_term_ψ_le_s : ∀ n : ℕ,
      ‖LSeries.term a_ψ s n‖ ≤ ‖LSeries.term (fun k => (a_K k : ℂ)) s n‖ := by
    intro n
    by_cases hn : n = 0
    · subst hn; simp [LSeries.term]
    · rw [LSeries.norm_term_eq, LSeries.norm_term_eq, if_neg hn, if_neg hn]
