    have hterm4 : |S_B - R⁻¹ * S_cone_p| ≤ c_bf * Y * Real.exp (-u / c_cube) := by
      calc |S_B - R⁻¹ * S_cone_p| ≤ c_bf * Y * Real.exp (-u / c_bf) := h4
        _ ≤ c_bf * Y * Real.exp (-u / c_cube) :=
          mul_le_mul_of_nonneg_left hexp4 (by positivity)
    have hterm5 : R⁻¹ * |S_cone_v - S_cone_p| ≤ (R⁻¹ * c_cp) * Y * Real.exp (-u / c_cube) := by
      calc R⁻¹ * |S_cone_v - S_cone_p| ≤ R⁻¹ * (c_cp * Y * Real.exp (-u / c_cp)) :=
            mul_le_mul_of_nonneg_left h5 (by positivity)
        _ ≤ R⁻¹ * (c_cp * Y * Real.exp (-u / c_cube)) :=
            mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp5 (by positivity)) (by positivity)
        _ = (R⁻¹ * c_cp) * Y * Real.exp (-u / c_cube) := by ring
    have hterm6 : R⁻¹ * |S_cone_v - W * S_prin| ≤ (R⁻¹ * c₂) * Y * Real.exp (-u / c_cube) := by
      calc R⁻¹ * |S_cone_v - W * S_prin| ≤ R⁻¹ * (c₂ * Y * Real.exp (-u / c₂)) :=
            mul_le_mul_of_nonneg_left h6 (by positivity)
        _ ≤ R⁻¹ * (c₂ * Y * Real.exp (-u / c_cube)) :=
            mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp6 (by positivity)) (by positivity)
        _ = (R⁻¹ * c₂) * Y * Real.exp (-u / c_cube) := by ring
    have hterm7 : (R⁻¹ * W) * |S_prin - H⁻¹ * S_all| ≤ ((R⁻¹ * W) * c₃) * Y * Real.exp (-u / c_cube) := by
      calc (R⁻¹ * W) * |S_prin - H⁻¹ * S_all| ≤ (R⁻¹ * W) * (c₃ * Y * Real.exp (-u / c₃)) :=
            mul_le_mul_of_nonneg_left h7 (by positivity)
        _ ≤ (R⁻¹ * W) * (c₃ * Y * Real.exp (-u / c_cube)) :=
            mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp7 (by positivity)) (by positivity)
        _ = ((R⁻¹ * W) * c₃) * Y * Real.exp (-u / c_cube) := by ring
    have hterm8 : (R⁻¹ * W * H⁻¹) * |S_all - Y| ≤ ((R⁻¹ * W * H⁻¹) * c₄) * Y * Real.exp (-u / c_cube) := by
      calc (R⁻¹ * W * H⁻¹) * |S_all - Y| ≤ (R⁻¹ * W * H⁻¹) * (c₄ * Y * Real.exp (-u / c₄)) :=
            mul_le_mul_of_nonneg_left h8 (by positivity)
        _ ≤ (R⁻¹ * W * H⁻¹) * (c₄ * Y * Real.exp (-u / c_cube)) :=
            mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp8 (by positivity)) (by positivity)
        _ = ((R⁻¹ * W * H⁻¹) * c₄) * Y * Real.exp (-u / c_cube) := by ring
    have h_sum_le :
        c₁₀ * Y * Real.exp (-u / c_cube) +
        c₂₀ * Y * Real.exp (-u / c_cube) +
        c_sec * Y * Real.exp (-u / c_cube) +
        c_bf * Y * Real.exp (-u / c_cube) +
        (R⁻¹ * c_cp) * Y * Real.exp (-u / c_cube) +
        (R⁻¹ * c₂) * Y * Real.exp (-u / c_cube) +
        ((R⁻¹ * W) * c₃) * Y * Real.exp (-u / c_cube) +
        ((R⁻¹ * W * H⁻¹) * c₄) * Y * Real.exp (-u / c_cube) ≤
        c_cube * Y * Real.exp (-u / c_cube) := by
      have hYE_nonneg : 0 ≤ Y * Real.exp (-u / c_cube) := by positivity
      calc c₁₀ * Y * Real.exp (-u / c_cube) +
          c₂₀ * Y * Real.exp (-u / c_cube) +
          c_sec * Y * Real.exp (-u / c_cube) +
          c_bf * Y * Real.exp (-u / c_cube) +
          (R⁻¹ * c_cp) * Y * Real.exp (-u / c_cube) +
          (R⁻¹ * c₂) * Y * Real.exp (-u / c_cube) +
          ((R⁻¹ * W) * c₃) * Y * Real.exp (-u / c_cube) +
          ((R⁻¹ * W * H⁻¹) * c₄) * Y * Real.exp (-u / c_cube)
        _ = A_coarse * (Y * Real.exp (-u / c_cube)) := by dsimp [A_coarse]; ring
        _ ≤ c_cube * (Y * Real.exp (-u / c_cube)) :=
            mul_le_mul_of_nonneg_right hA_coarse_le_c hYE_nonneg
        _ = c_cube * Y * Real.exp (-u / c_cube) := by ring
    linarith
  · push_neg at hm_coarse
    have h_SQ_le : |S_Q| ≤ c_pack * δ ^ n * (Real.log X + 1) :=
      hc_pack X hX m hm hm_le_X k hQ_bdd
    have h_SB_le : |S_B| ≤ c_box * Y * (Real.log X + 1) :=
      hc_box X hX
    have h_tri : |S_Q - τ * S_B| ≤ |S_Q| + τ * |S_B| := by
      calc |S_Q - τ * S_B|
        _ ≤ |S_Q| + |τ * S_B| := abs_sub _ _
        _ = |S_Q| + τ * |S_B| := by
          rw [abs_mul, abs_of_nonneg hτ_nonneg]
    have h_τSB_le : τ * |S_B| ≤ (c_box / F) * δ ^ n * (Real.log X + 1) := by
      calc τ * |S_B|
        _ ≤ τ * (c_box * Y * (Real.log X + 1)) :=
            mul_le_mul_of_nonneg_left h_SB_le hτ_nonneg
        _ = (c_box / F) * δ ^ n * (Real.log X + 1) := by
            dsimp [τ, V_Q]
            field_simp [hF_ne, hY_ne]
    have h_sum_δ : |S_Q - τ * S_B| ≤
        (c_pack + c_box / F) * δ ^ n * (Real.log X + 1) := by
      calc |S_Q - τ * S_B|
        _ ≤ |S_Q| + τ * |S_B| := h_tri
        _ ≤ c_pack * δ ^ n * (Real.log X + 1) + (c_box / F) * δ ^ n * (Real.log X + 1) :=
            add_le_add h_SQ_le h_τSB_le
        _ = (c_pack + c_box / F) * δ ^ n * (Real.log X + 1) := by ring
    have hm_pow_ge : (m : ℝ) ≤ (m : ℝ) ^ n := by
      calc (m : ℝ) = (m : ℝ) ^ 1 := (pow_one _).symm
        _ ≤ (m : ℝ) ^ n := pow_le_pow_right₀ hmR_ge_one hn_ge_one
    have hexp_le_mn : Real.exp u ≤ (m : ℝ) ^ n :=
      le_trans (le_of_lt hm_coarse) hm_pow_ge
    have hδn_le_exp : δ ^ n ≤ Y * Real.exp (-u) := by
      dsimp [δ, Y]
      rw [div_pow, div_le_iff₀ (by positivity)]
      calc X ^ n = X ^ n * (Real.exp (-u) * Real.exp u) := by
            rw [← Real.exp_add, neg_add_cancel, Real.exp_zero, mul_one]
        _ = (X ^ n * Real.exp (-u)) * Real.exp u := by ring
        _ ≤ (X ^ n * Real.exp (-u)) * (m : ℝ) ^ n :=
            mul_le_mul_of_nonneg_left hexp_le_mn (by positivity)
    have h_log_le : Real.log X + 1 ≤ 17 * Real.exp (u / 2) := by
      have h_exp4 : u / 4 ≤ Real.exp (u / 4) := by
        have h := Real.add_one_le_exp (u / 4)
        linarith
      have h_sq4 : (u / 4) ^ 2 ≤ (Real.exp (u / 4)) ^ 2 :=
        pow_le_pow_left₀ (by positivity) h_exp4 2
      have h_exp_sq : (Real.exp (u / 4)) ^ 2 = Real.exp (u / 2) := by
        rw [sq, ← Real.exp_add]
        ring_nf
      rw [h_exp_sq] at h_sq4
      have h_u_sq : Real.log X ≤ 16 * Real.exp (u / 2) := by
        calc Real.log X = u ^ 2 := hu_sq.symm
          _ = 16 * (u / 4) ^ 2 := by ring
          _ ≤ 16 * Real.exp (u / 2) := mul_le_mul_of_nonneg_left h_sq4 (by norm_num)
      have h_one_le : 1 ≤ Real.exp (u / 2) := Real.one_le_exp (by positivity)
      linarith
    have h_prod_le : δ ^ n * (Real.log X + 1) ≤ 17 * Y * Real.exp (-u / 2) := by
      have hexp_comb : Real.exp (-u) * Real.exp (u / 2) = Real.exp (-u / 2) := by
        rw [← Real.exp_add]
        ring_nf
      calc δ ^ n * (Real.log X + 1)
        _ ≤ (Y * Real.exp (-u)) * (17 * Real.exp (u / 2)) :=
            mul_le_mul hδn_le_exp h_log_le (by positivity) (by positivity)
        _ = 17 * Y * (Real.exp (-u) * Real.exp (u / 2)) := by ring
        _ = 17 * Y * Real.exp (-u / 2) := by rw [hexp_comb]
    have hexp_fine : Real.exp (-u / 2) ≤ Real.exp (-u / c_cube) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left hu_nonneg (by norm_num) h_two_le_c
    calc |S_Q - τ * S_B|
      _ ≤ (c_pack + c_box / F) * (δ ^ n * (Real.log X + 1)) := by linarith [h_sum_δ]
      _ ≤ (c_pack + c_box / F) * (17 * Y * Real.exp (-u / 2)) :=
          mul_le_mul_of_nonneg_left h_prod_le (by positivity)
      _ = A_fine * Y * Real.exp (-u / 2) := by dsimp [A_fine]; ring
      _ ≤ A_fine * Y * Real.exp (-u / c_cube) :=
          mul_le_mul_of_nonneg_left hexp_fine (by positivity)
      _ ≤ c_cube * Y * Real.exp (-u / c_cube) := by
          have : 0 ≤ Y * Real.exp (-u / c_cube) := by positivity
          nlinarith

theorem mitsui_prime_convex_to_box {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∃ c_cb : ℝ, 0 < c_cb ∧
      ∀ X : ℝ, 1 < X →
        ∀ C : Set (NumberField.mixedEmbedding.mixedSpace K), Convex ℝ C → IsOpen C →
          (∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
              NumberField.mixedEmbedding.normAtPlace w z < X) →
          |(∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
            - ((MeasureTheory.volume C).toReal /
                ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) *
                  X ^ (Module.finrank ℚ K))) *
              (∑' π : {π : NumberField.RingOfIntegers K //
                    Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
                  Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))|
            ≤ c_cb * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cb) :=
by
  obtain ⟨c_box, hc_box_pos, hc_box⟩ := mitsui_prime_box_upper_bound (K := K)
  obtain ⟨c_pack, hc_pack_pos, hc_pack⟩ := mitsui_prime_grid_partition_diff_le_boundary (K := K)
  obtain ⟨c_cube, hc_cube_pos, hc_cube⟩ := mitsui_prime_grid_cube_equidist (K := K)
  set n : ℕ := Module.finrank ℚ K
  set F : ℝ := (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
  have hn_pos : 0 < n := Module.finrank_pos
  have hn_ge_one : 1 ≤ n := hn_pos
  have hnR_pos : (0 : ℝ) < (n : ℝ) := Nat.cast_pos.mpr hn_pos
  have hnR_ge_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn_ge_one
  have hF_ge_one : 1 ≤ F := by
    change (1 : ℝ) ≤ (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
    exact_mod_cast NumberField.mixedEmbedding.one_le_convexBodyLTFactor K
  have hF_pos : 0 < F := lt_of_lt_of_le zero_lt_one hF_ge_one
  let c' : ℝ := min (1 / 2) (1 / (2 * (n : ℝ) * c_cube))
  have hc'_pos : 0 < c' := lt_min (by norm_num) (by positivity)
  have hc'_le_half : c' ≤ 1 / 2 := min_le_left _ _
  have hc'_le_cube : c' ≤ 1 / (2 * (n : ℝ) * c_cube) := min_le_right _ _
  let A_bdry : ℝ := 2 * (c_pack + c_box / F) * (2 : ℝ) ^ (3 * n) * (16 / c' ^ 2 + 1)
  have hA_bdry_pos : 0 < A_bdry := by dsimp [A_bdry]; positivity
  let A_int : ℝ := (2 : ℝ) ^ n * c_cube
  have hA_int_pos : 0 < A_int := by dsimp [A_int]; positivity
  let c_cb : ℝ := max (2 / c') (A_bdry + A_int)
  have hc_cb_pos : 0 < c_cb := lt_of_lt_of_le (by positivity) (le_max_left _ _)
  refine ⟨c_cb, hc_cb_pos, ?_⟩
  intro X hX C hC_conv hC_open hC_bdd
  have hX_pos : 0 < X := by linarith
  have hYn_pos : 0 < X ^ n := by positivity
  have hlogX_pos : 0 < Real.log X := Real.log_pos hX
  set u : ℝ := Real.sqrt (Real.log X)
  have hu_pos : 0 < u := Real.sqrt_pos.mpr hlogX_pos
  have hu_nonneg : 0 ≤ u := le_of_lt hu_pos
  have hu_sq : u ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlogX_pos)
  set m : ℕ := ⌊Real.exp (c' * u)⌋₊
  have hcu_pos : 0 < c' * u := mul_pos hc'_pos hu_pos
  have hexp_gt_one : 1 < Real.exp (c' * u) := Real.one_lt_exp_iff.mpr hcu_pos
  have hm_ge_one : 1 ≤ m := Nat.floor_pos.mpr (le_of_lt hexp_gt_one)
  have hmR_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm_ge_one
  have hmR_pos : (0 : ℝ) < (m : ℝ) := lt_of_lt_of_le zero_lt_one hmR_ge_one
  have hmR_ne : (m : ℝ) ≠ 0 := ne_of_gt hmR_pos
  have hm_le_exp : (m : ℝ) ≤ Real.exp (c' * u) := Nat.floor_le (Real.exp_nonneg _)
  have hexp_lt_m1 : Real.exp (c' * u) < (m : ℝ) + 1 := Nat.lt_floor_add_one _
  have hexp_le_2m : Real.exp (c' * u) ≤ 2 * (m : ℝ) := by linarith
  have h_minv_le : (m : ℝ)⁻¹ ≤ 2 * Real.exp (-c' * u) := by
    rw [inv_eq_one_div, div_le_iff₀ hmR_pos]
    calc (1 : ℝ) = Real.exp (c' * u) * Real.exp (-c' * u) := by
          rw [← Real.exp_add, neg_mul, add_neg_cancel, Real.exp_zero]
      _ ≤ (2 * (m : ℝ)) * Real.exp (-c' * u) :=
          mul_le_mul_of_nonneg_right hexp_le_2m (Real.exp_nonneg _)
      _ = 2 * Real.exp (-c' * u) * (m : ℝ) := by ring
  have hm_le_X : (m : ℝ) ≤ X := by
    rcases lt_or_ge u 1 with hu_lt | hu_ge
    · have hcu_lt : c' * u < Real.log 2 := by
        have h1 : c' * u < (1 / 2 : ℝ) * 1 := by
          calc c' * u ≤ (1 / 2) * u := mul_le_mul_of_nonneg_right hc'_le_half hu_nonneg
            _ < (1 / 2) * 1 := mul_lt_mul_of_pos_left hu_lt (by norm_num)
        have h2 := Real.log_two_gt_d9
        linarith
      have hexp_lt_two : Real.exp (c' * u) < 2 := by
        calc Real.exp (c' * u) < Real.exp (Real.log 2) := Real.exp_lt_exp.mpr hcu_lt
          _ = 2 := Real.exp_log (by norm_num)
      have hm_lt_two : m < 2 := (Nat.floor_lt (Real.exp_nonneg _)).mpr hexp_lt_two
      have hm_eq_one : m = 1 := by omega
      rw [hm_eq_one, Nat.cast_one]
      exact le_of_lt hX
    · have hcu_le_log : c' * u ≤ Real.log X := by
        calc c' * u ≤ (1 / 2) * u := mul_le_mul_of_nonneg_right hc'_le_half hu_nonneg
          _ ≤ 1 * u := by linarith
          _ = u * 1 := by ring
          _ ≤ u * u := mul_le_mul_of_nonneg_left hu_ge hu_nonneg
          _ = u ^ 2 := by ring
          _ = Real.log X := hu_sq
      calc (m : ℝ) ≤ Real.exp (c' * u) := hm_le_exp
        _ ≤ Real.exp (Real.log X) := Real.exp_le_exp.mpr hcu_le_log
        _ = X := Real.exp_log hX_pos
  have h1 := mitsui_convex_grid_boundary_card_bound X hX m hm_ge_one C hC_conv hC_open
  have h2 := hc_box X hX
  have h3 := hc_pack X hX m hm_ge_one hm_le_X C hC_bdd
  have h4 := mitsui_volume_grid_partition_diff_le_boundary X hX m hm_ge_one C hC_open hC_bdd
  set Q : (NumberField.mixedEmbedding.index K → Fin (2 * m)) →
      Set (NumberField.mixedEmbedding.mixedSpace K) :=
    fun k => {z : NumberField.mixedEmbedding.mixedSpace K |
      ∀ i : NumberField.mixedEmbedding.index K,
        (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
          Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
            ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))}
  set S_C : ℝ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C},
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  set S_B : ℝ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  set V : ℝ := (MeasureTheory.volume C).toReal
  set S_Q : (NumberField.mixedEmbedding.index K → Fin (2 * m)) → ℝ :=
    fun k => ∑' π : {π : NumberField.RingOfIntegers K //
        Prime π ∧
        ∀ i : NumberField.mixedEmbedding.index K,
          (NumberField.mixedEmbedding.stdBasis K).repr
              (NumberField.mixedEmbedding K (π : K)) i ∈
            Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))},
      Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  set S_grid : ℝ := ∑' k : {k : NumberField.mixedEmbedding.index K → Fin (2 * m) // Q k ⊆ C},
    S_Q k.1
  set V_grid : ℝ := ∑' k : {k : NumberField.mixedEmbedding.index K → Fin (2 * m) // Q k ⊆ C},
    (X / (m : ℝ)) ^ n
  set B_card : ℝ := (Nat.card {k : NumberField.mixedEmbedding.index K → Fin (2 * m) //
    (Q k ∩ C).Nonempty ∧ ¬ (Q k ⊆ C)} : ℝ)
  have h1' : B_card ≤ (2 : ℝ) ^ (3 * n) * (m : ℝ) ^ (n - 1) := h1
  have h2' : |S_B| ≤ c_box * X ^ n * (Real.log X + 1) := h2
  have h3' : |S_C - S_grid| ≤ c_pack * B_card * (X / (m : ℝ)) ^ n * (Real.log X + 1) := h3
  have h4' : |V - V_grid| ≤ B_card * (X / (m : ℝ)) ^ n := h4
  have h_pow_cancel : (m : ℝ) ^ (n - 1) * (X / (m : ℝ)) ^ n = X ^ n * (m : ℝ)⁻¹ := by
    have hm_pow : (m : ℝ) ^ n = (m : ℝ) ^ (n - 1) * (m : ℝ) := by
      rw [← pow_succ, Nat.sub_add_cancel hn_ge_one]
    rw [div_pow, hm_pow]
    field_simp [hmR_ne]
  have h_bdry_vol : B_card * (X / (m : ℝ)) ^ n ≤ (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ := by
    calc B_card * (X / (m : ℝ)) ^ n
      _ ≤ ((2 : ℝ) ^ (3 * n) * (m : ℝ) ^ (n - 1)) * (X / (m : ℝ)) ^ n :=
          mul_le_mul_of_nonneg_right h1' (by positivity)
      _ = (2 : ℝ) ^ (3 * n) * ((m : ℝ) ^ (n - 1) * (X / (m : ℝ)) ^ n) := by ring
      _ = (2 : ℝ) ^ (3 * n) * (X ^ n * (m : ℝ)⁻¹) := by rw [h_pow_cancel]
      _ = (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ := by ring
  have h_bdry1 : |S_C - S_grid| ≤
      c_pack * (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ * (Real.log X + 1) := by
    calc |S_C - S_grid| ≤ c_pack * (B_card * (X / (m : ℝ)) ^ n) * (Real.log X + 1) := by
          linarith [h3']
      _ ≤ c_pack * ((2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹) * (Real.log X + 1) := by
          gcongr
      _ = c_pack * (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ * (Real.log X + 1) := by ring
  have h_bdry2 : |(V_grid - V) / (F * X ^ n) * S_B| ≤
      (c_box / F) * (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ * (Real.log X + 1) := by
    have hFX_pos : 0 < F * X ^ n := by positivity
    have hFX_ne : F * X ^ n ≠ 0 := ne_of_gt hFX_pos
    have hF_ne : F ≠ 0 := ne_of_gt hF_pos
    have hYn_ne : X ^ n ≠ 0 := ne_of_gt hYn_pos
    rw [abs_mul, abs_div, abs_sub_comm, abs_of_pos hFX_pos]
    have h_div_le : |V - V_grid| / (F * X ^ n) ≤
        ((2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹) / (F * X ^ n) :=
      div_le_div_of_nonneg_right (le_trans h4' h_bdry_vol) (le_of_lt hFX_pos)
    calc (|V - V_grid| / (F * X ^ n)) * |S_B|
      _ ≤ (((2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹) / (F * X ^ n)) *
            (c_box * X ^ n * (Real.log X + 1)) :=
          mul_le_mul h_div_le h2' (abs_nonneg _) (by positivity)
      _ = (c_box / F) * (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ * (Real.log X + 1) := by
          field_simp [hF_ne, hYn_ne]
  have h_log_le : Real.log X + 1 ≤ (16 / c' ^ 2 + 1) * Real.exp (c' * u / 2) := by
    have h_exp4 : c' * u / 4 ≤ Real.exp (c' * u / 4) := by
      have h := Real.add_one_le_exp (c' * u / 4)
      linarith
    have h_sq4 : (c' * u / 4) ^ 2 ≤ (Real.exp (c' * u / 4)) ^ 2 :=
      pow_le_pow_left₀ (by positivity) h_exp4 2
    have h_exp_sq : (Real.exp (c' * u / 4)) ^ 2 = Real.exp (c' * u / 2) := by
      rw [sq, ← Real.exp_add]
      ring_nf
    rw [h_exp_sq] at h_sq4
    have hc'_sq_pos : 0 < c' ^ 2 := by positivity
    have h_u_sq_le : Real.log X ≤ (16 / c' ^ 2) * Real.exp (c' * u / 2) := by
      rw [← hu_sq, div_mul_eq_mul_div, le_div_iff₀ hc'_sq_pos]
      calc u ^ 2 * c' ^ 2 = 16 * (c' * u / 4) ^ 2 := by ring
        _ ≤ 16 * Real.exp (c' * u / 2) := mul_le_mul_of_nonneg_left h_sq4 (by norm_num)
    have h_one_le : 1 ≤ Real.exp (c' * u / 2) :=
      Real.one_le_exp (by positivity)
    linarith
  have h_minv_log : (m : ℝ)⁻¹ * (Real.log X + 1) ≤
      2 * (16 / c' ^ 2 + 1) * Real.exp (-u / c_cb) := by
    have hexp_prod : Real.exp (-c' * u) * Real.exp (c' * u / 2) = Real.exp (-c' * u / 2) := by
      rw [← Real.exp_add]
      ring_nf
    have h_exp_cb : Real.exp (-c' * u / 2) ≤ Real.exp (-u / c_cb) := by
      rw [Real.exp_le_exp]
      have h_cb_ge : 2 / c' ≤ c_cb := le_max_left _ _
      have h_div_le : u / c_cb ≤ u / (2 / c') :=
        div_le_div_of_nonneg_left hu_nonneg (by positivity) h_cb_ge
      have hc'_ne : c' ≠ 0 := ne_of_gt hc'_pos
      have h_eq : u / (2 / c') = c' * u / 2 := by field_simp [hc'_ne]
      have h_neg1 : -c' * u / 2 = -(c' * u / 2) := by ring
      have h_neg2 : -u / c_cb = -(u / c_cb) := by ring
      linarith
    calc (m : ℝ)⁻¹ * (Real.log X + 1)
      _ ≤ (2 * Real.exp (-c' * u)) * ((16 / c' ^ 2 + 1) * Real.exp (c' * u / 2)) :=
          mul_le_mul h_minv_le h_log_le (by positivity) (by positivity)
      _ = 2 * (16 / c' ^ 2 + 1) * (Real.exp (-c' * u) * Real.exp (c' * u / 2)) := by ring
      _ = 2 * (16 / c' ^ 2 + 1) * Real.exp (-c' * u / 2) := by rw [hexp_prod]
      _ ≤ 2 * (16 / c' ^ 2 + 1) * Real.exp (-u / c_cb) :=
          mul_le_mul_of_nonneg_left h_exp_cb (by positivity)
  have h_bdry_sum : |S_C - S_grid| + |(V_grid - V) / (F * X ^ n) * S_B| ≤
      A_bdry * X ^ n * Real.exp (-u / c_cb) := by
    calc |S_C - S_grid| + |(V_grid - V) / (F * X ^ n) * S_B|
      _ ≤ c_pack * (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ * (Real.log X + 1) +
            (c_box / F) * (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ * (Real.log X + 1) :=
          add_le_add h_bdry1 h_bdry2
      _ = (c_pack + c_box / F) * (2 : ℝ) ^ (3 * n) * X ^ n * ((m : ℝ)⁻¹ * (Real.log X + 1)) := by
          ring
      _ ≤ (c_pack + c_box / F) * (2 : ℝ) ^ (3 * n) * X ^ n *
            (2 * (16 / c' ^ 2 + 1) * Real.exp (-u / c_cb)) :=
          mul_le_mul_of_nonneg_left h_minv_log (by positivity)
      _ = A_bdry * X ^ n * Real.exp (-u / c_cb) := by
          dsimp [A_bdry]
          ring
  have h_int : |S_grid - (V_grid / (F * X ^ n)) * S_B| ≤
      A_int * X ^ n * Real.exp (-u / c_cb) := by
    classical
    set I_sub := {k : NumberField.mixedEmbedding.index K → Fin (2 * m) // Q k ⊆ C}
    have hS_grid_eq : S_grid = ∑ k : I_sub, S_Q k.1 := tsum_fintype _
    have hV_grid_eq : V_grid = ∑ k : I_sub, (X / (m : ℝ)) ^ n := tsum_fintype _
    have h_diff_sum : S_grid - (V_grid / (F * X ^ n)) * S_B =
        ∑ k : I_sub, (S_Q k.1 - ((X / (m : ℝ)) ^ n / (F * X ^ n)) * S_B) := by
      rw [hS_grid_eq, hV_grid_eq, Finset.sum_sub_distrib, Finset.sum_div, Finset.sum_mul]
    have h_term_le : ∀ k ∈ (Finset.univ : Finset I_sub),
        |S_Q k.1 - ((X / (m : ℝ)) ^ n / (F * X ^ n)) * S_B| ≤
          c_cube * X ^ n * Real.exp (-u / c_cube) := by
      intro k _
      exact hc_cube X hX m hm_ge_one hm_le_X k.1 (fun z hz w => hC_bdd z (k.2 hz) w)
    have h_abs_sum : |S_grid - (V_grid / (F * X ^ n)) * S_B| ≤
        (Fintype.card I_sub : ℝ) * (c_cube * X ^ n * Real.exp (-u / c_cube)) := by
      rw [h_diff_sum]
      calc |∑ k : I_sub, (S_Q k.1 - ((X / (m : ℝ)) ^ n / (F * X ^ n)) * S_B)|
        _ ≤ ∑ k : I_sub, |S_Q k.1 - ((X / (m : ℝ)) ^ n / (F * X ^ n)) * S_B| :=
            Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ _k : I_sub, (c_cube * X ^ n * Real.exp (-u / c_cube)) :=
            Finset.sum_le_sum h_term_le
        _ = (Fintype.card I_sub : ℝ) * (c_cube * X ^ n * Real.exp (-u / c_cube)) := by
            simp
    have hcard_idx : Fintype.card (NumberField.mixedEmbedding.index K) = n := by
      rw [← Module.finrank_eq_card_basis (NumberField.mixedEmbedding.stdBasis K),
          NumberField.mixedEmbedding.finrank K]
    have hcard_le : Fintype.card I_sub ≤ (2 * m) ^ n := by
      calc Fintype.card I_sub
        _ ≤ Fintype.card (NumberField.mixedEmbedding.index K → Fin (2 * m)) :=
            Fintype.card_subtype_le _
        _ = (2 * m) ^ n := by
            rw [Fintype.card_fun, Fintype.card_fin, hcard_idx]
    have hcardR_le : (Fintype.card I_sub : ℝ) ≤ (2 : ℝ) ^ n * Real.exp ((n : ℝ) * (c' * u)) := by
      calc (Fintype.card I_sub : ℝ)
        _ ≤ ((2 * m : ℕ) : ℝ) ^ n := by exact_mod_cast hcard_le
        _ = (2 : ℝ) ^ n * (m : ℝ) ^ n := by push_cast; rw [mul_pow]
        _ ≤ (2 : ℝ) ^ n * (Real.exp (c' * u)) ^ n :=
            mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) hm_le_exp n) (by positivity)
        _ = (2 : ℝ) ^ n * Real.exp ((n : ℝ) * (c' * u)) := by
            rw [← Real.exp_nat_mul]
    have h_exp_int : Real.exp ((n : ℝ) * (c' * u)) * Real.exp (-u / c_cube) ≤
        Real.exp (-u / c_cb) := by
      rw [← Real.exp_add, Real.exp_le_exp]
      have h_nc' : (n : ℝ) * c' ≤ 1 / (2 * c_cube) := by
        calc (n : ℝ) * c' ≤ (n : ℝ) * (1 / (2 * (n : ℝ) * c_cube)) :=
              mul_le_mul_of_nonneg_left hc'_le_cube (by positivity)
          _ = 1 / (2 * c_cube) := by
              have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hnR_pos
              field_simp [hn_ne]
      have h_nc'u : (n : ℝ) * (c' * u) ≤ u / (2 * c_cube) := by
        calc (n : ℝ) * (c' * u) = ((n : ℝ) * c') * u := by ring
          _ ≤ (1 / (2 * c_cube)) * u := mul_le_mul_of_nonneg_right h_nc' hu_nonneg
          _ = u / (2 * c_cube) := by ring
      have h_cb_ge : 2 * c_cube ≤ c_cb := by
        have h1 : 2 * c_cube ≤ 2 * (n : ℝ) * c_cube := by
          calc 2 * c_cube = 2 * 1 * c_cube := by ring
            _ ≤ 2 * (n : ℝ) * c_cube := by gcongr
        have h2 : 2 * (n : ℝ) * c_cube ≤ 2 / c' := by
          rw [le_div_iff₀ hc'_pos]
          have h3 : 2 * (n : ℝ) * c_cube * c' ≤ 2 * (n : ℝ) * c_cube * (1 / (2 * (n : ℝ) * c_cube)) :=
            mul_le_mul_of_nonneg_left hc'_le_cube (by positivity)
          have h4 : 2 * (n : ℝ) * c_cube * (1 / (2 * (n : ℝ) * c_cube)) = 1 := by
            have h_ne : 2 * (n : ℝ) * c_cube ≠ 0 := by positivity
            field_simp [h_ne]
          linarith
        exact le_trans (le_trans h1 h2) (le_max_left _ _)
      have h_div_cb : u / c_cb ≤ u / (2 * c_cube) :=
        div_le_div_of_nonneg_left hu_nonneg (by positivity) h_cb_ge
      have h_sub_eq : u / (2 * c_cube) + -u / c_cube = -(u / (2 * c_cube)) := by ring
      have h_neg_cb : -u / c_cb = -(u / c_cb) := by ring
      linarith
    calc |S_grid - (V_grid / (F * X ^ n)) * S_B|
      _ ≤ (Fintype.card I_sub : ℝ) * (c_cube * X ^ n * Real.exp (-u / c_cube)) := h_abs_sum
      _ ≤ ((2 : ℝ) ^ n * Real.exp ((n : ℝ) * (c' * u))) *
            (c_cube * X ^ n * Real.exp (-u / c_cube)) :=
          mul_le_mul_of_nonneg_right hcardR_le (by positivity)
      _ = A_int * X ^ n * (Real.exp ((n : ℝ) * (c' * u)) * Real.exp (-u / c_cube)) := by
          dsimp [A_int]; ring
      _ ≤ A_int * X ^ n * Real.exp (-u / c_cb) :=
          mul_le_mul_of_nonneg_left h_exp_int (by positivity)
  have h_ident : S_C - (V / (F * X ^ n)) * S_B =
      (S_C - S_grid) + (S_grid - (V_grid / (F * X ^ n)) * S_B) +
        ((V_grid - V) / (F * X ^ n)) * S_B := by
    ring
  have h_tri : |S_C - (V / (F * X ^ n)) * S_B| ≤
      |S_C - S_grid| + |S_grid - (V_grid / (F * X ^ n)) * S_B| +
        |((V_grid - V) / (F * X ^ n)) * S_B| := by
    rw [h_ident]
    have ht1 := abs_add_le
      ((S_C - S_grid) + (S_grid - (V_grid / (F * X ^ n)) * S_B))
      (((V_grid - V) / (F * X ^ n)) * S_B)
    have ht2 := abs_add_le
      (S_C - S_grid)
      (S_grid - (V_grid / (F * X ^ n)) * S_B)
    linarith
  have h_A_le : A_bdry + A_int ≤ c_cb := le_max_right _ _
  calc |S_C - (V / (F * X ^ n)) * S_B|
    _ ≤ (|S_C - S_grid| + |((V_grid - V) / (F * X ^ n)) * S_B|) +
          |S_grid - (V_grid / (F * X ^ n)) * S_B| := by linarith
    _ ≤ A_bdry * X ^ n * Real.exp (-u / c_cb) + A_int * X ^ n * Real.exp (-u / c_cb) :=
        add_le_add h_bdry_sum h_int
    _ = (A_bdry + A_int) * (X ^ n * Real.exp (-u / c_cb)) := by ring
    _ ≤ c_cb * (X ^ n * Real.exp (-u / c_cb)) :=
        mul_le_mul_of_nonneg_right h_A_le (by positivity)
    _ = c_cb * X ^ n * Real.exp (-u / c_cb) := by ring

theorem mitsui_vonMangoldt_convex_to_fundamentalCone {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∃ c₁ : ℝ, 0 < c₁ ∧
      ∀ X : ℝ, 1 < X →
        ∀ C : Set (NumberField.mixedEmbedding.mixedSpace K), Convex ℝ C → IsOpen C →
          (∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
              NumberField.mixedEmbedding.normAtPlace w z < X) →
          |(∑' x : {x : NumberField.RingOfIntegers K //
                NumberField.mixedEmbedding K (x : K) ∈ C},
              vonMangoldtO (x : NumberField.RingOfIntegers K))
            - ((MeasureTheory.volume C).toReal /
                ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) *
                  NumberField.Units.regulator K *
                  X ^ (Module.finrank ℚ K))) *
              (∑' x : {x : NumberField.RingOfIntegers K //
                  NumberField.mixedEmbedding K (x : K) ∈
                    NumberField.mixedEmbedding.fundamentalCone K ∧
                  NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤
                    X ^ (Module.finrank ℚ K)},
                vonMangoldtO (x : NumberField.RingOfIntegers K))|
            ≤ c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁) :=
by
  obtain ⟨c_pv, hc_pv_pos, hc_pv⟩ := mitsui_prime_to_vonMangoldt_unconditioned (K := K)
  obtain ⟨c_cb, hc_cb_pos, hc_cb⟩ := mitsui_prime_convex_to_box (K := K)
  obtain ⟨c_bf, hc_bf_pos, hc_bf⟩ := mitsui_prime_box_to_fundamentalCone (K := K)
  obtain ⟨c_cp, hc_cp_pos, hc_cp⟩ := mitsui_vonMangoldt_cone_to_prime (K := K)
  set F : ℝ := (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
  set R : ℝ := NumberField.Units.regulator K
  have hF_pos : 0 < F := by
    change (0 : ℝ) < (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
    have h1 := NumberField.mixedEmbedding.one_le_convexBodyLTFactor K
    exact_mod_cast lt_of_lt_of_le zero_lt_one h1
  have hR_pos : 0 < R := NumberField.Units.regulator_pos K
  let c₁ : ℝ := c_pv + c_cb + c_bf + c_cp + R⁻¹ * c_cp
  have hc₁_pos : 0 < c₁ := by
    dsimp [c₁]
    positivity
  refine ⟨c₁, hc₁_pos, ?_⟩
  intro X hX C hC_conv hC_open hC_bdd
  
  have hX0 : 0 ≤ X := by linarith
  let f : NumberField.InfinitePlace K → NNReal := fun _ => ⟨X, hX0⟩
  have hC_sub : C ⊆ NumberField.mixedEmbedding.convexBodyLT K f := by
    intro z hz
    rw [NumberField.mixedEmbedding.convexBodyLT, Set.mem_prod, Set.mem_univ_pi, Set.mem_univ_pi]
    refine ⟨fun w => ?_, fun w => ?_⟩
    · rw [Metric.mem_ball, dist_zero_right, ← NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2]
      exact hC_bdd z hz w.1
    · rw [Metric.mem_ball, dist_zero_right, ← NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex w.2]
      exact hC_bdd z hz w.1
  have hvol_le : MeasureTheory.volume C ≤
      MeasureTheory.volume (NumberField.mixedEmbedding.convexBodyLT K f) :=
    MeasureTheory.measure_mono hC_sub
  have hvol_eq : MeasureTheory.volume (NumberField.mixedEmbedding.convexBodyLT K f) =
      ↑(NumberField.mixedEmbedding.convexBodyLTFactor K) * ↑(∏ w, f w ^ w.mult) := by
    convert NumberField.mixedEmbedding.convexBodyLT_volume K f
  rw [hvol_eq] at hvol_le
  have hprod : (∏ w : NumberField.InfinitePlace K, f w ^ w.mult) =
      ⟨X, hX0⟩ ^ (Module.finrank ℚ K) := by
    dsimp [f]
    rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq]
  rw [hprod] at hvol_le
  have hne_top : (↑(NumberField.mixedEmbedding.convexBodyLTFactor K) *
      ↑(⟨X, hX0⟩ ^ (Module.finrank ℚ K) : NNReal) : ENNReal) ≠ ⊤ :=
    ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.coe_ne_top
  have hV_le : (MeasureTheory.volume C).toReal ≤ F * X ^ (Module.finrank ℚ K) := by
    have htoReal := ENNReal.toReal_mono hne_top hvol_le
    rw [ENNReal.toReal_mul, ENNReal.coe_toReal, ENNReal.coe_toReal, NNReal.coe_pow, NNReal.coe_mk] at htoReal
    exact htoReal
  
  set Y : ℝ := X ^ (Module.finrank ℚ K)
  set V : ℝ := (MeasureTheory.volume C).toReal
  have hX_pos : 0 < X := by linarith
  have hY_pos : 0 < Y := by dsimp [Y]; positivity
  have hV_nonneg : 0 ≤ V := ENNReal.toReal_nonneg
  set τ : ℝ := V / (F * Y)
  set ρ : ℝ := V / (F * R * Y)
  have hτ_nonneg : 0 ≤ τ := by dsimp [τ]; positivity
  have hτ_le_one : τ ≤ 1 := by
    dsimp [τ]
    exact div_le_one_of_le₀ hV_le (by positivity)
  have hρ_nonneg : 0 ≤ ρ := by dsimp [ρ]; positivity
  have hρ_le : ρ ≤ R⁻¹ := by
    dsimp [ρ]
    rw [div_le_iff₀ (by positivity)]
    have h1 : R⁻¹ * (F * R * Y) = F * Y := by
      have hR_ne : R ≠ 0 := ne_of_gt hR_pos
      field_simp [hR_ne]
    rw [h1]
    exact hV_le
  have h1 := hc_pv X hX C hC_conv hC_open hC_bdd
  have h2 := hc_cb X hX C hC_conv hC_open hC_bdd
  have h3 := hc_bf X hX
  have h4 := hc_cp X hX
  set S₁ : ℝ := ∑' x : {x : NumberField.RingOfIntegers K //
      NumberField.mixedEmbedding K (x : K) ∈ C},
    vonMangoldtO (x : NumberField.RingOfIntegers K)
  set S₂ : ℝ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C},
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  set S₃ : ℝ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  set S₄ : ℝ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      NumberField.mixedEmbedding K (π : K) ∈
        NumberField.mixedEmbedding.fundamentalCone K ∧
      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤ Y},
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  set S₅ : ℝ := ∑' x : {x : NumberField.RingOfIntegers K //
      NumberField.mixedEmbedding K (x : K) ∈
        NumberField.mixedEmbedding.fundamentalCone K ∧
      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤ Y},
    vonMangoldtO (x : NumberField.RingOfIntegers K)
  have h_ident : S₁ - ρ * S₅ =
      -(S₂ - S₁) + (S₂ - τ * S₃) + τ * (S₃ - R⁻¹ * S₄) + (-ρ) * (S₅ - S₄) := by
    dsimp [ρ, τ]
    ring
  have h_tri : |S₁ - ρ * S₅| ≤
      |S₂ - S₁| + |S₂ - τ * S₃| + |S₃ - R⁻¹ * S₄| + R⁻¹ * |S₅ - S₄| := by
    rw [h_ident]
    have ht1 := abs_add_le
      (-(S₂ - S₁) + (S₂ - τ * S₃) + τ * (S₃ - R⁻¹ * S₄))
      ((-ρ) * (S₅ - S₄))
    have ht2 := abs_add_le
      (-(S₂ - S₁) + (S₂ - τ * S₃))
      (τ * (S₃ - R⁻¹ * S₄))
    have ht3 := abs_add_le
      (-(S₂ - S₁))
      (S₂ - τ * S₃)
    have hm1 : |-(S₂ - S₁)| = |S₂ - S₁| := abs_neg _
    have hm3 : |τ * (S₃ - R⁻¹ * S₄)| ≤ |S₃ - R⁻¹ * S₄| := by
      rw [abs_mul, abs_of_nonneg hτ_nonneg]
      exact mul_le_of_le_one_left (abs_nonneg _) hτ_le_one
    have hm4 : |(-ρ) * (S₅ - S₄)| ≤ R⁻¹ * |S₅ - S₄| := by
      rw [abs_mul, abs_neg, abs_of_nonneg hρ_nonneg]
      exact mul_le_mul_of_nonneg_right hρ_le (abs_nonneg _)
    linarith
  have hsqrt_nonneg : 0 ≤ Real.sqrt (Real.log X) := Real.sqrt_nonneg _
  have hc_pv_le : c_pv ≤ c₁ := by
    have : 0 ≤ c_cb + c_bf + c_cp + R⁻¹ * c_cp := by positivity
    dsimp [c₁]; linarith
  have hc_cb_le : c_cb ≤ c₁ := by
    have : 0 ≤ c_pv + c_bf + c_cp + R⁻¹ * c_cp := by positivity
    dsimp [c₁]; linarith
  have hc_bf_le : c_bf ≤ c₁ := by
    have : 0 ≤ c_pv + c_cb + c_cp + R⁻¹ * c_cp := by positivity
    dsimp [c₁]; linarith
  have hc_cp_le : c_cp ≤ c₁ := by
    have : 0 ≤ c_pv + c_cb + c_bf + R⁻¹ * c_cp := by positivity
    dsimp [c₁]; linarith
  have hexp1 : Real.exp (-Real.sqrt (Real.log X) / c_pv) ≤ Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc_pv_pos hc_pv_le
  have hexp2 : Real.exp (-Real.sqrt (Real.log X) / c_cb) ≤ Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc_cb_pos hc_cb_le
  have hexp3 : Real.exp (-Real.sqrt (Real.log X) / c_bf) ≤ Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc_bf_pos hc_bf_le
  have hexp4 : Real.exp (-Real.sqrt (Real.log X) / c_cp) ≤ Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc_cp_pos hc_cp_le
  have hterm1 : |S₂ - S₁| ≤ c_pv * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    calc |S₂ - S₁| ≤ c_pv * Y * Real.exp (-Real.sqrt (Real.log X) / c_pv) := h1
      _ ≤ c_pv * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) :=
        mul_le_mul_of_nonneg_left hexp1 (by positivity)
  have hterm2 : |S₂ - τ * S₃| ≤ c_cb * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    calc |S₂ - τ * S₃| ≤ c_cb * Y * Real.exp (-Real.sqrt (Real.log X) / c_cb) := h2
      _ ≤ c_cb * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) :=
        mul_le_mul_of_nonneg_left hexp2 (by positivity)
  have hterm3 : |S₃ - R⁻¹ * S₄| ≤ c_bf * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    calc |S₃ - R⁻¹ * S₄| ≤ c_bf * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) := h3
      _ ≤ c_bf * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) :=
        mul_le_mul_of_nonneg_left hexp3 (by positivity)
  have hterm4 : R⁻¹ * |S₅ - S₄| ≤ (R⁻¹ * c_cp) * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    calc R⁻¹ * |S₅ - S₄| ≤ R⁻¹ * (c_cp * Y * Real.exp (-Real.sqrt (Real.log X) / c_cp)) :=
          mul_le_mul_of_nonneg_left h4 (by positivity)
      _ ≤ R⁻¹ * (c_cp * Y * Real.exp (-Real.sqrt (Real.log X) / c₁)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp4 (by positivity)) (by positivity)
      _ = (R⁻¹ * c_cp) * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := by ring
  have h_sum_le :
      c_pv * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) +
      c_cb * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) +
      c_bf * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) +
      (R⁻¹ * c_cp) * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) ≤
      c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    have h_coeff : c_pv + c_cb + c_bf + R⁻¹ * c_cp ≤ c₁ := by
      have : 0 ≤ c_cp := by positivity
      dsimp [c₁]; linarith
    have hYE_nonneg : 0 ≤ Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := by positivity
    calc c_pv * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) +
        c_cb * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) +
        c_bf * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) +
        (R⁻¹ * c_cp) * Y * Real.exp (-Real.sqrt (Real.log X) / c₁)
      _ = (c_pv + c_cb + c_bf + R⁻¹ * c_cp) * (Y * Real.exp (-Real.sqrt (Real.log X) / c₁)) := by ring
      _ ≤ c₁ * (Y * Real.exp (-Real.sqrt (Real.log X) / c₁)) := mul_le_mul_of_nonneg_right h_coeff hYE_nonneg
      _ = c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := by ring
  linarith

theorem mitsui_vonMangoldt_unconditioned {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∃ c₄ : ℝ, 0 < c₄ ∧
      ∀ X : ℝ, 1 < X →
        ∀ C : Set (NumberField.mixedEmbedding.mixedSpace K), Convex ℝ C → IsOpen C →
          (∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
              NumberField.mixedEmbedding.normAtPlace w z < X) →
          |(∑' x : {x : NumberField.RingOfIntegers K //
                NumberField.mixedEmbedding K (x : K) ∈ C},
              vonMangoldtO (x : NumberField.RingOfIntegers K))
            - ((NumberField.Units.torsionOrder K : ℝ) /
                ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) *
                  (NumberField.classNumber K : ℝ) *
                  NumberField.Units.regulator K)) *
              (MeasureTheory.volume C).toReal|
            ≤ c₄ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₄) :=
by
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_vonMangoldt_convex_to_fundamentalCone (K := K)
  obtain ⟨c₂, hc₂_pos, hc₂⟩ := mitsui_vonMangoldt_cone_to_principalPrimeIdeals (K := K)
  obtain ⟨c₃, hc₃_pos, hc₃⟩ := mitsui_chebyshev_principal_to_all_primeIdeals (K := K)
  obtain ⟨c₀, hc₀_pos, hc₀⟩ := mitsui_chebyshev_primeIdeals_asymptotic (K := K)
  set W : ℝ := (NumberField.Units.torsionOrder K : ℝ)
  set F : ℝ := (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
  set H : ℝ := (NumberField.classNumber K : ℝ)
  set R : ℝ := NumberField.Units.regulator K
  have hW_pos : 0 < W := by
    change (0 : ℝ) < (NumberField.Units.torsionOrder K : ℝ)
    exact_mod_cast NumberField.Units.torsionOrder_pos K
  have hF_pos : 0 < F := by
    change (0 : ℝ) < (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
    have h1 := NumberField.mixedEmbedding.one_le_convexBodyLTFactor K
    exact_mod_cast lt_of_lt_of_le zero_lt_one h1
  have hH_pos : 0 < H := by
    change (0 : ℝ) < (NumberField.classNumber K : ℝ)
    exact_mod_cast NumberField.classNumber_pos K
  have hR_pos : 0 < R := NumberField.Units.regulator_pos K
  let c₄ : ℝ := c₁ + c₂ + c₃ + c₀ + R⁻¹ * c₂ + (R⁻¹ * W) * c₃ + (R⁻¹ * W * H⁻¹) * c₀
  have hc₄_pos : 0 < c₄ := by
    dsimp [c₄]
    positivity
  refine ⟨c₄, hc₄_pos, ?_⟩
  intro X hX C hC_conv hC_open hC_bdd
  
  have hX0 : 0 ≤ X := by linarith
  let f : NumberField.InfinitePlace K → NNReal := fun _ => ⟨X, hX0⟩
  have hC_sub : C ⊆ NumberField.mixedEmbedding.convexBodyLT K f := by
    intro z hz
    rw [NumberField.mixedEmbedding.convexBodyLT, Set.mem_prod, Set.mem_univ_pi, Set.mem_univ_pi]
    refine ⟨fun w => ?_, fun w => ?_⟩
    · rw [Metric.mem_ball, dist_zero_right, ← NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2]
      exact hC_bdd z hz w.1
    · rw [Metric.mem_ball, dist_zero_right, ← NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex w.2]
      exact hC_bdd z hz w.1
  have hvol_le : MeasureTheory.volume C ≤
      MeasureTheory.volume (NumberField.mixedEmbedding.convexBodyLT K f) :=
    MeasureTheory.measure_mono hC_sub
  have hvol_eq : MeasureTheory.volume (NumberField.mixedEmbedding.convexBodyLT K f) =
      ↑(NumberField.mixedEmbedding.convexBodyLTFactor K) * ↑(∏ w, f w ^ w.mult) := by
    convert NumberField.mixedEmbedding.convexBodyLT_volume K f
  rw [hvol_eq] at hvol_le
  have hprod : (∏ w : NumberField.InfinitePlace K, f w ^ w.mult) =
      ⟨X, hX0⟩ ^ (Module.finrank ℚ K) := by
    dsimp [f]
    rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq]
  rw [hprod] at hvol_le
  have hne_top : (↑(NumberField.mixedEmbedding.convexBodyLTFactor K) *
      ↑(⟨X, hX0⟩ ^ (Module.finrank ℚ K) : NNReal) : ENNReal) ≠ ⊤ :=
    ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.coe_ne_top
  have hV_le : (MeasureTheory.volume C).toReal ≤ F * X ^ (Module.finrank ℚ K) := by
    have htoReal := ENNReal.toReal_mono hne_top hvol_le
    rw [ENNReal.toReal_mul, ENNReal.coe_toReal, ENNReal.coe_toReal, NNReal.coe_pow, NNReal.coe_mk] at htoReal
    exact htoReal
  
  set Y : ℝ := X ^ (Module.finrank ℚ K)
  set V : ℝ := (MeasureTheory.volume C).toReal
  have hX_pos : 0 < X := by linarith
  have hY_pos : 0 < Y := by dsimp [Y]; positivity
  have hV_nonneg : 0 ≤ V := ENNReal.toReal_nonneg
  set ρ : ℝ := V / (F * R * Y)
  have hρ_nonneg : 0 ≤ ρ := by dsimp [ρ]; positivity
  have hρ_le : ρ ≤ R⁻¹ := by
    dsimp [ρ]
    rw [div_le_iff₀ (by positivity)]
    have h1 : R⁻¹ * (F * R * Y) = F * Y := by
      have hR_ne : R ≠ 0 := ne_of_gt hR_pos
      field_simp [hR_ne]
    rw [h1]
    exact hV_le
  have h1 := hc₁ X hX C hC_conv hC_open hC_bdd
  have h2 := hc₂ X hX
  have h3 := hc₃ X hX
  have h4 := hc₀ X hX
  set S₁ : ℝ := ∑' x : {x : NumberField.RingOfIntegers K //
      NumberField.mixedEmbedding K (x : K) ∈ C},
    vonMangoldtO (x : NumberField.RingOfIntegers K)
  set S₂ : ℝ := ∑' x : {x : NumberField.RingOfIntegers K //
      NumberField.mixedEmbedding K (x : K) ∈
        NumberField.mixedEmbedding.fundamentalCone K ∧
      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤ Y},
    vonMangoldtO (x : NumberField.RingOfIntegers K)
  set S₃ : ℝ := ∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
      p.asIdeal.IsPrincipal ∧
      (Ideal.absNorm p.asIdeal : ℝ) ≤ Y},
    Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal)
  set S₄ : ℝ := ∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
      (Ideal.absNorm p.asIdeal : ℝ) ≤ Y},
    Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal)
  have h_ident : S₁ - (W / (F * H * R)) * V =
      (S₁ - ρ * S₂) + ρ * (S₂ - W * S₃) + (ρ * W) * (S₃ - H⁻¹ * S₄) + (ρ * W * H⁻¹) * (S₄ - Y) := by
    have hF_ne : F ≠ 0 := ne_of_gt hF_pos
    have hR_ne : R ≠ 0 := ne_of_gt hR_pos
    have hH_ne : H ≠ 0 := ne_of_gt hH_pos
    have hY_ne : Y ≠ 0 := ne_of_gt hY_pos
    dsimp [ρ]
    field_simp [hF_ne, hR_ne, hH_ne, hY_ne]
    ring
  have h_tri : |S₁ - (W / (F * H * R)) * V| ≤
      |S₁ - ρ * S₂| + R⁻¹ * |S₂ - W * S₃| + (R⁻¹ * W) * |S₃ - H⁻¹ * S₄| + (R⁻¹ * W * H⁻¹) * |S₄ - Y| := by
    rw [h_ident]
    have ht1 := abs_add_le
      ((S₁ - ρ * S₂) + ρ * (S₂ - W * S₃) + (ρ * W) * (S₃ - H⁻¹ * S₄))
      ((ρ * W * H⁻¹) * (S₄ - Y))
    have ht2 := abs_add_le
      ((S₁ - ρ * S₂) + ρ * (S₂ - W * S₃))
      ((ρ * W) * (S₃ - H⁻¹ * S₄))
    have ht3 := abs_add_le
      (S₁ - ρ * S₂)
      (ρ * (S₂ - W * S₃))
    have hm2 : |ρ * (S₂ - W * S₃)| ≤ R⁻¹ * |S₂ - W * S₃| := by
      rw [abs_mul, abs_of_nonneg hρ_nonneg]
      exact mul_le_mul_of_nonneg_right hρ_le (abs_nonneg _)
    have hm3 : |(ρ * W) * (S₃ - H⁻¹ * S₄)| ≤ (R⁻¹ * W) * |S₃ - H⁻¹ * S₄| := by
      rw [abs_mul, abs_of_nonneg (by positivity)]
      exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hρ_le (le_of_lt hW_pos)) (abs_nonneg _)
    have hm4 : |(ρ * W * H⁻¹) * (S₄ - Y)| ≤ (R⁻¹ * W * H⁻¹) * |S₄ - Y| := by
      rw [abs_mul, abs_of_nonneg (by positivity)]
      have hρWH : ρ * W * H⁻¹ ≤ R⁻¹ * W * H⁻¹ := by
        apply mul_le_mul_of_nonneg_right
        · exact mul_le_mul_of_nonneg_right hρ_le (le_of_lt hW_pos)
        · positivity
      exact mul_le_mul_of_nonneg_right hρWH (abs_nonneg _)
    linarith
  have hsqrt_nonneg : 0 ≤ Real.sqrt (Real.log X) := Real.sqrt_nonneg _
  have hc₁_le : c₁ ≤ c₄ := by
    have : 0 ≤ c₂ + c₃ + c₀ + R⁻¹ * c₂ + (R⁻¹ * W) * c₃ + (R⁻¹ * W * H⁻¹) * c₀ := by positivity
    dsimp [c₄]; linarith
  have hc₂_le : c₂ ≤ c₄ := by
    have : 0 ≤ c₁ + c₃ + c₀ + R⁻¹ * c₂ + (R⁻¹ * W) * c₃ + (R⁻¹ * W * H⁻¹) * c₀ := by positivity
    dsimp [c₄]; linarith
  have hc₃_le : c₃ ≤ c₄ := by
    have : 0 ≤ c₁ + c₂ + c₀ + R⁻¹ * c₂ + (R⁻¹ * W) * c₃ + (R⁻¹ * W * H⁻¹) * c₀ := by positivity
    dsimp [c₄]; linarith
  have hc₀_le : c₀ ≤ c₄ := by
    have : 0 ≤ c₁ + c₂ + c₃ + R⁻¹ * c₂ + (R⁻¹ * W) * c₃ + (R⁻¹ * W * H⁻¹) * c₀ := by positivity
    dsimp [c₄]; linarith
  have hexp1 : Real.exp (-Real.sqrt (Real.log X) / c₁) ≤ Real.exp (-Real.sqrt (Real.log X) / c₄) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₁_pos hc₁_le
  have hexp2 : Real.exp (-Real.sqrt (Real.log X) / c₂) ≤ Real.exp (-Real.sqrt (Real.log X) / c₄) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₂_pos hc₂_le
  have hexp3 : Real.exp (-Real.sqrt (Real.log X) / c₃) ≤ Real.exp (-Real.sqrt (Real.log X) / c₄) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₃_pos hc₃_le
  have hexp4 : Real.exp (-Real.sqrt (Real.log X) / c₀) ≤ Real.exp (-Real.sqrt (Real.log X) / c₄) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₀_pos hc₀_le
  have hterm1 : |S₁ - ρ * S₂| ≤ c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₄) := by
    calc |S₁ - ρ * S₂| ≤ c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := h1
      _ ≤ c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₄) :=
        mul_le_mul_of_nonneg_left hexp1 (by positivity)
  have hterm2 : R⁻¹ * |S₂ - W * S₃| ≤ (R⁻¹ * c₂) * Y * Real.exp (-Real.sqrt (Real.log X) / c₄) := by
    calc R⁻¹ * |S₂ - W * S₃| ≤ R⁻¹ * (c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂)) :=
          mul_le_mul_of_nonneg_left h2 (by positivity)
      _ ≤ R⁻¹ * (c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₄)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp2 (by positivity)) (by positivity)
      _ = (R⁻¹ * c₂) * Y * Real.exp (-Real.sqrt (Real.log X) / c₄) := by ring
  have hterm3 : (R⁻¹ * W) * |S₃ - H⁻¹ * S₄| ≤ ((R⁻¹ * W) * c₃) * Y * Real.exp (-Real.sqrt (Real.log X) / c₄) := by
    calc (R⁻¹ * W) * |S₃ - H⁻¹ * S₄| ≤ (R⁻¹ * W) * (c₃ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃)) :=
          mul_le_mul_of_nonneg_left h3 (by positivity)
      _ ≤ (R⁻¹ * W) * (c₃ * Y * Real.exp (-Real.sqrt (Real.log X) / c₄)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp3 (by positivity)) (by positivity)
      _ = ((R⁻¹ * W) * c₃) * Y * Real.exp (-Real.sqrt (Real.log X) / c₄) := by ring
  have hterm4 : (R⁻¹ * W * H⁻¹) * |S₄ - Y| ≤ ((R⁻¹ * W * H⁻¹) * c₀) * Y * Real.exp (-Real.sqrt (Real.log X) / c₄) := by
    calc (R⁻¹ * W * H⁻¹) * |S₄ - Y| ≤ (R⁻¹ * W * H⁻¹) * (c₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₀)) :=
          mul_le_mul_of_nonneg_left h4 (by positivity)
      _ ≤ (R⁻¹ * W * H⁻¹) * (c₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₄)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp4 (by positivity)) (by positivity)
      _ = ((R⁻¹ * W * H⁻¹) * c₀) * Y * Real.exp (-Real.sqrt (Real.log X) / c₄) := by ring
  have h_sum_le :
      c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₄) +
      (R⁻¹ * c₂) * Y * Real.exp (-Real.sqrt (Real.log X) / c₄) +
      ((R⁻¹ * W) * c₃) * Y * Real.exp (-Real.sqrt (Real.log X) / c₄) +
      ((R⁻¹ * W * H⁻¹) * c₀) * Y * Real.exp (-Real.sqrt (Real.log X) / c₄) ≤
      c₄ * Y * Real.exp (-Real.sqrt (Real.log X) / c₄) := by
    have h_coeff : c₁ + R⁻¹ * c₂ + (R⁻¹ * W) * c₃ + (R⁻¹ * W * H⁻¹) * c₀ ≤ c₄ := by
      have : 0 ≤ c₂ + c₃ + c₀ := by positivity
      dsimp [c₄]; linarith
    have hYE_nonneg : 0 ≤ Y * Real.exp (-Real.sqrt (Real.log X) / c₄) := by positivity
    calc c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₄) +
        (R⁻¹ * c₂) * Y * Real.exp (-Real.sqrt (Real.log X) / c₄) +
        ((R⁻¹ * W) * c₃) * Y * Real.exp (-Real.sqrt (Real.log X) / c₄) +
        ((R⁻¹ * W * H⁻¹) * c₀) * Y * Real.exp (-Real.sqrt (Real.log X) / c₄)
      _ = (c₁ + R⁻¹ * c₂ + (R⁻¹ * W) * c₃ + (R⁻¹ * W * H⁻¹) * c₀) * (Y * Real.exp (-Real.sqrt (Real.log X) / c₄)) := by ring
      _ ≤ c₄ * (Y * Real.exp (-Real.sqrt (Real.log X) / c₄)) := mul_le_mul_of_nonneg_right h_coeff hYE_nonneg
      _ = c₄ * Y * Real.exp (-Real.sqrt (Real.log X) / c₄) := by ring
  linarith

theorem mitsui_prime_ideal {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (A : ℕ) (hA : 1 < A) :
    ∃ (κ : Ideal (NumberField.RingOfIntegers K) → ℝ) (c : ℝ), 0 < c ∧
      (∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 → 0 < κ q) ∧
      ∀ X : ℝ, 1 < X →
        ∀ C : Set (NumberField.mixedEmbedding.mixedSpace K), Convex ℝ C → IsOpen C →
          (∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
              NumberField.mixedEmbedding.normAtPlace w z < X) →
          ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
            (Ideal.absNorm q : ℝ) < Real.log X ^ A →
            ∀ α : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk q α) →
              |(∑' π : {π : NumberField.RingOfIntegers K //
                    Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C ∧ π - α ∈ q},
                  Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
                 - κ q * (MeasureTheory.volume C).toReal|
                ≤ c * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) :=
by
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_prime_equidist_mod_q (K := K) A hA
  obtain ⟨c₂, hc₂_pos, hc₂⟩ := mitsui_prime_coprime_to_all (K := K) A hA
  obtain ⟨c₃, hc₃_pos, hc₃⟩ := mitsui_prime_to_vonMangoldt_unconditioned (K := K)
  obtain ⟨c₄, hc₄_pos, hc₄⟩ := mitsui_vonMangoldt_unconditioned (K := K)
  let κ₀ : ℝ := (NumberField.Units.torsionOrder K : ℝ) /
    ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) *
      (NumberField.classNumber K : ℝ) *
      NumberField.Units.regulator K)
  let φ : Ideal (NumberField.RingOfIntegers K) → ℝ :=
    fun q => (Nat.card (NumberField.RingOfIntegers K ⧸ q)ˣ : ℝ)
  let κ : Ideal (NumberField.RingOfIntegers K) → ℝ :=
    fun q => (NumberField.Units.torsionOrder K : ℝ) /
      ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) *
        (NumberField.classNumber K : ℝ) *
        NumberField.Units.regulator K *
        (Nat.card (NumberField.RingOfIntegers K ⧸ q)ˣ : ℝ))
  let c : ℝ := c₁ + c₂ + c₃ + c₄
  have hc_pos : 0 < c := by dsimp [c]; linarith
  have h_s1 : ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 → 0 < κ q ∧ 1 ≤ φ q := by
    intro q hq
    have hq_bot : q ≠ ⊥ := hq
    haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
      Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
    have hcard_pos : 0 < Nat.card (NumberField.RingOfIntegers K ⧸ q)ˣ := Nat.card_pos
    have hcard_ge_one : 1 ≤ φ q := by
      dsimp [φ]
      exact_mod_cast hcard_pos
    have htors : (0 : ℝ) < NumberField.Units.torsionOrder K := by
      exact_mod_cast NumberField.Units.torsionOrder_pos K
    have hconv : (0 : ℝ) < NumberField.mixedEmbedding.convexBodyLTFactor K := by
      have h1 := NumberField.mixedEmbedding.one_le_convexBodyLTFactor K
      exact_mod_cast lt_of_lt_of_le zero_lt_one h1
    have hclass : (0 : ℝ) < NumberField.classNumber K := by
      exact_mod_cast NumberField.classNumber_pos K
    have hreg : (0 : ℝ) < NumberField.Units.regulator K :=
      NumberField.Units.regulator_pos K
    refine ⟨?_, hcard_ge_one⟩
    dsimp [κ]
    positivity
  refine ⟨κ, c, hc_pos, fun q hq => (h_s1 q hq).1, ?_⟩
  intro X hX C hC_conv hC_open hC_bdd q hq hq_norm α hα
  have hφ_ge_one : 1 ≤ φ q := (h_s1 q hq).2
  have hφ_inv_nonneg : 0 ≤ (φ q)⁻¹ := by positivity
  have hφ_inv_le_one : (φ q)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hφ_ge_one
  have h1 := hc₁ X hX C hC_conv hC_open hC_bdd q hq hq_norm α hα
  have h2 := hc₂ X hX C hC_conv hC_open hC_bdd q hq hq_norm
  have h3 := hc₃ X hX C hC_conv hC_open hC_bdd
  have h4 := hc₄ X hX C hC_conv hC_open hC_bdd
  set S₁ : ℝ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C ∧ π - α ∈ q},
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  set S₂ : ℝ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C ∧
      IsUnit (Ideal.Quotient.mk q π)},
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  set S₃ : ℝ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C},
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  set S₄ : ℝ := ∑' x : {x : NumberField.RingOfIntegers K //
      NumberField.mixedEmbedding K (x : K) ∈ C},
    vonMangoldtO (x : NumberField.RingOfIntegers K)
  set V : ℝ := (MeasureTheory.volume C).toReal
  have h_ident : S₁ - κ q * V =
      (S₁ - (φ q)⁻¹ * S₂) + (φ q)⁻¹ * (S₂ - S₃) +
      (φ q)⁻¹ * (S₃ - S₄) + (φ q)⁻¹ * (S₄ - κ₀ * V) := by
    dsimp [κ, κ₀, φ]
    ring
  have h_tri : |S₁ - κ q * V| ≤
      |S₁ - (φ q)⁻¹ * S₂| + |S₂ - S₃| + |S₃ - S₄| + |S₄ - κ₀ * V| := by
    rw [h_ident]
    have ht1 := abs_add_le
      ((S₁ - (φ q)⁻¹ * S₂) + (φ q)⁻¹ * (S₂ - S₃) + (φ q)⁻¹ * (S₃ - S₄))
      ((φ q)⁻¹ * (S₄ - κ₀ * V))
    have ht2 := abs_add_le
      ((S₁ - (φ q)⁻¹ * S₂) + (φ q)⁻¹ * (S₂ - S₃))
      ((φ q)⁻¹ * (S₃ - S₄))
    have ht3 := abs_add_le
      (S₁ - (φ q)⁻¹ * S₂)
      ((φ q)⁻¹ * (S₂ - S₃))
    have hm2 : |(φ q)⁻¹ * (S₂ - S₃)| ≤ |S₂ - S₃| := by
      rw [abs_mul, abs_of_nonneg hφ_inv_nonneg]
      exact mul_le_of_le_one_left (abs_nonneg _) hφ_inv_le_one
    have hm3 : |(φ q)⁻¹ * (S₃ - S₄)| ≤ |S₃ - S₄| := by
      rw [abs_mul, abs_of_nonneg hφ_inv_nonneg]
      exact mul_le_of_le_one_left (abs_nonneg _) hφ_inv_le_one
    have hm4 : |(φ q)⁻¹ * (S₄ - κ₀ * V)| ≤ |S₄ - κ₀ * V| := by
      rw [abs_mul, abs_of_nonneg hφ_inv_nonneg]
      exact mul_le_of_le_one_left (abs_nonneg _) hφ_inv_le_one
    linarith
  have hX_pos : 0 ≤ X ^ (Module.finrank ℚ K) := by
    have : (0 : ℝ) ≤ X := by linarith
    positivity
  have hsqrt_nonneg : 0 ≤ Real.sqrt (Real.log X) := Real.sqrt_nonneg _
  have hexp1 : Real.exp (-Real.sqrt (Real.log X) / c₁) ≤ Real.exp (-Real.sqrt (Real.log X) / c) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₁_pos (by dsimp [c]; linarith)
  have hexp2 : Real.exp (-Real.sqrt (Real.log X) / c₂) ≤ Real.exp (-Real.sqrt (Real.log X) / c) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₂_pos (by dsimp [c]; linarith)
  have hexp3 : Real.exp (-Real.sqrt (Real.log X) / c₃) ≤ Real.exp (-Real.sqrt (Real.log X) / c) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₃_pos (by dsimp [c]; linarith)
  have hexp4 : Real.exp (-Real.sqrt (Real.log X) / c₄) ≤ Real.exp (-Real.sqrt (Real.log X) / c) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₄_pos (by dsimp [c]; linarith)
  have hterm1 : c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁) ≤
      c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) := by
    exact mul_le_mul_of_nonneg_left hexp1 (by positivity)
  have hterm2 : c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₂) ≤
      c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) := by
    exact mul_le_mul_of_nonneg_left hexp2 (by positivity)
  have hterm3 : c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃) ≤
      c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) := by
    exact mul_le_mul_of_nonneg_left hexp3 (by positivity)
  have hterm4 : c₄ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₄) ≤
      c₄ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) := by
    exact mul_le_mul_of_nonneg_left hexp4 (by positivity)
  have hsum :
      c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) +
      c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) +
      c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) +
      c₄ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) =
      c * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c) := by
    dsimp [c]
    ring
  linarith
