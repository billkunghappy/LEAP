          have h_val : xpm.1.1.2 = pm.1 := congrArg Subtype.val xpm.2
          have h_p : xpm.1.1.2.1 = pm.1.1 := congrArg Prod.fst h_val
          have h_ν : xpm.1.1.2.2 = pm.1.2 := congrArg Prod.snd h_val
          refine ⟨?_, xpm.1.2.2.2.2⟩
          rw [← h_p, ← h_ν]
          exact xpm.1.2.2.1⟩
      invFun := fun x =>
        ⟨⟨(x.1, pm.1), ⟨pm.2.1, x.2.1, pm.2.2, x.2.2⟩⟩, Subtype.ext rfl⟩
      left_inv := fun xpm => by
        apply Subtype.ext
        apply Subtype.ext
        exact Prod.ext rfl (congrArg Subtype.val xpm.2).symm
      right_inv := fun x => Subtype.ext rfl }
