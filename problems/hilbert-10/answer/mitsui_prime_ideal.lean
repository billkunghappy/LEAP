        refine Finset.sum_congr rfl (fun q _ => ?_)
        rw [h_step1 q]
        exact Finset.sum_congr rfl (fun b _ => h_step2 b q)
      _ = ∑ b : ι_b, ∑ q ∈ S_main,
            ∑ ξ : ι_ξ,
              if q ∈ S_main_slice ξ then
                (Hat_q q : ℂ) * (c_ind ξ b * χ (l_emb b) * ψ₀ b q)
