      (T * ∑' e : E, U e * E_L e) * (c_chi ^ ν * W) =
        (T * ∑' e : E, U e * E_R e) * (c_chi' ^ ν * W) := by
    intro E T U E_L E_R c_chi c_psi c_chi' W ν hc hE
    have h_tsum : (∑' e : E, U e * E_L e) = (∑' e : E, U e * E_R e) * c_psi ^ ν := by
      rw [← tsum_mul_right]
      exact tsum_congr (fun e => by rw [hE e, ← mul_assoc])
    rw [h_tsum, hc, mul_pow]
    ring
  refine ⟨θ₀, χ', hθ₀_bdd, hχ'_ray, hχ'_norm, h_real_tors, ?_⟩
  refine tsum_congr (fun pm => ?_)
  let p_nz : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
    ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩
  let ν : ℕ := pm.1.2
  have h_psi_pow :
      Complex.exp
        (2 * Real.pi * Complex.I *
          ∑ j : Fin r, (k_β j : ℂ) * (((ν : ℝ) * Φ_W p_nz j : ℝ) : ℂ)) =
      (ψ_kβ p_nz) ^ ν := by
    change Complex.exp _ = (f_ψ p_nz) ^ ν
    dsimp [f_ψ]
    rw [← Complex.exp_nat_mul]
    congr 1
    have h_sum :
        (∑ j : Fin r, (k_β j : ℂ) * (((ν : ℝ) * Φ_W p_nz j : ℝ) : ℂ)) =
        (ν : ℂ) * (∑ j : Fin r, (k_β j : ℂ) * (Φ_W p_nz j : ℂ)) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      push_cast
      ring
    rw [h_sum]
    ring
  refine h_alg _ _ _ _ (χ p_nz) (ψ_kβ p_nz) (χ' p_nz) _ ν rfl (fun e => ?_)
  rw [h_bilinear_exp (fun j => (ν : ℝ) * Φ_W p_nz j) e.1, h_psi_pow]

theorem mitsui_unitLogCoord_le_of_place_log_le {K : Type u} [Field K] [NumberField K] :
    ∃ M_K : ℝ, 0 < M_K ∧
      ∀ (w₀ : NumberField.InfinitePlace K)
        (y : Fin (NumberField.Units.rank K) → ℝ)
        (B : ℝ),
        0 ≤ B →
        (∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
          |∑ j : Fin (NumberField.Units.rank K),
              y j *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))| ≤ B) →
        ∀ i : Fin (NumberField.Units.rank K), |y i| ≤ M_K * B :=
by
  classical
  let n : ℕ := Module.finrank ℚ K
  let r : ℕ := NumberField.Units.rank K
  let B_R : Module.Basis (Fin r) ℝ (NumberField.Units.dirichletUnitTheorem.logSpace K) :=
    Module.Basis.ofZLatticeBasis ℝ
      (NumberField.Units.unitLattice K)
      (NumberField.Units.basisUnitLattice K)
  let L : Fin r → (NumberField.Units.dirichletUnitTheorem.logSpace K →L[ℝ] ℝ) :=
    fun i => (B_R.coord i).toContinuousLinearMap
  let M_K : ℝ := 2 * (n : ℝ) * (∑ i : Fin r, ‖L i‖) + 1
  have hM_K_pos : 0 < M_K := by
    dsimp [M_K]
    positivity
  refine ⟨M_K, hM_K_pos, ?_⟩
  intro w₀ y B hB h_diff i
  let S : NumberField.InfinitePlace K → ℝ :=
    fun w => ∑ j : Fin r, y j *
      Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))
  have hS_sub_eq : ∀ w : NumberField.InfinitePlace K,
      (∑ j : Fin r,
        y j *
          Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
            w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) =
        S w - S w₀ := by
    intro w
    dsimp [S]
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    let η_j : K := (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)
    have hη_ne : η_j ≠ 0 :=
      NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero _)
    have hwη : w η_j ≠ 0 := ne_of_gt (w.pos_iff.mpr hη_ne)
    have hw₀η : w₀ η_j ≠ 0 := ne_of_gt (w₀.pos_iff.mpr hη_ne)
    rw [← mul_sub, ← Real.log_div hwη hw₀η]
  have hS_diff : ∀ w : NumberField.InfinitePlace K, |S w - S w₀| ≤ B := by
    intro w
    by_cases hw : w = w₀
    · subst hw
      rw [sub_self, abs_zero]
      exact hB
    · have h1 := h_diff w hw
      rw [hS_sub_eq w] at h1
      exact h1
  have hsum_S : ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * S w = 0 := by
    dsimp [S]
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_eq_zero (fun j _ => ?_)
    have h_comm : (∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * (y j *
          Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)))) =
        y j * (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) *
            Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun w _ => by ring)
    rw [h_comm]
    have h_unit_sum : (∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) *
          Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) = 0 := by
      simpa using NumberField.Units.sum_mult_mul_log (NumberField.Units.fundSystem K j)
    rw [h_unit_sum, mul_zero]
  have hn_pos : (0 : ℝ) < (n : ℝ) := by
    dsimp [n]
    exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
  have hsum_mult : ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) = (n : ℝ) := by
    dsimp [n]
    exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
  have hsum_diff : ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * (S w - S w₀) =
      -(n : ℝ) * S w₀ := by
    simp_rw [mul_sub]
    rw [Finset.sum_sub_distrib, hsum_S, ← Finset.sum_mul, hsum_mult]
    ring
  have hw₀_mul_abs : (n : ℝ) * |S w₀| ≤ (n : ℝ) * B := by
    have h1 : (n : ℝ) * |S w₀| = |-(n : ℝ) * S w₀| := by
      rw [neg_mul, abs_neg, abs_mul, abs_of_pos hn_pos]
    rw [h1, ← hsum_diff]
    calc |∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * (S w - S w₀)|
        ≤ ∑ w : NumberField.InfinitePlace K, |(w.mult : ℝ) * (S w - S w₀)| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * B := by
          refine Finset.sum_le_sum (fun w _ => ?_)
          rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg w.mult)]
          exact mul_le_mul_of_nonneg_left (hS_diff w) (Nat.cast_nonneg w.mult)
      _ = (n : ℝ) * B := by
          rw [← Finset.sum_mul, hsum_mult]
  have hw₀_abs : |S w₀| ≤ B :=
    le_of_mul_le_mul_left hw₀_mul_abs hn_pos
  have hw_mult_abs : ∀ w : NumberField.InfinitePlace K,
      |(w.mult : ℝ) * S w| ≤ 2 * (n : ℝ) * B := by
    intro w
    have hw_abs : |S w| ≤ 2 * B := by
      have h_id : S w = (S w - S w₀) + S w₀ := by ring
      rw [h_id]
      have htri := abs_add_le (S w - S w₀) (S w₀)
      linarith [hS_diff w, hw₀_abs]
    have hw_mult_le : (w.mult : ℝ) ≤ (n : ℝ) := by
      have h_nat : w.mult ≤ n := by
        dsimp [n]
        rw [← NumberField.InfinitePlace.sum_mult_eq]
        exact Finset.single_le_sum (fun v _ => Nat.zero_le v.mult) (Finset.mem_univ w)
      exact_mod_cast h_nat
    rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg w.mult)]
    calc (w.mult : ℝ) * |S w|
        ≤ (n : ℝ) * (2 * B) :=
          mul_le_mul hw_mult_le hw_abs (abs_nonneg _) (le_of_lt hn_pos)
      _ = 2 * (n : ℝ) * B := by ring
  let v_y : NumberField.Units.dirichletUnitTheorem.logSpace K :=
    ∑ j : Fin r, y j • B_R j
  have hv_y_eval : ∀ w : {w : NumberField.InfinitePlace K // w ≠ NumberField.Units.dirichletUnitTheorem.w₀},
      v_y w = (w.1.mult : ℝ) * S w.1 := by
    intro w
    have h_eval : v_y w = ∑ j : Fin r, y j * (B_R j w) := by
      dsimp [v_y]
      simp [Finset.sum_apply]
    rw [h_eval]
    dsimp [S]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    have hB_j : B_R j w =
        (w.1.mult : ℝ) *
          Real.log (w.1 (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) := by
      dsimp [B_R]
      rw [Module.Basis.ofZLatticeBasis_apply, ← NumberField.Units.logEmbedding_fundSystem,
        NumberField.Units.dirichletUnitTheorem.logEmbedding_component]
    rw [hB_j]
    ring
  have h2nB_nonneg : 0 ≤ 2 * (n : ℝ) * B := by positivity
  have hv_y_norm : ‖v_y‖ ≤ 2 * (n : ℝ) * B := by
    rw [pi_norm_le_iff_of_nonneg h2nB_nonneg]
    intro w
    rw [Real.norm_eq_abs, hv_y_eval w]
    exact hw_mult_abs w.1
  have hL_eval : L i v_y = y i := by
    dsimp [L, v_y]
    rw [map_sum]
    simp [map_smul, Module.Basis.repr_self, Finsupp.single_apply]
  have hL_le : ‖L i‖ ≤ ∑ j : Fin r, ‖L j‖ :=
    Finset.single_le_sum (fun j _ => norm_nonneg (L j)) (Finset.mem_univ i)
  calc |y i|
      = ‖L i v_y‖ := by rw [hL_eval, Real.norm_eq_abs]
    _ ≤ ‖L i‖ * ‖v_y‖ := ContinuousLinearMap.le_opNorm (L i) v_y
    _ ≤ (∑ j : Fin r, ‖L j‖) * (2 * (n : ℝ) * B) :=
        mul_le_mul hL_le hv_y_norm (norm_nonneg _) (Finset.sum_nonneg (fun j _ => norm_nonneg _))
    _ = (2 * (n : ℝ) * ∑ j : Fin r, ‖L j‖) * B := by ring
    _ ≤ M_K * B := by
        dsimp [M_K]
        linarith

theorem mitsui_periodic_tent_1d_trigPoly_approx (h : ℝ) (hh_pos : 0 < h) (hh_le : h ≤ 1 / 2)
    (M : ℕ) (hM : 1 ≤ M) :
    ∃ c_1d : ℤ → ℝ,
      (∀ m : ℤ, 0 ≤ c_1d m ∧ c_1d m ≤ h) ∧
      (∀ x : ℝ,
        ‖∑ m ∈ Finset.Icc (-(M : ℤ)) (M : ℤ),
            (c_1d m : ℂ) * Complex.exp (2 * Real.pi * Complex.I * (m : ℝ) * x)‖ ≤ 1) ∧
      (∀ x : ℝ,
        ‖((max (0 : ℝ) (1 - |x - (Int.floor (x + 1 / 2) : ℝ)| / h) : ℝ) : ℂ) -
          ∑ m ∈ Finset.Icc (-(M : ℤ)) (M : ℤ),
            (c_1d m : ℂ) * Complex.exp (2 * Real.pi * Complex.I * (m : ℝ) * x)‖ ≤
          (h * (M : ℝ))⁻¹) :=
by
  let c_1d : ℤ → ℝ := fun m =>
    if m = 0 then h
    else (1 - Real.cos (2 * Real.pi * (m : ℝ) * h)) / (2 * Real.pi ^ 2 * h * (m : ℝ) ^ 2)
  have hc_1d : ∀ m : ℤ, c_1d m =
      if m = 0 then h
      else (1 - Real.cos (2 * Real.pi * (m : ℝ) * h)) / (2 * Real.pi ^ 2 * h * (m : ℝ) ^ 2) :=
    fun _ => rfl
  have hpi_pos : 0 < Real.pi := Real.pi_pos
  have h_trig : ∀ θ : ℝ, 1 - Real.cos (2 * θ) = 2 * Real.sin θ ^ 2 := by
    intro θ
    have h1 := Real.cos_two_mul' θ
    have h2 := Real.cos_sq_add_sin_sq θ
    linarith
  have hc_bounds : ∀ m : ℤ, 0 ≤ c_1d m ∧ c_1d m ≤ h := by
    intro m
    rw [hc_1d m]
    split_ifs with hm
    · exact ⟨le_of_lt hh_pos, le_rfl⟩
    · have hm_ne : (m : ℝ) ≠ 0 := Int.cast_ne_zero.mpr hm
      have hD_pos : 0 < 2 * Real.pi ^ 2 * h * (m : ℝ) ^ 2 := by positivity
      let θ : ℝ := Real.pi * (m : ℝ) * h
      have h2θ : 2 * Real.pi * (m : ℝ) * h = 2 * θ := by dsimp [θ]; ring
      rw [h2θ, h_trig θ]
      refine ⟨by positivity, ?_⟩
      rw [div_le_iff₀ hD_pos]
      have hsin_abs : |Real.sin θ| ≤ |θ| := Real.abs_sin_le_abs
      have hsin_sq : Real.sin θ ^ 2 ≤ θ ^ 2 := by
        rw [← sq_abs (Real.sin θ), ← sq_abs θ]
        exact pow_le_pow_left₀ (abs_nonneg _) hsin_abs 2
      calc 2 * Real.sin θ ^ 2
        _ ≤ 2 * θ ^ 2 := by linarith
        _ = h * (2 * Real.pi ^ 2 * h * (m : ℝ) ^ 2) := by dsimp [θ]; ring
  have hc_decay : ∀ m : ℤ, m ≠ 0 → c_1d m ≤ (Real.pi ^ 2 * h * (m : ℝ) ^ 2)⁻¹ := by
    intro m hm
    rw [hc_1d m, if_neg hm]
    have hm_ne : (m : ℝ) ≠ 0 := Int.cast_ne_zero.mpr hm
    have hD_pos : 0 < 2 * Real.pi ^ 2 * h * (m : ℝ) ^ 2 := by positivity
    let θ : ℝ := Real.pi * (m : ℝ) * h
    have h2θ : 2 * Real.pi * (m : ℝ) * h = 2 * θ := by dsimp [θ]; ring
    rw [h2θ, h_trig θ, div_le_iff₀ hD_pos]
    have hsin1 : Real.sin θ ^ 2 ≤ 1 := Real.sin_sq_le_one θ
    have h_rhs : (Real.pi ^ 2 * h * (m : ℝ) ^ 2)⁻¹ * (2 * Real.pi ^ 2 * h * (m : ℝ) ^ 2) = 2 := by
      have h1 : Real.pi ^ 2 * h * (m : ℝ) ^ 2 ≠ 0 := by positivity
      field_simp [h1]
    linarith
  have hc_even : ∀ m : ℤ, c_1d (-m) = c_1d m := by
    intro m
    rw [hc_1d (-m), hc_1d m]
    by_cases hm : m = 0
    · subst hm; simp
    · have hnm : -m ≠ 0 := neg_ne_zero.mpr hm
      rw [if_neg hnm, if_neg hm, Int.cast_neg]
      have h1 : 2 * Real.pi * -(m : ℝ) * h = -(2 * Real.pi * (m : ℝ) * h) := by ring
      rw [h1, Real.cos_neg, neg_sq]
  have hc_nat_succ_sum : Summable (fun n : ℕ => c_1d ((n + 1 : ℕ) : ℤ)) := by
    have h_p2 : Summable (fun n : ℕ => ((n : ℝ) ^ 2)⁻¹) :=
      Real.summable_nat_pow_inv.mpr (by norm_num)
    have h_shift : Summable (fun n : ℕ => (((n + 1 : ℕ) : ℝ) ^ 2)⁻¹) :=
      (summable_nat_add_iff 1).mpr h_p2
    have h_maj : Summable (fun n : ℕ => (Real.pi ^ 2 * h)⁻¹ * (((n + 1 : ℕ) : ℝ) ^ 2)⁻¹) :=
      h_shift.mul_left (Real.pi ^ 2 * h)⁻¹
    refine Summable.of_nonneg_of_le (fun n => (hc_bounds _).1) (fun n => ?_) h_maj
    have hn_ne : ((n + 1 : ℕ) : ℤ) ≠ 0 := by omega
    refine (hc_decay _ hn_ne).trans ?_
    rw [Int.cast_natCast, mul_inv]
  have hc_nat_sum : Summable (fun n : ℕ => c_1d (n : ℤ)) :=
    (summable_nat_add_iff 1).mp hc_nat_succ_sum
  have hc_neg_sum : Summable (fun n : ℕ => c_1d (-((n : ℤ) + 1))) := by
    have h_eq : (fun n : ℕ => c_1d (-((n : ℤ) + 1))) = (fun n : ℕ => c_1d ((n + 1 : ℕ) : ℤ)) := by
      ext n
      rw [hc_even]
      push_cast
      rfl
    rw [h_eq]
    exact hc_nat_succ_sum
  have hc_sum : Summable c_1d := Summable.of_nat_of_neg_add_one hc_nat_sum hc_neg_sum
  have h_Icc_eq : ∀ N : ℕ,
      ∑ m ∈ Finset.Icc (-(N : ℤ)) (N : ℤ), c_1d m =
        c_1d 0 + ∑ k ∈ Finset.range N, 2 * c_1d ((k + 1 : ℕ) : ℤ) := by
    intro N
    induction N with
    | zero => simp
    | succ N ih =>
      have h_left : insert (-((N + 1 : ℕ) : ℤ)) (Finset.Icc (-(N : ℤ)) ((N + 1 : ℕ) : ℤ)) =
          Finset.Icc (-((N + 1 : ℕ) : ℤ)) ((N + 1 : ℕ) : ℤ) := by
        have h1 : -((N + 1 : ℕ) : ℤ) + 1 = -(N : ℤ) := by push_cast; ring
        have h2 : -((N + 1 : ℕ) : ℤ) ≤ ((N + 1 : ℕ) : ℤ) := by omega
        simpa [h1] using Finset.insert_Icc_add_one_left_eq_Icc h2
      have h_right : insert ((N : ℤ) + 1) (Finset.Icc (-(N : ℤ)) (N : ℤ)) =
          Finset.Icc (-(N : ℤ)) ((N + 1 : ℕ) : ℤ) := by
        have h1 : ((N + 1 : ℕ) : ℤ) = (N : ℤ) + 1 := by push_cast; ring
        have h2 : -(N : ℤ) ≤ (N : ℤ) + 1 := by omega
        rw [h1]
        exact Finset.insert_Icc_right_eq_Icc_add_one h2
      have h_not_mem1 : -((N + 1 : ℕ) : ℤ) ∉ Finset.Icc (-(N : ℤ)) ((N + 1 : ℕ) : ℤ) := by
        rw [Finset.mem_Icc]; omega
      have h_not_mem2 : (N : ℤ) + 1 ∉ Finset.Icc (-(N : ℤ)) (N : ℤ) := by
        rw [Finset.mem_Icc]; omega
      rw [← h_left, Finset.sum_insert h_not_mem1, ← h_right, Finset.sum_insert h_not_mem2, ih,
        Finset.sum_range_succ, hc_even]
      have h_cast : ((N : ℤ) + 1) = ((N + 1 : ℕ) : ℤ) := by push_cast; ring
      rw [h_cast]
      ring
  have h_tsum_split : (∑' m : ℤ, c_1d m) =
      c_1d 0 + ∑' k : ℕ, 2 * c_1d ((k + 1 : ℕ) : ℤ) := by
    rw [tsum_of_nat_of_neg_add_one hc_nat_sum hc_neg_sum]
    have h1 := hc_nat_sum.sum_add_tsum_nat_add 1
    rw [Finset.sum_range_one, Nat.cast_zero] at h1
    have h_neg_eq : (∑' n : ℕ, c_1d (-((n : ℤ) + 1))) = ∑' n : ℕ, c_1d ((n + 1 : ℕ) : ℤ) := by
      refine tsum_congr (fun n => ?_)
      rw [hc_even]
      push_cast
      rfl
    have h_two : (∑' k : ℕ, 2 * c_1d ((k + 1 : ℕ) : ℤ)) =
        2 * ∑' k : ℕ, c_1d ((k + 1 : ℕ) : ℤ) := tsum_mul_left
    linarith
  have h_tail_eq : (∑' m : ℤ, c_1d m) - (∑ m ∈ Finset.Icc (-(M : ℤ)) (M : ℤ), c_1d m) =
      ∑' i : ℕ, 2 * c_1d ((i + M + 1 : ℕ) : ℤ) := by
    rw [h_tsum_split, h_Icc_eq M]
    have h2_sum : Summable (fun k : ℕ => 2 * c_1d ((k + 1 : ℕ) : ℤ)) :=
      hc_nat_succ_sum.mul_left 2
    have h_split_M := h2_sum.sum_add_tsum_nat_add M
    linarith
  have hc_tail : (∑' m : ℤ, c_1d m) - (∑ m ∈ Finset.Icc (-(M : ℤ)) (M : ℤ), c_1d m) ≤
      (h * (M : ℝ))⁻¹ := by
    rw [h_tail_eq]
    refine Real.tsum_le_of_sum_range_le
      (fun i => by have := (hc_bounds ((i + M + 1 : ℕ) : ℤ)).1; linarith) (fun n => ?_)
    have h_term_le : ∀ i : ℕ,
        2 * c_1d ((i + M + 1 : ℕ) : ℤ) ≤
          h⁻¹ * ((((i + M : ℕ) : ℝ))⁻¹ - (((i + 1 + M : ℕ) : ℝ))⁻¹) := by
      intro i
      have hiM_ne : ((i + M + 1 : ℕ) : ℤ) ≠ 0 := by omega
      have h_dec := hc_decay ((i + M + 1 : ℕ) : ℤ) hiM_ne
      rw [Int.cast_natCast] at h_dec
      let a : ℝ := ((i + M : ℕ) : ℝ)
      have ha_ge_one : 1 ≤ a := by
        dsimp [a]
        exact_mod_cast (by omega : 1 ≤ i + M)
      have ha_pos : 0 < a := by linarith
      have ha1_eq : ((i + M + 1 : ℕ) : ℝ) = a + 1 := by dsimp [a]; push_cast; ring
      have ha1_eq' : ((i + 1 + M : ℕ) : ℝ) = a + 1 := by dsimp [a]; push_cast; ring
