    calc W * ((Real.exp (-δ) - 1 + δ) * Y) ≤ W * (δ ^ 2 * Y) :=
          mul_le_mul_of_nonneg_left h1 (le_of_lt hW_pos)
      _ = W * Y * δ ^ 2 := by ring
  have h_fwd : ‖(Ψ₁_cone (Real.exp δ * Y) - Ψ₁_cone Y) - (δ : ℂ) * ψ_cone Y‖ ≤
      W * ((Ψ₁_K (Real.exp δ * Y) - Ψ₁_K Y) - δ * ψ_K Y) :=
    mitsui_primePower_char_fundamentalCone_riesz_forward_diff_le_uncond Y δ hY_pos hδ_pos q hq ψ
  have h_bwd : W * (Ψ₁_K Y - Ψ₁_K (Real.exp (-δ) * Y)) ≤ W * (δ * ψ_K Y) :=
    mul_le_mul_of_nonneg_left (mitsui_primePowers_ge_riesz_backward_diff Y δ hY_pos hδ_pos)
