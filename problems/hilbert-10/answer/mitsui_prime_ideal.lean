import Mathlib
import Hilbert10Defs
set_option maxHeartbeats 4000000

/-! ### Statement (originally `mitsui_prime_ideal.lean`) -/

/--
**Mitsui's prime ideal theorem.** Let `K` be a number field and `A > 1`. There are a
constant `c > 0` and positive weights `κ(𝔮)` such that for all `X > 1`, every convex
open `C ⊆ K ⊗ ℝ` contained in the region of size `X`, every nonzero ideal `𝔮` with
`N(𝔮) < (log X)^A` and every unit `α` mod `𝔮`, the sum `∑ log N(π)` over prime elements
`π ∈ C` with `π ≡ α (mod 𝔮)` equals `κ(𝔮) · Vol(C)` up to an error of size
`c · X^n · exp(-√(log X) / c)`.
-/

theorem mitsui_prime_to_vonMangoldt_filter_le {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (C : Set (NumberField.mixedEmbedding.mixedSpace K))
    (hC_bdd : ∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < X)
    (P : NumberField.RingOfIntegers K → Prop) :
    |(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C ∧ P π},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      - (∑' x : {x : NumberField.RingOfIntegers K //
            NumberField.mixedEmbedding K (x : K) ∈ C ∧ P x},
          vonMangoldtO (x : NumberField.RingOfIntegers K))|
    ≤ |(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      - (∑' x : {x : NumberField.RingOfIntegers K //
            NumberField.mixedEmbedding K (x : K) ∈ C},
          vonMangoldtO (x : NumberField.RingOfIntegers K))| :=
by
  classical
  let B_C : Set K := {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}
  have hB_fin : B_C.Finite := NumberField.Embeddings.finite_of_norm_le K ℂ X
  let S_C : Set (NumberField.RingOfIntegers K) :=
    {x : NumberField.RingOfIntegers K | NumberField.mixedEmbedding K (x : K) ∈ C}
  have hpre_fin : (algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_C).Finite :=
    hB_fin.preimage NumberField.RingOfIntegers.coe_injective.injOn
  have hS_sub : S_C ⊆ algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_C := by
    intro x hx
    refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, ?_⟩
    intro φ
    let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
    have hw1 : w (x : K) = ‖φ (x : K)‖ := NumberField.InfinitePlace.apply φ (x : K)
    have hw2 : NumberField.mixedEmbedding.normAtPlace w (NumberField.mixedEmbedding K (x : K)) = w (x : K) :=
      NumberField.mixedEmbedding.normAtPlace_apply w (x : K)
    have hlt : NumberField.mixedEmbedding.normAtPlace w (NumberField.mixedEmbedding K (x : K)) < X :=
      hC_bdd _ hx w
    change ‖φ (x : K)‖ ≤ X
    linarith
  have hS_fin : S_C.Finite := hpre_fin.subset hS_sub
  let F : Finset (NumberField.RingOfIntegers K) := hS_fin.toFinset
  have hF_mem : ∀ x : NumberField.RingOfIntegers K,
      x ∈ F ↔ NumberField.mixedEmbedding K (x : K) ∈ C :=
    fun x => hS_fin.mem_toFinset
  have h_nonneg : ∀ x : NumberField.RingOfIntegers K, 0 ≤ vonMangoldtO x := by
    intro x
    dsimp [vonMangoldtO]
    split_ifs with h
    · exact Real.log_natCast_nonneg _
    · exact le_rfl
  have h_prime_eq : ∀ π : NumberField.RingOfIntegers K, Prime π →
      vonMangoldtO π = Real.log ((Algebra.norm ℤ π).natAbs : ℝ) := by
    intro π hπ
    have hπ_ne : π ≠ 0 := hπ.ne_zero
    have hI_ne_bot : Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) ≠ ⊥ :=
      Ideal.span_singleton_eq_bot.not.mpr hπ_ne
    have hI_prime : (Ideal.span ({π} : Set (NumberField.RingOfIntegers K))).IsPrime :=
      (Ideal.span_singleton_prime hπ_ne).mpr hπ
    let p₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) :=
      ⟨Ideal.span {π}, hI_prime, hI_ne_bot⟩
    have hex : ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ∃ m : ℕ, 0 < m ∧ Ideal.span {π} = p.asIdeal ^ m :=
      ⟨p₀, 1, zero_lt_one, (pow_one _).symm⟩
    have h_unfold : vonMangoldtO π = Real.log (Ideal.absNorm hex.choose.asIdeal) := by
      dsimp [vonMangoldtO]
      exact dif_pos hex
    obtain ⟨m, hm_pos, hm_eq⟩ := hex.choose_spec
    have h_le : p₀.asIdeal ≤ hex.choose.asIdeal :=
      hm_eq.le.trans (Ideal.pow_le_self hm_pos.ne')
    have h_max : p₀.asIdeal.IsMaximal := IsDedekindDomain.HeightOneSpectrum.isMaximal p₀
    have h_ne_top : hex.choose.asIdeal ≠ ⊤ := hex.choose.isPrime.ne_top
    have h_ideal_eq : hex.choose.asIdeal = Ideal.span {π} :=
      (h_max.eq_of_le h_ne_top h_le).symm
    rw [h_unfold, h_ideal_eq, Ideal.absNorm_span_singleton]
  have h_eval : ∀ (Q : NumberField.RingOfIntegers K → Prop)
      (hQ : ∀ x : NumberField.RingOfIntegers K, Q x → NumberField.mixedEmbedding K (x : K) ∈ C),
      |(∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ Q π},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
        - (∑' x : {x : NumberField.RingOfIntegers K // Q x},
            vonMangoldtO (x : NumberField.RingOfIntegers K))|
      = ∑ x ∈ (F.filter Q).filter (fun x => ¬ Prime x), vonMangoldtO x := by
    intro Q hQ
    have h_tsum_prime_congr :
        (∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ Q π},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
        = ∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ Q π},
            vonMangoldtO (π : NumberField.RingOfIntegers K) := by
      refine tsum_congr (fun π => ?_)
      exact (h_prime_eq π.1 π.2.1).symm
    have h_iff1 : ∀ x : NumberField.RingOfIntegers K,
        (Prime x ∧ Q x) ↔ x ∈ (F.filter Q).filter Prime := by
      intro x
      simp only [Finset.mem_filter, hF_mem]
      exact ⟨fun ⟨hp, hq⟩ => ⟨⟨hQ x hq, hq⟩, hp⟩, fun ⟨⟨_, hq⟩, hp⟩ => ⟨hp, hq⟩⟩
    let e₁ : {x : NumberField.RingOfIntegers K // Prime x ∧ Q x} ≃
        {x : NumberField.RingOfIntegers K // x ∈ (F.filter Q).filter Prime} :=
      Equiv.subtypeEquivRight h_iff1
    have h_tsum1 :
        (∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ Q π},
          vonMangoldtO (π : NumberField.RingOfIntegers K))
        = ∑ x ∈ (F.filter Q).filter Prime, vonMangoldtO x := by
      rw [← Equiv.tsum_eq e₁.symm (fun x => vonMangoldtO (x : NumberField.RingOfIntegers K))]
      exact Finset.tsum_subtype ((F.filter Q).filter Prime) vonMangoldtO
    have h_iff2 : ∀ x : NumberField.RingOfIntegers K,
        Q x ↔ x ∈ F.filter Q := by
      intro x
      simp only [Finset.mem_filter, hF_mem]
      exact ⟨fun hq => ⟨hQ x hq, hq⟩, fun ⟨_, hq⟩ => hq⟩
    let e₂ : {x : NumberField.RingOfIntegers K // Q x} ≃
        {x : NumberField.RingOfIntegers K // x ∈ F.filter Q} :=
      Equiv.subtypeEquivRight h_iff2
    have h_tsum2 :
        (∑' x : {x : NumberField.RingOfIntegers K // Q x},
          vonMangoldtO (x : NumberField.RingOfIntegers K))
        = ∑ x ∈ F.filter Q, vonMangoldtO x := by
      rw [← Equiv.tsum_eq e₂.symm (fun x => vonMangoldtO (x : NumberField.RingOfIntegers K))]
      exact Finset.tsum_subtype (F.filter Q) vonMangoldtO
    have h_split :
        ∑ x ∈ (F.filter Q).filter Prime, vonMangoldtO x +
        ∑ x ∈ (F.filter Q).filter (fun x => ¬ Prime x), vonMangoldtO x =
        ∑ x ∈ F.filter Q, vonMangoldtO x :=
      Finset.sum_filter_add_sum_filter_not (F.filter Q) Prime vonMangoldtO
    have h_rem_nonneg : 0 ≤ ∑ x ∈ (F.filter Q).filter (fun x => ¬ Prime x), vonMangoldtO x :=
      Finset.sum_nonneg (fun x _ => h_nonneg x)
    rw [h_tsum_prime_congr, h_tsum1, h_tsum2, ← h_split]
    have h_sub :
        (∑ x ∈ (F.filter Q).filter Prime, vonMangoldtO x) -
        (∑ x ∈ (F.filter Q).filter Prime, vonMangoldtO x +
         ∑ x ∈ (F.filter Q).filter (fun x => ¬ Prime x), vonMangoldtO x) =
        - (∑ x ∈ (F.filter Q).filter (fun x => ¬ Prime x), vonMangoldtO x) := by ring
    rw [h_sub, abs_neg, abs_of_nonneg h_rem_nonneg]
  let Q₁ : NumberField.RingOfIntegers K → Prop :=
    fun x => NumberField.mixedEmbedding K (x : K) ∈ C ∧ P x
  let Q₂ : NumberField.RingOfIntegers K → Prop :=
    fun x => NumberField.mixedEmbedding K (x : K) ∈ C
  have h_lhs := h_eval Q₁ (fun x hx => hx.1)
  have h_rhs := h_eval Q₂ (fun x hx => hx)
  rw [h_lhs, h_rhs]
  refine Finset.sum_le_sum_of_subset_of_nonneg ?_ (fun x _ _ => h_nonneg x)
  intro x hx
  simp only [Finset.mem_filter] at hx ⊢
  exact ⟨⟨hx.1.1, hx.1.2.1⟩, hx.2⟩

theorem mitsui_vonMangoldt_diff_le_prime_power_card {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (X : ℝ) (hX : 1 < X)
    (C : Set (NumberField.mixedEmbedding.mixedSpace K))
    (hC_bdd : ∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < X) :
    |(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      - (∑' x : {x : NumberField.RingOfIntegers K //
            NumberField.mixedEmbedding K (x : K) ∈ C},
          vonMangoldtO (x : NumberField.RingOfIntegers K))|
      ≤ (Module.finrank ℚ K : ℝ) * Real.log X *
        (Nat.card {x : NumberField.RingOfIntegers K //
          (∀ w : NumberField.InfinitePlace K, w (x : K) < X) ∧
          ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
            ∃ m : ℕ, 2 ≤ m ∧ Ideal.span {x} = p.asIdeal ^ m} : ℝ) :=
by
  classical
  let B_C : Set K := {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}
  have hB_fin : B_C.Finite := NumberField.Embeddings.finite_of_norm_le K ℂ X
  have hpre_fin : (algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_C).Finite :=
    hB_fin.preimage NumberField.RingOfIntegers.coe_injective.injOn
  let B_X : Set (NumberField.RingOfIntegers K) :=
    {x : NumberField.RingOfIntegers K | ∀ w : NumberField.InfinitePlace K, w (x : K) < X}
  have hBX_sub : B_X ⊆ algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_C := by
    intro x hx
    refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, ?_⟩
    intro φ
    let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
    have hw1 : w (x : K) = ‖φ (x : K)‖ := NumberField.InfinitePlace.apply φ (x : K)
    have hlt : w (x : K) < X := hx w
    change ‖φ (x : K)‖ ≤ X
    linarith
  have hBX_fin : B_X.Finite := hpre_fin.subset hBX_sub
  let S_C : Set (NumberField.RingOfIntegers K) :=
    {x : NumberField.RingOfIntegers K | NumberField.mixedEmbedding K (x : K) ∈ C}
  have hSC_sub : S_C ⊆ B_X := by
    intro x hx w
    have hw2 : NumberField.mixedEmbedding.normAtPlace w (NumberField.mixedEmbedding K (x : K)) = w (x : K) :=
      NumberField.mixedEmbedding.normAtPlace_apply w (x : K)
    have hlt : NumberField.mixedEmbedding.normAtPlace w (NumberField.mixedEmbedding K (x : K)) < X :=
      hC_bdd _ hx w
    linarith
  have hS_fin : S_C.Finite := hBX_fin.subset hSC_sub
  let F : Finset (NumberField.RingOfIntegers K) := hS_fin.toFinset
  have hF_mem : ∀ x : NumberField.RingOfIntegers K,
      x ∈ F ↔ NumberField.mixedEmbedding K (x : K) ∈ C :=
    fun x => hS_fin.mem_toFinset
  let S_pp : Set (NumberField.RingOfIntegers K) :=
    {x : NumberField.RingOfIntegers K |
      (∀ w : NumberField.InfinitePlace K, w (x : K) < X) ∧
      ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ∃ m : ℕ, 2 ≤ m ∧ Ideal.span {x} = p.asIdeal ^ m}
  have hSpp_fin : S_pp.Finite := hBX_fin.subset (fun _ hx => hx.1)
  let F_pp : Finset (NumberField.RingOfIntegers K) := hSpp_fin.toFinset
  have hFpp_mem : ∀ x : NumberField.RingOfIntegers K,
      x ∈ F_pp ↔ ((∀ w : NumberField.InfinitePlace K, w (x : K) < X) ∧
        ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          ∃ m : ℕ, 2 ≤ m ∧ Ideal.span {x} = p.asIdeal ^ m) :=
    fun x => hSpp_fin.mem_toFinset
  have hcard_Spp : F_pp.card = Nat.card S_pp := by
    letI : Fintype S_pp := hSpp_fin.fintype
    rw [Nat.card_eq_fintype_card, hSpp_fin.card_toFinset]
  have h_nonneg : ∀ x : NumberField.RingOfIntegers K, 0 ≤ vonMangoldtO x := by
    intro x
    dsimp [vonMangoldtO]
    split_ifs with h
    · exact Real.log_natCast_nonneg _
    · exact le_rfl
  have h_prime_eq : ∀ π : NumberField.RingOfIntegers K, Prime π →
      vonMangoldtO π = Real.log ((Algebra.norm ℤ π).natAbs : ℝ) := by
    intro π hπ
    have hπ_ne : π ≠ 0 := hπ.ne_zero
    have hI_ne_bot : Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) ≠ ⊥ :=
      Ideal.span_singleton_eq_bot.not.mpr hπ_ne
    have hI_prime : (Ideal.span ({π} : Set (NumberField.RingOfIntegers K))).IsPrime :=
      (Ideal.span_singleton_prime hπ_ne).mpr hπ
    let p₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) :=
      ⟨Ideal.span {π}, hI_prime, hI_ne_bot⟩
    have hex : ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ∃ m : ℕ, 0 < m ∧ Ideal.span {π} = p.asIdeal ^ m :=
      ⟨p₀, 1, zero_lt_one, (pow_one _).symm⟩
    have h_unfold : vonMangoldtO π = Real.log (Ideal.absNorm hex.choose.asIdeal) := by
      dsimp [vonMangoldtO]
      exact dif_pos hex
    obtain ⟨m, hm_pos, hm_eq⟩ := hex.choose_spec
    have h_le : p₀.asIdeal ≤ hex.choose.asIdeal :=
      hm_eq.le.trans (Ideal.pow_le_self hm_pos.ne')
    have h_max : p₀.asIdeal.IsMaximal := IsDedekindDomain.HeightOneSpectrum.isMaximal p₀
    have h_ne_top : hex.choose.asIdeal ≠ ⊤ := hex.choose.isPrime.ne_top
    have h_ideal_eq : hex.choose.asIdeal = Ideal.span {π} :=
      (h_max.eq_of_le h_ne_top h_le).symm
    rw [h_unfold, h_ideal_eq, Ideal.absNorm_span_singleton]
  have h_tsum_prime_congr :
      (∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      = ∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C},
          vonMangoldtO (π : NumberField.RingOfIntegers K) := by
    refine tsum_congr (fun π => ?_)
    exact (h_prime_eq π.1 π.2.1).symm
  have h_iff1 : ∀ x : NumberField.RingOfIntegers K,
      (Prime x ∧ NumberField.mixedEmbedding K (x : K) ∈ C) ↔ x ∈ F.filter Prime := by
    intro x
    simp only [Finset.mem_filter, hF_mem, and_comm]
  let e₁ : {x : NumberField.RingOfIntegers K // Prime x ∧ NumberField.mixedEmbedding K (x : K) ∈ C} ≃
      {x : NumberField.RingOfIntegers K // x ∈ F.filter Prime} :=
    Equiv.subtypeEquivRight h_iff1
  have h_tsum1 :
      (∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C},
        vonMangoldtO (π : NumberField.RingOfIntegers K))
      = ∑ x ∈ F.filter Prime, vonMangoldtO x := by
    rw [← Equiv.tsum_eq e₁.symm (fun x => vonMangoldtO (x : NumberField.RingOfIntegers K))]
    exact Finset.tsum_subtype (F.filter Prime) vonMangoldtO
  let e₂ : {x : NumberField.RingOfIntegers K // NumberField.mixedEmbedding K (x : K) ∈ C} ≃
      {x : NumberField.RingOfIntegers K // x ∈ F} :=
    Equiv.subtypeEquivRight (fun x => (hF_mem x).symm)
  have h_tsum2 :
      (∑' x : {x : NumberField.RingOfIntegers K // NumberField.mixedEmbedding K (x : K) ∈ C},
        vonMangoldtO (x : NumberField.RingOfIntegers K))
      = ∑ x ∈ F, vonMangoldtO x := by
    rw [← Equiv.tsum_eq e₂.symm (fun x => vonMangoldtO (x : NumberField.RingOfIntegers K))]
    exact Finset.tsum_subtype F vonMangoldtO
  have h_split :
      ∑ x ∈ F.filter Prime, vonMangoldtO x +
      ∑ x ∈ F.filter (fun x => ¬ Prime x), vonMangoldtO x =
      ∑ x ∈ F, vonMangoldtO x :=
    Finset.sum_filter_add_sum_filter_not F Prime vonMangoldtO
  have h_rem_nonneg : 0 ≤ ∑ x ∈ F.filter (fun x => ¬ Prime x), vonMangoldtO x :=
    Finset.sum_nonneg (fun x _ => h_nonneg x)
  have h_lhs_eq :
      |(∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
        - (∑' x : {x : NumberField.RingOfIntegers K //
              NumberField.mixedEmbedding K (x : K) ∈ C},
            vonMangoldtO (x : NumberField.RingOfIntegers K))|
      = ∑ x ∈ F.filter (fun x => ¬ Prime x), vonMangoldtO x := by
    rw [h_tsum_prime_congr, h_tsum1, h_tsum2, ← h_split]
    have h_sub :
        (∑ x ∈ F.filter Prime, vonMangoldtO x) -
        (∑ x ∈ F.filter Prime, vonMangoldtO x +
         ∑ x ∈ F.filter (fun x => ¬ Prime x), vonMangoldtO x) =
        - (∑ x ∈ F.filter (fun x => ¬ Prime x), vonMangoldtO x) := by ring
    rw [h_sub, abs_neg, abs_of_nonneg h_rem_nonneg]
  let P_supp : NumberField.RingOfIntegers K → Prop :=
    fun x => ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ∃ m : ℕ, 0 < m ∧ Ideal.span {x} = p.asIdeal ^ m
  let F_supp : Finset (NumberField.RingOfIntegers K) :=
    (F.filter (fun x => ¬ Prime x)).filter P_supp
  have h_supp_split :
      ∑ x ∈ F_supp, vonMangoldtO x +
      ∑ x ∈ (F.filter (fun x => ¬ Prime x)).filter (fun x => ¬ P_supp x), vonMangoldtO x =
      ∑ x ∈ F.filter (fun x => ¬ Prime x), vonMangoldtO x :=
    Finset.sum_filter_add_sum_filter_not (F.filter (fun x => ¬ Prime x)) P_supp vonMangoldtO
  have h_not_supp_zero :
      ∑ x ∈ (F.filter (fun x => ¬ Prime x)).filter (fun x => ¬ P_supp x), vonMangoldtO x = 0 := by
    refine Finset.sum_eq_zero (fun x hx => ?_)
    simp only [Finset.mem_filter] at hx
    dsimp [vonMangoldtO]
    exact dif_neg hx.2
  have h_sum_supp :
      ∑ x ∈ F.filter (fun x => ¬ Prime x), vonMangoldtO x = ∑ x ∈ F_supp, vonMangoldtO x := by
    linarith
  have h_sub_pp : F_supp ⊆ F_pp := by
    intro x hx
    simp only [F_supp, Finset.mem_filter, hF_mem] at hx
    rcases hx with ⟨⟨hxC, hnprime⟩, p, m, hm_pos, hm_eq⟩
    rw [hFpp_mem]
    refine ⟨fun w => hSC_sub hxC w, p, m, ?_, hm_eq⟩
    by_contra! hm_lt
    have hm1 : m = 1 := by omega
    have h_span : Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = p.asIdeal := by
      rw [hm_eq, hm1, pow_one]
    have hx_ne : x ≠ 0 := by
      intro hx0
      apply p.ne_bot
      rw [← h_span, Ideal.span_singleton_eq_bot.mpr hx0]
    have hI_prime : (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))).IsPrime := by
      rw [h_span]
      exact p.isPrime
    exact hnprime ((Ideal.span_singleton_prime hx_ne).mp hI_prime)
  have h_le_pp : ∑ x ∈ F_supp, vonMangoldtO x ≤ ∑ x ∈ F_pp, vonMangoldtO x :=
    Finset.sum_le_sum_of_subset_of_nonneg h_sub_pp (fun x _ _ => h_nonneg x)
  have h_ptwise : ∀ x ∈ F_pp,
      vonMangoldtO x ≤ (Module.finrank ℚ K : ℝ) * Real.log X := by
    intro x hx
    have hx_box : ∀ w : NumberField.InfinitePlace K, w (x : K) < X :=
      ((hFpp_mem x).mp hx).1
    have hlog_pos : 0 < Real.log X := Real.log_pos hX
    dsimp [vonMangoldtO]
    split_ifs with hex
    · let p := hex.choose
      obtain ⟨m, hm_pos, hm_eq⟩ := hex.choose_spec
      have hp_ne_zero : Ideal.absNorm p.asIdeal ≠ 0 :=
        Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
      have hp_pos : 0 < (Ideal.absNorm p.asIdeal : ℝ) := by
        exact_mod_cast Nat.pos_of_ne_zero hp_ne_zero
      have h_pow_eq : Ideal.absNorm (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))) =
          (Ideal.absNorm p.asIdeal) ^ m := by
        rw [hm_eq, map_pow]
      have h_nat_le : Ideal.absNorm p.asIdeal ≤ (Algebra.norm ℤ x).natAbs := by
        calc Ideal.absNorm p.asIdeal
            ≤ (Ideal.absNorm p.asIdeal) ^ m := Nat.le_self_pow hm_pos.ne' _
          _ = Ideal.absNorm (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))) := h_pow_eq.symm
          _ = (Algebra.norm ℤ x).natAbs := Ideal.absNorm_span_singleton x
      have h_real_le1 : (Ideal.absNorm p.asIdeal : ℝ) ≤ ((Algebra.norm ℤ x).natAbs : ℝ) := by
        exact_mod_cast h_nat_le
      have h_norm_eq : ((Algebra.norm ℤ x).natAbs : ℝ) =
          ∏ w : NumberField.InfinitePlace K, w (x : K) ^ w.mult := by
        rw [NumberField.InfinitePlace.prod_eq_abs_norm (x : K), ← Algebra.coe_norm_int x,
          Nat.cast_natAbs]
        push_cast
        rfl
      have h_prod_le : (∏ w : NumberField.InfinitePlace K, w (x : K) ^ w.mult) ≤
          X ^ (Module.finrank ℚ K) := by
        calc (∏ w : NumberField.InfinitePlace K, w (x : K) ^ w.mult)
            ≤ ∏ w : NumberField.InfinitePlace K, X ^ w.mult := by
              refine Finset.prod_le_prod (fun w _ => by positivity) (fun w _ => ?_)
              exact pow_le_pow_left₀ (apply_nonneg w (x : K)) (le_of_lt (hx_box w)) w.mult
          _ = X ^ (∑ w : NumberField.InfinitePlace K, w.mult) :=
              Finset.prod_pow_eq_pow_sum Finset.univ (fun w : NumberField.InfinitePlace K => w.mult) X
          _ = X ^ (Module.finrank ℚ K) := by
              rw [NumberField.InfinitePlace.sum_mult_eq]
      have h_p_le_X : (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K) := by
        linarith
      calc Real.log (Ideal.absNorm p.asIdeal)
          ≤ Real.log (X ^ (Module.finrank ℚ K)) := Real.log_le_log hp_pos h_p_le_X
        _ = (Module.finrank ℚ K : ℝ) * Real.log X := Real.log_pow X (Module.finrank ℚ K)
    · positivity
  have h_sum_bound :
      ∑ x ∈ F_pp, vonMangoldtO x ≤
      (Module.finrank ℚ K : ℝ) * Real.log X * (Nat.card S_pp : ℝ) := by
    calc ∑ x ∈ F_pp, vonMangoldtO x
        ≤ ∑ _x ∈ F_pp, ((Module.finrank ℚ K : ℝ) * Real.log X) :=
          Finset.sum_le_sum h_ptwise
      _ = F_pp.card • ((Module.finrank ℚ K : ℝ) * Real.log X) :=
          Finset.sum_const _
      _ = (F_pp.card : ℝ) * ((Module.finrank ℚ K : ℝ) * Real.log X) :=
          nsmul_eq_mul _ _
      _ = (Nat.card S_pp : ℝ) * ((Module.finrank ℚ K : ℝ) * Real.log X) := by
          rw [hcard_Spp]
      _ = (Module.finrank ℚ K : ℝ) * Real.log X * (Nat.card S_pp : ℝ) := by
          ring
  rw [h_lhs_eq, h_sum_supp]
  exact h_le_pp.trans h_sum_bound

theorem mitsui_prime_power_elts_le_ideals_mul_units {K : Type u} [Field K] [NumberField K] :
    ∃ c_unit : ℝ, 0 < c_unit ∧
      ∀ X : ℝ, 1 < X →
        (Nat.card {x : NumberField.RingOfIntegers K //
          (∀ w : NumberField.InfinitePlace K, w (x : K) < X) ∧
          ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
            ∃ m : ℕ, 2 ≤ m ∧ Ideal.span {x} = p.asIdeal ^ m} : ℝ) ≤
        c_unit * (Real.log X + 1) ^ (NumberField.Units.rank K) *
          (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
            (Ideal.absNorm I : ℝ) < X ^ (Module.finrank ℚ K) ∧
            ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
              ∃ m : ℕ, 2 ≤ m ∧ I = p.asIdeal ^ m} : ℝ) :=
by
  classical
  have h_box_absNorm : ∀ (X : ℝ) (x : NumberField.RingOfIntegers K),
      x ≠ 0 → (∀ w : NumberField.InfinitePlace K, w (x : K) < X) →
      (Ideal.absNorm (Ideal.span {x}) : ℝ) < X ^ (Module.finrank ℚ K) := by
    intro X x hx_ne hx_box
    have hx_coe : (x : K) ≠ 0 := by exact_mod_cast hx_ne
    have hprod_lt : ∏ w : NumberField.InfinitePlace K, w (x : K) ^ w.mult <
        ∏ w : NumberField.InfinitePlace K, X ^ w.mult := by
      apply Finset.prod_lt_prod_of_nonempty
      · intro w _
        exact pow_pos (w.pos_iff.mpr hx_coe) w.mult
      · intro w _
        exact pow_lt_pow_left₀ (hx_box w) (le_of_lt (w.pos_iff.mpr hx_coe))
          (NumberField.InfinitePlace.mult_pos.ne')
      · exact Finset.univ_nonempty
    have hrhs : ∏ w : NumberField.InfinitePlace K, X ^ w.mult = X ^ (Module.finrank ℚ K) := by
      rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq]
    have hlhs : ∏ w : NumberField.InfinitePlace K, w (x : K) ^ w.mult =
        (Ideal.absNorm (Ideal.span {x}) : ℝ) := by
      rw [NumberField.InfinitePlace.prod_eq_abs_norm, Ideal.absNorm_span_singleton,
        Nat.cast_natAbs, Int.cast_abs, ← Algebra.coe_norm_int]
      simp
    linarith
  have h_box_ratio : ∀ (X : ℝ), 1 < X → ∀ (y : NumberField.RingOfIntegers K),
      y ≠ 0 → (∀ v : NumberField.InfinitePlace K, v (y : K) < X) →
      ∀ (w : NumberField.InfinitePlace K),
      (X / w (y : K)) ^ w.mult ≤ X ^ (Module.finrank ℚ K) := by
    intro X hX y hy_ne hy_box w
    have hy_coe : (y : K) ≠ 0 := by exact_mod_cast hy_ne
    have hX_pos : 0 < X := by linarith
    have h_one_le : ∀ v : NumberField.InfinitePlace K, 1 ≤ (X / v (y : K)) ^ v.mult := by
      intro v
      have hv_pos : 0 < v (y : K) := v.pos_iff.mpr hy_coe
      have hv_le : v (y : K) ≤ X := le_of_lt (hy_box v)
      exact one_le_pow₀ ((one_le_div hv_pos).mpr hv_le)
    have h_single : (X / w (y : K)) ^ w.mult ≤
        ∏ v : NumberField.InfinitePlace K, (X / v (y : K)) ^ v.mult := by
      rw [← Finset.mul_prod_erase Finset.univ
        (fun v : NumberField.InfinitePlace K => (X / v (y : K)) ^ v.mult) (Finset.mem_univ w)]
      have h1 : 1 ≤ ∏ v ∈ Finset.univ.erase w, (X / v (y : K)) ^ v.mult :=
        Finset.one_le_prod (Finset.univ.erase w) h_one_le
      have h0 : 0 ≤ (X / w (y : K)) ^ w.mult := le_trans zero_le_one (h_one_le w)
      exact le_mul_of_one_le_right h0 h1
    have h_prod : ∏ v : NumberField.InfinitePlace K, (X / v (y : K)) ^ v.mult =
        X ^ (Module.finrank ℚ K) / (|(Algebra.norm ℚ (y : K))| : ℝ) := by
      simp_rw [div_pow]
      rw [Finset.prod_div_distrib, Finset.prod_pow_eq_pow_sum,
        NumberField.InfinitePlace.sum_mult_eq, NumberField.InfinitePlace.prod_eq_abs_norm]
      simp
    have h_norm_ge_one : (1 : ℝ) ≤ (|(Algebra.norm ℚ (y : K))| : ℝ) := by
      have hnorm_ne : Algebra.norm ℚ (y : K) ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy_coe
      have hint_ne : Algebra.norm ℤ y ≠ 0 := by
        intro h0
        apply hnorm_ne
        rw [← Algebra.coe_norm_int y, h0, Int.cast_zero]
      have habs_ge : (1 : ℤ) ≤ |Algebra.norm ℤ y| := Int.one_le_abs hint_ne
      have hcast : (|(Algebra.norm ℚ (y : K))| : ℝ) = ((|Algebra.norm ℤ y| : ℤ) : ℝ) := by
        rw [← Algebra.coe_norm_int y]
        push_cast
        rfl
      rw [hcast]
      exact_mod_cast habs_ge
    have h_div_le : X ^ (Module.finrank ℚ K) / (|(Algebra.norm ℚ (y : K))| : ℝ) ≤
        X ^ (Module.finrank ℚ K) :=
      div_le_self (by positivity) h_norm_ge_one
    linarith
  have h_unit_upper : ∀ (X : ℝ), 1 < X → ∀ (x x₀ : NumberField.RingOfIntegers K),
      x ≠ 0 → x₀ ≠ 0 →
      (∀ w : NumberField.InfinitePlace K, w (x : K) < X) →
      (∀ w : NumberField.InfinitePlace K, w (x₀ : K) < X) →
      ∀ (u : (NumberField.RingOfIntegers K)ˣ), (u : NumberField.RingOfIntegers K) * x₀ = x →
      ∀ (w : NumberField.InfinitePlace K),
      (w.mult : ℝ) * Real.log (w ((u : NumberField.RingOfIntegers K) : K)) ≤
        (Module.finrank ℚ K : ℝ) * Real.log X := by
    intro X hX x x₀ _hx_ne hx₀_ne hx_box hx₀_box u hu w
    have hx₀_coe : (x₀ : K) ≠ 0 := by exact_mod_cast hx₀_ne
    have hu_coe : ((u : NumberField.RingOfIntegers K) : K) ≠ 0 := by exact_mod_cast u.ne_zero
    have hw_x₀_pos : 0 < w (x₀ : K) := w.pos_iff.mpr hx₀_coe
    have hw_u_pos : 0 < w ((u : NumberField.RingOfIntegers K) : K) := w.pos_iff.mpr hu_coe
    have hw_mul : w ((u : NumberField.RingOfIntegers K) : K) * w (x₀ : K) = w (x : K) := by
      rw [← map_mul]
      congr 1
      exact_mod_cast hu
    have hu_le : w ((u : NumberField.RingOfIntegers K) : K) ≤ X / w (x₀ : K) := by
      rw [le_div_iff₀ hw_x₀_pos, hw_mul]
      exact le_of_lt (hx_box w)
    have hpow_le : w ((u : NumberField.RingOfIntegers K) : K) ^ w.mult ≤
        X ^ (Module.finrank ℚ K) :=
      le_trans (pow_le_pow_left₀ (le_of_lt hw_u_pos) hu_le w.mult)
        (h_box_ratio X hX x₀ hx₀_ne hx₀_box w)
    have hlog := Real.log_le_log (pow_pos hw_u_pos w.mult) hpow_le
    rwa [Real.log_pow, Real.log_pow] at hlog
  have h_unit_log : ∀ (X : ℝ), 1 < X → ∀ (x x₀ : NumberField.RingOfIntegers K),
      x ≠ 0 → x₀ ≠ 0 →
      (∀ w : NumberField.InfinitePlace K, w (x : K) < X) →
      (∀ w : NumberField.InfinitePlace K, w (x₀ : K) < X) →
      ∀ (u : (NumberField.RingOfIntegers K)ˣ), (u : NumberField.RingOfIntegers K) * x₀ = x →
      ∀ (w : NumberField.InfinitePlace K),
      |(w.mult : ℝ) * Real.log (w ((u : NumberField.RingOfIntegers K) : K))| ≤
        (Module.finrank ℚ K : ℝ) * Real.log X := by
    intro X hX x x₀ hx_ne hx₀_ne hx_box hx₀_box u hu w
    rw [abs_le]
    refine ⟨?_, h_unit_upper X hX x x₀ hx_ne hx₀_ne hx_box hx₀_box u hu w⟩
    have hu_inv : ((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * x = x₀ := by
      rw [← hu, ← mul_assoc, Units.inv_mul, one_mul]
    have h2 := h_unit_upper X hX x₀ x hx₀_ne hx_ne hx₀_box hx_box u⁻¹ hu_inv w
    have hw_inv : w (((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) =
        (w ((u : NumberField.RingOfIntegers K) : K))⁻¹ := by
      have hmul : (((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
          ((u : NumberField.RingOfIntegers K) : K) = 1 := by
        exact_mod_cast Units.inv_mul u
      have hw1 : w (((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
          w ((u : NumberField.RingOfIntegers K) : K) = 1 := by
        rw [← map_mul, hmul, map_one]
      exact eq_inv_of_mul_eq_one_left hw1
    rw [hw_inv, Real.log_inv, mul_neg] at h2
    linarith
  have h_units_card : ∃ c_unit : ℝ, 0 < c_unit ∧
      ∀ X : ℝ, 1 < X →
        Finite {u : (NumberField.RingOfIntegers K)ˣ //
          ∀ w : NumberField.InfinitePlace K,
            |(w.mult : ℝ) * Real.log (w ((u : NumberField.RingOfIntegers K) : K))| ≤
              (Module.finrank ℚ K : ℝ) * Real.log X} ∧
        (Nat.card {u : (NumberField.RingOfIntegers K)ˣ //
          ∀ w : NumberField.InfinitePlace K,
            |(w.mult : ℝ) * Real.log (w ((u : NumberField.RingOfIntegers K) : K))| ≤
              (Module.finrank ℚ K : ℝ) * Real.log X} : ℝ) ≤
          c_unit * (Real.log X + 1) ^ (NumberField.Units.rank K) := by
    let n : ℕ := Module.finrank ℚ K
    let r : ℕ := NumberField.Units.rank K
    let B_R : Module.Basis (Fin r) ℝ (NumberField.Units.dirichletUnitTheorem.logSpace K) :=
      Module.Basis.ofZLatticeBasis ℝ
        (NumberField.Units.unitLattice K)
        (NumberField.Units.basisUnitLattice K)
    let L : Fin r → (NumberField.Units.dirichletUnitTheorem.logSpace K →L[ℝ] ℝ) :=
      fun i => (B_R.coord i).toContinuousLinearMap
    let M_K : ℝ := (n : ℝ) * ∑ i : Fin r, ‖L i‖
    have hM_nonneg : 0 ≤ M_K := by
      dsimp [M_K]
      positivity
    let C₀ : ℕ := 2 * ⌈M_K⌉₊ + 1
    let c_unit : ℝ := (Fintype.card (NumberField.Units.torsion K) : ℝ) * (C₀ : ℝ) ^ r
    have hc_unit_pos : 0 < c_unit := by
      dsimp [c_unit, C₀]
      have htors : 0 < Fintype.card (NumberField.Units.torsion K) := Fintype.card_pos
      positivity
    let ζ : (NumberField.RingOfIntegers K)ˣ → NumberField.Units.torsion K :=
      fun u => (NumberField.Units.exist_unique_eq_mul_prod K u).exists.choose.1
    let f : (NumberField.RingOfIntegers K)ˣ → (Fin r → ℤ) :=
      fun u => (NumberField.Units.exist_unique_eq_mul_prod K u).exists.choose.2
    have hu_eq : ∀ u : (NumberField.RingOfIntegers K)ˣ,
        u = (ζ u : (NumberField.RingOfIntegers K)ˣ) *
          ∏ j : Fin r, (NumberField.Units.fundSystem K j) ^ (f u j) :=
      fun u => (NumberField.Units.exist_unique_eq_mul_prod K u).exists.choose_spec
    have hrepr : ∀ u : (NumberField.RingOfIntegers K)ˣ, ∀ i : Fin r,
        B_R.repr (NumberField.Units.logEmbedding K (Additive.ofMul u)) i =
          ((f u i : ℤ) : ℝ) := by
      intro u i
      have hζ : NumberField.Units.logEmbedding K
          (Additive.ofMul (ζ u : (NumberField.RingOfIntegers K)ˣ)) = 0 := by
        ext w
        rw [NumberField.Units.dirichletUnitTheorem.logEmbedding_component]
        have hw1 : (w : NumberField.InfinitePlace K)
            ((algebraMap (NumberField.RingOfIntegers K) K)
              (ζ u : (NumberField.RingOfIntegers K)ˣ)) = 1 :=
          (NumberField.Units.mem_torsion K).mp (ζ u).2 (w : NumberField.InfinitePlace K)
        rw [hw1, Real.log_one, mul_zero]
        rfl
      have hlog : NumberField.Units.logEmbedding K (Additive.ofMul u) =
          ∑ j : Fin r, (f u j : ℝ) • B_R j := by
        conv_lhs => rw [hu_eq u]
        rw [ofMul_mul, map_add, hζ, zero_add, ofMul_prod, map_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [ofMul_zpow, map_zsmul, NumberField.Units.logEmbedding_fundSystem]
        dsimp [B_R]
        rw [Module.Basis.ofZLatticeBasis_apply, Int.cast_smul_eq_zsmul]
      rw [hlog, map_sum]
      simp [map_smul, Module.Basis.repr_self, Finsupp.single_apply]
    refine ⟨c_unit, hc_unit_pos, fun X hX => ?_⟩
    have hlogX_pos : 0 < Real.log X := Real.log_pos hX
    have hnlogX_nonneg : 0 ≤ (n : ℝ) * Real.log X := by positivity
    let U_X := {u : (NumberField.RingOfIntegers K)ˣ //
      ∀ w : NumberField.InfinitePlace K,
        |(w.mult : ℝ) * Real.log (w ((u : NumberField.RingOfIntegers K) : K))| ≤
          (n : ℝ) * Real.log X}
    let N_X : ℕ := ⌊M_K * Real.log X⌋₊
    let I_X : Finset ℤ := Finset.Icc (-(N_X : ℤ)) (N_X : ℤ)
    have hf_mem : ∀ u : U_X, ∀ i : Fin r, f u.1 i ∈ I_X := by
      intro u i
      set v_u : NumberField.Units.dirichletUnitTheorem.logSpace K :=
        NumberField.Units.logEmbedding K (Additive.ofMul u.1)
      have hv_norm : ‖v_u‖ ≤ (n : ℝ) * Real.log X := by
        rw [pi_norm_le_iff_of_nonneg hnlogX_nonneg]
        intro w
        rw [Real.norm_eq_abs]
        exact u.2 w.1
      have hL_eval : L i v_u = ((f u.1 i : ℤ) : ℝ) := by
        exact hrepr u.1 i
      have hL_le : ‖L i‖ ≤ ∑ j : Fin r, ‖L j‖ :=
        Finset.single_le_sum (fun j _ => norm_nonneg (L j)) (Finset.mem_univ i)
      have habs_le : |((f u.1 i : ℤ) : ℝ)| ≤ M_K * Real.log X := by
        calc |((f u.1 i : ℤ) : ℝ)|
            = ‖L i v_u‖ := by rw [← hL_eval, Real.norm_eq_abs]
          _ ≤ ‖L i‖ * ‖v_u‖ := ContinuousLinearMap.le_opNorm (L i) v_u
          _ ≤ (∑ j : Fin r, ‖L j‖) * ((n : ℝ) * Real.log X) :=
              mul_le_mul hL_le hv_norm (norm_nonneg _) (Finset.sum_nonneg (fun j _ => norm_nonneg _))
          _ = M_K * Real.log X := by dsimp [M_K]; ring
      have habs_lt : ((|f u.1 i| : ℤ) : ℝ) < ((N_X : ℤ) + 1 : ℝ) := by
        have h1 : ((|f u.1 i| : ℤ) : ℝ) = |((f u.1 i : ℤ) : ℝ)| := Int.cast_abs
        have h2 : M_K * Real.log X < (N_X : ℝ) + 1 := Nat.lt_floor_add_one (M_K * Real.log X)
        push_cast
        linarith
      have habs_int_lt : |f u.1 i| < (N_X : ℤ) + 1 := by exact_mod_cast habs_lt
      have habs_int_le : |f u.1 i| ≤ (N_X : ℤ) := by omega
      exact Finset.mem_Icc.mpr (abs_le.mp habs_int_le)
    let Θ : U_X → NumberField.Units.torsion K × (Fin r → I_X) :=
      fun u => (ζ u.1, fun i => ⟨f u.1 i, hf_mem u i⟩)
    have hΘ_inj : Function.Injective Θ := by
      intro u₁ u₂ hΘ
      have hζ_eq : ζ u₁.1 = ζ u₂.1 := (Prod.ext_iff.mp hΘ).1
      have hf_eq : f u₁.1 = f u₂.1 := by
        ext i
        exact congrArg Subtype.val (congrFun (Prod.ext_iff.mp hΘ).2 i)
      apply Subtype.ext
      rw [hu_eq u₁.1, hu_eq u₂.1, hζ_eq, hf_eq]
    haveI : Finite U_X := Finite.of_injective Θ hΘ_inj
    refine ⟨inferInstance, ?_⟩
    have hcard_le : Nat.card U_X ≤ Fintype.card (NumberField.Units.torsion K) * (2 * N_X + 1) ^ r := by
      have h1 := Nat.card_le_card_of_injective Θ hΘ_inj
      have h2 : Nat.card (NumberField.Units.torsion K × (Fin r → I_X)) =
          Fintype.card (NumberField.Units.torsion K) * (2 * N_X + 1) ^ r := by
        rw [Nat.card_eq_fintype_card, Fintype.card_prod, Fintype.card_fun,
          Fintype.card_coe, Fintype.card_fin, Int.card_Icc]
        have h_icc : ((N_X : ℤ) + 1 - -(N_X : ℤ)).toNat = 2 * N_X + 1 := by omega
        rw [h_icc]
      rwa [h2] at h1
    have hN_le : (N_X : ℝ) ≤ (⌈M_K⌉₊ : ℝ) * Real.log X := by
      calc (N_X : ℝ)
          ≤ M_K * Real.log X := Nat.floor_le (by positivity)
        _ ≤ (⌈M_K⌉₊ : ℝ) * Real.log X :=
            mul_le_mul_of_nonneg_right (Nat.le_ceil M_K) (le_of_lt hlogX_pos)
    have hbase_le : (2 * (N_X : ℝ) + 1) ≤ (C₀ : ℝ) * (Real.log X + 1) := by
      have hC₀_cast : (C₀ : ℝ) = 2 * (⌈M_K⌉₊ : ℝ) + 1 := by
        dsimp [C₀]
        push_cast
        rfl
      rw [hC₀_cast]
      nlinarith
    have hpow_le : (2 * (N_X : ℝ) + 1) ^ r ≤ ((C₀ : ℝ) * (Real.log X + 1)) ^ r :=
      pow_le_pow_left₀ (by positivity) hbase_le r
    have hcard_real : (Nat.card U_X : ℝ) ≤
        (Fintype.card (NumberField.Units.torsion K) : ℝ) * (2 * (N_X : ℝ) + 1) ^ r := by
      exact_mod_cast hcard_le
    calc (Nat.card U_X : ℝ)
        ≤ (Fintype.card (NumberField.Units.torsion K) : ℝ) * (2 * (N_X : ℝ) + 1) ^ r := hcard_real
      _ ≤ (Fintype.card (NumberField.Units.torsion K) : ℝ) * ((C₀ : ℝ) * (Real.log X + 1)) ^ r :=
          mul_le_mul_of_nonneg_left hpow_le (Nat.cast_nonneg _)
      _ = c_unit * (Real.log X + 1) ^ r := by
          dsimp [c_unit]
          rw [mul_pow]
          ring
  obtain ⟨c_unit, hc_unit_pos, hc_unit⟩ := h_units_card
  refine ⟨c_unit, hc_unit_pos, fun X hX => ?_⟩
  obtain ⟨hU_fin, hU_card⟩ := hc_unit X hX
  haveI : Finite {u : (NumberField.RingOfIntegers K)ˣ //
      ∀ w : NumberField.InfinitePlace K,
        |(w.mult : ℝ) * Real.log (w ((u : NumberField.RingOfIntegers K) : K))| ≤
          (Module.finrank ℚ K : ℝ) * Real.log X} := hU_fin
  haveI : Finite {I : Ideal (NumberField.RingOfIntegers K) //
      (Ideal.absNorm I : ℝ) < X ^ (Module.finrank ℚ K) ∧
      ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ∃ m : ℕ, 2 ≤ m ∧ I = p.asIdeal ^ m} := by
    let M_norm : ℕ := ⌈X ^ (Module.finrank ℚ K)⌉₊
    have hfin_set : {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ M_norm}.Finite :=
      Ideal.finite_setOf_absNorm_le M_norm
    refine Set.Finite.to_subtype (hfin_set.subset ?_)
    intro I hI
    have hle_real : (Ideal.absNorm I : ℝ) ≤ (M_norm : ℝ) :=
      le_trans (le_of_lt hI.1) (Nat.le_ceil _)
    exact_mod_cast hle_real
  have hx_ne : ∀ x : {x : NumberField.RingOfIntegers K //
      (∀ w : NumberField.InfinitePlace K, w (x : K) < X) ∧
      ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ∃ m : ℕ, 2 ≤ m ∧ Ideal.span {x} = p.asIdeal ^ m}, x.1 ≠ 0 := by
    intro x h0
    obtain ⟨p, m, _, hspan⟩ := x.2.2
    rw [h0, Ideal.span_singleton_zero] at hspan
    exact pow_ne_zero m p.ne_bot hspan.symm
  obtain ⟨Φ, hΦ_val⟩ : ∃ Φ :
      {x : NumberField.RingOfIntegers K //
        (∀ w : NumberField.InfinitePlace K, w (x : K) < X) ∧
        ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          ∃ m : ℕ, 2 ≤ m ∧ Ideal.span {x} = p.asIdeal ^ m} →
      {I : Ideal (NumberField.RingOfIntegers K) //
        (Ideal.absNorm I : ℝ) < X ^ (Module.finrank ℚ K) ∧
        ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          ∃ m : ℕ, 2 ≤ m ∧ I = p.asIdeal ^ m},
      ∀ x, (Φ x).1 = Ideal.span {x.1} :=
    ⟨fun x => ⟨Ideal.span {x.1}, ⟨h_box_absNorm X x.1 (hx_ne x) x.2.1, x.2.2⟩⟩,
     fun _ => rfl⟩
  obtain ⟨rep, hrep⟩ : ∃ rep : Set.range Φ →
      {x : NumberField.RingOfIntegers K //
        (∀ w : NumberField.InfinitePlace K, w (x : K) < X) ∧
        ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          ∃ m : ℕ, 2 ≤ m ∧ Ideal.span {x} = p.asIdeal ^ m},
      ∀ I : Set.range Φ, Φ (rep I) = I.1 :=
    ⟨fun I => I.2.choose, fun I => I.2.choose_spec⟩
  have hex_u : ∀ x : {x : NumberField.RingOfIntegers K //
      (∀ w : NumberField.InfinitePlace K, w (x : K) < X) ∧
      ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ∃ m : ℕ, 2 ≤ m ∧ Ideal.span {x} = p.asIdeal ^ m},
      ∃ u : {u : (NumberField.RingOfIntegers K)ˣ //
        ∀ w : NumberField.InfinitePlace K,
          |(w.mult : ℝ) * Real.log (w ((u : NumberField.RingOfIntegers K) : K))| ≤
            (Module.finrank ℚ K : ℝ) * Real.log X},
        (u.1 : NumberField.RingOfIntegers K) * (rep ⟨Φ x, x, rfl⟩).1 = x.1 := by
    intro x
    let y := rep ⟨Φ x, x, rfl⟩
    have hΦ_eq : Φ y = Φ x := hrep ⟨Φ x, x, rfl⟩
    have hspan_eq : Ideal.span {y.1} = Ideal.span {x.1} := by
      rw [← hΦ_val y, ← hΦ_val x, hΦ_eq]
    obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp hspan_eq
    have hu_mul : (u : NumberField.RingOfIntegers K) * y.1 = x.1 := by
      rw [mul_comm, hu]
    refine ⟨⟨u, fun w => h_unit_log X hX x.1 y.1
      (hx_ne x) (hx_ne y) x.2.1 y.2.1 u hu_mul w⟩, hu_mul⟩
  obtain ⟨u_elt, hu_elt⟩ : ∃ u_elt :
      {x : NumberField.RingOfIntegers K //
        (∀ w : NumberField.InfinitePlace K, w (x : K) < X) ∧
        ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          ∃ m : ℕ, 2 ≤ m ∧ Ideal.span {x} = p.asIdeal ^ m} →
      {u : (NumberField.RingOfIntegers K)ˣ //
        ∀ w : NumberField.InfinitePlace K,
          |(w.mult : ℝ) * Real.log (w ((u : NumberField.RingOfIntegers K) : K))| ≤
            (Module.finrank ℚ K : ℝ) * Real.log X},
      ∀ x, ((u_elt x).1 : NumberField.RingOfIntegers K) * (rep ⟨Φ x, x, rfl⟩).1 = x.1 :=
    ⟨fun x => (hex_u x).choose, fun x => (hex_u x).choose_spec⟩
  have hΨ_inj : Function.Injective (fun x => (u_elt x, Φ x)) := by
    intro x y hΨ
    have hu_eq : u_elt x = u_elt y := (Prod.ext_iff.mp hΨ).1
    have hΦ_eq : Φ x = Φ y := (Prod.ext_iff.mp hΨ).2
    have hrep_eq : rep ⟨Φ x, x, rfl⟩ = rep ⟨Φ y, y, rfl⟩ :=
      congrArg rep (Subtype.ext hΦ_eq)
    apply Subtype.ext
    rw [← hu_elt x, ← hu_elt y, hu_eq, hrep_eq]
  have hcard_nat := Nat.card_le_card_of_injective (fun x => (u_elt x, Φ x)) hΨ_inj
  rw [Nat.card_prod] at hcard_nat
  have hcard_real : (Nat.card {x : NumberField.RingOfIntegers K //
      (∀ w : NumberField.InfinitePlace K, w (x : K) < X) ∧
      ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ∃ m : ℕ, 2 ≤ m ∧ Ideal.span {x} = p.asIdeal ^ m} : ℝ) ≤
      (Nat.card {u : (NumberField.RingOfIntegers K)ˣ //
        ∀ w : NumberField.InfinitePlace K,
          |(w.mult : ℝ) * Real.log (w ((u : NumberField.RingOfIntegers K) : K))| ≤
            (Module.finrank ℚ K : ℝ) * Real.log X} : ℝ) *
      (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
        (Ideal.absNorm I : ℝ) < X ^ (Module.finrank ℚ K) ∧
        ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          ∃ m : ℕ, 2 ≤ m ∧ I = p.asIdeal ^ m} : ℝ) := by
    exact_mod_cast hcard_nat
  exact le_trans hcard_real (mul_le_mul_of_nonneg_right hU_card (Nat.cast_nonneg _))

theorem mitsui_prime_power_ideals_card_bound {K : Type u} [Field K] [NumberField K] :
    ∃ c_id : ℝ, 0 < c_id ∧
      ∀ X : ℝ, 1 < X →
        (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm I : ℝ) < X ^ (Module.finrank ℚ K) ∧
          ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
            ∃ m : ℕ, 2 ≤ m ∧ I = p.asIdeal ^ m} : ℝ) ≤
        c_id * X ^ ((Module.finrank ℚ K : ℝ) / 2) * (Real.log X + 1) :=
by
  classical
  have h_s1 : ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ s : ℝ, 1 ≤ s →
      (Nat.card {J : Ideal (NumberField.RingOfIntegers K) // (Ideal.absNorm J : ℝ) ≤ s} : ℝ) ≤
        C₁ * s := by
    set L_K : ℝ :=
      2 ^ NumberField.InfinitePlace.nrRealPlaces K *
        (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
        NumberField.Units.regulator K *
        (NumberField.classNumber K : ℝ) /
        ((NumberField.Units.torsionOrder K : ℝ) * Real.sqrt |(NumberField.discr K : ℝ)|)
    have h_tendsto : Filter.Tendsto
        (fun s : ℝ => (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ s} : ℝ) / s)
        Filter.atTop (nhds L_K) :=
      NumberField.Ideal.tendsto_norm_le_div_atTop K
    obtain ⟨S₀, hS₀⟩ := (Metric.tendsto_atTop.mp h_tendsto) 1 zero_lt_one
    let S₁ : ℝ := max S₀ 1
    let N₁ : ℕ := Nat.card {J : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm J ≤ ⌊S₁⌋₊}
    let C₁ : ℝ := max (|L_K| + 1) ((N₁ : ℝ) + 1)
    have hC₁_pos : 0 < C₁ := by
      have h1 : 0 ≤ |L_K| := abs_nonneg L_K
      have h2 : |L_K| + 1 ≤ C₁ := le_max_left _ _
      linarith
    refine ⟨C₁, hC₁_pos, ?_⟩
    intro s hs
    have hs_pos : 0 < s := lt_of_lt_of_le zero_lt_one hs
    by_cases hS : S₁ ≤ s
    · have hS₀_le : S₀ ≤ s := le_trans (le_max_left S₀ 1) hS
      have h_dist := hS₀ s hS₀_le
      rw [Real.dist_eq] at h_dist
      have h_sub : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ s} : ℝ) / s - L_K < 1 :=
        (abs_sub_lt_iff.mp h_dist).1
      have h_abs : L_K ≤ |L_K| := le_abs_self L_K
      have h_max : |L_K| + 1 ≤ C₁ := le_max_left _ _
      have h_div_le : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ s} : ℝ) / s ≤ C₁ := by linarith
      exact (div_le_iff₀ hs_pos).mp h_div_le
    · have hs_le : s ≤ S₁ := le_of_not_ge hS
      have h_sub : {J : Ideal (NumberField.RingOfIntegers K) | (Ideal.absNorm J : ℝ) ≤ s} ⊆
          {J : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm J ≤ ⌊S₁⌋₊} := by
        intro J hJ
        exact Nat.le_floor (le_trans hJ hs_le)
      have h_fin : {J : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm J ≤ ⌊S₁⌋₊}.Finite :=
        Ideal.finite_setOf_absNorm_le ⌊S₁⌋₊
      have h_card_le : Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ s} ≤ N₁ :=
        Nat.card_mono h_fin h_sub
      have h_card_real : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ s} : ℝ) ≤ (N₁ : ℝ) := by exact_mod_cast h_card_le
      have h_max : (N₁ : ℝ) + 1 ≤ C₁ := le_max_right _ _
      have h_le_C₁ : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ s} : ℝ) ≤ C₁ := by linarith
      nlinarith
  have h_s2 : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p.asIdeal := by
    intro p
    have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    omega
  have h_s3 : ∀ (X : ℝ), 1 < X →
      ∀ (I : Ideal (NumberField.RingOfIntegers K))
        (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
        2 ≤ m → I = p.asIdeal ^ m → (Ideal.absNorm I : ℝ) < X ^ (Module.finrank ℚ K) →
        (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ ((Module.finrank ℚ K : ℝ) / 2) ∧
        m < ⌊(Module.finrank ℚ K : ℝ) * Real.log X / Real.log 2⌋₊ + 1 := by
    intro X hX I p m hm hI_eq hI_norm
    set n : ℕ := Module.finrank ℚ K
    set k : ℕ := Ideal.absNorm p.asIdeal
    have hk2 : 2 ≤ k := h_s2 p
    have hk_pos : 0 < k := by omega
    have h_norm_eq : Ideal.absNorm I = k ^ m := by
      rw [hI_eq, map_pow]
    have hX_pos : 0 < X := by linarith
    refine ⟨?_, ?_⟩
    · have h_pow_le : k ^ 2 ≤ Ideal.absNorm I := by
        rw [h_norm_eq]
        exact Nat.pow_le_pow_right hk_pos hm
      have h_pow_real : (k : ℝ) ^ 2 ≤ (Ideal.absNorm I : ℝ) := by exact_mod_cast h_pow_le
      have h_sq_le_Xn : (k : ℝ) ^ 2 ≤ X ^ n := le_trans h_pow_real (le_of_lt hI_norm)
      have h_Xn_eq : (X ^ ((n : ℝ) / 2)) ^ 2 = X ^ n := by
        rw [sq, ← Real.rpow_add hX_pos, add_halves, Real.rpow_natCast]
      have h_sq_le_sq : (k : ℝ) ^ 2 ≤ (X ^ ((n : ℝ) / 2)) ^ 2 := by linarith
      have h_rpow_nonneg : 0 ≤ X ^ ((n : ℝ) / 2) := Real.rpow_nonneg (le_of_lt hX_pos) _
      exact (abs_le_of_sq_le_sq' h_sq_le_sq h_rpow_nonneg).2
    · have h_pow2_le : 2 ^ m ≤ Ideal.absNorm I := by
        rw [h_norm_eq]
        exact Nat.pow_le_pow_left hk2 m
      have h_pow2_real : (2 : ℝ) ^ m ≤ (Ideal.absNorm I : ℝ) := by exact_mod_cast h_pow2_le
      have h_pow2_le_Xn : (2 : ℝ) ^ m ≤ X ^ n := le_trans h_pow2_real (le_of_lt hI_norm)
      have h_log_le : Real.log ((2 : ℝ) ^ m) ≤ Real.log (X ^ n) :=
        Real.log_le_log (by positivity) h_pow2_le_Xn
      rw [Real.log_pow, Real.log_pow] at h_log_le
      have hlog2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num : (1 : ℝ) < 2)
      have hm_le_div : (m : ℝ) ≤ (n : ℝ) * Real.log X / Real.log 2 :=
        (le_div_iff₀ hlog2_pos).mpr h_log_le
      have hm_le_floor : m ≤ ⌊(n : ℝ) * Real.log X / Real.log 2⌋₊ :=
        Nat.le_floor hm_le_div
      exact Nat.lt_add_one_of_le hm_le_floor
  have h_s4 : ∀ (X : ℝ), 1 < X →
      Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
        (Ideal.absNorm I : ℝ) < X ^ (Module.finrank ℚ K) ∧
        ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          ∃ m : ℕ, 2 ≤ m ∧ I = p.asIdeal ^ m} ≤
      Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
        (Ideal.absNorm J : ℝ) ≤ X ^ ((Module.finrank ℚ K : ℝ) / 2)} *
      (⌊(Module.finrank ℚ K : ℝ) * Real.log X / Real.log 2⌋₊ + 1) := by
    intro X hX
    let n : ℕ := Module.finrank ℚ K
    let s : ℝ := X ^ ((n : ℝ) / 2)
    let M : ℕ := ⌊(n : ℝ) * Real.log X / Real.log 2⌋₊
    let S_pp : Set (Ideal (NumberField.RingOfIntegers K)) :=
      {I : Ideal (NumberField.RingOfIntegers K) |
        (Ideal.absNorm I : ℝ) < X ^ n ∧
        ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          ∃ m : ℕ, 2 ≤ m ∧ I = p.asIdeal ^ m}
    let S_J : Set (Ideal (NumberField.RingOfIntegers K)) :=
      {J : Ideal (NumberField.RingOfIntegers K) | (Ideal.absNorm J : ℝ) ≤ s}
    have hSpp_fin : S_pp.Finite := by
      apply Set.Finite.subset (Ideal.finite_setOf_absNorm_le ⌊X ^ n⌋₊)
      intro I hI
      exact Nat.le_floor (le_of_lt hI.1)
    have hSJ_fin : S_J.Finite := by
      apply Set.Finite.subset (Ideal.finite_setOf_absNorm_le ⌊s⌋₊)
      intro J hJ
      exact Nat.le_floor hJ
    letI : Fintype S_pp := hSpp_fin.fintype
    letI : Fintype S_J := hSJ_fin.fintype
    let F_pp : Finset (Ideal (NumberField.RingOfIntegers K)) := hSpp_fin.toFinset
    let F_J : Finset (Ideal (NumberField.RingOfIntegers K)) := hSJ_fin.toFinset
    have hcard_Spp : Nat.card S_pp = F_pp.card := by
      rw [Nat.card_eq_fintype_card, Set.Finite.card_toFinset]
    have hcard_SJ : Nat.card S_J = F_J.card := by
      rw [Nat.card_eq_fintype_card, Set.Finite.card_toFinset]
    let F_m : Finset ℕ := Finset.range (M + 1)
    let φ : Ideal (NumberField.RingOfIntegers K) × ℕ → Ideal (NumberField.RingOfIntegers K) :=
      fun q => q.1 ^ q.2
    have h_sub : F_pp ⊆ Finset.image φ (F_J ×ˢ F_m) := by
      intro I hI
      rw [Set.Finite.mem_toFinset] at hI
      rcases hI with ⟨hI_norm, p, m, hm, hI_eq⟩
      obtain ⟨hp_norm, hm_lt⟩ := h_s3 X hX I p m hm hI_eq hI_norm
      rw [Finset.mem_image]
      refine ⟨(p.asIdeal, m), ?_, ?_⟩
      · rw [Finset.mem_product, Set.Finite.mem_toFinset, Finset.mem_range]
        exact ⟨hp_norm, hm_lt⟩
      · dsimp [φ]
        exact hI_eq.symm
    calc Nat.card S_pp
        = F_pp.card := hcard_Spp
      _ ≤ (Finset.image φ (F_J ×ˢ F_m)).card := Finset.card_le_card h_sub
      _ ≤ (F_J ×ˢ F_m).card := Finset.card_image_le
      _ = F_J.card * F_m.card := Finset.card_product F_J F_m
      _ = Nat.card S_J * (M + 1) := by
          rw [← hcard_SJ, Finset.card_range]
  obtain ⟨C₁, hC₁_pos, hC₁⟩ := h_s1
  have hlog2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num : (1 : ℝ) < 2)
  let n : ℕ := Module.finrank ℚ K
  let c_id : ℝ := C₁ * ((n : ℝ) / Real.log 2 + 1)
  have hc_id_pos : 0 < c_id := by
    dsimp [c_id]
    positivity
  refine ⟨c_id, hc_id_pos, ?_⟩
  intro X hX
  set s : ℝ := X ^ ((n : ℝ) / 2)
  set M : ℕ := ⌊(n : ℝ) * Real.log X / Real.log 2⌋₊
  have hs_ge_one : 1 ≤ s := Real.one_le_rpow (le_of_lt hX) (by positivity)
  have h_SJ_bound : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
      (Ideal.absNorm J : ℝ) ≤ s} : ℝ) ≤ C₁ * s := hC₁ s hs_ge_one
  have hlogX_pos : 0 < Real.log X := Real.log_pos hX
  have h_arg_nonneg : 0 ≤ (n : ℝ) * Real.log X / Real.log 2 := by positivity
  have hM_le : (M : ℝ) ≤ (n : ℝ) * Real.log X / Real.log 2 := Nat.floor_le h_arg_nonneg
  have hM_bound : ((M + 1 : ℕ) : ℝ) ≤ ((n : ℝ) / Real.log 2 + 1) * (Real.log X + 1) := by
    push_cast
    have h_div_nonneg : 0 ≤ (n : ℝ) / Real.log 2 := by positivity
    have h_eq : (n : ℝ) * Real.log X / Real.log 2 = ((n : ℝ) / Real.log 2) * Real.log X := by ring
    nlinarith
  have h_s4_real : (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
      (Ideal.absNorm I : ℝ) < X ^ n ∧
      ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ∃ m : ℕ, 2 ≤ m ∧ I = p.asIdeal ^ m} : ℝ) ≤
      (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
        (Ideal.absNorm J : ℝ) ≤ s} : ℝ) * ((M + 1 : ℕ) : ℝ) := by
    exact_mod_cast h_s4 X hX
  calc (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
        (Ideal.absNorm I : ℝ) < X ^ n ∧
        ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          ∃ m : ℕ, 2 ≤ m ∧ I = p.asIdeal ^ m} : ℝ)
      ≤ (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ s} : ℝ) * ((M + 1 : ℕ) : ℝ) := h_s4_real
    _ ≤ (C₁ * s) * (((n : ℝ) / Real.log 2 + 1) * (Real.log X + 1)) := by
        gcongr
    _ = c_id * s * (Real.log X + 1) := by
        dsimp [c_id]
        ring

theorem mitsui_prime_to_vonMangoldt_unconditioned {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}] :
    ∃ c₃ : ℝ, 0 < c₃ ∧
      ∀ X : ℝ, 1 < X →
        ∀ C : Set (NumberField.mixedEmbedding.mixedSpace K), Convex ℝ C → IsOpen C →
          (∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
              NumberField.mixedEmbedding.normAtPlace w z < X) →
          |(∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
            - (∑' x : {x : NumberField.RingOfIntegers K //
                  NumberField.mixedEmbedding K (x : K) ∈ C},
                vonMangoldtO (x : NumberField.RingOfIntegers K))|
            ≤ c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃) :=
by
  obtain ⟨c_unit, hc_unit_pos, hc_unit⟩ := mitsui_prime_power_elts_le_ideals_mul_units (K := K)
  obtain ⟨c_id, hc_id_pos, hc_id⟩ := mitsui_prime_power_ideals_card_bound (K := K)
  let n : ℕ := Module.finrank ℚ K
  have hn : 0 < n := Module.finrank_pos
  have hn_pos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
  let k : ℕ := NumberField.Units.rank K + 2
  let A : ℝ := (n : ℝ) * c_unit * c_id
  have hA_pos : 0 < A := by positivity
  let K₀ : ℕ := max k 1
  have hK₀_pos : (0 : ℝ) < (K₀ : ℝ) := by
    dsimp [K₀]
    positivity
  let c₃ : ℝ := max 2 (A * (4 * (K₀ : ℝ)) ^ k * Real.exp 1)
  have hc_ge_two : 2 ≤ c₃ := le_max_left _ _
  have hc_ge_A : A * (4 * (K₀ : ℝ)) ^ k * Real.exp 1 ≤ c₃ := le_max_right _ _
  have hc₃_pos : 0 < c₃ := by linarith
  have h_s4 : ∀ X : ℝ, 1 < X →
      A * X ^ ((n : ℝ) / 2) * (Real.log X + 1) ^ k ≤
        c₃ * X ^ n * Real.exp (-Real.sqrt (Real.log X) / c₃) := by
    intro X hX
    have hX_pos : 0 < X := by linarith
    have hlog_pos : 0 < Real.log X := Real.log_pos hX
    set t : ℝ := Real.sqrt (Real.log X)
    have ht_pos : 0 < t := Real.sqrt_pos.mpr hlog_pos
    have ht_sq : t ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlog_pos)
    have hu_le : (t ^ 2 + 1) / (4 * (K₀ : ℝ)) ≤ Real.exp ((t ^ 2 + 1) / (4 * (K₀ : ℝ))) := by
      have h1 := Real.add_one_le_exp ((t ^ 2 + 1) / (4 * (K₀ : ℝ)))
      linarith
    have hu_nonneg : 0 ≤ (t ^ 2 + 1) / (4 * (K₀ : ℝ)) := by positivity
    have hpow_le : ((t ^ 2 + 1) / (4 * (K₀ : ℝ))) ^ k ≤
        Real.exp ((k : ℝ) * ((t ^ 2 + 1) / (4 * (K₀ : ℝ)))) := by
      calc ((t ^ 2 + 1) / (4 * (K₀ : ℝ))) ^ k
          ≤ (Real.exp ((t ^ 2 + 1) / (4 * (K₀ : ℝ)))) ^ k := pow_le_pow_left₀ hu_nonneg hu_le k
        _ = Real.exp ((k : ℝ) * ((t ^ 2 + 1) / (4 * (K₀ : ℝ)))) := (Real.exp_nat_mul _ k).symm
    have hk_le_K₀ : (k : ℝ) ≤ (K₀ : ℝ) := by
      dsimp [K₀]
      exact_mod_cast le_max_left k 1
    have hexp_arg_le1 : (k : ℝ) * ((t ^ 2 + 1) / (4 * (K₀ : ℝ))) ≤ (t ^ 2 + 1) / 4 := by
      have hdiv : (k : ℝ) / (K₀ : ℝ) ≤ 1 := (div_le_one hK₀_pos).mpr hk_le_K₀
      have hrew : (k : ℝ) * ((t ^ 2 + 1) / (4 * (K₀ : ℝ))) = ((k : ℝ) / (K₀ : ℝ)) * ((t ^ 2 + 1) / 4) := by ring
      rw [hrew]
      exact mul_le_of_le_one_left (by positivity) hdiv
    have hpoly_bound : (Real.log X + 1) ^ k ≤ (4 * (K₀ : ℝ)) ^ k * Real.exp ((t ^ 2 + 1) / 4) := by
      have h4K_nonneg : 0 ≤ (4 * (K₀ : ℝ)) ^ k := by positivity
      have h4K_ne_zero : (4 * (K₀ : ℝ)) ^ k ≠ 0 := by positivity
      have h1 : ((t ^ 2 + 1) / (4 * (K₀ : ℝ))) ^ k ≤ Real.exp ((t ^ 2 + 1) / 4) :=
        le_trans hpow_le (Real.exp_le_exp.mpr hexp_arg_le1)
      have h2 := mul_le_mul_of_nonneg_left h1 h4K_nonneg
      have h3 : (4 * (K₀ : ℝ)) ^ k * ((t ^ 2 + 1) / (4 * (K₀ : ℝ))) ^ k = (t ^ 2 + 1) ^ k := by
        rw [div_pow, mul_div_cancel₀ _ h4K_ne_zero]
      rw [← ht_sq, ← h3]
      exact h2
    have hn_ge_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
    have htc_le : t / c₃ ≤ t / 2 := div_le_div_of_nonneg_left (le_of_lt ht_pos) (by norm_num) hc_ge_two
    have hsq_nonneg : 0 ≤ (t - 1) ^ 2 / 4 := by positivity
    have hn_half : t ^ 2 / 2 ≤ ((n : ℝ) / 2) * t ^ 2 := by
      have : (1 : ℝ) / 2 ≤ (n : ℝ) / 2 := by linarith
      nlinarith
    have hexp_arg_le2 : (t ^ 2 + 1) / 4 ≤ 1 + ((n : ℝ) / 2) * t ^ 2 + (-t / c₃) := by
      have hident : (t ^ 2 + 1) / 4 = t ^ 2 / 2 - t / 2 + 1 / 2 - (t - 1) ^ 2 / 4 := by ring
      rw [neg_div]
      linarith
    have hexp_split : Real.exp (1 + ((n : ℝ) / 2) * t ^ 2 + (-t / c₃)) =
        Real.exp 1 * X ^ ((n : ℝ) / 2) * Real.exp (-t / c₃) := by
      rw [Real.exp_add, Real.exp_add, ht_sq, Real.rpow_def_of_pos hX_pos]
      ring_nf
    have hexp_bound : Real.exp ((t ^ 2 + 1) / 4) ≤ Real.exp 1 * X ^ ((n : ℝ) / 2) * Real.exp (-t / c₃) := by
      rw [← hexp_split]
      exact Real.exp_le_exp.mpr hexp_arg_le2
    have hX_half_mul : X ^ ((n : ℝ) / 2) * X ^ ((n : ℝ) / 2) = X ^ n := by
      rw [← Real.rpow_add hX_pos]
      have hnh : (n : ℝ) / 2 + (n : ℝ) / 2 = (n : ℝ) := by ring
      rw [hnh, Real.rpow_natCast]
    calc A * X ^ ((n : ℝ) / 2) * (Real.log X + 1) ^ k
        ≤ A * X ^ ((n : ℝ) / 2) * ((4 * (K₀ : ℝ)) ^ k * Real.exp ((t ^ 2 + 1) / 4)) := by
          gcongr
      _ ≤ A * X ^ ((n : ℝ) / 2) * ((4 * (K₀ : ℝ)) ^ k * (Real.exp 1 * X ^ ((n : ℝ) / 2) * Real.exp (-t / c₃))) := by
          gcongr
      _ = (A * (4 * (K₀ : ℝ)) ^ k * Real.exp 1) * (X ^ ((n : ℝ) / 2) * X ^ ((n : ℝ) / 2)) * Real.exp (-t / c₃) := by
          ring
      _ = (A * (4 * (K₀ : ℝ)) ^ k * Real.exp 1) * X ^ n * Real.exp (-t / c₃) := by
          rw [hX_half_mul]
      _ ≤ c₃ * X ^ n * Real.exp (-t / c₃) := by
          gcongr
  refine ⟨c₃, hc₃_pos, ?_⟩
  intro X hX C _hC_conv _hC_open hC_bdd
  have hlog_pos : 0 < Real.log X := Real.log_pos hX
  have hlog_le : Real.log X ≤ Real.log X + 1 := by linarith
  have h1 := mitsui_vonMangoldt_diff_le_prime_power_card X hX C hC_bdd
  have h2 := hc_unit X hX
  have h3 := hc_id X hX
  have h4 := h_s4 X hX
  set N_elts : ℝ := (Nat.card {x : NumberField.RingOfIntegers K //
    (∀ w : NumberField.InfinitePlace K, w (x : K) < X) ∧
    ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ∃ m : ℕ, 2 ≤ m ∧ Ideal.span {x} = p.asIdeal ^ m} : ℝ)
  set N_ids : ℝ := (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
    (Ideal.absNorm I : ℝ) < X ^ (Module.finrank ℚ K) ∧
    ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ∃ m : ℕ, 2 ≤ m ∧ I = p.asIdeal ^ m} : ℝ)
  have hN_elts_nonneg : 0 ≤ N_elts := Nat.cast_nonneg _
  have hstep1 : (n : ℝ) * Real.log X * N_elts ≤ (n : ℝ) * (Real.log X + 1) * N_elts := by
    gcongr
  have hstep2 : (n : ℝ) * (Real.log X + 1) * N_elts ≤
      (n : ℝ) * (Real.log X + 1) * (c_unit * (Real.log X + 1) ^ (NumberField.Units.rank K) * N_ids) := by
    gcongr
  have hstep3 : (n : ℝ) * (Real.log X + 1) * (c_unit * (Real.log X + 1) ^ (NumberField.Units.rank K) * N_ids) ≤
      (n : ℝ) * (Real.log X + 1) * (c_unit * (Real.log X + 1) ^ (NumberField.Units.rank K) *
        (c_id * X ^ ((n : ℝ) / 2) * (Real.log X + 1))) := by
    gcongr
  have hstep4 : (n : ℝ) * (Real.log X + 1) * (c_unit * (Real.log X + 1) ^ (NumberField.Units.rank K) *
        (c_id * X ^ ((n : ℝ) / 2) * (Real.log X + 1))) =
      A * X ^ ((n : ℝ) / 2) * (Real.log X + 1) ^ k := by
    dsimp [A, k]
    ring
  linarith

theorem mitsui_vonMangoldt_equidist_of_char_bound {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (C : Set (NumberField.mixedEmbedding.mixedSpace K))
    (hC_bdd : ∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < X)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (α : NumberField.RingOfIntegers K) (hα : IsUnit (Ideal.Quotient.mk q α))
    (B : ℝ) (hB : 0 ≤ B)
    (hchar : ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
      ‖∑' x : {x : NumberField.RingOfIntegers K //
            NumberField.mixedEmbedding K (x : K) ∈ C ∧
            IsUnit (Ideal.Quotient.mk q x)},
          ψ (Additive.ofMul x.2.2.unit) *
            (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ)‖ ≤ B) :
    |(∑' x : {x : NumberField.RingOfIntegers K //
          NumberField.mixedEmbedding K (x : K) ∈ C ∧ (x : NumberField.RingOfIntegers K) - α ∈ q},
        vonMangoldtO (x : NumberField.RingOfIntegers K))
      - ((Nat.card (NumberField.RingOfIntegers K ⧸ q)ˣ : ℝ))⁻¹ *
        (∑' x : {x : NumberField.RingOfIntegers K //
            NumberField.mixedEmbedding K (x : K) ∈ C ∧
            IsUnit (Ideal.Quotient.mk q x)},
          vonMangoldtO (x : NumberField.RingOfIntegers K))| ≤ B :=
by
  classical
  have hq_bot : q ≠ ⊥ := hq
  haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
    Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
  let G := Additive (NumberField.RingOfIntegers K ⧸ q)ˣ
  letI : Fintype G := Fintype.ofFinite G
  let N : ℕ := Fintype.card G
  have hN_card : Nat.card (NumberField.RingOfIntegers K ⧸ q)ˣ = N := by
    rw [Nat.card_congr Additive.ofMul, Nat.card_eq_fintype_card]
  have hN_pos : 0 < N := Fintype.card_pos
  have hNR_pos : (0 : ℝ) < (N : ℝ) := Nat.cast_pos.mpr hN_pos
  have hNR_ne : (N : ℝ) ≠ 0 := ne_of_gt hNR_pos
  have hNC_ne : (N : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hN_pos)
  have hcard_char : Fintype.card (AddChar G ℂ) = N := AddChar.card_eq
  have hcard_erase : (Finset.univ.erase (0 : AddChar G ℂ)).card = N - 1 := by
    rw [Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, hcard_char]
  have hB_fin : {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}.Finite :=
    NumberField.Embeddings.finite_of_norm_le K ℂ X
  have h_pre_fin : ((algebraMap (NumberField.RingOfIntegers K) K) ⁻¹'
      {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}).Finite :=
    hB_fin.preimage (NumberField.RingOfIntegers.coe_injective.injOn)
  have hSC_fin : {x : NumberField.RingOfIntegers K |
      NumberField.mixedEmbedding K (x : K) ∈ C}.Finite := by
    refine h_pre_fin.subset ?_
    intro x hx
    refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, ?_⟩
    intro φ
    let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
    have hw : ‖φ (x : K)‖ = w (x : K) := (NumberField.InfinitePlace.apply φ (x : K)).symm
    have hw2 : w (x : K) =
        NumberField.mixedEmbedding.normAtPlace w (NumberField.mixedEmbedding K (x : K)) :=
      (NumberField.mixedEmbedding.normAtPlace_apply w (x : K)).symm
    rw [hw, hw2]
    exact le_of_lt (hC_bdd _ hx w)
  let S_cop := {x : NumberField.RingOfIntegers K //
      NumberField.mixedEmbedding K (x : K) ∈ C ∧ IsUnit (Ideal.Quotient.mk q x)}
  let S_res := {x : NumberField.RingOfIntegers K //
      NumberField.mixedEmbedding K (x : K) ∈ C ∧ (x : NumberField.RingOfIntegers K) - α ∈ q}
  have hScop_fin : {x : NumberField.RingOfIntegers K |
      NumberField.mixedEmbedding K (x : K) ∈ C ∧ IsUnit (Ideal.Quotient.mk q x)}.Finite :=
    hSC_fin.subset (fun _ hx => hx.1)
  have hSres_fin : {x : NumberField.RingOfIntegers K |
      NumberField.mixedEmbedding K (x : K) ∈ C ∧ (x : NumberField.RingOfIntegers K) - α ∈ q}.Finite :=
    hSC_fin.subset (fun _ hx => hx.1)
  letI : Fintype S_cop := hScop_fin.fintype
  letI : Fintype S_res := hSres_fin.fintype
  let g_α : G := Additive.ofMul hα.unit
  let g : S_cop → G := fun x => Additive.ofMul x.2.2.unit
  have h_unit_of_res : ∀ y : NumberField.RingOfIntegers K,
      y - α ∈ q → IsUnit (Ideal.Quotient.mk q y) := by
    intro y hy
    have hmk : Ideal.Quotient.mk q y = Ideal.Quotient.mk q α :=
      (Ideal.Quotient.mk_eq_mk_iff_sub_mem y α).mpr hy
    rw [hmk]
    exact hα
  have h_res_iff : ∀ x : S_cop, g x - g_α = 0 ↔ (x.1 : NumberField.RingOfIntegers K) - α ∈ q := by
    intro x
    dsimp [g, g_α]
    rw [sub_eq_zero, Equiv.apply_eq_iff_eq, Units.ext_iff, IsUnit.unit_spec, IsUnit.unit_spec,
      Ideal.Quotient.mk_eq_mk_iff_sub_mem]
  let e : S_res ≃ {x : S_cop // g x - g_α = 0} :=
    { toFun := fun y => ⟨⟨y.1, y.2.1, h_unit_of_res y.1 y.2.2⟩, (h_res_iff ⟨y.1, y.2.1, h_unit_of_res y.1 y.2.2⟩).mpr y.2.2⟩
      invFun := fun x => ⟨x.1.1, x.1.2.1, (h_res_iff x.1).mp x.2⟩
      left_inv := fun y => by ext; rfl
      right_inv := fun x => by ext; rfl }
  have h_tsum_res :
      (∑' y : S_res, vonMangoldtO (y : NumberField.RingOfIntegers K)) =
      ∑ x : S_cop, (if g x - g_α = 0 then (1 : ℝ) else 0) *
        vonMangoldtO (x : NumberField.RingOfIntegers K) := by
    have he_tsum : (∑' y : S_res, vonMangoldtO (y : NumberField.RingOfIntegers K)) =
        ∑' x : {x : S_cop // g x - g_α = 0}, vonMangoldtO (x.1 : NumberField.RingOfIntegers K) :=
      Equiv.tsum_eq e (fun x : {x : S_cop // g x - g_α = 0} => vonMangoldtO (x.1 : NumberField.RingOfIntegers K))
    have h_sub : (∑ b : {x : S_cop // g x - g_α = 0}, vonMangoldtO (b.1 : NumberField.RingOfIntegers K)) =
        ∑ x ∈ Finset.univ.filter (fun x : S_cop => g x - g_α = 0), vonMangoldtO (x : NumberField.RingOfIntegers K) :=
      (Finset.sum_subtype (Finset.univ.filter (fun x : S_cop => g x - g_α = 0)) (fun _ => by simp)
        (fun x : S_cop => vonMangoldtO (x : NumberField.RingOfIntegers K))).symm
    rw [he_tsum, tsum_fintype, h_sub, Finset.sum_filter]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    split_ifs <;> ring
  have h_tsum_cop :
      (∑' x : S_cop, vonMangoldtO (x : NumberField.RingOfIntegers K)) =
      ∑ x : S_cop, vonMangoldtO (x : NumberField.RingOfIntegers K) :=
    tsum_fintype _
  have h_tsum_char : ∀ ψ : AddChar G ℂ,
      (∑' x : S_cop, ψ (g x) * (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ)) =
      ∑ x : S_cop, ψ (g x) * (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ) :=
    fun _ => tsum_fintype _
  have h_orth : ∀ x : S_cop,
      (if g x - g_α = 0 then (1 : ℂ) else 0) - (N : ℂ)⁻¹ =
      (N : ℂ)⁻¹ * ∑ ψ ∈ Finset.univ.erase (0 : AddChar G ℂ), ψ (-g_α) * ψ (g x) := by
    intro x
    have hsum : ∑ ψ : AddChar G ℂ, ψ (g x - g_α) = if g x - g_α = 0 then (N : ℂ) else 0 :=
      AddChar.sum_apply_eq_ite (g x - g_α)
    have herase := Finset.add_sum_erase Finset.univ (fun ψ : AddChar G ℂ => ψ (g x - g_α)) (Finset.mem_univ (0 : AddChar G ℂ))
    dsimp only at herase
    rw [AddChar.zero_apply] at herase
    have hsum2 : (1 : ℂ) + ∑ ψ ∈ Finset.univ.erase (0 : AddChar G ℂ), ψ (-g_α) * ψ (g x) =
        if g x - g_α = 0 then (N : ℂ) else 0 := by
      have hcongr : ∑ ψ ∈ Finset.univ.erase (0 : AddChar G ℂ), ψ (-g_α) * ψ (g x) =
          ∑ ψ ∈ Finset.univ.erase (0 : AddChar G ℂ), ψ (g x - g_α) := by
        refine Finset.sum_congr rfl (fun ψ _ => ?_)
        rw [sub_eq_neg_add, AddChar.map_add_eq_mul]
      rw [hcongr, herase, hsum]
    have hsum3 : ∑ ψ ∈ Finset.univ.erase (0 : AddChar G ℂ), ψ (-g_α) * ψ (g x) =
        (if g x - g_α = 0 then (N : ℂ) else 0) - 1 :=
      eq_sub_of_add_eq' hsum2
    rw [hsum3, mul_sub, mul_one]
    congr 1
    split_ifs with h0
    · exact (inv_mul_cancel₀ hNC_ne).symm
    · simp
  let Δ : ℝ := (∑' y : S_res, vonMangoldtO (y : NumberField.RingOfIntegers K)) -
      ((N : ℝ))⁻¹ * (∑' x : S_cop, vonMangoldtO (x : NumberField.RingOfIntegers K))
  change |((∑' y : S_res, vonMangoldtO (y : NumberField.RingOfIntegers K)) -
      ((Nat.card (NumberField.RingOfIntegers K ⧸ q)ˣ : ℝ))⁻¹ *
        (∑' x : S_cop, vonMangoldtO (x : NumberField.RingOfIntegers K)))| ≤ B
  rw [hN_card]
  change |Δ| ≤ B
  have hΔ_eq : Δ = ∑ x : S_cop,
      ((if g x - g_α = 0 then (1 : ℝ) else 0) - (N : ℝ)⁻¹) *
        vonMangoldtO (x : NumberField.RingOfIntegers K) := by
    dsimp [Δ]
    rw [h_tsum_res, h_tsum_cop, Finset.mul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    ring
  have hΔ_C : (Δ : ℂ) = (N : ℂ)⁻¹ * ∑ ψ ∈ Finset.univ.erase (0 : AddChar G ℂ),
      ψ (-g_α) * (∑ x : S_cop, ψ (g x) * (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ)) := by
    rw [hΔ_eq]
    push_cast
    trans (∑ x : S_cop, ∑ ψ ∈ Finset.univ.erase (0 : AddChar G ℂ),
        (N : ℂ)⁻¹ * (ψ (-g_α) * (ψ (g x) * (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ))))
    · refine Finset.sum_congr rfl (fun x _ => ?_)
      have h_lhs : (Complex.ofReal (if g x - g_α = 0 then (1 : ℝ) else 0) - (N : ℂ)⁻¹) =
          (if g x - g_α = 0 then (1 : ℂ) else 0) - (N : ℂ)⁻¹ := by
        split_ifs <;> simp
      rw [h_lhs, h_orth x, Finset.mul_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun ψ _ => ?_)
      ring
    · rw [Finset.sum_comm, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun ψ _ => ?_)
      rw [← Finset.mul_sum, ← Finset.mul_sum]
  have hΔ_norm : |Δ| = ‖(Δ : ℂ)‖ := (Complex.norm_real Δ).symm
  rw [hΔ_norm, hΔ_C, norm_mul, norm_inv, Complex.norm_natCast]
  have h_sum_le : ‖∑ ψ ∈ Finset.univ.erase (0 : AddChar G ℂ),
      ψ (-g_α) * (∑ x : S_cop, ψ (g x) * (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ))‖ ≤
      ((N - 1 : ℕ) : ℝ) * B := by
    calc ‖∑ ψ ∈ Finset.univ.erase (0 : AddChar G ℂ),
          ψ (-g_α) * (∑ x : S_cop, ψ (g x) * (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ))‖
      _ ≤ ∑ ψ ∈ Finset.univ.erase (0 : AddChar G ℂ),
          ‖ψ (-g_α) * (∑ x : S_cop, ψ (g x) * (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ))‖ :=
        norm_sum_le _ _
      _ ≤ (Finset.univ.erase (0 : AddChar G ℂ)).card • B := by
        refine Finset.sum_le_card_nsmul _ _ B (fun ψ hψ => ?_)
        rw [norm_mul, AddChar.norm_apply, one_mul, ← h_tsum_char ψ]
        exact hchar ψ (Finset.ne_of_mem_erase hψ)
      _ = ((N - 1 : ℕ) : ℝ) * B := by
        rw [hcard_erase, nsmul_eq_mul]
  calc (N : ℝ)⁻¹ * ‖∑ ψ ∈ Finset.univ.erase (0 : AddChar G ℂ),
        ψ (-g_α) * (∑ x : S_cop, ψ (g x) * (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ))‖
    _ ≤ (N : ℝ)⁻¹ * (((N - 1 : ℕ) : ℝ) * B) :=
      mul_le_mul_of_nonneg_left h_sum_le (inv_nonneg.mpr (le_of_lt hNR_pos))
    _ ≤ (N : ℝ)⁻¹ * ((N : ℝ) * B) := by
      refine mul_le_mul_of_nonneg_left ?_ (inv_nonneg.mpr (le_of_lt hNR_pos))
      exact mul_le_mul_of_nonneg_right (Nat.cast_le.mpr (Nat.sub_le N 1)) hB
    _ = B := by
      rw [← mul_assoc, inv_mul_cancel₀ hNR_ne, one_mul]

theorem mitsui_prime_to_vonMangoldt_char_filter_le {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (C : Set (NumberField.mixedEmbedding.mixedSpace K))
    (hC_bdd : ∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < X)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ) :
    ‖(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          NumberField.mixedEmbedding K (π : K) ∈ C ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      - (∑' x : {x : NumberField.RingOfIntegers K //
            NumberField.mixedEmbedding K (x : K) ∈ C ∧
            IsUnit (Ideal.Quotient.mk q x)},
          ψ (Additive.ofMul x.2.2.unit) *
            (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ))‖
    ≤ |(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      - (∑' x : {x : NumberField.RingOfIntegers K //
            NumberField.mixedEmbedding K (x : K) ∈ C},
          vonMangoldtO (x : NumberField.RingOfIntegers K))| :=
by
  classical
  have hq_bot : q ≠ ⊥ := hq
  haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
    Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
  let B_C : Set K := {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}
  have hB_fin : B_C.Finite := NumberField.Embeddings.finite_of_norm_le K ℂ X
  let S_C : Set (NumberField.RingOfIntegers K) :=
    {x : NumberField.RingOfIntegers K | NumberField.mixedEmbedding K (x : K) ∈ C}
  have hpre_fin : (algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_C).Finite :=
    hB_fin.preimage NumberField.RingOfIntegers.coe_injective.injOn
  have hS_sub : S_C ⊆ algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_C := by
    intro x hx
    refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, ?_⟩
    intro φ
    let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
    have hw1 : w (x : K) = ‖φ (x : K)‖ := NumberField.InfinitePlace.apply φ (x : K)
    have hw2 : NumberField.mixedEmbedding.normAtPlace w (NumberField.mixedEmbedding K (x : K)) = w (x : K) :=
      NumberField.mixedEmbedding.normAtPlace_apply w (x : K)
    have hlt : NumberField.mixedEmbedding.normAtPlace w (NumberField.mixedEmbedding K (x : K)) < X :=
      hC_bdd _ hx w
    change ‖φ (x : K)‖ ≤ X
    linarith
  have hS_fin : S_C.Finite := hpre_fin.subset hS_sub
  let F : Finset (NumberField.RingOfIntegers K) := hS_fin.toFinset
  have hF_mem : ∀ x : NumberField.RingOfIntegers K,
      x ∈ F ↔ NumberField.mixedEmbedding K (x : K) ∈ C :=
    fun x => hS_fin.mem_toFinset
  have h_nonneg : ∀ x : NumberField.RingOfIntegers K, 0 ≤ vonMangoldtO x := by
    intro x
    dsimp [vonMangoldtO]
    split_ifs with h
    · exact Real.log_natCast_nonneg _
    · exact le_rfl
  have h_prime_eq : ∀ π : NumberField.RingOfIntegers K, Prime π →
      vonMangoldtO π = Real.log ((Algebra.norm ℤ π).natAbs : ℝ) := by
    intro π hπ
    have hπ_ne : π ≠ 0 := hπ.ne_zero
    have hI_ne_bot : Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) ≠ ⊥ :=
      Ideal.span_singleton_eq_bot.not.mpr hπ_ne
    have hI_prime : (Ideal.span ({π} : Set (NumberField.RingOfIntegers K))).IsPrime :=
      (Ideal.span_singleton_prime hπ_ne).mpr hπ
    let p₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) :=
      ⟨Ideal.span {π}, hI_prime, hI_ne_bot⟩
    have hex : ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        ∃ m : ℕ, 0 < m ∧ Ideal.span {π} = p.asIdeal ^ m :=
      ⟨p₀, 1, zero_lt_one, (pow_one _).symm⟩
    have h_unfold : vonMangoldtO π = Real.log (Ideal.absNorm hex.choose.asIdeal) := by
      dsimp [vonMangoldtO]
      exact dif_pos hex
    obtain ⟨m, hm_pos, hm_eq⟩ := hex.choose_spec
    have h_le : p₀.asIdeal ≤ hex.choose.asIdeal :=
      hm_eq.le.trans (Ideal.pow_le_self hm_pos.ne')
    have h_max : p₀.asIdeal.IsMaximal := IsDedekindDomain.HeightOneSpectrum.isMaximal p₀
    have h_ne_top : hex.choose.asIdeal ≠ ⊤ := hex.choose.isPrime.ne_top
    have h_ideal_eq : hex.choose.asIdeal = Ideal.span {π} :=
      (h_max.eq_of_le h_ne_top h_le).symm
    rw [h_unfold, h_ideal_eq, Ideal.absNorm_span_singleton]
  let S_cop := {x : NumberField.RingOfIntegers K //
      NumberField.mixedEmbedding K (x : K) ∈ C ∧ IsUnit (Ideal.Quotient.mk q x)}
  have hScop_fin : {x : NumberField.RingOfIntegers K |
      NumberField.mixedEmbedding K (x : K) ∈ C ∧ IsUnit (Ideal.Quotient.mk q x)}.Finite :=
    hS_fin.subset (fun _ hx => hx.1)
  letI : Fintype S_cop := hScop_fin.fintype
  let S_prime := {π : NumberField.RingOfIntegers K //
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C ∧ IsUnit (Ideal.Quotient.mk q π)}
  let term : S_cop → ℂ := fun x =>
    ψ (Additive.ofMul x.2.2.unit) * (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ)
  let e_prime : S_prime ≃ {x : S_cop // Prime x.1} :=
    { toFun := fun π => ⟨⟨π.1, π.2.2.1, π.2.2.2⟩, π.2.1⟩
      invFun := fun x => ⟨x.1.1, x.2, x.1.2.1, x.1.2.2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun x => by ext; rfl }
  have h_lhs1 :
      (∑' π : S_prime,
        ψ (Additive.ofMul π.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑ x ∈ Finset.univ.filter (fun x : S_cop => Prime x.1), term x := by
    have h_congr :
        (∑' π : S_prime,
          ψ (Additive.ofMul π.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
        = ∑' π : S_prime, term (e_prime π).1 := by
      refine tsum_congr (fun π => ?_)
      dsimp [term, e_prime]
      rw [h_prime_eq π.1 π.2.1]
    rw [h_congr, Equiv.tsum_eq e_prime (fun y : {x : S_cop // Prime x.1} => term y.1), tsum_fintype]
    exact (Finset.sum_subtype (Finset.univ.filter (fun x : S_cop => Prime x.1))
      (fun _ => by simp) term).symm
  have h_lhs2 :
      (∑' x : S_cop, term x) = ∑ x ∈ Finset.univ, term x :=
    tsum_fintype term
  have h_lhs_split :
      ∑ x ∈ Finset.univ.filter (fun x : S_cop => Prime x.1), term x +
      ∑ x ∈ Finset.univ.filter (fun x : S_cop => ¬ Prime x.1), term x =
      ∑ x ∈ Finset.univ, term x :=
    Finset.sum_filter_add_sum_filter_not Finset.univ (fun x : S_cop => Prime x.1) term
  have h_lhs_diff :
      (∑' π : S_prime,
        ψ (Additive.ofMul π.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      - (∑' x : S_cop, term x)
      = - ∑ x ∈ Finset.univ.filter (fun x : S_cop => ¬ Prime x.1), term x := by
    rw [h_lhs1, h_lhs2, ← h_lhs_split]
    ring
  have h_term_norm : ∀ x : S_cop, ‖term x‖ = vonMangoldtO x.1 := by
    intro x
    dsimp [term]
    rw [norm_mul, AddChar.norm_apply, one_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (h_nonneg x.1)]
  have h_mem_F_cop : ∀ x : NumberField.RingOfIntegers K,
      x ∈ F.filter (fun x => IsUnit (Ideal.Quotient.mk q x)) ↔
        NumberField.mixedEmbedding K (x : K) ∈ C ∧ IsUnit (Ideal.Quotient.mk q x) := by
    intro x
    rw [Finset.mem_filter, hF_mem]
  have h_lhs_le :
      ‖(∑' π : S_prime,
          ψ (Additive.ofMul π.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
        - (∑' x : S_cop, term x)‖
      ≤ ∑ x ∈ (F.filter (fun x => IsUnit (Ideal.Quotient.mk q x))).filter (fun x => ¬ Prime x),
          vonMangoldtO x := by
    rw [h_lhs_diff, norm_neg]
    calc ‖∑ x ∈ Finset.univ.filter (fun x : S_cop => ¬ Prime x.1), term x‖
      _ ≤ ∑ x ∈ Finset.univ.filter (fun x : S_cop => ¬ Prime x.1), ‖term x‖ :=
        norm_sum_le _ _
      _ = ∑ x ∈ Finset.univ.filter (fun x : S_cop => ¬ Prime x.1), vonMangoldtO x.1 := by
        refine Finset.sum_congr rfl (fun x _ => h_term_norm x)
      _ = ∑ x : S_cop, (if ¬ Prime x.1 then vonMangoldtO x.1 else 0) := by
        rw [Finset.sum_filter]
      _ = ∑ x ∈ F.filter (fun x => IsUnit (Ideal.Quotient.mk q x)),
            (if ¬ Prime x then vonMangoldtO x else 0) := by
        exact (Finset.sum_subtype (F.filter (fun x => IsUnit (Ideal.Quotient.mk q x)))
          h_mem_F_cop (fun x => if ¬ Prime x then vonMangoldtO x else 0)).symm
      _ = ∑ x ∈ (F.filter (fun x => IsUnit (Ideal.Quotient.mk q x))).filter (fun x => ¬ Prime x),
            vonMangoldtO x := by
        rw [← Finset.sum_filter]
  let Q₂ : NumberField.RingOfIntegers K → Prop :=
    fun x => NumberField.mixedEmbedding K (x : K) ∈ C
  have h_rhs :
      |(∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ Q₂ π},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
        - (∑' x : {x : NumberField.RingOfIntegers K // Q₂ x},
            vonMangoldtO (x : NumberField.RingOfIntegers K))|
      = ∑ x ∈ (F.filter Q₂).filter (fun x => ¬ Prime x), vonMangoldtO x := by
    have h_tsum_prime_congr :
        (∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ Q₂ π},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
        = ∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ Q₂ π},
            vonMangoldtO (π : NumberField.RingOfIntegers K) := by
      refine tsum_congr (fun π => ?_)
      exact (h_prime_eq π.1 π.2.1).symm
    have h_iff1 : ∀ x : NumberField.RingOfIntegers K,
        (Prime x ∧ Q₂ x) ↔ x ∈ (F.filter Q₂).filter Prime := by
      intro x
      simp only [Finset.mem_filter, hF_mem, Q₂]
      exact ⟨fun ⟨hp, hq⟩ => ⟨⟨hq, hq⟩, hp⟩, fun ⟨⟨_, hq⟩, hp⟩ => ⟨hp, hq⟩⟩
    let e₁ : {x : NumberField.RingOfIntegers K // Prime x ∧ Q₂ x} ≃
        {x : NumberField.RingOfIntegers K // x ∈ (F.filter Q₂).filter Prime} :=
      Equiv.subtypeEquivRight h_iff1
    have h_tsum1 :
        (∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ Q₂ π},
          vonMangoldtO (π : NumberField.RingOfIntegers K))
        = ∑ x ∈ (F.filter Q₂).filter Prime, vonMangoldtO x := by
      rw [← Equiv.tsum_eq e₁.symm (fun x => vonMangoldtO (x : NumberField.RingOfIntegers K))]
      exact Finset.tsum_subtype ((F.filter Q₂).filter Prime) vonMangoldtO
    have h_iff2 : ∀ x : NumberField.RingOfIntegers K,
        Q₂ x ↔ x ∈ F.filter Q₂ := by
      intro x
      simp only [Finset.mem_filter, hF_mem, Q₂]
      exact ⟨fun hq => ⟨hq, hq⟩, fun ⟨_, hq⟩ => hq⟩
    let e₂ : {x : NumberField.RingOfIntegers K // Q₂ x} ≃
        {x : NumberField.RingOfIntegers K // x ∈ F.filter Q₂} :=
      Equiv.subtypeEquivRight h_iff2
    have h_tsum2 :
        (∑' x : {x : NumberField.RingOfIntegers K // Q₂ x},
          vonMangoldtO (x : NumberField.RingOfIntegers K))
        = ∑ x ∈ F.filter Q₂, vonMangoldtO x := by
      rw [← Equiv.tsum_eq e₂.symm (fun x => vonMangoldtO (x : NumberField.RingOfIntegers K))]
      exact Finset.tsum_subtype (F.filter Q₂) vonMangoldtO
    have h_split :
        ∑ x ∈ (F.filter Q₂).filter Prime, vonMangoldtO x +
        ∑ x ∈ (F.filter Q₂).filter (fun x => ¬ Prime x), vonMangoldtO x =
        ∑ x ∈ F.filter Q₂, vonMangoldtO x :=
      Finset.sum_filter_add_sum_filter_not (F.filter Q₂) Prime vonMangoldtO
    have h_rem_nonneg : 0 ≤ ∑ x ∈ (F.filter Q₂).filter (fun x => ¬ Prime x), vonMangoldtO x :=
      Finset.sum_nonneg (fun x _ => h_nonneg x)
    rw [h_tsum_prime_congr, h_tsum1, h_tsum2, ← h_split]
    have h_sub :
        (∑ x ∈ (F.filter Q₂).filter Prime, vonMangoldtO x) -
        (∑ x ∈ (F.filter Q₂).filter Prime, vonMangoldtO x +
         ∑ x ∈ (F.filter Q₂).filter (fun x => ¬ Prime x), vonMangoldtO x) =
        - (∑ x ∈ (F.filter Q₂).filter (fun x => ¬ Prime x), vonMangoldtO x) := by ring
    rw [h_sub, abs_neg, abs_of_nonneg h_rem_nonneg]
  rw [h_rhs]
  refine le_trans h_lhs_le ?_
  refine Finset.sum_le_sum_of_subset_of_nonneg ?_ (fun x _ _ => h_nonneg x)
  intro x hx
  simp only [Finset.mem_filter, Q₂] at hx ⊢
  exact ⟨⟨hx.1.1, (hF_mem x).mp hx.1.1⟩, hx.2⟩

theorem mitsui_prime_char_box_eq_zero_of_torsion_ne_one {K : Type u} [Field K] [NumberField K]
    (X : ℝ)
    (q : Ideal (NumberField.RingOfIntegers K))
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ)
    (hψ_tors : ∃ u ∈ NumberField.Units.torsion K,
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) ≠ 1) :
    (∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) = 0 :=
by
  obtain ⟨u, hu_tors, hu_ne⟩ := hψ_tors
  have hu_inv_tors : u⁻¹ ∈ NumberField.Units.torsion K :=
    Subgroup.inv_mem (NumberField.Units.torsion K) hu_tors
  let D := {π : NumberField.RingOfIntegers K //
    Prime π ∧
    (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
    IsUnit (Ideal.Quotient.mk q π)}
  have h_place (v : (NumberField.RingOfIntegers K)ˣ) (hv : v ∈ NumberField.Units.torsion K)
      (π : NumberField.RingOfIntegers K) (w : NumberField.InfinitePlace K) :
      w (((v : NumberField.RingOfIntegers K) * π : NumberField.RingOfIntegers K) : K) = w (π : K) := by
    change w ((algebraMap (NumberField.RingOfIntegers K) K) ((v : NumberField.RingOfIntegers K) * π)) =
      w ((algebraMap (NumberField.RingOfIntegers K) K) π)
    rw [map_mul, map_mul, (NumberField.Units.mem_torsion K).mp hv w, one_mul]
  have h_mem (v : (NumberField.RingOfIntegers K)ˣ) (hv : v ∈ NumberField.Units.torsion K) (π : D) :
      Prime ((v : NumberField.RingOfIntegers K) * π.1) ∧
      (∀ w : NumberField.InfinitePlace K,
        w (((v : NumberField.RingOfIntegers K) * π.1 : NumberField.RingOfIntegers K) : K) < X) ∧
      IsUnit (Ideal.Quotient.mk q ((v : NumberField.RingOfIntegers K) * π.1)) := by
    refine ⟨?_, ?_, ?_⟩
    · exact (associated_unit_mul_left π.1 (v : NumberField.RingOfIntegers K) v.isUnit).prime_iff.mpr π.2.1
    · intro w
      rw [h_place v hv π.1 w]
      exact π.2.2.1 w
    · rw [map_mul]
      exact IsUnit.mul (v.isUnit.map (Ideal.Quotient.mk q)) π.2.2.2
  let e : D ≃ D :=
    { toFun := fun π => ⟨(u : NumberField.RingOfIntegers K) * π.1, h_mem u hu_tors π⟩
      invFun := fun π => ⟨((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * π.1,
        h_mem u⁻¹ hu_inv_tors π⟩
      left_inv := fun π => Subtype.ext (Units.inv_mul_cancel_left u π.1)
      right_inv := fun π => Subtype.ext (Units.mul_inv_cancel_left u π.1) }
  let u_bar : (NumberField.RingOfIntegers K ⧸ q)ˣ :=
    Units.map (Ideal.Quotient.mk q).toMonoidHom u
  let F : D → ℂ := fun π =>
    ψ (Additive.ofMul π.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  have hF_eq (π : D) : F (e π) = ψ (Additive.ofMul u_bar) * F π := by
    dsimp [F]
    have h_unit : (e π).2.2.2.unit = u_bar * π.2.2.2.unit := by
      apply Units.ext
      change ((e π).2.2.2.unit : NumberField.RingOfIntegers K ⧸ q) =
        (u_bar : NumberField.RingOfIntegers K ⧸ q) * (π.2.2.2.unit : NumberField.RingOfIntegers K ⧸ q)
      rw [IsUnit.unit_spec, IsUnit.unit_spec]
      change Ideal.Quotient.mk q ((u : NumberField.RingOfIntegers K) * π.1) =
        Ideal.Quotient.mk q (u : NumberField.RingOfIntegers K) * Ideal.Quotient.mk q π.1
      exact map_mul (Ideal.Quotient.mk q) (u : NumberField.RingOfIntegers K) π.1
    have h_norm : (Algebra.norm ℤ ((e π : D) : NumberField.RingOfIntegers K)).natAbs =
        (Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs := by
      change (Algebra.norm ℤ ((u : NumberField.RingOfIntegers K) * π.1)).natAbs =
        (Algebra.norm ℤ π.1).natAbs
      rw [map_mul, Int.natAbs_mul, Int.natAbs_of_isUnit (u.isUnit.map (Algebra.norm ℤ)), one_mul]
    rw [h_unit, ofMul_mul, AddChar.map_add_eq_mul, h_norm, mul_assoc]
  set S : ℂ := ∑' π : D, F π
  have hS_eq : ψ (Additive.ofMul u_bar) * S = S := by
    calc ψ (Additive.ofMul u_bar) * S
      _ = ∑' π : D, ψ (Additive.ofMul u_bar) * F π := (tsum_mul_left).symm
      _ = ∑' π : D, F (e π) := by simp_rw [← hF_eq]
      _ = S := Equiv.tsum_eq e F
  have h_sub : (ψ (Additive.ofMul u_bar) - 1) * S = 0 := by
    rw [sub_mul, one_mul, sub_eq_zero]
    exact hS_eq
  rcases mul_eq_zero.mp h_sub with h_zero | hS_zero
  · exact False.elim (hu_ne (sub_eq_zero.mp h_zero))
  · exact hS_zero

theorem mitsui_convex_grid_boundary_card_bound {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (m : ℕ) (hm : 1 ≤ m)
    (C : Set (NumberField.mixedEmbedding.mixedSpace K))
    (hC_conv : Convex ℝ C) (hC_open : IsOpen C) :
    (Nat.card {k : NumberField.mixedEmbedding.index K → Fin (2 * m) //
      ({z : NumberField.mixedEmbedding.mixedSpace K |
          ∀ i : NumberField.mixedEmbedding.index K,
            (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
              Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))} ∩ C).Nonempty ∧
      ¬ ({z : NumberField.mixedEmbedding.mixedSpace K |
          ∀ i : NumberField.mixedEmbedding.index K,
            (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
              Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))} ⊆ C)} : ℝ) ≤
    (2 : ℝ) ^ (3 * Module.finrank ℚ K) * (m : ℝ) ^ (Module.finrank ℚ K - 1) :=
by
  classical
  let ι := NumberField.mixedEmbedding.index K
  let b := NumberField.mixedEmbedding.stdBasis K
  set n : ℕ := Module.finrank ℚ K
  have hcard_ι : Fintype.card ι = n := by
    rw [← Module.finrank_eq_card_basis b, NumberField.mixedEmbedding.finrank K]
  have hn_pos : 0 < n := Module.finrank_pos
  have hcard_pos : 0 < Fintype.card ι := by omega
  obtain ⟨i₀⟩ := Fintype.card_pos_iff.mp hcard_pos
  have hX_pos : 0 < X := by linarith
  have hmR_pos : (0 : ℝ) < (m : ℝ) := by exact_mod_cast (by omega : 0 < m)
  set δ : ℝ := X / (m : ℝ)
  have hδ_pos : 0 < δ := div_pos hX_pos hmR_pos
  let Q : (ι → Fin (2 * m)) → Set (NumberField.mixedEmbedding.mixedSpace K) :=
    fun k => {z : NumberField.mixedEmbedding.mixedSpace K |
      ∀ i : ι, b.repr z i ∈
        Set.Ico (δ * (((k i : ℕ) : ℝ) - (m : ℝ)))
          (δ * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))}
  set ℬ := {k : ι → Fin (2 * m) // (Q k ∩ C).Nonempty ∧ ¬ (Q k ⊆ C)}
  have hy_ex : ∀ k : ℬ, ∃ y ∈ Q k.1, y ∉ C := fun k => Set.not_subset.mp k.2.2
  let y : ℬ → NumberField.mixedEmbedding.mixedSpace K := fun k => (hy_ex k).choose
