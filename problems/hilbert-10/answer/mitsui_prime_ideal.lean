        have hx_bds := abs_le.mp hx_err
        have hy_bds := abs_le.mp hy_err
        have h_strip :
            (((q.1 * Real.cos q.2 ∈ Set.Icc (a₀ - ε) (a₀ + ε) ∨
                q.1 * Real.cos q.2 ∈ Set.Icc (b₀ - ε) (b₀ + ε)) ∧
              q.1 * Real.sin q.2 ∈ Set.Icc (-X) X) ∨
             (q.1 * Real.cos q.2 ∈ Set.Icc (-X) X ∧
              (q.1 * Real.sin q.2 ∈ Set.Icc (a₁ - ε) (a₁ + ε) ∨
                q.1 * Real.sin q.2 ∈ Set.Icc (b₁ - ε) (b₁ + ε)))) := by
