theorem mitsui_exists_fundSystem_char_ne_one {K : Type u} [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K))
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ)
    (hψ_tors : ∀ u ∈ NumberField.Units.torsion K,
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1)
    (hψ_units : ∃ u : (NumberField.RingOfIntegers K)ˣ,
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) ≠ 1) :
    ∃ j₀ : Fin (NumberField.Units.rank K),
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom
        (NumberField.Units.fundSystem K j₀))) ≠ 1 :=
by
  let φ : (NumberField.RingOfIntegers K)ˣ →* ℂ :=
    { toFun := fun v => ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom v))
      map_one' := by rw [map_one, ofMul_one, AddChar.map_zero_eq_one]
      map_mul' := fun x y => by rw [map_mul, ofMul_mul, AddChar.map_add_eq_mul] }
  by_contra h_all
  push_neg at h_all
  obtain ⟨u, hu_ne⟩ := hψ_units
  obtain ⟨ζe, hu_eq, _⟩ := NumberField.Units.exist_unique_eq_mul_prod K u
  have hφ_u : φ u = 1 := by
    have h1 := congrArg φ hu_eq
    rw [map_mul, map_prod] at h1
    have htors : φ ζe.1.1 = 1 := hψ_tors ζe.1.1 ζe.1.2
    have hprod : ∏ i : Fin (NumberField.Units.rank K), φ (NumberField.Units.fundSystem K i ^ ζe.2 i) = 1 := by
      apply Finset.prod_eq_one
      intro i _
      rw [map_zpow]
      change (ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom (NumberField.Units.fundSystem K i)))) ^ (ζe.2 i) = 1
      rw [h_all i, one_zpow]
    rw [h1, htors, hprod, mul_one]
  exact hu_ne hφ_u

