        have h_proj := congrArg proj h_repr
        rw [map_sum] at h_proj
        have h_rhs : proj z_star = if w = w₁ then -1 else 1 := rfl
        rw [h_rhs] at h_proj
        rw [← h_proj]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [map_smul, smul_eq_mul]
        congr 1
        symm
        change (B i).1 ⟨w, hw⟩ = (w.embedding ((b i : NumberField.RingOfIntegers K) : K)).re
        rw [hB_eq i, NumberField.mixedEmbedding.mixedEmbedding_apply_isReal]
        have h1 := NumberField.InfinitePlace.embedding_of_isReal_apply hw ((b i : NumberField.RingOfIntegers K) : K)
