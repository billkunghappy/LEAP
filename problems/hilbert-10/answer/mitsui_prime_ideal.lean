                  (W * H * C_vcoeff * Real.exp 1 * (2 * c_base))) *
                (Y₀ * Real.exp (-t / c_large)) := by ring
            _ ≤ c_large * (Y₀ * Real.exp (-t / c_large)) :=
              mul_le_mul_of_nonneg_right h_coeff hYE_nonneg
            _ = c_large * Y₀ * Real.exp (-t / c_large) := by ring
        linarith only [h_tri, h_s13, h_zero_mode_sub, h_term1, h_term2, h_term3, h_term4, h_sum_le]
      have h_W_mul :
          W * |Ψ₁_cell_ne - M_coeff * Z| = |Ψ₁_arch - W * M_coeff * Z| := by
        have h1 : Ψ₁_arch - W * M_coeff * Z = W * (Ψ₁_cell_ne - M_coeff * Z) := by
          rw [← hW_cell_eq]
          ring
        rw [h1, abs_mul, abs_of_pos hW_pos]
      calc |Ψ₁_cell_ne - M_coeff * Z|
        _ = 1 * |Ψ₁_cell_ne - M_coeff * Z| := (one_mul _).symm
        _ ≤ W * |Ψ₁_cell_ne - M_coeff * Z| :=
          mul_le_mul_of_nonneg_right hW_ge_one (abs_nonneg _)
        _ = |Ψ₁_arch - W * M_coeff * Z| := h_W_mul
        _ ≤ c_large * Y₀ * Real.exp (-t / c_large) := h_arch_sub
  have h_main_eq :
      κ₀ * ((n : ℝ)⁻¹ * (∏ w : NumberField.InfinitePlace K, (MeasureTheory.volume (V w)).toReal) * Z) =
      M_coeff * Z := by
    dsimp [M_coeff]; ring
  rw [← hΨ₁_cell_ne_def]
  change |Ψ₁_cell_ne -
      κ₀ * ((n : ℝ)⁻¹ * (∏ w : NumberField.InfinitePlace K, (MeasureTheory.volume (V w)).toReal) * Z)| ≤
    c_large * Y₀ * Real.exp (-t / c_large)
  rwa [h_main_eq]

theorem mitsui_primePower_decoupled_norm_dir_log_cell_asymptotic {K : Type u} [Field K] [NumberField K] :
    ∃ c_pp : ℝ, 0 < c_pp ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m → (m : ℝ) ≤ Real.exp (Real.sqrt (Real.log X)) →
          ∀ R₁ : ℝ, 1 < R₁ → R₁ ≤ X →
            ∀ k : NumberField.mixedEmbedding.index K → Fin (2 * m),
              ∀ w₀ : NumberField.InfinitePlace K,
                ∀ l : ℕ, 1 ≤ l →
                  ∀ p : NumberField.InfinitePlace K → Fin l,
                    (p w₀ : ℕ) + 1 = l →
                    ∀ Y : ℝ, 0 < Y → Y ≤ X ^ (Module.finrank ℚ K) →
                      |(∑' xpm : {xpm : NumberField.RingOfIntegers K ×
                              IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                            1 ≤ xpm.2.2 ∧
                            Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
                            (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Y ∧
                            (∀ i : NumberField.mixedEmbedding.index K,
                              R₁ *
                                ((NumberField.mixedEmbedding.stdBasis K).repr
                                    (NumberField.mixedEmbedding K (xpm.1 : K)) i / w₀ (xpm.1 : K)) ∈
                                Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                                  ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
                            (∀ w : NumberField.InfinitePlace K,
                              Real.log (w (xpm.1 : K) / w₀ (xpm.1 : K)) ∈
                                Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
                                  (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ))))},
                          Real.log (Ideal.absNorm xpm.1.2.1.asIdeal))
                        - ((NumberField.Units.torsionOrder K : ℝ) /
                            ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) *
                              (NumberField.classNumber K : ℝ) *
                              NumberField.Units.regulator K)) *
                          ((Module.finrank ℚ K : ℝ)⁻¹ *
                            (∏ w : NumberField.InfinitePlace K,
                              (MeasureTheory.volume {q : ℝ × ℝ |
                                (w = w₀ ∧
                                  q.1 ∈ Set.Ioo (0 : ℝ) 1 ∧
                                  ((∃ hw : w.IsReal,
                                      (q.2 ∈ Set.Ioo (0 : ℝ) 1 ∧
                                        R₁ ∈
                                          Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                            ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1))) ∨
                                      (q.2 ∈ Set.Ioo (1 : ℝ) 2 ∧
                                        -R₁ ∈
                                          Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                            ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)))) ∨
                                    (∃ hc : w.IsComplex,
                                      q.2 ∈ Set.Ioo (-Real.pi) Real.pi ∧
                                      R₁ * Real.cos q.2 ∈
                                        Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                                          ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
                                      R₁ * Real.sin q.2 ∈
                                        Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                                          ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1))))) ∨
                                (w ≠ w₀ ∧
                                  q.1 ∈
                                    Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
                                      (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ))) ∧
                                  ((∃ hw : w.IsReal,
                                      (q.2 ∈ Set.Ioo (0 : ℝ) 1 ∧
                                        R₁ * Real.exp q.1 ∈
                                          Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                            ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1))) ∨
                                      (q.2 ∈ Set.Ioo (1 : ℝ) 2 ∧
                                        -(R₁ * Real.exp q.1) ∈
                                          Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                            ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)))) ∨
                                    (∃ hc : w.IsComplex,
                                      q.2 ∈ Set.Ioo (-Real.pi) Real.pi ∧
                                      (R₁ * Real.exp q.1) * Real.cos q.2 ∈
                                        Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                                          ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
                                      (R₁ * Real.exp q.1) * Real.sin q.2 ∈
                                        Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                                          ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1)))))}).toReal) *
                            Y)|
                        ≤ c_pp * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_pp) :=
by
  classical
  obtain ⟨c_gen, hc_gen_pos, hc_gen⟩ := mitsui_decoupled_log_cell_generator_card_bound (K := K)
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_riesz_primePowers_asymptotic (K := K)
  obtain ⟨c_large, hc_large_pos, hc_large⟩ :=
    mitsui_riesz_primePower_decoupled_norm_dir_log_cell_asymptotic_of_large_Z (K := K)
  set n : ℕ := Module.finrank ℚ K
  have hn_pos : 0 < n := Module.finrank_pos
  have hn_rpos : (0 : ℝ) < (n : ℝ) := Nat.cast_pos.mpr hn_pos
  set r : ℕ := NumberField.Units.rank K
  set M_places : ℕ := Fintype.card (NumberField.InfinitePlace K)
  have hM_places_pos : 0 < M_places := Fintype.card_pos
  set d_exp : ℕ := r + M_places
  set W : ℝ := (NumberField.Units.torsionOrder K : ℝ)
  have hW_pos : 0 < W := by
    change (0 : ℝ) < (NumberField.Units.torsionOrder K : ℝ)
    exact_mod_cast NumberField.Units.torsionOrder_pos K
  set F : ℝ := (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
  have hF_pos : 0 < F := by
    change (0 : ℝ) < (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
    have h1 := NumberField.mixedEmbedding.one_le_convexBodyLTFactor K
    exact_mod_cast lt_of_lt_of_le zero_lt_one h1
  set H : ℝ := (NumberField.classNumber K : ℝ)
  have hH_pos : 0 < H := by
    change (0 : ℝ) < (NumberField.classNumber K : ℝ)
    exact_mod_cast NumberField.classNumber_pos K
  set R_reg : ℝ := NumberField.Units.regulator K
  have hR_reg_pos : 0 < R_reg := NumberField.Units.regulator_pos K
  set κ₀ : ℝ := W / (F * H * R_reg)
  have hκ₀_pos : 0 < κ₀ := by dsimp [κ₀]; positivity
  set C_vol : ℝ := κ₀ * (n : ℝ)⁻¹ * (2 * Real.pi) ^ M_places
  have hC_vol_pos : 0 < C_vol := by dsimp [C_vol]; positivity
  set c'_small : ℝ := 1 / (4 * ((d_exp : ℝ) + 1))
  have hc'_small_pos : 0 < c'_small := by dsimp [c'_small]; positivity
  set K₀_small : ℝ := 16 / c'_small ^ 2 + 1
  have hK₀_small_pos : 0 < K₀_small := by dsimp [K₀_small]; positivity
  set A_small : ℝ := (c_gen * (1 + c₁) + C_vol) * K₀_small ^ d_exp
  have hA_small_pos : 0 < A_small := by dsimp [A_small]; positivity
  set c_low : ℝ := (c_gen * (1 + c₁) + C_vol) * (2 : ℝ) ^ d_exp * Real.exp 1 * Real.exp 1
  have hc_low_pos : 0 < c_low := by dsimp [c_low]; positivity
  set c₀ : ℝ := max 4 (c_low + A_small + c_large)
  have hc₀_ge_4 : 4 ≤ c₀ := le_max_left 4 (c_low + A_small + c_large)
  have hc₀_pos : 0 < c₀ := lt_of_lt_of_le (by norm_num) hc₀_ge_4
  have h_sum_le_c₀ : c_low + A_small + c_large ≤ c₀ := le_max_right 4 (c_low + A_small + c_large)
  have hc_low_le_c₀ : c_low ≤ c₀ := by linarith
  have hA_small_le_c₀ : A_small ≤ c₀ := by linarith
  have hc_large_le_c₀ : c_large ≤ c₀ := by linarith
  set c : ℝ := max 1 (c₀ + c₁)
  have hc_ge_one : 1 ≤ c := le_max_left 1 (c₀ + c₁)
  have hc_pos : 0 < c := lt_of_lt_of_le zero_lt_one hc_ge_one
  have hc01_le : c₀ + c₁ ≤ c := le_max_right 1 (c₀ + c₁)
  have hc₀_le : c₀ ≤ c := by linarith
  have hc₁_le : c₁ ≤ c := by linarith
  set C₁ : ℝ := c * Real.exp (1 + 2 / c)
  have hC₁_pos : 0 < C₁ := by dsimp [C₁]; positivity
  set C_diff : ℝ := 4 * C₁ + 2
  have hC_diff_pos : 0 < C_diff := by dsimp [C_diff]; positivity
  set c' : ℝ := 1 / (4 * ((d_exp : ℝ) + 1) * c)
  have hc'_pos : 0 < c' := by dsimp [c']; positivity
  set K₀ : ℝ := 16 / c' ^ 2 + 1
  have hK₀_pos : 0 < K₀ := by dsimp [K₀]; positivity
  set A_diff : ℝ := (c_gen * C_diff + C_vol) * K₀ ^ d_exp
  have hA_diff_pos : 0 < A_diff := by dsimp [A_diff]; positivity
  let c_pp : ℝ := 2 * c + A_diff + 4 * c
  have hc_pp_pos : 0 < c_pp := by dsimp [c_pp]; positivity
  refine ⟨c_pp, hc_pp_pos, ?_⟩
  intro X hX m hm hm_coarse R₁ hR₁_gt hR₁_le k w₀ l hl p hp₀ Y hY_pos hY_le_Y₀
  set Y₀ : ℝ := X ^ n
  have hX_pos : (0 : ℝ) < X := by linarith
  have hY₀_gt_one : 1 < Y₀ := one_lt_pow₀ hX (ne_of_gt hn_pos)
  have hY₀_pos : 0 < Y₀ := by linarith
  have hlogX_pos : 0 < Real.log X := Real.log_pos hX
  have hl_rpos : (0 : ℝ) < (l : ℝ) := Nat.cast_pos.mpr hl
