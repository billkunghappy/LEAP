              (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)) s := by
      rw [h_ev_g.deriv_eq, hg_eq s hs_gt_one, ← hΛ_eq]
    rw [h_logDeriv_eq]
    set Z_s : ℂ := LSeries (fun n =>
        ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
          (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
            (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)) s
    have h_norm_le : ‖Z_s‖ ≤ M₀ / (5 / 4 - 1) :=
      h_rhp_LSeries χ hχ_norm s (5 / 4) (by norm_num) (by norm_num) (le_of_lt hs_gt_54)
    have h_re_le_norm : Z_s.re ≤ 4 * M₀ := by
      have h1 : Z_s.re ≤ ‖Z_s‖ := le_trans (le_abs_self _) (Complex.abs_re_le_norm Z_s)
      have h2 : M₀ / (5 / 4 - 1) = 4 * M₀ := by ring
      linarith
    have h_4M₀_le : 4 * M₀ ≤ A₀ * L_q := by
      calc 4 * M₀
          = 4 * M₀ * 1 := by ring
        _ ≤ 4 * M₀ * L_q := mul_le_mul_of_nonneg_left (by linarith) (by positivity)
        _ ≤ A₀ * L_q := by
            have : 4 * M₀ ≤ A₀ := by
              have : 0 ≤ 2 * (A : ℝ) * C₂ := by positivity
              dsimp [A₀]; linarith
            exact mul_le_mul_of_nonneg_right this (le_of_lt hLq_pos)
    linarith

theorem mitsui_ray_char_LSeries_analytic_continuation_bound {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ (B C : ℝ), 0 < B ∧ B ≤ 1 / 2 ∧ 0 < C ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
        ∀ χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ,
          (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
            x - 1 ∈ q →
            χ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
              mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1) →
          (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
            ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ I‖ = 1) ∧
            (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ I = 0)) →
          (∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
            (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ ∧ χ I₀ ≠ 1) →
          ∃ D : ℂ → ℂ,
            (∀ s : ℂ, 1 < s.re →
              D s = LSeries (fun n =>
                ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                      1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
                  (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
                    (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)) s) ∧
            (∀ s : ℂ,
              1 - B / ((Ideal.absNorm q : ℝ) ^ (1 / (2 * (A : ℝ))) + Real.log (4 + |s.im|)) ≤ s.re →
              DifferentiableAt ℂ D s ∧
              ‖D s‖ ≤ C * ((Ideal.absNorm q : ℝ) ^ (1 / (2 * (A : ℝ))) + Real.log (4 + |s.im|))) :=
by
  classical
  have h_bc : ∀ (F : ℂ → ℂ) (s₀ : ℂ) (R M : ℝ), 0 < R → 0 ≤ M →
      (∀ w ∈ Metric.closedBall s₀ R, DifferentiableAt ℂ F w) →
      (∀ w ∈ Metric.closedBall s₀ R, (F w).re ≤ M) →
      ∀ s ∈ Metric.closedBall s₀ (R / 2),
        ‖F s‖ ≤ 2 * M + 3 * ‖F s₀‖ := by
    intro F s₀ R M hR hM hF_diff hF_re s hs
    have hs_dist : ‖s - s₀‖ ≤ R / 2 := by
      simpa [Metric.mem_closedBall, dist_eq_norm] using hs
    set z : ℂ := s - s₀
    have hz_ball : ‖z‖ < R := by linarith
    let F₁ : ℂ → ℂ := fun u => F (s₀ + u) - F s₀
    have hF₁_zero : F₁ 0 = 0 := by simp [F₁]
    have h_u_mem : ∀ u ∈ Metric.ball (0 : ℂ) R, s₀ + u ∈ Metric.closedBall s₀ R := by
      intro u hu
      rw [Metric.mem_ball, dist_zero_right] at hu
      rw [Metric.mem_closedBall, dist_eq_norm, add_sub_cancel_left]
      exact le_of_lt hu
    have hF₁_diff : ∀ u ∈ Metric.ball (0 : ℂ) R, DifferentiableAt ℂ F₁ u := by
      intro u hu
      dsimp [F₁]
      exact ((hF_diff (s₀ + u) (h_u_mem u hu)).comp u
        ((differentiableAt_const s₀).add differentiableAt_id)).sub (differentiableAt_const (F s₀))
    have hF₁_re : ∀ u ∈ Metric.ball (0 : ℂ) R, (F₁ u).re ≤ M + ‖F s₀‖ := by
      intro u hu
      dsimp [F₁]
      have h1 : (F (s₀ + u)).re ≤ M := hF_re (s₀ + u) (h_u_mem u hu)
      have h2 : -(F s₀).re ≤ ‖F s₀‖ :=
        le_trans (neg_le_abs _) (Complex.abs_re_le_norm (F s₀))
      linarith
    apply le_of_forall_pos_le_add
    intro ε hε
    let A₁ : ℝ := M + ‖F s₀‖ + ε / 2
    have hA₁_pos : 0 < A₁ := by
      have : 0 ≤ ‖F s₀‖ := norm_nonneg _
      dsimp [A₁]; linarith
    let ϕ : ℂ → ℂ := fun u => (R : ℂ) * F₁ u / (2 * (A₁ : ℂ) - F₁ u)
    have h_denom_re : ∀ u ∈ Metric.ball (0 : ℂ) R, A₁ ≤ (2 * (A₁ : ℂ) - F₁ u).re := by
      intro u hu
      have h1 := hF₁_re u hu
      simp only [Complex.sub_re, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
        Complex.re_ofNat, Complex.im_ofNat, mul_zero, sub_zero]
      dsimp [A₁]
      linarith
    have h_denom_ne : ∀ u ∈ Metric.ball (0 : ℂ) R, 2 * (A₁ : ℂ) - F₁ u ≠ 0 := by
      intro u hu h0
      have h1 := h_denom_re u hu
      rw [h0, Complex.zero_re] at h1
      linarith
    have hϕ_diff : DifferentiableOn ℂ ϕ (Metric.ball (0 : ℂ) R) := by
      intro u hu
      refine DifferentiableAt.differentiableWithinAt ?_
      dsimp [ϕ]
      exact ((differentiableAt_const (R : ℂ)).mul (hF₁_diff u hu)).div
        ((differentiableAt_const (2 * (A₁ : ℂ))).sub (hF₁_diff u hu)) (h_denom_ne u hu)
    have hϕ_maps : Set.MapsTo ϕ (Metric.ball (0 : ℂ) R) (Metric.closedBall (0 : ℂ) R) := by
      intro u hu
      rw [Metric.mem_closedBall, dist_zero_right]
      dsimp [ϕ]
      rw [norm_div, norm_mul, Complex.norm_of_nonneg (le_of_lt hR)]
      have h_le_denom : ‖F₁ u‖ ≤ ‖2 * (A₁ : ℂ) - F₁ u‖ := by
        rw [← sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)]
        simp only [Complex.sq_norm, Complex.normSq_apply, Complex.sub_re, Complex.sub_im,
          Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
          Complex.re_ofNat, Complex.im_ofNat, mul_zero, sub_zero]
        have h1 : (F₁ u).re ≤ A₁ := by
          have := hF₁_re u hu
          dsimp [A₁]; linarith
        nlinarith
      have h_denom_pos : 0 < ‖2 * (A₁ : ℂ) - F₁ u‖ := norm_pos_iff.mpr (h_denom_ne u hu)
      have h_div_le : R * ‖F₁ u‖ / ‖2 * (A₁ : ℂ) - F₁ u‖ ≤ R * 1 := by
        rw [div_le_iff₀ h_denom_pos, mul_one]
        exact mul_le_mul_of_nonneg_left h_le_denom (le_of_lt hR)
      linarith
    have hϕ_zero : ϕ 0 = 0 := by
      dsimp [ϕ]
      rw [hF₁_zero, mul_zero, zero_div]
    have h_schwarz : ‖ϕ z‖ ≤ ‖z‖ :=
      Complex.norm_le_norm_of_mapsTo_ball hϕ_diff hϕ_maps hϕ_zero hz_ball
    have h_ϕz_le : ‖ϕ z‖ ≤ R / 2 := le_trans h_schwarz hs_dist
    have hz_in_ball : z ∈ Metric.ball (0 : ℂ) R := by
      rwa [Metric.mem_ball, dist_zero_right]
    have h_denom_z_pos : 0 < ‖2 * (A₁ : ℂ) - F₁ z‖ :=
      norm_pos_iff.mpr (h_denom_ne z hz_in_ball)
    have h_norm_ϕz : ‖ϕ z‖ = R * ‖F₁ z‖ / ‖2 * (A₁ : ℂ) - F₁ z‖ := by
      dsimp [ϕ]
      rw [norm_div, norm_mul, Complex.norm_of_nonneg (le_of_lt hR)]
    rw [h_norm_ϕz, div_le_iff₀ h_denom_z_pos] at h_ϕz_le
    have h_F₁z_le_half : R * ‖F₁ z‖ ≤ R * (A₁ + ‖F₁ z‖ / 2) := by
      have h_tri : ‖2 * (A₁ : ℂ) - F₁ z‖ ≤ 2 * A₁ + ‖F₁ z‖ := by
        calc ‖2 * (A₁ : ℂ) - F₁ z‖
            ≤ ‖2 * (A₁ : ℂ)‖ + ‖F₁ z‖ := norm_sub_le _ _
          _ = 2 * A₁ + ‖F₁ z‖ := by
              have h2A : (2 : ℂ) * (A₁ : ℂ) = ((2 * A₁ : ℝ) : ℂ) := by push_cast; ring
              rw [h2A, Complex.norm_of_nonneg (by positivity)]
      calc R * ‖F₁ z‖
          ≤ R / 2 * ‖2 * (A₁ : ℂ) - F₁ z‖ := h_ϕz_le
        _ ≤ R / 2 * (2 * A₁ + ‖F₁ z‖) :=
            mul_le_mul_of_nonneg_left h_tri (by positivity)
        _ = R * (A₁ + ‖F₁ z‖ / 2) := by ring
    have h_F₁z_le_2A : ‖F₁ z‖ ≤ 2 * A₁ := by
      have h1 := le_of_mul_le_mul_left h_F₁z_le_half hR
      linarith
    have h_Fs_eq : F s = F₁ z + F s₀ := by
      dsimp [F₁, z]
      ring_nf
    calc ‖F s‖
        = ‖F₁ z + F s₀‖ := by rw [h_Fs_eq]
      _ ≤ ‖F₁ z‖ + ‖F s₀‖ := norm_add_le _ _
      _ ≤ 2 * A₁ + ‖F s₀‖ := by linarith
      _ = 2 * M + 3 * ‖F s₀‖ + ε := by dsimp [A₁]; ring
  obtain ⟨M₀, hM₀_pos, h_rhp_LSeries⟩ := mitsui_ray_char_LSeries_norm_le_of_one_lt_re (K := K)
  obtain ⟨B₀, A₀, hB₀_pos, hB₀_le, hA₀_pos, h_hecke⟩ :=
    mitsui_ray_char_heckeL_zeroFree_and_re_logDeriv_bound (K := K) A hA
  let M₁ : ℝ := (4 * M₀) / B₀
  have hM₁_pos : 0 < M₁ := by dsimp [M₁]; positivity
  let B : ℝ := B₀ / 8
  let C : ℝ := 4 * A₀ + 3 * M₁
  have hB_pos : 0 < B := by dsimp [B]; positivity
  have hB_le : B ≤ 1 / 2 := by dsimp [B]; linarith
  have hC_pos : 0 < C := by dsimp [C]; positivity
  have hlog4_gt_one : 1 < Real.log 4 := by
    rw [← Real.log_exp 1]
    exact Real.log_lt_log (Real.exp_pos 1) (by linarith [Real.exp_one_lt_d9])
  have h_log_ge_one : ∀ t : ℝ, 1 ≤ Real.log (4 + |t|) := by
    intro t
    have ht : 4 ≤ 4 + |t| := by linarith [abs_nonneg t]
    exact le_trans (le_of_lt hlog4_gt_one) (Real.log_le_log (by norm_num) ht)
  refine ⟨B, C, hB_pos, hB_le, hC_pos, ?_⟩
  intro q hq χ hχ_ray hχ_norm_supp hχ_nonprin
  have hχ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ I‖ ≤ 1 := by
    intro I
    by_cases hI : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤
    · rw [(hχ_norm_supp I).1 hI]
    · rw [(hχ_norm_supp I).2 hI, norm_zero]
      linarith
  set M_q : ℝ := (Ideal.absNorm q : ℝ) ^ (1 / (2 * (A : ℝ)))
  have hq_norm_ne_zero : Ideal.absNorm q ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hq
  have hq_norm_ge_one : (1 : ℝ) ≤ (Ideal.absNorm q : ℝ) := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr hq_norm_ne_zero
  have hMq_ge_one : 1 ≤ M_q := by
    dsimp [M_q]
    exact Real.one_le_rpow hq_norm_ge_one (by positivity)
  obtain ⟨g_χ, hg_diff, hg_eq, hg_dlvp⟩ := h_hecke q hq χ hχ_ray hχ_norm_supp hχ_nonprin
  let D : ℂ → ℂ := fun s => -deriv g_χ s / g_χ s
  have h_deriv_diff : Differentiable ℂ (deriv g_χ) := by
    rw [← differentiableOn_univ]
    exact hg_diff.differentiableOn.deriv isOpen_univ
  have hD_diff_of_ne : ∀ s : ℂ, g_χ s ≠ 0 → DifferentiableAt ℂ D s := by
    intro s h_ne
    dsimp [D]
    exact (h_deriv_diff s).neg.div (hg_diff s) h_ne
  have hD_eq : ∀ s : ℂ, 1 < s.re →
      D s = LSeries (fun n =>
        ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
          (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
            (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)) s := by
    intro s hs
    obtain ⟨_, hΛ_eq⟩ := mitsui_ray_char_LSeries_primePowers_eq_neg_logDeriv χ hχ_norm s hs
    have hU_mem : {w : ℂ | 1 < w.re} ∈ nhds s :=
      (isOpen_lt continuous_const Complex.continuous_re).mem_nhds hs
    have h_ev_g : g_χ =ᶠ[nhds s] LSeries (fun n =>
        ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
          χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) := by
      filter_upwards [hU_mem] with w hw
      exact hg_eq w hw
    dsimp [D]
    rw [h_ev_g.deriv_eq, hg_eq s hs, ← hΛ_eq]
  let σ₀ : ℝ → ℝ := fun t => 1 + B₀ / (4 * (M_q + Real.log (4 + |t|)))
  have h_rhp_bound : ∀ s : ℂ, σ₀ s.im ≤ s.re →
      ‖D s‖ ≤ M₁ * (M_q + Real.log (4 + |s.im|)) := by
    intro s hs_re
    set t : ℝ := s.im
    set L_q : ℝ := M_q + Real.log (4 + |t|)
    have hL_ge_one : 1 ≤ Real.log (4 + |t|) := h_log_ge_one t
    have hLq_ge_two : 2 ≤ L_q := by dsimp [L_q]; linarith
    have hLq_pos : 0 < L_q := by linarith
    have hσ₀_gt_one : 1 < σ₀ t := by
      dsimp [σ₀]
      have : 0 < B₀ / (4 * L_q) := by positivity
      linarith
    have hσ₀_le_two : σ₀ t ≤ 2 := by
      dsimp [σ₀]
      have h1 : B₀ ≤ 4 * L_q := by linarith
      have h2 : B₀ / (4 * L_q) ≤ 1 := (div_le_one (by positivity)).mpr h1
      linarith
    have hs_gt_one : 1 < s.re := lt_of_lt_of_le hσ₀_gt_one hs_re
    rw [hD_eq s hs_gt_one]
    have h_bound := h_rhp_LSeries χ hχ_norm s (σ₀ t) hσ₀_gt_one hσ₀_le_two hs_re
    have h_eq : M₀ / (σ₀ t - 1) = M₁ * L_q := by
      dsimp [σ₀, M₁]
      have h_sub : 1 + B₀ / (4 * L_q) - 1 = B₀ / (4 * L_q) := by ring
      rw [h_sub]
      field_simp [ne_of_gt hB₀_pos, ne_of_gt hLq_pos]
    linarith
  refine ⟨D, hD_eq, ?_⟩
  intro s hs
  set t : ℝ := s.im
  set L : ℝ := Real.log (4 + |t|)
  set L_q : ℝ := M_q + L
  have hL_ge_one : 1 ≤ L := h_log_ge_one t
  have hLq_ge_two : 2 ≤ L_q := by dsimp [L_q]; linarith
  have hLq_pos : 0 < L_q := by linarith
  have hs_B₀ : 1 - B₀ / L_q ≤ s.re := by
    have hB_le_B₀ : B ≤ B₀ := by dsimp [B]; linarith
    have h_div : B / L_q ≤ B₀ / L_q := div_le_div_of_nonneg_right hB_le_B₀ (le_of_lt hLq_pos)
    linarith
  have hD_diff_s : DifferentiableAt ℂ D s := hD_diff_of_ne s (hg_dlvp s hs_B₀).1
  refine ⟨hD_diff_s, ?_⟩
  rcases le_or_gt (σ₀ t) s.re with hs_rhp | hs_collar
  · have h1 : ‖D s‖ ≤ M₁ * L_q := h_rhp_bound s hs_rhp
    have hM₁_le_C : M₁ ≤ C := by dsimp [C]; linarith
    calc ‖D s‖
        ≤ M₁ * L_q := h1
      _ ≤ C * L_q := mul_le_mul_of_nonneg_right hM₁_le_C (le_of_lt hLq_pos)
  · let s₀ : ℂ := (σ₀ t : ℂ) + (t : ℂ) * Complex.I
    let R : ℝ := (3 * B₀) / (4 * L_q)
    have hR_pos : 0 < R := by dsimp [R]; positivity
    have hR_le_half : R ≤ 1 / 2 := by
      dsimp [R]
      have h1 : 3 * B₀ ≤ 2 * L_q := by linarith
      rw [div_le_iff₀ (by positivity)]
      linarith
    have hs₀_re : s₀.re = σ₀ t := by simp [s₀]
    have hs₀_im : s₀.im = t := by simp [s₀]
    have h_ball_dlvp : ∀ w ∈ Metric.closedBall s₀ R,
        DifferentiableAt ℂ D w ∧ (D w).re ≤ (2 * A₀) * L_q := by
      intro w hw
      have hw_norm : ‖w - s₀‖ ≤ R := by simpa [Metric.mem_closedBall, dist_eq_norm] using hw
      have hw_im_diff : |w.im - t| ≤ R := by
        have h1 : |w.im - s₀.im| ≤ ‖w - s₀‖ := by
          rw [← Complex.sub_im]
          exact Complex.abs_im_le_norm (w - s₀)
        rw [hs₀_im] at h1
        exact le_trans h1 hw_norm
      have hw_im_le : |w.im| ≤ |t| + 1 / 2 := by
        have h1 : |w.im| - |t| ≤ |w.im - t| := abs_sub_abs_le_abs_sub w.im t
        linarith
      have h_sq_ge : 4 + |w.im| ≤ (4 + |t|) ^ 2 := by
        have ht_nn : 0 ≤ |t| := abs_nonneg t
        nlinarith
      have h_log_w_le : Real.log (4 + |w.im|) ≤ 2 * L := by
        have h1 : Real.log (4 + |w.im|) ≤ Real.log ((4 + |t|) ^ 2) :=
          Real.log_le_log (by positivity) h_sq_ge
        rw [Real.log_pow] at h1
        push_cast at h1
        dsimp [L]; linarith
      have h_Lq_w_le : M_q + Real.log (4 + |w.im|) ≤ 2 * L_q := by
        dsimp [L_q]; linarith
      have h_Lq_w_pos : 0 < M_q + Real.log (4 + |w.im|) := by
        have := h_log_ge_one w.im
        linarith
      have hw_re_ge : 1 - B₀ / (2 * L_q) ≤ w.re := by
        have h1 : s₀.re - w.re ≤ ‖w - s₀‖ := by
          have h2 : -(w - s₀).re ≤ ‖w - s₀‖ :=
            le_trans (neg_le_abs _) (Complex.abs_re_le_norm (w - s₀))
          simpa using h2
        rw [hs₀_re] at h1
        dsimp [σ₀, R] at h1 hw_norm
        have h_eq : 1 + B₀ / (4 * L_q) - (3 * B₀) / (4 * L_q) = 1 - B₀ / (2 * L_q) := by ring
        linarith
      have hw_dlvp_cond : 1 - B₀ / (M_q + Real.log (4 + |w.im|)) ≤ w.re := by
        have h_div : B₀ / (2 * L_q) ≤ B₀ / (M_q + Real.log (4 + |w.im|)) :=
          div_le_div_of_nonneg_left (le_of_lt hB₀_pos) h_Lq_w_pos h_Lq_w_le
        linarith
      obtain ⟨hw_ne, hw_re_bound⟩ := hg_dlvp w hw_dlvp_cond
      refine ⟨hD_diff_of_ne w hw_ne, ?_⟩
      dsimp [D]
      calc (-deriv g_χ w / g_χ w).re
          ≤ A₀ * (M_q + Real.log (4 + |w.im|)) := hw_re_bound
        _ ≤ A₀ * (2 * L_q) := mul_le_mul_of_nonneg_left h_Lq_w_le (le_of_lt hA₀_pos)
        _ = (2 * A₀) * L_q := by ring
    have hs_in_half : s ∈ Metric.closedBall s₀ (R / 2) := by
      rw [Metric.mem_closedBall, dist_eq_norm]
      have h_diff_eq : s - s₀ = ((s.re - σ₀ t : ℝ) : ℂ) := by
        apply Complex.ext
        · simp [s₀]
        · simp [s₀, t]
      rw [h_diff_eq, Complex.norm_real, Real.norm_eq_abs, abs_of_neg (by linarith)]
      dsimp [σ₀, R, B] at hs ⊢
      have h_alg : -(s.re - (1 + B₀ / (4 * L_q))) = 1 - s.re + B₀ / (4 * L_q) := by ring
      have h_R2 : (3 * B₀) / (4 * L_q) / 2 = B₀ / 8 / L_q + B₀ / (4 * L_q) := by ring
      linarith
    have h_bc_s := h_bc D s₀ R ((2 * A₀) * L_q) hR_pos (by positivity)
      (fun w hw => (h_ball_dlvp w hw).1) (fun w hw => (h_ball_dlvp w hw).2) s hs_in_half
    have hs₀_rhp : σ₀ s₀.im ≤ s₀.re := by
      rw [hs₀_re, hs₀_im]
    have hD_s₀_le : ‖D s₀‖ ≤ M₁ * L_q := by
      have h1 : ‖D s₀‖ ≤ M₁ * (M_q + Real.log (4 + |s₀.im|)) := h_rhp_bound s₀ hs₀_rhp
      rwa [hs₀_im] at h1
    calc ‖D s‖
        ≤ 2 * ((2 * A₀) * L_q) + 3 * ‖D s₀‖ := h_bc_s
      _ ≤ 2 * ((2 * A₀) * L_q) + 3 * (M₁ * L_q) := by linarith
      _ = C * L_q := by dsimp [C]; ring

theorem mitsui_landauPage_integral_bound (B : ℝ) (hB : 0 < B) :
    ∃ c₁ : ℝ, 0 < c₁ ∧
      ∀ Y : ℝ, 1 < Y →
        ∀ M : ℝ, 1 ≤ M → M ≤ Real.sqrt (Real.log Y) →
          (∫ t : ℝ,
            Y ^ (1 - B / (M + Real.log (4 + |t|))) *
              ((M + Real.log (4 + |t|)) / (1 / 4 + t ^ 2))) ≤
            c₁ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁) :=
by
