      have h1 : Multiplicative.toAdd (ϕ₀ j ⟨I_x, hs⟩) = (QuotientAddGroup.mk (W₀ x j) : Q₁) := by
        change Multiplicative.toAdd (f j ⟨I_x, hs⟩) = _
        rw [hf_eq j ⟨I_x, hs⟩ x hx_ne rfl, toAdd_ofAdd]
      rw [← h1, ← hϕ j ⟨I_x, hs⟩, h_mk I_x j]
    refine ⟨fun j => (h_ex j).choose, fun w w₀ => ?_⟩
    rw [hW₀_log x hx_ne w w₀]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [(h_ex j).choose_spec]

theorem mitsui_exists_ideal_phaseCoord_extending_principal {K : Type u} [Field K] [NumberField K]
    (Φ_W : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →
