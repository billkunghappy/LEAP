            β w.1 * (NumberField.mixedEmbedding K (α : K)).1 w) +
          (∑ w : {w : NumberField.InfinitePlace K // w.IsComplex},
            β w.1 * ((NumberField.mixedEmbedding K (α : K)).2 w).re) =
          ∑ w : NumberField.InfinitePlace K, β w * (w.embedding (α : K)).re := by
        rw [h_split_places (fun w => β w * (w.embedding (α : K)).re)]
        rfl
      have h_sum2 : (∑ w : {w : NumberField.InfinitePlace K // w.IsComplex},
            (L w.1 : ℝ) * ((NumberField.mixedEmbedding K (α : K)).2 w).im) =
          ∑ w : NumberField.InfinitePlace K, (L w : ℝ) * (w.embedding (α : K)).im := by
        rw [h_split_places (fun w => (L w : ℝ) * (w.embedding (α : K)).im)]
        have h_real_im_zero : (∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
            (L w.1 : ℝ) * (w.1.embedding (α : K)).im) = 0 := by
          refine Finset.sum_eq_zero (fun w _ => ?_)
          have h1 := NumberField.InfinitePlace.embedding_of_isReal_apply w.2 (α : K)
          rw [← h1, Complex.ofReal_im, mul_zero]
        rw [h_real_im_zero, zero_add]
        rfl
      rw [h_sum1, h_sum2, h_lin α, sub_self]
    have hF_zero : F = 0 := by
      apply (NumberField.mixedEmbedding.latticeBasis K).ext
      intro i
      rw [hF_basis i, LinearMap.zero_apply]
    refine ⟨?_, ?_⟩
    · intro w
      rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw_real | hw_cplx
      · let z_test : NumberField.mixedEmbedding.mixedSpace K :=
