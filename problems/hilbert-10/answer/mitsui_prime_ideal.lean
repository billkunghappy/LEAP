theorem mitsui_prime_char_grid_cube_to_fundamentalCone_of_units_eq_one {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c_cf : ℝ, 0 < c_cf ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m → (m : ℝ) ≤ Real.exp (Real.sqrt (Real.log X)) →
          ∀ k : NumberField.mixedEmbedding.index K → Fin (2 * m),
            (∀ z : NumberField.mixedEmbedding.mixedSpace K,
                (∀ i : NumberField.mixedEmbedding.index K,
                  (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
                    Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                      ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) →
                ∀ w : NumberField.InfinitePlace K,
                  NumberField.mixedEmbedding.normAtPlace w z < X) →
            ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
              (Ideal.absNorm q : ℝ) < Real.log X ^ A →
              ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
                (∀ u : (NumberField.RingOfIntegers K)ˣ,
                  ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) →
                ‖(∑' π : {π : NumberField.RingOfIntegers K //
                      Prime π ∧
                      (∀ i : NumberField.mixedEmbedding.index K,
                        (NumberField.mixedEmbedding.stdBasis K).repr
                            (NumberField.mixedEmbedding K (π : K)) i ∈
                          Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                            ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
                      IsUnit (Ideal.Quotient.mk q π)},
                    ψ (Additive.ofMul π.2.2.2.unit) *
                      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
                  - (((X / (m : ℝ)) ^ (Module.finrank ℚ K) /
                      ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) *
                        NumberField.Units.regulator K *
                        X ^ (Module.finrank ℚ K)) : ℝ) : ℂ) *
                    (∑' π : {π : NumberField.RingOfIntegers K //
                          Prime π ∧
                          NumberField.mixedEmbedding K (π : K) ∈
                            NumberField.mixedEmbedding.fundamentalCone K ∧
                          NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤
                            X ^ (Module.finrank ℚ K) ∧
                          IsUnit (Ideal.Quotient.mk q π)},
                        ψ (Additive.ofMul π.2.2.2.2.unit) *
                          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
