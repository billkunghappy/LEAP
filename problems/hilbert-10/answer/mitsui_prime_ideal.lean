            · rw [Set.indicator_of_notMem hA]
      have h_vol_diff_eq : MeasureTheory.volume (V_cplx R₁ \ V_cplx R₀) =
          ∫⁻ q : ℝ × ℝ, A_exact.indicator (fun q => ENNReal.ofReal q.1) q := by
        rw [h_vol_polar (V_cplx R₁ \ V_cplx R₀) ((hV_meas R₁).diff (hV_meas R₀)), h_f_diff_eq]
      have h_vol_diff_le : (MeasureTheory.volume (V_cplx R₁ \ V_cplx R₀)).toReal ≤
          Real.pi * (R₁ ^ 2 - R₀ ^ 2) := by
        have h_sub_box : A_exact ⊆ Set.Ico R₀ R₁ ×ˢ Set.Ioo (-Real.pi) Real.pi :=
