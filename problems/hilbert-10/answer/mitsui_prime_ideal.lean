    have h_pow_nat : ((Ideal.absNorm p_id.asIdeal ^ ν : ℕ) : ℝ) ≤ Z := by exact_mod_cast h_pow
    have h_km_le : Ideal.absNorm p_id.asIdeal ^ ν ≤ ⌊Z⌋₊ := Nat.le_floor h_pow_nat
