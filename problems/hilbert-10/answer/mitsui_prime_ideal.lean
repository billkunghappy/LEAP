    have h_star := congrArg star h_primal
    have h_star_wz : star ((w z : ℂ)) = (w z : ℂ) := by
      rw [RCLike.star_def, Complex.conj_ofReal]
    rw [star_mul, star_pow, h_star_wz, star_pow, mul_comm] at h_star
    exact h_star
