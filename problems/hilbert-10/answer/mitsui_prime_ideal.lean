                (∑ i : Fin n, u₀ i * (l i : ℝ) : ℂ)) *
                (((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d' j) : ℝ) : ℂ) *
                (Real.exp (-Real.pi *
                  ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ))) := by
      have h_pull : (∑' l : Fin n → ℤ, G' l 0) =
          ((2 * Real.pi : ℂ) * (-Complex.I)) *
            ∑' l : Fin n → ℤ,
              Complex.exp (2 * Real.pi * Complex.I *
                (∑ i : Fin n, u₀ i * (l i : ℝ) : ℂ)) *
                (((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d' j) : ℝ) : ℂ) *
                (Real.exp (-Real.pi *
                  ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ)) := by
        rw [← tsum_mul_left]
        refine tsum_congr (fun l => ?_)
        dsimp [G', ξ]
        rw [zero_mul, sub_zero, Complex.ofReal_mul, mul_assoc]
        push_cast
        rfl
