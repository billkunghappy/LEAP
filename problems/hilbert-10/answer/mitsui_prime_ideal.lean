    have h2 : (∑' p : D_1, term_ge1 (e_one p).1) =
        ∑' pm : {pm : D_ge1 // pm.1.2 = 1}, term_ge1 pm.1 :=
      Equiv.tsum_eq e_one (fun pm : {pm : D_ge1 // pm.1.2 = 1} => term_ge1 pm.1)
    rw [h1, h2, tsum_fintype]
    exact (Finset.sum_subtype (Finset.univ.filter (fun pm : D_ge1 => pm.1.2 = 1))
