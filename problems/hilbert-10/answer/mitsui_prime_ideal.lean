        (Φ_emb w z) ^ (a_place w) ∧
      (star ((w.embedding z / (w z : ℂ)) ^ (l_eff w))) * ((w z : ℂ) ^ (a_place w)) =
        (star (Φ_emb w z)) ^ (a_place w) := by
    intro w z hz
