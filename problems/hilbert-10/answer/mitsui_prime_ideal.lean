    have hw₀_pos : 0 < w₀ (x : K) := hv_pos w₀
    have hx_sector : ∀ w : NumberField.InfinitePlace K,
        Real.log (w (x : K) / w₀ (x : K)) ∈ Set.Ioc (-Real.log X) 0 := by
      intro w
      by_cases hw : w = w₀
      · rw [hw, div_self (ne_of_gt hw₀_pos), Real.log_one]
        exact ⟨neg_neg_of_pos hlog_pos, le_rfl⟩
      · have hpw_lt : (p w : ℕ) + 1 ≤ l := (p w).isLt
        have hpw_rle : ((p w : ℕ) : ℝ) + 1 ≤ (l : ℝ) := by exact_mod_cast hpw_lt
        have hpw_nonneg : (0 : ℝ) ≤ ((p w : ℕ) : ℝ) := Nat.cast_nonneg _
        have h_left_div : -1 ≤ (((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ) := by
          rw [le_div_iff₀ hl_pos]
          linarith
        have h_left : -Real.log X ≤ Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)) := by
          calc -Real.log X = Real.log X * (-1) := by ring
            _ ≤ Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)) :=
              mul_le_mul_of_nonneg_left h_left_div (le_of_lt hlog_pos)
        have h_right_div : (((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ) ≤ 0 :=
          div_nonpos_of_nonpos_of_nonneg (by linarith) (le_of_lt hl_pos)
        have h_right : Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)) ≤ 0 :=
          mul_nonpos_of_nonneg_of_nonpos (le_of_lt hlog_pos) h_right_div
        exact Set.Ioc_subset_Ioc h_left h_right (hx_log w hw)
    have hv_le_w₀ : v (x : K) ≤ w₀ (x : K) := by
      have hlog_le : Real.log (v (x : K) / w₀ (x : K)) ≤ 0 := (hx_sector v).2
      have hexp_le : Real.exp (Real.log (v (x : K) / w₀ (x : K))) ≤ Real.exp 0 :=
        Real.exp_le_exp.mpr hlog_le
      rw [Real.exp_log (div_pos (hv_pos v) hw₀_pos), Real.exp_zero] at hexp_le
      exact (div_le_one hw₀_pos).mp hexp_le
    have hw₀_le_X'v : ∀ u : NumberField.InfinitePlace K, w₀ (x : K) ≤ X' * u (x : K) := by
      intro u
      have hlog_gt : -Real.log X < Real.log (u (x : K) / w₀ (x : K)) := (hx_sector u).1
      have hlog_X' : Real.log X' = Real.log X := Real.log_exp (Real.log X)
      have hlog_sum : 0 ≤ Real.log X' + Real.log (u (x : K) / w₀ (x : K)) := by linarith
      have h_div_u_pos : 0 < u (x : K) / w₀ (x : K) := div_pos (hv_pos u) hw₀_pos
      rw [← Real.log_mul (ne_of_gt hX'_pos) (ne_of_gt h_div_u_pos), mul_div_assoc'] at hlog_sum
      have hexp_ge : Real.exp 0 ≤ Real.exp (Real.log ((X' * u (x : K)) / w₀ (x : K))) :=
        Real.exp_le_exp.mpr hlog_sum
      rw [Real.exp_zero, Real.exp_log (div_pos (mul_pos hX'_pos (hv_pos u)) hw₀_pos)] at hexp_ge
      exact (one_le_div hw₀_pos).mp hexp_ge
    have h_pow_each : ∀ u ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)),
        w₀ (x : K) ^ u.mult ≤ X' ^ u.mult * u (x : K) ^ u.mult := by
      intro u _
      calc w₀ (x : K) ^ u.mult
        _ ≤ (X' * u (x : K)) ^ u.mult :=
          pow_le_pow_left₀ (le_of_lt hw₀_pos) (hw₀_le_X'v u) u.mult
        _ = X' ^ u.mult * u (x : K) ^ u.mult := mul_pow X' (u (x : K)) u.mult
    have h_prod_le :
        (∏ u : NumberField.InfinitePlace K, w₀ (x : K) ^ u.mult) ≤
        (∏ u : NumberField.InfinitePlace K, (X' ^ u.mult * u (x : K) ^ u.mult)) :=
      Finset.prod_le_prod (fun u _ => by positivity) h_pow_each
    have h_lhs : (∏ u : NumberField.InfinitePlace K, w₀ (x : K) ^ u.mult) = w₀ (x : K) ^ n := by
      rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq]
    have h_rhs : (∏ u : NumberField.InfinitePlace K, (X' ^ u.mult * u (x : K) ^ u.mult)) =
        X' ^ n * ((Algebra.norm ℤ x).natAbs : ℝ) := by
      rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum,
        NumberField.InfinitePlace.sum_mult_eq, h_prod_norm x]
    rw [h_lhs, h_rhs] at h_prod_le
    have h_abs : Ideal.absNorm (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))) =
        Ideal.absNorm p_id.asIdeal ^ ν := by
      rw [h_span, map_pow]
    rw [Ideal.absNorm_span_singleton] at h_abs
    have hx_norm : ((Algebra.norm ℤ x).natAbs : ℝ) ≤ Z := by
      have h_eq : ((Algebra.norm ℤ x).natAbs : ℝ) = (Ideal.absNorm p_id.asIdeal : ℝ) ^ ν := by
        exact_mod_cast h_abs
      rw [h_eq]
      exact h_pow
    have hZ_ge_one : 1 ≤ Z := by
      have hk2 : 2 ≤ Ideal.absNorm p_id.asIdeal := h_norm_ge_two p_id
      have hk1 : (1 : ℝ) ≤ (Ideal.absNorm p_id.asIdeal : ℝ) := by
        have : 1 ≤ Ideal.absNorm p_id.asIdeal := by omega
        exact_mod_cast this
      exact le_trans (one_le_pow₀ hk1) h_pow
    have hZ_le_Zn : Z ≤ Z ^ n := le_self_pow₀ hZ_ge_one (ne_of_gt hn_pos)
    have hw₀_pow_le : w₀ (x : K) ^ n ≤ (X' * Z) ^ n := by
      calc w₀ (x : K) ^ n
        _ ≤ X' ^ n * ((Algebra.norm ℤ x).natAbs : ℝ) := h_prod_le
        _ ≤ X' ^ n * Z := mul_le_mul_of_nonneg_left hx_norm (by positivity)
        _ ≤ X' ^ n * Z ^ n := mul_le_mul_of_nonneg_left hZ_le_Zn (by positivity)
        _ = (X' * Z) ^ n := (mul_pow X' Z n).symm
    have hw₀_le_XZ : w₀ (x : K) ≤ X' * Z :=
      (pow_le_pow_iff_left₀ (le_of_lt hw₀_pos) (by positivity) (ne_of_gt hn_pos)).mp hw₀_pow_le
    exact le_trans hv_le_w₀ hw₀_le_XZ
  let B_XZ : Set K := {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X' * Z}
  have hBXZ_fin : B_XZ.Finite := NumberField.Embeddings.finite_of_norm_le K ℂ (X' * Z)
  have hpre_fin : (algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_XZ).Finite :=
    hBXZ_fin.preimage NumberField.RingOfIntegers.coe_injective.injOn
  let S_elt : Set (NumberField.RingOfIntegers K) :=
    {x : NumberField.RingOfIntegers K | ∀ w : NumberField.InfinitePlace K, w (x : K) ≤ X' * Z}
  have hSelt_sub : S_elt ⊆ algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_XZ := by
    intro x hx
    refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, fun φ => ?_⟩
    let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
    have hw : w (x : K) = ‖φ (x : K)‖ := NumberField.InfinitePlace.apply φ (x : K)
    change ‖φ (x : K)‖ ≤ X' * Z
    rw [← hw]
    exact hx w
  have hSelt_fin : S_elt.Finite := hpre_fin.subset hSelt_sub
  haveI : Finite S_elt := hSelt_fin
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Z⌋₊}
  let S_id_prod : Set (Ideal (NumberField.RingOfIntegers K) × ℕ) :=
    S_id ×ˢ {ν : ℕ | ν ≤ ⌊Z⌋₊}
  let S_cell_prod : Set (NumberField.RingOfIntegers K × Ideal (NumberField.RingOfIntegers K) × ℕ) :=
    S_elt ×ˢ S_id_prod
  have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Z⌋₊
  have hSid_prod_fin : S_id_prod.Finite := hSid_fin.prod (Set.finite_le_nat ⌊Z⌋₊)
  have hScell_prod_fin : S_cell_prod.Finite := hSelt_fin.prod hSid_prod_fin
  haveI : Finite S_id_prod := hSid_prod_fin
  haveI : Finite S_cell_prod := hScell_prod_fin
  let P_dir (x : NumberField.RingOfIntegers K) : Prop :=
    ∀ i : NumberField.mixedEmbedding.index K,
      R₁ *
        ((NumberField.mixedEmbedding.stdBasis K).repr
            (NumberField.mixedEmbedding K (x : K)) i / w₀ (x : K)) ∈
        Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
          ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))
  let D_cell := {xpm : NumberField.RingOfIntegers K ×
          IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ xpm.2.2 ∧
        Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
        (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Z ∧
        (∀ i : NumberField.mixedEmbedding.index K,
          R₁ *
            ((NumberField.mixedEmbedding.stdBasis K).repr
                (NumberField.mixedEmbedding K (xpm.1 : K)) i / w₀ (xpm.1 : K)) ∈
            Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
        (∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
          Real.log (w (xpm.1 : K) / w₀ (xpm.1 : K)) ∈
            Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
              (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))) ∧
        IsUnit (Ideal.Quotient.mk q xpm.1)}
  let D_log := {xpm : NumberField.RingOfIntegers K ×
          IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ xpm.2.2 ∧
        Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
        (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Z ∧
        (∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
          Real.log (w (xpm.1 : K) / w₀ (xpm.1 : K)) ∈
            Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
              (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))) ∧
        IsUnit (Ideal.Quotient.mk q xpm.1)}
  let f_log : D_log → S_cell_prod := fun xpm =>
    ⟨(xpm.1.1, xpm.1.2.1.asIdeal, xpm.1.2.2),
      ⟨h_cell_place_le xpm.1.1 xpm.1.2.1 xpm.1.2.2 xpm.2.1 xpm.2.2.1 xpm.2.2.2.1 xpm.2.2.2.2.1,
        h_pm_bounds xpm.1.2.1 xpm.1.2.2 xpm.2.1 xpm.2.2.2.1⟩⟩
  have hf_log_inj : Function.Injective f_log := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    have h1 := congrArg Prod.fst hval
    have h23 := congrArg Prod.snd hval
    have h2 := congrArg Prod.fst h23
    have h3 := congrArg Prod.snd h23
    apply Subtype.ext
    apply Prod.ext
    · exact h1
    · apply Prod.ext
      · exact IsDedekindDomain.HeightOneSpectrum.ext h2
      · exact h3
  haveI : Finite D_log := Finite.of_injective f_log hf_log_inj
  letI : Fintype D_log := Fintype.ofFinite D_log
  have h_place (v : (NumberField.RingOfIntegers K)ˣ) (hv : v ∈ NumberField.Units.torsion K)
      (x : NumberField.RingOfIntegers K) (w : NumberField.InfinitePlace K) :
      w (((v : NumberField.RingOfIntegers K) * x : NumberField.RingOfIntegers K) : K) = w (x : K) := by
    change w ((algebraMap (NumberField.RingOfIntegers K) K) ((v : NumberField.RingOfIntegers K) * x)) =
      w ((algebraMap (NumberField.RingOfIntegers K) K) x)
    rw [map_mul, map_mul, h_tors_norm v hv w, one_mul]
  have h_mem (v : (NumberField.RingOfIntegers K)ˣ) (hv : v ∈ NumberField.Units.torsion K) (xpm : D_log) :
      1 ≤ xpm.1.2.2 ∧
      Ideal.span ({(v : NumberField.RingOfIntegers K) * xpm.1.1} : Set (NumberField.RingOfIntegers K)) =
        xpm.1.2.1.asIdeal ^ xpm.1.2.2 ∧
      (Ideal.absNorm xpm.1.2.1.asIdeal : ℝ) ^ xpm.1.2.2 ≤ Z ∧
      (∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
        Real.log (w (((v : NumberField.RingOfIntegers K) * xpm.1.1 : NumberField.RingOfIntegers K) : K) /
            w₀ (((v : NumberField.RingOfIntegers K) * xpm.1.1 : NumberField.RingOfIntegers K) : K)) ∈
          Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
            (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))) ∧
      IsUnit (Ideal.Quotient.mk q ((v : NumberField.RingOfIntegers K) * xpm.1.1)) := by
    refine ⟨xpm.2.1, ?_, xpm.2.2.2.1, ?_, ?_⟩
    · rw [Ideal.span_singleton_mul_left_unit v.isUnit xpm.1.1]
      exact xpm.2.2.1
    · intro w hw
      rw [h_place v hv xpm.1.1 w, h_place v hv xpm.1.1 w₀]
      exact xpm.2.2.2.2.1 w hw
    · rw [map_mul]
      exact IsUnit.mul (v.isUnit.map (Ideal.Quotient.mk q)) xpm.2.2.2.2.2
  let e (u : NumberField.Units.torsion K) : D_log ≃ D_log :=
    { toFun := fun xpm =>
        ⟨(((u.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * xpm.1.1, xpm.1.2),
          h_mem u.1 u.2 xpm⟩
      invFun := fun xpm =>
        ⟨(((u.1⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * xpm.1.1, xpm.1.2),
          h_mem u.1⁻¹ (Subgroup.inv_mem (NumberField.Units.torsion K) u.2) xpm⟩
      left_inv := fun xpm => Subtype.ext (Prod.ext (Units.inv_mul_cancel_left u.1 xpm.1.1) rfl)
      right_inv := fun xpm => Subtype.ext (Prod.ext (Units.mul_inv_cancel_left u.1 xpm.1.1) rfl) }
  let Φ (u : NumberField.Units.torsion K) : ℂ :=
    ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom
      (u.1 : (NumberField.RingOfIntegers K)ˣ)))
  let F (xpm : D_log) : ℂ :=
    ψ (Additive.ofMul xpm.2.2.2.2.2.unit) *
      ((Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) *
        Real.log (Z / ((Ideal.absNorm xpm.1.2.1.asIdeal : ℝ) ^ xpm.1.2.2)) : ℝ) : ℂ)
  have hF_eq (u : NumberField.Units.torsion K) (xpm : D_log) :
      F (e u xpm) = Φ u * F xpm := by
    dsimp [F, Φ]
    have h_unit : (e u xpm).2.2.2.2.2.unit =
        Units.map (Ideal.Quotient.mk q).toMonoidHom (u.1 : (NumberField.RingOfIntegers K)ˣ) *
          xpm.2.2.2.2.2.unit := by
      apply Units.ext
      change ((e u xpm).2.2.2.2.2.unit : NumberField.RingOfIntegers K ⧸ q) =
        ((Units.map (Ideal.Quotient.mk q).toMonoidHom (u.1 : (NumberField.RingOfIntegers K)ˣ) :
            (NumberField.RingOfIntegers K ⧸ q)ˣ) : NumberField.RingOfIntegers K ⧸ q) *
          (xpm.2.2.2.2.2.unit : NumberField.RingOfIntegers K ⧸ q)
      rw [IsUnit.unit_spec, IsUnit.unit_spec]
      exact map_mul (Ideal.Quotient.mk q) ((u.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) xpm.1.1
    rw [h_unit, ofMul_mul, AddChar.map_add_eq_mul, mul_assoc]
    rfl
  let Q_dir (xpm : D_log) (u : NumberField.Units.torsion K) : Prop :=
    ∀ i : NumberField.mixedEmbedding.index K,
      R₁ *
        ((NumberField.mixedEmbedding.stdBasis K).repr
            (NumberField.mixedEmbedding K ((((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * xpm.1.1 : NumberField.RingOfIntegers K) : K)) i /
          w₀ (xpm.1.1 : K)) ∈
        Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
          ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))
  have hPQ (u : NumberField.Units.torsion K) (xpm : D_log) :
      P_dir (e u xpm).1.1 ↔ Q_dir xpm u := by
    dsimp [P_dir, Q_dir, e]
    simp_rw [h_place u.1 u.2 xpm.1.1 w₀]
  let e_sub : D_cell ≃ {xpm : D_log // P_dir xpm.1.1} :=
    { toFun := fun xpm =>
        ⟨⟨xpm.1, ⟨xpm.2.1, xpm.2.2.1, xpm.2.2.2.1, xpm.2.2.2.2.2.1, xpm.2.2.2.2.2.2⟩⟩,
          xpm.2.2.2.2.1⟩
      invFun := fun xpm =>
        ⟨xpm.1.1, ⟨xpm.1.2.1, xpm.1.2.2.1, xpm.1.2.2.2.1, xpm.2,
          xpm.1.2.2.2.2.1, xpm.1.2.2.2.2.2⟩⟩
      left_inv := fun _ => Subtype.ext rfl
      right_inv := fun _ => Subtype.ext (Subtype.ext rfl) }
  let F_cell (xpm : D_cell) : ℂ :=
    ψ (Additive.ofMul xpm.2.2.2.2.2.2.unit) *
      ((Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) *
        Real.log (Z / ((Ideal.absNorm xpm.1.2.1.asIdeal : ℝ) ^ xpm.1.2.2)) : ℝ) : ℂ)
  set S_cell : ℂ := ∑' xpm : D_cell, F_cell xpm
  have hS_cell_sum : S_cell = ∑ xpm : D_log, (if P_dir xpm.1.1 then F xpm else 0) := by
    have h1 : S_cell = ∑' xpm : {xpm : D_log // P_dir xpm.1.1}, F xpm.1 := by
      dsimp [S_cell]
      exact Equiv.tsum_eq e_sub (fun xpm : {xpm : D_log // P_dir xpm.1.1} => F xpm.1)
    rw [h1, tsum_fintype]
    symm
    rw [← Finset.sum_filter]
    exact Finset.sum_subtype (Finset.univ.filter (fun xpm : D_log => P_dir xpm.1.1))
      (fun _ => by simp) F
  have hS_cell_u (u : NumberField.Units.torsion K) :
      S_cell = ∑ xpm : D_log, (if Q_dir xpm u then Φ u else 0) * F xpm := by
    rw [hS_cell_sum, ← Equiv.sum_comp (e u)]
    refine Finset.sum_congr rfl (fun xpm _ => ?_)
    rw [if_congr (hPQ u xpm) rfl rfl, hF_eq u xpm]
    split_ifs <;> ring
  have hW_tors (xpm : D_log) :
      (∑' u : {u : NumberField.Units.torsion K // Q_dir xpm u}, Φ u.1) =
      ∑ u : NumberField.Units.torsion K, (if Q_dir xpm u then Φ u else 0) := by
    rw [tsum_fintype]
    symm
    rw [← Finset.sum_filter]
    exact Finset.sum_subtype (Finset.univ.filter (fun u : NumberField.Units.torsion K => Q_dir xpm u))
      (fun _ => by simp) Φ
  have h_tors_const :
      (NumberField.Units.torsionOrder K : ℂ) * S_cell =
      ∑ _u : NumberField.Units.torsion K, S_cell := by
    rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    rfl
  change (NumberField.Units.torsionOrder K : ℂ) * S_cell =
    ∑' xpm : D_log, (∑' u : {u : NumberField.Units.torsion K // Q_dir xpm u}, Φ u.1) * F xpm
  rw [h_tors_const, tsum_fintype]
  calc ∑ u : NumberField.Units.torsion K, S_cell
    _ = ∑ u : NumberField.Units.torsion K, ∑ xpm : D_log, (if Q_dir xpm u then Φ u else 0) * F xpm :=
        Finset.sum_congr rfl (fun u _ => hS_cell_u u)
    _ = ∑ xpm : D_log, ∑ u : NumberField.Units.torsion K, (if Q_dir xpm u then Φ u else 0) * F xpm :=
        Finset.sum_comm
    _ = ∑ xpm : D_log, (∑ u : NumberField.Units.torsion K, (if Q_dir xpm u then Φ u else 0)) * F xpm := by
        refine Finset.sum_congr rfl (fun xpm _ => ?_)
        rw [← Finset.sum_mul]
    _ = ∑ xpm : D_log, (∑' u : {u : NumberField.Units.torsion K // Q_dir xpm u}, Φ u.1) * F xpm := by
        refine Finset.sum_congr rfl (fun xpm _ => ?_)
        rw [hW_tors xpm]

theorem mitsui_exists_torsion_char_eq_embedding_pow {K : Type u} [Field K] [NumberField K]
    (w₀ : NumberField.InfinitePlace K)
    (q : Ideal (NumberField.RingOfIntegers K))
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ)
    (hψ_tors_sum : (∑' u : NumberField.Units.torsion K,
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom
        (u : (NumberField.RingOfIntegers K)ˣ)))) = 0) :
    ∃ a₀ : ℕ, 1 ≤ a₀ ∧ a₀ < NumberField.Units.torsionOrder K ∧
      ∀ u ∈ NumberField.Units.torsion K,
        ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) =
          (w₀.embedding ((u : NumberField.RingOfIntegers K) : K)) ^ a₀ :=
by
  let ι_C : NumberField.Units.torsion K →* ℂ :=
    { toFun := fun v => w₀.embedding (((v : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)
      map_one' := by
        change w₀.embedding ((algebraMap (NumberField.RingOfIntegers K) K)
          (((1 : NumberField.Units.torsion K) : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K)) = 1
        rw [Subgroup.coe_one, Units.val_one, map_one, map_one]
      map_mul' := fun x y => by
        change w₀.embedding ((algebraMap (NumberField.RingOfIntegers K) K)
          (((x * y : NumberField.Units.torsion K) : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K)) = _
        rw [Subgroup.coe_mul, Units.val_mul, map_mul, map_mul] }
  have hι_inj : Function.Injective ι_C := by
    intro x y hxy
    apply Subtype.ext
    apply Units.ext
    apply NumberField.RingOfIntegers.coe_injective
    exact w₀.embedding.injective hxy
  let Φ : NumberField.Units.torsion K →* ℂ :=
    { toFun := fun v => ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom
        (v : (NumberField.RingOfIntegers K)ˣ)))
      map_one' := by
        rw [Subgroup.coe_one, map_one, ofMul_one, AddChar.map_zero_eq_one]
      map_mul' := fun x y => by
        rw [Subgroup.coe_mul, map_mul, ofMul_mul, AddChar.map_add_eq_mul] }
  obtain ⟨g₀, hg₀_gen⟩ := IsCyclic.exists_monoid_generator (α := NumberField.Units.torsion K)
  have hg₀_ord : orderOf g₀ = NumberField.Units.torsionOrder K := by
    rw [orderOf_eq_card_of_forall_mem_powers hg₀_gen, Nat.card_eq_fintype_card]
    rfl
  have hζ₀_prim : IsPrimitiveRoot (ι_C g₀) (NumberField.Units.torsionOrder K) := by
    rw [IsPrimitiveRoot.iff_orderOf, orderOf_injective ι_C hι_inj g₀, hg₀_ord]
  have hΦ_pow : (Φ g₀) ^ (NumberField.Units.torsionOrder K) = 1 := by
    rw [← map_pow Φ g₀, ← hg₀_ord, pow_orderOf_eq_one, map_one]
  obtain ⟨a₀, ha₀_lt, ha₀_eq⟩ := IsPrimitiveRoot.eq_pow_of_pow_eq_one hζ₀_prim hΦ_pow
  have hΦ_eq_pow : ∀ v : NumberField.Units.torsion K, Φ v = (ι_C v) ^ a₀ := by
    intro v
    obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff v g₀).mp (hg₀_gen v)
    rw [← hn, map_pow, ← ha₀_eq, ← pow_mul, mul_comm a₀ n, pow_mul, ← map_pow]
  have ha₀_forall : ∀ u ∈ NumberField.Units.torsion K,
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) =
        (w₀.embedding ((u : NumberField.RingOfIntegers K) : K)) ^ a₀ :=
    fun u hu => hΦ_eq_pow ⟨u, hu⟩
  have ha₀_ge : 1 ≤ a₀ := by
    by_contra h_not_ge
    have ha₀_zero : a₀ = 0 := by omega
    have hΦ_one : ∀ v : NumberField.Units.torsion K, Φ v = 1 := by
      intro v
      rw [hΦ_eq_pow v, ha₀_zero, pow_zero]
    have h_sum_eq : (∑' v : NumberField.Units.torsion K, Φ v) =
        (NumberField.Units.torsionOrder K : ℂ) := by
      calc (∑' v : NumberField.Units.torsion K, Φ v)
        _ = ∑' _v : NumberField.Units.torsion K, (1 : ℂ) := tsum_congr hΦ_one
        _ = Nat.card (NumberField.Units.torsion K) • (1 : ℂ) := tsum_const (1 : ℂ)
        _ = (NumberField.Units.torsionOrder K : ℂ) := by
          rw [nsmul_eq_mul, mul_one, Nat.card_eq_fintype_card]
          rfl
    have h_ne_zero : (NumberField.Units.torsionOrder K : ℂ) ≠ 0 :=
      Nat.cast_ne_zero.mpr (NumberField.Units.torsionOrder_ne_zero K)
    exact h_ne_zero (h_sum_eq.symm.trans hψ_tors_sum)
  exact ⟨a₀, ha₀_ge, ha₀_lt, ha₀_forall⟩

theorem mitsui_exists_log_freq_extending_torsion_char_to_units {K : Type u} [Field K] [NumberField K]
    (w₀ : NumberField.InfinitePlace K)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ)
    (a₀ : ℕ)
    (ha₀ : ∀ u ∈ NumberField.Units.torsion K,
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) =
        (w₀.embedding ((u : NumberField.RingOfIntegers K) : K)) ^ a₀)
    (h_tors_norm : ∀ u ∈ NumberField.Units.torsion K, ∀ w : NumberField.InfinitePlace K,
      w ((u : NumberField.RingOfIntegers K) : K) = 1) :
    ∃ β : NumberField.InfinitePlace K → ℝ,
      ∀ u : (NumberField.RingOfIntegers K)ˣ,
        ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) =
          (w₀.embedding ((u : NumberField.RingOfIntegers K) : K) /
              (w₀ ((u : NumberField.RingOfIntegers K) : K) : ℂ)) ^ a₀ *
            Complex.exp
              (((∑ w : NumberField.InfinitePlace K,
                  β w * Real.log (w ((u : NumberField.RingOfIntegers K) : K) /
                    w₀ ((u : NumberField.RingOfIntegers K) : K))) : ℝ) * Complex.I) :=
by
  classical
  let n : ℕ := Module.finrank ℚ K
  let r : ℕ := NumberField.Units.rank K
  have h_s2 : ∃ α : Fin r → ℝ,
      ∀ j : Fin r,
        ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom (NumberField.Units.fundSystem K j))) =
          (w₀.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
              (w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) : ℂ)) ^ a₀ *
            Complex.exp ((α j : ℂ) * Complex.I) := by
    have hq_bot : q ≠ ⊥ := hq
    haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
      Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
    let Φ : Fin r → ℂ := fun j =>
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom (NumberField.Units.fundSystem K j)))
    let σ : Fin r → ℂ := fun j =>
      (w₀.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
          (w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) : ℂ)) ^ a₀
    let α : Fin r → ℝ := fun j => Complex.arg (Φ j / σ j)
    refine ⟨α, fun j => ?_⟩
    let η_j : (NumberField.RingOfIntegers K)ˣ := NumberField.Units.fundSystem K j
    have hη_ne : ((η_j : NumberField.RingOfIntegers K) : K) ≠ 0 :=
      NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero η_j)
    have hw₀_pos : 0 < w₀ ((η_j : NumberField.RingOfIntegers K) : K) :=
      w₀.pos_iff.mpr hη_ne
    have h_norm_Φ : ‖Φ j‖ = 1 := AddChar.norm_apply _ _
    have h_norm_σ : ‖σ j‖ = 1 := by
      dsimp [σ, η_j]
      rw [norm_pow, norm_div, NumberField.InfinitePlace.norm_embedding_eq,
        Complex.norm_real, Real.norm_eq_abs, abs_of_pos hw₀_pos,
        div_self (ne_of_gt hw₀_pos), one_pow]
    have hσ_ne : σ j ≠ 0 := by
      intro h0
      rw [h0, norm_zero] at h_norm_σ
      exact zero_ne_one h_norm_σ
    have h_norm_z : ‖Φ j / σ j‖ = 1 := by
      rw [norm_div, h_norm_Φ, h_norm_σ, div_one]
    have h_exp : Complex.exp ((α j : ℂ) * Complex.I) = Φ j / σ j := by
      have h1 := Complex.norm_mul_exp_arg_mul_I (Φ j / σ j)
      rw [h_norm_z, Complex.ofReal_one, one_mul] at h1
      exact h1
    change Φ j = σ j * Complex.exp ((α j : ℂ) * Complex.I)
    rw [h_exp, mul_div_cancel₀ _ hσ_ne]
  obtain ⟨α, hα⟩ := h_s2
  have h_s1 : ∃ β : NumberField.InfinitePlace K → ℝ,
      ∀ j : Fin r,
        (∑ w : NumberField.InfinitePlace K,
          β w * Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
            w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) = α j := by
    let B_R : Module.Basis (Fin r) ℝ (NumberField.Units.dirichletUnitTheorem.logSpace K) :=
      Module.Basis.ofZLatticeBasis ℝ
        (NumberField.Units.unitLattice K)
        (NumberField.Units.basisUnitLattice K)
    let T_log : (NumberField.InfinitePlace K → ℝ) → NumberField.Units.dirichletUnitTheorem.logSpace K :=
      fun y w => (w.1.mult : ℝ) *
        (y w.1 - (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * y v) / (n : ℝ))
    have hT_add : ∀ y₁ y₂ : NumberField.InfinitePlace K → ℝ,
        T_log (y₁ + y₂) = T_log y₁ + T_log y₂ := by
      intro y₁ y₂
      ext w
      change (w.1.mult : ℝ) *
          ((y₁ + y₂) w.1 - (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * (y₁ + y₂) v) / (n : ℝ)) =
        T_log y₁ w + T_log y₂ w
      dsimp [T_log]
      simp only [mul_add, Finset.sum_add_distrib]
      ring
    have hT_smul : ∀ (c : ℝ) (y : NumberField.InfinitePlace K → ℝ),
        T_log (c • y) = c • T_log y := by
      intro c y
      ext w
      change (w.1.mult : ℝ) *
          (c * y w.1 - (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * (c * y v)) / (n : ℝ)) =
        c * T_log y w
      dsimp [T_log]
      have h_sum_smul : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * (c * y v)) =
          c * ∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * y v := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun v _ => by ring)
      rw [h_sum_smul]
      ring
    let F_lin : (NumberField.InfinitePlace K → ℝ) →ₗ[ℝ] ℝ :=
      { toFun := fun y => ∑ i : Fin r, (B_R.repr (T_log y) i) * α i
        map_add' := fun y₁ y₂ => by
          rw [hT_add, map_add]
          simp only [Finsupp.add_apply, add_mul, Finset.sum_add_distrib]
        map_smul' := fun c y => by
          rw [hT_smul, map_smul]
          simp only [Finsupp.smul_apply, smul_eq_mul, mul_assoc, ← Finset.mul_sum, RingHom.id_apply] }
    let β : NumberField.InfinitePlace K → ℝ :=
      fun w => F_lin (fun v => if w = v then 1 else 0)
    have hF_eq : ∀ y : NumberField.InfinitePlace K → ℝ,
        (∑ w : NumberField.InfinitePlace K, β w * y w) = F_lin y := by
      intro y
      conv_rhs => rw [pi_eq_sum_univ y]
      rw [map_sum]
      refine Finset.sum_congr rfl (fun w _ => ?_)
      rw [map_smul, smul_eq_mul, mul_comm]
    refine ⟨β, fun j => ?_⟩
    let η_j : (NumberField.RingOfIntegers K)ˣ := NumberField.Units.fundSystem K j
    let y_j : NumberField.InfinitePlace K → ℝ :=
      fun w => Real.log (w ((η_j : NumberField.RingOfIntegers K) : K) /
        w₀ ((η_j : NumberField.RingOfIntegers K) : K))
    rw [hF_eq y_j]
    have hη_ne : ((η_j : NumberField.RingOfIntegers K) : K) ≠ 0 :=
      NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero η_j)
    have hw₀_ne : w₀ ((η_j : NumberField.RingOfIntegers K) : K) ≠ 0 :=
      ne_of_gt (w₀.pos_iff.mpr hη_ne)
    have hy_j : ∀ v : NumberField.InfinitePlace K,
        y_j v = Real.log (v ((η_j : NumberField.RingOfIntegers K) : K)) -
          Real.log (w₀ ((η_j : NumberField.RingOfIntegers K) : K)) := by
      intro v
      dsimp [y_j]
      exact Real.log_div (ne_of_gt (v.pos_iff.mpr hη_ne)) hw₀_ne
    have hn_pos : (0 : ℝ) < (n : ℝ) := by
      dsimp [n]
      exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
    have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
    have h_sum_mult : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ)) = (n : ℝ) := by
      dsimp [n]
      exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
    have h_unit_sum : (∑ v : NumberField.InfinitePlace K,
        (v.mult : ℝ) * Real.log (v ((η_j : NumberField.RingOfIntegers K) : K))) = 0 := by
      simpa using NumberField.Units.sum_mult_mul_log η_j
    have h_sum_yj : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * y_j v) =
        -(n : ℝ) * Real.log (w₀ ((η_j : NumberField.RingOfIntegers K) : K)) := by
      have h1 : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * y_j v) =
          (∑ v : NumberField.InfinitePlace K,
            (v.mult : ℝ) * Real.log (v ((η_j : NumberField.RingOfIntegers K) : K))) -
          (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ)) *
            Real.log (w₀ ((η_j : NumberField.RingOfIntegers K) : K)) := by
        rw [Finset.sum_mul, ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun v _ => ?_)
        rw [hy_j v, mul_sub]
      rw [h1, h_unit_sum, h_sum_mult]
      ring
    have hT_yj : T_log y_j = B_R j := by
      ext w
      dsimp [T_log, B_R]
      rw [Module.Basis.ofZLatticeBasis_apply, ← NumberField.Units.logEmbedding_fundSystem,
        NumberField.Units.dirichletUnitTheorem.logEmbedding_component]
      rw [hy_j w.1, h_sum_yj]
      have h_alg : (algebraMap (NumberField.RingOfIntegers K) K) (η_j : NumberField.RingOfIntegers K) =
          ((η_j : NumberField.RingOfIntegers K) : K) := rfl
      rw [h_alg]
      have h_div : -(n : ℝ) * Real.log (w₀ ((η_j : NumberField.RingOfIntegers K) : K)) / (n : ℝ) =
          -Real.log (w₀ ((η_j : NumberField.RingOfIntegers K) : K)) := by
        field_simp [hn_ne]
      rw [h_div]
      ring
    change (∑ i : Fin r, (B_R.repr (T_log y_j) i) * α i) = α j
    rw [hT_yj, Module.Basis.repr_self]
    simp [Finsupp.single_apply]
  obtain ⟨β, hβ⟩ := h_s1
  refine ⟨β, ?_⟩
  let Φ_lhs : (NumberField.RingOfIntegers K)ˣ →* ℂ :=
    { toFun := fun u => ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u))
      map_one' := by rw [map_one, ofMul_one, AddChar.map_zero_eq_one]
      map_mul' := fun u v => by rw [map_mul, ofMul_mul, AddChar.map_add_eq_mul] }
  let Φ_rhs : (NumberField.RingOfIntegers K)ˣ →* ℂ :=
    { toFun := fun u =>
        (w₀.embedding ((u : NumberField.RingOfIntegers K) : K) /
            (w₀ ((u : NumberField.RingOfIntegers K) : K) : ℂ)) ^ a₀ *
          Complex.exp
            (((∑ w : NumberField.InfinitePlace K,
                β w * Real.log (w ((u : NumberField.RingOfIntegers K) : K) /
                  w₀ ((u : NumberField.RingOfIntegers K) : K))) : ℝ) * Complex.I)
      map_one' := by
        have h1 : (((1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) = 1 := rfl
        have h_sum : (∑ w : NumberField.InfinitePlace K,
            β w * Real.log (w (1 : K) / w₀ (1 : K))) = 0 := by
          refine Finset.sum_eq_zero (fun w _ => ?_)
          rw [map_one, map_one, div_one, Real.log_one, mul_zero]
        rw [h1, h_sum, map_one, map_one, Complex.ofReal_one, div_one, one_pow,
          Complex.ofReal_zero, zero_mul, Complex.exp_zero, mul_one]
      map_mul' := fun u v => by
        have huK_ne : ((u : NumberField.RingOfIntegers K) : K) ≠ 0 :=
          NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero u)
        have hvK_ne : ((v : NumberField.RingOfIntegers K) : K) ≠ 0 :=
          NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero v)
        have hw₀u_pos : 0 < w₀ ((u : NumberField.RingOfIntegers K) : K) := w₀.pos_iff.mpr huK_ne
        have hw₀v_pos : 0 < w₀ ((v : NumberField.RingOfIntegers K) : K) := w₀.pos_iff.mpr hvK_ne
        have h_log_sum :
            (∑ w : NumberField.InfinitePlace K,
              β w * Real.log (w ((((u * v : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) /
                w₀ ((((u * v : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)))) =
            (∑ w : NumberField.InfinitePlace K,
              β w * Real.log (w ((u : NumberField.RingOfIntegers K) : K) /
                w₀ ((u : NumberField.RingOfIntegers K) : K))) +
            (∑ w : NumberField.InfinitePlace K,
              β w * Real.log (w ((v : NumberField.RingOfIntegers K) : K) /
                w₀ ((v : NumberField.RingOfIntegers K) : K))) := by
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl (fun w _ => ?_)
          have hwu_pos : 0 < w ((u : NumberField.RingOfIntegers K) : K) := w.pos_iff.mpr huK_ne
          have hwv_pos : 0 < w ((v : NumberField.RingOfIntegers K) : K) := w.pos_iff.mpr hvK_ne
          have h_div_u_ne : w ((u : NumberField.RingOfIntegers K) : K) /
              w₀ ((u : NumberField.RingOfIntegers K) : K) ≠ 0 :=
            ne_of_gt (div_pos hwu_pos hw₀u_pos)
          have h_div_v_ne : w ((v : NumberField.RingOfIntegers K) : K) /
              w₀ ((v : NumberField.RingOfIntegers K) : K) ≠ 0 :=
            ne_of_gt (div_pos hwv_pos hw₀v_pos)
          push_cast
          rw [map_mul, map_mul, mul_div_mul_comm, Real.log_mul h_div_u_ne h_div_v_ne, mul_add]
        have h_pow :
            (w₀.embedding ((((u * v : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) /
              (w₀ ((((u * v : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) : ℂ)) ^ a₀ =
            (w₀.embedding ((u : NumberField.RingOfIntegers K) : K) /
              (w₀ ((u : NumberField.RingOfIntegers K) : K) : ℂ)) ^ a₀ *
            (w₀.embedding ((v : NumberField.RingOfIntegers K) : K) /
              (w₀ ((v : NumberField.RingOfIntegers K) : K) : ℂ)) ^ a₀ := by
          push_cast
          rw [map_mul, map_mul, Complex.ofReal_mul, mul_div_mul_comm, mul_pow]
        rw [h_pow, h_log_sum]
        push_cast
        rw [add_mul, Complex.exp_add]
        ring }
  have h_inv : ∀ x : (NumberField.RingOfIntegers K)ˣ,
      Φ_lhs x = Φ_rhs x → Φ_lhs x⁻¹ = Φ_rhs x⁻¹ := by
    intro x hx
    have h1 : Φ_lhs x⁻¹ * Φ_lhs x = 1 := by
      rw [← map_mul, inv_mul_cancel, map_one]
    have h2 : Φ_lhs x * Φ_rhs x⁻¹ = 1 := by
      rw [hx, ← map_mul, mul_inv_cancel, map_one]
    exact left_inv_eq_right_inv h1 h2
  have h_zpow : ∀ (g : (NumberField.RingOfIntegers K)ˣ) (k : ℤ),
      Φ_lhs g = Φ_rhs g → Φ_lhs (g ^ k) = Φ_rhs (g ^ k) := by
    intro g k hg
    cases k with
    | ofNat m =>
      rw [Int.ofNat_eq_natCast, zpow_natCast, map_pow, map_pow, hg]
    | negSucc m =>
      rw [zpow_negSucc]
      apply h_inv
      rw [map_pow, map_pow, hg]
  have h_tors : ∀ ζ : NumberField.Units.torsion K,
      Φ_lhs (ζ : (NumberField.RingOfIntegers K)ˣ) = Φ_rhs (ζ : (NumberField.RingOfIntegers K)ˣ) := by
    intro ζ
    change ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom (ζ : (NumberField.RingOfIntegers K)ˣ))) =
      (w₀.embedding (((ζ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
          (w₀ (((ζ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) : ℂ)) ^ a₀ *
        Complex.exp
          (((∑ w : NumberField.InfinitePlace K,
              β w * Real.log (w (((ζ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                w₀ (((ζ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) : ℝ) * Complex.I)
    rw [ha₀ (ζ : (NumberField.RingOfIntegers K)ˣ) ζ.2]
    have hw₀_one : w₀ (((ζ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) = 1 :=
      h_tors_norm (ζ : (NumberField.RingOfIntegers K)ˣ) ζ.2 w₀
    have h_sum_zero : (∑ w : NumberField.InfinitePlace K,
        β w * Real.log (w (((ζ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
          w₀ (((ζ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) = 0 := by
      refine Finset.sum_eq_zero (fun w _ => ?_)
      rw [h_tors_norm (ζ : (NumberField.RingOfIntegers K)ˣ) ζ.2 w, hw₀_one, div_one, Real.log_one, mul_zero]
    rw [h_sum_zero, hw₀_one, Complex.ofReal_one, div_one, Complex.ofReal_zero, zero_mul, Complex.exp_zero, mul_one]
  have h_fund : ∀ j : Fin r,
      Φ_lhs (NumberField.Units.fundSystem K j) = Φ_rhs (NumberField.Units.fundSystem K j) := by
    intro j
    change ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom (NumberField.Units.fundSystem K j))) =
      (w₀.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
          (w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) : ℂ)) ^ a₀ *
        Complex.exp
          (((∑ w : NumberField.InfinitePlace K,
              β w * Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) : ℝ) * Complex.I)
    rw [hα j, hβ j]
  intro u
  let ζ : NumberField.Units.torsion K :=
    (NumberField.Units.exist_unique_eq_mul_prod K u).exists.choose.1
  let e : Fin r → ℤ :=
    (NumberField.Units.exist_unique_eq_mul_prod K u).exists.choose.2
  have hu_eq : u = (ζ : (NumberField.RingOfIntegers K)ˣ) *
      ∏ j : Fin r, (NumberField.Units.fundSystem K j) ^ (e j) :=
    (NumberField.Units.exist_unique_eq_mul_prod K u).exists.choose_spec
  change Φ_lhs u = Φ_rhs u
  rw [hu_eq, map_mul, map_mul, h_tors ζ, map_prod, map_prod]
  congr 1
  refine Finset.prod_congr rfl (fun j _ => ?_)
  exact h_zpow (NumberField.Units.fundSystem K j) (e j) (h_fund j)

theorem mitsui_exists_ideal_monoidHom_extending_unit_compensated_char {K : Type u} [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ)
    (ϕ_arch : NumberField.RingOfIntegers K → ℂ)
    (hϕ_mul : ∀ x y : NumberField.RingOfIntegers K, x ≠ 0 → y ≠ 0 →
      ϕ_arch (x * y) = ϕ_arch x * ϕ_arch y)
    (hϕ_norm : ∀ x : NumberField.RingOfIntegers K, x ≠ 0 → ‖ϕ_arch x‖ = 1)
    (hϕ_units : ∀ u : (NumberField.RingOfIntegers K)ˣ,
