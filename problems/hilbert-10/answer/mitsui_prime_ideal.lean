      have hγK_ne : (γ : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hγ_ne_C
      have hγ₀K_ne : (γ₀ : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hγ₀_ne
      have hc₁K_eq : (γ₀ : K) * (c₂ : K) = (γ : K) * (c₁ : K) := by exact_mod_cast hc₁_eq
      rw [div_eq_div_iff hγK_ne hγ₀K_ne]
      push_cast
      linear_combination (α a : K) * (x_star.1 : K) * hc₁K_eq
    have h3 : e_K (((c₁ * α a : R) : K) * (x_star.1 : K) / (γ₀ : K)) =
        e_K ((β (u₁ * a) : K) * (x_star.1 : K) / (γ₀ : K)) := by
      have h3a : ((c₁ * α a : R) : K) * (x_star.1 : K) = (((c₁ * α a) * x_star.1 : R) : K) := by
        push_cast; rfl
      have h3b : (β (u₁ * a) : K) * (x_star.1 : K) = ((β (u₁ * a) * x_star.1 : R) : K) := by
        push_cast; rfl
      rw [h3a, h3b]
      refine he_B₀_congr ((c₁ * α a) * x_star.1) (β (u₁ * a) * x_star.1) ?_ ?_
      · rw [← sub_mul]
        refine Ideal.mul_mem_right _ (B₀ : Ideal R) (sub_mem ?_ (hβ (u₁ * a)).1)
        exact Ideal.mul_mem_right _ (B₀ : Ideal R) hc₁_B₀
      · rw [map_mul, map_mul, map_mul, hα_mk_C a, (hβ (u₁ * a)).2]
    rw [h1, h2, h3]
  have hc₁_cop : Ideal.span ({c₁} : Set R) ⊔ f = ⊤ := by
    rw [← hc₁_span]
    exact h_cop_mul _ _ hB₀_cop hM₀_cop
  have hc₂_cop : Ideal.span ({c₂} : Set R) ⊔ f = ⊤ := by
    rw [← hc₂_span']
    exact h_cop_mul _ _ (h_cop_mul _ _ hJC_cop hJstar_cop) hM₀_cop
  have hu₁ : IsUnit u₁ := (h_unit_iff_sup c₁).mpr hc₁_cop
  have hu₂ : IsUnit u₂ := (h_unit_iff_sup c₂).mpr hc₂_cop
  let u₁_unit : (R ⧸ f)ˣ := hu₁.unit
  have hu₁_eq : (u₁_unit : R ⧸ f) = u₁ := hu₁.unit_spec
  let equiv₁ : (R ⧸ f) ≃ (R ⧸ f) :=
    { toFun := fun a => u₁ * a
      invFun := fun a => ↑(u₁_unit⁻¹) * a
      left_inv := fun a => by dsimp; rw [← mul_assoc, ← hu₁_eq, Units.inv_mul, one_mul]
      right_inv := fun a => by dsimp; rw [← mul_assoc, ← hu₁_eq, Units.mul_inv, one_mul] }
  let u₂_unit : (R ⧸ f)ˣ := hu₂.unit
  have hu₂_eq : (u₂_unit : R ⧸ f) = u₂ := hu₂.unit_spec
  let equiv₂ : (R ⧸ f) ≃ (R ⧸ f) :=
    { toFun := fun a => u₂ * a
      invFun := fun a => ↑(u₂_unit⁻¹) * a
      left_inv := fun a => by dsimp; rw [← mul_assoc, ← hu₂_eq, Units.inv_mul, one_mul]
      right_inv := fun a => by dsimp; rw [← mul_assoc, ← hu₂_eq, Units.mul_inv, one_mul] }
  let G_C : ℂ := ∑ a : R ⧸ f, ψ_f a * e_K ((α a : K) * (x_star.1 : K) / (γ : K))
  have h_GC_reindex : G_C = ψ_f u₂ * ∑ a : R ⧸ f,
      ψ_f a * e_K ((β (u₁ * a) : K) * (x_star.1 : K) / (γ₀ : K)) := by
    have h_eq1 : (∑ a : R ⧸ f, ψ_f (u₂ * a) * e_K ((α (u₂ * a) : K) * (x_star.1 : K) / (γ : K))) = G_C :=
      Fintype.sum_equiv equiv₂
        (fun a => ψ_f (u₂ * a) * e_K ((α (u₂ * a) : K) * (x_star.1 : K) / (γ : K)))
        (fun a => ψ_f a * e_K ((α a : K) * (x_star.1 : K) / (γ : K)))
        (fun _ => rfl)
    rw [← h_eq1, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [hψ_mul u₂ a, he_align a, mul_assoc]
  have h_G0_reindex : G₀ x_star.1 = ψ_f u₁ * ∑ a : R ⧸ f,
      ψ_f a * e_K ((β (u₁ * a) : K) * (x_star.1 : K) / (γ₀ : K)) := by
    have h_eq1 : (∑ a : R ⧸ f, ψ_f (u₁ * a) * e_K ((β (u₁ * a) : K) * (x_star.1 : K) / (γ₀ : K))) = G₀ x_star.1 :=
      Fintype.sum_equiv equiv₁
        (fun a => ψ_f (u₁ * a) * e_K ((β (u₁ * a) : K) * (x_star.1 : K) / (γ₀ : K)))
        (fun a => ψ_f a * e_K ((β a : K) * (x_star.1 : K) / (γ₀ : K)))
        (fun _ => rfl)
    rw [← h_eq1, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [hψ_mul u₁ a, mul_assoc]
  have h_u1_GC : ψ_f u₁ * G_C = ψ_f u₂ * G₀ x_star.1 := by
    rw [h_GC_reindex, h_G0_reindex]
    ring
  have h_span_c₁ : ψ₀ B₀ * ψ₀ M₀ = ψ_f u₁ * S c₁ := by
    rw [← map_mul]
    have h_sub : B₀ * M₀ = ⟨Ideal.span ({c₁} : Set R),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hc₁_ne)⟩ :=
      Subtype.ext hc₁_span
    rw [h_sub]
    exact hψ_span c₁ hc₁_ne
  have h_span_c₂ : ψ₀ J_C * ψ₀ J_star * ψ₀ M₀ = ψ_f u₂ * S c₂ := by
    rw [← map_mul, ← map_mul]
    have h_sub : J_C * J_star * M₀ = ⟨Ideal.span ({c₂} : Set R),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hc₂_ne)⟩ :=
      Subtype.ext hc₂_span'
    rw [h_sub]
    exact hψ_span c₂ hc₂_ne
  have h_S_cross : S γ₀ * S c₂ = S γ * S c₁ := by
    rw [← hS_mul, ← hS_mul, hc₁_eq]
  have h_S_c₁_sq : S c₁ * S c₁ = 1 := hS_mul_self c₁ hc₁_ne
  have h_S_c₂_sq : S c₂ * S c₂ = 1 := hS_mul_self c₂ hc₂_ne
  have h_B₀_conj : star (ψ₀ B₀) * ψ₀ B₀ = 1 :=
    h_star_mul_eq_one (ψ₀ B₀) ((hψ₀_norm_supp B₀).1 hB₀_cop)
  have h_M₀_conj : star (ψ₀ M₀) * ψ₀ M₀ = 1 :=
    h_star_mul_eq_one (ψ₀ M₀) ((hψ₀_norm_supp M₀).1 hM₀_cop)
  have h_JC_conj : star (ψ₀ J_C) * ψ₀ J_C = 1 :=
    h_star_mul_eq_one (ψ₀ J_C) ((hψ₀_norm_supp J_C).1 hJC_cop)
  have h_s3 : star (ψ₀ J_C) * (S γ * G_C) =
      S γ₀ * star (ψ₀ B₀) * ψ₀ J_star * G₀ x_star.1 := by
    have h_u1_eq : ψ_f u₁ = ψ₀ B₀ * ψ₀ M₀ * S c₁ := by
      calc ψ_f u₁ = (ψ_f u₁ * S c₁) * S c₁ := by linear_combination -ψ_f u₁ * h_S_c₁_sq
        _ = ψ₀ B₀ * ψ₀ M₀ * S c₁ := by rw [← h_span_c₁]
    have h_u2_eq : ψ_f u₂ = ψ₀ J_C * ψ₀ J_star * ψ₀ M₀ * S c₂ := by
      calc ψ_f u₂ = (ψ_f u₂ * S c₂) * S c₂ := by linear_combination -ψ_f u₂ * h_S_c₂_sq
        _ = ψ₀ J_C * ψ₀ J_star * ψ₀ M₀ * S c₂ := by rw [← h_span_c₂]
    have h_Sγ_eq : S γ = S γ₀ * S c₂ * S c₁ := by
      calc S γ = (S γ * S c₁) * S c₁ := by linear_combination -S γ * h_S_c₁_sq
        _ = S γ₀ * S c₂ * S c₁ := by rw [← h_S_cross]
    have h_u1_inv : (star (ψ₀ B₀) * star (ψ₀ M₀) * S c₁) * ψ_f u₁ = 1 := by
      calc (star (ψ₀ B₀) * star (ψ₀ M₀) * S c₁) * ψ_f u₁
        _ = (star (ψ₀ B₀) * ψ₀ B₀) * (star (ψ₀ M₀) * ψ₀ M₀) * (S c₁ * S c₁) := by
            rw [h_u1_eq]; ring
        _ = 1 := by
            rw [h_B₀_conj, h_M₀_conj, h_S_c₁_sq]; ring
    calc star (ψ₀ J_C) * (S γ * G_C)
      _ = star (ψ₀ J_C) * S γ * ((star (ψ₀ B₀) * star (ψ₀ M₀) * S c₁) * ψ_f u₁) * G_C := by
          rw [h_u1_inv]; ring
      _ = star (ψ₀ J_C) * S γ * (star (ψ₀ B₀) * star (ψ₀ M₀) * S c₁) * (ψ_f u₁ * G_C) := by ring
      _ = star (ψ₀ J_C) * S γ * (star (ψ₀ B₀) * star (ψ₀ M₀) * S c₁) * (ψ_f u₂ * G₀ x_star.1) := by
          rw [h_u1_GC]
      _ = S γ₀ * star (ψ₀ B₀) * ψ₀ J_star * G₀ x_star.1 *
            (S c₁ * S c₁) * (star (ψ₀ J_C) * ψ₀ J_C) * (star (ψ₀ M₀) * ψ₀ M₀) * (S c₂ * S c₂) := by
          rw [h_Sγ_eq, h_u2_eq]; ring
      _ = S γ₀ * star (ψ₀ B₀) * ψ₀ J_star * G₀ x_star.1 := by
          rw [h_S_c₁_sq, h_JC_conj, h_M₀_conj, h_S_c₂_sq]; ring
  rw [tsum_fintype]
  change star (ψ₀ J_C) *
      ((-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
        S γ * ((N_f_inv_sqrt : ℂ) * G_C)) =
    ω_ψ * ψ₀ J_star * star (ψ_f (Ideal.Quotient.mk f x_star.1))
  calc star (ψ₀ J_C) *
      ((-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
        S γ * ((N_f_inv_sqrt : ℂ) * G_C))
    _ = (-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
          (N_f_inv_sqrt : ℂ) * (star (ψ₀ J_C) * (S γ * G_C)) := by ring
    _ = (-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
          (N_f_inv_sqrt : ℂ) * (S γ₀ * star (ψ₀ B₀) * ψ₀ J_star * G₀ x_star.1) := by rw [h_s3]
    _ = (-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
          S γ₀ * star (ψ₀ B₀) * ((N_f_inv_sqrt : ℂ) * (τ_sum * star (ψ_f (Ideal.Quotient.mk f x_star.1)))) *
          ψ₀ J_star := by
        rw [hG₀_eval x_star.1]
        ring
    _ = ω_ψ * ψ₀ J_star * star (ψ_f (Ideal.Quotient.mk f x_star.1)) := by
        dsimp [ω_ψ, τ₀]
        ring

theorem mitsui_infinitePlace_harmonic_euclidean_trace_duality {K : Type u} [Field K] [NumberField K]
    (v₁ v₂ : Fin (Module.finrank ℚ K) → K)
    (γ : K) (hγ : γ ≠ 0)
    (Δ : ℝ) (hΔ : 0 < Δ)
    (h_dual : ∀ i j : Fin (Module.finrank ℚ K),
      (Algebra.trace ℚ K (v₁ i * (v₂ j / γ)) : ℝ) = if i = j then 1 else 0)
    (h_det : |(Matrix.of (fun i j : Fin (Module.finrank ℚ K) =>
        (Algebra.trace ℚ K (v₁ i * v₁ j) : ℝ))).det| = Δ ^ 2)
    (a_place : NumberField.InfinitePlace K → ℕ)
    (ha_real : ∀ w : NumberField.InfinitePlace K, w.IsReal → a_place w ≤ 1)
    (ha_cplx : ∀ w : NumberField.InfinitePlace K, w.IsComplex → a_place w = 0)
    (t : NumberField.InfinitePlace K → ℝ) (ht : ∀ w : NumberField.InfinitePlace K, 0 < t w) :
    let n : ℕ := Module.finrank ℚ K
    ∃ (A : Matrix (Fin n) (Fin n) ℝ) (d : Fin n → ℕ),
      A.det ≠ 0 ∧
      |A.det| = Δ * ∏ w : NumberField.InfinitePlace K, (t w) ^ ((w.mult : ℝ) / 2) ∧
      (∀ j : Fin n, d j ≤ 1) ∧
      (∑ j : Fin n, d j) = ∑ w : NumberField.InfinitePlace K, a_place w ∧
      (∀ q : Fin n → ℚ,
        (∏ w : NumberField.InfinitePlace K,
          (w (∑ i : Fin n, (q i : K) * v₁ i) * (t w) ^ (1 / 2 : ℝ)) ^ (a_place w)) =
        ∏ j : Fin n, |A.mulVec (fun i => (q i : ℝ)) j| ^ (d j)) ∧
      (∀ q : Fin n → ℚ,
        (∏ w : NumberField.InfinitePlace K,
          (w.embedding (∑ i : Fin n, (q i : K) * v₁ i) * (((t w) ^ (1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) =
        (((∏ j : Fin n, (A.mulVec (fun i => (q i : ℝ)) j) ^ (d j) : ℝ) : ℂ))) ∧
      (∀ q : Fin n → ℚ,
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * t w * (w (∑ i : Fin n, (q i : K) * v₁ i)) ^ 2) =
        ∑ j : Fin n, (A.mulVec (fun i => (q i : ℝ)) j) ^ 2) ∧
      (∀ l : Fin n → ℤ,
        (∏ w : NumberField.InfinitePlace K,
          ((w (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / w γ) * (t w) ^ (-1 / 2 : ℝ)) ^ (a_place w)) =
        ∏ j : Fin n, |A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j| ^ (d j)) ∧
      (∀ l : Fin n → ℤ,
        (((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d j) : ℝ) : ℂ)) =
        (∏ w : NumberField.InfinitePlace K,
          (w.embedding γ / (w γ : ℂ)) ^ (a_place w)) *
        (∏ w : NumberField.InfinitePlace K,
          ((w.embedding (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / (w γ : ℂ)) *
            (((t w) ^ (-1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w))) ∧
      (∀ l : Fin n → ℤ,
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (t w)⁻¹ * (w (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / w γ) ^ 2) =
        ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) :=
by
  classical
  intro n
  have h_s1 : ∀ x y : K,
      (Algebra.trace ℚ K (x * y) : ℝ) =
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) *
            ((w.embedding x).re * (w.embedding y).re -
              (w.embedding x).im * (w.embedding y).im) := by
    intro x y
    set z : K := x * y
    have h1 : (algebraMap ℚ ℂ) (Algebra.trace ℚ K z) = ∑ σ : K →ₐ[ℚ] ℂ, σ z :=
      trace_eq_sum_embeddings ℂ
    have h2 : (Algebra.trace ℚ K z : ℝ) = ∑ σ : K →ₐ[ℚ] ℂ, (σ z).re := by
      have hre := congr_arg Complex.re h1
      simpa [Complex.re_sum] using hre
    have h3 : (∑ σ : K →ₐ[ℚ] ℂ, (σ z).re) = ∑ φ : K →+* ℂ, (φ z).re := by
      rw [← Equiv.sum_comp (RingHom.equivRatAlgHom (R := K) (S := ℂ)) (fun σ : K →ₐ[ℚ] ℂ => (σ z).re)]
      rfl
    have h4 : (∑ φ : K →+* ℂ, (φ z).re) =
        ∑ idx : NumberField.mixedEmbedding.index K, ((NumberField.mixedEmbedding.indexEquiv K idx) z).re := by
      rw [← Equiv.sum_comp (NumberField.mixedEmbedding.indexEquiv K) (fun φ : K →+* ℂ => (φ z).re)]
    have h5 : (∑ idx : NumberField.mixedEmbedding.index K, ((NumberField.mixedEmbedding.indexEquiv K idx) z).re) =
        ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * (w.embedding z).re := by
      dsimp [NumberField.mixedEmbedding.index]
      rw [Fintype.sum_sum_type, Fintype.sum_prod_type]
      have h_real : (∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
          ((NumberField.mixedEmbedding.indexEquiv K (Sum.inl w)) z).re) =
          ∑ w : {w : NumberField.InfinitePlace K // w.IsReal}, (w.1.mult : ℝ) * (w.1.embedding z).re := by
        refine Finset.sum_congr rfl (fun w _ => ?_)
        rw [NumberField.mixedEmbedding.indexEquiv_apply_isReal w, NumberField.InfinitePlace.mult_isReal w]
        ring
      have h_cplx : (∑ w : {w : NumberField.InfinitePlace K // w.IsComplex},
          ∑ p : Fin 2, ((NumberField.mixedEmbedding.indexEquiv K (Sum.inr (w, p))) z).re) =
          ∑ w : {w : NumberField.InfinitePlace K // w.IsComplex}, (w.1.mult : ℝ) * (w.1.embedding z).re := by
        refine Finset.sum_congr rfl (fun w _ => ?_)
        rw [Fin.sum_univ_two,
          NumberField.mixedEmbedding.indexEquiv_apply_isComplex_fst w,
          NumberField.mixedEmbedding.indexEquiv_apply_isComplex_snd w,
          NumberField.ComplexEmbedding.conjugate_coe_eq,
          Complex.conj_re,
          NumberField.InfinitePlace.mult_isComplex w]
        push_cast
        ring
      rw [h_real, h_cplx, ← NumberField.InfinitePlace.sum_eq_sum_add_sum
        (fun w : NumberField.InfinitePlace K => (w.mult : ℝ) * (w.embedding z).re)]
    rw [h2, h3, h4, h5]
    refine Finset.sum_congr rfl (fun w _ => ?_)
    dsimp [z]
    rw [map_mul, Complex.mul_re]
  have h_s2 : ∀ y : K,
      (∏ w : NumberField.InfinitePlace K,
        (w (y / γ) * (t w) ^ (-1 / 2 : ℝ)) ^ (a_place w)) =
      (∏ w : NumberField.InfinitePlace K,
        ((w y / w γ) * (t w) ^ (-1 / 2 : ℝ)) ^ (a_place w)) ∧
      (∏ w : NumberField.InfinitePlace K,
        (w.embedding (y / γ) * (((t w) ^ (-1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) =
      (∏ w : NumberField.InfinitePlace K,
        (w.embedding γ / (w γ : ℂ)) ^ (a_place w)) *
      (∏ w : NumberField.InfinitePlace K,
        ((w.embedding y / (w γ : ℂ)) * (((t w) ^ (-1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) ∧
      (∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * (t w)⁻¹ * (w (y / γ)) ^ 2) =
      (∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * (t w)⁻¹ * (w y / w γ) ^ 2) := by
    intro y
    refine ⟨?_, ?_, ?_⟩
    · refine Finset.prod_congr rfl (fun w _ => ?_)
      rw [map_div₀]
    · rw [← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun w _ => ?_)
      rw [← mul_pow]
      rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
      · congr 1
        let r_γ : ℝ := NumberField.InfinitePlace.embedding_of_isReal hw γ
        have hr_coe : (r_γ : ℂ) = w.embedding γ :=
          NumberField.InfinitePlace.embedding_of_isReal_apply hw γ
        have hr_abs : |r_γ| = w γ := by
          rw [← Real.norm_eq_abs]
          exact NumberField.InfinitePlace.norm_embedding_of_isReal hw γ
        have hr_sq : r_γ ^ 2 = (w γ) ^ 2 := by
          rw [← sq_abs r_γ, hr_abs]
        have h_sq_C : (w.embedding γ) ^ 2 = (w γ : ℂ) ^ 2 := by
          rw [← hr_coe]
          exact_mod_cast hr_sq
        have hwγ_pos : 0 < w γ := NumberField.InfinitePlace.pos_iff.mpr hγ
        have hwγ_ne : (w γ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hwγ_pos)
        have hemb_ne : w.embedding γ ≠ 0 :=
          (map_ne_zero_iff w.embedding (RingHom.injective w.embedding)).mpr hγ
        have h_div : w.embedding (y / γ) = (w.embedding γ / (w γ : ℂ)) * (w.embedding y / (w γ : ℂ)) := by
          rw [map_div₀]
          field_simp [hwγ_ne, hemb_ne]
          rw [h_sq_C, mul_comm]
        rw [h_div, mul_assoc]
      · rw [ha_cplx w hw, pow_zero, pow_zero]
    · refine Finset.sum_congr rfl (fun w _ => ?_)
      rw [map_div₀]
  have h_card : Fintype.card (NumberField.mixedEmbedding.index K) = n := by
    rw [Fintype.card_congr (NumberField.mixedEmbedding.indexEquiv K)]
    exact NumberField.Embeddings.card K ℂ
  let ι_idx : NumberField.mixedEmbedding.index K ≃ Fin n := Fintype.equivFinOfCardEq h_card
  let Ψ₀ : K → NumberField.mixedEmbedding.index K → ℝ := fun x idx =>
    match idx with
    | Sum.inl w => (w.1.embedding x).re
    | Sum.inr (w, p) =>
        if p = 0 then Real.sqrt 2 * (w.1.embedding x).re
        else Real.sqrt 2 * (w.1.embedding x).im
  let c₀ : NumberField.mixedEmbedding.index K → ℝ := fun idx =>
    match idx with
    | Sum.inl w => (t w.1) ^ (1 / 2 : ℝ)
    | Sum.inr (w, _) => (t w.1) ^ (1 / 2 : ℝ)
  let s₀ : NumberField.mixedEmbedding.index K → ℝ := fun idx =>
    match idx with
    | Sum.inl _ => 1
