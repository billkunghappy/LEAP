            gcongr
        _ = A * s * (Real.log Y + 1) ^ 3 := by
            dsimp [A]
            ring
        _ ≤ c₂ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₂) := h_s6 Y hY_gt
    exact le_trans h_le_ge2 h_ge2_bound

theorem mitsui_chebyshev_le_riesz_forward_diff {K : Type u} [Field K] [NumberField K]
    (Y δ : ℝ) (hY : 0 < Y) (hδ : 0 < δ) :
    δ * (∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
          (Ideal.absNorm p.asIdeal : ℝ) ≤ Y},
        Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal))
      ≤ (∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
            (Ideal.absNorm p.asIdeal : ℝ) ≤ Real.exp δ * Y},
          Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal) *
            Real.log ((Real.exp δ * Y) / (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal : ℝ)))
        - (∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
              (Ideal.absNorm p.asIdeal : ℝ) ≤ Y},
            Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal) *
              Real.log (Y / (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal : ℝ))) :=
by
  classical
  have hexp_ge_one : 1 ≤ Real.exp δ := Real.one_le_exp (le_of_lt hδ)
  have hY_le_Z : Y ≤ Real.exp δ * Y := le_mul_of_one_le_left (le_of_lt hY) hexp_ge_one
  have hZ_pos : 0 < Real.exp δ * Y := mul_pos (Real.exp_pos δ) hY
  have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p.asIdeal := by
    intro p
    have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    omega
  let D_Y := {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
    (Ideal.absNorm p.asIdeal : ℝ) ≤ Y}
  let D_Z := {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
    (Ideal.absNorm p.asIdeal : ℝ) ≤ Real.exp δ * Y}
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Real.exp δ * Y⌋₊}
  have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Real.exp δ * Y⌋₊
  haveI : Finite S_id := hSid_fin
  let f_Z : D_Z → S_id := fun p => ⟨p.1.asIdeal, Nat.le_floor p.2⟩
  have hf_Z_inj : Function.Injective f_Z := by
    intro a b hab
    apply Subtype.ext
    apply IsDedekindDomain.HeightOneSpectrum.ext
    exact congrArg Subtype.val hab
  haveI : Finite D_Z := Finite.of_injective f_Z hf_Z_inj
  letI : Fintype D_Z := Fintype.ofFinite D_Z
  let f_Y : D_Y → S_id := fun p => ⟨p.1.asIdeal, Nat.le_floor (le_trans p.2 hY_le_Z)⟩
  have hf_Y_inj : Function.Injective f_Y := by
    intro a b hab
    apply Subtype.ext
    apply IsDedekindDomain.HeightOneSpectrum.ext
    exact congrArg Subtype.val hab
  haveI : Finite D_Y := Finite.of_injective f_Y hf_Y_inj
  letI : Fintype D_Y := Fintype.ofFinite D_Y
  have h_log_split : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      Real.log ((Real.exp δ * Y) / (Ideal.absNorm p.asIdeal : ℝ)) =
      Real.log (Y / (Ideal.absNorm p.asIdeal : ℝ)) + δ := by
    intro p
    have hk_pos : (0 : ℝ) < (Ideal.absNorm p.asIdeal : ℝ) := by
      have := h_norm_ge_two p
      positivity
    rw [Real.log_div (ne_of_gt hZ_pos) (ne_of_gt hk_pos),
      Real.log_div (ne_of_gt hY) (ne_of_gt hk_pos),
      Real.log_mul (ne_of_gt (Real.exp_pos δ)) (ne_of_gt hY),
      Real.log_exp]
    ring
  let Q : D_Z → Prop := fun p => (Ideal.absNorm p.1.asIdeal : ℝ) ≤ Y
  let e_Y : D_Y ≃ {p : D_Z // Q p} :=
    { toFun := fun p => ⟨⟨p.1, le_trans p.2 hY_le_Z⟩, p.2⟩
      invFun := fun p => ⟨p.1.1, p.2⟩
      left_inv := fun p => by apply Subtype.ext; rfl
      right_inv := fun p => by apply Subtype.ext; apply Subtype.ext; rfl }
  let term_Z : D_Z → ℝ := fun p =>
    Real.log (Ideal.absNorm p.1.asIdeal) *
      Real.log ((Real.exp δ * Y) / (Ideal.absNorm p.1.asIdeal : ℝ))
  let term_Y : D_Y → ℝ := fun p =>
    Real.log (Ideal.absNorm p.1.asIdeal) *
      Real.log (Y / (Ideal.absNorm p.1.asIdeal : ℝ))
  let term_ϑ : D_Y → ℝ := fun p =>
    Real.log (Ideal.absNorm p.1.asIdeal)
  have h_term_split : ∀ p : D_Y,
      term_Z (e_Y p).1 = term_Y p + δ * term_ϑ p := by
    intro p
    dsimp [term_Z, term_Y, term_ϑ, e_Y]
    rw [h_log_split p.1]
    ring
  have h_sum_filter_Z :
      ∑ p ∈ Finset.univ.filter Q, term_Z p =
      (∑' p : D_Y, term_Y p) + δ * (∑' p : D_Y, term_ϑ p) := by
    have h1 : ∑ p ∈ Finset.univ.filter Q, term_Z p =
        ∑' p : {p : D_Z // Q p}, term_Z p.1 := by
      rw [tsum_fintype]
      exact Finset.sum_subtype (Finset.univ.filter Q) (fun _ => by simp) term_Z
    have h2 : (∑' p : {p : D_Z // Q p}, term_Z p.1) =
        ∑' p : D_Y, term_Z (e_Y p).1 :=
      (Equiv.tsum_eq e_Y (fun p : {p : D_Z // Q p} => term_Z p.1)).symm
    rw [h1, h2, tsum_congr h_term_split, tsum_fintype, tsum_fintype, tsum_fintype,
      Finset.sum_add_distrib, ← Finset.mul_sum]
  have h_sum_Z : (∑' p : D_Z, term_Z p) =
      (∑ p ∈ Finset.univ.filter Q, term_Z p) +
      (∑ p ∈ Finset.univ.filter (fun p : D_Z => ¬ Q p), term_Z p) := by
    rw [tsum_fintype]
    exact (Finset.sum_filter_add_sum_filter_not Finset.univ Q term_Z).symm
  have h_rhs_eq :
      (∑' p : D_Z, term_Z p) - (∑' p : D_Y, term_Y p) =
      δ * (∑' p : D_Y, term_ϑ p) +
        (∑ p ∈ Finset.univ.filter (fun p : D_Z => ¬ Q p), term_Z p) := by
    rw [h_sum_Z, h_sum_filter_Z]
    ring
  have h_short_nonneg :
      0 ≤ ∑ p ∈ Finset.univ.filter (fun p : D_Z => ¬ Q p), term_Z p := by
    apply Finset.sum_nonneg
    intro p _
    have hk_pos : (0 : ℝ) < (Ideal.absNorm p.1.asIdeal : ℝ) := by
      have := h_norm_ge_two p.1
      positivity
    have hdiv_ge_one : 1 ≤ (Real.exp δ * Y) / (Ideal.absNorm p.1.asIdeal : ℝ) :=
      (one_le_div hk_pos).mpr p.2
    have hlog_div_nonneg : 0 ≤ Real.log ((Real.exp δ * Y) / (Ideal.absNorm p.1.asIdeal : ℝ)) :=
      Real.log_nonneg hdiv_ge_one
    have hlogN_nonneg : 0 ≤ Real.log (Ideal.absNorm p.1.asIdeal) :=
      Real.log_natCast_nonneg _
    exact mul_nonneg hlogN_nonneg hlog_div_nonneg
  change δ * (∑' p : D_Y, term_ϑ p) ≤ (∑' p : D_Z, term_Z p) - (∑' p : D_Y, term_Y p)
  linarith [h_rhs_eq, h_short_nonneg]

theorem mitsui_chebyshev_ge_riesz_backward_diff {K : Type u} [Field K] [NumberField K]
