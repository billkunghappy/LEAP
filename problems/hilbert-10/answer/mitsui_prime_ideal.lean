              mul_le_mul hrX (Real.abs_cos_le_one q.2) (abs_nonneg _) hX_nonneg
            _ = X := mul_one _
        have hy_Icc : q.1 * Real.sin q.2 ∈ Set.Icc (-X) X := by
          rw [Set.mem_Icc, ← abs_le, abs_mul, abs_of_pos hr]
          calc q.1 * |Real.sin q.2| ≤ X * 1 :=
              mul_le_mul hrX (Real.abs_sin_le_one q.2) (abs_nonneg _) hX_nonneg
            _ = X := mul_one _
        have h_diff_r : R₁ - q.1 ≤ ε := by linarith
        have h_diff_nonneg : 0 ≤ R₁ - q.1 := by linarith
        have hx_err : |R₁ * Real.cos q.2 - q.1 * Real.cos q.2| ≤ ε := by
