        _ = (Fintype.card ι : ℝ) * (C_L * (1 + S x)) := by
            rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
        _ ≤ D_ι * (C_L * (1 + S x)) := by
            refine mul_le_mul_of_nonneg_right ?_ (mul_nonneg (le_of_lt hCL_pos) (by linarith [hS_nn x]))
