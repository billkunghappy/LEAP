  let e_cop : S_cop ≃ {y : S_uncond // IsUnit (Ideal.Quotient.mk q y.1)} :=
    { toFun := fun x => ⟨⟨x.1, x.2.1, x.2.2.1⟩, x.2.2.2⟩
      invFun := fun y => ⟨y.1.1, y.1.2.1, y.1.2.2, y.2⟩
      left_inv := fun x => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_lhs_le :
      ‖(∑' π : S_sec_cop,
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) -
      (∑' k : NumberField.InfinitePlace K → Fin m,
        ∑' π : S_cell_cop k,
          ψ (Additive.ofMul π.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
      ≤ ∑ y : S_uncond, c y.1 * L y.1 := by
    rw [h_lhs_diff, norm_neg]
    calc ‖∑ x : S_cop, (c x.1 : ℂ) * term x‖
      _ ≤ ∑ x : S_cop, ‖(c x.1 : ℂ) * term x‖ := norm_sum_le _ _
      _ = ∑ x : S_cop, c x.1 * L x.1 := Finset.sum_congr rfl (fun x _ => h_term_norm x)
      _ = ∑ z : {y : S_uncond // IsUnit (Ideal.Quotient.mk q y.1)}, c z.1.1 * L z.1.1 :=
        Equiv.sum_comp e_cop (fun z : {y : S_uncond // IsUnit (Ideal.Quotient.mk q y.1)} =>
          c z.1.1 * L z.1.1)
      _ = ∑ y ∈ Finset.univ.filter (fun y : S_uncond => IsUnit (Ideal.Quotient.mk q y.1)),
            c y.1 * L y.1 :=
        (Finset.sum_subtype (Finset.univ.filter (fun y : S_uncond => IsUnit (Ideal.Quotient.mk q y.1)))
          (fun _ => by simp) (fun y : S_uncond => c y.1 * L y.1)).symm
      _ ≤ ∑ y : S_uncond, c y.1 * L y.1 :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
          (fun y _ _ => mul_nonneg (hc_nonneg y.1 y.2.1) (hL_nonneg y.1))
  let P_X : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ w : NumberField.InfinitePlace K, w (π : K) < X
  let P_ge : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K)
  have hc_le : ∀ y : S_uncond,
      c y.1 * L y.1 ≤
        (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0) +
        (if ¬ P_X y.1 then L y.1 else 0) := by
    intro y
    have h_ind_le : c y.1 ≤
        (if P_X y.1 ∧ ¬ P_ge y.1 then (1 : ℝ) else 0) +
        (if ¬ P_X y.1 then (1 : ℝ) else 0) := by
      dsimp [c]
      by_cases hsec : P_sec y.1
      · rw [if_pos hsec, h_sec_card_eq_one y.1 y.2.1 hsec]
        split_ifs <;> norm_num
      · rw [if_neg hsec, sub_zero]
        have h_card_le : ((M y.1).card : ℝ) ≤ 1 := by exact_mod_cast hM_le_one y.1
        by_cases hX_mem : P_X y.1
        · by_cases hge : P_ge y.1
          · by_cases hM_zero : (M y.1).card = 0
            · rw [hM_zero]
              split_ifs <;> norm_num
            · obtain ⟨k, hk⟩ := Finset.card_pos.mp (Nat.pos_of_ne_zero hM_zero)
              rw [Finset.mem_filter] at hk
              have h_max := (h_cell_sub k y.1 y.2.1 hk.2).1
              exfalso
              exact hsec ⟨fun w => ⟨hge w, h_max w⟩, hX_mem w₀⟩
          · simp [hX_mem, hge, h_card_le]
        · simp [hX_mem, h_card_le]
    have h_mul := mul_le_mul_of_nonneg_right h_ind_le (hL_nonneg y.1)
    calc c y.1 * L y.1
      _ ≤ ((if P_X y.1 ∧ ¬ P_ge y.1 then (1 : ℝ) else 0) +
           (if ¬ P_X y.1 then (1 : ℝ) else 0)) * L y.1 := h_mul
      _ = (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0) +
          (if ¬ P_X y.1 then L y.1 else 0) := by
        split_ifs <;> ring
  have h_sum_c_le :
      ∑ y : S_uncond, c y.1 * L y.1 ≤
        (∑ y : S_uncond, (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0)) +
        (∑ y : S_uncond, (if ¬ P_X y.1 then L y.1 else 0)) := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_le_sum (fun y _ => hc_le y)
  let S_X_uncond := {π : NumberField.RingOfIntegers K //
    Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X}
  let e_X_uncond : S_X_uncond ≃ {y : S_uncond // P_X y.1} :=
    { toFun := fun π => ⟨⟨π.1, π.2.1, fun w => lt_trans (π.2.2 w) hX_lt_X'⟩, π.2.2⟩
      invFun := fun y => ⟨y.1.1, y.1.2.1, y.2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_rhs_X :
      (∑' π : S_X_uncond, L π.1) =
        ∑ y : S_uncond, (if P_X y.1 then L y.1 else 0) := by
    change (∑' π : S_X_uncond, L (e_X_uncond π).1.1) = _
    rw [Equiv.tsum_eq e_X_uncond (fun z : {y : S_uncond // P_X y.1} => L z.1.1), tsum_fintype]
    have hsub : (∑ z : {y : S_uncond // P_X y.1}, L z.1.1) =
        ∑ y ∈ Finset.univ.filter (fun y : S_uncond => P_X y.1), L y.1 :=
      (Finset.sum_subtype (Finset.univ.filter (fun y : S_uncond => P_X y.1))
        (fun _ => by simp) (fun y : S_uncond => L y.1)).symm
    rw [hsub, Finset.sum_filter]
  let S_Xge_uncond := {π : NumberField.RingOfIntegers K //
    Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X}
  let e_Xge_uncond : S_Xge_uncond ≃ {y : S_uncond // P_X y.1 ∧ P_ge y.1} :=
    { toFun := fun π =>
        ⟨⟨π.1, π.2.1, fun w => lt_trans (π.2.2 w).2 hX_lt_X'⟩,
         ⟨fun w => (π.2.2 w).2, fun w => (π.2.2 w).1⟩⟩
      invFun := fun y => ⟨y.1.1, y.1.2.1, fun w => ⟨y.2.2 w, y.2.1 w⟩⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_rhs_Xge :
      (∑' π : S_Xge_uncond, L π.1) =
        ∑ y : S_uncond, (if P_X y.1 ∧ P_ge y.1 then L y.1 else 0) := by
    change (∑' π : S_Xge_uncond, L (e_Xge_uncond π).1.1) = _
    rw [Equiv.tsum_eq e_Xge_uncond (fun z : {y : S_uncond // P_X y.1 ∧ P_ge y.1} => L z.1.1),
      tsum_fintype]
    have hsub : (∑ z : {y : S_uncond // P_X y.1 ∧ P_ge y.1}, L z.1.1) =
        ∑ y ∈ Finset.univ.filter (fun y : S_uncond => P_X y.1 ∧ P_ge y.1), L y.1 :=
      (Finset.sum_subtype (Finset.univ.filter (fun y : S_uncond => P_X y.1 ∧ P_ge y.1))
        (fun _ => by simp) (fun y : S_uncond => L y.1)).symm
    rw [hsub, Finset.sum_filter]
  have h_rhs_X' : (∑' y : S_uncond, L y.1) = ∑ y : S_uncond, L y.1 :=
    tsum_fintype (fun y : S_uncond => L y.1)
  have h_rhs1_eq :
      |(∑' π : S_X_uncond, L π.1) - (∑' π : S_Xge_uncond, L π.1)| =
        ∑ y : S_uncond, (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0) := by
    have h_diff :
        (∑' π : S_X_uncond, L π.1) - (∑' π : S_Xge_uncond, L π.1) =
          ∑ y : S_uncond, (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0) := by
      rw [h_rhs_X, h_rhs_Xge, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun y _ => ?_)
      by_cases h1 : P_X y.1 <;> by_cases h2 : P_ge y.1 <;> simp [h1, h2]
    have h_nonneg :
        0 ≤ ∑ y : S_uncond, (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0) :=
      Finset.sum_nonneg (fun y _ => by split_ifs; exact hL_nonneg y.1; exact le_rfl)
    rw [h_diff, abs_of_nonneg h_nonneg]
  have h_rhs2_eq :
      |(∑' y : S_uncond, L y.1) - (∑' π : S_X_uncond, L π.1)| =
        ∑ y : S_uncond, (if ¬ P_X y.1 then L y.1 else 0) := by
    have h_diff :
        (∑' y : S_uncond, L y.1) - (∑' π : S_X_uncond, L π.1) =
          ∑ y : S_uncond, (if ¬ P_X y.1 then L y.1 else 0) := by
      rw [h_rhs_X', h_rhs_X, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun y _ => ?_)
      by_cases h1 : P_X y.1 <;> simp [h1]
    have h_nonneg :
        0 ≤ ∑ y : S_uncond, (if ¬ P_X y.1 then L y.1 else 0) :=
      Finset.sum_nonneg (fun y _ => by by_cases h1 : P_X y.1 <;> simp [h1, hL_nonneg y.1])
    rw [h_diff, abs_of_nonneg h_nonneg]
  change ‖(∑' π : S_sec_cop,
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) -
      (∑' k : NumberField.InfinitePlace K → Fin m,
        ∑' π : S_cell_cop k,
          ψ (Additive.ofMul π.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
    ≤ |(∑' π : S_X_uncond, L π.1) - (∑' π : S_Xge_uncond, L π.1)| +
      |(∑' y : S_uncond, L y.1) - (∑' π : S_X_uncond, L π.1)|
  rw [h_rhs1_eq, h_rhs2_eq]
  exact le_trans h_lhs_le h_sum_c_le

theorem mitsui_prime_char_decoupled_log_box_sub_primePower_le {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (m : ℕ) (hm : 1 ≤ m)
    (w₀ : NumberField.InfinitePlace K)
    (k : NumberField.InfinitePlace K → Fin m)
    (Y : ℝ) (hY : Y ≤ X ^ (Module.finrank ℚ K))
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ) :
    ‖(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) ≤ Y ∧
          (∀ w : NumberField.InfinitePlace K,
            Real.log (w (π : K) / w₀ (π : K)) ∈
              Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))) ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      - (∑' xpm : {xpm : NumberField.RingOfIntegers K ×
              IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            1 ≤ xpm.2.2 ∧
            Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
            (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Y ∧
            (∀ w : NumberField.InfinitePlace K,
              Real.log (w (xpm.1 : K) / w₀ (xpm.1 : K)) ∈
                Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                  (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))) ∧
            IsUnit (Ideal.Quotient.mk q xpm.1)},
          ψ (Additive.ofMul xpm.2.2.2.2.2.unit) *
            (Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) : ℂ))‖
    ≤ ∑' xpm : {xpm : NumberField.RingOfIntegers K ×
            IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          2 ≤ xpm.2.2 ∧
          Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
          (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ X ^ (Module.finrank ℚ K) ∧
          ∀ w : NumberField.InfinitePlace K,
            Real.log (w (xpm.1 : K) / w₀ (xpm.1 : K)) ∈ Set.Ioc (-Real.log X) 0},
        Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) :=
by
  classical
  have hq_bot : q ≠ ⊥ := hq
  haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
    Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
  set n : ℕ := Module.finrank ℚ K
  set Z₀ : ℝ := X ^ n
  have hn_pos : 0 < n := Module.finrank_pos
  have hX_pos : 0 < X := by linarith
  have hlog_pos : 0 < Real.log X := Real.log_pos hX
  have hm_pos : (0 : ℝ) < (m : ℝ) := Nat.cast_pos.mpr hm
  have h_cell_sub_sector : ∀ w : NumberField.InfinitePlace K,
      Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
        (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))) ⊆
      Set.Ioc (-Real.log X) 0 := by
    intro w
    have hkw_lt : (k w : ℕ) + 1 ≤ m := (k w).isLt
    have hkw_rle : ((k w : ℕ) : ℝ) + 1 ≤ (m : ℝ) := by exact_mod_cast hkw_lt
    have hkw_nonneg : (0 : ℝ) ≤ ((k w : ℕ) : ℝ) := Nat.cast_nonneg _
    have h_left_div : -1 ≤ (((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ) := by
      rw [le_div_iff₀ hm_pos]
      linarith
    have h_left : -Real.log X ≤ Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)) := by
      calc -Real.log X = Real.log X * (-1) := by ring
        _ ≤ Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)) :=
          mul_le_mul_of_nonneg_left h_left_div (le_of_lt hlog_pos)
    have h_right_div : (((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ) ≤ 0 :=
      div_nonpos_of_nonpos_of_nonneg (by linarith) (le_of_lt hm_pos)
    have h_right : Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos (le_of_lt hlog_pos) h_right_div
    exact Set.Ioc_subset_Ioc h_left h_right
  have h_prod_norm : ∀ x : NumberField.RingOfIntegers K,
      (∏ v : NumberField.InfinitePlace K, v (x : K) ^ v.mult) =
        ((Algebra.norm ℤ x).natAbs : ℝ) := by
    intro x
    rw [NumberField.InfinitePlace.prod_eq_abs_norm]
    have h_coe : Algebra.norm ℚ (x : K) = (Algebra.norm ℤ x : ℚ) :=
      (Algebra.coe_norm_int x).symm
    rw [h_coe]
    push_cast
    rw [← Int.cast_abs]
    exact (Int.cast_natAbs (Algebra.norm ℤ x)).symm
  have h_sector_place_le : ∀ x : NumberField.RingOfIntegers K,
      x ≠ 0 →
      ((Algebra.norm ℤ x).natAbs : ℝ) ≤ Z₀ →
      (∀ v : NumberField.InfinitePlace K,
        Real.log (v (x : K) / w₀ (x : K)) ∈ Set.Ioc (-Real.log X) 0) →
      ∀ v : NumberField.InfinitePlace K, v (x : K) ≤ X ^ 2 := by
    intro x hx_ne hx_norm hx_log v
    have hxK : (x : K) ≠ 0 :=
      NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx_ne
    have hv_pos : ∀ u : NumberField.InfinitePlace K, 0 < u (x : K) :=
      fun u => u.pos_iff.mpr hxK
    have hw₀_pos : 0 < w₀ (x : K) := hv_pos w₀
    have hv_le_w₀ : v (x : K) ≤ w₀ (x : K) := by
      have hlog_le : Real.log (v (x : K) / w₀ (x : K)) ≤ 0 := (hx_log v).2
      have hexp_le : Real.exp (Real.log (v (x : K) / w₀ (x : K))) ≤ Real.exp 0 :=
        Real.exp_le_exp.mpr hlog_le
      rw [Real.exp_log (div_pos (hv_pos v) hw₀_pos), Real.exp_zero] at hexp_le
      exact (div_le_one hw₀_pos).mp hexp_le
    have hw₀_le_Xv : ∀ u : NumberField.InfinitePlace K, w₀ (x : K) ≤ X * u (x : K) := by
      intro u
      have hlog_gt : -Real.log X < Real.log (u (x : K) / w₀ (x : K)) := (hx_log u).1
      have hlog_sum : 0 ≤ Real.log X + Real.log (u (x : K) / w₀ (x : K)) := by linarith
      have h_div_pos : 0 < u (x : K) / w₀ (x : K) := div_pos (hv_pos u) hw₀_pos
      rw [← Real.log_mul (ne_of_gt hX_pos) (ne_of_gt h_div_pos), mul_div_assoc'] at hlog_sum
      have hexp_ge : Real.exp 0 ≤ Real.exp (Real.log ((X * u (x : K)) / w₀ (x : K))) :=
        Real.exp_le_exp.mpr hlog_sum
      rw [Real.exp_zero, Real.exp_log (div_pos (mul_pos hX_pos (hv_pos u)) hw₀_pos)] at hexp_ge
      exact (one_le_div hw₀_pos).mp hexp_ge
    have h_pow_each : ∀ u ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)),
        w₀ (x : K) ^ u.mult ≤ X ^ u.mult * u (x : K) ^ u.mult := by
      intro u _
      calc w₀ (x : K) ^ u.mult
        _ ≤ (X * u (x : K)) ^ u.mult :=
          pow_le_pow_left₀ (le_of_lt hw₀_pos) (hw₀_le_Xv u) u.mult
        _ = X ^ u.mult * u (x : K) ^ u.mult := mul_pow X (u (x : K)) u.mult
    have h_prod_le :
        (∏ u : NumberField.InfinitePlace K, w₀ (x : K) ^ u.mult) ≤
        (∏ u : NumberField.InfinitePlace K, (X ^ u.mult * u (x : K) ^ u.mult)) :=
      Finset.prod_le_prod (fun u _ => by positivity) h_pow_each
    have h_lhs : (∏ u : NumberField.InfinitePlace K, w₀ (x : K) ^ u.mult) = w₀ (x : K) ^ n := by
      rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq]
    have h_rhs : (∏ u : NumberField.InfinitePlace K, (X ^ u.mult * u (x : K) ^ u.mult)) =
        Z₀ * ((Algebra.norm ℤ x).natAbs : ℝ) := by
      rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum,
        NumberField.InfinitePlace.sum_mult_eq, h_prod_norm x]
    rw [h_lhs, h_rhs] at h_prod_le
    have hw₀_pow_le : w₀ (x : K) ^ n ≤ (X ^ 2) ^ n := by
      calc w₀ (x : K) ^ n
        _ ≤ Z₀ * ((Algebra.norm ℤ x).natAbs : ℝ) := h_prod_le
        _ ≤ Z₀ * Z₀ := mul_le_mul_of_nonneg_left hx_norm (by dsimp [Z₀]; positivity)
        _ = (X ^ 2) ^ n := by
          dsimp [Z₀]
          rw [← mul_pow, sq]
    have hw₀_le_X2 : w₀ (x : K) ≤ X ^ 2 :=
      (pow_le_pow_iff_left₀ (le_of_lt hw₀_pos) (by positivity) (ne_of_gt hn_pos)).mp hw₀_pow_le
    exact le_trans hv_le_w₀ hw₀_le_X2
  let B_X2 : Set K := {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X ^ 2}
  have hBX2_fin : B_X2.Finite := NumberField.Embeddings.finite_of_norm_le K ℂ (X ^ 2)
  have hpre_fin : (algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X2).Finite :=
    hBX2_fin.preimage NumberField.RingOfIntegers.coe_injective.injOn
  let S_elt : Set (NumberField.RingOfIntegers K) :=
    {x : NumberField.RingOfIntegers K | ∀ w : NumberField.InfinitePlace K, w (x : K) ≤ X ^ 2}
  have hSelt_sub : S_elt ⊆ algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X2 := by
    intro x hx
    refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, fun φ => ?_⟩
    let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
    have hw : w (x : K) = ‖φ (x : K)‖ := NumberField.InfinitePlace.apply φ (x : K)
    change ‖φ (x : K)‖ ≤ X ^ 2
    rw [← hw]
    exact hx w
  have hSelt_fin : S_elt.Finite := hpre_fin.subset hSelt_sub
  haveI : Finite S_elt := hSelt_fin
  have h_norm_ge_two : ∀ p_id : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p_id.asIdeal := by
    intro p_id
    have h0 : Ideal.absNorm p_id.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p_id.ne_bot
