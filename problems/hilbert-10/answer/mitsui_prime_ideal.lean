      _ ≤ 4 * A + ‖F s₀‖ := by linarith
      _ = 4 * M + 5 * ‖F s₀‖ + ε := by dsimp [A]; ring
  obtain ⟨M₁, hM₁_pos, h_s1⟩ := mitsui_riemannZeta_logDeriv_bound_of_one_lt_re_le_two
  obtain ⟨A₀, hA₀_pos, h_s2⟩ :=
    mitsui_riemannZeta_re_logDeriv_bound_of_zeroFree_of_three_le_im B₀ hB₀_pos hB₀_le h_zf
  let F : ℂ → ℂ := fun w => -deriv riemannZeta w / riemannZeta w
  have h_diff_on : DifferentiableOn ℂ riemannZeta {(1 : ℂ)}ᶜ :=
    fun w hw => (differentiableAt_riemannZeta hw).differentiableWithinAt
  have h_deriv_on : DifferentiableOn ℂ (deriv riemannZeta) {(1 : ℂ)}ᶜ :=
    h_diff_on.deriv isOpen_compl_singleton
  have hF_diff : ∀ w : ℂ, w ≠ 1 → riemannZeta w ≠ 0 → DifferentiableAt ℂ F w := by
    intro w hw_ne hw_zf
    dsimp [F]
    exact ((h_deriv_on.differentiableAt (isOpen_compl_singleton.mem_nhds hw_ne)).neg).div
      (differentiableAt_riemannZeta hw_ne) hw_zf
  have hlog4_gt_one : 1 < Real.log 4 := by
    rw [← Real.log_exp 1]
    exact Real.log_lt_log (Real.exp_pos 1) (lt_trans Real.exp_one_lt_d9 (by norm_num))
  have hlog_ge_one : ∀ t : ℝ, 1 ≤ Real.log (4 + |t|) := by
    intro t
    have h4_le : (4 : ℝ) ≤ 4 + |t| := by linarith [abs_nonneg t]
    exact le_trans (le_of_lt hlog4_gt_one) (Real.log_le_log (by norm_num) h4_le)
  let σ₀ : ℝ → ℝ := fun t => 1 + B₀ / (8 * Real.log (4 + |t|))
  let M₀ : ℝ := M₁ + 8 / B₀
  have hM₀_pos : 0 < M₀ := by dsimp [M₀]; positivity
  have hF_right : ∀ w : ℂ, σ₀ w.im ≤ w.re → w.re ≤ 2 →
      ‖F w‖ ≤ M₀ * Real.log (4 + |w.im|) := by
    intro w hw_ge hw_le
    set L : ℝ := Real.log (4 + |w.im|)
    have hL_ge_one : 1 ≤ L := hlog_ge_one w.im
    have hL_pos : 0 < L := lt_of_lt_of_le zero_lt_one hL_ge_one
    have h_step_pos : 0 < B₀ / (8 * L) := by positivity
    have hw_gt_one : 1 < w.re := by
      have : σ₀ w.im = 1 + B₀ / (8 * L) := rfl
      linarith
    have hw_sub_ge : B₀ / (8 * L) ≤ w.re - 1 := by
      have : σ₀ w.im = 1 + B₀ / (8 * L) := rfl
      linarith
    have h_inv_le : 1 / (w.re - 1) ≤ (8 / B₀) * L := by
      rw [one_div]
      have h1 : (w.re - 1)⁻¹ ≤ (B₀ / (8 * L))⁻¹ := inv_anti₀ h_step_pos hw_sub_ge
      have h2 : (B₀ / (8 * L))⁻¹ = (8 / B₀) * L := by
        have hB₀_ne : B₀ ≠ 0 := ne_of_gt hB₀_pos
        have hL_ne : L ≠ 0 := ne_of_gt hL_pos
        field_simp [hB₀_ne, hL_ne]
      rwa [h2] at h1
    have h_M₁_le : M₁ ≤ M₁ * L := le_mul_of_one_le_right (le_of_lt hM₁_pos) hL_ge_one
    have h1 : ‖F w‖ ≤ M₁ + 1 / (w.re - 1) := h_s1 w hw_gt_one hw_le
    calc ‖F w‖
        ≤ M₁ + 1 / (w.re - 1) := h1
      _ ≤ M₁ * L + (8 / B₀) * L := add_le_add h_M₁_le h_inv_le
      _ = M₀ * L := by dsimp [M₀]; ring
  let C₃ : ℝ := 8 * A₀ + 5 * M₀ + 1
  have hC₃_pos : 0 < C₃ := by dsimp [C₃]; positivity
  refine ⟨C₃, hC₃_pos, ?_⟩
  intro s hs_im hs_re_ge hs_re_le
  set t : ℝ := s.im
  set L : ℝ := Real.log (4 + |t|)
  have hL_ge_one : 1 ≤ L := hlog_ge_one t
  have hL_pos : 0 < L := lt_of_lt_of_le zero_lt_one hL_ge_one
  have hs_sub_one_norm : 4 ≤ ‖s - 1‖ := by
    have h_im : (s - 1).im = t := by simp [t]
    have h1 : |t| ≤ ‖s - 1‖ := by
      rw [← h_im]
      exact Complex.abs_im_le_norm (s - 1)
    linarith
  have h_pole_le_L : ‖(1 : ℂ) / (s - 1)‖ ≤ L := by
    rw [one_div, norm_inv]
    have h1 : ‖s - 1‖⁻¹ ≤ (4 : ℝ)⁻¹ := inv_anti₀ (by norm_num) hs_sub_one_norm
    linarith
  have hF_bound : ‖F s‖ ≤ (8 * A₀ + 5 * M₀) * L := by
    rcases le_or_gt (σ₀ t) s.re with hs_right | hs_collar
    · have h1 : ‖F s‖ ≤ M₀ * L := hF_right s hs_right hs_re_le
      have h_coeff : M₀ ≤ 8 * A₀ + 5 * M₀ := by linarith
      calc ‖F s‖
          ≤ M₀ * L := h1
        _ ≤ (8 * A₀ + 5 * M₀) * L := mul_le_mul_of_nonneg_right h_coeff (le_of_lt hL_pos)
    · let s₀ : ℂ := (σ₀ t : ℂ) + (t : ℂ) * Complex.I
      let R : ℝ := (3 * B₀) / (8 * L)
      have hR_pos : 0 < R := by dsimp [R]; positivity
      have hR_le_half : R ≤ 1 / 2 := by
        dsimp [R]
        rw [div_le_iff₀ (by positivity)]
        nlinarith
      have hs₀_re : s₀.re = σ₀ t := by simp [s₀]
      have hs₀_im : s₀.im = t := by simp [s₀]
      have h_ball : ∀ w ∈ Metric.closedBall s₀ R,
          DifferentiableAt ℂ F w ∧ (F w).re ≤ (2 * A₀) * L := by
        intro w hw
        have hw_dist : ‖w - s₀‖ ≤ R := by
          simpa [Metric.mem_closedBall, dist_eq_norm] using hw
        have hw_re_sub : |w.re - σ₀ t| ≤ R := by
          have h1 : |(w - s₀).re| ≤ ‖w - s₀‖ := Complex.abs_re_le_norm (w - s₀)
          rw [Complex.sub_re, hs₀_re] at h1
          exact le_trans h1 hw_dist
        have hw_im_sub : |w.im - t| ≤ R := by
          have h1 : |(w - s₀).im| ≤ ‖w - s₀‖ := Complex.abs_im_le_norm (w - s₀)
          rw [Complex.sub_im, hs₀_im] at h1
          exact le_trans h1 hw_dist
        have hw_im_ge : 3 ≤ |w.im| := by
          have h1 : |t| - |w.im| ≤ |w.im - t| := by
            rw [abs_sub_comm]
            exact abs_sub_abs_le_abs_sub t w.im
          linarith
        have hw_im_le : |w.im| ≤ |t| + 1 / 2 := by
          have h1 : |w.im| - |t| ≤ |w.im - t| := abs_sub_abs_le_abs_sub w.im t
          linarith
        have hw_ne_one : w ≠ 1 := by
          intro h1
          have : |w.im| = 0 := by rw [h1]; simp
          linarith
        have h4w_pos : 0 < 4 + |w.im| := by positivity
        have h4t_pos : 0 < 4 + |t| := by positivity
        have h4w_le_sq : 4 + |w.im| ≤ (4 + |t|) ^ 2 := by
          have ht_nonneg : 0 ≤ |t| := abs_nonneg t
          nlinarith
        have hlogw_le_2L : Real.log (4 + |w.im|) ≤ 2 * L := by
          have h1 := Real.log_le_log h4w_pos h4w_le_sq
          rw [Real.log_pow] at h1
          simpa [L] using h1
        have hlogw_pos : 0 < Real.log (4 + |w.im|) :=
          lt_of_lt_of_le zero_lt_one (hlog_ge_one w.im)
        have hw_re_ge_collar : 1 - (B₀ / 2) / (2 * L) ≤ w.re := by
          have h1 : -R ≤ w.re - σ₀ t := (abs_le.mp hw_re_sub).1
          have h_eq : σ₀ t - R = 1 - (B₀ / 2) / (2 * L) := by
            dsimp [σ₀, R, L]
            ring
          linarith
        have h_div_half : (B₀ / 2) / (2 * L) ≤ (B₀ / 2) / Real.log (4 + |w.im|) :=
          div_le_div_of_nonneg_left (by positivity) hlogw_pos hlogw_le_2L
        have hw_re_s2 : 1 - (B₀ / 2) / Real.log (4 + |w.im|) ≤ w.re := by linarith
        have h_half_le_B₀ : (B₀ / 2) / Real.log (4 + |w.im|) ≤ B₀ / Real.log (4 + |w.im|) :=
          div_le_div_of_nonneg_right (by linarith) (le_of_lt hlogw_pos)
        have hw_re_zf : 1 - B₀ / Real.log (4 + |w.im|) ≤ w.re := by linarith
        have hw_re_le_two : w.re ≤ 2 := by
          have h1 : w.re - σ₀ t ≤ R := (abs_le.mp hw_re_sub).2
          have h_step : B₀ / (8 * L) ≤ 1 / 16 := by
            rw [div_le_iff₀ (by positivity)]
            nlinarith
          have h_sig : σ₀ t = 1 + B₀ / (8 * L) := rfl
          linarith
        have hw_zf : riemannZeta w ≠ 0 := h_zf w hw_ne_one hw_re_zf
        refine ⟨hF_diff w hw_ne_one hw_zf, ?_⟩
        have h_re_w := h_s2 w hw_im_ge hw_re_s2 hw_re_le_two
        calc (F w).re
            ≤ A₀ * Real.log (4 + |w.im|) := h_re_w
          _ ≤ A₀ * (2 * L) := mul_le_mul_of_nonneg_left hlogw_le_2L (le_of_lt hA₀_pos)
          _ = (2 * A₀) * L := by ring
      have hs_mem_inner : s ∈ Metric.closedBall s₀ (2 * R / 3) := by
        rw [Metric.mem_closedBall, dist_eq_norm]
        have h_sub_eq : s - s₀ = ((s.re - σ₀ t : ℝ) : ℂ) := by
          apply Complex.ext
          · simp [hs₀_re]
          · simp [hs₀_im, t]
        rw [h_sub_eq, Complex.norm_real, Real.norm_eq_abs,
          abs_of_neg (sub_neg.mpr hs_collar)]
        have h_sig : σ₀ t = 1 + B₀ / (8 * L) := rfl
        have h_rad : 2 * R / 3 = B₀ / (4 * L) := by dsimp [R]; ring
        have h_diff : (1 + B₀ / (8 * L)) - (1 - (B₀ / 8) / L) = B₀ / (4 * L) := by ring
        linarith
      have hs₀_re_le_two : s₀.re ≤ 2 := by
        rw [hs₀_re]
        have h_step : B₀ / (8 * L) ≤ 1 / 16 := by
          rw [div_le_iff₀ (by positivity)]
          nlinarith
        have h_sig : σ₀ t = 1 + B₀ / (8 * L) := rfl
        linarith
      have hFs₀_le : ‖F s₀‖ ≤ M₀ * L := by
        have h1 := hF_right s₀ (by rw [hs₀_re, hs₀_im]) hs₀_re_le_two
        rwa [hs₀_im] at h1
      have hFs_bc : ‖F s‖ ≤ 4 * ((2 * A₀) * L) + 5 * ‖F s₀‖ :=
        h_bc F s₀ R ((2 * A₀) * L) hR_pos (by positivity)
          (fun w hw => (h_ball w hw).1) (fun w hw => (h_ball w hw).2) s hs_mem_inner
      calc ‖F s‖
          ≤ 4 * ((2 * A₀) * L) + 5 * ‖F s₀‖ := hFs_bc
        _ ≤ 4 * ((2 * A₀) * L) + 5 * (M₀ * L) := by linarith
        _ = (8 * A₀ + 5 * M₀) * L := by ring
  calc ‖F s - 1 / (s - 1)‖
      ≤ ‖F s‖ + ‖(1 : ℂ) / (s - 1)‖ := norm_sub_le _ _
    _ ≤ (8 * A₀ + 5 * M₀) * L + L := add_le_add hF_bound h_pole_le_L
    _ = C₃ * L := by dsimp [C₃]; ring

theorem mitsui_riemannZeta_zeroFree_and_logDeriv_bound : ∃ (B C : ℝ), 0 < B ∧ B ≤ 1 / 2 ∧ 0 < C ∧
      ∀ s : ℂ, s ≠ 1 → 1 - B / Real.log (4 + |s.im|) ≤ s.re →
        riemannZeta s ≠ 0 ∧
        ‖-deriv riemannZeta s / riemannZeta s - 1 / (s - 1)‖ ≤ C * Real.log (4 + |s.im|) :=
by
  obtain ⟨C₁, hC₁_pos, h_s1⟩ := mitsui_riemannZeta_logDeriv_sub_pole_bound_of_two_le_re
  obtain ⟨δ₀, C₂, hδ₀_pos, hδ₀_le, hC₂_pos, h_s2⟩ :=
    mitsui_riemannZeta_zeroFree_and_logDeriv_bound_of_im_le_four
  obtain ⟨B₁, hB₁_pos, hB₁_le, h_s3⟩ := mitsui_riemannZeta_zeroFree_of_four_le_im
  have hlog4_pos : 0 < Real.log 4 := Real.log_pos (by norm_num)
  let B₀ : ℝ := min B₁ (δ₀ * Real.log 4)
  have hB₀_pos : 0 < B₀ := lt_min hB₁_pos (mul_pos hδ₀_pos hlog4_pos)
  have hB₀_le_B₁ : B₀ ≤ B₁ := min_le_left _ _
  have hB₀_le_δ₀ : B₀ ≤ δ₀ * Real.log 4 := min_le_right _ _
  have hB₀_le : B₀ ≤ 1 / 2 := le_trans hB₀_le_B₁ hB₁_le
  have h_zf : ∀ w : ℂ, w ≠ 1 → 1 - B₀ / Real.log (4 + |w.im|) ≤ w.re → riemannZeta w ≠ 0 := by
    intro w hw_ne hw_re
    have h4_le : (4 : ℝ) ≤ 4 + |w.im| := by linarith [abs_nonneg w.im]
    have hlogw_ge : Real.log 4 ≤ Real.log (4 + |w.im|) := Real.log_le_log (by norm_num) h4_le
    have hlogw_pos : 0 < Real.log (4 + |w.im|) := lt_of_lt_of_le hlog4_pos hlogw_ge
    rcases le_or_gt 2 w.re with hw2 | hw2
    · exact (h_s1 w hw2).1
    · rcases le_or_gt |w.im| 4 with hw_im | hw_im
      · have h_div1 : B₀ / Real.log (4 + |w.im|) ≤ B₀ / Real.log 4 :=
          div_le_div_of_nonneg_left (le_of_lt hB₀_pos) hlog4_pos hlogw_ge
        have h_div2 : B₀ / Real.log 4 ≤ (δ₀ * Real.log 4) / Real.log 4 :=
          div_le_div_of_nonneg_right hB₀_le_δ₀ (le_of_lt hlog4_pos)
        have h_eq : (δ₀ * Real.log 4) / Real.log 4 = δ₀ :=
          mul_div_cancel_right₀ δ₀ (ne_of_gt hlog4_pos)
        have hw_re' : 1 - δ₀ ≤ w.re := by linarith
        exact (h_s2 w hw_ne hw_im hw_re' (le_of_lt hw2)).1
      · have h_div : B₀ / Real.log (4 + |w.im|) ≤ B₁ / Real.log (4 + |w.im|) :=
          div_le_div_of_nonneg_right hB₀_le_B₁ (le_of_lt hlogw_pos)
        have hw_re' : 1 - B₁ / Real.log (4 + |w.im|) ≤ w.re := by linarith
        exact h_s3 w (le_of_lt hw_im) hw_re'
  obtain ⟨C₃, hC₃_pos, h_s4⟩ :=
    mitsui_riemannZeta_logDeriv_bound_of_zeroFree_of_four_le_im B₀ hB₀_pos hB₀_le h_zf
  let B : ℝ := B₀ / 8
  let C : ℝ := C₁ / Real.log 4 + C₂ / Real.log 4 + C₃
  have hB_pos : 0 < B := by dsimp [B]; positivity
  have hB_le : B ≤ 1 / 2 := by dsimp [B]; linarith
  have hC_pos : 0 < C := by dsimp [C]; positivity
  refine ⟨B, C, hB_pos, hB_le, hC_pos, ?_⟩
  intro s hs_ne hs_re
  have h4_le : (4 : ℝ) ≤ 4 + |s.im| := by linarith [abs_nonneg s.im]
  have hlogs_ge : Real.log 4 ≤ Real.log (4 + |s.im|) := Real.log_le_log (by norm_num) h4_le
  have hlogs_pos : 0 < Real.log (4 + |s.im|) := lt_of_lt_of_le hlog4_pos hlogs_ge
  have hB_le_B₀ : B ≤ B₀ := by dsimp [B]; linarith
  have h_div_B₀ : B / Real.log (4 + |s.im|) ≤ B₀ / Real.log (4 + |s.im|) :=
    div_le_div_of_nonneg_right hB_le_B₀ (le_of_lt hlogs_pos)
  have hs_re_B₀ : 1 - B₀ / Real.log (4 + |s.im|) ≤ s.re := by linarith
  refine ⟨h_zf s hs_ne hs_re_B₀, ?_⟩
  rcases le_or_gt 2 s.re with hs2 | hs2
  · have h1 : ‖-deriv riemannZeta s / riemannZeta s - 1 / (s - 1)‖ ≤ C₁ := (h_s1 s hs2).2
    have h2 : C₁ = (C₁ / Real.log 4) * Real.log 4 :=
      (div_mul_cancel₀ C₁ (ne_of_gt hlog4_pos)).symm
    have h3 : (C₁ / Real.log 4) * Real.log 4 ≤ (C₁ / Real.log 4) * Real.log (4 + |s.im|) :=
      mul_le_mul_of_nonneg_left hlogs_ge (by positivity)
    have hC1_le_C : C₁ / Real.log 4 ≤ C := by
      have : 0 ≤ C₂ / Real.log 4 + C₃ := by positivity
      dsimp [C]; linarith
    have h4 : (C₁ / Real.log 4) * Real.log (4 + |s.im|) ≤ C * Real.log (4 + |s.im|) :=
      mul_le_mul_of_nonneg_right hC1_le_C (le_of_lt hlogs_pos)
    linarith
  · rcases le_or_gt |s.im| 4 with hs_im | hs_im
    · have h_div1 : B₀ / Real.log (4 + |s.im|) ≤ B₀ / Real.log 4 :=
        div_le_div_of_nonneg_left (le_of_lt hB₀_pos) hlog4_pos hlogs_ge
      have h_div2 : B₀ / Real.log 4 ≤ (δ₀ * Real.log 4) / Real.log 4 :=
        div_le_div_of_nonneg_right hB₀_le_δ₀ (le_of_lt hlog4_pos)
      have h_eq : (δ₀ * Real.log 4) / Real.log 4 = δ₀ :=
        mul_div_cancel_right₀ δ₀ (ne_of_gt hlog4_pos)
      have hs_re_δ₀ : 1 - δ₀ ≤ s.re := by linarith
      have h1 : ‖-deriv riemannZeta s / riemannZeta s - 1 / (s - 1)‖ ≤ C₂ :=
        (h_s2 s hs_ne hs_im hs_re_δ₀ (le_of_lt hs2)).2
      have h2 : C₂ = (C₂ / Real.log 4) * Real.log 4 :=
        (div_mul_cancel₀ C₂ (ne_of_gt hlog4_pos)).symm
      have h3 : (C₂ / Real.log 4) * Real.log 4 ≤ (C₂ / Real.log 4) * Real.log (4 + |s.im|) :=
        mul_le_mul_of_nonneg_left hlogs_ge (by positivity)
      have hC2_le_C : C₂ / Real.log 4 ≤ C := by
        have : 0 ≤ C₁ / Real.log 4 + C₃ := by positivity
        dsimp [C]; linarith
      have h4 : (C₂ / Real.log 4) * Real.log (4 + |s.im|) ≤ C * Real.log (4 + |s.im|) :=
        mul_le_mul_of_nonneg_right hC2_le_C (le_of_lt hlogs_pos)
      linarith
    · have h1 : ‖-deriv riemannZeta s / riemannZeta s - 1 / (s - 1)‖ ≤ C₃ * Real.log (4 + |s.im|) :=
        h_s4 s (le_of_lt hs_im) hs_re (le_of_lt hs2)
      have hC3_le_C : C₃ ≤ C := by
        have : 0 ≤ C₁ / Real.log 4 + C₂ / Real.log 4 := by positivity
        dsimp [C]; linarith
      have h2 : C₃ * Real.log (4 + |s.im|) ≤ C * Real.log (4 + |s.im|) :=
        mul_le_mul_of_nonneg_right hC3_le_C (le_of_lt hlogs_pos)
      linarith

theorem mitsui_riemannZeta_logDeriv_sub_pole_extension (B C : ℝ) (hB_pos : 0 < B) (hB_le : B ≤ 1 / 2) (hC_pos : 0 < C)
    (h_dlvp : ∀ s : ℂ, s ≠ 1 → 1 - B / Real.log (4 + |s.im|) ≤ s.re →
      riemannZeta s ≠ 0 ∧
      ‖-deriv riemannZeta s / riemannZeta s - 1 / (s - 1)‖ ≤ C * Real.log (4 + |s.im|)) :
    ∃ D : ℂ → ℂ,
      (∀ s : ℂ, s ≠ 1 → D s = -deriv riemannZeta s / riemannZeta s - 1 / (s - 1)) ∧
      (∀ s : ℂ, 1 - B / Real.log (4 + |s.im|) ≤ s.re →
        DifferentiableAt ℂ D s ∧
        ‖D s‖ ≤ C * Real.log (4 + |s.im|)) :=
by
  let f : ℂ → ℂ := fun s => -deriv riemannZeta s / riemannZeta s - 1 / (s - 1)
  let D : ℂ → ℂ := Function.update f 1 (limUnder (nhdsWithin 1 {1}ᶜ) f)
  have hD_ne : ∀ z : ℂ, z ≠ 1 → D z = f z := by
    intro z hz
    exact Function.update_of_ne hz (limUnder (nhdsWithin 1 {1}ᶜ) f) f
  have hD_ev : ∀ z : ℂ, z ≠ 1 → D =ᶠ[nhds z] f := by
    intro z hz
    have h_open : IsOpen ({1}ᶜ : Set ℂ) := isOpen_compl_singleton
    have h_mem : ({1}ᶜ : Set ℂ) ∈ nhds z := h_open.mem_nhds hz
    exact Filter.eventuallyEq_of_mem h_mem (fun w hw => hD_ne w hw)
  have h_diffOn_zeta : DifferentiableOn ℂ riemannZeta {1}ᶜ := by
    intro z hz
    exact (differentiableAt_riemannZeta hz).differentiableWithinAt
  have h_diffOn_deriv_zeta : DifferentiableOn ℂ (deriv riemannZeta) {1}ᶜ :=
    h_diffOn_zeta.deriv isOpen_compl_singleton
  have hf_diff : ∀ z : ℂ, z ≠ 1 → riemannZeta z ≠ 0 → DifferentiableAt ℂ f z := by
    intro z hz hζ
    have h_zeta : DifferentiableAt ℂ riemannZeta z := differentiableAt_riemannZeta hz
    have h_deriv_zeta : DifferentiableAt ℂ (deriv riemannZeta) z :=
      h_diffOn_deriv_zeta.differentiableAt (isOpen_compl_singleton.mem_nhds hz)
    have h_term1 : DifferentiableAt ℂ (fun w => -deriv riemannZeta w / riemannZeta w) z :=
      h_deriv_zeta.neg.div h_zeta hζ
    have h_term2 : DifferentiableAt ℂ (fun w => 1 / (w - 1)) z :=
      (differentiableAt_const (1 : ℂ)).div
        (differentiableAt_id.sub (differentiableAt_const (1 : ℂ)))
        (sub_ne_zero.mpr hz)
    exact h_term1.sub h_term2
  have hlog5_pos : 0 < Real.log 5 := Real.log_pos (by norm_num)
  let r : ℝ := min (B / Real.log 5) 1
  have hr_pos : 0 < r := lt_min (div_pos hB_pos hlog5_pos) zero_lt_one
  let V : Set ℂ := Metric.ball (1 : ℂ) r
  have hV_nhds : V ∈ nhds (1 : ℂ) := Metric.ball_mem_nhds (1 : ℂ) hr_pos
  have hV_dlvp : ∀ z ∈ V \ {(1 : ℂ)},
      z ≠ 1 ∧ 1 - B / Real.log (4 + |z.im|) ≤ z.re ∧ Real.log (4 + |z.im|) ≤ Real.log 5 := by
    intro z hz
    have hz_ball : z ∈ V := hz.1
    have hz_ne : z ≠ 1 := hz.2
    rw [Metric.mem_ball, dist_eq_norm] at hz_ball
    have hr_le_B : r ≤ B / Real.log 5 := min_le_left _ _
    have hr_le_one : r ≤ 1 := min_le_right _ _
    have him_eq : (z - 1).im = z.im := by
      rw [Complex.sub_im, Complex.one_im, sub_zero]
    have him_le_norm : |z.im| ≤ ‖z - 1‖ := by
      rw [← him_eq]
      exact Complex.abs_im_le_norm (z - 1)
    have him_le_one : |z.im| ≤ 1 := by linarith
    have him_nonneg : 0 ≤ |z.im| := abs_nonneg z.im
    have h4_gt_one : 1 < 4 + |z.im| := by linarith
    have h4_pos : 0 < 4 + |z.im| := by linarith
    have h4_le_five : 4 + |z.im| ≤ 5 := by linarith
    have hlog_pos : 0 < Real.log (4 + |z.im|) := Real.log_pos h4_gt_one
    have hlog_le : Real.log (4 + |z.im|) ≤ Real.log 5 := Real.log_le_log h4_pos h4_le_five
    have hB_div_le : B / Real.log 5 ≤ B / Real.log (4 + |z.im|) :=
      div_le_div_of_nonneg_left (le_of_lt hB_pos) hlog_pos hlog_le
    have hre_sub : 1 - z.re ≤ |(z - 1).re| := by
      have h1 : -(z - 1).re ≤ |(z - 1).re| := neg_le_abs _
      have h2 : -(z - 1).re = 1 - z.re := by
        rw [Complex.sub_re, Complex.one_re]
        ring
      linarith
    have hre_le_norm : |(z - 1).re| ≤ ‖z - 1‖ := Complex.abs_re_le_norm (z - 1)
    have hre_bound : 1 - B / Real.log (4 + |z.im|) ≤ z.re := by linarith
    exact ⟨hz_ne, hre_bound, hlog_le⟩
  have hf_diffOn : DifferentiableOn ℂ f (V \ {(1 : ℂ)}) := by
    intro z hz
    obtain ⟨hz_ne, hre_bound, _⟩ := hV_dlvp z hz
    have hζ : riemannZeta z ≠ 0 := (h_dlvp z hz_ne hre_bound).1
    exact (hf_diff z hz_ne hζ).differentiableWithinAt
  have hf_bdd : BddAbove (norm ∘ f '' (V \ {(1 : ℂ)})) := by
    refine ⟨C * Real.log 5, ?_⟩
    rintro _ ⟨z, hz, rfl⟩
    obtain ⟨hz_ne, hre_bound, hlog_le⟩ := hV_dlvp z hz
    have h_norm : ‖f z‖ ≤ C * Real.log (4 + |z.im|) := (h_dlvp z hz_ne hre_bound).2
    have h_C_mul : C * Real.log (4 + |z.im|) ≤ C * Real.log 5 :=
      mul_le_mul_of_nonneg_left hlog_le (le_of_lt hC_pos)
    dsimp [Function.comp]
    linarith
  have hD_diffOn_V : DifferentiableOn ℂ D V :=
    Complex.differentiableOn_update_limUnder_of_bddAbove hV_nhds hf_diffOn hf_bdd
  have hD_diff_one : DifferentiableAt ℂ D 1 :=
    hD_diffOn_V.differentiableAt hV_nhds
  let x : ℕ → ℝ := fun n => 1 / ((n : ℝ) + 1)
  let s_seq : ℕ → ℂ := fun n => 1 + (x n : ℂ)
  have hD_seq_bound : ∀ n : ℕ, ‖D (s_seq n)‖ ≤ C * Real.log (4 + |(1 : ℂ).im|) := by
    intro n
    have hx_pos : 0 < x n := by dsimp [x]; positivity
    have hs_re : (s_seq n).re = 1 + x n := rfl
    have hs_im : (s_seq n).im = 0 := by simp [s_seq]
    have hs_ne : s_seq n ≠ 1 := by
      intro h_eq
      have h_re_eq := congrArg Complex.re h_eq
      rw [hs_re, Complex.one_re] at h_re_eq
      linarith
    have hlog4_pos : 0 < Real.log (4 + |(s_seq n).im|) := by
      rw [hs_im, abs_zero, add_zero]
      exact Real.log_pos (by norm_num)
    have hB_div_pos : 0 < B / Real.log (4 + |(s_seq n).im|) := div_pos hB_pos hlog4_pos
    have hs_dlvp_re : 1 - B / Real.log (4 + |(s_seq n).im|) ≤ (s_seq n).re := by
      rw [hs_re]
      linarith
    have h_norm := (h_dlvp (s_seq n) hs_ne hs_dlvp_re).2
    rw [hD_ne (s_seq n) hs_ne]
    have him_eq : (s_seq n).im = (1 : ℂ).im := by
      rw [hs_im, Complex.one_im]
    rwa [him_eq] at h_norm
  have hx_tendsto : Filter.Tendsto x Filter.atTop (nhds (0 : ℝ)) :=
    tendsto_one_div_add_atTop_nhds_zero_nat
  have hxC_tendsto : Filter.Tendsto (fun n : ℕ => (x n : ℂ)) Filter.atTop (nhds (0 : ℂ)) := by
    have h_cont := (Complex.continuous_ofReal.tendsto (0 : ℝ)).comp hx_tendsto
    rwa [Complex.ofReal_zero] at h_cont
  have hs_tendsto : Filter.Tendsto s_seq Filter.atTop (nhds (1 : ℂ)) := by
    have h_add := (tendsto_const_nhds (x := (1 : ℂ))).add hxC_tendsto
    rwa [add_zero (1 : ℂ)] at h_add
  have hD_tendsto : Filter.Tendsto (fun n : ℕ => ‖D (s_seq n)‖) Filter.atTop (nhds ‖D 1‖) :=
    (hD_diff_one.continuousAt.tendsto.comp hs_tendsto).norm
  have hD_norm_one : ‖D 1‖ ≤ C * Real.log (4 + |(1 : ℂ).im|) :=
    le_of_tendsto' hD_tendsto hD_seq_bound
  refine ⟨D, hD_ne, ?_⟩
  intro s h_re
  by_cases hs : s = 1
  · subst hs
    exact ⟨hD_diff_one, hD_norm_one⟩
  · obtain ⟨hζ, h_bound⟩ := h_dlvp s hs h_re
    have hD_diff_s : DifferentiableAt ℂ D s :=
      (hf_diff s hs hζ).congr_of_eventuallyEq (hD_ev s hs)
    have hD_norm_s : ‖D s‖ ≤ C * Real.log (4 + |s.im|) := by
      rw [hD_ne s hs]
      exact h_bound
    exact ⟨hD_diff_s, hD_norm_s⟩

theorem mitsui_riesz_vertical_integral_eq_add_pole_integral (B C : ℝ) (D : ℂ → ℂ) (hB_pos : 0 < B) (hB_le : B ≤ 1 / 2) (hC_pos : 0 < C)
    (hD_eq : ∀ s : ℂ, s ≠ 1 → D s = -deriv riemannZeta s / riemannZeta s - 1 / (s - 1))
    (hD_dlvp : ∀ s : ℂ, 1 - B / Real.log (4 + |s.im|) ≤ s.re →
      DifferentiableAt ℂ D s ∧
      ‖D s‖ ≤ C * Real.log (4 + |s.im|))
    (Y : ℝ) (hY : 1 < Y) :
    (1 / (2 * Real.pi)) *
        (∫ t : ℝ,
          ((Y : ℂ) ^ (2 + (t : ℂ) * Complex.I) / (2 + (t : ℂ) * Complex.I) ^ 2) *
            (-deriv riemannZeta (2 + (t : ℂ) * Complex.I) /
              riemannZeta (2 + (t : ℂ) * Complex.I))).re =
      (1 / (2 * Real.pi)) *
        (∫ t : ℝ,
          ((Y : ℂ) ^ (2 + (t : ℂ) * Complex.I) / (2 + (t : ℂ) * Complex.I) ^ 2) *
            D (2 + (t : ℂ) * Complex.I)).re +
      (1 / (2 * Real.pi)) *
        (∫ t : ℝ,
          ((Y : ℂ) ^ (2 + (t : ℂ) * Complex.I) / (2 + (t : ℂ) * Complex.I) ^ 2) *
            (1 / ((2 + (t : ℂ) * Complex.I) - 1))).re :=
by
  have hY_pos : 0 < Y := by linarith
  have hY_ne : (Y : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt hY_pos
  set s : ℝ → ℂ := fun t => 2 + (t : ℂ) * Complex.I
  set K : ℝ → ℂ := fun t => (Y : ℂ) ^ (s t) / (s t) ^ 2
  set F_zeta : ℝ → ℂ := fun t => K t * (-deriv riemannZeta (s t) / riemannZeta (s t))
  set F_D : ℝ → ℂ := fun t => K t * D (s t)
  set F_pole : ℝ → ℂ := fun t => K t * (1 / (s t - 1))
  have hs_re : ∀ t : ℝ, (s t).re = 2 := by
    intro t
    simp [s]
  have hs_im : ∀ t : ℝ, (s t).im = t := by
    intro t
    simp [s]
  have hs_ne_one : ∀ t : ℝ, s t ≠ 1 := by
    intro t h
    have hre := congr_arg Complex.re h
    rw [hs_re t, Complex.one_re] at hre
    norm_num at hre
  have h_pw_eq : ∀ t : ℝ, F_zeta t = F_D t + F_pole t := by
    intro t
    have hD := hD_eq (s t) (hs_ne_one t)
    dsimp [F_zeta, F_D, F_pole]
    rw [hD]
    ring
  have hs_normSq : ∀ t : ℝ, Complex.normSq (s t) = 4 + t ^ 2 := by
    intro t
    rw [Complex.normSq_apply, hs_re t, hs_im t]
    ring
  have hs_sq_norm : ∀ t : ℝ, ‖(s t) ^ 2‖ = 4 + t ^ 2 := by
    intro t
    rw [norm_pow, Complex.sq_norm, hs_normSq t]
  have hs_sq_ne : ∀ t : ℝ, (s t) ^ 2 ≠ 0 := by
    intro t
    rw [← norm_ne_zero_iff, hs_sq_norm t]
    positivity
  have hs_sub_one_normSq : ∀ t : ℝ, Complex.normSq (s t - 1) = 1 + t ^ 2 := by
    intro t
    rw [Complex.normSq_apply, Complex.sub_re, Complex.sub_im, hs_re t, hs_im t,
      Complex.one_re, Complex.one_im]
    ring
  have hs_sub_one_norm_ge_one : ∀ t : ℝ, 1 ≤ ‖s t - 1‖ := by
    intro t
    rw [Complex.norm_def, hs_sub_one_normSq t]
    have h1 : (1 : ℝ) ≤ 1 + t ^ 2 := by
      have : 0 ≤ t ^ 2 := sq_nonneg t
      linarith
    have h2 := Real.sqrt_le_sqrt h1
    rwa [Real.sqrt_one] at h2
  have hs_sub_one_ne : ∀ t : ℝ, s t - 1 ≠ 0 := by
    intro t
    rw [← norm_ne_zero_iff]
    have h := hs_sub_one_norm_ge_one t
    linarith
  have hK_norm : ∀ t : ℝ, ‖K t‖ = Y ^ 2 / (4 + t ^ 2) := by
    intro t
    dsimp [K]
    rw [norm_div, Complex.norm_cpow_eq_rpow_re_of_pos hY_pos (s t), hs_re t,
      Real.rpow_two, hs_sq_norm t]
  have hs_cont : Continuous s := by
    dsimp [s]
    fun_prop
  have hK_cont : Continuous K := by
    have h_cpow_eq : (fun t : ℝ => (Y : ℂ) ^ (s t)) =
        (fun t : ℝ => Complex.exp (Complex.log (Y : ℂ) * s t)) := by
      ext t
      rw [Complex.cpow_def_of_ne_zero hY_ne]
    have h_cpow_cont : Continuous (fun t : ℝ => (Y : ℂ) ^ (s t)) := by
      rw [h_cpow_eq]
      exact Continuous.cexp (continuous_const.mul hs_cont)
    exact h_cpow_cont.div (hs_cont.pow 2) hs_sq_ne
  
  have hF_pole_cont : Continuous F_pole := by
    dsimp [F_pole]
    refine hK_cont.mul ?_
    exact continuous_const.div (hs_cont.sub continuous_const) hs_sub_one_ne
  have hF_pole_bound : ∀ t : ℝ, ‖F_pole t‖ ≤ Y ^ 2 * (1 + t ^ 2)⁻¹ := by
    intro t
    dsimp [F_pole]
    rw [norm_mul, hK_norm t, norm_div, norm_one]
    have h_inv_le_one : 1 / ‖s t - 1‖ ≤ 1 := by
      rw [one_div]
      exact inv_le_one_of_one_le₀ (hs_sub_one_norm_ge_one t)
    have h_denom : (4 + t ^ 2)⁻¹ ≤ (1 + t ^ 2)⁻¹ := by
      exact inv_anti₀ (by positivity) (by linarith)
    calc (Y ^ 2 / (4 + t ^ 2)) * (1 / ‖s t - 1‖)
      _ ≤ (Y ^ 2 / (4 + t ^ 2)) * 1 :=
          mul_le_mul_of_nonneg_left h_inv_le_one (by positivity)
      _ = Y ^ 2 * (4 + t ^ 2)⁻¹ := by ring
      _ ≤ Y ^ 2 * (1 + t ^ 2)⁻¹ :=
          mul_le_mul_of_nonneg_left h_denom (by positivity)
  have hInt_pole : MeasureTheory.Integrable F_pole MeasureTheory.volume :=
    MeasureTheory.Integrable.mono'
      (integrable_inv_one_add_sq.const_mul (Y ^ 2))
      hF_pole_cont.aestronglyMeasurable
      (Filter.Eventually.of_forall hF_pole_bound)
  
  set g : ℝ → ℝ := fun t => (4 + |t|) ^ (-3 / 2 : ℝ)
  have hg_Ioi : MeasureTheory.IntegrableOn g (Set.Ioi (0 : ℝ)) MeasureTheory.volume := by
    have h0 : MeasureTheory.IntegrableOn (fun x : ℝ => (x + 4) ^ (-3 / 2 : ℝ)) (Set.Ioi (0 : ℝ)) MeasureTheory.volume :=
      integrableOn_add_rpow_Ioi_of_lt (by norm_num) (by norm_num)
    refine h0.congr_fun (fun x hx => ?_) measurableSet_Ioi
    have hx_pos : 0 < x := Set.mem_Ioi.mp hx
    dsimp [g]
    rw [abs_of_pos hx_pos, add_comm]
  have hg_Ici : MeasureTheory.IntegrableOn g (Set.Ici (0 : ℝ)) MeasureTheory.volume :=
    hg_Ioi.congr_set_ae MeasureTheory.Ioi_ae_eq_Ici.symm
  have hg_Iic : MeasureTheory.IntegrableOn g (Set.Iic (0 : ℝ)) MeasureTheory.volume := by
    have h_neg : MeasureTheory.IntegrableOn (fun x : ℝ => g (-x)) (Set.Iic (0 : ℝ)) MeasureTheory.volume := by
      have h_Ici_neg : MeasureTheory.IntegrableOn g (Set.Ici (-(0 : ℝ))) MeasureTheory.volume := by
        simpa using hg_Ici
      exact h_Ici_neg.comp_neg_Iic
    have h_eq : (fun x : ℝ => g (-x)) = g := by
      ext x
      dsimp [g]
      rw [abs_neg]
    rwa [h_eq] at h_neg
  have hg_int : MeasureTheory.Integrable g MeasureTheory.volume := by
    rw [← MeasureTheory.integrableOn_univ, ← Set.Iic_union_Ioi (a := (0 : ℝ))]
    exact hg_Iic.union hg_Ioi
  have hs_dlvp_cond : ∀ t : ℝ, 1 - B / Real.log (4 + |(s t).im|) ≤ (s t).re := by
    intro t
    rw [hs_re t, hs_im t]
    have h4_gt_one : 1 < 4 + |t| := by
      have : 0 ≤ |t| := abs_nonneg t
      linarith
    have hlog_pos : 0 < Real.log (4 + |t|) := Real.log_pos h4_gt_one
    have hdiv_pos : 0 < B / Real.log (4 + |t|) := div_pos hB_pos hlog_pos
    linarith
  have hD_cont : Continuous (fun t : ℝ => D (s t)) := by
    rw [continuous_iff_continuousAt]
    intro t
    have h_diff : DifferentiableAt ℂ D (s t) := (hD_dlvp (s t) (hs_dlvp_cond t)).1
    exact h_diff.continuousAt.comp hs_cont.continuousAt
  have hF_D_cont : Continuous F_D := hK_cont.mul hD_cont
  have hF_D_bound : ∀ t : ℝ, ‖F_D t‖ ≤ (10 * Y ^ 2 * C) * g t := by
    intro t
    dsimp [F_D, g]
    rw [norm_mul, hK_norm t]
    have hD_norm : ‖D (s t)‖ ≤ C * Real.log (4 + |t|) := by
      have h := (hD_dlvp (s t) (hs_dlvp_cond t)).2
      rwa [hs_im t] at h
    have h4t_pos : 0 < 4 + |t| := by positivity
    have h4t_gt_one : 1 < 4 + |t| := by
      have : 0 ≤ |t| := abs_nonneg t
      linarith
    set L : ℝ := Real.log (4 + |t|)
    have hL_pos : 0 < L := Real.log_pos h4t_gt_one
    have hexpL : Real.exp L = 4 + |t| := Real.exp_log h4t_pos
    have h_L_le : L ≤ 2 * Real.exp (L / 2) := by
      have h1 := Real.add_one_le_exp (L / 2)
      linarith
    have h_quad : (4 + |t|) ^ 2 ≤ 5 * (4 + t ^ 2) := by
      have h_nonneg : 0 ≤ 4 * (|t| - 1) ^ 2 := by positivity
      have h_id : 5 * (4 + t ^ 2) - (4 + |t|) ^ 2 = 4 * (|t| - 1) ^ 2 := by
        have h_sq : t ^ 2 = |t| ^ 2 := (sq_abs t).symm
        rw [h_sq]
        ring
      linarith
    have h_denom_pos : 0 < 4 + t ^ 2 := by positivity
    have h_inv_le : (4 + t ^ 2)⁻¹ ≤ 5 * Real.exp (-2 * L) := by
      have h_exp2L : (4 + |t|) ^ 2 = Real.exp (2 * L) := by
        rw [← hexpL, sq, ← Real.exp_add]
        congr 1
        ring
      have h_neg : Real.exp (-2 * L) = ((4 + |t|) ^ 2)⁻¹ := by
        rw [h_exp2L, show -2 * L = -(2 * L) by ring, Real.exp_neg]
      rw [h_neg, ← div_eq_mul_inv, inv_eq_one_div, div_le_div_iff₀ h_denom_pos (by positivity)]
      linarith
    have h_ratio_le : L / (4 + t ^ 2) ≤ 10 * (4 + |t|) ^ (-3 / 2 : ℝ) := by
      have h_rpow : (4 + |t|) ^ (-3 / 2 : ℝ) = Real.exp (L / 2) * Real.exp (-2 * L) := by
        rw [Real.rpow_def_of_pos h4t_pos, ← Real.exp_add]
        congr 1
        dsimp [L]
        ring
      calc L / (4 + t ^ 2)
        _ = L * (4 + t ^ 2)⁻¹ := div_eq_mul_inv _ _
        _ ≤ (2 * Real.exp (L / 2)) * (5 * Real.exp (-2 * L)) :=
            mul_le_mul h_L_le h_inv_le (by positivity) (by positivity)
        _ = 10 * (Real.exp (L / 2) * Real.exp (-2 * L)) := by ring
        _ = 10 * (4 + |t|) ^ (-3 / 2 : ℝ) := by rw [← h_rpow]
    calc (Y ^ 2 / (4 + t ^ 2)) * ‖D (s t)‖
      _ ≤ (Y ^ 2 / (4 + t ^ 2)) * (C * L) :=
          mul_le_mul_of_nonneg_left hD_norm (by positivity)
      _ = (Y ^ 2 * C) * (L / (4 + t ^ 2)) := by ring
      _ ≤ (Y ^ 2 * C) * (10 * (4 + |t|) ^ (-3 / 2 : ℝ)) :=
          mul_le_mul_of_nonneg_left h_ratio_le (by positivity)
      _ = (10 * Y ^ 2 * C) * (4 + |t|) ^ (-3 / 2 : ℝ) := by ring
  have hInt_D : MeasureTheory.Integrable F_D MeasureTheory.volume :=
    MeasureTheory.Integrable.mono'
      (hg_int.const_mul (10 * Y ^ 2 * C))
      hF_D_cont.aestronglyMeasurable
      (Filter.Eventually.of_forall hF_D_bound)
  
  have h_int_eq : (∫ t : ℝ, F_zeta t) = (∫ t : ℝ, F_D t) + (∫ t : ℝ, F_pole t) := by
    have h_fun : F_zeta = fun t => F_D t + F_pole t := funext h_pw_eq
    rw [h_fun, MeasureTheory.integral_add hInt_D hInt_pole]
  change (1 / (2 * Real.pi)) * (∫ t : ℝ, F_zeta t).re =
    (1 / (2 * Real.pi)) * (∫ t : ℝ, F_D t).re +
    (1 / (2 * Real.pi)) * (∫ t : ℝ, F_pole t).re
  rw [h_int_eq, Complex.add_re, mul_add]

theorem mitsui_riesz_poleFree_vertical_integrable (B C : ℝ) (D : ℂ → ℂ) (hB_pos : 0 < B) (hB_le : B ≤ 1 / 2) (hC_pos : 0 < C)
    (hD_dlvp : ∀ s : ℂ, 1 - B / Real.log (4 + |s.im|) ≤ s.re →
      DifferentiableAt ℂ D s ∧
      ‖D s‖ ≤ C * Real.log (4 + |s.im|))
    (Y : ℝ) (hY : 1 < Y) :
    MeasureTheory.Integrable
      (fun t : ℝ =>
        ((Y : ℂ) ^ (2 + (t : ℂ) * Complex.I) / (2 + (t : ℂ) * Complex.I) ^ 2) *
          D (2 + (t : ℂ) * Complex.I))
      MeasureTheory.volume :=
by
  have hY_pos : 0 < Y := by linarith
  have hY_ne : (Y : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt hY_pos
  set s : ℝ → ℂ := fun t => 2 + (t : ℂ) * Complex.I
  set K : ℝ → ℂ := fun t => (Y : ℂ) ^ (s t) / (s t) ^ 2
  set F_D : ℝ → ℂ := fun t => K t * D (s t)
  have hs_re : ∀ t : ℝ, (s t).re = 2 := by
    intro t
    simp [s]
  have hs_im : ∀ t : ℝ, (s t).im = t := by
    intro t
    simp [s]
  have hs_normSq : ∀ t : ℝ, Complex.normSq (s t) = 4 + t ^ 2 := by
    intro t
    rw [Complex.normSq_apply, hs_re t, hs_im t]
    ring
  have hs_sq_norm : ∀ t : ℝ, ‖(s t) ^ 2‖ = 4 + t ^ 2 := by
    intro t
    rw [norm_pow, Complex.sq_norm, hs_normSq t]
  have hs_sq_ne : ∀ t : ℝ, (s t) ^ 2 ≠ 0 := by
    intro t
    rw [← norm_ne_zero_iff, hs_sq_norm t]
    positivity
  have hK_norm : ∀ t : ℝ, ‖K t‖ = Y ^ 2 / (4 + t ^ 2) := by
    intro t
    dsimp [K]
    rw [norm_div, Complex.norm_cpow_eq_rpow_re_of_pos hY_pos (s t), hs_re t,
      Real.rpow_two, hs_sq_norm t]
  have hs_cont : Continuous s := by
    dsimp [s]
    fun_prop
  have hK_cont : Continuous K := by
    have h_cpow_eq : (fun t : ℝ => (Y : ℂ) ^ (s t)) =
        (fun t : ℝ => Complex.exp (Complex.log (Y : ℂ) * s t)) := by
      ext t
      rw [Complex.cpow_def_of_ne_zero hY_ne]
    have h_cpow_cont : Continuous (fun t : ℝ => (Y : ℂ) ^ (s t)) := by
      rw [h_cpow_eq]
      exact Continuous.cexp (continuous_const.mul hs_cont)
    exact h_cpow_cont.div (hs_cont.pow 2) hs_sq_ne
  set g : ℝ → ℝ := fun t => (4 + |t|) ^ (-3 / 2 : ℝ)
  have hg_Ioi : MeasureTheory.IntegrableOn g (Set.Ioi (0 : ℝ)) MeasureTheory.volume := by
    have h0 : MeasureTheory.IntegrableOn (fun x : ℝ => (x + 4) ^ (-3 / 2 : ℝ)) (Set.Ioi (0 : ℝ)) MeasureTheory.volume :=
      integrableOn_add_rpow_Ioi_of_lt (by norm_num) (by norm_num)
    refine h0.congr_fun (fun x hx => ?_) measurableSet_Ioi
    have hx_pos : 0 < x := Set.mem_Ioi.mp hx
    dsimp [g]
    rw [abs_of_pos hx_pos, add_comm]
  have hg_Ici : MeasureTheory.IntegrableOn g (Set.Ici (0 : ℝ)) MeasureTheory.volume :=
    hg_Ioi.congr_set_ae MeasureTheory.Ioi_ae_eq_Ici.symm
  have hg_Iic : MeasureTheory.IntegrableOn g (Set.Iic (0 : ℝ)) MeasureTheory.volume := by
    have h_neg : MeasureTheory.IntegrableOn (fun x : ℝ => g (-x)) (Set.Iic (0 : ℝ)) MeasureTheory.volume := by
      have h_Ici_neg : MeasureTheory.IntegrableOn g (Set.Ici (-(0 : ℝ))) MeasureTheory.volume := by
        simpa using hg_Ici
      exact h_Ici_neg.comp_neg_Iic
    have h_eq : (fun x : ℝ => g (-x)) = g := by
      ext x
      dsimp [g]
      rw [abs_neg]
    rwa [h_eq] at h_neg
  have hg_int : MeasureTheory.Integrable g MeasureTheory.volume := by
    rw [← MeasureTheory.integrableOn_univ, ← Set.Iic_union_Ioi (a := (0 : ℝ))]
    exact hg_Iic.union hg_Ioi
  have hs_dlvp_cond : ∀ t : ℝ, 1 - B / Real.log (4 + |(s t).im|) ≤ (s t).re := by
    intro t
    rw [hs_re t, hs_im t]
    have h4_gt_one : 1 < 4 + |t| := by
      have : 0 ≤ |t| := abs_nonneg t
      linarith
    have hlog_pos : 0 < Real.log (4 + |t|) := Real.log_pos h4_gt_one
    have hdiv_pos : 0 < B / Real.log (4 + |t|) := div_pos hB_pos hlog_pos
    linarith
  have hD_cont : Continuous (fun t : ℝ => D (s t)) := by
    rw [continuous_iff_continuousAt]
    intro t
    have h_diff : DifferentiableAt ℂ D (s t) := (hD_dlvp (s t) (hs_dlvp_cond t)).1
    exact h_diff.continuousAt.comp hs_cont.continuousAt
  have hF_D_cont : Continuous F_D := hK_cont.mul hD_cont
  have hF_D_bound : ∀ t : ℝ, ‖F_D t‖ ≤ (10 * Y ^ 2 * C) * g t := by
    intro t
    dsimp [F_D, g]
    rw [norm_mul, hK_norm t]
    have hD_norm : ‖D (s t)‖ ≤ C * Real.log (4 + |t|) := by
      have h := (hD_dlvp (s t) (hs_dlvp_cond t)).2
      rwa [hs_im t] at h
    have h4t_pos : 0 < 4 + |t| := by positivity
    have h4t_gt_one : 1 < 4 + |t| := by
      have : 0 ≤ |t| := abs_nonneg t
      linarith
    set L : ℝ := Real.log (4 + |t|)
    have hL_pos : 0 < L := Real.log_pos h4t_gt_one
    have hexpL : Real.exp L = 4 + |t| := Real.exp_log h4t_pos
    have h_L_le : L ≤ 2 * Real.exp (L / 2) := by
      have h1 := Real.add_one_le_exp (L / 2)
      linarith
    have h_quad : (4 + |t|) ^ 2 ≤ 5 * (4 + t ^ 2) := by
      have h_nonneg : 0 ≤ 4 * (|t| - 1) ^ 2 := by positivity
      have h_id : 5 * (4 + t ^ 2) - (4 + |t|) ^ 2 = 4 * (|t| - 1) ^ 2 := by
        have h_sq : t ^ 2 = |t| ^ 2 := (sq_abs t).symm
        rw [h_sq]
        ring
      linarith
    have h_denom_pos : 0 < 4 + t ^ 2 := by positivity
    have h_inv_le : (4 + t ^ 2)⁻¹ ≤ 5 * Real.exp (-2 * L) := by
      have h_exp2L : (4 + |t|) ^ 2 = Real.exp (2 * L) := by
        rw [← hexpL, sq, ← Real.exp_add]
        congr 1
        ring
      have h_neg : Real.exp (-2 * L) = ((4 + |t|) ^ 2)⁻¹ := by
        rw [h_exp2L, show -2 * L = -(2 * L) by ring, Real.exp_neg]
      rw [h_neg, ← div_eq_mul_inv, inv_eq_one_div, div_le_div_iff₀ h_denom_pos (by positivity)]
      linarith
    have h_ratio_le : L / (4 + t ^ 2) ≤ 10 * (4 + |t|) ^ (-3 / 2 : ℝ) := by
      have h_rpow : (4 + |t|) ^ (-3 / 2 : ℝ) = Real.exp (L / 2) * Real.exp (-2 * L) := by
        rw [Real.rpow_def_of_pos h4t_pos, ← Real.exp_add]
        congr 1
        dsimp [L]
        ring
      calc L / (4 + t ^ 2)
        _ = L * (4 + t ^ 2)⁻¹ := div_eq_mul_inv _ _
        _ ≤ (2 * Real.exp (L / 2)) * (5 * Real.exp (-2 * L)) :=
            mul_le_mul h_L_le h_inv_le (by positivity) (by positivity)
        _ = 10 * (Real.exp (L / 2) * Real.exp (-2 * L)) := by ring
        _ = 10 * (4 + |t|) ^ (-3 / 2 : ℝ) := by rw [← h_rpow]
    calc (Y ^ 2 / (4 + t ^ 2)) * ‖D (s t)‖
      _ ≤ (Y ^ 2 / (4 + t ^ 2)) * (C * L) :=
          mul_le_mul_of_nonneg_left hD_norm (by positivity)
      _ = (Y ^ 2 * C) * (L / (4 + t ^ 2)) := by ring
      _ ≤ (Y ^ 2 * C) * (10 * (4 + |t|) ^ (-3 / 2 : ℝ)) :=
          mul_le_mul_of_nonneg_left h_ratio_le (by positivity)
      _ = (10 * Y ^ 2 * C) * (4 + |t|) ^ (-3 / 2 : ℝ) := by ring
  exact MeasureTheory.Integrable.mono'
    (hg_int.const_mul (10 * Y ^ 2 * C))
    hF_D_cont.aestronglyMeasurable
    (Filter.Eventually.of_forall hF_D_bound)

theorem mitsui_riesz_poleFree_boundary_integrable (B : ℝ) (hB_pos : 0 < B) (Y : ℝ) (hY : 1 < Y) :
    MeasureTheory.Integrable
      (fun t : ℝ => Y ^ (1 - B / Real.log (4 + |t|)) * (Real.log (4 + |t|) / (1 / 4 + t ^ 2)))
      MeasureTheory.volume :=
by
  have hY_pos : 0 < Y := by linarith
  set f : ℝ → ℝ := fun t =>
    Y ^ (1 - B / Real.log (4 + |t|)) * (Real.log (4 + |t|) / (1 / 4 + t ^ 2))
  set g : ℝ → ℝ := fun t => (4 + |t|) ^ (-3 / 2 : ℝ)
  have hg_Ioi : MeasureTheory.IntegrableOn g (Set.Ioi (0 : ℝ)) MeasureTheory.volume := by
    have h0 : MeasureTheory.IntegrableOn (fun x : ℝ => (x + 4) ^ (-3 / 2 : ℝ)) (Set.Ioi (0 : ℝ)) MeasureTheory.volume :=
      integrableOn_add_rpow_Ioi_of_lt (by norm_num) (by norm_num)
    refine h0.congr_fun (fun x hx => ?_) measurableSet_Ioi
    have hx_pos : 0 < x := Set.mem_Ioi.mp hx
    dsimp [g]
    rw [abs_of_pos hx_pos, add_comm]
  have hg_Ici : MeasureTheory.IntegrableOn g (Set.Ici (0 : ℝ)) MeasureTheory.volume :=
    hg_Ioi.congr_set_ae MeasureTheory.Ioi_ae_eq_Ici.symm
  have hg_Iic : MeasureTheory.IntegrableOn g (Set.Iic (0 : ℝ)) MeasureTheory.volume := by
    have h_neg : MeasureTheory.IntegrableOn (fun x : ℝ => g (-x)) (Set.Iic (0 : ℝ)) MeasureTheory.volume := by
      have h_Ici_neg : MeasureTheory.IntegrableOn g (Set.Ici (-(0 : ℝ))) MeasureTheory.volume := by
        simpa using hg_Ici
      exact h_Ici_neg.comp_neg_Iic
    have h_eq : (fun x : ℝ => g (-x)) = g := by
      ext x
      dsimp [g]
      rw [abs_neg]
    rwa [h_eq] at h_neg
  have hg_int : MeasureTheory.Integrable g MeasureTheory.volume := by
    rw [← MeasureTheory.integrableOn_univ, ← Set.Iic_union_Ioi (a := (0 : ℝ))]
    exact hg_Iic.union hg_Ioi
  have h4t_gt_one : ∀ t : ℝ, 1 < 4 + |t| := by
    intro t
    have : 0 ≤ |t| := abs_nonneg t
    linarith
  have h4t_pos : ∀ t : ℝ, 0 < 4 + |t| := by
    intro t
    have := h4t_gt_one t
    linarith
  have h4t_ne : ∀ t : ℝ, 4 + |t| ≠ 0 := fun t => ne_of_gt (h4t_pos t)
  have hlog_pos : ∀ t : ℝ, 0 < Real.log (4 + |t|) := fun t => Real.log_pos (h4t_gt_one t)
  have hlog_ne : ∀ t : ℝ, Real.log (4 + |t|) ≠ 0 := fun t => ne_of_gt (hlog_pos t)
  have hdenom_pos : ∀ t : ℝ, 0 < 1 / 4 + t ^ 2 := fun t => by positivity
  have hdenom_ne : ∀ t : ℝ, 1 / 4 + t ^ 2 ≠ 0 := fun t => ne_of_gt (hdenom_pos t)
  have hf_nonneg : ∀ t : ℝ, 0 ≤ f t := by
    intro t
    dsimp [f]
    have := hlog_pos t
    positivity
  have hf_cont : Continuous f := by
    have h_log_cont : Continuous (fun t : ℝ => Real.log (4 + |t|)) :=
      (continuous_const.add continuous_abs).log h4t_ne
    have h_exp_cont : Continuous (fun t : ℝ => 1 - B / Real.log (4 + |t|)) :=
      continuous_const.sub (continuous_const.div h_log_cont hlog_ne)
    have h_rpow_cont : Continuous (fun t : ℝ => Y ^ (1 - B / Real.log (4 + |t|))) :=
      continuous_const.rpow h_exp_cont (fun _ => Or.inl (ne_of_gt hY_pos))
    have h_frac_cont : Continuous (fun t : ℝ => Real.log (4 + |t|) / (1 / 4 + t ^ 2)) :=
      h_log_cont.div (continuous_const.add (continuous_pow 2)) hdenom_ne
    exact h_rpow_cont.mul h_frac_cont
  have hf_bound : ∀ t : ℝ, ‖f t‖ ≤ (160 * Y) * g t := by
    intro t
    rw [Real.norm_of_nonneg (hf_nonneg t)]
    dsimp [f, g]
    set L : ℝ := Real.log (4 + |t|)
    have hL_pos : 0 < L := hlog_pos t
    have hexpL : Real.exp L = 4 + |t| := Real.exp_log (h4t_pos t)
    have h_factor1 : Y ^ (1 - B / L) ≤ Y := by
      calc Y ^ (1 - B / L) ≤ Y ^ (1 : ℝ) := by
            refine Real.rpow_le_rpow_of_exponent_le (le_of_lt hY) ?_
            have : 0 ≤ B / L := by positivity
            linarith
        _ = Y := Real.rpow_one Y
    have h_L_le : L ≤ 2 * Real.exp (L / 2) := by
      have h1 := Real.add_one_le_exp (L / 2)
      linarith
    have h_quad : (4 + |t|) ^ 2 ≤ 80 * (1 / 4 + t ^ 2) := by
      have h1 : 0 ≤ 4 * (|t| - 1) ^ 2 := by positivity
      have h2 : 0 ≤ 75 * t ^ 2 := by positivity
      have h_id : 80 * (1 / 4 + t ^ 2) - (4 + |t|) ^ 2 = 4 * (|t| - 1) ^ 2 + 75 * t ^ 2 := by
        have h_sq : t ^ 2 = |t| ^ 2 := (sq_abs t).symm
        rw [h_sq]
        ring
      linarith
    have h_inv_le : (1 / 4 + t ^ 2)⁻¹ ≤ 80 * Real.exp (-2 * L) := by
      have h_exp2L : (4 + |t|) ^ 2 = Real.exp (2 * L) := by
        rw [← hexpL, sq, ← Real.exp_add]
        congr 1
        ring
      have h_neg : Real.exp (-2 * L) = ((4 + |t|) ^ 2)⁻¹ := by
        rw [h_exp2L, show -2 * L = -(2 * L) by ring, Real.exp_neg]
      rw [h_neg, ← div_eq_mul_inv, inv_eq_one_div, div_le_div_iff₀ (hdenom_pos t) (by positivity)]
      linarith
    have h_ratio_le : L / (1 / 4 + t ^ 2) ≤ 160 * (4 + |t|) ^ (-3 / 2 : ℝ) := by
      have h_rpow : (4 + |t|) ^ (-3 / 2 : ℝ) = Real.exp (L / 2) * Real.exp (-2 * L) := by
        rw [Real.rpow_def_of_pos (h4t_pos t), ← Real.exp_add]
        congr 1
        dsimp [L]
        ring
      calc L / (1 / 4 + t ^ 2)
        _ = L * (1 / 4 + t ^ 2)⁻¹ := div_eq_mul_inv _ _
        _ ≤ (2 * Real.exp (L / 2)) * (80 * Real.exp (-2 * L)) :=
            mul_le_mul h_L_le h_inv_le (by positivity) (by positivity)
        _ = 160 * (Real.exp (L / 2) * Real.exp (-2 * L)) := by ring
        _ = 160 * (4 + |t|) ^ (-3 / 2 : ℝ) := by rw [← h_rpow]
    calc Y ^ (1 - B / L) * (L / (1 / 4 + t ^ 2))
      _ ≤ Y * (160 * (4 + |t|) ^ (-3 / 2 : ℝ)) :=
          mul_le_mul h_factor1 h_ratio_le (by positivity) (by positivity)
      _ = (160 * Y) * (4 + |t|) ^ (-3 / 2 : ℝ) := by ring
  exact MeasureTheory.Integrable.mono'
    (hg_int.const_mul (160 * Y))
    hf_cont.aestronglyMeasurable
    (Filter.Eventually.of_forall hf_bound)

theorem mitsui_riesz_poleFree_truncated_vertical_le_boundary_add_horiz (B C : ℝ) (D : ℂ → ℂ) (hB_pos : 0 < B) (hB_le : B ≤ 1 / 2) (hC_pos : 0 < C)
    (hD_dlvp : ∀ s : ℂ, 1 - B / Real.log (4 + |s.im|) ≤ s.re →
      DifferentiableAt ℂ D s ∧
      ‖D s‖ ≤ C * Real.log (4 + |s.im|))
    (Y : ℝ) (hY : 1 < Y) (T : ℝ) (hT : 0 < T) :
    ‖∫ t in (-T)..T,
        ((Y : ℂ) ^ (2 + (t : ℂ) * Complex.I) / (2 + (t : ℂ) * Complex.I) ^ 2) *
          D (2 + (t : ℂ) * Complex.I)‖ ≤
      (5 / 2) * C *
        (∫ t in (-T)..T,
          Y ^ (1 - B / Real.log (4 + |t|)) * (Real.log (4 + |t|) / (1 / 4 + t ^ 2))) +
      (‖∫ x in (1 - B / Real.log (4 + |T|))..2,
          ((Y : ℂ) ^ ((x : ℂ) + (T : ℂ) * Complex.I) / ((x : ℂ) + (T : ℂ) * Complex.I) ^ 2) *
            D ((x : ℂ) + (T : ℂ) * Complex.I)‖ +
        ‖∫ x in (1 - B / Real.log (4 + |T|))..2,
          ((Y : ℂ) ^ ((x : ℂ) - (T : ℂ) * Complex.I) / ((x : ℂ) - (T : ℂ) * Complex.I) ^ 2) *
            D ((x : ℂ) - (T : ℂ) * Complex.I)‖) :=
by
  have hY_pos : 0 < Y := by linarith
  have hY_ne : (Y : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt hY_pos
  obtain ⟨σ, hσ_def⟩ : ∃ σ : ℝ → ℝ, σ = fun t : ℝ => 1 - B / Real.log (4 + |t|) := ⟨_, rfl⟩
  obtain ⟨H, hH_def⟩ : ∃ H : ℂ → ℂ, H = fun s : ℂ => ((Y : ℂ) ^ s / s ^ 2) * D s := ⟨_, rfl⟩
  obtain ⟨g, hg_def⟩ : ∃ g : ℝ → ℝ, g = fun t : ℝ => Y ^ (σ t) * (Real.log (4 + |t|) / (1 / 4 + t ^ 2)) := ⟨_, rfl⟩
  have hσ_abs : ∀ t : ℝ, σ (|t|) = σ t := by intro t; simp [hσ_def]
  have hσ_neg : ∀ t : ℝ, σ (-t) = σ t := by intro t; simp [hσ_def]
  have hlog4_ge : ∀ t : ℝ, 5 / 4 ≤ Real.log (4 + |t|) := by
    intro t
    have h2 : (5 / 8 : ℝ) ≤ Real.log 2 := by
      have := Real.log_two_gt_d9
      linarith
    have h4 : (5 / 4 : ℝ) ≤ Real.log 4 := by
      have h4_eq : (4 : ℝ) = 2 ^ 2 := by norm_num
      rw [h4_eq, Real.log_pow]
      push_cast
      linarith
    have h_le : Real.log 4 ≤ Real.log (4 + |t|) := by
      apply Real.log_le_log (by norm_num)
      have : 0 ≤ |t| := abs_nonneg t
      linarith
    linarith
  have hσ_bounds : ∀ t : ℝ, 3 / 5 ≤ σ t ∧ σ t ≤ 1 := by
    intro t
    have hL := hlog4_ge t
    have hL_pos : 0 < Real.log (4 + |t|) := by linarith
    have h_div_nonneg : 0 ≤ B / Real.log (4 + |t|) := by positivity
    have h_div_le : B / Real.log (4 + |t|) ≤ 2 / 5 := by
      rw [div_le_iff₀ hL_pos]
      linarith
    rw [hσ_def]
    constructor <;> linarith
  have hσ_lip : ∀ a b : ℝ, 0 ≤ a → a ≤ b → σ a ≤ σ b ∧ σ b - σ a ≤ (b - a) / 4 := by
    intro a b ha hab
    have hb : 0 ≤ b := le_trans ha hab
    have hLa : Real.log (4 + |a|) = Real.log (4 + a) := by rw [abs_of_nonneg ha]
    have hLb : Real.log (4 + |b|) = Real.log (4 + b) := by rw [abs_of_nonneg hb]
    set La := Real.log (4 + a)
    set Lb := Real.log (4 + b)
    have hLa_ge : 5 / 4 ≤ La := by rw [← hLa]; exact hlog4_ge a
    have hLb_ge : 5 / 4 ≤ Lb := by rw [← hLb]; exact hlog4_ge b
    have hLa_pos : 0 < La := by linarith
    have hLb_pos : 0 < Lb := by linarith
    have hLa_le_Lb : La ≤ Lb := Real.log_le_log (by linarith) (by linarith)
    have h_diff_eq : σ b - σ a = B * (Lb - La) / (La * Lb) := by
      rw [hσ_def]
      dsimp only []
      rw [hLa, hLb]
      have hLa_ne : La ≠ 0 := ne_of_gt hLa_pos
      have hLb_ne : Lb ≠ 0 := ne_of_gt hLb_pos
      field_simp [hLa_ne, hLb_ne]
      ring
    have h_nonneg : 0 ≤ σ b - σ a := by
      rw [h_diff_eq]
      have : 0 ≤ Lb - La := by linarith
      positivity
    have h_log_diff : Lb - La ≤ (b - a) / 4 := by
      have h4a_pos : 0 < 4 + a := by linarith
      have h4b_pos : 0 < 4 + b := by linarith
      have h1 : Lb - La = Real.log ((4 + b) / (4 + a)) := by
        dsimp [La, Lb]
        rw [Real.log_div (ne_of_gt h4b_pos) (ne_of_gt h4a_pos)]
      have h2 : Real.log ((4 + b) / (4 + a)) ≤ (4 + b) / (4 + a) - 1 :=
        Real.log_le_sub_one_of_pos (div_pos h4b_pos h4a_pos)
      have h3 : (4 + b) / (4 + a) - 1 = (b - a) / (4 + a) := by
        field_simp [ne_of_gt h4a_pos]
        ring
      have h4 : (b - a) / (4 + a) ≤ (b - a) / 4 :=
        div_le_div_of_nonneg_left (by linarith) (by norm_num) (by linarith)
      linarith
    have h_prod_ge : 1 ≤ La * Lb := by
      calc (1 : ℝ) = 1 * 1 := by norm_num
        _ ≤ La * Lb := mul_le_mul (by linarith) (by linarith) (by norm_num) (by linarith)
    have h_upper : σ b - σ a ≤ (b - a) / 4 := by
      rw [h_diff_eq, div_le_iff₀ (mul_pos hLa_pos hLb_pos)]
      calc B * (Lb - La) ≤ (1 / 2) * ((b - a) / 4) :=
            mul_le_mul hB_le h_log_diff (by linarith) (by norm_num)
        _ ≤ ((b - a) / 4) * 1 := by linarith
        _ ≤ ((b - a) / 4) * (La * Lb) :=
            mul_le_mul_of_nonneg_left h_prod_ge (by linarith)
    exact ⟨by linarith, h_upper⟩
  have hσ_cont : Continuous σ := by
    rw [hσ_def]
    refine continuous_const.sub (continuous_const.div ?_ (fun t => ne_of_gt (by linarith [hlog4_ge t])))
    exact (continuous_const.add continuous_abs).log (fun t => by positivity)
  have hH_props : ∀ s : ℂ, σ s.im ≤ s.re →
      DifferentiableAt ℂ H s ∧
      ‖H s‖ ≤ C * Y ^ s.re * (Real.log (4 + |s.im|) / (s.re ^ 2 + s.im ^ 2)) := by
    intro s hs
    have hs_re_pos : 0 < s.re := by linarith [(hσ_bounds s.im).1]
    have hs_normSq : Complex.normSq s = s.re ^ 2 + s.im ^ 2 := by
      rw [Complex.normSq_apply]
      ring
    have hs_sq_norm : ‖s ^ 2‖ = s.re ^ 2 + s.im ^ 2 := by
      rw [norm_pow, Complex.sq_norm, hs_normSq]
    have hs_sq_pos : 0 < s.re ^ 2 + s.im ^ 2 := by positivity
    have hs_sq_ne : s ^ 2 ≠ 0 := by
      rw [← norm_ne_zero_iff, hs_sq_norm]
      exact ne_of_gt hs_sq_pos
    have h_cpow_eq : (fun z : ℂ => (Y : ℂ) ^ z) =
        (fun z : ℂ => Complex.exp (Complex.log (Y : ℂ) * z)) := by
      ext z
      exact Complex.cpow_def_of_ne_zero hY_ne z
    have h_cpow_diff : DifferentiableAt ℂ (fun z : ℂ => (Y : ℂ) ^ z) s := by
      rw [h_cpow_eq]
      exact (differentiableAt_id.const_mul (Complex.log (Y : ℂ))).cexp
    have hD := hD_dlvp s (by rwa [hσ_def] at hs)
    refine ⟨?_, ?_⟩
    · rw [hH_def]
      exact (h_cpow_diff.div (differentiableAt_id.pow 2) hs_sq_ne).mul hD.1
    · rw [hH_def, norm_mul, norm_div, Complex.norm_cpow_eq_rpow_re_of_pos hY_pos s, hs_sq_norm]
      calc (Y ^ s.re / (s.re ^ 2 + s.im ^ 2)) * ‖D s‖
        _ ≤ (Y ^ s.re / (s.re ^ 2 + s.im ^ 2)) * (C * Real.log (4 + |s.im|)) :=
            mul_le_mul_of_nonneg_left hD.2 (by positivity)
        _ = C * Y ^ s.re * (Real.log (4 + |s.im|) / (s.re ^ 2 + s.im ^ 2)) := by ring
  have hg_cont : Continuous g := by
    rw [hg_def]
    refine (Continuous.rpow continuous_const hσ_cont (fun _ => Or.inl (ne_of_gt hY_pos))).mul ?_
    refine ((continuous_const.add continuous_abs).log (fun _ => by positivity)).div ?_ (fun _ => by positivity)
    exact continuous_const.add (continuous_id.pow 2)
  have h_rect : ∀ (a b y₁ y₂ : ℝ), 0 ≤ a → a ≤ b → y₁ ≤ y₂ →
      (∀ y ∈ Set.Icc y₁ y₂, a ≤ |y| ∧ |y| ≤ b) →
      (((∫ x in σ b..2, H ((x : ℂ) + (y₁ : ℂ) * Complex.I)) -
          ∫ x in σ b..2, H ((x : ℂ) + (y₂ : ℂ) * Complex.I)) +
        Complex.I * ∫ y in y₁..y₂, H (2 + (y : ℂ) * Complex.I)) -
      Complex.I * ∫ y in y₁..y₂, H ((σ b : ℂ) + (y : ℂ) * Complex.I) = 0 := by
    intro a b y₁ y₂ ha hab hy₁₂ hy_abs
    set z : ℂ := (σ b : ℂ) + (y₁ : ℂ) * Complex.I
    set w : ℂ := 2 + (y₂ : ℂ) * Complex.I
    have hz_re : z.re = σ b := by simp [z]
    have hw_re : w.re = 2 := by simp [w]
    have hz_im : z.im = y₁ := by simp [z]
    have hw_im : w.im = y₂ := by simp [w]
    have hσb_le_two : σ b ≤ 2 := by linarith [(hσ_bounds b).2]
    have h_diff_on : DifferentiableOn ℂ H (Set.uIcc z.re w.re ×ℂ Set.uIcc z.im w.im) := by
      intro s hs
      rw [Complex.mem_reProdIm, hz_re, hw_re, hz_im, hw_im,
        Set.uIcc_of_le hσb_le_two, Set.uIcc_of_le hy₁₂] at hs
      have habs_le : |s.im| ≤ b := (hy_abs s.im hs.2).2
      have hσ_le : σ s.im ≤ σ b := by
        rw [← hσ_abs s.im]
        exact (hσ_lip (|s.im|) b (abs_nonneg _) habs_le).1
      exact ((hH_props s (le_trans hσ_le hs.1.1)).1).differentiableWithinAt
    have h_cg := Complex.integral_boundary_rect_eq_zero_of_differentiableOn H z w h_diff_on
    simpa only [hz_re, hw_re, hz_im, hw_im, smul_eq_mul] using h_cg
  have h_split : ∀ (a b y₀ : ℝ), 0 ≤ a → a ≤ b → |y₀| = a →
      (∫ x in σ a..σ b, H ((x : ℂ) + (y₀ : ℂ) * Complex.I)) +
        (∫ x in σ b..2, H ((x : ℂ) + (y₀ : ℂ) * Complex.I)) =
      ∫ x in σ a..2, H ((x : ℂ) + (y₀ : ℂ) * Complex.I) := by
    intro a b y₀ ha hab hy₀
    have hσa_le_σb : σ a ≤ σ b := (hσ_lip a b ha hab).1
    have hσb_le_two : σ b ≤ 2 := by linarith [(hσ_bounds b).2]
    have hσa_le_two : σ a ≤ 2 := le_trans hσa_le_σb hσb_le_two
    have h_inner_cont : Continuous (fun x : ℝ => (x : ℂ) + (y₀ : ℂ) * Complex.I) :=
      Complex.continuous_ofReal.add continuous_const
    have h_cont_on : ContinuousOn (fun x : ℝ => H ((x : ℂ) + (y₀ : ℂ) * Complex.I)) (Set.Icc (σ a) 2) := by
      intro x hx
      have hs_re : (((x : ℂ) + (y₀ : ℂ) * Complex.I)).re = x := by simp
      have hs_im : (((x : ℂ) + (y₀ : ℂ) * Complex.I)).im = y₀ := by simp
      have hσ_le : σ (((x : ℂ) + (y₀ : ℂ) * Complex.I)).im ≤ (((x : ℂ) + (y₀ : ℂ) * Complex.I)).re := by
        rw [hs_re, hs_im, ← hσ_abs y₀, hy₀]
        exact hx.1
      have h_ca : ContinuousAt (fun x : ℝ => H ((x : ℂ) + (y₀ : ℂ) * Complex.I)) x :=
        ContinuousAt.comp ((hH_props _ hσ_le).1).continuousAt h_inner_cont.continuousAt
      exact h_ca.continuousWithinAt
    have h_int1 : IntervalIntegrable (fun x : ℝ => H ((x : ℂ) + (y₀ : ℂ) * Complex.I)) MeasureTheory.volume (σ a) (σ b) := by
      apply ContinuousOn.intervalIntegrable
      rw [Set.uIcc_of_le hσa_le_σb]
      exact h_cont_on.mono (Set.Icc_subset_Icc_right hσb_le_two)
    have h_int2 : IntervalIntegrable (fun x : ℝ => H ((x : ℂ) + (y₀ : ℂ) * Complex.I)) MeasureTheory.volume (σ b) 2 := by
      apply ContinuousOn.intervalIntegrable
      rw [Set.uIcc_of_le hσb_le_two]
      exact h_cont_on.mono (Set.Icc_subset_Icc_left hσa_le_σb)
    exact intervalIntegral.integral_add_adjacent_intervals h_int1 h_int2
  have h_left_step : ∀ (a b y₁ y₂ : ℝ), 0 ≤ a → a ≤ b →
      ((b - a) / 4) * Real.log Y ≤ Real.log 2 →
      y₁ ≤ y₂ → (∀ t ∈ Set.Icc y₁ y₂, a ≤ |t| ∧ |t| ≤ b) →
      ‖∫ t in y₁..y₂, H ((σ b : ℂ) + (t : ℂ) * Complex.I)‖ ≤
        2 * C * ∫ t in y₁..y₂, g t := by
    intro a b y₁ y₂ ha hab h_step_Y hy₁₂ hy_abs
    have h_pw : ∀ t ∈ Set.Ioc y₁ y₂, ‖H ((σ b : ℂ) + (t : ℂ) * Complex.I)‖ ≤ 2 * C * g t := by
      intro t ht
      have ht_Icc : t ∈ Set.Icc y₁ y₂ := Set.Ioc_subset_Icc_self ht
      have ha_le : a ≤ |t| := (hy_abs t ht_Icc).1
      have hb_ge : |t| ≤ b := (hy_abs t ht_Icc).2
      have hσ_a_t : σ a ≤ σ t := by
        rw [← hσ_abs t]
        exact (hσ_lip a (|t|) ha ha_le).1
      have hσ_t_b : σ t ≤ σ b := by
        rw [← hσ_abs t]
        exact (hσ_lip (|t|) b (abs_nonneg t) hb_ge).1
      have hσ_diff : σ b - σ t ≤ (b - a) / 4 := by
        have := (hσ_lip a b ha hab).2
        linarith
      have hY_diff : Y ^ (σ b - σ t) ≤ 2 := by
        rw [Real.rpow_def_of_pos hY_pos]
        have h_le : Real.log Y * (σ b - σ t) ≤ Real.log 2 := by
          calc Real.log Y * (σ b - σ t)
            _ ≤ Real.log Y * ((b - a) / 4) :=
                mul_le_mul_of_nonneg_left hσ_diff (le_of_lt (Real.log_pos hY))
            _ = ((b - a) / 4) * Real.log Y := by ring
            _ ≤ Real.log 2 := h_step_Y
        exact le_trans (Real.exp_le_exp.mpr h_le) (le_of_eq (Real.exp_log (by norm_num)))
      have hY_σb : Y ^ (σ b) ≤ 2 * Y ^ (σ t) := by
        have h_add : σ b = (σ b - σ t) + σ t := by ring
        rw [h_add, Real.rpow_add hY_pos]
        exact mul_le_mul_of_nonneg_right hY_diff (by positivity)
      have hσb_ge : 3 / 5 ≤ σ b := (hσ_bounds b).1
      have hσb_sq : (3 / 5 : ℝ) ^ 2 ≤ (σ b) ^ 2 := sq_le_sq' (by linarith) hσb_ge
      have h_denom : 1 / 4 + t ^ 2 ≤ (σ b) ^ 2 + t ^ 2 := by linarith
      have h_denom_pos : 0 < 1 / 4 + t ^ 2 := by positivity
      have hL_pos : 0 < Real.log (4 + |t|) := by linarith [hlog4_ge t]
      have h_frac : Real.log (4 + |t|) / ((σ b) ^ 2 + t ^ 2) ≤ Real.log (4 + |t|) / (1 / 4 + t ^ 2) :=
        div_le_div_of_nonneg_left (le_of_lt hL_pos) h_denom_pos h_denom
      set s : ℂ := (σ b : ℂ) + (t : ℂ) * Complex.I
      have hs_re : s.re = σ b := by simp [s]
      have hs_im : s.im = t := by simp [s]
      have hH_b := (hH_props s (by rw [hs_re, hs_im]; exact hσ_t_b)).2
      rw [hs_re, hs_im] at hH_b
      rw [hg_def]
      calc ‖H s‖
        _ ≤ C * Y ^ (σ b) * (Real.log (4 + |t|) / ((σ b) ^ 2 + t ^ 2)) := hH_b
        _ ≤ C * (2 * Y ^ (σ t)) * (Real.log (4 + |t|) / (1 / 4 + t ^ 2)) := by
            apply mul_le_mul
            · exact mul_le_mul_of_nonneg_left hY_σb (le_of_lt hC_pos)
            · exact h_frac
            · positivity
            · positivity
        _ = 2 * C * (Y ^ (σ t) * (Real.log (4 + |t|) / (1 / 4 + t ^ 2))) := by ring
    have h_int : IntervalIntegrable (fun t => 2 * C * g t) MeasureTheory.volume y₁ y₂ :=
      (continuous_const.mul hg_cont).intervalIntegrable y₁ y₂
    have h_le := intervalIntegral.norm_integral_le_of_norm_le hy₁₂
      (Filter.Eventually.of_forall h_pw) h_int
    rwa [intervalIntegral.integral_const_mul] at h_le
  have h_horiz_step : ∀ (a b y₁ y₂ y₀ : ℝ), 0 ≤ a → a ≤ b →
      2 * b * (b - a) ≤ 1 / 10 →
      ((b - a) / 4) * Real.log Y ≤ Real.log 2 →
      y₁ ≤ y₂ → y₂ - y₁ = b - a →
      (∀ t ∈ Set.Icc y₁ y₂, a ≤ |t| ∧ |t| ≤ b) →
      |y₀| = a →
      ‖∫ x in σ a..σ b, H ((x : ℂ) + (y₀ : ℂ) * Complex.I)‖ ≤
        (1 / 2) * C * ∫ t in y₁..y₂, g t := by
    intro a b y₁ y₂ y₀ ha hab h_step_quad h_step_Y hy₁₂ hy_len hy_abs hy₀
    have hσa_le_σb : σ a ≤ σ b := (hσ_lip a b ha hab).1
    have hσ_diff : σ b - σ a ≤ (b - a) / 4 := (hσ_lip a b ha hab).2
    set M : ℝ := C * Y ^ (σ b) * (Real.log (4 + a) / (9 / 25 + a ^ 2))
    have hLa_pos : 0 < Real.log (4 + a) := by
      have := hlog4_ge a
      rw [abs_of_nonneg ha] at this
      linarith
    have hM_nonneg : 0 ≤ M := by dsimp [M]; positivity
    have h_H_le_M : ∀ x ∈ Set.uIoc (σ a) (σ b), ‖H ((x : ℂ) + (y₀ : ℂ) * Complex.I)‖ ≤ M := by
      intro x hx
      rw [Set.uIoc_of_le hσa_le_σb] at hx
      set s : ℂ := (x : ℂ) + (y₀ : ℂ) * Complex.I
      have hs_re : s.re = x := by simp [s]
      have hs_im : s.im = y₀ := by simp [s]
      have hσ_le : σ s.im ≤ s.re := by
        rw [hs_re, hs_im, ← hσ_abs y₀, hy₀]
        exact le_of_lt hx.1
      have hH_b := (hH_props s hσ_le).2
      rw [hs_re, hs_im, hy₀] at hH_b
      have hYx : Y ^ x ≤ Y ^ (σ b) := Real.rpow_le_rpow_of_exponent_le (le_of_lt hY) hx.2
      have hx_ge : 3 / 5 ≤ x := le_trans (hσ_bounds a).1 (le_of_lt hx.1)
      have hx_sq : (3 / 5 : ℝ) ^ 2 ≤ x ^ 2 := sq_le_sq' (by linarith) hx_ge
      have hy₀_sq : y₀ ^ 2 = a ^ 2 := by rw [← sq_abs y₀, hy₀]
      have h_denom : 9 / 25 + a ^ 2 ≤ x ^ 2 + y₀ ^ 2 := by linarith
      have h_frac : Real.log (4 + a) / (x ^ 2 + y₀ ^ 2) ≤ Real.log (4 + a) / (9 / 25 + a ^ 2) :=
        div_le_div_of_nonneg_left (le_of_lt hLa_pos) (by positivity) h_denom
      calc ‖H s‖
        _ ≤ C * Y ^ x * (Real.log (4 + a) / (x ^ 2 + y₀ ^ 2)) := hH_b
        _ ≤ C * Y ^ (σ b) * (Real.log (4 + a) / (9 / 25 + a ^ 2)) := by
            apply mul_le_mul
            · exact mul_le_mul_of_nonneg_left hYx (le_of_lt hC_pos)
            · exact h_frac
            · positivity
            · positivity
        _ = M := rfl
    have h_int_M : ‖∫ x in σ a..σ b, H ((x : ℂ) + (y₀ : ℂ) * Complex.I)‖ ≤ (1 / 4) * ((y₂ - y₁) * M) := by
      have h1 := intervalIntegral.norm_integral_le_of_norm_le_const h_H_le_M
      rw [abs_of_nonneg (sub_nonneg.mpr hσa_le_σb)] at h1
      calc ‖∫ x in σ a..σ b, H ((x : ℂ) + (y₀ : ℂ) * Complex.I)‖
        _ ≤ M * (σ b - σ a) := h1
        _ ≤ M * ((b - a) / 4) := mul_le_mul_of_nonneg_left hσ_diff hM_nonneg
        _ = (1 / 4) * ((y₂ - y₁) * M) := by rw [hy_len]; ring
    have h_M_le_g : ∀ t ∈ Set.Icc y₁ y₂, M ≤ 2 * C * g t := by
      intro t ht
      have ha_le : a ≤ |t| := (hy_abs t ht).1
      have hb_ge : |t| ≤ b := (hy_abs t ht).2
      have hσ_a_t : σ a ≤ σ t := by
        rw [← hσ_abs t]
        exact (hσ_lip a (|t|) ha ha_le).1
      have hσ_diff_t : σ b - σ t ≤ (b - a) / 4 := by linarith
      have hY_diff : Y ^ (σ b - σ t) ≤ 2 := by
        rw [Real.rpow_def_of_pos hY_pos]
        have h_le : Real.log Y * (σ b - σ t) ≤ Real.log 2 := by
          calc Real.log Y * (σ b - σ t)
            _ ≤ Real.log Y * ((b - a) / 4) :=
                mul_le_mul_of_nonneg_left hσ_diff_t (le_of_lt (Real.log_pos hY))
            _ = ((b - a) / 4) * Real.log Y := by ring
            _ ≤ Real.log 2 := h_step_Y
        exact le_trans (Real.exp_le_exp.mpr h_le) (le_of_eq (Real.exp_log (by norm_num)))
      have hY_σb : Y ^ (σ b) ≤ 2 * Y ^ (σ t) := by
        have h_add : σ b = (σ b - σ t) + σ t := by ring
        rw [h_add, Real.rpow_add hY_pos]
        exact mul_le_mul_of_nonneg_right hY_diff (by positivity)
      have h_sq_diff : t ^ 2 - a ^ 2 ≤ 1 / 10 := by
        have h_id : t ^ 2 - a ^ 2 = (|t| - a) * (|t| + a) := by
          rw [← sq_abs t]
          ring
        rw [h_id]
        calc (|t| - a) * (|t| + a)
          _ ≤ (b - a) * (2 * b) :=
              mul_le_mul (by linarith) (by linarith) (by linarith) (by linarith)
          _ = 2 * b * (b - a) := by ring
          _ ≤ 1 / 10 := h_step_quad
      have h_denom : 1 / 4 + t ^ 2 ≤ 9 / 25 + a ^ 2 := by linarith
      have hL_le : Real.log (4 + a) ≤ Real.log (4 + |t|) :=
        Real.log_le_log (by linarith) (by linarith)
      have h_frac : Real.log (4 + a) / (9 / 25 + a ^ 2) ≤ Real.log (4 + |t|) / (1 / 4 + t ^ 2) := by
        exact div_le_div₀ (by linarith [hlog4_ge t]) hL_le (by positivity) h_denom
      dsimp [M]
      rw [hg_def]
      calc C * Y ^ (σ b) * (Real.log (4 + a) / (9 / 25 + a ^ 2))
        _ ≤ C * (2 * Y ^ (σ t)) * (Real.log (4 + |t|) / (1 / 4 + t ^ 2)) := by
            apply mul_le_mul
            · exact mul_le_mul_of_nonneg_left hY_σb (le_of_lt hC_pos)
            · exact h_frac
            · positivity
            · positivity
        _ = 2 * C * (Y ^ (σ t) * (Real.log (4 + |t|) / (1 / 4 + t ^ 2))) := by ring
    have h_mono : (y₂ - y₁) * M ≤ 2 * C * ∫ t in y₁..y₂, g t := by
      calc (y₂ - y₁) * M = ∫ t in y₁..y₂, M := by
            rw [intervalIntegral.integral_const, smul_eq_mul]
        _ ≤ ∫ t in y₁..y₂, (2 * C * g t) :=
            intervalIntegral.integral_mono_on hy₁₂ intervalIntegral.intervalIntegrable_const
              ((continuous_const.mul hg_cont).intervalIntegrable y₁ y₂) h_M_le_g
        _ = 2 * C * ∫ t in y₁..y₂, g t := intervalIntegral.integral_const_mul (2 * C) g
    linarith
  obtain ⟨F_D, hF_D_def⟩ : ∃ F_D : ℝ → ℂ, F_D = fun t : ℝ => H (2 + (t : ℂ) * Complex.I) := ⟨_, rfl⟩
  obtain ⟨F_pos, hF_pos_def⟩ : ∃ F_pos : ℝ → ℂ, F_pos = fun u : ℝ =>
    ∫ x in σ u..2, H ((x : ℂ) + (u : ℂ) * Complex.I) := ⟨_, rfl⟩
  obtain ⟨F_neg, hF_neg_def⟩ : ∃ F_neg : ℝ → ℂ, F_neg = fun u : ℝ =>
    ∫ x in σ u..2, H ((x : ℂ) + ((-u : ℝ) : ℂ) * Complex.I) := ⟨_, rfl⟩
  have hF_D_cont : Continuous F_D := by
    rw [hF_D_def, continuous_iff_continuousAt]
    intro t
    have h_inner_cont : Continuous (fun t : ℝ => (2 : ℂ) + (t : ℂ) * Complex.I) :=
      continuous_const.add (Complex.continuous_ofReal.mul continuous_const)
    have hs_re : ((2 : ℂ) + (t : ℂ) * Complex.I).re = 2 := by simp
    have hs_im : ((2 : ℂ) + (t : ℂ) * Complex.I).im = t := by simp
    have hσ_le : σ ((2 + (t : ℂ) * Complex.I).im) ≤ (2 + (t : ℂ) * Complex.I).re := by
      rw [hs_re, hs_im]
      linarith [(hσ_bounds t).2]
    exact ContinuousAt.comp ((hH_props _ hσ_le).1).continuousAt h_inner_cont.continuousAt
  have hF_zero_eq : F_pos 0 = F_neg 0 := by
    rw [hF_pos_def, hF_neg_def]
    simp
  have h_step : ∀ a b : ℝ, 0 ≤ a → a ≤ b →
      2 * b * (b - a) ≤ 1 / 10 →
      ((b - a) / 4) * Real.log Y ≤ Real.log 2 →
      ‖Complex.I * (∫ t in a..b, F_D t) - (F_pos b - F_pos a)‖ ≤
        (5 / 2) * C * (∫ t in a..b, g t) ∧
      ‖Complex.I * (∫ t in (-b)..(-a), F_D t) - (F_neg a - F_neg b)‖ ≤
        (5 / 2) * C * (∫ t in (-b)..(-a), g t) := by
    intro a b ha hab h_quad h_Y
    have hy_pos : ∀ t ∈ Set.Icc a b, a ≤ |t| ∧ |t| ≤ b := by
      intro t ht
      rw [abs_of_nonneg (le_trans ha ht.1)]
      exact ht
    have hy_neg : ∀ t ∈ Set.Icc (-b) (-a), a ≤ |t| ∧ |t| ≤ b := by
      intro t ht
      have ht_nonpos : t ≤ 0 := le_trans ht.2 (by linarith)
      rw [abs_of_nonpos ht_nonpos]
      exact ⟨by linarith [ht.2], by linarith [ht.1]⟩
    constructor
    · have hr := h_rect a b a b ha hab hab hy_pos
      have hs := h_split a b a ha hab (abs_of_nonneg ha)
      have h_id : Complex.I * (∫ t in a..b, F_D t) - (F_pos b - F_pos a) =
          Complex.I * (∫ t in a..b, H ((σ b : ℂ) + (t : ℂ) * Complex.I)) +
            (∫ x in σ a..σ b, H ((x : ℂ) + (a : ℂ) * Complex.I)) := by
        rw [hF_D_def, hF_pos_def]
        linear_combination hr - hs
      have h_tri : ‖Complex.I * (∫ t in a..b, F_D t) - (F_pos b - F_pos a)‖ ≤
          ‖∫ t in a..b, H ((σ b : ℂ) + (t : ℂ) * Complex.I)‖ +
            ‖∫ x in σ a..σ b, H ((x : ℂ) + (a : ℂ) * Complex.I)‖ := by
        rw [h_id]
        have h1 := norm_add_le
          (Complex.I * (∫ t in a..b, H ((σ b : ℂ) + (t : ℂ) * Complex.I)))
          (∫ x in σ a..σ b, H ((x : ℂ) + (a : ℂ) * Complex.I))
        rwa [norm_mul, Complex.norm_I, one_mul] at h1
      have hl := h_left_step a b a b ha hab h_Y hab hy_pos
      have hh := h_horiz_step a b a b a ha hab h_quad h_Y hab rfl hy_pos (abs_of_nonneg ha)
      linarith
    · have hab_neg : -b ≤ -a := by linarith
      have hr := h_rect a b (-b) (-a) ha hab hab_neg hy_neg
      have hs := h_split a b (-a) ha hab (by rw [abs_neg, abs_of_nonneg ha])
      have h_id : Complex.I * (∫ t in (-b)..(-a), F_D t) - (F_neg a - F_neg b) =
          Complex.I * (∫ t in (-b)..(-a), H ((σ b : ℂ) + (t : ℂ) * Complex.I)) -
            (∫ x in σ a..σ b, H ((x : ℂ) + ((-a : ℝ) : ℂ) * Complex.I)) := by
        rw [hF_D_def, hF_neg_def]
        linear_combination hr + hs
      have h_tri : ‖Complex.I * (∫ t in (-b)..(-a), F_D t) - (F_neg a - F_neg b)‖ ≤
          ‖∫ t in (-b)..(-a), H ((σ b : ℂ) + (t : ℂ) * Complex.I)‖ +
            ‖∫ x in σ a..σ b, H ((x : ℂ) + ((-a : ℝ) : ℂ) * Complex.I)‖ := by
        rw [h_id]
        have h1 := norm_sub_le
          (Complex.I * (∫ t in (-b)..(-a), H ((σ b : ℂ) + (t : ℂ) * Complex.I)))
          (∫ x in σ a..σ b, H ((x : ℂ) + ((-a : ℝ) : ℂ) * Complex.I))
        rwa [norm_mul, Complex.norm_I, one_mul] at h1
      have hl := h_left_step a b (-b) (-a) ha hab h_Y hab_neg hy_neg
      have hh := h_horiz_step a b (-b) (-a) (-a) ha hab h_quad h_Y hab_neg (by ring) hy_neg
        (by rw [abs_neg, abs_of_nonneg ha])
      linarith
  clear h_rect h_split h_left_step h_horiz_step hH_props hσ_lip hσ_bounds hlog4_ge
  set N : ℕ := ⌊20 * T ^ 2 + T * Real.log Y⌋₊ + 1
  have hN_pos : 0 < (N : ℝ) := by dsimp [N]; positivity
  have hN_ne : (N : ℝ) ≠ 0 := ne_of_gt hN_pos
  have hN_gt : 20 * T ^ 2 + T * Real.log Y < (N : ℝ) := by
    dsimp [N]
    push_cast
    exact Nat.lt_floor_add_one (20 * T ^ 2 + T * Real.log Y)
  set δ : ℝ := T / (N : ℝ)
  have hδ_pos : 0 < δ := div_pos hT hN_pos
  set tk : ℕ → ℝ := fun k => (k : ℝ) * δ
  have htk_zero : tk 0 = 0 := by simp [tk]
  have htk_N : tk N = T := by
    dsimp [tk, δ]
    exact mul_div_cancel₀ T hN_ne
  have hlogY_pos : 0 < Real.log Y := Real.log_pos hY
  have h_2Tδ : 2 * T * δ ≤ 1 / 10 := by
    dsimp [δ]
    rw [mul_div_assoc', div_le_iff₀ hN_pos]
    have : 0 < T * Real.log Y := mul_pos hT hlogY_pos
    linarith
  have h_δY : (δ / 4) * Real.log Y ≤ Real.log 2 := by
    have h1 : δ * Real.log Y ≤ 1 := by
      dsimp [δ]
      rw [div_mul_eq_mul_div, div_le_one hN_pos]
      have : 0 < 20 * T ^ 2 := by positivity
      linarith
    have h2 : (5 / 8 : ℝ) ≤ Real.log 2 := by
      have := Real.log_two_gt_d9
      linarith
    linarith
  have h_k_step : ∀ k ∈ Finset.range N,
      ‖Complex.I * (∫ t in tk k..tk (k + 1), F_D t) - (F_pos (tk (k + 1)) - F_pos (tk k))‖ ≤
        (5 / 2) * C * (∫ t in tk k..tk (k + 1), g t) ∧
      ‖Complex.I * (∫ t in (-tk (k + 1))..(-tk k), F_D t) - (F_neg (tk k) - F_neg (tk (k + 1)))‖ ≤
        (5 / 2) * C * (∫ t in (-tk (k + 1))..(-tk k), g t) := by
    intro k hk
    rw [Finset.mem_range] at hk
    have hk_nonneg : 0 ≤ tk k := by dsimp [tk]; positivity
    have h_diff : tk (k + 1) - tk k = δ := by
      dsimp [tk]
      push_cast
      ring
    have hk_le : tk k ≤ tk (k + 1) := by linarith
    have hk1_le_T : tk (k + 1) ≤ T := by
      have hk1_le_N : ((k + 1 : ℕ) : ℝ) ≤ (N : ℝ) := by exact_mod_cast hk
      calc tk (k + 1) = ((k + 1 : ℕ) : ℝ) * δ := rfl
        _ ≤ (N : ℝ) * δ := mul_le_mul_of_nonneg_right hk1_le_N (le_of_lt hδ_pos)
        _ = T := htk_N
    have h_quad : 2 * tk (k + 1) * (tk (k + 1) - tk k) ≤ 1 / 10 := by
      rw [h_diff]
      calc 2 * tk (k + 1) * δ ≤ 2 * T * δ := by
            apply mul_le_mul_of_nonneg_right (by linarith) (le_of_lt hδ_pos)
        _ ≤ 1 / 10 := h_2Tδ
    have h_Y : ((tk (k + 1) - tk k) / 4) * Real.log Y ≤ Real.log 2 := by
      rw [h_diff]
      exact h_δY
    exact h_step (tk k) (tk (k + 1)) hk_nonneg hk_le h_quad h_Y
  have hF_D_ii : ∀ u v : ℝ, IntervalIntegrable F_D MeasureTheory.volume u v :=
    fun u v => hF_D_cont.intervalIntegrable u v
  have hg_ii : ∀ u v : ℝ, IntervalIntegrable g MeasureTheory.volume u v :=
    fun u v => hg_cont.intervalIntegrable u v
  have h_pos_sum_F : (∑ k ∈ Finset.range N, ∫ t in tk k..tk (k + 1), F_D t) = ∫ t in 0..T, F_D t := by
    rw [intervalIntegral.sum_integral_adjacent_intervals (fun k _ => hF_D_ii (tk k) (tk (k + 1))),
      htk_zero, htk_N]
  have h_pos_sum_g : (∑ k ∈ Finset.range N, ∫ t in tk k..tk (k + 1), g t) = ∫ t in 0..T, g t := by
    rw [intervalIntegral.sum_integral_adjacent_intervals (fun k _ => hg_ii (tk k) (tk (k + 1))),
      htk_zero, htk_N]
  have h_pos_sum_H : (∑ k ∈ Finset.range N, (F_pos (tk (k + 1)) - F_pos (tk k))) = F_pos T - F_pos 0 := by
    rw [Finset.sum_range_sub (fun k => F_pos (tk k)) N, htk_N, htk_zero]
  have h_pos_tele : ‖Complex.I * (∫ t in 0..T, F_D t) - (F_pos T - F_pos 0)‖ ≤
      (5 / 2) * C * (∫ t in 0..T, g t) := by
    have h_eq : Complex.I * (∫ t in 0..T, F_D t) - (F_pos T - F_pos 0) =
        ∑ k ∈ Finset.range N, (Complex.I * (∫ t in tk k..tk (k + 1), F_D t) - (F_pos (tk (k + 1)) - F_pos (tk k))) := by
      rw [Finset.sum_sub_distrib, ← Finset.mul_sum, h_pos_sum_F, h_pos_sum_H]
    rw [h_eq]
    calc ‖∑ k ∈ Finset.range N, (Complex.I * (∫ t in tk k..tk (k + 1), F_D t) - (F_pos (tk (k + 1)) - F_pos (tk k)))‖
      _ ≤ ∑ k ∈ Finset.range N, ‖Complex.I * (∫ t in tk k..tk (k + 1), F_D t) - (F_pos (tk (k + 1)) - F_pos (tk k))‖ :=
          norm_sum_le _ _
      _ ≤ ∑ k ∈ Finset.range N, (5 / 2) * C * (∫ t in tk k..tk (k + 1), g t) :=
          Finset.sum_le_sum (fun k hk => (h_k_step k hk).1)
      _ = (5 / 2) * C * (∑ k ∈ Finset.range N, ∫ t in tk k..tk (k + 1), g t) := by
          rw [← Finset.mul_sum]
      _ = (5 / 2) * C * (∫ t in 0..T, g t) := by rw [h_pos_sum_g]
  have h_neg_sum_F : (∑ k ∈ Finset.range N, ∫ t in (-tk (k + 1))..(-tk k), F_D t) = ∫ t in (-T)..0, F_D t := by
    have h_term : ∀ k : ℕ, (∫ t in (-tk (k + 1))..(-tk k), F_D t) =
        (∫ t in (-tk (k + 1))..0, F_D t) - (∫ t in (-tk k)..0, F_D t) := by
      intro k
      have h_adj := intervalIntegral.integral_add_adjacent_intervals
        (hF_D_ii (-tk (k + 1)) (-tk k)) (hF_D_ii (-tk k) 0)
      exact eq_sub_of_add_eq h_adj
    simp_rw [h_term]
    rw [Finset.sum_range_sub (fun k => ∫ t in (-tk k)..0, F_D t) N, htk_N, htk_zero, neg_zero,
      intervalIntegral.integral_same, sub_zero]
  have h_neg_sum_g : (∑ k ∈ Finset.range N, ∫ t in (-tk (k + 1))..(-tk k), g t) = ∫ t in (-T)..0, g t := by
    have h_term : ∀ k : ℕ, (∫ t in (-tk (k + 1))..(-tk k), g t) =
        (∫ t in (-tk (k + 1))..0, g t) - (∫ t in (-tk k)..0, g t) := by
      intro k
      have h_adj := intervalIntegral.integral_add_adjacent_intervals
        (hg_ii (-tk (k + 1)) (-tk k)) (hg_ii (-tk k) 0)
      exact eq_sub_of_add_eq h_adj
    simp_rw [h_term]
    rw [Finset.sum_range_sub (fun k => ∫ t in (-tk k)..0, g t) N, htk_N, htk_zero, neg_zero,
      intervalIntegral.integral_same, sub_zero]
  have h_neg_sum_H : (∑ k ∈ Finset.range N, (F_neg (tk k) - F_neg (tk (k + 1)))) = F_neg 0 - F_neg T := by
    rw [Finset.sum_range_sub' (fun k => F_neg (tk k)) N, htk_zero, htk_N]
  have h_neg_tele : ‖Complex.I * (∫ t in (-T)..0, F_D t) - (F_neg 0 - F_neg T)‖ ≤
      (5 / 2) * C * (∫ t in (-T)..0, g t) := by
    have h_eq : Complex.I * (∫ t in (-T)..0, F_D t) - (F_neg 0 - F_neg T) =
        ∑ k ∈ Finset.range N, (Complex.I * (∫ t in (-tk (k + 1))..(-tk k), F_D t) - (F_neg (tk k) - F_neg (tk (k + 1)))) := by
      rw [Finset.sum_sub_distrib, ← Finset.mul_sum, h_neg_sum_F, h_neg_sum_H]
    rw [h_eq]
    calc ‖∑ k ∈ Finset.range N, (Complex.I * (∫ t in (-tk (k + 1))..(-tk k), F_D t) - (F_neg (tk k) - F_neg (tk (k + 1))))‖
      _ ≤ ∑ k ∈ Finset.range N, ‖Complex.I * (∫ t in (-tk (k + 1))..(-tk k), F_D t) - (F_neg (tk k) - F_neg (tk (k + 1)))‖ :=
          norm_sum_le _ _
      _ ≤ ∑ k ∈ Finset.range N, (5 / 2) * C * (∫ t in (-tk (k + 1))..(-tk k), g t) :=
          Finset.sum_le_sum (fun k hk => (h_k_step k hk).2)
      _ = (5 / 2) * C * (∑ k ∈ Finset.range N, ∫ t in (-tk (k + 1))..(-tk k), g t) := by
          rw [← Finset.mul_sum]
      _ = (5 / 2) * C * (∫ t in (-T)..0, g t) := by rw [h_neg_sum_g]
  have h_add_F : (∫ t in (-T)..0, F_D t) + (∫ t in 0..T, F_D t) = ∫ t in (-T)..T, F_D t :=
    intervalIntegral.integral_add_adjacent_intervals (hF_D_ii (-T) 0) (hF_D_ii 0 T)
  have h_add_g : (∫ t in (-T)..0, g t) + (∫ t in 0..T, g t) = ∫ t in (-T)..T, g t :=
    intervalIntegral.integral_add_adjacent_intervals (hg_ii (-T) 0) (hg_ii 0 T)
  have h_comb_id : Complex.I * (∫ t in (-T)..T, F_D t) - (F_pos T - F_neg T) =
      (Complex.I * (∫ t in (-T)..0, F_D t) - (F_neg 0 - F_neg T)) +
        (Complex.I * (∫ t in 0..T, F_D t) - (F_pos T - F_pos 0)) := by
    rw [← h_add_F, hF_zero_eq]
    ring
  have h_comb_norm : ‖Complex.I * (∫ t in (-T)..T, F_D t) - (F_pos T - F_neg T)‖ ≤
      (5 / 2) * C * (∫ t in (-T)..T, g t) := by
    rw [h_comb_id, ← h_add_g]
    have h_tri := norm_add_le
      (Complex.I * (∫ t in (-T)..0, F_D t) - (F_neg 0 - F_neg T))
      (Complex.I * (∫ t in 0..T, F_D t) - (F_pos T - F_pos 0))
    linarith
  have h_final_opaque : ‖∫ t in (-T)..T, F_D t‖ ≤
      (5 / 2) * C * (∫ t in (-T)..T, g t) + (‖F_pos T‖ + ‖F_neg T‖) := by
    set Z := ∫ t in (-T)..T, F_D t
    have hZ_norm : ‖Z‖ = ‖Complex.I * Z‖ := by
      rw [norm_mul, Complex.norm_I, one_mul]
    have h1 : ‖Complex.I * Z‖ ≤ ‖Complex.I * Z - (F_pos T - F_neg T)‖ + ‖F_pos T - F_neg T‖ := by
      calc ‖Complex.I * Z‖
        _ = ‖(Complex.I * Z - (F_pos T - F_neg T)) + (F_pos T - F_neg T)‖ := by ring_nf
        _ ≤ ‖Complex.I * Z - (F_pos T - F_neg T)‖ + ‖F_pos T - F_neg T‖ :=
            norm_add_le (Complex.I * Z - (F_pos T - F_neg T)) (F_pos T - F_neg T)
    have h2 : ‖F_pos T - F_neg T‖ ≤ ‖F_pos T‖ + ‖F_neg T‖ := norm_sub_le (F_pos T) (F_neg T)
    linarith
  have hF_neg_T : F_neg T = ∫ x in (1 - B / Real.log (4 + |T|))..2,
      ((Y : ℂ) ^ ((x : ℂ) - (T : ℂ) * Complex.I) / ((x : ℂ) - (T : ℂ) * Complex.I) ^ 2) *
        D ((x : ℂ) - (T : ℂ) * Complex.I) := by
    rw [hF_neg_def, hσ_def, hH_def]
    refine intervalIntegral.integral_congr (fun x _ => ?_)
    dsimp only []
    rw [Complex.ofReal_neg, neg_mul, ← sub_eq_add_neg]
  have hF_pos_T : F_pos T = ∫ x in (1 - B / Real.log (4 + |T|))..2,
      ((Y : ℂ) ^ ((x : ℂ) + (T : ℂ) * Complex.I) / ((x : ℂ) + (T : ℂ) * Complex.I) ^ 2) *
        D ((x : ℂ) + (T : ℂ) * Complex.I) := by
    rw [hF_pos_def, hσ_def, hH_def]
  have hF_D_int : (∫ t in (-T)..T, F_D t) = ∫ t in (-T)..T,
      ((Y : ℂ) ^ (2 + (t : ℂ) * Complex.I) / (2 + (t : ℂ) * Complex.I) ^ 2) *
        D (2 + (t : ℂ) * Complex.I) := by
    rw [hF_D_def, hH_def]
  have hg_int : (∫ t in (-T)..T, g t) = ∫ t in (-T)..T,
      Y ^ (1 - B / Real.log (4 + |t|)) * (Real.log (4 + |t|) / (1 / 4 + t ^ 2)) := by
    rw [hg_def, hσ_def]
  rw [← hF_D_int, ← hg_int, ← hF_pos_T, ← hF_neg_T]
  exact h_final_opaque

theorem mitsui_riesz_poleFree_horiz_caps_tendsto_zero (B C : ℝ) (D : ℂ → ℂ) (hB_pos : 0 < B) (hB_le : B ≤ 1 / 2) (hC_pos : 0 < C)
    (hD_dlvp : ∀ s : ℂ, 1 - B / Real.log (4 + |s.im|) ≤ s.re →
      DifferentiableAt ℂ D s ∧
      ‖D s‖ ≤ C * Real.log (4 + |s.im|))
    (Y : ℝ) (hY : 1 < Y) :
    Filter.Tendsto
      (fun T : ℝ =>
        ‖∫ x in (1 - B / Real.log (4 + |T|))..2,
          ((Y : ℂ) ^ ((x : ℂ) + (T : ℂ) * Complex.I) / ((x : ℂ) + (T : ℂ) * Complex.I) ^ 2) *
            D ((x : ℂ) + (T : ℂ) * Complex.I)‖ +
        ‖∫ x in (1 - B / Real.log (4 + |T|))..2,
          ((Y : ℂ) ^ ((x : ℂ) - (T : ℂ) * Complex.I) / ((x : ℂ) - (T : ℂ) * Complex.I) ^ 2) *
            D ((x : ℂ) - (T : ℂ) * Complex.I)‖)
      Filter.atTop (nhds 0) :=
by
  have hY_pos : 0 < Y := by linarith
  set σ : ℝ → ℝ := fun T => 1 - B / Real.log (4 + |T|)
  set E_horiz : ℝ → ℝ := fun T =>
    ‖∫ x in (σ T)..2,
        ((Y : ℂ) ^ ((x : ℂ) + (T : ℂ) * Complex.I) / ((x : ℂ) + (T : ℂ) * Complex.I) ^ 2) *
          D ((x : ℂ) + (T : ℂ) * Complex.I)‖ +
      ‖∫ x in (σ T)..2,
        ((Y : ℂ) ^ ((x : ℂ) - (T : ℂ) * Complex.I) / ((x : ℂ) - (T : ℂ) * Complex.I) ^ 2) *
          D ((x : ℂ) - (T : ℂ) * Complex.I)‖
  have h_cap_bound : ∀ (T : ℝ), 4 ≤ T → ∀ (y : ℝ), |y| = T →
      ‖∫ x in (σ T)..2,
        ((Y : ℂ) ^ ((x : ℂ) + (y : ℂ) * Complex.I) / ((x : ℂ) + (y : ℂ) * Complex.I) ^ 2) *
          D ((x : ℂ) + (y : ℂ) * Complex.I)‖ ≤ (4 * Y ^ 2 * C) * T⁻¹ := by
    intro T hT4 y hy
    have hT_pos : 0 < T := by linarith
    have habsT : |T| = T := abs_of_pos hT_pos
    have h_log_ge_one : 1 ≤ Real.log (4 + |T|) := by
      have hexp1 : Real.exp 1 ≤ 4 + |T| := by
        have h1 := Real.exp_one_lt_d9
        have h2 : 0 ≤ |T| := abs_nonneg T
        linarith
      have h_le := Real.log_le_log (Real.exp_pos 1) hexp1
      rwa [Real.log_exp] at h_le
    have h_div_le : B / Real.log (4 + |T|) ≤ 1 / 2 := by
      have h1 : B / Real.log (4 + |T|) ≤ B / 1 :=
        div_le_div_of_nonneg_left (le_of_lt hB_pos) zero_lt_one h_log_ge_one
      linarith
    have h_div_pos : 0 < B / Real.log (4 + |T|) :=
      div_pos hB_pos (lt_of_lt_of_le zero_lt_one h_log_ge_one)
    have hσ_ge : 1 / 2 ≤ σ T := by
      dsimp [σ]
      linarith
    have hσ_le_two : σ T ≤ 2 := by
      dsimp [σ]
      linarith
    have h_len_le : |2 - σ T| ≤ 2 := by
      rw [abs_of_pos (by dsimp [σ]; linarith)]
      dsimp [σ]
      linarith
    have h_log_le_two_T : Real.log (4 + |T|) ≤ 2 * T := by
      rw [habsT]
      have h_sub := Real.log_le_sub_one_of_pos (by linarith : 0 < 4 + T)
      linarith
    have h_ptwise : ∀ x ∈ Set.uIoc (σ T) 2,
        ‖((Y : ℂ) ^ ((x : ℂ) + (y : ℂ) * Complex.I) / ((x : ℂ) + (y : ℂ) * Complex.I) ^ 2) *
          D ((x : ℂ) + (y : ℂ) * Complex.I)‖ ≤ (2 * Y ^ 2 * C) * T⁻¹ := by
      intro x hx
      rw [Set.uIoc_of_le hσ_le_two, Set.mem_Ioc] at hx
      set s : ℂ := (x : ℂ) + (y : ℂ) * Complex.I
      have hs_re : s.re = x := by simp [s]
      have hs_im : s.im = y := by simp [s]
      have hs_dlvp : 1 - B / Real.log (4 + |s.im|) ≤ s.re := by
        rw [hs_re, hs_im, hy, ← habsT]
        exact le_of_lt hx.1
      have hD_le : ‖D s‖ ≤ 2 * C * T := by
        have h1 := (hD_dlvp s hs_dlvp).2
        rw [hs_im, hy, ← habsT] at h1
        calc ‖D s‖ ≤ C * Real.log (4 + |T|) := h1
          _ ≤ C * (2 * T) := mul_le_mul_of_nonneg_left h_log_le_two_T (le_of_lt hC_pos)
          _ = 2 * C * T := by ring
      have h_cpow_le : ‖(Y : ℂ) ^ s‖ ≤ Y ^ 2 := by
        rw [Complex.norm_cpow_eq_rpow_re_of_pos hY_pos s, hs_re]
        calc Y ^ x ≤ Y ^ (2 : ℝ) := Real.rpow_le_rpow_of_exponent_le (le_of_lt hY) hx.2
          _ = Y ^ 2 := Real.rpow_two Y
      have h_denom_ge : T ^ 2 ≤ ‖s ^ 2‖ := by
        have h_normSq : Complex.normSq s = x ^ 2 + T ^ 2 := by
          rw [Complex.normSq_apply, hs_re, hs_im]
          have hy_sq : y * y = T ^ 2 := by
            calc y * y = |y| ^ 2 := by rw [sq_abs]; ring
              _ = T ^ 2 := by rw [hy]
          linarith [hy_sq, sq x]
        rw [norm_pow, Complex.sq_norm, h_normSq]
        have : 0 ≤ x ^ 2 := sq_nonneg x
        linarith
      have h_denom_pos : 0 < T ^ 2 := by positivity
      have h_frac_le : ‖(Y : ℂ) ^ s / s ^ 2‖ ≤ Y ^ 2 / T ^ 2 := by
        rw [norm_div]
        exact div_le_div₀ (by positivity) h_cpow_le h_denom_pos h_denom_ge
      rw [norm_mul]
      calc ‖(Y : ℂ) ^ s / s ^ 2‖ * ‖D s‖
        _ ≤ (Y ^ 2 / T ^ 2) * (2 * C * T) :=
          mul_le_mul h_frac_le hD_le (norm_nonneg _) (by positivity)
        _ = (2 * Y ^ 2 * C) * T⁻¹ := by
          have hT_ne : T ≠ 0 := ne_of_gt hT_pos
          field_simp [hT_ne]
    have h_int := intervalIntegral.norm_integral_le_of_norm_le_const h_ptwise
    calc ‖∫ x in (σ T)..2,
          ((Y : ℂ) ^ ((x : ℂ) + (y : ℂ) * Complex.I) / ((x : ℂ) + (y : ℂ) * Complex.I) ^ 2) *
            D ((x : ℂ) + (y : ℂ) * Complex.I)‖
      _ ≤ ((2 * Y ^ 2 * C) * T⁻¹) * |2 - σ T| := h_int
      _ ≤ ((2 * Y ^ 2 * C) * T⁻¹) * 2 :=
          mul_le_mul_of_nonneg_left h_len_le (by positivity)
      _ = (4 * Y ^ 2 * C) * T⁻¹ := by ring
  have h_nonneg : ∀ᶠ T : ℝ in Filter.atTop, 0 ≤ E_horiz T :=
    Filter.Eventually.of_forall (fun T => add_nonneg (norm_nonneg _) (norm_nonneg _))
  have h_upper : ∀ᶠ T : ℝ in Filter.atTop, E_horiz T ≤ (8 * Y ^ 2 * C) * T⁻¹ := by
    filter_upwards [Filter.eventually_ge_atTop (4 : ℝ)] with T hT4
    have hT_pos : 0 < T := by linarith
    have habsT : |T| = T := abs_of_pos hT_pos
    have habs_negT : |-T| = T := by rw [abs_neg, habsT]
    have h_top := h_cap_bound T hT4 T habsT
    have h_bot_eq :
        (∫ x in (σ T)..2,
          ((Y : ℂ) ^ ((x : ℂ) - (T : ℂ) * Complex.I) / ((x : ℂ) - (T : ℂ) * Complex.I) ^ 2) *
            D ((x : ℂ) - (T : ℂ) * Complex.I)) =
        ∫ x in (σ T)..2,
          ((Y : ℂ) ^ ((x : ℂ) + ((-T : ℝ) : ℂ) * Complex.I) /
              ((x : ℂ) + ((-T : ℝ) : ℂ) * Complex.I) ^ 2) *
            D ((x : ℂ) + ((-T : ℝ) : ℂ) * Complex.I) := by
      congr 1
      ext x
      have hx_sub : (x : ℂ) - (T : ℂ) * Complex.I = (x : ℂ) + ((-T : ℝ) : ℂ) * Complex.I := by
        push_cast
        ring
      rw [hx_sub]
    have h_bot :
        ‖∫ x in (σ T)..2,
          ((Y : ℂ) ^ ((x : ℂ) - (T : ℂ) * Complex.I) / ((x : ℂ) - (T : ℂ) * Complex.I) ^ 2) *
            D ((x : ℂ) - (T : ℂ) * Complex.I)‖ ≤ (4 * Y ^ 2 * C) * T⁻¹ := by
      rw [h_bot_eq]
      exact h_cap_bound T hT4 (-T) habs_negT
    dsimp [E_horiz]
    linarith
  have h_maj_tendsto : Filter.Tendsto (fun T : ℝ => (8 * Y ^ 2 * C) * T⁻¹) Filter.atTop (nhds 0) := by
    have h := tendsto_inv_atTop_zero.const_mul (8 * Y ^ 2 * C)
    rwa [mul_zero] at h
  exact squeeze_zero' h_nonneg h_upper h_maj_tendsto

theorem mitsui_riesz_poleFree_vertical_integral_le_boundary_integral (B C : ℝ) (D : ℂ → ℂ) (hB_pos : 0 < B) (hB_le : B ≤ 1 / 2) (hC_pos : 0 < C)
    (hD_dlvp : ∀ s : ℂ, 1 - B / Real.log (4 + |s.im|) ≤ s.re →
      DifferentiableAt ℂ D s ∧
