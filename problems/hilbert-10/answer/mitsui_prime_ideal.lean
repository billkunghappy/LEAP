        (((b / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^ (∑ w, a_place w))
        ((b / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)))
  · 
    refine ⟨?_, ?_⟩
    · refine Finset.sum_congr rfl (fun C _ => ?_)
      congr 1
      refine congrArg (fun g : (Fin r → ℝ) → ℂ => ∫ y in Cube, g y) (funext (fun y => ?_))
      exact h_s1 (J_rep C : Ideal R) ψ_f (Or.inr ⟨w₀, hw₀⟩) y (fun i => 2 * y i)
        (((b / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^ (∑ w, a_place w))
        ((b / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)))
    · refine Finset.sum_congr rfl (fun C _ => ?_)
      congr 1
      refine congrArg (fun g : (Fin r → ℝ) → ℂ => ∫ y in Cube, g y) (funext (fun y => ?_))
      exact h_s1 (J_rep C : Ideal R) (fun a => star (ψ_f a)) (Or.inr ⟨w₀, hw₀⟩)
        (fun i => -y i) (fun i => -2 * y i)
        (((b / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^ (∑ w, a_place w))
        ((b / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)))
  · 
    have h_sum_a : (∑ w : NumberField.InfinitePlace K, a_place w) = 0 :=
      Finset.sum_eq_zero (fun w _ => ha0 w)
    have h_term1 : ∀ (C : ClassGroup R) (x : R) (y : Fin r → ℝ),
        ψ_f (Ideal.Quotient.mk f x) *
          (∏ w : NumberField.InfinitePlace K,
            (w.embedding (x : K) *
              ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (y i) : ℝ) : ℂ)) ^ (a_place w)) *
          ((((b / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
              (∑ w : NumberField.InfinitePlace K, a_place w) *
            Real.exp (-Real.pi * (b / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (w (x : K)) ^ 2 *
                  ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) : ℝ) : ℂ) =
        (Real.exp (-Real.pi * (b / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
          ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * (w (x : K)) ^ 2 *
              ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (1 * (2 * y i))) : ℂ) := by
      intro C x y
      have h_prod :
          (∏ w : NumberField.InfinitePlace K,
            (w.embedding (x : K) *
              ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (y i) : ℝ) : ℂ)) ^ (a_place w)) = 1 :=
        Finset.prod_eq_one (fun w _ => by rw [ha0 w, pow_zero])
      rw [hψ_all, h_prod, h_sum_a, pow_zero, one_mul, one_mul, one_mul]
      congr 3
      refine Finset.sum_congr rfl (fun w _ => ?_)
      congr 1
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [one_mul]
    have h_term2 : ∀ (C : ClassGroup R) (x : R) (y : Fin r → ℝ),
        star (ψ_f (Ideal.Quotient.mk f x)) *
          (∏ w : NumberField.InfinitePlace K,
            (w.embedding (x : K) *
              ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) *
          ((((b / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
              (∑ w : NumberField.InfinitePlace K, a_place w) *
            Real.exp (-Real.pi * (b / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (w (x : K)) ^ 2 *
                  ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ) =
        (Real.exp (-Real.pi * (b / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
          ∑ w : NumberField.InfinitePlace K,
