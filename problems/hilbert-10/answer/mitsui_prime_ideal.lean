    have h_not_one_le : ¬ (1 ≤ a₀) := by omega
    rcases h_nonprin_v with ha₀_ge | ⟨hl_real_ang, h_unit_or_cplx⟩
    · exact False.elim (h_not_one_le ha₀_ge)
    · have hl_eq : ∀ w : NumberField.InfinitePlace K, l_eff w = l_ang w :=
        hl_eff_eq_of_zero ha₀_zero hl_real_ang
