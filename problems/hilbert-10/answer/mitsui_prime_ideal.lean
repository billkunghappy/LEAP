  have hC_diff_pos : 0 < C_diff := by dsimp [C_diff]; positivity
  set c' : ℝ := 1 / (4 * ((r : ℝ) + 1) * c)
  have hc'_pos : 0 < c' := by dsimp [c']; positivity
  set K₀ : ℝ := 16 / c' ^ 2 + 1
  have hK₀_pos : 0 < K₀ := by dsimp [K₀]; positivity
  set A_diff : ℝ := c_gen * K₀ ^ r * C_diff
  have hA_diff_pos : 0 < A_diff := by dsimp [A_diff]; positivity
  let c_pp : ℝ := 2 * c + A_diff + 4 * c
  have hc_pp_pos : 0 < c_pp := by dsimp [c_pp]; positivity
  refine ⟨c_pp, hc_pp_pos, ?_⟩
  intro X hX m hm w₀ k hk₀ q hq hq_norm ψ hψ hψ_tors j₀ hj₀
  set Y₀ : ℝ := X ^ n
  have hX_pos : (0 : ℝ) < X := by linarith
  have hY₀_gt_one : 1 < Y₀ := one_lt_pow₀ hX (ne_of_gt hn_pos)
  have hY₀_pos : 0 < Y₀ := by linarith
  have hlogX_pos : 0 < Real.log X := Real.log_pos hX
  have hm_rpos : (0 : ℝ) < (m : ℝ) := Nat.cast_pos.mpr hm
  set t : ℝ := Real.sqrt (Real.log X)
  have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg _
  have ht_sq : t ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlogX_pos)
  set S_exp : ℝ := ∑ w : NumberField.InfinitePlace K,
      (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))
  set Y : ℝ := Y₀ * Real.exp (Real.log X * S_exp)
  have h_sum_nonpos : S_exp ≤ 0 := by
    refine Finset.sum_nonpos (fun w _ => ?_)
    have hkw_lt : (k w : ℕ) < m := (k w).isLt
    have hkw_le : (k w : ℕ) + 1 ≤ m := hkw_lt
    have hkw_rle : ((k w : ℕ) : ℝ) + 1 ≤ (m : ℝ) := by exact_mod_cast hkw_le
    have hnum_nonpos : ((k w : ℕ) : ℝ) + 1 - (m : ℝ) ≤ 0 := by linarith
    have hdiv_nonpos : (((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ) ≤ 0 :=
      div_nonpos_of_nonpos_of_nonneg hnum_nonpos (le_of_lt hm_rpos)
    have hmult_nonneg : (0 : ℝ) ≤ (w.mult : ℝ) := Nat.cast_nonneg w.mult
