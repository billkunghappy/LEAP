    · push_neg at h_prim
      rcases h_prim with ⟨f', hq₁f', hf'_ne, h_triv⟩
      obtain ⟨hf'_ne_zero, h_norm_lt⟩ := h_norm_lt_of_ne q₁ f' hq₁ hq₁f' hf'_ne
      obtain ⟨χ', hχ'_norm_supp, hχ'_lam, hχ'_eq⟩ :=
        h_extend q₁ f' hq₁ hq₁f' χ₁ hχ₁_norm_supp h_triv
      rw [hm] at h_norm_lt
      obtain ⟨f, χ₀, hf'f, hχ₀_norm_supp, hχ₀_lam, hχ₀_prim, hχ₀_eq⟩ :=
        ih (Ideal.absNorm f') h_norm_lt f' hf'_ne_zero rfl χ' hχ'_norm_supp hχ'_lam
      refine ⟨f, χ₀, le_trans hq₁f' hf'f, hχ₀_norm_supp, hχ₀_lam, hχ₀_prim, ?_⟩
      intro I hIq₁
      have hIf' : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ f' = ⊤ :=
        eq_top_iff.mpr (le_trans (ge_of_eq hIq₁) (sup_le_sup_left hq₁f' _))
      rw [← hχ'_eq I hIq₁, hχ₀_eq I hIf']
  have hχ_lam : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ q →
      χ_gr ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = lam_inf x :=
    fun x hx_ne hxq => (hlam_iff x hx_ne _).mpr (hχ_prin x hx_ne hxq)
  obtain ⟨f, χ₀, hqf, hχ₀_norm_supp, hχ₀_lam, hχ₀_prim_lam, hχ_eq⟩ :=
    h_ind (Ideal.absNorm q) q hq rfl χ_gr hχ_norm_supp hχ_lam
  refine ⟨f, χ₀, hqf, hχ₀_norm_supp, ?_, ?_, hχ_eq⟩
  · intro x hx_ne hxf
    exact (hlam_iff x hx_ne _).mp (hχ₀_lam x hx_ne hxf)
  · intro f' hff' hf'_ne
    obtain ⟨x, hx_ne, hx_cop, hx_sub, hx_ne_lam⟩ := hχ₀_prim_lam f' hff' hf'_ne
    refine ⟨x, hx_ne, hx_cop, hx_sub, ?_⟩
    intro y hy_log hy_eq
    exact hx_ne_lam ((hlam_iff x hx_ne _).mpr ⟨y, hy_log, hy_eq⟩)

theorem mitsui_primitive_grossenchar_exists_quotient_char_and_zero_mode_of_units_eq_one {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (l_ang : NumberField.InfinitePlace K → ℤ)
    (h_tors : ∀ ζ ∈ NumberField.Units.torsion K,
      (∏ w : NumberField.InfinitePlace K,
        (w.embedding ((ζ : NumberField.RingOfIntegers K) : K)) ^ (l_ang w)) = 1)
    (v_place : NumberField.InfinitePlace K → ℝ)
    (hv_sum : (∑ w : NumberField.InfinitePlace K, v_place w) = 0)
    (h_nonprin_v :
      (∃ j : Fin (NumberField.Units.rank K),
        (∑ w : NumberField.InfinitePlace K,
          v_place w *
            Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) ≠ 0) ∨
      (∃ w : NumberField.InfinitePlace K, w.IsComplex ∧ l_ang w ≠ 0) ∨
      (∃ w : NumberField.InfinitePlace K, w.IsReal ∧ Odd (l_ang w)))
    (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ₀_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖χ₀ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → χ₀ I = 0))
    (hχ₀_prin_v : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ f →
      χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
        Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I) =
      ∏ w : NumberField.InfinitePlace K,
        (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w))
    (hχ₀_prim_v : ∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
      ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧
        x - 1 ∈ f' ∧
        χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
          Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I) ≠
        ∏ w : NumberField.InfinitePlace K,
          (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w)) :
    let R := NumberField.RingOfIntegers K
    ∃ (l_eff : NumberField.InfinitePlace K → ℤ) (ψ_f : (R ⧸ f) → ℂ),
      (∀ w : NumberField.InfinitePlace K, w.IsReal → (l_eff w = 0 ∨ l_eff w = 1)) ∧
      (∀ w : NumberField.InfinitePlace K, w.IsComplex → (l_eff w).natAbs ≤ (l_ang w).natAbs) ∧
      ψ_f 1 = 1 ∧
      (∀ a b : R ⧸ f, ψ_f (a * b) = ψ_f a * ψ_f b) ∧
      (∀ a : R ⧸ f, (IsUnit a → ‖ψ_f a‖ = 1) ∧ (¬ IsUnit a → ψ_f a = 0)) ∧
      (∀ (x : R) (hx_ne : x ≠ 0),
        χ₀ ⟨Ideal.span ({x} : Set R),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
          Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I) =
        ψ_f (Ideal.Quotient.mk f x) *
          ∏ w : NumberField.InfinitePlace K,
            (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_eff w)) ∧
      (∀ f' : Ideal R, f ≤ f' → f' ≠ f →
        ∃ x : R, IsUnit (Ideal.Quotient.mk f x) ∧ x - 1 ∈ f' ∧ ψ_f (Ideal.Quotient.mk f x) ≠ 1) ∧
      ((f ≠ ⊤ ∧ ψ_f 0 = 0 ∧
          ∀ (h_fin : Fintype (R ⧸ f)), @Finset.sum (R ⧸ f) ℂ _ (@Finset.univ (R ⧸ f) h_fin) ψ_f = 0) ∨
        (f = ⊤ ∧ (∀ a : R ⧸ f, ψ_f a = 1) ∧
          ((∃ w : NumberField.InfinitePlace K, l_eff w ≠ 0) ∨
            ((∀ w : NumberField.InfinitePlace K, l_eff w = 0) ∧
              ∃ i : Fin (NumberField.Units.rank K),
                ∃ k : ℤ, k ≠ 0 ∧
                  (∑ w : NumberField.InfinitePlace K,
                    v_place w * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) =
                    2 * Real.pi * (k : ℝ))))) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let l_eff : NumberField.InfinitePlace K → ℤ := fun w =>
    if w.IsReal then (if Even (l_ang w) then 0 else 1) else l_ang w
  have hl_eff_real : ∀ w : NumberField.InfinitePlace K, w.IsReal → (l_eff w = 0 ∨ l_eff w = 1) := by
    intro w hw
    dsimp [l_eff]
    rw [if_pos hw]
    split_ifs
    · exact Or.inl rfl
    · exact Or.inr rfl
  have hl_eff_cplx : ∀ w : NumberField.InfinitePlace K, w.IsComplex →
      (l_eff w).natAbs ≤ (l_ang w).natAbs := by
    intro w hw
    have hnot_real : ¬ w.IsReal := NumberField.InfinitePlace.not_isReal_iff_isComplex.mpr hw
    dsimp [l_eff]
    rw [if_neg hnot_real]
  have h_eff_prod : ∀ (x : R), x ≠ 0 →
      (∏ w : NumberField.InfinitePlace K,
        (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_eff w)) =
      ∏ w : NumberField.InfinitePlace K,
        (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w) := by
    intro x hx_ne
    let u_w : NumberField.InfinitePlace K → ℂ := fun w => w.embedding (x : K) / (w (x : K) : ℂ)
    have hxK : (x : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx_ne
    have hu_ne : ∀ w : NumberField.InfinitePlace K, u_w w ≠ 0 := by
      intro w
      dsimp [u_w]
      have hw_ne : (w (x : K) : ℂ) ≠ 0 :=
        Complex.ofReal_ne_zero.mpr (ne_of_gt (w.pos_iff.mpr hxK))
      have hemb_ne : w.embedding (x : K) ≠ 0 := map_ne_zero_iff _ (RingHom.injective _) |>.mpr hxK
      exact div_ne_zero hemb_ne hw_ne
    have hu_real_sq : ∀ w : NumberField.InfinitePlace K, w.IsReal → (u_w w) ^ 2 = 1 := by
      intro w hw
      dsimp [u_w]
      have h_emb : w.embedding (x : K) = ((NumberField.InfinitePlace.embedding_of_isReal hw (x : K) : ℝ) : ℂ) :=
        (NumberField.InfinitePlace.embedding_of_isReal_apply hw (x : K)).symm
      have h_norm : w (x : K) = |NumberField.InfinitePlace.embedding_of_isReal hw (x : K)| := by
        rw [← NumberField.InfinitePlace.norm_embedding_of_isReal hw, Real.norm_eq_abs]
      have hw_ne : (w (x : K) : ℂ) ≠ 0 :=
        Complex.ofReal_ne_zero.mpr (ne_of_gt (w.pos_iff.mpr hxK))
      rw [div_pow, div_eq_one_iff_eq (pow_ne_zero 2 hw_ne), h_emb, h_norm]
      norm_cast
      exact (sq_abs _).symm
    refine Finset.prod_congr rfl (fun w _ => ?_)
    change (u_w w) ^ (l_eff w) = (u_w w) ^ (l_ang w)
    dsimp [l_eff]
    by_cases hw : w.IsReal
    · rw [if_pos hw]
      have hsqz : (u_w w) ^ (2 : ℤ) = 1 := by
        exact_mod_cast hu_real_sq w hw
      split_ifs with h_ev
      · rw [zpow_zero]
        obtain ⟨k, hk⟩ := h_ev
        have hk2 : l_ang w = 2 * k := by omega
        rw [hk2, zpow_mul, hsqz, one_zpow]
      · rw [zpow_one]
        obtain ⟨k, hk⟩ := Int.not_even_iff_odd.mp h_ev
        rw [hk, zpow_add₀ (hu_ne w), zpow_one, zpow_mul, hsqz, one_zpow, one_mul]
    · rw [if_neg hw]
  have hχ₀_prin_eff : ∀ (x : R) (hx_ne : x ≠ 0),
      x - 1 ∈ f →
      χ₀ ⟨Ideal.span ({x} : Set R),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
        Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I) =
      ∏ w : NumberField.InfinitePlace K,
        (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_eff w) := by
    intro x hx_ne hx_sub
    rw [h_eff_prod x hx_ne]
    exact hχ₀_prin_v x hx_ne hx_sub
  have hχ₀_prim_eff : ∀ f' : Ideal R, f ≤ f' → f' ≠ f →
      ∃ (x : R) (hx_ne : x ≠ 0),
        Ideal.span ({x} : Set R) ⊔ f = ⊤ ∧
        x - 1 ∈ f' ∧
        χ₀ ⟨Ideal.span ({x} : Set R),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
          Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I) ≠
        ∏ w : NumberField.InfinitePlace K,
          (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_eff w) := by
    intro f' hf_le hf'_ne
    obtain ⟨x, hx_ne, hx_cop, hx_sub, hx_ne_ang⟩ := hχ₀_prim_v f' hf_le hf'_ne
    refine ⟨x, hx_ne, hx_cop, hx_sub, ?_⟩
    rw [h_eff_prod x hx_ne]
    exact hx_ne_ang
  let E_log : R → ℂ := fun x =>
    Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I)
  let A_ang : R → ℂ := fun x =>
    ∏ w : NumberField.InfinitePlace K,
      (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_eff w)
  have hE_norm : ∀ x : R, ‖E_log x‖ = 1 := by
    intro x
    exact Complex.norm_exp_ofReal_mul_I _
  have hE_mul : ∀ (x y : R), x ≠ 0 → y ≠ 0 → E_log (x * y) = E_log x * E_log y := by
    intro x y hx hy
    dsimp [E_log]
    have hxK : (x : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx
    have hyK : (y : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hy
    have hxy_coe : ((x * y : R) : K) = (x : K) * (y : K) := by push_cast; rfl
    have h_sum : (∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w ((x * y : R) : K))) =
        (∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) +
        (∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (y : K))) := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun w _ => ?_)
      have hwx : w (x : K) ≠ 0 := ne_of_gt (w.pos_iff.mpr hxK)
      have hwy : w (y : K) ≠ 0 := ne_of_gt (w.pos_iff.mpr hyK)
      rw [hxy_coe, map_mul, Real.log_mul hwx hwy, mul_add]
    rw [h_sum, Complex.ofReal_add, add_mul, Complex.exp_add]
  have hA_norm : ∀ (x : R), x ≠ 0 → ‖A_ang x‖ = 1 := by
    intro x hx
    dsimp [A_ang]
    rw [norm_prod]
    refine Finset.prod_eq_one (fun w _ => ?_)
    have hxK : (x : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx
    have hwx_pos : 0 < w (x : K) := w.pos_iff.mpr hxK
    rw [norm_zpow, norm_div, NumberField.InfinitePlace.norm_embedding_eq,
      Complex.norm_real, Real.norm_eq_abs, abs_of_pos hwx_pos,
      div_self (ne_of_gt hwx_pos), one_zpow]
  have hA_ne : ∀ (x : R), x ≠ 0 → A_ang x ≠ 0 := by
    intro x hx
    exact norm_ne_zero_iff.mp (by rw [hA_norm x hx]; exact one_ne_zero)
  have hA_mul : ∀ (x y : R), A_ang (x * y) = A_ang x * A_ang y := by
    intro x y
    dsimp [A_ang]
    rw [← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl (fun w _ => ?_)
    have hxy_coe : ((x * y : R) : K) = (x : K) * (y : K) := by push_cast; rfl
    rw [hxy_coe, map_mul, map_mul, Complex.ofReal_mul, mul_div_mul_comm, mul_zpow]
  have h_unit_iff_sup : ∀ x : R,
      IsUnit (Ideal.Quotient.mk f x) ↔
        Ideal.span ({x} : Set R) ⊔ f = ⊤ := by
    intro x
    constructor
    · intro hx
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (↑(hx.unit⁻¹) : R ⧸ f)
      have h_mk_zero : Ideal.Quotient.mk f (1 - x * y) = 0 := by
        rw [map_sub, map_one, map_mul, ← hx.unit_spec, hy, Units.mul_inv, sub_self]
      have h_mem_f : 1 - x * y ∈ f := Ideal.Quotient.eq_zero_iff_mem.mp h_mk_zero
      have h_mem_span : x * y ∈ Ideal.span ({x} : Set R) :=
        Ideal.mem_span_singleton.mpr ⟨y, rfl⟩
      rw [Ideal.eq_top_iff_one, Submodule.mem_sup]
      exact ⟨x * y, h_mem_span, 1 - x * y, h_mem_f, add_sub_cancel (x * y) 1⟩
    · intro h_top
      have h_one : (1 : R) ∈ Ideal.span ({x} : Set R) ⊔ f :=
        (Ideal.eq_top_iff_one _).mp h_top
      obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp h_one
      obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton.mp ha
      have h_mk : Ideal.Quotient.mk f x * Ideal.Quotient.mk f y = 1 := by
        have h1 := congrArg (Ideal.Quotient.mk f) hab
        rw [map_add, map_mul, map_one, Ideal.Quotient.eq_zero_iff_mem.mpr hb, add_zero] at h1
        exact h1
      exact IsUnit.of_mul_eq_one (Ideal.Quotient.mk f y) h_mk
  have hf_bot : f ≠ ⊥ := hf
  obtain ⟨z₀, hz₀_mem, hz₀_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hf_bot
  have hz₀_mk : Ideal.Quotient.mk f z₀ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hz₀_mem
  let x₀ : (R ⧸ f) → R := fun a => (Ideal.Quotient.mk_surjective a).choose
  have hx₀ : ∀ a : R ⧸ f, Ideal.Quotient.mk f (x₀ a) = a :=
    fun a => (Ideal.Quotient.mk_surjective a).choose_spec
  let lift_nz : (R ⧸ f) → R := fun a => if x₀ a = 0 then z₀ else x₀ a
  have hlift_ne : ∀ a : R ⧸ f, lift_nz a ≠ 0 := by
    intro a
    dsimp [lift_nz]
    split_ifs with h0
    · exact hz₀_ne
    · exact h0
  have hlift_mk : ∀ a : R ⧸ f, Ideal.Quotient.mk f (lift_nz a) = a := by
    intro a
    dsimp [lift_nz]
    split_ifs with h0
    · rw [hz₀_mk, ← hx₀ a, h0, map_zero]
    · exact hx₀ a
  let P : ∀ (x : R), x ≠ 0 → nonZeroDivisors (Ideal R) :=
    fun x hx => ⟨Ideal.span ({x} : Set R),
      mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx)⟩
  have hP_mul : ∀ (x y : R) (hx : x ≠ 0) (hy : y ≠ 0),
      P (x * y) (mul_ne_zero hx hy) = P x hx * P y hy := by
    intro x y hx hy
    exact Subtype.ext (Ideal.span_singleton_mul_span_singleton x y).symm
  let F : ∀ (x : R), x ≠ 0 → ℂ := fun x hx => χ₀ (P x hx) * E_log x * (A_ang x)⁻¹
  have hF_mul : ∀ (x y : R) (hx : x ≠ 0) (hy : y ≠ 0),
       F (x * y) (mul_ne_zero hx hy) = F x hx * F y hy := by
    intro x y hx hy
    dsimp [F]
    rw [hP_mul x y hx hy, map_mul, hE_mul x y hx hy, hA_mul x y, mul_inv]
    ring
  have hF_ray : ∀ (x : R) (hx : x ≠ 0), x - 1 ∈ f → F x hx = 1 := by
    intro x hx hx_sub
    dsimp [F]
    have h_prin : χ₀ (P x hx) * E_log x = A_ang x := hχ₀_prin_eff x hx hx_sub
    rw [h_prin, mul_inv_cancel₀ (hA_ne x hx)]
  have hF_norm_supp : ∀ (x : R) (hx : x ≠ 0),
      ((P x hx : Ideal R) ⊔ f = ⊤ → ‖F x hx‖ = 1) ∧
      (¬ ((P x hx : Ideal R) ⊔ f = ⊤) → F x hx = 0) := by
    intro x hx
    constructor
    · intro h_top
      dsimp [F]
      rw [norm_mul, norm_mul, norm_inv, (hχ₀_norm_supp (P x hx)).1 h_top,
        hE_norm x, hA_norm x hx, inv_one, mul_one, mul_one]
    · intro h_not_top
      dsimp [F]
      rw [(hχ₀_norm_supp (P x hx)).2 h_not_top, zero_mul, zero_mul]
  have h_congr : ∀ (x y : R) (hx : x ≠ 0) (hy : y ≠ 0),
      Ideal.Quotient.mk f x = Ideal.Quotient.mk f y →
      F x hx = F y hy := by
    intro x y hx hy h_eq
    by_cases hu : IsUnit (Ideal.Quotient.mk f x)
    · let u_x : (R ⧸ f)ˣ := hu.unit
      have hu_x_eq : (u_x : R ⧸ f) = Ideal.Quotient.mk f x := hu.unit_spec
      let b : R ⧸ f := ↑(u_x⁻¹)
      let z : R := lift_nz b
      have hz : z ≠ 0 := hlift_ne b
      have hxz_mk : Ideal.Quotient.mk f (x * z) = Ideal.Quotient.mk f 1 := by
        rw [map_mul, hlift_mk b]
        change Ideal.Quotient.mk f x * ↑(u_x⁻¹) = Ideal.Quotient.mk f 1
        rw [← hu_x_eq, Units.mul_inv, map_one]
      have hyz_mk : Ideal.Quotient.mk f (y * z) = Ideal.Quotient.mk f 1 := by
        rw [map_mul, ← h_eq, ← map_mul, hxz_mk]
      have hxz_sub : x * z - 1 ∈ f :=
        (Ideal.Quotient.mk_eq_mk_iff_sub_mem (x * z) 1).mp hxz_mk
      have hyz_sub : y * z - 1 ∈ f :=
        (Ideal.Quotient.mk_eq_mk_iff_sub_mem (y * z) 1).mp hyz_mk
      have hxz_ray : F x hx * F z hz = 1 := by
        rw [← hF_mul x z hx hz]
        exact hF_ray (x * z) (mul_ne_zero hx hz) hxz_sub
      have hyz_ray : F y hy * F z hz = 1 := by
        rw [← hF_mul y z hy hz]
        exact hF_ray (y * z) (mul_ne_zero hy hz) hyz_sub
      have hz_ne_zero : F z hz ≠ 0 := right_ne_zero_of_mul_eq_one hxz_ray
      exact mul_right_cancel₀ hz_ne_zero (hxz_ray.trans hyz_ray.symm)
    · have hy_u : ¬ IsUnit (Ideal.Quotient.mk f y) := h_eq ▸ hu
      have hx_not_top : ¬ ((P x hx : Ideal R) ⊔ f = ⊤) :=
        fun h_top => hu ((h_unit_iff_sup x).mpr h_top)
      have hy_not_top : ¬ ((P y hy : Ideal R) ⊔ f = ⊤) :=
