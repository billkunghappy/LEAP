      linarith [h_collar_tail_le, h_grid_δ_le]
    calc (2 * (A_collar + ε_tail) + C_grid * δ * (Real.log X + 1) ^ (NumberField.Units.rank K)) * Ψ₁_K
      _ ≤ ((6 * C_coeff + C_gcoeff) * Real.exp (-t / (2 / c'))) * ((1 + c_base) * Real.exp 1 * Y₀) :=
        mul_le_mul h_factor_le hΨ₁_K_bound hΨ₁_K_nonneg (by positivity)
      _ = (Real.exp 1 * ((6 * C_coeff + C_gcoeff) * (1 + c_base))) * Y₀ * Real.exp (-t / (2 / c')) := by ring
      _ ≤ (Real.exp 1 * ((6 * C_coeff + C_gcoeff) * (1 + c_base))) * Y₀ * Real.exp (-t / c_coord) :=
        mul_le_mul_of_nonneg_left hexp_2c'_le_c_coord (by positivity)
  have h_term_vol_diff :
      Vol * |Ψ₁_K - Z| ≤
      (Real.exp 1 * (C_vcoeff * c_base)) * Y₀ * Real.exp (-t / c_coord) := by
    calc Vol * |Ψ₁_K - Z|
      _ ≤ (C_vcoeff * Real.exp (c' * t / 2)) * (c_base * Real.exp 1 * Y₀ * Real.exp (-t / c_base)) :=
        mul_le_mul hVol_le hΨ₁_K_diff_le (abs_nonneg _) (by positivity)
      _ = (Real.exp 1 * (C_vcoeff * c_base)) * Y₀ * (Real.exp (c' * t / 2) * Real.exp (-t / c_base)) := by ring
      _ ≤ (Real.exp 1 * (C_vcoeff * c_base)) * Y₀ * Real.exp (-t / (2 * c_base)) :=
        mul_le_mul_of_nonneg_left h_exp_0_le (by positivity)
