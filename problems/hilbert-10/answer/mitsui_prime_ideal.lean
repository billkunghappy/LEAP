  obtain ⟨c_gen, hc_gen_pos, hc_gen⟩ := h_units_card
  refine ⟨c_gen, hc_gen_pos, fun X hX m hm w₀ k I hI => ?_⟩
  let CellGen := {x : NumberField.RingOfIntegers K //
