    have h_eq : Complex.I * (∫ t in 0..T, F_D t) - (F_pos T - F_pos 0) =
        ∑ k ∈ Finset.range N, (Complex.I * (∫ t in tk k..tk (k + 1), F_D t) - (F_pos (tk (k + 1)) - F_pos (tk k))) := by
      rw [Finset.sum_sub_distrib, ← Finset.mul_sum, h_pos_sum_F, h_pos_sum_H]
    rw [h_eq]
    calc ‖∑ k ∈ Finset.range N, (Complex.I * (∫ t in tk k..tk (k + 1), F_D t) - (F_pos (tk (k + 1)) - F_pos (tk k)))‖
      _ ≤ ∑ k ∈ Finset.range N, ‖Complex.I * (∫ t in tk k..tk (k + 1), F_D t) - (F_pos (tk (k + 1)) - F_pos (tk k))‖ :=
          norm_sum_le _ _
      _ ≤ ∑ k ∈ Finset.range N, (5 / 2) * C * (∫ t in tk k..tk (k + 1), g t) :=
          Finset.sum_le_sum (fun k hk => (h_k_step k hk).1)
      _ = (5 / 2) * C * (∑ k ∈ Finset.range N, ∫ t in tk k..tk (k + 1), g t) := by
          rw [← Finset.mul_sum]
      _ = (5 / 2) * C * (∫ t in 0..T, g t) := by rw [h_pos_sum_g]
  have h_neg_sum_F : (∑ k ∈ Finset.range N, ∫ t in (-tk (k + 1))..(-tk k), F_D t) = ∫ t in (-T)..0, F_D t := by
    have h_term : ∀ k : ℕ, (∫ t in (-tk (k + 1))..(-tk k), F_D t) =
        (∫ t in (-tk (k + 1))..0, F_D t) - (∫ t in (-tk k)..0, F_D t) := by
      intro k
      have h_adj := intervalIntegral.integral_add_adjacent_intervals
        (hF_D_ii (-tk (k + 1)) (-tk k)) (hF_D_ii (-tk k) 0)
      exact eq_sub_of_add_eq h_adj
    simp_rw [h_term]
    rw [Finset.sum_range_sub (fun k => ∫ t in (-tk k)..0, F_D t) N, htk_N, htk_zero, neg_zero,
      intervalIntegral.integral_same, sub_zero]
  have h_neg_sum_g : (∑ k ∈ Finset.range N, ∫ t in (-tk (k + 1))..(-tk k), g t) = ∫ t in (-T)..0, g t := by
    have h_term : ∀ k : ℕ, (∫ t in (-tk (k + 1))..(-tk k), g t) =
        (∫ t in (-tk (k + 1))..0, g t) - (∫ t in (-tk k)..0, g t) := by
      intro k
      have h_adj := intervalIntegral.integral_add_adjacent_intervals
        (hg_ii (-tk (k + 1)) (-tk k)) (hg_ii (-tk k) 0)
      exact eq_sub_of_add_eq h_adj
    simp_rw [h_term]
    rw [Finset.sum_range_sub (fun k => ∫ t in (-tk k)..0, g t) N, htk_N, htk_zero, neg_zero,
      intervalIntegral.integral_same, sub_zero]
  have h_neg_sum_H : (∑ k ∈ Finset.range N, (F_neg (tk k) - F_neg (tk (k + 1)))) = F_neg 0 - F_neg T := by
    rw [Finset.sum_range_sub' (fun k => F_neg (tk k)) N, htk_zero, htk_N]
  have h_neg_tele : ‖Complex.I * (∫ t in (-T)..0, F_D t) - (F_neg 0 - F_neg T)‖ ≤
      (5 / 2) * C * (∫ t in (-T)..0, g t) := by
    have h_eq : Complex.I * (∫ t in (-T)..0, F_D t) - (F_neg 0 - F_neg T) =
        ∑ k ∈ Finset.range N, (Complex.I * (∫ t in (-tk (k + 1))..(-tk k), F_D t) - (F_neg (tk k) - F_neg (tk (k + 1)))) := by
      rw [Finset.sum_sub_distrib, ← Finset.mul_sum, h_neg_sum_F, h_neg_sum_H]
    rw [h_eq]
    calc ‖∑ k ∈ Finset.range N, (Complex.I * (∫ t in (-tk (k + 1))..(-tk k), F_D t) - (F_neg (tk k) - F_neg (tk (k + 1))))‖
      _ ≤ ∑ k ∈ Finset.range N, ‖Complex.I * (∫ t in (-tk (k + 1))..(-tk k), F_D t) - (F_neg (tk k) - F_neg (tk (k + 1)))‖ :=
          norm_sum_le _ _
      _ ≤ ∑ k ∈ Finset.range N, (5 / 2) * C * (∫ t in (-tk (k + 1))..(-tk k), g t) :=
          Finset.sum_le_sum (fun k hk => (h_k_step k hk).2)
      _ = (5 / 2) * C * (∑ k ∈ Finset.range N, ∫ t in (-tk (k + 1))..(-tk k), g t) := by
          rw [← Finset.mul_sum]
      _ = (5 / 2) * C * (∫ t in (-T)..0, g t) := by rw [h_neg_sum_g]
  have h_add_F : (∫ t in (-T)..0, F_D t) + (∫ t in 0..T, F_D t) = ∫ t in (-T)..T, F_D t :=
    intervalIntegral.integral_add_adjacent_intervals (hF_D_ii (-T) 0) (hF_D_ii 0 T)
  have h_add_g : (∫ t in (-T)..0, g t) + (∫ t in 0..T, g t) = ∫ t in (-T)..T, g t :=
    intervalIntegral.integral_add_adjacent_intervals (hg_ii (-T) 0) (hg_ii 0 T)
  have h_comb_id : Complex.I * (∫ t in (-T)..T, F_D t) - (F_pos T - F_neg T) =
      (Complex.I * (∫ t in (-T)..0, F_D t) - (F_neg 0 - F_neg T)) +
        (Complex.I * (∫ t in 0..T, F_D t) - (F_pos T - F_pos 0)) := by
    rw [← h_add_F, hF_zero_eq]
    ring
  have h_comb_norm : ‖Complex.I * (∫ t in (-T)..T, F_D t) - (F_pos T - F_neg T)‖ ≤
      (5 / 2) * C * (∫ t in (-T)..T, g t) := by
    rw [h_comb_id, ← h_add_g]
    have h_tri := norm_add_le
      (Complex.I * (∫ t in (-T)..0, F_D t) - (F_neg 0 - F_neg T))
      (Complex.I * (∫ t in 0..T, F_D t) - (F_pos T - F_pos 0))
    linarith
  have h_final_opaque : ‖∫ t in (-T)..T, F_D t‖ ≤
      (5 / 2) * C * (∫ t in (-T)..T, g t) + (‖F_pos T‖ + ‖F_neg T‖) := by
    set Z := ∫ t in (-T)..T, F_D t
    have hZ_norm : ‖Z‖ = ‖Complex.I * Z‖ := by
      rw [norm_mul, Complex.norm_I, one_mul]
    have h1 : ‖Complex.I * Z‖ ≤ ‖Complex.I * Z - (F_pos T - F_neg T)‖ + ‖F_pos T - F_neg T‖ := by
      calc ‖Complex.I * Z‖
        _ = ‖(Complex.I * Z - (F_pos T - F_neg T)) + (F_pos T - F_neg T)‖ := by ring_nf
        _ ≤ ‖Complex.I * Z - (F_pos T - F_neg T)‖ + ‖F_pos T - F_neg T‖ :=
            norm_add_le (Complex.I * Z - (F_pos T - F_neg T)) (F_pos T - F_neg T)
    have h2 : ‖F_pos T - F_neg T‖ ≤ ‖F_pos T‖ + ‖F_neg T‖ := norm_sub_le (F_pos T) (F_neg T)
    linarith
  have hF_neg_T : F_neg T = ∫ x in (1 - B / (M + Real.log (4 + |T|)))..2,
      ((Y : ℂ) ^ ((x : ℂ) - (T : ℂ) * Complex.I) / ((x : ℂ) - (T : ℂ) * Complex.I) ^ 2) *
        D ((x : ℂ) - (T : ℂ) * Complex.I) := by
    rw [hF_neg_def, hσ_def, hH_def]
    refine intervalIntegral.integral_congr (fun x _ => ?_)
    dsimp only []
    rw [Complex.ofReal_neg, neg_mul, ← sub_eq_add_neg]
  have hF_pos_T : F_pos T = ∫ x in (1 - B / (M + Real.log (4 + |T|)))..2,
      ((Y : ℂ) ^ ((x : ℂ) + (T : ℂ) * Complex.I) / ((x : ℂ) + (T : ℂ) * Complex.I) ^ 2) *
        D ((x : ℂ) + (T : ℂ) * Complex.I) := by
    rw [hF_pos_def, hσ_def, hH_def]
  have hF_D_int : (∫ t in (-T)..T, F_D t) = ∫ t in (-T)..T,
      ((Y : ℂ) ^ (2 + (t : ℂ) * Complex.I) / (2 + (t : ℂ) * Complex.I) ^ 2) *
        D (2 + (t : ℂ) * Complex.I) := by
    rw [hF_D_def, hH_def]
  have hg_int : (∫ t in (-T)..T, g t) = ∫ t in (-T)..T,
      Y ^ (1 - B / (M + Real.log (4 + |t|))) * ((M + Real.log (4 + |t|)) / (1 / 4 + t ^ 2)) := by
    rw [hg_def, hσ_def]
  rw [← hF_D_int, ← hg_int, ← hF_pos_T, ← hF_neg_T]
  exact h_final_opaque

theorem mitsui_riesz_poleFree_conductor_horiz_caps_tendsto_zero (B C M : ℝ) (D : ℂ → ℂ) (hB_pos : 0 < B) (hB_le : B ≤ 1 / 2) (hC_pos : 0 < C) (hM : 1 ≤ M)
    (hD_dlvp : ∀ s : ℂ, 1 - B / (M + Real.log (4 + |s.im|)) ≤ s.re →
      DifferentiableAt ℂ D s ∧
      ‖D s‖ ≤ C * (M + Real.log (4 + |s.im|)))
    (Y : ℝ) (hY : 1 < Y) :
    Filter.Tendsto
      (fun T : ℝ =>
        ‖∫ x in (1 - B / (M + Real.log (4 + |T|)))..2,
          ((Y : ℂ) ^ ((x : ℂ) + (T : ℂ) * Complex.I) / ((x : ℂ) + (T : ℂ) * Complex.I) ^ 2) *
            D ((x : ℂ) + (T : ℂ) * Complex.I)‖ +
        ‖∫ x in (1 - B / (M + Real.log (4 + |T|)))..2,
          ((Y : ℂ) ^ ((x : ℂ) - (T : ℂ) * Complex.I) / ((x : ℂ) - (T : ℂ) * Complex.I) ^ 2) *
            D ((x : ℂ) - (T : ℂ) * Complex.I)‖)
      Filter.atTop (nhds 0) :=
by
  have hY_pos : 0 < Y := by linarith
  set σ : ℝ → ℝ := fun T => 1 - B / (M + Real.log (4 + |T|))
  set E_horiz : ℝ → ℝ := fun T =>
    ‖∫ x in (σ T)..2,
        ((Y : ℂ) ^ ((x : ℂ) + (T : ℂ) * Complex.I) / ((x : ℂ) + (T : ℂ) * Complex.I) ^ 2) *
          D ((x : ℂ) + (T : ℂ) * Complex.I)‖ +
      ‖∫ x in (σ T)..2,
        ((Y : ℂ) ^ ((x : ℂ) - (T : ℂ) * Complex.I) / ((x : ℂ) - (T : ℂ) * Complex.I) ^ 2) *
          D ((x : ℂ) - (T : ℂ) * Complex.I)‖
  have h_cap_bound : ∀ (T : ℝ), 4 + M ≤ T → ∀ (y : ℝ), |y| = T →
      ‖∫ x in (σ T)..2,
        ((Y : ℂ) ^ ((x : ℂ) + (y : ℂ) * Complex.I) / ((x : ℂ) + (y : ℂ) * Complex.I) ^ 2) *
          D ((x : ℂ) + (y : ℂ) * Complex.I)‖ ≤ (6 * Y ^ 2 * C) * T⁻¹ := by
    intro T hTM y hy
    have hT4 : 4 ≤ T := by linarith
    have hMT : M ≤ T := by linarith
    have hT_pos : 0 < T := by linarith
    have habsT : |T| = T := abs_of_pos hT_pos
    have h_log_ge_one : 1 ≤ Real.log (4 + |T|) := by
      have hexp1 : Real.exp 1 ≤ 4 + |T| := by
        have h1 := Real.exp_one_lt_d9
        have h2 : 0 ≤ |T| := abs_nonneg T
        linarith
      have h_le := Real.log_le_log (Real.exp_pos 1) hexp1
      rwa [Real.log_exp] at h_le
    have h_denom_ge_one : 1 ≤ M + Real.log (4 + |T|) := by linarith
    have h_div_le : B / (M + Real.log (4 + |T|)) ≤ 1 / 2 := by
      have h1 : B / (M + Real.log (4 + |T|)) ≤ B / 1 :=
        div_le_div_of_nonneg_left (le_of_lt hB_pos) zero_lt_one h_denom_ge_one
      linarith
    have h_div_pos : 0 < B / (M + Real.log (4 + |T|)) :=
      div_pos hB_pos (lt_of_lt_of_le zero_lt_one h_denom_ge_one)
    have hσ_ge : 1 / 2 ≤ σ T := by
      dsimp [σ]
      linarith
    have hσ_le_two : σ T ≤ 2 := by
      dsimp [σ]
      linarith
    have h_len_le : |2 - σ T| ≤ 2 := by
      rw [abs_of_pos (by dsimp [σ]; linarith)]
      dsimp [σ]
      linarith
    have h_denom_le_three_T : M + Real.log (4 + |T|) ≤ 3 * T := by
      rw [habsT]
      have h_sub := Real.log_le_sub_one_of_pos (by linarith : 0 < 4 + T)
      linarith
    have h_ptwise : ∀ x ∈ Set.uIoc (σ T) 2,
        ‖((Y : ℂ) ^ ((x : ℂ) + (y : ℂ) * Complex.I) / ((x : ℂ) + (y : ℂ) * Complex.I) ^ 2) *
          D ((x : ℂ) + (y : ℂ) * Complex.I)‖ ≤ (3 * Y ^ 2 * C) * T⁻¹ := by
      intro x hx
      rw [Set.uIoc_of_le hσ_le_two, Set.mem_Ioc] at hx
      set s : ℂ := (x : ℂ) + (y : ℂ) * Complex.I
      have hs_re : s.re = x := by simp [s]
      have hs_im : s.im = y := by simp [s]
      have hs_dlvp : 1 - B / (M + Real.log (4 + |s.im|)) ≤ s.re := by
        rw [hs_re, hs_im, hy, ← habsT]
        exact le_of_lt hx.1
      have hD_le : ‖D s‖ ≤ 3 * C * T := by
        have h1 := (hD_dlvp s hs_dlvp).2
        rw [hs_im, hy, ← habsT] at h1
        calc ‖D s‖ ≤ C * (M + Real.log (4 + |T|)) := h1
          _ ≤ C * (3 * T) := mul_le_mul_of_nonneg_left h_denom_le_three_T (le_of_lt hC_pos)
          _ = 3 * C * T := by ring
      have h_cpow_le : ‖(Y : ℂ) ^ s‖ ≤ Y ^ 2 := by
        rw [Complex.norm_cpow_eq_rpow_re_of_pos hY_pos s, hs_re]
        calc Y ^ x ≤ Y ^ (2 : ℝ) := Real.rpow_le_rpow_of_exponent_le (le_of_lt hY) hx.2
          _ = Y ^ 2 := Real.rpow_two Y
      have h_denom_ge : T ^ 2 ≤ ‖s ^ 2‖ := by
        have h_normSq : Complex.normSq s = x ^ 2 + T ^ 2 := by
          rw [Complex.normSq_apply, hs_re, hs_im]
          have hy_sq : y * y = T ^ 2 := by
            calc y * y = |y| ^ 2 := by rw [sq_abs]; ring
              _ = T ^ 2 := by rw [hy]
          linarith [hy_sq, sq x]
        rw [norm_pow, Complex.sq_norm, h_normSq]
        have : 0 ≤ x ^ 2 := sq_nonneg x
        linarith
      have h_denom_pos : 0 < T ^ 2 := by positivity
      have h_frac_le : ‖(Y : ℂ) ^ s / s ^ 2‖ ≤ Y ^ 2 / T ^ 2 := by
        rw [norm_div]
        exact div_le_div₀ (by positivity) h_cpow_le h_denom_pos h_denom_ge
      rw [norm_mul]
      calc ‖(Y : ℂ) ^ s / s ^ 2‖ * ‖D s‖
        _ ≤ (Y ^ 2 / T ^ 2) * (3 * C * T) :=
          mul_le_mul h_frac_le hD_le (norm_nonneg _) (by positivity)
        _ = (3 * Y ^ 2 * C) * T⁻¹ := by
          have hT_ne : T ≠ 0 := ne_of_gt hT_pos
          field_simp [hT_ne]
    have h_int := intervalIntegral.norm_integral_le_of_norm_le_const h_ptwise
    calc ‖∫ x in (σ T)..2,
          ((Y : ℂ) ^ ((x : ℂ) + (y : ℂ) * Complex.I) / ((x : ℂ) + (y : ℂ) * Complex.I) ^ 2) *
            D ((x : ℂ) + (y : ℂ) * Complex.I)‖
      _ ≤ ((3 * Y ^ 2 * C) * T⁻¹) * |2 - σ T| := h_int
      _ ≤ ((3 * Y ^ 2 * C) * T⁻¹) * 2 :=
          mul_le_mul_of_nonneg_left h_len_le (by positivity)
      _ = (6 * Y ^ 2 * C) * T⁻¹ := by ring
  have h_nonneg : ∀ᶠ T : ℝ in Filter.atTop, 0 ≤ E_horiz T :=
    Filter.Eventually.of_forall (fun T => add_nonneg (norm_nonneg _) (norm_nonneg _))
  have h_upper : ∀ᶠ T : ℝ in Filter.atTop, E_horiz T ≤ (12 * Y ^ 2 * C) * T⁻¹ := by
    filter_upwards [Filter.eventually_ge_atTop (4 + M)] with T hTM
    have hT_pos : 0 < T := by linarith
    have habsT : |T| = T := abs_of_pos hT_pos
    have habs_negT : |-T| = T := by rw [abs_neg, habsT]
    have h_top := h_cap_bound T hTM T habsT
    have h_bot_eq :
        (∫ x in (σ T)..2,
          ((Y : ℂ) ^ ((x : ℂ) - (T : ℂ) * Complex.I) / ((x : ℂ) - (T : ℂ) * Complex.I) ^ 2) *
            D ((x : ℂ) - (T : ℂ) * Complex.I)) =
        ∫ x in (σ T)..2,
          ((Y : ℂ) ^ ((x : ℂ) + ((-T : ℝ) : ℂ) * Complex.I) /
              ((x : ℂ) + ((-T : ℝ) : ℂ) * Complex.I) ^ 2) *
            D ((x : ℂ) + ((-T : ℝ) : ℂ) * Complex.I) := by
      congr 1
      ext x
      have hx_sub : (x : ℂ) - (T : ℂ) * Complex.I = (x : ℂ) + ((-T : ℝ) : ℂ) * Complex.I := by
        push_cast
        ring
      rw [hx_sub]
    have h_bot :
        ‖∫ x in (σ T)..2,
          ((Y : ℂ) ^ ((x : ℂ) - (T : ℂ) * Complex.I) / ((x : ℂ) - (T : ℂ) * Complex.I) ^ 2) *
            D ((x : ℂ) - (T : ℂ) * Complex.I)‖ ≤ (6 * Y ^ 2 * C) * T⁻¹ := by
      rw [h_bot_eq]
      exact h_cap_bound T hTM (-T) habs_negT
    dsimp [E_horiz]
    linarith
  have h_maj_tendsto : Filter.Tendsto (fun T : ℝ => (12 * Y ^ 2 * C) * T⁻¹) Filter.atTop (nhds 0) := by
    have h := tendsto_inv_atTop_zero.const_mul (12 * Y ^ 2 * C)
    rwa [mul_zero] at h
  exact squeeze_zero' h_nonneg h_upper h_maj_tendsto

theorem mitsui_riesz_poleFree_conductor_vertical_integral_le_boundary_integral (B C M : ℝ) (D : ℂ → ℂ) (hB_pos : 0 < B) (hB_le : B ≤ 1 / 2) (hC_pos : 0 < C) (hM : 1 ≤ M)
    (hD_dlvp : ∀ s : ℂ, 1 - B / (M + Real.log (4 + |s.im|)) ≤ s.re →
      DifferentiableAt ℂ D s ∧
      ‖D s‖ ≤ C * (M + Real.log (4 + |s.im|)))
    (Y : ℝ) (hY : 1 < Y) :
    ‖((1 / (2 * Real.pi) : ℝ) : ℂ) *
        (∫ t : ℝ,
          ((Y : ℂ) ^ (2 + (t : ℂ) * Complex.I) / (2 + (t : ℂ) * Complex.I) ^ 2) *
            D (2 + (t : ℂ) * Complex.I))‖ ≤
      C * ∫ t : ℝ, Y ^ (1 - B / (M + Real.log (4 + |t|))) * ((M + Real.log (4 + |t|)) / (1 / 4 + t ^ 2)) :=
by
  have hY_pos : 0 < Y := by linarith
  have hInt_vert :=
    mitsui_riesz_poleFree_conductor_vertical_integrable B C M D hB_pos hB_le hC_pos hM hD_dlvp Y hY
  have hInt_bound :=
    mitsui_riesz_poleFree_conductor_boundary_integrable B M hB_pos hM Y hY
  have h_horiz_tendsto :=
    mitsui_riesz_poleFree_conductor_horiz_caps_tendsto_zero B C M D hB_pos hB_le hC_pos hM hD_dlvp Y hY
  set F_D : ℝ → ℂ := fun t =>
    ((Y : ℂ) ^ (2 + (t : ℂ) * Complex.I) / (2 + (t : ℂ) * Complex.I) ^ 2) *
      D (2 + (t : ℂ) * Complex.I)
  set g : ℝ → ℝ := fun t =>
    Y ^ (1 - B / (M + Real.log (4 + |t|))) * ((M + Real.log (4 + |t|)) / (1 / 4 + t ^ 2))
  set E_horiz : ℝ → ℝ := fun T =>
    ‖∫ x in (1 - B / (M + Real.log (4 + |T|)))..2,
        ((Y : ℂ) ^ ((x : ℂ) + (T : ℂ) * Complex.I) / ((x : ℂ) + (T : ℂ) * Complex.I) ^ 2) *
          D ((x : ℂ) + (T : ℂ) * Complex.I)‖ +
      ‖∫ x in (1 - B / (M + Real.log (4 + |T|)))..2,
        ((Y : ℂ) ^ ((x : ℂ) - (T : ℂ) * Complex.I) / ((x : ℂ) - (T : ℂ) * Complex.I) ^ 2) *
          D ((x : ℂ) - (T : ℂ) * Complex.I)‖
  have hg_nonneg : ∀ t : ℝ, 0 ≤ g t := by
    intro t
    dsimp [g]
    have h4t : 1 < 4 + |t| := by
      have : 0 ≤ |t| := abs_nonneg t
      linarith
    have hlog : 0 < Real.log (4 + |t|) := Real.log_pos h4t
    have hM_log : 0 < M + Real.log (4 + |t|) := by linarith
    positivity
  have h_trunc_le_global : ∀ T : ℝ, 0 < T → (∫ t in (-T)..T, g t) ≤ ∫ t : ℝ, g t := by
    intro T hT
    rw [intervalIntegral.integral_of_le (by linarith : -T ≤ T)]
    exact MeasureTheory.setIntegral_le_integral hInt_bound (Filter.Eventually.of_forall hg_nonneg)
  have h_ev : ∀ᶠ T : ℝ in Filter.atTop,
      ‖∫ t in (-T)..T, F_D t‖ ≤ (5 / 2) * C * (∫ t : ℝ, g t) + E_horiz T := by
    filter_upwards [Filter.eventually_ge_atTop (1 : ℝ)] with T hT1
    have hT : 0 < T := by linarith
    have h1 : ‖∫ t in (-T)..T, F_D t‖ ≤ (5 / 2) * C * (∫ t in (-T)..T, g t) + E_horiz T :=
      mitsui_riesz_poleFree_conductor_truncated_vertical_le_boundary_add_horiz
        B C M D hB_pos hB_le hC_pos hM hD_dlvp Y hY T hT
    have h2 : (5 / 2) * C * (∫ t in (-T)..T, g t) ≤ (5 / 2) * C * (∫ t : ℝ, g t) :=
      mul_le_mul_of_nonneg_left (h_trunc_le_global T hT) (by positivity)
    exact le_trans h1 (add_le_add h2 (le_refl (E_horiz T)))
  have h_lhs_tendsto : Filter.Tendsto (fun T : ℝ => ‖∫ t in (-T)..T, F_D t‖)
      Filter.atTop (nhds ‖∫ t : ℝ, F_D t‖) :=
    (MeasureTheory.intervalIntegral_tendsto_integral hInt_vert
      Filter.tendsto_neg_atTop_atBot Filter.tendsto_id).norm
  have h_rhs_tendsto : Filter.Tendsto (fun T : ℝ => (5 / 2) * C * (∫ t : ℝ, g t) + E_horiz T)
      Filter.atTop (nhds ((5 / 2) * C * (∫ t : ℝ, g t))) := by
    simpa only [add_zero] using
      (tendsto_const_nhds (x := (5 / 2) * C * (∫ t : ℝ, g t))).add h_horiz_tendsto
  have h_global_norm : ‖∫ t : ℝ, F_D t‖ ≤ (5 / 2) * C * (∫ t : ℝ, g t) :=
    le_of_tendsto_of_tendsto h_lhs_tendsto h_rhs_tendsto h_ev
  have h_int_g_nonneg : 0 ≤ ∫ t : ℝ, g t :=
    MeasureTheory.integral_nonneg hg_nonneg
  have h_pi_gt : 3 < Real.pi := Real.pi_gt_three
  have h_coeff_le_one : (1 / (2 * Real.pi)) * (5 / 2) ≤ 1 := by
    rw [div_mul_eq_mul_div, div_le_one (by linarith)]
    linarith
  change ‖((1 / (2 * Real.pi) : ℝ) : ℂ) * (∫ t : ℝ, F_D t)‖ ≤ C * ∫ t : ℝ, g t
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos (by positivity : 0 < 1 / (2 * Real.pi))]
  calc (1 / (2 * Real.pi)) * ‖∫ t : ℝ, F_D t‖
    _ ≤ (1 / (2 * Real.pi)) * ((5 / 2) * C * (∫ t : ℝ, g t)) :=
      mul_le_mul_of_nonneg_left h_global_norm (by positivity)
    _ = ((1 / (2 * Real.pi)) * (5 / 2)) * (C * ∫ t : ℝ, g t) := by ring
    _ ≤ 1 * (C * ∫ t : ℝ, g t) :=
      mul_le_mul_of_nonneg_right h_coeff_le_one (by positivity)
    _ = C * ∫ t : ℝ, g t := one_mul _

theorem mitsui_landauPage_two_sqrt_integral_bound (B : ℝ) (hB : 0 < B) :
    ∃ c₁ : ℝ, 0 < c₁ ∧
      ∀ Y : ℝ, 1 < Y →
        ∀ M : ℝ, 1 ≤ M → M ≤ 2 * Real.sqrt (Real.log Y) →
          (∫ t : ℝ,
            Y ^ (1 - B / (M + Real.log (4 + |t|))) *
              ((M + Real.log (4 + |t|)) / (1 / 4 + t ^ 2))) ≤
            c₁ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁) :=
by
  have hg₀ : MeasureTheory.IntegrableOn (fun x : ℝ => (x + 4) ^ (-3 / 2 : ℝ)) (Set.Ioi (0 : ℝ)) MeasureTheory.volume :=
    integrableOn_add_rpow_Ioi_of_lt (by norm_num) (by norm_num)
  set I₀ : ℝ := ∫ x in Set.Ioi (0 : ℝ), (x + 4) ^ (-3 / 2 : ℝ)
  have hI₀_nonneg : 0 ≤ I₀ := by
    refine MeasureTheory.setIntegral_nonneg measurableSet_Ioi (fun x hx => ?_)
    have hx_pos : 0 < x := Set.mem_Ioi.mp hx
    exact Real.rpow_nonneg (by linarith) _
  set u : ℝ := min B 1
  have hu_pos : 0 < u := lt_min hB zero_lt_one
  have hu_le_B : u ≤ B := min_le_left B 1
  have hu_le_one : u ≤ 1 := min_le_right B 1
  have hu_inv_pos : 0 < u⁻¹ := inv_pos.mpr hu_pos
  let c₁ : ℝ := 4352 * u⁻¹ * I₀ + 8 * u⁻¹ + 1
  have hc₁_pos : 0 < c₁ := by dsimp [c₁]; positivity
  refine ⟨c₁, hc₁_pos, ?_⟩
  intro Y hY M hM_ge hM_le
  have hY_pos : 0 < Y := by linarith
  have hlogY_pos : 0 < Real.log Y := Real.log_pos hY
  set v : ℝ := Real.sqrt (Real.log Y)
  have hv_nonneg : 0 ≤ v := Real.sqrt_nonneg _
  have hv2 : v ^ 2 = Real.log Y := Real.sq_sqrt (le_of_lt hlogY_pos)
  set f : ℝ → ℝ := fun x => Y ^ (1 - B / (M + Real.log (4 + x))) * ((M + Real.log (4 + x)) / (1 / 4 + x ^ 2))
  have h_abs_eq :
      (∫ t : ℝ,
        Y ^ (1 - B / (M + Real.log (4 + |t|))) *
          ((M + Real.log (4 + |t|)) / (1 / 4 + t ^ 2))) =
      2 * ∫ x in Set.Ioi (0 : ℝ), f x := by
    have h_fun :
        (fun t : ℝ =>
          Y ^ (1 - B / (M + Real.log (4 + |t|))) *
            ((M + Real.log (4 + |t|)) / (1 / 4 + t ^ 2))) =
        (fun t : ℝ => f |t|) := by
      ext t
      dsimp [f]
      rw [sq_abs]
    rw [h_fun, integral_comp_abs]
  set K_Y : ℝ := 2176 * u⁻¹ * Y * Real.exp (-v / c₁)
  have hK_Y_nonneg : 0 ≤ K_Y := by dsimp [K_Y]; positivity
  have h_pw : ∀ x ∈ Set.Ioi (0 : ℝ), f x ≤ K_Y * (x + 4) ^ (-3 / 2 : ℝ) := by
    intro x hx
    have hx_pos : 0 < x := Set.mem_Ioi.mp hx
    have hx4_pos : 0 < x + 4 := by linarith
    have h4x_pos : 0 < 4 + x := by linarith
    have h4x_gt_one : 1 < 4 + x := by linarith
    set L : ℝ := Real.log (4 + x)
    have hL_pos : 0 < L := Real.log_pos h4x_gt_one
    set L_M : ℝ := M + L
    have hLM_pos : 0 < L_M := by dsimp [L_M]; linarith
    have hexpL : Real.exp L = x + 4 := by
      dsimp [L]
      rw [Real.exp_log h4x_pos]
      ring
    have h_sq_ineq : (u / 4 * v - u / 32 * L_M) * L_M ≤ B * Real.log Y := by
      have h_t1 : 0 ≤ (B - u) * v ^ 2 := mul_nonneg (by linarith) (sq_nonneg v)
      have h_t2 : 0 ≤ u * (v - L_M / 8) ^ 2 := by positivity
      have h_t3 : 0 ≤ (u / 64) * L_M ^ 2 := by positivity
      have h_id : B * Real.log Y - (u / 4 * v - u / 32 * L_M) * L_M =
          (B - u) * v ^ 2 + u * (v - L_M / 8) ^ 2 + (u / 64) * L_M ^ 2 := by
        rw [← hv2]
        ring
      linarith
    have h_div_LM : u / 4 * v - u / 32 * L_M ≤ (B * Real.log Y) / L_M :=
      (le_div_iff₀ hLM_pos).mpr h_sq_ineq
    have h_exp_arg1 : Real.log Y * (1 - B / L_M) ≤ Real.log Y + (-(u / 4 * v) + u / 32 * L_M) := by
      have h_eq : Real.log Y * (1 - B / L_M) = Real.log Y - (B * Real.log Y) / L_M := by ring
      linarith
    have h_factor1 : Y ^ (1 - B / L_M) ≤ Y * Real.exp (-(u / 4 * v) + u / 32 * L_M) := by
      rw [Real.rpow_def_of_pos hY_pos]
      calc Real.exp (Real.log Y * (1 - B / L_M))
        _ ≤ Real.exp (Real.log Y + (-(u / 4 * v) + u / 32 * L_M)) := Real.exp_le_exp.mpr h_exp_arg1
        _ = Real.exp (Real.log Y) * Real.exp (-(u / 4 * v) + u / 32 * L_M) := Real.exp_add _ _
        _ = Y * Real.exp (-(u / 4 * v) + u / 32 * L_M) := by rw [Real.exp_log hY_pos]
    have h_factor2 : L_M ≤ (32 * u⁻¹) * Real.exp (u * L_M / 32) := by
      have h_uLM : u * L_M / 32 ≤ Real.exp (u * L_M / 32) := by
        have := Real.add_one_le_exp (u * L_M / 32)
        linarith
      have h_mul := mul_le_mul_of_nonneg_left h_uLM (by positivity : (0 : ℝ) ≤ 32 * u⁻¹)
      have h_lhs : (32 * u⁻¹) * (u * L_M / 32) = L_M := by
        have hu_ne : u ≠ 0 := ne_of_gt hu_pos
        field_simp [hu_ne]
      rwa [h_lhs] at h_mul
    have h_denom_pos : 0 < 1 / 4 + x ^ 2 := by positivity
    have h_quad : (x + 4) ^ 2 ≤ 68 * (1 / 4 + x ^ 2) := by
      have h1 : 0 ≤ (4 * x - 1) ^ 2 := sq_nonneg _
      have h2 : 0 ≤ 51 * x ^ 2 := by positivity
      have h_id : 68 * (1 / 4 + x ^ 2) - (x + 4) ^ 2 = (4 * x - 1) ^ 2 + 51 * x ^ 2 := by ring
      linarith
    have h_factor3 : (1 / 4 + x ^ 2)⁻¹ ≤ 68 * Real.exp (-2 * L) := by
      have h_exp2L : (x + 4) ^ 2 = Real.exp (2 * L) := by
        rw [← hexpL, sq, ← Real.exp_add]
        congr 1
        ring
      have h_neg : Real.exp (-2 * L) = ((x + 4) ^ 2)⁻¹ := by
        rw [h_exp2L, show -2 * L = -(2 * L) by ring, Real.exp_neg]
      rw [h_neg, ← div_eq_mul_inv, inv_eq_one_div, div_le_div_iff₀ h_denom_pos (by positivity)]
      linarith
    have h_factor23 : L_M / (1 / 4 + x ^ 2) ≤ ((32 * u⁻¹) * Real.exp (u * L_M / 32)) * (68 * Real.exp (-2 * L)) := by
      rw [div_eq_mul_inv]
      exact mul_le_mul h_factor2 h_factor3 (by positivity) (by positivity)
    have h_prod : f x ≤
        (Y * Real.exp (-(u / 4 * v) + u / 32 * L_M)) *
          (((32 * u⁻¹) * Real.exp (u * L_M / 32)) * (68 * Real.exp (-2 * L))) := by
      dsimp [f, L_M, L]
      exact mul_le_mul h_factor1 h_factor23 (by positivity) (by positivity)
    have h_prod_eq :
        (Y * Real.exp (-(u / 4 * v) + u / 32 * L_M)) *
          (((32 * u⁻¹) * Real.exp (u * L_M / 32)) * (68 * Real.exp (-2 * L))) =
        (2176 * u⁻¹ * Y) * Real.exp (-(u / 4 * v) + u / 16 * L_M - 2 * L) := by
      have h_exp_comb :
          Real.exp (-(u / 4 * v) + u / 32 * L_M) * (Real.exp (u * L_M / 32) * Real.exp (-2 * L)) =
          Real.exp (-(u / 4 * v) + u / 16 * L_M - 2 * L) := by
        rw [← Real.exp_add, ← Real.exp_add]
        congr 1
        ring
      calc (Y * Real.exp (-(u / 4 * v) + u / 32 * L_M)) *
          (((32 * u⁻¹) * Real.exp (u * L_M / 32)) * (68 * Real.exp (-2 * L)))
        _ = (2176 * u⁻¹ * Y) *
            (Real.exp (-(u / 4 * v) + u / 32 * L_M) * (Real.exp (u * L_M / 32) * Real.exp (-2 * L))) := by ring
        _ = (2176 * u⁻¹ * Y) * Real.exp (-(u / 4 * v) + u / 16 * L_M - 2 * L) := by rw [h_exp_comb]
    rw [h_prod_eq] at h_prod
    have h_8u_le_c₁ : 8 * u⁻¹ ≤ c₁ := by
      have : 0 ≤ 4352 * u⁻¹ * I₀ + 1 := by positivity
      dsimp [c₁]; linarith
    have hv_div : v / c₁ ≤ u / 8 * v := by
      calc v / c₁ ≤ v / (8 * u⁻¹) := div_le_div_of_nonneg_left hv_nonneg (by positivity) h_8u_le_c₁
        _ = u / 8 * v := by
            have hu_ne : u ≠ 0 := ne_of_gt hu_pos
            field_simp [hu_ne]
    have hM_bound : u / 16 * M ≤ u / 8 * v := by
      calc u / 16 * M ≤ u / 16 * (2 * v) := mul_le_mul_of_nonneg_left hM_le (by positivity)
        _ = u / 8 * v := by ring
    have hL_bound : u / 16 * L ≤ L / 2 := by
      have huL : u * L ≤ 1 * L := mul_le_mul_of_nonneg_right hu_le_one (le_of_lt hL_pos)
      linarith
    have h_comb_exp : -(u / 4 * v) + u / 16 * L_M - 2 * L ≤ -v / c₁ + Real.log (x + 4) * (-3 / 2 : ℝ) := by
      have hL_eq : Real.log (x + 4) = L := by
        dsimp [L]
        rw [show x + 4 = 4 + x by ring]
      rw [hL_eq]
      have h_neg : -v / c₁ = -(v / c₁) := by ring
      dsimp [L_M]
      linarith
    have h_exp_le :
        Real.exp (-(u / 4 * v) + u / 16 * L_M - 2 * L) ≤
        Real.exp (-v / c₁) * (x + 4) ^ (-3 / 2 : ℝ) := by
      rw [Real.rpow_def_of_pos hx4_pos, ← Real.exp_add]
      exact Real.exp_le_exp.mpr h_comb_exp
    calc f x
      _ ≤ (2176 * u⁻¹ * Y) * Real.exp (-(u / 4 * v) + u / 16 * L_M - 2 * L) := h_prod
      _ ≤ (2176 * u⁻¹ * Y) * (Real.exp (-v / c₁) * (x + 4) ^ (-3 / 2 : ℝ)) :=
          mul_le_mul_of_nonneg_left h_exp_le (by positivity)
      _ = K_Y * (x + 4) ^ (-3 / 2 : ℝ) := by dsimp [K_Y]; ring
  have h_int_le : (∫ x in Set.Ioi (0 : ℝ), f x) ≤ K_Y * I₀ := by
    by_cases hf : MeasureTheory.IntegrableOn f (Set.Ioi (0 : ℝ)) MeasureTheory.volume
    · have h_mono := MeasureTheory.setIntegral_mono_on hf (hg₀.const_mul K_Y) measurableSet_Ioi h_pw
      rwa [MeasureTheory.integral_const_mul] at h_mono
    · rw [MeasureTheory.integral_undef hf]
      positivity
  have h_4352_le : 4352 * u⁻¹ * I₀ ≤ c₁ := by
    have : 0 ≤ 8 * u⁻¹ + 1 := by positivity
    dsimp [c₁]; linarith
  calc (∫ t : ℝ,
        Y ^ (1 - B / (M + Real.log (4 + |t|))) *
          ((M + Real.log (4 + |t|)) / (1 / 4 + t ^ 2)))
    _ = 2 * ∫ x in Set.Ioi (0 : ℝ), f x := h_abs_eq
    _ ≤ 2 * (K_Y * I₀) := mul_le_mul_of_nonneg_left h_int_le (by norm_num)
    _ = (4352 * u⁻¹ * I₀) * (Y * Real.exp (-v / c₁)) := by dsimp [K_Y]; ring
    _ ≤ c₁ * (Y * Real.exp (-v / c₁)) := mul_le_mul_of_nonneg_right h_4352_le (by positivity)
    _ = c₁ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁) := by dsimp [v]; ring

theorem mitsui_riesz_primePower_ray_char_archimedeanCoord_nonprincipal_freq_bound {K : Type u} [Field K] [NumberField K]
