      Finset (IsDedekindDomain.HeightOneSpectrum R) →
      (nonZeroDivisors (Ideal R) →* ℂ) := fun ψ T =>
    { toFun := fun I => if ∀ p ∈ T, ¬ ((I : Ideal R) ≤ p.asIdeal) then ψ I else 0
      map_one' := by
        have h1 : ∀ p ∈ T, ¬ (((1 : nonZeroDivisors (Ideal R)) : Ideal R) ≤ p.asIdeal) := by
          intro p _ h_le
          have h_one : ((1 : nonZeroDivisors (Ideal R)) : Ideal R) = ⊤ := Ideal.one_eq_top
          rw [h_one] at h_le
          exact p.isPrime.ne_top (top_le_iff.mp h_le)
        rw [if_pos h1, map_one]
      map_mul' := by
        intro I J
        have h_mul_iff : (∀ p ∈ T, ¬ (((I * J : nonZeroDivisors (Ideal R)) : Ideal R) ≤ p.asIdeal)) ↔
            (∀ p ∈ T, ¬ ((I : Ideal R) ≤ p.asIdeal)) ∧
            (∀ p ∈ T, ¬ ((J : Ideal R) ≤ p.asIdeal)) := by
          refine ⟨fun h => ⟨fun p hp hI => h p hp (Ideal.mul_le_right.trans hI),
            fun p hp hJ => h p hp (Ideal.mul_le_left.trans hJ)⟩,
            fun ⟨hI, hJ⟩ p hp hIJ => ?_⟩
          rcases p.isPrime.mul_le.mp hIJ with h1 | h2
          · exact hI p hp h1
          · exact hJ p hp h2
        by_cases hI : ∀ p ∈ T, ¬ ((I : Ideal R) ≤ p.asIdeal)
        · by_cases hJ : ∀ p ∈ T, ¬ ((J : Ideal R) ≤ p.asIdeal)
          · have hIJ : ∀ p ∈ T, ¬ (((I * J : nonZeroDivisors (Ideal R)) : Ideal R) ≤ p.asIdeal) :=
              h_mul_iff.mpr ⟨hI, hJ⟩
            rw [if_pos hIJ, if_pos hI, if_pos hJ, map_mul]
          · have hIJ : ¬ (∀ p ∈ T, ¬ (((I * J : nonZeroDivisors (Ideal R)) : Ideal R) ≤ p.asIdeal)) :=
              fun h => hJ (h_mul_iff.mp h).2
            rw [if_neg hIJ, if_neg hJ, mul_zero]
        · have hIJ : ¬ (∀ p ∈ T, ¬ (((I * J : nonZeroDivisors (Ideal R)) : Ideal R) ≤ p.asIdeal)) :=
            fun h => hI (h_mul_iff.mp h).1
          rw [if_neg hIJ, if_neg hI, zero_mul] }
