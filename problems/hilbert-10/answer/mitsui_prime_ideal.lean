    rw [h_star, one_mul, h_norm_top, one_mul]
    have hb_pos : 0 < D ^ (-1 / 2 : ℝ) * u := by positivity
    rw [(mitsui_principal_subideal_norm_tsum_eq_torsion_inv_mul_cube_integral_lattice
      (⊤ : Ideal R) (J_rep C) ψ₁ hψ₁_norm (fun _ => 1) hψ₁_span (D ^ (-1 / 2 : ℝ) * u) hb_pos).2]
    congr 1
    have h_int_congr :
        (∫ y in Cube,
