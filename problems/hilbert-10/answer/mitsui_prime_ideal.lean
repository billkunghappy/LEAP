    have h_union_range : ∀ n : ℕ,
        (⋃ i ∈ Finset.range n, Set.Ioc (a_pt i) (a_pt (i + 1))) = Set.Ioc (a_pt 0) (a_pt n) := by
      intro n
      induction n with
      | zero =>
        simp
      | succ n ih =>
        have h_step_union :
            (⋃ i ∈ Finset.range (n + 1), Set.Ioc (a_pt i) (a_pt (i + 1))) =
            (⋃ i ∈ Finset.range n, Set.Ioc (a_pt i) (a_pt (i + 1))) ∪ Set.Ioc (a_pt n) (a_pt (n + 1)) := by
          ext u
          simp only [Set.mem_iUnion, Set.mem_union, Finset.mem_range, Nat.lt_succ_iff_lt_or_eq]
          constructor
          · rintro ⟨i, hi | rfl, hu⟩
            · exact Or.inl ⟨i, hi, hu⟩
            · exact Or.inr hu
          · rintro (⟨i, hi, hu⟩ | hu)
            · exact ⟨i, Or.inl hi, hu⟩
            · exact ⟨n, Or.inr rfl, hu⟩
        rw [h_step_union, ih,
            Set.Ioc_union_Ioc_eq_Ioc (ha_mono (Nat.zero_le n)) (ha_mono (Nat.le_succ n))]
    have h_mem_tot_iff : ∀ u : ℝ,
        u ∈ Set.Ioc (-Real.log X) 0 ↔ ∃ j : Fin l, u ∈ Set.Ioc (a_pt j) (b_pt j) := by
      intro u
      rw [← ha_zero, ← ha_l, ← h_union_range l, Set.mem_iUnion₂]
      constructor
      · rintro ⟨i, hi_mem, hu⟩
        have hi_lt : i < l := Finset.mem_range.mp hi_mem
        refine ⟨⟨i, hi_lt⟩, ?_⟩
        rwa [hb_eq]
      · rintro ⟨j, hu⟩
        refine ⟨j.1, Finset.mem_range.mpr j.2, ?_⟩
        rwa [← hb_eq j]
    have h_slice_unique : ∀ (u : ℝ) (j₁ j₂ : Fin l),
        u ∈ Set.Ioc (a_pt j₁) (b_pt j₁) → u ∈ Set.Ioc (a_pt j₂) (b_pt j₂) → j₁ = j₂ := by
      intro u j₁ j₂ h₁ h₂
      by_contra hne
      rw [hb_eq] at h₁ h₂
      rcases lt_or_gt_of_ne (Fin.val_ne_of_ne hne) with hlt | hgt
      · have hle : a_pt ((j₁ : ℕ) + 1) ≤ a_pt j₂ := ha_mono hlt
        linarith [h₁.2, h₂.1]
      · have hle : a_pt ((j₂ : ℕ) + 1) ≤ a_pt j₁ := ha_mono hgt
        linarith [h₂.2, h₁.1]
    have h_meas_gen : ∀ (I : Set ℝ), MeasurableSet I →
        MeasurableSet {q : ℝ × ℝ | q.1 ∈ I ∧ q.2 ∈ S (R₁ * Real.exp q.1)} := by
      intro I hI
      rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hc
      · have hnot_c : ¬ w.IsComplex := NumberField.InfinitePlace.not_isComplex_iff_isReal.mpr hw
        let I_w : Set ℝ :=
          Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
            ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1))
        have h_eq : {q : ℝ × ℝ | q.1 ∈ I ∧ q.2 ∈ S (R₁ * Real.exp q.1)} =
            ((I ∩ (fun u : ℝ => R₁ * Real.exp u) ⁻¹' I_w) ×ˢ Set.Ioo (0 : ℝ) 1) ∪
            ((I ∩ (fun u : ℝ => -(R₁ * Real.exp u)) ⁻¹' I_w) ×ˢ Set.Ioo (1 : ℝ) 2) := by
          ext q
          simp only [S, Set.mem_setOf_eq, Set.mem_union, Set.mem_prod, Set.mem_inter_iff,
            Set.mem_preimage]
          constructor
          · rintro ⟨hq1, ⟨hw', ⟨h2, h3⟩ | ⟨h2, h3⟩⟩ | ⟨hc', _⟩⟩
            · rw [Subsingleton.elim hw' hw] at h3
              exact Or.inl ⟨⟨hq1, h3⟩, h2⟩
            · rw [Subsingleton.elim hw' hw] at h3
              exact Or.inr ⟨⟨hq1, h3⟩, h2⟩
            · exact False.elim (hnot_c hc')
          · rintro (⟨⟨hq1, h3⟩, h2⟩ | ⟨⟨hq1, h3⟩, h2⟩)
            · exact ⟨hq1, Or.inl ⟨hw, Or.inl ⟨h2, h3⟩⟩⟩
            · exact ⟨hq1, Or.inl ⟨hw, Or.inr ⟨h2, h3⟩⟩⟩
        rw [h_eq]
        have hc1 : Continuous (fun u : ℝ => R₁ * Real.exp u) := by fun_prop
        have hc2 : Continuous (fun u : ℝ => -(R₁ * Real.exp u)) := by fun_prop
        exact ((hI.inter (hc1.measurable measurableSet_Ico)).prod measurableSet_Ioo).union
          ((hI.inter (hc2.measurable measurableSet_Ico)).prod measurableSet_Ioo)
      · have hnot_r : ¬ w.IsReal := NumberField.InfinitePlace.not_isReal_iff_isComplex.mpr hc
        let I_0 : Set ℝ :=
          Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
            ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1))
        let I_1 : Set ℝ :=
          Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
            ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1))
        have h_eq : {q : ℝ × ℝ | q.1 ∈ I ∧ q.2 ∈ S (R₁ * Real.exp q.1)} =
            (I ×ˢ Set.Ioo (-Real.pi) Real.pi) ∩
            ((fun q : ℝ × ℝ => (R₁ * Real.exp q.1) * Real.cos q.2) ⁻¹' I_0 ∩
             (fun q : ℝ × ℝ => (R₁ * Real.exp q.1) * Real.sin q.2) ⁻¹' I_1) := by
          ext q
          simp only [S, Set.mem_setOf_eq, Set.mem_inter_iff, Set.mem_prod, Set.mem_preimage]
          constructor
          · rintro ⟨hq1, ⟨hw', _⟩ | ⟨hc', h2, h3, h4⟩⟩
            · exact False.elim (hnot_r hw')
            · rw [Subsingleton.elim hc' hc] at h3 h4
              exact ⟨⟨hq1, h2⟩, h3, h4⟩
          · rintro ⟨⟨hq1, h2⟩, h3, h4⟩
            exact ⟨hq1, Or.inr ⟨hc, h2, h3, h4⟩⟩
        rw [h_eq]
        have hc1 : Continuous (fun q : ℝ × ℝ => (R₁ * Real.exp q.1) * Real.cos q.2) := by fun_prop
        have hc2 : Continuous (fun q : ℝ × ℝ => (R₁ * Real.exp q.1) * Real.sin q.2) := by fun_prop
        exact (hI.prod measurableSet_Ioo).inter
          ((hc1.measurable measurableSet_Ico).inter (hc2.measurable measurableSet_Ico))
    have hV_tot_meas : MeasurableSet V_tot := h_meas_gen _ measurableSet_Ioc
    have hV_slice_meas : ∀ j : Fin l, MeasurableSet (V_slice j) :=
      fun j => h_meas_gen _ measurableSet_Ioc
    have hV_tot_sub : V_tot ⊆ Set.Ioc (-Real.log X) 0 ×ˢ Set.Ioo (-Real.pi) Real.pi := by
      intro q ⟨hq1, hq2⟩
      refine ⟨hq1, ?_⟩
      have hpi : 3 < Real.pi := Real.pi_gt_three
      rcases hq2 with ⟨_, ⟨h1, _⟩ | ⟨h2, _⟩⟩ | ⟨_, h3, _, _⟩
      · exact ⟨by linarith [h1.1], by linarith [h1.2]⟩
      · exact ⟨by linarith [h2.1], by linarith [h2.2]⟩
      · exact h3
    have hV_slice_sub : ∀ j : Fin l, V_slice j ⊆ V_tot := by
      intro j q ⟨hq1, hq2⟩
      exact ⟨(h_mem_tot_iff q.1).mpr ⟨j, hq1⟩, hq2⟩
    have h_box_ne_top :
        MeasureTheory.volume (Set.Ioc (-Real.log X) 0 ×ˢ Set.Ioo (-Real.pi) Real.pi) ≠ ⊤ := by
      rw [MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod,
          Real.volume_Ioc, Real.volume_Ioo]
      exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top
    have hV_tot_ne_top : MeasureTheory.volume V_tot ≠ ⊤ :=
      ne_top_of_le_ne_top h_box_ne_top (MeasureTheory.measure_mono hV_tot_sub)
    have hV_slice_ne_top : ∀ j : Fin l, MeasureTheory.volume (V_slice j) ≠ ⊤ :=
      fun j => ne_top_of_le_ne_top hV_tot_ne_top (MeasureTheory.measure_mono (hV_slice_sub j))
    let f_mid (q : ℝ × ℝ) : ENNReal :=
      ∑ j : Fin l, (V_slice j).indicator (fun _ => ENNReal.ofReal (c_wt j)) q
    have h_pt_lo : ∀ q : ℝ × ℝ, V_tot.indicator g_wt q ≤ f_mid q := by
      intro q
      by_cases hq : q ∈ V_tot
      · rw [Set.indicator_of_mem hq]
        obtain ⟨j₀, hj₀⟩ := (h_mem_tot_iff q.1).mp hq.1
        have hq_slice : q ∈ V_slice j₀ := ⟨hj₀, hq.2⟩
        have h_le_c : (R₁ * Real.exp q.1) ^ w.mult ≤ c_wt j₀ := by
          dsimp [c_wt]
          apply pow_le_pow_left₀ (by positivity)
          exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hj₀.2) hR₁
        calc g_wt q
          _ ≤ ENNReal.ofReal (c_wt j₀) := ENNReal.ofReal_le_ofReal h_le_c
          _ = (V_slice j₀).indicator (fun _ => ENNReal.ofReal (c_wt j₀)) q :=
              (Set.indicator_of_mem hq_slice (fun _ : ℝ × ℝ => ENNReal.ofReal (c_wt j₀))).symm
          _ ≤ f_mid q := by
              dsimp [f_mid]
              exact Finset.single_le_sum
                (f := fun j : Fin l => (V_slice j).indicator (fun _ => ENNReal.ofReal (c_wt j)) q)
                (fun j _ => zero_le _) (Finset.mem_univ j₀)
      · rw [Set.indicator_of_notMem hq]
        exact zero_le _
    set E_factor : ℝ := Real.exp ((w.mult : ℝ) * δ)
    have h_pt_hi : ∀ q : ℝ × ℝ,
        f_mid q ≤ ENNReal.ofReal E_factor * V_tot.indicator g_wt q := by
      intro q
      by_cases h_ex : ∃ j₀ : Fin l, q ∈ V_slice j₀
      · obtain ⟨j₀, hj₀⟩ := h_ex
        have hq_tot : q ∈ V_tot := hV_slice_sub j₀ hj₀
        have h_sum_single : f_mid q = ENNReal.ofReal (c_wt j₀) := by
          dsimp [f_mid]
          rw [Finset.sum_eq_single j₀]
          · exact Set.indicator_of_mem hj₀ _
          · intro j _ hj_ne
            have h_not : q ∉ V_slice j := fun hj => hj_ne (h_slice_unique q.1 j j₀ hj.1 hj₀.1)
            exact Set.indicator_of_notMem h_not _
          · intro h_abs
            exact False.elim (h_abs (Finset.mem_univ j₀))
        rw [h_sum_single, Set.indicator_of_mem hq_tot,
            ← ENNReal.ofReal_mul (by dsimp [E_factor]; positivity)]
        apply ENNReal.ofReal_le_ofReal
        have hb_le : b_pt j₀ ≤ q.1 + δ := by linarith [hj₀.1.1, ha_step j₀]
        have h_base : R₁ * Real.exp (b_pt j₀) ≤ Real.exp δ * (R₁ * Real.exp q.1) := by
          calc R₁ * Real.exp (b_pt j₀)
            _ ≤ R₁ * Real.exp (q.1 + δ) :=
                mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hb_le) hR₁
            _ = Real.exp δ * (R₁ * Real.exp q.1) := by
                rw [Real.exp_add]; ring
        calc c_wt j₀
          _ ≤ (Real.exp δ * (R₁ * Real.exp q.1)) ^ w.mult :=
              pow_le_pow_left₀ (by positivity) h_base w.mult
          _ = (Real.exp δ) ^ w.mult * (R₁ * Real.exp q.1) ^ w.mult := mul_pow _ _ _
          _ = E_factor * (R₁ * Real.exp q.1) ^ w.mult := by
              dsimp [E_factor]
              rw [← Real.exp_nat_mul]
      · push_neg at h_ex
        have h_zero : f_mid q = 0 := by
          dsimp [f_mid]
          exact Finset.sum_eq_zero (fun j _ => Set.indicator_of_notMem (h_ex j) _)
        rw [h_zero]
        exact zero_le _
    have h_mid_int :
        (∫⁻ q : ℝ × ℝ, f_mid q) =
        ∑ j : Fin l, ENNReal.ofReal (c_wt j) * MeasureTheory.volume (V_slice j) := by
      dsimp [f_mid]
      rw [MeasureTheory.lintegral_finset_sum _
        (fun j _ => measurable_const.indicator (hV_slice_meas j))]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [MeasureTheory.lintegral_indicator (hV_slice_meas j), MeasureTheory.setLIntegral_const]
    have h_mid_term_ne_top : ∀ j : Fin l,
        ENNReal.ofReal (c_wt j) * MeasureTheory.volume (V_slice j) ≠ ⊤ :=
      fun j => ENNReal.mul_ne_top ENNReal.ofReal_ne_top (hV_slice_ne_top j)
    have h_mid_ne_top : (∫⁻ q : ℝ × ℝ, f_mid q) ≠ ⊤ := by
      rw [h_mid_int]
      exact ne_of_lt (ENNReal.sum_lt_top.mpr (fun j _ => lt_top_iff_ne_top.mpr (h_mid_term_ne_top j)))
    have h_mid_toReal :
        (∫⁻ q : ℝ × ℝ, f_mid q).toReal =
        ∑ j : Fin l, (MeasureTheory.volume (V_slice j)).toReal * c_wt j := by
      rw [h_mid_int, ENNReal.toReal_sum (fun j _ => h_mid_term_ne_top j)]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal (by dsimp [c_wt]; positivity), mul_comm]
    have h_lo_int : (∫⁻ q : ℝ × ℝ, V_tot.indicator g_wt q) ≤ ∫⁻ q : ℝ × ℝ, f_mid q :=
      MeasureTheory.lintegral_mono h_pt_lo
    have h_lo_ne_top : (∫⁻ q : ℝ × ℝ, V_tot.indicator g_wt q) ≠ ⊤ :=
      ne_top_of_le_ne_top h_mid_ne_top h_lo_int
    have h_lo_toReal :
        (∫⁻ q : ℝ × ℝ, V_tot.indicator g_wt q).toReal ≤
        ∑ j : Fin l, (MeasureTheory.volume (V_slice j)).toReal * c_wt j := by
      rw [← h_mid_toReal]
      exact ENNReal.toReal_mono h_mid_ne_top h_lo_int
    have h_g_meas : Measurable (V_tot.indicator g_wt) := by
      have h_cont : Continuous (fun q : ℝ × ℝ => (R₁ * Real.exp q.1) ^ w.mult) := by fun_prop
      exact (ENNReal.measurable_ofReal.comp h_cont.measurable).indicator hV_tot_meas
    have h_hi_int :
        (∫⁻ q : ℝ × ℝ, f_mid q) ≤
        ENNReal.ofReal E_factor * ∫⁻ q : ℝ × ℝ, V_tot.indicator g_wt q := by
      calc (∫⁻ q : ℝ × ℝ, f_mid q)
        _ ≤ ∫⁻ q : ℝ × ℝ, ENNReal.ofReal E_factor * V_tot.indicator g_wt q :=
            MeasureTheory.lintegral_mono h_pt_hi
        _ = ENNReal.ofReal E_factor * ∫⁻ q : ℝ × ℝ, V_tot.indicator g_wt q :=
            MeasureTheory.lintegral_const_mul _ h_g_meas
    have h_hi_ne_top : ENNReal.ofReal E_factor * (∫⁻ q : ℝ × ℝ, V_tot.indicator g_wt q) ≠ ⊤ :=
      ENNReal.mul_ne_top ENNReal.ofReal_ne_top h_lo_ne_top
    have h_hi_toReal :
        ∑ j : Fin l, (MeasureTheory.volume (V_slice j)).toReal * c_wt j ≤
        E_factor * (∫⁻ q : ℝ × ℝ, V_tot.indicator g_wt q).toReal := by
      rw [← h_mid_toReal]
      have h1 := ENNReal.toReal_mono h_hi_ne_top h_hi_int
      rwa [ENNReal.toReal_mul, ENNReal.toReal_ofReal (by dsimp [E_factor]; positivity)] at h1
    exact ⟨h_lo_toReal, h_hi_toReal⟩
  have mitsui_place_log_sector_weighted_lintegral_bounds :
      ∀ (X : ℝ) (hX : 1 < X)
        (m : ℕ) (hm : 1 ≤ m)
        (R₁ : ℝ) (hR₁ : 1 < R₁) (hR₁_le : R₁ ≤ X)
        (k : NumberField.mixedEmbedding.index K → Fin (2 * m))
        (w : NumberField.InfinitePlace K),
        0 ≤ (∫⁻ q : ℝ × ℝ,
