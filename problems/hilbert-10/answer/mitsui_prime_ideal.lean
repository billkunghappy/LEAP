              Complex.I) =
        (Real.exp (-Real.pi * c ^ 2 *
          ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * (w (x : K)) ^ 2 *
              ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (1 * (2 * y i))) : ℂ) *
          Complex.exp
            (((∑ w : NumberField.InfinitePlace K,
                v_place w *
                  ∑ i : Fin r,
                    y i * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) : ℝ) *
              Complex.I) := by
      intro x y
      have h_prod_one :
          (∏ w : NumberField.InfinitePlace K,
            (Φ_emb w (x : K) *
              ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (y i) : ℝ) : ℂ)) ^ (a_place w)) = 1 :=
        Finset.prod_eq_one (fun w _ => by rw [ha0 w, pow_zero])
      rw [hψ_all, h_prod_one, h_sum_a, pow_zero, one_mul, one_mul, one_mul]
      congr 2
      congr 2
      refine Finset.sum_congr rfl (fun w _ => ?_)
      congr 1
