      _ = ∑ m_freq ∈ S_M, c m_freq * (∑ pm : D_Y, E m_freq (v pm) * W pm) := by
        refine Finset.sum_congr rfl (fun m_freq _ => (Finset.mul_sum _ _ _).symm)
