  have hexp_le_one : Real.exp (Real.log X * S_exp) ≤ 1 :=
    Real.exp_le_one_iff.mpr hexp_arg_nonpos
  have hY_le_Y₀ : Y ≤ Y₀ := by
    dsimp [Y]
    exact mul_le_of_le_one_right (le_of_lt hY₀_pos) hexp_le_one
  have h_sum_lower : 1 - (n : ℝ) ≤ S_exp := by
    have h_split : S_exp =
        (w₀.mult : ℝ) * ((((k w₀ : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)) +
        ∑ w ∈ Finset.univ.erase w₀,
          (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)) := by
      dsimp [S_exp]
      exact (Finset.add_sum_erase _ _ (Finset.mem_univ w₀)).symm
    have hkw₀_r : ((k w₀ : ℕ) : ℝ) + 1 = (m : ℝ) := by exact_mod_cast hk₀
    have hw₀_term : (w₀.mult : ℝ) * ((((k w₀ : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)) = 0 := by
      rw [hkw₀_r, sub_self, zero_div, mul_zero]
    have h_erase_ge : ∑ w ∈ Finset.univ.erase w₀, (-(w.mult : ℝ)) ≤
        ∑ w ∈ Finset.univ.erase w₀,
          (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)) := by
      refine Finset.sum_le_sum (fun w _ => ?_)
      have hkw_nonneg : (0 : ℝ) ≤ ((k w : ℕ) : ℝ) := Nat.cast_nonneg _
      have hnum_ge : -(m : ℝ) ≤ ((k w : ℕ) : ℝ) + 1 - (m : ℝ) := by linarith
      have hdiv_ge : -1 ≤ (((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ) := by
        rw [le_div_iff₀ hm_rpos]
        linarith
      have hmult_nonneg : (0 : ℝ) ≤ (w.mult : ℝ) := Nat.cast_nonneg w.mult
      have hmul := mul_le_mul_of_nonneg_left hdiv_ge hmult_nonneg
      linarith
    have h_mult_split : (w₀.mult : ℝ) + ∑ w ∈ Finset.univ.erase w₀, (w.mult : ℝ) = (n : ℝ) := by
      rw [Finset.add_sum_erase Finset.univ (fun w : NumberField.InfinitePlace K => (w.mult : ℝ)) (Finset.mem_univ w₀)]
      exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
    have hw₀_mult_pos : 0 < w₀.mult := NumberField.InfinitePlace.mult_pos
    have hw₀_mult_ge_one : (1 : ℝ) ≤ (w₀.mult : ℝ) := by exact_mod_cast hw₀_mult_pos
    rw [Finset.sum_neg_distrib] at h_erase_ge
    linarith
  have hX_le_Y : X ≤ Y := by
    have hY₀_exp : Y₀ = Real.exp ((n : ℝ) * Real.log X) := by
