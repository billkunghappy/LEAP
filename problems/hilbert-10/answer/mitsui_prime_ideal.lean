  obtain ⟨h_u_maj_int, h_u_c_eq⟩ := h_s3 G_maj G_c hG_maj_int hG_c_int
  set n : ℕ := Module.finrank ℚ K
  set r₁ : ℕ := NumberField.InfinitePlace.nrRealPlaces K
  set r₂ : ℕ := NumberField.InfinitePlace.nrComplexPlaces K
  set Reg : ℝ := NumberField.Units.regulator K
  set A_sum : ℕ := ∑ w : NumberField.InfinitePlace K, a_place w
  have hn_pos : (0 : ℝ) < (n : ℝ) := by
    dsimp [n]
    exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
  have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  have h_y_maj : ∀ u : ℝ,
      (∫ y : Fin (NumberField.Units.rank K) → ℝ, G_maj (Ψ_K u y)) =
