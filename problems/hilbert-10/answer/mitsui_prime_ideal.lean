    calc ‖S₃ - ((R⁻¹ : ℝ) : ℂ) * S₄‖ ≤ M_card * (c₃₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃₀)) := h_norm3
      _ ≤ M_card * (c₃₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁)) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp3 (by positivity)) hM_nonneg
