    intro t
    have hre : ((2 + (t : ℂ) * Complex.I) - 1).re = 1 := by simp; ring
    calc (1 : ℝ) = |((2 + (t : ℂ) * Complex.I) - 1).re| := by rw [hre, abs_one]
      _ ≤ ‖(2 + (t : ℂ) * Complex.I) - 1‖ := Complex.abs_re_le_norm _
  have h_log_inv_le : ∀ {t : ℝ}, 0 < t → -Real.log t ≤ t⁻¹ - 1 := by
    intro t ht
    have h1 := Real.log_le_sub_one_of_pos (inv_pos.mpr ht)
    rwa [Real.log_inv] at h1
  let f_pole : ℝ → ℂ := fun t =>
    if t ∈ Set.Ioc (0 : ℝ) 1 then ((t⁻¹ + Real.log t - 1 : ℝ) : ℂ) else 0
  have h_mellin : ∀ s : ℂ, 1 < s.re →
      HasMellin f_pole s ((1 / s ^ 2) * (1 / (s - 1))) := by
    intro s hs
