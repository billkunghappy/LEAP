theorem mitsui_grossenchar_sq_primitive_conductor_reduction {K : Type u} [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (w₀ : NumberField.InfinitePlace K)
