            (Real.exp (-Real.pi *
              ∑ j : Fin n, (A.mulVec (fun i => u₀ i + (k i : ℝ)) j) ^ 2) : ℂ)) := by
      rw [← tsum_mul_left]
      refine tsum_congr (fun k => ?_)
      dsimp [F', y]
      have h1 : (∏ j : Fin n, (A.mulVec (fun i => u₀ i + (k i : ℝ)) j - 0 * e₀ j) ^ (d' j)) =
