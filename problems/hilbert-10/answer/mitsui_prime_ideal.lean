theorem mitsui_ray_char_heckeL_conj_symm_of_im_eq_zero {K : Type u} [Field K] [NumberField K]
    (χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ I‖ ≤ 1)
    (hχ_im : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), (χ I).im = 0)
    (g_χ : ℂ → ℂ)
    (hg_diff : Differentiable ℂ g_χ)
    (hg_eq : ∀ s : ℂ, 1 < s.re →
      g_χ s = LSeries (fun n =>
        ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
          χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s)
    (β γ : ℝ)
    (h_zero : g_χ ((β : ℂ) + (γ : ℂ) * Complex.I) = 0) :
    g_χ ((β : ℂ) - (γ : ℂ) * Complex.I) = 0 :=
by
  set a_χ : ℕ → ℂ := fun n =>
    ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
      χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩
  have hχ_conj : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      starRingEnd ℂ (χ I) = χ I := by
    intro I
    apply Complex.ext
    · exact Complex.conj_re (χ I)
    · rw [Complex.conj_im, hχ_im I, neg_zero]
  have ha_conj : ∀ n : ℕ, starRingEnd ℂ (a_χ n) = a_χ n := by
    intro n
    dsimp [a_χ]
    rw [Complex.conj_tsum]
    congr 1
    ext I
    exact hχ_conj ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩
  have h_term_conj : ∀ (w : ℂ) (n : ℕ),
      LSeries.term a_χ (starRingEnd ℂ w) n = starRingEnd ℂ (LSeries.term a_χ w n) := by
    intro w n
    rcases eq_or_ne n 0 with rfl | hn
    · simp [LSeries.term_zero]
    · rw [LSeries.term_of_ne_zero hn, LSeries.term_of_ne_zero hn, map_div₀, ha_conj n]
      have h_arg : (n : ℂ).arg ≠ Real.pi := by
        rw [Complex.natCast_arg]
        exact Real.pi_ne_zero.symm
      rw [Complex.cpow_conj (n : ℂ) w h_arg, map_natCast]
  have h_LSeries_conj : ∀ w : ℂ,
      starRingEnd ℂ (LSeries a_χ (starRingEnd ℂ w)) = LSeries a_χ w := by
    intro w
    dsimp [LSeries]
    rw [Complex.conj_tsum]
    congr 1
    ext n
    rw [h_term_conj w n, starRingEnd_self_apply]
  let h : ℂ → ℂ := ⇑(starRingEnd ℂ) ∘ g_χ ∘ ⇑(starRingEnd ℂ)
  have hh_diff : Differentiable ℂ h := by
    intro z
    have h1 := (hg_diff (starRingEnd ℂ z)).conj_conj
    rwa [starRingEnd_self_apply] at h1
  have hh_anal : AnalyticOnNhd ℂ h Set.univ := fun z _ => hh_diff.analyticAt z
  have hg_anal : AnalyticOnNhd ℂ g_χ Set.univ := fun z _ => hg_diff.analyticAt z
  have hU_open : IsOpen {w : ℂ | 1 < w.re} :=
    isOpen_lt continuous_const Complex.continuous_re
  have hU_nhds : {w : ℂ | 1 < w.re} ∈ nhds (2 : ℂ) :=
    hU_open.mem_nhds (by norm_num : (1 : ℝ) < (2 : ℂ).re)
  have h_ev : h =ᶠ[nhds (2 : ℂ)] g_χ := by
    apply Filter.eventuallyEq_of_mem hU_nhds
    intro w hw
    have hw_re : 1 < w.re := hw
    have hw_conj_re : 1 < (starRingEnd ℂ w).re := by
      rw [Complex.conj_re]
      exact hw_re
    dsimp [h]
    rw [hg_eq (starRingEnd ℂ w) hw_conj_re, hg_eq w hw_re]
    exact h_LSeries_conj w
  have h_eq_on : Set.EqOn h g_χ Set.univ :=
    hh_anal.eqOn_of_preconnected_of_eventuallyEq hg_anal isPreconnected_univ
      (Set.mem_univ (2 : ℂ)) h_ev
  have h_eq_all : ∀ z : ℂ, h z = g_χ z := fun z => h_eq_on (Set.mem_univ z)
  set z : ℂ := (β : ℂ) - (γ : ℂ) * Complex.I
  have hz_conj : starRingEnd ℂ z = (β : ℂ) + (γ : ℂ) * Complex.I := by
    dsimp [z]
    rw [map_sub, map_mul, Complex.conj_ofReal, Complex.conj_ofReal, Complex.conj_I]
    ring
  rw [← h_eq_all z]
  dsimp [h]
  rw [hz_conj, h_zero, map_zero]

theorem mitsui_grossenchar_heckeL_nonreal_zeroFree_of_vertical_growth {K : Type u} [Field K] [NumberField K] (A₁ : ℝ) (hA₁_pos : 0 < A₁) :
