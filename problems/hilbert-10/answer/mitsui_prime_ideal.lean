            (-deriv riemannZeta (2 + (t : ℂ) * Complex.I) /
              riemannZeta (2 + (t : ℂ) * Complex.I))).re - Y| ≤
      (C + B⁻¹) *
        ∫ t : ℝ, Y ^ (1 - B / Real.log (4 + |t|)) * (Real.log (4 + |t|) / (1 / 4 + t ^ 2)) :=
by
