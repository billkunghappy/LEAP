        (fun m₀ => tsum_nonneg (fun _ => le_of_lt (Real.exp_pos _)))
        (fun m₀ => ?_) h_dom
      calc (∑' m' : Fin n → ℤ, H_dual (m₀, m'))
        _ = ∑' m' : Fin n → ℤ,
              Real.exp (-Real.pi * ((d⁻¹) ^ 2 * ((m₀ : ℝ) - y 0) ^ 2)) *
                Real.exp (-Real.pi * ∑ i : Fin n,
                  (M'.transpose⁻¹.mulVec (fun l => (m' l : ℝ) - w' m₀ l) i) ^ 2) :=
            tsum_congr (hH_factor m₀)
        _ = Real.exp (-Real.pi * ((d⁻¹) ^ 2 * ((m₀ : ℝ) - y 0) ^ 2)) *
              ∑' m' : Fin n → ℤ,
                Real.exp (-Real.pi * ∑ i : Fin n,
                  (M'.transpose⁻¹.mulVec (fun l => (m' l : ℝ) - w' m₀ l) i) ^ 2) :=
            tsum_mul_left
        _ ≤ Real.exp (-Real.pi * ((d⁻¹) ^ 2 * ((m₀ : ℝ) - y 0) ^ 2)) * (|M'.det| * S_primal) :=
            mul_le_mul_of_nonneg_left (h_dual_bound (w' m₀)) (le_of_lt (Real.exp_pos _))
        _ = (|M'.det| * S_primal) * Real.exp (-Real.pi * (d⁻¹) ^ 2 * ((m₀ : ℝ) - y 0) ^ 2) := by
            rw [mul_comm, ← mul_assoc]
    have hH_sum : Summable H_dual :=
      (summable_prod_of_nonneg (fun _ => le_of_lt (Real.exp_pos _))).mpr ⟨hH_fiber_sum, hH_outer_sum⟩
    let e₂ : ℤ × (Fin n → ℤ) ≃ (Fin (n + 1) → ℤ) :=
      Fin.consEquiv (fun _ : Fin (n + 1) => ℤ)
    have he₂_zero : ∀ p : ℤ × (Fin n → ℤ), e₂ p 0 = p.1 := by
      intro p; simp [e₂]
    have he₂_succ : ∀ (p : ℤ × (Fin n → ℤ)) (l : Fin n), e₂ p l.succ = p.2 l := by
      intro p l; simp [e₂]
    have h_re_eq : ∀ p : ℤ × (Fin n → ℤ),
        Real.exp
          (-Real.pi *
            ((d⁻¹) ^ 2 * ((e₂ p 0 : ℝ) - y 0) ^ 2 +
              ∑ i : Fin n,
                (M'.transpose⁻¹.mulVec
                  (fun l => ((e₂ p l.succ : ℝ) - y l.succ) - ((e₂ p 0 : ℝ) - y 0) * c l) i) ^ 2)) =
        H_dual p := by
      intro p
      dsimp only [H_dual]
      have hsucc : (fun l : Fin n => ((e₂ p l.succ : ℝ) - y l.succ) - ((e₂ p 0 : ℝ) - y 0) * c l) =
          (fun l : Fin n => ((p.2 l : ℝ) - y l.succ) - ((p.1 : ℝ) - y 0) * c l) := by
        ext l
        rw [he₂_zero, he₂_succ]
      rw [hsucc, he₂_zero]
    rw [← Equiv.tsum_eq e₂]
    have h_congr : (∑' p : ℤ × (Fin n → ℤ),
        (Real.exp
          (-Real.pi *
            ((d⁻¹) ^ 2 * ((e₂ p 0 : ℝ) - y 0) ^ 2 +
              ∑ i : Fin n,
                (M'.transpose⁻¹.mulVec
                  (fun l => ((e₂ p l.succ : ℝ) - y l.succ) - ((e₂ p 0 : ℝ) - y 0) * c l) i) ^ 2)) : ℂ)) =
        ∑' p : ℤ × (Fin n → ℤ), (H_dual p : ℂ) :=
      tsum_congr (fun p => congr_arg Complex.ofReal (h_re_eq p))
    rw [h_congr, ← Complex.ofReal_tsum, hH_sum.tsum_prod, Complex.ofReal_tsum]
    refine tsum_congr (fun m₀ => ?_)
    calc ((∑' m' : Fin n → ℤ, H_dual (m₀, m') : ℝ) : ℂ)
      _ = ∑' m' : Fin n → ℤ, (H_dual (m₀, m') : ℂ) := Complex.ofReal_tsum _
      _ = ∑' m' : Fin n → ℤ,
            ((Real.exp (-Real.pi * ((d⁻¹) ^ 2 * ((m₀ : ℝ) - y 0) ^ 2)) : ℂ) *
              (Real.exp
                (-Real.pi *
                  ∑ i : Fin n,
                    (M'.transpose⁻¹.mulVec
                      (fun l => ((m' l : ℝ) - y l.succ) - ((m₀ : ℝ) - y 0) * c l) i) ^ 2) : ℂ)) := by
          refine tsum_congr (fun m' => ?_)
          rw [← Complex.ofReal_mul]
          congr 1
          dsimp only [H_dual]
          rw [← Real.exp_add]
          congr 1
          ring
      _ = (Real.exp (-Real.pi * ((d⁻¹) ^ 2 * ((m₀ : ℝ) - y 0) ^ 2)) : ℂ) *
            ∑' m' : Fin n → ℤ,
              (Real.exp
                (-Real.pi *
                  ∑ i : Fin n,
                    (M'.transpose⁻¹.mulVec
                      (fun l => ((m' l : ℝ) - y l.succ) - ((m₀ : ℝ) - y 0) * c l) i) ^ 2) : ℂ) :=
          tsum_mul_left
  rw [h_s2, h_s3]
  have h_inner : ∀ m₀ : ℤ,
      (Real.exp (-Real.pi * ((d⁻¹) ^ 2 * ((m₀ : ℝ) - y 0) ^ 2)) : ℂ) *
        (∑' k' : Fin n → ℤ,
          Complex.exp
            ((-Real.pi * ∑ i : Fin n, (M'.mulVec (fun l => (k' l : ℝ)) i) ^ 2 : ℝ) +
              2 * Real.pi * Complex.I *
                ∑ l : Fin n, (((y l.succ + ((m₀ : ℝ) - y 0) * c l : ℝ) * (k' l : ℝ) : ℂ)))) =
      ((|M'.det|⁻¹ : ℝ) : ℂ) *
        ((Real.exp (-Real.pi * ((d⁻¹) ^ 2 * ((m₀ : ℝ) - y 0) ^ 2)) : ℂ) *
          ∑' m' : Fin n → ℤ,
            (Real.exp
              (-Real.pi *
                ∑ i : Fin n,
                  (M'.transpose⁻¹.mulVec
                    (fun l => ((m' l : ℝ) - y l.succ) - ((m₀ : ℝ) - y 0) * c l) i) ^ 2) : ℂ)) := by
    intro m₀
    rw [h_IH (fun l => y l.succ + ((m₀ : ℝ) - y 0) * c l), mul_left_comm]
    congr 2
    refine tsum_congr (fun m' => ?_)
    have h_vec : (fun l : Fin n => (m' l : ℝ) - (y l.succ + ((m₀ : ℝ) - y 0) * c l)) =
        (fun l : Fin n => ((m' l : ℝ) - y l.succ) - ((m₀ : ℝ) - y 0) * c l) := by
      ext l; ring
    rw [h_vec]
  calc ((|d|⁻¹ : ℝ) : ℂ) *
        ∑' m₀ : ℤ,
          (Real.exp (-Real.pi * ((d⁻¹) ^ 2 * ((m₀ : ℝ) - y 0) ^ 2)) : ℂ) *
            ∑' k' : Fin n → ℤ,
              Complex.exp
                ((-Real.pi * ∑ i : Fin n, (M'.mulVec (fun l => (k' l : ℝ)) i) ^ 2 : ℝ) +
                  2 * Real.pi * Complex.I *
                    ∑ l : Fin n, (((y l.succ + ((m₀ : ℝ) - y 0) * c l : ℝ) * (k' l : ℝ) : ℂ)))
    _ = ((|d|⁻¹ : ℝ) : ℂ) *
          ∑' m₀ : ℤ,
            (((|M'.det|⁻¹ : ℝ) : ℂ) *
              ((Real.exp (-Real.pi * ((d⁻¹) ^ 2 * ((m₀ : ℝ) - y 0) ^ 2)) : ℂ) *
                ∑' m' : Fin n → ℤ,
                  (Real.exp
                    (-Real.pi *
                      ∑ i : Fin n,
                        (M'.transpose⁻¹.mulVec
                          (fun l => ((m' l : ℝ) - y l.succ) - ((m₀ : ℝ) - y 0) * c l) i) ^ 2) : ℂ))) := by
        rw [tsum_congr h_inner]
    _ = ((|d|⁻¹ : ℝ) : ℂ) *
          (((|M'.det|⁻¹ : ℝ) : ℂ) *
            ∑' m₀ : ℤ,
              (Real.exp (-Real.pi * ((d⁻¹) ^ 2 * ((m₀ : ℝ) - y 0) ^ 2)) : ℂ) *
                ∑' m' : Fin n → ℤ,
                  (Real.exp
                    (-Real.pi *
                      ∑ i : Fin n,
                        (M'.transpose⁻¹.mulVec
                          (fun l => ((m' l : ℝ) - y l.succ) - ((m₀ : ℝ) - y 0) * c l) i) ^ 2) : ℂ)) := by
        rw [tsum_mul_left]
    _ = (((|d| * |M'.det|)⁻¹ : ℝ) : ℂ) *
          ∑' m₀ : ℤ,
            (Real.exp (-Real.pi * ((d⁻¹) ^ 2 * ((m₀ : ℝ) - y 0) ^ 2)) : ℂ) *
              ∑' m' : Fin n → ℤ,
                (Real.exp
                  (-Real.pi *
                    ∑ i : Fin n,
                      (M'.transpose⁻¹.mulVec
                        (fun l => ((m' l : ℝ) - y l.succ) - ((m₀ : ℝ) - y 0) * c l) i) ^ 2) : ℂ) := by
        rw [← mul_assoc, ← Complex.ofReal_mul, mul_inv]

theorem mitsui_matrix_lattice_gaussian_poisson_summation (n : ℕ)
    (M : Matrix (Fin n) (Fin n) ℝ) (hM : M.det ≠ 0) :
    Summable (fun k : Fin n → ℤ =>
      Real.exp (-Real.pi *
        ∑ j : Fin n, (M.mulVec (fun i => (k i : ℝ)) j) ^ 2)) ∧
    1 +
      (∑' k : {k : Fin n → ℤ // k ≠ 0},
        Real.exp (-Real.pi *
          ∑ j : Fin n, (M.mulVec (fun i => (k.1 i : ℝ)) j) ^ 2)) =
    |M.det|⁻¹ *
      (1 +
        (∑' m : {m : Fin n → ℤ // m ≠ 0},
          Real.exp (-Real.pi *
            ∑ j : Fin n, (M.transpose⁻¹.mulVec (fun i => (m.1 i : ℝ)) j) ^ 2))) :=
by
  have h_det_dual : ∀ {N : ℕ} (B : Matrix (Fin N) (Fin N) ℝ), B.det ≠ 0 → B.transpose⁻¹.det ≠ 0 := by
    intro N B hB
    rw [Matrix.det_nonsing_inv, Matrix.det_transpose, Ring.inverse_eq_inv]
    exact inv_ne_zero hB
  have h_sum_zero : ∀ {N : ℕ} (B : Matrix (Fin N) (Fin N) ℝ), B.det ≠ 0 →
      Summable (fun k : Fin N → ℤ =>
        Real.exp (-Real.pi * ∑ j : Fin N, (B.mulVec (fun i => (k i : ℝ)) j) ^ 2)) := by
    intro N B hB
    have h0 := mitsui_matrix_lattice_shifted_gaussian_summable N B hB 0
    refine h0.congr (fun k => ?_)
    have hk : (fun i : Fin N => (k i : ℝ) + (0 : Fin N → ℝ) i) = (fun i : Fin N => (k i : ℝ)) := by
      ext i; exact add_zero _
    rw [hk]
  have h_phased : ∀ (N : ℕ) (A : Matrix (Fin N) (Fin N) ℝ), A.det ≠ 0 → ∀ y : Fin N → ℝ,
      (∑' k : Fin N → ℤ,
        Complex.exp ((-Real.pi * ∑ j : Fin N, (A.mulVec (fun i => (k i : ℝ)) j) ^ 2 : ℝ) +
          2 * Real.pi * Complex.I * ∑ l : Fin N, (y l * (k l : ℝ) : ℂ))) =
      ((|A.det|⁻¹ : ℝ) : ℂ) *
        ∑' m : Fin N → ℤ,
          (Real.exp (-Real.pi * ∑ j : Fin N,
            (A.transpose⁻¹.mulVec (fun i => (m i : ℝ) - y i) j) ^ 2) : ℂ) := by
    intro N
    induction' N with N ih
    · intro A _hA y
      rw [tsum_fintype, tsum_fintype]
      simp [Matrix.det_fin_zero]
    · intro A hA y
      obtain ⟨d, c, M', hd, hM', hdet, hQ_primal, hQ_dual⟩ :=
        mitsui_matrix_succ_orthogonal_column_split N A hA
      have h_sum : Summable (fun k : Fin (N + 1) → ℤ =>
          Real.exp (-Real.pi *
            (d ^ 2 * ((k 0 : ℝ) + ∑ i : Fin N, c i * (k i.succ : ℝ)) ^ 2 +
              ∑ i : Fin N, (M'.mulVec (fun l => (k l.succ : ℝ)) i) ^ 2))) := by
        refine (h_sum_zero A hA).congr (fun k => ?_)
        rw [hQ_primal (fun i => (k i : ℝ))]
      have h_sum' : Summable (fun k' : Fin N → ℤ =>
          Real.exp (-Real.pi * ∑ i : Fin N, (M'.mulVec (fun l => (k' l : ℝ)) i) ^ 2)) :=
        h_sum_zero M' hM'
      have h_dual' : ∀ w' : Fin N → ℝ,
          Summable (fun m' : Fin N → ℤ =>
            Real.exp (-Real.pi * ∑ i : Fin N,
              (M'.transpose⁻¹.mulVec (fun l => (m' l : ℝ) - w' l) i) ^ 2)) := by
        intro w'
        have hw := mitsui_matrix_lattice_shifted_gaussian_summable N M'.transpose⁻¹ (h_det_dual M' hM') (-w')
        refine hw.congr (fun m' => ?_)
        have hm : (fun l : Fin N => (m' l : ℝ) + (-w') l) = (fun l : Fin N => (m' l : ℝ) - w' l) := by
          ext l; exact (sub_eq_add_neg _ _).symm
        rw [hm]
      have h_lhs :
          (∑' k : Fin (N + 1) → ℤ,
            Complex.exp ((-Real.pi * ∑ j : Fin (N + 1), (A.mulVec (fun i => (k i : ℝ)) j) ^ 2 : ℝ) +
              2 * Real.pi * Complex.I * ∑ l : Fin (N + 1), (y l * (k l : ℝ) : ℂ))) =
          (∑' k : Fin (N + 1) → ℤ,
            Complex.exp
              ((-Real.pi *
                  (d ^ 2 * ((k 0 : ℝ) + ∑ i : Fin N, c i * (k i.succ : ℝ)) ^ 2 +
                    ∑ i : Fin N, (M'.mulVec (fun l => (k l.succ : ℝ)) i) ^ 2) : ℝ) +
                2 * Real.pi * Complex.I * ∑ j : Fin (N + 1), (y j * (k j : ℝ) : ℂ))) := by
        refine tsum_congr (fun k => ?_)
        rw [hQ_primal (fun i => (k i : ℝ))]
      have h_rhs :
          (∑' m : Fin (N + 1) → ℤ,
            (Real.exp (-Real.pi * ∑ j : Fin (N + 1),
              (A.transpose⁻¹.mulVec (fun i => (m i : ℝ) - y i) j) ^ 2) : ℂ)) =
          (∑' m : Fin (N + 1) → ℤ,
            (Real.exp
              (-Real.pi *
                ((d⁻¹) ^ 2 * ((m 0 : ℝ) - y 0) ^ 2 +
                  ∑ i : Fin N,
                    (M'.transpose⁻¹.mulVec
                      (fun l => ((m l.succ : ℝ) - y l.succ) - ((m 0 : ℝ) - y 0) * c l) i) ^ 2)) : ℂ)) := by
        refine tsum_congr (fun m => ?_)
        rw [hQ_dual (fun i => (m i : ℝ) - y i)]
      rw [h_lhs, hdet, h_rhs]
      exact mitsui_block_quadratic_phased_gaussian_poisson_step N d hd c M' hM' h_sum h_sum' h_dual' (ih M' hM') y
  have h_sum_M : Summable (fun k : Fin n → ℤ =>
      Real.exp (-Real.pi * ∑ j : Fin n, (M.mulVec (fun i => (k i : ℝ)) j) ^ 2)) :=
    h_sum_zero M hM
  have h_sum_dual : Summable (fun m : Fin n → ℤ =>
      Real.exp (-Real.pi * ∑ j : Fin n, (M.transpose⁻¹.mulVec (fun i => (m i : ℝ)) j) ^ 2)) :=
    h_sum_zero M.transpose⁻¹ (h_det_dual M hM)
  refine ⟨h_sum_M, ?_⟩
  have h_split : ∀ (B : Matrix (Fin n) (Fin n) ℝ),
      Summable (fun k : Fin n → ℤ =>
        Real.exp (-Real.pi * ∑ j : Fin n, (B.mulVec (fun i => (k i : ℝ)) j) ^ 2)) →
      1 + (∑' k : {k : Fin n → ℤ // k ≠ 0},
        Real.exp (-Real.pi * ∑ j : Fin n, (B.mulVec (fun i => (k.1 i : ℝ)) j) ^ 2)) =
      ∑' k : Fin n → ℤ,
        Real.exp (-Real.pi * ∑ j : Fin n, (B.mulVec (fun i => (k i : ℝ)) j) ^ 2) := by
    intro B hB
    let f : (Fin n → ℤ) → ℝ := fun k =>
      Real.exp (-Real.pi * ∑ j : Fin n, (B.mulVec (fun i => (k i : ℝ)) j) ^ 2)
    have hf0 : f 0 = 1 := by
      dsimp [f]
      have h0 : (fun _ : Fin n => ((0 : ℤ) : ℝ)) = 0 := by ext i; simp
      rw [h0, Matrix.mulVec_zero]
      simp
    have h_ite : (∑' k : {k : Fin n → ℤ // k ≠ 0}, f k.1) = ∑' k : Fin n → ℤ, if k = 0 then 0 else f k := by
      have h_sub := tsum_subtype {k : Fin n → ℤ | k ≠ 0} f
      refine h_sub.trans (tsum_congr (fun k => ?_))
      dsimp [Set.indicator]
      by_cases hk : k = 0 <;> simp [hk]
    have hB' : Summable f := hB
    change 1 + (∑' k : {k : Fin n → ℤ // k ≠ 0}, f k.1) = ∑' k : Fin n → ℤ, f k
    rw [Summable.tsum_eq_add_tsum_ite hB' 0, hf0, ← h_ite]
  rw [h_split M h_sum_M, h_split M.transpose⁻¹ h_sum_dual]
  have h0 := h_phased n M hM 0
  have h_lhs0 :
      (∑' k : Fin n → ℤ,
        Complex.exp ((-Real.pi * ∑ j : Fin n, (M.mulVec (fun i => (k i : ℝ)) j) ^ 2 : ℝ) +
          2 * Real.pi * Complex.I * ∑ l : Fin n, ((0 : Fin n → ℝ) l * (k l : ℝ) : ℂ))) =
      ((∑' k : Fin n → ℤ,
        Real.exp (-Real.pi * ∑ j : Fin n, (M.mulVec (fun i => (k i : ℝ)) j) ^ 2) : ℝ) : ℂ) := by
    rw [Complex.ofReal_tsum]
    refine tsum_congr (fun k => ?_)
    have h_phase : (∑ l : Fin n, ((0 : Fin n → ℝ) l * (k l : ℝ) : ℂ)) = 0 := by simp
    rw [h_phase, mul_zero, add_zero, Complex.ofReal_exp]
  have h_rhs0 :
      ((|M.det|⁻¹ : ℝ) : ℂ) *
        (∑' m : Fin n → ℤ,
          (Real.exp (-Real.pi * ∑ j : Fin n,
            (M.transpose⁻¹.mulVec (fun i => (m i : ℝ) - (0 : Fin n → ℝ) i) j) ^ 2) : ℂ)) =
      ((|M.det|⁻¹ *
        ∑' m : Fin n → ℤ,
          Real.exp (-Real.pi * ∑ j : Fin n,
            (M.transpose⁻¹.mulVec (fun i => (m i : ℝ)) j) ^ 2) : ℝ) : ℂ) := by
    rw [Complex.ofReal_mul, Complex.ofReal_tsum]
    congr 1
    refine tsum_congr (fun m => ?_)
    have hm : (fun i : Fin n => (m i : ℝ) - (0 : Fin n → ℝ) i) = (fun i : Fin n => (m i : ℝ)) := by
      ext i; exact sub_zero _
    rw [hm]
  rw [h_lhs0, h_rhs0] at h0
  exact Complex.ofReal_injective h0

theorem mitsui_ideal_lattice_poisson_theta_inversion {K : Type u} [Field K] [NumberField K]
    (J₁ J₂ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))
    (γ : NumberField.RingOfIntegers K) (hγ : γ ≠ 0)
    (h_span : differentIdeal ℤ (NumberField.RingOfIntegers K) *
      (J₁ : Ideal (NumberField.RingOfIntegers K)) *
      (J₂ : Ideal (NumberField.RingOfIntegers K)) =
      Ideal.span ({γ} : Set (NumberField.RingOfIntegers K)))
    (c : NumberField.InfinitePlace K → ℝ) (hc : ∀ w : NumberField.InfinitePlace K, 0 < c w) :
    let R := NumberField.RingOfIntegers K
    let D : ℝ := |(NumberField.discr K : ℝ)|
    1 +
      (∑' x₁ : {x : R // x ≠ 0 ∧ x ∈ (J₁ : Ideal R)},
        Real.exp (-Real.pi *
          ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * (c w) ^ 2 * (w (x₁.1 : K)) ^ 2)) =
    (D ^ (1 / 2 : ℝ) * (Ideal.absNorm (J₁ : Ideal R) : ℝ) *
      ∏ w : NumberField.InfinitePlace K, (c w) ^ w.mult)⁻¹ *
      (1 +
        (∑' x₂ : {x : R // x ≠ 0 ∧ x ∈ (J₂ : Ideal R)},
          Real.exp (-Real.pi *
            ∑ w : NumberField.InfinitePlace K,
              (w.mult : ℝ) * (c w) ^ (-2 : ℤ) * (w ((x₂.1 : K) / (γ : K))) ^ 2))) :=
by
  intro R D
  set n : ℕ := Module.finrank ℚ K
  obtain ⟨v₁, v₂, e₁, e₂, h_lin₁, h_lin₂, h_dual, h_det⟩ :=
    mitsui_ideal_lattice_trace_dual_zbasis_and_det J₁ J₂ γ hγ h_span
  have hD_pos : 0 < D := by
    dsimp [D]
    exact abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  have hJ₁_ne : (J₁ : Ideal R) ≠ ⊥ := nonZeroDivisors.coe_ne_zero J₁
  have hNJ₁_pos : 0 < (Ideal.absNorm (J₁ : Ideal R) : ℝ) := by
    exact_mod_cast Nat.pos_of_ne_zero (Ideal.absNorm_eq_zero_iff.not.mpr hJ₁_ne)
  set Δ : ℝ := D ^ (1 / 2 : ℝ) * (Ideal.absNorm (J₁ : Ideal R) : ℝ)
  have hΔ_pos : 0 < Δ := by dsimp [Δ]; positivity
  have hΔ_sq : Δ ^ 2 = D * (Ideal.absNorm (J₁ : Ideal R) : ℝ) ^ 2 := by
    dsimp [Δ]
    rw [mul_pow, ← Real.rpow_natCast (D ^ (1 / 2 : ℝ)) 2, ← Real.rpow_mul (le_of_lt hD_pos)]
    norm_num
  obtain ⟨M, hM_ne, hM_det, hQ₁, hQ₂⟩ :=
    mitsui_infinitePlace_weighted_euclidean_trace_duality
      (fun i => (v₁ i : K)) (fun i => (v₂ i : K) / (γ : K))
      Δ hΔ_pos h_dual (h_det.trans hΔ_sq.symm) c hc
  have h_lhs :
      (∑' x₁ : {x : R // x ≠ 0 ∧ x ∈ (J₁ : Ideal R)},
        Real.exp (-Real.pi *
          ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * (c w) ^ 2 * (w (x₁.1 : K)) ^ 2)) =
      (∑' k : {k : Fin n → ℤ // k ≠ 0},
        Real.exp (-Real.pi *
          ∑ j : Fin n, (M.mulVec (fun i => (k.1 i : ℝ)) j) ^ 2)) := by
    rw [← Equiv.tsum_eq e₁]
    refine tsum_congr (fun k => ?_)
    congr 1
    congr 1
    have h1 :
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (c w) ^ 2 * (w (((e₁ k).1 : R) : K)) ^ 2) =
