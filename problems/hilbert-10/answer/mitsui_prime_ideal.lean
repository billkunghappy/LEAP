        exact ⟨lt_of_lt_of_le hp.1 hR₀₁_sq, hp.2⟩
      have hV_mono : (MeasureTheory.volume (V_cplx R₀)).toReal ≤ (MeasureTheory.volume (V_cplx R₁)).toReal :=
        ENNReal.toReal_mono (hV_ne_top R₁ hR₁) (MeasureTheory.measure_mono hV_sub)
      have hV_diff : (MeasureTheory.volume (V_cplx R₁)).toReal - (MeasureTheory.volume (V_cplx R₀)).toReal =
