  have hq₀ : q₀ ≠ 0 := top_ne_bot
  let ψ₀ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q₀)ˣ) ℂ := 0
  haveI h_sub_quot : Subsingleton (NumberField.RingOfIntegers K ⧸ q₀) :=
    Ideal.Quotient.subsingleton_iff.mpr rfl
  have h_unit : ∀ x : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk q₀ x) :=
    fun _ => isUnit_of_subsingleton _
  have h_tsum_cast_pp : ∀ (P Q : NumberField.RingOfIntegers K ×
        IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ → Prop)
      (hPQ : ∀ xpm, P xpm ↔ Q xpm)
      (f : NumberField.RingOfIntegers K ×
        IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ → ℝ)
      (u_fn : ∀ xpm : {xpm : NumberField.RingOfIntegers K ×
        IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ // P xpm},
        Additive (NumberField.RingOfIntegers K ⧸ q₀)ˣ),
      (∑' xpm : {xpm : NumberField.RingOfIntegers K ×
          IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ // P xpm},
          ψ₀ (u_fn xpm) * (f xpm.1 : ℂ)) =
      ((∑' xpm : {xpm : NumberField.RingOfIntegers K ×
          IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ // Q xpm},
