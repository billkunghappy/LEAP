                      mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ j + (d j : ℝ)) *
                      α w j) : ℝ) * Complex.I)) := by
    intro x hx_ne
    let I_x : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
      ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩
    obtain ⟨d, hd⟩ := hΦ_W_prin x hx_ne
    let c : Fin r → ℝ := fun j => Φ_W I_x j + (d j : ℝ)
    have hxK : (x : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx_ne
    have hn_pos : (0 : ℝ) < (n : ℝ) := by
      dsimp [n]
      exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
    have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
    have h_sum_mult : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ)) = (n : ℝ) := by
      dsimp [n]
      exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
    have hℓ_eq : ∀ w : NumberField.InfinitePlace K,
        ℓ x w = ∑ j : Fin r, c j *
          Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) := by
      intro w
      have hwx : w (x : K) ≠ 0 := ne_of_gt (w.pos_iff.mpr hxK)
      have h_step : ∀ v : NumberField.InfinitePlace K,
          (v.mult : ℝ) * (Real.log (w (x : K)) - Real.log (v (x : K))) =
            ∑ j : Fin r, c j * ((v.mult : ℝ) *
              Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) -
              (v.mult : ℝ) *
              Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) := by
        intro v
        have hvx : v (x : K) ≠ 0 := ne_of_gt (v.pos_iff.mpr hxK)
        have hdv := hd w v
        rw [Real.log_div hwx hvx] at hdv
        change Real.log (w (x : K)) - Real.log (v (x : K)) =
          ∑ j : Fin r, c j *
            Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
              v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) at hdv
        rw [hdv, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        let η_j : K := (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)
        have hη_ne : η_j ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero _)
        have hwη : w η_j ≠ 0 := ne_of_gt (w.pos_iff.mpr hη_ne)
        have hvη : v η_j ≠ 0 := ne_of_gt (v.pos_iff.mpr hη_ne)
        change (v.mult : ℝ) * (c j * Real.log (w η_j / v η_j)) =
          c j * ((v.mult : ℝ) * Real.log (w η_j) - (v.mult : ℝ) * Real.log (v η_j))
        rw [Real.log_div hwη hvη]
        ring
      have h_sum_v := Finset.sum_congr rfl (fun v (_ : v ∈ Finset.univ) => h_step v)
      have h_lhs : (∑ v : NumberField.InfinitePlace K,
          (v.mult : ℝ) * (Real.log (w (x : K)) - Real.log (v (x : K)))) =
          (n : ℝ) * ℓ x w := by
        simp_rw [mul_sub]
        rw [Finset.sum_sub_distrib, ← Finset.sum_mul, h_sum_mult]
        dsimp [ℓ]
        field_simp [hn_ne]
      have h_rhs : (∑ v : NumberField.InfinitePlace K,
          ∑ j : Fin r, c j * ((v.mult : ℝ) *
            Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) -
            (v.mult : ℝ) *
            Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)))) =
          (n : ℝ) * ∑ j : Fin r, c j *
            Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) := by
        rw [Finset.sum_comm, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [← Finset.mul_sum, Finset.sum_sub_distrib, ← Finset.sum_mul, h_sum_mult]
        have h_unit_sum : (∑ v : NumberField.InfinitePlace K,
            (v.mult : ℝ) *
              Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) = 0 := by
          simpa using NumberField.Units.sum_mult_mul_log (NumberField.Units.fundSystem K j)
        rw [h_unit_sum, sub_zero]
        ring
      rw [h_lhs, h_rhs] at h_sum_v
      exact mul_left_cancel₀ hn_ne h_sum_v
    have hL_eq : L_vec x = ∑ j : Fin r, c j • B_R j := by
      ext w
      have h_eval : (∑ j : Fin r, c j • B_R j) w = ∑ j : Fin r, c j * (B_R j w) := by
        simp [Finset.sum_apply]
      rw [h_eval]
      change (w.1.mult : ℝ) * ℓ x w.1 = _
      rw [hℓ_eq w.1, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
