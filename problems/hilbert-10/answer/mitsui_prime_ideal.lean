theorem mitsui_place_sector_cell_main_term_sum_bound {K : Type u} [Field K] [NumberField K] :
    ∃ c_sum : ℝ, 0 < c_sum ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m → Real.log X ≤ (m : ℝ) →
          ∀ w₀ : NumberField.InfinitePlace K,
            |(∑' k : NumberField.InfinitePlace K → Fin m,
                (if (k w₀ : ℕ) + 1 = m then (1 : ℝ) else 0) *
                  (∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) *
                  (Real.log X / (m : ℝ)) ^ (NumberField.Units.rank K) *
                  (X ^ (Module.finrank ℚ K) *
                    Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
                      (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))))
              - (w₀.mult : ℝ) * X ^ (Module.finrank ℚ K)|
              ≤ c_sum * X ^ (Module.finrank ℚ K) * ((Real.log X + 1) ^ 2 / (m : ℝ)) +
                c_sum * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_sum) :=
by
  classical
  have h_s1 : ∀ (X : ℝ) (m : ℕ), 1 ≤ m → ∀ (w₀ : NumberField.InfinitePlace K),
      (∑' k : NumberField.InfinitePlace K → Fin m,
          (if (k w₀ : ℕ) + 1 = m then (1 : ℝ) else 0) *
            (∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) *
            (Real.log X / (m : ℝ)) ^ (NumberField.Units.rank K) *
            (X ^ (Module.finrank ℚ K) *
              Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))))
        = (w₀.mult : ℝ) * X ^ (Module.finrank ℚ K) *
            ∏ w ∈ Finset.univ.erase w₀,
              ∑ j : Fin m,
                ((w.mult : ℝ) * (Real.log X / (m : ℝ))) *
                  Real.exp (((w.mult : ℝ) * (Real.log X / (m : ℝ))) *
                    (((j : ℕ) : ℝ) + 1 - (m : ℝ))) := by
    intro X m hm w₀
    set n : ℕ := Module.finrank ℚ K
    set r : ℕ := NumberField.Units.rank K
    set Y : ℝ := X ^ n
    set δ : ℝ := Real.log X / (m : ℝ)
    let h_step : NumberField.InfinitePlace K → ℝ := fun w => (w.mult : ℝ) * δ
    let g_exp : NumberField.InfinitePlace K → Fin m → ℝ :=
      fun w j => Real.exp (h_step w * (((j : ℕ) : ℝ) + 1 - (m : ℝ)))
    let f_place : NumberField.InfinitePlace K → Fin m → ℝ :=
      fun w j =>
        (if w = w₀ then (if (j : ℕ) + 1 = m then (1 : ℝ) else 0) else 1) *
          ((w.mult : ℝ) * g_exp w j)
    have h_term : ∀ k : NumberField.InfinitePlace K → Fin m,
        (if (k w₀ : ℕ) + 1 = m then (1 : ℝ) else 0) *
          (∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) *
          δ ^ r *
          (Y * Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))) =
        Y * δ ^ r * ∏ w : NumberField.InfinitePlace K, f_place w (k w) := by
      intro k
      have h_exp : Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))) =
          ∏ w : NumberField.InfinitePlace K, g_exp w (k w) := by
        rw [Finset.mul_sum, Real.exp_sum]
        refine Finset.prod_congr rfl (fun w _ => ?_)
        dsimp [g_exp, h_step, δ]
        congr 1
        ring
      have h_ite : (∏ w : NumberField.InfinitePlace K,
          if w = w₀ then (if (k w : ℕ) + 1 = m then (1 : ℝ) else 0) else 1) =
          if (k w₀ : ℕ) + 1 = m then (1 : ℝ) else 0 :=
        Fintype.prod_ite_eq' w₀ (fun w => if (k w : ℕ) + 1 = m then (1 : ℝ) else 0)
