                rw [abs_of_pos hLq_pos, abs_of_pos (by positivity)]
                exact hLq_le_Qq)
            calc ‖g_χ 1‖
                ≤ (1 - σ) * C_deriv * (Real.log (Ideal.absNorm q : ℝ) + Real.log 4) ^ 2 := h1
              _ ≤ (B₂ / Q_q ^ 4) * C_deriv * (Real.log (Ideal.absNorm q : ℝ) + Real.log 4) ^ 2 := by
                  apply mul_le_mul_of_nonneg_right
                  · exact mul_le_mul_of_nonneg_right h_gap (le_of_lt hC_deriv_pos)
                  · positivity
              _ ≤ (B₂ / Q_q ^ 4) * C_deriv * (K_A * Q_q) ^ 2 := by
                  apply mul_le_mul_of_nonneg_left h_sq_Lq (by positivity)
          have h_combined : 1 - α₁ ≤ B₂ * (D_est / 2) := by
            have h_prod : 1 - α₁ ≤
                C_est * (Q₁ * Q_q) * ‖g₁ 1‖ *
                  ((B₂ / Q_q ^ 4) * C_deriv * (K_A * Q_q) ^ 2) *
                  (C_deriv * (K_A * (Q₁ * Q_q))) := by
              calc 1 - α₁
                  ≤ C_est * (Q₁ * Q_q) * ‖g₁ 1‖ * ‖g_χ 1‖ * ‖g₁₂ 1‖ := by
                    rwa [hQq₁q_eq] at h_est_ineq
                _ ≤ C_est * (Q₁ * Q_q) * ‖g₁ 1‖ *
                      ((B₂ / Q_q ^ 4) * C_deriv * (K_A * Q_q) ^ 2) * ‖g₁₂ 1‖ := by
                    apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
                    exact mul_le_mul_of_nonneg_left hg_χ_one_le (by positivity)
                _ ≤ C_est * (Q₁ * Q_q) * ‖g₁ 1‖ *
                      ((B₂ / Q_q ^ 4) * C_deriv * (K_A * Q_q) ^ 2) *
                      (C_deriv * (K_A * (Q₁ * Q_q))) := by
                    exact mul_le_mul_of_nonneg_left hg₁₂_one_le (by positivity)
            have h_alg :
                C_est * (Q₁ * Q_q) * ‖g₁ 1‖ *
                  ((B₂ / Q_q ^ 4) * C_deriv * (K_A * Q_q) ^ 2) *
                  (C_deriv * (K_A * (Q₁ * Q_q))) = B₂ * (D_est / 2) := by
              dsimp [D_est]
              have hQq_ne : Q_q ≠ 0 := ne_of_gt hQq_pos
              field_simp [hQq_ne]
            linarith
          have h_half : B₂ * (D_est / 2) ≤ (1 - α₁) / 2 := by
            have h1 := mul_le_mul_of_nonneg_right hB₂_le_est (by positivity : 0 ≤ D_est / 2)
            have h2 : ((1 - α₁) / D_est) * (D_est / 2) = (1 - α₁) / 2 := by
              have hD_ne : D_est ≠ 0 := ne_of_gt hD_est_pos
              field_simp [hD_ne]
