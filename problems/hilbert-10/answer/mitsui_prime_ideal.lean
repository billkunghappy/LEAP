      rw [FractionalIdeal.mem_dual (one_ne_zero : (1 : FractionalIdeal S₀ K) ≠ 0)]
      intro a ha
      rw [FractionalIdeal.mem_one_iff] at ha
      rcases ha with ⟨y, rfl⟩
      rw [Algebra.traceForm_apply]
      have h_eq : (v : K) / (γ₀ : K) * (algebraMap R K y) = (v : K) * (y : K) / (γ₀ : K) := by ring
      rw [h_eq]
