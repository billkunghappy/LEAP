                        ‖g_χ s‖ ≤ A₁ * ((Ideal.absNorm q : ℝ) * Real.exp M * (4 + |s.im|)) ^ (Module.finrank ℚ K + 1)) →
                      ∀ s : ℂ, s.im ≠ 0 →
