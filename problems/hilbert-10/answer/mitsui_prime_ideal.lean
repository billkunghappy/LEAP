        _ = (∑ a : R ⧸ f, ψ_f (u₀ * a)) - S_sum := by rw [← h_pull]
        _ = S_sum - S_sum := by rw [h_shift]
        _ = 0 := sub_self S_sum
    exact (mul_eq_zero.mp h_sub_zero).resolve_left (sub_ne_zero.mpr hψ_u₀)

theorem mitsui_principal_subideal_stripped_tsum_eq_torsion_inv_mul_cube_integral {K : Type u} [Field K] [NumberField K]
    (a_place : NumberField.InfinitePlace K → ℕ)
    (ν_place : NumberField.InfinitePlace K → ℝ)
    (hν_sum : (∑ w : NumberField.InfinitePlace K, ν_place w) = 0)
    (J : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))
    (ψ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hψ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖ψ I‖ ≤ 1)
    (b : ℝ) (hb : 0 < b) :
    let R := NumberField.RingOfIntegers K
    let n : ℕ := Module.finrank ℚ K
    let r : ℕ := NumberField.Units.rank K
    let Q_K : (Fin r → ℝ) → ℝ := fun y =>
      ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * ∏ i : Fin r,
          (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)
    let U_K : (Fin r → ℝ) → ℝ := fun y =>
      ∏ w : NumberField.InfinitePlace K,
        (∏ i : Fin r,
          (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (y i)) ^ (a_place w)
    let J_c : ℝ → ℂ := fun a =>
      ∫ y : Fin r → ℝ,
        ((U_K y * Real.exp (-a * Q_K y) : ℝ) : ℂ) *
          Complex.exp
            (((∑ w : NumberField.InfinitePlace K,
                ν_place w *
                  ∑ i : Fin r,
                    y i * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) : ℝ) *
              Complex.I)
    let Cube : Set (Fin r → ℝ) := Set.pi Set.univ (fun _ => Set.Ico (0 : ℝ) 1)
    (∑' m : ℕ,
      (∑' I : {I : Ideal R // I ≠ ⊥ ∧ I ≤ (J : Ideal R) ∧ I.IsPrincipal ∧
            Ideal.absNorm I = m * Ideal.absNorm (J : Ideal R)},
        ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
        ((((b / (Ideal.absNorm (J : Ideal R) : ℝ) *
            (Ideal.absNorm (J : Ideal R) * m : ℝ)) ^ (1 / (n : ℝ))) ^
          (∑ w : NumberField.InfinitePlace K, a_place w) : ℝ) : ℂ) *
        J_c (Real.pi * (b / (Ideal.absNorm (J : Ideal R) : ℝ) *
          (Ideal.absNorm (J : Ideal R) * m : ℝ)) ^ (2 / (n : ℝ)))) =
      (NumberField.Units.torsionOrder K : ℂ)⁻¹ *
        (∫ y in Cube,
          (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J : Ideal R)},
            ψ ⟨Ideal.span ({x.1} : Set R),
              mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr x.2.1)⟩ *
              Complex.exp (((∑ w : NumberField.InfinitePlace K, ν_place w * Real.log (w (x.1 : K))) : ℝ) * Complex.I) *
              ((((b / (Ideal.absNorm (J : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
                  (∑ w : NumberField.InfinitePlace K, a_place w) *
                (∏ w : NumberField.InfinitePlace K,
                  (w (x.1 : K) * ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (y i)) ^ (a_place w)) *
                Real.exp (-Real.pi * (b / (Ideal.absNorm (J : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                  ∑ w : NumberField.InfinitePlace K,
                    (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                      ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) : ℝ) : ℂ) *
              Complex.exp
                (((∑ w : NumberField.InfinitePlace K,
                    ν_place w *
                      ∑ i : Fin r,
                        y i * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) : ℝ) *
                  Complex.I))) ∧
    (∑' m : ℕ,
      (∑' I : {I : Ideal R // I ≠ ⊥ ∧ I ≤ (J : Ideal R) ∧ I.IsPrincipal ∧
            Ideal.absNorm I = m * Ideal.absNorm (J : Ideal R)},
        ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
        ((((b / (Ideal.absNorm (J : Ideal R) : ℝ) *
            (Ideal.absNorm (J : Ideal R) * m : ℝ)) ^ (1 / (n : ℝ))) ^
          (∑ w : NumberField.InfinitePlace K, a_place w) : ℝ) : ℂ) *
        J_c (Real.pi * (b / (Ideal.absNorm (J : Ideal R) : ℝ) *
          (Ideal.absNorm (J : Ideal R) * m : ℝ)) ^ (2 / (n : ℝ)))) =
      (NumberField.Units.torsionOrder K : ℂ)⁻¹ *
