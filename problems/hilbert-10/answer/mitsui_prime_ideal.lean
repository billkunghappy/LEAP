              ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) = 1 :=
        Finset.prod_eq_one (fun w _ => by rw [ha0 w, pow_zero])
      rw [hψ_all, star_one, h_prod, h_sum_a, pow_zero, one_mul, one_mul, one_mul]
      congr 3
      refine Finset.sum_congr rfl (fun w _ => ?_)
      congr 1
      refine Finset.prod_congr rfl (fun i _ => ?_)
      congr 1
      ring
    have hc_C_pos : ∀ C : ClassGroup R,
        0 < (b / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) := by
      intro C
      have hJ_ne : (J_rep C : Ideal R) ≠ ⊥ := nonZeroDivisors.coe_ne_zero (J_rep C)
      have hN_pos : (0 : ℝ) < (Ideal.absNorm (J_rep C : Ideal R) : ℝ) := by
        exact_mod_cast Nat.pos_of_ne_zero (Ideal.absNorm_eq_zero_iff.not.mpr hJ_ne)
      positivity
    refine ⟨?_, ?_⟩
    · simp_rw [h_term1]
      have h_per_C : ∀ C : ClassGroup R,
          star (ψ₀ (J_rep C)) *
            (∫ y in Cube,
              (∑' x : (J_rep C : Ideal R),
                (Real.exp (-Real.pi * (b / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
