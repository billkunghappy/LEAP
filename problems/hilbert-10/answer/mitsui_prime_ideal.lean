          ((NumberField.mixedEmbedding.stdBasis K).repr
              (NumberField.mixedEmbedding K (π : K)) i / w₀ (π : K)) ∈
          Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
            ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
      (∀ w : NumberField.InfinitePlace K,
        Real.log (w (π : K) / w₀ (π : K)) ∈
          Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
            (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))) ∧
      IsUnit (Ideal.Quotient.mk q π)}
  let e_cell_cop (p : NumberField.InfinitePlace K → Fin l) :
      S_cell_cop p ≃ {x : S_cop // P_cell p x.1} :=
    { toFun := fun π =>
        ⟨⟨π.1, π.2.1, fun w =>
            have hsub := h_cell_sub p π.1 π.2.1 ⟨π.2.2.1, π.2.2.2.1, π.2.2.2.2.1⟩
            lt_of_lt_of_le (lt_of_le_of_lt (hsub.2.1 w) hsub.2.2) hR'_le_X',
          π.2.2.2.2.2⟩,
         ⟨π.2.2.1, π.2.2.2.1, π.2.2.2.2.1⟩⟩
      invFun := fun x =>
        ⟨x.1.1, x.1.2.1, x.2.1, x.2.2.1, x.2.2.2, x.1.2.2.2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun x => by ext; rfl }
  have h_lhs_cell : ∀ p : NumberField.InfinitePlace K → Fin l,
      (∑' π : S_cell_cop p,
        ψ (Additive.ofMul π.2.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑ x : S_cop, (if P_cell p x.1 then term x else 0) := by
    intro p
    change (∑' π : S_cell_cop p, term (e_cell_cop p π).1) = _
    rw [Equiv.tsum_eq (e_cell_cop p) (fun z : {x : S_cop // P_cell p x.1} => term z.1), tsum_fintype]
    have hsub : (∑ z : {x : S_cop // P_cell p x.1}, term z.1) =
        ∑ x ∈ Finset.univ.filter (fun x : S_cop => P_cell p x.1), term x :=
      (Finset.sum_subtype (Finset.univ.filter (fun x : S_cop => P_cell p x.1))
        (fun _ => by simp) term).symm
    rw [hsub, Finset.sum_filter]
  have h_lhs2 :
      (∑' p : NumberField.InfinitePlace K → Fin l,
        ∑' π : S_cell_cop p,
          ψ (Additive.ofMul π.2.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑ x : S_cop, ((M x.1).card : ℂ) * term x := by
    rw [tsum_fintype]
    simp_rw [h_lhs_cell]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
  let c : NumberField.RingOfIntegers K → ℝ :=
    fun π => ((M π).card : ℝ) - (if P_cone π then 1 else 0)
  have hc_nonneg : ∀ π : NumberField.RingOfIntegers K, Prime π → 0 ≤ c π := by
    intro π h_prime
    dsimp [c]
    split_ifs with hcone
    · rw [h_cone_card_eq_one π h_prime hcone]
      norm_num
    · rw [sub_zero]
      positivity
  have h_lhs_diff :
      (∑' π : S_cone_cop,
        ψ (Additive.ofMul π.2.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) -
      (∑' p : NumberField.InfinitePlace K → Fin l,
        ∑' π : S_cell_cop p,
          ψ (Additive.ofMul π.2.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = - ∑ x : S_cop, (c x.1 : ℂ) * term x := by
    rw [h_lhs1, h_lhs2, ← Finset.sum_sub_distrib, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    dsimp [c]
    split_ifs <;> push_cast <;> ring
  have h_term_norm : ∀ x : S_cop,
      ‖(c x.1 : ℂ) * term x‖ = c x.1 * L x.1 := by
    intro x
    dsimp [term]
    rw [norm_mul, norm_mul, AddChar.norm_apply, one_mul,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hc_nonneg x.1 x.2.1),
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hL_nonneg x.1)]
  let e_cop : S_cop ≃ {y : S_uncond // IsUnit (Ideal.Quotient.mk q y.1)} :=
    { toFun := fun x => ⟨⟨x.1, x.2.1, x.2.2.1⟩, x.2.2.2⟩
      invFun := fun y => ⟨y.1.1, y.1.2.1, y.1.2.2, y.2⟩
      left_inv := fun x => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_lhs_le :
      ‖(∑' π : S_cone_cop,
        ψ (Additive.ofMul π.2.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) -
      (∑' p : NumberField.InfinitePlace K → Fin l,
        ∑' π : S_cell_cop p,
          ψ (Additive.ofMul π.2.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
      ≤ ∑ y : S_uncond, c y.1 * L y.1 := by
    rw [h_lhs_diff, norm_neg]
    calc ‖∑ x : S_cop, (c x.1 : ℂ) * term x‖
      _ ≤ ∑ x : S_cop, ‖(c x.1 : ℂ) * term x‖ := norm_sum_le _ _
      _ = ∑ x : S_cop, c x.1 * L x.1 := Finset.sum_congr rfl (fun x _ => h_term_norm x)
      _ = ∑ z : {y : S_uncond // IsUnit (Ideal.Quotient.mk q y.1)}, c z.1.1 * L z.1.1 :=
        Equiv.sum_comp e_cop (fun z : {y : S_uncond // IsUnit (Ideal.Quotient.mk q y.1)} =>
          c z.1.1 * L z.1.1)
      _ = ∑ y ∈ Finset.univ.filter (fun y : S_uncond => IsUnit (Ideal.Quotient.mk q y.1)),
            c y.1 * L y.1 :=
        (Finset.sum_subtype (Finset.univ.filter (fun y : S_uncond => IsUnit (Ideal.Quotient.mk q y.1)))
          (fun _ => by simp) (fun y : S_uncond => c y.1 * L y.1)).symm
      _ ≤ ∑ y : S_uncond, c y.1 * L y.1 :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
          (fun y _ _ => mul_nonneg (hc_nonneg y.1 y.2.1) (hL_nonneg y.1))
  let P_X : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ w : NumberField.InfinitePlace K, w (π : K) < X
  let P_ge : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K)
  let P_R' : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ w : NumberField.InfinitePlace K, w (π : K) < R'
  let P_R : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ w : NumberField.InfinitePlace K, w (π : K) < R
  have hc_le : ∀ y : S_uncond,
      c y.1 * L y.1 ≤
        (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0) +
        (if P_R' y.1 ∧ ¬ P_R y.1 then L y.1 else 0) := by
    intro y
    have h_ind_le : c y.1 ≤
        (if P_X y.1 ∧ ¬ P_ge y.1 then (1 : ℝ) else 0) +
        (if P_R' y.1 ∧ ¬ P_R y.1 then (1 : ℝ) else 0) := by
      dsimp [c]
      by_cases hcone : P_cone y.1
      · rw [if_pos hcone, h_cone_card_eq_one y.1 y.2.1 hcone]
        split_ifs <;> norm_num
      · rw [if_neg hcone, sub_zero]
        have h_card_le : ((M y.1).card : ℝ) ≤ 1 := by exact_mod_cast hM_le_one y.1
        by_cases hM_zero : (M y.1).card = 0
        · rw [hM_zero]
          split_ifs <;> norm_num
        · obtain ⟨p, hp⟩ := Finset.card_pos.mp (Nat.pos_of_ne_zero hM_zero)
          rw [Finset.mem_filter] at hp
          have hsub := h_cell_sub p y.1 y.2.1 hp.2
          have hR'_mem : P_R' y.1 := fun w => lt_of_le_of_lt (hsub.2.1 w) hsub.2.2
          by_cases hR_mem : P_R y.1
          · have hX_mem : P_X y.1 := fun w => lt_of_lt_of_le (hR_mem w) hR_le
            have hge : ¬ P_ge y.1 := by
              intro hge_pos
              exact hcone ⟨hsub.1, fun w => ⟨hge_pos w, hsub.2.1 w⟩, hR_mem w₀⟩
            have h1 : P_X y.1 ∧ ¬ P_ge y.1 := ⟨hX_mem, hge⟩
            rw [if_pos h1]
            split_ifs <;> linarith
          · have h2 : P_R' y.1 ∧ ¬ P_R y.1 := ⟨hR'_mem, hR_mem⟩
            rw [if_pos h2]
            split_ifs <;> linarith
    have h_mul := mul_le_mul_of_nonneg_right h_ind_le (hL_nonneg y.1)
    calc c y.1 * L y.1
      _ ≤ ((if P_X y.1 ∧ ¬ P_ge y.1 then (1 : ℝ) else 0) +
           (if P_R' y.1 ∧ ¬ P_R y.1 then (1 : ℝ) else 0)) * L y.1 := h_mul
      _ = (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0) +
          (if P_R' y.1 ∧ ¬ P_R y.1 then L y.1 else 0) := by
        split_ifs <;> ring
  have h_sum_c_le :
      ∑ y : S_uncond, c y.1 * L y.1 ≤
        (∑ y : S_uncond, (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0)) +
        (∑ y : S_uncond, (if P_R' y.1 ∧ ¬ P_R y.1 then L y.1 else 0)) := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_le_sum (fun y _ => hc_le y)
  let S_X_uncond := {π : NumberField.RingOfIntegers K //
    Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X}
  let e_X_uncond : S_X_uncond ≃ {y : S_uncond // P_X y.1} :=
    { toFun := fun π => ⟨⟨π.1, π.2.1, fun w => lt_trans (π.2.2 w) hX_lt_X'⟩, π.2.2⟩
      invFun := fun y => ⟨y.1.1, y.1.2.1, y.2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_rhs_X :
      (∑' π : S_X_uncond, L π.1) =
        ∑ y : S_uncond, (if P_X y.1 then L y.1 else 0) := by
    change (∑' π : S_X_uncond, L (e_X_uncond π).1.1) = _
    rw [Equiv.tsum_eq e_X_uncond (fun z : {y : S_uncond // P_X y.1} => L z.1.1), tsum_fintype]
    have hsub : (∑ z : {y : S_uncond // P_X y.1}, L z.1.1) =
        ∑ y ∈ Finset.univ.filter (fun y : S_uncond => P_X y.1), L y.1 :=
      (Finset.sum_subtype (Finset.univ.filter (fun y : S_uncond => P_X y.1))
        (fun _ => by simp) (fun y : S_uncond => L y.1)).symm
    rw [hsub, Finset.sum_filter]
  let S_Xge_uncond := {π : NumberField.RingOfIntegers K //
    Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X}
  let e_Xge_uncond : S_Xge_uncond ≃ {y : S_uncond // P_X y.1 ∧ P_ge y.1} :=
    { toFun := fun π =>
        ⟨⟨π.1, π.2.1, fun w => lt_trans (π.2.2 w).2 hX_lt_X'⟩,
         ⟨fun w => (π.2.2 w).2, fun w => (π.2.2 w).1⟩⟩
      invFun := fun y => ⟨y.1.1, y.1.2.1, fun w => ⟨y.2.2 w, y.2.1 w⟩⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_rhs_Xge :
      (∑' π : S_Xge_uncond, L π.1) =
        ∑ y : S_uncond, (if P_X y.1 ∧ P_ge y.1 then L y.1 else 0) := by
    change (∑' π : S_Xge_uncond, L (e_Xge_uncond π).1.1) = _
    rw [Equiv.tsum_eq e_Xge_uncond (fun z : {y : S_uncond // P_X y.1 ∧ P_ge y.1} => L z.1.1),
      tsum_fintype]
    have hsub : (∑ z : {y : S_uncond // P_X y.1 ∧ P_ge y.1}, L z.1.1) =
        ∑ y ∈ Finset.univ.filter (fun y : S_uncond => P_X y.1 ∧ P_ge y.1), L y.1 :=
      (Finset.sum_subtype (Finset.univ.filter (fun y : S_uncond => P_X y.1 ∧ P_ge y.1))
        (fun _ => by simp) (fun y : S_uncond => L y.1)).symm
    rw [hsub, Finset.sum_filter]
  have h_rhs1_eq :
      |(∑' π : S_X_uncond, L π.1) - (∑' π : S_Xge_uncond, L π.1)| =
        ∑ y : S_uncond, (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0) := by
    have h_diff :
        (∑' π : S_X_uncond, L π.1) - (∑' π : S_Xge_uncond, L π.1) =
          ∑ y : S_uncond, (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0) := by
      rw [h_rhs_X, h_rhs_Xge, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun y _ => ?_)
      by_cases h1 : P_X y.1 <;> by_cases h2 : P_ge y.1 <;> simp [h1, h2]
    have h_nonneg :
        0 ≤ ∑ y : S_uncond, (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0) :=
      Finset.sum_nonneg (fun y _ => by split_ifs; exact hL_nonneg y.1; exact le_rfl)
    rw [h_diff, abs_of_nonneg h_nonneg]
  let S_R'_uncond := {π : NumberField.RingOfIntegers K //
    Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < R'}
  let e_R'_uncond : S_R'_uncond ≃ {y : S_uncond // P_R' y.1} :=
    { toFun := fun π => ⟨⟨π.1, π.2.1, fun w => lt_of_lt_of_le (π.2.2 w) hR'_le_X'⟩, π.2.2⟩
      invFun := fun y => ⟨y.1.1, y.1.2.1, y.2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_rhs_R' :
      (∑' π : S_R'_uncond, L π.1) =
        ∑ y : S_uncond, (if P_R' y.1 then L y.1 else 0) := by
    change (∑' π : S_R'_uncond, L (e_R'_uncond π).1.1) = _
    rw [Equiv.tsum_eq e_R'_uncond (fun z : {y : S_uncond // P_R' y.1} => L z.1.1), tsum_fintype]
    have hsub : (∑ z : {y : S_uncond // P_R' y.1}, L z.1.1) =
        ∑ y ∈ Finset.univ.filter (fun y : S_uncond => P_R' y.1), L y.1 :=
      (Finset.sum_subtype (Finset.univ.filter (fun y : S_uncond => P_R' y.1))
        (fun _ => by simp) (fun y : S_uncond => L y.1)).symm
    rw [hsub, Finset.sum_filter]
  let S_R_uncond := {π : NumberField.RingOfIntegers K //
    Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < R}
  let e_R_uncond : S_R_uncond ≃ {y : S_uncond // P_R y.1} :=
    { toFun := fun π => ⟨⟨π.1, π.2.1, fun w => lt_of_lt_of_le (π.2.2 w) hR_le_X'⟩, π.2.2⟩
      invFun := fun y => ⟨y.1.1, y.1.2.1, y.2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_rhs_R :
      (∑' π : S_R_uncond, L π.1) =
        ∑ y : S_uncond, (if P_R y.1 then L y.1 else 0) := by
    change (∑' π : S_R_uncond, L (e_R_uncond π).1.1) = _
    rw [Equiv.tsum_eq e_R_uncond (fun z : {y : S_uncond // P_R y.1} => L z.1.1), tsum_fintype]
    have hsub : (∑ z : {y : S_uncond // P_R y.1}, L z.1.1) =
        ∑ y ∈ Finset.univ.filter (fun y : S_uncond => P_R y.1), L y.1 :=
      (Finset.sum_subtype (Finset.univ.filter (fun y : S_uncond => P_R y.1))
        (fun _ => by simp) (fun y : S_uncond => L y.1)).symm
    rw [hsub, Finset.sum_filter]
  have h_rhs2_eq :
      |(∑' π : S_R'_uncond, L π.1) - (∑' π : S_R_uncond, L π.1)| =
        ∑ y : S_uncond, (if P_R' y.1 ∧ ¬ P_R y.1 then L y.1 else 0) := by
    have h_diff :
        (∑' π : S_R'_uncond, L π.1) - (∑' π : S_R_uncond, L π.1) =
          ∑ y : S_uncond, (if P_R' y.1 ∧ ¬ P_R y.1 then L y.1 else 0) := by
      rw [h_rhs_R', h_rhs_R, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun y _ => ?_)
      by_cases hR : P_R y.1
      · have hR' : P_R' y.1 := fun w => lt_of_lt_of_le (hR w) hR_le_R'
        simp [hR, hR']
      · by_cases hR' : P_R' y.1 <;> simp [hR, hR']
    have h_nonneg :
        0 ≤ ∑ y : S_uncond, (if P_R' y.1 ∧ ¬ P_R y.1 then L y.1 else 0) :=
      Finset.sum_nonneg (fun y _ => by split_ifs; exact hL_nonneg y.1; exact le_rfl)
    rw [h_diff, abs_of_nonneg h_nonneg]
  change ‖(∑' π : S_cone_cop,
        ψ (Additive.ofMul π.2.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) -
      (∑' p : NumberField.InfinitePlace K → Fin l,
        ∑' π : S_cell_cop p,
          ψ (Additive.ofMul π.2.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
    ≤ |(∑' π : S_X_uncond, L π.1) - (∑' π : S_Xge_uncond, L π.1)| +
      |(∑' π : S_R'_uncond, L π.1) - (∑' π : S_R_uncond, L π.1)|
  rw [h_rhs1_eq, h_rhs2_eq]
  exact le_trans h_lhs_le h_sum_c_le

theorem mitsui_prime_sub_box_shell_diff_bound {K : Type u} [Field K] [NumberField K] :
    ∃ c_sub : ℝ, 0 < c_sub ∧
      ∀ X : ℝ, 1 < X →
        ∀ l : ℕ, 1 ≤ l → Real.log X ≤ (l : ℝ) →
          ∀ R : ℝ, 0 ≤ R → R ≤ X →
            |(∑' π : {π : NumberField.RingOfIntegers K //
                  Prime π ∧
                  ∀ w : NumberField.InfinitePlace K,
                    w (π : K) < R * Real.exp (Real.log X / (l : ℝ))},
                Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
              - (∑' π : {π : NumberField.RingOfIntegers K //
                    Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < R},
                  Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))|
              ≤ c_sub * X ^ (Module.finrank ℚ K) * ((Real.log X + 1) ^ 2 / (l : ℝ)) +
                c_sub * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_sub) :=
by
  classical
  letI : VAdd (NumberField.mixedEmbedding.integerLattice K)
    (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.vaddSet
  letI : VAdd (NumberField.mixedEmbedding.mixedSpace K)
    (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.vaddSet
  let F : Set (NumberField.mixedEmbedding.mixedSpace K) :=
    ZSpan.fundamentalDomain (NumberField.mixedEmbedding.latticeBasis K)
  have hF_bdd : Bornology.IsBounded F :=
    ZSpan.fundamentalDomain_isBounded (NumberField.mixedEmbedding.latticeBasis K)
  obtain ⟨D, hD_gt1, hF_ball⟩ := hF_bdd.subset_ball_lt 1 0
  have hD_ge1 : 1 ≤ D := le_of_lt hD_gt1
  have hD_pos : 0 < D := lt_of_lt_of_le zero_lt_one hD_ge1
  have hF_norm : ∀ z ∈ F, ∀ w : NumberField.InfinitePlace K,
      NumberField.mixedEmbedding.normAtPlace w z < D := by
    intro z hz w
    have hz_norm : ‖z‖ < D := by
      have h1 := hF_ball hz
      rwa [Metric.mem_ball, dist_zero_right] at h1
    rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
    · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw z]
      have h1 : ‖z.1 ⟨w, hw⟩‖ ≤ ‖z.1‖ := norm_le_pi_norm z.1 ⟨w, hw⟩
      have h2 : ‖z.1‖ ≤ ‖z‖ := by
        rw [Prod.norm_def]
        exact le_max_left _ _
      exact lt_of_le_of_lt (le_trans h1 h2) hz_norm
    · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hw z]
