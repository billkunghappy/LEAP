      exact Subtype.ext (sub_eq_zero.mp ((AbsoluteValue.eq_zero w.1).mp hw))
    have hS_bound : ∀ w₀ : NumberField.InfinitePlace K,
        ((hS_fin w₀).toFinset.card : ℝ) ≤ C_slab * (X ^ n * δ + X ^ (n - 1)) := by
      intro w₀
      let f_b : NumberField.InfinitePlace K → NNReal := fun _ => b
      let f_a : NumberField.InfinitePlace K → NNReal := fun w => if w = w₀ then a else b
      let B_b := NumberField.mixedEmbedding.convexBodyLT K f_b
      let B_a := NumberField.mixedEmbedding.convexBodyLT K f_a
      let T := (hS_fin w₀).toFinset
      let T_lat : Finset (NumberField.mixedEmbedding.integerLattice K) := T.map ⟨j, hj_inj⟩
      let U : Set (NumberField.mixedEmbedding.mixedSpace K) := ⋃ g ∈ T_lat, g +ᵥ F
      have haedisj : (T_lat : Set (NumberField.mixedEmbedding.integerLattice K)).Pairwise
          (Function.onFun (MeasureTheory.AEDisjoint MeasureTheory.volume) (fun g => g +ᵥ F)) := by
        intro g₁ _ g₂ _ hne
        exact hF_fund.aedisjoint hne
      have hnull : ∀ g ∈ T_lat, MeasureTheory.NullMeasurableSet (g +ᵥ F) MeasureTheory.volume := by
        intro g _
        change MeasureTheory.NullMeasurableSet
          ((g : NumberField.mixedEmbedding.mixedSpace K) +ᵥ F) MeasureTheory.volume
        exact (hF_meas.const_vadd (g : NumberField.mixedEmbedding.mixedSpace K)).nullMeasurableSet
      have hvol_union : MeasureTheory.volume U = (T.card : ENNReal) * MeasureTheory.volume F := by
        dsimp [U]
        rw [MeasureTheory.measure_biUnion_finset₀ haedisj hnull]
        have h_each : ∀ g ∈ T_lat, MeasureTheory.volume (g +ᵥ F) = MeasureTheory.volume F := by
          intro g _
          change MeasureTheory.volume ((g : NumberField.mixedEmbedding.mixedSpace K) +ᵥ F) =
            MeasureTheory.volume F
          exact MeasureTheory.measure_vadd MeasureTheory.volume
            (g : NumberField.mixedEmbedding.mixedSpace K) F
        rw [Finset.sum_congr rfl h_each, Finset.sum_const, nsmul_eq_mul, Finset.card_map]
      have h_disj : Disjoint U B_a := by
        rw [Set.disjoint_left]
        intro z hzU hzB
        simp only [U, Set.mem_iUnion] at hzU
        rcases hzU with ⟨g, hg, hzF⟩
        rcases Finset.mem_map.mp hg with ⟨x, hxT, rfl⟩
        rw [Set.Finite.mem_toFinset] at hxT
        rcases hzF with ⟨u, huF, rfl⟩
        have htri := NumberField.mixedEmbedding.normAtPlace_add_le w₀
          (NumberField.mixedEmbedding K (x : K) + u) (-u)
        have h_cancel : (NumberField.mixedEmbedding K (x : K) + u) + (-u) =
            NumberField.mixedEmbedding K (x : K) := add_neg_cancel_right _ _
        rw [h_cancel, NumberField.mixedEmbedding.normAtPlace_apply,
            NumberField.mixedEmbedding.normAtPlace_neg] at htri
        have huD := hF_norm u huF w₀
        have h_nonneg := h_norm_nonneg w₀ (NumberField.mixedEmbedding K (x : K) + u)
        have h_low : a_real ≤ NumberField.mixedEmbedding.normAtPlace w₀
            (NumberField.mixedEmbedding K (x : K) + u) :=
          max_le h_nonneg (by linarith only [hxT.1, htri, huD])
        have h_lt := (h_mem f_a _).mp hzB w₀
        change NumberField.mixedEmbedding.normAtPlace w₀
          (NumberField.mixedEmbedding K (x : K) + u) < (f_a w₀ : ℝ) at h_lt
        have hfa : (f_a w₀ : ℝ) = a_real := by simp [f_a, a]
        linarith only [h_low, h_lt, hfa]
      have h_sub : U ∪ B_a ⊆ B_b := by
        rintro z (hzU | hzBa)
        · simp only [U, Set.mem_iUnion] at hzU
          rcases hzU with ⟨g, hg, hzF⟩
          rcases Finset.mem_map.mp hg with ⟨x, hxT, rfl⟩
          rw [Set.Finite.mem_toFinset] at hxT
          rcases hzF with ⟨u, huF, rfl⟩
          rw [h_mem]
          intro w
          change NumberField.mixedEmbedding.normAtPlace w
            (NumberField.mixedEmbedding K (x : K) + u) < (f_b w : ℝ)
          have htri := NumberField.mixedEmbedding.normAtPlace_add_le w
            (NumberField.mixedEmbedding K (x : K)) u
          rw [NumberField.mixedEmbedding.normAtPlace_apply] at htri
          have huD := hF_norm u huF w
          have hfb : (f_b w : ℝ) = R' + D := by simp [f_b, b, b_real]
          have hxw := hxT.2 w
          linarith only [htri, huD, hfb, hxw]
        · rw [h_mem] at hzBa ⊢
          intro w
          refine lt_of_lt_of_le (hzBa w) ?_
          by_cases hw : w = w₀
          · simp [f_a, f_b, hw, a, b, hab]
          · simp [f_a, f_b, hw]
      have h_meas_ie : MeasureTheory.volume U + MeasureTheory.volume B_a ≤
          MeasureTheory.volume B_b := by
        rw [← MeasureTheory.measure_union h_disj (h_meas f_a)]
        exact MeasureTheory.measure_mono h_sub
      have hU_ne_top : MeasureTheory.volume U ≠ ⊤ := by
        rw [hvol_union]
        exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top T.card) hF_ne_top
      have h_real_ie := ENNReal.toReal_mono (h_vol_ne_top f_b) h_meas_ie
      rw [ENNReal.toReal_add hU_ne_top (h_vol_ne_top f_a),
          hvol_union, ENNReal.toReal_mul, ENNReal.toReal_natCast,
          h_toReal_vol f_a, h_toReal_vol f_b] at h_real_ie
      let S_rem : Finset (NumberField.InfinitePlace K) :=
        (Finset.univ : Finset (NumberField.InfinitePlace K)).erase w₀
      let P_rem : ℝ := ∏ w ∈ S_rem, b_real ^ w.mult
      have hPrem_nonneg : 0 ≤ P_rem := Finset.prod_nonneg (fun _ _ => by positivity)
      have hp_b : (∏ w : NumberField.InfinitePlace K, (f_b w : ℝ) ^ w.mult) =
          b_real ^ w₀.mult * P_rem := by
        have h1 := (Finset.mul_prod_erase (Finset.univ : Finset (NumberField.InfinitePlace K))
          (fun w => (f_b w : ℝ) ^ w.mult) (Finset.mem_univ w₀)).symm
        rw [h1]
        simp [f_b, b, P_rem, S_rem]
      have hp_a : (∏ w : NumberField.InfinitePlace K, (f_a w : ℝ) ^ w.mult) =
          a_real ^ w₀.mult * P_rem := by
        have h1 := (Finset.mul_prod_erase (Finset.univ : Finset (NumberField.InfinitePlace K))
          (fun w => (f_a w : ℝ) ^ w.mult) (Finset.mem_univ w₀)).symm
        rw [h1]
        have h_head : (f_a w₀ : ℝ) ^ w₀.mult = a_real ^ w₀.mult := by simp [f_a, a]
        have h_tail : (∏ w ∈ S_rem, (f_a w : ℝ) ^ w.mult) = P_rem := by
          refine Finset.prod_congr rfl (fun w hw => ?_)
          have hne : w ≠ w₀ := Finset.ne_of_mem_erase hw
          simp [f_a, hne, b]
        rw [h_head, h_tail]
      have h_factored : (T.card : ℝ) * V_K ≤
          F_K * (b_real ^ w₀.mult - a_real ^ w₀.mult) * P_rem := by
        rw [hp_a, hp_b] at h_real_ie
        change (T.card : ℝ) * V_K + F_K * (a_real ^ w₀.mult * P_rem) ≤
          F_K * (b_real ^ w₀.mult * P_rem) at h_real_ie
        linarith only [h_real_ie]
      have h_w0_bound : b_real ^ w₀.mult - a_real ^ w₀.mult ≤
          2 * B₀ ^ 2 * (X * δ + 2) * X ^ (w₀.mult - 1) := by
        rcases NumberField.InfinitePlace.isReal_or_isComplex w₀ with hw | hw
        · have hm_real : w₀.mult = 1 := NumberField.InfinitePlace.mult_isReal ⟨w₀, hw⟩
          rw [hm_real]
          simp only [Nat.sub_self, pow_one, pow_zero, mul_one]
          have hB₀_le_2sq : B₀ ≤ 2 * B₀ ^ 2 := by
            have h1 : B₀ * 1 ≤ B₀ * B₀ := mul_le_mul_of_nonneg_left hB₀_ge1 (le_of_lt hB₀_pos)
            have h2 : B₀ * B₀ = B₀ ^ 2 := (sq B₀).symm
            have h3 : 0 ≤ B₀ ^ 2 := sq_nonneg B₀
            linarith only [h1, h2, h3]
          have h_pos_term : 0 ≤ X * δ + 2 := by positivity
          calc b_real - a_real
              ≤ B₀ * (X * δ + 2) := hba_diff
            _ ≤ (2 * B₀ ^ 2) * (X * δ + 2) :=
                mul_le_mul_of_nonneg_right hB₀_le_2sq h_pos_term
        · have hm_cplx : w₀.mult = 2 := NumberField.InfinitePlace.mult_isComplex ⟨w₀, hw⟩
          rw [hm_cplx]
          change b_real ^ 2 - a_real ^ 2 ≤ 2 * B₀ ^ 2 * (X * δ + 2) * X ^ 1
          have h_diff_sq : b_real ^ 2 - a_real ^ 2 = (b_real - a_real) * (b_real + a_real) := by ring
          rw [h_diff_sq, pow_one]
          calc (b_real - a_real) * (b_real + a_real)
              ≤ (B₀ * (X * δ + 2)) * (2 * B₀ * X) :=
                mul_le_mul hba_diff hba_sum (by positivity) (by positivity)
            _ = 2 * B₀ ^ 2 * (X * δ + 2) * X := by ring
      have h_mult_sum : w₀.mult + ∑ w ∈ S_rem, w.mult = n := by
        have h1 := Finset.add_sum_erase (Finset.univ : Finset (NumberField.InfinitePlace K))
          (fun w => w.mult) (Finset.mem_univ w₀)
        rw [NumberField.InfinitePlace.sum_mult_eq] at h1
        exact h1
      have hw0_pos : 1 ≤ w₀.mult := NumberField.InfinitePlace.mult_pos
      have hSrem_le_n : (∑ w ∈ S_rem, w.mult) ≤ n := by omega
      have h_exp_sum : (w₀.mult - 1) + (∑ w ∈ S_rem, w.mult) = n - 1 := by omega
      have hPrem_bound : P_rem ≤ B₀ ^ n * X ^ (∑ w ∈ S_rem, w.mult) := by
        have h1 : P_rem ≤ ∏ w ∈ S_rem, (B₀ * X) ^ w.mult := by
          dsimp [P_rem]
          apply Finset.prod_le_prod
          · intro w _; positivity
          · intro w _
            exact pow_le_pow_left₀ hb_nonneg hb_le_X w.mult
        rw [Finset.prod_pow_eq_pow_sum, mul_pow] at h1
        have h2 : B₀ ^ (∑ w ∈ S_rem, w.mult) ≤ B₀ ^ n :=
          pow_le_pow_right₀ hB₀_ge1 hSrem_le_n
        exact le_trans h1 (mul_le_mul_of_nonneg_right h2 (by positivity))
      have h_X_pow1 : X ^ (w₀.mult - 1) * X ^ (∑ w ∈ S_rem, w.mult) = X ^ (n - 1) := by
        rw [← pow_add, h_exp_sum]
      have h_X_pow2 : X * X ^ (n - 1) = X ^ n := by
        rw [← pow_succ', Nat.sub_add_cancel hn_pos]
      have h_B0_pow : B₀ ^ 2 * B₀ ^ n = B₀ ^ (n + 2) := by
        rw [← pow_add, add_comm]
      have h_prod_comb :
          (b_real ^ w₀.mult - a_real ^ w₀.mult) * P_rem ≤
          2 * B₀ ^ (n + 2) * (X * δ + 2) * X ^ (n - 1) := by
        calc (b_real ^ w₀.mult - a_real ^ w₀.mult) * P_rem
            ≤ (2 * B₀ ^ 2 * (X * δ + 2) * X ^ (w₀.mult - 1)) *
                (B₀ ^ n * X ^ (∑ w ∈ S_rem, w.mult)) :=
              mul_le_mul h_w0_bound hPrem_bound hPrem_nonneg (by positivity)
          _ = 2 * (B₀ ^ 2 * B₀ ^ n) * (X * δ + 2) *
                (X ^ (w₀.mult - 1) * X ^ (∑ w ∈ S_rem, w.mult)) := by ring
          _ = 2 * B₀ ^ (n + 2) * (X * δ + 2) * X ^ (n - 1) := by rw [h_B0_pow, h_X_pow1]
      have h_expand_le :
          2 * B₀ ^ (n + 2) * (X * δ + 2) * X ^ (n - 1) ≤
          4 * B₀ ^ (n + 2) * (X ^ n * δ + X ^ (n - 1)) := by
        have h_alg : 2 * B₀ ^ (n + 2) * (X * δ + 2) * X ^ (n - 1) =
            2 * B₀ ^ (n + 2) * ((X * X ^ (n - 1)) * δ + 2 * X ^ (n - 1)) := by ring
        rw [h_alg, h_X_pow2]
        have h_nonneg : 0 ≤ 2 * B₀ ^ (n + 2) * (X ^ n * δ) := by positivity
        linarith only [h_nonneg]
      have h_card_VK : (T.card : ℝ) * V_K ≤
          (4 * F_K * B₀ ^ (n + 2)) * (X ^ n * δ + X ^ (n - 1)) := by
        have h1 : F_K * (b_real ^ w₀.mult - a_real ^ w₀.mult) * P_rem =
            F_K * ((b_real ^ w₀.mult - a_real ^ w₀.mult) * P_rem) := by ring
        have h2 : (b_real ^ w₀.mult - a_real ^ w₀.mult) * P_rem ≤
            4 * B₀ ^ (n + 2) * (X ^ n * δ + X ^ (n - 1)) :=
          le_trans h_prod_comb h_expand_le
        have h3 : F_K * ((b_real ^ w₀.mult - a_real ^ w₀.mult) * P_rem) ≤
            F_K * (4 * B₀ ^ (n + 2) * (X ^ n * δ + X ^ (n - 1))) :=
          mul_le_mul_of_nonneg_left h2 (le_of_lt hFK_pos)
        linarith only [h_factored, h1, h3]
      rw [← le_div_iff₀ hVK_pos] at h_card_VK
      calc (T.card : ℝ)
          ≤ (4 * F_K * B₀ ^ (n + 2)) * (X ^ n * δ + X ^ (n - 1)) / V_K := h_card_VK
        _ = C_slab * (X ^ n * δ + X ^ (n - 1)) := by dsimp [C_slab]; ring
    calc (∑ w₀ : NumberField.InfinitePlace K, ((hS_fin w₀).toFinset.card : ℝ))
        ≤ ∑ _w₀ : NumberField.InfinitePlace K,
            (C_slab * (X ^ n * δ + X ^ (n - 1))) :=
          Finset.sum_le_sum (fun w₀ _ => hS_bound w₀)
      _ = ((Fintype.card (NumberField.InfinitePlace K) : ℝ) * C_slab) *
            (X ^ n * δ + X ^ (n - 1)) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
          ring
      _ ≤ C₀ * (X ^ n * δ + X ^ (n - 1)) := by
          have hC₀_ge : (Fintype.card (NumberField.InfinitePlace K) : ℝ) * C_slab ≤ C₀ :=
            le_max_right _ _
          exact mul_le_mul_of_nonneg_right hC₀_ge (by positivity)
  
  have h_s3_bound :
      C₀ * (X ^ n * δ + X ^ (n - 1)) * ((n : ℝ) * (L + 1)) ≤
      c_sub * X ^ n * ((L + 1) ^ 2 / (l : ℝ)) +
        c_sub * X ^ n * Real.exp (-Real.sqrt L / c_sub) := by
    have h_delta_L : δ * (L + 1) ≤ (L + 1) ^ 2 / (l : ℝ) := by
      dsimp [δ]
      rw [div_mul_eq_mul_div]
      apply div_le_div_of_nonneg_right _ (le_of_lt hl_rpos)
      have h1 : L ≤ L + 1 := by linarith only []
      have h2 : L * (L + 1) ≤ (L + 1) * (L + 1) :=
        mul_le_mul_of_nonneg_right h1 (by positivity)
      rwa [← sq] at h2
    have h_term1 : (C₀ * (n : ℝ)) * X ^ n * (δ * (L + 1)) ≤
        c_sub * X ^ n * ((L + 1) ^ 2 / (l : ℝ)) := by
      have h1 : (C₀ * (n : ℝ)) * X ^ n ≤ c_sub * X ^ n :=
        mul_le_mul_of_nonneg_right hc_sub_ge_C0 (by positivity)
      exact mul_le_mul h1 h_delta_L (by positivity) (by positivity)
    let t : ℝ := Real.sqrt L
    have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg L
    have ht_sq : t ^ 2 = L := Real.sq_sqrt hL_nonneg
    have hL_le_exp : L ≤ 4 * Real.exp t := by
      have h1 := Real.add_one_le_exp (t / 2)
      have ht_le : t ≤ 2 * Real.exp (t / 2) := by linarith only [h1]
      have hsq : t ^ 2 ≤ (2 * Real.exp (t / 2)) ^ 2 := pow_le_pow_left₀ ht_nonneg ht_le 2
      have hexp_sq : (2 * Real.exp (t / 2)) ^ 2 = 4 * Real.exp t := by
        calc (2 * Real.exp (t / 2)) ^ 2 = 4 * (Real.exp (t / 2) * Real.exp (t / 2)) := by ring
          _ = 4 * Real.exp (t / 2 + t / 2) := by rw [← Real.exp_add]
          _ = 4 * Real.exp t := by rw [add_halves]
      linarith only [ht_sq, hsq, hexp_sq]
    have h1_le_exp_t : 1 ≤ Real.exp t := Real.one_le_exp ht_nonneg
    have hL1_le_exp : L + 1 ≤ 5 * Real.exp t := by linarith only [hL_le_exp, h1_le_exp_t]
    have hexp_t_le : Real.exp t ≤ X * Real.exp 1 * Real.exp (-t) := by
      have h1 : 0 ≤ (t - 1) ^ 2 := sq_nonneg (t - 1)
      have h1_exp : (t - 1) ^ 2 = t ^ 2 - 2 * t + 1 := by ring
      have h2 : t ≤ (L + 1) + (-t) := by linarith only [h1, h1_exp, ht_sq]
      calc Real.exp t ≤ Real.exp ((L + 1) + (-t)) := Real.exp_le_exp.mpr h2
        _ = Real.exp L * Real.exp 1 * Real.exp (-t) := by rw [Real.exp_add, Real.exp_add]
        _ = X * Real.exp 1 * Real.exp (-t) := by rw [Real.exp_log hX_pos]
    have hL1_le_X : L + 1 ≤ 5 * X * Real.exp 1 * Real.exp (-t) := by
      calc L + 1 ≤ 5 * Real.exp t := hL1_le_exp
        _ ≤ 5 * (X * Real.exp 1 * Real.exp (-t)) := by linarith only [hexp_t_le]
        _ = 5 * X * Real.exp 1 * Real.exp (-t) := by ring
    have hexp_csub : Real.exp (-t) ≤ Real.exp (-t / c_sub) := by
      rw [Real.exp_le_exp, neg_div, neg_le_neg_iff]
      exact div_le_self ht_nonneg hc_sub_ge1
    have hXn : X ^ (n - 1) * X = X ^ n := by
      rw [← pow_succ, Nat.sub_add_cancel hn_pos]
    have h_term2 : (C₀ * (n : ℝ)) * X ^ (n - 1) * (L + 1) ≤
        c_sub * X ^ n * Real.exp (-t / c_sub) := by
      calc (C₀ * (n : ℝ)) * X ^ (n - 1) * (L + 1)
          ≤ (C₀ * (n : ℝ)) * X ^ (n - 1) * (5 * X * Real.exp 1 * Real.exp (-t)) :=
            mul_le_mul_of_nonneg_left hL1_le_X (by positivity)
        _ = (5 * Real.exp 1 * C₀ * (n : ℝ)) * (X ^ (n - 1) * X) * Real.exp (-t) := by ring
        _ = (5 * Real.exp 1 * C₀ * (n : ℝ)) * X ^ n * Real.exp (-t) := by rw [hXn]
        _ ≤ c_sub * X ^ n * Real.exp (-t / c_sub) := by
            apply mul_le_mul
            · exact mul_le_mul_of_nonneg_right hc_sub_ge5 (by positivity)
            · exact hexp_csub
            · positivity
            · positivity
    have h_alg : C₀ * (X ^ n * δ + X ^ (n - 1)) * ((n : ℝ) * (L + 1)) =
        (C₀ * (n : ℝ)) * X ^ n * (δ * (L + 1)) +
        (C₀ * (n : ℝ)) * X ^ (n - 1) * (L + 1) := by ring
    rw [h_alg]
    exact add_le_add h_term1 h_term2
  
  have h_mid :
      (∑ w₀ : NumberField.InfinitePlace K, ((hS_fin w₀).toFinset.card : ℝ)) *
        ((n : ℝ) * (L + 1)) ≤
      C₀ * (X ^ n * δ + X ^ (n - 1)) * ((n : ℝ) * (L + 1)) :=
    mul_le_mul_of_nonneg_right h_s2_bound (by positivity)
  exact le_trans h_s1_bound (le_trans h_mid h_s3_bound)

theorem mitsui_prime_char_decoupled_norm_dir_log_cell_sub_primePower_le {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (m : ℕ) (hm : 1 ≤ m)
    (R₁ : ℝ)
    (k : NumberField.mixedEmbedding.index K → Fin (2 * m))
    (w₀ : NumberField.InfinitePlace K)
    (l : ℕ) (hl : 1 ≤ l)
    (p : NumberField.InfinitePlace K → Fin l)
    (Y : ℝ) (hY : Y ≤ X ^ (Module.finrank ℚ K))
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ) :
    ‖(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) ≤ Y ∧
          (∀ i : NumberField.mixedEmbedding.index K,
            R₁ *
              ((NumberField.mixedEmbedding.stdBasis K).repr
                  (NumberField.mixedEmbedding K (π : K)) i / w₀ (π : K)) ∈
              Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
          (∀ w : NumberField.InfinitePlace K,
            Real.log (w (π : K) / w₀ (π : K)) ∈
              Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
                (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))) ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      - (∑' xpm : {xpm : NumberField.RingOfIntegers K ×
              IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            1 ≤ xpm.2.2 ∧
            Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
            (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Y ∧
            (∀ i : NumberField.mixedEmbedding.index K,
              R₁ *
                ((NumberField.mixedEmbedding.stdBasis K).repr
                    (NumberField.mixedEmbedding K (xpm.1 : K)) i / w₀ (xpm.1 : K)) ∈
                Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
