      Finset.prod_nonneg (fun _ _ => by positivity)
    have hPrem_bound : P_rem ≤ (1 + D) ^ n * X ^ (∑ w ∈ S_rem, w.mult) := by
      have h1 : P_rem ≤ ∏ w ∈ S_rem, ((1 + D) * X) ^ w.mult := by
        dsimp [P_rem]
        apply Finset.prod_le_prod
        · intro w _; positivity
        · intro w _
          have hXD : X + D ≤ (1 + D) * X := by nlinarith
          exact pow_le_pow_left₀ (by positivity) hXD w.mult
      rw [Finset.prod_pow_eq_pow_sum, mul_pow] at h1
      have h2 : (1 + D) ^ (∑ w ∈ S_rem, w.mult) ≤ (1 + D) ^ n :=
        pow_le_pow_right₀ (by linarith) hSrem_le_n
      exact le_trans h1 (mul_le_mul_of_nonneg_right h2 (by positivity))
    have h_prod_split : ∀ f : NumberField.InfinitePlace K → NNReal,
        (∀ w ∈ S_rem, (f w : ℝ) = X + D) →
        (∏ w : NumberField.InfinitePlace K, (f w : ℝ) ^ w.mult) =
          (f w₁ : ℝ) ^ w₁.mult * (f w₂ : ℝ) ^ w₂.mult * P_rem := by
      intro f hf
      have h1 := (Finset.mul_prod_erase (Finset.univ : Finset (NumberField.InfinitePlace K))
        (fun w => (f w : ℝ) ^ w.mult) (Finset.mem_univ w₁)).symm
      have h2 := (Finset.mul_prod_erase ((Finset.univ : Finset (NumberField.InfinitePlace K)).erase w₁)
        (fun w => (f w : ℝ) ^ w.mult) hw2_mem).symm
      have h3 : (∏ w ∈ S_rem, (f w : ℝ) ^ w.mult) = P_rem :=
        Finset.prod_congr rfl (fun w hw => by rw [hf w hw])
      rw [h1, h2, h3, mul_assoc]
    have h_slab_k : ∀ k ∈ Finset.range (⌊X⌋₊ + 1),
        ((hS_fin w₁ w₂ k).toFinset.card : ℝ) ≤ C_slab * X ^ (n - 2) := by
      intro k hk
      have hk_le_floor : k ≤ ⌊X⌋₊ := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
      have hk_le_X : (k : ℝ) ≤ X :=
        le_trans (Nat.cast_le.mpr hk_le_floor) (Nat.floor_le (le_of_lt hX_pos))
      let a_real : ℝ := max 0 ((k : ℝ) - D)
      let b_real : ℝ := (k : ℝ) + 1 + D
      have ha_nonneg : 0 ≤ a_real := le_max_left _ _
      have hb_nonneg : 0 ≤ b_real := by dsimp [b_real]; positivity
      have hab : a_real ≤ b_real := max_le hb_nonneg (by dsimp [b_real]; linarith)
      have hba_diff : b_real - a_real ≤ 1 + 2 * D := by
        have : (k : ℝ) - D ≤ a_real := le_max_right _ _
        dsimp [b_real]; linarith
      have hb_le_X : b_real ≤ 2 * (1 + D) * X := by dsimp [b_real]; nlinarith
      let a : NNReal := ⟨a_real, ha_nonneg⟩
      let b : NNReal := ⟨b_real, hb_nonneg⟩
      let c_X : NNReal := ⟨X + D, by positivity⟩
      let f₀₀ : NumberField.InfinitePlace K → NNReal :=
        fun w => if w = w₁ then b else if w = w₂ then b else c_X
      let f₁₀ : NumberField.InfinitePlace K → NNReal :=
        fun w => if w = w₁ then a else if w = w₂ then b else c_X
      let f₀₁ : NumberField.InfinitePlace K → NNReal :=
        fun w => if w = w₁ then b else if w = w₂ then a else c_X
      let f₁₁ : NumberField.InfinitePlace K → NNReal :=
        fun w => if w = w₁ then a else if w = w₂ then a else c_X
      let B₀₀ := NumberField.mixedEmbedding.convexBodyLT K f₀₀
      let B₁₀ := NumberField.mixedEmbedding.convexBodyLT K f₁₀
      let B₀₁ := NumberField.mixedEmbedding.convexBodyLT K f₀₁
      let B₁₁ := NumberField.mixedEmbedding.convexBodyLT K f₁₁
      let T := (hS_fin w₁ w₂ k).toFinset
      let T_lat : Finset (NumberField.mixedEmbedding.integerLattice K) := T.map ⟨j, hj_inj⟩
      let U : Set (NumberField.mixedEmbedding.mixedSpace K) := ⋃ g ∈ T_lat, g +ᵥ F
      have haedisj : (T_lat : Set (NumberField.mixedEmbedding.integerLattice K)).Pairwise
          (Function.onFun (MeasureTheory.AEDisjoint MeasureTheory.volume) (fun g => g +ᵥ F)) := by
        intro g₁ _ g₂ _ hne
        exact hF_fund.aedisjoint hne
      have hnull : ∀ g ∈ T_lat, MeasureTheory.NullMeasurableSet (g +ᵥ F) MeasureTheory.volume := by
        intro g _
        change MeasureTheory.NullMeasurableSet
          ((g : NumberField.mixedEmbedding.mixedSpace K) +ᵥ F) MeasureTheory.volume
        exact (hF_meas.const_vadd (g : NumberField.mixedEmbedding.mixedSpace K)).nullMeasurableSet
      have hvol_union : MeasureTheory.volume U = (T.card : ENNReal) * MeasureTheory.volume F := by
        dsimp [U]
        rw [MeasureTheory.measure_biUnion_finset₀ haedisj hnull]
        have h_each : ∀ g ∈ T_lat, MeasureTheory.volume (g +ᵥ F) = MeasureTheory.volume F := by
          intro g _
          change MeasureTheory.volume ((g : NumberField.mixedEmbedding.mixedSpace K) +ᵥ F) =
            MeasureTheory.volume F
          exact MeasureTheory.measure_vadd MeasureTheory.volume
            (g : NumberField.mixedEmbedding.mixedSpace K) F
        rw [Finset.sum_congr rfl h_each, Finset.sum_const, nsmul_eq_mul, Finset.card_map]
      have h_disj : Disjoint U (B₁₀ ∪ B₀₁) := by
        rw [Set.disjoint_left]
        intro z hzU hzB
        simp only [U, Set.mem_iUnion] at hzU
        rcases hzU with ⟨g, hg, hzF⟩
        rcases Finset.mem_map.mp hg with ⟨x, hxT, rfl⟩
        rw [Set.Finite.mem_toFinset] at hxT
        rcases hzF with ⟨u, huF, rfl⟩
        have h_low : ∀ w : NumberField.InfinitePlace K, (k : ℝ) ≤ w (x : K) →
            a_real ≤ NumberField.mixedEmbedding.normAtPlace w
              (NumberField.mixedEmbedding K (x : K) + u) := by
          intro w hkw
          have htri := NumberField.mixedEmbedding.normAtPlace_add_le w
            (NumberField.mixedEmbedding K (x : K) + u) (-u)
          have h_cancel : (NumberField.mixedEmbedding K (x : K) + u) + (-u) =
              NumberField.mixedEmbedding K (x : K) := add_neg_cancel_right _ _
          rw [h_cancel, NumberField.mixedEmbedding.normAtPlace_apply,
              NumberField.mixedEmbedding.normAtPlace_neg] at htri
          have huD := hF_norm u huF w
          have h_nonneg := h_norm_nonneg w (NumberField.mixedEmbedding K (x : K) + u)
          exact max_le h_nonneg (by linarith)
        rcases hzB with hz10 | hz01
        · have h1 := (h_mem f₁₀ _).mp hz10 w₁
          change NumberField.mixedEmbedding.normAtPlace w₁
            (NumberField.mixedEmbedding K (x : K) + u) < (f₁₀ w₁ : ℝ) at h1
          have hfw1 : (f₁₀ w₁ : ℝ) = a_real := by simp [f₁₀, a]
          linarith [h_low w₁ hxT.1]
        · have h2 := (h_mem f₀₁ _).mp hz01 w₂
          change NumberField.mixedEmbedding.normAtPlace w₂
            (NumberField.mixedEmbedding K (x : K) + u) < (f₀₁ w₂ : ℝ) at h2
          have hfw2 : (f₀₁ w₂ : ℝ) = a_real := by simp [f₀₁, hw12.symm, a]
          linarith [h_low w₂ hxT.2.2.1]
      have h_sub : U ∪ (B₁₀ ∪ B₀₁) ⊆ B₀₀ := by
        rintro z (hzU | hz10 | hz01)
        · simp only [U, Set.mem_iUnion] at hzU
          rcases hzU with ⟨g, hg, hzF⟩
          rcases Finset.mem_map.mp hg with ⟨x, hxT, rfl⟩
          rw [Set.Finite.mem_toFinset] at hxT
          rcases hzF with ⟨u, huF, rfl⟩
          rw [h_mem]
          intro w
          change NumberField.mixedEmbedding.normAtPlace w
            (NumberField.mixedEmbedding K (x : K) + u) < (f₀₀ w : ℝ)
          have htri := NumberField.mixedEmbedding.normAtPlace_add_le w
            (NumberField.mixedEmbedding K (x : K)) u
          rw [NumberField.mixedEmbedding.normAtPlace_apply] at htri
          have huD := hF_norm u huF w
          by_cases hw1 : w = w₁
          · rw [hw1] at htri huD ⊢
            have hfw : (f₀₀ w₁ : ℝ) = b_real := by simp [f₀₀, b]
            dsimp [b_real] at hfw
            linarith [hxT.2.1]
          · by_cases hw2 : w = w₂
            · rw [hw2] at htri huD ⊢
              have hfw : (f₀₀ w₂ : ℝ) = b_real := by simp [f₀₀, hw12.symm, b]
              dsimp [b_real] at hfw
              linarith [hxT.2.2.2.1]
            · have hfw : (f₀₀ w : ℝ) = X + D := by simp [f₀₀, hw1, hw2, c_X]
              linarith [hxT.2.2.2.2 w]
        · rw [h_mem] at hz10 ⊢
          intro w
          refine lt_of_lt_of_le (hz10 w) ?_
          by_cases hw1 : w = w₁
          · simp [f₁₀, f₀₀, hw1, a, b, hab]
          · simp [f₁₀, f₀₀, hw1]
        · rw [h_mem] at hz01 ⊢
          intro w
          refine lt_of_lt_of_le (hz01 w) ?_
          by_cases hw1 : w = w₁
          · simp [f₀₁, f₀₀, hw1]
          · by_cases hw2 : w = w₂
            · simp [f₀₁, f₀₀, hw2, hw12.symm, a, b, hab]
            · simp [f₀₁, f₀₀, hw1, hw2]
      have h_inter : B₁₀ ∩ B₀₁ = B₁₁ := by
        ext z
        simp only [Set.mem_inter_iff, B₁₀, B₀₁, B₁₁, h_mem]
        constructor
        · rintro ⟨h1, h2⟩ w
          by_cases hw1 : w = w₁
          · have := h1 w
            simpa [f₁₀, f₁₁, hw1] using this
          · by_cases hw2 : w = w₂
            · have := h2 w
              simpa [f₀₁, f₁₁, hw1, hw2, hw12.symm] using this
            · have := h1 w
              simpa [f₁₀, f₁₁, hw1, hw2] using this
        · intro h
          refine ⟨fun w => ?_, fun w => ?_⟩
          · refine lt_of_lt_of_le (h w) ?_
            by_cases hw1 : w = w₁
            · simp [f₁₁, f₁₀, hw1]
            · by_cases hw2 : w = w₂
              · simp [f₁₁, f₁₀, hw2, hw12.symm, a, b, hab]
              · simp [f₁₁, f₁₀, hw1, hw2]
          · refine lt_of_lt_of_le (h w) ?_
            by_cases hw1 : w = w₁
            · simp [f₁₁, f₀₁, hw1, a, b, hab]
            · simp [f₁₁, f₀₁, hw1]
      have h_meas_ie1 : MeasureTheory.volume U + MeasureTheory.volume (B₁₀ ∪ B₀₁) ≤
          MeasureTheory.volume B₀₀ := by
        rw [← MeasureTheory.measure_union h_disj ((h_meas f₁₀).union (h_meas f₀₁))]
        exact MeasureTheory.measure_mono h_sub
      have h_meas_ie2 : MeasureTheory.volume (B₁₀ ∪ B₀₁) + MeasureTheory.volume B₁₁ =
          MeasureTheory.volume B₁₀ + MeasureTheory.volume B₀₁ := by
        rw [← h_inter]
        exact MeasureTheory.measure_union_add_inter B₁₀ (h_meas f₀₁)
      have h_meas_ie : MeasureTheory.volume U + MeasureTheory.volume B₁₀ + MeasureTheory.volume B₀₁ ≤
          MeasureTheory.volume B₀₀ + MeasureTheory.volume B₁₁ := by
        calc MeasureTheory.volume U + MeasureTheory.volume B₁₀ + MeasureTheory.volume B₀₁
            = MeasureTheory.volume U + (MeasureTheory.volume B₁₀ + MeasureTheory.volume B₀₁) := by
              rw [add_assoc]
          _ = MeasureTheory.volume U + (MeasureTheory.volume (B₁₀ ∪ B₀₁) + MeasureTheory.volume B₁₁) := by
              rw [← h_meas_ie2]
          _ = (MeasureTheory.volume U + MeasureTheory.volume (B₁₀ ∪ B₀₁)) + MeasureTheory.volume B₁₁ := by
              rw [add_assoc]
          _ ≤ MeasureTheory.volume B₀₀ + MeasureTheory.volume B₁₁ :=
              add_le_add_left h_meas_ie1 _
      have hU_ne_top : MeasureTheory.volume U ≠ ⊤ := by
        rw [hvol_union]
        exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top T.card) hF_ne_top
      have h_rhs_ne_top : MeasureTheory.volume B₀₀ + MeasureTheory.volume B₁₁ ≠ ⊤ :=
        ENNReal.add_ne_top.mpr ⟨h_vol_ne_top f₀₀, h_vol_ne_top f₁₁⟩
      have h_real_ie := ENNReal.toReal_mono h_rhs_ne_top h_meas_ie
      rw [ENNReal.toReal_add (ENNReal.add_ne_top.mpr ⟨hU_ne_top, h_vol_ne_top f₁₀⟩) (h_vol_ne_top f₀₁),
          ENNReal.toReal_add hU_ne_top (h_vol_ne_top f₁₀),
          ENNReal.toReal_add (h_vol_ne_top f₀₀) (h_vol_ne_top f₁₁),
          hvol_union, ENNReal.toReal_mul, ENNReal.toReal_natCast,
          h_toReal_vol f₁₀, h_toReal_vol f₀₁, h_toReal_vol f₀₀, h_toReal_vol f₁₁] at h_real_ie
      have hp00 : (∏ w : NumberField.InfinitePlace K, (f₀₀ w : ℝ) ^ w.mult) =
          b_real ^ w₁.mult * b_real ^ w₂.mult * P_rem := by
        rw [h_prod_split f₀₀ (fun w hw => by
          obtain ⟨hw1, hw2⟩ := h_Srem_ne w hw; simp [f₀₀, hw1, hw2, c_X])]
        simp [f₀₀, hw12.symm, b]
      have hp10 : (∏ w : NumberField.InfinitePlace K, (f₁₀ w : ℝ) ^ w.mult) =
          a_real ^ w₁.mult * b_real ^ w₂.mult * P_rem := by
        rw [h_prod_split f₁₀ (fun w hw => by
          obtain ⟨hw1, hw2⟩ := h_Srem_ne w hw; simp [f₁₀, hw1, hw2, c_X])]
        simp [f₁₀, hw12.symm, a, b]
      have hp01 : (∏ w : NumberField.InfinitePlace K, (f₀₁ w : ℝ) ^ w.mult) =
          b_real ^ w₁.mult * a_real ^ w₂.mult * P_rem := by
        rw [h_prod_split f₀₁ (fun w hw => by
          obtain ⟨hw1, hw2⟩ := h_Srem_ne w hw; simp [f₀₁, hw1, hw2, c_X])]
        simp [f₀₁, hw12.symm, a, b]
      have hp11 : (∏ w : NumberField.InfinitePlace K, (f₁₁ w : ℝ) ^ w.mult) =
          a_real ^ w₁.mult * a_real ^ w₂.mult * P_rem := by
        rw [h_prod_split f₁₁ (fun w hw => by
          obtain ⟨hw1, hw2⟩ := h_Srem_ne w hw; simp [f₁₁, hw1, hw2, c_X])]
        simp [f₁₁, hw12.symm, a]
      have h_factored : (T.card : ℝ) * V_K ≤
          F_K * (b_real ^ w₁.mult - a_real ^ w₁.mult) *
            (b_real ^ w₂.mult - a_real ^ w₂.mult) * P_rem := by
        rw [hp10, hp01, hp00, hp11] at h_real_ie
        change (T.card : ℝ) * V_K + F_K * (a_real ^ w₁.mult * b_real ^ w₂.mult * P_rem) +
            F_K * (b_real ^ w₁.mult * a_real ^ w₂.mult * P_rem) ≤
          F_K * (b_real ^ w₁.mult * b_real ^ w₂.mult * P_rem) +
            F_K * (a_real ^ w₁.mult * a_real ^ w₂.mult * P_rem) at h_real_ie
        linarith
      have h_factor_bound : ∀ w : NumberField.InfinitePlace K,
          0 ≤ b_real ^ w.mult - a_real ^ w.mult ∧
          b_real ^ w.mult - a_real ^ w.mult ≤ 8 * (1 + D) ^ 2 * X ^ (w.mult - 1) := by
        intro w
        refine ⟨sub_nonneg.mpr (pow_le_pow_left₀ ha_nonneg hab w.mult), ?_⟩
        rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
        · have hm : w.mult = 1 := NumberField.InfinitePlace.mult_isReal ⟨w, hw⟩
          rw [hm]
          simp only [Nat.sub_self, pow_one, pow_zero, mul_one]
          nlinarith [hba_diff, hD_pos]
        · have hm : w.mult = 2 := NumberField.InfinitePlace.mult_isComplex ⟨w, hw⟩
          rw [hm]
          change b_real ^ 2 - a_real ^ 2 ≤ 8 * (1 + D) ^ 2 * X ^ 1
          have h_diff_sq : b_real ^ 2 - a_real ^ 2 = (b_real - a_real) * (b_real + a_real) := by ring
          rw [h_diff_sq, pow_one]
          have h_sum_le : b_real + a_real ≤ 4 * (1 + D) * X := by linarith [hab, hb_le_X]
          have h_diff_le2 : b_real - a_real ≤ 2 * (1 + D) := by linarith [hba_diff]
          calc (b_real - a_real) * (b_real + a_real)
              ≤ (2 * (1 + D)) * (4 * (1 + D) * X) :=
                mul_le_mul h_diff_le2 h_sum_le (by positivity) (by positivity)
            _ = 8 * (1 + D) ^ 2 * X := by ring
      have h_rhs_prod_le :
          F_K * (b_real ^ w₁.mult - a_real ^ w₁.mult) *
            (b_real ^ w₂.mult - a_real ^ w₂.mult) * P_rem ≤
          (64 * F_K * (1 + D) ^ (n + 4)) * X ^ (n - 2) := by
        have hf1 := h_factor_bound w₁
        have hf2 := h_factor_bound w₂
        have h12 : (b_real ^ w₁.mult - a_real ^ w₁.mult) * (b_real ^ w₂.mult - a_real ^ w₂.mult) ≤
            (8 * (1 + D) ^ 2 * X ^ (w₁.mult - 1)) * (8 * (1 + D) ^ 2 * X ^ (w₂.mult - 1)) :=
          mul_le_mul hf1.2 hf2.2 hf2.1 (by positivity)
        have h12P : (b_real ^ w₁.mult - a_real ^ w₁.mult) *
              (b_real ^ w₂.mult - a_real ^ w₂.mult) * P_rem ≤
            (8 * (1 + D) ^ 2 * X ^ (w₁.mult - 1)) *
              (8 * (1 + D) ^ 2 * X ^ (w₂.mult - 1)) *
              ((1 + D) ^ n * X ^ (∑ w ∈ S_rem, w.mult)) :=
          mul_le_mul h12 hPrem_bound hPrem_nonneg (by positivity)
        have h_alg : F_K * ((8 * (1 + D) ^ 2 * X ^ (w₁.mult - 1)) *
              (8 * (1 + D) ^ 2 * X ^ (w₂.mult - 1)) *
              ((1 + D) ^ n * X ^ (∑ w ∈ S_rem, w.mult))) =
            (64 * F_K * ((1 + D) ^ n * (1 + D) ^ 4)) *
              (X ^ (w₁.mult - 1) * X ^ (w₂.mult - 1) * X ^ (∑ w ∈ S_rem, w.mult)) := by ring
        have h_D_pow : (1 + D) ^ n * (1 + D) ^ 4 = (1 + D) ^ (n + 4) := (pow_add (1 + D) n 4).symm
        have h_X_pow : X ^ (w₁.mult - 1) * X ^ (w₂.mult - 1) * X ^ (∑ w ∈ S_rem, w.mult) =
            X ^ (n - 2) := by
          rw [← pow_add, ← pow_add, h_exp_sum]
        calc F_K * (b_real ^ w₁.mult - a_real ^ w₁.mult) *
              (b_real ^ w₂.mult - a_real ^ w₂.mult) * P_rem
            = F_K * ((b_real ^ w₁.mult - a_real ^ w₁.mult) *
                (b_real ^ w₂.mult - a_real ^ w₂.mult) * P_rem) := by ring
          _ ≤ F_K * ((8 * (1 + D) ^ 2 * X ^ (w₁.mult - 1)) *
                (8 * (1 + D) ^ 2 * X ^ (w₂.mult - 1)) *
                ((1 + D) ^ n * X ^ (∑ w ∈ S_rem, w.mult))) :=
              mul_le_mul_of_nonneg_left h12P (le_of_lt hFK_pos)
          _ = (64 * F_K * ((1 + D) ^ n * (1 + D) ^ 4)) *
                (X ^ (w₁.mult - 1) * X ^ (w₂.mult - 1) * X ^ (∑ w ∈ S_rem, w.mult)) := h_alg
          _ = (64 * F_K * (1 + D) ^ (n + 4)) * X ^ (n - 2) := by rw [h_D_pow, h_X_pow]
      have h_card_VK : (T.card : ℝ) * V_K ≤ (64 * F_K * (1 + D) ^ (n + 4)) * X ^ (n - 2) :=
        le_trans h_factored h_rhs_prod_le
      rw [← le_div_iff₀ hVK_pos] at h_card_VK
      calc (T.card : ℝ)
          ≤ (64 * F_K * (1 + D) ^ (n + 4)) * X ^ (n - 2) / V_K := h_card_VK
        _ = C_slab * X ^ (n - 2) := by dsimp [C_slab]; ring
    have h_range_le : ((⌊X⌋₊ + 1 : ℕ) : ℝ) ≤ 2 * X := by
      have hfl : (⌊X⌋₊ : ℝ) ≤ X := Nat.floor_le (le_of_lt hX_pos)
      push_cast
      linarith
    have h_X_pow_step : X ^ (n - 2) * X = X ^ (n - 1) := by
      rw [← pow_succ]
      congr 1
      omega
    calc (∑ k ∈ Finset.range (⌊X⌋₊ + 1), ((hS_fin w₁ w₂ k).toFinset.card : ℝ))
        ≤ ∑ _k ∈ Finset.range (⌊X⌋₊ + 1), (C_slab * X ^ (n - 2)) :=
          Finset.sum_le_sum h_slab_k
      _ = ((⌊X⌋₊ + 1 : ℕ) : ℝ) * (C_slab * X ^ (n - 2)) := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      _ ≤ (2 * X) * (C_slab * X ^ (n - 2)) :=
          mul_le_mul_of_nonneg_right h_range_le (by positivity)
      _ = (2 * C_slab) * (X ^ (n - 2) * X) := by ring
      _ = (2 * C_slab) * X ^ (n - 1) := by rw [h_X_pow_step]
  have h_s2_bound :
      (∑ p ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)).offDiag,
        ∑ k ∈ Finset.range (⌊X⌋₊ + 1), ((hS_fin p.1 p.2 k).toFinset.card : ℝ)) ≤
      C₀ * X ^ (n - 1) := by
    calc (∑ p ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)).offDiag,
            ∑ k ∈ Finset.range (⌊X⌋₊ + 1), ((hS_fin p.1 p.2 k).toFinset.card : ℝ))
        ≤ ∑ _p ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)).offDiag,
            ((2 * C_slab) * X ^ (n - 1)) :=
          Finset.sum_le_sum h_offDiag_bound
      _ = (((Finset.univ : Finset (NumberField.InfinitePlace K)).offDiag.card : ℝ) *
            (2 * C_slab)) * X ^ (n - 1) := by
          rw [Finset.sum_const, nsmul_eq_mul]
          ring
      _ ≤ C₀ * X ^ (n - 1) := by
          have hC₀_ge : ((Finset.univ : Finset (NumberField.InfinitePlace K)).offDiag.card : ℝ) *
              (2 * C_slab) ≤ C₀ := le_max_right _ _
          exact mul_le_mul_of_nonneg_right hC₀_ge (by positivity)
  
  let L : ℝ := Real.log X
  let t : ℝ := Real.sqrt L
  have hL_pos : 0 < L := Real.log_pos hX
  have hL_nonneg : 0 ≤ L := le_of_lt hL_pos
  have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg L
  have ht_sq : t ^ 2 = L := Real.sq_sqrt hL_nonneg
  have hL_le_exp : L ≤ 4 * Real.exp t := by
    have h1 := Real.add_one_le_exp (t / 2)
    have ht_le : t ≤ 2 * Real.exp (t / 2) := by linarith
    have hsq : t ^ 2 ≤ (2 * Real.exp (t / 2)) ^ 2 := pow_le_pow_left₀ ht_nonneg ht_le 2
    have hexp_sq : (2 * Real.exp (t / 2)) ^ 2 = 4 * Real.exp t := by
      calc (2 * Real.exp (t / 2)) ^ 2 = 4 * (Real.exp (t / 2) * Real.exp (t / 2)) := by ring
        _ = 4 * Real.exp (t / 2 + t / 2) := by rw [← Real.exp_add]
        _ = 4 * Real.exp t := by rw [add_halves]
    linarith
  have hexp_t_le : Real.exp t ≤ X * Real.exp 1 * Real.exp (-t) := by
    have h1 : 0 ≤ (t - 1) ^ 2 := sq_nonneg (t - 1)
    have h2 : t ≤ (L + 1) + (-t) := by nlinarith [h1, ht_sq]
    calc Real.exp t ≤ Real.exp ((L + 1) + (-t)) := Real.exp_le_exp.mpr h2
      _ = Real.exp L * Real.exp 1 * Real.exp (-t) := by rw [Real.exp_add, Real.exp_add]
      _ = X * Real.exp 1 * Real.exp (-t) := by rw [Real.exp_log hX_pos]
  have hL_le_X : L ≤ 4 * X * Real.exp 1 * Real.exp (-t) := by
    calc L ≤ 4 * Real.exp t := hL_le_exp
      _ ≤ 4 * (X * Real.exp 1 * Real.exp (-t)) := by linarith [hexp_t_le]
      _ = 4 * X * Real.exp 1 * Real.exp (-t) := by ring
  have hexp_c2 : Real.exp (-t) ≤ Real.exp (-t / c₂) := by
    rw [Real.exp_le_exp, neg_div, neg_le_neg_iff]
    exact div_le_self ht_nonneg hc₂_ge1
  have hXn : X ^ (n - 1) * X = X ^ n := by
    rw [← pow_succ, Nat.sub_add_cancel hn_pos]
  have hc₂_ge_M : 4 * Real.exp 1 * C₀ * M_card * (n : ℝ) ≤ c₂ := by
    have h1 : 4 * Real.exp 1 * C₀ * M_card * (n : ℝ) ≤
        4 * Real.exp 1 * C₀ * (M_card + 1) * (n : ℝ) := by
      have : 0 ≤ 4 * Real.exp 1 * C₀ * (n : ℝ) := by positivity
      nlinarith
    exact le_trans h1 hc₂_ge_const
  have h_s3_bound : C₀ * X ^ (n - 1) * (M_card * ((n : ℝ) * L)) ≤
      c₂ * X ^ n * Real.exp (-t / c₂) := by
    calc C₀ * X ^ (n - 1) * (M_card * ((n : ℝ) * L))
        ≤ C₀ * X ^ (n - 1) * (M_card * ((n : ℝ) * (4 * X * Real.exp 1 * Real.exp (-t)))) := by
          apply mul_le_mul_of_nonneg_left
          · apply mul_le_mul_of_nonneg_left
            · exact mul_le_mul_of_nonneg_left hL_le_X (Nat.cast_nonneg n)
            · exact hM_card_nonneg
          · positivity
      _ = (4 * Real.exp 1 * C₀ * M_card * (n : ℝ)) * (X ^ (n - 1) * X) * Real.exp (-t) := by ring
      _ = (4 * Real.exp 1 * C₀ * M_card * (n : ℝ)) * X ^ n * Real.exp (-t) := by rw [hXn]
      _ ≤ c₂ * X ^ n * Real.exp (-t / c₂) := by
          apply mul_le_mul
          · exact mul_le_mul_of_nonneg_right hc₂_ge_M (by positivity)
          · exact hexp_c2
          · positivity
          · positivity
  
  have h_mid :
      (∑ p ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)).offDiag,
        ∑ k ∈ Finset.range (⌊X⌋₊ + 1), ((hS_fin p.1 p.2 k).toFinset.card : ℝ)) *
      (M_card * ((n : ℝ) * L)) ≤ C₀ * X ^ (n - 1) * (M_card * ((n : ℝ) * L)) :=
    mul_le_mul_of_nonneg_right h_s2_bound (by positivity)
  exact le_trans h_s1_bound (le_trans h_mid h_s3_bound)

theorem mitsui_torsion_char_tsum_eq_zero {K : Type u} [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K))
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ)
    (hψ_tors : ∃ u ∈ NumberField.Units.torsion K,
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) ≠ 1) :
    (∑' u : NumberField.Units.torsion K,
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom
        (u : (NumberField.RingOfIntegers K)ˣ)))) = 0 ∧
    ∀ u ∈ NumberField.Units.torsion K, ∀ w : NumberField.InfinitePlace K,
      w ((u : NumberField.RingOfIntegers K) : K) = 1 :=
by
  have h_norm_one : ∀ u ∈ NumberField.Units.torsion K, ∀ w : NumberField.InfinitePlace K,
      w ((u : NumberField.RingOfIntegers K) : K) = 1 :=
    fun u hu w => (NumberField.Units.mem_torsion K).mp hu w
  obtain ⟨u₀, hu₀, hψ_u₀⟩ := hψ_tors
  let u0_tors : NumberField.Units.torsion K := ⟨u₀, hu₀⟩
  let Φ : NumberField.Units.torsion K → ℂ :=
    fun v => ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom
      (v : (NumberField.RingOfIntegers K)ˣ)))
  have hΦ_mul : ∀ v : NumberField.Units.torsion K, Φ (u0_tors * v) = Φ u0_tors * Φ v := by
    intro v
    dsimp [Φ]
    rw [map_mul, ofMul_mul, AddChar.map_add_eq_mul]
  set S : ℂ := ∑' v : NumberField.Units.torsion K, Φ v
  have hS_eq : Φ u0_tors * S = S := by
    dsimp [S]
    rw [← tsum_mul_left]
    simp_rw [← hΦ_mul]
    exact Equiv.tsum_eq (Equiv.mulLeft u0_tors) Φ
  have h_sub : (Φ u0_tors - 1) * S = 0 := by
    rw [sub_mul, one_mul, sub_eq_zero]
    exact hS_eq
  have hS_zero : S = 0 := by
    rcases mul_eq_zero.mp h_sub with h_zero | hS_zero
    · exfalso
      exact hψ_u₀ (sub_eq_zero.mp h_zero)
    · exact hS_zero
  exact ⟨hS_zero, h_norm_one⟩

theorem mitsui_prime_char_grid_cube_place_sector_radial_shell_diff_le {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (m : ℕ) (hm : 1 ≤ m)
    (L : ℕ) (hL : 1 ≤ L)
    (k : NumberField.mixedEmbedding.index K → Fin (2 * m))
    (hQ_bdd : ∀ z : NumberField.mixedEmbedding.mixedSpace K,
        (∀ i : NumberField.mixedEmbedding.index K,
          (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
            Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) →
        ∀ w : NumberField.InfinitePlace K,
          NumberField.mixedEmbedding.normAtPlace w z < X)
    (w₀ : NumberField.InfinitePlace K)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ) :
    ‖(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          (∀ i : NumberField.mixedEmbedding.index K,
            (NumberField.mixedEmbedding.stdBasis K).repr
                (NumberField.mixedEmbedding K (π : K)) i ∈
              Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
          (∀ w : NumberField.InfinitePlace K,
            1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      - (∑ j : Fin L,
          ∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧
                (∀ i : NumberField.mixedEmbedding.index K,
                  (X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1) *
                    ((NumberField.mixedEmbedding.stdBasis K).repr
                        (NumberField.mixedEmbedding K (π : K)) i / w₀ (π : K)) ∈
                    Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                      ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
                (∀ w : NumberField.InfinitePlace K,
                  1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
                w₀ (π : K) ∈
                  Set.Ico ((X / (L : ℝ)) * ((j : ℕ) : ℝ))
                    ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ∧
                IsUnit (Ideal.Quotient.mk q π)},
              ψ (Additive.ofMul π.2.2.2.2.2.unit) *
                (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
    ≤ |(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          ∀ i : NumberField.mixedEmbedding.index K,
            (NumberField.mixedEmbedding.stdBasis K).repr
                (NumberField.mixedEmbedding K (π : K)) i ∈
              Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)) - X / (L : ℝ))
                ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1) + X / (L : ℝ))},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      - (∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧
            ∀ i : NumberField.mixedEmbedding.index K,
              (NumberField.mixedEmbedding.stdBasis K).repr
                  (NumberField.mixedEmbedding K (π : K)) i ∈
                Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)) + X / (L : ℝ))
                  ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1) - X / (L : ℝ))},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))| :=
by
  classical
  have hq_bot : q ≠ ⊥ := hq
  haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
    Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
  let L_log : NumberField.RingOfIntegers K → ℝ :=
    fun π => Real.log ((Algebra.norm ℤ π).natAbs : ℝ)
  have hL_nonneg : ∀ π : NumberField.RingOfIntegers K, 0 ≤ L_log π :=
    fun _ => Real.log_natCast_nonneg _
  have hX_pos : (0 : ℝ) < X := by linarith
  have hm_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  have hm_pos : (0 : ℝ) < (m : ℝ) := lt_of_lt_of_le zero_lt_one hm_ge_one
  have hm_ne : (m : ℝ) ≠ 0 := ne_of_gt hm_pos
  have hL_ge_one : (1 : ℝ) ≤ (L : ℝ) := by exact_mod_cast hL
  have hL_pos : (0 : ℝ) < (L : ℝ) := lt_of_lt_of_le zero_lt_one hL_ge_one
  have hL_ne : (L : ℝ) ≠ 0 := ne_of_gt hL_pos
  let δ : ℝ := X / (m : ℝ)
  have hδ_pos : 0 < δ := div_pos hX_pos hm_pos
  let ε_L : ℝ := X / (L : ℝ)
  have hε_pos : 0 < ε_L := div_pos hX_pos hL_pos
  have hε_ne : ε_L ≠ 0 := ne_of_gt hε_pos
  have hε_le_X : ε_L ≤ X := div_le_self (le_of_lt hX_pos) hL_ge_one
  let b := NumberField.mixedEmbedding.stdBasis K
  let z_coord : NumberField.RingOfIntegers K → NumberField.mixedEmbedding.index K → ℝ :=
    fun π i => b.repr (NumberField.mixedEmbedding K (π : K)) i
  let a_lo : NumberField.mixedEmbedding.index K → ℝ :=
    fun i => (X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ))
  let b_hi : NumberField.mixedEmbedding.index K → ℝ :=
    fun i => (X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1)
  let P_cube : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ i : NumberField.mixedEmbedding.index K,
      z_coord π i ∈ Set.Ico (a_lo i) (b_hi i)
  let P_sector : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ w : NumberField.InfinitePlace K,
      1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)
  let P_sec : NumberField.RingOfIntegers K → Prop :=
    fun π => P_cube π ∧ P_sector π
  let P_shell : Fin L → NumberField.RingOfIntegers K → Prop :=
    fun j π =>
      (∀ i : NumberField.mixedEmbedding.index K,
        ε_L * (((j : ℕ) : ℝ) + 1) * (z_coord π i / w₀ (π : K)) ∈ Set.Ico (a_lo i) (b_hi i)) ∧
      P_sector π ∧
      w₀ (π : K) ∈ Set.Ico (ε_L * ((j : ℕ) : ℝ)) (ε_L * (((j : ℕ) : ℝ) + 1))
  let P_out : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ i : NumberField.mixedEmbedding.index K,
      z_coord π i ∈ Set.Ico (a_lo i - ε_L) (b_hi i + ε_L)
  let P_in : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ i : NumberField.mixedEmbedding.index K,
      z_coord π i ∈ Set.Ico (a_lo i + ε_L) (b_hi i - ε_L)
  have h_coord_le_w0 : ∀ π : NumberField.RingOfIntegers K,
      P_sector π → ∀ i : NumberField.mixedEmbedding.index K,
        -w₀ (π : K) ≤ z_coord π i ∧ z_coord π i ≤ w₀ (π : K) := by
    intro π h_sec i
    apply abs_le.mp
    dsimp [z_coord, b]
    rcases i with w | ⟨w, r⟩
    · rw [NumberField.mixedEmbedding.stdBasis_apply_isReal _ w, ← Real.norm_eq_abs,
          ← NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2,
          NumberField.mixedEmbedding.normAtPlace_apply]
      exact (h_sec w.1).2
    · fin_cases r
      · change |((NumberField.mixedEmbedding.stdBasis K).repr
            (NumberField.mixedEmbedding K (π : K))) (Sum.inr (w, 0))| ≤ w₀ (π : K)
        rw [NumberField.mixedEmbedding.stdBasis_apply_isComplex_fst _ w]
        have h1 : |((NumberField.mixedEmbedding K (π : K)).2 w).re| ≤
            ‖(NumberField.mixedEmbedding K (π : K)).2 w‖ :=
          Complex.abs_re_le_norm _
        have h2 : ‖(NumberField.mixedEmbedding K (π : K)).2 w‖ = w.1 (π : K) := by
          rw [← NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex w.2,
              NumberField.mixedEmbedding.normAtPlace_apply]
        linarith [(h_sec w.1).2]
      · change |((NumberField.mixedEmbedding.stdBasis K).repr
            (NumberField.mixedEmbedding K (π : K))) (Sum.inr (w, 1))| ≤ w₀ (π : K)
        rw [NumberField.mixedEmbedding.stdBasis_apply_isComplex_snd _ w]
        have h1 : |((NumberField.mixedEmbedding K (π : K)).2 w).im| ≤
            ‖(NumberField.mixedEmbedding K (π : K)).2 w‖ :=
          Complex.abs_im_le_norm _
        have h2 : ‖(NumberField.mixedEmbedding K (π : K)).2 w‖ = w.1 (π : K) := by
          rw [← NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex w.2,
              NumberField.mixedEmbedding.normAtPlace_apply]
        linarith [(h_sec w.1).2]
  have h_out_coord_abs : ∀ π : NumberField.RingOfIntegers K,
      P_out π → ∀ i : NumberField.mixedEmbedding.index K, |z_coord π i| ≤ 2 * X := by
    intro π hx i
    have hki_nonneg : (0 : ℝ) ≤ ((k i : ℕ) : ℝ) := Nat.cast_nonneg _
    have hki_lt : (k i : ℕ) + 1 ≤ 2 * m := (k i).isLt
    have hki_le : ((k i : ℕ) : ℝ) + 1 ≤ 2 * (m : ℝ) := by
      have h1 : (((k i : ℕ) + 1 : ℕ) : ℝ) ≤ ((2 * m : ℕ) : ℝ) := by exact_mod_cast hki_lt
      push_cast at h1
      exact h1
    have ha_ge : -X ≤ a_lo i := by
      dsimp [a_lo]
      have h1 : -(m : ℝ) ≤ ((k i : ℕ) : ℝ) - (m : ℝ) := by linarith
      have h2 : (X / (m : ℝ)) * (-(m : ℝ)) ≤ (X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)) :=
        mul_le_mul_of_nonneg_left h1 (le_of_lt hδ_pos)
      have h3 : (X / (m : ℝ)) * (-(m : ℝ)) = -X := by
        rw [mul_neg, div_mul_cancel₀ X hm_ne]
      linarith
    have hb_le : b_hi i ≤ X := by
      dsimp [b_hi]
      have h1 : ((k i : ℕ) : ℝ) - (m : ℝ) + 1 ≤ (m : ℝ) := by linarith
      have h2 : (X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1) ≤ (X / (m : ℝ)) * (m : ℝ) :=
        mul_le_mul_of_nonneg_left h1 (le_of_lt hδ_pos)
      have h3 : (X / (m : ℝ)) * (m : ℝ) = X := div_mul_cancel₀ X hm_ne
      linarith
    have hxi := hx i
    rw [Set.mem_Ico] at hxi
    exact abs_le.mpr ⟨by linarith [hxi.1], by linarith [hxi.2]⟩
  have h_out_norm_le : ∀ π : NumberField.RingOfIntegers K,
      P_out π → ∀ w : NumberField.InfinitePlace K, w (π : K) ≤ 4 * X := by
    intro π hx w
    rw [← NumberField.mixedEmbedding.normAtPlace_apply w (π : K)]
    rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
    · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw, Real.norm_eq_abs]
      have h1 : |(NumberField.mixedEmbedding K (π : K)).1 ⟨w, hw⟩| =
          |z_coord π (Sum.inl ⟨w, hw⟩)| := by
        dsimp [z_coord, b]
      have h2 := h_out_coord_abs π hx (Sum.inl ⟨w, hw⟩)
      linarith
    · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hw]
      have h1 := Complex.norm_le_abs_re_add_abs_im ((NumberField.mixedEmbedding K (π : K)).2 ⟨w, hw⟩)
      have hre : |((NumberField.mixedEmbedding K (π : K)).2 ⟨w, hw⟩).re| =
          |z_coord π (Sum.inr (⟨w, hw⟩, 0))| := by
        dsimp [z_coord, b]
      have him : |((NumberField.mixedEmbedding K (π : K)).2 ⟨w, hw⟩).im| =
          |z_coord π (Sum.inr (⟨w, hw⟩, 1))| := by
        dsimp [z_coord, b]
      have h2 := h_out_coord_abs π hx (Sum.inr (⟨w, hw⟩, 0))
      have h3 := h_out_coord_abs π hx (Sum.inr (⟨w, hw⟩, 1))
      linarith
  have h_perturb : ∀ (π : NumberField.RingOfIntegers K) (j : Fin L)
      (i : NumberField.mixedEmbedding.index K),
      P_sector π →
      w₀ (π : K) ∈ Set.Ico (ε_L * ((j : ℕ) : ℝ)) (ε_L * (((j : ℕ) : ℝ) + 1)) →
      -ε_L ≤ ε_L * (((j : ℕ) : ℝ) + 1) * (z_coord π i / w₀ (π : K)) - z_coord π i ∧
        ε_L * (((j : ℕ) : ℝ) + 1) * (z_coord π i / w₀ (π : K)) - z_coord π i ≤ ε_L := by
    intro π j i h_sec h_rad
    have hr_ge_one : 1 ≤ w₀ (π : K) := (h_sec w₀).1
    have hr_pos : 0 < w₀ (π : K) := by linarith
    have hr_ne : w₀ (π : K) ≠ 0 := ne_of_gt hr_pos
    have hc := h_coord_le_w0 π h_sec i
    set u : ℝ := z_coord π i / w₀ (π : K)
    have hu_lo : -1 ≤ u := by
      dsimp [u]
      rw [le_div_iff₀ hr_pos]
      linarith [hc.1]
    have hu_hi : u ≤ 1 := by
      dsimp [u]
      rw [div_le_iff₀ hr_pos]
      linarith [hc.2]
    set R : ℝ := ε_L * (((j : ℕ) : ℝ) + 1)
    rw [Set.mem_Ico] at h_rad
    have hR_lo : 0 ≤ R - w₀ (π : K) := by
      dsimp [R]
      linarith [h_rad.2]
    have hR_hi : R - w₀ (π : K) ≤ ε_L := by
      dsimp [R]
      linarith [h_rad.1]
    have hz_eq : w₀ (π : K) * u = z_coord π i := mul_div_cancel₀ (z_coord π i) hr_ne
    have h_diff : R * u - z_coord π i = (R - w₀ (π : K)) * u := by
      rw [← hz_eq]
      ring
    rw [h_diff]
    have h_abs_u : |u| ≤ 1 := abs_le.mpr ⟨hu_lo, hu_hi⟩
    have h_abs_R : |R - w₀ (π : K)| ≤ ε_L := by
      rw [abs_of_nonneg hR_lo]
      exact hR_hi
    have h_abs_prod : |(R - w₀ (π : K)) * u| ≤ ε_L := by
      rw [abs_mul]
      calc |R - w₀ (π : K)| * |u|
        _ ≤ ε_L * 1 := mul_le_mul h_abs_R h_abs_u (abs_nonneg _) (le_of_lt hε_pos)
        _ = ε_L := mul_one _
    exact abs_le.mp h_abs_prod
  clear h_coord_le_w0 h_out_coord_abs
  have h_sec_out : ∀ π : NumberField.RingOfIntegers K, P_sec π → P_out π := by
    intro π h i
    have hi := h.1 i
    rw [Set.mem_Ico] at hi ⊢
    exact ⟨by linarith [hi.1], by linarith [hi.2]⟩
  have h_in_cube : ∀ π : NumberField.RingOfIntegers K, P_in π → P_cube π := by
    intro π h i
    have hi := h i
    rw [Set.mem_Ico] at hi ⊢
    exact ⟨by linarith [hi.1], by linarith [hi.2]⟩
  have h_in_out : ∀ π : NumberField.RingOfIntegers K, P_in π → P_out π := by
    intro π h i
    have hi := h i
    rw [Set.mem_Ico] at hi ⊢
    exact ⟨by linarith [hi.1], by linarith [hi.2]⟩
  have h_shell_out : ∀ (j : Fin L) (π : NumberField.RingOfIntegers K), P_shell j π → P_out π := by
    intro j π h i
    have hi := h.1 i
    have hp := h_perturb π j i h.2.1 h.2.2
    rw [Set.mem_Ico] at hi ⊢
    exact ⟨by linarith [hi.1, hp.2], by linarith [hi.2, hp.1]⟩
  let M : NumberField.RingOfIntegers K → Finset (Fin L) :=
    fun π => Finset.univ.filter (fun j : Fin L => P_shell j π)
  have hM_le_one : ∀ π : NumberField.RingOfIntegers K, (M π).card ≤ 1 := by
    intro π
    rw [Finset.card_le_one]
    intro j₁ hj₁ j₂ hj₂
    rw [Finset.mem_filter] at hj₁ hj₂
    have h1 := hj₁.2.2.2
    have h2 := hj₂.2.2.2
    rw [Set.mem_Ico] at h1 h2
    apply Fin.ext
    have h12_lt : ((j₁ : ℕ) : ℝ) < ((j₂ : ℕ) : ℝ) + 1 :=
      lt_of_mul_lt_mul_left (lt_of_le_of_lt h1.1 h2.2) (le_of_lt hε_pos)
    have h21_lt : ((j₂ : ℕ) : ℝ) < ((j₁ : ℕ) : ℝ) + 1 :=
      lt_of_mul_lt_mul_left (lt_of_le_of_lt h2.1 h1.2) (le_of_lt hε_pos)
    have h12_real : ((j₁ : ℕ) : ℝ) < (((j₂ : ℕ) + 1 : ℕ) : ℝ) := by
      push_cast; exact h12_lt
    have h21_real : ((j₂ : ℕ) : ℝ) < (((j₁ : ℕ) + 1 : ℕ) : ℝ) := by
      push_cast; exact h21_lt
    have h12_nat : (j₁ : ℕ) < (j₂ : ℕ) + 1 := by exact_mod_cast h12_real
    have h21_nat : (j₂ : ℕ) < (j₁ : ℕ) + 1 := by exact_mod_cast h21_real
    omega
  let c : NumberField.RingOfIntegers K → ℝ :=
    fun π => (if P_sec π then (1 : ℝ) else 0) - ((M π).card : ℝ)
  have hc_eq_zero_of_in : ∀ π : NumberField.RingOfIntegers K, P_in π → c π = 0 := by
    intro π h_in
    have h_cube : P_cube π := h_in_cube π h_in
    dsimp [c]
    by_cases h_sector : P_sector π
    · have h_sec : P_sec π := ⟨h_cube, h_sector⟩
      rw [if_pos h_sec]
      have hw0_lt : w₀ (π : K) < X := by
        rw [← NumberField.mixedEmbedding.normAtPlace_apply w₀ (π : K)]
        exact hQ_bdd (NumberField.mixedEmbedding K (π : K)) h_cube w₀
      have hw0_ge_one : 1 ≤ w₀ (π : K) := (h_sector w₀).1
      have hw0_nonneg : 0 ≤ w₀ (π : K) := by linarith
      set t : ℝ := w₀ (π : K) / ε_L
      have ht_nonneg : 0 ≤ t := div_nonneg hw0_nonneg (le_of_lt hε_pos)
      have ht_lt : t < (L : ℝ) := by
        dsimp [t]
        rw [div_lt_iff₀ hε_pos]
        have h_mul : (L : ℝ) * ε_L = X := by
          dsimp [ε_L]
          exact mul_div_cancel₀ X hL_ne
        linarith
      have hfloor_lt : ⌊t⌋₊ < L := (Nat.floor_lt ht_nonneg).mpr ht_lt
      let j₀ : Fin L := ⟨⌊t⌋₊, hfloor_lt⟩
      have hj₀_rad : w₀ (π : K) ∈ Set.Ico (ε_L * ((j₀ : ℕ) : ℝ)) (ε_L * (((j₀ : ℕ) : ℝ) + 1)) := by
        rw [Set.mem_Ico]
        have hf1 : ((j₀ : ℕ) : ℝ) ≤ t := Nat.floor_le ht_nonneg
        have hf2 : t < ((j₀ : ℕ) : ℝ) + 1 := Nat.lt_floor_add_one t
        have h_et : ε_L * t = w₀ (π : K) := mul_div_cancel₀ (w₀ (π : K)) hε_ne
        refine ⟨?_, ?_⟩
        · rw [← h_et]
          exact mul_le_mul_of_nonneg_left hf1 (le_of_lt hε_pos)
        · rw [← h_et]
          exact mul_lt_mul_of_pos_left hf2 hε_pos
      have hj₀_coord : ∀ i : NumberField.mixedEmbedding.index K,
          ε_L * (((j₀ : ℕ) : ℝ) + 1) * (z_coord π i / w₀ (π : K)) ∈ Set.Ico (a_lo i) (b_hi i) := by
        intro i
        have hi := h_in i
        have hp := h_perturb π j₀ i h_sector hj₀_rad
        rw [Set.mem_Ico] at hi ⊢
        exact ⟨by linarith [hi.1, hp.1], by linarith [hi.2, hp.2]⟩
      have hj₀_mem : j₀ ∈ M π := by
        rw [Finset.mem_filter]
        exact ⟨Finset.mem_univ j₀, hj₀_coord, h_sector, hj₀_rad⟩
      have h_card_ge : 1 ≤ (M π).card := Finset.card_pos.mpr ⟨j₀, hj₀_mem⟩
      have h_card_eq : (M π).card = 1 := le_antisymm (hM_le_one π) h_card_ge
      rw [h_card_eq]
      norm_num
    · have h_not_sec : ¬ P_sec π := fun h => h_sector h.2
      rw [if_neg h_not_sec]
      have hM_empty : M π = ∅ := by
        rw [Finset.filter_eq_empty_iff]
        intro j _ hj
        exact h_sector hj.2.1
      rw [hM_empty, Finset.card_empty]
      norm_num
  have hc_abs_le : ∀ π : NumberField.RingOfIntegers K,
      |c π| ≤ if ¬ P_in π then (1 : ℝ) else 0 := by
    intro π
    by_cases h_in : P_in π
    · rw [if_neg (not_not.mpr h_in), hc_eq_zero_of_in π h_in, abs_zero]
    · rw [if_pos h_in]
      dsimp [c]
      have h1 : 0 ≤ (if P_sec π then (1 : ℝ) else 0) ∧ (if P_sec π then (1 : ℝ) else 0) ≤ 1 := by
        split_ifs <;> constructor <;> norm_num
      have h2_lo : (0 : ℝ) ≤ ((M π).card : ℝ) := Nat.cast_nonneg _
      have h2_hi : ((M π).card : ℝ) ≤ 1 := by exact_mod_cast hM_le_one π
      exact abs_le.mpr ⟨by linarith [h1.1, h2_hi], by linarith [h1.2, h2_lo]⟩
  clear h_perturb h_in_cube hM_le_one hc_eq_zero_of_in
  let B_4X : Set K := {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ 4 * X}
  have hB_fin : B_4X.Finite := NumberField.Embeddings.finite_of_norm_le K ℂ (4 * X)
  have hpre_fin : (algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_4X).Finite :=
    hB_fin.preimage NumberField.RingOfIntegers.coe_injective.injOn
  have hS_out_sub : {π : NumberField.RingOfIntegers K | Prime π ∧ P_out π} ⊆
      algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_4X := by
    intro π hπ
    refine ⟨NumberField.RingOfIntegers.isIntegral_coe π, ?_⟩
    intro φ
    let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
    have hw1 : w (π : K) = ‖φ (π : K)‖ := NumberField.InfinitePlace.apply φ (π : K)
    have hle : w (π : K) ≤ 4 * X := h_out_norm_le π hπ.2 w
    change ‖φ (π : K)‖ ≤ 4 * X
    linarith
  have hS_out_fin : {π : NumberField.RingOfIntegers K | Prime π ∧ P_out π}.Finite :=
    hpre_fin.subset hS_out_sub
  let S_out := {π : NumberField.RingOfIntegers K // Prime π ∧ P_out π}
  letI : Fintype S_out := hS_out_fin.fintype
  have hS_cop_fin : {π : NumberField.RingOfIntegers K |
      Prime π ∧ P_out π ∧ IsUnit (Ideal.Quotient.mk q π)}.Finite :=
    hS_out_fin.subset (fun _ hπ => ⟨hπ.1, hπ.2.1⟩)
  let S_out_cop := {π : NumberField.RingOfIntegers K //
    Prime π ∧ P_out π ∧ IsUnit (Ideal.Quotient.mk q π)}
  letI : Fintype S_out_cop := hS_cop_fin.fintype
  let term : S_out_cop → ℂ := fun x =>
    ψ (Additive.ofMul x.2.2.2.unit) * (L_log x.1 : ℂ)
  let S_sec_cop := {π : NumberField.RingOfIntegers K //
    Prime π ∧
    P_cube π ∧
    P_sector π ∧
    IsUnit (Ideal.Quotient.mk q π)}
  let e_sec_cop : S_sec_cop ≃ {x : S_out_cop // P_sec x.1} :=
    { toFun := fun π =>
        ⟨⟨π.1, π.2.1, h_sec_out π.1 ⟨π.2.2.1, π.2.2.2.1⟩, π.2.2.2.2⟩,
         ⟨π.2.2.1, π.2.2.2.1⟩⟩
      invFun := fun x =>
        ⟨x.1.1, x.1.2.1, x.2.1, x.2.2, x.1.2.2.2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun x => by ext; rfl }
  have h_lhs1 :
      (∑' π : S_sec_cop,
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑ x : S_out_cop, (if P_sec x.1 then (1 : ℂ) else 0) * term x := by
    change (∑' π : S_sec_cop, term (e_sec_cop π).1) = _
    rw [Equiv.tsum_eq e_sec_cop (fun z : {x : S_out_cop // P_sec x.1} => term z.1), tsum_fintype]
    have hsub : (∑ z : {x : S_out_cop // P_sec x.1}, term z.1) =
        ∑ x ∈ Finset.univ.filter (fun x : S_out_cop => P_sec x.1), term x :=
      (Finset.sum_subtype (Finset.univ.filter (fun x : S_out_cop => P_sec x.1))
        (fun _ => by simp) term).symm
    rw [hsub, Finset.sum_filter]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    split_ifs <;> ring
  let S_shell_cop (j : Fin L) := {π : NumberField.RingOfIntegers K //
    Prime π ∧
    (∀ i : NumberField.mixedEmbedding.index K,
      ε_L * (((j : ℕ) : ℝ) + 1) * (z_coord π i / w₀ (π : K)) ∈ Set.Ico (a_lo i) (b_hi i)) ∧
    P_sector π ∧
    w₀ (π : K) ∈ Set.Ico (ε_L * ((j : ℕ) : ℝ)) (ε_L * (((j : ℕ) : ℝ) + 1)) ∧
    IsUnit (Ideal.Quotient.mk q π)}
  let e_shell_cop (j : Fin L) : S_shell_cop j ≃ {x : S_out_cop // P_shell j x.1} :=
    { toFun := fun π =>
        ⟨⟨π.1, π.2.1, h_shell_out j π.1 ⟨π.2.2.1, π.2.2.2.1, π.2.2.2.2.1⟩, π.2.2.2.2.2⟩,
         ⟨π.2.2.1, π.2.2.2.1, π.2.2.2.2.1⟩⟩
      invFun := fun x =>
        ⟨x.1.1, x.1.2.1, x.2.1, x.2.2.1, x.2.2.2, x.1.2.2.2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun x => by ext; rfl }
  have h_lhs_shell : ∀ j : Fin L,
      (∑' π : S_shell_cop j,
        ψ (Additive.ofMul π.2.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑ x : S_out_cop, (if P_shell j x.1 then term x else 0) := by
    intro j
    change (∑' π : S_shell_cop j, term (e_shell_cop j π).1) = _
    rw [Equiv.tsum_eq (e_shell_cop j) (fun z : {x : S_out_cop // P_shell j x.1} => term z.1), tsum_fintype]
    have hsub : (∑ z : {x : S_out_cop // P_shell j x.1}, term z.1) =
        ∑ x ∈ Finset.univ.filter (fun x : S_out_cop => P_shell j x.1), term x :=
      (Finset.sum_subtype (Finset.univ.filter (fun x : S_out_cop => P_shell j x.1))
        (fun _ => by simp) term).symm
    rw [hsub, Finset.sum_filter]
  have h_lhs2 :
      (∑ j : Fin L,
        ∑' π : S_shell_cop j,
          ψ (Additive.ofMul π.2.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑ x : S_out_cop, ((M x.1).card : ℂ) * term x := by
    simp_rw [h_lhs_shell]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
  have h_lhs_diff :
      (∑' π : S_sec_cop,
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) -
      (∑ j : Fin L,
        ∑' π : S_shell_cop j,
          ψ (Additive.ofMul π.2.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑ x : S_out_cop, (c x.1 : ℂ) * term x := by
    rw [h_lhs1, h_lhs2, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    dsimp [c]
    split_ifs <;> push_cast <;> ring
  have h_term_norm : ∀ x : S_out_cop,
      ‖(c x.1 : ℂ) * term x‖ = |c x.1| * L_log x.1 := by
    intro x
    dsimp [term]
    rw [norm_mul, norm_mul, AddChar.norm_apply, one_mul,
      Complex.norm_real, Real.norm_eq_abs,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hL_nonneg x.1)]
  let e_cop : S_out_cop ≃ {y : S_out // IsUnit (Ideal.Quotient.mk q y.1)} :=
    { toFun := fun x => ⟨⟨x.1, x.2.1, x.2.2.1⟩, x.2.2.2⟩
      invFun := fun y => ⟨y.1.1, y.1.2.1, y.1.2.2, y.2⟩
      left_inv := fun x => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_lhs_le :
      ‖(∑' π : S_sec_cop,
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) -
      (∑ j : Fin L,
        ∑' π : S_shell_cop j,
          ψ (Additive.ofMul π.2.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
      ≤ ∑ y : S_out, |c y.1| * L_log y.1 := by
    rw [h_lhs_diff]
    calc ‖∑ x : S_out_cop, (c x.1 : ℂ) * term x‖
      _ ≤ ∑ x : S_out_cop, ‖(c x.1 : ℂ) * term x‖ := norm_sum_le _ _
      _ = ∑ x : S_out_cop, |c x.1| * L_log x.1 := Finset.sum_congr rfl (fun x _ => h_term_norm x)
      _ = ∑ z : {y : S_out // IsUnit (Ideal.Quotient.mk q y.1)}, |c z.1.1| * L_log z.1.1 :=
        Equiv.sum_comp e_cop (fun z : {y : S_out // IsUnit (Ideal.Quotient.mk q y.1)} =>
          |c z.1.1| * L_log z.1.1)
      _ = ∑ y ∈ Finset.univ.filter (fun y : S_out => IsUnit (Ideal.Quotient.mk q y.1)),
            |c y.1| * L_log y.1 :=
        (Finset.sum_subtype (Finset.univ.filter (fun y : S_out => IsUnit (Ideal.Quotient.mk q y.1)))
          (fun _ => by simp) (fun y : S_out => |c y.1| * L_log y.1)).symm
      _ ≤ ∑ y : S_out, |c y.1| * L_log y.1 :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
          (fun y _ _ => mul_nonneg (abs_nonneg _) (hL_nonneg y.1))
  have h_rhs1 : (∑' y : S_out, L_log y.1) = ∑ y : S_out, L_log y.1 :=
    tsum_fintype (fun y : S_out => L_log y.1)
  let S_in_uncond := {π : NumberField.RingOfIntegers K // Prime π ∧ P_in π}
  let e_in_uncond : S_in_uncond ≃ {y : S_out // P_in y.1} :=
    { toFun := fun π => ⟨⟨π.1, π.2.1, h_in_out π.1 π.2.2⟩, π.2.2⟩
      invFun := fun y => ⟨y.1.1, y.1.2.1, y.2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_rhs2 :
      (∑' π : S_in_uncond, L_log π.1) =
        ∑ y : S_out, (if P_in y.1 then L_log y.1 else 0) := by
    change (∑' π : S_in_uncond, L_log (e_in_uncond π).1.1) = _
    rw [Equiv.tsum_eq e_in_uncond (fun z : {y : S_out // P_in y.1} => L_log z.1.1), tsum_fintype]
    have hsub : (∑ z : {y : S_out // P_in y.1}, L_log z.1.1) =
        ∑ y ∈ Finset.univ.filter (fun y : S_out => P_in y.1), L_log y.1 :=
      (Finset.sum_subtype (Finset.univ.filter (fun y : S_out => P_in y.1))
        (fun _ => by simp) (fun y : S_out => L_log y.1)).symm
    rw [hsub, Finset.sum_filter]
  have h_rhs_diff :
      (∑' y : S_out, L_log y.1) - (∑' π : S_in_uncond, L_log π.1) =
        ∑ y : S_out, (if ¬ P_in y.1 then L_log y.1 else 0) := by
    rw [h_rhs1, h_rhs2, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun y _ => ?_)
    by_cases h : P_in y.1 <;> simp [h]
  have h_rhs_nonneg :
      0 ≤ ∑ y : S_out, (if ¬ P_in y.1 then L_log y.1 else 0) := by
    refine Finset.sum_nonneg (fun y _ => ?_)
    split_ifs
    · exact le_rfl
    · exact hL_nonneg y.1
  have h_rhs_abs :
      |(∑' y : S_out, L_log y.1) - (∑' π : S_in_uncond, L_log π.1)| =
        ∑ y : S_out, (if ¬ P_in y.1 then L_log y.1 else 0) := by
    rw [h_rhs_diff, abs_of_nonneg h_rhs_nonneg]
  change ‖(∑' π : S_sec_cop,
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) -
      (∑ j : Fin L,
        ∑' π : S_shell_cop j,
          ψ (Additive.ofMul π.2.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
    ≤ |(∑' y : S_out, L_log y.1) - (∑' π : S_in_uncond, L_log π.1)|
  rw [h_rhs_abs]
  refine le_trans h_lhs_le (Finset.sum_le_sum (fun y _ => ?_))
  have h_mul := mul_le_mul_of_nonneg_right (hc_abs_le y.1) (hL_nonneg y.1)
  calc |c y.1| * L_log y.1
    _ ≤ (if ¬ P_in y.1 then (1 : ℝ) else 0) * L_log y.1 := h_mul
    _ = if ¬ P_in y.1 then L_log y.1 else 0 := by split_ifs <;> ring

theorem mitsui_prime_grid_cube_collar_diff_bound {K : Type u} [Field K] [NumberField K] :
    ∃ c_col : ℝ, 0 < c_col ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m →
          ∀ L : ℕ, 1 ≤ L →
            ∀ k : NumberField.mixedEmbedding.index K → Fin (2 * m),
              |(∑' π : {π : NumberField.RingOfIntegers K //
                    Prime π ∧
                    ∀ i : NumberField.mixedEmbedding.index K,
                      (NumberField.mixedEmbedding.stdBasis K).repr
                          (NumberField.mixedEmbedding K (π : K)) i ∈
                        Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)) - X / (L : ℝ))
                          ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1) + X / (L : ℝ))},
