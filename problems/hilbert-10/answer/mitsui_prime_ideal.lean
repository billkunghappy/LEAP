    rw [Real.exp_add, Real.exp_add, ← Real.rpow_def_of_pos hm_pos (2 : ℝ),
        ← Real.rpow_def_of_pos hm_pos (-2 : ℝ), Real.rpow_neg (le_of_lt hm_pos) (2 : ℝ)] at h_exp_ineq
    exact h_exp_ineq
  let maj : ℕ → ℝ := fun m => (M₀ * C₁ * Real.exp K₀) * ((m : ℝ) ^ (2 : ℝ))⁻¹
  have h_maj_sum : Summable maj :=
    (Real.summable_nat_rpow_inv.mpr one_lt_two).mul_left (M₀ * C₁ * Real.exp K₀)
  let a_arg : ℕ → ℝ := fun m =>
    Real.pi * (D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * ((m : ℝ) * v))) ^ (2 / (n : ℝ))
  let term : ClassGroup R → ℕ → ℂ := fun C m =>
    (∑' I : S_prin C m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) * (J_K (a_arg m) : ℂ)
  have h_term_sum : ∀ C : ClassGroup R, Summable (fun m : ℕ => star (ψ (J_rep C)) * term C m) := by
    intro C
    refine Summable.of_norm_bounded h_maj_sum (fun m => ?_)
    rw [norm_mul, norm_star, hψ_rep C, one_mul]
    dsimp [term]
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (hJK_nn (a_arg m))]
    have h_card_step : ‖∑' I : S_prin C m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖ * J_K (a_arg m) ≤
        (Nat.card (S_m m) : ℝ) * J_K (a_arg m) :=
      mul_le_mul_of_nonneg_right ((h_s2 m).2 C) (hJK_nn (a_arg m))
    refine le_trans h_card_step ?_
    by_cases hm0 : m = 0
    · subst hm0
      haveI h_empty : IsEmpty (S_m 0) := by
        refine ⟨fun I => ?_⟩
        exact I.2.1 (Ideal.absNorm_eq_zero_iff.mp I.2.2)
      rw [Nat.card_of_isEmpty, Nat.cast_zero, zero_mul]
      dsimp [maj]
      positivity
    · have hm_ge_one_nat : 1 ≤ m := Nat.one_le_iff_ne_zero.mpr hm0
      have hm_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm_ge_one_nat
      have hm_pos : (0 : ℝ) < (m : ℝ) := lt_of_lt_of_le zero_lt_one hm_ge_one
      have hmα_ge_one : 1 ≤ (m : ℝ) ^ α := Real.one_le_rpow hm_ge_one (le_of_lt hα_pos)
      have ha_eq : a_arg m = a₀ * (m : ℝ) ^ α := by
        dsimp [a_arg, a₀, α, b_scale]
        have h_in : D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * ((m : ℝ) * v)) =
            (m : ℝ) * (D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * v)) := by ring
        rw [h_in, Real.mul_rpow (le_of_lt hm_pos) (le_of_lt hb_pos)]
        ring
      have ha_ge : a₀ ≤ a_arg m := by
        rw [ha_eq]
        exact le_mul_of_one_le_right (le_of_lt ha₀_pos) hmα_ge_one
      have hJK_m : J_K (a_arg m) ≤ M₀ * Real.exp (-c_decay * (m : ℝ) ^ α) := by
        have h1 := hJK_bound (a_arg m) ha_ge
        have h_exp_eq : -((n : ℝ) / 2) * a_arg m = -c_decay * (m : ℝ) ^ α := by
          rw [ha_eq]
          dsimp [c_decay]
          ring
        rwa [h_exp_eq] at h1
      have hm_le_sq : (m : ℝ) ≤ (m : ℝ) ^ (2 : ℝ) := by
        rw [Real.rpow_two]
        nlinarith
      have h_card_m : (Nat.card (S_m m) : ℝ) ≤ C₁ * (m : ℝ) ^ (2 : ℝ) := by
        calc (Nat.card (S_m m) : ℝ)
            ≤ C₁ * (m : ℝ) := ha_K_bound m hm_ge_one_nat
          _ ≤ C₁ * (m : ℝ) ^ (2 : ℝ) := mul_le_mul_of_nonneg_left hm_le_sq (le_of_lt hC₁_pos)
      have h_dom_m := h_dom m hm_ge_one_nat
      calc (Nat.card (S_m m) : ℝ) * J_K (a_arg m)
          ≤ (C₁ * (m : ℝ) ^ (2 : ℝ)) * (M₀ * Real.exp (-c_decay * (m : ℝ) ^ α)) :=
            mul_le_mul h_card_m hJK_m (hJK_nn _) (by positivity)
        _ = (M₀ * C₁) * (((m : ℝ) ^ (2 : ℝ)) * Real.exp (-c_decay * (m : ℝ) ^ α)) := by ring
        _ ≤ (M₀ * C₁) * (Real.exp K₀ * ((m : ℝ) ^ (2 : ℝ))⁻¹) :=
            mul_le_mul_of_nonneg_left h_dom_m (by positivity)
        _ = maj m := by dsimp [maj]; ring
  
  have h_lhs_eq :
      (∑' m : ℕ,
        (∑' I : S_m m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) * (J_K (a_arg m) : ℂ)) =
      ∑ C : ClassGroup R, star (ψ (J_rep C)) * (∑' m : ℕ, term C m) := by
    have h_step1 : ∀ m : ℕ,
        (∑' I : S_m m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) * (J_K (a_arg m) : ℂ) =
        ∑ C : ClassGroup R, star (ψ (J_rep C)) * term C m := by
      intro m
      rw [(h_s2 m).1, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun C _ => ?_)
      dsimp [term]
      ring
    simp_rw [h_step1]
    rw [Summable.tsum_finsetSum (fun C _ => h_term_sum C)]
    refine Finset.sum_congr rfl (fun C _ => ?_)
    exact tsum_mul_left
  change (∑' m : ℕ,
      (∑' I : S_m m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) * (J_K (a_arg m) : ℂ)) = _
  rw [h_lhs_eq]
  refine Finset.sum_congr rfl (fun C _ => ?_)
  congr 1
  refine tsum_congr (fun m => ?_)
  dsimp [term, a_arg]
  congr 2
  have hJ_ne : (J_rep C : Ideal R) ≠ ⊥ := nonZeroDivisors.coe_ne_zero (J_rep C)
  have hNJ_ne : (Ideal.absNorm (J_rep C : Ideal R) : ℝ) ≠ 0 :=
    Nat.cast_ne_zero.mpr (Ideal.absNorm_eq_zero_iff.not.mpr hJ_ne)
  have h_cancel :
      (D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * v) / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) *
        ((Ideal.absNorm (J_rep C : Ideal R) : ℝ) * (m : ℝ)) =
      D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * ((m : ℝ) * v)) := by
    field_simp [hNJ_ne]
  rw [h_cancel]

theorem mitsui_principal_subideal_norm_tsum_eq_torsion_inv_mul_cube_integral_lattice {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K))
    (J : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))
    (ψ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hψ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖ψ I‖ ≤ 1)
    (ψ_res : (NumberField.RingOfIntegers K ⧸ f) → ℂ)
    (hψ_span : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      ψ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
        ψ_res (Ideal.Quotient.mk f x))
    (b : ℝ) (hb : 0 < b) :
    let R := NumberField.RingOfIntegers K
    let n : ℕ := Module.finrank ℚ K
    let r : ℕ := NumberField.Units.rank K
    let J_K : ℝ → ℝ := fun a =>
      ∫ y : Fin r → ℝ,
        Real.exp (-a *
          ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * ∏ i : Fin r,
              (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i))
    let Cube : Set (Fin r → ℝ) := Set.pi Set.univ (fun _ => Set.Ico (0 : ℝ) 1)
    (∑' m : ℕ,
      (∑' I : {I : Ideal R // I ≠ ⊥ ∧ I ≤ (J : Ideal R) ∧ I.IsPrincipal ∧
            Ideal.absNorm I = m * Ideal.absNorm (J : Ideal R)},
        ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
        (J_K (Real.pi * ((b / (Ideal.absNorm (J : Ideal R) : ℝ)) *
          (Ideal.absNorm (J : Ideal R) * m : ℝ)) ^ (2 / (n : ℝ))) : ℂ)) =
      (NumberField.Units.torsionOrder K : ℂ)⁻¹ *
        (∫ y in Cube,
          (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J : Ideal R)},
            ψ_res (Ideal.Quotient.mk f x.1) *
              (Real.exp (-Real.pi * (b / (Ideal.absNorm (J : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                ∑ w : NumberField.InfinitePlace K,
                  (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                    ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) : ℂ))) ∧
    (∑' m : ℕ,
      (∑' I : {I : Ideal R // I ≠ ⊥ ∧ I ≤ (J : Ideal R) ∧ I.IsPrincipal ∧
            Ideal.absNorm I = m * Ideal.absNorm (J : Ideal R)},
        ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
        (J_K (Real.pi * ((b / (Ideal.absNorm (J : Ideal R) : ℝ)) *
          (Ideal.absNorm (J : Ideal R) * m : ℝ)) ^ (2 / (n : ℝ))) : ℂ)) =
      (NumberField.Units.torsionOrder K : ℂ)⁻¹ *
        (∫ y in Cube,
          (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J : Ideal R)},
            ψ_res (Ideal.Quotient.mk f x.1) *
              (Real.exp (-Real.pi * (b / (Ideal.absNorm (J : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                ∑ w : NumberField.InfinitePlace K,
                  (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                    ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℂ))) :=
by
  classical
  intro R n r J_K Cube
  haveI : Countable R :=
    Function.Injective.countable (Module.Free.chooseBasis ℤ R).repr.injective
  let ε : Fin r → Rˣ := NumberField.Units.fundSystem K
  have hw_ε_pos : ∀ (w : NumberField.InfinitePlace K) (i : Fin r),
      0 < w ((ε i : R) : K) := by
    intro w i
    exact w.pos_iff.mpr (NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero (ε i)))
  let Q_K : (Fin r → ℝ) → ℝ := fun y =>
    ∑ w : NumberField.InfinitePlace K,
      (w.mult : ℝ) * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * y i)
  
  have h_gauss_int : ∀ (a : ℝ), 0 < a →
      MeasureTheory.Integrable (fun y : Fin r → ℝ => Real.exp (-a * Q_K y)) MeasureTheory.volume := by
    intro a ha
    let w₀ : NumberField.InfinitePlace K := NumberField.Units.dirichletUnitTheorem.w₀
    let S := {w : NumberField.InfinitePlace K // w ≠ w₀}
    let e : Fin r ≃ S := NumberField.Units.equivFinRank K
    let L : NumberField.InfinitePlace K → (Fin r → ℝ) → ℝ := fun w y =>
      ∑ i : Fin r, y i * ((w.mult : ℝ) * Real.log (w ((ε i : R) : K)))
    have hQ_nn : ∀ y : Fin r → ℝ, 0 ≤ Q_K y := by
      intro y
      refine Finset.sum_nonneg (fun w _ => ?_)
      exact mul_nonneg (Nat.cast_nonneg _)
        (Finset.prod_nonneg (fun i _ => Real.rpow_nonneg (le_of_lt (hw_ε_pos w i)) _))
    have hL_le : ∀ (w : NumberField.InfinitePlace K) (y : Fin r → ℝ),
        L w y ≤ (1 / 2 : ℝ) * Q_K y := by
      intro w y
      have h_single : (w.mult : ℝ) * ∏ i : Fin r,
          (w ((ε i : R) : K)) ^ (2 * y i) ≤ Q_K y := by
        refine Finset.single_le_sum (f := fun w' : NumberField.InfinitePlace K =>
          (w'.mult : ℝ) * ∏ i : Fin r, (w' ((ε i : R) : K)) ^ (2 * y i))
          (fun w' _ => ?_) (Finset.mem_univ w)
        exact mul_nonneg (Nat.cast_nonneg _)
          (Finset.prod_nonneg (fun i _ => Real.rpow_nonneg (le_of_lt (hw_ε_pos w' i)) _))
      have h_prod_eq : (∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * y i)) =
          Real.exp (∑ i : Fin r, Real.log (w ((ε i : R) : K)) * (2 * y i)) := by
        rw [Real.exp_sum]
        refine Finset.prod_congr rfl (fun i _ => ?_)
        exact Real.rpow_def_of_pos (hw_ε_pos w i) (2 * y i)
      have h_exp : ∑ i : Fin r, Real.log (w ((ε i : R) : K)) * (2 * y i) ≤
          ∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * y i) := by
        rw [h_prod_eq]
        linarith [Real.add_one_le_exp (∑ i : Fin r, Real.log (w ((ε i : R) : K)) * (2 * y i))]
      have h_mul : (w.mult : ℝ) * (∑ i : Fin r, Real.log (w ((ε i : R) : K)) * (2 * y i)) ≤
          (w.mult : ℝ) * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * y i) :=
        mul_le_mul_of_nonneg_left h_exp (Nat.cast_nonneg _)
      have h_2L : 2 * L w y = (w.mult : ℝ) * (∑ i : Fin r, Real.log (w ((ε i : R) : K)) * (2 * y i)) := by
        dsimp [L]
        rw [Finset.mul_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        ring
      linarith
    have hL_sum_zero : ∀ y : Fin r → ℝ, ∑ w : NumberField.InfinitePlace K, L w y = 0 := by
      intro y
      dsimp [L]
      rw [Finset.sum_comm]
      have h_inner : ∀ i : Fin r,
          ∑ w : NumberField.InfinitePlace K, y i * ((w.mult : ℝ) * Real.log (w ((ε i : R) : K))) = 0 := by
        intro i
        rw [← Finset.mul_sum]
        have h_log_sum : ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * Real.log (w ((ε i : R) : K)) = 0 := by
          have h_eq : ∑ w : NumberField.InfinitePlace K,
              (w.mult : ℝ) * Real.log (w ((ε i : R) : K)) =
              Real.log (∏ w : NumberField.InfinitePlace K, (w ((ε i : R) : K)) ^ w.mult) := by
            rw [Real.log_prod (fun w _ => pow_ne_zero w.mult (ne_of_gt (hw_ε_pos w i)))]
            refine Finset.sum_congr rfl (fun w _ => ?_)
            rw [Real.log_pow]
          rw [h_eq, NumberField.InfinitePlace.prod_eq_abs_norm]
          have h_norm := NumberField.Units.norm K (ε i)
          have h_cast : |(Algebra.norm ℚ (((ε i : R) : K)))| = 1 := h_norm
          rw [h_cast, Rat.cast_one, Real.log_one]
        rw [h_log_sum, mul_zero]
      simp [h_inner]
    have hL_abs_le : ∀ (w' : S) (y : Fin r → ℝ),
        |L w'.1 y| ≤ ((r : ℝ) + 1) / 2 * Q_K y := by
      intro w' y
      have h_split := Fintype.sum_eq_add_sum_subtype_ne (fun w => L w y) w₀
      rw [hL_sum_zero y] at h_split
      have h_w0 := hL_le w₀ y
      have h_neg_sum : - ∑ w : S, L w.1 y ≤ (1 / 2 : ℝ) * Q_K y := by linarith
      have h_erase := Finset.add_sum_erase Finset.univ (fun w : S => L w.1 y) (Finset.mem_univ w')
      have h_erase_le : ∑ w ∈ Finset.univ.erase w', L w.1 y ≤ (r : ℝ) * ((1 / 2 : ℝ) * Q_K y) := by
        have h1 : ∑ w ∈ Finset.univ.erase w', L w.1 y ≤
            (Finset.univ.erase w').card • ((1 / 2 : ℝ) * Q_K y) :=
          Finset.sum_le_card_nsmul (Finset.univ.erase w') (fun w : S => L w.1 y) ((1 / 2 : ℝ) * Q_K y)
            (fun w _ => hL_le w.1 y)
        rw [nsmul_eq_mul] at h1
        have h_card : (Finset.univ.erase w').card ≤ r := by
          have h2 : (Finset.univ.erase w').card ≤ (Finset.univ : Finset S).card := Finset.card_erase_le
          have h3 : (Finset.univ : Finset S).card = r := by
            rw [Finset.card_univ, Fintype.card_congr e.symm, Fintype.card_fin]
          omega
        have h_card_r : ((Finset.univ.erase w').card : ℝ) ≤ (r : ℝ) := by exact_mod_cast h_card
        exact le_trans h1 (mul_le_mul_of_nonneg_right h_card_r (by linarith [hQ_nn y]))
      have h_upper : L w'.1 y ≤ ((r : ℝ) + 1) / 2 * Q_K y := by
        have h1 := hL_le w'.1 y
        have hr : (0 : ℝ) ≤ (r : ℝ) := Nat.cast_nonneg r
        have hQ := hQ_nn y
        nlinarith
      have h_lower : -(((r : ℝ) + 1) / 2 * Q_K y) ≤ L w'.1 y := by
        change L w'.1 y + ∑ w ∈ Finset.univ.erase w', L w.1 y = ∑ w : S, L w.1 y at h_erase
        linarith
      exact abs_le.mpr ⟨h_lower, h_upper⟩
    let A : Matrix S S ℝ := Matrix.of fun w₁ w₂ =>
      (w₂.1.mult : ℝ) * Real.log (w₂.1 ((ε (e.symm w₁) : R) : K))
    have hA_det : |A.det| = NumberField.Units.regulator K :=
      (NumberField.Units.regulator_eq_det K w₀ e.symm).symm
    have hA_pos : 0 < |A.det| := by
      rw [hA_det]
      exact NumberField.Units.regulator_pos K
    have hA_unit : IsUnit A.det := isUnit_iff_ne_zero.mpr (abs_pos.mp hA_pos)
    have hy_eq : ∀ (y : Fin r → ℝ) (i : Fin r),
        y i = ∑ w : S, L w.1 y * A⁻¹ w (e i) := by
      intro y i
      let x : S → ℝ := fun w₁ => y (e.symm w₁)
      have hxA : Matrix.vecMul x A = fun w₂ : S => L w₂.1 y := by
        ext w₂
        dsimp [Matrix.vecMul, dotProduct, x, A, L]
        exact e.symm.sum_comp (fun j => y j * ((w₂.1.mult : ℝ) * Real.log (w₂.1 ((ε j : R) : K))))
      have hx_inv : Matrix.vecMul (Matrix.vecMul x A) A⁻¹ = x := by
        rw [Matrix.vecMul_vecMul, Matrix.mul_nonsing_inv A hA_unit, Matrix.vecMul_one]
      have h_eval := congr_fun hx_inv (e i)
      rw [hxA] at h_eval
      dsimp [Matrix.vecMul, dotProduct, x] at h_eval
      rw [e.symm_apply_apply] at h_eval
      exact h_eval.symm
    let B_K : ℝ := 1 + ∑ i : Fin r, ∑ w : S, |A⁻¹ w (e i)|
    have hBK_pos : 0 < B_K := by
      have : 0 ≤ ∑ i : Fin r, ∑ w : S, |A⁻¹ w (e i)| :=
        Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun w _ => abs_nonneg _))
      dsimp [B_K]
      linarith
    have hr1_pos : 0 < ((r : ℝ) + 1) / 2 := by positivity
    let c₀ : ℝ := (B_K * (((r : ℝ) + 1) / 2))⁻¹
    have hc₀_pos : 0 < c₀ := by dsimp [c₀]; positivity
    have hQ_ge : ∀ y : Fin r → ℝ, c₀ * (∑ i : Fin r, |y i|) ≤ Q_K y := by
      intro y
      have hy_abs : ∀ i : Fin r, |y i| ≤ (∑ w : S, |A⁻¹ w (e i)|) * (((r : ℝ) + 1) / 2 * Q_K y) := by
        intro i
        rw [hy_eq y i]
        calc |∑ w : S, L w.1 y * A⁻¹ w (e i)|
            ≤ ∑ w : S, |L w.1 y * A⁻¹ w (e i)| := Finset.abs_sum_le_sum_abs _ _
          _ = ∑ w : S, |L w.1 y| * |A⁻¹ w (e i)| := by
              refine Finset.sum_congr rfl (fun w _ => abs_mul _ _)
          _ ≤ ∑ w : S, (((r : ℝ) + 1) / 2 * Q_K y) * |A⁻¹ w (e i)| := by
              refine Finset.sum_le_sum (fun w _ => ?_)
              exact mul_le_mul_of_nonneg_right (hL_abs_le w y) (abs_nonneg _)
          _ = (∑ w : S, |A⁻¹ w (e i)|) * (((r : ℝ) + 1) / 2 * Q_K y) := by
              rw [Finset.sum_mul]
              refine Finset.sum_congr rfl (fun w _ => mul_comm _ _)
      have h_sum_y : ∑ i : Fin r, |y i| ≤ (B_K * (((r : ℝ) + 1) / 2)) * Q_K y := by
        calc ∑ i : Fin r, |y i|
            ≤ ∑ i : Fin r, (∑ w : S, |A⁻¹ w (e i)|) * (((r : ℝ) + 1) / 2 * Q_K y) :=
              Finset.sum_le_sum (fun i _ => hy_abs i)
          _ = (∑ i : Fin r, ∑ w : S, |A⁻¹ w (e i)|) * (((r : ℝ) + 1) / 2 * Q_K y) := by
              rw [← Finset.sum_mul]
          _ ≤ B_K * (((r : ℝ) + 1) / 2 * Q_K y) := by
              refine mul_le_mul_of_nonneg_right ?_ (by positivity [hQ_nn y])
              dsimp [B_K]
              linarith
          _ = (B_K * (((r : ℝ) + 1) / 2)) * Q_K y := by ring
      dsimp [c₀]
      rw [inv_mul_le_iff₀ (mul_pos hBK_pos hr1_pos)]
      exact h_sum_y
