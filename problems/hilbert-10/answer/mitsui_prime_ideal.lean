    mitsui_entire_strip_exp_bound_of_high_im_bound g_sq C₁ B₁ hC₁_pos hB₁_nonneg hg_diff h_high
  refine ⟨B, χ_dual, g_sq, hB_pos, hχ_dual_norm, hg_diff, hg_eq, ?_, hg_exp⟩
  intro s hs
  set n : ℕ := Module.finrank ℚ K
  have hq_norm_ne_zero : Ideal.absNorm q ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hq
