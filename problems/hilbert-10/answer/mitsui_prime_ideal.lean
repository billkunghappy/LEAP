  have h_outer_sub : Ω ⊆ (⋃ p ∈ U_outer, Q_hat p) := by
    intro z hz
    rcases h_out z hz with ⟨hz₀, hy_bdd, hθ_ioo, ξ, hξ_real, hξ_outer⟩
    let q₁ : Fin r → ℤ := fun j => Int.floor ((z (e.symm j).1).1 / h)
    have hq₁_ivl : ∀ j : Fin r,
        (z (e.symm j).1).1 ∈ Set.Ico ((q₁ j : ℝ) * h) (((q₁ j : ℝ) + 1) * h) := by
      intro j
      rw [Set.mem_Ico]
