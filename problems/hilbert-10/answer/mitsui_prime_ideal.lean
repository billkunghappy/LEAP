        _ = t ^ z.re * (P_f * W₀_maj (S_f * t)) := by ring
    refine ⟨h_int, ?_⟩
    set B_f : ℝ := D ^ (1 / 2 : ℝ) * N_f ^ (1 / 2 : ℝ)
    have hBf_nn : 0 ≤ B_f := by dsimp [B_f]; positivity
    have hBS_one : B_f * S_f = 1 := by
      dsimp [B_f, S_f, D, N_f]
      have hD1 : D ^ (1 / 2 : ℝ) * D ^ (-1 / 2 : ℝ) = 1 := by
        rw [← Real.rpow_add hD_pos]; norm_num
      have hN1 : N_f ^ (1 / 2 : ℝ) * N_f ^ (-1 / 2 : ℝ) = 1 := by
        rw [← Real.rpow_add hNf_pos]; norm_num
      calc (D ^ (1 / 2 : ℝ) * N_f ^ (1 / 2 : ℝ)) * (D ^ (-1 / 2 : ℝ) * N_f ^ (-1 / 2 : ℝ))
