  let term_log (xpm : D_log) : ℝ :=
    W_elt xpm.1.1 * F_riesz xpm.1.2.1 xpm.1.2.2
  let term_all_prin (pm : D_all) : ℝ :=
    if (pm.1.1.asIdeal ^ pm.1.2).IsPrincipal then
      M_real pm.1.1 pm.1.2 * F_riesz pm.1.1 pm.1.2
    else 0
