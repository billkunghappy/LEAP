    have h_sum_real := LSeriesSummable_of_sum_norm_bigO_and_nonneg h_bigO ha_nonneg zero_le_one hs
    simpa [a_K, S] using h_sum_real
  have hζ_def : NumberField.dedekindZeta K = LSeries (fun n => (a_K n : ℂ)) := rfl
  let G : ℝ → ℂ := fun t => (t : ℂ) ^ s * (W t : ℂ)
  let G_re : ℝ → ℝ := fun t => t ^ s.re * W t
  have hW_c_meas : MeasureTheory.AEStronglyMeasurable (fun t : ℝ => (W t : ℂ))
