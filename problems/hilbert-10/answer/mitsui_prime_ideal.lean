            rw [← h_sum_real]
            push_cast
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl (fun w _ => by ring)
    have h_exp_W :
        f_W I_x *
          Complex.exp
            (((∑ j : Fin r,
                y j * (-2 * Real.pi * (m_freq j : ℝ) + A_arg j)) : ℝ) * Complex.I) =
        Complex.exp
          (((∑ j : Fin r, y j * A_arg j) : ℝ) * Complex.I) := by
      dsimp [f_W]
      rw [← Complex.exp_add]
      have h_arg :
          (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℂ) * (Φ_W I_x j : ℂ)) +
            (((∑ j : Fin r,
                y j * (-2 * Real.pi * (m_freq j : ℝ) + A_arg j)) : ℝ) * Complex.I) =
          (((∑ j : Fin r, y j * A_arg j) : ℝ) * Complex.I) +
          ((-(∑ j : Fin r, m_freq j * d j) : ℤ) : ℂ) * (2 * Real.pi * Complex.I) := by
        have h_sum_split :
            (∑ j : Fin r,
              (y j : ℂ) * (-2 * (Real.pi : ℂ) * (m_freq j : ℂ) + (A_arg j : ℂ))) =
            (∑ j : Fin r, (y j : ℂ) * (A_arg j : ℂ)) -
            2 * (Real.pi : ℂ) * (∑ j : Fin r, (m_freq j : ℂ) * (Φ_W I_x j : ℂ)) -
            2 * (Real.pi : ℂ) * (∑ j : Fin r, (m_freq j : ℂ) * (d j : ℂ)) := by
          rw [Finset.mul_sum, Finset.mul_sum,
            ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          dsimp [y]
