    calc ‖F s‖
        = ‖F₁ z + F s₀‖ := by rw [h_Fs_eq]
      _ ≤ ‖F₁ z‖ + ‖F s₀‖ := norm_add_le _ _
      _ ≤ 2 * A₁ + ‖F s₀‖ := by linarith
      _ = 2 * M_re + 3 * ‖F s₀‖ + ε := by dsimp [A₁]; ring
  obtain ⟨M₀, hM₀_pos, h_rhp_LSeries⟩ := mitsui_ray_char_LSeries_norm_le_of_one_lt_re (K := K)
  obtain ⟨B₀, A₀, hB₀_pos, hB₀_le, hA₀_pos, h_hecke⟩ :=
    mitsui_grossenchar_heckeL_zeroFree_and_re_logDeriv_bound (K := K) A hA
  let M₁ : ℝ := (4 * M₀) / B₀
  have hM₁_pos : 0 < M₁ := by dsimp [M₁]; positivity
  let B : ℝ := B₀ / 8
  let C : ℝ := 4 * A₀ + 3 * M₁
  have hB_pos : 0 < B := by dsimp [B]; positivity
  have hB_le : B ≤ 1 / 2 := by dsimp [B]; linarith
  have hC_pos : 0 < C := by dsimp [C]; positivity
  have hlog4_gt_one : 1 < Real.log 4 := by
    rw [← Real.log_exp 1]
    exact Real.log_lt_log (Real.exp_pos 1) (by linarith [Real.exp_one_lt_d9])
  have h_log_ge_one : ∀ t : ℝ, 1 ≤ Real.log (4 + |t|) := by
    intro t
    have ht : 4 ≤ 4 + |t| := by linarith [abs_nonneg t]
    exact le_trans (le_of_lt hlog4_gt_one) (Real.log_le_log (by norm_num) ht)
  refine ⟨B, C, hB_pos, hB_le, hC_pos, ?_⟩
  intro q hq w₀ a₀ ha₀_lt θ₀ hθ₀_bdd m_freq l_ang h_tors h_nonprin M hM hq_M hm_M hl_M χ_gr hχ_gr_norm_supp hχ_gr_prin
  have hχ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ_gr I‖ ≤ 1 := by
    intro I
    by_cases hI : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤
    · rw [(hχ_gr_norm_supp I).1 hI]
    · rw [(hχ_gr_norm_supp I).2 hI, norm_zero]
      linarith
  obtain ⟨g_χ, hg_diff, hg_eq, hg_dlvp⟩ :=
    h_hecke q hq w₀ a₀ ha₀_lt θ₀ hθ₀_bdd m_freq l_ang h_tors h_nonprin M hM hq_M hm_M hl_M χ_gr hχ_gr_norm_supp hχ_gr_prin
  let D : ℂ → ℂ := fun s => -deriv g_χ s / g_χ s
  have h_deriv_diff : Differentiable ℂ (deriv g_χ) := by
    rw [← differentiableOn_univ]
    exact hg_diff.differentiableOn.deriv isOpen_univ
  have hD_diff_of_ne : ∀ s : ℂ, g_χ s ≠ 0 → DifferentiableAt ℂ D s := by
    intro s h_ne
    dsimp [D]
    exact (h_deriv_diff s).neg.div (hg_diff s) h_ne
  have hD_eq : ∀ s : ℂ, 1 < s.re →
      D s = LSeries (fun n =>
        ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
          (χ_gr ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
            (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)) s := by
    intro s hs
    obtain ⟨_, hΛ_eq⟩ := mitsui_ray_char_LSeries_primePowers_eq_neg_logDeriv χ_gr hχ_norm s hs
    have hU_mem : {w : ℂ | 1 < w.re} ∈ nhds s :=
      (isOpen_lt continuous_const Complex.continuous_re).mem_nhds hs
    have h_ev_g : g_χ =ᶠ[nhds s] LSeries (fun n =>
        ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
          χ_gr ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) := by
      filter_upwards [hU_mem] with w hw
      exact hg_eq w hw
    dsimp [D]
    rw [h_ev_g.deriv_eq, hg_eq s hs, ← hΛ_eq]
  let σ₀ : ℝ → ℝ := fun t => 1 + B₀ / (4 * (M + Real.log (4 + |t|)))
  have h_rhp_bound : ∀ s : ℂ, σ₀ s.im ≤ s.re →
      ‖D s‖ ≤ M₁ * (M + Real.log (4 + |s.im|)) := by
    intro s hs_re
    set t : ℝ := s.im
    set L_M : ℝ := M + Real.log (4 + |t|)
    have hL_ge_one : 1 ≤ Real.log (4 + |t|) := h_log_ge_one t
    have hLM_ge_two : 2 ≤ L_M := by dsimp [L_M]; linarith
    have hLM_pos : 0 < L_M := by linarith
    have hσ₀_gt_one : 1 < σ₀ t := by
      dsimp [σ₀]
      have : 0 < B₀ / (4 * L_M) := by positivity
      linarith
    have hσ₀_le_two : σ₀ t ≤ 2 := by
      dsimp [σ₀]
      have h1 : B₀ ≤ 4 * L_M := by linarith
      have h2 : B₀ / (4 * L_M) ≤ 1 := (div_le_one (by positivity)).mpr h1
      linarith
    have hs_gt_one : 1 < s.re := lt_of_lt_of_le hσ₀_gt_one hs_re
    rw [hD_eq s hs_gt_one]
    have h_bound := h_rhp_LSeries χ_gr hχ_norm s (σ₀ t) hσ₀_gt_one hσ₀_le_two hs_re
    have h_eq : M₀ / (σ₀ t - 1) = M₁ * L_M := by
      dsimp [σ₀, M₁]
      have h_sub : 1 + B₀ / (4 * L_M) - 1 = B₀ / (4 * L_M) := by ring
      rw [h_sub]
      field_simp [ne_of_gt hB₀_pos, ne_of_gt hLM_pos]
    linarith
  refine ⟨D, hD_eq, ?_⟩
  intro s hs
  set t : ℝ := s.im
  set L : ℝ := Real.log (4 + |t|)
  set L_M : ℝ := M + L
  have hL_ge_one : 1 ≤ L := h_log_ge_one t
  have hLM_ge_two : 2 ≤ L_M := by dsimp [L_M]; linarith
  have hLM_pos : 0 < L_M := by linarith
  have hs_B₀ : 1 - B₀ / L_M ≤ s.re := by
    have hB_le_B₀ : B ≤ B₀ := by dsimp [B]; linarith
    have h_div : B / L_M ≤ B₀ / L_M := div_le_div_of_nonneg_right hB_le_B₀ (le_of_lt hLM_pos)
    linarith
  have hD_diff_s : DifferentiableAt ℂ D s := hD_diff_of_ne s (hg_dlvp s hs_B₀).1
  refine ⟨hD_diff_s, ?_⟩
  rcases le_or_gt (σ₀ t) s.re with hs_rhp | hs_collar
  · have h1 : ‖D s‖ ≤ M₁ * L_M := h_rhp_bound s hs_rhp
    have hM₁_le_C : M₁ ≤ C := by dsimp [C]; linarith
    calc ‖D s‖
        ≤ M₁ * L_M := h1
      _ ≤ C * L_M := mul_le_mul_of_nonneg_right hM₁_le_C (le_of_lt hLM_pos)
  · let s₀ : ℂ := (σ₀ t : ℂ) + (t : ℂ) * Complex.I
    let R : ℝ := (3 * B₀) / (4 * L_M)
    have hR_pos : 0 < R := by dsimp [R]; positivity
    have hR_le_half : R ≤ 1 / 2 := by
      dsimp [R]
      have h1 : 3 * B₀ ≤ 2 * L_M := by linarith
      rw [div_le_iff₀ (by positivity)]
      linarith
    have hs₀_re : s₀.re = σ₀ t := by simp [s₀]
    have hs₀_im : s₀.im = t := by simp [s₀]
    have h_ball_dlvp : ∀ w ∈ Metric.closedBall s₀ R,
        DifferentiableAt ℂ D w ∧ (D w).re ≤ (2 * A₀) * L_M := by
      intro w hw
      have hw_norm : ‖w - s₀‖ ≤ R := by simpa [Metric.mem_closedBall, dist_eq_norm] using hw
      have hw_im_diff : |w.im - t| ≤ R := by
        have h1 : |w.im - s₀.im| ≤ ‖w - s₀‖ := by
          rw [← Complex.sub_im]
          exact Complex.abs_im_le_norm (w - s₀)
        rw [hs₀_im] at h1
        exact le_trans h1 hw_norm
      have hw_im_le : |w.im| ≤ |t| + 1 / 2 := by
        have h1 : |w.im| - |t| ≤ |w.im - t| := abs_sub_abs_le_abs_sub w.im t
        linarith
      have h_sq_ge : 4 + |w.im| ≤ (4 + |t|) ^ 2 := by
        have ht_nn : 0 ≤ |t| := abs_nonneg t
        nlinarith
      have h_log_w_le : Real.log (4 + |w.im|) ≤ 2 * L := by
        have h1 : Real.log (4 + |w.im|) ≤ Real.log ((4 + |t|) ^ 2) :=
          Real.log_le_log (by positivity) h_sq_ge
        rw [Real.log_pow] at h1
        push_cast at h1
        dsimp [L]; linarith
      have h_LM_w_le : M + Real.log (4 + |w.im|) ≤ 2 * L_M := by
        dsimp [L_M]; linarith
      have h_LM_w_pos : 0 < M + Real.log (4 + |w.im|) := by
        have := h_log_ge_one w.im
        linarith
      have hw_re_ge : 1 - B₀ / (2 * L_M) ≤ w.re := by
        have h1 : s₀.re - w.re ≤ ‖w - s₀‖ := by
          have h2 : -(w - s₀).re ≤ ‖w - s₀‖ :=
            le_trans (neg_le_abs _) (Complex.abs_re_le_norm (w - s₀))
          simpa using h2
        rw [hs₀_re] at h1
        dsimp [σ₀, R] at h1 hw_norm
        have h_eq : 1 + B₀ / (4 * L_M) - (3 * B₀) / (4 * L_M) = 1 - B₀ / (2 * L_M) := by ring
        linarith
      have hw_dlvp_cond : 1 - B₀ / (M + Real.log (4 + |w.im|)) ≤ w.re := by
        have h_div : B₀ / (2 * L_M) ≤ B₀ / (M + Real.log (4 + |w.im|)) :=
          div_le_div_of_nonneg_left (le_of_lt hB₀_pos) h_LM_w_pos h_LM_w_le
        linarith
      obtain ⟨hw_ne, hw_re_bound⟩ := hg_dlvp w hw_dlvp_cond
      refine ⟨hD_diff_of_ne w hw_ne, ?_⟩
      dsimp [D]
      calc (-deriv g_χ w / g_χ w).re
          ≤ A₀ * (M + Real.log (4 + |w.im|)) := hw_re_bound
        _ ≤ A₀ * (2 * L_M) := mul_le_mul_of_nonneg_left h_LM_w_le (le_of_lt hA₀_pos)
        _ = (2 * A₀) * L_M := by ring
    have hs_in_half : s ∈ Metric.closedBall s₀ (R / 2) := by
      rw [Metric.mem_closedBall, dist_eq_norm]
      have h_diff_eq : s - s₀ = ((s.re - σ₀ t : ℝ) : ℂ) := by
        apply Complex.ext
        · simp [s₀]
        · simp [s₀, t]
      rw [h_diff_eq, Complex.norm_real, Real.norm_eq_abs, abs_of_neg (by linarith)]
      dsimp [σ₀, R, B] at hs ⊢
      have h_alg : -(s.re - (1 + B₀ / (4 * L_M))) = 1 - s.re + B₀ / (4 * L_M) := by ring
      have h_R2 : (3 * B₀) / (4 * L_M) / 2 = B₀ / 8 / L_M + B₀ / (4 * L_M) := by ring
      linarith
    have h_bc_s := h_bc D s₀ R ((2 * A₀) * L_M) hR_pos (by positivity)
      (fun w hw => (h_ball_dlvp w hw).1) (fun w hw => (h_ball_dlvp w hw).2) s hs_in_half
    have hs₀_rhp : σ₀ s₀.im ≤ s₀.re := by
      rw [hs₀_re, hs₀_im]
    have hD_s₀_le : ‖D s₀‖ ≤ M₁ * L_M := by
      have h1 : ‖D s₀‖ ≤ M₁ * (M + Real.log (4 + |s₀.im|)) := h_rhp_bound s₀ hs₀_rhp
      rwa [hs₀_im] at h1
    calc ‖D s‖
        ≤ 2 * ((2 * A₀) * L_M) + 3 * ‖D s₀‖ := h_bc_s
      _ ≤ 2 * ((2 * A₀) * L_M) + 3 * (M₁ * L_M) := by linarith
      _ = C * L_M := by dsimp [C]; ring

theorem mitsui_riesz_poleFree_conductor_vertical_integrable (B C M : ℝ) (D : ℂ → ℂ) (hB_pos : 0 < B) (hB_le : B ≤ 1 / 2) (hC_pos : 0 < C) (hM : 1 ≤ M)
    (hD_dlvp : ∀ s : ℂ, 1 - B / (M + Real.log (4 + |s.im|)) ≤ s.re →
      DifferentiableAt ℂ D s ∧
      ‖D s‖ ≤ C * (M + Real.log (4 + |s.im|)))
    (Y : ℝ) (hY : 1 < Y) :
    MeasureTheory.Integrable
      (fun t : ℝ =>
        ((Y : ℂ) ^ (2 + (t : ℂ) * Complex.I) / (2 + (t : ℂ) * Complex.I) ^ 2) *
          D (2 + (t : ℂ) * Complex.I))
      MeasureTheory.volume :=
by
  have hY_pos : 0 < Y := by linarith
  have hY_ne : (Y : ℂ) ≠ 0 := by exact_mod_cast ne_of_gt hY_pos
  set s : ℝ → ℂ := fun t => 2 + (t : ℂ) * Complex.I
  set K : ℝ → ℂ := fun t => (Y : ℂ) ^ (s t) / (s t) ^ 2
  set F_D : ℝ → ℂ := fun t => K t * D (s t)
  have hs_re : ∀ t : ℝ, (s t).re = 2 := by
    intro t
    simp [s]
  have hs_im : ∀ t : ℝ, (s t).im = t := by
    intro t
    simp [s]
  have hs_normSq : ∀ t : ℝ, Complex.normSq (s t) = 4 + t ^ 2 := by
    intro t
    rw [Complex.normSq_apply, hs_re t, hs_im t]
    ring
  have hs_sq_norm : ∀ t : ℝ, ‖(s t) ^ 2‖ = 4 + t ^ 2 := by
    intro t
    rw [norm_pow, Complex.sq_norm, hs_normSq t]
  have hs_sq_ne : ∀ t : ℝ, (s t) ^ 2 ≠ 0 := by
    intro t
    rw [← norm_ne_zero_iff, hs_sq_norm t]
    positivity
  have hK_norm : ∀ t : ℝ, ‖K t‖ = Y ^ 2 / (4 + t ^ 2) := by
    intro t
    dsimp [K]
    rw [norm_div, Complex.norm_cpow_eq_rpow_re_of_pos hY_pos (s t), hs_re t,
      Real.rpow_two, hs_sq_norm t]
  have hs_cont : Continuous s := by
    dsimp [s]
    fun_prop
  have hK_cont : Continuous K := by
    have h_cpow_eq : (fun t : ℝ => (Y : ℂ) ^ (s t)) =
        (fun t : ℝ => Complex.exp (Complex.log (Y : ℂ) * s t)) := by
      ext t
      rw [Complex.cpow_def_of_ne_zero hY_ne]
    have h_cpow_cont : Continuous (fun t : ℝ => (Y : ℂ) ^ (s t)) := by
      rw [h_cpow_eq]
      exact Continuous.cexp (continuous_const.mul hs_cont)
    exact h_cpow_cont.div (hs_cont.pow 2) hs_sq_ne
  set g : ℝ → ℝ := fun t => (4 + |t|) ^ (-3 / 2 : ℝ)
  have hg_Ioi : MeasureTheory.IntegrableOn g (Set.Ioi (0 : ℝ)) MeasureTheory.volume := by
    have h0 : MeasureTheory.IntegrableOn (fun x : ℝ => (x + 4) ^ (-3 / 2 : ℝ)) (Set.Ioi (0 : ℝ)) MeasureTheory.volume :=
      integrableOn_add_rpow_Ioi_of_lt (by norm_num) (by norm_num)
    refine h0.congr_fun (fun x hx => ?_) measurableSet_Ioi
    have hx_pos : 0 < x := Set.mem_Ioi.mp hx
    dsimp [g]
    rw [abs_of_pos hx_pos, add_comm]
  have hg_Ici : MeasureTheory.IntegrableOn g (Set.Ici (0 : ℝ)) MeasureTheory.volume :=
    hg_Ioi.congr_set_ae MeasureTheory.Ioi_ae_eq_Ici.symm
  have hg_Iic : MeasureTheory.IntegrableOn g (Set.Iic (0 : ℝ)) MeasureTheory.volume := by
    have h_neg : MeasureTheory.IntegrableOn (fun x : ℝ => g (-x)) (Set.Iic (0 : ℝ)) MeasureTheory.volume := by
      have h_Ici_neg : MeasureTheory.IntegrableOn g (Set.Ici (-(0 : ℝ))) MeasureTheory.volume := by
        simpa using hg_Ici
      exact h_Ici_neg.comp_neg_Iic
    have h_eq : (fun x : ℝ => g (-x)) = g := by
      ext x
      dsimp [g]
      rw [abs_neg]
    rwa [h_eq] at h_neg
  have hg_int : MeasureTheory.Integrable g MeasureTheory.volume := by
    rw [← MeasureTheory.integrableOn_univ, ← Set.Iic_union_Ioi (a := (0 : ℝ))]
    exact hg_Iic.union hg_Ioi
  have hs_dlvp_cond : ∀ t : ℝ, 1 - B / (M + Real.log (4 + |(s t).im|)) ≤ (s t).re := by
    intro t
    rw [hs_re t, hs_im t]
    have h4_gt_one : 1 < 4 + |t| := by
      have : 0 ≤ |t| := abs_nonneg t
      linarith
    have hlog_pos : 0 < Real.log (4 + |t|) := Real.log_pos h4_gt_one
    have hM_log_pos : 0 < M + Real.log (4 + |t|) := by linarith
    have hdiv_pos : 0 < B / (M + Real.log (4 + |t|)) := div_pos hB_pos hM_log_pos
    linarith
  have hD_cont : Continuous (fun t : ℝ => D (s t)) := by
    rw [continuous_iff_continuousAt]
    intro t
    have h_diff : DifferentiableAt ℂ D (s t) := (hD_dlvp (s t) (hs_dlvp_cond t)).1
    exact h_diff.continuousAt.comp hs_cont.continuousAt
  have hF_D_cont : Continuous F_D := hK_cont.mul hD_cont
  have hF_D_bound : ∀ t : ℝ, ‖F_D t‖ ≤ (10 * Y ^ 2 * C * (M + 1)) * g t := by
    intro t
    dsimp [F_D, g]
    rw [norm_mul, hK_norm t]
    have h4t_pos : 0 < 4 + |t| := by positivity
    set L : ℝ := Real.log (4 + |t|)
    have h1_le_L : 1 ≤ L := by
      have hexp1 : Real.exp 1 ≤ 4 + |t| := by
        have h_e := Real.exp_one_lt_d9
        have h_abs : 0 ≤ |t| := abs_nonneg t
        linarith
      have hlog := Real.log_le_log (Real.exp_pos 1) hexp1
      rwa [Real.log_exp] at hlog
    have hM_le_ML : M ≤ M * L := le_mul_of_one_le_right (by linarith) h1_le_L
    have hML_le : M + L ≤ (M + 1) * L := by linarith
    have hD_norm : ‖D (s t)‖ ≤ (C * (M + 1)) * L := by
      have h := (hD_dlvp (s t) (hs_dlvp_cond t)).2
      rw [hs_im t] at h
      calc ‖D (s t)‖
        _ ≤ C * (M + L) := h
        _ ≤ C * ((M + 1) * L) := mul_le_mul_of_nonneg_left hML_le (le_of_lt hC_pos)
        _ = (C * (M + 1)) * L := by ring
    have hexpL : Real.exp L = 4 + |t| := Real.exp_log h4t_pos
    have h_L_le : L ≤ 2 * Real.exp (L / 2) := by
      have h1 := Real.add_one_le_exp (L / 2)
      linarith
    have h_quad : (4 + |t|) ^ 2 ≤ 5 * (4 + t ^ 2) := by
      have h_nonneg : 0 ≤ 4 * (|t| - 1) ^ 2 := by positivity
      have h_id : 5 * (4 + t ^ 2) - (4 + |t|) ^ 2 = 4 * (|t| - 1) ^ 2 := by
        have h_sq : t ^ 2 = |t| ^ 2 := (sq_abs t).symm
        rw [h_sq]
        ring
      linarith
    have h_denom_pos : 0 < 4 + t ^ 2 := by positivity
    have h_inv_le : (4 + t ^ 2)⁻¹ ≤ 5 * Real.exp (-2 * L) := by
      have h_exp2L : (4 + |t|) ^ 2 = Real.exp (2 * L) := by
        rw [← hexpL, sq, ← Real.exp_add]
        congr 1
        ring
      have h_neg : Real.exp (-2 * L) = ((4 + |t|) ^ 2)⁻¹ := by
        rw [h_exp2L, show -2 * L = -(2 * L) by ring, Real.exp_neg]
      rw [h_neg, ← div_eq_mul_inv, inv_eq_one_div, div_le_div_iff₀ h_denom_pos (by positivity)]
      linarith
    have h_ratio_le : L / (4 + t ^ 2) ≤ 10 * (4 + |t|) ^ (-3 / 2 : ℝ) := by
      have h_rpow : (4 + |t|) ^ (-3 / 2 : ℝ) = Real.exp (L / 2) * Real.exp (-2 * L) := by
        rw [Real.rpow_def_of_pos h4t_pos, ← Real.exp_add]
        congr 1
        dsimp [L]
        ring
      calc L / (4 + t ^ 2)
        _ = L * (4 + t ^ 2)⁻¹ := div_eq_mul_inv _ _
        _ ≤ (2 * Real.exp (L / 2)) * (5 * Real.exp (-2 * L)) :=
            mul_le_mul h_L_le h_inv_le (by positivity) (by positivity)
        _ = 10 * (Real.exp (L / 2) * Real.exp (-2 * L)) := by ring
        _ = 10 * (4 + |t|) ^ (-3 / 2 : ℝ) := by rw [← h_rpow]
    calc (Y ^ 2 / (4 + t ^ 2)) * ‖D (s t)‖
      _ ≤ (Y ^ 2 / (4 + t ^ 2)) * ((C * (M + 1)) * L) :=
          mul_le_mul_of_nonneg_left hD_norm (by positivity)
      _ = (Y ^ 2 * C * (M + 1)) * (L / (4 + t ^ 2)) := by ring
      _ ≤ (Y ^ 2 * C * (M + 1)) * (10 * (4 + |t|) ^ (-3 / 2 : ℝ)) :=
          mul_le_mul_of_nonneg_left h_ratio_le (by positivity)
      _ = (10 * Y ^ 2 * C * (M + 1)) * (4 + |t|) ^ (-3 / 2 : ℝ) := by ring
  exact MeasureTheory.Integrable.mono'
    (hg_int.const_mul (10 * Y ^ 2 * C * (M + 1)))
    hF_D_cont.aestronglyMeasurable
    (Filter.Eventually.of_forall hF_D_bound)

theorem mitsui_riesz_poleFree_conductor_boundary_integrable (B M : ℝ) (hB_pos : 0 < B) (hM : 1 ≤ M) (Y : ℝ) (hY : 1 < Y) :
    MeasureTheory.Integrable
      (fun t : ℝ =>
        Y ^ (1 - B / (M + Real.log (4 + |t|))) *
          ((M + Real.log (4 + |t|)) / (1 / 4 + t ^ 2)))
      MeasureTheory.volume :=
by
  have hY_pos : 0 < Y := by linarith
  set f : ℝ → ℝ := fun t =>
