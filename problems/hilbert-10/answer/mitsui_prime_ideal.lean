    (hH_sphere : ∀ s ∈ Metric.sphere (2 : ℂ) (3 / 2), ‖H s‖ ≤ M)
    (hα₁_ge : 9 / 10 ≤ α₁)
    (hα₁_lt : α₁ < 1)
