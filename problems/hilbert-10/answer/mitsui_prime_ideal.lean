  let term_ge1 : D_ge1 → ℂ := fun pm =>
    (M_cell (pm.1.1.asIdeal ^ pm.1.2) : ℂ) *
      (ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
        (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ))
  have h_term_e_one : ∀ p : D_1, term_1 p = term_ge1 (e_one p).1 := by
    intro p
    dsimp [term_1, term_ge1, e_one]
    have hM : M_cell (p.1.asIdeal ^ 1) = M_cell p.1.asIdeal := by rw [pow_one]
    have hU : p.2.choose_spec.2.unit = (e_one p).1.2.2.choose_spec.2.unit := by
      apply Units.ext
