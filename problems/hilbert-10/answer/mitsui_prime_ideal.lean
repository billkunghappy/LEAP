    congr 1
    refine MeasureTheory.setIntegral_congr_fun hCube_meas (fun y _ => ?_)
    exact Equiv.tsum_eq e_J (fun x => F x.1 y)
  
  rcases hψ_zero with ⟨_, hψ0, _⟩ | ⟨_, hψ_all, h_sum_star, h_sum_chi⟩
  · 
    refine ⟨?_, ?_⟩
    · refine Finset.sum_congr rfl (fun C _ => ?_)
      congr 1
      refine congrArg (fun g : (Fin r → ℝ) → ℂ => ∫ y in Cube, g y) (funext (fun y => ?_))
