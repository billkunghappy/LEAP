    have hs_sub_pos : 0 < s.re - 1 := by linarith
    have hs_ne : s ≠ 0 := by
      intro h; rw [h] at hs; simp at hs; linarith
    have hs_sub_ne : s - 1 ≠ 0 := by
      intro h
      have hre : (s - 1).re = 0 := by rw [h]; simp
      simp at hre
      linarith
    let g : ℝ → ℂ := fun t => (t : ℂ) ^ (s - 1) * ((t⁻¹ + Real.log t - 1 : ℝ) : ℂ)
    have hf_Ioc : ∀ t ∈ Set.Ioc (0 : ℝ) 1, (t : ℂ) ^ (s - 1) • f_pole t = g t := by
      intro t ht
      dsimp [f_pole, g]
      rw [if_pos ht]
    have hf_Ioi : ∀ t ∈ Set.Ioi (1 : ℝ), (t : ℂ) ^ (s - 1) • f_pole t = 0 := by
      intro t ht
      dsimp [f_pole]
      have hnot : t ∉ Set.Ioc (0 : ℝ) 1 := by
