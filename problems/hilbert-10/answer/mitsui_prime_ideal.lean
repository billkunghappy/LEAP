          rwa [hχ_one, one_mul, hA_one] at h1
        obtain ⟨k, hk⟩ := Complex.exp_eq_one_iff.mp hE_one
        have hk' : (((∑ w : NumberField.InfinitePlace K,
            v_place w * Real.log (w (u_i : K))) : ℝ) : ℂ) * Complex.I =
            ((2 * Real.pi * (k : ℝ) : ℝ) : ℂ) * Complex.I := by
          calc (((∑ w : NumberField.InfinitePlace K,
              v_place w * Real.log (w (u_i : K))) : ℝ) : ℂ) * Complex.I
            _ = ↑k * (2 * ↑Real.pi * Complex.I) := hk
            _ = ((2 * Real.pi * (k : ℝ) : ℝ) : ℂ) * Complex.I := by
                push_cast
                ring
        have hk_eq : (∑ w : NumberField.InfinitePlace K,
            v_place w * Real.log (w (u_i : K))) = 2 * Real.pi * (k : ℝ) :=
          Complex.ofReal_injective (mul_right_cancel₀ Complex.I_ne_zero hk')
        refine ⟨i, k, ?_, hk_eq⟩
        intro hk_zero
        apply hi_ne
        rw [hk_eq, hk_zero, Int.cast_zero, mul_zero]
      · exfalso
        have hnot_real : ¬ w.IsReal := NumberField.InfinitePlace.not_isReal_iff_isComplex.mpr hw_c
        have h1 : l_eff w = l_ang w := by
          dsimp [l_eff]
