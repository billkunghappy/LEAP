      (c * Real.exp 1 + 2 * c + c * Real.exp (1 / c) + 2) * Y * δ ^ 2 := by
    have h_ident : (Ψ₁_K (Real.exp δ * Y) - Ψ₁_K Y) - (Ψ₁_K Y - Ψ₁_K (Real.exp (-δ) * Y)) =
        (Ψ₁_K (Real.exp δ * Y) - Real.exp δ * Y) - 2 * (Ψ₁_K Y - Y) +
        (Ψ₁_K (Real.exp (-δ) * Y) - Real.exp (-δ) * Y) +
        (Real.exp δ - 1 - δ) * Y + (Real.exp (-δ) - 1 + δ) * Y := by ring
    linarith
  have h_norm_δ_ψ : δ * ‖ψ_cl Y‖ ≤
      ‖Ψ₁_cl (Real.exp δ * Y)‖ + ‖Ψ₁_cl Y‖ +
      ‖(Ψ₁_cl (Real.exp δ * Y) - Ψ₁_cl Y) - (δ : ℂ) * ψ_cl Y‖ := by
    have h_eq : (δ : ℂ) * ψ_cl Y =
        (Ψ₁_cl (Real.exp δ * Y) - Ψ₁_cl Y) -
        ((Ψ₁_cl (Real.exp δ * Y) - Ψ₁_cl Y) - (δ : ℂ) * ψ_cl Y) := by ring
    have h_norm_eq : δ * ‖ψ_cl Y‖ =
        ‖(Ψ₁_cl (Real.exp δ * Y) - Ψ₁_cl Y) -
          ((Ψ₁_cl (Real.exp δ * Y) - Ψ₁_cl Y) - (δ : ℂ) * ψ_cl Y)‖ := by
      rw [← h_eq, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hδ_pos]
    have ht1 := norm_sub_le (Ψ₁_cl (Real.exp δ * Y) - Ψ₁_cl Y)
      ((Ψ₁_cl (Real.exp δ * Y) - Ψ₁_cl Y) - (δ : ℂ) * ψ_cl Y)
    have ht2 := norm_sub_le (Ψ₁_cl (Real.exp δ * Y)) (Ψ₁_cl Y)
    linarith
  have h_δ_ψ_le_c2 : δ * ‖ψ_cl Y‖ ≤ c₂ * Y * δ ^ 2 := by
    have h_c2_ge : 2 * c * Real.exp 1 + 3 * c + c * Real.exp (1 / c) + 2 ≤ c₂ := by
      have : 0 ≤ 2 * c := by positivity
      dsimp [c₂]; linarith
    have hYδ2_nonneg : 0 ≤ Y * δ ^ 2 := by positivity
    have h_bound : (2 * c * Real.exp 1 + 3 * c + c * Real.exp (1 / c) + 2) * (Y * δ ^ 2) ≤
        c₂ * Y * δ ^ 2 := by
      calc (2 * c * Real.exp 1 + 3 * c + c * Real.exp (1 / c) + 2) * (Y * δ ^ 2)
        _ ≤ c₂ * (Y * δ ^ 2) := mul_le_mul_of_nonneg_right h_c2_ge hYδ2_nonneg
        _ = c₂ * Y * δ ^ 2 := by ring
    linarith
  have h_ψ_le_δ : ‖ψ_cl Y‖ ≤ c₂ * Y * δ := by
    apply le_of_mul_le_mul_left _ hδ_pos
    calc δ * ‖ψ_cl Y‖ ≤ c₂ * Y * δ ^ 2 := h_δ_ψ_le_c2
      _ = δ * (c₂ * Y * δ) := by ring
  have h_δ_le_final : δ ≤ Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    dsimp [δ]
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    have h1 : Real.sqrt (Real.log X) / c₂ ≤ Real.sqrt (Real.log Y) / c₂ :=
      div_le_div_of_nonneg_right hsqrtX_le_sqrtY (le_of_lt hc₂_pos)
    have h2c_le_c2 : 2 * c ≤ c₂ := by
      have : 0 ≤ 2 * c * Real.exp 1 + 3 * c + c * Real.exp (1 / c) + 2 := by positivity
      dsimp [c₂]; linarith
    have h2 : Real.sqrt (Real.log Y) / c₂ ≤ Real.sqrt (Real.log Y) / (2 * c) :=
      div_le_div_of_nonneg_left (Real.sqrt_nonneg _) (by positivity) h2c_le_c2
    linarith
  calc ‖ψ_cl Y‖ ≤ c₂ * Y * δ := h_ψ_le_δ
    _ ≤ c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
        mul_le_mul_of_nonneg_left h_δ_le_final (by positivity)

theorem mitsui_chebyshev_principal_to_all_primeIdeals {K : Type u} [Field K] [NumberField K] :
    ∃ c₃ : ℝ, 0 < c₃ ∧
      ∀ X : ℝ, 1 < X →
        |(∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
              p.asIdeal.IsPrincipal ∧
              (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K)},
            Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal))
          - ((NumberField.classNumber K : ℝ))⁻¹ *
            (∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
                (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K)},
              Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal))|
          ≤ c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃) :=
by
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_higher_primePower_chebyshev_bound (K := K)
  obtain ⟨c₂, hc₂_pos, hc₂⟩ := mitsui_primePower_classGroup_char_bound (K := K)
  let c₃ : ℝ := c₁ + c₂
  have hc₃_pos : 0 < c₃ := by dsimp [c₃]; linarith
  refine ⟨c₃, hc₃_pos, ?_⟩
  intro X hX
  set Y : ℝ := X ^ (Module.finrank ℚ K)
  set B : ℝ := c₃ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃)
  have hX_pos : 0 < X := by linarith
  have hY_nonneg : 0 ≤ Y := by dsimp [Y]; positivity
  have hB_nonneg : 0 ≤ B := by dsimp [B]; positivity
  apply mitsui_chebyshev_principal_of_classGroup_char_bound Y B hB_nonneg
  intro χ hχ
  set S₁ : ℂ := ∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
        (Ideal.absNorm p.asIdeal : ℝ) ≤ Y},
      χ (Additive.ofMul (ClassGroup.mk0 ⟨p.1.asIdeal, mem_nonZeroDivisors_of_ne_zero p.1.ne_bot⟩)) *
        (Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal) : ℂ)
  set S₂ : ℂ := ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
      (χ (Additive.ofMul (ClassGroup.mk0 ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩))) ^ pm.1.2 *
        (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)
  have h_tri : ‖S₁‖ ≤ ‖S₁ - S₂‖ + ‖S₂‖ := norm_le_norm_sub_add S₁ S₂
  have h_sub : ‖S₁ - S₂‖ ≤ c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) :=
    le_trans (mitsui_chebyshev_char_sub_primePower_le Y χ) (hc₁ X hX)
  have h_main : ‖S₂‖ ≤ c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
    hc₂ X hX χ hχ
  have hsqrt_nonneg : 0 ≤ Real.sqrt (Real.log X) := Real.sqrt_nonneg _
  have hexp₁ : Real.exp (-Real.sqrt (Real.log X) / c₁) ≤ Real.exp (-Real.sqrt (Real.log X) / c₃) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₁_pos (by dsimp [c₃]; linarith)
  have hexp₂ : Real.exp (-Real.sqrt (Real.log X) / c₂) ≤ Real.exp (-Real.sqrt (Real.log X) / c₃) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₂_pos (by dsimp [c₃]; linarith)
  have hterm₁ : c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) ≤
      c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃) :=
    mul_le_mul_of_nonneg_left hexp₁ (by positivity)
  have hterm₂ : c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) ≤
      c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃) :=
    mul_le_mul_of_nonneg_left hexp₂ (by positivity)
  have hsum :
      c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃) +
      c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃) = B := by
    dsimp [B, c₃]
    ring
  linarith

theorem mitsui_principalPrimeIdeals_place_sector_bound_of_rank_pos {K : Type u} [Field K] [NumberField K]
    (h_rank : 0 < NumberField.Units.rank K) :
    ∃ c₃₁ : ℝ, 0 < c₃₁ ∧
      ∀ X : ℝ, 1 < X →
        ∀ w₀ : NumberField.InfinitePlace K,
          |(∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
                p.asIdeal.IsPrincipal ∧
                (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K)},
              (Nat.card {π : NumberField.RingOfIntegers K //
                  Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧
                  (∀ w : NumberField.InfinitePlace K,
                    1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
                  w₀ (π : K) < X} : ℝ) *
                Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal))
            - ((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) *
              (NumberField.Units.regulator K)⁻¹ *
              ((NumberField.Units.torsionOrder K : ℝ) *
                (∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
                      p.asIdeal.IsPrincipal ∧
                      (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K)},
                    Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal)))|
            ≤ c₃₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃₁) :=
by
  classical
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_prime_box_to_ge_one (K := K)
  obtain ⟨c_shell, hc_shell_pos, hc_shell⟩ := mitsui_prime_box_shell_diff_bound (K := K)
  obtain ⟨c_cell, hc_cell_pos, hc_cell⟩ :=
    mitsui_principalPrimeIdeals_decoupled_log_cell_bound_of_rank_pos (K := K) h_rank
  obtain ⟨c_sum, hc_sum_pos, hc_sum⟩ := mitsui_place_sector_cell_main_term_sum_bound (K := K)
  obtain ⟨c₄, hc₄_pos, hc₄⟩ := mitsui_chebyshev_primeIdeals_asymptotic (K := K)
  obtain ⟨c₃, hc₃_pos, hc₃⟩ := mitsui_chebyshev_principal_to_all_primeIdeals (K := K)
  set M : ℕ := Fintype.card (NumberField.InfinitePlace K)
  have hM_pos : 0 < M := Fintype.card_pos
  have hM_rpos : (0 : ℝ) < (M : ℝ) := Nat.cast_pos.mpr hM_pos
  set n : ℕ := Module.finrank ℚ K
  have hn_pos : 0 < n := Module.finrank_pos
  have hn_rpos : (0 : ℝ) < (n : ℝ) := Nat.cast_pos.mpr hn_pos
  have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_rpos
  set R : ℝ := NumberField.Units.regulator K
  have hR_pos : 0 < R := NumberField.Units.regulator_pos K
  have hR_ne : R ≠ 0 := ne_of_gt hR_pos
  have hR_inv_nonneg : 0 ≤ R⁻¹ := by positivity
  set W : ℝ := (NumberField.Units.torsionOrder K : ℝ)
  have hW_nat_pos : 0 < NumberField.Units.torsionOrder K :=
    NumberField.Units.torsionOrder_pos K
  have hW_pos : 0 < W := by
    dsimp [W]
    exact_mod_cast hW_nat_pos
  set H : ℝ := (NumberField.classNumber K : ℝ)
  have hH_nat_pos : 0 < NumberField.classNumber K :=
    NumberField.classNumber_pos K
  have hH_pos : 0 < H := by
    dsimp [H]
    exact_mod_cast hH_nat_pos
  have hH_ne : H ≠ 0 := ne_of_gt hH_pos
  have hH_inv_nonneg : 0 ≤ H⁻¹ := by positivity
  set β : ℝ := W / ((n : ℝ) * R * H)
  have hβ_pos : 0 < β := by dsimp [β]; positivity
  set A_cone : ℝ := R⁻¹ * W
  have hA_cone_pos : 0 < A_cone := by dsimp [A_cone]; positivity
  set c' : ℝ := 1 / (4 * (M : ℝ) * c_cell)
  have hc'_pos : 0 < c' := by dsimp [c']; positivity
  set K₀ : ℝ := 16 / c' ^ 2 + 1
  have hK₀_pos : 0 < K₀ := by dsimp [K₀]; positivity
  set A_cell : ℝ := K₀ ^ (2 * M) * c_cell
  have hA_cell_pos : 0 < A_cell := by dsimp [A_cell]; positivity
  let c₃₁ : ℝ :=
    c₁ + 3 * c_shell + A_cell + 3 * β * c_sum + A_cone * H⁻¹ * c₄ + A_cone * c₃ +
      1 / c' + 2 * c_cell + c_sum + c₄ + c₃
  have hc₃₁_pos : 0 < c₃₁ := by dsimp [c₃₁]; positivity
  refine ⟨c₃₁, hc₃₁_pos, ?_⟩
  intro X hX w₀
  set Y : ℝ := X ^ (Module.finrank ℚ K)
  have hX_pos : (0 : ℝ) < X := by linarith
  have hY_nonneg : 0 ≤ Y := by dsimp [Y]; positivity
  have hlog_pos : 0 < Real.log X := Real.log_pos hX
  set t : ℝ := Real.sqrt (Real.log X)
  have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg _
  have ht_sq : t ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlog_pos)
  set z : ℝ := (Real.log X + 1) ^ 2 * Real.exp (c' * t)
  set m : ℕ := ⌊z⌋₊
  have hexp_ge_one : 1 ≤ Real.exp (c' * t) := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by positivity)
  have hlog1_le_sq : Real.log X + 1 ≤ (Real.log X + 1) ^ 2 := by nlinarith
  have hz_ge : Real.log X + 1 ≤ z := by
    dsimp [z]
    calc Real.log X + 1
      _ = (Real.log X + 1) * 1 := (mul_one _).symm
      _ ≤ (Real.log X + 1) ^ 2 * Real.exp (c' * t) :=
        mul_le_mul hlog1_le_sq hexp_ge_one zero_le_one (by positivity)
  have hz_lt : z < (m : ℝ) + 1 := Nat.lt_floor_add_one z
  have hlog_lt_m : Real.log X < (m : ℝ) := by linarith
  have hm_log : Real.log X ≤ (m : ℝ) := le_of_lt hlog_lt_m
  have hm_rpos : (0 : ℝ) < (m : ℝ) := lt_trans hlog_pos hlog_lt_m
  have hm_pos : 0 < m := Nat.cast_pos.mp hm_rpos
  have hm : 1 ≤ m := hm_pos
  have hm_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  have hz_le_2m : z ≤ 2 * (m : ℝ) := by linarith
  have h_ratio : (Real.log X + 1) ^ 2 / (m : ℝ) ≤ 2 * Real.exp (-c' * t) := by
    rw [div_le_iff₀ hm_rpos]
    calc (Real.log X + 1) ^ 2
      _ = z * Real.exp (-c' * t) := by
        dsimp [z]
        rw [mul_assoc, ← Real.exp_add]
        have h0 : c' * t + -c' * t = 0 := by ring
        rw [h0, Real.exp_zero, mul_one]
      _ ≤ (2 * (m : ℝ)) * Real.exp (-c' * t) :=
        mul_le_mul_of_nonneg_right hz_le_2m (by positivity)
      _ = 2 * Real.exp (-c' * t) * (m : ℝ) := by ring
  have hm_le_z : (m : ℝ) ≤ z := Nat.floor_le (by dsimp [z]; positivity)
  have hu_exp : c' * t / 4 + 1 ≤ Real.exp (c' * t / 4) := Real.add_one_le_exp (c' * t / 4)
  have hu_sq : (c' * t / 4) ^ 2 ≤ Real.exp (c' * t / 2) := by
    have h1 : c' * t / 4 ≤ c' * t / 4 + 1 := by linarith
    have h2 : c' * t / 4 ≤ Real.exp (c' * t / 4) := le_trans h1 hu_exp
    calc (c' * t / 4) ^ 2
      _ = (c' * t / 4) * (c' * t / 4) := sq _
      _ ≤ Real.exp (c' * t / 4) * Real.exp (c' * t / 4) :=
        mul_le_mul h2 h2 (by positivity) (by positivity)
      _ = Real.exp (c' * t / 2) := by
        rw [← Real.exp_add]
        ring_nf
  have hlog_le_exp : Real.log X ≤ (16 / c' ^ 2) * Real.exp (c' * t / 2) := by
    have h1 : (c' ^ 2 / 16) * Real.log X = (c' * t / 4) ^ 2 := by
      rw [← ht_sq]
      ring
    rw [div_mul_eq_mul_div, le_div_iff₀ (by positivity)]
    linarith
  have hexp_half_ge_one : 1 ≤ Real.exp (c' * t / 2) := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by positivity)
  have hlog1_le_K₀ : Real.log X + 1 ≤ K₀ * Real.exp (c' * t / 2) := by
    dsimp [K₀]
    linarith
  have hlog1_sq_le : (Real.log X + 1) ^ 2 ≤ K₀ ^ 2 * Real.exp (c' * t) := by
    calc (Real.log X + 1) ^ 2
      _ = (Real.log X + 1) * (Real.log X + 1) := sq _
      _ ≤ (K₀ * Real.exp (c' * t / 2)) * (K₀ * Real.exp (c' * t / 2)) :=
        mul_le_mul hlog1_le_K₀ hlog1_le_K₀ (by positivity) (by positivity)
      _ = K₀ ^ 2 * (Real.exp (c' * t / 2) * Real.exp (c' * t / 2)) := by ring
      _ = K₀ ^ 2 * Real.exp (c' * t) := by
        rw [← Real.exp_add]
        ring_nf
  have hm_le_K₀ : (m : ℝ) ≤ K₀ ^ 2 * Real.exp (2 * c' * t) := by
    calc (m : ℝ)
      _ ≤ z := hm_le_z
      _ = (Real.log X + 1) ^ 2 * Real.exp (c' * t) := rfl
      _ ≤ (K₀ ^ 2 * Real.exp (c' * t)) * Real.exp (c' * t) :=
        mul_le_mul_of_nonneg_right hlog1_sq_le (by positivity)
      _ = K₀ ^ 2 * (Real.exp (c' * t) * Real.exp (c' * t)) := by ring
      _ = K₀ ^ 2 * Real.exp (2 * c' * t) := by
        rw [← Real.exp_add]
        ring_nf
  have hexp_M_eq : (M : ℝ) * (2 * c' * t) = t / (2 * c_cell) := by
    dsimp [c']
    have hM_ne : (M : ℝ) ≠ 0 := ne_of_gt hM_rpos
    have hc_ne : c_cell ≠ 0 := ne_of_gt hc_cell_pos
    field_simp [hM_ne, hc_ne]
    ring
  have hm_pow_le : (m : ℝ) ^ M ≤ K₀ ^ (2 * M) * Real.exp (t / (2 * c_cell)) := by
    calc (m : ℝ) ^ M
      _ ≤ (K₀ ^ 2 * Real.exp (2 * c' * t)) ^ M :=
        pow_le_pow_left₀ (by positivity) hm_le_K₀ M
      _ = K₀ ^ (2 * M) * (Real.exp (2 * c' * t)) ^ M := by
        rw [mul_pow, ← pow_mul]
      _ = K₀ ^ (2 * M) * Real.exp ((M : ℝ) * (2 * c' * t)) := by
        rw [← Real.exp_nat_mul]
      _ = K₀ ^ (2 * M) * Real.exp (t / (2 * c_cell)) := by
        rw [hexp_M_eq]
  set S_sec : ℝ := ∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
        p.asIdeal.IsPrincipal ∧
        (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K)},
      (Nat.card {π : NumberField.RingOfIntegers K //
          Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧
          (∀ w : NumberField.InfinitePlace K,
            1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
          w₀ (π : K) < X} : ℝ) *
        Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal)
  let S_cell : (NumberField.InfinitePlace K → Fin m) → ℝ := fun k =>
    ∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
          p.asIdeal.IsPrincipal ∧
          (Ideal.absNorm p.asIdeal : ℝ) ≤
            X ^ (Module.finrank ℚ K) *
              Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))},
        (Nat.card {π : NumberField.RingOfIntegers K //
            Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧
            ∀ w : NumberField.InfinitePlace K,
              Real.log (w (π : K) / w₀ (π : K)) ∈
                Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                  (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℝ) *
          Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal)
  set S_sum : ℝ := ∑' k : NumberField.InfinitePlace K → Fin m, S_cell k
  let W_cell : (NumberField.InfinitePlace K → Fin m) → ℝ := fun k =>
    (if (k w₀ : ℕ) + 1 = m then (1 : ℝ) else 0) *
      (∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) *
      (Real.log X / (m : ℝ)) ^ (NumberField.Units.rank K) *
      (X ^ (Module.finrank ℚ K) *
        Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))))
  set W_sum : ℝ := ∑' k : NumberField.InfinitePlace K → Fin m, W_cell k
  set S_prin : ℝ := ∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
        p.asIdeal.IsPrincipal ∧
        (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K)},
      Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal)
  set S_all : ℝ := ∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
        (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K)},
      Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal)
  set γ : ℝ := ((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) * R⁻¹ * W
  have hw₀_le_n : w₀.mult ≤ Module.finrank ℚ K := by
    rw [← NumberField.InfinitePlace.sum_mult_eq]
    exact Finset.single_le_sum (fun w _ => Nat.zero_le w.mult) (Finset.mem_univ w₀)
  have hw₀_rle_n : (w₀.mult : ℝ) ≤ (Module.finrank ℚ K : ℝ) := Nat.cast_le.mpr hw₀_le_n
  have hw₀_ratio_nonneg : 0 ≤ (w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ) := by positivity
  have hw₀_ratio_le_one : (w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ) ≤ 1 :=
    div_le_one_of_le₀ hw₀_rle_n (le_of_lt hn_rpos)
  have hγ_nonneg : 0 ≤ γ := by dsimp [γ]; positivity
  have hγ_le_cone : γ ≤ A_cone := by
    dsimp [γ, A_cone]
    have h1 : ((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) * R⁻¹ ≤ R⁻¹ :=
      mul_le_of_le_one_left hR_inv_nonneg hw₀_ratio_le_one
    exact mul_le_mul_of_nonneg_right h1 (le_of_lt hW_pos)
  have h_sub_diff := mitsui_principalPrimeIdeals_place_sector_sub_cell_diff_le X hX m hm w₀
  have h_ge_one := hc₁ X hX
  have h_shell := hc_shell X hX m hm hm_log
  have h_shell_le :
      c_shell * Y * ((Real.log X + 1) ^ 2 / (m : ℝ)) + c_shell * Y * Real.exp (-t / c_shell) ≤
      2 * c_shell * Y * Real.exp (-c' * t) + c_shell * Y * Real.exp (-t / c_shell) := by
    have h1 : c_shell * Y * ((Real.log X + 1) ^ 2 / (m : ℝ)) ≤
        c_shell * Y * (2 * Real.exp (-c' * t)) :=
      mul_le_mul_of_nonneg_left h_ratio (by positivity)
    linarith
  have h_diff1_bound : |S_sec - S_sum| ≤
      c₁ * Y * Real.exp (-t / c₁) +
      2 * c_shell * Y * Real.exp (-c' * t) +
      c_shell * Y * Real.exp (-t / c_shell) := by
    change |S_sec - S_sum| ≤ _ at h_sub_diff
    linarith
  have h_cell_each : ∀ k : NumberField.InfinitePlace K → Fin m,
      |S_cell k - β * W_cell k| ≤ c_cell * Y * Real.exp (-t / c_cell) := by
    intro k
    have hk := hc_cell X hX m hm w₀ k
    have h_eq : β * W_cell k =
        (if (k w₀ : ℕ) + 1 = m then (1 : ℝ) else 0) *
          ((∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) /
            ((Module.finrank ℚ K : ℝ) *
              NumberField.Units.regulator K *
              (NumberField.classNumber K : ℝ))) *
          (NumberField.Units.torsionOrder K : ℝ) *
          (Real.log X / (m : ℝ)) ^ (NumberField.Units.rank K) *
          (X ^ (Module.finrank ℚ K) *
            Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
              (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))) := by
      dsimp [β, W_cell, n, R, W, H]
      ring
    rw [h_eq]
    exact hk
  have h_sum_diff_fintype :
      S_sum - β * W_sum = ∑ k : NumberField.InfinitePlace K → Fin m, (S_cell k - β * W_cell k) := by
    dsimp [S_sum, W_sum]
    rw [tsum_fintype, tsum_fintype, Finset.mul_sum, ← Finset.sum_sub_distrib]
  have h_sum_abs_le : |S_sum - β * W_sum| ≤
      (m : ℝ) ^ M * (c_cell * Y * Real.exp (-t / c_cell)) := by
    rw [h_sum_diff_fintype]
    calc |∑ k : NumberField.InfinitePlace K → Fin m, (S_cell k - β * W_cell k)|
      _ ≤ ∑ k : NumberField.InfinitePlace K → Fin m, |S_cell k - β * W_cell k| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _k : NumberField.InfinitePlace K → Fin m,
            (c_cell * Y * Real.exp (-t / c_cell)) :=
          Finset.sum_le_sum (fun k _ => h_cell_each k)
      _ = (m : ℝ) ^ M * (c_cell * Y * Real.exp (-t / c_cell)) := by
          simp [M, Finset.sum_const, nsmul_eq_mul, Fintype.card_fin]
  have h_diff2_bound : |S_sum - β * W_sum| ≤ A_cell * Y * Real.exp (-t / (2 * c_cell)) := by
    calc |S_sum - β * W_sum|
      _ ≤ (m : ℝ) ^ M * (c_cell * Y * Real.exp (-t / c_cell)) := h_sum_abs_le
      _ ≤ (K₀ ^ (2 * M) * Real.exp (t / (2 * c_cell))) *
            (c_cell * Y * Real.exp (-t / c_cell)) :=
          mul_le_mul_of_nonneg_right hm_pow_le (by positivity)
      _ = A_cell * Y * (Real.exp (t / (2 * c_cell)) * Real.exp (-t / c_cell)) := by
          dsimp [A_cell]; ring
      _ = A_cell * Y * Real.exp (-t / (2 * c_cell)) := by
          rw [← Real.exp_add]
          congr 2
          ring
  have h_wsum := hc_sum X hX m hm hm_log w₀
  have h_wsum_le :
      |W_sum - (w₀.mult : ℝ) * Y| ≤
      2 * c_sum * Y * Real.exp (-c' * t) + c_sum * Y * Real.exp (-t / c_sum) := by
    change |W_sum - (w₀.mult : ℝ) * Y| ≤ _ at h_wsum
    have h1 : c_sum * Y * ((Real.log X + 1) ^ 2 / (m : ℝ)) ≤
        c_sum * Y * (2 * Real.exp (-c' * t)) :=
      mul_le_mul_of_nonneg_left h_ratio (by positivity)
    linarith
  have h_diff3_bound : |β * (W_sum - (w₀.mult : ℝ) * Y)| ≤
      2 * β * c_sum * Y * Real.exp (-c' * t) + β * c_sum * Y * Real.exp (-t / c_sum) := by
    rw [abs_mul, abs_of_pos hβ_pos]
    calc β * |W_sum - (w₀.mult : ℝ) * Y|
      _ ≤ β * (2 * c_sum * Y * Real.exp (-c' * t) + c_sum * Y * Real.exp (-t / c_sum)) :=
          mul_le_mul_of_nonneg_left h_wsum_le (le_of_lt hβ_pos)
      _ = 2 * β * c_sum * Y * Real.exp (-c' * t) + β * c_sum * Y * Real.exp (-t / c_sum) := by ring
  have h_all_asymp : |Y - S_all| ≤ c₄ * Y * Real.exp (-t / c₄) := by
    rw [abs_sub_comm]
    exact hc₄ X hX
  have h_diff4_bound : |(γ * H⁻¹) * (Y - S_all)| ≤ (A_cone * H⁻¹ * c₄) * Y * Real.exp (-t / c₄) := by
    rw [abs_mul, abs_of_nonneg (mul_nonneg hγ_nonneg hH_inv_nonneg)]
    have hγH : γ * H⁻¹ ≤ A_cone * H⁻¹ := mul_le_mul_of_nonneg_right hγ_le_cone hH_inv_nonneg
    calc (γ * H⁻¹) * |Y - S_all|
      _ ≤ (A_cone * H⁻¹) * |Y - S_all| := mul_le_mul_of_nonneg_right hγH (abs_nonneg _)
      _ ≤ (A_cone * H⁻¹) * (c₄ * Y * Real.exp (-t / c₄)) :=
          mul_le_mul_of_nonneg_left h_all_asymp (by positivity)
      _ = (A_cone * H⁻¹ * c₄) * Y * Real.exp (-t / c₄) := by ring
  have h_prin_to_all : |H⁻¹ * S_all - S_prin| ≤ c₃ * Y * Real.exp (-t / c₃) := by
    rw [abs_sub_comm]
    exact hc₃ X hX
  have h_diff5_bound : |γ * (H⁻¹ * S_all - S_prin)| ≤ (A_cone * c₃) * Y * Real.exp (-t / c₃) := by
    rw [abs_mul, abs_of_nonneg hγ_nonneg]
    calc γ * |H⁻¹ * S_all - S_prin|
      _ ≤ A_cone * |H⁻¹ * S_all - S_prin| := mul_le_mul_of_nonneg_right hγ_le_cone (abs_nonneg _)
      _ ≤ A_cone * (c₃ * Y * Real.exp (-t / c₃)) :=
          mul_le_mul_of_nonneg_left h_prin_to_all (le_of_lt hA_cone_pos)
      _ = (A_cone * c₃) * Y * Real.exp (-t / c₃) := by ring
  have h_ident :
      S_sec - ((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) * R⁻¹ * (W * S_prin) =
      (S_sec - S_sum) + (S_sum - β * W_sum) + β * (W_sum - (w₀.mult : ℝ) * Y) +
        (γ * H⁻¹) * (Y - S_all) + γ * (H⁻¹ * S_all - S_prin) := by
    dsimp [γ, β, n]
    field_simp [hn_ne, hR_ne, hH_ne]
    ring
  have h_tri :
      |S_sec - ((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) * R⁻¹ * (W * S_prin)| ≤
      |S_sec - S_sum| + |S_sum - β * W_sum| + |β * (W_sum - (w₀.mult : ℝ) * Y)| +
        |(γ * H⁻¹) * (Y - S_all)| + |γ * (H⁻¹ * S_all - S_prin)| := by
    rw [h_ident]
    have ht1 := abs_add_le
      ((S_sec - S_sum) + (S_sum - β * W_sum) + β * (W_sum - (w₀.mult : ℝ) * Y) + (γ * H⁻¹) * (Y - S_all))
      (γ * (H⁻¹ * S_all - S_prin))
    have ht2 := abs_add_le
      ((S_sec - S_sum) + (S_sum - β * W_sum) + β * (W_sum - (w₀.mult : ℝ) * Y))
      ((γ * H⁻¹) * (Y - S_all))
    have ht3 := abs_add_le
      ((S_sec - S_sum) + (S_sum - β * W_sum))
      (β * (W_sum - (w₀.mult : ℝ) * Y))
    have ht4 := abs_add_le
      (S_sec - S_sum)
      (S_sum - β * W_sum)
    linarith
  have hc₁_le : c₁ ≤ c₃₁ := by
    have : 0 ≤ 3 * c_shell + A_cell + 3 * β * c_sum + A_cone * H⁻¹ * c₄ + A_cone * c₃ +
      1 / c' + 2 * c_cell + c_sum + c₄ + c₃ := by positivity
    dsimp [c₃₁]; linarith
  have hc'_inv_le : 1 / c' ≤ c₃₁ := by
    have : 0 ≤ c₁ + 3 * c_shell + A_cell + 3 * β * c_sum + A_cone * H⁻¹ * c₄ + A_cone * c₃ +
      2 * c_cell + c_sum + c₄ + c₃ := by positivity
    dsimp [c₃₁]; linarith
  have hc_shell_le : c_shell ≤ c₃₁ := by
    have : 0 ≤ c₁ + 2 * c_shell + A_cell + 3 * β * c_sum + A_cone * H⁻¹ * c₄ + A_cone * c₃ +
      1 / c' + 2 * c_cell + c_sum + c₄ + c₃ := by positivity
    dsimp [c₃₁]; linarith
  have h2c_cell_le : 2 * c_cell ≤ c₃₁ := by
    have : 0 ≤ c₁ + 3 * c_shell + A_cell + 3 * β * c_sum + A_cone * H⁻¹ * c₄ + A_cone * c₃ +
      1 / c' + c_sum + c₄ + c₃ := by positivity
    dsimp [c₃₁]; linarith
  have hc_sum_le : c_sum ≤ c₃₁ := by
    have : 0 ≤ c₁ + 3 * c_shell + A_cell + 3 * β * c_sum + A_cone * H⁻¹ * c₄ + A_cone * c₃ +
      1 / c' + 2 * c_cell + c₄ + c₃ := by positivity
    dsimp [c₃₁]; linarith
  have hc₄_le : c₄ ≤ c₃₁ := by
    have : 0 ≤ c₁ + 3 * c_shell + A_cell + 3 * β * c_sum + A_cone * H⁻¹ * c₄ + A_cone * c₃ +
      1 / c' + 2 * c_cell + c_sum + c₃ := by positivity
    dsimp [c₃₁]; linarith
  have hc₃_le : c₃ ≤ c₃₁ := by
    have : 0 ≤ c₁ + 3 * c_shell + A_cell + 3 * β * c_sum + A_cone * H⁻¹ * c₄ + A_cone * c₃ +
      1 / c' + 2 * c_cell + c_sum + c₄ := by positivity
    dsimp [c₃₁]; linarith
  have hexp₁ : Real.exp (-t / c₁) ≤ Real.exp (-t / c₃₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg hc₁_pos hc₁_le
  have hexp_c' : Real.exp (-c' * t) ≤ Real.exp (-t / c₃₁) := by
    have h_eq : -c' * t = -t / (1 / c') := by
      have hc'_ne : c' ≠ 0 := ne_of_gt hc'_pos
      field_simp [hc'_ne]
    rw [h_eq, Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg (by positivity) hc'_inv_le
  have hexp_shell : Real.exp (-t / c_shell) ≤ Real.exp (-t / c₃₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg hc_shell_pos hc_shell_le
  have hexp_cell : Real.exp (-t / (2 * c_cell)) ≤ Real.exp (-t / c₃₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg (by positivity) h2c_cell_le
  have hexp_sum : Real.exp (-t / c_sum) ≤ Real.exp (-t / c₃₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg hc_sum_pos hc_sum_le
  have hexp₄ : Real.exp (-t / c₄) ≤ Real.exp (-t / c₃₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg hc₄_pos hc₄_le
  have hexp₃ : Real.exp (-t / c₃) ≤ Real.exp (-t / c₃₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg hc₃_pos hc₃_le
  have hterm₁ : c₁ * Y * Real.exp (-t / c₁) ≤ c₁ * Y * Real.exp (-t / c₃₁) :=
    mul_le_mul_of_nonneg_left hexp₁ (by positivity)
  have hterm₂ : 2 * c_shell * Y * Real.exp (-c' * t) ≤ 2 * c_shell * Y * Real.exp (-t / c₃₁) :=
    mul_le_mul_of_nonneg_left hexp_c' (by positivity)
  have hterm₃ : c_shell * Y * Real.exp (-t / c_shell) ≤ c_shell * Y * Real.exp (-t / c₃₁) :=
    mul_le_mul_of_nonneg_left hexp_shell (by positivity)
  have hterm₄ : A_cell * Y * Real.exp (-t / (2 * c_cell)) ≤ A_cell * Y * Real.exp (-t / c₃₁) :=
    mul_le_mul_of_nonneg_left hexp_cell (by positivity)
  have hterm₅ : 2 * β * c_sum * Y * Real.exp (-c' * t) ≤ 2 * β * c_sum * Y * Real.exp (-t / c₃₁) :=
    mul_le_mul_of_nonneg_left hexp_c' (by positivity)
  have hterm₆ : β * c_sum * Y * Real.exp (-t / c_sum) ≤ β * c_sum * Y * Real.exp (-t / c₃₁) :=
    mul_le_mul_of_nonneg_left hexp_sum (by positivity)
  have hterm₇ : (A_cone * H⁻¹ * c₄) * Y * Real.exp (-t / c₄) ≤ (A_cone * H⁻¹ * c₄) * Y * Real.exp (-t / c₃₁) :=
    mul_le_mul_of_nonneg_left hexp₄ (by positivity)
  have hterm₈ : (A_cone * c₃) * Y * Real.exp (-t / c₃) ≤ (A_cone * c₃) * Y * Real.exp (-t / c₃₁) :=
    mul_le_mul_of_nonneg_left hexp₃ (by positivity)
  have h_sum_all_le :
      c₁ * Y * Real.exp (-t / c₃₁) +
      2 * c_shell * Y * Real.exp (-t / c₃₁) +
      c_shell * Y * Real.exp (-t / c₃₁) +
      A_cell * Y * Real.exp (-t / c₃₁) +
      2 * β * c_sum * Y * Real.exp (-t / c₃₁) +
      β * c_sum * Y * Real.exp (-t / c₃₁) +
      (A_cone * H⁻¹ * c₄) * Y * Real.exp (-t / c₃₁) +
      (A_cone * c₃) * Y * Real.exp (-t / c₃₁) ≤
      c₃₁ * Y * Real.exp (-t / c₃₁) := by
    have h_coeff :
        c₁ + 2 * c_shell + c_shell + A_cell + 2 * β * c_sum + β * c_sum +
          A_cone * H⁻¹ * c₄ + A_cone * c₃ ≤ c₃₁ := by
      have : 0 ≤ 1 / c' + 2 * c_cell + c_sum + c₄ + c₃ := by positivity
      dsimp [c₃₁]; linarith
    have hYE_nonneg : 0 ≤ Y * Real.exp (-t / c₃₁) := by positivity
    calc c₁ * Y * Real.exp (-t / c₃₁) +
        2 * c_shell * Y * Real.exp (-t / c₃₁) +
        c_shell * Y * Real.exp (-t / c₃₁) +
        A_cell * Y * Real.exp (-t / c₃₁) +
        2 * β * c_sum * Y * Real.exp (-t / c₃₁) +
        β * c_sum * Y * Real.exp (-t / c₃₁) +
        (A_cone * H⁻¹ * c₄) * Y * Real.exp (-t / c₃₁) +
        (A_cone * c₃) * Y * Real.exp (-t / c₃₁)
      _ = (c₁ + 2 * c_shell + c_shell + A_cell + 2 * β * c_sum + β * c_sum +
            A_cone * H⁻¹ * c₄ + A_cone * c₃) * (Y * Real.exp (-t / c₃₁)) := by ring
      _ ≤ c₃₁ * (Y * Real.exp (-t / c₃₁)) := mul_le_mul_of_nonneg_right h_coeff hYE_nonneg
      _ = c₃₁ * Y * Real.exp (-t / c₃₁) := by ring
  change |S_sec - ((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) * R⁻¹ * (W * S_prin)| ≤
    c₃₁ * Y * Real.exp (-t / c₃₁)
  linarith

theorem mitsui_prime_place_sector_to_fundamentalCone {K : Type u} [Field K] [NumberField K] :
    ∃ c₃ : ℝ, 0 < c₃ ∧
      ∀ X : ℝ, 1 < X →
        ∀ w₀ : NumberField.InfinitePlace K,
          |(∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧
                (∀ w : NumberField.InfinitePlace K,
                  1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
                w₀ (π : K) < X},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
            - ((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) *
              (NumberField.Units.regulator K)⁻¹ *
              (∑' π : {π : NumberField.RingOfIntegers K //
                    Prime π ∧
                    NumberField.mixedEmbedding K (π : K) ∈
                      NumberField.mixedEmbedding.fundamentalCone K ∧
                    NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤
                      X ^ (Module.finrank ℚ K)},
                  Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))|
            ≤ c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃) :=
by
  rcases Nat.eq_zero_or_pos (NumberField.Units.rank K) with h_rank | h_rank
  · obtain ⟨c₃₀, hc₃₀_pos, hc₃₀⟩ :=
      mitsui_principalPrimeIdeals_place_sector_bound_of_rank_eq_zero (K := K) h_rank
    refine ⟨c₃₀, hc₃₀_pos, ?_⟩
    intro X hX w₀
    rw [mitsui_prime_place_sector_eq_principalPrimeIdeals X hX w₀,
      mitsui_prime_fundamentalCone_eq_torsionOrder_mul_principalPrimeIdeals
        (X ^ (Module.finrank ℚ K))]
    exact hc₃₀ X hX w₀
  · obtain ⟨c₃₁, hc₃₁_pos, hc₃₁⟩ :=
      mitsui_principalPrimeIdeals_place_sector_bound_of_rank_pos (K := K) h_rank
    refine ⟨c₃₁, hc₃₁_pos, ?_⟩
    intro X hX w₀
    rw [mitsui_prime_place_sector_eq_principalPrimeIdeals X hX w₀,
      mitsui_prime_fundamentalCone_eq_torsionOrder_mul_principalPrimeIdeals
        (X ^ (Module.finrank ℚ K))]
    exact hc₃₁ X hX w₀

theorem mitsui_prime_box_to_fundamentalCone {K : Type u} [Field K] [NumberField K] :
    ∃ c_bf : ℝ, 0 < c_bf ∧
      ∀ X : ℝ, 1 < X →
        |(∑' π : {π : NumberField.RingOfIntegers K //
              Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
            Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
          - (NumberField.Units.regulator K)⁻¹ *
            (∑' π : {π : NumberField.RingOfIntegers K //
                  Prime π ∧
                  NumberField.mixedEmbedding K (π : K) ∈
                    NumberField.mixedEmbedding.fundamentalCone K ∧
                  NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤
                    X ^ (Module.finrank ℚ K)},
                Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))|
          ≤ c_bf * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_bf) :=
by
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_prime_box_to_ge_one (K := K)
  obtain ⟨c₂, hc₂_pos, hc₂⟩ := mitsui_prime_box_ge_one_to_place_sectors (K := K)
  obtain ⟨c₃, hc₃_pos, hc₃⟩ := mitsui_prime_place_sector_to_fundamentalCone (K := K)
  set M_card : ℝ := (Fintype.card (NumberField.InfinitePlace K) : ℝ)
  have hM_nonneg : 0 ≤ M_card := by dsimp [M_card]; positivity
  let c_bf : ℝ := c₁ + c₂ + M_card * c₃ + c₃
  have hc_bf_pos : 0 < c_bf := by dsimp [c_bf]; positivity
  refine ⟨c_bf, hc_bf_pos, ?_⟩
  intro X hX
  set Y : ℝ := X ^ (Module.finrank ℚ K)
  set R : ℝ := NumberField.Units.regulator K
  have hX_pos : 0 < X := by linarith
  have hY_nonneg : 0 ≤ Y := by dsimp [Y]; positivity
  set S₁ : ℝ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  set S₂ : ℝ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X},
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  let S_sec : NumberField.InfinitePlace K → ℝ := fun w₀ =>
    ∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          (∀ w : NumberField.InfinitePlace K,
            1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
          w₀ (π : K) < X},
      Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  set S₃ : ℝ := ∑ w₀ : NumberField.InfinitePlace K, S_sec w₀
  set S₄ : ℝ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      NumberField.mixedEmbedding K (π : K) ∈
        NumberField.mixedEmbedding.fundamentalCone K ∧
      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤ Y},
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  have h1 : |S₁ - S₂| ≤ c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := hc₁ X hX
  have h2 : |S₂ - S₃| ≤ c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := hc₂ X hX
  have h3 : ∀ w₀ : NumberField.InfinitePlace K,
      |S_sec w₀ - ((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) * R⁻¹ * S₄| ≤
        c₃ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃) := hc₃ X hX
  have hn_pos : (0 : ℝ) < (Module.finrank ℚ K : ℝ) := by
    exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
  have hn_ne : (Module.finrank ℚ K : ℝ) ≠ 0 := ne_of_gt hn_pos
  have h_sum_mult : (∑ w₀ : NumberField.InfinitePlace K, (w₀.mult : ℝ)) = (Module.finrank ℚ K : ℝ) := by
    exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
  have h_sum_weights :
      (∑ w₀ : NumberField.InfinitePlace K,
        ((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) * R⁻¹ * S₄) = R⁻¹ * S₄ := by
    rw [← Finset.sum_mul, ← Finset.sum_mul, ← Finset.sum_div, h_sum_mult, div_self hn_ne, one_mul]
  have h_diff3 : S₃ - R⁻¹ * S₄ =
      ∑ w₀ : NumberField.InfinitePlace K,
        (S_sec w₀ - ((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) * R⁻¹ * S₄) := by
    dsimp [S₃]
    rw [Finset.sum_sub_distrib, h_sum_weights]
  have h_abs3 : |S₃ - R⁻¹ * S₄| ≤
      M_card * (c₃ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃)) := by
    rw [h_diff3]
    calc |∑ w₀ : NumberField.InfinitePlace K,
            (S_sec w₀ - ((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) * R⁻¹ * S₄)|
      _ ≤ ∑ w₀ : NumberField.InfinitePlace K,
            |S_sec w₀ - ((w₀.mult : ℝ) / (Module.finrank ℚ K : ℝ)) * R⁻¹ * S₄| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _w₀ : NumberField.InfinitePlace K,
            (c₃ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃)) :=
          Finset.sum_le_sum (fun w₀ _ => h3 w₀)
      _ = M_card * (c₃ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃)) := by
          simp [M_card, Finset.sum_const, nsmul_eq_mul]
  have h_ident : S₁ - R⁻¹ * S₄ = (S₁ - S₂) + (S₂ - S₃) + (S₃ - R⁻¹ * S₄) := by ring
  have h_tri : |S₁ - R⁻¹ * S₄| ≤ |S₁ - S₂| + |S₂ - S₃| + |S₃ - R⁻¹ * S₄| := by
    rw [h_ident]
    have ht1 := abs_add_le ((S₁ - S₂) + (S₂ - S₃)) (S₃ - R⁻¹ * S₄)
    have ht2 := abs_add_le (S₁ - S₂) (S₂ - S₃)
    linarith
  have hsqrt_nonneg : 0 ≤ Real.sqrt (Real.log X) := Real.sqrt_nonneg _
  have hc₁_le : c₁ ≤ c_bf := by
    have : 0 ≤ c₂ + M_card * c₃ + c₃ := by positivity
    dsimp [c_bf]; linarith
  have hc₂_le : c₂ ≤ c_bf := by
    have : 0 ≤ c₁ + M_card * c₃ + c₃ := by positivity
    dsimp [c_bf]; linarith
  have hc₃_le : c₃ ≤ c_bf := by
    have : 0 ≤ c₁ + c₂ + M_card * c₃ := by positivity
    dsimp [c_bf]; linarith
  have hexp1 : Real.exp (-Real.sqrt (Real.log X) / c₁) ≤ Real.exp (-Real.sqrt (Real.log X) / c_bf) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₁_pos hc₁_le
  have hexp2 : Real.exp (-Real.sqrt (Real.log X) / c₂) ≤ Real.exp (-Real.sqrt (Real.log X) / c_bf) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₂_pos hc₂_le
  have hexp3 : Real.exp (-Real.sqrt (Real.log X) / c₃) ≤ Real.exp (-Real.sqrt (Real.log X) / c_bf) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₃_pos hc₃_le
  have hterm1 : |S₁ - S₂| ≤ c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) := by
    calc |S₁ - S₂| ≤ c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := h1
      _ ≤ c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) :=
        mul_le_mul_of_nonneg_left hexp1 (by positivity)
  have hterm2 : |S₂ - S₃| ≤ c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) := by
    calc |S₂ - S₃| ≤ c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := h2
      _ ≤ c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) :=
        mul_le_mul_of_nonneg_left hexp2 (by positivity)
  have hterm3 : |S₃ - R⁻¹ * S₄| ≤ (M_card * c₃) * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) := by
    calc |S₃ - R⁻¹ * S₄| ≤ M_card * (c₃ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃)) := h_abs3
      _ ≤ M_card * (c₃ * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf)) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp3 (by positivity)) hM_nonneg
      _ = (M_card * c₃) * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) := by ring
  have h_sum_le :
      c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) +
      c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) +
      (M_card * c₃) * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) ≤
      c_bf * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) := by
    have h_coeff : c₁ + c₂ + M_card * c₃ ≤ c_bf := by
      have : 0 ≤ c₃ := by positivity
      dsimp [c_bf]; linarith
    have hYE_nonneg : 0 ≤ Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) := by positivity
    calc c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) +
        c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) +
        (M_card * c₃) * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf)
      _ = (c₁ + c₂ + M_card * c₃) * (Y * Real.exp (-Real.sqrt (Real.log X) / c_bf)) := by ring
      _ ≤ c_bf * (Y * Real.exp (-Real.sqrt (Real.log X) / c_bf)) :=
        mul_le_mul_of_nonneg_right h_coeff hYE_nonneg
      _ = c_bf * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) := by ring
  linarith

theorem mitsui_vonMangoldt_cone_to_principalPrimeIdeals {K : Type u} [Field K] [NumberField K] :
    ∃ c₂ : ℝ, 0 < c₂ ∧
      ∀ X : ℝ, 1 < X →
        |(∑' x : {x : NumberField.RingOfIntegers K //
              NumberField.mixedEmbedding K (x : K) ∈
                NumberField.mixedEmbedding.fundamentalCone K ∧
              NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤
                X ^ (Module.finrank ℚ K)},
            vonMangoldtO (x : NumberField.RingOfIntegers K))
          - (NumberField.Units.torsionOrder K : ℝ) *
            (∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
                p.asIdeal.IsPrincipal ∧
                (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K)},
              Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal))|
          ≤ c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
by
  classical
  have h_norm_span : ∀ x : NumberField.RingOfIntegers K,
      (Ideal.absNorm (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))) : ℝ) =
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) := by
    intro x
    rw [Ideal.absNorm_span_singleton, NumberField.mixedEmbedding.norm_eq_norm,
      ← Algebra.coe_norm_int x, Nat.cast_natAbs]
    push_cast
    rfl
  have h_prime_cone_eq_prod : ∀ Y : ℝ,
      (∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧
            NumberField.mixedEmbedding K (π : K) ∈
              NumberField.mixedEmbedding.fundamentalCone K ∧
            NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤ Y},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)) =
      ∑' q : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
            p.asIdeal.IsPrincipal ∧
            (Ideal.absNorm p.asIdeal : ℝ) ≤ Y} ×
          NumberField.Units.torsion K,
        Real.log (Ideal.absNorm (q.1 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal) := by
    intro Y
    let D_prime := {π : NumberField.RingOfIntegers K //
      Prime π ∧
      NumberField.mixedEmbedding K (π : K) ∈
        NumberField.mixedEmbedding.fundamentalCone K ∧
      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤ Y}
    let D_ideal := {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
      p.asIdeal.IsPrincipal ∧
      (Ideal.absNorm p.asIdeal : ℝ) ≤ Y}
    let p₀ : D_prime → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) :=
      fun π => ⟨Ideal.span ({π.1} : Set (NumberField.RingOfIntegers K)),
        (Ideal.span_singleton_prime π.2.1.ne_zero).mpr π.2.1,
        Ideal.span_singleton_eq_bot.not.mpr π.2.1.ne_zero⟩
    let d_ideal : D_prime → D_ideal :=
      fun π => ⟨p₀ π, ⟨⟨π.1, rfl⟩⟩, by
        show (Ideal.absNorm (Ideal.span ({π.1} : Set (NumberField.RingOfIntegers K))) : ℝ) ≤ Y
        rw [h_norm_span π.1]
        exact π.2.2.2⟩
    let a : D_prime → NumberField.mixedEmbedding.fundamentalCone.integerSet K :=
      fun π => ⟨NumberField.mixedEmbedding K (π.1 : K),
        NumberField.mixedEmbedding.fundamentalCone.mem_integerSet.mpr ⟨π.2.2.1, π.1, rfl⟩⟩
    let u_of : D_prime → NumberField.Units.torsion K :=
      fun π => (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a π)).2
    let toFun : D_prime → D_ideal × NumberField.Units.torsion K :=
      fun π => (d_ideal π, u_of π)
    let b : D_ideal → {I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) //
        Submodule.IsPrincipal (I : Ideal (NumberField.RingOfIntegers K))} :=
      fun p => ⟨⟨p.1.asIdeal, mem_nonZeroDivisors_of_ne_zero p.1.ne_bot⟩, p.2.1⟩
    let a' : D_ideal × NumberField.Units.torsion K →
        NumberField.mixedEmbedding.fundamentalCone.integerSet K :=
      fun q => (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K).symm (b q.1, q.2)
    let x' : D_ideal × NumberField.Units.torsion K → NumberField.RingOfIntegers K :=
      fun q => (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet (a' q) :
        NumberField.RingOfIntegers K)
    have h_span : ∀ q : D_ideal × NumberField.Units.torsion K,
        Ideal.span ({x' q} : Set (NumberField.RingOfIntegers K)) = q.1.1.asIdeal := by
      intro q
      have h1 := NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv_apply_fst (a' q)
      have h2 : (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a' q)).1 = b q.1 := by
        dsimp [a']
        rw [(NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K).apply_symm_apply]
      have h3 : (((NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a' q)).1 :
          nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
          Ideal (NumberField.RingOfIntegers K)) = q.1.1.asIdeal := by
        rw [h2]
      exact h1.symm.trans h3
    have hx'_prime : ∀ q : D_ideal × NumberField.Units.torsion K, Prime (x' q) := by
      intro q
      have hx'_ne : x' q ≠ 0 :=
        nonZeroDivisors.ne_zero
          (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet (a' q)).2
      have hI_prime : (Ideal.span ({x' q} : Set (NumberField.RingOfIntegers K))).IsPrime := by
        rw [h_span q]
        exact q.1.1.isPrime
      exact (Ideal.span_singleton_prime hx'_ne).mp hI_prime
    have hx'_cone : ∀ q : D_ideal × NumberField.Units.torsion K,
        NumberField.mixedEmbedding K ((x' q : NumberField.RingOfIntegers K) : K) ∈
          NumberField.mixedEmbedding.fundamentalCone K := by
      intro q
      have h_emb := NumberField.mixedEmbedding.fundamentalCone.mixedEmbedding_preimageOfMemIntegerSet (a' q)
      change NumberField.mixedEmbedding K ((x' q : NumberField.RingOfIntegers K) : K) = (a' q).1 at h_emb
      rw [h_emb]
      exact (NumberField.mixedEmbedding.fundamentalCone.mem_integerSet.mp (a' q).2).1
    have hx'_norm : ∀ q : D_ideal × NumberField.Units.torsion K,
        NumberField.mixedEmbedding.norm
          (NumberField.mixedEmbedding K ((x' q : NumberField.RingOfIntegers K) : K)) ≤ Y := by
      intro q
      rw [← h_norm_span (x' q), h_span q]
      exact q.1.2.2
    let invFun : D_ideal × NumberField.Units.torsion K → D_prime :=
      fun q => ⟨x' q, hx'_prime q, hx'_cone q, hx'_norm q⟩
    have h_left_inv : Function.LeftInverse invFun toFun := by
      intro π
      apply Subtype.ext
      change x' (toFun π) = π.1
      have ha_pre : (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet (a π) :
          NumberField.RingOfIntegers K) = π.1 :=
        NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet_mixedEmbedding (a π).2
      have h_b_eq : b (d_ideal π) =
          (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a π)).1 := by
        apply Subtype.ext
        apply Subtype.ext
        change Ideal.span ({π.1} : Set (NumberField.RingOfIntegers K)) =
          (((NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a π)).1 :
            nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
            Ideal (NumberField.RingOfIntegers K))
        rw [NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv_apply_fst (a π), ha_pre]
      have h_pair : (b (d_ideal π), u_of π) =
          NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a π) :=
        Prod.ext h_b_eq rfl
      have ha'_eq : a' (toFun π) = a π := by
        dsimp [a', toFun]
        rw [h_pair, (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K).symm_apply_apply]
      dsimp [x']
      rw [ha'_eq]
      exact ha_pre
    have h_right_inv : Function.RightInverse invFun toFun := by
      intro q
      apply Prod.ext
      · apply Subtype.ext
        apply IsDedekindDomain.HeightOneSpectrum.ext
        change Ideal.span ({x' q} : Set (NumberField.RingOfIntegers K)) = q.1.1.asIdeal
        exact h_span q
      · have ha_eq : a (invFun q) = a' q := by
          apply Subtype.ext
          exact NumberField.mixedEmbedding.fundamentalCone.mixedEmbedding_preimageOfMemIntegerSet (a' q)
        change (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a (invFun q))).2 = q.2
        rw [ha_eq]
        dsimp [a']
        rw [(NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K).apply_symm_apply]
    let E : D_prime ≃ D_ideal × NumberField.Units.torsion K :=
      { toFun := toFun
        invFun := invFun
        left_inv := h_left_inv
        right_inv := h_right_inv }
    have h_term : ∀ π : D_prime,
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) =
        Real.log (Ideal.absNorm ((E π).1 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal) := by
      intro π
      have h_asIdeal : ((E π).1 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal =
          Ideal.span ({π.1} : Set (NumberField.RingOfIntegers K)) := rfl
      rw [h_asIdeal, Ideal.absNorm_span_singleton]
    rw [tsum_congr h_term]
    exact Equiv.tsum_eq E
      (fun q : D_ideal × NumberField.Units.torsion K =>
        Real.log (Ideal.absNorm (q.1 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal))
  have h_prod_eq_torsionOrder_mul : ∀ Y : ℝ,
      (∑' q : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
            p.asIdeal.IsPrincipal ∧
            (Ideal.absNorm p.asIdeal : ℝ) ≤ Y} ×
          NumberField.Units.torsion K,
        Real.log (Ideal.absNorm (q.1 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal)) =
      (NumberField.Units.torsionOrder K : ℝ) *
        (∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
            p.asIdeal.IsPrincipal ∧
            (Ideal.absNorm p.asIdeal : ℝ) ≤ Y},
          Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal)) := by
    intro Y
    let D_ideal := {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
      p.asIdeal.IsPrincipal ∧
      (Ideal.absNorm p.asIdeal : ℝ) ≤ Y}
    let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
      {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊}
    have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Y⌋₊
    haveI : Finite S_id := hSid_fin
    let ψ : D_ideal → S_id :=
      fun p => ⟨p.1.asIdeal, Nat.le_floor p.2.2⟩
    have hψ_inj : Function.Injective ψ := by
      intro p₁ p₂ hψ
      apply Subtype.ext
      apply IsDedekindDomain.HeightOneSpectrum.ext
      exact congrArg Subtype.val hψ
    haveI : Finite D_ideal := Finite.of_injective ψ hψ_inj
    letI : Fintype D_ideal := Fintype.ofFinite D_ideal
    have h_card : (Fintype.card (NumberField.Units.torsion K) : ℝ) =
        (NumberField.Units.torsionOrder K : ℝ) := rfl
    rw [tsum_fintype, tsum_fintype, Fintype.sum_prod_type]
    simp_rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, h_card]
    rw [← Finset.mul_sum]
  have h_cone_fin : ∀ Y : ℝ,
      {x : NumberField.RingOfIntegers K |
        NumberField.mixedEmbedding K (x : K) ∈ NumberField.mixedEmbedding.fundamentalCone K ∧
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤ Y}.Finite := by
    intro Y
    let S_cone : Set (NumberField.RingOfIntegers K) :=
      {x : NumberField.RingOfIntegers K |
        NumberField.mixedEmbedding K (x : K) ∈ NumberField.mixedEmbedding.fundamentalCone K ∧
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤ Y}
    let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
      {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊}
    have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Y⌋₊
    haveI : Finite S_id := hSid_fin
    let a : S_cone → NumberField.mixedEmbedding.fundamentalCone.integerSet K :=
      fun x => ⟨NumberField.mixedEmbedding K (x.1 : K),
        NumberField.mixedEmbedding.fundamentalCone.mem_integerSet.mpr ⟨x.2.1, x.1, rfl⟩⟩
    have ha_pre : ∀ x : S_cone,
        (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet (a x) :
          NumberField.RingOfIntegers K) = x.1 :=
