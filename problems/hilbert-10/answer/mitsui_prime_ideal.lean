        _ ≤ c₀' * (Z * Real.exp (-Real.sqrt (Real.log Z) / c₀')) :=
            mul_le_mul_of_nonneg_right hc1_exp_le_c0' (by positivity)
        _ = c₀' * Z * Real.exp (-Real.sqrt (Real.log Z) / c₀') := by ring
  set n : ℕ := Module.finrank ℚ K
  have hn_pos : 0 < n := Module.finrank_pos
