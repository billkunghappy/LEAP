                Real.log (Z / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ))) := by
    refine tsum_congr (fun pm => ?_)
    rw [h_card_eq pm]
  rw [h_tsum_eq]
  have hX_pos : (0 : ℝ) < X := by linarith
  set B : ℝ := c₀ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₀)
  have hB : 0 ≤ B := by
    dsimp [B]
    positivity
  obtain ⟨χ₀, hχ₀_unit, hχ₀_not_unit⟩ :=
    mitsui_exists_ideal_monoidHom_extending_unit_trivial_char q hq ψ hψ_units
  refine mitsui_riesz_principalPrimePower_weighted_le_of_ideal_monoidHom_bound
    Z q ψ M B hB χ₀ hχ₀_unit hχ₀_not_unit ?_
  intro χ hχ_unit hχ_not_unit
  obtain ⟨hχ_ray, hχ_norm, hχ_nonprin⟩ :=
    mitsui_ideal_monoidHom_ray_properties_of_extending_char q hq ψ hψ χ hχ_unit hχ_not_unit
  exact hc₀ X hX m hm w₀ k Z hXZ hZ_le q hq hq_norm χ hχ_ray hχ_norm hχ_nonprin

theorem mitsui_principalPrimePower_char_decoupled_log_cell_bound_of_rank_pos {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A)
    (h_rank : 0 < NumberField.Units.rank K) :
    ∃ c_pp : ℝ, 0 < c_pp ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m →
          ∀ w₀ : NumberField.InfinitePlace K,
            ∀ k : NumberField.InfinitePlace K → Fin m,
