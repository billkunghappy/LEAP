    have hlogX_pos : 0 < Real.log X := Real.log_pos hX
    set u : ℝ := Real.sqrt (Real.log X)
    have hu_pos : 0 < u := Real.sqrt_pos.mpr hlogX_pos
    have hu_nonneg : 0 ≤ u := le_of_lt hu_pos
    have hu_sq : u ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlogX_pos)
    have hmR_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
    have hmR_pos : (0 : ℝ) < (m : ℝ) := lt_of_lt_of_le zero_lt_one hmR_ge_one
    rcases le_or_gt (Real.exp u) (m : ℝ) with hm_fine | hm_coarse
    · have h_norm_le := mitsui_prime_char_grid_cube_norm_le_uncond (K := K) X hX m hm k hQ_bdd q hq ψ
      have h_pack_le := hc_pack X hX m hm hm_le_X k hQ_bdd
      have h_le1 := le_trans h_norm_le h_pack_le
      have hm_pow_ge : (m : ℝ) ≤ (m : ℝ) ^ n := by
        calc (m : ℝ) = (m : ℝ) ^ 1 := (pow_one _).symm
          _ ≤ (m : ℝ) ^ n := pow_le_pow_right₀ hmR_ge_one hn_ge_one
      have hexp_le_mn : Real.exp u ≤ (m : ℝ) ^ n := le_trans hm_fine hm_pow_ge
      have h_vol_le : (X / (m : ℝ)) ^ n ≤ Y * Real.exp (-u) := by
        rw [div_pow]
        have h_div : Y / (m : ℝ) ^ n ≤ Y / Real.exp u :=
          div_le_div_of_nonneg_left hY_nonneg (Real.exp_pos u) hexp_le_mn
        have h_eq : Y / Real.exp u = Y * Real.exp (-u) := by
          rw [Real.exp_neg, div_eq_mul_inv]
        exact le_of_le_of_eq h_div h_eq
      have h_log_le : Real.log X + 1 ≤ 17 * Real.exp (u / 2) := by
        have h_exp4 : u / 4 ≤ Real.exp (u / 4) := by
          have h := Real.add_one_le_exp (u / 4)
          linarith
        have h_sq4 : (u / 4) ^ 2 ≤ (Real.exp (u / 4)) ^ 2 :=
          pow_le_pow_left₀ (by positivity) h_exp4 2
        have h_exp_sq : (Real.exp (u / 4)) ^ 2 = Real.exp (u / 2) := by
          rw [sq, ← Real.exp_add]
