            rw [polarCoord_target]
            simp only [Set.mem_prod, Set.mem_Ioi, V_cplx, Set.mem_diff, Set.mem_setOf_eq,
              polarCoord_symm_apply, h_r_sq, h_lt_iff R₁ hR₁, h_lt_iff R₀ hR₀, A_exact, Set.mem_Ico]
            constructor
            · rintro ⟨⟨_, hθ⟩, ⟨hr1, ha0, ha1⟩, hnot0⟩
              refine ⟨⟨?_, hr1⟩, hθ, ha0, ha1⟩
              by_contra hlt0
              push_neg at hlt0
              exact hnot0 ⟨hlt0, ha0, ha1⟩
            · rintro ⟨⟨hr0, hr1⟩, hθ, ha0, ha1⟩
              refine ⟨⟨hr, hθ⟩, ⟨hr1, ha0, ha1⟩, ?_⟩
              rintro ⟨hlt0, _, _⟩
              linarith
