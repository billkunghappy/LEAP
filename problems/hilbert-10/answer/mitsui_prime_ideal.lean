  have hK_rpos : (0 : ℝ) < (K_δ : ℝ) := by linarith
  have hK_rne : (K_δ : ℝ) ≠ 0 := ne_of_gt hK_rpos
  have hh_pos : 0 < h := inv_pos.mpr hK_rpos
  have hh_nonneg : 0 ≤ h := le_of_lt hh_pos
  have hKh : (K_δ : ℝ) * h = 1 := mul_inv_cancel₀ hK_rne
  have hK_cast : (K : ℝ) = (K_δ : ℝ) := Int.cast_natCast K_δ
