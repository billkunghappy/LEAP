theorem mitsui_mellin_Ioo_zero_one_eq_Ioi_one_of_theta_inversion (R_K : ℝ) (Ψ : ℝ → ℝ)
    (hΨ_inv : ∀ u ∈ Set.Ioi (1 : ℝ),
      u ^ (-3 : ℝ) * Ψ u⁻¹ = Ψ u + R_K * (u ^ (-1 : ℝ) - u ^ (-2 : ℝ)))
    (s : ℂ) :
    (∫ u in Set.Ioo (0 : ℝ) 1, (u : ℂ) ^ s * (Ψ u : ℂ)) =
      ∫ u in Set.Ioi (1 : ℝ),
        ((u : ℂ) ^ (1 - s) * (Ψ u : ℂ) +
          (R_K : ℂ) * ((u : ℂ) ^ (-s) - (u : ℂ) ^ (-1 - s))) :=
by
  have h_img : (fun u : ℝ => u⁻¹) '' Set.Ioi (1 : ℝ) = Set.Ioo (0 : ℝ) 1 := by
    rw [Set.image_inv_eq_inv, Set.inv_Ioi₀ zero_lt_one, inv_one]
  rw [← h_img]
  have h_deriv : ∀ u ∈ Set.Ioi (1 : ℝ),
      HasDerivWithinAt (fun x : ℝ => x⁻¹) (-(u ^ 2)⁻¹) (Set.Ioi (1 : ℝ)) u := by
    intro u hu
    have hu_pos : 0 < u := lt_trans zero_lt_one hu
    exact (hasDerivAt_inv (ne_of_gt hu_pos)).hasDerivWithinAt
  rw [MeasureTheory.integral_image_eq_integral_abs_deriv_smul measurableSet_Ioi h_deriv inv_injective.injOn]
  refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun u hu => ?_)
  dsimp only
  have hu_pos : 0 < u := lt_trans zero_lt_one hu
  have hu_nn : 0 ≤ u := le_of_lt hu_pos
  have hu_c_ne : (u : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hu_pos)
