        (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → (χ_gr I) ^ 2 = χ₀ I) :=
by
  classical
  let n : ℕ := Module.finrank ℚ K
  let r : ℕ := NumberField.Units.rank K
  let Ω : Fin r → ℝ := fun j =>
    2 * Real.pi * (θ₀ j - (m_freq j : ℝ)) +
      ∑ w : NumberField.InfinitePlace K,
        (l_ang w : ℝ) *
          (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg
  let B_R : Module.Basis (Fin r) ℝ (NumberField.Units.dirichletUnitTheorem.logSpace K) :=
    Module.Basis.ofZLatticeBasis ℝ
      (NumberField.Units.unitLattice K)
      (NumberField.Units.basisUnitLattice K)
  have hn_pos : (0 : ℝ) < (n : ℝ) := by
    dsimp [n]
    exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
  have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  have h_sum_mult : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ)) = (n : ℝ) := by
    dsimp [n]
    exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
  
  let ℓ : NumberField.RingOfIntegers K → NumberField.InfinitePlace K → ℝ :=
    fun x w => Real.log (w (x : K)) -
      (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * Real.log (v (x : K))) / (n : ℝ)
  let L_vec : NumberField.RingOfIntegers K → NumberField.Units.dirichletUnitTheorem.logSpace K :=
    fun x w => (w.1.mult : ℝ) * ℓ x w.1
  let W₀ : NumberField.RingOfIntegers K → Fin r → ℝ :=
    fun x j => B_R.repr (L_vec x) j
  have hW₀_log : ∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
      ∀ w : NumberField.InfinitePlace K,
        Real.log (w (x : K) / w₀ (x : K)) =
          ∑ j : Fin r,
            W₀ x j *
              Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) := by
    intro x hx w
    let r_x : NumberField.InfinitePlace K → ℝ :=
      fun v => ∑ j : Fin r, W₀ x j *
        Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))
    let w_dir : NumberField.InfinitePlace K := NumberField.Units.dirichletUnitTheorem.w₀
    have h_ne_dir : ∀ v : NumberField.InfinitePlace K, v ≠ w_dir →
        (v.mult : ℝ) * ℓ x v = (v.mult : ℝ) * r_x v := by
      intro v hv
      let v_sub : {v : NumberField.InfinitePlace K // v ≠ w_dir} := ⟨v, hv⟩
      have h_basis := congr_fun (Module.Basis.sum_repr B_R (L_vec x)).symm v_sub
      change (v.mult : ℝ) * ℓ x v = (∑ j : Fin r, (W₀ x j) • B_R j) v_sub at h_basis
      rw [h_basis]
      have h_eval : (∑ j : Fin r, (W₀ x j) • B_R j) v_sub =
          ∑ j : Fin r, W₀ x j * (B_R j v_sub) := by
        simp [Finset.sum_apply]
      rw [h_eval]
      dsimp [r_x]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      have hB_j : B_R j v_sub =
          (v.mult : ℝ) *
            Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) := by
        dsimp [B_R]
        rw [Module.Basis.ofZLatticeBasis_apply, ← NumberField.Units.logEmbedding_fundSystem,
          NumberField.Units.dirichletUnitTheorem.logEmbedding_component]
      rw [hB_j]
      ring
    have h_sum_ℓ : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * ℓ x v) = 0 := by
      dsimp [ℓ]
      simp_rw [mul_sub]
      rw [Finset.sum_sub_distrib, ← Finset.sum_mul, h_sum_mult, mul_div_cancel₀ _ hn_ne, sub_self]
    have h_sum_r : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * r_x v) = 0 := by
      dsimp [r_x]
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_eq_zero (fun j _ => ?_)
      have h_comm : (∑ v : NumberField.InfinitePlace K,
          (v.mult : ℝ) * (W₀ x j *
            Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)))) =
          W₀ x j * (∑ v : NumberField.InfinitePlace K,
            (v.mult : ℝ) *
              Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun v _ => by ring)
      rw [h_comm]
      have h_unit_sum : (∑ v : NumberField.InfinitePlace K,
          (v.mult : ℝ) *
            Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) = 0 := by
        simpa using NumberField.Units.sum_mult_mul_log (NumberField.Units.fundSystem K j)
      rw [h_unit_sum, mul_zero]
    have h_all_mult : ∀ v : NumberField.InfinitePlace K,
