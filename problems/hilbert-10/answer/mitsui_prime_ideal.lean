        exact MeasureTheory.lintegral_mono h_pt_le1
      have h_lint2 : MeasureTheory.volume (V_cplx R₁ \ V_cplx R₀) ≤
          ENNReal.ofReal ((R₁ ^ 2 - R₀ ^ 2) / 2) * MeasureTheory.volume S_cplx +
            MeasureTheory.volume D_col := by
        rw [← h_cyl_int, h_vol_diff_eq, h_vol_polar D_col hD_meas,
            ← MeasureTheory.lintegral_add_left h_meas_cyl_ind]
        exact MeasureTheory.lintegral_mono h_pt_le2
      have h_toReal1 := ENNReal.toReal_mono (ENNReal.add_ne_top.mpr ⟨h_exact_ne_top, hD_ne_top⟩) h_lint1
      have h_toReal2 := ENNReal.toReal_mono (ENNReal.add_ne_top.mpr ⟨h_cyl_ne_top, hD_ne_top⟩) h_lint2
      rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal (by nlinarith [hR₀₁_sq]),
          ENNReal.toReal_add h_exact_ne_top hD_ne_top] at h_toReal1
      rw [ENNReal.toReal_add h_cyl_ne_top hD_ne_top, ENNReal.toReal_mul,
          ENNReal.toReal_ofReal (by nlinarith [hR₀₁_sq])] at h_toReal2
      refine ⟨hV_mono, ?_, ?_⟩
      · rw [hV_diff]
        exact h_vol_diff_le
      · rw [hV_diff, abs_le]
        exact ⟨by linarith, by linarith⟩
    have h_collar_sum :
        (∑ j : Fin L,
          (MeasureTheory.volume {p : ℝ × ℝ |
            (((p.1 ∈ Set.Icc (a₀ - ε) (a₀ + ε) ∨ p.1 ∈ Set.Icc (b₀ - ε) (b₀ + ε)) ∧
                p.2 ∈ Set.Icc (-X) X) ∨
             (p.1 ∈ Set.Icc (-X) X ∧
                (p.2 ∈ Set.Icc (a₁ - ε) (a₁ + ε) ∨ p.2 ∈ Set.Icc (b₁ - ε) (b₁ + ε)))) ∧
            ((X / (L : ℝ)) * ((j : ℕ) : ℝ)) ^ 2 ≤ p.1 ^ 2 + p.2 ^ 2 ∧
            p.1 ^ 2 + p.2 ^ 2 < ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ^ 2}).toReal) ≤
        16 * ε * X := by
      let K₁ : Set (ℝ × ℝ) := Set.Icc (a₀ - ε) (a₀ + ε) ×ˢ Set.Icc (-X) X
      let K₂ : Set (ℝ × ℝ) := Set.Icc (b₀ - ε) (b₀ + ε) ×ˢ Set.Icc (-X) X
      let K₃ : Set (ℝ × ℝ) := Set.Icc (-X) X ×ˢ Set.Icc (a₁ - ε) (a₁ + ε)
      let K₄ : Set (ℝ × ℝ) := Set.Icc (-X) X ×ˢ Set.Icc (b₁ - ε) (b₁ + ε)
      let C_cplx : Set (ℝ × ℝ) := (K₁ ∪ K₂) ∪ (K₃ ∪ K₄)
      let D_col : Fin L → Set (ℝ × ℝ) := fun j =>
        {p : ℝ × ℝ |
          (((p.1 ∈ Set.Icc (a₀ - ε) (a₀ + ε) ∨ p.1 ∈ Set.Icc (b₀ - ε) (b₀ + ε)) ∧
              p.2 ∈ Set.Icc (-X) X) ∨
           (p.1 ∈ Set.Icc (-X) X ∧
              (p.2 ∈ Set.Icc (a₁ - ε) (a₁ + ε) ∨ p.2 ∈ Set.Icc (b₁ - ε) (b₁ + ε)))) ∧
          ((X / (L : ℝ)) * ((j : ℕ) : ℝ)) ^ 2 ≤ p.1 ^ 2 + p.2 ^ 2 ∧
          p.1 ^ 2 + p.2 ^ 2 < ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ^ 2}
      have hD_sub : ∀ j : Fin L, D_col j ⊆ C_cplx := by
        intro j p hp
        rcases hp.1 with ⟨h1 | h2, h3⟩ | ⟨h1, h2 | h3⟩
        · exact Or.inl (Or.inl ⟨h1, h3⟩)
        · exact Or.inl (Or.inr ⟨h2, h3⟩)
        · exact Or.inr (Or.inl ⟨h1, h2⟩)
        · exact Or.inr (Or.inr ⟨h1, h3⟩)
      have h_strip_vol : ∀ (u v : ℝ),
          MeasureTheory.volume (Set.Icc (u - ε) (u + ε) ×ˢ Set.Icc (-v) v) =
            ENNReal.ofReal (2 * ε) * ENNReal.ofReal (2 * v) := by
        intro u v
        rw [MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod,
            Real.volume_Icc, Real.volume_Icc]
        have h1 : (u + ε) - (u - ε) = 2 * ε := by ring
        have h2 : v - (-v) = 2 * v := by ring
        rw [h1, h2]
      have h_strip_vol' : ∀ (u v : ℝ),
          MeasureTheory.volume (Set.Icc (-v) v ×ˢ Set.Icc (u - ε) (u + ε)) =
            ENNReal.ofReal (2 * v) * ENNReal.ofReal (2 * ε) := by
        intro u v
        rw [MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod,
            Real.volume_Icc, Real.volume_Icc]
        have h1 : (u + ε) - (u - ε) = 2 * ε := by ring
        have h2 : v - (-v) = 2 * v := by ring
        rw [h1, h2]
      have hK1 : MeasureTheory.volume K₁ = ENNReal.ofReal (4 * ε * X) := by
        dsimp [K₁]
        rw [h_strip_vol, ← ENNReal.ofReal_mul (by positivity)]
        congr 1; ring
      have hK2 : MeasureTheory.volume K₂ = ENNReal.ofReal (4 * ε * X) := by
        dsimp [K₂]
        rw [h_strip_vol, ← ENNReal.ofReal_mul (by positivity)]
        congr 1; ring
      have hK3 : MeasureTheory.volume K₃ = ENNReal.ofReal (4 * ε * X) := by
        dsimp [K₃]
        rw [h_strip_vol', ← ENNReal.ofReal_mul (by positivity)]
        congr 1; ring
      have hK4 : MeasureTheory.volume K₄ = ENNReal.ofReal (4 * ε * X) := by
        dsimp [K₄]
        rw [h_strip_vol', ← ENNReal.ofReal_mul (by positivity)]
        congr 1; ring
      have hC_vol : MeasureTheory.volume C_cplx ≤ ENNReal.ofReal (16 * ε * X) := by
        calc MeasureTheory.volume C_cplx
          _ ≤ MeasureTheory.volume (K₁ ∪ K₂) + MeasureTheory.volume (K₃ ∪ K₄) :=
              MeasureTheory.measure_union_le _ _
          _ ≤ (MeasureTheory.volume K₁ + MeasureTheory.volume K₂) +
              (MeasureTheory.volume K₃ + MeasureTheory.volume K₄) :=
              add_le_add (MeasureTheory.measure_union_le _ _) (MeasureTheory.measure_union_le _ _)
          _ = (ENNReal.ofReal (4 * ε * X) + ENNReal.ofReal (4 * ε * X)) +
              (ENNReal.ofReal (4 * ε * X) + ENNReal.ofReal (4 * ε * X)) := by
              rw [hK1, hK2, hK3, hK4]
          _ = ENNReal.ofReal (16 * ε * X) := by
              rw [← ENNReal.ofReal_add (by positivity) (by positivity),
                  ← ENNReal.ofReal_add (by positivity) (by positivity)]
              congr 1; ring
      have hC_ne_top : MeasureTheory.volume C_cplx ≠ ⊤ :=
        ne_top_of_le_ne_top ENNReal.ofReal_ne_top hC_vol
      have hD_ne_top : ∀ j : Fin L, MeasureTheory.volume (D_col j) ≠ ⊤ := fun j =>
        ne_top_of_le_ne_top hC_ne_top (MeasureTheory.measure_mono (hD_sub j))
      have hC_meas : MeasurableSet C_cplx := by
        dsimp [C_cplx, K₁, K₂, K₃, K₄]
        exact ((measurableSet_Icc.prod measurableSet_Icc).union
          (measurableSet_Icc.prod measurableSet_Icc)).union
          ((measurableSet_Icc.prod measurableSet_Icc).union
          (measurableSet_Icc.prod measurableSet_Icc))
      have hD_eq : ∀ j : Fin L, D_col j = C_cplx ∩
          {p : ℝ × ℝ | ((X / (L : ℝ)) * ((j : ℕ) : ℝ)) ^ 2 ≤ p.1 ^ 2 + p.2 ^ 2 ∧
            p.1 ^ 2 + p.2 ^ 2 < ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ^ 2} := by
        intro j
        ext p
        simp only [D_col, C_cplx, K₁, K₂, K₃, K₄, Set.mem_setOf_eq, Set.mem_inter_iff,
          Set.mem_union, Set.mem_prod]
        tauto
      have hD_meas : ∀ j : Fin L, MeasurableSet (D_col j) := by
        intro j
        rw [hD_eq j]
        refine hC_meas.inter ?_
        have h_cont : Continuous (fun p : ℝ × ℝ => p.1 ^ 2 + p.2 ^ 2) := by fun_prop
        exact (measurableSet_le measurable_const h_cont.measurable).inter
          (measurableSet_lt h_cont.measurable measurable_const)
      have h_disj : Set.PairwiseDisjoint (↑(Finset.univ : Finset (Fin L))) D_col := by
        intro j₁ _ j₂ _ hj
        rw [Function.onFun, Set.disjoint_left]
        intro p hp1 hp2
        have h_lt_or_gt : (j₁ : ℕ) < (j₂ : ℕ) ∨ (j₂ : ℕ) < (j₁ : ℕ) :=
          lt_or_gt_of_ne (Fin.val_ne_of_ne hj)
        rcases h_lt_or_gt with hlt | hgt
        · have hle : ((j₁ : ℕ) : ℝ) + 1 ≤ ((j₂ : ℕ) : ℝ) := by exact_mod_cast hlt
          have hR_le : (X / (L : ℝ)) * (((j₁ : ℕ) : ℝ) + 1) ≤ (X / (L : ℝ)) * ((j₂ : ℕ) : ℝ) :=
            mul_le_mul_of_nonneg_left hle (by positivity)
          have hsq_le : ((X / (L : ℝ)) * (((j₁ : ℕ) : ℝ) + 1)) ^ 2 ≤ ((X / (L : ℝ)) * ((j₂ : ℕ) : ℝ)) ^ 2 :=
            pow_le_pow_left₀ (by positivity) hR_le 2
          linarith [hp1.2.2, hp2.2.1]
        · have hle : ((j₂ : ℕ) : ℝ) + 1 ≤ ((j₁ : ℕ) : ℝ) := by exact_mod_cast hgt
          have hR_le : (X / (L : ℝ)) * (((j₂ : ℕ) : ℝ) + 1) ≤ (X / (L : ℝ)) * ((j₁ : ℕ) : ℝ) :=
            mul_le_mul_of_nonneg_left hle (by positivity)
          have hsq_le : ((X / (L : ℝ)) * (((j₂ : ℕ) : ℝ) + 1)) ^ 2 ≤ ((X / (L : ℝ)) * ((j₁ : ℕ) : ℝ)) ^ 2 :=
            pow_le_pow_left₀ (by positivity) hR_le 2
          linarith [hp2.2.2, hp1.2.1]
      have h_sum_eq : (∑ j : Fin L, (MeasureTheory.volume (D_col j)).toReal) =
          (MeasureTheory.volume (⋃ j ∈ (Finset.univ : Finset (Fin L)), D_col j)).toReal := by
        rw [← ENNReal.toReal_sum (fun j _ => hD_ne_top j),
            MeasureTheory.measure_biUnion_finset h_disj (fun j _ => hD_meas j)]
      change (∑ j : Fin L, (MeasureTheory.volume (D_col j)).toReal) ≤ 16 * ε * X
      rw [h_sum_eq]
      have h_biUnion_sub : (⋃ j ∈ (Finset.univ : Finset (Fin L)), D_col j) ⊆ C_cplx := by
        intro p hp
        simp only [Set.mem_iUnion] at hp
        rcases hp with ⟨j, _, hpj⟩
        exact hD_sub j hpj
      have h_vol_le : MeasureTheory.volume (⋃ j ∈ (Finset.univ : Finset (Fin L)), D_col j) ≤
          ENNReal.ofReal (16 * ε * X) :=
        le_trans (MeasureTheory.measure_mono h_biUnion_sub) hC_vol
      have h_toReal := ENNReal.toReal_mono ENNReal.ofReal_ne_top h_vol_le
      rwa [ENNReal.toReal_ofReal (by positivity)] at h_toReal
    have h_shell : ∀ j : Fin L,
        0 ≤ (X / (L : ℝ)) * ((j : ℕ) : ℝ) ∧
        (X / (L : ℝ)) * ((j : ℕ) : ℝ) ≤ (X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1) ∧
        (X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1) ≤ X ∧
        (X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1) - (X / (L : ℝ)) * ((j : ℕ) : ℝ) ≤ ε := by
      intro j
      have hj_le : ((j : ℕ) : ℝ) + 1 ≤ (L : ℝ) := by exact_mod_cast Nat.succ_le_of_lt j.2
      refine ⟨by positivity, ?_, ?_, ?_⟩
      · exact mul_le_mul_of_nonneg_left (by linarith) (by positivity)
      · calc (X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)
          _ ≤ (X / (L : ℝ)) * (L : ℝ) := mul_le_mul_of_nonneg_left hj_le (by positivity)
          _ = X := div_mul_cancel₀ X (ne_of_gt hL_pos)
      · dsimp [ε]; linarith
    refine ⟨?_, ?_⟩
    · intro j
      obtain ⟨hR0, hR01, hR1X, h_diff⟩ := h_shell j
      have hs2 := h_single_shell
        ((X / (L : ℝ)) * ((j : ℕ) : ℝ)) ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1))
        hR0 hR01 hR1X h_diff
      refine ⟨hs2.1, le_trans hs2.2.1 ?_⟩
      set R₀ : ℝ := (X / (L : ℝ)) * ((j : ℕ) : ℝ)
      set R₁ : ℝ := (X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)
      have h_sq_diff : R₁ ^ 2 - R₀ ^ 2 = (R₁ + R₀) * (X / (L : ℝ)) := by
        dsimp [R₀, R₁]; ring
      have h_sum_le : R₁ + R₀ ≤ 2 * X := by linarith
      have h_pi_pos : 0 ≤ Real.pi := le_of_lt Real.pi_pos
      calc Real.pi * (R₁ ^ 2 - R₀ ^ 2)
        _ = Real.pi * ((R₁ + R₀) * (X / (L : ℝ))) := by rw [h_sq_diff]
        _ ≤ Real.pi * ((2 * X) * (X / (L : ℝ))) :=
            mul_le_mul_of_nonneg_left
              (mul_le_mul_of_nonneg_right h_sum_le (by positivity)) h_pi_pos
        _ = (2 * Real.pi * X ^ 2) / (L : ℝ) := by ring
        _ ≤ (2 * Real.pi * (4 * X) ^ 2) / (L : ℝ) :=
            div_le_div_of_nonneg_right (by nlinarith) (le_of_lt hL_pos)
    · have h_each : ∀ j : Fin L,
          |((((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ^ 2 - ((X / (L : ℝ)) * ((j : ℕ) : ℝ)) ^ 2) / 2 *
            (MeasureTheory.volume {θ : ℝ |
              θ ∈ Set.Ioo (-Real.pi) Real.pi ∧
              ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) * Real.cos θ ∈ Set.Ico a₀ b₀ ∧
              ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) * Real.sin θ ∈ Set.Ico a₁ b₁}).toReal -
            ((MeasureTheory.volume {p : ℝ × ℝ |
              p.1 ^ 2 + p.2 ^ 2 < ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ^ 2 ∧
              p.1 ∈ Set.Ico a₀ b₀ ∧ p.2 ∈ Set.Ico a₁ b₁}).toReal -
             (MeasureTheory.volume {p : ℝ × ℝ |
              p.1 ^ 2 + p.2 ^ 2 < ((X / (L : ℝ)) * ((j : ℕ) : ℝ)) ^ 2 ∧
              p.1 ∈ Set.Ico a₀ b₀ ∧ p.2 ∈ Set.Ico a₁ b₁}).toReal))| ≤
          (MeasureTheory.volume {p : ℝ × ℝ |
            (((p.1 ∈ Set.Icc (a₀ - ε) (a₀ + ε) ∨ p.1 ∈ Set.Icc (b₀ - ε) (b₀ + ε)) ∧
                p.2 ∈ Set.Icc (-X) X) ∨
             (p.1 ∈ Set.Icc (-X) X ∧
                (p.2 ∈ Set.Icc (a₁ - ε) (a₁ + ε) ∨ p.2 ∈ Set.Icc (b₁ - ε) (b₁ + ε)))) ∧
            ((X / (L : ℝ)) * ((j : ℕ) : ℝ)) ^ 2 ≤ p.1 ^ 2 + p.2 ^ 2 ∧
            p.1 ^ 2 + p.2 ^ 2 < ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ^ 2}).toReal := by
        intro j
        obtain ⟨hR0, hR01, hR1X, h_diff⟩ := h_shell j
        exact (h_single_shell
          ((X / (L : ℝ)) * ((j : ℕ) : ℝ)) ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1))
          hR0 hR01 hR1X h_diff).2.2
      calc (∑ j : Fin L, _)
        _ ≤ ∑ j : Fin L, _ := Finset.sum_le_sum (fun j _ => h_each j)
        _ ≤ 16 * ε * X := h_collar_sum
        _ = (16 * X ^ 2) / (L : ℝ) := by dsimp [ε]; ring
        _ ≤ (16 * (4 * X) ^ 2) / (L : ℝ) :=
            div_le_div_of_nonneg_right (by nlinarith) (le_of_lt hL_pos)

theorem mitsui_finset_prod_diff_sum_erase_bound {ι : Type u} [Fintype ι] [DecidableEq ι]
    (A B M : ι → ℝ) (η : ℝ) (hη : 0 ≤ η)
    (h_bounds : ∀ w : ι, 0 ≤ A w ∧ A w ≤ B w ∧ B w ≤ M w ∧ B w - A w ≤ η * M w) :
    |(∑ w₀ : ι, (B w₀ - A w₀) * ∏ w ∈ Finset.univ.erase w₀, B w) -
      ((∏ w : ι, B w) - ∏ w : ι, A w)| ≤
    (Fintype.card ι : ℝ) ^ 2 * η ^ 2 * ∏ w : ι, M w :=
by
  have hA_nonneg : ∀ w, 0 ≤ A w := fun w => (h_bounds w).1
  have hAB : ∀ w, A w ≤ B w := fun w => (h_bounds w).2.1
  have hBM : ∀ w, B w ≤ M w := fun w => (h_bounds w).2.2.1
  have hBA_le : ∀ w, B w - A w ≤ η * M w := fun w => (h_bounds w).2.2.2
  have hB_nonneg : ∀ w, 0 ≤ B w := fun w => le_trans (hA_nonneg w) (hAB w)
  have hM_nonneg : ∀ w, 0 ≤ M w := fun w => le_trans (hB_nonneg w) (hBM w)
  have hAM : ∀ w, A w ≤ M w := fun w => le_trans (hAB w) (hBM w)
  have hBA_nonneg : ∀ w, 0 ≤ B w - A w := fun w => sub_nonneg.mpr (hAB w)
  let S₁ (s : Finset ι) : ℝ := ∑ w₀ ∈ s, (B w₀ - A w₀) * ∏ w ∈ s.erase w₀, B w
  let D (s : Finset ι) : ℝ := (∏ w ∈ s, B w) - ∏ w ∈ s, A w
  let P_B (s : Finset ι) : ℝ := ∏ w ∈ s, B w
  let P_M (s : Finset ι) : ℝ := ∏ w ∈ s, M w
  have hPB_nonneg : ∀ s : Finset ι, 0 ≤ P_B s :=
    fun s => Finset.prod_nonneg (fun w _ => hB_nonneg w)
  have hPM_nonneg : ∀ s : Finset ι, 0 ≤ P_M s :=
    fun s => Finset.prod_nonneg (fun w _ => hM_nonneg w)
  have hPB_le_PM : ∀ s : Finset ι, P_B s ≤ P_M s :=
    fun s => Finset.prod_le_prod (fun w _ => hB_nonneg w) (fun w _ => hBM w)
  have h_ind : ∀ s : Finset ι,
      0 ≤ D s ∧
      D s ≤ (s.card : ℝ) * η * P_M s ∧
      0 ≤ S₁ s - D s ∧
      S₁ s - D s ≤ (s.card : ℝ) ^ 2 * η ^ 2 * P_M s := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      simp [S₁, D, P_M]
    | @insert a s ha ih =>
      rcases ih with ⟨hD_nonneg, hD_le, hSD_nonneg, hSD_le⟩
      have hPM_ins : P_M (insert a s) = M a * P_M s := Finset.prod_insert ha
      have hcard_ins : ((insert a s).card : ℝ) = (s.card : ℝ) + 1 := by
        rw [Finset.card_insert_of_notMem ha, Nat.cast_add, Nat.cast_one]
      have hD_ins : D (insert a s) = (B a - A a) * P_B s + A a * D s := by
        dsimp [D, P_B]
        rw [Finset.prod_insert ha, Finset.prod_insert ha]
        ring
      have hS₁_ins : S₁ (insert a s) = (B a - A a) * P_B s + B a * S₁ s := by
        dsimp [S₁, P_B]
        rw [Finset.sum_insert ha, Finset.erase_insert ha]
        congr 1
        have h_sum_eq :
            (∑ w₀ ∈ s, (B w₀ - A w₀) * ∏ w ∈ (insert a s).erase w₀, B w) =
            ∑ w₀ ∈ s, B a * ((B w₀ - A w₀) * ∏ w ∈ s.erase w₀, B w) := by
          refine Finset.sum_congr rfl (fun w₀ hw₀ => ?_)
          have hne : a ≠ w₀ := (ne_of_mem_of_not_mem hw₀ ha).symm
          have ha_not_erase : a ∉ s.erase w₀ := fun hmem => ha (Finset.mem_of_mem_erase hmem)
          rw [Finset.erase_insert_of_ne hne, Finset.prod_insert ha_not_erase]
          ring
        rw [h_sum_eq, ← Finset.mul_sum]
      have hSD_ins : S₁ (insert a s) - D (insert a s) =
          B a * (S₁ s - D s) + (B a - A a) * D s := by
        rw [hS₁_ins, hD_ins]
        ring
      set k : ℝ := (s.card : ℝ)
      have hk_nonneg : 0 ≤ k := Nat.cast_nonneg s.card
      have hBa_nonneg := hB_nonneg a
      have hAa_nonneg := hA_nonneg a
      have hMa_nonneg := hM_nonneg a
      have hBAa_nonneg := hBA_nonneg a
      have hPBs_nonneg := hPB_nonneg s
      have hPMs_nonneg := hPM_nonneg s
      have hD_ins_nonneg : 0 ≤ D (insert a s) := by
        rw [hD_ins]
        positivity
      have hD_ins_le : D (insert a s) ≤ ((insert a s).card : ℝ) * η * P_M (insert a s) := by
        rw [hD_ins, hcard_ins, hPM_ins]
        have h1 : (B a - A a) * P_B s ≤ (η * M a) * P_M s :=
          mul_le_mul (hBA_le a) (hPB_le_PM s) hPBs_nonneg (by positivity)
        have h2 : A a * D s ≤ M a * (k * η * P_M s) :=
          mul_le_mul (hAM a) hD_le hD_nonneg hMa_nonneg
        calc (B a - A a) * P_B s + A a * D s
          _ ≤ (η * M a) * P_M s + M a * (k * η * P_M s) := add_le_add h1 h2
          _ = (k + 1) * η * (M a * P_M s) := by ring
      have hSD_ins_nonneg : 0 ≤ S₁ (insert a s) - D (insert a s) := by
        rw [hSD_ins]
        positivity
      have hSD_ins_le : S₁ (insert a s) - D (insert a s) ≤
          ((insert a s).card : ℝ) ^ 2 * η ^ 2 * P_M (insert a s) := by
        rw [hSD_ins, hcard_ins, hPM_ins]
        have h1 : B a * (S₁ s - D s) ≤ M a * (k ^ 2 * η ^ 2 * P_M s) :=
          mul_le_mul (hBM a) hSD_le hSD_nonneg hMa_nonneg
        have h2 : (B a - A a) * D s ≤ (η * M a) * (k * η * P_M s) :=
          mul_le_mul (hBA_le a) hD_le hD_nonneg (by positivity)
        have hk_sq : k ^ 2 + k ≤ (k + 1) ^ 2 := by nlinarith
        calc B a * (S₁ s - D s) + (B a - A a) * D s
          _ ≤ M a * (k ^ 2 * η ^ 2 * P_M s) + (η * M a) * (k * η * P_M s) := add_le_add h1 h2
          _ = (k ^ 2 + k) * (η ^ 2 * M a * P_M s) := by ring
          _ ≤ (k + 1) ^ 2 * (η ^ 2 * M a * P_M s) :=
              mul_le_mul_of_nonneg_right hk_sq (by positivity)
          _ = (k + 1) ^ 2 * η ^ 2 * (M a * P_M s) := by ring
      exact ⟨hD_ins_nonneg, hD_ins_le, hSD_ins_nonneg, hSD_ins_le⟩
  rcases h_ind Finset.univ with ⟨_, _, hSD_univ_nonneg, hSD_univ_le⟩
  change |S₁ Finset.univ - D Finset.univ| ≤ (Fintype.card ι : ℝ) ^ 2 * η ^ 2 * P_M Finset.univ
  rw [abs_of_nonneg hSD_univ_nonneg, ← Finset.card_univ]
  exact hSD_univ_le

theorem mitsui_grid_cube_conical_shell_main_term_sum_bound {K : Type u} [Field K] [NumberField K] :
    ∃ c_sum : ℝ, 0 < c_sum ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m →
          ∀ L : ℕ, 1 ≤ L →
            ∀ k : NumberField.mixedEmbedding.index K → Fin (2 * m),
              (∀ z : NumberField.mixedEmbedding.mixedSpace K,
                  (∀ i : NumberField.mixedEmbedding.index K,
                    (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
                      Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                        ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) →
                  ∀ w : NumberField.InfinitePlace K,
                    NumberField.mixedEmbedding.normAtPlace w z < X) →
              |(∑ w₀ : NumberField.InfinitePlace K,
                  ∑ j : Fin L,
                    (((if 1 < (X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1) then (1 : ℝ) else 0) -
                      (if 1 < (X / (L : ℝ)) * ((j : ℕ) : ℝ)
                       then (((X / (L : ℝ)) * ((j : ℕ) : ℝ)) / ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1))) ^ (Module.finrank ℚ K)
                       else 0)) *
                     ((Module.finrank ℚ K : ℝ)⁻¹ *
                       ∏ w : NumberField.InfinitePlace K,
                         (MeasureTheory.volume {p : ℝ × ℝ |
                           (w = w₀ ∧
                             p.1 ∈ Set.Ioo (0 : ℝ) (((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ^ w.mult) ∧
                             ((∃ hw : w.IsReal,
                                 (p.2 ∈ Set.Ioo (0 : ℝ) 1 ∧
                                   (X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1) ∈
                                     Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                       ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1))) ∨
                                 (p.2 ∈ Set.Ioo (1 : ℝ) 2 ∧
                                   -((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ∈
                                     Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                       ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)))) ∨
                               (∃ hc : w.IsComplex,
                                 p.2 ∈ Set.Ioo (-Real.pi) Real.pi ∧
                                 ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) * Real.cos p.2 ∈
                                   Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                                     ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
                                 ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) * Real.sin p.2 ∈
                                   Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                                     ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1))))) ∨
                           (w ≠ w₀ ∧
                             ((∃ hw : w.IsReal,
                                 p.1 ∈ Set.Ioo (-((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1))) ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ∧
                                 p.1 ∈
                                   Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                     ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
                                 p.2 ∈ Set.Ioo (0 : ℝ) 1) ∨
                               (∃ hc : w.IsComplex,
                                 p.1 ^ 2 + p.2 ^ 2 < ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ^ 2 ∧
                                 p.1 ∈
                                   Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                                     ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
                                 p.2 ∈
                                   Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                                     ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1)))))}).toReal)))
                - (X / (m : ℝ)) ^ (Module.finrank ℚ K)|
                ≤ c_sum * X ^ (Module.finrank ℚ K) * ((Real.log X + 1) / (L : ℝ)) +
                  c_sum * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_sum) :=
by
  classical
  set n : ℕ := Module.finrank ℚ K
  have hn_pos : 0 < n := Module.finrank_pos
  have hn_ge_one : 1 ≤ n := hn_pos
  have hn_rpos : (0 : ℝ) < (n : ℝ) := Nat.cast_pos.mpr hn_pos
  have hn_rge_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn_ge_one
  set M : ℕ := Fintype.card (NumberField.InfinitePlace K)
  have hM_pos : 0 < M := Fintype.card_pos
  have hM_rpos : (0 : ℝ) < (M : ℝ) := Nat.cast_pos.mpr hM_pos
  let A₁ : ℝ := 2 * Real.pi * (M : ℝ) * (4 : ℝ) ^ n * (n : ℝ)
  let A₂ : ℝ := 16 * (M : ℝ) * (4 : ℝ) ^ n
  let A₃ : ℝ := 4 * Real.pi ^ 2 * (M : ℝ) ^ 2 * (4 : ℝ) ^ n
  let A_exp : ℝ := 4 * Real.pi * (M : ℝ) * (4 : ℝ) ^ n * Real.exp 1
  let c_sum : ℝ := 1 + A₁ + A₂ + A₃ + A_exp
  have hA₁_pos : 0 < A₁ := by dsimp [A₁]; positivity
  have hA₂_pos : 0 < A₂ := by dsimp [A₂]; positivity
  have hA₃_pos : 0 < A₃ := by dsimp [A₃]; positivity
  have hA_exp_pos : 0 < A_exp := by dsimp [A_exp]; positivity
  have hc_sum_ge_one : 1 ≤ c_sum := by
    have : 0 ≤ A₁ + A₂ + A₃ + A_exp := by positivity
    dsimp [c_sum]; linarith
  have hc_sum_pos : 0 < c_sum := lt_of_lt_of_le zero_lt_one hc_sum_ge_one
  refine ⟨c_sum, hc_sum_pos, ?_⟩
  intro X hX m hm L hL k hQ_bdd
  have hX_pos : 0 < X := lt_trans zero_lt_one hX
  have hX_nonneg : 0 ≤ X := le_of_lt hX_pos
  have hlog_pos : 0 < Real.log X := Real.log_pos hX
  have hL_rpos : (0 : ℝ) < (L : ℝ) := Nat.cast_pos.mpr hL
  have hL_rge_one : (1 : ℝ) ≤ (L : ℝ) := by exact_mod_cast hL
  have hL_rne : (L : ℝ) ≠ 0 := ne_of_gt hL_rpos
  set Y : ℝ := X ^ n
  have hY_pos : 0 < Y := by dsimp [Y]; positivity
  have hY_nonneg : 0 ≤ Y := le_of_lt hY_pos
  let U : ℝ → NumberField.InfinitePlace K → NumberField.InfinitePlace K → Set (ℝ × ℝ) :=
    fun R w₀ w =>
      {p : ℝ × ℝ |
        (w = w₀ ∧
          p.1 ∈ Set.Ioo (0 : ℝ) (R ^ w.mult) ∧
          ((∃ hw : w.IsReal,
              (p.2 ∈ Set.Ioo (0 : ℝ) 1 ∧
                R ∈
                  Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                    ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1))) ∨
              (p.2 ∈ Set.Ioo (1 : ℝ) 2 ∧
                -R ∈
                  Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                    ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)))) ∨
            (∃ hc : w.IsComplex,
              p.2 ∈ Set.Ioo (-Real.pi) Real.pi ∧
              R * Real.cos p.2 ∈
                Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
              R * Real.sin p.2 ∈
                Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1))))) ∨
        (w ≠ w₀ ∧
          ((∃ hw : w.IsReal,
              p.1 ∈ Set.Ioo (-R) R ∧
              p.1 ∈
                Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
              p.2 ∈ Set.Ioo (0 : ℝ) 1) ∨
            (∃ hc : w.IsComplex,
              p.1 ^ 2 + p.2 ^ 2 < R ^ 2 ∧
              p.1 ∈
                Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
              p.2 ∈
                Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1)))))}
  let V : NumberField.InfinitePlace K → ℝ → Set (ℝ × ℝ) :=
    fun w R =>
      {p : ℝ × ℝ |
        (∃ hw : w.IsReal,
            p.1 ∈ Set.Ioo (-R) R ∧
            p.1 ∈
              Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
            p.2 ∈ Set.Ioo (0 : ℝ) 1) ∨
        (∃ hc : w.IsComplex,
            p.1 ^ 2 + p.2 ^ 2 < R ^ 2 ∧
            p.1 ∈
              Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
            p.2 ∈
              Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1)))}
  let S : NumberField.InfinitePlace K → ℝ → Set ℝ :=
    fun w R =>
      {θ : ℝ |
        (∃ hw : w.IsReal,
            (θ ∈ Set.Ioo (0 : ℝ) 1 ∧
              R ∈
                Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1))) ∨
            (θ ∈ Set.Ioo (1 : ℝ) 2 ∧
              -R ∈
                Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)))) ∨
        (∃ hc : w.IsComplex,
            θ ∈ Set.Ioo (-Real.pi) Real.pi ∧
            R * Real.cos θ ∈
              Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
            R * Real.sin θ ∈
              Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1)))}
  let F : NumberField.InfinitePlace K → ℝ → ℝ := fun w R => (MeasureTheory.volume (V w R)).toReal
  let G : NumberField.InfinitePlace K → ℝ → ℝ := fun w R => (MeasureTheory.volume (S w R)).toReal
  let R_seq : ℕ → ℝ := fun i => (X / (L : ℝ)) * (i : ℝ)
  let R₀ : Fin L → ℝ := fun j => (X / (L : ℝ)) * ((j : ℕ) : ℝ)
  let R₁ : Fin L → ℝ := fun j => (X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)
  have hF_nonneg : ∀ w R, 0 ≤ F w R := fun _ _ => ENNReal.toReal_nonneg
  have hG_nonneg : ∀ w R, 0 ≤ G w R := fun _ _ => ENNReal.toReal_nonneg
  obtain ⟨h_s1_vol, h_s1_end⟩ :=
    mitsui_grid_cube_place_volume_factorization_and_bounds X hX m hm k hQ_bdd
  have hR₁_pos : ∀ j : Fin L, 0 < R₁ j := by intro j; dsimp [R₁]; positivity
  have hR₁_nonneg : ∀ j : Fin L, 0 ≤ R₁ j := fun j => le_of_lt (hR₁_pos j)
  have hR₁_le_X : ∀ j : Fin L, R₁ j ≤ X := by
    intro j
    dsimp [R₁]
    have hj_le : ((j : ℕ) : ℝ) + 1 ≤ (L : ℝ) := by exact_mod_cast j.2
    rw [div_mul_eq_mul_div, div_le_iff₀ hL_rpos]
    exact mul_le_mul_of_nonneg_left hj_le hX_nonneg
  have h_prod_pow : ∀ r : ℝ, (∏ w : NumberField.InfinitePlace K, r ^ w.mult) = r ^ n := by
    intro r
    rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq]
  have h_prod_U : ∀ (w₀ : NumberField.InfinitePlace K) (j : Fin L),
      (∏ w : NumberField.InfinitePlace K, (MeasureTheory.volume (U (R₁ j) w₀ w)).toReal) =
      (R₁ j) ^ w₀.mult * G w₀ (R₁ j) * ∏ w ∈ Finset.univ.erase w₀, F w (R₁ j) := by
    intro w₀ j
    rw [← Finset.mul_prod_erase Finset.univ
      (fun w => (MeasureTheory.volume (U (R₁ j) w₀ w)).toReal) (Finset.mem_univ w₀)]
    have h_diag : (MeasureTheory.volume (U (R₁ j) w₀ w₀)).toReal = (R₁ j) ^ w₀.mult * G w₀ (R₁ j) :=
      (h_s1_vol w₀ (R₁ j) (hR₁_nonneg j)).1
    have h_off : (∏ w ∈ Finset.univ.erase w₀, (MeasureTheory.volume (U (R₁ j) w₀ w)).toReal) =
        ∏ w ∈ Finset.univ.erase w₀, F w (R₁ j) := by
      refine Finset.prod_congr rfl (fun w hw => ?_)
      exact (h_s1_vol w₀ (R₁ j) (hR₁_nonneg j)).2.1 w (Finset.ne_of_mem_erase hw)
    rw [h_diag, h_off]
  let α_n : Fin L → ℝ := fun j =>
    ((if 1 < R₁ j then (1 : ℝ) else 0) -
      (if 1 < R₀ j then (R₀ j / R₁ j) ^ n else 0)) * (n : ℝ)⁻¹
  let β_w : NumberField.InfinitePlace K → Fin L → ℝ := fun w₀ j =>
    ((R₁ j) ^ w₀.mult - (R₀ j) ^ w₀.mult) / ((w₀.mult : ℝ) * (R₁ j) ^ w₀.mult)
  let P_erase : NumberField.InfinitePlace K → Fin L → ℝ := fun w₀ j =>
    ∏ w ∈ Finset.univ.erase w₀, F w (R₁ j)
  set S_orig : ℝ := ∑ w₀ : NumberField.InfinitePlace K, ∑ j : Fin L,
    ((if 1 < R₁ j then (1 : ℝ) else 0) -
      (if 1 < R₀ j then (R₀ j / R₁ j) ^ n else 0)) *
      ((n : ℝ)⁻¹ * ∏ w : NumberField.InfinitePlace K, (MeasureTheory.volume (U (R₁ j) w₀ w)).toReal)
  set S_mid₁ : ℝ := ∑ w₀ : NumberField.InfinitePlace K, ∑ j : Fin L,
    (((R₁ j) ^ w₀.mult - (R₀ j) ^ w₀.mult) / (w₀.mult : ℝ) * G w₀ (R₁ j)) * P_erase w₀ j
  set S_mid₂ : ℝ := ∑ w₀ : NumberField.InfinitePlace K, ∑ j : Fin L,
    (F w₀ (R₁ j) - F w₀ (R₀ j)) * P_erase w₀ j
  have hP_erase_nonneg : ∀ w₀ j, 0 ≤ P_erase w₀ j :=
    fun w₀ j => Finset.prod_nonneg (fun w _ => hF_nonneg w (R₁ j))
  have h_erase_bound : ∀ (w₀ : NumberField.InfinitePlace K) (j : Fin L),
      (R₁ j) ^ w₀.mult * G w₀ (R₁ j) * P_erase w₀ j ≤
      2 * Real.pi * (4 : ℝ) ^ n * (R₁ j) ^ n := by
    intro w₀ j
    have hr := hR₁_nonneg j
    have hr4 : (R₁ j) ^ w₀.mult ≤ (4 * R₁ j) ^ w₀.mult :=
      pow_le_pow_left₀ hr (by linarith) w₀.mult
    have h_prod_le : P_erase w₀ j ≤ ∏ w ∈ Finset.univ.erase w₀, (4 * R₁ j) ^ w.mult :=
      Finset.prod_le_prod (fun w _ => hF_nonneg w (R₁ j))
        (fun w _ => (h_s1_vol w (R₁ j) hr).2.2.2)
    have h_rp_le : (R₁ j) ^ w₀.mult * P_erase w₀ j ≤ (4 : ℝ) ^ n * (R₁ j) ^ n := by
      calc (R₁ j) ^ w₀.mult * P_erase w₀ j
        _ ≤ (4 * R₁ j) ^ w₀.mult * (∏ w ∈ Finset.univ.erase w₀, (4 * R₁ j) ^ w.mult) :=
            mul_le_mul hr4 h_prod_le (hP_erase_nonneg w₀ j) (by positivity)
        _ = ∏ w : NumberField.InfinitePlace K, (4 * R₁ j) ^ w.mult :=
            Finset.mul_prod_erase Finset.univ
              (fun w : NumberField.InfinitePlace K => (4 * R₁ j) ^ w.mult) (Finset.mem_univ w₀)
        _ = (4 * R₁ j) ^ n := h_prod_pow (4 * R₁ j)
        _ = (4 : ℝ) ^ n * (R₁ j) ^ n := mul_pow 4 (R₁ j) n
    have hG_le : G w₀ (R₁ j) ≤ 2 * Real.pi := (h_s1_vol w₀ (R₁ j) hr).2.2.1
    calc (R₁ j) ^ w₀.mult * G w₀ (R₁ j) * P_erase w₀ j
      _ = G w₀ (R₁ j) * ((R₁ j) ^ w₀.mult * P_erase w₀ j) := by ring
      _ ≤ (2 * Real.pi) * ((4 : ℝ) ^ n * (R₁ j) ^ n) :=
          mul_le_mul hG_le h_rp_le
            (mul_nonneg (pow_nonneg hr _) (hP_erase_nonneg w₀ j)) (by positivity)
      _ = 2 * Real.pi * (4 : ℝ) ^ n * (R₁ j) ^ n := by ring
  have h_diff1 : |S_orig - S_mid₁| ≤
      2 * Real.pi * (M : ℝ) * (4 : ℝ) ^ n * (2 + (n : ℝ) * Y / (L : ℝ)) := by
    have h_each_w0 : ∀ w₀ : NumberField.InfinitePlace K,
        |∑ j : Fin L,
          (((if 1 < R₁ j then (1 : ℝ) else 0) -
              (if 1 < R₀ j then (R₀ j / R₁ j) ^ n else 0)) *
            ((n : ℝ)⁻¹ * ∏ w : NumberField.InfinitePlace K, (MeasureTheory.volume (U (R₁ j) w₀ w)).toReal) -
           (((R₁ j) ^ w₀.mult - (R₀ j) ^ w₀.mult) / (w₀.mult : ℝ) * G w₀ (R₁ j)) * P_erase w₀ j)| ≤
        2 * Real.pi * (4 : ℝ) ^ n * (2 + (n : ℝ) * Y / (L : ℝ)) := by
      intro w₀
      have hw₀_ge_one : 1 ≤ w₀.mult := by
        exact_mod_cast NumberField.InfinitePlace.one_le_mult (w := w₀)
      have hw₀_le_n : w₀.mult ≤ n := by
        dsimp [n]
        rw [← NumberField.InfinitePlace.sum_mult_eq]
        exact Finset.single_le_sum (fun w _ => Nat.zero_le w.mult) (Finset.mem_univ w₀)
      have h_s2 := mitsui_conical_shell_radial_weight_diff_sum_bound n w₀.mult hw₀_ge_one hw₀_le_n X hX L hL
      have h_term_le : ∀ j : Fin L,
          |(((if 1 < R₁ j then (1 : ℝ) else 0) -
              (if 1 < R₀ j then (R₀ j / R₁ j) ^ n else 0)) *
            ((n : ℝ)⁻¹ * ∏ w : NumberField.InfinitePlace K, (MeasureTheory.volume (U (R₁ j) w₀ w)).toReal) -
           (((R₁ j) ^ w₀.mult - (R₀ j) ^ w₀.mult) / (w₀.mult : ℝ) * G w₀ (R₁ j)) * P_erase w₀ j)| ≤
          2 * Real.pi * (4 : ℝ) ^ n * (|α_n j - β_w w₀ j| * (R₁ j) ^ n) := by
        intro j
        rw [h_prod_U w₀ j]
        have h_pow_ne : (R₁ j) ^ w₀.mult ≠ 0 := pow_ne_zero _ (ne_of_gt (hR₁_pos j))
        have hw₀_ne : (w₀.mult : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hw₀_ge_one)
        have h_alg :
            ((if 1 < R₁ j then (1 : ℝ) else 0) -
              (if 1 < R₀ j then (R₀ j / R₁ j) ^ n else 0)) *
            ((n : ℝ)⁻¹ * ((R₁ j) ^ w₀.mult * G w₀ (R₁ j) * P_erase w₀ j)) -
            (((R₁ j) ^ w₀.mult - (R₀ j) ^ w₀.mult) / (w₀.mult : ℝ) * G w₀ (R₁ j)) * P_erase w₀ j =
            (α_n j - β_w w₀ j) * ((R₁ j) ^ w₀.mult * G w₀ (R₁ j) * P_erase w₀ j) := by
          dsimp [α_n, β_w]
          field_simp [h_pow_ne, hw₀_ne]
        rw [h_alg, abs_mul]
        have h_nonneg : 0 ≤ (R₁ j) ^ w₀.mult * G w₀ (R₁ j) * P_erase w₀ j :=
          mul_nonneg (mul_nonneg (pow_nonneg (hR₁_nonneg j) _) (hG_nonneg w₀ (R₁ j))) (hP_erase_nonneg w₀ j)
        rw [abs_of_nonneg h_nonneg]
        calc |α_n j - β_w w₀ j| * ((R₁ j) ^ w₀.mult * G w₀ (R₁ j) * P_erase w₀ j)
          _ ≤ |α_n j - β_w w₀ j| * (2 * Real.pi * (4 : ℝ) ^ n * (R₁ j) ^ n) :=
              mul_le_mul_of_nonneg_left (h_erase_bound w₀ j) (abs_nonneg _)
          _ = 2 * Real.pi * (4 : ℝ) ^ n * (|α_n j - β_w w₀ j| * (R₁ j) ^ n) := by ring
      calc |∑ j : Fin L,
            (((if 1 < R₁ j then (1 : ℝ) else 0) -
                (if 1 < R₀ j then (R₀ j / R₁ j) ^ n else 0)) *
              ((n : ℝ)⁻¹ * ∏ w : NumberField.InfinitePlace K, (MeasureTheory.volume (U (R₁ j) w₀ w)).toReal) -
             (((R₁ j) ^ w₀.mult - (R₀ j) ^ w₀.mult) / (w₀.mult : ℝ) * G w₀ (R₁ j)) * P_erase w₀ j)|
        _ ≤ ∑ j : Fin L,
            |(((if 1 < R₁ j then (1 : ℝ) else 0) -
                (if 1 < R₀ j then (R₀ j / R₁ j) ^ n else 0)) *
              ((n : ℝ)⁻¹ * ∏ w : NumberField.InfinitePlace K, (MeasureTheory.volume (U (R₁ j) w₀ w)).toReal) -
             (((R₁ j) ^ w₀.mult - (R₀ j) ^ w₀.mult) / (w₀.mult : ℝ) * G w₀ (R₁ j)) * P_erase w₀ j)| :=
            Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ j : Fin L, 2 * Real.pi * (4 : ℝ) ^ n * (|α_n j - β_w w₀ j| * (R₁ j) ^ n) :=
            Finset.sum_le_sum (fun j _ => h_term_le j)
        _ = 2 * Real.pi * (4 : ℝ) ^ n * ∑ j : Fin L, (|α_n j - β_w w₀ j| * (R₁ j) ^ n) := by
            rw [← Finset.mul_sum]
        _ ≤ 2 * Real.pi * (4 : ℝ) ^ n * (2 + (n : ℝ) * Y / (L : ℝ)) :=
            mul_le_mul_of_nonneg_left h_s2 (by positivity)
    have h_sub : S_orig - S_mid₁ =
        ∑ w₀ : NumberField.InfinitePlace K, ∑ j : Fin L,
          (((if 1 < R₁ j then (1 : ℝ) else 0) -
              (if 1 < R₀ j then (R₀ j / R₁ j) ^ n else 0)) *
            ((n : ℝ)⁻¹ * ∏ w : NumberField.InfinitePlace K, (MeasureTheory.volume (U (R₁ j) w₀ w)).toReal) -
           (((R₁ j) ^ w₀.mult - (R₀ j) ^ w₀.mult) / (w₀.mult : ℝ) * G w₀ (R₁ j)) * P_erase w₀ j) := by
      dsimp [S_orig, S_mid₁]
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun w₀ _ => (Finset.sum_sub_distrib _ _).symm)
    rw [h_sub]
    calc |∑ w₀ : NumberField.InfinitePlace K, ∑ j : Fin L, _|
      _ ≤ ∑ w₀ : NumberField.InfinitePlace K, |∑ j : Fin L, _| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _w₀ : NumberField.InfinitePlace K,
            (2 * Real.pi * (4 : ℝ) ^ n * (2 + (n : ℝ) * Y / (L : ℝ))) :=
          Finset.sum_le_sum (fun w₀ _ => h_each_w0 w₀)
      _ = 2 * Real.pi * (M : ℝ) * (4 : ℝ) ^ n * (2 + (n : ℝ) * Y / (L : ℝ)) := by
          simp [M, Finset.sum_const, nsmul_eq_mul]; ring
  have h_diff2 : |S_mid₁ - S_mid₂| ≤ A₂ * Y / (L : ℝ) := by
    have h_each_w0 : ∀ w₀ : NumberField.InfinitePlace K,
        |∑ j : Fin L,
          ((((R₁ j) ^ w₀.mult - (R₀ j) ^ w₀.mult) / (w₀.mult : ℝ) * G w₀ (R₁ j)) * P_erase w₀ j -
           (F w₀ (R₁ j) - F w₀ (R₀ j)) * P_erase w₀ j)| ≤
        16 * (4 : ℝ) ^ n * Y / (L : ℝ) := by
      intro w₀
      have h_s3 := (mitsui_place_conical_shell_volume_diff_bound X hX m hm L hL k w₀).2
      let Q_erase : ℝ := ∏ w ∈ Finset.univ.erase w₀, (4 * X) ^ w.mult
      have hQ_nonneg : 0 ≤ Q_erase := Finset.prod_nonneg (fun w _ => by positivity)
      have h_P_le_Q : ∀ j : Fin L, P_erase w₀ j ≤ Q_erase := by
        intro j
        refine Finset.prod_le_prod (fun w _ => hF_nonneg w (R₁ j)) (fun w _ => ?_)
        have h1 : F w (R₁ j) ≤ (4 * R₁ j) ^ w.mult := (h_s1_vol w (R₁ j) (hR₁_nonneg j)).2.2.2
        have h2 : (4 * R₁ j) ^ w.mult ≤ (4 * X) ^ w.mult :=
          pow_le_pow_left₀ (by positivity) (by linarith [hR₁_le_X j]) w.mult
        exact le_trans h1 h2
      have h_comb_X : (4 * X) ^ w₀.mult * Q_erase = (4 : ℝ) ^ n * Y := by
        calc (4 * X) ^ w₀.mult * Q_erase
          _ = ∏ w : NumberField.InfinitePlace K, (4 * X) ^ w.mult :=
              Finset.mul_prod_erase Finset.univ
                (fun w : NumberField.InfinitePlace K => (4 * X) ^ w.mult) (Finset.mem_univ w₀)
          _ = (4 * X) ^ n := h_prod_pow (4 * X)
          _ = (4 : ℝ) ^ n * Y := by dsimp [Y]; exact mul_pow 4 X n
      have h_term_le : ∀ j : Fin L,
          |((((R₁ j) ^ w₀.mult - (R₀ j) ^ w₀.mult) / (w₀.mult : ℝ) * G w₀ (R₁ j)) * P_erase w₀ j -
            (F w₀ (R₁ j) - F w₀ (R₀ j)) * P_erase w₀ j)| ≤
          |((R₁ j) ^ w₀.mult - (R₀ j) ^ w₀.mult) / (w₀.mult : ℝ) * G w₀ (R₁ j) -
            (F w₀ (R₁ j) - F w₀ (R₀ j))| * Q_erase := by
        intro j
        rw [← sub_mul, abs_mul, abs_of_nonneg (hP_erase_nonneg w₀ j)]
        exact mul_le_mul_of_nonneg_left (h_P_le_Q j) (abs_nonneg _)
      calc |∑ j : Fin L,
            ((((R₁ j) ^ w₀.mult - (R₀ j) ^ w₀.mult) / (w₀.mult : ℝ) * G w₀ (R₁ j)) * P_erase w₀ j -
             (F w₀ (R₁ j) - F w₀ (R₀ j)) * P_erase w₀ j)|
        _ ≤ ∑ j : Fin L,
            |((((R₁ j) ^ w₀.mult - (R₀ j) ^ w₀.mult) / (w₀.mult : ℝ) * G w₀ (R₁ j)) * P_erase w₀ j -
              (F w₀ (R₁ j) - F w₀ (R₀ j)) * P_erase w₀ j)| :=
            Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ j : Fin L,
            |((R₁ j) ^ w₀.mult - (R₀ j) ^ w₀.mult) / (w₀.mult : ℝ) * G w₀ (R₁ j) -
              (F w₀ (R₁ j) - F w₀ (R₀ j))| * Q_erase :=
            Finset.sum_le_sum (fun j _ => h_term_le j)
        _ = (∑ j : Fin L,
              |((R₁ j) ^ w₀.mult - (R₀ j) ^ w₀.mult) / (w₀.mult : ℝ) * G w₀ (R₁ j) -
                (F w₀ (R₁ j) - F w₀ (R₀ j))|) * Q_erase := by
            rw [← Finset.sum_mul]
        _ ≤ (16 * (4 * X) ^ w₀.mult / (L : ℝ)) * Q_erase :=
            mul_le_mul_of_nonneg_right h_s3 hQ_nonneg
        _ = 16 * ((4 * X) ^ w₀.mult * Q_erase) / (L : ℝ) := by ring
        _ = 16 * (4 : ℝ) ^ n * Y / (L : ℝ) := by rw [h_comb_X]; ring
    have h_sub : S_mid₁ - S_mid₂ =
        ∑ w₀ : NumberField.InfinitePlace K, ∑ j : Fin L,
          ((((R₁ j) ^ w₀.mult - (R₀ j) ^ w₀.mult) / (w₀.mult : ℝ) * G w₀ (R₁ j)) * P_erase w₀ j -
           (F w₀ (R₁ j) - F w₀ (R₀ j)) * P_erase w₀ j) := by
      dsimp [S_mid₁, S_mid₂]
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun w₀ _ => (Finset.sum_sub_distrib _ _).symm)
    rw [h_sub]
    calc |∑ w₀ : NumberField.InfinitePlace K, ∑ j : Fin L, _|
      _ ≤ ∑ w₀ : NumberField.InfinitePlace K, |∑ j : Fin L, _| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _w₀ : NumberField.InfinitePlace K, (16 * (4 : ℝ) ^ n * Y / (L : ℝ)) :=
          Finset.sum_le_sum (fun w₀ _ => h_each_w0 w₀)
      _ = A₂ * Y / (L : ℝ) := by
          simp [M, A₂, Finset.sum_const, nsmul_eq_mul]; ring
  have h_tel : (∑ j : Fin L, ((∏ w : NumberField.InfinitePlace K, F w (R₁ j)) -
      ∏ w : NumberField.InfinitePlace K, F w (R₀ j))) = (X / (m : ℝ)) ^ n := by
    let P_seq : ℕ → ℝ := fun i => ∏ w : NumberField.InfinitePlace K, F w (R_seq i)
    have h_reindex :
        (∑ j : Fin L, ((∏ w : NumberField.InfinitePlace K, F w (R₁ j)) -
          ∏ w : NumberField.InfinitePlace K, F w (R₀ j))) =
        ∑ i ∈ Finset.range L, (P_seq (i + 1) - P_seq i) := by
      rw [Fin.sum_univ_eq_sum_range
        (fun i : ℕ => (∏ w : NumberField.InfinitePlace K, F w ((X / (L : ℝ)) * ((i : ℝ) + 1))) -
          ∏ w : NumberField.InfinitePlace K, F w ((X / (L : ℝ)) * (i : ℝ))) L]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      dsimp [P_seq, R_seq]
      push_cast
      rfl
    rw [h_reindex, Finset.sum_range_sub P_seq L]
    have hPL : P_seq L = (X / (m : ℝ)) ^ n := by
      dsimp [P_seq, R_seq]
      have hRL : (X / (L : ℝ)) * (L : ℝ) = X := div_mul_cancel₀ X hL_rne
      rw [hRL]
      calc (∏ w : NumberField.InfinitePlace K, F w X)
        _ = ∏ w : NumberField.InfinitePlace K, (X / (m : ℝ)) ^ w.mult :=
            Finset.prod_congr rfl (fun w _ => (h_s1_end w).2)
        _ = (X / (m : ℝ)) ^ n := h_prod_pow (X / (m : ℝ))
    have hP0 : P_seq 0 = 0 := by
      dsimp [P_seq, R_seq]
      have hR0 : (X / (L : ℝ)) * ((0 : ℕ) : ℝ) = 0 := by ring
      rw [hR0]
      obtain ⟨w₀⟩ := ( inferInstance : Nonempty (NumberField.InfinitePlace K) )
      exact Finset.prod_eq_zero (Finset.mem_univ w₀) (h_s1_end w₀).1
    rw [hPL, hP0, sub_zero]
  have h_diff3 : |S_mid₂ - (X / (m : ℝ)) ^ n| ≤ A₃ * Y / (L : ℝ) := by
    have h_swap : S_mid₂ = ∑ j : Fin L, ∑ w₀ : NumberField.InfinitePlace K,
        (F w₀ (R₁ j) - F w₀ (R₀ j)) * P_erase w₀ j := Finset.sum_comm
    rw [h_swap, ← h_tel, ← Finset.sum_sub_distrib]
    let η : ℝ := 2 * Real.pi / (L : ℝ)
    have hη_nonneg : 0 ≤ η := by dsimp [η]; positivity
    have h_each_j : ∀ j : Fin L,
        |(∑ w₀ : NumberField.InfinitePlace K, (F w₀ (R₁ j) - F w₀ (R₀ j)) * P_erase w₀ j) -
          ((∏ w : NumberField.InfinitePlace K, F w (R₁ j)) -
            ∏ w : NumberField.InfinitePlace K, F w (R₀ j))| ≤
        (M : ℝ) ^ 2 * η ^ 2 * ((4 : ℝ) ^ n * Y) := by
      intro j
      have h_bds : ∀ w : NumberField.InfinitePlace K,
          0 ≤ F w (R₀ j) ∧ F w (R₀ j) ≤ F w (R₁ j) ∧ F w (R₁ j) ≤ (4 * X) ^ w.mult ∧
          F w (R₁ j) - F w (R₀ j) ≤ η * (4 * X) ^ w.mult := by
        intro w
        have hs3_w := (mitsui_place_conical_shell_volume_diff_bound X hX m hm L hL k w).1 j
        have hF1_le : F w (R₁ j) ≤ (4 * X) ^ w.mult := by
          have h1 : F w (R₁ j) ≤ (4 * R₁ j) ^ w.mult := (h_s1_vol w (R₁ j) (hR₁_nonneg j)).2.2.2
          have h2 : (4 * R₁ j) ^ w.mult ≤ (4 * X) ^ w.mult :=
            pow_le_pow_left₀ (by positivity) (by linarith [hR₁_le_X j]) w.mult
          exact le_trans h1 h2
        refine ⟨hF_nonneg w (R₀ j), hs3_w.1, hF1_le, ?_⟩
        dsimp [η]
        rw [div_mul_eq_mul_div]
        exact hs3_w.2
      have h_s4 := mitsui_finset_prod_diff_sum_erase_bound
        (fun w => F w (R₀ j)) (fun w => F w (R₁ j)) (fun w => (4 * X) ^ w.mult) η hη_nonneg h_bds
      have h_prod_M : (∏ w : NumberField.InfinitePlace K, (4 * X) ^ w.mult) = (4 : ℝ) ^ n * Y := by
        rw [h_prod_pow (4 * X)]
        dsimp [Y]
        exact mul_pow 4 X n
      rw [h_prod_M] at h_s4
      exact h_s4
    calc |∑ j : Fin L, _|
      _ ≤ ∑ j : Fin L, |_ - _| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _j : Fin L, ((M : ℝ) ^ 2 * η ^ 2 * ((4 : ℝ) ^ n * Y)) :=
          Finset.sum_le_sum (fun j _ => h_each_j j)
      _ = (L : ℝ) * ((M : ℝ) ^ 2 * η ^ 2 * ((4 : ℝ) ^ n * Y)) := by
          simp [Finset.sum_const, nsmul_eq_mul]
      _ = A₃ * Y / (L : ℝ) := by
          dsimp [A₃, η]
          field_simp [hL_rne]
          ring
  set t : ℝ := Real.sqrt (Real.log X)
  have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg _
  have ht_sq : t ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlog_pos)
  have h_one_le_exp : 1 ≤ Real.exp 1 * Y * Real.exp (-t / c_sum) := by
    have hsq : 0 ≤ (t - 1) ^ 2 := sq_nonneg (t - 1)
    have hlog_ge : t - 1 ≤ Real.log X := by nlinarith [hsq, ht_sq]
    have hn_log : Real.log X ≤ (n : ℝ) * Real.log X := by
      calc Real.log X = 1 * Real.log X := (one_mul _).symm
        _ ≤ (n : ℝ) * Real.log X := mul_le_mul_of_nonneg_right hn_rge_one (le_of_lt hlog_pos)
    have h_div_t : t / c_sum ≤ t := div_le_self ht_nonneg hc_sum_ge_one
    have h_exp_arg : 0 ≤ 1 + (n : ℝ) * Real.log X + (-t / c_sum) := by
      have : -t ≤ -t / c_sum := by
        rw [neg_div, neg_le_neg_iff]
        exact h_div_t
      linarith
    have hY_eq : Y = Real.exp ((n : ℝ) * Real.log X) := by
      dsimp [Y]
      rw [Real.exp_nat_mul, Real.exp_log hX_pos]
    calc (1 : ℝ)
      _ = Real.exp 0 := Real.exp_zero.symm
      _ ≤ Real.exp (1 + (n : ℝ) * Real.log X + (-t / c_sum)) := Real.exp_le_exp.mpr h_exp_arg
      _ = Real.exp 1 * Real.exp ((n : ℝ) * Real.log X) * Real.exp (-t / c_sum) := by
          rw [Real.exp_add, Real.exp_add]
      _ = Real.exp 1 * Y * Real.exp (-t / c_sum) := by rw [← hY_eq]
  have h_const_term_le :
      4 * Real.pi * (M : ℝ) * (4 : ℝ) ^ n ≤ A_exp * Y * Real.exp (-t / c_sum) := by
    calc 4 * Real.pi * (M : ℝ) * (4 : ℝ) ^ n
      _ = (4 * Real.pi * (M : ℝ) * (4 : ℝ) ^ n) * 1 := (mul_one _).symm
      _ ≤ (4 * Real.pi * (M : ℝ) * (4 : ℝ) ^ n) * (Real.exp 1 * Y * Real.exp (-t / c_sum)) :=
          mul_le_mul_of_nonneg_left h_one_le_exp (by positivity)
      _ = A_exp * Y * Real.exp (-t / c_sum) := by dsimp [A_exp]; ring
  have h_invL_le : 1 / (L : ℝ) ≤ (Real.log X + 1) / (L : ℝ) :=
    div_le_div_of_nonneg_right (by linarith) (le_of_lt hL_rpos)
  have h_L_terms_le :
      (A₁ + A₂ + A₃) * Y / (L : ℝ) ≤ c_sum * Y * ((Real.log X + 1) / (L : ℝ)) := by
    have h_coeff : A₁ + A₂ + A₃ ≤ c_sum := by
      have : 0 ≤ 1 + A_exp := by positivity
      dsimp [c_sum]; linarith
    calc (A₁ + A₂ + A₃) * Y / (L : ℝ)
      _ = (A₁ + A₂ + A₃) * Y * (1 / (L : ℝ)) := by ring
      _ ≤ (A₁ + A₂ + A₃) * Y * ((Real.log X + 1) / (L : ℝ)) :=
          mul_le_mul_of_nonneg_left h_invL_le (by positivity)
      _ ≤ c_sum * Y * ((Real.log X + 1) / (L : ℝ)) := by
          have : 0 ≤ Y * ((Real.log X + 1) / (L : ℝ)) := by positivity
          nlinarith
  have h_exp_term_le :
      A_exp * Y * Real.exp (-t / c_sum) ≤ c_sum * Y * Real.exp (-t / c_sum) := by
    have h_coeff : A_exp ≤ c_sum := by
      have : 0 ≤ 1 + A₁ + A₂ + A₃ := by positivity
      dsimp [c_sum]; linarith
    have : 0 ≤ Y * Real.exp (-t / c_sum) := by positivity
    nlinarith
  have h_tri1 := abs_sub_le S_orig S_mid₁ ((X / (m : ℝ)) ^ n)
  have h_tri2 := abs_sub_le S_mid₁ S_mid₂ ((X / (m : ℝ)) ^ n)
  have h_diff1_expand :
      2 * Real.pi * (M : ℝ) * (4 : ℝ) ^ n * (2 + (n : ℝ) * Y / (L : ℝ)) =
      4 * Real.pi * (M : ℝ) * (4 : ℝ) ^ n + A₁ * Y / (L : ℝ) := by
    dsimp [A₁]; ring
  have h_L_add :
      A₁ * Y / (L : ℝ) + A₂ * Y / (L : ℝ) + A₃ * Y / (L : ℝ) =
      (A₁ + A₂ + A₃) * Y / (L : ℝ) := by
    ring
  change |S_orig - (X / (m : ℝ)) ^ n| ≤
    c_sum * Y * ((Real.log X + 1) / (L : ℝ)) + c_sum * Y * Real.exp (-t / c_sum)
  linarith

theorem mitsui_prime_grid_cube_place_sectors_asymptotic {K : Type u} [Field K] [NumberField K] :
