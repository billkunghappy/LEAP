      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      dsimp [f_place, h_step]
      rw [if_neg hw_ne]
      ring
    rw [h_w0_sum]
    calc Y * δ ^ r * ((w₀.mult : ℝ) * ∏ w ∈ Finset.univ.erase w₀, ∑ j : Fin m, f_place w j)
      _ = (w₀.mult : ℝ) * Y * (δ ^ r * ∏ w ∈ Finset.univ.erase w₀, ∑ j : Fin m, f_place w j) := by ring
      _ = (w₀.mult : ℝ) * Y * ∏ w ∈ Finset.univ.erase w₀, ∑ j : Fin m, h_step w * g_exp w j := by
        rw [h_erase_prod]
  have h_s2 : ∀ (m : ℕ) (h : ℝ), 0 ≤ h →
      1 - Real.exp (-(m : ℝ) * h) ≤
        ∑ j : Fin m, h * Real.exp (h * (((j : ℕ) : ℝ) + 1 - (m : ℝ))) ∧
      ∑ j : Fin m, h * Real.exp (h * (((j : ℕ) : ℝ) + 1 - (m : ℝ))) ≤
        Real.exp h * (1 - Real.exp (-(m : ℝ) * h)) ∧
      ∑ j : Fin m, h * Real.exp (h * (((j : ℕ) : ℝ) + 1 - (m : ℝ))) ≤
        Real.exp h := by
    intro m h hh
    let a : ℕ → ℝ := fun i => Real.exp (h * ((i : ℝ) - (m : ℝ)))
    have h_reindex :
        (∑ j : Fin m, h * Real.exp (h * (((j : ℕ) : ℝ) + 1 - (m : ℝ)))) =
        ∑ i ∈ Finset.range m, h * a (i + 1) := by
      rw [Fin.sum_univ_eq_sum_range (fun i : ℕ => h * Real.exp (h * ((i : ℝ) + 1 - (m : ℝ)))) m]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      dsimp [a]
      push_cast
      ring_nf
    have h_tel : (∑ i ∈ Finset.range m, (a (i + 1) - a i)) = 1 - Real.exp (-(m : ℝ) * h) := by
      rw [Finset.sum_range_sub a m]
      have ham : a m = 1 := by
        dsimp [a]
        rw [sub_self, mul_zero, Real.exp_zero]
      have ha0 : a 0 = Real.exp (-(m : ℝ) * h) := by
        dsimp [a]
        congr 1
        push_cast
        ring
      rw [ham, ha0]
    have h_lo_pt : ∀ i : ℕ, a (i + 1) - a i ≤ h * a (i + 1) := by
      intro i
      have h1 : 1 - Real.exp (-h) ≤ h := by linarith [Real.add_one_le_exp (-h)]
      have h_ai : a i = a (i + 1) * Real.exp (-h) := by
        dsimp [a]
        rw [← Real.exp_add]
        congr 1
        push_cast
        ring
      calc a (i + 1) - a i
        _ = (1 - Real.exp (-h)) * a (i + 1) := by rw [h_ai]; ring
        _ ≤ h * a (i + 1) := mul_le_mul_of_nonneg_right h1 (Real.exp_nonneg _)
    have h_hi_pt : ∀ i : ℕ, h * a (i + 1) ≤ Real.exp h * (a (i + 1) - a i) := by
      intro i
      have h1 : h ≤ Real.exp h - 1 := by linarith [Real.add_one_le_exp h]
      have h_ai1 : a (i + 1) = a i * Real.exp h := by
        dsimp [a]
        rw [← Real.exp_add]
        congr 1
        push_cast
        ring
      calc h * a (i + 1)
        _ = (Real.exp h * a i) * h := by rw [h_ai1]; ring
        _ ≤ (Real.exp h * a i) * (Real.exp h - 1) :=
          mul_le_mul_of_nonneg_left h1 (mul_nonneg (Real.exp_nonneg _) (Real.exp_nonneg _))
        _ = Real.exp h * (a (i + 1) - a i) := by rw [h_ai1]; ring
    have h_lo : 1 - Real.exp (-(m : ℝ) * h) ≤ ∑ i ∈ Finset.range m, h * a (i + 1) := by
      rw [← h_tel]
      exact Finset.sum_le_sum (fun i _ => h_lo_pt i)
    have h_hi1 : ∑ i ∈ Finset.range m, h * a (i + 1) ≤ Real.exp h * (1 - Real.exp (-(m : ℝ) * h)) := by
      rw [← h_tel, Finset.mul_sum]
      exact Finset.sum_le_sum (fun i _ => h_hi_pt i)
    have h_hi2 : Real.exp h * (1 - Real.exp (-(m : ℝ) * h)) ≤ Real.exp h := by
      have : 0 ≤ Real.exp h * Real.exp (-(m : ℝ) * h) := by positivity
      linarith
    rw [h_reindex]
    exact ⟨h_lo, h_hi1, le_trans h_hi1 h_hi2⟩
  have h_s3 : ∀ (n r : ℕ) (X : ℝ), 1 < X → ∀ (m : ℕ), 1 ≤ m → Real.log X ≤ (m : ℝ) →
      ∀ (P : ℝ), (1 - X⁻¹) ^ r ≤ P → P ≤ Real.exp ((n : ℝ) * (Real.log X / (m : ℝ))) →
      |P - 1| ≤
        Real.exp (n : ℝ) * (n : ℝ) * ((Real.log X + 1) ^ 2 / (m : ℝ)) +
          (r : ℝ) * Real.exp 1 * Real.exp (-Real.sqrt (Real.log X)) := by
    intro n r X hX m hm hm_log P hP_lo hP_hi
    have hX_pos : 0 < X := by linarith
    have hlog_pos : 0 < Real.log X := Real.log_pos hX
    have hm_rpos : 0 < (m : ℝ) := Nat.cast_pos.mpr hm
    have hX_inv_pos : 0 < X⁻¹ := inv_pos.mpr hX_pos
    have hX_inv_lt_one : X⁻¹ < 1 := inv_lt_one_of_one_lt₀ hX
    have h_bern : 1 - (r : ℝ) * X⁻¹ ≤ (1 - X⁻¹) ^ r := by
      have h1 := one_add_mul_le_pow (a := -X⁻¹) (by linarith) r
      simpa [sub_eq_add_neg] using h1
    set t : ℝ := Real.sqrt (Real.log X)
    have ht_sq : t ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlog_pos)
    have h_inv_le : X⁻¹ ≤ Real.exp 1 * Real.exp (-t) := by
      have hsq : 0 ≤ (t - 1) ^ 2 := sq_nonneg (t - 1)
      have h_ineq : -Real.log X ≤ 1 + -t := by nlinarith [hsq, ht_sq]
      calc X⁻¹
        _ = Real.exp (-Real.log X) := by rw [Real.exp_neg, Real.exp_log hX_pos]
        _ ≤ Real.exp (1 + -t) := Real.exp_le_exp.mpr h_ineq
        _ = Real.exp 1 * Real.exp (-t) := Real.exp_add 1 (-t)
    have h_P_sub_lo : -((r : ℝ) * Real.exp 1 * Real.exp (-t)) ≤ P - 1 := by
      have hr_mul : (r : ℝ) * X⁻¹ ≤ (r : ℝ) * (Real.exp 1 * Real.exp (-t)) :=
        mul_le_mul_of_nonneg_left h_inv_le (Nat.cast_nonneg r)
      linarith [h_bern, hP_lo, hr_mul]
    set u : ℝ := (n : ℝ) * (Real.log X / (m : ℝ))
    have hu_nonneg : 0 ≤ u := by dsimp [u]; positivity
    have h_div_le_one : Real.log X / (m : ℝ) ≤ 1 := div_le_one_of_le₀ hm_log (le_of_lt hm_rpos)
    have hu_le_n : u ≤ (n : ℝ) := by
      dsimp [u]
      calc (n : ℝ) * (Real.log X / (m : ℝ))
        _ ≤ (n : ℝ) * 1 := mul_le_mul_of_nonneg_left h_div_le_one (Nat.cast_nonneg n)
        _ = (n : ℝ) := mul_one _
    have hexp_u_le : Real.exp u ≤ Real.exp (n : ℝ) := Real.exp_le_exp.mpr hu_le_n
    have h_exp_sub : Real.exp u - 1 ≤ Real.exp (n : ℝ) * u := by
      have h1 : 1 - Real.exp (-u) ≤ u := by linarith [Real.add_one_le_exp (-u)]
      have h2 : Real.exp u * Real.exp (-u) = 1 := by
        rw [← Real.exp_add, add_neg_cancel, Real.exp_zero]
      calc Real.exp u - 1
        _ = Real.exp u * (1 - Real.exp (-u)) := by rw [mul_sub, mul_one, h2]
        _ ≤ Real.exp u * u := mul_le_mul_of_nonneg_left h1 (Real.exp_nonneg u)
        _ ≤ Real.exp (n : ℝ) * u := mul_le_mul_of_nonneg_right hexp_u_le hu_nonneg
    have h_log_le_sq : Real.log X / (m : ℝ) ≤ (Real.log X + 1) ^ 2 / (m : ℝ) := by
      apply div_le_div_of_nonneg_right _ (le_of_lt hm_rpos)
      nlinarith
    have h_P_sub_hi : P - 1 ≤ Real.exp (n : ℝ) * (n : ℝ) * ((Real.log X + 1) ^ 2 / (m : ℝ)) := by
      have h3 : Real.exp (n : ℝ) * u ≤ Real.exp (n : ℝ) * (n : ℝ) * ((Real.log X + 1) ^ 2 / (m : ℝ)) := by
        dsimp [u]
        calc Real.exp (n : ℝ) * ((n : ℝ) * (Real.log X / (m : ℝ)))
          _ = (Real.exp (n : ℝ) * (n : ℝ)) * (Real.log X / (m : ℝ)) := by ring
          _ ≤ (Real.exp (n : ℝ) * (n : ℝ)) * ((Real.log X + 1) ^ 2 / (m : ℝ)) :=
            mul_le_mul_of_nonneg_left h_log_le_sq (by positivity)
      linarith [hP_hi, h_exp_sub, h3]
    have hB1_nonneg : 0 ≤ Real.exp (n : ℝ) * (n : ℝ) * ((Real.log X + 1) ^ 2 / (m : ℝ)) := by positivity
    have hB2_nonneg : 0 ≤ (r : ℝ) * Real.exp 1 * Real.exp (-t) := by positivity
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  set n : ℕ := Module.finrank ℚ K
  set r : ℕ := NumberField.Units.rank K
  let c_sum : ℝ := (n : ℝ) ^ 2 * Real.exp (n : ℝ) + (n : ℝ) * ((r : ℝ) + 1) * Real.exp 1 + 1
  have hc_sum_ge_one : 1 ≤ c_sum := by
    have : 0 ≤ (n : ℝ) ^ 2 * Real.exp (n : ℝ) + (n : ℝ) * ((r : ℝ) + 1) * Real.exp 1 := by positivity
    dsimp [c_sum]; linarith
  have hc_sum_pos : 0 < c_sum := by linarith
  refine ⟨c_sum, hc_sum_pos, ?_⟩
  intro X hX m hm hm_log w₀
  set Y : ℝ := X ^ n
  set δ : ℝ := Real.log X / (m : ℝ)
  have hX_pos : 0 < X := by linarith
  have hY_nonneg : 0 ≤ Y := by dsimp [Y]; positivity
  have hlog_pos : 0 < Real.log X := Real.log_pos hX
  have hm_rpos : 0 < (m : ℝ) := Nat.cast_pos.mpr hm
  have hδ_nonneg : 0 ≤ δ := by dsimp [δ]; positivity
  let h_step : NumberField.InfinitePlace K → ℝ := fun w => (w.mult : ℝ) * δ
  let I_sum : NumberField.InfinitePlace K → ℝ := fun w =>
    ∑ j : Fin m, h_step w * Real.exp (h_step w * (((j : ℕ) : ℝ) + 1 - (m : ℝ)))
  set P : ℝ := ∏ w ∈ Finset.univ.erase w₀, I_sum w
  have h_sum_eq :
      (∑' k : NumberField.InfinitePlace K → Fin m,
          (if (k w₀ : ℕ) + 1 = m then (1 : ℝ) else 0) *
            (∏ w : NumberField.InfinitePlace K, (w.mult : ℝ)) *
            (Real.log X / (m : ℝ)) ^ (NumberField.Units.rank K) *
            (X ^ (Module.finrank ℚ K) *
              Real.exp (Real.log X * ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))))
        = (w₀.mult : ℝ) * Y * P := h_s1 X m hm w₀
  have hh_step_nonneg : ∀ w : NumberField.InfinitePlace K, 0 ≤ h_step w := by
    intro w; dsimp [h_step]; positivity
  have h_one_sub_inv_nonneg : 0 ≤ 1 - X⁻¹ := by
    have : X⁻¹ < 1 := inv_lt_one_of_one_lt₀ hX
    linarith
  have h_I_lo : ∀ w : NumberField.InfinitePlace K, 1 - X⁻¹ ≤ I_sum w := by
    intro w
    have hw_mult_ge_one : (1 : ℝ) ≤ (w.mult : ℝ) := by
      exact_mod_cast NumberField.InfinitePlace.one_le_mult (w := w)
    have h_mh : -(m : ℝ) * h_step w = -(w.mult : ℝ) * Real.log X := by
      dsimp [h_step, δ]
      have hm_ne : (m : ℝ) ≠ 0 := ne_of_gt hm_rpos
      field_simp [hm_ne]
    have h_exp_mh_le : Real.exp (-(m : ℝ) * h_step w) ≤ X⁻¹ := by
      have h_inv_eq : X⁻¹ = Real.exp (-Real.log X) := by
        rw [Real.exp_neg, Real.exp_log hX_pos]
      rw [h_mh, h_inv_eq, Real.exp_le_exp]
      nlinarith [hw_mult_ge_one, hlog_pos]
    have h_s2_lo := (h_s2 m (h_step w) (hh_step_nonneg w)).1
    change 1 - Real.exp (-(m : ℝ) * h_step w) ≤ I_sum w at h_s2_lo
    linarith
  have h_I_hi : ∀ w : NumberField.InfinitePlace K, I_sum w ≤ Real.exp (h_step w) := by
    intro w
    exact (h_s2 m (h_step w) (hh_step_nonneg w)).2.2
  have h_card_erase : (Finset.univ.erase w₀).card = r := by
    rw [Finset.card_erase_of_mem (Finset.mem_univ w₀), Finset.card_univ]
    rfl
  have hP_lo : (1 - X⁻¹) ^ r ≤ P := by
    have h_const : (1 - X⁻¹) ^ r = ∏ _w ∈ Finset.univ.erase w₀, (1 - X⁻¹) := by
      rw [Finset.prod_const, h_card_erase]
    rw [h_const]
    exact Finset.prod_le_prod (fun _ _ => h_one_sub_inv_nonneg) (fun w _ => h_I_lo w)
  have hP_hi : P ≤ Real.exp ((n : ℝ) * (Real.log X / (m : ℝ))) := by
    have h_prod_exp : P ≤ ∏ w ∈ Finset.univ.erase w₀, Real.exp (h_step w) :=
      Finset.prod_le_prod (fun w _ => le_trans h_one_sub_inv_nonneg (h_I_lo w)) (fun w _ => h_I_hi w)
    rw [← Real.exp_sum] at h_prod_exp
    have h_sum_erase_le :
        (∑ w ∈ Finset.univ.erase w₀, h_step w) ≤ ∑ w : NumberField.InfinitePlace K, h_step w :=
      Finset.sum_le_univ_sum_of_nonneg (fun w => hh_step_nonneg w)
    have h_sum_univ_eq :
        (∑ w : NumberField.InfinitePlace K, h_step w) = (n : ℝ) * (Real.log X / (m : ℝ)) := by
      dsimp [h_step, δ]
      rw [← Finset.sum_mul]
      have h_sum_mult : (∑ w : NumberField.InfinitePlace K, (w.mult : ℝ)) = (n : ℝ) := by
        exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
      rw [h_sum_mult]
    calc P
      _ ≤ Real.exp (∑ w ∈ Finset.univ.erase w₀, h_step w) := h_prod_exp
      _ ≤ Real.exp (∑ w : NumberField.InfinitePlace K, h_step w) := Real.exp_le_exp.mpr h_sum_erase_le
      _ = Real.exp ((n : ℝ) * (Real.log X / (m : ℝ))) := by rw [h_sum_univ_eq]
  have h_abs_P := h_s3 n r X hX m hm hm_log P hP_lo hP_hi
  have hw₀_le_n : w₀.mult ≤ n := by
    dsimp [n]
    rw [← NumberField.InfinitePlace.sum_mult_eq]
    exact Finset.single_le_sum (fun w _ => Nat.zero_le w.mult) (Finset.mem_univ w₀)
  have hw₀_rle_n : (w₀.mult : ℝ) ≤ (n : ℝ) := Nat.cast_le.mpr hw₀_le_n
  have hw₀_nonneg : 0 ≤ (w₀.mult : ℝ) := Nat.cast_nonneg w₀.mult
  set t : ℝ := Real.sqrt (Real.log X)
  have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg _
  have hexp_t_le : Real.exp (-t) ≤ Real.exp (-t / c_sum) := by
    rw [Real.exp_le_exp, neg_div, neg_le_neg_iff]
    exact div_le_self ht_nonneg hc_sum_ge_one
  have h_diff_eq : (w₀.mult : ℝ) * Y * P - (w₀.mult : ℝ) * Y = (w₀.mult : ℝ) * Y * (P - 1) := by ring
  rw [h_sum_eq, h_diff_eq, abs_mul, abs_of_nonneg (mul_nonneg hw₀_nonneg hY_nonneg)]
  have h_w0Y_le : (w₀.mult : ℝ) * Y ≤ (n : ℝ) * Y :=
    mul_le_mul_of_nonneg_right hw₀_rle_n hY_nonneg
  set L_term : ℝ := (Real.log X + 1) ^ 2 / (m : ℝ)
  have hL_nonneg : 0 ≤ L_term := by dsimp [L_term]; positivity
  have h_c1 : (n : ℝ) ^ 2 * Real.exp (n : ℝ) ≤ c_sum := by
    have : 0 ≤ (n : ℝ) * ((r : ℝ) + 1) * Real.exp 1 + 1 := by positivity
    dsimp [c_sum]; linarith
  have h_c2 : (n : ℝ) * (r : ℝ) * Real.exp 1 ≤ c_sum := by
    have : 0 ≤ (n : ℝ) ^ 2 * Real.exp (n : ℝ) + (n : ℝ) * Real.exp 1 + 1 := by positivity
    dsimp [c_sum]; linarith
  calc (w₀.mult : ℝ) * Y * |P - 1|
    _ ≤ ((n : ℝ) * Y) * |P - 1| := mul_le_mul_of_nonneg_right h_w0Y_le (abs_nonneg _)
    _ ≤ ((n : ℝ) * Y) * (Real.exp (n : ℝ) * (n : ℝ) * L_term + (r : ℝ) * Real.exp 1 * Real.exp (-t)) :=
      mul_le_mul_of_nonneg_left h_abs_P (by positivity)
    _ ≤ ((n : ℝ) * Y) * (Real.exp (n : ℝ) * (n : ℝ) * L_term + (r : ℝ) * Real.exp 1 * Real.exp (-t / c_sum)) := by
      gcongr
    _ = ((n : ℝ) ^ 2 * Real.exp (n : ℝ)) * (Y * L_term) +
          ((n : ℝ) * (r : ℝ) * Real.exp 1) * (Y * Real.exp (-t / c_sum)) := by ring
    _ ≤ c_sum * (Y * L_term) + c_sum * (Y * Real.exp (-t / c_sum)) := by
      gcongr
    _ = c_sum * Y * L_term + c_sum * Y * Real.exp (-t / c_sum) := by ring

theorem mitsui_riesz_primeIdeals_to_primePowers {K : Type u} [Field K] [NumberField K] :
    ∃ c₂ : ℝ, 0 < c₂ ∧
      ∀ Y : ℝ, 0 < Y →
        |(∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
              (Ideal.absNorm p.asIdeal : ℝ) ≤ Y},
            Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal) *
              Real.log (Y / (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal : ℝ)))
          - (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
              Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)))|
          ≤ c₂ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₂) :=
by
  classical
  have h_s1 : ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ s : ℝ, 1 ≤ s →
      (Nat.card {J : Ideal (NumberField.RingOfIntegers K) // (Ideal.absNorm J : ℝ) ≤ s} : ℝ) ≤
        C₁ * s := by
    set L_K : ℝ :=
      2 ^ NumberField.InfinitePlace.nrRealPlaces K *
        (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
        NumberField.Units.regulator K *
        (NumberField.classNumber K : ℝ) /
        ((NumberField.Units.torsionOrder K : ℝ) * Real.sqrt |(NumberField.discr K : ℝ)|)
    have h_tendsto : Filter.Tendsto
        (fun s : ℝ => (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ s} : ℝ) / s)
        Filter.atTop (nhds L_K) :=
      NumberField.Ideal.tendsto_norm_le_div_atTop K
    obtain ⟨S₀, hS₀⟩ := (Metric.tendsto_atTop.mp h_tendsto) 1 zero_lt_one
    let S₁ : ℝ := max S₀ 1
    let N₁ : ℕ := Nat.card {J : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm J ≤ ⌊S₁⌋₊}
    let C₁ : ℝ := max (|L_K| + 1) ((N₁ : ℝ) + 1)
    have hC₁_pos : 0 < C₁ := by
      have h1 : 0 ≤ |L_K| := abs_nonneg L_K
      have h2 : |L_K| + 1 ≤ C₁ := le_max_left _ _
      linarith
    refine ⟨C₁, hC₁_pos, ?_⟩
    intro s hs
    have hs_pos : 0 < s := lt_of_lt_of_le zero_lt_one hs
    by_cases hS : S₁ ≤ s
    · have hS₀_le : S₀ ≤ s := le_trans (le_max_left S₀ 1) hS
      have h_dist := hS₀ s hS₀_le
      rw [Real.dist_eq] at h_dist
      have h_sub : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ s} : ℝ) / s - L_K < 1 :=
        (abs_sub_lt_iff.mp h_dist).1
      have h_abs : L_K ≤ |L_K| := le_abs_self L_K
      have h_max : |L_K| + 1 ≤ C₁ := le_max_left _ _
      have h_div_le : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ s} : ℝ) / s ≤ C₁ := by linarith
      exact (div_le_iff₀ hs_pos).mp h_div_le
    · have hs_le : s ≤ S₁ := le_of_not_ge hS
      have h_sub : {J : Ideal (NumberField.RingOfIntegers K) | (Ideal.absNorm J : ℝ) ≤ s} ⊆
          {J : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm J ≤ ⌊S₁⌋₊} := by
        intro J hJ
        exact Nat.le_floor (le_trans hJ hs_le)
      have h_fin : {J : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm J ≤ ⌊S₁⌋₊}.Finite :=
        Ideal.finite_setOf_absNorm_le ⌊S₁⌋₊
      have h_card_le : Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ s} ≤ N₁ :=
        Nat.card_mono h_fin h_sub
      have h_card_real : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
