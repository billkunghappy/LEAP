      _ = (Real.exp 1 * (C_coeff * (2 * (3 : ℝ) ^ (NumberField.Units.rank K) * c_base))) * Y₀ *
            (Real.exp (c' * t / 2) * Real.exp (t / (8 * c_base)) * Real.exp (-t / c_base)) := by ring
      _ ≤ (Real.exp 1 * (C_coeff * (2 * (3 : ℝ) ^ (NumberField.Units.rank K) * c_base))) * Y₀ *
            Real.exp (-t / (2 * c_base)) :=
        mul_le_mul_of_nonneg_left h_exp_osc_le (by positivity)
      _ ≤ (Real.exp 1 * (C_coeff * (2 * (3 : ℝ) ^ (NumberField.Units.rank K) * c_base))) * Y₀ *
            Real.exp (-t / c_coord) :=
        mul_le_mul_of_nonneg_left hexp_2cb_le_c_coord (by positivity)
  have h_term_collar_grid :
      (2 * (A_collar + ε_tail) + C_grid * δ * (Real.log X + 1) ^ (NumberField.Units.rank K)) * Ψ₁_K ≤
