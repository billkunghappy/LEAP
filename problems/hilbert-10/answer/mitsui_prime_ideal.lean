      intro b q
      dsimp [w_b]
      rw [Finset.sum_mul, Finset.sum_mul, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun ξ _ => ?_)
      split_ifs <;> ring
    calc (∑ l_real ∈ B_real, χ l_real * ∑ q ∈ S_main, w_main l_real q * (Hat_q q : ℂ))
      _ = ∑ l_real ∈ B_real, ∑ q ∈ S_main, χ l_real * (w_main l_real q * (Hat_q q : ℂ)) := by
        refine Finset.sum_congr rfl (fun l_real _ => Finset.mul_sum _ _ _)
      _ = ∑ q ∈ S_main, ∑ l_real ∈ B_real, χ l_real * (w_main l_real q * (Hat_q q : ℂ)) :=
        Finset.sum_comm
      _ = ∑ q ∈ S_main, ∑ b : ι_b,
            ∑ ξ : ι_ξ,
              if q ∈ S_main_slice ξ then
                (Hat_q q : ℂ) * (c_ind ξ b * χ (l_emb b) * ψ₀ b q)
