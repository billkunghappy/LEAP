      have hγK_ne : (γ : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hγ_ne_C
      have hγ₀K_ne : (γ₀ : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hγ₀_ne
      have hc₁K_eq : (γ₀ : K) * (c₂ : K) = (γ : K) * (c₁ : K) := by exact_mod_cast hc₁_eq
      rw [div_eq_div_iff hγK_ne hγ₀K_ne]
      push_cast
      linear_combination (α a : K) * (x_star.1 : K) * hc₁K_eq
    have h3 : e_K (((c₁ * α a : R) : K) * (x_star.1 : K) / (γ₀ : K)) =
        e_K ((β (u₁ * a) : K) * (x_star.1 : K) / (γ₀ : K)) := by
      have h3a : ((c₁ * α a : R) : K) * (x_star.1 : K) = (((c₁ * α a) * x_star.1 : R) : K) := by
        push_cast; rfl
      have h3b : (β (u₁ * a) : K) * (x_star.1 : K) = ((β (u₁ * a) * x_star.1 : R) : K) := by
        push_cast; rfl
      rw [h3a, h3b]
      refine he_B₀_congr ((c₁ * α a) * x_star.1) (β (u₁ * a) * x_star.1) ?_ ?_
      · rw [← sub_mul]
        refine Ideal.mul_mem_right _ (B₀ : Ideal R) (sub_mem ?_ (hβ (u₁ * a)).1)
        exact Ideal.mul_mem_right _ (B₀ : Ideal R) hc₁_B₀
      · rw [map_mul, map_mul, map_mul, hα_mk_C a, (hβ (u₁ * a)).2]
    rw [h1, h2, h3]
  have hc₁_cop : Ideal.span ({c₁} : Set R) ⊔ f = ⊤ := by
    rw [← hc₁_span]
    exact h_cop_mul _ _ hB₀_cop hM₀_cop
  have hc₂_cop : Ideal.span ({c₂} : Set R) ⊔ f = ⊤ := by
    rw [← hc₂_span']
    exact h_cop_mul _ _ (h_cop_mul _ _ hJC_cop hJstar_cop) hM₀_cop
  have hu₁ : IsUnit u₁ := (h_unit_iff_sup c₁).mpr hc₁_cop
  have hu₂ : IsUnit u₂ := (h_unit_iff_sup c₂).mpr hc₂_cop
  let u₁_unit : (R ⧸ f)ˣ := hu₁.unit
  have hu₁_eq : (u₁_unit : R ⧸ f) = u₁ := hu₁.unit_spec
  let equiv₁ : (R ⧸ f) ≃ (R ⧸ f) :=
    { toFun := fun a => u₁ * a
      invFun := fun a => ↑(u₁_unit⁻¹) * a
      left_inv := fun a => by dsimp; rw [← mul_assoc, ← hu₁_eq, Units.inv_mul, one_mul]
      right_inv := fun a => by dsimp; rw [← mul_assoc, ← hu₁_eq, Units.mul_inv, one_mul] }
  let u₂_unit : (R ⧸ f)ˣ := hu₂.unit
  have hu₂_eq : (u₂_unit : R ⧸ f) = u₂ := hu₂.unit_spec
  let equiv₂ : (R ⧸ f) ≃ (R ⧸ f) :=
    { toFun := fun a => u₂ * a
      invFun := fun a => ↑(u₂_unit⁻¹) * a
      left_inv := fun a => by dsimp; rw [← mul_assoc, ← hu₂_eq, Units.inv_mul, one_mul]
      right_inv := fun a => by dsimp; rw [← mul_assoc, ← hu₂_eq, Units.mul_inv, one_mul] }
  let G_C : ℂ := ∑ a : R ⧸ f, ψ_f a * e_K ((α a : K) * (x_star.1 : K) / (γ : K))
  have h_GC_reindex : G_C = ψ_f u₂ * ∑ a : R ⧸ f,
      ψ_f a * e_K ((β (u₁ * a) : K) * (x_star.1 : K) / (γ₀ : K)) := by
    have h_eq1 : (∑ a : R ⧸ f, ψ_f (u₂ * a) * e_K ((α (u₂ * a) : K) * (x_star.1 : K) / (γ : K))) = G_C :=
      Fintype.sum_equiv equiv₂
        (fun a => ψ_f (u₂ * a) * e_K ((α (u₂ * a) : K) * (x_star.1 : K) / (γ : K)))
        (fun a => ψ_f a * e_K ((α a : K) * (x_star.1 : K) / (γ : K)))
        (fun _ => rfl)
    rw [← h_eq1, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [hψ_mul u₂ a, he_align a, mul_assoc]
  have h_G0_reindex : G₀ x_star.1 = ψ_f u₁ * ∑ a : R ⧸ f,
      ψ_f a * e_K ((β (u₁ * a) : K) * (x_star.1 : K) / (γ₀ : K)) := by
    have h_eq1 : (∑ a : R ⧸ f, ψ_f (u₁ * a) * e_K ((β (u₁ * a) : K) * (x_star.1 : K) / (γ₀ : K))) = G₀ x_star.1 :=
      Fintype.sum_equiv equiv₁
        (fun a => ψ_f (u₁ * a) * e_K ((β (u₁ * a) : K) * (x_star.1 : K) / (γ₀ : K)))
        (fun a => ψ_f a * e_K ((β a : K) * (x_star.1 : K) / (γ₀ : K)))
        (fun _ => rfl)
    rw [← h_eq1, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [hψ_mul u₁ a, mul_assoc]
  have h_u1_GC : ψ_f u₁ * G_C = ψ_f u₂ * G₀ x_star.1 := by
    rw [h_GC_reindex, h_G0_reindex]
    ring
  have h_span_c₁ : χ₀ B₀ * χ₀ M₀ = ψ_f u₁ * T c₁ := by
    rw [← map_mul]
    have h_sub : B₀ * M₀ = ⟨Ideal.span ({c₁} : Set R),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hc₁_ne)⟩ :=
      Subtype.ext hc₁_span
    rw [h_sub]
    exact hψ_span_T c₁ hc₁_ne
  have h_span_c₂ : χ₀ J_C * χ₀ J_star * χ₀ M₀ = ψ_f u₂ * T c₂ := by
    rw [← map_mul, ← map_mul]
    have h_sub : J_C * J_star * M₀ = ⟨Ideal.span ({c₂} : Set R),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hc₂_ne)⟩ :=
      Subtype.ext hc₂_span'
    rw [h_sub]
    exact hψ_span_T c₂ hc₂_ne
  have h_T_cross : T γ₀ * T c₂ = T γ * T c₁ := by
    rw [← hT_mul γ₀ c₂ hγ₀_ne hc₂_ne, ← hT_mul γ c₁ hγ_ne_C hc₁_ne, hc₁_eq]
  have h_T_c₁_conj : star (T c₁) * T c₁ = 1 := hT_conj c₁ hc₁_ne
  have h_T_c₂_conj : star (T c₂) * T c₂ = 1 := hT_conj c₂ hc₂_ne
  have h_B₀_conj : star (χ₀ B₀) * χ₀ B₀ = 1 :=
    h_star_mul_eq_one (χ₀ B₀) ((hχ₀_norm_supp B₀).1 hB₀_cop)
  have h_M₀_conj : star (χ₀ M₀) * χ₀ M₀ = 1 :=
    h_star_mul_eq_one (χ₀ M₀) ((hχ₀_norm_supp M₀).1 hM₀_cop)
  have h_JC_conj : star (χ₀ J_C) * χ₀ J_C = 1 :=
    h_star_mul_eq_one (χ₀ J_C) ((hχ₀_norm_supp J_C).1 hJC_cop)
  have h_s3 : star (χ₀ J_C) * (T γ * G_C) =
      T γ₀ * star (χ₀ B₀) * χ₀ J_star * G₀ x_star.1 := by
    have h_u1_eq : ψ_f u₁ = χ₀ B₀ * χ₀ M₀ * star (T c₁) := by
      calc ψ_f u₁ = (ψ_f u₁ * T c₁) * star (T c₁) := by linear_combination -ψ_f u₁ * h_T_c₁_conj
        _ = χ₀ B₀ * χ₀ M₀ * star (T c₁) := by rw [← h_span_c₁]
    have h_u2_eq : ψ_f u₂ = χ₀ J_C * χ₀ J_star * χ₀ M₀ * star (T c₂) := by
      calc ψ_f u₂ = (ψ_f u₂ * T c₂) * star (T c₂) := by linear_combination -ψ_f u₂ * h_T_c₂_conj
        _ = χ₀ J_C * χ₀ J_star * χ₀ M₀ * star (T c₂) := by rw [← h_span_c₂]
    have h_Tγ_eq : T γ = T γ₀ * T c₂ * star (T c₁) := by
      calc T γ = (T γ * T c₁) * star (T c₁) := by linear_combination -T γ * h_T_c₁_conj
        _ = T γ₀ * T c₂ * star (T c₁) := by rw [← h_T_cross]
    have h_u1_inv : (star (χ₀ B₀) * star (χ₀ M₀) * T c₁) * ψ_f u₁ = 1 := by
      calc (star (χ₀ B₀) * star (χ₀ M₀) * T c₁) * ψ_f u₁
        _ = (star (χ₀ B₀) * χ₀ B₀) * (star (χ₀ M₀) * χ₀ M₀) * (star (T c₁) * T c₁) := by
            rw [h_u1_eq]; ring
        _ = 1 := by
            rw [h_B₀_conj, h_M₀_conj, h_T_c₁_conj]; ring
    calc star (χ₀ J_C) * (T γ * G_C)
      _ = star (χ₀ J_C) * T γ * ((star (χ₀ B₀) * star (χ₀ M₀) * T c₁) * ψ_f u₁) * G_C := by
          rw [h_u1_inv]; ring
      _ = star (χ₀ J_C) * T γ * (star (χ₀ B₀) * star (χ₀ M₀) * T c₁) * (ψ_f u₁ * G_C) := by ring
      _ = star (χ₀ J_C) * T γ * (star (χ₀ B₀) * star (χ₀ M₀) * T c₁) * (ψ_f u₂ * G₀ x_star.1) := by
          rw [h_u1_GC]
      _ = T γ₀ * star (χ₀ B₀) * χ₀ J_star * G₀ x_star.1 *
            (star (T c₁) * T c₁) * (star (χ₀ J_C) * χ₀ J_C) * (star (χ₀ M₀) * χ₀ M₀) * (star (T c₂) * T c₂) := by
          rw [h_Tγ_eq, h_u2_eq]; ring
      _ = T γ₀ * star (χ₀ B₀) * χ₀ J_star * G₀ x_star.1 := by
          rw [h_T_c₁_conj, h_JC_conj, h_M₀_conj, h_T_c₂_conj]; ring
  rw [tsum_fintype]
  change star (χ₀ J_C) *
      ((-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
        S γ * E_inv γ * ((N_f_inv_sqrt : ℂ) * G_C)) =
    ω_χ * χ₀ J_star * star (ψ_f (Ideal.Quotient.mk f x_star.1))
  calc star (χ₀ J_C) *
      ((-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
        S γ * E_inv γ * ((N_f_inv_sqrt : ℂ) * G_C))
    _ = (-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
          (N_f_inv_sqrt : ℂ) * (star (χ₀ J_C) * (T γ * G_C)) := by
        dsimp [T]
        ring
    _ = (-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
          (N_f_inv_sqrt : ℂ) * (T γ₀ * star (χ₀ B₀) * χ₀ J_star * G₀ x_star.1) := by rw [h_s3]
    _ = (-Complex.I) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
          T γ₀ * star (χ₀ B₀) * ((N_f_inv_sqrt : ℂ) * (τ_sum * star (ψ_f (Ideal.Quotient.mk f x_star.1)))) *
          χ₀ J_star := by
        rw [hG₀_eval x_star.1]
        ring
    _ = ω_χ * χ₀ J_star * star (ψ_f (Ideal.Quotient.mk f x_star.1)) := by
        dsimp [ω_χ, τ₀]
        ring

theorem mitsui_shifted_ideal_lattice_trace_dual_zbasis_and_det {K : Type u} [Field K] [NumberField K]
    (M J_star : Ideal (NumberField.RingOfIntegers K)) (hM : M ≠ 0) (hJ_star : J_star ≠ 0)
    (γ : NumberField.RingOfIntegers K) (hγ : γ ≠ 0)
    (h_dual : differentIdeal ℤ (NumberField.RingOfIntegers K) * M * J_star =
      Ideal.span ({γ} : Set (NumberField.RingOfIntegers K)))
    (α : NumberField.RingOfIntegers K) :
    let R := NumberField.RingOfIntegers K
    let n : ℕ := Module.finrank ℚ K
    let D : ℝ := |(NumberField.discr K : ℝ)|
    ∃ (v₁ v₂ : Fin n → R)
      (e₁ : (Fin n → ℤ) ≃ M)
      (e₂ : (Fin n → ℤ) ≃ J_star)
      (u : Fin n → ℚ),
      (∀ k : Fin n → ℤ,
        ((α + (e₁ k).1 : R) : K) = ∑ i : Fin n, ((u i + (k i : ℚ) : ℚ) : K) * (v₁ i : K)) ∧
      (∀ l : Fin n → ℤ,
        (((e₂ l).1 : R) : K) = ∑ i : Fin n, ((l i : ℚ) : K) * (v₂ i : K)) ∧
      (∀ l : Fin n → ℤ,
        Algebra.trace ℚ K ((α : K) * (((e₂ l).1 : R) : K) / (γ : K)) =
          ∑ i : Fin n, u i * (l i : ℚ)) ∧
      (∀ i j : Fin n,
        (Algebra.trace ℚ K ((v₁ i : K) * ((v₂ j : K) / (γ : K))) : ℝ) =
          if i = j then 1 else 0) ∧
      |(Matrix.of (fun i j : Fin n =>
          (Algebra.trace ℚ K ((v₁ i : K) * (v₁ j : K)) : ℝ))).det| =
        D * (Ideal.absNorm M : ℝ) ^ 2 :=
by
  classical
  intro R n D
  have h_s1 : ∃ b₁ : Module.Basis (Fin n) ℚ K,
      (∀ x : K,
        x ∈ Submodule.span ℤ (Set.range ⇑b₁) ↔
          x ∈ (M : FractionalIdeal (nonZeroDivisors R) K)) ∧
      |(Matrix.of (fun i j : Fin n =>
          (Algebra.trace ℚ K (b₁ i * b₁ j) : ℝ))).det| =
        D * (Ideal.absNorm M : ℝ) ^ 2 := by
    have hM_ne : M ≠ ⊥ := hM
    let I₁ : FractionalIdeal (nonZeroDivisors R) K := ↑M
    have hI₁_ne : I₁ ≠ 0 := FractionalIdeal.coeIdeal_ne_zero.mpr hM_ne
    let I₁_unit : (FractionalIdeal (nonZeroDivisors R) K)ˣ := Units.mk0 I₁ hI₁_ne
    let b_int := NumberField.integralBasis K
    let b_frac := NumberField.basisOfFractionalIdeal K I₁_unit
    have h_card_int : Fintype.card (Module.Free.ChooseBasisIndex ℤ R) = n := by
      rw [← Module.finrank_eq_card_basis b_int]
    have h_card_frac :
        Fintype.card (Module.Free.ChooseBasisIndex ℤ ↥((I₁_unit : FractionalIdeal (nonZeroDivisors R) K) : Submodule R K)) = n := by
      rw [← Module.finrank_eq_card_basis b_frac]
    let e₀ : Module.Free.ChooseBasisIndex ℤ R ≃ Fin n :=
      Fintype.equivOfCardEq (h_card_int.trans (Fintype.card_fin n).symm)
    let e₁ : Module.Free.ChooseBasisIndex ℤ ↥((I₁_unit : FractionalIdeal (nonZeroDivisors R) K) : Submodule R K) ≃ Fin n :=
      Fintype.equivOfCardEq (h_card_frac.trans (Fintype.card_fin n).symm)
    let e₀₁ : Module.Free.ChooseBasisIndex ℤ R ≃
        Module.Free.ChooseBasisIndex ℤ ↥((I₁_unit : FractionalIdeal (nonZeroDivisors R) K) : Submodule R K) :=
      e₀.trans e₁.symm
    let b₁ : Module.Basis (Fin n) ℚ K := b_frac.reindex e₁
    refine ⟨b₁, ?_, ?_⟩
    · intro x
      have h_range : Set.range ⇑b₁ = Set.range ⇑b_frac := by
        ext y
        simp [b₁]
      rw [h_range, NumberField.mem_span_basisOfFractionalIdeal]
      rfl
    · let b₁₀ : Module.Basis (Module.Free.ChooseBasisIndex ℤ R) ℚ K := b_frac.reindex e₀₁.symm
      have hb₁₀_coe : ⇑b₁₀ = ⇑b₁ ∘ ⇑(e₀.symm).symm := by
        ext i
        dsimp [b₁₀, b₁, e₀₁]
        simp [Module.Basis.reindex_apply]
      have h_discr_reindex : Algebra.discr ℚ ⇑b₁₀ = Algebra.discr ℚ ⇑b₁ := by
        rw [hb₁₀_coe]
        exact Algebra.discr_reindex ℚ b₁ e₀.symm
      let P := b_int.toMatrix ⇑b₁₀
      have h_vecMul : Matrix.vecMul ⇑b_int (P.map (algebraMap ℚ K)) = ⇑b₁₀ := by
        ext j
        rw [Matrix.vecMul_eq_sum, Finset.sum_apply]
        have h_sum : (∑ i, (b_int i • P.map (algebraMap ℚ K) i) j) = ∑ i, P i j • b_int i := by
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [Pi.smul_apply, Matrix.map_apply, smul_eq_mul, Algebra.smul_def, mul_comm]
        rw [h_sum]
        exact b_int.sum_toMatrix_smul_self ⇑b₁₀ j
      have h_discr_vecMul : Algebra.discr ℚ ⇑b₁₀ = P.det ^ 2 * Algebra.discr ℚ ⇑b_int := by
        rw [← h_vecMul]
        exact Algebra.discr_of_matrix_vecMul ⇑b_int P
      have h_det_abs : |P.det| = (Ideal.absNorm M : ℚ) := by
        have h1 : P.det = b_int.det ⇑b₁₀ := (b_int.det_apply ⇑b₁₀).symm
        rw [h1]
        have h2 := NumberField.det_basisOfFractionalIdeal_eq_absNorm K I₁_unit e₀₁
        have h3 : FractionalIdeal.absNorm (I₁_unit : FractionalIdeal (nonZeroDivisors R) K) =
            (Ideal.absNorm M : ℚ) :=
          FractionalIdeal.coeIdeal_absNorm M
        exact h2.trans h3
      have h_det_sq : P.det ^ 2 = (Ideal.absNorm M : ℚ) ^ 2 := by
        rw [← sq_abs P.det, h_det_abs]
      have h_discr_eq :
          (Algebra.traceMatrix ℚ ⇑b₁).det =
            (Ideal.absNorm M : ℚ) ^ 2 * (NumberField.discr K : ℚ) := by
        rw [← Algebra.discr_def ℚ ⇑b₁, ← h_discr_reindex, h_discr_vecMul, h_det_sq, NumberField.coe_discr K]
      have h_mat_eq :
          Matrix.of (fun i j : Fin n => (Algebra.trace ℚ K (b₁ i * b₁ j) : ℝ)) =
            (algebraMap ℚ ℝ).mapMatrix (Algebra.traceMatrix ℚ ⇑b₁) := by
        ext i j
        simp [Algebra.traceMatrix_apply]
      rw [h_mat_eq, ← RingHom.map_det (algebraMap ℚ ℝ)]
      change |(((Algebra.traceMatrix ℚ ⇑b₁).det : ℚ) : ℝ)| = D * (Ideal.absNorm M : ℝ) ^ 2
      rw [h_discr_eq]
      push_cast
      rw [abs_mul, abs_pow, Nat.abs_cast, mul_comm]
  obtain ⟨b₁, hb₁_span, hb₁_det⟩ := h_s1
  have h_s2 : ∃ u : Fin n → ℚ,
      ((α : R) : K) = (∑ i : Fin n, (u i : K) * b₁ i) ∧
      (∀ l : Fin n → ℤ,
        Algebra.trace ℚ K ((α : K) * ∑ j : Fin n, ((l j : ℚ) : K) * b₁.traceDual j) =
          ∑ i : Fin n, u i * (l i : ℚ)) ∧
      (∀ i j : Fin n,
        (Algebra.trace ℚ K (b₁ i * b₁.traceDual j) : ℝ) =
          if i = j then 1 else 0) ∧
      (∀ x : K,
        x ∈ Submodule.span ℤ (Set.range ⇑b₁.traceDual) ↔
          (γ : K) * x ∈ (J_star : FractionalIdeal (nonZeroDivisors R) K)) := by
    let u : Fin n → ℚ := fun i => b₁.repr (α : K) i
    refine ⟨u, ?_, ?_, ?_, ?_⟩
    · have h1 := (b₁.sum_repr (α : K)).symm
      rw [h1]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      dsimp [u]
      rw [Algebra.smul_def, eq_ratCast]
    · have hu_trace : ∀ j : Fin n, Algebra.trace ℚ K ((α : K) * b₁.traceDual j) = u j := by
        intro j
        have h_sum_α : ((α : R) : K) = ∑ i : Fin n, u i • b₁ i := (b₁.sum_repr (α : K)).symm
        rw [h_sum_α, Finset.sum_mul, map_sum]
        have h_term : ∀ i : Fin n,
            Algebra.trace ℚ K (u i • b₁ i * b₁.traceDual j) = if i = j then u i else 0 := by
          intro i
          rw [smul_mul_assoc, map_smul, b₁.trace_mul_traceDual i j, smul_eq_mul]
          split_ifs <;> simp
        simp_rw [h_term]
        simp
      intro l
      have h_mul_sum :
          ((α : R) : K) * (∑ j : Fin n, ((l j : ℚ) : K) * b₁.traceDual j) =
            ∑ j : Fin n, (l j : ℚ) • (((α : R) : K) * b₁.traceDual j) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [Algebra.smul_def, eq_ratCast]
        ring
      rw [h_mul_sum, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_smul, hu_trace j, smul_eq_mul, mul_comm]
    · intro i j
      rw [b₁.trace_mul_traceDual i j]
      split_ifs <;> simp
    · intro x
      have hM_ne : M ≠ ⊥ := hM
      let I₁ : FractionalIdeal (nonZeroDivisors R) K := ↑M
      let I₂ : FractionalIdeal (nonZeroDivisors R) K := ↑J_star
      let I_D : FractionalIdeal (nonZeroDivisors R) K := ↑(differentIdeal ℤ R : Ideal R)
      have hI₁_ne : I₁ ≠ 0 := FractionalIdeal.coeIdeal_ne_zero.mpr hM_ne
      have h_sub_eq : Submodule.restrictScalars ℤ (I₁ : Submodule R K) = Submodule.span ℤ (Set.range ⇑b₁) := by
        ext y
        exact (hb₁_span y).symm
      have h_dual_span := Submodule.traceDual_span_of_basis ℤ (I₁ : Submodule R K) b₁ h_sub_eq
      have h_coe_dual : ((FractionalIdeal.dual ℤ ℚ I₁ : FractionalIdeal (nonZeroDivisors R) K) : Submodule R K) =
          Submodule.traceDual ℤ ℚ (I₁ : Submodule R K) :=
        FractionalIdeal.coe_dual ℤ ℚ hI₁_ne
      have h_mem_dual : x ∈ Submodule.span ℤ (Set.range ⇑b₁.traceDual) ↔ x ∈ FractionalIdeal.dual ℤ ℚ I₁ := by
        rw [← h_dual_span, ← h_coe_dual]
        rfl
      rw [h_mem_dual]
      have h_diff : I_D = (FractionalIdeal.dual ℤ ℚ (1 : FractionalIdeal (nonZeroDivisors R) K))⁻¹ :=
        coeIdeal_differentIdeal ℤ ℚ K R
      have h_dual_one : FractionalIdeal.dual ℤ ℚ (1 : FractionalIdeal (nonZeroDivisors R) K) = I_D⁻¹ := by
        rw [h_diff, inv_inv]
      have h_dual_I₁ : FractionalIdeal.dual ℤ ℚ I₁ = (I_D * I₁)⁻¹ := by
        rw [FractionalIdeal.dual_eq_mul_inv ℤ ℚ I₁, h_dual_one, mul_inv_rev, mul_comm]
      let S_γ : FractionalIdeal (nonZeroDivisors R) K :=
        FractionalIdeal.spanSingleton (nonZeroDivisors R) (γ : K)
      have h_coe_span : (I_D * I₁) * I₂ = S_γ := by
        have h1 := congr_arg ((↑) : Ideal R → FractionalIdeal (nonZeroDivisors R) K) h_dual
        rw [FractionalIdeal.coeIdeal_mul, FractionalIdeal.coeIdeal_mul,
            FractionalIdeal.coeIdeal_span_singleton] at h1
        exact h1
      have hγ_K : (γ : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hγ
      have hSγ_ne : S_γ ≠ 0 := FractionalIdeal.spanSingleton_eq_zero_iff.not.mpr hγ_K
      have hI_D_I₁_ne : I_D * I₁ ≠ 0 := by
        intro h_zero
        rw [h_zero, zero_mul] at h_coe_span
        exact hSγ_ne h_coe_span.symm
      have h_dual_eq_span_mul :
          FractionalIdeal.dual ℤ ℚ I₁ =
            FractionalIdeal.spanSingleton (nonZeroDivisors R) (γ : K)⁻¹ * I₂ := by
        rw [h_dual_I₁, ← FractionalIdeal.spanSingleton_inv K (γ : K)]
        calc (I_D * I₁)⁻¹
            = (I_D * I₁)⁻¹ * (S_γ * S_γ⁻¹) := by rw [mul_inv_cancel₀ hSγ_ne, mul_one]
          _ = (I_D * I₁)⁻¹ * (((I_D * I₁) * I₂) * S_γ⁻¹) := by rw [h_coe_span]
          _ = ((I_D * I₁)⁻¹ * (I_D * I₁)) * (I₂ * S_γ⁻¹) := by ring
          _ = S_γ⁻¹ * I₂ := by rw [inv_mul_cancel₀ hI_D_I₁_ne, one_mul, mul_comm]
      rw [h_dual_eq_span_mul, FractionalIdeal.mem_singleton_mul]
      constructor
      · rintro ⟨y', hy', rfl⟩
        rw [mul_inv_cancel_left₀ hγ_K]
        exact hy'
      · intro hx
        exact ⟨(γ : K) * x, hx, (inv_mul_cancel_left₀ hγ_K x).symm⟩
  obtain ⟨u, hα_sum, hα_trace, h_dual_b₁, hb₂_span⟩ := h_s2
  have h_s3 : ∀ (J : Ideal R) (γ₀ : R) (hγ₀ : γ₀ ≠ 0) (b : Module.Basis (Fin n) ℚ K),
      (∀ x : K,
        x ∈ Submodule.span ℤ (Set.range ⇑b) ↔
          (γ₀ : K) * x ∈ (J : FractionalIdeal (nonZeroDivisors R) K)) →
      ∃ (v : Fin n → R)
        (e : (Fin n → ℤ) ≃ J),
        (∀ i : Fin n, (v i : K) / (γ₀ : K) = b i) ∧
        (∀ m : Fin n → ℤ,
          (((e m).1 : R) : K) = ∑ i : Fin n, ((m i : ℚ) : K) * (v i : K)) := by
    intro J γ₀ hγ₀ b hb_span
    have hγ₀_K : (γ₀ : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hγ₀
    have hv_ex : ∀ i : Fin n, ∃ r : R, r ∈ J ∧ (r : K) = (γ₀ : K) * b i := by
      intro i
      have hb_mem : b i ∈ Submodule.span ℤ (Set.range ⇑b) :=
        Submodule.subset_span (Set.mem_range_self i)
      have h_coe_mem : (γ₀ : K) * b i ∈ (J : FractionalIdeal (nonZeroDivisors R) K) :=
        (hb_span (b i)).mp hb_mem
      rwa [FractionalIdeal.mem_coeIdeal] at h_coe_mem
    let v : Fin n → R := fun i => Classical.choose (hv_ex i)
    have hv_mem : ∀ i : Fin n, v i ∈ J := fun i => (Classical.choose_spec (hv_ex i)).1
    have hv_eq : ∀ i : Fin n, (v i : K) = (γ₀ : K) * b i := fun i => (Classical.choose_spec (hv_ex i)).2
    have hv_div : ∀ i : Fin n, (v i : K) / (γ₀ : K) = b i := by
      intro i
      rw [hv_eq i, mul_div_cancel_left₀ (b i) hγ₀_K]
    let F : (Fin n → ℤ) → R := fun m => ∑ i : Fin n, m i • v i
    have hF_mem : ∀ m : Fin n → ℤ, F m ∈ J :=
      fun m => Submodule.sum_smul_mem (J.restrictScalars ℤ) m (fun i _ => hv_mem i)
    have hF_div : ∀ m : Fin n → ℤ, ((F m : R) : K) / (γ₀ : K) = ∑ i : Fin n, (m i : K) * b i := by
      intro m
      have hF_coe : ((F m : R) : K) = (γ₀ : K) * ∑ i : Fin n, (m i : K) * b i := by
        dsimp [F]
        push_cast
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        change m i • (v i : K) = (γ₀ : K) * ((m i : K) * b i)
        rw [hv_eq i, zsmul_eq_mul, mul_left_comm]
      rw [hF_coe, mul_div_cancel_left₀ _ hγ₀_K]
    have hF_repr : ∀ (m : Fin n → ℤ) (j : Fin n),
        b.repr (((F m : R) : K) / (γ₀ : K)) j = (m j : ℚ) := by
      intro m j
      rw [hF_div m]
      have h_smul : (∑ i : Fin n, (m i : K) * b i) = ∑ i : Fin n, (m i : ℚ) • b i := by
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Algebra.smul_def, eq_ratCast, Rat.cast_intCast]
      rw [h_smul, map_sum]
      simp [Module.Basis.repr_self, Finsupp.single_apply]
    have hF_inj : Function.Injective F := by
      intro m₁ m₂ hm
      ext j
      have h_eq : (m₁ j : ℚ) = (m₂ j : ℚ) := by
        rw [← hF_repr m₁ j, ← hF_repr m₂ j, hm]
      exact Int.cast_injective h_eq
    let f_sub : (Fin n → ℤ) → J := fun m => ⟨F m, hF_mem m⟩
    have hf_bij : Function.Bijective f_sub := by
      refine ⟨?_, ?_⟩
      · intro m₁ m₂ hm
        exact hF_inj (Subtype.ext_iff.mp hm)
      · rintro ⟨x, hx_mem⟩
        have hx_coe_mem : (γ₀ : K) * ((x : K) / (γ₀ : K)) ∈ (J : FractionalIdeal (nonZeroDivisors R) K) := by
          rw [mul_div_cancel₀ _ hγ₀_K]
          exact (FractionalIdeal.mem_coeIdeal (nonZeroDivisors R)).mpr ⟨x, hx_mem, rfl⟩
        have hx_span : (x : K) / (γ₀ : K) ∈ Submodule.span ℤ (Set.range ⇑b) :=
          (hb_span ((x : K) / (γ₀ : K))).mpr hx_coe_mem
        rw [Submodule.mem_span_range_iff_exists_fun ℤ] at hx_span
        obtain ⟨m, hm⟩ := hx_span
        have hF_x_div : ((F m : R) : K) / (γ₀ : K) = (x : K) / (γ₀ : K) := by
          rw [hF_div m, ← hm]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [zsmul_eq_mul]
        have hF_x_coe : ((F m : R) : K) = (x : K) := (div_left_inj' hγ₀_K).mp hF_x_div
        have hF_x : F m = x := NumberField.RingOfIntegers.ext_iff.mpr hF_x_coe
        exact ⟨m, Subtype.ext hF_x⟩
    let e : (Fin n → ℤ) ≃ J := Equiv.ofBijective f_sub hf_bij
    refine ⟨v, e, hv_div, ?_⟩
    intro m
    change ((F m : R) : K) = ∑ i : Fin n, ((m i : ℚ) : K) * (v i : K)
    dsimp [F]
    push_cast
    refine Finset.sum_congr rfl (fun i _ => ?_)
    change m i • (v i : K) = (m i : K) * (v i : K)
    rw [zsmul_eq_mul]
  have h_one_K : ((1 : R) : K) = 1 := rfl
  have hb₁_span' : ∀ x : K,
      x ∈ Submodule.span ℤ (Set.range ⇑b₁) ↔
        ((1 : R) : K) * x ∈ (M : FractionalIdeal (nonZeroDivisors R) K) := by
    intro x
    rw [h_one_K, one_mul]
    exact hb₁_span x
  obtain ⟨v₁, e₁, hv₁_eq, he₁_lin⟩ :=
    h_s3 M 1 one_ne_zero b₁ hb₁_span'
  obtain ⟨v₂, e₂, hv₂_eq, he₂_lin⟩ :=
    h_s3 J_star γ hγ b₁.traceDual hb₂_span
  have hv₁_b₁ : ∀ i : Fin n, (v₁ i : K) = b₁ i := by
    intro i
    have h1 := hv₁_eq i
    rwa [h_one_K, div_one] at h1
  refine ⟨v₁, v₂, e₁, e₂, u, ?_, he₂_lin, ?_, ?_, ?_⟩
  · intro k
    change (α : K) + (((e₁ k).1 : R) : K) = ∑ i : Fin n, ((u i + (k i : ℚ) : ℚ) : K) * (v₁ i : K)
    rw [hα_sum, he₁_lin k, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [← hv₁_b₁ i, Rat.cast_add, add_mul]
  · intro l
    have h_div_sum :
        ((α : K) * (((e₂ l).1 : R) : K) / (γ : K)) =
          (α : K) * ∑ j : Fin n, ((l j : ℚ) : K) * b₁.traceDual j := by
      rw [he₂_lin l, mul_div_assoc, Finset.sum_div]
      congr 1
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [mul_div_assoc, hv₂_eq j]
    rw [h_div_sum, hα_trace l]
  · intro i j
    rw [hv₁_b₁ i, hv₂_eq j]
    exact h_dual_b₁ i j
  · simp_rw [hv₁_b₁]
    exact hb₁_det

theorem mitsui_infinitePlace_grossenchar_harmonic_euclidean_trace_duality {K : Type u} [Field K] [NumberField K]
    (v₁ v₂ : Fin (Module.finrank ℚ K) → K)
    (γ : K) (hγ : γ ≠ 0)
    (Δ : ℝ) (hΔ : 0 < Δ)
    (h_dual : ∀ i j : Fin (Module.finrank ℚ K),
      (Algebra.trace ℚ K (v₁ i * (v₂ j / γ)) : ℝ) = if i = j then 1 else 0)
    (h_det : |(Matrix.of (fun i j : Fin (Module.finrank ℚ K) =>
        (Algebra.trace ℚ K (v₁ i * v₁ j) : ℝ))).det| = Δ ^ 2)
    (l_eff : NumberField.InfinitePlace K → ℤ)
    (hl_eff_real : ∀ w : NumberField.InfinitePlace K, w.IsReal → (l_eff w = 0 ∨ l_eff w = 1))
    (t : NumberField.InfinitePlace K → ℝ) (ht : ∀ w : NumberField.InfinitePlace K, 0 < t w) :
    let n : ℕ := Module.finrank ℚ K
    let a_place : NumberField.InfinitePlace K → ℕ := fun w => (l_eff w).natAbs
    ∃ (A : Matrix (Fin n) (Fin n) ℝ)
      (d_real d_cplx : Fin n → ℕ)
      (p : Fin n → Fin n)
      (ε : Fin n → ℝ),
      A.det ≠ 0 ∧
      |A.det| = Δ * ∏ w : NumberField.InfinitePlace K, (t w) ^ ((w.mult : ℝ) / 2) ∧
      (∀ j : Fin n, d_real j ≤ 1) ∧
      (∀ j : Fin n, (ε j) ^ 2 = 1) ∧
      (∀ j : Fin n, p (p j) = j) ∧
      (∀ j : Fin n, d_cplx j ≠ 0 →
        p j ≠ j ∧ d_real j = 0 ∧ d_real (p j) = 0 ∧ d_cplx (p j) = 0) ∧
      (∑ j : Fin n, d_real j) + (∑ j : Fin n, d_cplx j) =
        ∑ w : NumberField.InfinitePlace K, a_place w ∧
      (∀ q : Fin n → ℚ,
        (∏ j : Fin n, |A.mulVec (fun i => (q i : ℝ)) j| ^ (d_real j)) *
        (∏ j : Fin n,
          ‖((A.mulVec (fun i => (q i : ℝ)) j : ℝ) : ℂ) +
            (ε j : ℂ) * Complex.I * ((A.mulVec (fun i => (q i : ℝ)) (p j) : ℝ) : ℂ)‖ ^ (d_cplx j)) =
        (Real.sqrt 2) ^ (∑ j : Fin n, d_cplx j) *
        (∏ w : NumberField.InfinitePlace K,
          (w (∑ i : Fin n, (q i : K) * v₁ i) * (t w) ^ (1 / 2 : ℝ)) ^ (a_place w))) ∧
      (∀ q : Fin n → ℚ,
        (((∏ j : Fin n, (A.mulVec (fun i => (q i : ℝ)) j) ^ (d_real j) : ℝ) : ℂ) *
        (∏ j : Fin n,
          (((A.mulVec (fun i => (q i : ℝ)) j : ℝ) : ℂ) +
            (ε j : ℂ) * Complex.I * ((A.mulVec (fun i => (q i : ℝ)) (p j) : ℝ) : ℂ)) ^ (d_cplx j))) =
        (((Real.sqrt 2) ^ (∑ j : Fin n, d_cplx j) : ℝ) : ℂ) *
        (∏ w : NumberField.InfinitePlace K,
          ((if 0 ≤ l_eff w then w.embedding (∑ i : Fin n, (q i : K) * v₁ i)
            else star (w.embedding (∑ i : Fin n, (q i : K) * v₁ i))) *
            (((t w) ^ (1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w))) ∧
      (∀ q : Fin n → ℚ,
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * t w * (w (∑ i : Fin n, (q i : K) * v₁ i)) ^ 2) =
        ∑ j : Fin n, (A.mulVec (fun i => (q i : ℝ)) j) ^ 2) ∧
      (∀ l : Fin n → ℤ,
        (∏ j : Fin n, |A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j| ^ (d_real j)) *
        (∏ j : Fin n,
          ‖((A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j : ℝ) : ℂ) +
            (ε j : ℂ) * Complex.I * ((A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) (p j) : ℝ) : ℂ)‖ ^ (d_cplx j)) =
        (Real.sqrt 2) ^ (∑ j : Fin n, d_cplx j) *
        (∏ w : NumberField.InfinitePlace K,
          ((w (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / w γ) * (t w) ^ (-1 / 2 : ℝ)) ^ (a_place w))) ∧
      (∀ l : Fin n → ℤ,
        (((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d_real j) : ℝ) : ℂ) *
        (∏ j : Fin n,
          (((A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j : ℝ) : ℂ) +
            (ε j : ℂ) * Complex.I * ((A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) (p j) : ℝ) : ℂ)) ^ (d_cplx j))) =
        (((Real.sqrt 2) ^ (∑ j : Fin n, d_cplx j) : ℝ) : ℂ) *
        (∏ w : NumberField.InfinitePlace K,
          (w.embedding γ / (w γ : ℂ)) ^ (l_eff w)) *
        (∏ w : NumberField.InfinitePlace K,
          ((star (if 0 ≤ l_eff w then w.embedding (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i)
            else star (w.embedding (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i))) / (w γ : ℂ)) *
            (((t w) ^ (-1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w))) ∧
      (∀ l : Fin n → ℤ,
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (t w)⁻¹ * (w (∑ i : Fin n, ((l i : ℚ) : K) * v₂ i) / w γ) ^ 2) =
        ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) :=
by
  classical
  intro n a_place
  have h_s1 : ∀ x y : K,
      (Algebra.trace ℚ K (x * y) : ℝ) =
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) *
            ((w.embedding x).re * (w.embedding y).re -
              (w.embedding x).im * (w.embedding y).im) := by
    intro x y
    set z : K := x * y
    have h1 : (algebraMap ℚ ℂ) (Algebra.trace ℚ K z) = ∑ σ : K →ₐ[ℚ] ℂ, σ z :=
      trace_eq_sum_embeddings ℂ
    have h2 : (Algebra.trace ℚ K z : ℝ) = ∑ σ : K →ₐ[ℚ] ℂ, (σ z).re := by
      have hre := congr_arg Complex.re h1
      simpa [Complex.re_sum] using hre
    have h3 : (∑ σ : K →ₐ[ℚ] ℂ, (σ z).re) = ∑ φ : K →+* ℂ, (φ z).re := by
      rw [← Equiv.sum_comp (RingHom.equivRatAlgHom (R := K) (S := ℂ)) (fun σ : K →ₐ[ℚ] ℂ => (σ z).re)]
      rfl
    have h4 : (∑ φ : K →+* ℂ, (φ z).re) =
        ∑ idx : NumberField.mixedEmbedding.index K, ((NumberField.mixedEmbedding.indexEquiv K idx) z).re := by
      rw [← Equiv.sum_comp (NumberField.mixedEmbedding.indexEquiv K) (fun φ : K →+* ℂ => (φ z).re)]
    have h5 : (∑ idx : NumberField.mixedEmbedding.index K, ((NumberField.mixedEmbedding.indexEquiv K idx) z).re) =
        ∑ w : NumberField.InfinitePlace K, (w.mult : ℝ) * (w.embedding z).re := by
      dsimp [NumberField.mixedEmbedding.index]
      rw [Fintype.sum_sum_type, Fintype.sum_prod_type]
      have h_real : (∑ w : {w : NumberField.InfinitePlace K // w.IsReal},
          ((NumberField.mixedEmbedding.indexEquiv K (Sum.inl w)) z).re) =
          ∑ w : {w : NumberField.InfinitePlace K // w.IsReal}, (w.1.mult : ℝ) * (w.1.embedding z).re := by
        refine Finset.sum_congr rfl (fun w _ => ?_)
        rw [NumberField.mixedEmbedding.indexEquiv_apply_isReal w, NumberField.InfinitePlace.mult_isReal w]
        ring
      have h_cplx : (∑ w : {w : NumberField.InfinitePlace K // w.IsComplex},
          ∑ p : Fin 2, ((NumberField.mixedEmbedding.indexEquiv K (Sum.inr (w, p))) z).re) =
          ∑ w : {w : NumberField.InfinitePlace K // w.IsComplex}, (w.1.mult : ℝ) * (w.1.embedding z).re := by
        refine Finset.sum_congr rfl (fun w _ => ?_)
        rw [Fin.sum_univ_two,
          NumberField.mixedEmbedding.indexEquiv_apply_isComplex_fst w,
          NumberField.mixedEmbedding.indexEquiv_apply_isComplex_snd w,
          NumberField.ComplexEmbedding.conjugate_coe_eq,
          Complex.conj_re,
          NumberField.InfinitePlace.mult_isComplex w]
        push_cast
        ring
      rw [h_real, h_cplx, ← NumberField.InfinitePlace.sum_eq_sum_add_sum
        (fun w : NumberField.InfinitePlace K => (w.mult : ℝ) * (w.embedding z).re)]
    rw [h2, h3, h4, h5]
    refine Finset.sum_congr rfl (fun w _ => ?_)
    dsimp [z]
    rw [map_mul, Complex.mul_re]
  have h_s2 : ∀ y : K,
      (∏ w : NumberField.InfinitePlace K,
        (w (y / γ) * (t w) ^ (-1 / 2 : ℝ)) ^ (a_place w)) =
      (∏ w : NumberField.InfinitePlace K,
        ((w y / w γ) * (t w) ^ (-1 / 2 : ℝ)) ^ (a_place w)) ∧
      (∏ w : NumberField.InfinitePlace K,
        (star (if 0 ≤ l_eff w then w.embedding (y / γ) else star (w.embedding (y / γ))) *
          (((t w) ^ (-1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) =
      (∏ w : NumberField.InfinitePlace K,
        (w.embedding γ / (w γ : ℂ)) ^ (l_eff w)) *
      (∏ w : NumberField.InfinitePlace K,
        ((star (if 0 ≤ l_eff w then w.embedding y else star (w.embedding y)) / (w γ : ℂ)) *
          (((t w) ^ (-1 / 2 : ℝ) : ℝ) : ℂ)) ^ (a_place w)) ∧
      (∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * (t w)⁻¹ * (w (y / γ)) ^ 2) =
      (∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * (t w)⁻¹ * (w y / w γ) ^ 2) := by
    intro y
    refine ⟨?_, ?_, ?_⟩
    · refine Finset.prod_congr rfl (fun w _ => ?_)
      rw [map_div₀]
    · rw [← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun w _ => ?_)
      have hwγ_pos : 0 < w γ := NumberField.InfinitePlace.pos_iff.mpr hγ
      have hwγ_ne : (w γ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hwγ_pos)
      have hemb_ne : w.embedding γ ≠ 0 :=
        (map_ne_zero_iff w.embedding (RingHom.injective w.embedding)).mpr hγ
      have hstar_ne : star (w.embedding γ) ≠ 0 := star_ne_zero.mpr hemb_ne
      have h_mul_conj : w.embedding γ * star (w.embedding γ) = (w γ : ℂ) ^ 2 := by
        rw [Complex.star_def, Complex.mul_conj', NumberField.InfinitePlace.norm_embedding_eq w γ]
      by_cases h_nonneg : 0 ≤ l_eff w
      · have hl_eq : l_eff w = (a_place w : ℤ) :=
          (Int.ofNat_natAbs_of_nonneg h_nonneg).symm
