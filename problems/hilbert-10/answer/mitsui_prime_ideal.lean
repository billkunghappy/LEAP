theorem mitsui_riesz_primePower_ray_char_unitLogCoord_fract_bound_of_fundSystem_ne_one {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A)
    (Φ_W : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →
