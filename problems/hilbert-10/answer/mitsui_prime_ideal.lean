  have h_pm_bounds : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (ν : ℕ),
      1 ≤ ν → (Ideal.absNorm p.asIdeal : ℝ) ^ ν ≤ Z₀ →
      Ideal.absNorm p.asIdeal ≤ ⌊Z₀⌋₊ ∧ ν ≤ ⌊Z₀⌋₊ := by
    intro p ν hν h_pow
    have hk2 : 2 ≤ Ideal.absNorm p.asIdeal := h_norm_ge_two p
    have h_pow_nat : ((Ideal.absNorm p.asIdeal ^ ν : ℕ) : ℝ) ≤ Z₀ := by exact_mod_cast h_pow
    have h_km_le : Ideal.absNorm p.asIdeal ^ ν ≤ ⌊Z₀⌋₊ := Nat.le_floor h_pow_nat
    have hν_ne : ν ≠ 0 := by omega
    have hk_le_km : Ideal.absNorm p.asIdeal ≤ Ideal.absNorm p.asIdeal ^ ν :=
      Nat.le_self_pow hν_ne (Ideal.absNorm p.asIdeal)
    have hν_le_2ν : ν ≤ 2 ^ ν := (Nat.lt_pow_self (by decide : 1 < 2)).le
    have h2ν_le_km : 2 ^ ν ≤ Ideal.absNorm p.asIdeal ^ ν := Nat.pow_le_pow_left hk2 ν
    exact ⟨le_trans hk_le_km h_km_le, le_trans (le_trans hν_le_2ν h2ν_le_km) h_km_le⟩
  let D_1 := {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
    ∃ h : p.asIdeal.IsPrincipal,
    (Ideal.absNorm p.asIdeal : ℝ) ≤ Y ∧
    IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ p.asIdeal h))}
  let D_ge1 := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧
    ∃ h : (pm.1.asIdeal ^ pm.2).IsPrincipal,
    (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y ∧
    IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ (pm.1.asIdeal ^ pm.2) h))}
  let D_ge2 := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Z₀}
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Z₀⌋₊}
  let S_prod : Set (Ideal (NumberField.RingOfIntegers K) × ℕ) :=
    S_id ×ˢ {ν : ℕ | ν ≤ ⌊Z₀⌋₊}
