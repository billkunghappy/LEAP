    have hxK : (x : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx
    have hwx : w (x : K) ≠ 0 := ne_of_gt (w.pos_iff.mpr hxK)
    have hw₀x : w₀ (x : K) ≠ 0 := ne_of_gt (w₀.pos_iff.mpr hxK)
    calc Real.log (w (x : K) / w₀ (x : K))
      _ = Real.log (w (x : K)) - Real.log (w₀ (x : K)) := Real.log_div hwx hw₀x
      _ = ℓ x w - ℓ x w₀ := by dsimp [ℓ]; ring
      _ = r_x w - r_x w₀ := by rw [h_all w, h_all w₀]
