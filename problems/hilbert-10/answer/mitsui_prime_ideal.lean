        w.embedding (((ζ₀ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
          τ w *
          Complex.exp
            (((∑ j : Fin (NumberField.Units.rank K),
                (v j + (d₀ j : ℝ)) *
                  (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg) : ℝ) * Complex.I)) :
    (∑' x : {x : NumberField.RingOfIntegers K //
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = I ∧
        ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
          Real.log (w (x : K) / w₀ (x : K)) ∈
            Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
              (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))},
      (∑' u : {u : NumberField.Units.torsion K //
          ∀ i : NumberField.mixedEmbedding.index K,
            R₁ *
              ((NumberField.mixedEmbedding.stdBasis K).repr
                  (NumberField.mixedEmbedding K ((((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * x.1 : NumberField.RingOfIntegers K) : K)) i /
                w₀ (x.1 : K)) ∈
              Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))},
        (w₀.embedding ((((u.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * x.1 : NumberField.RingOfIntegers K) : K) /
          (w₀ (x.1 : K) : ℂ)) ^ a₀) *
        Complex.exp
          (((∑ w : NumberField.InfinitePlace K,
              β w * Real.log (w (x.1 : K) / w₀ (x.1 : K))) : ℝ) * Complex.I)) =
      (NumberField.Units.torsionOrder K : ℂ) *
        ∑' e : {e : Fin (NumberField.Units.rank K) → ℤ //
            ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
              ∑ j : Fin (NumberField.Units.rank K),
                (v j + (e j : ℝ)) *
                  Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                    w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ∈
                Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
                  (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))},
          (∑' u : {u : NumberField.Units.torsion K //
              ∀ i : NumberField.mixedEmbedding.index K,
                R₁ *
                  (NumberField.mixedEmbedding.stdBasis K).repr
                    (fun w : {w : NumberField.InfinitePlace K // w.IsReal} =>
                      (w.1.embedding (((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
                        τ w.1 *
                        Complex.exp
                          (((∑ j : Fin (NumberField.Units.rank K),
                              (v j + (e.1 j : ℝ)) *
                                (w.1.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg) : ℝ) * Complex.I) *
                        (Real.exp
                          (∑ j : Fin (NumberField.Units.rank K),
                            (v j + (e.1 j : ℝ)) *
                              Real.log (w.1 (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                                w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) : ℂ)).re,
                     fun w : {w : NumberField.InfinitePlace K // w.IsComplex} =>
                      w.1.embedding (((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
                        τ w.1 *
                        Complex.exp
                          (((∑ j : Fin (NumberField.Units.rank K),
                              (v j + (e.1 j : ℝ)) *
                                (w.1.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg) : ℝ) * Complex.I) *
                        (Real.exp
                          (∑ j : Fin (NumberField.Units.rank K),
                            (v j + (e.1 j : ℝ)) *
                              Real.log (w.1 (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                                w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) : ℂ)) i ∈
                  Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                    ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))},
            (w₀.embedding (((u.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
              τ w₀ *
              Complex.exp
                (((∑ j : Fin (NumberField.Units.rank K),
                    (v j + (e.1 j : ℝ)) *
                      (w₀.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg) : ℝ) * Complex.I)) ^ a₀) *
            Complex.exp
              (((∑ w : NumberField.InfinitePlace K,
                  β w *
                    ∑ j : Fin (NumberField.Units.rank K),
                      (v j + (e.1 j : ℝ)) *
                        Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                          w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) : ℝ) * Complex.I) :=
by
  classical
  let I_cell (w : NumberField.InfinitePlace K) : Set ℝ :=
    Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
      (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))
  let I_dir (i : NumberField.mixedEmbedding.index K) : Set ℝ :=
    Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
      ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))
  let CellGen := {x : NumberField.RingOfIntegers K //
    Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = I ∧
    ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
      Real.log (w (x : K) / w₀ (x : K)) ∈ I_cell w}
  let FreeCell := {e : Fin (NumberField.Units.rank K) → ℤ //
    ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
      ∑ j : Fin (NumberField.Units.rank K),
        (v j + (e j : ℝ)) *
          Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
            w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ∈
        I_cell w}
  have h_cell_fin : Finite CellGen := by
    let n : ℕ := Module.finrank ℚ K
    have hn_pos : (0 : ℝ) < (n : ℝ) := Nat.cast_pos.mpr Module.finrank_pos
    have hsum_mult : ∑ v_pl : NumberField.InfinitePlace K, (v_pl.mult : ℝ) = (n : ℝ) := by
      exact_mod_cast NumberField.InfinitePlace.sum_mult_eq
    let B : ℝ := |Real.log X|
    have hB_nonneg : 0 ≤ B := abs_nonneg _
    let C₀ : ℝ := ∑ v_pl : NumberField.InfinitePlace K, (v_pl.mult : ℝ) * Real.log (v_pl (x₀ : K))
    let R_max : ℝ := Real.exp (C₀ / (n : ℝ) + 2 * B)
    have h_bdd : ∀ x : CellGen, ∀ w : NumberField.InfinitePlace K, w (x.1 : K) ≤ R_max := by
      intro x w
      have hspan_eq : Ideal.span ({x₀} : Set (NumberField.RingOfIntegers K)) =
          Ideal.span ({x.1} : Set (NumberField.RingOfIntegers K)) :=
        hx₀_span.trans x.2.1.symm
      obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp hspan_eq
      have hx_ne : x.1 ≠ 0 := by
        rw [← hu]
        exact mul_ne_zero hx₀_ne u.ne_zero
      have hx₀_coe : (x₀ : K) ≠ 0 := by exact_mod_cast hx₀_ne
      have hu_coe : ((u : NumberField.RingOfIntegers K) : K) ≠ 0 := by exact_mod_cast u.ne_zero
      have hx_coe : (x.1 : K) ≠ 0 := by exact_mod_cast hx_ne
      have hv_x₀_pos : ∀ v_pl : NumberField.InfinitePlace K, 0 < v_pl (x₀ : K) :=
        fun v_pl => v_pl.pos_iff.mpr hx₀_coe
      have hv_u_pos : ∀ v_pl : NumberField.InfinitePlace K, 0 < v_pl ((u : NumberField.RingOfIntegers K) : K) :=
        fun v_pl => v_pl.pos_iff.mpr hu_coe
      have hv_x_pos : ∀ v_pl : NumberField.InfinitePlace K, 0 < v_pl (x.1 : K) :=
        fun v_pl => v_pl.pos_iff.mpr hx_coe
      have h_sum_x : ∑ v_pl : NumberField.InfinitePlace K, (v_pl.mult : ℝ) * Real.log (v_pl (x.1 : K)) = C₀ := by
        have h_log_v : ∀ v_pl : NumberField.InfinitePlace K,
            (v_pl.mult : ℝ) * Real.log (v_pl (x.1 : K)) =
              (v_pl.mult : ℝ) * Real.log (v_pl (x₀ : K)) +
                (v_pl.mult : ℝ) * Real.log (v_pl ((u : NumberField.RingOfIntegers K) : K)) := by
          intro v_pl
          have hv_mul : v_pl (x.1 : K) = v_pl (x₀ : K) * v_pl ((u : NumberField.RingOfIntegers K) : K) := by
            rw [← map_mul]
            congr 1
            exact_mod_cast hu.symm
          rw [hv_mul, Real.log_mul (ne_of_gt (hv_x₀_pos v_pl)) (ne_of_gt (hv_u_pos v_pl)), mul_add]
        simp_rw [h_log_v]
        rw [Finset.sum_add_distrib, NumberField.Units.sum_mult_mul_log u, add_zero]
      have h_rel_abs : ∀ v_pl : NumberField.InfinitePlace K,
          |Real.log (v_pl (x.1 : K)) - Real.log (w₀ (x.1 : K))| ≤ B := by
        intro v_pl
        by_cases hv : v_pl = w₀
        · rw [hv, sub_self, abs_zero]
          exact hB_nonneg
        · have hx_v := x.2.2 v_pl hv
          rw [← Real.log_div (ne_of_gt (hv_x_pos v_pl)) (ne_of_gt (hv_x_pos w₀))]
          rw [Set.mem_Ioc] at hx_v
          have hl_pos_nat : 0 < l := Fin.pos (p v_pl)
          have hl_pos : (0 : ℝ) < (l : ℝ) := Nat.cast_pos.mpr hl_pos_nat
          have hp_lt : ((p v_pl : ℕ) : ℝ) + 1 ≤ (l : ℝ) := by exact_mod_cast (p v_pl).isLt
          have hp_nonneg : (0 : ℝ) ≤ ((p v_pl : ℕ) : ℝ) := Nat.cast_nonneg _
          have h_diff_pos : 0 < Real.log X * ((((p v_pl : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)) -
              Real.log X * ((((p v_pl : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)) :=
            sub_pos.mpr (lt_of_lt_of_le hx_v.1 hx_v.2)
          have h_diff_eq : Real.log X * ((((p v_pl : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)) -
              Real.log X * ((((p v_pl : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)) = Real.log X / (l : ℝ) := by
            ring
          rw [h_diff_eq] at h_diff_pos
          have hlogX_pos : 0 < Real.log X := (div_pos_iff_of_pos_right hl_pos).mp h_diff_pos
          have hB_eq : B = Real.log X := abs_of_pos hlogX_pos
          have h_left_div : -1 ≤ (((p v_pl : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ) := by
            rw [le_div_iff₀ hl_pos]
            linarith
          have h_left : -B ≤ Real.log X * ((((p v_pl : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)) := by
            rw [hB_eq]
            calc -Real.log X = Real.log X * (-1) := by ring
              _ ≤ Real.log X * ((((p v_pl : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)) :=
                mul_le_mul_of_nonneg_left h_left_div (le_of_lt hlogX_pos)
          have h_right_div : (((p v_pl : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ) ≤ 0 :=
            div_nonpos_of_nonpos_of_nonneg (by linarith) (le_of_lt hl_pos)
          have h_right : Real.log X * ((((p v_pl : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)) ≤ 0 :=
            mul_nonpos_of_nonneg_of_nonpos (le_of_lt hlogX_pos) h_right_div
          rw [abs_le]
          refine ⟨le_trans h_left (le_of_lt hx_v.1), le_trans hx_v.2 (le_trans h_right hB_nonneg)⟩
      have h_sum_ineq : (n : ℝ) * Real.log (w₀ (x.1 : K)) - C₀ ≤ (n : ℝ) * B := by
        have h_lhs : (n : ℝ) * Real.log (w₀ (x.1 : K)) - C₀ =
            ∑ v_pl : NumberField.InfinitePlace K,
              (v_pl.mult : ℝ) * (Real.log (w₀ (x.1 : K)) - Real.log (v_pl (x.1 : K))) := by
          simp_rw [mul_sub]
          rw [Finset.sum_sub_distrib, ← Finset.sum_mul, hsum_mult, h_sum_x]
        have h_rhs : (n : ℝ) * B = ∑ v_pl : NumberField.InfinitePlace K, (v_pl.mult : ℝ) * B := by
          rw [← Finset.sum_mul, hsum_mult]
        rw [h_lhs, h_rhs]
        refine Finset.sum_le_sum (fun v_pl _ => ?_)
        have hv_le : Real.log (w₀ (x.1 : K)) - Real.log (v_pl (x.1 : K)) ≤ B := by
          have h1 := (abs_le.mp (h_rel_abs v_pl)).1
          linarith
        exact mul_le_mul_of_nonneg_left hv_le (Nat.cast_nonneg v_pl.mult)
      have hw₀_le : Real.log (w₀ (x.1 : K)) ≤ C₀ / (n : ℝ) + B := by
        have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
        have h_eq : C₀ / (n : ℝ) + B = (C₀ + (n : ℝ) * B) / (n : ℝ) := by field_simp [hn_ne]
        rw [h_eq, le_div_iff₀ hn_pos]
        linarith
      have hw_diff_le : Real.log (w (x.1 : K)) - Real.log (w₀ (x.1 : K)) ≤ B :=
        (abs_le.mp (h_rel_abs w)).2
      have hw_log_le : Real.log (w (x.1 : K)) ≤ C₀ / (n : ℝ) + 2 * B := by linarith
      have hexp_le := Real.exp_le_exp.mpr hw_log_le
      rwa [Real.exp_log (hv_x_pos w)] at hexp_le
    let B_K : Set K := {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ R_max}
    have hBK_fin : B_K.Finite := NumberField.Embeddings.finite_of_norm_le K ℂ R_max
    have hpre_fin : (algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_K).Finite :=
      hBK_fin.preimage NumberField.RingOfIntegers.coe_injective.injOn
    let S_elt : Set (NumberField.RingOfIntegers K) :=
      {x : NumberField.RingOfIntegers K | ∀ w : NumberField.InfinitePlace K, w (x : K) ≤ R_max}
    have hSelt_sub : S_elt ⊆ algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_K := by
      intro x hx
      refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, fun φ => ?_⟩
      let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
      have hw : w (x : K) = ‖φ (x : K)‖ := NumberField.InfinitePlace.apply φ (x : K)
      change ‖φ (x : K)‖ ≤ R_max
      rw [← hw]
      exact hx w
    haveI : Finite S_elt := hpre_fin.subset hSelt_sub
    let f_elt : CellGen → S_elt := fun x => ⟨x.1, h_bdd x⟩
    have hf_inj : Function.Injective f_elt := by
      intro x y hxy
      have hval : (f_elt x).1 = (f_elt y).1 := congrArg Subtype.val hxy
      exact Subtype.ext hval
    exact Finite.of_injective f_elt hf_inj
  haveI : Finite CellGen := h_cell_fin
  let U_map : NumberField.Units.torsion K × (Fin (NumberField.Units.rank K) → ℤ) →
      (NumberField.RingOfIntegers K)ˣ :=
    fun ζe => (ζe.1 : (NumberField.RingOfIntegers K)ˣ) *
      ∏ j : Fin (NumberField.Units.rank K), (NumberField.Units.fundSystem K j) ^ (ζe.2 j)
  let E_shift : NumberField.Units.torsion K × (Fin (NumberField.Units.rank K) → ℤ) ≃
      NumberField.Units.torsion K × (Fin (NumberField.Units.rank K) → ℤ) :=
    Equiv.prodCongr (Equiv.mulRight ζ₀⁻¹) (Equiv.subRight d₀)
  have h_span_unshifted : ∀ ζe : NumberField.Units.torsion K × (Fin (NumberField.Units.rank K) → ℤ),
      Ideal.span ({((U_map ζe : NumberField.RingOfIntegers K) * x₀)} : Set (NumberField.RingOfIntegers K)) = I := by
    intro ζe
    rw [Ideal.span_singleton_mul_left_unit (U_map ζe).isUnit x₀, hx₀_span]
  have h_span : ∀ ζe : NumberField.Units.torsion K × (Fin (NumberField.Units.rank K) → ℤ),
      Ideal.span ({(((((ζe.1 * ζ₀⁻¹ : NumberField.Units.torsion K) : (NumberField.RingOfIntegers K)ˣ) *
          ∏ j : Fin (NumberField.Units.rank K),
            (NumberField.Units.fundSystem K j) ^ (ζe.2 j - d₀ j) : (NumberField.RingOfIntegers K)ˣ) :
          NumberField.RingOfIntegers K) * x₀)} : Set (NumberField.RingOfIntegers K)) = I :=
    fun ζe => h_span_unshifted (E_shift ζe)
  let Φ_I : NumberField.Units.torsion K × (Fin (NumberField.Units.rank K) → ℤ) →
      {x : NumberField.RingOfIntegers K // Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = I} :=
    fun ζe => ⟨(U_map ζe : NumberField.RingOfIntegers K) * x₀, h_span_unshifted ζe⟩
  have hΦ_inj_unshifted : Function.Injective Φ_I := by
    intro p₁ p₂ hΦ
    have h_val : (U_map p₁ : NumberField.RingOfIntegers K) * x₀ =
        (U_map p₂ : NumberField.RingOfIntegers K) * x₀ := congrArg Subtype.val hΦ
    have h_coe : (U_map p₁ : NumberField.RingOfIntegers K) = (U_map p₂ : NumberField.RingOfIntegers K) :=
      mul_right_cancel₀ hx₀_ne h_val
    have hU_eq : U_map p₁ = U_map p₂ := Units.ext h_coe
    exact (NumberField.Units.exist_unique_eq_mul_prod K (U_map p₁)).unique rfl hU_eq
  have hΦ_surj_unshifted : Function.Surjective Φ_I := by
    intro x
    have hspan_eq : Ideal.span ({x₀} : Set (NumberField.RingOfIntegers K)) =
        Ideal.span ({x.1} : Set (NumberField.RingOfIntegers K)) := by
      rw [hx₀_span, x.2]
    obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp hspan_eq
    have hu' : (u : NumberField.RingOfIntegers K) * x₀ = x.1 := by
      rw [mul_comm, hu]
