  have h_val : (1 / (2 * Real.pi)) *
      (∫ t : ℝ,
        ((Y : ℂ) ^ (2 + (t : ℂ) * Complex.I) / (2 + (t : ℂ) * Complex.I) ^ 2) *
          (1 / ((2 + (t : ℂ) * Complex.I) - 1))).re =
      Y - Real.log Y - 1 := by
    have hY_inv_pos : 0 < Y⁻¹ := inv_pos.mpr hY_pos
    have hY_inv_lt_one : Y⁻¹ < 1 := inv_lt_one_of_one_lt₀ hY
    have hY_inv_mem : Y⁻¹ ∈ Set.Ioc (0 : ℝ) 1 := ⟨hY_inv_pos, le_of_lt hY_inv_lt_one⟩
    have h_mc : MellinConvergent f_pole ((2 : ℝ) : ℂ) := (h_mellin 2 (by norm_num)).1
    have h_mellin_line : ∀ t : ℝ, mellin f_pole ((2 : ℝ) + (t : ℂ) * Complex.I) =
