by
  let δ : ℝ := X / (m : ℝ)
  let a (i : NumberField.mixedEmbedding.index K) : ℝ := δ * (((k i : ℕ) : ℝ) - (m : ℝ))
  let b_hi (i : NumberField.mixedEmbedding.index K) : ℝ := δ * (((k i : ℕ) : ℝ) - (m : ℝ) + 1)
  let S (w : NumberField.InfinitePlace K) (R : ℝ) : Set ℝ :=
    {θ : ℝ |
      (∃ hw : w.IsReal,
          (θ ∈ Set.Ioo (0 : ℝ) 1 ∧ R ∈ Set.Ico (a (Sum.inl ⟨w, hw⟩)) (b_hi (Sum.inl ⟨w, hw⟩))) ∨
          (θ ∈ Set.Ioo (1 : ℝ) 2 ∧ -R ∈ Set.Ico (a (Sum.inl ⟨w, hw⟩)) (b_hi (Sum.inl ⟨w, hw⟩)))) ∨
      (∃ hc : w.IsComplex,
          θ ∈ Set.Ioo (-Real.pi) Real.pi ∧
          R * Real.cos θ ∈ Set.Ico (a (Sum.inr (⟨w, hc⟩, 0))) (b_hi (Sum.inr (⟨w, hc⟩, 0))) ∧
          R * Real.sin θ ∈ Set.Ico (a (Sum.inr (⟨w, hc⟩, 1))) (b_hi (Sum.inr (⟨w, hc⟩, 1))))}
  let V (w : NumberField.InfinitePlace K) (R : ℝ) : Set (ℝ × ℝ) :=
    {p : ℝ × ℝ |
      (∃ hw : w.IsReal,
          p.1 ∈ Set.Ioo (-R) R ∧
          p.1 ∈ Set.Ico (a (Sum.inl ⟨w, hw⟩)) (b_hi (Sum.inl ⟨w, hw⟩)) ∧
          p.2 ∈ Set.Ioo (0 : ℝ) 1) ∨
      (∃ hc : w.IsComplex,
          p.1 ^ 2 + p.2 ^ 2 < R ^ 2 ∧
          p.1 ∈ Set.Ico (a (Sum.inr (⟨w, hc⟩, 0))) (b_hi (Sum.inr (⟨w, hc⟩, 0))) ∧
          p.2 ∈ Set.Ico (a (Sum.inr (⟨w, hc⟩, 1))) (b_hi (Sum.inr (⟨w, hc⟩, 1))))}
  let U (w₀ w : NumberField.InfinitePlace K) (R : ℝ) : Set (ℝ × ℝ) :=
    {p : ℝ × ℝ |
      (w = w₀ ∧ p.1 ∈ Set.Ioo (0 : ℝ) (R ^ w.mult) ∧ p.2 ∈ S w R) ∨
      (w ≠ w₀ ∧ p ∈ V w R)}
  have hs2 : ∀ (w₀ : NumberField.InfinitePlace K) (R : ℝ), 0 ≤ R →
      (MeasureTheory.volume (U w₀ w₀ R)).toReal =
        R ^ w₀.mult * (MeasureTheory.volume (S w₀ R)).toReal := by
    intro w₀ R hR
    have hU_eq : U w₀ w₀ R = Set.Ioo (0 : ℝ) (R ^ w₀.mult) ×ˢ S w₀ R := by
      ext ⟨x, y⟩
      simp [U, Set.mem_prod]
    rw [hU_eq, MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod,
      Real.volume_Ioo, sub_zero, ENNReal.toReal_mul,
      ENNReal.toReal_ofReal (pow_nonneg hR w₀.mult)]
  have hs3 : ∀ (w₀ : NumberField.InfinitePlace K) (R : ℝ) (w : NumberField.InfinitePlace K),
      w ≠ w₀ → (MeasureTheory.volume (U w₀ w R)).toReal = (MeasureTheory.volume (V w R)).toReal := by
    intro w₀ R w hw
    have hU_eq : U w₀ w R = V w R := by
      ext p
      simp [U, hw]
    rw [hU_eq]
  have hs4 : ∀ (w₀ : NumberField.InfinitePlace K) (R : ℝ),
      (MeasureTheory.volume (S w₀ R)).toReal ≤ 2 * Real.pi := by
    intro w₀ R
    have hpi : 3 < Real.pi := Real.pi_gt_three
    have hS_sub : S w₀ R ⊆ Set.Ioo (-Real.pi) Real.pi := by
      intro θ hθ
      rcases hθ with ⟨hw, ⟨h1, _⟩ | ⟨h2, _⟩⟩ | ⟨hc, h3, _, _⟩
      · exact ⟨by linarith [h1.1], by linarith [h1.2]⟩
      · exact ⟨by linarith [h2.1], by linarith [h2.2]⟩
      · exact h3
    have hvol : MeasureTheory.volume (S w₀ R) ≤ ENNReal.ofReal (Real.pi - -Real.pi) := by
      calc MeasureTheory.volume (S w₀ R)
        _ ≤ MeasureTheory.volume (Set.Ioo (-Real.pi) Real.pi) := MeasureTheory.measure_mono hS_sub
        _ = ENNReal.ofReal (Real.pi - -Real.pi) := Real.volume_Ioo
    have htoReal := ENNReal.toReal_mono ENNReal.ofReal_ne_top hvol
    rw [ENNReal.toReal_ofReal (by linarith)] at htoReal
    linarith
  have hs5 : ∀ (w₀ : NumberField.InfinitePlace K) (R : ℝ), 0 ≤ R →
      (MeasureTheory.volume (V w₀ R)).toReal ≤ (4 * R) ^ w₀.mult := by
    intro w₀ R hR
    rcases NumberField.InfinitePlace.isReal_or_isComplex w₀ with hw | hc
    · have hmult : w₀.mult = 1 := NumberField.InfinitePlace.mult_isReal ⟨w₀, hw⟩
      have hnot_c : ¬ w₀.IsComplex := NumberField.InfinitePlace.not_isComplex_iff_isReal.mpr hw
      have hV_sub : V w₀ R ⊆ Set.Ioo (-R) R ×ˢ Set.Ioo (0 : ℝ) 1 := by
        intro ⟨x, y⟩ hp
        rcases hp with ⟨_, hx, _, hy⟩ | ⟨hc', _⟩
        · exact ⟨hx, hy⟩
        · exact False.elim (hnot_c hc')
      have hvol : MeasureTheory.volume (V w₀ R) ≤ ENNReal.ofReal (R - -R) := by
        calc MeasureTheory.volume (V w₀ R)
          _ ≤ MeasureTheory.volume (Set.Ioo (-R) R ×ˢ Set.Ioo (0 : ℝ) 1) :=
              MeasureTheory.measure_mono hV_sub
          _ = ENNReal.ofReal (R - -R) * ENNReal.ofReal (1 - 0) := by
              rw [MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod,
                Real.volume_Ioo, Real.volume_Ioo]
          _ = ENNReal.ofReal (R - -R) := by
              rw [sub_zero, ENNReal.ofReal_one, mul_one]
      have htoReal := ENNReal.toReal_mono ENNReal.ofReal_ne_top hvol
      rw [ENNReal.toReal_ofReal (by linarith)] at htoReal
      rw [hmult, pow_one]
      linarith
    · have hmult : w₀.mult = 2 := NumberField.InfinitePlace.mult_isComplex ⟨w₀, hc⟩
      have hnot_r : ¬ w₀.IsReal := NumberField.InfinitePlace.not_isReal_iff_isComplex.mpr hc
      have hV_sub : V w₀ R ⊆ Set.Icc (-R) R ×ˢ Set.Icc (-R) R := by
        intro ⟨x, y⟩ hp
        rcases hp with ⟨hr', _⟩ | ⟨_, hxy, _, _⟩
        · exact False.elim (hnot_r hr')
        · refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
          · nlinarith [sq_nonneg x, sq_nonneg y, sq_nonneg (x + R)]
          · nlinarith [sq_nonneg x, sq_nonneg y, sq_nonneg (R - x)]
          · nlinarith [sq_nonneg x, sq_nonneg y, sq_nonneg (y + R)]
          · nlinarith [sq_nonneg x, sq_nonneg y, sq_nonneg (R - y)]
      have hvol : MeasureTheory.volume (V w₀ R) ≤ ENNReal.ofReal ((R - -R) * (R - -R)) := by
        calc MeasureTheory.volume (V w₀ R)
          _ ≤ MeasureTheory.volume (Set.Icc (-R) R ×ˢ Set.Icc (-R) R) :=
              MeasureTheory.measure_mono hV_sub
          _ = ENNReal.ofReal (R - -R) * ENNReal.ofReal (R - -R) := by
              rw [MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod,
                Real.volume_Icc]
          _ = ENNReal.ofReal ((R - -R) * (R - -R)) := by
              rw [← ENNReal.ofReal_mul (by linarith)]
      have htoReal := ENNReal.toReal_mono ENNReal.ofReal_ne_top hvol
      rw [ENNReal.toReal_ofReal (by nlinarith)] at htoReal
      rw [hmult]
      nlinarith
  have hs6 : ∀ w : NumberField.InfinitePlace K, (MeasureTheory.volume (V w 0)).toReal = 0 := by
    intro w
    have hV_empty : V w 0 = ∅ := by
      ext ⟨x, y⟩
      simp only [V, Set.mem_setOf_eq, Set.mem_Ioo, Set.mem_empty_iff_false, iff_false]
      rintro (⟨_, ⟨hx1, hx2⟩, _, _⟩ | ⟨_, hxy, _, _⟩)
      · linarith
      · nlinarith [sq_nonneg x, sq_nonneg y]
    rw [hV_empty, MeasureTheory.measure_empty, ENNReal.toReal_zero]
  have hs7 : ∀ w : NumberField.InfinitePlace K,
      (MeasureTheory.volume (V w X)).toReal = δ ^ w.mult := by
    classical
    let b := NumberField.mixedEmbedding.stdBasis K
    have hX_pos : 0 < X := by linarith
    have hm_pos : 0 < (m : ℝ) := by exact_mod_cast hm
    have hδ_pos : 0 < δ := div_pos hX_pos hm_pos
    have hδ_nonneg : 0 ≤ δ := le_of_lt hδ_pos
    have h_len : ∀ i : NumberField.mixedEmbedding.index K, b_hi i - a i = δ := by
      intro i
      dsimp [a, b_hi]
      ring
    have ha_mem : ∀ i : NumberField.mixedEmbedding.index K, a i ∈ Set.Ico (a i) (b_hi i) := by
      intro i
      refine ⟨le_refl _, ?_⟩
      linarith [h_len i]
    have hrepr_symm : ∀ (f : NumberField.mixedEmbedding.index K → ℝ)
        (i : NumberField.mixedEmbedding.index K),
        b.repr (b.equivFun.symm f) i = f i := by
      intro f i
      rw [← Module.Basis.equivFun_apply]
      exact congr_fun (b.equivFun.apply_symm_apply f) i
    intro w
    rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hc
    · have hmult : w.mult = 1 := NumberField.InfinitePlace.mult_isReal ⟨w, hw⟩
      have hnot_c : ¬ w.IsComplex := NumberField.InfinitePlace.not_isComplex_iff_isReal.mpr hw
      let i₀ : NumberField.mixedEmbedding.index K := Sum.inl ⟨w, hw⟩
      have h_in_ball : ∀ x ∈ Set.Ico (a i₀) (b_hi i₀), x ∈ Set.Ioo (-X) X := by
        intro x hx
        let z : NumberField.mixedEmbedding.mixedSpace K :=
          b.equivFun.symm (fun i => if i = i₀ then x else a i)
        have hz_mem : ∀ i : NumberField.mixedEmbedding.index K,
            b.repr z i ∈ Set.Ico (a i) (b_hi i) := by
          intro i
          dsimp [z]
          rw [hrepr_symm]
          split_ifs with h
          · subst h; exact hx
          · exact ha_mem i
        have hnorm := hQ_bdd z hz_mem w
        rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw z, Real.norm_eq_abs,
          ← NumberField.mixedEmbedding.stdBasis_apply_isReal z ⟨w, hw⟩] at hnorm
        have hrepr_z : b.repr z i₀ = x := by
          dsimp [z]
          rw [hrepr_symm, if_pos rfl]
        rw [hrepr_z] at hnorm
        exact abs_lt.mp hnorm
      have hV_eq : V w X = Set.Ico (a i₀) (b_hi i₀) ×ˢ Set.Ioo (0 : ℝ) 1 := by
        ext ⟨x, y⟩
        simp only [V, Set.mem_setOf_eq, Set.mem_prod]
        constructor
        · rintro (⟨hw', _, hx_ico, hy⟩ | ⟨hc', _⟩)
          · exact ⟨hx_ico, hy⟩
          · exact False.elim (hnot_c hc')
        · rintro ⟨hx_ico, hy⟩
          exact Or.inl ⟨hw, h_in_ball x hx_ico, hx_ico, hy⟩
      rw [hV_eq, MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod,
        Real.volume_Ico, Real.volume_Ioo, h_len i₀, sub_zero, ENNReal.ofReal_one, mul_one,
        ENNReal.toReal_ofReal hδ_nonneg, hmult, pow_one]
    · have hmult : w.mult = 2 := NumberField.InfinitePlace.mult_isComplex ⟨w, hc⟩
      have hnot_r : ¬ w.IsReal := NumberField.InfinitePlace.not_isReal_iff_isComplex.mpr hc
      let i₀ : NumberField.mixedEmbedding.index K := Sum.inr (⟨w, hc⟩, 0)
      let i₁ : NumberField.mixedEmbedding.index K := Sum.inr (⟨w, hc⟩, 1)
      have h_ne : i₁ ≠ i₀ := by simp [i₀, i₁]
      have h_in_ball : ∀ x₀ ∈ Set.Ico (a i₀) (b_hi i₀), ∀ x₁ ∈ Set.Ico (a i₁) (b_hi i₁),
          x₀ ^ 2 + x₁ ^ 2 < X ^ 2 := by
        intro x₀ hx₀ x₁ hx₁
        let z : NumberField.mixedEmbedding.mixedSpace K :=
          b.equivFun.symm (fun i => if i = i₀ then x₀ else if i = i₁ then x₁ else a i)
        have hz_repr : ∀ i : NumberField.mixedEmbedding.index K,
            b.repr z i = (if i = i₀ then x₀ else if i = i₁ then x₁ else a i) :=
          hrepr_symm _
        have hz_mem : ∀ i : NumberField.mixedEmbedding.index K,
            b.repr z i ∈ Set.Ico (a i) (b_hi i) := by
          intro i
          rw [hz_repr i]
          split_ifs with h0 h1
          · subst h0; exact hx₀
          · subst h1; exact hx₁
          · exact ha_mem i
        have hnorm := hQ_bdd z hz_mem w
        rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hc z] at hnorm
        have hre : (z.2 ⟨w, hc⟩).re = x₀ := by
          rw [← NumberField.mixedEmbedding.stdBasis_apply_isComplex_fst z ⟨w, hc⟩]
          change b.repr z i₀ = x₀
          rw [hz_repr i₀, if_pos rfl]
        have him : (z.2 ⟨w, hc⟩).im = x₁ := by
          rw [← NumberField.mixedEmbedding.stdBasis_apply_isComplex_snd z ⟨w, hc⟩]
          change b.repr z i₁ = x₁
          rw [hz_repr i₁, if_neg h_ne, if_pos rfl]
        have hsq : ‖z.2 ⟨w, hc⟩‖ ^ 2 = x₀ ^ 2 + x₁ ^ 2 := by
          rw [Complex.sq_norm, Complex.normSq_apply, hre, him]
          ring
        have hnorm_nonneg : 0 ≤ ‖z.2 ⟨w, hc⟩‖ := norm_nonneg _
        nlinarith
      have hV_eq : V w X = Set.Ico (a i₀) (b_hi i₀) ×ˢ Set.Ico (a i₁) (b_hi i₁) := by
        ext ⟨x₀, x₁⟩
        simp only [V, Set.mem_setOf_eq, Set.mem_prod]
        constructor
        · rintro (⟨hr', _⟩ | ⟨hc', _, hx₀, hx₁⟩)
          · exact False.elim (hnot_r hr')
          · exact ⟨hx₀, hx₁⟩
        · rintro ⟨hx₀, hx₁⟩
          exact Or.inr ⟨hc, h_in_ball x₀ hx₀ x₁ hx₁, hx₀, hx₁⟩
      rw [hV_eq, MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod,
        Real.volume_Ico, Real.volume_Ico, h_len i₀, h_len i₁, ENNReal.toReal_mul,
        ENNReal.toReal_ofReal hδ_nonneg, hmult, sq]
  exact ⟨fun w₀ R hR => ⟨hs2 w₀ R hR, hs3 w₀ R, hs4 w₀ R, hs5 w₀ R hR⟩,
    fun w => ⟨hs6 w, hs7 w⟩⟩

theorem mitsui_conical_shell_radial_weight_diff_sum_bound (n e : ℕ) (he : 1 ≤ e) (hen : e ≤ n)
    (X : ℝ) (hX : 1 < X)
    (L : ℕ) (hL : 1 ≤ L) :
    (∑ j : Fin L,
      |(((if 1 < (X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1) then (1 : ℝ) else 0) -
          (if 1 < (X / (L : ℝ)) * ((j : ℕ) : ℝ)
           then (((X / (L : ℝ)) * ((j : ℕ) : ℝ)) / ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1))) ^ n
           else 0)) * (n : ℝ)⁻¹ -
        (((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ^ e - ((X / (L : ℝ)) * ((j : ℕ) : ℝ)) ^ e) /
          ((e : ℝ) * ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ^ e))| *
        ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ^ n) ≤
    2 + (n : ℝ) * X ^ n / (L : ℝ) :=
by
  have hn_ge_one : 1 ≤ n := le_trans he hen
  have hn_pos : 0 < n := hn_ge_one
  have hn_ne : n ≠ 0 := ne_of_gt hn_pos
  have hn_rge_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn_ge_one
  have hn_rpos : (0 : ℝ) < (n : ℝ) := lt_of_lt_of_le zero_lt_one hn_rge_one
  have hn_rne : (n : ℝ) ≠ 0 := ne_of_gt hn_rpos
  have he_rge_one : (1 : ℝ) ≤ (e : ℝ) := by exact_mod_cast he
  have he_rpos : (0 : ℝ) < (e : ℝ) := lt_of_lt_of_le zero_lt_one he_rge_one
  have he_rne : (e : ℝ) ≠ 0 := ne_of_gt he_rpos
  have hX_pos : 0 < X := lt_trans zero_lt_one hX
  have hX_nonneg : 0 ≤ X := le_of_lt hX_pos
  have hL_rge_one : (1 : ℝ) ≤ (L : ℝ) := by exact_mod_cast hL
  have hL_rpos : (0 : ℝ) < (L : ℝ) := lt_of_lt_of_le zero_lt_one hL_rge_one
  have hL_rne : (L : ℝ) ≠ 0 := ne_of_gt hL_rpos
  set ε : ℝ := X / (L : ℝ)
  have hε_pos : 0 < ε := div_pos hX_pos hL_rpos
  have hε_nonneg : 0 ≤ ε := le_of_lt hε_pos
  let R₀ : Fin L → ℝ := fun j => (X / (L : ℝ)) * ((j : ℕ) : ℝ)
  let R₁ : Fin L → ℝ := fun j => (X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)
  let α_n : Fin L → ℝ := fun j =>
    ((if 1 < R₁ j then (1 : ℝ) else 0) -
      (if 1 < R₀ j then (R₀ j / R₁ j) ^ n else 0)) * (n : ℝ)⁻¹
  let β_n : Fin L → ℝ := fun j =>
    (R₁ j ^ n - R₀ j ^ n) / ((n : ℝ) * R₁ j ^ n)
  let β_e : Fin L → ℝ := fun j =>
    (R₁ j ^ e - R₀ j ^ e) / ((e : ℝ) * R₁ j ^ e)
  have hR₀_nonneg : ∀ j : Fin L, 0 ≤ R₀ j := by intro j; dsimp [R₀]; positivity
  have hR₁_pos : ∀ j : Fin L, 0 < R₁ j := by intro j; dsimp [R₁]; positivity
  have hR₁_nonneg : ∀ j : Fin L, 0 ≤ R₁ j := fun j => le_of_lt (hR₁_pos j)
  have hR₁_ne : ∀ j : Fin L, R₁ j ≠ 0 := fun j => ne_of_gt (hR₁_pos j)
  have hR₀_le_R₁ : ∀ j : Fin L, R₀ j ≤ R₁ j := by
    intro j; dsimp [R₀, R₁]
    exact mul_le_mul_of_nonneg_left (by linarith) hε_nonneg
  have hR₁_sub_R₀ : ∀ j : Fin L, R₁ j - R₀ j = ε := by
    intro j; dsimp [R₀, R₁, ε]; ring
  have hR₁_le_X : ∀ j : Fin L, R₁ j ≤ X := by
    intro j; dsimp [R₁]
    have hj_le : ((j : ℕ) : ℝ) + 1 ≤ (L : ℝ) := by exact_mod_cast j.2
    rw [div_mul_eq_mul_div, div_le_iff₀ hL_rpos]
    exact mul_le_mul_of_nonneg_left hj_le hX_nonneg
  let c : ℕ → ℝ := fun i =>
    if 1 < (X / (L : ℝ)) * (i : ℝ) then (2 : ℝ) else ((X / (L : ℝ)) * (i : ℝ)) ^ n
  have h_partA_alg : ∀ j : Fin L,
      (α_n j - β_n j) * R₁ j ^ n =
      (n : ℝ)⁻¹ * ((if 1 < R₀ j then 0 else R₀ j ^ n) - (if 1 < R₁ j then 0 else R₁ j ^ n)) := by
    intro j
    have hRn_ne : R₁ j ^ n ≠ 0 := pow_ne_zero n (hR₁_ne j)
    dsimp [α_n, β_n]
    rw [div_pow]
    split_ifs <;> field_simp [hn_rne, hRn_ne] <;> ring
  have h_partA_each : ∀ j : Fin L,
      |α_n j - β_n j| * R₁ j ^ n ≤ c ((j : ℕ) + 1) - c (j : ℕ) := by
    intro j
    have hRn_nonneg : 0 ≤ R₁ j ^ n := pow_nonneg (hR₁_nonneg j) n
    have h_abs_eq : |α_n j - β_n j| * R₁ j ^ n = |(α_n j - β_n j) * R₁ j ^ n| := by
      rw [abs_mul, abs_of_nonneg hRn_nonneg]
    rw [h_abs_eq, h_partA_alg j, abs_mul, abs_of_pos (inv_pos.mpr hn_rpos)]
    have h_inv_le : (n : ℝ)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hn_rge_one
    have h_le1 :
        (n : ℝ)⁻¹ * |(if 1 < R₀ j then 0 else R₀ j ^ n) - (if 1 < R₁ j then 0 else R₁ j ^ n)| ≤
        |(if 1 < R₀ j then 0 else R₀ j ^ n) - (if 1 < R₁ j then 0 else R₁ j ^ n)| :=
      mul_le_of_le_one_left (abs_nonneg _) h_inv_le
    have h_c1 : c ((j : ℕ) + 1) = if 1 < R₁ j then (2 : ℝ) else R₁ j ^ n := by
      dsimp [c, R₁]; push_cast; rfl
    have h_c0 : c (j : ℕ) = if 1 < R₀ j then (2 : ℝ) else R₀ j ^ n := rfl
    have h_le2 :
        |(if 1 < R₀ j then 0 else R₀ j ^ n) - (if 1 < R₁ j then 0 else R₁ j ^ n)| ≤
        c ((j : ℕ) + 1) - c (j : ℕ) := by
      rw [h_c1, h_c0]
      split_ifs with h0 h1 h1
      · simp
      · exfalso; linarith [hR₀_le_R₁ j]
      · rw [sub_zero, abs_of_nonneg (pow_nonneg (hR₀_nonneg j) n)]
        have hR0_le_one : R₀ j ^ n ≤ 1 := pow_le_one₀ (hR₀_nonneg j) (not_lt.mp h0)
        linarith
      · rw [abs_sub_comm,
          abs_of_nonneg (sub_nonneg.mpr (pow_le_pow_left₀ (hR₀_nonneg j) (hR₀_le_R₁ j) n))]
    exact le_trans h_le1 h_le2
  have h_sum_A : ∑ j : Fin L, |α_n j - β_n j| * R₁ j ^ n ≤ 2 := by
    calc ∑ j : Fin L, |α_n j - β_n j| * R₁ j ^ n
      _ ≤ ∑ j : Fin L, (c ((j : ℕ) + 1) - c (j : ℕ)) :=
          Finset.sum_le_sum (fun j _ => h_partA_each j)
      _ = ∑ i ∈ Finset.range L, (c (i + 1) - c i) :=
          Fin.sum_univ_eq_sum_range (fun i => c (i + 1) - c i) L
      _ = c L - c 0 := Finset.sum_range_sub c L
      _ = 2 := by
          have hcL : c L = 2 := by
            dsimp [c]
            rw [div_mul_cancel₀ X hL_rne, if_pos hX]
          have hc0 : c 0 = 0 := by
            dsimp [c]
            rw [Nat.cast_zero, mul_zero, if_neg (by norm_num), zero_pow hn_ne]
          rw [hcL, hc0, sub_zero]
  have h_poly_bounds : ∀ (k : ℕ) (t : ℝ), 0 ≤ t → t ≤ 1 →
      (k : ℝ) * t ^ k * (1 - t) ≤ 1 - t ^ k ∧ 1 - t ^ k ≤ (k : ℝ) * (1 - t) := by
    intro k t ht0 ht1
    induction k with
    | zero => simp
    | succ k ih =>
      have htk0 : 0 ≤ t ^ k := pow_nonneg ht0 k
      have htk1 : t ^ k ≤ 1 := pow_le_one₀ ht0 ht1
      have htk_succ1 : t ^ (k + 1) ≤ 1 := pow_le_one₀ ht0 ht1
      push_cast
      refine ⟨?_, ?_⟩
      · calc ((k : ℝ) + 1) * t ^ (k + 1) * (1 - t)
          _ = t * ((k : ℝ) * t ^ k * (1 - t)) + t ^ (k + 1) * (1 - t) := by
              rw [pow_succ]; ring
          _ ≤ t * (1 - t ^ k) + 1 * (1 - t) := by
              have h1 : t * ((k : ℝ) * t ^ k * (1 - t)) ≤ t * (1 - t ^ k) :=
                mul_le_mul_of_nonneg_left ih.1 ht0
              have h2 : t ^ (k + 1) * (1 - t) ≤ 1 * (1 - t) :=
                mul_le_mul_of_nonneg_right htk_succ1 (by linarith)
              linarith
          _ = 1 - t ^ (k + 1) := by rw [pow_succ]; ring
      · calc 1 - t ^ (k + 1)
          _ = (1 - t ^ k) + t ^ k * (1 - t) := by rw [pow_succ]; ring
          _ ≤ (k : ℝ) * (1 - t) + 1 * (1 - t) := by
              have h2 : t ^ k * (1 - t) ≤ 1 * (1 - t) :=
                mul_le_mul_of_nonneg_right htk1 (by linarith)
              linarith [ih.2]
          _ = ((k : ℝ) + 1) * (1 - t) := by ring
  have h_partB_each : ∀ j : Fin L,
      |β_n j - β_e j| * R₁ j ^ n ≤ (n : ℝ) * X ^ n / (L : ℝ) ^ 2 := by
    intro j
    rcases eq_or_lt_of_le hen with rfl | h_lt
    · dsimp [β_n, β_e]
      rw [sub_self, abs_zero, zero_mul]
      positivity
    · have hn2 : 2 ≤ n := by omega
      set t : ℝ := R₀ j / R₁ j
      have ht0 : 0 ≤ t := div_nonneg (hR₀_nonneg j) (hR₁_nonneg j)
      have ht1 : t ≤ 1 := div_le_one_of_le₀ (hR₀_le_R₁ j) (hR₁_nonneg j)
      have h1t_nonneg : 0 ≤ 1 - t := sub_nonneg.mpr ht1
      have hβn_eq : β_n j = (1 - t ^ n) / (n : ℝ) := by
        have hRn_ne : R₁ j ^ n ≠ 0 := pow_ne_zero n (hR₁_ne j)
        dsimp [β_n, t]
        rw [div_pow]
        field_simp [hn_rne, hRn_ne]
      have hβe_eq : β_e j = (1 - t ^ e) / (e : ℝ) := by
        have hRe_ne : R₁ j ^ e ≠ 0 := pow_ne_zero e (hR₁_ne j)
        dsimp [β_e, t]
        rw [div_pow]
        field_simp [he_rne, hRe_ne]
      have h_bn_bds := h_poly_bounds n t ht0 ht1
      have h_be_bds := h_poly_bounds e t ht0 ht1
      have hβn_lo : t ^ n * (1 - t) ≤ β_n j := by
        rw [hβn_eq, le_div_iff₀ hn_rpos]
        linarith [h_bn_bds.1]
      have hβn_hi : β_n j ≤ 1 - t := by
        rw [hβn_eq, div_le_iff₀ hn_rpos]
        linarith [h_bn_bds.2]
      have h_tn_le_te : t ^ n ≤ t ^ e := pow_le_pow_of_le_one ht0 ht1 hen
      have hβe_lo : t ^ n * (1 - t) ≤ β_e j := by
        have h1 : t ^ n * (1 - t) ≤ t ^ e * (1 - t) :=
          mul_le_mul_of_nonneg_right h_tn_le_te h1t_nonneg
        have h2 : t ^ e * (1 - t) ≤ β_e j := by
          rw [hβe_eq, le_div_iff₀ he_rpos]
          linarith [h_be_bds.1]
        exact le_trans h1 h2
      have hβe_hi : β_e j ≤ 1 - t := by
        rw [hβe_eq, div_le_iff₀ he_rpos]
        linarith [h_be_bds.2]
      have h_diff_le : |β_n j - β_e j| ≤ (n : ℝ) * (1 - t) ^ 2 := by
        have h_abs : |β_n j - β_e j| ≤ (1 - t) * (1 - t ^ n) := by
          rw [abs_sub_le_iff]
          refine ⟨by linarith, by linarith⟩
        calc |β_n j - β_e j|
          _ ≤ (1 - t) * (1 - t ^ n) := h_abs
          _ ≤ (1 - t) * ((n : ℝ) * (1 - t)) :=
              mul_le_mul_of_nonneg_left h_bn_bds.2 h1t_nonneg
          _ = (n : ℝ) * (1 - t) ^ 2 := by ring
      have hn_split : n = 2 + (n - 2) := by omega
      have hR_pow_split : R₁ j ^ n = R₁ j ^ 2 * R₁ j ^ (n - 2) := by
        conv_lhs => rw [hn_split, pow_add]
      have hX_pow_split : X ^ n = X ^ 2 * X ^ (n - 2) := by
        conv_lhs => rw [hn_split, pow_add]
      have h1t_R1 : (1 - t) * R₁ j = ε := by
        dsimp [t]
        have hR1 := hR₁_ne j
        have hsub := hR₁_sub_R₀ j
        calc (1 - R₀ j / R₁ j) * R₁ j = R₁ j - R₀ j := by field_simp [hR1]
          _ = ε := hsub
      have h_Rn2_le : R₁ j ^ (n - 2) ≤ X ^ (n - 2) :=
        pow_le_pow_left₀ (hR₁_nonneg j) (hR₁_le_X j) (n - 2)
      calc |β_n j - β_e j| * R₁ j ^ n
        _ ≤ ((n : ℝ) * (1 - t) ^ 2) * R₁ j ^ n :=
            mul_le_mul_of_nonneg_right h_diff_le (pow_nonneg (hR₁_nonneg j) n)
        _ = (n : ℝ) * ((1 - t) * R₁ j) ^ 2 * R₁ j ^ (n - 2) := by
            rw [hR_pow_split]; ring
        _ = (n : ℝ) * ε ^ 2 * R₁ j ^ (n - 2) := by rw [h1t_R1]
        _ ≤ (n : ℝ) * ε ^ 2 * X ^ (n - 2) :=
            mul_le_mul_of_nonneg_left h_Rn2_le (by positivity)
        _ = (n : ℝ) * X ^ n / (L : ℝ) ^ 2 := by
            dsimp [ε]
            rw [hX_pow_split]
            ring
  have h_sum_B : ∑ j : Fin L, |β_n j - β_e j| * R₁ j ^ n ≤ (n : ℝ) * X ^ n / (L : ℝ) := by
    calc ∑ j : Fin L, |β_n j - β_e j| * R₁ j ^ n
      _ ≤ ∑ _j : Fin L, ((n : ℝ) * X ^ n / (L : ℝ) ^ 2) :=
          Finset.sum_le_sum (fun j _ => h_partB_each j)
      _ = (L : ℝ) * ((n : ℝ) * X ^ n / (L : ℝ) ^ 2) := by
          simp [Finset.sum_const, nsmul_eq_mul]
      _ = (n : ℝ) * X ^ n / (L : ℝ) := by
          field_simp [hL_rne]
  have h_tri_each : ∀ j : Fin L,
      |α_n j - β_e j| * R₁ j ^ n ≤
      |α_n j - β_n j| * R₁ j ^ n + |β_n j - β_e j| * R₁ j ^ n := by
    intro j
    have h1 : |α_n j - β_e j| ≤ |α_n j - β_n j| + |β_n j - β_e j| :=
      abs_sub_le (α_n j) (β_n j) (β_e j)
    calc |α_n j - β_e j| * R₁ j ^ n
      _ ≤ (|α_n j - β_n j| + |β_n j - β_e j|) * R₁ j ^ n :=
          mul_le_mul_of_nonneg_right h1 (pow_nonneg (hR₁_nonneg j) n)
      _ = |α_n j - β_n j| * R₁ j ^ n + |β_n j - β_e j| * R₁ j ^ n :=
          add_mul _ _ _
  calc ∑ j : Fin L, |α_n j - β_e j| * R₁ j ^ n
    _ ≤ ∑ j : Fin L, (|α_n j - β_n j| * R₁ j ^ n + |β_n j - β_e j| * R₁ j ^ n) :=
        Finset.sum_le_sum (fun j _ => h_tri_each j)
    _ = (∑ j : Fin L, |α_n j - β_n j| * R₁ j ^ n) +
        (∑ j : Fin L, |β_n j - β_e j| * R₁ j ^ n) :=
        Finset.sum_add_distrib
    _ ≤ 2 + (n : ℝ) * X ^ n / (L : ℝ) :=
        add_le_add h_sum_A h_sum_B

theorem mitsui_place_conical_shell_volume_diff_bound {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (m : ℕ) (hm : 1 ≤ m)
    (L : ℕ) (hL : 1 ≤ L)
    (k : NumberField.mixedEmbedding.index K → Fin (2 * m))
    (w : NumberField.InfinitePlace K) :
    (∀ j : Fin L,
      (MeasureTheory.volume {p : ℝ × ℝ |
        (∃ hw : w.IsReal,
            p.1 ∈ Set.Ioo (-((X / (L : ℝ)) * ((j : ℕ) : ℝ))) ((X / (L : ℝ)) * ((j : ℕ) : ℝ)) ∧
            p.1 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
            p.2 ∈ Set.Ioo (0 : ℝ) 1) ∨
        (∃ hc : w.IsComplex,
            p.1 ^ 2 + p.2 ^ 2 < ((X / (L : ℝ)) * ((j : ℕ) : ℝ)) ^ 2 ∧
            p.1 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
            p.2 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1)))}).toReal ≤
      (MeasureTheory.volume {p : ℝ × ℝ |
        (∃ hw : w.IsReal,
            p.1 ∈ Set.Ioo (-((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1))) ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ∧
            p.1 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
            p.2 ∈ Set.Ioo (0 : ℝ) 1) ∨
        (∃ hc : w.IsComplex,
            p.1 ^ 2 + p.2 ^ 2 < ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ^ 2 ∧
            p.1 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
            p.2 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1)))}).toReal ∧
      (MeasureTheory.volume {p : ℝ × ℝ |
        (∃ hw : w.IsReal,
            p.1 ∈ Set.Ioo (-((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1))) ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ∧
            p.1 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
            p.2 ∈ Set.Ioo (0 : ℝ) 1) ∨
        (∃ hc : w.IsComplex,
            p.1 ^ 2 + p.2 ^ 2 < ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ^ 2 ∧
            p.1 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
            p.2 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1)))}).toReal -
      (MeasureTheory.volume {p : ℝ × ℝ |
        (∃ hw : w.IsReal,
            p.1 ∈ Set.Ioo (-((X / (L : ℝ)) * ((j : ℕ) : ℝ))) ((X / (L : ℝ)) * ((j : ℕ) : ℝ)) ∧
            p.1 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
            p.2 ∈ Set.Ioo (0 : ℝ) 1) ∨
        (∃ hc : w.IsComplex,
            p.1 ^ 2 + p.2 ^ 2 < ((X / (L : ℝ)) * ((j : ℕ) : ℝ)) ^ 2 ∧
            p.1 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
            p.2 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1)))}).toReal ≤
      2 * Real.pi * (4 * X) ^ w.mult / (L : ℝ)) ∧
    (∑ j : Fin L,
      |((((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ^ w.mult - ((X / (L : ℝ)) * ((j : ℕ) : ℝ)) ^ w.mult) /
          (w.mult : ℝ) *
        (MeasureTheory.volume {θ : ℝ |
          (∃ hw : w.IsReal,
              (θ ∈ Set.Ioo (0 : ℝ) 1 ∧
                (X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1) ∈
                  Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                    ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1))) ∨
              (θ ∈ Set.Ioo (1 : ℝ) 2 ∧
                -((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ∈
                  Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                    ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)))) ∨
          (∃ hc : w.IsComplex,
              θ ∈ Set.Ioo (-Real.pi) Real.pi ∧
              ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) * Real.cos θ ∈
                Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
              ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) * Real.sin θ ∈
                Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1)))}).toReal -
        ((MeasureTheory.volume {p : ℝ × ℝ |
          (∃ hw : w.IsReal,
              p.1 ∈ Set.Ioo (-((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1))) ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ∧
              p.1 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
              p.2 ∈ Set.Ioo (0 : ℝ) 1) ∨
          (∃ hc : w.IsComplex,
              p.1 ^ 2 + p.2 ^ 2 < ((X / (L : ℝ)) * (((j : ℕ) : ℝ) + 1)) ^ 2 ∧
              p.1 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
              p.2 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1)))}).toReal -
         (MeasureTheory.volume {p : ℝ × ℝ |
          (∃ hw : w.IsReal,
              p.1 ∈ Set.Ioo (-((X / (L : ℝ)) * ((j : ℕ) : ℝ))) ((X / (L : ℝ)) * ((j : ℕ) : ℝ)) ∧
              p.1 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
              p.2 ∈ Set.Ioo (0 : ℝ) 1) ∨
          (∃ hc : w.IsComplex,
              p.1 ^ 2 + p.2 ^ 2 < ((X / (L : ℝ)) * ((j : ℕ) : ℝ)) ^ 2 ∧
              p.1 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
              p.2 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1)))}).toReal))|) ≤
    16 * (4 * X) ^ w.mult / (L : ℝ) :=
by
  have hX_pos : 0 < X := by linarith
  have hm_pos : 0 < (m : ℝ) := by exact_mod_cast hm
  have hL_pos : 0 < (L : ℝ) := by exact_mod_cast hL
  set ε : ℝ := X / (L : ℝ)
  have hε_pos : 0 < ε := div_pos hX_pos hL_pos
  have hε_nonneg : 0 ≤ ε := le_of_lt hε_pos
  rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hc
  · have hw_mult : w.mult = 1 := NumberField.InfinitePlace.mult_isReal ⟨w, hw⟩
    have h_not_cplx : ¬ w.IsComplex := NumberField.InfinitePlace.not_isComplex_iff_isReal.mpr hw
    set a : ℝ := (X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ))
    set b : ℝ := (X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)
    have hab : a ≤ b := by
      have : 0 ≤ X / (m : ℝ) := by positivity
      dsimp [a, b]; linarith
    have hV_eq : ∀ R : ℝ,
        {p : ℝ × ℝ |
          (∃ hw' : w.IsReal,
              p.1 ∈ Set.Ioo (-R) R ∧
              p.1 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw'⟩) : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw'⟩) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
              p.2 ∈ Set.Ioo (0 : ℝ) 1) ∨
          (∃ hc : w.IsComplex,
              p.1 ^ 2 + p.2 ^ 2 < R ^ 2 ∧
              p.1 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
              p.2 ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1)))} =
        {p : ℝ × ℝ | p.1 ∈ Set.Ioo (-R) R ∧ p.1 ∈ Set.Ico a b ∧ p.2 ∈ Set.Ioo (0 : ℝ) 1} := by
      intro R; ext p; simp only [Set.mem_setOf_eq]; constructor
      · rintro (⟨hw', hp⟩ | ⟨hc, _⟩)
        · rw [Subsingleton.elim hw' hw] at hp; exact hp
        · exact False.elim (h_not_cplx hc)
      · intro hp; exact Or.inl ⟨hw, hp⟩
    have hS_eq : ∀ R : ℝ,
        {θ : ℝ |
          (∃ hw' : w.IsReal,
              (θ ∈ Set.Ioo (0 : ℝ) 1 ∧
                R ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw'⟩) : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw'⟩) : ℕ) : ℝ) - (m : ℝ) + 1))) ∨
              (θ ∈ Set.Ioo (1 : ℝ) 2 ∧
                -R ∈ Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw'⟩) : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw'⟩) : ℕ) : ℝ) - (m : ℝ) + 1)))) ∨
          (∃ hc : w.IsComplex,
              θ ∈ Set.Ioo (-Real.pi) Real.pi ∧
              R * Real.cos θ ∈
                Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
              R * Real.sin θ ∈
                Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1)))} =
        {θ : ℝ | (θ ∈ Set.Ioo (0 : ℝ) 1 ∧ R ∈ Set.Ico a b) ∨
          (θ ∈ Set.Ioo (1 : ℝ) 2 ∧ -R ∈ Set.Ico a b)} := by
      intro R; ext θ; simp only [Set.mem_setOf_eq]; constructor
      · rintro (⟨hw', hθ⟩ | ⟨hc, _⟩)
        · rw [Subsingleton.elim hw' hw] at hθ; exact hθ
        · exact False.elim (h_not_cplx hc)
      · intro hθ; exact Or.inl ⟨hw, hθ⟩
    simp only [hV_eq, hS_eq, hw_mult, Nat.cast_one, pow_one, div_one]
    let cl : ℝ → ℝ := fun x => if b ≤ x then b else if a ≤ x then x else a
    have hV_eval : ∀ R : ℝ, 0 ≤ R →
        (MeasureTheory.volume {p : ℝ × ℝ |
          p.1 ∈ Set.Ioo (-R) R ∧ p.1 ∈ Set.Ico a b ∧ p.2 ∈ Set.Ioo (0 : ℝ) 1}).toReal =
        cl R - cl (-R) := by
      intro R hR
      have h_prod : {p : ℝ × ℝ |
          p.1 ∈ Set.Ioo (-R) R ∧ p.1 ∈ Set.Ico a b ∧ p.2 ∈ Set.Ioo (0 : ℝ) 1} =
          (Set.Ioo (-R) R ∩ Set.Ico a b) ×ˢ Set.Ioo (0 : ℝ) 1 := by
        ext p; simp only [Set.mem_setOf_eq, Set.mem_prod, Set.mem_inter_iff, and_assoc]
      rw [h_prod, MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod,
          Real.volume_Ioo, sub_zero, ENNReal.ofReal_one, mul_one]
      have hae : (Set.Ioo (-R) R ∩ Set.Ico a b : Set ℝ) =ᵐ[MeasureTheory.volume]
          (Set.Ico (-R) R ∩ Set.Ico a b : Set ℝ) :=
        Filter.EventuallyEq.inter MeasureTheory.Ioo_ae_eq_Ico Filter.EventuallyEq.rfl
      rw [MeasureTheory.measure_congr hae, Set.Ico_inter_Ico, Real.volume_Ico,
          ENNReal.toReal_ofReal']
      dsimp [cl]
      simp only [max_def, min_def]
      split_ifs <;> linarith
    let g_ind : ℝ → ℝ := fun x => (if a ≤ x then 1 else 0) - (if b ≤ x then 1 else 0)
    have hg_ind_eq : ∀ x : ℝ, (if x ∈ Set.Ico a b then (1 : ℝ) else 0) = g_ind x := by
      intro x
      dsimp [g_ind]
      by_cases h1 : a ≤ x <;> by_cases h2 : b ≤ x
      · have hnot : ¬ (x < b) := not_lt.mpr h2
        simp [Set.mem_Ico, h1, h2, hnot]
      · have hlt : x < b := lt_of_not_ge h2
        simp [Set.mem_Ico, h1, h2, hlt]
      · have hnot : ¬ (b ≤ x) := fun hb => h1 (le_trans hab hb)
        simp [Set.mem_Ico, h1, hnot]
      · simp [Set.mem_Ico, h1, h2]
    have hS_eval : ∀ R : ℝ,
        (MeasureTheory.volume {θ : ℝ |
          (θ ∈ Set.Ioo (0 : ℝ) 1 ∧ R ∈ Set.Ico a b) ∨
          (θ ∈ Set.Ioo (1 : ℝ) 2 ∧ -R ∈ Set.Ico a b)}).toReal =
        g_ind R + g_ind (-R) := by
      intro R
      let S₁ : Set ℝ := {θ : ℝ | θ ∈ Set.Ioo (0 : ℝ) 1 ∧ R ∈ Set.Ico a b}
      let S₂ : Set ℝ := {θ : ℝ | θ ∈ Set.Ioo (1 : ℝ) 2 ∧ -R ∈ Set.Ico a b}
      have h_union : {θ : ℝ |
          (θ ∈ Set.Ioo (0 : ℝ) 1 ∧ R ∈ Set.Ico a b) ∨
          (θ ∈ Set.Ioo (1 : ℝ) 2 ∧ -R ∈ Set.Ico a b)} = S₁ ∪ S₂ := rfl
      have hS1_eq : S₁ = if R ∈ Set.Ico a b then Set.Ioo (0 : ℝ) 1 else ∅ := by
        split_ifs with hR <;> { ext θ; simp [S₁, hR] }
      have hS2_eq : S₂ = if -R ∈ Set.Ico a b then Set.Ioo (1 : ℝ) 2 else ∅ := by
        split_ifs with hR <;> { ext θ; simp [S₂, hR] }
      have h_disj : Disjoint S₁ S₂ := by
        rw [Set.disjoint_left]
        intro θ h1 h2
        linarith [h1.1.2, h2.1.1]
      have hS2_meas : MeasurableSet S₂ := by
        rw [hS2_eq]; split_ifs; exact measurableSet_Ioo; exact MeasurableSet.empty
      have hS1_vol : MeasureTheory.volume S₁ =
          ENNReal.ofReal (if R ∈ Set.Ico a b then 1 else 0) := by
        rw [hS1_eq]; split_ifs <;> simp [Real.volume_Ioo]
      have hS2_vol : MeasureTheory.volume S₂ =
          ENNReal.ofReal (if -R ∈ Set.Ico a b then 1 else 0) := by
        rw [hS2_eq]; split_ifs <;> simp [Real.volume_Ioo] <;> norm_num
      rw [h_union, MeasureTheory.measure_union h_disj hS2_meas, hS1_vol, hS2_vol,
          ENNReal.toReal_add ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top,
          ENNReal.toReal_ofReal (by split_ifs <;> linarith),
          ENNReal.toReal_ofReal (by split_ifs <;> linarith),
          hg_ind_eq R, hg_ind_eq (-R)]
    have hcl_lip : ∀ x : ℝ, 0 ≤ cl (x + ε) - cl x ∧ cl (x + ε) - cl x ≤ ε := by
      intro x
      dsimp [cl]
      by_cases ha1 : a ≤ x
      · have ha2 : a ≤ x + ε := by linarith
