      (ψ : nonZeroDivisors (Ideal R) →* ℂ)
      (hψ_norm : ∀ I : nonZeroDivisors (Ideal R), ‖ψ I‖ ≤ 1)
      (s : ℂ) (hs : 1 < s.re),
