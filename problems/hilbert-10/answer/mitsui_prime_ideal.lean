    rw [Complex.ofReal_inv, Complex.inv_cpow _ s, ← Complex.cpow_neg]
    rw [Complex.arg_ofReal_of_nonneg hu_nn]
    exact Real.pi_ne_zero.symm
  rw [h_inv_cpow]
