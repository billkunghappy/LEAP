      rcases abs_le.mp h_bdd_j with ⟨hy_lo, hy_hi⟩
      rcases hq₁_ivl j with ⟨hq_le_y, hy_lt_q1⟩
      have h1 : ((-(N_y : ℤ) : ℤ) : ℝ) * h ≤ (q₁ j : ℝ) * h := by
        push_cast
        linarith
      have h2 : (q₁ j : ℝ) * h ≤ ((N_y : ℤ) : ℝ) * h := by
        push_cast
        linarith
      have h1' : ((-(N_y : ℤ) : ℤ) : ℝ) ≤ (q₁ j : ℝ) := le_of_mul_le_mul_right h1 hh_pos
      have h2' : (q₁ j : ℝ) ≤ ((N_y : ℤ) : ℝ) := le_of_mul_le_mul_right h2 hh_pos
      exact ⟨Int.cast_le.mp h1', Int.cast_le.mp h2'⟩
    have h_ex_q₂ : ∀ w : ι_complex,
        ∃ p_w ∈ Finset.Ico (0 : ℤ) (K_δ : ℤ), (z w.1).2 ∈ I_wrapped (α_p q₁ w) p_w :=
      fun w => hI_wrapped_cover (α_p q₁ w) (z w.1).2 (hθ_ioo w)
    let q₂ : ι_complex → ℤ := fun w => (h_ex_q₂ w).choose
    have hq₂_mem : q₂ ∈ B_K :=
      Fintype.mem_piFinset.mpr (fun w => (h_ex_q₂ w).choose_spec.1)
    have hq₂_in : ∀ w : ι_complex, (z w.1).2 ∈ I_wrapped (α_p q₁ w) (q₂ w) :=
      fun w => (h_ex_q₂ w).choose_spec.2
    let q : (Fin r → ℤ) × (ι_complex → ℤ) := (q₁, q₂)
    have hq_grid : q ∈ B_grid := Finset.mem_product.mpr ⟨hq₁_mem, hq₂_mem⟩
    have hq_outer : q ∈ S_outer_slice ξ := by
      refine hξ_outer q hq_grid hq₁_near (fun w => ?_)
      exact (hI_wrapped_in (α_p q₁ w) (q₂ w) (z w.1).2 (hq₂_in w)).2
    have hq_s'_outer : q ∈ S'_outer ξ := Finset.mem_inter.mpr ⟨hq_outer, hq_grid⟩
    have hp_mem : (⟨ξ, q⟩ : Σ _ : ι_real → Fin 2, (Fin r → ℤ) × (ι_complex → ℤ)) ∈ U_outer :=
      Finset.mem_sigma.mpr ⟨Finset.mem_univ ξ, hq_s'_outer⟩
    refine Set.mem_iUnion₂.mpr ⟨⟨ξ, q⟩, hp_mem, ?_⟩
    intro w _
    refine ⟨?_, ?_⟩
    · dsimp [I₁]
      by_cases hw : w ≠ w₀
      · rw [dif_pos hw]
        simpa [q] using hq₁_ivl (e ⟨w, hw⟩)
      · rw [dif_neg hw]
        have hw_eq : w = w₀ := not_not.mp hw
        subst hw_eq
        exact hz₀
    · dsimp [I₂]
      split_ifs with hw
      · exact hξ_real ⟨w, hw⟩
      · exact hq₂_in ⟨w, (NumberField.InfinitePlace.isReal_or_isComplex w).resolve_left hw⟩
  have hU_main_grid : ∀ p ∈ U_main, p.2 ∈ B_grid := by
    intro p hp
    exact (h_sub p.1).1 (Finset.mem_sigma.mp hp).2
  have hU_outer_grid : ∀ p ∈ U_outer, p.2 ∈ B_grid := by
    intro p hp
    exact (Finset.mem_inter.mp (Finset.mem_sigma.mp hp).2).2
  have h_vol_inner_eq :
      MeasureTheory.volume (⋃ p ∈ U_main, Q_hat p) =
        (U_main.card : ENNReal) * ENNReal.ofReal v_box := by
    rw [MeasureTheory.measure_biUnion_finset
      (hQ_hat_disj.subset (Set.subset_univ _))
      (fun p hp => hQ_hat_meas p (hU_main_grid p hp))]
    have h_sum :
        ∑ p ∈ U_main, MeasureTheory.volume (Q_hat p) =
          ∑ _p ∈ U_main, ENNReal.ofReal v_box :=
      Finset.sum_congr rfl (fun p hp => hQ_hat_vol p (hU_main_grid p hp))
    rw [h_sum, Finset.sum_const, nsmul_eq_mul]
  have h_vol_lo_enn :
      (U_main.card : ENNReal) * ENNReal.ofReal v_box ≤ MeasureTheory.volume Ω := by
    rw [← h_vol_inner_eq]
    exact MeasureTheory.measure_mono h_inner_sub
  have h_vol_hi_enn :
      MeasureTheory.volume Ω ≤ (U_outer.card : ENNReal) * ENNReal.ofReal v_box := by
    calc MeasureTheory.volume Ω
      _ ≤ MeasureTheory.volume (⋃ p ∈ U_outer, Q_hat p) := MeasureTheory.measure_mono h_outer_sub
      _ ≤ ∑ p ∈ U_outer, MeasureTheory.volume (Q_hat p) :=
        MeasureTheory.measure_biUnion_finset_le U_outer Q_hat
      _ = ∑ _p ∈ U_outer, ENNReal.ofReal v_box :=
        Finset.sum_congr rfl (fun p hp => hQ_hat_vol p (hU_outer_grid p hp))
      _ = (U_outer.card : ENNReal) * ENNReal.ofReal v_box := by
        rw [Finset.sum_const, nsmul_eq_mul]
  have h_outer_ne_top :
      (U_outer.card : ENNReal) * ENNReal.ofReal v_box ≠ ⊤ :=
    ENNReal.mul_ne_top (ENNReal.natCast_ne_top _) ENNReal.ofReal_ne_top
  have h_vol_ne_top : MeasureTheory.volume Ω ≠ ⊤ :=
    ne_top_of_le_ne_top h_outer_ne_top h_vol_hi_enn
  have h_vol_lo : (U_main.card : ℝ) * v_box ≤ (MeasureTheory.volume Ω).toReal := by
    have h1 := ENNReal.toReal_mono h_vol_ne_top h_vol_lo_enn
    rw [ENNReal.toReal_mul, ENNReal.toReal_natCast, ENNReal.toReal_ofReal hv_box_nonneg] at h1
    exact h1
  have h_vol_hi : (MeasureTheory.volume Ω).toReal ≤ (U_outer.card : ℝ) * v_box := by
    have h1 := ENNReal.toReal_mono h_outer_ne_top h_vol_hi_enn
    rw [ENNReal.toReal_mul, ENNReal.toReal_natCast, ENNReal.toReal_ofReal hv_box_nonneg] at h1
    exact h1
  have h_card_main :
      (U_main.card : ℝ) = ∑ ξ : ι_real → Fin 2, ((S_main_slice ξ).card : ℝ) := by
    dsimp [U_main]
    rw [Finset.card_sigma, Nat.cast_sum]
  have h_card_outer :
      (U_outer.card : ℝ) = ∑ ξ : ι_real → Fin 2, ((S'_outer ξ).card : ℝ) := by
    dsimp [U_outer]
    rw [Finset.card_sigma, Nat.cast_sum]
  have h_slice_card_le : ∀ ξ : ι_real → Fin 2,
      ((S'_outer ξ).card : ℝ) ≤ ((S_main_slice ξ).card : ℝ) + (S_collar.card : ℝ) := by
    intro ξ
    have h_sub_union : S'_outer ξ ⊆ S_main_slice ξ ∪ S_collar := by
      intro q hq
      by_cases hq_main : q ∈ S_main_slice ξ
      · exact Finset.mem_union_left _ hq_main
