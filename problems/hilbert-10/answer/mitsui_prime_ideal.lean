    intro w
    rw [hΦ0 w, star_zero]
  
  have h_single : ∀ (w : NumberField.InfinitePlace K) (z : K), z ≠ 0 →
      ((w.embedding z / (w z : ℂ)) ^ (l_eff w)) * ((w z : ℂ) ^ (a_place w)) =
        (Φ_emb w z) ^ (a_place w) ∧
      (star ((w.embedding z / (w z : ℂ)) ^ (l_eff w))) * ((w z : ℂ) ^ (a_place w)) =
        (star (Φ_emb w z)) ^ (a_place w) := by
    intro w z hz
    have hw_pos : 0 < w z := w.pos_iff.mpr hz
    have hw_ne : (w z : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hw_pos)
    have hemb_ne : w.embedding z ≠ 0 := (map_ne_zero_iff w.embedding (RingHom.injective _)).mpr hz
    have h_norm : ‖w.embedding z‖ = w z := NumberField.InfinitePlace.norm_embedding_eq w z
    have h_conj_mul : star (w.embedding z) * w.embedding z = (w z : ℂ) * (w z : ℂ) := by
