    by_cases hp₀ : (p w₀ : ℕ) + 1 = l
    · by_cases hY_ge_one : 1 ≤ Y
      · set S_prime : ℂ := ∑' π : D_cell,
            ψ (Additive.ofMul π.2.2.2.2.2.unit) *
