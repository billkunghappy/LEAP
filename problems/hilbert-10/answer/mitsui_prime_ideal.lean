      NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero u)
    have h_prod :
        (∏ w : NumberField.InfinitePlace K,
          (star (Φ_emb w ((u : R) : K)) / (w ((u : R) : K) : ℂ)) ^ (a_place w)) =
        star (∏ w : NumberField.InfinitePlace K,
          (w.embedding ((u : R) : K) / (w ((u : R) : K) : ℂ)) ^ (l_eff w)) := by
      rw [star_prod]
      exact Finset.prod_congr rfl (fun w _ => hΦ_star_unit_w w ((u : R) : K) hu_ne)
    rw [h_prod, ← star_mul, mul_comm, hψ_units u]
    rw [RCLike.star_def, ← Complex.exp_conj, map_mul, Complex.conj_ofReal, Complex.conj_I,
      mul_neg, ← neg_mul, ← Complex.ofReal_neg]
  let b₀ : Module.Basis (Fin r) ℝ (Fin r → ℝ) := Pi.basisFun ℝ (Fin r)
  let L_ℤ : Submodule ℤ (Fin r → ℝ) := Submodule.span ℤ (Set.range ⇑b₀)
  have h_per : ∀ (g : L_ℤ) (y : Fin r → ℝ), Θ (g +ᵥ y) = Θ y := by
    intro g y
    obtain ⟨e, he⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ).mp g.2
    have hg_coord : ∀ i : Fin r, (g +ᵥ y) i = (e i : ℝ) + y i := by
      intro i
      change g.1 i + y i = (e i : ℝ) + y i
      have hg_i : g.1 i = (e i : ℝ) := by
        rw [← he]
        simp [b₀, Finset.sum_apply, Pi.basisFun_apply, Pi.single_apply]
      rw [hg_i]
    let u_e : Rˣ := ∏ i : Fin r, (ε i) ^ (-(e i))
    let φ_e : J_star ≃ J_star :=
      { toFun := fun x => ⟨(u_e : R) * x.1, J_star.mul_mem_left (u_e : R) x.2⟩
        invFun := fun x => ⟨((u_e⁻¹ : Rˣ) : R) * x.1, J_star.mul_mem_left ((u_e⁻¹ : Rˣ) : R) x.2⟩
        left_inv := fun x => Subtype.ext (by
          change ((u_e⁻¹ : Rˣ) : R) * ((u_e : R) * x.1) = x.1
          rw [← mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul])
        right_inv := fun x => Subtype.ext (by
          change (u_e : R) * (((u_e⁻¹ : Rˣ) : R) * x.1) = x.1
          rw [← mul_assoc, ← Units.val_mul, mul_inv_cancel, Units.val_one, one_mul]) }
    have hw_ue : ∀ w : NumberField.InfinitePlace K,
        w ((u_e : R) : K) = ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(e i : ℝ)) := by
      intro w
      let ψ_w : Rˣ →* ℝ :=
        { toFun := fun u => w ((u : R) : K)
          map_one' := by push_cast; exact map_one w
          map_mul' := fun u v => by push_cast; exact map_mul w _ _ }
      change ψ_w u_e = _
      dsimp [u_e]
      rw [map_prod]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [map_zpow ψ_w (ε i) (-(e i))]
      change (w ((ε i : R) : K)) ^ (-(e i)) = _
      rw [← Real.rpow_intCast, Int.cast_neg]
    have h_ue_lin : ∀ w : NumberField.InfinitePlace K,
        w ((u_e : R) : K) * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) =
          ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(g +ᵥ y) i) := by
      intro w
      rw [hw_ue w, ← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [← Real.rpow_add (hw_ε_pos w i), hg_coord i]
      congr 1
      ring
    have h_ue_sq : ∀ w : NumberField.InfinitePlace K,
        (w ((u_e : R) : K)) ^ 2 * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i) =
          ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (g +ᵥ y) i) := by
      intro w
      rw [hw_ue w, ← Finset.prod_pow, ← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [← Real.rpow_natCast, ← Real.rpow_mul (le_of_lt (hw_ε_pos w i)),
        ← Real.rpow_add (hw_ε_pos w i), hg_coord i]
      congr 1
      push_cast
      ring
    have h_ue_log : ∀ w : NumberField.InfinitePlace K,
        Real.log (w ((u_e : R) : K)) =
          -∑ i : Fin r, (e i : ℝ) * Real.log (w ((ε i : R) : K)) := by
      intro w
      rw [hw_ue w, Real.log_prod (fun i _ => ne_of_gt (Real.rpow_pos_of_pos (hw_ε_pos w i) _)),
        ← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Real.log_rpow (hw_ε_pos w i), neg_mul]
    have h_ue_phase :
        Complex.exp (((-∑ w : NumberField.InfinitePlace K,
          v_place w * Real.log (w ((u_e : R) : K))) : ℝ) * Complex.I) * E_cube y =
        E_cube (g +ᵥ y) := by
      dsimp only [E_cube]
      rw [← Complex.exp_add, ← add_mul, ← Complex.ofReal_add, ← Finset.sum_neg_distrib,
        ← Finset.sum_add_distrib]
      congr 3
      refine Finset.sum_congr rfl (fun w _ => ?_)
      rw [h_ue_log w, mul_neg, neg_neg, ← mul_add, ← Finset.sum_add_distrib]
      congr 1
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hg_coord i, add_mul]
    have h_ue_poly_w : ∀ (w : NumberField.InfinitePlace K) (x_star : J_star),
        (star (Φ_emb w (((φ_e x_star).1 : R) : K)) *
          ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w) =
        (star (Φ_emb w ((u_e : R) : K)) / (w ((u_e : R) : K) : ℂ)) ^ (a_place w) *
          (star (Φ_emb w ((x_star.1 : R) : K)) *
            ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(g +ᵥ y) i) : ℝ) : ℂ)) ^ (a_place w) := by
      intro w x_star
      have hw_ue_ne : (w ((u_e : R) : K) : ℂ) ≠ 0 := by
        exact_mod_cast ne_of_gt
          (w.pos_iff.mpr (NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero u_e)))
      have h_coe_lin :
          (w ((u_e : R) : K) : ℂ) * ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ) =
          ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(g +ᵥ y) i) : ℝ) : ℂ) := by
        rw [← Complex.ofReal_mul, h_ue_lin w]
      have h_emb_mul : star (Φ_emb w (((φ_e x_star).1 : R) : K)) =
          star (Φ_emb w ((u_e : R) : K)) * star (Φ_emb w ((x_star.1 : R) : K)) := by
        change star (Φ_emb w ((((u_e : R) * x_star.1 : R) : K))) = _
        push_cast
        exact hΦ_star_mul w _ _
      rw [h_emb_mul, ← mul_pow]
      congr 1
      rw [← h_coe_lin]
      calc star (Φ_emb w ((u_e : R) : K)) * star (Φ_emb w ((x_star.1 : R) : K)) *
            ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ)
        _ = (star (Φ_emb w ((u_e : R) : K)) / (w ((u_e : R) : K) : ℂ) * (w ((u_e : R) : K) : ℂ)) *
            star (Φ_emb w ((x_star.1 : R) : K)) *
            ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ) := by
            rw [div_mul_cancel₀ _ hw_ue_ne]
        _ = (star (Φ_emb w ((u_e : R) : K)) / (w ((u_e : R) : K) : ℂ)) *
            (star (Φ_emb w ((x_star.1 : R) : K)) *
              ((w ((u_e : R) : K) : ℂ) * ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ))) := by
            ring
    have h_ue_poly_prod : ∀ x_star : J_star,
        (∏ w : NumberField.InfinitePlace K,
          (star (Φ_emb w (((φ_e x_star).1 : R) : K)) *
            ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) =
        (∏ w : NumberField.InfinitePlace K,
          (star (Φ_emb w ((u_e : R) : K)) / (w ((u_e : R) : K) : ℂ)) ^ (a_place w)) *
          (∏ w : NumberField.InfinitePlace K,
            (star (Φ_emb w ((x_star.1 : R) : K)) *
              ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(g +ᵥ y) i) : ℝ) : ℂ)) ^ (a_place w)) := by
      intro x_star
      simp_rw [h_ue_poly_w _ x_star]
      exact Finset.prod_mul_distrib
    have h_ue_char : ∀ x_star : J_star,
        star (ψ_f (Ideal.Quotient.mk f (φ_e x_star).1)) =
        star (ψ_f (Ideal.Quotient.mk f (u_e : R))) * star (ψ_f (Ideal.Quotient.mk f x_star.1)) := by
      intro x_star
      change star (ψ_f (Ideal.Quotient.mk f ((u_e : R) * x_star.1))) = _
      rw [map_mul, hψ_mul, star_mul, mul_comm]
    have h_ue_char_poly : ∀ x_star : J_star,
        star (ψ_f (Ideal.Quotient.mk f (φ_e x_star).1)) *
          (∏ w : NumberField.InfinitePlace K,
            (star (Φ_emb w (((φ_e x_star).1 : R) : K)) *
              ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) =
        Complex.exp (((-∑ w : NumberField.InfinitePlace K,
          v_place w * Real.log (w ((u_e : R) : K))) : ℝ) * Complex.I) *
          (star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
            (∏ w : NumberField.InfinitePlace K,
              (star (Φ_emb w ((x_star.1 : R) : K)) *
                ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(g +ᵥ y) i) : ℝ) : ℂ)) ^ (a_place w))) := by
      intro x_star
      rw [h_ue_char x_star, h_ue_poly_prod x_star]
      calc (star (ψ_f (Ideal.Quotient.mk f (u_e : R))) * star (ψ_f (Ideal.Quotient.mk f x_star.1))) *
            ((∏ w : NumberField.InfinitePlace K,
              (star (Φ_emb w ((u_e : R) : K)) / (w ((u_e : R) : K) : ℂ)) ^ (a_place w)) *
              (∏ w : NumberField.InfinitePlace K,
                (star (Φ_emb w ((x_star.1 : R) : K)) *
                  ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(g +ᵥ y) i) : ℝ) : ℂ)) ^ (a_place w)))
        _ = (star (ψ_f (Ideal.Quotient.mk f (u_e : R))) *
              (∏ w : NumberField.InfinitePlace K,
                (star (Φ_emb w ((u_e : R) : K)) / (w ((u_e : R) : K) : ℂ)) ^ (a_place w))) *
            (star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
              (∏ w : NumberField.InfinitePlace K,
                (star (Φ_emb w ((x_star.1 : R) : K)) *
                  ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(g +ᵥ y) i) : ℝ) : ℂ)) ^ (a_place w))) := by
            ring
        _ = _ := by rw [h_unit_star_cancel u_e]
    have h_ue_gauss : ∀ x_star : J_star,
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (w (((φ_e x_star).1 : R) : K)) ^ 2 *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)) =
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (g +ᵥ y) i)) := by
      intro x_star
      refine Finset.sum_congr rfl (fun w _ => ?_)
      have hw_mul : w (((φ_e x_star).1 : R) : K) = w ((u_e : R) : K) * w ((x_star.1 : R) : K) := by
        change w ((((u_e : R) * x_star.1 : R) : K)) = _
        push_cast
        exact map_mul w _ _
      rw [hw_mul, mul_pow]
      calc (w.mult : ℝ) * ((w ((u_e : R) : K)) ^ 2 * (w ((x_star.1 : R) : K)) ^ 2) *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)
        _ = (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
            ((w ((u_e : R) : K)) ^ 2 * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)) := by ring
        _ = (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (g +ᵥ y) i) := by rw [h_ue_sq w]
    symm
    dsimp only [Θ]
    rw [← Equiv.tsum_eq φ_e]
    refine tsum_congr (fun x_star => ?_)
    rw [h_ue_char_poly x_star, h_ue_gauss x_star]
    calc (Complex.exp (((-∑ w : NumberField.InfinitePlace K,
            v_place w * Real.log (w ((u_e : R) : K))) : ℝ) * Complex.I) *
          (star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
            (∏ w : NumberField.InfinitePlace K,
              (star (Φ_emb w ((x_star.1 : R) : K)) *
                ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(g +ᵥ y) i) : ℝ) : ℂ)) ^ (a_place w)))) *
          (((c_scaled ^ A_exp *
            Real.exp (-Real.pi * c_scaled ^ 2 *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
                  ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (g +ᵥ y) i)) : ℝ) : ℂ)) *
          E_cube y
      _ = star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
          (∏ w : NumberField.InfinitePlace K,
            (star (Φ_emb w ((x_star.1 : R) : K)) *
              ((∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(g +ᵥ y) i) : ℝ) : ℂ)) ^ (a_place w)) *
          (((c_scaled ^ A_exp *
            Real.exp (-Real.pi * c_scaled ^ 2 *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
                  ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (g +ᵥ y) i)) : ℝ) : ℂ)) *
          (Complex.exp (((-∑ w : NumberField.InfinitePlace K,
            v_place w * Real.log (w ((u_e : R) : K))) : ℝ) * Complex.I) * E_cube y) := by ring
      _ = _ := by rw [h_ue_phase]
  
  haveI : MeasureTheory.VAddInvariantMeasure L_ℤ (Fin r → ℝ) MeasureTheory.volume :=
    ⟨fun z t _ => MeasureTheory.measure_preimage_add MeasureTheory.volume z.1 t⟩
  have h_fund_Cube : MeasureTheory.IsAddFundamentalDomain L_ℤ Cube MeasureTheory.volume := by
    dsimp [Cube]
    rw [← ZSpan.fundamentalDomain_pi_basisFun]
    exact ZSpan.isAddFundamentalDomain b₀ MeasureTheory.volume
  let t_Cube : Set (Fin r → ℝ) := (fun y => y + v_γ) '' Cube
  have hCube_meas : MeasurableSet Cube :=
    MeasurableSet.univ_pi (fun _ => measurableSet_Ico)
  have ht_Cube_meas : MeasurableSet t_Cube :=
    (measurableEmbedding_addRight v_γ).measurableSet_image.mpr hCube_meas
  have h_fund_trans : MeasureTheory.IsAddFundamentalDomain L_ℤ t_Cube MeasureTheory.volume := by
    refine MeasureTheory.IsAddFundamentalDomain.mk' ht_Cube_meas.nullMeasurableSet (fun x => ?_)
    have h_iff : ∀ g : L_ℤ, g +ᵥ x ∈ t_Cube ↔ g +ᵥ (x - v_γ) ∈ ZSpan.fundamentalDomain b₀ := by
      intro g
      rw [ZSpan.fundamentalDomain_pi_basisFun]
      change (∃ y ∈ Cube, y + v_γ = g.1 + x) ↔ g.1 + (x - v_γ) ∈ Cube
      constructor
      · rintro ⟨y, hy, hy_eq⟩
        have h_eq : g.1 + (x - v_γ) = y := by
          calc g.1 + (x - v_γ) = (g.1 + x) - v_γ := by abel
            _ = (y + v_γ) - v_γ := by rw [← hy_eq]
            _ = y := add_sub_cancel_right y v_γ
        rwa [h_eq]
      · intro h_mem
        refine ⟨g.1 + (x - v_γ), h_mem, ?_⟩
        abel
    simp_rw [h_iff]
    exact ZSpan.exist_unique_vadd_mem_fundamentalDomain b₀ (x - v_γ)
  have h_img := (MeasureTheory.MeasurePreserving.setIntegral_image_emb
    (MeasureTheory.measurePreserving_add_right MeasureTheory.volume v_γ)
    (measurableEmbedding_addRight v_γ) Θ Cube).symm
  have h_eq_fund := MeasureTheory.IsAddFundamentalDomain.setIntegral_eq
    h_fund_trans h_fund_Cube h_per
  exact h_lhs_eq.trans (h_img.trans h_eq_fund)

theorem mitsui_primitive_grossenchar_classGroup_cube_lattice_posNeg_theta_inversion {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (l_eff : NumberField.InfinitePlace K → ℤ)
    (hl_eff_real : ∀ w : NumberField.InfinitePlace K, w.IsReal → (l_eff w = 0 ∨ l_eff w = 1))
    (v_place : NumberField.InfinitePlace K → ℝ)
    (hv_sum : (∑ w : NumberField.InfinitePlace K, v_place w) = 0)
    (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ₀_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖χ₀ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → χ₀ I = 0))
    (J_rep : ClassGroup (NumberField.RingOfIntegers K) → nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))
    (hJ_cls : ∀ C : ClassGroup (NumberField.RingOfIntegers K), ClassGroup.mk0 (J_rep C) = C⁻¹)
    (hJ_cop : ∀ C : ClassGroup (NumberField.RingOfIntegers K), (J_rep C : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤)
    (ψ_f : (NumberField.RingOfIntegers K ⧸ f) → ℂ)
    (hψ_one : ψ_f 1 = 1)
    (hψ_mul : ∀ a b : NumberField.RingOfIntegers K ⧸ f, ψ_f (a * b) = ψ_f a * ψ_f b)
    (hψ_unit : ∀ a : NumberField.RingOfIntegers K ⧸ f, (IsUnit a → ‖ψ_f a‖ = 1) ∧ (¬ IsUnit a → ψ_f a = 0))
    (hψ_span : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
        Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I) =
      ψ_f (Ideal.Quotient.mk f x) *
        ∏ w : NumberField.InfinitePlace K,
          (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_eff w))
    (hψ_prim : ∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
      ∃ x : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk f x) ∧ x - 1 ∈ f' ∧ ψ_f (Ideal.Quotient.mk f x) ≠ 1)
    (hψ_zero : (f ≠ ⊤ ∧ ψ_f 0 = 0 ∧
        ∀ (h_fin : Fintype (NumberField.RingOfIntegers K ⧸ f)),
          @Finset.sum (NumberField.RingOfIntegers K ⧸ f) ℂ _ (@Finset.univ (NumberField.RingOfIntegers K ⧸ f) h_fin) ψ_f = 0) ∨
      (f = ⊤ ∧ (∀ a : NumberField.RingOfIntegers K ⧸ f, ψ_f a = 1) ∧
        (∀ w : NumberField.InfinitePlace K, w.IsReal → l_eff w = 0) ∧
        ((∃ w : NumberField.InfinitePlace K, l_eff w ≠ 0) ∨
          ((∀ w : NumberField.InfinitePlace K, l_eff w = 0) ∧
            ∃ i : Fin (NumberField.Units.rank K),
              ∃ k : ℤ, k ≠ 0 ∧
                (∑ w : NumberField.InfinitePlace K,
                  v_place w * Real.log (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K))) =
                  2 * Real.pi * (k : ℝ))))) :
    let R := NumberField.RingOfIntegers K
    let n : ℕ := Module.finrank ℚ K
    let r : ℕ := NumberField.Units.rank K
    let a_place : NumberField.InfinitePlace K → ℕ := fun w => (l_eff w).natAbs
    let S_f : ℝ := |(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) * (Ideal.absNorm f : ℝ) ^ (-1 / 2 : ℝ)
    let Cube : Set (Fin r → ℝ) := Set.pi Set.univ (fun _ => Set.Ico (0 : ℝ) 1)
    ∃ ω_χ : ℂ, ‖ω_χ‖ = 1 ∧
      ∀ u ∈ Set.Ioi (0 : ℝ),
        (∑ C : ClassGroup R,
          star (χ₀ (J_rep C)) *
            (∫ y in Cube,
              (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
                χ₀ ⟨Ideal.span ({x.1} : Set R),
                  mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr x.2.1)⟩ *
                  Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x.1 : K))) : ℝ) * Complex.I) *
                  ((((S_f * u⁻¹ / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
                      (∑ w : NumberField.InfinitePlace K, a_place w) *
