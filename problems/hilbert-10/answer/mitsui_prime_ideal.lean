      have hm_eq_h : ((m₁ - m₀ : ℤ) : ℝ) = h := by
        calc ((m₁ - m₀ : ℤ) : ℝ) = ((K : ℝ) * h) * ((m₁ - m₀ : ℤ) : ℝ) := by rw [hKh_int, one_mul]
          _ = ((K : ℝ) * ((m₁ - m₀ : ℤ) : ℝ)) * h := by ring
