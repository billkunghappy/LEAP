        congrArg (B * ·) (Finset.sum_subtype (Finset.univ.filter (fun pm : D_ge1 => ¬ (pm.1.2 = 1)))
          (fun _ => by simp) (fun pm : D_ge1 => Real.log (Ideal.absNorm pm.1.1.asIdeal)))
  let emb_ge2 : {pm : D_ge1 // ¬ (pm.1.2 = 1)} ↪ D_ge2 :=
    { toFun := fun pm =>
        ⟨pm.1.1, ⟨by have := pm.1.2.1; have := pm.2; omega,
