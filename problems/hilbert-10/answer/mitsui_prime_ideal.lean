    intro p₁ p₂ hΨ
    have h_val : (Ψ p₁).1 = (Ψ p₂).1 := congrArg Subtype.val hΨ
    have hΦ : Φ_I (p₁.1, p₁.2.1) = Φ_I (p₂.1, p₂.2.1) := Subtype.ext h_val
