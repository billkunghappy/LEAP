theorem mitsui_riesz_vonMangoldt_nat_asymptotic : ∃ c₀ : ℝ, 0 < c₀ ∧
      ∀ Y : ℝ, 0 < Y →
        |(∑ n ∈ Finset.Icc 1 ⌊Y⌋₊,
            ArithmeticFunction.vonMangoldt n * Real.log (Y / (n : ℝ)))
          - Y|
          ≤ c₀ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₀) :=
by
  obtain ⟨B, C, hB_pos, hB_le, hC_pos, h_dlvp⟩ := mitsui_riemannZeta_zeroFree_and_logDeriv_bound
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_deLaValleePoussin_integral_bound B hB_pos
  let c₀ : ℝ := (C + B⁻¹) * c₁ + c₁ + 1
  have hc₀_pos : 0 < c₀ := by dsimp [c₀]; positivity
  refine ⟨c₀, hc₀_pos, ?_⟩
  intro Y hY
  rcases le_or_gt Y 1 with hY_le | hY_gt
  · have hS_zero : (∑ n ∈ Finset.Icc 1 ⌊Y⌋₊,
        ArithmeticFunction.vonMangoldt n * Real.log (Y / (n : ℝ))) = 0 := by
      apply Finset.sum_eq_zero
      intro n hn
      rw [Finset.mem_Icc] at hn
      have hn1 : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn.1
      have hnY : (n : ℝ) ≤ Y := by
        have h_le : (n : ℝ) ≤ (⌊Y⌋₊ : ℝ) := by exact_mod_cast hn.2
        exact le_trans h_le (Nat.floor_le (le_of_lt hY))
      have hYn : Y / (n : ℝ) = 1 := by
        have hY1 : Y = 1 := by linarith
        have hn1' : (n : ℝ) = 1 := by linarith
        rw [hY1, hn1', div_one]
      rw [hYn, Real.log_one, mul_zero]
    rw [hS_zero, zero_sub, abs_neg, abs_of_pos hY]
    have hlog_nonpos : Real.log Y ≤ 0 := Real.log_nonpos (le_of_lt hY) hY_le
    have hsqrt_zero : Real.sqrt (Real.log Y) = 0 := Real.sqrt_eq_zero_of_nonpos hlog_nonpos
    rw [hsqrt_zero, neg_zero, zero_div, Real.exp_zero, mul_one]
    have hc₀_ge_one : 1 ≤ c₀ := by
      have : 0 ≤ (C + B⁻¹) * c₁ + c₁ := by positivity
      dsimp [c₀]; linarith
    calc Y = 1 * Y := by ring
      _ ≤ c₀ * Y := mul_le_mul_of_nonneg_right hc₀_ge_one (le_of_lt hY)
  · rw [mitsui_riesz_vonMangoldt_eq_vertical_integral Y hY_gt]
    have h3 := mitsui_riesz_vertical_integral_sub_id_le_boundary_integral B C hB_pos hB_le hC_pos h_dlvp Y hY_gt
    have h4 := hc₁ Y hY_gt
    have hCB_nonneg : 0 ≤ C + B⁻¹ := by positivity
    have h_step1 : (C + B⁻¹) *
        (∫ t : ℝ, Y ^ (1 - B / Real.log (4 + |t|)) * (Real.log (4 + |t|) / (1 / 4 + t ^ 2))) ≤
        (C + B⁻¹) * (c₁ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁)) :=
      mul_le_mul_of_nonneg_left h4 hCB_nonneg
    have hsqrt_nonneg : 0 ≤ Real.sqrt (Real.log Y) := Real.sqrt_nonneg _
    have hc₁_le_c₀ : c₁ ≤ c₀ := by
      have : 0 ≤ (C + B⁻¹) * c₁ + 1 := by positivity
      dsimp [c₀]; linarith
    have hexp_le : Real.exp (-Real.sqrt (Real.log Y) / c₁) ≤ Real.exp (-Real.sqrt (Real.log Y) / c₀) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left hsqrt_nonneg hc₁_pos hc₁_le_c₀
    have h_step2 : (C + B⁻¹) * (c₁ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁)) ≤
        ((C + B⁻¹) * c₁) * Y * Real.exp (-Real.sqrt (Real.log Y) / c₀) := by
      calc (C + B⁻¹) * (c₁ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₁))
        _ = ((C + B⁻¹) * c₁ * Y) * Real.exp (-Real.sqrt (Real.log Y) / c₁) := by ring
        _ ≤ ((C + B⁻¹) * c₁ * Y) * Real.exp (-Real.sqrt (Real.log Y) / c₀) :=
            mul_le_mul_of_nonneg_left hexp_le (by positivity)
        _ = ((C + B⁻¹) * c₁) * Y * Real.exp (-Real.sqrt (Real.log Y) / c₀) := by ring
    have hCBc1_le_c₀ : (C + B⁻¹) * c₁ ≤ c₀ := by
      have : 0 ≤ c₁ + 1 := by positivity
      dsimp [c₀]; linarith
    have h_step3 : ((C + B⁻¹) * c₁) * Y * Real.exp (-Real.sqrt (Real.log Y) / c₀) ≤
        c₀ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₀) := by
      calc ((C + B⁻¹) * c₁) * Y * Real.exp (-Real.sqrt (Real.log Y) / c₀)
        _ = ((C + B⁻¹) * c₁) * (Y * Real.exp (-Real.sqrt (Real.log Y) / c₀)) := by ring
        _ ≤ c₀ * (Y * Real.exp (-Real.sqrt (Real.log Y) / c₀)) :=
            mul_le_mul_of_nonneg_right hCBc1_le_c₀ (by positivity)
        _ = c₀ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₀) := by ring
    linarith

theorem mitsui_riesz_primePowers_sub_vonMangoldt_eq_vertical_integral {K : Type u} [Field K] [NumberField K]
