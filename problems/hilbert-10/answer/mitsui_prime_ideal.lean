    have hNf_c_ne : (N_f : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hNf_pos)
    have hNf_comb : (N_f : ℂ) ^ (z / 2) * (N_f : ℂ) ^ ((-3 / 4 : ℝ) : ℂ) = (N_f : ℂ) ^ (z / 2 - (3 / 4 : ℂ)) := by
      rw [← Complex.cpow_add _ _ hNf_c_ne]
      congr 1
      push_cast
      ring
    set F : NumberField.InfinitePlace K → ℂ := fun w =>
      ∫ v in Set.Ioi (0 : ℝ),
        (v : ℂ) ^ (z + ((a_place w : ℂ) + (ν_place w : ℂ) * Complex.I) / (w.mult : ℂ)) *
