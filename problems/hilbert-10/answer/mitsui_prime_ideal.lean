        Real.exp 1 * Real.sqrt Y * Real.exp (-t / c₂) := by
      rw [Real.exp_add, Real.exp_add, hexp_half]
    have hexp_bound : Real.exp ((t ^ 2 + 1) / 4) ≤
        Real.exp 1 * Real.sqrt Y * Real.exp (-t / c₂) := by
      rw [← hexp_split]
      exact Real.exp_le_exp.mpr hexp_arg_le
    have hY_sqrt_mul : Real.sqrt Y * Real.sqrt Y = Y :=
      Real.mul_self_sqrt (le_of_lt hY_pos)
    calc A * Real.sqrt Y * (Real.log Y + 1) ^ 3
        ≤ A * Real.sqrt Y * (1728 * Real.exp ((t ^ 2 + 1) / 4)) := by
          gcongr
      _ ≤ A * Real.sqrt Y * (1728 * (Real.exp 1 * Real.sqrt Y * Real.exp (-t / c₂))) := by
          gcongr
      _ = (1728 * A * Real.exp 1) * (Real.sqrt Y * Real.sqrt Y) * Real.exp (-t / c₂) := by
          ring
      _ = (1728 * A * Real.exp 1) * Y * Real.exp (-t / c₂) := by
          rw [hY_sqrt_mul]
      _ ≤ c₂ * Y * Real.exp (-t / c₂) := by
          gcongr
  refine ⟨c₂, hc₂_pos, ?_⟩
  intro Y hY_pos
  have h_le_ge2 := h_s3 Y
  rcases le_or_gt Y 1 with hY_le | hY_gt
  · let D_ge2 := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
      2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y}
    haveI : IsEmpty D_ge2 := ⟨fun pm => by
      have hk2 : 2 ≤ Ideal.absNorm pm.1.1.asIdeal := h_s2 pm.1.1
      have hm_ne : pm.1.2 ≠ 0 := by have := pm.2.1; omega
      have hk_le_pow : Ideal.absNorm pm.1.1.asIdeal ≤ Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2 :=
        Nat.le_self_pow hm_ne (Ideal.absNorm pm.1.1.asIdeal)
      have h2_le_pow : 2 ≤ Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2 := le_trans hk2 hk_le_pow
      have h2_real : (2 : ℝ) ≤ (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 := by
        exact_mod_cast h2_le_pow
      have h_pow_le_Y : (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 ≤ Y := pm.2.2
      linarith⟩
    have h_tsum_zero : (∑' pm : D_ge2,
        Real.log (Ideal.absNorm pm.1.1.asIdeal) *
          Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))) = 0 := tsum_empty
    have h_rhs_nonneg : 0 ≤ c₂ * Y * Real.exp (-Real.sqrt (Real.log Y) / c₂) := by positivity
    linarith
  · set s : ℝ := Real.sqrt Y
    set M : ℕ := ⌊Real.log Y / Real.log 2⌋₊
    have hs_ge_one : 1 ≤ s := Real.one_le_sqrt.mpr (le_of_lt hY_gt)
    have h_SJ_bound : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
        (Ideal.absNorm J : ℝ) ≤ s} : ℝ) ≤ C₁ * s := hC₁ s hs_ge_one
    have hlogY_pos : 0 < Real.log Y := Real.log_pos hY_gt
    have h_arg_nonneg : 0 ≤ Real.log Y / Real.log 2 := by positivity
    have hM_le : (M : ℝ) ≤ Real.log Y / Real.log 2 := Nat.floor_le h_arg_nonneg
