                  · exact Or.inr ⟨hx_Icc, Or.inr ⟨by linarith, by linarith⟩⟩
                · exact Or.inr ⟨hx_Icc, Or.inl ⟨by linarith, by linarith⟩⟩
              · exact Or.inl ⟨Or.inr ⟨by linarith, by linarith⟩, hy_Icc⟩
            · exact Or.inl ⟨Or.inl ⟨by linarith, by linarith⟩, hy_Icc⟩
          · have h_r_x : a₀ ≤ q.1 * Real.cos q.2 ∧ q.1 * Real.cos q.2 < b₀ := he.2.2.1
            have h_r_y : a₁ ≤ q.1 * Real.sin q.2 ∧ q.1 * Real.sin q.2 < b₁ := he.2.2.2
            by_cases hx1 : a₀ ≤ R₁ * Real.cos q.2
            · by_cases hx2 : R₁ * Real.cos q.2 < b₀
