    have hpoly_bound : (Real.log X + 1) ^ 2 ≤ 64 * Real.exp ((t ^ 2 + 1) / 4) := by
      have h2 := mul_le_mul_of_nonneg_left hpow_le (by norm_num : (0 : ℝ) ≤ 64)
      have h3 : 64 * ((t ^ 2 + 1) / 8) ^ 2 = (t ^ 2 + 1) ^ 2 := by ring
      rw [← ht_sq, ← h3]
      exact h2
    have hn_ge_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
    have htc_le : t / c₂ ≤ t / 2 :=
      div_le_div_of_nonneg_left (le_of_lt ht_pos) (by norm_num) hc_ge_two
    have hsq_nonneg : 0 ≤ (t - 1) ^ 2 / 4 := by positivity
    have hn_half : t ^ 2 / 2 ≤ ((n : ℝ) / 2) * t ^ 2 := by
      have : (1 : ℝ) / 2 ≤ (n : ℝ) / 2 := by linarith
      nlinarith
    have hexp_arg_le2 : (t ^ 2 + 1) / 4 ≤ 1 + ((n : ℝ) / 2) * t ^ 2 + (-t / c₂) := by
      have hident : (t ^ 2 + 1) / 4 = t ^ 2 / 2 - t / 2 + 1 / 2 - (t - 1) ^ 2 / 4 := by ring
      rw [neg_div]
      linarith
    have hexp_split : Real.exp (1 + ((n : ℝ) / 2) * t ^ 2 + (-t / c₂)) =
        Real.exp 1 * X ^ ((n : ℝ) / 2) * Real.exp (-t / c₂) := by
      rw [Real.exp_add, Real.exp_add, ht_sq, Real.rpow_def_of_pos hX_pos]
      ring_nf
    have hexp_bound : Real.exp ((t ^ 2 + 1) / 4) ≤
        Real.exp 1 * X ^ ((n : ℝ) / 2) * Real.exp (-t / c₂) := by
      rw [← hexp_split]
      exact Real.exp_le_exp.mpr hexp_arg_le2
    have hX_half_mul : X ^ ((n : ℝ) / 2) * X ^ ((n : ℝ) / 2) = X ^ n := by
      rw [← Real.rpow_add hX_pos]
      have hnh : (n : ℝ) / 2 + (n : ℝ) / 2 = (n : ℝ) := by ring
      rw [hnh, Real.rpow_natCast]
    calc A * X ^ ((n : ℝ) / 2) * (Real.log X + 1) ^ 2
        ≤ A * X ^ ((n : ℝ) / 2) * (64 * Real.exp ((t ^ 2 + 1) / 4)) := by
          gcongr
      _ ≤ A * X ^ ((n : ℝ) / 2) * (64 * (Real.exp 1 * X ^ ((n : ℝ) / 2) * Real.exp (-t / c₂))) := by
          gcongr
      _ = (64 * A * Real.exp 1) * (X ^ ((n : ℝ) / 2) * X ^ ((n : ℝ) / 2)) * Real.exp (-t / c₂) := by
          ring
      _ = (64 * A * Real.exp 1) * X ^ n * Real.exp (-t / c₂) := by
          rw [hX_half_mul]
      _ ≤ c₂ * X ^ n * Real.exp (-t / c₂) := by
          gcongr
  refine ⟨c₂, hc₂_pos, ?_⟩
  intro X hX q hq ψ
  have hX_pos : 0 < X := by linarith
  have h2X_gt_one : 1 < 2 * X := by linarith
  have hlog_pos : 0 < Real.log X := Real.log_pos hX
  have hlog_le : Real.log X ≤ Real.log X + 1 := by linarith
  have hlog2_lt_one : Real.log 2 < 1 := lt_trans Real.log_two_lt_d9 (by norm_num)
  have hlog2X_le : Real.log (2 * X) + 1 ≤ 2 * (Real.log X + 1) := by
    rw [Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) (ne_of_gt hX_pos)]
    linarith
  have hrpow2X : (2 * X) ^ ((n : ℝ) / 2) = (2 : ℝ) ^ ((n : ℝ) / 2) * X ^ ((n : ℝ) / 2) :=
    Real.mul_rpow (by norm_num : (0 : ℝ) ≤ 2) (le_of_lt hX_pos)
  have h1 := h_s1 X hX q hq ψ
  have h2 := h_s2 X hX
  have h3 := hc_id (2 * X) h2X_gt_one
  have h4 := h_s4 X hX
  set N_elts : ℝ := (Nat.card {x : NumberField.RingOfIntegers K //
    NumberField.mixedEmbedding K (x : K) ∈
      NumberField.mixedEmbedding.fundamentalCone K ∧
    NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤
      X ^ n ∧
    ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ∃ m : ℕ, 2 ≤ m ∧ Ideal.span {x} = p.asIdeal ^ m} : ℝ)
  set N_ids : ℝ := (Nat.card {I : Ideal (NumberField.RingOfIntegers K) //
    (Ideal.absNorm I : ℝ) < (2 * X) ^ n ∧
    ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ∃ m : ℕ, 2 ≤ m ∧ I = p.asIdeal ^ m} : ℝ)
  have hN_elts_nonneg : 0 ≤ N_elts := Nat.cast_nonneg _
  have hstep1 : (n : ℝ) * Real.log X * N_elts ≤ (n : ℝ) * (Real.log X + 1) * N_elts := by
    gcongr
  have hstep2 : (n : ℝ) * (Real.log X + 1) * N_elts ≤
      (n : ℝ) * (Real.log X + 1) * (W * N_ids) := by
    gcongr
  have hstep3 : (n : ℝ) * (Real.log X + 1) * (W * N_ids) ≤
      (n : ℝ) * (Real.log X + 1) *
        (W * (c_id * (2 * X) ^ ((n : ℝ) / 2) * (Real.log (2 * X) + 1))) := by
    gcongr
  have hstep4 : (n : ℝ) * (Real.log X + 1) *
        (W * (c_id * (2 * X) ^ ((n : ℝ) / 2) * (Real.log (2 * X) + 1))) ≤
      (n : ℝ) * (Real.log X + 1) *
        (W * (c_id * ((2 : ℝ) ^ ((n : ℝ) / 2) * X ^ ((n : ℝ) / 2)) * (2 * (Real.log X + 1)))) := by
    rw [hrpow2X]
    gcongr
  have hstep5 : (n : ℝ) * (Real.log X + 1) *
        (W * (c_id * ((2 : ℝ) ^ ((n : ℝ) / 2) * X ^ ((n : ℝ) / 2)) * (2 * (Real.log X + 1)))) =
      A * X ^ ((n : ℝ) / 2) * (Real.log X + 1) ^ 2 := by
    dsimp [A]
    ring
  linarith

theorem mitsui_vonMangoldt_char_convex_to_fundamentalCone {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (A : ℕ) (hA : 1 < A) :
    ∃ c₁ : ℝ, 0 < c₁ ∧
      ∀ X : ℝ, 1 < X →
        ∀ C : Set (NumberField.mixedEmbedding.mixedSpace K), Convex ℝ C → IsOpen C →
          (∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
              NumberField.mixedEmbedding.normAtPlace w z < X) →
          ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
            (Ideal.absNorm q : ℝ) < Real.log X ^ A →
            ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
              ‖(∑' x : {x : NumberField.RingOfIntegers K //
                    NumberField.mixedEmbedding K (x : K) ∈ C ∧
                    IsUnit (Ideal.Quotient.mk q x)},
                  ψ (Additive.ofMul x.2.2.unit) *
                    (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ))
                - (((MeasureTheory.volume C).toReal /
                    ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) *
                      NumberField.Units.regulator K *
                      X ^ (Module.finrank ℚ K)) : ℝ) : ℂ) *
                  (∑' x : {x : NumberField.RingOfIntegers K //
                      NumberField.mixedEmbedding K (x : K) ∈
                        NumberField.mixedEmbedding.fundamentalCone K ∧
                      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤
                        X ^ (Module.finrank ℚ K) ∧
                      IsUnit (Ideal.Quotient.mk q x)},
                    ψ (Additive.ofMul x.2.2.2.unit) *
                      (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ))‖
                ≤ c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁) :=
by
  obtain ⟨c_pv, hc_pv_pos, hc_pv⟩ := mitsui_prime_to_vonMangoldt_unconditioned (K := K)
  obtain ⟨c_cb, hc_cb_pos, hc_cb⟩ := mitsui_prime_char_convex_to_box (K := K) A hA
  obtain ⟨c_bf, hc_bf_pos, hc_bf⟩ := mitsui_prime_char_box_to_fundamentalCone (K := K) A hA
  obtain ⟨c_cp, hc_cp_pos, hc_cp⟩ := mitsui_vonMangoldt_char_cone_to_prime (K := K)
  set F : ℝ := (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
  set R : ℝ := NumberField.Units.regulator K
  have hF_pos : 0 < F := by
    change (0 : ℝ) < (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
    have h1 := NumberField.mixedEmbedding.one_le_convexBodyLTFactor K
    exact_mod_cast lt_of_lt_of_le zero_lt_one h1
  have hR_pos : 0 < R := NumberField.Units.regulator_pos K
  let c₁ : ℝ := c_pv + c_cb + c_bf + c_cp + R⁻¹ * c_cp
  have hc₁_pos : 0 < c₁ := by
    dsimp [c₁]
    positivity
  refine ⟨c₁, hc₁_pos, ?_⟩
  intro X hX C hC_conv hC_open hC_bdd q hq hq_norm ψ hψ
  
  have hX0 : 0 ≤ X := by linarith
  let f : NumberField.InfinitePlace K → NNReal := fun _ => ⟨X, hX0⟩
  have hC_sub : C ⊆ NumberField.mixedEmbedding.convexBodyLT K f := by
    intro z hz
    rw [NumberField.mixedEmbedding.convexBodyLT, Set.mem_prod, Set.mem_univ_pi, Set.mem_univ_pi]
    refine ⟨fun w => ?_, fun w => ?_⟩
    · rw [Metric.mem_ball, dist_zero_right, ← NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2]
      exact hC_bdd z hz w.1
    · rw [Metric.mem_ball, dist_zero_right, ← NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex w.2]
      exact hC_bdd z hz w.1
  have hvol_le : MeasureTheory.volume C ≤
      MeasureTheory.volume (NumberField.mixedEmbedding.convexBodyLT K f) :=
    MeasureTheory.measure_mono hC_sub
  have hvol_eq : MeasureTheory.volume (NumberField.mixedEmbedding.convexBodyLT K f) =
      ↑(NumberField.mixedEmbedding.convexBodyLTFactor K) * ↑(∏ w, f w ^ w.mult) := by
    convert NumberField.mixedEmbedding.convexBodyLT_volume K f
  rw [hvol_eq] at hvol_le
  have hprod : (∏ w : NumberField.InfinitePlace K, f w ^ w.mult) =
      ⟨X, hX0⟩ ^ (Module.finrank ℚ K) := by
    dsimp [f]
    rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq]
  rw [hprod] at hvol_le
  have hne_top : (↑(NumberField.mixedEmbedding.convexBodyLTFactor K) *
      ↑(⟨X, hX0⟩ ^ (Module.finrank ℚ K) : NNReal) : ENNReal) ≠ ⊤ :=
    ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.coe_ne_top
  have hV_le : (MeasureTheory.volume C).toReal ≤ F * X ^ (Module.finrank ℚ K) := by
    have htoReal := ENNReal.toReal_mono hne_top hvol_le
    rw [ENNReal.toReal_mul, ENNReal.coe_toReal, ENNReal.coe_toReal, NNReal.coe_pow, NNReal.coe_mk] at htoReal
    exact htoReal
  
  set Y : ℝ := X ^ (Module.finrank ℚ K)
  set V : ℝ := (MeasureTheory.volume C).toReal
  have hX_pos : 0 < X := by linarith
  have hY_pos : 0 < Y := by dsimp [Y]; positivity
  have hV_nonneg : 0 ≤ V := ENNReal.toReal_nonneg
  set τ : ℝ := V / (F * Y)
  set ρ : ℝ := V / (F * R * Y)
  have hτ_nonneg : 0 ≤ τ := by dsimp [τ]; positivity
  have hτ_le_one : τ ≤ 1 := by
    dsimp [τ]
    exact div_le_one_of_le₀ hV_le (by positivity)
  have hρ_nonneg : 0 ≤ ρ := by dsimp [ρ]; positivity
  have hρ_le : ρ ≤ R⁻¹ := by
    dsimp [ρ]
    rw [div_le_iff₀ (by positivity)]
    have h1 : R⁻¹ * (F * R * Y) = F * Y := by
      have hR_ne : R ≠ 0 := ne_of_gt hR_pos
      field_simp [hR_ne]
    rw [h1]
    exact hV_le
  have h1_filter := mitsui_prime_to_vonMangoldt_char_filter_le (K := K) X hX C hC_bdd q hq ψ
  have h1_uncond := hc_pv X hX C hC_conv hC_open hC_bdd
  have h1 := le_trans h1_filter h1_uncond
  have h2 := hc_cb X hX C hC_conv hC_open hC_bdd q hq hq_norm ψ hψ
  have h3 := hc_bf X hX q hq hq_norm ψ hψ
  have h4 := hc_cp X hX q hq ψ
  set S₁ : ℂ := ∑' x : {x : NumberField.RingOfIntegers K //
      NumberField.mixedEmbedding K (x : K) ∈ C ∧
      IsUnit (Ideal.Quotient.mk q x)},
    ψ (Additive.ofMul x.2.2.unit) *
      (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ)
  set S₂ : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      NumberField.mixedEmbedding K (π : K) ∈ C ∧
      IsUnit (Ideal.Quotient.mk q π)},
    ψ (Additive.ofMul π.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S₃ : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
      IsUnit (Ideal.Quotient.mk q π)},
    ψ (Additive.ofMul π.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S₄ : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      NumberField.mixedEmbedding K (π : K) ∈
        NumberField.mixedEmbedding.fundamentalCone K ∧
      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤ Y ∧
      IsUnit (Ideal.Quotient.mk q π)},
    ψ (Additive.ofMul π.2.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S₅ : ℂ := ∑' x : {x : NumberField.RingOfIntegers K //
      NumberField.mixedEmbedding K (x : K) ∈
        NumberField.mixedEmbedding.fundamentalCone K ∧
      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤ Y ∧
      IsUnit (Ideal.Quotient.mk q x)},
    ψ (Additive.ofMul x.2.2.2.unit) *
      (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ)
  have hρ_eq_C : (ρ : ℂ) = (τ : ℂ) * ((R⁻¹ : ℝ) : ℂ) := by
    have hρ_eq : ρ = τ * R⁻¹ := by dsimp [ρ, τ]; ring
    exact_mod_cast hρ_eq
  have h_ident : S₁ - (ρ : ℂ) * S₅ =
      (-(S₂ - S₁) + (S₂ - (τ : ℂ) * S₃) + (τ : ℂ) * (S₃ - ((R⁻¹ : ℝ) : ℂ) * S₄)) -
        (ρ : ℂ) * (S₅ - S₄) := by
    have hρC : (ρ : ℂ) * S₄ = (τ : ℂ) * (((R⁻¹ : ℝ) : ℂ) * S₄) := by
      rw [hρ_eq_C, mul_assoc]
    linear_combination -hρC
  have h_tri : ‖S₁ - (ρ : ℂ) * S₅‖ ≤
      ‖S₂ - S₁‖ + ‖S₂ - (τ : ℂ) * S₃‖ + ‖S₃ - ((R⁻¹ : ℝ) : ℂ) * S₄‖ + R⁻¹ * ‖S₅ - S₄‖ := by
    rw [congrArg norm h_ident]
    have ht1 := norm_sub_le
      (-(S₂ - S₁) + (S₂ - (τ : ℂ) * S₃) + (τ : ℂ) * (S₃ - ((R⁻¹ : ℝ) : ℂ) * S₄))
      ((ρ : ℂ) * (S₅ - S₄))
    have ht2 := norm_add_le
      (-(S₂ - S₁) + (S₂ - (τ : ℂ) * S₃))
      ((τ : ℂ) * (S₃ - ((R⁻¹ : ℝ) : ℂ) * S₄))
    have ht3 := norm_add_le (-(S₂ - S₁)) (S₂ - (τ : ℂ) * S₃)
    rw [norm_neg] at ht3
    have hm3 : ‖(τ : ℂ) * (S₃ - ((R⁻¹ : ℝ) : ℂ) * S₄)‖ ≤ ‖S₃ - ((R⁻¹ : ℝ) : ℂ) * S₄‖ := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hτ_nonneg]
      exact mul_le_of_le_one_left (norm_nonneg _) hτ_le_one
    have hm4 : ‖(ρ : ℂ) * (S₅ - S₄)‖ ≤ R⁻¹ * ‖S₅ - S₄‖ := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hρ_nonneg]
      exact mul_le_mul_of_nonneg_right hρ_le (norm_nonneg _)
    linarith
  have hsqrt_nonneg : 0 ≤ Real.sqrt (Real.log X) := Real.sqrt_nonneg _
  have hc_pv_le : c_pv ≤ c₁ := by
    have : 0 ≤ c_cb + c_bf + c_cp + R⁻¹ * c_cp := by positivity
    dsimp [c₁]; linarith
  have hc_cb_le : c_cb ≤ c₁ := by
    have : 0 ≤ c_pv + c_bf + c_cp + R⁻¹ * c_cp := by positivity
    dsimp [c₁]; linarith
  have hc_bf_le : c_bf ≤ c₁ := by
    have : 0 ≤ c_pv + c_cb + c_cp + R⁻¹ * c_cp := by positivity
    dsimp [c₁]; linarith
  have hc_cp_le : c_cp ≤ c₁ := by
    have : 0 ≤ c_pv + c_cb + c_bf + R⁻¹ * c_cp := by positivity
    dsimp [c₁]; linarith
  have hexp1 : Real.exp (-Real.sqrt (Real.log X) / c_pv) ≤ Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc_pv_pos hc_pv_le
  have hexp2 : Real.exp (-Real.sqrt (Real.log X) / c_cb) ≤ Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc_cb_pos hc_cb_le
  have hexp3 : Real.exp (-Real.sqrt (Real.log X) / c_bf) ≤ Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc_bf_pos hc_bf_le
  have hexp4 : Real.exp (-Real.sqrt (Real.log X) / c_cp) ≤ Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc_cp_pos hc_cp_le
  have hterm1 : ‖S₂ - S₁‖ ≤ c_pv * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    calc ‖S₂ - S₁‖ ≤ c_pv * Y * Real.exp (-Real.sqrt (Real.log X) / c_pv) := h1
      _ ≤ c_pv * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) :=
        mul_le_mul_of_nonneg_left hexp1 (by positivity)
  have hterm2 : ‖S₂ - (τ : ℂ) * S₃‖ ≤ c_cb * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    calc ‖S₂ - (τ : ℂ) * S₃‖ ≤ c_cb * Y * Real.exp (-Real.sqrt (Real.log X) / c_cb) := h2
      _ ≤ c_cb * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) :=
        mul_le_mul_of_nonneg_left hexp2 (by positivity)
  have hterm3 : ‖S₃ - ((R⁻¹ : ℝ) : ℂ) * S₄‖ ≤ c_bf * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    calc ‖S₃ - ((R⁻¹ : ℝ) : ℂ) * S₄‖ ≤ c_bf * Y * Real.exp (-Real.sqrt (Real.log X) / c_bf) := h3
      _ ≤ c_bf * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) :=
        mul_le_mul_of_nonneg_left hexp3 (by positivity)
  have hterm4 : R⁻¹ * ‖S₅ - S₄‖ ≤ (R⁻¹ * c_cp) * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    calc R⁻¹ * ‖S₅ - S₄‖ ≤ R⁻¹ * (c_cp * Y * Real.exp (-Real.sqrt (Real.log X) / c_cp)) :=
          mul_le_mul_of_nonneg_left h4 (by positivity)
      _ ≤ R⁻¹ * (c_cp * Y * Real.exp (-Real.sqrt (Real.log X) / c₁)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp4 (by positivity)) (by positivity)
      _ = (R⁻¹ * c_cp) * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := by ring
  have h_sum_le :
      c_pv * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) +
      c_cb * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) +
      c_bf * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) +
      (R⁻¹ * c_cp) * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) ≤
      c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    have h_coeff : c_pv + c_cb + c_bf + R⁻¹ * c_cp ≤ c₁ := by
      have : 0 ≤ c_cp := by positivity
      dsimp [c₁]; linarith
    have hYE_nonneg : 0 ≤ Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := by positivity
    calc c_pv * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) +
        c_cb * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) +
        c_bf * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) +
        (R⁻¹ * c_cp) * Y * Real.exp (-Real.sqrt (Real.log X) / c₁)
      _ = (c_pv + c_cb + c_bf + R⁻¹ * c_cp) * (Y * Real.exp (-Real.sqrt (Real.log X) / c₁)) := by ring
      _ ≤ c₁ * (Y * Real.exp (-Real.sqrt (Real.log X) / c₁)) := mul_le_mul_of_nonneg_right h_coeff hYE_nonneg
      _ = c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := by ring
  linarith

theorem mitsui_prime_char_fundamentalCone_eq_zero_of_torsion_ne_one {K : Type u} [Field K] [NumberField K]
    (X : ℝ)
    (q : Ideal (NumberField.RingOfIntegers K))
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ)
    (hψ_tors : ∃ u ∈ NumberField.Units.torsion K,
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) ≠ 1) :
    (∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          NumberField.mixedEmbedding K (π : K) ∈
            NumberField.mixedEmbedding.fundamentalCone K ∧
          NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤
            X ^ (Module.finrank ℚ K) ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)) = 0 :=
by
  obtain ⟨u, hu_tors, hu_ne⟩ := hψ_tors
  have hu_inv_tors : u⁻¹ ∈ NumberField.Units.torsion K :=
    Subgroup.inv_mem (NumberField.Units.torsion K) hu_tors
  let D := {π : NumberField.RingOfIntegers K //
    Prime π ∧
    NumberField.mixedEmbedding K (π : K) ∈
      NumberField.mixedEmbedding.fundamentalCone K ∧
    NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤
      X ^ (Module.finrank ℚ K) ∧
    IsUnit (Ideal.Quotient.mk q π)}
  have h_smul (v : (NumberField.RingOfIntegers K)ˣ) (π : NumberField.RingOfIntegers K) :
      NumberField.mixedEmbedding K (((v : NumberField.RingOfIntegers K) * π : NumberField.RingOfIntegers K) : K) =
        v • NumberField.mixedEmbedding K (π : K) := by
    rw [NumberField.mixedEmbedding.unitSMul_smul, ← map_mul]
    rfl
  have h_mem (v : (NumberField.RingOfIntegers K)ˣ) (hv : v ∈ NumberField.Units.torsion K) (π : D) :
      Prime ((v : NumberField.RingOfIntegers K) * π.1) ∧
      NumberField.mixedEmbedding K (((v : NumberField.RingOfIntegers K) * π.1 : NumberField.RingOfIntegers K) : K) ∈
        NumberField.mixedEmbedding.fundamentalCone K ∧
      NumberField.mixedEmbedding.norm
        (NumberField.mixedEmbedding K (((v : NumberField.RingOfIntegers K) * π.1 : NumberField.RingOfIntegers K) : K)) ≤
        X ^ (Module.finrank ℚ K) ∧
      IsUnit (Ideal.Quotient.mk q ((v : NumberField.RingOfIntegers K) * π.1)) := by
    refine ⟨?_, ?_, ?_, ?_⟩
    · exact (associated_unit_mul_left π.1 (v : NumberField.RingOfIntegers K) v.isUnit).prime_iff.mpr π.2.1
    · rw [h_smul]
      exact (NumberField.mixedEmbedding.fundamentalCone.unit_smul_mem_iff_mem_torsion π.2.2.1 v).mpr hv
    · rw [h_smul, NumberField.mixedEmbedding.norm_unit_smul]
      exact π.2.2.2.1
    · rw [map_mul]
      exact IsUnit.mul (v.isUnit.map (Ideal.Quotient.mk q)) π.2.2.2.2
  let e : D ≃ D :=
    { toFun := fun π => ⟨(u : NumberField.RingOfIntegers K) * π.1, h_mem u hu_tors π⟩
      invFun := fun π => ⟨((u⁻¹ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * π.1,
        h_mem u⁻¹ hu_inv_tors π⟩
      left_inv := fun π => Subtype.ext (Units.inv_mul_cancel_left u π.1)
      right_inv := fun π => Subtype.ext (Units.mul_inv_cancel_left u π.1) }
  let u_bar : (NumberField.RingOfIntegers K ⧸ q)ˣ :=
    Units.map (Ideal.Quotient.mk q).toMonoidHom u
  let F : D → ℂ := fun π =>
    ψ (Additive.ofMul π.2.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  have hF_eq (π : D) : F (e π) = ψ (Additive.ofMul u_bar) * F π := by
    dsimp [F]
    have h_unit : (e π).2.2.2.2.unit = u_bar * π.2.2.2.2.unit := by
      apply Units.ext
      change ((e π).2.2.2.2.unit : NumberField.RingOfIntegers K ⧸ q) =
        (u_bar : NumberField.RingOfIntegers K ⧸ q) * (π.2.2.2.2.unit : NumberField.RingOfIntegers K ⧸ q)
      rw [IsUnit.unit_spec, IsUnit.unit_spec]
      change Ideal.Quotient.mk q ((u : NumberField.RingOfIntegers K) * π.1) =
        Ideal.Quotient.mk q (u : NumberField.RingOfIntegers K) * Ideal.Quotient.mk q π.1
      exact map_mul (Ideal.Quotient.mk q) (u : NumberField.RingOfIntegers K) π.1
    have h_norm : (Algebra.norm ℤ ((e π : D) : NumberField.RingOfIntegers K)).natAbs =
        (Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs := by
      change (Algebra.norm ℤ ((u : NumberField.RingOfIntegers K) * π.1)).natAbs =
        (Algebra.norm ℤ π.1).natAbs
      rw [map_mul, Int.natAbs_mul, Int.natAbs_of_isUnit (u.isUnit.map (Algebra.norm ℤ)), one_mul]
    rw [h_unit, ofMul_mul, AddChar.map_add_eq_mul, h_norm, mul_assoc]
  set S : ℂ := ∑' π : D, F π
  have hS_eq : ψ (Additive.ofMul u_bar) * S = S := by
    calc ψ (Additive.ofMul u_bar) * S
      _ = ∑' π : D, ψ (Additive.ofMul u_bar) * F π := (tsum_mul_left).symm
      _ = ∑' π : D, F (e π) := by simp_rw [← hF_eq]
      _ = S := Equiv.tsum_eq e F
  have h_sub : (ψ (Additive.ofMul u_bar) - 1) * S = 0 := by
    rw [sub_mul, one_mul, sub_eq_zero]
    exact hS_eq
  rcases mul_eq_zero.mp h_sub with h_zero | hS_zero
  · exact False.elim (hu_ne (sub_eq_zero.mp h_zero))
  · exact hS_zero

theorem mitsui_prime_char_fundamentalCone_bound {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c₃ : ℝ, 0 < c₃ ∧
      ∀ X : ℝ, 1 < X →
        ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
          (Ideal.absNorm q : ℝ) < Real.log X ^ A →
          ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
            ‖∑' π : {π : NumberField.RingOfIntegers K //
                  Prime π ∧
                  NumberField.mixedEmbedding K (π : K) ∈
                    NumberField.mixedEmbedding.fundamentalCone K ∧
                  NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤
                    X ^ (Module.finrank ℚ K) ∧
                  IsUnit (Ideal.Quotient.mk q π)},
                ψ (Additive.ofMul π.2.2.2.2.unit) *
                  (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)‖
              ≤ c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃) :=
by
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_prime_char_fundamentalCone_bound_of_units_eq_one (K := K) A hA
  obtain ⟨c₂, hc₂_pos, hc₂⟩ := mitsui_prime_char_fundamentalCone_bound_of_torsion_eq_one_of_units_ne_one (K := K) A hA
  let c₃ : ℝ := c₁ + c₂
  have hc₃_pos : 0 < c₃ := by dsimp [c₃]; positivity
  refine ⟨c₃, hc₃_pos, ?_⟩
  intro X hX q hq hq_norm ψ hψ
  have hX_pos : (0 : ℝ) < X := by linarith
  have hY_nonneg : 0 ≤ X ^ (Module.finrank ℚ K) := by positivity
  have hsqrt_nonneg : 0 ≤ Real.sqrt (Real.log X) := Real.sqrt_nonneg _
  have hc₁_le : c₁ ≤ c₃ := by dsimp [c₃]; linarith
  have hc₂_le : c₂ ≤ c₃ := by dsimp [c₃]; linarith
  have hexp₁ : Real.exp (-Real.sqrt (Real.log X) / c₁) ≤ Real.exp (-Real.sqrt (Real.log X) / c₃) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₁_pos hc₁_le
  have hexp₂ : Real.exp (-Real.sqrt (Real.log X) / c₂) ≤ Real.exp (-Real.sqrt (Real.log X) / c₃) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₂_pos hc₂_le
  by_cases h_tors : ∃ u ∈ NumberField.Units.torsion K,
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) ≠ 1
  · rw [mitsui_prime_char_fundamentalCone_eq_zero_of_torsion_ne_one X q ψ h_tors, norm_zero]
    positivity
  · push_neg at h_tors
    by_cases h_units : ∀ u : (NumberField.RingOfIntegers K)ˣ,
        ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1
    · have h1 := hc₁ X hX q hq hq_norm ψ hψ h_units
      have hterm₁ : c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁) ≤
          c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃) := by
        calc c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁)
          _ ≤ c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃) :=
            mul_le_mul_of_nonneg_left hexp₁ (by positivity)
          _ ≤ c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃) := by
            have : 0 ≤ X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃) := by positivity
            nlinarith
      exact le_trans h1 hterm₁
    · push_neg at h_units
      have h2 := hc₂ X hX q hq hq_norm ψ hψ h_tors h_units
      have hterm₂ : c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₂) ≤
          c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃) := by
        calc c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₂)
          _ ≤ c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₂) := le_rfl
          _ ≤ c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃) :=
            mul_le_mul_of_nonneg_left hexp₂ (by positivity)
          _ ≤ c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃) := by
            have : 0 ≤ X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃) := by positivity
            nlinarith
      exact le_trans h2 hterm₂

theorem mitsui_vonMangoldt_nonprincipal_char_bound {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (A : ℕ) (hA : 1 < A) :
    ∃ c₂ : ℝ, 0 < c₂ ∧
      ∀ X : ℝ, 1 < X →
        ∀ C : Set (NumberField.mixedEmbedding.mixedSpace K), Convex ℝ C → IsOpen C →
          (∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
              NumberField.mixedEmbedding.normAtPlace w z < X) →
          ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
            (Ideal.absNorm q : ℝ) < Real.log X ^ A →
            ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
              ‖∑' x : {x : NumberField.RingOfIntegers K //
                    NumberField.mixedEmbedding K (x : K) ∈ C ∧
                    IsUnit (Ideal.Quotient.mk q x)},
                  ψ (Additive.ofMul x.2.2.unit) *
                    (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ)‖
                ≤ c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
by
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_vonMangoldt_char_convex_to_fundamentalCone (K := K) A hA
  obtain ⟨c₀, hc₀_pos, hc₀⟩ := mitsui_vonMangoldt_char_cone_to_prime (K := K)
  obtain ⟨c₃, hc₃_pos, hc₃⟩ := mitsui_prime_char_fundamentalCone_bound (K := K) A hA
  set F : ℝ := (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
  set R : ℝ := NumberField.Units.regulator K
  have hF_pos : 0 < F := by
    change (0 : ℝ) < (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
    have h1 := NumberField.mixedEmbedding.one_le_convexBodyLTFactor K
    exact_mod_cast lt_of_lt_of_le zero_lt_one h1
  have hR_pos : 0 < R := NumberField.Units.regulator_pos K
  let c₂ : ℝ := c₁ + c₀ + c₃ + R⁻¹ * c₀ + R⁻¹ * c₃
  have hc₂_pos : 0 < c₂ := by
    dsimp [c₂]
    positivity
  refine ⟨c₂, hc₂_pos, ?_⟩
  intro X hX C hC_conv hC_open hC_bdd q hq hq_norm ψ hψ
  
  have hX0 : 0 ≤ X := by linarith
  let f : NumberField.InfinitePlace K → NNReal := fun _ => ⟨X, hX0⟩
  have hC_sub : C ⊆ NumberField.mixedEmbedding.convexBodyLT K f := by
    intro z hz
    rw [NumberField.mixedEmbedding.convexBodyLT, Set.mem_prod, Set.mem_univ_pi, Set.mem_univ_pi]
    refine ⟨fun w => ?_, fun w => ?_⟩
    · rw [Metric.mem_ball, dist_zero_right, ← NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2]
      exact hC_bdd z hz w.1
    · rw [Metric.mem_ball, dist_zero_right, ← NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex w.2]
      exact hC_bdd z hz w.1
  have hvol_le : MeasureTheory.volume C ≤
      MeasureTheory.volume (NumberField.mixedEmbedding.convexBodyLT K f) :=
    MeasureTheory.measure_mono hC_sub
  have hvol_eq : MeasureTheory.volume (NumberField.mixedEmbedding.convexBodyLT K f) =
      ↑(NumberField.mixedEmbedding.convexBodyLTFactor K) * ↑(∏ w, f w ^ w.mult) := by
    convert NumberField.mixedEmbedding.convexBodyLT_volume K f
  rw [hvol_eq] at hvol_le
  have hprod : (∏ w : NumberField.InfinitePlace K, f w ^ w.mult) =
      ⟨X, hX0⟩ ^ (Module.finrank ℚ K) := by
    dsimp [f]
    rw [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq]
  rw [hprod] at hvol_le
  have hne_top : (↑(NumberField.mixedEmbedding.convexBodyLTFactor K) *
      ↑(⟨X, hX0⟩ ^ (Module.finrank ℚ K) : NNReal) : ENNReal) ≠ ⊤ :=
    ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.coe_ne_top
  have hV_le : (MeasureTheory.volume C).toReal ≤ F * X ^ (Module.finrank ℚ K) := by
    have htoReal := ENNReal.toReal_mono hne_top hvol_le
    rw [ENNReal.toReal_mul, ENNReal.coe_toReal, ENNReal.coe_toReal, NNReal.coe_pow, NNReal.coe_mk] at htoReal
    exact htoReal
  
  set Y : ℝ := X ^ (Module.finrank ℚ K)
  set V : ℝ := (MeasureTheory.volume C).toReal
  have hX_pos : 0 < X := by linarith
  have hY_pos : 0 < Y := by dsimp [Y]; positivity
  have hV_nonneg : 0 ≤ V := ENNReal.toReal_nonneg
  set ρ : ℝ := V / (F * R * Y)
  have hρ_nonneg : 0 ≤ ρ := by dsimp [ρ]; positivity
  have hρ_le : ρ ≤ R⁻¹ := by
    dsimp [ρ]
    rw [div_le_iff₀ (by positivity)]
    have h1 : R⁻¹ * (F * R * Y) = F * Y := by
      have hR_ne : R ≠ 0 := ne_of_gt hR_pos
      field_simp [hR_ne]
    rw [h1]
    exact hV_le
  have h1 := hc₁ X hX C hC_conv hC_open hC_bdd q hq hq_norm ψ hψ
  have h2 := hc₀ X hX q hq ψ
  have h3 := hc₃ X hX q hq hq_norm ψ hψ
  set S₁ : ℂ := ∑' x : {x : NumberField.RingOfIntegers K //
      NumberField.mixedEmbedding K (x : K) ∈ C ∧
      IsUnit (Ideal.Quotient.mk q x)},
    ψ (Additive.ofMul x.2.2.unit) *
      (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ)
  set S₂ : ℂ := ∑' x : {x : NumberField.RingOfIntegers K //
      NumberField.mixedEmbedding K (x : K) ∈
        NumberField.mixedEmbedding.fundamentalCone K ∧
      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) ≤ Y ∧
      IsUnit (Ideal.Quotient.mk q x)},
    ψ (Additive.ofMul x.2.2.2.unit) *
      (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ)
  set S₃ : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      NumberField.mixedEmbedding K (π : K) ∈
        NumberField.mixedEmbedding.fundamentalCone K ∧
      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤ Y ∧
      IsUnit (Ideal.Quotient.mk q π)},
    ψ (Additive.ofMul π.2.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  have h_ident : S₁ = (S₁ - (ρ : ℂ) * S₂) + (ρ : ℂ) * (S₂ - S₃) + (ρ : ℂ) * S₃ := by ring
  have h_tri : ‖S₁‖ ≤ ‖S₁ - (ρ : ℂ) * S₂‖ + R⁻¹ * ‖S₂ - S₃‖ + R⁻¹ * ‖S₃‖ := by
    rw [congrArg norm h_ident]
    have ht1 := norm_add_le ((S₁ - (ρ : ℂ) * S₂) + (ρ : ℂ) * (S₂ - S₃)) ((ρ : ℂ) * S₃)
    have ht2 := norm_add_le (S₁ - (ρ : ℂ) * S₂) ((ρ : ℂ) * (S₂ - S₃))
    have hm2 : ‖(ρ : ℂ) * (S₂ - S₃)‖ ≤ R⁻¹ * ‖S₂ - S₃‖ := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hρ_nonneg]
      exact mul_le_mul_of_nonneg_right hρ_le (norm_nonneg _)
    have hm3 : ‖(ρ : ℂ) * S₃‖ ≤ R⁻¹ * ‖S₃‖ := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hρ_nonneg]
      exact mul_le_mul_of_nonneg_right hρ_le (norm_nonneg _)
    linarith
  have hsqrt_nonneg : 0 ≤ Real.sqrt (Real.log X) := Real.sqrt_nonneg _
  have hc₁_le : c₁ ≤ c₂ := by
    have : 0 ≤ c₀ + c₃ + R⁻¹ * c₀ + R⁻¹ * c₃ := by positivity
    dsimp [c₂]; linarith
  have hc₀_le : c₀ ≤ c₂ := by
    have : 0 ≤ c₁ + c₃ + R⁻¹ * c₀ + R⁻¹ * c₃ := by positivity
    dsimp [c₂]; linarith
  have hc₃_le : c₃ ≤ c₂ := by
    have : 0 ≤ c₁ + c₀ + R⁻¹ * c₀ + R⁻¹ * c₃ := by positivity
    dsimp [c₂]; linarith
  have hexp1 : Real.exp (-Real.sqrt (Real.log X) / c₁) ≤ Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₁_pos hc₁_le
  have hexp2 : Real.exp (-Real.sqrt (Real.log X) / c₀) ≤ Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₀_pos hc₀_le
  have hexp3 : Real.exp (-Real.sqrt (Real.log X) / c₃) ≤ Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₃_pos hc₃_le
  have hterm1 : ‖S₁ - (ρ : ℂ) * S₂‖ ≤ c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    calc ‖S₁ - (ρ : ℂ) * S₂‖ ≤ c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) := h1
      _ ≤ c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
        mul_le_mul_of_nonneg_left hexp1 (by positivity)
  have hterm2 : R⁻¹ * ‖S₂ - S₃‖ ≤ (R⁻¹ * c₀) * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    calc R⁻¹ * ‖S₂ - S₃‖ ≤ R⁻¹ * (c₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₀)) :=
          mul_le_mul_of_nonneg_left h2 (by positivity)
      _ ≤ R⁻¹ * (c₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp2 (by positivity)) (by positivity)
      _ = (R⁻¹ * c₀) * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := by ring
  have hterm3 : R⁻¹ * ‖S₃‖ ≤ (R⁻¹ * c₃) * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    calc R⁻¹ * ‖S₃‖ ≤ R⁻¹ * (c₃ * Y * Real.exp (-Real.sqrt (Real.log X) / c₃)) :=
          mul_le_mul_of_nonneg_left h3 (by positivity)
      _ ≤ R⁻¹ * (c₃ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp3 (by positivity)) (by positivity)
      _ = (R⁻¹ * c₃) * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := by ring
  have h_sum_le :
      c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) +
      (R⁻¹ * c₀) * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) +
      (R⁻¹ * c₃) * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) ≤
      c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := by
    have h_coeff : c₁ + R⁻¹ * c₀ + R⁻¹ * c₃ ≤ c₂ := by
      have : 0 ≤ c₀ + c₃ := by positivity
      dsimp [c₂]; linarith
    have hYE_nonneg : 0 ≤ Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := by positivity
    calc c₁ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) +
        (R⁻¹ * c₀) * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) +
        (R⁻¹ * c₃) * Y * Real.exp (-Real.sqrt (Real.log X) / c₂)
      _ = (c₁ + R⁻¹ * c₀ + R⁻¹ * c₃) * (Y * Real.exp (-Real.sqrt (Real.log X) / c₂)) := by ring
      _ ≤ c₂ * (Y * Real.exp (-Real.sqrt (Real.log X) / c₂)) := mul_le_mul_of_nonneg_right h_coeff hYE_nonneg
      _ = c₂ * Y * Real.exp (-Real.sqrt (Real.log X) / c₂) := by ring
  linarith

theorem mitsui_prime_equidist_mod_q {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (A : ℕ) (hA : 1 < A) :
    ∃ c₁ : ℝ, 0 < c₁ ∧
      ∀ X : ℝ, 1 < X →
        ∀ C : Set (NumberField.mixedEmbedding.mixedSpace K), Convex ℝ C → IsOpen C →
          (∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
              NumberField.mixedEmbedding.normAtPlace w z < X) →
          ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
            (Ideal.absNorm q : ℝ) < Real.log X ^ A →
            ∀ α : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk q α) →
              |(∑' π : {π : NumberField.RingOfIntegers K //
                    Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C ∧ π - α ∈ q},
                  Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
                - ((Nat.card (NumberField.RingOfIntegers K ⧸ q)ˣ : ℝ))⁻¹ *
                  (∑' π : {π : NumberField.RingOfIntegers K //
                      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C ∧
                      IsUnit (Ideal.Quotient.mk q π)},
                    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))|
                ≤ c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁) :=
by
  obtain ⟨c₃, hc₃_pos, hc₃⟩ := mitsui_prime_to_vonMangoldt_unconditioned (K := K)
  obtain ⟨c₂, hc₂_pos, hc₂⟩ := mitsui_vonMangoldt_nonprincipal_char_bound (K := K) A hA
  let c₁ : ℝ := 2 * c₃ + c₂
  have hc₁_pos : 0 < c₁ := by dsimp [c₁]; linarith
  refine ⟨c₁, hc₁_pos, ?_⟩
  intro X hX C hC_conv hC_open hC_bdd q hq hq_norm α hα
  let φ : ℝ := (Nat.card (NumberField.RingOfIntegers K ⧸ q)ˣ : ℝ)
  have hq_bot : q ≠ ⊥ := hq
  haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
    Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
  have hcard_pos : 0 < Nat.card (NumberField.RingOfIntegers K ⧸ q)ˣ := Nat.card_pos
  have hφ_ge_one : 1 ≤ φ := by
    dsimp [φ]
    exact_mod_cast hcard_pos
  have hφ_inv_nonneg : 0 ≤ φ⁻¹ := by positivity
  have hφ_inv_le_one : φ⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hφ_ge_one
  have hu := hc₃ X hX C hC_conv hC_open hC_bdd
  have hf1 := mitsui_prime_to_vonMangoldt_filter_le (K := K) X hX C hC_bdd
    (fun x => (x : NumberField.RingOfIntegers K) - α ∈ q)
  have hf2 := mitsui_prime_to_vonMangoldt_filter_le (K := K) X hX C hC_bdd
    (fun x => IsUnit (Ideal.Quotient.mk q x))
  let B : ℝ := c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₂)
  have hX_nonneg : (0 : ℝ) ≤ X := by linarith
  have hB_nonneg : 0 ≤ B := by
    dsimp [B]
    positivity
  have hchar : ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
      ‖∑' x : {x : NumberField.RingOfIntegers K //
            NumberField.mixedEmbedding K (x : K) ∈ C ∧
            IsUnit (Ideal.Quotient.mk q x)},
          ψ (Additive.ofMul x.2.2.unit) *
            (vonMangoldtO (x : NumberField.RingOfIntegers K) : ℂ)‖ ≤ B := by
    intro ψ hψ
    exact hc₂ X hX C hC_conv hC_open hC_bdd q hq hq_norm ψ hψ
  have heq := mitsui_vonMangoldt_equidist_of_char_bound (K := K) X hX C hC_bdd q hq α hα B hB_nonneg hchar
  set S₁ : ℝ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C ∧ π - α ∈ q},
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  set S₂ : ℝ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C ∧
      IsUnit (Ideal.Quotient.mk q π)},
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  set T₁ : ℝ := ∑' x : {x : NumberField.RingOfIntegers K //
      NumberField.mixedEmbedding K (x : K) ∈ C ∧ (x : NumberField.RingOfIntegers K) - α ∈ q},
    vonMangoldtO (x : NumberField.RingOfIntegers K)
  set T₂ : ℝ := ∑' x : {x : NumberField.RingOfIntegers K //
      NumberField.mixedEmbedding K (x : K) ∈ C ∧
      IsUnit (Ideal.Quotient.mk q x)},
    vonMangoldtO (x : NumberField.RingOfIntegers K)
  have h_ident : S₁ - φ⁻¹ * S₂ = (S₁ - T₁) + (T₁ - φ⁻¹ * T₂) + φ⁻¹ * (T₂ - S₂) := by ring
  have h_tri : |S₁ - φ⁻¹ * S₂| ≤ |S₁ - T₁| + |T₁ - φ⁻¹ * T₂| + |S₂ - T₂| := by
    rw [h_ident]
    have ht1 := abs_add_le ((S₁ - T₁) + (T₁ - φ⁻¹ * T₂)) (φ⁻¹ * (T₂ - S₂))
    have ht2 := abs_add_le (S₁ - T₁) (T₁ - φ⁻¹ * T₂)
    have hm : |φ⁻¹ * (T₂ - S₂)| ≤ |S₂ - T₂| := by
      rw [abs_mul, abs_of_nonneg hφ_inv_nonneg, abs_sub_comm T₂ S₂]
      exact mul_le_of_le_one_left (abs_nonneg _) hφ_inv_le_one
    linarith
  have hsqrt_nonneg : 0 ≤ Real.sqrt (Real.log X) := Real.sqrt_nonneg _
  have hexp3 : Real.exp (-Real.sqrt (Real.log X) / c₃) ≤ Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₃_pos (by dsimp [c₁]; linarith)
  have hexp2 : Real.exp (-Real.sqrt (Real.log X) / c₂) ≤ Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hsqrt_nonneg hc₂_pos (by dsimp [c₁]; linarith)
  have hterm3 : c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₃) ≤
      c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    exact mul_le_mul_of_nonneg_left hexp3 (by positivity)
  have hterm2 : B ≤
      c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    dsimp [B]
    exact mul_le_mul_of_nonneg_left hexp2 (by positivity)
  have hsum :
      2 * (c₃ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁)) +
      c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁) =
      c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    dsimp [c₁]
    ring
  linarith

theorem mitsui_prime_coprime_to_all {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (A : ℕ) (hA : 1 < A) :
    ∃ c₂ : ℝ, 0 < c₂ ∧
      ∀ X : ℝ, 1 < X →
        ∀ C : Set (NumberField.mixedEmbedding.mixedSpace K), Convex ℝ C → IsOpen C →
          (∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
              NumberField.mixedEmbedding.normAtPlace w z < X) →
          ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
            (Ideal.absNorm q : ℝ) < Real.log X ^ A →
            |(∑' π : {π : NumberField.RingOfIntegers K //
                  Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C ∧
                  IsUnit (Ideal.Quotient.mk q π)},
                Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
              - (∑' π : {π : NumberField.RingOfIntegers K //
                    Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C},
                  Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))|
              ≤ c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
by
  rename_i inst_real inst_complex
  clear inst_real inst_complex
  classical
  letI : VAdd (NumberField.mixedEmbedding.integerLattice K)
    (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.vaddSet
  letI : VAdd (NumberField.mixedEmbedding.mixedSpace K)
    (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.vaddSet
  
  have h_s1 : ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
      1 ≤ Ideal.absNorm q ∧
      ∀ π : NumberField.RingOfIntegers K, Prime π → ¬ IsUnit (Ideal.Quotient.mk q π) →
        (Algebra.norm ℤ π).natAbs ≤ Ideal.absNorm q := by
    intro q hq
    have hq_bot : q ≠ ⊥ := hq
    have hnorm_ne : Ideal.absNorm q ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hq_bot
    refine ⟨Nat.one_le_iff_ne_zero.mpr hnorm_ne, ?_⟩
    intro π hπ hnu
    have hπ_ne : π ≠ 0 := hπ.ne_zero
    have hspan_ne : Ideal.span {π} ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr hπ_ne
    have hprime : (Ideal.span {π}).IsPrime := (Ideal.span_singleton_prime hπ_ne).mpr hπ
    have hmax : (Ideal.span {π}).IsMaximal := Ideal.IsPrime.isMaximal hprime hspan_ne
    have hle : q ≤ Ideal.span {π} := by
      by_contra hnotle
      obtain ⟨y, hyq, hynot⟩ := SetLike.not_le_iff_exists.mp hnotle
      have h1 : (1 : NumberField.RingOfIntegers K) ∈ Ideal.span {π} ⊔ q :=
        (Ideal.isMaximal_iff.mp hmax).2 (Ideal.span {π} ⊔ q) y le_sup_left hynot (Ideal.mem_sup_right hyq)
      obtain ⟨u, hu, v, hv, huv⟩ := Submodule.mem_sup.mp h1
      obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton.mp hu
      apply hnu
      have hmk : Ideal.Quotient.mk q (π * r + v) = Ideal.Quotient.mk q 1 := congrArg (Ideal.Quotient.mk q) huv
      rw [map_add, map_mul, map_one, Ideal.Quotient.eq_zero_iff_mem.mpr hv, add_zero] at hmk
      exact IsUnit.of_mul_eq_one (Ideal.Quotient.mk q r) hmk
    have hdvd : Ideal.absNorm (Ideal.span {π}) ∣ Ideal.absNorm q :=
      Ideal.absNorm_dvd_absNorm_of_le hle
    rw [Ideal.absNorm_span_singleton] at hdvd
    exact Nat.le_of_dvd (Nat.pos_of_ne_zero hnorm_ne) hdvd
  
  have h_s2 : ∀ (X Y : ℝ), 1 < X → 1 ≤ Y →
      ∀ (C : Set (NumberField.mixedEmbedding.mixedSpace K)),
        (∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
            NumberField.mixedEmbedding.normAtPlace w z < X) →
        ∀ (U : NumberField.RingOfIntegers K → Prop),
          (∀ π : NumberField.RingOfIntegers K, Prime π →
              NumberField.mixedEmbedding K (π : K) ∈ C → ¬ U π →
              ((Algebra.norm ℤ π).natAbs : ℝ) < Y) →
          |(∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C ∧ U π},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
            - (∑' π : {π : NumberField.RingOfIntegers K //
                  Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C},
                Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))|
            ≤ (Nat.card {x : NumberField.RingOfIntegers K //
                (∀ w : NumberField.InfinitePlace K, w (x : K) < X) ∧
                ((Algebra.norm ℤ x).natAbs : ℝ) < Y} : ℝ) * Real.log Y := by
    intro X Y hX hY C hC_bdd U hU
    let B_X : Set (NumberField.RingOfIntegers K) :=
      {x | ∀ w : NumberField.InfinitePlace K, w (x : K) < X}
    have hBX_fin : B_X.Finite := by
      have hBK_fin : {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}.Finite :=
        NumberField.Embeddings.finite_of_norm_le K ℂ X
      have hsub : B_X ⊆ (Subtype.val : NumberField.RingOfIntegers K → K) ⁻¹'
          {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X} := by
        intro x hx
        refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, fun φ => ?_⟩
        have hφ : (NumberField.InfinitePlace.mk φ) (x : K) = ‖φ (x : K)‖ :=
          NumberField.InfinitePlace.apply φ (x : K)
        have hxφ : (NumberField.InfinitePlace.mk φ) (x : K) < X := hx (NumberField.InfinitePlace.mk φ)
        change ‖φ (x : K)‖ ≤ X
        linarith
      exact (hBK_fin.preimage Subtype.val_injective.injOn).subset hsub
    have hC_sub_BX : ∀ x : NumberField.RingOfIntegers K,
        NumberField.mixedEmbedding K (x : K) ∈ C → x ∈ B_X := by
      intro x hx w
      have h1 := hC_bdd _ hx w
      rwa [NumberField.mixedEmbedding.normAtPlace_apply] at h1
    let P : Set (NumberField.RingOfIntegers K) :=
      {π | Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C ∧ U π}
    let Q : Set (NumberField.RingOfIntegers K) :=
      {π | Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C}
    let R : Set (NumberField.RingOfIntegers K) :=
      {π | Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C ∧ ¬ U π}
    let S : Set (NumberField.RingOfIntegers K) :=
      {x | (∀ w : NumberField.InfinitePlace K, w (x : K) < X) ∧ ((Algebra.norm ℤ x).natAbs : ℝ) < Y}
    have hP_fin : P.Finite := hBX_fin.subset (fun x hx => hC_sub_BX x hx.2.1)
    have hQ_fin : Q.Finite := hBX_fin.subset (fun x hx => hC_sub_BX x hx.2)
    have hR_fin : R.Finite := hBX_fin.subset (fun x hx => hC_sub_BX x hx.2.1)
    have hS_fin : S.Finite := hBX_fin.subset (fun x hx => hx.1)
    letI : Fintype P := hP_fin.fintype
    letI : Fintype Q := hQ_fin.fintype
    letI : Fintype S := hS_fin.fintype
    let g : NumberField.RingOfIntegers K → ℝ :=
      fun x => Real.log ((Algebra.norm ℤ x).natAbs : ℝ)
    have hsumP : (∑' π : P, g π) = ∑ π ∈ hP_fin.toFinset, g π := by
      rw [tsum_fintype]
      exact (Finset.sum_subtype hP_fin.toFinset (fun _ => hP_fin.mem_toFinset) g).symm
    have hsumQ : (∑' π : Q, g π) = ∑ π ∈ hQ_fin.toFinset, g π := by
      rw [tsum_fintype]
      exact (Finset.sum_subtype hQ_fin.toFinset (fun _ => hQ_fin.mem_toFinset) g).symm
    change |(∑' π : P, g π) - (∑' π : Q, g π)| ≤ (Nat.card S : ℝ) * Real.log Y
    rw [hsumP, hsumQ]
    have hP_sub_Q : hP_fin.toFinset ⊆ hQ_fin.toFinset := by
      intro x hx
      rw [Set.Finite.mem_toFinset] at hx ⊢
      exact ⟨hx.1, hx.2.1⟩
    have hQ_sdiff_P : hQ_fin.toFinset \ hP_fin.toFinset = hR_fin.toFinset := by
      ext x
      simp only [Finset.mem_sdiff, Set.Finite.mem_toFinset, P, Q, R, Set.mem_setOf_eq]
      tauto
    have h_sdiff := Finset.sum_sdiff hP_sub_Q (f := g)
    rw [hQ_sdiff_P] at h_sdiff
    have h_diff : (∑ π ∈ hP_fin.toFinset, g π) - (∑ π ∈ hQ_fin.toFinset, g π) =
        - (∑ π ∈ hR_fin.toFinset, g π) := by linarith
    rw [h_diff, abs_neg]
    have hg_nonneg : ∀ π ∈ hR_fin.toFinset, 0 ≤ g π := by
      intro π hπ
      rw [Set.Finite.mem_toFinset] at hπ
      have hπ_ne : π ≠ 0 := hπ.1.ne_zero
      have hnorm_ne : Algebra.norm ℤ π ≠ 0 := Algebra.norm_ne_zero_iff.mpr hπ_ne
      have hnat_pos : 1 ≤ (Algebra.norm ℤ π).natAbs :=
        Nat.one_le_iff_ne_zero.mpr (Int.natAbs_ne_zero.mpr hnorm_ne)
      exact Real.log_nonneg (by exact_mod_cast hnat_pos)
    have hg_le : ∀ π ∈ hR_fin.toFinset, g π ≤ Real.log Y := by
      intro π hπ
      rw [Set.Finite.mem_toFinset] at hπ
      have hπ_ne : π ≠ 0 := hπ.1.ne_zero
      have hnorm_ne : Algebra.norm ℤ π ≠ 0 := Algebra.norm_ne_zero_iff.mpr hπ_ne
      have hnat_pos : (0 : ℝ) < (Algebra.norm ℤ π).natAbs := by
        exact_mod_cast Int.natAbs_pos.mpr hnorm_ne
      exact Real.log_le_log hnat_pos (le_of_lt (hU π hπ.1 hπ.2.1 hπ.2.2))
    rw [abs_of_nonneg (Finset.sum_nonneg hg_nonneg)]
    have hR_sub_S : hR_fin.toFinset ⊆ hS_fin.toFinset := by
      intro π hπ
      rw [Set.Finite.mem_toFinset] at hπ ⊢
      exact ⟨hC_sub_BX π hπ.2.1, hU π hπ.1 hπ.2.1 hπ.2.2⟩
    have hcard_RS : hR_fin.toFinset.card ≤ hS_fin.toFinset.card :=
      Finset.card_le_card hR_sub_S
    have hcard_S : hS_fin.toFinset.card = Nat.card S := by
      rw [Nat.card_eq_fintype_card, Set.Finite.card_toFinset]
    calc ∑ π ∈ hR_fin.toFinset, g π
        ≤ ∑ _π ∈ hR_fin.toFinset, Real.log Y := Finset.sum_le_sum hg_le
      _ = (hR_fin.toFinset.card : ℝ) * Real.log Y := by
          rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ (Nat.card S : ℝ) * Real.log Y := by
          apply mul_le_mul_of_nonneg_right
          · rw [← hcard_S]
            exact_mod_cast hcard_RS
          · exact Real.log_nonneg hY
  
  have h_s3 : ∃ C₀ : ℝ, 0 < C₀ ∧
      ∀ X Y : ℝ, 1 < X → 1 ≤ Y →
        (Nat.card {x : NumberField.RingOfIntegers K //
            (∀ w : NumberField.InfinitePlace K, w (x : K) < X) ∧
            ((Algebra.norm ℤ x).natAbs : ℝ) < Y} : ℝ)
          ≤ C₀ * Y ^ 2 * X ^ (Module.finrank ℚ K - 1) := by
    let F : Set (NumberField.mixedEmbedding.mixedSpace K) :=
      ZSpan.fundamentalDomain (NumberField.mixedEmbedding.latticeBasis K)
    have hF_bdd : Bornology.IsBounded F :=
      ZSpan.fundamentalDomain_isBounded (NumberField.mixedEmbedding.latticeBasis K)
    obtain ⟨D, hD_gt1, hF_ball⟩ := hF_bdd.subset_ball_lt 1 0
    have hD_ge1 : 1 ≤ D := le_of_lt hD_gt1
    have hD_pos : 0 < D := by linarith
    have hF_norm : ∀ z ∈ F, ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < D := by
      intro z hz w
      have hz_norm : ‖z‖ < D := by
        have h1 := hF_ball hz
        rwa [Metric.mem_ball, dist_zero_right] at h1
      rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
      · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw z]
        have h1 : ‖z.1 ⟨w, hw⟩‖ ≤ ‖z.1‖ := norm_le_pi_norm z.1 ⟨w, hw⟩
        have h2 : ‖z.1‖ ≤ ‖z‖ := by
          rw [Prod.norm_def]
          exact le_max_left _ _
        exact lt_of_le_of_lt (le_trans h1 h2) hz_norm
      · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hw z]
        have h1 : ‖z.2 ⟨w, hw⟩‖ ≤ ‖z.2‖ := norm_le_pi_norm z.2 ⟨w, hw⟩
        have h2 : ‖z.2‖ ≤ ‖z‖ := by
          rw [Prod.norm_def]
