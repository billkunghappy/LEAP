theorem mitsui_grossenchar_heckeL_completed_entire_and_mellin_bound_of_unitLog_ne_one {K : Type u} [Field K] [NumberField K] :
    ∃ C₀ : ℝ, 0 < C₀ ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
        ∀ w₀ : NumberField.InfinitePlace K,
          ∀ a₀ : ℕ, a₀ < NumberField.Units.torsionOrder K →
            ∀ θ₀ : Fin (NumberField.Units.rank K) → ℝ,
              (∀ j : Fin (NumberField.Units.rank K), 0 ≤ θ₀ j ∧ θ₀ j < 1) →
              ∀ j₀ : Fin (NumberField.Units.rank K), 0 < θ₀ j₀ →
                ∀ (m_freq : Fin (NumberField.Units.rank K) → ℤ)
                  (l_ang : NumberField.InfinitePlace K → ℤ),
                  (∀ ζ ∈ NumberField.Units.torsion K,
                    (∏ w : NumberField.InfinitePlace K,
                      (w.embedding ((ζ : NumberField.RingOfIntegers K) : K)) ^ (l_ang w)) = 1) →
                  ∀ M : ℝ, 1 ≤ M →
                    (∀ j : Fin (NumberField.Units.rank K), |(m_freq j : ℝ)| ≤ Real.exp M) →
                    (∀ w : NumberField.InfinitePlace K, |(l_ang w : ℝ)| ≤ Real.exp M) →
                    ∀ χ_gr : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ,
                      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
                        ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ_gr I‖ = 1) ∧
                        (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ_gr I = 0)) →
                      (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
                        x - 1 ∈ q →
                        ∃ y : Fin (NumberField.Units.rank K) → ℝ,
                          (∀ w : NumberField.InfinitePlace K,
                            Real.log (w (x : K) / w₀ (x : K)) =
                              ∑ j : Fin (NumberField.Units.rank K),
                                y j *
                                  Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                                    w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) ∧
                          χ_gr ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
                            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
                            ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
                              Complex.exp
                                (((∑ j : Fin (NumberField.Units.rank K),
                                    y j *
                                      (2 * Real.pi * (θ₀ j - (m_freq j : ℝ)) +
                                        ∑ w : NumberField.InfinitePlace K,
                                          (l_ang w : ℝ) *
                                            (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg)) : ℝ) * Complex.I)) =
                            ∏ w : NumberField.InfinitePlace K,
                              (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w)) →
                      ∃ (B₀ : ℝ) (χ_dual : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ) (g_χ : ℂ → ℂ),
                        0 < B₀ ∧
                        (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ_dual I‖ ≤ 1) ∧
                        Differentiable ℂ g_χ ∧
                        (∀ s : ℂ, 1 < s.re →
                          g_χ s = LSeries (fun n =>
                            ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
                              χ_gr ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s) ∧
                        (∀ s : ℂ, s.re = -1 / 2 →
                          ‖(((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ (s / 2) *
                              (Complex.Gammaℝ s) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
                              (Complex.Gammaℂ s) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) * g_χ s‖ ≤
                            C₀ * (Ideal.absNorm q : ℝ) ^ 2 * (Real.exp M) ^ (Module.finrank ℚ K) *
                              ‖(((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ ((1 - s) / 2) *
                                  (Complex.Gammaℝ (1 - s)) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
                                  (Complex.Gammaℂ (1 - s)) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) *
                                LSeries (fun n =>
                                  ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
                                    χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) (1 - s)‖) ∧
