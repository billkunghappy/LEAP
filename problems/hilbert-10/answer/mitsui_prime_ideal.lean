    Finset.sum_congr rfl (fun C _ => h_per_C C)
  rw [h_sum_per_C, ← Finset.mul_sum]
  congr 1
  exact Equiv.sum_comp σ (fun C =>
    χ₀ (J_rep C) *
      (∫ y in Cube,
        (∑' x : (J_rep C : Ideal R),
          star (ψ_f (Ideal.Quotient.mk f x.1)) *
            (∏ w : NumberField.InfinitePlace K,
              ((if 0 ≤ l_eff w then star (w.embedding (x.1 : K)) else w.embedding (x.1 : K)) *
                ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) *
            ((((b_RHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
                (∑ w : NumberField.InfinitePlace K, a_place w) *
              Real.exp (-Real.pi * (b_RHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                ∑ w : NumberField.InfinitePlace K,
                  (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                    ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ) *
            E_torus y)))

theorem mitsui_primitive_grossenchar_sq_stripped_unitRank_posNeg_theta_inversion {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (l_eff : NumberField.InfinitePlace K → ℤ)
    (hl_eff_real : ∀ w : NumberField.InfinitePlace K, w.IsReal → l_eff w = 0)
    (v_place : NumberField.InfinitePlace K → ℝ)
    (hv_sum : (∑ w : NumberField.InfinitePlace K, v_place w) = 0)
    (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ₀_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖χ₀ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → χ₀ I = 0))
    (hχ₀_prin_eff : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ f →
