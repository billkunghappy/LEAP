      _ = M₀ * Real.exp (-((n : ℝ) / 2) * a) := by ring
  let η : ℝ := ((n : ℝ) * a₀) / (4 * ((A : ℝ) + 1))
  have hη_pos : 0 < η := by dsimp [η]; positivity
  have hη_ne : η ≠ 0 := ne_of_gt hη_pos
  let c : ℝ := ((n : ℝ) / 8) * a₀
  let C₀ : ℝ := P_f * P_K * S_f⁻¹ * (S_f ^ (1 / (n : ℝ))) ^ A * (η⁻¹) ^ A * M₀
  have hc_pos : 0 < c := by dsimp [c]; positivity
  have hC₀_pos : 0 < C₀ := by dsimp [C₀]; positivity
  refine ⟨C₀, c, α, hC₀_pos, hc_pos, hα_pos, hW_maj_meas, hW_maj_nn,
    hW₁_meas, hW₂_meas, hW₁_cont, hW₂_cont,
    fun t ht => ⟨hW₁_le t ht, hW₂_le t ht⟩, ?_⟩
  intro t ht
  have ht1 : 1 < t := Set.mem_Ioi.mp ht
  have ht_pos : 0 < t := lt_trans zero_lt_one ht1
  have ht_ge_one : 1 ≤ t := le_of_lt ht1
  have hτ_pos : 0 < S_f * t := mul_pos hSf_pos ht_pos
  dsimp only [W_maj, W₀_maj]
  rw [if_pos hτ_pos]
  have h_arg : Real.pi * (S_f * t) ^ α = a₀ * t ^ α := by
    rw [Real.mul_rpow (le_of_lt hSf_pos) (le_of_lt ht_pos)]
    dsimp [a₀]
    ring
  rw [h_arg]
  have htα_ge_one : 1 ≤ t ^ α := Real.one_le_rpow ht_ge_one (le_of_lt hα_pos)
  have htα_nn : 0 ≤ t ^ α := le_trans zero_le_one htα_ge_one
  have ha_ge : a₀ ≤ a₀ * t ^ α := le_mul_of_one_le_right (le_of_lt ha₀_pos) htα_ge_one
  have hJ_le := hJ_maj_bound (a₀ * t ^ α) ha_ge
  have ht_inv_le : (S_f * t)⁻¹ ≤ S_f⁻¹ := by
    rw [mul_inv]
    have ht1_inv : t⁻¹ ≤ 1 := inv_le_one_of_one_le₀ ht_ge_one
    calc S_f⁻¹ * t⁻¹ ≤ S_f⁻¹ * 1 := mul_le_mul_of_nonneg_left ht1_inv (by positivity)
      _ = S_f⁻¹ := mul_one _
  have h_rpow_le : t ^ (1 / (n : ℝ)) ≤ t ^ α := by
    refine Real.rpow_le_rpow_of_exponent_le ht_ge_one ?_
    dsimp [α]
    exact div_le_div_of_nonneg_right (by norm_num) (le_of_lt hn_pos)
  have htα_le_exp : t ^ α ≤ η⁻¹ * Real.exp (η * t ^ α) := by
    have h1 := Real.add_one_le_exp (η * t ^ α)
    have h2 : η * t ^ α ≤ Real.exp (η * t ^ α) := by linarith
    have h3 := mul_le_mul_of_nonneg_left h2 (le_of_lt (inv_pos.mpr hη_pos))
    have h_lhs : η⁻¹ * (η * t ^ α) = t ^ α := by
      field_simp [hη_ne]
    rwa [h_lhs] at h3
  have hAη_le : (A : ℝ) * η ≤ ((n : ℝ) / 4) * a₀ := by
    dsimp [η]
    rw [mul_div_assoc', div_le_iff₀ (by positivity)]
    have : (A : ℝ) ≤ (A : ℝ) + 1 := by linarith
    nlinarith
  have h_poly_le : ((S_f * t) ^ (1 / (n : ℝ))) ^ A ≤
      (S_f ^ (1 / (n : ℝ))) ^ A * (η⁻¹) ^ A * Real.exp (((n : ℝ) / 4) * a₀ * t ^ α) := by
    rw [Real.mul_rpow (le_of_lt hSf_pos) (le_of_lt ht_pos), mul_pow, mul_assoc]
    refine mul_le_mul_of_nonneg_left ?_ (pow_nonneg (Real.rpow_nonneg (le_of_lt hSf_pos) _) A)
    have h_pow1 : (t ^ (1 / (n : ℝ))) ^ A ≤ (η⁻¹ * Real.exp (η * t ^ α)) ^ A :=
      pow_le_pow_left₀ (Real.rpow_nonneg (le_of_lt ht_pos) _) (le_trans h_rpow_le htα_le_exp) A
    rw [mul_pow, ← Real.exp_nat_mul] at h_pow1
    have h_exp_A : Real.exp ((A : ℝ) * (η * t ^ α)) ≤ Real.exp (((n : ℝ) / 4) * a₀ * t ^ α) := by
      rw [Real.exp_le_exp]
      have h_mul := mul_le_mul_of_nonneg_right hAη_le htα_nn
      linarith
    exact le_trans h_pow1 (mul_le_mul_of_nonneg_left h_exp_A (by positivity))
  have h_pref_le : P_f * (P_K * (S_f * t)⁻¹ * ((S_f * t) ^ (1 / (n : ℝ))) ^ A * J_maj (a₀ * t ^ α)) ≤
      P_f * (P_K * S_f⁻¹ * ((S_f ^ (1 / (n : ℝ))) ^ A * (η⁻¹) ^ A * Real.exp (((n : ℝ) / 4) * a₀ * t ^ α)) *
        (M₀ * Real.exp (-((n : ℝ) / 2) * (a₀ * t ^ α)))) := by
    refine mul_le_mul_of_nonneg_left ?_ (le_of_lt hPf_pos)
    refine mul_le_mul ?_ hJ_le (hJ_maj_nn _) (by positivity)
    refine mul_le_mul ?_ h_poly_le (by positivity) (by positivity)
    exact mul_le_mul_of_nonneg_left ht_inv_le (le_of_lt hPK_pos)
  have h_rhs_eq : P_f * (P_K * S_f⁻¹ * ((S_f ^ (1 / (n : ℝ))) ^ A * (η⁻¹) ^ A * Real.exp (((n : ℝ) / 4) * a₀ * t ^ α)) *
      (M₀ * Real.exp (-((n : ℝ) / 2) * (a₀ * t ^ α)))) =
      C₀ * Real.exp (-2 * c * t ^ α) := by
    have h_rearrange :
        P_f * (P_K * S_f⁻¹ * ((S_f ^ (1 / (n : ℝ))) ^ A * (η⁻¹) ^ A * Real.exp (((n : ℝ) / 4) * a₀ * t ^ α)) *
          (M₀ * Real.exp (-((n : ℝ) / 2) * (a₀ * t ^ α)))) =
        C₀ * (Real.exp (((n : ℝ) / 4) * a₀ * t ^ α) * Real.exp (-((n : ℝ) / 2) * (a₀ * t ^ α))) := by
      dsimp [C₀]
      ring
    rw [h_rearrange, ← Real.exp_add]
    congr 2
    dsimp [c]
    ring
  rw [← h_rhs_eq]
  exact h_pref_le

theorem mitsui_shifted_unitRank_archimedean_mellin_eq_prod_places {K : Type u} [Field K] [NumberField K]
    (a_place : NumberField.InfinitePlace K → ℕ)
    (ν_place : NumberField.InfinitePlace K → ℝ)
    (hν_sum : (∑ w : NumberField.InfinitePlace K, ν_place w) = 0) :
    let Q_K : (Fin (NumberField.Units.rank K) → ℝ) → ℝ := fun y =>
      ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * ∏ i : Fin (NumberField.Units.rank K),
          (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i)
    let U_K : (Fin (NumberField.Units.rank K) → ℝ) → ℝ := fun y =>
      ∏ w : NumberField.InfinitePlace K,
        (∏ i : Fin (NumberField.Units.rank K),
          (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (y i)) ^ (a_place w)
    let J_maj : ℝ → ℝ := fun a =>
      ∫ y : Fin (NumberField.Units.rank K) → ℝ, U_K y * Real.exp (-a * Q_K y)
    let J_c : ℝ → ℂ := fun a =>
      ∫ y : Fin (NumberField.Units.rank K) → ℝ,
        ((U_K y * Real.exp (-a * Q_K y) : ℝ) : ℂ) *
          Complex.exp
            (((∑ w : NumberField.InfinitePlace K,
                ν_place w *
                  ∑ i : Fin (NumberField.Units.rank K),
                    y i * Real.log (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K))) : ℝ) *
              Complex.I)
    ∀ z : ℂ, 1 < z.re →
      MeasureTheory.IntegrableOn
        (fun τ : ℝ => τ ^ z.re *
          ((2 : ℝ) ^ (NumberField.InfinitePlace.nrRealPlaces K + NumberField.InfinitePlace.nrComplexPlaces K) *
            NumberField.Units.regulator K * τ⁻¹ *
            (τ ^ (1 / (Module.finrank ℚ K : ℝ))) ^ (∑ w : NumberField.InfinitePlace K, a_place w) *
            J_maj (Real.pi * τ ^ (2 / (Module.finrank ℚ K : ℝ)))))
        (Set.Ioi (0 : ℝ)) MeasureTheory.volume ∧
      (∫ τ in Set.Ioi (0 : ℝ),
        (τ : ℂ) ^ z *
          ((((2 : ℝ) ^ (NumberField.InfinitePlace.nrRealPlaces K + NumberField.InfinitePlace.nrComplexPlaces K) *
            NumberField.Units.regulator K * τ⁻¹ *
            (τ ^ (1 / (Module.finrank ℚ K : ℝ))) ^ (∑ w : NumberField.InfinitePlace K, a_place w) : ℝ) : ℂ) *
            J_c (Real.pi * τ ^ (2 / (Module.finrank ℚ K : ℝ))))) =
        ∏ w : NumberField.InfinitePlace K,
          (∫ v in Set.Ioi (0 : ℝ),
            (v : ℂ) ^ (z + ((a_place w : ℂ) + (ν_place w : ℂ) * Complex.I) / (w.mult : ℂ)) *
              ((2 * v⁻¹ * Real.exp (-Real.pi * (w.mult : ℝ) * v ^ (2 / (w.mult : ℝ))) : ℝ) : ℂ)) :=
by
  classical
  have h_s1 : ∀ (c : ℝ), 0 < c → ∀ (f_re : ℝ → ℝ) (f_c : ℝ → ℂ),
      (MeasureTheory.IntegrableOn (fun τ : ℝ => τ⁻¹ * f_re τ) (Set.Ioi (0 : ℝ)) MeasureTheory.volume ↔
        MeasureTheory.Integrable (fun u : ℝ => c * f_re (Real.exp (c * u))) MeasureTheory.volume) ∧
      (∫ τ in Set.Ioi (0 : ℝ), ((τ⁻¹ : ℝ) : ℂ) * f_c τ) =
        ∫ u : ℝ, (c : ℂ) * f_c (Real.exp (c * u)) := by
    intro c hc f_re f_c
    let ϕ : ℝ → ℝ := fun u => Real.exp (c * u)
    let ϕ' : ℝ → ℝ := fun u => c * Real.exp (c * u)
    have h_deriv : ∀ u ∈ (Set.univ : Set ℝ), HasDerivWithinAt ϕ (ϕ' u) Set.univ u := by
      intro u _
      have h1 : HasDerivAt (fun x : ℝ => c * x) (c * 1) u := (hasDerivAt_id u).const_mul c
      rw [mul_one] at h1
      have h2 : HasDerivAt ϕ (Real.exp (c * u) * c) u := (Real.hasDerivAt_exp (c * u)).comp u h1
      rw [mul_comm] at h2
      exact h2.hasDerivWithinAt
    have h_inj : Set.InjOn ϕ Set.univ :=
      fun u₁ _ u₂ _ h => mul_left_cancel₀ (ne_of_gt hc) (Real.exp_injective h)
    have h_surj : Function.Surjective (fun u : ℝ => c * u) := mul_left_surjective₀ (ne_of_gt hc)
    have h_img : ϕ '' Set.univ = Set.Ioi (0 : ℝ) := by
      rw [Set.image_univ]
      change Set.range (Real.exp ∘ fun u : ℝ => c * u) = Set.Ioi (0 : ℝ)
      rw [h_surj.range_comp, Real.range_exp]
    have h_abs : ∀ u : ℝ, |ϕ' u| = c * Real.exp (c * u) := by
      intro u
      dsimp [ϕ']
      exact abs_of_pos (mul_pos hc (Real.exp_pos _))
    refine ⟨?_, ?_⟩
    · rw [← h_img]
      rw [MeasureTheory.integrableOn_image_iff_integrableOn_abs_deriv_smul MeasurableSet.univ h_deriv h_inj]
      rw [MeasureTheory.integrableOn_univ]
      refine MeasureTheory.integrable_congr (Filter.Eventually.of_forall (fun u => ?_))
      dsimp [ϕ]
      rw [h_abs u]
      have hexp_ne : Real.exp (c * u) ≠ 0 := Real.exp_ne_zero (c * u)
      calc (c * Real.exp (c * u)) * ((Real.exp (c * u))⁻¹ * f_re (Real.exp (c * u)))
          = c * (Real.exp (c * u) * (Real.exp (c * u))⁻¹) * f_re (Real.exp (c * u)) := by ring
        _ = c * 1 * f_re (Real.exp (c * u)) := by rw [mul_inv_cancel₀ hexp_ne]
        _ = c * f_re (Real.exp (c * u)) := by ring
    · rw [← h_img]
      rw [MeasureTheory.integral_image_eq_integral_abs_deriv_smul MeasurableSet.univ h_deriv h_inj]
      rw [MeasureTheory.setIntegral_univ]
      refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall (fun u => ?_))
      dsimp [ϕ]
      rw [h_abs u, Complex.ofReal_mul, Complex.ofReal_inv]
      have hexp_ne : (Real.exp (c * u) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (Real.exp_ne_zero (c * u))
      calc ((c : ℂ) * (Real.exp (c * u) : ℂ)) * (((Real.exp (c * u) : ℂ))⁻¹ * f_c (Real.exp (c * u)))
          = (c : ℂ) * ((Real.exp (c * u) : ℂ) * ((Real.exp (c * u) : ℂ))⁻¹) * f_c (Real.exp (c * u)) := by ring
        _ = (c : ℂ) * 1 * f_c (Real.exp (c * u)) := by rw [mul_inv_cancel₀ hexp_ne]
        _ = (c : ℂ) * f_c (Real.exp (c * u)) := by ring
  have h_s2 : ∀ (m a : ℕ), 1 ≤ m → m ≤ 2 → ∀ (ν : ℝ) (z : ℂ), 1 < z.re →
      let g_maj : ℝ → ℝ := fun t =>
        2 * Real.exp (t * (z.re + (a : ℝ) / (m : ℝ))) *
          Real.exp (-Real.pi * (m : ℝ) * Real.exp (t * (2 / (m : ℝ))))
      let g_c : ℝ → ℂ := fun t =>
        Complex.exp ((t : ℂ) * (z + ((a : ℂ) + (ν : ℂ) * Complex.I) / (m : ℂ))) *
          ((2 * Real.exp (-Real.pi * (m : ℝ) * Real.exp (t * (2 / (m : ℝ)))) : ℝ) : ℂ)
      (∀ t : ℝ, 0 ≤ g_maj t) ∧
      MeasureTheory.Integrable g_maj MeasureTheory.volume ∧
      MeasureTheory.Integrable g_c MeasureTheory.volume ∧
      (∫ v in Set.Ioi (0 : ℝ),
        (v : ℂ) ^ (z + ((a : ℂ) + (ν : ℂ) * Complex.I) / (m : ℂ)) *
          ((2 * v⁻¹ * Real.exp (-Real.pi * (m : ℝ) * v ^ (2 / (m : ℝ))) : ℝ) : ℂ)) =
        ∫ t : ℝ, g_c t := by
    intro m a hm1 hm2 ν z hz g_maj g_c
    have hm_pos : (0 : ℝ) < (m : ℝ) := by exact_mod_cast (lt_of_lt_of_le zero_lt_one hm1)
    have hm_le2 : (m : ℝ) ≤ 2 := by exact_mod_cast hm2
    have hm_ne : (m : ℝ) ≠ 0 := ne_of_gt hm_pos
    set σ : ℝ := z.re + (a : ℝ) / (m : ℝ)
    set p : ℝ := 2 / (m : ℝ)
    set b : ℝ := Real.pi * (m : ℝ)
    have hb_neg : -b = -Real.pi * (m : ℝ) := by dsimp [b]; ring
    have ha_div_nn : 0 ≤ (a : ℝ) / (m : ℝ) := by positivity
    have hσ_gt : -1 < σ - 1 := by dsimp [σ]; linarith
    have hp_ge : 1 ≤ p := by
      dsimp [p]
      rw [one_le_div hm_pos]
      exact hm_le2
    have hb_pos : 0 < b := by dsimp [b]; positivity
    have h_gmaj_nn : ∀ t : ℝ, 0 ≤ g_maj t := by
      intro t
      dsimp [g_maj]
      positivity
    let f_re : ℝ → ℝ := fun v => 2 * v ^ σ * Real.exp (-Real.pi * (m : ℝ) * v ^ p)
    let s_m : ℂ := z + ((a : ℂ) + (ν : ℂ) * Complex.I) / (m : ℂ)
    let f_c : ℝ → ℂ := fun v => (v : ℂ) ^ s_m * ((2 * Real.exp (-Real.pi * (m : ℝ) * v ^ p) : ℝ) : ℂ)
    have hs1 := h_s1 1 zero_lt_one f_re f_c
    have h_int_v0 : MeasureTheory.IntegrableOn
        (fun v : ℝ => 2 * (v ^ (σ - 1) * Real.exp (-b * v ^ p)))
        (Set.Ioi (0 : ℝ)) MeasureTheory.volume :=
      (integrableOn_rpow_mul_exp_neg_mul_rpow hσ_gt hp_ge hb_pos).const_mul 2
    have h_int_v : MeasureTheory.IntegrableOn
        (fun v : ℝ => v⁻¹ * f_re v) (Set.Ioi (0 : ℝ)) MeasureTheory.volume := by
      refine h_int_v0.congr_fun (fun v hv => ?_) measurableSet_Ioi
      have hv_pos : 0 < v := Set.mem_Ioi.mp hv
      dsimp [f_re]
      rw [← hb_neg, Real.rpow_sub hv_pos, Real.rpow_one, div_eq_mul_inv]
      ring
    have h_gmaj_int : MeasureTheory.Integrable g_maj MeasureTheory.volume := by
      have h1 := hs1.1.mp h_int_v
      refine h1.congr (Filter.Eventually.of_forall (fun t => ?_))
      dsimp [f_re, g_maj, σ, p]
      rw [one_mul, one_mul, ← Real.exp_mul, ← Real.exp_mul]
    have h_re_sm : ∀ t : ℝ, ((t : ℂ) * s_m).re = t * σ := by
      intro t
      have hm_c : (m : ℂ) = ((m : ℝ) : ℂ) := by norm_cast
      dsimp [s_m, σ]
      rw [hm_c]
      simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero,
        Complex.add_re, Complex.div_ofReal_re, Complex.natCast_re, Complex.I_re, mul_zero,
        Complex.I_im, mul_one, sub_self, add_zero]
    have h_gc_cont : Continuous g_c := by
      dsimp [g_c]
      fun_prop
    have h_gc_int : MeasureTheory.Integrable g_c MeasureTheory.volume := by
      refine h_gmaj_int.mono' h_gc_cont.aestronglyMeasurable (Filter.Eventually.of_forall (fun t => ?_))
      dsimp [g_c, g_maj]
      rw [norm_mul, Complex.norm_exp, h_re_sm t, Complex.norm_real,
        Real.norm_of_nonneg (by positivity)]
      dsimp [σ]
      linarith
    refine ⟨h_gmaj_nn, h_gmaj_int, h_gc_int, ?_⟩
    have h_lhs_eq : (∫ v in Set.Ioi (0 : ℝ),
        (v : ℂ) ^ s_m * ((2 * v⁻¹ * Real.exp (-Real.pi * (m : ℝ) * v ^ (2 / (m : ℝ))) : ℝ) : ℂ)) =
        ∫ v in Set.Ioi (0 : ℝ), ((v⁻¹ : ℝ) : ℂ) * f_c v := by
      refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun v _ => ?_)
      dsimp [f_c, p]
      push_cast
      ring
    change (∫ v in Set.Ioi (0 : ℝ),
        (v : ℂ) ^ s_m * ((2 * v⁻¹ * Real.exp (-Real.pi * (m : ℝ) * v ^ (2 / (m : ℝ))) : ℝ) : ℂ)) =
        ∫ t : ℝ, g_c t
    rw [h_lhs_eq, hs1.2]
    refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall (fun t => ?_))
    dsimp [f_c, g_c, p, s_m]
    rw [one_mul, one_mul, ← Real.exp_mul]
    have hexp_c_ne : ((Real.exp t : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (Real.exp_ne_zero t)
    have h_cpow : ((Real.exp t : ℝ) : ℂ) ^ (z + ((a : ℂ) + (ν : ℂ) * Complex.I) / (m : ℂ)) =
        Complex.exp ((t : ℂ) * (z + ((a : ℂ) + (ν : ℂ) * Complex.I) / (m : ℂ))) := by
      rw [Complex.cpow_def_of_ne_zero hexp_c_ne, ← Complex.ofReal_log (Real.exp_nonneg t), Real.log_exp]
    rw [h_cpow]
  have h_s3 : ∀ (G_maj : (NumberField.InfinitePlace K → ℝ) → ℝ)
      (G_c : (NumberField.InfinitePlace K → ℝ) → ℂ),
      MeasureTheory.Integrable G_maj MeasureTheory.volume →
      MeasureTheory.Integrable G_c MeasureTheory.volume →
      let Ψ_K : ℝ → (Fin (NumberField.Units.rank K) → ℝ) → (NumberField.InfinitePlace K → ℝ) :=
        fun u y w =>
          (w.mult : ℝ) *
            (u + ∑ i : Fin (NumberField.Units.rank K),
              y i * Real.log (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)))
      MeasureTheory.Integrable
        (fun u : ℝ =>
          (Module.finrank ℚ K : ℝ) * NumberField.Units.regulator K *
            ∫ y : Fin (NumberField.Units.rank K) → ℝ, G_maj (Ψ_K u y))
        MeasureTheory.volume ∧
      (∫ t : NumberField.InfinitePlace K → ℝ, G_c t) =
        ∫ u : ℝ,
          (((Module.finrank ℚ K : ℝ) * NumberField.Units.regulator K : ℝ) : ℂ) *
            ∫ y : Fin (NumberField.Units.rank K) → ℝ, G_c (Ψ_K u y) := by
    intro G_maj G_c hG_maj_int hG_c_int Ψ_K
    let E := NumberField.mixedEmbedding.realSpace K
    let B := NumberField.mixedEmbedding.fundamentalCone.completeBasis K
    let L_K : E ≃L[ℝ] E := B.equivFunL.symm
    let L_map : E →L[ℝ] E := (L_K : E →L[ℝ] E)
    let J_K : ℝ := (Module.finrank ℚ K : ℝ) * NumberField.Units.regulator K
    have h_det : |L_map.det| = J_K :=
      NumberField.mixedEmbedding.fundamentalCone.abs_det_completeBasis_equivFunL_symm K
    have h_fderiv : ∀ x ∈ (Set.univ : Set E), HasFDerivWithinAt L_K L_map Set.univ x :=
      fun x _ => L_map.hasFDerivWithinAt
    have h_inj : Set.InjOn L_K Set.univ := L_K.injective.injOn
    have h_img : L_K '' Set.univ = Set.univ := by
      rw [Set.image_univ]
      exact L_K.surjective.range_eq
    have h_maj_L : MeasureTheory.Integrable (fun x : E => J_K * G_maj (L_K x)) MeasureTheory.volume := by
      have h1 : MeasureTheory.IntegrableOn G_maj (L_K '' Set.univ) MeasureTheory.volume := by
        rw [h_img, MeasureTheory.integrableOn_univ]
