  have hF_int : ∀ m : ℕ, MeasureTheory.IntegrableOn (F m) (Set.Ioi (0 : ℝ)) MeasureTheory.volume := by
    intro m
    by_cases hm : m = 0
    · subst hm
      have hF0 : F 0 = fun _ => 0 := by
