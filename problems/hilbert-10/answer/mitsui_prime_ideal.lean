          Finset.sum_congr rfl (fun a _ => h_term a)
      _ = G₀ y :=
          Fintype.sum_equiv equiv_u
            (fun a => ψ_f (a * u) * e_K ((β (a * u) : K) * (y : K) / (γ₀ : K)))
            (fun a => ψ_f a * e_K ((β a : K) * (y : K) / (γ₀ : K)))
            (fun _ => rfl)
  let τ_sum : ℂ := G₀ 1
  have hG₀_eval : ∀ y : R, G₀ y = τ_sum * star (ψ_f (Ideal.Quotient.mk f y)) := by
    intro y
    by_cases hy : IsUnit (Ideal.Quotient.mk f y)
    · have h1 := hG₀_unit_mul y 1 hy
      rw [mul_one] at h1
      have h_conj := h_star_mul_eq_one (ψ_f (Ideal.Quotient.mk f y)) ((hψ_unit _).1 hy)
      calc G₀ y = (star (ψ_f (Ideal.Quotient.mk f y)) * ψ_f (Ideal.Quotient.mk f y)) * G₀ y := by
            rw [h_conj, one_mul]
