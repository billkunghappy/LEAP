        have h_toReal := ENNReal.toReal_mono ENNReal.ofReal_ne_top h_lint_le
        rwa [ENNReal.toReal_ofReal (by nlinarith [hR₀₁_sq, Real.pi_pos])] at h_toReal
      have h_symm_collar : ∀ q : ℝ × ℝ, 0 < q.1 →
          ((q ∈ A_cyl ∧ q ∉ A_exact) ∨ (q ∈ A_exact ∧ q ∉ A_cyl)) →
          q ∈ polarCoord.target ∧ polarCoord.symm q ∈ D_col := by
        intro q hr h_symm
        have h_common : q.1 ∈ Set.Ico R₀ R₁ ∧ q.2 ∈ Set.Ioo (-Real.pi) Real.pi := by
          rcases h_symm with ⟨hc, _⟩ | ⟨he, _⟩
          · exact ⟨hc.1, hc.2.1⟩
          · exact ⟨he.1, he.2.1⟩
        have hr0 : R₀ ≤ q.1 := h_common.1.1
        have hr1 : q.1 < R₁ := h_common.1.2
        have hθ : q.2 ∈ Set.Ioo (-Real.pi) Real.pi := h_common.2
        have ht : q ∈ polarCoord.target := by
          rw [polarCoord_target]
          exact ⟨hr, hθ⟩
        refine ⟨ht, ?_⟩
        have h_r_sq : (q.1 * Real.cos q.2) ^ 2 + (q.1 * Real.sin q.2) ^ 2 = q.1 ^ 2 := by
          calc (q.1 * Real.cos q.2) ^ 2 + (q.1 * Real.sin q.2) ^ 2
            _ = q.1 ^ 2 * (Real.cos q.2 ^ 2 + Real.sin q.2 ^ 2) := by ring
            _ = q.1 ^ 2 * 1 := by rw [Real.cos_sq_add_sin_sq]
            _ = q.1 ^ 2 := mul_one _
        have h_sq_lo : R₀ ^ 2 ≤ q.1 ^ 2 := pow_le_pow_left₀ hR₀ hr0 2
        have h_sq_hi : q.1 ^ 2 < R₁ ^ 2 := pow_lt_pow_left₀ hr1 (le_of_lt hr) (by decide)
        have hrX : q.1 ≤ X := le_trans (le_of_lt hr1) hR₁X
        have hx_Icc : q.1 * Real.cos q.2 ∈ Set.Icc (-X) X := by
          rw [Set.mem_Icc, ← abs_le, abs_mul, abs_of_pos hr]
