    le_trans hlog1_le_K₀_half (mul_le_mul_of_nonneg_left hexp_half_le (le_of_lt hK₀_pos))
  have hexp_d_le : (d_exp : ℝ) * (c' * t) ≤ t / (4 * c) := by
    have hd_le : (d_exp : ℝ) ≤ (d_exp : ℝ) + 1 := by linarith
    have h1 : (d_exp : ℝ) * (c' * t) ≤ ((d_exp : ℝ) + 1) * (c' * t) :=
