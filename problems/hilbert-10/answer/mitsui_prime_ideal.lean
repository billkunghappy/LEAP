    _ = s * (s - 1) *
          ((∫ u in Set.Ioi (1 : ℝ),
              ((u : ℂ) ^ (1 - s) * (Ψ_K u : ℂ) +
                (R_K : ℂ) * ((u : ℂ) ^ (-s) - (u : ℂ) ^ (-1 - s)))) +
            (∫ u in Set.Ioi (1 : ℝ), (u : ℂ) ^ s * (Ψ_K u : ℂ))) := by rw [h2]
    _ = (R_K : ℂ) +
          s * (s - 1) *
            ∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s + (u : ℂ) ^ (1 - s)) * (Ψ_K u : ℂ) := h3

