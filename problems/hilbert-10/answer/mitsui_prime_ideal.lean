    have h_norm : ‖w.embedding z‖ = w z := NumberField.InfinitePlace.norm_embedding_eq w z
    have h_conj_mul : star (w.embedding z) * w.embedding z = (w z : ℂ) * (w z : ℂ) := by
      have h1 := RCLike.conj_mul (w.embedding z)
      rw [RCLike.star_def]
      rw [h_norm] at h1
      exact h1.trans (sq (w z : ℂ))
    have h_inv : (w.embedding z / (w z : ℂ))⁻¹ = star (w.embedding z) / (w z : ℂ) := by
      rw [inv_div]
      calc (w z : ℂ) / w.embedding z
          = ((w z : ℂ) * (w z : ℂ)) / ((w z : ℂ) * w.embedding z) :=
            (mul_div_mul_left (w z : ℂ) (w.embedding z) hw_ne).symm
        _ = (star (w.embedding z) * w.embedding z) / ((w z : ℂ) * w.embedding z) := by
            rw [h_conj_mul]
