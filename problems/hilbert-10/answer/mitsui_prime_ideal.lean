        _ = (∑ a : R ⧸ f, ψ_f (u₀ * a)) - S_sum := by rw [← h_pull]
        _ = S_sum - S_sum := by rw [h_shift]
        _ = 0 := sub_self S_sum
    exact (mul_eq_zero.mp h_sub_zero).resolve_left (sub_ne_zero.mpr hψ_u₀)

theorem mitsui_grossenchar_cube_nonzero_lattice_sum_eq_full_ideal_sum_of_units_eq_one {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
