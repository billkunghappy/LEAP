    calc c₁₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) +
        c₂₀ * Y * Real.exp (-Real.sqrt (Real.log X) / c₁) +
        (M_card * c₃₀) * Y * Real.exp (-Real.sqrt (Real.log X) / c₁)
      _ = (c₁₀ + c₂₀ + M_card * c₃₀) * (Y * Real.exp (-Real.sqrt (Real.log X) / c₁)) := by ring
