            (D ^ (-1 / 2 : ℝ) * N_f ^ (-1 / 2 : ℝ) * u / (Ideal.absNorm J_σC : ℝ)) := by
            rw [div_eq_mul_inv]
            ring
        _ = D ^ (-1 / 2 : ℝ) * N_f ^ (-1 / 2 : ℝ) * u / (Ideal.absNorm J_σC : ℝ) := by
            rw [mul_inv_cancel₀ hJC_ne', hD_prod, hNf_prod]
            ring
    have h_scale_sq : (c_C⁻¹ * N_γ ^ (-1 / (n : ℝ))) ^ 2 =
        (b_RHS / (Ideal.absNorm J_σC : ℝ)) ^ (2 / (n : ℝ)) := by
      rw [h_scale_c]
      have hb_rhs_ratio_pos : 0 < b_RHS / (Ideal.absNorm J_σC : ℝ) := div_pos hb_RHS_pos hNJσC_pos
      rw [← Real.rpow_natCast, ← Real.rpow_mul (le_of_lt hb_rhs_ratio_pos)]
      congr 1; ring
    rw [h_scale_sq, h_scale_c, mul_assoc]
  have h_sum_per_C :
      (∑ C : ClassGroup R,
        star (ψ₀ (J_rep C)) *
          (∫ y in Cube,
            (∑' x : (J_rep C : Ideal R),
              ψ_f (Ideal.Quotient.mk f x.1) *
                (∏ w : NumberField.InfinitePlace K,
                  (w.embedding (x.1 : K) *
                    ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (y i) : ℝ) : ℂ)) ^ (a_place w)) *
                ((((b_LHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
                    (∑ w : NumberField.InfinitePlace K, a_place w) *
                  Real.exp (-Real.pi * (b_LHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                    ∑ w : NumberField.InfinitePlace K,
                      (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                        ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) : ℝ) : ℂ)))) =
      (∑ C : ClassGroup R,
        ((u : ℂ) * ω_ψ) *
          (ψ₀ (J_rep (σ C)) *
            (∫ y in Cube,
              (∑' x : (J_rep (σ C) : Ideal R),
                star (ψ_f (Ideal.Quotient.mk f x.1)) *
                  (∏ w : NumberField.InfinitePlace K,
                    (w.embedding (x.1 : K) *
                      ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) *
                  ((((b_RHS / (Ideal.absNorm (J_rep (σ C) : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
                      (∑ w : NumberField.InfinitePlace K, a_place w) *
                    Real.exp (-Real.pi * (b_RHS / (Ideal.absNorm (J_rep (σ C) : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                      ∑ w : NumberField.InfinitePlace K,
                        (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                          ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ))))) :=
    Finset.sum_congr rfl (fun C _ => h_per_C C)
  rw [h_sum_per_C, ← Finset.mul_sum]
  congr 1
  exact Equiv.sum_comp σ (fun C =>
    ψ₀ (J_rep C) *
      (∫ y in Cube,
        (∑' x : (J_rep C : Ideal R),
          star (ψ_f (Ideal.Quotient.mk f x.1)) *
            (∏ w : NumberField.InfinitePlace K,
              (w.embedding (x.1 : K) *
                ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) *
            ((((b_RHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
                (∑ w : NumberField.InfinitePlace K, a_place w) *
              Real.exp (-Real.pi * (b_RHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                ∑ w : NumberField.InfinitePlace K,
                  (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                    ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ))))

theorem mitsui_primitive_narrow_ray_char_stripped_unitRank_theta_inversion {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (ψ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hψ₀_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖ψ₀ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → ψ₀ I = 0))
    (hψ₀_nonprin : ∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧ ψ₀ I₀ ≠ 1)
    (hψ₀_prim : ∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
      ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧
        x - 1 ∈ f' ∧
        (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (x : K)).re) ∧
        ψ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ ≠ 1)
    (a_place : NumberField.InfinitePlace K → ℕ)
    (ha_real : ∀ w : NumberField.InfinitePlace K, w.IsReal → a_place w ≤ 1)
    (ha_cplx : ∀ w : NumberField.InfinitePlace K, w.IsComplex → a_place w = 0)
    (hψ₀_prin_sign : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ f →
      ψ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
        ∏ w : NumberField.InfinitePlace K,
          (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (a_place w)) :
    let Q_K : (Fin (NumberField.Units.rank K) → ℝ) → ℝ := fun y =>
      ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * ∏ i : Fin (NumberField.Units.rank K),
          (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i)
    let U_K : (Fin (NumberField.Units.rank K) → ℝ) → ℝ := fun y =>
      ∏ w : NumberField.InfinitePlace K,
        (∏ i : Fin (NumberField.Units.rank K),
          (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (y i)) ^ (a_place w)
    let J_maj : ℝ → ℝ := fun a =>
      ∫ y : Fin (NumberField.Units.rank K) → ℝ, U_K y * Real.exp (-a * Q_K y)
    let S_f : ℝ := |(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) * (Ideal.absNorm f : ℝ) ^ (-1 / 2 : ℝ)
    ∃ ω_ψ : ℂ, ‖ω_ψ‖ = 1 ∧
      ∀ u ∈ Set.Ioi (0 : ℝ),
        (∑' m : ℕ,
          (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
            ψ₀ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
          (((((S_f * ((m : ℝ) * u⁻¹)) ^ (1 / (Module.finrank ℚ K : ℝ))) ^
              (∑ w : NumberField.InfinitePlace K, a_place w) *
            J_maj (Real.pi * (S_f * ((m : ℝ) * u⁻¹)) ^ (2 / (Module.finrank ℚ K : ℝ))) : ℝ) : ℂ))) =
        (u : ℂ) * ω_ψ *
          (∑' m : ℕ,
            (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
              ((starRingEnd ℂ).toMonoidHom.comp ψ₀) ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
            (((((S_f * ((m : ℝ) * u)) ^ (1 / (Module.finrank ℚ K : ℝ))) ^
                (∑ w : NumberField.InfinitePlace K, a_place w) *
              J_maj (Real.pi * (S_f * ((m : ℝ) * u)) ^ (2 / (Module.finrank ℚ K : ℝ))) : ℝ) : ℂ))) :=
by
  intro Q_K U_K J_maj S_f
  let R := NumberField.RingOfIntegers K
  let n : ℕ := Module.finrank ℚ K
  let r : ℕ := NumberField.Units.rank K
  let Cube : Set (Fin r → ℝ) := Set.pi Set.univ (fun _ => Set.Ico (0 : ℝ) 1)
  obtain ⟨J_rep, hJ_cls, hJ_cop, h_s1⟩ :=
    mitsui_narrow_stripped_tsum_eq_sum_classGroup_principal_subideals f hf a_place
  obtain ⟨ψ_f, hψ_one, hψ_mul, hψ_unit, hψ_span, hψ_prim, hψ_zero_gen⟩ :=
    mitsui_primitive_narrow_ray_char_exists_quotient_char_and_zero_mode
      f hf ψ₀ hψ₀_norm_supp hψ₀_nonprin hψ₀_prim a_place ha_real ha_cplx hψ₀_prin_sign
  have hψ_zero : (f ≠ ⊤ ∧ ψ_f 0 = 0 ∧
      ∀ (h_fin : Fintype (R ⧸ f)),
        @Finset.sum (R ⧸ f) ℂ _ (@Finset.univ (R ⧸ f) h_fin) ψ_f = 0) ∨
    (f = ⊤ ∧ (∀ a : R ⧸ f, ψ_f a = 1) ∧
      ((∃ w : NumberField.InfinitePlace K, a_place w ≠ 0) ∨
        ((∀ w : NumberField.InfinitePlace K, a_place w = 0) ∧
          (∑ C : ClassGroup R, star (ψ₀ (J_rep C))) = 0 ∧
          (∑ C : ClassGroup R, ψ₀ (J_rep C)) = 0))) :=
    hψ_zero_gen.imp id (fun ⟨hf_top, hψ_all, h_disj⟩ =>
      ⟨hf_top, hψ_all, h_disj.imp id (fun ⟨ha0, hJ⟩ => ⟨ha0, hJ J_rep hJ_cls hJ_cop⟩)⟩)
  obtain ⟨ω_ψ, hω_norm, h_s4⟩ :=
    mitsui_primitive_narrow_ray_char_classGroup_cube_lattice_theta_inversion
      f hf ψ₀ hψ₀_norm_supp a_place ha_real ha_cplx J_rep hJ_cls hJ_cop ψ_f
      hψ_one hψ_mul hψ_unit hψ_span hψ_prim hψ_zero
  let χ_dual : nonZeroDivisors (Ideal R) →* ℂ :=
    (starRingEnd ℂ).toMonoidHom.comp ψ₀
  have hψ₀_norm_le : ∀ I : nonZeroDivisors (Ideal R), ‖ψ₀ I‖ ≤ 1 := by
    intro I
    by_cases hI : (I : Ideal R) ⊔ f = ⊤
    · rw [(hψ₀_norm_supp I).1 hI]
    · rw [(hψ₀_norm_supp I).2 hI, norm_zero]
      exact zero_le_one
  have hχ_dual_norm_supp : ∀ I : nonZeroDivisors (Ideal R),
      ((I : Ideal R) ⊔ f = ⊤ → ‖χ_dual I‖ = 1) ∧
      (¬ ((I : Ideal R) ⊔ f = ⊤) → χ_dual I = 0) := by
    intro I
    refine ⟨fun hI => ?_, fun hI => ?_⟩
    · change ‖star (ψ₀ I)‖ = 1
      rw [norm_star, (hψ₀_norm_supp I).1 hI]
    · change star (ψ₀ I) = 0
      rw [(hψ₀_norm_supp I).2 hI, star_zero]
  have hχ_dual_norm_le : ∀ I : nonZeroDivisors (Ideal R), ‖χ_dual I‖ ≤ 1 := by
    intro I
    change ‖star (ψ₀ I)‖ ≤ 1
    rw [norm_star]
    exact hψ₀_norm_le I
  have hψ_dual_span : ∀ (x : R) (hx_ne : x ≠ 0),
      χ_dual ⟨Ideal.span ({x} : Set R),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
        star (ψ_f (Ideal.Quotient.mk f x)) *
          ∏ w : NumberField.InfinitePlace K,
            (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (a_place w) := by
    intro x hx_ne
    have h_prod_star :
        star (∏ w : NumberField.InfinitePlace K,
          (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (a_place w)) =
        ∏ w : NumberField.InfinitePlace K,
          (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (a_place w) := by
      rw [star_prod]
      refine Finset.prod_congr rfl (fun w _ => ?_)
      rw [star_pow]
      by_cases hw : w.IsReal
      · have h_emb : w.embedding (x : K) = ((NumberField.InfinitePlace.embedding_of_isReal hw (x : K) : ℝ) : ℂ) :=
          (NumberField.InfinitePlace.embedding_of_isReal_apply hw (x : K)).symm
        rw [h_emb, star_div₀, Complex.star_def, Complex.conj_ofReal, Complex.conj_ofReal]
      · have hw_cplx : w.IsComplex := NumberField.InfinitePlace.not_isReal_iff_isComplex.mp hw
        rw [ha_cplx w hw_cplx, pow_zero, pow_zero]
    change star (ψ₀ ⟨Ideal.span ({x} : Set R), _⟩) = _
    rw [hψ_span x hx_ne, star_mul, h_prod_star, mul_comm]
  refine ⟨ω_ψ, hω_norm, ?_⟩
  intro u hu
  have hu_pos : 0 < u := Set.mem_Ioi.mp hu
  have hu_inv_pos : 0 < u⁻¹ := inv_pos.mpr hu_pos
  have hD_pos : 0 < |(NumberField.discr K : ℝ)| :=
    abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  have hf_norm_ne : Ideal.absNorm f ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hf
  have hNf_pos : 0 < (Ideal.absNorm f : ℝ) := by
    exact_mod_cast Nat.pos_of_ne_zero hf_norm_ne
  have hSf_pos : 0 < S_f := by
    dsimp [S_f]
    positivity
  have hb_inv_pos : 0 < S_f * u⁻¹ := mul_pos hSf_pos hu_inv_pos
  have hb_pos : 0 < S_f * u := mul_pos hSf_pos hu_pos
  set LHS_raw : ℂ :=
    ∑' m : ℕ,
      (∑' I : {I : Ideal R // I ≠ ⊥ ∧ Ideal.absNorm I = m},
        ψ₀ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
      ((((S_f * ((m : ℝ) * u⁻¹)) ^ (1 / (n : ℝ))) ^
          (∑ w : NumberField.InfinitePlace K, a_place w) *
        J_maj (Real.pi * (S_f * ((m : ℝ) * u⁻¹)) ^ (2 / (n : ℝ))) : ℝ) : ℂ)
  set RHS_raw : ℂ :=
    ∑' m : ℕ,
      (∑' I : {I : Ideal R // I ≠ ⊥ ∧ Ideal.absNorm I = m},
        χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
      ((((S_f * ((m : ℝ) * u)) ^ (1 / (n : ℝ))) ^
          (∑ w : NumberField.InfinitePlace K, a_place w) *
        J_maj (Real.pi * (S_f * ((m : ℝ) * u)) ^ (2 / (n : ℝ))) : ℝ) : ℂ)
  set Sum₁ : ℂ :=
    ∑ C : ClassGroup R,
      star (ψ₀ (J_rep C)) *
        (∫ y in Cube,
          (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
            ψ_f (Ideal.Quotient.mk f x.1) *
              (∏ w : NumberField.InfinitePlace K,
                (w.embedding (x.1 : K) *
                  ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (y i) : ℝ) : ℂ)) ^ (a_place w)) *
              ((((S_f * u⁻¹ / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
                  (∑ w : NumberField.InfinitePlace K, a_place w) *
                Real.exp (-Real.pi * (S_f * u⁻¹ / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                  ∑ w : NumberField.InfinitePlace K,
                    (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                      ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) : ℝ) : ℂ)))
  set Sum₂ : ℂ :=
    ∑ C : ClassGroup R,
      ψ₀ (J_rep C) *
        (∫ y in Cube,
          (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
            star (ψ_f (Ideal.Quotient.mk f x.1)) *
              (∏ w : NumberField.InfinitePlace K,
                (w.embedding (x.1 : K) *
                  ((∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-y i) : ℝ) : ℂ)) ^ (a_place w)) *
              ((((S_f * u / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (1 / (n : ℝ))) ^
                  (∑ w : NumberField.InfinitePlace K, a_place w) *
                Real.exp (-Real.pi * (S_f * u / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                  ∑ w : NumberField.InfinitePlace K,
                    (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                      ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℝ) : ℂ)))
  have h1 : LHS_raw = (NumberField.Units.torsionOrder K : ℂ)⁻¹ * Sum₁ := by
    refine (h_s1 ψ₀ hψ₀_norm_supp u⁻¹ hu_inv_pos).trans ?_
    dsimp only [Sum₁]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun C _ => ?_)
    have h_unfold := (mitsui_principal_subideal_narrow_tsum_eq_torsion_inv_mul_cube_integral_lattice
      f (J_rep C) a_place ha_real ha_cplx ψ₀ hψ₀_norm_le ψ_f hψ_span
      (S_f * u⁻¹) hb_inv_pos).1
    exact (congrArg (fun z => star (ψ₀ (J_rep C)) * z) h_unfold).trans (by ring)
  have h2 : RHS_raw = (NumberField.Units.torsionOrder K : ℂ)⁻¹ * Sum₂ := by
    refine (h_s1 χ_dual hχ_dual_norm_supp u hu_pos).trans ?_
    dsimp only [Sum₂]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun C _ => ?_)
    have h_star : star (χ_dual (J_rep C)) = ψ₀ (J_rep C) := star_star (ψ₀ (J_rep C))
    have h_unfold := (mitsui_principal_subideal_narrow_tsum_eq_torsion_inv_mul_cube_integral_lattice
      f (J_rep C) a_place ha_real ha_cplx χ_dual hχ_dual_norm_le (fun a => star (ψ_f a)) hψ_dual_span
      (S_f * u) hb_pos).2
    exact (congrArg₂ (· * ·) h_star h_unfold).trans (by ring)
  have h_inv : Sum₁ = (u : ℂ) * ω_ψ * Sum₂ := h_s4 u hu
  change LHS_raw = (u : ℂ) * ω_ψ * RHS_raw
  rw [h1, h2, h_inv]
  ring

theorem mitsui_primitive_narrow_ray_char_theta_inversion_and_unitDiscr_fubini {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (ψ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hψ₀_narrow : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ f →
      (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (x : K)).re) →
      ψ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1)
    (hψ₀_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖ψ₀ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → ψ₀ I = 0))
    (hψ₀_nonprin : ∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧ ψ₀ I₀ ≠ 1)
    (hψ₀_prim : ∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
      ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧
        x - 1 ∈ f' ∧
        (∀ w : NumberField.InfinitePlace K, w.IsReal → 0 < (w.embedding (x : K)).re) ∧
        ψ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ ≠ 1) :
    ∃ (q₀ q₁ : ℕ) (ω_ψ : ℂ) (W₀ : ℝ → ℝ) (C₀ c α : ℝ),
      q₀ + q₁ = NumberField.InfinitePlace.nrRealPlaces K ∧
      0 < C₀ ∧ 0 < c ∧ 0 < α ∧ ‖ω_ψ‖ = 1 ∧
      Measurable W₀ ∧
      ContinuousOn W₀ (Set.Ioi (0 : ℝ)) ∧
      (∀ τ : ℝ, 0 ≤ W₀ τ) ∧
      (∀ z : ℂ, 1 < z.re →
        MeasureTheory.IntegrableOn (fun τ : ℝ => τ ^ z.re * W₀ τ) (Set.Ioi (0 : ℝ)) MeasureTheory.volume ∧
        (∫ τ in Set.Ioi (0 : ℝ), (τ : ℂ) ^ z * (W₀ τ : ℂ)) =
          (∫ v in Set.Ioi (0 : ℝ), (v : ℂ) ^ z * ((2 * v⁻¹ * Real.exp (-Real.pi * v ^ 2) : ℝ) : ℂ)) ^ q₀ *
