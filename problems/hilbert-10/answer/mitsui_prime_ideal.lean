theorem mitsui_riesz_vertical_integral_sub_id_le_boundary_integral (B C : ℝ) (hB_pos : 0 < B) (hB_le : B ≤ 1 / 2) (hC_pos : 0 < C)
    (h_dlvp : ∀ s : ℂ, s ≠ 1 → 1 - B / Real.log (4 + |s.im|) ≤ s.re →
      riemannZeta s ≠ 0 ∧
