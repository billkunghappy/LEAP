    by_cases h_l : ∃ w : NumberField.InfinitePlace K, l_eff w ≠ 0
    · exact Or.inl h_l
    · right
      have hl0_eff : ∀ w : NumberField.InfinitePlace K, l_eff w = 0 :=
        fun w => not_not.mp (not_exists.mp h_l w)
