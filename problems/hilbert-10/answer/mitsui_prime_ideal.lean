    rw [Nat.card_eq_fintype_card, Fintype.card_of_subtype B_finset]
    intro k
    simp only [B_finset, Finset.mem_filter, Finset.mem_univ, true_and]
  change |(∑' π : {π : NumberField.RingOfIntegers K //
        Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C}, g π.1) -
      (∑' k : {k : NumberField.mixedEmbedding.index K → Fin (2 * m) // Q k ⊆ C},
        ∑' π : {π : NumberField.RingOfIntegers K // Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ Q k.1}, g π.1)| ≤
      c_pack * (Nat.card {k : NumberField.mixedEmbedding.index K → Fin (2 * m) //
        (Q k ∩ C).Nonempty ∧ ¬ (Q k ⊆ C)} : ℝ) * δ ^ n * (Real.log X + 1)
  rw [hdiff_eq, abs_of_nonneg hsum_nonneg, ← hB_card_eq]
  calc ∑ k ∈ B_finset, ∑ π ∈ F_inter k, g π
    _ ≤ ∑ _k ∈ B_finset, (c_pack * δ ^ n * (Real.log X + 1)) :=
        Finset.sum_le_sum (fun k _ => h_cube_bound k)
    _ = (B_finset.card : ℝ) * (c_pack * δ ^ n * (Real.log X + 1)) := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ = c_pack * (B_finset.card : ℝ) * δ ^ n * (Real.log X + 1) := by ring

theorem mitsui_prime_char_grid_partition_diff_le_uncond {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (m : ℕ) (hm : 1 ≤ m)
    (C : Set (NumberField.mixedEmbedding.mixedSpace K))
    (hC_bdd : ∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
        NumberField.mixedEmbedding.normAtPlace w z < X)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ) :
    ‖(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          NumberField.mixedEmbedding K (π : K) ∈ C ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      - (∑' k : {k : NumberField.mixedEmbedding.index K → Fin (2 * m) //
            {z : NumberField.mixedEmbedding.mixedSpace K |
              ∀ i : NumberField.mixedEmbedding.index K,
                (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
                  Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                    ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))} ⊆ C},
          ∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧
                (∀ i : NumberField.mixedEmbedding.index K,
                  (NumberField.mixedEmbedding.stdBasis K).repr
                      (NumberField.mixedEmbedding K (π : K)) i ∈
                    Set.Ico ((X / (m : ℝ)) * ((((k : NumberField.mixedEmbedding.index K → Fin (2 * m)) i : ℕ) : ℝ) - (m : ℝ)))
                      ((X / (m : ℝ)) * ((((k : NumberField.mixedEmbedding.index K → Fin (2 * m)) i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
                IsUnit (Ideal.Quotient.mk q π)},
              ψ (Additive.ofMul π.2.2.2.unit) *
                (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖ ≤
    |(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      - (∑' k : {k : NumberField.mixedEmbedding.index K → Fin (2 * m) //
            {z : NumberField.mixedEmbedding.mixedSpace K |
              ∀ i : NumberField.mixedEmbedding.index K,
                (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
                  Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                    ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))} ⊆ C},
          ∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧
                ∀ i : NumberField.mixedEmbedding.index K,
                  (NumberField.mixedEmbedding.stdBasis K).repr
                      (NumberField.mixedEmbedding K (π : K)) i ∈
                    Set.Ico ((X / (m : ℝ)) * ((((k : NumberField.mixedEmbedding.index K → Fin (2 * m)) i : ℕ) : ℝ) - (m : ℝ)))
                      ((X / (m : ℝ)) * ((((k : NumberField.mixedEmbedding.index K → Fin (2 * m)) i : ℕ) : ℝ) - (m : ℝ) + 1))},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))| :=
by
  classical
  have hq_bot : q ≠ ⊥ := hq
  haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
    Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
  let L : NumberField.RingOfIntegers K → ℝ :=
    fun π => Real.log ((Algebra.norm ℤ π).natAbs : ℝ)
  have hL_nonneg : ∀ π : NumberField.RingOfIntegers K, 0 ≤ L π :=
    fun _ => Real.log_natCast_nonneg _
  let P_cube : (NumberField.mixedEmbedding.index K → Fin (2 * m)) →
      NumberField.mixedEmbedding.mixedSpace K → Prop :=
    fun k z => ∀ i : NumberField.mixedEmbedding.index K,
      (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
        Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
          ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))
  let Q : (NumberField.mixedEmbedding.index K → Fin (2 * m)) →
      Set (NumberField.mixedEmbedding.mixedSpace K) :=
    fun k => {z : NumberField.mixedEmbedding.mixedSpace K | P_cube k z}
  let I_sub := {k : NumberField.mixedEmbedding.index K → Fin (2 * m) // Q k ⊆ C}
  letI : Fintype I_sub := Fintype.ofFinite I_sub
  let B_X : Set K := {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}
  have hB_fin : B_X.Finite := NumberField.Embeddings.finite_of_norm_le K ℂ X
  have hpre_fin : (algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X).Finite :=
    hB_fin.preimage NumberField.RingOfIntegers.coe_injective.injOn
  have hS_sub : {π : NumberField.RingOfIntegers K |
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C} ⊆
      algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X := by
    intro π hπ
    refine ⟨NumberField.RingOfIntegers.isIntegral_coe π, ?_⟩
    intro φ
    let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
    have hw1 : w (π : K) = ‖φ (π : K)‖ := NumberField.InfinitePlace.apply φ (π : K)
    have hw2 : NumberField.mixedEmbedding.normAtPlace w (NumberField.mixedEmbedding K (π : K)) = w (π : K) :=
      NumberField.mixedEmbedding.normAtPlace_apply w (π : K)
    have hlt : NumberField.mixedEmbedding.normAtPlace w (NumberField.mixedEmbedding K (π : K)) < X :=
      hC_bdd _ hπ.2 w
    change ‖φ (π : K)‖ ≤ X
    linarith
  have hS_fin : {π : NumberField.RingOfIntegers K |
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C}.Finite :=
    hpre_fin.subset hS_sub
  let S_uncond := {π : NumberField.RingOfIntegers K //
    Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C}
  letI : Fintype S_uncond := hS_fin.fintype
  let S_cop := {π : NumberField.RingOfIntegers K //
    Prime π ∧
    NumberField.mixedEmbedding K (π : K) ∈ C ∧
    IsUnit (Ideal.Quotient.mk q π)}
  have hScop_fin : {π : NumberField.RingOfIntegers K |
      Prime π ∧
      NumberField.mixedEmbedding K (π : K) ∈ C ∧
      IsUnit (Ideal.Quotient.mk q π)}.Finite :=
    hS_fin.subset (fun _ hπ => ⟨hπ.1, hπ.2.1⟩)
  letI : Fintype S_cop := hScop_fin.fintype
  let M : NumberField.RingOfIntegers K → Finset I_sub :=
    fun π => Finset.univ.filter (fun k : I_sub =>
      P_cube k.1 (NumberField.mixedEmbedding K (π : K)))
  have hδ_pos : 0 < X / (m : ℝ) := by
    have hX_pos : 0 < X := by linarith
    have hm_pos : 0 < (m : ℝ) := by positivity
    positivity
  have h_disj : ∀ (π : NumberField.RingOfIntegers K) (k₁ k₂ : I_sub),
      P_cube k₁.1 (NumberField.mixedEmbedding K (π : K)) →
      P_cube k₂.1 (NumberField.mixedEmbedding K (π : K)) →
      k₁ = k₂ := by
    intro π k₁ k₂ hk₁ hk₂
    ext i
    have h1 := hk₁ i
    have h2 := hk₂ i
    rw [Set.mem_Ico] at h1 h2
    have h12 : (X / (m : ℝ)) * (((k₁.1 i : ℕ) : ℝ) - (m : ℝ)) <
        (X / (m : ℝ)) * (((k₂.1 i : ℕ) : ℝ) - (m : ℝ) + 1) :=
      lt_of_le_of_lt h1.1 h2.2
    have h21 : (X / (m : ℝ)) * (((k₂.1 i : ℕ) : ℝ) - (m : ℝ)) <
        (X / (m : ℝ)) * (((k₁.1 i : ℕ) : ℝ) - (m : ℝ) + 1) :=
      lt_of_le_of_lt h2.1 h1.2
    have h12_nat : (k₁.1 i : ℕ) < (k₂.1 i : ℕ) + 1 := by
      have : ((k₁.1 i : ℕ) : ℝ) < (((k₂.1 i : ℕ) + 1 : ℕ) : ℝ) := by push_cast; nlinarith
      exact_mod_cast this
    have h21_nat : (k₂.1 i : ℕ) < (k₁.1 i : ℕ) + 1 := by
      have : ((k₂.1 i : ℕ) : ℝ) < (((k₁.1 i : ℕ) + 1 : ℕ) : ℝ) := by push_cast; nlinarith
      exact_mod_cast this
    omega
  have hM_le_one : ∀ π : NumberField.RingOfIntegers K, (M π).card ≤ 1 := by
    intro π
    rw [Finset.card_le_one]
    intro k₁ hk₁ k₂ hk₂
    rw [Finset.mem_filter] at hk₁ hk₂
    exact h_disj π k₁ k₂ hk₁.2 hk₂.2
  have hM_sub_nonneg : ∀ π : NumberField.RingOfIntegers K, 0 ≤ 1 - ((M π).card : ℝ) := by
    intro π
    have h1 : ((M π).card : ℝ) ≤ 1 := by exact_mod_cast hM_le_one π
    linarith
  let term : S_cop → ℂ := fun π =>
    ψ (Additive.ofMul π.2.2.2.unit) * (L π.1 : ℂ)
  have h_lhs1 : (∑' π : S_cop, term π) = ∑ x : S_cop, term x :=
    tsum_fintype term
  let S_cube_cop (k : I_sub) :=
    {π : NumberField.RingOfIntegers K //
      Prime π ∧
      P_cube k.1 (NumberField.mixedEmbedding K (π : K)) ∧
      IsUnit (Ideal.Quotient.mk q π)}
  let e_cube_cop (k : I_sub) :
      S_cube_cop k ≃ {x : S_cop // P_cube k.1 (NumberField.mixedEmbedding K (x.1 : K))} :=
    { toFun := fun π =>
        ⟨⟨π.1, π.2.1, k.2 π.2.2.1, π.2.2.2⟩, π.2.2.1⟩
      invFun := fun x =>
        ⟨x.1.1, x.1.2.1, x.2, x.1.2.2.2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun x => by ext; rfl }
  have h_lhs_cube : ∀ k : I_sub,
      (∑' π : S_cube_cop k,
        ψ (Additive.ofMul π.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑ x : S_cop, (if P_cube k.1 (NumberField.mixedEmbedding K (x.1 : K)) then term x else 0) := by
    intro k
    change (∑' π : S_cube_cop k, term (e_cube_cop k π).1) = _
    rw [Equiv.tsum_eq (e_cube_cop k)
      (fun z : {x : S_cop // P_cube k.1 (NumberField.mixedEmbedding K (x.1 : K))} => term z.1),
      tsum_fintype]
    have hsub : (∑ z : {x : S_cop // P_cube k.1 (NumberField.mixedEmbedding K (x.1 : K))}, term z.1) =
        ∑ x ∈ Finset.univ.filter (fun x : S_cop => P_cube k.1 (NumberField.mixedEmbedding K (x.1 : K))), term x :=
      (Finset.sum_subtype (Finset.univ.filter (fun x : S_cop => P_cube k.1 (NumberField.mixedEmbedding K (x.1 : K))))
        (fun _ => by simp) term).symm
    rw [hsub, Finset.sum_filter]
  have h_lhs2 :
      (∑' k : I_sub,
        ∑' π : S_cube_cop k,
          ψ (Additive.ofMul π.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑ x : S_cop, ((M x.1).card : ℂ) * term x := by
    rw [tsum_fintype]
    simp_rw [h_lhs_cube]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
  have h_lhs_diff :
      (∑' π : S_cop, term π) -
      (∑' k : I_sub,
        ∑' π : S_cube_cop k,
          ψ (Additive.ofMul π.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑ x : S_cop, (1 - ((M x.1).card : ℂ)) * term x := by
    rw [h_lhs1, h_lhs2, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    ring
  have h_term_norm : ∀ x : S_cop,
      ‖(1 - ((M x.1).card : ℂ)) * term x‖ = (1 - ((M x.1).card : ℝ)) * L x.1 := by
    intro x
    dsimp [term]
    have h_cast : (1 - ((M x.1).card : ℂ)) = ((1 - ((M x.1).card : ℝ) : ℝ) : ℂ) := by
      push_cast; rfl
    rw [h_cast, norm_mul, norm_mul, AddChar.norm_apply, one_mul,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hM_sub_nonneg x.1),
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hL_nonneg x.1)]
  let e_cop : S_cop ≃ {y : S_uncond // IsUnit (Ideal.Quotient.mk q y.1)} :=
    { toFun := fun x => ⟨⟨x.1, x.2.1, x.2.2.1⟩, x.2.2.2⟩
      invFun := fun y => ⟨y.1.1, y.1.2.1, y.1.2.2, y.2⟩
      left_inv := fun x => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_lhs_le :
      ‖(∑' π : S_cop, term π) -
        (∑' k : I_sub,
          ∑' π : S_cube_cop k,
            ψ (Additive.ofMul π.2.2.2.unit) *
              (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
      ≤ ∑ y ∈ Finset.univ.filter (fun y : S_uncond => IsUnit (Ideal.Quotient.mk q y.1)),
          (1 - ((M y.1).card : ℝ)) * L y.1 := by
    rw [h_lhs_diff]
    calc ‖∑ x : S_cop, (1 - ((M x.1).card : ℂ)) * term x‖
      _ ≤ ∑ x : S_cop, ‖(1 - ((M x.1).card : ℂ)) * term x‖ :=
        norm_sum_le _ _
      _ = ∑ x : S_cop, (1 - ((M x.1).card : ℝ)) * L x.1 :=
        Finset.sum_congr rfl (fun x _ => h_term_norm x)
      _ = ∑ z : {y : S_uncond // IsUnit (Ideal.Quotient.mk q y.1)},
            (1 - ((M z.1.1).card : ℝ)) * L z.1.1 :=
        Equiv.sum_comp e_cop (fun z : {y : S_uncond // IsUnit (Ideal.Quotient.mk q y.1)} =>
          (1 - ((M z.1.1).card : ℝ)) * L z.1.1)
      _ = ∑ y ∈ Finset.univ.filter (fun y : S_uncond => IsUnit (Ideal.Quotient.mk q y.1)),
            (1 - ((M y.1).card : ℝ)) * L y.1 :=
        (Finset.sum_subtype (Finset.univ.filter (fun y : S_uncond => IsUnit (Ideal.Quotient.mk q y.1)))
          (fun _ => by simp) (fun y : S_uncond => (1 - ((M y.1).card : ℝ)) * L y.1)).symm
  have h_rhs1 : (∑' y : S_uncond, L y.1) = ∑ y : S_uncond, L y.1 :=
    tsum_fintype (fun y : S_uncond => L y.1)
  let S_cube_uncond (k : I_sub) :=
    {π : NumberField.RingOfIntegers K //
      Prime π ∧ P_cube k.1 (NumberField.mixedEmbedding K (π : K))}
  let e_cube_uncond (k : I_sub) :
      S_cube_uncond k ≃ {y : S_uncond // P_cube k.1 (NumberField.mixedEmbedding K (y.1 : K))} :=
    { toFun := fun π => ⟨⟨π.1, π.2.1, k.2 π.2.2⟩, π.2.2⟩
      invFun := fun y => ⟨y.1.1, y.1.2.1, y.2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_rhs_cube : ∀ k : I_sub,
      (∑' π : S_cube_uncond k, L π.1) =
      ∑ y : S_uncond, (if P_cube k.1 (NumberField.mixedEmbedding K (y.1 : K)) then L y.1 else 0) := by
    intro k
    change (∑' π : S_cube_uncond k, L (e_cube_uncond k π).1.1) = _
    rw [Equiv.tsum_eq (e_cube_uncond k)
      (fun z : {y : S_uncond // P_cube k.1 (NumberField.mixedEmbedding K (y.1 : K))} => L z.1.1),
      tsum_fintype]
    have hsub : (∑ z : {y : S_uncond // P_cube k.1 (NumberField.mixedEmbedding K (y.1 : K))}, L z.1.1) =
        ∑ y ∈ Finset.univ.filter (fun y : S_uncond => P_cube k.1 (NumberField.mixedEmbedding K (y.1 : K))), L y.1 :=
      (Finset.sum_subtype (Finset.univ.filter (fun y : S_uncond => P_cube k.1 (NumberField.mixedEmbedding K (y.1 : K))))
        (fun _ => by simp) (fun y : S_uncond => L y.1)).symm
    rw [hsub, Finset.sum_filter]
  have h_rhs2 :
      (∑' k : I_sub, ∑' π : S_cube_uncond k, L π.1) =
      ∑ y : S_uncond, ((M y.1).card : ℝ) * L y.1 := by
    rw [tsum_fintype]
    simp_rw [h_rhs_cube]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun y _ => ?_)
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
  have h_rhs_diff :
      (∑' y : S_uncond, L y.1) -
      (∑' k : I_sub, ∑' π : S_cube_uncond k, L π.1)
      = ∑ y : S_uncond, (1 - ((M y.1).card : ℝ)) * L y.1 := by
    rw [h_rhs1, h_rhs2, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun y _ => ?_)
    ring
  have h_rhs_nonneg :
      0 ≤ ∑ y : S_uncond, (1 - ((M y.1).card : ℝ)) * L y.1 :=
    Finset.sum_nonneg (fun y _ => mul_nonneg (hM_sub_nonneg y.1) (hL_nonneg y.1))
  have h_rhs_abs :
      |(∑' y : S_uncond, L y.1) -
        (∑' k : I_sub, ∑' π : S_cube_uncond k, L π.1)|
      = ∑ y : S_uncond, (1 - ((M y.1).card : ℝ)) * L y.1 := by
    rw [h_rhs_diff, abs_of_nonneg h_rhs_nonneg]
  change ‖(∑' π : S_cop, term π) -
      (∑' k : I_sub,
        ∑' π : S_cube_cop k,
          ψ (Additive.ofMul π.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
    ≤ |(∑' y : S_uncond, L y.1) -
      (∑' k : I_sub, ∑' π : S_cube_uncond k, L π.1)|
  rw [h_rhs_abs]
  refine le_trans h_lhs_le ?_
  exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
    (fun y _ _ => mul_nonneg (hM_sub_nonneg y.1) (hL_nonneg y.1))

theorem mitsui_prime_char_grid_cube_norm_le_uncond {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (m : ℕ) (hm : 1 ≤ m)
    (k : NumberField.mixedEmbedding.index K → Fin (2 * m))
    (hQ_bdd : ∀ z : NumberField.mixedEmbedding.mixedSpace K,
        (∀ i : NumberField.mixedEmbedding.index K,
          (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
            Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) →
        ∀ w : NumberField.InfinitePlace K,
          NumberField.mixedEmbedding.normAtPlace w z < X)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ) :
    ‖∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          (∀ i : NumberField.mixedEmbedding.index K,
            (NumberField.mixedEmbedding.stdBasis K).repr
                (NumberField.mixedEmbedding K (π : K)) i ∈
              Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)‖ ≤
      |∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧
            ∀ i : NumberField.mixedEmbedding.index K,
              (NumberField.mixedEmbedding.stdBasis K).repr
                  (NumberField.mixedEmbedding K (π : K)) i ∈
                Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)| :=
by
  classical
  have hq_bot : q ≠ ⊥ := hq
  haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
    Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
  let P_cube : NumberField.mixedEmbedding.mixedSpace K → Prop :=
    fun z => ∀ i : NumberField.mixedEmbedding.index K,
      (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
        Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
          ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))
  let B_X : Set K := {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}
  have hB_fin : B_X.Finite := NumberField.Embeddings.finite_of_norm_le K ℂ X
  let S_cube : Set (NumberField.RingOfIntegers K) :=
    {x : NumberField.RingOfIntegers K | P_cube (NumberField.mixedEmbedding K (x : K))}
  have hpre_fin : (algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X).Finite :=
    hB_fin.preimage NumberField.RingOfIntegers.coe_injective.injOn
  have hS_sub : S_cube ⊆ algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X := by
    intro x hx
    refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, ?_⟩
    intro φ
    let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
    have hw1 : w (x : K) = ‖φ (x : K)‖ := NumberField.InfinitePlace.apply φ (x : K)
    have hw2 : NumberField.mixedEmbedding.normAtPlace w (NumberField.mixedEmbedding K (x : K)) = w (x : K) :=
      NumberField.mixedEmbedding.normAtPlace_apply w (x : K)
    have hlt : NumberField.mixedEmbedding.normAtPlace w (NumberField.mixedEmbedding K (x : K)) < X :=
      hQ_bdd (NumberField.mixedEmbedding K (x : K)) hx w
    change ‖φ (x : K)‖ ≤ X
    linarith
  have hS_fin : S_cube.Finite := hpre_fin.subset hS_sub
  let F : Finset (NumberField.RingOfIntegers K) := hS_fin.toFinset
  have hF_mem : ∀ x : NumberField.RingOfIntegers K,
      x ∈ F ↔ P_cube (NumberField.mixedEmbedding K (x : K)) :=
    fun x => hS_fin.mem_toFinset
  let w_real : NumberField.RingOfIntegers K → ℝ :=
    fun π => Real.log ((Algebra.norm ℤ π).natAbs : ℝ)
  have h_nonneg : ∀ π : NumberField.RingOfIntegers K, 0 ≤ w_real π :=
    fun _ => Real.log_natCast_nonneg _
  let S₁ := {π : NumberField.RingOfIntegers K //
      Prime π ∧
      P_cube (NumberField.mixedEmbedding K (π : K)) ∧
      IsUnit (Ideal.Quotient.mk q π)}
  have hS₁_fin : {π : NumberField.RingOfIntegers K |
      Prime π ∧
      P_cube (NumberField.mixedEmbedding K (π : K)) ∧
      IsUnit (Ideal.Quotient.mk q π)}.Finite :=
    hS_fin.subset (fun _ h => h.2.1)
  letI : Fintype S₁ := hS₁_fin.fintype
  let term : S₁ → ℂ := fun π =>
    ψ (Additive.ofMul π.2.2.2.unit) * (w_real π.1 : ℂ)
  have h_term_norm : ∀ π : S₁, ‖term π‖ = w_real π.1 := by
    intro π
    dsimp [term]
    rw [norm_mul, AddChar.norm_apply, one_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (h_nonneg π.1)]
  have h_mem_F_S₁ : ∀ π : NumberField.RingOfIntegers K,
      π ∈ F.filter (fun π => Prime π ∧ IsUnit (Ideal.Quotient.mk q π)) ↔
        Prime π ∧ P_cube (NumberField.mixedEmbedding K (π : K)) ∧
          IsUnit (Ideal.Quotient.mk q π) := by
    intro π
    simp only [Finset.mem_filter, hF_mem]
    tauto
  have h_lhs_le :
      ‖∑' π : S₁, term π‖ ≤
        ∑ π ∈ F.filter (fun π => Prime π ∧ IsUnit (Ideal.Quotient.mk q π)), w_real π := by
    rw [tsum_fintype term]
    calc ‖∑ π ∈ Finset.univ, term π‖
      _ ≤ ∑ π ∈ Finset.univ, ‖term π‖ := norm_sum_le _ _
      _ = ∑ π : S₁, w_real π.1 := Finset.sum_congr rfl (fun π _ => h_term_norm π)
      _ = ∑ π ∈ F.filter (fun π => Prime π ∧ IsUnit (Ideal.Quotient.mk q π)), w_real π :=
        (Finset.sum_subtype (F.filter (fun π => Prime π ∧ IsUnit (Ideal.Quotient.mk q π)))
          h_mem_F_S₁ w_real).symm
  have h_iff1 : ∀ π : NumberField.RingOfIntegers K,
      (Prime π ∧ P_cube (NumberField.mixedEmbedding K (π : K))) ↔
        π ∈ F.filter Prime := by
    intro π
    simp only [Finset.mem_filter, hF_mem]
    tauto
  let e₁ : {π : NumberField.RingOfIntegers K //
      Prime π ∧ P_cube (NumberField.mixedEmbedding K (π : K))} ≃
      {π : NumberField.RingOfIntegers K // π ∈ F.filter Prime} :=
    Equiv.subtypeEquivRight h_iff1
  have h_tsum1 :
      (∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧ P_cube (NumberField.mixedEmbedding K (π : K))},
          w_real π.1)
      = ∑ π ∈ F.filter Prime, w_real π := by
    rw [← Equiv.tsum_eq e₁.symm (fun π => w_real π.1)]
    exact Finset.tsum_subtype (F.filter Prime) w_real
  refine le_trans h_lhs_le ?_
  refine le_trans ?_ (le_abs_self _)
  rw [h_tsum1]
  refine Finset.sum_le_sum_of_subset_of_nonneg ?_ (fun π _ _ => h_nonneg π)
  intro π hπ
  simp only [Finset.mem_filter] at hπ ⊢
  exact ⟨hπ.1, hπ.2.1⟩

theorem mitsui_prime_grid_cube_upper_bound {K : Type u} [Field K] [NumberField K] :
    ∃ c_pack : ℝ, 0 < c_pack ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m → (m : ℝ) ≤ X →
          ∀ k : NumberField.mixedEmbedding.index K → Fin (2 * m),
            (∀ z : NumberField.mixedEmbedding.mixedSpace K,
                (∀ i : NumberField.mixedEmbedding.index K,
                  (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
                    Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                      ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) →
                ∀ w : NumberField.InfinitePlace K,
                  NumberField.mixedEmbedding.normAtPlace w z < X) →
            |∑' π : {π : NumberField.RingOfIntegers K //
                  Prime π ∧
                  ∀ i : NumberField.mixedEmbedding.index K,
                    (NumberField.mixedEmbedding.stdBasis K).repr
                        (NumberField.mixedEmbedding K (π : K)) i ∈
                      Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                        ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))},
                Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)| ≤
              c_pack * (X / (m : ℝ)) ^ (Module.finrank ℚ K) * (Real.log X + 1) :=
by
  classical
  letI : VAdd (NumberField.mixedEmbedding.integerLattice K)
    (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.vaddSet
  letI : VAdd (NumberField.mixedEmbedding.mixedSpace K)
    (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.vaddSet
  letI : SMul ℝ (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.smulSet
  let b := NumberField.mixedEmbedding.stdBasis K
  let F_lat : Set (NumberField.mixedEmbedding.mixedSpace K) :=
    ZSpan.fundamentalDomain (NumberField.mixedEmbedding.latticeBasis K)
  let F_std : Set (NumberField.mixedEmbedding.mixedSpace K) :=
    ZSpan.fundamentalDomain b
  have hF_bdd : Bornology.IsBounded F_lat :=
    ZSpan.fundamentalDomain_isBounded (NumberField.mixedEmbedding.latticeBasis K)
  obtain ⟨D, hD_gt1, hF_ball⟩ := hF_bdd.subset_ball_lt 1 0
  have hD_pos : 0 < D := by linarith
  have hF_coord : ∀ u ∈ F_lat, ∀ i : NumberField.mixedEmbedding.index K,
      -D < b.repr u i ∧ b.repr u i < D := by
    intro u hu i
    have hu_norm : ‖u‖ < D := by
      have h1 := hF_ball hu
      rwa [Metric.mem_ball, dist_zero_right] at h1
    have habs : |b.repr u i| < D := by
      rcases i with w | ⟨w, j⟩
      · rw [NumberField.mixedEmbedding.stdBasis_apply_isReal u w, ← Real.norm_eq_abs]
        have h1 : ‖u.1 w‖ ≤ ‖u.1‖ := norm_le_pi_norm u.1 w
        have h2 : ‖u.1‖ ≤ ‖u‖ := by
          rw [Prod.norm_def]
          exact le_max_left _ _
        exact lt_of_le_of_lt (le_trans h1 h2) hu_norm
      · fin_cases j
        · change |(b.repr u) (Sum.inr (w, 0))| < D
          rw [NumberField.mixedEmbedding.stdBasis_apply_isComplex_fst u w]
          have h0 : |(u.2 w).re| ≤ ‖u.2 w‖ := Complex.abs_re_le_norm (u.2 w)
          have h1 : ‖u.2 w‖ ≤ ‖u.2‖ := norm_le_pi_norm u.2 w
          have h2 : ‖u.2‖ ≤ ‖u‖ := by
            rw [Prod.norm_def]
            exact le_max_right _ _
          exact lt_of_le_of_lt (le_trans h0 (le_trans h1 h2)) hu_norm
        · change |(b.repr u) (Sum.inr (w, 1))| < D
          rw [NumberField.mixedEmbedding.stdBasis_apply_isComplex_snd u w]
          have h0 : |(u.2 w).im| ≤ ‖u.2 w‖ := Complex.abs_im_le_norm (u.2 w)
          have h1 : ‖u.2 w‖ ≤ ‖u.2‖ := norm_le_pi_norm u.2 w
          have h2 : ‖u.2‖ ≤ ‖u‖ := by
            rw [Prod.norm_def]
            exact le_max_right _ _
          exact lt_of_le_of_lt (le_trans h0 (le_trans h1 h2)) hu_norm
    exact abs_lt.mp habs
  have hF_fund : MeasureTheory.IsAddFundamentalDomain
      (NumberField.mixedEmbedding.integerLattice K) F_lat MeasureTheory.volume :=
    NumberField.mixedEmbedding.fundamentalDomain_integerLattice K
  have hF_meas : MeasurableSet F_lat :=
    ZSpan.fundamentalDomain_measurableSet (NumberField.mixedEmbedding.latticeBasis K)
  let V_K : ℝ := (MeasureTheory.volume F_lat).toReal
  have hVK_pos : 0 < V_K := by
    dsimp [V_K, F_lat]
    rw [NumberField.mixedEmbedding.volume_fundamentalDomain_latticeBasis K]
    rw [ENNReal.toReal_mul, ENNReal.toReal_pow, ENNReal.coe_toReal]
    have hdiscr : NumberField.discr K ≠ 0 := NumberField.discr_ne_zero K
    have hsqrt_pos : (0 : NNReal) < NNReal.sqrt ‖NumberField.discr K‖₊ :=
      NNReal.sqrt_pos.mpr (nnnorm_pos.mpr hdiscr)
    have hsqrt_rpos : (0 : ℝ) < (NNReal.sqrt ‖NumberField.discr K‖₊ : ℝ) :=
      NNReal.coe_pos.mpr hsqrt_pos
    have h2 : (0 : ℝ) < ENNReal.toReal 2⁻¹ := by norm_num
    positivity
  let n : ℕ := Module.finrank ℚ K
  have hn_pos : 0 < n := Module.finrank_pos
  have hnR_pos : (0 : ℝ) < (n : ℝ) := Nat.cast_pos.mpr hn_pos
  let c_lat : ℝ := (1 + 2 * D) ^ n / V_K
  have hc_lat_pos : 0 < c_lat := by dsimp [c_lat]; positivity
  let c_pack : ℝ := (n : ℝ) * c_lat
  have hc_pack_pos : 0 < c_pack := mul_pos hnR_pos hc_lat_pos
  refine ⟨c_pack, hc_pack_pos, ?_⟩
  intro X hX m hm hm_le_X k hQ_bdd
  have hX_pos : 0 < X := by linarith
  have hlogX_pos : 0 < Real.log X := Real.log_pos hX
  have hmR_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  have hmR_pos : 0 < (m : ℝ) := lt_of_lt_of_le zero_lt_one hmR_ge_one
  set δ : ℝ := X / (m : ℝ)
  have hδ_ge_one : 1 ≤ δ := (one_le_div hmR_pos).mpr hm_le_X
  have hδ_pos : 0 < δ := lt_of_lt_of_le zero_lt_one hδ_ge_one
  let B_X : Set (NumberField.RingOfIntegers K) :=
    {x | ∀ w : NumberField.InfinitePlace K, w (x : K) < X}
  have hBX_fin : B_X.Finite := by
    have hBK_fin : {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}.Finite :=
      NumberField.Embeddings.finite_of_norm_le K ℂ X
    have hsub : B_X ⊆ (Subtype.val : NumberField.RingOfIntegers K → K) ⁻¹'
        {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X} := by
      intro x hx
      refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, fun φ => ?_⟩
      have hφ : (NumberField.InfinitePlace.mk φ) (x : K) = ‖φ (x : K)‖ :=
        NumberField.InfinitePlace.apply φ (x : K)
      have hxφ : (NumberField.InfinitePlace.mk φ) (x : K) < X := hx (NumberField.InfinitePlace.mk φ)
      change ‖φ (x : K)‖ ≤ X
      linarith
    exact (hBK_fin.preimage Subtype.val_injective.injOn).subset hsub
  let T_Q : Set (NumberField.RingOfIntegers K) :=
    {x | ∀ i : NumberField.mixedEmbedding.index K,
      b.repr (NumberField.mixedEmbedding K (x : K)) i ∈
        Set.Ico (δ * (((k i : ℕ) : ℝ) - (m : ℝ))) (δ * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))}
  have hTQ_sub_BX : T_Q ⊆ B_X := by
    intro x hx w
    rw [← NumberField.mixedEmbedding.normAtPlace_apply w (x : K)]
    exact hQ_bdd (NumberField.mixedEmbedding K (x : K)) hx w
  have hT_fin : T_Q.Finite := hBX_fin.subset hTQ_sub_BX
  let P_Q : Set (NumberField.RingOfIntegers K) :=
    {π | Prime π ∧ ∀ i : NumberField.mixedEmbedding.index K,
      b.repr (NumberField.mixedEmbedding K (π : K)) i ∈
        Set.Ico (δ * (((k i : ℕ) : ℝ) - (m : ℝ))) (δ * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))}
  have hP_fin : P_Q.Finite := hT_fin.subset (fun _ hπ => hπ.2)
  letI : Fintype P_Q := hP_fin.fintype
  let g : NumberField.RingOfIntegers K → ℝ :=
    fun x => Real.log ((Algebra.norm ℤ x).natAbs : ℝ)
  have hsumP : (∑' π : P_Q, g π) = ∑ π ∈ hP_fin.toFinset, g π := by
    rw [tsum_fintype]
    exact (Finset.sum_subtype hP_fin.toFinset (fun _ => hP_fin.mem_toFinset) g).symm
  change |∑' π : P_Q, g π| ≤ c_pack * δ ^ n * (Real.log X + 1)
  rw [hsumP]
  have hg_nonneg : ∀ π ∈ hP_fin.toFinset, 0 ≤ g π := by
    intro π hπ
    rw [Set.Finite.mem_toFinset] at hπ
    have hπ_ne : π ≠ 0 := hπ.1.ne_zero
    have hnorm_ne : Algebra.norm ℤ π ≠ 0 := Algebra.norm_ne_zero_iff.mpr hπ_ne
    have hnat_pos : 1 ≤ (Algebra.norm ℤ π).natAbs :=
      Nat.one_le_iff_ne_zero.mpr (Int.natAbs_ne_zero.mpr hnorm_ne)
    exact Real.log_nonneg (by exact_mod_cast hnat_pos)
  have hg_le : ∀ π ∈ hP_fin.toFinset, g π ≤ (n : ℝ) * (Real.log X + 1) := by
    intro π hπ
    rw [Set.Finite.mem_toFinset] at hπ
    have hπ_ne : π ≠ 0 := hπ.1.ne_zero
    have hnorm_ne : Algebra.norm ℤ π ≠ 0 := Algebra.norm_ne_zero_iff.mpr hπ_ne
    have hnat_pos : (0 : ℝ) < (Algebra.norm ℤ π).natAbs := by
      exact_mod_cast Int.natAbs_pos.mpr hnorm_ne
    have hprod_eq : (∏ w : NumberField.InfinitePlace K, w (π : K) ^ w.mult) =
        ((Algebra.norm ℤ π).natAbs : ℝ) := by
      rw [NumberField.InfinitePlace.prod_eq_abs_norm (π : K), ← Algebra.coe_norm_int π]
      rw [Nat.cast_natAbs]
      norm_cast
    have hprod_le : ((Algebra.norm ℤ π).natAbs : ℝ) ≤ X ^ n := by
      rw [← hprod_eq]
      have h1 : (∏ w : NumberField.InfinitePlace K, w (π : K) ^ w.mult) ≤
          ∏ w : NumberField.InfinitePlace K, X ^ w.mult := by
        apply Finset.prod_le_prod
        · intro w _
          positivity
        · intro w _
          exact pow_le_pow_left₀ (by positivity) (le_of_lt (hTQ_sub_BX hπ.2 w)) w.mult
      rwa [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq] at h1
    have hlog_le : g π ≤ Real.log (X ^ n) := Real.log_le_log hnat_pos hprod_le
    rw [Real.log_pow] at hlog_le
    have h_log_add : (n : ℝ) * Real.log X ≤ (n : ℝ) * (Real.log X + 1) :=
      mul_le_mul_of_nonneg_left (by linarith) (Nat.cast_nonneg n)
    exact le_trans hlog_le h_log_add
  rw [abs_of_nonneg (Finset.sum_nonneg hg_nonneg)]
  have h_s2_bound : ∑ π ∈ hP_fin.toFinset, g π ≤
      (hP_fin.toFinset.card : ℝ) * ((n : ℝ) * (Real.log X + 1)) := by
    calc ∑ π ∈ hP_fin.toFinset, g π
        ≤ ∑ _π ∈ hP_fin.toFinset, ((n : ℝ) * (Real.log X + 1)) := Finset.sum_le_sum hg_le
      _ = (hP_fin.toFinset.card : ℝ) * ((n : ℝ) * (Real.log X + 1)) := by
          rw [Finset.sum_const, nsmul_eq_mul]
  let j : NumberField.RingOfIntegers K → NumberField.mixedEmbedding.integerLattice K :=
    fun x => ⟨NumberField.mixedEmbedding K (x : K), ⟨x, rfl⟩⟩
  have hj_inj : Function.Injective j := by
    intro x y hxy
    have h : NumberField.mixedEmbedding K (x : K) = NumberField.mixedEmbedding K (y : K) :=
      congrArg Subtype.val hxy
    obtain ⟨w⟩ : Nonempty (NumberField.InfinitePlace K) := inferInstance
    have hsub : NumberField.mixedEmbedding K ((x : K) - (y : K)) = 0 := by
      rw [map_sub, h, sub_self]
    have hw : w ((x : K) - (y : K)) = 0 := by
      rw [← NumberField.mixedEmbedding.normAtPlace_apply w ((x : K) - (y : K)), hsub, map_zero]
    exact Subtype.ext (sub_eq_zero.mp ((AbsoluteValue.eq_zero w.1).mp hw))
  let T : Finset (NumberField.RingOfIntegers K) := hT_fin.toFinset
  let T_lat : Finset (NumberField.mixedEmbedding.integerLattice K) := T.map ⟨j, hj_inj⟩
  have haedisj : (T_lat : Set (NumberField.mixedEmbedding.integerLattice K)).Pairwise
      (Function.onFun (MeasureTheory.AEDisjoint MeasureTheory.volume) (fun g => g +ᵥ F_lat)) := by
    intro g₁ _ g₂ _ hne
    exact hF_fund.aedisjoint hne
  have hnull : ∀ g ∈ T_lat, MeasureTheory.NullMeasurableSet (g +ᵥ F_lat) MeasureTheory.volume := by
    intro g _
    change MeasureTheory.NullMeasurableSet ((g : NumberField.mixedEmbedding.mixedSpace K) +ᵥ F_lat) MeasureTheory.volume
    exact (hF_meas.const_vadd (g : NumberField.mixedEmbedding.mixedSpace K)).nullMeasurableSet
  have hvol_union : MeasureTheory.volume (⋃ g ∈ T_lat, g +ᵥ F_lat) =
      (T.card : ENNReal) * MeasureTheory.volume F_lat := by
    rw [MeasureTheory.measure_biUnion_finset₀ haedisj hnull]
    have h_each : ∀ g ∈ T_lat, MeasureTheory.volume (g +ᵥ F_lat) = MeasureTheory.volume F_lat := by
      intro g _
      change MeasureTheory.volume ((g : NumberField.mixedEmbedding.mixedSpace K) +ᵥ F_lat) = MeasureTheory.volume F_lat
      exact MeasureTheory.measure_vadd MeasureTheory.volume (g : NumberField.mixedEmbedding.mixedSpace K) F_lat
    rw [Finset.sum_congr rfl h_each, Finset.sum_const, nsmul_eq_mul, Finset.card_map]
  let v₀ : NumberField.mixedEmbedding.mixedSpace K :=
    b.equivFun.symm (fun i => δ * (((k i : ℕ) : ℝ) - (m : ℝ) - D))
  let L : ℝ := (1 + 2 * D) * δ
  have hL_pos : 0 < L := by dsimp [L]; positivity
  have hL_ne : L ≠ 0 := ne_of_gt hL_pos
  have hv₀_repr : ∀ i : NumberField.mixedEmbedding.index K,
      b.repr v₀ i = δ * (((k i : ℕ) : ℝ) - (m : ℝ) - D) := by
    intro i
    change (b.equivFun v₀) i = _
    rw [LinearEquiv.apply_symm_apply]
  have hsub_cube : (⋃ g ∈ T_lat, g +ᵥ F_lat) ⊆ v₀ +ᵥ (L • F_std) := by
    intro z hz
    simp only [Set.mem_iUnion] at hz
    rcases hz with ⟨g, hg, hzF⟩
    rcases Finset.mem_map.mp hg with ⟨x, hxT, rfl⟩
    rw [Set.Finite.mem_toFinset] at hxT
    rcases hzF with ⟨u, huF, rfl⟩
    change (NumberField.mixedEmbedding K (x : K) + u) ∈ v₀ +ᵥ (L • F_std)
    let w : NumberField.mixedEmbedding.mixedSpace K :=
      L⁻¹ • ((NumberField.mixedEmbedding K (x : K) + u) - v₀)
    have hw_in : w ∈ F_std := by
      rw [ZSpan.mem_fundamentalDomain]
      intro i
      dsimp [w]
      rw [map_smul, map_sub, map_add, Finsupp.smul_apply, Finsupp.sub_apply, Finsupp.add_apply,
          smul_eq_mul, hv₀_repr i]
      have hxi := hxT i
      have hui := hF_coord u huF i
      have hDδ : D ≤ D * δ := le_mul_of_one_le_right (le_of_lt hD_pos) hδ_ge_one
      have h_num_nonneg : 0 ≤ (b.repr (NumberField.mixedEmbedding K (x : K)) i + b.repr u i) -
          δ * (((k i : ℕ) : ℝ) - (m : ℝ) - D) := by
        linarith [hxi.1, hui.1]
      have h_num_lt : (b.repr (NumberField.mixedEmbedding K (x : K)) i + b.repr u i) -
          δ * (((k i : ℕ) : ℝ) - (m : ℝ) - D) < L := by
        dsimp [L]
        linarith [hxi.2, hui.2]
      refine ⟨mul_nonneg (inv_nonneg.mpr (le_of_lt hL_pos)) h_num_nonneg, ?_⟩
      rw [inv_mul_lt_iff₀ hL_pos, mul_one]
      exact h_num_lt
    refine ⟨L • w, ⟨w, hw_in, rfl⟩, ?_⟩
    dsimp [w]
    rw [smul_smul, mul_inv_cancel₀ hL_ne, one_smul]
    abel
  have hvol_cube : MeasureTheory.volume (v₀ +ᵥ (L • F_std)) =
      ENNReal.ofReal ((1 + 2 * D) ^ n * δ ^ n) := by
    rw [MeasureTheory.measure_vadd, MeasureTheory.Measure.addHaar_smul,
        NumberField.mixedEmbedding.finrank K,
        NumberField.mixedEmbedding.volume_fundamentalDomain_stdBasis K, mul_one]
    have hLn_pos : 0 ≤ L ^ n := by positivity
    rw [abs_of_nonneg hLn_pos]
    dsimp [L, n]
    rw [mul_pow]
  have hvol_le : (T.card : ENNReal) * MeasureTheory.volume F_lat ≤
      ENNReal.ofReal ((1 + 2 * D) ^ n * δ ^ n) := by
    rw [← hvol_union, ← hvol_cube]
    exact MeasureTheory.measure_mono hsub_cube
  have htoReal := ENNReal.toReal_mono ENNReal.ofReal_ne_top hvol_le
  rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity), ENNReal.toReal_natCast] at htoReal
  have hT_card_le : (T.card : ℝ) ≤ c_lat * δ ^ n := by
    dsimp [c_lat]
    rw [div_mul_eq_mul_div, le_div_iff₀ hVK_pos]
    exact htoReal
  have hP_sub_T : hP_fin.toFinset ⊆ T := by
    intro π hπ
    rw [Set.Finite.mem_toFinset] at hπ ⊢
    exact hπ.2
  have hcard_le : (hP_fin.toFinset.card : ℝ) ≤ (T.card : ℝ) := by
    exact_mod_cast Finset.card_le_card hP_sub_T
  calc ∑ π ∈ hP_fin.toFinset, g π
    _ ≤ (hP_fin.toFinset.card : ℝ) * ((n : ℝ) * (Real.log X + 1)) := h_s2_bound
    _ ≤ (c_lat * δ ^ n) * ((n : ℝ) * (Real.log X + 1)) :=
        mul_le_mul_of_nonneg_right (le_trans hcard_le hT_card_le) (by positivity)
    _ = c_pack * δ ^ n * (Real.log X + 1) := by
        dsimp [c_pack]
        ring

theorem mitsui_prime_char_grid_cube_to_ge_one_le {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (m : ℕ) (hm : 1 ≤ m)
    (k : NumberField.mixedEmbedding.index K → Fin (2 * m))
    (hQ_bdd : ∀ z : NumberField.mixedEmbedding.mixedSpace K,
        (∀ i : NumberField.mixedEmbedding.index K,
          (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
            Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) →
        ∀ w : NumberField.InfinitePlace K,
          NumberField.mixedEmbedding.normAtPlace w z < X)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ) :
    ‖(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          (∀ i : NumberField.mixedEmbedding.index K,
            (NumberField.mixedEmbedding.stdBasis K).repr
                (NumberField.mixedEmbedding K (π : K)) i ∈
              Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      - (∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧
            (∀ i : NumberField.mixedEmbedding.index K,
              (NumberField.mixedEmbedding.stdBasis K).repr
                  (NumberField.mixedEmbedding K (π : K)) i ∈
                Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                  ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
            (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K)) ∧
            IsUnit (Ideal.Quotient.mk q π)},
          ψ (Additive.ofMul π.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
    ≤ |(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      - (∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))| :=
by
  classical
  have hq_bot : q ≠ ⊥ := hq
  haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
    Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
  let B_X : Set K := {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}
  have hB_fin : B_X.Finite := NumberField.Embeddings.finite_of_norm_le K ℂ X
  let S_box : Set (NumberField.RingOfIntegers K) :=
    {x : NumberField.RingOfIntegers K | ∀ w : NumberField.InfinitePlace K, w (x : K) < X}
  have hpre_fin : (algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X).Finite :=
    hB_fin.preimage NumberField.RingOfIntegers.coe_injective.injOn
  have hS_sub : S_box ⊆ algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X := by
    intro x hx
    refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, ?_⟩
    intro φ
    let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
    have hw1 : w (x : K) = ‖φ (x : K)‖ := NumberField.InfinitePlace.apply φ (x : K)
    have hlt : w (x : K) < X := hx w
    change ‖φ (x : K)‖ ≤ X
    linarith
  have hS_fin : S_box.Finite := hpre_fin.subset hS_sub
  let F : Finset (NumberField.RingOfIntegers K) := hS_fin.toFinset
  have hF_mem : ∀ x : NumberField.RingOfIntegers K,
      x ∈ F ↔ ∀ w : NumberField.InfinitePlace K, w (x : K) < X :=
    fun x => hS_fin.mem_toFinset
  let P_cube : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ i : NumberField.mixedEmbedding.index K,
      (NumberField.mixedEmbedding.stdBasis K).repr
          (NumberField.mixedEmbedding K (π : K)) i ∈
        Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
          ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))
  have h_cube_lt : ∀ x : NumberField.RingOfIntegers K,
      P_cube x → ∀ w : NumberField.InfinitePlace K, w (x : K) < X := by
    intro x hx w
    rw [← NumberField.mixedEmbedding.normAtPlace_apply w (x : K)]
    exact hQ_bdd (NumberField.mixedEmbedding K (x : K)) hx w
  let w_real : NumberField.RingOfIntegers K → ℝ :=
    fun π => Real.log ((Algebra.norm ℤ π).natAbs : ℝ)
  have h_nonneg : ∀ π : NumberField.RingOfIntegers K, 0 ≤ w_real π :=
    fun _ => Real.log_natCast_nonneg _
  let P_ge : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K)
  let S₁ := {π : NumberField.RingOfIntegers K //
      Prime π ∧ P_cube π ∧ IsUnit (Ideal.Quotient.mk q π)}
  have hS₁_fin : {π : NumberField.RingOfIntegers K |
      Prime π ∧ P_cube π ∧ IsUnit (Ideal.Quotient.mk q π)}.Finite :=
    hS_fin.subset (fun x h => h_cube_lt x h.2.1)
  letI : Fintype S₁ := hS₁_fin.fintype
  let S₂ := {π : NumberField.RingOfIntegers K //
      Prime π ∧ P_cube π ∧ P_ge π ∧ IsUnit (Ideal.Quotient.mk q π)}
  let term : S₁ → ℂ := fun π =>
    ψ (Additive.ofMul π.2.2.2.unit) * (w_real π.1 : ℂ)
  let e_ge : S₂ ≃ {π : S₁ // P_ge π.1} :=
    { toFun := fun π => ⟨⟨π.1, π.2.1, π.2.2.1, π.2.2.2.2⟩, π.2.2.2.1⟩
      invFun := fun π => ⟨π.1.1, π.1.2.1, π.1.2.2.1, π.2, π.1.2.2.2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun π => by ext; rfl }
  have h_lhs1 : (∑' π : S₁, term π) = ∑ π ∈ Finset.univ, term π :=
    tsum_fintype term
  have h_lhs2 :
      (∑' π : S₂,
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑ π ∈ Finset.univ.filter (fun π : S₁ => P_ge π.1), term π := by
    change (∑' π : S₂, term (e_ge π).1) = _
    rw [Equiv.tsum_eq e_ge (fun y : {π : S₁ // P_ge π.1} => term y.1), tsum_fintype]
    exact (Finset.sum_subtype (Finset.univ.filter (fun π : S₁ => P_ge π.1))
      (fun _ => by simp) term).symm
  have h_lhs_split :
      ∑ π ∈ Finset.univ.filter (fun π : S₁ => P_ge π.1), term π +
      ∑ π ∈ Finset.univ.filter (fun π : S₁ => ¬ P_ge π.1), term π =
      ∑ π ∈ Finset.univ, term π :=
    Finset.sum_filter_add_sum_filter_not Finset.univ (fun π : S₁ => P_ge π.1) term
  have h_lhs_diff :
      (∑' π : S₁, term π) -
      (∑' π : S₂,
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑ π ∈ Finset.univ.filter (fun π : S₁ => ¬ P_ge π.1), term π := by
    rw [h_lhs1, h_lhs2, ← h_lhs_split]
    ring
  have h_term_norm : ∀ π : S₁, ‖term π‖ = w_real π.1 := by
    intro π
    dsimp [term]
    rw [norm_mul, AddChar.norm_apply, one_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (h_nonneg π.1)]
  have h_mem_F_S₁ : ∀ π : NumberField.RingOfIntegers K,
      π ∈ F.filter (fun π => Prime π ∧ P_cube π ∧ IsUnit (Ideal.Quotient.mk q π)) ↔
        Prime π ∧ P_cube π ∧ IsUnit (Ideal.Quotient.mk q π) := by
    intro π
    simp only [Finset.mem_filter, hF_mem]
    exact ⟨fun h => h.2, fun h => ⟨h_cube_lt π h.2.1, h⟩⟩
  have h_lhs_le :
      ‖(∑' π : S₁, term π) -
        (∑' π : S₂,
          ψ (Additive.ofMul π.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
      ≤ ∑ π ∈ (F.filter (fun π => Prime π ∧ P_cube π ∧ IsUnit (Ideal.Quotient.mk q π))).filter
          (fun π => ¬ P_ge π), w_real π := by
    rw [h_lhs_diff]
    calc ‖∑ π ∈ Finset.univ.filter (fun π : S₁ => ¬ P_ge π.1), term π‖
      _ ≤ ∑ π ∈ Finset.univ.filter (fun π : S₁ => ¬ P_ge π.1), ‖term π‖ :=
        norm_sum_le _ _
      _ = ∑ π ∈ Finset.univ.filter (fun π : S₁ => ¬ P_ge π.1), w_real π.1 := by
        refine Finset.sum_congr rfl (fun π _ => h_term_norm π)
      _ = ∑ π : S₁, (if ¬ P_ge π.1 then w_real π.1 else 0) := by
        rw [Finset.sum_filter]
      _ = ∑ π ∈ F.filter (fun π => Prime π ∧ P_cube π ∧ IsUnit (Ideal.Quotient.mk q π)),
            (if ¬ P_ge π then w_real π else 0) := by
        exact (Finset.sum_subtype (F.filter (fun π => Prime π ∧ P_cube π ∧ IsUnit (Ideal.Quotient.mk q π)))
          h_mem_F_S₁ (fun π => if ¬ P_ge π then w_real π else 0)).symm
      _ = ∑ π ∈ (F.filter (fun π => Prime π ∧ P_cube π ∧ IsUnit (Ideal.Quotient.mk q π))).filter
            (fun π => ¬ P_ge π), w_real π := by
        rw [← Finset.sum_filter]
  have h_rhs_diff :
      (∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
          w_real π.1)
      - (∑' π : {π : NumberField.RingOfIntegers K //
              Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X},
            w_real π.1)
      = ∑ π ∈ (F.filter Prime).filter (fun π => ¬ P_ge π), w_real π := by
    have h_iff1 : ∀ π : NumberField.RingOfIntegers K,
        (Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X) ↔
          π ∈ F.filter Prime := by
      intro π
      simp only [Finset.mem_filter, hF_mem]
      tauto
    let e₁ : {π : NumberField.RingOfIntegers K //
        Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X} ≃
        {π : NumberField.RingOfIntegers K // π ∈ F.filter Prime} :=
      Equiv.subtypeEquivRight h_iff1
    have h_tsum1 :
        (∑' π : {π : NumberField.RingOfIntegers K //
              Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
            w_real π.1)
        = ∑ π ∈ F.filter Prime, w_real π := by
      rw [← Equiv.tsum_eq e₁.symm (fun π => w_real π.1)]
      exact Finset.tsum_subtype (F.filter Prime) w_real
    have h_iff2 : ∀ π : NumberField.RingOfIntegers K,
        (Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X) ↔
          π ∈ (F.filter Prime).filter P_ge := by
      intro π
      simp only [Finset.mem_filter, hF_mem, P_ge, forall_and]
      tauto
    let e₂ : {π : NumberField.RingOfIntegers K //
        Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X} ≃
        {π : NumberField.RingOfIntegers K // π ∈ (F.filter Prime).filter P_ge} :=
      Equiv.subtypeEquivRight h_iff2
    have h_tsum2 :
        (∑' π : {π : NumberField.RingOfIntegers K //
              Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X},
            w_real π.1)
        = ∑ π ∈ (F.filter Prime).filter P_ge, w_real π := by
      rw [← Equiv.tsum_eq e₂.symm (fun π => w_real π.1)]
      exact Finset.tsum_subtype ((F.filter Prime).filter P_ge) w_real
    have h_split :
        ∑ π ∈ (F.filter Prime).filter P_ge, w_real π +
        ∑ π ∈ (F.filter Prime).filter (fun π => ¬ P_ge π), w_real π =
        ∑ π ∈ F.filter Prime, w_real π :=
      Finset.sum_filter_add_sum_filter_not (F.filter Prime) P_ge w_real
    rw [h_tsum1, h_tsum2, ← h_split]
    ring
  refine le_trans h_lhs_le ?_
  refine le_trans ?_ (le_abs_self _)
  rw [h_rhs_diff]
  refine Finset.sum_le_sum_of_subset_of_nonneg ?_ (fun π _ _ => h_nonneg π)
  intro π hπ
  simp only [Finset.mem_filter] at hπ ⊢
  exact ⟨⟨hπ.1.1, hπ.1.2.1⟩, hπ.2⟩

theorem mitsui_prime_box_to_ge_one {K : Type u} [Field K] [NumberField K] :
    ∃ c₁ : ℝ, 0 < c₁ ∧
      ∀ X : ℝ, 1 < X →
        |(∑' π : {π : NumberField.RingOfIntegers K //
              Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
            Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
          - (∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))|
          ≤ c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁) :=
by
  classical
  letI : VAdd (NumberField.mixedEmbedding.integerLattice K)
    (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.vaddSet
  letI : VAdd (NumberField.mixedEmbedding.mixedSpace K)
    (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.vaddSet
  let F : Set (NumberField.mixedEmbedding.mixedSpace K) :=
    ZSpan.fundamentalDomain (NumberField.mixedEmbedding.latticeBasis K)
  have hF_bdd : Bornology.IsBounded F :=
    ZSpan.fundamentalDomain_isBounded (NumberField.mixedEmbedding.latticeBasis K)
  obtain ⟨D, hD_gt1, hF_ball⟩ := hF_bdd.subset_ball_lt 1 0
  have hD_ge1 : 1 ≤ D := le_of_lt hD_gt1
  have hD_pos : 0 < D := by linarith
  have hF_norm : ∀ z ∈ F, ∀ w : NumberField.InfinitePlace K,
      NumberField.mixedEmbedding.normAtPlace w z < D := by
    intro z hz w
    have hz_norm : ‖z‖ < D := by
      have h1 := hF_ball hz
      rwa [Metric.mem_ball, dist_zero_right] at h1
    rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
    · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw z]
      have h1 : ‖z.1 ⟨w, hw⟩‖ ≤ ‖z.1‖ := norm_le_pi_norm z.1 ⟨w, hw⟩
      have h2 : ‖z.1‖ ≤ ‖z‖ := by
        rw [Prod.norm_def]
        exact le_max_left _ _
      exact lt_of_le_of_lt (le_trans h1 h2) hz_norm
    · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hw z]
      have h1 : ‖z.2 ⟨w, hw⟩‖ ≤ ‖z.2‖ := norm_le_pi_norm z.2 ⟨w, hw⟩
      have h2 : ‖z.2‖ ≤ ‖z‖ := by
        rw [Prod.norm_def]
        exact le_max_right _ _
      exact lt_of_le_of_lt (le_trans h1 h2) hz_norm
  have hF_fund : MeasureTheory.IsAddFundamentalDomain
      (NumberField.mixedEmbedding.integerLattice K) F MeasureTheory.volume :=
    NumberField.mixedEmbedding.fundamentalDomain_integerLattice K
  have hF_meas : MeasurableSet F :=
    ZSpan.fundamentalDomain_measurableSet (NumberField.mixedEmbedding.latticeBasis K)
  let V_K : ℝ := (MeasureTheory.volume F).toReal
  have hVK_pos : 0 < V_K := by
    dsimp [V_K, F]
    rw [NumberField.mixedEmbedding.volume_fundamentalDomain_latticeBasis K]
    rw [ENNReal.toReal_mul, ENNReal.toReal_pow, ENNReal.coe_toReal]
    have hdiscr : NumberField.discr K ≠ 0 := NumberField.discr_ne_zero K
    have hsqrt_pos : (0 : NNReal) < NNReal.sqrt ‖NumberField.discr K‖₊ :=
      NNReal.sqrt_pos.mpr (nnnorm_pos.mpr hdiscr)
    have hsqrt_rpos : (0 : ℝ) < (NNReal.sqrt ‖NumberField.discr K‖₊ : ℝ) :=
      NNReal.coe_pos.mpr hsqrt_pos
    have h2 : (0 : ℝ) < ENNReal.toReal 2⁻¹ := by norm_num
    positivity
  let n : ℕ := Module.finrank ℚ K
  have hn_pos : 1 ≤ n := Module.finrank_pos
  let C₀ : ℝ := max 1 ((Fintype.card (NumberField.InfinitePlace K) : ℝ) *
    ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) * (1 + D) ^ (n + 1) / V_K))
  have hC₀_pos : 0 < C₀ := lt_of_lt_of_le zero_lt_one (le_max_left _ _)
  let c₁ : ℝ := max 1 (4 * Real.exp 1 * C₀ * (n : ℝ))
  have hc₁_ge1 : 1 ≤ c₁ := le_max_left _ _
  have hc₁_pos : 0 < c₁ := lt_of_lt_of_le zero_lt_one hc₁_ge1
  have hc₁_ge_const : 4 * Real.exp 1 * C₀ * (n : ℝ) ≤ c₁ := le_max_right _ _
  refine ⟨c₁, hc₁_pos, ?_⟩
  intro X hX
  have hX_pos : 0 < X := by linarith
  
  let B_X : Set (NumberField.RingOfIntegers K) :=
    {x | ∀ w : NumberField.InfinitePlace K, w (x : K) < X}
  have hBX_fin : B_X.Finite := by
    have hBK_fin : {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}.Finite :=
      NumberField.Embeddings.finite_of_norm_le K ℂ X
    have hsub : B_X ⊆ (Subtype.val : NumberField.RingOfIntegers K → K) ⁻¹'
        {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X} := by
      intro x hx
      refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, fun φ => ?_⟩
      have hφ : (NumberField.InfinitePlace.mk φ) (x : K) = ‖φ (x : K)‖ :=
        NumberField.InfinitePlace.apply φ (x : K)
      have hxφ : (NumberField.InfinitePlace.mk φ) (x : K) < X := hx (NumberField.InfinitePlace.mk φ)
      change ‖φ (x : K)‖ ≤ X
      linarith
    exact (hBK_fin.preimage Subtype.val_injective.injOn).subset hsub
  let Q : Set (NumberField.RingOfIntegers K) :=
    {π | Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X}
  let P : Set (NumberField.RingOfIntegers K) :=
    {π | Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X}
  let R : Set (NumberField.RingOfIntegers K) :=
    {π | Prime π ∧ (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
      ¬ (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X)}
  let B : NumberField.InfinitePlace K → Set (NumberField.RingOfIntegers K) :=
    fun w₀ => {x | w₀ (x : K) < 1 ∧ ∀ w : NumberField.InfinitePlace K, w ≠ w₀ → w (x : K) < X}
  have hQ_fin : Q.Finite := hBX_fin.subset (fun _ hx => hx.2)
  have hP_fin : P.Finite := hBX_fin.subset (fun _ hx w => (hx.2 w).2)
  have hR_fin : R.Finite := hBX_fin.subset (fun _ hx => hx.2.1)
  have hB_fin : ∀ w₀, (B w₀).Finite := by
    intro w₀
    refine hBX_fin.subset (fun x hx w => ?_)
    by_cases hw : w = w₀
    · subst hw
      exact lt_trans hx.1 hX
    · exact hx.2 w hw
  letI : Fintype Q := hQ_fin.fintype
  letI : Fintype P := hP_fin.fintype
  let g : NumberField.RingOfIntegers K → ℝ :=
    fun x => Real.log ((Algebra.norm ℤ x).natAbs : ℝ)
  have hsumQ : (∑' π : Q, g π) = ∑ π ∈ hQ_fin.toFinset, g π := by
    rw [tsum_fintype]
    exact (Finset.sum_subtype hQ_fin.toFinset (fun _ => hQ_fin.mem_toFinset) g).symm
  have hsumP : (∑' π : P, g π) = ∑ π ∈ hP_fin.toFinset, g π := by
    rw [tsum_fintype]
    exact (Finset.sum_subtype hP_fin.toFinset (fun _ => hP_fin.mem_toFinset) g).symm
  change |(∑' π : Q, g π) - (∑' π : P, g π)| ≤
    c₁ * X ^ n * Real.exp (-Real.sqrt (Real.log X) / c₁)
  rw [hsumQ, hsumP]
  have hP_sub_Q : hP_fin.toFinset ⊆ hQ_fin.toFinset := by
    intro x hx
    rw [Set.Finite.mem_toFinset] at hx ⊢
    exact ⟨hx.1, fun w => (hx.2 w).2⟩
  have hQ_sdiff_P : hQ_fin.toFinset \ hP_fin.toFinset = hR_fin.toFinset := by
    ext x
    simp only [Finset.mem_sdiff, Set.Finite.mem_toFinset, P, Q, R, Set.mem_setOf_eq]
    tauto
  have h_sdiff := Finset.sum_sdiff hP_sub_Q (f := g)
  rw [hQ_sdiff_P] at h_sdiff
  have h_diff : (∑ π ∈ hQ_fin.toFinset, g π) - (∑ π ∈ hP_fin.toFinset, g π) =
      ∑ π ∈ hR_fin.toFinset, g π := by linarith
  rw [h_diff]
  have hg_nonneg : ∀ π ∈ hR_fin.toFinset, 0 ≤ g π := by
    intro π hπ
    rw [Set.Finite.mem_toFinset] at hπ
    have hπ_ne : π ≠ 0 := hπ.1.ne_zero
    have hnorm_ne : Algebra.norm ℤ π ≠ 0 := Algebra.norm_ne_zero_iff.mpr hπ_ne
    have hnat_pos : 1 ≤ (Algebra.norm ℤ π).natAbs :=
      Nat.one_le_iff_ne_zero.mpr (Int.natAbs_ne_zero.mpr hnorm_ne)
    exact Real.log_nonneg (by exact_mod_cast hnat_pos)
  have hg_le : ∀ π ∈ hR_fin.toFinset, g π ≤ (n : ℝ) * Real.log X := by
    intro π hπ
    rw [Set.Finite.mem_toFinset] at hπ
    have hπ_ne : π ≠ 0 := hπ.1.ne_zero
    have hnorm_ne : Algebra.norm ℤ π ≠ 0 := Algebra.norm_ne_zero_iff.mpr hπ_ne
    have hnat_pos : (0 : ℝ) < (Algebra.norm ℤ π).natAbs := by
      exact_mod_cast Int.natAbs_pos.mpr hnorm_ne
    have hprod_eq : (∏ w : NumberField.InfinitePlace K, w (π : K) ^ w.mult) =
        ((Algebra.norm ℤ π).natAbs : ℝ) := by
      rw [NumberField.InfinitePlace.prod_eq_abs_norm (π : K), ← Algebra.coe_norm_int π]
      rw [Nat.cast_natAbs]
      norm_cast
    have hprod_le : ((Algebra.norm ℤ π).natAbs : ℝ) ≤ X ^ n := by
      rw [← hprod_eq]
      have h1 : (∏ w : NumberField.InfinitePlace K, w (π : K) ^ w.mult) ≤
          ∏ w : NumberField.InfinitePlace K, X ^ w.mult := by
        apply Finset.prod_le_prod
        · intro w _
          positivity
        · intro w _
          exact pow_le_pow_left₀ (by positivity) (le_of_lt (hπ.2.1 w)) w.mult
      rwa [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq] at h1
    have hlog_le : g π ≤ Real.log (X ^ n) := Real.log_le_log hnat_pos hprod_le
    rwa [Real.log_pow] at hlog_le
  rw [abs_of_nonneg (Finset.sum_nonneg hg_nonneg)]
  have hR_cover : hR_fin.toFinset ⊆ Finset.univ.biUnion (fun w₀ => (hB_fin w₀).toFinset) := by
    intro π hπ
    rw [Set.Finite.mem_toFinset] at hπ
    rw [Finset.mem_biUnion]
    have hex : ∃ w₀ : NumberField.InfinitePlace K, w₀ (π : K) < 1 := by
      by_contra h_all
      push_neg at h_all
      exact hπ.2.2 (fun w => ⟨h_all w, hπ.2.1 w⟩)
    obtain ⟨w₀, hw₀⟩ := hex
    refine ⟨w₀, Finset.mem_univ w₀, ?_⟩
    rw [Set.Finite.mem_toFinset]
    exact ⟨hw₀, fun w _ => hπ.2.1 w⟩
  have hcard_R_le_sum : (hR_fin.toFinset.card : ℝ) ≤
      ∑ w₀ : NumberField.InfinitePlace K, ((hB_fin w₀).toFinset.card : ℝ) := by
    have h1 : hR_fin.toFinset.card ≤
        ∑ w₀ ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)), (hB_fin w₀).toFinset.card :=
      le_trans (Finset.card_le_card hR_cover) Finset.card_biUnion_le
    exact_mod_cast h1
  have h_s1_bound : ∑ π ∈ hR_fin.toFinset, g π ≤
      (∑ w₀ : NumberField.InfinitePlace K, ((hB_fin w₀).toFinset.card : ℝ)) *
        ((n : ℝ) * Real.log X) := by
    have hlog_nonneg : 0 ≤ (n : ℝ) * Real.log X :=
      mul_nonneg (Nat.cast_nonneg n) (Real.log_nonneg (le_of_lt hX))
    calc ∑ π ∈ hR_fin.toFinset, g π
        ≤ ∑ _π ∈ hR_fin.toFinset, ((n : ℝ) * Real.log X) := Finset.sum_le_sum hg_le
      _ = (hR_fin.toFinset.card : ℝ) * ((n : ℝ) * Real.log X) := by
          rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ (∑ w₀ : NumberField.InfinitePlace K, ((hB_fin w₀).toFinset.card : ℝ)) *
            ((n : ℝ) * Real.log X) :=
          mul_le_mul_of_nonneg_right hcard_R_le_sum hlog_nonneg
  
  let j : NumberField.RingOfIntegers K → NumberField.mixedEmbedding.integerLattice K :=
    fun x => ⟨NumberField.mixedEmbedding K (x : K), ⟨x, rfl⟩⟩
  have hj_inj : Function.Injective j := by
    intro x y hxy
    have h : NumberField.mixedEmbedding K (x : K) = NumberField.mixedEmbedding K (y : K) :=
      congrArg Subtype.val hxy
    obtain ⟨w⟩ : Nonempty (NumberField.InfinitePlace K) := inferInstance
    have hsub : NumberField.mixedEmbedding K ((x : K) - (y : K)) = 0 := by
      rw [map_sub, h, sub_self]
    have hw : w ((x : K) - (y : K)) = 0 := by
      rw [← NumberField.mixedEmbedding.normAtPlace_apply w ((x : K) - (y : K)), hsub, map_zero]
    exact Subtype.ext (sub_eq_zero.mp ((AbsoluteValue.eq_zero w.1).mp hw))
  have hB_bound : ∀ w₀ : NumberField.InfinitePlace K,
      ((hB_fin w₀).toFinset.card : ℝ) ≤
        ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) * (1 + D) ^ (n + 1) / V_K) *
          X ^ (n - 1) := by
    intro w₀
    let T := (hB_fin w₀).toFinset
    let T_lat : Finset (NumberField.mixedEmbedding.integerLattice K) := T.map ⟨j, hj_inj⟩
    let f : NumberField.InfinitePlace K → NNReal :=
      fun w => if w = w₀ then ⟨1 + D, by positivity⟩ else ⟨X + D, by positivity⟩
    have haedisj : (T_lat : Set (NumberField.mixedEmbedding.integerLattice K)).Pairwise
        (Function.onFun (MeasureTheory.AEDisjoint MeasureTheory.volume) (fun g => g +ᵥ F)) := by
      intro g₁ _ g₂ _ hne
      exact hF_fund.aedisjoint hne
    have hnull : ∀ g ∈ T_lat, MeasureTheory.NullMeasurableSet (g +ᵥ F) MeasureTheory.volume := by
      intro g _
      change MeasureTheory.NullMeasurableSet ((g : NumberField.mixedEmbedding.mixedSpace K) +ᵥ F) MeasureTheory.volume
      exact (hF_meas.const_vadd (g : NumberField.mixedEmbedding.mixedSpace K)).nullMeasurableSet
    have hvol_union : MeasureTheory.volume (⋃ g ∈ T_lat, g +ᵥ F) =
        (T.card : ENNReal) * MeasureTheory.volume F := by
      rw [MeasureTheory.measure_biUnion_finset₀ haedisj hnull]
      have h_each : ∀ g ∈ T_lat, MeasureTheory.volume (g +ᵥ F) = MeasureTheory.volume F := by
        intro g _
        change MeasureTheory.volume ((g : NumberField.mixedEmbedding.mixedSpace K) +ᵥ F) = MeasureTheory.volume F
        exact MeasureTheory.measure_vadd MeasureTheory.volume (g : NumberField.mixedEmbedding.mixedSpace K) F
      rw [Finset.sum_congr rfl h_each, Finset.sum_const, nsmul_eq_mul, Finset.card_map]
    have hsub_body : (⋃ g ∈ T_lat, g +ᵥ F) ⊆ NumberField.mixedEmbedding.convexBodyLT K f := by
      intro z hz
      simp only [Set.mem_iUnion] at hz
      rcases hz with ⟨g, hg, hzF⟩
      rcases Finset.mem_map.mp hg with ⟨x, hxT, rfl⟩
      rw [Set.Finite.mem_toFinset] at hxT
      rcases hzF with ⟨u, huF, rfl⟩
      have h_all_w : ∀ w : NumberField.InfinitePlace K,
          NumberField.mixedEmbedding.normAtPlace w (NumberField.mixedEmbedding K (x : K) + u) < f w := by
        intro w
        have htri := NumberField.mixedEmbedding.normAtPlace_add_le w
          (NumberField.mixedEmbedding K (x : K)) u
        rw [NumberField.mixedEmbedding.normAtPlace_apply] at htri
        have huD := hF_norm u huF w
        by_cases hw : w = w₀
        · subst hw
          have hfw : (f w : ℝ) = 1 + D := by simp [f]
          linarith [hxT.1]
        · have hfw : (f w : ℝ) = X + D := by simp [f, hw]
          linarith [hxT.2 w hw]
      refine ⟨fun w _ => ?_, fun w _ => ?_⟩
      · simp only [Metric.mem_ball, dist_zero_right]
        rw [← NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2]
        exact h_all_w w.1
      · simp only [Metric.mem_ball, dist_zero_right]
        rw [← NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex w.2]
        exact h_all_w w.1
    have hvol_le : (T.card : ENNReal) * MeasureTheory.volume F ≤
        MeasureTheory.volume (NumberField.mixedEmbedding.convexBodyLT K f) := by
      rw [← hvol_union]
      exact MeasureTheory.measure_mono hsub_body
    rw [NumberField.mixedEmbedding.convexBodyLT_volume K f] at hvol_le
    have h_rhs_ne_top : (↑(NumberField.mixedEmbedding.convexBodyLTFactor K) *
        ↑(∏ w : NumberField.InfinitePlace K, f w ^ w.mult) : ENNReal) ≠ ⊤ :=
      ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.coe_ne_top
    have h_real_le := ENNReal.toReal_mono h_rhs_ne_top hvol_le
    rw [ENNReal.toReal_mul, ENNReal.toReal_natCast, ENNReal.toReal_mul,
        ENNReal.coe_toReal, ENNReal.coe_toReal, NNReal.coe_prod] at h_real_le
    have h_prod_bound : (∏ w : NumberField.InfinitePlace K, ((f w ^ w.mult : NNReal) : ℝ)) ≤
        (1 + D) ^ (n + 1) * X ^ (n - 1) := by
      have h_split := (Finset.mul_prod_erase Finset.univ
        (fun w : NumberField.InfinitePlace K => ((f w ^ w.mult : NNReal) : ℝ))
        (Finset.mem_univ w₀)).symm
      rw [h_split]
      have hw₀_mult_le : w₀.mult ≤ 2 := by
        rcases NumberField.InfinitePlace.isReal_or_isComplex w₀ with hw | hw
        · have h1 := NumberField.InfinitePlace.mult_isReal ⟨w₀, hw⟩
          change w₀.mult = 1 at h1
          omega
        · have h1 := NumberField.InfinitePlace.mult_isComplex ⟨w₀, hw⟩
          change w₀.mult = 2 at h1
          omega
      have hw₀_mult_ge : 1 ≤ w₀.mult := NumberField.InfinitePlace.mult_pos
      have h_w0_term : ((f w₀ ^ w₀.mult : NNReal) : ℝ) ≤ (1 + D) ^ 2 := by
        rw [NNReal.coe_pow]
        have hfw0 : (f w₀ : ℝ) = 1 + D := by simp [f]
        rw [hfw0]
        exact pow_le_pow_right₀ (by linarith) hw₀_mult_le
      have h_rest_term : (∏ w ∈ Finset.univ.erase w₀, ((f w ^ w.mult : NNReal) : ℝ)) ≤
          (1 + D) ^ (n - 1) * X ^ (n - 1) := by
        have h1 : (∏ w ∈ Finset.univ.erase w₀, ((f w ^ w.mult : NNReal) : ℝ)) ≤
            ∏ w ∈ Finset.univ.erase w₀, ((1 + D) * X) ^ w.mult := by
          apply Finset.prod_le_prod
          · intro w _
            positivity
          · intro w hw
            rw [NNReal.coe_pow]
            have hne : w ≠ w₀ := Finset.ne_of_mem_erase hw
            have hfw : (f w : ℝ) = X + D := by simp [f, hne]
            rw [hfw]
            have hXD : X + D ≤ (1 + D) * X := by nlinarith
            exact pow_le_pow_left₀ (by positivity) hXD w.mult
        rw [Finset.prod_pow_eq_pow_sum] at h1
        have hsum_erase : (∑ w ∈ Finset.univ.erase w₀, w.mult) ≤ n - 1 := by
          have hsum := Finset.add_sum_erase Finset.univ
            (fun w : NumberField.InfinitePlace K => w.mult) (Finset.mem_univ w₀)
          rw [NumberField.InfinitePlace.sum_mult_eq] at hsum
          change w₀.mult + ∑ w ∈ Finset.univ.erase w₀, w.mult = n at hsum
          omega
        have h2 : ((1 + D) * X) ^ (∑ w ∈ Finset.univ.erase w₀, w.mult) ≤
            ((1 + D) * X) ^ (n - 1) :=
          pow_le_pow_right₀ (by nlinarith) hsum_erase
        calc (∏ w ∈ Finset.univ.erase w₀, ((f w ^ w.mult : NNReal) : ℝ))
            ≤ ((1 + D) * X) ^ (n - 1) := le_trans h1 h2
          _ = (1 + D) ^ (n - 1) * X ^ (n - 1) := mul_pow (1 + D) X (n - 1)
      have h_pow_comb : (1 + D) ^ 2 * (1 + D) ^ (n - 1) = (1 + D) ^ (n + 1) := by
        rw [← pow_add]
        congr 1
        omega
      calc ((f w₀ ^ w₀.mult : NNReal) : ℝ) *
            ∏ w ∈ Finset.univ.erase w₀, ((f w ^ w.mult : NNReal) : ℝ)
          ≤ (1 + D) ^ 2 * ((1 + D) ^ (n - 1) * X ^ (n - 1)) := by
            apply mul_le_mul h_w0_term h_rest_term (by positivity) (by positivity)
        _ = ((1 + D) ^ 2 * (1 + D) ^ (n - 1)) * X ^ (n - 1) := by ring
        _ = (1 + D) ^ (n + 1) * X ^ (n - 1) := by rw [h_pow_comb]
    have h_factor_nonneg : (0 : ℝ) ≤ NumberField.mixedEmbedding.convexBodyLTFactor K := by
      positivity
    have h_comb : (T.card : ℝ) * V_K ≤
        (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) *
          ((1 + D) ^ (n + 1) * X ^ (n - 1)) :=
      le_trans h_real_le (mul_le_mul_of_nonneg_left h_prod_bound h_factor_nonneg)
    rw [← le_div_iff₀ hVK_pos] at h_comb
    calc (T.card : ℝ)
        ≤ (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) *
            ((1 + D) ^ (n + 1) * X ^ (n - 1)) / V_K := h_comb
      _ = ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) * (1 + D) ^ (n + 1) / V_K) *
            X ^ (n - 1) := by ring
  have h_s2_bound : (∑ w₀ : NumberField.InfinitePlace K, ((hB_fin w₀).toFinset.card : ℝ)) ≤
      C₀ * X ^ (n - 1) := by
    calc (∑ w₀ : NumberField.InfinitePlace K, ((hB_fin w₀).toFinset.card : ℝ))
        ≤ ∑ _w₀ : NumberField.InfinitePlace K,
            (((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) * (1 + D) ^ (n + 1) / V_K) *
              X ^ (n - 1)) :=
          Finset.sum_le_sum (fun w₀ _ => hB_bound w₀)
      _ = ((Fintype.card (NumberField.InfinitePlace K) : ℝ) *
            ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) * (1 + D) ^ (n + 1) / V_K)) *
            X ^ (n - 1) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
          ring
      _ ≤ C₀ * X ^ (n - 1) := by
          have hC₀_ge : (Fintype.card (NumberField.InfinitePlace K) : ℝ) *
              ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) * (1 + D) ^ (n + 1) / V_K) ≤ C₀ :=
            le_max_right _ _
          exact mul_le_mul_of_nonneg_right hC₀_ge (by positivity)
  
  let L : ℝ := Real.log X
  let t : ℝ := Real.sqrt L
  have hL_pos : 0 < L := Real.log_pos hX
  have hL_nonneg : 0 ≤ L := le_of_lt hL_pos
  have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg L
  have ht_sq : t ^ 2 = L := Real.sq_sqrt hL_nonneg
  have hL_le_exp : L ≤ 4 * Real.exp t := by
    have h1 := Real.add_one_le_exp (t / 2)
    have ht_le : t ≤ 2 * Real.exp (t / 2) := by linarith
    have hsq : t ^ 2 ≤ (2 * Real.exp (t / 2)) ^ 2 := pow_le_pow_left₀ ht_nonneg ht_le 2
    have hexp_sq : (2 * Real.exp (t / 2)) ^ 2 = 4 * Real.exp t := by
      calc (2 * Real.exp (t / 2)) ^ 2 = 4 * (Real.exp (t / 2) * Real.exp (t / 2)) := by ring
        _ = 4 * Real.exp (t / 2 + t / 2) := by rw [← Real.exp_add]
        _ = 4 * Real.exp t := by rw [add_halves]
    linarith
  have hexp_t_le : Real.exp t ≤ X * Real.exp 1 * Real.exp (-t) := by
    have h1 : 0 ≤ (t - 1) ^ 2 := sq_nonneg (t - 1)
    have h2 : t ≤ (L + 1) + (-t) := by nlinarith [h1, ht_sq]
    calc Real.exp t ≤ Real.exp ((L + 1) + (-t)) := Real.exp_le_exp.mpr h2
      _ = Real.exp L * Real.exp 1 * Real.exp (-t) := by rw [Real.exp_add, Real.exp_add]
      _ = X * Real.exp 1 * Real.exp (-t) := by rw [Real.exp_log hX_pos]
  have hL_le_X : L ≤ 4 * X * Real.exp 1 * Real.exp (-t) := by
    calc L ≤ 4 * Real.exp t := hL_le_exp
      _ ≤ 4 * (X * Real.exp 1 * Real.exp (-t)) := by linarith [hexp_t_le]
      _ = 4 * X * Real.exp 1 * Real.exp (-t) := by ring
  have hexp_c1 : Real.exp (-t) ≤ Real.exp (-t / c₁) := by
    rw [Real.exp_le_exp, neg_div, neg_le_neg_iff]
    exact div_le_self ht_nonneg hc₁_ge1
  have hXn : X ^ (n - 1) * X = X ^ n := by
    rw [← pow_succ, Nat.sub_add_cancel hn_pos]
  have h_s3_bound : C₀ * X ^ (n - 1) * ((n : ℝ) * L) ≤
      c₁ * X ^ n * Real.exp (-t / c₁) := by
    calc C₀ * X ^ (n - 1) * ((n : ℝ) * L)
        ≤ C₀ * X ^ (n - 1) * ((n : ℝ) * (4 * X * Real.exp 1 * Real.exp (-t))) := by
          apply mul_le_mul_of_nonneg_left
          · exact mul_le_mul_of_nonneg_left hL_le_X (Nat.cast_nonneg n)
          · positivity
      _ = (4 * Real.exp 1 * C₀ * (n : ℝ)) * (X ^ (n - 1) * X) * Real.exp (-t) := by ring
      _ = (4 * Real.exp 1 * C₀ * (n : ℝ)) * X ^ n * Real.exp (-t) := by rw [hXn]
      _ ≤ c₁ * X ^ n * Real.exp (-t / c₁) := by
          apply mul_le_mul
          · exact mul_le_mul_of_nonneg_right hc₁_ge_const (by positivity)
          · exact hexp_c1
          · positivity
          · positivity
  
  have h_mid : (∑ w₀ : NumberField.InfinitePlace K, ((hB_fin w₀).toFinset.card : ℝ)) *
      ((n : ℝ) * L) ≤ C₀ * X ^ (n - 1) * ((n : ℝ) * L) :=
    mul_le_mul_of_nonneg_right h_s2_bound (by positivity)
  exact le_trans h_s1_bound (le_trans h_mid h_s3_bound)

theorem mitsui_prime_char_grid_cube_ge_one_to_place_sectors_le {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (m : ℕ) (hm : 1 ≤ m)
    (k : NumberField.mixedEmbedding.index K → Fin (2 * m))
    (hQ_bdd : ∀ z : NumberField.mixedEmbedding.mixedSpace K,
        (∀ i : NumberField.mixedEmbedding.index K,
          (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
            Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) →
        ∀ w : NumberField.InfinitePlace K,
          NumberField.mixedEmbedding.normAtPlace w z < X)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ) :
    ‖(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          (∀ i : NumberField.mixedEmbedding.index K,
            (NumberField.mixedEmbedding.stdBasis K).repr
                (NumberField.mixedEmbedding K (π : K)) i ∈
              Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
          (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K)) ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      - (∑ w₀ : NumberField.InfinitePlace K,
          ∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧
                (∀ i : NumberField.mixedEmbedding.index K,
                  (NumberField.mixedEmbedding.stdBasis K).repr
                      (NumberField.mixedEmbedding K (π : K)) i ∈
                    Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                      ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
                (∀ w : NumberField.InfinitePlace K,
                  1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
                IsUnit (Ideal.Quotient.mk q π)},
              ψ (Additive.ofMul π.2.2.2.2.unit) *
                (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
    ≤ |(∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X},
        Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
      - (∑ w₀ : NumberField.InfinitePlace K,
          ∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧
                (∀ w : NumberField.InfinitePlace K,
                  1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
                w₀ (π : K) < X},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))| :=
by
  classical
  have hq_bot : q ≠ ⊥ := hq
  haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
    Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
  let L : NumberField.RingOfIntegers K → ℝ :=
    fun π => Real.log ((Algebra.norm ℤ π).natAbs : ℝ)
  have hL_nonneg : ∀ π : NumberField.RingOfIntegers K, 0 ≤ L π :=
    fun _ => Real.log_natCast_nonneg _
  let P_cube : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ i : NumberField.mixedEmbedding.index K,
      (NumberField.mixedEmbedding.stdBasis K).repr
          (NumberField.mixedEmbedding K (π : K)) i ∈
        Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
          ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))
  have h_cube_lt : ∀ x : NumberField.RingOfIntegers K,
      P_cube x → ∀ w : NumberField.InfinitePlace K, w (x : K) < X := by
    intro x hx w
    rw [← NumberField.mixedEmbedding.normAtPlace_apply w (x : K)]
    exact hQ_bdd (NumberField.mixedEmbedding K (x : K)) hx w
  let P_box : NumberField.RingOfIntegers K → Prop :=
    fun π => Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X
  let P_max : NumberField.InfinitePlace K → NumberField.RingOfIntegers K → Prop :=
    fun w₀ π => ∀ w : NumberField.InfinitePlace K, w (π : K) ≤ w₀ (π : K)
  let B_X : Set K := {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X}
  have hB_fin : B_X.Finite := NumberField.Embeddings.finite_of_norm_le K ℂ X
  have hpre_fin : (algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X).Finite :=
    hB_fin.preimage NumberField.RingOfIntegers.coe_injective.injOn
  have hS_sub : {π : NumberField.RingOfIntegers K | P_box π} ⊆
      algebraMap (NumberField.RingOfIntegers K) K ⁻¹' B_X := by
    intro π hπ
    refine ⟨NumberField.RingOfIntegers.isIntegral_coe π, ?_⟩
    intro φ
    let w : NumberField.InfinitePlace K := NumberField.InfinitePlace.mk φ
    have hw1 : w (π : K) = ‖φ (π : K)‖ := NumberField.InfinitePlace.apply φ (π : K)
    have hlt : w (π : K) < X := (hπ.2 w).2
    change ‖φ (π : K)‖ ≤ X
    linarith
  have hS_fin : {π : NumberField.RingOfIntegers K | P_box π}.Finite :=
    hpre_fin.subset hS_sub
  let S_uncond := {π : NumberField.RingOfIntegers K //
    Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X}
  letI : Fintype S_uncond := hS_fin.fintype
  let S_cop := {π : NumberField.RingOfIntegers K //
    Prime π ∧
    P_cube π ∧
    (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K)) ∧
    IsUnit (Ideal.Quotient.mk q π)}
  have hScop_fin : {π : NumberField.RingOfIntegers K |
      Prime π ∧
      P_cube π ∧
      (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K)) ∧
      IsUnit (Ideal.Quotient.mk q π)}.Finite :=
    hS_fin.subset (fun x hπ => ⟨hπ.1, fun w => ⟨hπ.2.2.1 w, h_cube_lt x hπ.2.1 w⟩⟩)
  letI : Fintype S_cop := hScop_fin.fintype
  let M : NumberField.RingOfIntegers K → Finset (NumberField.InfinitePlace K) :=
    fun π => Finset.univ.filter (fun w₀ : NumberField.InfinitePlace K => P_max w₀ π)
  have hM_ge_one : ∀ π : NumberField.RingOfIntegers K, 1 ≤ (M π).card := by
    intro π
    obtain ⟨w₀, _, hw₀⟩ := Finset.exists_max_image Finset.univ
      (fun w : NumberField.InfinitePlace K => w (π : K)) Finset.univ_nonempty
    have hw₀_mem : w₀ ∈ M π := by
      rw [Finset.mem_filter]
      exact ⟨Finset.mem_univ w₀, fun w => hw₀ w (Finset.mem_univ w)⟩
    exact Finset.card_pos.mpr ⟨w₀, hw₀_mem⟩
  have hM_sub_nonneg : ∀ π : NumberField.RingOfIntegers K, 0 ≤ ((M π).card : ℝ) - 1 := by
    intro π
    have h1 : (1 : ℝ) ≤ ((M π).card : ℝ) := by exact_mod_cast hM_ge_one π
    linarith
  let term : S_cop → ℂ := fun π =>
    ψ (Additive.ofMul π.2.2.2.2.unit) * (L π.1 : ℂ)
  have h_lhs1 : (∑' π : S_cop, term π) = ∑ x : S_cop, term x :=
    tsum_fintype term
  let S_sec_cop (w₀ : NumberField.InfinitePlace K) :=
    {π : NumberField.RingOfIntegers K //
      Prime π ∧
      P_cube π ∧
      (∀ w : NumberField.InfinitePlace K,
        1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
      IsUnit (Ideal.Quotient.mk q π)}
  let e_sec_cop (w₀ : NumberField.InfinitePlace K) :
      S_sec_cop w₀ ≃ {x : S_cop // P_max w₀ x.1} :=
    { toFun := fun π =>
        ⟨⟨π.1, π.2.1, π.2.2.1, fun w => (π.2.2.2.1 w).1, π.2.2.2.2⟩,
         fun w => (π.2.2.2.1 w).2⟩
      invFun := fun x =>
        ⟨x.1.1, x.1.2.1, x.1.2.2.1, fun w => ⟨x.1.2.2.2.1 w, x.2 w⟩, x.1.2.2.2.2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun x => by ext; rfl }
  have h_lhs_sec : ∀ w₀ : NumberField.InfinitePlace K,
      (∑' π : S_sec_cop w₀,
        ψ (Additive.ofMul π.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑ x : S_cop, (if P_max w₀ x.1 then term x else 0) := by
    intro w₀
    change (∑' π : S_sec_cop w₀, term (e_sec_cop w₀ π).1) = _
    rw [Equiv.tsum_eq (e_sec_cop w₀) (fun z : {x : S_cop // P_max w₀ x.1} => term z.1), tsum_fintype]
    have hsub : (∑ z : {x : S_cop // P_max w₀ x.1}, term z.1) =
        ∑ x ∈ Finset.univ.filter (fun x : S_cop => P_max w₀ x.1), term x :=
      (Finset.sum_subtype (Finset.univ.filter (fun x : S_cop => P_max w₀ x.1))
        (fun _ => by simp) term).symm
    rw [hsub, Finset.sum_filter]
  have h_lhs2 :
      (∑ w₀ : NumberField.InfinitePlace K,
        ∑' π : S_sec_cop w₀,
          ψ (Additive.ofMul π.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = ∑ x : S_cop, ((M x.1).card : ℂ) * term x := by
    simp_rw [h_lhs_sec]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
  have h_lhs_diff :
      (∑' π : S_cop, term π) -
      (∑ w₀ : NumberField.InfinitePlace K,
        ∑' π : S_sec_cop w₀,
          ψ (Additive.ofMul π.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
      = - ∑ x : S_cop, (((M x.1).card : ℂ) - 1) * term x := by
    rw [h_lhs1, h_lhs2, ← Finset.sum_sub_distrib, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    ring
  have h_term_norm : ∀ x : S_cop,
      ‖(((M x.1).card : ℂ) - 1) * term x‖ = (((M x.1).card : ℝ) - 1) * L x.1 := by
    intro x
    dsimp [term]
    have h_cast : (((M x.1).card : ℂ) - 1) = ((((M x.1).card : ℝ) - 1 : ℝ) : ℂ) := by
      push_cast; rfl
    rw [h_cast, norm_mul, norm_mul, AddChar.norm_apply, one_mul,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hM_sub_nonneg x.1),
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hL_nonneg x.1)]
  let e_cop : S_cop ≃ {y : S_uncond // P_cube y.1 ∧ IsUnit (Ideal.Quotient.mk q y.1)} :=
    { toFun := fun x =>
        ⟨⟨x.1, x.2.1, fun w => ⟨x.2.2.2.1 w, h_cube_lt x.1 x.2.2.1 w⟩⟩,
         ⟨x.2.2.1, x.2.2.2.2⟩⟩
      invFun := fun y =>
        ⟨y.1.1, y.1.2.1, y.2.1, fun w => (y.1.2.2 w).1, y.2.2⟩
      left_inv := fun x => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_lhs_le :
      ‖(∑' π : S_cop, term π) -
        (∑ w₀ : NumberField.InfinitePlace K,
          ∑' π : S_sec_cop w₀,
            ψ (Additive.ofMul π.2.2.2.2.unit) *
              (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
      ≤ ∑ y ∈ Finset.univ.filter (fun y : S_uncond => P_cube y.1 ∧ IsUnit (Ideal.Quotient.mk q y.1)),
          (((M y.1).card : ℝ) - 1) * L y.1 := by
    rw [h_lhs_diff, norm_neg]
    calc ‖∑ x : S_cop, (((M x.1).card : ℂ) - 1) * term x‖
      _ ≤ ∑ x : S_cop, ‖(((M x.1).card : ℂ) - 1) * term x‖ :=
        norm_sum_le _ _
      _ = ∑ x : S_cop, (((M x.1).card : ℝ) - 1) * L x.1 :=
        Finset.sum_congr rfl (fun x _ => h_term_norm x)
      _ = ∑ z : {y : S_uncond // P_cube y.1 ∧ IsUnit (Ideal.Quotient.mk q y.1)},
            (((M z.1.1).card : ℝ) - 1) * L z.1.1 :=
        Equiv.sum_comp e_cop (fun z : {y : S_uncond // P_cube y.1 ∧ IsUnit (Ideal.Quotient.mk q y.1)} =>
          (((M z.1.1).card : ℝ) - 1) * L z.1.1)
      _ = ∑ y ∈ Finset.univ.filter (fun y : S_uncond => P_cube y.1 ∧ IsUnit (Ideal.Quotient.mk q y.1)),
            (((M y.1).card : ℝ) - 1) * L y.1 :=
        (Finset.sum_subtype (Finset.univ.filter (fun y : S_uncond => P_cube y.1 ∧ IsUnit (Ideal.Quotient.mk q y.1)))
          (fun _ => by simp) (fun y : S_uncond => (((M y.1).card : ℝ) - 1) * L y.1)).symm
  have h_rhs1 : (∑' y : S_uncond, L y.1) = ∑ y : S_uncond, L y.1 :=
    tsum_fintype (fun y : S_uncond => L y.1)
  let S_sec_uncond (w₀ : NumberField.InfinitePlace K) :=
    {π : NumberField.RingOfIntegers K //
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K,
        1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
      w₀ (π : K) < X}
  let e_sec_uncond (w₀ : NumberField.InfinitePlace K) :
      S_sec_uncond w₀ ≃ {y : S_uncond // P_max w₀ y.1} :=
    { toFun := fun π =>
        ⟨⟨π.1, π.2.1, fun w => ⟨(π.2.2.1 w).1, lt_of_le_of_lt (π.2.2.1 w).2 π.2.2.2⟩⟩,
         fun w => (π.2.2.1 w).2⟩
      invFun := fun y =>
        ⟨y.1.1, y.1.2.1, fun w => ⟨(y.1.2.2 w).1, y.2 w⟩, (y.1.2.2 w₀).2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_rhs_sec : ∀ w₀ : NumberField.InfinitePlace K,
      (∑' π : S_sec_uncond w₀, L π.1) =
      ∑ y : S_uncond, (if P_max w₀ y.1 then L y.1 else 0) := by
    intro w₀
    change (∑' π : S_sec_uncond w₀, L (e_sec_uncond w₀ π).1.1) = _
    rw [Equiv.tsum_eq (e_sec_uncond w₀) (fun z : {y : S_uncond // P_max w₀ y.1} => L z.1.1), tsum_fintype]
    have hsub : (∑ z : {y : S_uncond // P_max w₀ y.1}, L z.1.1) =
        ∑ y ∈ Finset.univ.filter (fun y : S_uncond => P_max w₀ y.1), L y.1 :=
      (Finset.sum_subtype (Finset.univ.filter (fun y : S_uncond => P_max w₀ y.1))
        (fun _ => by simp) (fun y : S_uncond => L y.1)).symm
    rw [hsub, Finset.sum_filter]
  have h_rhs2 :
      (∑ w₀ : NumberField.InfinitePlace K, ∑' π : S_sec_uncond w₀, L π.1) =
      ∑ y : S_uncond, ((M y.1).card : ℝ) * L y.1 := by
    simp_rw [h_rhs_sec]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun y _ => ?_)
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
  have h_rhs_diff :
      (∑' y : S_uncond, L y.1) -
      (∑ w₀ : NumberField.InfinitePlace K, ∑' π : S_sec_uncond w₀, L π.1)
      = - ∑ y : S_uncond, (((M y.1).card : ℝ) - 1) * L y.1 := by
    rw [h_rhs1, h_rhs2, ← Finset.sum_sub_distrib, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl (fun y _ => ?_)
    ring
  have h_rhs_nonneg :
      0 ≤ ∑ y : S_uncond, (((M y.1).card : ℝ) - 1) * L y.1 :=
    Finset.sum_nonneg (fun y _ => mul_nonneg (hM_sub_nonneg y.1) (hL_nonneg y.1))
  have h_rhs_abs :
      |(∑' y : S_uncond, L y.1) -
        (∑ w₀ : NumberField.InfinitePlace K, ∑' π : S_sec_uncond w₀, L π.1)|
      = ∑ y : S_uncond, (((M y.1).card : ℝ) - 1) * L y.1 := by
    rw [h_rhs_diff, abs_neg, abs_of_nonneg h_rhs_nonneg]
  change ‖(∑' π : S_cop, term π) -
      (∑ w₀ : NumberField.InfinitePlace K,
        ∑' π : S_sec_cop w₀,
          ψ (Additive.ofMul π.2.2.2.2.unit) *
            (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
    ≤ |(∑' y : S_uncond, L y.1) -
      (∑ w₀ : NumberField.InfinitePlace K, ∑' π : S_sec_uncond w₀, L π.1)|
  rw [h_rhs_abs]
  refine le_trans h_lhs_le ?_
  exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
    (fun y _ _ => mul_nonneg (hM_sub_nonneg y.1) (hL_nonneg y.1))

theorem mitsui_prime_box_ge_one_to_place_sectors {K : Type u} [Field K] [NumberField K] :
    ∃ c₂ : ℝ, 0 < c₂ ∧
      ∀ X : ℝ, 1 < X →
        |(∑' π : {π : NumberField.RingOfIntegers K //
              Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X},
            Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
          - (∑ w₀ : NumberField.InfinitePlace K,
              ∑' π : {π : NumberField.RingOfIntegers K //
                    Prime π ∧
                    (∀ w : NumberField.InfinitePlace K,
                      1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
                    w₀ (π : K) < X},
                  Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))|
          ≤ c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
by
  classical
  letI : VAdd (NumberField.mixedEmbedding.integerLattice K)
    (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.vaddSet
  letI : VAdd (NumberField.mixedEmbedding.mixedSpace K)
    (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.vaddSet
  let F : Set (NumberField.mixedEmbedding.mixedSpace K) :=
    ZSpan.fundamentalDomain (NumberField.mixedEmbedding.latticeBasis K)
  have hF_bdd : Bornology.IsBounded F :=
    ZSpan.fundamentalDomain_isBounded (NumberField.mixedEmbedding.latticeBasis K)
  obtain ⟨D, hD_gt1, hF_ball⟩ := hF_bdd.subset_ball_lt 1 0
  have hD_ge1 : 1 ≤ D := le_of_lt hD_gt1
  have hD_pos : 0 < D := by linarith
  have hF_norm : ∀ z ∈ F, ∀ w : NumberField.InfinitePlace K,
      NumberField.mixedEmbedding.normAtPlace w z < D := by
    intro z hz w
    have hz_norm : ‖z‖ < D := by
      have h1 := hF_ball hz
      rwa [Metric.mem_ball, dist_zero_right] at h1
    rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
    · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw z]
      have h1 : ‖z.1 ⟨w, hw⟩‖ ≤ ‖z.1‖ := norm_le_pi_norm z.1 ⟨w, hw⟩
      have h2 : ‖z.1‖ ≤ ‖z‖ := by
        rw [Prod.norm_def]
        exact le_max_left _ _
      exact lt_of_le_of_lt (le_trans h1 h2) hz_norm
    · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hw z]
      have h1 : ‖z.2 ⟨w, hw⟩‖ ≤ ‖z.2‖ := norm_le_pi_norm z.2 ⟨w, hw⟩
      have h2 : ‖z.2‖ ≤ ‖z‖ := by
        rw [Prod.norm_def]
        exact le_max_right _ _
      exact lt_of_le_of_lt (le_trans h1 h2) hz_norm
  have hF_fund : MeasureTheory.IsAddFundamentalDomain
      (NumberField.mixedEmbedding.integerLattice K) F MeasureTheory.volume :=
    NumberField.mixedEmbedding.fundamentalDomain_integerLattice K
  have hF_meas : MeasurableSet F :=
    ZSpan.fundamentalDomain_measurableSet (NumberField.mixedEmbedding.latticeBasis K)
  have hF_ne_top : MeasureTheory.volume F ≠ ⊤ := by
    dsimp [F]
    rw [NumberField.mixedEmbedding.volume_fundamentalDomain_latticeBasis K]
    exact ENNReal.mul_ne_top (ENNReal.pow_ne_top (ENNReal.inv_ne_top.mpr (by norm_num))) ENNReal.coe_ne_top
  let V_K : ℝ := (MeasureTheory.volume F).toReal
  have hVK_pos : 0 < V_K := by
    dsimp [V_K, F]
    rw [NumberField.mixedEmbedding.volume_fundamentalDomain_latticeBasis K]
    rw [ENNReal.toReal_mul, ENNReal.toReal_pow, ENNReal.coe_toReal]
    have hdiscr : NumberField.discr K ≠ 0 := NumberField.discr_ne_zero K
    have hsqrt_pos : (0 : NNReal) < NNReal.sqrt ‖NumberField.discr K‖₊ :=
      NNReal.sqrt_pos.mpr (nnnorm_pos.mpr hdiscr)
    have hsqrt_rpos : (0 : ℝ) < (NNReal.sqrt ‖NumberField.discr K‖₊ : ℝ) :=
      NNReal.coe_pos.mpr hsqrt_pos
    have h2 : (0 : ℝ) < ENNReal.toReal 2⁻¹ := by norm_num
    positivity
  let F_K : ℝ := (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
  have hFK_pos : 0 < F_K := by
    change (0 : ℝ) < (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
    have h1 := NumberField.mixedEmbedding.one_le_convexBodyLTFactor K
    exact_mod_cast lt_of_lt_of_le zero_lt_one h1
  let n : ℕ := Module.finrank ℚ K
  have hn_pos : 1 ≤ n := Module.finrank_pos
  let M_card : ℝ := (Fintype.card (NumberField.InfinitePlace K) : ℝ)
  have hM_card_nonneg : 0 ≤ M_card := Nat.cast_nonneg _
