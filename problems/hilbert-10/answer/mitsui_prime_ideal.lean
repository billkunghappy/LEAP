        (w ((x * y : NumberField.RingOfIntegers K) : K) : ℂ) =
        (w.embedding (x : K) / (w (x : K) : ℂ)) *
          (w.embedding (y : K) / (w (y : K) : ℂ)) := by
      push_cast
      rw [map_mul, map_mul, Complex.ofReal_mul, mul_div_mul_comm]
    dsimp [τ₀]
    rw [h_emb, hsum, Complex.ofReal_add, add_mul, Complex.exp_add]
    ring
  have hτ₀_unit : ∀ u : (NumberField.RingOfIntegers K)ˣ,
      ∃ ζ : NumberField.Units.torsion K,
        ∀ w : NumberField.InfinitePlace K,
          τ₀ (u : NumberField.RingOfIntegers K) w =
            w.embedding (((ζ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) := by
    intro u
    let ζ : NumberField.Units.torsion K :=
      (NumberField.Units.exist_unique_eq_mul_prod K u).exists.choose.1
    let d : Fin r → ℤ :=
      (NumberField.Units.exist_unique_eq_mul_prod K u).exists.choose.2
    have hu_eq : u = (ζ : (NumberField.RingOfIntegers K)ˣ) *
        ∏ j : Fin r, (NumberField.Units.fundSystem K j) ^ (d j) :=
      (NumberField.Units.exist_unique_eq_mul_prod K u).exists.choose_spec
    have h_sum_u : (∑ v : NumberField.InfinitePlace K,
        (v.mult : ℝ) * Real.log (v ((u : NumberField.RingOfIntegers K) : K))) = 0 := by
      simpa using NumberField.Units.sum_mult_mul_log u
    have hL_u : L_vec (u : NumberField.RingOfIntegers K) =
        NumberField.Units.logEmbedding K (Additive.ofMul u) := by
      ext w
      dsimp [L_vec, ℓ]
      rw [h_sum_u, zero_div, sub_zero]
    have hζ : NumberField.Units.logEmbedding K
        (Additive.ofMul (ζ : (NumberField.RingOfIntegers K)ˣ)) = 0 := by
      ext w
      rw [NumberField.Units.dirichletUnitTheorem.logEmbedding_component]
      have hw1 : (w : NumberField.InfinitePlace K)
          ((algebraMap (NumberField.RingOfIntegers K) K)
            (ζ : (NumberField.RingOfIntegers K)ˣ)) = 1 :=
        (NumberField.Units.mem_torsion K).mp ζ.2 (w : NumberField.InfinitePlace K)
      rw [hw1, Real.log_one, mul_zero]
      rfl
    have hlog : NumberField.Units.logEmbedding K (Additive.ofMul u) =
        ∑ j : Fin r, (d j : ℝ) • B_R j := by
      conv_lhs => rw [hu_eq]
      rw [ofMul_mul, map_add, hζ, zero_add, ofMul_prod, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [ofMul_zpow, map_zsmul, NumberField.Units.logEmbedding_fundSystem]
      dsimp [B_R]
      rw [Module.Basis.ofZLatticeBasis_apply, Int.cast_smul_eq_zsmul]
