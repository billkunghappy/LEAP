      dsimp [c_gen, C₀]
      have htors : 0 < Fintype.card (NumberField.Units.torsion K) := Fintype.card_pos
      positivity
    let ζ : (NumberField.RingOfIntegers K)ˣ → NumberField.Units.torsion K :=
