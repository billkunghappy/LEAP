            (∑ v : {v : NumberField.InfinitePlace K // v.IsComplex},
              β v.1 * (if v = ⟨w, hw_cplx⟩ then (1 : ℂ) else 0).re) -
            (∑ v : {v : NumberField.InfinitePlace K // v.IsComplex},
