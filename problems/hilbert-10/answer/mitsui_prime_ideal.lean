        _ = C₀ * ((A : ℝ) + 1) * ((Real.log X ^ A) ^ 2 * Real.log X) * X ^ (n - 1) := by ring
        _ = C₀ * ((A : ℝ) + 1) * (Real.log X) ^ (2 * A + 1) * X ^ (n - 1) := by rw [hpow_eq]
    have hB_pos : (0 : ℝ) < 4 * (A : ℝ) + 2 := by positivity
    have hexp_step : Real.log X ≤ (4 * (A : ℝ) + 2) * Real.exp (Real.log X / (4 * (A : ℝ) + 2)) := by
      have h1 := Real.add_one_le_exp (Real.log X / (4 * (A : ℝ) + 2))
      have h2 : Real.log X / (4 * (A : ℝ) + 2) ≤ Real.exp (Real.log X / (4 * (A : ℝ) + 2)) := by linarith
      have h3 := (div_le_iff₀ hB_pos).mp h2
