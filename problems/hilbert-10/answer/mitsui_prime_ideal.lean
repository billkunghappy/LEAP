          div_le_div_of_nonneg_right hz_q_le (le_of_lt h_2pi_pos)
      _ = (16 * Real.pi) * V * (‖s‖ / (2 * Real.pi)) := by ring
  · intro l v hl hv
    set z_p : ℂ := s + ((l : ℝ) / 2 : ℂ) - ((v : ℝ) / 2 : ℂ) * Complex.I
    set w_p : ℂ := (1 - s) + ((l : ℝ) / 2 : ℂ) + ((v : ℝ) / 2 : ℂ) * Complex.I
    by_cases hz : z_p = 0
    · rw [hz, Complex.Gamma_zero, inv_zero, mul_zero, zero_mul, norm_zero]
      exact sq_nonneg _
    · have h_shift_p : w_p = (starRingEnd ℂ z_p + 1) + 1 := by
        apply Complex.ext
        · simp [w_p, z_p, hs, map_ofNat]; ring
        · simp [w_p, z_p, map_ofNat]
      have h_zp_conj_ne : starRingEnd ℂ z_p ≠ 0 :=
        (map_ne_zero (starRingEnd ℂ)).mpr hz
      have h_zp_conj1_re : 0 < (starRingEnd ℂ z_p + 1).re := by
        have hl_nn : (0 : ℝ) ≤ (l : ℝ) := Nat.cast_nonneg l
        simp [z_p, hs, map_ofNat]
        linarith
      have h_zp_conj1_ne : starRingEnd ℂ z_p + 1 ≠ 0 := by
        intro h_zero
        rw [h_zero, Complex.zero_re] at h_zp_conj1_re
        exact lt_irrefl 0 h_zp_conj1_re
      have h_gamma_p : Complex.Gamma w_p =
          (starRingEnd ℂ z_p + 1) * (starRingEnd ℂ z_p * starRingEnd ℂ (Complex.Gamma z_p)) := by
        rw [h_shift_p, Complex.Gamma_add_one _ h_zp_conj1_ne,
          Complex.Gamma_add_one _ h_zp_conj_ne, Complex.Gamma_conj]
      have h_conj_add_one : starRingEnd ℂ z_p + 1 = starRingEnd ℂ (z_p + 1) := by simp
      have h_norm_gamma_p : ‖Complex.Gamma w_p‖ = ‖z_p + 1‖ * ‖z_p‖ * ‖Complex.Gamma z_p‖ := by
        rw [h_gamma_p, h_conj_add_one, norm_mul, norm_mul,
          RingHomIsometric.norm_map, RingHomIsometric.norm_map, RingHomIsometric.norm_map]
        ring
      have h_re_wp : 0 < w_p.re := by
        have hl_nn : (0 : ℝ) ≤ (l : ℝ) := Nat.cast_nonneg l
        simp [w_p, hs]
        linarith
      have h_gamma_wp_pos : 0 < ‖Complex.Gamma w_p‖ :=
        norm_pos_iff.mpr (Complex.Gamma_ne_zero_of_re_pos h_re_wp)
      have h_gamma_zp_ne : ‖Complex.Gamma z_p‖ ≠ 0 := by
        intro h_zero
        rw [h_zero, mul_zero] at h_norm_gamma_p
        linarith
      have h_2pi_cast : (2 : ℂ) * (Real.pi : ℂ) = ((2 * Real.pi : ℝ) : ℂ) := by push_cast; ring
      have h_re_sum_p : z_p.re + (-w_p).re = -2 := by
        simp [z_p, w_p, hs]; ring
      have h_rpow_p :
          (2 * Real.pi) ^ z_p.re * (2 * Real.pi) ^ (-w_p).re = ((2 * Real.pi) ^ 2)⁻¹ := by
        rw [← Real.rpow_add h_2pi_pos, h_re_sum_p]
        have h_cast : (-2 : ℝ) = ((-2 : ℤ) : ℝ) := by norm_num
        rw [h_cast, Real.rpow_intCast, zpow_neg, zpow_two]
        ring
      have h_cplx_prod :
          ((1 / 2 : ℂ) * (2 * (Real.pi : ℂ)) ^ z_p * (Complex.Gamma z_p)⁻¹) * Complex.Gammaℂ w_p =
          ((2 * (Real.pi : ℂ)) ^ z_p * (2 * (Real.pi : ℂ)) ^ (-w_p)) *
            ((Complex.Gamma z_p)⁻¹ * Complex.Gamma w_p) := by
        rw [Complex.Gammaℂ_def]
        ring
      have h_lhs_p :
          ‖((1 / 2 : ℂ) * (2 * (Real.pi : ℂ)) ^ z_p * (Complex.Gamma z_p)⁻¹) * Complex.Gammaℂ w_p‖ =
          (‖z_p‖ * ‖z_p + 1‖) / (2 * Real.pi) ^ 2 := by
        rw [h_cplx_prod, norm_mul, norm_mul, norm_mul, norm_inv,
          h_2pi_cast,
          Complex.norm_cpow_eq_rpow_re_of_pos h_2pi_pos,
          Complex.norm_cpow_eq_rpow_re_of_pos h_2pi_pos,
          h_rpow_p, h_norm_gamma_p]
        have h_cancel :
            ((2 * Real.pi) ^ 2)⁻¹ * (‖Complex.Gamma z_p‖⁻¹ * (‖z_p + 1‖ * ‖z_p‖ * ‖Complex.Gamma z_p‖)) =
            ((2 * Real.pi) ^ 2)⁻¹ * (‖z_p‖ * ‖z_p + 1‖) * (‖Complex.Gamma z_p‖⁻¹ * ‖Complex.Gamma z_p‖) := by
          ring
        rw [h_cancel, inv_mul_cancel₀ h_gamma_zp_ne]
        ring
      have hz_p_eq : z_p = s + (((l : ℝ) / 2 : ℝ) : ℂ) - ((v / 2 : ℝ) : ℂ) * Complex.I := by
        dsimp [z_p]; push_cast; ring
      have hz_p_tri : ‖z_p‖ ≤ ‖s‖ + (l : ℝ) / 2 + |v| / 2 := by
        have ht1 := norm_sub_le (s + (((l : ℝ) / 2 : ℝ) : ℂ)) (((v / 2 : ℝ) : ℂ) * Complex.I)
        have ht2 := norm_add_le s (((l : ℝ) / 2 : ℝ) : ℂ)
        have hl_nn : (0 : ℝ) ≤ (l : ℝ) / 2 := by positivity
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hl_nn] at ht2
        rw [norm_mul, Complex.norm_real, Complex.norm_I, mul_one, Real.norm_eq_abs,
          abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)] at ht1
        rw [hz_p_eq]
        linarith
      have hz_p_le : ‖z_p‖ ≤ (16 * Real.pi) * V * ‖s‖ := by
        nlinarith [hz_p_tri, hl, hv, h_s_le_Vs, h_V_le_2Vs, h_two_le_pi]
      have hz_p1_tri : ‖z_p + 1‖ ≤ ‖z_p‖ + 1 := by
        have ht := norm_add_le z_p 1
        rw [norm_one] at ht
        exact ht
      have hz_p1_le : ‖z_p + 1‖ ≤ (16 * Real.pi) * V * ‖s‖ := by
        nlinarith [hz_p1_tri, hz_p_tri, hl, hv, h_s_le_Vs, h_V_le_2Vs, h_one_le_2Vs, h_two_le_pi]
      have h_prod_le :
          ‖z_p‖ * ‖z_p + 1‖ ≤ ((16 * Real.pi) * V * ‖s‖) * ((16 * Real.pi) * V * ‖s‖) :=
        mul_le_mul hz_p_le hz_p1_le (norm_nonneg _) (by positivity)
      rw [h_lhs_p]
      calc (‖z_p‖ * ‖z_p + 1‖) / (2 * Real.pi) ^ 2
          ≤ (((16 * Real.pi) * V * ‖s‖) * ((16 * Real.pi) * V * ‖s‖)) / (2 * Real.pi) ^ 2 :=
            div_le_div_of_nonneg_right h_prod_le (sq_nonneg _)
        _ = ((16 * Real.pi) * V * (‖s‖ / (2 * Real.pi))) ^ 2 := by ring

theorem mitsui_shifted_archimedean_gamma_inv_and_strip_ratio_bounds (D : ℝ) (r₁ r₂ : ℕ) (V : ℝ)
    (hD_pos : 0 < D) (hV_ge_one : 1 ≤ V)
    (a_real : Fin r₁ → ℕ) (ha_real : ∀ q_idx : Fin r₁, a_real q_idx ≤ 1)
    (v_real : Fin r₁ → ℝ) (hv_real : ∀ q_idx : Fin r₁, |v_real q_idx| ≤ V)
    (l_cplx : Fin r₂ → ℕ) (hl_cplx : ∀ p_idx : Fin r₂, (l_cplx p_idx : ℝ) ≤ V)
    (v_cplx : Fin r₂ → ℝ) (hv_cplx : ∀ p_idx : Fin r₂, |v_cplx p_idx| ≤ V) :
    ∃ (G_inv : ℂ → ℂ) (A_arch : ℝ),
      Differentiable ℂ G_inv ∧
      0 < A_arch ∧
      (∀ s : ℂ, 1 < s.re →
        ((D : ℂ) ^ (s / 2) *
          (∏ q_idx : Fin r₁, Complex.Gammaℝ (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I)) *
          (∏ p_idx : Fin r₂, Complex.Gammaℂ (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I))) *
          G_inv s = 1) ∧
      (∀ s : ℂ, s.re = -1 / 2 →
        ‖((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * G_inv s‖ *
          ‖(D : ℂ) ^ ((1 - s) / 2) *
            (∏ q_idx : Fin r₁, Complex.Gammaℝ ((1 - s) + (a_real q_idx : ℂ) + (v_real q_idx : ℂ) * Complex.I)) *
            (∏ p_idx : Fin r₂, Complex.Gammaℂ ((1 - s) + ((l_cplx p_idx : ℝ) / 2 : ℂ) + ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I))‖ ≤
        (16 * Real.pi) ^ (r₁ + 2 * r₂) * V ^ (r₁ + 2 * r₂) *
          ‖(D : ℂ) ^ ((1 - s) / 2) * (Complex.Gammaℝ (1 - s)) ^ r₁ * (Complex.Gammaℂ (1 - s)) ^ r₂‖) ∧
      (∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 → 1 ≤ |s.im| →
        ‖((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * G_inv s‖ ≤ A_arch) :=
by
  have hD_ne : (D : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hD_pos)
  have hpi_ne : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
  have h2pi_ne : (2 : ℂ) * (Real.pi : ℂ) ≠ 0 := mul_ne_zero two_ne_zero hpi_ne
  have hV_pos : 0 < V := lt_of_lt_of_le zero_lt_one hV_ge_one
  let d_inv : ℂ → ℂ := fun s => (D : ℂ) ^ (-s / 2)
  let gR_inv : ℂ → ℂ := fun z => (Complex.Gammaℝ z)⁻¹
  let gC_inv : ℂ → ℂ := fun z => (1 / 2 : ℂ) * (2 * (Real.pi : ℂ)) ^ z * (Complex.Gamma z)⁻¹
  let G_inv : ℂ → ℂ := fun s =>
    d_inv s *
      (∏ q_idx : Fin r₁, gR_inv (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I)) *
      (∏ p_idx : Fin r₂, gC_inv (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I))
  let B_V : ℝ := (2 * Real.pi) ^ V * (1 + 4 * V) ^ 3 * Real.exp (2 * (V + V ^ 2))
  have hB_V_pos : 0 < B_V := by dsimp [B_V]; positivity
  let A_arch : ℝ := B_V ^ (r₁ + r₂)
  have hA_arch_pos : 0 < A_arch := by dsimp [A_arch]; positivity
  have hd_cancel : ∀ s : ℂ, (D : ℂ) ^ (s / 2) * d_inv s = 1 := by
    intro s
    dsimp [d_inv]
    rw [neg_div, Complex.cpow_neg]
    exact mul_inv_cancel₀ (Complex.cpow_ne_zero_iff.mpr (Or.inl hD_ne))
  have hd_inv_diff : Differentiable ℂ d_inv :=
    ((differentiable_id.neg).div_const (2 : ℂ)).const_cpow (Or.inl hD_ne)
  have hgR_inv_diff : Differentiable ℂ gR_inv :=
    Complex.differentiable_Gammaℝ_inv
  have hgC_inv_diff : Differentiable ℂ gC_inv :=
    ((differentiable_const (1 / 2 : ℂ)).mul (differentiable_id.const_cpow (Or.inl h2pi_ne))).mul
      Complex.differentiable_one_div_Gamma
  have hprod_R_diff : Differentiable ℂ (fun s : ℂ =>
      ∏ q_idx : Fin r₁, gR_inv (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I)) := by
    apply Differentiable.fun_finset_prod
    intro q_idx _
    exact hgR_inv_diff.comp
      ((differentiable_id.add (differentiable_const _)).sub (differentiable_const _))
  have hprod_C_diff : Differentiable ℂ (fun s : ℂ =>
      ∏ p_idx : Fin r₂, gC_inv (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)) := by
    apply Differentiable.fun_finset_prod
    intro p_idx _
    exact hgC_inv_diff.comp
      ((differentiable_id.add (differentiable_const _)).sub (differentiable_const _))
  have hG_inv_diff : Differentiable ℂ G_inv :=
    (hd_inv_diff.mul hprod_R_diff).mul hprod_C_diff
  refine ⟨G_inv, A_arch, hG_inv_diff, hA_arch_pos, ?_, ?_, ?_⟩
  · intro s hs
    have h_R_one : ∀ q_idx : Fin r₁,
        Complex.Gammaℝ (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I) *
          gR_inv (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I) = 1 := by
      intro q_idx
      set z_q : ℂ := s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I
      have hz_q_re : 0 < z_q.re := by
        have ha_nn : (0 : ℝ) ≤ (a_real q_idx : ℝ) := Nat.cast_nonneg _
        simp [z_q]
        linarith
      exact mul_inv_cancel₀ (Complex.Gammaℝ_ne_zero_of_re_pos hz_q_re)
    have h_C_one : ∀ p_idx : Fin r₂,
        Complex.Gammaℂ (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I) *
          gC_inv (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I) = 1 := by
      intro p_idx
      set z_p : ℂ := s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I
      have hz_p_re : 0 < z_p.re := by
        have hl_nn : (0 : ℝ) ≤ (l_cplx p_idx : ℝ) := Nat.cast_nonneg _
        simp [z_p]
        linarith
      have hG_ne : Complex.Gamma z_p ≠ 0 := Complex.Gamma_ne_zero_of_re_pos hz_p_re
      have h2pi_pow_ne : (2 * (Real.pi : ℂ)) ^ (-z_p) ≠ 0 :=
        Complex.cpow_ne_zero_iff.mpr (Or.inl h2pi_ne)
      have hGC_ne : Complex.Gammaℂ z_p ≠ 0 := by
        rw [Complex.Gammaℂ_def]
        exact mul_ne_zero (mul_ne_zero two_ne_zero h2pi_pow_ne) hG_ne
      have hgC_eq : gC_inv z_p = (Complex.Gammaℂ z_p)⁻¹ := by
        dsimp [gC_inv]
        rw [Complex.Gammaℂ_def, Complex.cpow_neg, mul_inv, mul_inv, inv_inv]
        ring
      rw [hgC_eq]
      exact mul_inv_cancel₀ hGC_ne
    have h_prod_R :
        (∏ q_idx : Fin r₁, Complex.Gammaℝ (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I)) *
        (∏ q_idx : Fin r₁, gR_inv (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I)) = 1 := by
      rw [← Finset.prod_mul_distrib]
      exact Finset.prod_eq_one (fun q_idx _ => h_R_one q_idx)
    have h_prod_C :
        (∏ p_idx : Fin r₂, Complex.Gammaℂ (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)) *
        (∏ p_idx : Fin r₂, gC_inv (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)) = 1 := by
      rw [← Finset.prod_mul_distrib]
      exact Finset.prod_eq_one (fun p_idx _ => h_C_one p_idx)
    calc ((D : ℂ) ^ (s / 2) *
          (∏ q_idx : Fin r₁, Complex.Gammaℝ (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I)) *
          (∏ p_idx : Fin r₂, Complex.Gammaℂ (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I))) *
          G_inv s
        = ((D : ℂ) ^ (s / 2) * d_inv s) *
          ((∏ q_idx : Fin r₁, Complex.Gammaℝ (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I)) *
            (∏ q_idx : Fin r₁, gR_inv (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I))) *
          ((∏ p_idx : Fin r₂, Complex.Gammaℂ (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)) *
            (∏ p_idx : Fin r₂, gC_inv (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I))) := by
          dsimp [G_inv]; ring
      _ = 1 * 1 * 1 := by rw [hd_cancel s, h_prod_R, h_prod_C]
      _ = 1 := by ring
  · intro s hs
    obtain ⟨h_real_neg_half, h_cplx_neg_half⟩ :=
      mitsui_shifted_gammaR_and_gammaC_neg_half_re_factor_bounds V hV_ge_one s hs
    obtain ⟨_, hγ_eq⟩ := mitsui_archimedean_gamma_norm_eq_on_neg_half_re r₁ r₂ s hs
    set K_s : ℝ := (16 * Real.pi) * V * (‖s‖ / (2 * Real.pi))
    have hK_s_nn : 0 ≤ K_s := by dsimp [K_s]; positivity
    have h_R_prod_le :
        (∏ q_idx : Fin r₁,
          ‖gR_inv (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I) *
            Complex.Gammaℝ ((1 - s) + (a_real q_idx : ℂ) + (v_real q_idx : ℂ) * Complex.I)‖) ≤
        K_s ^ r₁ := by
      calc (∏ q_idx : Fin r₁,
            ‖gR_inv (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I) *
              Complex.Gammaℝ ((1 - s) + (a_real q_idx : ℂ) + (v_real q_idx : ℂ) * Complex.I)‖)
          ≤ ∏ _ : Fin r₁, K_s := by
            apply Finset.prod_le_prod
            · intro q_idx _; exact norm_nonneg _
            · intro q_idx _
              exact h_real_neg_half (a_real q_idx) (v_real q_idx) (ha_real q_idx) (hv_real q_idx)
        _ = K_s ^ r₁ := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    have h_C_prod_le :
        (∏ p_idx : Fin r₂,
          ‖gC_inv (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I) *
            Complex.Gammaℂ ((1 - s) + ((l_cplx p_idx : ℝ) / 2 : ℂ) + ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)‖) ≤
        (K_s ^ 2) ^ r₂ := by
      calc (∏ p_idx : Fin r₂,
            ‖gC_inv (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I) *
              Complex.Gammaℂ ((1 - s) + ((l_cplx p_idx : ℝ) / 2 : ℂ) + ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)‖)
          ≤ ∏ _ : Fin r₂, K_s ^ 2 := by
            apply Finset.prod_le_prod
            · intro p_idx _; exact norm_nonneg _
            · intro p_idx _
              exact h_cplx_neg_half (l_cplx p_idx) (v_cplx p_idx) (hl_cplx p_idx) (hv_cplx p_idx)
        _ = (K_s ^ 2) ^ r₂ := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    have h_lhs_simplify :
        ((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * G_inv s =
        ((Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) *
          (∏ q_idx : Fin r₁, gR_inv (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I)) *
          (∏ p_idx : Fin r₂, gC_inv (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)) := by
      calc ((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * G_inv s
          = ((D : ℂ) ^ (s / 2) * d_inv s) *
              ((Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) *
              (∏ q_idx : Fin r₁, gR_inv (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I)) *
              (∏ p_idx : Fin r₂, gC_inv (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)) := by
            dsimp [G_inv]; ring
        _ = ((Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) *
              (∏ q_idx : Fin r₁, gR_inv (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I)) *
              (∏ p_idx : Fin r₂, gC_inv (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)) := by
            rw [hd_cancel s, one_mul]
    have h_cplx_rearrange :
        (((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * G_inv s) *
          ((D : ℂ) ^ ((1 - s) / 2) *
            (∏ q_idx : Fin r₁, Complex.Gammaℝ ((1 - s) + (a_real q_idx : ℂ) + (v_real q_idx : ℂ) * Complex.I)) *
            (∏ p_idx : Fin r₂, Complex.Gammaℂ ((1 - s) + ((l_cplx p_idx : ℝ) / 2 : ℂ) + ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I))) =
        ((D : ℂ) ^ ((1 - s) / 2) * ((Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂)) *
          ((∏ q_idx : Fin r₁,
              (gR_inv (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I) *
                Complex.Gammaℝ ((1 - s) + (a_real q_idx : ℂ) + (v_real q_idx : ℂ) * Complex.I))) *
            (∏ p_idx : Fin r₂,
              (gC_inv (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I) *
                Complex.Gammaℂ ((1 - s) + ((l_cplx p_idx : ℝ) / 2 : ℂ) + ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)))) := by
      calc (((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * G_inv s) *
            ((D : ℂ) ^ ((1 - s) / 2) *
              (∏ q_idx : Fin r₁, Complex.Gammaℝ ((1 - s) + (a_real q_idx : ℂ) + (v_real q_idx : ℂ) * Complex.I)) *
              (∏ p_idx : Fin r₂, Complex.Gammaℂ ((1 - s) + ((l_cplx p_idx : ℝ) / 2 : ℂ) + ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)))
          = ((D : ℂ) ^ ((1 - s) / 2) * ((Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂)) *
              (((∏ q_idx : Fin r₁, gR_inv (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I)) *
                (∏ q_idx : Fin r₁, Complex.Gammaℝ ((1 - s) + (a_real q_idx : ℂ) + (v_real q_idx : ℂ) * Complex.I))) *
              ((∏ p_idx : Fin r₂, gC_inv (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)) *
                (∏ p_idx : Fin r₂, Complex.Gammaℂ ((1 - s) + ((l_cplx p_idx : ℝ) / 2 : ℂ) + ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)))) := by
            rw [h_lhs_simplify]; ring
        _ = ((D : ℂ) ^ ((1 - s) / 2) * ((Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂)) *
              ((∏ q_idx : Fin r₁,
                  (gR_inv (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I) *
                    Complex.Gammaℝ ((1 - s) + (a_real q_idx : ℂ) + (v_real q_idx : ℂ) * Complex.I))) *
                (∏ p_idx : Fin r₂,
                  (gC_inv (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I) *
                    Complex.Gammaℂ ((1 - s) + ((l_cplx p_idx : ℝ) / 2 : ℂ) + ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)))) := by
            rw [← Finset.prod_mul_distrib, ← Finset.prod_mul_distrib]
    have h_norm_rearrange :
        ‖((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * G_inv s‖ *
          ‖(D : ℂ) ^ ((1 - s) / 2) *
            (∏ q_idx : Fin r₁, Complex.Gammaℝ ((1 - s) + (a_real q_idx : ℂ) + (v_real q_idx : ℂ) * Complex.I)) *
            (∏ p_idx : Fin r₂, Complex.Gammaℂ ((1 - s) + ((l_cplx p_idx : ℝ) / 2 : ℂ) + ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I))‖ =
        (‖(D : ℂ) ^ ((1 - s) / 2)‖ * ‖(Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂‖) *
          ((∏ q_idx : Fin r₁,
              ‖gR_inv (s + (a_real q_idx : ℂ) - (v_real q_idx : ℂ) * Complex.I) *
                Complex.Gammaℝ ((1 - s) + (a_real q_idx : ℂ) + (v_real q_idx : ℂ) * Complex.I)‖) *
            (∏ p_idx : Fin r₂,
              ‖gC_inv (s + ((l_cplx p_idx : ℝ) / 2 : ℂ) - ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I) *
                Complex.Gammaℂ ((1 - s) + ((l_cplx p_idx : ℝ) / 2 : ℂ) + ((v_cplx p_idx : ℝ) / 2 : ℂ) * Complex.I)‖)) := by
      rw [← norm_mul, h_cplx_rearrange, norm_mul, norm_mul ((D : ℂ) ^ ((1 - s) / 2)),
