      have h_pos_y : 0 < (w.embedding (y : K)).re := by linarith
      rw [hx₀_re_eq w]
      have : 0 < (N_q : ℝ) * (w.embedding (y : K)).re := mul_pos hNq_pos h_pos_y
      linarith
    obtain ⟨x₀, hx₀_ne, hx₀_q, hx₀_neg, hx₀_pos⟩ := h_s4
    let I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
      ⟨Ideal.span ({x₀} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx₀_ne)⟩
    refine ⟨I₀, h_coprime x₀ hx₀_q, ?_⟩
    have hχ_x₀ : χ_gr I₀ = (-1 : ℂ) ^ (L w₁) := by
      rw [h_prin_simple x₀ hx₀_ne hx₀_q]
      have h_factor : ∀ w : NumberField.InfinitePlace K,
          (w.embedding (x₀ : K) / (w (x₀ : K) : ℂ)) ^ (L w) =
            if w = w₁ then (-1 : ℂ) ^ (L w₁) else 1 := by
        intro w
        by_cases hw : w = w₁
        · subst hw
          simp only [↓reduceIte]
          rw [h_real_neg x₀ w hw₁_real hx₀_neg]
        · simp only [hw, ↓reduceIte]
          rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw_real | hw_cplx
          · rw [h_real_pos x₀ w hw_real (hx₀_pos w hw_real hw), one_zpow]
          · rw [hL_cplx w hw_cplx, zpow_zero]
      calc (∏ w : NumberField.InfinitePlace K,
            (w.embedding (x₀ : K) / (w (x₀ : K) : ℂ)) ^ (L w))
        _ = ∏ w : NumberField.InfinitePlace K,
            (if w = w₁ then (-1 : ℂ) ^ (L w₁) else 1) :=
          Finset.prod_congr rfl (fun w _ => h_factor w)
        _ = (-1 : ℂ) ^ (L w₁) := by
          rw [Finset.prod_ite_eq' Finset.univ w₁]
          simp
    rw [hχ_x₀]
    exact hw₁_odd

theorem mitsui_grossenchar_heckeL_real_zeroFree_of_vertical_growth_of_units_eq_one {K : Type u} [Field K] [NumberField K] (A : ℕ) (hA : 1 < A) (A₁ : ℝ) (hA₁_pos : 0 < A₁) :
    ∃ B₂ : ℝ, 0 < B₂ ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
        ∀ w₀ : NumberField.InfinitePlace K,
          ∀ (m_freq : Fin (NumberField.Units.rank K) → ℤ)
            (l_ang : NumberField.InfinitePlace K → ℤ),
            (∀ ζ ∈ NumberField.Units.torsion K,
              (∏ w : NumberField.InfinitePlace K,
                (w.embedding ((ζ : NumberField.RingOfIntegers K) : K)) ^ (l_ang w)) = 1) →
            ((∃ j : Fin (NumberField.Units.rank K),
                -2 * Real.pi * (m_freq j : ℝ) +
                  ∑ w : NumberField.InfinitePlace K,
                    (l_ang w : ℝ) *
                      (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg ≠ 0) ∨
              (∃ w : NumberField.InfinitePlace K, w.IsComplex ∧ l_ang w ≠ 0) ∨
              (∃ w : NumberField.InfinitePlace K, w.IsReal ∧ Odd (l_ang w))) →
            ∀ M : ℝ, 1 ≤ M →
              (Ideal.absNorm q : ℝ) ≤ (M ^ 2) ^ A →
              (∀ j : Fin (NumberField.Units.rank K), |(m_freq j : ℝ)| ≤ Real.exp M) →
              (∀ w : NumberField.InfinitePlace K, |(l_ang w : ℝ)| ≤ Real.exp M) →
              ∀ χ_gr : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ,
                (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
                  ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ_gr I‖ = 1) ∧
                  (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ_gr I = 0)) →
                (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
                  x - 1 ∈ q →
                  ∃ y : Fin (NumberField.Units.rank K) → ℝ,
                    (∀ w : NumberField.InfinitePlace K,
                      Real.log (w (x : K) / w₀ (x : K)) =
                        ∑ j : Fin (NumberField.Units.rank K),
                          y j *
                            Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                              w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) ∧
                    χ_gr ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
                      mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
                      Complex.exp
                        (((∑ j : Fin (NumberField.Units.rank K),
                            y j *
                              (-2 * Real.pi * (m_freq j : ℝ) +
                                ∑ w : NumberField.InfinitePlace K,
                                  (l_ang w : ℝ) *
                                    (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg)) : ℝ) * Complex.I) =
                      ∏ w : NumberField.InfinitePlace K,
                        (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w)) →
                ∀ g_χ : ℂ → ℂ,
                  Differentiable ℂ g_χ →
                  (∀ s : ℂ, 1 < s.re →
                    g_χ s = LSeries (fun n =>
                      ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
                        χ_gr ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s) →
                  (∀ s : ℂ, 1 / 2 ≤ s.re → s.re ≤ 2 →
                    ‖g_χ s‖ ≤ A₁ * ((Ideal.absNorm q : ℝ) * Real.exp M * (4 + |s.im|)) ^ (Module.finrank ℚ K + 1)) →
                  ∀ σ : ℝ,
                    1 - B₂ / M ≤ σ →
                    g_χ (σ : ℂ) ≠ 0 :=
by
  classical
  obtain ⟨A₂, hA₂_pos, h_sq_entire⟩ :=
    mitsui_grossenchar_sq_heckeL_entire_and_vertical_growth (K := K)
  obtain ⟨B₁, hB₁_pos, h_cplx_zf⟩ :=
    mitsui_ray_char_heckeL_real_zeroFree_of_sq_entire (K := K) A₁ hA₁_pos A₂ hA₂_pos
  obtain ⟨A₃, hA₃_pos, _, h_narrow_entire⟩ :=
    mitsui_grossenchar_real_narrow_ray_entire_and_vertical_growth (K := K)
