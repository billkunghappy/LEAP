  have hInt_bound :=
    mitsui_riesz_poleFree_boundary_integrable B hB_pos Y hY
  have h_horiz_tendsto :=
    mitsui_riesz_poleFree_horiz_caps_tendsto_zero B C D hB_pos hB_le hC_pos hD_dlvp Y hY
