theorem mitsui_estermann_entire_sphere_taylor_zero_bound (H : ℂ → ℂ) (ρ : ℂ) (b : ℕ → ℝ) (M α₁ : ℝ)
    (hH_diff : Differentiable ℂ H)
    (hb_zero : b 0 = 1)
    (hb_nonneg : ∀ m : ℕ, 0 ≤ b m)
    (hH_taylor : ∀ m : ℕ,
      (m.factorial : ℂ)⁻¹ * (-1 : ℂ) ^ m * iteratedDeriv m H 2 = (b m : ℂ) - ρ)
