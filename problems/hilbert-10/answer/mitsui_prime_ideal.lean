    exact Complex.exp_int_mul_two_pi_mul_I (∑ j : Fin r, d j * m j)
  have h_real_tors : ∀ (I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) (ν : ℕ)
      (w : NumberField.InfinitePlace K),
      ‖(Φ_τ I w) ^ ν‖ = 1 ∧
      (w.IsReal →
        ((Φ_τ I w) ^ ν *
          Complex.exp
            (((∑ j : Fin r, ((ν : ℝ) * Φ_W I j) * (w.embedding (η j)).arg) : ℝ) * Complex.I)) ^
          (2 * h_K) = 1) := by
    intro I ν w
    refine ⟨by rw [norm_pow, hΦ_τ_norm I w, one_pow], fun hw => ?_⟩
    let z_I : ℂ :=
      Φ_τ I w *
        Complex.exp (((∑ j : Fin r, Φ_W I j * (w.embedding (η j)).arg) : ℝ) * Complex.I)
    obtain ⟨x, hx_ne, hx_eq⟩ := h_prin_pow I
    obtain ⟨d₁, hd₁⟩ := hΦ_W_pow I h_K
    obtain ⟨ζ₁, hζ₁⟩ := hΦ_τ_pow I h_K
