            ∑ j : Fin (NumberField.Units.rank K),
              (m_freq j : ℝ) *
                ((pm.1.2 : ℝ) * Φ_W ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩ j)) *
            ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
              Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)‖ ≤ B_osc) :
    ‖∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
        Complex.exp
          (2 * Real.pi * Complex.I *
            ∑ j : Fin (NumberField.Units.rank K),
              (θ₀ j : ℂ) *
                ((Int.fract ((pm.1.2 : ℝ) * Φ_W ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩ j) : ℝ) : ℂ)) *
          ((χ' ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
            ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
              Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ))‖ ≤
      2 * A_main * (2 * (M : ℝ) + 1) ^ (NumberField.Units.rank K) * B_osc +
        (A_collar + ε_tail) *
          (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
              Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))) :=
by
  classical
  have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p.asIdeal := by
    intro p
    have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    omega
  have h_pm_bounds : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (ν : ℕ),
      1 ≤ ν → (Ideal.absNorm p.asIdeal : ℝ) ^ ν ≤ Y →
      Ideal.absNorm p.asIdeal ≤ ⌊Y⌋₊ ∧ ν ≤ ⌊Y⌋₊ := by
    intro p ν hν h_pow
    have hk2 : 2 ≤ Ideal.absNorm p.asIdeal := h_norm_ge_two p
    have h_pow_nat : ((Ideal.absNorm p.asIdeal ^ ν : ℕ) : ℝ) ≤ Y := by exact_mod_cast h_pow
    have h_km_le : Ideal.absNorm p.asIdeal ^ ν ≤ ⌊Y⌋₊ := Nat.le_floor h_pow_nat
    have hν_ne : ν ≠ 0 := by omega
    have hk_le_km : Ideal.absNorm p.asIdeal ≤ Ideal.absNorm p.asIdeal ^ ν :=
      Nat.le_self_pow hν_ne (Ideal.absNorm p.asIdeal)
    have hν_le_2ν : ν ≤ 2 ^ ν := (Nat.lt_pow_self (by decide : 1 < 2)).le
    have h2ν_le_km : 2 ^ ν ≤ Ideal.absNorm p.asIdeal ^ ν := Nat.pow_le_pow_left hk2 ν
    exact ⟨le_trans hk_le_km h_km_le, le_trans (le_trans hν_le_2ν h2ν_le_km) h_km_le⟩
  let D_Y := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y}
  let S_prod : Set (Ideal (NumberField.RingOfIntegers K) × ℕ) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊} ×ˢ {ν : ℕ | ν ≤ ⌊Y⌋₊}
  have hSprod_fin : S_prod.Finite :=
    (Ideal.finite_setOf_absNorm_le ⌊Y⌋₊).prod (Set.finite_le_nat ⌊Y⌋₊)
  haveI : Finite S_prod := hSprod_fin
  let f_Y : D_Y → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2), h_pm_bounds pm.1.1 pm.1.2 pm.2.1 pm.2.2⟩
  have hf_Y_inj : Function.Injective f_Y := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    dsimp [f_Y] at hval
    exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext (Prod.mk.inj hval).1) (Prod.mk.inj hval).2)
  haveI : Finite D_Y := Finite.of_injective f_Y hf_Y_inj
  letI : Fintype D_Y := Fintype.ofFinite D_Y
  let w_riesz : D_Y → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal) *
      Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
  let ξ : D_Y → ℂ := fun pm =>
    (χ' ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2
  have hw_nonneg : ∀ pm : D_Y, 0 ≤ w_riesz pm := by
    intro pm
    dsimp [w_riesz]
    have hk2 : 2 ≤ Ideal.absNorm pm.1.1.asIdeal := h_norm_ge_two pm.1.1
    have hk1 : (1 : ℝ) ≤ (Ideal.absNorm pm.1.1.asIdeal : ℝ) := by
      have : 1 ≤ Ideal.absNorm pm.1.1.asIdeal := by omega
      exact_mod_cast this
    have hk_pos : (0 : ℝ) < (Ideal.absNorm pm.1.1.asIdeal : ℝ) := by linarith
    have hpow_pos : (0 : ℝ) < (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 := pow_pos hk_pos pm.1.2
    have hdiv_ge_one : 1 ≤ Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2) :=
