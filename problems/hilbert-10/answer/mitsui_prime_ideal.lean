theorem mitsui_periodic_hat_circle_pou_and_cos_sin_collar_card_bound (K_δ : ℕ) (hK_δ : 3 ≤ K_δ) :
    (∀ x : ℝ,
      ∑ p ∈ Finset.Ico (0 : ℤ) (K_δ : ℤ),
        max (0 : ℝ)
          (1 - |x - (p : ℝ) * (K_δ : ℝ)⁻¹ -
