    ⟨(pm.1.1.asIdeal, pm.1.2), h_pm_bounds pm.1.1 pm.1.2 pm.2.1 pm.2.2⟩
  have hf_all_Z_inj : Function.Injective f_all_Z := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    dsimp [f_all_Z] at hval
    exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext (Prod.mk.inj hval).1) (Prod.mk.inj hval).2)
  haveI : Finite D_all_Z := Finite.of_injective f_all_Z hf_all_Z_inj
  letI : Fintype D_all_Z := Fintype.ofFinite D_all_Z
  let f_all_Y : D_all_Y → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2),
      h_pm_bounds pm.1.1 pm.1.2 pm.2.1 (le_trans pm.2.2 hY_le_Z)⟩
  have hf_all_Y_inj : Function.Injective f_all_Y := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    dsimp [f_all_Y] at hval
    exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext (Prod.mk.inj hval).1) (Prod.mk.inj hval).2)
  haveI : Finite D_all_Y := Finite.of_injective f_all_Y hf_all_Y_inj
  letI : Fintype D_all_Y := Fintype.ofFinite D_all_Y
  have h_log_split : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (ν : ℕ),
      Real.log ((Real.exp δ * Y) / ((Ideal.absNorm p.asIdeal : ℝ) ^ ν)) =
      Real.log (Y / ((Ideal.absNorm p.asIdeal : ℝ) ^ ν)) + δ := by
    intro p ν
    have hk_pos : (0 : ℝ) < (Ideal.absNorm p.asIdeal : ℝ) := by
      have := h_norm_ge_two p
      positivity
    have hpow_pos : (0 : ℝ) < (Ideal.absNorm p.asIdeal : ℝ) ^ ν := pow_pos hk_pos ν
    rw [Real.log_div (ne_of_gt hZ_pos) (ne_of_gt hpow_pos),
      Real.log_mul (ne_of_gt (Real.exp_pos δ)) (ne_of_gt hY),
      Real.log_exp,
      Real.log_div (ne_of_gt hY) (ne_of_gt hpow_pos)]
    ring
  let P_prin : D_prin_Z → Prop := fun pm =>
    (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 ≤ Y
  let P_all : D_all_Z → Prop := fun pm =>
    (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 ≤ Y
  let e_prin : D_prin_Y ≃ {pm : D_prin_Z // P_prin pm} :=
    { toFun := fun pm =>
        ⟨⟨pm.1, ⟨pm.2.1, ⟨pm.2.2.choose,
          le_trans pm.2.2.choose_spec.1 hY_le_Z, pm.2.2.choose_spec.2⟩⟩⟩,
          pm.2.2.choose_spec.1⟩
      invFun := fun pm =>
        ⟨pm.1.1, ⟨pm.1.2.1, ⟨pm.1.2.2.choose, pm.2, pm.1.2.2.choose_spec.2⟩⟩⟩
      left_inv := fun pm => by apply Subtype.ext; rfl
      right_inv := fun pm => by apply Subtype.ext; apply Subtype.ext; rfl }
  let e_all : D_all_Y ≃ {pm : D_all_Z // P_all pm} :=
    { toFun := fun pm =>
        ⟨⟨pm.1, ⟨pm.2.1, le_trans pm.2.2 hY_le_Z⟩⟩, pm.2.2⟩
      invFun := fun pm => ⟨pm.1.1, ⟨pm.1.2.1, pm.2⟩⟩
      left_inv := fun pm => by apply Subtype.ext; rfl
      right_inv := fun pm => by apply Subtype.ext; apply Subtype.ext; rfl }
  let M_free (I : Ideal (NumberField.RingOfIntegers K)) (hI : I.IsPrincipal) : ℕ :=
    Nat.card {e : Fin (NumberField.Units.rank K) → ℤ //
      ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
        Real.log (w ((@Submodule.IsPrincipal.generator _ _ _ _ _ I hI : NumberField.RingOfIntegers K) : K) /
            w₀ ((@Submodule.IsPrincipal.generator _ _ _ _ _ I hI : NumberField.RingOfIntegers K) : K)) +
          ∑ j : Fin (NumberField.Units.rank K),
            (e j : ℝ) *
              Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ∈
          Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
            (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))}
  let term_prin_Z : D_prin_Z → ℂ := fun pm =>
    (M_free (pm.1.1.asIdeal ^ pm.1.2) pm.2.2.choose : ℂ) *
      (ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
        ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
          Real.log ((Real.exp δ * Y) / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ))
  let term_prin_Y : D_prin_Y → ℂ := fun pm =>
    (M_free (pm.1.1.asIdeal ^ pm.1.2) pm.2.2.choose : ℂ) *
      (ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
        ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
          Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ))
  let term_ψ_prin_Y : D_prin_Y → ℂ := fun pm =>
    (M_free (pm.1.1.asIdeal ^ pm.1.2) pm.2.2.choose : ℂ) *
      (ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
        (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ))
  have h_term_prin_split : ∀ pm : D_prin_Y,
      term_prin_Z (e_prin pm).1 = term_prin_Y pm + (δ : ℂ) * term_ψ_prin_Y pm := by
    intro pm
    have hU : (e_prin pm).1.2.2.choose_spec.2.unit = pm.2.2.choose_spec.2.unit := by
      apply Units.ext
      simp only [IsUnit.unit_spec]
      rfl
    have hM : M_free (pm.1.1.asIdeal ^ pm.1.2) (e_prin pm).1.2.2.choose =
        M_free (pm.1.1.asIdeal ^ pm.1.2) pm.2.2.choose := rfl
    dsimp [term_prin_Z, term_prin_Y, term_ψ_prin_Y]
    rw [hU, hM]
    change (M_free (pm.1.1.asIdeal ^ pm.1.2) pm.2.2.choose : ℂ) *
        (ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
          ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
            Real.log ((Real.exp δ * Y) / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)) =
      (M_free (pm.1.1.asIdeal ^ pm.1.2) pm.2.2.choose : ℂ) *
        (ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
          ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
            Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)) +
      (δ : ℂ) * ((M_free (pm.1.1.asIdeal ^ pm.1.2) pm.2.2.choose : ℂ) *
        (ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
          (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)))
    rw [h_log_split pm.1.1 pm.1.2]
    push_cast
    ring
  have h_sum_prin_filter :
      ∑ pm ∈ Finset.univ.filter P_prin, term_prin_Z pm =
      (∑' pm : D_prin_Y, term_prin_Y pm) +
        (δ : ℂ) * (∑' pm : D_prin_Y, term_ψ_prin_Y pm) := by
    have h1 : ∑ pm ∈ Finset.univ.filter P_prin, term_prin_Z pm =
        ∑' pm : {pm : D_prin_Z // P_prin pm}, term_prin_Z pm.1 := by
      rw [tsum_fintype]
      exact Finset.sum_subtype (Finset.univ.filter P_prin) (fun _ => by simp) term_prin_Z
    have h2 : (∑' pm : {pm : D_prin_Z // P_prin pm}, term_prin_Z pm.1) =
        ∑' pm : D_prin_Y, term_prin_Z (e_prin pm).1 :=
      (Equiv.tsum_eq e_prin (fun pm : {pm : D_prin_Z // P_prin pm} => term_prin_Z pm.1)).symm
    rw [h1, h2, tsum_congr h_term_prin_split, tsum_fintype, tsum_fintype, tsum_fintype,
      Finset.sum_add_distrib, ← Finset.mul_sum]
  have h_sum_prin_Z : (∑' pm : D_prin_Z, term_prin_Z pm) =
      (∑ pm ∈ Finset.univ.filter P_prin, term_prin_Z pm) +
      (∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm), term_prin_Z pm) := by
    rw [tsum_fintype]
    exact (Finset.sum_filter_add_sum_filter_not Finset.univ P_prin term_prin_Z).symm
  have h_lhs_eq :
      ((∑' pm : D_prin_Z, term_prin_Z pm) - (∑' pm : D_prin_Y, term_prin_Y pm)) -
        (δ : ℂ) * (∑' pm : D_prin_Y, term_ψ_prin_Y pm) =
      ∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm), term_prin_Z pm := by
    rw [h_sum_prin_Z, h_sum_prin_filter]
    ring
  let term_all_Z : D_all_Z → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal) *
      Real.log ((Real.exp δ * Y) / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
  let term_all_Y : D_all_Y → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal) *
      Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
  let term_ψ_all_Y : D_all_Y → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal)
  have h_term_all_split : ∀ pm : D_all_Y,
      term_all_Z (e_all pm).1 = term_all_Y pm + δ * term_ψ_all_Y pm := by
    intro pm
    dsimp [term_all_Z, term_all_Y, term_ψ_all_Y, e_all]
    rw [h_log_split pm.1.1 pm.1.2]
    ring
  have h_sum_all_filter :
      ∑ pm ∈ Finset.univ.filter P_all, term_all_Z pm =
      (∑' pm : D_all_Y, term_all_Y pm) +
        δ * (∑' pm : D_all_Y, term_ψ_all_Y pm) := by
    have h1 : ∑ pm ∈ Finset.univ.filter P_all, term_all_Z pm =
        ∑' pm : {pm : D_all_Z // P_all pm}, term_all_Z pm.1 := by
      rw [tsum_fintype]
      exact Finset.sum_subtype (Finset.univ.filter P_all) (fun _ => by simp) term_all_Z
    have h2 : (∑' pm : {pm : D_all_Z // P_all pm}, term_all_Z pm.1) =
        ∑' pm : D_all_Y, term_all_Z (e_all pm).1 :=
      (Equiv.tsum_eq e_all (fun pm : {pm : D_all_Z // P_all pm} => term_all_Z pm.1)).symm
    rw [h1, h2, tsum_congr h_term_all_split, tsum_fintype, tsum_fintype, tsum_fintype,
      Finset.sum_add_distrib, ← Finset.mul_sum]
  have h_sum_all_Z : (∑' pm : D_all_Z, term_all_Z pm) =
      (∑ pm ∈ Finset.univ.filter P_all, term_all_Z pm) +
      (∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_all_Z pm) := by
    rw [tsum_fintype]
    exact (Finset.sum_filter_add_sum_filter_not Finset.univ P_all term_all_Z).symm
  have h_rhs_eq :
      ((∑' pm : D_all_Z, term_all_Z pm) - (∑' pm : D_all_Y, term_all_Y pm)) -
        δ * (∑' pm : D_all_Y, term_ψ_all_Y pm) =
      ∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_all_Z pm := by
    rw [h_sum_all_Z, h_sum_all_filter]
    ring
  have h_term_all_Z_nonneg : ∀ pm : D_all_Z, 0 ≤ term_all_Z pm := by
    intro pm
    dsimp [term_all_Z]
    apply mul_nonneg (Real.log_natCast_nonneg _)
    apply Real.log_nonneg
    have hk_pos : (0 : ℝ) < (Ideal.absNorm pm.1.1.asIdeal : ℝ) := by
      have := h_norm_ge_two pm.1.1
      positivity
    have hpow_pos : (0 : ℝ) < (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 :=
      pow_pos hk_pos pm.1.2
    exact (one_le_div₀ hpow_pos).mpr pm.2.2
  let emb_short : {pm : D_prin_Z // ¬ P_prin pm} ↪ {pm : D_all_Z // ¬ P_all pm} :=
    { toFun := fun pm => ⟨⟨pm.1.1, ⟨pm.1.2.1, pm.1.2.2.choose_spec.1⟩⟩, pm.2⟩
      inj' := fun a b hab => by
        have hval := congrArg Subtype.val (congrArg Subtype.val hab)
        apply Subtype.ext; apply Subtype.ext; exact hval }
  have h_term_prin_norm_le : ∀ pm : D_prin_Z,
      ‖term_prin_Z pm‖ ≤ B * term_all_Z ⟨pm.1, ⟨pm.2.1, pm.2.2.choose_spec.1⟩⟩ := by
    intro pm
    have h_nonneg : 0 ≤ term_all_Z ⟨pm.1, ⟨pm.2.1, pm.2.2.choose_spec.1⟩⟩ :=
      h_term_all_Z_nonneg ⟨pm.1, ⟨pm.2.1, pm.2.2.choose_spec.1⟩⟩
    have hM_le : (M_free (pm.1.1.asIdeal ^ pm.1.2) pm.2.2.choose : ℝ) ≤ B :=
      hB pm.1.1 pm.1.2 pm.2.1 pm.2.2.choose
    dsimp [term_prin_Z, term_all_Z] at h_nonneg ⊢
    rw [norm_mul, norm_mul, Complex.norm_natCast, AddChar.norm_apply, one_mul,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg h_nonneg]
    exact mul_le_mul_of_nonneg_right hM_le h_nonneg
  let F_short : {pm : D_all_Z // ¬ P_all pm} → ℝ := fun pm => term_all_Z pm.1
  have h_short_le :
      (∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm),
          term_all_Z ⟨pm.1, ⟨pm.2.1, pm.2.2.choose_spec.1⟩⟩) ≤
      ∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_all_Z pm := by
    calc ∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm),
            term_all_Z ⟨pm.1, ⟨pm.2.1, pm.2.2.choose_spec.1⟩⟩
      _ = ∑ pm : {pm : D_prin_Z // ¬ P_prin pm}, F_short (emb_short pm) :=
        Finset.sum_subtype (Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm))
          (fun _ => by simp) (fun pm : D_prin_Z => term_all_Z ⟨pm.1, ⟨pm.2.1, pm.2.2.choose_spec.1⟩⟩)
      _ = ∑ pm ∈ Finset.map emb_short Finset.univ, F_short pm :=
        (Finset.sum_map Finset.univ emb_short F_short).symm
      _ ≤ ∑ pm : {pm : D_all_Z // ¬ P_all pm}, F_short pm :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
          (fun pm _ _ => h_term_all_Z_nonneg pm.1)
      _ = ∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_all_Z pm :=
        (Finset.sum_subtype (Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm))
          (fun _ => by simp) term_all_Z).symm
  rw [h_lhs_eq, h_rhs_eq]
  calc ‖∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm), term_prin_Z pm‖
    _ ≤ ∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm), ‖term_prin_Z pm‖ :=
      norm_sum_le _ _
    _ ≤ ∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm),
          (B * term_all_Z ⟨pm.1, ⟨pm.2.1, pm.2.2.choose_spec.1⟩⟩) :=
      Finset.sum_le_sum (fun pm _ => h_term_prin_norm_le pm)
    _ = B * ∑ pm ∈ Finset.univ.filter (fun pm : D_prin_Z => ¬ P_prin pm),
          term_all_Z ⟨pm.1, ⟨pm.2.1, pm.2.2.choose_spec.1⟩⟩ :=
      (Finset.mul_sum _ _ B).symm
    _ ≤ B * ∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_all_Z pm :=
      mul_le_mul_of_nonneg_left h_short_le hB₀

theorem mitsui_exists_ideal_monoidHom_extending_unit_trivial_char {K : Type u} [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ)
    (hψ_units : ∀ u : (NumberField.RingOfIntegers K)ˣ,
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) :
    ∃ χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ,
      (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0)
        (hx : IsUnit (Ideal.Quotient.mk q x)),
        χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
          ψ (Additive.ofMul hx.unit)) ∧
      (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        ¬ IsUnit (Ideal.Quotient.mk q x) →
        χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 0) :=
by
  classical
  have h_s2 : ∀ {M : Type u} [CommMonoid M] [IsCancelMul M]
      (S : Submonoid M) (ϕ₀ : S →* ℂˣ),
      ∃ ϕ : M →* ℂˣ, ∀ s : S, ϕ s.1 = ϕ₀ s := by
    clear q hq ψ hψ_units
    intro M _ _ S ϕ₀
    haveI : DivisibleBy (Additive ℂˣ) ℕ :=
      { div := fun a n =>
          if hn : n = 0 then 0
          else
            let hpos : 0 < n := Nat.pos_of_ne_zero hn
            let u : ℂˣ := Additive.toMul a
            let z := (IsAlgClosed.exists_pow_nat_eq (u : ℂ) hpos).choose
            let hz : z ^ n = (u : ℂ) :=
              (IsAlgClosed.exists_pow_nat_eq (u : ℂ) hpos).choose_spec
            let hz0 : z ≠ 0 := by
              intro h0
              have hpow : z ^ n = 0 := by rw [h0, zero_pow hn]
              rw [hz] at hpow
              exact Units.ne_zero u hpow
            Additive.ofMul (Units.mk0 z hz0)
        div_zero := by simp
        div_cancel := fun {n} a hn => by
          dsimp
          rw [dif_neg hn]
          set hpos : 0 < n := Nat.pos_of_ne_zero hn
          set u : ℂˣ := Additive.toMul a
          set z := (IsAlgClosed.exists_pow_nat_eq (u : ℂ) hpos).choose
          set hz : z ^ n = (u : ℂ) :=
            (IsAlgClosed.exists_pow_nat_eq (u : ℂ) hpos).choose_spec
          have hz0 : z ≠ 0 := by
            intro h0
            have hpow : z ^ n = 0 := by rw [h0, zero_pow hn]
            rw [hz] at hpow
            exact Units.ne_zero u hpow
          rw [← ofMul_pow]
          have hu : (Units.mk0 z hz0) ^ n = u := by
            ext
            simpa using hz
          rw [hu, ofMul_toMul] }
    haveI : DivisibleBy (Additive ℂˣ) ℤ := AddGroup.divisibleByIntOfDivisibleByNat (Additive ℂˣ)
    haveI : Module.Injective ℤ (Additive ℂˣ) :=
      Module.Baer.injective (Module.Baer.of_divisible (Additive ℂˣ))
    let ι_M : M →* Algebra.GrothendieckGroup M := Algebra.GrothendieckGroup.of
    let ι_S : S →* Algebra.GrothendieckGroup S := Algebra.GrothendieckGroup.of
    let F : Algebra.GrothendieckGroup S →* Algebra.GrothendieckGroup M :=
      Algebra.GrothendieckGroup.lift (ι_M.comp S.subtype)
    let Φ₀ : Algebra.GrothendieckGroup S →* ℂˣ :=
      Algebra.GrothendieckGroup.lift ϕ₀
    have hF_of : ∀ s : S, F (ι_S s) = ι_M s.1 := by
      intro s
      have hcomp : F.comp ι_S = ι_M.comp S.subtype := by
        change (Algebra.GrothendieckGroup.lift (ι_M.comp S.subtype)).comp Algebra.GrothendieckGroup.of = _
        rw [← Algebra.GrothendieckGroup.lift_symm_apply]
        exact Algebra.GrothendieckGroup.lift.symm_apply_apply (ι_M.comp S.subtype)
      exact DFunLike.congr_fun hcomp s
    have hΦ₀_of : ∀ s : S, Φ₀ (ι_S s) = ϕ₀ s := by
      intro s
      have hcomp : Φ₀.comp ι_S = ϕ₀ := by
        change (Algebra.GrothendieckGroup.lift ϕ₀).comp Algebra.GrothendieckGroup.of = _
        rw [← Algebra.GrothendieckGroup.lift_symm_apply]
        exact Algebra.GrothendieckGroup.lift.symm_apply_apply ϕ₀
      exact DFunLike.congr_fun hcomp s
    have hF_inj : Function.Injective F := by
      rw [← MonoidHom.ker_eq_bot_iff, Subgroup.eq_bot_iff_forall]
      intro z hz
      rw [MonoidHom.mem_ker] at hz
      let locS := Localization.monoidOf (⊤ : Submonoid S)
      let p := locS.sec z
      have hF_apply : F z = ι_M p.1.1 / ι_M (p.2 : S).1 := by
        simpa [F, p, locS] using Algebra.GrothendieckGroup.lift_apply (ι_M.comp S.subtype) z
      rw [hz] at hF_apply
      have h_eq_M : ι_M p.1.1 = ι_M (p.2 : S).1 := div_eq_one.mp hF_apply.symm
      have hp_eq_val : p.1.1 = (p.2 : S).1 := Algebra.GrothendieckGroup.of_injective h_eq_M
      have hp_eq : p.1 = (p.2 : S) := Subtype.ext hp_eq_val
      have hsec : locS.toMonoidHom p.1 = locS.toMonoidHom p.2 * z := locS.sec_spec' z
      rw [hp_eq] at hsec
      have hsec1 : locS.toMonoidHom (p.2 : S) * z = locS.toMonoidHom (p.2 : S) * 1 := by
        rw [mul_one, ← hsec]
      exact mul_left_cancel hsec1
    let F_lin : Additive (Algebra.GrothendieckGroup S) →ₗ[ℤ] Additive (Algebra.GrothendieckGroup M) :=
      (MonoidHom.toAdditive F).toIntLinearMap
    let Φ₀_lin : Additive (Algebra.GrothendieckGroup S) →ₗ[ℤ] Additive ℂˣ :=
      (MonoidHom.toAdditive Φ₀).toIntLinearMap
    have hF_lin_inj : Function.Injective F_lin := hF_inj
    obtain ⟨Φ_hat_lin, hΦ_hat_comp⟩ :=
      @Module.Injective.extension_property ℤ _ _ (Additive ℂˣ) _ _ inferInstance
        (Additive (Algebra.GrothendieckGroup S)) _ _
        (Additive (Algebra.GrothendieckGroup M)) _ _
        F_lin hF_lin_inj Φ₀_lin
    let Φ_hat : Algebra.GrothendieckGroup M →* ℂˣ :=
      MonoidHom.toAdditive.symm Φ_hat_lin.toAddMonoidHom
    refine ⟨Φ_hat.comp ι_M, fun s => ?_⟩
    change Φ_hat (ι_M s.1) = ϕ₀ s
    rw [← hF_of s]
    have h_step : Φ_hat (F (ι_S s)) = Φ₀ (ι_S s) := by
      have h1 := LinearMap.congr_fun hΦ_hat_comp (Additive.ofMul (ι_S s))
      exact congrArg Additive.toMul h1
    rw [h_step, hΦ₀_of s]
  let ψu : (NumberField.RingOfIntegers K ⧸ q)ˣ →* ℂˣ :=
    { toFun := fun u =>
        ⟨ψ (Additive.ofMul u), ψ (Additive.ofMul u⁻¹),
          by rw [← AddChar.map_add_eq_mul, ← ofMul_mul, mul_inv_cancel, ofMul_one, AddChar.map_zero_eq_one],
          by rw [← AddChar.map_add_eq_mul, ← ofMul_mul, inv_mul_cancel, ofMul_one, AddChar.map_zero_eq_one]⟩
      map_one' := by
        ext
        simp [ofMul_one, AddChar.map_zero_eq_one]
      map_mul' := by
        intro a b
        ext
        simp [ofMul_mul, AddChar.map_add_eq_mul] }
  have h_wd : ∀ (x y : NumberField.RingOfIntegers K)
      (hx : IsUnit (Ideal.Quotient.mk q x)) (hy : IsUnit (Ideal.Quotient.mk q y)),
      Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) =
        Ideal.span ({y} : Set (NumberField.RingOfIntegers K)) →
      ψu hx.unit = ψu hy.unit := by
    intro x y hx hy hspan
    obtain ⟨u, rfl⟩ := Ideal.span_singleton_eq_span_singleton.mp hspan
    have hy_unit : hy.unit = hx.unit * Units.map (Ideal.Quotient.mk q).toMonoidHom u := by
      ext
      simp [IsUnit.unit_spec]
    have hu_one : ψu (Units.map (Ideal.Quotient.mk q).toMonoidHom u) = 1 := by
      ext
      exact hψ_units u
    rw [hy_unit, map_mul, hu_one, mul_one]
  let S : Submonoid (nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :=
    { carrier := {I | ∃ (x : NumberField.RingOfIntegers K) (_hx_ne : x ≠ 0)
        (_hx : IsUnit (Ideal.Quotient.mk q x)),
        (I : Ideal (NumberField.RingOfIntegers K)) = Ideal.span ({x} : Set (NumberField.RingOfIntegers K))}
      one_mem' := ⟨1, one_ne_zero, by simp, by simp [Ideal.one_eq_top]⟩
      mul_mem' := by
        rintro I J ⟨x, hx_ne, hx, hI⟩ ⟨y, hy_ne, hy, hJ⟩
        refine ⟨x * y, mul_ne_zero hx_ne hy_ne, ?_, ?_⟩
        · rw [map_mul]
          exact hx.mul hy
        · change (I : Ideal (NumberField.RingOfIntegers K)) * (J : Ideal (NumberField.RingOfIntegers K)) = _
          rw [hI, hJ, Ideal.span_singleton_mul_span_singleton] }
  let f : S → ℂˣ := fun s => ψu s.2.choose_spec.2.choose.unit
  have hf_eq : ∀ (s : S) (x : NumberField.RingOfIntegers K)
      (hx : IsUnit (Ideal.Quotient.mk q x)),
      (s.1 : Ideal (NumberField.RingOfIntegers K)) = Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) →
      f s = ψu hx.unit := by
    intro s x hx hsx
    dsimp [f]
    apply h_wd
    rw [← s.2.choose_spec.2.choose_spec, hsx]
  let ϕ₀ : S →* ℂˣ :=
    { toFun := f
      map_one' := by
        have h1 : IsUnit (Ideal.Quotient.mk q (1 : NumberField.RingOfIntegers K)) := by simp
        have hf1 := hf_eq 1 1 h1 (by simp [Ideal.one_eq_top])
        have h1_unit : h1.unit = 1 := by
          ext
          simp
        rw [hf1, h1_unit, map_one]
      map_mul' := by
        intro s₁ s₂
        obtain ⟨x, hx_ne, hx, hx_span⟩ := s₁.2
        obtain ⟨y, hy_ne, hy, hy_span⟩ := s₂.2
        have hxy : IsUnit (Ideal.Quotient.mk q (x * y)) := by
          rw [map_mul]
          exact hx.mul hy
        have hxy_span : (((s₁ * s₂ : S).1 : nonZeroDivisors _) : Ideal (NumberField.RingOfIntegers K)) =
            Ideal.span ({x * y} : Set (NumberField.RingOfIntegers K)) := by
          change (s₁.1 : Ideal (NumberField.RingOfIntegers K)) * (s₂.1 : Ideal (NumberField.RingOfIntegers K)) = _
          rw [hx_span, hy_span, Ideal.span_singleton_mul_span_singleton]
        rw [hf_eq (s₁ * s₂) (x * y) hxy hxy_span, hf_eq s₁ x hx hx_span, hf_eq s₂ y hy hy_span]
        have hxy_unit : hxy.unit = hx.unit * hy.unit := by
          ext
          simp [IsUnit.unit_spec]
        rw [hxy_unit, map_mul] }
  haveI : IsLeftCancelMul (nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :=
    ⟨fun a b c h => Subtype.ext (mul_left_cancel₀ (nonZeroDivisors.ne_zero a.2) (congrArg Subtype.val h))⟩
  haveI : IsRightCancelMul (nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :=
    ⟨fun a b c h => Subtype.ext (mul_right_cancel₀ (nonZeroDivisors.ne_zero a.2) (congrArg Subtype.val h))⟩
  haveI : IsCancelMul (nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) := ⟨⟩
  obtain ⟨ϕ, hϕ⟩ := h_s2 S ϕ₀
  have h_coprime_mul : ∀ I J : Ideal (NumberField.RingOfIntegers K),
      (I * J) ⊔ q = ⊤ ↔ (I ⊔ q = ⊤ ∧ J ⊔ q = ⊤) := by
    intro I J
    rw [← Ideal.isCoprime_iff_sup_eq, ← Ideal.isCoprime_iff_sup_eq, ← Ideal.isCoprime_iff_sup_eq]
    exact IsCoprime.mul_left_iff
  let χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ :=
    { toFun := fun I => if (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ then (ϕ I : ℂ) else 0
      map_one' := by simp
      map_mul' := by
        intro I J
        dsimp
        have hmul := h_coprime_mul (I : Ideal (NumberField.RingOfIntegers K))
          (J : Ideal (NumberField.RingOfIntegers K))
        by_cases hI : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤
        · by_cases hJ : (J : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤
          · have hIJ : ((I : Ideal (NumberField.RingOfIntegers K)) *
                (J : Ideal (NumberField.RingOfIntegers K))) ⊔ q = ⊤ :=
              hmul.mpr ⟨hI, hJ⟩
            rw [if_pos hIJ, if_pos hI, if_pos hJ, map_mul, Units.val_mul]
          · have hIJ : ¬ (((I : Ideal (NumberField.RingOfIntegers K)) *
                (J : Ideal (NumberField.RingOfIntegers K))) ⊔ q = ⊤) :=
              fun h => hJ (hmul.mp h).2
            rw [if_neg hIJ, if_neg hJ, mul_zero]
        · have hIJ : ¬ (((I : Ideal (NumberField.RingOfIntegers K)) *
              (J : Ideal (NumberField.RingOfIntegers K))) ⊔ q = ⊤) :=
            fun h => hI (hmul.mp h).1
          rw [if_neg hIJ, if_neg hI, zero_mul] }
  have h_unit_iff : ∀ x : NumberField.RingOfIntegers K,
      IsUnit (Ideal.Quotient.mk q x) ↔ Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ q = ⊤ := by
    intro x
    constructor
    · intro hx
      obtain ⟨u, hu⟩ := hx
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective ((u⁻¹ : (NumberField.RingOfIntegers K ⧸ q)ˣ) :
        NumberField.RingOfIntegers K ⧸ q)
      have hxy1 : Ideal.Quotient.mk q (x * y) = Ideal.Quotient.mk q 1 := by
        rw [map_mul, ← hu, hy, Units.mul_inv, map_one]
      have h_mem_q : 1 - x * y ∈ q := by
        have hsub : x * y - 1 ∈ q := Ideal.Quotient.eq.mp hxy1
        simpa using q.neg_mem hsub
      rw [Ideal.eq_top_iff_one, Submodule.mem_sup]
      refine ⟨x * y, Ideal.mem_span_singleton.mpr ⟨y, rfl⟩, 1 - x * y, h_mem_q, by ring⟩
    · intro htop
      rw [Ideal.eq_top_iff_one, Submodule.mem_sup] at htop
      obtain ⟨a, ha, b, hb, hab⟩ := htop
      obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton.mp ha
      have hxy1 : Ideal.Quotient.mk q x * Ideal.Quotient.mk q y = 1 := by
        rw [← map_mul, ← map_one (Ideal.Quotient.mk q), Ideal.Quotient.eq]
        have hsub : x * y - 1 = -b := by linear_combination hab
        rw [hsub]
        exact q.neg_mem hb
      exact IsUnit.of_mul_eq_one _ hxy1
  refine ⟨χ₀, ⟨fun x hx_ne hx => ?_, fun x hx_ne hnx => ?_⟩⟩
  · have hs : ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ ∈ S :=
      ⟨x, hx_ne, hx, rfl⟩
    dsimp [χ₀]
    rw [if_pos ((h_unit_iff x).mp hx), hϕ ⟨_, hs⟩]
    have hval : ϕ₀ ⟨⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩, hs⟩ = ψu hx.unit :=
      hf_eq ⟨_, hs⟩ x hx rfl
    rw [hval]
    rfl
  · dsimp [χ₀]
    rw [if_neg (mt (h_unit_iff x).mpr hnx)]

theorem mitsui_ideal_monoidHom_ray_properties_of_extending_char {K : Type u} [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ) (hψ : ψ ≠ 0)
    (χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ_unit : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0)
      (hx : IsUnit (Ideal.Quotient.mk q x)),
      χ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
        ψ (Additive.ofMul hx.unit))
    (hχ_not_unit : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      ¬ IsUnit (Ideal.Quotient.mk q x) →
      χ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 0) :
    (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ q →
      χ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1) ∧
    (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ I = 0)) ∧
    (∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ ∧ χ I₀ ≠ 1) :=
by
  have h_unit_iff_sup : ∀ x : NumberField.RingOfIntegers K,
      IsUnit (Ideal.Quotient.mk q x) ↔
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ q = ⊤ := by
    intro x
    constructor
    · intro hx
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (↑(hx.unit⁻¹) : NumberField.RingOfIntegers K ⧸ q)
      have h_mk_zero : Ideal.Quotient.mk q (1 - x * y) = 0 := by
        rw [map_sub, map_one, map_mul, ← hx.unit_spec, hy, Units.mul_inv, sub_self]
      have h_mem_q : 1 - x * y ∈ q := Ideal.Quotient.eq_zero_iff_mem.mp h_mk_zero
      have h_mem_span : x * y ∈ Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) :=
        Ideal.mem_span_singleton.mpr ⟨y, rfl⟩
      rw [Ideal.eq_top_iff_one, Submodule.mem_sup]
      exact ⟨x * y, h_mem_span, 1 - x * y, h_mem_q, add_sub_cancel (x * y) 1⟩
    · intro h_top
      have h_one : (1 : NumberField.RingOfIntegers K) ∈
          Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ q :=
        (Ideal.eq_top_iff_one _).mp h_top
      obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp h_one
      obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton.mp ha
      have h_mk : Ideal.Quotient.mk q x * Ideal.Quotient.mk q y = 1 := by
        have h1 := congrArg (Ideal.Quotient.mk q) hab
        rw [map_add, map_mul, map_one, Ideal.Quotient.eq_zero_iff_mem.mpr hb, add_zero] at h1
        exact h1
      exact IsUnit.of_mul_eq_one (Ideal.Quotient.mk q y) h_mk
  refine ⟨?_, ?_, ?_⟩
  · intro x hx_ne hx_sub
    have h_mk : Ideal.Quotient.mk q x = 1 := by
      have h1 := (Ideal.Quotient.mk_eq_mk_iff_sub_mem x 1).mpr hx_sub
      rwa [map_one] at h1
    have hx : IsUnit (Ideal.Quotient.mk q x) := h_mk.symm ▸ isUnit_one
    have h_unit_one : hx.unit = 1 := Units.ext (hx.unit_spec.trans h_mk)
    rw [hχ_unit x hx_ne hx, h_unit_one, ofMul_one, AddChar.map_zero_eq_one]
  · intro I
    let h_K : ℕ := Fintype.card (ClassGroup (NumberField.RingOfIntegers K))
    have hh_K_pos : 0 < h_K := NumberField.classNumber_pos K
    have hh_K_ne : h_K ≠ 0 := ne_of_gt hh_K_pos
    have h_mk0_pow : ClassGroup.mk0 (I ^ h_K) = 1 := by
      rw [map_pow, pow_card_eq_one]
    have h_prin : Submodule.IsPrincipal
        ((I ^ h_K : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
          Ideal (NumberField.RingOfIntegers K)) :=
      (ClassGroup.mk0_eq_one_iff (I ^ h_K).2).mp h_mk0_pow
    obtain ⟨x, hx_span⟩ := h_prin.principal
    have hx_span' : ((I ^ h_K : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
        Ideal (NumberField.RingOfIntegers K)) =
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) := hx_span
    have hx_ne : x ≠ 0 := by
      intro hx0
      have h_ne_zero : ((I ^ h_K : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
          Ideal (NumberField.RingOfIntegers K)) ≠ 0 :=
        nonZeroDivisors.coe_ne_zero (I ^ h_K)
      apply h_ne_zero
      rw [hx_span', Submodule.zero_eq_bot, Ideal.span_singleton_eq_bot]
      exact hx0
    have hI_pow_eq : I ^ h_K =
        ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ :=
      Subtype.ext hx_span'
    have hχ_pow : (χ I) ^ h_K =
        χ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ := by
      rw [← map_pow, hI_pow_eq]
    have h_span_eq_pow : Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) =
        (I : Ideal (NumberField.RingOfIntegers K)) ^ h_K := by
      rw [← hx_span', SubmonoidClass.coe_pow]
    have h_unit_iff_I : IsUnit (Ideal.Quotient.mk q x) ↔
        (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ := by
      rw [h_unit_iff_sup x, h_span_eq_pow, ← Ideal.isCoprime_iff_sup_eq,
        IsCoprime.pow_left_iff hh_K_pos, Ideal.isCoprime_iff_sup_eq]
    constructor
    · intro h_sup
      have hx : IsUnit (Ideal.Quotient.mk q x) := h_unit_iff_I.mpr h_sup
      have hχ_pow_eq : (χ I) ^ h_K = ψ (Additive.ofMul hx.unit) :=
        hχ_pow.trans (hχ_unit x hx_ne hx)
      have hq_bot : q ≠ ⊥ := hq
      haveI : Finite (NumberField.RingOfIntegers K ⧸ q) :=
        Ideal.finiteQuotientOfFreeOfNeBot q hq_bot
      have h_norm_pow : ‖χ I‖ ^ h_K = 1 := by
        rw [← norm_pow, hχ_pow_eq, AddChar.norm_apply]
      exact (pow_eq_one_iff_of_nonneg (norm_nonneg (χ I)) hh_K_ne).mp h_norm_pow
    · intro h_not_sup
      have hx_not : ¬ IsUnit (Ideal.Quotient.mk q x) :=
        fun hx => h_not_sup (h_unit_iff_I.mp hx)
      have hχ_pow_zero : (χ I) ^ h_K = 0 :=
        hχ_pow.trans (hχ_not_unit x hx_ne hx_not)
      exact eq_zero_of_pow_eq_zero hχ_pow_zero
  · obtain ⟨a, ha⟩ := DFunLike.ne_iff.mp hψ
    rw [AddChar.zero_apply] at ha
    let u₀ : (NumberField.RingOfIntegers K ⧸ q)ˣ := Additive.toMul a
    have hu₀ : ψ (Additive.ofMul u₀) ≠ 1 := ha
    obtain ⟨x₀, hx₀_mk⟩ := Ideal.Quotient.mk_surjective (u₀ : NumberField.RingOfIntegers K ⧸ q)
    have hx₀_unit : IsUnit (Ideal.Quotient.mk q x₀) := hx₀_mk.symm ▸ u₀.isUnit
    have hx₀_unit_eq : hx₀_unit.unit = u₀ := Units.ext (hx₀_unit.unit_spec.trans hx₀_mk)
    have hx₀_ne : x₀ ≠ 0 := by
      intro hx₀_zero
      have h_zero_unit : IsUnit (0 : NumberField.RingOfIntegers K ⧸ q) := by
        rw [← map_zero (Ideal.Quotient.mk q), ← hx₀_zero]
        exact hx₀_unit
      have h_zero_eq_one : (0 : NumberField.RingOfIntegers K ⧸ q) = 1 :=
        isUnit_zero_iff.mp h_zero_unit
      haveI : Subsingleton (NumberField.RingOfIntegers K ⧸ q) :=
        subsingleton_of_zero_eq_one h_zero_eq_one
      have hu₀_eq_one : u₀ = 1 := Subsingleton.elim u₀ 1
      apply hu₀
      rw [hu₀_eq_one, ofMul_one, AddChar.map_zero_eq_one]
    refine ⟨⟨Ideal.span ({x₀} : Set (NumberField.RingOfIntegers K)),
      mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx₀_ne)⟩, ?_, ?_⟩
    · exact (h_unit_iff_sup x₀).mp hx₀_unit
    · rw [hχ_unit x₀ hx₀_ne hx₀_unit, hx₀_unit_eq]
      exact hu₀

theorem mitsui_freeUnit_cell_card_eq_of_unitLogCoord {K : Type u} [Field K] [NumberField K]
    (X : ℝ)
    (m : ℕ)
    (w₀ : NumberField.InfinitePlace K)
    (k : NumberField.InfinitePlace K → Fin m)
    (I : Ideal (NumberField.RingOfIntegers K)) (hI : I.IsPrincipal)
    (v : Fin (NumberField.Units.rank K) → ℝ)
    (d : Fin (NumberField.Units.rank K) → ℤ)
    (hd : ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
      Real.log (w ((@Submodule.IsPrincipal.generator _ _ _ _ _ I hI : NumberField.RingOfIntegers K) : K) /
          w₀ ((@Submodule.IsPrincipal.generator _ _ _ _ _ I hI : NumberField.RingOfIntegers K) : K)) =
        ∑ j : Fin (NumberField.Units.rank K),
          (v j + (d j : ℝ)) *
            Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
              w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) :
    Nat.card {e : Fin (NumberField.Units.rank K) → ℤ //
        ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
          Real.log (w ((@Submodule.IsPrincipal.generator _ _ _ _ _ I hI : NumberField.RingOfIntegers K) : K) /
              w₀ ((@Submodule.IsPrincipal.generator _ _ _ _ _ I hI : NumberField.RingOfIntegers K) : K)) +
            ∑ j : Fin (NumberField.Units.rank K),
              (e j : ℝ) *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ∈
            Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
              (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))}
      = Nat.card {e : Fin (NumberField.Units.rank K) → ℤ //
          ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
            ∑ j : Fin (NumberField.Units.rank K),
              (v j + (e j : ℝ)) *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ∈
              Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} :=
by
  refine Nat.card_congr (Equiv.subtypeEquiv (Equiv.addRight d) (fun e => ?_))
  refine forall_congr' (fun w => imp_congr_right (fun hw => ?_))
  have h_eq :
      Real.log (w ((@Submodule.IsPrincipal.generator _ _ _ _ _ I hI : NumberField.RingOfIntegers K) : K) /
          w₀ ((@Submodule.IsPrincipal.generator _ _ _ _ _ I hI : NumberField.RingOfIntegers K) : K)) +
        ∑ j : Fin (NumberField.Units.rank K),
          (e j : ℝ) *
            Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
              w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) =
      ∑ j : Fin (NumberField.Units.rank K),
        (v j + (((Equiv.addRight d e) j : ℤ) : ℝ)) *
          Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
            w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) := by
    rw [hd w hw, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    simp only [Equiv.coe_addRight, Pi.add_apply, Int.cast_add]
    ring
  rw [h_eq]

theorem mitsui_riesz_principalPrimePower_weighted_le_of_ideal_monoidHom_bound {K : Type u} [Field K] [NumberField K]
    (Y : ℝ)
    (q : Ideal (NumberField.RingOfIntegers K))
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ)
    (M : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℕ → ℂ)
    (B : ℝ) (hB : 0 ≤ B)
    (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ₀_unit : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0)
      (hx : IsUnit (Ideal.Quotient.mk q x)),
      χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
        ψ (Additive.ofMul hx.unit))
    (hχ₀_not_unit : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      ¬ IsUnit (Ideal.Quotient.mk q x) →
      χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 0)
    (h_bound : ∀ χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ,
      (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0)
        (hx : IsUnit (Ideal.Quotient.mk q x)),
        χ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
          ψ (Additive.ofMul hx.unit)) →
      (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        ¬ IsUnit (Ideal.Quotient.mk q x) →
        χ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 0) →
      ‖∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
          M pm.1.1 pm.1.2 *
            ((χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
              ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ))‖ ≤ B) :
    ‖∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          1 ≤ pm.2 ∧
          ∃ h : (pm.1.asIdeal ^ pm.2).IsPrincipal,
          (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y ∧
          IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ (pm.1.asIdeal ^ pm.2) h))},
        M pm.1.1 pm.1.2 *
          (ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
            ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
              Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ))‖ ≤ B :=
by
  classical
  have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p.asIdeal := by
    intro p
    have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    omega
  have h_pm_bounds : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
      1 ≤ m → (Ideal.absNorm p.asIdeal : ℝ) ^ m ≤ Y →
      Ideal.absNorm p.asIdeal ≤ ⌊Y⌋₊ ∧ m ≤ ⌊Y⌋₊ := by
    intro p m hm h_pow
    have hk2 : 2 ≤ Ideal.absNorm p.asIdeal := h_norm_ge_two p
    have h_pow_nat : ((Ideal.absNorm p.asIdeal ^ m : ℕ) : ℝ) ≤ Y := by exact_mod_cast h_pow
    have h_km_le : Ideal.absNorm p.asIdeal ^ m ≤ ⌊Y⌋₊ := Nat.le_floor h_pow_nat
    have hm_ne : m ≠ 0 := by omega
    have hk_le_km : Ideal.absNorm p.asIdeal ≤ Ideal.absNorm p.asIdeal ^ m :=
      Nat.le_self_pow hm_ne (Ideal.absNorm p.asIdeal)
    have hm_le_2m : m ≤ 2 ^ m := (Nat.lt_pow_self (by decide : 1 < 2)).le
    have h2m_le_km : 2 ^ m ≤ Ideal.absNorm p.asIdeal ^ m := Nat.pow_le_pow_left hk2 m
    exact ⟨le_trans hk_le_km h_km_le, le_trans (le_trans hm_le_2m h2m_le_km) h_km_le⟩
  let D_all := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y}
  let D_prin := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧
    ∃ h : (pm.1.asIdeal ^ pm.2).IsPrincipal,
    (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y ∧
    IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ (pm.1.asIdeal ^ pm.2) h))}
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊}
  let S_prod : Set (Ideal (NumberField.RingOfIntegers K) × ℕ) :=
    S_id ×ˢ {m : ℕ | m ≤ ⌊Y⌋₊}
  have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Y⌋₊
  have hSprod_fin : S_prod.Finite := hSid_fin.prod (Set.finite_le_nat ⌊Y⌋₊)
  haveI : Finite S_id := hSid_fin
  haveI : Finite S_prod := hSprod_fin
  let f_all : D_all → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2), h_pm_bounds pm.1.1 pm.1.2 pm.2.1 pm.2.2⟩
  have hf_all_inj : Function.Injective f_all := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    have h1 := congrArg Prod.fst hval
    have h2 := congrArg Prod.snd hval
    apply Subtype.ext
    apply Prod.ext
    · exact IsDedekindDomain.HeightOneSpectrum.ext h1
    · exact h2
  haveI : Finite D_all := Finite.of_injective f_all hf_all_inj
  letI : Fintype D_all := Fintype.ofFinite D_all
  let f_prin : D_prin → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2), h_pm_bounds pm.1.1 pm.1.2 pm.2.1 pm.2.2.choose_spec.1⟩
  have hf_prin_inj : Function.Injective f_prin := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    have h1 := congrArg Prod.fst hval
    have h2 := congrArg Prod.snd hval
    apply Subtype.ext
    apply Prod.ext
    · exact IsDedekindDomain.HeightOneSpectrum.ext h1
    · exact h2
  haveI : Finite D_prin := Finite.of_injective f_prin hf_prin_inj
  letI : Fintype D_prin := Fintype.ofFinite D_prin
  letI : Fintype (ClassGroup (NumberField.RingOfIntegers K)) :=
    NumberField.RingOfIntegers.instFintypeClassGroup K
  let G := Additive (ClassGroup (NumberField.RingOfIntegers K))
  letI : Fintype G := inferInstanceAs (Fintype (ClassGroup (NumberField.RingOfIntegers K)))
  let χ_twist (η : AddChar G ℂ) : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ :=
    { toFun := fun I => χ₀ I * η (Additive.ofMul (ClassGroup.mk0 I))
      map_one' := by
        rw [map_one, map_one, ofMul_one, AddChar.map_zero_eq_one, mul_one]
      map_mul' := fun I J => by
        rw [map_mul, map_mul, ofMul_mul, AddChar.map_add_eq_mul]
        ring }
  have hχ_twist_span (η : AddChar G ℂ) (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0) :
      χ_twist η ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
      χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ := by
    change χ₀ _ * η (Additive.ofMul (ClassGroup.mk0 _)) = χ₀ _
    have h_prin : (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))).IsPrincipal := ⟨⟨x, rfl⟩⟩
    have h_mk0 : ClassGroup.mk0 ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1 :=
      (ClassGroup.mk0_eq_one_iff _).mpr h_prin
    rw [h_mk0, ofMul_one, AddChar.map_zero_eq_one, mul_one]
  let p_nz (pm : D_all) : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
    ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩
  let I_pm (pm : D_all) : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
    (p_nz pm) ^ pm.1.2
  let w (pm : D_all) : ℂ :=
    M pm.1.1 pm.1.2 *
      ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
        Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)
  have h_eta_bound (η : AddChar G ℂ) :
      ‖∑' pm : D_all, (χ_twist η (p_nz pm)) ^ pm.1.2 * w pm‖ ≤ B := by
    have h_eq : (∑' pm : D_all, (χ_twist η (p_nz pm)) ^ pm.1.2 * w pm) =
        ∑' pm : D_all,
          M pm.1.1 pm.1.2 *
            ((χ_twist η ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
              ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)) := by
      refine tsum_congr (fun pm => ?_)
      dsimp [w, p_nz]
      exact mul_left_comm _ _ _
    rw [h_eq]
    apply h_bound (χ_twist η)
    · intro x hx_ne hx
      rw [hχ_twist_span η x hx_ne]
      exact hχ₀_unit x hx_ne hx
    · intro x hx_ne hx
      rw [hχ_twist_span η x hx_ne]
      exact hχ₀_not_unit x hx_ne hx
  let P_prin (pm : D_all) : Prop :=
    ∃ h : (pm.1.1.asIdeal ^ pm.1.2).IsPrincipal,
      IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ (pm.1.1.asIdeal ^ pm.1.2) h))
  have h_I_pm_coe (pm : D_all) :
      (I_pm pm : Ideal (NumberField.RingOfIntegers K)) = pm.1.1.asIdeal ^ pm.1.2 :=
    SubmonoidClass.coe_pow (p_nz pm) pm.1.2
  have h_sum_eta_orth (pm : D_all) :
      (∑ η : AddChar G ℂ, (χ_twist η (p_nz pm)) ^ pm.1.2 * w pm) =
        if (pm.1.1.asIdeal ^ pm.1.2).IsPrincipal then
          (Fintype.card G : ℂ) * (χ₀ (I_pm pm) * w pm)
        else 0 := by
    have h_term (η : AddChar G ℂ) :
        (χ_twist η (p_nz pm)) ^ pm.1.2 * w pm =
          (χ₀ (I_pm pm) * w pm) * η (Additive.ofMul (ClassGroup.mk0 (I_pm pm))) := by
      have h1 : (χ_twist η (p_nz pm)) ^ pm.1.2 = χ_twist η (I_pm pm) :=
        (map_pow (χ_twist η) (p_nz pm) pm.1.2).symm
      rw [h1]
      change (χ₀ (I_pm pm) * η (Additive.ofMul (ClassGroup.mk0 (I_pm pm)))) * w pm = _
      ring
    simp_rw [h_term, ← Finset.mul_sum, AddChar.sum_apply_eq_ite]
    have h_iff : Additive.ofMul (ClassGroup.mk0 (I_pm pm)) = 0 ↔
        (pm.1.1.asIdeal ^ pm.1.2).IsPrincipal := by
      rw [ofMul_eq_zero]
      have h2 : ClassGroup.mk0 (I_pm pm) = 1 ↔
          Submodule.IsPrincipal (I_pm pm : Ideal (NumberField.RingOfIntegers K)) :=
        ClassGroup.mk0_eq_one_iff (I_pm pm).2
      rwa [h_I_pm_coe pm] at h2
    by_cases h_prin : (pm.1.1.asIdeal ^ pm.1.2).IsPrincipal
    · have h0 : Additive.ofMul (ClassGroup.mk0 (I_pm pm)) = 0 := h_iff.mpr h_prin
      rw [if_pos h0, if_pos h_prin]
      ring
    · have h0 : Additive.ofMul (ClassGroup.mk0 (I_pm pm)) ≠ 0 := fun hc => h_prin (h_iff.mp hc)
      rw [if_neg h0, if_neg h_prin, mul_zero]
  have h_inner_sum (pm : D_all) :
      (∑ η : AddChar G ℂ, (χ_twist η (p_nz pm)) ^ pm.1.2 * w pm) =
        if hp : P_prin pm then
          (Fintype.card G : ℂ) * (ψ (Additive.ofMul hp.choose_spec.unit) * w pm)
        else 0 := by
    rw [h_sum_eta_orth pm]
    by_cases h_prin : (pm.1.1.asIdeal ^ pm.1.2).IsPrincipal
    · rw [if_pos h_prin]
      let g : NumberField.RingOfIntegers K :=
        @Submodule.IsPrincipal.generator _ _ _ _ _ (pm.1.1.asIdeal ^ pm.1.2) h_prin
      have h_span : Ideal.span ({g} : Set (NumberField.RingOfIntegers K)) =
          pm.1.1.asIdeal ^ pm.1.2 :=
        @Submodule.IsPrincipal.span_singleton_generator _ _ _ _ _ (pm.1.1.asIdeal ^ pm.1.2) h_prin
      have h_I_ne_zero : (I_pm pm : Ideal (NumberField.RingOfIntegers K)) ≠ 0 :=
        nonZeroDivisors.ne_zero (I_pm pm).2
      have h_span_ne_bot : Ideal.span ({g} : Set (NumberField.RingOfIntegers K)) ≠ ⊥ := by
        rw [h_span, ← h_I_pm_coe pm]
        exact h_I_ne_zero
      have hg_ne : g ≠ 0 := Ideal.span_singleton_eq_bot.not.mp h_span_ne_bot
      have h_I_eq : I_pm pm = ⟨Ideal.span ({g} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hg_ne)⟩ := by
        apply Subtype.ext
        exact (h_I_pm_coe pm).trans h_span.symm
      by_cases hg_unit : IsUnit (Ideal.Quotient.mk q g)
      · have hp : P_prin pm := ⟨h_prin, hg_unit⟩
        rw [dif_pos hp, h_I_eq, hχ₀_unit g hg_ne hg_unit]
      · have hnp : ¬ P_prin pm := by
          rintro ⟨h_prin', hg_unit'⟩
          exact hg_unit hg_unit'
        rw [dif_neg hnp, h_I_eq, hχ₀_not_unit g hg_ne hg_unit, zero_mul, mul_zero]
    · have hnp : ¬ P_prin pm := fun ⟨h_prin', _⟩ => h_prin h_prin'
      rw [if_neg h_prin, dif_neg hnp]
  let term_prin (pm : D_prin) : ℂ :=
    M pm.1.1 pm.1.2 *
      (ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
        ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
          Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ))
  let term_all_prin (pm : D_all) : ℂ :=
    if hp : P_prin pm then
      ψ (Additive.ofMul hp.choose_spec.unit) * w pm
    else 0
  let e_prin : D_prin ≃ {pm : D_all // P_prin pm} :=
    { toFun := fun pm =>
        ⟨⟨pm.1, ⟨pm.2.1, pm.2.2.choose_spec.1⟩⟩,
          ⟨pm.2.2.choose, pm.2.2.choose_spec.2⟩⟩
      invFun := fun pm =>
        ⟨pm.1.1, ⟨pm.1.2.1, ⟨pm.2.choose, pm.1.2.2, pm.2.choose_spec⟩⟩⟩
      left_inv := fun pm => by apply Subtype.ext; rfl
      right_inv := fun pm => by apply Subtype.ext; apply Subtype.ext; rfl }
  have h_term_e_prin (pm : D_prin) :
      term_prin pm = term_all_prin (e_prin pm).1 := by
    dsimp [term_prin, term_all_prin, w]
    rw [dif_pos (e_prin pm).2]
    exact mul_left_comm _ _ _
  have h_sum_prin :
      (∑' pm : D_prin, term_prin pm) = ∑ pm : D_all, term_all_prin pm := by
    have h1 : (∑' pm : D_prin, term_prin pm) = ∑' pm : D_prin, term_all_prin (e_prin pm).1 :=
      tsum_congr h_term_e_prin
    have h2 : (∑' pm : D_prin, term_all_prin (e_prin pm).1) =
        ∑' pm : {pm : D_all // P_prin pm}, term_all_prin pm.1 :=
      Equiv.tsum_eq e_prin (fun pm : {pm : D_all // P_prin pm} => term_all_prin pm.1)
    rw [h1, h2, tsum_fintype]
    have h3 : (∑ pm : {pm : D_all // P_prin pm}, term_all_prin pm.1) =
        ∑ pm ∈ Finset.univ.filter (fun pm : D_all => P_prin pm), term_all_prin pm :=
      (Finset.sum_subtype (Finset.univ.filter (fun pm : D_all => P_prin pm))
        (fun _ => by simp) term_all_prin).symm
    have h4 : (∑ pm : D_all, term_all_prin pm) =
        (∑ pm ∈ Finset.univ.filter (fun pm : D_all => P_prin pm), term_all_prin pm) +
        (∑ pm ∈ Finset.univ.filter (fun pm : D_all => ¬ P_prin pm), term_all_prin pm) :=
      (Finset.sum_filter_add_sum_filter_not Finset.univ
        (fun pm : D_all => P_prin pm) term_all_prin).symm
    have h5 : (∑ pm ∈ Finset.univ.filter (fun pm : D_all => ¬ P_prin pm), term_all_prin pm) = 0 := by
      apply Finset.sum_eq_zero
      intro pm hpm
      have hnp : ¬ P_prin pm := (Finset.mem_filter.mp hpm).2
      dsimp [term_all_prin]
      rw [dif_neg hnp]
    rw [h3, h4, h5, add_zero]
  have h_double_sum :
      (Fintype.card G : ℂ) * (∑' pm : D_prin, term_prin pm) =
        ∑ η : AddChar G ℂ, ∑' pm : D_all, (χ_twist η (p_nz pm)) ^ pm.1.2 * w pm := by
    rw [h_sum_prin, Finset.mul_sum]
    have h_each (pm : D_all) :
        (Fintype.card G : ℂ) * term_all_prin pm =
          ∑ η : AddChar G ℂ, (χ_twist η (p_nz pm)) ^ pm.1.2 * w pm := by
      rw [h_inner_sum pm]
      dsimp [term_all_prin]
      split_ifs <;> ring
    simp_rw [h_each]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro η _
    exact (tsum_fintype _).symm
  have h_norm_double :
      (Fintype.card G : ℝ) * ‖∑' pm : D_prin, term_prin pm‖ ≤
        (Fintype.card G : ℝ) * B := by
    have h_lhs : (Fintype.card G : ℝ) * ‖∑' pm : D_prin, term_prin pm‖ =
        ‖(Fintype.card G : ℂ) * (∑' pm : D_prin, term_prin pm)‖ := by
      rw [norm_mul, Complex.norm_natCast]
    rw [h_lhs, h_double_sum]
    calc ‖∑ η : AddChar G ℂ, ∑' pm : D_all, (χ_twist η (p_nz pm)) ^ pm.1.2 * w pm‖
      _ ≤ ∑ η : AddChar G ℂ, ‖∑' pm : D_all, (χ_twist η (p_nz pm)) ^ pm.1.2 * w pm‖ :=
          norm_sum_le _ _
      _ ≤ (Finset.univ : Finset (AddChar G ℂ)).card • B :=
          Finset.sum_le_card_nsmul _ _ B (fun η _ => h_eta_bound η)
      _ = (Fintype.card G : ℝ) * B := by
          rw [Finset.card_univ, AddChar.card_eq, nsmul_eq_mul]
  have h_card_pos : (0 : ℝ) < (Fintype.card G : ℝ) := by
    exact_mod_cast Fintype.card_pos (α := G)
  exact le_of_mul_le_mul_left h_norm_double h_card_pos

theorem mitsui_hat_grid_cell_pointwise_sandwich {α : Type u} [Fintype α] (w₀ : α)
    (r N : ℕ) (h C_L : ℝ) (hh_nonneg : 0 ≤ h)
    (L : α → Fin r → ℝ) (hC_L : ∀ w : α, w ≠ w₀ → ∑ j : Fin r, |L w j| ≤ C_L)
    (a b : α → ℝ)
    (S_main S_outer S_collar : Finset (Fin r → ℤ))
    (hS_main : ∀ p : Fin r → ℤ, p ∈ S_main ↔
      p ∈ Fintype.piFinset (fun _ : Fin r => Finset.Icc (-(N : ℤ)) (N : ℤ)) ∧
      ∀ w : α, w ≠ w₀ →
        ∑ j : Fin r, (p j : ℝ) * h * L w j ∈ Set.Ioc (a w + C_L * h) (b w - C_L * h))
    (hS_outer : ∀ p : Fin r → ℤ, p ∈ S_outer ↔
      p ∈ Fintype.piFinset (fun _ : Fin r => Finset.Icc (-(N : ℤ)) (N : ℤ)) ∧
      ∀ w : α, w ≠ w₀ →
        ∑ j : Fin r, (p j : ℝ) * h * L w j ∈ Set.Ioc (a w - C_L * h) (b w + C_L * h))
    (hS_collar_sum : ∀ f : (Fin r → ℤ) → ℝ,
      (∑ p ∈ S_main, f p) + (∑ p ∈ S_collar, f p) = ∑ p ∈ S_outer, f p)
    (h_pou : ∀ y : Fin r → ℝ,
      (∑ p ∈ Fintype.piFinset (fun _ : Fin r => Finset.Icc (-(N : ℤ)) (N : ℤ)),
        ∏ j : Fin r, max (0 : ℝ) (1 - |y j - (p j : ℝ) * h| / h)) ≤ 1 ∧
      ((∀ j : Fin r, |y j| ≤ ((N : ℝ) - 1) * h) →
        ∑ p ∈ Fintype.piFinset (fun _ : Fin r => Finset.Icc (-(N : ℤ)) (N : ℤ)),
          ∏ j : Fin r, max (0 : ℝ) (1 - |y j - (p j : ℝ) * h| / h) = 1))
    (v : Fin r → ℝ)
    (h_shift : ∀ p : Fin r → ℤ,
      (∏ j : Fin r,
        max (0 : ℝ)
          (1 - |v j + ((-Int.floor (v j - (p j : ℝ) * h + 1 / 2) : ℤ) : ℝ) - (p j : ℝ) * h| / h) =
        ∏ j : Fin r,
          max (0 : ℝ)
            (1 - |v j - (p j : ℝ) * h - (Int.floor (v j - (p j : ℝ) * h + 1 / 2) : ℝ)| / h)) ∧
      (∀ e : Fin r → ℤ,
        e ≠ (fun j => -Int.floor (v j - (p j : ℝ) * h + 1 / 2)) →
        ∏ j : Fin r, max (0 : ℝ) (1 - |v j + (e j : ℝ) - (p j : ℝ) * h| / h) = 0) ∧
      (∀ e : Fin r → ℤ,
        0 < ∏ j : Fin r, max (0 : ℝ) (1 - |v j + (e j : ℝ) - (p j : ℝ) * h| / h) →
        ∀ j : Fin r, |v j + (e j : ℝ) - (p j : ℝ) * h| ≤ h))
    (h_cell_bdd : ∀ e : Fin r → ℤ,
      (∀ w : α, w ≠ w₀ → ∑ j : Fin r, (v j + (e j : ℝ)) * L w j ∈ Set.Ioc (a w) (b w)) →
      ∀ j : Fin r, |v j + (e j : ℝ)| ≤ ((N : ℝ) - 1) * h) :
    ∑ p ∈ S_main,
      ∏ j : Fin r,
        max (0 : ℝ)
          (1 - |v j - (p j : ℝ) * h - (Int.floor (v j - (p j : ℝ) * h + 1 / 2) : ℝ)| / h) ≤
      (Nat.card {e : Fin r → ℤ //
        ∀ w : α, w ≠ w₀ → ∑ j : Fin r, (v j + (e j : ℝ)) * L w j ∈ Set.Ioc (a w) (b w)} : ℝ) ∧
    (Nat.card {e : Fin r → ℤ //
      ∀ w : α, w ≠ w₀ → ∑ j : Fin r, (v j + (e j : ℝ)) * L w j ∈ Set.Ioc (a w) (b w)} : ℝ) ≤
      (∑ p ∈ S_main,
        ∏ j : Fin r,
          max (0 : ℝ)
            (1 - |v j - (p j : ℝ) * h - (Int.floor (v j - (p j : ℝ) * h + 1 / 2) : ℝ)| / h)) +
      (∑ p ∈ S_collar,
        ∏ j : Fin r,
          max (0 : ℝ)
            (1 - |v j - (p j : ℝ) * h - (Int.floor (v j - (p j : ℝ) * h + 1 / 2) : ℝ)| / h)) :=
by
  classical
  let R : ℝ := ((N : ℝ) - 1) * h
  let B_N : Finset (Fin r → ℤ) :=
    Fintype.piFinset (fun _ : Fin r => Finset.Icc (-(N : ℤ)) (N : ℤ))
  let P_cell : (Fin r → ℤ) → Prop :=
    fun e => ∀ w : α, w ≠ w₀ → ∑ j : Fin r, (v j + (e j : ℝ)) * L w j ∈ Set.Ioc (a w) (b w)
  let E_box : Finset (Fin r → ℤ) :=
    Fintype.piFinset (fun j : Fin r => Finset.Icc (Int.floor (-v j - R)) (Int.floor (-v j + R)))
  let E_fin : Finset (Fin r → ℤ) := E_box.filter P_cell
  have hE_iff : ∀ e : Fin r → ℤ, e ∈ E_fin ↔ P_cell e := by
    intro e
    constructor
    · intro he
      exact (Finset.mem_filter.mp he).2
    · intro he
      refine Finset.mem_filter.mpr ⟨Fintype.mem_piFinset.mpr (fun j => ?_), he⟩
      have h_abs : |v j + (e j : ℝ)| ≤ R := h_cell_bdd e he j
      have h_bounds := abs_le.mp h_abs
      have h_lo : -v j - R ≤ (e j : ℝ) := by linarith [h_bounds.1]
      have h_hi : (e j : ℝ) ≤ -v j + R := by linarith [h_bounds.2]
      have h_lo_int : Int.floor (-v j - R) ≤ e j :=
        Int.cast_le.mp (le_trans (Int.floor_le (-v j - R)) h_lo)
      have h_hi_int : e j ≤ Int.floor (-v j + R) :=
        Int.le_floor.mpr h_hi
      exact Finset.mem_Icc.mpr ⟨h_lo_int, h_hi_int⟩
  have h_card_nat : Nat.card {e : Fin r → ℤ // P_cell e} = E_fin.card :=
    (@Nat.card_eq_fintype_card {e : Fin r → ℤ // P_cell e} (Fintype.ofFinset E_fin hE_iff)).trans
      (@Fintype.card_ofFinset (Fin r → ℤ) P_cell E_fin hE_iff)
  have h_card_real : (Nat.card {e : Fin r → ℤ // P_cell e} : ℝ) = (E_fin.card : ℝ) := by
    exact_mod_cast h_card_nat
  have h_lip : ∀ (y y' : Fin r → ℝ), (∀ j : Fin r, |y j - y' j| ≤ h) →
      ∀ w : α, w ≠ w₀ →
        |(∑ j : Fin r, y j * L w j) - (∑ j : Fin r, y' j * L w j)| ≤ C_L * h := by
    intro y y' hy w hw
    have h_diff : (∑ j : Fin r, y j * L w j) - (∑ j : Fin r, y' j * L w j) =
        ∑ j : Fin r, (y j - y' j) * L w j := by
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      ring
    rw [h_diff]
    calc |∑ j : Fin r, (y j - y' j) * L w j|
      _ ≤ ∑ j : Fin r, |(y j - y' j) * L w j| := Finset.abs_sum_le_sum_abs _ _
      _ = ∑ j : Fin r, |y j - y' j| * |L w j| :=
          Finset.sum_congr rfl (fun j _ => abs_mul _ _)
      _ ≤ ∑ j : Fin r, h * |L w j| :=
          Finset.sum_le_sum (fun j _ => mul_le_mul_of_nonneg_right (hy j) (abs_nonneg _))
      _ = h * ∑ j : Fin r, |L w j| := (Finset.mul_sum _ _ _).symm
      _ ≤ h * C_L := mul_le_mul_of_nonneg_left (hC_L w hw) hh_nonneg
      _ = C_L * h := mul_comm _ _
  let Phi : (Fin r → ℤ) → (Fin r → ℤ) → ℝ :=
    fun e p => ∏ j : Fin r, max (0 : ℝ) (1 - |v j + (e j : ℝ) - (p j : ℝ) * h| / h)
  let tildePhi : (Fin r → ℤ) → ℝ :=
    fun p => ∏ j : Fin r,
      max (0 : ℝ) (1 - |v j - (p j : ℝ) * h - (Int.floor (v j - (p j : ℝ) * h + 1 / 2) : ℝ)| / h)
  let e_star : (Fin r → ℤ) → (Fin r → ℤ) :=
    fun p j => -Int.floor (v j - (p j : ℝ) * h + 1 / 2)
  have hPhi_nonneg : ∀ e p : Fin r → ℤ, 0 ≤ Phi e p :=
    fun _ _ => Finset.prod_nonneg (fun _ _ => le_max_left 0 _)
  have htildePhi_nonneg : ∀ p : Fin r → ℤ, 0 ≤ tildePhi p :=
    fun _ => Finset.prod_nonneg (fun _ _ => le_max_left 0 _)
  have h_sum_E_le : ∀ p : Fin r → ℤ, ∑ e ∈ E_fin, Phi e p ≤ tildePhi p := by
    intro p
    have h_shift_eq : Phi (e_star p) p = tildePhi p := (h_shift p).1
    by_cases he : e_star p ∈ E_fin
    · have h_eq : ∑ e ∈ E_fin, Phi e p = Phi (e_star p) p :=
        Finset.sum_eq_single (e_star p)
          (fun e _ hne => (h_shift p).2.1 e hne)
          (fun hnot => False.elim (hnot he))
      rw [h_eq, h_shift_eq]
    · have h_zero : ∑ e ∈ E_fin, Phi e p = 0 := by
        refine Finset.sum_eq_zero (fun e he_mem => (h_shift p).2.1 e (fun h_eq => ?_))
        change e = e_star p at h_eq
        rw [h_eq] at he_mem
        exact he he_mem
      rw [h_zero]
      exact htildePhi_nonneg p
  have h_main_eq : ∀ p ∈ S_main, tildePhi p = ∑ e ∈ E_fin, Phi e p := by
    intro p hp
    have h_shift_eq : Phi (e_star p) p = tildePhi p := (h_shift p).1
    rw [← h_shift_eq]
    refine (Finset.sum_eq_single (e_star p)
      (fun e _ hne => (h_shift p).2.1 e hne)
      (fun he_not => ?_)).symm
    by_contra h_ne
    have h_pos : 0 < Phi (e_star p) p :=
      lt_of_le_of_ne (hPhi_nonneg (e_star p) p) (Ne.symm h_ne)
    have h_dist : ∀ j : Fin r, |v j + (e_star p j : ℝ) - (p j : ℝ) * h| ≤ h :=
      (h_shift p).2.2 (e_star p) h_pos
    have h_in_cell : P_cell (e_star p) := by
      intro w hw
      have hp_w := ((hS_main p).mp hp).2 w hw
      rw [Set.mem_Ioc] at hp_w ⊢
      have h_w_lip := h_lip (fun j => v j + (e_star p j : ℝ)) (fun j => (p j : ℝ) * h) h_dist w hw
      have h_w_bounds := abs_le.mp h_w_lip
      constructor
      · linarith [hp_w.1, h_w_bounds.1]
      · linarith [hp_w.2, h_w_bounds.2]
    exact he_not ((hE_iff (e_star p)).mpr h_in_cell)
  have hS_main_sub : S_main ⊆ B_N := fun p hp => ((hS_main p).mp hp).1
  have hS_outer_sub : S_outer ⊆ B_N := fun p hp => ((hS_outer p).mp hp).1
  constructor
  · change ∑ p ∈ S_main, tildePhi p ≤ (Nat.card {e : Fin r → ℤ // P_cell e} : ℝ)
    calc ∑ p ∈ S_main, tildePhi p
      _ = ∑ p ∈ S_main, ∑ e ∈ E_fin, Phi e p :=
          Finset.sum_congr rfl (fun p hp => h_main_eq p hp)
      _ = ∑ e ∈ E_fin, ∑ p ∈ S_main, Phi e p := Finset.sum_comm
      _ ≤ ∑ e ∈ E_fin, ∑ p ∈ B_N, Phi e p :=
          Finset.sum_le_sum (fun e _ =>
            Finset.sum_le_sum_of_subset_of_nonneg hS_main_sub (fun p _ _ => hPhi_nonneg e p))
      _ ≤ ∑ e ∈ E_fin, (1 : ℝ) :=
          Finset.sum_le_sum (fun e _ => (h_pou (fun j => v j + (e j : ℝ))).1)
      _ = (E_fin.card : ℝ) := by rw [Finset.sum_const, nsmul_eq_mul, mul_one]
      _ = (Nat.card {e : Fin r → ℤ // P_cell e} : ℝ) := h_card_real.symm
  · change (Nat.card {e : Fin r → ℤ // P_cell e} : ℝ) ≤
        (∑ p ∈ S_main, tildePhi p) + (∑ p ∈ S_collar, tildePhi p)
    have h_e_outer : ∀ e ∈ E_fin, ∑ p ∈ S_outer, Phi e p = 1 := by
      intro e he
      have he_cell : P_cell e := (hE_iff e).mp he
      have he_bdd : ∀ j : Fin r, |v j + (e j : ℝ)| ≤ ((N : ℝ) - 1) * h :=
        h_cell_bdd e he_cell
      have h_pou_eq : ∑ p ∈ B_N, Phi e p = 1 :=
        (h_pou (fun j => v j + (e j : ℝ))).2 he_bdd
      rw [← h_pou_eq]
      refine Finset.sum_subset hS_outer_sub (fun p hp_box hp_not => ?_)
      by_contra h_ne
      have h_pos : 0 < Phi e p :=
        lt_of_le_of_ne (hPhi_nonneg e p) (Ne.symm h_ne)
      have h_dist : ∀ j : Fin r, |v j + (e j : ℝ) - (p j : ℝ) * h| ≤ h :=
        (h_shift p).2.2 e h_pos
      have hp_outer : p ∈ S_outer := by
        refine (hS_outer p).mpr ⟨hp_box, fun w hw => ?_⟩
        have he_w := he_cell w hw
        rw [Set.mem_Ioc] at he_w ⊢
        have h_w_lip := h_lip (fun j => v j + (e j : ℝ)) (fun j => (p j : ℝ) * h) h_dist w hw
        have h_w_bounds := abs_le.mp h_w_lip
        constructor
        · linarith [he_w.1, h_w_bounds.2]
        · linarith [he_w.2, h_w_bounds.1]
      exact hp_not hp_outer
    calc (Nat.card {e : Fin r → ℤ // P_cell e} : ℝ)
      _ = (E_fin.card : ℝ) := h_card_real
      _ = ∑ e ∈ E_fin, (1 : ℝ) := by rw [Finset.sum_const, nsmul_eq_mul, mul_one]
      _ = ∑ e ∈ E_fin, ∑ p ∈ S_outer, Phi e p :=
          Finset.sum_congr rfl (fun e he => (h_e_outer e he).symm)
      _ = ∑ p ∈ S_outer, ∑ e ∈ E_fin, Phi e p := Finset.sum_comm
      _ ≤ ∑ p ∈ S_outer, tildePhi p :=
          Finset.sum_le_sum (fun p _ => h_sum_E_le p)
      _ = (∑ p ∈ S_main, tildePhi p) + (∑ p ∈ S_collar, tildePhi p) :=
          (hS_collar_sum tildePhi).symm

theorem mitsui_unitLogCoord_cell_hat_grid_sandwich {K : Type u} [Field K] [NumberField K]
    (h_rank : 0 < NumberField.Units.rank K)
    (M_K : ℝ) (hM_K_pos : 0 < M_K)
    (hM_K : ∀ (w₀ : NumberField.InfinitePlace K)
      (y : Fin (NumberField.Units.rank K) → ℝ)
      (B : ℝ),
      0 ≤ B →
      (∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
        |∑ j : Fin (NumberField.Units.rank K),
            y j *
              Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))| ≤ B) →
      ∀ i : Fin (NumberField.Units.rank K), |y i| ≤ M_K * B) :
    ∃ C_grid : ℝ, 0 < C_grid ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m →
          ∀ w₀ : NumberField.InfinitePlace K,
            ∀ k : NumberField.InfinitePlace K → Fin m,
              ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
                ∃ (S_main S_collar : Finset (Fin (NumberField.Units.rank K) → ℤ)),
                  (∀ v : Fin (NumberField.Units.rank K) → ℝ,
                    ∑ p ∈ S_main,
                      ∏ j : Fin (NumberField.Units.rank K),
                        max (0 : ℝ)
                          (1 - |v j - (p j : ℝ) * (δ / 2) -
                              (Int.floor (v j - (p j : ℝ) * (δ / 2) + 1 / 2) : ℝ)| / (δ / 2)) ≤
                      (Nat.card {e : Fin (NumberField.Units.rank K) → ℤ //
                          ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
                            ∑ j : Fin (NumberField.Units.rank K),
                              (v j + (e j : ℝ)) *
                                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ∈
                              Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                                (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℝ) ∧
                    (Nat.card {e : Fin (NumberField.Units.rank K) → ℤ //
                        ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
                          ∑ j : Fin (NumberField.Units.rank K),
                            (v j + (e j : ℝ)) *
                              Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                                w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ∈
                            Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                              (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℝ) ≤
                      (∑ p ∈ S_main,
                        ∏ j : Fin (NumberField.Units.rank K),
                          max (0 : ℝ)
                            (1 - |v j - (p j : ℝ) * (δ / 2) -
                                (Int.floor (v j - (p j : ℝ) * (δ / 2) + 1 / 2) : ℝ)| / (δ / 2))) +
                      (∑ p ∈ S_collar,
                        ∏ j : Fin (NumberField.Units.rank K),
                          max (0 : ℝ)
                            (1 - |v j - (p j : ℝ) * (δ / 2) -
                                (Int.floor (v j - (p j : ℝ) * (δ / 2) + 1 / 2) : ℝ)| / (δ / 2)))) ∧
                  (S_main.card : ℝ) * (δ / 2) ^ (NumberField.Units.rank K) ≤
                    C_grid * (Real.log X + 1) ^ (NumberField.Units.rank K) ∧
                  (S_collar.card : ℝ) * (δ / 2) ^ (NumberField.Units.rank K) ≤
                    C_grid * δ * (Real.log X + 1) ^ (NumberField.Units.rank K) :=
by
  classical
  let r : ℕ := NumberField.Units.rank K
  have hr_pos : 0 < r := h_rank
  have hr_rpos : (0 : ℝ) < (r : ℝ) := Nat.cast_pos.mpr hr_pos
  let η : Fin r → K := fun j =>
    (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) :
      NumberField.RingOfIntegers K) : K)
  let C_L : ℝ :=
    (∑ w : NumberField.InfinitePlace K,
      ∑ w' : NumberField.InfinitePlace K,
        ∑ j : Fin r, |Real.log (w (η j) / w' (η j))|) + 1
  have hC_L_pos : 0 < C_L := by
    dsimp [C_L]
    have h_sum_nonneg : 0 ≤ ∑ w : NumberField.InfinitePlace K,
        ∑ w' : NumberField.InfinitePlace K,
          ∑ j : Fin r, |Real.log (w (η j) / w' (η j))| :=
      Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => abs_nonneg _)))
    linarith
  let C_2 : ℝ := 2 * M_K + 4 * M_K * C_L + 2
  have hC_2_pos : 0 < C_2 := by dsimp [C_2]; positivity
  let K_end : ℝ := 8 * M_K * C_L + 4
  have hK_end_pos : 0 < K_end := by dsimp [K_end]; positivity
  let C_grid : ℝ := C_2 ^ r + (r : ℝ) * K_end * C_2 ^ r
  have hC_grid_pos : 0 < C_grid := by dsimp [C_grid]; positivity
  refine ⟨C_grid, hC_grid_pos, ?_⟩
  intro X hX m hm w₀ k δ hδ_pos hδ_le_one
  let h : ℝ := δ / 2
  have hh_pos : 0 < h := by dsimp [h]; linarith
  have hh_nonneg : 0 ≤ h := le_of_lt hh_pos
  have hh_le_half : h ≤ 1 / 2 := by dsimp [h]; linarith
  have hh_le_δ : h ≤ δ := by dsimp [h]; linarith
  let B : ℝ := Real.log X
  have hB_pos : 0 < B := Real.log_pos hX
  have hB_nonneg : 0 ≤ B := le_of_lt hB_pos
  have hm_rpos : (0 : ℝ) < (m : ℝ) := Nat.cast_pos.mpr hm
  have hm_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  let L : NumberField.InfinitePlace K → Fin r → ℝ :=
    fun w j => Real.log (w (η j) / w₀ (η j))
  let a : NumberField.InfinitePlace K → ℝ :=
    fun w => Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ))
  let b : NumberField.InfinitePlace K → ℝ :=
    fun w => Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))
  have hC_L : ∀ w : NumberField.InfinitePlace K, w ≠ w₀ → ∑ j : Fin r, |L w j| ≤ C_L := by
    intro w _hw
    dsimp [C_L, L]
    have h1 : ∑ j : Fin r, |Real.log (w (η j) / w₀ (η j))| ≤
        ∑ w' : NumberField.InfinitePlace K, ∑ j : Fin r, |Real.log (w (η j) / w' (η j))| :=
      Finset.single_le_sum
        (f := fun w' : NumberField.InfinitePlace K => ∑ j : Fin r, |Real.log (w (η j) / w' (η j))|)
        (fun w' _ => Finset.sum_nonneg (fun _ _ => abs_nonneg _))
        (Finset.mem_univ w₀)
    have h2 : ∑ w' : NumberField.InfinitePlace K, ∑ j : Fin r, |Real.log (w (η j) / w' (η j))| ≤
        ∑ w₁ : NumberField.InfinitePlace K,
          ∑ w' : NumberField.InfinitePlace K, ∑ j : Fin r, |Real.log (w₁ (η j) / w' (η j))| :=
      Finset.single_le_sum
        (f := fun w₁ : NumberField.InfinitePlace K =>
          ∑ w' : NumberField.InfinitePlace K, ∑ j : Fin r, |Real.log (w₁ (η j) / w' (η j))|)
        (fun w₁ _ => Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => abs_nonneg _)))
        (Finset.mem_univ w)
    linarith
  let N : ℕ := ⌈M_K * B / h⌉₊ + 1
  have hN_ge_one : 1 ≤ N := Nat.le_add_left 1 _
  have hN_bound : M_K * B ≤ ((N : ℝ) - 1) * h := by
    have h_ceil : M_K * B / h ≤ (⌈M_K * B / h⌉₊ : ℝ) := Nat.le_ceil _
    have h_N_sub : ((N : ℝ) - 1) = (⌈M_K * B / h⌉₊ : ℝ) := by
      dsimp [N]
      push_cast
      ring
    rw [h_N_sub]
    exact (div_le_iff₀ hh_pos).mp h_ceil
  let B_N : Finset (Fin r → ℤ) :=
    Fintype.piFinset (fun _ : Fin r => Finset.Icc (-(N : ℤ)) (N : ℤ))
  let S_main : Finset (Fin r → ℤ) :=
    B_N.filter (fun p =>
      ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
        ∑ j : Fin r, (p j : ℝ) * h * L w j ∈ Set.Ioc (a w + C_L * h) (b w - C_L * h))
  let S_outer : Finset (Fin r → ℤ) :=
    B_N.filter (fun p =>
      ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
        ∑ j : Fin r, (p j : ℝ) * h * L w j ∈ Set.Ioc (a w - C_L * h) (b w + C_L * h))
  let S_collar : Finset (Fin r → ℤ) := S_outer \ S_main
  have hS_main_iff : ∀ p : Fin r → ℤ, p ∈ S_main ↔
      p ∈ B_N ∧
      ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
        ∑ j : Fin r, (p j : ℝ) * h * L w j ∈ Set.Ioc (a w + C_L * h) (b w - C_L * h) :=
    fun p => Finset.mem_filter
  have hS_outer_iff : ∀ p : Fin r → ℤ, p ∈ S_outer ↔
      p ∈ B_N ∧
      ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
        ∑ j : Fin r, (p j : ℝ) * h * L w j ∈ Set.Ioc (a w - C_L * h) (b w + C_L * h) :=
    fun p => Finset.mem_filter
  have hCL_h_nonneg : 0 ≤ C_L * h := mul_nonneg (le_of_lt hC_L_pos) hh_nonneg
  have hS_sub : S_main ⊆ S_outer := by
    intro p hp
    rcases (hS_main_iff p).mp hp with ⟨hp_box, hp_in⟩
    refine (hS_outer_iff p).mpr ⟨hp_box, fun w hw => ?_⟩
    rcases hp_in w hw with ⟨h_lo, h_hi⟩
    exact ⟨by linarith, by linarith⟩
  have hS_collar_sum : ∀ f : (Fin r → ℤ) → ℝ,
      (∑ p ∈ S_main, f p) + (∑ p ∈ S_collar, f p) = ∑ p ∈ S_outer, f p := by
    intro f
    dsimp [S_collar]
    rw [add_comm, Finset.sum_sdiff hS_sub]
  have hab_bounds : ∀ w : NumberField.InfinitePlace K,
      -B ≤ a w ∧ a w ≤ b w ∧ b w ≤ 0 ∧ b w - a w ≤ B := by
    intro w
    dsimp [a, b, B]
    have hkw_nonneg : (0 : ℝ) ≤ ((k w : ℕ) : ℝ) := Nat.cast_nonneg _
    have hkw_lt : (k w : ℕ) < m := (k w).isLt
    have hkw_le : (k w : ℕ) + 1 ≤ m := hkw_lt
    have hkw_rle : ((k w : ℕ) : ℝ) + 1 ≤ (m : ℝ) := by exact_mod_cast hkw_le
    have h_lo_div : -1 ≤ (((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ) := by
      rw [le_div_iff₀ hm_rpos]
      linarith
    have h_mid_div : (((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ) ≤
        ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)) := by
      exact div_le_div_of_nonneg_right (by linarith) (le_of_lt hm_rpos)
    have h_hi_div : (((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ) ≤ 0 := by
      exact div_nonpos_of_nonpos_of_nonneg (by linarith) (le_of_lt hm_rpos)
    have h_a_lo : -Real.log X ≤ Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)) := by
      have h1 := mul_le_mul_of_nonneg_left h_lo_div hB_nonneg
      linarith
    have h_ab : Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)) ≤
        Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)) :=
      mul_le_mul_of_nonneg_left h_mid_div hB_nonneg
    have h_b_hi : Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos hB_nonneg h_hi_div
    have h_diff_eq :
        Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)) -
        Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)) =
        Real.log X / (m : ℝ) := by
      have hm_ne : (m : ℝ) ≠ 0 := ne_of_gt hm_rpos
      field_simp [hm_ne]
      ring
    have h_diff_le : Real.log X / (m : ℝ) ≤ Real.log X :=
      div_le_self hB_nonneg hm_ge_one
    refine ⟨h_a_lo, h_ab, h_b_hi, ?_⟩
    rw [h_diff_eq]
    exact h_diff_le
  have h_card : Nat.card {w : NumberField.InfinitePlace K // w ≠ w₀} = r := by
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype_compl, Fintype.card_subtype_eq w₀]
    rfl
  have hS_main_outer : ∀ p ∈ S_main, ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
      ∑ j : Fin r, (p j : ℝ) * h * L w j ∈ Set.Ioc (a w - C_L * h) (b w + C_L * h) := by
    intro p hp
    exact ((hS_outer_iff p).mp (hS_sub hp)).2
  have hS_collar_prop : ∀ p ∈ S_collar,
      (∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
        ∑ j : Fin r, (p j : ℝ) * h * L w j ∈ Set.Ioc (a w - C_L * h) (b w + C_L * h)) ∧
      (∃ w : NumberField.InfinitePlace K, w ≠ w₀ ∧
        ∑ j : Fin r, (p j : ℝ) * h * L w j ∉ Set.Ioc (a w + C_L * h) (b w - C_L * h)) := by
    intro p hp
    rcases Finset.mem_sdiff.mp hp with ⟨hp_out, hp_not_main⟩
    rcases (hS_outer_iff p).mp hp_out with ⟨hp_box, hp_in_out⟩
    refine ⟨hp_in_out, ?_⟩
    by_contra h_all
    push_neg at h_all
    exact hp_not_main ((hS_main_iff p).mpr ⟨hp_box, h_all⟩)
  refine ⟨S_main, S_collar, ?_, ?_, ?_⟩
  · intro v
    refine mitsui_hat_grid_cell_pointwise_sandwich w₀ r N h C_L hh_nonneg L hC_L a b
      S_main S_outer S_collar hS_main_iff hS_outer_iff hS_collar_sum
      (fun y => mitsui_hat_box_partition_of_unity r N hN_ge_one h hh_pos y)
      v
      (fun p => mitsui_periodic_hat_eq_unique_int_shift r h hh_pos hh_le_half v p)
      (fun e he j => ?_)
    have h_abs_le : ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
        |∑ j₁ : Fin r, (v j₁ + (e j₁ : ℝ)) * L w j₁| ≤ B := by
      intro w hw
      rcases he w hw with ⟨h_gt_a, h_le_b⟩
      rcases hab_bounds w with ⟨ha_lo, _, hb_hi, _⟩
      exact abs_le.mpr ⟨by linarith, by linarith⟩
    have h_coord := hM_K w₀ (fun j₁ => v j₁ + (e j₁ : ℝ)) B hB_nonneg h_abs_le j
    exact le_trans h_coord hN_bound
  · have h_cards := mitsui_hat_grid_main_and_collar_card_bound w₀ r hr_pos h_card
      M_K C_L B h hM_K_pos hC_L_pos hB_pos hh_pos hh_le_half L (hM_K w₀) a b
      (fun w _hw => ⟨(hab_bounds w).2.1, (hab_bounds w).2.2.2⟩)
      S_main S_collar hS_main_outer hS_collar_prop
    have hC_2_le : C_2 ^ r ≤ C_grid := by
      dsimp [C_grid]
      have : 0 ≤ (r : ℝ) * K_end * C_2 ^ r := by positivity
      linarith
    calc (S_main.card : ℝ) * h ^ r
      _ ≤ C_2 ^ r * (B + 1) ^ r := h_cards.1
      _ ≤ C_grid * (B + 1) ^ r :=
        mul_le_mul_of_nonneg_right hC_2_le (by positivity)
  · have h_cards := mitsui_hat_grid_main_and_collar_card_bound w₀ r hr_pos h_card
      M_K C_L B h hM_K_pos hC_L_pos hB_pos hh_pos hh_le_half L (hM_K w₀) a b
      (fun w _hw => ⟨(hab_bounds w).2.1, (hab_bounds w).2.2.2⟩)
      S_main S_collar hS_main_outer hS_collar_prop
    have h_coeff_le : (r : ℝ) * K_end * C_2 ^ r ≤ C_grid := by
      dsimp [C_grid]
      have : 0 ≤ C_2 ^ r := by positivity
      linarith
    calc (S_collar.card : ℝ) * h ^ r
      _ ≤ (r : ℝ) * K_end * C_2 ^ r * h * (B + 1) ^ r := h_cards.2
      _ ≤ C_grid * δ * (B + 1) ^ r := by
        have h1 : (r : ℝ) * K_end * C_2 ^ r * h ≤ C_grid * δ :=
          mul_le_mul h_coeff_le hh_le_δ hh_nonneg (le_of_lt hC_grid_pos)
        exact mul_le_mul_of_nonneg_right h1 (by positivity)

theorem mitsui_hat_grid_sum_trigPoly_approx (r : ℕ) (h : ℝ) (hh_nonneg : 0 ≤ h) (M : ℕ)
    (f_1d : ℝ → ℝ) (hf_1d : ∀ x : ℝ, 0 ≤ f_1d x ∧ f_1d x ≤ 1)
    (c_1d : ℤ → ℝ) (hc_1d : ∀ m : ℤ, 0 ≤ c_1d m ∧ c_1d m ≤ h)
    (h_norm_1d : ∀ x : ℝ,
      ‖∑ m ∈ Finset.Icc (-(M : ℤ)) (M : ℤ),
          (c_1d m : ℂ) * Complex.exp (2 * Real.pi * Complex.I * (m : ℝ) * x)‖ ≤ 1)
    (ε_1d : ℝ) (hε_1d : 0 ≤ ε_1d)
    (h_approx_1d : ∀ x : ℝ,
      ‖(f_1d x : ℂ) -
        ∑ m ∈ Finset.Icc (-(M : ℤ)) (M : ℤ),
          (c_1d m : ℂ) * Complex.exp (2 * Real.pi * Complex.I * (m : ℝ) * x)‖ ≤ ε_1d)
    (S : Finset (Fin r → ℤ)) :
    ∃ c_S : (Fin r → ℤ) → ℂ,
      (∀ m_freq : Fin r → ℤ, ‖c_S m_freq‖ ≤ (S.card : ℝ) * h ^ r) ∧
      (∀ v : Fin r → ℝ,
        ‖((∑ p ∈ S, ∏ j : Fin r, f_1d (v j - (p j : ℝ) * h) : ℝ) : ℂ) -
          ∑ m_freq ∈ Fintype.piFinset (fun _ : Fin r => Finset.Icc (-(M : ℤ)) (M : ℤ)),
            c_S m_freq *
              Complex.exp (2 * Real.pi * Complex.I *
                ∑ j : Fin r, (m_freq j : ℝ) * v j)‖ ≤
          (S.card : ℝ) * (r : ℝ) * ε_1d) :=
by
  classical
  let I_M : Finset ℤ := Finset.Icc (-(M : ℤ)) (M : ℤ)
  let S_M : Finset (Fin r → ℤ) := Fintype.piFinset (fun _ : Fin r => I_M)
  let T_1d : ℝ → ℂ := fun x =>
    ∑ m ∈ I_M, (c_1d m : ℂ) * Complex.exp (2 * Real.pi * Complex.I * (m : ℝ) * x)
  let c_factor : (Fin r → ℤ) → (Fin r → ℤ) → Fin r → ℂ := fun m_freq p j =>
    (c_1d (m_freq j) : ℂ) *
      Complex.exp (-2 * Real.pi * Complex.I * (m_freq j : ℝ) * (p j : ℝ) * h)
  let c_S : (Fin r → ℤ) → ℂ := fun m_freq =>
    ∑ p ∈ S, ∏ j : Fin r, c_factor m_freq p j
  have hf_norm : ∀ x : ℝ, ‖(f_1d x : ℂ)‖ ≤ 1 := by
    intro x
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hf_1d x).1]
    exact (hf_1d x).2
  have hc_factor_norm : ∀ (m_freq p : Fin r → ℤ) (j : Fin r),
      ‖c_factor m_freq p j‖ ≤ h := by
    intro m_freq p j
    dsimp only [c_factor]
    have h_exp_eq : -2 * Real.pi * Complex.I * (m_freq j : ℝ) * (p j : ℝ) * h =
        ((-2 * Real.pi * (m_freq j : ℝ) * (p j : ℝ) * h : ℝ) : ℂ) * Complex.I := by
      push_cast
      ring
    rw [norm_mul, h_exp_eq, Complex.norm_exp_ofReal_mul_I, mul_one,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hc_1d (m_freq j)).1]
    exact (hc_1d (m_freq j)).2
  have hc_prod_norm : ∀ (m_freq p : Fin r → ℤ),
      ‖∏ j : Fin r, c_factor m_freq p j‖ ≤ h ^ r := by
    intro m_freq p
    rw [norm_prod]
    calc ∏ j : Fin r, ‖c_factor m_freq p j‖
      _ ≤ ∏ _j : Fin r, h :=
        Finset.prod_le_prod (fun j _ => norm_nonneg _) (fun j _ => hc_factor_norm m_freq p j)
      _ = h ^ r := by
        rw [Finset.prod_const, Finset.card_fin]
  have hc_S_bound : ∀ m_freq : Fin r → ℤ, ‖c_S m_freq‖ ≤ (S.card : ℝ) * h ^ r := by
    intro m_freq
    dsimp only [c_S]
    calc ‖∑ p ∈ S, ∏ j : Fin r, c_factor m_freq p j‖
      _ ≤ ∑ p ∈ S, ‖∏ j : Fin r, c_factor m_freq p j‖ := norm_sum_le _ _
      _ ≤ ∑ _p ∈ S, h ^ r := Finset.sum_le_sum (fun p _ => hc_prod_norm m_freq p)
      _ = (S.card : ℝ) * h ^ r := by
        rw [Finset.sum_const, nsmul_eq_mul]
  have h_prod_diff_finset : ∀ (a b : Fin r → ℂ),
      (∀ j : Fin r, ‖a j‖ ≤ 1) →
      (∀ j : Fin r, ‖b j‖ ≤ 1) →
      (∀ j : Fin r, ‖a j - b j‖ ≤ ε_1d) →
      ∀ A : Finset (Fin r),
        ‖(∏ j ∈ A, a j) - ∏ j ∈ A, b j‖ ≤ (A.card : ℝ) * ε_1d := by
    intro a b ha hb hab A
    induction A using Finset.induction_on with
    | empty =>
      simp
    | @insert i A hi ih =>
      rw [Finset.prod_insert hi, Finset.prod_insert hi, Finset.card_insert_of_notMem hi]
      have h_split : a i * (∏ j ∈ A, a j) - b i * (∏ j ∈ A, b j) =
          (a i - b i) * (∏ j ∈ A, a j) + b i * ((∏ j ∈ A, a j) - ∏ j ∈ A, b j) := by
        ring
      have h_prod_a : ‖∏ j ∈ A, a j‖ ≤ 1 := by
        rw [norm_prod]
        exact Finset.prod_le_one (fun j _ => norm_nonneg _) (fun j _ => ha j)
      have h_term1 : ‖(a i - b i) * (∏ j ∈ A, a j)‖ ≤ ε_1d := by
        rw [norm_mul]
        calc ‖a i - b i‖ * ‖∏ j ∈ A, a j‖
          _ ≤ ε_1d * 1 := mul_le_mul (hab i) h_prod_a (norm_nonneg _) hε_1d
          _ = ε_1d := mul_one _
      have h_term2 : ‖b i * ((∏ j ∈ A, a j) - ∏ j ∈ A, b j)‖ ≤ (A.card : ℝ) * ε_1d := by
        rw [norm_mul]
        calc ‖b i‖ * ‖(∏ j ∈ A, a j) - ∏ j ∈ A, b j‖
          _ ≤ 1 * ((A.card : ℝ) * ε_1d) := mul_le_mul (hb i) ih (norm_nonneg _) zero_le_one
          _ = (A.card : ℝ) * ε_1d := one_mul _
      rw [h_split, Nat.cast_add, Nat.cast_one]
      have h_tri := norm_add_le
        ((a i - b i) * (∏ j ∈ A, a j))
        (b i * ((∏ j ∈ A, a j) - ∏ j ∈ A, b j))
      linarith
  have h_pointwise_prod_err : ∀ (v : Fin r → ℝ) (p : Fin r → ℤ),
      ‖(∏ j : Fin r, (f_1d (v j - (p j : ℝ) * h) : ℂ)) -
        ∏ j : Fin r, T_1d (v j - (p j : ℝ) * h)‖ ≤ (r : ℝ) * ε_1d := by
    intro v p
    have h1 := h_prod_diff_finset
      (fun j => (f_1d (v j - (p j : ℝ) * h) : ℂ))
      (fun j => T_1d (v j - (p j : ℝ) * h))
      (fun j => hf_norm (v j - (p j : ℝ) * h))
      (fun j => h_norm_1d (v j - (p j : ℝ) * h))
      (fun j => h_approx_1d (v j - (p j : ℝ) * h))
      Finset.univ
    rwa [Finset.card_fin] at h1
  have h_term_factor : ∀ (v : Fin r → ℝ) (p m_freq : Fin r → ℤ) (j : Fin r),
      (c_1d (m_freq j) : ℂ) *
        Complex.exp (2 * Real.pi * Complex.I * (m_freq j : ℝ) * ((v j - (p j : ℝ) * h : ℝ) : ℂ)) =
      c_factor m_freq p j *
        Complex.exp (2 * Real.pi * Complex.I * (m_freq j : ℝ) * v j) := by
    intro v p m_freq j
    dsimp only [c_factor]
    have h_exp_split :
        2 * Real.pi * Complex.I * (m_freq j : ℝ) * ((v j - (p j : ℝ) * h : ℝ) : ℂ) =
        (-2 * Real.pi * Complex.I * (m_freq j : ℝ) * (p j : ℝ) * h) +
          (2 * Real.pi * Complex.I * (m_freq j : ℝ) * v j) := by
      push_cast
      ring
    rw [h_exp_split, Complex.exp_add]
    ring
  have h_exp_prod_eq : ∀ (v : Fin r → ℝ) (m_freq : Fin r → ℤ),
      (∏ j : Fin r, Complex.exp (2 * Real.pi * Complex.I * (m_freq j : ℝ) * v j)) =
      Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v j) := by
    intro v m_freq
    rw [← Complex.exp_sum]
    congr 1
    rw [Complex.ofReal_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    push_cast
    ring
  have h_prod_T_1d : ∀ (v : Fin r → ℝ) (p : Fin r → ℤ),
      (∏ j : Fin r, T_1d (v j - (p j : ℝ) * h)) =
      ∑ m_freq ∈ S_M,
        (∏ j : Fin r, c_factor m_freq p j) *
          Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v j) := by
    intro v p
    dsimp only [T_1d, S_M]
    rw [Finset.prod_univ_sum]
    refine Finset.sum_congr rfl (fun m_freq _ => ?_)
    have h_each : (∏ j : Fin r,
        (c_1d (m_freq j) : ℂ) *
          Complex.exp (2 * Real.pi * Complex.I * (m_freq j : ℝ) * ((v j - (p j : ℝ) * h : ℝ) : ℂ))) =
      ∏ j : Fin r,
        c_factor m_freq p j *
          Complex.exp (2 * Real.pi * Complex.I * (m_freq j : ℝ) * v j) := by
      refine Finset.prod_congr rfl (fun j _ => h_term_factor v p m_freq j)
    rw [h_each, Finset.prod_mul_distrib, h_exp_prod_eq v m_freq]
  have h_trig_eq : ∀ v : Fin r → ℝ,
      (∑ p ∈ S, ∏ j : Fin r, T_1d (v j - (p j : ℝ) * h)) =
      ∑ m_freq ∈ S_M,
        c_S m_freq *
          Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v j) := by
    intro v
    calc ∑ p ∈ S, ∏ j : Fin r, T_1d (v j - (p j : ℝ) * h)
      _ = ∑ p ∈ S, ∑ m_freq ∈ S_M,
            (∏ j : Fin r, c_factor m_freq p j) *
              Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v j) :=
        Finset.sum_congr rfl (fun p _ => h_prod_T_1d v p)
      _ = ∑ m_freq ∈ S_M, ∑ p ∈ S,
            (∏ j : Fin r, c_factor m_freq p j) *
              Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v j) :=
        Finset.sum_comm
      _ = ∑ m_freq ∈ S_M,
            c_S m_freq *
              Complex.exp (2 * Real.pi * Complex.I * ∑ j : Fin r, (m_freq j : ℝ) * v j) := by
        refine Finset.sum_congr rfl (fun m_freq _ => ?_)
        dsimp [c_S]
        rw [Finset.sum_mul]
  refine ⟨c_S, hc_S_bound, ?_⟩
  intro v
  have h_cast :
      ((∑ p ∈ S, ∏ j : Fin r, f_1d (v j - (p j : ℝ) * h) : ℝ) : ℂ) =
      ∑ p ∈ S, ∏ j : Fin r, (f_1d (v j - (p j : ℝ) * h) : ℂ) := by
    rw [Complex.ofReal_sum]
    refine Finset.sum_congr rfl (fun p _ => Complex.ofReal_prod _ _)
  rw [h_cast, ← h_trig_eq v, ← Finset.sum_sub_distrib]
  calc ‖∑ p ∈ S,
        ((∏ j : Fin r, (f_1d (v j - (p j : ℝ) * h) : ℂ)) -
          ∏ j : Fin r, T_1d (v j - (p j : ℝ) * h))‖
    _ ≤ ∑ p ∈ S,
          ‖(∏ j : Fin r, (f_1d (v j - (p j : ℝ) * h) : ℂ)) -
            ∏ j : Fin r, T_1d (v j - (p j : ℝ) * h)‖ :=
      norm_sum_le _ _
    _ ≤ ∑ _p ∈ S, ((r : ℝ) * ε_1d) :=
      Finset.sum_le_sum (fun p _ => h_pointwise_prod_err v p)
    _ = (S.card : ℝ) * (r : ℝ) * ε_1d := by
      rw [Finset.sum_const, nsmul_eq_mul, mul_assoc]

theorem mitsui_unitLogCoord_cell_trigPoly_approx {K : Type u} [Field K] [NumberField K]
    (h_rank : 0 < NumberField.Units.rank K) :
    ∃ C_trig : ℝ, 0 < C_trig ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m →
          ∀ w₀ : NumberField.InfinitePlace K,
            ∀ k : NumberField.InfinitePlace K → Fin m,
              ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
                ∀ M : ℕ, 1 ≤ M →
                  ∃ (c_main c_collar : (Fin (NumberField.Units.rank K) → ℤ) → ℂ),
                    (∀ v : Fin (NumberField.Units.rank K) → ℝ,
                      ‖(Nat.card {e : Fin (NumberField.Units.rank K) → ℤ //
                          ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
                            ∑ j : Fin (NumberField.Units.rank K),
                              (v j + (e j : ℝ)) *
                                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ∈
                              Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                                (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℂ) -
                        ∑ m_freq ∈ Fintype.piFinset (fun _ : Fin (NumberField.Units.rank K) => Finset.Icc (-(M : ℤ)) (M : ℤ)),
                          c_main m_freq *
                            Complex.exp (2 * Real.pi * Complex.I *
                              ∑ j : Fin (NumberField.Units.rank K), (m_freq j : ℝ) * v j)‖ ≤
                      (∑ m_freq ∈ Fintype.piFinset (fun _ : Fin (NumberField.Units.rank K) => Finset.Icc (-(M : ℤ)) (M : ℤ)),
                        c_collar m_freq *
                          Complex.exp (2 * Real.pi * Complex.I *
                            ∑ j : Fin (NumberField.Units.rank K), (m_freq j : ℝ) * v j)).re +
                      C_trig * (Real.log X + 1) ^ (NumberField.Units.rank K) *
                        (δ ^ (2 * NumberField.Units.rank K))⁻¹ * (M : ℝ)⁻¹) ∧
                    ‖c_collar 0‖ ≤ C_trig * δ * (Real.log X + 1) ^ (NumberField.Units.rank K) ∧
                    (∀ m_freq : Fin (NumberField.Units.rank K) → ℤ,
                      ‖c_main m_freq‖ ≤ C_trig * (Real.log X + 1) ^ (NumberField.Units.rank K) ∧
                      ‖c_collar m_freq‖ ≤ C_trig * (Real.log X + 1) ^ (NumberField.Units.rank K)) :=
by
  classical
  obtain ⟨M_K, hM_K_pos, hM_K⟩ := mitsui_unitLogCoord_le_of_place_log_le (K := K)
  obtain ⟨C_grid, hC_grid_pos, h_grid⟩ :=
    mitsui_unitLogCoord_cell_hat_grid_sandwich h_rank M_K hM_K_pos hM_K
  let r : ℕ := NumberField.Units.rank K
  have hr_pos : 0 < r := h_rank
  have hr_rpos : (0 : ℝ) < (r : ℝ) := Nat.cast_pos.mpr hr_pos
  let C_trig : ℝ := C_grid + (2 : ℝ) ^ (r + 2) * (r : ℝ) * C_grid
  have hC_trig_pos : 0 < C_trig := by dsimp [C_trig]; positivity
  have hC_grid_le : C_grid ≤ C_trig := by
    have : 0 ≤ (2 : ℝ) ^ (r + 2) * (r : ℝ) * C_grid := by positivity
    dsimp [C_trig]; linarith
  have h_tail_coeff_le : (2 : ℝ) ^ (r + 2) * (r : ℝ) * C_grid ≤ C_trig := by
    dsimp [C_trig]; linarith
  refine ⟨C_trig, hC_trig_pos, ?_⟩
  intro X hX m hm w₀ k δ hδ_pos hδ_le_one M hM_ge_one
  have hlogX_pos : 0 < Real.log X := Real.log_pos hX
  have hlogX1_pos : 0 < (Real.log X + 1) ^ r := by positivity
  have hM_rpos : (0 : ℝ) < (M : ℝ) := Nat.cast_pos.mpr hM_ge_one
  let h : ℝ := δ / 2
  have hh_pos : 0 < h := by dsimp [h]; linarith
  have hh_nonneg : 0 ≤ h := le_of_lt hh_pos
  have hh_le : h ≤ 1 / 2 := by dsimp [h]; linarith
  obtain ⟨S_main, S_collar, h_sand, hS_main_card, hS_collar_card⟩ :=
    h_grid X hX m hm w₀ k δ hδ_pos hδ_le_one
  obtain ⟨c_1d, hc_1d, h_norm_1d, h_approx_1d⟩ :=
    mitsui_periodic_tent_1d_trigPoly_approx h hh_pos hh_le M hM_ge_one
  let f_1d : ℝ → ℝ := fun x =>
    max (0 : ℝ) (1 - |x - (Int.floor (x + 1 / 2) : ℝ)| / h)
  have hf_1d : ∀ x : ℝ, 0 ≤ f_1d x ∧ f_1d x ≤ 1 := by
    intro x
    refine ⟨le_max_left 0 _, max_le zero_le_one ?_⟩
    exact sub_le_self 1 (div_nonneg (abs_nonneg _) hh_nonneg)
  let ε_1d : ℝ := (h * (M : ℝ))⁻¹
  have hε_1d : 0 ≤ ε_1d := by dsimp [ε_1d]; positivity
  obtain ⟨c_main, hc_main_coeff, hc_main_approx⟩ :=
    mitsui_hat_grid_sum_trigPoly_approx r h hh_nonneg M f_1d hf_1d c_1d hc_1d
      h_norm_1d ε_1d hε_1d h_approx_1d S_main
  obtain ⟨c_collar, hc_collar_coeff, hc_collar_approx⟩ :=
    mitsui_hat_grid_sum_trigPoly_approx r h hh_nonneg M f_1d hf_1d c_1d hc_1d
      h_norm_1d ε_1d hε_1d h_approx_1d S_collar
  have hS_collar_card_unif : (S_collar.card : ℝ) * h ^ r ≤ C_grid * (Real.log X + 1) ^ r := by
    calc (S_collar.card : ℝ) * h ^ r
      _ ≤ C_grid * δ * (Real.log X + 1) ^ r := hS_collar_card
      _ ≤ C_grid * 1 * (Real.log X + 1) ^ r := by
        have : C_grid * δ ≤ C_grid * 1 := mul_le_mul_of_nonneg_left hδ_le_one (le_of_lt hC_grid_pos)
        exact mul_le_mul_of_nonneg_right this (le_of_lt hlogX1_pos)
      _ = C_grid * (Real.log X + 1) ^ r := by ring
  refine ⟨c_main, c_collar, ?_, ?_, ?_⟩
  · intro v
    let N_v : ℝ := (Nat.card {e : Fin r → ℤ //
      ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
        ∑ j : Fin r,
          (v j + (e j : ℝ)) *
            Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
              w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ∈
          Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
            (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℝ)
    let F_main : ℝ := ∑ p ∈ S_main, ∏ j : Fin r, f_1d (v j - (p j : ℝ) * h)
    let F_collar : ℝ := ∑ p ∈ S_collar, ∏ j : Fin r, f_1d (v j - (p j : ℝ) * h)
    let T_main : ℂ :=
      ∑ m_freq ∈ Fintype.piFinset (fun _ : Fin r => Finset.Icc (-(M : ℤ)) (M : ℤ)),
        c_main m_freq *
          Complex.exp (2 * Real.pi * Complex.I *
            ∑ j : Fin r, (m_freq j : ℝ) * v j)
    let T_collar : ℂ :=
      ∑ m_freq ∈ Fintype.piFinset (fun _ : Fin r => Finset.Icc (-(M : ℤ)) (M : ℤ)),
        c_collar m_freq *
          Complex.exp (2 * Real.pi * Complex.I *
            ∑ j : Fin r, (m_freq j : ℝ) * v j)
    have h_sand_v : F_main ≤ N_v ∧ N_v ≤ F_main + F_collar := h_sand v
    have h_diff_nonneg : 0 ≤ N_v - F_main := sub_nonneg.mpr h_sand_v.1
    have h_diff_le : N_v - F_main ≤ F_collar := by linarith [h_sand_v.2]
    have h_norm_NF : ‖(N_v : ℂ) - (F_main : ℂ)‖ ≤ F_collar := by
      rw [← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg h_diff_nonneg]
      exact h_diff_le
    have h_F_main_T : ‖(F_main : ℂ) - T_main‖ ≤ (S_main.card : ℝ) * (r : ℝ) * ε_1d :=
      hc_main_approx v
    have h_F_collar_T : ‖(F_collar : ℂ) - T_collar‖ ≤ (S_collar.card : ℝ) * (r : ℝ) * ε_1d :=
      hc_collar_approx v
    have h_F_collar_re : F_collar - T_collar.re ≤ (S_collar.card : ℝ) * (r : ℝ) * ε_1d := by
      have h1 : F_collar - T_collar.re = ((F_collar : ℂ) - T_collar).re := by
        rw [Complex.sub_re, Complex.ofReal_re]
      have h2 : ((F_collar : ℂ) - T_collar).re ≤ ‖(F_collar : ℂ) - T_collar‖ :=
        le_trans (le_abs_self _) (Complex.abs_re_le_norm _)
      linarith
    have h_tri : ‖(N_v : ℂ) - T_main‖ ≤
        T_collar.re + ((S_main.card : ℝ) + (S_collar.card : ℝ)) * (r : ℝ) * ε_1d := by
      have h_id : (N_v : ℂ) - T_main = ((N_v : ℂ) - (F_main : ℂ)) + ((F_main : ℂ) - T_main) := by
        ring
      have h1 : ‖(N_v : ℂ) - T_main‖ ≤ ‖(N_v : ℂ) - (F_main : ℂ)‖ + ‖(F_main : ℂ) - T_main‖ := by
        rw [h_id]
        exact norm_add_le _ _
      linarith
    have h_cards_hr : ((S_main.card : ℝ) + (S_collar.card : ℝ)) * h ^ r ≤
        2 * C_grid * (Real.log X + 1) ^ r := by
      linarith [hS_main_card, hS_collar_card_unif]
    have h_hr_pos : 0 < h ^ r := pow_pos hh_pos r
    have h_cards_le : (S_main.card : ℝ) + (S_collar.card : ℝ) ≤
        2 * C_grid * (Real.log X + 1) ^ r * (h ^ r)⁻¹ := by
      exact (le_mul_inv_iff₀ h_hr_pos).mpr h_cards_hr
    have h_hr_inv_h_inv : (h ^ r)⁻¹ * h⁻¹ = (2 : ℝ) ^ (r + 1) * (δ ^ (r + 1))⁻¹ := by
      have h1 : h ^ r * h = δ ^ (r + 1) / (2 : ℝ) ^ (r + 1) := by
        rw [← pow_succ, div_pow]
      have hδ_ne : δ ^ (r + 1) ≠ 0 := ne_of_gt (pow_pos hδ_pos (r + 1))
      have h2_ne : (2 : ℝ) ^ (r + 1) ≠ 0 := by positivity
      rw [← mul_inv, h1, inv_div, div_eq_mul_inv]
    have h_δ_pow_le : δ ^ (2 * r) ≤ δ ^ (r + 1) :=
      pow_le_pow_of_le_one (le_of_lt hδ_pos) hδ_le_one (by omega)
    have h_δ_inv_le : (δ ^ (r + 1))⁻¹ ≤ (δ ^ (2 * r))⁻¹ :=
      inv_anti₀ (pow_pos hδ_pos (2 * r)) h_δ_pow_le
    have h_tail_le :
        ((S_main.card : ℝ) + (S_collar.card : ℝ)) * (r : ℝ) * ε_1d ≤
        C_trig * (Real.log X + 1) ^ r * (δ ^ (2 * r))⁻¹ * (M : ℝ)⁻¹ := by
      have h1 : ((S_main.card : ℝ) + (S_collar.card : ℝ)) * (r : ℝ) * ε_1d ≤
          (2 * C_grid * (Real.log X + 1) ^ r * (h ^ r)⁻¹) * (r : ℝ) * ε_1d :=
        mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_right h_cards_le (le_of_lt hr_rpos)) hε_1d
      have h2 : (2 * C_grid * (Real.log X + 1) ^ r * (h ^ r)⁻¹) * (r : ℝ) * ε_1d =
          ((2 : ℝ) ^ (r + 2) * (r : ℝ) * C_grid) * (Real.log X + 1) ^ r *
            (δ ^ (r + 1))⁻¹ * (M : ℝ)⁻¹ := by
        dsimp [ε_1d]
        rw [mul_inv]
        calc (2 * C_grid * (Real.log X + 1) ^ r * (h ^ r)⁻¹) * (r : ℝ) * (h⁻¹ * (M : ℝ)⁻¹)
          _ = 2 * C_grid * (r : ℝ) * (Real.log X + 1) ^ r * ((h ^ r)⁻¹ * h⁻¹) * (M : ℝ)⁻¹ := by ring
          _ = 2 * C_grid * (r : ℝ) * (Real.log X + 1) ^ r * ((2 : ℝ) ^ (r + 1) * (δ ^ (r + 1))⁻¹) * (M : ℝ)⁻¹ := by
            rw [h_hr_inv_h_inv]
          _ = ((2 : ℝ) ^ (r + 2) * (r : ℝ) * C_grid) * (Real.log X + 1) ^ r *
                (δ ^ (r + 1))⁻¹ * (M : ℝ)⁻¹ := by
            rw [pow_succ (2 : ℝ) (r + 1)]
            ring
      have h3 : ((2 : ℝ) ^ (r + 2) * (r : ℝ) * C_grid) * (Real.log X + 1) ^ r *
            (δ ^ (r + 1))⁻¹ * (M : ℝ)⁻¹ ≤
          C_trig * (Real.log X + 1) ^ r * (δ ^ (2 * r))⁻¹ * (M : ℝ)⁻¹ := by
        have h3a : (2 : ℝ) ^ (r + 2) * (r : ℝ) * C_grid * (Real.log X + 1) ^ r ≤
            C_trig * (Real.log X + 1) ^ r :=
          mul_le_mul_of_nonneg_right h_tail_coeff_le (le_of_lt hlogX1_pos)
        have h3b : (2 : ℝ) ^ (r + 2) * (r : ℝ) * C_grid * (Real.log X + 1) ^ r * (δ ^ (r + 1))⁻¹ ≤
            C_trig * (Real.log X + 1) ^ r * (δ ^ (2 * r))⁻¹ :=
          mul_le_mul h3a h_δ_inv_le (by positivity) (by positivity)
        exact mul_le_mul_of_nonneg_right h3b (by positivity)
      linarith
    change ‖((N_v : ℝ) : ℂ) - T_main‖ ≤ T_collar.re + C_trig * (Real.log X + 1) ^ r * (δ ^ (2 * r))⁻¹ * (M : ℝ)⁻¹
    linarith
  · calc ‖c_collar 0‖
      _ ≤ (S_collar.card : ℝ) * h ^ r := hc_collar_coeff 0
      _ ≤ C_grid * δ * (Real.log X + 1) ^ r := hS_collar_card
      _ ≤ C_trig * δ * (Real.log X + 1) ^ r := by
        have : C_grid * δ ≤ C_trig * δ := mul_le_mul_of_nonneg_right hC_grid_le (le_of_lt hδ_pos)
        exact mul_le_mul_of_nonneg_right this (le_of_lt hlogX1_pos)
  · intro m_freq
    refine ⟨?_, ?_⟩
    · calc ‖c_main m_freq‖
        _ ≤ (S_main.card : ℝ) * h ^ r := hc_main_coeff m_freq
        _ ≤ C_grid * (Real.log X + 1) ^ r := hS_main_card
        _ ≤ C_trig * (Real.log X + 1) ^ r :=
          mul_le_mul_of_nonneg_right hC_grid_le (le_of_lt hlogX1_pos)
    · calc ‖c_collar m_freq‖
        _ ≤ (S_collar.card : ℝ) * h ^ r := hc_collar_coeff m_freq
        _ ≤ C_grid * (Real.log X + 1) ^ r := hS_collar_card_unif
        _ ≤ C_trig * (Real.log X + 1) ^ r :=
          mul_le_mul_of_nonneg_right hC_grid_le (le_of_lt hlogX1_pos)

theorem mitsui_riesz_primePower_unitLogCoord_cell_le_of_trigPoly_approx {K : Type u} [Field K] [NumberField K]
    (X : ℝ)
    (m : ℕ)
    (w₀ : NumberField.InfinitePlace K)
    (k : NumberField.InfinitePlace K → Fin m)
    (Φ_W : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →
      Fin (NumberField.Units.rank K) → ℝ)
    (Z : ℝ) (hZ : 0 < Z)
    (χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ I‖ ≤ 1)
    (M : ℕ)
    (c_main c_collar : (Fin (NumberField.Units.rank K) → ℤ) → ℂ)
    (A_main A_collar ε_tail B₀ B_osc : ℝ)
    (hA_main : 0 ≤ A_main) (hB₀ : 0 ≤ B₀) (hB_osc : 0 ≤ B_osc)
    (h_approx : ∀ v : Fin (NumberField.Units.rank K) → ℝ,
      ‖(Nat.card {e : Fin (NumberField.Units.rank K) → ℤ //
          ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
            ∑ j : Fin (NumberField.Units.rank K),
              (v j + (e j : ℝ)) *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) ∈
              Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℂ) -
        ∑ m_freq ∈ Fintype.piFinset (fun _ : Fin (NumberField.Units.rank K) => Finset.Icc (-(M : ℤ)) (M : ℤ)),
          c_main m_freq *
            Complex.exp (2 * Real.pi * Complex.I *
              ∑ j : Fin (NumberField.Units.rank K), (m_freq j : ℝ) * v j)‖ ≤
      (∑ m_freq ∈ Fintype.piFinset (fun _ : Fin (NumberField.Units.rank K) => Finset.Icc (-(M : ℤ)) (M : ℤ)),
        c_collar m_freq *
          Complex.exp (2 * Real.pi * Complex.I *
            ∑ j : Fin (NumberField.Units.rank K), (m_freq j : ℝ) * v j)).re + ε_tail)
    (hc_collar_zero : ‖c_collar 0‖ ≤ A_collar)
    (hc_coeff : ∀ m_freq : Fin (NumberField.Units.rank K) → ℤ,
      ‖c_main m_freq‖ ≤ A_main ∧ ‖c_collar m_freq‖ ≤ A_main)
    (h_zero_χ :
      ‖∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Z},
          (χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
            ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
              Real.log (Z / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)‖ ≤ B₀)
    (h_osc : ∀ m_freq ∈ Fintype.piFinset (fun _ : Fin (NumberField.Units.rank K) => Finset.Icc (-(M : ℤ)) (M : ℤ)),
      m_freq ≠ 0 →
      ‖∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Z},
          Complex.exp (2 * Real.pi * Complex.I *
            ∑ j : Fin (NumberField.Units.rank K),
              (m_freq j : ℝ) *
                ((pm.1.2 : ℝ) * Φ_W ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩ j)) *
            ((χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
              ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                Real.log (Z / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ))‖ ≤ B_osc ∧
      ‖∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
