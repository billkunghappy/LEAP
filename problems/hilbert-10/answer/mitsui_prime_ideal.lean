          rw [Fintype.card_subtype]
        rw [h_card, ← Fintype.card_congr e_k, ← Nat.card_eq_fintype_card]
      let ι : S_pos → S_J := fun J => ⟨J.1, by exact_mod_cast J.2.2⟩
      have hι_inj : Function.Injective ι := fun a b h => Subtype.ext (congrArg (fun x : S_J => x.1) h)
      have h_le_SJ : (Nat.card S_pos : ℝ) ≤ (Nat.card S_J : ℝ) := by
        exact_mod_cast Nat.card_le_card_of_injective ι hι_inj
      rw [h_sum_eq, Real.rpow_one]
      exact le_trans h_le_SJ (hC₁ (N : ℝ) hN_real)
    have h_bigO : (fun N : ℕ => ∑ k ∈ Finset.Icc 1 N, (a_K k : ℝ)) =O[Filter.atTop]
