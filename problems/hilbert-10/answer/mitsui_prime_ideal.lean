    have hs_out_ne : s_out ≠ 0 := ne_of_gt hs_out_pos
    let s_in : ℝ := max 0 (δ - 2 * η)
    have hs_in_nonneg : 0 ≤ s_in := le_max_left _ _
    have hs_le : s_in ≤ s_out :=
      max_le (le_of_lt hs_out_pos) (by dsimp [s_out]; linarith only [hη_pos])
    have h_card_VK_diff : (T.card : ℝ) * V_K ≤ s_out ^ n - s_in ^ n := by
      let j : NumberField.RingOfIntegers K → NumberField.mixedEmbedding.integerLattice K :=
        fun x => ⟨NumberField.mixedEmbedding K (x : K), ⟨x, rfl⟩⟩
      have hj_inj : Function.Injective j := by
        intro x y hxy
        have h : NumberField.mixedEmbedding K (x : K) = NumberField.mixedEmbedding K (y : K) :=
          congrArg Subtype.val hxy
        obtain ⟨w⟩ : Nonempty (NumberField.InfinitePlace K) := inferInstance
        have hsub : NumberField.mixedEmbedding K ((x : K) - (y : K)) = 0 := by
          rw [map_sub, h, sub_self]
        have hw : w ((x : K) - (y : K)) = 0 := by
          rw [← NumberField.mixedEmbedding.normAtPlace_apply w ((x : K) - (y : K)), hsub, map_zero]
        exact Subtype.ext (sub_eq_zero.mp ((AbsoluteValue.eq_zero w.1).mp hw))
      let T_lat : Finset (NumberField.mixedEmbedding.integerLattice K) := T.map ⟨j, hj_inj⟩
      let U : Set (NumberField.mixedEmbedding.mixedSpace K) := ⋃ g ∈ T_lat, g +ᵥ F_lat
      have haedisj : (T_lat : Set (NumberField.mixedEmbedding.integerLattice K)).Pairwise
          (Function.onFun (MeasureTheory.AEDisjoint MeasureTheory.volume) (fun g => g +ᵥ F_lat)) := by
        intro g₁ _ g₂ _ hne
        exact hF_fund.aedisjoint hne
      have hnull : ∀ g ∈ T_lat, MeasureTheory.NullMeasurableSet (g +ᵥ F_lat) MeasureTheory.volume := by
        intro g _
        change MeasureTheory.NullMeasurableSet
          ((g : NumberField.mixedEmbedding.mixedSpace K) +ᵥ F_lat) MeasureTheory.volume
        exact (hF_meas.const_vadd (g : NumberField.mixedEmbedding.mixedSpace K)).nullMeasurableSet
      have hvol_union : MeasureTheory.volume U = (T.card : ENNReal) * MeasureTheory.volume F_lat := by
        dsimp [U]
        rw [MeasureTheory.measure_biUnion_finset₀ haedisj hnull]
        have h_each : ∀ g ∈ T_lat, MeasureTheory.volume (g +ᵥ F_lat) = MeasureTheory.volume F_lat := by
          intro g _
          change MeasureTheory.volume ((g : NumberField.mixedEmbedding.mixedSpace K) +ᵥ F_lat) =
            MeasureTheory.volume F_lat
          exact MeasureTheory.measure_vadd MeasureTheory.volume
            (g : NumberField.mixedEmbedding.mixedSpace K) F_lat
        rw [Finset.sum_congr rfl h_each, Finset.sum_const, nsmul_eq_mul, Finset.card_map]
      have hU_ne_top : MeasureTheory.volume U ≠ ⊤ := by
        rw [hvol_union]
        exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top T.card) hF_ne_top
      have hvol_cube : ∀ (v : NumberField.mixedEmbedding.mixedSpace K) (s : ℝ), 0 ≤ s →
          MeasureTheory.volume (v +ᵥ (s • F_std)) = ENNReal.ofReal (s ^ n) := by
        intro v s hs
        rw [MeasureTheory.measure_vadd, MeasureTheory.Measure.addHaar_smul,
            NumberField.mixedEmbedding.finrank K,
            NumberField.mixedEmbedding.volume_fundamentalDomain_stdBasis K, mul_one]
        have hsn_nonneg : 0 ≤ s ^ n := pow_nonneg hs n
        rw [abs_of_nonneg hsn_nonneg]
      let v_out : NumberField.mixedEmbedding.mixedSpace K :=
        b.equivFun.symm (fun i => a_lo i - η)
      have hv_out_repr : ∀ i : NumberField.mixedEmbedding.index K,
          b.repr v_out i = a_lo i - η := by
        intro i
        change (b.equivFun v_out) i = _
        rw [LinearEquiv.apply_symm_apply]
      let B_out : Set (NumberField.mixedEmbedding.mixedSpace K) := v_out +ᵥ (s_out • F_std)
      have hU_sub_Bout : U ⊆ B_out := by
        intro z hzU
        simp only [U, Set.mem_iUnion] at hzU
        rcases hzU with ⟨g, hg, hzF⟩
        rcases Finset.mem_map.mp hg with ⟨x, hxT, rfl⟩
        rw [Set.Finite.mem_toFinset] at hxT
        rcases hzF with ⟨u, huF, rfl⟩
        change (NumberField.mixedEmbedding K (x : K) + u) ∈ v_out +ᵥ (s_out • F_std)
        let w : NumberField.mixedEmbedding.mixedSpace K :=
          s_out⁻¹ • ((NumberField.mixedEmbedding K (x : K) + u) - v_out)
        have hw_in : w ∈ F_std := by
          rw [ZSpan.mem_fundamentalDomain]
          intro i
          dsimp [w]
          rw [map_smul, map_sub, map_add, Finsupp.smul_apply, Finsupp.sub_apply, Finsupp.add_apply,
              smul_eq_mul, hv_out_repr i]
          have hxi := hxT.1 i
          have hui := hF_coord u huF i
          have hba := hba_eq i
          have h_num_nonneg : 0 ≤ (b.repr (NumberField.mixedEmbedding K (x : K)) i + b.repr u i) -
              (a_lo i - η) := by
            dsimp [η]
            linarith only [hxi.1, hui.1]
          have h_num_lt : (b.repr (NumberField.mixedEmbedding K (x : K)) i + b.repr u i) -
              (a_lo i - η) < s_out := by
            dsimp [s_out, η]
            linarith only [hxi.2, hui.2, hba]
          refine ⟨mul_nonneg (inv_nonneg.mpr (le_of_lt hs_out_pos)) h_num_nonneg, ?_⟩
          rw [inv_mul_lt_iff₀ hs_out_pos, mul_one]
          exact h_num_lt
        refine ⟨s_out • w, ⟨w, hw_in, rfl⟩, ?_⟩
        dsimp [w]
        rw [smul_smul, mul_inv_cancel₀ hs_out_ne, one_smul]
        abel
      rcases le_or_gt (δ - 2 * η) 0 with h_small | h_large
      · have hs_in_zero : s_in = 0 := max_eq_left h_small
        have hs_in_pow : s_in ^ n = 0 := by
          rw [hs_in_zero, zero_pow (ne_of_gt hn_pos)]
        have h_meas_ie : MeasureTheory.volume U ≤ MeasureTheory.volume B_out :=
          MeasureTheory.measure_mono hU_sub_Bout
        rw [hvol_union, hvol_cube v_out s_out (le_of_lt hs_out_pos)] at h_meas_ie
        have htoReal := ENNReal.toReal_mono ENNReal.ofReal_ne_top h_meas_ie
        rw [ENNReal.toReal_mul, ENNReal.toReal_natCast,
            ENNReal.toReal_ofReal (by positivity)] at htoReal
        change (T.card : ℝ) * V_K ≤ s_out ^ n at htoReal
        linarith only [htoReal, hs_in_pow]
      · have hs_in_eq : s_in = δ - 2 * η := max_eq_right (le_of_lt h_large)
        have hs_in_pos : 0 < s_in := by linarith only [hs_in_eq, h_large]
        let v_in : NumberField.mixedEmbedding.mixedSpace K :=
          b.equivFun.symm (fun i => a_lo i + η)
        have hv_in_repr : ∀ i : NumberField.mixedEmbedding.index K,
            b.repr v_in i = a_lo i + η := by
          intro i
          change (b.equivFun v_in) i = _
          rw [LinearEquiv.apply_symm_apply]
        let B_in : Set (NumberField.mixedEmbedding.mixedSpace K) := v_in +ᵥ (s_in • F_std)
        have hBin_meas : MeasurableSet B_in :=
          (hF_std_meas.const_smul₀ s_in).const_vadd v_in
        have hBin_coord : ∀ z ∈ B_in, ∀ i : NumberField.mixedEmbedding.index K,
            a_lo i + η ≤ b.repr z i ∧ b.repr z i < b_hi i - η := by
          intro z hzB i
          rcases hzB with ⟨_, ⟨w, hw_in, rfl⟩, rfl⟩
          change a_lo i + η ≤ b.repr (v_in + s_in • w) i ∧
            b.repr (v_in + s_in • w) i < b_hi i - η
          rw [map_add, map_smul, Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul, hv_in_repr i]
          rw [ZSpan.mem_fundamentalDomain] at hw_in
          have hwi := hw_in i
          have h_lo : 0 ≤ s_in * b.repr w i := mul_nonneg (le_of_lt hs_in_pos) hwi.1
          have h_hi : s_in * b.repr w i < s_in := by
            calc s_in * b.repr w i < s_in * 1 := mul_lt_mul_of_pos_left hwi.2 hs_in_pos
              _ = s_in := mul_one s_in
          have hba := hba_eq i
          refine ⟨by linarith only [h_lo], by linarith only [h_hi, hs_in_eq, hba]⟩
        have h_disj : Disjoint U B_in := by
          rw [Set.disjoint_left]
          intro z hzU hzB
          simp only [U, Set.mem_iUnion] at hzU
          rcases hzU with ⟨g, hg, hzF⟩
          rcases Finset.mem_map.mp hg with ⟨x, hxT, rfl⟩
          rw [Set.Finite.mem_toFinset] at hxT
          rcases hzF with ⟨u, huF, rfl⟩
          apply hxT.2
          intro i
          have hz_i := hBin_coord (NumberField.mixedEmbedding K (x : K) + u) hzB i
          rw [map_add, Finsupp.add_apply] at hz_i
          have hu_i := hF_coord u huF i
          dsimp [η] at hz_i
          exact ⟨by linarith only [hz_i.1, hu_i.2], by linarith only [hz_i.2, hu_i.1]⟩
        have h_union_sub : U ∪ B_in ⊆ B_out := by
          rintro z (hzU | hzB)
          · exact hU_sub_Bout hzU
          · let w : NumberField.mixedEmbedding.mixedSpace K := s_out⁻¹ • (z - v_out)
            have hw_in : w ∈ F_std := by
              rw [ZSpan.mem_fundamentalDomain]
              intro i
              dsimp [w]
              rw [map_smul, map_sub, Finsupp.smul_apply, Finsupp.sub_apply,
                  smul_eq_mul, hv_out_repr i]
              have hz_i := hBin_coord z hzB i
              have hba := hba_eq i
              have h_num_nonneg : 0 ≤ b.repr z i - (a_lo i - η) := by
                linarith only [hz_i.1, hη_pos]
              have h_num_lt : b.repr z i - (a_lo i - η) < s_out := by
                dsimp [s_out]
                linarith only [hz_i.2, hba, hη_pos]
              refine ⟨mul_nonneg (inv_nonneg.mpr (le_of_lt hs_out_pos)) h_num_nonneg, ?_⟩
              rw [inv_mul_lt_iff₀ hs_out_pos, mul_one]
              exact h_num_lt
            refine ⟨s_out • w, ⟨w, hw_in, rfl⟩, ?_⟩
            dsimp [w]
            rw [smul_smul, mul_inv_cancel₀ hs_out_ne, one_smul]
            abel
        have h_meas_ie : MeasureTheory.volume U + MeasureTheory.volume B_in ≤
            MeasureTheory.volume B_out := by
          rw [← MeasureTheory.measure_union h_disj hBin_meas]
          exact MeasureTheory.measure_mono h_union_sub
        have hBin_vol : MeasureTheory.volume B_in = ENNReal.ofReal (s_in ^ n) :=
          hvol_cube v_in s_in hs_in_nonneg
        have hBout_vol : MeasureTheory.volume B_out = ENNReal.ofReal (s_out ^ n) :=
          hvol_cube v_out s_out (le_of_lt hs_out_pos)
        rw [hBin_vol, hBout_vol] at h_meas_ie
        have htoReal := ENNReal.toReal_mono ENNReal.ofReal_ne_top h_meas_ie
        rw [ENNReal.toReal_add hU_ne_top ENNReal.ofReal_ne_top,
            hvol_union, ENNReal.toReal_mul, ENNReal.toReal_natCast,
            ENNReal.toReal_ofReal (by positivity),
            ENNReal.toReal_ofReal (by positivity)] at htoReal
        change (T.card : ℝ) * V_K + s_in ^ n ≤ s_out ^ n at htoReal
        linarith only [htoReal]
    have h_geom_term : ∀ r ∈ Finset.range n,
        s_out ^ r * s_in ^ (n - 1 - r) ≤ s_out ^ (n - 1) := by
      intro r hr
      have hr_lt : r < n := Finset.mem_range.mp hr
      have h_exp : r + (n - 1 - r) = n - 1 := by omega
      calc s_out ^ r * s_in ^ (n - 1 - r)
          ≤ s_out ^ r * s_out ^ (n - 1 - r) :=
            mul_le_mul_of_nonneg_left
              (pow_le_pow_left₀ hs_in_nonneg hs_le (n - 1 - r)) (pow_nonneg (le_of_lt hs_out_pos) r)
        _ = s_out ^ (n - 1) := by rw [← pow_add, h_exp]
    have h_geom_sum : (∑ r ∈ Finset.range n, s_out ^ r * s_in ^ (n - 1 - r)) ≤
        (n : ℝ) * s_out ^ (n - 1) := by
      calc (∑ r ∈ Finset.range n, s_out ^ r * s_in ^ (n - 1 - r))
          ≤ ∑ _r ∈ Finset.range n, s_out ^ (n - 1) := Finset.sum_le_sum h_geom_term
        _ = (n : ℝ) * s_out ^ (n - 1) := by
            rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    have h_pow_diff : s_out ^ n - s_in ^ n ≤ (n : ℝ) * s_out ^ (n - 1) * (s_out - s_in) := by
      rw [← geom_sum₂_mul s_out s_in n]
      exact mul_le_mul_of_nonneg_right h_geom_sum (sub_nonneg.mpr hs_le)
    have hs_diff_le : s_out - s_in ≤ 4 * (ε_L + D) := by
      have h_in_ge : δ - 2 * η ≤ s_in := le_max_right 0 (δ - 2 * η)
      dsimp [s_out, η] at h_in_ge ⊢
      linarith only [h_in_ge]
    have hs_out_le : s_out ≤ B₀ * X := by
      have hDX : D ≤ D * X := le_mul_of_one_le_right (le_of_lt hD_pos) (le_of_lt hX)
      dsimp [s_out, η, B₀]
      linarith only [hδ_le_X, hε_le_X, hDX]
    have hs_out_pow_le : s_out ^ (n - 1) ≤ B₀ ^ (n - 1) * X ^ (n - 1) := by
      calc s_out ^ (n - 1) ≤ (B₀ * X) ^ (n - 1) :=
            pow_le_pow_left₀ (le_of_lt hs_out_pos) hs_out_le (n - 1)
        _ = B₀ ^ (n - 1) * X ^ (n - 1) := mul_pow B₀ X (n - 1)
    have hXn_eps : X ^ (n - 1) * ε_L = X ^ n / (L : ℝ) := by
      dsimp [ε_L]
      rw [← mul_div_assoc, ← pow_succ, Nat.sub_add_cancel hn_pos]
    have h_rhs_le : (n : ℝ) * s_out ^ (n - 1) * (s_out - s_in) ≤
        4 * (n : ℝ) * B₀ ^ (n - 1) * (X ^ n / (L : ℝ) + D * X ^ (n - 1)) := by
      calc (n : ℝ) * s_out ^ (n - 1) * (s_out - s_in)
          ≤ (n : ℝ) * (B₀ ^ (n - 1) * X ^ (n - 1)) * (4 * (ε_L + D)) := by
            apply mul_le_mul
            · exact mul_le_mul_of_nonneg_left hs_out_pow_le (Nat.cast_nonneg n)
            · exact hs_diff_le
            · exact sub_nonneg.mpr hs_le
            · positivity
        _ = 4 * (n : ℝ) * B₀ ^ (n - 1) * (X ^ (n - 1) * ε_L + D * X ^ (n - 1)) := by ring
        _ = 4 * (n : ℝ) * B₀ ^ (n - 1) * (X ^ n / (L : ℝ) + D * X ^ (n - 1)) := by
            rw [hXn_eps]
    have h_card_VK : (T.card : ℝ) * V_K ≤
        4 * (n : ℝ) * B₀ ^ (n - 1) * (X ^ n / (L : ℝ) + D * X ^ (n - 1)) :=
      le_trans h_card_VK_diff (le_trans h_pow_diff h_rhs_le)
    rw [← le_div_iff₀ hVK_pos] at h_card_VK
    calc (T.card : ℝ)
        ≤ 4 * (n : ℝ) * B₀ ^ (n - 1) * (X ^ n / (L : ℝ) + D * X ^ (n - 1)) / V_K := h_card_VK
      _ = C_lat * (X ^ n / (L : ℝ) + D * X ^ (n - 1)) := by dsimp [C_lat]; ring
  
  have h_s4_bound :
      (D * C_log) * X ^ (n - 1) * (Real.log X + 1) ≤
      c_col * X ^ n * Real.exp (-Real.sqrt (Real.log X) / c_col) := by
    let t : ℝ := Real.sqrt (Real.log X)
    have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg (Real.log X)
    have ht_sq : t ^ 2 = Real.log X := Real.sq_sqrt hlogX_nonneg
    have hL_le_exp : Real.log X ≤ 4 * Real.exp t := by
      have h1 := Real.add_one_le_exp (t / 2)
      have ht_le : t ≤ 2 * Real.exp (t / 2) := by linarith only [h1]
      have hsq : t ^ 2 ≤ (2 * Real.exp (t / 2)) ^ 2 := pow_le_pow_left₀ ht_nonneg ht_le 2
      have hexp_sq : (2 * Real.exp (t / 2)) ^ 2 = 4 * Real.exp t := by
        calc (2 * Real.exp (t / 2)) ^ 2 = 4 * (Real.exp (t / 2) * Real.exp (t / 2)) := by ring
          _ = 4 * Real.exp (t / 2 + t / 2) := by rw [← Real.exp_add]
          _ = 4 * Real.exp t := by rw [add_halves]
      linarith only [ht_sq, hsq, hexp_sq]
    have h1_le_exp_t : 1 ≤ Real.exp t := Real.one_le_exp ht_nonneg
    have hL1_le_exp : Real.log X + 1 ≤ 5 * Real.exp t := by
      linarith only [hL_le_exp, h1_le_exp_t]
    have hexp_t_le : Real.exp t ≤ X * Real.exp 1 * Real.exp (-t) := by
      have h1 : 0 ≤ (t - 1) ^ 2 := sq_nonneg (t - 1)
      have h1_exp : (t - 1) ^ 2 = t ^ 2 - 2 * t + 1 := by ring
      have h2 : t ≤ (Real.log X + 1) + (-t) := by linarith only [h1, h1_exp, ht_sq]
      calc Real.exp t ≤ Real.exp ((Real.log X + 1) + (-t)) := Real.exp_le_exp.mpr h2
        _ = Real.exp (Real.log X) * Real.exp 1 * Real.exp (-t) := by
            rw [Real.exp_add, Real.exp_add]
        _ = X * Real.exp 1 * Real.exp (-t) := by rw [Real.exp_log hX_pos]
    have hL1_le_X : Real.log X + 1 ≤ 5 * X * Real.exp 1 * Real.exp (-t) := by
      calc Real.log X + 1 ≤ 5 * Real.exp t := hL1_le_exp
        _ ≤ 5 * (X * Real.exp 1 * Real.exp (-t)) := by linarith only [hexp_t_le]
        _ = 5 * X * Real.exp 1 * Real.exp (-t) := by ring
    have hexp_ccol : Real.exp (-t) ≤ Real.exp (-t / c_col) := by
      rw [Real.exp_le_exp, neg_div, neg_le_neg_iff]
      exact div_le_self ht_nonneg hc_col_ge1
    have hXn : X ^ (n - 1) * X = X ^ n := by
      rw [← pow_succ, Nat.sub_add_cancel hn_pos]
    calc (D * C_log) * X ^ (n - 1) * (Real.log X + 1)
        ≤ (D * C_log) * X ^ (n - 1) * (5 * X * Real.exp 1 * Real.exp (-t)) :=
          mul_le_mul_of_nonneg_left hL1_le_X (by positivity)
      _ = (5 * Real.exp 1 * D * C_log) * (X ^ (n - 1) * X) * Real.exp (-t) := by ring
      _ = (5 * Real.exp 1 * D * C_log) * X ^ n * Real.exp (-t) := by rw [hXn]
      _ ≤ c_col * X ^ n * Real.exp (-t / c_col) := by
          apply mul_le_mul
          · exact mul_le_mul_of_nonneg_right hc_col_ge5 (by positivity)
          · exact hexp_ccol
          · positivity
          · positivity
  
  have h_mid :
      (T.card : ℝ) * (3 * (n : ℝ) * (Real.log X + 1)) ≤
      C_lat * (X ^ n / (L : ℝ) + D * X ^ (n - 1)) * (3 * (n : ℝ) * (Real.log X + 1)) :=
    mul_le_mul_of_nonneg_right h_s3_bound (by positivity)
  have h_alg :
      C_lat * (X ^ n / (L : ℝ) + D * X ^ (n - 1)) * (3 * (n : ℝ) * (Real.log X + 1)) =
      C_log * X ^ n * ((Real.log X + 1) / (L : ℝ)) +
        (D * C_log) * X ^ (n - 1) * (Real.log X + 1) := by
    dsimp [C_log]
    ring
  have h_term1 :
      C_log * X ^ n * ((Real.log X + 1) / (L : ℝ)) ≤
      c_col * X ^ n * ((Real.log X + 1) / (L : ℝ)) := by
    have h1 : C_log * X ^ n ≤ c_col * X ^ n :=
      mul_le_mul_of_nonneg_right hc_col_ge_Clog (by positivity)
    exact mul_le_mul_of_nonneg_right h1 (by positivity)
  have h_comb :
      C_lat * (X ^ n / (L : ℝ) + D * X ^ (n - 1)) * (3 * (n : ℝ) * (Real.log X + 1)) ≤
      c_col * X ^ n * ((Real.log X + 1) / (L : ℝ)) +
        c_col * X ^ n * Real.exp (-Real.sqrt (Real.log X) / c_col) := by
    rw [h_alg]
    exact add_le_add h_term1 h_s4_bound
  exact le_trans h_s2_bound (le_trans h_mid h_comb)

theorem mitsui_prime_char_decoupled_conical_shell_eq_sub_cone {K : Type u} [Field K] [NumberField K]
    (X : ℝ) (hX : 1 < X)
    (m : ℕ) (hm : 1 ≤ m)
    (R₁ R₀ : ℝ) (hR₀₁ : R₀ ≤ R₁) (hR₁_le : R₁ ≤ X)
    (k : NumberField.mixedEmbedding.index K → Fin (2 * m))
    (w₀ : NumberField.InfinitePlace K)
    (q : Ideal (NumberField.RingOfIntegers K))
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ) :
    (∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          (∀ i : NumberField.mixedEmbedding.index K,
            R₁ *
              ((NumberField.mixedEmbedding.stdBasis K).repr
                  (NumberField.mixedEmbedding K (π : K)) i / w₀ (π : K)) ∈
              Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
          (∀ w : NumberField.InfinitePlace K,
            1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
          w₀ (π : K) ∈ Set.Ico R₀ R₁ ∧
          IsUnit (Ideal.Quotient.mk q π)},
        ψ (Additive.ofMul π.2.2.2.2.2.unit) *
          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
    = (∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧
            (∀ i : NumberField.mixedEmbedding.index K,
              R₁ *
                ((NumberField.mixedEmbedding.stdBasis K).repr
                    (NumberField.mixedEmbedding K (π : K)) i / w₀ (π : K)) ∈
