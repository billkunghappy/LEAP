      have hNq_ge_one : (1 : ℝ) ≤ (N_q : ℝ) := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hNq_ne
      have hNq_pos : (0 : ℝ) < (N_q : ℝ) := lt_of_lt_of_le zero_lt_one hNq_ge_one
      have hNq_mem : (N_q : NumberField.RingOfIntegers K) ∈ q := Ideal.absNorm_mem q
      let E₀ : ℝ := ∑ i : ι, ∑ v : NumberField.InfinitePlace K, v ((b i : NumberField.RingOfIntegers K) : K)
