          exact hw_ne (hl0_ang w)
        obtain ⟨i, hi_ne⟩ := h_unit_or_cplx.resolve_right h_not_cplx
        let η_i : Rˣ := NumberField.Units.fundSystem K i
        let u_i : R := (η_i : R)
