      rw [hΦ_val]
      exact x.2.2 w
    refine ⟨(ζ, ⟨e, he⟩), ?_⟩
    exact Subtype.ext hΦ_val
  let E : NumberField.Units.torsion K × FreeCell ≃ CellGen :=
    Equiv.ofBijective Ψ ⟨hΨ_inj, hΨ_surj⟩
