    have hI_wrapped_iff : ∀ θ : ℝ,
        θ ∈ I_wrapped α₀ p ↔
          θ ∈ Set.Ioo (-Real.pi) Real.pi ∧ (θ ∈ Set.Ico a₁ b₁ ∨ θ ∈ Set.Ico a₂ b₂) := by
      intro θ
      refine ⟨fun hθ => ?_, fun hθ => ?_⟩
      · rcases hθ with ⟨hθ_ioo, h_lo, h_hi⟩
        refine ⟨hθ_ioo, ?_⟩
        rcases lt_or_ge θ θ_split with h_lt | h_ge
        · left
          have h_fl_lo : (m₀ : ℝ) ≤ (θ - α₀) / (2 * Real.pi) := by
            rw [le_div_iff₀ h2pi_pos]
            linarith [hθ_ioo.1]
          have h_fl_hi : (θ - α₀) / (2 * Real.pi) < (m₀ : ℝ) + 1 := by
            rw [div_lt_iff₀ h2pi_pos]
            dsimp [θ_split] at h_lt
            linarith
          have h_fl : Int.floor ((θ - α₀) / (2 * Real.pi)) = m₀ :=
            Int.floor_eq_iff.mpr ⟨h_fl_lo, h_fl_hi⟩
          rw [h_fl] at h_lo h_hi
          have h_lo' : (p : ℝ) * h * (2 * Real.pi) ≤ (θ - α₀) - (m₀ : ℝ) * (2 * Real.pi) := by
            have h1 : (p : ℝ) * h ≤ (θ - α₀ - (m₀ : ℝ) * (2 * Real.pi)) / (2 * Real.pi) := by
              calc (p : ℝ) * h ≤ (θ - α₀) / (2 * Real.pi) - (m₀ : ℝ) := h_lo
                _ = (θ - α₀ - (m₀ : ℝ) * (2 * Real.pi)) / (2 * Real.pi) := by
                  field_simp [h2pi_ne]
            exact (le_div_iff₀ h2pi_pos).mp h1
          have h_hi' : (θ - α₀) - (m₀ : ℝ) * (2 * Real.pi) < ((p : ℝ) + 1) * h * (2 * Real.pi) := by
            have h1 : (θ - α₀ - (m₀ : ℝ) * (2 * Real.pi)) / (2 * Real.pi) < ((p : ℝ) + 1) * h := by
              calc (θ - α₀ - (m₀ : ℝ) * (2 * Real.pi)) / (2 * Real.pi)
                _ = (θ - α₀) / (2 * Real.pi) - (m₀ : ℝ) := by field_simp [h2pi_ne]
                _ < ((p : ℝ) + 1) * h := h_hi
            exact (div_lt_iff₀ h2pi_pos).mp h1
          rw [Set.mem_Ico]
          dsimp [a₁, b₁]
          exact ⟨by linarith, by linarith⟩
        · right
          have h_fl_lo : ((m₀ + 1 : ℤ) : ℝ) ≤ (θ - α₀) / (2 * Real.pi) := by
            push_cast
            rw [le_div_iff₀ h2pi_pos]
            dsimp [θ_split] at h_ge
            linarith
          have h_fl_hi : (θ - α₀) / (2 * Real.pi) < ((m₀ + 1 : ℤ) : ℝ) + 1 := by
            push_cast
            rw [div_lt_iff₀ h2pi_pos]
            linarith [hθ_ioo.2, hm₀_hi]
          have h_fl : Int.floor ((θ - α₀) / (2 * Real.pi)) = m₀ + 1 :=
            Int.floor_eq_iff.mpr ⟨h_fl_lo, h_fl_hi⟩
          rw [h_fl, Int.cast_add, Int.cast_one] at h_lo h_hi
          have h_lo' : (p : ℝ) * h * (2 * Real.pi) ≤ (θ - α₀) - ((m₀ : ℝ) + 1) * (2 * Real.pi) := by
            have h1 : (p : ℝ) * h ≤ (θ - α₀ - ((m₀ : ℝ) + 1) * (2 * Real.pi)) / (2 * Real.pi) := by
              calc (p : ℝ) * h ≤ (θ - α₀) / (2 * Real.pi) - ((m₀ : ℝ) + 1) := h_lo
                _ = (θ - α₀ - ((m₀ : ℝ) + 1) * (2 * Real.pi)) / (2 * Real.pi) := by
                  field_simp [h2pi_ne]
            exact (le_div_iff₀ h2pi_pos).mp h1
          have h_hi' : (θ - α₀) - ((m₀ : ℝ) + 1) * (2 * Real.pi) < ((p : ℝ) + 1) * h * (2 * Real.pi) := by
            have h1 : (θ - α₀ - ((m₀ : ℝ) + 1) * (2 * Real.pi)) / (2 * Real.pi) < ((p : ℝ) + 1) * h := by
              calc (θ - α₀ - ((m₀ : ℝ) + 1) * (2 * Real.pi)) / (2 * Real.pi)
                _ = (θ - α₀) / (2 * Real.pi) - ((m₀ : ℝ) + 1) := by field_simp [h2pi_ne]
                _ < ((p : ℝ) + 1) * h := h_hi
            exact (div_lt_iff₀ h2pi_pos).mp h1
          rw [Set.mem_Ico]
          dsimp [a₂, b₂, a₁, b₁]
          exact ⟨by linarith, by linarith⟩
      · rcases hθ with ⟨hθ_ioo, h_ivl⟩
        refine ⟨hθ_ioo, ?_⟩
        rcases h_ivl with ⟨h_a1, h_b1⟩ | ⟨h_a2, h_b2⟩
        · have h_lt_split : θ < θ_split := lt_of_lt_of_le h_b1 h_b1_le_split
          have h_fl_lo : (m₀ : ℝ) ≤ (θ - α₀) / (2 * Real.pi) := by
            rw [le_div_iff₀ h2pi_pos]
            linarith [hθ_ioo.1]
          have h_fl_hi : (θ - α₀) / (2 * Real.pi) < (m₀ : ℝ) + 1 := by
            rw [div_lt_iff₀ h2pi_pos]
            dsimp [θ_split] at h_lt_split
            linarith
          have h_fl : Int.floor ((θ - α₀) / (2 * Real.pi)) = m₀ :=
            Int.floor_eq_iff.mpr ⟨h_fl_lo, h_fl_hi⟩
          rw [h_fl, Set.mem_Ico]
          have h_eq : (θ - α₀) / (2 * Real.pi) - (m₀ : ℝ) =
              (θ - α₀ - 2 * Real.pi * (m₀ : ℝ)) / (2 * Real.pi) := by
            field_simp [h2pi_ne]
          rw [h_eq, le_div_iff₀ h2pi_pos, div_lt_iff₀ h2pi_pos]
          dsimp [a₁, b₁] at h_a1 h_b1
          exact ⟨by linarith, by linarith⟩
        · have h_ge_split : θ_split ≤ θ := le_trans h_split_le_a2 h_a2
          have h_fl_lo : ((m₀ + 1 : ℤ) : ℝ) ≤ (θ - α₀) / (2 * Real.pi) := by
            push_cast
            rw [le_div_iff₀ h2pi_pos]
            dsimp [θ_split] at h_ge_split
            linarith
          have h_fl_hi : (θ - α₀) / (2 * Real.pi) < ((m₀ + 1 : ℤ) : ℝ) + 1 := by
            push_cast
            rw [div_lt_iff₀ h2pi_pos]
            linarith [hθ_ioo.2, hm₀_hi]
          have h_fl : Int.floor ((θ - α₀) / (2 * Real.pi)) = m₀ + 1 :=
            Int.floor_eq_iff.mpr ⟨h_fl_lo, h_fl_hi⟩
          rw [h_fl, Int.cast_add, Int.cast_one, Set.mem_Ico]
          have h_eq : (θ - α₀) / (2 * Real.pi) - ((m₀ : ℝ) + 1) =
              (θ - α₀ - 2 * Real.pi * ((m₀ : ℝ) + 1)) / (2 * Real.pi) := by
            field_simp [h2pi_ne]
          rw [h_eq, le_div_iff₀ h2pi_pos, div_lt_iff₀ h2pi_pos]
          dsimp [a₂, b₂, a₁, b₁] at h_a2 h_b2
          exact ⟨by linarith, by linarith⟩
    rcases lt_or_ge (-Real.pi) a₁ with h_case1 | h_a1_le
    · have h_set_eq : I_wrapped α₀ p = Set.Ico a₁ b₁ := by
        ext θ
        rw [hI_wrapped_iff, Set.mem_Ioo, Set.mem_Ico, Set.mem_Ico]
        refine ⟨fun h => ?_, fun h => ?_⟩
        · rcases h with ⟨⟨h_gt, h_lt⟩, h1 | h2⟩
          · exact h1
          · dsimp [a₂] at h2
            linarith [h2.1]
        · refine ⟨⟨by linarith [h.1], by linarith [h.2, h_b1_le_split, h_split_le_pi]⟩, Or.inl h⟩
      rw [h_set_eq]
      refine ⟨measurableSet_Ico, ?_⟩
      rw [Real.volume_Ico, h_b1_gt_a1]
    · rcases le_or_gt b₁ (-Real.pi) with h_case2 | h_case3
      · have h_set_eq : I_wrapped α₀ p = Set.Ico a₂ b₂ := by
          ext θ
          rw [hI_wrapped_iff, Set.mem_Ioo, Set.mem_Ico, Set.mem_Ico]
          refine ⟨fun h => ?_, fun h => ?_⟩
          · rcases h with ⟨⟨h_gt, h_lt⟩, h1 | h2⟩
            · linarith [h1.2]
            · exact h2
          · refine ⟨⟨by linarith [h.1, h_split_le_a2, hm₀_hi], by dsimp [b₂] at h; linarith [h.2]⟩, Or.inr h⟩
        rw [h_set_eq]
        refine ⟨measurableSet_Ico, ?_⟩
        rw [Real.volume_Ico, h_b2_gt_a2]
      · have h_set_eq : I_wrapped α₀ p = Set.Ioo (-Real.pi) b₁ ∪ Set.Ico a₂ Real.pi := by
          ext θ
          rw [hI_wrapped_iff, Set.mem_union, Set.mem_Ioo, Set.mem_Ioo, Set.mem_Ico, Set.mem_Ico, Set.mem_Ico]
          refine ⟨fun h => ?_, fun h => ?_⟩
          · rcases h with ⟨⟨h_gt, h_lt⟩, h1 | h2⟩
            · exact Or.inl ⟨h_gt, h1.2⟩
            · exact Or.inr ⟨h2.1, h_lt⟩
          · rcases h with ⟨h_gt, h_lt⟩ | ⟨h_ge, h_lt⟩
            · refine ⟨⟨h_gt, by linarith [h_lt, h_b1_le_split, h_split_le_pi]⟩, Or.inl ⟨by linarith, h_lt⟩⟩
            · refine ⟨⟨by linarith [h_ge, h_split_le_a2, hm₀_hi], h_lt⟩, Or.inr ⟨h_ge, by dsimp [b₂]; linarith⟩⟩
        rw [h_set_eq]
        refine ⟨measurableSet_Ioo.union measurableSet_Ico, ?_⟩
        have h_disj : Disjoint (Set.Ioo (-Real.pi) b₁) (Set.Ico a₂ Real.pi) := by
          rw [Set.disjoint_left]
          intro θ h1 h2
          linarith [h1.2, h2.1, h_b1_le_split, h_split_le_a2]
        rw [MeasureTheory.measure_union h_disj measurableSet_Ico, Real.volume_Ioo, Real.volume_Ico]
        have h_len1 : 0 ≤ b₁ - -Real.pi := by linarith
        have h_len2 : 0 ≤ Real.pi - a₂ := by dsimp [a₂]; linarith
        rw [← ENNReal.ofReal_add h_len1 h_len2]
        have h_sum_len : (b₁ - -Real.pi) + (Real.pi - a₂) = 2 * Real.pi * h := by
          dsimp [a₂]
          linarith [h_b1_gt_a1]
        rw [h_sum_len]
  let I₁ : (Fin r → ℤ) → NumberField.InfinitePlace K → Set ℝ :=
    fun q₁ w =>
      if hw : w ≠ w₀ then
        Set.Ico ((q₁ (e ⟨w, hw⟩) : ℝ) * h) (((q₁ (e ⟨w, hw⟩) : ℝ) + 1) * h)
      else
        Set.Ioo (0 : ℝ) 1
  let I₂ : (ι_real → Fin 2) → ((Fin r → ℤ) × (ι_complex → ℤ)) → NumberField.InfinitePlace K → Set ℝ :=
    fun ξ q w =>
      if hw : w.IsReal then
        Set.Ioo ((ξ ⟨w, hw⟩ : ℕ) : ℝ) (((ξ ⟨w, hw⟩ : ℕ) : ℝ) + 1)
      else
        I_wrapped (α_p q.1 ⟨w, (NumberField.InfinitePlace.isReal_or_isComplex w).resolve_left hw⟩)
          (q.2 ⟨w, (NumberField.InfinitePlace.isReal_or_isComplex w).resolve_left hw⟩)
  let Q_hat : (Σ _ : ι_real → Fin 2, (Fin r → ℤ) × (ι_complex → ℤ)) →
      Set (NumberField.InfinitePlace K → ℝ × ℝ) :=
    fun p => Set.univ.pi (fun w : NumberField.InfinitePlace K => I₁ p.2.1 w ×ˢ I₂ p.1 p.2 w)
  have hI₁_meas : ∀ (q₁ : Fin r → ℤ) (w : NumberField.InfinitePlace K), MeasurableSet (I₁ q₁ w) := by
    intro q₁ w
    dsimp [I₁]
    by_cases hw : w ≠ w₀
    · rw [dif_pos hw]
      exact measurableSet_Ico
    · rw [dif_neg hw]
      exact measurableSet_Ioo
  have hI₂_meas : ∀ (p : Σ _ : ι_real → Fin 2, (Fin r → ℤ) × (ι_complex → ℤ)),
      p.2 ∈ B_grid → ∀ w : NumberField.InfinitePlace K, MeasurableSet (I₂ p.1 p.2 w) := by
    intro p hp w
    dsimp [I₂]
    split_ifs with hw
    · exact measurableSet_Ioo
    · have h_mem : p.2.2 ⟨w, (NumberField.InfinitePlace.isReal_or_isComplex w).resolve_left hw⟩ ∈
          Finset.Ico (0 : ℤ) (K_δ : ℤ) :=
        Fintype.mem_piFinset.mp (Finset.mem_product.mp hp).2 _
      exact (hI_wrapped_meas_vol _ _ h_mem).1
  have hQ_hat_meas : ∀ (p : Σ _ : ι_real → Fin 2, (Fin r → ℤ) × (ι_complex → ℤ)),
      p.2 ∈ B_grid → MeasurableSet (Q_hat p) := by
    intro p hp
    exact MeasurableSet.univ_pi (fun w => (hI₁_meas p.2.1 w).prod (hI₂_meas p hp w))
  let v_box : ℝ := (2 * Real.pi) ^ r₂ * h ^ (r + r₂)
  have hv_box_nonneg : 0 ≤ v_box := by dsimp [v_box]; positivity
  have hI₁_prod_vol : ∀ (q₁ : Fin r → ℤ),
      (∏ w : NumberField.InfinitePlace K, MeasureTheory.volume (I₁ q₁ w)) =
        ENNReal.ofReal (h ^ r) := by
    intro q₁
    rw [Fintype.prod_eq_mul_prod_subtype_ne
      (fun w : NumberField.InfinitePlace K => MeasureTheory.volume (I₁ q₁ w)) w₀]
    have hw₀ : MeasureTheory.volume (I₁ q₁ w₀) = 1 := by
      dsimp [I₁]
      rw [dif_neg (not_not.mpr rfl), Real.volume_Ioo, sub_zero, ENNReal.ofReal_one]
    have h_ne : ∀ w : {w : NumberField.InfinitePlace K // w ≠ w₀},
        MeasureTheory.volume (I₁ q₁ w.1) = ENNReal.ofReal h := by
      intro w
      dsimp [I₁]
      rw [dif_pos w.2, Real.volume_Ico]
      have h_diff : ((q₁ (e ⟨w.1, w.2⟩) : ℝ) + 1) * h - (q₁ (e ⟨w.1, w.2⟩) : ℝ) * h = h := by ring
      rw [h_diff]
    rw [hw₀, one_mul]
    simp_rw [h_ne]
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_congr e, Fintype.card_fin,
      ← ENNReal.ofReal_pow hh_nonneg]
  have hI₂_prod_vol : ∀ (p : Σ _ : ι_real → Fin 2, (Fin r → ℤ) × (ι_complex → ℤ)),
      p.2 ∈ B_grid →
        (∏ w : NumberField.InfinitePlace K, MeasureTheory.volume (I₂ p.1 p.2 w)) =
          ENNReal.ofReal ((2 * Real.pi * h) ^ r₂) := by
    intro p hp
    rw [NumberField.InfinitePlace.prod_eq_prod_mul_prod
      (fun w : NumberField.InfinitePlace K => MeasureTheory.volume (I₂ p.1 p.2 w))]
    have h_real : ∀ w : ι_real, MeasureTheory.volume (I₂ p.1 p.2 w.1) = 1 := by
      intro w
      dsimp [I₂]
      rw [dif_pos w.2, Real.volume_Ioo, add_sub_cancel_left, ENNReal.ofReal_one]
    have h_complex : ∀ w : ι_complex,
        MeasureTheory.volume (I₂ p.1 p.2 w.1) = ENNReal.ofReal (2 * Real.pi * h) := by
      intro w
      have hnr : ¬ w.1.IsReal := NumberField.InfinitePlace.not_isReal_iff_isComplex.mpr w.2
      dsimp [I₂]
      rw [dif_neg hnr]
      have h_sub : (⟨w.1, (NumberField.InfinitePlace.isReal_or_isComplex w.1).resolve_left hnr⟩ : ι_complex) = w :=
        Subtype.ext rfl
      rw [h_sub]
      have h_mem : p.2.2 w ∈ Finset.Ico (0 : ℤ) (K_δ : ℤ) :=
        Fintype.mem_piFinset.mp (Finset.mem_product.mp hp).2 w
      exact (hI_wrapped_meas_vol _ _ h_mem).2
    simp_rw [h_real, Finset.prod_const_one, one_mul, h_complex]
    rw [Finset.prod_const, Finset.card_univ, ← ENNReal.ofReal_pow h2pih_nonneg]
  have hQ_hat_vol : ∀ (p : Σ _ : ι_real → Fin 2, (Fin r → ℤ) × (ι_complex → ℤ)),
      p.2 ∈ B_grid →
        MeasureTheory.volume (Q_hat p) = ENNReal.ofReal v_box := by
    intro p hp
    dsimp [Q_hat]
    have h_pi : MeasureTheory.volume (Set.univ.pi (fun w : NumberField.InfinitePlace K => I₁ p.2.1 w ×ˢ I₂ p.1 p.2 w)) =
        ∏ w : NumberField.InfinitePlace K, MeasureTheory.volume (I₁ p.2.1 w ×ˢ I₂ p.1 p.2 w) :=
      MeasureTheory.Measure.pi_pi (fun _ => MeasureTheory.volume) _
    have h_prod : ∀ w : NumberField.InfinitePlace K,
        MeasureTheory.volume (I₁ p.2.1 w ×ˢ I₂ p.1 p.2 w) =
          MeasureTheory.volume (I₁ p.2.1 w) * MeasureTheory.volume (I₂ p.1 p.2 w) := by
      intro w
      rw [MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod]
    rw [h_pi]
    simp_rw [h_prod]
    rw [Finset.prod_mul_distrib, hI₁_prod_vol p.2.1, hI₂_prod_vol p hp,
      ← ENNReal.ofReal_mul (pow_nonneg hh_nonneg r)]
    have h_eq : h ^ r * (2 * Real.pi * h) ^ r₂ = v_box := by
      dsimp [v_box]
      rw [mul_pow, pow_add]
      ring
    rw [h_eq]
  have hQ_hat_disj :
      (Set.univ : Set (Σ _ : ι_real → Fin 2, (Fin r → ℤ) × (ι_complex → ℤ))).PairwiseDisjoint Q_hat := by
    intro p _ p' _ hne
    rw [Function.onFun, Set.disjoint_left]
    intro z hzp hzp'
    apply hne
    have h_xi_eq : p.1 = p'.1 := by
      funext w_r
      have hz1 := (hzp w_r.1 (Set.mem_univ _)).2
      have hz2 := (hzp' w_r.1 (Set.mem_univ _)).2
      dsimp [I₂] at hz1 hz2
      rw [dif_pos w_r.2] at hz1 hz2
      rcases hz1 with ⟨h_lo1, h_hi1⟩
      rcases hz2 with ⟨h_lo2, h_hi2⟩
      have h_lt1 : ((p.1 w_r : ℕ) : ℝ) < (((p'.1 w_r : ℕ) + 1 : ℕ) : ℝ) := by
        push_cast
        linarith
      have h_lt2 : ((p'.1 w_r : ℕ) : ℝ) < (((p.1 w_r : ℕ) + 1 : ℕ) : ℝ) := by
        push_cast
        linarith
      have hn1 : (p.1 w_r : ℕ) < (p'.1 w_r : ℕ) + 1 := Nat.cast_lt.mp h_lt1
      have hn2 : (p'.1 w_r : ℕ) < (p.1 w_r : ℕ) + 1 := Nat.cast_lt.mp h_lt2
      exact Fin.ext (by omega)
    have h_q1_eq : p.2.1 = p'.2.1 := by
      funext j
      let w_j := e.symm j
      have hz1 := (hzp w_j.1 (Set.mem_univ _)).1
      have hz2 := (hzp' w_j.1 (Set.mem_univ _)).1
      dsimp [I₁] at hz1 hz2
      rw [dif_pos w_j.2, e.apply_symm_apply] at hz1 hz2
      rcases hz1 with ⟨h_lo1, h_hi1⟩
      rcases hz2 with ⟨h_lo2, h_hi2⟩
      have h_lt1 : (p.2.1 j : ℝ) * h < ((p'.2.1 j + 1 : ℤ) : ℝ) * h := by
        push_cast
        linarith
      have h_lt2 : (p'.2.1 j : ℝ) * h < ((p.2.1 j + 1 : ℤ) : ℝ) * h := by
        push_cast
        linarith
      have h_lt1' : (p.2.1 j : ℝ) < ((p'.2.1 j + 1 : ℤ) : ℝ) := lt_of_mul_lt_mul_right h_lt1 hh_nonneg
      have h_lt2' : (p'.2.1 j : ℝ) < ((p.2.1 j + 1 : ℤ) : ℝ) := lt_of_mul_lt_mul_right h_lt2 hh_nonneg
      have hz_int1 : p.2.1 j < p'.2.1 j + 1 := Int.cast_lt.mp h_lt1'
      have hz_int2 : p'.2.1 j < p.2.1 j + 1 := Int.cast_lt.mp h_lt2'
      omega
    have h_q2_eq : p.2.2 = p'.2.2 := by
      funext w_c
      have hnr : ¬ w_c.1.IsReal := NumberField.InfinitePlace.not_isReal_iff_isComplex.mpr w_c.2
      have hz1 := (hzp w_c.1 (Set.mem_univ _)).2
      have hz2 := (hzp' w_c.1 (Set.mem_univ _)).2
      dsimp [I₂] at hz1 hz2
      rw [dif_neg hnr] at hz1 hz2
      have h_sub : (⟨w_c.1, (NumberField.InfinitePlace.isReal_or_isComplex w_c.1).resolve_left hnr⟩ : ι_complex) = w_c :=
        Subtype.ext rfl
      rw [h_sub] at hz1 hz2
      rw [← h_q1_eq] at hz2
      exact hI_wrapped_disj (α_p p.2.1 w_c) (p.2.2 w_c) (p'.2.2 w_c) (z w_c.1).2 hz1 hz2
    rcases p with ⟨ξ, q₁, q₂⟩
    rcases p' with ⟨ξ', q₁', q₂'⟩
    dsimp at h_xi_eq h_q1_eq h_q2_eq
    subst h_xi_eq h_q1_eq h_q2_eq
    rfl
  let S'_outer : (ι_real → Fin 2) → Finset ((Fin r → ℤ) × (ι_complex → ℤ)) :=
    fun ξ => S_outer_slice ξ ∩ B_grid
  let U_main : Finset (Σ _ : ι_real → Fin 2, (Fin r → ℤ) × (ι_complex → ℤ)) :=
    (Finset.univ : Finset (ι_real → Fin 2)).sigma S_main_slice
  let U_outer : Finset (Σ _ : ι_real → Fin 2, (Fin r → ℤ) × (ι_complex → ℤ)) :=
    (Finset.univ : Finset (ι_real → Fin 2)).sigma S'_outer
  have h_inner_sub : (⋃ p ∈ U_main, Q_hat p) ⊆ Ω := by
    intro z hz
    rw [Set.mem_iUnion₂] at hz
    rcases hz with ⟨⟨ξ, q⟩, hp_mem, hzQ⟩
    have hq_main : q ∈ S_main_slice ξ := (Finset.mem_sigma.mp hp_mem).2
    refine h_in ξ q hq_main z ?_ ?_ ?_ ?_
    · have hz₀ := (hzQ w₀ (Set.mem_univ w₀)).1
      dsimp [I₁] at hz₀
      rwa [dif_neg (not_not.mpr rfl)] at hz₀
    · intro j
      have hzj := (hzQ (e.symm j).1 (Set.mem_univ _)).1
      dsimp [I₁] at hzj
      rw [dif_pos (e.symm j).2, e.apply_symm_apply] at hzj
      rcases hzj with ⟨h_lo, h_hi⟩
      change |(z (e.symm j).1).1 - (q.1 j : ℝ) * h| ≤ h
      exact abs_le.mpr ⟨by linarith, by linarith⟩
    · intro w
      have hzw := (hzQ w.1 (Set.mem_univ _)).2
      dsimp [I₂] at hzw
      rwa [dif_pos w.2] at hzw
