      term_cell_Z (e_cell xpm).1 = term_cell_Y xpm + (δ : ℂ) * term_ψ_cell_Y xpm := by
    intro xpm
    dsimp [term_cell_Z, term_cell_Y, term_ψ_cell_Y, e_cell]
    rw [h_log_split xpm.1.2.1 xpm.1.2.2]
    push_cast
    ring
  have h_sum_cell_filter :
      ∑ xpm ∈ Finset.univ.filter P_cell, term_cell_Z xpm =
      (∑' xpm : D_cell_Y, term_cell_Y xpm) +
        (δ : ℂ) * (∑' xpm : D_cell_Y, term_ψ_cell_Y xpm) := by
    have h1 : ∑ xpm ∈ Finset.univ.filter P_cell, term_cell_Z xpm =
        ∑' xpm : {xpm : D_cell_Z // P_cell xpm}, term_cell_Z xpm.1 := by
      rw [tsum_fintype]
      exact Finset.sum_subtype (Finset.univ.filter P_cell) (fun _ => by simp) term_cell_Z
    have h2 : (∑' xpm : {xpm : D_cell_Z // P_cell xpm}, term_cell_Z xpm.1) =
        ∑' xpm : D_cell_Y, term_cell_Z (e_cell xpm).1 :=
      (Equiv.tsum_eq e_cell (fun xpm : {xpm : D_cell_Z // P_cell xpm} => term_cell_Z xpm.1)).symm
    rw [h1, h2, tsum_congr h_term_cell_split, tsum_fintype, tsum_fintype, tsum_fintype,
      Finset.sum_add_distrib, ← Finset.mul_sum]
  have h_sum_cell_Z : (∑' xpm : D_cell_Z, term_cell_Z xpm) =
      (∑ xpm ∈ Finset.univ.filter P_cell, term_cell_Z xpm) +
      (∑ xpm ∈ Finset.univ.filter (fun xpm : D_cell_Z => ¬ P_cell xpm), term_cell_Z xpm) := by
    rw [tsum_fintype]
    exact (Finset.sum_filter_add_sum_filter_not Finset.univ P_cell term_cell_Z).symm
  have h_lhs_eq :
      ((∑' xpm : D_cell_Z, term_cell_Z xpm) - (∑' xpm : D_cell_Y, term_cell_Y xpm)) -
        (δ : ℂ) * (∑' xpm : D_cell_Y, term_ψ_cell_Y xpm) =
      ∑ xpm ∈ Finset.univ.filter (fun xpm : D_cell_Z => ¬ P_cell xpm), term_cell_Z xpm := by
    rw [h_sum_cell_Z, h_sum_cell_filter]
    ring
  let term_all_Z : D_all_Z → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal) *
      Real.log ((Real.exp δ * Y) / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
  let term_all_Y : D_all_Y → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal) *
      Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
  let term_ψ_all_Y : D_all_Y → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal)
  have h_term_all_split : ∀ pm : D_all_Y,
      term_all_Z (e_all pm).1 = term_all_Y pm + δ * term_ψ_all_Y pm := by
    intro pm
    dsimp [term_all_Z, term_all_Y, term_ψ_all_Y, e_all]
    rw [h_log_split pm.1.1 pm.1.2]
    ring
  have h_sum_all_filter :
      ∑ pm ∈ Finset.univ.filter P_all, term_all_Z pm =
      (∑' pm : D_all_Y, term_all_Y pm) +
        δ * (∑' pm : D_all_Y, term_ψ_all_Y pm) := by
    have h1 : ∑ pm ∈ Finset.univ.filter P_all, term_all_Z pm =
        ∑' pm : {pm : D_all_Z // P_all pm}, term_all_Z pm.1 := by
      rw [tsum_fintype]
      exact Finset.sum_subtype (Finset.univ.filter P_all) (fun _ => by simp) term_all_Z
    have h2 : (∑' pm : {pm : D_all_Z // P_all pm}, term_all_Z pm.1) =
        ∑' pm : D_all_Y, term_all_Z (e_all pm).1 :=
      (Equiv.tsum_eq e_all (fun pm : {pm : D_all_Z // P_all pm} => term_all_Z pm.1)).symm
    rw [h1, h2, tsum_congr h_term_all_split, tsum_fintype, tsum_fintype, tsum_fintype,
      Finset.sum_add_distrib, ← Finset.mul_sum]
  have h_sum_all_Z : (∑' pm : D_all_Z, term_all_Z pm) =
      (∑ pm ∈ Finset.univ.filter P_all, term_all_Z pm) +
      (∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_all_Z pm) := by
    rw [tsum_fintype]
    exact (Finset.sum_filter_add_sum_filter_not Finset.univ P_all term_all_Z).symm
  have h_rhs_eq :
      ((∑' pm : D_all_Z, term_all_Z pm) - (∑' pm : D_all_Y, term_all_Y pm)) -
        δ * (∑' pm : D_all_Y, term_ψ_all_Y pm) =
      ∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_all_Z pm := by
    rw [h_sum_all_Z, h_sum_all_filter]
    ring
  have h_term_all_Z_nonneg : ∀ pm : D_all_Z, 0 ≤ term_all_Z pm := by
    intro pm
    dsimp [term_all_Z]
    apply mul_nonneg (Real.log_natCast_nonneg _)
    apply Real.log_nonneg
    have hk_pos : (0 : ℝ) < (Ideal.absNorm pm.1.1.asIdeal : ℝ) := by
      have := h_norm_ge_two pm.1.1
      positivity
    have hpow_pos : (0 : ℝ) < (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 :=
      pow_pos hk_pos pm.1.2
    exact (one_le_div₀ hpow_pos).mpr pm.2.2
  let S_cell_short : Finset D_cell_Z := Finset.univ.filter (fun xpm : D_cell_Z => ¬ P_cell xpm)
  let S_all_short : Finset D_all_Z := Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm)
  let proj : D_cell_Z → D_all_Z := fun xpm => ⟨xpm.1.2, ⟨xpm.2.1, xpm.2.2.2.1⟩⟩
  have h_maps : ∀ xpm ∈ S_cell_short, proj xpm ∈ S_all_short := by
    intro xpm hxpm
    rw [Finset.mem_filter] at hxpm ⊢
    exact ⟨Finset.mem_univ _, hxpm.2⟩
  have h_term_cell_Z_norm : ∀ xpm : D_cell_Z,
      ‖term_cell_Z xpm‖ = term_all_Z (proj xpm) := by
    intro xpm
    have h_nonneg : 0 ≤ term_all_Z (proj xpm) := h_term_all_Z_nonneg (proj xpm)
    dsimp [term_cell_Z, term_all_Z, proj] at h_nonneg ⊢
    rw [norm_mul, AddChar.norm_apply, one_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_nonneg h_nonneg]
  let Fiber (pm : D_all_Z) : Finset D_cell_Z :=
    S_cell_short.filter (fun xpm : D_cell_Z => proj xpm = pm)
  have h_fiber_card_le : ∀ pm : D_all_Z, ((Fiber pm).card : ℝ) ≤ B := by
    intro pm
    haveI : Finite (LogGen pm.1.1 pm.1.2) := h_logGen_fin pm
    let f_fib : ↥(Fiber pm) → LogGen pm.1.1 pm.1.2 := fun xpm =>
      ⟨xpm.1.1.1, by
        have h_eq : proj xpm.1 = pm := (Finset.mem_filter.mp xpm.2).2
        have h_val : xpm.1.1.2 = pm.1 := congrArg Subtype.val h_eq
        have h_p : xpm.1.1.2.1 = pm.1.1 := congrArg Prod.fst h_val
        have h_ν : xpm.1.1.2.2 = pm.1.2 := congrArg Prod.snd h_val
        refine ⟨?_, xpm.1.2.2.2.2.2.1⟩
        rw [← h_p, ← h_ν]
        exact xpm.1.2.2.1⟩
    have hf_fib_inj : Function.Injective f_fib := by
      intro a b hab
      have hx : a.1.1.1 = b.1.1.1 := congrArg Subtype.val hab
      have ha : proj a.1 = pm := (Finset.mem_filter.mp a.2).2
      have hb : proj b.1 = pm := (Finset.mem_filter.mp b.2).2
      have h_pm : a.1.1.2 = b.1.1.2 :=
        (congrArg Subtype.val ha).trans (congrArg Subtype.val hb).symm
      apply Subtype.ext
      apply Subtype.ext
      exact Prod.ext hx h_pm
    have h_card_nat : (Fiber pm).card ≤ Nat.card (LogGen pm.1.1 pm.1.2) := by
      calc (Fiber pm).card
        _ = Fintype.card ↥(Fiber pm) := (Fintype.card_coe (Fiber pm)).symm
        _ = Nat.card ↥(Fiber pm) := (Nat.card_eq_fintype_card).symm
        _ ≤ Nat.card (LogGen pm.1.1 pm.1.2) := Nat.card_le_card_of_injective f_fib hf_fib_inj
    have h_card_real : ((Fiber pm).card : ℝ) ≤ (Nat.card (LogGen pm.1.1 pm.1.2) : ℝ) := by
      exact_mod_cast h_card_nat
    exact le_trans h_card_real (hB pm.1.1 pm.1.2 pm.2.1)
  have h_fiber_sum_le : ∀ pm ∈ S_all_short,
      (∑ xpm ∈ Fiber pm, term_all_Z (proj xpm)) ≤ B * term_all_Z pm := by
    intro pm _
    have h_congr : (∑ xpm ∈ Fiber pm, term_all_Z (proj xpm)) =
        ∑ _xpm ∈ Fiber pm, term_all_Z pm := by
      refine Finset.sum_congr rfl (fun xpm hxpm => ?_)
      rw [(Finset.mem_filter.mp hxpm).2]
    rw [h_congr, Finset.sum_const, nsmul_eq_mul]
    exact mul_le_mul_of_nonneg_right (h_fiber_card_le pm) (h_term_all_Z_nonneg pm)
  rw [h_lhs_eq, h_rhs_eq]
  calc ‖∑ xpm ∈ S_cell_short, term_cell_Z xpm‖
    _ ≤ ∑ xpm ∈ S_cell_short, ‖term_cell_Z xpm‖ :=
      norm_sum_le _ _
    _ = ∑ xpm ∈ S_cell_short, term_all_Z (proj xpm) :=
      Finset.sum_congr rfl (fun xpm _ => h_term_cell_Z_norm xpm)
    _ = ∑ pm ∈ S_all_short, ∑ xpm ∈ Fiber pm, term_all_Z (proj xpm) :=
      (Finset.sum_fiberwise_of_maps_to h_maps (fun xpm => term_all_Z (proj xpm))).symm
    _ ≤ ∑ pm ∈ S_all_short, (B * term_all_Z pm) :=
      Finset.sum_le_sum h_fiber_sum_le
    _ = B * ∑ pm ∈ S_all_short, term_all_Z pm :=
      (Finset.mul_sum S_all_short term_all_Z B).symm

theorem mitsui_primePowers_ge_riesz_backward_diff {K : Type u} [Field K] [NumberField K]
    (Y δ : ℝ) (hY : 0 < Y) (hδ : 0 < δ) :
    (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
        Real.log (Ideal.absNorm pm.1.1.asIdeal) *
          Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)))
      - (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Real.exp (-δ) * Y},
          Real.log (Ideal.absNorm pm.1.1.asIdeal) *
            Real.log ((Real.exp (-δ) * Y) / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)))
      ≤ δ * (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
          Real.log (Ideal.absNorm pm.1.1.asIdeal)) :=
by
  classical
  set Z_minus : ℝ := Real.exp (-δ) * Y
  have hexp_le_one : Real.exp (-δ) ≤ 1 := by
    rw [Real.exp_le_one_iff]
    linarith
  have hZ_le_Y : Z_minus ≤ Y :=
    mul_le_of_le_one_left (le_of_lt hY) hexp_le_one
  have hZ_pos : 0 < Z_minus := mul_pos (Real.exp_pos (-δ)) hY
  have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p.asIdeal := by
    intro p
    have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    omega
  have h_pm_bounds : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
      1 ≤ m → (Ideal.absNorm p.asIdeal : ℝ) ^ m ≤ Y →
      Ideal.absNorm p.asIdeal ≤ ⌊Y⌋₊ ∧ m ≤ ⌊Y⌋₊ := by
    intro p m hm h_pow
    have hk2 : 2 ≤ Ideal.absNorm p.asIdeal := h_norm_ge_two p
    have h_pow_nat : ((Ideal.absNorm p.asIdeal ^ m : ℕ) : ℝ) ≤ Y := by exact_mod_cast h_pow
    have h_km_le : Ideal.absNorm p.asIdeal ^ m ≤ ⌊Y⌋₊ := Nat.le_floor h_pow_nat
    have hm_ne : m ≠ 0 := by omega
    have hk_le_km : Ideal.absNorm p.asIdeal ≤ Ideal.absNorm p.asIdeal ^ m :=
      Nat.le_self_pow hm_ne (Ideal.absNorm p.asIdeal)
    have hm_le_2m : m ≤ 2 ^ m := (Nat.lt_pow_self (by decide : 1 < 2)).le
    have h2m_le_km : 2 ^ m ≤ Ideal.absNorm p.asIdeal ^ m := Nat.pow_le_pow_left hk2 m
    exact ⟨le_trans hk_le_km h_km_le, le_trans (le_trans hm_le_2m h2m_le_km) h_km_le⟩
  let D_Y := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y}
  let D_Z := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Real.exp (-δ) * Y}
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊}
  let S_prod : Set (Ideal (NumberField.RingOfIntegers K) × ℕ) :=
    S_id ×ˢ {m : ℕ | m ≤ ⌊Y⌋₊}
  have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Y⌋₊
  have hSprod_fin : S_prod.Finite := hSid_fin.prod (Set.finite_le_nat ⌊Y⌋₊)
  haveI : Finite S_prod := hSprod_fin
  let f_Y : D_Y → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2), h_pm_bounds pm.1.1 pm.1.2 pm.2.1 pm.2.2⟩
  have hf_Y_inj : Function.Injective f_Y := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    dsimp [f_Y] at hval
    apply Subtype.ext; apply Prod.ext
    · exact IsDedekindDomain.HeightOneSpectrum.ext (congrArg Prod.fst hval)
    · exact congrArg (Prod.snd : Ideal (NumberField.RingOfIntegers K) × ℕ → ℕ) hval
  haveI : Finite D_Y := Finite.of_injective f_Y hf_Y_inj
  letI : Fintype D_Y := Fintype.ofFinite D_Y
  let f_Z : D_Z → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2),
      h_pm_bounds pm.1.1 pm.1.2 pm.2.1 (le_trans pm.2.2 hZ_le_Y)⟩
  have hf_Z_inj : Function.Injective f_Z := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    dsimp [f_Z] at hval
    apply Subtype.ext; apply Prod.ext
    · exact IsDedekindDomain.HeightOneSpectrum.ext (congrArg Prod.fst hval)
    · exact congrArg (Prod.snd : Ideal (NumberField.RingOfIntegers K) × ℕ → ℕ) hval
  haveI : Finite D_Z := Finite.of_injective f_Z hf_Z_inj
  letI : Fintype D_Z := Fintype.ofFinite D_Z
  have h_log_split : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
      Real.log (Y / ((Ideal.absNorm p.asIdeal : ℝ) ^ m)) =
      Real.log ((Real.exp (-δ) * Y) / ((Ideal.absNorm p.asIdeal : ℝ) ^ m)) + δ := by
    intro p m
    have hk_pos : (0 : ℝ) < (Ideal.absNorm p.asIdeal : ℝ) := by
      have := h_norm_ge_two p
      positivity
    have hpow_pos : (0 : ℝ) < (Ideal.absNorm p.asIdeal : ℝ) ^ m := pow_pos hk_pos m
    rw [Real.log_div (ne_of_gt hY) (ne_of_gt hpow_pos),
      Real.log_div (ne_of_gt hZ_pos) (ne_of_gt hpow_pos),
      Real.log_mul (ne_of_gt (Real.exp_pos (-δ))) (ne_of_gt hY),
      Real.log_exp]
    ring
  let Q : D_Y → Prop := fun pm =>
    (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 ≤ Real.exp (-δ) * Y
  let e_Z : D_Z ≃ {pm : D_Y // Q pm} :=
    { toFun := fun pm => ⟨⟨pm.1, ⟨pm.2.1, le_trans pm.2.2 hZ_le_Y⟩⟩, pm.2.2⟩
      invFun := fun pm => ⟨pm.1.1, ⟨pm.1.2.1, pm.2⟩⟩
      left_inv := fun pm => by apply Subtype.ext; rfl
      right_inv := fun pm => by apply Subtype.ext; apply Subtype.ext; rfl }
  let term_Y : D_Y → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal) *
      Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
  let term_Z : D_Z → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal) *
      Real.log ((Real.exp (-δ) * Y) / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
  let term_ψ_Y : D_Y → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal)
  have h_term_split : ∀ pm : D_Z,
      term_Y (e_Z pm).1 = term_Z pm + δ * term_ψ_Y (e_Z pm).1 := by
    intro pm
    dsimp [term_Y, term_Z, term_ψ_Y, e_Z]
    rw [h_log_split pm.1.1 pm.1.2]
    ring
  have h_sum_filter_Y :
      ∑ pm ∈ Finset.univ.filter Q, term_Y pm =
      (∑' pm : D_Z, term_Z pm) +
        δ * (∑ pm ∈ Finset.univ.filter Q, term_ψ_Y pm) := by
    have h1 : ∑ pm ∈ Finset.univ.filter Q, term_Y pm =
        ∑' pm : {pm : D_Y // Q pm}, term_Y pm.1 := by
      rw [tsum_fintype]
      exact Finset.sum_subtype (Finset.univ.filter Q) (fun _ => by simp) term_Y
    have h2 : (∑' pm : {pm : D_Y // Q pm}, term_Y pm.1) =
        ∑' pm : D_Z, term_Y (e_Z pm).1 :=
      (Equiv.tsum_eq e_Z (fun pm : {pm : D_Y // Q pm} => term_Y pm.1)).symm
    have h3 : ∑ pm ∈ Finset.univ.filter Q, term_ψ_Y pm =
        ∑' pm : D_Z, term_ψ_Y (e_Z pm).1 := by
      have h3a : ∑ pm ∈ Finset.univ.filter Q, term_ψ_Y pm =
          ∑' pm : {pm : D_Y // Q pm}, term_ψ_Y pm.1 := by
        rw [tsum_fintype]
        exact Finset.sum_subtype (Finset.univ.filter Q) (fun _ => by simp) term_ψ_Y
      rw [h3a]
      exact (Equiv.tsum_eq e_Z (fun pm : {pm : D_Y // Q pm} => term_ψ_Y pm.1)).symm
    rw [h1, h2, h3, tsum_congr h_term_split, tsum_fintype, tsum_fintype, tsum_fintype,
      Finset.sum_add_distrib, ← Finset.mul_sum]
  have h_sum_Y : (∑' pm : D_Y, term_Y pm) =
      (∑ pm ∈ Finset.univ.filter Q, term_Y pm) +
      (∑ pm ∈ Finset.univ.filter (fun pm : D_Y => ¬ Q pm), term_Y pm) := by
    rw [tsum_fintype]
    exact (Finset.sum_filter_add_sum_filter_not Finset.univ Q term_Y).symm
  have h_lhs_eq :
      (∑' pm : D_Y, term_Y pm) - (∑' pm : D_Z, term_Z pm) =
      δ * (∑ pm ∈ Finset.univ.filter Q, term_ψ_Y pm) +
        (∑ pm ∈ Finset.univ.filter (fun pm : D_Y => ¬ Q pm), term_Y pm) := by
    rw [h_sum_Y, h_sum_filter_Y]
    ring
  have h_rhs_eq :
      δ * (∑' pm : D_Y, term_ψ_Y pm) =
      δ * (∑ pm ∈ Finset.univ.filter Q, term_ψ_Y pm) +
        (∑ pm ∈ Finset.univ.filter (fun pm : D_Y => ¬ Q pm), δ * term_ψ_Y pm) := by
    have h_ψ_split : (∑' pm : D_Y, term_ψ_Y pm) =
        (∑ pm ∈ Finset.univ.filter Q, term_ψ_Y pm) +
        (∑ pm ∈ Finset.univ.filter (fun pm : D_Y => ¬ Q pm), term_ψ_Y pm) := by
      rw [tsum_fintype]
      exact (Finset.sum_filter_add_sum_filter_not Finset.univ Q term_ψ_Y).symm
    rw [h_ψ_split, mul_add]
    congr 1
    exact Finset.mul_sum _ _ _
  have h_short_le : ∀ pm ∈ Finset.univ.filter (fun pm : D_Y => ¬ Q pm),
      term_Y pm ≤ δ * term_ψ_Y pm := by
    intro pm hpm
    have hnotQ : ¬ Q pm := (Finset.mem_filter.mp hpm).2
    have h_gt : Real.exp (-δ) * Y < (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 :=
      not_le.mp hnotQ
    have hk_pos : (0 : ℝ) < (Ideal.absNorm pm.1.1.asIdeal : ℝ) := by
      have := h_norm_ge_two pm.1.1
      positivity
    have hpow_pos : (0 : ℝ) < (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 :=
      pow_pos hk_pos pm.1.2
    have hdiv_pos : 0 < Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2) :=
      div_pos hY hpow_pos
    have hdiv_le_exp : Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2) ≤ Real.exp δ := by
      rw [div_le_iff₀ hpow_pos]
      have hY_eq : Y = Real.exp δ * (Real.exp (-δ) * Y) := by
        rw [← mul_assoc, ← Real.exp_add, add_neg_cancel, Real.exp_zero, one_mul]
      calc Y = Real.exp δ * (Real.exp (-δ) * Y) := hY_eq
        _ ≤ Real.exp δ * ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2) :=
            mul_le_mul_of_nonneg_left (le_of_lt h_gt) (le_of_lt (Real.exp_pos δ))
    have hlog_le : Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) ≤ δ := by
      have h1 := Real.log_le_log hdiv_pos hdiv_le_exp
      rwa [Real.log_exp] at h1
    have hlogN_nonneg : 0 ≤ Real.log (Ideal.absNorm pm.1.1.asIdeal) :=
      Real.log_natCast_nonneg _
    dsimp [term_Y, term_ψ_Y]
    calc Real.log (Ideal.absNorm pm.1.1.asIdeal) *
          Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
      _ ≤ Real.log (Ideal.absNorm pm.1.1.asIdeal) * δ :=
          mul_le_mul_of_nonneg_left hlog_le hlogN_nonneg
      _ = δ * Real.log (Ideal.absNorm pm.1.1.asIdeal) := mul_comm _ _
  have h_sum_short_le :
      (∑ pm ∈ Finset.univ.filter (fun pm : D_Y => ¬ Q pm), term_Y pm) ≤
      (∑ pm ∈ Finset.univ.filter (fun pm : D_Y => ¬ Q pm), δ * term_ψ_Y pm) :=
    Finset.sum_le_sum h_short_le
  change (∑' pm : D_Y, term_Y pm) - (∑' pm : D_Z, term_Z pm) ≤ δ * (∑' pm : D_Y, term_ψ_Y pm)
  linarith [h_lhs_eq, h_rhs_eq, h_sum_short_le]

theorem mitsui_riesz_primePowers_eq_sum_Icc {K : Type u} [Field K] [NumberField K]
    (Y : ℝ) (hY : 0 < Y) :
    (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
        Real.log (Ideal.absNorm pm.1.1.asIdeal) *
          Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))) =
      ∑ n ∈ Finset.Icc 1 ⌊Y⌋₊,
        (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n},
            Real.log (Ideal.absNorm pm.1.1.asIdeal)) *
          Real.log (Y / (n : ℝ)) :=
by
  classical
  have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p.asIdeal := by
    intro p
    have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    omega
  have h_nat_bounds : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (m N : ℕ), 1 ≤ m → Ideal.absNorm p.asIdeal ^ m ≤ N →
      (Ideal.absNorm p.asIdeal ≤ N ∧ m ≤ N) ∧ 1 ≤ Ideal.absNorm p.asIdeal ^ m := by
    intro p m N hm h_pow
    have hk2 : 2 ≤ Ideal.absNorm p.asIdeal := h_norm_ge_two p
    have hm_ne : m ≠ 0 := by omega
    have hk_le_km : Ideal.absNorm p.asIdeal ≤ Ideal.absNorm p.asIdeal ^ m :=
      Nat.le_self_pow hm_ne (Ideal.absNorm p.asIdeal)
    have hm_le_2m : m ≤ 2 ^ m := (Nat.lt_pow_self (by decide : 1 < 2)).le
    have h2m_le_km : 2 ^ m ≤ Ideal.absNorm p.asIdeal ^ m := Nat.pow_le_pow_left hk2 m
    exact ⟨⟨le_trans hk_le_km h_pow, le_trans (le_trans hm_le_2m h2m_le_km) h_pow⟩,
      le_trans hm (le_trans hm_le_2m h2m_le_km)⟩
  let D_Y := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y}
  let F (n : ℕ) := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧ Ideal.absNorm pm.1.asIdeal ^ pm.2 = n}
  let S_prod : Set (Ideal (NumberField.RingOfIntegers K) × ℕ) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊} ×ˢ {m : ℕ | m ≤ ⌊Y⌋₊}
  have hSprod_fin : S_prod.Finite :=
    (Ideal.finite_setOf_absNorm_le ⌊Y⌋₊).prod (Set.finite_le_nat ⌊Y⌋₊)
  have h_pm_floor : ∀ pm : D_Y, Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2 ≤ ⌊Y⌋₊ := by
    intro pm
    have h_pow_nat : ((Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2 : ℕ) : ℝ) ≤ Y := by
      exact_mod_cast pm.2.2
    exact Nat.le_floor h_pow_nat
  haveI : Finite S_prod := hSprod_fin
  let f_Y : D_Y → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2), (h_nat_bounds pm.1.1 pm.1.2 ⌊Y⌋₊ pm.2.1 (h_pm_floor pm)).1⟩
  have hf_Y_inj : Function.Injective f_Y := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    dsimp [f_Y] at hval
    apply Subtype.ext; apply Prod.ext
    · exact IsDedekindDomain.HeightOneSpectrum.ext (congrArg Prod.fst hval)
    · exact congrArg (Prod.snd : Ideal (NumberField.RingOfIntegers K) × ℕ → ℕ) hval
  haveI : Finite D_Y := Finite.of_injective f_Y hf_Y_inj
  letI : Fintype D_Y := Fintype.ofFinite D_Y
  let g : D_Y → ℕ := fun pm => Ideal.absNorm pm.1.1.asIdeal ^ pm.1.2
  let term_Y : D_Y → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal) *
      Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
  let term_ψ_Y : D_Y → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal)
  have hg : ∀ pm ∈ (Finset.univ : Finset D_Y), g pm ∈ Finset.Icc 1 ⌊Y⌋₊ := by
    intro pm _
    rw [Finset.mem_Icc]
    exact ⟨(h_nat_bounds pm.1.1 pm.1.2 ⌊Y⌋₊ pm.2.1 (h_pm_floor pm)).2, h_pm_floor pm⟩
  have h_lhs : (∑' pm : D_Y, term_Y pm) =
      ∑ n ∈ Finset.Icc 1 ⌊Y⌋₊, ∑ pm ∈ Finset.univ with g pm = n, term_Y pm := by
    rw [tsum_fintype]
    exact (Finset.sum_fiberwise_of_maps_to hg term_Y).symm
  change (∑' pm : D_Y, term_Y pm) =
    ∑ n ∈ Finset.Icc 1 ⌊Y⌋₊,
      (∑' pm : F n, Real.log (Ideal.absNorm pm.1.1.asIdeal)) * Real.log (Y / (n : ℝ))
  rw [h_lhs]
  refine Finset.sum_congr rfl (fun n hn => ?_)
  have hn_le_floor : n ≤ ⌊Y⌋₊ := (Finset.mem_Icc.mp hn).2
  have hn_le_Y : (n : ℝ) ≤ Y := by
    have h1 : (n : ℝ) ≤ (⌊Y⌋₊ : ℝ) := by exact_mod_cast hn_le_floor
    exact le_trans h1 (Nat.floor_le (le_of_lt hY))
  have h_factor :
      (∑ pm ∈ Finset.univ with g pm = n, term_Y pm) =
      (∑ pm ∈ Finset.univ with g pm = n, term_ψ_Y pm) * Real.log (Y / (n : ℝ)) := by
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl (fun pm hpm => ?_)
    have hg_eq : g pm = n := (Finset.mem_filter.mp hpm).2
    have h_cast : ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2) = (n : ℝ) := by
      exact_mod_cast hg_eq
    dsimp [term_Y, term_ψ_Y]
    rw [h_cast]
  rw [h_factor]
  congr 1
  let e_n : F n ≃ {pm : D_Y // g pm = n} :=
    { toFun := fun pm => ⟨⟨pm.1, ⟨pm.2.1, by
        have h_cast : ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2) = (n : ℝ) := by
          exact_mod_cast pm.2.2
        linarith⟩⟩, pm.2.2⟩
      invFun := fun q => ⟨q.1.1, ⟨q.1.2.1, q.2⟩⟩
      left_inv := fun pm => by apply Subtype.ext; rfl
      right_inv := fun q => by apply Subtype.ext; apply Subtype.ext; rfl }
  have h_sub : (∑ pm ∈ Finset.univ with g pm = n, term_ψ_Y pm) =
      ∑' q : {pm : D_Y // g pm = n}, term_ψ_Y q.1 := by
    rw [tsum_fintype]
    exact Finset.sum_subtype (Finset.univ.filter (fun pm : D_Y => g pm = n))
      (fun _ => by simp) term_ψ_Y
  rw [h_sub]
  exact (Equiv.tsum_eq e_n (fun q : {pm : D_Y // g pm = n} => term_ψ_Y q.1)).symm

theorem mitsui_riesz_vonMangoldt_eq_vertical_integral (Y : ℝ) (hY : 1 < Y) :
    (∑ n ∈ Finset.Icc 1 ⌊Y⌋₊,
        ArithmeticFunction.vonMangoldt n * Real.log (Y / (n : ℝ))) =
      (1 / (2 * Real.pi)) *
        (∫ t : ℝ,
          ((Y : ℂ) ^ (2 + (t : ℂ) * Complex.I) / (2 + (t : ℂ) * Complex.I) ^ 2) *
            (-deriv riemannZeta (2 + (t : ℂ) * Complex.I) /
              riemannZeta (2 + (t : ℂ) * Complex.I))).re :=
by
  have hY_pos : 0 < Y := by linarith
  have h_int_four_add_sq : MeasureTheory.Integrable (fun t : ℝ => (4 + t ^ 2)⁻¹) := by
    refine integrable_inv_one_add_sq.mono' ?_ ?_
    · exact (continuous_const.add (continuous_pow 2)).inv₀ (fun t => by positivity) |>.aestronglyMeasurable
    · refine Filter.Eventually.of_forall (fun t => ?_)
      rw [Real.norm_of_nonneg (by positivity)]
      exact inv_anti₀ (by positivity) (by linarith)
  have h_norm_sq : ∀ t : ℝ, ‖(2 + (t : ℂ) * Complex.I) ^ 2‖ = 4 + t ^ 2 := by
    intro t
    rw [norm_pow, ← Complex.normSq_eq_norm_sq]
    have hre : (2 + (t : ℂ) * Complex.I).re = 2 := by simp
    have him : (2 + (t : ℂ) * Complex.I).im = t := by simp
    rw [Complex.normSq_apply, hre, him]
    ring
  have h_neg_log_le_rpow : ∀ {t r : ℝ}, 0 < t → 0 < r → -Real.log t ≤ (1 / r) * t ^ (-r) := by
    intro t r ht hr
    have h1 : Real.log (t ^ (-r)) ≤ t ^ (-r) - 1 :=
      Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos ht (-r))
    have h2 : Real.log (t ^ (-r)) = r * (-Real.log t) := by
      rw [Real.log_rpow ht]
      ring
    rw [h2] at h1
    have h3 : r * (-Real.log t) ≤ t ^ (-r) := by linarith
    rw [← le_div_iff₀' hr] at h3
    linarith [show t ^ (-r) / r = (1 / r) * t ^ (-r) by ring]
  have h_mellin : ∀ s : ℂ, 0 < s.re →
      HasMellin (fun t : ℝ => ((max 0 (-Real.log t) : ℝ) : ℂ)) s (1 / s ^ 2) := by
    intro s hs
    let f : ℝ → ℂ := fun t => ((max 0 (-Real.log t) : ℝ) : ℂ)
    let g : ℝ → ℂ := fun t => (t : ℂ) ^ (s - 1) * ((-Real.log t : ℝ) : ℂ)
    have hs_ne : s ≠ 0 := by
      intro h; rw [h] at hs; simp at hs
    have hf_Ioc : ∀ t ∈ Set.Ioc (0 : ℝ) 1, (t : ℂ) ^ (s - 1) • f t = g t := by
      intro t ht
      dsimp [f, g]
      rw [max_eq_right]
      linarith [Real.log_nonpos (le_of_lt ht.1) ht.2]
    have hf_Ioi : ∀ t ∈ Set.Ioi (1 : ℝ), (t : ℂ) ^ (s - 1) • f t = 0 := by
      intro t ht
      dsimp [f]
      have hlog : 0 ≤ Real.log t := Real.log_nonneg (le_of_lt ht)
      rw [max_eq_left (by linarith), Complex.ofReal_zero, mul_zero]
    have hg_norm_le : ∀ t ∈ Set.Ioc (0 : ℝ) 1,
        ‖g t‖ ≤ (2 / s.re) * t ^ (s.re / 2 - 1) := by
      intro t ht
      dsimp [g]
      rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos ht.1, Complex.sub_re, Complex.one_re,
        Complex.norm_real, Real.norm_of_nonneg (by linarith [Real.log_nonpos (le_of_lt ht.1) ht.2])]
      have h_log := h_neg_log_le_rpow ht.1 (half_pos hs)
      have h_mul := mul_le_mul_of_nonneg_left h_log (Real.rpow_nonneg (le_of_lt ht.1) (s.re - 1))
      have h_rpow : t ^ (s.re - 1) * ((1 / (s.re / 2)) * t ^ (-(s.re / 2))) =
          (2 / s.re) * (t ^ (s.re - 1) * t ^ (-(s.re / 2))) := by ring
      rw [h_rpow, ← Real.rpow_add ht.1] at h_mul
      convert h_mul using 2
      ring
    have hg_contOn : ContinuousOn g (Set.Ioc 0 1) := by
      intro t ht
      refine ContinuousAt.continuousWithinAt ?_
      refine (ContinuousAt.cpow Complex.continuous_ofReal.continuousAt continuousAt_const ?_).mul ?_
      · rw [Complex.mem_slitPlane_iff]; exact Or.inl ht.1
      · exact Complex.continuous_ofReal.continuousAt.comp (Real.continuousAt_log (ne_of_gt ht.1)).neg
    have hg_int_Ioc : MeasureTheory.IntegrableOn g (Set.Ioc 0 1) MeasureTheory.volume := by
      have h_dom : IntervalIntegrable (fun t : ℝ => (2 / s.re) * t ^ (s.re / 2 - 1)) MeasureTheory.volume 0 1 :=
        (intervalIntegral.intervalIntegrable_rpow' (by linarith : -1 < s.re / 2 - 1)).const_mul (2 / s.re)
      rw [intervalIntegrable_iff_integrableOn_Ioc_of_le zero_le_one] at h_dom
      refine h_dom.mono' (hg_contOn.aestronglyMeasurable measurableSet_Ioc) ?_
      exact MeasureTheory.ae_restrict_of_forall_mem measurableSet_Ioc hg_norm_le
    have h_int_Ioc : MeasureTheory.IntegrableOn (fun t : ℝ => (t : ℂ) ^ (s - 1) • f t) (Set.Ioc 0 1) MeasureTheory.volume :=
      hg_int_Ioc.congr_fun (fun t ht => (hf_Ioc t ht).symm) measurableSet_Ioc
    have h_int_Ioi : MeasureTheory.IntegrableOn (fun t : ℝ => (t : ℂ) ^ (s - 1) • f t) (Set.Ioi 1) MeasureTheory.volume :=
      (MeasureTheory.integrableOn_zero).congr_fun (fun t ht => (hf_Ioi t ht).symm) measurableSet_Ioi
    have h_mc : MellinConvergent f s := by
      rw [MellinConvergent, ← Set.Ioc_union_Ioi_eq_Ioi zero_le_one]
      exact h_int_Ioc.union h_int_Ioi
    let G : ℝ → ℂ := fun t => (t : ℂ) ^ s * (1 / s ^ 2 - (Real.log t : ℂ) / s)
    have hG_deriv : ∀ x ∈ Set.Ioo (0 : ℝ) 1, HasDerivAt G (g x) x := by
      intro x hx
      have hx_ne : x ≠ 0 := ne_of_gt hx.1
      have hx_ne_C : (x : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hx_ne
      have h1 : HasDerivAt (fun y : ℝ => (y : ℂ) ^ s) (s * (x : ℂ) ^ (s - 1)) x :=
        hasDerivAt_ofReal_cpow_const hx_ne hs_ne
      have h2 : HasDerivAt (fun y : ℝ => 1 / s ^ 2 - (Real.log y : ℂ) / s) (0 - ((x⁻¹ : ℝ) : ℂ) / s) x := by
        refine (hasDerivAt_const x (1 / s ^ 2)).sub ?_
        exact ((Real.hasDerivAt_log hx_ne).ofReal_comp).div_const s
      have hmul := h1.mul h2
      convert hmul using 1
      dsimp [g]
      have h_cpow : (x : ℂ) ^ s = (x : ℂ) ^ (s - 1) * (x : ℂ) := by
        conv_lhs => rw [show s = (s - 1) + 1 by ring, Complex.cpow_add _ _ hx_ne_C, Complex.cpow_one]
      rw [h_cpow, Complex.ofReal_inv, Complex.ofReal_neg]
      field_simp [hs_ne, hx_ne_C]
      ring
    have hG_tendsto_zero : Filter.Tendsto G (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
      rw [tendsto_zero_iff_norm_tendsto_zero]
      let B : ℝ → ℝ := fun t => ‖1 / s ^ 2‖ * t ^ s.re + (2 / s.re / ‖s‖) * t ^ (s.re / 2)
      have hB_tendsto : Filter.Tendsto B (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
        have h1 : Filter.Tendsto (fun t : ℝ => t ^ s.re) (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
          have hc : Filter.Tendsto (fun t : ℝ => t ^ s.re) (nhdsWithin 0 (Set.Ioi 0)) (nhds ((0 : ℝ) ^ s.re)) :=
            (Real.continuousAt_rpow_const 0 s.re (Or.inr (le_of_lt hs))).continuousWithinAt.tendsto
          rwa [Real.zero_rpow (ne_of_gt hs)] at hc
        have h2 : Filter.Tendsto (fun t : ℝ => t ^ (s.re / 2)) (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
          have hc : Filter.Tendsto (fun t : ℝ => t ^ (s.re / 2)) (nhdsWithin 0 (Set.Ioi 0)) (nhds ((0 : ℝ) ^ (s.re / 2))) :=
            (Real.continuousAt_rpow_const 0 (s.re / 2) (Or.inr (le_of_lt (half_pos hs)))).continuousWithinAt.tendsto
          rwa [Real.zero_rpow (ne_of_gt (half_pos hs))] at hc
        have h3 := (h1.const_mul ‖1 / s ^ 2‖).add (h2.const_mul (2 / s.re / ‖s‖))
        rwa [mul_zero, mul_zero, add_zero] at h3
      refine squeeze_zero' (Filter.Eventually.of_forall (fun t => norm_nonneg (G t))) ?_ hB_tendsto
      filter_upwards [Ioo_mem_nhdsGT zero_lt_one] with t ht
      dsimp [G, B]
      rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos ht.1]
      have h_sub : ‖1 / s ^ 2 - (Real.log t : ℂ) / s‖ ≤ ‖1 / s ^ 2‖ + (-Real.log t) / ‖s‖ := by
        calc ‖1 / s ^ 2 - (Real.log t : ℂ) / s‖
          _ ≤ ‖1 / s ^ 2‖ + ‖(Real.log t : ℂ) / s‖ := norm_sub_le _ _
          _ = ‖1 / s ^ 2‖ + (-Real.log t) / ‖s‖ := by
            rw [norm_div (Real.log t : ℂ) s, Complex.norm_real,
              Real.norm_of_nonpos (Real.log_nonpos (le_of_lt ht.1) (le_of_lt ht.2))]
      have h_log := h_neg_log_le_rpow ht.1 (half_pos hs)
      have h_div : (-Real.log t) / ‖s‖ ≤ ((2 / s.re) / ‖s‖) * t ^ (-(s.re / 2)) := by
        calc (-Real.log t) / ‖s‖ ≤ ((1 / (s.re / 2)) * t ^ (-(s.re / 2))) / ‖s‖ :=
              div_le_div_of_nonneg_right h_log (norm_nonneg s)
          _ = ((2 / s.re) / ‖s‖) * t ^ (-(s.re / 2)) := by ring
      have h_tot : ‖1 / s ^ 2 - (Real.log t : ℂ) / s‖ ≤ ‖1 / s ^ 2‖ + ((2 / s.re) / ‖s‖) * t ^ (-(s.re / 2)) :=
        by linarith
      calc t ^ s.re * ‖1 / s ^ 2 - (Real.log t : ℂ) / s‖
        _ ≤ t ^ s.re * (‖1 / s ^ 2‖ + ((2 / s.re) / ‖s‖) * t ^ (-(s.re / 2))) :=
          mul_le_mul_of_nonneg_left h_tot (Real.rpow_nonneg (le_of_lt ht.1) _)
        _ = ‖1 / s ^ 2‖ * t ^ s.re + (2 / s.re / ‖s‖) * (t ^ s.re * t ^ (-(s.re / 2))) := by ring
        _ = ‖1 / s ^ 2‖ * t ^ s.re + (2 / s.re / ‖s‖) * t ^ (s.re / 2) := by
          rw [← Real.rpow_add ht.1]
          congr 2; ring
    have hG_tendsto_one : Filter.Tendsto G (nhdsWithin 1 (Set.Iio 1)) (nhds (1 / s ^ 2)) := by
      have hG_cont : ContinuousAt G 1 := by
        refine (ContinuousAt.cpow Complex.continuous_ofReal.continuousAt continuousAt_const ?_).mul ?_
        · rw [Complex.mem_slitPlane_iff]; exact Or.inl zero_lt_one
        · refine continuousAt_const.sub ((Complex.continuous_ofReal.continuousAt.comp (Real.continuousAt_log one_ne_zero)).div_const s)
      have hG1 : G 1 = 1 / s ^ 2 := by simp [G]
      rw [← hG1]
      exact hG_cont.continuousWithinAt.tendsto
    have hg_int : IntervalIntegrable g MeasureTheory.volume 0 1 :=
      (intervalIntegrable_iff_integrableOn_Ioc_of_le zero_le_one).mpr hg_int_Ioc
    have h_ftc := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_tendsto zero_lt_one hG_deriv hg_int hG_tendsto_zero hG_tendsto_one
    rw [sub_zero, intervalIntegral.integral_of_le zero_le_one] at h_ftc
    refine ⟨h_mc, ?_⟩
    rw [mellin, ← Set.Ioc_union_Ioi_eq_Ioi zero_le_one,
      MeasureTheory.setIntegral_union Set.Ioc_disjoint_Ioi_same measurableSet_Ioi h_int_Ioc h_int_Ioi,
      MeasureTheory.setIntegral_congr_fun measurableSet_Ioc hf_Ioc,
      MeasureTheory.setIntegral_eq_zero_of_forall_eq_zero hf_Ioi,
      add_zero, h_ftc]
  have h_vert_single : ∀ (u : ℝ), 0 < u →
      (1 / (2 * Real.pi)) *
        (∫ t : ℝ,
          ((u : ℂ) ^ (2 + (t : ℂ) * Complex.I) / (2 + (t : ℂ) * Complex.I) ^ 2)).re =
        max 0 (Real.log u) := by
    intro u hu
    let f : ℝ → ℂ := fun t => ((max 0 (-Real.log t) : ℝ) : ℂ)
    have hu_inv : 0 < u⁻¹ := inv_pos.mpr hu
    have h_mc : MellinConvergent f ((2 : ℝ) : ℂ) := (h_mellin 2 (by norm_num)).1
    have h_mellin_line : ∀ t : ℝ, mellin f ((2 : ℝ) + (t : ℂ) * Complex.I) =
        1 / (2 + (t : ℂ) * Complex.I) ^ 2 := by
      intro t
      have hre : 0 < ((2 : ℝ) + (t : ℂ) * Complex.I).re := by simp
      simpa using (h_mellin ((2 : ℝ) + (t : ℂ) * Complex.I) hre).2
    have h_vi : Complex.VerticalIntegrable (mellin f) 2 MeasureTheory.volume := by
      rw [Complex.VerticalIntegrable.eq_def]
      have h_eq : (fun y : ℝ => mellin f ((2 : ℝ) + (y : ℂ) * Complex.I)) =
          (fun y : ℝ => (1 / (2 + (y : ℂ) * Complex.I) ^ 2 : ℂ)) := by
        ext y; exact h_mellin_line y
      rw [h_eq]
      refine h_int_four_add_sq.mono' ?_ ?_
      · refine (continuous_const.div ?_ (fun y => ?_)).aestronglyMeasurable
        · exact (continuous_const.add (Complex.continuous_ofReal.mul continuous_const)).pow 2
        · rw [← norm_ne_zero_iff, h_norm_sq]; positivity
      · refine Filter.Eventually.of_forall (fun y => ?_)
        rw [norm_div, norm_one, h_norm_sq, one_div]
    have h_cont : ContinuousAt f u⁻¹ := by
      refine Complex.continuous_ofReal.continuousAt.comp ?_
      refine continuousAt_const.max ?_
      exact (Real.continuousAt_log (ne_of_gt hu_inv)).neg
    have h_inv := mellinInv_mellin_eq 2 f hu_inv h_mc h_vi h_cont
    rw [mellinInv.eq_def] at h_inv
    have h_integrand : ∀ y : ℝ,
        ((u⁻¹ : ℝ) : ℂ) ^ (-((2 : ℝ) + (y : ℂ) * Complex.I)) •
          mellin f ((2 : ℝ) + (y : ℂ) * Complex.I) =
        ((u : ℂ) ^ (2 + (y : ℂ) * Complex.I) / (2 + (y : ℂ) * Complex.I) ^ 2) := by
      intro y
      rw [h_mellin_line y, smul_eq_mul, Complex.ofReal_inv]
      have h_arg : (u : ℂ).arg ≠ Real.pi := by
        rw [Complex.arg_ofReal_of_nonneg (le_of_lt hu)]
        exact Real.pi_ne_zero.symm
      rw [Complex.inv_cpow _ _ h_arg, Complex.cpow_neg, inv_inv]
      simp [div_eq_mul_inv]
    have h_int_eq : (∫ y : ℝ, ((u⁻¹ : ℝ) : ℂ) ^ (-((2 : ℝ) + (y : ℂ) * Complex.I)) •
          mellin f ((2 : ℝ) + (y : ℂ) * Complex.I)) =
        ∫ y : ℝ, ((u : ℂ) ^ (2 + (y : ℂ) * Complex.I) / (2 + (y : ℂ) * Complex.I) ^ 2) :=
      MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall h_integrand)
    rw [h_int_eq] at h_inv
    have h_re := congrArg Complex.re h_inv
    simp only [f, Complex.real_smul, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
      zero_mul, sub_zero, Real.log_inv, neg_neg] at h_re
    exact h_re
  let a : ℕ → ℝ := fun n => ArithmeticFunction.vonMangoldt n
  have ha0 : a 0 = 0 := ArithmeticFunction.map_zero
  have ha_sum : LSeriesSummable (fun n => (a n : ℂ)) 2 :=
    ArithmeticFunction.LSeriesSummable_vonMangoldt (by norm_num)
  let s : ℝ → ℂ := fun t => 2 + (t : ℂ) * Complex.I
  let F : ℕ → ℝ → ℂ := fun n t =>
    ((Y : ℂ) ^ s t / s t ^ 2) * LSeries.term (fun k => (a k : ℂ)) (s t) n
  have hs_re : ∀ t : ℝ, (s t).re = 2 := fun t => by simp [s]
  have hs_sq_ne : ∀ t : ℝ, s t ^ 2 ≠ 0 := fun t => by
    rw [← norm_ne_zero_iff, h_norm_sq]; positivity
  have hF_eq : ∀ (n : ℕ) (t : ℝ),
      F n t = (a n : ℂ) * (((Y / (n : ℝ) : ℝ) : ℂ) ^ s t / s t ^ 2) := by
    intro n t
    rcases eq_or_ne n 0 with rfl | hn
    · simp [F, LSeries.term_zero, ha0]
    · dsimp [F]
      rw [LSeries.term_of_ne_zero hn]
      have hn_pos : (0 : ℝ) < (n : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hn)
      have hn_ne_R : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
      have hn_ne_C : (n : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hn
      have hn_cpow_ne : (n : ℂ) ^ s t ≠ 0 := by
        rw [Ne, Complex.cpow_eq_zero_iff, not_and_or]
        exact Or.inl hn_ne_C
      have hY_split : (Y : ℂ) ^ s t = (((Y / (n : ℝ) : ℝ) : ℂ) ^ s t) * (n : ℂ) ^ s t := by
        have h1 : Y = (Y / (n : ℝ)) * (n : ℝ) := (div_mul_cancel₀ Y hn_ne_R).symm
        conv_lhs => rw [h1, Complex.ofReal_mul]
        rw [Complex.mul_cpow_ofReal_nonneg (div_nonneg (le_of_lt hY_pos) (le_of_lt hn_pos)) (le_of_lt hn_pos)]
        simp
      rw [hY_split]
      field_simp [hs_sq_ne t, hn_cpow_ne]
  have hF_norm : ∀ (n : ℕ) (t : ℝ),
      ‖F n t‖ = (Y ^ 2 * ‖LSeries.term (fun k => (a k : ℂ)) 2 n‖) * (4 + t ^ 2)⁻¹ := by
    intro n t
    dsimp [F]
    rw [norm_mul, norm_div, h_norm_sq]
    have hY_norm : ‖(Y : ℂ) ^ s t‖ = Y ^ 2 := by
      rw [Complex.norm_cpow_eq_rpow_re_of_pos hY_pos, hs_re t]
      norm_num
    have hterm_norm : ‖LSeries.term (fun k => (a k : ℂ)) (s t) n‖ =
        ‖LSeries.term (fun k => (a k : ℂ)) 2 n‖ := by
      rcases eq_or_ne n 0 with rfl | hn
      · simp [LSeries.term_zero]
      · rw [LSeries.term_of_ne_zero hn, LSeries.term_of_ne_zero hn, norm_div, norm_div]
        have hn_pos : (0 : ℝ) < (n : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hn)
        have h1 : ‖(n : ℂ) ^ s t‖ = (n : ℝ) ^ (s t).re := by
          simpa using Complex.norm_cpow_eq_rpow_re_of_pos hn_pos (s t)
        have h2 : ‖(n : ℂ) ^ (2 : ℂ)‖ = (n : ℝ) ^ (2 : ℂ).re := by
          simpa using Complex.norm_cpow_eq_rpow_re_of_pos hn_pos (2 : ℂ)
        rw [h1, h2, hs_re t]
        simp
    rw [hY_norm, hterm_norm]
    ring
  have hF_cont : ∀ n : ℕ, Continuous (F n) := by
    intro n
    have hs_cont : Continuous s := continuous_const.add (Complex.continuous_ofReal.mul continuous_const)
    have hY_cont : Continuous (fun t : ℝ => (Y : ℂ) ^ s t / s t ^ 2) := by
      refine (hs_cont.const_cpow (Or.inl (Complex.ofReal_ne_zero.mpr (ne_of_gt hY_pos)))).div ?_ hs_sq_ne
      exact hs_cont.pow 2
    rcases eq_or_ne n 0 with rfl | hn
    · have : F 0 = fun _ => 0 := by ext t; simp [F, LSeries.term_zero]
      rw [this]; exact continuous_const
    · have : F n = fun t => ((Y : ℂ) ^ s t / s t ^ 2) * ((a n : ℂ) / (n : ℂ) ^ s t) := by
        ext t; dsimp [F]; rw [LSeries.term_of_ne_zero hn]
      rw [this]
      have hn_ne_C : (n : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hn
      refine hY_cont.mul (continuous_const.div ?_ (fun t => ?_))
      · exact hs_cont.const_cpow (Or.inl hn_ne_C)
      · rw [Ne, Complex.cpow_eq_zero_iff, not_and_or]; exact Or.inl hn_ne_C
  have hF_int : ∀ n : ℕ, MeasureTheory.Integrable (F n) := by
    intro n
    refine (h_int_four_add_sq.const_mul (Y ^ 2 * ‖LSeries.term (fun k => (a k : ℂ)) 2 n‖)).mono' ?_ ?_
    · exact (hF_cont n).aestronglyMeasurable
    · exact Filter.Eventually.of_forall (fun t => le_of_eq (hF_norm n t))
  have hF_sum_norm : Summable (fun n : ℕ => ∫ t : ℝ, ‖F n t‖) := by
    have h_eq : (fun n : ℕ => ∫ t : ℝ, ‖F n t‖) =
        fun n : ℕ => (Y ^ 2 * ∫ t : ℝ, (4 + t ^ 2)⁻¹) * ‖LSeries.term (fun k => (a k : ℂ)) 2 n‖ := by
      ext n
      simp_rw [hF_norm n, MeasureTheory.integral_const_mul]
      ring
    rw [h_eq]
    exact ha_sum.norm.mul_left _
  have h_rhs_eq_tsum :
      (1 / (2 * Real.pi)) *
        (∫ t : ℝ,
          ((Y : ℂ) ^ s t / s t ^ 2) *
            (-deriv riemannZeta (s t) / riemannZeta (s t))).re =
      ∑' n : ℕ, a n * max 0 (Real.log (Y / (n : ℝ))) := by
    have h_integrand : (fun t : ℝ => ((Y : ℂ) ^ s t / s t ^ 2) * (-deriv riemannZeta (s t) / riemannZeta (s t))) =
        fun t : ℝ => ∑' n : ℕ, F n t := by
      ext t
      have hre : 1 < (s t).re := by rw [hs_re t]; norm_num
      rw [← ArithmeticFunction.LSeries_vonMangoldt_eq_deriv_riemannZeta_div hre, LSeries.eq_def, ← tsum_mul_left]
    have h_int_tsum : (∫ t : ℝ, ((Y : ℂ) ^ s t / s t ^ 2) * (-deriv riemannZeta (s t) / riemannZeta (s t))) =
        ∑' n : ℕ, ∫ t : ℝ, F n t := by
      rw [h_integrand]
      exact (MeasureTheory.integral_tsum_of_summable_integral_norm hF_int hF_sum_norm).symm
    have hF_sum_int : Summable (fun n : ℕ => ∫ t : ℝ, F n t) :=
      Summable.of_norm_bounded hF_sum_norm (fun n => MeasureTheory.norm_integral_le_integral_norm (F n))
    rw [h_int_tsum, Complex.re_tsum hF_sum_int, ← tsum_mul_left]
    refine tsum_congr (fun n => ?_)
    have h_n : (∫ t : ℝ, F n t) = (a n : ℂ) * ∫ t : ℝ, (((Y / (n : ℝ) : ℝ) : ℂ) ^ s t / s t ^ 2) := by
      simp_rw [hF_eq n, MeasureTheory.integral_const_mul]
    rw [h_n, Complex.re_ofReal_mul]
    rcases eq_or_ne n 0 with rfl | hn
    · simp [ha0]
    · have hn_pos : (0 : ℝ) < (n : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hn)
      have hYn_pos : 0 < Y / (n : ℝ) := div_pos hY_pos hn_pos
      have h_eval := h_vert_single (Y / (n : ℝ)) hYn_pos
      dsimp [s]
      rw [← h_eval]
      ring
  have h_trunc : (∑' n : ℕ, a n * max 0 (Real.log (Y / (n : ℝ)))) =
      ∑ n ∈ Finset.Icc 1 ⌊Y⌋₊, a n * Real.log (Y / (n : ℝ)) := by
    rw [tsum_eq_sum (s := Finset.Icc 1 ⌊Y⌋₊)]
    · refine Finset.sum_congr rfl (fun n hn => ?_)
      rw [Finset.mem_Icc] at hn
      have hn_pos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn.1
      have hn_le : (n : ℝ) ≤ Y := le_trans (by exact_mod_cast hn.2) (Nat.floor_le (le_of_lt hY_pos))
      have h_div : 1 ≤ Y / (n : ℝ) := (one_le_div hn_pos).mpr hn_le
      rw [max_eq_right (Real.log_nonneg h_div)]
    · intro n hn
      rw [Finset.mem_Icc, not_and_or, not_le, not_le] at hn
      rcases hn with hn0 | hnY
      · have h0 : n = 0 := Nat.lt_one_iff.mp hn0
        rw [h0, ha0, zero_mul]
      · have hYn : Y < (n : ℝ) := Nat.lt_of_floor_lt hnY
        have hn_nonneg : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
        have h_div_nonneg : 0 ≤ Y / (n : ℝ) := div_nonneg (le_of_lt hY_pos) hn_nonneg
        have h_div_le : Y / (n : ℝ) ≤ 1 := div_le_one_of_le₀ (le_of_lt hYn) hn_nonneg
        rw [max_eq_left (Real.log_nonpos h_div_nonneg h_div_le), mul_zero]
  exact (h_rhs_eq_tsum.trans h_trunc).symm

theorem mitsui_riemannZeta_logDeriv_sub_pole_bound_of_two_le_re : ∃ C₁ : ℝ, 0 < C₁ ∧
      ∀ s : ℂ, 2 ≤ s.re →
        riemannZeta s ≠ 0 ∧
        ‖-deriv riemannZeta s / riemannZeta s - 1 / (s - 1)‖ ≤ C₁ :=
by
  let f : ℕ → ℂ := fun n => (ArithmeticFunction.vonMangoldt n : ℂ)
  let C₁ : ℝ := (∑' n : ℕ, ‖LSeries.term f 2 n‖) + 1
  have hC₁_pos : 0 < C₁ := by
    dsimp [C₁]
    have h_nonneg : 0 ≤ ∑' n : ℕ, ‖LSeries.term f 2 n‖ :=
      tsum_nonneg (fun n => norm_nonneg _)
    linarith
  refine ⟨C₁, hC₁_pos, ?_⟩
  intro s hs
  have hs_gt_one : 1 < s.re := by linarith
  have hs_ge_one : 1 ≤ s.re := by linarith
  refine ⟨riemannZeta_ne_zero_of_one_le_re hs_ge_one, ?_⟩
  have h_sum_2 : LSeriesSummable f 2 :=
    ArithmeticFunction.LSeriesSummable_vonMangoldt (by norm_num)
  have h_re : (2 : ℂ).re ≤ s.re := by simpa using hs
  have h_sum_s : LSeriesSummable f s := LSeriesSummable.of_re_le_re h_re h_sum_2
  have h_norm_2 : Summable (fun n => ‖LSeries.term f 2 n‖) := h_sum_2.norm
  have h_norm_s : Summable (fun n => ‖LSeries.term f s n‖) := h_sum_s.norm
  have h_logDeriv_eq : -deriv riemannZeta s / riemannZeta s = LSeries f s :=
    (ArithmeticFunction.LSeries_vonMangoldt_eq_deriv_riemannZeta_div hs_gt_one).symm
  have h_logDeriv_le : ‖-deriv riemannZeta s / riemannZeta s‖ ≤ ∑' n : ℕ, ‖LSeries.term f 2 n‖ := by
    rw [h_logDeriv_eq, LSeries]
    calc ‖∑' n : ℕ, LSeries.term f s n‖
      _ ≤ ∑' n : ℕ, ‖LSeries.term f s n‖ := norm_tsum_le_tsum_norm h_norm_s
      _ ≤ ∑' n : ℕ, ‖LSeries.term f 2 n‖ :=
          Summable.tsum_le_tsum (LSeries.norm_term_le_of_re_le_re f h_re) h_norm_s h_norm_2
  have h_sub_one_ge : 1 ≤ ‖s - 1‖ := by
    have h1 : 1 ≤ (s - 1).re := by simp; linarith
    have h2 : (s - 1).re ≤ |(s - 1).re| := le_abs_self _
    have h3 : |(s - 1).re| ≤ ‖s - 1‖ := Complex.abs_re_le_norm (s - 1)
    linarith
  have h_pole_le : ‖(1 : ℂ) / (s - 1)‖ ≤ 1 := by
    rw [one_div, norm_inv]
    exact inv_le_one_of_one_le₀ h_sub_one_ge
  have h_tri : ‖-deriv riemannZeta s / riemannZeta s - 1 / (s - 1)‖ ≤
      ‖-deriv riemannZeta s / riemannZeta s‖ + ‖(1 : ℂ) / (s - 1)‖ :=
    norm_sub_le _ _
  dsimp [C₁]
  linarith

theorem mitsui_riemannZeta_zeroFree_and_logDeriv_bound_of_im_le_four : ∃ (δ₀ C₂ : ℝ), 0 < δ₀ ∧ δ₀ ≤ 1 / 2 ∧ 0 < C₂ ∧
      ∀ s : ℂ, s ≠ 1 → |s.im| ≤ 4 → 1 - δ₀ ≤ s.re → s.re ≤ 2 →
        riemannZeta s ≠ 0 ∧
        ‖-deriv riemannZeta s / riemannZeta s - 1 / (s - 1)‖ ≤ C₂ :=
by
  let g₀ : ℂ → ℂ := fun s => (s - 1) * riemannZeta s
  let g : ℂ → ℂ := Function.update g₀ 1 (limUnder (nhdsWithin 1 {1}ᶜ) g₀)
  have hg_one : g 1 = 1 := by
    dsimp [g, g₀]
    rw [Function.update_self]
    exact riemannZeta_residue_one.limUnder_eq
  have hg_ne : ∀ z : ℂ, z ≠ 1 → g z = g₀ z := fun z hz => Function.update_of_ne hz _ g₀
  have hg_ev : ∀ z : ℂ, z ≠ 1 → g =ᶠ[nhds z] g₀ := by
    intro z hz
    exact Filter.eventuallyEq_of_mem (isOpen_compl_singleton.mem_nhds hz) (fun w hw => hg_ne w hw)
  have hg₀_diff : ∀ z : ℂ, z ≠ 1 → DifferentiableAt ℂ g₀ z := by
    intro z hz
    exact (differentiableAt_id.sub (differentiableAt_const (1 : ℂ))).mul (differentiableAt_riemannZeta hz)
  obtain ⟨r, hr_pos, hr⟩ := Metric.tendsto_nhdsWithin_nhds.mp riemannZeta_residue_one 1 zero_lt_one
  let V : Set ℂ := Metric.ball (1 : ℂ) r
  have hV_nhds : V ∈ nhds (1 : ℂ) := Metric.ball_mem_nhds (1 : ℂ) hr_pos
  have hg₀_diffOn : DifferentiableOn ℂ g₀ (V \ {(1 : ℂ)}) :=
    fun z hz => (hg₀_diff z hz.2).differentiableWithinAt
  have hg₀_bdd : BddAbove (norm ∘ g₀ '' (V \ {(1 : ℂ)})) := by
    refine ⟨2, ?_⟩
    rintro y ⟨z, ⟨hzV, hz1⟩, rfl⟩
    simp only [Function.comp_apply]
    have hdist : dist (g₀ z) 1 < 1 := hr hz1 (Metric.mem_ball.mp hzV)
    rw [dist_eq_norm] at hdist
    have htri : ‖g₀ z‖ ≤ ‖g₀ z - 1‖ + ‖(1 : ℂ)‖ := by
      calc ‖g₀ z‖ = ‖(g₀ z - 1) + 1‖ := by ring_nf
        _ ≤ ‖g₀ z - 1‖ + ‖(1 : ℂ)‖ := norm_add_le (g₀ z - 1) 1
    have h1 : ‖(1 : ℂ)‖ = 1 := norm_one
    linarith
  have hg_diffOn_V : DifferentiableOn ℂ g V :=
    Complex.differentiableOn_update_limUnder_of_bddAbove hV_nhds hg₀_diffOn hg₀_bdd
  have hg_diff_one : DifferentiableAt ℂ g 1 := hg_diffOn_V.differentiableAt hV_nhds
  have hg_diff : Differentiable ℂ g := by
    intro z
    by_cases hz : z = 1
    · rwa [hz]
    · exact (hg₀_diff z hz).congr_of_eventuallyEq (hg_ev z hz)
  have hg_cont : Continuous g := hg_diff.continuous
  have h_deriv_g_diff : Differentiable ℂ (deriv g) := by
    rw [← differentiableOn_univ]
    exact (differentiableOn_univ.mpr hg_diff).deriv isOpen_univ
  have h_deriv_g_cont : Continuous (deriv g) := h_deriv_g_diff.continuous
  let K₀ : Set ℂ := Set.Icc (1 : ℝ) 2 ×ℂ Set.Icc (-4 : ℝ) 4
  let U : Set ℂ := {z : ℂ | g z ≠ 0}
  have hK₀_compact : IsCompact K₀ := isCompact_Icc.reProdIm isCompact_Icc
  have hU_open : IsOpen U := isOpen_ne_fun hg_cont continuous_const
  have hK₀_sub : K₀ ⊆ U := by
    intro z hz
    rw [Set.mem_setOf_eq]
    have hz_re : 1 ≤ z.re := (Complex.mem_reProdIm.mp hz).1.1
    by_cases hz1 : z = 1
    · rw [hz1, hg_one]
      exact one_ne_zero
    · rw [hg_ne z hz1]
      exact mul_ne_zero (sub_ne_zero.mpr hz1) (riemannZeta_ne_zero_of_one_le_re hz_re)
  obtain ⟨δ, hδ_pos, hδ_sub⟩ := hK₀_compact.exists_thickening_subset_open hU_open hK₀_sub
  let δ₀ : ℝ := min (δ / 2) (1 / 2)
  have hδ₀_pos : 0 < δ₀ := lt_min (half_pos hδ_pos) (by norm_num)
  have hδ₀_le : δ₀ ≤ 1 / 2 := min_le_right _ _
  have hδ₀_lt_δ : δ₀ < δ := lt_of_le_of_lt (min_le_left _ _) (half_lt_self hδ_pos)
  let K : Set ℂ := Set.Icc (1 - δ₀) 2 ×ℂ Set.Icc (-4 : ℝ) 4
  have hK_sub_U : K ⊆ U := by
    intro s hs
    rcases Complex.mem_reProdIm.mp hs with ⟨⟨hs_re1, hs_re2⟩, ⟨hs_im1, hs_im2⟩⟩
    let z : ℂ := ⟨max 1 s.re, s.im⟩
    have hz_K₀ : z ∈ K₀ := by
      rw [Complex.mem_reProdIm]
      refine ⟨⟨le_max_left 1 s.re, max_le (by norm_num) hs_re2⟩, ⟨hs_im1, hs_im2⟩⟩
    have hsz_eq : s - z = ((s.re - max 1 s.re : ℝ) : ℂ) := by
      apply Complex.ext <;> simp [z]
    have hdist_le : dist s z ≤ δ₀ := by
      rw [dist_eq_norm, hsz_eq, Complex.norm_real, Real.norm_eq_abs, abs_le]
      refine ⟨?_, ?_⟩
      · have : max 1 s.re ≤ s.re + δ₀ := max_le (by linarith) (by linarith)
        linarith
      · have : s.re ≤ max 1 s.re := le_max_right 1 s.re
        linarith
    have hs_thick : s ∈ Metric.thickening δ K₀ := by
      rw [Metric.mem_thickening_iff]
      exact ⟨z, hz_K₀, lt_of_le_of_lt hdist_le hδ₀_lt_δ⟩
    exact hδ_sub hs_thick
  have hK_compact : IsCompact K := isCompact_Icc.reProdIm isCompact_Icc
  have h_cont_K : ContinuousOn (fun s : ℂ => ‖-deriv g s / g s‖) K :=
    ((h_deriv_g_cont.continuousOn.neg).div hg_cont.continuousOn (fun s hs => hK_sub_U hs)).norm
  obtain ⟨M₂, hM₂⟩ := hK_compact.bddAbove_image h_cont_K
  let C₂ : ℝ := max M₂ 1
  have hC₂_pos : 0 < C₂ := lt_of_lt_of_le zero_lt_one (le_max_right M₂ 1)
  refine ⟨δ₀, C₂, hδ₀_pos, hδ₀_le, hC₂_pos, ?_⟩
  intro s hs_ne hs_im hs_re1 hs_re2
  have hs_K : s ∈ K := Complex.mem_reProdIm.mpr ⟨⟨hs_re1, hs_re2⟩, abs_le.mp hs_im⟩
  have hg_s_ne : g s ≠ 0 := hK_sub_U hs_K
  have hζ_ne : riemannZeta s ≠ 0 := by
    rw [hg_ne s hs_ne] at hg_s_ne
    exact right_ne_zero_of_mul hg_s_ne
  refine ⟨hζ_ne, ?_⟩
  have h_deriv_g_eq : deriv g s = 1 * riemannZeta s + (s - 1) * deriv riemannZeta s := by
    rw [(hg_ev s hs_ne).deriv_eq]
    have hd1 : HasDerivAt (fun w : ℂ => w - 1) 1 s := (hasDerivAt_id s).sub_const (1 : ℂ)
    have hd2 : HasDerivAt riemannZeta (deriv riemannZeta s) s := (differentiableAt_riemannZeta hs_ne).hasDerivAt
    exact (hd1.mul hd2).deriv
  have h_ident : -deriv riemannZeta s / riemannZeta s - 1 / (s - 1) = -deriv g s / g s := by
    have hs_sub_ne : s - 1 ≠ 0 := sub_ne_zero.mpr hs_ne
    rw [hg_ne s hs_ne, h_deriv_g_eq]
    dsimp [g₀]
    field_simp [hs_sub_ne, hζ_ne]
    ring
  rw [h_ident]
  exact le_trans (hM₂ (Set.mem_image_of_mem _ hs_K)) (le_max_left M₂ 1)

theorem mitsui_riemannZeta_trig_logDeriv_nonneg (σ γ : ℝ) (hσ : 1 < σ) :
    0 ≤ 3 * (-deriv riemannZeta (σ : ℂ) / riemannZeta (σ : ℂ)).re +
      4 * (-deriv riemannZeta ((σ : ℂ) + (γ : ℂ) * Complex.I) /
        riemannZeta ((σ : ℂ) + (γ : ℂ) * Complex.I)).re +
      (-deriv riemannZeta ((σ : ℂ) + ((2 * γ : ℝ) : ℂ) * Complex.I) /
        riemannZeta ((σ : ℂ) + ((2 * γ : ℝ) : ℂ) * Complex.I)).re :=
by
  let f : ℕ → ℂ := fun n => (ArithmeticFunction.vonMangoldt n : ℂ)
  let s₀ : ℂ := (σ : ℂ)
  let s₁ : ℂ := (σ : ℂ) + (γ : ℂ) * Complex.I
  let s₂ : ℂ := (σ : ℂ) + ((2 * γ : ℝ) : ℂ) * Complex.I
  have hs₀_re : s₀.re = σ := by simp [s₀]
  have hs₀_im : s₀.im = 0 := by simp [s₀]
  have hs₁_re : s₁.re = σ := by simp [s₁]
  have hs₁_im : s₁.im = γ := by simp [s₁]
  have hs₂_re : s₂.re = σ := by simp [s₂]
  have hs₂_im : s₂.im = 2 * γ := by simp [s₂]
  have hs₀ : 1 < s₀.re := by rw [hs₀_re]; exact hσ
  have hs₁ : 1 < s₁.re := by rw [hs₁_re]; exact hσ
  have hs₂ : 1 < s₂.re := by rw [hs₂_re]; exact hσ
  have h_sum₀ : Summable (LSeries.term f s₀) :=
    ArithmeticFunction.LSeriesSummable_vonMangoldt hs₀
  have h_sum₁ : Summable (LSeries.term f s₁) :=
    ArithmeticFunction.LSeriesSummable_vonMangoldt hs₁
  have h_sum₂ : Summable (LSeries.term f s₂) :=
    ArithmeticFunction.LSeriesSummable_vonMangoldt hs₂
  have h_re₀ : Summable (fun n => (LSeries.term f s₀ n).re) :=
    Complex.reCLM.summable h_sum₀
  have h_re₁ : Summable (fun n => (LSeries.term f s₁ n).re) :=
    Complex.reCLM.summable h_sum₁
  have h_re₂ : Summable (fun n => (LSeries.term f s₂ n).re) :=
    Complex.reCLM.summable h_sum₂
  have h_eq₀ : (-deriv riemannZeta s₀ / riemannZeta s₀).re =
      ∑' n : ℕ, (LSeries.term f s₀ n).re := by
    rw [← ArithmeticFunction.LSeries_vonMangoldt_eq_deriv_riemannZeta_div hs₀, LSeries,
      Complex.re_tsum h_sum₀]
  have h_eq₁ : (-deriv riemannZeta s₁ / riemannZeta s₁).re =
      ∑' n : ℕ, (LSeries.term f s₁ n).re := by
    rw [← ArithmeticFunction.LSeries_vonMangoldt_eq_deriv_riemannZeta_div hs₁, LSeries,
      Complex.re_tsum h_sum₁]
  have h_eq₂ : (-deriv riemannZeta s₂ / riemannZeta s₂).re =
      ∑' n : ℕ, (LSeries.term f s₂ n).re := by
    rw [← ArithmeticFunction.LSeries_vonMangoldt_eq_deriv_riemannZeta_div hs₂, LSeries,
      Complex.re_tsum h_sum₂]
  change 0 ≤ 3 * (-deriv riemannZeta s₀ / riemannZeta s₀).re +
    4 * (-deriv riemannZeta s₁ / riemannZeta s₁).re +
    (-deriv riemannZeta s₂ / riemannZeta s₂).re
  rw [h_eq₀, h_eq₁, h_eq₂, ← tsum_mul_left, ← tsum_mul_left,
    ← Summable.tsum_add (h_re₀.mul_left 3) (h_re₁.mul_left 4),
    ← Summable.tsum_add ((h_re₀.mul_left 3).add (h_re₁.mul_left 4)) h_re₂]
  apply tsum_nonneg
  intro n
  rcases eq_or_ne n 0 with rfl | hn
  · simp [LSeries.term_zero]
  · have h_term_re : ∀ s : ℂ, (LSeries.term f s n).re =
        ArithmeticFunction.vonMangoldt n *
          (Real.exp (Real.log (n : ℝ) * (-s.re)) *
            Real.cos (Real.log (n : ℝ) * (-s.im))) := by
      intro s
      have hn_c : (n : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hn
      dsimp [f]
      rw [LSeries.term_of_ne_zero hn, div_eq_mul_inv, ← Complex.cpow_neg,
        Complex.cpow_def_of_ne_zero hn_c, ← Complex.natCast_log,
        Complex.re_ofReal_mul, Complex.exp_re, Complex.re_ofReal_mul,
        Complex.im_ofReal_mul, Complex.neg_re, Complex.neg_im]
    rw [h_term_re s₀, h_term_re s₁, h_term_re s₂,
      hs₀_re, hs₀_im, hs₁_re, hs₁_im, hs₂_re, hs₂_im]
    set θ : ℝ := Real.log (n : ℝ) * (-γ)
    have hθ₀ : Real.log (n : ℝ) * (-0 : ℝ) = 0 := by ring
    have hθ₂ : Real.log (n : ℝ) * (-(2 * γ)) = 2 * θ := by dsimp [θ]; ring
    rw [hθ₀, hθ₂, Real.cos_zero, Real.cos_two_mul θ]
    have h_alg :
        3 * (ArithmeticFunction.vonMangoldt n * (Real.exp (Real.log (n : ℝ) * (-σ)) * 1)) +
        4 * (ArithmeticFunction.vonMangoldt n * (Real.exp (Real.log (n : ℝ) * (-σ)) * Real.cos θ)) +
        ArithmeticFunction.vonMangoldt n * (Real.exp (Real.log (n : ℝ) * (-σ)) * (2 * Real.cos θ ^ 2 - 1)) =
        ArithmeticFunction.vonMangoldt n * Real.exp (Real.log (n : ℝ) * (-σ)) *
          (2 * (1 + Real.cos θ) ^ 2) := by ring
    rw [h_alg]
    have hΛ : 0 ≤ ArithmeticFunction.vonMangoldt n := ArithmeticFunction.vonMangoldt_nonneg
    positivity

theorem mitsui_riemannZeta_real_logDeriv_le_of_one_lt_le_two : ∃ C₁ : ℝ, 0 < C₁ ∧
      ∀ σ : ℝ, 1 < σ → σ ≤ 2 →
        (-deriv riemannZeta (σ : ℂ) / riemannZeta (σ : ℂ)).re ≤ 1 / (σ - 1) + C₁ :=
by
  let g₀ : ℂ → ℂ := fun s => (s - 1) * riemannZeta s
  let g : ℂ → ℂ := Function.update g₀ 1 (limUnder (nhdsWithin 1 {1}ᶜ) g₀)
  have hg_one : g 1 = 1 := by
    dsimp [g, g₀]
    rw [Function.update_self]
    exact riemannZeta_residue_one.limUnder_eq
  have hg_ne : ∀ z : ℂ, z ≠ 1 → g z = g₀ z := fun z hz => Function.update_of_ne hz _ g₀
  have hg_ev : ∀ z : ℂ, z ≠ 1 → g =ᶠ[nhds z] g₀ := by
    intro z hz
    exact Filter.eventuallyEq_of_mem (isOpen_compl_singleton.mem_nhds hz) (fun w hw => hg_ne w hw)
  have hg₀_diff : ∀ z : ℂ, z ≠ 1 → DifferentiableAt ℂ g₀ z := by
    intro z hz
    exact (differentiableAt_id.sub (differentiableAt_const (1 : ℂ))).mul (differentiableAt_riemannZeta hz)
  obtain ⟨r, hr_pos, hr⟩ := Metric.tendsto_nhdsWithin_nhds.mp riemannZeta_residue_one 1 zero_lt_one
  let V : Set ℂ := Metric.ball (1 : ℂ) r
  have hV_nhds : V ∈ nhds (1 : ℂ) := Metric.ball_mem_nhds (1 : ℂ) hr_pos
  have hg₀_diffOn : DifferentiableOn ℂ g₀ (V \ {(1 : ℂ)}) :=
    fun z hz => (hg₀_diff z hz.2).differentiableWithinAt
  have hg₀_bdd : BddAbove (norm ∘ g₀ '' (V \ {(1 : ℂ)})) := by
    refine ⟨2, ?_⟩
    rintro y ⟨z, ⟨hzV, hz1⟩, rfl⟩
    simp only [Function.comp_apply]
    have hdist : dist (g₀ z) 1 < 1 := hr hz1 (Metric.mem_ball.mp hzV)
    rw [dist_eq_norm] at hdist
    have htri : ‖g₀ z‖ ≤ ‖g₀ z - 1‖ + ‖(1 : ℂ)‖ := by
      calc ‖g₀ z‖ = ‖(g₀ z - 1) + 1‖ := by ring_nf
        _ ≤ ‖g₀ z - 1‖ + ‖(1 : ℂ)‖ := norm_add_le (g₀ z - 1) 1
    have h1 : ‖(1 : ℂ)‖ = 1 := norm_one
    linarith
  have hg_diffOn_V : DifferentiableOn ℂ g V :=
    Complex.differentiableOn_update_limUnder_of_bddAbove hV_nhds hg₀_diffOn hg₀_bdd
  have hg_diff_one : DifferentiableAt ℂ g 1 := hg_diffOn_V.differentiableAt hV_nhds
  have hg_diff : Differentiable ℂ g := by
    intro z
    by_cases hz : z = 1
    · rwa [hz]
    · exact (hg₀_diff z hz).congr_of_eventuallyEq (hg_ev z hz)
  have hg_cont : Continuous g := hg_diff.continuous
  have h_deriv_g_diff : Differentiable ℂ (deriv g) := by
    rw [← differentiableOn_univ]
    exact (differentiableOn_univ.mpr hg_diff).deriv isOpen_univ
  have h_deriv_g_cont : Continuous (deriv g) := h_deriv_g_diff.continuous
  let K₀ : Set ℂ := Set.Icc (1 : ℝ) 2 ×ℂ Set.Icc (-4 : ℝ) 4
  have hK₀_compact : IsCompact K₀ := isCompact_Icc.reProdIm isCompact_Icc
  have hK₀_ne : ∀ z ∈ K₀, g z ≠ 0 := by
    intro z hz
    have hz_re : 1 ≤ z.re := (Complex.mem_reProdIm.mp hz).1.1
    by_cases hz1 : z = 1
    · rw [hz1, hg_one]
      exact one_ne_zero
    · rw [hg_ne z hz1]
      exact mul_ne_zero (sub_ne_zero.mpr hz1) (riemannZeta_ne_zero_of_one_le_re hz_re)
  have h_cont_K₀ : ContinuousOn (fun s : ℂ => ‖-deriv g s / g s‖) K₀ :=
    ((h_deriv_g_cont.continuousOn.neg).div hg_cont.continuousOn hK₀_ne).norm
  obtain ⟨M₁, hM₁⟩ := hK₀_compact.bddAbove_image h_cont_K₀
  let C₁ : ℝ := max M₁ 1
  have hC₁_pos : 0 < C₁ := lt_of_lt_of_le zero_lt_one (le_max_right M₁ 1)
  refine ⟨C₁, hC₁_pos, ?_⟩
  intro σ hσ1 hσ2
  set s : ℂ := (σ : ℂ)
  have hs_K₀ : s ∈ K₀ := by
    rw [Complex.mem_reProdIm]
    simp only [s, Complex.ofReal_re, Complex.ofReal_im]
    exact ⟨⟨by linarith, hσ2⟩, ⟨by norm_num, by norm_num⟩⟩
  have hs_ne : s ≠ 1 := by
    intro h
    have hre := congrArg Complex.re h
    simp only [s, Complex.ofReal_re, Complex.one_re] at hre
    linarith
  have hζ_ne : riemannZeta s ≠ 0 := by
    apply riemannZeta_ne_zero_of_one_le_re
    simp only [s, Complex.ofReal_re]
    linarith
  have h_deriv_g_eq : deriv g s = 1 * riemannZeta s + (s - 1) * deriv riemannZeta s := by
    rw [(hg_ev s hs_ne).deriv_eq]
    have hd1 : HasDerivAt (fun w : ℂ => w - 1) 1 s := (hasDerivAt_id s).sub_const (1 : ℂ)
    have hd2 : HasDerivAt riemannZeta (deriv riemannZeta s) s := (differentiableAt_riemannZeta hs_ne).hasDerivAt
    exact (hd1.mul hd2).deriv
  have h_ident : -deriv riemannZeta s / riemannZeta s - 1 / (s - 1) = -deriv g s / g s := by
    have hs_sub_ne : s - 1 ≠ 0 := sub_ne_zero.mpr hs_ne
    rw [hg_ne s hs_ne, h_deriv_g_eq]
    dsimp [g₀]
    field_simp [hs_sub_ne, hζ_ne]
    ring
  have h_norm_le : ‖-deriv riemannZeta s / riemannZeta s - 1 / (s - 1)‖ ≤ C₁ := by
    rw [h_ident]
    exact le_trans (hM₁ (Set.mem_image_of_mem _ hs_K₀)) (le_max_left M₁ 1)
  have h_re_le : (-deriv riemannZeta s / riemannZeta s).re - (1 / (s - 1)).re ≤ C₁ := by
    rw [← Complex.sub_re]
    exact le_trans (Complex.re_le_norm _) h_norm_le
  have h_pole_re : (1 / (s - 1)).re = 1 / (σ - 1) := by
    have h_eq : (1 / (s - 1) : ℂ) = ((1 / (σ - 1) : ℝ) : ℂ) := by
      dsimp [s]
      push_cast
      rfl
    rw [h_eq, Complex.ofReal_re]
  linarith

theorem mitsui_riemannZeta_norm_le_of_half_le_re_of_two_le_im : ∃ A₁ : ℝ, 0 < A₁ ∧
      ∀ s : ℂ, 1 / 2 ≤ s.re → s.re ≤ 2 → 2 ≤ |s.im| →
        ‖riemannZeta s‖ ≤ A₁ * (4 + |s.im|) :=
by
  have h_s1 : ∀ (n : ℕ) (s : ℂ), 0 < s.re → s ≠ 1 →
      ‖1 / ((n : ℂ) + 1) ^ s - (((n : ℂ) + 1) ^ (1 - s) - ((n : ℂ) + 2) ^ (1 - s)) / (s - 1)‖ ≤
        ‖s‖ * ((n : ℝ) + 1) ^ (-s.re - 1) := by
    intro n s hs_re hs_ne
    set a : ℝ := (n : ℝ) + 1
    have ha_pos : 0 < a := by dsimp [a]; positivity
    have hs_ne_zero : s ≠ 0 := by
      intro h
      rw [h, Complex.zero_re] at hs_re
      exact lt_irrefl 0 hs_re
    have h_neg_s_ne : -s ≠ 0 := neg_ne_zero.mpr hs_ne_zero
    have h_neg_s_ne_neg1 : -s ≠ -1 := by
      intro h
      exact hs_ne (neg_inj.mp h)
    have h_step1 : ∀ x ∈ Set.Icc a (a + 1),
        ‖(x : ℂ) ^ (-s) - (a : ℂ) ^ (-s)‖ ≤ ‖s‖ * a ^ (-s.re - 1) := by
      intro x hx
      have hx_ge : a ≤ x := hx.1
      have hx_le : x ≤ a + 1 := hx.2
      let h : ℝ → ℂ := fun t => (t : ℂ) ^ (-s)
      let h' : ℝ → ℂ := fun t => -s * (t : ℂ) ^ (-s - 1)
      have hh_deriv : ∀ t ∈ Set.Icc a x, HasDerivWithinAt h (h' t) (Set.Icc a x) t := by
        intro t ht
        have ht_pos : 0 < t := lt_of_lt_of_le ha_pos ht.1
        exact (hasDerivAt_ofReal_cpow_const (ne_of_gt ht_pos) h_neg_s_ne).hasDerivWithinAt
      have hh'_bound : ∀ t ∈ Set.Icc a x, ‖h' t‖ ≤ ‖s‖ * a ^ (-s.re - 1) := by
        intro t ht
        have ht_pos : 0 < t := lt_of_lt_of_le ha_pos ht.1
        dsimp [h']
        rw [norm_mul, norm_neg, Complex.norm_cpow_eq_rpow_re_of_pos ht_pos]
        have h_re : (-s - 1).re = -s.re - 1 := by simp
        rw [h_re]
        apply mul_le_mul_of_nonneg_left _ (norm_nonneg s)
        exact Real.rpow_le_rpow_of_nonpos ha_pos ht.1 (by linarith)
      have hmvt := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
        hh_deriv hh'_bound (convex_Icc a x) ⟨le_refl a, hx_ge⟩ ⟨hx_ge, le_refl x⟩
      have h_dist : ‖x - a‖ ≤ 1 := by
        rw [Real.norm_of_nonneg (by linarith)]
        linarith
      calc ‖(x : ℂ) ^ (-s) - (a : ℂ) ^ (-s)‖
        _ = ‖h x - h a‖ := rfl
        _ ≤ ‖s‖ * a ^ (-s.re - 1) * ‖x - a‖ := hmvt
        _ ≤ ‖s‖ * a ^ (-s.re - 1) * 1 :=
            mul_le_mul_of_nonneg_left h_dist (mul_nonneg (norm_nonneg s) (Real.rpow_nonneg (le_of_lt ha_pos) _))
        _ = ‖s‖ * a ^ (-s.re - 1) := mul_one _
    let g : ℝ → ℂ := fun x => (x : ℂ) ^ (-s + 1) / (-s + 1) - (x : ℂ) * (a : ℂ) ^ (-s)
    let g' : ℝ → ℂ := fun x => (x : ℂ) ^ (-s) - (a : ℂ) ^ (-s)
    have hg_deriv : ∀ x ∈ Set.Icc a (a + 1), HasDerivWithinAt g (g' x) (Set.Icc a (a + 1)) x := by
      intro x hx
      have hx_pos : 0 < x := lt_of_lt_of_le ha_pos hx.1
      have hd1 : HasDerivAt (fun y : ℝ => (y : ℂ) ^ (-s + 1) / (-s + 1)) ((x : ℂ) ^ (-s)) x :=
        hasDerivAt_ofReal_cpow_const' (ne_of_gt hx_pos) h_neg_s_ne_neg1
      have hd2 : HasDerivAt (fun y : ℝ => (y : ℂ) * (a : ℂ) ^ (-s)) ((a : ℂ) ^ (-s)) x := by
        simpa using (Complex.ofRealCLM.hasDerivAt (x := x)).mul_const ((a : ℂ) ^ (-s))
      exact (hd1.sub hd2).hasDerivWithinAt
    have hmvt2 := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
      hg_deriv h_step1 (convex_Icc a (a + 1))
      ⟨le_refl a, by linarith⟩ ⟨by linarith, le_refl (a + 1)⟩
    have h_dist2 : ‖(a + 1) - a‖ = 1 := by
      have : (a + 1) - a = 1 := by ring
      rw [this, Real.norm_eq_abs, abs_one]
    rw [h_dist2, mul_one] at hmvt2
    have ha_cast : (a : ℂ) = (n : ℂ) + 1 := by dsimp [a]; push_cast; ring
    have ha1_cast : ((a + 1 : ℝ) : ℂ) = (n : ℂ) + 2 := by dsimp [a]; push_cast; ring
    have h_exp : -s + 1 = 1 - s := by ring
    have h_inv : (a : ℂ) ^ (-s) = 1 / ((n : ℂ) + 1) ^ s := by
      rw [ha_cast, Complex.cpow_neg, one_div]
    have h_eq : 1 / ((n : ℂ) + 1) ^ s - (((n : ℂ) + 1) ^ (1 - s) - ((n : ℂ) + 2) ^ (1 - s)) / (s - 1) =
        g a - g (a + 1) := by
      dsimp [g]
      rw [ha1_cast, h_inv, ha_cast, h_exp]
      have h_sub_ne : s - 1 ≠ 0 := sub_ne_zero.mpr hs_ne
      have h_one_sub_ne : 1 - s ≠ 0 := sub_ne_zero.mpr (Ne.symm hs_ne)
      field_simp [h_sub_ne, h_one_sub_ne]
      ring
    rw [h_eq, norm_sub_rev]
    exact hmvt2
  have h_s2 : ∀ (s : ℂ), 1 < s.re →
      riemannZeta s - 1 / (s - 1) =
        ∑' n : ℕ, (1 / ((n : ℂ) + 1) ^ s - (((n : ℂ) + 1) ^ (1 - s) - ((n : ℂ) + 2) ^ (1 - s)) / (s - 1)) := by
    intro s hs
    let T : ℕ → ℂ := fun n =>
      1 / ((n : ℂ) + 1) ^ s - (((n : ℂ) + 1) ^ (1 - s) - ((n : ℂ) + 2) ^ (1 - s)) / (s - 1)
    have hs_pos : 0 < s.re := by linarith
    have hs_ne : s ≠ 1 := by
      intro h
      rw [h, Complex.one_re] at hs
      exact lt_irrefl 1 hs
    have h_sum_rpow : Summable (fun n : ℕ => ((n : ℝ) + 1) ^ (-s.re - 1)) := by
      have h1 := (Real.summable_one_div_nat_add_rpow 1 (s.re + 1)).mpr (by linarith)
      refine h1.congr (fun n => ?_)
      have hn_pos : 0 < (n : ℝ) + 1 := by positivity
      rw [abs_of_pos hn_pos, one_div, ← Real.rpow_neg (le_of_lt hn_pos)]
      congr 1
      ring
    have hT_sum : Summable T :=
      Summable.of_norm_bounded (h_sum_rpow.mul_left ‖s‖) (fun n => h_s1 n s hs_pos hs_ne)
    have h_part : ∀ N : ℕ,
        ∑ n ∈ Finset.range N, T n =
          (∑ n ∈ Finset.range N, 1 / ((n : ℂ) + 1) ^ s) -
            (1 - ((N : ℂ) + 1) ^ (1 - s)) / (s - 1) := by
      intro N
      dsimp [T]
      rw [Finset.sum_sub_distrib, ← Finset.sum_div]
      congr 1
      let f : ℕ → ℂ := fun k => ((k : ℂ) + 1) ^ (1 - s)
      have h_tele : ∑ n ∈ Finset.range N, (((n : ℂ) + 1) ^ (1 - s) - ((n : ℂ) + 2) ^ (1 - s)) =
          ∑ n ∈ Finset.range N, (f n - f (n + 1)) := by
        refine Finset.sum_congr rfl (fun n _ => ?_)
        dsimp [f]
        have : ((n + 1 : ℕ) : ℂ) + 1 = (n : ℂ) + 2 := by push_cast; ring
        rw [this]
      rw [h_tele, Finset.sum_range_sub' f N]
      dsimp [f]
      have h0 : ((0 : ℕ) : ℂ) + 1 = 1 := by norm_num
      rw [h0, Complex.one_cpow]
    have h_zeta_sum : Summable (fun n : ℕ => 1 / ((n : ℂ) + 1) ^ s) := by
      have h1 := (summable_nat_add_iff 1).mpr (Complex.summable_one_div_nat_cpow.mpr hs)
      refine h1.congr (fun n => ?_)
      push_cast
      rfl
    have h_tendsto1 : Filter.Tendsto (fun N : ℕ => ∑ n ∈ Finset.range N, 1 / ((n : ℂ) + 1) ^ s)
        Filter.atTop (nhds (riemannZeta s)) := by
      rw [zeta_eq_tsum_one_div_nat_add_one_cpow hs]
      exact h_zeta_sum.hasSum.tendsto_sum_nat
    have h_tendsto_cpow : Filter.Tendsto (fun N : ℕ => ((N : ℂ) + 1) ^ (1 - s))
        Filter.atTop (nhds 0) := by
      rw [tendsto_zero_iff_norm_tendsto_zero]
      have h_norm : (fun N : ℕ => ‖((N : ℂ) + 1) ^ (1 - s)‖) =
          (fun N : ℕ => ((N : ℝ) + 1) ^ (-(s.re - 1))) := by
        ext N
        have hN_pos : 0 < (N : ℝ) + 1 := by positivity
        have h_cast : ((N : ℂ) + 1) = (((N : ℝ) + 1 : ℝ) : ℂ) := by push_cast; rfl
        rw [h_cast, Complex.norm_cpow_eq_rpow_re_of_pos hN_pos]
        congr 1
        simp
      rw [h_norm]
      exact (tendsto_rpow_neg_atTop (by linarith : 0 < s.re - 1)).comp
        (tendsto_natCast_atTop_atTop.atTop_add tendsto_const_nhds)
    have h_tendsto2 : Filter.Tendsto (fun N : ℕ => (1 - ((N : ℂ) + 1) ^ (1 - s)) / (s - 1))
        Filter.atTop (nhds (1 / (s - 1))) := by
      have h1 := ((tendsto_const_nhds (x := (1 : ℂ))).sub h_tendsto_cpow).div_const (s - 1)
      simpa using h1
    have h_tendsto_T : Filter.Tendsto (fun N : ℕ => ∑ n ∈ Finset.range N, T n)
        Filter.atTop (nhds (riemannZeta s - 1 / (s - 1))) := by
      refine Filter.Tendsto.congr (fun N => (h_part N).symm) ?_
      exact h_tendsto1.sub h_tendsto2
    exact tendsto_nhds_unique h_tendsto_T hT_sum.hasSum.tendsto_sum_nat
  have h_s3 : ∀ (s : ℂ), 1 / 2 ≤ s.re → s.re ≤ 2 → 2 ≤ |s.im| →
      riemannZeta s - 1 / (s - 1) =
        ∑' n : ℕ, (1 / ((n : ℂ) + 1) ^ s - (((n : ℂ) + 1) ^ (1 - s) - ((n : ℂ) + 2) ^ (1 - s)) / (s - 1)) := by
    intro s hs_re_low hs_re_high hs_im
    set t : ℝ := s.im
    let U : Set ℂ :=
      (Complex.reCLM ⁻¹' Set.Ioo (1 / 4 : ℝ) 3) ∩ (Complex.imCLM ⁻¹' Set.Ioo (t - 1) (t + 1))
    have hU_open : IsOpen U :=
      (isOpen_Ioo.preimage Complex.continuous_re).inter (isOpen_Ioo.preimage Complex.continuous_im)
    have hU_conv : Convex ℝ U :=
      ((convex_Ioo (1 / 4 : ℝ) 3).linear_preimage Complex.reCLM.toLinearMap).inter
        ((convex_Ioo (t - 1) (t + 1)).linear_preimage Complex.imCLM.toLinearMap)
    have hU_preconn : IsPreconnected U := hU_conv.isPreconnected
    have hz_props : ∀ z ∈ U, 0 < z.re ∧ z ≠ 1 ∧ ‖z‖ ≤ 4 + |t| ∧ -z.re - 1 ≤ -(5 / 4 : ℝ) := by
      intro z hz
      have hre1 : 1 / 4 < z.re := hz.1.1
      have hre2 : z.re < 3 := hz.1.2
      have him1 : t - 1 < z.im := hz.2.1
      have him2 : z.im < t + 1 := hz.2.2
      have h_re_pos : 0 < z.re := by linarith
      have hz_ne_one : z ≠ 1 := by
        intro h_eq
        have h_im_zero : z.im = 0 := by rw [h_eq, Complex.one_im]
        have ht_lt : |t| < 1 := abs_lt.mpr ⟨by linarith, by linarith⟩
        linarith
      have h_abs_re : |z.re| ≤ 3 := abs_le.mpr ⟨by linarith, by linarith⟩
      have h_abs_im : |z.im| ≤ |t| + 1 := by
        have h1 : -(|t| + 1) ≤ t - 1 := by linarith [neg_abs_le t]
        have h2 : t + 1 ≤ |t| + 1 := by linarith [le_abs_self t]
        exact abs_le.mpr ⟨by linarith, by linarith⟩
      have h_norm : ‖z‖ ≤ 4 + |t| := by
        have h1 := Complex.norm_le_abs_re_add_abs_im z
        linarith
      refine ⟨h_re_pos, hz_ne_one, h_norm, by linarith⟩
    let F : ℂ → ℂ := fun z => riemannZeta z - 1 / (z - 1)
    have hF_diff : DifferentiableOn ℂ F U := by
      intro z hz
      have hz_ne : z ≠ 1 := (hz_props z hz).2.1
      have hd1 : DifferentiableAt ℂ riemannZeta z := differentiableAt_riemannZeta hz_ne
      have hd2 : DifferentiableAt ℂ (fun w : ℂ => 1 / (w - 1)) z :=
        (differentiableAt_const (1 : ℂ)).div
          (differentiableAt_id.sub (differentiableAt_const (1 : ℂ)))
          (sub_ne_zero.mpr hz_ne)
      exact (hd1.sub hd2).differentiableWithinAt
    have hF_anal : AnalyticOnNhd ℂ F U := hF_diff.analyticOnNhd hU_open
    let T : ℕ → ℂ → ℂ := fun n z =>
      1 / ((n : ℂ) + 1) ^ z - (((n : ℂ) + 1) ^ (1 - z) - ((n : ℂ) + 2) ^ (1 - z)) / (z - 1)
    let G : ℂ → ℂ := fun z => ∑' n : ℕ, T n z
    have hT_diff : ∀ (n : ℕ), ∀ z ∈ U, DifferentiableAt ℂ (T n) z := by
      intro n z hz
      have hz_ne : z ≠ 1 := (hz_props z hz).2.1
      have hn1_ne : ((n : ℂ) + 1) ≠ 0 := by
        intro h
        have hre : (((n : ℂ) + 1).re) = 0 := by rw [h, Complex.zero_re]
        simp at hre
        linarith
      have hn2_ne : ((n : ℂ) + 2) ≠ 0 := by
        intro h
        have hre : (((n : ℂ) + 2).re) = 0 := by rw [h, Complex.zero_re]
        simp at hre
        linarith
      have hd_cpow1 : DifferentiableAt ℂ (fun w : ℂ => ((n : ℂ) + 1) ^ w) z :=
        differentiableAt_id.const_cpow (Or.inl hn1_ne)
      have hd_div1 : DifferentiableAt ℂ (fun w : ℂ => 1 / ((n : ℂ) + 1) ^ w) z :=
        (differentiableAt_const (1 : ℂ)).div hd_cpow1 (Complex.cpow_ne_zero_iff.mpr (Or.inl hn1_ne))
      have hd_cpow2 : DifferentiableAt ℂ (fun w : ℂ => ((n : ℂ) + 1) ^ (1 - w)) z :=
        ((differentiableAt_const (1 : ℂ)).sub differentiableAt_id).const_cpow (Or.inl hn1_ne)
      have hd_cpow3 : DifferentiableAt ℂ (fun w : ℂ => ((n : ℂ) + 2) ^ (1 - w)) z :=
        ((differentiableAt_const (1 : ℂ)).sub differentiableAt_id).const_cpow (Or.inl hn2_ne)
      have hd_div2 : DifferentiableAt ℂ
          (fun w : ℂ => (((n : ℂ) + 1) ^ (1 - w) - ((n : ℂ) + 2) ^ (1 - w)) / (w - 1)) z :=
        (hd_cpow2.sub hd_cpow3).div
          (differentiableAt_id.sub (differentiableAt_const (1 : ℂ)))
          (sub_ne_zero.mpr hz_ne)
      exact hd_div1.sub hd_div2
    let u : ℕ → ℝ := fun n => (4 + |t|) * ((n : ℝ) + 1) ^ (-(5 / 4 : ℝ))
    have hu_sum : Summable u := by
      have h1 := (Real.summable_one_div_nat_add_rpow 1 (5 / 4 : ℝ)).mpr (by norm_num)
      have h2 : Summable (fun n : ℕ => ((n : ℝ) + 1) ^ (-(5 / 4 : ℝ))) := by
        refine h1.congr (fun n => ?_)
        have hn_pos : 0 < (n : ℝ) + 1 := by positivity
        rw [abs_of_pos hn_pos, one_div, Real.rpow_neg (le_of_lt hn_pos)]
      exact h2.mul_left (4 + |t|)
    have hT_le_u : ∀ (n : ℕ), ∀ z ∈ U, ‖T n z‖ ≤ u n := by
      intro n z hz
      obtain ⟨h_re_pos, hz_ne_one, h_norm, h_exp⟩ := hz_props z hz
      have h1 := h_s1 n z h_re_pos hz_ne_one
      have hn_ge_one : 1 ≤ (n : ℝ) + 1 := by linarith
      have h2 : ((n : ℝ) + 1) ^ (-z.re - 1) ≤ ((n : ℝ) + 1) ^ (-(5 / 4 : ℝ)) :=
        Real.rpow_le_rpow_of_exponent_le hn_ge_one h_exp
      have h3 : ‖z‖ * ((n : ℝ) + 1) ^ (-z.re - 1) ≤ (4 + |t|) * ((n : ℝ) + 1) ^ (-(5 / 4 : ℝ)) :=
        mul_le_mul h_norm h2 (by positivity) (by positivity)
      exact le_trans h1 h3
    have h_unif : TendstoUniformlyOn (fun N z => ∑ n ∈ Finset.range N, T n z) G Filter.atTop U :=
      tendstoUniformlyOn_tsum_nat hu_sum hT_le_u
    have h_part_diff : ∀ᶠ N : ℕ in Filter.atTop, DifferentiableOn ℂ (fun z => ∑ n ∈ Finset.range N, T n z) U :=
      Filter.Eventually.of_forall (fun N z hz =>
        (DifferentiableAt.fun_sum (fun n _ => hT_diff n z hz)).differentiableWithinAt)
    have hG_diff : DifferentiableOn ℂ G U :=
      h_unif.tendstoLocallyUniformlyOn.differentiableOn h_part_diff hU_open
    have hG_anal : AnalyticOnNhd ℂ G U := hG_diff.analyticOnNhd hU_open
    let z₀ : ℂ := 2 + (t : ℂ) * Complex.I
    have hz₀_U : z₀ ∈ U := by
      refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩ <;> simp [z₀] <;> norm_num
    have hs_U : s ∈ U := by
      refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
      · change 1 / 4 < s.re; linarith
      · change s.re < 3; linarith
      · change t - 1 < s.im; dsimp [t]; linarith
      · change s.im < t + 1; dsimp [t]; linarith
    have h_ev : F =ᶠ[nhds z₀] G := by
      let V : Set ℂ := {z : ℂ | 1 < z.re}
      have hV_open : IsOpen V := isOpen_Ioi.preimage Complex.continuous_re
      have hz₀_V : z₀ ∈ V := by simp [V, z₀]
      exact Filter.eventuallyEq_of_mem (hV_open.mem_nhds hz₀_V) (fun z hz => h_s2 z hz)
    exact hF_anal.eqOn_of_preconnected_of_eventuallyEq hG_anal hU_preconn hz₀_U h_ev hs_U
  let u₀ : ℕ → ℝ := fun n => ((n : ℝ) + 1) ^ (-(3 / 2 : ℝ))
  have hu₀_sum : Summable u₀ := by
    have h1 := (Real.summable_one_div_nat_add_rpow 1 (3 / 2 : ℝ)).mpr (by norm_num)
    refine h1.congr (fun n => ?_)
    dsimp [u₀]
    have hn_pos : 0 < (n : ℝ) + 1 := by positivity
    rw [abs_of_pos hn_pos, one_div, Real.rpow_neg (le_of_lt hn_pos)]
  let A₁ : ℝ := 1 + ∑' n : ℕ, u₀ n
  have h_tsum_nonneg : 0 ≤ ∑' n : ℕ, u₀ n :=
    tsum_nonneg (fun n => by dsimp [u₀]; positivity)
  have hA₁_pos : 0 < A₁ := by dsimp [A₁]; linarith
  refine ⟨A₁, hA₁_pos, ?_⟩
  intro s hs_re_low hs_re_high hs_im
  let T : ℕ → ℂ := fun n =>
    1 / ((n : ℂ) + 1) ^ s - (((n : ℂ) + 1) ^ (1 - s) - ((n : ℂ) + 2) ^ (1 - s)) / (s - 1)
  have h_eq : riemannZeta s = 1 / (s - 1) + ∑' n : ℕ, T n :=
    eq_add_of_sub_eq' (h_s3 s hs_re_low hs_re_high hs_im)
  have hs_sub_one_norm : 2 ≤ ‖s - 1‖ := by
    have h1 : |s.im| = |(s - 1).im| := by simp
    have h2 := Complex.abs_im_le_norm (s - 1)
    linarith
  have h_pole_le : ‖1 / (s - 1)‖ ≤ 4 + |s.im| := by
    rw [norm_div, norm_one]
    have h1 : 1 / ‖s - 1‖ ≤ 1 / 2 :=
      div_le_div_of_nonneg_left (by norm_num) (by norm_num) hs_sub_one_norm
    linarith
  have hs_norm_le : ‖s‖ ≤ 4 + |s.im| := by
    have h1 := Complex.norm_le_abs_re_add_abs_im s
    have h2 : |s.re| = s.re := abs_of_pos (by linarith)
    linarith
  have hs_re_pos : 0 < s.re := by linarith
  have hs_ne_one : s ≠ 1 := by
    intro h
    rw [h, Complex.one_im, abs_zero] at hs_im
    linarith
  have hT_bound : ∀ n : ℕ, ‖T n‖ ≤ (4 + |s.im|) * u₀ n := by
    intro n
    have h1 := h_s1 n s hs_re_pos hs_ne_one
    have hn_ge_one : 1 ≤ (n : ℝ) + 1 := by linarith
    have h_exp : -s.re - 1 ≤ -(3 / 2 : ℝ) := by linarith
    have h2 : ((n : ℝ) + 1) ^ (-s.re - 1) ≤ u₀ n :=
      Real.rpow_le_rpow_of_exponent_le hn_ge_one h_exp
    have h3 : ‖s‖ * ((n : ℝ) + 1) ^ (-s.re - 1) ≤ (4 + |s.im|) * u₀ n :=
      mul_le_mul hs_norm_le h2 (by positivity) (by linarith)
    exact le_trans h1 h3
  have hT_norm_sum : Summable (fun n : ℕ => ‖T n‖) :=
    Summable.of_nonneg_of_le (fun n => norm_nonneg (T n)) hT_bound (hu₀_sum.mul_left (4 + |s.im|))
  have h_tsum_le : ‖∑' n : ℕ, T n‖ ≤ (4 + |s.im|) * ∑' n : ℕ, u₀ n := by
    calc ‖∑' n : ℕ, T n‖
      _ ≤ ∑' n : ℕ, ‖T n‖ := norm_tsum_le_tsum_norm hT_norm_sum
      _ ≤ ∑' n : ℕ, (4 + |s.im|) * u₀ n :=
          hT_norm_sum.tsum_le_tsum hT_bound (hu₀_sum.mul_left (4 + |s.im|))
      _ = (4 + |s.im|) * ∑' n : ℕ, u₀ n := tsum_mul_left
  calc ‖riemannZeta s‖
    _ = ‖1 / (s - 1) + ∑' n : ℕ, T n‖ := by rw [h_eq]
    _ ≤ ‖1 / (s - 1)‖ + ‖∑' n : ℕ, T n‖ := norm_add_le _ _
    _ ≤ (4 + |s.im|) + (4 + |s.im|) * ∑' n : ℕ, u₀ n := add_le_add h_pole_le h_tsum_le
    _ = A₁ * (4 + |s.im|) := by dsimp [A₁]; ring

theorem mitsui_zeroFree_disk_logDeriv_norm_le (g : ℂ → ℂ) (s₁ : ℂ) (M : ℝ) (hM : 0 ≤ M)
    (hg : ∀ z ∈ Metric.closedBall s₁ (1 / 2),
      DifferentiableAt ℂ g z ∧ g z ≠ 0 ∧ ‖g z‖ ≤ Real.exp M * ‖g s₁‖) :
    ∀ z ∈ Metric.closedBall s₁ (1 / 4),
      ‖deriv g z / g z‖ ≤ 48 * M :=
by
  intro z hz
  let U : Set ℂ := Metric.ball s₁ (1 / 2)
  have hU_sub : U ⊆ Metric.closedBall s₁ (1 / 2) := Metric.ball_subset_closedBall
  have hs₁_mem : s₁ ∈ U := Metric.mem_ball_self (by norm_num)
  have h_diff_on : DifferentiableOn ℂ g U :=
    fun w hw => (hg w (hU_sub hw)).1.differentiableWithinAt
  have h_deriv_on : DifferentiableOn ℂ (deriv g) U :=
    h_diff_on.deriv Metric.isOpen_ball
  have h_logDeriv_on : DifferentiableOn ℂ (fun w => deriv g w / g w) U :=
    fun w hw => (h_deriv_on w hw).div (h_diff_on w hw) (hg w (hU_sub hw)).2.1
  obtain ⟨L₀, hL₀⟩ := h_logDeriv_on.isExactOn_ball
  let L : ℂ → ℂ := fun w => L₀ w - L₀ s₁
  have hL_s₁ : L s₁ = 0 := sub_self _
  have hL_hasDeriv : ∀ w ∈ U, HasDerivAt L (deriv g w / g w) w :=
    fun w hw => (hL₀ w hw).sub_const (L₀ s₁)
  have hL_diff : ∀ w ∈ U, DifferentiableAt ℂ L w :=
    fun w hw => (hL_hasDeriv w hw).differentiableAt
  have hL_deriv_eq : ∀ w ∈ U, deriv L w = deriv g w / g w :=
    fun w hw => (hL_hasDeriv w hw).deriv
  let Φ : ℂ → ℂ := fun w => g w * Complex.exp (-L w)
  have hΦ_hasDeriv : ∀ w ∈ U, HasDerivAt Φ 0 w := by
    intro w hw
    have h1 : HasDerivAt g (deriv g w) w := (hg w (hU_sub hw)).1.hasDerivAt
    have h2 : HasDerivAt (fun u => Complex.exp (-L u)) (Complex.exp (-L w) * -(deriv g w / g w)) w :=
      ((hL_hasDeriv w hw).neg).cexp
    have h3 := h1.mul h2
    have h_zero : deriv g w * Complex.exp (-L w) + g w * (Complex.exp (-L w) * -(deriv g w / g w)) = 0 := by
      have hnz := (hg w (hU_sub hw)).2.1
      field_simp [hnz]
      ring
    rwa [h_zero] at h3
  have hΦ_diff_on : DifferentiableOn ℂ Φ U :=
    fun w hw => (hΦ_hasDeriv w hw).differentiableAt.differentiableWithinAt
  have hΦ_fderiv_zero : ∀ w ∈ U, fderivWithin ℂ Φ U w = 0 := by
    intro w hw
    have h1 : HasFDerivWithinAt Φ (0 : ℂ →L[ℂ] ℂ) U w := by
      have h2 := (hΦ_hasDeriv w hw).hasFDerivAt.hasFDerivWithinAt (s := U)
      simpa using h2
    exact h1.fderivWithin (Metric.isOpen_ball.uniqueDiffWithinAt hw)
  have hΦ_const : ∀ w ∈ U, Φ w = g s₁ := by
    intro w hw
    have h_eq := Convex.is_const_of_fderivWithin_eq_zero (convex_ball s₁ (1 / 2))
      hΦ_diff_on hΦ_fderiv_zero hw hs₁_mem
    dsimp [Φ] at h_eq
    rw [hL_s₁, neg_zero, Complex.exp_zero, mul_one] at h_eq
    exact h_eq
  have hL_re : ∀ w ∈ U, (L w).re ≤ M := by
    intro w hw
    have h_eq : g w = g s₁ * Complex.exp (L w) := by
      have h1 := hΦ_const w hw
      dsimp [Φ] at h1
      calc g w = g w * Complex.exp (-L w) * Complex.exp (L w) := by
            rw [mul_assoc, ← Complex.exp_add, neg_add_cancel, Complex.exp_zero, mul_one]
        _ = g s₁ * Complex.exp (L w) := by rw [h1]
    have h_norm : ‖g s₁‖ * Real.exp (L w).re ≤ Real.exp M * ‖g s₁‖ := by
      have h1 := (hg w (hU_sub hw)).2.2
      rw [h_eq, norm_mul, Complex.norm_exp] at h1
      exact h1
    have hs₁_pos : 0 < ‖g s₁‖ := norm_pos_iff.mpr (hg s₁ (hU_sub hs₁_mem)).2.1
    have h_exp : Real.exp (L w).re ≤ Real.exp M := by nlinarith
    exact Real.exp_le_exp.mp h_exp
  let R₁ : ℝ := 1 / 2
  have hR₁_pos : 0 < R₁ := by dsimp [R₁]; norm_num
  have hL_bc : ∀ w ∈ Metric.closedBall s₁ (3 / 8), ‖L w‖ ≤ 6 * M := by
    intro w hw
    have hw_dist : ‖w - s₁‖ ≤ 3 / 8 := by
      simpa [Metric.mem_closedBall, dist_eq_norm] using hw
    set v : ℂ := w - s₁
    have hv_ball : ‖v‖ < R₁ := by dsimp [R₁]; linarith
    have h_u_mem : ∀ u ∈ Metric.ball (0 : ℂ) R₁, s₁ + u ∈ U := by
      intro u hu
      rw [Metric.mem_ball, dist_zero_right] at hu
      rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left]
      exact hu
    apply le_of_forall_pos_le_add
    intro ε hε
    let A : ℝ := M + ε / 6
    have hA_pos : 0 < A := by dsimp [A]; linarith
    let ϕ : ℂ → ℂ := fun u => (R₁ : ℂ) * L (s₁ + u) / (2 * (A : ℂ) - L (s₁ + u))
    have h_denom_re : ∀ u ∈ Metric.ball (0 : ℂ) R₁, A ≤ (2 * (A : ℂ) - L (s₁ + u)).re := by
      intro u hu
      have h1 := hL_re (s₁ + u) (h_u_mem u hu)
      simp only [Complex.sub_re, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
        Complex.re_ofNat, Complex.im_ofNat, mul_zero, sub_zero]
      dsimp [A]; linarith
    have h_denom_ne : ∀ u ∈ Metric.ball (0 : ℂ) R₁, 2 * (A : ℂ) - L (s₁ + u) ≠ 0 := by
      intro u hu h0
      have h1 := h_denom_re u hu
      rw [h0, Complex.zero_re] at h1
      linarith
    have hϕ_diff : DifferentiableOn ℂ ϕ (Metric.ball (0 : ℂ) R₁) := by
      intro u hu
      refine DifferentiableAt.differentiableWithinAt ?_
      have hLu : DifferentiableAt ℂ (fun x => L (s₁ + x)) u :=
        (hL_diff (s₁ + u) (h_u_mem u hu)).comp u ((differentiableAt_const s₁).add differentiableAt_id)
      dsimp [ϕ]
      exact ((differentiableAt_const (R₁ : ℂ)).mul hLu).div
        ((differentiableAt_const (2 * (A : ℂ))).sub hLu) (h_denom_ne u hu)
    have hϕ_maps : Set.MapsTo ϕ (Metric.ball (0 : ℂ) R₁) (Metric.closedBall (0 : ℂ) R₁) := by
      intro u hu
      rw [Metric.mem_closedBall, dist_zero_right]
      dsimp [ϕ]
      rw [norm_div, norm_mul, Complex.norm_of_nonneg (le_of_lt hR₁_pos)]
      have h_le_denom : ‖L (s₁ + u)‖ ≤ ‖2 * (A : ℂ) - L (s₁ + u)‖ := by
