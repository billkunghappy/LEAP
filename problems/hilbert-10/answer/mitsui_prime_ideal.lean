  refine ⟨?_, ?_⟩
  · intro x hx_ne hx_q h_pos
    rw [h_prin_simple x hx_ne hx_q]
    refine Finset.prod_eq_one (fun w _ => ?_)
    rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw_real | hw_cplx
    · rw [h_real_pos x w hw_real (h_pos w hw_real), one_zpow]
    · rw [hL_cplx w hw_cplx, zpow_zero]
