  have hc₁_le_c₀ : c₁ ≤ c₀ := by
    have : 0 ≤ C * c₁ := by positivity
    dsimp [c₀]; linarith
  have hCc₁_le_c₀ : C * c₁ ≤ c₀ := by
    dsimp [c₀]; linarith
  have hexp_le :
      Real.exp (-Real.sqrt (Real.log Y) / c₁) ≤ Real.exp (-Real.sqrt (Real.log Y) / c₀) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
