by
  classical
  intro R r a_place Cube
  let Φ_emb : NumberField.InfinitePlace K → K → ℂ := fun w z =>
    if 0 ≤ l_eff w then w.embedding z else star (w.embedding z)
  have hΦ0 : ∀ w : NumberField.InfinitePlace K, Φ_emb w 0 = 0 := by
    intro w
    dsimp [Φ_emb]
    split_ifs <;> simp
