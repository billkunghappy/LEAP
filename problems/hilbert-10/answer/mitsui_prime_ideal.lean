            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
            ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
              Complex.exp
                (((∑ j : Fin (NumberField.Units.rank K),
                    y j *
                      (2 * Real.pi * (θ₀ j - (m_freq j : ℝ)) +
                        ∑ w : NumberField.InfinitePlace K,
                          (l_ang w : ℝ) *
                            (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg)) : ℝ) * Complex.I)) ≠
            ∏ w : NumberField.InfinitePlace K,
              (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w))
    (v_place : NumberField.InfinitePlace K → ℝ)
    (hv_sum : (∑ w : NumberField.InfinitePlace K, v_place w) = 0)
    (hv_eq : ∀ j : Fin (NumberField.Units.rank K),
      (∑ w : NumberField.InfinitePlace K,
        v_place w *
          Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
            w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) =
      2 * Real.pi * (θ₀ j - (m_freq j : ℝ)) +
        ∑ w : NumberField.InfinitePlace K,
          (l_ang w : ℝ) *
            (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg) :
    (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ f →
      χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
        ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
          Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I)) =
      ∏ w : NumberField.InfinitePlace K,
        (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w)) ∧
    (∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
      ∃ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) ⊔ f = ⊤ ∧
        x - 1 ∈ f' ∧
        χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
          ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
            Complex.exp (((∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) : ℝ) * Complex.I)) ≠
        ∏ w : NumberField.InfinitePlace K,
          (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w)) :=
by
  classical
  let n : ℕ := Module.finrank ℚ K
  let r : ℕ := NumberField.Units.rank K
  let Ω : Fin r → ℝ := fun j =>
    2 * Real.pi * (θ₀ j - (m_freq j : ℝ)) +
      ∑ w : NumberField.InfinitePlace K,
        (l_ang w : ℝ) *
          (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg
  have h_lin : ∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
      ∀ y : Fin r → ℝ,
        (∀ w : NumberField.InfinitePlace K,
          Real.log (w (x : K) / w₀ (x : K)) =
            ∑ j : Fin r,
              y j *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) →
        (∑ j : Fin r, y j * Ω j) =
          ∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K)) := by
    intro x hx_ne y hy
    have hxK_ne : (x : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx_ne
    have hw₀x_ne : w₀ (x : K) ≠ 0 := ne_of_gt (w₀.pos_iff.mpr hxK_ne)
    calc (∑ j : Fin r, y j * Ω j)
      _ = ∑ j : Fin r, y j *
            (∑ w : NumberField.InfinitePlace K,
              v_place w * Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) := by
          refine Finset.sum_congr rfl (fun j _ => by dsimp [Ω]; rw [← hv_eq j])
      _ = ∑ w : NumberField.InfinitePlace K,
            v_place w * (∑ j : Fin r, y j *
              Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) := by
          simp_rw [Finset.mul_sum]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun w _ => Finset.sum_congr rfl (fun j _ => by ring))
      _ = ∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K) / w₀ (x : K)) := by
          refine Finset.sum_congr rfl (fun w _ => by rw [← hy w])
      _ = (∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K))) -
            (∑ w : NumberField.InfinitePlace K, v_place w) * Real.log (w₀ (x : K)) := by
          rw [Finset.sum_mul, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun w _ => ?_)
          have hwx_ne : w (x : K) ≠ 0 := ne_of_gt (w.pos_iff.mpr hxK_ne)
          rw [Real.log_div hwx_ne hw₀x_ne, mul_sub]
      _ = ∑ w : NumberField.InfinitePlace K, v_place w * Real.log (w (x : K)) := by
          rw [hv_sum, zero_mul, sub_zero]
  let B_R : Module.Basis (Fin r) ℝ (NumberField.Units.dirichletUnitTheorem.logSpace K) :=
    Module.Basis.ofZLatticeBasis ℝ
      (NumberField.Units.unitLattice K)
      (NumberField.Units.basisUnitLattice K)
  have hn_pos : (0 : ℝ) < (n : ℝ) := by
    dsimp [n]
    exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
  have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  have h_sum_mult : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ)) = (n : ℝ) := by
    dsimp [n]
    exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
  let ℓ : NumberField.RingOfIntegers K → NumberField.InfinitePlace K → ℝ :=
    fun x w => Real.log (w (x : K)) -
      (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * Real.log (v (x : K))) / (n : ℝ)
  let L_vec : NumberField.RingOfIntegers K → NumberField.Units.dirichletUnitTheorem.logSpace K :=
    fun x w => (w.1.mult : ℝ) * ℓ x w.1
  let W₀ : NumberField.RingOfIntegers K → Fin r → ℝ :=
    fun x j => B_R.repr (L_vec x) j
  have hW₀_log : ∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
      ∀ w : NumberField.InfinitePlace K,
        Real.log (w (x : K) / w₀ (x : K)) =
          ∑ j : Fin r,
            W₀ x j *
              Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) := by
    intro x hx w
    let r_x : NumberField.InfinitePlace K → ℝ :=
      fun v => ∑ j : Fin r, W₀ x j *
        Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))
    let w_dir : NumberField.InfinitePlace K := NumberField.Units.dirichletUnitTheorem.w₀
    have h_ne_dir : ∀ v : NumberField.InfinitePlace K, v ≠ w_dir →
        (v.mult : ℝ) * ℓ x v = (v.mult : ℝ) * r_x v := by
      intro v hv
      let v_sub : {v : NumberField.InfinitePlace K // v ≠ w_dir} := ⟨v, hv⟩
      have h_basis := congr_fun (Module.Basis.sum_repr B_R (L_vec x)).symm v_sub
      change (v.mult : ℝ) * ℓ x v = (∑ j : Fin r, (W₀ x j) • B_R j) v_sub at h_basis
      rw [h_basis]
      have h_eval : (∑ j : Fin r, (W₀ x j) • B_R j) v_sub =
          ∑ j : Fin r, W₀ x j * (B_R j v_sub) := by
        simp [Finset.sum_apply]
      rw [h_eval]
      dsimp [r_x]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      have hB_j : B_R j v_sub =
          (v.mult : ℝ) *
            Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) := by
        dsimp [B_R]
        rw [Module.Basis.ofZLatticeBasis_apply, ← NumberField.Units.logEmbedding_fundSystem,
          NumberField.Units.dirichletUnitTheorem.logEmbedding_component]
      rw [hB_j]
      ring
    have h_sum_ℓ : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * ℓ x v) = 0 := by
      dsimp [ℓ]
      simp_rw [mul_sub]
      rw [Finset.sum_sub_distrib, ← Finset.sum_mul, h_sum_mult, mul_div_cancel₀ _ hn_ne, sub_self]
    have h_sum_r : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * r_x v) = 0 := by
      dsimp [r_x]
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_eq_zero (fun j _ => ?_)
      have h_comm : (∑ v : NumberField.InfinitePlace K,
          (v.mult : ℝ) * (W₀ x j *
            Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)))) =
          W₀ x j * (∑ v : NumberField.InfinitePlace K,
            (v.mult : ℝ) *
              Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun v _ => by ring)
      rw [h_comm]
      have h_unit_sum : (∑ v : NumberField.InfinitePlace K,
          (v.mult : ℝ) *
            Real.log (v (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) = 0 := by
        simpa using NumberField.Units.sum_mult_mul_log (NumberField.Units.fundSystem K j)
      rw [h_unit_sum, mul_zero]
    have h_all_mult : ∀ v : NumberField.InfinitePlace K,
        (v.mult : ℝ) * ℓ x v = (v.mult : ℝ) * r_x v := by
      intro v
      by_cases hv : v = w_dir
      · subst hv
        have h1 := (Finset.add_sum_erase Finset.univ (fun v : NumberField.InfinitePlace K => (v.mult : ℝ) * ℓ x v) (Finset.mem_univ w_dir)).symm
        have h2 := (Finset.add_sum_erase Finset.univ (fun v : NumberField.InfinitePlace K => (v.mult : ℝ) * r_x v) (Finset.mem_univ w_dir)).symm
        have h_erase : (∑ v ∈ Finset.univ.erase w_dir, (v.mult : ℝ) * ℓ x v) =
            (∑ v ∈ Finset.univ.erase w_dir, (v.mult : ℝ) * r_x v) :=
          Finset.sum_congr rfl (fun v hv_mem => h_ne_dir v (Finset.ne_of_mem_erase hv_mem))
        linarith
      · exact h_ne_dir v hv
    have h_all : ∀ v : NumberField.InfinitePlace K, ℓ x v = r_x v := by
      intro v
      have h_mult_pos : (0 : ℝ) < (v.mult : ℝ) := by
        exact_mod_cast NumberField.InfinitePlace.mult_pos (w := v)
      exact mul_left_cancel₀ (ne_of_gt h_mult_pos) (h_all_mult v)
    have hxK : (x : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx
    have hwx : w (x : K) ≠ 0 := ne_of_gt (w.pos_iff.mpr hxK)
    have hw₀x : w₀ (x : K) ≠ 0 := ne_of_gt (w₀.pos_iff.mpr hxK)
    calc Real.log (w (x : K) / w₀ (x : K))
      _ = Real.log (w (x : K)) - Real.log (w₀ (x : K)) := Real.log_div hwx hw₀x
      _ = ℓ x w - ℓ x w₀ := by dsimp [ℓ]; ring
      _ = r_x w - r_x w₀ := by rw [h_all w, h_all w₀]
      _ = ∑ j : Fin r, W₀ x j *
            Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
              w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) := by
        dsimp [r_x]
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        let η_j : K := (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)
        have hη_ne : η_j ≠ 0 :=
          NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero _)
        have hwη : w η_j ≠ 0 := ne_of_gt (w.pos_iff.mpr hη_ne)
        have hw₀η : w₀ η_j ≠ 0 := ne_of_gt (w₀.pos_iff.mpr hη_ne)
        rw [← mul_sub, ← Real.log_div hwη hw₀η]
  refine ⟨?_, ?_⟩
  · intro x hx_ne hx_mem
    obtain ⟨y, hy, h_eq⟩ := hχ₀_prin x hx_ne hx_mem
    have h_sum_eq := h_lin x hx_ne y hy
    dsimp [Ω, r] at h_sum_eq
    rw [← h_sum_eq]
    exact h_eq
  · intro f' hff' hf'ne
    obtain ⟨x, hx_ne, h_cop, hx_mem, h_ne⟩ := hχ₀_prim f' hff' hf'ne
    refine ⟨x, hx_ne, h_cop, hx_mem, ?_⟩
    have h_ne_W₀ := h_ne (W₀ x) (hW₀_log x hx_ne)
    have h_sum_eq := h_lin x hx_ne (W₀ x) (hW₀_log x hx_ne)
    dsimp [Ω, r] at h_sum_eq
    rw [← h_sum_eq]
    exact h_ne_W₀

theorem mitsui_shifted_theta_series_eq_of_stripped_unitRank_series {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (a_place : NumberField.InfinitePlace K → ℕ)
    (ν₁ ν₂ : NumberField.InfinitePlace K → ℝ)
    (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (ω_χ : ℂ) :
    let Q_K : (Fin (NumberField.Units.rank K) → ℝ) → ℝ := fun y =>
      ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * ∏ i : Fin (NumberField.Units.rank K),
          (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i)
    let U_K : (NumberField.InfinitePlace K → ℕ) → (Fin (NumberField.Units.rank K) → ℝ) → ℝ := fun a_place y =>
      ∏ w : NumberField.InfinitePlace K,
        (∏ i : Fin (NumberField.Units.rank K),
          (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (y i)) ^ (a_place w)
    let J_c : (NumberField.InfinitePlace K → ℕ) → (NumberField.InfinitePlace K → ℝ) → ℝ → ℂ := fun a_place ν_place a =>
      ∫ y : Fin (NumberField.Units.rank K) → ℝ,
        ((U_K a_place y * Real.exp (-a * Q_K y) : ℝ) : ℂ) *
          Complex.exp
            (((∑ w : NumberField.InfinitePlace K,
                ν_place w *
                  ∑ i : Fin (NumberField.Units.rank K),
                    y i * Real.log (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K))) : ℝ) *
              Complex.I)
    let W₀_c : (NumberField.InfinitePlace K → ℕ) → (NumberField.InfinitePlace K → ℝ) → ℝ → ℂ := fun a_place ν_place τ =>
      if 0 < τ then
        (((2 : ℝ) ^ (NumberField.InfinitePlace.nrRealPlaces K + NumberField.InfinitePlace.nrComplexPlaces K) *
          NumberField.Units.regulator K * τ⁻¹ *
          (τ ^ (1 / (Module.finrank ℚ K : ℝ))) ^ (∑ w : NumberField.InfinitePlace K, a_place w) : ℝ) : ℂ) *
          J_c a_place ν_place (Real.pi * τ ^ (2 / (Module.finrank ℚ K : ℝ)))
      else 0
    let S_f : ℝ := |(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) * (Ideal.absNorm f : ℝ) ^ (-1 / 2 : ℝ)
    let P_f : ℝ := (Ideal.absNorm f : ℝ) ^ (-3 / 4 : ℝ) * S_f
    let S_strip : (NumberField.InfinitePlace K → ℝ) → (nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ) → ℝ → ℂ :=
      fun ν_place ψ v =>
        ∑' m : ℕ,
          (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
            ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
            ((((S_f * ((m : ℝ) * v)) ^ (1 / (Module.finrank ℚ K : ℝ))) ^ (∑ w : NumberField.InfinitePlace K, a_place w) : ℝ) : ℂ) *
            J_c a_place ν_place (Real.pi * (S_f * ((m : ℝ) * v)) ^ (2 / (Module.finrank ℚ K : ℝ)))
    (∀ u ∈ Set.Ioi (0 : ℝ),
      S_strip ν₁ χ₀ u⁻¹ = (u : ℂ) * ω_χ * S_strip ν₂ ((starRingEnd ℂ).toMonoidHom.comp χ₀) u) →
    ∀ u ∈ Set.Ioi (1 : ℝ),
      ((u ^ (-3 : ℝ) : ℝ) : ℂ) *
        ((1 : ℂ) * ∑' m : ℕ,
          (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
            χ₀ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
            ((m : ℂ) * ((P_f : ℂ) * W₀_c a_place ν₁ (S_f * ((m : ℝ) * u⁻¹))))) =
        ω_χ * ∑' m : ℕ,
          (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
            ((starRingEnd ℂ).toMonoidHom.comp χ₀) ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
            ((m : ℂ) * ((P_f : ℂ) * W₀_c a_place ν₂ (S_f * ((m : ℝ) * u)))) ∧
      ((u ^ (-3 : ℝ) : ℝ) : ℂ) *
        (ω_χ * ∑' m : ℕ,
          (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
            ((starRingEnd ℂ).toMonoidHom.comp χ₀) ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
            ((m : ℂ) * ((P_f : ℂ) * W₀_c a_place ν₂ (S_f * ((m : ℝ) * u⁻¹))))) =
        (1 : ℂ) * ∑' m : ℕ,
          (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
            χ₀ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
            ((m : ℂ) * ((P_f : ℂ) * W₀_c a_place ν₁ (S_f * ((m : ℝ) * u)))) :=
by
  intro Q_K U_K J_c W₀_c S_f P_f S_strip h_strip u hu
  have hu1 : 1 < u := Set.mem_Ioi.mp hu
  have hu_pos : 0 < u := lt_trans zero_lt_one hu1
  have hu_inv_pos : 0 < u⁻¹ := inv_pos.mpr hu_pos
  have hu_ne : u ≠ 0 := ne_of_gt hu_pos
  have huc_ne : (u : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hu_ne
  set D : ℝ := |(NumberField.discr K : ℝ)|
  set N_f : ℝ := (Ideal.absNorm f : ℝ)
  set P_K : ℝ := (2 : ℝ) ^ (NumberField.InfinitePlace.nrRealPlaces K + NumberField.InfinitePlace.nrComplexPlaces K) *
    NumberField.Units.regulator K
  have hD_pos : 0 < D := by
    dsimp [D]
    exact abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  have hf_norm_ne : Ideal.absNorm f ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hf
  have hNf_pos : 0 < N_f := by
    dsimp [N_f]
    exact_mod_cast Nat.pos_of_ne_zero hf_norm_ne
  have hSf_pos : 0 < S_f := by
    dsimp [S_f]
    positivity
  have hSf_ne : S_f ≠ 0 := ne_of_gt hSf_pos
  have hSfc_ne : (S_f : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hSf_ne
  have h_term : ∀ (ν_place : NumberField.InfinitePlace K → ℝ)
      (ψ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
      (v : ℝ), 0 < v → ∀ m : ℕ,
      (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
        ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
        ((m : ℂ) * ((P_f : ℂ) * W₀_c a_place ν_place (S_f * ((m : ℝ) * v)))) =
      ((P_K * N_f ^ (-3 / 4 : ℝ) * v⁻¹ : ℝ) : ℂ) *
        ((∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
          ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
          ((((S_f * ((m : ℝ) * v)) ^ (1 / (Module.finrank ℚ K : ℝ))) ^ (∑ w : NumberField.InfinitePlace K, a_place w) : ℝ) : ℂ) *
          J_c a_place ν_place (Real.pi * (S_f * ((m : ℝ) * v)) ^ (2 / (Module.finrank ℚ K : ℝ)))) := by
    intro ν_place ψ v hv m
    by_cases hm : m = 0
    · subst hm
      haveI : IsEmpty {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = 0} :=
        ⟨fun ⟨I, hI_ne, hI_norm⟩ => hI_ne (Ideal.absNorm_eq_zero_iff.mp hI_norm)⟩
      rw [tsum_empty]
      simp
    · have hm_pos : 0 < (m : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hm)
      have hm_ne : (m : ℝ) ≠ 0 := ne_of_gt hm_pos
      have hmc_ne : (m : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hm
      have hv_ne : v ≠ 0 := ne_of_gt hv
      have hvc_ne : (v : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hv_ne
      have hτ_pos : 0 < S_f * ((m : ℝ) * v) := by positivity
      dsimp [W₀_c]
      rw [if_pos hτ_pos]
      change _ = ((P_K * N_f ^ (-3 / 4 : ℝ) * v⁻¹ : ℝ) : ℂ) * _
      have hPf_eq : (P_f : ℂ) = ((N_f ^ (-3 / 4 : ℝ) : ℝ) : ℂ) * (S_f : ℂ) := by
        dsimp [P_f, N_f]
        push_cast
        rfl
      rw [hPf_eq]
      dsimp [P_K]
      push_cast
      field_simp [hSfc_ne, hmc_ne, hvc_ne]
  have h_sum : ∀ (ν_place : NumberField.InfinitePlace K → ℝ)
      (ψ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
      (v : ℝ), 0 < v →
      (∑' m : ℕ,
        (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
          ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
          ((m : ℂ) * ((P_f : ℂ) * W₀_c a_place ν_place (S_f * ((m : ℝ) * v))))) =
      ((P_K * N_f ^ (-3 / 4 : ℝ) * v⁻¹ : ℝ) : ℂ) * S_strip ν_place ψ v := by
    intro ν_place ψ v hv
    dsimp [S_strip]
    simp_rw [h_term ν_place ψ v hv]
    exact tsum_mul_left
  set χ_dual : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ :=
    (starRingEnd ℂ).toMonoidHom.comp χ₀
  have h_inv1 := h_strip u hu_pos
  have h_inv2 := h_strip u⁻¹ hu_inv_pos
  rw [inv_inv] at h_inv2
  have hu3 : u ^ (-3 : ℝ) = (u ^ 3)⁻¹ := by
    rw [Real.rpow_neg (le_of_lt hu_pos)]
    norm_num
  have h_alg1 : ∀ T : ℂ,
      ((u ^ (-3 : ℝ) : ℝ) : ℂ) * ((1 : ℂ) * (((P_K * N_f ^ (-3 / 4 : ℝ) * (u⁻¹)⁻¹ : ℝ) : ℂ) * ((u : ℂ) * ω_χ * T))) =
      ω_χ * (((P_K * N_f ^ (-3 / 4 : ℝ) * u⁻¹ : ℝ) : ℂ) * T) := by
    intro T
    rw [hu3]
    push_cast
    field_simp [huc_ne]
  have h_alg2 : ∀ T : ℂ,
      ((u ^ (-3 : ℝ) : ℝ) : ℂ) * (ω_χ * (((P_K * N_f ^ (-3 / 4 : ℝ) * (u⁻¹)⁻¹ : ℝ) : ℂ) * T)) =
      (1 : ℂ) * (((P_K * N_f ^ (-3 / 4 : ℝ) * u⁻¹ : ℝ) : ℂ) * (((u⁻¹ : ℝ) : ℂ) * ω_χ * T)) := by
    intro T
    rw [hu3]
    push_cast
    field_simp [huc_ne]
  refine ⟨?_, ?_⟩
  · rw [h_sum ν₁ χ₀ u⁻¹ hu_inv_pos, h_sum ν₂ χ_dual u hu_pos, h_inv1]
    exact h_alg1 _
  · rw [h_sum ν₂ χ_dual u⁻¹ hu_inv_pos, h_sum ν₁ χ₀ u hu_pos, h_inv2]
    exact h_alg2 _

theorem mitsui_stripped_unitRank_series_eq_sum_classGroup_principal_subideals {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (a_place : NumberField.InfinitePlace K → ℕ) :
    let R := NumberField.RingOfIntegers K
    let n : ℕ := Module.finrank ℚ K
    let Q_K : (Fin (NumberField.Units.rank K) → ℝ) → ℝ := fun y =>
      ∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * ∏ i : Fin (NumberField.Units.rank K),
          (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)
    let U_K : (Fin (NumberField.Units.rank K) → ℝ) → ℝ := fun y =>
      ∏ w : NumberField.InfinitePlace K,
        (∏ i : Fin (NumberField.Units.rank K),
          (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (y i)) ^ (a_place w)
    let J_c : (NumberField.InfinitePlace K → ℝ) → ℝ → ℂ := fun ν_place a =>
      ∫ y : Fin (NumberField.Units.rank K) → ℝ,
        ((U_K y * Real.exp (-a * Q_K y) : ℝ) : ℂ) *
          Complex.exp
            (((∑ w : NumberField.InfinitePlace K,
                ν_place w *
                  ∑ i : Fin (NumberField.Units.rank K),
                    y i * Real.log (w ((NumberField.Units.fundSystem K i : R) : K))) : ℝ) *
              Complex.I)
    let S_f : ℝ := |(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) * (Ideal.absNorm f : ℝ) ^ (-1 / 2 : ℝ)
    let S_strip : (NumberField.InfinitePlace K → ℝ) → (nonZeroDivisors (Ideal R) →* ℂ) → ℝ → ℂ :=
      fun ν_place ψ v =>
        ∑' m : ℕ,
          (∑' I : {I : Ideal R // I ≠ ⊥ ∧ Ideal.absNorm I = m},
            ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
            ((((S_f * ((m : ℝ) * v)) ^ (1 / (n : ℝ))) ^ (∑ w : NumberField.InfinitePlace K, a_place w) : ℝ) : ℂ) *
            J_c ν_place (Real.pi * (S_f * ((m : ℝ) * v)) ^ (2 / (n : ℝ)))
    ∃ J_rep : ClassGroup R → nonZeroDivisors (Ideal R),
      (∀ C : ClassGroup R, ClassGroup.mk0 (J_rep C) = C⁻¹) ∧
      (∀ C : ClassGroup R, (J_rep C : Ideal R) ⊔ f = ⊤) ∧
      ∀ (ν_place : NumberField.InfinitePlace K → ℝ)
        (ψ : nonZeroDivisors (Ideal R) →* ℂ),
        (∀ I : nonZeroDivisors (Ideal R),
          ((I : Ideal R) ⊔ f = ⊤ → ‖ψ I‖ = 1) ∧
          (¬ ((I : Ideal R) ⊔ f = ⊤) → ψ I = 0)) →
        ∀ v ∈ Set.Ioi (0 : ℝ),
          S_strip ν_place ψ v =
            ∑ C : ClassGroup R,
              star (ψ (J_rep C)) *
                (∑' m : ℕ,
                  (∑' I : {I : Ideal R // I ≠ ⊥ ∧ I ≤ (J_rep C : Ideal R) ∧ I.IsPrincipal ∧
                        Ideal.absNorm I = m * Ideal.absNorm (J_rep C : Ideal R)},
                    ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
