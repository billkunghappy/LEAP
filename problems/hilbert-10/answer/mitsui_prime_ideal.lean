      |Ψ₁_cell Y - M_coeff * Y| +
      |M_coeff * (Real.exp δ - 1 - δ) * Y| +
      |(Ψ₁_cell (Real.exp δ * Y) - Ψ₁_cell Y) - δ * ψ_cell Y| := by
    have h_eq : δ * (ψ_cell Y - M_coeff * Y) =
        ((Ψ₁_cell (Real.exp δ * Y) - M_coeff * (Real.exp δ * Y)) -
