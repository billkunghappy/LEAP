      rw [Ideal.mul_sup, sup_eq_right]
      exact h_le
    have h_sup_eq : Ideal.span ({v} : Set R) ⊔ (f * (B₀ : Ideal R)) = f * (B₀ : Ideal R) :=
      mul_left_cancel₀ hd_ne h_sup
    have hv_le : Ideal.span ({v} : Set R) ≤ f * (B₀ : Ideal R) := le_sup_left.trans h_sup_eq.le
    exact hv_le (Ideal.mem_span_singleton_self v)
  have he_B₀_congr : ∀ (z₁ z₂ : R),
      z₁ - z₂ ∈ (B₀ : Ideal R) → Ideal.Quotient.mk f z₁ = Ideal.Quotient.mk f z₂ →
