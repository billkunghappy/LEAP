      have h_diff_fB₀ : β (u₁ * a) - c₁ C * α_C C a ∈ f * (B₀ : Ideal R) := by
        rw [h_fB₀_eq_inf, Submodule.mem_inf]
        refine ⟨(B₀ : Ideal R).sub_mem (hβ (u₁ * a)).1 (Ideal.mul_mem_right (α_C C a) (B₀ : Ideal R) hc₁_mem), ?_⟩
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, (hβ (u₁ * a)).2, ((hα_C_spec C).1 a).2]
        exact sub_self (u₁ * a)
      exact Ideal.mul_mem_right x_star.1 (f * (B₀ : Ideal R)) h_diff_fB₀
    have h_congr_β :
        Complex.exp (2 * Real.pi * Complex.I *
          (Algebra.trace ℚ K ((β (u₁ * a) : K) * (x_star.1 : K) / (γ₀ : K)) : ℂ)) =
        Complex.exp (2 * Real.pi * Complex.I *
          (Algebra.trace ℚ K (((c₁ C * α_C C a * x_star.1 : R) : K) / (γ₀ : K)) : ℂ)) := by
      have h_sub' : β (u₁ * a) * x_star.1 - c₁ C * α_C C a * x_star.1 ∈ f * (B₀ : Ideal R) := by
        have h_alg : β (u₁ * a) * x_star.1 - c₁ C * α_C C a * x_star.1 =
            (β (u₁ * a) - c₁ C * α_C C a) * x_star.1 := by ring
        rw [h_alg]; exact h_sub_β
      have h1 := h_exp_congr (f * (B₀ : Ideal R)) γ₀ hγ₀ h_span_fB₀
        (β (u₁ * a) * x_star.1) (c₁ C * α_C C a * x_star.1) h_sub'
      push_cast at h1 ⊢
      exact h1
    have h_div_eq : (((c₂ C * α_C C a * x_star.1 : R) : K) / (γ_C C : K)) =
        (((c₁ C * α_C C a * x_star.1 : R) : K) / (γ₀ : K)) := by
      have hγC_K : (γ_C C : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hγC_ne
      have hγ₀_K : (γ₀ : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hγ₀
      have h_cross_K : (γ_C C : K) * (c₁ C : K) = (γ₀ : K) * (c₂ C : K) := by
        exact_mod_cast h_cross
      push_cast
      rw [div_eq_div_iff hγC_K hγ₀_K]
      calc (c₂ C : K) * (α_C C a : K) * (x_star.1 : K) * (γ₀ : K)
          = ((γ₀ : K) * (c₂ C : K)) * ((α_C C a : K) * (x_star.1 : K)) := by ring
        _ = ((γ_C C : K) * (c₁ C : K)) * ((α_C C a : K) * (x_star.1 : K)) := by rw [← h_cross_K]
        _ = (c₁ C : K) * (α_C C a : K) * (x_star.1 : K) * (γ_C C : K) := by ring
    rw [h_congr_α, h_congr_β, h_div_eq]
  let S_common : ℂ := ∑ a : R ⧸ f,
    ψ_f a *
      Complex.exp (2 * Real.pi * Complex.I *
        (Algebra.trace ℚ K ((β (u₁ * a) : K) * (x_star.1 : K) / (γ₀ : K)) : ℂ))
  have h_lhs_sum :
      (∑' a : R ⧸ f,
        ψ_f a *
          Complex.exp (2 * Real.pi * Complex.I *
            (Algebra.trace ℚ K ((α_C C a : K) * (x_star.1 : K) / (γ_C C : K)) : ℂ))) =
      ψ_f u₂ * S_common := by
    rw [tsum_fintype, ← Equiv.sum_comp e_u₂]
    dsimp [e_u₂, S_common]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [hψ_mul u₂ a, h_exp_eq a, mul_assoc]
  have h_rhs_sum : S₀ x_star.1 = ψ_f u₁ * S_common := by
    dsimp [S₀]
    rw [← Equiv.sum_comp e_u₁]
    dsimp [e_u₁, S_common]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [hψ_mul u₁ a, mul_assoc]
  have h_u₁_norm : ‖ψ_f u₁‖ = 1 := (hψ_unit u₁).1 hc₁_u
  have h_u₁_conj : star (ψ_f u₁) * ψ_f u₁ = 1 := by
    have h1 := Complex.conj_mul' (ψ_f u₁)
    change star (ψ_f u₁) * ψ_f u₁ = (‖ψ_f u₁‖ : ℂ) ^ 2 at h1
    rw [h1, h_u₁_norm, Complex.ofReal_one, one_pow]
  have h_reindex_eq :
      (∑' a : R ⧸ f,
        ψ_f a *
          Complex.exp (2 * Real.pi * Complex.I *
            (Algebra.trace ℚ K ((α_C C a : K) * (x_star.1 : K) / (γ_C C : K)) : ℂ))) =
      ψ_f u₂ * star (ψ_f u₁) * S₀ x_star.1 := by
    rw [h_lhs_sum, h_rhs_sum]
    calc ψ_f u₂ * S_common
        = ψ_f u₂ * (1 * S_common) := by rw [one_mul]
      _ = ψ_f u₂ * ((star (ψ_f u₁) * ψ_f u₁) * S_common) := by rw [← h_u₁_conj]
      _ = ψ_f u₂ * star (ψ_f u₁) * (ψ_f u₁ * S_common) := by ring
  rw [h_reindex_eq, hS₀_eval x_star.1]
  dsimp [ω_χ, τ₀, u₁, u₂]
  calc star (χ₀ (J_rep C)) *
        ((((Ideal.absNorm f : ℝ) ^ (-1 / 2 : ℝ) : ℝ) : ℂ) *
          (ψ_f (Ideal.Quotient.mk f (c₂ C)) * star (ψ_f (Ideal.Quotient.mk f (c₁ C))) *
            (S₀ 1 * star (ψ_f (Ideal.Quotient.mk f x_star.1)))))
      = (star (χ₀ (J_rep C)) * ψ_f (Ideal.Quotient.mk f (c₂ C)) *
          star (ψ_f (Ideal.Quotient.mk f (c₁ C)))) *
          ((((Ideal.absNorm f : ℝ) ^ (-1 / 2 : ℝ) : ℝ) : ℂ) * S₀ 1) *
          star (ψ_f (Ideal.Quotient.mk f x_star.1)) := by ring
    _ = (star (χ₀ B₀) * χ₀ (J_rep (σ C))) *
          ((((Ideal.absNorm f : ℝ) ^ (-1 / 2 : ℝ) : ℝ) : ℂ) * S₀ 1) *
          star (ψ_f (Ideal.Quotient.mk f x_star.1)) := by rw [h_char_eq]
    _ = star (χ₀ B₀) * ((((Ideal.absNorm f : ℝ) ^ (-1 / 2 : ℝ) : ℝ) : ℂ) * S₀ 1) *
          χ₀ (J_rep (σ C)) * star (ψ_f (Ideal.Quotient.mk f x_star.1)) := by ring

theorem mitsui_shifted_ideal_lattice_poisson_summation {K : Type u} [Field K] [NumberField K]
    (M J_star : Ideal (NumberField.RingOfIntegers K)) (hM : M ≠ 0) (hJ_star : J_star ≠ 0)
    (γ : NumberField.RingOfIntegers K) (hγ : γ ≠ 0)
    (h_dual : differentIdeal ℤ (NumberField.RingOfIntegers K) * M * J_star =
      Ideal.span ({γ} : Set (NumberField.RingOfIntegers K)))
    (α : NumberField.RingOfIntegers K)
    (t : NumberField.InfinitePlace K → ℝ) (ht : ∀ w : NumberField.InfinitePlace K, 0 < t w) :
    let R := NumberField.RingOfIntegers K
    let D : ℝ := |(NumberField.discr K : ℝ)|
    Summable (fun m : M =>
      Real.exp (-Real.pi *
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * t w * (w ((α + m.1 : R) : K)) ^ 2)) ∧
    Summable (fun x_star : J_star =>
      Real.exp (-Real.pi *
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (t w)⁻¹ * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2)) ∧
    (∑' m : M,
      (Real.exp (-Real.pi *
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * t w * (w ((α + m.1 : R) : K)) ^ 2) : ℂ)) =
      (((D ^ (1 / 2 : ℝ) * (Ideal.absNorm M : ℝ) *
          ∏ w : NumberField.InfinitePlace K, (t w) ^ ((w.mult : ℝ) / 2))⁻¹ : ℝ) : ℂ) *
        ∑' x_star : J_star,
          Complex.exp (2 * Real.pi * Complex.I *
            (Algebra.trace ℚ K ((α : K) * (x_star.1 : K) / (γ : K)) : ℂ)) *
            (Real.exp (-Real.pi *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (t w)⁻¹ * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2) : ℂ) :=
by
  intro R D
  set n : ℕ := Module.finrank ℚ K
  obtain ⟨v₁, v₂, e₁, e₂, u, h_lin₁, h_lin₂, h_tr, h_dual_v, h_det⟩ :=
    mitsui_shifted_ideal_lattice_trace_dual_zbasis_and_det M J_star hM hJ_star γ hγ h_dual α
  have hD_pos : 0 < D := by
    dsimp [D]
    exact abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  have hM_bot : M ≠ ⊥ := hM
  have hNM_pos : 0 < (Ideal.absNorm M : ℝ) := by
    exact_mod_cast Nat.pos_of_ne_zero (Ideal.absNorm_eq_zero_iff.not.mpr hM_bot)
  set Δ : ℝ := D ^ (1 / 2 : ℝ) * (Ideal.absNorm M : ℝ)
  have hΔ_pos : 0 < Δ := by dsimp [Δ]; positivity
  have hΔ_sq : Δ ^ 2 = D * (Ideal.absNorm M : ℝ) ^ 2 := by
    dsimp [Δ]
    rw [mul_pow, ← Real.rpow_natCast (D ^ (1 / 2 : ℝ)) 2, ← Real.rpow_mul (le_of_lt hD_pos)]
    norm_num
  have hγ_K : (γ : K) ≠ 0 := by exact_mod_cast hγ
  obtain ⟨A, _d, hA_ne, hA_det, _hd_le, _hd_sum, _hP_norm, _hP_cplx, hP_quad, _hD_norm, _hD_cplx, hD_quad⟩ :=
    mitsui_infinitePlace_harmonic_euclidean_trace_duality
      (fun i => (v₁ i : K)) (fun i => (v₂ i : K)) (γ : K) hγ_K
      Δ hΔ_pos h_dual_v (h_det.trans hΔ_sq.symm)
      (fun _ : NumberField.InfinitePlace K => 0) (fun _ _ => zero_le_one) (fun _ _ => rfl) t ht
  have hq_cast : ∀ k : Fin n → ℤ,
      (fun i : Fin n => ((u i + (k i : ℚ) : ℚ) : ℝ)) = (fun i : Fin n => (u i : ℝ) + (k i : ℝ)) := by
    intro k
    ext i
    push_cast
    rfl
  have hP_quad_k : ∀ k : Fin n → ℤ,
      (∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * t w * (w ((α + (e₁ k).1 : R) : K)) ^ 2) =
      ∑ j : Fin n, (A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) j) ^ 2 := by
    intro k
    rw [h_lin₁ k, hP_quad (fun i => u i + (k i : ℚ)), hq_cast k]
  have hD_quad_l : ∀ l : Fin n → ℤ,
      (∑ w : NumberField.InfinitePlace K,
        (w.mult : ℝ) * (t w)⁻¹ * (w (((e₂ l).1 : R) : K) / w (γ : K)) ^ 2) =
      ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2 := by
    intro l
    rw [h_lin₂ l, hD_quad l]
  have h_tr_l : ∀ l : Fin n → ℤ,
      (Algebra.trace ℚ K ((α : K) * (((e₂ l).1 : R) : K) / (γ : K)) : ℂ) =
      (∑ i : Fin n, (u i : ℝ) * (l i : ℝ) : ℂ) := by
    intro l
    rw [h_tr l]
    push_cast
    rfl
  have h_det_dual : ∀ {N : ℕ} (B : Matrix (Fin N) (Fin N) ℝ), B.det ≠ 0 → B.transpose⁻¹.det ≠ 0 := by
    intro N B hB
    rw [Matrix.det_nonsing_inv, Matrix.det_transpose, Ring.inverse_eq_inv]
    exact inv_ne_zero hB
  have h_sum_zero : ∀ {N : ℕ} (B : Matrix (Fin N) (Fin N) ℝ), B.det ≠ 0 →
      Summable (fun k : Fin N → ℤ =>
        Real.exp (-Real.pi * ∑ j : Fin N, (B.mulVec (fun i => (k i : ℝ)) j) ^ 2)) := by
    intro N B hB
    have h0 := mitsui_matrix_lattice_shifted_gaussian_summable N B hB 0
    refine h0.congr (fun k => ?_)
    have hk : (fun i : Fin N => (k i : ℝ) + (0 : Fin N → ℝ) i) = (fun i : Fin N => (k i : ℝ)) := by
      ext i; exact add_zero _
    rw [hk]
  have h_summable_M : Summable (fun m : M =>
      Real.exp (-Real.pi *
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * t w * (w ((α + m.1 : R) : K)) ^ 2)) := by
    rw [← e₁.summable_iff]
    have h_eq :
        ((fun m : M =>
          Real.exp (-Real.pi *
            ∑ w : NumberField.InfinitePlace K,
              (w.mult : ℝ) * t w * (w ((α + m.1 : R) : K)) ^ 2)) ∘ ⇑e₁) =
        (fun k : Fin n → ℤ =>
          Real.exp (-Real.pi *
            ∑ j : Fin n, (A.mulVec (fun i => (k i : ℝ) + (u i : ℝ)) j) ^ 2)) := by
      ext k
      dsimp [Function.comp]
      rw [hP_quad_k k]
      have h_vec : (fun i : Fin n => (u i : ℝ) + (k i : ℝ)) = (fun i : Fin n => (k i : ℝ) + (u i : ℝ)) := by
        ext i; exact add_comm _ _
      rw [h_vec]
    rw [h_eq]
    exact mitsui_matrix_lattice_shifted_gaussian_summable n A hA_ne (fun i => (u i : ℝ))
  have h_summable_J : Summable (fun x_star : J_star =>
      Real.exp (-Real.pi *
        ∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (t w)⁻¹ * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2)) := by
    rw [← e₂.summable_iff]
    have h_eq :
        ((fun x_star : J_star =>
          Real.exp (-Real.pi *
            ∑ w : NumberField.InfinitePlace K,
              (w.mult : ℝ) * (t w)⁻¹ * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2)) ∘ ⇑e₂) =
        (fun l : Fin n → ℤ =>
          Real.exp (-Real.pi *
            ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2)) := by
      ext l
      dsimp [Function.comp]
      rw [hD_quad_l l]
    rw [h_eq]
    exact h_sum_zero A.transpose⁻¹ (h_det_dual A hA_ne)
  refine ⟨h_summable_M, h_summable_J, ?_⟩
  have h_phased : ∀ (N : ℕ) (B : Matrix (Fin N) (Fin N) ℝ), B.det ≠ 0 → ∀ y : Fin N → ℝ,
      (∑' k : Fin N → ℤ,
        Complex.exp ((-Real.pi * ∑ j : Fin N, (B.mulVec (fun i => (k i : ℝ)) j) ^ 2 : ℝ) +
          2 * Real.pi * Complex.I * ∑ l : Fin N, (y l * (k l : ℝ) : ℂ))) =
      ((|B.det|⁻¹ : ℝ) : ℂ) *
        ∑' m : Fin N → ℤ,
          (Real.exp (-Real.pi * ∑ j : Fin N,
            (B.transpose⁻¹.mulVec (fun i => (m i : ℝ) - y i) j) ^ 2) : ℂ) := by
    intro N
    induction' N with N ih
    · intro B _hB y
      rw [tsum_fintype, tsum_fintype]
      simp [Matrix.det_fin_zero]
    · intro B hB y
      obtain ⟨d₀, c, M', hd₀, hM', hdet, hQ_primal, hQ_dual⟩ :=
        mitsui_matrix_succ_orthogonal_column_split N B hB
      have h_sum : Summable (fun k : Fin (N + 1) → ℤ =>
          Real.exp (-Real.pi *
            (d₀ ^ 2 * ((k 0 : ℝ) + ∑ i : Fin N, c i * (k i.succ : ℝ)) ^ 2 +
              ∑ i : Fin N, (M'.mulVec (fun l => (k l.succ : ℝ)) i) ^ 2))) := by
        refine (h_sum_zero B hB).congr (fun k => ?_)
        rw [hQ_primal (fun i => (k i : ℝ))]
      have h_sum' : Summable (fun k' : Fin N → ℤ =>
          Real.exp (-Real.pi * ∑ i : Fin N, (M'.mulVec (fun l => (k' l : ℝ)) i) ^ 2)) :=
        h_sum_zero M' hM'
      have h_dual' : ∀ w' : Fin N → ℝ,
          Summable (fun m' : Fin N → ℤ =>
            Real.exp (-Real.pi * ∑ i : Fin N,
              (M'.transpose⁻¹.mulVec (fun l => (m' l : ℝ) - w' l) i) ^ 2)) := by
        intro w'
        have hw := mitsui_matrix_lattice_shifted_gaussian_summable N M'.transpose⁻¹ (h_det_dual M' hM') (-w')
        refine hw.congr (fun m' => ?_)
        have hm : (fun l : Fin N => (m' l : ℝ) + (-w') l) = (fun l : Fin N => (m' l : ℝ) - w' l) := by
          ext l; exact (sub_eq_add_neg _ _).symm
        rw [hm]
      have h_lhs :
          (∑' k : Fin (N + 1) → ℤ,
            Complex.exp ((-Real.pi * ∑ j : Fin (N + 1), (B.mulVec (fun i => (k i : ℝ)) j) ^ 2 : ℝ) +
              2 * Real.pi * Complex.I * ∑ l : Fin (N + 1), (y l * (k l : ℝ) : ℂ))) =
          (∑' k : Fin (N + 1) → ℤ,
            Complex.exp
              ((-Real.pi *
                  (d₀ ^ 2 * ((k 0 : ℝ) + ∑ i : Fin N, c i * (k i.succ : ℝ)) ^ 2 +
                    ∑ i : Fin N, (M'.mulVec (fun l => (k l.succ : ℝ)) i) ^ 2) : ℝ) +
                2 * Real.pi * Complex.I * ∑ j : Fin (N + 1), (y j * (k j : ℝ) : ℂ))) := by
        refine tsum_congr (fun k => ?_)
        rw [hQ_primal (fun i => (k i : ℝ))]
      have h_rhs :
          (∑' m : Fin (N + 1) → ℤ,
            (Real.exp (-Real.pi * ∑ j : Fin (N + 1),
              (B.transpose⁻¹.mulVec (fun i => (m i : ℝ) - y i) j) ^ 2) : ℂ)) =
          (∑' m : Fin (N + 1) → ℤ,
            (Real.exp
              (-Real.pi *
                ((d₀⁻¹) ^ 2 * ((m 0 : ℝ) - y 0) ^ 2 +
                  ∑ i : Fin N,
                    (M'.transpose⁻¹.mulVec
                      (fun l => ((m l.succ : ℝ) - y l.succ) - ((m 0 : ℝ) - y 0) * c l) i) ^ 2)) : ℂ)) := by
        refine tsum_congr (fun m => ?_)
        rw [hQ_dual (fun i => (m i : ℝ) - y i)]
      rw [h_lhs, hdet, h_rhs]
      exact mitsui_block_quadratic_phased_gaussian_poisson_step N d₀ hd₀ c M' hM' h_sum h_sum' h_dual' (ih M' hM') y
  have h_base :
      (∑' k : Fin n → ℤ,
        (Real.exp (-Real.pi *
          ∑ j : Fin n, (A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) j) ^ 2) : ℂ)) =
      ((|A.det|⁻¹ : ℝ) : ℂ) *
        ∑' l : Fin n → ℤ,
          Complex.exp (2 * Real.pi * Complex.I *
            (∑ i : Fin n, (u i : ℝ) * (l i : ℝ) : ℂ)) *
            (Real.exp (-Real.pi *
              ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ) := by
    let u' : Fin n → ℝ := fun i => (u i : ℝ)
    have hp := h_phased n A.transpose⁻¹ (h_det_dual A hA_ne) u'
    have h_inv_inv : (A.transpose⁻¹).transpose⁻¹ = A := by
      have hA_unit : IsUnit A.det := isUnit_iff_ne_zero.mpr hA_ne
      rw [Matrix.transpose_nonsing_inv, Matrix.transpose_transpose, Matrix.nonsing_inv_nonsing_inv A hA_unit]
    have h_det_inv : |(A.transpose⁻¹).det|⁻¹ = |A.det| := by
      rw [Matrix.det_nonsing_inv, Matrix.det_transpose, Ring.inverse_eq_inv, abs_inv, inv_inv]
    rw [h_inv_inv, h_det_inv] at hp
    have h_rhs_reindex :
        (∑' m : Fin n → ℤ,
          (Real.exp (-Real.pi * ∑ j : Fin n,
            (A.mulVec (fun i => (m i : ℝ) - u' i) j) ^ 2) : ℂ)) =
        (∑' k : Fin n → ℤ,
          (Real.exp (-Real.pi * ∑ j : Fin n,
            (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ 2) : ℂ)) := by
      rw [← (Equiv.neg (Fin n → ℤ)).tsum_eq]
      refine tsum_congr (fun k => ?_)
      have h_sum_eq : (∑ j : Fin n, (A.mulVec (fun i => ((Equiv.neg (Fin n → ℤ) k i : ℤ) : ℝ) - u' i) j) ^ 2) =
          ∑ j : Fin n, (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ 2 := by
        refine Finset.sum_congr rfl (fun j _ => ?_)
        have h_vec : (fun i : Fin n => ((Equiv.neg (Fin n → ℤ) k i : ℤ) : ℝ) - u' i) = -(fun i : Fin n => u' i + (k i : ℝ)) := by
          ext i
          dsimp [Equiv.neg]
          push_cast
          ring
        rw [h_vec, Matrix.mulVec_neg, Pi.neg_apply, neg_sq]
      rw [h_sum_eq]
    have h_lhs_split :
        (∑' l : Fin n → ℤ,
          Complex.exp ((-Real.pi * ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2 : ℝ) +
            2 * Real.pi * Complex.I * ∑ i : Fin n, (u' i * (l i : ℝ) : ℂ))) =
        (∑' l : Fin n → ℤ,
          Complex.exp (2 * Real.pi * Complex.I * (∑ i : Fin n, u' i * (l i : ℝ) : ℂ)) *
            (Real.exp (-Real.pi * ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ)) := by
      refine tsum_congr (fun l => ?_)
      rw [add_comm, Complex.exp_add, Complex.ofReal_exp]
    rw [h_rhs_reindex, h_lhs_split] at hp
    have h_cancel : ((|A.det|⁻¹ : ℝ) : ℂ) * ((|A.det| : ℝ) : ℂ) = 1 := by
      rw [← Complex.ofReal_mul, inv_mul_cancel₀ (abs_ne_zero.mpr hA_ne), Complex.ofReal_one]
    calc (∑' k : Fin n → ℤ,
          (Real.exp (-Real.pi * ∑ j : Fin n, (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ 2) : ℂ))
      _ = 1 * (∑' k : Fin n → ℤ,
            (Real.exp (-Real.pi * ∑ j : Fin n, (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ 2) : ℂ)) := (one_mul _).symm
      _ = (((|A.det|⁻¹ : ℝ) : ℂ) * ((|A.det| : ℝ) : ℂ)) *
            (∑' k : Fin n → ℤ,
              (Real.exp (-Real.pi * ∑ j : Fin n, (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ 2) : ℂ)) := by rw [h_cancel]
      _ = ((|A.det|⁻¹ : ℝ) : ℂ) *
            (((|A.det| : ℝ) : ℂ) *
              (∑' k : Fin n → ℤ,
                (Real.exp (-Real.pi * ∑ j : Fin n, (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ 2) : ℂ))) := by rw [mul_assoc]
      _ = ((|A.det|⁻¹ : ℝ) : ℂ) *
            ∑' l : Fin n → ℤ,
              Complex.exp (2 * Real.pi * Complex.I * (∑ i : Fin n, u' i * (l i : ℝ) : ℂ)) *
                (Real.exp (-Real.pi * ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ) := by rw [← hp]
  have h_lhs_reindex :
      (∑' m : M,
        (Real.exp (-Real.pi *
          ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * t w * (w ((α + m.1 : R) : K)) ^ 2) : ℂ)) =
      (∑' k : Fin n → ℤ,
        (Real.exp (-Real.pi *
          ∑ j : Fin n, (A.mulVec (fun i => (u i : ℝ) + (k i : ℝ)) j) ^ 2) : ℂ)) := by
    rw [← Equiv.tsum_eq e₁]
    refine tsum_congr (fun k => ?_)
    rw [hP_quad_k k]
  have h_rhs_reindex_J :
      (∑' x_star : J_star,
        Complex.exp (2 * Real.pi * Complex.I *
          (Algebra.trace ℚ K ((α : K) * (x_star.1 : K) / (γ : K)) : ℂ)) *
          (Real.exp (-Real.pi *
            ∑ w : NumberField.InfinitePlace K,
              (w.mult : ℝ) * (t w)⁻¹ * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2) : ℂ)) =
      (∑' l : Fin n → ℤ,
        Complex.exp (2 * Real.pi * Complex.I *
          (∑ i : Fin n, (u i : ℝ) * (l i : ℝ) : ℂ)) *
          (Real.exp (-Real.pi *
            ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ)) := by
    rw [← Equiv.tsum_eq e₂]
    refine tsum_congr (fun l => ?_)
    rw [h_tr_l l, hD_quad_l l]
  rw [h_lhs_reindex, h_rhs_reindex_J, h_base, hA_det]

theorem mitsui_generator_unitLog_shift_cube_integral_eq {K : Type u} [Field K] [NumberField K]
    (f J_star : Ideal (NumberField.RingOfIntegers K))
    (γ : NumberField.RingOfIntegers K) (hγ : γ ≠ 0)
    (ψ_f : (NumberField.RingOfIntegers K ⧸ f) → ℂ)
    (hψ_mul : ∀ a b : NumberField.RingOfIntegers K ⧸ f, ψ_f (a * b) = ψ_f a * ψ_f b)
    (hψ_units : ∀ u : (NumberField.RingOfIntegers K)ˣ, ψ_f (Ideal.Quotient.mk f (u : NumberField.RingOfIntegers K)) = 1)
    (c : ℝ) :
    let R := NumberField.RingOfIntegers K
    let n : ℕ := Module.finrank ℚ K
    let r : ℕ := NumberField.Units.rank K
    let Cube : Set (Fin r → ℝ) := Set.pi Set.univ (fun _ => Set.Ico (0 : ℝ) 1)
    let N_γ : ℝ := (Ideal.absNorm (Ideal.span ({γ} : Set R)) : ℝ)
    (∫ y in Cube,
      (∑' x_star : J_star,
        star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
          (Real.exp (-Real.pi * c *
            ∑ w : NumberField.InfinitePlace K,
              (w.mult : ℝ) * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2 *
                ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℂ))) =
    (∫ y in Cube,
      (∑' x_star : J_star,
        star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
          (Real.exp (-Real.pi * (c * N_γ ^ (-2 / (n : ℝ))) *
            ∑ w : NumberField.InfinitePlace K,
              (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
                ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℂ))) :=
by
  classical
  intro R n r Cube N_γ
  let ε : Fin r → Rˣ := NumberField.Units.fundSystem K
  have hw_ε_pos : ∀ (w : NumberField.InfinitePlace K) (i : Fin r),
      0 < w ((ε i : R) : K) := by
    intro w i
    exact w.pos_iff.mpr (NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero (ε i)))
  have hγ_coe : (γ : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hγ
  have hw_γ_pos : ∀ w : NumberField.InfinitePlace K, 0 < w (γ : K) :=
    fun w => w.pos_iff.mpr hγ_coe
  have hNγ_pos : 0 < N_γ := by
    dsimp [N_γ]
    have h_span_ne : Ideal.span ({γ} : Set R) ≠ ⊥ := Ideal.span_singleton_eq_bot.not.mpr hγ
    exact_mod_cast Nat.pos_of_ne_zero (Ideal.absNorm_eq_zero_iff.not.mpr h_span_ne)
  have hn_pos : (0 : ℝ) < (n : ℝ) := by
    dsimp [n]
    exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
  have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  
  let B_R : Module.Basis (Fin r) ℝ (NumberField.Units.dirichletUnitTheorem.logSpace K) :=
    Module.Basis.ofZLatticeBasis ℝ
      (NumberField.Units.unitLattice K)
      (NumberField.Units.basisUnitLattice K)
  let S_γ : ℝ := ∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * Real.log (v (γ : K))
  let ℓ_γ : NumberField.InfinitePlace K → ℝ :=
    fun w => Real.log (w (γ : K)) - S_γ / (n : ℝ)
  let L_vec : NumberField.Units.dirichletUnitTheorem.logSpace K :=
    fun w => (w.1.mult : ℝ) * ℓ_γ w.1
  let v_γ : Fin r → ℝ := fun j => B_R.repr L_vec j
  let r_γ : NumberField.InfinitePlace K → ℝ :=
    fun v => ∑ j : Fin r, v_γ j * Real.log (v ((ε j : R) : K))
  let w_dir : NumberField.InfinitePlace K := NumberField.Units.dirichletUnitTheorem.w₀
  have h_ne_dir : ∀ v : NumberField.InfinitePlace K, v ≠ w_dir →
      (v.mult : ℝ) * ℓ_γ v = (v.mult : ℝ) * r_γ v := by
    intro v hv
    let v_sub : {v : NumberField.InfinitePlace K // v ≠ w_dir} := ⟨v, hv⟩
    have h_basis := congr_fun (Module.Basis.sum_repr B_R L_vec).symm v_sub
    change (v.mult : ℝ) * ℓ_γ v = (∑ j : Fin r, (v_γ j) • B_R j) v_sub at h_basis
    rw [h_basis]
    have h_eval : (∑ j : Fin r, (v_γ j) • B_R j) v_sub =
        ∑ j : Fin r, v_γ j * (B_R j v_sub) := by
      simp [Finset.sum_apply]
    rw [h_eval]
    dsimp [r_γ]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    have hB_j : B_R j v_sub = (v.mult : ℝ) * Real.log (v ((ε j : R) : K)) := by
      dsimp [B_R, ε]
      rw [Module.Basis.ofZLatticeBasis_apply, ← NumberField.Units.logEmbedding_fundSystem,
        NumberField.Units.dirichletUnitTheorem.logEmbedding_component]
    rw [hB_j]
    ring
  have h_sum_mult : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ)) = (n : ℝ) := by
    dsimp [n]
    exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
  have h_sum_ℓ : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * ℓ_γ v) = 0 := by
    dsimp [ℓ_γ]
    simp_rw [mul_sub]
    rw [Finset.sum_sub_distrib, ← Finset.sum_mul, h_sum_mult, mul_div_cancel₀ _ hn_ne, sub_self]
  have h_sum_r : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * r_γ v) = 0 := by
    dsimp [r_γ]
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_eq_zero (fun j _ => ?_)
    have h_comm : (∑ v : NumberField.InfinitePlace K,
        (v.mult : ℝ) * (v_γ j * Real.log (v ((ε j : R) : K)))) =
        v_γ j * (∑ v : NumberField.InfinitePlace K,
          (v.mult : ℝ) * Real.log (v ((ε j : R) : K))) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun v _ => by ring)
    rw [h_comm]
    have h_unit_sum : (∑ v : NumberField.InfinitePlace K,
        (v.mult : ℝ) * Real.log (v ((ε j : R) : K))) = 0 := by
      simpa [ε] using NumberField.Units.sum_mult_mul_log (NumberField.Units.fundSystem K j)
    rw [h_unit_sum, mul_zero]
  have h_all_mult : ∀ v : NumberField.InfinitePlace K,
      (v.mult : ℝ) * ℓ_γ v = (v.mult : ℝ) * r_γ v := by
    intro v
    by_cases hv : v = w_dir
    · subst hv
      have h1 := (Finset.add_sum_erase Finset.univ
        (fun v : NumberField.InfinitePlace K => (v.mult : ℝ) * ℓ_γ v)
        (Finset.mem_univ w_dir)).symm
      have h2 := (Finset.add_sum_erase Finset.univ
        (fun v : NumberField.InfinitePlace K => (v.mult : ℝ) * r_γ v)
        (Finset.mem_univ w_dir)).symm
      have h_erase : (∑ v ∈ Finset.univ.erase w_dir, (v.mult : ℝ) * ℓ_γ v) =
          (∑ v ∈ Finset.univ.erase w_dir, (v.mult : ℝ) * r_γ v) :=
        Finset.sum_congr rfl (fun v hv_mem => h_ne_dir v (Finset.ne_of_mem_erase hv_mem))
      linarith
    · exact h_ne_dir v hv
  have h_all : ∀ v : NumberField.InfinitePlace K, ℓ_γ v = r_γ v := by
    intro v
    have h_mult_pos : (0 : ℝ) < (v.mult : ℝ) := by
      exact_mod_cast NumberField.InfinitePlace.mult_pos (w := v)
    exact mul_left_cancel₀ (ne_of_gt h_mult_pos) (h_all_mult v)
  have h_Sγ_eq : S_γ = Real.log N_γ := by
    dsimp [S_γ, N_γ]
    have h_prod : (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * Real.log (v (γ : K))) =
        Real.log (∏ v : NumberField.InfinitePlace K, (v (γ : K)) ^ v.mult) := by
      rw [Real.log_prod (fun v _ => pow_ne_zero v.mult (ne_of_gt (hw_γ_pos v)))]
      refine Finset.sum_congr rfl (fun v _ => ?_)
      rw [Real.log_pow]
    rw [h_prod, NumberField.InfinitePlace.prod_eq_abs_norm]
    congr 1
    rw [Ideal.absNorm_span_singleton]
    have h_coe_norm : ((Algebra.norm ℤ γ : ℤ) : ℚ) = Algebra.norm ℚ (γ : K) :=
      Algebra.coe_norm_int γ
    rw [← h_coe_norm]
    exact_mod_cast (Nat.cast_natAbs (Algebra.norm ℤ γ)).symm
  have h_log_γ : ∀ w : NumberField.InfinitePlace K,
      Real.log (w (γ : K)) = Real.log N_γ / (n : ℝ) + r_γ w := by
    intro w
    have h1 := h_all w
    dsimp [ℓ_γ] at h1
    rw [h_Sγ_eq] at h1
    linarith
  have h_wγ_sq : ∀ w : NumberField.InfinitePlace K,
      (w (γ : K)) ^ 2 = N_γ ^ (2 / (n : ℝ)) * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * v_γ i) := by
    intro w
    have h2_log : 2 * Real.log (w (γ : K)) =
        Real.log N_γ * (2 / (n : ℝ)) +
          ∑ i : Fin r, Real.log (w ((ε i : R) : K)) * (2 * v_γ i) := by
      rw [h_log_γ w]
      dsimp [r_γ]
      rw [mul_add, Finset.mul_sum]
      congr 1
      · ring
      · refine Finset.sum_congr rfl (fun i _ => by ring)
    have h_exp := congrArg Real.exp h2_log
    have h_lhs : Real.exp (2 * Real.log (w (γ : K))) = (w (γ : K)) ^ 2 := by
      rw [mul_comm, ← Real.rpow_def_of_pos (hw_γ_pos w) 2, Real.rpow_two]
    have h_rhs : Real.exp (Real.log N_γ * (2 / (n : ℝ)) +
        ∑ i : Fin r, Real.log (w ((ε i : R) : K)) * (2 * v_γ i)) =
        N_γ ^ (2 / (n : ℝ)) * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * v_γ i) := by
      rw [Real.exp_add, ← Real.rpow_def_of_pos hNγ_pos, Real.exp_sum]
      congr 1
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [← Real.rpow_def_of_pos (hw_ε_pos w i)]
    linarith
  
  let c_scaled : ℝ := c * N_γ ^ (-2 / (n : ℝ))
  let Θ : (Fin r → ℝ) → ℂ := fun y =>
    ∑' x_star : J_star,
      star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
        (Real.exp (-Real.pi * c_scaled *
          ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
              ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)) : ℂ)
  have h_inv_sq : ∀ (w : NumberField.InfinitePlace K) (y : Fin r → ℝ),
      ((w (γ : K)) ^ 2)⁻¹ * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i) =
        N_γ ^ (-2 / (n : ℝ)) * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (y + v_γ) i) := by
    intro w y
    rw [h_wγ_sq w, mul_inv, mul_assoc]
    congr 1
    · rw [← Real.rpow_neg (le_of_lt hNγ_pos), neg_div]
    · rw [← Finset.prod_inv_distrib, ← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [← Real.rpow_neg (le_of_lt (hw_ε_pos w i)), ← Real.rpow_add (hw_ε_pos w i)]
      congr 1
      change -(2 * v_γ i) + -2 * y i = -2 * (y i + v_γ i)
      ring
  have h_gauss_exp : ∀ (y : Fin r → ℝ) (x_star : J_star),
      -Real.pi * c *
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2 *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)) =
      -Real.pi * c_scaled *
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (y + v_γ) i)) := by
    intro y x_star
    have h_sum_eq :
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2 *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)) =
        N_γ ^ (-2 / (n : ℝ)) *
          (∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
              ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (y + v_γ) i)) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun w _ => ?_)
      calc (w.mult : ℝ) * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2 *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)
        _ = (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
            (((w (γ : K)) ^ 2)⁻¹ * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)) := by
            rw [div_pow, div_eq_mul_inv]
            ring
        _ = (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
            (N_γ ^ (-2 / (n : ℝ)) * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (y + v_γ) i)) := by
            rw [h_inv_sq w y]
        _ = N_γ ^ (-2 / (n : ℝ)) *
            ((w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
              ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (y + v_γ) i)) := by ring
    rw [h_sum_eq]
    dsimp [c_scaled]
    ring
  have h_lhs_eq :
      (∫ y in Cube,
        (∑' x_star : J_star,
          star (ψ_f (Ideal.Quotient.mk f x_star.1)) *
            (Real.exp (-Real.pi * c *
              ∑ w : NumberField.InfinitePlace K,
                (w.mult : ℝ) * (w ((x_star.1 : R) : K) / w (γ : K)) ^ 2 *
                  ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)) : ℂ))) =
      ∫ y in Cube, Θ (y + v_γ) := by
    congr 1
    ext y
    dsimp only [Θ]
    refine tsum_congr (fun x_star => ?_)
    rw [h_gauss_exp y x_star]
  
  let b₀ : Module.Basis (Fin r) ℝ (Fin r → ℝ) := Pi.basisFun ℝ (Fin r)
  let L_ℤ : Submodule ℤ (Fin r → ℝ) := Submodule.span ℤ (Set.range ⇑b₀)
  have h_per : ∀ (g : L_ℤ) (y : Fin r → ℝ), Θ (g +ᵥ y) = Θ y := by
    intro g y
    obtain ⟨e, he⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ).mp g.2
    have hg_coord : ∀ i : Fin r, (g +ᵥ y) i = (e i : ℝ) + y i := by
      intro i
      change g.1 i + y i = (e i : ℝ) + y i
      have hg_i : g.1 i = (e i : ℝ) := by
        rw [← he]
        simp [b₀, Finset.sum_apply, Pi.basisFun_apply, Pi.single_apply]
      rw [hg_i]
    let u_e : Rˣ := ∏ i : Fin r, (ε i) ^ (-(e i))
    let φ_e : J_star ≃ J_star :=
      { toFun := fun x => ⟨(u_e : R) * x.1, J_star.mul_mem_left (u_e : R) x.2⟩
        invFun := fun x => ⟨((u_e⁻¹ : Rˣ) : R) * x.1, J_star.mul_mem_left ((u_e⁻¹ : Rˣ) : R) x.2⟩
        left_inv := fun x => Subtype.ext (by
          change ((u_e⁻¹ : Rˣ) : R) * ((u_e : R) * x.1) = x.1
          rw [← mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul])
        right_inv := fun x => Subtype.ext (by
          change (u_e : R) * (((u_e⁻¹ : Rˣ) : R) * x.1) = x.1
          rw [← mul_assoc, ← Units.val_mul, mul_inv_cancel, Units.val_one, one_mul]) }
    have hw_ue : ∀ w : NumberField.InfinitePlace K,
        w ((u_e : R) : K) = ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-(e i : ℝ)) := by
      intro w
      let ψ_w : Rˣ →* ℝ :=
        { toFun := fun u => w ((u : R) : K)
          map_one' := by push_cast; exact map_one w
          map_mul' := fun u v => by push_cast; exact map_mul w _ _ }
      change ψ_w u_e = _
      dsimp [u_e]
      rw [map_prod]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [map_zpow ψ_w (ε i) (-(e i))]
      change (w ((ε i : R) : K)) ^ (-(e i)) = _
      rw [← Real.rpow_intCast, Int.cast_neg]
    have h_ue_sq : ∀ w : NumberField.InfinitePlace K,
        (w ((u_e : R) : K)) ^ 2 * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i) =
          ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (g +ᵥ y) i) := by
      intro w
      rw [hw_ue w, ← Finset.prod_pow, ← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [← Real.rpow_natCast, ← Real.rpow_mul (le_of_lt (hw_ε_pos w i)),
        ← Real.rpow_add (hw_ε_pos w i), hg_coord i]
      congr 1
      push_cast
      ring
    have h_ue_char : ∀ x_star : J_star,
        star (ψ_f (Ideal.Quotient.mk f (φ_e x_star).1)) =
        star (ψ_f (Ideal.Quotient.mk f x_star.1)) := by
      intro x_star
      change star (ψ_f (Ideal.Quotient.mk f ((u_e : R) * x_star.1))) = _
      rw [map_mul, hψ_mul, hψ_units u_e, one_mul]
    have h_ue_gauss : ∀ x_star : J_star,
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (w (((φ_e x_star).1 : R) : K)) ^ 2 *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)) =
        (∑ w : NumberField.InfinitePlace K,
          (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (g +ᵥ y) i)) := by
      intro x_star
      refine Finset.sum_congr rfl (fun w _ => ?_)
      have hw_mul : w (((φ_e x_star).1 : R) : K) = w ((u_e : R) : K) * w ((x_star.1 : R) : K) := by
        change w ((((u_e : R) * x_star.1 : R) : K)) = _
        push_cast
        exact map_mul w _ _
      rw [hw_mul, mul_pow]
      calc (w.mult : ℝ) * ((w ((u_e : R) : K)) ^ 2 * (w ((x_star.1 : R) : K)) ^ 2) *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)
        _ = (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
            ((w ((u_e : R) : K)) ^ 2 * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * y i)) := by ring
        _ = (w.mult : ℝ) * (w ((x_star.1 : R) : K)) ^ 2 *
            ∏ i : Fin r, (w ((ε i : R) : K)) ^ (-2 * (g +ᵥ y) i) := by rw [h_ue_sq w]
    symm
    dsimp only [Θ]
    rw [← Equiv.tsum_eq φ_e]
    refine tsum_congr (fun x_star => ?_)
    rw [h_ue_char x_star, h_ue_gauss x_star]
  
  haveI : MeasureTheory.VAddInvariantMeasure L_ℤ (Fin r → ℝ) MeasureTheory.volume :=
    ⟨fun z t _ => MeasureTheory.measure_preimage_add MeasureTheory.volume z.1 t⟩
  have h_fund_Cube : MeasureTheory.IsAddFundamentalDomain L_ℤ Cube MeasureTheory.volume := by
    dsimp [Cube]
    rw [← ZSpan.fundamentalDomain_pi_basisFun]
    exact ZSpan.isAddFundamentalDomain b₀ MeasureTheory.volume
  let t_Cube : Set (Fin r → ℝ) := (fun y => y + v_γ) '' Cube
  have hCube_meas : MeasurableSet Cube :=
    MeasurableSet.univ_pi (fun _ => measurableSet_Ico)
  have ht_Cube_meas : MeasurableSet t_Cube :=
    (measurableEmbedding_addRight v_γ).measurableSet_image.mpr hCube_meas
  have h_fund_trans : MeasureTheory.IsAddFundamentalDomain L_ℤ t_Cube MeasureTheory.volume := by
    refine MeasureTheory.IsAddFundamentalDomain.mk' ht_Cube_meas.nullMeasurableSet (fun x => ?_)
    have h_iff : ∀ g : L_ℤ, g +ᵥ x ∈ t_Cube ↔ g +ᵥ (x - v_γ) ∈ ZSpan.fundamentalDomain b₀ := by
      intro g
      rw [ZSpan.fundamentalDomain_pi_basisFun]
      change (∃ y ∈ Cube, y + v_γ = g.1 + x) ↔ g.1 + (x - v_γ) ∈ Cube
      constructor
      · rintro ⟨y, hy, hy_eq⟩
        have h_eq : g.1 + (x - v_γ) = y := by
          calc g.1 + (x - v_γ) = (g.1 + x) - v_γ := by abel
            _ = (y + v_γ) - v_γ := by rw [← hy_eq]
            _ = y := add_sub_cancel_right y v_γ
        rwa [h_eq]
      · intro h_mem
        refine ⟨g.1 + (x - v_γ), h_mem, ?_⟩
        abel
    simp_rw [h_iff]
    exact ZSpan.exist_unique_vadd_mem_fundamentalDomain b₀ (x - v_γ)
  have h_img := (MeasureTheory.MeasurePreserving.setIntegral_image_emb
    (MeasureTheory.measurePreserving_add_right MeasureTheory.volume v_γ)
    (measurableEmbedding_addRight v_γ) Θ Cube).symm
  have h_eq_fund := MeasureTheory.IsAddFundamentalDomain.setIntegral_eq
    h_fund_trans h_fund_Cube h_per
  exact h_lhs_eq.trans (h_img.trans h_eq_fund)

theorem mitsui_primitive_ray_char_classGroup_cube_lattice_theta_inversion {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ₀_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖χ₀ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → χ₀ I = 0))
    (J_rep : ClassGroup (NumberField.RingOfIntegers K) → nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))
    (hJ_cls : ∀ C : ClassGroup (NumberField.RingOfIntegers K), ClassGroup.mk0 (J_rep C) = C⁻¹)
    (hJ_cop : ∀ C : ClassGroup (NumberField.RingOfIntegers K), (J_rep C : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤)
    (ψ_f : (NumberField.RingOfIntegers K ⧸ f) → ℂ)
    (hψ_one : ψ_f 1 = 1)
    (hψ_mul : ∀ a b : NumberField.RingOfIntegers K ⧸ f, ψ_f (a * b) = ψ_f a * ψ_f b)
    (hψ_unit : ∀ a : NumberField.RingOfIntegers K ⧸ f, (IsUnit a → ‖ψ_f a‖ = 1) ∧ (¬ IsUnit a → ψ_f a = 0))
    (hψ_span : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
        ψ_f (Ideal.Quotient.mk f x))
    (hψ_prim : ∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
      ∃ x : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk f x) ∧ x - 1 ∈ f' ∧ ψ_f (Ideal.Quotient.mk f x) ≠ 1)
    (hψ_zero : (f ≠ ⊤ ∧ ψ_f 0 = 0 ∧
        ∀ (h_fin : Fintype (NumberField.RingOfIntegers K ⧸ f)),
          @Finset.sum (NumberField.RingOfIntegers K ⧸ f) ℂ _ (@Finset.univ (NumberField.RingOfIntegers K ⧸ f) h_fin) ψ_f = 0) ∨
      (f = ⊤ ∧ (∀ a : NumberField.RingOfIntegers K ⧸ f, ψ_f a = 1) ∧
        (∑ C : ClassGroup (NumberField.RingOfIntegers K), star (χ₀ (J_rep C))) = 0 ∧
        (∑ C : ClassGroup (NumberField.RingOfIntegers K), χ₀ (J_rep C)) = 0)) :
    let R := NumberField.RingOfIntegers K
    let n : ℕ := Module.finrank ℚ K
    let r : ℕ := NumberField.Units.rank K
    let D : ℝ := |(NumberField.discr K : ℝ)|
    let N_f : ℝ := (Ideal.absNorm f : ℝ)
    let Cube : Set (Fin r → ℝ) := Set.pi Set.univ (fun _ => Set.Ico (0 : ℝ) 1)
    ∃ ω_χ : ℂ, ‖ω_χ‖ = 1 ∧
      ∀ u ∈ Set.Ioi (0 : ℝ),
        (∑ C : ClassGroup R,
          star (χ₀ (J_rep C)) *
            (∫ y in Cube,
              (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
                ψ_f (Ideal.Quotient.mk f x.1) *
                  (Real.exp (-Real.pi * ((D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * u⁻¹)) /
                      (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                    ∑ w : NumberField.InfinitePlace K,
                      (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                        ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) : ℂ)))) =
        (u : ℂ) * ω_χ *
          (∑ C : ClassGroup R,
            χ₀ (J_rep C) *
              (∫ y in Cube,
                (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
                  star (ψ_f (Ideal.Quotient.mk f x.1)) *
                    (Real.exp (-Real.pi * ((D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * u)) /
                        (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                      ∑ w : NumberField.InfinitePlace K,
                        (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                          ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℂ)))) :=
by
  classical
  intro R n r D N_f Cube
  haveI : Finite (R ⧸ f) := Ideal.finiteQuotientOfFreeOfNeBot f hf
  letI : Fintype (R ⧸ f) := Fintype.ofFinite (R ⧸ f)
  obtain ⟨σ, γ_C, α_C, Φ_C, ω_χ, hω_norm, hγ_C, hα_Φ, h_gauss⟩ :=
    mitsui_primitive_ray_char_dual_class_and_gauss_sum
      f hf χ₀ hχ₀_norm_supp J_rep hJ_cls hJ_cop ψ_f hψ_one hψ_mul hψ_unit hψ_span hψ_prim hψ_zero
  have hψ_units : ∀ u_unit : Rˣ, ψ_f (Ideal.Quotient.mk f (u_unit : R)) = 1 := by
    intro u_unit
    have hu_ne : (u_unit : R) ≠ 0 := Units.ne_zero u_unit
    rw [← hψ_span (u_unit : R) hu_ne]
    have h_span : Ideal.span ({(u_unit : R)} : Set R) = ⊤ :=
      Ideal.span_singleton_eq_top.mpr u_unit.isUnit
    have h_one : (⟨Ideal.span ({(u_unit : R)} : Set R),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hu_ne)⟩ :
          nonZeroDivisors (Ideal R)) = 1 :=
      Subtype.ext (h_span.trans Ideal.one_eq_top.symm)
    rw [h_one, map_one]
  have h_unit_prod : ∀ (u_unit : Rˣ) (t : ℝ),
      (∏ w : NumberField.InfinitePlace K,
        (w ((u_unit : R) : K)) ^ ((w.mult : ℝ) * t)) = 1 := by
    intro u_unit t
    have h_pos : ∀ w : NumberField.InfinitePlace K, 0 < w ((u_unit : R) : K) := by
      intro w
      exact w.pos_iff.mpr (NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero u_unit))
    have h_step : ∀ w : NumberField.InfinitePlace K,
        (w ((u_unit : R) : K)) ^ ((w.mult : ℝ) * t) =
        ((w ((u_unit : R) : K)) ^ w.mult) ^ t := by
      intro w
      rw [← Real.rpow_natCast, ← Real.rpow_mul (le_of_lt (h_pos w))]
    have h_congr : (∏ w : NumberField.InfinitePlace K, (w ((u_unit : R) : K)) ^ ((w.mult : ℝ) * t)) =
        ∏ w : NumberField.InfinitePlace K, ((w ((u_unit : R) : K)) ^ w.mult) ^ t :=
      Finset.prod_congr rfl (fun w _ => h_step w)
    rw [h_congr, Real.finset_prod_rpow _ _ (fun w _ => pow_nonneg (le_of_lt (h_pos w)) _)]
    have h_prod : (∏ w : NumberField.InfinitePlace K, (w ((u_unit : R) : K)) ^ w.mult) = 1 := by
      rw [NumberField.InfinitePlace.prod_eq_abs_norm]
      have h_norm := NumberField.Units.norm K u_unit
      exact_mod_cast h_norm
    rw [h_prod, Real.one_rpow]
  have hD_pos : 0 < D := by
    dsimp [D]
    exact abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  have hNf_pos : 0 < N_f := by
    dsimp [N_f]
    exact_mod_cast Nat.pos_of_ne_zero (Ideal.absNorm_eq_zero_iff.not.mpr hf)
  have hn_pos : (0 : ℝ) < (n : ℝ) := by
    dsimp [n]
    exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
  have hD_prod : D ^ (1 / 2 : ℝ) * D ^ (-1 / 2 : ℝ) = 1 := by
    rw [← Real.rpow_add hD_pos]; norm_num
  have hNf_prod : N_f ^ (1 / 2 : ℝ) * N_f ^ (-1 / 2 : ℝ) = 1 := by
    rw [← Real.rpow_add hNf_pos]; norm_num
  have hNf_sq : N_f = N_f ^ (1 / 2 : ℝ) * N_f ^ (1 / 2 : ℝ) := by
    rw [← Real.rpow_add hNf_pos]; norm_num
  have hD_inv : (D ^ (1 / 2 : ℝ))⁻¹ = D ^ (-1 / 2 : ℝ) := by
    rw [← Real.rpow_neg (le_of_lt hD_pos)]; norm_num
  have hNf_inv : (N_f ^ (1 / 2 : ℝ))⁻¹ = N_f ^ (-1 / 2 : ℝ) := by
    rw [← Real.rpow_neg (le_of_lt hNf_pos)]; norm_num
  have hD_neg_inv : (D ^ (-1 / 2 : ℝ))⁻¹ = D ^ (1 / 2 : ℝ) := by
    rw [← hD_inv, inv_inv]
  have hNf_neg_inv : (N_f ^ (-1 / 2 : ℝ))⁻¹ = N_f ^ (1 / 2 : ℝ) := by
    rw [← hNf_inv, inv_inv]
  have hD_inv_sq : D⁻¹ = D ^ (-1 / 2 : ℝ) * D ^ (-1 / 2 : ℝ) := by
    rw [← Real.rpow_add hD_pos, ← Real.rpow_neg_one]
    congr 1; norm_num
  have hNf_inv_sq : N_f⁻¹ = N_f ^ (-1 / 2 : ℝ) * N_f ^ (-1 / 2 : ℝ) := by
    rw [← Real.rpow_add hNf_pos, ← Real.rpow_neg_one]
    congr 1; norm_num
  have hw_fund_pos : ∀ (w : NumberField.InfinitePlace K) (i : Fin r),
      0 < w ((NumberField.Units.fundSystem K i : R) : K) := by
    intro w i
    exact w.pos_iff.mpr (NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero _))
  have hCube_meas : MeasurableSet Cube := MeasurableSet.univ_pi (fun _ => measurableSet_Ico)
  refine ⟨ω_χ, hω_norm, fun u hu => ?_⟩
  have hu_pos : 0 < u := Set.mem_Ioi.mp hu
  set b_LHS : ℝ := D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * u⁻¹)
  set b_RHS : ℝ := D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * u)
  have hb_LHS_pos : 0 < b_LHS := by dsimp [b_LHS]; positivity
  have hb_RHS_pos : 0 < b_RHS := by dsimp [b_RHS]; positivity
  have h_prod_one_mul : ∀ (w : NumberField.InfinitePlace K) (y : Fin r → ℝ),
      (∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (1 * (2 * y i))) =
      ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i) :=
    fun w y => Finset.prod_congr rfl (fun i _ => by rw [one_mul])
  have h_prod_neg_one_mul : ∀ (w : NumberField.InfinitePlace K) (y : Fin r → ℝ),
      (∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ ((-1 : ℝ) * (2 * y i))) =
      ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i) :=
    fun w y => Finset.prod_congr rfl (fun i _ => by rw [neg_one_mul, neg_mul])
  have h_s1_lhs :
      (∑ C : ClassGroup R,
        star (χ₀ (J_rep C)) *
          (∫ y in Cube,
            (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
              ψ_f (Ideal.Quotient.mk f x.1) *
                (Real.exp (-Real.pi * (b_LHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                  ∑ w : NumberField.InfinitePlace K,
                    (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                      ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) : ℂ)))) =
      (∑ C : ClassGroup R,
        star (χ₀ (J_rep C)) *
          (∫ y in Cube,
            (∑' x : (J_rep C : Ideal R),
              ψ_f (Ideal.Quotient.mk f x.1) *
                (Real.exp (-Real.pi * (b_LHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                  ∑ w : NumberField.InfinitePlace K,
                    (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                      ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) : ℂ)))) := by
    have h1 := (mitsui_classGroup_cube_nonzero_lattice_sum_eq_full_ideal_sum
      f hf χ₀ J_rep ψ_f hψ_zero b_LHS hb_LHS_pos 1 (Or.inl rfl)).1
    have h_lhs_congr :
        (∑ C : ClassGroup R,
          star (χ₀ (J_rep C)) *
            (∫ y in Cube,
              (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
                ψ_f (Ideal.Quotient.mk f x.1) *
                  (Real.exp (-Real.pi * (b_LHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                    ∑ w : NumberField.InfinitePlace K,
                      (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                        ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) : ℂ)))) =
        (∑ C : ClassGroup R,
          star (χ₀ (J_rep C)) *
            (∫ y in Cube,
              (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
                ψ_f (Ideal.Quotient.mk f x.1) *
                  (Real.exp (-Real.pi * (b_LHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                    ∑ w : NumberField.InfinitePlace K,
                      (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                        ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (1 * (2 * y i))) : ℂ)))) := by
      refine Finset.sum_congr rfl (fun C _ => congrArg _ (MeasureTheory.setIntegral_congr_fun hCube_meas (fun y _ => tsum_congr (fun x => ?_))))
      congr 4
      exact Finset.sum_congr rfl (fun w _ => by rw [h_prod_one_mul w y])
    have h_rhs_congr :
        (∑ C : ClassGroup R,
          star (χ₀ (J_rep C)) *
            (∫ y in Cube,
              (∑' x : (J_rep C : Ideal R),
                ψ_f (Ideal.Quotient.mk f x.1) *
                  (Real.exp (-Real.pi * (b_LHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                    ∑ w : NumberField.InfinitePlace K,
                      (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                        ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (1 * (2 * y i))) : ℂ)))) =
        (∑ C : ClassGroup R,
          star (χ₀ (J_rep C)) *
            (∫ y in Cube,
              (∑' x : (J_rep C : Ideal R),
                ψ_f (Ideal.Quotient.mk f x.1) *
                  (Real.exp (-Real.pi * (b_LHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                    ∑ w : NumberField.InfinitePlace K,
                      (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                        ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i)) : ℂ)))) := by
      refine Finset.sum_congr rfl (fun C _ => congrArg _ (MeasureTheory.setIntegral_congr_fun hCube_meas (fun y _ => tsum_congr (fun x => ?_))))
      congr 4
      exact Finset.sum_congr rfl (fun w _ => by rw [h_prod_one_mul w y])
    exact (h_lhs_congr.trans h1).trans h_rhs_congr
  have h_s1_rhs :
      (∑ C : ClassGroup R,
        χ₀ (J_rep C) *
          (∫ y in Cube,
            (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
              star (ψ_f (Ideal.Quotient.mk f x.1)) *
                (Real.exp (-Real.pi * (b_RHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                  ∑ w : NumberField.InfinitePlace K,
                    (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                      ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℂ)))) =
      (∑ C : ClassGroup R,
        χ₀ (J_rep C) *
          (∫ y in Cube,
            (∑' x : (J_rep C : Ideal R),
              star (ψ_f (Ideal.Quotient.mk f x.1)) *
                (Real.exp (-Real.pi * (b_RHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                  ∑ w : NumberField.InfinitePlace K,
                    (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                      ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℂ)))) := by
    have h2 := (mitsui_classGroup_cube_nonzero_lattice_sum_eq_full_ideal_sum
      f hf χ₀ J_rep ψ_f hψ_zero b_RHS hb_RHS_pos (-1) (Or.inr rfl)).2
    have h_lhs_congr :
        (∑ C : ClassGroup R,
          χ₀ (J_rep C) *
            (∫ y in Cube,
              (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
                star (ψ_f (Ideal.Quotient.mk f x.1)) *
                  (Real.exp (-Real.pi * (b_RHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                    ∑ w : NumberField.InfinitePlace K,
                      (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                        ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (-2 * y i)) : ℂ)))) =
        (∑ C : ClassGroup R,
          χ₀ (J_rep C) *
            (∫ y in Cube,
              (∑' x : {x : R // x ≠ 0 ∧ x ∈ (J_rep C : Ideal R)},
                star (ψ_f (Ideal.Quotient.mk f x.1)) *
                  (Real.exp (-Real.pi * (b_RHS / (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) ^ (2 / (n : ℝ)) *
                    ∑ w : NumberField.InfinitePlace K,
                      (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                        ∏ i : Fin r, (w ((NumberField.Units.fundSystem K i : R) : K)) ^ ((-1 : ℝ) * (2 * y i))) : ℂ)))) := by
      refine Finset.sum_congr rfl (fun C _ => congrArg _ (MeasureTheory.setIntegral_congr_fun hCube_meas (fun y _ => tsum_congr (fun x => ?_))))
      congr 4
      exact Finset.sum_congr rfl (fun w _ => by rw [h_prod_neg_one_mul w y])
    have h_rhs_congr :
        (∑ C : ClassGroup R,
