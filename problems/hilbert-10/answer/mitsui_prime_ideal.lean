    field_simp [hs_sub_ne]
  have h2_re : (1 : ℝ) < (2 : ℂ).re := by norm_num
  have hζ2_ne : NumberField.dedekindZeta K 2 ≠ 0 :=
    (mitsui_LSeries_primePowers_eq_neg_logDeriv_dedekindZeta (K := K) 2 h2_re).1
  have hg2_ne : g_χ 2 ≠ 0 := by
    rw [hg_eq 2 h2_re]
