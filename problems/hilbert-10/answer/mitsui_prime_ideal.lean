        (R_K : ℂ) +
          s * (s - 1) *
            ∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s + (u : ℂ) ^ (1 - s)) * (Ψ_K u : ℂ)) :=
by
  set r₁ : ℕ := NumberField.InfinitePlace.nrRealPlaces K
  set r₂ : ℕ := NumberField.InfinitePlace.nrComplexPlaces K
  let R_K : ℝ := (2 : ℝ) ^ (r₁ + r₂) * NumberField.Units.regulator K *
    (NumberField.classNumber K : ℝ) / (NumberField.Units.torsionOrder K : ℝ)
  have hreg : (0 : ℝ) < NumberField.Units.regulator K := NumberField.Units.regulator_pos K
  have hclass : (0 : ℝ) < (NumberField.classNumber K : ℝ) := by
    exact_mod_cast NumberField.classNumber_pos K
  have htors : (0 : ℝ) < (NumberField.Units.torsionOrder K : ℝ) := by
    exact_mod_cast NumberField.Units.torsionOrder_pos K
  have hR_pos : 0 < R_K := by
    dsimp [R_K]
    positivity
  obtain ⟨Ψ_K, hΨ_nn, hΨ_int, hΨ_inv, h_mellin⟩ :=
    mitsui_dedekindZeta_unfolded_mellin_and_theta_inversion (K := K)
  refine ⟨R_K, Ψ_K, hR_pos, hΨ_nn, hΨ_int, ?_⟩
  intro s hs
  set γ_s : ℂ :=
    ((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ (s / 2) *
      (Complex.Gammaℝ s) ^ r₁ *
      (Complex.Gammaℂ s) ^ r₂
