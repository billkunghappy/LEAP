                            ((∃ hw : w.IsReal,
                                p.1 ∈ Set.Ioo (-R₁) R₁ ∧
                                p.1 ∈
                                  Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                    ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
                                p.2 ∈ Set.Ioo (0 : ℝ) 1) ∨
                              (∃ hc : w.IsComplex,
                                p.1 ^ 2 + p.2 ^ 2 < R₁ ^ 2 ∧
                                p.1 ∈
                                  Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                                    ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
                                p.2 ∈
                                  Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                                    ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1)))))}).toReal|
                    ≤ c_sum * X ^ (Module.finrank ℚ K) * ((Real.log X + 1) ^ 2 / (l : ℝ)) +
                      c_sum * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_sum) :=
by
  classical
  have mitsui_finset_prod_sub_prod_bound :
      ∀ (s : Finset (NumberField.InfinitePlace K))
        (A F M : NumberField.InfinitePlace K → ℝ) (ε : ℝ) (hε : 0 ≤ ε)
        (h_bounds : ∀ w ∈ s, 0 ≤ A w ∧ A w ≤ M w ∧ 0 ≤ F w ∧ F w ≤ M w ∧ |A w - F w| ≤ ε * M w),
        |(∏ w ∈ s, A w) - ∏ w ∈ s, F w| ≤ (s.card : ℝ) * ε * ∏ w ∈ s, M w := by
    intro s A F M ε hε h_bounds
    induction s using Finset.induction_on with
    | empty =>
      simp
    | @insert a s ha ih =>
      have ha_mem : a ∈ insert a s := Finset.mem_insert_self a s
      have hs_sub : ∀ w ∈ s, 0 ≤ A w ∧ A w ≤ M w ∧ 0 ≤ F w ∧ F w ≤ M w ∧ |A w - F w| ≤ ε * M w :=
        fun w hw => h_bounds w (Finset.mem_insert_of_mem hw)
      have h_ih := ih hs_sub
