    let u_unit : (R ⧸ f)ˣ := hu₀.unit
    have hu_unit_eq : (u_unit : R ⧸ f) = u₀ := hu₀.unit_spec
    let e : (R ⧸ f) ≃ (R ⧸ f) :=
      { toFun := fun a => u₀ * a
        invFun := fun a => ↑(u_unit⁻¹) * a
        left_inv := fun a => by
          dsimp
          rw [← mul_assoc, ← hu_unit_eq, Units.inv_mul, one_mul]
        right_inv := fun a => by
          dsimp
          rw [← mul_assoc, ← hu_unit_eq, Units.mul_inv, one_mul] }
    let S_sum : ℂ := ∑ a : R ⧸ f, ψ_f a
    have h_shift : (∑ a : R ⧸ f, ψ_f (u₀ * a)) = S_sum :=
      Fintype.sum_equiv e (fun a => ψ_f (u₀ * a)) ψ_f (fun _ => rfl)
