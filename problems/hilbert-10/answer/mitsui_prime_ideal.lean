                Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
                  (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))},
          (∑' u : {u : NumberField.Units.torsion K //
              ∀ i : NumberField.mixedEmbedding.index K,
                R₁ *
                  ((NumberField.mixedEmbedding.stdBasis K).repr
                      (NumberField.mixedEmbedding K ((((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * xpm.1.1 : NumberField.RingOfIntegers K) : K)) i /
                    w₀ (xpm.1.1 : K)) ∈
                  Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                    ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))},
            (w₀.embedding ((((u.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * xpm.1.1 : NumberField.RingOfIntegers K) : K) /
              (w₀ (xpm.1.1 : K) : ℂ)) ^ a₀) *
            Complex.exp
              (((∑ w : NumberField.InfinitePlace K,
                  β w * Real.log (w (xpm.1.1 : K) / w₀ (xpm.1.1 : K))) : ℝ) * Complex.I) *
            ((χ₀ ⟨xpm.1.2.1.asIdeal, mem_nonZeroDivisors_of_ne_zero xpm.1.2.1.ne_bot⟩) ^ xpm.1.2.2 *
              ((Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) *
                Real.log (Z / ((Ideal.absNorm xpm.1.2.1.asIdeal : ℝ) ^ xpm.1.2.2)) : ℝ) : ℂ)) :=
by
  let U_dir (x : NumberField.RingOfIntegers K) :=
    {u : NumberField.Units.torsion K //
      ∀ i : NumberField.mixedEmbedding.index K,
        R₁ *
          ((NumberField.mixedEmbedding.stdBasis K).repr
              (NumberField.mixedEmbedding K ((((u : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * x : NumberField.RingOfIntegers K) : K)) i /
            w₀ (x : K)) ∈
          Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
            ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))}
  let D_cond :=
    {xpm : NumberField.RingOfIntegers K ×
        IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
      1 ≤ xpm.2.2 ∧
      Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
      (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Z ∧
      (∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
        Real.log (w (xpm.1 : K) / w₀ (xpm.1 : K)) ∈
          Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
            (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))) ∧
      IsUnit (Ideal.Quotient.mk q xpm.1)}
  let D_uncond :=
    {xpm : NumberField.RingOfIntegers K ×
        IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
      1 ≤ xpm.2.2 ∧
      Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
      (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Z ∧
      ∀ w : NumberField.InfinitePlace K, w ≠ w₀ →
        Real.log (w (xpm.1 : K) / w₀ (xpm.1 : K)) ∈
          Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
            (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ)))}
  let F_cond (xpm : D_cond) : ℂ :=
    (∑' u : U_dir xpm.1.1,
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom
        (u.1 : (NumberField.RingOfIntegers K)ˣ)))) *
      (ψ (Additive.ofMul xpm.2.2.2.2.2.unit) *
        ((Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) *
          Real.log (Z / ((Ideal.absNorm xpm.1.2.1.asIdeal : ℝ) ^ xpm.1.2.2)) : ℝ) : ℂ))
  let G (xpm : D_uncond) : ℂ :=
    (∑' u : U_dir xpm.1.1,
      (w₀.embedding ((((u.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * xpm.1.1 : NumberField.RingOfIntegers K) : K) /
        (w₀ (xpm.1.1 : K) : ℂ)) ^ a₀) *
      Complex.exp
        (((∑ w : NumberField.InfinitePlace K,
            β w * Real.log (w (xpm.1.1 : K) / w₀ (xpm.1.1 : K))) : ℝ) * Complex.I) *
      ((χ₀ ⟨xpm.1.2.1.asIdeal, mem_nonZeroDivisors_of_ne_zero xpm.1.2.1.ne_bot⟩) ^ xpm.1.2.2 *
        ((Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) *
          Real.log (Z / ((Ideal.absNorm xpm.1.2.1.asIdeal : ℝ) ^ xpm.1.2.2)) : ℝ) : ℂ))
  have h_tors_sum (x : NumberField.RingOfIntegers K) :
      (∑' u : U_dir x,
        ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom
          (u.1 : (NumberField.RingOfIntegers K)ˣ)))) *
        (w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ =
      ∑' u : U_dir x,
        (w₀.embedding ((((u.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) * x : NumberField.RingOfIntegers K) : K) /
          (w₀ (x : K) : ℂ)) ^ a₀ := by
    rw [← tsum_mul_right]
    refine tsum_congr (fun u => ?_)
    rw [ha₀ u.1.1 u.1.2, ← mul_pow, mul_div_assoc']
    congr 2
    push_cast
    exact (map_mul w₀.embedding (((u.1 : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) (x : K)).symm
  let s_unit : Set D_uncond := {xpm : D_uncond | IsUnit (Ideal.Quotient.mk q xpm.1.1)}
  let e_sub : D_cond ≃ s_unit :=
    { toFun := fun xpm =>
        ⟨⟨xpm.1, ⟨xpm.2.1, xpm.2.2.1, xpm.2.2.2.1, xpm.2.2.2.2.1⟩⟩, xpm.2.2.2.2.2⟩
      invFun := fun xpm =>
        ⟨xpm.1.1, ⟨xpm.1.2.1, xpm.1.2.2.1, xpm.1.2.2.2.1, xpm.1.2.2.2.2, xpm.2⟩⟩
      left_inv := fun _ => Subtype.ext rfl
      right_inv := fun _ => Subtype.ext (Subtype.ext rfl) }
  have h_cond_eq : ∀ xpm : D_cond, F_cond xpm = G (e_sub xpm).1 := by
    intro xpm
    have h_span_ne : Ideal.span ({xpm.1.1} : Set (NumberField.RingOfIntegers K)) ≠ ⊥ :=
      xpm.2.2.1.symm ▸ pow_ne_zero xpm.1.2.2 xpm.1.2.1.ne_bot
    have hx_ne : xpm.1.1 ≠ 0 := Ideal.span_singleton_eq_bot.not.mp h_span_ne
    have h_ideal_eq :
