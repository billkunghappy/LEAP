      intro m
      have h_I : ∀ I : S_prin m,
          ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩ *
            (∑' x : {x : R // Ideal.span ({x} : Set R) = I.1}, G_c_s x.1) =
          (NumberField.Units.torsionOrder K : ℂ) *
            (ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩ *
              ((((((b' * (N_J * m : ℝ)) ^ (1 / (n : ℝ))) ^ A_exp : ℝ) : ℂ) *
                J_c (Real.pi * (b' * (N_J * m : ℝ)) ^ (2 / (n : ℝ)))))) := by
        intro I
        have h_sum_I :
            (∑' x : {x : R // Ideal.span ({x} : Set R) = I.1}, G_c_s x.1) =
              (NumberField.Units.torsionOrder K : ℂ) *
                ((((((b' * (N_J * m : ℝ)) ^ (1 / (n : ℝ))) ^ A_exp : ℝ) : ℂ) *
