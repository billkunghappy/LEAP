        refine Finset.sum_congr rfl (fun ξ _ => ?_)
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun q _ => (Finset.mul_sum _ _ _).symm)
  refine ⟨w_main, hw_main_norm, ?_⟩
  intro U_tors _ v h_shift P_log h_log_bdd P_dir P_slice Ψ_u Ψ_e hΨ_norm χ_real hχ_norm ϑ
    h_slice_ind h_grid_in_out
  let R₀ : ℝ := M_K * B
  have hR₀_nonneg : 0 ≤ R₀ := mul_nonneg hM_K_nonneg hB_nonneg
  let I_shift : Fin r → Finset ℤ :=
    fun j => Finset.Icc (Int.floor (-v j - R₀)) (Int.floor (-v j + R₀))
  let E_box : Finset (Fin r → ℤ) := Fintype.piFinset I_shift
  let E_fin : Finset (Fin r → ℤ) := E_box.filter P_log
  have hE_iff : ∀ e : Fin r → ℤ, e ∈ E_fin ↔ P_log e := by
    intro e
    dsimp [E_fin]
    rw [Finset.mem_filter]
    refine ⟨fun h => h.2, fun he => ⟨?_, he⟩⟩
    dsimp [E_box, I_shift]
    rw [Fintype.mem_piFinset]
    intro j
    rw [Finset.mem_Icc]
    have h_abs := abs_le.mp (h_log_bdd e he j)
    have h_lo : -v j - R₀ ≤ (e j : ℝ) := by dsimp [R₀]; linarith [h_abs.1]
    have h_hi : (e j : ℝ) ≤ -v j + R₀ := by dsimp [R₀]; linarith [h_abs.2]
    refine ⟨?_, Int.le_floor.mpr h_hi⟩
    exact Int.cast_le.mp (le_trans (Int.floor_le (-v j - R₀)) h_lo)
  have hE_card : (E_fin.card : ℝ) ≤ (2 * M_K + 2) ^ r * (B + 1) ^ r := by
    have h_sub : (E_fin.card : ℝ) ≤ (E_box.card : ℝ) := by
      exact_mod_cast Finset.card_le_card (Finset.filter_subset P_log E_box)
    have h_box_card : (E_box.card : ℝ) = ∏ j : Fin r, ((I_shift j).card : ℝ) := by
      dsimp [E_box]
      rw [Fintype.card_piFinset, Nat.cast_prod]
    have h_I_le : ∀ j : Fin r, ((I_shift j).card : ℝ) ≤ (2 * M_K + 2) * (B + 1) := by
      intro j
      dsimp [I_shift]
      set a_j : ℤ := Int.floor (-v j - R₀)
      set b_j : ℤ := Int.floor (-v j + R₀)
      have hab : a_j ≤ b_j + 1 := by
        have h1 : a_j ≤ b_j := Int.floor_mono (by linarith)
        omega
