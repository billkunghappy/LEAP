  exact le_trans (hg_feq_sharp s hs) (mul_le_mul_of_nonneg_right h_coeff_le (norm_nonneg _))

theorem mitsui_grossenchar_sq_heckeL_entire_and_vertical_growth {K : Type u} [Field K] [NumberField K] :
    ∃ A₁_sq : ℝ, 0 < A₁_sq ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
        ∀ w₀ : NumberField.InfinitePlace K,
          ∀ a₀ : ℕ, a₀ < NumberField.Units.torsionOrder K →
            ∀ θ₀ : Fin (NumberField.Units.rank K) → ℝ,
              (∀ j : Fin (NumberField.Units.rank K), 0 ≤ θ₀ j ∧ θ₀ j < 1) →
              ∀ (m_freq : Fin (NumberField.Units.rank K) → ℤ)
                (l_ang : NumberField.InfinitePlace K → ℤ),
                (∀ ζ ∈ NumberField.Units.torsion K,
                  (∏ w : NumberField.InfinitePlace K,
                    (w.embedding ((ζ : NumberField.RingOfIntegers K) : K)) ^ (l_ang w)) = 1) →
                ∀ M : ℝ, 1 ≤ M →
                  (∀ j : Fin (NumberField.Units.rank K), |(m_freq j : ℝ)| ≤ Real.exp M) →
                  (∀ w : NumberField.InfinitePlace K, |(l_ang w : ℝ)| ≤ Real.exp M) →
                  ∀ χ_gr : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ,
                    (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
                      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ_gr I‖ = 1) ∧
                      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ_gr I = 0)) →
                    (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
                      x - 1 ∈ q →
                      ∃ y : Fin (NumberField.Units.rank K) → ℝ,
                        (∀ w : NumberField.InfinitePlace K,
                          Real.log (w (x : K) / w₀ (x : K)) =
                            ∑ j : Fin (NumberField.Units.rank K),
                              y j *
                                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) ∧
                        χ_gr ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
                          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
                          ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
                            Complex.exp
                              (((∑ j : Fin (NumberField.Units.rank K),
                                  y j *
                                    (2 * Real.pi * (θ₀ j - (m_freq j : ℝ)) +
                                      ∑ w : NumberField.InfinitePlace K,
                                        (l_ang w : ℝ) *
                                          (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg)) : ℝ) * Complex.I)) =
                          ∏ w : NumberField.InfinitePlace K,
                            (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w)) →
                    (∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
                      (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ ∧ (χ_gr I₀) ^ 2 ≠ 1) →
                    ∃ g_sq : ℂ → ℂ,
                      Differentiable ℂ g_sq ∧
                      (∀ s : ℂ, 1 < s.re →
                        g_sq s = LSeries (fun n =>
                          ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
                            (χ_gr ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) ^ 2) s) ∧
                      (∀ s : ℂ, 1 / 2 ≤ s.re → s.re ≤ 2 →
                        ‖g_sq s‖ ≤ A₁_sq * ((Ideal.absNorm q : ℝ) * Real.exp M * (4 + |s.im|)) ^ (Module.finrank ℚ K + 1)) :=
by
  obtain ⟨C₀, hC₀_pos, h_func⟩ :=
    mitsui_grossenchar_sq_heckeL_entire_functional_le_and_exp_bound (K := K)
  set n : ℕ := Module.finrank ℚ K
  set r₁ : ℕ := NumberField.InfinitePlace.nrRealPlaces K
  set r₂ : ℕ := NumberField.InfinitePlace.nrComplexPlaces K
  have hr_eq : r₁ + 2 * r₂ = n := NumberField.InfinitePlace.card_add_two_mul_card_eq_rank K
  set D : ℝ := |(NumberField.discr K : ℝ)|
  have hD_pos : 0 < D := by
    dsimp [D]
    exact abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  set Z₃₂ : ℝ := ‖NumberField.dedekindZeta K ((3 / 2 : ℝ) : ℂ)‖
  have hZ₃₂_nonneg : 0 ≤ Z₃₂ := norm_nonneg _
  let M_left : ℝ := C₀ * (D / (2 * Real.pi) ^ n * Z₃₂)
  let M_right : ℝ := Z₃₂
  let M₀ : ℝ := M_left + M_right + 1
  have hM_left_nonneg : 0 ≤ M_left := by dsimp [M_left]; positivity
  have hM_right_nonneg : 0 ≤ M_right := hZ₃₂_nonneg
  have hM₀_pos : 0 < M₀ := by dsimp [M₀]; positivity
  let A₁_sq : ℝ := 4 ^ (n + 1) * M₀
  have hA₁_sq_pos : 0 < A₁_sq := by dsimp [A₁_sq]; positivity
  refine ⟨A₁_sq, hA₁_sq_pos, ?_⟩
  intro q hq w₀ a₀ ha₀_lt θ₀ hθ₀_bdd m_freq l_ang h_tors M hM hm_M hl_M χ_gr hχ_norm_supp hχ_prin h_sq_nonprin
  let χ_sq : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ :=
