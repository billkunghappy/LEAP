        dsimp [F_lat, Ec_s, E₀c_s, E₀_s, Φ_ν, c]
        have h_real_cast :
            (((C_b' *
              (∏ w : NumberField.InfinitePlace K,
                (w (x.1 : K) * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (s * y i)) ^ (a_place w)) *
              Real.exp (-Real.pi * b' ^ (2 / (n : ℝ)) *
                ∑ w : NumberField.InfinitePlace K,
                  (w.mult : ℝ) * (w (x.1 : K)) ^ 2 *
                    ∏ i : Fin r, (w ((ε i : R) : K)) ^ (s * (2 * y i))) : ℝ) : ℂ)) =
            (C_b' : ℂ) *
              (((∏ w : NumberField.InfinitePlace K,
                (w (x.1 : K) * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (s * y i)) ^ (a_place w)) *
              Real.exp (-(Real.pi * b' ^ (2 / (n : ℝ))) *
                ∑ w : NumberField.InfinitePlace K,
