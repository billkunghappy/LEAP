    have hδ_pow_inv : (δ ^ (2 * r))⁻¹ = Real.exp (2 * (r : ℝ) * c' * t) := by
      dsimp [δ]
      rw [← Real.exp_nat_mul, ← Real.exp_neg, Nat.cast_mul, Nat.cast_ofNat]
      congr 1
      ring
    have h_tail_factor_le : (δ ^ (2 * r))⁻¹ * (M : ℝ)⁻¹ ≤ 2 * δ := by
      rw [hδ_pow_inv]
      have h_eq : Real.exp (2 * (r : ℝ) * c' * t) = z_M * δ := by
        dsimp [z_M, δ]
        rw [← Real.exp_add]
        congr 1
        ring
      rw [h_eq, mul_right_comm, ← div_eq_mul_inv]
      have h_div : z_M / (M : ℝ) ≤ 2 := (div_le_iff₀ hM_rpos).mpr (by linarith)
      exact mul_le_mul_of_nonneg_right h_div (le_of_lt hδ_pos)
    have h_collar_tail_le : A_collar + ε_tail ≤ 3 * C_trig * Real.exp (-t / (1 / c')) := by
      have h1 : A_collar + ε_tail = C_trig * (δ + (δ ^ (2 * r))⁻¹ * (M : ℝ)⁻¹) := by
        dsimp [A_collar, ε_tail]
        ring
      have h2 : δ + (δ ^ (2 * r))⁻¹ * (M : ℝ)⁻¹ ≤ 3 * δ := by linarith
      have h3 : A_collar + ε_tail ≤ 3 * C_trig * δ := by
        rw [h1]
        calc C_trig * (δ + (δ ^ (2 * r))⁻¹ * (M : ℝ)⁻¹)
          _ ≤ C_trig * (3 * δ) := mul_le_mul_of_nonneg_left h2 (le_of_lt hC_trig_pos)
          _ = 3 * C_trig * δ := by ring
      have h_exp_δ : δ = Real.exp (-t / (1 / c')) := by
        dsimp [δ]
        congr 1
        have hc'_ne : c' ≠ 0 := ne_of_gt hc'_pos
        field_simp [hc'_ne]
      rwa [← h_exp_δ]
    have hB_osc_le : B_osc ≤ c_base * Y * Real.exp (-t / c_base) := by
      dsimp [B_osc]
      have hexp_Y : Real.exp (-t / c_gr) ≤ Real.exp (-t / c_base) := by
        rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
        exact div_le_div_of_nonneg_left ht_nonneg hc_gr_pos hc_gr_le
      have hcY : c_gr * Y ≤ c_base * Y :=
        mul_le_mul_of_nonneg_right hc_gr_le (le_of_lt hY_pos)
      exact mul_le_mul hcY hexp_Y (by positivity) (by positivity)
    have h_2M1_pow_le : (2 * (M : ℝ) + 1) ^ r ≤ (3 : ℝ) ^ r * Real.exp (t / (8 * c_base)) := by
      have hz_M_pow : z_M ^ r = Real.exp (t / (8 * c_base)) := by
        dsimp [z_M]
        rw [← Real.exp_nat_mul]
        congr 1
        dsimp [c']
        have hr_ne : (r : ℝ) ≠ 0 := ne_of_gt hr_rpos
        have h2r1_ne : 2 * (r : ℝ) + 1 ≠ 0 := by positivity
        have hcb_ne : c_base ≠ 0 := ne_of_gt hc_base_pos
        field_simp [hr_ne, h2r1_ne, hcb_ne]
      calc (2 * (M : ℝ) + 1) ^ r
        _ ≤ (3 * z_M) ^ r := pow_le_pow_left₀ (by positivity) h2M1_le r
        _ = (3 : ℝ) ^ r * z_M ^ r := mul_pow 3 z_M r
        _ = (3 : ℝ) ^ r * Real.exp (t / (8 * c_base)) := by rw [hz_M_pow]
    have h_exp_osc_le :
        Real.exp (t / (8 * c_base)) * Real.exp (-t / c_base) ≤
        Real.exp (-t / (2 * c_base)) := by
      rw [← Real.exp_add, Real.exp_le_exp]
      have h_diff : t / (8 * c_base) + -t / c_base ≤ -t / (2 * c_base) := by
        have h_eq : -t / (2 * c_base) - (t / (8 * c_base) + -t / c_base) =
            3 * t / (8 * c_base) := by
          have hcb_ne : c_base ≠ 0 := ne_of_gt hc_base_pos
          field_simp [hcb_ne]
          ring
        have h_nonneg : 0 ≤ 3 * t / (8 * c_base) := by positivity
        linarith
      exact h_diff
    have h2cb_le_c₀ : 2 * c_base ≤ c₀ := by
      have : 0 ≤ C_trig * (2 * (3 : ℝ) ^ r * c_base + 3 * (1 + c_base)) + 1 / c' := by
        positivity
      dsimp [c₀]; linarith
    have h1c'_le_c₀ : 1 / c' ≤ c₀ := by
      have : 0 ≤ C_trig * (2 * (3 : ℝ) ^ r * c_base + 3 * (1 + c_base)) + 2 * c_base := by
        positivity
      dsimp [c₀]; linarith
    have hexp_2cb_le_c₀ : Real.exp (-t / (2 * c_base)) ≤ Real.exp (-t / c₀) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left ht_nonneg (by positivity) h2cb_le_c₀
    have hexp_1c'_le_c₀ : Real.exp (-t / (1 / c')) ≤ Real.exp (-t / c₀) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left ht_nonneg (by positivity) h1c'_le_c₀
    have h_term2 :
        2 * A_main * (2 * (M : ℝ) + 1) ^ r * B_osc ≤
        (C_trig * (2 * (3 : ℝ) ^ r * c_base)) * Y * Real.exp (-t / c₀) := by
      dsimp [A_main]
      calc 2 * C_trig * (2 * (M : ℝ) + 1) ^ r * B_osc
        _ = (2 * C_trig) * ((2 * (M : ℝ) + 1) ^ r * B_osc) := by ring
        _ ≤ (2 * C_trig) * (((3 : ℝ) ^ r * Real.exp (t / (8 * c_base))) *
              (c_base * Y * Real.exp (-t / c_base))) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul h_2M1_pow_le hB_osc_le hB_osc_nonneg (by positivity)) (by positivity)
        _ = (C_trig * (2 * (3 : ℝ) ^ r * c_base)) * Y *
              (Real.exp (t / (8 * c_base)) * Real.exp (-t / c_base)) := by ring
        _ ≤ (C_trig * (2 * (3 : ℝ) ^ r * c_base)) * Y * Real.exp (-t / (2 * c_base)) :=
          mul_le_mul_of_nonneg_left h_exp_osc_le (by positivity)
        _ ≤ (C_trig * (2 * (3 : ℝ) ^ r * c_base)) * Y * Real.exp (-t / c₀) :=
          mul_le_mul_of_nonneg_left hexp_2cb_le_c₀ (by positivity)
    have h_term3 :
        (A_collar + ε_tail) * Ψ₁_K ≤
        (C_trig * (3 * (1 + c_base))) * Y * Real.exp (-t / c₀) := by
      calc (A_collar + ε_tail) * Ψ₁_K
        _ ≤ (3 * C_trig * Real.exp (-t / (1 / c'))) * ((1 + c_base) * Y) :=
          mul_le_mul h_collar_tail_le hΨ₁_K_bound hΨ₁_K_nonneg (by positivity)
        _ = (C_trig * (3 * (1 + c_base))) * Y * Real.exp (-t / (1 / c')) := by ring
        _ ≤ (C_trig * (3 * (1 + c_base))) * Y * Real.exp (-t / c₀) :=
          mul_le_mul_of_nonneg_left hexp_1c'_le_c₀ (by positivity)
    have h_sum_le :
        (C_trig * (2 * (3 : ℝ) ^ r * c_base)) * Y * Real.exp (-t / c₀) +
        (C_trig * (3 * (1 + c_base))) * Y * Real.exp (-t / c₀) ≤
        c₀ * Y * Real.exp (-t / c₀) := by
      have h_coeff :
          C_trig * (2 * (3 : ℝ) ^ r * c_base) +
          C_trig * (3 * (1 + c_base)) ≤ c₀ := by
        have : 0 ≤ 1 / c' + 2 * c_base := by positivity
        dsimp [c₀]; linarith
      have hYE_nonneg : 0 ≤ Y * Real.exp (-t / c₀) := by positivity
      calc (C_trig * (2 * (3 : ℝ) ^ r * c_base)) * Y * Real.exp (-t / c₀) +
          (C_trig * (3 * (1 + c_base))) * Y * Real.exp (-t / c₀)
        _ = (C_trig * (2 * (3 : ℝ) ^ r * c_base) +
              C_trig * (3 * (1 + c_base))) * (Y * Real.exp (-t / c₀)) := by ring
        _ ≤ c₀ * (Y * Real.exp (-t / c₀)) := mul_le_mul_of_nonneg_right h_coeff hYE_nonneg
        _ = c₀ * Y * Real.exp (-t / c₀) := by ring
    exact le_trans h_s3 (by linarith)
  · refine ⟨1, zero_lt_one, ?_⟩
    intro Y _ w₀ q _ _ β i₀
    exact False.elim (h_rank i₀.pos)

theorem mitsui_primePower_char_fundamentalCone_bound_of_fundSystem_ne_one {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c₂ : ℝ, 0 < c₂ ∧
      ∀ X : ℝ, 1 < X →
        ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
          (Ideal.absNorm q : ℝ) < Real.log X ^ A →
          ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
            (∀ u ∈ NumberField.Units.torsion K,
              ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) →
            ∀ i₀ : Fin (NumberField.Units.rank K),
              ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom
                (NumberField.Units.fundSystem K i₀))) ≠ 1 →
              ‖∑' xpm : {xpm : NumberField.RingOfIntegers K ×
                    IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                  1 ≤ xpm.2.2 ∧
                  Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
                  NumberField.mixedEmbedding K (xpm.1 : K) ∈
                    NumberField.mixedEmbedding.fundamentalCone K ∧
                  (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ X ^ (Module.finrank ℚ K) ∧
                  IsUnit (Ideal.Quotient.mk q xpm.1)},
                ψ (Additive.ofMul xpm.2.2.2.2.2.unit) *
                  (Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) : ℂ)‖
                ≤ c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
by
  obtain ⟨Φ_W, hΦ_W_mul, hΦ_W_pow, hΦ_W_prin⟩ :=
    mitsui_exists_ideal_unitLogCoord_extending_principal (K := K)
  obtain ⟨c₀, hc₀_pos, hc₀⟩ :=
    mitsui_riesz_primePower_ray_char_unitLogCoord_fract_bound_of_fundSystem_ne_one
      (K := K) A hA Φ_W hΦ_W_mul hΦ_W_pow hΦ_W_prin
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_riesz_primePowers_asymptotic (K := K)
  set W : ℝ := (NumberField.Units.torsionOrder K : ℝ)
  have hW_nat_pos : 0 < NumberField.Units.torsionOrder K :=
    NumberField.Units.torsionOrder_pos K
  have hW_pos : 0 < W := by
    dsimp [W]
    exact_mod_cast hW_nat_pos
  have hW_ge_one : 1 ≤ W := by
    dsimp [W]
    exact_mod_cast hW_nat_pos
  let c : ℝ := W * c₀ + W * c₁
  have hc_pos : 0 < c := by dsimp [c]; positivity
  have hWc₀_le : W * c₀ ≤ c := by dsimp [c]; nlinarith
  have hWc₁_le : W * c₁ ≤ c := by dsimp [c]; nlinarith
  have hc₀_le : c₀ ≤ c := by dsimp [c]; nlinarith
  have hc₁_le : c₁ ≤ c := by dsimp [c]; nlinarith
  let c₂ : ℝ := 2 * c + 2 * c * Real.exp 1 + 3 * c + c * Real.exp (1 / c) + 2 * W
  have hc₂_pos : 0 < c₂ := by dsimp [c₂]; positivity
  refine ⟨c₂, hc₂_pos, ?_⟩
  intro X hX q hq hq_norm ψ _hψ hψ_tors i₀ hi₀
  let w₀ : NumberField.InfinitePlace K := NumberField.Units.dirichletUnitTheorem.w₀
  have h_tors_norm : ∀ u ∈ NumberField.Units.torsion K, ∀ w : NumberField.InfinitePlace K,
      w ((u : NumberField.RingOfIntegers K) : K) = 1 :=
    fun u hu w => (NumberField.Units.mem_torsion K).mp hu w
  have ha₀ : ∀ u ∈ NumberField.Units.torsion K,
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) =
        (w₀.embedding ((u : NumberField.RingOfIntegers K) : K)) ^ (0 : ℕ) := by
    intro u hu
    rw [hψ_tors u hu, pow_zero]
  obtain ⟨β, hβ⟩ :=
    mitsui_exists_log_freq_extending_torsion_char_to_units w₀ q hq ψ 0 ha₀ h_tors_norm
  have hβ_i₀ :
      Complex.exp
        (((∑ w : NumberField.InfinitePlace K,
            β w * Real.log (w (((NumberField.Units.fundSystem K i₀ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
              w₀ (((NumberField.Units.fundSystem K i₀ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) : ℝ) * Complex.I) ≠ 1 := by
    have h1 := hβ (NumberField.Units.fundSystem K i₀)
    rw [pow_zero, one_mul] at h1
    exact h1 ▸ hi₀
  let ϕ_arch : NumberField.RingOfIntegers K → ℂ := fun x =>
    Complex.exp
      (((∑ w : NumberField.InfinitePlace K,
          β w * Real.log (w (x : K) / w₀ (x : K))) : ℝ) * Complex.I)
  have hϕ_mul : ∀ x y : NumberField.RingOfIntegers K, x ≠ 0 → y ≠ 0 →
      ϕ_arch (x * y) = ϕ_arch x * ϕ_arch y := by
    intro x y hx_ne hy_ne
    have hxK_ne : (x : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx_ne
    have hyK_ne : (y : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hy_ne
    have hw₀x_pos : 0 < w₀ (x : K) := w₀.pos_iff.mpr hxK_ne
    have hw₀y_pos : 0 < w₀ (y : K) := w₀.pos_iff.mpr hyK_ne
    have h_log_sum :
        (∑ w : NumberField.InfinitePlace K,
          β w * Real.log (w (((x * y : NumberField.RingOfIntegers K) : K)) /
            w₀ (((x * y : NumberField.RingOfIntegers K) : K)))) =
        (∑ w : NumberField.InfinitePlace K,
          β w * Real.log (w (x : K) / w₀ (x : K))) +
        (∑ w : NumberField.InfinitePlace K,
          β w * Real.log (w (y : K) / w₀ (y : K))) := by
      rw [← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro w _
      have hwx_pos : 0 < w (x : K) := w.pos_iff.mpr hxK_ne
      have hwy_pos : 0 < w (y : K) := w.pos_iff.mpr hyK_ne
      have h_div_x_ne : w (x : K) / w₀ (x : K) ≠ 0 := ne_of_gt (div_pos hwx_pos hw₀x_pos)
      have h_div_y_ne : w (y : K) / w₀ (y : K) ≠ 0 := ne_of_gt (div_pos hwy_pos hw₀y_pos)
      push_cast
      rw [map_mul, map_mul, mul_div_mul_comm, Real.log_mul h_div_x_ne h_div_y_ne, mul_add]
    dsimp [ϕ_arch]
    rw [h_log_sum]
    push_cast
    rw [add_mul, Complex.exp_add]
  have hϕ_norm : ∀ x : NumberField.RingOfIntegers K, x ≠ 0 → ‖ϕ_arch x‖ = 1 := by
    intro x _hx_ne
    dsimp [ϕ_arch]
    exact Complex.norm_exp_ofReal_mul_I _
  have hϕ_units : ∀ u : (NumberField.RingOfIntegers K)ˣ,
      ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) =
        ϕ_arch (u : NumberField.RingOfIntegers K) := by
    intro u
    have h1 := hβ u
    rw [pow_zero, one_mul] at h1
    exact h1
  obtain ⟨χ₀, hχ₀_unit, hχ₀_not_unit, hχ₀_ray, hχ₀_norm⟩ :=
    mitsui_exists_ideal_monoidHom_extending_unit_compensated_char q hq ψ ϕ_arch hϕ_mul hϕ_norm hϕ_units
  let M : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℕ → ℂ := fun p m =>
    Complex.exp
      (((∑ w : NumberField.InfinitePlace K,
          β w *
            ∑ j : Fin (NumberField.Units.rank K),
              Int.fract ((m : ℝ) * Φ_W ⟨p.asIdeal, mem_nonZeroDivisors_of_ne_zero p.ne_bot⟩ j) *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) : ℝ) * Complex.I)
  have hM : ∀ (x : NumberField.RingOfIntegers K)
      (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
      1 ≤ m →
      Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = p.asIdeal ^ m →
      NumberField.mixedEmbedding K (x : K) ∈ NumberField.mixedEmbedding.fundamentalCone K →
      ϕ_arch x = M p m := by
    intro x p m _hm h_span h_cone
    dsimp [ϕ_arch, M]
    congr 1
    congr 1
    congr 1
    refine Finset.sum_congr rfl (fun w _ => ?_)
    rw [mitsui_fundamentalCone_log_eq_fract_of_unitLogCoord Φ_W hΦ_W_pow hΦ_W_prin x p m h_span h_cone w w₀]
  let Ψ₁_cone : ℝ → ℂ := fun Z =>
    ∑' xpm : {xpm : NumberField.RingOfIntegers K ×
          IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ xpm.2.2 ∧
        Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
        NumberField.mixedEmbedding K (xpm.1 : K) ∈
          NumberField.mixedEmbedding.fundamentalCone K ∧
        (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Z ∧
        IsUnit (Ideal.Quotient.mk q xpm.1)},
      ψ (Additive.ofMul xpm.2.2.2.2.2.unit) *
        ((Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) *
          Real.log (Z / ((Ideal.absNorm xpm.1.2.1.asIdeal : ℝ) ^ xpm.1.2.2)) : ℝ) : ℂ)
  let ψ_cone : ℝ → ℂ := fun Z =>
    ∑' xpm : {xpm : NumberField.RingOfIntegers K ×
          IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ xpm.2.2 ∧
        Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
        NumberField.mixedEmbedding K (xpm.1 : K) ∈
          NumberField.mixedEmbedding.fundamentalCone K ∧
        (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Z ∧
        IsUnit (Ideal.Quotient.mk q xpm.1)},
      ψ (Additive.ofMul xpm.2.2.2.2.2.unit) *
        (Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) : ℂ)
  let Ψ₁_K : ℝ → ℝ := fun Z =>
    ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Z},
      Real.log (Ideal.absNorm pm.1.1.asIdeal) *
        Real.log (Z / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
  let ψ_K : ℝ → ℝ := fun Z =>
    ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Z},
      Real.log (Ideal.absNorm pm.1.1.asIdeal)
  have hΨ₁_cone_le : ∀ Z : ℝ, 1 < Z → (Ideal.absNorm q : ℝ) < Real.log Z ^ A →
      ‖Ψ₁_cone Z‖ ≤ (W * c₀) * Z * Real.exp (-Real.sqrt (Real.log Z) / c₀) := by
    intro Z hZ_gt_one hq_norm_Z
    have hZ_pos : 0 < Z := by linarith
    set B_Z : ℝ := c₀ * Z * Real.exp (-Real.sqrt (Real.log Z) / c₀)
    have hB_Z : 0 ≤ B_Z := by dsimp [B_Z]; positivity
    have h_le : ‖Ψ₁_cone Z‖ ≤ W * B_Z := by
      refine mitsui_riesz_primePower_char_fundamentalCone_le_of_ideal_monoidHom_bound
        Z q ψ ϕ_arch M hM B_Z hB_Z χ₀ hχ₀_unit hχ₀_not_unit ?_
      intro χ hχ_prin hχ_norm_zero
      have hχ_ray : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
          x - 1 ∈ q →
          χ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
            mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
            Complex.exp
              (((∑ w : NumberField.InfinitePlace K,
                  β w * Real.log (w (x : K) / w₀ (x : K))) : ℝ) * Complex.I) = 1 := by
        intro x hx_ne hx1
        rw [hχ_prin x hx_ne]
        exact hχ₀_ray x hx_ne hx1
      have hχ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
          ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ I‖ = 1) ∧
          (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ I = 0) := by
        intro I
        refine ⟨fun hI => ?_, fun hI => ?_⟩
        · rw [(hχ_norm_zero I).1]
          exact (hχ₀_norm I).1 hI
        · rw [(hχ_norm_zero I).2]
          exact (hχ₀_norm I).2 hI
      exact hc₀ Z hZ_gt_one w₀ q hq hq_norm_Z β i₀ hβ_i₀ χ hχ_ray hχ_norm
    calc ‖Ψ₁_cone Z‖ ≤ W * B_Z := h_le
      _ = (W * c₀) * Z * Real.exp (-Real.sqrt (Real.log Z) / c₀) := by dsimp [B_Z]; ring
  set n : ℕ := Module.finrank ℚ K
  have hn_pos : 0 < n := Module.finrank_pos
  have hn_ge_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn_pos
  set Y : ℝ := X ^ n
  have hX_pos : 0 < X := by linarith
  have hY_gt_one : 1 < Y := one_lt_pow₀ hX (ne_of_gt hn_pos)
  have hY_pos : 0 < Y := by linarith
  have hlogX_pos : 0 < Real.log X := Real.log_pos hX
  have hlogY_eq : Real.log Y = (n : ℝ) * Real.log X := by
    dsimp [Y]
    exact Real.log_pow X n
  have hlogX_le_logY : Real.log X ≤ Real.log Y := by
    rw [hlogY_eq]
    exact le_mul_of_one_le_left (le_of_lt hlogX_pos) hn_ge_one
  have hsqrtX_le_sqrtY : Real.sqrt (Real.log X) ≤ Real.sqrt (Real.log Y) :=
    Real.sqrt_le_sqrt hlogX_le_logY
  have hq_norm_Y : (Ideal.absNorm q : ℝ) < Real.log Y ^ A :=
    lt_of_lt_of_le hq_norm (pow_le_pow_left₀ (le_of_lt hlogX_pos) hlogX_le_logY A)
  set δ : ℝ := Real.exp (-Real.sqrt (Real.log Y) / (2 * c))
  have hδ_pos : 0 < δ := Real.exp_pos _
  have hδ_le_one : δ ≤ 1 := by
    dsimp [δ]
    rw [Real.exp_le_one_iff, neg_div, neg_nonpos]
    exact div_nonneg (Real.sqrt_nonneg _) (by positivity)
  have hδ_sq : δ ^ 2 = Real.exp (-Real.sqrt (Real.log Y) / c) := by
    dsimp [δ]
    rw [sq, ← Real.exp_add]
    congr 1
    ring
  have hΨ₁_cone_Y : ‖Ψ₁_cone Y‖ ≤ c * Y * δ ^ 2 := by
    have h1 := hΨ₁_cone_le Y hY_gt_one hq_norm_Y
    have hexp : Real.exp (-Real.sqrt (Real.log Y) / c₀) ≤ δ ^ 2 := by
      rw [hδ_sq, Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left (Real.sqrt_nonneg _) hc₀_pos hc₀_le
    calc ‖Ψ₁_cone Y‖
      _ ≤ (W * c₀) * Y * Real.exp (-Real.sqrt (Real.log Y) / c₀) := h1
      _ ≤ (W * c₀) * Y * δ ^ 2 := mul_le_mul_of_nonneg_left hexp (by positivity)
      _ ≤ c * Y * δ ^ 2 := by
          have : 0 ≤ Y * δ ^ 2 := by positivity
