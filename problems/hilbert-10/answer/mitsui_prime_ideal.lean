    have : 0 ≤ c_ray + c_coord + 1 := by positivity
    linarith [hc₀_def]
  have hc_ray_le_c₀ : c_ray ≤ c₀ := by
    have : 0 ≤ c_coord + c_low + 1 := by positivity
