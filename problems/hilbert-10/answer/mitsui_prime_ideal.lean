      have hz'_i := hz'_Q i
      rw [Set.mem_Ico] at hy_i hz'_i
      have h_step_i := hd_step i
      by_cases hfi : 0 ≤ f k (b i)
      · have hε_i : ε k i = true := decide_eq_true hfi
