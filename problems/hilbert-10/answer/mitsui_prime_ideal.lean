          rw [← Finset.sum_mul, ← Complex.ofReal_sum, h_sum_Psi]
        have h_sum_nu_u : (∑ w : NumberField.InfinitePlace K, ((u * ν_place w : ℝ) : ℂ) * Complex.I) = 0 := by
          rw [← Finset.sum_mul, ← Complex.ofReal_sum, ← Finset.mul_sum, hν_sum, mul_zero, Complex.ofReal_zero, zero_mul]
        have h_sum_nu_Ly : (∑ w : NumberField.InfinitePlace K, ((ν_place w * L_y w : ℝ) : ℂ) * Complex.I) =
            ((∑ w : NumberField.InfinitePlace K, ν_place w * L_y w : ℝ) : ℂ) * Complex.I := by
          rw [← Finset.sum_mul, ← Complex.ofReal_sum]
        rw [h_sum_z, h_sum_nu_u, add_zero, h_sum_nu_Ly, ← Complex.ofReal_sum, ← Complex.ofReal_sum, Complex.ofReal_mul]
        ring
      simp_rw [Finset.prod_mul_distrib, h_exp_c]
      have h_gauss_c : (∏ w : NumberField.InfinitePlace K,
          ((2 * Real.exp (-Real.pi * (w.mult : ℝ) * Real.exp (Ψ_K u y w * (2 / (w.mult : ℝ)))) : ℝ) : ℂ)) =
          (((2 : ℝ) ^ (NumberField.InfinitePlace.nrRealPlaces K + NumberField.InfinitePlace.nrComplexPlaces K) : ℝ) : ℂ) *
            ((Real.exp (-Real.pi * Real.exp (2 * u) * Q_K y) : ℝ) : ℂ) := by
        rw [← Complex.ofReal_prod]
        simp_rw [Finset.prod_mul_distrib, h_prod_two, h_gauss_prod, Complex.ofReal_mul]
      rw [h_gauss_c, Complex.ofReal_mul, Complex.ofReal_mul]
      dsimp [L_y]
      ring
  intro Q_K U_K J_maj J_c z hz
  let g_maj : NumberField.InfinitePlace K → ℝ → ℝ := fun w t =>
    2 * Real.exp (t * (z.re + (a_place w : ℝ) / (w.mult : ℝ))) *
      Real.exp (-Real.pi * (w.mult : ℝ) * Real.exp (t * (2 / (w.mult : ℝ))))
  let g_c : NumberField.InfinitePlace K → ℝ → ℂ := fun w t =>
    Complex.exp ((t : ℂ) * (z + ((a_place w : ℂ) + (ν_place w : ℂ) * Complex.I) / (w.mult : ℂ))) *
      ((2 * Real.exp (-Real.pi * (w.mult : ℝ) * Real.exp (t * (2 / (w.mult : ℝ)))) : ℝ) : ℂ)
  have hw_mult : ∀ w : NumberField.InfinitePlace K, 1 ≤ w.mult ∧ w.mult ≤ 2 := by
    intro w
    rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
    · have hm : w.mult = 1 := NumberField.InfinitePlace.mult_isReal ⟨w, hw⟩
      omega
    · have hm : w.mult = 2 := NumberField.InfinitePlace.mult_isComplex ⟨w, hw⟩
      omega
  have h_place := fun w => h_s2 w.mult (a_place w) (hw_mult w).1 (hw_mult w).2 (ν_place w) z hz
  have h_gmaj_int : ∀ w : NumberField.InfinitePlace K, MeasureTheory.Integrable (g_maj w) MeasureTheory.volume :=
    fun w => (h_place w).2.1
  have h_gc_int : ∀ w : NumberField.InfinitePlace K, MeasureTheory.Integrable (g_c w) MeasureTheory.volume :=
    fun w => (h_place w).2.2.1
  have h_gc_eq : ∀ w : NumberField.InfinitePlace K,
      (∫ v in Set.Ioi (0 : ℝ),
        (v : ℂ) ^ (z + ((a_place w : ℂ) + (ν_place w : ℂ) * Complex.I) / (w.mult : ℂ)) *
          ((2 * v⁻¹ * Real.exp (-Real.pi * (w.mult : ℝ) * v ^ (2 / (w.mult : ℝ))) : ℝ) : ℂ)) =
        ∫ t : ℝ, g_c w t :=
    fun w => (h_place w).2.2.2
  let G_maj : (NumberField.InfinitePlace K → ℝ) → ℝ := fun t => ∏ w : NumberField.InfinitePlace K, g_maj w (t w)
  let G_c : (NumberField.InfinitePlace K → ℝ) → ℂ := fun t => ∏ w : NumberField.InfinitePlace K, g_c w (t w)
  have hG_maj_int : MeasureTheory.Integrable G_maj MeasureTheory.volume :=
    MeasureTheory.Integrable.fintype_prod_dep h_gmaj_int
  have hG_c_int : MeasureTheory.Integrable G_c MeasureTheory.volume :=
    MeasureTheory.Integrable.fintype_prod_dep h_gc_int
  have h_prod_places :
      (∏ w : NumberField.InfinitePlace K,
        (∫ v in Set.Ioi (0 : ℝ),
          (v : ℂ) ^ (z + ((a_place w : ℂ) + (ν_place w : ℂ) * Complex.I) / (w.mult : ℂ)) *
            ((2 * v⁻¹ * Real.exp (-Real.pi * (w.mult : ℝ) * v ^ (2 / (w.mult : ℝ))) : ℝ) : ℂ))) =
        ∫ t : NumberField.InfinitePlace K → ℝ, G_c t := by
    simp_rw [h_gc_eq]
