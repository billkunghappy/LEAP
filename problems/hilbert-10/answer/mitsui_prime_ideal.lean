            Real.exp 1 * ((6 * C_coeff + C_gcoeff) * (1 + c_base)) +
            Real.exp 1 * (C_vcoeff * c_base)) * (Y₀ * Real.exp (-t / c_coord)) := by ring
      _ ≤ c_coord * (Y₀ * Real.exp (-t / c_coord)) := mul_le_mul_of_nonneg_right h_coeff hYE_nonneg
      _ = c_coord * Y₀ * Real.exp (-t / c_coord) := by ring
  have h_final : |Ψ₁_coord - Vol * Z| ≤ c_coord * Y₀ * Real.exp (-t / c_coord) := by
    linarith
