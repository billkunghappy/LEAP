  obtain ⟨hD_ge2_fin, h_cheb_bound⟩ := hc₁ X hX
  let D_sec := {xpm : NumberField.RingOfIntegers K ×
        IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
      2 ≤ xpm.2.2 ∧
      Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
      (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Y₀ ∧
      ∀ w : NumberField.InfinitePlace K,
        Real.log (w (xpm.1 : K) / w₀ (xpm.1 : K)) ∈ Set.Ioc (-Real.log X) 0}
  let D_ge2 := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y₀}
  let U₂ := {u : (NumberField.RingOfIntegers K)ˣ //
    ∀ w : NumberField.InfinitePlace K,
      |(w.mult : ℝ) * Real.log (w ((u : NumberField.RingOfIntegers K) : K))| ≤
        2 * (Module.finrank ℚ K : ℝ) * Real.log X}
  haveI : Finite U₂ := hU_fin
  letI : Fintype U₂ := Fintype.ofFinite U₂
  haveI : Finite D_ge2 := hD_ge2_fin
  letI : Fintype D_ge2 := Fintype.ofFinite D_ge2
  let Φ : D_sec → D_ge2 := fun xpm => ⟨xpm.1.2, ⟨xpm.2.1, xpm.2.2.2.1⟩⟩
  let rep : Set.range Φ → D_sec := fun z => z.2.choose
  have hrep : ∀ z : Set.range Φ, Φ (rep z) = z.1 := fun z => z.2.choose_spec
  have hxpm_ne : ∀ xpm : D_sec, xpm.1.1 ≠ 0 := by
    intro xpm h0
    have hspan := xpm.2.2.1
    rw [h0, Ideal.span_singleton_zero] at hspan
    exact pow_ne_zero xpm.1.2.2 xpm.1.2.1.ne_bot hspan.symm
  have hex_u : ∀ xpm : D_sec, ∃ u : U₂,
      (u.1 : NumberField.RingOfIntegers K) * (rep ⟨Φ xpm, xpm, rfl⟩).1.1 = xpm.1.1 := by
    intro xpm
    let y : D_sec := rep ⟨Φ xpm, xpm, rfl⟩
    have hΦ_eq : Φ y = Φ xpm := hrep ⟨Φ xpm, xpm, rfl⟩
    have hy_pm : y.1.2 = xpm.1.2 := congrArg Subtype.val hΦ_eq
    have hspan_eq : Ideal.span ({y.1.1} : Set (NumberField.RingOfIntegers K)) =
        Ideal.span ({xpm.1.1} : Set (NumberField.RingOfIntegers K)) := by
      rw [y.2.2.1, xpm.2.2.1, hy_pm]
    obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp hspan_eq
    have hu_mul : (u : NumberField.RingOfIntegers K) * y.1.1 = xpm.1.1 := by
      rw [mul_comm, hu]
    have hu_sub : ∀ w : NumberField.InfinitePlace K,
        |Real.log (w ((u : NumberField.RingOfIntegers K) : K)) -
          Real.log (w₀ ((u : NumberField.RingOfIntegers K) : K))| ≤ Real.log X :=
      h_sec_sub X w₀ xpm.1.1 y.1.1 (hxpm_ne y) xpm.2.2.2.2 y.2.2.2.2 u hu_mul
    refine ⟨⟨u, h_unit_mult_log (Real.log X) (le_of_lt hlog_pos) w₀ u hu_sub⟩, hu_mul⟩
  let u_elt : D_sec → U₂ := fun xpm => (hex_u xpm).choose
  have hu_elt : ∀ xpm : D_sec,
      ((u_elt xpm).1 : NumberField.RingOfIntegers K) * (rep ⟨Φ xpm, xpm, rfl⟩).1.1 = xpm.1.1 :=
    fun xpm => (hex_u xpm).choose_spec
  let emb : D_sec ↪ U₂ × D_ge2 :=
    { toFun := fun xpm => (u_elt xpm, Φ xpm)
      inj' := fun a b hab => by
        have hu_eq : u_elt a = u_elt b := (Prod.ext_iff.mp hab).1
        have hΦ_eq : Φ a = Φ b := (Prod.ext_iff.mp hab).2
        have hrep_eq : rep ⟨Φ a, a, rfl⟩ = rep ⟨Φ b, b, rfl⟩ :=
          congrArg rep (Subtype.ext hΦ_eq)
        have hx_eq : a.1.1 = b.1.1 := by
          rw [← hu_elt a, ← hu_elt b, hu_eq, hrep_eq]
        have hpm_eq : a.1.2 = b.1.2 := congrArg Subtype.val hΦ_eq
        exact Subtype.ext (Prod.ext hx_eq hpm_eq) }
  haveI : Finite D_sec := Finite.of_injective emb emb.injective
  letI : Fintype D_sec := Fintype.ofFinite D_sec
  let F_ge2 : D_ge2 → ℝ := fun pm => Real.log (Ideal.absNorm pm.1.1.asIdeal)
  have hF_nonneg : ∀ pm : D_ge2, 0 ≤ F_ge2 pm := fun _ => Real.log_natCast_nonneg _
  have h_sec_le_prod :
      (∑' xpm : D_sec, Real.log (Ideal.absNorm xpm.1.2.1.asIdeal)) ≤
        (Nat.card U₂ : ℝ) * (∑' pm : D_ge2, F_ge2 pm) := by
    calc (∑' xpm : D_sec, Real.log (Ideal.absNorm xpm.1.2.1.asIdeal))
        = ∑ xpm : D_sec, F_ge2 (emb xpm).2 := tsum_fintype _
      _ = ∑ z ∈ (Finset.univ : Finset D_sec).map emb, F_ge2 z.2 := by
          rw [Finset.sum_map]
      _ ≤ ∑ z ∈ (Finset.univ : Finset (U₂ × D_ge2)), F_ge2 z.2 := by
          refine Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) (fun z _ _ => hF_nonneg z.2)
      _ = ∑ _u : U₂, ∑ pm : D_ge2, F_ge2 pm := by
          exact Fintype.sum_prod_type (fun z : U₂ × D_ge2 => F_ge2 z.2)
      _ = (Fintype.card U₂ : ℝ) * (∑ pm : D_ge2, F_ge2 pm) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      _ = (Nat.card U₂ : ℝ) * (∑' pm : D_ge2, F_ge2 pm) := by
          rw [Nat.card_eq_fintype_card, tsum_fintype]
  have hu_exp : c' * t / 4 + 1 ≤ Real.exp (c' * t / 4) := Real.add_one_le_exp (c' * t / 4)
  have hu_sq : (c' * t / 4) ^ 2 ≤ Real.exp (c' * t / 2) := by
    have h1 : c' * t / 4 ≤ c' * t / 4 + 1 := by linarith
    have h2 : c' * t / 4 ≤ Real.exp (c' * t / 4) := le_trans h1 hu_exp
    calc (c' * t / 4) ^ 2
      _ = (c' * t / 4) * (c' * t / 4) := sq _
      _ ≤ Real.exp (c' * t / 4) * Real.exp (c' * t / 4) :=
        mul_le_mul h2 h2 (by positivity) (by positivity)
      _ = Real.exp (c' * t / 2) := by
        rw [← Real.exp_add]
        ring_nf
  have hlog_le_exp : Real.log X ≤ (16 / c' ^ 2) * Real.exp (c' * t / 2) := by
    have h1 : (c' ^ 2 / 16) * Real.log X = (c' * t / 4) ^ 2 := by
      rw [← ht_sq]
      ring
    rw [div_mul_eq_mul_div, le_div_iff₀ (by positivity)]
    linarith
  have hexp_half_ge_one : 1 ≤ Real.exp (c' * t / 2) := by
    rw [← Real.exp_zero]
    exact Real.exp_le_exp.mpr (by positivity)
  have hlog1_le_K₀_half : Real.log X + 1 ≤ K₀ * Real.exp (c' * t / 2) := by
    dsimp [K₀]
    linarith
  have hexp_half_le : Real.exp (c' * t / 2) ≤ Real.exp (c' * t) := by
    rw [Real.exp_le_exp]
    have : 0 ≤ c' * t := by positivity
    linarith
  have hlog1_le_K₀ : Real.log X + 1 ≤ K₀ * Real.exp (c' * t) :=
    le_trans hlog1_le_K₀_half (mul_le_mul_of_nonneg_left hexp_half_le (le_of_lt hK₀_pos))
  have hexp_r_le : (r : ℝ) * (c' * t) ≤ t / (2 * c₁) := by
    have h1 : (r : ℝ) * (c' * t) ≤ ((r : ℝ) + 1) * (c' * t) := by
      have : 0 ≤ c' * t := by positivity
      nlinarith
    have h2 : ((r : ℝ) + 1) * (c' * t) = t / (2 * c₁) := by
      dsimp [c']
      have hr1_ne : (r : ℝ) + 1 ≠ 0 := ne_of_gt hr1_pos
      have hc₁_ne : c₁ ≠ 0 := ne_of_gt hc₁_pos
      field_simp [hr1_ne, hc₁_ne]
    linarith
  have hlog1_pow_le : (Real.log X + 1) ^ r ≤ K₀ ^ r * Real.exp (t / (2 * c₁)) := by
    calc (Real.log X + 1) ^ r
      _ ≤ (K₀ * Real.exp (c' * t)) ^ r :=
        pow_le_pow_left₀ (by positivity) hlog1_le_K₀ r
      _ = K₀ ^ r * (Real.exp (c' * t)) ^ r := mul_pow _ _ _
      _ = K₀ ^ r * Real.exp ((r : ℝ) * (c' * t)) := by rw [← Real.exp_nat_mul]
      _ ≤ K₀ ^ r * Real.exp (t / (2 * c₁)) :=
        mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hexp_r_le) (by positivity)
  have hU_card_exp : (Nat.card U₂ : ℝ) ≤ c_gen * (K₀ ^ r * Real.exp (t / (2 * c₁))) :=
    le_trans hU_card (mul_le_mul_of_nonneg_left hlog1_pow_le (le_of_lt hc_gen_pos))
  have hexp_combine : Real.exp (t / (2 * c₁)) * Real.exp (-t / c₁) = Real.exp (-t / (2 * c₁)) := by
    rw [← Real.exp_add]
    congr 1
    have hc₁_ne : c₁ ≠ 0 := ne_of_gt hc₁_pos
    field_simp [hc₁_ne]
    ring
  have h2c₁_pos : 0 < 2 * c₁ := by positivity
  have h2c₁_le : 2 * c₁ ≤ c_hpp := by dsimp [c_hpp]; linarith
  have hexp_hpp : Real.exp (-t / (2 * c₁)) ≤ Real.exp (-t / c_hpp) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left ht_nonneg h2c₁_pos h2c₁_le
  have hA_le_c : A_hpp ≤ c_hpp := by dsimp [c_hpp]; linarith
  have h_sum_nonneg : 0 ≤ ∑' pm : D_ge2, F_ge2 pm := tsum_nonneg hF_nonneg
  calc (∑' xpm : D_sec, Real.log (Ideal.absNorm xpm.1.2.1.asIdeal))
      ≤ (Nat.card U₂ : ℝ) * (∑' pm : D_ge2, F_ge2 pm) := h_sec_le_prod
    _ ≤ (Nat.card U₂ : ℝ) * (c₁ * Y₀ * Real.exp (-t / c₁)) :=
        mul_le_mul_of_nonneg_left h_cheb_bound (Nat.cast_nonneg _)
    _ ≤ (c_gen * (K₀ ^ r * Real.exp (t / (2 * c₁)))) * (c₁ * Y₀ * Real.exp (-t / c₁)) :=
        mul_le_mul_of_nonneg_right hU_card_exp (by positivity)
    _ = A_hpp * Y₀ * (Real.exp (t / (2 * c₁)) * Real.exp (-t / c₁)) := by
        dsimp [A_hpp]; ring
    _ = A_hpp * Y₀ * Real.exp (-t / (2 * c₁)) := by rw [hexp_combine]
    _ ≤ A_hpp * Y₀ * Real.exp (-t / c_hpp) :=
        mul_le_mul_of_nonneg_left hexp_hpp (by positivity)
    _ ≤ c_hpp * Y₀ * Real.exp (-t / c_hpp) := by
        have : 0 ≤ Y₀ * Real.exp (-t / c_hpp) := by positivity
        nlinarith

theorem mitsui_decoupled_log_cell_generator_card_bound {K : Type u} [Field K] [NumberField K] :
    ∃ c_gen : ℝ, 0 < c_gen ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m →
          ∀ w₀ : NumberField.InfinitePlace K,
            ∀ k : NumberField.InfinitePlace K → Fin m,
              ∀ I : Ideal (NumberField.RingOfIntegers K), I ≠ 0 →
                (Nat.card {x : NumberField.RingOfIntegers K //
                    Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = I ∧
                    ∀ w : NumberField.InfinitePlace K,
                      Real.log (w (x : K) / w₀ (x : K)) ∈
                        Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                          (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℝ)
                  ≤ c_gen * (Real.log X + 1) ^ (NumberField.Units.rank K) :=
by
  classical
  have h_cell_sub : ∀ (X : ℝ), 1 < X → ∀ (m : ℕ), 1 ≤ m →
      ∀ (w₀ : NumberField.InfinitePlace K) (k : NumberField.InfinitePlace K → Fin m)
        (x x₀ : NumberField.RingOfIntegers K),
      x₀ ≠ 0 →
      (∀ w : NumberField.InfinitePlace K,
        Real.log (w (x : K) / w₀ (x : K)) ∈
          Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
            (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))) →
      (∀ w : NumberField.InfinitePlace K,
        Real.log (w (x₀ : K) / w₀ (x₀ : K)) ∈
          Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
            (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))) →
      ∀ (u : (NumberField.RingOfIntegers K)ˣ),
      (u : NumberField.RingOfIntegers K) * x₀ = x →
      ∀ (w : NumberField.InfinitePlace K),
      |Real.log (w ((u : NumberField.RingOfIntegers K) : K)) -
        Real.log (w₀ ((u : NumberField.RingOfIntegers K) : K))| ≤ Real.log X := by
    intro X hX m hm w₀ k x x₀ hx₀_ne hx_cell hx₀_cell u hu w
    have hx₀_coe : (x₀ : K) ≠ 0 := by exact_mod_cast hx₀_ne
    have hu_coe : ((u : NumberField.RingOfIntegers K) : K) ≠ 0 := by exact_mod_cast u.ne_zero
    have hw_x₀_ne : w (x₀ : K) ≠ 0 := ne_of_gt (w.pos_iff.mpr hx₀_coe)
    have hw₀_x₀_ne : w₀ (x₀ : K) ≠ 0 := ne_of_gt (w₀.pos_iff.mpr hx₀_coe)
    have hw_u_ne : w ((u : NumberField.RingOfIntegers K) : K) ≠ 0 := ne_of_gt (w.pos_iff.mpr hu_coe)
    have hw₀_u_ne : w₀ ((u : NumberField.RingOfIntegers K) : K) ≠ 0 := ne_of_gt (w₀.pos_iff.mpr hu_coe)
    have hw_mul : w (x : K) = w ((u : NumberField.RingOfIntegers K) : K) * w (x₀ : K) := by
      rw [← map_mul]
      congr 1
      exact_mod_cast hu.symm
    have hw₀_mul : w₀ (x : K) = w₀ ((u : NumberField.RingOfIntegers K) : K) * w₀ (x₀ : K) := by
      rw [← map_mul]
      congr 1
      exact_mod_cast hu.symm
    have h_log_diff : Real.log (w ((u : NumberField.RingOfIntegers K) : K)) -
        Real.log (w₀ ((u : NumberField.RingOfIntegers K) : K)) =
        Real.log (w (x : K) / w₀ (x : K)) - Real.log (w (x₀ : K) / w₀ (x₀ : K)) := by
      rw [hw_mul, hw₀_mul,
        Real.log_div (mul_ne_zero hw_u_ne hw_x₀_ne) (mul_ne_zero hw₀_u_ne hw₀_x₀_ne),
        Real.log_div hw_x₀_ne hw₀_x₀_ne,
        Real.log_mul hw_u_ne hw_x₀_ne,
        Real.log_mul hw₀_u_ne hw₀_x₀_ne]
      ring
    have hx_w := hx_cell w
    have hx₀_w := hx₀_cell w
    rw [Set.mem_Ioc] at hx_w hx₀_w
    set a_w : ℝ := Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ))
    set b_w : ℝ := Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ))
    have hba_eq : b_w - a_w = Real.log X / (m : ℝ) := by
      dsimp [a_w, b_w]
      ring
    have hlogX_pos : 0 < Real.log X := Real.log_pos hX
    have hm_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
    have hba_le : b_w - a_w ≤ Real.log X := by
      rw [hba_eq]
      exact div_le_self (le_of_lt hlogX_pos) hm_ge_one
    rw [h_log_diff, abs_le]
    refine ⟨?_, ?_⟩ <;> linarith [hx_w.1, hx_w.2, hx₀_w.1, hx₀_w.2, hba_le]
  have h_unit_mult_log : ∀ (B : ℝ), 0 ≤ B →
      ∀ (w₀ : NumberField.InfinitePlace K) (u : (NumberField.RingOfIntegers K)ˣ),
      (∀ w : NumberField.InfinitePlace K,
        |Real.log (w ((u : NumberField.RingOfIntegers K) : K)) -
          Real.log (w₀ ((u : NumberField.RingOfIntegers K) : K))| ≤ B) →
      ∀ (w : NumberField.InfinitePlace K),
      |(w.mult : ℝ) * Real.log (w ((u : NumberField.RingOfIntegers K) : K))| ≤
        2 * (Module.finrank ℚ K : ℝ) * B := by
    intro B hB w₀ u hu_sub w
    let n : ℕ := Module.finrank ℚ K
    have hn_pos : 0 < (n : ℝ) := by
      dsimp [n]
      exact Nat.cast_pos.mpr Module.finrank_pos
    have hsum_mult : ∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) = (n : ℝ) := by
      dsimp [n]
      exact_mod_cast NumberField.InfinitePlace.sum_mult_eq
    have hsum_log : ∑ v : NumberField.InfinitePlace K,
        (v.mult : ℝ) * Real.log (v ((u : NumberField.RingOfIntegers K) : K)) = 0 :=
      NumberField.Units.sum_mult_mul_log u
    have hsum_diff : ∑ v : NumberField.InfinitePlace K,
        (v.mult : ℝ) * (Real.log (v ((u : NumberField.RingOfIntegers K) : K)) -
          Real.log (w₀ ((u : NumberField.RingOfIntegers K) : K))) =
        -(n : ℝ) * Real.log (w₀ ((u : NumberField.RingOfIntegers K) : K)) := by
      simp_rw [mul_sub]
      rw [Finset.sum_sub_distrib, hsum_log, ← Finset.sum_mul, hsum_mult]
      ring
    have hw₀_mul_abs : (n : ℝ) * |Real.log (w₀ ((u : NumberField.RingOfIntegers K) : K))| ≤
        (n : ℝ) * B := by
      have h1 : (n : ℝ) * |Real.log (w₀ ((u : NumberField.RingOfIntegers K) : K))| =
          |-(n : ℝ) * Real.log (w₀ ((u : NumberField.RingOfIntegers K) : K))| := by
        rw [neg_mul, abs_neg, abs_mul, abs_of_pos hn_pos]
      rw [h1, ← hsum_diff]
      calc |∑ v : NumberField.InfinitePlace K,
            (v.mult : ℝ) * (Real.log (v ((u : NumberField.RingOfIntegers K) : K)) -
              Real.log (w₀ ((u : NumberField.RingOfIntegers K) : K)))|
          ≤ ∑ v : NumberField.InfinitePlace K,
              |(v.mult : ℝ) * (Real.log (v ((u : NumberField.RingOfIntegers K) : K)) -
                Real.log (w₀ ((u : NumberField.RingOfIntegers K) : K)))| :=
            Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * B := by
            refine Finset.sum_le_sum (fun v _ => ?_)
            rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg v.mult)]
            exact mul_le_mul_of_nonneg_left (hu_sub v) (Nat.cast_nonneg v.mult)
        _ = (n : ℝ) * B := by
            rw [← Finset.sum_mul, hsum_mult]
    have hw₀_abs : |Real.log (w₀ ((u : NumberField.RingOfIntegers K) : K))| ≤ B :=
      le_of_mul_le_mul_left hw₀_mul_abs hn_pos
    have hw_abs : |Real.log (w ((u : NumberField.RingOfIntegers K) : K))| ≤ 2 * B := by
      have h_id : Real.log (w ((u : NumberField.RingOfIntegers K) : K)) =
          (Real.log (w ((u : NumberField.RingOfIntegers K) : K)) -
            Real.log (w₀ ((u : NumberField.RingOfIntegers K) : K))) +
          Real.log (w₀ ((u : NumberField.RingOfIntegers K) : K)) := by ring
      rw [h_id]
      have htri := abs_add_le
        (Real.log (w ((u : NumberField.RingOfIntegers K) : K)) -
          Real.log (w₀ ((u : NumberField.RingOfIntegers K) : K)))
        (Real.log (w₀ ((u : NumberField.RingOfIntegers K) : K)))
      linarith [hu_sub w, hw₀_abs]
    have hw_mult_le : (w.mult : ℝ) ≤ (n : ℝ) := by
      have h_nat : w.mult ≤ n := by
        dsimp [n]
        rw [← NumberField.InfinitePlace.sum_mult_eq]
        exact Finset.single_le_sum (fun v _ => Nat.zero_le v.mult) (Finset.mem_univ w)
      exact_mod_cast h_nat
    rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg w.mult)]
    calc (w.mult : ℝ) * |Real.log (w ((u : NumberField.RingOfIntegers K) : K))|
        ≤ (n : ℝ) * (2 * B) :=
          mul_le_mul hw_mult_le hw_abs (abs_nonneg _) (le_of_lt hn_pos)
      _ = 2 * (n : ℝ) * B := by ring
  have h_units_card : ∃ c_gen : ℝ, 0 < c_gen ∧
      ∀ X : ℝ, 1 < X →
        Finite {u : (NumberField.RingOfIntegers K)ˣ //
          ∀ w : NumberField.InfinitePlace K,
            |(w.mult : ℝ) * Real.log (w ((u : NumberField.RingOfIntegers K) : K))| ≤
              2 * (Module.finrank ℚ K : ℝ) * Real.log X} ∧
        (Nat.card {u : (NumberField.RingOfIntegers K)ˣ //
          ∀ w : NumberField.InfinitePlace K,
            |(w.mult : ℝ) * Real.log (w ((u : NumberField.RingOfIntegers K) : K))| ≤
              2 * (Module.finrank ℚ K : ℝ) * Real.log X} : ℝ) ≤
          c_gen * (Real.log X + 1) ^ (NumberField.Units.rank K) := by
    let n : ℕ := Module.finrank ℚ K
    let r : ℕ := NumberField.Units.rank K
    let B_R : Module.Basis (Fin r) ℝ (NumberField.Units.dirichletUnitTheorem.logSpace K) :=
      Module.Basis.ofZLatticeBasis ℝ
        (NumberField.Units.unitLattice K)
        (NumberField.Units.basisUnitLattice K)
    let L : Fin r → (NumberField.Units.dirichletUnitTheorem.logSpace K →L[ℝ] ℝ) :=
