    have h_ite_eq :
        (∑' x : J, (if x = 0 then (0 : ℂ) else ∫ y in Cube, F x.1 y)) =
        ∑' x : {x : J // x ≠ 0}, ∫ y in Cube, F x.1.1 y := by
      have h_sub := (tsum_subtype_eq_of_support_subset
        (f := fun x : J => if x = 0 then (0 : ℂ) else ∫ y in Cube, F x.1 y)
        (s := {x : J | x ≠ 0}) (fun x hx => by
