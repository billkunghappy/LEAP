            D (2 + (t : ℂ) * Complex.I)).re| ≤
      C * ∫ t : ℝ, Y ^ (1 - B / Real.log (4 + |t|)) * (Real.log (4 + |t|) / (1 / 4 + t ^ 2)) :=
by
  have hY_pos : 0 < Y := by linarith
  have hInt_vert :=
