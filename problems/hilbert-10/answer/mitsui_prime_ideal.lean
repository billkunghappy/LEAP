        simp only [Complex.add_re, Complex.natCast_re, Complex.mul_re, Complex.ofReal_re,
          Complex.I_re, mul_zero, Complex.ofReal_im, Complex.I_im, mul_one, sub_self, add_zero]
        have : (0 : ℝ) ≤ (a_place w_sub.1 : ℝ) := Nat.cast_nonneg _
