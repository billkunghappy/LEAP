    have h_cpow : ((Real.exp ((n : ℝ) * u) : ℝ) : ℂ) ^ s = Complex.exp (((n : ℝ) * u : ℂ) * s) := by
      rw [Complex.cpow_def_of_ne_zero hexp_c_ne, ← Complex.ofReal_log (Real.exp_nonneg _),
        Real.log_exp, Complex.ofReal_mul]
    rw [h_cpow]
    push_cast
    ring

theorem mitsui_ideal_norm_tsum_eq_sum_classGroup_principal_subideals {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0) :
    let R := NumberField.RingOfIntegers K
    let n : ℕ := Module.finrank ℚ K
    let D : ℝ := |(NumberField.discr K : ℝ)|
    let N_f : ℝ := (Ideal.absNorm f : ℝ)
    let J_K : ℝ → ℝ := fun a =>
      ∫ y : Fin (NumberField.Units.rank K) → ℝ,
        Real.exp (-a *
          ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * ∏ i : Fin (NumberField.Units.rank K),
              (w ((NumberField.Units.fundSystem K i : R) : K)) ^ (2 * y i))
    ∃ J_rep : ClassGroup R → nonZeroDivisors (Ideal R),
      (∀ C : ClassGroup R, ClassGroup.mk0 (J_rep C) = C⁻¹) ∧
      (∀ C : ClassGroup R, (J_rep C : Ideal R) ⊔ f = ⊤) ∧
      ∀ (ψ : nonZeroDivisors (Ideal R) →* ℂ),
        (∀ I : nonZeroDivisors (Ideal R),
          ((I : Ideal R) ⊔ f = ⊤ → ‖ψ I‖ = 1) ∧
          (¬ ((I : Ideal R) ⊔ f = ⊤) → ψ I = 0)) →
        ∀ v ∈ Set.Ioi (0 : ℝ),
          (∑' m : ℕ,
            (∑' I : {I : Ideal R // I ≠ ⊥ ∧ Ideal.absNorm I = m},
              ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
              (J_K (Real.pi * (D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * ((m : ℝ) * v))) ^ (2 / (n : ℝ))) : ℂ)) =
          ∑ C : ClassGroup R,
            star (ψ (J_rep C)) *
              (∑' m : ℕ,
                (∑' I : {I : Ideal R // I ≠ ⊥ ∧ I ≤ (J_rep C : Ideal R) ∧ I.IsPrincipal ∧
                      Ideal.absNorm I = m * Ideal.absNorm (J_rep C : Ideal R)},
                  ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
                  (J_K (Real.pi * ((D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * v) /
                    (Ideal.absNorm (J_rep C : Ideal R) : ℝ)) *
                    (Ideal.absNorm (J_rep C : Ideal R) * m : ℝ)) ^ (2 / (n : ℝ))) : ℂ)) :=
by
  classical
  intro R n D N_f J_K
  
  have h_comp : ∀ I : nonZeroDivisors (Ideal R),
      ∃ (M₀ : nonZeroDivisors (Ideal R)) (c₀ : R),
        c₀ ≠ 0 ∧
        (M₀ : Ideal R) ⊔ f = ⊤ ∧
        (I : Ideal R) * (M₀ : Ideal R) = Ideal.span ({c₀} : Set R) := by
    intro I
    have hI : (I : Ideal R) ≠ 0 := nonZeroDivisors.coe_ne_zero I
    by_cases hI_top : (I : Ideal R) = ⊤
    · refine ⟨1, 1, one_ne_zero, ?_, ?_⟩
      · rw [Submonoid.coe_one, Ideal.one_eq_top, top_sup_eq]
      · rw [Submonoid.coe_one, Ideal.one_eq_top, hI_top, Ideal.mul_top, Ideal.span_singleton_one]
    · set J₀ : Ideal R := (I : Ideal R) * ((I : Ideal R) * f)
      have hJ₀_ne : J₀ ≠ 0 := mul_ne_zero hI (mul_ne_zero hI hf)
      obtain ⟨c₀, hc₀_sup⟩ := IsDedekindDomain.exists_sup_span_eq Ideal.mul_le_right hJ₀_ne
      have hc₀_ne : c₀ ≠ 0 := by
        intro hc₀_zero
        rw [hc₀_zero, Ideal.span_singleton_zero, sup_bot_eq] at hc₀_sup
        have h_eq : (I : Ideal R) * ((I : Ideal R) * f) = (I : Ideal R) * ⊤ := by
          rw [Ideal.mul_top]
          exact hc₀_sup
        have hIf_top : (I : Ideal R) * f = ⊤ := mul_left_cancel₀ hI h_eq
        have hI_ge_top : ⊤ ≤ (I : Ideal R) := hIf_top ▸ Ideal.mul_le_right
        exact hI_top (top_le_iff.mp hI_ge_top)
      have hc₀_le : Ideal.span ({c₀} : Set R) ≤ (I : Ideal R) :=
        le_sup_right.trans hc₀_sup.le
      obtain ⟨M₁, hM₁_mul⟩ := Ideal.dvd_iff_le.mpr hc₀_le
      have hspan_ne : Ideal.span ({c₀} : Set R) ≠ 0 :=
        Ideal.span_singleton_eq_bot.not.mpr hc₀_ne
      have hM₁_ne : M₁ ≠ 0 := right_ne_zero_of_mul (hM₁_mul ▸ hspan_ne)
      have h_mul_sup : (I : Ideal R) * (((I : Ideal R) * f) ⊔ M₁) = (I : Ideal R) * ⊤ := by
        rw [Ideal.mul_sup, ← hM₁_mul, Ideal.mul_top]
        exact hc₀_sup
      have hIf_sup : ((I : Ideal R) * f) ⊔ M₁ = ⊤ := mul_left_cancel₀ hI h_mul_sup
      have hM₁_cop : M₁ ⊔ f = ⊤ := by
        rw [sup_comm, eq_top_iff, ← hIf_sup]
        exact sup_le_sup_right Ideal.mul_le_left M₁
      exact ⟨⟨M₁, mem_nonZeroDivisors_of_ne_zero hM₁_ne⟩, c₀, hc₀_ne, hM₁_cop, hM₁_mul.symm⟩
  let I_C : ClassGroup R → nonZeroDivisors (Ideal R) :=
    fun C => (ClassGroup.mk0_surjective C).choose
  have hI_C : ∀ C : ClassGroup R, ClassGroup.mk0 (I_C C) = C :=
    fun C => (ClassGroup.mk0_surjective C).choose_spec
  let J_rep : ClassGroup R → nonZeroDivisors (Ideal R) :=
    fun C => (h_comp (I_C C)).choose
  have hJ_cls : ∀ C : ClassGroup R, ClassGroup.mk0 (J_rep C) = C⁻¹ := by
    intro C
    obtain ⟨c₀, _, _, h_mul⟩ := (h_comp (I_C C)).choose_spec
    have h_prin : ((I_C C * J_rep C : nonZeroDivisors (Ideal R)) : Ideal R).IsPrincipal := by
      change ((I_C C : Ideal R) * (J_rep C : Ideal R)).IsPrincipal
      rw [h_mul]
      exact ⟨⟨c₀, rfl⟩⟩
    have h_mk0_one : ClassGroup.mk0 (I_C C * J_rep C) = 1 :=
      (ClassGroup.mk0_eq_one_iff (I_C C * J_rep C).2).mpr h_prin
    rw [map_mul, hI_C C] at h_mk0_one
    exact eq_inv_of_mul_eq_one_right h_mk0_one
  have hJ_cop : ∀ C : ClassGroup R, (J_rep C : Ideal R) ⊔ f = ⊤ := by
    intro C
    exact (h_comp (I_C C)).choose_spec.choose_spec.2.1
  refine ⟨J_rep, hJ_cls, hJ_cop, ?_⟩
  intro ψ hψ v hv
  have hψ_rep : ∀ C : ClassGroup R, ‖ψ (J_rep C)‖ = 1 :=
    fun C => (hψ (J_rep C)).1 (hJ_cop C)
  have hψ_le : ∀ I : nonZeroDivisors (Ideal R), ‖ψ I‖ ≤ 1 := by
    intro I
    by_cases hI : (I : Ideal R) ⊔ f = ⊤
    · exact le_of_eq ((hψ I).1 hI)
    · rw [(hψ I).2 hI, norm_zero]
      exact zero_le_one
  
  let S_m (m : ℕ) := {I : Ideal R // I ≠ ⊥ ∧ Ideal.absNorm I = m}
  let S_prin (C : ClassGroup R) (m : ℕ) :=
    {I : Ideal R // I ≠ ⊥ ∧ I ≤ (J_rep C : Ideal R) ∧ I.IsPrincipal ∧
      Ideal.absNorm I = m * Ideal.absNorm (J_rep C : Ideal R)}
  have h_s2 : ∀ m : ℕ,
      (∑' I : S_m m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) =
        (∑ C : ClassGroup R,
          star (ψ (J_rep C)) *
            (∑' I : S_prin C m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩)) ∧
      (∀ C : ClassGroup R,
        ‖∑' I : S_prin C m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖ ≤
          (Nat.card (S_m m) : ℝ)) := by
    intro m
    haveI h_fin_m : Finite (S_m m) :=
      (Ideal.finite_setOf_absNorm_eq m).subset (fun _ h => h.2)
    letI : Fintype (S_m m) := Fintype.ofFinite (S_m m)
    have h_fin_prin : ∀ C : ClassGroup R, Finite (S_prin C m) := fun C =>
      (Ideal.finite_setOf_absNorm_eq (m * Ideal.absNorm (J_rep C : Ideal R))).subset
        (fun _ h => h.2.2.2)
    letI : ∀ C : ClassGroup R, Fintype (S_prin C m) := fun C => Fintype.ofFinite (S_prin C m)
    let g : S_m m → ClassGroup R :=
      fun I₀ => ClassGroup.mk0 ⟨I₀.1, mem_nonZeroDivisors_of_ne_zero I₀.2.1⟩
    have h_bij : ∀ C : ClassGroup R,
        (∑ I₀ ∈ Finset.univ.filter (fun I₀ : S_m m => g I₀ = C),
          ψ ⟨I₀.1, mem_nonZeroDivisors_of_ne_zero I₀.2.1⟩) =
          star (ψ (J_rep C)) *
            (∑ I : S_prin C m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) ∧
        (Finset.univ : Finset (S_prin C m)).card =
          (Finset.univ.filter (fun I₀ : S_m m => g I₀ = C)).card := by
      intro C
      have hJ_ne : (J_rep C : Ideal R) ≠ 0 := nonZeroDivisors.coe_ne_zero (J_rep C)
      have hJ_bot : (J_rep C : Ideal R) ≠ ⊥ := hJ_ne
      have hNJ_pos : 0 < Ideal.absNorm (J_rep C : Ideal R) :=
        Nat.pos_of_ne_zero (Ideal.absNorm_eq_zero_iff.not.mpr hJ_bot)
      let Φ : ∀ I₀ : S_m m, I₀ ∈ Finset.univ.filter (fun I₀ : S_m m => g I₀ = C) → S_prin C m :=
        fun I₀ hI₀ =>
          ⟨I₀.1 * (J_rep C : Ideal R),
            mul_ne_zero I₀.2.1 hJ_ne,
            Ideal.mul_le_left,
            by
              have hg : g I₀ = C := (Finset.mem_filter.mp hI₀).2
              let I₀' : nonZeroDivisors (Ideal R) := ⟨I₀.1, mem_nonZeroDivisors_of_ne_zero I₀.2.1⟩
              have h_mk : ClassGroup.mk0 (I₀' * J_rep C) = 1 := by
                rw [map_mul]
                change g I₀ * ClassGroup.mk0 (J_rep C) = 1
                rw [hg, hJ_cls C, mul_inv_cancel]
              exact (ClassGroup.mk0_eq_one_iff (I₀' * J_rep C).2).mp h_mk,
            by
              rw [map_mul, I₀.2.2]⟩
      have hΦ_inj : ∀ (a₁ : S_m m) (ha₁ : a₁ ∈ Finset.univ.filter (fun I₀ : S_m m => g I₀ = C))
          (a₂ : S_m m) (ha₂ : a₂ ∈ Finset.univ.filter (fun I₀ : S_m m => g I₀ = C)),
          Φ a₁ ha₁ = Φ a₂ ha₂ → a₁ = a₂ := by
        intro a₁ ha₁ a₂ ha₂ h_eq
        have h_val : a₁.1 * (J_rep C : Ideal R) = a₂.1 * (J_rep C : Ideal R) :=
          congrArg Subtype.val h_eq
        exact Subtype.ext (mul_right_cancel₀ hJ_ne h_val)
      have hΦ_surj : ∀ b ∈ (Finset.univ : Finset (S_prin C m)),
          ∃ a, ∃ (ha : a ∈ Finset.univ.filter (fun I₀ : S_m m => g I₀ = C)), Φ a ha = b := by
        intro b _
        obtain ⟨M, hM_mul⟩ := Ideal.dvd_iff_le.mpr b.2.2.1
        have hM_mul' : b.1 = M * (J_rep C : Ideal R) := hM_mul.trans (mul_comm _ _)
        have hM_ne : M ≠ ⊥ := left_ne_zero_of_mul (hM_mul' ▸ b.2.1)
        have hM_norm_mul : Ideal.absNorm M * Ideal.absNorm (J_rep C : Ideal R) =
            m * Ideal.absNorm (J_rep C : Ideal R) := by
          rw [← map_mul, ← hM_mul', b.2.2.2.2]
        have hM_norm : Ideal.absNorm M = m :=
          Nat.eq_of_mul_eq_mul_right hNJ_pos hM_norm_mul
        let a : S_m m := ⟨M, hM_ne, hM_norm⟩
        have ha_g : g a = C := by
          let M' : nonZeroDivisors (Ideal R) := ⟨M, mem_nonZeroDivisors_of_ne_zero hM_ne⟩
          have h_prin : ((M' * J_rep C : nonZeroDivisors (Ideal R)) : Ideal R).IsPrincipal := by
            change (M * (J_rep C : Ideal R)).IsPrincipal
            rw [← hM_mul']
            exact b.2.2.2.1
          have h_mk : ClassGroup.mk0 (M' * J_rep C) = 1 :=
            (ClassGroup.mk0_eq_one_iff (M' * J_rep C).2).mpr h_prin
          rw [map_mul, hJ_cls C] at h_mk
          exact mul_inv_eq_one.mp h_mk
        have ha_mem : a ∈ Finset.univ.filter (fun I₀ : S_m m => g I₀ = C) :=
          Finset.mem_filter.mpr ⟨Finset.mem_univ a, ha_g⟩
        refine ⟨a, ha_mem, Subtype.ext hM_mul'.symm⟩
      have h_conj_mul : star (ψ (J_rep C)) * ψ (J_rep C) = 1 := by
        change (starRingEnd ℂ) (ψ (J_rep C)) * ψ (J_rep C) = 1
        rw [RCLike.conj_mul, hψ_rep C]
        norm_num
      refine ⟨?_, ?_⟩
      · rw [Finset.mul_sum]
        refine Finset.sum_bij Φ (fun a ha => Finset.mem_univ (Φ a ha)) hΦ_inj hΦ_surj ?_
        intro a ha
        let a' : nonZeroDivisors (Ideal R) := ⟨a.1, mem_nonZeroDivisors_of_ne_zero a.2.1⟩
        have h_prod : (⟨(Φ a ha).1, mem_nonZeroDivisors_of_ne_zero (Φ a ha).2.1⟩ : nonZeroDivisors (Ideal R)) =
            a' * J_rep C := rfl
        rw [h_prod, map_mul]
        calc ψ a'
            = (star (ψ (J_rep C)) * ψ (J_rep C)) * ψ a' := by rw [h_conj_mul, one_mul]
          _ = star (ψ (J_rep C)) * (ψ a' * ψ (J_rep C)) := by ring
      · symm
        refine Finset.card_bij Φ (fun a ha => Finset.mem_univ (Φ a ha)) hΦ_inj hΦ_surj
    refine ⟨?_, ?_⟩
    · rw [tsum_fintype]
      have h_fib := (Finset.sum_fiberwise_of_maps_to
        (s := (Finset.univ : Finset (S_m m)))
        (t := (Finset.univ : Finset (ClassGroup R)))
        (g := g)
        (f := fun I₀ : S_m m => ψ ⟨I₀.1, mem_nonZeroDivisors_of_ne_zero I₀.2.1⟩)
        (fun I₀ _ => Finset.mem_univ (g I₀))).symm
      rw [h_fib]
      refine Finset.sum_congr rfl (fun C _ => ?_)
      rw [tsum_fintype]
      exact (h_bij C).1
    · intro C
      rw [tsum_fintype]
      have h_norm_le : ‖∑ I : S_prin C m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖ ≤
          ((Finset.univ : Finset (S_prin C m)).card : ℝ) := by
        calc ‖∑ I : S_prin C m, ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖
            ≤ ∑ I : S_prin C m, ‖ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩‖ :=
              norm_sum_le _ _
          _ ≤ ∑ _I : S_prin C m, (1 : ℝ) :=
              Finset.sum_le_sum (fun I _ => hψ_le ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩)
          _ = ((Finset.univ : Finset (S_prin C m)).card : ℝ) := by
              rw [Finset.sum_const, nsmul_eq_mul, mul_one]
      have h_card_le : (Finset.univ : Finset (S_prin C m)).card ≤ Nat.card (S_m m) := by
        rw [(h_bij C).2, Nat.card_eq_fintype_card, ← Finset.card_univ]
        exact Finset.card_filter_le _ _
      exact le_trans h_norm_le (by exact_mod_cast h_card_le)
  
  let r : ℕ := NumberField.Units.rank K
  let ε : Fin r → Rˣ := NumberField.Units.fundSystem K
  let Q_K : (Fin r → ℝ) → ℝ := fun y =>
    ∑ w : NumberField.InfinitePlace K,
      (w.mult : ℝ) * ∏ i : Fin r,
        (w ((ε i : R) : K)) ^ (2 * y i)
  have h_gauss_int : ∀ (b : ℝ), 0 < b →
      MeasureTheory.Integrable (fun y : Fin r → ℝ => Real.exp (-b * Q_K y)) MeasureTheory.volume := by
    intro b hb
    let w₀ : NumberField.InfinitePlace K := NumberField.Units.dirichletUnitTheorem.w₀
    let S := {w : NumberField.InfinitePlace K // w ≠ w₀}
    let e : Fin r ≃ S := NumberField.Units.equivFinRank K
    let L : NumberField.InfinitePlace K → (Fin r → ℝ) → ℝ := fun w y =>
      ∑ i : Fin r, y i * ((w.mult : ℝ) * Real.log (w ((ε i : R) : K)))
    have hw_pos : ∀ (w : NumberField.InfinitePlace K) (i : Fin r),
        0 < w ((ε i : R) : K) := by
      intro w i
      exact w.pos_iff.mpr (ZeroMemClass.coe_eq_zero.not.mpr (Units.ne_zero (ε i)))
    have hQ_nn : ∀ y : Fin r → ℝ, 0 ≤ Q_K y := by
      intro y
      refine Finset.sum_nonneg (fun w _ => ?_)
      exact mul_nonneg (Nat.cast_nonneg _)
        (Finset.prod_nonneg (fun i _ => Real.rpow_nonneg (le_of_lt (hw_pos w i)) _))
    have hL_le : ∀ (w : NumberField.InfinitePlace K) (y : Fin r → ℝ),
        L w y ≤ (1 / 2 : ℝ) * Q_K y := by
      intro w y
      have h_single : (w.mult : ℝ) * ∏ i : Fin r,
          (w ((ε i : R) : K)) ^ (2 * y i) ≤ Q_K y := by
        refine Finset.single_le_sum (f := fun w' : NumberField.InfinitePlace K =>
          (w'.mult : ℝ) * ∏ i : Fin r, (w' ((ε i : R) : K)) ^ (2 * y i))
          (fun w' _ => ?_) (Finset.mem_univ w)
        exact mul_nonneg (Nat.cast_nonneg _)
          (Finset.prod_nonneg (fun i _ => Real.rpow_nonneg (le_of_lt (hw_pos w' i)) _))
      have h_prod_eq : (∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * y i)) =
          Real.exp (∑ i : Fin r, Real.log (w ((ε i : R) : K)) * (2 * y i)) := by
        rw [Real.exp_sum]
        refine Finset.prod_congr rfl (fun i _ => ?_)
        exact Real.rpow_def_of_pos (hw_pos w i) (2 * y i)
      have h_exp : ∑ i : Fin r, Real.log (w ((ε i : R) : K)) * (2 * y i) ≤
          ∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * y i) := by
        rw [h_prod_eq]
        linarith [Real.add_one_le_exp (∑ i : Fin r, Real.log (w ((ε i : R) : K)) * (2 * y i))]
      have h_mul : (w.mult : ℝ) * (∑ i : Fin r, Real.log (w ((ε i : R) : K)) * (2 * y i)) ≤
          (w.mult : ℝ) * ∏ i : Fin r, (w ((ε i : R) : K)) ^ (2 * y i) :=
        mul_le_mul_of_nonneg_left h_exp (Nat.cast_nonneg _)
      have h_2L : 2 * L w y = (w.mult : ℝ) * (∑ i : Fin r, Real.log (w ((ε i : R) : K)) * (2 * y i)) := by
        dsimp [L]
        rw [Finset.mul_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        ring
      linarith
    have hL_sum_zero : ∀ y : Fin r → ℝ, ∑ w : NumberField.InfinitePlace K, L w y = 0 := by
      intro y
      dsimp [L]
      rw [Finset.sum_comm]
      have h_inner : ∀ i : Fin r,
          ∑ w : NumberField.InfinitePlace K, y i * ((w.mult : ℝ) * Real.log (w ((ε i : R) : K))) = 0 := by
        intro i
        rw [← Finset.mul_sum]
        have h_log_sum : ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * Real.log (w ((ε i : R) : K)) = 0 := by
          have h_eq : ∑ w : NumberField.InfinitePlace K,
              (w.mult : ℝ) * Real.log (w ((ε i : R) : K)) =
              Real.log (∏ w : NumberField.InfinitePlace K, (w ((ε i : R) : K)) ^ w.mult) := by
            rw [Real.log_prod (fun w _ => pow_ne_zero w.mult (ne_of_gt (hw_pos w i)))]
            refine Finset.sum_congr rfl (fun w _ => ?_)
            rw [Real.log_pow]
          rw [h_eq, NumberField.InfinitePlace.prod_eq_abs_norm]
          have h_norm := NumberField.Units.norm K (ε i)
          have h_cast : |(Algebra.norm ℚ (((ε i : R) : K)))| = 1 := h_norm
          rw [h_cast, Rat.cast_one, Real.log_one]
        rw [h_log_sum, mul_zero]
      simp [h_inner]
    have hL_abs_le : ∀ (w' : S) (y : Fin r → ℝ),
        |L w'.1 y| ≤ ((r : ℝ) + 1) / 2 * Q_K y := by
      intro w' y
      have h_split := Fintype.sum_eq_add_sum_subtype_ne (fun w => L w y) w₀
      rw [hL_sum_zero y] at h_split
      have h_w0 := hL_le w₀ y
