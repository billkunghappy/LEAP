        have h1 := (Finset.add_sum_erase Finset.univ d₀ (Finset.mem_univ j₀)).symm
        have h2 := (Finset.add_sum_erase Finset.univ d₁ (Finset.mem_univ j₀)).symm
        have h_er : (∑ j ∈ Finset.univ.erase j₀, d₀ j) = ∑ j ∈ Finset.univ.erase j₀, d₁ j := by
          refine Finset.sum_congr rfl (fun j hj => ?_)
          dsimp [d₀]
          exact Function.update_of_ne (Finset.ne_of_mem_erase hj) 0 d₁
        rw [h2, hj₀_eq] at hm
        rw [h1, h_er, hd₀_zero]
        omega
      rw [← h_upd]
      exact h_s5 d₀ hd₀_le j₀ hd₀_zero (ih d₀ hd₀_le hm₀) u₀
  exact h_ind (∑ j : Fin n, d j) d hd rfl u

theorem mitsui_matrix_involution_harmonic_gaussian_degree_extension_of_real_base (n : ℕ)
    (A : Matrix (Fin n) (Fin n) ℝ) (hA : A.det ≠ 0)
    (u : Fin n → ℝ)
    (d_real d_cplx : Fin n → ℕ)
    (p : Fin n → Fin n)
    (ε : Fin n → ℝ)
    (hd_real : ∀ j : Fin n, d_real j ≤ 1)
    (hε_sq : ∀ j : Fin n, (ε j) ^ 2 = 1)
    (hp_inv : ∀ j : Fin n, p (p j) = j)
    (hd_cplx_supp : ∀ j : Fin n, d_cplx j ≠ 0 →
      p j ≠ j ∧ d_real j = 0 ∧ d_real (p j) = 0 ∧ d_cplx (p j) = 0)
    (h_gauss_sum : ∀ (B : Matrix (Fin n) (Fin n) ℝ), B.det ≠ 0 → ∀ (v : Fin n → ℝ),
      Summable (fun k : Fin n → ℤ =>
        Real.exp (-Real.pi *
          ∑ j : Fin n, (B.mulVec (fun i => v i + (k i : ℝ)) j) ^ 2)))
    (h_base : ∀ (u' : Fin n → ℝ),
      (∑' k : Fin n → ℤ,
        (((∏ j : Fin n, (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ (d_real j) : ℝ) : ℂ) *
        (Real.exp (-Real.pi *
          ∑ j : Fin n, (A.mulVec (fun i => u' i + (k i : ℝ)) j) ^ 2) : ℂ))) =
        ((-Complex.I) ^ (∑ j : Fin n, d_real j) *
          ((|A.det|⁻¹ : ℝ) : ℂ)) *
          ∑' l : Fin n → ℤ,
            Complex.exp (2 * Real.pi * Complex.I *
              (∑ i : Fin n, u' i * (l i : ℝ) : ℂ)) *
              (((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d_real j) : ℝ) : ℂ) *
              (Real.exp (-Real.pi *
                ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ))) :
    Summable (fun k : Fin n → ℤ =>
      (∏ j : Fin n, |A.mulVec (fun i => u i + (k i : ℝ)) j| ^ (d_real j)) *
      (∏ j : Fin n,
        ‖((A.mulVec (fun i => u i + (k i : ℝ)) j : ℝ) : ℂ) +
          (ε j : ℂ) * Complex.I * ((A.mulVec (fun i => u i + (k i : ℝ)) (p j) : ℝ) : ℂ)‖ ^ (d_cplx j)) *
      Real.exp (-Real.pi *
        ∑ j : Fin n, (A.mulVec (fun i => u i + (k i : ℝ)) j) ^ 2)) ∧
    Summable (fun l : Fin n → ℤ =>
      (∏ j : Fin n, |A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j| ^ (d_real j)) *
      (∏ j : Fin n,
        ‖((A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j : ℝ) : ℂ) +
          (ε j : ℂ) * Complex.I * ((A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) (p j) : ℝ) : ℂ)‖ ^ (d_cplx j)) *
      Real.exp (-Real.pi *
        ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2)) ∧
    (∑' k : Fin n → ℤ,
      (((∏ j : Fin n, (A.mulVec (fun i => u i + (k i : ℝ)) j) ^ (d_real j) : ℝ) : ℂ) *
      (∏ j : Fin n,
        (((A.mulVec (fun i => u i + (k i : ℝ)) j : ℝ) : ℂ) +
          (ε j : ℂ) * Complex.I * ((A.mulVec (fun i => u i + (k i : ℝ)) (p j) : ℝ) : ℂ)) ^ (d_cplx j)) *
      (Real.exp (-Real.pi *
        ∑ j : Fin n, (A.mulVec (fun i => u i + (k i : ℝ)) j) ^ 2) : ℂ))) =
      ((-Complex.I) ^ ((∑ j : Fin n, d_real j) + (∑ j : Fin n, d_cplx j)) *
        ((|A.det|⁻¹ : ℝ) : ℂ)) *
        ∑' l : Fin n → ℤ,
          Complex.exp (2 * Real.pi * Complex.I *
            (∑ i : Fin n, u i * (l i : ℝ) : ℂ)) *
            (((∏ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ (d_real j) : ℝ) : ℂ) *
            (∏ j : Fin n,
              (((A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j : ℝ) : ℂ) +
                (ε j : ℂ) * Complex.I * ((A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) (p j) : ℝ) : ℂ)) ^ (d_cplx j)) *
            (Real.exp (-Real.pi *
              ∑ j : Fin n, (A.transpose⁻¹.mulVec (fun i => (l i : ℝ)) j) ^ 2) : ℂ)) :=
by
  classical
  have h_det_dual : ∀ {N : ℕ} (B : Matrix (Fin N) (Fin N) ℝ), B.det ≠ 0 → B.transpose⁻¹.det ≠ 0 := by
    intro N B hB
    rw [Matrix.det_nonsing_inv, Matrix.det_transpose, Ring.inverse_eq_inv]
    exact inv_ne_zero hB
  have h_det_smul : ∀ {N : ℕ} (c : ℝ), c ≠ 0 → ∀ (B : Matrix (Fin N) (Fin N) ℝ), B.det ≠ 0 → (c • B).det ≠ 0 := by
    intro N c hc B hB
    rw [Matrix.det_smul, Fintype.card_fin]
    exact mul_ne_zero (pow_ne_zero N hc) hB
  let Z : (Fin n → ℝ) → Fin n → ℂ := fun v j =>
    ((v j : ℝ) : ℂ) + (ε j : ℂ) * Complex.I * ((v (p j) : ℝ) : ℂ)
  
  have h_poly_exp_bound : ∀ (c₁ : Fin n → ℕ),
      ∃ C_poly : ℝ, 0 < C_poly ∧ ∀ v : Fin n → ℝ,
        ((∏ j : Fin n, |v j| ^ (d_real j)) *
          ∏ j : Fin n, ‖Z v j‖ ^ (c₁ j)) ≤
        C_poly * Real.exp (3 * Real.pi / 4 * ∑ j : Fin n, (v j) ^ 2) := by
    intro c₁
    have h_abs_le : ∀ x : ℝ, |x| ≤ 1 + x ^ 2 := by
      intro x
      have h1 : 0 ≤ (|x| - 1) ^ 2 := sq_nonneg (|x| - 1)
      have h2 : |x| ^ 2 = x ^ 2 := sq_abs x
      nlinarith
    have h_coord_le : ∀ (v : Fin n → ℝ) (j : Fin n), |v j| ≤ 1 + ∑ i : Fin n, (v i) ^ 2 := by
      intro v j
      have h1 := h_abs_le (v j)
      have h2 : (v j) ^ 2 ≤ ∑ i : Fin n, (v i) ^ 2 :=
        Finset.single_le_sum (fun i _ => sq_nonneg (v i)) (Finset.mem_univ j)
      linarith
    have h_Z_le : ∀ (v : Fin n → ℝ) (j : Fin n),
        ‖Z v j‖ ≤ (1 + |ε j|) * (1 + ∑ i : Fin n, (v i) ^ 2) := by
      intro v j
      dsimp [Z]
      have h_tri := norm_add_le ((v j : ℝ) : ℂ) ((ε j : ℂ) * Complex.I * ((v (p j) : ℝ) : ℂ))
      rw [norm_mul, norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Complex.norm_real,
        Complex.norm_real, Real.norm_eq_abs, Real.norm_eq_abs, Real.norm_eq_abs] at h_tri
      have hj1 := h_coord_le v j
      have hj2 := h_coord_le v (p j)
      have hε_nn : 0 ≤ |ε j| := abs_nonneg (ε j)
      nlinarith
    let M : ℕ := (∑ j : Fin n, d_real j) + (∑ j : Fin n, c₁ j)
    let δ : ℝ := 3 * Real.pi / 4
    have hδ_pos : 0 < δ := by dsimp [δ]; positivity
    let η : ℝ := δ / ((M : ℝ) + 1)
    have hη_pos : 0 < η := by dsimp [η]; positivity
    let C_poly : ℝ := (∏ j : Fin n, (1 + |ε j|) ^ (c₁ j)) * (1 + η⁻¹) ^ M
    have hC_pos : 0 < C_poly := by
      dsimp [C_poly]
      exact mul_pos (Finset.prod_pos (fun j _ => by positivity)) (by positivity)
    refine ⟨C_poly, hC_pos, fun v => ?_⟩
    set S : ℝ := ∑ i : Fin n, (v i) ^ 2
    have hS_nn : 0 ≤ S := Finset.sum_nonneg (fun i _ => sq_nonneg (v i))
    have h_prod_d : (∏ j : Fin n, |v j| ^ (d_real j)) ≤ (1 + S) ^ (∑ j : Fin n, d_real j) := by
      calc (∏ j : Fin n, |v j| ^ (d_real j))
        _ ≤ ∏ j : Fin n, (1 + S) ^ (d_real j) :=
            Finset.prod_le_prod (fun j _ => by positivity)
              (fun j _ => pow_le_pow_left₀ (abs_nonneg _) (h_coord_le v j) (d_real j))
        _ = (1 + S) ^ (∑ j : Fin n, d_real j) := Finset.prod_pow_eq_pow_sum _ _ _
    have h_prod_c : (∏ j : Fin n, ‖Z v j‖ ^ (c₁ j)) ≤
        (∏ j : Fin n, (1 + |ε j|) ^ (c₁ j)) * (1 + S) ^ (∑ j : Fin n, c₁ j) := by
      calc (∏ j : Fin n, ‖Z v j‖ ^ (c₁ j))
        _ ≤ ∏ j : Fin n, ((1 + |ε j|) * (1 + S)) ^ (c₁ j) :=
            Finset.prod_le_prod (fun j _ => by positivity)
              (fun j _ => pow_le_pow_left₀ (norm_nonneg _) (h_Z_le v j) (c₁ j))
        _ = ∏ j : Fin n, ((1 + |ε j|) ^ (c₁ j) * (1 + S) ^ (c₁ j)) :=
            Finset.prod_congr rfl (fun j _ => mul_pow _ _ _)
        _ = (∏ j : Fin n, (1 + |ε j|) ^ (c₁ j)) * ∏ j : Fin n, (1 + S) ^ (c₁ j) :=
            Finset.prod_mul_distrib
        _ = (∏ j : Fin n, (1 + |ε j|) ^ (c₁ j)) * (1 + S) ^ (∑ j : Fin n, c₁ j) := by
            rw [Finset.prod_pow_eq_pow_sum]
    have h_one_add_S : 1 + S ≤ (1 + η⁻¹) * Real.exp (η * S) := by
      have h_inv : η⁻¹ * (η * S) = S := inv_mul_cancel_left₀ (ne_of_gt hη_pos) S
      have h_exp := Real.add_one_le_exp (η * S)
      have h_η_inv_nn : 0 ≤ η⁻¹ := by positivity
      have h_ηS_nn : 0 ≤ η * S := by positivity
      nlinarith
    have h_pow_M : (1 + S) ^ M ≤ (1 + η⁻¹) ^ M * Real.exp (δ * S) := by
      calc (1 + S) ^ M
        _ ≤ ((1 + η⁻¹) * Real.exp (η * S)) ^ M :=
            pow_le_pow_left₀ (by positivity) h_one_add_S M
        _ = (1 + η⁻¹) ^ M * (Real.exp (η * S)) ^ M := mul_pow _ _ _
        _ = (1 + η⁻¹) ^ M * Real.exp ((M : ℝ) * (η * S)) := by rw [← Real.exp_nat_mul]
        _ ≤ (1 + η⁻¹) ^ M * Real.exp (δ * S) := by
            refine mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr ?_) (by positivity)
            have h_eq : (M : ℝ) * (η * S) = ((M : ℝ) / ((M : ℝ) + 1)) * (δ * S) := by
              dsimp [η]; ring
            rw [h_eq]
            exact mul_le_of_le_one_left (by positivity)
              (div_le_one_of_le₀ (by linarith) (by positivity))
    have h_prod_comb :
        (∏ j : Fin n, |v j| ^ (d_real j)) * (∏ j : Fin n, ‖Z v j‖ ^ (c₁ j)) ≤
        (∏ j : Fin n, (1 + |ε j|) ^ (c₁ j)) * (1 + S) ^ M := by
      calc (∏ j : Fin n, |v j| ^ (d_real j)) * (∏ j : Fin n, ‖Z v j‖ ^ (c₁ j))
        _ ≤ (1 + S) ^ (∑ j : Fin n, d_real j) *
              ((∏ j : Fin n, (1 + |ε j|) ^ (c₁ j)) * (1 + S) ^ (∑ j : Fin n, c₁ j)) :=
            mul_le_mul h_prod_d h_prod_c (by positivity) (by positivity)
        _ = (∏ j : Fin n, (1 + |ε j|) ^ (c₁ j)) *
              ((1 + S) ^ (∑ j : Fin n, d_real j) * (1 + S) ^ (∑ j : Fin n, c₁ j)) := by ring
        _ = (∏ j : Fin n, (1 + |ε j|) ^ (c₁ j)) * (1 + S) ^ M := by
            dsimp [M]; rw [pow_add]
