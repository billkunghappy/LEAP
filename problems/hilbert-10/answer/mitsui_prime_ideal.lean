        (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a_rem v)).2 :=
      (Prod.ext_iff.mp hΦ).2
    have h_span_eq : Ideal.span ({u.1.1.1} : Set (NumberField.RingOfIntegers K)) =
        Ideal.span ({v.1.1.1} : Set (NumberField.RingOfIntegers K)) := by
      have hu_span := u.1.2.2.1
      have hv_span := v.1.2.2.1
      have h_pow_eq : u.1.1.2.1.asIdeal ^ u.1.1.2.2 = v.1.1.2.1.asIdeal ^ v.1.1.2.2 := by
        rw [congrArg Prod.fst h_pm_eq, congrArg Prod.snd h_pm_eq]
      exact hu_span.trans (h_pow_eq.trans hv_span.symm)
    have hfst1 : (((NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a_rem u)).1 :
        nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
        Ideal (NumberField.RingOfIntegers K)) =
        Ideal.span ({u.1.1.1} : Set (NumberField.RingOfIntegers K)) := by
      rw [NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv_apply_fst, ha_rem_pre u]
    have hfst2 : (((NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a_rem v)).1 :
        nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) :
        Ideal (NumberField.RingOfIntegers K)) =
        Ideal.span ({v.1.1.1} : Set (NumberField.RingOfIntegers K)) := by
      rw [NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv_apply_fst, ha_rem_pre v]
    have hfst_eq : (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a_rem u)).1 =
        (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a_rem v)).1 := by
      apply Subtype.ext
      apply Subtype.ext
      rw [hfst1, hfst2, h_span_eq]
    have heq_equiv : NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a_rem u) =
        NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K (a_rem v) :=
      Prod.ext hfst_eq h_tors_eq
    have ha_eq : a_rem u = a_rem v :=
      (NumberField.mixedEmbedding.fundamentalCone.integerSetEquiv K).injective heq_equiv
    have hx_eq : u.1.1.1 = v.1.1.1 := by
      rw [← ha_rem_pre u, ← ha_rem_pre v]
      exact congrArg (fun z : NumberField.mixedEmbedding.fundamentalCone.integerSet K =>
        (NumberField.mixedEmbedding.fundamentalCone.preimageOfMemIntegerSet z :
          NumberField.RingOfIntegers K)) ha_eq
    apply Subtype.ext
    apply Subtype.ext
    exact Prod.ext hx_eq h_pm_eq
  let emb_prod : D_cone_rem ↪ D_all_rem × NumberField.Units.torsion K := ⟨Φ, hΦ_inj⟩
  let G : D_all_rem × NumberField.Units.torsion K → ℝ := fun pz => F_rem pz.1
  have h_norm_lhs :
      ‖((∑' xpm : D_cone_Z, term_cone_Z xpm) - (∑' xpm : D_cone_Y, term_cone_Y xpm)) -
        (δ : ℂ) * (∑' xpm : D_cone_Y, term_ψ_cone_Y xpm)‖ ≤
      ∑ xpm : D_cone_rem, G (emb_prod xpm) := by
    rw [h_lhs_eq]
    calc ‖∑ xpm ∈ Finset.univ.filter (fun xpm : D_cone_Z => ¬ P_cone xpm), term_cone_Z xpm‖
      _ ≤ ∑ xpm ∈ Finset.univ.filter (fun xpm : D_cone_Z => ¬ P_cone xpm), ‖term_cone_Z xpm‖ :=
        norm_sum_le _ _
      _ = ∑ xpm ∈ Finset.univ.filter (fun xpm : D_cone_Z => ¬ P_cone xpm),
            term_all_Z ⟨xpm.1.2, ⟨xpm.2.1, xpm.2.2.2.2.1⟩⟩ :=
        Finset.sum_congr rfl (fun xpm _ => h_term_cone_norm xpm)
      _ = ∑ xpm : D_cone_rem, G (emb_prod xpm) :=
        Finset.sum_subtype (Finset.univ.filter (fun xpm : D_cone_Z => ¬ P_cone xpm))
          (fun _ => by simp) (fun xpm : D_cone_Z => term_all_Z ⟨xpm.1.2, ⟨xpm.2.1, xpm.2.2.2.2.1⟩⟩)
  have h_le_prod : (∑ xpm : D_cone_rem, G (emb_prod xpm)) ≤
      ∑ pz : D_all_rem × NumberField.Units.torsion K, G pz := by
    rw [← Finset.sum_map Finset.univ emb_prod G]
    exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
      (fun pz _ _ => h_term_all_Z_nonneg pz.1.1)
  have h_prod_eq : (∑ pz : D_all_rem × NumberField.Units.torsion K, G pz) =
      (NumberField.Units.torsionOrder K : ℝ) * ∑ pm : D_all_rem, F_rem pm := by
    rw [Fintype.sum_prod_type]
    dsimp only [G]
    have h_inner : ∀ pm : D_all_rem,
        (∑ _ζ : NumberField.Units.torsion K, F_rem pm) =
          (NumberField.Units.torsionOrder K : ℝ) * F_rem pm := by
      intro pm
      rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      rfl
    simp_rw [h_inner]
    rw [← Finset.mul_sum]
  rw [h_rhs_eq, ← h_prod_eq]
  exact le_trans h_norm_lhs h_le_prod

theorem mitsui_fundamentalCone_log_eq_fract_of_unitLogCoord {K : Type u} [Field K] [NumberField K]
    (Φ_W : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →
      Fin (NumberField.Units.rank K) → ℝ)
    (hΦ_W_pow : ∀ (I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) (ν : ℕ),
      ∃ d : Fin (NumberField.Units.rank K) → ℤ,
        ∀ j : Fin (NumberField.Units.rank K),
          Φ_W (I ^ ν) j = (ν : ℝ) * Φ_W I j + (d j : ℝ))
    (hΦ_W_prin : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      ∃ d : Fin (NumberField.Units.rank K) → ℤ,
        ∀ (w w₀ : NumberField.InfinitePlace K),
          Real.log (w (x : K) / w₀ (x : K)) =
            ∑ j : Fin (NumberField.Units.rank K),
              (Φ_W ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
                mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ j + (d j : ℝ)) *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)))
    (x : NumberField.RingOfIntegers K)
    (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (m : ℕ)
    (h_span : Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = p.asIdeal ^ m)
    (h_cone : NumberField.mixedEmbedding K (x : K) ∈ NumberField.mixedEmbedding.fundamentalCone K)
    (w w₀ : NumberField.InfinitePlace K) :
    Real.log (w (x : K) / w₀ (x : K)) =
      ∑ j : Fin (NumberField.Units.rank K),
        Int.fract ((m : ℝ) * Φ_W ⟨p.asIdeal, mem_nonZeroDivisors_of_ne_zero p.ne_bot⟩ j) *
          Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
            w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)) :=
by
  classical
  let n : ℕ := Module.finrank ℚ K
  let r : ℕ := NumberField.Units.rank K
  let η : Fin r → K := fun j =>
    (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)
  let p_nz : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
    ⟨p.asIdeal, mem_nonZeroDivisors_of_ne_zero p.ne_bot⟩
  have hp_pow_ne : p.asIdeal ^ m ≠ ⊥ := pow_ne_zero m p.ne_bot
  have hx_ne : x ≠ 0 := Ideal.span_singleton_eq_bot.not.mp (h_span.symm ▸ hp_pow_ne)
  have hxK : (x : K) ≠ 0 := NumberField.RingOfIntegers.coe_ne_zero_iff.mpr hx_ne
  let I_x : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
    ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
      mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩
  have hI_x_eq : I_x = p_nz ^ m := Subtype.ext h_span
  obtain ⟨d₁, hd₁⟩ := hΦ_W_prin x hx_ne
  obtain ⟨d₂, hd₂⟩ := hΦ_W_pow p_nz m
  let c : Fin r → ℝ := fun j => Φ_W I_x j + (d₁ j : ℝ)
  have hc_eq : ∀ j : Fin r, c j = ((d₂ j + d₁ j : ℤ) : ℝ) + (m : ℝ) * Φ_W p_nz j := by
    intro j
    dsimp [c]
    rw [hI_x_eq, hd₂ j]
    push_cast
    ring
  let B_R : Module.Basis (Fin r) ℝ (NumberField.Units.dirichletUnitTheorem.logSpace K) :=
    Module.Basis.ofZLatticeBasis ℝ (NumberField.Units.unitLattice K) (NumberField.Units.basisUnitLattice K)
  let W₀ : Fin r → ℝ := fun j =>
    B_R.repr (NumberField.mixedEmbedding.logMap (NumberField.mixedEmbedding K (x : K))) j
  have hW₀_mem : ∀ j : Fin r, W₀ j ∈ Set.Ico (0 : ℝ) 1 := by
    rw [NumberField.mixedEmbedding.fundamentalCone.eq_def, Set.mem_diff, Set.mem_preimage,
      ZSpan.mem_fundamentalDomain] at h_cone
    exact h_cone.1
  have h_log_norm : Real.log (NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K))) =
      ∑ u : NumberField.InfinitePlace K, (u.mult : ℝ) * Real.log (u (x : K)) := by
    rw [NumberField.mixedEmbedding.norm_eq_norm, ← NumberField.InfinitePlace.prod_eq_abs_norm,
      Real.log_prod (fun u _ => pow_ne_zero u.mult (ne_of_gt (u.pos_iff.mpr hxK)))]
    refine Finset.sum_congr rfl (fun u _ => ?_)
    rw [Real.log_pow]
  have hn_pos : (0 : ℝ) < (n : ℝ) := by
    dsimp [n]
    exact_mod_cast Module.finrank_pos (R := ℚ) (M := K)
  have hn_ne : (n : ℝ) ≠ 0 := ne_of_gt hn_pos
  have h_sum_mult : (∑ u : NumberField.InfinitePlace K, (u.mult : ℝ)) = (n : ℝ) := by
    dsimp [n]
    exact_mod_cast NumberField.InfinitePlace.sum_mult_eq (K := K)
  have h_place_eq : ∀ v : NumberField.InfinitePlace K,
      Real.log (v (x : K)) -
        Real.log (NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K))) * (n : ℝ)⁻¹ =
      ∑ j : Fin r, c j * Real.log (v (η j)) := by
    intro v
    have hvx : v (x : K) ≠ 0 := ne_of_gt (v.pos_iff.mpr hxK)
    have h_diff : ∀ u : NumberField.InfinitePlace K,
        Real.log (v (x : K)) - Real.log (u (x : K)) =
          ∑ j : Fin r, c j * (Real.log (v (η j)) - Real.log (u (η j))) := by
      intro u
      have hux : u (x : K) ≠ 0 := ne_of_gt (u.pos_iff.mpr hxK)
      have h1 := hd₁ v u
      rw [Real.log_div hvx hux] at h1
      rw [h1]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      have hη_ne : η j ≠ 0 :=
        NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero _)
      have hvη : v (η j) ≠ 0 := ne_of_gt (v.pos_iff.mpr hη_ne)
      have huη : u (η j) ≠ 0 := ne_of_gt (u.pos_iff.mpr hη_ne)
      change c j * Real.log (v (η j) / u (η j)) = c j * (Real.log (v (η j)) - Real.log (u (η j)))
      rw [Real.log_div hvη huη]
    have h_weighted :
        (∑ u : NumberField.InfinitePlace K, (u.mult : ℝ) * (Real.log (v (x : K)) - Real.log (u (x : K)))) =
        (∑ u : NumberField.InfinitePlace K, (u.mult : ℝ) *
          (∑ j : Fin r, c j * (Real.log (v (η j)) - Real.log (u (η j))))) := by
      refine Finset.sum_congr rfl (fun u _ => ?_)
      rw [h_diff u]
    have h_lhs :
        (∑ u : NumberField.InfinitePlace K, (u.mult : ℝ) * (Real.log (v (x : K)) - Real.log (u (x : K)))) =
        (n : ℝ) * Real.log (v (x : K)) -
          Real.log (NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K))) := by
      simp_rw [mul_sub]
      rw [Finset.sum_sub_distrib, ← Finset.sum_mul, h_sum_mult, ← h_log_norm]
    have h_rhs :
        (∑ u : NumberField.InfinitePlace K, (u.mult : ℝ) *
          (∑ j : Fin r, c j * (Real.log (v (η j)) - Real.log (u (η j))))) =
        (n : ℝ) * (∑ j : Fin r, c j * Real.log (v (η j))) := by
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      have h_sub_j :
          (∑ u : NumberField.InfinitePlace K,
            (u.mult : ℝ) * (c j * (Real.log (v (η j)) - Real.log (u (η j))))) =
          c j * ((∑ u : NumberField.InfinitePlace K, (u.mult : ℝ)) * Real.log (v (η j)) -
            ∑ u : NumberField.InfinitePlace K, (u.mult : ℝ) * Real.log (u (η j))) := by
        rw [Finset.sum_mul, ← Finset.sum_sub_distrib, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun u _ => by ring)
      rw [h_sub_j, h_sum_mult]
      have h_unit_sum :
          (∑ u : NumberField.InfinitePlace K, (u.mult : ℝ) * Real.log (u (η j))) = 0 := by
        simpa [η] using NumberField.Units.sum_mult_mul_log (NumberField.Units.fundSystem K j)
      rw [h_unit_sum, sub_zero]
      ring
    rw [h_lhs, h_rhs] at h_weighted
    calc Real.log (v (x : K)) -
          Real.log (NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K))) * (n : ℝ)⁻¹
      _ = (n : ℝ)⁻¹ * ((n : ℝ) * Real.log (v (x : K)) -
            Real.log (NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)))) := by
          field_simp [hn_ne]
      _ = (n : ℝ)⁻¹ * ((n : ℝ) * (∑ j : Fin r, c j * Real.log (v (η j)))) := by
          rw [h_weighted]
      _ = ∑ j : Fin r, c j * Real.log (v (η j)) := by
          field_simp [hn_ne]
  have h_logMap_eq :
      NumberField.mixedEmbedding.logMap (NumberField.mixedEmbedding K (x : K)) =
      ∑ j : Fin r, (c j) • B_R j := by
    ext v
    rw [NumberField.mixedEmbedding.logMap_apply, NumberField.mixedEmbedding.normAtPlace_apply]
    have hv := h_place_eq v.1
    dsimp [n] at hv
    rw [hv]
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    have hB_j : B_R j v = (v.1.mult : ℝ) * Real.log (v.1 (η j)) := by
      dsimp [B_R, η]
      rw [Module.Basis.ofZLatticeBasis_apply, ← NumberField.Units.logEmbedding_fundSystem,
        NumberField.Units.dirichletUnitTheorem.logEmbedding_component]
    rw [hB_j]
    ring
  have hW₀_eq_c : ∀ j : Fin r, W₀ j = c j := by
    intro j
    dsimp [W₀]
    rw [h_logMap_eq, map_sum]
    simp [map_smul, Module.Basis.repr_self, Finsupp.single_apply]
  have hc_fract : ∀ j : Fin r, c j = Int.fract ((m : ℝ) * Φ_W p_nz j) := by
    intro j
    have h_fract_W₀ : Int.fract (W₀ j) = W₀ j :=
      Int.fract_eq_iff.mpr ⟨(hW₀_mem j).1, (hW₀_mem j).2, 0, by simp⟩
    calc c j = W₀ j := (hW₀_eq_c j).symm
      _ = Int.fract (W₀ j) := h_fract_W₀.symm
      _ = Int.fract (c j) := by rw [hW₀_eq_c j]
      _ = Int.fract (((d₂ j + d₁ j : ℤ) : ℝ) + (m : ℝ) * Φ_W p_nz j) := by rw [hc_eq j]
      _ = Int.fract ((m : ℝ) * Φ_W p_nz j) :=
          Int.fract_intCast_add (d₂ j + d₁ j) ((m : ℝ) * Φ_W p_nz j)
  rw [hd₁ w w₀]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  change c j * Real.log (w (η j) / w₀ (η j)) =
    Int.fract ((m : ℝ) * Φ_W p_nz j) * Real.log (w (η j) / w₀ (η j))
  rw [hc_fract j]

theorem mitsui_riesz_primePower_char_fundamentalCone_le_of_ideal_monoidHom_bound {K : Type u} [Field K] [NumberField K]
    (Y : ℝ)
    (q : Ideal (NumberField.RingOfIntegers K))
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ)
    (ϕ_arch : NumberField.RingOfIntegers K → ℂ)
    (M : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℕ → ℂ)
    (hM : ∀ (x : NumberField.RingOfIntegers K)
      (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
      1 ≤ m →
      Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = p.asIdeal ^ m →
      NumberField.mixedEmbedding K (x : K) ∈ NumberField.mixedEmbedding.fundamentalCone K →
      ϕ_arch x = M p m)
    (B : ℝ) (hB : 0 ≤ B)
    (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ₀_unit : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0)
      (hx : IsUnit (Ideal.Quotient.mk q x)),
      ψ (Additive.ofMul hx.unit) =
        χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
          ϕ_arch x)
    (hχ₀_not_unit : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      ¬ IsUnit (Ideal.Quotient.mk q x) →
      χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 0)
    (h_bound : ∀ χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ,
      (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        χ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
        χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩) →
      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
        ‖χ I‖ = ‖χ₀ I‖ ∧ (χ I = 0 ↔ χ₀ I = 0)) →
      ‖∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
          M pm.1.1 pm.1.2 *
            ((χ ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩) ^ pm.1.2 *
              ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ))‖ ≤ B) :
    ‖∑' xpm : {xpm : NumberField.RingOfIntegers K ×
            IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          1 ≤ xpm.2.2 ∧
          Ideal.span ({xpm.1} : Set (NumberField.RingOfIntegers K)) = xpm.2.1.asIdeal ^ xpm.2.2 ∧
          NumberField.mixedEmbedding K (xpm.1 : K) ∈
            NumberField.mixedEmbedding.fundamentalCone K ∧
          (Ideal.absNorm xpm.2.1.asIdeal : ℝ) ^ xpm.2.2 ≤ Y ∧
          IsUnit (Ideal.Quotient.mk q xpm.1)},
        ψ (Additive.ofMul xpm.2.2.2.2.2.unit) *
          ((Real.log (Ideal.absNorm xpm.1.2.1.asIdeal) *
            Real.log (Y / ((Ideal.absNorm xpm.1.2.1.asIdeal : ℝ) ^ xpm.1.2.2)) : ℝ) : ℂ)‖
      ≤ (NumberField.Units.torsionOrder K : ℝ) * B :=
by
  classical
  have h_norm_span : ∀ x : NumberField.RingOfIntegers K,
      (Ideal.absNorm (Ideal.span ({x} : Set (NumberField.RingOfIntegers K))) : ℝ) =
        NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) := by
    intro x
    rw [Ideal.absNorm_span_singleton, NumberField.mixedEmbedding.norm_eq_norm,
      ← Algebra.coe_norm_int x, Nat.cast_natAbs]
    push_cast
    rfl
  have h_span_norm_pow : ∀ (x : NumberField.RingOfIntegers K)
      (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
      Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = p.asIdeal ^ m →
      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (x : K)) =
        (Ideal.absNorm p.asIdeal : ℝ) ^ m := by
    intro x p m h_span
    rw [← h_norm_span x, h_span, map_pow, Nat.cast_pow]
  have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p.asIdeal := by
