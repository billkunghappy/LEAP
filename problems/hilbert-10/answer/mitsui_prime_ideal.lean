      exact xpm.2.2.1
    have h_χ₀_pow :
        χ₀ ⟨Ideal.span ({xpm.1.1} : Set (NumberField.RingOfIntegers K)),
          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
        (χ₀ ⟨xpm.1.2.1.asIdeal, mem_nonZeroDivisors_of_ne_zero xpm.1.2.1.ne_bot⟩) ^ xpm.1.2.2 := by
      rw [h_ideal_eq, map_pow]
    have hG_zero : G xpm = 0 := by
      dsimp [G]
      rw [← h_χ₀_pow, hχ₀_not_unit xpm.1.1 hx_ne h_not_unit, zero_mul, mul_zero]
    exact hG_ne hG_zero
  calc ∑' xpm : D_cond, F_cond xpm
    _ = ∑' xpm : D_cond, G (e_sub xpm).1 := tsum_congr h_cond_eq
    _ = ∑' xpm : s_unit, G xpm.1 := Equiv.tsum_eq e_sub (fun xpm : s_unit => G xpm.1)
    _ = ∑' xpm : D_uncond, G xpm := tsum_subtype_eq_of_support_subset h_supp

theorem mitsui_exists_ideal_unitLogCoord_extending_principal {K : Type u} [Field K] [NumberField K] :
    ∃ Φ_W : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →
        Fin (NumberField.Units.rank K) → ℝ,
      (∀ I J : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
        ∃ d : Fin (NumberField.Units.rank K) → ℤ,
          ∀ j : Fin (NumberField.Units.rank K),
            Φ_W (I * J) j = Φ_W I j + Φ_W J j + (d j : ℝ)) ∧
      (∀ (I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K))) (ν : ℕ),
        ∃ d : Fin (NumberField.Units.rank K) → ℤ,
          ∀ j : Fin (NumberField.Units.rank K),
            Φ_W (I ^ ν) j = (ν : ℝ) * Φ_W I j + (d j : ℝ)) ∧
      (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
        ∃ d : Fin (NumberField.Units.rank K) → ℤ,
          ∀ (w w₀ : NumberField.InfinitePlace K),
            Real.log (w (x : K) / w₀ (x : K)) =
              ∑ j : Fin (NumberField.Units.rank K),
                (Φ_W ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
                  mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ j + (d j : ℝ)) *
                  Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                    w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) :=
by
  classical
  let n : ℕ := Module.finrank ℚ K
  let r : ℕ := NumberField.Units.rank K
  have h_s1 : ∃ W₀ : NumberField.RingOfIntegers K → Fin r → ℝ,
      (∀ (x y : NumberField.RingOfIntegers K), x ≠ 0 → y ≠ 0 →
        ∀ j : Fin r, W₀ (x * y) j = W₀ x j + W₀ y j) ∧
      (∀ u : (NumberField.RingOfIntegers K)ˣ,
        ∃ d : Fin r → ℤ, ∀ j : Fin r, W₀ (u : NumberField.RingOfIntegers K) j = (d j : ℝ)) ∧
      (∀ (x : NumberField.RingOfIntegers K), x ≠ 0 →
        ∀ (w w₀ : NumberField.InfinitePlace K),
          Real.log (w (x : K) / w₀ (x : K)) =
            ∑ j : Fin r,
              W₀ x j *
                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) := by
    let B_R : Module.Basis (Fin r) ℝ (NumberField.Units.dirichletUnitTheorem.logSpace K) :=
      Module.Basis.ofZLatticeBasis ℝ
        (NumberField.Units.unitLattice K)
        (NumberField.Units.basisUnitLattice K)
    let ℓ : NumberField.RingOfIntegers K → NumberField.InfinitePlace K → ℝ :=
      fun x w => Real.log (w (x : K)) -
        (∑ v : NumberField.InfinitePlace K, (v.mult : ℝ) * Real.log (v (x : K))) / (n : ℝ)
    let L_vec : NumberField.RingOfIntegers K → NumberField.Units.dirichletUnitTheorem.logSpace K :=
      fun x w => (w.1.mult : ℝ) * ℓ x w.1
    let W₀ : NumberField.RingOfIntegers K → Fin r → ℝ :=
      fun x j => B_R.repr (L_vec x) j
    refine ⟨W₀, ?_, ?_, ?_⟩
    · intro x y hx hy j
