    mitsui_riesz_primePower_unitLogCoord_cell_bound_of_rank_pos
      (K := K) h_rank Φ_W hΦ_W_mul hΦ_W_pow hΦ_W_prin
  have hn_pos : 0 < Module.finrank ℚ K := Module.finrank_pos
  have hn_rpos : (0 : ℝ) < (Module.finrank ℚ K : ℝ) := Nat.cast_pos.mpr hn_pos
  have hn_ne : (Module.finrank ℚ K : ℝ) ≠ 0 := ne_of_gt hn_rpos
