      (∑ p ∈ Finset.univ.filter (fun p : D_Y => ¬ Q p), term_Y p) := by
    rw [tsum_fintype]
    exact (Finset.sum_filter_add_sum_filter_not Finset.univ Q term_Y).symm
  have h_lhs_eq :
      (∑' p : D_Y, term_Y p) - (∑' p : D_Z, term_Z p) =
      δ * (∑ p ∈ Finset.univ.filter Q, term_ϑ_Y p) +
        (∑ p ∈ Finset.univ.filter (fun p : D_Y => ¬ Q p), term_Y p) := by
    rw [h_sum_Y, h_sum_filter_Y]
    ring
  have h_rhs_eq :
      δ * (∑' p : D_Y, term_ϑ_Y p) =
      δ * (∑ p ∈ Finset.univ.filter Q, term_ϑ_Y p) +
        (∑ p ∈ Finset.univ.filter (fun p : D_Y => ¬ Q p), δ * term_ϑ_Y p) := by
    have h_ϑ_split : (∑' p : D_Y, term_ϑ_Y p) =
        (∑ p ∈ Finset.univ.filter Q, term_ϑ_Y p) +
        (∑ p ∈ Finset.univ.filter (fun p : D_Y => ¬ Q p), term_ϑ_Y p) := by
      rw [tsum_fintype]
      exact (Finset.sum_filter_add_sum_filter_not Finset.univ Q term_ϑ_Y).symm
    rw [h_ϑ_split, mul_add]
    congr 1
    exact Finset.mul_sum _ _ _
  have h_short_le : ∀ p ∈ Finset.univ.filter (fun p : D_Y => ¬ Q p),
      term_Y p ≤ δ * term_ϑ_Y p := by
    intro p hp
    have hnotQ : ¬ Q p := (Finset.mem_filter.mp hp).2
    have h_gt : Real.exp (-δ) * Y < (Ideal.absNorm p.1.asIdeal : ℝ) :=
      not_le.mp hnotQ
    have hk_pos : (0 : ℝ) < (Ideal.absNorm p.1.asIdeal : ℝ) := by
      have := h_norm_ge_two p.1
      positivity
    have hdiv_pos : 0 < Y / (Ideal.absNorm p.1.asIdeal : ℝ) :=
      div_pos hY hk_pos
    have hdiv_le_exp : Y / (Ideal.absNorm p.1.asIdeal : ℝ) ≤ Real.exp δ := by
      rw [div_le_iff₀ hk_pos]
      have hY_eq : Y = Real.exp δ * (Real.exp (-δ) * Y) := by
        rw [← mul_assoc, ← Real.exp_add, add_neg_cancel, Real.exp_zero, one_mul]
      calc Y = Real.exp δ * (Real.exp (-δ) * Y) := hY_eq
        _ ≤ Real.exp δ * (Ideal.absNorm p.1.asIdeal : ℝ) :=
            mul_le_mul_of_nonneg_left (le_of_lt h_gt) (le_of_lt (Real.exp_pos δ))
    have hlog_le : Real.log (Y / (Ideal.absNorm p.1.asIdeal : ℝ)) ≤ δ := by
      have h1 := Real.log_le_log hdiv_pos hdiv_le_exp
      rwa [Real.log_exp] at h1
    have hlogN_nonneg : 0 ≤ Real.log (Ideal.absNorm p.1.asIdeal) :=
      Real.log_natCast_nonneg _
    dsimp [term_Y, term_ϑ_Y]
    calc Real.log (Ideal.absNorm p.1.asIdeal) *
          Real.log (Y / (Ideal.absNorm p.1.asIdeal : ℝ))
      _ ≤ Real.log (Ideal.absNorm p.1.asIdeal) * δ :=
          mul_le_mul_of_nonneg_left hlog_le hlogN_nonneg
      _ = δ * Real.log (Ideal.absNorm p.1.asIdeal) := mul_comm _ _
  have h_sum_short_le :
      (∑ p ∈ Finset.univ.filter (fun p : D_Y => ¬ Q p), term_Y p) ≤
      (∑ p ∈ Finset.univ.filter (fun p : D_Y => ¬ Q p), δ * term_ϑ_Y p) :=
    Finset.sum_le_sum h_short_le
  change (∑' p : D_Y, term_Y p) - (∑' p : D_Z, term_Z p) ≤ δ * (∑' p : D_Y, term_ϑ_Y p)
  linarith [h_lhs_eq, h_rhs_eq, h_sum_short_le]

theorem mitsui_chebyshev_primeIdeals_asymptotic {K : Type u} [Field K] [NumberField K] :
    ∃ c₄ : ℝ, 0 < c₄ ∧
      ∀ X : ℝ, 1 < X →
        |(∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
              (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ (Module.finrank ℚ K)},
            Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal))
          - X ^ (Module.finrank ℚ K)|
          ≤ c₄ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₄) :=
by
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_riesz_primePowers_asymptotic (K := K)
  obtain ⟨c₂, hc₂_pos, hc₂⟩ := mitsui_riesz_primeIdeals_to_primePowers (K := K)
  let c₀ : ℝ := c₁ + c₂
  have hc₀_pos : 0 < c₀ := by dsimp [c₀]; linarith
  let P : ℝ → ℝ := fun Z =>
    ∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
        (Ideal.absNorm p.asIdeal : ℝ) ≤ Z},
      Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal) *
        Real.log (Z / (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal : ℝ))
  let Ψ₁ : ℝ → ℝ := fun Z =>
    ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
        1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Z},
      Real.log (Ideal.absNorm pm.1.1.asIdeal) *
        Real.log (Z / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
  let ϑ : ℝ → ℝ := fun Z =>
    ∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
        (Ideal.absNorm p.asIdeal : ℝ) ≤ Z},
      Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal)
  have hP : ∀ Z : ℝ, 0 < Z → |P Z - Z| ≤ c₀ * Z * Real.exp (-Real.sqrt (Real.log Z) / c₀) := by
    intro Z hZ
    have h1 : |Ψ₁ Z - Z| ≤ c₁ * Z * Real.exp (-Real.sqrt (Real.log Z) / c₁) := hc₁ Z hZ
    have h2 : |P Z - Ψ₁ Z| ≤ c₂ * Z * Real.exp (-Real.sqrt (Real.log Z) / c₂) := hc₂ Z hZ
    have h_tri : |P Z - Z| ≤ |P Z - Ψ₁ Z| + |Ψ₁ Z - Z| := abs_sub_le (P Z) (Ψ₁ Z) Z
    have hsqrt_nonneg : 0 ≤ Real.sqrt (Real.log Z) := Real.sqrt_nonneg _
    have hexp1 : Real.exp (-Real.sqrt (Real.log Z) / c₁) ≤ Real.exp (-Real.sqrt (Real.log Z) / c₀) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left hsqrt_nonneg hc₁_pos (by dsimp [c₀]; linarith)
    have hexp2 : Real.exp (-Real.sqrt (Real.log Z) / c₂) ≤ Real.exp (-Real.sqrt (Real.log Z) / c₀) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left hsqrt_nonneg hc₂_pos (by dsimp [c₀]; linarith)
    have hterm1 : c₁ * Z * Real.exp (-Real.sqrt (Real.log Z) / c₁) ≤
        c₁ * Z * Real.exp (-Real.sqrt (Real.log Z) / c₀) :=
      mul_le_mul_of_nonneg_left hexp1 (by positivity)
    have hterm2 : c₂ * Z * Real.exp (-Real.sqrt (Real.log Z) / c₂) ≤
        c₂ * Z * Real.exp (-Real.sqrt (Real.log Z) / c₀) :=
      mul_le_mul_of_nonneg_left hexp2 (by positivity)
    have hsum : c₂ * Z * Real.exp (-Real.sqrt (Real.log Z) / c₀) +
        c₁ * Z * Real.exp (-Real.sqrt (Real.log Z) / c₀) =
        c₀ * Z * Real.exp (-Real.sqrt (Real.log Z) / c₀) := by
      dsimp [c₀]; ring
    linarith
  let c₄ : ℝ := 2 * c₀ + c₀ * Real.exp 1 + c₀ + c₀ * Real.exp (1 / c₀) + 1
  have hc₄_pos : 0 < c₄ := by
    dsimp [c₄]
    positivity
  refine ⟨c₄, hc₄_pos, ?_⟩
  intro X hX
  set n : ℕ := Module.finrank ℚ K
  have hn_pos : 0 < n := Module.finrank_pos
  have hn_ge_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn_pos
  set Y : ℝ := X ^ n
  have hX_pos : 0 < X := by linarith
  have hY_gt_one : 1 < Y := one_lt_pow₀ hX (ne_of_gt hn_pos)
  have hY_pos : 0 < Y := by linarith
  have hlogX_pos : 0 < Real.log X := Real.log_pos hX
  have hlogY_eq : Real.log Y = (n : ℝ) * Real.log X := by
    dsimp [Y]
    exact Real.log_pow X n
  have hlogX_le_logY : Real.log X ≤ Real.log Y := by
    rw [hlogY_eq]
    exact le_mul_of_one_le_left (le_of_lt hlogX_pos) hn_ge_one
  have hsqrtX_le_sqrtY : Real.sqrt (Real.log X) ≤ Real.sqrt (Real.log Y) :=
    Real.sqrt_le_sqrt hlogX_le_logY
  set δ : ℝ := Real.exp (-Real.sqrt (Real.log Y) / (2 * c₀))
  have hδ_pos : 0 < δ := Real.exp_pos _
  have hδ_le_one : δ ≤ 1 := by
    dsimp [δ]
    rw [Real.exp_le_one_iff, neg_div, neg_nonpos]
    exact div_nonneg (Real.sqrt_nonneg _) (by positivity)
  have hδ_sq : δ ^ 2 = Real.exp (-Real.sqrt (Real.log Y) / c₀) := by
    dsimp [δ]
    rw [sq, ← Real.exp_add]
    congr 1
    ring
  have hPY : |P Y - Y| ≤ c₀ * Y * δ ^ 2 := by
    rw [hδ_sq]
    exact hP Y hY_pos
  have hZ_plus_pos : 0 < Real.exp δ * Y := mul_pos (Real.exp_pos δ) hY_pos
  have hPZ_plus : |P (Real.exp δ * Y) - Real.exp δ * Y| ≤ (c₀ * Real.exp 1) * Y * δ ^ 2 := by
    have h1 := hP (Real.exp δ * Y) hZ_plus_pos
    have hlog_ge : Real.log Y ≤ Real.log (Real.exp δ * Y) := by
      rw [Real.log_mul (ne_of_gt (Real.exp_pos δ)) (ne_of_gt hY_pos), Real.log_exp]
      linarith
    have hsqrt_ge : Real.sqrt (Real.log Y) ≤ Real.sqrt (Real.log (Real.exp δ * Y)) :=
      Real.sqrt_le_sqrt hlog_ge
    have hexp_le : Real.exp (-Real.sqrt (Real.log (Real.exp δ * Y)) / c₀) ≤ δ ^ 2 := by
      rw [hδ_sq, Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_right hsqrt_ge (le_of_lt hc₀_pos)
    have hexpδ_le : Real.exp δ ≤ Real.exp 1 := Real.exp_le_exp.mpr hδ_le_one
    calc |P (Real.exp δ * Y) - Real.exp δ * Y|
      _ ≤ c₀ * (Real.exp δ * Y) * Real.exp (-Real.sqrt (Real.log (Real.exp δ * Y)) / c₀) := h1
      _ ≤ c₀ * (Real.exp δ * Y) * δ ^ 2 := mul_le_mul_of_nonneg_left hexp_le (by positivity)
      _ = c₀ * Real.exp δ * (Y * δ ^ 2) := by ring
      _ ≤ c₀ * Real.exp 1 * (Y * δ ^ 2) := by
          apply mul_le_mul_of_nonneg_right
          · exact mul_le_mul_of_nonneg_left hexpδ_le (le_of_lt hc₀_pos)
          · positivity
      _ = (c₀ * Real.exp 1) * Y * δ ^ 2 := by ring
  have hZ_minus_pos : 0 < Real.exp (-δ) * Y := mul_pos (Real.exp_pos (-δ)) hY_pos
  have hPZ_minus : |P (Real.exp (-δ) * Y) - Real.exp (-δ) * Y| ≤ (c₀ * Real.exp (1 / c₀)) * Y * δ ^ 2 := by
    have h1 := hP (Real.exp (-δ) * Y) hZ_minus_pos
    have hlog_eq : Real.log (Real.exp (-δ) * Y) = Real.log Y - δ := by
      rw [Real.log_mul (ne_of_gt (Real.exp_pos (-δ))) (ne_of_gt hY_pos), Real.log_exp]
      ring
    set u : ℝ := Real.log (Real.exp (-δ) * Y)
    have hu_le_sq : u ≤ Real.sqrt u ^ 2 := by
      rcases le_or_gt 0 u with hu | hu
      · rw [Real.sq_sqrt hu]
      · have : 0 ≤ Real.sqrt u ^ 2 := sq_nonneg _
        linarith
    have hsqrt_u_nonneg : 0 ≤ Real.sqrt u := Real.sqrt_nonneg u
    have hlogY_le_sq : Real.log Y ≤ (Real.sqrt u + 1) ^ 2 := by
      have : Real.log Y = u + δ := by dsimp [u]; linarith [hlog_eq]
      calc Real.log Y = u + δ := this
        _ ≤ Real.sqrt u ^ 2 + 1 := by linarith
        _ ≤ Real.sqrt u ^ 2 + 2 * Real.sqrt u + 1 := by linarith
        _ = (Real.sqrt u + 1) ^ 2 := by ring
    have hsqrtY_le : Real.sqrt (Real.log Y) ≤ Real.sqrt u + 1 := by
      have h2 := Real.sqrt_le_sqrt hlogY_le_sq
      rwa [Real.sqrt_sq (by linarith)] at h2
    have hexp_le : Real.exp (-Real.sqrt u / c₀) ≤ Real.exp (1 / c₀) * δ ^ 2 := by
      rw [hδ_sq, ← Real.exp_add, Real.exp_le_exp]
      have h_num : -Real.sqrt u ≤ 1 - Real.sqrt (Real.log Y) := by linarith
      have h_div : -Real.sqrt u / c₀ ≤ (1 - Real.sqrt (Real.log Y)) / c₀ :=
        div_le_div_of_nonneg_right h_num (le_of_lt hc₀_pos)
      have h_eq : (1 - Real.sqrt (Real.log Y)) / c₀ = 1 / c₀ + -Real.sqrt (Real.log Y) / c₀ := by ring
      linarith
    have hexp_negδ_le : Real.exp (-δ) ≤ 1 := by
      rw [Real.exp_le_one_iff]
      linarith
    calc |P (Real.exp (-δ) * Y) - Real.exp (-δ) * Y|
      _ ≤ c₀ * (Real.exp (-δ) * Y) * Real.exp (-Real.sqrt u / c₀) := h1
      _ ≤ c₀ * (Real.exp (-δ) * Y) * (Real.exp (1 / c₀) * δ ^ 2) :=
          mul_le_mul_of_nonneg_left hexp_le (by positivity)
      _ = Real.exp (-δ) * ((c₀ * Real.exp (1 / c₀)) * Y * δ ^ 2) := by ring
      _ ≤ 1 * ((c₀ * Real.exp (1 / c₀)) * Y * δ ^ 2) :=
          mul_le_mul_of_nonneg_right hexp_negδ_le (by positivity)
      _ = (c₀ * Real.exp (1 / c₀)) * Y * δ ^ 2 := by ring
  have hexp_pos_taylor : Real.exp δ - 1 - δ ≤ δ ^ 2 := by
    have habs : |δ| ≤ 1 := by rw [abs_of_pos hδ_pos]; exact hδ_le_one
    have h1 := Real.abs_exp_sub_one_sub_id_le habs
    exact le_trans (le_abs_self _) h1
  have hexp_neg_taylor : Real.exp (-δ) - 1 + δ ≤ δ ^ 2 := by
    have habs : |-δ| ≤ 1 := by rw [abs_neg, abs_of_pos hδ_pos]; exact hδ_le_one
    have h1 := Real.abs_exp_sub_one_sub_id_le habs
    have h2 : Real.exp (-δ) - 1 - (-δ) ≤ (-δ) ^ 2 := le_trans (le_abs_self _) h1
    linarith
  have h_fwd : δ * ϑ Y ≤ P (Real.exp δ * Y) - P Y :=
    mitsui_chebyshev_le_riesz_forward_diff Y δ hY_pos hδ_pos
  have h_bwd : P Y - P (Real.exp (-δ) * Y) ≤ δ * ϑ Y :=
    mitsui_chebyshev_ge_riesz_backward_diff Y δ hY_pos hδ_pos
  have hPY_upper : P Y - Y ≤ c₀ * Y * δ ^ 2 := (abs_le.mp hPY).2
  have hPY_lower : -(c₀ * Y * δ ^ 2) ≤ P Y - Y := (abs_le.mp hPY).1
  have hPZ_plus_upper : P (Real.exp δ * Y) - Real.exp δ * Y ≤ (c₀ * Real.exp 1) * Y * δ ^ 2 :=
    (abs_le.mp hPZ_plus).2
  have hPZ_minus_upper : P (Real.exp (-δ) * Y) - Real.exp (-δ) * Y ≤ (c₀ * Real.exp (1 / c₀)) * Y * δ ^ 2 :=
    (abs_le.mp hPZ_minus).2
  have h_taylor_pos_Y : (Real.exp δ - 1 - δ) * Y ≤ Y * δ ^ 2 := by
    calc (Real.exp δ - 1 - δ) * Y ≤ δ ^ 2 * Y :=
          mul_le_mul_of_nonneg_right hexp_pos_taylor (le_of_lt hY_pos)
      _ = Y * δ ^ 2 := by ring
  have h_taylor_neg_Y : (Real.exp (-δ) - 1 + δ) * Y ≤ Y * δ ^ 2 := by
    calc (Real.exp (-δ) - 1 + δ) * Y ≤ δ ^ 2 * Y :=
          mul_le_mul_of_nonneg_right hexp_neg_taylor (le_of_lt hY_pos)
      _ = Y * δ ^ 2 := by ring
  have h_diff_upper_δ : δ * (ϑ Y - Y) ≤ c₄ * Y * δ ^ 2 := by
    have h_ident : P (Real.exp δ * Y) - P Y - δ * Y =
        (P (Real.exp δ * Y) - Real.exp δ * Y) - (P Y - Y) + (Real.exp δ - 1 - δ) * Y := by ring
    have h_c4_ge : c₀ * Real.exp 1 + c₀ + 1 ≤ c₄ := by
      have : 0 ≤ 2 * c₀ + c₀ * Real.exp (1 / c₀) := by positivity
      dsimp [c₄]; linarith
    have hYδ2_nonneg : 0 ≤ Y * δ ^ 2 := by positivity
    have h_bound : (c₀ * Real.exp 1 + c₀ + 1) * (Y * δ ^ 2) ≤ c₄ * Y * δ ^ 2 := by
      calc (c₀ * Real.exp 1 + c₀ + 1) * (Y * δ ^ 2) ≤ c₄ * (Y * δ ^ 2) :=
            mul_le_mul_of_nonneg_right h_c4_ge hYδ2_nonneg
        _ = c₄ * Y * δ ^ 2 := by ring
    linarith
  have h_diff_lower_δ : δ * (Y - ϑ Y) ≤ c₄ * Y * δ ^ 2 := by
    have h_ident : δ * Y - (P Y - P (Real.exp (-δ) * Y)) =
        (P (Real.exp (-δ) * Y) - Real.exp (-δ) * Y) - (P Y - Y) + (Real.exp (-δ) - 1 + δ) * Y := by ring
    have h_c4_ge : c₀ * Real.exp (1 / c₀) + c₀ + 1 ≤ c₄ := by
      have : 0 ≤ 2 * c₀ + c₀ * Real.exp 1 := by positivity
      dsimp [c₄]; linarith
    have hYδ2_nonneg : 0 ≤ Y * δ ^ 2 := by positivity
    have h_bound : (c₀ * Real.exp (1 / c₀) + c₀ + 1) * (Y * δ ^ 2) ≤ c₄ * Y * δ ^ 2 := by
      calc (c₀ * Real.exp (1 / c₀) + c₀ + 1) * (Y * δ ^ 2) ≤ c₄ * (Y * δ ^ 2) :=
            mul_le_mul_of_nonneg_right h_c4_ge hYδ2_nonneg
        _ = c₄ * Y * δ ^ 2 := by ring
    linarith
  have h_upper : ϑ Y - Y ≤ c₄ * Y * δ := by
    apply le_of_mul_le_mul_left _ hδ_pos
    calc δ * (ϑ Y - Y) ≤ c₄ * Y * δ ^ 2 := h_diff_upper_δ
      _ = δ * (c₄ * Y * δ) := by ring
  have h_lower : -(c₄ * Y * δ) ≤ ϑ Y - Y := by
    have h1 : Y - ϑ Y ≤ c₄ * Y * δ := by
      apply le_of_mul_le_mul_left _ hδ_pos
      calc δ * (Y - ϑ Y) ≤ c₄ * Y * δ ^ 2 := h_diff_lower_δ
        _ = δ * (c₄ * Y * δ) := by ring
    linarith
  have h_abs_δ : |ϑ Y - Y| ≤ c₄ * Y * δ := abs_le.mpr ⟨h_lower, h_upper⟩
  have h_δ_le_final : δ ≤ Real.exp (-Real.sqrt (Real.log X) / c₄) := by
    dsimp [δ]
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    have h1 : Real.sqrt (Real.log X) / c₄ ≤ Real.sqrt (Real.log Y) / c₄ :=
      div_le_div_of_nonneg_right hsqrtX_le_sqrtY (le_of_lt hc₄_pos)
    have h2c0_le_c4 : 2 * c₀ ≤ c₄ := by
      have : 0 ≤ c₀ * Real.exp 1 + c₀ + c₀ * Real.exp (1 / c₀) + 1 := by positivity
      dsimp [c₄]; linarith
    have h2 : Real.sqrt (Real.log Y) / c₄ ≤ Real.sqrt (Real.log Y) / (2 * c₀) :=
      div_le_div_of_nonneg_left (Real.sqrt_nonneg _) (by positivity) h2c0_le_c4
    linarith
  calc |ϑ Y - Y| ≤ c₄ * Y * δ := h_abs_δ
    _ ≤ c₄ * Y * Real.exp (-Real.sqrt (Real.log X) / c₄) :=
        mul_le_mul_of_nonneg_left h_δ_le_final (by positivity)

theorem mitsui_chebyshev_principal_of_classGroup_char_bound {K : Type u} [Field K] [NumberField K]
    (Y : ℝ) (B : ℝ) (hB : 0 ≤ B)
    (hchar : ∀ χ : AddChar (Additive (ClassGroup (NumberField.RingOfIntegers K))) ℂ, χ ≠ 0 →
      ‖∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
            (Ideal.absNorm p.asIdeal : ℝ) ≤ Y},
          χ (Additive.ofMul (ClassGroup.mk0 ⟨p.1.asIdeal, mem_nonZeroDivisors_of_ne_zero p.1.ne_bot⟩)) *
            (Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal) : ℂ)‖ ≤ B) :
    |(∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
          p.asIdeal.IsPrincipal ∧
          (Ideal.absNorm p.asIdeal : ℝ) ≤ Y},
        Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal))
      - ((NumberField.classNumber K : ℝ))⁻¹ *
        (∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
            (Ideal.absNorm p.asIdeal : ℝ) ≤ Y},
          Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal))| ≤ B :=
by
  classical
  let G := Additive (ClassGroup (NumberField.RingOfIntegers K))
  let H : ℕ := Fintype.card G
  have hH_eq : H = NumberField.classNumber K :=
    Fintype.card_congr Additive.ofMul.symm
  have hH_pos : 0 < H := by
    rw [hH_eq]
    exact NumberField.classNumber_pos K
  have hHR_pos : (0 : ℝ) < (H : ℝ) := Nat.cast_pos.mpr hH_pos
  have hHR_ne : (H : ℝ) ≠ 0 := ne_of_gt hHR_pos
  have hHC_ne : (H : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hH_pos)
  have h_card_char : Fintype.card (AddChar G ℂ) = H := AddChar.card_eq
  have h_card_erase : (Finset.univ.erase (0 : AddChar G ℂ)).card = H - 1 := by
    rw [Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, h_card_char]
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊}
  haveI : Finite S_id := Ideal.finite_setOf_absNorm_le ⌊Y⌋₊
  let S_all := {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
    (Ideal.absNorm p.asIdeal : ℝ) ≤ Y}
  let S_prin := {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
    p.asIdeal.IsPrincipal ∧ (Ideal.absNorm p.asIdeal : ℝ) ≤ Y}
  let f_all : S_all → S_id := fun p => ⟨p.1.asIdeal, Nat.le_floor p.2⟩
  have hf_all_inj : Function.Injective f_all := by
    intro p₁ p₂ h
    ext1
    exact IsDedekindDomain.HeightOneSpectrum.ext (congrArg Subtype.val h)
  haveI : Finite S_all := Finite.of_injective f_all hf_all_inj
  letI : Fintype S_all := Fintype.ofFinite S_all
  let f_prin : S_prin → S_id := fun p => ⟨p.1.asIdeal, Nat.le_floor p.2.2⟩
  have hf_prin_inj : Function.Injective f_prin := by
    intro p₁ p₂ h
    ext1
    exact IsDedekindDomain.HeightOneSpectrum.ext (congrArg Subtype.val h)
  haveI : Finite S_prin := Finite.of_injective f_prin hf_prin_inj
  letI : Fintype S_prin := Fintype.ofFinite S_prin
  let g : S_all → G := fun p =>
    Additive.ofMul (ClassGroup.mk0 ⟨p.1.asIdeal, mem_nonZeroDivisors_of_ne_zero p.1.ne_bot⟩)
  have h_prin_iff : ∀ p : S_all, g p = 0 ↔ p.1.asIdeal.IsPrincipal := by
    intro p
    dsimp [g]
    rw [ofMul_eq_zero, ClassGroup.mk0_eq_one_iff]
  let e : S_prin ≃ {p : S_all // g p = 0} :=
    { toFun := fun p => ⟨⟨p.1, p.2.2⟩, (h_prin_iff ⟨p.1, p.2.2⟩).mpr p.2.1⟩
      invFun := fun p => ⟨p.1.1, ⟨(h_prin_iff p.1).mp p.2, p.1.2⟩⟩
      left_inv := fun _ => by ext; rfl
      right_inv := fun _ => by ext; rfl }
  have h_sum_prin :
      (∑' p : S_prin, Real.log (Ideal.absNorm p.1.asIdeal)) =
        ∑ p : S_all, (if g p = 0 then (1 : ℝ) else 0) * Real.log (Ideal.absNorm p.1.asIdeal) := by
    have he :
        (∑' p : S_prin, Real.log (Ideal.absNorm p.1.asIdeal)) =
          ∑' q : {p : S_all // g p = 0}, Real.log (Ideal.absNorm q.1.1.asIdeal) :=
      Equiv.tsum_eq e (fun q => Real.log (Ideal.absNorm q.1.1.asIdeal))
    rw [he, tsum_fintype]
    have h_sub :
        (∑ q : {p : S_all // g p = 0}, Real.log (Ideal.absNorm q.1.1.asIdeal)) =
          ∑ p ∈ Finset.univ.filter (fun p : S_all => g p = 0),
            Real.log (Ideal.absNorm p.1.asIdeal) :=
      (Finset.sum_subtype (Finset.univ.filter (fun p : S_all => g p = 0))
        (fun _ => by simp) (fun p : S_all => Real.log (Ideal.absNorm p.1.asIdeal))).symm
    rw [h_sub, Finset.sum_filter]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    split_ifs <;> ring
  have h_sum_all :
      (∑' p : S_all, Real.log (Ideal.absNorm p.1.asIdeal)) =
        ∑ p : S_all, Real.log (Ideal.absNorm p.1.asIdeal) :=
    tsum_fintype _
  have h_sum_char : ∀ χ : AddChar G ℂ,
      (∑' p : S_all, χ (g p) * (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)) =
        ∑ p : S_all, χ (g p) * (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ) :=
    fun _ => tsum_fintype _
  have h_ortho : ∀ p : S_all,
      ((if g p = 0 then (1 : ℂ) else 0) - (H : ℂ)⁻¹) =
        (H : ℂ)⁻¹ * ∑ χ ∈ Finset.univ.erase (0 : AddChar G ℂ), χ (g p) := by
    intro p
    have h1 : ∑ χ : AddChar G ℂ, χ (g p) = if g p = 0 then (H : ℂ) else 0 :=
      AddChar.sum_apply_eq_ite (g p)
    have h2 : (0 : AddChar G ℂ) (g p) + ∑ χ ∈ Finset.univ.erase (0 : AddChar G ℂ), χ (g p) =
        ∑ χ : AddChar G ℂ, χ (g p) :=
      Finset.add_sum_erase Finset.univ (fun χ : AddChar G ℂ => χ (g p)) (Finset.mem_univ _)
    rw [AddChar.zero_apply] at h2
    have h3 : ∑ χ ∈ Finset.univ.erase (0 : AddChar G ℂ), χ (g p) =
        (if g p = 0 then (H : ℂ) else 0) - 1 := by
      rw [← h1, ← h2]
      ring
    rw [h3]
    split_ifs with hgp
    · rw [mul_sub, mul_one, inv_mul_cancel₀ hHC_ne]
    · ring
  set Δ : ℝ :=
    (∑' p : S_prin, Real.log (Ideal.absNorm p.1.asIdeal)) -
      (H : ℝ)⁻¹ * (∑' p : S_all, Real.log (Ideal.absNorm p.1.asIdeal))
  have hΔ_real :
      Δ = ∑ p : S_all, ((if g p = 0 then (1 : ℝ) else 0) - (H : ℝ)⁻¹) *
        Real.log (Ideal.absNorm p.1.asIdeal) := by
    dsimp [Δ]
    rw [h_sum_prin, h_sum_all, Finset.mul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    ring
  have hΔ_complex :
      (Δ : ℂ) = (H : ℂ)⁻¹ * ∑ χ ∈ Finset.univ.erase (0 : AddChar G ℂ),
        ∑ p : S_all, χ (g p) * (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ) := by
    rw [hΔ_real]
    simp only [Complex.ofReal_sum, Complex.ofReal_mul, Complex.ofReal_sub,
      Complex.ofReal_inv, Complex.ofReal_natCast]
    rw [Finset.sum_comm, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    rw [← Finset.sum_mul, ← mul_assoc, ← h_ortho p]
    split_ifs <;> simp
  have h_norm_Δ : |Δ| = ‖(Δ : ℂ)‖ := (Complex.norm_real Δ).symm
  have h_goal_eq :
      |(∑' p : S_prin, Real.log (Ideal.absNorm p.1.asIdeal)) -
        ((NumberField.classNumber K : ℝ))⁻¹ *
          (∑' p : S_all, Real.log (Ideal.absNorm p.1.asIdeal))| = |Δ| := by
    dsimp [Δ]
    rw [hH_eq]
  rw [h_goal_eq, h_norm_Δ, hΔ_complex, norm_mul, norm_inv, Complex.norm_natCast]
  have h_sum_bound :
      ‖∑ χ ∈ Finset.univ.erase (0 : AddChar G ℂ),
          ∑ p : S_all, χ (g p) * (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)‖ ≤
        ((H - 1 : ℕ) : ℝ) * B := by
    calc
      ‖∑ χ ∈ Finset.univ.erase (0 : AddChar G ℂ),
          ∑ p : S_all, χ (g p) * (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)‖
        ≤ ∑ χ ∈ Finset.univ.erase (0 : AddChar G ℂ),
            ‖∑ p : S_all, χ (g p) * (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)‖ :=
          norm_sum_le _ _
      _ ≤ (Finset.univ.erase (0 : AddChar G ℂ)).card • B := by
          refine Finset.sum_le_card_nsmul _ _ B (fun χ hχ => ?_)
          rw [← h_sum_char χ]
          exact hchar χ (Finset.ne_of_mem_erase hχ)
      _ = ((H - 1 : ℕ) : ℝ) * B := by
          rw [h_card_erase, nsmul_eq_mul]
  have h_H_sub_le : ((H - 1 : ℕ) : ℝ) ≤ (H : ℝ) := by
    exact_mod_cast Nat.sub_le H 1
  calc
    (H : ℝ)⁻¹ * ‖∑ χ ∈ Finset.univ.erase (0 : AddChar G ℂ),
        ∑ p : S_all, χ (g p) * (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)‖
      ≤ (H : ℝ)⁻¹ * (((H - 1 : ℕ) : ℝ) * B) :=
        mul_le_mul_of_nonneg_left h_sum_bound (inv_nonneg.mpr (le_of_lt hHR_pos))
    _ ≤ (H : ℝ)⁻¹ * ((H : ℝ) * B) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right h_H_sub_le hB)
          (inv_nonneg.mpr (le_of_lt hHR_pos))
    _ = B := by
        rw [← mul_assoc, inv_mul_cancel₀ hHR_ne, one_mul]

theorem mitsui_chebyshev_char_sub_primePower_le {K : Type u} [Field K] [NumberField K]
    (Y : ℝ)
    (χ : AddChar (Additive (ClassGroup (NumberField.RingOfIntegers K))) ℂ) :
    ‖(∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
          (Ideal.absNorm p.asIdeal : ℝ) ≤ Y},
        χ (Additive.ofMul (ClassGroup.mk0 ⟨p.1.asIdeal, mem_nonZeroDivisors_of_ne_zero p.1.ne_bot⟩)) *
          (Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal) : ℂ))
      - (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
          (χ (Additive.ofMul (ClassGroup.mk0 ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩))) ^ pm.1.2 *
            (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ))‖
    ≤ ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
        Real.log (Ideal.absNorm pm.1.1.asIdeal) :=
by
  classical
  have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p.asIdeal := by
    intro p
    have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    omega
  have h_pm_bounds : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
      1 ≤ m → (Ideal.absNorm p.asIdeal : ℝ) ^ m ≤ Y →
      Ideal.absNorm p.asIdeal ≤ ⌊Y⌋₊ ∧ m ≤ ⌊Y⌋₊ := by
    intro p m hm h_pow
    have hk2 : 2 ≤ Ideal.absNorm p.asIdeal := h_norm_ge_two p
    have h_pow_nat : ((Ideal.absNorm p.asIdeal ^ m : ℕ) : ℝ) ≤ Y := by exact_mod_cast h_pow
    have h_km_le : Ideal.absNorm p.asIdeal ^ m ≤ ⌊Y⌋₊ := Nat.le_floor h_pow_nat
    have hm_ne : m ≠ 0 := by omega
    have hk_le_km : Ideal.absNorm p.asIdeal ≤ Ideal.absNorm p.asIdeal ^ m :=
      Nat.le_self_pow hm_ne (Ideal.absNorm p.asIdeal)
    have hm_le_2m : m ≤ 2 ^ m := (Nat.lt_pow_self (by decide : 1 < 2)).le
    have h2m_le_km : 2 ^ m ≤ Ideal.absNorm p.asIdeal ^ m := Nat.pow_le_pow_left hk2 m
    exact ⟨le_trans hk_le_km h_km_le, le_trans (le_trans hm_le_2m h2m_le_km) h_km_le⟩
  let D_1 := {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
    (Ideal.absNorm p.asIdeal : ℝ) ≤ Y}
  let D_ge1 := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y}
  let D_ge2 := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y}
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊}
  let S_prod : Set (Ideal (NumberField.RingOfIntegers K) × ℕ) :=
    S_id ×ˢ {m : ℕ | m ≤ ⌊Y⌋₊}
  have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Y⌋₊
  have hSprod_fin : S_prod.Finite := hSid_fin.prod (Set.finite_le_nat ⌊Y⌋₊)
  haveI : Finite S_id := hSid_fin
  haveI : Finite S_prod := hSprod_fin
  let f_1 : D_1 → S_id := fun p => ⟨p.1.asIdeal, Nat.le_floor p.2⟩
  have hf_1_inj : Function.Injective f_1 := by
    intro a b hab
    apply Subtype.ext
    apply IsDedekindDomain.HeightOneSpectrum.ext
    exact congrArg Subtype.val hab
  haveI : Finite D_1 := Finite.of_injective f_1 hf_1_inj
  letI : Fintype D_1 := Fintype.ofFinite D_1
  let f_ge1 : D_ge1 → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2), h_pm_bounds pm.1.1 pm.1.2 pm.2.1 pm.2.2⟩
  have hf_ge1_inj : Function.Injective f_ge1 := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    have h1 := congrArg Prod.fst hval
    have h2 := congrArg Prod.snd hval
    apply Subtype.ext
    apply Prod.ext
    · exact IsDedekindDomain.HeightOneSpectrum.ext h1
    · exact h2
  haveI : Finite D_ge1 := Finite.of_injective f_ge1 hf_ge1_inj
  letI : Fintype D_ge1 := Fintype.ofFinite D_ge1
  let f_ge2 : D_ge2 → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2), h_pm_bounds pm.1.1 pm.1.2 (by have := pm.2.1; omega) pm.2.2⟩
  have hf_ge2_inj : Function.Injective f_ge2 := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    have h1 := congrArg Prod.fst hval
    have h2 := congrArg Prod.snd hval
    apply Subtype.ext
    apply Prod.ext
    · exact IsDedekindDomain.HeightOneSpectrum.ext h1
    · exact h2
  haveI : Finite D_ge2 := Finite.of_injective f_ge2 hf_ge2_inj
  letI : Fintype D_ge2 := Fintype.ofFinite D_ge2
  let e_one : D_1 ≃ {pm : D_ge1 // pm.1.2 = 1} :=
    { toFun := fun p =>
        ⟨⟨(p.1, 1), ⟨le_rfl, by rw [pow_one]; exact p.2⟩⟩, rfl⟩
      invFun := fun pm =>
        ⟨pm.1.1.1, by
          have hY := pm.1.2.2
          rw [pm.2, pow_one] at hY
          exact hY⟩
      left_inv := fun p => by
        apply Subtype.ext
        rfl
      right_inv := fun pm => by
        apply Subtype.ext
        apply Subtype.ext
        apply Prod.ext
        · rfl
        · exact pm.2.symm }
  let term_1 : D_1 → ℂ := fun p =>
    χ (Additive.ofMul (ClassGroup.mk0 ⟨p.1.asIdeal, mem_nonZeroDivisors_of_ne_zero p.1.ne_bot⟩)) *
      (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)
  let term_ge1 : D_ge1 → ℂ := fun pm =>
    (χ (Additive.ofMul (ClassGroup.mk0 ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩))) ^ pm.1.2 *
      (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)
  have h_term_e_one : ∀ p : D_1, term_1 p = term_ge1 (e_one p).1 := by
    intro p
    dsimp [term_1, term_ge1, e_one]
    rw [pow_one]
  have h_sum_1 : (∑' p : D_1, term_1 p) =
      ∑ pm ∈ Finset.univ.filter (fun pm : D_ge1 => pm.1.2 = 1), term_ge1 pm := by
    have h1 : (∑' p : D_1, term_1 p) = ∑' p : D_1, term_ge1 (e_one p).1 :=
      tsum_congr h_term_e_one
    have h2 : (∑' p : D_1, term_ge1 (e_one p).1) =
        ∑' pm : {pm : D_ge1 // pm.1.2 = 1}, term_ge1 pm.1 :=
      Equiv.tsum_eq e_one (fun pm : {pm : D_ge1 // pm.1.2 = 1} => term_ge1 pm.1)
    rw [h1, h2, tsum_fintype]
    exact (Finset.sum_subtype (Finset.univ.filter (fun pm : D_ge1 => pm.1.2 = 1))
      (fun _ => by simp) term_ge1).symm
  have h_sum_ge1 : (∑' pm : D_ge1, term_ge1 pm) =
      (∑ pm ∈ Finset.univ.filter (fun pm : D_ge1 => pm.1.2 = 1), term_ge1 pm) +
      (∑ pm ∈ Finset.univ.filter (fun pm : D_ge1 => ¬ (pm.1.2 = 1)), term_ge1 pm) := by
    rw [tsum_fintype]
    exact (Finset.sum_filter_add_sum_filter_not Finset.univ
      (fun pm : D_ge1 => pm.1.2 = 1) term_ge1).symm
  have h_diff : (∑' p : D_1, term_1 p) - (∑' pm : D_ge1, term_ge1 pm) =
      - ∑ pm ∈ Finset.univ.filter (fun pm : D_ge1 => ¬ (pm.1.2 = 1)), term_ge1 pm := by
    rw [h_sum_1, h_sum_ge1]
    ring
  have h_term_norm : ∀ pm : D_ge1,
      ‖term_ge1 pm‖ = Real.log (Ideal.absNorm pm.1.1.asIdeal) := by
    intro pm
    dsimp [term_ge1]
    rw [norm_mul, norm_pow, AddChar.norm_apply, one_pow, one_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (Real.log_natCast_nonneg _)]
  have h_norm_diff : ‖(∑' p : D_1, term_1 p) - (∑' pm : D_ge1, term_ge1 pm)‖ ≤
      ∑ pm : {pm : D_ge1 // ¬ (pm.1.2 = 1)}, Real.log (Ideal.absNorm pm.1.1.1.asIdeal) := by
    rw [h_diff, norm_neg]
    calc ‖∑ pm ∈ Finset.univ.filter (fun pm : D_ge1 => ¬ (pm.1.2 = 1)), term_ge1 pm‖
      _ ≤ ∑ pm ∈ Finset.univ.filter (fun pm : D_ge1 => ¬ (pm.1.2 = 1)), ‖term_ge1 pm‖ :=
        norm_sum_le _ _
      _ = ∑ pm ∈ Finset.univ.filter (fun pm : D_ge1 => ¬ (pm.1.2 = 1)),
            Real.log (Ideal.absNorm pm.1.1.asIdeal) :=
        Finset.sum_congr rfl (fun pm _ => h_term_norm pm)
      _ = ∑ pm : {pm : D_ge1 // ¬ (pm.1.2 = 1)}, Real.log (Ideal.absNorm pm.1.1.1.asIdeal) :=
        Finset.sum_subtype (Finset.univ.filter (fun pm : D_ge1 => ¬ (pm.1.2 = 1)))
          (fun _ => by simp) (fun pm : D_ge1 => Real.log (Ideal.absNorm pm.1.1.asIdeal))
  let emb_ge2 : {pm : D_ge1 // ¬ (pm.1.2 = 1)} ↪ D_ge2 :=
    { toFun := fun pm =>
        ⟨pm.1.1, ⟨by have := pm.1.2.1; have := pm.2; omega, pm.1.2.2⟩⟩
      inj' := fun a b hab => by
        have hval := congrArg Subtype.val hab
        apply Subtype.ext
        apply Subtype.ext
        exact hval }
  let F_ge2 : D_ge2 → ℝ := fun pm => Real.log (Ideal.absNorm pm.1.1.asIdeal)
  have h_le_ge2 : (∑ pm : {pm : D_ge1 // ¬ (pm.1.2 = 1)},
      Real.log (Ideal.absNorm pm.1.1.1.asIdeal)) ≤ ∑' pm : D_ge2, F_ge2 pm := by
    change (∑ pm ∈ (Finset.univ : Finset {pm : D_ge1 // ¬ (pm.1.2 = 1)}),
        F_ge2 (emb_ge2 pm)) ≤ ∑' pm : D_ge2, F_ge2 pm
    rw [← Finset.sum_map Finset.univ emb_ge2 F_ge2, tsum_fintype]
    exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
      (fun pm _ _ => Real.log_natCast_nonneg _)
  exact le_trans h_norm_diff h_le_ge2

theorem mitsui_riesz_primePower_classGroup_char_norm_le_uncond {K : Type u} [Field K] [NumberField K]
    (Y : ℝ) (hY : 0 < Y)
    (χ : AddChar (Additive (ClassGroup (NumberField.RingOfIntegers K))) ℂ) :
    ‖∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
          1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
        (χ (Additive.ofMul (ClassGroup.mk0 ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩))) ^ pm.1.2 *
          ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
            Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)‖
      ≤ ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
          Real.log (Ideal.absNorm pm.1.1.asIdeal) *
            Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) :=
by
  classical
  have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p.asIdeal := by
    intro p
    have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    omega
  have h_pm_bounds : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
      1 ≤ m → (Ideal.absNorm p.asIdeal : ℝ) ^ m ≤ Y →
      Ideal.absNorm p.asIdeal ≤ ⌊Y⌋₊ ∧ m ≤ ⌊Y⌋₊ := by
    intro p m hm h_pow
    have hk2 : 2 ≤ Ideal.absNorm p.asIdeal := h_norm_ge_two p
    have h_pow_nat : ((Ideal.absNorm p.asIdeal ^ m : ℕ) : ℝ) ≤ Y := by exact_mod_cast h_pow
    have h_km_le : Ideal.absNorm p.asIdeal ^ m ≤ ⌊Y⌋₊ := Nat.le_floor h_pow_nat
    have hm_ne : m ≠ 0 := by omega
    have hk_le_km : Ideal.absNorm p.asIdeal ≤ Ideal.absNorm p.asIdeal ^ m :=
      Nat.le_self_pow hm_ne (Ideal.absNorm p.asIdeal)
    have hm_le_2m : m ≤ 2 ^ m := (Nat.lt_pow_self (by decide : 1 < 2)).le
    have h2m_le_km : 2 ^ m ≤ Ideal.absNorm p.asIdeal ^ m := Nat.pow_le_pow_left hk2 m
    exact ⟨le_trans hk_le_km h_km_le, le_trans (le_trans hm_le_2m h2m_le_km) h_km_le⟩
  let D_Y := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y}
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Y⌋₊}
  let S_prod : Set (Ideal (NumberField.RingOfIntegers K) × ℕ) :=
    S_id ×ˢ {m : ℕ | m ≤ ⌊Y⌋₊}
  have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Y⌋₊
  have hSprod_fin : S_prod.Finite := hSid_fin.prod (Set.finite_le_nat ⌊Y⌋₊)
  haveI : Finite S_prod := hSprod_fin
  let f_Y : D_Y → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2), h_pm_bounds pm.1.1 pm.1.2 pm.2.1 pm.2.2⟩
  have hf_Y_inj : Function.Injective f_Y := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    have h1 := congrArg Prod.fst hval
    have h2 := congrArg Prod.snd hval
    apply Subtype.ext
    apply Prod.ext
    · exact IsDedekindDomain.HeightOneSpectrum.ext h1
    · exact h2
  haveI : Finite D_Y := Finite.of_injective f_Y hf_Y_inj
  letI : Fintype D_Y := Fintype.ofFinite D_Y
  let w : D_Y → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal) *
      Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
  let term_cl : D_Y → ℂ := fun pm =>
    (χ (Additive.ofMul (ClassGroup.mk0 ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩))) ^ pm.1.2 *
      ((w pm : ℝ) : ℂ)
  have h_w_nonneg : ∀ pm : D_Y, 0 ≤ w pm := by
    intro pm
    have hk2 : 2 ≤ Ideal.absNorm pm.1.1.asIdeal := h_norm_ge_two pm.1.1
    have hk_pos : (0 : ℝ) < (Ideal.absNorm pm.1.1.asIdeal : ℝ) := by
      have : 0 < Ideal.absNorm pm.1.1.asIdeal := by omega
      exact_mod_cast this
    have hpow_pos : (0 : ℝ) < (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 :=
      pow_pos hk_pos pm.1.2
    have h_div_ge_one : 1 ≤ Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2) :=
      (one_le_div₀ hpow_pos).mpr pm.2.2
    exact mul_nonneg (Real.log_natCast_nonneg _) (Real.log_nonneg h_div_ge_one)
  have h_term_norm : ∀ pm : D_Y, ‖term_cl pm‖ = w pm := by
    intro pm
    dsimp [term_cl]
    rw [norm_mul, norm_pow, AddChar.norm_apply, one_pow, one_mul,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (h_w_nonneg pm)]
  change ‖∑' pm : D_Y, term_cl pm‖ ≤ ∑' pm : D_Y, w pm
  rw [tsum_fintype, tsum_fintype]
  calc ‖∑ pm : D_Y, term_cl pm‖
    _ ≤ ∑ pm : D_Y, ‖term_cl pm‖ := norm_sum_le Finset.univ term_cl
    _ = ∑ pm : D_Y, w pm := Finset.sum_congr rfl (fun pm _ => h_term_norm pm)

theorem mitsui_primePower_classGroup_char_riesz_forward_diff_le_uncond {K : Type u} [Field K] [NumberField K]
    (Y δ : ℝ) (hY : 0 < Y) (hδ : 0 < δ)
    (χ : AddChar (Additive (ClassGroup (NumberField.RingOfIntegers K))) ℂ) :
    ‖((∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Real.exp δ * Y},
          (χ (Additive.ofMul (ClassGroup.mk0 ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩))) ^ pm.1.2 *
            ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
              Real.log ((Real.exp δ * Y) / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ))
        - (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
            (χ (Additive.ofMul (ClassGroup.mk0 ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩))) ^ pm.1.2 *
              ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)))
      - (δ : ℂ) *
        (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
            (χ (Additive.ofMul (ClassGroup.mk0 ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩))) ^ pm.1.2 *
              (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ))‖
      ≤ ((∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Real.exp δ * Y},
            Real.log (Ideal.absNorm pm.1.1.asIdeal) *
              Real.log ((Real.exp δ * Y) / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)))
          - (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
              Real.log (Ideal.absNorm pm.1.1.asIdeal) *
                Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))))
        - δ *
          (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
              Real.log (Ideal.absNorm pm.1.1.asIdeal)) :=
by
  classical
  set Z_plus : ℝ := Real.exp δ * Y
  have hexp_gt_one : 1 < Real.exp δ := Real.one_lt_exp_iff.mpr hδ
  have hY_le_Z : Y ≤ Z_plus :=
    le_mul_of_one_le_left (le_of_lt hY) (le_of_lt hexp_gt_one)
  have hZ_pos : 0 < Z_plus := mul_pos (Real.exp_pos δ) hY
  have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p.asIdeal := by
    intro p
    have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    omega
  have h_pm_bounds : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
      1 ≤ m → (Ideal.absNorm p.asIdeal : ℝ) ^ m ≤ Z_plus →
      Ideal.absNorm p.asIdeal ≤ ⌊Z_plus⌋₊ ∧ m ≤ ⌊Z_plus⌋₊ := by
    intro p m hm h_pow
    have hk2 : 2 ≤ Ideal.absNorm p.asIdeal := h_norm_ge_two p
    have h_pow_nat : ((Ideal.absNorm p.asIdeal ^ m : ℕ) : ℝ) ≤ Z_plus := by exact_mod_cast h_pow
    have h_km_le : Ideal.absNorm p.asIdeal ^ m ≤ ⌊Z_plus⌋₊ := Nat.le_floor h_pow_nat
    have hm_ne : m ≠ 0 := by omega
    have hk_le_km : Ideal.absNorm p.asIdeal ≤ Ideal.absNorm p.asIdeal ^ m :=
      Nat.le_self_pow hm_ne (Ideal.absNorm p.asIdeal)
    have hm_le_2m : m ≤ 2 ^ m := (Nat.lt_pow_self (by decide : 1 < 2)).le
    have h2m_le_km : 2 ^ m ≤ Ideal.absNorm p.asIdeal ^ m := Nat.pow_le_pow_left hk2 m
    exact ⟨le_trans hk_le_km h_km_le, le_trans (le_trans hm_le_2m h2m_le_km) h_km_le⟩
  let D_all_Z := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Real.exp δ * Y}
  let D_all_Y := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
    1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y}
  let S_id : Set (Ideal (NumberField.RingOfIntegers K)) :=
    {I : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm I ≤ ⌊Z_plus⌋₊}
  let S_prod : Set (Ideal (NumberField.RingOfIntegers K) × ℕ) :=
    S_id ×ˢ {m : ℕ | m ≤ ⌊Z_plus⌋₊}
  have hSid_fin : S_id.Finite := Ideal.finite_setOf_absNorm_le ⌊Z_plus⌋₊
  have hSprod_fin : S_prod.Finite := hSid_fin.prod (Set.finite_le_nat ⌊Z_plus⌋₊)
  haveI : Finite S_prod := hSprod_fin
  let f_all_Z : D_all_Z → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2), h_pm_bounds pm.1.1 pm.1.2 pm.2.1 pm.2.2⟩
  have hf_all_Z_inj : Function.Injective f_all_Z := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    dsimp [f_all_Z] at hval
    exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext (Prod.mk.inj hval).1) (Prod.mk.inj hval).2)
  haveI : Finite D_all_Z := Finite.of_injective f_all_Z hf_all_Z_inj
  letI : Fintype D_all_Z := Fintype.ofFinite D_all_Z
  let f_all_Y : D_all_Y → S_prod := fun pm =>
    ⟨(pm.1.1.asIdeal, pm.1.2),
      h_pm_bounds pm.1.1 pm.1.2 pm.2.1 (le_trans pm.2.2 hY_le_Z)⟩
  have hf_all_Y_inj : Function.Injective f_all_Y := by
    intro a b hab
    have hval := congrArg Subtype.val hab
    dsimp [f_all_Y] at hval
    exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext (Prod.mk.inj hval).1) (Prod.mk.inj hval).2)
  haveI : Finite D_all_Y := Finite.of_injective f_all_Y hf_all_Y_inj
  letI : Fintype D_all_Y := Fintype.ofFinite D_all_Y
  have h_log_split : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
      Real.log ((Real.exp δ * Y) / ((Ideal.absNorm p.asIdeal : ℝ) ^ m)) =
      Real.log (Y / ((Ideal.absNorm p.asIdeal : ℝ) ^ m)) + δ := by
    intro p m
    have hk_pos : (0 : ℝ) < (Ideal.absNorm p.asIdeal : ℝ) := by
      have := h_norm_ge_two p
      positivity
    have hpow_pos : (0 : ℝ) < (Ideal.absNorm p.asIdeal : ℝ) ^ m := pow_pos hk_pos m
    rw [Real.log_div (ne_of_gt hZ_pos) (ne_of_gt hpow_pos),
      Real.log_mul (ne_of_gt (Real.exp_pos δ)) (ne_of_gt hY),
      Real.log_exp,
      Real.log_div (ne_of_gt hY) (ne_of_gt hpow_pos)]
    ring
  let P_all : D_all_Z → Prop := fun pm =>
    (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 ≤ Y
  let e_all : D_all_Y ≃ {pm : D_all_Z // P_all pm} :=
    { toFun := fun pm =>
        ⟨⟨pm.1, ⟨pm.2.1, le_trans pm.2.2 hY_le_Z⟩⟩, pm.2.2⟩
      invFun := fun pm => ⟨pm.1.1, ⟨pm.1.2.1, pm.2⟩⟩
      left_inv := fun pm => by apply Subtype.ext; rfl
      right_inv := fun pm => by apply Subtype.ext; apply Subtype.ext; rfl }
  let term_cl_Z : D_all_Z → ℂ := fun pm =>
    (χ (Additive.ofMul (ClassGroup.mk0 ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩))) ^ pm.1.2 *
      ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
        Real.log ((Real.exp δ * Y) / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)
  let term_cl_Y : D_all_Y → ℂ := fun pm =>
    (χ (Additive.ofMul (ClassGroup.mk0 ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩))) ^ pm.1.2 *
      ((Real.log (Ideal.absNorm pm.1.1.asIdeal) *
        Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2)) : ℝ) : ℂ)
  let term_ψ_cl_Y : D_all_Y → ℂ := fun pm =>
    (χ (Additive.ofMul (ClassGroup.mk0 ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩))) ^ pm.1.2 *
      (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)
  have h_term_cl_split : ∀ pm : D_all_Y,
      term_cl_Z (e_all pm).1 = term_cl_Y pm + (δ : ℂ) * term_ψ_cl_Y pm := by
    intro pm
    dsimp [term_cl_Z, term_cl_Y, term_ψ_cl_Y, e_all]
    rw [h_log_split pm.1.1 pm.1.2]
    push_cast
    ring
  have h_sum_cl_filter :
      ∑ pm ∈ Finset.univ.filter P_all, term_cl_Z pm =
      (∑' pm : D_all_Y, term_cl_Y pm) +
        (δ : ℂ) * (∑' pm : D_all_Y, term_ψ_cl_Y pm) := by
    have h1 : ∑ pm ∈ Finset.univ.filter P_all, term_cl_Z pm =
        ∑' pm : {pm : D_all_Z // P_all pm}, term_cl_Z pm.1 := by
      rw [tsum_fintype]
      exact Finset.sum_subtype (Finset.univ.filter P_all) (fun _ => by simp) term_cl_Z
    have h2 : (∑' pm : {pm : D_all_Z // P_all pm}, term_cl_Z pm.1) =
        ∑' pm : D_all_Y, term_cl_Z (e_all pm).1 :=
      (Equiv.tsum_eq e_all (fun pm : {pm : D_all_Z // P_all pm} => term_cl_Z pm.1)).symm
    rw [h1, h2, tsum_congr h_term_cl_split, tsum_fintype, tsum_fintype, tsum_fintype,
      Finset.sum_add_distrib, ← Finset.mul_sum]
  have h_sum_cl_Z : (∑' pm : D_all_Z, term_cl_Z pm) =
      (∑ pm ∈ Finset.univ.filter P_all, term_cl_Z pm) +
      (∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_cl_Z pm) := by
    rw [tsum_fintype]
    exact (Finset.sum_filter_add_sum_filter_not Finset.univ P_all term_cl_Z).symm
  have h_lhs_eq :
      ((∑' pm : D_all_Z, term_cl_Z pm) - (∑' pm : D_all_Y, term_cl_Y pm)) -
        (δ : ℂ) * (∑' pm : D_all_Y, term_ψ_cl_Y pm) =
      ∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_cl_Z pm := by
    rw [h_sum_cl_Z, h_sum_cl_filter]
    ring
  let term_all_Z : D_all_Z → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal) *
      Real.log ((Real.exp δ * Y) / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
  let term_all_Y : D_all_Y → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal) *
      Real.log (Y / ((Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2))
  let term_ψ_all_Y : D_all_Y → ℝ := fun pm =>
    Real.log (Ideal.absNorm pm.1.1.asIdeal)
  have h_term_all_split : ∀ pm : D_all_Y,
      term_all_Z (e_all pm).1 = term_all_Y pm + δ * term_ψ_all_Y pm := by
    intro pm
    dsimp [term_all_Z, term_all_Y, term_ψ_all_Y, e_all]
    rw [h_log_split pm.1.1 pm.1.2]
    ring
  have h_sum_all_filter :
      ∑ pm ∈ Finset.univ.filter P_all, term_all_Z pm =
      (∑' pm : D_all_Y, term_all_Y pm) +
        δ * (∑' pm : D_all_Y, term_ψ_all_Y pm) := by
    have h1 : ∑ pm ∈ Finset.univ.filter P_all, term_all_Z pm =
        ∑' pm : {pm : D_all_Z // P_all pm}, term_all_Z pm.1 := by
      rw [tsum_fintype]
      exact Finset.sum_subtype (Finset.univ.filter P_all) (fun _ => by simp) term_all_Z
    have h2 : (∑' pm : {pm : D_all_Z // P_all pm}, term_all_Z pm.1) =
        ∑' pm : D_all_Y, term_all_Z (e_all pm).1 :=
      (Equiv.tsum_eq e_all (fun pm : {pm : D_all_Z // P_all pm} => term_all_Z pm.1)).symm
    rw [h1, h2, tsum_congr h_term_all_split, tsum_fintype, tsum_fintype, tsum_fintype,
      Finset.sum_add_distrib, ← Finset.mul_sum]
  have h_sum_all_Z : (∑' pm : D_all_Z, term_all_Z pm) =
      (∑ pm ∈ Finset.univ.filter P_all, term_all_Z pm) +
      (∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_all_Z pm) := by
    rw [tsum_fintype]
    exact (Finset.sum_filter_add_sum_filter_not Finset.univ P_all term_all_Z).symm
  have h_rhs_eq :
      ((∑' pm : D_all_Z, term_all_Z pm) - (∑' pm : D_all_Y, term_all_Y pm)) -
        δ * (∑' pm : D_all_Y, term_ψ_all_Y pm) =
      ∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_all_Z pm := by
    rw [h_sum_all_Z, h_sum_all_filter]
    ring
  have h_term_all_Z_nonneg : ∀ pm : D_all_Z, 0 ≤ term_all_Z pm := by
    intro pm
    dsimp [term_all_Z]
    apply mul_nonneg (Real.log_natCast_nonneg _)
    apply Real.log_nonneg
    have hk_pos : (0 : ℝ) < (Ideal.absNorm pm.1.1.asIdeal : ℝ) := by
      have := h_norm_ge_two pm.1.1
      positivity
    have hpow_pos : (0 : ℝ) < (Ideal.absNorm pm.1.1.asIdeal : ℝ) ^ pm.1.2 :=
      pow_pos hk_pos pm.1.2
    exact (one_le_div₀ hpow_pos).mpr pm.2.2
  have h_term_cl_norm : ∀ pm : D_all_Z,
      ‖term_cl_Z pm‖ = term_all_Z pm := by
    intro pm
    have h_nonneg : 0 ≤ term_all_Z pm := h_term_all_Z_nonneg pm
    dsimp [term_cl_Z, term_all_Z] at h_nonneg ⊢
    rw [norm_mul, norm_pow, AddChar.norm_apply, one_pow, one_mul,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg h_nonneg]
  rw [h_lhs_eq, h_rhs_eq]
  calc ‖∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_cl_Z pm‖
    _ ≤ ∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), ‖term_cl_Z pm‖ :=
      norm_sum_le _ _
    _ = ∑ pm ∈ Finset.univ.filter (fun pm : D_all_Z => ¬ P_all pm), term_all_Z pm :=
      Finset.sum_congr rfl (fun pm _ => h_term_cl_norm pm)

theorem mitsui_primePower_classGroup_char_bound {K : Type u} [Field K] [NumberField K] :
    ∃ c₂ : ℝ, 0 < c₂ ∧
      ∀ X : ℝ, 1 < X →
        ∀ χ : AddChar (Additive (ClassGroup (NumberField.RingOfIntegers K))) ℂ, χ ≠ 0 →
          ‖∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
                1 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ X ^ (Module.finrank ℚ K)},
              (χ (Additive.ofMul (ClassGroup.mk0 ⟨pm.1.1.asIdeal, mem_nonZeroDivisors_of_ne_zero pm.1.1.ne_bot⟩))) ^ pm.1.2 *
                (Real.log (Ideal.absNorm pm.1.1.asIdeal) : ℂ)‖
            ≤ c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
by
  obtain ⟨c₀, hc₀_pos, hc₀⟩ :=
    mitsui_riesz_primePower_ray_char_bound (K := K) 2 (by decide : 1 < 2)
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_riesz_primePowers_asymptotic (K := K)
  let c₀' : ℝ := c₀ + (c₁ + 1) * Real.exp (1 / c₀)
  have hc₀'_pos : 0 < c₀' := by dsimp [c₀']; positivity
  have hc₀_le_c₀' : c₀ ≤ c₀' := by
    have : 0 ≤ (c₁ + 1) * Real.exp (1 / c₀) := by positivity
    dsimp [c₀']; linarith
  let c : ℝ := c₀' + c₁
  have hc_pos : 0 < c := by dsimp [c]; linarith
