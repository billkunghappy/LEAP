      field_simp [hD_ne, hNf_ne, ht_ne]
    rw [h_pref]
    have ht_inv_le : t⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (le_of_lt ht1)
    have hPJ_nn : 0 ≤ N_f ^ (-3 / 4 : ℝ) * P_K * J_K (a₀ * t ^ α) :=
      mul_nonneg (by positivity) (hJK_nn _)
    calc t⁻¹ * (N_f ^ (-3 / 4 : ℝ) * P_K * J_K (a₀ * t ^ α))
        ≤ 1 * (N_f ^ (-3 / 4 : ℝ) * P_K * J_K (a₀ * t ^ α)) :=
          mul_le_mul_of_nonneg_right ht_inv_le hPJ_nn
      _ = (N_f ^ (-3 / 4 : ℝ) * P_K) * J_K (a₀ * t ^ α) := by ring
      _ ≤ (N_f ^ (-3 / 4 : ℝ) * P_K) * (M₀ * Real.exp (-2 * c * t ^ α)) :=
          mul_le_mul_of_nonneg_left hJ_le (by positivity)
      _ = C₀ * Real.exp (-2 * c * t ^ α) := by dsimp [C₀]; ring
  · intro u hu
    have hu1 : 1 < u := Set.mem_Ioi.mp hu
    have hu_pos : 0 < u := lt_trans zero_lt_one hu1
    have hu_inv_pos : 0 < u⁻¹ := inv_pos.mpr hu_pos
    have hu_ne : u ≠ 0 := ne_of_gt hu_pos
    have huc_ne : (u : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hu_ne
    have hD_rpow_pos : 0 < D ^ (-1 / 2 : ℝ) := Real.rpow_pos_of_pos hD_pos _
    have hD_rpow_ne : D ^ (-1 / 2 : ℝ) ≠ 0 := ne_of_gt hD_rpow_pos
    have hNf_rpow_pos : 0 < N_f ^ (-1 / 2 : ℝ) := Real.rpow_pos_of_pos hNf_pos _
    have hNf_rpow_ne : N_f ^ (-1 / 2 : ℝ) ≠ 0 := ne_of_gt hNf_rpow_pos
    have h_term : ∀ (ψ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
        (v : ℝ), 0 < v → ∀ m : ℕ,
        (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
          ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
          (((m : ℝ) * (N_f ^ (-1 / 2 : ℝ) * (N_f ^ (-3 / 4 : ℝ) *
            (D ^ (-1 / 2 : ℝ) * W₀ (D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * ((m : ℝ) * v)))))) : ℝ) : ℂ) =
        (((P_K * N_f ^ (-3 / 4 : ℝ) * v⁻¹ : ℝ) : ℂ) *
          ((∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
            ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
            (J_K (Real.pi * (D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * ((m : ℝ) * v))) ^ α) : ℂ))) := by
      intro ψ v hv m
      by_cases hm : m = 0
      · subst hm
        haveI : IsEmpty {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = 0} :=
          ⟨fun ⟨I, hI_ne, hI_norm⟩ => hI_ne (Ideal.absNorm_eq_zero_iff.mp hI_norm)⟩
        rw [tsum_empty]
        simp
      · have hm_pos : 0 < (m : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hm)
        have hm_ne : (m : ℝ) ≠ 0 := ne_of_gt hm_pos
        have hτ_pos : 0 < D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * ((m : ℝ) * v)) := by positivity
        dsimp [W₀]
        rw [if_pos hτ_pos]
        have hv_ne : v ≠ 0 := ne_of_gt hv
        have h_real_eq :
            (m : ℝ) * (N_f ^ (-1 / 2 : ℝ) * (N_f ^ (-3 / 4 : ℝ) *
              (D ^ (-1 / 2 : ℝ) * (P_K * (D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * ((m : ℝ) * v)))⁻¹ *
                J_K (Real.pi * (D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * ((m : ℝ) * v))) ^ α))))) =
            (P_K * N_f ^ (-3 / 4 : ℝ) * v⁻¹) *
              J_K (Real.pi * (D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * ((m : ℝ) * v))) ^ α) := by
          field_simp [hD_rpow_ne, hNf_rpow_ne, hm_ne, hv_ne]
        rw [h_real_eq]
        push_cast
        ring
    have h_sum : ∀ (ψ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
        (v : ℝ), 0 < v →
        (∑' m : ℕ,
          (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
            ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
            (((m : ℝ) * (N_f ^ (-1 / 2 : ℝ) * (N_f ^ (-3 / 4 : ℝ) *
              (D ^ (-1 / 2 : ℝ) * W₀ (D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * ((m : ℝ) * v)))))) : ℝ) : ℂ)) =
        ((P_K * N_f ^ (-3 / 4 : ℝ) * v⁻¹ : ℝ) : ℂ) *
          (∑' m : ℕ,
            (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
              ψ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
              (J_K (Real.pi * (D ^ (-1 / 2 : ℝ) * (N_f ^ (-1 / 2 : ℝ) * ((m : ℝ) * v))) ^ α) : ℂ)) := by
      intro ψ v hv
      simp_rw [h_term ψ v hv]
      exact tsum_mul_left
    set χ_dual : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ :=
      (starRingEnd ℂ).toMonoidHom.comp χ₀
    have h_inv1 := h_inv_J u hu_pos
    have h_inv2 := h_inv_J u⁻¹ hu_inv_pos
    rw [inv_inv] at h_inv2
    have hu3 : u ^ (-3 : ℝ) = (u ^ 3)⁻¹ := by
      rw [Real.rpow_neg (le_of_lt hu_pos)]
      norm_num
    have h_alg1 : ∀ T : ℂ,
        ((u ^ (-3 : ℝ) : ℝ) : ℂ) * ((1 : ℂ) * (((P_K * N_f ^ (-3 / 4 : ℝ) * (u⁻¹)⁻¹ : ℝ) : ℂ) * ((u : ℂ) * ω_χ * T))) =
        ω_χ * (((P_K * N_f ^ (-3 / 4 : ℝ) * u⁻¹ : ℝ) : ℂ) * T) := by
      intro T
      rw [hu3]
      push_cast
      field_simp [huc_ne]
    have h_alg2 : ∀ T : ℂ,
        ((u ^ (-3 : ℝ) : ℝ) : ℂ) * (ω_χ * (((P_K * N_f ^ (-3 / 4 : ℝ) * (u⁻¹)⁻¹ : ℝ) : ℂ) * T)) =
        (1 : ℂ) * (((P_K * N_f ^ (-3 / 4 : ℝ) * u⁻¹ : ℝ) : ℂ) * (((u⁻¹ : ℝ) : ℂ) * ω_χ * T)) := by
      intro T
      rw [hu3]
      push_cast
      field_simp [huc_ne]
    refine ⟨?_, ?_⟩
    · rw [h_sum χ₀ u⁻¹ hu_inv_pos, h_sum χ_dual u hu_pos]
      dsimp [J_K, Q_K, D, N_f, α, n] at h_inv1 ⊢
      rw [h_inv1]
      exact h_alg1 _
    · rw [h_sum χ_dual u⁻¹ hu_inv_pos, h_sum χ₀ u hu_pos]
      dsimp [J_K, Q_K, D, N_f, α, n] at h_inv2 ⊢
      rw [h_inv2]
      exact h_alg2 _

theorem mitsui_ray_char_theta_kernels_inversion_and_unfolding {K : Type u} [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ_ray : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ q →
      χ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1)
    (hχ_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ I = 0))
    (hχ_nonprin : ∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ ∧ χ I₀ ≠ 1) :
    ∃ (χ₀ χ_dual : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
      (M_χ : ℂ → ℂ) (ω_χ : ℂ) (N_f : ℝ)
      (Φ₁ Φ₂ : ℝ → ℂ) (W_χ Ψ_χ : ℝ → ℝ) (C c α : ℝ),
      0 < N_f ∧ 0 < C ∧ 0 < c ∧ 0 < α ∧ ‖ω_χ‖ = 1 ∧
      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ₀ I‖ ≤ 1) ∧
      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ_dual I‖ ≤ 1) ∧
      Differentiable ℂ M_χ ∧
      (∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 → ‖M_χ s‖ ≤ (Ideal.absNorm q : ℝ) ^ 2) ∧
      ContinuousOn Φ₁ (Set.Ioi (1 : ℝ)) ∧
      ContinuousOn Φ₂ (Set.Ioi (1 : ℝ)) ∧
      MeasureTheory.AEStronglyMeasurable Ψ_χ (MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))) ∧
      (∀ u ∈ Set.Ioi (1 : ℝ), 0 ≤ Ψ_χ u) ∧
      (∀ u ∈ Set.Ioi (1 : ℝ), ‖Φ₁ u‖ ≤ Ψ_χ u ∧ ‖Φ₂ u‖ ≤ Ψ_χ u) ∧
      (∀ u ∈ Set.Ioi (1 : ℝ), Ψ_χ u ≤ C * Real.exp (-c * u ^ α)) ∧
      (∀ u ∈ Set.Ioi (1 : ℝ),
        ((u ^ (-3 : ℝ) : ℝ) : ℂ) * Φ₁ u⁻¹ = Φ₂ u ∧
        ((u ^ (-3 : ℝ) : ℝ) : ℂ) * Φ₂ u⁻¹ = Φ₁ u) ∧
      MeasureTheory.AEStronglyMeasurable W_χ (MeasureTheory.volume.restrict (Set.Ioi (0 : ℝ))) ∧
      (∀ t ∈ Set.Ioi (0 : ℝ), 0 ≤ W_χ t) ∧
      (∀ z : ℂ, 1 < z.re →
        MeasureTheory.IntegrableOn (fun t : ℝ => t ^ z.re * W_χ t) (Set.Ioi (0 : ℝ)) MeasureTheory.volume ∧
        (∫ t in Set.Ioi (0 : ℝ), (t : ℂ) ^ z * (W_χ t : ℂ)) =
          (N_f : ℂ) ^ (z / 2 - (3 / 4 : ℂ)) *
            (((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ (z / 2) *
              (Complex.Gammaℝ z) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
              (Complex.Gammaℂ z) ^ (NumberField.InfinitePlace.nrComplexPlaces K))) ∧
      (∀ u ∈ Set.Ioi (0 : ℝ),
        Φ₁ u = (1 : ℂ) * ∑' m : ℕ,
          (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
            χ₀ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
            (((m : ℝ) * W_χ ((m : ℝ) * u) : ℝ) : ℂ)) ∧
      (∀ u ∈ Set.Ioi (0 : ℝ),
        Φ₂ u = ω_χ * ∑' m : ℕ,
          (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
            χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
            (((m : ℝ) * W_χ ((m : ℝ) * u) : ℝ) : ℂ)) ∧
      (∀ s : ℂ, 1 < s.re →
        M_χ s * (N_f : ℂ) ^ (s / 2 - (3 / 4 : ℂ)) *
          LSeries (fun n =>
            ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
              χ₀ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s =
        LSeries (fun n =>
          ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
            χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s) :=
by
  obtain ⟨f, χ₀, M_χ, hf_ne, hχ₀_ray, hχ₀_norm_supp, hχ₀_nonprin, hχ₀_prim,
    hM_diff, hM_bound, h_euler_LSeries⟩ :=
    mitsui_ray_char_primitive_conductor_and_euler_factorization q hq χ hχ_ray hχ_norm_supp hχ_nonprin
  obtain ⟨ω_χ, W₀, C₀, c, α, hC₀_pos, hc_pos, hα_pos, hω_norm,
    hW₀_meas, hW₀_cont, hW₀_nn, hW₀_mellin, hWχ_bound, h_inv⟩ :=
    mitsui_primitive_ray_char_theta_inversion_and_unitDiscr_fubini
      f hf_ne χ₀ hχ₀_ray hχ₀_norm_supp hχ₀_nonprin hχ₀_prim
  set N_f : ℝ := (Ideal.absNorm f : ℝ)
  set D : ℝ := |(NumberField.discr K : ℝ)|
  have hf_norm_ne : Ideal.absNorm f ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hf_ne
  have hNf_pos : 0 < N_f := by
    dsimp [N_f]
    exact_mod_cast Nat.pos_of_ne_zero hf_norm_ne
  have hD_pos : 0 < D := by
    dsimp [D]
    exact abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  let χ_dual : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ :=
    (starRingEnd ℂ).toMonoidHom.comp χ₀
  have hχ₀_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ₀ I‖ ≤ 1 := by
    intro I
    by_cases hI : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤
    · rw [(hχ₀_norm_supp I).1 hI]
    · rw [(hχ₀_norm_supp I).2 hI, norm_zero]
      exact zero_le_one
  have hχ_dual_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ_dual I‖ ≤ 1 := by
    intro I
    change ‖starRingEnd ℂ (χ₀ I)‖ ≤ 1
    rw [Complex.norm_conj]
    exact hχ₀_norm I
  let W_K : ℝ → ℝ := fun y => D ^ (-1 / 2 : ℝ) * W₀ (D ^ (-1 / 2 : ℝ) * y)
  let W₁ : ℝ → ℝ := fun y => N_f ^ (-3 / 4 : ℝ) * W_K y
  let W_χ : ℝ → ℝ := fun t => N_f ^ (-1 / 2 : ℝ) * W₁ (N_f ^ (-1 / 2 : ℝ) * t)
  let Φ₁ : ℝ → ℂ := fun u => (1 : ℂ) * ∑' m : ℕ,
    (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
      χ₀ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
      (((m : ℝ) * W_χ ((m : ℝ) * u) : ℝ) : ℂ)
  let Φ₂ : ℝ → ℂ := fun u => ω_χ * ∑' m : ℕ,
    (∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = m},
      χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) *
      (((m : ℝ) * W_χ ((m : ℝ) * u) : ℝ) : ℂ)
  let Ψ_χ : ℝ → ℝ := fun u => ∑' m : ℕ,
    (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm I = m} : ℝ) *
      (m : ℝ) * W_χ ((m : ℝ) * u)
  have hWK_meas : Measurable W_K :=
    measurable_const.mul (hW₀_meas.comp (measurable_const.mul measurable_id))
  have hWK_nn_all : ∀ y : ℝ, 0 ≤ W_K y :=
    fun _ => mul_nonneg (Real.rpow_nonneg (le_of_lt hD_pos) _) (hW₀_nn _)
  have hW₁_meas : Measurable W₁ := measurable_const.mul hWK_meas
  have hW₁_nn_all : ∀ y : ℝ, 0 ≤ W₁ y :=
    fun y => mul_nonneg (Real.rpow_nonneg (le_of_lt hNf_pos) _) (hWK_nn_all y)
  have hWχ_meas : Measurable W_χ :=
    measurable_const.mul (hW₁_meas.comp (measurable_const.mul measurable_id))
  have hWχ_nn_all : ∀ t : ℝ, 0 ≤ W_χ t :=
    fun _ => mul_nonneg (Real.rpow_nonneg (le_of_lt hNf_pos) _) (hW₁_nn_all _)
  have hWχ_cont : ContinuousOn W_χ (Set.Ioi (1 : ℝ)) := by
    refine continuousOn_const.mul (continuousOn_const.mul (continuousOn_const.mul ?_))
    refine hW₀_cont.comp (continuousOn_const.mul (continuousOn_const.mul continuousOn_id)) ?_
    intro t ht
    have ht_pos : 0 < t := lt_trans zero_lt_one ht
    exact mul_pos (Real.rpow_pos_of_pos hD_pos _) (mul_pos (Real.rpow_pos_of_pos hNf_pos _) ht_pos)
  obtain ⟨_, _, hWK_rescale⟩ :=
    mitsui_mellin_Ioi_zero_comp_mul_left_and_integrableOn W₀ D hD_pos hW₀_meas hW₀_nn
  obtain ⟨hWχ_aemeas, hWχ_nn, hWχ_rescale⟩ :=
    mitsui_mellin_Ioi_zero_comp_mul_left_and_integrableOn W₁ N_f hNf_pos hW₁_meas hW₁_nn_all
  obtain ⟨C, hC_pos, hΨ_meas, hΨ_nn, hΨ_bound⟩ :=
    mitsui_ideal_norm_tsum_measurable_and_exp_bound_of_kernel_exp_bound
      (K := K) W_χ C₀ c α hC₀_pos hc_pos hα_pos hWχ_meas hWχ_nn_all hWχ_bound
  obtain ⟨hΦ₁_cont, hΦ₁_le⟩ :=
    mitsui_ray_char_series_continuousOn_and_norm_le_of_kernel_exp_bound
      χ₀ hχ₀_norm 1 norm_one W_χ C₀ c α hC₀_pos hc_pos hα_pos hWχ_cont hWχ_nn_all hWχ_bound
  obtain ⟨hΦ₂_cont, hΦ₂_le⟩ :=
    mitsui_ray_char_series_continuousOn_and_norm_le_of_kernel_exp_bound
      χ_dual hχ_dual_norm ω_χ hω_norm W_χ C₀ c α hC₀_pos hc_pos hα_pos hWχ_cont hWχ_nn_all hWχ_bound
  refine ⟨χ₀, χ_dual, M_χ, ω_χ, N_f, Φ₁, Φ₂, W_χ, Ψ_χ, C, c, α,
    hNf_pos, hC_pos, hc_pos, hα_pos, hω_norm, hχ₀_norm, hχ_dual_norm,
    hM_diff, hM_bound, hΦ₁_cont, hΦ₂_cont,
    hΨ_meas, hΨ_nn, fun u hu => ⟨hΦ₁_le u hu, hΦ₂_le u hu⟩, hΨ_bound,
    h_inv, hWχ_aemeas, hWχ_nn, ?_,
    fun _ _ => rfl, fun _ _ => rfl, h_euler_LSeries⟩
  intro z hz
  obtain ⟨hW₀_int_z, hW₀_eq_z⟩ := hW₀_mellin z hz
  obtain ⟨h_real_z, h_cplx_z⟩ := mitsui_archimedean_place_gamma_mellin_identities z hz
  rw [h_real_z, h_cplx_z] at hW₀_eq_z
  set γ₀_z : ℂ :=
    (Complex.Gammaℝ z) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
      (Complex.Gammaℂ z) ^ (NumberField.InfinitePlace.nrComplexPlaces K)
  obtain ⟨hWK_int_z, hWK_eq_z⟩ := hWK_rescale z γ₀_z hW₀_int_z hW₀_eq_z
  have hW₁_int_z : MeasureTheory.IntegrableOn (fun y : ℝ => y ^ z.re * W₁ y)
      (Set.Ioi (0 : ℝ)) MeasureTheory.volume := by
    have h_eq : (fun y : ℝ => y ^ z.re * W₁ y) =
        (fun y : ℝ => N_f ^ (-3 / 4 : ℝ) * (y ^ z.re * W_K y)) := by
      ext y; dsimp [W₁]; ring
    rw [h_eq]
    exact hWK_int_z.const_mul (N_f ^ (-3 / 4 : ℝ))
  have hW₁_eq_z : (∫ y in Set.Ioi (0 : ℝ), (y : ℂ) ^ z * (W₁ y : ℂ)) =
      ((N_f ^ (-3 / 4 : ℝ) : ℝ) : ℂ) * ((D : ℂ) ^ (z / 2) * γ₀_z) := by
    have h_congr : (∫ y in Set.Ioi (0 : ℝ), (y : ℂ) ^ z * (W₁ y : ℂ)) =
        ∫ y in Set.Ioi (0 : ℝ), ((N_f ^ (-3 / 4 : ℝ) : ℝ) : ℂ) * ((y : ℂ) ^ z * (W_K y : ℂ)) := by
      refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun y _ => ?_)
      dsimp [W₁]
      push_cast
      ring
    rw [h_congr, MeasureTheory.integral_const_mul, hWK_eq_z]
  obtain ⟨hWχ_int_z, hWχ_eq_z⟩ :=
    hWχ_rescale z (((N_f ^ (-3 / 4 : ℝ) : ℝ) : ℂ) * ((D : ℂ) ^ (z / 2) * γ₀_z)) hW₁_int_z hW₁_eq_z
  refine ⟨hWχ_int_z, ?_⟩
  rw [hWχ_eq_z]
  have hNf_cpow : ((N_f ^ (-3 / 4 : ℝ) : ℝ) : ℂ) = (N_f : ℂ) ^ (-(3 / 4 : ℂ)) := by
    rw [Complex.ofReal_cpow (le_of_lt hNf_pos)]
    push_cast
    congr 1
    ring
  have hNf_ne : (N_f : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hNf_pos)
  have hNf_mul : (N_f : ℂ) ^ (z / 2) * ((N_f ^ (-3 / 4 : ℝ) : ℝ) : ℂ) =
      (N_f : ℂ) ^ (z / 2 - (3 / 4 : ℂ)) := by
    rw [hNf_cpow, ← Complex.cpow_add _ _ hNf_ne, sub_eq_add_neg]
  calc (N_f : ℂ) ^ (z / 2) * (((N_f ^ (-3 / 4 : ℝ) : ℝ) : ℂ) * ((D : ℂ) ^ (z / 2) * γ₀_z))
      = ((N_f : ℂ) ^ (z / 2) * ((N_f ^ (-3 / 4 : ℝ) : ℝ) : ℂ)) * ((D : ℂ) ^ (z / 2) * γ₀_z) := by ring
    _ = (N_f : ℂ) ^ (z / 2 - (3 / 4 : ℂ)) * ((D : ℂ) ^ (z / 2) * γ₀_z) := by rw [hNf_mul]
    _ = (N_f : ℂ) ^ (z / 2 - (3 / 4 : ℂ)) * ((D : ℂ) ^ (z / 2) *
          (Complex.Gammaℝ z) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
          (Complex.Gammaℂ z) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) := by
        dsimp [γ₀_z]
        ring

theorem mitsui_ray_char_hecke_theta_rhp_and_euler_rep {K : Type u} [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ_ray : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ q →
      χ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1)
    (hχ_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ I = 0))
    (hχ_nonprin : ∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ ∧ χ I₀ ≠ 1) :
    ∃ (χ_dual : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
      (M_χ : ℂ → ℂ) (Φ₁ Φ₂ : ℝ → ℂ) (Ψ_χ : ℝ → ℝ),
      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ_dual I‖ ≤ 1) ∧
      Differentiable ℂ M_χ ∧
      (∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 → ‖M_χ s‖ ≤ (Ideal.absNorm q : ℝ) ^ 2) ∧
      ContinuousOn Φ₁ (Set.Ioi (1 : ℝ)) ∧
      ContinuousOn Φ₂ (Set.Ioi (1 : ℝ)) ∧
      (∀ u ∈ Set.Ioi (1 : ℝ), 0 ≤ Ψ_χ u) ∧
      (∀ u ∈ Set.Ioi (1 : ℝ), ‖Φ₁ u‖ ≤ Ψ_χ u ∧ ‖Φ₂ u‖ ≤ Ψ_χ u) ∧
      (∀ σ : ℝ, MeasureTheory.IntegrableOn (fun u : ℝ => u ^ σ * Ψ_χ u) (Set.Ioi (1 : ℝ)) MeasureTheory.volume) ∧
      (∀ s : ℂ, 1 < s.re →
        (((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ (s / 2) *
          (Complex.Gammaℝ s) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
          (Complex.Gammaℂ s) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) *
          LSeries (fun n =>
            ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
              χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s =
        M_χ s * ∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s * Φ₁ u + (u : ℂ) ^ (1 - s) * Φ₂ u)) ∧
      (∀ s : ℂ, s.re = -1 / 2 →
        ‖∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s * Φ₁ u + (u : ℂ) ^ (1 - s) * Φ₂ u)‖ =
          ‖(((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ ((1 - s) / 2) *
              (Complex.Gammaℝ (1 - s)) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
              (Complex.Gammaℂ (1 - s)) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) *
            LSeries (fun n =>
              ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
                χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) (1 - s)‖) :=
by
  obtain ⟨χ₀, χ_dual, M_χ, ω_χ, N_f, Φ₁, Φ₂, W_χ, Ψ_χ, C, c, α,
    hNf_pos, hC, hc, hα, hω_norm, hχ₀_norm, hχ_dual_norm,
    hM_diff, hM_bound, hΦ₁_cont, hΦ₂_cont,
    hΨ_meas, hΨ_nn, hΦ_le, hΨ_bound,
    h_inv, hW_meas, hW_nn, hW_mellin,
    hΦ₁_unfold, hΦ₂_unfold, h_euler_LSeries⟩ :=
    mitsui_ray_char_theta_kernels_inversion_and_unfolding q hq χ hχ_ray hχ_norm_supp hχ_nonprin
  have hΨ_int : ∀ σ : ℝ, MeasureTheory.IntegrableOn (fun u : ℝ => u ^ σ * Ψ_χ u) (Set.Ioi (1 : ℝ)) MeasureTheory.volume :=
    fun σ => mitsui_theta_kernel_moments_integrable_of_exp_bound Ψ_χ C c α hC hc hα hΨ_meas hΨ_nn hΨ_bound σ
  refine ⟨χ_dual, M_χ, Φ₁, Φ₂, Ψ_χ, hχ_dual_norm, hM_diff, hM_bound,
    hΦ₁_cont, hΦ₂_cont, hΨ_nn, hΦ_le, hΨ_int, ?_, ?_⟩
  · intro s hs
    set γ_s : ℂ :=
      (((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ (s / 2) *
        (Complex.Gammaℝ s) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
        (Complex.Gammaℂ s) ^ (NumberField.InfinitePlace.nrComplexPlaces K))
    set Γ_s : ℂ := (N_f : ℂ) ^ (s / 2 - (3 / 4 : ℂ)) * γ_s
    obtain ⟨hW_int_s, hW_eq_s⟩ := hW_mellin s hs
    have h_mellin₁ :
        (1 : ℂ) * Γ_s *
          LSeries (fun n =>
            ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
              χ₀ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s =
        ∫ u in Set.Ioi (0 : ℝ), (u : ℂ) ^ s * Φ₁ u :=
      mitsui_ray_char_mellin_Ioi_zero_of_kernel_unfolding
        χ₀ hχ₀_norm W_χ Φ₁ 1 Γ_s s hs hW_meas hW_nn hW_int_s hW_eq_s hΦ₁_unfold
    have h_fold₁ :
        (∫ u in Set.Ioi (0 : ℝ), (u : ℂ) ^ s * Φ₁ u) =
        ∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s * Φ₁ u + (u : ℂ) ^ (1 - s) * Φ₂ u) :=
      mitsui_mellin_Ioi_zero_eq_folded_Ioi_one_of_polarFree_inversion
        Φ₁ Φ₂ Ψ_χ hΦ₁_cont hΦ₂_cont hΨ_nn hΦ_le hΨ_int (fun u hu => (h_inv u hu).1) s
    calc γ_s *
          LSeries (fun n =>
            ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
              χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s
        = γ_s *
            (M_χ s * (N_f : ℂ) ^ (s / 2 - (3 / 4 : ℂ)) *
              LSeries (fun n =>
                ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
                  χ₀ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s) := by
            rw [← h_euler_LSeries s hs]
      _ = M_χ s *
            ((1 : ℂ) * Γ_s *
              LSeries (fun n =>
                ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
                  χ₀ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s) := by
            dsimp [Γ_s]; ring
      _ = M_χ s * (∫ u in Set.Ioi (0 : ℝ), (u : ℂ) ^ s * Φ₁ u) := by rw [h_mellin₁]
      _ = M_χ s * ∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s * Φ₁ u + (u : ℂ) ^ (1 - s) * Φ₂ u) := by
            rw [h_fold₁]
  · intro s hs
    have hs_1s : 1 < (1 - s).re := by
      rw [Complex.sub_re, Complex.one_re, hs]
      norm_num
    set γ_1s : ℂ :=
      (((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ ((1 - s) / 2) *
        (Complex.Gammaℝ (1 - s)) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
        (Complex.Gammaℂ (1 - s)) ^ (NumberField.InfinitePlace.nrComplexPlaces K))
    set Γ_1s : ℂ := (N_f : ℂ) ^ ((1 - s) / 2 - (3 / 4 : ℂ)) * γ_1s
    obtain ⟨hW_int_1s, hW_eq_1s⟩ := hW_mellin (1 - s) hs_1s
    have h_mellin₂ :
        ω_χ * Γ_1s *
          LSeries (fun n =>
            ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
              χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) (1 - s) =
        ∫ u in Set.Ioi (0 : ℝ), (u : ℂ) ^ (1 - s) * Φ₂ u :=
      mitsui_ray_char_mellin_Ioi_zero_of_kernel_unfolding
        χ_dual hχ_dual_norm W_χ Φ₂ ω_χ Γ_1s (1 - s) hs_1s hW_meas hW_nn hW_int_1s hW_eq_1s hΦ₂_unfold
    have h_fold₂ :
        (∫ u in Set.Ioi (0 : ℝ), (u : ℂ) ^ (1 - s) * Φ₂ u) =
        ∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ (1 - s) * Φ₂ u + (u : ℂ) ^ (1 - (1 - s)) * Φ₁ u) :=
      mitsui_mellin_Ioi_zero_eq_folded_Ioi_one_of_polarFree_inversion
        Φ₂ Φ₁ Ψ_χ hΦ₂_cont hΦ₁_cont hΨ_nn (fun u hu => ⟨(hΦ_le u hu).2, (hΦ_le u hu).1⟩)
        hΨ_int (fun u hu => (h_inv u hu).2) (1 - s)
    have h_congr_fold :
        (∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s * Φ₁ u + (u : ℂ) ^ (1 - s) * Φ₂ u)) =
        ∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ (1 - s) * Φ₂ u + (u : ℂ) ^ (1 - (1 - s)) * Φ₁ u) := by
      refine MeasureTheory.setIntegral_congr_fun measurableSet_Ioi (fun u _ => ?_)
      have h1s : 1 - (1 - s) = s := by ring
      rw [h1s, add_comm]
    have h_norm_Nf : ‖(N_f : ℂ) ^ ((1 - s) / 2 - (3 / 4 : ℂ))‖ = 1 := by
      rw [Complex.norm_cpow_eq_rpow_re_of_pos hNf_pos]
      have h_re_zero : ((1 - s) / 2 - (3 / 4 : ℂ)).re = 0 := by
        simp [Complex.sub_re, Complex.div_ofNat_re, hs]
        ring
      rw [h_re_zero, Real.rpow_zero]
    rw [h_congr_fold, ← h_fold₂, ← h_mellin₂]
    dsimp [Γ_1s]
    rw [norm_mul, norm_mul, norm_mul, hω_norm, h_norm_Nf, one_mul, one_mul, ← norm_mul]

theorem mitsui_ray_char_heckeL_completed_entire_and_mellin_bound {K : Type u} [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ_ray : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ q →
      χ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1)
    (hχ_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ I = 0))
    (hχ_nonprin : ∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ ∧ χ I₀ ≠ 1) :
    ∃ (C₀ : ℝ) (χ_dual : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ) (g_χ : ℂ → ℂ),
      0 < C₀ ∧
      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ_dual I‖ ≤ 1) ∧
      Differentiable ℂ g_χ ∧
      (∀ s : ℂ, 1 < s.re →
        g_χ s = LSeries (fun n =>
          ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
            χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s) ∧
      (∀ s : ℂ, s.re = -1 / 2 →
        ‖(((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ (s / 2) *
            (Complex.Gammaℝ s) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
            (Complex.Gammaℂ s) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) * g_χ s‖ ≤
          (Ideal.absNorm q : ℝ) ^ 2 *
            ‖(((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ ((1 - s) / 2) *
                (Complex.Gammaℝ (1 - s)) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
                (Complex.Gammaℂ (1 - s)) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) *
              LSeries (fun n =>
                ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
                  χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) (1 - s)‖) ∧
      (∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 → 1 ≤ |s.im| →
        ‖(((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ (s / 2) *
            (Complex.Gammaℝ s) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
            (Complex.Gammaℂ s) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) * g_χ s‖ ≤
          C₀ * (4 + |s.im|)) :=
by
  obtain ⟨χ_dual, M_χ, Φ₁, Φ₂, Ψ_χ, hχ_dual_norm, hM_diff, hM_bound,
      hΦ₁_cont, hΦ₂_cont, hΨ_nn, hΦ_le, hΨ_int, h_rhp, h_dual_line⟩ :=
    mitsui_ray_char_hecke_theta_rhp_and_euler_rep q hq χ hχ_ray hχ_norm_supp hχ_nonprin
  obtain ⟨hJ_diff, hJ_bound⟩ :=
    mitsui_hecke_char_theta_integral_differentiable_and_strip_norm_le
      Φ₁ Φ₂ Ψ_χ hΦ₁_cont hΦ₂_cont hΨ_nn hΦ_le hΨ_int
  set D : ℝ := |(NumberField.discr K : ℝ)|
  set r₁ : ℕ := NumberField.InfinitePlace.nrRealPlaces K
  set r₂ : ℕ := NumberField.InfinitePlace.nrComplexPlaces K
  have hD_pos : 0 < D := by
    dsimp [D]
    exact abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  have hr_pos : 0 < r₁ + 2 * r₂ := by
    dsimp [r₁, r₂]
    rw [NumberField.InfinitePlace.card_add_two_mul_card_eq_rank K]
    exact Module.finrank_pos
  obtain ⟨H, hH_diff, hH_inv⟩ :=
    mitsui_archimedean_completed_gamma_entire_inv D r₁ r₂ hD_pos hr_pos
  let J_χ : ℂ → ℂ := fun s =>
    ∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s * Φ₁ u + (u : ℂ) ^ (1 - s) * Φ₂ u)
  let Ξ_χ : ℂ → ℂ := fun s => M_χ s * J_χ s
  let g_χ : ℂ → ℂ := fun s => s * H s * Ξ_χ s
  set I₀ : ℝ := 2 * ∫ u in Set.Ioi (1 : ℝ), u ^ (2 : ℝ) * Ψ_χ u
  have h_int_nn : 0 ≤ ∫ u in Set.Ioi (1 : ℝ), u ^ (2 : ℝ) * Ψ_χ u := by
    apply MeasureTheory.setIntegral_nonneg measurableSet_Ioi
    intro u hu
    have hu_nn : 0 ≤ u := by linarith [Set.mem_Ioi.mp hu]
    exact mul_nonneg (Real.rpow_nonneg hu_nn 2) (hΨ_nn u hu)
  have hI₀_nn : 0 ≤ I₀ := by dsimp [I₀]; positivity
  let C₀ : ℝ := (Ideal.absNorm q : ℝ) ^ 2 * I₀ + 1
  have hC₀_pos : 0 < C₀ := by dsimp [C₀]; positivity
  have hΞ_diff : Differentiable ℂ Ξ_χ := hM_diff.mul hJ_diff
  have hg_diff : Differentiable ℂ g_χ := (differentiable_id.mul hH_diff).mul hΞ_diff
  have h_completed_eq : ∀ s : ℂ, -1 / 2 ≤ s.re → s ≠ 0 →
      ((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * g_χ s =
        Ξ_χ s := by
    intro s hs_re hs_ne
    set γ_s : ℂ := (D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂
    have h_inv : s * γ_s * H s = 1 := hH_inv s hs_re hs_ne
    calc γ_s * g_χ s = γ_s * (s * H s * Ξ_χ s) := rfl
      _ = (s * γ_s * H s) * Ξ_χ s := by ring
      _ = 1 * Ξ_χ s := by rw [h_inv]
      _ = Ξ_χ s := one_mul _
  refine ⟨C₀, χ_dual, g_χ, hC₀_pos, hχ_dual_norm, hg_diff, ?_, ?_, ?_⟩
  · intro s hs
    have hs_re : -1 / 2 ≤ s.re := by linarith
    have hs_ne : s ≠ 0 := by
      intro h0
      rw [h0, Complex.zero_re] at hs
      norm_num at hs
    set γ_s : ℂ := (D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂
    set L_s : ℂ := LSeries (fun n =>
      ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
        χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s
    have h_inv : s * γ_s * H s = 1 := hH_inv s hs_re hs_ne
    have h_eq : γ_s * L_s = Ξ_χ s := h_rhp s hs
    calc g_χ s = s * H s * Ξ_χ s := rfl
      _ = s * H s * (γ_s * L_s) := by rw [← h_eq]
      _ = (s * γ_s * H s) * L_s := by ring
      _ = 1 * L_s := by rw [h_inv]
      _ = L_s := one_mul _
  · intro s hs
    have hs1 : -1 / 2 ≤ s.re := by linarith
    have hs2 : s.re ≤ 2 := by linarith
    have hs_ne : s ≠ 0 := by
      intro h0
      rw [h0, Complex.zero_re] at hs
      norm_num at hs
    calc ‖((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * g_χ s‖
        = ‖M_χ s * J_χ s‖ := by rw [h_completed_eq s hs1 hs_ne]
      _ = ‖M_χ s‖ * ‖J_χ s‖ := norm_mul _ _
      _ ≤ (Ideal.absNorm q : ℝ) ^ 2 * ‖J_χ s‖ :=
          mul_le_mul_of_nonneg_right (hM_bound s hs1 hs2) (norm_nonneg _)
      _ = (Ideal.absNorm q : ℝ) ^ 2 *
            ‖((D : ℂ) ^ ((1 - s) / 2) * (Complex.Gammaℝ (1 - s)) ^ r₁ *
                (Complex.Gammaℂ (1 - s)) ^ r₂) *
              LSeries (fun n =>
                ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
                  χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) (1 - s)‖ := by
          rw [← h_dual_line s hs]
  · intro s hs1 hs2 hs_im
    have hs_ne : s ≠ 0 := by
      intro h0
      rw [h0, Complex.zero_im, abs_zero] at hs_im
      norm_num at hs_im
    have h4_ge_one : 1 ≤ 4 + |s.im| := by linarith [abs_nonneg s.im]
    have h_prod_le : ‖M_χ s‖ * ‖J_χ s‖ ≤ (Ideal.absNorm q : ℝ) ^ 2 * I₀ :=
      mul_le_mul (hM_bound s hs1 hs2) (hJ_bound s hs1 hs2) (norm_nonneg _) (by positivity)
    have h_le_C₀ : (Ideal.absNorm q : ℝ) ^ 2 * I₀ ≤ C₀ := by
      dsimp [C₀]; linarith
    calc ‖((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * g_χ s‖
        = ‖M_χ s * J_χ s‖ := by rw [h_completed_eq s hs1 hs_ne]
      _ = ‖M_χ s‖ * ‖J_χ s‖ := norm_mul _ _
      _ ≤ (Ideal.absNorm q : ℝ) ^ 2 * I₀ := h_prod_le
      _ ≤ C₀ := h_le_C₀
      _ = C₀ * 1 := by ring
      _ ≤ C₀ * (4 + |s.im|) := mul_le_mul_of_nonneg_left h4_ge_one (le_of_lt hC₀_pos)

theorem mitsui_ray_char_heckeL_entire_functional_le_and_exp_bound {K : Type u} [Field K] [NumberField K]
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ_ray : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      x - 1 ∈ q →
      χ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1)
    (hχ_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ I = 0))
    (hχ_nonprin : ∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ ∧ χ I₀ ≠ 1) :
    ∃ (B : ℝ) (χ_dual : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ) (g_χ : ℂ → ℂ),
      0 < B ∧
      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ_dual I‖ ≤ 1) ∧
      Differentiable ℂ g_χ ∧
      (∀ s : ℂ, 1 < s.re →
        g_χ s = LSeries (fun n =>
          ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
            χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s) ∧
      (∀ s : ℂ, s.re = -1 / 2 →
        ‖(((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ (s / 2) *
            (Complex.Gammaℝ s) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
            (Complex.Gammaℂ s) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) * g_χ s‖ ≤
          (Ideal.absNorm q : ℝ) ^ (Module.finrank ℚ K + 1) *
            ‖(((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ ((1 - s) / 2) *
                (Complex.Gammaℝ (1 - s)) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
                (Complex.Gammaℂ (1 - s)) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) *
              LSeries (fun n =>
                ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
                  χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) (1 - s)‖) ∧
      (∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 →
        ‖g_χ s‖ ≤ Real.exp (B * (4 + |s.im|))) :=
by
  obtain ⟨C₀, χ_dual, g_χ, hC₀_pos, hχ_dual_norm, hg_diff, hg_eq, hg_feq_sq, hg_mellin⟩ :=
    mitsui_ray_char_heckeL_completed_entire_and_mellin_bound q hq χ hχ_ray hχ_norm_supp hχ_nonprin
  set r₁ : ℕ := NumberField.InfinitePlace.nrRealPlaces K
  set r₂ : ℕ := NumberField.InfinitePlace.nrComplexPlaces K
  set D : ℝ := |(NumberField.discr K : ℝ)|
  have hD_ge_one : (1 : ℝ) ≤ D := by
    dsimp [D]
    exact_mod_cast Int.one_le_abs (NumberField.discr_ne_zero K)
  have hD_pos : 0 < D := lt_of_lt_of_le zero_lt_one hD_ge_one
  let C₁ : ℝ := C₀ * D ^ (1 / 4 : ℝ)
  have hC₁_pos : 0 < C₁ := by dsimp [C₁]; positivity
  let B₁ : ℝ := 8 * ((r₁ : ℝ) + (r₂ : ℝ))
  have hB₁_nonneg : 0 ≤ B₁ := by dsimp [B₁]; positivity
  have h_high : ∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 → 1 ≤ |s.im| →
      ‖g_χ s‖ ≤ C₁ * (4 + |s.im|) * Real.exp (B₁ * (4 + |s.im|)) := by
    intro s hs1 hs2 hs_im
    set L : ℝ := 4 + |s.im|
    have hD_s_lower : D ^ (-1 / 4 : ℝ) ≤ ‖(D : ℂ) ^ (s / 2)‖ := by
      rw [Complex.norm_cpow_eq_rpow_re_of_pos hD_pos]
      have hs2_re : -1 / 4 ≤ (s / 2).re := by
        rw [Complex.div_ofNat_re]; linarith
      exact Real.rpow_le_rpow_of_exponent_le hD_ge_one hs2_re
    have hγ_lower : Real.exp (-B₁ * L) ≤ ‖(Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂‖ := by
      have h1 := mitsui_archimedean_gamma_exp_lower_bound_on_strip r₁ r₂ s hs1 hs2 hs_im
      dsimp [B₁, L]
      exact h1
    have h_mellin_s := hg_mellin s hs1 hs2 hs_im
    have h_assoc :
        ((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * g_χ s =
          (D : ℂ) ^ (s / 2) * ((Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * g_χ s := by
      ring
    rw [h_assoc, norm_mul, norm_mul] at h_mellin_s
    have h_pref_lower :
        D ^ (-1 / 4 : ℝ) * Real.exp (-B₁ * L) ≤
          ‖(D : ℂ) ^ (s / 2)‖ * ‖(Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂‖ :=
      mul_le_mul hD_s_lower hγ_lower (le_of_lt (Real.exp_pos _)) (norm_nonneg _)
    have h_prod_le :
        (D ^ (-1 / 4 : ℝ) * Real.exp (-B₁ * L)) * ‖g_χ s‖ ≤ C₀ * L :=
      le_trans (mul_le_mul_of_nonneg_right h_pref_lower (norm_nonneg _)) h_mellin_s
    have hD_cancel : D ^ (1 / 4 : ℝ) * D ^ (-1 / 4 : ℝ) = 1 := by
      rw [← Real.rpow_add hD_pos]
      norm_num
    have hexp_cancel : Real.exp (B₁ * L) * Real.exp (-B₁ * L) = 1 := by
      rw [← Real.exp_add]
      simp
    calc ‖g_χ s‖
        = (D ^ (1 / 4 : ℝ) * Real.exp (B₁ * L)) *
            ((D ^ (-1 / 4 : ℝ) * Real.exp (-B₁ * L)) * ‖g_χ s‖) := by
          have h1 : (D ^ (1 / 4 : ℝ) * Real.exp (B₁ * L)) *
              (D ^ (-1 / 4 : ℝ) * Real.exp (-B₁ * L)) =
              (D ^ (1 / 4 : ℝ) * D ^ (-1 / 4 : ℝ)) *
                (Real.exp (B₁ * L) * Real.exp (-B₁ * L)) := by ring
          rw [← mul_assoc, h1, hD_cancel, hexp_cancel, mul_one, one_mul]
      _ ≤ (D ^ (1 / 4 : ℝ) * Real.exp (B₁ * L)) * (C₀ * L) :=
          mul_le_mul_of_nonneg_left h_prod_le (by positivity)
      _ = C₁ * L * Real.exp (B₁ * L) := by dsimp [C₁]; ring
  obtain ⟨B, hB_pos, hg_exp⟩ :=
    mitsui_entire_strip_exp_bound_of_high_im_bound g_χ C₁ B₁ hC₁_pos hB₁_nonneg hg_diff h_high
  refine ⟨B, χ_dual, g_χ, hB_pos, hχ_dual_norm, hg_diff, hg_eq, ?_, hg_exp⟩
  intro s hs
  have hq_norm_ne_zero : Ideal.absNorm q ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hq
  have hNq_ge_one : (1 : ℝ) ≤ (Ideal.absNorm q : ℝ) := by
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr hq_norm_ne_zero
  have h_deg : 2 ≤ Module.finrank ℚ K + 1 := by
    have := Module.finrank_pos (R := ℚ) (M := K)
    omega
  have h_pow_le : (Ideal.absNorm q : ℝ) ^ 2 ≤ (Ideal.absNorm q : ℝ) ^ (Module.finrank ℚ K + 1) :=
    pow_le_pow_right₀ hNq_ge_one h_deg
  exact le_trans (hg_feq_sq s hs) (mul_le_mul_of_nonneg_right h_pow_le (norm_nonneg _))

theorem mitsui_ray_char_heckeL_entire_and_vertical_growth {K : Type u} [Field K] [NumberField K] :
    ∃ A₁ : ℝ, 0 < A₁ ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
        ∀ χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ,
          (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
            x - 1 ∈ q →
            χ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
              mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ = 1) →
          (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
            ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ I‖ = 1) ∧
            (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ I = 0)) →
          (∃ I₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
            (I₀ : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ ∧ χ I₀ ≠ 1) →
          ∃ g_χ : ℂ → ℂ,
            Differentiable ℂ g_χ ∧
            (∀ s : ℂ, 1 < s.re →
              g_χ s = LSeries (fun n =>
                ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
                  χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s) ∧
            (∀ s : ℂ, 1 / 2 ≤ s.re → s.re ≤ 2 →
              ‖g_χ s‖ ≤ A₁ * ((Ideal.absNorm q : ℝ) * (4 + |s.im|)) ^ (Module.finrank ℚ K + 1)) :=
by
  set n : ℕ := Module.finrank ℚ K
  set r₁ : ℕ := NumberField.InfinitePlace.nrRealPlaces K
  set r₂ : ℕ := NumberField.InfinitePlace.nrComplexPlaces K
  have hr_eq : r₁ + 2 * r₂ = n := NumberField.InfinitePlace.card_add_two_mul_card_eq_rank K
  set D : ℝ := |(NumberField.discr K : ℝ)|
  have hD_pos : 0 < D := by
    dsimp [D]
    exact abs_pos.mpr (by exact_mod_cast NumberField.discr_ne_zero K)
  set Z₃₂ : ℝ := ‖NumberField.dedekindZeta K ((3 / 2 : ℝ) : ℂ)‖
  have hZ₃₂_nonneg : 0 ≤ Z₃₂ := norm_nonneg _
  let M_left : ℝ := D / (2 * Real.pi) ^ n * Z₃₂
  let M_right : ℝ := Z₃₂
  let M₀ : ℝ := M_left + M_right + 1
  have hM_left_nonneg : 0 ≤ M_left := by dsimp [M_left]; positivity
  have hM_right_nonneg : 0 ≤ M_right := hZ₃₂_nonneg
  have hM₀_pos : 0 < M₀ := by dsimp [M₀]; positivity
  let A₁ : ℝ := 4 ^ (n + 1) * M₀
  have hA₁_pos : 0 < A₁ := by dsimp [A₁]; positivity
  refine ⟨A₁, hA₁_pos, ?_⟩
  intro q hq χ hχ_ray hχ_norm_supp hχ_nonprin
  have hχ_norm : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ I‖ ≤ 1 := by
    intro I
    by_cases hI : (I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤
    · rw [(hχ_norm_supp I).1 hI]
    · rw [(hχ_norm_supp I).2 hI, norm_zero]
      linarith
  obtain ⟨B, χ_dual, g_χ, hB_pos, hχ_dual_norm, hg_diff, hg_eq, hg_feq_le, hg_exp⟩ :=
    mitsui_ray_char_heckeL_entire_functional_le_and_exp_bound q hq χ hχ_ray hχ_norm_supp hχ_nonprin
  set N_q : ℝ := (Ideal.absNorm q : ℝ)
  have hq_norm_ne_zero : Ideal.absNorm q ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr hq
  have hNq_ge_one : 1 ≤ N_q := by
    dsimp [N_q]
    exact_mod_cast Nat.one_le_iff_ne_zero.mpr hq_norm_ne_zero
  have hNq_pos : 0 < N_q := lt_of_lt_of_le zero_lt_one hNq_ge_one
  have hNq_pow_ge_one : 1 ≤ N_q ^ (n + 1) := one_le_pow₀ hNq_ge_one
  have hNq_pow_pos : 0 < N_q ^ (n + 1) := by positivity
  let M : ℝ := M₀ * N_q ^ (n + 1)
  have hM_pos : 0 < M := by dsimp [M]; positivity
  have hg_left : ∀ s : ℂ, s.re = -1 / 2 → ‖g_χ s‖ ≤ M * (4 + |s.im|) ^ (n + 1) := by
    intro s hs
    obtain ⟨hγ_pos, hγ_eq⟩ := mitsui_archimedean_gamma_norm_eq_on_neg_half_re r₁ r₂ s hs
    rw [hr_eq] at hγ_eq
    have h_feq := hg_feq_le s hs
    set γ_s : ℂ := (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂
    set γ_1s : ℂ := (Complex.Gammaℝ (1 - s)) ^ r₁ * (Complex.Gammaℂ (1 - s)) ^ r₂
    set L_1s : ℂ := LSeries (fun k =>
      ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = k},
        χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) (1 - s)
    have h_lhs_assoc : ((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * g_χ s =
        (D : ℂ) ^ (s / 2) * γ_s * g_χ s := by
      dsimp [γ_s]; ring
    have h_rhs_assoc : ((D : ℂ) ^ ((1 - s) / 2) * (Complex.Gammaℝ (1 - s)) ^ r₁ * (Complex.Gammaℂ (1 - s)) ^ r₂) * L_1s =
        (D : ℂ) ^ ((1 - s) / 2) * γ_1s * L_1s := by
      dsimp [γ_1s]; ring
    change ‖((D : ℂ) ^ (s / 2) * (Complex.Gammaℝ s) ^ r₁ * (Complex.Gammaℂ s) ^ r₂) * g_χ s‖ ≤
      N_q ^ (n + 1) * ‖((D : ℂ) ^ ((1 - s) / 2) * (Complex.Gammaℝ (1 - s)) ^ r₁ * (Complex.Gammaℂ (1 - s)) ^ r₂) * L_1s‖ at h_feq
    rw [h_lhs_assoc, h_rhs_assoc] at h_feq
    simp only [norm_mul] at h_feq
    have hs_div_re : (s / 2).re = -1 / 4 := by
      rw [Complex.div_ofNat_re, hs]
      ring
    have h1s_div_re : ((1 - s) / 2).re = 3 / 4 := by
      rw [Complex.div_ofNat_re, Complex.sub_re, Complex.one_re, hs]
      ring
    have hD_s : ‖(D : ℂ) ^ (s / 2)‖ = D ^ (-1 / 4 : ℝ) := by
      rw [Complex.norm_cpow_eq_rpow_re_of_pos hD_pos, hs_div_re]
    have hD_1s : ‖(D : ℂ) ^ ((1 - s) / 2)‖ = D * D ^ (-1 / 4 : ℝ) := by
      rw [Complex.norm_cpow_eq_rpow_re_of_pos hD_pos, h1s_div_re]
      have h_exp : (3 / 4 : ℝ) = 1 + (-1 / 4 : ℝ) := by ring
      rw [h_exp, Real.rpow_add hD_pos, Real.rpow_one]
    rw [hD_s, hD_1s, hγ_eq] at h_feq
    have hD_rpow_pos : 0 < D ^ (-1 / 4 : ℝ) := Real.rpow_pos_of_pos hD_pos _
    have h_pref_pos : 0 < D ^ (-1 / 4 : ℝ) * ‖γ_s‖ := mul_pos hD_rpow_pos hγ_pos
    have h_g_le : ‖g_χ s‖ ≤ N_q ^ (n + 1) * (D * (‖s‖ / (2 * Real.pi)) ^ n * ‖L_1s‖) := by
      apply le_of_mul_le_mul_left _ h_pref_pos
      calc (D ^ (-1 / 4 : ℝ) * ‖γ_s‖) * ‖g_χ s‖
          ≤ N_q ^ (n + 1) * (D * D ^ (-1 / 4 : ℝ) * ((‖s‖ / (2 * Real.pi)) ^ n * ‖γ_s‖) * ‖L_1s‖) := h_feq
        _ = (D ^ (-1 / 4 : ℝ) * ‖γ_s‖) * (N_q ^ (n + 1) * (D * (‖s‖ / (2 * Real.pi)) ^ n * ‖L_1s‖)) := by ring
    have h1s_re : (3 / 2 : ℝ) ≤ (1 - s).re := by
      rw [Complex.sub_re, Complex.one_re, hs]
      linarith
    have hL_le : ‖L_1s‖ ≤ Z₃₂ :=
      mitsui_ray_char_LSeries_norm_le_dedekindZeta_of_re_ge χ_dual hχ_dual_norm (1 - s) (3 / 2) (by norm_num) h1s_re
    have hs_norm_le : ‖s‖ ≤ 4 + |s.im| := by
      have h1 := Complex.norm_le_abs_re_add_abs_im s
      rw [hs, abs_of_neg (by norm_num)] at h1
      linarith
    have h2pi_pos : 0 < 2 * Real.pi := by positivity
    have h_div_pow_le : (‖s‖ / (2 * Real.pi)) ^ n ≤ (4 + |s.im|) ^ n / (2 * Real.pi) ^ n := by
      rw [← div_pow]
      exact pow_le_pow_left₀ (by positivity)
        (div_le_div_of_nonneg_right hs_norm_le (le_of_lt h2pi_pos)) n
    have h4_ge_one : 1 ≤ 4 + |s.im| := by linarith [abs_nonneg s.im]
    have h_pow_succ_ge : (4 + |s.im|) ^ n ≤ (4 + |s.im|) ^ (n + 1) :=
      pow_le_pow_right₀ h4_ge_one (Nat.le_succ n)
    have h_prod_le : D * (‖s‖ / (2 * Real.pi)) ^ n * ‖L_1s‖ ≤ M_left * (4 + |s.im|) ^ (n + 1) := by
      calc D * (‖s‖ / (2 * Real.pi)) ^ n * ‖L_1s‖
          = D * ((‖s‖ / (2 * Real.pi)) ^ n * ‖L_1s‖) := by ring
        _ ≤ D * (((4 + |s.im|) ^ n / (2 * Real.pi) ^ n) * Z₃₂) := by
            refine mul_le_mul_of_nonneg_left ?_ (le_of_lt hD_pos)
            exact mul_le_mul h_div_pow_le hL_le (norm_nonneg _) (by positivity)
        _ = M_left * (4 + |s.im|) ^ n := by
            dsimp [M_left]
            ring
        _ ≤ M_left * (4 + |s.im|) ^ (n + 1) :=
            mul_le_mul_of_nonneg_left h_pow_succ_ge hM_left_nonneg
    have hM_left_le : M_left ≤ M₀ := by dsimp [M₀]; linarith
    calc ‖g_χ s‖
        ≤ N_q ^ (n + 1) * (D * (‖s‖ / (2 * Real.pi)) ^ n * ‖L_1s‖) := h_g_le
      _ ≤ N_q ^ (n + 1) * (M_left * (4 + |s.im|) ^ (n + 1)) :=
          mul_le_mul_of_nonneg_left h_prod_le (le_of_lt hNq_pow_pos)
      _ ≤ N_q ^ (n + 1) * (M₀ * (4 + |s.im|) ^ (n + 1)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hM_left_le (by positivity)) (le_of_lt hNq_pow_pos)
      _ = M * (4 + |s.im|) ^ (n + 1) := by
          dsimp [M]; ring
  have hg_right : ∀ s : ℂ, s.re = 2 → ‖g_χ s‖ ≤ M * (4 + |s.im|) ^ (n + 1) := by
    intro s hs
    have hs_gt_one : 1 < s.re := by linarith
    rw [hg_eq s hs_gt_one]
    have hs_ge : (3 / 2 : ℝ) ≤ s.re := by linarith
    have hL_le : ‖LSeries (fun k =>
        ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = k},
          χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s‖ ≤ M_right :=
      mitsui_ray_char_LSeries_norm_le_dedekindZeta_of_re_ge χ hχ_norm s (3 / 2) (by norm_num) hs_ge
    have h4_ge_one : 1 ≤ 4 + |s.im| := by linarith [abs_nonneg s.im]
    have h_pow_ge_one : 1 ≤ (4 + |s.im|) ^ (n + 1) := one_le_pow₀ h4_ge_one
    have hM_right_le : M_right ≤ M₀ := by dsimp [M₀]; linarith
    calc ‖LSeries (fun k =>
          ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = k},
            χ ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s‖
        ≤ M_right := hL_le
      _ ≤ M₀ := hM_right_le
      _ = M₀ * 1 * 1 := by ring
      _ ≤ M₀ * N_q ^ (n + 1) * (4 + |s.im|) ^ (n + 1) := by
          refine mul_le_mul ?_ h_pow_ge_one zero_le_one (by positivity)
          exact mul_le_mul_of_nonneg_left hNq_pow_ge_one (le_of_lt hM₀_pos)
      _ = M * (4 + |s.im|) ^ (n + 1) := by
          dsimp [M]
  refine ⟨g_χ, hg_diff, hg_eq, ?_⟩
  intro s hs1 hs2
  have hs_neg_half : -1 / 2 ≤ s.re := by linarith
  have h_pl := mitsui_phragmenLindelof_polynomial_vertical_strip g_χ (n + 1) B M
    hB_pos (le_of_lt hM_pos) hg_diff hg_exp hg_left hg_right s hs_neg_half hs2
  calc ‖g_χ s‖
      ≤ 4 ^ (n + 1) * M * (4 + |s.im|) ^ (n + 1) := h_pl
    _ = A₁ * ((Ideal.absNorm q : ℝ) * (4 + |s.im|)) ^ (n + 1) := by
        dsimp [A₁, M, N_q]
        rw [mul_pow]
        ring

theorem mitsui_ray_char_heckeL_nonreal_zeroFree_of_vertical_growth {K : Type u} [Field K] [NumberField K] (A₁ : ℝ) (hA₁_pos : 0 < A₁) :
    ∃ B₁ : ℝ, 0 < B₁ ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
        ∀ χ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ,
          (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
            x - 1 ∈ q →
