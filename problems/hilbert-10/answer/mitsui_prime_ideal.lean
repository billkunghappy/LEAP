      fun p => ⟨p.1.asIdeal, Nat.le_floor p.2.2⟩
    have hemb_inj : Function.Injective emb_id := by
      intro p₁ p₂ hp
      apply Subtype.ext
      apply IsDedekindDomain.HeightOneSpectrum.ext
      exact congrArg Subtype.val hp
    haveI : Finite D_Y := Finite.of_injective emb_id hemb_inj
    letI : Fintype D_Y := Fintype.ofFinite D_Y
    let F_SQ : S_Q → ℝ := fun z => L z.1.1
    let F_DY : D_Y → ℝ := fun p => Real.log (Ideal.absNorm p.1.asIdeal)
    have hF_eq : ∀ z : S_Q, F_SQ z = F_DY (d_prin z) := by
      intro z
      dsimp [F_SQ, F_DY, L]
      congr 2
      change (Algebra.norm ℤ z.1.1).natAbs =
        Ideal.absNorm (Ideal.span ({z.1.1} : Set (NumberField.RingOfIntegers K)))
      exact (Ideal.absNorm_span_singleton z.1.1).symm
    have h_tsum_sigma :
        (∑' z : S_Q, F_SQ z) =
          ∑ p : D_Y, ∑ w : {z : S_Q // d_prin z = p}, F_SQ w.1 := by
      rw [← Equiv.tsum_eq (Equiv.sigmaFiberEquiv d_prin) F_SQ, tsum_fintype, Fintype.sum_sigma]
      rfl
    have h_inner : ∀ p : D_Y,
        (∑ w : {z : S_Q // d_prin z = p}, F_SQ w.1) =
          (Nat.card (Fiber_Q p.1) : ℝ) * F_DY p := by
      intro p
      have h_const : ∀ w : {z : S_Q // d_prin z = p}, F_SQ w.1 = F_DY p := by
        intro w
        rw [hF_eq w.1, w.2]
      have h_sum_const :
          (∑ w : {z : S_Q // d_prin z = p}, F_SQ w.1) =
            ∑ _w : {z : S_Q // d_prin z = p}, F_DY p :=
        Finset.sum_congr rfl (fun w _ => h_const w)
      rw [h_sum_const, Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
        ← Nat.card_eq_fintype_card, Nat.card_congr (e_fiber p)]
    have h_lhs_eq :
        (∑' p : D_Y, (Nat.card (Fiber_Q p.1) : ℝ) * F_DY p) = ∑' z : S_Q, F_SQ z := by
      rw [h_tsum_sigma, tsum_fintype]
      exact (Finset.sum_congr rfl (fun p _ => h_inner p)).symm
    have h_rhs_eq :
        (∑' z : S_Q, F_SQ z) =
          ∑ x : S_uncond, (if ((Algebra.norm ℤ x.1).natAbs : ℝ) ≤ Y ∧ Q x.1 then L x.1 else 0) := by
      rw [tsum_fintype]
      have hsub : (∑ z : S_Q, F_SQ z) =
          ∑ x ∈ Finset.univ.filter (fun x : S_uncond => ((Algebra.norm ℤ x.1).natAbs : ℝ) ≤ Y ∧ Q x.1),
            L x.1 :=
        (Finset.sum_subtype
          (Finset.univ.filter (fun x : S_uncond => ((Algebra.norm ℤ x.1).natAbs : ℝ) ≤ Y ∧ Q x.1))
          (fun _ => by simp) (fun x : S_uncond => L x.1)).symm
      rw [hsub, Finset.sum_filter]
    exact h_lhs_eq.trans h_rhs_eq
  let D_prin_sec := {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
    p.asIdeal.IsPrincipal ∧
    (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ n}
  have h_lhs1 :
      (∑' p : D_prin_sec,
        (Nat.card {π : NumberField.RingOfIntegers K //
            Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧ P_sec π} : ℝ) *
          Real.log (Ideal.absNorm p.1.asIdeal))
      = ∑ x : S_uncond, (if P_sec x.1 then (1 : ℝ) else 0) * L x.1 := by
    have h_sub_sec : ∀ π : NumberField.RingOfIntegers K,
        Prime π → ((Algebra.norm ℤ π).natAbs : ℝ) ≤ X ^ n → P_sec π →
        ∀ w : NumberField.InfinitePlace K, w (π : K) < X' := by
      intro π _ _ hsec w
      exact lt_trans (lt_of_le_of_lt (hsec.1 w).2 hsec.2) hX_lt_X'
    rw [h_prin_sum_eq (X ^ n) P_sec h_sub_sec]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    by_cases hsec : P_sec x.1
    · have hnorm : ((Algebra.norm ℤ x.1).natAbs : ℝ) ≤ X ^ n :=
        h_sec_norm_le x.1 hsec.1 hsec.2
      rw [if_pos ⟨hnorm, hsec⟩, if_pos hsec, one_mul]
    · have hnot : ¬ (((Algebra.norm ℤ x.1).natAbs : ℝ) ≤ X ^ n ∧ P_sec x.1) :=
        fun h => hsec h.2
      rw [if_neg hnot, if_neg hsec, zero_mul]
  let D_prin_cell (k : NumberField.InfinitePlace K → Fin m) :=
    {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
      p.asIdeal.IsPrincipal ∧
      (Ideal.absNorm p.asIdeal : ℝ) ≤ Y_max k}
  have h_lhs_cell : ∀ k : NumberField.InfinitePlace K → Fin m,
      (∑' p : D_prin_cell k,
        (Nat.card {π : NumberField.RingOfIntegers K //
            Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧ P_dir k π} : ℝ) *
          Real.log (Ideal.absNorm p.1.asIdeal))
      = ∑ x : S_uncond, (if P_cell k x.1 then L x.1 else 0) := by
    intro k
    have h_sub_cell : ∀ π : NumberField.RingOfIntegers K,
        Prime π → ((Algebra.norm ℤ π).natAbs : ℝ) ≤ Y_max k → P_dir k π →
        ∀ w : NumberField.InfinitePlace K, w (π : K) < X' := by
      intro π h_prime hnorm hdir w
      have hsub := h_cell_sub k π h_prime ⟨hnorm, hdir⟩
      exact lt_of_le_of_lt (hsub.1 w) hsub.2
    rw [h_prin_sum_eq (Y_max k) (P_dir k) h_sub_cell]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    by_cases hk : P_cell k x.1
    · rw [if_pos hk, if_pos hk]
    · rw [if_neg hk, if_neg hk]
  have h_lhs2 :
      (∑' k : NumberField.InfinitePlace K → Fin m,
        ∑' p : D_prin_cell k,
          (Nat.card {π : NumberField.RingOfIntegers K //
              Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧ P_dir k π} : ℝ) *
            Real.log (Ideal.absNorm p.1.asIdeal))
      = ∑ x : S_uncond, ((M x.1).card : ℝ) * L x.1 := by
    rw [tsum_fintype]
    simp_rw [h_lhs_cell]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
  let c : NumberField.RingOfIntegers K → ℝ :=
    fun π => ((M π).card : ℝ) - (if P_sec π then 1 else 0)
  have hc_nonneg : ∀ π : NumberField.RingOfIntegers K, Prime π → 0 ≤ c π := by
    intro π h_prime
    dsimp [c]
    split_ifs with hsec
    · rw [h_sec_card_eq_one π h_prime hsec]
      norm_num
    · rw [sub_zero]
      positivity
  have h_lhs_diff :
      (∑' p : D_prin_sec,
        (Nat.card {π : NumberField.RingOfIntegers K //
            Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧ P_sec π} : ℝ) *
          Real.log (Ideal.absNorm p.1.asIdeal)) -
      (∑' k : NumberField.InfinitePlace K → Fin m,
        ∑' p : D_prin_cell k,
          (Nat.card {π : NumberField.RingOfIntegers K //
              Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧ P_dir k π} : ℝ) *
            Real.log (Ideal.absNorm p.1.asIdeal))
      = - ∑ x : S_uncond, c x.1 * L x.1 := by
    rw [h_lhs1, h_lhs2, ← Finset.sum_sub_distrib, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    dsimp [c]
    split_ifs <;> ring
  have h_lhs_le :
      |(∑' p : D_prin_sec,
        (Nat.card {π : NumberField.RingOfIntegers K //
            Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧ P_sec π} : ℝ) *
          Real.log (Ideal.absNorm p.1.asIdeal)) -
      (∑' k : NumberField.InfinitePlace K → Fin m,
        ∑' p : D_prin_cell k,
          (Nat.card {π : NumberField.RingOfIntegers K //
              Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧ P_dir k π} : ℝ) *
            Real.log (Ideal.absNorm p.1.asIdeal))|
      ≤ ∑ y : S_uncond, c y.1 * L y.1 := by
    rw [h_lhs_diff, abs_neg, abs_of_nonneg]
    exact Finset.sum_nonneg (fun y _ => mul_nonneg (hc_nonneg y.1 y.2.1) (hL_nonneg y.1))
  let P_X : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ w : NumberField.InfinitePlace K, w (π : K) < X
  let P_ge : NumberField.RingOfIntegers K → Prop :=
    fun π => ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K)
  have hc_le : ∀ y : S_uncond,
      c y.1 * L y.1 ≤
        (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0) +
        (if ¬ P_X y.1 then L y.1 else 0) := by
    intro y
    have h_ind_le : c y.1 ≤
        (if P_X y.1 ∧ ¬ P_ge y.1 then (1 : ℝ) else 0) +
        (if ¬ P_X y.1 then (1 : ℝ) else 0) := by
      dsimp [c]
      by_cases hsec : P_sec y.1
      · rw [if_pos hsec, h_sec_card_eq_one y.1 y.2.1 hsec]
        split_ifs <;> norm_num
      · rw [if_neg hsec, sub_zero]
        have h_card_le : ((M y.1).card : ℝ) ≤ 1 := by exact_mod_cast hM_le_one y.1
        by_cases hX_mem : P_X y.1
        · by_cases hge : P_ge y.1
          · by_cases hM_zero : (M y.1).card = 0
            · rw [hM_zero]
              split_ifs <;> norm_num
            · obtain ⟨k, hk⟩ := Finset.card_pos.mp (Nat.pos_of_ne_zero hM_zero)
              rw [Finset.mem_filter] at hk
              have h_max := (h_cell_sub k y.1 y.2.1 hk.2).1
              exfalso
              exact hsec ⟨fun w => ⟨hge w, h_max w⟩, hX_mem w₀⟩
          · simp [hX_mem, hge, h_card_le]
        · simp [hX_mem, h_card_le]
    have h_mul := mul_le_mul_of_nonneg_right h_ind_le (hL_nonneg y.1)
    calc c y.1 * L y.1
      _ ≤ ((if P_X y.1 ∧ ¬ P_ge y.1 then (1 : ℝ) else 0) +
           (if ¬ P_X y.1 then (1 : ℝ) else 0)) * L y.1 := h_mul
      _ = (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0) +
          (if ¬ P_X y.1 then L y.1 else 0) := by
        split_ifs <;> ring
  have h_sum_c_le :
      ∑ y : S_uncond, c y.1 * L y.1 ≤
        (∑ y : S_uncond, (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0)) +
        (∑ y : S_uncond, (if ¬ P_X y.1 then L y.1 else 0)) := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_le_sum (fun y _ => hc_le y)
  let S_X_uncond := {π : NumberField.RingOfIntegers K //
    Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X}
  let e_X_uncond : S_X_uncond ≃ {y : S_uncond // P_X y.1} :=
    { toFun := fun π => ⟨⟨π.1, π.2.1, fun w => lt_trans (π.2.2 w) hX_lt_X'⟩, π.2.2⟩
      invFun := fun y => ⟨y.1.1, y.1.2.1, y.2⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_rhs_X :
      (∑' π : S_X_uncond, L π.1) =
        ∑ y : S_uncond, (if P_X y.1 then L y.1 else 0) := by
    change (∑' π : S_X_uncond, L (e_X_uncond π).1.1) = _
    rw [Equiv.tsum_eq e_X_uncond (fun z : {y : S_uncond // P_X y.1} => L z.1.1), tsum_fintype]
    have hsub : (∑ z : {y : S_uncond // P_X y.1}, L z.1.1) =
        ∑ y ∈ Finset.univ.filter (fun y : S_uncond => P_X y.1), L y.1 :=
      (Finset.sum_subtype (Finset.univ.filter (fun y : S_uncond => P_X y.1))
        (fun _ => by simp) (fun y : S_uncond => L y.1)).symm
    rw [hsub, Finset.sum_filter]
  let S_Xge_uncond := {π : NumberField.RingOfIntegers K //
    Prime π ∧ ∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K) ∧ w (π : K) < X}
  let e_Xge_uncond : S_Xge_uncond ≃ {y : S_uncond // P_X y.1 ∧ P_ge y.1} :=
    { toFun := fun π =>
        ⟨⟨π.1, π.2.1, fun w => lt_trans (π.2.2 w).2 hX_lt_X'⟩,
         ⟨fun w => (π.2.2 w).2, fun w => (π.2.2 w).1⟩⟩
      invFun := fun y => ⟨y.1.1, y.1.2.1, fun w => ⟨y.2.2 w, y.2.1 w⟩⟩
      left_inv := fun π => by ext; rfl
      right_inv := fun y => by ext; rfl }
  have h_rhs_Xge :
      (∑' π : S_Xge_uncond, L π.1) =
        ∑ y : S_uncond, (if P_X y.1 ∧ P_ge y.1 then L y.1 else 0) := by
    change (∑' π : S_Xge_uncond, L (e_Xge_uncond π).1.1) = _
    rw [Equiv.tsum_eq e_Xge_uncond (fun z : {y : S_uncond // P_X y.1 ∧ P_ge y.1} => L z.1.1),
      tsum_fintype]
    have hsub : (∑ z : {y : S_uncond // P_X y.1 ∧ P_ge y.1}, L z.1.1) =
        ∑ y ∈ Finset.univ.filter (fun y : S_uncond => P_X y.1 ∧ P_ge y.1), L y.1 :=
      (Finset.sum_subtype (Finset.univ.filter (fun y : S_uncond => P_X y.1 ∧ P_ge y.1))
        (fun _ => by simp) (fun y : S_uncond => L y.1)).symm
    rw [hsub, Finset.sum_filter]
  have h_rhs_X' : (∑' y : S_uncond, L y.1) = ∑ y : S_uncond, L y.1 :=
    tsum_fintype (fun y : S_uncond => L y.1)
  have h_rhs1_eq :
      |(∑' π : S_X_uncond, L π.1) - (∑' π : S_Xge_uncond, L π.1)| =
        ∑ y : S_uncond, (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0) := by
    have h_diff :
        (∑' π : S_X_uncond, L π.1) - (∑' π : S_Xge_uncond, L π.1) =
          ∑ y : S_uncond, (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0) := by
      rw [h_rhs_X, h_rhs_Xge, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun y _ => ?_)
      by_cases h1 : P_X y.1 <;> by_cases h2 : P_ge y.1 <;> simp [h1, h2]
    have h_nonneg :
        0 ≤ ∑ y : S_uncond, (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0) :=
      Finset.sum_nonneg (fun y _ => by split_ifs; exact hL_nonneg y.1; exact le_rfl)
    rw [h_diff, abs_of_nonneg h_nonneg]
  have h_rhs2_eq :
      |(∑' y : S_uncond, L y.1) - (∑' π : S_X_uncond, L π.1)| =
        ∑ y : S_uncond, (if ¬ P_X y.1 then L y.1 else 0) := by
    have h_diff :
        (∑' y : S_uncond, L y.1) - (∑' π : S_X_uncond, L π.1) =
          ∑ y : S_uncond, (if ¬ P_X y.1 then L y.1 else 0) := by
      rw [h_rhs_X', h_rhs_X, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun y _ => ?_)
      by_cases h1 : P_X y.1 <;> simp [h1]
    have h_nonneg :
        0 ≤ ∑ y : S_uncond, (if ¬ P_X y.1 then L y.1 else 0) :=
      Finset.sum_nonneg (fun y _ => by by_cases h1 : P_X y.1 <;> simp [h1, hL_nonneg y.1])
    rw [h_diff, abs_of_nonneg h_nonneg]
  change |(∑' p : D_prin_sec,
        (Nat.card {π : NumberField.RingOfIntegers K //
            Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧ P_sec π} : ℝ) *
          Real.log (Ideal.absNorm p.1.asIdeal)) -
      (∑' k : NumberField.InfinitePlace K → Fin m,
        ∑' p : D_prin_cell k,
          (Nat.card {π : NumberField.RingOfIntegers K //
              Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧ P_dir k π} : ℝ) *
            Real.log (Ideal.absNorm p.1.asIdeal))|
    ≤ |(∑' π : S_X_uncond, L π.1) - (∑' π : S_Xge_uncond, L π.1)| +
      |(∑' y : S_uncond, L y.1) - (∑' π : S_X_uncond, L π.1)|
  rw [h_rhs1_eq, h_rhs2_eq]
  exact le_trans h_lhs_le h_sum_c_le

theorem mitsui_principalPrimeIdeals_decoupled_log_cell_sub_primePower_le {K : Type u} [Field K] [NumberField K]
    (X : ℝ)
    (m : ℕ)
    (w₀ : NumberField.InfinitePlace K)
    (k : NumberField.InfinitePlace K → Fin m)
    (Y : ℝ) (hY : Y ≤ X ^ (Module.finrank ℚ K))
    (B : ℝ) (hB₀ : 0 ≤ B)
    (hB : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (ν : ℕ),
      2 ≤ ν →
      (Nat.card {x : NumberField.RingOfIntegers K //
          Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = p.asIdeal ^ ν ∧
          ∀ w : NumberField.InfinitePlace K,
            Real.log (w (x : K) / w₀ (x : K)) ∈
              Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℝ) ≤ B) :
    |(∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
          p.asIdeal.IsPrincipal ∧
          (Ideal.absNorm p.asIdeal : ℝ) ≤ Y},
        (Nat.card {π : NumberField.RingOfIntegers K //
            Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧
            ∀ w : NumberField.InfinitePlace K,
              Real.log (w (π : K) / w₀ (π : K)) ∈
                Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                  (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℝ) *
          Real.log (Ideal.absNorm (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)).asIdeal))
      - (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            1 ≤ pm.2 ∧
            (pm.1.asIdeal ^ pm.2).IsPrincipal ∧
            (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y},
          (Nat.card {x : NumberField.RingOfIntegers K //
              Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = pm.1.1.asIdeal ^ pm.1.2 ∧
              ∀ w : NumberField.InfinitePlace K,
                Real.log (w (x : K) / w₀ (x : K)) ∈
                  Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                    (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℝ) *
            Real.log (Ideal.absNorm pm.1.1.asIdeal))|
      ≤ B * ∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ X ^ (Module.finrank ℚ K)},
          Real.log (Ideal.absNorm pm.1.1.asIdeal) :=
by
  classical
  set Z₀ : ℝ := X ^ (Module.finrank ℚ K)
  have h_norm_ge_two : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p.asIdeal := by
    intro p
    have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    omega
  have h_pm_bounds : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (ν : ℕ),
      1 ≤ ν → (Ideal.absNorm p.asIdeal : ℝ) ^ ν ≤ Z₀ →
      Ideal.absNorm p.asIdeal ≤ ⌊Z₀⌋₊ ∧ ν ≤ ⌊Z₀⌋₊ := by
    intro p ν hν h_pow
    have hk2 : 2 ≤ Ideal.absNorm p.asIdeal := h_norm_ge_two p
    have h_pow_nat : ((Ideal.absNorm p.asIdeal ^ ν : ℕ) : ℝ) ≤ Z₀ := by exact_mod_cast h_pow
    have h_km_le : Ideal.absNorm p.asIdeal ^ ν ≤ ⌊Z₀⌋₊ := Nat.le_floor h_pow_nat
    have hν_ne : ν ≠ 0 := by omega
    have hk_le_km : Ideal.absNorm p.asIdeal ≤ Ideal.absNorm p.asIdeal ^ ν :=
      Nat.le_self_pow hν_ne (Ideal.absNorm p.asIdeal)
    have hν_le_2ν : ν ≤ 2 ^ ν := (Nat.lt_pow_self (by decide : 1 < 2)).le
