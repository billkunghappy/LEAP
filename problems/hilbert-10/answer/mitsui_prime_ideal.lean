    have h_diff :
        (∑' π : S_X_uncond, L π.1) - (∑' π : S_Xge_uncond, L π.1) =
          ∑ y : S_uncond, (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0) := by
      rw [h_rhs_X, h_rhs_Xge, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun y _ => ?_)
      by_cases h1 : P_X y.1 <;> by_cases h2 : P_ge y.1 <;> simp [h1, h2]
    have h_nonneg :
        0 ≤ ∑ y : S_uncond, (if P_X y.1 ∧ ¬ P_ge y.1 then L y.1 else 0) :=
      Finset.sum_nonneg (fun y _ => by split_ifs; exact hL_nonneg y.1; exact le_rfl)
    rw [h_diff, abs_of_nonneg h_nonneg]
  have h_rhs2_eq :
      |(∑' y : S_uncond, L y.1) - (∑' π : S_X_uncond, L π.1)| =
        ∑ y : S_uncond, (if ¬ P_X y.1 then L y.1 else 0) := by
    have h_diff :
        (∑' y : S_uncond, L y.1) - (∑' π : S_X_uncond, L π.1) =
          ∑ y : S_uncond, (if ¬ P_X y.1 then L y.1 else 0) := by
      rw [h_rhs_X', h_rhs_X, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun y _ => ?_)
      by_cases h1 : P_X y.1 <;> simp [h1]
    have h_nonneg :
        0 ≤ ∑ y : S_uncond, (if ¬ P_X y.1 then L y.1 else 0) :=
      Finset.sum_nonneg (fun y _ => by by_cases h1 : P_X y.1 <;> simp [h1, hL_nonneg y.1])
    rw [h_diff, abs_of_nonneg h_nonneg]
  change ‖(∑' p : D_prin_sec,
        (Nat.card {π : NumberField.RingOfIntegers K //
            Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧ P_sec π} : ℂ) *
          (ψ (Additive.ofMul p.2.choose_spec.2.unit) *
            (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ))) -
      (∑' k : NumberField.InfinitePlace K → Fin m,
        ∑' p : D_prin_cell k,
          (Nat.card {π : NumberField.RingOfIntegers K //
              Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧ P_dir k π} : ℂ) *
            (ψ (Additive.ofMul p.2.choose_spec.2.unit) *
              (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)))‖
    ≤ |(∑' π : S_X_uncond, L π.1) - (∑' π : S_Xge_uncond, L π.1)| +
      |(∑' y : S_uncond, L y.1) - (∑' π : S_X_uncond, L π.1)|
  rw [h_rhs1_eq, h_rhs2_eq]
  exact le_trans h_lhs_le h_sum_c_le

theorem mitsui_prime_box_shell_diff_bound {K : Type u} [Field K] [NumberField K] :
    ∃ c_shell : ℝ, 0 < c_shell ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m → Real.log X ≤ (m : ℝ) →
          |(∑' π : {π : NumberField.RingOfIntegers K //
                Prime π ∧
                ∀ w : NumberField.InfinitePlace K,
                  w (π : K) < X * Real.exp (Real.log X / (m : ℝ))},
              Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
            - (∑' π : {π : NumberField.RingOfIntegers K //
                  Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
                Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))|
            ≤ c_shell * X ^ (Module.finrank ℚ K) * ((Real.log X + 1) ^ 2 / (m : ℝ)) +
              c_shell * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_shell) :=
by
  classical
  letI : VAdd (NumberField.mixedEmbedding.integerLattice K)
    (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.vaddSet
  letI : VAdd (NumberField.mixedEmbedding.mixedSpace K)
    (Set (NumberField.mixedEmbedding.mixedSpace K)) := Set.vaddSet
  let F : Set (NumberField.mixedEmbedding.mixedSpace K) :=
    ZSpan.fundamentalDomain (NumberField.mixedEmbedding.latticeBasis K)
  have hF_bdd : Bornology.IsBounded F :=
    ZSpan.fundamentalDomain_isBounded (NumberField.mixedEmbedding.latticeBasis K)
  obtain ⟨D, hD_gt1, hF_ball⟩ := hF_bdd.subset_ball_lt 1 0
  have hD_ge1 : 1 ≤ D := le_of_lt hD_gt1
  have hD_pos : 0 < D := lt_of_lt_of_le zero_lt_one hD_ge1
  have hF_norm : ∀ z ∈ F, ∀ w : NumberField.InfinitePlace K,
      NumberField.mixedEmbedding.normAtPlace w z < D := by
    intro z hz w
    have hz_norm : ‖z‖ < D := by
      have h1 := hF_ball hz
      rwa [Metric.mem_ball, dist_zero_right] at h1
    rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
    · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw z]
      have h1 : ‖z.1 ⟨w, hw⟩‖ ≤ ‖z.1‖ := norm_le_pi_norm z.1 ⟨w, hw⟩
      have h2 : ‖z.1‖ ≤ ‖z‖ := by
        rw [Prod.norm_def]
        exact le_max_left _ _
      exact lt_of_le_of_lt (le_trans h1 h2) hz_norm
    · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hw z]
      have h1 : ‖z.2 ⟨w, hw⟩‖ ≤ ‖z.2‖ := norm_le_pi_norm z.2 ⟨w, hw⟩
      have h2 : ‖z.2‖ ≤ ‖z‖ := by
        rw [Prod.norm_def]
        exact le_max_right _ _
      exact lt_of_le_of_lt (le_trans h1 h2) hz_norm
  clear hF_bdd hF_ball
  have hF_fund : MeasureTheory.IsAddFundamentalDomain
      (NumberField.mixedEmbedding.integerLattice K) F MeasureTheory.volume :=
    NumberField.mixedEmbedding.fundamentalDomain_integerLattice K
  have hF_meas : MeasurableSet F :=
    ZSpan.fundamentalDomain_measurableSet (NumberField.mixedEmbedding.latticeBasis K)
  have hF_ne_top : MeasureTheory.volume F ≠ ⊤ := by
    dsimp [F]
    rw [NumberField.mixedEmbedding.volume_fundamentalDomain_latticeBasis K]
    exact ENNReal.mul_ne_top (ENNReal.pow_ne_top (ENNReal.inv_ne_top.mpr (by norm_num))) ENNReal.coe_ne_top
  let V_K : ℝ := (MeasureTheory.volume F).toReal
  have hVK_pos : 0 < V_K := by
    dsimp [V_K, F]
    rw [NumberField.mixedEmbedding.volume_fundamentalDomain_latticeBasis K]
    rw [ENNReal.toReal_mul, ENNReal.toReal_pow, ENNReal.coe_toReal]
    have hdiscr : NumberField.discr K ≠ 0 := NumberField.discr_ne_zero K
    have hsqrt_pos : (0 : NNReal) < NNReal.sqrt ‖NumberField.discr K‖₊ :=
      NNReal.sqrt_pos.mpr (nnnorm_pos.mpr hdiscr)
    have hsqrt_rpos : (0 : ℝ) < (NNReal.sqrt ‖NumberField.discr K‖₊ : ℝ) :=
      NNReal.coe_pos.mpr hsqrt_pos
    have h2 : (0 : ℝ) < ENNReal.toReal 2⁻¹ := by norm_num
    positivity
  let F_K : ℝ := (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
  have hFK_pos : 0 < F_K := by
    change (0 : ℝ) < (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
    have h1 := NumberField.mixedEmbedding.one_le_convexBodyLTFactor K
    exact_mod_cast lt_of_lt_of_le zero_lt_one h1
  let n : ℕ := Module.finrank ℚ K
  have hn_pos : 1 ≤ n := Module.finrank_pos
  let B₀ : ℝ := Real.exp 1 + D
  have hB₀_ge1 : 1 ≤ B₀ := by
    dsimp [B₀]
    have : 0 < Real.exp 1 := Real.exp_pos 1
    linarith only [this, hD_ge1]
  have hB₀_pos : 0 < B₀ := lt_of_lt_of_le zero_lt_one hB₀_ge1
  let C_slab : ℝ := 4 * F_K * B₀ ^ (n + 2) / V_K
  have hC_slab_pos : 0 < C_slab := by dsimp [C_slab]; positivity
  let C₀ : ℝ := max 1 ((Fintype.card (NumberField.InfinitePlace K) : ℝ) * C_slab)
  have hC₀_pos : 0 < C₀ := lt_of_lt_of_le zero_lt_one (le_max_left _ _)
  let c_shell : ℝ := max 1 (5 * Real.exp 1 * C₀ * (n : ℝ))
  have hc_shell_ge1 : 1 ≤ c_shell := le_max_left _ _
  have hc_shell_pos : 0 < c_shell := lt_of_lt_of_le zero_lt_one hc_shell_ge1
  have hc_shell_ge5 : 5 * Real.exp 1 * C₀ * (n : ℝ) ≤ c_shell := le_max_right _ _
  have hc_shell_ge_C0 : C₀ * (n : ℝ) ≤ c_shell := by
    have he_ge1 : 1 ≤ Real.exp 1 := Real.one_le_exp zero_le_one
    have h5e : (1 : ℝ) ≤ 5 * Real.exp 1 := by linarith only [he_ge1]
    have hC0n_nonneg : 0 ≤ C₀ * (n : ℝ) := mul_nonneg (le_of_lt hC₀_pos) (Nat.cast_nonneg n)
    have h1 : 1 * (C₀ * (n : ℝ)) ≤ (5 * Real.exp 1) * (C₀ * (n : ℝ)) :=
      mul_le_mul_of_nonneg_right h5e hC0n_nonneg
    rw [one_mul] at h1
    have h2 : (5 * Real.exp 1) * (C₀ * (n : ℝ)) = 5 * Real.exp 1 * C₀ * (n : ℝ) := by ring
    rw [h2] at h1
    exact le_trans h1 hc_shell_ge5
  refine ⟨c_shell, hc_shell_pos, ?_⟩
  intro X hX m hm hLm
  have hX_pos : 0 < X := lt_trans zero_lt_one hX
  let L : ℝ := Real.log X
  have hL_pos : 0 < L := Real.log_pos hX
  have hL_nonneg : 0 ≤ L := le_of_lt hL_pos
  have hm_rpos : (0 : ℝ) < (m : ℝ) := by
    exact_mod_cast (lt_of_lt_of_le zero_lt_one hm)
  let δ : ℝ := L / (m : ℝ)
  have hδ_pos : 0 < δ := div_pos hL_pos hm_rpos
  have hδ_nonneg : 0 ≤ δ := le_of_lt hδ_pos
  have hδ_le_one : δ ≤ 1 := div_le_one_of_le₀ hLm (le_of_lt hm_rpos)
  let X' : ℝ := X * Real.exp δ
  have hexp_gt_one : 1 < Real.exp δ := Real.one_lt_exp_iff.mpr hδ_pos
  have hX_lt_Xp : X < X' := lt_mul_of_one_lt_right hX_pos hexp_gt_one
  have hXp_gt_one : 1 < X' := lt_trans hX hX_lt_Xp
  have hXp_pos : 0 < X' := lt_trans zero_lt_one hXp_gt_one
  let B_Xp : Set (NumberField.RingOfIntegers K) :=
    {x | ∀ w : NumberField.InfinitePlace K, w (x : K) < X'}
  have hBXp_fin : B_Xp.Finite := by
    have hBK_fin : {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X'}.Finite :=
      NumberField.Embeddings.finite_of_norm_le K ℂ X'
    have hsub : B_Xp ⊆ (Subtype.val : NumberField.RingOfIntegers K → K) ⁻¹'
        {y : K | IsIntegral ℤ y ∧ ∀ φ : K →+* ℂ, ‖φ y‖ ≤ X'} := by
      intro x hx
      refine ⟨NumberField.RingOfIntegers.isIntegral_coe x, fun φ => ?_⟩
      have hφ : (NumberField.InfinitePlace.mk φ) (x : K) = ‖φ (x : K)‖ :=
        NumberField.InfinitePlace.apply φ (x : K)
      have hxφ : (NumberField.InfinitePlace.mk φ) (x : K) < X' := hx (NumberField.InfinitePlace.mk φ)
      change ‖φ (x : K)‖ ≤ X'
      linarith only [hφ, hxφ]
    exact (hBK_fin.preimage Subtype.val_injective.injOn).subset hsub
  let S : NumberField.InfinitePlace K → Set (NumberField.RingOfIntegers K) :=
    fun w₀ => {x | X ≤ w₀ (x : K) ∧ ∀ w : NumberField.InfinitePlace K, w (x : K) < X'}
  have hS_fin : ∀ w₀, (S w₀).Finite := fun w₀ => hBXp_fin.subset (fun _ hx => hx.2)
  
  have h_s1_bound :
      |(∑' π : {π : NumberField.RingOfIntegers K //
            Prime π ∧
            ∀ w : NumberField.InfinitePlace K,
              w (π : K) < X * Real.exp (Real.log X / (m : ℝ))},
          Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))
        - (∑' π : {π : NumberField.RingOfIntegers K //
              Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
            Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ))| ≤
      (∑ w₀ : NumberField.InfinitePlace K, ((hS_fin w₀).toFinset.card : ℝ)) *
        ((n : ℝ) * (L + 1)) := by
    let Q' : Set (NumberField.RingOfIntegers K) :=
      {π | Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X'}
    let Q : Set (NumberField.RingOfIntegers K) :=
      {π | Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X}
    let R : Set (NumberField.RingOfIntegers K) :=
      {π | Prime π ∧ (∀ w : NumberField.InfinitePlace K, w (π : K) < X') ∧
        ¬ (∀ w : NumberField.InfinitePlace K, w (π : K) < X)}
    have hQp_fin : Q'.Finite := hBXp_fin.subset (fun _ hx => hx.2)
    have hQ_fin : Q.Finite := hBXp_fin.subset (fun _ hx w => lt_trans (hx.2 w) hX_lt_Xp)
    have hR_fin : R.Finite := hBXp_fin.subset (fun _ hx => hx.2.1)
    letI : Fintype Q' := hQp_fin.fintype
    letI : Fintype Q := hQ_fin.fintype
    let g : NumberField.RingOfIntegers K → ℝ :=
      fun x => Real.log ((Algebra.norm ℤ x).natAbs : ℝ)
    have hsumQp : (∑' π : Q', g π) = ∑ π ∈ hQp_fin.toFinset, g π := by
      rw [tsum_fintype]
      exact (Finset.sum_subtype hQp_fin.toFinset (fun _ => hQp_fin.mem_toFinset) g).symm
    have hsumQ : (∑' π : Q, g π) = ∑ π ∈ hQ_fin.toFinset, g π := by
      rw [tsum_fintype]
      exact (Finset.sum_subtype hQ_fin.toFinset (fun _ => hQ_fin.mem_toFinset) g).symm
    change |(∑' π : Q', g π) - (∑' π : Q, g π)| ≤
      (∑ w₀ : NumberField.InfinitePlace K, ((hS_fin w₀).toFinset.card : ℝ)) *
        ((n : ℝ) * (L + 1))
    rw [hsumQp, hsumQ]
    have hQ_sub_Qp : hQ_fin.toFinset ⊆ hQp_fin.toFinset := by
      intro x hx
      rw [Set.Finite.mem_toFinset] at hx ⊢
      exact ⟨hx.1, fun w => lt_trans (hx.2 w) hX_lt_Xp⟩
    have hQp_sdiff_Q : hQp_fin.toFinset \ hQ_fin.toFinset = hR_fin.toFinset := by
      ext x
      simp only [Finset.mem_sdiff, Set.Finite.mem_toFinset, Q', Q, R, Set.mem_setOf_eq]
      tauto
    have h_sdiff := Finset.sum_sdiff hQ_sub_Qp (f := g)
    rw [hQp_sdiff_Q] at h_sdiff
    have h_diff : (∑ π ∈ hQp_fin.toFinset, g π) - (∑ π ∈ hQ_fin.toFinset, g π) =
        ∑ π ∈ hR_fin.toFinset, g π := by linarith only [h_sdiff]
    rw [h_diff]
    have hg_nonneg : ∀ π ∈ hR_fin.toFinset, 0 ≤ g π := by
      intro π _
      exact Real.log_natCast_nonneg _
    have hlog_Xp_le : Real.log X' ≤ L + 1 := by
      have hlog_Xp : Real.log X' = L + δ := by
        dsimp [X', L]
        rw [Real.log_mul (ne_of_gt hX_pos) (ne_of_gt (Real.exp_pos δ)), Real.log_exp]
      linarith only [hlog_Xp, hδ_le_one]
    have hg_le : ∀ π ∈ hR_fin.toFinset, g π ≤ (n : ℝ) * (L + 1) := by
      intro π hπ
      rw [Set.Finite.mem_toFinset] at hπ
      have hπ_ne : π ≠ 0 := hπ.1.ne_zero
      have hnorm_ne : Algebra.norm ℤ π ≠ 0 := Algebra.norm_ne_zero_iff.mpr hπ_ne
      have hnat_pos : (0 : ℝ) < (Algebra.norm ℤ π).natAbs := by
        exact_mod_cast Int.natAbs_pos.mpr hnorm_ne
      have hprod_eq : (∏ w : NumberField.InfinitePlace K, w (π : K) ^ w.mult) =
          ((Algebra.norm ℤ π).natAbs : ℝ) := by
        rw [NumberField.InfinitePlace.prod_eq_abs_norm (π : K), ← Algebra.coe_norm_int π]
        rw [Nat.cast_natAbs]
        norm_cast
      have hprod_le : ((Algebra.norm ℤ π).natAbs : ℝ) ≤ X' ^ n := by
        rw [← hprod_eq]
        have h1 : (∏ w : NumberField.InfinitePlace K, w (π : K) ^ w.mult) ≤
            ∏ w : NumberField.InfinitePlace K, X' ^ w.mult := by
          apply Finset.prod_le_prod
          · intro w _
            positivity
          · intro w _
            exact pow_le_pow_left₀ (by positivity) (le_of_lt (hπ.2.1 w)) w.mult
        rwa [Finset.prod_pow_eq_pow_sum, NumberField.InfinitePlace.sum_mult_eq] at h1
      have hlog_le1 : g π ≤ Real.log (X' ^ n) := Real.log_le_log hnat_pos hprod_le
      rw [Real.log_pow] at hlog_le1
      exact le_trans hlog_le1 (mul_le_mul_of_nonneg_left hlog_Xp_le (Nat.cast_nonneg n))
    rw [abs_of_nonneg (Finset.sum_nonneg hg_nonneg)]
    have hR_cover : hR_fin.toFinset ⊆ Finset.univ.biUnion (fun w₀ => (hS_fin w₀).toFinset) := by
      intro π hπ
      rw [Set.Finite.mem_toFinset] at hπ
      rw [Finset.mem_biUnion]
      have hex : ∃ w₀ : NumberField.InfinitePlace K, X ≤ w₀ (π : K) := by
        by_contra h_all
        push_neg at h_all
        exact hπ.2.2 h_all
      obtain ⟨w₀, hw₀⟩ := hex
      refine ⟨w₀, Finset.mem_univ w₀, ?_⟩
      rw [Set.Finite.mem_toFinset]
      exact ⟨hw₀, hπ.2.1⟩
    have hcard_R_le_sum : (hR_fin.toFinset.card : ℝ) ≤
        ∑ w₀ : NumberField.InfinitePlace K, ((hS_fin w₀).toFinset.card : ℝ) := by
      have h1 : hR_fin.toFinset.card ≤
          ∑ w₀ ∈ (Finset.univ : Finset (NumberField.InfinitePlace K)), (hS_fin w₀).toFinset.card :=
        le_trans (Finset.card_le_card hR_cover) Finset.card_biUnion_le
      exact_mod_cast h1
    have hlog_nonneg : 0 ≤ (n : ℝ) * (L + 1) := by positivity
    calc ∑ π ∈ hR_fin.toFinset, g π
        ≤ ∑ _π ∈ hR_fin.toFinset, ((n : ℝ) * (L + 1)) := Finset.sum_le_sum hg_le
      _ = (hR_fin.toFinset.card : ℝ) * ((n : ℝ) * (L + 1)) := by
          rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ (∑ w₀ : NumberField.InfinitePlace K, ((hS_fin w₀).toFinset.card : ℝ)) *
            ((n : ℝ) * (L + 1)) :=
          mul_le_mul_of_nonneg_right hcard_R_le_sum hlog_nonneg
  
  have h_s2_bound :
      (∑ w₀ : NumberField.InfinitePlace K, ((hS_fin w₀).toFinset.card : ℝ)) ≤
      C₀ * (X ^ n * δ + X ^ (n - 1)) := by
    have hexp_le_e : Real.exp δ ≤ Real.exp 1 := Real.exp_le_exp.mpr hδ_le_one
    have hXp_le_eX : X' ≤ Real.exp 1 * X := by
      dsimp [X']
      have h1 := mul_le_mul_of_nonneg_left hexp_le_e (le_of_lt hX_pos)
      linarith only [h1]
    have hexp_sub_one : Real.exp δ - 1 ≤ B₀ * δ := by
      have h1 : -δ + 1 ≤ Real.exp (-δ) := Real.add_one_le_exp (-δ)
      have h2 : 1 - Real.exp (-δ) ≤ δ := by linarith only [h1]
      have h3 : (1 - Real.exp (-δ)) * Real.exp δ ≤ δ * Real.exp δ :=
        mul_le_mul_of_nonneg_right h2 (le_of_lt (Real.exp_pos δ))
      have h4 : (1 - Real.exp (-δ)) * Real.exp δ = Real.exp δ - 1 := by
        calc (1 - Real.exp (-δ)) * Real.exp δ
            = Real.exp δ - Real.exp (-δ) * Real.exp δ := by ring
          _ = Real.exp δ - Real.exp (-δ + δ) := by rw [← Real.exp_add]
          _ = Real.exp δ - Real.exp 0 := by ring_nf
          _ = Real.exp δ - 1 := by rw [Real.exp_zero]
      have h_exp_le_B0 : Real.exp δ ≤ B₀ := by
        dsimp [B₀]
        linarith only [hexp_le_e, hD_pos]
      have h5 : δ * Real.exp δ ≤ B₀ * δ := by
        have hm := mul_le_mul_of_nonneg_left h_exp_le_B0 hδ_nonneg
        linarith only [hm]
      linarith only [h3, h4, h5]
    have hXp_sub_X : X' - X ≤ B₀ * X * δ := by
      have h1 : X' - X = X * (Real.exp δ - 1) := by dsimp [X']; ring
      have h2 : X * (Real.exp δ - 1) ≤ X * (B₀ * δ) :=
        mul_le_mul_of_nonneg_left hexp_sub_one (le_of_lt hX_pos)
      linarith only [h1, h2]
    let a_real : ℝ := max 0 (X - D)
    let b_real : ℝ := X' + D
    have ha_nonneg : 0 ≤ a_real := le_max_left _ _
    have hb_pos : 0 < b_real := by dsimp [b_real]; positivity
    have hb_nonneg : 0 ≤ b_real := le_of_lt hb_pos
    have hab : a_real ≤ b_real := max_le hb_nonneg (by dsimp [b_real]; linarith only [hX_lt_Xp, hD_pos])
    have hba_diff : b_real - a_real ≤ B₀ * (X * δ + 2) := by
      have ha_ge : X - D ≤ a_real := le_max_right _ _
      have hD_le_B0 : D ≤ B₀ := by
        dsimp [B₀]
        have : 0 < Real.exp 1 := Real.exp_pos 1
        linarith only [this]
      dsimp [b_real]
      linarith only [ha_ge, hD_le_B0, hXp_sub_X]
    have hb_le_X : b_real ≤ B₀ * X := by
      have hDX : D ≤ D * X := le_mul_of_one_le_right (le_of_lt hD_pos) (le_of_lt hX)
      dsimp [b_real, B₀]
      linarith only [hXp_le_eX, hDX]
    have hba_sum : b_real + a_real ≤ 2 * B₀ * X := by linarith only [hab, hb_le_X]
    let a : NNReal := ⟨a_real, ha_nonneg⟩
    let b : NNReal := ⟨b_real, hb_nonneg⟩
    have h_meas : ∀ f : NumberField.InfinitePlace K → NNReal,
        MeasurableSet (NumberField.mixedEmbedding.convexBodyLT K f) := by
      intro f
      exact (IsOpen.prod
        (isOpen_set_pi Set.finite_univ (fun _ _ => Metric.isOpen_ball))
        (isOpen_set_pi Set.finite_univ (fun _ _ => Metric.isOpen_ball))).measurableSet
    have h_mem : ∀ (f : NumberField.InfinitePlace K → NNReal)
        (z : NumberField.mixedEmbedding.mixedSpace K),
        z ∈ NumberField.mixedEmbedding.convexBodyLT K f ↔
          ∀ w : NumberField.InfinitePlace K,
            NumberField.mixedEmbedding.normAtPlace w z < (f w : ℝ) := by
      intro f z
      rw [NumberField.mixedEmbedding.convexBodyLT, Set.mem_prod, Set.mem_univ_pi, Set.mem_univ_pi]
      constructor
      · rintro ⟨h1, h2⟩ w
        rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
        · have h := h1 ⟨w, hw⟩
          rwa [Metric.mem_ball, dist_zero_right,
            ← NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw] at h
        · have h := h2 ⟨w, hw⟩
          rwa [Metric.mem_ball, dist_zero_right,
            ← NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hw] at h
      · intro h
        refine ⟨fun w => ?_, fun w => ?_⟩
        · rw [Metric.mem_ball, dist_zero_right,
            ← NumberField.mixedEmbedding.normAtPlace_apply_of_isReal w.2]
          exact h w.1
        · rw [Metric.mem_ball, dist_zero_right,
            ← NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex w.2]
          exact h w.1
    have h_norm_nonneg : ∀ (w : NumberField.InfinitePlace K)
        (z : NumberField.mixedEmbedding.mixedSpace K),
        0 ≤ NumberField.mixedEmbedding.normAtPlace w z := by
      intro w z
      rcases NumberField.InfinitePlace.isReal_or_isComplex w with hw | hw
      · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isReal hw]
        exact norm_nonneg _
      · rw [NumberField.mixedEmbedding.normAtPlace_apply_of_isComplex hw]
        exact norm_nonneg _
    have h_vol_eq : ∀ f : NumberField.InfinitePlace K → NNReal,
        MeasureTheory.volume (NumberField.mixedEmbedding.convexBodyLT K f) =
          ↑(NumberField.mixedEmbedding.convexBodyLTFactor K) *
            ↑(∏ w : NumberField.InfinitePlace K, f w ^ w.mult) :=
      fun f => NumberField.mixedEmbedding.convexBodyLT_volume K f
    have h_vol_ne_top : ∀ f : NumberField.InfinitePlace K → NNReal,
        MeasureTheory.volume (NumberField.mixedEmbedding.convexBodyLT K f) ≠ ⊤ := by
      intro f
      rw [h_vol_eq f]
      exact ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.coe_ne_top
    have h_toReal_vol : ∀ f : NumberField.InfinitePlace K → NNReal,
        (MeasureTheory.volume (NumberField.mixedEmbedding.convexBodyLT K f)).toReal =
          F_K * ∏ w : NumberField.InfinitePlace K, (f w : ℝ) ^ w.mult := by
      intro f
      rw [h_vol_eq f, ENNReal.toReal_mul, ENNReal.coe_toReal, ENNReal.coe_toReal, NNReal.coe_prod]
      simp only [NNReal.coe_pow, F_K]
    let j : NumberField.RingOfIntegers K → NumberField.mixedEmbedding.integerLattice K :=
      fun x => ⟨NumberField.mixedEmbedding K (x : K), ⟨x, rfl⟩⟩
    have hj_inj : Function.Injective j := by
      intro x y hxy
      have h : NumberField.mixedEmbedding K (x : K) = NumberField.mixedEmbedding K (y : K) :=
        congrArg Subtype.val hxy
      obtain ⟨w⟩ : Nonempty (NumberField.InfinitePlace K) := inferInstance
      have hsub : NumberField.mixedEmbedding K ((x : K) - (y : K)) = 0 := by
        rw [map_sub, h, sub_self]
      have hw : w ((x : K) - (y : K)) = 0 := by
        rw [← NumberField.mixedEmbedding.normAtPlace_apply w ((x : K) - (y : K)), hsub, map_zero]
      exact Subtype.ext (sub_eq_zero.mp ((AbsoluteValue.eq_zero w.1).mp hw))
    have hS_bound : ∀ w₀ : NumberField.InfinitePlace K,
        ((hS_fin w₀).toFinset.card : ℝ) ≤ C_slab * (X ^ n * δ + X ^ (n - 1)) := by
      intro w₀
      let f_b : NumberField.InfinitePlace K → NNReal := fun _ => b
      let f_a : NumberField.InfinitePlace K → NNReal := fun w => if w = w₀ then a else b
      let B_b := NumberField.mixedEmbedding.convexBodyLT K f_b
      let B_a := NumberField.mixedEmbedding.convexBodyLT K f_a
      let T := (hS_fin w₀).toFinset
      let T_lat : Finset (NumberField.mixedEmbedding.integerLattice K) := T.map ⟨j, hj_inj⟩
      let U : Set (NumberField.mixedEmbedding.mixedSpace K) := ⋃ g ∈ T_lat, g +ᵥ F
      have haedisj : (T_lat : Set (NumberField.mixedEmbedding.integerLattice K)).Pairwise
          (Function.onFun (MeasureTheory.AEDisjoint MeasureTheory.volume) (fun g => g +ᵥ F)) := by
        intro g₁ _ g₂ _ hne
        exact hF_fund.aedisjoint hne
      have hnull : ∀ g ∈ T_lat, MeasureTheory.NullMeasurableSet (g +ᵥ F) MeasureTheory.volume := by
        intro g _
        change MeasureTheory.NullMeasurableSet
          ((g : NumberField.mixedEmbedding.mixedSpace K) +ᵥ F) MeasureTheory.volume
        exact (hF_meas.const_vadd (g : NumberField.mixedEmbedding.mixedSpace K)).nullMeasurableSet
      have hvol_union : MeasureTheory.volume U = (T.card : ENNReal) * MeasureTheory.volume F := by
        dsimp [U]
        rw [MeasureTheory.measure_biUnion_finset₀ haedisj hnull]
        have h_each : ∀ g ∈ T_lat, MeasureTheory.volume (g +ᵥ F) = MeasureTheory.volume F := by
          intro g _
          change MeasureTheory.volume ((g : NumberField.mixedEmbedding.mixedSpace K) +ᵥ F) =
            MeasureTheory.volume F
          exact MeasureTheory.measure_vadd MeasureTheory.volume
            (g : NumberField.mixedEmbedding.mixedSpace K) F
        rw [Finset.sum_congr rfl h_each, Finset.sum_const, nsmul_eq_mul, Finset.card_map]
      have h_disj : Disjoint U B_a := by
        rw [Set.disjoint_left]
        intro z hzU hzB
        simp only [U, Set.mem_iUnion] at hzU
        rcases hzU with ⟨g, hg, hzF⟩
        rcases Finset.mem_map.mp hg with ⟨x, hxT, rfl⟩
        rw [Set.Finite.mem_toFinset] at hxT
        rcases hzF with ⟨u, huF, rfl⟩
        have htri := NumberField.mixedEmbedding.normAtPlace_add_le w₀
          (NumberField.mixedEmbedding K (x : K) + u) (-u)
        have h_cancel : (NumberField.mixedEmbedding K (x : K) + u) + (-u) =
            NumberField.mixedEmbedding K (x : K) := add_neg_cancel_right _ _
        rw [h_cancel, NumberField.mixedEmbedding.normAtPlace_apply,
            NumberField.mixedEmbedding.normAtPlace_neg] at htri
        have huD := hF_norm u huF w₀
        have h_nonneg := h_norm_nonneg w₀ (NumberField.mixedEmbedding K (x : K) + u)
        have h_low : a_real ≤ NumberField.mixedEmbedding.normAtPlace w₀
            (NumberField.mixedEmbedding K (x : K) + u) :=
          max_le h_nonneg (by linarith only [hxT.1, htri, huD])
        have h_lt := (h_mem f_a _).mp hzB w₀
        change NumberField.mixedEmbedding.normAtPlace w₀
          (NumberField.mixedEmbedding K (x : K) + u) < (f_a w₀ : ℝ) at h_lt
        have hfa : (f_a w₀ : ℝ) = a_real := by simp [f_a, a]
        linarith only [h_low, h_lt, hfa]
      have h_sub : U ∪ B_a ⊆ B_b := by
        rintro z (hzU | hzBa)
        · simp only [U, Set.mem_iUnion] at hzU
          rcases hzU with ⟨g, hg, hzF⟩
          rcases Finset.mem_map.mp hg with ⟨x, hxT, rfl⟩
          rw [Set.Finite.mem_toFinset] at hxT
          rcases hzF with ⟨u, huF, rfl⟩
          rw [h_mem]
          intro w
          change NumberField.mixedEmbedding.normAtPlace w
            (NumberField.mixedEmbedding K (x : K) + u) < (f_b w : ℝ)
          have htri := NumberField.mixedEmbedding.normAtPlace_add_le w
            (NumberField.mixedEmbedding K (x : K)) u
          rw [NumberField.mixedEmbedding.normAtPlace_apply] at htri
          have huD := hF_norm u huF w
          have hfb : (f_b w : ℝ) = X' + D := by simp [f_b, b, b_real]
          have hxw := hxT.2 w
          linarith only [htri, huD, hfb, hxw]
        · rw [h_mem] at hzBa ⊢
          intro w
          refine lt_of_lt_of_le (hzBa w) ?_
          by_cases hw : w = w₀
          · simp [f_a, f_b, hw, a, b, hab]
          · simp [f_a, f_b, hw]
      have h_meas_ie : MeasureTheory.volume U + MeasureTheory.volume B_a ≤
          MeasureTheory.volume B_b := by
        rw [← MeasureTheory.measure_union h_disj (h_meas f_a)]
        exact MeasureTheory.measure_mono h_sub
      have hU_ne_top : MeasureTheory.volume U ≠ ⊤ := by
        rw [hvol_union]
        exact ENNReal.mul_ne_top (ENNReal.natCast_ne_top T.card) hF_ne_top
      have h_real_ie := ENNReal.toReal_mono (h_vol_ne_top f_b) h_meas_ie
      rw [ENNReal.toReal_add hU_ne_top (h_vol_ne_top f_a),
          hvol_union, ENNReal.toReal_mul, ENNReal.toReal_natCast,
          h_toReal_vol f_a, h_toReal_vol f_b] at h_real_ie
      let S_rem : Finset (NumberField.InfinitePlace K) :=
        (Finset.univ : Finset (NumberField.InfinitePlace K)).erase w₀
      let P_rem : ℝ := ∏ w ∈ S_rem, b_real ^ w.mult
      have hPrem_nonneg : 0 ≤ P_rem := Finset.prod_nonneg (fun _ _ => by positivity)
      have hp_b : (∏ w : NumberField.InfinitePlace K, (f_b w : ℝ) ^ w.mult) =
          b_real ^ w₀.mult * P_rem := by
        have h1 := (Finset.mul_prod_erase (Finset.univ : Finset (NumberField.InfinitePlace K))
          (fun w => (f_b w : ℝ) ^ w.mult) (Finset.mem_univ w₀)).symm
        rw [h1]
        simp [f_b, b, P_rem, S_rem]
      have hp_a : (∏ w : NumberField.InfinitePlace K, (f_a w : ℝ) ^ w.mult) =
          a_real ^ w₀.mult * P_rem := by
        have h1 := (Finset.mul_prod_erase (Finset.univ : Finset (NumberField.InfinitePlace K))
          (fun w => (f_a w : ℝ) ^ w.mult) (Finset.mem_univ w₀)).symm
        rw [h1]
        have h_head : (f_a w₀ : ℝ) ^ w₀.mult = a_real ^ w₀.mult := by simp [f_a, a]
        have h_tail : (∏ w ∈ S_rem, (f_a w : ℝ) ^ w.mult) = P_rem := by
          refine Finset.prod_congr rfl (fun w hw => ?_)
          have hne : w ≠ w₀ := Finset.ne_of_mem_erase hw
          simp [f_a, hne, b]
        rw [h_head, h_tail]
      have h_factored : (T.card : ℝ) * V_K ≤
          F_K * (b_real ^ w₀.mult - a_real ^ w₀.mult) * P_rem := by
        rw [hp_a, hp_b] at h_real_ie
        change (T.card : ℝ) * V_K + F_K * (a_real ^ w₀.mult * P_rem) ≤
          F_K * (b_real ^ w₀.mult * P_rem) at h_real_ie
        linarith only [h_real_ie]
      have h_w0_bound : b_real ^ w₀.mult - a_real ^ w₀.mult ≤
          2 * B₀ ^ 2 * (X * δ + 2) * X ^ (w₀.mult - 1) := by
        rcases NumberField.InfinitePlace.isReal_or_isComplex w₀ with hw | hw
        · have hm_real : w₀.mult = 1 := NumberField.InfinitePlace.mult_isReal ⟨w₀, hw⟩
          rw [hm_real]
          simp only [Nat.sub_self, pow_one, pow_zero, mul_one]
          have hB₀_le_2sq : B₀ ≤ 2 * B₀ ^ 2 := by
            have h1 : B₀ * 1 ≤ B₀ * B₀ := mul_le_mul_of_nonneg_left hB₀_ge1 (le_of_lt hB₀_pos)
            have h2 : B₀ * B₀ = B₀ ^ 2 := (sq B₀).symm
            have h3 : 0 ≤ B₀ ^ 2 := sq_nonneg B₀
            linarith only [h1, h2, h3]
          have h_pos_term : 0 ≤ X * δ + 2 := by positivity
          calc b_real - a_real
              ≤ B₀ * (X * δ + 2) := hba_diff
            _ ≤ (2 * B₀ ^ 2) * (X * δ + 2) :=
                mul_le_mul_of_nonneg_right hB₀_le_2sq h_pos_term
        · have hm_cplx : w₀.mult = 2 := NumberField.InfinitePlace.mult_isComplex ⟨w₀, hw⟩
          rw [hm_cplx]
          change b_real ^ 2 - a_real ^ 2 ≤ 2 * B₀ ^ 2 * (X * δ + 2) * X ^ 1
          have h_diff_sq : b_real ^ 2 - a_real ^ 2 = (b_real - a_real) * (b_real + a_real) := by ring
          rw [h_diff_sq, pow_one]
          calc (b_real - a_real) * (b_real + a_real)
              ≤ (B₀ * (X * δ + 2)) * (2 * B₀ * X) :=
                mul_le_mul hba_diff hba_sum (by positivity) (by positivity)
            _ = 2 * B₀ ^ 2 * (X * δ + 2) * X := by ring
      have h_mult_sum : w₀.mult + ∑ w ∈ S_rem, w.mult = n := by
        have h1 := Finset.add_sum_erase (Finset.univ : Finset (NumberField.InfinitePlace K))
          (fun w => w.mult) (Finset.mem_univ w₀)
        rw [NumberField.InfinitePlace.sum_mult_eq] at h1
        exact h1
      have hw0_pos : 1 ≤ w₀.mult := NumberField.InfinitePlace.mult_pos
      have hSrem_le_n : (∑ w ∈ S_rem, w.mult) ≤ n := by omega
      have h_exp_sum : (w₀.mult - 1) + (∑ w ∈ S_rem, w.mult) = n - 1 := by omega
      have hPrem_bound : P_rem ≤ B₀ ^ n * X ^ (∑ w ∈ S_rem, w.mult) := by
        have h1 : P_rem ≤ ∏ w ∈ S_rem, (B₀ * X) ^ w.mult := by
          dsimp [P_rem]
          apply Finset.prod_le_prod
          · intro w _; positivity
          · intro w _
            exact pow_le_pow_left₀ hb_nonneg hb_le_X w.mult
        rw [Finset.prod_pow_eq_pow_sum, mul_pow] at h1
        have h2 : B₀ ^ (∑ w ∈ S_rem, w.mult) ≤ B₀ ^ n :=
          pow_le_pow_right₀ hB₀_ge1 hSrem_le_n
        exact le_trans h1 (mul_le_mul_of_nonneg_right h2 (by positivity))
      have h_X_pow1 : X ^ (w₀.mult - 1) * X ^ (∑ w ∈ S_rem, w.mult) = X ^ (n - 1) := by
        rw [← pow_add, h_exp_sum]
      have h_X_pow2 : X * X ^ (n - 1) = X ^ n := by
        rw [← pow_succ', Nat.sub_add_cancel hn_pos]
      have h_B0_pow : B₀ ^ 2 * B₀ ^ n = B₀ ^ (n + 2) := by
        rw [← pow_add, add_comm]
      have h_prod_comb :
          (b_real ^ w₀.mult - a_real ^ w₀.mult) * P_rem ≤
          2 * B₀ ^ (n + 2) * (X * δ + 2) * X ^ (n - 1) := by
        calc (b_real ^ w₀.mult - a_real ^ w₀.mult) * P_rem
            ≤ (2 * B₀ ^ 2 * (X * δ + 2) * X ^ (w₀.mult - 1)) *
                (B₀ ^ n * X ^ (∑ w ∈ S_rem, w.mult)) :=
              mul_le_mul h_w0_bound hPrem_bound hPrem_nonneg (by positivity)
          _ = 2 * (B₀ ^ 2 * B₀ ^ n) * (X * δ + 2) *
                (X ^ (w₀.mult - 1) * X ^ (∑ w ∈ S_rem, w.mult)) := by ring
          _ = 2 * B₀ ^ (n + 2) * (X * δ + 2) * X ^ (n - 1) := by rw [h_B0_pow, h_X_pow1]
      have h_expand_le :
          2 * B₀ ^ (n + 2) * (X * δ + 2) * X ^ (n - 1) ≤
          4 * B₀ ^ (n + 2) * (X ^ n * δ + X ^ (n - 1)) := by
        have h_alg : 2 * B₀ ^ (n + 2) * (X * δ + 2) * X ^ (n - 1) =
            2 * B₀ ^ (n + 2) * ((X * X ^ (n - 1)) * δ + 2 * X ^ (n - 1)) := by ring
        rw [h_alg, h_X_pow2]
        have h_nonneg : 0 ≤ 2 * B₀ ^ (n + 2) * (X ^ n * δ) := by positivity
        linarith only [h_nonneg]
      have h_card_VK : (T.card : ℝ) * V_K ≤
          (4 * F_K * B₀ ^ (n + 2)) * (X ^ n * δ + X ^ (n - 1)) := by
        have h1 : F_K * (b_real ^ w₀.mult - a_real ^ w₀.mult) * P_rem =
            F_K * ((b_real ^ w₀.mult - a_real ^ w₀.mult) * P_rem) := by ring
        have h2 : (b_real ^ w₀.mult - a_real ^ w₀.mult) * P_rem ≤
            4 * B₀ ^ (n + 2) * (X ^ n * δ + X ^ (n - 1)) :=
          le_trans h_prod_comb h_expand_le
        have h3 : F_K * ((b_real ^ w₀.mult - a_real ^ w₀.mult) * P_rem) ≤
            F_K * (4 * B₀ ^ (n + 2) * (X ^ n * δ + X ^ (n - 1))) :=
          mul_le_mul_of_nonneg_left h2 (le_of_lt hFK_pos)
        linarith only [h_factored, h1, h3]
      rw [← le_div_iff₀ hVK_pos] at h_card_VK
      calc (T.card : ℝ)
          ≤ (4 * F_K * B₀ ^ (n + 2)) * (X ^ n * δ + X ^ (n - 1)) / V_K := h_card_VK
        _ = C_slab * (X ^ n * δ + X ^ (n - 1)) := by dsimp [C_slab]; ring
    calc (∑ w₀ : NumberField.InfinitePlace K, ((hS_fin w₀).toFinset.card : ℝ))
        ≤ ∑ _w₀ : NumberField.InfinitePlace K,
            (C_slab * (X ^ n * δ + X ^ (n - 1))) :=
          Finset.sum_le_sum (fun w₀ _ => hS_bound w₀)
      _ = ((Fintype.card (NumberField.InfinitePlace K) : ℝ) * C_slab) *
            (X ^ n * δ + X ^ (n - 1)) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
          ring
      _ ≤ C₀ * (X ^ n * δ + X ^ (n - 1)) := by
          have hC₀_ge : (Fintype.card (NumberField.InfinitePlace K) : ℝ) * C_slab ≤ C₀ :=
            le_max_right _ _
          exact mul_le_mul_of_nonneg_right hC₀_ge (by positivity)
  
  have h_s3_bound :
      C₀ * (X ^ n * δ + X ^ (n - 1)) * ((n : ℝ) * (L + 1)) ≤
      c_shell * X ^ n * ((L + 1) ^ 2 / (m : ℝ)) +
        c_shell * X ^ n * Real.exp (-Real.sqrt L / c_shell) := by
    have h_delta_L : δ * (L + 1) ≤ (L + 1) ^ 2 / (m : ℝ) := by
      dsimp [δ]
      rw [div_mul_eq_mul_div]
      apply div_le_div_of_nonneg_right _ (le_of_lt hm_rpos)
      have h1 : L ≤ L + 1 := by linarith only []
      have h2 : L * (L + 1) ≤ (L + 1) * (L + 1) :=
        mul_le_mul_of_nonneg_right h1 (by positivity)
      rwa [← sq] at h2
    have h_term1 : (C₀ * (n : ℝ)) * X ^ n * (δ * (L + 1)) ≤
        c_shell * X ^ n * ((L + 1) ^ 2 / (m : ℝ)) := by
      have h1 : (C₀ * (n : ℝ)) * X ^ n ≤ c_shell * X ^ n :=
        mul_le_mul_of_nonneg_right hc_shell_ge_C0 (by positivity)
      exact mul_le_mul h1 h_delta_L (by positivity) (by positivity)
    let t : ℝ := Real.sqrt L
    have ht_nonneg : 0 ≤ t := Real.sqrt_nonneg L
    have ht_sq : t ^ 2 = L := Real.sq_sqrt hL_nonneg
    have hL_le_exp : L ≤ 4 * Real.exp t := by
      have h1 := Real.add_one_le_exp (t / 2)
      have ht_le : t ≤ 2 * Real.exp (t / 2) := by linarith only [h1]
      have hsq : t ^ 2 ≤ (2 * Real.exp (t / 2)) ^ 2 := pow_le_pow_left₀ ht_nonneg ht_le 2
      have hexp_sq : (2 * Real.exp (t / 2)) ^ 2 = 4 * Real.exp t := by
        calc (2 * Real.exp (t / 2)) ^ 2 = 4 * (Real.exp (t / 2) * Real.exp (t / 2)) := by ring
          _ = 4 * Real.exp (t / 2 + t / 2) := by rw [← Real.exp_add]
          _ = 4 * Real.exp t := by rw [add_halves]
      linarith only [ht_sq, hsq, hexp_sq]
    have h1_le_exp_t : 1 ≤ Real.exp t := Real.one_le_exp ht_nonneg
    have hL1_le_exp : L + 1 ≤ 5 * Real.exp t := by linarith only [hL_le_exp, h1_le_exp_t]
    have hexp_t_le : Real.exp t ≤ X * Real.exp 1 * Real.exp (-t) := by
      have h1 : 0 ≤ (t - 1) ^ 2 := sq_nonneg (t - 1)
      have h1_exp : (t - 1) ^ 2 = t ^ 2 - 2 * t + 1 := by ring
      have h2 : t ≤ (L + 1) + (-t) := by linarith only [h1, h1_exp, ht_sq]
      calc Real.exp t ≤ Real.exp ((L + 1) + (-t)) := Real.exp_le_exp.mpr h2
        _ = Real.exp L * Real.exp 1 * Real.exp (-t) := by rw [Real.exp_add, Real.exp_add]
        _ = X * Real.exp 1 * Real.exp (-t) := by rw [Real.exp_log hX_pos]
    have hL1_le_X : L + 1 ≤ 5 * X * Real.exp 1 * Real.exp (-t) := by
      calc L + 1 ≤ 5 * Real.exp t := hL1_le_exp
        _ ≤ 5 * (X * Real.exp 1 * Real.exp (-t)) := by linarith only [hexp_t_le]
        _ = 5 * X * Real.exp 1 * Real.exp (-t) := by ring
    have hexp_cshell : Real.exp (-t) ≤ Real.exp (-t / c_shell) := by
      rw [Real.exp_le_exp, neg_div, neg_le_neg_iff]
      exact div_le_self ht_nonneg hc_shell_ge1
    have hXn : X ^ (n - 1) * X = X ^ n := by
      rw [← pow_succ, Nat.sub_add_cancel hn_pos]
    have h_term2 : (C₀ * (n : ℝ)) * X ^ (n - 1) * (L + 1) ≤
        c_shell * X ^ n * Real.exp (-t / c_shell) := by
      calc (C₀ * (n : ℝ)) * X ^ (n - 1) * (L + 1)
          ≤ (C₀ * (n : ℝ)) * X ^ (n - 1) * (5 * X * Real.exp 1 * Real.exp (-t)) :=
            mul_le_mul_of_nonneg_left hL1_le_X (by positivity)
        _ = (5 * Real.exp 1 * C₀ * (n : ℝ)) * (X ^ (n - 1) * X) * Real.exp (-t) := by ring
        _ = (5 * Real.exp 1 * C₀ * (n : ℝ)) * X ^ n * Real.exp (-t) := by rw [hXn]
        _ ≤ c_shell * X ^ n * Real.exp (-t / c_shell) := by
            apply mul_le_mul
            · exact mul_le_mul_of_nonneg_right hc_shell_ge5 (by positivity)
            · exact hexp_cshell
            · positivity
            · positivity
    have h_alg : C₀ * (X ^ n * δ + X ^ (n - 1)) * ((n : ℝ) * (L + 1)) =
        (C₀ * (n : ℝ)) * X ^ n * (δ * (L + 1)) +
        (C₀ * (n : ℝ)) * X ^ (n - 1) * (L + 1) := by ring
    rw [h_alg]
    exact add_le_add h_term1 h_term2
  
  have h_mid :
      (∑ w₀ : NumberField.InfinitePlace K, ((hS_fin w₀).toFinset.card : ℝ)) *
        ((n : ℝ) * (L + 1)) ≤
      C₀ * (X ^ n * δ + X ^ (n - 1)) * ((n : ℝ) * (L + 1)) :=
    mul_le_mul_of_nonneg_right h_s2_bound (by positivity)
  exact le_trans h_s1_bound (le_trans h_mid h_s3_bound)

theorem mitsui_higher_primePower_chebyshev_bound {K : Type u} [Field K] [NumberField K] :
    ∃ c₁ : ℝ, 0 < c₁ ∧
      ∀ X : ℝ, 1 < X →
        (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
              2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ X ^ (Module.finrank ℚ K)},
            Real.log (Ideal.absNorm pm.1.1.asIdeal))
          ≤ c₁ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₁) :=
by
  classical
  have h_s1 : ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ s : ℝ, 1 ≤ s →
      (Nat.card {J : Ideal (NumberField.RingOfIntegers K) // (Ideal.absNorm J : ℝ) ≤ s} : ℝ) ≤
        C₁ * s := by
    set L_K : ℝ :=
      2 ^ NumberField.InfinitePlace.nrRealPlaces K *
        (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
        NumberField.Units.regulator K *
        (NumberField.classNumber K : ℝ) /
        ((NumberField.Units.torsionOrder K : ℝ) * Real.sqrt |(NumberField.discr K : ℝ)|)
    have h_tendsto : Filter.Tendsto
        (fun s : ℝ => (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ s} : ℝ) / s)
        Filter.atTop (nhds L_K) :=
      NumberField.Ideal.tendsto_norm_le_div_atTop K
    obtain ⟨S₀, hS₀⟩ := (Metric.tendsto_atTop.mp h_tendsto) 1 zero_lt_one
    let S₁ : ℝ := max S₀ 1
    let N₁ : ℕ := Nat.card {J : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm J ≤ ⌊S₁⌋₊}
    let C₁ : ℝ := max (|L_K| + 1) ((N₁ : ℝ) + 1)
    have hC₁_pos : 0 < C₁ := by
      have h1 : 0 ≤ |L_K| := abs_nonneg L_K
      have h2 : |L_K| + 1 ≤ C₁ := le_max_left _ _
      linarith
    refine ⟨C₁, hC₁_pos, ?_⟩
    intro s hs
    have hs_pos : 0 < s := lt_of_lt_of_le zero_lt_one hs
    by_cases hS : S₁ ≤ s
    · have hS₀_le : S₀ ≤ s := le_trans (le_max_left S₀ 1) hS
      have h_dist := hS₀ s hS₀_le
      rw [Real.dist_eq] at h_dist
      have h_sub : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ s} : ℝ) / s - L_K < 1 :=
        (abs_sub_lt_iff.mp h_dist).1
      have h_abs : L_K ≤ |L_K| := le_abs_self L_K
      have h_max : |L_K| + 1 ≤ C₁ := le_max_left _ _
      have h_div_le : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ s} : ℝ) / s ≤ C₁ := by linarith
      exact (div_le_iff₀ hs_pos).mp h_div_le
    · have hs_le : s ≤ S₁ := le_of_not_ge hS
      have h_sub : {J : Ideal (NumberField.RingOfIntegers K) | (Ideal.absNorm J : ℝ) ≤ s} ⊆
          {J : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm J ≤ ⌊S₁⌋₊} := by
        intro J hJ
        exact Nat.le_floor (le_trans hJ hs_le)
      have h_fin : {J : Ideal (NumberField.RingOfIntegers K) | Ideal.absNorm J ≤ ⌊S₁⌋₊}.Finite :=
        Ideal.finite_setOf_absNorm_le ⌊S₁⌋₊
      have h_card_le : Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ s} ≤ N₁ :=
        Nat.card_mono h_fin h_sub
      have h_card_real : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ s} : ℝ) ≤ (N₁ : ℝ) := by exact_mod_cast h_card_le
      have h_max : (N₁ : ℝ) + 1 ≤ C₁ := le_max_right _ _
      have h_le_C₁ : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ s} : ℝ) ≤ C₁ := by linarith
      nlinarith
  have h_s2 : ∀ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      2 ≤ Ideal.absNorm p.asIdeal := by
    intro p
    have h0 : Ideal.absNorm p.asIdeal ≠ 0 := Ideal.absNorm_eq_zero_iff.not.mpr p.ne_bot
    have h1 : Ideal.absNorm p.asIdeal ≠ 1 := Ideal.absNorm_eq_one_iff.not.mpr p.isPrime.ne_top
    omega
  have h_s3 : ∀ (X : ℝ), 1 < X →
      ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
        2 ≤ m → (Ideal.absNorm p.asIdeal : ℝ) ^ m ≤ X ^ (Module.finrank ℚ K) →
        (Ideal.absNorm p.asIdeal : ℝ) ≤ X ^ ((Module.finrank ℚ K : ℝ) / 2) ∧
        m < ⌊(Module.finrank ℚ K : ℝ) * Real.log X / Real.log 2⌋₊ + 1 ∧
        Real.log (Ideal.absNorm p.asIdeal) ≤ (Module.finrank ℚ K : ℝ) * Real.log X := by
    intro X hX p m hm h_pow
    set n : ℕ := Module.finrank ℚ K
    set k : ℕ := Ideal.absNorm p.asIdeal
    have hk2 : 2 ≤ k := h_s2 p
    have hk_pos : 0 < k := by omega
    have hX_pos : 0 < X := by linarith
    refine ⟨?_, ?_, ?_⟩
    · have h_pow_le : k ^ 2 ≤ k ^ m := Nat.pow_le_pow_right hk_pos hm
      have h_pow_real : (k : ℝ) ^ 2 ≤ (k : ℝ) ^ m := by exact_mod_cast h_pow_le
      have h_sq_le_Xn : (k : ℝ) ^ 2 ≤ X ^ n := le_trans h_pow_real h_pow
      have h_Xn_eq : (X ^ ((n : ℝ) / 2)) ^ 2 = X ^ n := by
        rw [sq, ← Real.rpow_add hX_pos, add_halves, Real.rpow_natCast]
      have h_sq_le_sq : (k : ℝ) ^ 2 ≤ (X ^ ((n : ℝ) / 2)) ^ 2 := by linarith
      have h_rpow_nonneg : 0 ≤ X ^ ((n : ℝ) / 2) := Real.rpow_nonneg (le_of_lt hX_pos) _
      exact (abs_le_of_sq_le_sq' h_sq_le_sq h_rpow_nonneg).2
    · have h_pow2_le : 2 ^ m ≤ k ^ m := Nat.pow_le_pow_left hk2 m
      have h_pow2_real : (2 : ℝ) ^ m ≤ (k : ℝ) ^ m := by exact_mod_cast h_pow2_le
      have h_pow2_le_Xn : (2 : ℝ) ^ m ≤ X ^ n := le_trans h_pow2_real h_pow
      have h_log_le : Real.log ((2 : ℝ) ^ m) ≤ Real.log (X ^ n) :=
        Real.log_le_log (by positivity) h_pow2_le_Xn
      rw [Real.log_pow, Real.log_pow] at h_log_le
      have hlog2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num : (1 : ℝ) < 2)
      have hm_le_div : (m : ℝ) ≤ (n : ℝ) * Real.log X / Real.log 2 :=
        (le_div_iff₀ hlog2_pos).mpr h_log_le
      have hm_le_floor : m ≤ ⌊(n : ℝ) * Real.log X / Real.log 2⌋₊ :=
        Nat.le_floor hm_le_div
      exact Nat.lt_add_one_of_le hm_le_floor
    · have hm_ne : m ≠ 0 := by omega
      have hk_le_pow : k ≤ k ^ m := Nat.le_self_pow hm_ne k
      have hk_real : (k : ℝ) ≤ (k : ℝ) ^ m := by exact_mod_cast hk_le_pow
      have hk_le_Xn : (k : ℝ) ≤ X ^ n := le_trans hk_real h_pow
      have h_log_le : Real.log (k : ℝ) ≤ Real.log (X ^ n) :=
        Real.log_le_log (by positivity) hk_le_Xn
      rw [Real.log_pow] at h_log_le
      exact h_log_le
  have h_s4 : ∀ (X : ℝ), 1 < X →
      (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ X ^ (Module.finrank ℚ K)},
          Real.log (Ideal.absNorm pm.1.1.asIdeal)) ≤
      (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
        (Ideal.absNorm J : ℝ) ≤ X ^ ((Module.finrank ℚ K : ℝ) / 2)} : ℝ) *
      ((⌊(Module.finrank ℚ K : ℝ) * Real.log X / Real.log 2⌋₊ + 1 : ℕ) : ℝ) *
      ((Module.finrank ℚ K : ℝ) * Real.log X) := by
    intro X hX
    let n : ℕ := Module.finrank ℚ K
    let s : ℝ := X ^ ((n : ℝ) / 2)
    let M : ℕ := ⌊(n : ℝ) * Real.log X / Real.log 2⌋₊
    let D_ge2 := {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
      2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ X ^ n}
    let S_J := {J : Ideal (NumberField.RingOfIntegers K) // (Ideal.absNorm J : ℝ) ≤ s}
    have hSJ_set_fin : {J : Ideal (NumberField.RingOfIntegers K) | (Ideal.absNorm J : ℝ) ≤ s}.Finite := by
      apply Set.Finite.subset (Ideal.finite_setOf_absNorm_le ⌊s⌋₊)
      intro J hJ
      exact Nat.le_floor hJ
    haveI : Finite S_J := hSJ_set_fin
    let ψ : D_ge2 → S_J × Fin (M + 1) := fun pm =>
      (⟨pm.1.1.asIdeal, (h_s3 X hX pm.1.1 pm.1.2 pm.2.1 pm.2.2).1⟩,
       ⟨pm.1.2, (h_s3 X hX pm.1.1 pm.1.2 pm.2.1 pm.2.2).2.1⟩)
    have hψ_inj : Function.Injective ψ := by
      intro a b hab
      have h1 : a.1.1.asIdeal = b.1.1.asIdeal := congrArg Subtype.val (Prod.ext_iff.mp hab).1
      have h2 : a.1.2 = b.1.2 := congrArg Fin.val (Prod.ext_iff.mp hab).2
      exact Subtype.ext (Prod.ext (IsDedekindDomain.HeightOneSpectrum.ext h1) h2)
    haveI : Finite D_ge2 := Finite.of_injective ψ hψ_inj
    letI : Fintype D_ge2 := Fintype.ofFinite D_ge2
    have hcard_le : Nat.card D_ge2 ≤ Nat.card S_J * (M + 1) := by
      calc Nat.card D_ge2
          ≤ Nat.card (S_J × Fin (M + 1)) := Nat.card_le_card_of_injective ψ hψ_inj
        _ = Nat.card S_J * Nat.card (Fin (M + 1)) := Nat.card_prod S_J (Fin (M + 1))
        _ = Nat.card S_J * (M + 1) := by rw [Nat.card_fin]
    have hcard_real : (Nat.card D_ge2 : ℝ) ≤ (Nat.card S_J : ℝ) * ((M + 1 : ℕ) : ℝ) := by
      exact_mod_cast hcard_le
    have hlogX_pos : 0 < Real.log X := Real.log_pos hX
    have hn_logX_nonneg : 0 ≤ (n : ℝ) * Real.log X := by positivity
    calc (∑' pm : D_ge2, Real.log (Ideal.absNorm pm.1.1.asIdeal))
        = ∑ pm : D_ge2, Real.log (Ideal.absNorm pm.1.1.asIdeal) := tsum_fintype _
      _ ≤ ∑ _pm : D_ge2, ((n : ℝ) * Real.log X) := by
          apply Finset.sum_le_sum
          intro pm _
          exact (h_s3 X hX pm.1.1 pm.1.2 pm.2.1 pm.2.2).2.2
      _ = (Fintype.card D_ge2 : ℝ) * ((n : ℝ) * Real.log X) := by
          rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      _ = (Nat.card D_ge2 : ℝ) * ((n : ℝ) * Real.log X) := by
          rw [← Nat.card_eq_fintype_card]
      _ ≤ ((Nat.card S_J : ℝ) * ((M + 1 : ℕ) : ℝ)) * ((n : ℝ) * Real.log X) := by
          gcongr
      _ = (Nat.card S_J : ℝ) * ((M + 1 : ℕ) : ℝ) * ((n : ℝ) * Real.log X) := by
          ring
  obtain ⟨C₁, hC₁_pos, hC₁⟩ := h_s1
  let n : ℕ := Module.finrank ℚ K
  have hn : 0 < n := Module.finrank_pos
  have hn_pos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
  have hlog2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num : (1 : ℝ) < 2)
  let c_id : ℝ := C₁ * ((n : ℝ) / Real.log 2 + 1)
  have hc_id_pos : 0 < c_id := by
    dsimp [c_id]
    positivity
  let A : ℝ := (n : ℝ) * c_id
  have hA_pos : 0 < A := by
    dsimp [A]
    positivity
  let c₁ : ℝ := max 2 (64 * A * Real.exp 1)
  have hc_ge_two : 2 ≤ c₁ := le_max_left _ _
  have hc_ge_A : 64 * A * Real.exp 1 ≤ c₁ := le_max_right _ _
  have hc₁_pos : 0 < c₁ := by linarith
  have h_s5 : ∀ X : ℝ, 1 < X →
      A * X ^ ((n : ℝ) / 2) * (Real.log X + 1) ^ 2 ≤
        c₁ * X ^ n * Real.exp (-Real.sqrt (Real.log X) / c₁) := by
    intro X hX
    have hX_pos : 0 < X := by linarith
    have hlog_pos : 0 < Real.log X := Real.log_pos hX
    set t : ℝ := Real.sqrt (Real.log X)
    have ht_pos : 0 < t := Real.sqrt_pos.mpr hlog_pos
    have ht_sq : t ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlog_pos)
    have hu_le : (t ^ 2 + 1) / 8 ≤ Real.exp ((t ^ 2 + 1) / 8) := by
      have h1 := Real.add_one_le_exp ((t ^ 2 + 1) / 8)
      linarith
    have hu_nonneg : 0 ≤ (t ^ 2 + 1) / 8 := by positivity
    have hpow_le : ((t ^ 2 + 1) / 8) ^ 2 ≤ Real.exp ((t ^ 2 + 1) / 4) := by
      calc ((t ^ 2 + 1) / 8) ^ 2
          ≤ (Real.exp ((t ^ 2 + 1) / 8)) ^ 2 := pow_le_pow_left₀ hu_nonneg hu_le 2
        _ = Real.exp ((2 : ℕ) * ((t ^ 2 + 1) / 8)) := (Real.exp_nat_mul _ 2).symm
        _ = Real.exp ((t ^ 2 + 1) / 4) := by
            congr 1
            push_cast
            ring
    have hpoly_bound : (Real.log X + 1) ^ 2 ≤ 64 * Real.exp ((t ^ 2 + 1) / 4) := by
      have h2 := mul_le_mul_of_nonneg_left hpow_le (by norm_num : (0 : ℝ) ≤ 64)
      have h3 : 64 * ((t ^ 2 + 1) / 8) ^ 2 = (t ^ 2 + 1) ^ 2 := by ring
      rw [← ht_sq, ← h3]
      exact h2
    have hn_ge_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
    have htc_le : t / c₁ ≤ t / 2 :=
      div_le_div_of_nonneg_left (le_of_lt ht_pos) (by norm_num) hc_ge_two
    have hsq_nonneg : 0 ≤ (t - 1) ^ 2 / 4 := by positivity
    have hn_half : t ^ 2 / 2 ≤ ((n : ℝ) / 2) * t ^ 2 := by
      have : (1 : ℝ) / 2 ≤ (n : ℝ) / 2 := by linarith
      nlinarith
    have hexp_arg_le2 : (t ^ 2 + 1) / 4 ≤ 1 + ((n : ℝ) / 2) * t ^ 2 + (-t / c₁) := by
      have hident : (t ^ 2 + 1) / 4 = t ^ 2 / 2 - t / 2 + 1 / 2 - (t - 1) ^ 2 / 4 := by ring
      rw [neg_div]
      linarith
    have hexp_split : Real.exp (1 + ((n : ℝ) / 2) * t ^ 2 + (-t / c₁)) =
        Real.exp 1 * X ^ ((n : ℝ) / 2) * Real.exp (-t / c₁) := by
      rw [Real.exp_add, Real.exp_add, ht_sq, Real.rpow_def_of_pos hX_pos]
      ring_nf
    have hexp_bound : Real.exp ((t ^ 2 + 1) / 4) ≤
        Real.exp 1 * X ^ ((n : ℝ) / 2) * Real.exp (-t / c₁) := by
      rw [← hexp_split]
      exact Real.exp_le_exp.mpr hexp_arg_le2
    have hX_half_mul : X ^ ((n : ℝ) / 2) * X ^ ((n : ℝ) / 2) = X ^ n := by
      rw [← Real.rpow_add hX_pos]
      have hnh : (n : ℝ) / 2 + (n : ℝ) / 2 = (n : ℝ) := by ring
      rw [hnh, Real.rpow_natCast]
    calc A * X ^ ((n : ℝ) / 2) * (Real.log X + 1) ^ 2
        ≤ A * X ^ ((n : ℝ) / 2) * (64 * Real.exp ((t ^ 2 + 1) / 4)) := by
          gcongr
      _ ≤ A * X ^ ((n : ℝ) / 2) * (64 * (Real.exp 1 * X ^ ((n : ℝ) / 2) * Real.exp (-t / c₁))) := by
          gcongr
      _ = (64 * A * Real.exp 1) * (X ^ ((n : ℝ) / 2) * X ^ ((n : ℝ) / 2)) * Real.exp (-t / c₁) := by
          ring
      _ = (64 * A * Real.exp 1) * X ^ n * Real.exp (-t / c₁) := by
          rw [hX_half_mul]
      _ ≤ c₁ * X ^ n * Real.exp (-t / c₁) := by
          gcongr
  refine ⟨c₁, hc₁_pos, ?_⟩
  intro X hX
  set s : ℝ := X ^ ((n : ℝ) / 2)
  set M : ℕ := ⌊(n : ℝ) * Real.log X / Real.log 2⌋₊
  have hs_ge_one : 1 ≤ s := Real.one_le_rpow (le_of_lt hX) (by positivity)
  have h_SJ_bound : (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
      (Ideal.absNorm J : ℝ) ≤ s} : ℝ) ≤ C₁ * s := hC₁ s hs_ge_one
  have hlogX_pos : 0 < Real.log X := Real.log_pos hX
  have h_arg_nonneg : 0 ≤ (n : ℝ) * Real.log X / Real.log 2 := by positivity
  have hM_le : (M : ℝ) ≤ (n : ℝ) * Real.log X / Real.log 2 := Nat.floor_le h_arg_nonneg
  have hM_bound : ((M + 1 : ℕ) : ℝ) ≤ ((n : ℝ) / Real.log 2 + 1) * (Real.log X + 1) := by
    push_cast
    have h_div_nonneg : 0 ≤ (n : ℝ) / Real.log 2 := by positivity
    have h_eq : (n : ℝ) * Real.log X / Real.log 2 = ((n : ℝ) / Real.log 2) * Real.log X := by ring
    nlinarith
  have hlog_le : (n : ℝ) * Real.log X ≤ (n : ℝ) * (Real.log X + 1) := by
    have : Real.log X ≤ Real.log X + 1 := by linarith
    gcongr
  calc (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            2 ≤ pm.2 ∧ (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ X ^ n},
          Real.log (Ideal.absNorm pm.1.1.asIdeal))
      ≤ (Nat.card {J : Ideal (NumberField.RingOfIntegers K) //
          (Ideal.absNorm J : ℝ) ≤ s} : ℝ) * ((M + 1 : ℕ) : ℝ) * ((n : ℝ) * Real.log X) := h_s4 X hX
    _ ≤ (C₁ * s) * (((n : ℝ) / Real.log 2 + 1) * (Real.log X + 1)) * ((n : ℝ) * (Real.log X + 1)) := by
        gcongr
    _ = A * s * (Real.log X + 1) ^ 2 := by
        dsimp [A, c_id]
        ring
    _ ≤ c₁ * X ^ n * Real.exp (-Real.sqrt (Real.log X) / c₁) := h_s5 X hX

theorem mitsui_principalPrimeIdeals_char_decoupled_log_cell_sub_primePower_le {K : Type u} [Field K] [NumberField K]
    (X : ℝ)
    (m : ℕ)
    (w₀ : NumberField.InfinitePlace K)
    (k : NumberField.InfinitePlace K → Fin m)
    (Y : ℝ) (hY : Y ≤ X ^ (Module.finrank ℚ K))
    (B : ℝ) (hB₀ : 0 ≤ B)
    (hB : ∀ (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (ν : ℕ),
      2 ≤ ν →
      (Nat.card {x : NumberField.RingOfIntegers K //
          Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = p.asIdeal ^ ν ∧
          ∀ w : NumberField.InfinitePlace K,
            Real.log (w (x : K) / w₀ (x : K)) ∈
              Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℝ) ≤ B)
    (q : Ideal (NumberField.RingOfIntegers K)) (hq : q ≠ 0)
    (ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ) :
    ‖(∑' p : {p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) //
          ∃ h : p.asIdeal.IsPrincipal,
          (Ideal.absNorm p.asIdeal : ℝ) ≤ Y ∧
          IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ p.asIdeal h))},
        (Nat.card {π : NumberField.RingOfIntegers K //
            Ideal.span ({π} : Set (NumberField.RingOfIntegers K)) = p.1.asIdeal ∧
            ∀ w : NumberField.InfinitePlace K,
              Real.log (w (π : K) / w₀ (π : K)) ∈
                Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                  (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℂ) *
          (ψ (Additive.ofMul p.2.choose_spec.2.unit) *
            (Real.log (Ideal.absNorm p.1.asIdeal) : ℂ)))
      - (∑' pm : {pm : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) × ℕ //
            1 ≤ pm.2 ∧
            ∃ h : (pm.1.asIdeal ^ pm.2).IsPrincipal,
            (Ideal.absNorm pm.1.asIdeal : ℝ) ^ pm.2 ≤ Y ∧
            IsUnit (Ideal.Quotient.mk q (@Submodule.IsPrincipal.generator _ _ _ _ _ (pm.1.asIdeal ^ pm.2) h))},
          (Nat.card {x : NumberField.RingOfIntegers K //
              Ideal.span ({x} : Set (NumberField.RingOfIntegers K)) = pm.1.1.asIdeal ^ pm.1.2 ∧
              ∀ w : NumberField.InfinitePlace K,
                Real.log (w (x : K) / w₀ (x : K)) ∈
                  Set.Ioc (Real.log X * ((((k w : ℕ) : ℝ) - (m : ℝ)) / (m : ℝ)))
                    (Real.log X * ((((k w : ℕ) : ℝ) + 1 - (m : ℝ)) / (m : ℝ)))} : ℂ) *
            (ψ (Additive.ofMul pm.2.2.choose_spec.2.unit) *
