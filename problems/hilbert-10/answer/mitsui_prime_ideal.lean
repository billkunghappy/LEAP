          intro i
          rw [← hσ_i i]
          have h1 := hd_step i
          linarith
        exact h_ray k' k (-d) hd_ge hd_step'
      · have hd_ge : 1 ≤ d := by omega
        exact h_ray k k' d hd_ge hd_step
