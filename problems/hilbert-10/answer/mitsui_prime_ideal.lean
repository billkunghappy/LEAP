                  |(∑' p : NumberField.InfinitePlace K → Fin l,
                      (if (p w₀ : ℕ) + 1 = l then (1 : ℝ) else 0) *
                        (∏ w : NumberField.InfinitePlace K,
                          (MeasureTheory.volume {q : ℝ × ℝ |
                            (w = w₀ ∧
                              q.1 ∈ Set.Ioo (0 : ℝ) 1 ∧
                              ((∃ hw : w.IsReal,
                                  (q.2 ∈ Set.Ioo (0 : ℝ) 1 ∧
                                    R₁ ∈
                                      Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                        ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1))) ∨
                                  (q.2 ∈ Set.Ioo (1 : ℝ) 2 ∧
                                    -R₁ ∈
                                      Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                        ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)))) ∨
                                (∃ hc : w.IsComplex,
                                  q.2 ∈ Set.Ioo (-Real.pi) Real.pi ∧
                                  R₁ * Real.cos q.2 ∈
                                    Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ)))
                                      ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 0)) : ℕ) : ℝ) - (m : ℝ) + 1)) ∧
                                  R₁ * Real.sin q.2 ∈
                                    Set.Ico ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ)))
                                      ((X / (m : ℝ)) * (((k (Sum.inr (⟨w, hc⟩, 1)) : ℕ) : ℝ) - (m : ℝ) + 1))))) ∨
                            (w ≠ w₀ ∧
                              q.1 ∈
                                Set.Ioc (Real.log X * ((((p w : ℕ) : ℝ) - (l : ℝ)) / (l : ℝ)))
                                  (Real.log X * ((((p w : ℕ) : ℝ) + 1 - (l : ℝ)) / (l : ℝ))) ∧
                              ((∃ hw : w.IsReal,
                                  (q.2 ∈ Set.Ioo (0 : ℝ) 1 ∧
                                    R₁ * Real.exp q.1 ∈
                                      Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                        ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1))) ∨
                                  (q.2 ∈ Set.Ioo (1 : ℝ) 2 ∧
                                    -(R₁ * Real.exp q.1) ∈
                                      Set.Ico ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ)))
                                        ((X / (m : ℝ)) * (((k (Sum.inl ⟨w, hw⟩) : ℕ) : ℝ) - (m : ℝ) + 1)))) ∨
