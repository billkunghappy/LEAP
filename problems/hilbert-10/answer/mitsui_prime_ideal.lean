theorem mitsui_unitRank_ideal_norm_theta_inversion {K : Type u} [Field K] [NumberField K] :
    let J_K : ℝ → ℝ := fun a =>
      ∫ y : Fin (NumberField.Units.rank K) → ℝ,
        Real.exp (-a *
          ∑ w : NumberField.InfinitePlace K,
            (w.mult : ℝ) * ∏ i : Fin (NumberField.Units.rank K),
              (w ((NumberField.Units.fundSystem K i : NumberField.RingOfIntegers K) : K)) ^ (2 * y i))
    ∀ u ∈ Set.Ioi (1 : ℝ),
      (∑' m : ℕ,
        (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0 ∧ Ideal.absNorm I = m} : ℝ) *
          J_K (Real.pi * (|(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) * ((m : ℝ) * u⁻¹)) ^ (2 / (Module.finrank ℚ K : ℝ)))) =
        u *
          (∑' m : ℕ,
            (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // I ≠ 0 ∧ Ideal.absNorm I = m} : ℝ) *
              J_K (Real.pi * (|(NumberField.discr K : ℝ)| ^ (-1 / 2 : ℝ) * ((m : ℝ) * u)) ^ (2 / (Module.finrank ℚ K : ℝ)))) +
          ((NumberField.classNumber K : ℝ) / (NumberField.Units.torsionOrder K : ℝ)) * (u - 1) :=
by
  classical
  let R := NumberField.RingOfIntegers K
  let n : ℕ := Module.finrank ℚ K
  let r : ℕ := NumberField.Units.rank K
  let D : ℝ := |(NumberField.discr K : ℝ)|
  let Cube : Set (Fin r → ℝ) := Set.pi Set.univ (fun _ => Set.Ico (0 : ℝ) 1)
  intro J_K u hu
  have hu1 : 1 < u := Set.mem_Ioi.mp hu
  have hu_pos : 0 < u := lt_trans zero_lt_one hu1
  have hu_inv_pos : 0 < u⁻¹ := inv_pos.mpr hu_pos
  have hD_pos : 0 < D := by
