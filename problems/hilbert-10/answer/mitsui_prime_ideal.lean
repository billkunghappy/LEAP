theorem mitsui_primitive_ray_char_dual_class_and_gauss_sum {K : Type u} [Field K] [NumberField K]
    (f : Ideal (NumberField.RingOfIntegers K)) (hf : f ≠ 0)
    (χ₀ : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ)
    (hχ₀_norm_supp : ∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤ → ‖χ₀ I‖ = 1) ∧
      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤) → χ₀ I = 0))
    (J_rep : ClassGroup (NumberField.RingOfIntegers K) → nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)))
    (hJ_cls : ∀ C : ClassGroup (NumberField.RingOfIntegers K), ClassGroup.mk0 (J_rep C) = C⁻¹)
    (hJ_cop : ∀ C : ClassGroup (NumberField.RingOfIntegers K), (J_rep C : Ideal (NumberField.RingOfIntegers K)) ⊔ f = ⊤)
    (ψ_f : (NumberField.RingOfIntegers K ⧸ f) → ℂ)
    (hψ_one : ψ_f 1 = 1)
    (hψ_mul : ∀ a b : NumberField.RingOfIntegers K ⧸ f, ψ_f (a * b) = ψ_f a * ψ_f b)
    (hψ_unit : ∀ a : NumberField.RingOfIntegers K ⧸ f, (IsUnit a → ‖ψ_f a‖ = 1) ∧ (¬ IsUnit a → ψ_f a = 0))
    (hψ_span : ∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
      χ₀ ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
        mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ =
        ψ_f (Ideal.Quotient.mk f x))
    (hψ_prim : ∀ f' : Ideal (NumberField.RingOfIntegers K), f ≤ f' → f' ≠ f →
      ∃ x : NumberField.RingOfIntegers K, IsUnit (Ideal.Quotient.mk f x) ∧ x - 1 ∈ f' ∧ ψ_f (Ideal.Quotient.mk f x) ≠ 1)
    (hψ_zero : (f ≠ ⊤ ∧ ψ_f 0 = 0 ∧
        ∀ (h_fin : Fintype (NumberField.RingOfIntegers K ⧸ f)),
          @Finset.sum (NumberField.RingOfIntegers K ⧸ f) ℂ _ (@Finset.univ (NumberField.RingOfIntegers K ⧸ f) h_fin) ψ_f = 0) ∨
      (f = ⊤ ∧ (∀ a : NumberField.RingOfIntegers K ⧸ f, ψ_f a = 1) ∧
        (∑ C : ClassGroup (NumberField.RingOfIntegers K), star (χ₀ (J_rep C))) = 0 ∧
        (∑ C : ClassGroup (NumberField.RingOfIntegers K), χ₀ (J_rep C)) = 0)) :
    let R := NumberField.RingOfIntegers K
    ∃ (σ : ClassGroup R ≃ ClassGroup R)
      (γ_C : ClassGroup R → R)
      (α_C : ClassGroup R → (R ⧸ f) → R)
      (Φ_C : ∀ C : ClassGroup R, ((R ⧸ f) × ((J_rep C : Ideal R) * f : Ideal R)) ≃ (J_rep C : Ideal R))
      (ω_χ : ℂ),
      ‖ω_χ‖ = 1 ∧
      (∀ C : ClassGroup R, γ_C C ≠ 0 ∧
        differentIdeal ℤ R * f * (J_rep C : Ideal R) * (J_rep (σ C) : Ideal R) =
          Ideal.span ({γ_C C} : Set R)) ∧
      (∀ (C : ClassGroup R) (a : R ⧸ f),
        Ideal.Quotient.mk f (α_C C a) = a ∧
        ∀ m : ((J_rep C : Ideal R) * f : Ideal R),
          ((Φ_C C (a, m)).1 : R) = α_C C a + m.1) ∧
      (∀ (C : ClassGroup R) (x_star : (J_rep (σ C) : Ideal R)),
        star (χ₀ (J_rep C)) *
          ((((Ideal.absNorm f : ℝ) ^ (-1 / 2 : ℝ) : ℝ) : ℂ) *
            ∑' a : R ⧸ f,
              ψ_f a *
                Complex.exp (2 * Real.pi * Complex.I *
                  (Algebra.trace ℚ K ((α_C C a : K) * (x_star.1 : K) / (γ_C C : K)) : ℂ))) =
        ω_χ * χ₀ (J_rep (σ C)) * star (ψ_f (Ideal.Quotient.mk f x_star.1))) :=
by
  classical
  let _ := hψ_zero
  intro R
  haveI : Finite (R ⧸ f) := Ideal.finiteQuotientOfFreeOfNeBot f hf
  letI : Fintype (R ⧸ f) := Fintype.ofFinite (R ⧸ f)
  
  have h_s1 : ∀ (J : Ideal R), J ⊔ f = ⊤ →
      ∃ (α : (R ⧸ f) → R)
        (Φ : ((R ⧸ f) × (J * f : Ideal R)) ≃ J),
        (∀ a : R ⧸ f, α a ∈ J ∧ Ideal.Quotient.mk f (α a) = a) ∧
        (∀ (a : R ⧸ f) (m : (J * f : Ideal R)),
          ((Φ (a, m)).1 : R) = α a + m.1) := by
    intro J hJ_cop
    have h1_mem : (1 : R) ∈ J ⊔ f := (Ideal.eq_top_iff_one (J ⊔ f)).mp hJ_cop
    obtain ⟨u_J, hu_J, v_f, hv_f, huv⟩ := Submodule.mem_sup.mp h1_mem
    have hu_mk : Ideal.Quotient.mk f u_J = 1 := by
      have h_ap := congrArg (Ideal.Quotient.mk f) huv
      rw [map_add, map_one, Ideal.Quotient.eq_zero_iff_mem.mpr hv_f, add_zero] at h_ap
      exact h_ap
    let r_lift : (R ⧸ f) → R := fun a => (Ideal.Quotient.mk_surjective a).choose
    have hr_lift : ∀ a : R ⧸ f, Ideal.Quotient.mk f (r_lift a) = a :=
      fun a => (Ideal.Quotient.mk_surjective a).choose_spec
    let α : (R ⧸ f) → R := fun a => r_lift a * u_J
    have hα_mem : ∀ a : R ⧸ f, α a ∈ J :=
      fun a => Ideal.mul_mem_left J (r_lift a) hu_J
    have hα_mk : ∀ a : R ⧸ f, Ideal.Quotient.mk f (α a) = a := by
      intro a
      dsimp [α]
      rw [map_mul, hr_lift a, hu_mk, mul_one]
    have h_mul_eq_inf : J * f = J ⊓ f := Ideal.mul_eq_inf_of_coprime hJ_cop
    have h_sub_mem : ∀ x : J, x.1 - α (Ideal.Quotient.mk f x.1) ∈ (J * f : Ideal R) := by
      intro x
      rw [h_mul_eq_inf, Submodule.mem_inf]
      refine ⟨J.sub_mem x.2 (hα_mem _), ?_⟩
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hα_mk, sub_self]
    let Φ : ((R ⧸ f) × (J * f : Ideal R)) ≃ J :=
      { toFun := fun p => ⟨α p.1 + p.2.1, J.add_mem (hα_mem p.1) (Ideal.mul_le_right p.2.2)⟩
        invFun := fun x => (Ideal.Quotient.mk f x.1, ⟨x.1 - α (Ideal.Quotient.mk f x.1), h_sub_mem x⟩)
        left_inv := by
          rintro ⟨a, m⟩
          have hm_f : m.1 ∈ f := Ideal.mul_le_left m.2
          have h_mk : Ideal.Quotient.mk f (α a + m.1) = a := by
            rw [map_add, hα_mk a, Ideal.Quotient.eq_zero_iff_mem.mpr hm_f, add_zero]
          refine Prod.ext h_mk (Subtype.ext ?_)
          dsimp
          rw [h_mk, add_sub_cancel_left]
        right_inv := by
          intro x
          exact Subtype.ext (add_sub_cancel (α (Ideal.Quotient.mk f x.1)) x.1) }
    exact ⟨α, Φ, fun a => ⟨hα_mem a, hα_mk a⟩, fun a m => rfl⟩
  
  have h_s2 :
      ∃ (σ : ClassGroup R ≃ ClassGroup R)
        (γ_C : ClassGroup R → R)
        (B₀ : nonZeroDivisors (Ideal R))
        (γ₀ : R)
        (c₁ c₂ : ClassGroup R → R),
        (B₀ : Ideal R) ⊔ f = ⊤ ∧
        γ₀ ≠ 0 ∧
        differentIdeal ℤ R * f * (B₀ : Ideal R) = Ideal.span ({γ₀} : Set R) ∧
        ‖χ₀ B₀‖ = 1 ∧
        (∀ C : ClassGroup R, γ_C C ≠ 0 ∧
          differentIdeal ℤ R * f * (J_rep C : Ideal R) * (J_rep (σ C) : Ideal R) =
            Ideal.span ({γ_C C} : Set R)) ∧
        (∀ C : ClassGroup R,
          c₁ C ∈ (B₀ : Ideal R) ∧
          γ_C C * c₁ C = γ₀ * c₂ C ∧
          IsUnit (Ideal.Quotient.mk f (c₁ C)) ∧
          IsUnit (Ideal.Quotient.mk f (c₂ C)) ∧
          star (χ₀ (J_rep C)) * ψ_f (Ideal.Quotient.mk f (c₂ C)) *
            star (ψ_f (Ideal.Quotient.mk f (c₁ C))) =
            star (χ₀ B₀) * χ₀ (J_rep (σ C))) := by
    have hd_norm : Ideal.absNorm (differentIdeal ℤ R) = (NumberField.discr K).natAbs :=
      NumberField.absNorm_differentIdeal K R
    have hd_ne : differentIdeal ℤ R ≠ 0 := by
      intro h0
      have h_abs : Ideal.absNorm (differentIdeal ℤ R) = 0 :=
        Ideal.absNorm_eq_zero_iff.mpr h0
      rw [hd_norm] at h_abs
      exact Int.natAbs_ne_zero.mpr (NumberField.discr_ne_zero K) h_abs
    let I_Df : nonZeroDivisors (Ideal R) :=
      ⟨differentIdeal ℤ R * f, mem_nonZeroDivisors_of_ne_zero (mul_ne_zero hd_ne hf)⟩
    let C₀ : ClassGroup R := ClassGroup.mk0 I_Df
    let σ : ClassGroup R ≃ ClassGroup R :=
      (Equiv.inv (ClassGroup R)).trans (Equiv.mulLeft C₀)
    let P_C : ClassGroup R → nonZeroDivisors (Ideal R) :=
      fun C => I_Df * J_rep C * J_rep (σ C)
    have h_mk0_P : ∀ C : ClassGroup R, ClassGroup.mk0 (P_C C) = 1 := by
      intro C
      dsimp [P_C]
      rw [map_mul, map_mul, hJ_cls C, hJ_cls (σ C)]
      change C₀ * C⁻¹ * (C₀ * C⁻¹)⁻¹ = 1
      exact mul_inv_cancel (C₀ * C⁻¹)
    have h_prin : ∀ C : ClassGroup R, ((P_C C : nonZeroDivisors (Ideal R)) : Ideal R).IsPrincipal :=
      fun C => (ClassGroup.mk0_eq_one_iff (P_C C).2).mp (h_mk0_P C)
    let γ_C : ClassGroup R → R := fun C =>
      @Submodule.IsPrincipal.generator _ _ _ _ _ ((P_C C : nonZeroDivisors (Ideal R)) : Ideal R) (h_prin C)
    have h_span_C : ∀ C : ClassGroup R,
        differentIdeal ℤ R * f * (J_rep C : Ideal R) * (J_rep (σ C) : Ideal R) =
          Ideal.span ({γ_C C} : Set R) := by
      intro C
      exact (@Submodule.IsPrincipal.span_singleton_generator _ _ _ _ _
        ((P_C C : nonZeroDivisors (Ideal R)) : Ideal R) (h_prin C)).symm
    have hγ_C_ne : ∀ C : ClassGroup R, γ_C C ≠ 0 := by
      intro C h0
      have hP_ne : ((P_C C : nonZeroDivisors (Ideal R)) : Ideal R) ≠ 0 :=
        nonZeroDivisors.coe_ne_zero (P_C C)
      apply hP_ne
      change differentIdeal ℤ R * f * (J_rep C : Ideal R) * (J_rep (σ C) : Ideal R) = ⊥
      rw [h_span_C C, h0, Ideal.span_singleton_zero]
    have h_comp : ∀ I : nonZeroDivisors (Ideal R),
        ∃ (M₀ : nonZeroDivisors (Ideal R)) (c₀ : R),
          c₀ ≠ 0 ∧
          (M₀ : Ideal R) ⊔ f = ⊤ ∧
          (I : Ideal R) * (M₀ : Ideal R) = Ideal.span ({c₀} : Set R) := by
      intro I
      have hI : (I : Ideal R) ≠ 0 := nonZeroDivisors.coe_ne_zero I
      by_cases hI_top : (I : Ideal R) = ⊤
      · refine ⟨1, 1, one_ne_zero, ?_, ?_⟩
        · rw [Submonoid.coe_one, Ideal.one_eq_top, top_sup_eq]
        · rw [Submonoid.coe_one, Ideal.one_eq_top, hI_top, Ideal.mul_top, Ideal.span_singleton_one]
      · set J₀ : Ideal R := (I : Ideal R) * ((I : Ideal R) * f)
        have hJ₀_ne : J₀ ≠ 0 := mul_ne_zero hI (mul_ne_zero hI hf)
        obtain ⟨c₀, hc₀_sup⟩ := IsDedekindDomain.exists_sup_span_eq Ideal.mul_le_right hJ₀_ne
        have hc₀_ne : c₀ ≠ 0 := by
          intro hc₀_zero
          rw [hc₀_zero, Ideal.span_singleton_zero, sup_bot_eq] at hc₀_sup
          have h_eq : (I : Ideal R) * ((I : Ideal R) * f) = (I : Ideal R) * ⊤ := by
            rw [Ideal.mul_top]
            exact hc₀_sup
          have hIf_top : (I : Ideal R) * f = ⊤ := mul_left_cancel₀ hI h_eq
          have hI_ge_top : ⊤ ≤ (I : Ideal R) := hIf_top ▸ Ideal.mul_le_right
          exact hI_top (top_le_iff.mp hI_ge_top)
        have hc₀_le : Ideal.span ({c₀} : Set R) ≤ (I : Ideal R) :=
          le_sup_right.trans hc₀_sup.le
        obtain ⟨M₁, hM₁_mul⟩ := Ideal.dvd_iff_le.mpr hc₀_le
        have hspan_ne : Ideal.span ({c₀} : Set R) ≠ 0 :=
          Ideal.span_singleton_eq_bot.not.mpr hc₀_ne
