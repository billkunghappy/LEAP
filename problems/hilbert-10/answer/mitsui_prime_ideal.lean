    have hψ_fund : ∀ j : Fin r,
        ψ_w (NumberField.Units.fundSystem K j) =
          Complex.exp ((α w j : ℂ) * Complex.I) := by
      intro j
      let η_j : K := (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)
      have hη_ne : η_j ≠ 0 :=
        NumberField.RingOfIntegers.coe_ne_zero_iff.mpr (Units.ne_zero _)
      have hwη_ne : (w η_j : ℂ) ≠ 0 :=
        Complex.ofReal_ne_zero.mpr (ne_of_gt (w.pos_iff.mpr hη_ne))
      have h_polar := Complex.norm_mul_exp_arg_mul_I (w.embedding η_j)
      rw [NumberField.InfinitePlace.norm_embedding_eq w η_j] at h_polar
      dsimp [ψ_w, α]
      change w.embedding η_j / (w η_j : ℂ) = Complex.exp (((w.embedding η_j).arg : ℂ) * Complex.I)
      conv_lhs => rw [← h_polar]
      exact mul_div_cancel_left₀ _ hwη_ne
    have hψ_ζ : ψ_w (ζ : (NumberField.RingOfIntegers K)ˣ) =
        w.embedding (((ζ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) := by
      dsimp [ψ_w]
      have hw1 : w (((ζ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) = 1 :=
        (NumberField.Units.mem_torsion K).mp ζ.2 w
      rw [hw1, Complex.ofReal_one, div_one]
    have hu_ψ : ψ_w u =
        w.embedding (((ζ : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) *
          Complex.exp (((∑ j : Fin r, (d j : ℝ) * α w j) : ℝ) * Complex.I) := by
      have h1 := congrArg ψ_w hu_eq
      rw [map_mul, hψ_ζ, map_prod] at h1
      rw [h1]
      congr 1
      have hprod : (∏ j : Fin r, ψ_w ((NumberField.Units.fundSystem K j) ^ (d j))) =
          ∏ j : Fin r, Complex.exp (((d j : ℝ) * α w j : ℝ) * Complex.I) := by
