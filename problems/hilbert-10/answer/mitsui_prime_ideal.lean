    rw [h_rearrange, h_inv u hu]
    have h_u1 : ((u ^ (1 : ℝ) : ℝ) : ℂ) = (u : ℂ) ^ (1 : ℂ) := by
      rw [Complex.ofReal_cpow hu_nn]; simp
    rw [h_u1]
    have h_exp1 : (u : ℂ) ^ (-s) * (u : ℂ) ^ (1 : ℂ) = (u : ℂ) ^ (1 - s) := by
      rw [← Complex.cpow_add _ _ hu_c_ne]
      congr 1; ring
    rw [h_exp1]
  have h_img : (fun u : ℝ => u⁻¹) '' Set.Ioi (1 : ℝ) = Set.Ioo (0 : ℝ) 1 := by
    rw [Set.image_inv_eq_inv, Set.inv_Ioi₀ zero_lt_one, inv_one]
  have h_deriv : ∀ u ∈ Set.Ioi (1 : ℝ),
      HasDerivWithinAt (fun x : ℝ => x⁻¹) (-(u ^ 2)⁻¹) (Set.Ioi (1 : ℝ)) u := by
    intro u hu
    have hu_pos : 0 < u := lt_trans zero_lt_one hu
    exact (hasDerivAt_inv (ne_of_gt hu_pos)).hasDerivWithinAt
  have hg_int_Ioo : MeasureTheory.IntegrableOn g (Set.Ioo (0 : ℝ) 1) MeasureTheory.volume := by
    rw [← h_img, MeasureTheory.integrableOn_image_iff_integrableOn_abs_deriv_smul
      measurableSet_Ioi h_deriv inv_injective.injOn]
    exact hh_int_Ioi.congr_fun (fun u hu => (h_jac u hu).symm) measurableSet_Ioi
  have h_int_eq_Ioo : (∫ u in Set.Ioo (0 : ℝ) 1, g u) = ∫ u in Set.Ioi (1 : ℝ), h u := by
    rw [← h_img, MeasureTheory.integral_image_eq_integral_abs_deriv_smul
      measurableSet_Ioi h_deriv inv_injective.injOn]
    exact MeasureTheory.setIntegral_congr_fun measurableSet_Ioi h_jac
  have hg_int_Ioc : MeasureTheory.IntegrableOn g (Set.Ioc (0 : ℝ) 1) MeasureTheory.volume :=
    (MeasureTheory.integrableOn_congr_set_ae MeasureTheory.Ioo_ae_eq_Ioc).mp hg_int_Ioo
  have h_union : Set.Ioc (0 : ℝ) 1 ∪ Set.Ioi (1 : ℝ) = Set.Ioi (0 : ℝ) :=
    Set.Ioc_union_Ioi_eq_Ioi zero_le_one
  change (∫ u in Set.Ioi (0 : ℝ), g u) = ∫ u in Set.Ioi (1 : ℝ), (g u + h u)
  rw [← h_union, MeasureTheory.setIntegral_union Set.Ioc_disjoint_Ioi_same measurableSet_Ioi hg_int_Ioc hg_int_Ioi]
  rw [← MeasureTheory.setIntegral_congr_set MeasureTheory.Ioo_ae_eq_Ioc, h_int_eq_Ioo, add_comm]
  exact (MeasureTheory.integral_add hg_int_Ioi hh_int_Ioi).symm

theorem mitsui_hecke_char_theta_integral_differentiable_and_strip_norm_le (Φ₁ Φ₂ : ℝ → ℂ) (Ψ : ℝ → ℝ)
    (hΦ₁_cont : ContinuousOn Φ₁ (Set.Ioi (1 : ℝ)))
    (hΦ₂_cont : ContinuousOn Φ₂ (Set.Ioi (1 : ℝ)))
    (hΨ_nn : ∀ u ∈ Set.Ioi (1 : ℝ), 0 ≤ Ψ u)
    (hΦ_le : ∀ u ∈ Set.Ioi (1 : ℝ), ‖Φ₁ u‖ ≤ Ψ u ∧ ‖Φ₂ u‖ ≤ Ψ u)
    (hΨ_int : ∀ σ : ℝ, MeasureTheory.IntegrableOn (fun u : ℝ => u ^ σ * Ψ u) (Set.Ioi (1 : ℝ)) MeasureTheory.volume) :
    Differentiable ℂ (fun s : ℂ =>
      ∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s * Φ₁ u + (u : ℂ) ^ (1 - s) * Φ₂ u)) ∧
    (∀ s : ℂ, -1 / 2 ≤ s.re → s.re ≤ 2 →
      ‖∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s * Φ₁ u + (u : ℂ) ^ (1 - s) * Φ₂ u)‖ ≤
        2 * ∫ u in Set.Ioi (1 : ℝ), u ^ (2 : ℝ) * Ψ u) :=
by
  set μ : MeasureTheory.Measure ℝ := MeasureTheory.volume.restrict (Set.Ioi (1 : ℝ))
  have hΦ₁_meas : MeasureTheory.AEStronglyMeasurable Φ₁ μ :=
    hΦ₁_cont.aestronglyMeasurable measurableSet_Ioi
  have hΦ₂_meas : MeasureTheory.AEStronglyMeasurable Φ₂ μ :=
    hΦ₂_cont.aestronglyMeasurable measurableSet_Ioi
  have h_cpow_meas : ∀ z : ℂ, MeasureTheory.AEStronglyMeasurable (fun u : ℝ => (u : ℂ) ^ z) μ := by
    intro z
    refine ContinuousOn.aestronglyMeasurable ?_ measurableSet_Ioi
    intro u hu
    have hu_pos : 0 < u := lt_trans zero_lt_one (Set.mem_Ioi.mp hu)
    exact (Complex.continuous_ofReal.continuousAt.cpow continuousAt_const
      (Complex.ofReal_mem_slitPlane.mpr hu_pos)).continuousWithinAt
  have h_clog_meas : MeasureTheory.AEStronglyMeasurable (fun u : ℝ => Complex.log (u : ℂ)) μ := by
    refine ContinuousOn.aestronglyMeasurable ?_ measurableSet_Ioi
    intro u hu
    have hu_pos : 0 < u := lt_trans zero_lt_one (Set.mem_Ioi.mp hu)
    exact (Complex.continuous_ofReal.continuousAt.clog
      (Complex.ofReal_mem_slitPlane.mpr hu_pos)).continuousWithinAt
  refine ⟨?_, ?_⟩
  · intro s₀
    let F : ℂ → ℝ → ℂ := fun s u => (u : ℂ) ^ s * Φ₁ u + (u : ℂ) ^ (1 - s) * Φ₂ u
    let F' : ℂ → ℝ → ℂ := fun s u =>
      ((u : ℂ) ^ s * Complex.log (u : ℂ)) * Φ₁ u -
        ((u : ℂ) ^ (1 - s) * Complex.log (u : ℂ)) * Φ₂ u
    have hF_meas : ∀ s : ℂ, MeasureTheory.AEStronglyMeasurable (F s) μ := by
      intro s
      exact ((h_cpow_meas s).mul hΦ₁_meas).add ((h_cpow_meas (1 - s)).mul hΦ₂_meas)
    have hF'_meas : MeasureTheory.AEStronglyMeasurable (F' s₀) μ :=
      (((h_cpow_meas s₀).mul h_clog_meas).mul hΦ₁_meas).sub
        (((h_cpow_meas (1 - s₀)).mul h_clog_meas).mul hΦ₂_meas)
    set N : ℝ := |s₀.re| + 3
    let bound : ℝ → ℝ := fun u => (2 : ℝ) * (u ^ N * Ψ u)
    have h_bound_int : MeasureTheory.Integrable bound μ := (hΨ_int N).const_mul 2
    have hFs₀_int : MeasureTheory.Integrable (F s₀) μ := by
      refine h_bound_int.mono' (hF_meas s₀) ?_
      filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioi] with u hu
      have hu_gt : 1 < u := Set.mem_Ioi.mp hu
      have hu_pos : 0 < u := by linarith
      have hu_ge : 1 ≤ u := by linarith
      have hΨ_u : 0 ≤ Ψ u := hΨ_nn u hu
      have hΦ₁_u : ‖Φ₁ u‖ ≤ Ψ u := (hΦ_le u hu).1
      have hΦ₂_u : ‖Φ₂ u‖ ≤ Ψ u := (hΦ_le u hu).2
      have hs₀_re : s₀.re ≤ N := by
        have : s₀.re ≤ |s₀.re| := le_abs_self s₀.re
        dsimp [N]; linarith
      have h1s₀_re : (1 - s₀).re ≤ N := by
        rw [Complex.sub_re, Complex.one_re]
        have : -s₀.re ≤ |s₀.re| := neg_le_abs s₀.re
        dsimp [N]; linarith
      have h_us : ‖(u : ℂ) ^ s₀‖ ≤ u ^ N := by
        rw [Complex.norm_cpow_eq_rpow_re_of_pos hu_pos s₀]
        exact Real.rpow_le_rpow_of_exponent_le hu_ge hs₀_re
      have h_u1s : ‖(u : ℂ) ^ (1 - s₀)‖ ≤ u ^ N := by
        rw [Complex.norm_cpow_eq_rpow_re_of_pos hu_pos (1 - s₀)]
        exact Real.rpow_le_rpow_of_exponent_le hu_ge h1s₀_re
      have h_t1 : ‖(u : ℂ) ^ s₀ * Φ₁ u‖ ≤ u ^ N * Ψ u := by
        rw [norm_mul]
        exact mul_le_mul h_us hΦ₁_u (norm_nonneg _) (Real.rpow_nonneg (le_of_lt hu_pos) N)
      have h_t2 : ‖(u : ℂ) ^ (1 - s₀) * Φ₂ u‖ ≤ u ^ N * Ψ u := by
        rw [norm_mul]
        exact mul_le_mul h_u1s hΦ₂_u (norm_nonneg _) (Real.rpow_nonneg (le_of_lt hu_pos) N)
      dsimp [F, bound]
      calc ‖(u : ℂ) ^ s₀ * Φ₁ u + (u : ℂ) ^ (1 - s₀) * Φ₂ u‖
          ≤ ‖(u : ℂ) ^ s₀ * Φ₁ u‖ + ‖(u : ℂ) ^ (1 - s₀) * Φ₂ u‖ := norm_add_le _ _
        _ ≤ u ^ N * Ψ u + u ^ N * Ψ u := add_le_add h_t1 h_t2
        _ = (2 : ℝ) * (u ^ N * Ψ u) := by ring
    have h_deriv : ∀ᵐ (u : ℝ) ∂μ, ∀ s ∈ Metric.ball s₀ 1, HasDerivAt (fun z => F z u) (F' s u) s := by
      filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioi] with u hu s _hs
      have hu_pos : 0 < u := lt_trans zero_lt_one (Set.mem_Ioi.mp hu)
      have hu_c_ne : (u : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hu_pos)
      have hd1 : HasDerivAt (fun z : ℂ => (u : ℂ) ^ z) ((u : ℂ) ^ s * Complex.log (u : ℂ) * 1) s :=
        (hasDerivAt_id s).const_cpow (Or.inl hu_c_ne)
      have hd2 : HasDerivAt (fun z : ℂ => (u : ℂ) ^ (1 - z))
          ((u : ℂ) ^ (1 - s) * Complex.log (u : ℂ) * (0 - 1)) s :=
        ((hasDerivAt_const s (1 : ℂ)).sub (hasDerivAt_id s)).const_cpow (Or.inl hu_c_ne)
      have hd3 := (hd1.mul_const (Φ₁ u)).add (hd2.mul_const (Φ₂ u))
      dsimp [F, F']
      convert hd3 using 1
      ring
    have h_bound : ∀ᵐ (u : ℝ) ∂μ, ∀ s ∈ Metric.ball s₀ 1, ‖F' s u‖ ≤ bound u := by
      filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioi] with u hu s hs
      have hu_gt : 1 < u := Set.mem_Ioi.mp hu
      have hu_pos : 0 < u := by linarith
      have hu_ge : 1 ≤ u := by linarith
      have hΨ_u : 0 ≤ Ψ u := hΨ_nn u hu
      have hΦ₁_u : ‖Φ₁ u‖ ≤ Ψ u := (hΦ_le u hu).1
      have hΦ₂_u : ‖Φ₂ u‖ ≤ Ψ u := (hΦ_le u hu).2
      have hs_dist : ‖s - s₀‖ < 1 := by simpa [Metric.mem_ball, dist_eq_norm] using hs
      have hs_re_diff : |(s - s₀).re| ≤ 1 :=
        le_trans (Complex.abs_re_le_norm (s - s₀)) (le_of_lt hs_dist)
      have hs_re_sub : |s.re - s₀.re| ≤ 1 := by simpa [Complex.sub_re] using hs_re_diff
      have hs_re_le : s.re ≤ N - 1 := by
        have h1 : s.re - s₀.re ≤ 1 := (abs_le.mp hs_re_sub).2
        have h2 : s₀.re ≤ |s₀.re| := le_abs_self s₀.re
        dsimp [N]; linarith
      have h1s_re_le : (1 - s).re ≤ N - 1 := by
        rw [Complex.sub_re, Complex.one_re]
        have h1 : -1 ≤ s.re - s₀.re := (abs_le.mp hs_re_sub).1
        have h2 : -s₀.re ≤ |s₀.re| := neg_le_abs s₀.re
        dsimp [N]; linarith
      have h_us : ‖(u : ℂ) ^ s‖ ≤ u ^ (N - 1) := by
        rw [Complex.norm_cpow_eq_rpow_re_of_pos hu_pos s]
        exact Real.rpow_le_rpow_of_exponent_le hu_ge hs_re_le
      have h_u1s : ‖(u : ℂ) ^ (1 - s)‖ ≤ u ^ (N - 1) := by
        rw [Complex.norm_cpow_eq_rpow_re_of_pos hu_pos (1 - s)]
        exact Real.rpow_le_rpow_of_exponent_le hu_ge h1s_re_le
      have h_log_nn : 0 ≤ Real.log u := Real.log_nonneg hu_ge
      have h_clog_norm : ‖Complex.log (u : ℂ)‖ = Real.log u := by
        rw [← Complex.ofReal_log (le_of_lt hu_pos), Complex.norm_of_nonneg h_log_nn]
      have h_log_le : Real.log u ≤ u ^ (1 : ℝ) := by
        have h1 : Real.log u ≤ u - 1 := Real.log_le_sub_one_of_pos hu_pos
        rw [Real.rpow_one]
        linarith
      have h_rpow_combine : u ^ (N - 1) * u ^ (1 : ℝ) = u ^ N := by
        rw [← Real.rpow_add hu_pos]
        congr 1; ring
      have h_term1 : ‖(u : ℂ) ^ s * Complex.log (u : ℂ)‖ ≤ u ^ N := by
        rw [norm_mul, h_clog_norm, ← h_rpow_combine]
        exact mul_le_mul h_us h_log_le h_log_nn (Real.rpow_nonneg (le_of_lt hu_pos) _)
      have h_term2 : ‖(u : ℂ) ^ (1 - s) * Complex.log (u : ℂ)‖ ≤ u ^ N := by
        rw [norm_mul, h_clog_norm, ← h_rpow_combine]
        exact mul_le_mul h_u1s h_log_le h_log_nn (Real.rpow_nonneg (le_of_lt hu_pos) _)
      have h_t1 : ‖((u : ℂ) ^ s * Complex.log (u : ℂ)) * Φ₁ u‖ ≤ u ^ N * Ψ u := by
        rw [norm_mul]
        exact mul_le_mul h_term1 hΦ₁_u (norm_nonneg _) (Real.rpow_nonneg (le_of_lt hu_pos) N)
      have h_t2 : ‖((u : ℂ) ^ (1 - s) * Complex.log (u : ℂ)) * Φ₂ u‖ ≤ u ^ N * Ψ u := by
        rw [norm_mul]
        exact mul_le_mul h_term2 hΦ₂_u (norm_nonneg _) (Real.rpow_nonneg (le_of_lt hu_pos) N)
      dsimp [F', bound]
      calc ‖((u : ℂ) ^ s * Complex.log (u : ℂ)) * Φ₁ u -
            ((u : ℂ) ^ (1 - s) * Complex.log (u : ℂ)) * Φ₂ u‖
          ≤ ‖((u : ℂ) ^ s * Complex.log (u : ℂ)) * Φ₁ u‖ +
            ‖((u : ℂ) ^ (1 - s) * Complex.log (u : ℂ)) * Φ₂ u‖ := norm_sub_le _ _
        _ ≤ u ^ N * Ψ u + u ^ N * Ψ u := add_le_add h_t1 h_t2
        _ = (2 : ℝ) * (u ^ N * Ψ u) := by ring
    exact (hasDerivAt_integral_of_dominated_loc_of_deriv_le
      (Metric.ball_mem_nhds s₀ zero_lt_one)
      (Filter.Eventually.of_forall hF_meas)
      hFs₀_int hF'_meas h_bound h_bound_int h_deriv).2.differentiableAt
  · intro s hs1 hs2
    have h1s_re : (1 - s).re ≤ 2 := by
      rw [Complex.sub_re, Complex.one_re]
      linarith
    have h_int_dom :
        MeasureTheory.Integrable (fun u : ℝ => (2 : ℝ) * (u ^ (2 : ℝ) * Ψ u)) μ :=
      (hΨ_int (2 : ℝ)).const_mul 2
    have h_ae : ∀ᵐ (u : ℝ) ∂μ,
        ‖(u : ℂ) ^ s * Φ₁ u + (u : ℂ) ^ (1 - s) * Φ₂ u‖ ≤ (2 : ℝ) * (u ^ (2 : ℝ) * Ψ u) := by
      filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioi] with u hu
      have hu_gt : 1 < u := Set.mem_Ioi.mp hu
      have hu_pos : 0 < u := by linarith
      have hu_ge : 1 ≤ u := by linarith
      have hΦ₁_u : ‖Φ₁ u‖ ≤ Ψ u := (hΦ_le u hu).1
      have hΦ₂_u : ‖Φ₂ u‖ ≤ Ψ u := (hΦ_le u hu).2
      have h_us : ‖(u : ℂ) ^ s‖ ≤ u ^ (2 : ℝ) := by
        rw [Complex.norm_cpow_eq_rpow_re_of_pos hu_pos s]
        exact Real.rpow_le_rpow_of_exponent_le hu_ge hs2
      have h_u1s : ‖(u : ℂ) ^ (1 - s)‖ ≤ u ^ (2 : ℝ) := by
        rw [Complex.norm_cpow_eq_rpow_re_of_pos hu_pos (1 - s)]
        exact Real.rpow_le_rpow_of_exponent_le hu_ge h1s_re
      have h_t1 : ‖(u : ℂ) ^ s * Φ₁ u‖ ≤ u ^ (2 : ℝ) * Ψ u := by
        rw [norm_mul]
        exact mul_le_mul h_us hΦ₁_u (norm_nonneg _) (Real.rpow_nonneg (le_of_lt hu_pos) 2)
      have h_t2 : ‖(u : ℂ) ^ (1 - s) * Φ₂ u‖ ≤ u ^ (2 : ℝ) * Ψ u := by
        rw [norm_mul]
        exact mul_le_mul h_u1s hΦ₂_u (norm_nonneg _) (Real.rpow_nonneg (le_of_lt hu_pos) 2)
      calc ‖(u : ℂ) ^ s * Φ₁ u + (u : ℂ) ^ (1 - s) * Φ₂ u‖
          ≤ ‖(u : ℂ) ^ s * Φ₁ u‖ + ‖(u : ℂ) ^ (1 - s) * Φ₂ u‖ := norm_add_le _ _
        _ ≤ u ^ (2 : ℝ) * Ψ u + u ^ (2 : ℝ) * Ψ u := add_le_add h_t1 h_t2
        _ = (2 : ℝ) * (u ^ (2 : ℝ) * Ψ u) := by ring
    calc ‖∫ u in Set.Ioi (1 : ℝ), ((u : ℂ) ^ s * Φ₁ u + (u : ℂ) ^ (1 - s) * Φ₂ u)‖
        ≤ ∫ u in Set.Ioi (1 : ℝ), (2 : ℝ) * (u ^ (2 : ℝ) * Ψ u) :=
          MeasureTheory.norm_integral_le_of_norm_le h_int_dom h_ae
      _ = 2 * ∫ u in Set.Ioi (1 : ℝ), u ^ (2 : ℝ) * Ψ u :=
          MeasureTheory.integral_const_mul (2 : ℝ) (fun u : ℝ => u ^ (2 : ℝ) * Ψ u)

theorem mitsui_grossenchar_heckeL_completed_entire_and_mellin_bound {K : Type u} [Field K] [NumberField K] :
    ∃ C₀ : ℝ, 0 < C₀ ∧
      ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
        ∀ w₀ : NumberField.InfinitePlace K,
          ∀ a₀ : ℕ, a₀ < NumberField.Units.torsionOrder K →
            ∀ θ₀ : Fin (NumberField.Units.rank K) → ℝ,
              (∀ j : Fin (NumberField.Units.rank K), 0 ≤ θ₀ j ∧ θ₀ j < 1) →
              ∀ (m_freq : Fin (NumberField.Units.rank K) → ℤ)
                (l_ang : NumberField.InfinitePlace K → ℤ),
                (∀ ζ ∈ NumberField.Units.torsion K,
                  (∏ w : NumberField.InfinitePlace K,
                    (w.embedding ((ζ : NumberField.RingOfIntegers K) : K)) ^ (l_ang w)) = 1) →
                (1 ≤ a₀ ∨
                  ((∀ w : NumberField.InfinitePlace K, w.IsReal → l_ang w = 0) ∧
                    (m_freq ≠ 0 ∨ ∃ w : NumberField.InfinitePlace K, w.IsComplex ∧ l_ang w ≠ 0))) →
                ∀ M : ℝ, 1 ≤ M →
                  (∀ j : Fin (NumberField.Units.rank K), |(m_freq j : ℝ)| ≤ Real.exp M) →
                  (∀ w : NumberField.InfinitePlace K, |(l_ang w : ℝ)| ≤ Real.exp M) →
                  ∀ χ_gr : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ,
                    (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)),
                      ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤ → ‖χ_gr I‖ = 1) ∧
                      (¬ ((I : Ideal (NumberField.RingOfIntegers K)) ⊔ q = ⊤) → χ_gr I = 0)) →
                    (∀ (x : NumberField.RingOfIntegers K) (hx_ne : x ≠ 0),
                      x - 1 ∈ q →
                      ∃ y : Fin (NumberField.Units.rank K) → ℝ,
                        (∀ w : NumberField.InfinitePlace K,
                          Real.log (w (x : K) / w₀ (x : K)) =
                            ∑ j : Fin (NumberField.Units.rank K),
                              y j *
                                Real.log (w (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K) /
                                  w₀ (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K))) ∧
                        χ_gr ⟨Ideal.span ({x} : Set (NumberField.RingOfIntegers K)),
                          mem_nonZeroDivisors_of_ne_zero (Ideal.span_singleton_eq_bot.not.mpr hx_ne)⟩ *
                          ((w₀.embedding (x : K) / (w₀ (x : K) : ℂ)) ^ a₀ *
                            Complex.exp
                              (((∑ j : Fin (NumberField.Units.rank K),
                                  y j *
                                    (2 * Real.pi * (θ₀ j - (m_freq j : ℝ)) +
                                      ∑ w : NumberField.InfinitePlace K,
                                        (l_ang w : ℝ) *
                                          (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg)) : ℝ) * Complex.I)) =
                          ∏ w : NumberField.InfinitePlace K,
                            (w.embedding (x : K) / (w (x : K) : ℂ)) ^ (l_ang w)) →
                    ∃ (B₀ : ℝ) (χ_dual : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) →* ℂ) (g_χ : ℂ → ℂ),
                      0 < B₀ ∧
                      (∀ I : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)), ‖χ_dual I‖ ≤ 1) ∧
                      Differentiable ℂ g_χ ∧
                      (∀ s : ℂ, 1 < s.re →
                        g_χ s = LSeries (fun n =>
                          ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
                            χ_gr ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) s) ∧
                      (∀ s : ℂ, s.re = -1 / 2 →
                        ‖(((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ (s / 2) *
                            (Complex.Gammaℝ s) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
                            (Complex.Gammaℂ s) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) * g_χ s‖ ≤
                          C₀ * (Ideal.absNorm q : ℝ) ^ 2 * (Real.exp M) ^ (Module.finrank ℚ K) *
                            ‖(((|(NumberField.discr K : ℝ)| : ℝ) : ℂ) ^ ((1 - s) / 2) *
                                (Complex.Gammaℝ (1 - s)) ^ (NumberField.InfinitePlace.nrRealPlaces K) *
                                (Complex.Gammaℂ (1 - s)) ^ (NumberField.InfinitePlace.nrComplexPlaces K)) *
                              LSeries (fun n =>
                                ∑' I : {I : Ideal (NumberField.RingOfIntegers K) // I ≠ ⊥ ∧ Ideal.absNorm I = n},
                                  χ_dual ⟨I.1, mem_nonZeroDivisors_of_ne_zero I.2.1⟩) (1 - s)‖) ∧
