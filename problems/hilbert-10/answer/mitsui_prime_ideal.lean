    have h_eq : R⁻¹ * (F * R * Y) = F * Y := by
      field_simp [hR_ne]
    rw [h_eq]
    exact hδn_le_FY
  set S₁ : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      (∀ i : NumberField.mixedEmbedding.index K,
        (NumberField.mixedEmbedding.stdBasis K).repr
            (NumberField.mixedEmbedding K (π : K)) i ∈
          Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
            ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
      IsUnit (Ideal.Quotient.mk q π)},
    ψ (Additive.ofMul π.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S₂ : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      (∀ i : NumberField.mixedEmbedding.index K,
        (NumberField.mixedEmbedding.stdBasis K).repr
            (NumberField.mixedEmbedding K (π : K)) i ∈
          Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
            ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
      (∀ w : NumberField.InfinitePlace K, 1 ≤ w (π : K)) ∧
      IsUnit (Ideal.Quotient.mk q π)},
    ψ (Additive.ofMul π.2.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  let S_sec : NumberField.InfinitePlace K → ℂ := fun w₀ =>
    ∑' π : {π : NumberField.RingOfIntegers K //
          Prime π ∧
          (∀ i : NumberField.mixedEmbedding.index K,
            (NumberField.mixedEmbedding.stdBasis K).repr
                (NumberField.mixedEmbedding K (π : K)) i ∈
              Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
          (∀ w : NumberField.InfinitePlace K,
            1 ≤ w (π : K) ∧ w (π : K) ≤ w₀ (π : K)) ∧
          IsUnit (Ideal.Quotient.mk q π)},
      ψ (Additive.ofMul π.2.2.2.2.unit) *
        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S₃ : ℂ := ∑ w₀ : NumberField.InfinitePlace K, S_sec w₀
  set S₄ : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      NumberField.mixedEmbedding K (π : K) ∈
        NumberField.mixedEmbedding.fundamentalCone K ∧
      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤ Y ∧
      IsUnit (Ideal.Quotient.mk q π)},
    ψ (Additive.ofMul π.2.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  have h1_le := mitsui_prime_char_grid_cube_to_ge_one_le (K := K) X hX m hm k hQ_bdd q hq ψ
  have h1_uncond := hc₁₀ X hX
  have h1 : ‖S₁ - S₂‖ ≤ c₁₀ * Y * Real.exp (-u / c₁₀) :=
    le_trans h1_le h1_uncond
  have h2_le := mitsui_prime_char_grid_cube_ge_one_to_place_sectors_le (K := K) X hX m hm k hQ_bdd q hq ψ
  have h2_uncond := hc₂₀ X hX
  have h2 : ‖S₂ - S₃‖ ≤ c₂₀ * Y * Real.exp (-u / c₂₀) :=
    le_trans h2_le h2_uncond
  have h3 : ∀ w₀ : NumberField.InfinitePlace K,
      ‖S_sec w₀‖ ≤ c_sec * Y * Real.exp (-u / c_sec) :=
    fun w₀ => hc_sec X hX m hm hm_coarse k hQ_bdd w₀ q hq hq_norm ψ hψ hψ_units
  have h_norm3 : ‖S₃‖ ≤ M_card * (c_sec * Y * Real.exp (-u / c_sec)) := by
    dsimp [S₃]
    calc ‖∑ w₀ : NumberField.InfinitePlace K, S_sec w₀‖
      _ ≤ ∑ w₀ : NumberField.InfinitePlace K, ‖S_sec w₀‖ := norm_sum_le _ _
      _ ≤ ∑ _w₀ : NumberField.InfinitePlace K, (c_sec * Y * Real.exp (-u / c_sec)) :=
          Finset.sum_le_sum (fun w₀ _ => h3 w₀)
      _ = M_card * (c_sec * Y * Real.exp (-u / c_sec)) := by
          simp [M_card, Finset.sum_const, nsmul_eq_mul]
  have h4 : ‖S₄‖ ≤ c_cone * Y * Real.exp (-u / c_cone) :=
    hc_cone X hX q hq hq_norm ψ hψ hψ_units
  have h_ident : S₁ - (ρ_cube : ℂ) * S₄ = (S₁ - S₂) + (S₂ - S₃) + S₃ - (ρ_cube : ℂ) * S₄ := by
    ring
  have h_tri : ‖S₁ - (ρ_cube : ℂ) * S₄‖ ≤
      ‖S₁ - S₂‖ + ‖S₂ - S₃‖ + ‖S₃‖ + R⁻¹ * ‖S₄‖ := by
    rw [congrArg norm h_ident]
    have ht1 := norm_sub_le ((S₁ - S₂) + (S₂ - S₃) + S₃) ((ρ_cube : ℂ) * S₄)
    have ht2 := norm_add_le ((S₁ - S₂) + (S₂ - S₃)) S₃
    have ht3 := norm_add_le (S₁ - S₂) (S₂ - S₃)
    have hm4 : ‖(ρ_cube : ℂ) * S₄‖ ≤ R⁻¹ * ‖S₄‖ := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hρ_nonneg]
      exact mul_le_mul_of_nonneg_right hρ_le (norm_nonneg _)
    linarith
  have hc₁₀_le : c₁₀ ≤ c_cf := by
    have : 0 ≤ c₂₀ + M_card * c_sec + c_sec + c_cone + R⁻¹ * c_cone := by positivity
    dsimp [c_cf]; linarith
  have hc₂₀_le : c₂₀ ≤ c_cf := by
    have : 0 ≤ c₁₀ + M_card * c_sec + c_sec + c_cone + R⁻¹ * c_cone := by positivity
    dsimp [c_cf]; linarith
  have hc_sec_le : c_sec ≤ c_cf := by
    have : 0 ≤ c₁₀ + c₂₀ + M_card * c_sec + c_cone + R⁻¹ * c_cone := by positivity
    dsimp [c_cf]; linarith
  have hc_cone_le : c_cone ≤ c_cf := by
    have : 0 ≤ c₁₀ + c₂₀ + M_card * c_sec + c_sec + R⁻¹ * c_cone := by positivity
    dsimp [c_cf]; linarith
  have hexp1 : Real.exp (-u / c₁₀) ≤ Real.exp (-u / c_cf) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hu_nonneg hc₁₀_pos hc₁₀_le
  have hexp2 : Real.exp (-u / c₂₀) ≤ Real.exp (-u / c_cf) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hu_nonneg hc₂₀_pos hc₂₀_le
  have hexp3 : Real.exp (-u / c_sec) ≤ Real.exp (-u / c_cf) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hu_nonneg hc_sec_pos hc_sec_le
  have hexp4 : Real.exp (-u / c_cone) ≤ Real.exp (-u / c_cf) := by
    rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
    exact div_le_div_of_nonneg_left hu_nonneg hc_cone_pos hc_cone_le
  have hterm1 : ‖S₁ - S₂‖ ≤ c₁₀ * Y * Real.exp (-u / c_cf) := by
    calc ‖S₁ - S₂‖ ≤ c₁₀ * Y * Real.exp (-u / c₁₀) := h1
      _ ≤ c₁₀ * Y * Real.exp (-u / c_cf) :=
        mul_le_mul_of_nonneg_left hexp1 (by positivity)
  have hterm2 : ‖S₂ - S₃‖ ≤ c₂₀ * Y * Real.exp (-u / c_cf) := by
    calc ‖S₂ - S₃‖ ≤ c₂₀ * Y * Real.exp (-u / c₂₀) := h2
      _ ≤ c₂₀ * Y * Real.exp (-u / c_cf) :=
        mul_le_mul_of_nonneg_left hexp2 (by positivity)
  have hterm3 : ‖S₃‖ ≤ (M_card * c_sec) * Y * Real.exp (-u / c_cf) := by
    calc ‖S₃‖ ≤ M_card * (c_sec * Y * Real.exp (-u / c_sec)) := h_norm3
      _ ≤ M_card * (c_sec * Y * Real.exp (-u / c_cf)) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp3 (by positivity)) hM_nonneg
      _ = (M_card * c_sec) * Y * Real.exp (-u / c_cf) := by ring
  have hterm4 : R⁻¹ * ‖S₄‖ ≤ (R⁻¹ * c_cone) * Y * Real.exp (-u / c_cf) := by
    calc R⁻¹ * ‖S₄‖ ≤ R⁻¹ * (c_cone * Y * Real.exp (-u / c_cone)) :=
          mul_le_mul_of_nonneg_left h4 (by positivity)
      _ ≤ R⁻¹ * (c_cone * Y * Real.exp (-u / c_cf)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hexp4 (by positivity)) (by positivity)
      _ = (R⁻¹ * c_cone) * Y * Real.exp (-u / c_cf) := by ring
  have h_sum_le :
      c₁₀ * Y * Real.exp (-u / c_cf) +
      c₂₀ * Y * Real.exp (-u / c_cf) +
      (M_card * c_sec) * Y * Real.exp (-u / c_cf) +
      (R⁻¹ * c_cone) * Y * Real.exp (-u / c_cf) ≤
      c_cf * Y * Real.exp (-u / c_cf) := by
    have h_coeff : c₁₀ + c₂₀ + M_card * c_sec + R⁻¹ * c_cone ≤ c_cf := by
      have : 0 ≤ c_sec + c_cone := by positivity
      dsimp [c_cf]; linarith
    have hYE_nonneg : 0 ≤ Y * Real.exp (-u / c_cf) := by positivity
    calc c₁₀ * Y * Real.exp (-u / c_cf) +
        c₂₀ * Y * Real.exp (-u / c_cf) +
        (M_card * c_sec) * Y * Real.exp (-u / c_cf) +
        (R⁻¹ * c_cone) * Y * Real.exp (-u / c_cf)
      _ = (c₁₀ + c₂₀ + M_card * c_sec + R⁻¹ * c_cone) * (Y * Real.exp (-u / c_cf)) := by ring
      _ ≤ c_cf * (Y * Real.exp (-u / c_cf)) :=
        mul_le_mul_of_nonneg_right h_coeff hYE_nonneg
      _ = c_cf * Y * Real.exp (-u / c_cf) := by ring
  linarith

theorem mitsui_prime_char_grid_cube_equidist_of_units_eq_one {K : Type u} [Field K] [NumberField K]
    (A : ℕ) (hA : 1 < A) :
    ∃ c_cube : ℝ, 0 < c_cube ∧
      ∀ X : ℝ, 1 < X →
        ∀ m : ℕ, 1 ≤ m → (m : ℝ) ≤ X →
          ∀ k : NumberField.mixedEmbedding.index K → Fin (2 * m),
            (∀ z : NumberField.mixedEmbedding.mixedSpace K,
                (∀ i : NumberField.mixedEmbedding.index K,
                  (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
                    Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                      ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) →
                ∀ w : NumberField.InfinitePlace K,
                  NumberField.mixedEmbedding.normAtPlace w z < X) →
            ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
              (Ideal.absNorm q : ℝ) < Real.log X ^ A →
              ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
                (∀ u : (NumberField.RingOfIntegers K)ˣ,
                  ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) →
                ‖(∑' π : {π : NumberField.RingOfIntegers K //
                      Prime π ∧
                      (∀ i : NumberField.mixedEmbedding.index K,
                        (NumberField.mixedEmbedding.stdBasis K).repr
                            (NumberField.mixedEmbedding K (π : K)) i ∈
                          Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
                            ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
                      IsUnit (Ideal.Quotient.mk q π)},
                    ψ (Additive.ofMul π.2.2.2.unit) *
                      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
                  - (((X / (m : ℝ)) ^ (Module.finrank ℚ K) /
                      ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) *
                        X ^ (Module.finrank ℚ K)) : ℝ) : ℂ) *
                    (∑' π : {π : NumberField.RingOfIntegers K //
                          Prime π ∧
                          (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
                          IsUnit (Ideal.Quotient.mk q π)},
                        ψ (Additive.ofMul π.2.2.2.unit) *
                          (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
                  ≤ c_cube * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c_cube) :=
by
  obtain ⟨c_pack, hc_pack_pos, hc_pack⟩ := mitsui_prime_grid_cube_upper_bound (K := K)
  obtain ⟨c_box, hc_box_pos, hc_box⟩ := mitsui_prime_box_upper_bound (K := K)
  obtain ⟨c₁, hc₁_pos, hc₁⟩ := mitsui_prime_char_box_to_fundamentalCone_of_units_eq_one (K := K) A hA
  obtain ⟨c_cf, hc_cf_pos, hc_cf⟩ :=
    mitsui_prime_char_grid_cube_to_fundamentalCone_of_units_eq_one (K := K) A hA
  set n : ℕ := Module.finrank ℚ K
  set F : ℝ := (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
  set R : ℝ := NumberField.Units.regulator K
  have hn_pos : 0 < n := Module.finrank_pos
  have hn_ge_one : 1 ≤ n := hn_pos
  have hF_ge_one : 1 ≤ F := by
    change (1 : ℝ) ≤ (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
    exact_mod_cast NumberField.mixedEmbedding.one_le_convexBodyLTFactor K
  have hF_pos : 0 < F := lt_of_lt_of_le zero_lt_one hF_ge_one
  have hF_ne : F ≠ 0 := ne_of_gt hF_pos
  have hR_pos : 0 < R := NumberField.Units.regulator_pos K
  have hR_ne : R ≠ 0 := ne_of_gt hR_pos
  let A_fine : ℝ := 17 * (c_pack + c_box / F)
  have hA_fine_pos : 0 < A_fine := by dsimp [A_fine]; positivity
  let c_cube : ℝ := 2 + c_cf + c₁ + A_fine
  have hc_cube_pos : 0 < c_cube := by dsimp [c_cube]; positivity
  have h_two_le_c : 2 ≤ c_cube := by
    have : 0 ≤ c_cf + c₁ + A_fine := by positivity
    dsimp [c_cube]; linarith
  have hc_cf_le_c : c_cf ≤ c_cube := by
    have : 0 ≤ 2 + c₁ + A_fine := by positivity
    dsimp [c_cube]; linarith
  have hc₁_le_c : c₁ ≤ c_cube := by
    have : 0 ≤ 2 + c_cf + A_fine := by positivity
    dsimp [c_cube]; linarith
  have h_sum_cf_le_c : c_cf + c₁ ≤ c_cube := by
    have : 0 ≤ 2 + A_fine := by positivity
    dsimp [c_cube]; linarith
  have hA_fine_le_c : A_fine ≤ c_cube := by
    have : 0 ≤ 2 + c_cf + c₁ := by positivity
    dsimp [c_cube]; linarith
  refine ⟨c_cube, hc_cube_pos, ?_⟩
  intro X hX m hm hm_le_X k hQ_bdd q hq hq_norm ψ hψ hψ_units
  have hX_pos : 0 < X := by linarith
  have hYn_pos : 0 < X ^ n := by positivity
  have hYn_ne : X ^ n ≠ 0 := ne_of_gt hYn_pos
  have hlogX_pos : 0 < Real.log X := Real.log_pos hX
  set u : ℝ := Real.sqrt (Real.log X)
  have hu_pos : 0 < u := Real.sqrt_pos.mpr hlogX_pos
  have hu_nonneg : 0 ≤ u := le_of_lt hu_pos
  have hu_sq : u ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlogX_pos)
  have hmR_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
  have hmR_pos : (0 : ℝ) < (m : ℝ) := lt_of_lt_of_le zero_lt_one hmR_ge_one
  set δ : ℝ := X / (m : ℝ)
  have hδ_pos : 0 < δ := by dsimp [δ]; positivity
  have hδ_le_X : δ ≤ X := by
    dsimp [δ]
    exact div_le_self (le_of_lt hX_pos) hmR_ge_one
  have hδn_le_Xn : δ ^ n ≤ X ^ n := pow_le_pow_left₀ (le_of_lt hδ_pos) hδ_le_X n
  have hXn_le_FXn : X ^ n ≤ F * X ^ n := by
    calc X ^ n = 1 * X ^ n := by ring
      _ ≤ F * X ^ n := mul_le_mul_of_nonneg_right hF_ge_one (le_of_lt hYn_pos)
  set τ_cube : ℝ := δ ^ n / (F * X ^ n)
  set ρ_cube : ℝ := δ ^ n / (F * R * X ^ n)
  have hτ_nonneg : 0 ≤ τ_cube := by dsimp [τ_cube]; positivity
  have hτ_le_one : τ_cube ≤ 1 := by
    dsimp [τ_cube]
    exact div_le_one_of_le₀ (le_trans hδn_le_Xn hXn_le_FXn) (by positivity)
  have hρ_eq_R : ρ_cube = τ_cube * R⁻¹ := by
    dsimp [ρ_cube, τ_cube]
    ring
  have hρ_eq_C : (ρ_cube : ℂ) = (τ_cube : ℂ) * ((R⁻¹ : ℝ) : ℂ) := by
    exact_mod_cast hρ_eq_R
  set S_Q : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      (∀ i : NumberField.mixedEmbedding.index K,
        (NumberField.mixedEmbedding.stdBasis K).repr
            (NumberField.mixedEmbedding K (π : K)) i ∈
          Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
            ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
      IsUnit (Ideal.Quotient.mk q π)},
    ψ (Additive.ofMul π.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S_B : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
      IsUnit (Ideal.Quotient.mk q π)},
    ψ (Additive.ofMul π.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S_cone : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      NumberField.mixedEmbedding K (π : K) ∈
        NumberField.mixedEmbedding.fundamentalCone K ∧
      NumberField.mixedEmbedding.norm (NumberField.mixedEmbedding K (π : K)) ≤
        X ^ n ∧
      IsUnit (Ideal.Quotient.mk q π)},
    ψ (Additive.ofMul π.2.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  by_cases hm_coarse : (m : ℝ) ≤ Real.exp u
  · have h_cf := hc_cf X hX m hm hm_coarse k hQ_bdd q hq hq_norm ψ hψ hψ_units
    have h_bf := hc₁ X hX q hq hq_norm ψ hψ hψ_units
    have h_ident : S_Q - (τ_cube : ℂ) * S_B =
        (S_Q - (ρ_cube : ℂ) * S_cone) -
          (τ_cube : ℂ) * (S_B - ((R⁻¹ : ℝ) : ℂ) * S_cone) := by
      rw [hρ_eq_C]
      ring
    have h_tri : ‖S_Q - (τ_cube : ℂ) * S_B‖ ≤
        ‖S_Q - (ρ_cube : ℂ) * S_cone‖ + ‖S_B - ((R⁻¹ : ℝ) : ℂ) * S_cone‖ := by
      rw [congrArg norm h_ident]
      have ht1 := norm_sub_le
        (S_Q - (ρ_cube : ℂ) * S_cone)
        ((τ_cube : ℂ) * (S_B - ((R⁻¹ : ℝ) : ℂ) * S_cone))
      have hm1 : ‖(τ_cube : ℂ) * (S_B - ((R⁻¹ : ℝ) : ℂ) * S_cone)‖ ≤
          ‖S_B - ((R⁻¹ : ℝ) : ℂ) * S_cone‖ := by
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hτ_nonneg]
        exact mul_le_of_le_one_left (norm_nonneg _) hτ_le_one
      linarith
    have hexp_cf : Real.exp (-u / c_cf) ≤ Real.exp (-u / c_cube) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left hu_nonneg hc_cf_pos hc_cf_le_c
    have hexp_bf : Real.exp (-u / c₁) ≤ Real.exp (-u / c_cube) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left hu_nonneg hc₁_pos hc₁_le_c
    have hterm_cf : ‖S_Q - (ρ_cube : ℂ) * S_cone‖ ≤
        c_cf * X ^ n * Real.exp (-u / c_cube) := by
      calc ‖S_Q - (ρ_cube : ℂ) * S_cone‖
        _ ≤ c_cf * X ^ n * Real.exp (-u / c_cf) := h_cf
        _ ≤ c_cf * X ^ n * Real.exp (-u / c_cube) :=
          mul_le_mul_of_nonneg_left hexp_cf (by positivity)
    have hterm_bf : ‖S_B - ((R⁻¹ : ℝ) : ℂ) * S_cone‖ ≤
        c₁ * X ^ n * Real.exp (-u / c_cube) := by
      calc ‖S_B - ((R⁻¹ : ℝ) : ℂ) * S_cone‖
        _ ≤ c₁ * X ^ n * Real.exp (-u / c₁) := h_bf
        _ ≤ c₁ * X ^ n * Real.exp (-u / c_cube) :=
          mul_le_mul_of_nonneg_left hexp_bf (by positivity)
    calc ‖S_Q - (τ_cube : ℂ) * S_B‖
      _ ≤ ‖S_Q - (ρ_cube : ℂ) * S_cone‖ + ‖S_B - ((R⁻¹ : ℝ) : ℂ) * S_cone‖ := h_tri
      _ ≤ c_cf * X ^ n * Real.exp (-u / c_cube) + c₁ * X ^ n * Real.exp (-u / c_cube) :=
          add_le_add hterm_cf hterm_bf
      _ = (c_cf + c₁) * (X ^ n * Real.exp (-u / c_cube)) := by ring
      _ ≤ c_cube * (X ^ n * Real.exp (-u / c_cube)) :=
          mul_le_mul_of_nonneg_right h_sum_cf_le_c (by positivity)
      _ = c_cube * X ^ n * Real.exp (-u / c_cube) := by ring
  · push_neg at hm_coarse
    have h_SQ_le : ‖S_Q‖ ≤ c_pack * δ ^ n * (Real.log X + 1) :=
      le_trans (mitsui_prime_char_grid_cube_norm_le_uncond X hX m hm k hQ_bdd q hq ψ)
        (hc_pack X hX m hm hm_le_X k hQ_bdd)
    have h_SB_le : ‖S_B‖ ≤ c_box * X ^ n * (Real.log X + 1) :=
      le_trans (mitsui_prime_char_box_norm_le_uncond X hX q hq ψ) (hc_box X hX)
    have h_tri : ‖S_Q - (τ_cube : ℂ) * S_B‖ ≤ ‖S_Q‖ + τ_cube * ‖S_B‖ := by
      calc ‖S_Q - (τ_cube : ℂ) * S_B‖
        _ ≤ ‖S_Q‖ + ‖(τ_cube : ℂ) * S_B‖ := norm_sub_le _ _
        _ = ‖S_Q‖ + τ_cube * ‖S_B‖ := by
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hτ_nonneg]
    have h_τSB_le : τ_cube * ‖S_B‖ ≤ (c_box / F) * δ ^ n * (Real.log X + 1) := by
      calc τ_cube * ‖S_B‖
        _ ≤ τ_cube * (c_box * X ^ n * (Real.log X + 1)) :=
            mul_le_mul_of_nonneg_left h_SB_le hτ_nonneg
        _ = (c_box / F) * δ ^ n * (Real.log X + 1) := by
            dsimp [τ_cube]
            field_simp [hF_ne, hYn_ne]
    have h_sum_δ : ‖S_Q - (τ_cube : ℂ) * S_B‖ ≤
        (c_pack + c_box / F) * δ ^ n * (Real.log X + 1) := by
      calc ‖S_Q - (τ_cube : ℂ) * S_B‖
        _ ≤ ‖S_Q‖ + τ_cube * ‖S_B‖ := h_tri
        _ ≤ c_pack * δ ^ n * (Real.log X + 1) + (c_box / F) * δ ^ n * (Real.log X + 1) :=
            add_le_add h_SQ_le h_τSB_le
        _ = (c_pack + c_box / F) * δ ^ n * (Real.log X + 1) := by ring
    have hm_pow_ge : (m : ℝ) ≤ (m : ℝ) ^ n := by
      calc (m : ℝ) = (m : ℝ) ^ 1 := (pow_one _).symm
        _ ≤ (m : ℝ) ^ n := pow_le_pow_right₀ hmR_ge_one hn_ge_one
    have hexp_le_mn : Real.exp u ≤ (m : ℝ) ^ n :=
      le_trans (le_of_lt hm_coarse) hm_pow_ge
    have hδn_le_exp : δ ^ n ≤ X ^ n * Real.exp (-u) := by
      dsimp [δ]
      rw [div_pow, div_le_iff₀ (by positivity)]
      calc X ^ n = X ^ n * (Real.exp (-u) * Real.exp u) := by
            rw [← Real.exp_add, neg_add_cancel, Real.exp_zero, mul_one]
        _ = (X ^ n * Real.exp (-u)) * Real.exp u := by ring
        _ ≤ (X ^ n * Real.exp (-u)) * (m : ℝ) ^ n :=
            mul_le_mul_of_nonneg_left hexp_le_mn (by positivity)
    have h_log_le : Real.log X + 1 ≤ 17 * Real.exp (u / 2) := by
      have h_exp4 : u / 4 ≤ Real.exp (u / 4) := by
        have h := Real.add_one_le_exp (u / 4)
        linarith
      have h_sq4 : (u / 4) ^ 2 ≤ (Real.exp (u / 4)) ^ 2 :=
        pow_le_pow_left₀ (by positivity) h_exp4 2
      have h_exp_sq : (Real.exp (u / 4)) ^ 2 = Real.exp (u / 2) := by
        rw [sq, ← Real.exp_add]
        ring_nf
      rw [h_exp_sq] at h_sq4
      have h_u_sq : Real.log X ≤ 16 * Real.exp (u / 2) := by
        calc Real.log X = u ^ 2 := hu_sq.symm
          _ = 16 * (u / 4) ^ 2 := by ring
          _ ≤ 16 * Real.exp (u / 2) := mul_le_mul_of_nonneg_left h_sq4 (by norm_num)
      have h_one_le : 1 ≤ Real.exp (u / 2) := Real.one_le_exp (by positivity)
      linarith
    have h_prod_le : δ ^ n * (Real.log X + 1) ≤ 17 * X ^ n * Real.exp (-u / 2) := by
      have hexp_comb : Real.exp (-u) * Real.exp (u / 2) = Real.exp (-u / 2) := by
        rw [← Real.exp_add]
        ring_nf
      calc δ ^ n * (Real.log X + 1)
        _ ≤ (X ^ n * Real.exp (-u)) * (17 * Real.exp (u / 2)) :=
            mul_le_mul hδn_le_exp h_log_le (by positivity) (by positivity)
        _ = 17 * X ^ n * (Real.exp (-u) * Real.exp (u / 2)) := by ring
        _ = 17 * X ^ n * Real.exp (-u / 2) := by rw [hexp_comb]
    have hexp_fine : Real.exp (-u / 2) ≤ Real.exp (-u / c_cube) := by
      rw [Real.exp_le_exp, neg_div, neg_div, neg_le_neg_iff]
      exact div_le_div_of_nonneg_left hu_nonneg (by norm_num) h_two_le_c
    calc ‖S_Q - (τ_cube : ℂ) * S_B‖
      _ ≤ (c_pack + c_box / F) * (δ ^ n * (Real.log X + 1)) := by linarith [h_sum_δ]
      _ ≤ (c_pack + c_box / F) * (17 * X ^ n * Real.exp (-u / 2)) :=
          mul_le_mul_of_nonneg_left h_prod_le (by positivity)
      _ = A_fine * X ^ n * Real.exp (-u / 2) := by dsimp [A_fine]; ring
      _ ≤ A_fine * X ^ n * Real.exp (-u / c_cube) :=
          mul_le_mul_of_nonneg_left hexp_fine (by positivity)
      _ ≤ c_cube * X ^ n * Real.exp (-u / c_cube) := by
          have : 0 ≤ X ^ n * Real.exp (-u / c_cube) := by positivity
          nlinarith

theorem mitsui_prime_char_convex_to_box_of_units_eq_one {K : Type u} [Field K] [NumberField K]
    [Fintype {w : NumberField.InfinitePlace K // w.IsReal}]
    [Fintype {w : NumberField.InfinitePlace K // w.IsComplex}]
    (A : ℕ) (hA : 1 < A) :
    ∃ c₂ : ℝ, 0 < c₂ ∧
      ∀ X : ℝ, 1 < X →
        ∀ C : Set (NumberField.mixedEmbedding.mixedSpace K), Convex ℝ C → IsOpen C →
          (∀ z ∈ C, ∀ w : NumberField.InfinitePlace K,
              NumberField.mixedEmbedding.normAtPlace w z < X) →
          ∀ q : Ideal (NumberField.RingOfIntegers K), q ≠ 0 →
            (Ideal.absNorm q : ℝ) < Real.log X ^ A →
            ∀ ψ : AddChar (Additive (NumberField.RingOfIntegers K ⧸ q)ˣ) ℂ, ψ ≠ 0 →
              (∀ u : (NumberField.RingOfIntegers K)ˣ,
                ψ (Additive.ofMul (Units.map (Ideal.Quotient.mk q).toMonoidHom u)) = 1) →
              ‖(∑' π : {π : NumberField.RingOfIntegers K //
                    Prime π ∧
                    NumberField.mixedEmbedding K (π : K) ∈ C ∧
                    IsUnit (Ideal.Quotient.mk q π)},
                  ψ (Additive.ofMul π.2.2.2.unit) *
                    (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))
                - (((MeasureTheory.volume C).toReal /
                    ((NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ) *
                      X ^ (Module.finrank ℚ K)) : ℝ) : ℂ) *
                  (∑' π : {π : NumberField.RingOfIntegers K //
                        Prime π ∧
                        (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
                        IsUnit (Ideal.Quotient.mk q π)},
                      ψ (Additive.ofMul π.2.2.2.unit) *
                        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ))‖
                ≤ c₂ * X ^ (Module.finrank ℚ K) * Real.exp (-Real.sqrt (Real.log X) / c₂) :=
by
  obtain ⟨c_box, hc_box_pos, hc_box⟩ := mitsui_prime_box_upper_bound (K := K)
  obtain ⟨c_pack, hc_pack_pos, hc_pack⟩ := mitsui_prime_grid_partition_diff_le_boundary (K := K)
  obtain ⟨c_cube, hc_cube_pos, hc_cube⟩ :=
    mitsui_prime_char_grid_cube_equidist_of_units_eq_one (K := K) A hA
  set n : ℕ := Module.finrank ℚ K
  set F : ℝ := (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
  have hn_pos : 0 < n := Module.finrank_pos
  have hn_ge_one : 1 ≤ n := hn_pos
  have hnR_pos : (0 : ℝ) < (n : ℝ) := Nat.cast_pos.mpr hn_pos
  have hnR_ge_one : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn_ge_one
  have hF_ge_one : 1 ≤ F := by
    change (1 : ℝ) ≤ (NumberField.mixedEmbedding.convexBodyLTFactor K : ℝ)
    exact_mod_cast NumberField.mixedEmbedding.one_le_convexBodyLTFactor K
  have hF_pos : 0 < F := lt_of_lt_of_le zero_lt_one hF_ge_one
  let c' : ℝ := min (1 / 2) (1 / (2 * (n : ℝ) * c_cube))
  have hc'_pos : 0 < c' := lt_min (by norm_num) (by positivity)
  have hc'_le_half : c' ≤ 1 / 2 := min_le_left _ _
  have hc'_le_cube : c' ≤ 1 / (2 * (n : ℝ) * c_cube) := min_le_right _ _
  let A_bdry : ℝ := 2 * (c_pack + c_box / F) * (2 : ℝ) ^ (3 * n) * (16 / c' ^ 2 + 1)
  have hA_bdry_pos : 0 < A_bdry := by dsimp [A_bdry]; positivity
  let A_int : ℝ := (2 : ℝ) ^ n * c_cube
  have hA_int_pos : 0 < A_int := by dsimp [A_int]; positivity
  let c₂ : ℝ := max (2 / c') (A_bdry + A_int)
  have hc₂_pos : 0 < c₂ := lt_of_lt_of_le (by positivity) (le_max_left _ _)
  refine ⟨c₂, hc₂_pos, ?_⟩
  intro X hX C hC_conv hC_open hC_bdd q hq hq_norm ψ hψ hψ_units
  have hX_pos : 0 < X := by linarith
  have hYn_pos : 0 < X ^ n := by positivity
  have hlogX_pos : 0 < Real.log X := Real.log_pos hX
  set u : ℝ := Real.sqrt (Real.log X)
  have hu_pos : 0 < u := Real.sqrt_pos.mpr hlogX_pos
  have hu_nonneg : 0 ≤ u := le_of_lt hu_pos
  have hu_sq : u ^ 2 = Real.log X := Real.sq_sqrt (le_of_lt hlogX_pos)
  set m : ℕ := ⌊Real.exp (c' * u)⌋₊
  have hcu_pos : 0 < c' * u := mul_pos hc'_pos hu_pos
  have hexp_gt_one : 1 < Real.exp (c' * u) := Real.one_lt_exp_iff.mpr hcu_pos
  have hm_ge_one : 1 ≤ m := Nat.floor_pos.mpr (le_of_lt hexp_gt_one)
  have hmR_ge_one : (1 : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm_ge_one
  have hmR_pos : (0 : ℝ) < (m : ℝ) := lt_of_lt_of_le zero_lt_one hmR_ge_one
  have hmR_ne : (m : ℝ) ≠ 0 := ne_of_gt hmR_pos
  have hm_le_exp : (m : ℝ) ≤ Real.exp (c' * u) := Nat.floor_le (Real.exp_nonneg _)
  have hexp_lt_m1 : Real.exp (c' * u) < (m : ℝ) + 1 := Nat.lt_floor_add_one _
  have hexp_le_2m : Real.exp (c' * u) ≤ 2 * (m : ℝ) := by linarith
  have h_minv_le : (m : ℝ)⁻¹ ≤ 2 * Real.exp (-c' * u) := by
    rw [inv_eq_one_div, div_le_iff₀ hmR_pos]
    calc (1 : ℝ) = Real.exp (c' * u) * Real.exp (-c' * u) := by
          rw [← Real.exp_add, neg_mul, add_neg_cancel, Real.exp_zero]
      _ ≤ (2 * (m : ℝ)) * Real.exp (-c' * u) :=
          mul_le_mul_of_nonneg_right hexp_le_2m (Real.exp_nonneg _)
      _ = 2 * Real.exp (-c' * u) * (m : ℝ) := by ring
  have hm_le_X : (m : ℝ) ≤ X := by
    rcases lt_or_ge u 1 with hu_lt | hu_ge
    · have hcu_lt : c' * u < Real.log 2 := by
        have h1 : c' * u < (1 / 2 : ℝ) * 1 := by
          calc c' * u ≤ (1 / 2) * u := mul_le_mul_of_nonneg_right hc'_le_half hu_nonneg
            _ < (1 / 2) * 1 := mul_lt_mul_of_pos_left hu_lt (by norm_num)
        have h2 := Real.log_two_gt_d9
        linarith
      have hexp_lt_two : Real.exp (c' * u) < 2 := by
        calc Real.exp (c' * u) < Real.exp (Real.log 2) := Real.exp_lt_exp.mpr hcu_lt
          _ = 2 := Real.exp_log (by norm_num)
      have hm_lt_two : m < 2 := (Nat.floor_lt (Real.exp_nonneg _)).mpr hexp_lt_two
      have hm_eq_one : m = 1 := by omega
      rw [hm_eq_one, Nat.cast_one]
      exact le_of_lt hX
    · have hcu_le_log : c' * u ≤ Real.log X := by
        calc c' * u ≤ (1 / 2) * u := mul_le_mul_of_nonneg_right hc'_le_half hu_nonneg
          _ ≤ 1 * u := by linarith
          _ = u * 1 := by ring
          _ ≤ u * u := mul_le_mul_of_nonneg_left hu_ge hu_nonneg
          _ = u ^ 2 := by ring
          _ = Real.log X := hu_sq
      calc (m : ℝ) ≤ Real.exp (c' * u) := hm_le_exp
        _ ≤ Real.exp (Real.log X) := Real.exp_le_exp.mpr hcu_le_log
        _ = X := Real.exp_log hX_pos
  have h1 := mitsui_convex_grid_boundary_card_bound X hX m hm_ge_one C hC_conv hC_open
  have h2 := hc_box X hX
  have h3 := hc_pack X hX m hm_ge_one hm_le_X C hC_bdd
  have h4 := mitsui_volume_grid_partition_diff_le_boundary X hX m hm_ge_one C hC_open hC_bdd
  have h5 := mitsui_prime_char_box_norm_le_uncond X hX q hq ψ
  have h6 := mitsui_prime_char_grid_partition_diff_le_uncond X hX m hm_ge_one C hC_bdd q hq ψ
  set Q : (NumberField.mixedEmbedding.index K → Fin (2 * m)) →
      Set (NumberField.mixedEmbedding.mixedSpace K) :=
    fun k => {z : NumberField.mixedEmbedding.mixedSpace K |
      ∀ i : NumberField.mixedEmbedding.index K,
        (NumberField.mixedEmbedding.stdBasis K).repr z i ∈
          Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
            ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))}
  set S_C : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      NumberField.mixedEmbedding K (π : K) ∈ C ∧
      IsUnit (Ideal.Quotient.mk q π)},
    ψ (Additive.ofMul π.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S_B : ℂ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧
      (∀ w : NumberField.InfinitePlace K, w (π : K) < X) ∧
      IsUnit (Ideal.Quotient.mk q π)},
    ψ (Additive.ofMul π.2.2.2.unit) *
      (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S_Q : (NumberField.mixedEmbedding.index K → Fin (2 * m)) → ℂ :=
    fun k => ∑' π : {π : NumberField.RingOfIntegers K //
        Prime π ∧
        (∀ i : NumberField.mixedEmbedding.index K,
          (NumberField.mixedEmbedding.stdBasis K).repr
              (NumberField.mixedEmbedding K (π : K)) i ∈
            Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))) ∧
        IsUnit (Ideal.Quotient.mk q π)},
      ψ (Additive.ofMul π.2.2.2.unit) *
        (Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ) : ℂ)
  set S_grid : ℂ := ∑' k : {k : NumberField.mixedEmbedding.index K → Fin (2 * m) // Q k ⊆ C},
    S_Q k.1
  set S_C_uncond : ℝ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧ NumberField.mixedEmbedding K (π : K) ∈ C},
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  set S_B_uncond : ℝ := ∑' π : {π : NumberField.RingOfIntegers K //
      Prime π ∧ ∀ w : NumberField.InfinitePlace K, w (π : K) < X},
    Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  set S_Q_uncond : (NumberField.mixedEmbedding.index K → Fin (2 * m)) → ℝ :=
    fun k => ∑' π : {π : NumberField.RingOfIntegers K //
        Prime π ∧
        ∀ i : NumberField.mixedEmbedding.index K,
          (NumberField.mixedEmbedding.stdBasis K).repr
              (NumberField.mixedEmbedding K (π : K)) i ∈
            Set.Ico ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ)))
              ((X / (m : ℝ)) * (((k i : ℕ) : ℝ) - (m : ℝ) + 1))},
      Real.log ((Algebra.norm ℤ (π : NumberField.RingOfIntegers K)).natAbs : ℝ)
  set S_grid_uncond : ℝ := ∑' k : {k : NumberField.mixedEmbedding.index K → Fin (2 * m) // Q k ⊆ C},
    S_Q_uncond k.1
  set V : ℝ := (MeasureTheory.volume C).toReal
  set V_grid : ℝ := ∑' k : {k : NumberField.mixedEmbedding.index K → Fin (2 * m) // Q k ⊆ C},
    (X / (m : ℝ)) ^ n
  set B_card : ℝ := (Nat.card {k : NumberField.mixedEmbedding.index K → Fin (2 * m) //
    (Q k ∩ C).Nonempty ∧ ¬ (Q k ⊆ C)} : ℝ)
  have h1' : B_card ≤ (2 : ℝ) ^ (3 * n) * (m : ℝ) ^ (n - 1) := h1
  have h2' : ‖S_B‖ ≤ c_box * X ^ n * (Real.log X + 1) := le_trans h5 h2
  have h3' : ‖S_C - S_grid‖ ≤ c_pack * B_card * (X / (m : ℝ)) ^ n * (Real.log X + 1) :=
    le_trans h6 h3
  have h4' : |V - V_grid| ≤ B_card * (X / (m : ℝ)) ^ n := h4
  have h_pow_cancel : (m : ℝ) ^ (n - 1) * (X / (m : ℝ)) ^ n = X ^ n * (m : ℝ)⁻¹ := by
    have hm_pow : (m : ℝ) ^ n = (m : ℝ) ^ (n - 1) * (m : ℝ) := by
      rw [← pow_succ, Nat.sub_add_cancel hn_ge_one]
    rw [div_pow, hm_pow]
    field_simp [hmR_ne]
  have h_bdry_vol : B_card * (X / (m : ℝ)) ^ n ≤ (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ := by
    calc B_card * (X / (m : ℝ)) ^ n
      _ ≤ ((2 : ℝ) ^ (3 * n) * (m : ℝ) ^ (n - 1)) * (X / (m : ℝ)) ^ n :=
          mul_le_mul_of_nonneg_right h1' (by positivity)
      _ = (2 : ℝ) ^ (3 * n) * ((m : ℝ) ^ (n - 1) * (X / (m : ℝ)) ^ n) := by ring
      _ = (2 : ℝ) ^ (3 * n) * (X ^ n * (m : ℝ)⁻¹) := by rw [h_pow_cancel]
      _ = (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ := by ring
  have h_bdry1 : ‖S_C - S_grid‖ ≤
      c_pack * (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ * (Real.log X + 1) := by
    calc ‖S_C - S_grid‖ ≤ c_pack * (B_card * (X / (m : ℝ)) ^ n) * (Real.log X + 1) := by
          linarith [h3']
      _ ≤ c_pack * ((2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹) * (Real.log X + 1) := by
          gcongr
      _ = c_pack * (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ * (Real.log X + 1) := by ring
  have h_bdry2 : ‖(((V_grid - V) / (F * X ^ n) : ℝ) : ℂ) * S_B‖ ≤
      (c_box / F) * (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ * (Real.log X + 1) := by
    have hFX_pos : 0 < F * X ^ n := by positivity
    have hFX_ne : F * X ^ n ≠ 0 := ne_of_gt hFX_pos
    have hF_ne : F ≠ 0 := ne_of_gt hF_pos
    have hYn_ne : X ^ n ≠ 0 := ne_of_gt hYn_pos
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_div, abs_sub_comm, abs_of_pos hFX_pos]
    have h_div_le : |V - V_grid| / (F * X ^ n) ≤
        ((2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹) / (F * X ^ n) :=
      div_le_div_of_nonneg_right (le_trans h4' h_bdry_vol) (le_of_lt hFX_pos)
    calc (|V - V_grid| / (F * X ^ n)) * ‖S_B‖
      _ ≤ (((2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹) / (F * X ^ n)) *
            (c_box * X ^ n * (Real.log X + 1)) :=
          mul_le_mul h_div_le h2' (norm_nonneg _) (by positivity)
      _ = (c_box / F) * (2 : ℝ) ^ (3 * n) * X ^ n * (m : ℝ)⁻¹ * (Real.log X + 1) := by
          field_simp [hF_ne, hYn_ne]
  have h_log_le : Real.log X + 1 ≤ (16 / c' ^ 2 + 1) * Real.exp (c' * u / 2) := by
    have h_exp4 : c' * u / 4 ≤ Real.exp (c' * u / 4) := by
      have h := Real.add_one_le_exp (c' * u / 4)
      linarith
    have h_sq4 : (c' * u / 4) ^ 2 ≤ (Real.exp (c' * u / 4)) ^ 2 :=
      pow_le_pow_left₀ (by positivity) h_exp4 2
    have h_exp_sq : (Real.exp (c' * u / 4)) ^ 2 = Real.exp (c' * u / 2) := by
      rw [sq, ← Real.exp_add]
      ring_nf
    rw [h_exp_sq] at h_sq4
    have hc'_sq_pos : 0 < c' ^ 2 := by positivity
    have h_u_sq_le : Real.log X ≤ (16 / c' ^ 2) * Real.exp (c' * u / 2) := by
