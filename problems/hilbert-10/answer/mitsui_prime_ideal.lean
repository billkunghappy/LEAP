  have hψ_one : ψ_f 1 = 1 := by
    have h1_ne : (1 : R) ≠ 0 := one_ne_zero
    have h1_mk : Ideal.Quotient.mk f 1 = 1 := map_one _
    rw [← h1_mk, ← hψ_span_F 1 h1_ne]
    exact hF_ray 1 h1_ne (by rw [sub_self]; exact f.zero_mem)
  have hψ_mul : ∀ a b : R ⧸ f, ψ_f (a * b) = ψ_f a * ψ_f b := by
