                ∑ w : NumberField.InfinitePlace K,
                  (l_ang w : ℝ) *
                    (w.embedding (((NumberField.Units.fundSystem K j : (NumberField.RingOfIntegers K)ˣ) : NumberField.RingOfIntegers K) : K)).arg) := by
