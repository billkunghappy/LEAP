    intro P hP j i
    rw [Matrix.scalar_apply, Matrix.diagonal_apply]
    split_ifs <;> [exact hP; exact polyDivPi_zero]
  have matDivPi_mul_left : ∀ {X Y}, matInt X → matDivPi Y → matDivPi (X * Y) := by
    intro X Y hX hY j i
    rw [Matrix.mul_apply]
    exact polyDivPi_sum _ _ fun r _ => polyDivPi_mul_left (hX j r) (hY r i)
  have matDivPi_mul_right : ∀ {X Y}, matDivPi X → matInt Y → matDivPi (X * Y) := by
    intro X Y hX hY j i
    rw [Matrix.mul_apply]
    exact polyDivPi_sum _ _ fun r _ => polyDivPi_mul_right (hX j r) (hY r i)
  have matDivPi_sum : ∀ {ι : Type} (s : Finset ι) (g : ι → Matrix (Fin q) (Fin q) (Polynomial E₀)),
      (∀ r ∈ s, matDivPi (g r)) → matDivPi (∑ r ∈ s, g r) := by
    intro ι s g hg j i
    rw [Matrix.sum_apply]
    exact polyDivPi_sum s (fun r => (g r) j i) fun r hr => hg r hr j i
  have h_aeval_mat_eq : ∀ (X : Matrix (Fin q) (Fin q) (Polynomial E₀)) (P : Polynomial E₀),
