    rw [← mul_sub]
    exact matDivPi_mul_left (matInt_scalar (polyInt_C (hP e))) (matDivPi_pow_sub hX hY hXY e)
  have polyInt_det : ∀ {X : Matrix (Fin q) (Fin q) (Polynomial E₀)},
      matInt X → polyInt X.det := by
    intro X hX
    rw [Matrix.det_apply]
    refine polyInt_sum _ _ fun σ _ => ?_
    rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with hsign | hsign
    · rw [hsign, one_smul]
      exact polyInt_prod _ _ fun i _ => hX (σ i) i
    · rw [hsign, Units.neg_smul, one_smul]
      exact polyInt_neg (polyInt_prod _ _ fun i _ => hX (σ i) i)
  have polyDivPi_det_sub : ∀ {X Y : Matrix (Fin q) (Fin q) (Polynomial E₀)},
      matInt X → matInt Y → matDivPi (X - Y) → polyDivPi (X.det - Y.det) := by
    intro X Y hX hY hXY
    rw [Matrix.det_apply, Matrix.det_apply, ← Finset.sum_sub_distrib]
    refine polyDivPi_sum _ _ fun σ _ => ?_
    rw [← smul_sub]
    apply polyDivPi_units_smul
    have h_prod_sub : ∀ (s : Finset (Fin q)),
        polyDivPi ((∏ i ∈ s, X (σ i) i) - (∏ i ∈ s, Y (σ i) i)) := by
      intro s
      induction s using Finset.cons_induction with
      | empty =>
        rw [Finset.prod_empty, Finset.prod_empty, sub_self]
        exact polyDivPi_zero
      | cons a s ha ih =>
        rw [Finset.prod_cons, Finset.prod_cons]
        have h_id : X (σ a) a * (∏ i ∈ s, X (σ i) i) - Y (σ a) a * (∏ i ∈ s, Y (σ i) i) =
            (X (σ a) a - Y (σ a) a) * (∏ i ∈ s, X (σ i) i) +
            Y (σ a) a * ((∏ i ∈ s, X (σ i) i) - (∏ i ∈ s, Y (σ i) i)) := by ring
        rw [h_id]
        exact polyDivPi_add
          (polyDivPi_mul_right (hXY (σ a) a) (polyInt_prod s _ fun i _ => hX (σ i) i))
          (polyDivPi_mul_left (hY (σ a) a) ih)
    exact h_prod_sub Finset.univ
  
  let C := relColemanCompanion F L E₀ π
  let M := Polynomial.aeval C A
  let M₀ := Polynomial.aeval C₀ A
  let N_A := relColemanNorm F L E₀ π A
  let A_q := relPolyCoeffPow A
  have hC_int : matInt C := by
    intro j i
    dsimp [C, relColemanCompanion]
    split_ifs
    · exact polyInt_one
    · exact polyInt_zero
    · exact polyInt_X
    · exact polyInt_neg (polyInt_C hπ_int)
    · exact polyInt_zero
  have hC₀_int : matInt C₀ := by
    intro j i
    rw [hC₀_apply]
    split_ifs
    · exact polyInt_one
    · exact polyInt_zero
    · exact polyInt_X
    · exact polyInt_zero
  have hC_sub_C₀ : matDivPi (C - C₀) := by
    intro j i
    change polyDivPi (C j i - C₀ j i)
    dsimp [C, C₀, relColemanCompanion]
    rw [map_zero, neg_zero]
    by_cases hlt : (i : ℕ) + 1 < qL F L
    · rw [if_pos hlt, if_pos hlt, sub_self]
      exact polyDivPi_zero
    · rw [if_neg hlt, if_neg hlt]
      by_cases hj0 : (j : ℕ) = 0
      · rw [if_pos hj0, if_pos hj0, sub_self]
        exact polyDivPi_zero
      · rw [if_neg hj0, if_neg hj0]
        by_cases hj1 : (j : ℕ) = 1
        · rw [if_pos hj1, if_pos hj1, sub_zero]
          exact polyDivPi_neg (polyDivPi_C h_pi_div_pi)
        · rw [if_neg hj1, if_neg hj1, sub_self]
          exact polyDivPi_zero
  have hM_int : matInt M := matInt_aeval hC_int hA_int
  have hM₀_int : matInt M₀ := matInt_aeval hC₀_int hA_int
  have hM_sub_M₀ : matDivPi (M - M₀) := matDivPi_aeval_sub hC_int hC₀_int hC_sub_C₀ hA_int
  have hNA_int : polyInt N_A := polyInt_det hM_int
  have hAq_int : polyInt A_q := polyInt_coeffPow hA_int
  
  have h_conj1 : polyValLe F E₀ 0 N_A := (polyValLe_zero_iff N_A).mpr hNA_int
  have h_conj2 : ∀ j i : Fin q, polyValLe F E₀ 0 (M j i) :=
    fun j i => (polyValLe_zero_iff (M j i)).mpr (hM_int j i)
  
  have h_trace_M₀_div : polyDivPi (Matrix.trace M₀) := by
    have h_tr_eq : Matrix.trace M₀ =
        ∑ e ∈ A.support, Polynomial.C (A.coeff e) * Matrix.trace (C₀ ^ e) := by
      dsimp [M₀]
      rw [h_aeval_mat_eq C₀ A, Matrix.trace_sum]
      refine Finset.sum_congr rfl fun e _ => ?_
      dsimp [Matrix.trace, Matrix.diag]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Matrix.diagonal_mul]
    rw [h_tr_eq]
    exact polyDivPi_sum _ _ fun e _ =>
      polyDivPi_mul_left (polyInt_C (hA_int e)) (h_trace_C₀_pow_div e)
  have h_trace_M_sub_M₀ : polyDivPi (Matrix.trace M - Matrix.trace M₀) := by
    rw [← Matrix.trace_sub]
    exact polyDivPi_sum _ _ fun i _ => hM_sub_M₀ i i
  have h_trace_M_div : polyDivPi (Matrix.trace M) := by
    have h := polyDivPi_add h_trace_M_sub_M₀ h_trace_M₀_div
    rwa [sub_add_cancel] at h
  have h_conj5 : polyValLe F E₀ 1 (Matrix.trace M) :=
    (polyValLe_one_iff (Matrix.trace M)).mpr h_trace_M_div
  
  have h_M₀_pow_sub_scalar : matDivPi (M₀ ^ q - Matrix.scalar (Fin q) A_q) := by
    have h_eq : M₀ ^ q - Matrix.scalar (Fin q) A_q =
        Polynomial.aeval C₀ (A ^ q - A_q.comp (Polynomial.X ^ q)) := by
      rw [map_sub, map_pow, h_aeval_C₀_comp A_q]
    rw [h_eq]
    exact matDivPi_aeval_of_polyDivPi hC₀_int (h_pow_qL_sub_comp hA_int)
  have h_M_pow_sub_M₀_pow : matDivPi (M ^ q - M₀ ^ q) :=
    matDivPi_pow_sub hM_int hM₀_int hM_sub_M₀ q
  have h_M_pow_sub_scalar_Aq : matDivPi (M ^ q - Matrix.scalar (Fin q) A_q) := by
    have h := matDivPi_add h_M_pow_sub_M₀_pow h_M₀_pow_sub_scalar
    rwa [sub_add_sub_cancel] at h
  have h_det_Mq_sub : polyDivPi ((M ^ q).det - (Matrix.scalar (Fin q) A_q).det) :=
    polyDivPi_det_sub (matInt_pow hM_int q) (matInt_scalar hAq_int) h_M_pow_sub_scalar_Aq
  have h_det_Mq : (M ^ q).det = N_A ^ q := Matrix.det_pow M q
  have h_det_scalar_Aq : (Matrix.scalar (Fin q) A_q).det = A_q ^ q := by
    rw [Matrix.scalar_apply, Matrix.det_diagonal, Finset.prod_const, Finset.card_univ,
      Fintype.card_fin]
  have h_NA_pow_sub_Aq_pow : polyDivPi (N_A ^ q - A_q ^ q) := by
    rwa [h_det_Mq, h_det_scalar_Aq] at h_det_Mq_sub
  have h_NA_sub_Aq : polyDivPi (N_A - A_q) :=
    h_polyDivPi_of_pow_qL_sub hNA_int hAq_int h_NA_pow_sub_Aq_pow
  
  have h_M_pow_sub_scalar_NA : matDivPi (M ^ q - Matrix.scalar (Fin q) N_A) := by
    have h_scalar_diff : Matrix.scalar (Fin q) N_A - Matrix.scalar (Fin q) A_q =
        Matrix.scalar (Fin q) (N_A - A_q) := (map_sub (Matrix.scalar (Fin q)) N_A A_q).symm
    have h1 : matDivPi (Matrix.scalar (Fin q) N_A - Matrix.scalar (Fin q) A_q) := by
      rw [h_scalar_diff]
      exact matDivPi_scalar h_NA_sub_Aq
    have h2 := matDivPi_sub h_M_pow_sub_scalar_Aq h1
    rwa [sub_sub_sub_cancel_right] at h2
  have h_conj4 : ∀ j i : Fin q,
      polyValLe F E₀ 1 ((M ^ q - Matrix.scalar (Fin q) N_A) j i) :=
    fun j i => (polyValLe_one_iff _).mpr (h_M_pow_sub_scalar_NA j i)
  
  have h_NA_sub_frob : polyDivPi (N_A - relPolyFrob F E₀ τ A) := by
    have h := polyDivPi_add h_NA_sub_Aq h_frob_congr
    rwa [sub_add_sub_cancel] at h
  have h_conj6 : polyValLe F E₀ 1 (N_A - relPolyFrob F E₀ τ A) :=
    (polyValLe_one_iff _).mpr h_NA_sub_frob
  
  have h_conj3 : A.coeff 0 ≠ 0 → valL F E₀ (A.coeff 0) = 0 →
      N_A.coeff 0 ≠ 0 ∧ valL F E₀ (N_A.coeff 0) = 0 := by
    intro ha0_ne ha0_val
    set w := A_q.coeff 0
    have hw_eq : w = (A.coeff 0) ^ q := h_coeffPow_coeff A 0
    have hw_ne : w ≠ 0 := by
      rw [hw_eq]
      exact pow_ne_zero q ha0_ne
    have hw_val : valL F E₀ w = 0 := by
      rw [hw_eq, valL_pow_elem ha0_ne q, ha0_val, mul_zero]
    have hw_not_div : ¬ IsIntegral 𝒪[F] (w / π) := by
      rw [div_pi_int_iff]
      rintro (h0 | hle)
      · exact hw_ne h0
      · omega
    have h_diff_div : IsIntegral 𝒪[F] ((N_A.coeff 0 - w) / π) := by
      have h := h_NA_sub_Aq 0
      rwa [Polynomial.coeff_sub] at h
    have hNA0_not_div : ¬ IsIntegral 𝒪[F] (N_A.coeff 0 / π) := by
      intro hdiv
      apply hw_not_div
      have h_id : w / π = N_A.coeff 0 / π - (N_A.coeff 0 - w) / π := by ring
      rw [h_id]
      exact IsIntegral.sub hdiv h_diff_div
    have hNA0_not_one : ¬ (N_A.coeff 0 = 0 ∨ 1 ≤ valL F E₀ (N_A.coeff 0)) :=
      mt (div_pi_int_iff (N_A.coeff 0)).mpr hNA0_not_div
    push_neg at hNA0_not_one
    obtain ⟨hNA0_ne, hNA0_lt1⟩ := hNA0_not_one
    have hNA0_nonneg : 0 ≤ valL F E₀ (N_A.coeff 0) :=
      ((mem_int_iff (N_A.coeff 0)).mp (hNA_int 0)).resolve_left hNA0_ne
    exact ⟨hNA0_ne, by omega⟩
  exact ⟨h_conj1, h_conj2, h_conj3, h_conj4, h_conj5, h_conj6⟩

theorem relColemanNorm_congr_succ_of_polyValLe (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E₀ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    [FiniteDimensional F E₀] (π : E₀) : valL F E₀ π = 1 →
    (∀ P : Polynomial E₀, polyValLe F E₀ 0 P →
      let M := Polynomial.aeval (relColemanCompanion F L E₀ π) P
      let N_P := relColemanNorm F L E₀ π P
      polyValLe F E₀ 0 N_P ∧
      (∀ j i : Fin (qL F L), polyValLe F E₀ 0 (M j i)) ∧
      (P.coeff 0 ≠ 0 → valL F E₀ (P.coeff 0) = 0 →
        N_P.coeff 0 ≠ 0 ∧ valL F E₀ (N_P.coeff 0) = 0) ∧
      (∀ j i : Fin (qL F L),
        polyValLe F E₀ 1 ((M ^ (qL F L) - Matrix.scalar (Fin (qL F L)) N_P) j i)) ∧
      polyValLe F E₀ 1 (Matrix.trace M)) →
    ∀ (k : ℕ), 1 ≤ k →
    ∀ (A B : Polynomial E₀),
      polyValLe F E₀ 0 A →
      polyValLe F E₀ 0 B →
      B.coeff 0 ≠ 0 →
      valL F E₀ (B.coeff 0) = 0 →
      polyValLe F E₀ k (A - B) →
      polyValLe F E₀ (k + 1) (relColemanNorm F L E₀ π A - relColemanNorm F L E₀ π B) :=
by
  intro hπ h_mod1 k hk A B hA hB hB0_ne hB0_val hAB
  have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem_K : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K],
      0 < resDeg F K ∧ ∃ π_K : Kˣ, relVal F K π_K = resDeg F K := by
    intro K _
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {m : ℕ | 0 < m ∧ ∃ z : K, z ≠ 0 ∧ relVal F K z = m}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F K, Module.finrank_pos, algebraMap F K u,
        (map_ne_zero (algebraMap F K)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F K (u : F)) = (u : F) ^ Module.finrank F K :=
        Algebra.norm_algebraMap (u : F)
      have hpow : addVal F ((u : F) ^ Module.finrank F K) =
          (Module.finrank F K : ℤ) * addVal F u := by
        change Multiplicative.toAdd (addValHom (u ^ Module.finrank F K)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  have hresL_pos : 0 < resDeg F L := (resDeg_mem_K L).1
  have hresL_ne : resDeg F L ≠ 0 := hresL_pos.ne'
  have hqF_gt1 : 1 < q F := by
    change 1 < Nat.card 𝓀[F]
    exact Finite.one_lt_card
  have hq_gt1 : 1 < qL F L := one_lt_pow₀ hqF_gt1 hresL_ne
  set q := qL F L
  have hq2 : 2 ≤ q := by omega
  have hq1 : 1 ≤ q := by omega
  obtain ⟨hresE₀_pos, π_ex, hπ_ex⟩ := resDeg_mem_K E₀
  have hfE₀_pos : (0 : ℤ) < (resDeg F E₀ : ℤ) := Nat.cast_pos.mpr hresE₀_pos
  have hfE₀_ne : (resDeg F E₀ : ℤ) ≠ 0 := hfE₀_pos.ne'
  let relValHom : E₀ˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : E₀ˣ, Multiplicative.toAdd (relValHom u) = relVal F E₀ u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : E₀ˣ,
      relVal F E₀ ((u * v : E₀ˣ) : E₀) = relVal F E₀ u + relVal F E₀ v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : E₀ˣ) (z : ℤ),
      relVal F E₀ ((u ^ z : E₀ˣ) : E₀) = z * relVal F E₀ u := by
    intro u z
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have relVal_eq_resDeg_mul_valL_E₀ : ∀ u : E₀ˣ,
      relVal F E₀ u = (resDeg F E₀ : ℤ) * valL F E₀ u := by
    intro u
    let q₀ := relVal F E₀ u / (resDeg F E₀ : ℤ)
    let r₀ := relVal F E₀ u % (resDeg F E₀ : ℤ)
    have hdiv : r₀ + (resDeg F E₀ : ℤ) * q₀ = relVal F E₀ u := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r₀ := Int.emod_nonneg _ (by positivity)
    have hrlt : r₀ < (resDeg F E₀ : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F E₀ ((u * π_ex ^ (-q₀) : E₀ˣ) : E₀) = r₀ := by
      rw [relVal_units_mul, relVal_units_zpow, hπ_ex]
      linarith
    have hr_eq : r₀ = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r₀.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r₀.toNat ∈ {m : ℕ | 0 < m ∧ ∃ z : E₀, z ≠ 0 ∧ relVal F E₀ z = m} := by
        refine ⟨hr_pos, ((u * π_ex ^ (-q₀) : E₀ˣ) : E₀), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F E₀ ≤ r₀.toNat := Nat.sInf_le hmem
      omega
    change relVal F E₀ u = (resDeg F E₀ : ℤ) * q₀
    linarith
  have valL_E₀_mul : ∀ v₁ v₂ : E₀ˣ,
      valL F E₀ ((v₁ * v₂ : E₀ˣ) : E₀) = valL F E₀ v₁ + valL F E₀ v₂ := by
    intro v₁ v₂
    have hrel := relVal_eq_resDeg_mul_valL_E₀ (v₁ * v₂)
    rw [relVal_units_mul, relVal_eq_resDeg_mul_valL_E₀ v₁,
      relVal_eq_resDeg_mul_valL_E₀ v₂] at hrel
    apply mul_left_cancel₀ hfE₀_ne
    linarith
  have valL_E₀_zpow : ∀ (v₁ : E₀ˣ) (z : ℤ),
      valL F E₀ ((v₁ ^ z : E₀ˣ) : E₀) = z * valL F E₀ v₁ := by
    intro v₁ z
    have hrel := relVal_eq_resDeg_mul_valL_E₀ (v₁ ^ z)
    rw [relVal_units_zpow, relVal_eq_resDeg_mul_valL_E₀ v₁] at hrel
    apply mul_left_cancel₀ hfE₀_ne
    linarith
  have valL_E₀_inv : ∀ v₁ : E₀ˣ,
      valL F E₀ ((v₁⁻¹ : E₀ˣ) : E₀) = -valL F E₀ v₁ := by
    intro v₁
    have h1 := valL_E₀_zpow v₁ (-1)
    rw [zpow_neg_one, neg_one_mul] at h1
    exact h1
  have valL_E₀_div_elem : ∀ {a b : E₀} (ha : a ≠ 0) (hb : b ≠ 0),
      valL F E₀ (a / b) = valL F E₀ a - valL F E₀ b := by
    intro a b ha hb
    have hab' : a / b ≠ 0 := div_ne_zero ha hb
    have h := valL_E₀_mul (Units.mk0 _ hab') (Units.mk0 _ hb)
    change valL F E₀ ((a / b) * b) = valL F E₀ (a / b) + valL F E₀ b at h
    rw [div_mul_cancel₀ _ hb] at h
    omega
  have hπ_ne : π ≠ 0 := by
    intro h0
    have h1 := hπ
    rw [h0] at h1
    simp [valL, relVal, addVal] at h1
  let π_u : E₀ˣ := Units.mk0 π hπ_ne
  have valL_π_pow : ∀ m : ℕ, valL F E₀ (π ^ m) = (m : ℤ) := by
    intro m
    change valL F E₀ (((π_u ^ (m : ℤ) : E₀ˣ) : E₀)) = (m : ℤ)
    rw [valL_E₀_zpow, show valL F E₀ π_u = 1 from hπ, mul_one]
  have isIntegral_aux : ∀ (K : Type u) [Field K] [Algebra F K] [FiniteDimensional F K] (x : K),
      IsIntegral 𝒪[F] x ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x) := by
    intro K _ _ _ x
    have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
        0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
      intro a ha
      unfold addVal
      rw [dif_neg ha]
      set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
      set va := valuation F a
      have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
      constructor
      · intro h_nonneg
        have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
        have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
        have h_iso : iso va ≤ iso 1 := by
          rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
          exact WithZero.coe_le_coe.mpr h_unzero
        exact (map_le_map_iff iso).mp h_iso
      · intro h_le
        have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
        have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
          Multiplicative.toAdd_le.mpr h_iso
        omega
    constructor
    · intro hx
      by_cases hx0 : x = 0
      · exact Or.inl hx0
      · right
        have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
