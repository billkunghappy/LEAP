  have h_rel_step : ∀ (K L_base Ω : Type u) [Field K] [Field L_base] [Field Ω]
      [Algebra K L_base] [Algebra K Ω] [Algebra L_base Ω] [IsScalarTower K L_base Ω]
      (q : ℕ), 2 ≤ q → ∀ (ϖ : K) (β_L : L_base) (π : Ω),
      algebraMap L_base Ω β_L = algebraMap K Ω ϖ * π + π ^ q →
      Module.finrank L_base (IntermediateField.adjoin L_base ({π} : Set Ω)) = q →
