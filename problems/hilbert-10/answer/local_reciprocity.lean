      (Polynomial.X ^ (q - 1) + Polynomial.C ϖ : Polynomial K).Monic →
      (Polynomial.X ^ (q - 1) + Polynomial.C ϖ : Polynomial K).natDegree = q - 1 →
      Irreducible (Polynomial.X ^ (q - 1) + Polynomial.C ϖ : Polynomial K) →
      ∀ (π₁ : Ω),
        Polynomial.aeval π₁ (Polynomial.X ^ (q - 1) + Polynomial.C ϖ : Polynomial K) = 0 →
        ∀ (A : Polynomial K),
          (Matrix.det (Polynomial.aeval (bareCompanion q ϖ) A)).coeff 0 =
            A.coeff 0 *
              Algebra.norm K
                (Polynomial.aeval
                  (⟨π₁, IntermediateField.mem_adjoin_simple_self K π₁⟩ :
                    IntermediateField.adjoin K ({π₁} : Set Ω)) A) := by
    clear! F L E₀ τ
    intro K Ω _ _ _ q ϖ hD₁_monic hD₁_deg hD₁_irr π₁ hπ₁ A
    let D₁ : Polynomial K := Polynomial.X ^ (q - 1) + Polynomial.C ϖ
    have hdeg_pos : 0 < D₁.natDegree := Irreducible.natDegree_pos hD₁_irr
    have hq2 : 2 ≤ q := by
      change 0 < (Polynomial.X ^ (q - 1) + Polynomial.C ϖ : Polynomial K).natDegree at hdeg_pos
