      ∀ (π β : Ω), IsIntegral K β → IsIntegral K π →
        β = Polynomial.aeval π (Polynomial.C ϖ * Polynomial.X + Polynomial.X ^ q) →
        Module.finrank K (IntermediateField.adjoin K ({β} : Set Ω)) = d →
        Module.finrank K (IntermediateField.adjoin K ({π} : Set Ω)) = d * q →
        ∀ (A : Polynomial K),
          Algebra.norm K
              (Polynomial.aeval
                (⟨β, IntermediateField.mem_adjoin_simple_self K β⟩ :
                  IntermediateField.adjoin K ({β} : Set Ω))
                (Matrix.det (Polynomial.aeval (bareCompanion q ϖ) A))) =
            Algebra.norm K
              (Polynomial.aeval
                (⟨π, IntermediateField.mem_adjoin_simple_self K π⟩ :
                  IntermediateField.adjoin K ({π} : Set Ω)) A) := by
    clear! F L E₀ τ h_base_companion
    intro K Ω _ _ _ q ϖ d hd hq2 π β h_int_β_K h_int_π_K hβ_eq h_fin_β h_fin_π A
    let K_β : IntermediateField K Ω := IntermediateField.adjoin K ({β} : Set Ω)
    let K_π : IntermediateField K Ω := IntermediateField.adjoin K ({π} : Set Ω)
    haveI : FiniteDimensional K K_β := IntermediateField.adjoin.finiteDimensional h_int_β_K
    haveI : FiniteDimensional K K_π := IntermediateField.adjoin.finiteDimensional h_int_π_K
    have hβ_exp : β = algebraMap K Ω ϖ * π + π ^ q := by
      rw [hβ_eq, map_add, map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
    have hπ_mem : π ∈ K_π := IntermediateField.mem_adjoin_simple_self K π
    have hβ_mem_Kπ : β ∈ K_π := by
      rw [hβ_exp]
      exact K_π.add_mem (K_π.mul_mem (K_π.algebraMap_mem ϖ) hπ_mem) (pow_mem hπ_mem q)
    have hβπ : K_β ≤ K_π := (IntermediateField.adjoin_simple_le_iff).mpr hβ_mem_Kπ
    let B : IntermediateField K_β Ω := IntermediateField.extendScalars hβπ
    let B_adj : IntermediateField K_β Ω := IntermediateField.adjoin K_β ({π} : Set Ω)
    haveI : FiniteDimensional K B := ‹FiniteDimensional K K_π›
    haveI : FiniteDimensional K_β B := FiniteDimensional.right K K_β B
    have hKπ_le : K_π ≤ B_adj.restrictScalars K := by
      rw [IntermediateField.adjoin_simple_le_iff]
      exact (IntermediateField.mem_restrictScalars K).mpr
        (IntermediateField.mem_adjoin_simple_self K_β π)
    have hB_eq : B = B_adj := by
      apply le_antisymm
      · intro z hz
        exact (IntermediateField.mem_restrictScalars K).mp
          (hKπ_le ((IntermediateField.mem_extendScalars hβπ).mp hz))
      · rw [IntermediateField.adjoin_simple_le_iff]
        exact (IntermediateField.mem_extendScalars hβπ).mpr hπ_mem
    have h_mul_fin : Module.finrank K K_β * Module.finrank K_β B = Module.finrank K B :=
      Module.finrank_mul_finrank K K_β B
    have h_fin_B_K : Module.finrank K B = d * q := h_fin_π
    have h_fin_B : Module.finrank K_β B = q := by
      rw [h_fin_β, h_fin_B_K] at h_mul_fin
      exact Nat.eq_of_mul_eq_mul_left hd h_mul_fin
    let e_B : B ≃ₐ[K_β] B_adj := IntermediateField.equivOfEq hB_eq
    have h_fin_Badj : Module.finrank K_β B_adj = q := by
      rw [← LinearEquiv.finrank_eq e_B.toLinearEquiv, h_fin_B]
    let β_tilde : K_β := ⟨β, IntermediateField.mem_adjoin_simple_self K β⟩
    have h_rel := h_rel_step K K_β Ω q hq2 ϖ β_tilde π hβ_exp h_fin_Badj A
    let α_adj : B_adj := ⟨π, IntermediateField.mem_adjoin_simple_self K_β π⟩
    let π_B : B := ⟨π, (IntermediateField.mem_extendScalars hβπ).mpr hπ_mem⟩
    let e_B_K : B ≃ₐ[K] B_adj := {
      toRingEquiv := e_B.toRingEquiv
      commutes' := fun a => by
        rw [IsScalarTower.algebraMap_apply K K_β B a,
          IsScalarTower.algebraMap_apply K K_β B_adj a]
        exact e_B.commutes (algebraMap K K_β a)
    }
    have h_eB_aeval : e_B (Polynomial.aeval π_B A) = Polynomial.aeval α_adj A := by
      calc e_B (Polynomial.aeval π_B A)
        _ = e_B_K (Polynomial.aeval π_B A) := rfl
        _ = Polynomial.aeval (e_B_K π_B) A :=
            (Polynomial.aeval_algHom_apply e_B_K.toAlgHom π_B A).symm
        _ = Polynomial.aeval α_adj A := rfl
    have h_norm_Kβ : Algebra.norm K_β (Polynomial.aeval α_adj A) =
        Algebra.norm K_β (Polynomial.aeval π_B A) := by
      rw [← h_eB_aeval]
      exact Algebra.norm_eq_of_algEquiv e_B (Polynomial.aeval π_B A)
    let e_π : B ≃ₐ[K] K_π := {
      toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hβπ).mp z.2⟩
      invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hβπ).mpr z.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl
    }
    have h_eπ_aeval : e_π (Polynomial.aeval π_B A) =
        Polynomial.aeval (⟨π, IntermediateField.mem_adjoin_simple_self K π⟩ : K_π) A :=
      (Polynomial.aeval_algHom_apply e_π.toAlgHom π_B A).symm
    rw [h_rel, h_norm_Kβ, Algebra.norm_norm,
      ← Algebra.norm_eq_of_algEquiv e_π (Polynomial.aeval π_B A), h_eπ_aeval]
  clear h_rel_step
  intro hτE₀
  have hτ_pow : ∀ (n : ℕ) (x : AlgebraicClosure F), x ∈ E₀ → (τ ^ n) x ∈ E₀ := by
    intro n
    induction n with
    | zero =>
      intro x hx
      simpa using hx
    | succ n ih =>
      intro x hx
      rw [pow_succ', AlgEquiv.mul_apply]
      exact hτE₀ _ (ih x hx)
  have h_coeff_coe : ∀ (x : E₀) (n : ℕ),
      ((relLubinTateCoeff F E₀ τ x n : E₀) : AlgebraicClosure F) =
        (τ ^ n) (x : AlgebraicClosure F) := by
    intro x n
    rw [relLubinTateCoeff, dif_pos (hτ_pow n (x : AlgebraicClosure F) x.2)]
  have h_coeff_zero : ∀ x : E₀, relLubinTateCoeff F E₀ τ x 0 = x := by
    intro x
    apply Subtype.ext
    rw [h_coeff_coe, pow_zero, AlgEquiv.one_apply]
  have h_coeff_shift : ∀ (ϖ : E₀) (j : ℕ),
      relLubinTateCoeff F E₀ τ (relLubinTateCoeff F E₀ τ ϖ 1) j =
        relLubinTateCoeff F E₀ τ ϖ (j + 1) := by
    intro ϖ j
    apply Subtype.ext
    rw [h_coeff_coe, h_coeff_coe, h_coeff_coe, ← AlgEquiv.mul_apply, ← pow_add]
  have h_poly_shift : ∀ (ϖ : E₀) (j : ℕ),
      relLubinTatePoly F L E₀ τ (relLubinTateCoeff F E₀ τ ϖ 1) j =
        relLubinTatePoly F L E₀ τ ϖ (j + 1) := by
    intro ϖ j
    dsimp [relLubinTatePoly]
    rw [h_coeff_shift]
  have h_iter_comp : ∀ (n : ℕ) (ϖ : E₀),
      relLubinTateIterPoly F L E₀ τ ϖ (n + 1) =
        (relLubinTateIterPoly F L E₀ τ (relLubinTateCoeff F E₀ τ ϖ 1) n).comp
          (relLubinTatePoly F L E₀ τ ϖ 0) := by
    intro n
    induction n with
    | zero =>
      intro ϖ
      change (relLubinTatePoly F L E₀ τ ϖ 0).comp Polynomial.X =
        Polynomial.X.comp (relLubinTatePoly F L E₀ τ ϖ 0)
      rw [Polynomial.comp_X, Polynomial.X_comp]
    | succ n ih =>
      intro ϖ
      change (relLubinTatePoly F L E₀ τ ϖ (n + 1)).comp
          (relLubinTateIterPoly F L E₀ τ ϖ (n + 1)) =
        ((relLubinTatePoly F L E₀ τ (relLubinTateCoeff F E₀ τ ϖ 1) n).comp
          (relLubinTateIterPoly F L E₀ τ (relLubinTateCoeff F E₀ τ ϖ 1) n)).comp
          (relLubinTatePoly F L E₀ τ ϖ 0)
      rw [ih ϖ, ← h_poly_shift ϖ n, Polynomial.comp_assoc]
  have h_div_comp : ∀ (k : ℕ), 1 ≤ k → ∀ (ϖ : E₀),
      relLubinTateDivPoly F L E₀ τ ϖ (k + 1) =
        (relLubinTateDivPoly F L E₀ τ (relLubinTateCoeff F E₀ τ ϖ 1) k).comp
          (relLubinTatePoly F L E₀ τ ϖ 0) := by
    intro k hk ϖ
    have hk_eq : (k - 1) + 1 = k := Nat.sub_add_cancel hk
    have h_iter_k : relLubinTateIterPoly F L E₀ τ ϖ k =
        (relLubinTateIterPoly F L E₀ τ (relLubinTateCoeff F E₀ τ ϖ 1) (k - 1)).comp
          (relLubinTatePoly F L E₀ τ ϖ 0) := by
      conv_lhs => rw [← hk_eq]
      exact h_iter_comp (k - 1) ϖ
    have h_coeff_k : relLubinTateCoeff F E₀ τ ϖ k =
        relLubinTateCoeff F E₀ τ (relLubinTateCoeff F E₀ τ ϖ 1) (k - 1) := by
      rw [h_coeff_shift ϖ (k - 1), hk_eq]
    dsimp [relLubinTateDivPoly]
    rw [h_iter_k, h_coeff_k, Polynomial.add_comp, Polynomial.pow_comp, Polynomial.C_comp]
  have h_normIter_shift : ∀ (n : ℕ) (ϖ : E₀) (A : Polynomial E₀),
      relColemanNormIter F L E₀ τ ϖ A (n + 1) =
        relColemanNormIter F L E₀ τ (relLubinTateCoeff F E₀ τ ϖ 1)
          (relColemanNorm F L E₀ ϖ A) n := by
    intro n
    induction n with
    | zero =>
      intro ϖ A
      change relColemanNorm F L E₀ (relLubinTateCoeff F E₀ τ ϖ 0) A =
        relColemanNorm F L E₀ ϖ A
      rw [h_coeff_zero]
    | succ n ih =>
      intro ϖ A
      change relColemanNorm F L E₀ (relLubinTateCoeff F E₀ τ ϖ (n + 1))
          (relColemanNormIter F L E₀ τ ϖ A (n + 1)) =
        relColemanNorm F L E₀ (relLubinTateCoeff F E₀ τ (relLubinTateCoeff F E₀ τ ϖ 1) n)
          (relColemanNormIter F L E₀ τ (relLubinTateCoeff F E₀ τ ϖ 1)
            (relColemanNorm F L E₀ ϖ A) n)
      rw [ih ϖ A, h_coeff_shift ϖ n]
  have h_main : ∀ (n : ℕ) (ϖ : E₀),
      (∀ (j k : ℕ), 1 ≤ k →
        let D_jk := relLubinTateDivPoly F L E₀ τ (relLubinTateCoeff F E₀ τ ϖ j) k
        D_jk.Monic ∧
        D_jk.natDegree = (qL F L - 1) * (qL F L) ^ (k - 1) ∧
        Irreducible D_jk) →
      ∀ (π : AlgebraicClosure F),
      Polynomial.aeval π (relLubinTateDivPoly F L E₀ τ ϖ (n + 1)) = 0 →
      ∀ (A : Polynomial E₀),
        (relColemanNormIter F L E₀ τ ϖ A (n + 1)).coeff 0 =
          (relColemanNormIter F L E₀ τ ϖ A n).coeff 0 *
            Algebra.norm E₀
              (Polynomial.aeval
                (⟨π, IntermediateField.mem_adjoin_simple_self E₀ π⟩ :
                  IntermediateField.adjoin E₀ ({π} : Set (AlgebraicClosure F))) A) := by
    intro n
    induction n with
    | zero =>
      intro ϖ hD_jk π hπ A
      have hD₁_eq : relLubinTateDivPoly F L E₀ τ ϖ 1 =
          Polynomial.X ^ (qL F L - 1) + Polynomial.C ϖ := by
        change (relLubinTateIterPoly F L E₀ τ ϖ 0) ^ (qL F L - 1) +
            Polynomial.C (relLubinTateCoeff F E₀ τ ϖ 0) = _
        rw [h_coeff_zero]
        rfl
      have h01 := hD_jk 0 1 le_rfl
      dsimp only at h01
      rw [h_coeff_zero, hD₁_eq, Nat.sub_self, pow_zero, mul_one] at h01
      rw [hD₁_eq] at hπ
      change (relColemanNorm F L E₀ (relLubinTateCoeff F E₀ τ ϖ 0) A).coeff 0 =
        A.coeff 0 * _
      rw [h_coeff_zero]
      exact h_base_companion E₀ (AlgebraicClosure F) (qL F L) ϖ h01.1 h01.2.1 h01.2.2 π hπ A
    | succ k' ih =>
      intro ϖ hD_jk π hπ A
      let k : ℕ := k' + 1
      have hk : 1 ≤ k := Nat.succ_pos k'
      let ϖ₁ := relLubinTateCoeff F E₀ τ ϖ 1
      let f₀ := relLubinTatePoly F L E₀ τ ϖ 0
      let β := Polynomial.aeval π f₀
      let A₁ := relColemanNorm F L E₀ ϖ A
      have hD_jk₁ : ∀ (j r : ℕ), 1 ≤ r →
          let D_jr := relLubinTateDivPoly F L E₀ τ (relLubinTateCoeff F E₀ τ ϖ₁ j) r
          D_jr.Monic ∧
          D_jr.natDegree = (qL F L - 1) * (qL F L) ^ (r - 1) ∧
          Irreducible D_jr := by
        intro j r hr
        dsimp only
        rw [h_coeff_shift ϖ j]
        exact hD_jk (j + 1) r hr
      have hβ : Polynomial.aeval β (relLubinTateDivPoly F L E₀ τ ϖ₁ k) = 0 := by
        have h1 : Polynomial.aeval π (relLubinTateDivPoly F L E₀ τ ϖ (k + 1)) = 0 := hπ
        rw [h_div_comp k hk ϖ, Polynomial.aeval_comp] at h1
        exact h1
      have h_ih := ih ϖ₁ hD_jk₁ β hβ A₁
      change (relColemanNormIter F L E₀ τ ϖ₁ A₁ k).coeff 0 =
        (relColemanNormIter F L E₀ τ ϖ₁ A₁ k').coeff 0 * _ at h_ih
      rw [← h_normIter_shift k ϖ A, ← h_normIter_shift k' ϖ A] at h_ih
      change (relColemanNormIter F L E₀ τ ϖ A (k + 1)).coeff 0 =
        (relColemanNormIter F L E₀ τ ϖ A k).coeff 0 * _
      rw [h_ih]
      congr 1
      have h01 := hD_jk 0 1 le_rfl
      dsimp only at h01
      rw [h_coeff_zero, Nat.sub_self, pow_zero, mul_one] at h01
      have hdeg1_pos : 0 < (relLubinTateDivPoly F L E₀ τ ϖ 1).natDegree :=
        Irreducible.natDegree_pos h01.2.2
      have hq2 : 2 ≤ qL F L := by omega
      let d : ℕ := (qL F L - 1) * (qL F L) ^ (k - 1)
      have hDβ_props := hD_jk₁ 0 k hk
      dsimp only at hDβ_props
      rw [h_coeff_zero] at hDβ_props
      let D_β := relLubinTateDivPoly F L E₀ τ ϖ₁ k
      have hdeg_β_pos : 0 < D_β.natDegree := Irreducible.natDegree_pos hDβ_props.2.2
      have hd_pos : 1 ≤ d := by
        have hdeg_eq : D_β.natDegree = d := hDβ_props.2.1
        omega
      have h_int_β : IsIntegral E₀ β := ⟨D_β, hDβ_props.1, hβ⟩
      have h_minpoly_β : D_β = minpoly E₀ β :=
        minpoly.eq_of_irreducible_of_monic hDβ_props.2.2 hβ hDβ_props.1
      have h_fin_β : Module.finrank E₀
          (IntermediateField.adjoin E₀ ({β} : Set (AlgebraicClosure F))) = d := by
        rw [IntermediateField.adjoin.finrank h_int_β, ← h_minpoly_β, hDβ_props.2.1]
      have hDπ_props := hD_jk 0 (k + 1) (by omega)
      dsimp only at hDπ_props
      rw [h_coeff_zero] at hDπ_props
      let D_π := relLubinTateDivPoly F L E₀ τ ϖ (k + 1)
      have h_int_π : IsIntegral E₀ π := ⟨D_π, hDπ_props.1, hπ⟩
      have h_minpoly_π : D_π = minpoly E₀ π :=
        minpoly.eq_of_irreducible_of_monic hDπ_props.2.2 hπ hDπ_props.1
      have h_deg_π_eq : D_π.natDegree = d * qL F L := by
        have h1 : D_π.natDegree = (qL F L - 1) * (qL F L) ^ k := hDπ_props.2.1
        have h_pow : (qL F L) ^ k = (qL F L) ^ (k - 1) * qL F L := by
          conv_lhs => rw [← Nat.sub_add_cancel hk]
          exact pow_succ (qL F L) (k - 1)
        rw [h1, h_pow, ← mul_assoc]
      have h_fin_π : Module.finrank E₀
          (IntermediateField.adjoin E₀ ({π} : Set (AlgebraicClosure F))) = d * qL F L := by
        rw [IntermediateField.adjoin.finrank h_int_π, ← h_minpoly_π, h_deg_π_eq]
      have hβ_eq : β = Polynomial.aeval π
          (Polynomial.C ϖ * Polynomial.X + Polynomial.X ^ qL F L) := by
        change Polynomial.aeval π
          (Polynomial.C (relLubinTateCoeff F E₀ τ ϖ 0) * Polynomial.X +
            Polynomial.X ^ qL F L) = _
        rw [h_coeff_zero]
      exact h_step_companion E₀ (AlgebraicClosure F) (qL F L) ϖ d hd_pos hq2 π β
        h_int_β h_int_π hβ_eq h_fin_β h_fin_π A
  intro ϖ hD_jk m hm π_m hπ_m A
  have hm_eq : (m - 1) + 1 = m := Nat.sub_add_cancel hm
  have hπ' : Polynomial.aeval π_m (relLubinTateDivPoly F L E₀ τ ϖ ((m - 1) + 1)) = 0 := by
    rw [hm_eq]
    exact hπ_m
  have h := h_main (m - 1) ϖ hD_jk π_m hπ' A
  rw [hm_eq] at h
  exact h

theorem relColemanNorm_frob_congr_and_pow_qL_and_trace (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E₀ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    [FiniteDimensional F E₀] (f₀ : ℕ) : 1 ≤ f₀ →
    resDeg F E₀ = resDeg F L * f₀ →
    ∀ (τ : AbsGal F),
    (∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ → τ ζ = ζ ^ qL F L) →
    (∀ x ∈ E₀, τ x ∈ E₀) →
    ∀ (π : E₀), valL F E₀ π = 1 →
    ∀ (A : Polynomial E₀), polyValLe F E₀ 0 A →
    let C := relColemanCompanion F L E₀ π
    let M := Polynomial.aeval C A
    let N_A := relColemanNorm F L E₀ π A
    polyValLe F E₀ 0 N_A ∧
    (∀ j i : Fin (qL F L), polyValLe F E₀ 0 (M j i)) ∧
    (A.coeff 0 ≠ 0 → valL F E₀ (A.coeff 0) = 0 →
      N_A.coeff 0 ≠ 0 ∧ valL F E₀ (N_A.coeff 0) = 0) ∧
    (∀ j i : Fin (qL F L),
      polyValLe F E₀ 1 ((M ^ (qL F L) - Matrix.scalar (Fin (qL F L)) N_A) j i)) ∧
    polyValLe F E₀ 1 (Matrix.trace M) ∧
    polyValLe F E₀ 1 (N_A - relPolyFrob F E₀ τ A) :=
by
  intro hf₀ hres_E₀ τ hτFrob hτE₀ π hπ A hA
  let q := qL F L
  let q_E₀ := qL F E₀
  let π_L := chosenUniformizer F L
  let π_E₀ := chosenUniformizer F E₀
  have hπ_L_val : valL F L π_L = 1 := (valL_chosenUniformizer_and_mul_zpow F L 1).1
  have hπ_E₀_val : valL F E₀ π_E₀ = 1 := (valL_chosenUniformizer_and_mul_zpow F E₀ 1).1
  have hresL_ne : resDeg F L ≠ 0 := by
    intro h0
    have h1 := hπ_L_val
    rw [valL, h0, Nat.cast_zero, Int.ediv_zero] at h1
    omega
  have hresE₀_ne : resDeg F E₀ ≠ 0 := by
    intro h0
    have h1 := hπ
    rw [valL, h0, Nat.cast_zero, Int.ediv_zero] at h1
    omega
  have hresL_pos : 0 < resDeg F L := Nat.pos_of_ne_zero hresL_ne
  have hresE₀_pos : 0 < resDeg F E₀ := Nat.pos_of_ne_zero hresE₀_ne
  have hfE₀_pos : (0 : ℤ) < (resDeg F E₀ : ℤ) := Nat.cast_pos.mpr hresE₀_pos
  have hfE₀_ne : (resDeg F E₀ : ℤ) ≠ 0 := hfE₀_pos.ne'
  haveI : Finite 𝓀[F] :=
    IsNonarchimedeanLocalField.instFiniteResidueFieldSubtypeMemSubringIntegerValueGroupWithZeroValuation F
  letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  haveI : CharP 𝓀[F] (p F) := ringChar.charP 𝓀[F]
  obtain ⟨n_p, hp_prime, hcard_p⟩ := FiniteField.card 𝓀[F] (p F)
  let e_p : ℕ := (n_p : ℕ) * resDeg F L
  let e_E₀ : ℕ := (n_p : ℕ) * resDeg F E₀
  have he_p_pos : 1 ≤ e_p := Nat.mul_pos n_p.2 hresL_pos
  have he_E₀_pos : 1 ≤ e_E₀ := Nat.mul_pos n_p.2 hresE₀_pos
  have hq_eq_p_pow : q = (p F) ^ e_p := by
    dsimp [q, qL, EllipticRootNumber.q, e_p]
    rw [Nat.card_eq_fintype_card, hcard_p, ← pow_mul]
  have hqE₀_eq_p_pow : q_E₀ = (p F) ^ e_E₀ := by
    dsimp [q_E₀, qL, EllipticRootNumber.q, e_E₀]
    rw [Nat.card_eq_fintype_card, hcard_p, ← pow_mul]
  have hq_two : 2 ≤ q := by
    rw [hq_eq_p_pow]
    calc 2 = 2 ^ 1 := (pow_one 2).symm
      _ ≤ (p F) ^ 1 := Nat.pow_le_pow_left hp_prime.two_le 1
      _ ≤ (p F) ^ e_p := Nat.pow_le_pow_right hp_prime.pos he_p_pos
  have hq1 : 1 ≤ q := by omega
  have hq_pos : 0 < q := by omega
  have hqE₀_two : 2 ≤ q_E₀ := by
    rw [hqE₀_eq_p_pow]
    calc 2 = 2 ^ 1 := (pow_one 2).symm
