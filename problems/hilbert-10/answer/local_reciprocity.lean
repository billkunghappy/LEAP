    have h_vpi_div : (v_bar * πbar) / πbar ∈ Sunram := by
      rw [mul_div_cancel_right₀ v_bar hπbar_ne]
      exact hv_unram
    have h_pi_div : πbar / πbar ∈ Sunram := by
      rw [div_self hπbar_ne]
      exact Sunram.one_mem
    have h_id : τψ.comp f₀_poly - fπ.comp ψ =
        (τψ.comp f₀_poly - τψ.comp (Polynomial.X ^ qL F L)) +
        (τψ.comp (Polynomial.X ^ qL F L) - ψ ^ qL F L) -
        Polynomial.C πbar * ψ := by
      rw [hfπ_eq]
      simp only [Polynomial.add_comp, Polynomial.mul_comp, Polynomial.C_comp,
        Polynomial.X_comp, Polynomial.pow_comp]
      ring
    rw [h_id]
