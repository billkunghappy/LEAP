  have h_tr_diff_div : polyDivPow 1
      (c * Matrix.trace H₀ - c * Matrix.trace (M_B ^ (q - 1) * D)) := by
    rw [← h_tr_diff_eq]
    apply polyDivPow_sum
    intro i _
    rw [Matrix.diag_apply, Matrix.mul_apply]
    apply polyDivPow_sum
    intro r _
    simpa using polyDivPow_mul (h_adj_diff_div i r) (hD_div r i)
  let P₁ : Polynomial E₀ := B ^ (q - 1) * Δ
  have hP₁_div : polyDivPow 0 P₁ := by
    have hB_pow_div : polyDivPow 0 (B ^ (q - 1)) :=
      polyDivPow_pow ((polyValLe_iff_polyDivPow 0 B).mp hB) (q - 1)
    simpa using polyDivPow_mul hB_pow_div hΔ_div
  have hP₁ : polyValLe F E₀ 0 P₁ := (polyValLe_iff_polyDivPow 0 P₁).mpr hP₁_div
  have h_tr_P₁ : polyValLe F E₀ 1 (Matrix.trace (M_B ^ (q - 1) * D)) := by
    have h_aeval_P₁ : Polynomial.aeval C P₁ = M_B ^ (q - 1) * D := by
