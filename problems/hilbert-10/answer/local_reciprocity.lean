            change algebraMap F L (c i / c i₀) * ω i = _
            rw [Algebra.smul_def, map_div₀, div_eq_inv_mul, mul_assoc]
          simp_rw [h_eq, ← Finset.mul_sum, hc_sum, mul_zero]
