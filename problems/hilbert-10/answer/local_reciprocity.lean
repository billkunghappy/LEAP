    fun hX hY j i => polyDivPi_add (hX j i) (hY j i)
  have matDivPi_sub : ∀ {X Y}, matDivPi X → matDivPi Y → matDivPi (X - Y) :=
    fun hX hY j i => polyDivPi_sub (hX j i) (hY j i)
  have matDivPi_scalar : ∀ {P : Polynomial E₀},
