theorem pow_dvd_add_sum_Icc_of_coprime_eq_and_pow_dvd_sub (p m : ℕ) :
    2 ≤ p → 1 ≤ m →
    ∀ (f : ℕ → ℕ),
      (∀ k < m, ∀ c : ℕ, 1 ≤ c → c * p ^ k < p ^ m → ¬ (p ∣ c) → f (c * p ^ k) = f (p ^ k)) →
      (∀ k : ℕ, 1 ≤ k → k < m → f (p ^ (k - 1)) ≤ f (p ^ k)) →
      (∀ k : ℕ, 1 ≤ k → k < m → p ^ k ∣ (f (p ^ k) - f (p ^ (k - 1)))) →
      p ^ m ∣ (f (p ^ (m - 1)) + ∑ r ∈ Finset.Icc 1 (p ^ m - 1), f r) :=
by
  intro hp hm f h_unit h_mono h_sen
  have h_ind : ∀ (n : ℕ), 1 ≤ n → ∀ (d : ℕ) (f : ℕ → ℕ),
      (∀ k < n, ∀ c : ℕ, 1 ≤ c → c * p ^ k < p ^ n → ¬ (p ∣ c) → f (c * p ^ k) = f (p ^ k)) →
      (∀ k : ℕ, 1 ≤ k → k < n → f (p ^ (k - 1)) ≤ f (p ^ k)) →
      (∀ k : ℕ, 1 ≤ k → k < n → p ^ (d + k) ∣ (f (p ^ k) - f (p ^ (k - 1)))) →
      p ^ n * f 1 ≤ f (p ^ (n - 1)) + ∑ r ∈ Finset.Icc 1 (p ^ n - 1), f r ∧
        p ^ (d + n) ∣ (f (p ^ (n - 1)) + ∑ r ∈ Finset.Icc 1 (p ^ n - 1), f r - p ^ n * f 1) := by
    refine Nat.le_induction ?_ ?_
    · intro d f h_unit _h_mono _h_sen
      have h_sum : ∑ r ∈ Finset.Icc 1 (p ^ 1 - 1), f r = (p - 1) * f 1 := by
        have h_eq : ∀ r ∈ Finset.Icc 1 (p ^ 1 - 1), f r = f 1 := by
          intro r hr
          rw [Finset.mem_Icc] at hr
          have hr_pos : 0 < r := by omega
          have hr_lt : r < p := by
            have : p ^ 1 = p := pow_one p
            omega
          have hnotdvd : ¬ (p ∣ r) := Nat.not_dvd_of_pos_of_lt hr_pos hr_lt
          have h_u := h_unit 0 (by omega) r hr.1 (by simpa [pow_zero, pow_one] using hr_lt) hnotdvd
          simpa [pow_zero] using h_u
        rw [Finset.sum_congr rfl h_eq, Finset.sum_const, smul_eq_mul, Nat.card_Icc]
        have : p ^ 1 = p := pow_one p
        have h_card : p ^ 1 - 1 + 1 - 1 = p - 1 := by omega
        rw [h_card]
