    toML_inj (by rw [toML_galApply, toML_mul, toML_mul, toML_galApply, toML_galApply, map_mul])
  have galApply_inv : ∀ (τ : Gbar) (y : M),
      galApply F hLM τ y⁻¹ = (galApply F hLM τ y)⁻¹ := fun τ y =>
    toML_inj (by rw [toML_galApply, toML_inv, toML_inv, toML_galApply, map_inv₀])
  let V : ℤ → M → Prop := fun k z => z = 0 ∨ k ≤ valL F M z
  have hV_add : ∀ (k : ℤ) {x y : M}, V k x → V k y → V k (x + y) :=
    fun k {_ _} hx hy => (hV_add_sub k hx hy).1
  have hV_sub : ∀ (k : ℤ) {x y : M}, V k x → V k y → V k (x - y) :=
    fun k {_ _} hx hy => (hV_add_sub k hx hy).2
  have valL_neg : ∀ z : M, valL F M (-z) = valL F M z := by
    intro z
    by_cases hz : z = 0
    · rw [hz, neg_zero]
    · have hnz : -z ≠ 0 := neg_ne_zero.mpr hz
      have h1 : valL F M z ≤ valL F M (-z) := by
        have hsub := hV_sub (valL F M z) (Or.inl rfl : V (valL F M z) 0) (Or.inr le_rfl)
        rw [zero_sub] at hsub
        rcases hsub with h0 | hle
        · exact False.elim (hnz h0)
        · exact hle
      have h2 : valL F M (-z) ≤ valL F M z := by
        have hsub := hV_sub (valL F M (-z)) (Or.inl rfl : V (valL F M (-z)) 0) (Or.inr le_rfl)
        rw [zero_sub, neg_neg] at hsub
        rcases hsub with h0 | hle
        · exact False.elim (hz h0)
        · exact hle
      omega
  have hV_mul : ∀ {k₁ k₂ : ℤ} {x y : M}, V k₁ x → V k₂ y → V (k₁ + k₂) (x * y) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rcases hx with rfl | hx
        · exact False.elim (hx0 rfl)
        · rcases hy with rfl | hy
          · exact False.elim (hy0 rfl)
          · rw [h_val_mul hx0 hy0]
            omega
  have hV_gal : ∀ (k : ℤ) (τ : Gbar) {x : M}, V k x → V k (galApply F hLM τ x) := by
    intro k τ x hx
    rcases hx with rfl | hx
    · left; exact galApply_zero τ
    · right; rw [h_val_gal]; exact hx
  have hπ_ne : π_M ≠ 0 := by
    intro h0
    have h1 := hπ_M
    rw [h0, h_val_zero_one.1] at h1
    omega
  have h_orbit_prod : ∀ (τ : Gbar) (μ : ℤ),
      ∃ g : M, g ≠ 0 ∧ valL F M g = μ ∧
        ((galApply F hLM (τ ^ μ.natAbs) π_M = π_M ∧ galApply F hLM τ g - g = 0) ∨
          (galApply F hLM (τ ^ μ.natAbs) π_M ≠ π_M ∧ galApply F hLM τ g - g ≠ 0 ∧
            valL F M (galApply F hLM τ g - g) =
              μ + valL F M (galApply F hLM (τ ^ μ.natAbs) π_M - π_M) - 1)) := by
    intro τ μ
    let g_nat : ℕ → M := fun r => ∏ j ∈ Finset.range r, galApply F hLM (τ ^ j) π_M
