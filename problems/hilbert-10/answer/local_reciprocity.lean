    clear! F L E₀ τ h_base_companion
    intro K L_base Ω _ _ _ _ _ _ _ q hq2 ϖ β_L π hβ_exp h_fin A
    let B_adj : IntermediateField L_base Ω := IntermediateField.adjoin L_base ({π} : Set Ω)
    let ϖ_L : L_base := algebraMap K L_base ϖ
    let Q : Polynomial L_base := Polynomial.C ϖ_L * Polynomial.X - Polynomial.C β_L
    let P : Polynomial L_base := Polynomial.X ^ q + Q
    have hQ_deg : Q.degree < (q : WithBot ℕ) := by
      have h1 : Q.degree ≤ max (Polynomial.C ϖ_L * Polynomial.X).degree (Polynomial.C β_L).degree :=
        Polynomial.degree_sub_le _ _
      have h2 : (Polynomial.C ϖ_L * Polynomial.X).degree ≤ 1 := Polynomial.degree_C_mul_X_le ϖ_L
      have h3 : (Polynomial.C β_L).degree ≤ 0 := Polynomial.degree_C_le
      have h4 : Q.degree ≤ ((1 : ℕ) : WithBot ℕ) := le_trans h1 (max_le h2 (le_trans h3 (by decide)))
      have h5 : ((1 : ℕ) : WithBot ℕ) < (q : WithBot ℕ) := WithBot.coe_lt_coe.mpr hq2
