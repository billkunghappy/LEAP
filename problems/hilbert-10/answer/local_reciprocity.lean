    have hgcd : Nat.gcd c (p F) = 1 :=
      (hp_prime.coprime_iff_not_dvd.mpr hnotdvd).symm.gcd_eq_one
    have h_bezout_int :
        (1 : ℤ) = (c : ℤ) * Nat.gcdA c (p F) + (p F : ℤ) * Nat.gcdB c (p F) := by
      have h := Nat.gcd_eq_gcd_ab c (p F)
      rw [hgcd, Nat.cast_one] at h
      exact h
    have h_bezout :
        (1 : M) = (c : M) * (Nat.gcdA c (p F) : M) + (p F : M) * (Nat.gcdB c (p F) : M) := by
      have h := congrArg (Int.cast : ℤ → M) h_bezout_int
      push_cast at h
      exact h
    have hc_not_V1 : ¬ V 1 (c : M) := by
      intro hc_V1
      have h1_raw : V (1 + 0) ((c : M) * (Nat.gcdA c (p F) : M)) :=
        hV_mul hc_V1 (hV_intCast (Nat.gcdA c (p F)))
      have h1 : V 1 ((c : M) * (Nat.gcdA c (p F) : M)) := hV_mono (by omega) h1_raw
      have h2_raw : V (1 + 0) ((p F : M) * (Nat.gcdB c (p F) : M)) :=
        hV_mul hp_val (hV_intCast (Nat.gcdB c (p F)))
      have h2 : V 1 ((p F : M) * (Nat.gcdB c (p F) : M)) := hV_mono (by omega) h2_raw
      have h_sum : V 1 ((c : M) * (Nat.gcdA c (p F) : M) + (p F : M) * (Nat.gcdB c (p F) : M)) :=
        hV_add 1 h1 h2
      rw [← h_bezout] at h_sum
      rcases h_sum with h0 | hle
      · exact one_ne_zero h0
      · rw [valL_one] at hle
        omega
    have hc_ne : (c : M) ≠ 0 := fun h0 => hc_not_V1 (Or.inl h0)
    have hc_val : valL F M (c : M) = 0 := by
      rcases hV_natCast c with h0 | hle
      · exfalso; exact hc_ne h0
      · by_contra hne
        have hle1 : 1 ≤ valL F M (c : M) := by omega
        exact hc_not_V1 (Or.inr hle1)
    have hcδ_ne : (c : M) * δ ≠ 0 := mul_ne_zero hc_ne hδ_ne
    have hcδ_val : valL F M ((c : M) * δ) = w_τ := by
      rw [valL_mul hc_ne hδ_ne, hc_val, zero_add]
    have h_decomp :
        galApply F hLM (τ ^ c) π_M - π_M =
          (c : M) * δ + (galApply F hLM (τ ^ c) π_M - π_M - (c : M) * δ) := by
      ring
    obtain ⟨h_sum_ne, h_sum_val⟩ :=
      h_val_add_of_lt w_τ hcδ_ne hcδ_val (h_lin τ hw c)
    rw [← h_decomp] at h_sum_ne h_sum_val
    exact ⟨sub_ne_zero.mp h_sum_ne, h_sum_val⟩
  have h_pow_p_le : ∀ (τ : Gbar), 2 ≤ valL F M (galApply F hLM τ π_M - π_M) → τ ^ (p F) ≠ 1 →
      valL F M (galApply F hLM τ π_M - π_M) + 1 ≤
        valL F M (galApply F hLM (τ ^ (p F)) π_M - π_M) := by
    intro τ hw hτp
    set w_τ : ℤ := valL F M (galApply F hLM τ π_M - π_M)
    set δ : M := galApply F hLM τ π_M - π_M
    have hpδ_raw : V (1 + w_τ) ((p F : M) * δ) :=
      hV_mul hp_val (Or.inr (le_refl w_τ))
    have hpδ : V (w_τ + 1) ((p F : M) * δ) := hV_mono (by omega) hpδ_raw
    have h_decomp :
        galApply F hLM (τ ^ (p F)) π_M - π_M =
          (p F : M) * δ + (galApply F hLM (τ ^ (p F)) π_M - π_M - (p F : M) * δ) := by
      ring
    have h_tot : V (w_τ + 1) (galApply F hLM (τ ^ (p F)) π_M - π_M) := by
      rw [h_decomp]
      exact hV_add (w_τ + 1) hpδ (h_lin τ hw (p F))
    have h_ne : galApply F hLM (τ ^ (p F)) π_M - π_M ≠ 0 :=
      sub_ne_zero.mpr (hM_ram (τ ^ (p F)) hτp).1
    rcases h_tot with h0 | hle
    · exfalso; exact h_ne h0
    · exact hle
  exact ⟨hp_prime, hp_val, ⟨valL_zero, valL_one⟩, valL_mul, valL_inv, valL_galApply,
    hV_add_sub, h_val_add_of_lt, h_shift, h_coprime_pow, h_pow_p_le⟩

theorem exists_orbit_prod_and_trace_valL_galApply_sub_eq (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (hLM : L ≤ M)
    (π_M : M) :
    valL F M π_M = 1 →
    ((p F : M) = 0 ∨ 1 ≤ valL F M (p F : M)) →
    (valL F M 0 = 0 ∧ valL F M 1 = 0) →
    (∀ {x y : M}, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) →
    (∀ {x : M}, x ≠ 0 → valL F M x⁻¹ = -valL F M x) →
    (∀ (τ : (IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM))
      (x : M), valL F M (galApply F hLM τ x) = valL F M x) →
    (∀ (k : ℤ) {x y : M}, (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
      (x + y = 0 ∨ k ≤ valL F M (x + y)) ∧ (x - y = 0 ∨ k ≤ valL F M (x - y))) →
    (∀ (τ : (IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM)),
      τ ≠ 1 → ∀ (μ : ℤ) (x : M), (x = 0 ∨ μ ≤ valL F M x) →
        galApply F hLM τ x - x = 0 ∨
          μ + (valL F M (galApply F hLM τ π_M - π_M) - 1) ≤ valL F M (galApply F hLM τ x - x)) →
    let Gbar := (IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM)
    (∀ (τ : Gbar) (μ : ℤ),
      ∃ g : M, g ≠ 0 ∧ valL F M g = μ ∧
        ((galApply F hLM (τ ^ μ.natAbs) π_M = π_M ∧ galApply F hLM τ g - g = 0) ∨
          (galApply F hLM (τ ^ μ.natAbs) π_M ≠ π_M ∧ galApply F hLM τ g - g ≠ 0 ∧
            valL F M (galApply F hLM τ g - g) =
              μ + valL F M (galApply F hLM (τ ^ μ.natAbs) π_M - π_M) - 1))) ∧
    (∀ (τ : Gbar), 2 ≤ valL F M (galApply F hLM τ π_M - π_M) →
      ∀ (s : ℤ) (ghat : M), (ghat = 0 ∨ s ≤ valL F M ghat) →
        ∃ h : M, (h = 0 ∨ s + 1 ≤ valL F M h) ∧
          galApply F hLM τ h - h = galApply F hLM (τ ^ (p F)) ghat - ghat) :=
by
  intro hπ_M hp_val h_val_zero_one h_val_mul h_val_inv h_val_gal hV_add_sub h_shift
  set M_L := IntermediateField.extendScalars hLM
  set Gbar := M_L ≃ₐ[L] M_L
  let toML : M → M_L := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLM).mpr y.2⟩
  have toML_inj : ∀ {y z : M}, toML y = toML z → y = z := fun h =>
    Subtype.ext (congrArg Subtype.val h)
  have toML_galApply : ∀ (τ : Gbar) (y : M), toML (galApply F hLM τ y) = τ (toML y) :=
    fun _ _ => Subtype.ext rfl
  have toML_zero : toML 0 = 0 := Subtype.ext rfl
  have toML_one : toML 1 = 1 := Subtype.ext rfl
  have toML_add : ∀ y z : M, toML (y + z) = toML y + toML z := fun _ _ => Subtype.ext rfl
  have toML_sub : ∀ y z : M, toML (y - z) = toML y - toML z := fun _ _ => Subtype.ext rfl
  have toML_mul : ∀ y z : M, toML (y * z) = toML y * toML z := fun _ _ => Subtype.ext rfl
  have toML_inv : ∀ y : M, toML y⁻¹ = (toML y)⁻¹ := fun _ => Subtype.ext rfl
  have galApply_one : ∀ y : M, galApply F hLM 1 y = y := fun y =>
    toML_inj (by rw [toML_galApply, AlgEquiv.one_apply])
  have galApply_mul_aut : ∀ (σ τ : Gbar) (y : M),
      galApply F hLM (σ * τ) y = galApply F hLM σ (galApply F hLM τ y) := fun σ τ y =>
    toML_inj (by rw [toML_galApply, toML_galApply, toML_galApply, AlgEquiv.mul_apply])
  have galApply_inv_left : ∀ (τ : Gbar) (y : M),
      galApply F hLM τ⁻¹ (galApply F hLM τ y) = y := fun τ y => by
    rw [← galApply_mul_aut, inv_mul_cancel, galApply_one]
  have galApply_zero : ∀ τ : Gbar, galApply F hLM τ 0 = 0 := fun τ =>
    toML_inj (by rw [toML_galApply, toML_zero, map_zero])
  have galApply_one_val : ∀ τ : Gbar, galApply F hLM τ 1 = 1 := fun τ =>
    toML_inj (by rw [toML_galApply, toML_one, map_one])
  have galApply_add : ∀ (τ : Gbar) (y z : M),
      galApply F hLM τ (y + z) = galApply F hLM τ y + galApply F hLM τ z := fun τ y z =>
    toML_inj (by rw [toML_galApply, toML_add, toML_add, toML_galApply, toML_galApply, map_add])
  have galApply_sub : ∀ (τ : Gbar) (y z : M),
      galApply F hLM τ (y - z) = galApply F hLM τ y - galApply F hLM τ z := fun τ y z =>
    toML_inj (by rw [toML_galApply, toML_sub, toML_sub, toML_galApply, toML_galApply, map_sub])
  have galApply_mul : ∀ (τ : Gbar) (y z : M),
