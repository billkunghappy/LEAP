          _ = (c + Ck * H₀ a a) * P_S -
              (c * c ^ n + Ck * c ^ n * H₀ a a + Ck * (c ^ n * sum_S)) := by ring
          _ = (c + Ck * H₀ a a) * P_S -
              (c * c ^ n + Ck * c ^ n * H₀ a a + Ck * (c * (c ^ (n - 1) * sum_S))) := by
              rw [hc_mul_pow]
          _ = (c + Ck * H₀ a a) * (P_S - (c ^ n + Ck * c ^ (n - 1) * sum_S)) +
              Ck * (Ck * (H₀ a a * c ^ (n - 1) * sum_S)) := by ring
      rw [h_alg]
      apply polyDivPow_add
      · have h_factor0 : polyDivPow 0 (c + Ck * H₀ a a) := by
          rw [← hN_diag a]
          exact hN_div0 a a
        simpa using polyDivPow_mul h_factor0 ih
      · rw [two_mul]
        apply polyDivPow_mul (polyDivPow_C_pow k)
        have h_pow_c : polyDivPow 0 (c ^ (n - 1)) := polyDivPow_pow hc_div (n - 1)
        have h_sum_S : polyDivPow 0 sum_S :=
          polyDivPow_sum (fun i _ => hH₀_div i i)
        have h_inner : polyDivPow 0 (H₀ a a * c ^ (n - 1) * sum_S) := by
          have h1 : polyDivPow 0 (H₀ a a * c ^ (n - 1)) :=
            by simpa using polyDivPow_mul (hH₀_div a a) h_pow_c
          simpa using polyDivPow_mul h1 h_sum_S
        have h2 := polyDivPow_mul (polyDivPow_C_pow k) h_inner
        rwa [add_zero] at h2
  have h_diag_univ : polyDivPow (2 * k)
      ((∏ i : Fin q, N i i) - (c ^ q + Polynomial.C (π ^ k) * c ^ (q - 1) * Matrix.trace H₀)) := by
    have h := h_diag_S Finset.univ
    have h_prod_eq : (∏ i : Fin q, N i i) = ∏ i ∈ Finset.univ, (c + Polynomial.C (π ^ k) * H₀ i i) :=
