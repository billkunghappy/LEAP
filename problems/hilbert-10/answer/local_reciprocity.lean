      intro k hk
      rw [← Polynomial.map_sub, Polynomial.coeff_map, hD_le k hk, map_zero]
    have h_fπ_comp_sub : ∀ k ≤ m + 1,
        (fπ.comp ψ - fπ.comp ϕ).coeff k = πbar * D.coeff k := by
      intro k hk
      have h_id : fπ.comp ψ - fπ.comp ϕ =
          Polynomial.C πbar * D + (ψ ^ qL F L - ϕ ^ qL F L) := by
        rw [hfπ_eq]
        dsimp [D]
        simp only [Polynomial.add_comp, Polynomial.mul_comp, Polynomial.C_comp,
          Polynomial.X_comp, Polynomial.pow_comp]
        ring
      rw [h_id, Polynomial.coeff_add, Polynomial.coeff_C_mul,
        h_qL_sub_vanish m hψ0 hϕ0 hD_le k hk, add_zero]
    refine ⟨fun k hk => ?_, ?_⟩
    · have h1 : (τψ.comp f₀_poly).coeff k = (τϕ.comp f₀_poly).coeff k := by
        apply sub_eq_zero.mp
        rw [← Polynomial.coeff_sub, h_comp_right_vanish m hf₀_coeff_0 hτD_le k hk]
      have h2 : (fπ.comp ψ).coeff k = (fπ.comp ϕ).coeff k := by
        apply sub_eq_zero.mp
        rw [← Polynomial.coeff_sub, h_fπ_comp_sub k (by omega), hD_le k hk, mul_zero]
      rw [Polynomial.coeff_sub, Polynomial.coeff_sub, h1, h2]
    · have h_comp_f₀_succ : (τψ.comp f₀_poly - τϕ.comp f₀_poly).coeff (m + 1) =
