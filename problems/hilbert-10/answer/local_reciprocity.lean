          by_contra h_ne
          have h_unit : IsUnit (a (Fin.last r)) :=
            (IsLocalRing.residue_ne_zero_iff_isUnit (a (Fin.last r))).mp h_ne
          obtain ⟨u, hu⟩ := h_unit
          let u_inv : 𝒪[F] := ↑(u⁻¹)
          have hu_mul : u_inv * a (Fin.last r) = 1 := by
            rw [← hu]
            exact Units.inv_mul u
          have h_u_inv_int : IsIntegral 𝒪[F] (algebraMap 𝒪[F] L u_inv) := isIntegral_algebraMap
          have h_mul_int := IsIntegral.mul h_u_inv_int ha_int
          let b : Fin r → 𝒪[F] := fun i => -(u_inv * a i.castSucc)
          have h_alg : algebraMap 𝒪[F] L u_inv *
              ((∑ j : Fin (r + 1), algebraMap 𝒪[F] L (a j) * ω' j) / πL) =
              (x₀ - ∑ i : Fin r, algebraMap 𝒪[F] L (b i) * ω i) / πL := by
            rw [h_sum_split, ← mul_div_assoc]
            congr 1
            have h1 : algebraMap 𝒪[F] L u_inv * (algebraMap 𝒪[F] L (a (Fin.last r)) * x₀) = x₀ := by
              rw [← mul_assoc, ← map_mul, hu_mul, map_one, one_mul]
            have h2 : algebraMap 𝒪[F] L u_inv *
                (∑ i : Fin r, algebraMap 𝒪[F] L (a i.castSucc) * ω i) =
                -(∑ i : Fin r, algebraMap 𝒪[F] L (b i) * ω i) := by
              rw [Finset.mul_sum, ← Finset.sum_neg_distrib]
              refine Finset.sum_congr rfl fun i _ => ?_
              simp only [b, map_neg, map_mul, neg_mul, neg_neg, mul_assoc]
            rw [mul_add, h1, h2]
            ring
          rw [h_alg] at h_mul_int
          exact hx₀_not b h_mul_int
        have h_last_div_int : IsIntegral 𝒪[F] ((algebraMap 𝒪[F] L (a (Fin.last r)) * x₀) / πL) := by
          rw [mul_div_right_comm]
          exact IsIntegral.mul (h_res_zero_div_int (a (Fin.last r)) h_last) hx₀_int
        have h_init_int : IsIntegral 𝒪[F]
            ((∑ i : Fin r, algebraMap 𝒪[F] L (a i.castSucc) * ω i) / πL) := by
          have h_sub := IsIntegral.sub ha_int h_last_div_int
          have h_eq : ((∑ j : Fin (r + 1), algebraMap 𝒪[F] L (a j) * ω' j) / πL) -
              ((algebraMap 𝒪[F] L (a (Fin.last r)) * x₀) / πL) =
              (∑ i : Fin r, algebraMap 𝒪[F] L (a i.castSucc) * ω i) / πL := by
            rw [h_sum_split, add_div, add_sub_cancel_right]
          rwa [h_eq] at h_sub
        have h_init := hP3 (fun i => a i.castSucc) h_init_int
        intro j
        refine Fin.lastCases h_last (fun i => h_init i) j
    have h_basis_ind : ∀ (k : ℕ) (r : ℕ), Module.finrank F L - r ≤ k →
        ∀ (ω : Fin r → L), P1 r ω → P3 r ω →
        ∃ (f₀ : ℕ) (ω₀ : Fin f₀ → L), P1 f₀ ω₀ ∧ P2 f₀ ω₀ ∧ P3 f₀ ω₀ := by
      intro k
      induction k with
      | zero =>
        intro r hr ω hP1 hP3
        by_cases hP2 : P2 r ω
        · exact ⟨r, ω, hP1, hP2, hP3⟩
        · obtain ⟨ω', hP1', hP3'⟩ := h_step r ω hP1 hP3 hP2
          have hle := h_le_finrank (r + 1) ω' hP3'
          omega
      | succ k ih =>
        intro r hr ω hP1 hP3
        by_cases hP2 : P2 r ω
        · exact ⟨r, ω, hP1, hP2, hP3⟩
        · obtain ⟨ω', hP1', hP3'⟩ := h_step r ω hP1 hP3 hP2
          have hle := h_le_finrank (r + 1) ω' hP3'
          exact ih (r + 1) (by omega) ω' hP1' hP3'
    obtain ⟨f₀, ω, hω_int, hω_span, hω_ind⟩ :=
      h_basis_ind (Module.finrank F L) 0 (by omega) Fin.elim0
        (fun i => Fin.elim0 i) (fun _ _ i => Fin.elim0 i)
    obtain ⟨uF, huF⟩ := exists_addVal_eq_one
    set πF : F := (uF : F)
    have hπF0 : πF ≠ 0 := uF.ne_zero
    have hπF_L0 : algebraMap F L πF ≠ 0 := (map_ne_zero (algebraMap F L)).mpr hπF0
    have h_finrank_rel : (Module.finrank F L : ℤ) =
        (resDeg F L : ℤ) * valL F L (algebraMap F L πF) := by
      have h1 := relVal_algebraMap hπF0
      rw [huF, mul_one, relVal_eq hπF_L0] at h1
      exact h1.symm
    have h_finrank_pos : 0 < Module.finrank F L := Module.finrank_pos
    have h_valL_πF_pos : 0 < valL F L (algebraMap F L πF) := by
      by_contra hle
      have hle0 : valL F L (algebraMap F L πF) ≤ 0 := by omega
      have hnp : (resDeg F L : ℤ) * valL F L (algebraMap F L πF) ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos (by omega) hle0
      omega
    let e : ℕ := (valL F L (algebraMap F L πF)).toNat
    have he_eq : (e : ℤ) = valL F L (algebraMap F L πF) :=
      Int.toNat_of_nonneg (by omega)
    have he_pos : 0 < e := by omega
    have h_finrank_eq : Module.finrank F L = resDeg F L * e := by
      have h : (Module.finrank F L : ℤ) = (resDeg F L * e : ℕ) := by
        push_cast
        rw [he_eq]
        exact h_finrank_rel
      exact Nat.cast_injective h
    have valL_algebraMap : ∀ {c : F} (hc : c ≠ 0),
        valL F L (algebraMap F L c) = (e : ℤ) * addVal F c := by
      intro c hc
      have hcL0 : algebraMap F L c ≠ 0 := (map_ne_zero (algebraMap F L)).mpr hc
      have h1 := relVal_algebraMap hc
      rw [relVal_eq hcL0, h_finrank_rel, ← he_eq, mul_assoc] at h1
      exact mul_left_cancel₀ (by positivity) h1
    have h_comb : ∀ (c : Fin f₀ → F), (∃ i, c i ≠ 0) →
        (∑ i, c i • ω i ≠ 0) ∧ ∃ m : ℤ, valL F L (∑ i, c i • ω i) = (e : ℤ) * m := by
      intro c ⟨i₁, hi₁⟩
      let S : Finset (Fin f₀) := Finset.univ.filter (fun i => c i ≠ 0)
      have hS_ne : S.Nonempty := ⟨i₁, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi₁⟩⟩
      obtain ⟨i₀, hi₀S, hi₀_min⟩ := Finset.exists_min_image S (fun i => addVal F (c i)) hS_ne
      have hci₀ : c i₀ ≠ 0 := (Finset.mem_filter.mp hi₀S).2
      have h_val_div : ∀ i : Fin f₀, valuation F (c i / c i₀) ≤ 1 := by
        intro i
        by_cases hci : c i = 0
        · rw [hci, zero_div, map_zero]
          exact zero_le_one
        · apply (addVal_nonneg_iff_val_le_one (div_ne_zero hci hci₀)).mp
          rw [addVal_div hci hci₀]
          have hiS : i ∈ S := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hci⟩
          have hle := hi₀_min i hiS
          omega
      let a : Fin f₀ → 𝒪[F] := fun i => ⟨c i / c i₀, h_val_div i⟩
      set s₀ : L := ∑ i : Fin f₀, algebraMap 𝒪[F] L (a i) * ω i
      have hs_eq : ∑ i : Fin f₀, c i • ω i = algebraMap F L (c i₀) * s₀ := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        change c i • ω i = algebraMap F L (c i₀) * (algebraMap F L (c i / c i₀) * ω i)
        rw [Algebra.smul_def, ← mul_assoc, ← map_mul, mul_div_cancel₀ _ hci₀]
      have ha_i₀ : a i₀ = 1 := Subtype.ext (div_self hci₀)
      have h_not_div : ¬ IsIntegral 𝒪[F] (s₀ / πL) := by
        intro hdiv
        have hres := hω_ind a hdiv i₀
        rw [ha_i₀, map_one] at hres
        exact one_ne_zero hres
      have hs₀_ne : s₀ ≠ 0 := by
        intro h0
        apply h_not_div
        rw [h0, zero_div]
        exact isIntegral_zero
      have hs_ne : ∑ i : Fin f₀, c i • ω i ≠ 0 := by
        rw [hs_eq]
        exact mul_ne_zero ((map_ne_zero (algebraMap F L)).mpr hci₀) hs₀_ne
      have hs₀_int : IsIntegral 𝒪[F] s₀ :=
        (integralClosure 𝒪[F] L).sum_mem fun i _ =>
          (integralClosure 𝒪[F] L).mul_mem isIntegral_algebraMap (hω_int i)
      have hs₀_val_nonneg : 0 ≤ valL F L s₀ := (h_int_valL hs₀_ne).mp hs₀_int
      have hs₀_val_lt : valL F L s₀ < 1 := by
        by_contra hge
        apply h_not_div
        rw [h_int_valL (div_ne_zero hs₀_ne hπL_ne), valL_div hs₀_ne hπL_ne, hπ_val]
        omega
      have hs₀_val_zero : valL F L s₀ = 0 := by omega
      refine ⟨hs_ne, addVal F (c i₀), ?_⟩
      rw [hs_eq, valL_mul ((map_ne_zero (algebraMap F L)).mpr hci₀) hs₀_ne,
        valL_algebraMap hci₀, hs₀_val_zero, add_zero]
    let B : Fin f₀ × Fin e → L := fun p => ω p.1 * πL ^ (p.2 : ℕ)
    have hB_li : LinearIndependent F B := by
      rw [Fintype.linearIndependent_iff]
      intro c hc_sum
      let s : Fin e → L := fun j => ∑ i : Fin f₀, c (i, j) • ω i
      have h_sum_s : ∑ j : Fin e, s j * πL ^ (j : ℕ) = 0 := by
        rw [← hc_sum, Fintype.sum_prod_type_right]
        refine Finset.sum_congr rfl fun j _ => ?_
        simp only [s, B, Finset.sum_mul, smul_mul_assoc]
      have hs_all_zero : ∀ j : Fin e, s j = 0 := by
        by_contra h_not
        push_neg at h_not
        obtain ⟨j₁, hj₁⟩ := h_not
        let T : Finset (Fin e) := Finset.univ.filter (fun j => s j ≠ 0)
        have hT_ne : T.Nonempty := ⟨j₁, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj₁⟩⟩
        let t : Fin e → L := fun j => s j * πL ^ (j : ℕ)
        have ht_ne : ∀ j ∈ T, t j ≠ 0 := by
          intro j hjT
          exact mul_ne_zero (Finset.mem_filter.mp hjT).2 (pow_ne_zero _ hπL_ne)
        have ht_mod : ∀ j ∈ T, valL F L (t j) % (e : ℤ) = (j : ℤ) := by
          intro j hjT
          have hsj : s j ≠ 0 := (Finset.mem_filter.mp hjT).2
          have hex : ∃ i, c (i, j) ≠ 0 := by
            by_contra h_all0
            push_neg at h_all0
            apply hsj
            simp [s, h_all0]
          obtain ⟨-, m, hm⟩ := h_comb (fun i => c (i, j)) hex
          have h_val_t : valL F L (t j) = (j : ℤ) + (e : ℤ) * m := by
            change valL F L (s j * πL ^ (j : ℕ)) = _
            rw [valL_mul hsj (pow_ne_zero _ hπL_ne), hm, valL_pow hπL_ne, hπ_val, mul_one, add_comm]
          rw [h_val_t, Int.add_mul_emod_self_left, Int.emod_eq_of_lt (by positivity) (by omega)]
        obtain ⟨j₀, hj₀T, hj₀_min⟩ := Finset.exists_min_image T (fun j => valL F L (t j)) hT_ne
        have h_strict : ∀ j ∈ T.erase j₀, valL F L (t j₀) + 1 ≤ valL F L (t j) := by
          intro j hj
          have hj_ne : j ≠ j₀ := (Finset.mem_erase.mp hj).1
          have hjT : j ∈ T := (Finset.mem_erase.mp hj).2
          have hle := hj₀_min j hjT
          have hne_val : valL F L (t j) ≠ valL F L (t j₀) := by
            intro heq
            have hmod : valL F L (t j) % (e : ℤ) = valL F L (t j₀) % (e : ℤ) :=
              congrArg (fun z => z % (e : ℤ)) heq
            rw [ht_mod j hjT, ht_mod j₀ hj₀T] at hmod
            exact hj_ne (Fin.ext (Int.ofNat.inj hmod))
          omega
        have h_sum_T : ∑ j ∈ T, t j = 0 := by
          rw [← h_sum_s]
          refine Finset.sum_subset (Finset.subset_univ T) fun j _ hjT => ?_
          have hsj0 : s j = 0 := by
            by_contra hsj
            exact hjT (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hsj⟩)
          simp [t, hsj0]
        have h_erase_sum : ∑ j ∈ T.erase j₀, t j = -t j₀ := by
          have h := Finset.add_sum_erase T t hj₀T
          rw [h_sum_T] at h
          linear_combination h
        have h_div_sum_int : IsIntegral 𝒪[F]
            (∑ j ∈ T.erase j₀, ((t j / t j₀) / πL)) := by
          refine (integralClosure 𝒪[F] L).sum_mem fun j hj => ?_
          have hjT : j ∈ T := (Finset.mem_erase.mp hj).2
          have h_ne1 : t j / t j₀ ≠ 0 := div_ne_zero (ht_ne j hjT) (ht_ne j₀ hj₀T)
          have h_ne2 : (t j / t j₀) / πL ≠ 0 := div_ne_zero h_ne1 hπL_ne
          change IsIntegral 𝒪[F] ((t j / t j₀) / πL)
          rw [h_int_valL h_ne2, valL_div h_ne1 hπL_ne, valL_div (ht_ne j hjT) (ht_ne j₀ hj₀T), hπ_val]
          have hlt := h_strict j hj
          omega
        have h_sum_eq : (∑ j ∈ T.erase j₀, ((t j / t j₀) / πL)) = (-1 : L) / πL := by
          rw [← Finset.sum_div, ← Finset.sum_div, h_erase_sum, neg_div,
            div_self (ht_ne j₀ hj₀T)]
        rw [h_sum_eq] at h_div_sum_int
        have h_neg1_ne : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have h_neg1_val : valL F L (-1 : L) = 0 := by
          have hsq : valL F L ((-1 : L) * (-1 : L)) = valL F L (-1 : L) + valL F L (-1 : L) :=
            valL_mul h_neg1_ne h_neg1_ne
          rw [neg_mul_neg, mul_one, valL_one] at hsq
          omega
        have h_contra := (h_int_valL (div_ne_zero h_neg1_ne hπL_ne)).mp h_div_sum_int
        rw [valL_div h_neg1_ne hπL_ne, h_neg1_val, hπ_val] at h_contra
        omega
      intro ⟨i, j⟩
      by_contra hcij
      obtain ⟨hne, -⟩ := h_comb (fun i' => c (i', j)) ⟨i, hcij⟩
      exact hne (hs_all_zero j)
    let V : Submodule F L := Submodule.span F (Set.range B)
    have h_m_step : ∀ (m : ℕ), m ≤ e → ∀ x : L, IsIntegral 𝒪[F] x →
        ∃ v ∈ V, ∃ z : L, IsIntegral 𝒪[F] z ∧ x = v + πL ^ m * z := by
      intro m
      induction m with
      | zero =>
        intro _ x hx
        exact ⟨0, V.zero_mem, x, hx, by simp⟩
      | succ m ih =>
        intro hm x hx
        obtain ⟨v₁, hv₁, z₁, hz₁, hxz₁⟩ := ih (by omega) x hx
        obtain ⟨a, ha⟩ := hω_span z₁ hz₁
        set z₂ : L := (z₁ - ∑ i : Fin f₀, algebraMap 𝒪[F] L (a i) * ω i) / πL
        have hz₁_eq : z₁ = (∑ i : Fin f₀, algebraMap 𝒪[F] L (a i) * ω i) + πL * z₂ := by
          rw [mul_div_cancel₀ _ hπL_ne, add_sub_cancel]
        let jm : Fin e := ⟨m, by omega⟩
        let v₂ : L := ∑ i : Fin f₀, (a i : F) • B (i, jm)
        have hv₂ : v₂ ∈ V :=
          V.sum_mem fun i _ => V.smul_mem _ (Submodule.subset_span ⟨(i, jm), rfl⟩)
        have hv₂_eq : v₂ = πL ^ m * ∑ i : Fin f₀, algebraMap 𝒪[F] L (a i) * ω i := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          change (a i : F) • (ω i * πL ^ m) = πL ^ m * (algebraMap 𝒪[F] L (a i) * ω i)
          rw [Algebra.smul_def]
          change algebraMap F L (a i : F) * (ω i * πL ^ m) =
            πL ^ m * (algebraMap F L (a i : F) * ω i)
          ring
        refine ⟨v₁ + v₂, V.add_mem hv₁ hv₂, z₂, ha, ?_⟩
        rw [hxz₁, hz₁_eq, mul_add, ← hv₂_eq, pow_succ, mul_assoc, add_assoc]
    have h_int_in_V : ∀ x : L, IsIntegral 𝒪[F] x → x ∈ V := by
      apply h_span V πF hπF0 (by omega)
      intro x hx
      obtain ⟨v, hv, z, hz, hxz⟩ := h_m_step e (le_refl e) x hx
      set u : L := πL ^ e / algebraMap F L πF
      have hu_ne : u ≠ 0 := div_ne_zero (pow_ne_zero e hπL_ne) hπF_L0
      have hu_int : IsIntegral 𝒪[F] u := by
        rw [h_int_valL hu_ne, valL_div (pow_ne_zero e hπL_ne) hπF_L0,
          valL_pow hπL_ne, hπ_val, mul_one, ← he_eq, sub_self]
      refine ⟨v, hv, u * z, IsIntegral.mul hu_int hz, ?_⟩
      rw [hxz, Algebra.smul_def, ← mul_assoc, mul_div_cancel₀ _ hπF_L0]
    have hV_top : V = ⊤ := by
      rw [Submodule.eq_top_iff']
      intro x
      by_cases hx0 : x = 0
      · rw [hx0]
        exact V.zero_mem
      · let k : ℕ := (-valL F L x).toNat
        have hk_ge : -valL F L x ≤ (k : ℤ) := by omega
        have h_smul_ne : (πF ^ k) • x ≠ 0 :=
          smul_ne_zero (pow_ne_zero k hπF0) hx0
        have h_smul_int : IsIntegral 𝒪[F] ((πF ^ k) • x) := by
          rw [h_int_valL h_smul_ne, Algebra.smul_def,
            valL_mul ((map_ne_zero (algebraMap F L)).mpr (pow_ne_zero k hπF0)) hx0,
            map_pow, valL_pow hπF_L0, ← he_eq]
          nlinarith
        have h_mem := h_int_in_V ((πF ^ k) • x) h_smul_int
        have h_inv := V.smul_mem ((πF ^ k)⁻¹) h_mem
        rwa [inv_smul_smul₀ (pow_ne_zero k hπF0)] at h_inv
    let bL : Module.Basis (Fin f₀ × Fin e) F L :=
      Module.Basis.mk hB_li (by change ⊤ ≤ V; rw [hV_top])
    have h_finrank_B : Module.finrank F L = f₀ * e := by
      rw [Module.finrank_eq_card_basis bL, Fintype.card_prod, Fintype.card_fin, Fintype.card_fin]
    have hf₀ : f₀ = resDeg F L := by nlinarith
    have h_quot_pow : ∀ {R : Type u} [CommRing R] (I : Ideal R) [I.IsMaximal] [Fintype (R ⧸ I)]
        (x : R), Ideal.Quotient.mk I (x ^ Fintype.card (R ⧸ I)) = Ideal.Quotient.mk I x := by
      intro R _ I _ _ x
      letI : Field (R ⧸ I) := Ideal.Quotient.field I
      rw [map_pow]
      exact FiniteField.pow_card (Ideal.Quotient.mk I x)
    have hπL_int : IsIntegral 𝒪[F] πL :=
      (h_int_valL hπL_ne).mpr (by rw [hπ_val]; omega)
    let π₀ : integralClosure 𝒪[F] L := ⟨πL, hπL_int⟩
    have mem_I_iff : ∀ x : integralClosure 𝒪[F] L,
        x ∈ Ideal.span {π₀} ↔ IsIntegral 𝒪[F] ((x : L) / πL) := by
      intro x
      rw [Ideal.mem_span_singleton]
      constructor
      · rintro ⟨y, hy⟩
        have hx : (x : L) = πL * (y : L) := congrArg Subtype.val hy
        rw [hx, mul_div_cancel_left₀ (y : L) hπL_ne]
        exact y.2
      · intro hdiv
        refine ⟨⟨(x : L) / πL, hdiv⟩, Subtype.ext ?_⟩
        exact (mul_div_cancel₀ (x : L) hπL_ne).symm
    haveI hI_max : (Ideal.span {π₀}).IsMaximal := by
      rw [Ideal.isMaximal_iff]
      refine ⟨?_, ?_⟩
      · intro h1
        rw [mem_I_iff] at h1
        have h1_ne : (1 : L) / πL ≠ 0 := div_ne_zero one_ne_zero hπL_ne
        have hval := (h_int_valL h1_ne).mp h1
        rw [valL_div one_ne_zero hπL_ne, valL_one, hπ_val] at hval
        omega
      · intro J x hIJ hxI hxJ
        have hx0 : (x : L) ≠ 0 := by
          intro h0
          apply hxI
          rw [mem_I_iff, h0, zero_div]
          exact isIntegral_zero
        have hx_val_nonneg : 0 ≤ valL F L (x : L) := (h_int_valL hx0).mp x.2
        have hx_val_lt : valL F L (x : L) < 1 := by
          by_contra hge
          apply hxI
          rw [mem_I_iff, h_int_valL (div_ne_zero hx0 hπL_ne), valL_div hx0 hπL_ne, hπ_val]
          omega
        have hx_val_zero : valL F L (x : L) = 0 := by omega
        have hinv_int : IsIntegral 𝒪[F] ((x : L)⁻¹) := by
          rw [h_int_valL (inv_ne_zero hx0), ← one_div, valL_div one_ne_zero hx0,
            valL_one, hx_val_zero, sub_zero]
        let y : integralClosure 𝒪[F] L := ⟨(x : L)⁻¹, hinv_int⟩
        have hyx : y * x = 1 := Subtype.ext (inv_mul_cancel₀ hx0)
        rw [← hyx]
        exact J.mul_mem_left y hxJ
    haveI : Finite 𝓀[F] :=
      IsNonarchimedeanLocalField.instFiniteResidueFieldSubtypeMemSubringIntegerValueGroupWithZeroValuation F
    letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
    let rep : 𝓀[F] → 𝒪[F] := fun b => (IsLocalRing.residue_surjective b).choose
    have hrep : ∀ b : 𝓀[F], IsLocalRing.residue 𝒪[F] (rep b) = b :=
      fun b => (IsLocalRing.residue_surjective b).choose_spec
    have hsum_int : ∀ b : Fin f₀ → 𝓀[F],
        IsIntegral 𝒪[F] (∑ i : Fin f₀, algebraMap 𝒪[F] L (rep (b i)) * ω i) :=
      fun b => (integralClosure 𝒪[F] L).sum_mem
        fun i _ => (integralClosure 𝒪[F] L).mul_mem isIntegral_algebraMap (hω_int i)
    let Ψ : (Fin f₀ → 𝓀[F]) → (integralClosure 𝒪[F] L ⧸ Ideal.span {π₀}) :=
      fun b => Ideal.Quotient.mk (Ideal.span {π₀})
        ⟨∑ i : Fin f₀, algebraMap 𝒪[F] L (rep (b i)) * ω i, hsum_int b⟩
    have hΨ_inj : Function.Injective Ψ := by
      intro b₁ b₂ hEq
      have hmem : (⟨∑ i : Fin f₀, algebraMap 𝒪[F] L (rep (b₁ i)) * ω i, hsum_int b₁⟩ :
          integralClosure 𝒪[F] L) -
          ⟨∑ i : Fin f₀, algebraMap 𝒪[F] L (rep (b₂ i)) * ω i, hsum_int b₂⟩ ∈ Ideal.span {π₀} :=
        Ideal.Quotient.eq.mp hEq
      rw [mem_I_iff] at hmem
      have hval : ((⟨∑ i : Fin f₀, algebraMap 𝒪[F] L (rep (b₁ i)) * ω i, hsum_int b₁⟩ -
          ⟨∑ i : Fin f₀, algebraMap 𝒪[F] L (rep (b₂ i)) * ω i, hsum_int b₂⟩ :
          integralClosure 𝒪[F] L) : L) =
          ∑ i : Fin f₀, algebraMap 𝒪[F] L (rep (b₁ i) - rep (b₂ i)) * ω i := by
        change (∑ i : Fin f₀, algebraMap 𝒪[F] L (rep (b₁ i)) * ω i) -
            (∑ i : Fin f₀, algebraMap 𝒪[F] L (rep (b₂ i)) * ω i) = _
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_sub, sub_mul]
      rw [hval] at hmem
      have hind := hω_ind (fun i => rep (b₁ i) - rep (b₂ i)) hmem
      funext i
      have hi := hind i
      rw [map_sub, hrep, hrep, sub_eq_zero] at hi
      exact hi
    have hΨ_surj : Function.Surjective Ψ := by
      intro q
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective q
      obtain ⟨a, ha⟩ := hω_span (x : L) x.2
      let b : Fin f₀ → 𝓀[F] := fun i => IsLocalRing.residue 𝒪[F] (a i)
      refine ⟨b, ?_⟩
      apply Ideal.Quotient.eq.mpr
      rw [mem_I_iff]
      have hdiff_sum : IsIntegral 𝒪[F]
          ((∑ i : Fin f₀, algebraMap 𝒪[F] L (rep (b i) - a i) * ω i) / πL) := by
        have h_eq : (∑ i : Fin f₀, algebraMap 𝒪[F] L (rep (b i) - a i) * ω i) / πL =
            ∑ i : Fin f₀, (algebraMap 𝒪[F] L (rep (b i) - a i) / πL) * ω i := by
          rw [Finset.sum_div]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [div_mul_eq_mul_div]
        rw [h_eq]
        refine (integralClosure 𝒪[F] L).sum_mem fun i _ =>
          (integralClosure 𝒪[F] L).mul_mem ?_ (hω_int i)
        apply h_res_zero_div_int
        rw [map_sub, hrep, sub_self]
      have h_sub := (integralClosure 𝒪[F] L).sub_mem hdiff_sum ha
      have h_alg : ((∑ i : Fin f₀, algebraMap 𝒪[F] L (rep (b i) - a i) * ω i) / πL) -
          (((x : L) - ∑ i : Fin f₀, algebraMap 𝒪[F] L (a i) * ω i) / πL) =
          (((⟨∑ i : Fin f₀, algebraMap 𝒪[F] L (rep (b i)) * ω i, hsum_int b⟩ :
            integralClosure 𝒪[F] L) - x : integralClosure 𝒪[F] L) : L) / πL := by
        change _ = ((∑ i : Fin f₀, algebraMap 𝒪[F] L (rep (b i)) * ω i) - (x : L)) / πL
        rw [← sub_div]
        congr 1
        have h1 : ∑ i : Fin f₀, algebraMap 𝒪[F] L (rep (b i) - a i) * ω i =
            (∑ i : Fin f₀, algebraMap 𝒪[F] L (rep (b i)) * ω i) -
            (∑ i : Fin f₀, algebraMap 𝒪[F] L (a i) * ω i) := by
          rw [← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [map_sub, sub_mul]
        rw [h1]
        ring
      rwa [h_alg] at h_sub
    let eΨ : (Fin f₀ → 𝓀[F]) ≃ (integralClosure 𝒪[F] L ⧸ Ideal.span {π₀}) :=
      Equiv.ofBijective Ψ ⟨hΨ_inj, hΨ_surj⟩
    letI : Fintype (integralClosure 𝒪[F] L ⧸ Ideal.span {π₀}) :=
      Fintype.ofEquiv (Fin f₀ → 𝓀[F]) eΨ
    have hcard : Fintype.card (integralClosure 𝒪[F] L ⧸ Ideal.span {π₀}) = qL F L := by
      rw [Fintype.ofEquiv_card eΨ, Fintype.card_fun, Fintype.card_fin, hf₀, qL, q,
        Nat.card_eq_fintype_card]
    intro c hc
    let c₀ : integralClosure 𝒪[F] L := ⟨c, hc⟩
    have hfermat : Ideal.Quotient.mk (Ideal.span {π₀}) (c₀ ^ qL F L) =
        Ideal.Quotient.mk (Ideal.span {π₀}) c₀ := by
      rw [← hcard]
      exact h_quot_pow (Ideal.span {π₀}) c₀
    have hmem : c₀ ^ qL F L - c₀ ∈ Ideal.span {π₀} := Ideal.Quotient.eq.mp hfermat
    rw [mem_I_iff] at hmem
    exact hmem
  let f : Polynomial L := lubinTatePoly F L πL
  have hres_ne : resDeg F L ≠ 0 := by omega
  have hq : 1 < q F := by
    unfold q
    exact Finite.one_lt_card
  have hqL : 1 < qL F L := Nat.one_lt_pow hres_ne hq
  have mem_int_iff : ∀ z : L, IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ valL F L z := by
    intro z
    rcases eq_or_ne z 0 with rfl | hz
    · simp [isIntegral_zero]
    · rw [h_int_valL hz, or_iff_right hz]
  have mem_div_pi : ∀ {z : L}, IsIntegral 𝒪[F] (z / πL) → z = 0 ∨ ((1 : ℕ) : ℤ) ≤ valL F L z := by
    intro z hz
    rcases eq_or_ne z 0 with rfl | hne
    · exact Or.inl rfl
    · right
      have hdiv_ne : z / πL ≠ 0 := div_ne_zero hne hπL_ne
      have hval_nonneg : 0 ≤ valL F L (z / πL) := (h_int_valL hdiv_ne).mp hz
      rw [valL_div hne hπL_ne, hπ_val] at hval_nonneg
      omega
  have isIntegral_sum : ∀ {ι : Type} (s : Finset ι) (g : ι → L),
      (∀ i ∈ s, IsIntegral 𝒪[F] (g i)) → IsIntegral 𝒪[F] (∑ i ∈ s, g i) := by
    intro ι s g hg
    induction s using Finset.cons_induction with
    | empty => exact isIntegral_zero
    | cons x s hx ih =>
      rw [Finset.sum_cons]
      exact IsIntegral.add (hg x (Finset.mem_cons_self x s))
        (ih fun i hi => hg i (Finset.mem_cons.mpr (Or.inr hi)))
  have hπ_mem : IsIntegral 𝒪[F] πL := (mem_int_iff πL).mpr (Or.inr (by omega))
  let polyInt : Polynomial L → Prop := fun P => ∀ k : ℕ, IsIntegral 𝒪[F] (P.coeff k)
  have polyInt_zero : polyInt 0 := fun k => by
    rw [Polynomial.coeff_zero]
    exact isIntegral_zero
  have polyInt_one : polyInt 1 := fun k => by
    rw [Polynomial.coeff_one]
    split_ifs <;> [exact isIntegral_one; exact isIntegral_zero]
  have polyInt_X : polyInt Polynomial.X := fun k => by
    rw [Polynomial.coeff_X]
    split_ifs <;> [exact isIntegral_one; exact isIntegral_zero]
  have polyInt_C : ∀ {c : L}, IsIntegral 𝒪[F] c → polyInt (Polynomial.C c) := fun hc k => by
    rw [Polynomial.coeff_C]
    split_ifs <;> [exact hc; exact isIntegral_zero]
  have isIntegral_natCast : ∀ m : ℕ, IsIntegral 𝒪[F] (m : L) := by
    intro m
    induction m with
    | zero =>
      rw [Nat.cast_zero]
      exact isIntegral_zero
    | succ m ih =>
      rw [Nat.cast_succ]
      exact IsIntegral.add ih isIntegral_one
  have polyInt_natCast : ∀ m : ℕ, polyInt (m : Polynomial L) := by
    intro m
    rw [← Polynomial.C_eq_natCast]
    exact polyInt_C (isIntegral_natCast m)
  have polyInt_monomial : ∀ (j : ℕ) {c : L},
      IsIntegral 𝒪[F] c → polyInt (Polynomial.monomial j c) := by
    intro j c hc k
    rw [Polynomial.coeff_monomial]
    split_ifs <;> [exact hc; exact isIntegral_zero]
  have polyInt_add : ∀ {P Q : Polynomial L}, polyInt P → polyInt Q → polyInt (P + Q) :=
    fun hP hQ k => by
      rw [Polynomial.coeff_add]
      exact IsIntegral.add (hP k) (hQ k)
  have polyInt_mul : ∀ {P Q : Polynomial L}, polyInt P → polyInt Q → polyInt (P * Q) :=
    fun hP hQ k => by
      rw [Polynomial.coeff_mul]
      exact isIntegral_sum _ _ fun x _ => IsIntegral.mul (hP x.1) (hQ x.2)
  have polyInt_pow : ∀ {P : Polynomial L}, polyInt P → ∀ e : ℕ, polyInt (P ^ e) := by
    intro P hP e
    induction e with
    | zero => exact polyInt_one
    | succ e ih =>
      rw [pow_succ]
      exact polyInt_mul ih hP
  have polyInt_sum : ∀ {ι : Type} (s : Finset ι) (g : ι → Polynomial L),
      (∀ i ∈ s, polyInt (g i)) → polyInt (∑ i ∈ s, g i) := by
    intro ι s g hg k
    rw [Polynomial.finset_sum_coeff]
    exact isIntegral_sum s (fun i => (g i).coeff k) fun i hi => hg i hi k
  have polyInt_f : polyInt f :=
    polyInt_add (polyInt_mul (polyInt_C hπ_mem) polyInt_X) (polyInt_pow polyInt_X (qL F L))
  let polyDivPi : Polynomial L → Prop := fun P => ∀ k : ℕ, IsIntegral 𝒪[F] (P.coeff k / πL)
  have polyDivPi_zero : polyDivPi 0 := fun k => by
    rw [Polynomial.coeff_zero, zero_div]
    exact isIntegral_zero
  have polyDivPi_add : ∀ {P Q : Polynomial L}, polyDivPi P → polyDivPi Q → polyDivPi (P + Q) :=
    fun hP hQ k => by
      rw [Polynomial.coeff_add, add_div]
      exact IsIntegral.add (hP k) (hQ k)
  have polyDivPi_sub : ∀ {P Q : Polynomial L}, polyDivPi P → polyDivPi Q → polyDivPi (P - Q) :=
    fun hP hQ k => by
      rw [Polynomial.coeff_sub, sub_div]
      exact IsIntegral.sub (hP k) (hQ k)
  have polyDivPi_C_mul : ∀ {c : L} {Q : Polynomial L}, IsIntegral 𝒪[F] (c / πL) → polyInt Q →
      polyDivPi (Polynomial.C c * Q) := by
    intro c Q hc hQ k
    rw [Polynomial.coeff_C_mul, mul_div_right_comm]
    exact IsIntegral.mul hc (hQ k)
  have polyDivPi_mul_right : ∀ {P Q : Polynomial L}, polyDivPi P → polyInt Q →
      polyDivPi (P * Q) := by
    intro P Q hP hQ k
    rw [Polynomial.coeff_mul, Finset.sum_div]
    refine isIntegral_sum _ _ fun x _ => ?_
    rw [mul_div_right_comm]
    exact IsIntegral.mul (hP x.1) (hQ x.2)
  have h_pi_div_pi : IsIntegral 𝒪[F] (πL / πL) := by
    rw [div_self hπL_ne]
    exact isIntegral_one
  have h_f_pow_sub : ∀ e : ℕ, polyDivPi (f ^ e - (Polynomial.X ^ qL F L) ^ e) := by
    intro e
    induction e with
    | zero =>
      rw [pow_zero, pow_zero, sub_self]
      exact polyDivPi_zero
    | succ e ih =>
      have h_id : f ^ (e + 1) - (Polynomial.X ^ qL F L) ^ (e + 1) =
          Polynomial.C πL * (Polynomial.X * f ^ e) +
            (f ^ e - (Polynomial.X ^ qL F L) ^ e) * Polynomial.X ^ qL F L := by
        dsimp [f, lubinTatePoly]
        rw [pow_succ, pow_succ]
        ring
      rw [h_id]
      exact polyDivPi_add
        (polyDivPi_C_mul h_pi_div_pi (polyInt_mul polyInt_X (polyInt_pow polyInt_f e)))
        (polyDivPi_mul_right ih (polyInt_pow polyInt_X (qL F L)))
  have h_comp_f_sub_X_pow : ∀ {ψ : Polynomial L}, polyInt ψ →
      polyDivPi (ψ.comp f - ψ.comp (Polynomial.X ^ qL F L)) := by
    intro ψ hψ k
    rw [Polynomial.comp_eq_sum_left, Polynomial.comp_eq_sum_left, Polynomial.sum_def,
      Polynomial.sum_def, ← Finset.sum_sub_distrib, Polynomial.finset_sum_coeff, Finset.sum_div]
    refine isIntegral_sum _ _ fun e _ => ?_
    rw [← mul_sub, Polynomial.coeff_C_mul, mul_div_assoc]
    exact IsIntegral.mul (hψ e) (h_f_pow_sub e k)
  letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  haveI : CharP 𝓀[F] (p F) := ringChar.charP 𝓀[F]
  obtain ⟨n_p, hp_prime, hcard_p⟩ := FiniteField.card 𝓀[F] (p F)
  have hqL_eq_p_pow : qL F L = (p F) ^ ((n_p : ℕ) * resDeg F L) := by
    dsimp [qL, q]
    rw [Nat.card_eq_fintype_card, hcard_p, ← pow_mul]
  have h_pow_qL_sub_comp : ∀ {ψ : Polynomial L}, polyInt ψ →
      polyDivPi (ψ ^ qL F L - ψ.comp (Polynomial.X ^ qL F L)) := by
    intro ψ hψ
    let P_pref : ℕ → Polynomial L := fun N =>
      ∑ i ∈ Finset.range N, Polynomial.monomial i (ψ.coeff i)
    have h_ind : ∀ N : ℕ, polyInt (P_pref N) ∧
        polyDivPi ((P_pref N) ^ qL F L - (P_pref N).comp (Polynomial.X ^ qL F L)) := by
      intro N
      induction N with
      | zero =>
        refine ⟨polyInt_zero, ?_⟩
        dsimp [P_pref]
        rw [zero_pow (by omega), Polynomial.zero_comp, sub_self]
        exact polyDivPi_zero
      | succ N ih =>
        set M := Polynomial.monomial N (ψ.coeff N)
        have hM_int : polyInt M := polyInt_monomial N (hψ N)
        have h_pref_succ : P_pref (N + 1) = P_pref N + M := Finset.sum_range_succ _ N
        rw [h_pref_succ]
        refine ⟨polyInt_add ih.1 hM_int, ?_⟩
        let e_p := (n_p : ℕ) * resDeg F L
        let S_rem := ∑ k ∈ Finset.Ioo 0 ((p F) ^ e_p),
          (P_pref N) ^ k * M ^ ((p F) ^ e_p - k) * ↑(((p F) ^ e_p).choose k / p F)
        have h_binom : (P_pref N + M) ^ qL F L =
            (P_pref N) ^ qL F L + M ^ qL F L + Polynomial.C (p F : L) * S_rem := by
          dsimp [S_rem]
          rw [hqL_eq_p_pow, add_pow_prime_pow_eq' hp_prime (P_pref N) M e_p,
            Polynomial.C_eq_natCast]
        have h_id : (P_pref N + M) ^ qL F L - (P_pref N + M).comp (Polynomial.X ^ qL F L) =
            ((P_pref N) ^ qL F L - (P_pref N).comp (Polynomial.X ^ qL F L)) +
            (M ^ qL F L - M.comp (Polynomial.X ^ qL F L)) +
            Polynomial.C (p F : L) * S_rem := by
          rw [h_binom, Polynomial.add_comp]
          ring
        rw [h_id]
        have hM_frob : polyDivPi (M ^ qL F L - M.comp (Polynomial.X ^ qL F L)) := by
          have hM_eq : M ^ qL F L - M.comp (Polynomial.X ^ qL F L) =
              Polynomial.monomial (N * qL F L) ((ψ.coeff N) ^ qL F L - ψ.coeff N) := by
            dsimp [M]
            rw [Polynomial.monomial_pow, Polynomial.monomial_comp, ← pow_mul,
              Polynomial.C_mul_X_pow_eq_monomial, Nat.mul_comm (qL F L) N, ← Polynomial.monomial_sub]
          rw [hM_eq]
          intro k
          rw [Polynomial.coeff_monomial]
          split_ifs
          · exact h_fermat (ψ.coeff N) (hψ N)
          · rw [zero_div]
            exact isIntegral_zero
        have hS_int : polyInt S_rem := by
          refine polyInt_sum _ _ fun k _ => ?_
          exact polyInt_mul
            (polyInt_mul (polyInt_pow ih.1 k) (polyInt_pow hM_int _))
            (polyInt_natCast _)
        exact polyDivPi_add (polyDivPi_add ih.2 hM_frob) (polyDivPi_C_mul h_p_int hS_int)
    have h_as_sum : P_pref (ψ.natDegree + 1) = ψ := (Polynomial.as_sum_range ψ).symm
    have h_res := (h_ind (ψ.natDegree + 1)).2
    rwa [h_as_sum] at h_res
  have hϕ_int : polyInt ϕ := fun k => (mem_int_iff (ϕ.coeff k)).mpr (hϕ k)
  have h_id : f.comp ϕ - ϕ.comp f =
      Polynomial.C πL * ϕ + (ϕ ^ qL F L - ϕ.comp (Polynomial.X ^ qL F L)) -
        (ϕ.comp f - ϕ.comp (Polynomial.X ^ qL F L)) := by
    dsimp [f, lubinTatePoly]
    simp only [Polynomial.add_comp, Polynomial.mul_comp, Polynomial.C_comp,
      Polynomial.X_comp, Polynomial.pow_comp]
    ring
  have h_div_pi : polyDivPi (f.comp ϕ - ϕ.comp f) := by
    rw [h_id]
    exact polyDivPi_sub
      (polyDivPi_add (polyDivPi_C_mul h_pi_div_pi hϕ_int) (h_pow_qL_sub_comp hϕ_int))
      (h_comp_f_sub_X_pow hϕ_int)
  intro k
  exact mem_div_pi (h_div_pi k)

theorem polyValLe_monomial_modByMonic_lubinTateIterPoly (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (n m j : ℕ) (hj1 : 1 ≤ j) (hjm : m * (qL F L) ^ n ≤ j)
    (d : L) (hd : d = 0 ∨ 0 ≤ valL F L d) :
    polyValLe F L m
      ((Polynomial.monomial j d) %ₘ lubinTateIterPoly F L (chosenUniformizer F L : L) n) :=
by
  let π₀ := chosenUniformizer F L
  let π : L := (π₀ : L)
  have hπ_ne : π ≠ 0 := π₀.ne_zero
  have addVal_mul : ∀ {x y : F}, x ≠ 0 → y ≠ 0 → addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Lˣ, Multiplicative.toAdd (relValHom u) = relVal F L u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : Lˣ,
      relVal F L ((u * v : Lˣ) : L) = relVal F L u + relVal F L v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : Lˣ) (k : ℤ),
      relVal F L ((u ^ k : Lˣ) : L) = k * relVal F L u := by
    intro u k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨c, hc⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F c) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hc]
      exact hg
    have hc0 : c ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 c hc0, ?_⟩
    simp only [Units.val_mk0, addVal, hc0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F c))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
