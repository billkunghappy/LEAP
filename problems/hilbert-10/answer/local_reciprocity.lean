    refine Finset.sum_eq_zero fun x hx => ?_
    have hsum : x.1 + x.2 = k := Finset.mem_antidiagonal.mp hx
    rcases eq_or_ne x.2 0 with hx2 | hx2
    · rw [hx2, hB0, mul_zero]
    · rw [hA x.1 (by omega), zero_mul]
  have h_pow_sub_pow_vanish : ∀ (m : ℕ) {P Q : Polynomial L},
      (∀ k ≤ m, (P - Q).coeff k = 0) → ∀ (e k : ℕ), k ≤ m → (P ^ e - Q ^ e).coeff k = 0 := by
    intro m P Q hPQ e
    induction e with
    | zero =>
      intro k _
      rw [pow_zero, pow_zero, sub_self, Polynomial.coeff_zero]
    | succ e ih =>
      intro k hk
      have h_id : P ^ (e + 1) - Q ^ (e + 1) = (P - Q) * P ^ e + (P ^ e - Q ^ e) * Q := by
        rw [pow_succ, pow_succ]
        ring
      rw [h_id, Polynomial.coeff_add, h_mul_vanish_le m hPQ k hk,
        h_mul_vanish_le m ih k hk, add_zero]
  have h_comp_coeff_zero : ∀ {P Q : Polynomial L},
      P.coeff 0 = 0 → Q.coeff 0 = 0 → (P.comp Q).coeff 0 = 0 := by
    intro P Q hP0 hQ0
    rw [Polynomial.comp_eq_sum_left, Polynomial.sum_def, Polynomial.finset_sum_coeff]
    refine Finset.sum_eq_zero fun e _ => ?_
    rw [Polynomial.coeff_C_mul]
    rcases eq_or_ne e 0 with rfl | he
    · rw [hP0, zero_mul]
    · rw [h_pow_coeff_lt hQ0 e 0 (by omega), mul_zero]
  have h_comp_coeff_one : ∀ {P Q : Polynomial L},
      P.coeff 0 = 0 → Q.coeff 0 = 0 → (P.comp Q).coeff 1 = P.coeff 1 * Q.coeff 1 := by
    intro P Q hP0 hQ0
    rw [Polynomial.comp_eq_sum_left, Polynomial.sum_def, Polynomial.finset_sum_coeff]
    rw [Finset.sum_eq_single 1]
    · rw [Polynomial.coeff_C_mul, pow_one]
    · intro e _ he1
      rw [Polynomial.coeff_C_mul]
      rcases eq_or_ne e 0 with rfl | he0
      · rw [hP0, zero_mul]
      · rw [h_pow_coeff_lt hQ0 e 1 (by omega), mul_zero]
    · intro hnotmem
      rw [Polynomial.coeff_C_mul, Polynomial.notMem_support_iff.mp hnotmem, zero_mul]
  have h_comp_right_vanish : ∀ (m : ℕ) {P Q G : Polynomial L},
      G.coeff 0 = 0 → (∀ k ≤ m, (P - Q).coeff k = 0) →
      ∀ k ≤ m, (P.comp G - Q.comp G).coeff k = 0 := by
    intro m P Q G hG0 hPQ k hk
    rw [← Polynomial.sub_comp, Polynomial.comp_eq_sum_left, Polynomial.sum_def,
      Polynomial.finset_sum_coeff]
    refine Finset.sum_eq_zero fun e _ => ?_
    rw [Polynomial.coeff_C_mul]
    rcases le_or_gt e m with hem | hem
    · rw [hPQ e hem, zero_mul]
    · rw [h_pow_coeff_lt hG0 e k (by omega), mul_zero]
  have h_comp_left_vanish : ∀ (m : ℕ) {P Q G : Polynomial L},
      (∀ k ≤ m, (P - Q).coeff k = 0) →
      ∀ k ≤ m, (G.comp P - G.comp Q).coeff k = 0 := by
    intro m P Q G hPQ k hk
    rw [Polynomial.comp_eq_sum_left, Polynomial.comp_eq_sum_left, Polynomial.sum_def,
      Polynomial.sum_def, ← Finset.sum_sub_distrib, Polynomial.finset_sum_coeff]
    refine Finset.sum_eq_zero fun e _ => ?_
    rw [← mul_sub, Polynomial.coeff_C_mul, h_pow_sub_pow_vanish m hPQ e k hk, mul_zero]
  have hf_coeff_0 : f.coeff 0 = 0 := by
    dsimp [f, lubinTatePoly]
    rw [Polynomial.coeff_add, Polynomial.coeff_C_mul, Polynomial.coeff_X_zero, mul_zero,
      zero_add, Polynomial.coeff_X_pow]
    exact if_neg (by omega)
  have hf_coeff_1 : f.coeff 1 = π := by
    dsimp [f, lubinTatePoly]
    rw [Polynomial.coeff_add, Polynomial.coeff_C_mul, Polynomial.coeff_X_one, mul_one,
      Polynomial.coeff_X_pow, if_neg (by omega), add_zero]
  have h_master_comm : ∀ (m : ℕ) {ψ ϕ : Polynomial L},
      ψ.coeff 0 = 0 → ϕ.coeff 0 = 0 → (∀ k ≤ m, (ψ - ϕ).coeff k = 0) →
      (∀ k ≤ m, (f.comp ψ - ψ.comp f).coeff k = (f.comp ϕ - ϕ.comp f).coeff k) ∧
      ((f.comp ψ - ψ.comp f).coeff (m + 1) =
        (f.comp ϕ - ϕ.comp f).coeff (m + 1) - (π ^ (m + 1) - π) * (ψ - ϕ).coeff (m + 1)) := by
    intro m ψ ϕ hψ0 hϕ0 hD_le
    set D := ψ - ϕ
    have h_qL_sub : ∀ k ≤ m + 1, (ψ ^ qL F L - ϕ ^ qL F L).coeff k = 0 := by
      intro k hk
      obtain ⟨d, hd⟩ : ∃ d : ℕ, qL F L = d + 2 := ⟨qL F L - 2, by omega⟩
      rw [hd]
      have h_id : ψ ^ (d + 2) - ϕ ^ (d + 2) =
          D * ψ ^ (d + 1) + (ψ ^ (d + 1) - ϕ ^ (d + 1)) * ϕ := by
        dsimp [D]
        rw [pow_succ _ (d + 1), pow_succ _ (d + 1)]
        ring
      have hψd0 : (ψ ^ (d + 1)).coeff 0 = 0 := h_pow_coeff_lt hψ0 (d + 1) 0 (by omega)
      rw [h_id, Polynomial.coeff_add,
        h_mul_vanish_succ m hD_le hψd0 k hk,
        h_mul_vanish_succ m (h_pow_sub_pow_vanish m hD_le (d + 1)) hϕ0 k hk, add_zero]
    have h_f_comp_sub : ∀ k ≤ m + 1,
        (f.comp ψ - f.comp ϕ).coeff k = π * D.coeff k := by
      intro k hk
      have h_id : f.comp ψ - f.comp ϕ = Polynomial.C π * D + (ψ ^ qL F L - ϕ ^ qL F L) := by
        dsimp [f, lubinTatePoly, D]
        simp only [Polynomial.add_comp, Polynomial.mul_comp, Polynomial.C_comp,
          Polynomial.X_comp, Polynomial.pow_comp]
        ring
      rw [h_id, Polynomial.coeff_add, Polynomial.coeff_C_mul, h_qL_sub k hk, add_zero]
    have h_comp_f_le : ∀ k ≤ m, (ψ.comp f - ϕ.comp f).coeff k = 0 :=
      h_comp_right_vanish m hf_coeff_0 hD_le
    have h_comp_f_succ : (ψ.comp f - ϕ.comp f).coeff (m + 1) =
        π ^ (m + 1) * D.coeff (m + 1) := by
      rw [← Polynomial.sub_comp, Polynomial.comp_eq_sum_left, Polynomial.sum_def,
        Polynomial.finset_sum_coeff]
      rw [Finset.sum_eq_single (m + 1)]
      · rw [Polynomial.coeff_C_mul, h_pow_coeff_eq hf_coeff_0 (m + 1), hf_coeff_1, mul_comm]
      · intro e _ he_ne
        rw [Polynomial.coeff_C_mul]
        rcases le_or_gt e m with hem | hem
        · rw [hD_le e hem, zero_mul]
        · rw [h_pow_coeff_lt hf_coeff_0 e (m + 1) (by omega), mul_zero]
      · intro hnotmem
        rw [Polynomial.coeff_C_mul, Polynomial.notMem_support_iff.mp hnotmem, zero_mul]
    refine ⟨fun k hk => ?_, ?_⟩
    · have h1 : (f.comp ψ).coeff k = (f.comp ϕ).coeff k := by
        apply sub_eq_zero.mp
        rw [← Polynomial.coeff_sub, h_f_comp_sub k (by omega), hD_le k hk, mul_zero]
      have h2 : (ψ.comp f).coeff k = (ϕ.comp f).coeff k := by
        apply sub_eq_zero.mp
        rw [← Polynomial.coeff_sub, h_comp_f_le k hk]
      rw [Polynomial.coeff_sub, Polynomial.coeff_sub, h1, h2]
    · have h_id : (f.comp ψ - ψ.comp f).coeff (m + 1) =
          (f.comp ϕ - ϕ.comp f).coeff (m + 1) +
          (f.comp ψ - f.comp ϕ).coeff (m + 1) -
          (ψ.comp f - ϕ.comp f).coeff (m + 1) := by
        simp only [Polynomial.coeff_sub]
        ring
      rw [h_id, h_f_comp_sub (m + 1) (le_refl _), h_comp_f_succ]
      dsimp [D]
      ring
  have h_trunc_props : ∀ (c : L) (m : ℕ),
      let ϕ_m := lubinTateEndoTrunc F L π c m
      ϕ_m.coeff 0 = 0 ∧
      (1 ≤ m → ϕ_m.coeff 1 = c) ∧
      (∀ k > m, ϕ_m.coeff k = 0) ∧
      (∀ k ≤ m, (f.comp ϕ_m - ϕ_m.comp f).coeff k = 0) := by
    intro c m
    induction m with
    | zero =>
      dsimp [lubinTateEndoTrunc]
      refine ⟨Polynomial.coeff_zero 0, fun h => by omega, fun k _ => Polynomial.coeff_zero k, ?_⟩
      intro k hk
      have hk0 : k = 0 := by omega
      subst hk0
      rw [Polynomial.zero_comp, Polynomial.coeff_sub,
        h_comp_coeff_zero hf_coeff_0 (Polynomial.coeff_zero 0), Polynomial.coeff_zero, sub_self]
    | succ m ih =>
      rcases eq_or_ne m 0 with rfl | hm0
      · dsimp [lubinTateEndoTrunc]
        have h0 : (Polynomial.C c * Polynomial.X).coeff 0 = 0 := by
          rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_zero, mul_zero]
        have h1 : (Polynomial.C c * Polynomial.X).coeff 1 = c := by
          rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_one, mul_one]
        have hgt : ∀ k > 1, (Polynomial.C c * Polynomial.X).coeff k = 0 := by
          intro k hk
          rw [Polynomial.coeff_C_mul, Polynomial.coeff_X, if_neg (by omega), mul_zero]
        refine ⟨h0, fun _ => h1, hgt, ?_⟩
        intro k hk
        have h_comm_1 : f.comp (Polynomial.C c * Polynomial.X) -
            (Polynomial.C c * Polynomial.X).comp f =
            Polynomial.C (c ^ qL F L - c) * Polynomial.X ^ qL F L := by
          dsimp [f, lubinTatePoly]
          simp only [Polynomial.add_comp, Polynomial.mul_comp, Polynomial.C_comp,
            Polynomial.X_comp, Polynomial.pow_comp, mul_pow, map_sub, map_pow]
          ring
        rw [h_comm_1, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg (by omega), mul_zero]
      · obtain ⟨r', rfl⟩ := Nat.exists_eq_succ_of_ne_zero hm0
        dsimp [lubinTateEndoTrunc]
        set ϕ₁ := lubinTateEndoTrunc F L π c (r' + 1)
        set d_coeff := ((f.comp ϕ₁ - ϕ₁.comp f).coeff (r' + 2)) / (π ^ (r' + 2) - π)
        set ϕ₂ := ϕ₁ + Polynomial.monomial (r' + 2) d_coeff
        have hϕ₂_0 : ϕ₂.coeff 0 = 0 := by
          dsimp [ϕ₂]
          rw [Polynomial.coeff_add, ih.1, Polynomial.coeff_monomial, if_neg (by omega), add_zero]
        have hϕ₂_1 : ϕ₂.coeff 1 = c := by
          dsimp [ϕ₂]
          rw [Polynomial.coeff_add, ih.2.1 (by omega), Polynomial.coeff_monomial,
            if_neg (by omega), add_zero]
        have hϕ₂_gt : ∀ k > r' + 2, ϕ₂.coeff k = 0 := by
          intro k hk
          dsimp [ϕ₂]
          rw [Polynomial.coeff_add, ih.2.2.1 k (by omega), Polynomial.coeff_monomial,
            if_neg (by omega), add_zero]
        have hD_le : ∀ k ≤ r' + 1, (ϕ₂ - ϕ₁).coeff k = 0 := by
          intro k hk
          dsimp [ϕ₂]
          rw [add_sub_cancel_left, Polynomial.coeff_monomial, if_neg (by omega)]
        have hD_succ : (ϕ₂ - ϕ₁).coeff (r' + 2) = d_coeff := by
          dsimp [ϕ₂]
          rw [add_sub_cancel_left, Polynomial.coeff_monomial, if_pos rfl]
        have h_mc := h_master_comm (r' + 1) hϕ₂_0 ih.1 hD_le
        refine ⟨hϕ₂_0, fun _ => hϕ₂_1, hϕ₂_gt, ?_⟩
        intro k hk
        rcases lt_or_eq_of_le hk with hlt | rfl
        · rw [h_mc.1 k (by omega), ih.2.2.2 k (by omega)]
        · rw [h_mc.2, hD_succ]
          dsimp [d_coeff]
          rw [mul_div_cancel₀ _ (hπ_pow_sub_ne (r' + 1) (by omega)), sub_self]
  have h_unique : ∀ (c : L) (m : ℕ), 1 ≤ m → ∀ ψ : Polynomial L,
      ψ.coeff 0 = 0 → ψ.coeff 1 = c →
      (∀ k ≤ m, (f.comp ψ - ψ.comp f).coeff k = 0) →
      ∀ k ≤ m, (lubinTateEndoTrunc F L π c m - ψ).coeff k = 0 := by
    intro c m hm ψ hψ0 hψ1 hψ_comm
    have h_ind : ∀ j : ℕ, 1 ≤ j → j ≤ m →
        ∀ k ≤ j, (lubinTateEndoTrunc F L π c j - ψ).coeff k = 0 := by
      intro j
      induction j with
      | zero =>
        intro hj
        omega
      | succ j ih =>
        intro _ hjm
        rcases eq_or_ne j 0 with rfl | hj0
        · intro k hk
          rw [Polynomial.coeff_sub]
          rcases eq_or_ne k 0 with rfl | hk0
          · rw [(h_trunc_props c 1).1, hψ0, sub_self]
          · have hk1 : k = 1 := by omega
            subst hk1
            rw [(h_trunc_props c 1).2.1 (le_refl 1), hψ1, sub_self]
        · obtain ⟨r', rfl⟩ := Nat.exists_eq_succ_of_ne_zero hj0
          have ih' := ih (by omega) (by omega)
          set ϕ₁ := lubinTateEndoTrunc F L π c (r' + 1)
          set ϕ₂ := lubinTateEndoTrunc F L π c (r' + 2)
          have h_ψ_ϕ₁ : ∀ k ≤ r' + 1, (ψ - ϕ₁).coeff k = 0 := by
            intro k hk
            rw [← neg_sub, Polynomial.coeff_neg, ih' k hk, neg_zero]
          have h_mc := (h_master_comm (r' + 1) hψ0 (h_trunc_props c (r' + 1)).1 h_ψ_ϕ₁).2
          have h_comm_ψ : (f.comp ψ - ψ.comp f).coeff (r' + 2) = 0 := hψ_comm (r' + 2) hjm
          have h_comm_ϕ₂ : (f.comp ϕ₂ - ϕ₂.comp f).coeff (r' + 2) = 0 :=
            (h_trunc_props c (r' + 2)).2.2.2 (r' + 2) (le_refl _)
          have h_ϕ₂_ϕ₁ : ∀ k ≤ r' + 1, (ϕ₂ - ϕ₁).coeff k = 0 := by
            intro k hk
            dsimp [ϕ₂, ϕ₁, lubinTateEndoTrunc]
            rw [add_sub_cancel_left, Polynomial.coeff_monomial, if_neg (by omega)]
          have h_mc₂ := (h_master_comm (r' + 1) (h_trunc_props c (r' + 2)).1
            (h_trunc_props c (r' + 1)).1 h_ϕ₂_ϕ₁).2
          change (f.comp ψ - ψ.comp f).coeff (r' + 2) =
            (f.comp ϕ₁ - ϕ₁.comp f).coeff (r' + 2) -
              (π ^ (r' + 2) - π) * (ψ - ϕ₁).coeff (r' + 2) at h_mc
          change (f.comp ϕ₂ - ϕ₂.comp f).coeff (r' + 2) =
            (f.comp ϕ₁ - ϕ₁.comp f).coeff (r' + 2) -
              (π ^ (r' + 2) - π) * (ϕ₂ - ϕ₁).coeff (r' + 2) at h_mc₂
          rw [h_comm_ψ] at h_mc
          rw [h_comm_ϕ₂] at h_mc₂
          have h_Y : (π ^ (r' + 2) - π) * (ψ - ϕ₁).coeff (r' + 2) =
              (f.comp ϕ₁ - ϕ₁.comp f).coeff (r' + 2) :=
            (sub_eq_zero.mp h_mc.symm).symm
          have h_Z : (π ^ (r' + 2) - π) * (ϕ₂ - ϕ₁).coeff (r' + 2) =
              (f.comp ϕ₁ - ϕ₁.comp f).coeff (r' + 2) :=
            (sub_eq_zero.mp h_mc₂.symm).symm
          have h_eq_coeff : (ϕ₂ - ϕ₁).coeff (r' + 2) = (ψ - ϕ₁).coeff (r' + 2) :=
            mul_left_cancel₀ (hπ_pow_sub_ne (r' + 1) (by omega)) (h_Z.trans h_Y.symm)
          intro k hk
          rw [← sub_sub_sub_cancel_right ϕ₂ ψ ϕ₁, Polynomial.coeff_sub]
          rcases lt_or_eq_of_le hk with hlt | rfl
          · rw [h_ϕ₂_ϕ₁ k (by omega), h_ψ_ϕ₁ k (by omega), sub_self]
          · rw [h_eq_coeff, sub_self]
    exact h_ind m hm (le_refl m)
  set ϕ_a := lubinTateEndoTrunc F L π a r
  set ϕ_b := lubinTateEndoTrunc F L π b r
  set ϕ_ab := lubinTateEndoTrunc F L π (a * b) r
  have hϕa0 : ϕ_a.coeff 0 = 0 := (h_trunc_props a r).1
  have hϕb0 : ϕ_b.coeff 0 = 0 := (h_trunc_props b r).1
  have h_ab_vanish : ∀ k ≤ r, (ϕ_ab - ϕ_a.comp ϕ_b).coeff k = 0 := by
    rcases eq_or_ne r 0 with rfl | hr0
    · intro k hk
      have hk0 : k = 0 := by omega
      subst hk0
      rw [Polynomial.coeff_sub, (h_trunc_props (a * b) 0).1, h_comp_coeff_zero hϕa0 hϕb0, sub_self]
    · have hr1 : 1 ≤ r := by omega
      set ψ := ϕ_a.comp ϕ_b
      have hψ0 : ψ.coeff 0 = 0 := h_comp_coeff_zero hϕa0 hϕb0
      have hψ1 : ψ.coeff 1 = a * b := by
        rw [h_comp_coeff_one hϕa0 hϕb0, (h_trunc_props a r).2.1 hr1, (h_trunc_props b r).2.1 hr1]
      have hψ_comm : ∀ k ≤ r, (f.comp ψ - ψ.comp f).coeff k = 0 := by
        intro k hk
        have h_id : f.comp ψ - ψ.comp f =
            ((f.comp ϕ_a).comp ϕ_b - (ϕ_a.comp f).comp ϕ_b) +
            (ϕ_a.comp (f.comp ϕ_b) - ϕ_a.comp (ϕ_b.comp f)) := by
          dsimp [ψ]
          simp only [Polynomial.comp_assoc]
          ring
        rw [h_id, Polynomial.coeff_add,
          h_comp_right_vanish r hϕb0 (h_trunc_props a r).2.2.2 k hk,
          h_comp_left_vanish r (h_trunc_props b r).2.2.2 k hk, add_zero]
      exact h_unique (a * b) r hr1 ψ hψ0 hψ1 hψ_comm
  have hfn_props : ∀ (j : ℕ),
      polyInt (lubinTateIterPoly F L π j) ∧
      (lubinTateIterPoly F L π j).coeff 0 = 0 ∧
      ∀ k ≤ r, ((lubinTateIterPoly F L π j).comp ϕ_b -
        ϕ_b.comp (lubinTateIterPoly F L π j)).coeff k = 0 := by
    intro j
    induction j with
    | zero =>
      dsimp [lubinTateIterPoly]
      refine ⟨polyInt_X, Polynomial.coeff_X_zero, fun k _ => ?_⟩
      rw [Polynomial.X_comp, Polynomial.comp_X, sub_self, Polynomial.coeff_zero]
    | succ j ih =>
      dsimp [lubinTateIterPoly]
      set f_j := lubinTateIterPoly F L π j
      refine ⟨polyInt_comp polyInt_f ih.1, h_comp_coeff_zero hf_coeff_0 ih.2.1, fun k hk => ?_⟩
      have h_id : (f.comp f_j).comp ϕ_b - ϕ_b.comp (f.comp f_j) =
          (f.comp (f_j.comp ϕ_b) - f.comp (ϕ_b.comp f_j)) +
          ((f.comp ϕ_b).comp f_j - (ϕ_b.comp f).comp f_j) := by
        simp only [Polynomial.comp_assoc]
        ring
      rw [h_id, Polynomial.coeff_add,
        h_comp_left_vanish r ih.2.2 k hk,
        h_comp_right_vanish r ih.2.1 (h_trunc_props b r).2.2.2 k hk, add_zero]
  refine ⟨(polyValLe_iff_polyInt _).mpr hϕa_int, hϕa0,
    ⟨(polyValLe_iff_polyInt _).mpr (polyInt_sub hϕab_int (polyInt_comp hϕa_int hϕb_int)),
      h_ab_vanish⟩,
    ⟨(polyValLe_iff_polyInt _).mpr
      (polyInt_sub (polyInt_comp (hfn_props n).1 hϕb_int)
        (polyInt_comp hϕb_int (hfn_props n).1)),
      (hfn_props n).2.2⟩⟩

theorem polyValLe_comp_modByMonic_sub_of_trunc_comm (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (n m r : ℕ) (hmr : m * (qL F L) ^ n ≤ r)
    (ϕ_a ϕ_b ϕ_ab P_a P_b : Polynomial L)
    (hϕa : polyValLe F L 0 ϕ_a) (hϕa0 : ϕ_a.coeff 0 = 0)
    (hϕb : polyValLe F L 0 ϕ_b) (hϕb0 : ϕ_b.coeff 0 = 0)
    (h_ab : polyValLe F L 0 (ϕ_ab - ϕ_a.comp ϕ_b))
    (h_ab_vanish : ∀ k ≤ r, (ϕ_ab - ϕ_a.comp ϕ_b).coeff k = 0)
    (h_iter : polyValLe F L 0 ((lubinTateIterPoly F L (chosenUniformizer F L : L) n).comp ϕ_b -
      ϕ_b.comp (lubinTateIterPoly F L (chosenUniformizer F L : L) n)))
    (h_iter_vanish : ∀ k ≤ r,
      ((lubinTateIterPoly F L (chosenUniformizer F L : L) n).comp ϕ_b -
        ϕ_b.comp (lubinTateIterPoly F L (chosenUniformizer F L : L) n)).coeff k = 0)
    (hPa : polyValLe F L m
      (P_a - ϕ_a %ₘ lubinTateIterPoly F L (chosenUniformizer F L : L) n))
    (hPb : polyValLe F L m
      (P_b - ϕ_b %ₘ lubinTateIterPoly F L (chosenUniformizer F L : L) n)) :
    polyValLe F L m
      ((P_a.comp P_b) %ₘ lubinTateIterPoly F L (chosenUniformizer F L : L) n -
        ϕ_ab %ₘ lubinTateIterPoly F L (chosenUniformizer F L : L) n) :=
by
  let π₀ := chosenUniformizer F L
  let π : L := (π₀ : L)
  have hπ_ne : π ≠ 0 := π₀.ne_zero
  have addVal_mul : ∀ {x y : F}, x ≠ 0 → y ≠ 0 → addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
