        refine ⟨hθ₂_0, fun _ => hθ₂_1, hθ₂_gt, hθ₂_unram, ?_⟩
        intro k hk
        change IsIntegralDivPow F L πL (M + 1)
          ((((θ₂.map (τ : AlgebraicClosure F →+* AlgebraicClosure F)).comp f₀_poly) -
            fπ.comp θ₂).coeff k)
        rcases lt_or_eq_of_le hk with hlt | rfl
        · rw [h_ms.1 k (by omega)]
          exact ih.2.2.2.2 k (by omega)
        · rw [h_ms.2, hD_succ]
          have h_num_eq : num = πbar * d := by
