      obtain ⟨m, hm⟩ := exists_pow_lt_of_lt_one (half_pos hε) hπ_norm_lt_one
      refine ⟨m, fun r₁ hr₁ r₂ hr₂ => ?_⟩
      have hd1 : dist (u r₁) (u m) ≤ ‖πE‖ ^ m := hu_dist m r₁ hr₁
      have hd2 : dist (u r₂) (u m) ≤ ‖πE‖ ^ m := hu_dist m r₂ hr₂
      calc dist (u r₁) (u r₂)
          ≤ dist (u r₁) (u m) + dist (u r₂) (u m) :=
            dist_triangle_right (u r₁) (u r₂) (u m)
        _ ≤ ‖πE‖ ^ m + ‖πE‖ ^ m := add_le_add hd1 hd2
        _ < ε / 2 + ε / 2 := add_lt_add hm hm
        _ = ε := add_halves ε
    obtain ⟨x, hx⟩ := cauchySeq_tendsto_of_complete h_cauchy
    refine ⟨x, fun m r hmr => (h_val_iff_norm (x - u r) m).mpr ?_⟩
    by_contra h_gt
    have hδ : 0 < ‖x - u r‖ - ‖πE‖ ^ m := by linarith
    obtain ⟨K, hK⟩ := Metric.tendsto_atTop.mp hx (‖x - u r‖ - ‖πE‖ ^ m) hδ
    have h_dist_x : dist x (u (r + K)) < ‖x - u r‖ - ‖πE‖ ^ m := by
      rw [dist_comm]
      exact hK (r + K) (Nat.le_add_left K r)
    have h_dist_u : dist (u (r + K)) (u r) ≤ ‖πE‖ ^ m := by
      rw [dist_eq_norm]
      exact hu_norm m r K hmr
    have h_tri : ‖x - u r‖ ≤ dist x (u (r + K)) + dist (u (r + K)) (u r) := by
      rw [← dist_eq_norm]
      exact dist_triangle x (u (r + K)) (u r)
    linarith
  obtain ⟨dF, hp, hcardF⟩ := FiniteField.card 𝓀[F] (p F)
  have hqF_eq : q F = (p F) ^ (dF : ℕ) := by
    rw [q, Nat.card_eq_fintype_card, hcardF]
  have hp_ge_two : 2 ≤ p F := hp.two_le
  have hdF_pos : 0 < (dF : ℕ) := dF.pos
  have hqF_ge_two : 2 ≤ q F := by
    rw [hqF_eq]
    calc 2 = 2 ^ 1 := by ring
      _ ≤ 2 ^ (dF : ℕ) := Nat.pow_le_pow_right (by omega) hdF_pos
      _ ≤ (p F) ^ (dF : ℕ) := Nat.pow_le_pow_left hp_ge_two (dF : ℕ)
  have hqL_eq : qL F L = (p F) ^ ((dF : ℕ) * resDeg F L) := by
    rw [qL, hqF_eq, ← pow_mul]
  have hqE_eq : qL F E = (p F) ^ ((dF : ℕ) * resDeg F E) := by
    rw [qL, hqF_eq, ← pow_mul]
  have hqL_ge_two : 2 ≤ qL F L := by
    rw [hqL_eq]
    have hk_pos : 0 < (dF : ℕ) * resDeg F L := Nat.mul_pos hdF_pos hfL_pos
    calc 2 = 2 ^ 1 := by ring
      _ ≤ 2 ^ ((dF : ℕ) * resDeg F L) := Nat.pow_le_pow_right (by omega) hk_pos
      _ ≤ (p F) ^ ((dF : ℕ) * resDeg F L) := Nat.pow_le_pow_left hp_ge_two _
  have hqE_ge_two : 2 ≤ qL F E := by
    rw [hqE_eq]
    have hk_pos : 0 < (dF : ℕ) * resDeg F E := Nat.mul_pos hdF_pos hf_pos
    calc 2 = 2 ^ 1 := by ring
      _ ≤ 2 ^ ((dF : ℕ) * resDeg F E) := Nat.pow_le_pow_right (by omega) hk_pos
      _ ≤ (p F) ^ ((dF : ℕ) * resDeg F E) := Nat.pow_le_pow_left hp_ge_two _
  have h_not_dvd_qE : ¬ p F ∣ qL F E - 1 := by
    intro hdvd
    have hk_pos : 0 < (dF : ℕ) * resDeg F E := Nat.mul_pos hdF_pos hf_pos
    have hdvd_pow : p F ∣ qL F E := by
      rw [hqE_eq]
      exact dvd_pow_self (p F) (by omega)
    have hdvd_one : p F ∣ 1 := by
      have hsub := Nat.dvd_sub hdvd_pow hdvd
      have heq : qL F E - (qL F E - 1) = 1 := by omega
      rwa [heq] at hsub
    exact hp.not_dvd_one hdvd_one
  let I_pow : ℕ → E → Prop := fun m w => IsIntegral 𝒪[F] (w / πE ^ m)
  have I_pow_iff_valL : ∀ (m : ℕ) (w : E),
      I_pow m w ↔ (w = 0 ∨ (m : ℤ) ≤ valL F E w) := by
    intro m w
    by_cases hw : w = 0
    · simp [I_pow, hw, isIntegral_zero]
    · have hpow_ne : πE ^ m ≠ 0 := pow_ne_zero m hπE_ne
      have hdiv_ne : w / πE ^ m ≠ 0 := div_ne_zero hw hpow_ne
      change IsIntegral 𝒪[F] (w / πE ^ m) ↔ (w = 0 ∨ (m : ℤ) ≤ valL F E w)
      rw [h_int_valL hdiv_ne, or_iff_right hw, valL_div hw hpow_ne, valL_pow hπE_ne m,
        hπ_val, mul_one]
      omega
  have I_pow_zero : ∀ m : ℕ, I_pow m 0 := fun m => (I_pow_iff_valL m 0).mpr (Or.inl rfl)
  have I_pow_add : ∀ {m : ℕ} {w₁ w₂ : E}, I_pow m w₁ → I_pow m w₂ → I_pow m (w₁ + w₂) := by
    intro m w₁ w₂ h₁ h₂
    change IsIntegral 𝒪[F] ((w₁ + w₂) / πE ^ m)
    rw [add_div]
    exact h₁.add h₂
  have I_pow_sub : ∀ {m : ℕ} {w₁ w₂ : E}, I_pow m w₁ → I_pow m w₂ → I_pow m (w₁ - w₂) := by
    intro m w₁ w₂ h₁ h₂
    change IsIntegral 𝒪[F] ((w₁ - w₂) / πE ^ m)
    rw [sub_div]
    exact h₁.sub h₂
  have I_pow_mul_int : ∀ {m : ℕ} {w y : E}, I_pow m w → IsIntegral 𝒪[F] y → I_pow m (w * y) := by
    intro m w y hw hy
    change IsIntegral 𝒪[F] ((w * y) / πE ^ m)
    rw [mul_div_right_comm]
    exact hw.mul hy
  have I_pow_mul_p : ∀ {m : ℕ} {w : E}, I_pow m w → I_pow (m + 1) (w * (p F : E)) := by
    intro m w hw
    change IsIntegral 𝒪[F] ((w * (p F : E)) / πE ^ (m + 1))
    have h_eq : (w * (p F : E)) / πE ^ (m + 1) = (w / πE ^ m) * ((p F : E) / πE) := by
      rw [pow_succ, div_mul_div_comm]
    rw [h_eq]
    exact hw.mul h_p_int
  have I_pow_mono : ∀ {m₁ m₂ : ℕ} {w : E}, m₁ ≤ m₂ → I_pow m₂ w → I_pow m₁ w := by
    intro m₁ m₂ w hle hw
    rw [I_pow_iff_valL] at hw ⊢
    rcases hw with rfl | hw_val
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have I_pow_sum : ∀ (m : ℕ) (s : Finset ℕ) (φ : ℕ → E),
      (∀ j ∈ s, I_pow m (φ j)) → I_pow m (∑ j ∈ s, φ j) := by
    intro m s φ hφ
    induction s using Finset.induction_on with
    | empty =>
      rw [Finset.sum_empty]
      exact I_pow_zero m
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact I_pow_add (hφ a (Finset.mem_insert_self a s))
        (ih (fun j hj => hφ j (Finset.mem_insert_of_mem hj)))
  have I_pow_frob_step : ∀ {m : ℕ} {x y : E},
      1 ≤ m → IsIntegral 𝒪[F] x → IsIntegral 𝒪[F] y →
      I_pow m (x - y) → I_pow (m + 1) (x ^ qL F E - y ^ qL F E) := by
    intro m x y hm hx hy hxy
    set d : E := x - y
    have hd_int : IsIntegral 𝒪[F] d := hx.sub hy
    have hx_eq : x = d + y := (sub_add_cancel x y).symm
    have hd_pow : I_pow (m + 1) (d ^ qL F E) := by
      rw [I_pow_iff_valL] at hxy ⊢
      rcases hxy with hd0 | hd_val
      · left
        rw [hd0, zero_pow (by omega)]
      · by_cases hd0 : d = 0
        · left
          rw [hd0, zero_pow (by omega)]
        · right
          rw [valL_pow hd0 (qL F E)]
          have hqE_int : (2 : ℤ) ≤ (qL F E : ℤ) := by exact_mod_cast hqE_ge_two
          have hm_int : (1 : ℤ) ≤ (m : ℤ) := by exact_mod_cast hm
          have hmul : (2 : ℤ) * (m : ℤ) ≤ (qL F E : ℤ) * valL F E d :=
            mul_le_mul hqE_int hd_val (by omega) (by omega)
          omega
    have hqE_split : qL F E + 1 = (qL F E - 1) + 1 + 1 := by omega
    have h_sum_split : ∑ k ∈ Finset.range (qL F E + 1),
        d ^ k * y ^ (qL F E - k) * ((qL F E).choose k : E) =
        ((∑ j ∈ Finset.range (qL F E - 1),
          d ^ (j + 1) * y ^ (qL F E - (j + 1)) * ((qL F E).choose (j + 1) : E)) +
          d ^ 0 * y ^ (qL F E - 0) * ((qL F E).choose 0 : E)) +
        d ^ ((qL F E - 1) + 1) * y ^ (qL F E - ((qL F E - 1) + 1)) *
          ((qL F E).choose ((qL F E - 1) + 1) : E) := by
      rw [hqE_split, Finset.sum_range_succ, Finset.sum_range_succ']
    have h_binom : x ^ qL F E - y ^ qL F E =
        d ^ qL F E + ∑ j ∈ Finset.range (qL F E - 1),
          d ^ (j + 1) * y ^ (qL F E - (j + 1)) * ((qL F E).choose (j + 1) : E) := by
      rw [hx_eq, add_pow, h_sum_split]
      have h_sub1 : (qL F E - 1) + 1 = qL F E := by omega
      have h_top : d ^ ((qL F E - 1) + 1) * y ^ (qL F E - ((qL F E - 1) + 1)) *
          ((qL F E).choose ((qL F E - 1) + 1) : E) = d ^ qL F E := by
        rw [h_sub1, Nat.sub_self, pow_zero, mul_one, Nat.choose_self, Nat.cast_one, mul_one]
      have h_bot : d ^ 0 * y ^ (qL F E - 0) * ((qL F E).choose 0 : E) = y ^ qL F E := by
        rw [pow_zero, one_mul, Nat.sub_zero, Nat.choose_zero_right, Nat.cast_one, mul_one]
      rw [h_top, h_bot]
      ring
    rw [h_binom]
    refine I_pow_add hd_pow (I_pow_sum (m + 1) _ _ fun j hj => ?_)
    have hj_lt : j < qL F E - 1 := Finset.mem_range.mp hj
    have hk_ne_zero : j + 1 ≠ 0 := by omega
    have hk_ne_qE : j + 1 ≠ (p F) ^ ((dF : ℕ) * resDeg F E) := by omega
    have hdvd : p F ∣ (qL F E).choose (j + 1) := by
      rw [hqE_eq]
      exact hp.dvd_choose_pow hk_ne_zero hk_ne_qE
    obtain ⟨c_j, hc_j⟩ := hdvd
    have h_term : d ^ (j + 1) * y ^ (qL F E - (j + 1)) * ((qL F E).choose (j + 1) : E) =
        (d * (p F : E)) * (d ^ j * y ^ (qL F E - (j + 1)) * (c_j : E)) := by
      rw [pow_succ, hc_j, Nat.cast_mul]
      ring
    rw [h_term]
    refine I_pow_mul_int (I_pow_mul_p hxy) ?_
    refine ((hd_int.pow j).mul (hy.pow (qL F E - (j + 1)))).mul ?_
    have hcj_eq : (c_j : E) = algebraMap 𝒪[F] E (c_j : 𝒪[F]) := by simp
    rw [hcj_eq]
    exact isIntegral_algebraMap
  have exists_teich : ∀ c : E, IsIntegral 𝒪[F] c →
      ∃ z : E, z ^ qL F E = z ∧ IsIntegral 𝒪[F] ((z - c) / πE) := by
    intro c hc
    let u : ℕ → E := fun r => ((fun w : E => w ^ qL F E)^[r] c)
    have hu_zero : u 0 = c := rfl
    have hu_succ : ∀ r : ℕ, u (r + 1) = (u r) ^ qL F E :=
      fun r => Function.iterate_succ_apply' (fun w : E => w ^ qL F E) r c
    have hu_int : ∀ r : ℕ, IsIntegral 𝒪[F] (u r) := by
      intro r
      induction r with
      | zero => exact hc
      | succ r ih =>
        rw [hu_succ]
        exact ih.pow (qL F E)
    have hu_step : ∀ r : ℕ, I_pow (r + 1) (u (r + 1) - u r) := by
      intro r
      induction r with
      | zero =>
        change IsIntegral 𝒪[F] ((u 1 - u 0) / πE ^ 1)
        rw [hu_succ 0, hu_zero, pow_one]
        exact h_frob c hc
      | succ r ih =>
        have h_step := I_pow_frob_step (by omega : 1 ≤ r + 1) (hu_int (r + 1)) (hu_int r) ih
        rwa [← hu_succ (r + 1), ← hu_succ r] at h_step
    have hu_cauchy_I : ∀ r k : ℕ, I_pow (r + 1) (u (r + k) - u r) := by
      intro r k
      induction k with
      | zero =>
        rw [add_zero, sub_self]
        exact I_pow_zero (r + 1)
      | succ k ih =>
        have h_split : u (r + (k + 1)) - u r =
            (u (r + k + 1) - u (r + k)) + (u (r + k) - u r) := by
          rw [← add_assoc]
          ring
        rw [h_split]
        exact I_pow_add (I_pow_mono (by omega : r + 1 ≤ r + k + 1) (hu_step (r + k))) ih
    have hu_cauchy : ∀ m r k : ℕ, m ≤ r →
        u (r + k) - u r = 0 ∨ (m : ℤ) ≤ valL F E (u (r + k) - u r) := by
      intro m r k hmr
      exact (I_pow_iff_valL m (u (r + k) - u r)).mp
        (I_pow_mono (by omega : m ≤ r + 1) (hu_cauchy_I r k))
    obtain ⟨z, hz_lim⟩ := h_cauchy_limit u hu_cauchy
    have hz_I : ∀ m r : ℕ, m ≤ r → I_pow m (z - u r) :=
      fun m r hmr => (I_pow_iff_valL m (z - u r)).mpr (hz_lim m r hmr)
    have hz_sub_c : I_pow 1 (z - c) := by
      have h1 : I_pow 1 (z - u 1) := hz_I 1 1 (le_refl 1)
      have h2 : I_pow 1 (u 1 - c) := by
        rw [← hu_zero]
        exact hu_step 0
      have h3 := I_pow_add h1 h2
      rwa [sub_add_sub_cancel] at h3
    have hz_sub_c_div : IsIntegral 𝒪[F] ((z - c) / πE) := by
      have h := hz_sub_c
      change IsIntegral 𝒪[F] ((z - c) / πE ^ 1) at h
      rwa [pow_one] at h
    have hz_int : IsIntegral 𝒪[F] z := by
      have h0 : I_pow 0 (z - c) := I_pow_mono (by omega : 0 ≤ 1) hz_sub_c
      change IsIntegral 𝒪[F] ((z - c) / πE ^ 0) at h0
      rw [pow_zero, div_one] at h0
      have h_eq : z = (z - c) + c := (sub_add_cancel z c).symm
      rw [h_eq]
      exact h0.add hc
    have hz_pow_eq : z ^ qL F E = z := by
      by_contra hne
      have hsub_ne : z ^ qL F E - z ≠ 0 := sub_ne_zero.mpr hne
      let m : ℕ := (valL F E (z ^ qL F E - z)).toNat + 1
      have hm_ge : 1 ≤ m := by omega
      have h_z_um : I_pow m (z - u m) := hz_I m m (le_refl m)
      have h_pow_step : I_pow (m + 1) (z ^ qL F E - u (m + 1)) := by
        rw [hu_succ m]
        exact I_pow_frob_step hm_ge hz_int (hu_int m) h_z_um
      have h_z_um1 : I_pow (m + 1) (z - u (m + 1)) := hz_I (m + 1) (m + 1) (le_refl (m + 1))
      have h_diff : I_pow (m + 1) (z ^ qL F E - z) := by
        have h := I_pow_sub h_pow_step h_z_um1
        rwa [sub_sub_sub_cancel_right] at h
      rcases (I_pow_iff_valL (m + 1) (z ^ qL F E - z)).mp h_diff with h0 | hval
      · exact hsub_ne h0
      · omega
    exact ⟨z, hz_pow_eq, hz_sub_c_div⟩
  let f : E → E := fun x =>
    if hx : IsIntegral 𝒪[F] x then (exists_teich x hx).choose else 0
  have hf_pow : ∀ x ∈ S, f x ^ qL F E = f x := by
    intro x hx
    have hx_int : IsIntegral 𝒪[F] x := hS_int x hx
    dsimp [f]
    rw [dif_pos hx_int]
    exact (exists_teich x hx_int).choose_spec.1
  have hf_sub : ∀ x ∈ S, IsIntegral 𝒪[F] ((f x - x) / πE) := by
    intro x hx
    have hx_int : IsIntegral 𝒪[F] x := hS_int x hx
    dsimp [f]
    rw [dif_pos hx_int]
    exact (exists_teich x hx_int).choose_spec.2
  have hf_inj : Set.InjOn f (S : Set E) := by
    intro x hx y hy h_eq
    by_contra h_ne
    have h_diff_int : IsIntegral 𝒪[F] ((x - y) / πE) := by
      have h_sub := (hf_sub y hy).sub (hf_sub x hx)
      have h_alg : (f y - y) / πE - (f x - x) / πE = (x - y) / πE := by
        rw [h_eq, ← sub_div]
        congr 1
        ring
      rwa [h_alg] at h_sub
    exact hS_sep x hx y hy h_ne h_diff_int
  have hf_frob : ∀ x ∈ S, f x ^ qL F L = f x := by
    intro x hx
    set z : E := f x
    by_cases hz : z = 0
    · rw [hz, zero_pow (by omega)]
    · have hz_unit : z ^ (qL F E - 1) = 1 := by
        apply mul_right_cancel₀ hz
        rw [← pow_succ, Nat.sub_add_cancel (by omega), one_mul]
        exact hf_pow x hx
      let ζ : AlgebraicClosure F := (z : AlgebraicClosure F)
      have hζ_pow : ζ ^ (qL F E - 1) = 1 :=
        congrArg Subtype.val hz_unit
      have hζ_root : IsPrimeToPRootOfUnity F ζ :=
        ⟨qL F E - 1, by omega, h_not_dvd_qE, hζ_pow⟩
      have hσζ : σ ζ = ζ := hσE z
      have h_act := hσFrob ζ hζ_root
      have h_toNat_pos : (- -(resDeg F L : ℤ)).toNat = resDeg F L := by omega
      have h_toNat_neg : (-(resDeg F L : ℤ)).toNat = 0 := by omega
      rw [hσζ, h_toNat_pos, h_toNat_neg, pow_zero, pow_one] at h_act
      exact Subtype.ext h_act
  let P : Polynomial E := Polynomial.X ^ qL F L - Polynomial.X
  have hP_deg : P.natDegree = qL F L := by
    dsimp [P]
    rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt]
    · exact Polynomial.natDegree_X_pow (qL F L)
    · rw [Polynomial.natDegree_X, Polynomial.natDegree_X_pow]
      omega
  have hP_ne : P ≠ 0 := by
    intro h0
    have hdeg : P.natDegree = 0 := by rw [h0, Polynomial.natDegree_zero]
    omega
  have h_sub_roots : (S.image f).val ⊆ P.roots := by
    rw [Multiset.subset_iff]
    intro z hz
    rw [Finset.mem_val, Finset.mem_image] at hz
    obtain ⟨x, hxS, rfl⟩ := hz
    rw [Polynomial.mem_roots hP_ne, Polynomial.IsRoot.def]
    simp only [P, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X]
    exact sub_eq_zero.mpr (hf_frob x hxS)
  have h_card_le : (S.image f).card ≤ P.natDegree :=
    Polynomial.card_le_degree_of_subset_roots h_sub_roots
  have hq_le : qL F E ≤ qL F L := by
    rw [Finset.card_image_of_injOn hf_inj, hS_card, hP_deg] at h_card_le
    exact h_card_le
  have hf_ge : resDeg F E ≤ resDeg F L := by
    unfold qL at hq_le
    exact (Nat.pow_le_pow_iff_right (by omega : 1 < q F)).mp hq_le
  exact le_antisymm hf_ge hf_le

theorem finrank_ltDivSubfield (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] (n : ℕ) :
    1 ≤ n →
      Module.finrank F (ltDivSubfield F L n) =
        Module.finrank F L * (qL F L - 1) * (qL F L) ^ (n - 1) :=
by
  intro hn
  set ϖ : Lˣ := chosenUniformizer F L
  have hϖ : valL F L ϖ = 1 := (valL_chosenUniformizer_and_mul_zpow F L 1).1
  have hres_ne : resDeg F L ≠ 0 := by
    intro h0
    unfold valL at hϖ
    rw [h0, Nat.cast_zero, Int.ediv_zero] at hϖ
    omega
  have hq_gt : 1 < q F := Finite.one_lt_card
  have hqL_gt : 1 < qL F L := one_lt_pow₀ hq_gt hres_ne
  have hg_deg_all : ∀ m : ℕ,
      (lubinTateIterPoly F L (ϖ : L) m).Monic ∧
      (lubinTateIterPoly F L (ϖ : L) m).natDegree = (qL F L) ^ m := by
    intro m
    have hdeg_lt : (Polynomial.C (ϖ : L) * Polynomial.X).degree <
        (Polynomial.X ^ qL F L : Polynomial L).degree := by
      rw [Polynomial.degree_X_pow]
      exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_le (ϖ : L)) (WithBot.coe_lt_coe.mpr hqL_gt)
    have hf0_monic : (lubinTatePoly F L (ϖ : L)).Monic := by
      change (Polynomial.C (ϖ : L) * Polynomial.X + Polynomial.X ^ qL F L).Monic
      rw [add_comm]
      exact Polynomial.Monic.add_of_left (Polynomial.monic_X_pow (qL F L)) hdeg_lt
    have hf0_deg : (lubinTatePoly F L (ϖ : L)).natDegree = qL F L := by
      change (Polynomial.C (ϖ : L) * Polynomial.X + Polynomial.X ^ qL F L).natDegree = qL F L
      rw [add_comm, Polynomial.natDegree_add_eq_left_of_degree_lt hdeg_lt,
        Polynomial.natDegree_X_pow]
    induction m with
    | zero =>
      dsimp [lubinTateIterPoly]
      exact ⟨Polynomial.monic_X, Polynomial.natDegree_X⟩
    | succ m ih =>
      obtain ⟨ih_monic, ih_deg⟩ := ih
      have h_deg_ne : (lubinTateIterPoly F L (ϖ : L) m).natDegree ≠ 0 := by
        rw [ih_deg]
        exact pow_ne_zero m (by omega)
      dsimp [lubinTateIterPoly]
      refine ⟨hf0_monic.comp ih_monic h_deg_ne, ?_⟩
      rw [Polynomial.natDegree_comp, hf0_deg, ih_deg, pow_succ']
  obtain ⟨hg_monic, hg_deg⟩ := hg_deg_all (n - 1)
  set P0 : Polynomial L := (lubinTateIterPoly F L (ϖ : L) (n - 1)) ^ (qL F L - 1)
  set d : ℕ := (qL F L - 1) * (qL F L) ^ (n - 1)
  have hP0_monic : P0.Monic := hg_monic.pow (qL F L - 1)
  have hP0_deg : P0.natDegree = d := by
    change ((lubinTateIterPoly F L (ϖ : L) (n - 1)) ^ (qL F L - 1)).natDegree = d
    rw [hg_monic.natDegree_pow, hg_deg]
  have hd_pos : 1 ≤ d := Nat.mul_pos (by omega) (pow_pos (by omega) (n - 1))
  have hdeg_C_lt : (Polynomial.C (ϖ : L)).degree < P0.degree := by
    rw [Polynomial.degree_eq_natDegree hP0_monic.ne_zero, hP0_deg]
    exact lt_of_le_of_lt Polynomial.degree_C_le (WithBot.coe_lt_coe.mpr hd_pos)
  set f_n : Polynomial L := lubinTateDivPoly F L (ϖ : L) n
  have hf_deg : f_n.natDegree = d := by
    change (P0 + Polynomial.C (ϖ : L)).natDegree = d
    rw [Polynomial.natDegree_add_eq_left_of_degree_lt hdeg_C_lt, hP0_deg]
  obtain ⟨hf_monic, -, hf_irr⟩ :=
    lubinTateDivPoly_monic_coeff_zero_and_irreducible F L ϖ hϖ n hn
  obtain ⟨π_n, hπ_aeval, hM_eq⟩ :=
    exists_aeval_lubinTateDivPoly_eq_zero_and_lubinTateLevelField_eq_adjoin F L ϖ hϖ n hn
  have hπ_int : IsIntegral ↥L π_n :=
    ⟨f_n, hf_monic, Polynomial.aeval_def π_n f_n ▸ hπ_aeval⟩
  have h_minpoly : minpoly ↥L π_n = f_n :=
    (minpoly.eq_of_irreducible_of_monic hf_irr hπ_aeval hf_monic).symm
  have h_finrank_L : Module.finrank ↥L ↥(lubinTateLevelField F L ϖ n) = d := by
    rw [hM_eq, IntermediateField.adjoin.finrank hπ_int, h_minpoly, hf_deg]
  set S : Set (AlgebraicClosure F) := {α : AlgebraicClosure F | isLubinTateRoot F L ϖ n α}
  have h_field_eq : ltDivSubfield F L n = (lubinTateLevelField F L ϖ n).restrictScalars F := by
    apply le_antisymm
    · unfold ltDivSubfield lubinTateLevelField
      apply sup_le
      · intro x hx
        exact (IntermediateField.mem_restrictScalars F).mpr
          ((IntermediateField.adjoin ↥L S).algebraMap_mem ⟨x, hx⟩)
      · rw [IntermediateField.adjoin_le_iff]
        intro α hα
        exact (IntermediateField.mem_restrictScalars F).mpr
          (IntermediateField.subset_adjoin ↥L S hα)
    · intro z hz
      have hz' : z ∈ IntermediateField.adjoin ↥L S :=
        (IntermediateField.mem_restrictScalars F).mp hz
      clear hz
      induction hz' using IntermediateField.adjoin_induction with
      | mem y hy =>
        exact (le_sup_right : IntermediateField.adjoin F S ≤ ltDivSubfield F L n)
          (IntermediateField.subset_adjoin F S hy)
      | algebraMap r =>
        exact (le_sup_left : L ≤ ltDivSubfield F L n) r.2
      | add x y _ _ hx hy =>
        exact (ltDivSubfield F L n).add_mem hx hy
      | mul x y _ _ hx hy =>
        exact (ltDivSubfield F L n).mul_mem hx hy
      | inv x _ hx =>
        exact (ltDivSubfield F L n).inv_mem hx
  rw [h_field_eq]
  change Module.finrank F ↥(lubinTateLevelField F L ϖ n) = _
  rw [← Module.finrank_mul_finrank F ↥L ↥(lubinTateLevelField F L ϖ n), h_finrank_L, ← mul_assoc]

theorem exists_lowerRamSubgroup_eq_bot (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F E] (hLE : L ≤ E) :
    ∃ N : ℕ, 1 ≤ N ∧
      ∀ u : ℕ, lowerRamSubgroup F hLE u ≠ ⊥ →
        herbrandSum F hLE u < N * Module.finrank L (IntermediateField.extendScalars hLE) :=
by
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab_ne : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab_ne, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h_eq := addVal_mul h1 h1
    rw [mul_one] at h_eq
    omega
  have valL_inv_nonneg : ∀ {y : E}, y ≠ 0 → ¬ (0 ≤ valL F E y) → 0 ≤ valL F E (y⁻¹) := by
    intro y hy hneg
    set a : F := Algebra.norm F y
    set b : F := Algebra.norm F (y⁻¹)
    have ha : a ≠ 0 := (Algebra.norm_ne_zero_iff (R := F) (S := ↥E)).mpr hy
    have hb : b ≠ 0 := (Algebra.norm_ne_zero_iff (R := F) (S := ↥E)).mpr (inv_ne_zero hy)
    have hab1 : a * b = 1 := by
      dsimp [a, b]
      rw [← map_mul, mul_inv_cancel₀ hy, map_one]
    have h_rel_sum : relVal F E y + relVal F E (y⁻¹) = 0 := by
      change addVal F a + addVal F b = 0
      rw [← addVal_mul ha hb, hab1, addVal_one]
    have h_res_nonneg : (0 : ℤ) ≤ (resDeg F E : ℤ) := Nat.cast_nonneg _
    have h_rel_neg : relVal F E y < 0 := by
      by_contra h_nonneg
      push_neg at h_nonneg
      exact hneg (Int.ediv_nonneg h_nonneg h_res_nonneg)
    have h_inv_nonneg : 0 ≤ relVal F E (y⁻¹) := by omega
    exact Int.ediv_nonneg h_inv_nonneg h_res_nonneg
  let E_L := IntermediateField.extendScalars hLE
  let G := E_L ≃ₐ[L] E_L
  have galApply_zero : ∀ σ : G, galApply F hLE σ 0 = 0 := by
    intro σ
    apply Subtype.ext
    exact congrArg Subtype.val (map_zero σ)
  have galApply_inv : ∀ (σ : G) (y : E), galApply F hLE σ (y⁻¹) = (galApply F hLE σ y)⁻¹ := by
    intro σ y
    apply Subtype.ext
    let y_tilde : E_L := ⟨y.1, (IntermediateField.mem_extendScalars hLE).mpr y.2⟩
    exact congrArg Subtype.val (map_inv₀ σ y_tilde)
  let S : ℕ → Set G := fun u =>
    {σ : G | ∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
      galApply F hLE σ x = x ∨ (u + 1 : ℤ) ≤ valL F E (galApply F hLE σ x - x)}
  have exists_bound_of_ne_one : ∀ σ : G, σ ≠ 1 → ∃ u_σ : ℕ, ∀ u : ℕ, u_σ ≤ u → σ ∉ S u := by
    intro σ hσ
    have h_exists_z : ∃ z : E_L, σ z ≠ z := by
      by_contra h_all
      push_neg at h_all
      exact hσ (AlgEquiv.ext h_all)
    obtain ⟨z, hz⟩ := h_exists_z
    let y : E := ⟨z.1, (IntermediateField.mem_extendScalars hLE).mp z.2⟩
    have hy_ne : galApply F hLE σ y ≠ y := by
      intro h_eq
      apply hz
      apply Subtype.ext
      exact congrArg Subtype.val h_eq
    have hy0 : y ≠ 0 := by
      intro h0
      rw [h0, galApply_zero σ] at hy_ne
      exact hy_ne rfl
    have h_exists_x : ∃ x : E, (x = 0 ∨ 0 ≤ valL F E x) ∧ galApply F hLE σ x ≠ x := by
      by_cases hval : 0 ≤ valL F E y
      · exact ⟨y, Or.inr hval, hy_ne⟩
      · refine ⟨y⁻¹, Or.inr (valL_inv_nonneg hy0 hval), ?_⟩
        intro h_eq_inv
        rw [galApply_inv σ y, inv_inj] at h_eq_inv
        exact hy_ne h_eq_inv
    obtain ⟨x, hx_int, hx_ne⟩ := h_exists_x
    refine ⟨(valL F E (galApply F hLE σ x - x)).toNat, ?_⟩
    intro u hu hmem
    rcases hmem x hx_int with h_fix | h_val
    · exact hx_ne h_fix
    · omega
  haveI : FiniteDimensional F ↥E_L := ‹FiniteDimensional F E›
  haveI : FiniteDimensional ↥L ↥E_L := FiniteDimensional.right F ↥L ↥E_L
  letI : Fintype G := AlgEquiv.fintype ↥L ↥E_L
  let f : G → ℕ := fun σ => if h : σ ≠ 1 then (exists_bound_of_ne_one σ h).choose else 0
  let U : ℕ := Finset.univ.sup f
  have h_bot : ∀ u : ℕ, U ≤ u → lowerRamSubgroup F hLE u = ⊥ := by
    intro u hu
    unfold lowerRamSubgroup
    rw [Subgroup.closure_eq_bot_iff, Set.subset_singleton_iff]
    intro σ hσ_mem
    by_contra hσ
    have h_le_U : f σ ≤ U := Finset.le_sup (f := f) (Finset.mem_univ σ)
    have h_f_eq : f σ = (exists_bound_of_ne_one σ hσ).choose := dif_pos hσ
    have h_not_mem : σ ∉ S u :=
      (exists_bound_of_ne_one σ hσ).choose_spec u (by omega)
    exact h_not_mem hσ_mem
  let N : ℕ := herbrandSum F hLE U + 1
  refine ⟨N, by omega, ?_⟩
  intro u hu_ne
  have hu_le : u ≤ U := by
    by_contra h_gt
    exact hu_ne (h_bot u (by omega))
  have h_sum_le : herbrandSum F hLE u ≤ herbrandSum F hLE U := by
    unfold herbrandSum
    exact Finset.sum_le_sum_of_subset (Finset.Icc_subset_Icc_right (a := 1) hu_le)
  have h_pos : 0 < Module.finrank L (IntermediateField.extendScalars hLE) :=
    Module.finrank_pos (R := ↥L) (M := ↥E_L)
  have h_mul : N ≤ N * Module.finrank L (IntermediateField.extendScalars hLE) :=
    Nat.le_mul_of_pos_right N h_pos
  omega

theorem finrank_and_exists_gen_ltDivSubfield (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (n : ℕ) :
    1 ≤ n →
      let hLE : L ≤ ltDivSubfield F L n := le_sup_left
      FiniteDimensional F (ltDivSubfield F L n) ∧
      Module.finrank L (IntermediateField.extendScalars hLE) =
        (qL F L - 1) * (qL F L) ^ (n - 1) ∧
      ∃ π_n : ltDivSubfield F L n,
        Polynomial.aeval (π_n : AlgebraicClosure F)
          (lubinTateDivPoly F L (chosenUniformizer F L : L) n) = 0 ∧
        IntermediateField.extendScalars hLE =
          IntermediateField.adjoin L {(π_n : AlgebraicClosure F)} ∧
        valL F (ltDivSubfield F L n) π_n = 1 ∧
        ∀ c : L, c ≠ 0 →
          valL F (ltDivSubfield F L n) (IntermediateField.inclusion hLE c) =
            (((qL F L - 1) * (qL F L) ^ (n - 1) : ℕ) : ℤ) * valL F L c :=
by
  intro hn
  set E := ltDivSubfield F L n
  set hLE : L ≤ E := le_sup_left
  set E_L := IntermediateField.extendScalars hLE
  set ϖ : Lˣ := chosenUniformizer F L
  have hϖ : valL F L ϖ = 1 := (valL_chosenUniformizer_and_mul_zpow F L 1).1
  have hres_ne : resDeg F L ≠ 0 := by
    intro h0
    unfold valL at hϖ
    rw [h0, Nat.cast_zero, Int.ediv_zero] at hϖ
    omega
  have hq_gt : 1 < q F := Finite.one_lt_card
  have hqL_gt : 1 < qL F L := one_lt_pow₀ hq_gt hres_ne
  have hg_deg_all : ∀ m : ℕ,
      (lubinTateIterPoly F L (ϖ : L) m).Monic ∧
      (lubinTateIterPoly F L (ϖ : L) m).natDegree = (qL F L) ^ m := by
    intro m
    have hdeg_lt : (Polynomial.C (ϖ : L) * Polynomial.X).degree <
        (Polynomial.X ^ qL F L : Polynomial L).degree := by
      rw [Polynomial.degree_X_pow]
      exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_le (ϖ : L)) (WithBot.coe_lt_coe.mpr hqL_gt)
    have hf0_monic : (lubinTatePoly F L (ϖ : L)).Monic := by
      change (Polynomial.C (ϖ : L) * Polynomial.X + Polynomial.X ^ qL F L).Monic
      rw [add_comm]
      exact Polynomial.Monic.add_of_left (Polynomial.monic_X_pow (qL F L)) hdeg_lt
    have hf0_deg : (lubinTatePoly F L (ϖ : L)).natDegree = qL F L := by
      change (Polynomial.C (ϖ : L) * Polynomial.X + Polynomial.X ^ qL F L).natDegree = qL F L
      rw [add_comm, Polynomial.natDegree_add_eq_left_of_degree_lt hdeg_lt,
        Polynomial.natDegree_X_pow]
    induction m with
    | zero =>
      dsimp [lubinTateIterPoly]
      exact ⟨Polynomial.monic_X, Polynomial.natDegree_X⟩
    | succ m ih =>
      obtain ⟨ih_monic, ih_deg⟩ := ih
      have h_deg_ne : (lubinTateIterPoly F L (ϖ : L) m).natDegree ≠ 0 := by
        rw [ih_deg]
        exact pow_ne_zero m (by omega)
      dsimp [lubinTateIterPoly]
      refine ⟨hf0_monic.comp ih_monic h_deg_ne, ?_⟩
      rw [Polynomial.natDegree_comp, hf0_deg, ih_deg, pow_succ']
  obtain ⟨hg_monic, hg_deg⟩ := hg_deg_all (n - 1)
  set P0 : Polynomial L := (lubinTateIterPoly F L (ϖ : L) (n - 1)) ^ (qL F L - 1)
  set d : ℕ := (qL F L - 1) * (qL F L) ^ (n - 1)
  have hP0_monic : P0.Monic := hg_monic.pow (qL F L - 1)
  have hP0_deg : P0.natDegree = d := by
    change ((lubinTateIterPoly F L (ϖ : L) (n - 1)) ^ (qL F L - 1)).natDegree = d
    rw [hg_monic.natDegree_pow, hg_deg]
  have hd_pos : 1 ≤ d := Nat.mul_pos (by omega) (pow_pos (by omega) (n - 1))
  have hdeg_C_lt : (Polynomial.C (ϖ : L)).degree < P0.degree := by
    rw [Polynomial.degree_eq_natDegree hP0_monic.ne_zero, hP0_deg]
    exact lt_of_le_of_lt Polynomial.degree_C_le (WithBot.coe_lt_coe.mpr hd_pos)
  set f_n : Polynomial L := lubinTateDivPoly F L (ϖ : L) n
  have hf_deg : f_n.natDegree = d := by
    change (P0 + Polynomial.C (ϖ : L)).natDegree = d
    rw [Polynomial.natDegree_add_eq_left_of_degree_lt hdeg_C_lt, hP0_deg]
  obtain ⟨hf_monic, hf_coeff, hf_irr⟩ :=
    lubinTateDivPoly_monic_coeff_zero_and_irreducible F L ϖ hϖ n hn
  obtain ⟨π₀, hπ₀_aeval, hM_eq⟩ :=
    exists_aeval_lubinTateDivPoly_eq_zero_and_lubinTateLevelField_eq_adjoin F L ϖ hϖ n hn
  set S : Set (AlgebraicClosure F) := {α : AlgebraicClosure F | isLubinTateRoot F L ϖ n α}
  have hE_le : E ≤ (lubinTateLevelField F L ϖ n).restrictScalars F := by
    unfold E ltDivSubfield lubinTateLevelField
    apply sup_le
    · intro x hx
      exact (IntermediateField.mem_restrictScalars F).mpr
        ((IntermediateField.adjoin ↥L S).algebraMap_mem ⟨x, hx⟩)
    · rw [IntermediateField.adjoin_le_iff]
      intro α hα
      exact (IntermediateField.mem_restrictScalars F).mpr
        (IntermediateField.subset_adjoin ↥L S hα)
  have h_ext_eq : E_L = lubinTateLevelField F L ϖ n := by
    apply le_antisymm
    · intro z hz
      exact (IntermediateField.mem_restrictScalars F).mp
        (hE_le ((IntermediateField.mem_extendScalars hLE).mp hz))
    · unfold lubinTateLevelField
      rw [IntermediateField.adjoin_le_iff]
      intro α hα
      exact (IntermediateField.mem_extendScalars hLE).mpr
        ((le_sup_right : IntermediateField.adjoin F S ≤ E)
          (IntermediateField.subset_adjoin F S hα))
  have h_adj0 : E_L = IntermediateField.adjoin L {π₀} := h_ext_eq.trans hM_eq
  have hπ₀_mem_EL : π₀ ∈ E_L := by
    rw [h_adj0]
    exact IntermediateField.mem_adjoin_simple_self ↥L π₀
  have hπ₀_mem : π₀ ∈ E := (IntermediateField.mem_extendScalars hLE).mp hπ₀_mem_EL
  let π_n : E := ⟨π₀, hπ₀_mem⟩
  have hπ_int : IsIntegral ↥L π₀ :=
    ⟨f_n, hf_monic, Polynomial.aeval_def π₀ f_n ▸ hπ₀_aeval⟩
  have h_minpoly : minpoly ↥L π₀ = f_n :=
    (minpoly.eq_of_irreducible_of_monic hf_irr hπ₀_aeval hf_monic).symm
  have h_finrank : Module.finrank ↥L ↥E_L = d := by
    rw [h_adj0, IntermediateField.adjoin.finrank hπ_int, h_minpoly, hf_deg]
  haveI : FiniteDimensional ↥L ↥E_L :=
    Module.finite_of_finrank_pos (by rw [h_finrank]; exact hd_pos)
  have hFinE : FiniteDimensional F ↥E := by
    change FiniteDimensional F ↥E_L
    exact FiniteDimensional.trans F ↥L ↥E_L
  haveI : FiniteDimensional F ↥E := hFinE
  obtain ⟨τ, hτL, hτFrob⟩ := exists_actsAsFrobPow_neg_resDeg F L
  obtain ⟨σ, hσL, hσFrob, hσLT⟩ :=
    exists_isLubinTateFrob_of_frobLift F L ϖ hϖ τ hτL hτFrob
  have hσ_fix_E : σ ∈ E.fixingSubgroup := by
    change σ ∈ (ltDivSubfield F L n).fixingSubgroup
    unfold ltDivSubfield
    rw [IntermediateField.fixingSubgroup_sup]
    refine Subgroup.mem_inf.mpr ⟨hσL, ?_⟩
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    induction hz using IntermediateField.adjoin_induction with
    | mem α hα => exact hσLT n α hα
    | algebraMap r => exact AlgEquiv.commutes _ r
    | add a b _ _ ha hb => rw [map_add, ha, hb]
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
    | inv a _ ha => rw [map_inv₀, ha]
  have h_resDeg : resDeg F E = resDeg F L :=
    resDeg_eq_of_actsAsFrobPow_neg_resDeg_and_mem_fixingSubgroup F L E hLE σ hσFrob hσ_fix_E
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  have addVal_pow : ∀ {a : F} (ha : a ≠ 0) (k : ℕ),
      addVal F (a ^ k) = (k : ℤ) * addVal F a := by
    intro a ha k
    let u : Fˣ := Units.mk0 a ha
    change Multiplicative.toAdd (addValHom (u ^ k)) = (k : ℤ) * Multiplicative.toAdd (addValHom u)
    rw [map_pow, toAdd_pow, nsmul_eq_mul]
  have h_gen_norm : ∀ (K Ω : Type u) [Field K] [Field Ω] [Algebra K Ω]
      (B : IntermediateField K Ω) (g : Polynomial K) (α : Ω) (x : B),
      (x : Ω) = α → B = IntermediateField.adjoin K {α} → g.Monic → Irreducible g →
      Polynomial.aeval α g = 0 → Algebra.norm K (-x) = g.coeff 0 := by
    intro K Ω _ _ _ B g α x hx hB hg_monic hg_irr hg_aeval
    subst hB
    have h_int : IsIntegral K α :=
      ⟨g, hg_monic, Polynomial.aeval_def α g ▸ hg_aeval⟩
    let pb : PowerBasis K ↥(IntermediateField.adjoin K {α}) :=
      IntermediateField.adjoin.powerBasis h_int
    have h_min : minpoly K pb.gen = g := by
      rw [IntermediateField.adjoin.powerBasis_gen h_int, IntermediateField.minpoly_gen K α]
      exact (minpoly.eq_of_irreducible_of_monic hg_irr hg_aeval hg_monic).symm
    have h_norm_gen : Algebra.norm K pb.gen = (-1 : K) ^ pb.dim * g.coeff 0 := by
      rw [Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, h_min]
    have hx_eq : x = pb.gen := by
      apply Subtype.ext
      rw [hx, IntermediateField.adjoin.powerBasis_gen h_int]
      rfl
    rw [hx_eq]
    have h_neg : (-pb.gen : ↥(IntermediateField.adjoin K {α})) =
        algebraMap K ↥(IntermediateField.adjoin K {α}) (-1 : K) * pb.gen := by
      simp
    rw [h_neg, map_mul, Algebra.norm_algebraMap, pb.finrank, h_norm_gen, ← mul_assoc, ← mul_pow]
    simp
  let x_n : E_L := toExtendScalars F hLE π_n
  have h_norm_neg_L : Algebra.norm ↥L (-x_n) = (ϖ : L) := by
    rw [h_gen_norm ↥L (AlgebraicClosure F) E_L f_n π₀ x_n rfl h_adj0 hf_monic hf_irr hπ₀_aeval,
      hf_coeff]
  have h_norm_neg_F : Algebra.norm F (-π_n : E) = Algebra.norm F (ϖ : L) := by
    change Algebra.norm F (-x_n) = Algebra.norm F (ϖ : L)
    rw [← Algebra.norm_norm (R := F) (S := ↥L) (a := -x_n), h_norm_neg_L]
  have h_norm_sq_F : (Algebra.norm F π_n) ^ 2 = (Algebra.norm F (ϖ : L)) ^ 2 := by
    calc (Algebra.norm F π_n) ^ 2 = Algebra.norm F (π_n ^ 2) := (map_pow _ _ 2).symm
      _ = Algebra.norm F ((-π_n) ^ 2) := by rw [neg_sq]
      _ = (Algebra.norm F (-π_n)) ^ 2 := map_pow _ _ 2
      _ = (Algebra.norm F (ϖ : L)) ^ 2 := by rw [h_norm_neg_F]
  have hn_ϖ : Algebra.norm F (ϖ : L) ≠ 0 := (ϖ.isUnit.map (Algebra.norm F)).ne_zero
  have hn_π : Algebra.norm F π_n ≠ 0 := by
    intro h0
    have hsq : (Algebra.norm F (ϖ : L)) ^ 2 = 0 := by
      rw [← h_norm_sq_F, h0, zero_pow two_ne_zero]
    exact hn_ϖ (pow_eq_zero hsq)
  have hπ_ne : π_n ≠ 0 := by
    intro h0
    apply hn_π
    have h0' : (π_n : E) = algebraMap F E 0 := by rw [h0, map_zero]
    rw [h0', Algebra.norm_algebraMap, zero_pow (Module.finrank_pos.ne')]
  have h_relVal_sq : 2 * relVal F E π_n = 2 * relVal F L (ϖ : L) := by
    have h1 := addVal_pow hn_π 2
    have h2 := addVal_pow hn_ϖ 2
    rw [h_norm_sq_F] at h1
    change addVal F ((Algebra.norm F (ϖ : L)) ^ 2) = (2 : ℤ) * relVal F E π_n at h1
    change addVal F ((Algebra.norm F (ϖ : L)) ^ 2) = (2 : ℤ) * relVal F L (ϖ : L) at h2
    omega
  have h_relVal_π : relVal F E π_n = relVal F L (ϖ : L) := by omega
  let u_π : Eˣ := Units.mk0 π_n hπ_ne
  have h_val_π : valL F E π_n = 1 := by
    have h1 : relVal F E u_π = (resDeg F E : ℤ) * valL F E u_π :=
      relVal_eq_resDeg_mul_valL F E u_π
    have h2 : relVal F L ϖ = (resDeg F L : ℤ) * valL F L ϖ :=
      relVal_eq_resDeg_mul_valL F L ϖ
    change relVal F E π_n = (resDeg F E : ℤ) * valL F E π_n at h1
    rw [h_relVal_π, h2, h_resDeg, hϖ] at h1
    have hres_z : (resDeg F L : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr hres_ne
    exact (mul_left_cancel₀ hres_z h1).symm
  have h_val_inc : ∀ c : L, c ≠ 0 →
      valL F E (IntermediateField.inclusion hLE c) = (d : ℤ) * valL F L c := by
    intro c hc
    let cE : E := IntermediateField.inclusion hLE c
    let cEL : E_L := algebraMap ↥L ↥E_L c
    have h_norm_c_L : Algebra.norm ↥L cEL = c ^ d := by
      rw [Algebra.norm_algebraMap, h_finrank]
    have h_norm_c_F : Algebra.norm F cE = (Algebra.norm F c) ^ d := by
      change Algebra.norm F cEL = (Algebra.norm F c) ^ d
      rw [← Algebra.norm_norm (R := F) (S := ↥L) (a := cEL), h_norm_c_L, map_pow]
    let u_c : Lˣ := Units.mk0 c hc
    have hcE_ne : cE ≠ 0 := (map_ne_zero (IntermediateField.inclusion hLE)).mpr hc
    let u_cE : Eˣ := Units.mk0 cE hcE_ne
    have hn_c : Algebra.norm F c ≠ 0 := (u_c.isUnit.map (Algebra.norm F)).ne_zero
    have h_relVal_c : relVal F E cE = (d : ℤ) * relVal F L c := by
      change addVal F (Algebra.norm F cE) = (d : ℤ) * addVal F (Algebra.norm F c)
      rw [h_norm_c_F, addVal_pow hn_c d]
    have h1 : relVal F E u_cE = (resDeg F E : ℤ) * valL F E u_cE :=
      relVal_eq_resDeg_mul_valL F E u_cE
    have h2 : relVal F L u_c = (resDeg F L : ℤ) * valL F L u_c :=
      relVal_eq_resDeg_mul_valL F L u_c
    change relVal F E cE = (resDeg F E : ℤ) * valL F E cE at h1
    change relVal F L c = (resDeg F L : ℤ) * valL F L c at h2
    rw [h_relVal_c, h2, h_resDeg] at h1
    have h1' : (resDeg F L : ℤ) * valL F E cE = (resDeg F L : ℤ) * ((d : ℤ) * valL F L c) := by
      linarith
    have hres_z : (resDeg F L : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr hres_ne
    exact mul_left_cancel₀ hres_z h1'
  exact ⟨hFinE, h_finrank, π_n, hπ₀_aeval, h_adj0, h_val_π, h_val_inc⟩

theorem galApply_sub_of_mem_lowerRamSubgroup (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
    (hLE : L ≤ E) (u : ℕ) (x : E) :
    (x = 0 ∨ 0 ≤ valL F E x) →
      (∀ σ ∈ lowerRamSubgroup F hLE u,
        galApply F hLE σ x = x ∨ (u + 1 : ℤ) ≤ valL F E (galApply F hLE σ x - x)) ∧
      (∀ σ₁ ∈ lowerRamSubgroup F hLE u, ∀ σ₂ ∈ lowerRamSubgroup F hLE u,
        galApply F hLE σ₁ x = galApply F hLE σ₂ x ∨
          (u + 1 : ℤ) ≤ valL F E (galApply F hLE σ₁ x - galApply F hLE σ₂ x)) :=
by
  intro hx
  have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
      0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
    intro a ha
    unfold addVal
    rw [dif_neg ha]
    set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    set va := valuation F a
    have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
    constructor
    · intro h_nonneg
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
      have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
      have h_iso : iso va ≤ iso 1 := by
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
        exact WithZero.coe_le_coe.mpr h_unzero
      exact (map_le_map_iff iso).mp h_iso
    · intro h_le
      have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
      rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
        Multiplicative.toAdd_le.mpr h_iso
      omega
  have addVal_mul : ∀ {y₁ y₂ : F} (hy₁ : y₁ ≠ 0) (hy₂ : y₂ ≠ 0),
      addVal F (y₁ * y₂) = addVal F y₁ + addVal F y₂ := by
    intro y₁ y₂ hy₁ hy₂
    have hy₁₂ : y₁ * y₂ ≠ 0 := mul_ne_zero hy₁ hy₂
    simp only [addVal, hy₁, hy₂, hy₁₂, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun w => Multiplicative.ofAdd (addVal F w)
      map_one' := by simp [addVal_one]
      map_mul' := fun w₁ w₂ => by simp [addVal_mul w₁.ne_zero w₂.ne_zero, ofAdd_add] }
  let relValHom : Eˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ w : Eˣ, Multiplicative.toAdd (relValHom w) = relVal F E w :=
    fun _ => rfl
  have relVal_units_mul : ∀ w₁ w₂ : Eˣ,
      relVal F E ((w₁ * w₂ : Eˣ) : E) = relVal F E w₁ + relVal F E w₂ := by
    intro w₁ w₂
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (w : Eˣ) (k : ℤ),
      relVal F E ((w ^ k : Eˣ) : E) = k * relVal F E w := by
    intro w k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have exists_addVal_eq_one : ∃ w : Fˣ, addVal F w = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F E ∧ ∃ π : Eˣ, relVal F E π = resDeg F E := by
    obtain ⟨w, hw⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : E, z ≠ 0 ∧ relVal F E z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F E, Module.finrank_pos, algebraMap F E w,
        (map_ne_zero (algebraMap F E)).mpr w.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F E (w : F)) = (w : F) ^ Module.finrank F E :=
        Algebra.norm_algebraMap (w : F)
      have hpow : addVal F ((w : F) ^ Module.finrank F E) =
          (Module.finrank F E : ℤ) * addVal F w := by
        change Multiplicative.toAdd (addValHom (w ^ Module.finrank F E)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hw, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hf_pos, π_ex, hπ_ex⟩ := resDeg_mem
  have relVal_eq_resDeg_mul_valL_aux :
      ∀ w : Eˣ, relVal F E w = (resDeg F E : ℤ) * valL F E w := by
    intro w
    let q := relVal F E w / (resDeg F E : ℤ)
    let r := relVal F E w % (resDeg F E : ℤ)
    have hdiv : r + (resDeg F E : ℤ) * q = relVal F E w := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r := Int.emod_nonneg _ (by positivity)
    have hrlt : r < (resDeg F E : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F E ((w * π_ex ^ (-q) : Eˣ) : E) = r := by
      rw [relVal_units_mul, relVal_units_zpow, hπ_ex]
      linarith
    have hr_eq : r = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : E, z ≠ 0 ∧ relVal F E z = k} := by
        refine ⟨hr_pos, ((w * π_ex ^ (-q) : Eˣ) : E), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F E ≤ r.toNat := Nat.sInf_le hmem
      omega
    change relVal F E w = (resDeg F E : ℤ) * q
    linarith
  let m : ℤ := (u + 1 : ℤ)
  let V_m : E → Prop := fun z => z = 0 ∨ m ≤ valL F E z
  let u_m : Eˣ := π_ex ^ (-m)
  have h_rescale : ∀ z : E,
      V_m z ↔ (z * (u_m : E) = 0 ∨ 0 ≤ relVal F E (z * (u_m : E))) := by
    intro z
    change (z = 0 ∨ m ≤ valL F E z) ↔ (z * (u_m : E) = 0 ∨ 0 ≤ relVal F E (z * (u_m : E)))
    by_cases hz0 : z = 0
    · simp [hz0]
    · have hum0 : (u_m : E) ≠ 0 := Units.ne_zero u_m
      have hzum0 : z * (u_m : E) ≠ 0 := mul_ne_zero hz0 hum0
      rw [or_iff_right hz0, or_iff_right hzum0]
      let uz : Eˣ := Units.mk0 z hz0
      have h_eq : z * (u_m : E) = ((uz * u_m : Eˣ) : E) := rfl
      have h_rel : relVal F E (z * (u_m : E)) =
          (resDeg F E : ℤ) * (valL F E z - m) := by
        rw [h_eq, relVal_units_mul, relVal_eq_resDeg_mul_valL_aux uz]
        change (resDeg F E : ℤ) * valL F E z + relVal F E ((π_ex ^ (-m) : Eˣ) : E) = _
        rw [relVal_units_zpow, hπ_ex]
        ring
      rw [h_rel]
      have hf_pos_z : (0 : ℤ) < (resDeg F E : ℤ) := by positivity
      constructor
      · intro hm
        have hsub : 0 ≤ valL F E z - m := by omega
        exact mul_nonneg (by positivity) hsub
      · intro hmul
        have hsub : 0 ≤ valL F E z - m := nonneg_of_mul_nonneg_right hmul hf_pos_z
        omega
  have h_norm_minpoly : ∀ (K : Type u) [Field K] [Algebra F K] [FiniteDimensional F K] (z : K),
      ∃ dK : ℕ, 0 < dK ∧
        ∃ s : ℕ, Algebra.norm F z = ((-1 : F) ^ s * (minpoly F z).coeff 0) ^ dK := by
    intro K _ _ _ z
    have hz_int_F : IsIntegral F z := Algebra.IsIntegral.isIntegral z
    let pb : PowerBasis F (IntermediateField.adjoin F ({z} : Set K)) :=
      IntermediateField.adjoin.powerBasis hz_int_F
    have h_gen_coe : (pb.gen : K) = z := IntermediateField.AdjoinSimple.coe_gen F z
    set dK : ℕ := Module.finrank (IntermediateField.adjoin F ({z} : Set K)) K
    have h_finrank_pos : 0 < dK := Module.finrank_pos
    have h_norm_tower : Algebra.norm F z = (Algebra.norm F pb.gen) ^ dK := by
      have h1 : Algebra.norm F (pb.gen : K) = (Algebra.norm F pb.gen) ^ dK := by
        rw [← Algebra.norm_norm (R := F) (S := IntermediateField.adjoin F ({z} : Set K))
          (A := K) (a := (pb.gen : K)), ← map_pow]
        congr 1
        exact Algebra.norm_algebraMap (L := K) pb.gen
      rwa [h_gen_coe] at h1
    have h_norm_pb : Algebra.norm F pb.gen =
        (-1) ^ pb.dim * (minpoly F pb.gen).coeff 0 :=
      Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb
    have h_minpoly_eq : minpoly F pb.gen = minpoly F z := by
      have h1 : minpoly F pb.gen = minpoly F (pb.gen : K) :=
        (minpoly.algHom_eq
          (IntermediateField.val (IntermediateField.adjoin F ({z} : Set K)))
          (IntermediateField.val (IntermediateField.adjoin F ({z} : Set K))).injective
          pb.gen).symm
      rwa [h_gen_coe] at h1
    refine ⟨dK, h_finrank_pos, pb.dim, ?_⟩
    rw [h_norm_tower, h_norm_pb, h_minpoly_eq]
  letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
  haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
  haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
  letI : Valued F (ValueGroupWithZero F) :=
    IsValuativeTopology.instValuedValueGroupWithZeroOfIsUniformAddGroup
  let rlo : RankLeOneStruct F :=
    { emb := (WithZeroMulInt.toNNReal (by norm_num : (2 : NNReal) ≠ 0)).comp
        (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).toMonoidWithZeroHom
      strictMono := (WithZeroMulInt.toNNReal_strictMono (by norm_num : (1 : NNReal) < 2)).comp
        (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).strictMono }
  haveI : (Valued.v (R := F)).RankOne := Valuation.RankOne.ofRankLeOneStruct rlo
  letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
  haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F (ValueGroupWithZero F)
  haveI : Algebra.IsAlgebraic F E := Algebra.IsAlgebraic.of_finite F E
  have h_spec : ∀ z : E, (z = 0 ∨ 0 ≤ relVal F E z) ↔ spectralNorm F E z ≤ 1 := by
    intro z
    by_cases hz0 : z = 0
    · subst hz0
      simp [spectralNorm_zero]
    · rw [or_iff_right hz0]
      have hnorm0 : Algebra.norm F z ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hz0
      have hz_int_F : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      obtain ⟨dK, h_finrank_pos, s, h_norm_eq⟩ := h_norm_minpoly E z
      have h_norm_coeff_pow : ‖Algebra.norm F z‖ =
          ‖(minpoly F z).coeff 0‖ ^ dK := by
        rw [h_norm_eq, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
      have h_deg_pos : 0 < (minpoly F z).natDegree := minpoly.natDegree_pos hz_int_F
      have he_pos : (0 : ℝ) < 1 / ((minpoly F z).natDegree : ℝ) := by positivity
      have h_val_norm_iff : valuation F (Algebra.norm F z) ≤ 1 ↔ ‖Algebra.norm F z‖ ≤ 1 :=
        Valued.toNormedField.norm_le_one_iff.symm
      rw [relVal, addVal_nonneg_iff_val_le_one hnorm0, h_val_norm_iff, h_norm_coeff_pow,
        pow_le_one_iff_of_nonneg (norm_nonneg _) h_finrank_pos.ne',
        spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow F E z]
      constructor
      · intro hc0
        exact Real.rpow_le_one (norm_nonneg _) hc0 (by positivity)
      · intro h_rpow
        by_contra h_gt
        push_neg at h_gt
        have h_one_lt : 1 < ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) :=
          Real.one_lt_rpow h_gt he_pos
        linarith
  have h_ult : ∀ z₁ z₂ : E,
      spectralNorm F E z₁ ≤ 1 → spectralNorm F E z₂ ≤ 1 →
      spectralNorm F E (z₁ + z₂) ≤ 1 ∧ spectralNorm F E (z₁ - z₂) ≤ 1 := by
    intro z₁ z₂ hz₁ hz₂
    have h_add : spectralNorm F E (z₁ + z₂) ≤ 1 :=
      le_trans (isNonarchimedean_spectralNorm z₁ z₂) (max_le hz₁ hz₂)
    have h_neg : spectralNorm F E (-z₂) ≤ 1 := by
      rw [spectralNorm_neg (Algebra.IsAlgebraic.isAlgebraic z₂)]
      exact hz₂
    have h_sub : spectralNorm F E (z₁ - z₂) ≤ 1 := by
      rw [sub_eq_add_neg]
      exact le_trans (isNonarchimedean_spectralNorm z₁ (-z₂)) (max_le hz₁ h_neg)
    exact ⟨h_add, h_sub⟩
  have hV_add : ∀ {z₁ z₂ : E}, V_m z₁ → V_m z₂ → V_m (z₁ + z₂) := by
    intro z₁ z₂ hz₁ hz₂
    rw [h_rescale, h_spec, add_mul]
    have h₁ : spectralNorm F E (z₁ * (u_m : E)) ≤ 1 := (h_spec _).mp ((h_rescale _).mp hz₁)
    have h₂ : spectralNorm F E (z₂ * (u_m : E)) ≤ 1 := (h_spec _).mp ((h_rescale _).mp hz₂)
    exact (h_ult _ _ h₁ h₂).1
  have hV_sub : ∀ {z₁ z₂ : E}, V_m z₁ → V_m z₂ → V_m (z₁ - z₂) := by
    intro z₁ z₂ hz₁ hz₂
    rw [h_rescale, h_spec, sub_mul]
    have h₁ : spectralNorm F E (z₁ * (u_m : E)) ≤ 1 := (h_spec _).mp ((h_rescale _).mp hz₁)
    have h₂ : spectralNorm F E (z₂ * (u_m : E)) ≤ 1 := (h_spec _).mp ((h_rescale _).mp hz₂)
    exact (h_ult _ _ h₁ h₂).2
  have hV_neg : ∀ {z : E}, V_m z → V_m (-z) := by
    intro z hz
    have h0 : V_m 0 := Or.inl rfl
    have hsub := hV_sub h0 hz
    rwa [zero_sub] at hsub
  let E_L := IntermediateField.extendScalars hLE
  let G := E_L ≃ₐ[L] E_L
  let toEL : E → E_L := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLE).mpr y.2⟩
  have toEL_inj : ∀ {y z : E}, toEL y = toEL z → y = z :=
    fun h => Subtype.ext (congrArg Subtype.val h)
  have toEL_galApply : ∀ (σ : G) (y : E), toEL (galApply F hLE σ y) = σ (toEL y) :=
    fun _ _ => Subtype.ext rfl
  have toEL_zero : toEL 0 = 0 := Subtype.ext rfl
  have toEL_add : ∀ y z : E, toEL (y + z) = toEL y + toEL z := fun _ _ => Subtype.ext rfl
  have toEL_sub : ∀ y z : E, toEL (y - z) = toEL y - toEL z := fun _ _ => Subtype.ext rfl
  have toEL_mul : ∀ y z : E, toEL (y * z) = toEL y * toEL z := fun _ _ => Subtype.ext rfl
  have toEL_algMap : ∀ c : F, toEL (algebraMap F E c) = algebraMap L E_L (algebraMap F L c) :=
    fun _ => Subtype.ext rfl
  have galApply_one : ∀ y : E, galApply F hLE 1 y = y :=
    fun y => toEL_inj (by rw [toEL_galApply, AlgEquiv.one_apply])
  have galApply_mul : ∀ (σ τ : G) (y : E),
      galApply F hLE (σ * τ) y = galApply F hLE σ (galApply F hLE τ y) :=
    fun σ τ y => toEL_inj (by rw [toEL_galApply, toEL_galApply, toEL_galApply, AlgEquiv.mul_apply])
  have galApply_inv_left : ∀ (σ : G) (y : E), galApply F hLE σ⁻¹ (galApply F hLE σ y) = y := by
    intro σ y
    rw [← galApply_mul, inv_mul_cancel, galApply_one]
  have galApply_inv_right : ∀ (σ : G) (y : E), galApply F hLE σ (galApply F hLE σ⁻¹ y) = y := by
    intro σ y
    rw [← galApply_mul, mul_inv_cancel, galApply_one]
  have galApply_add : ∀ (σ : G) (y z : E),
      galApply F hLE σ (y + z) = galApply F hLE σ y + galApply F hLE σ z :=
    fun σ y z => toEL_inj (by
      rw [toEL_galApply, toEL_add, map_add, toEL_add, toEL_galApply, toEL_galApply])
  have galApply_sub : ∀ (σ : G) (y z : E),
      galApply F hLE σ (y - z) = galApply F hLE σ y - galApply F hLE σ z :=
    fun σ y z => toEL_inj (by
      rw [toEL_galApply, toEL_sub, map_sub, toEL_sub, toEL_galApply, toEL_galApply])
  have galApply_mul_val : ∀ (σ : G) (y z : E),
      galApply F hLE σ (y * z) = galApply F hLE σ y * galApply F hLE σ z :=
    fun σ y z => toEL_inj (by
      rw [toEL_galApply, toEL_mul, map_mul, toEL_mul, toEL_galApply, toEL_galApply])
  have galApply_zero : ∀ σ : G, galApply F hLE σ 0 = 0 :=
    fun σ => toEL_inj (by rw [toEL_galApply, toEL_zero, map_zero])
  let galAlgEquiv : G → (E ≃ₐ[F] E) := fun σ =>
    { toFun := galApply F hLE σ
      invFun := galApply F hLE σ⁻¹
      left_inv := galApply_inv_left σ
      right_inv := galApply_inv_right σ
      map_mul' := galApply_mul_val σ
      map_add' := galApply_add σ
      commutes' := fun c => toEL_inj (by rw [toEL_galApply, toEL_algMap, σ.commutes]) }
  have norm_galApply : ∀ (σ : G) (z : E),
      Algebra.norm F (galApply F hLE σ z) = Algebra.norm F z :=
    fun σ z => Algebra.norm_eq_of_algEquiv (galAlgEquiv σ) z
  have valL_galApply : ∀ (σ : G) (z : E),
      valL F E (galApply F hLE σ z) = valL F E z := by
    intro σ z
    unfold valL relVal
    rw [norm_galApply]
  have hV_gal : ∀ (σ : G) {z : E}, V_m z → V_m (galApply F hLE σ z) := by
    intro σ z hz
    rcases hz with rfl | hz
    · rw [galApply_zero]
      exact Or.inl rfl
    · right
      rwa [valL_galApply]
  let H_x : Subgroup G :=
    { carrier := {σ : G | V_m (galApply F hLE σ x - x)}
      one_mem' := by
        simp only [Set.mem_setOf_eq, galApply_one, sub_self]
        exact Or.inl rfl
      mul_mem' := by
        intro σ τ hσ hτ
        simp only [Set.mem_setOf_eq] at hσ hτ ⊢
        have h_id : galApply F hLE (σ * τ) x - x =
            galApply F hLE σ (galApply F hLE τ x - x) + (galApply F hLE σ x - x) := by
          rw [galApply_mul, galApply_sub, sub_add_sub_cancel]
        rw [h_id]
        exact hV_add (hV_gal σ hτ) hσ
      inv_mem' := by
        intro σ hσ
        simp only [Set.mem_setOf_eq] at hσ ⊢
        have h_id : galApply F hLE σ⁻¹ x - x =
            -(galApply F hLE σ⁻¹ (galApply F hLE σ x - x)) := by
          rw [galApply_sub, galApply_inv_left, neg_sub]
        rw [h_id]
        exact hV_neg (hV_gal σ⁻¹ hσ) }
  have h_le : lowerRamSubgroup F hLE u ≤ H_x := by
    unfold lowerRamSubgroup
    rw [Subgroup.closure_le]
    intro σ hσ
    simp only [Set.mem_setOf_eq] at hσ
    change V_m (galApply F hLE σ x - x)
    change galApply F hLE σ x - x = 0 ∨ (u + 1 : ℤ) ≤ valL F E (galApply F hLE σ x - x)
    rw [sub_eq_zero]
    exact hσ x hx
  constructor
  · intro σ hσ
    have h_mem : V_m (galApply F hLE σ x - x) := h_le hσ
    change galApply F hLE σ x - x = 0 ∨ (u + 1 : ℤ) ≤ valL F E (galApply F hLE σ x - x) at h_mem
    rwa [sub_eq_zero] at h_mem
  · intro σ₁ hσ₁ σ₂ hσ₂
    have h₁ : V_m (galApply F hLE σ₁ x - x) := h_le hσ₁
    have h₂ : V_m (galApply F hLE σ₂ x - x) := h_le hσ₂
    have h_diff : V_m ((galApply F hLE σ₁ x - x) - (galApply F hLE σ₂ x - x)) := hV_sub h₁ h₂
    rw [sub_sub_sub_cancel_right] at h_diff
    change galApply F hLE σ₁ x - galApply F hLE σ₂ x = 0 ∨
      (u + 1 : ℤ) ≤ valL F E (galApply F hLE σ₁ x - galApply F hLE σ₂ x) at h_diff
    rwa [sub_eq_zero] at h_diff

theorem valL_eval₂_lubinTateEndoPoly_sub_eq (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    [FiniteDimensional F E] (hLE : L ≤ E) (n : ℕ) :
    1 ≤ n →
      ∀ (π_E : E), valL F E π_E = 1 →
        (∀ c : L, c ≠ 0 →
          valL F E (IntermediateField.inclusion hLE c) =
            (((qL F L - 1) * (qL F L) ^ (n - 1) : ℕ) : ℤ) * valL F L c) →
        ∀ (a₁ a₂ : L), (a₁ = 0 ∨ 0 ≤ valL F L a₁) → (a₂ = 0 ∨ 0 ≤ valL F L a₂) →
          a₁ ≠ a₂ → ∀ (k : ℕ), k < n → valL F L (a₁ - a₂) = (k : ℤ) →
            let y₁ : E := Polynomial.eval₂ (IntermediateField.inclusion hLE).toRingHom π_E
              (lubinTateEndoPoly F L (chosenUniformizer F L : L) a₁ n)
            let y₂ : E := Polynomial.eval₂ (IntermediateField.inclusion hLE).toRingHom π_E
              (lubinTateEndoPoly F L (chosenUniformizer F L : L) a₂ n)
            y₁ ≠ y₂ ∧ valL F E (y₁ - y₂) = ((qL F L) ^ k : ℤ) :=
by
  intro hn π_E hπ_E h_val_inc a₁ a₂ ha₁ ha₂ hne k hk hval y₁ y₂
  have hval_zero_E : valL F E 0 = 0 := by
    unfold valL relVal addVal
    rw [Algebra.norm_zero, dif_pos rfl, Int.zero_ediv]
  have hπ_E_ne : π_E ≠ 0 := by
    intro h0
    rw [h0, hval_zero_E] at hπ_E
    omega
  let ϖ : Eˣ := Units.mk0 π_E hπ_E_ne
  have hϖ : valL F E ϖ = 1 := hπ_E
  have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
      0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
    intro a ha
    unfold addVal
    rw [dif_neg ha]
    set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    set va := valuation F a
    have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
    constructor
    · intro h_nonneg
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
      have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
      have h_iso : iso va ≤ iso 1 := by
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
        exact WithZero.coe_le_coe.mpr h_unzero
      exact (map_le_map_iff iso).mp h_iso
    · intro h_le
      have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
      rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
        Multiplicative.toAdd_le.mpr h_iso
      omega
  have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom : Eˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Eˣ, Multiplicative.toAdd (relValHom u) = relVal F E u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : Eˣ,
      relVal F E ((u * v : Eˣ) : E) = relVal F E u + relVal F E v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : Eˣ) (m : ℤ),
      relVal F E ((u ^ m : Eˣ) : E) = m * relVal F E u := by
    intro u m
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have relVal_mul : ∀ {x y : E} (hx : x ≠ 0) (hy : y ≠ 0),
      relVal F E (x * y) = relVal F E x + relVal F E y := by
    intro x y hx hy
    exact relVal_units_mul (Units.mk0 x hx) (Units.mk0 y hy)
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F E ∧ ∃ π : Eˣ, relVal F E π = resDeg F E := by
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {m : ℕ | 0 < m ∧ ∃ z : E, z ≠ 0 ∧ relVal F E z = m}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F E, Module.finrank_pos, algebraMap F E u,
        (map_ne_zero (algebraMap F E)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F E (u : F)) = (u : F) ^ Module.finrank F E :=
        Algebra.norm_algebraMap (u : F)
      have hpow : addVal F ((u : F) ^ Module.finrank F E) =
          (Module.finrank F E : ℤ) * addVal F u := by
        change Multiplicative.toAdd (addValHom (u ^ Module.finrank F E)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hf_pos, π_ex, hπ_ex⟩ := resDeg_mem
  have relVal_eq_resDeg_mul_valL_aux :
      ∀ u : Eˣ, relVal F E u = (resDeg F E : ℤ) * valL F E u := by
    intro u
    let q_div := relVal F E u / (resDeg F E : ℤ)
    let r_rem := relVal F E u % (resDeg F E : ℤ)
    have hdiv : r_rem + (resDeg F E : ℤ) * q_div = relVal F E u := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r_rem := Int.emod_nonneg _ (by positivity)
    have hrlt : r_rem < (resDeg F E : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F E ((u * π_ex ^ (-q_div) : Eˣ) : E) = r_rem := by
      rw [relVal_units_mul, relVal_units_zpow, hπ_ex]
      linarith
    have hr_eq : r_rem = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r_rem.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r_rem.toNat ∈ {m : ℕ | 0 < m ∧ ∃ z : E, z ≠ 0 ∧ relVal F E z = m} := by
        refine ⟨hr_pos, ((u * π_ex ^ (-q_div) : Eˣ) : E), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F E ≤ r_rem.toNat := Nat.sInf_le hmem
      omega
    change relVal F E u = (resDeg F E : ℤ) * q_div
    linarith
  have relVal_eq : ∀ {x : E} (hx : x ≠ 0), relVal F E x = (resDeg F E : ℤ) * valL F E x :=
    fun hx => relVal_eq_resDeg_mul_valL_aux (Units.mk0 _ hx)
  have valL_mul : ∀ {x y : E} (hx : x ≠ 0) (hy : y ≠ 0),
      valL F E (x * y) = valL F E x + valL F E y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    have h := relVal_mul hx hy
    rw [relVal_eq hxy, relVal_eq hx, relVal_eq hy, ← mul_add] at h
    exact mul_left_cancel₀ (by positivity) h
  have valL_one : valL F E 1 = 0 := by
    have h1 : (1 : E) ≠ 0 := one_ne_zero
    have h := valL_mul h1 h1
    rw [mul_one] at h
    omega
  have valL_pow : ∀ {x : E} (hx : x ≠ 0) (m : ℕ), valL F E (x ^ m) = (m : ℤ) * valL F E x := by
    intro x hx m
    induction m with
    | zero => simp [valL_one]
    | succ m ih =>
      rw [pow_succ, valL_mul (pow_ne_zero m hx) hx, ih]
      push_cast
      ring
  have valL_units_zpow : ∀ (u : Eˣ) (m : ℤ),
      valL F E ((u ^ m : Eˣ) : E) = m * valL F E u := by
    intro u m
    have h := relVal_units_zpow u m
    rw [relVal_eq (Units.ne_zero _), relVal_eq (Units.ne_zero _), ← mul_left_comm] at h
    exact mul_left_cancel₀ (by positivity) h
  have h_int_aux : ∀ (K : Type u) [Field K] [Algebra F K] [FiniteDimensional F K] (x : K),
      IsIntegral 𝒪[F] x ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x) := by
    intro K _ _ _ x
    constructor
    · intro hx
      by_cases hx0 : x = 0
      · exact Or.inl hx0
      · right
        have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
        have hnorm_int : IsIntegral 𝒪[F] (Algebra.norm F x) := Algebra.isIntegral_norm F hx
        have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
          (Valuation.Integers.isIntegral_iff_v_le_one
            (Valuation.integer.integers (valuation F))).mp hnorm_int
        exact (addVal_nonneg_iff_val_le_one hnorm0).mpr hval_le
    · rintro (rfl | h_rel)
      · exact isIntegral_zero
      · by_cases hx0 : x = 0
        · rw [hx0]
          exact isIntegral_zero
        · have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
          have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
            (addVal_nonneg_iff_val_le_one hnorm0).mp h_rel
          have hx_int_F : IsIntegral F x := Algebra.IsIntegral.isIntegral x
          let pb : PowerBasis F (IntermediateField.adjoin F ({x} : Set K)) :=
            IntermediateField.adjoin.powerBasis hx_int_F
          have h_gen_coe : (pb.gen : K) = x := IntermediateField.AdjoinSimple.coe_gen F x
          set dK : ℕ := Module.finrank (IntermediateField.adjoin F ({x} : Set K)) K
          have h_finrank_pos : 0 < dK := Module.finrank_pos
          have h_norm_tower : Algebra.norm F x = (Algebra.norm F pb.gen) ^ dK := by
            have h1 : Algebra.norm F (pb.gen : K) = (Algebra.norm F pb.gen) ^ dK := by
              rw [← Algebra.norm_norm (R := F) (S := IntermediateField.adjoin F ({x} : Set K))
                (A := K) (a := (pb.gen : K)), ← map_pow]
              congr 1
              exact Algebra.norm_algebraMap (L := K) pb.gen
            rwa [h_gen_coe] at h1
          have h_norm_pb : Algebra.norm F pb.gen =
              (-1) ^ pb.dim * (minpoly F pb.gen).coeff 0 :=
            Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb
          have h_minpoly_eq : minpoly F pb.gen = minpoly F x := by
            have h1 : minpoly F pb.gen = minpoly F (pb.gen : K) :=
              (minpoly.algHom_eq
                (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K)))
                (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K))).injective
                pb.gen).symm
            rwa [h_gen_coe] at h1
          letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
          haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
          haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
          letI : Valued F (ValueGroupWithZero F) :=
            IsValuativeTopology.instValuedValueGroupWithZeroOfIsUniformAddGroup
          let rlo : RankLeOneStruct F :=
            { emb := (WithZeroMulInt.toNNReal (by norm_num : (2 : NNReal) ≠ 0)).comp
                (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).toMonoidWithZeroHom
              strictMono := (WithZeroMulInt.toNNReal_strictMono (by norm_num : (1 : NNReal) < 2)).comp
                (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).strictMono }
          haveI : (Valued.v (R := F)).RankOne := Valuation.RankOne.ofRankLeOneStruct rlo
          letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
          haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F (ValueGroupWithZero F)
          have hnorm_norm_le : ‖Algebra.norm F x‖ ≤ 1 :=
            Valued.toNormedField.norm_le_one_iff.mpr hval_le
          have h_norm_coeff_pow : ‖Algebra.norm F x‖ =
              ‖(minpoly F x).coeff 0‖ ^ dK := by
            rw [h_norm_tower, h_norm_pb, h_minpoly_eq, norm_pow, norm_mul, norm_pow,
              norm_neg, norm_one, one_pow, one_mul]
          have h_coeff0_le : ‖(minpoly F x).coeff 0‖ ≤ 1 := by
            rw [h_norm_coeff_pow] at hnorm_norm_le
            exact (pow_le_one_iff_of_nonneg (norm_nonneg _) h_finrank_pos.ne').mp hnorm_norm_le
          have h_spec_le : spectralValue (minpoly F x) ≤ 1 := by
            change spectralNorm F K x ≤ 1
            rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow F K x]
            exact Real.rpow_le_one (norm_nonneg _) h_coeff0_le (by positivity)
          have h_all_coeffs : ∀ m : ℕ, ‖(minpoly F x).coeff m‖ ≤ 1 :=
            (spectralValue_le_one_iff (minpoly.monic hx_int_F)).mp h_spec_le
          have h_lifts : minpoly F x ∈ Polynomial.lifts (algebraMap 𝒪[F] F) := by
            rw [Polynomial.lifts_iff_coeff_lifts]
            intro m
            have hv : valuation F ((minpoly F x).coeff m) ≤ 1 :=
              Valued.toNormedField.norm_le_one_iff.mp (h_all_coeffs m)
            exact ⟨⟨(minpoly F x).coeff m, hv⟩, rfl⟩
          obtain ⟨P₀, hP₀_map, -, hP₀_monic⟩ :=
            Polynomial.lifts_and_degree_eq_and_monic h_lifts (minpoly.monic hx_int_F)
          refine ⟨P₀, hP₀_monic, ?_⟩
          have h_eval : Polynomial.aeval x (P₀.map (algebraMap 𝒪[F] F)) = 0 := by
            rw [hP₀_map]
            exact minpoly.aeval F x
          rwa [Polynomial.aeval_map_algebraMap] at h_eval
  have h_int : ∀ z : E, IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ relVal F E z := h_int_aux E
  have h_int_valL : ∀ {z : E} (hz : z ≠ 0), IsIntegral 𝒪[F] z ↔ 0 ≤ valL F E z := by
    intro z hz
    rw [h_int, or_iff_right hz, relVal_eq hz]
    exact ⟨fun h => nonneg_of_mul_nonneg_right h (by positivity),
      fun h => mul_nonneg (by positivity) h⟩
  have h_neg1_ne : (-1 : E) ≠ 0 := neg_ne_zero.mpr one_ne_zero
  have h_neg1_val : valL F E (-1 : E) = 0 := by
    have h := valL_mul h_neg1_ne h_neg1_ne
    rw [neg_mul_neg, mul_one, valL_one] at h
    omega
  let V_val : ℤ → E → Prop := fun m z => z = 0 ∨ m ≤ valL F E z
  have hV_iff : ∀ (m : ℤ) (z : E), V_val m z ↔ IsIntegral 𝒪[F] (z * ((ϖ ^ (-m) : Eˣ) : E)) := by
    intro m z
    by_cases hz0 : z = 0
    · simp [V_val, hz0, isIntegral_zero]
    · have hu_ne : ((ϖ ^ (-m) : Eˣ) : E) ≠ 0 := Units.ne_zero _
      have hmul_ne : z * ((ϖ ^ (-m) : Eˣ) : E) ≠ 0 := mul_ne_zero hz0 hu_ne
      change (z = 0 ∨ m ≤ valL F E z) ↔ IsIntegral 𝒪[F] (z * ((ϖ ^ (-m) : Eˣ) : E))
      rw [or_iff_right hz0, h_int_valL hmul_ne, valL_mul hz0 hu_ne, valL_units_zpow ϖ (-m), hϖ]
      omega
  have hV_add : ∀ {m : ℤ} {x y : E}, V_val m x → V_val m y → V_val m (x + y) := by
    intro m x y hx hy
    rw [hV_iff] at hx hy ⊢
    rw [add_mul]
    exact (integralClosure 𝒪[F] E).add_mem hx hy
  have hV_sub : ∀ {m : ℤ} {x y : E}, V_val m x → V_val m y → V_val m (x - y) := by
    intro m x y hx hy
    rw [hV_iff] at hx hy ⊢
    rw [sub_mul]
    exact (integralClosure 𝒪[F] E).sub_mem hx hy
  have valL_neg : ∀ x : E, valL F E (-x) = valL F E x := by
    intro x
    by_cases hx0 : x = 0
    · rw [hx0, neg_zero]
    · have h_eq : -x = (-1 : E) * x := neg_eq_neg_one_mul x
      rw [h_eq, valL_mul h_neg1_ne hx0, h_neg1_val, zero_add]
  have valL_add_of_lt : ∀ {x y : E}, x ≠ 0 → (y = 0 ∨ valL F E x < valL F E y) →
      x + y ≠ 0 ∧ valL F E (x + y) = valL F E x := by
    intro x y hx hy
    rcases hy with rfl | hy_lt
    · rw [add_zero]
      exact ⟨hx, rfl⟩
    · have hxy_ne : x + y ≠ 0 := by
        intro h0
        have hy_eq : y = -x := eq_neg_of_add_eq_zero_right h0
        rw [hy_eq, valL_neg] at hy_lt
        omega
      set m : ℤ := valL F E x
      have hx_m : V_val m x := Or.inr (le_refl m)
      have hy_m : V_val m y := Or.inr (by omega)
      have hxy_m : V_val m (x + y) := hV_add hx_m hy_m
      have h_ge : m ≤ valL F E (x + y) := by
        rcases hxy_m with h0 | hge
        · exact False.elim (hxy_ne h0)
        · exact hge
      have h_le : valL F E (x + y) ≤ m := by
        by_contra hgt
        have hxy_m1 : V_val (m + 1) (x + y) := Or.inr (by omega)
        have hy_m1 : V_val (m + 1) y := Or.inr (by omega)
        have hx_m1 : V_val (m + 1) ((x + y) - y) := hV_sub hxy_m1 hy_m1
        rw [add_sub_cancel_right] at hx_m1
        rcases hx_m1 with h0 | hge1
        · exact hx h0
        · omega
      exact ⟨hxy_ne, by omega⟩
  set ϖ_L : Lˣ := chosenUniformizer F L
  have hϖ_L : valL F L ϖ_L = 1 := (valL_chosenUniformizer_and_mul_zpow F L 1).1
  set P₁ : Polynomial L := lubinTateEndoPoly F L (ϖ_L : L) a₁ n
  set P₂ : Polynomial L := lubinTateEndoPoly F L (ϖ_L : L) a₂ n
  set D : Polynomial L := P₁ - P₂
  set M : ℕ := (qL F L) ^ k
  obtain ⟨hD_int, hD_zero, hD_lt, hD_M_ne, hD_M_val⟩ :=
    lubinTateEndoPoly_sub_coeff_valL_staircase F L ϖ_L hϖ_L n a₁ a₂ ha₁ ha₂ hne k hk hval
  have hresL_ne : resDeg F L ≠ 0 := by
    intro h0
    have h1 : valL F L ϖ_L = 0 := by
      unfold valL
      rw [h0, Nat.cast_zero, Int.ediv_zero]
    omega
  have hq_gt : 1 < q F := by
    unfold q
    exact Finite.one_lt_card
  have hqL_gt : 1 < qL F L := by
    unfold qL
    exact one_lt_pow₀ hq_gt hresL_ne
  set d_n : ℕ := (qL F L - 1) * (qL F L) ^ (n - 1)
  have hM_le_dn : M ≤ d_n := by
    calc M = (qL F L) ^ k := rfl
      _ ≤ (qL F L) ^ (n - 1) := Nat.pow_le_pow_right (by omega) (by omega)
      _ = 1 * (qL F L) ^ (n - 1) := (one_mul _).symm
      _ ≤ (qL F L - 1) * (qL F L) ^ (n - 1) := Nat.mul_le_mul_right _ (by omega)
  have hM_le_dn_z : (M : ℤ) ≤ (d_n : ℤ) := by exact_mod_cast hM_le_dn
  have hdn_nonneg : (0 : ℤ) ≤ (d_n : ℤ) := by positivity
  let ι : L →+* E := (IntermediateField.inclusion hLE).toRingHom
  let t : ℕ → E := fun j => ι (D.coeff j) * π_E ^ j
  have ht_val : ∀ (j : ℕ), D.coeff j ≠ 0 →
      t j ≠ 0 ∧ valL F E (t j) = (d_n : ℤ) * valL F L (D.coeff j) + (j : ℤ) := by
    intro j hcj
    have h_inc_ne : ι (D.coeff j) ≠ 0 := (map_ne_zero ι).mpr hcj
    have h_pow_ne : π_E ^ j ≠ 0 := pow_ne_zero j hπ_E_ne
    have h_tj_ne : t j ≠ 0 := mul_ne_zero h_inc_ne h_pow_ne
    refine ⟨h_tj_ne, ?_⟩
    dsimp [t]
    rw [valL_mul h_inc_ne h_pow_ne, valL_pow hπ_E_ne j, hπ_E, mul_one]
    have h_inc_val : valL F E (ι (D.coeff j)) = (d_n : ℤ) * valL F L (D.coeff j) :=
      h_val_inc (D.coeff j) hcj
    rw [h_inc_val]
  have htM : t M ≠ 0 ∧ valL F E (t M) = (M : ℤ) := by
    obtain ⟨htM_ne, htM_val⟩ := ht_val M hD_M_ne
    rw [hD_M_val, mul_zero, zero_add] at htM_val
    exact ⟨htM_ne, htM_val⟩
  have ht_other : ∀ (j : ℕ), j ≠ M → V_val ((M : ℤ) + 1) (t j) := by
    intro j hj_ne
    by_cases hcj : D.coeff j = 0
    · left
      dsimp [t]
      rw [hcj, map_zero, zero_mul]
    · right
      obtain ⟨_, hval_j⟩ := ht_val j hcj
      rw [hval_j]
      rcases lt_trichotomy j M with hj_lt | rfl | hj_gt
      · have hj_ne0 : j ≠ 0 := by
          intro hj0
          rw [hj0] at hcj
          exact hcj hD_zero
        have hj_pos : (1 : ℤ) ≤ (j : ℤ) := by omega
        have h_coeff_ge : 1 ≤ valL F L (D.coeff j) := (hD_lt j hj_lt).resolve_left hcj
        have h_mul_ge : (d_n : ℤ) ≤ (d_n : ℤ) * valL F L (D.coeff j) := by
          calc (d_n : ℤ) = (d_n : ℤ) * 1 := (mul_one _).symm
            _ ≤ (d_n : ℤ) * valL F L (D.coeff j) := mul_le_mul_of_nonneg_left h_coeff_ge hdn_nonneg
        omega
      · exact False.elim (hj_ne rfl)
      · have hj_ge : (M : ℤ) + 1 ≤ (j : ℤ) := by omega
        have h_coeff_nonneg : 0 ≤ valL F L (D.coeff j) := (hD_int j).resolve_left hcj
        have h_mul_nonneg : 0 ≤ (d_n : ℤ) * valL F L (D.coeff j) :=
          mul_nonneg hdn_nonneg h_coeff_nonneg
        omega
  have hy_sub : y₁ - y₂ = ∑ j ∈ Finset.range (D.natDegree + 1), t j := by
    change Polynomial.eval₂ ι π_E P₁ - Polynomial.eval₂ ι π_E P₂ = _
    rw [← Polynomial.eval₂_sub]
    exact Polynomial.eval₂_eq_sum_range ι π_E
  have hM_le_deg : M ≤ D.natDegree := Polynomial.le_natDegree_of_ne_zero hD_M_ne
  have hM_mem : M ∈ Finset.range (D.natDegree + 1) := Finset.mem_range.mpr (by omega)
  set S_rem := (Finset.range (D.natDegree + 1)).erase M
  set s : E := ∑ j ∈ S_rem, t j
  have hy_eq : y₁ - y₂ = t M + s := by
    rw [hy_sub, ← Finset.add_sum_erase _ _ hM_mem]
  have hs_val : V_val ((M : ℤ) + 1) s :=
    Finset.sum_induction t (V_val ((M : ℤ) + 1)) (fun _ _ hx hy => hV_add hx hy) (Or.inl rfl)
      (fun j hj => ht_other j (Finset.ne_of_mem_erase hj))
  have hs_lt : s = 0 ∨ valL F E (t M) < valL F E s := by
    rcases hs_val with hs0 | hs_ge
    · exact Or.inl hs0
    · right
      rw [htM.2]
      omega
  obtain ⟨h_ne, h_val_eq⟩ := valL_add_of_lt htM.1 hs_lt
  rw [← hy_eq] at h_ne h_val_eq
  rw [htM.2] at h_val_eq
  exact ⟨sub_ne_zero.mp h_ne, h_val_eq⟩

theorem lowerRamSubgroup_ltDivSubfield_eq_bot_and_card_le (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (n : ℕ) :
    1 ≤ n →
      let hLE : L ≤ ltDivSubfield F L n := le_sup_left
      ∀ (π_n : ltDivSubfield F L n),
        Polynomial.aeval (π_n : AlgebraicClosure F)
          (lubinTateDivPoly F L (chosenUniformizer F L : L) n) = 0 →
        IntermediateField.extendScalars hLE =
          IntermediateField.adjoin L {(π_n : AlgebraicClosure F)} →
        (∀ (u : ℕ), ∀ σ ∈ lowerRamSubgroup F hLE u,
          galApply F hLE σ π_n = π_n ∨
            (u + 1 : ℤ) ≤ valL F (ltDivSubfield F L n) (galApply F hLE σ π_n - π_n)) →
        (∀ (u : ℕ), ∀ σ₁ ∈ lowerRamSubgroup F hLE u, ∀ σ₂ ∈ lowerRamSubgroup F hLE u,
          galApply F hLE σ₁ π_n = galApply F hLE σ₂ π_n ∨
            (u + 1 : ℤ) ≤ valL F (ltDivSubfield F L n)
              (galApply F hLE σ₁ π_n - galApply F hLE σ₂ π_n)) →
        (∀ a₁ a₂ : L, (a₁ = 0 ∨ 0 ≤ valL F L a₁) → (a₂ = 0 ∨ 0 ≤ valL F L a₂) →
          a₁ ≠ a₂ → ∀ k : ℕ, k < n → valL F L (a₁ - a₂) = (k : ℤ) →
            let y₁ : ltDivSubfield F L n :=
              Polynomial.eval₂ (IntermediateField.inclusion hLE).toRingHom π_n
                (lubinTateEndoPoly F L (chosenUniformizer F L : L) a₁ n)
            let y₂ : ltDivSubfield F L n :=
              Polynomial.eval₂ (IntermediateField.inclusion hLE).toRingHom π_n
                (lubinTateEndoPoly F L (chosenUniformizer F L : L) a₂ n)
            y₁ ≠ y₂ ∧ valL F (ltDivSubfield F L n) (y₁ - y₂) = ((qL F L) ^ k : ℤ)) →
        (∀ u : ℕ, (qL F L) ^ (n - 1) ≤ u → lowerRamSubgroup F hLE u = ⊥) ∧
        (∀ i : ℕ, 1 ≤ i → i < n → ∀ k : ℕ, (qL F L) ^ (i - 1) ≤ k →
          Nat.card (lowerRamSubgroup F hLE k) ≤ (qL F L) ^ (n - i)) :=
by
  intro hn hLE π_n hπ_aeval h_adj h_ram1 h_ram2 h_endo_val
  let E := ltDivSubfield F L n
  let E_L := IntermediateField.extendScalars hLE
  let ϖ : Lˣ := chosenUniformizer F L
  have hϖ : valL F L ϖ = 1 := (valL_chosenUniformizer_and_mul_zpow F L 1).1
  have hres_ne : resDeg F L ≠ 0 := by
    intro h0
    have h1 : valL F L ϖ = 0 := by
      unfold valL
      rw [h0, Nat.cast_zero, Int.ediv_zero]
    omega
  have hres_pos : 0 < resDeg F L := Nat.pos_of_ne_zero hres_ne
  have hq_gt : 1 < q F := by
    unfold q
    exact Finite.one_lt_card
  have hqL_gt : 1 < qL F L := by
    unfold qL
    exact one_lt_pow₀ hq_gt hres_ne
  have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Lˣ, Multiplicative.toAdd (relValHom u) = relVal F L u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : Lˣ,
      relVal F L ((u * v : Lˣ) : L) = relVal F L u + relVal F L v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : Lˣ) (m : ℤ),
      relVal F L ((u ^ m : Lˣ) : L) = m * relVal F L u := by
    intro u m
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have relVal_mul : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      relVal F L (x * y) = relVal F L x + relVal F L y := by
    intro x y hx hy
    exact relVal_units_mul (Units.mk0 x hx) (Units.mk0 y hy)
  have relVal_eq : ∀ {x : L} (hx : x ≠ 0), relVal F L x = (resDeg F L : ℤ) * valL F L x :=
    fun hx => relVal_eq_resDeg_mul_valL F L (Units.mk0 _ hx)
  have valL_mul : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      valL F L (x * y) = valL F L x + valL F L y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    have h := relVal_mul hx hy
    rw [relVal_eq hxy, relVal_eq hx, relVal_eq hy, ← mul_add] at h
    exact mul_left_cancel₀ (by positivity) h
  have valL_one : valL F L 1 = 0 := by
    have h1 : (1 : L) ≠ 0 := one_ne_zero
    have h := valL_mul h1 h1
    rw [mul_one] at h
    omega
  have valL_units_zpow : ∀ (u : Lˣ) (m : ℤ),
      valL F L ((u ^ m : Lˣ) : L) = m * valL F L u := by
    intro u m
    have h := relVal_units_zpow u m
    rw [relVal_eq (Units.ne_zero _), relVal_eq (Units.ne_zero _), ← mul_left_comm] at h
    exact mul_left_cancel₀ (by positivity) h
  have h_int_valL : ∀ {z : L} (hz : z ≠ 0), IsIntegral 𝒪[F] z ↔ 0 ≤ valL F L z := by
    intro z hz
    rw [isIntegral_iff_eq_zero_or_relVal_nonneg F L z, or_iff_right hz, relVal_eq hz]
    exact ⟨fun h => nonneg_of_mul_nonneg_right h (by positivity),
      fun h => mul_nonneg (by positivity) h⟩
  have h_neg1_ne : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
  have h_neg1_val : valL F L (-1 : L) = 0 := by
    have h := valL_mul h_neg1_ne h_neg1_ne
    rw [neg_mul_neg, mul_one, valL_one] at h
    omega
  let V_val : ℤ → L → Prop := fun m z => z = 0 ∨ m ≤ valL F L z
  have hV_iff : ∀ (m : ℤ) (z : L), V_val m z ↔ IsIntegral 𝒪[F] (z * ((ϖ ^ (-m) : Lˣ) : L)) := by
    intro m z
    by_cases hz0 : z = 0
    · simp [V_val, hz0, isIntegral_zero]
    · have hu_ne : ((ϖ ^ (-m) : Lˣ) : L) ≠ 0 := Units.ne_zero _
      have hmul_ne : z * ((ϖ ^ (-m) : Lˣ) : L) ≠ 0 := mul_ne_zero hz0 hu_ne
      change (z = 0 ∨ m ≤ valL F L z) ↔ IsIntegral 𝒪[F] (z * ((ϖ ^ (-m) : Lˣ) : L))
      rw [or_iff_right hz0, h_int_valL hmul_ne, valL_mul hz0 hu_ne, valL_units_zpow ϖ (-m), hϖ]
      omega
  have hV_add : ∀ {m : ℤ} {x y : L}, V_val m x → V_val m y → V_val m (x + y) := by
    intro m x y hx hy
    rw [hV_iff] at hx hy ⊢
    rw [add_mul]
    exact (integralClosure 𝒪[F] L).add_mem hx hy
  have hV_sub : ∀ {m : ℤ} {x y : L}, V_val m x → V_val m y → V_val m (x - y) := by
    intro m x y hx hy
    rw [hV_iff] at hx hy ⊢
    rw [sub_mul]
    exact (integralClosure 𝒪[F] L).sub_mem hx hy
  have valL_neg : ∀ x : L, valL F L (-x) = valL F L x := by
    intro x
    by_cases hx0 : x = 0
    · rw [hx0, neg_zero]
    · have h_eq : -x = (-1 : L) * x := neg_eq_neg_one_mul x
      rw [h_eq, valL_mul h_neg1_ne hx0, h_neg1_val, zero_add]
  have valL_add_of_lt : ∀ {x y : L}, x ≠ 0 → (y = 0 ∨ valL F L x < valL F L y) →
      x + y ≠ 0 ∧ valL F L (x + y) = valL F L x := by
    intro x y hx hy
    rcases hy with rfl | hy_lt
    · rw [add_zero]
      exact ⟨hx, rfl⟩
    · have hxy_ne : x + y ≠ 0 := by
        intro h0
        have hy_eq : y = -x := eq_neg_of_add_eq_zero_right h0
        rw [hy_eq, valL_neg] at hy_lt
        omega
      set m : ℤ := valL F L x
      have hx_m : V_val m x := Or.inr (le_refl m)
      have hy_m : V_val m y := Or.inr (by omega)
      have hxy_m : V_val m (x + y) := hV_add hx_m hy_m
      have h_ge : m ≤ valL F L (x + y) := by
        rcases hxy_m with h0 | hge
        · exact False.elim (hxy_ne h0)
        · exact hge
      have h_le : valL F L (x + y) ≤ m := by
        by_contra hgt
        have hxy_m1 : V_val (m + 1) (x + y) := Or.inr (by omega)
        have hy_m1 : V_val (m + 1) y := Or.inr (by omega)
        have hx_m1 : V_val (m + 1) ((x + y) - y) := hV_sub hxy_m1 hy_m1
        rw [add_sub_cancel_right] at hx_m1
        rcases hx_m1 with h0 | hge1
        · exact hx h0
        · omega
      exact ⟨hxy_ne, by omega⟩
  have hg_deg_all : ∀ k : ℕ,
      (lubinTateIterPoly F L (ϖ : L) k).Monic ∧
      (lubinTateIterPoly F L (ϖ : L) k).natDegree = (qL F L) ^ k := by
    intro k
    have hdeg_lt : (Polynomial.C (ϖ : L) * Polynomial.X).degree <
        (Polynomial.X ^ qL F L : Polynomial L).degree := by
      rw [Polynomial.degree_X_pow]
      exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_le (ϖ : L)) (WithBot.coe_lt_coe.mpr hqL_gt)
    have hf0_monic : (lubinTatePoly F L (ϖ : L)).Monic := by
      change (Polynomial.C (ϖ : L) * Polynomial.X + Polynomial.X ^ qL F L).Monic
      rw [add_comm]
      exact Polynomial.Monic.add_of_left (Polynomial.monic_X_pow (qL F L)) hdeg_lt
    have hf0_deg : (lubinTatePoly F L (ϖ : L)).natDegree = qL F L := by
      change (Polynomial.C (ϖ : L) * Polynomial.X + Polynomial.X ^ qL F L).natDegree = qL F L
      rw [add_comm, Polynomial.natDegree_add_eq_left_of_degree_lt hdeg_lt,
        Polynomial.natDegree_X_pow]
    induction k with
    | zero =>
      dsimp [lubinTateIterPoly]
      exact ⟨Polynomial.monic_X, Polynomial.natDegree_X⟩
    | succ k ih =>
      obtain ⟨ih_monic, ih_deg⟩ := ih
      have h_deg_ne : (lubinTateIterPoly F L (ϖ : L) k).natDegree ≠ 0 := by
        rw [ih_deg]
        exact pow_ne_zero k (by omega)
      dsimp [lubinTateIterPoly]
      refine ⟨hf0_monic.comp ih_monic h_deg_ne, ?_⟩
      rw [Polynomial.natDegree_comp, hf0_deg, ih_deg, pow_succ']
  let g_n : Polynomial L := lubinTateIterPoly F L (ϖ : L) n
  let f_n : Polynomial L := lubinTateDivPoly F L (ϖ : L) n
  have hg_monic : g_n.Monic := (hg_deg_all n).1
  have hg_deg : g_n.natDegree = (qL F L) ^ n := (hg_deg_all n).2
  have hn_eq : n = (n - 1) + 1 := (Nat.sub_add_cancel hn).symm
  have hqL_sub : (qL F L - 1) + 1 = qL F L := Nat.sub_add_cancel (by omega)
  have h_gn_eq : g_n = lubinTateIterPoly F L (ϖ : L) (n - 1) * f_n := by
    change lubinTateIterPoly F L (ϖ : L) n =
      lubinTateIterPoly F L (ϖ : L) (n - 1) *
        ((lubinTateIterPoly F L (ϖ : L) (n - 1)) ^ (qL F L - 1) + Polynomial.C (ϖ : L))
    conv_lhs => rw [hn_eq]
    change (Polynomial.C (ϖ : L) * Polynomial.X + Polynomial.X ^ qL F L).comp
      (lubinTateIterPoly F L (ϖ : L) (n - 1)) = _
    rw [Polynomial.add_comp, Polynomial.mul_comp, Polynomial.C_comp, Polynomial.X_comp,
      Polynomial.pow_comp, Polynomial.X_comp]
    conv_lhs => rw [← hqL_sub, pow_succ']
    ring
  have hπ_gn : Polynomial.aeval (π_n : AlgebraicClosure F) g_n = 0 := by
    rw [h_gn_eq, map_mul, hπ_aeval, mul_zero]
  let ι : L →+* E := (IntermediateField.inclusion hLE).toRingHom
  let y : L → E := fun a =>
    Polynomial.eval₂ ι π_n (lubinTateEndoPoly F L (ϖ : L) a n)
  let Φ : L → AlgebraicClosure F := fun a => (y a : AlgebraicClosure F)
  have h_endo_y : ∀ a₁ a₂ : L, V_val 0 a₁ → V_val 0 a₂ → a₁ ≠ a₂ →
      ∀ k : ℕ, k < n → valL F L (a₁ - a₂) = (k : ℤ) →
        y a₁ ≠ y a₂ ∧ valL F E (y a₁ - y a₂) = (((qL F L) ^ k : ℕ) : ℤ) := by
    intro a₁ a₂ ha₁ ha₂ hne k hk hval
    obtain ⟨hne_y, hval_y⟩ := h_endo_val a₁ a₂ ha₁ ha₂ hne k hk hval
    exact ⟨hne_y, hval_y.trans (Nat.cast_pow (qL F L) k).symm⟩
  have h_comp_ι : E.val.toRingHom.comp ι = algebraMap L (AlgebraicClosure F) := by
    ext c
    rfl
  have hΦ_eq_aeval : ∀ a : L,
      Φ a = Polynomial.aeval (π_n : AlgebraicClosure F) (lubinTateEndoPoly F L (ϖ : L) a n) := by
    intro a
    change E.val.toRingHom (Polynomial.eval₂ ι π_n (lubinTateEndoPoly F L (ϖ : L) a n)) = _
    rw [Polynomial.hom_eval₂, h_comp_ι, ← Polynomial.aeval_def]
    rfl
  let G_n : Polynomial (AlgebraicClosure F) := g_n.map (algebraMap L (AlgebraicClosure F))
  let R : Finset (AlgebraicClosure F) := (g_n.aroots (AlgebraicClosure F)).toFinset
  have hGn_deg : G_n.natDegree = (qL F L) ^ n := by
    rw [hg_monic.natDegree_map, hg_deg]
  have hR_card : R.card ≤ (qL F L) ^ n := by
    calc R.card ≤ (g_n.aroots (AlgebraicClosure F)).card :=
          Multiset.toFinset_card_le (g_n.aroots (AlgebraicClosure F))
      _ ≤ G_n.natDegree := Polynomial.card_roots' G_n
      _ = (qL F L) ^ n := hGn_deg
  have h_mem_R : ∀ β : AlgebraicClosure F, β ∈ R ↔ Polynomial.aeval β g_n = 0 := by
    intro β
    rw [Multiset.mem_toFinset, Polynomial.mem_aroots]
    exact ⟨fun h => h.2, fun h => ⟨hg_monic.ne_zero, h⟩⟩
  have hΦ_mem_R : ∀ a : L, V_val 0 a → Φ a ∈ R := by
    intro a ha
    rw [h_mem_R, hΦ_eq_aeval]
    let P_a := lubinTateEndoPoly F L (ϖ : L) a n
    have h_mod : (g_n.comp P_a) %ₘ g_n = 0 :=
      lubinTateIterPoly_comp_lubinTateEndoPoly_modByMonic_eq_zero F L ϖ hϖ n a ha
    have h_div := (Polynomial.modByMonic_add_div (g_n.comp P_a) hg_monic).symm
    have h_eval := congrArg (Polynomial.aeval (π_n : AlgebraicClosure F)) h_div
    rw [Polynomial.aeval_comp, h_mod, zero_add, map_mul, hπ_gn, zero_mul] at h_eval
    exact h_eval
  obtain ⟨S, hS_card, hS_int, hS_diff⟩ :=
    exists_finset_card_qL_pow_and_valL_sub_lt F L ϖ hϖ n
  have h_sub_S : S.image Φ ⊆ R := by
    intro β hβ
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hβ
    exact hΦ_mem_R a (hS_int a ha)
  have h_inj_S : Set.InjOn Φ (S : Set L) := by
    intro a₁ ha₁ a₂ ha₂ h_eq
    by_contra hne
    have ha₁' : a₁ ∈ S := Finset.mem_coe.mp ha₁
    have ha₂' : a₂ ∈ S := Finset.mem_coe.mp ha₂
    obtain ⟨k, hk_lt, hk_val⟩ := hS_diff a₁ ha₁' a₂ ha₂' hne
    have hy_ne : y a₁ ≠ y a₂ :=
      (h_endo_y a₁ a₂ (hS_int a₁ ha₁') (hS_int a₂ ha₂') hne k hk_lt hk_val).1
    exact hy_ne (Subtype.ext h_eq)
  have h_im_S_card : (S.image Φ).card = (qL F L) ^ n := by
    rw [Finset.card_image_of_injOn h_inj_S, hS_card]
  have h_R_le_im : R.card ≤ (S.image Φ).card := by
    rw [h_im_S_card]
    exact hR_card
  have h_eq_R : S.image Φ = R :=
    (Finset.subset_iff_eq_of_card_le h_R_le_im).mp h_sub_S
  let toEL : E →+* E_L := toExtendScalars F hLE
  have h_gal_coe : ∀ (σ : E_L ≃ₐ[L] E_L) (z : E),
      (galApply F hLE σ z : AlgebraicClosure F) = (σ (toEL z) : AlgebraicClosure F) :=
    fun _ _ => rfl
  have hπ_EL_gn : Polynomial.aeval (toEL π_n) g_n = 0 := by
    apply Subtype.ext
    change (IntermediateField.val E_L) (Polynomial.aeval (toEL π_n) g_n) = 0
    rw [← Polynomial.aeval_algHom_apply (IntermediateField.val E_L) (toEL π_n) g_n]
    exact hπ_gn
  have h_gal_mem_R : ∀ σ : E_L ≃ₐ[L] E_L, (galApply F hLE σ π_n : AlgebraicClosure F) ∈ R := by
    intro σ
    rw [h_mem_R, h_gal_coe]
    change Polynomial.aeval ((IntermediateField.val E_L) (σ (toEL π_n))) g_n = 0
    rw [Polynomial.aeval_algHom_apply (IntermediateField.val E_L) (σ (toEL π_n)) g_n,
      Polynomial.aeval_algHom_apply σ (toEL π_n) g_n, hπ_EL_gn, map_zero, map_zero]
  have h_gal_mem_S : ∀ σ : E_L ≃ₐ[L] E_L, ∃ a ∈ S, y a = galApply F hLE σ π_n := by
    intro σ
    have hmem : (galApply F hLE σ π_n : AlgebraicClosure F) ∈ S.image Φ :=
      h_eq_R.symm ▸ h_gal_mem_R σ
    obtain ⟨a, ha, hΦa⟩ := Finset.mem_image.mp hmem
    exact ⟨a, ha, Subtype.ext hΦa⟩
  have h_gal_inj : ∀ σ₁ σ₂ : E_L ≃ₐ[L] E_L,
      galApply F hLE σ₁ π_n = galApply F hLE σ₂ π_n → σ₁ = σ₂ := by
    intro σ₁ σ₂ h_eq
    have h_eq_EL : σ₁ (toEL π_n) = σ₂ (toEL π_n) :=
      Subtype.ext (congrArg Subtype.val h_eq)
    have h_mem_EL : ∀ {x : AlgebraicClosure F},
        x ∈ IntermediateField.adjoin L {(π_n : AlgebraicClosure F)} → x ∈ E_L := by
      intro x hx
      change x ∈ IntermediateField.extendScalars hLE
      rw [h_adj]
      exact hx
    have h_ind : ∀ {w : AlgebraicClosure F}
        (hw : w ∈ IntermediateField.adjoin L {(π_n : AlgebraicClosure F)}) (hwE : w ∈ E_L),
        σ₁ ⟨w, hwE⟩ = σ₂ ⟨w, hwE⟩ := by
      intro w hw
      induction hw using IntermediateField.adjoin_induction with
      | mem x hx =>
        intro hwE
        rw [Set.mem_singleton_iff] at hx
        subst hx
        exact h_eq_EL
      | algebraMap r =>
        intro hwE
        change σ₁ (algebraMap L E_L r) = σ₂ (algebraMap L E_L r)
        rw [AlgEquiv.commutes, AlgEquiv.commutes]
      | add a b ha hb iha ihb =>
        intro hwE
        have haE : a ∈ E_L := h_mem_EL ha
        have hbE : b ∈ E_L := h_mem_EL hb
        change σ₁ (⟨a, haE⟩ + ⟨b, hbE⟩) = σ₂ (⟨a, haE⟩ + ⟨b, hbE⟩)
        rw [map_add, map_add, iha haE, ihb hbE]
      | mul a b ha hb iha ihb =>
        intro hwE
        have haE : a ∈ E_L := h_mem_EL ha
        have hbE : b ∈ E_L := h_mem_EL hb
        change σ₁ (⟨a, haE⟩ * ⟨b, hbE⟩) = σ₂ (⟨a, haE⟩ * ⟨b, hbE⟩)
        rw [map_mul, map_mul, iha haE, ihb hbE]
      | inv a ha iha =>
        intro hwE
        have haE : a ∈ E_L := h_mem_EL ha
        change σ₁ (⟨a, haE⟩⁻¹) = σ₂ (⟨a, haE⟩⁻¹)
        rw [map_inv₀, map_inv₀, iha haE]
    refine AlgEquiv.ext (fun z => ?_)
    have hz_adj : z.1 ∈ IntermediateField.adjoin L {(π_n : AlgebraicClosure F)} := by
      rw [← h_adj]
      exact z.2
    exact h_ind hz_adj z.2
  have h_gal_one : galApply F hLE 1 π_n = π_n := Subtype.ext rfl
  refine ⟨?_, ?_⟩
  · intro u hu
    rw [Subgroup.eq_bot_iff_forall]
    intro σ hσ
    rcases h_ram1 u σ hσ with h_fix | h_val_ge
    · apply h_gal_inj σ 1
      rw [h_fix, h_gal_one]
    · by_contra h_ne_one
      have h_ne_π : galApply F hLE σ π_n ≠ π_n := by
        intro h_eq
        apply h_ne_one
        apply h_gal_inj σ 1
        rw [h_eq, h_gal_one]
      obtain ⟨a_σ, ha_σ, hy_σ⟩ := h_gal_mem_S σ
      obtain ⟨a_1, ha_1, hy_1⟩ := h_gal_mem_S 1
      rw [h_gal_one] at hy_1
      have ha_ne : a_σ ≠ a_1 := by
        intro h_eq_a
        apply h_ne_π
        rw [← hy_σ, ← hy_1, h_eq_a]
      obtain ⟨m, hm_lt, hm_val⟩ := hS_diff a_σ ha_σ a_1 ha_1 ha_ne
      have hy_val : valL F E (y a_σ - y a_1) = (((qL F L) ^ m : ℕ) : ℤ) :=
        (h_endo_y a_σ a_1 (hS_int a_σ ha_σ) (hS_int a_1 ha_1) ha_ne m hm_lt hm_val).2
      rw [hy_σ, hy_1] at hy_val
      have h_ram_ge : (u + 1 : ℤ) ≤ (((qL F L) ^ m : ℕ) : ℤ) := by
        rw [← hy_val]
        exact h_val_ge
      have h_pow_le : (qL F L) ^ m ≤ u :=
        le_trans (Nat.pow_le_pow_right (by omega) (by omega)) hu
      omega
  · intro i hi1 hin k hk
    let H := lowerRamSubgroup F hLE k
    let α : H → L := fun σ => (h_gal_mem_S σ.1).choose
    have hα_mem : ∀ σ : H, α σ ∈ S := fun σ => (h_gal_mem_S σ.1).choose_spec.1
    have hα_eq : ∀ σ : H, y (α σ) = galApply F hLE σ.1 π_n :=
      fun σ => (h_gal_mem_S σ.1).choose_spec.2
    have hα_inj : Function.Injective α := by
      intro σ₁ σ₂ h_eq
      apply Subtype.ext
      apply h_gal_inj σ₁.1 σ₂.1
      rw [← hα_eq σ₁, ← hα_eq σ₂, h_eq]
    let α_S : H → ↥S := fun σ => ⟨α σ, hα_mem σ⟩
    have hα_S_inj : Function.Injective α_S :=
      fun σ₁ σ₂ h => hα_inj (congrArg Subtype.val h)
    letI : Fintype H := Fintype.ofInjective α_S hα_S_inj
    let B : Finset L := Finset.univ.image α
    have hB_sub : B ⊆ S := by
      intro b hb
      obtain ⟨σ, -, rfl⟩ := Finset.mem_image.mp hb
      exact hα_mem σ
    have hB_card : B.card = Nat.card H := by
      rw [Finset.card_image_of_injective _ hα_inj, Finset.card_univ, Nat.card_eq_fintype_card]
    have hB_diff : ∀ b₁ ∈ B, ∀ b₂ ∈ B, b₁ ≠ b₂ →
        ∃ m : ℕ, i ≤ m ∧ m < n ∧ valL F L (b₁ - b₂) = (m : ℤ) := by
      intro b₁ hb₁ b₂ hb₂ hb_ne
      obtain ⟨σ₁, -, rfl⟩ := Finset.mem_image.mp hb₁
      obtain ⟨σ₂, -, rfl⟩ := Finset.mem_image.mp hb₂
      obtain ⟨m, hm_lt, hm_val⟩ :=
        hS_diff (α σ₁) (hα_mem σ₁) (α σ₂) (hα_mem σ₂) hb_ne
      have h_endo := h_endo_y (α σ₁) (α σ₂)
        (hS_int (α σ₁) (hα_mem σ₁)) (hS_int (α σ₂) (hα_mem σ₂)) hb_ne m hm_lt hm_val
      have hy_ne : galApply F hLE σ₁.1 π_n ≠ galApply F hLE σ₂.1 π_n := by
        rw [← hα_eq σ₁, ← hα_eq σ₂]
        exact h_endo.1
      have hy_val : valL F E (galApply F hLE σ₁.1 π_n - galApply F hLE σ₂.1 π_n) =
          (((qL F L) ^ m : ℕ) : ℤ) := by
        rw [← hα_eq σ₁, ← hα_eq σ₂]
        exact h_endo.2
      have h_ram_ge : (k + 1 : ℤ) ≤ (((qL F L) ^ m : ℕ) : ℤ) := by
        rw [← hy_val]
        exact (h_ram2 k σ₁.1 σ₁.2 σ₂.1 σ₂.2).resolve_left hy_ne
      have h_pow_lt : (qL F L) ^ (i - 1) < (qL F L) ^ m := by omega
      have h_exp_lt : i - 1 < m := (Nat.pow_lt_pow_iff_right hqL_gt).mp h_pow_lt
      exact ⟨m, by omega, hm_lt, hm_val⟩
    obtain ⟨S_i, hSi_card, hSi_int, hSi_diff⟩ :=
      exists_finset_card_qL_pow_and_valL_sub_lt F L ϖ hϖ i
    let ψ : L × L → AlgebraicClosure F := fun p => Φ (p.1 + p.2)
    have h_im_sub : (B ×ˢ S_i).image ψ ⊆ R := by
      intro β hβ
      obtain ⟨⟨b, s⟩, hp, rfl⟩ := Finset.mem_image.mp hβ
      obtain ⟨hb, hs⟩ := Finset.mem_product.mp hp
      exact hΦ_mem_R (b + s) (hV_add (hS_int b (hB_sub hb)) (hSi_int s hs))
    have h_inj_prod : Set.InjOn ψ ((B ×ˢ S_i : Finset (L × L)) : Set (L × L)) := by
      rintro ⟨b₁, s₁⟩ hp₁ ⟨b₂, s₂⟩ hp₂ h_eq
      by_contra hp_ne
      obtain ⟨hb₁, hs₁⟩ := Finset.mem_product.mp (Finset.mem_coe.mp hp₁)
      obtain ⟨hb₂, hs₂⟩ := Finset.mem_product.mp (Finset.mem_coe.mp hp₂)
      have h1_int : V_val 0 (b₁ + s₁) := hV_add (hS_int b₁ (hB_sub hb₁)) (hSi_int s₁ hs₁)
      have h2_int : V_val 0 (b₂ + s₂) := hV_add (hS_int b₂ (hB_sub hb₂)) (hSi_int s₂ hs₂)
      have h_diff_val : (b₁ + s₁) ≠ (b₂ + s₂) ∧
          ∃ r : ℕ, r < n ∧ valL F L ((b₁ + s₁) - (b₂ + s₂)) = (r : ℤ) := by
        by_cases hs_eq : s₁ = s₂
        · have hb_ne : b₁ ≠ b₂ := fun hb_eq => hp_ne (Prod.ext hb_eq hs_eq)
          obtain ⟨m, -, hm_lt, hm_val⟩ := hB_diff b₁ hb₁ b₂ hb₂ hb_ne
          have h_sub_eq : (b₁ + s₁) - (b₂ + s₂) = b₁ - b₂ := by
            rw [hs_eq]
            ring
          refine ⟨?_, m, hm_lt, ?_⟩
          · intro h_add_eq
            exact hb_ne (sub_eq_zero.mp (h_sub_eq ▸ sub_eq_zero.mpr h_add_eq))
          · rw [h_sub_eq, hm_val]
        · obtain ⟨r, hr_lt, hr_val⟩ := hSi_diff s₁ hs₁ s₂ hs₂ hs_eq
          have hs_sub_ne : s₁ - s₂ ≠ 0 := sub_ne_zero.mpr hs_eq
          have h_sub_eq : (b₁ + s₁) - (b₂ + s₂) = (s₁ - s₂) + (b₁ - b₂) := by ring
          have hy_cond : b₁ - b₂ = 0 ∨ valL F L (s₁ - s₂) < valL F L (b₁ - b₂) := by
            by_cases hb_eq : b₁ = b₂
            · exact Or.inl (sub_eq_zero.mpr hb_eq)
            · right
              obtain ⟨m, hm_ge, -, hm_val⟩ := hB_diff b₁ hb₁ b₂ hb₂ hb_eq
              rw [hr_val, hm_val]
              omega
          obtain ⟨h_add_ne, h_add_val⟩ := valL_add_of_lt hs_sub_ne hy_cond
          rw [← h_sub_eq] at h_add_ne h_add_val
          exact ⟨sub_ne_zero.mp h_add_ne, r, by omega, h_add_val.trans hr_val⟩
      obtain ⟨h_sum_ne, r, hr_lt, hr_val⟩ := h_diff_val
      have hy_ne : y (b₁ + s₁) ≠ y (b₂ + s₂) :=
        (h_endo_y (b₁ + s₁) (b₂ + s₂) h1_int h2_int h_sum_ne r hr_lt hr_val).1
      exact hy_ne (Subtype.ext h_eq)
    have h_prod_card : ((B ×ˢ S_i).image ψ).card = Nat.card H * (qL F L) ^ i := by
      rw [Finset.card_image_of_injOn h_inj_prod, Finset.card_product, hB_card, hSi_card]
    have h_mul_le : Nat.card H * (qL F L) ^ i ≤ (qL F L) ^ (n - i) * (qL F L) ^ i := by
      have hn_split : (n - i) + i = n := by omega
      rw [← pow_add, hn_split, ← h_prod_card]
      exact (Finset.card_le_card h_im_sub).trans hR_card
    exact Nat.le_of_mul_le_mul_right h_mul_le (pow_pos (by omega) i)

theorem sum_Icc_lt_of_le_pow_blocks (q n u : ℕ) :
    2 ≤ q → 1 ≤ n → u < q ^ (n - 1) →
      ∀ (f : ℕ → ℕ),
        (∀ i : ℕ, 1 ≤ i → i < n → ∀ k : ℕ, q ^ (i - 1) ≤ k → f k ≤ q ^ (n - i)) →
          ∑ k ∈ Finset.Icc 1 u, f k < n * ((q - 1) * q ^ (n - 1)) :=
by
  intro hq hn hu f hf
  set D := (q - 1) * q ^ (n - 1)
  have h_block : ∀ m : ℕ, m ≤ n - 1 → ∑ k ∈ Finset.Icc 1 (q ^ m - 1), f k ≤ m * D := by
    intro m
    induction m with
    | zero =>
      intro _
      rw [pow_zero]
      have h_emp : Finset.Icc 1 (1 - 1) = ∅ := Finset.Icc_eq_empty (by omega)
      rw [h_emp, Finset.sum_empty, Nat.zero_mul]
    | succ m ih =>
      intro hm1
      have hqm : 1 ≤ q ^ m := Nat.one_le_pow m q (by omega)
      have hqm1 : q ^ m + 1 ≤ q ^ (m + 1) := by
        calc q ^ m + 1 ≤ q ^ m + q ^ m := by omega
          _ = q ^ m * 2 := by ring
          _ ≤ q ^ m * q := Nat.mul_le_mul_left (q ^ m) hq
          _ = q ^ (m + 1) := (pow_succ q m).symm
      set A := Finset.Icc 1 (q ^ m - 1)
      set B := Finset.Icc (q ^ m) (q ^ (m + 1) - 1)
      have h_union : Finset.Icc 1 (q ^ (m + 1) - 1) = A ∪ B := by
        ext k
        simp only [A, B, Finset.mem_union, Finset.mem_Icc]
        omega
      have h_disj : Disjoint A B := by
        rw [Finset.disjoint_left]
        intro k hkA hkB
        simp only [A, B, Finset.mem_Icc] at hkA hkB
        omega
      rw [h_union, Finset.sum_union h_disj]
      have h_A : ∑ k ∈ A, f k ≤ m * D := ih (by omega)
      have h_B_bound : ∀ k ∈ B, f k ≤ q ^ (n - (m + 1)) := by
        intro k hkB
        have hk_ge : q ^ m ≤ k := (Finset.mem_Icc.mp hkB).1
        have h_sub : m + 1 - 1 = m := by omega
        have hf_app := hf (m + 1) (by omega) (by omega) k
        rw [h_sub] at hf_app
        exact hf_app hk_ge
      have h_B_sum : ∑ k ∈ B, f k ≤ B.card * q ^ (n - (m + 1)) := by
        have h_nsmul := Finset.sum_le_card_nsmul B f (q ^ (n - (m + 1))) h_B_bound
        rwa [smul_eq_mul] at h_nsmul
      have h_B_card : B.card = (q - 1) * q ^ m := by
        rw [Nat.card_Icc]
        have h_pow : q ^ (m + 1) = q * q ^ m := pow_succ' q m
        have h_sub_mul : (q - 1) * q ^ m = q * q ^ m - 1 * q ^ m := Nat.sub_mul q 1 (q ^ m)
        omega
      have h_B_D : B.card * q ^ (n - (m + 1)) = D := by
        rw [h_B_card, mul_assoc, ← pow_add]
        have h_exp : m + (n - (m + 1)) = n - 1 := by omega
        rw [h_exp]
      have h_B : ∑ k ∈ B, f k ≤ D := by
        rw [← h_B_D]
        exact h_B_sum
      calc ∑ k ∈ A, f k + ∑ k ∈ B, f k ≤ m * D + D := Nat.add_le_add h_A h_B
        _ = (m + 1) * D := by ring
  have hqn1 : 1 ≤ q ^ (n - 1) := Nat.one_le_pow (n - 1) q (by omega)
  have h_sub_u : Finset.Icc 1 u ⊆ Finset.Icc 1 (q ^ (n - 1) - 1) :=
    Finset.Icc_subset_Icc_right (by omega)
  have h_sum_u : ∑ k ∈ Finset.Icc 1 u, f k ≤ ∑ k ∈ Finset.Icc 1 (q ^ (n - 1) - 1), f k :=
    Finset.sum_le_sum_of_subset h_sub_u
  have h_sum_n1 : ∑ k ∈ Finset.Icc 1 (q ^ (n - 1) - 1), f k ≤ (n - 1) * D :=
    h_block (n - 1) le_rfl
  have hD_pos : 1 ≤ D := by
    dsimp [D]
    have hq1 : 1 ≤ q - 1 := by omega
    exact Nat.mul_pos hq1 hqn1
  have hn_D : (n - 1) * D + D = n * D := by
    have hn_eq : n - 1 + 1 = n := by omega
    calc (n - 1) * D + D = (n - 1 + 1) * D := by ring
      _ = n * D := by rw [hn_eq]
  omega

theorem herbrandSum_ltDivSubfield_lt (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] (n : ℕ) :
    1 ≤ n →
      ∀ u : ℕ, lowerRamSubgroup F (le_sup_left : L ≤ ltDivSubfield F L n) u ≠ ⊥ →
        herbrandSum F (le_sup_left : L ≤ ltDivSubfield F L n) u <
          n * Module.finrank L
            (IntermediateField.extendScalars (le_sup_left : L ≤ ltDivSubfield F L n)) :=
by
  intro hn u hu_ne
  set hLE : L ≤ ltDivSubfield F L n := le_sup_left
  obtain ⟨hFinE, h_finrank, π_n, hπ_aeval, h_adj, hπ_val, h_val_inc⟩ :=
    finrank_and_exists_gen_ltDivSubfield F L n hn
  haveI : FiniteDimensional F (ltDivSubfield F L n) := hFinE
  have hπ_nonneg : π_n = 0 ∨ 0 ≤ valL F (ltDivSubfield F L n) π_n :=
    Or.inr (by omega)
  have h_ram1 : ∀ (v : ℕ), ∀ σ ∈ lowerRamSubgroup F hLE v,
      galApply F hLE σ π_n = π_n ∨
        (v + 1 : ℤ) ≤ valL F (ltDivSubfield F L n) (galApply F hLE σ π_n - π_n) :=
    fun v => (galApply_sub_of_mem_lowerRamSubgroup F L (ltDivSubfield F L n) hLE v π_n hπ_nonneg).1
  have h_ram2 : ∀ (v : ℕ), ∀ σ₁ ∈ lowerRamSubgroup F hLE v, ∀ σ₂ ∈ lowerRamSubgroup F hLE v,
      galApply F hLE σ₁ π_n = galApply F hLE σ₂ π_n ∨
        (v + 1 : ℤ) ≤ valL F (ltDivSubfield F L n)
          (galApply F hLE σ₁ π_n - galApply F hLE σ₂ π_n) :=
    fun v => (galApply_sub_of_mem_lowerRamSubgroup F L (ltDivSubfield F L n) hLE v π_n hπ_nonneg).2
  have h_endo_val :=
    valL_eval₂_lubinTateEndoPoly_sub_eq F L (ltDivSubfield F L n) hLE n hn π_n hπ_val h_val_inc
  obtain ⟨h_bot, h_card⟩ :=
    lowerRamSubgroup_ltDivSubfield_eq_bot_and_card_le F L n hn π_n hπ_aeval h_adj
      h_ram1 h_ram2 h_endo_val
  have hu_lt : u < (qL F L) ^ (n - 1) := by
    by_contra h_ge
    exact hu_ne (h_bot u (Nat.le_of_not_lt h_ge))
  haveI : FiniteDimensional F (IntermediateField.extendScalars hLE) := hFinE
  haveI : FiniteDimensional L (IntermediateField.extendScalars hLE) :=
    FiniteDimensional.right F L (IntermediateField.extendScalars hLE)
  have h_pos : 0 < Module.finrank L (IntermediateField.extendScalars hLE) :=
    Module.finrank_pos
  rw [h_finrank] at h_pos
  have hq_ne : qL F L - 1 ≠ 0 := by
    intro h0
    rw [h0, zero_mul] at h_pos
    omega
  have hqL_ge : 2 ≤ qL F L := by omega
  rw [herbrandSum, h_finrank]
  exact sum_Icc_lt_of_le_pow_blocks (qL F L) n u hqL_ge hn hu_lt
    (fun k => Nat.card (lowerRamSubgroup F hLE k)) h_card

theorem exists_mem_valL_sub_ge_one_of_resDeg_eq (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E] (hLE : L ≤ E) :
    resDeg F E = resDeg F L →
    ∀ (x : E), (x = 0 ∨ 0 ≤ valL F E x) →
    ∃ c : L, (c = 0 ∨ 0 ≤ valL F L c) ∧
      (x - IntermediateField.inclusion hLE c = 0 ∨
        1 ≤ valL F E (x - IntermediateField.inclusion hLE c)) :=
by
  intro hres x hx
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion hLE).toLinearMap
      (IntermediateField.inclusion hLE).injective
  have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
      0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
    intro a ha
    unfold addVal
    rw [dif_neg ha]
    set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    set va := valuation F a
    have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
    constructor
    · intro h_nonneg
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
      have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
      have h_iso : iso va ≤ iso 1 := by
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
        exact WithZero.coe_le_coe.mpr h_unzero
      exact (map_le_map_iff iso).mp h_iso
    · intro h_le
      have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
      rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
        Multiplicative.toAdd_le.mpr h_iso
      omega
  have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  have addVal_div : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x / y) = addVal F x - addVal F y := by
    intro x y hx hy
    have hxy : x / y ≠ 0 := div_ne_zero hx hy
    have h := addVal_mul hxy hy
    rw [div_mul_cancel₀ _ hy] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have h_int_aux : ∀ (K : Type u) [Field K] [Algebra F K] [FiniteDimensional F K] (x : K),
      IsIntegral 𝒪[F] x ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x) := by
    intro K _ _ _ x
    constructor
    · intro hx
      by_cases hx0 : x = 0
      · exact Or.inl hx0
      · right
        have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
        have hnorm_int : IsIntegral 𝒪[F] (Algebra.norm F x) := Algebra.isIntegral_norm F hx
        have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
          (Valuation.Integers.isIntegral_iff_v_le_one
            (Valuation.integer.integers (valuation F))).mp hnorm_int
        exact (addVal_nonneg_iff_val_le_one hnorm0).mpr hval_le
    · rintro (rfl | h_rel)
      · exact isIntegral_zero
      · by_cases hx0 : x = 0
        · rw [hx0]
          exact isIntegral_zero
        · have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
          have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
            (addVal_nonneg_iff_val_le_one hnorm0).mp h_rel
          have hx_int_F : IsIntegral F x := Algebra.IsIntegral.isIntegral x
          let pb : PowerBasis F (IntermediateField.adjoin F ({x} : Set K)) :=
            IntermediateField.adjoin.powerBasis hx_int_F
          have h_gen_coe : (pb.gen : K) = x := IntermediateField.AdjoinSimple.coe_gen F x
          set dK : ℕ := Module.finrank (IntermediateField.adjoin F ({x} : Set K)) K
          have h_finrank_pos : 0 < dK := Module.finrank_pos
          have h_norm_tower : Algebra.norm F x = (Algebra.norm F pb.gen) ^ dK := by
            have h1 : Algebra.norm F (pb.gen : K) = (Algebra.norm F pb.gen) ^ dK := by
              rw [← Algebra.norm_norm (R := F) (S := IntermediateField.adjoin F ({x} : Set K))
                (A := K) (a := (pb.gen : K)), ← map_pow]
              congr 1
              exact Algebra.norm_algebraMap (L := K) pb.gen
            rwa [h_gen_coe] at h1
          have h_norm_pb : Algebra.norm F pb.gen =
              (-1) ^ pb.dim * (minpoly F pb.gen).coeff 0 :=
            Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb
          have h_minpoly_eq : minpoly F pb.gen = minpoly F x := by
            have h1 : minpoly F pb.gen = minpoly F (pb.gen : K) :=
              (minpoly.algHom_eq
                (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K)))
                (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K))).injective
                pb.gen).symm
            rwa [h_gen_coe] at h1
          letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
          haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
          haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
          letI : Valued F (ValueGroupWithZero F) :=
            IsValuativeTopology.instValuedValueGroupWithZeroOfIsUniformAddGroup
          let rlo : RankLeOneStruct F :=
            { emb := (WithZeroMulInt.toNNReal (by norm_num : (2 : NNReal) ≠ 0)).comp
                (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).toMonoidWithZeroHom
              strictMono := (WithZeroMulInt.toNNReal_strictMono (by norm_num : (1 : NNReal) < 2)).comp
                (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).strictMono }
          haveI : (Valued.v (R := F)).RankOne := Valuation.RankOne.ofRankLeOneStruct rlo
          letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
          haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F (ValueGroupWithZero F)
          have hnorm_norm_le : ‖Algebra.norm F x‖ ≤ 1 :=
            Valued.toNormedField.norm_le_one_iff.mpr hval_le
          have h_norm_coeff_pow : ‖Algebra.norm F x‖ =
              ‖(minpoly F x).coeff 0‖ ^ dK := by
            rw [h_norm_tower, h_norm_pb, h_minpoly_eq, norm_pow, norm_mul, norm_pow,
              norm_neg, norm_one, one_pow, one_mul]
          have h_coeff0_le : ‖(minpoly F x).coeff 0‖ ≤ 1 := by
            rw [h_norm_coeff_pow] at hnorm_norm_le
            exact (pow_le_one_iff_of_nonneg (norm_nonneg _) h_finrank_pos.ne').mp hnorm_norm_le
          have h_spec_le : spectralValue (minpoly F x) ≤ 1 := by
            change spectralNorm F K x ≤ 1
            rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow F K x]
            exact Real.rpow_le_one (norm_nonneg _) h_coeff0_le (by positivity)
          have h_all_coeffs : ∀ m : ℕ, ‖(minpoly F x).coeff m‖ ≤ 1 :=
            (spectralValue_le_one_iff (minpoly.monic hx_int_F)).mp h_spec_le
          have h_lifts : minpoly F x ∈ Polynomial.lifts (algebraMap 𝒪[F] F) := by
            rw [Polynomial.lifts_iff_coeff_lifts]
            intro m
            have hv : valuation F ((minpoly F x).coeff m) ≤ 1 :=
              Valued.toNormedField.norm_le_one_iff.mp (h_all_coeffs m)
            exact ⟨⟨(minpoly F x).coeff m, hv⟩, rfl⟩
          obtain ⟨P₀, hP₀_map, -, hP₀_monic⟩ :=
            Polynomial.lifts_and_degree_eq_and_monic h_lifts (minpoly.monic hx_int_F)
          refine ⟨P₀, hP₀_monic, ?_⟩
          have h_eval : Polynomial.aeval x (P₀.map (algebraMap 𝒪[F] F)) = 0 := by
            rw [hP₀_map]
            exact minpoly.aeval F x
          rwa [Polynomial.aeval_map_algebraMap] at h_eval
  let P1 : ∀ (K : IntermediateField F (AlgebraicClosure F)) (r : ℕ), (Fin r → K) → Prop :=
    fun _ r ω => ∀ i : Fin r, IsIntegral 𝒪[F] (ω i)
  let P2 : ∀ (K : IntermediateField F (AlgebraicClosure F)), K → ∀ (r : ℕ), (Fin r → K) → Prop :=
    fun K πK r ω => ∀ z : K, IsIntegral 𝒪[F] z →
      ∃ a : Fin r → 𝒪[F], IsIntegral 𝒪[F] ((z - ∑ i, algebraMap 𝒪[F] K (a i) * ω i) / πK)
  let P3 : ∀ (K : IntermediateField F (AlgebraicClosure F)), K → ∀ (r : ℕ), (Fin r → K) → Prop :=
    fun K πK r ω => ∀ a : Fin r → 𝒪[F],
      IsIntegral 𝒪[F] ((∑ i, algebraMap 𝒪[F] K (a i) * ω i) / πK) →
      ∀ i : Fin r, IsLocalRing.residue 𝒪[F] (a i) = 0
  have h_field : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K],
      ∃ (πK : K), πK ≠ 0 ∧ valL F K πK = 1 ∧
        (∀ {x y : K}, x ≠ 0 → y ≠ 0 → valL F K (x / y) = valL F K x - valL F K y) ∧
        (valL F K 1 = 0) ∧
        (∀ {z : K}, z ≠ 0 → (IsIntegral 𝒪[F] z ↔ 0 ≤ valL F K z)) ∧
        (∀ (r : ℕ) (ω : Fin r → K), P1 K r ω → P3 K πK r ω → r ≤ resDeg F K) ∧
        (∀ (r : ℕ) (ω : Fin r → K), P1 K r ω → P3 K πK r ω → ¬ P2 K πK r ω →
          ∃ ω' : Fin (r + 1) → K, P1 K (r + 1) ω' ∧ P3 K πK (r + 1) ω') ∧
        (∃ (f₀ : ℕ) (ω₀ : Fin f₀ → K),
          P1 K f₀ ω₀ ∧ P2 K πK f₀ ω₀ ∧ P3 K πK f₀ ω₀ ∧ f₀ = resDeg F K) := by
    intro K _
    let relValHom : Kˣ →* Multiplicative ℤ :=
      addValHom.comp (Units.map (Algebra.norm F))
    have relValHom_apply : ∀ u : Kˣ, Multiplicative.toAdd (relValHom u) = relVal F K u :=
      fun _ => rfl
    have relVal_units_mul : ∀ u v : Kˣ,
        relVal F K ((u * v : Kˣ) : K) = relVal F K u + relVal F K v := by
      intro u v
      rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
    have relVal_units_zpow : ∀ (u : Kˣ) (k : ℤ),
        relVal F K ((u ^ k : Kˣ) : K) = k * relVal F K u := by
      intro u k
      rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
      rfl
    have relVal_mul : ∀ {x y : K} (hx : x ≠ 0) (hy : y ≠ 0),
        relVal F K (x * y) = relVal F K x + relVal F K y := by
      intro x y hx hy
      exact relVal_units_mul (Units.mk0 x hx) (Units.mk0 y hy)
    have resDeg_mem : 0 < resDeg F K ∧ ∃ π : Kˣ, relVal F K π = resDeg F K := by
      obtain ⟨u, hu⟩ := exists_addVal_eq_one
      let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : K, z ≠ 0 ∧ relVal F K z = k}
      have hS : S.Nonempty := by
        refine ⟨Module.finrank F K, Module.finrank_pos, algebraMap F K u,
          (map_ne_zero (algebraMap F K)).mpr u.ne_zero, ?_⟩
        have hnorm : Algebra.norm F (algebraMap F K (u : F)) = (u : F) ^ Module.finrank F K :=
          Algebra.norm_algebraMap (u : F)
        have hpow : addVal F ((u : F) ^ Module.finrank F K) =
            (Module.finrank F K : ℤ) * addVal F u := by
          change Multiplicative.toAdd (addValHom (u ^ Module.finrank F K)) = _
          rw [map_pow, toAdd_pow, nsmul_eq_mul]
          rfl
        rw [relVal, hnorm, hpow, hu, mul_one]
      obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
      exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
    obtain ⟨hf_pos, π_ex, hπ_ex⟩ := resDeg_mem
    have relVal_eq_resDeg_mul_valL_aux :
        ∀ u : Kˣ, relVal F K u = (resDeg F K : ℤ) * valL F K u := by
      intro u
      let q := relVal F K u / (resDeg F K : ℤ)
      let r := relVal F K u % (resDeg F K : ℤ)
      have hdiv : r + (resDeg F K : ℤ) * q = relVal F K u := Int.emod_add_mul_ediv _ _
      have hr0 : 0 ≤ r := Int.emod_nonneg _ (by positivity)
      have hrlt : r < (resDeg F K : ℤ) := Int.emod_lt_of_pos _ (by positivity)
      have hy : relVal F K ((u * π_ex ^ (-q) : Kˣ) : K) = r := by
        rw [relVal_units_mul, relVal_units_zpow, hπ_ex]
        linarith
      have hr_eq : r = 0 := by
        by_contra hr_ne
        have hr_pos : 0 < r.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
        have hmem : r.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : K, z ≠ 0 ∧ relVal F K z = k} := by
          refine ⟨hr_pos, ((u * π_ex ^ (-q) : Kˣ) : K), Units.ne_zero _, ?_⟩
          rw [hy, Int.toNat_of_nonneg hr0]
        have hle : resDeg F K ≤ r.toNat := Nat.sInf_le hmem
        omega
      change relVal F K u = (resDeg F K : ℤ) * q
      linarith
    have relVal_eq : ∀ {x : K} (hx : x ≠ 0), relVal F K x = (resDeg F K : ℤ) * valL F K x :=
      fun hx => relVal_eq_resDeg_mul_valL_aux (Units.mk0 _ hx)
    set πK : K := (π_ex : K)
    have hπK_ne : πK ≠ 0 := Units.ne_zero π_ex
    have hπ_val : valL F K πK = 1 := by
      unfold valL
      rw [hπ_ex, Int.ediv_self (by positivity)]
    have valL_mul : ∀ {x y : K} (hx : x ≠ 0) (hy : y ≠ 0),
        valL F K (x * y) = valL F K x + valL F K y := by
      intro x y hx hy
      have hxy : x * y ≠ 0 := mul_ne_zero hx hy
      have h := relVal_mul hx hy
      rw [relVal_eq hxy, relVal_eq hx, relVal_eq hy, ← mul_add] at h
      exact mul_left_cancel₀ (by positivity) h
    have valL_one : valL F K 1 = 0 := by
      have h1 : (1 : K) ≠ 0 := one_ne_zero
      have h := valL_mul h1 h1
      rw [mul_one] at h
      omega
    have valL_div : ∀ {x y : K} (hx : x ≠ 0) (hy : y ≠ 0),
        valL F K (x / y) = valL F K x - valL F K y := by
      intro x y hx hy
      have hxy : x / y ≠ 0 := div_ne_zero hx hy
      have h := valL_mul hxy hy
      rw [div_mul_cancel₀ _ hy] at h
      omega
    have valL_pow : ∀ {x : K} (hx : x ≠ 0) (m : ℕ), valL F K (x ^ m) = (m : ℤ) * valL F K x := by
      intro x hx m
      induction m with
      | zero => simp [valL_one]
      | succ m ih =>
        rw [pow_succ, valL_mul (pow_ne_zero m hx) hx, ih]
        push_cast
        ring
    have h_int : ∀ z : K, IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ relVal F K z := h_int_aux K
    have h_int_valL : ∀ {z : K} (hz : z ≠ 0), IsIntegral 𝒪[F] z ↔ 0 ≤ valL F K z := by
      intro z hz
      rw [h_int, or_iff_right hz, relVal_eq hz]
      exact ⟨fun h => nonneg_of_mul_nonneg_right h (by positivity),
        fun h => mul_nonneg (by positivity) h⟩
    have relVal_algebraMap : ∀ {c : F} (hc : c ≠ 0),
        relVal F K (algebraMap F K c) = (Module.finrank F K : ℤ) * addVal F c := by
      intro c hc
      have hnorm : Algebra.norm F (algebraMap F K c) = c ^ Module.finrank F K :=
        Algebra.norm_algebraMap c
