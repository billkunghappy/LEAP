                (Sunram.prod_mem fun i _ => hg_unram i)
                (Sunram.pow_mem hπbar_unram (M * m)))
              (hτ_pow_unram M hd_unram)
          exact (h_unram _ h_rem_unram).1
  
  let Sbar : Subring (AlgebraicClosure F) := (integralClosure 𝒪[F] (AlgebraicClosure F)).toSubring
  haveI : IsScalarTower 𝒪[F] F (AlgebraicClosure F) := IsScalarTower.of_algebraMap_eq' rfl
  have isIntegral_gal : ∀ (γ : AbsGal F) {x : AlgebraicClosure F},
      IsIntegral 𝒪[F] x → IsIntegral 𝒪[F] (γ x) := by
    intro γ x hx
    exact (isIntegral_algEquiv (γ.restrictScalars 𝒪[F])).mpr hx
  have hπbar_int : πbar ∈ Sbar := (h_unram πbar hπbar_unram).1
  have hubar_int : ubar ∈ Sbar := (h_unram ubar hubar_unram).1
  have hv_int : v_bar ∈ Sbar := (h_unram v_bar hv_unram).1
  have polyMem_map_alg : ∀ {P : Polynomial L},
      polyMem SL P → polyMem Sbar (P.map (algebraMap L (AlgebraicClosure F))) := by
