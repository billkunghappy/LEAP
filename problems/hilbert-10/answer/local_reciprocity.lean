          have h_tau_g : ∀ i : ℕ, τ (g i) = g (i + 1) := by
            intro i
            dsimp [g]
            rw [map_pow, ← AlgEquiv.mul_apply, ← pow_succ']
          have hg0 : g 0 = v_bar ^ (m + 2) := by
            dsimp [g]
            rw [pow_zero]
            rfl
          have h_prod_tau : ∀ j : ℕ,
              v_bar ^ (m + 2) * τ (∏ i ∈ Finset.range j, g i) =
              ∏ i ∈ Finset.range (j + 1), g i := by
            intro j
            rw [Finset.prod_range_succ' g j, hg0, mul_comm _ (v_bar ^ (m + 2)), map_prod]
            congr 1
            exact Finset.prod_congr rfl fun i _ => h_tau_g i
          have h_tele_step : ∀ j : ℕ,
              t j - v_bar ^ (m + 2) * πbar ^ (m + 1) * τ (t j) = t j - t (j + 1) := by
            intro j
            congr 1
            have h_tau_tj : τ (t j) =
                τ (∏ i ∈ Finset.range j, g i) * πbar ^ (j * (m + 1)) * ((τ ^ (j + 1)) d) := by
              dsimp [t]
              rw [map_mul, map_mul, map_pow, hτ_πbar, pow_succ' τ j, AlgEquiv.mul_apply]
            have h_pi_pow : πbar ^ (m + 1) * πbar ^ (j * (m + 1)) =
                πbar ^ ((j + 1) * (m + 1)) := by
              rw [← pow_add]
              congr 1
              ring
            rw [h_tau_tj]
            calc v_bar ^ (m + 2) * πbar ^ (m + 1) *
                  (τ (∏ i ∈ Finset.range j, g i) * πbar ^ (j * (m + 1)) * ((τ ^ (j + 1)) d))
                = (v_bar ^ (m + 2) * τ (∏ i ∈ Finset.range j, g i)) *
                  (πbar ^ (m + 1) * πbar ^ (j * (m + 1))) * ((τ ^ (j + 1)) d) := by ring
              _ = (∏ i ∈ Finset.range (j + 1), g i) *
                  πbar ^ ((j + 1) * (m + 1)) * ((τ ^ (j + 1)) d) := by
                rw [h_prod_tau j, h_pi_pow]
              _ = t (j + 1) := rfl
          have h_tele : b - v_bar ^ (m + 2) * πbar ^ (m + 1) * τ b = d - t M := by
            dsimp [b]
            rw [map_sum, Finset.mul_sum, ← Finset.sum_sub_distrib]
            have h_congr : ∑ j ∈ Finset.range M,
                (t j - v_bar ^ (m + 2) * πbar ^ (m + 1) * τ (t j)) =
                ∑ j ∈ Finset.range M, (t j - t (j + 1)) :=
