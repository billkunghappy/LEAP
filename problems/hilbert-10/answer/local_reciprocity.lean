          have hx_sum : x.1 + x.2 = i := Finset.mem_antidiagonal.mp hx_anti
          have hx1_ne : x.1 ≠ 0 := by
            intro h10
            apply hx_ne
            ext
            · exact h10
            · omega
          have hx2_lt : x.2 < i := by omega
          exact IsIntegral.mul (hU_coeff x.1) (ih x.2 hx2_lt)
        revert h_each
        generalize (Finset.antidiagonal i).erase (0, i) = S
        intro h_each
        induction S using Finset.induction_on with
        | empty =>
          rw [Finset.sum_empty]
          exact isIntegral_zero
        | @insert a S ha ihS =>
          rw [Finset.sum_insert ha]
          exact IsIntegral.add (h_each a (Finset.mem_insert_self a S))
            (ihS (fun x hx => h_each x (Finset.mem_insert_of_mem hx)))
      have h_prod_int : IsIntegral 𝒪[F] (U.coeff 0 * (W.coeff i / π ^ (k + 1))) := by
        rw [h_div_UW]
        exact IsIntegral.sub (h_cNA_sub i) h_sum_erase_int
      have h_cancel : W.coeff i / π ^ (k + 1) =
          (U.coeff 0)⁻¹ * (U.coeff 0 * (W.coeff i / π ^ (k + 1))) := by
        rw [inv_mul_cancel_left₀ hU0_ne]
      rw [h_cancel]
      exact IsIntegral.mul hU0_inv_int h_prod_int
  exact (polyValLe_iff_polyDivPow (k + 1) W).mpr hW_div

theorem valL_normLM_sub_one_ge_of_aeval_relLubinTateDivPoly_eq_zero (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (f₀ m : ℕ) : 1 ≤ f₀ → 1 ≤ m →
    let E₀ := unramDegSubfield F L f₀
    let hLE₀ : L ≤ E₀ := le_sup_left
    ∀ [FiniteDimensional F E₀],
    resDeg F E₀ = resDeg F L * f₀ →
    ∀ (τ : AbsGal F), τ ∈ L.fixingSubgroup →
    (∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ → τ ζ = ζ ^ qL F L) →
    (∀ x ∈ E₀, τ x ∈ E₀) →
    (∀ x ∈ E₀, (τ ^ f₀) x = x) →
    (∀ x : E₀,
      ∏ j ∈ Finset.range f₀, (τ ^ j) (x : AlgebraicClosure F) =
        algebraMap L (AlgebraicClosure F) (normLM F hLE₀ x)) →
    ∀ (ϖ : E₀ˣ), valL F E₀ ϖ = 1 →
    ∀ (π_m : AlgebraicClosure F),
    Polynomial.aeval π_m (relLubinTateDivPoly F L E₀ τ (ϖ : E₀) m) = 0 →
    let K := E₀ ⊔ IntermediateField.adjoin F {π_m}
    let hLK : L ≤ K := hLE₀.trans le_sup_left
    ∀ [FiniteDimensional F K],
    resDeg F K = resDeg F E₀ →
    ∀ (w₀ : Kˣ), valL F K w₀ = 0 →
      ((Units.map (normLM F hLK) w₀ : Lˣ) : L) = 1 ∨
      (m : ℤ) ≤ valL F L (((Units.map (normLM F hLK) w₀ : Lˣ) : L) - 1) :=
by
  intro hf₀ hm E₀ hLE₀ _ hres_E₀ τ hτL hτFrob hτE₀ hτf₀_E₀ hτ_prod ϖ hϖ_val π_m hπ_m_Dm
  intro K hLK _ hres_K_E₀ w₀ hw₀_val
  let hE₀K : E₀ ≤ K := le_sup_left
  let π_L := chosenUniformizer F L
  have hπ_L : valL F L π_L = 1 := (valL_chosenUniformizer_and_mul_zpow F L 1).1
  have hresL_ne : resDeg F L ≠ 0 := by
    intro h0
    have h1 := hπ_L
    rw [valL, h0, Nat.cast_zero, Int.ediv_zero] at h1
    omega
  have hresE₀_ne : resDeg F E₀ ≠ 0 := by
    intro h0
    have h1 := hϖ_val
    rw [valL, h0, Nat.cast_zero, Int.ediv_zero] at h1
    omega
  have hresL_pos : 0 < resDeg F L := Nat.pos_of_ne_zero hresL_ne
  have hresE₀_pos : 0 < resDeg F E₀ := Nat.pos_of_ne_zero hresE₀_ne
  have hfL_ne : (resDeg F L : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr hresL_ne
  have hfE₀_ne : (resDeg F E₀ : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr hresE₀_ne
  have hfL_pos : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hresL_pos
  have hfE₀_pos : (0 : ℤ) < (resDeg F E₀ : ℤ) := Nat.cast_pos.mpr hresE₀_pos
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab' : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab', ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h2 := addVal_mul h1 h1
    rw [mul_one] at h2
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun v => Multiplicative.ofAdd (addVal F v)
      map_one' := by simp [addVal_one]
      map_mul' := fun v w => by simp [addVal_mul v.ne_zero w.ne_zero, ofAdd_add] }
  have relVal_units_mul : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (v₁ v₂ : Mˣ), relVal F M ((v₁ * v₂ : Mˣ) : M) = relVal F M v₁ + relVal F M v₂ := by
    intro M _ v₁ v₂
    let relValHom : Mˣ →* Multiplicative ℤ := addValHom.comp (Units.map (Algebra.norm F))
    have h_app : ∀ u : Mˣ, Multiplicative.toAdd (relValHom u) = relVal F M u := fun _ => rfl
    rw [← h_app, map_mul, toAdd_mul, h_app, h_app]
  have relVal_units_zpow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (v₁ : Mˣ) (k : ℤ), relVal F M ((v₁ ^ k : Mˣ) : M) = k * relVal F M v₁ := by
    intro M _ v₁ k
    let relValHom : Mˣ →* Multiplicative ℤ := addValHom.comp (Units.map (Algebra.norm F))
    have h_app : ∀ u : Mˣ, Multiplicative.toAdd (relValHom u) = relVal F M u := fun _ => rfl
    rw [← h_app, map_zpow, toAdd_zpow, h_app, zsmul_eq_mul]
    rfl
  have valL_L_mul : ∀ v₁ v₂ : Lˣ,
      valL F L ((v₁ * v₂ : Lˣ) : L) = valL F L v₁ + valL F L v₂ := by
    intro v₁ v₂
    have hrel := relVal_eq_resDeg_mul_valL F L (v₁ * v₂)
    rw [relVal_units_mul L, relVal_eq_resDeg_mul_valL F L v₁,
      relVal_eq_resDeg_mul_valL F L v₂] at hrel
    apply mul_left_cancel₀ hfL_ne
    linarith
  have valL_L_zpow : ∀ (v₁ : Lˣ) (k : ℤ),
      valL F L ((v₁ ^ k : Lˣ) : L) = k * valL F L v₁ := by
    intro v₁ k
    have hrel := relVal_eq_resDeg_mul_valL F L (v₁ ^ k)
    rw [relVal_units_zpow L, relVal_eq_resDeg_mul_valL F L v₁] at hrel
    apply mul_left_cancel₀ hfL_ne
    linarith
  have valL_E₀_mul : ∀ v₁ v₂ : E₀ˣ,
      valL F E₀ ((v₁ * v₂ : E₀ˣ) : E₀) = valL F E₀ v₁ + valL F E₀ v₂ := by
    intro v₁ v₂
    have hrel := relVal_eq_resDeg_mul_valL F E₀ (v₁ * v₂)
    rw [relVal_units_mul E₀, relVal_eq_resDeg_mul_valL F E₀ v₁,
      relVal_eq_resDeg_mul_valL F E₀ v₂] at hrel
    apply mul_left_cancel₀ hfE₀_ne
    linarith
  have valL_E₀_zpow : ∀ (v₁ : E₀ˣ) (k : ℤ),
      valL F E₀ ((v₁ ^ k : E₀ˣ) : E₀) = k * valL F E₀ v₁ := by
    intro v₁ k
    have hrel := relVal_eq_resDeg_mul_valL F E₀ (v₁ ^ k)
    rw [relVal_units_zpow E₀, relVal_eq_resDeg_mul_valL F E₀ v₁] at hrel
    apply mul_left_cancel₀ hfE₀_ne
    linarith
  have valL_L_div_elem : ∀ {a b : L} (ha : a ≠ 0) (hb : b ≠ 0),
      valL F L (a / b) = valL F L a - valL F L b := by
    intro a b ha hb
    have hab' : a / b ≠ 0 := div_ne_zero ha hb
    have h := valL_L_mul (Units.mk0 _ hab') (Units.mk0 _ hb)
    change valL F L ((a / b) * b) = valL F L (a / b) + valL F L b at h
    rw [div_mul_cancel₀ _ hb] at h
    omega
  have valL_E₀_div_elem : ∀ {a b : E₀} (ha : a ≠ 0) (hb : b ≠ 0),
      valL F E₀ (a / b) = valL F E₀ a - valL F E₀ b := by
    intro a b ha hb
    have hab' : a / b ≠ 0 := div_ne_zero ha hb
    have h := valL_E₀_mul (Units.mk0 _ hab') (Units.mk0 _ hb)
    change valL F E₀ ((a / b) * b) = valL F E₀ (a / b) + valL F E₀ b at h
    rw [div_mul_cancel₀ _ hb] at h
    omega
  have hπL_ne : (π_L : L) ≠ 0 := Units.ne_zero π_L
  have valL_πL_pow : ∀ k : ℕ, valL F L ((π_L : L) ^ k) = (k : ℤ) := by
    intro k
    change valL F L (((π_L ^ (k : ℤ) : Lˣ) : L)) = (k : ℤ)
    rw [valL_L_zpow, hπ_L, mul_one]
  have h_div_iff_L : ∀ (k : ℕ) (d : L),
      (d = 0 ∨ (k : ℤ) ≤ valL F L d) ↔ IsIntegral 𝒪[F] (d / (π_L : L) ^ k) := by
    intro k d
    rw [isIntegral_iff_eq_zero_or_relVal_nonneg F L (d / (π_L : L) ^ k)]
    have hpow_ne : (π_L : L) ^ k ≠ 0 := pow_ne_zero k hπL_ne
    by_cases hd0 : d = 0
