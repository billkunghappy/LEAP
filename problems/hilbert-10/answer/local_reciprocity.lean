import Mathlib
import WeilDeligneDefs
set_option maxHeartbeats 4000000

noncomputable section

set_option linter.unusedSectionVars false

open scoped Classical
open ValuativeRel

universe u

/-! ### Statement (originally `local_reciprocity.lean`) -/

open EllipticRootNumber

/--
**Local Artin reciprocity (local class field theory).** Let `F` be a non-archimedean local
field with algebraic closure `F̄`, Weil group `W_F ⊆ Gal(F̄/F)` and degree map
`deg : W_F → ℤ` (`deg = 1` on arithmetic Frobenius). For every finite extension `L/F` inside
`F̄` there is a map `rec_L : L^× → W_L = W_F ∩ Gal(F̄/L)` (a set-theoretic lift of the
reciprocity homomorphism `L^× → W_L^{ab}`), normalised so that uniformisers map to *geometric*
Frobenius elements, such that
(i) `deg (rec_L x) = -v_F(N_{L/F} x)` for all `x ∈ L^×`;
(ii) for every finite abelian extension `M/L` inside `F̄`, the induced map
`L^× → W_L / W_M = Gal(M/L)` is a homomorphism, is surjective, and has kernel the norm group
`N_{M/L}(M^×)`.
(Milne, *Class Field Theory*, Theorem I.1.1; Serre, *Local class field theory*, §2.3 in
Cassels–Fröhlich; Neukirch, *Algebraic Number Theory*, Theorem V.1.3.)
-/
def chosenUniformizer (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F)) : Lˣ :=
  Classical.epsilon fun π : Lˣ => valL F L π = 1

def isLubinTateRoot (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F)) (ϖ : Lˣ)
    (n : ℕ) (α : AlgebraicClosure F) : Prop :=
  ((fun y : AlgebraicClosure F => ((ϖ : L) : AlgebraicClosure F) * y + y ^ qL F L)^[n] α) = 0

def IsLubinTateFrob (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F)) (ϖ : Lˣ)
    (σ : AbsGal F) : Prop :=
  σ ∈ L.fixingSubgroup ∧
  ActsAsFrobPow F σ (-(resDeg F L : ℤ)) ∧
  ∀ (n : ℕ) (α : AlgebraicClosure F), isLubinTateRoot F L ϖ n α → σ α = α

def lubinTateFrob (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F)) (ϖ : Lˣ) :
    AbsGal F :=
  Classical.epsilon (IsLubinTateFrob F L ϖ)

def rawRecMap (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F)) (x : Lˣ) :
    AbsGal F :=
  lubinTateFrob F L (x * (chosenUniformizer F L) ^ (1 - valL F L x)) *
    (lubinTateFrob F L (chosenUniformizer F L)) ^ (valL F L x - 1)

def canonicalRecMap (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F)) (x : Lˣ) :
    relWeil F L :=
  if h : rawRecMap F L x ∈ relWeil F L then ⟨rawRecMap F L x, h⟩ else 1
def lubinTateExtension (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F)) (ϖ : Lˣ) :
    IntermediateField F (AlgebraicClosure F) :=
  L ⊔ IntermediateField.adjoin F {α : AlgebraicClosure F | ∃ n : ℕ, isLubinTateRoot F L ϖ n α}
def lubinTateUnramField (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (n m : ℕ) : IntermediateField F (AlgebraicClosure F) :=
  L ⊔ IntermediateField.adjoin F
    ({α : AlgebraicClosure F | isLubinTateRoot F L (chosenUniformizer F L) n α} ∪
     {ζ : AlgebraicClosure F | ζ ^ (qL F L ^ m - 1) = 1})
def lubinTatePoly (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F)) (ϖ : L) :
    Polynomial L :=
  Polynomial.C ϖ * Polynomial.X + Polynomial.X ^ qL F L

def lubinTateIterPoly (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F)) (ϖ : L) :
    ℕ → Polynomial L
  | 0 => Polynomial.X
  | n + 1 => (lubinTatePoly F L ϖ).comp (lubinTateIterPoly F L ϖ n)

def lubinTateEndoTrunc (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (ϖ a : L) : ℕ → Polynomial L
  | 0 => 0
  | 1 => Polynomial.C a * Polynomial.X
  | r + 2 =>
    let ϕ := lubinTateEndoTrunc F L ϖ a (r + 1)
    let f := lubinTatePoly F L ϖ
    let c := ((f.comp ϕ - ϕ.comp f).coeff (r + 2)) / (ϖ ^ (r + 2) - ϖ)
    ϕ + Polynomial.monomial (r + 2) c

def IsLubinTateEndoPoly (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (ϖ a : L) (n : ℕ) (P : Polynomial L) : Prop :=
  P %ₘ lubinTateIterPoly F L ϖ n = P ∧
  ∀ m r : ℕ, m * (qL F L) ^ n ≤ r → ∀ k : ℕ,
    let d := (P - lubinTateEndoTrunc F L ϖ a r %ₘ lubinTateIterPoly F L ϖ n).coeff k
    d = 0 ∨ (m : ℤ) ≤ valL F L d

def lubinTateEndoPoly (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (ϖ a : L) (n : ℕ) : Polynomial L :=
  Classical.epsilon (IsLubinTateEndoPoly F L ϖ a n)
def lubinTateDivField (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (n : ℕ) : IntermediateField F (AlgebraicClosure F) :=
  L ⊔ IntermediateField.adjoin F
    {α : AlgebraicClosure F | isLubinTateRoot F L (chosenUniformizer F L) n α}
def unramDegSubfield (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (m : ℕ) : IntermediateField F (AlgebraicClosure F) :=
  L ⊔ IntermediateField.adjoin F
    {ζ : AlgebraicClosure F | ζ ^ (qL F L ^ m - 1) = 1}

def ltDivSubfield (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (n : ℕ) : IntermediateField F (AlgebraicClosure F) :=
  L ⊔ IntermediateField.adjoin F
    {α : AlgebraicClosure F | isLubinTateRoot F L (chosenUniformizer F L) n α}

def ltFixedSubfield (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L M : IntermediateField F (AlgebraicClosure F))
    (m : ℕ) : IntermediateField F (AlgebraicClosure F) :=
  L ⊔ ((M ⊔ unramDegSubfield F L m) ⊓
    IntermediateField.fixedField
      (Subgroup.zpowers (lubinTateFrob F L (chosenUniformizer F L))))
def lubinTateLevelField (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (ϖ : Lˣ) (n : ℕ) : IntermediateField L (AlgebraicClosure F) :=
  IntermediateField.adjoin L {α : AlgebraicClosure F | isLubinTateRoot F L ϖ n α}

def unramifiedLevelField (F : Type u) [Field F]
    (L : IntermediateField F (AlgebraicClosure F)) (m : ℕ) :
    IntermediateField L (AlgebraicClosure F) :=
  IntermediateField.adjoin L {ζ : AlgebraicClosure F | ζ ^ m = 1}

def lubinTateTotalField (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (ϖ : Lˣ) : IntermediateField L (AlgebraicClosure F) :=
  IntermediateField.adjoin L {α : AlgebraicClosure F | ∃ n : ℕ, isLubinTateRoot F L ϖ n α}

def unramifiedTotalField (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F)) :
    IntermediateField L (AlgebraicClosure F) :=
  IntermediateField.adjoin L {ζ : AlgebraicClosure F | IsPrimeToPRootOfUnity F ζ}
def polyValLe (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (m : ℕ) (P : Polynomial L) : Prop :=
  ∀ k : ℕ, P.coeff k = 0 ∨ (m : ℤ) ≤ valL F L (P.coeff k)
def IsIntegralOverValL (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (γ : AlgebraicClosure F) : Prop :=
  ∃ g : Polynomial L, g.Monic ∧ Polynomial.aeval γ g = 0 ∧
    ∀ k : ℕ, g.coeff k = 0 ∨ 0 ≤ valL F L (g.coeff k)
def lubinTateDivPoly (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (ϖ : L) (n : ℕ) : Polynomial L :=
  (lubinTateIterPoly F L ϖ (n - 1)) ^ (qL F L - 1) + Polynomial.C ϖ
def IsIntegralDivPow (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (π : L) (k : ℕ) (z : AlgebraicClosure F) : Prop :=
  IsIntegral 𝒪[F] (z / (algebraMap L (AlgebraicClosure F) π) ^ k)

def unramSubring (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F)) :
    Subring (AlgebraicClosure F) :=
  Subring.closure
    ({x : AlgebraicClosure F | ∃ c : L, IsIntegral 𝒪[F] c ∧ algebraMap L (AlgebraicClosure F) c = x} ∪
     {ζ : AlgebraicClosure F | IsPrimeToPRootOfUnity F ζ})

def colemanTheta (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (π u : L) (τ : AbsGal F) (ε : AlgebraicClosure F) (M : ℕ) :
    ℕ → Polynomial (AlgebraicClosure F)
  | 0 => 0
  | 1 => Polynomial.C ε * Polynomial.X
  | k + 2 =>
    let θ := colemanTheta F L π u τ ε M (k + 1)
    let τθ := θ.map (τ : AlgebraicClosure F →+* AlgebraicClosure F)
    let fπ := (lubinTatePoly F L π).map (algebraMap L (AlgebraicClosure F))
    let fuπ := (lubinTatePoly F L (u * π)).map (algebraMap L (AlgebraicClosure F))
    let πbar : AlgebraicClosure F := algebraMap L (AlgebraicClosure F) π
    let ubar : AlgebraicClosure F := algebraMap L (AlgebraicClosure F) u
    let d := ((τθ.comp fπ - fuπ.comp θ).coeff (k + 2)) / πbar
    let b := ∑ j ∈ Finset.range M,
      ubar⁻¹ ^ (j + 1) * πbar ^ (j * (k + 1)) * ((τ ^ j) d)
    θ + Polynomial.monomial (k + 2) b
def galApply (F : Type u) [Field F] {L E : IntermediateField F (AlgebraicClosure F)} (hLE : L ≤ E)
    (σ : (IntermediateField.extendScalars hLE) ≃ₐ[L] (IntermediateField.extendScalars hLE))
    (x : E) : E :=
  ⟨(σ ⟨x.1, (IntermediateField.mem_extendScalars hLE).mpr x.2⟩).1,
   (IntermediateField.mem_extendScalars hLE).mp
     (σ ⟨x.1, (IntermediateField.mem_extendScalars hLE).mpr x.2⟩).2⟩

def lowerRamSubgroup (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] {L E : IntermediateField F (AlgebraicClosure F)}
    (hLE : L ≤ E) (u : ℕ) :
    Subgroup ((IntermediateField.extendScalars hLE) ≃ₐ[L] (IntermediateField.extendScalars hLE)) :=
  Subgroup.closure {σ | ∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
    galApply F hLE σ x = x ∨ (u + 1 : ℤ) ≤ valL F E (galApply F hLE σ x - x)}

def herbrandSum (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] {L E : IntermediateField F (AlgebraicClosure F)}
    (hLE : L ≤ E) (u : ℕ) : ℕ :=
  ∑ k ∈ Finset.Icc 1 u, Nat.card (lowerRamSubgroup F hLE k)
def relLubinTateCoeff (F : Type u) [Field F]
    (E₀ : IntermediateField F (AlgebraicClosure F)) (τ : AbsGal F) (ϖ : E₀) (j : ℕ) : E₀ :=
  if h : (τ ^ j) (ϖ : AlgebraicClosure F) ∈ E₀ then ⟨(τ ^ j) (ϖ : AlgebraicClosure F), h⟩ else ϖ

def relLubinTatePoly (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L E₀ : IntermediateField F (AlgebraicClosure F))
    (τ : AbsGal F) (ϖ : E₀) (j : ℕ) : Polynomial E₀ :=
  Polynomial.C (relLubinTateCoeff F E₀ τ ϖ j) * Polynomial.X + Polynomial.X ^ qL F L

def relLubinTateIterPoly (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L E₀ : IntermediateField F (AlgebraicClosure F))
    (τ : AbsGal F) (ϖ : E₀) : ℕ → Polynomial E₀
  | 0 => Polynomial.X
  | n + 1 => (relLubinTatePoly F L E₀ τ ϖ n).comp (relLubinTateIterPoly F L E₀ τ ϖ n)

def relLubinTateDivPoly (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L E₀ : IntermediateField F (AlgebraicClosure F))
    (τ : AbsGal F) (ϖ : E₀) (m : ℕ) : Polynomial E₀ :=
  (relLubinTateIterPoly F L E₀ τ ϖ (m - 1)) ^ (qL F L - 1) +
    Polynomial.C (relLubinTateCoeff F E₀ τ ϖ (m - 1))

def relColemanTheta (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (π : L) (v : AlgebraicClosure F) (τ : AbsGal F) (ε : AlgebraicClosure F) (M : ℕ) :
    ℕ → Polynomial (AlgebraicClosure F)
  | 0 => 0
  | 1 => Polynomial.C ε * Polynomial.X
  | k + 2 =>
    let θ := relColemanTheta F L π v τ ε M (k + 1)
    let τθ := θ.map (τ : AlgebraicClosure F →+* AlgebraicClosure F)
    let πbar : AlgebraicClosure F := algebraMap L (AlgebraicClosure F) π
    let f₀ : Polynomial (AlgebraicClosure F) :=
      Polynomial.C (v * πbar) * Polynomial.X + Polynomial.X ^ qL F L
    let fπ : Polynomial (AlgebraicClosure F) :=
      (lubinTatePoly F L π).map (algebraMap L (AlgebraicClosure F))
    let d := ((τθ.comp f₀ - fπ.comp θ).coeff (k + 2)) / πbar
    let b := ∑ j ∈ Finset.range M,
      (∏ i ∈ Finset.range j, ((τ ^ i) v) ^ (k + 2)) * πbar ^ (j * (k + 1)) * ((τ ^ j) d)
    θ + Polynomial.monomial (k + 2) b

def relColemanCompanion (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L E₀ : IntermediateField F (AlgebraicClosure F))
    (π : E₀) : Matrix (Fin (qL F L)) (Fin (qL F L)) (Polynomial E₀) :=
  fun j i =>
    if (i : ℕ) + 1 < qL F L then
      if (j : ℕ) = (i : ℕ) + 1 then 1 else 0
    else
      if (j : ℕ) = 0 then Polynomial.X
      else if (j : ℕ) = 1 then -Polynomial.C π
      else 0

def relColemanNorm (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L E₀ : IntermediateField F (AlgebraicClosure F))
    (π : E₀) (A : Polynomial E₀) : Polynomial E₀ :=
  Matrix.det (Polynomial.aeval (relColemanCompanion F L E₀ π) A)
def relPolyFrob (F : Type u) [Field F]
    (E₀ : IntermediateField F (AlgebraicClosure F)) (τ : AbsGal F) (P : Polynomial E₀) :
    Polynomial E₀ :=
  ∑ i ∈ P.support, Polynomial.monomial i (relLubinTateCoeff F E₀ τ (P.coeff i) 1)

def relColemanNormIter (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L E₀ : IntermediateField F (AlgebraicClosure F))
    (τ : AbsGal F) (ϖ : E₀) (A : Polynomial E₀) : ℕ → Polynomial E₀
  | 0 => A
  | k + 1 =>
    relColemanNorm F L E₀ (relLubinTateCoeff F E₀ τ ϖ k)
      (relColemanNormIter F L E₀ τ ϖ A k)

theorem weilDegreeHom_apply_of_actsAsFrobPow (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (σ : weilGroup F) (n : ℤ) :
    ActsAsFrobPow F (σ : AbsGal F) n → weilDegreeHom F σ = Multiplicative.ofAdd n :=
by
  have h_res_card : ∃ d : ℕ+, Nat.Prime (p F) ∧ q F = p F ^ (d : ℕ) := by
    haveI : Finite 𝓀[F] :=
      IsNonarchimedeanLocalField.instFiniteResidueFieldSubtypeMemSubringIntegerValueGroupWithZeroValuation F
    letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
    haveI : CharP 𝓀[F] (p F) := ringChar.charP 𝓀[F]
    obtain ⟨d, hp, hcard⟩ := FiniteField.card 𝓀[F] (p F)
    refine ⟨d, hp, ?_⟩
    unfold q
    rw [Nat.card_eq_fintype_card, hcard]
  obtain ⟨d, hp, hq_eq⟩ := h_res_card
  have hp_dvd_q : p F ∣ q F := by
    rw [hq_eq]
    exact dvd_pow_self (p F) d.ne_zero
  have hq_ge_two : 2 ≤ q F := by
    rw [hq_eq]
    calc 2 ≤ p F := hp.two_le
      _ = p F ^ 1 := (pow_one (p F)).symm
      _ ≤ p F ^ (d : ℕ) := Nat.pow_le_pow_right hp.pos d.pos
  have actsAsFrobPow_unique : ∀ (τ : AbsGal F) (n₁ n₂ : ℤ),
      ActsAsFrobPow F τ n₁ → ActsAsFrobPow F τ n₂ → n₁ = n₂ := by
    intro τ n₁ n₂ h₁ h₂
    set a : ℕ := n₁.toNat + (-n₂).toNat
    set b : ℕ := n₂.toNat + (-n₁).toNat
    set k : ℕ := a + b + 2
    set m : ℕ := q F ^ k - 1
    have hq_pos : 0 < q F := by omega
    have hqa_pos : 1 ≤ q F ^ a := Nat.one_le_pow a (q F) hq_pos
    have hqb_pos : 1 ≤ q F ^ b := Nat.one_le_pow b (q F) hq_pos
    have hq2 : 4 ≤ q F ^ 2 := by
      calc 4 = 2 ^ 2 := rfl
        _ ≤ q F ^ 2 := Nat.pow_le_pow_left hq_ge_two 2
    have hqa_lt_qk : q F ^ a + 1 < q F ^ k := by
      calc q F ^ a + 1 < 4 * q F ^ a := by omega
        _ = q F ^ a * 4 := by ring
        _ ≤ q F ^ a * q F ^ 2 := Nat.mul_le_mul_left (q F ^ a) hq2
        _ = q F ^ (a + 2) := (pow_add (q F) a 2).symm
        _ ≤ q F ^ k := Nat.pow_le_pow_right hq_pos (by omega)
    have hqb_lt_qk : q F ^ b + 1 < q F ^ k := by
      calc q F ^ b + 1 < 4 * q F ^ b := by omega
        _ = q F ^ b * 4 := by ring
        _ ≤ q F ^ b * q F ^ 2 := Nat.mul_le_mul_left (q F ^ b) hq2
        _ = q F ^ (b + 2) := (pow_add (q F) b 2).symm
        _ ≤ q F ^ k := Nat.pow_le_pow_right hq_pos (by omega)
    have hqa_lt_m : q F ^ a < m := by omega
    have hqb_lt_m : q F ^ b < m := by omega
    have hm_pos : 0 < m := by omega
    have hm_add_one : m + 1 = q F ^ k := Nat.sub_add_cancel (by omega)
    have hpm : ¬ p F ∣ m := by
      intro h_dvd
      have hk_ne : k ≠ 0 := by omega
      have hp_dvd_qk : p F ∣ q F ^ k := dvd_trans hp_dvd_q (dvd_pow_self (q F) hk_ne)
      rw [← hm_add_one] at hp_dvd_qk
      have hp_dvd_one : p F ∣ 1 := (Nat.dvd_add_right h_dvd).mp hp_dvd_qk
      exact hp.not_dvd_one hp_dvd_one
    have hm_ne_zero_F : (m : F) ≠ 0 := by
      intro hm0
      have h_int : (m : 𝒪[F]) = 0 := by
        apply Subtype.ext
        push_cast
        exact hm0
      have h_res : (m : 𝓀[F]) = 0 := by
        rw [← map_natCast (IsLocalRing.residue 𝒪[F]) m, h_int, map_zero]
      have hp_dvd_m : p F ∣ m := (ringChar.spec 𝓀[F] m).mp h_res
      exact hpm hp_dvd_m
    haveI : NeZero (m : F) := ⟨hm_ne_zero_F⟩
    obtain ⟨ζ, hζ⟩ := (AlgebraicClosure.hasEnoughRootsOfUnity F m).prim
    have h_root : IsPrimeToPRootOfUnity F ζ := ⟨m, hm_pos, hpm, hζ.pow_eq_one⟩
    have hτ₁ := h₁ ζ h_root
    have hτ₂ := h₂ ζ h_root
    have h_eq_pow : ζ ^ (q F ^ a) = ζ ^ (q F ^ b) := by
      calc ζ ^ (q F ^ a)
        _ = ζ ^ (q F ^ n₁.toNat * q F ^ (-n₂).toNat) := by rw [← pow_add]
        _ = (ζ ^ (q F ^ n₁.toNat)) ^ (q F ^ (-n₂).toNat) := pow_mul ζ _ _
        _ = (τ ζ ^ (q F ^ (-n₁).toNat)) ^ (q F ^ (-n₂).toNat) := by rw [← hτ₁]
        _ = (τ ζ ^ (q F ^ (-n₂).toNat)) ^ (q F ^ (-n₁).toNat) := pow_right_comm (τ ζ) _ _
        _ = (ζ ^ (q F ^ n₂.toNat)) ^ (q F ^ (-n₁).toNat) := by rw [hτ₂]
        _ = ζ ^ (q F ^ n₂.toNat * q F ^ (-n₁).toNat) := (pow_mul ζ _ _).symm
        _ = ζ ^ (q F ^ b) := by rw [← pow_add]
    have h_qa_eq_qb : q F ^ a = q F ^ b := hζ.pow_inj hqa_lt_m hqb_lt_m h_eq_pow
    have h_a_eq_b : n₁.toNat + (-n₂).toNat = n₂.toNat + (-n₁).toNat :=
      Nat.pow_right_injective hq_ge_two h_qa_eq_qb
    omega
  have isPrimeToP_map : ∀ (τ : AbsGal F) (ζ : AlgebraicClosure F),
      IsPrimeToPRootOfUnity F ζ → IsPrimeToPRootOfUnity F (τ ζ) := by
    intro τ ζ ⟨m, hm_pos, hpm, hζm⟩
    refine ⟨m, hm_pos, hpm, ?_⟩
    rw [← map_pow, hζm, map_one]
  have actsAsFrobPow_mul : ∀ (τ₁ τ₂ : AbsGal F) (n₁ n₂ : ℤ),
      ActsAsFrobPow F τ₁ n₁ → ActsAsFrobPow F τ₂ n₂ → ActsAsFrobPow F (τ₁ * τ₂) (n₁ + n₂) := by
    intro τ₁ τ₂ n₁ n₂ h₁ h₂ ζ hζ
    set a₁ : ℕ := n₁.toNat
    set b₁ : ℕ := (-n₁).toNat
    set a₂ : ℕ := n₂.toNat
    set b₂ : ℕ := (-n₂).toNat
    set A : ℕ := (n₁ + n₂).toNat
    set B : ℕ := (-(n₁ + n₂)).toNat
    set c : ℕ := (b₁ + b₂) - B
    have h_a_eq : a₁ + a₂ = A + c := by omega
    have h_b_eq : b₁ + b₂ = B + c := by omega
    set z₁ : AlgebraicClosure F := ((τ₁ * τ₂) ζ) ^ (q F ^ B)
    set z₂ : AlgebraicClosure F := ζ ^ (q F ^ A)
    set k : ℕ := q F ^ c
    have hz_pow_k : z₁ ^ k = z₂ ^ k := by
      have hτ₂ζ : IsPrimeToPRootOfUnity F (τ₂ ζ) := isPrimeToP_map τ₂ ζ hζ
      calc z₁ ^ k
        _ = ((τ₁ * τ₂) ζ) ^ (q F ^ B * q F ^ c) := (pow_mul _ _ _).symm
        _ = ((τ₁ * τ₂) ζ) ^ (q F ^ (B + c)) := by rw [← pow_add]
        _ = (τ₁ (τ₂ ζ)) ^ (q F ^ (b₁ + b₂)) := by rw [AlgEquiv.mul_apply, h_b_eq]
        _ = (τ₁ (τ₂ ζ)) ^ (q F ^ b₁ * q F ^ b₂) := by rw [pow_add]
        _ = ((τ₁ (τ₂ ζ)) ^ (q F ^ b₁)) ^ (q F ^ b₂) := pow_mul _ _ _
        _ = ((τ₂ ζ) ^ (q F ^ a₁)) ^ (q F ^ b₂) := by rw [h₁ (τ₂ ζ) hτ₂ζ]
        _ = ((τ₂ ζ) ^ (q F ^ b₂)) ^ (q F ^ a₁) := pow_right_comm _ _ _
        _ = (ζ ^ (q F ^ a₂)) ^ (q F ^ a₁) := by rw [h₂ ζ hζ]
        _ = ζ ^ (q F ^ a₂ * q F ^ a₁) := (pow_mul _ _ _).symm
        _ = ζ ^ (q F ^ (a₁ + a₂)) := by rw [← pow_add, add_comm a₂ a₁]
        _ = ζ ^ (q F ^ (A + c)) := by rw [h_a_eq]
        _ = ζ ^ (q F ^ A * q F ^ c) := by rw [pow_add]
        _ = z₂ ^ k := pow_mul _ _ _
    obtain ⟨m, hm_pos, hpm, hζm⟩ := hζ
    have hz₁_m : z₁ ^ m = 1 := by
      calc z₁ ^ m
        _ = (((τ₁ * τ₂) ζ) ^ m) ^ (q F ^ B) := pow_right_comm _ _ _
        _ = ((τ₁ * τ₂) (ζ ^ m)) ^ (q F ^ B) := by rw [map_pow]
        _ = 1 := by rw [hζm, map_one, one_pow]
    have hz₂_m : z₂ ^ m = 1 := by
      calc z₂ ^ m
        _ = (ζ ^ m) ^ (q F ^ A) := pow_right_comm _ _ _
        _ = 1 := by rw [hζm, one_pow]
    have hk_coprime : Nat.Coprime k m := by
      have hp_cop : Nat.Coprime (p F) m := hp.coprime_iff_not_dvd.mpr hpm
      have hq_cop : Nat.Coprime (q F) m := by
        rw [hq_eq]
        exact hp_cop.pow_left (d : ℕ)
      exact hq_cop.pow_left c
    have h_bezout : (k : ℤ) * k.gcdA m + (m : ℤ) * k.gcdB m = 1 := by
      have h_gcd := Nat.gcd_eq_gcd_ab k m
      rw [hk_coprime.gcd_eq_one] at h_gcd
      push_cast at h_gcd
      exact h_gcd.symm
    have pow_cancel : ∀ z : AlgebraicClosure F, z ^ m = 1 → z = (z ^ k) ^ (k.gcdA m) := by
      intro z hzm
      have hz_ne : z ≠ 0 := by
        intro hz0
        rw [hz0, zero_pow hm_pos.ne'] at hzm
        exact zero_ne_one hzm
      calc z
        _ = z ^ (1 : ℤ) := (zpow_one z).symm
        _ = z ^ ((k : ℤ) * k.gcdA m + (m : ℤ) * k.gcdB m) := by rw [h_bezout]
        _ = z ^ ((k : ℤ) * k.gcdA m) * z ^ ((m : ℤ) * k.gcdB m) := zpow_add₀ hz_ne _ _
        _ = (z ^ (k : ℤ)) ^ (k.gcdA m) * (z ^ (m : ℤ)) ^ (k.gcdB m) := by rw [zpow_mul, zpow_mul]
        _ = (z ^ k) ^ (k.gcdA m) * (z ^ m) ^ (k.gcdB m) := by rw [zpow_natCast, zpow_natCast]
        _ = (z ^ k) ^ (k.gcdA m) * 1 ^ (k.gcdB m) := by rw [hzm]
        _ = (z ^ k) ^ (k.gcdA m) := by rw [one_zpow, mul_one]
    rw [pow_cancel z₁ hz₁_m, pow_cancel z₂ hz₂_m, hz_pow_k]
  have actsAsFrobPow_inv : ∀ (τ : AbsGal F) (m : ℤ),
      ActsAsFrobPow F τ m → ActsAsFrobPow F τ⁻¹ (-m) := by
    intro τ m hm ζ hζ
    have hinvζ : IsPrimeToPRootOfUnity F (τ⁻¹ ζ) := isPrimeToP_map τ⁻¹ ζ hζ
    have h_app := hm (τ⁻¹ ζ) hinvζ
    have h_cancel : τ (τ⁻¹ ζ) = ζ := by
      rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
    rw [h_cancel] at h_app
    rw [neg_neg]
    exact h_app.symm
  have actsAsFrobPow_one : ActsAsFrobPow F 1 0 := by
    intro ζ _
    simp
  have weilGroup_exists : ∀ τ : weilGroup F, ∃ m : ℤ, ActsAsFrobPow F (τ : AbsGal F) m := by
    intro ⟨τ, hτ⟩
    exact Subgroup.closure_induction
      (fun g hg => hg)
      ⟨0, actsAsFrobPow_one⟩
      (fun g₁ g₂ _ _ ⟨m₁, hm₁⟩ ⟨m₂, hm₂⟩ => ⟨m₁ + m₂, actsAsFrobPow_mul g₁ g₂ m₁ m₂ hm₁ hm₂⟩)
      (fun g _ ⟨m, hm⟩ => ⟨-m, actsAsFrobPow_inv g m hm⟩)
      hτ
  have weilDegree_eq : ∀ (τ : AbsGal F) (m : ℤ), ActsAsFrobPow F τ m → weilDegree F τ = m := by
    intro τ m hm
    have hex_τ : ∃ k : ℤ, ActsAsFrobPow F τ k := ⟨m, hm⟩
    have h_choose : ActsAsFrobPow F τ (weilDegree F τ) := by
      unfold weilDegree
      rw [dif_pos hex_τ]
      exact hex_τ.choose_spec
    exact actsAsFrobPow_unique τ (weilDegree F τ) m h_choose hm
  have weilGroup_acts : ∀ τ : weilGroup F,
      ActsAsFrobPow F (τ : AbsGal F) (weilDegree F (τ : AbsGal F)) := by
    intro τ
    obtain ⟨m, hm⟩ := weilGroup_exists τ
    rw [weilDegree_eq (τ : AbsGal F) m hm]
    exact hm
  let degHom : weilGroup F →* Multiplicative ℤ := {
    toFun := fun τ => Multiplicative.ofAdd (weilDegree F (τ : AbsGal F))
    map_one' := by
      rw [Subgroup.coe_one, weilDegree_eq 1 0 actsAsFrobPow_one, ofAdd_zero]
    map_mul' := fun τ₁ τ₂ => by
      have h_mul := actsAsFrobPow_mul (τ₁ : AbsGal F) (τ₂ : AbsGal F)
        (weilDegree F (τ₁ : AbsGal F)) (weilDegree F (τ₂ : AbsGal F))
        (weilGroup_acts τ₁) (weilGroup_acts τ₂)
      rw [Subgroup.coe_mul, weilDegree_eq _ _ h_mul, ofAdd_add]
  }
  have hex : ∃ f : weilGroup F →* Multiplicative ℤ,
      ∀ (τ : weilGroup F) (m : ℤ), ActsAsFrobPow F τ m → f τ = Multiplicative.ofAdd m := by
    refine ⟨degHom, fun τ m hm => ?_⟩
    change Multiplicative.ofAdd (weilDegree F (τ : AbsGal F)) = Multiplicative.ofAdd m
    rw [weilDegree_eq (τ : AbsGal F) m hm]
  exact @Classical.epsilon_spec _
    (fun f : weilGroup F →* Multiplicative ℤ =>
      ∀ (τ : weilGroup F) (m : ℤ), ActsAsFrobPow F τ m → f τ = Multiplicative.ofAdd m)
    hex σ n

theorem relVal_eq_resDeg_mul_valL (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] (x : Lˣ) :
    relVal F L x = (resDeg F L : ℤ) * valL F L x :=
by
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Lˣ, Multiplicative.toAdd (relValHom u) = relVal F L u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : Lˣ,
      relVal F L ((u * v : Lˣ) : L) = relVal F L u + relVal F L v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : Lˣ) (k : ℤ),
      relVal F L ((u ^ k : Lˣ) : L) = k * relVal F L u := by
    intro u k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F L ∧ ∃ π : Lˣ, relVal F L π = resDeg F L := by
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L u,
        (map_ne_zero (algebraMap F L)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (u : F)) = (u : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (u : F)
      have hpow : addVal F ((u : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F u := by
        change Multiplicative.toAdd (addValHom (u ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hf, π, hπ⟩ := resDeg_mem
  let q := relVal F L x / (resDeg F L : ℤ)
  let r := relVal F L x % (resDeg F L : ℤ)
  have hdiv : r + (resDeg F L : ℤ) * q = relVal F L x := Int.emod_add_mul_ediv _ _
  have hr0 : 0 ≤ r := Int.emod_nonneg _ (by positivity)
  have hrlt : r < (resDeg F L : ℤ) := Int.emod_lt_of_pos _ (by positivity)
  have hy : relVal F L ((x * π ^ (-q) : Lˣ) : L) = r := by
    rw [relVal_units_mul, relVal_units_zpow, hπ]
    linarith
  have hr_eq : r = 0 := by
    by_contra hr_ne
    have hr_pos : 0 < r.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
    have hmem : r.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k} := by
      refine ⟨hr_pos, ((x * π ^ (-q) : Lˣ) : L), Units.ne_zero _, ?_⟩
      rw [hy, Int.toNat_of_nonneg hr0]
    have hle : resDeg F L ≤ r.toNat := Nat.sInf_le hmem
    omega
  change relVal F L x = (resDeg F L : ℤ) * q
  linarith

theorem valL_chosenUniformizer_and_mul_zpow (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (x : Lˣ) :
    valL F L (chosenUniformizer F L) = 1 ∧
    valL F L ((x * (chosenUniformizer F L) ^ (1 - valL F L x) : Lˣ) : L) = 1 :=
by
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Lˣ, Multiplicative.toAdd (relValHom u) = relVal F L u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : Lˣ,
      relVal F L ((u * v : Lˣ) : L) = relVal F L u + relVal F L v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : Lˣ) (k : ℤ),
      relVal F L ((u ^ k : Lˣ) : L) = k * relVal F L u := by
    intro u k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F L ∧ ∃ π : Lˣ, relVal F L π = resDeg F L := by
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L u,
        (map_ne_zero (algebraMap F L)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (u : F)) = (u : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (u : F)
      have hpow : addVal F ((u : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F u := by
        change Multiplicative.toAdd (addValHom (u ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hf, π, hπ⟩ := resDeg_mem
  have relVal_eq_resDeg_mul_valL_aux : ∀ u : Lˣ, relVal F L u = (resDeg F L : ℤ) * valL F L u := by
    intro u
    let q := relVal F L u / (resDeg F L : ℤ)
    let r := relVal F L u % (resDeg F L : ℤ)
    have hdiv : r + (resDeg F L : ℤ) * q = relVal F L u := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r := Int.emod_nonneg _ (by positivity)
    have hrlt : r < (resDeg F L : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F L ((u * π ^ (-q) : Lˣ) : L) = r := by
      rw [relVal_units_mul, relVal_units_zpow, hπ]
      linarith
    have hr_eq : r = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k} := by
        refine ⟨hr_pos, ((u * π ^ (-q) : Lˣ) : L), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F L ≤ r.toNat := Nat.sInf_le hmem
      omega
    change relVal F L u = (resDeg F L : ℤ) * q
    linarith
  have hf_ne : (resDeg F L : ℤ) ≠ 0 := by positivity
  have hπ_val : valL F L π = 1 := by
    rw [valL, hπ, Int.ediv_self hf_ne]
  have hch : valL F L (chosenUniformizer F L) = 1 :=
    Classical.epsilon_spec (p := fun π : Lˣ => valL F L π = 1) ⟨π, hπ_val⟩
  refine ⟨hch, ?_⟩
  have hrel := relVal_eq_resDeg_mul_valL_aux (x * (chosenUniformizer F L) ^ (1 - valL F L x))
  rw [relVal_units_mul, relVal_units_zpow, relVal_eq_resDeg_mul_valL_aux x,
    relVal_eq_resDeg_mul_valL_aux (chosenUniformizer F L), hch, mul_one] at hrel
  apply mul_left_cancel₀ hf_ne
  linarith

theorem actsAsFrobPow_mul_and_zpow (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] :
    (∀ (σ₁ σ₂ : AbsGal F) (n₁ n₂ : ℤ),
      ActsAsFrobPow F σ₁ n₁ → ActsAsFrobPow F σ₂ n₂ →
      ActsAsFrobPow F (σ₁ * σ₂) (n₁ + n₂)) ∧
    (∀ (σ : AbsGal F) (n k : ℤ),
      ActsAsFrobPow F σ n → ActsAsFrobPow F (σ ^ k) (k * n)) :=
by
  have h_res_card : ∃ d : ℕ+, Nat.Prime (p F) ∧ q F = p F ^ (d : ℕ) := by
    haveI : Finite 𝓀[F] :=
      IsNonarchimedeanLocalField.instFiniteResidueFieldSubtypeMemSubringIntegerValueGroupWithZeroValuation F
    letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
    haveI : CharP 𝓀[F] (p F) := ringChar.charP 𝓀[F]
    obtain ⟨d, hp, hcard⟩ := FiniteField.card 𝓀[F] (p F)
    refine ⟨d, hp, ?_⟩
    unfold q
    rw [Nat.card_eq_fintype_card, hcard]
  obtain ⟨d, hp, hq_eq⟩ := h_res_card
  have isPrimeToP_map : ∀ (τ : AbsGal F) (ζ : AlgebraicClosure F),
      IsPrimeToPRootOfUnity F ζ → IsPrimeToPRootOfUnity F (τ ζ) := by
    intro τ ζ ⟨m, hm_pos, hpm, hζm⟩
    refine ⟨m, hm_pos, hpm, ?_⟩
    rw [← map_pow, hζm, map_one]
  have actsAsFrobPow_mul : ∀ (τ₁ τ₂ : AbsGal F) (n₁ n₂ : ℤ),
      ActsAsFrobPow F τ₁ n₁ → ActsAsFrobPow F τ₂ n₂ → ActsAsFrobPow F (τ₁ * τ₂) (n₁ + n₂) := by
    intro τ₁ τ₂ n₁ n₂ h₁ h₂ ζ hζ
    set a₁ : ℕ := n₁.toNat
    set b₁ : ℕ := (-n₁).toNat
    set a₂ : ℕ := n₂.toNat
    set b₂ : ℕ := (-n₂).toNat
    set A : ℕ := (n₁ + n₂).toNat
    set B : ℕ := (-(n₁ + n₂)).toNat
    set c : ℕ := (b₁ + b₂) - B
    have h_a_eq : a₁ + a₂ = A + c := by omega
    have h_b_eq : b₁ + b₂ = B + c := by omega
    set z₁ : AlgebraicClosure F := ((τ₁ * τ₂) ζ) ^ (q F ^ B)
    set z₂ : AlgebraicClosure F := ζ ^ (q F ^ A)
    set k : ℕ := q F ^ c
    have hz_pow_k : z₁ ^ k = z₂ ^ k := by
      have hτ₂ζ : IsPrimeToPRootOfUnity F (τ₂ ζ) := isPrimeToP_map τ₂ ζ hζ
      calc z₁ ^ k
        _ = ((τ₁ * τ₂) ζ) ^ (q F ^ B * q F ^ c) := (pow_mul _ _ _).symm
        _ = ((τ₁ * τ₂) ζ) ^ (q F ^ (B + c)) := by rw [← pow_add]
        _ = (τ₁ (τ₂ ζ)) ^ (q F ^ (b₁ + b₂)) := by rw [AlgEquiv.mul_apply, h_b_eq]
        _ = (τ₁ (τ₂ ζ)) ^ (q F ^ b₁ * q F ^ b₂) := by rw [pow_add]
        _ = ((τ₁ (τ₂ ζ)) ^ (q F ^ b₁)) ^ (q F ^ b₂) := pow_mul _ _ _
        _ = ((τ₂ ζ) ^ (q F ^ a₁)) ^ (q F ^ b₂) := by rw [h₁ (τ₂ ζ) hτ₂ζ]
        _ = ((τ₂ ζ) ^ (q F ^ b₂)) ^ (q F ^ a₁) := pow_right_comm _ _ _
        _ = (ζ ^ (q F ^ a₂)) ^ (q F ^ a₁) := by rw [h₂ ζ hζ]
        _ = ζ ^ (q F ^ a₂ * q F ^ a₁) := (pow_mul _ _ _).symm
        _ = ζ ^ (q F ^ (a₁ + a₂)) := by rw [← pow_add, add_comm a₂ a₁]
        _ = ζ ^ (q F ^ (A + c)) := by rw [h_a_eq]
        _ = ζ ^ (q F ^ A * q F ^ c) := by rw [pow_add]
        _ = z₂ ^ k := pow_mul _ _ _
    obtain ⟨m, hm_pos, hpm, hζm⟩ := hζ
    have hz₁_m : z₁ ^ m = 1 := by
      calc z₁ ^ m
        _ = (((τ₁ * τ₂) ζ) ^ m) ^ (q F ^ B) := pow_right_comm _ _ _
        _ = ((τ₁ * τ₂) (ζ ^ m)) ^ (q F ^ B) := by rw [map_pow]
        _ = 1 := by rw [hζm, map_one, one_pow]
    have hz₂_m : z₂ ^ m = 1 := by
      calc z₂ ^ m
        _ = (ζ ^ m) ^ (q F ^ A) := pow_right_comm _ _ _
        _ = 1 := by rw [hζm, one_pow]
    have hk_coprime : Nat.Coprime k m := by
      have hp_cop : Nat.Coprime (p F) m := hp.coprime_iff_not_dvd.mpr hpm
      have hq_cop : Nat.Coprime (q F) m := by
        rw [hq_eq]
        exact hp_cop.pow_left (d : ℕ)
      exact hq_cop.pow_left c
    have h_bezout : (k : ℤ) * k.gcdA m + (m : ℤ) * k.gcdB m = 1 := by
      have h_gcd := Nat.gcd_eq_gcd_ab k m
      rw [hk_coprime.gcd_eq_one] at h_gcd
      push_cast at h_gcd
      exact h_gcd.symm
    have pow_cancel : ∀ z : AlgebraicClosure F, z ^ m = 1 → z = (z ^ k) ^ (k.gcdA m) := by
      intro z hzm
      have hz_ne : z ≠ 0 := by
        intro hz0
        rw [hz0, zero_pow hm_pos.ne'] at hzm
        exact zero_ne_one hzm
      calc z
        _ = z ^ (1 : ℤ) := (zpow_one z).symm
        _ = z ^ ((k : ℤ) * k.gcdA m + (m : ℤ) * k.gcdB m) := by rw [h_bezout]
        _ = z ^ ((k : ℤ) * k.gcdA m) * z ^ ((m : ℤ) * k.gcdB m) := zpow_add₀ hz_ne _ _
        _ = (z ^ (k : ℤ)) ^ (k.gcdA m) * (z ^ (m : ℤ)) ^ (k.gcdB m) := by rw [zpow_mul, zpow_mul]
        _ = (z ^ k) ^ (k.gcdA m) * (z ^ m) ^ (k.gcdB m) := by rw [zpow_natCast, zpow_natCast]
        _ = (z ^ k) ^ (k.gcdA m) * 1 ^ (k.gcdB m) := by rw [hzm]
        _ = (z ^ k) ^ (k.gcdA m) := by rw [one_zpow, mul_one]
    rw [pow_cancel z₁ hz₁_m, pow_cancel z₂ hz₂_m, hz_pow_k]
  have actsAsFrobPow_inv : ∀ (τ : AbsGal F) (m : ℤ),
      ActsAsFrobPow F τ m → ActsAsFrobPow F τ⁻¹ (-m) := by
    intro τ m hm ζ hζ
    have hinvζ : IsPrimeToPRootOfUnity F (τ⁻¹ ζ) := isPrimeToP_map τ⁻¹ ζ hζ
    have h_app := hm (τ⁻¹ ζ) hinvζ
    have h_cancel : τ (τ⁻¹ ζ) = ζ := by
      rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
    rw [h_cancel] at h_app
    rw [neg_neg]
    exact h_app.symm
  have actsAsFrobPow_one : ActsAsFrobPow F 1 0 := by
    intro ζ _
    simp
  have actsAsFrobPow_pow : ∀ (σ : AbsGal F) (n : ℤ) (m : ℕ),
      ActsAsFrobPow F σ n → ActsAsFrobPow F (σ ^ m) ((m : ℤ) * n) := by
    intro σ n m h
    induction m with
    | zero =>
      rw [pow_zero, Nat.cast_zero, zero_mul]
      exact actsAsFrobPow_one
    | succ m ih =>
      have h_mul := actsAsFrobPow_mul (σ ^ m) σ ((m : ℤ) * n) n ih h
      have h_eq : ((m + 1 : ℕ) : ℤ) * n = (m : ℤ) * n + n := by
        push_cast
        ring
      rw [pow_succ, h_eq]
      exact h_mul
  have actsAsFrobPow_zpow : ∀ (σ : AbsGal F) (n k : ℤ),
      ActsAsFrobPow F σ n → ActsAsFrobPow F (σ ^ k) (k * n) := by
    intro σ n k h
    cases k with
    | ofNat m =>
      rw [Int.ofNat_eq_natCast, zpow_natCast]
      exact actsAsFrobPow_pow σ n m h
    | negSucc m =>
      rw [zpow_negSucc]
      have h_pow := actsAsFrobPow_pow σ n (m + 1) h
      have h_inv := actsAsFrobPow_inv (σ ^ (m + 1)) (((m + 1 : ℕ) : ℤ) * n) h_pow
      have h_eq : Int.negSucc m * n = -(((m + 1 : ℕ) : ℤ) * n) := by
        rw [Int.negSucc_eq]
        push_cast
        ring
      rw [h_eq]
      exact h_inv
  exact ⟨actsAsFrobPow_mul, actsAsFrobPow_zpow⟩

theorem isIntegral_pow_qL_sub_and_p_div_chosenUniformizer (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] :
    (∀ c : L, IsIntegral 𝒪[F] c →
      IsIntegral 𝒪[F] ((c ^ qL F L - c) / (chosenUniformizer F L : L))) ∧
    IsIntegral 𝒪[F] ((p F : L) / (chosenUniformizer F L : L)) :=
by
  have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
      0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
    intro a ha
    unfold addVal
    rw [dif_neg ha]
    set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    set va := valuation F a
    have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
    constructor
    · intro h_nonneg
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
      have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
      have h_iso : iso va ≤ iso 1 := by
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
        exact WithZero.coe_le_coe.mpr h_unzero
      exact (map_le_map_iff iso).mp h_iso
    · intro h_le
      have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
      rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
        Multiplicative.toAdd_le.mpr h_iso
      omega
  have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  have addVal_div : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x / y) = addVal F x - addVal F y := by
    intro x y hx hy
    have hxy : x / y ≠ 0 := div_ne_zero hx hy
    have h := addVal_mul hxy hy
    rw [div_mul_cancel₀ _ hy] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Lˣ, Multiplicative.toAdd (relValHom u) = relVal F L u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : Lˣ,
      relVal F L ((u * v : Lˣ) : L) = relVal F L u + relVal F L v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : Lˣ) (k : ℤ),
      relVal F L ((u ^ k : Lˣ) : L) = k * relVal F L u := by
    intro u k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have relVal_mul : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      relVal F L (x * y) = relVal F L x + relVal F L y := by
    intro x y hx hy
    exact relVal_units_mul (Units.mk0 x hx) (Units.mk0 y hy)
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F L ∧ ∃ π : Lˣ, relVal F L π = resDeg F L := by
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L u,
        (map_ne_zero (algebraMap F L)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (u : F)) = (u : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (u : F)
      have hpow : addVal F ((u : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F u := by
        change Multiplicative.toAdd (addValHom (u ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hf_pos, π_ex, hπ_ex⟩ := resDeg_mem
  have relVal_eq_resDeg_mul_valL_aux :
      ∀ u : Lˣ, relVal F L u = (resDeg F L : ℤ) * valL F L u := by
    intro u
    let q := relVal F L u / (resDeg F L : ℤ)
    let r := relVal F L u % (resDeg F L : ℤ)
    have hdiv : r + (resDeg F L : ℤ) * q = relVal F L u := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r := Int.emod_nonneg _ (by positivity)
    have hrlt : r < (resDeg F L : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F L ((u * π_ex ^ (-q) : Lˣ) : L) = r := by
      rw [relVal_units_mul, relVal_units_zpow, hπ_ex]
      linarith
    have hr_eq : r = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k} := by
        refine ⟨hr_pos, ((u * π_ex ^ (-q) : Lˣ) : L), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F L ≤ r.toNat := Nat.sInf_le hmem
      omega
    change relVal F L u = (resDeg F L : ℤ) * q
    linarith
  have relVal_eq : ∀ {x : L} (hx : x ≠ 0), relVal F L x = (resDeg F L : ℤ) * valL F L x :=
    fun hx => relVal_eq_resDeg_mul_valL_aux (Units.mk0 _ hx)
  set πL : L := (chosenUniformizer F L : L)
  have hπL_ne : πL ≠ 0 := Units.ne_zero (chosenUniformizer F L)
  have hπ_val : valL F L πL = 1 := by
    have hf_ne : (resDeg F L : ℤ) ≠ 0 := by positivity
    have hπ_ex_val : valL F L π_ex = 1 := by
      rw [valL, hπ_ex, Int.ediv_self hf_ne]
    exact Classical.epsilon_spec (p := fun π : Lˣ => valL F L π = 1) ⟨π_ex, hπ_ex_val⟩
  have hπ_rel : relVal F L πL = (resDeg F L : ℤ) := by
    rw [relVal_eq hπL_ne, hπ_val, mul_one]
  have valL_mul : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      valL F L (x * y) = valL F L x + valL F L y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    have h := relVal_mul hx hy
    rw [relVal_eq hxy, relVal_eq hx, relVal_eq hy, ← mul_add] at h
    exact mul_left_cancel₀ (by positivity) h
  have valL_one : valL F L 1 = 0 := by
    have h1 : (1 : L) ≠ 0 := one_ne_zero
    have h := valL_mul h1 h1
    rw [mul_one] at h
    omega
  have valL_div : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      valL F L (x / y) = valL F L x - valL F L y := by
    intro x y hx hy
    have hxy : x / y ≠ 0 := div_ne_zero hx hy
    have h := valL_mul hxy hy
    rw [div_mul_cancel₀ _ hy] at h
    omega
  have valL_pow : ∀ {x : L} (hx : x ≠ 0) (n : ℕ), valL F L (x ^ n) = (n : ℤ) * valL F L x := by
    intro x hx n
    induction n with
    | zero => simp [valL_one]
    | succ n ih =>
      rw [pow_succ, valL_mul (pow_ne_zero n hx) hx, ih]
      push_cast
      ring
  have h_int_aux : ∀ (K : Type u) [Field K] [Algebra F K] [FiniteDimensional F K] (x : K),
      IsIntegral 𝒪[F] x ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x) := by
    intro K _ _ _ x
    constructor
    · intro hx
      by_cases hx0 : x = 0
      · exact Or.inl hx0
      · right
        have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
        have hnorm_int : IsIntegral 𝒪[F] (Algebra.norm F x) := Algebra.isIntegral_norm F hx
        have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
          (Valuation.Integers.isIntegral_iff_v_le_one
            (Valuation.integer.integers (valuation F))).mp hnorm_int
        exact (addVal_nonneg_iff_val_le_one hnorm0).mpr hval_le
    · rintro (rfl | h_rel)
      · exact isIntegral_zero
      · by_cases hx0 : x = 0
        · rw [hx0]
          exact isIntegral_zero
        · have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
          have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
            (addVal_nonneg_iff_val_le_one hnorm0).mp h_rel
          have hx_int_F : IsIntegral F x := Algebra.IsIntegral.isIntegral x
          let pb : PowerBasis F (IntermediateField.adjoin F ({x} : Set K)) :=
            IntermediateField.adjoin.powerBasis hx_int_F
          have h_gen_coe : (pb.gen : K) = x := IntermediateField.AdjoinSimple.coe_gen F x
          set dK : ℕ := Module.finrank (IntermediateField.adjoin F ({x} : Set K)) K
          have h_finrank_pos : 0 < dK := Module.finrank_pos
          have h_norm_tower : Algebra.norm F x = (Algebra.norm F pb.gen) ^ dK := by
            have h1 : Algebra.norm F (pb.gen : K) = (Algebra.norm F pb.gen) ^ dK := by
              rw [← Algebra.norm_norm (R := F) (S := IntermediateField.adjoin F ({x} : Set K))
                (A := K) (a := (pb.gen : K)), ← map_pow]
              congr 1
              exact Algebra.norm_algebraMap (L := K) pb.gen
            rwa [h_gen_coe] at h1
          have h_norm_pb : Algebra.norm F pb.gen =
              (-1) ^ pb.dim * (minpoly F pb.gen).coeff 0 :=
            Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb
          have h_minpoly_eq : minpoly F pb.gen = minpoly F x := by
            have h1 : minpoly F pb.gen = minpoly F (pb.gen : K) :=
              (minpoly.algHom_eq
                (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K)))
                (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K))).injective
                pb.gen).symm
            rwa [h_gen_coe] at h1
          letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
          haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
          haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
          letI : Valued F (ValueGroupWithZero F) :=
            IsValuativeTopology.instValuedValueGroupWithZeroOfIsUniformAddGroup
          let rlo : RankLeOneStruct F :=
            { emb := (WithZeroMulInt.toNNReal (by norm_num : (2 : NNReal) ≠ 0)).comp
                (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).toMonoidWithZeroHom
              strictMono := (WithZeroMulInt.toNNReal_strictMono (by norm_num : (1 : NNReal) < 2)).comp
                (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).strictMono }
          haveI : (Valued.v (R := F)).RankOne := Valuation.RankOne.ofRankLeOneStruct rlo
          letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
          haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F (ValueGroupWithZero F)
          have hnorm_norm_le : ‖Algebra.norm F x‖ ≤ 1 :=
            Valued.toNormedField.norm_le_one_iff.mpr hval_le
          have h_norm_coeff_pow : ‖Algebra.norm F x‖ =
