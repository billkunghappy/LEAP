      change Multiplicative.toAdd (addValHom ((Units.mk0 c hc) ^ Module.finrank F L)) = _
      rw [map_pow, toAdd_pow, nsmul_eq_mul]
      rfl
    rw [relVal, hnorm, hpow]
  have h_res_zero_div_int : ∀ d : 𝒪[F], IsLocalRing.residue 𝒪[F] d = 0 →
      IsIntegral 𝒪[F] (algebraMap 𝒪[F] L d / πL) := by
    intro d hd_res
    by_cases hd0 : (d : F) = 0
    · have hdL : algebraMap 𝒪[F] L d = 0 := by
        change algebraMap F L (d : F) = 0
        rw [hd0, map_zero]
      rw [hdL, zero_div]
      exact isIntegral_zero
    · have hdL0 : algebraMap 𝒪[F] L d ≠ 0 := by
        change algebraMap F L (d : F) ≠ 0
        exact (map_ne_zero (algebraMap F L)).mpr hd0
