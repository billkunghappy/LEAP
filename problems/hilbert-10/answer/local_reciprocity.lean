      change y ^ qL F L + (c * y - (c * y + y ^ qL F L)) = 0
      ring
    have hy_A : IsIntegral A_int y := ⟨Q, hQ_monic, hQ_eval⟩
    exact @isIntegral_trans 𝒪[F] ↥A_int (AlgebraicClosure F) _ _ _ _ _ _ _ _ y hy_A
