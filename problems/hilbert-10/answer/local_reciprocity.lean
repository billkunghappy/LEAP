        rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
        exact not_not.mpr hd_res
      have h_val_lt : valuation F (d : F) < 1 :=
        (Valuation.Integer.not_isUnit_iff_valuation_lt_one).mp h_not_unit
