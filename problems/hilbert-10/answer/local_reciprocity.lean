      have hd_k_mem : d_k ∈ unramSubring F L := by
        rw [hd_k_def]
        exact (unramSubring F L).neg_mem
          ((unramSubring F L).mul_mem ((unramSubring F L).mul_mem hε'₁_mem huinv_mem') hc_k_mem)
      obtain ⟨b_k, hb_k_mem, hb_k_congr⟩ := h_as d_k hd_k_mem
      have hb_k_congr' : IsIntegral 𝒪[F] ((τ b_k - b_k - d_k) / πbar ^ 1) := by
        rw [hπbar_def]
        exact hb_k_congr
      have hb_k_int : IsIntegral 𝒪[F] b_k := (h_unram b_k hb_k_mem).1
      have hτ_bk_int : IsIntegral 𝒪[F] (τ b_k) := (h_unram _ (h_unram b_k hb_k_mem).2.1).1
      obtain ⟨ε_next, hε_next_def⟩ : ∃ ε_next : AlgebraicClosure F,
          ε_next = ε_k + πbar ^ (k + 1) * ε₁ * b_k := ⟨_, rfl⟩
      have hε_next_mem : ε_next ∈ unramSubring F L := by
        rw [hε_next_def]
        exact (unramSubring F L).add_mem hε_k_mem
          ((unramSubring F L).mul_mem
            ((unramSubring F L).mul_mem ((unramSubring F L).pow_mem hπbar_mem' (k + 1)) hε₁_mem)
            hb_k_mem)
      refine ⟨ε_next, hε_next_mem, ?_, ?_⟩
      · have h_unit_eq : (ε_next * ε'₁ - 1) / πbar ^ 1 =
            (ε_k * ε'₁ - 1) / πbar ^ 1 + πbar ^ k * b_k := by
          rw [div_eq_iff (pow_ne_zero 1 hπbar_ne)]
          have h1 : ε_k * ε'₁ - 1 = ((ε_k * ε'₁ - 1) / πbar ^ 1) * πbar ^ 1 :=
            (div_mul_cancel₀ _ (pow_ne_zero 1 hπbar_ne)).symm
          calc ε_next * ε'₁ - 1
              = (ε_k * ε'₁ - 1) + πbar ^ (k + 1) * (ε₁ * ε'₁) * b_k := by
                rw [hε_next_def]
                ring
            _ = ((ε_k * ε'₁ - 1) / πbar ^ 1) * πbar ^ 1 +
                  (πbar ^ k * πbar ^ 1) * 1 * b_k := by
                rw [← h1, ← pow_add, hε₁_mul_inv]
            _ = ((ε_k * ε'₁ - 1) / πbar ^ 1 + πbar ^ k * b_k) * πbar ^ 1 := by ring
        rw [h_unit_eq]
        exact IsIntegral.add h_unit_k (IsIntegral.mul (hπbar_int'.pow k) hb_k_int)
      · have hτ_next : τ ε_next = τ ε_k + πbar ^ (k + 1) * τ ε₁ * τ b_k := by
          rw [hε_next_def, map_add, map_mul, map_mul, map_pow, hτ_πbar]
        have h_ck_cancel : c_k = -(ubar * ε₁ * d_k) := by
          calc c_k = 1 * 1 * c_k := by ring
            _ = (ubar * uinv) * (ε₁ * ε'₁) * c_k := by rw [hu_mul_inv, hε₁_mul_inv]
            _ = -(ubar * ε₁ * -(ε'₁ * uinv * c_k)) := by ring
            _ = -(ubar * ε₁ * d_k) := by rw [hd_k_def]
        have h_frob_eq : (τ ε_next - ubar * ε_next) / πbar ^ (k + 2) =
            ubar * ε₁ * ((τ b_k - b_k - d_k) / πbar ^ 1) +
            ((τ ε₁ - ubar * ε₁) / πbar ^ 1) * τ b_k := by
          rw [div_eq_iff (pow_ne_zero (k + 2) hπbar_ne)]
          have h1 : τ b_k - b_k - d_k = ((τ b_k - b_k - d_k) / πbar ^ 1) * πbar ^ 1 :=
            (div_mul_cancel₀ _ (pow_ne_zero 1 hπbar_ne)).symm
          have h2 : τ ε₁ - ubar * ε₁ = ((τ ε₁ - ubar * ε₁) / πbar ^ 1) * πbar ^ 1 :=
            (div_mul_cancel₀ _ (pow_ne_zero 1 hπbar_ne)).symm
          calc τ ε_next - ubar * ε_next
              = (τ ε_k - ubar * ε_k) + πbar ^ (k + 1) * (τ ε₁ * τ b_k - ubar * ε₁ * b_k) := by
                rw [hτ_next, hε_next_def]
                ring
            _ = πbar ^ (k + 1) * (c_k + τ ε₁ * τ b_k - ubar * ε₁ * b_k) := by
                rw [hc_k_eq]
                ring
            _ = πbar ^ (k + 1) *
                  (ubar * ε₁ * (τ b_k - b_k - d_k) + (τ ε₁ - ubar * ε₁) * τ b_k) := by
                rw [h_ck_cancel]
                ring
            _ = πbar ^ (k + 1) *
                  (ubar * ε₁ * (((τ b_k - b_k - d_k) / πbar ^ 1) * πbar ^ 1) +
                   (((τ ε₁ - ubar * ε₁) / πbar ^ 1) * πbar ^ 1) * τ b_k) := by
                rw [← h1, ← h2]
            _ = (ubar * ε₁ * ((τ b_k - b_k - d_k) / πbar ^ 1) +
                  ((τ ε₁ - ubar * ε₁) / πbar ^ 1) * τ b_k) *
                  (πbar ^ (k + 1) * πbar ^ 1) := by ring
            _ = (ubar * ε₁ * ((τ b_k - b_k - d_k) / πbar ^ 1) +
                  ((τ ε₁ - ubar * ε₁) / πbar ^ 1) * τ b_k) * πbar ^ (k + 2) := by
                rw [← pow_add]
        rw [h_frob_eq]
        exact IsIntegral.add (IsIntegral.mul (IsIntegral.mul hubar_int' hε₁_int) hb_k_congr')
          (IsIntegral.mul hε₁_frob' hτ_bk_int)
  cases K with
  | zero =>
    refine ⟨ε₁, hε₁_mem, ε'₁, hε'₁_mem, ?_, ?_⟩
    · change IsIntegral 𝒪[F] ((ε₁ * ε'₁ - 1) / (algebraMap L (AlgebraicClosure F) (π : L)) ^ 1)
      rw [hε₁_mul_inv, sub_self, zero_div]
      exact isIntegral_zero
    · change IsIntegral 𝒪[F]
        ((τ ε₁ - algebraMap L (AlgebraicClosure F) (u : L) * ε₁) /
          (algebraMap L (AlgebraicClosure F) (π : L)) ^ 0)
      rw [pow_zero, div_one]
      have h_mem : τ ε₁ - algebraMap L (AlgebraicClosure F) (u : L) * ε₁ ∈ unramSubring F L :=
        (unramSubring F L).sub_mem ((h_unram ε₁ hε₁_mem).2.1)
          ((unramSubring F L).mul_mem hubar_mem hε₁_mem)
      exact (h_unram _ h_mem).1
  | succ k =>
    obtain ⟨ε, hε_mem, h_unit, h_frob⟩ := h_ind k
    refine ⟨ε, hε_mem, ε'₁, hε'₁_mem, ?_, ?_⟩
    · unfold IsIntegralDivPow
      rwa [← hπbar_def]
    · unfold IsIntegralDivPow
      rwa [← hπbar_def, ← hubar_def]

theorem colemanTheta_iter_and_endoTrunc_congr (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (π u : Lˣ) :
    valL F L π = 1 → valL F L u = 0 →
      ∀ (τ : AbsGal F), τ ∈ L.fixingSubgroup →
        (∀ x ∈ unramSubring F L,
          IsIntegral 𝒪[F] x ∧
          τ x ∈ unramSubring F L ∧
          (τ x - x ^ qL F L) / algebraMap L (AlgebraicClosure F) (π : L) ∈ unramSubring F L) →
        ∀ (ε : AlgebraicClosure F), ε ∈ unramSubring F L →
        ∀ (M₀ r₁ : ℕ),
          IsIntegralDivPow F L (π : L) (M₀ + r₁ + 1)
            (τ ε - algebraMap L (AlgebraicClosure F) (u : L) * ε) →
          let θ := colemanTheta F L (π : L) (u : L) τ ε (M₀ + r₁) r₁
          θ.coeff 0 = 0 ∧
          (1 ≤ r₁ → θ.coeff 1 = ε) ∧
          θ.natDegree ≤ r₁ ∧
          (∀ k : ℕ, IsIntegral 𝒪[F] (θ.coeff k)) ∧
          (∀ (n : ℕ) (k : ℕ), k ≤ r₁ →
            IsIntegralDivPow F L (π : L) M₀
              ((((θ.map ((τ ^ n : AbsGal F) : AlgebraicClosure F →+* AlgebraicClosure F)).comp
                ((lubinTateIterPoly F L (π : L) n).map (algebraMap L (AlgebraicClosure F)))) -
                ((lubinTateIterPoly F L ((u * π : Lˣ) : L) n).map
                  (algebraMap L (AlgebraicClosure F))).comp θ).coeff k)) ∧
          (∀ k : ℕ, k ≤ r₁ →
            IsIntegralDivPow F L (π : L) M₀
              (((θ.map (τ : AlgebraicClosure F →+* AlgebraicClosure F)) -
                θ.comp ((lubinTateEndoTrunc F L (π : L) (u : L) r₁).map
                  (algebraMap L (AlgebraicClosure F)))).coeff k)) :=
by
  intro hπ hu τ hτL h_unram ε hε_mem M₀ r₁ hε_frob
  let π₀ : Lˣ := chosenUniformizer F L
  let πL : L := (π : L)
  let uL : L := (u : L)
  let πbar : AlgebraicClosure F := algebraMap L (AlgebraicClosure F) πL
  let ubar : AlgebraicClosure F := algebraMap L (AlgebraicClosure F) uL
  let M : ℕ := M₀ + r₁
  let fπL : Polynomial L := lubinTatePoly F L πL
  let fuπL : Polynomial L := lubinTatePoly F L (uL * πL)
  let fπ : Polynomial (AlgebraicClosure F) := fπL.map (algebraMap L (AlgebraicClosure F))
  let fuπ : Polynomial (AlgebraicClosure F) := fuπL.map (algebraMap L (AlgebraicClosure F))
  have hπ₀ : valL F L π₀ = 1 := (valL_chosenUniformizer_and_mul_zpow F L π).1
  have h_relVal_eq : ∀ x : Lˣ, relVal F L x = (resDeg F L : ℤ) * valL F L x :=
    relVal_eq_resDeg_mul_valL F L
  have h_int_iff : ∀ z : L, IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ relVal F L z :=
    isIntegral_iff_eq_zero_or_relVal_nonneg F L
  obtain ⟨h_frob₀, h_p₀⟩ := isIntegral_pow_qL_sub_and_p_div_chosenUniformizer F L
  have hπL_ne : πL ≠ 0 := π.ne_zero
  have huL_ne : uL ≠ 0 := u.ne_zero
  have hπbar_ne : πbar ≠ 0 := (map_ne_zero (algebraMap L (AlgebraicClosure F))).mpr hπL_ne
  have hubar_ne : ubar ≠ 0 := (map_ne_zero (algebraMap L (AlgebraicClosure F))).mpr huL_ne
  have hf_ne : (resDeg F L : ℤ) ≠ 0 := by
    intro h0
    have h1 : valL F L πL = 1 := hπ
    rw [valL, h0, Int.ediv_zero] at h1
    omega
  have hres_ne : resDeg F L ≠ 0 := by omega
  have hf_pos : 0 < (resDeg F L : ℤ) := by omega
  have hq : 1 < q F := by
    unfold q
    exact Finite.one_lt_card
  have hqL : 1 < qL F L := Nat.one_lt_pow hres_ne hq
  have addVal_mul : ∀ {x y : F}, x ≠ 0 → y ≠ 0 → addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun v => Multiplicative.ofAdd (addVal F v)
      map_one' := by simp [addVal_one]
      map_mul' := fun v w => by simp [addVal_mul v.ne_zero w.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ v : Lˣ, Multiplicative.toAdd (relValHom v) = relVal F L v :=
    fun _ => rfl
  have relVal_units_mul : ∀ v w : Lˣ,
      relVal F L ((v * w : Lˣ) : L) = relVal F L v + relVal F L w := by
    intro v w
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (v : Lˣ) (k : ℤ),
      relVal F L ((v ^ k : Lˣ) : L) = k * relVal F L v := by
    intro v k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have valL_units_mul : ∀ v w : Lˣ,
      valL F L ((v * w : Lˣ) : L) = valL F L v + valL F L w := by
    intro v w
    have hrel := h_relVal_eq (v * w)
    rw [relVal_units_mul, h_relVal_eq v, h_relVal_eq w] at hrel
    apply mul_left_cancel₀ hf_ne
    linarith
  have valL_units_zpow : ∀ (v : Lˣ) (k : ℤ),
      valL F L ((v ^ k : Lˣ) : L) = k * valL F L v := by
    intro v k
    have hrel := h_relVal_eq (v ^ k)
    rw [relVal_units_zpow, h_relVal_eq v] at hrel
    apply mul_left_cancel₀ hf_ne
    linarith
  have valL_div : ∀ {x y : L}, x ≠ 0 → y ≠ 0 → valL F L (x / y) = valL F L x - valL F L y := by
    intro x y hx hy
    let ux : Lˣ := Units.mk0 x hx
    let uy : Lˣ := Units.mk0 y hy
    have hxy : x / y = ((ux * uy ^ (-1 : ℤ) : Lˣ) : L) := by
      simp [ux, uy, div_eq_mul_inv]
    rw [hxy, valL_units_mul, valL_units_zpow]
    change valL F L x + (-1 : ℤ) * valL F L y = valL F L x - valL F L y
    ring
  have valL_pi_pow : ∀ k : ℕ, valL F L (πL ^ k) = (k : ℤ) := by
    intro k
    have hpow : πL ^ k = ((π ^ (k : ℤ) : Lˣ) : L) := by simp [πL]
    rw [hpow, valL_units_zpow, hπ, mul_one]
  have hπ_pow_sub_ne : ∀ m : ℕ, 1 ≤ m → πL ^ (m + 1) - πL ≠ 0 := by
    intro m hm h0
    have heq : πL ^ (m + 1) = πL := sub_eq_zero.mp h0
    have hval := congrArg (valL F L) heq
    rw [valL_pi_pow (m + 1), hπ] at hval
    omega
  have mem_int_iff : ∀ z : L, IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ valL F L z := by
    intro z
    rw [h_int_iff z]
    rcases eq_or_ne z 0 with rfl | hz
    · simp
    · have hrel := h_relVal_eq (Units.mk0 z hz)
      change relVal F L z = (resDeg F L : ℤ) * valL F L z at hrel
      rw [or_iff_right hz, or_iff_right hz, hrel, mul_nonneg_iff_of_pos_left hf_pos]
  have hπL_val : valL F L πL = 1 := hπ
  have huL_val : valL F L uL = 0 := hu
  have hπL_int : IsIntegral 𝒪[F] πL := (mem_int_iff πL).mpr (Or.inr (by omega))
  have huL_int : IsIntegral 𝒪[F] uL := (mem_int_iff uL).mpr (Or.inr (by omega))
  have huL_inv_int : IsIntegral 𝒪[F] uL⁻¹ := by
    rw [mem_int_iff]
    right
    have h_inv_eq : uL⁻¹ = (1 : L) / uL := (one_div uL).symm
    have h1_val : valL F L 1 = 0 := by simpa using valL_pi_pow 0
    rw [h_inv_eq, valL_div one_ne_zero huL_ne, h1_val, hu]
    omega
  have hw_int : IsIntegral 𝒪[F] ((π₀ : L) / πL) := by
    rw [mem_int_iff]
    right
    rw [valL_div π₀.ne_zero hπL_ne, hπ₀, hπ]
    omega
  have h_div_transfer : ∀ z : L, z / πL = (z / (π₀ : L)) * ((π₀ : L) / πL) := by
    intro z
    calc z / πL = (z / (π₀ : L) * (π₀ : L)) / πL := by rw [div_mul_cancel₀ z π₀.ne_zero]
      _ = (z / (π₀ : L)) * ((π₀ : L) / πL) := mul_div_assoc _ _ _
  have h_fermat_pi : ∀ c : L, IsIntegral 𝒪[F] c →
      IsIntegral 𝒪[F] ((c ^ qL F L - c) / πL) := by
    intro c hc
    rw [h_div_transfer]
    exact (h_frob₀ c hc).mul hw_int
  have h_p_div_pi : IsIntegral 𝒪[F] ((p F : L) / πL) := by
    rw [h_div_transfer]
    exact h_p₀.mul hw_int
  have h_inv_pi_not_mem : ¬ IsIntegral 𝒪[F] (1 / πL) := by
    rw [mem_int_iff]
    rintro (h0 | hle)
    · exact one_div_ne_zero hπL_ne h0
    · have h1 : valL F L 1 = 0 := by simpa using valL_pi_pow 0
      rw [valL_div one_ne_zero hπL_ne, h1, hπ] at hle
      omega
  have h_div_unit_mem : ∀ (k : ℕ) {y : L},
      IsIntegral 𝒪[F] y → IsIntegral 𝒪[F] (y / (πL ^ (k + 1) - 1)) := by
    intro k y hy
    set v := πL ^ (k + 1) - 1
    have hv_mem : IsIntegral 𝒪[F] v :=
      IsIntegral.sub (IsIntegral.pow hπL_int (k + 1)) isIntegral_one
    have hv_div_not_mem : ¬ IsIntegral 𝒪[F] (v / πL) := by
      intro hmem
      apply h_inv_pi_not_mem
      have h_id : 1 / πL = πL ^ k - v / πL := by
        dsimp [v]
        rw [sub_div, pow_succ', mul_div_cancel_left₀ _ hπL_ne, sub_sub_cancel]
      rw [h_id]
      exact IsIntegral.sub (IsIntegral.pow hπL_int k) hmem
    have hv_ne : v ≠ 0 := by
      intro h0
      apply hv_div_not_mem
      rw [h0, zero_div]
      exact isIntegral_zero
    have hv_val_nonneg : 0 ≤ valL F L v := ((mem_int_iff v).mp hv_mem).resolve_left hv_ne
    have hv_val_lt : valL F L v < 1 := by
      by_contra hge
      apply hv_div_not_mem
      rw [mem_int_iff]
      right
      rw [valL_div hv_ne hπL_ne, hπ]
      omega
    have hv_val : valL F L v = 0 := by omega
    rw [mem_int_iff]
    rcases eq_or_ne y 0 with rfl | hy0
    · left
      exact zero_div v
    · right
      have hy_val : 0 ≤ valL F L y := ((mem_int_iff y).mp hy).resolve_left hy0
      rw [valL_div hy0 hv_ne, hv_val, sub_zero]
      exact hy_val
  letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  haveI : CharP 𝓀[F] (p F) := ringChar.charP 𝓀[F]
  obtain ⟨n_p, hp_prime, hcard_p⟩ := FiniteField.card 𝓀[F] (p F)
  let e_p : ℕ := (n_p : ℕ) * resDeg F L
  have hqL_eq_p_pow : qL F L = (p F) ^ e_p := by
    dsimp [qL, q, e_p]
    rw [Nat.card_eq_fintype_card, hcard_p, ← pow_mul]
  let polyMem : ∀ {R : Type u} [CommRing R], Subring R → Polynomial R → Prop :=
    fun S P => ∀ k : ℕ, P.coeff k ∈ S
  have polyMem_zero : ∀ {R : Type u} [CommRing R] (S : Subring R), polyMem S 0 := by
    intro R _ S k
    rw [Polynomial.coeff_zero]
    exact S.zero_mem
  have polyMem_one : ∀ {R : Type u} [CommRing R] (S : Subring R), polyMem S 1 := by
    intro R _ S k
    rw [Polynomial.coeff_one]
    split_ifs <;> [exact S.one_mem; exact S.zero_mem]
  have polyMem_X : ∀ {R : Type u} [CommRing R] (S : Subring R), polyMem S Polynomial.X := by
    intro R _ S k
    rw [Polynomial.coeff_X]
    split_ifs <;> [exact S.one_mem; exact S.zero_mem]
  have polyMem_C : ∀ {R : Type u} [CommRing R] (S : Subring R) {c : R},
      c ∈ S → polyMem S (Polynomial.C c) := by
    intro R _ S c hc k
    rw [Polynomial.coeff_C]
    split_ifs <;> [exact hc; exact S.zero_mem]
  have polyMem_natCast : ∀ {R : Type u} [CommRing R] (S : Subring R) (m : ℕ),
      polyMem S (m : Polynomial R) := by
    intro R _ S m
    rw [← Polynomial.C_eq_natCast]
    exact polyMem_C S (natCast_mem S m)
  have polyMem_monomial : ∀ {R : Type u} [CommRing R] (S : Subring R) (j : ℕ) {c : R},
      c ∈ S → polyMem S (Polynomial.monomial j c) := by
    intro R _ S j c hc k
    rw [Polynomial.coeff_monomial]
    split_ifs <;> [exact hc; exact S.zero_mem]
  have polyMem_add : ∀ {R : Type u} [CommRing R] (S : Subring R) {P Q : Polynomial R},
      polyMem S P → polyMem S Q → polyMem S (P + Q) := by
    intro R _ S P Q hP hQ k
    rw [Polynomial.coeff_add]
    exact S.add_mem (hP k) (hQ k)
  have polyMem_sub : ∀ {R : Type u} [CommRing R] (S : Subring R) {P Q : Polynomial R},
      polyMem S P → polyMem S Q → polyMem S (P - Q) := by
    intro R _ S P Q hP hQ k
    rw [Polynomial.coeff_sub]
    exact S.sub_mem (hP k) (hQ k)
  have polyMem_mul : ∀ {R : Type u} [CommRing R] (S : Subring R) {P Q : Polynomial R},
      polyMem S P → polyMem S Q → polyMem S (P * Q) := by
    intro R _ S P Q hP hQ k
    rw [Polynomial.coeff_mul]
    exact S.sum_mem fun x _ => S.mul_mem (hP x.1) (hQ x.2)
  have polyMem_pow : ∀ {R : Type u} [CommRing R] (S : Subring R) {P : Polynomial R},
      polyMem S P → ∀ e : ℕ, polyMem S (P ^ e) := by
    intro R _ S P hP e
    induction e with
    | zero => exact polyMem_one S
    | succ e ih =>
      rw [pow_succ]
      exact polyMem_mul S ih hP
  have polyMem_sum : ∀ {R : Type u} [CommRing R] (S : Subring R) {ι : Type}
      (s : Finset ι) (g : ι → Polynomial R),
      (∀ i ∈ s, polyMem S (g i)) → polyMem S (∑ i ∈ s, g i) := by
    intro R _ S ι s g hg k
    rw [Polynomial.finset_sum_coeff]
    exact S.sum_mem fun i hi => hg i hi k
