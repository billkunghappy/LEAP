    have hδ : 0 < ‖x - u r‖ - ‖πL‖ ^ m := by linarith
    obtain ⟨K, hK⟩ := Metric.tendsto_atTop.mp hx (‖x - u r‖ - ‖πL‖ ^ m) hδ
    have h_dist_x : dist x (u (r + K)) < ‖x - u r‖ - ‖πL‖ ^ m := by
      rw [dist_comm]
      exact hK (r + K) (Nat.le_add_left K r)
    have h_dist_u : dist (u (r + K)) (u r) ≤ ‖πL‖ ^ m := by
      rw [dist_eq_norm]
      exact hu_norm m r K hmr
    have h_tri : ‖x - u r‖ ≤ dist x (u (r + K)) + dist (u (r + K)) (u r) := by
      rw [← dist_eq_norm]
      exact dist_triangle x (u (r + K)) (u r)
    linarith
  have hqL_ge_two : 2 ≤ qL F L := by
    dsimp [qL]
    calc 2 = 2 ^ 1 := (pow_one 2).symm
      _ ≤ 2 ^ resDeg F L := Nat.pow_le_pow_right (by omega) hf_pos
      _ ≤ q F ^ resDeg F L := Nat.pow_le_pow_left hq_ge_two (resDeg F L)
  set m : ℕ := qL F L - 1
  have hm_pos : 0 < m := by omega
  have hm_add_one : m + 1 = qL F L := by omega
  have hpm : ¬ p F ∣ m := by
    intro h_dvd
    have hp_dvd_qL : p F ∣ qL F L := by
      dsimp [qL]
      exact dvd_trans hp_dvd_q (dvd_pow_self (q F) hf_pos.ne')
    rw [← hm_add_one] at hp_dvd_qL
    exact hp.not_dvd_one ((Nat.dvd_add_right h_dvd).mp hp_dvd_qL)
  have h_res_m_ne : (m : 𝓀[F]) ≠ 0 := fun h_zero => hpm ((ringChar.spec 𝓀[F] m).mp h_zero)
  have h_unit_m : IsUnit (m : 𝒪[F]) := by
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit, map_natCast]
    exact h_res_m_ne
  obtain ⟨u_m, hu_m⟩ := h_unit_m
  have hm_inv_mul : algebraMap 𝒪[F] L (↑(u_m⁻¹) : 𝒪[F]) * (m : L) = 1 := by
    rw [← map_natCast (algebraMap 𝒪[F] L) m, ← map_mul, ← hu_m, Units.inv_mul, map_one]
  have hm_ne_L : (m : L) ≠ 0 := right_ne_zero_of_mul_eq_one hm_inv_mul
  have hm_inv_int : IsIntegral 𝒪[F] ((m : L)⁻¹) := by
    rw [inv_eq_of_mul_eq_one_left hm_inv_mul]
    exact isIntegral_algebraMap
  letI : Field (integralClosure 𝒪[F] L ⧸ Ideal.span {π₀}) :=
    Ideal.Quotient.field (Ideal.span {π₀})
  obtain ⟨g_res, hg_ord⟩ :=
    IsCyclic.exists_ofOrder_eq_natCard (α := (integralClosure 𝒪[F] L ⧸ Ideal.span {π₀})ˣ)
  have hcard_units : Nat.card (integralClosure 𝒪[F] L ⧸ Ideal.span {π₀})ˣ = m := by
    rw [Nat.card_eq_fintype_card, Fintype.card_units, hcard]
  rw [hcard_units] at hg_ord
  have hg_pow : (g_res : integralClosure 𝒪[F] L ⧸ Ideal.span {π₀}) ^ m = 1 := by
    rw [← Units.val_pow_eq_pow_val, ← hg_ord, pow_orderOf_eq_one, Units.val_one]
  obtain ⟨x₀, hx₀_mk⟩ :=
    Ideal.Quotient.mk_surjective (I := Ideal.span {π₀})
      (g_res : integralClosure 𝒪[F] L ⧸ Ideal.span {π₀})
  set u₀ : L := (x₀ : L)
  have hu₀_int : IsIntegral 𝒪[F] u₀ := x₀.2
  have hu₀_pow : divPowInt 1 (u₀ ^ m - 1) := by
    have h_mk_pow : Ideal.Quotient.mk (Ideal.span {π₀}) (x₀ ^ m) =
        Ideal.Quotient.mk (Ideal.span {π₀}) 1 := by
      rw [map_pow, hx₀_mk, hg_pow, map_one]
    have h_mem_I : x₀ ^ m - 1 ∈ Ideal.span {π₀} := Ideal.Quotient.eq.mp h_mk_pow
    rw [mem_I_iff] at h_mem_I
    change IsIntegral 𝒪[F] ((u₀ ^ m - 1) / πL ^ 1)
    rw [pow_one]
    exact h_mem_I
  have h_natCast_int : ∀ k : ℕ, IsIntegral 𝒪[F] (k : L) :=
    fun k => (integralClosure 𝒪[F] L).natCast_mem k
  have h_binom : ∀ (k : ℕ) (h : L), IsIntegral 𝒪[F] h →
      ∃ g : L, IsIntegral 𝒪[F] g ∧ (1 + h) ^ k = 1 + (k : L) * h + h ^ 2 * g := by
    intro k h hh
    induction k with
    | zero =>
      refine ⟨0, isIntegral_zero, ?_⟩
      simp
    | succ k ih =>
      obtain ⟨g, hg_int, hg_eq⟩ := ih
      refine ⟨(1 + h) * g + (k : L),
        ((isIntegral_one.add hh).mul hg_int).add (h_natCast_int k), ?_⟩
      rw [pow_succ', hg_eq]
      push_cast
      ring
  let step : L → L := fun u => u * (1 + -((m : L)⁻¹ * (u ^ m - 1)))
  let u_seq : ℕ → L := fun r => step^[r] u₀
  have hu_step : ∀ r : ℕ, u_seq (r + 1) = step (u_seq r) := fun r =>
    Function.iterate_succ_apply' step r u₀
  have hu_prop : ∀ r : ℕ,
      IsIntegral 𝒪[F] (u_seq r) ∧
      divPowInt (r + 1) ((u_seq r) ^ m - 1) ∧
      divPowInt (r + 1) (u_seq (r + 1) - u_seq r) := by
    intro r
    induction r with
    | zero =>
      have hu0 : u_seq 0 = u₀ := rfl
      rw [hu0]
      refine ⟨hu₀_int, hu₀_pow, ?_⟩
      rw [hu_step 0, hu0]
      set h := -((m : L)⁻¹ * (u₀ ^ m - 1))
      have hh_div : divPowInt 1 h := by
        have h1 := h_mul_int 1 hm_inv_int hu₀_pow
        have h2 := h_sub 1 (h_zero 1) h1
        rwa [zero_sub] at h2
      have h_diff : u₀ * (1 + h) - u₀ = u₀ * h := by ring
      rw [show step u₀ - u₀ = u₀ * h from h_diff]
      exact h_mul_int 1 hu₀_int hh_div
    | succ r ih =>
      obtain ⟨hur_int, hur_pow, _⟩ := ih
      set h := -((m : L)⁻¹ * ((u_seq r) ^ m - 1))
      have hh_div : divPowInt (r + 1) h := by
        have h1 := h_mul_int (r + 1) hm_inv_int hur_pow
        have h2 := h_sub (r + 1) (h_zero (r + 1)) h1
        rwa [zero_sub] at h2
      have hh_int : IsIntegral 𝒪[F] h := (h_div0 h).mp (h_mono (Nat.zero_le _) hh_div)
      have hur1_eq : u_seq (r + 1) = u_seq r * (1 + h) := hu_step r
      have hur1_int : IsIntegral 𝒪[F] (u_seq (r + 1)) := by
        rw [hur1_eq]
        exact hur_int.mul (isIntegral_one.add hh_int)
      obtain ⟨g, hg_int, hg_eq⟩ := h_binom m h hh_int
      have hum_eq : (u_seq r) ^ m = 1 - (m : L) * h := by
        dsimp [h]
        rw [mul_neg, ← mul_assoc, mul_inv_cancel₀ hm_ne_L, one_mul]
        ring
      have hur1_pow_eq : (u_seq (r + 1)) ^ m - 1 =
          ((1 - (m : L) * h) * g - (m : L) ^ 2) * (h * h) := by
        rw [hur1_eq, mul_pow, hum_eq, hg_eq]
        ring
      have h_factor_int : IsIntegral 𝒪[F] ((1 - (m : L) * h) * g - (m : L) ^ 2) :=
        ((isIntegral_one.sub ((h_natCast_int m).mul hh_int)).mul hg_int).sub
          ((h_natCast_int m).pow 2)
      have hh2_div : divPowInt ((r + 1) + (r + 1)) (h * h) :=
        h_mul_pow (r + 1) (r + 1) hh_div hh_div
      have hh2_div' : divPowInt (r + 2) (h * h) :=
        h_mono (by omega) hh2_div
      have hur1_pow_div : divPowInt (r + 2) ((u_seq (r + 1)) ^ m - 1) := by
        rw [hur1_pow_eq]
        exact h_mul_int (r + 2) h_factor_int hh2_div'
      refine ⟨hur1_int, hur1_pow_div, ?_⟩
      set h' := -((m : L)⁻¹ * ((u_seq (r + 1)) ^ m - 1))
      have hh'_div : divPowInt (r + 2) h' := by
        have h1 := h_mul_int (r + 2) hm_inv_int hur1_pow_div
        have h2 := h_sub (r + 2) (h_zero (r + 2)) h1
        rwa [zero_sub] at h2
      have h_diff : u_seq (r + 2) - u_seq (r + 1) = u_seq (r + 1) * h' := by
        rw [hu_step (r + 1)]
        change u_seq (r + 1) * (1 + h') - u_seq (r + 1) = u_seq (r + 1) * h'
        ring
      rw [h_diff]
      exact h_mul_int (r + 2) hur1_int hh'_div
  have hu_cauchy_hyp : ∀ m₀ r k : ℕ, m₀ ≤ r → divPowInt m₀ (u_seq (r + k) - u_seq r) := by
    intro m₀ r k hmr
    induction k with
    | zero =>
      simp [h_zero m₀]
    | succ k ih =>
      have h_step_k : divPowInt m₀ (u_seq (r + k + 1) - u_seq (r + k)) :=
        h_mono (by omega) (hu_prop (r + k)).2.2
      have h_sum := h_add m₀ h_step_k ih
      have h_alg : (u_seq (r + k + 1) - u_seq (r + k)) + (u_seq (r + k) - u_seq r) =
          u_seq (r + (k + 1)) - u_seq r := by
        rw [← Nat.add_assoc]
        ring
      rwa [h_alg] at h_sum
  obtain ⟨x_lim, hx_lim⟩ := h_cauchy u_seq hu_cauchy_hyp
  have hx_u0 : divPowInt 1 (x_lim - u₀) := by
    have h1 : divPowInt 1 (x_lim - u_seq 1) := hx_lim 1 1 (le_refl 1)
    have h2 : divPowInt 1 (u_seq 1 - u_seq 0) := (hu_prop 0).2.2
    have h3 := h_add 1 h1 h2
    have h_alg : (x_lim - u_seq 1) + (u_seq 1 - u_seq 0) = x_lim - u₀ := by
      change (x_lim - u_seq 1) + (u_seq 1 - u₀) = x_lim - u₀
      ring
    rwa [h_alg] at h3
  have hx_int : IsIntegral 𝒪[F] x_lim := by
    have h1 : IsIntegral 𝒪[F] (x_lim - u₀) := (h_div0 (x_lim - u₀)).mp (h_mono (Nat.zero_le 1) hx_u0)
    have h2 := h1.add hu₀_int
    rwa [sub_add_cancel] at h2
  have h_pow_sub : ∀ (k : ℕ) (a b : L), IsIntegral 𝒪[F] a → IsIntegral 𝒪[F] b →
      ∃ q_pol : L, IsIntegral 𝒪[F] q_pol ∧ a ^ k - b ^ k = q_pol * (a - b) := by
    intro k a b ha hb
    induction k with
    | zero =>
      refine ⟨0, isIntegral_zero, ?_⟩
      simp
    | succ k ih =>
      obtain ⟨q_pol, hq_int, hq_eq⟩ := ih
      refine ⟨a * q_pol + b ^ k, (ha.mul hq_int).add (hb.pow k), ?_⟩
      calc a ^ (k + 1) - b ^ (k + 1)
          = a * (a ^ k - b ^ k) + b ^ k * (a - b) := by ring
        _ = a * (q_pol * (a - b)) + b ^ k * (a - b) := by rw [hq_eq]
        _ = (a * q_pol + b ^ k) * (a - b) := by ring
  have hx_pow_one : x_lim ^ m = 1 := by
    have h_zero_xm1 : x_lim ^ m - 1 = 0 := by
      apply h_sep
      intro r
      obtain ⟨q_pol, hq_int, hq_eq⟩ := h_pow_sub m x_lim (u_seq r) hx_int (hu_prop r).1
      have h_diff_r : divPowInt r (x_lim - u_seq r) := hx_lim r r (le_refl r)
      have h_xm_urm : divPowInt r (x_lim ^ m - (u_seq r) ^ m) := by
        rw [hq_eq]
        exact h_mul_int r hq_int h_diff_r
      have h_urm_1 : divPowInt r ((u_seq r) ^ m - 1) :=
        h_mono (Nat.le_succ r) (hu_prop r).2.1
      have h_sum := h_add r h_xm_urm h_urm_1
      have h_alg : (x_lim ^ m - (u_seq r) ^ m) + ((u_seq r) ^ m - 1) = x_lim ^ m - 1 := by ring
      rwa [h_alg] at h_sum
    exact sub_eq_zero.mp h_zero_xm1
  let x_R : integralClosure 𝒪[F] L := ⟨x_lim, hx_int⟩
  have hx_R_res : Ideal.Quotient.mk (Ideal.span {π₀}) x_R =
      (g_res : integralClosure 𝒪[F] L ⧸ Ideal.span {π₀}) := by
    rw [← hx₀_mk]
    apply Ideal.Quotient.eq.mpr
    rw [mem_I_iff]
    change IsIntegral 𝒪[F] ((x_lim - u₀) / πL)
    have h1 := hx_u0
    change IsIntegral 𝒪[F] ((x_lim - u₀) / πL ^ 1) at h1
    rwa [pow_one] at h1
  have hx_R_prim : IsPrimitiveRoot x_R m := by
    rw [IsPrimitiveRoot.iff_def]
    refine ⟨Subtype.ext hx_pow_one, fun l hl => ?_⟩
    have h_gl : g_res ^ l = 1 := by
      apply Units.ext
      rw [Units.val_pow_eq_pow_val, Units.val_one, ← hx_R_res, ← map_pow, hl, map_one]
    rw [← hg_ord]
    exact orderOf_dvd_iff_pow_eq_one.mpr h_gl
  have hx_L_prim : IsPrimitiveRoot x_lim m :=
    hx_R_prim.map_of_injective (f := (integralClosure 𝒪[F] L).val) Subtype.val_injective
  set ζ₀ : AlgebraicClosure F := algebraMap L (AlgebraicClosure F) x_lim
  have hprim : IsPrimitiveRoot ζ₀ m :=
    hx_L_prim.map_of_injective (algebraMap L (AlgebraicClosure F)).injective
  have hζ₀_pow : ζ₀ ^ m = 1 := hprim.pow_eq_one
  have hζ₀_p' : IsPrimeToPRootOfUnity F ζ₀ := ⟨m, hm_pos, hpm, hζ₀_pow⟩
  have hw_ζ₀ : (w : AbsGal F) ζ₀ = ζ₀ := w.2.2 x_lim
  have h_eq := hn_w ζ₀ hζ₀_p'
  rw [hw_ζ₀] at h_eq
  have h_ncases := Int.natAbs_eq n_w
  generalize ha_def : n_w.natAbs = a at h_ncases
  have h_pow_a : ζ₀ ^ (q F ^ a) = ζ₀ := by
    rcases h_ncases with hn | hn
    · have h_lhs : (-n_w).toNat = 0 := by omega
      have h_rhs : n_w.toNat = a := by omega
      rw [h_lhs, h_rhs, pow_zero, pow_one] at h_eq
      exact h_eq.symm
    · have h_lhs : (-n_w).toNat = a := by omega
      have h_rhs : n_w.toNat = 0 := by omega
      rw [h_lhs, h_rhs, pow_zero, pow_one] at h_eq
      exact h_eq
  have h_pow_f : ζ₀ ^ (q F ^ resDeg F L) = ζ₀ := by
    change ζ₀ ^ qL F L = ζ₀
    rw [← hm_add_one, pow_succ, hζ₀_pow, one_mul]
  have h_pow_mul : ∀ c : ℕ, ζ₀ ^ (q F ^ (resDeg F L * c)) = ζ₀ := by
    intro c
    induction c with
    | zero =>
      rw [Nat.mul_zero, pow_zero, pow_one]
    | succ c ih =>
      rw [Nat.mul_succ, pow_add, pow_mul, ih, h_pow_f]
  have h_div_mod : resDeg F L * (a / resDeg F L) + a % resDeg F L = a :=
    Nat.div_add_mod a (resDeg F L)
  have hs_lt : a % resDeg F L < resDeg F L := Nat.mod_lt a hf_pos
  generalize hs_def : a % resDeg F L = s at h_div_mod hs_lt
  generalize hc_def : a / resDeg F L = c at h_div_mod
  have h_pow_s : ζ₀ ^ (q F ^ s) = ζ₀ := by
    calc ζ₀ ^ (q F ^ s) = (ζ₀ ^ (q F ^ (resDeg F L * c))) ^ (q F ^ s) := by rw [h_pow_mul c]
      _ = ζ₀ ^ (q F ^ (resDeg F L * c) * q F ^ s) := (pow_mul _ _ _).symm
      _ = ζ₀ ^ (q F ^ (resDeg F L * c + s)) := by rw [← pow_add]
      _ = ζ₀ ^ (q F ^ a) := by rw [h_div_mod]
      _ = ζ₀ := h_pow_a
  have hs_zero : s = 0 := by
    by_contra hs_ne
    have hs1 : 1 ≤ s := by omega
    have hqs_ge_two : 2 ≤ q F ^ s := by
      calc 2 = 2 ^ 1 := (pow_one 2).symm
        _ ≤ 2 ^ s := Nat.pow_le_pow_right (by omega) hs1
        _ ≤ q F ^ s := Nat.pow_le_pow_left hq_ge_two s
    have hqs_lt : q F ^ s < q F ^ resDeg F L :=
      Nat.pow_lt_pow_right (by omega) hs_lt
    have hqs_lt_qL : q F ^ s < qL F L := hqs_lt
    generalize hl_def : q F ^ s - 1 = l
    have hl_pos : l ≠ 0 := by omega
    have hl_lt : l < m := by omega
    have hl1 : l + 1 = q F ^ s := by omega
    have hζ₀_ne_zero : ζ₀ ≠ 0 := hprim.ne_zero hm_pos.ne'
    have h_pow_l : ζ₀ ^ l = 1 := by
      apply mul_right_cancel₀ hζ₀_ne_zero
      rw [← pow_succ, hl1, one_mul, h_pow_s]
    exact hprim.pow_ne_one_of_pos_of_lt hl_pos hl_lt h_pow_l
  have ha_eq : a = resDeg F L * c := by omega
  rcases h_ncases with hn | hn
  · refine ⟨-(c : ℤ), ?_⟩
    have h_exp : -((resDeg F L : ℤ) * -(c : ℤ)) = n_w := by
      rw [hn, ha_eq, Nat.cast_mul]
      ring
    rwa [h_exp]
  · refine ⟨(c : ℤ), ?_⟩
    have h_exp : -((resDeg F L : ℤ) * (c : ℤ)) = n_w := by
      rw [hn, ha_eq, Nat.cast_mul]
    rwa [h_exp]

theorem abelianExt_le_lubinTateExtension_sup_unramifiedClosure (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (h : L ≤ M)
    (hab : IsAbelianExt F h) :
    M ≤ lubinTateExtension F L (chosenUniformizer F L) ⊔ unramifiedClosure F :=
by
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion h).injective
  set m := Module.finrank F M
  have hm : 1 ≤ m := Nat.succ_le_of_lt (Module.finrank_pos (R := F) (M := M))
  have h_unram : unramDegSubfield F L m ≤ L ⊔ unramifiedClosure F := by
    have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab_ne : a * b ≠ 0 := mul_ne_zero ha hb
      simp only [addVal, ha, hb, hab_ne, ↓reduceDIte]
      rw [← neg_add, neg_inj, ← toAdd_mul]
      congr 1
      rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
        WithZero.coe_unzero, ← map_mul, ← map_mul]
    have addVal_one : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have h_eq := addVal_mul h1 h1
      rw [mul_one] at h_eq
      omega
    let addValHom : Fˣ →* Multiplicative ℤ :=
      { toFun := fun u => Multiplicative.ofAdd (addVal F u)
        map_one' := by simp [addVal_one]
        map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
    have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
      let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
        (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
      have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
          WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
        (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
      obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
      have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
          WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
        rw [ha]
        exact hg
      have ha0 : a ≠ 0 := by
        intro h0
        rw [h0, map_zero, map_zero] at h1
        exact WithZero.coe_ne_zero h1.symm
      refine ⟨Units.mk0 a ha0, ?_⟩
      simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
      have h2 : WithZero.unzero
          (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
          (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
      rw [h2, toAdd_ofAdd, neg_neg]
    have hres : 0 < resDeg F L := by
      obtain ⟨u, hu⟩ := exists_addVal_eq_one
      let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
      have hS : S.Nonempty := by
        refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L u,
          (map_ne_zero (algebraMap F L)).mpr u.ne_zero, ?_⟩
        have hnorm : Algebra.norm F (algebraMap F L (u : F)) = (u : F) ^ Module.finrank F L :=
          Algebra.norm_algebraMap (u : F)
        have hpow : addVal F ((u : F) ^ Module.finrank F L) =
            (Module.finrank F L : ℤ) * addVal F u := by
          change Multiplicative.toAdd (addValHom (u ^ Module.finrank F L)) = _
          rw [map_pow, toAdd_pow, nsmul_eq_mul]
          rfl
        rw [relVal, hnorm, hpow, hu, mul_one]
      exact (Nat.sInf_mem hS).1
    apply sup_le_sup_left
    rw [unramifiedClosure, IntermediateField.adjoin_le_iff]
    intro ζ hζ
    apply IntermediateField.subset_adjoin
    simp only [Set.mem_setOf_eq] at hζ ⊢
    haveI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
    haveI : CharP 𝓀[F] (p F) := by unfold p; infer_instance
    obtain ⟨d, hp, hq⟩ := FiniteField.card 𝓀[F] (p F)
    have hq' : q F = p F ^ (d : ℕ) := by
      rw [q, Nat.card_eq_fintype_card, hq]
    set k := (d : ℕ) * resDeg F L * m
    have hk_pos : 0 < k := Nat.mul_pos (Nat.mul_pos d.pos hres) (by omega)
    have hqLm : qL F L ^ m = p F ^ k := by
      dsimp [qL, k]
      rw [hq', ← pow_mul, ← pow_mul, mul_assoc]
    have hp_ge_two : 2 ≤ p F := hp.two_le
    have hpow_ge_two : 2 ≤ qL F L ^ m := by
      rw [hqLm]
      calc 2 = 2 ^ 1 := by ring
        _ ≤ 2 ^ k := Nat.pow_le_pow_right (by omega) hk_pos
        _ ≤ p F ^ k := Nat.pow_le_pow_left hp_ge_two k
    refine ⟨qL F L ^ m - 1, by omega, ?_, hζ⟩
    intro hdvd
    have hdvd_pow : p F ∣ qL F L ^ m := by
      rw [hqLm]
      exact dvd_pow_self (p F) (by omega)
    have hdvd_one : p F ∣ 1 := by
      have hsub := Nat.dvd_sub hdvd_pow hdvd
      have heq : qL F L ^ m - (qL F L ^ m - 1) = 1 := by omega
      rwa [heq] at hsub
    exact hp.not_dvd_one hdvd_one
  have h_split : M ≤ ltFixedSubfield F L M m ⊔ unramDegSubfield F L m :=
    le_ltFixedSubfield_sup_unramDegSubfield F L M h hab
  obtain ⟨n, _, h_fixed⟩ := exists_ltFixedSubfield_le_ltDivSubfield F L M h hab m hm
  have h_div : ltDivSubfield F L n ≤ lubinTateExtension F L (chosenUniformizer F L) := by
    unfold ltDivSubfield lubinTateExtension
    apply sup_le_sup_left
    rw [IntermediateField.adjoin_le_iff]
    intro α hα
    exact IntermediateField.subset_adjoin F _ ⟨n, hα⟩
  have h_unram' : unramDegSubfield F L m ≤
      lubinTateExtension F L (chosenUniformizer F L) ⊔ unramifiedClosure F :=
    le_trans h_unram (sup_le_sup_right le_sup_left _)
  exact le_trans h_split (sup_le (le_trans h_fixed (le_trans h_div le_sup_left)) h_unram')

theorem exists_rawRecMap_inv_mul_mem_lubinTateUnramField_fixingSubgroup (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (h : L ≤ M) :
    IsAbelianExt F h → ∀ (n m : ℕ), 1 ≤ n → 1 ≤ m → M ≤ lubinTateUnramField F L n m →
      ∀ σ : relWeil F M, ∃ y₀ : Mˣ,
        (rawRecMap F M y₀)⁻¹ * (σ : AbsGal F) ∈ (lubinTateUnramField F L n m).fixingSubgroup :=
by
  intro _hab n m hn hm hM σ
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion h).injective
  let K := lubinTateUnramField F L n m
  haveI : FiniteDimensional F K := finiteDimensional_lubinTateUnramField F L n m hm
  have hLK : L ≤ K := le_sup_left
  have hab_LK : IsAbelianExt F hLK := isAbelianExt_lubinTateUnramField F L n m hn hm
  have hab_MK : IsAbelianExt F hM := by
    have hfix : M.fixingSubgroup ≤ L.fixingSubgroup := IntermediateField.fixingSubgroup_le h
    refine ⟨fun σ' hσ' τ hτ => hab_LK.1 σ' (hfix hσ') τ hτ,
      fun σ' hσ' τ hτ => hab_LK.2.1 σ' (hfix hσ') τ (hfix hτ), ?_⟩
    haveI : Algebra.IsSeparable L (IntermediateField.extendScalars hLK) := hab_LK.2.2
    rw [Algebra.isSeparable_def]
    intro x
    let xL : IntermediateField.extendScalars hLK :=
      ⟨x.1, (IntermediateField.mem_extendScalars hLK).mpr
        ((IntermediateField.mem_extendScalars hM).mp x.2)⟩
    have hxL_sep : (minpoly L xL).Separable := Algebra.IsSeparable.isSeparable L xL
    let P : Polynomial M := (minpoly L xL).map (IntermediateField.inclusion h)
    have hP_sep : P.Separable := Polynomial.Separable.map hxL_sep
    have hP_aeval : Polynomial.aeval x P = 0 := by
      apply Subtype.ext
      change (IntermediateField.extendScalars hM).val (Polynomial.aeval x P) = 0
      rw [← Polynomial.aeval_algHom_apply (IntermediateField.extendScalars hM).val x P]
      have h0 : Polynomial.aeval ((IntermediateField.extendScalars hLK).val xL)
          (minpoly L xL) = 0 := by
        rw [Polynomial.aeval_algHom_apply, minpoly.aeval, map_zero]
      rw [← h0]
      simp only [P, Polynomial.aeval_def, Polynomial.eval₂_map]
      rfl
    exact Polynomial.Separable.of_dvd hP_sep (minpoly.dvd M x hP_aeval)
  obtain ⟨k, hk⟩ := relWeil_exists_actsAsFrobPow_mul_resDeg F M σ
  obtain ⟨u, hu, hu_LT⟩ :=
    exists_unit_rawRecMap_inv_mul_mem_lubinTateExtension_fixingSubgroup F M (σ : AbsGal F) σ.2.2
  let π_M := chosenUniformizer F M
  let y₀ : Mˣ := u * π_M ^ k
  refine ⟨y₀, ?_⟩
  obtain ⟨hy₀_val, hy₀_rel⟩ := valL_and_relVal_unit_mul_chosenUniformizer_zpow F M u k hu
  obtain ⟨_hy₀_mem, hy₀_frob⟩ := rawRecMap_actsAsFrobPow_and_mem_relWeil F M y₀
  rw [hy₀_rel] at hy₀_frob
  have hy₀_unram :
      (rawRecMap F M y₀)⁻¹ * (σ : AbsGal F) ∈ (unramifiedClosure F).fixingSubgroup := by
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    unfold unramifiedClosure at hz
    induction hz using IntermediateField.adjoin_induction with
    | mem ζ hζ =>
      rcases le_total 0 (-((resDeg F M : ℤ) * k)) with hn' | hn'
      · have hn0 : (- -((resDeg F M : ℤ) * k)).toNat = 0 := Int.toNat_of_nonpos (by omega)
        have h1 := hy₀_frob ζ hζ
        have h2 := hk ζ hζ
        rw [hn0, pow_zero, pow_one] at h1 h2
        change (rawRecMap F M y₀)⁻¹ ((σ : AbsGal F) ζ) = ζ
        rw [h2, ← h1]
        exact (rawRecMap F M y₀).symm_apply_apply ζ
      · have hn0 : (-((resDeg F M : ℤ) * k)).toNat = 0 := Int.toNat_of_nonpos hn'
        have hζ' : IsPrimeToPRootOfUnity F (((rawRecMap F M y₀)⁻¹ * (σ : AbsGal F)) ζ) := by
          rcases hζ with ⟨m₀, hm1, hm2, hm3⟩
          refine ⟨m₀, hm1, hm2, ?_⟩
          rw [← map_pow, hm3, map_one]
        have h1 := hy₀_frob (((rawRecMap F M y₀)⁻¹ * (σ : AbsGal F)) ζ) hζ'
        have h2 := hk ζ hζ
        rw [hn0, pow_zero, pow_one] at h1 h2
        have h3 : (rawRecMap F M y₀) (((rawRecMap F M y₀)⁻¹ * (σ : AbsGal F)) ζ) =
            (σ : AbsGal F) ζ := by
          change (rawRecMap F M y₀) ((rawRecMap F M y₀).symm ((σ : AbsGal F) ζ)) =
            (σ : AbsGal F) ζ
          exact (rawRecMap F M y₀).apply_symm_apply _
        rw [h3, h2] at h1
        exact h1.symm
    | algebraMap a => exact AlgEquiv.commutes _ a
    | add a b _ _ ha hb => rw [map_add, ha, hb]
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
    | inv a _ ha => rw [map_inv₀, ha]
  have hraw_eq : rawRecMap F M y₀ = rawRecMap F M u * (lubinTateFrob F M π_M) ^ k := by
    unfold rawRecMap
    have h_unif : y₀ * π_M ^ (1 - valL F M y₀) = u * π_M ^ (1 - valL F M u) := by
      change (u * π_M ^ k) * π_M ^ (1 - valL F M y₀) = u * π_M ^ (1 - valL F M u)
      rw [hy₀_val, hu, mul_assoc, ← zpow_add]
      congr 2
      ring
    have h_exp : valL F M y₀ - 1 = (valL F M u - 1) + k := by
      rw [hy₀_val, hu]
      ring
    rw [h_unif, h_exp, zpow_add, mul_assoc]
  have hy₀_LT : (rawRecMap F M y₀)⁻¹ * (σ : AbsGal F) ∈
      (lubinTateExtension F M π_M).fixingSubgroup := by
    rw [hraw_eq, mul_inv_rev, mul_assoc]
    exact Subgroup.mul_mem _
      (Subgroup.inv_mem _ (Subgroup.zpow_mem _
        (lubinTateFrob_chosenUniformizer_mem_fixingSubgroup F M) k))
      hu_LT
  have hy₀_sup : (rawRecMap F M y₀)⁻¹ * (σ : AbsGal F) ∈
      (lubinTateExtension F M π_M ⊔ unramifiedClosure F).fixingSubgroup := by
    rw [IntermediateField.fixingSubgroup_sup]
    exact ⟨hy₀_LT, hy₀_unram⟩
  exact IntermediateField.fixingSubgroup_le
    (abelianExt_le_lubinTateExtension_sup_unramifiedClosure F M K hM hab_MK) hy₀_sup

theorem rawRecMap_inv_mul_normLM_mul_mem_lubinTateUnramField_fixingSubgroup (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (h : L ≤ M) :
    IsAbelianExt F h → ∀ (n m : ℕ), 1 ≤ n → 1 ≤ m → M ≤ lubinTateUnramField F L n m →
      ∀ (y₀ : Mˣ) (z : Lˣ),
        (rawRecMap F L (Units.map (normLM F h) y₀ * z))⁻¹ *
          (rawRecMap F M y₀ * rawRecMap F L z) ∈ (lubinTateUnramField F L n m).fixingSubgroup :=
by
  intro hab n m _hn hm _hM y₀ z
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion h).injective
  let e : M ≃ₐ[F] IntermediateField.extendScalars h := {
    toFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars h).mpr y.2⟩
    invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars h).mp y.2⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl
    map_mul' := fun _ _ => rfl
    map_add' := fun _ _ => rfl
    commutes' := fun _ => rfl
  }
  haveI : FiniteDimensional F (IntermediateField.extendScalars h) :=
    Module.Finite.equiv e.toLinearEquiv
  haveI : FiniteDimensional L (IntermediateField.extendScalars h) :=
    FiniteDimensional.right F L (IntermediateField.extendScalars h)
  let w₀ : Lˣ := Units.map (normLM F h) y₀
  have hw₀ : normLM F h (y₀ : M) = (w₀ : L) := rfl
  have h_relVal_w₀ : relVal F L (w₀ : L) = relVal F M (y₀ : M) := by
    change addVal F (Algebra.norm F (w₀ : L)) = addVal F (Algebra.norm F (y₀ : M))
    congr 1
    calc Algebra.norm F (w₀ : L)
      _ = Algebra.norm F (Algebra.norm L (e (y₀ : M))) := rfl
      _ = Algebra.norm F (e (y₀ : M)) := Algebra.norm_norm
      _ = Algebra.norm F (y₀ : M) := Algebra.norm_eq_of_algEquiv e (y₀ : M)
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab_ne : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab_ne, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have h_relVal_wz : relVal F L ((w₀ * z : Lˣ) : L) = relVal F M (y₀ : M) + relVal F L (z : L) := by
    have hw₀_norm_ne : Algebra.norm F (w₀ : L) ≠ 0 :=
      (w₀.isUnit.map (Algebra.norm F)).ne_zero
    have hz_norm_ne : Algebra.norm F (z : L) ≠ 0 :=
      (z.isUnit.map (Algebra.norm F)).ne_zero
    have hmul : relVal F L ((w₀ * z : Lˣ) : L) = relVal F L (w₀ : L) + relVal F L (z : L) := by
      unfold relVal
      rw [Units.val_mul, map_mul, addVal_mul hw₀_norm_ne hz_norm_ne]
    rw [hmul, h_relVal_w₀]
  have hres : 0 < resDeg F L := by
    by_contra hle
    have h0 : resDeg F L = 0 := by omega
    have hu0 : valL F L ((1 : Lˣ) : L) = 0 := by
      unfold valL
      rw [h0, Nat.cast_zero, Int.ediv_zero]
    have h1 := (valL_and_relVal_unit_mul_chosenUniformizer_zpow F L 1 1 hu0).1
    unfold valL at h1
    rw [h0, Nat.cast_zero, Int.ediv_zero] at h1
    omega
  haveI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  haveI : CharP 𝓀[F] (p F) := by unfold p; infer_instance
  obtain ⟨d, hp, hq⟩ := FiniteField.card 𝓀[F] (p F)
  have hq' : q F = p F ^ (d : ℕ) := by
    rw [q, Nat.card_eq_fintype_card, hq]
  have hp_ge_two : 2 ≤ p F := hp.two_le
  have hqL_ge_two : 2 ≤ qL F L := by
    dsimp [qL]
    rw [hq', ← pow_mul]
    have hpos : 0 < (d : ℕ) * resDeg F L := Nat.mul_pos d.pos hres
    calc 2 = 2 ^ 1 := by ring
      _ ≤ 2 ^ ((d : ℕ) * resDeg F L) := Nat.pow_le_pow_right (by omega) hpos
      _ ≤ p F ^ ((d : ℕ) * resDeg F L) := Nat.pow_le_pow_left hp_ge_two _
  let N := qL F L ^ m - 1
  have hqLm_ge_two : 2 ≤ qL F L ^ m := by
    calc 2 = 2 ^ 1 := by ring
      _ ≤ 2 ^ m := Nat.pow_le_pow_right (by omega) hm
      _ ≤ qL F L ^ m := Nat.pow_le_pow_left hqL_ge_two m
  have hN_pos : 0 < N := by omega
  have hpN : ¬ p F ∣ N := by
    intro hdvd
    have hdvd_pow : p F ∣ qL F L ^ m := by
      dsimp [qL]
      rw [hq', ← pow_mul, ← pow_mul]
      have hk_pos : 0 < (d : ℕ) * (resDeg F L * m) :=
        Nat.mul_pos d.pos (Nat.mul_pos hres (by omega))
      exact dvd_pow_self (p F) hk_pos.ne'
    have hdvd_one : p F ∣ 1 := by
      have hsub := Nat.dvd_sub hdvd_pow hdvd
      have heq : qL F L ^ m - N = 1 := by omega
      rwa [heq] at hsub
    exact hp.not_dvd_one hdvd_one
  obtain ⟨hmem_wz, hfrob_wz⟩ := rawRecMap_actsAsFrobPow_and_mem_relWeil F L (w₀ * z)
  obtain ⟨hmem_y₀, hfrob_y₀⟩ := rawRecMap_actsAsFrobPow_and_mem_relWeil F M y₀
  obtain ⟨hmem_z, hfrob_z⟩ := rawRecMap_actsAsFrobPow_and_mem_relWeil F L z
  set σ := rawRecMap F L (w₀ * z)
  set τ := rawRecMap F M y₀ * rawRecMap F L z
  set k := -relVal F L ((w₀ * z : Lˣ) : L)
  have hτ_k : ActsAsFrobPow F τ k := by
    have hmul_frob := (actsAsFrobPow_mul_and_zpow F).1
      (rawRecMap F M y₀) (rawRecMap F L z) (-relVal F M (y₀ : M)) (-relVal F L (z : L))
      hfrob_y₀ hfrob_z
    have hk_eq : -relVal F M (y₀ : M) + -relVal F L (z : L) = k := by
      change -relVal F M (y₀ : M) + -relVal F L (z : L) = -relVal F L ((w₀ * z : Lˣ) : L)
      rw [h_relVal_wz, neg_add]
    rwa [hk_eq] at hmul_frob
  have h_apply_p' : ∀ (γ : AbsGal F) {ζ : AlgebraicClosure F},
      IsPrimeToPRootOfUnity F ζ → IsPrimeToPRootOfUnity F (γ ζ) := by
    intro γ ζ ⟨r, hr, hpr, hζr⟩
    exact ⟨r, hr, hpr, by rw [← map_pow, hζr, map_one]⟩
  let π_L := chosenUniformizer F L
  have hisRoot_apply : ∀ {γ : AbsGal F}, γ ∈ L.fixingSubgroup →
      ∀ {β : AlgebraicClosure F}, isLubinTateRoot F L π_L n β → isLubinTateRoot F L π_L n (γ β) := by
    intro γ hγ β hβ
    have hγπ : γ ((π_L : L) : AlgebraicClosure F) = ((π_L : L) : AlgebraicClosure F) :=
      (IntermediateField.mem_fixingSubgroup_iff L γ).mp hγ (π_L : L) (π_L : L).2
    let g : AlgebraicClosure F → AlgebraicClosure F :=
      fun w => ((π_L : L) : AlgebraicClosure F) * w + w ^ qL F L
    have hsc : Function.Semiconj γ g g := by
      intro w
      dsimp [g]
      rw [map_add, map_mul, map_pow, hγπ]
    have hiter : γ (g^[n] β) = g^[n] (γ β) := (hsc.iterate_right n) β
    change g^[n] (γ β) = 0
    have hβ' : g^[n] β = 0 := hβ
    rw [← hiter, hβ', map_zero]
  unfold lubinTateUnramField
  rw [IntermediateField.fixingSubgroup_sup, Subgroup.mem_inf]
  refine ⟨?_, ?_⟩
  · refine Subgroup.mul_mem _ (Subgroup.inv_mem _ hmem_wz.2) ?_
    exact Subgroup.mul_mem _ (IntermediateField.fixingSubgroup_le h hmem_y₀.2) hmem_z.2
  · rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    induction hx using IntermediateField.adjoin_induction with
    | mem x hx =>
      rcases hx with hα | hζ
      · change (σ⁻¹ * τ) x = x
        rw [AlgEquiv.mul_apply]
        let α' := rawRecMap F L z x
        have hα' : isLubinTateRoot F L π_L n α' := hisRoot_apply hmem_z.2 hα
        have hσx : σ x = rawRecMap F L w₀ α' :=
          rawRecMap_mul_apply_isLubinTateRoot F L w₀ z n x hα
        have hτx : τ x = rawRecMap F L w₀ α' := by
          change rawRecMap F M y₀ α' = rawRecMap F L w₀ α'
          exact (rawRecMap_normLM_apply_isLubinTateRoot F L M h hab w₀ y₀ hw₀ n α' hα').symm
        rw [hτx, ← hσx]
        exact AlgEquiv.symm_apply_apply σ x
      · have hζ_p : IsPrimeToPRootOfUnity F x := ⟨N, hN_pos, hpN, hζ⟩
        change (σ⁻¹ * τ) x = x
        rw [AlgEquiv.mul_apply]
        rcases le_total 0 k with hk | hk
        · have hk' : (-k).toNat = 0 := by omega
          have h1 := hfrob_wz x hζ_p
          have h2 := hτ_k x hζ_p
          rw [hk', pow_zero, pow_one] at h1 h2
          rw [h2, ← h1]
          exact AlgEquiv.symm_apply_apply σ x
        · have hk' : k.toNat = 0 := by omega
          have h1 := hτ_k x hζ_p
          have h2 := hfrob_wz (σ⁻¹ (τ x)) (h_apply_p' σ⁻¹ (h_apply_p' τ hζ_p))
          have happly : σ (σ⁻¹ (τ x)) = τ x := AlgEquiv.apply_symm_apply σ (τ x)
          rw [hk', pow_zero, pow_one] at h1
          rw [happly, hk', pow_zero, pow_one] at h2
          rw [← h2, h1]
    | algebraMap r => exact AlgEquiv.commutes _ r
    | add a b _ _ ha hb => rw [map_add, ha, hb]
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
    | inv a _ ha => rw [map_inv₀, ha]

theorem exists_eq_mul_of_actsAsFrobPow_and_fix_rootsOfUnity (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (m : ℕ) :
    1 ≤ m → ∀ (r : ℤ) (σ : AbsGal F),
      ActsAsFrobPow F σ (-((resDeg F L : ℤ) * r)) →
      (∀ ζ : AlgebraicClosure F, ζ ^ (qL F L ^ m - 1) = 1 → σ ζ = ζ) →
      ∃ k : ℤ, r = (m : ℤ) * k :=
by
  intro hm r σ hfrob hfix
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab_ne : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab_ne, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h_eq := addVal_mul h1 h1
    rw [mul_one] at h_eq
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have hres : 0 < resDeg F L := by
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L u,
        (map_ne_zero (algebraMap F L)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (u : F)) = (u : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (u : F)
      have hpow : addVal F ((u : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F u := by
        change Multiplicative.toAdd (addValHom (u ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu, mul_one]
    exact (Nat.sInf_mem hS).1
  haveI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  haveI : CharP 𝓀[F] (p F) := by unfold p; infer_instance
  obtain ⟨d, hp, hq⟩ := FiniteField.card 𝓀[F] (p F)
  have hq' : q F = p F ^ (d : ℕ) := by
    rw [q, Nat.card_eq_fintype_card, hq]
  have hp_ge_two : 2 ≤ p F := hp.two_le
  have hqL_ge_two : 2 ≤ qL F L := by
    dsimp [qL]
    rw [hq', ← pow_mul]
    have hpos : 0 < (d : ℕ) * resDeg F L := Nat.mul_pos d.pos hres
    calc 2 = 2 ^ 1 := by ring
      _ ≤ 2 ^ ((d : ℕ) * resDeg F L) := Nat.pow_le_pow_right (by omega) hpos
      _ ≤ p F ^ ((d : ℕ) * resDeg F L) := Nat.pow_le_pow_left hp_ge_two _
  generalize hN_def : qL F L ^ m - 1 = N
  have hqLm_ge_two : 2 ≤ qL F L ^ m := by
    calc 2 = 2 ^ 1 := by ring
      _ ≤ 2 ^ m := Nat.pow_le_pow_right (by omega) hm
      _ ≤ qL F L ^ m := Nat.pow_le_pow_left hqL_ge_two m
  have hN_pos : 0 < N := by omega
  have hpN : ¬ p F ∣ N := by
    intro hdvd
    have hdvd_pow : p F ∣ qL F L ^ m := by
      dsimp [qL]
      rw [hq', ← pow_mul, ← pow_mul]
      have hk_pos : 0 < (d : ℕ) * (resDeg F L * m) :=
        Nat.mul_pos d.pos (Nat.mul_pos hres (by omega))
      exact dvd_pow_self (p F) hk_pos.ne'
    have hdvd_one : p F ∣ 1 := by
      have hsub := Nat.dvd_sub hdvd_pow hdvd
      have heq : qL F L ^ m - N = 1 := by omega
      rwa [heq] at hsub
    exact hp.not_dvd_one hdvd_one
  have hNF : (N : F) ≠ 0 := by
    intro h0
    have h0' : (N : 𝒪[F]) = 0 := Subtype.ext h0
    have hres_N : (N : 𝓀[F]) = 0 := by
      rw [← map_natCast (IsLocalRing.residue 𝒪[F]) N, h0', map_zero]
    exact hpN ((ringChar.spec 𝓀[F] N).mp hres_N)
  haveI : NeZero (N : F) := ⟨hNF⟩
  haveI : NeZero N := ⟨hN_pos.ne'⟩
  haveI : HasEnoughRootsOfUnity (AlgebraicClosure F) N :=
    AlgebraicClosure.hasEnoughRootsOfUnity F N
  obtain ⟨ζ₀, hprim⟩ := HasEnoughRootsOfUnity.prim (M := AlgebraicClosure F) (n := N)
  have hζ₀_pow : ζ₀ ^ N = 1 := hprim.pow_eq_one
  have hσζ₀ : σ ζ₀ = ζ₀ := hfix ζ₀ (by rwa [hN_def])
  have hζ₀_p' : IsPrimeToPRootOfUnity F ζ₀ := ⟨N, hN_pos, hpN, hζ₀_pow⟩
  have h_eq := hfrob ζ₀ hζ₀_p'
  rw [hσζ₀, neg_neg] at h_eq
  have h_rcases := Int.natAbs_eq r
  generalize ha_def : r.natAbs = a at h_rcases
  have h_pow_a : ζ₀ ^ (qL F L ^ a) = ζ₀ := by
    rcases h_rcases with hr | hr
    · have h_lhs : ((resDeg F L : ℤ) * r).toNat = resDeg F L * a := by
        rw [hr, ← Nat.cast_mul, Int.toNat_natCast]
      have h_rhs : (-((resDeg F L : ℤ) * r)).toNat = 0 := by
        rw [hr, ← Nat.cast_mul]
        omega
      rw [h_lhs, h_rhs, pow_zero, pow_one, pow_mul] at h_eq
      exact h_eq
    · have h_lhs : ((resDeg F L : ℤ) * r).toNat = 0 := by
        rw [hr, mul_neg, ← Nat.cast_mul]
        omega
      have h_rhs : (-((resDeg F L : ℤ) * r)).toNat = resDeg F L * a := by
        rw [hr, mul_neg, neg_neg, ← Nat.cast_mul, Int.toNat_natCast]
      rw [h_lhs, h_rhs, pow_zero, pow_one, pow_mul] at h_eq
      exact h_eq.symm
  have hN1 : N + 1 = qL F L ^ m := by omega
  have h_pow_m : ζ₀ ^ (qL F L ^ m) = ζ₀ := by
    rw [← hN1, pow_succ, hζ₀_pow, one_mul]
  have h_pow_mul : ∀ c : ℕ, ζ₀ ^ (qL F L ^ (m * c)) = ζ₀ := by
    intro c
    induction c with
    | zero =>
      rw [Nat.mul_zero, pow_zero, pow_one]
    | succ c ih =>
      rw [Nat.mul_succ, pow_add, pow_mul, ih, h_pow_m]
  have h_div_mod : m * (a / m) + a % m = a := Nat.div_add_mod a m
  have hs_lt : a % m < m := Nat.mod_lt a (by omega)
  generalize hs_def : a % m = s at h_div_mod hs_lt
  generalize hc_def : a / m = c at h_div_mod
  have h_pow_s : ζ₀ ^ (qL F L ^ s) = ζ₀ := by
    calc ζ₀ ^ (qL F L ^ s) = (ζ₀ ^ (qL F L ^ (m * c))) ^ (qL F L ^ s) := by rw [h_pow_mul c]
      _ = ζ₀ ^ (qL F L ^ (m * c) * qL F L ^ s) := (pow_mul _ _ _).symm
      _ = ζ₀ ^ (qL F L ^ (m * c + s)) := by rw [← pow_add]
      _ = ζ₀ ^ (qL F L ^ a) := by rw [h_div_mod]
      _ = ζ₀ := h_pow_a
  have hs_zero : s = 0 := by
    by_contra hs_ne
    have hs1 : 1 ≤ s := by omega
    have hqLs_ge_two : 2 ≤ qL F L ^ s := by
      calc 2 = 2 ^ 1 := by ring
        _ ≤ 2 ^ s := Nat.pow_le_pow_right (by omega) hs1
        _ ≤ qL F L ^ s := Nat.pow_le_pow_left hqL_ge_two s
    have hqLs_lt : qL F L ^ s < qL F L ^ m :=
      Nat.pow_lt_pow_right (by omega) hs_lt
    generalize hl_def : qL F L ^ s - 1 = l
    have hl_pos : l ≠ 0 := by omega
    have hl_lt : l < N := by omega
    have hl1 : l + 1 = qL F L ^ s := by omega
    have hζ₀_ne_zero : ζ₀ ≠ 0 := hprim.ne_zero hN_pos.ne'
    have h_pow_l : ζ₀ ^ l = 1 := by
      apply mul_right_cancel₀ hζ₀_ne_zero
      rw [← pow_succ, hl1, one_mul, h_pow_s]
    exact hprim.pow_ne_one_of_pos_of_lt hl_pos hl_lt h_pow_l
  have ha_eq : a = m * c := by omega
  rcases h_rcases with hr | hr
  · refine ⟨(c : ℤ), ?_⟩
    rw [hr, ha_eq, Nat.cast_mul]
  · refine ⟨-(c : ℤ), ?_⟩
    rw [hr, ha_eq, Nat.cast_mul, mul_neg]

theorem mul_chosenUniformizer_zpow_neg_valL_mem_unitGroup_of_fix_isLubinTateRoot (F : Type u)
    [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (n : ℕ) :
    1 ≤ n → ∀ z : Lˣ,
      (∀ α : AlgebraicClosure F,
        isLubinTateRoot F L (chosenUniformizer F L) n α → rawRecMap F L z α = α) →
      z * (chosenUniformizer F L) ^ (-valL F L z) ∈ unitGroup F L n :=
by
  intro hn z hz_fix
  let π := chosenUniformizer F L
  let u : Lˣ := z * π ^ (-valL F L z)
  obtain ⟨hπ, -⟩ := valL_chosenUniformizer_and_mul_zpow F L z
  have hres_ne : resDeg F L ≠ 0 := by
    intro h0
    have h1 : valL F L π = 1 := hπ
    rw [valL, h0, Nat.cast_zero, Int.ediv_zero] at h1
    omega
  have hf_ne : (resDeg F L : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr hres_ne
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun v => Multiplicative.ofAdd (addVal F v)
      map_one' := by simp [addVal_one]
      map_mul' := fun v w => by simp [addVal_mul v.ne_zero w.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ v : Lˣ, Multiplicative.toAdd (relValHom v) = relVal F L v :=
    fun _ => rfl
  have relVal_units_mul : ∀ v w : Lˣ,
      relVal F L ((v * w : Lˣ) : L) = relVal F L v + relVal F L w := by
    intro v w
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (v : Lˣ) (k : ℤ),
      relVal F L ((v ^ k : Lˣ) : L) = k * relVal F L v := by
    intro v k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have valL_units_mul : ∀ v w : Lˣ,
      valL F L ((v * w : Lˣ) : L) = valL F L v + valL F L w := by
    intro v w
    have hrel := relVal_eq_resDeg_mul_valL F L (v * w)
    rw [relVal_units_mul, relVal_eq_resDeg_mul_valL F L v,
      relVal_eq_resDeg_mul_valL F L w] at hrel
    apply mul_left_cancel₀ hf_ne
    linarith
  have valL_units_zpow : ∀ (v : Lˣ) (k : ℤ),
      valL F L ((v ^ k : Lˣ) : L) = k * valL F L v := by
    intro v k
    have hrel := relVal_eq_resDeg_mul_valL F L (v ^ k)
    rw [relVal_units_zpow, relVal_eq_resDeg_mul_valL F L v] at hrel
    apply mul_left_cancel₀ hf_ne
    linarith
  have hu_val : valL F L u = 0 := by
    change valL F L ((z * π ^ (-valL F L z) : Lˣ) : L) = 0
    rw [valL_units_mul, valL_units_zpow, hπ]
    ring
  have h1_val : valL F L (1 : Lˣ) = 0 := by
    have h := valL_units_zpow π 0
    simp only [zpow_zero, zero_mul] at h
    exact h
  have hshift_eq : z * π ^ (1 - valL F L z) = u * π := by
    have hexp : (1 - valL F L z : ℤ) = -valL F L z + 1 := by ring
    change z * π ^ (1 - valL F L z) = (z * π ^ (-valL F L z)) * π
    rw [hexp, zpow_add, zpow_one, mul_assoc]
  have hu_relVal : 0 ≤ relVal F L (u : L) := by
    rw [relVal_eq_resDeg_mul_valL F L u, hu_val, mul_zero]
  have hu_int : IsIntegral 𝒪[F] (u : L) :=
    (isIntegral_iff_eq_zero_or_relVal_nonneg F L (u : L)).mpr (Or.inr hu_relVal)
  have hu_sub_int : IsIntegral 𝒪[F] ((u : L) - 1) :=
    IsIntegral.sub hu_int isIntegral_one
  have hu_sub_val_nonneg : (u : L) ≠ 1 → 0 ≤ valL F L ((u : L) - 1) := by
    intro hne
    have hsub_ne : (u : L) - 1 ≠ 0 := sub_ne_zero.mpr hne
    rcases (isIntegral_iff_eq_zero_or_relVal_nonneg F L ((u : L) - 1)).mp hu_sub_int with h0 | hrel
    · exact absurd h0 hsub_ne
    · exact Int.ediv_nonneg hrel (by omega)
  obtain ⟨τ, hτL, hτFrob⟩ := exists_actsAsFrobPow_neg_resDeg F L
  have hspec_π : IsLubinTateFrob F L π (lubinTateFrob F L π) :=
    Classical.epsilon_spec (exists_isLubinTateFrob_of_frobLift F L π hπ τ hτL hτFrob)
  have hfix_π : ∀ {β : AlgebraicClosure F}, isLubinTateRoot F L π n β →
      lubinTateFrob F L π β = β :=
    fun hβ => hspec_π.2.2 n _ hβ
  have hfix_π_nat : ∀ (m : ℕ) {β : AlgebraicClosure F}, isLubinTateRoot F L π n β →
      ((lubinTateFrob F L π) ^ m) β = β := by
    intro m
    induction m with
    | zero =>
      intro β _
      rfl
    | succ m ih =>
      intro β hβ
      rw [pow_succ', AlgEquiv.mul_apply, ih hβ, hfix_π hβ]
  have hfix_π_zpow : ∀ (k : ℤ) {β : AlgebraicClosure F}, isLubinTateRoot F L π n β →
      ((lubinTateFrob F L π) ^ k) β = β := by
    intro k β hβ
    cases k with
    | ofNat m =>
      change ((lubinTateFrob F L π) ^ (m : ℤ)) β = β
      rw [zpow_natCast]
      exact hfix_π_nat m hβ
    | negSucc m =>
      change (((lubinTateFrob F L π) ^ (m + 1))⁻¹) β = β
      have hm := hfix_π_nat (m + 1) hβ
      have hinv : (((lubinTateFrob F L π) ^ (m + 1))⁻¹)
          (((lubinTateFrob F L π) ^ (m + 1)) β) = β :=
        AlgEquiv.symm_apply_apply ((lubinTateFrob F L π) ^ (m + 1)) β
      rw [hm] at hinv
      exact hinv
  have hraw_eq : ∀ {β : AlgebraicClosure F}, isLubinTateRoot F L π n β →
      rawRecMap F L z β = lubinTateFrob F L (u * π) β := by
    intro β hβ
    change (lubinTateFrob F L (z * π ^ (1 - valL F L z)) *
      (lubinTateFrob F L π) ^ (valL F L z - 1)) β = _
    rw [AlgEquiv.mul_apply, hfix_π_zpow (valL F L z - 1) hβ, hshift_eq]
  set D : Polynomial L :=
    lubinTateEndoPoly F L (π : L) (u : L) n - lubinTateEndoPoly F L (π : L) 1 n
  have haeval_D : ∀ {α : AlgebraicClosure F}, isLubinTateRoot F L π n α →
      Polynomial.aeval α D = 0 := by
    intro α hα
    have haeval_u : Polynomial.aeval α (lubinTateEndoPoly F L (π : L) (u : L) n) = α := by
      rw [← lubinTateFrob_unit_mul_chosenUniformizer_apply_isLubinTateRoot F L u hu_val n α hα,
        ← hraw_eq hα, hz_fix α hα]
    have haeval_1 : Polynomial.aeval α (lubinTateEndoPoly F L (π : L) 1 n) = α := by
      change Polynomial.aeval α (lubinTateEndoPoly F L (π : L) ((1 : Lˣ) : L) n) = α
      rw [← lubinTateFrob_unit_mul_chosenUniformizer_apply_isLubinTateRoot F L 1 h1_val n α hα,
        one_mul]
      exact hfix_π hα
    change Polynomial.aeval α
      (lubinTateEndoPoly F L (π : L) (u : L) n - lubinTateEndoPoly F L (π : L) 1 n) = 0
    rw [map_sub, haeval_u, haeval_1, sub_self]
  obtain ⟨hf_monic, -, hf_irr⟩ :=
    lubinTateDivPoly_monic_coeff_zero_and_irreducible F L π hπ n hn
  set f_n : Polynomial L := lubinTateDivPoly F L (π : L) n
  set g_n : Polynomial L := lubinTateIterPoly F L (π : L) n
  obtain ⟨π_n, hπ_aeval⟩ :=
    IsAlgClosed.exists_aeval_eq_zero (AlgebraicClosure F) f_n hf_irr.degree_pos.ne'
  have hq_gt : 1 < q F := Finite.one_lt_card
  have hqL_gt : 1 < qL F L := one_lt_pow₀ hq_gt hres_ne
  have hn_eq : n = (n - 1) + 1 := (Nat.sub_add_cancel hn).symm
  have hqL_sub : (qL F L - 1) + 1 = qL F L := Nat.sub_add_cancel (by omega)
  have h_gn_eq : g_n = lubinTateIterPoly F L (π : L) (n - 1) * f_n := by
    change lubinTateIterPoly F L (π : L) n =
      lubinTateIterPoly F L (π : L) (n - 1) *
        ((lubinTateIterPoly F L (π : L) (n - 1)) ^ (qL F L - 1) + Polynomial.C (π : L))
    conv_lhs => rw [hn_eq]
    change (Polynomial.C (π : L) * Polynomial.X + Polynomial.X ^ qL F L).comp
      (lubinTateIterPoly F L (π : L) (n - 1)) = _
    rw [Polynomial.add_comp, Polynomial.mul_comp, Polynomial.C_comp, Polynomial.X_comp,
      Polynomial.pow_comp, Polynomial.X_comp]
    conv_lhs => rw [← hqL_sub, pow_succ']
    ring
  have hπ_gn : Polynomial.aeval π_n g_n = 0 := by
    rw [h_gn_eq, map_mul, hπ_aeval, mul_zero]
  have hπ_root : isLubinTateRoot F L π n π_n :=
    ((lubinTateIterPoly_monic_and_aeval_eq_zero_iff F L π n).2 π_n).mp hπ_gn
  have hπ_D : Polynomial.aeval π_n D = 0 := haeval_D hπ_root
  have h_minpoly : minpoly L π_n = f_n :=
    (minpoly.eq_of_irreducible_of_monic hf_irr hπ_aeval hf_monic).symm
  have h_dvd : f_n ∣ D := by
    rw [← h_minpoly]
    exact minpoly.dvd L π_n hπ_D
  change u ∈ unitGroup F L n
  unfold unitGroup
  apply Subgroup.subset_closure
  simp only [Set.mem_setOf_eq, if_neg (by omega : n ≠ 0)]
  by_contra h_not
  push_neg at h_not
  obtain ⟨hne, hval_lt⟩ := h_not
  have hval_nonneg : 0 ≤ valL F L ((u : L) - 1) := hu_sub_val_nonneg hne
  set k : ℕ := (valL F L ((u : L) - 1)).toNat
  have hk_val : valL F L ((u : L) - 1) = (k : ℤ) := (Int.toNat_of_nonneg hval_nonneg).symm
  have hk_lt : k < n := by omega
  have hu_nonneg : (u : L) = 0 ∨ 0 ≤ valL F L (u : L) := Or.inr (by omega)
  have h1_nonneg : (1 : L) = 0 ∨ 0 ≤ valL F L (1 : L) :=
    Or.inr (by change 0 ≤ valL F L ((1 : Lˣ) : L); omega)
  obtain ⟨hD0, hDc0, hD_lt, hD_eq⟩ :=
    lubinTateEndoPoly_sub_coeff_valL_staircase F L π hπ n (u : L) 1
      hu_nonneg h1_nonneg hne k hk_lt hk_val
  set M : ℕ := (qL F L) ^ k
  have hM_pos : 1 ≤ M := Nat.one_le_pow k (qL F L) (by omega)
  have hM_le : M ≤ (qL F L) ^ (n - 1) := Nat.pow_le_pow_right (by omega) (by omega)
  have h_not_dvd : ¬ (f_n ∣ D) :=
    not_lubinTateDivPoly_dvd_of_valL_coeff_eq_zero F L π hπ n hn D
      hD0 hDc0 M hM_pos hM_le hD_lt hD_eq
  exact h_not_dvd h_dvd

theorem exists_normLM_mul_of_rawRecMap_mem_fixingSubgroup (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (h : L ≤ M) :
    IsAbelianExt F h → ∀ (n m : ℕ), 1 ≤ n → 1 ≤ m → M ≤ lubinTateUnramField F L n m →
      ∀ x : Lˣ, rawRecMap F L x ∈ M.fixingSubgroup →
        ∃ (y : M) (u : Lˣ) (k : ℤ), u ∈ unitGroup F L n ∧
          (x : L) = normLM F h y * (u : L) *
            (((chosenUniformizer F L) ^ ((m : ℤ) * k) : Lˣ) : L) :=
by
  intro hab n m hn hm hM x hx
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion h).injective
  have hx_weil : rawRecMap F L x ∈ weilGroup F :=
    (rawRecMap_actsAsFrobPow_and_mem_relWeil F L x).1.1
  let σ_M : relWeil F M := ⟨rawRecMap F L x, Subgroup.mem_inf.mpr ⟨hx_weil, hx⟩⟩
  obtain ⟨y₀, hy₀⟩ :=
    exists_rawRecMap_inv_mul_mem_lubinTateUnramField_fixingSubgroup F L M h hab n m hn hm hM σ_M
  let w₀ : Lˣ := Units.map (normLM F h) y₀
  let z : Lˣ := w₀⁻¹ * x
  have hw₀z : w₀ * z = x := mul_inv_cancel_left w₀ x
  have hcompat :=
    rawRecMap_inv_mul_normLM_mul_mem_lubinTateUnramField_fixingSubgroup
      F L M h hab n m hn hm hM y₀ z
  change (rawRecMap F L (w₀ * z))⁻¹ * (rawRecMap F M y₀ * rawRecMap F L z) ∈
    (lubinTateUnramField F L n m).fixingSubgroup at hcompat
  rw [hw₀z] at hcompat
  have hz_fix : rawRecMap F L z ∈ (lubinTateUnramField F L n m).fixingSubgroup := by
    have hprod := (lubinTateUnramField F L n m).fixingSubgroup.mul_mem hy₀ hcompat
    have hgrp :
        ((rawRecMap F M y₀)⁻¹ * (σ_M : AbsGal F)) *
          ((rawRecMap F L x)⁻¹ * (rawRecMap F M y₀ * rawRecMap F L z)) =
        rawRecMap F L z := by
      change ((rawRecMap F M y₀)⁻¹ * rawRecMap F L x) *
        ((rawRecMap F L x)⁻¹ * (rawRecMap F M y₀ * rawRecMap F L z)) = rawRecMap F L z
      group
    rwa [hgrp] at hprod
  rw [IntermediateField.mem_fixingSubgroup_iff] at hz_fix
  have hz_roots : ∀ ζ : AlgebraicClosure F, ζ ^ (qL F L ^ m - 1) = 1 →
      rawRecMap F L z ζ = ζ := by
    intro ζ hζ
    have hmem : ζ ∈ lubinTateUnramField F L n m := by
      unfold lubinTateUnramField
      apply (le_sup_right : IntermediateField.adjoin F _ ≤ _)
      apply IntermediateField.subset_adjoin
      exact Set.mem_union_right _ hζ
    exact hz_fix ζ hmem
  have hz_lt : ∀ α : AlgebraicClosure F,
      isLubinTateRoot F L (chosenUniformizer F L) n α → rawRecMap F L z α = α := by
    intro α hα
    have hmem : α ∈ lubinTateUnramField F L n m := by
      unfold lubinTateUnramField
      apply (le_sup_right : IntermediateField.adjoin F _ ≤ _)
      apply IntermediateField.subset_adjoin
      exact Set.mem_union_left _ hα
    exact hz_fix α hmem
  have hz_frob : ActsAsFrobPow F (rawRecMap F L z) (-((resDeg F L : ℤ) * valL F L z)) := by
    have hf := (rawRecMap_actsAsFrobPow_and_mem_relWeil F L z).2
    rwa [relVal_eq_resDeg_mul_valL F L z] at hf
  obtain ⟨k, hk⟩ :=
    exists_eq_mul_of_actsAsFrobPow_and_fix_rootsOfUnity
      F L m hm (valL F L z) (rawRecMap F L z) hz_frob hz_roots
  let u : Lˣ := z * (chosenUniformizer F L) ^ (-valL F L z)
  have hu : u ∈ unitGroup F L n :=
    mul_chosenUniformizer_zpow_neg_valL_mem_unitGroup_of_fix_isLubinTateRoot F L n hn z hz_lt
  refine ⟨(y₀ : M), u, k, hu, ?_⟩
  have h_units : x = w₀ * u * (chosenUniformizer F L) ^ ((m : ℤ) * k) := by
    have huz : u * (chosenUniformizer F L) ^ (valL F L z) = z := by
      dsimp only [u]
      rw [zpow_neg, inv_mul_cancel_right]
    rw [← hw₀z, ← hk, mul_assoc, huz]
  have h_coe := congrArg (Units.val : Lˣ → L) h_units
  simpa only [Units.val_mul, w₀, Units.coe_map, MonoidHom.coe_coe] using h_coe

theorem exists_normLM_eq_one_sub_iterate_pow_of_lubinTateLevelField_eq_adjoin (F : Type u)
    [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (n : ℕ) :
    1 ≤ n → ∀ (π_n : AlgebraicClosure F),
      Polynomial.aeval π_n (lubinTateDivPoly F L (chosenUniformizer F L : L) n) = 0 →
      lubinTateLevelField F L (chosenUniformizer F L) n = IntermediateField.adjoin L {π_n} →
      ∀ (h_L_div : L ≤ lubinTateDivField F L n) (c : L),
        ∃ y : lubinTateDivField F L n,
          normLM F h_L_div y =
            (1 - ((fun x : L => (chosenUniformizer F L : L) * (x - x ^ qL F L))^[n - 1] c)) ^
              (qL F L - 1) :=
by
  have h_quotient_and_iterate : ∀ (K Ω : Type u) [Field K] [Field Ω] [Algebra K Ω]
      (ϖ : K) (qL : ℕ) (hqL : 1 < qL),
      let f : Polynomial K := Polynomial.C ϖ * Polynomial.X + Polynomial.X ^ qL
      let g : ℕ → Polynomial K := fun m => Nat.rec Polynomial.X (fun _ gm => f.comp gm) m
      let divPoly : ℕ → Polynomial K := fun m => (g (m - 1)) ^ (qL - 1) + Polynomial.C ϖ
      let Q : ℕ → Polynomial K := fun m => Nat.rec 1 (fun k Qk => Qk * divPoly (k + 1)) m
      let ftilde : K → K := fun x => ϖ * (x - x ^ qL)
      (∀ m : ℕ, Polynomial.X * Q m = g m) ∧
      (∀ (π₁ : Ω), π₁ ^ qL = - algebraMap K Ω ϖ * π₁ →
        ∀ (c : K) (m : ℕ),
          Polynomial.aeval (algebraMap K Ω c * π₁) (g m) =
            algebraMap K Ω (ftilde^[m] c) * π₁) := by
    clear! F n
    intro K Ω _ _ _ ϖ qL hqL f g divPoly Q ftilde
    have hqL_sub : (qL - 1) + 1 = qL := Nat.sub_add_cancel (by omega)
    refine ⟨?_, ?_⟩
    · intro m
      induction m with
      | zero =>
        change Polynomial.X * 1 = Polynomial.X
        exact mul_one Polynomial.X
      | succ m ih =>
        change Polynomial.X * (Q m * ((g m) ^ (qL - 1) + Polynomial.C ϖ)) =
          (Polynomial.C ϖ * Polynomial.X + Polynomial.X ^ qL).comp (g m)
        rw [← mul_assoc, ih, Polynomial.add_comp, Polynomial.mul_comp, Polynomial.C_comp,
          Polynomial.X_comp, Polynomial.pow_comp, Polynomial.X_comp]
        conv_rhs => rw [← hqL_sub, pow_succ']
        ring
    · intro π₁ hπ₁ c m
      induction m with
      | zero =>
        change Polynomial.aeval (algebraMap K Ω c * π₁) Polynomial.X = algebraMap K Ω c * π₁
        exact Polynomial.aeval_X _
      | succ m ih =>
        rw [Function.iterate_succ_apply']
        change Polynomial.aeval (algebraMap K Ω c * π₁)
            ((Polynomial.C ϖ * Polynomial.X + Polynomial.X ^ qL).comp (g m)) =
          algebraMap K Ω (ϖ * (ftilde^[m] c - (ftilde^[m] c) ^ qL)) * π₁
        rw [Polynomial.aeval_comp, map_add, map_mul, Polynomial.aeval_C, Polynomial.aeval_X,
          map_pow, Polynomial.aeval_X, ih, mul_pow, hπ₁, map_mul, map_sub, map_pow]
        ring
  have h_shifted_gen_norm : ∀ (A₁ Ω : Type u) [Field A₁] [Field Ω] [Algebra A₁ Ω]
      (B : IntermediateField A₁ Ω) (π_n : Ω)
      (hB : B = IntermediateField.adjoin A₁ {π_n}) (G : Polynomial A₁) (hG_monic : G.Monic)
      (hG_deg : G.natDegree = Module.finrank A₁ B) (hG_aeval : Polynomial.aeval π_n G = 0)
      (y : A₁) (π_B : B) (hπ_B : (π_B : Ω) = π_n),
      Algebra.norm A₁ (π_B - algebraMap A₁ B y) =
        (-1 : A₁) ^ (Module.finrank A₁ B) * G.eval y := by
    clear! F n
    intro A₁ Ω _ _ _ B π_n hB G hG_monic hG_deg hG_aeval y π_B hπ_B
    set α_y : Ω := π_n - algebraMap A₁ Ω y
    have h_adj_eq : IntermediateField.adjoin A₁ ({α_y} : Set Ω) = B := by
      rw [hB]
      apply le_antisymm
      · rw [IntermediateField.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        exact sub_mem (IntermediateField.mem_adjoin_simple_self A₁ π_n)
          (IntermediateField.algebraMap_mem _ y)
      · rw [IntermediateField.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        have h_eq : π_n = α_y + algebraMap A₁ Ω y := (sub_add_cancel π_n (algebraMap A₁ Ω y)).symm
        rw [h_eq]
        exact add_mem (IntermediateField.mem_adjoin_simple_self A₁ α_y)
          (IntermediateField.algebraMap_mem _ y)
    set G_y : Polynomial A₁ := G.comp (Polynomial.X + Polynomial.C y)
    have hGy_monic : G_y.Monic :=
      hG_monic.comp (Polynomial.monic_X_add_C y) (by rw [Polynomial.natDegree_X_add_C]; omega)
    have hGy_deg : G_y.natDegree = Module.finrank A₁ B := by
      dsimp [G_y]
      rw [Polynomial.natDegree_comp, hG_deg, Polynomial.natDegree_X_add_C, mul_one]
    have hGy_aeval_Ω : Polynomial.aeval α_y G_y = 0 := by
      dsimp [G_y, α_y]
      rw [Polynomial.aeval_comp, map_add, Polynomial.aeval_X, Polynomial.aeval_C,
        sub_add_cancel, hG_aeval]
    have h_int : IsIntegral A₁ α_y :=
      ⟨G_y, hGy_monic, Polynomial.aeval_def α_y G_y ▸ hGy_aeval_Ω⟩
    let pb₀ : PowerBasis A₁ ↥(IntermediateField.adjoin A₁ ({α_y} : Set Ω)) :=
      IntermediateField.adjoin.powerBasis h_int
    let pb : PowerBasis A₁ B := pb₀.map (IntermediateField.equivOfEq h_adj_eq)
    have h_gen_coe : (pb.gen : Ω) = α_y := by
      change (pb₀.gen : Ω) = α_y
      rw [IntermediateField.adjoin.powerBasis_gen h_int]
      rfl
    have h_gen_eq : pb.gen = π_B - algebraMap A₁ B y := by
      apply Subtype.ext
      change (pb.gen : Ω) = (π_B : Ω) - algebraMap A₁ Ω y
      rw [h_gen_coe, hπ_B]
    have hGy_aeval : Polynomial.aeval pb.gen G_y = 0 := by
      apply Subtype.ext
      change B.val (Polynomial.aeval pb.gen G_y) = 0
      rw [← Polynomial.aeval_algHom_apply B.val]
      change Polynomial.aeval (pb.gen : Ω) G_y = 0
      rw [h_gen_coe]
      exact hGy_aeval_Ω
    have h_int_gen : IsIntegral A₁ pb.gen :=
      ⟨G_y, hGy_monic, Polynomial.aeval_def pb.gen G_y ▸ hGy_aeval⟩
    have h_dvd : minpoly A₁ pb.gen ∣ G_y := minpoly.dvd A₁ pb.gen hGy_aeval
    have h_min_monic : (minpoly A₁ pb.gen).Monic := minpoly.monic h_int_gen
    have h_min_deg : (minpoly A₁ pb.gen).natDegree = Module.finrank A₁ B := by
      rw [PowerBasis.natDegree_minpoly pb, ← pb.finrank]
    have h_min_eq : minpoly A₁ pb.gen = G_y :=
      (Polynomial.eq_of_monic_of_dvd_of_natDegree_le h_min_monic hGy_monic h_dvd
        (by rw [hGy_deg, h_min_deg])).symm
    have h_coeff0 : G_y.coeff 0 = G.eval y := by
      dsimp [G_y]
      rw [Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_comp, Polynomial.eval_add,
        Polynomial.eval_X, Polynomial.eval_C, zero_add]
    rw [← h_gen_eq, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, h_min_eq, h_coeff0,
      ← pb.finrank]
  have h_tower_norm : ∀ (K Ω : Type u) [Field K] [Field Ω] [Algebra K Ω]
      (ϖ : K) (hϖ_ne : ϖ ≠ 0) (qL n : ℕ) (hqL : 1 < qL) (hn : 1 ≤ n) (π_n : Ω),
      let f : Polynomial K := Polynomial.C ϖ * Polynomial.X + Polynomial.X ^ qL
      let g : ℕ → Polynomial K := fun m => Nat.rec Polynomial.X (fun _ gm => f.comp gm) m
      let divPoly : ℕ → Polynomial K := fun m => (g (m - 1)) ^ (qL - 1) + Polynomial.C ϖ
      let ftilde : K → K := fun x => ϖ * (x - x ^ qL)
      (divPoly 1).Monic → Irreducible (divPoly 1) →
      (divPoly n).Monic → Irreducible (divPoly n) →
      Polynomial.aeval π_n (divPoly n) = 0 →
      ∀ (c : K),
        ∃ w : IntermediateField.adjoin K ({π_n} : Set Ω),
          Algebra.norm K w = (1 - ftilde^[n - 1] c) ^ (qL - 1) := by
    clear! F n
    intro K Ω _ _ _ ϖ hϖ_ne qL n hqL hn π_n f g divPoly ftilde hf1_monic hf1_irr
      hfn_monic hfn_irr hπ_aeval c
    have hqL_sub : (qL - 1) + 1 = qL := Nat.sub_add_cancel (by omega)
    let Q : ℕ → Polynomial K := fun m => Nat.rec 1 (fun k Qk => Qk * divPoly (k + 1)) m
    obtain ⟨h_XQ, h_iter⟩ := h_quotient_and_iterate K Ω ϖ qL hqL
    have hg_deg_all : ∀ m : ℕ, (g m).Monic ∧ (g m).natDegree = qL ^ m := by
      intro m
      have hdeg_lt : (Polynomial.C ϖ * Polynomial.X).degree <
          (Polynomial.X ^ qL : Polynomial K).degree := by
        rw [Polynomial.degree_X_pow]
        exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_le ϖ) (WithBot.coe_lt_coe.mpr hqL)
      have hf0_monic : f.Monic := by
        change (Polynomial.C ϖ * Polynomial.X + Polynomial.X ^ qL).Monic
        rw [add_comm]
        exact Polynomial.Monic.add_of_left (Polynomial.monic_X_pow qL) hdeg_lt
      have hf0_deg : f.natDegree = qL := by
        change (Polynomial.C ϖ * Polynomial.X + Polynomial.X ^ qL).natDegree = qL
        rw [add_comm, Polynomial.natDegree_add_eq_left_of_degree_lt hdeg_lt,
          Polynomial.natDegree_X_pow]
      induction m with
      | zero =>
        dsimp [g]
        exact ⟨Polynomial.monic_X, Polynomial.natDegree_X⟩
      | succ m ih =>
        obtain ⟨ih_monic, ih_deg⟩ := ih
        have h_deg_ne : (g m).natDegree ≠ 0 := by
          rw [ih_deg]
          exact pow_ne_zero m (by omega)
        change (f.comp (g m)).Monic ∧ (f.comp (g m)).natDegree = qL ^ (m + 1)
        refine ⟨hf0_monic.comp ih_monic h_deg_ne, ?_⟩
        rw [Polynomial.natDegree_comp, hf0_deg, ih_deg, pow_succ']
    have hdiv_deg : ∀ k : ℕ, 1 ≤ k → (divPoly k).natDegree = (qL - 1) * qL ^ (k - 1) := by
      intro k hk
      obtain ⟨hgk_monic, hgk_deg⟩ := hg_deg_all (k - 1)
      set P0 : Polynomial K := (g (k - 1)) ^ (qL - 1)
      set dk : ℕ := (qL - 1) * qL ^ (k - 1)
      have hP0_monic : P0.Monic := hgk_monic.pow (qL - 1)
      have hP0_deg : P0.natDegree = dk := by
        change ((g (k - 1)) ^ (qL - 1)).natDegree = dk
        rw [hgk_monic.natDegree_pow, hgk_deg]
      have hdk_pos : 1 ≤ dk := Nat.mul_pos (by omega) (pow_pos (by omega) (k - 1))
      have hdeg_C_lt : (Polynomial.C ϖ).degree < P0.degree := by
        rw [Polynomial.degree_eq_natDegree hP0_monic.ne_zero, hP0_deg]
        exact lt_of_le_of_lt Polynomial.degree_C_le (WithBot.coe_lt_coe.mpr hdk_pos)
      change (P0 + Polynomial.C ϖ).natDegree = dk
      rw [Polynomial.natDegree_add_eq_left_of_degree_lt hdeg_C_lt, hP0_deg]
    have hf1_deg : (divPoly 1).natDegree = qL - 1 := by
      rw [hdiv_deg 1 le_rfl]
      simp
    have hfn_deg : (divPoly n).natDegree = (qL - 1) * qL ^ (n - 1) := hdiv_deg n hn
    set g_prev : Polynomial K := g (n - 1)
    set Q_prev : Polynomial K := Q (n - 1)
    set π₁ : Ω := Polynomial.aeval π_n g_prev
    set β : Ω := Polynomial.aeval π_n Q_prev
    have h_mul_π : π_n * β = π₁ := by
      have h1 := congrArg (Polynomial.aeval π_n) (h_XQ (n - 1))
      rwa [map_mul, Polynomial.aeval_X] at h1
    have hπ₁_pow_add : π₁ ^ (qL - 1) + algebraMap K Ω ϖ = 0 := by
      have h1 : Polynomial.aeval π_n (g_prev ^ (qL - 1) + Polynomial.C ϖ) = 0 := hπ_aeval
      rwa [map_add, map_pow, Polynomial.aeval_C] at h1
    have hπ₁_aeval : Polynomial.aeval π₁ (divPoly 1) = 0 := by
      change Polynomial.aeval π₁ (Polynomial.X ^ (qL - 1) + Polynomial.C ϖ) = 0
      rw [map_add, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
      exact hπ₁_pow_add
    have hπ₁_pow1 : π₁ ^ (qL - 1) = - algebraMap K Ω ϖ :=
      eq_neg_of_add_eq_zero_left hπ₁_pow_add
    have hπ₁_ne : π₁ ≠ 0 := by
      intro h0
      rw [h0, zero_pow (by omega)] at hπ₁_pow1
      have hϖ_Ω : algebraMap K Ω ϖ ≠ 0 := (map_ne_zero (algebraMap K Ω)).mpr hϖ_ne
      exact hϖ_Ω (neg_eq_zero.mp hπ₁_pow1.symm)
    have hπ₁_pow : π₁ ^ qL = - algebraMap K Ω ϖ * π₁ := by
      calc π₁ ^ qL = π₁ ^ ((qL - 1) + 1) := by rw [hqL_sub]
        _ = π₁ ^ (qL - 1) * π₁ := pow_succ π₁ (qL - 1)
        _ = - algebraMap K Ω ϖ * π₁ := by rw [hπ₁_pow1]
    set A_n : IntermediateField K Ω := IntermediateField.adjoin K {π_n}
    set A₁ : IntermediateField K Ω := IntermediateField.adjoin K {π₁}
    let π_An : ↥A_n := ⟨π_n, IntermediateField.mem_adjoin_simple_self K π_n⟩
    have hπ₁_mem : π₁ ∈ A_n := by
      have h1 : (Polynomial.aeval π_An g_prev : Ω) = π₁ := by
        change A_n.val (Polynomial.aeval π_An g_prev) = Polynomial.aeval (A_n.val π_An) g_prev
        exact (Polynomial.aeval_algHom_apply A_n.val π_An g_prev).symm
      rw [← h1]
      exact (Polynomial.aeval π_An g_prev).2
    have hβ_mem : β ∈ A_n := by
      have h1 : (Polynomial.aeval π_An Q_prev : Ω) = β := by
        change A_n.val (Polynomial.aeval π_An Q_prev) = Polynomial.aeval (A_n.val π_An) Q_prev
        exact (Polynomial.aeval_algHom_apply A_n.val π_An Q_prev).symm
      rw [← h1]
      exact (Polynomial.aeval π_An Q_prev).2
    have h1n : A₁ ≤ A_n := IntermediateField.adjoin_simple_le_iff.mpr hπ₁_mem
    set B : IntermediateField ↥A₁ Ω := IntermediateField.extendScalars h1n
    have hB : B = IntermediateField.adjoin ↥A₁ {π_n} := by
      apply le_antisymm
      · intro z hz
        change z ∈ A_n at hz
        induction hz using IntermediateField.adjoin_induction with
        | mem x hx =>
          rw [Set.mem_singleton_iff.mp hx]
          exact IntermediateField.mem_adjoin_simple_self ↥A₁ π_n
        | algebraMap r =>
          change algebraMap K Ω r ∈ IntermediateField.adjoin ↥A₁ {π_n}
          exact (IntermediateField.adjoin ↥A₁ {π_n}).algebraMap_mem (algebraMap K ↥A₁ r)
        | add x y _ _ hx hy => exact add_mem hx hy
        | mul x y _ _ hx hy => exact mul_mem hx hy
        | inv x _ hx => exact inv_mem hx
      · rw [IntermediateField.adjoin_simple_le_iff]
        exact (IntermediateField.mem_extendScalars h1n).mpr
          (IntermediateField.mem_adjoin_simple_self K π_n)
    have h_int1 : IsIntegral K π₁ :=
      ⟨divPoly 1, hf1_monic, Polynomial.aeval_def π₁ (divPoly 1) ▸ hπ₁_aeval⟩
    have h_intn : IsIntegral K π_n :=
      ⟨divPoly n, hfn_monic, Polynomial.aeval_def π_n (divPoly n) ▸ hπ_aeval⟩
    have h_min1 : minpoly K π₁ = divPoly 1 :=
      (minpoly.eq_of_irreducible_of_monic hf1_irr hπ₁_aeval hf1_monic).symm
    have h_minn : minpoly K π_n = divPoly n :=
      (minpoly.eq_of_irreducible_of_monic hfn_irr hπ_aeval hfn_monic).symm
    have h_fin1 : Module.finrank K ↥A₁ = qL - 1 := by
      rw [IntermediateField.adjoin.finrank h_int1, h_min1, hf1_deg]
    have h_finn : Module.finrank K ↥A_n = (qL - 1) * qL ^ (n - 1) := by
      rw [IntermediateField.adjoin.finrank h_intn, h_minn, hfn_deg]
    have h_finB_K : Module.finrank K ↥B = (qL - 1) * qL ^ (n - 1) := h_finn
    have h_tower : Module.finrank K ↥A₁ * Module.finrank ↥A₁ ↥B = Module.finrank K ↥B :=
      Module.finrank_mul_finrank K ↥A₁ ↥B
    rw [h_fin1, h_finB_K] at h_tower
    have h_finB : Module.finrank ↥A₁ ↥B = qL ^ (n - 1) :=
      Nat.eq_of_mul_eq_mul_left (by omega) h_tower
    let π₁_A₁ : ↥A₁ := ⟨π₁, IntermediateField.mem_adjoin_simple_self K π₁⟩
    let π_B : ↥B := ⟨π_n, (IntermediateField.mem_extendScalars h1n).mpr
      (IntermediateField.mem_adjoin_simple_self K π_n)⟩
    let β_B : ↥B := ⟨β, (IntermediateField.mem_extendScalars h1n).mpr hβ_mem⟩
    set G : Polynomial ↥A₁ := g_prev.map (algebraMap K ↥A₁) - Polynomial.C π₁_A₁
    obtain ⟨hg_prev_monic, hg_prev_deg⟩ := hg_deg_all (n - 1)
    have hg_map_monic : (g_prev.map (algebraMap K ↥A₁)).Monic :=
      hg_prev_monic.map (algebraMap K ↥A₁)
    have hg_map_deg : (g_prev.map (algebraMap K ↥A₁)).natDegree = qL ^ (n - 1) := by
      rw [hg_prev_monic.natDegree_map, hg_prev_deg]
    have h_qL_pow_pos : 1 ≤ qL ^ (n - 1) := pow_pos (by omega : 0 < qL) (n - 1)
    have h_deg_C_lt : (Polynomial.C π₁_A₁).degree < (g_prev.map (algebraMap K ↥A₁)).degree := by
      rw [Polynomial.degree_eq_natDegree hg_map_monic.ne_zero, hg_map_deg]
      exact lt_of_le_of_lt Polynomial.degree_C_le (WithBot.coe_lt_coe.mpr h_qL_pow_pos)
    have hG_monic : G.Monic := hg_map_monic.sub_of_left h_deg_C_lt
    have hG_deg : G.natDegree = Module.finrank ↥A₁ ↥B := by
      dsimp [G]
      rw [Polynomial.natDegree_sub_C, hg_map_deg, h_finB]
    have hG_aeval : Polynomial.aeval π_n G = 0 := by
      dsimp [G]
      rw [map_sub, Polynomial.aeval_map_algebraMap, Polynomial.aeval_C]
      change π₁ - π₁ = 0
      exact sub_self π₁
    have hg_prev_eval0 : g_prev.eval 0 = 0 := by
      have h1 := congrArg (Polynomial.eval 0) (h_XQ (n - 1))
      rwa [Polynomial.eval_mul, Polynomial.eval_X, zero_mul, eq_comm] at h1
    have hG_eval0 : G.eval 0 = - π₁_A₁ := by
      dsimp [G]
      rw [← Polynomial.coeff_zero_eq_eval_zero, Polynomial.coeff_sub, Polynomial.coeff_map,
        Polynomial.coeff_zero_eq_eval_zero, hg_prev_eval0, map_zero, Polynomial.coeff_C_zero,
        zero_sub]
    set y_c : ↥A₁ := algebraMap K ↥A₁ c * π₁_A₁
    have hG_eval_yc : G.eval y_c = - (algebraMap K ↥A₁ (1 - ftilde^[n - 1] c) * π₁_A₁) := by
      apply Subtype.ext
      have h_val_aeval : ((Polynomial.aeval y_c g_prev : ↥A₁) : Ω) =
          Polynomial.aeval (algebraMap K Ω c * π₁) g_prev := by
        change A₁.val (Polynomial.aeval y_c g_prev) = Polynomial.aeval (A₁.val y_c) g_prev
        exact (Polynomial.aeval_algHom_apply A₁.val y_c g_prev).symm
      change ((G.eval y_c : ↥A₁) : Ω) = - (algebraMap K Ω (1 - ftilde^[n - 1] c) * π₁)
      dsimp [G]
      rw [Polynomial.eval_sub, Polynomial.eval_map_algebraMap, Polynomial.eval_C,
        AddSubgroupClass.coe_sub, h_val_aeval]
      change Polynomial.aeval (algebraMap K Ω c * π₁) g_prev - π₁ =
        - (algebraMap K Ω (1 - ftilde^[n - 1] c) * π₁)
      rw [h_iter π₁ hπ₁_pow c (n - 1), map_sub, map_one]
      ring
    have h_norm_πB : Algebra.norm ↥A₁ π_B =
        (-1 : ↥A₁) ^ (Module.finrank ↥A₁ ↥B) * (- π₁_A₁) := by
      have h1 := h_shifted_gen_norm ↥A₁ Ω B π_n hB G hG_monic hG_deg hG_aeval 0 π_B rfl
      rwa [map_zero, sub_zero, hG_eval0] at h1
    have hπ₁_A₁_ne : π₁_A₁ ≠ 0 := by
      intro h0
      exact hπ₁_ne (congrArg Subtype.val h0)
    have h_norm_πB_ne : Algebra.norm ↥A₁ π_B ≠ 0 := by
      rw [h_norm_πB]
      exact mul_ne_zero (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero))
        (neg_ne_zero.mpr hπ₁_A₁_ne)
    let w_B : ↥B := 1 - algebraMap K ↥B c * β_B
    have h_prod_B : π_B * w_B = π_B - algebraMap ↥A₁ ↥B y_c := by
      apply Subtype.ext
      change π_n * (1 - algebraMap K Ω c * β) = π_n - algebraMap K Ω c * π₁
      calc π_n * (1 - algebraMap K Ω c * β) = π_n - algebraMap K Ω c * (π_n * β) := by ring
        _ = π_n - algebraMap K Ω c * π₁ := by rw [h_mul_π]
    have h_norm_prod : Algebra.norm ↥A₁ (π_B * w_B) =
        Algebra.norm ↥A₁ π_B * algebraMap K ↥A₁ (1 - ftilde^[n - 1] c) := by
      rw [h_prod_B, h_shifted_gen_norm ↥A₁ Ω B π_n hB G hG_monic hG_deg hG_aeval y_c π_B rfl,
        hG_eval_yc, h_norm_πB]
      ring
    rw [map_mul] at h_norm_prod
    have h_norm_wB : Algebra.norm ↥A₁ w_B = algebraMap K ↥A₁ (1 - ftilde^[n - 1] c) :=
      mul_left_cancel₀ h_norm_πB_ne h_norm_prod
    have h_norm_An : Algebra.norm K (w_B : ↥A_n) = (1 - ftilde^[n - 1] c) ^ (qL - 1) := by
      change Algebra.norm K w_B = (1 - ftilde^[n - 1] c) ^ (qL - 1)
      rw [← Algebra.norm_norm (R := K) (S := ↥A₁) (a := w_B), h_norm_wB,
        Algebra.norm_algebraMap, h_fin1]
    exact ⟨(w_B : ↥A_n), h_norm_An⟩
  intro hn π_n hπ_aeval h_level h_L_div c
  set ϖ : Lˣ := chosenUniformizer F L
  have hϖ : valL F L ϖ = 1 := (valL_chosenUniformizer_and_mul_zpow F L 1).1
  have hres_ne : resDeg F L ≠ 0 := by
    intro h0
    unfold valL at hϖ
    rw [h0, Nat.cast_zero, Int.ediv_zero] at hϖ
    omega
  have hq_gt : 1 < q F := Finite.one_lt_card
  have hqL_gt : 1 < qL F L := one_lt_pow₀ hq_gt hres_ne
  obtain ⟨hf1_monic, -, hf1_irr⟩ :=
    lubinTateDivPoly_monic_coeff_zero_and_irreducible F L ϖ hϖ 1 le_rfl
  obtain ⟨hfn_monic, -, hfn_irr⟩ :=
    lubinTateDivPoly_monic_coeff_zero_and_irreducible F L ϖ hϖ n hn
  let f₀ : Polynomial L := Polynomial.C (ϖ : L) * Polynomial.X + Polynomial.X ^ qL F L
  let g₀ : ℕ → Polynomial L := fun m => Nat.rec Polynomial.X (fun _ gm => f₀.comp gm) m
  have hg_eq : ∀ m : ℕ, g₀ m = lubinTateIterPoly F L (ϖ : L) m := by
    intro m
    induction m with
    | zero => rfl
    | succ m ih => exact congrArg f₀.comp ih
  let divPoly₀ : ℕ → Polynomial L := fun m => (g₀ (m - 1)) ^ (qL F L - 1) + Polynomial.C (ϖ : L)
  have hdiv_eq : ∀ m : ℕ, divPoly₀ m = lubinTateDivPoly F L (ϖ : L) m := by
    intro m
    dsimp [divPoly₀, lubinTateDivPoly]
    rw [hg_eq (m - 1)]
  rw [← hdiv_eq 1] at hf1_monic hf1_irr
  rw [← hdiv_eq n] at hfn_monic hfn_irr hπ_aeval
  obtain ⟨w, hw⟩ := h_tower_norm ↥L (AlgebraicClosure F) (ϖ : L) ϖ.ne_zero (qL F L) n
    hqL_gt hn π_n hf1_monic hf1_irr hfn_monic hfn_irr hπ_aeval c
  set E := lubinTateDivField F L n
  set E_L := IntermediateField.extendScalars h_L_div
  set S : Set (AlgebraicClosure F) := {α : AlgebraicClosure F | isLubinTateRoot F L ϖ n α}
  have hE_le : E ≤ (lubinTateLevelField F L ϖ n).restrictScalars F := by
    unfold E lubinTateDivField lubinTateLevelField
    apply sup_le
    · intro x hx
      exact (IntermediateField.mem_restrictScalars F).mpr
        ((IntermediateField.adjoin ↥L S).algebraMap_mem ⟨x, hx⟩)
    · rw [IntermediateField.adjoin_le_iff]
      intro α hα
      exact (IntermediateField.mem_restrictScalars F).mpr
        (IntermediateField.subset_adjoin ↥L S hα)
  have h_ext_eq : E_L = lubinTateLevelField F L ϖ n := by
    apply le_antisymm
    · intro z hz
      exact (IntermediateField.mem_restrictScalars F).mp
        (hE_le ((IntermediateField.mem_extendScalars h_L_div).mp hz))
    · unfold lubinTateLevelField
      rw [IntermediateField.adjoin_le_iff]
      intro α hα
      exact (IntermediateField.mem_extendScalars h_L_div).mpr
        ((le_sup_right : IntermediateField.adjoin F S ≤ E)
          (IntermediateField.subset_adjoin F S hα))
  have h_adj0 : E_L = IntermediateField.adjoin L {π_n} := h_ext_eq.trans h_level
  let e : ↥(IntermediateField.adjoin L {π_n}) ≃ₐ[↥L] ↥E_L :=
    IntermediateField.equivOfEq h_adj0.symm
  let z : ↥E_L := e w
  have hz_norm : Algebra.norm ↥L z =
      (1 - ((fun x : L => (ϖ : L) * (x - x ^ qL F L))^[n - 1] c)) ^ (qL F L - 1) := by
    dsimp [z]
    rw [Algebra.norm_eq_of_algEquiv e w]
    exact hw
  exact ⟨⟨z.1, (IntermediateField.mem_extendScalars h_L_div).mp z.2⟩, hz_norm⟩

theorem exists_one_sub_iterate_pow_eq_of_le_valL_sub_one (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (n : ℕ) :
    1 ≤ n → ∀ (u : Lˣ), (n : ℤ) ≤ valL F L ((u : L) - 1) →
      ∃ c : L,
        (1 - ((fun x : L => (chosenUniformizer F L : L) * (x - x ^ qL F L))^[n - 1] c)) ^
          (qL F L - 1) = (u : L) :=
by
  intro hn u hu
  have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
      0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
    intro a ha
    unfold addVal
    rw [dif_neg ha]
    set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    set va := valuation F a
    have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
    constructor
    · intro h_nonneg
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
      have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
      have h_iso : iso va ≤ iso 1 := by
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
        exact WithZero.coe_le_coe.mpr h_unzero
      exact (map_le_map_iff iso).mp h_iso
    · intro h_le
      have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
      rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
        Multiplicative.toAdd_le.mpr h_iso
      omega
  have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Lˣ, Multiplicative.toAdd (relValHom u) = relVal F L u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : Lˣ,
      relVal F L ((u * v : Lˣ) : L) = relVal F L u + relVal F L v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : Lˣ) (k : ℤ),
      relVal F L ((u ^ k : Lˣ) : L) = k * relVal F L u := by
    intro u k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have relVal_mul : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      relVal F L (x * y) = relVal F L x + relVal F L y := by
    intro x y hx hy
    exact relVal_units_mul (Units.mk0 x hx) (Units.mk0 y hy)
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F L ∧ ∃ π : Lˣ, relVal F L π = resDeg F L := by
    obtain ⟨uF, hu_val⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L uF,
        (map_ne_zero (algebraMap F L)).mpr uF.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (uF : F)) = (uF : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (uF : F)
      have hpow : addVal F ((uF : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F uF := by
        change Multiplicative.toAdd (addValHom (uF ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu_val, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hf_pos, π_ex, hπ_ex⟩ := resDeg_mem
  have relVal_eq_resDeg_mul_valL_aux :
      ∀ u₀ : Lˣ, relVal F L u₀ = (resDeg F L : ℤ) * valL F L u₀ := by
    intro u₀
    let q₀ := relVal F L u₀ / (resDeg F L : ℤ)
    let r₀ := relVal F L u₀ % (resDeg F L : ℤ)
    have hdiv : r₀ + (resDeg F L : ℤ) * q₀ = relVal F L u₀ := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r₀ := Int.emod_nonneg _ (by positivity)
    have hrlt : r₀ < (resDeg F L : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F L ((u₀ * π_ex ^ (-q₀) : Lˣ) : L) = r₀ := by
      rw [relVal_units_mul, relVal_units_zpow, hπ_ex]
      linarith
    have hr_eq : r₀ = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r₀.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r₀.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k} := by
        refine ⟨hr_pos, ((u₀ * π_ex ^ (-q₀) : Lˣ) : L), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F L ≤ r₀.toNat := Nat.sInf_le hmem
      omega
    change relVal F L u₀ = (resDeg F L : ℤ) * q₀
    linarith
  have relVal_eq : ∀ {x : L} (hx : x ≠ 0), relVal F L x = (resDeg F L : ℤ) * valL F L x :=
    fun hx => relVal_eq_resDeg_mul_valL_aux (Units.mk0 _ hx)
  set πL : L := (chosenUniformizer F L : L)
  have hπL_ne : πL ≠ 0 := Units.ne_zero (chosenUniformizer F L)
  have hπ_val : valL F L πL = 1 := by
    have hf_ne : (resDeg F L : ℤ) ≠ 0 := by positivity
    have hπ_ex_val : valL F L π_ex = 1 := by
      rw [valL, hπ_ex, Int.ediv_self hf_ne]
    exact Classical.epsilon_spec (p := fun π : Lˣ => valL F L π = 1) ⟨π_ex, hπ_ex_val⟩
  have valL_mul : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      valL F L (x * y) = valL F L x + valL F L y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    have h := relVal_mul hx hy
    rw [relVal_eq hxy, relVal_eq hx, relVal_eq hy, ← mul_add] at h
    exact mul_left_cancel₀ (by positivity) h
  have valL_one : valL F L 1 = 0 := by
    have h1 : (1 : L) ≠ 0 := one_ne_zero
    have h := valL_mul h1 h1
    rw [mul_one] at h
    omega
  have valL_div : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      valL F L (x / y) = valL F L x - valL F L y := by
    intro x y hx hy
    have hxy : x / y ≠ 0 := div_ne_zero hx hy
    have h := valL_mul hxy hy
    rw [div_mul_cancel₀ _ hy] at h
    omega
  have valL_pow : ∀ {x : L} (hx : x ≠ 0) (k : ℕ), valL F L (x ^ k) = (k : ℤ) * valL F L x := by
    intro x hx k
    induction k with
    | zero => simp [valL_one]
    | succ k ih =>
      rw [pow_succ, valL_mul (pow_ne_zero k hx) hx, ih]
      push_cast
      ring
  have h_pow_val : ∀ m : ℕ, valL F L (πL ^ m) = (m : ℤ) := by
    intro m
    rw [valL_pow hπL_ne m, hπ_val, mul_one]
  have h_inv_val : valL F L (πL⁻¹) = -1 := by
    have h := valL_mul hπL_ne (inv_ne_zero hπL_ne)
    rw [mul_inv_cancel₀ hπL_ne, valL_one, hπ_val] at h
    omega
  letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
  haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
  haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
  letI : Valued F (ValueGroupWithZero F) :=
    IsValuativeTopology.instValuedValueGroupWithZeroOfIsUniformAddGroup
  let rlo : RankLeOneStruct F :=
    { emb := (WithZeroMulInt.toNNReal (by norm_num : (2 : NNReal) ≠ 0)).comp
        (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).toMonoidWithZeroHom
      strictMono := (WithZeroMulInt.toNNReal_strictMono (by norm_num : (1 : NNReal) < 2)).comp
        (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).strictMono }
  haveI : (Valued.v (R := F)).RankOne := Valuation.RankOne.ofRankLeOneStruct rlo
  letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
  haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F (ValueGroupWithZero F)
  have h_norm_and_int_aux : ∀ (K : Type u) [Field K] [Algebra F K] [FiniteDimensional F K] (x : K),
      (spectralNorm F K x ≤ 1 ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x)) ∧
      (IsIntegral 𝒪[F] x ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x)) := by
    intro K _ _ _ x
    letI : NormedField K := spectralNorm.normedField F K
    by_cases hx0 : x = 0
    · subst hx0
      refine ⟨⟨fun _ => Or.inl rfl, fun _ => by change ‖(0 : K)‖ ≤ 1; rw [norm_zero]; exact zero_le_one⟩,
        ⟨fun _ => Or.inl rfl, fun _ => isIntegral_zero⟩⟩
    · have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
      have hx_int_F : IsIntegral F x := Algebra.IsIntegral.isIntegral x
      let pb : PowerBasis F (IntermediateField.adjoin F ({x} : Set K)) :=
        IntermediateField.adjoin.powerBasis hx_int_F
      have h_gen_coe : (pb.gen : K) = x := IntermediateField.AdjoinSimple.coe_gen F x
      set dK : ℕ := Module.finrank (IntermediateField.adjoin F ({x} : Set K)) K
      have h_finrank_pos : 0 < dK := Module.finrank_pos
      have h_norm_tower : Algebra.norm F x = (Algebra.norm F pb.gen) ^ dK := by
        have h1 : Algebra.norm F (pb.gen : K) = (Algebra.norm F pb.gen) ^ dK := by
          rw [← Algebra.norm_norm (R := F) (S := IntermediateField.adjoin F ({x} : Set K))
            (A := K) (a := (pb.gen : K)), ← map_pow]
          congr 1
          exact Algebra.norm_algebraMap (L := K) pb.gen
        rwa [h_gen_coe] at h1
      have h_norm_pb : Algebra.norm F pb.gen =
          (-1) ^ pb.dim * (minpoly F pb.gen).coeff 0 :=
        Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb
      have h_minpoly_eq : minpoly F pb.gen = minpoly F x := by
        have h1 : minpoly F pb.gen = minpoly F (pb.gen : K) :=
          (minpoly.algHom_eq
            (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K)))
            (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K))).injective
            pb.gen).symm
        rwa [h_gen_coe] at h1
      have h_norm_coeff_pow : ‖Algebra.norm F x‖ =
          ‖(minpoly F x).coeff 0‖ ^ dK := by
        rw [h_norm_tower, h_norm_pb, h_minpoly_eq, norm_pow, norm_mul, norm_pow,
