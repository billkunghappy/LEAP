      rw [valL_E₀_div_elem h_ne hu_prev_τ_ne, hu_prev_τ_val, sub_zero]
      exact hle
  have h_normLM_eτ : ∀ x : E₀, normLM F hLE₀ (e_τ x) = normLM F hLE₀ x := by
    intro x
    apply (algebraMap L (AlgebraicClosure F)).injective
    calc algebraMap L (AlgebraicClosure F) (normLM F hLE₀ (e_τ x))
      _ = ∏ j ∈ Finset.range f₀, (τ ^ j) ((e_τ x : E₀) : AlgebraicClosure F) :=
          (hτ_prod (e_τ x)).symm
      _ = ∏ j ∈ Finset.range f₀, (τ ^ (j + 1)) (x : AlgebraicClosure F) := by
          refine Finset.prod_congr rfl (fun j _ => ?_)
          rw [pow_succ, AlgEquiv.mul_apply, h_eτ_coe]
      _ = (∏ j ∈ Finset.range (f₀ - 1), (τ ^ (j + 1)) (x : AlgebraicClosure F)) *
            (τ ^ f₀) (x : AlgebraicClosure F) := by
          conv_lhs => rw [← Nat.sub_add_cancel hf₀]
          rw [Finset.prod_range_succ, Nat.sub_add_cancel hf₀]
      _ = (∏ j ∈ Finset.range (f₀ - 1), (τ ^ (j + 1)) (x : AlgebraicClosure F)) *
            (τ ^ 0) (x : AlgebraicClosure F) := by
          rw [hτf₀_E₀ (x : AlgebraicClosure F) x.2, pow_zero, AlgEquiv.one_apply]
      _ = ∏ j ∈ Finset.range f₀, (τ ^ j) (x : AlgebraicClosure F) := by
          conv_rhs => rw [← Nat.sub_add_cancel hf₀]
          rw [Finset.prod_range_succ']
      _ = algebraMap L (AlgebraicClosure F) (normLM F hLE₀ x) := hτ_prod x
  have h_uprev_norm : Units.map (normLM F hLE₀) u_prev_τ = Units.map (normLM F hLE₀) u_prev :=
    Units.ext (h_normLM_eτ (u_prev : E₀))
  have h_upoly_norm_eq : Units.map (normLM F hLK) u_poly = Units.map (normLM F hLE₀) v₁ := by
    have h_comp : Units.map (normLM F hLK) u_poly =
        Units.map (normLM F hLE₀) (Units.map (normLM F hE₀K) u_poly) :=
      Units.ext (normLM_comp F L E₀ K hLE₀ hE₀K (u_poly : K))
    rw [map_mul, map_mul, map_inv, h_uprev_norm, mul_inv_cancel_right, ← h_comp]
  
  let π_L_E₀ : E₀ˣ := Units.map (IntermediateField.inclusion hLE₀).toMonoidHom π_L
  have h_τ_pow_L : ∀ (j : ℕ) (c : L),
      (τ ^ j) (algebraMap L (AlgebraicClosure F) c) = algebraMap L (AlgebraicClosure F) c := by
    intro j c
    induction j with
    | zero => rfl
    | succ j ih =>
      rw [pow_succ', AlgEquiv.mul_apply, ih]
      exact (IntermediateField.mem_fixingSubgroup_iff L τ).mp hτL c c.2
  have h_norm_inc_L : ∀ c : L,
      normLM F hLE₀ (IntermediateField.inclusion hLE₀ c) = c ^ f₀ := by
    intro c
    apply (algebraMap L (AlgebraicClosure F)).injective
    rw [← hτ_prod (IntermediateField.inclusion hLE₀ c), map_pow]
    calc ∏ j ∈ Finset.range f₀,
          (τ ^ j) ((IntermediateField.inclusion hLE₀ c : E₀) : AlgebraicClosure F)
      _ = ∏ _j ∈ Finset.range f₀, algebraMap L (AlgebraicClosure F) c :=
          Finset.prod_congr rfl (fun j _ => h_τ_pow_L j c)
      _ = (algebraMap L (AlgebraicClosure F) c) ^ f₀ := by
          rw [Finset.prod_const, Finset.card_range]
  have h_norm_πL_E₀ : normLM F hLE₀ (π_L_E₀ : E₀) = (π_L : L) ^ f₀ :=
    h_norm_inc_L (π_L : L)
  let e_LE₀ : E₀ ≃ₐ[F] IntermediateField.extendScalars hLE₀ := {
    toFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLE₀).mpr y.2⟩
    invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLE₀).mp y.2⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl
    map_mul' := fun _ _ => rfl
    map_add' := fun _ _ => rfl
    commutes' := fun _ => rfl
  }
  haveI : FiniteDimensional F (IntermediateField.extendScalars hLE₀) :=
    Module.Finite.equiv e_LE₀.toLinearEquiv
  haveI : FiniteDimensional L (IntermediateField.extendScalars hLE₀) :=
    FiniteDimensional.right F L (IntermediateField.extendScalars hLE₀)
  have hrel_E₀_eq_norm : ∀ z : E₀, relVal F E₀ z = relVal F L (normLM F hLE₀ z) := by
    intro z
    change addVal F (Algebra.norm F z) =
      addVal F (Algebra.norm F (Algebra.norm L (e_LE₀ z)))
    rw [Algebra.norm_norm, Algebra.norm_eq_of_algEquiv e_LE₀]
  have hπ_L_E₀_val : valL F E₀ π_L_E₀ = 1 := by
    have hrel_eq := hrel_E₀_eq_norm (π_L_E₀ : E₀)
    have hrel_E₀ := relVal_eq_resDeg_mul_valL F E₀ π_L_E₀
    have hrel_L := relVal_eq_resDeg_mul_valL F L (π_L ^ (f₀ : ℤ))
    change relVal F L ((π_L : L) ^ f₀) =
      (resDeg F L : ℤ) * valL F L ((π_L ^ (f₀ : ℤ) : Lˣ) : L) at hrel_L
    rw [valL_L_zpow, hπ_L, mul_one] at hrel_L
    have hres_cast : (resDeg F E₀ : ℤ) = (resDeg F L : ℤ) * (f₀ : ℤ) := by
      exact_mod_cast hres_E₀
    rw [hrel_eq, h_norm_πL_E₀, hrel_L, ← hres_cast] at hrel_E₀
    apply mul_left_cancel₀ hfE₀_ne
    linarith
  have hz_int : IsIntegral 𝒪[F] (((v₁ : E₀) - 1) / (π_L_E₀ : E₀) ^ m) :=
    (h_div_iff_E₀ π_L_E₀ hπ_L_E₀_val m ((v₁ : E₀) - 1)).mp hv₁_congr
  let z_E₀ : E₀ := ((v₁ : E₀) - 1) / (π_L_E₀ : E₀) ^ m
  have hπ_L_E₀_int : IsIntegral 𝒪[F] (π_L_E₀ : E₀) := by
    have h := (h_div_iff_E₀ π_L_E₀ hπ_L_E₀_val 0 (π_L_E₀ : E₀)).mp
      (Or.inr (by rw [hπ_L_E₀_val]; omega))
    simpa using h
  have hπ_E₀_pow_int : IsIntegral 𝒪[F] ((π_L_E₀ : E₀) ^ m) := IsIntegral.pow hπ_L_E₀_int m
  have hv₁_E₀_eq : (v₁ : E₀) = 1 + (π_L_E₀ : E₀) ^ m * z_E₀ := by
    have hpow_ne : (π_L_E₀ : E₀) ^ m ≠ 0 := pow_ne_zero m (Units.ne_zero π_L_E₀)
    dsimp [z_E₀]
    rw [mul_div_cancel₀ _ hpow_ne, add_sub_cancel]
  have h_eτ_pow_πL : ∀ n : ℕ, (e_τ ^ n) (π_L_E₀ : E₀) = (π_L_E₀ : E₀) := by
    intro n
    apply Subtype.ext
    rw [h_eτ_pow_coe]
    exact h_τ_pow_L n (π_L : L)
  have h_eτ_pow_int : ∀ (n : ℕ) (x : E₀), IsIntegral 𝒪[F] x → IsIntegral 𝒪[F] ((e_τ ^ n) x) := by
    intro n x hx
    rw [isIntegral_iff_eq_zero_or_relVal_nonneg F E₀] at hx ⊢
    rcases hx with rfl | hle
    · left
      exact map_zero (e_τ ^ n)
    · right
      change 0 ≤ addVal F (Algebra.norm F ((e_τ ^ n) x))
      rw [Algebra.norm_eq_of_algEquiv (e_τ ^ n) x]
      exact hle
  have h_prod_int : ∀ n : ℕ, ∃ y_n : E₀,
      IsIntegral 𝒪[F] y_n ∧
      ∏ j ∈ Finset.range n, (e_τ ^ j) (v₁ : E₀) = 1 + (π_L_E₀ : E₀) ^ m * y_n := by
    intro n
    induction n with
    | zero =>
      refine ⟨0, isIntegral_zero, ?_⟩
      simp
    | succ n ih =>
      obtain ⟨y_n, hy_n_int, hy_n_eq⟩ := ih
      let z_n : E₀ := (e_τ ^ n) z_E₀
      have hz_n_int : IsIntegral 𝒪[F] z_n := h_eτ_pow_int n z_E₀ hz_int
      have h_term : (e_τ ^ n) (v₁ : E₀) = 1 + (π_L_E₀ : E₀) ^ m * z_n := by
        conv_lhs => rw [hv₁_E₀_eq]
        rw [map_add, map_one, map_mul, map_pow, h_eτ_pow_πL n]
      refine ⟨y_n + z_n + (π_L_E₀ : E₀) ^ m * y_n * z_n,
        IsIntegral.add (IsIntegral.add hy_n_int hz_n_int)
          (IsIntegral.mul (IsIntegral.mul hπ_E₀_pow_int hy_n_int) hz_n_int), ?_⟩
      rw [Finset.prod_range_succ, hy_n_eq, h_term]
      ring
  obtain ⟨y_f₀, hy_f₀_int, hy_f₀_eq⟩ := h_prod_int f₀
  have h_prod_eq_norm : ∏ j ∈ Finset.range f₀, (e_τ ^ j) (v₁ : E₀) =
      IntermediateField.inclusion hLE₀ (normLM F hLE₀ (v₁ : E₀)) := by
    apply (algebraMap E₀ (AlgebraicClosure F)).injective
    rw [map_prod]
    calc ∏ j ∈ Finset.range f₀, (algebraMap E₀ (AlgebraicClosure F)) ((e_τ ^ j) (v₁ : E₀))
      _ = ∏ j ∈ Finset.range f₀, (τ ^ j) ((v₁ : E₀) : AlgebraicClosure F) :=
          Finset.prod_congr rfl (fun j _ => h_eτ_pow_coe j (v₁ : E₀))
      _ = algebraMap L (AlgebraicClosure F) (normLM F hLE₀ (v₁ : E₀)) := hτ_prod (v₁ : E₀)
  rw [h_prod_eq_norm] at hy_f₀_eq
  have h_norm_v₁_div_eq : IntermediateField.inclusion hLE₀
      ((normLM F hLE₀ (v₁ : E₀) - 1) / (π_L : L) ^ m) = y_f₀ := by
    have hpow_ne : (π_L_E₀ : E₀) ^ m ≠ 0 := pow_ne_zero m (Units.ne_zero π_L_E₀)
    have h_inc_π : IntermediateField.inclusion hLE₀ (π_L : L) = (π_L_E₀ : E₀) := rfl
    rw [map_div₀, map_sub, map_one, map_pow, h_inc_π, hy_f₀_eq, add_sub_cancel_left,
      mul_div_cancel_left₀ _ hpow_ne]
  have h_inc_int_iff : ∀ c : L,
      IsIntegral 𝒪[F] (IntermediateField.inclusion hLE₀ c) → IsIntegral 𝒪[F] c := by
    intro c hc
    rw [isIntegral_iff_eq_zero_or_relVal_nonneg F E₀] at hc
    rw [isIntegral_iff_eq_zero_or_relVal_nonneg F L]
    by_cases hc0 : c = 0
    · exact Or.inl hc0
    · right
      have hinc_ne : IntermediateField.inclusion hLE₀ c ≠ 0 :=
        (map_ne_zero (IntermediateField.inclusion hLE₀)).mpr hc0
      have hrel := hc.resolve_left hinc_ne
      rw [hrel_E₀_eq_norm, h_norm_inc_L] at hrel
      let u_c : Lˣ := Units.mk0 c hc0
      have h_zpow := relVal_units_zpow L u_c (f₀ : ℤ)
      change relVal F L (c ^ f₀) = (f₀ : ℤ) * relVal F L c at h_zpow
      rw [h_zpow] at hrel
      have hf₀_pos : (0 : ℤ) < (f₀ : ℤ) := by omega
      exact nonneg_of_mul_nonneg_right hrel hf₀_pos
  have h_norm_v₁_int : IsIntegral 𝒪[F] ((normLM F hLE₀ (v₁ : E₀) - 1) / (π_L : L) ^ m) := by
    apply h_inc_int_iff
    rw [h_norm_v₁_div_eq]
    exact hy_f₀_int
  let a_u : L := ((Units.map (normLM F hLK) u_poly : Lˣ) : L)
  let b_v : L := ((Units.map (normLM F hLK) v_rem : Lˣ) : L)
  have ha_u_eq : a_u = normLM F hLE₀ (v₁ : E₀) := congr_arg Units.val h_upoly_norm_eq
  have ha_u_int : IsIntegral 𝒪[F] ((a_u - 1) / (π_L : L) ^ m) := by
    rw [ha_u_eq]
    exact h_norm_v₁_int
  have hb_v_sub : b_v - 1 = 0 ∨ (m : ℤ) ≤ valL F L (b_v - 1) :=
    h_vrem_norm.imp sub_eq_zero.mpr id
  have hb_v_int : IsIntegral 𝒪[F] ((b_v - 1) / (π_L : L) ^ m) :=
    (h_div_iff_L m (b_v - 1)).mp hb_v_sub
  have hπL_int : IsIntegral 𝒪[F] (π_L : L) := by
    have h := (h_div_iff_L 0 (π_L : L)).mp (Or.inr (by rw [hπ_L]; omega))
    simpa using h
  have hπL_pow_int : IsIntegral 𝒪[F] ((π_L : L) ^ m) := IsIntegral.pow hπL_int m
  have hb_v_elem_int : IsIntegral 𝒪[F] b_v := by
    have hpow_ne : (π_L : L) ^ m ≠ 0 := pow_ne_zero m hπL_ne
    have h_eq : b_v = 1 + (π_L : L) ^ m * ((b_v - 1) / (π_L : L) ^ m) := by
      rw [mul_div_cancel₀ _ hpow_ne, add_sub_cancel]
    rw [h_eq]
    exact IsIntegral.add isIntegral_one (IsIntegral.mul hπL_pow_int hb_v_int)
  have hab_int : IsIntegral 𝒪[F] ((a_u * b_v - 1) / (π_L : L) ^ m) := by
    have h_eq : (a_u * b_v - 1) / (π_L : L) ^ m =
        ((a_u - 1) / (π_L : L) ^ m) * b_v + (b_v - 1) / (π_L : L) ^ m := by
      ring
    rw [h_eq]
    exact IsIntegral.add (IsIntegral.mul ha_u_int hb_v_elem_int) hb_v_int
  have hab_congr : a_u * b_v - 1 = 0 ∨ (m : ℤ) ≤ valL F L (a_u * b_v - 1) :=
    (h_div_iff_L m (a_u * b_v - 1)).mpr hab_int
  have hw₀_norm_coe : ((Units.map (normLM F hLK) w₀ : Lˣ) : L) = a_u * b_v := by
    rw [hw₀_eq, map_mul, Units.val_mul]
  rw [hw₀_norm_coe]
  exact hab_congr.imp sub_eq_zero.mp id

theorem exists_intermediateField_fixingSubgroup_and_valL_normLM_mul_inv_sub_one_ge (F : Type u)
    [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (u : Lˣ) :
    valL F L u = 0 → ∀ (f₀ m : ℕ), 1 ≤ f₀ → 1 ≤ m → ∀ (σ : AbsGal F),
      σ ∈ L.fixingSubgroup →
      ActsAsFrobPow F σ (-((resDeg F L : ℤ) * (f₀ : ℤ))) →
      (∀ α : AlgebraicClosure F,
        isLubinTateRoot F L (chosenUniformizer F L) m α →
        σ α = lubinTateFrob F L (u * chosenUniformizer F L) α) →
      ∃ (K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K),
        FiniteDimensional F K ∧
        σ ∈ K.fixingSubgroup ∧
        resDeg F K = resDeg F L * f₀ ∧
        ∀ (z : Kˣ), valL F K z = 1 →
          ((Units.map (normLM F hLK) z * (u * (chosenUniformizer F L) ^ (f₀ : ℤ))⁻¹ : Lˣ) : L) = 1 ∨
          (m : ℤ) ≤ valL F L
            (((Units.map (normLM F hLK) z *
              (u * (chosenUniformizer F L) ^ (f₀ : ℤ))⁻¹ : Lˣ) : L) - 1) :=
by
  intro hu f₀ m hf₀ hm σ hσL hσFrob hσ_apply
  let π_L := chosenUniformizer F L
  let E₀ := unramDegSubfield F L f₀
  let hLE₀ : L ≤ E₀ := le_sup_left
  obtain ⟨hFin_E₀, hσE₀, hres_E₀, τ, v, hτL, hτFrob, hτσ_unram, hτE₀, hτf₀_E₀,
    hτ_prod, hτ_norm_coeff, hv_val, hv_norm, hϖ_val, hϖ_norm⟩ :=
    exists_unramDegSubfield_frob_and_normLM_eq F L u hu f₀ hf₀ σ hσL hσFrob
  haveI : FiniteDimensional F E₀ := hFin_E₀
  let ϖ : E₀ˣ := v * Units.map (IntermediateField.inclusion hLE₀).toMonoidHom π_L
  have hϖ_coe : ((ϖ : E₀) : AlgebraicClosure F) =
      ((v : E₀) : AlgebraicClosure F) * algebraMap L (AlgebraicClosure F) (π_L : L) := rfl
  have h_v_prod : ∏ j ∈ Finset.range f₀, (τ ^ j) ((v : E₀) : AlgebraicClosure F) =
      algebraMap L (AlgebraicClosure F) (u : L) := by
    have h1 := hτ_prod (v : E₀)
    have h2 : normLM F hLE₀ (v : E₀) = (u : L) := congr_arg Units.val hv_norm
    rw [h2] at h1
    exact h1
  obtain ⟨hDm_monic, hDm_deg, hDm_c0, hDm_c0_val, hDm_irr, hFm_eq⟩ :=
    relLubinTateDivPoly_monic_coeff_zero_and_irreducible F L E₀ τ hτE₀ ϖ hϖ_val m hm
  let D_m := relLubinTateDivPoly F L E₀ τ (ϖ : E₀) m
  let F_m := relLubinTateIterPoly F L E₀ τ (ϖ : E₀) m
  obtain ⟨π_m, hπ_m_Dm⟩ :=
    IsAlgClosed.exists_aeval_eq_zero (AlgebraicClosure F) D_m hDm_irr.degree_pos.ne'
  have hπ_m_Fm : Polynomial.aeval π_m F_m = 0 := by
    change Polynomial.aeval π_m (relLubinTateIterPoly F L E₀ τ (ϖ : E₀) m) = 0
    rw [hFm_eq, map_mul, hπ_m_Dm, mul_zero]
  let K : IntermediateField F (AlgebraicClosure F) := E₀ ⊔ IntermediateField.adjoin F {π_m}
  let hE₀K : E₀ ≤ K := le_sup_left
  let hLK : L ≤ K := hLE₀.trans hE₀K
  let A : IntermediateField E₀ (AlgebraicClosure F) := IntermediateField.extendScalars hE₀K
  have hK_le : K ≤
      (IntermediateField.adjoin ↥E₀ ({π_m} : Set (AlgebraicClosure F))).restrictScalars F := by
    apply sup_le
    · intro x hx
      exact (IntermediateField.mem_restrictScalars F).mpr
        ((IntermediateField.adjoin ↥E₀ ({π_m} : Set (AlgebraicClosure F))).algebraMap_mem ⟨x, hx⟩)
    · rw [IntermediateField.adjoin_simple_le_iff]
      exact (IntermediateField.mem_restrictScalars F).mpr
        (IntermediateField.mem_adjoin_simple_self ↥E₀ π_m)
  have hA : A = IntermediateField.adjoin ↥E₀ ({π_m} : Set (AlgebraicClosure F)) := by
    apply le_antisymm
    · intro z hz
      exact (IntermediateField.mem_restrictScalars F).mp
        (hK_le ((IntermediateField.mem_extendScalars hE₀K).mp hz))
    · rw [IntermediateField.adjoin_simple_le_iff]
      exact (IntermediateField.mem_extendScalars hE₀K).mpr
        ((le_sup_right : IntermediateField.adjoin F ({π_m} : Set (AlgebraicClosure F)) ≤ K)
          (IntermediateField.mem_adjoin_simple_self F π_m))
  haveI : Finite ↑({π_m} : Set (AlgebraicClosure F)) := (Set.finite_singleton π_m).to_subtype
  haveI : FiniteDimensional F (IntermediateField.adjoin F ({π_m} : Set (AlgebraicClosure F))) :=
    IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)
  haveI : FiniteDimensional F K :=
    IntermediateField.finiteDimensional_sup E₀
      (IntermediateField.adjoin F ({π_m} : Set (AlgebraicClosure F)))
  let e_E₀K : K ≃ₐ[F] A := {
    toFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hE₀K).mpr y.2⟩
    invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hE₀K).mp y.2⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl
    map_mul' := fun _ _ => rfl
    map_add' := fun _ _ => rfl
    commutes' := fun _ => rfl
  }
  haveI : FiniteDimensional F A := Module.Finite.equiv e_E₀K.toLinearEquiv
  haveI : FiniteDimensional E₀ A := FiniteDimensional.right F E₀ A
  have hσ_πm : σ π_m = π_m :=
    apply_eq_of_aeval_relLubinTateIterPoly_eq_zero F L u hu f₀ m hf₀ hm σ τ hσL hτL hτFrob
      hτσ_unram hσ_apply hres_E₀ hτE₀ hτf₀_E₀ v hv_val h_v_prod ϖ hϖ_coe π_m hπ_m_Fm
  have hσK : σ ∈ K.fixingSubgroup := by
    change σ ∈ (E₀ ⊔ IntermediateField.adjoin F {π_m}).fixingSubgroup
    rw [IntermediateField.fixingSubgroup_sup, Subgroup.mem_inf]
    refine ⟨hσE₀, ?_⟩
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    induction hx using IntermediateField.adjoin_induction with
    | mem y hy =>
      rw [Set.mem_singleton_iff.mp hy]
      exact hσ_πm
    | algebraMap r => exact AlgEquiv.commutes σ r
    | add a b _ _ ha hb => rw [map_add, ha, hb]
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
    | inv a _ ha => rw [map_inv₀, ha]
  have hσFrob_E₀ : ActsAsFrobPow F σ (-(resDeg F E₀ : ℤ)) := by
    have hcast : (resDeg F E₀ : ℤ) = (resDeg F L : ℤ) * (f₀ : ℤ) := by
      exact_mod_cast hres_E₀
    rw [hcast]
    exact hσFrob
  have hres_K_E₀ : resDeg F K = resDeg F E₀ :=
    resDeg_eq_of_actsAsFrobPow_neg_resDeg_and_mem_fixingSubgroup F E₀ K hE₀K σ hσFrob_E₀ hσK
  have hres_K : resDeg F K = resDeg F L * f₀ := hres_K_E₀.trans hres_E₀
  obtain ⟨z_lvl, hz_lvl⟩ :=
    exists_norm_eq_of_eq_adjoin_of_irreducible_monic F E₀ A D_m π_m hA hDm_monic hDm_irr hπ_m_Dm
