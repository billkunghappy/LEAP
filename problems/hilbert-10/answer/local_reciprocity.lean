  let eΨ : (Fin f₀ → 𝓀[F]) ≃ (integralClosure 𝒪[F] L ⧸ Ideal.span {π₀}) :=
    Equiv.ofBijective Ψ ⟨hΨ_inj, hΨ_surj⟩
  letI : Fintype (integralClosure 𝒪[F] L ⧸ Ideal.span {π₀}) :=
    Fintype.ofEquiv (Fin f₀ → 𝓀[F]) eΨ
  have hcard : Fintype.card (integralClosure 𝒪[F] L ⧸ Ideal.span {π₀}) = qL F L := by
    rw [Fintype.ofEquiv_card eΨ, Fintype.card_fun, Fintype.card_fin, hf₀, qL, q,
      Nat.card_eq_fintype_card]
  intro c hc
  let c₀ : integralClosure 𝒪[F] L := ⟨c, hc⟩
  have hfermat : Ideal.Quotient.mk (Ideal.span {π₀}) (c₀ ^ qL F L) =
      Ideal.Quotient.mk (Ideal.span {π₀}) c₀ := by
    rw [← hcard]
    exact h_quot_pow (Ideal.span {π₀}) c₀
  have hmem : c₀ ^ qL F L - c₀ ∈ Ideal.span {π₀} := Ideal.Quotient.eq.mp hfermat
  rw [mem_I_iff] at hmem
  exact hmem

theorem aeval_pow_qL_minpoly_eq_zero (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] :
    (∀ c : L, IsIntegral 𝒪[F] c →
      IsIntegral 𝒪[F] ((c ^ qL F L - c) / (chosenUniformizer F L : L))) →
    IsIntegral 𝒪[F] ((p F : L) / (chosenUniformizer F L : L)) →
    (∀ m : ℕ, 0 < m → ¬ p F ∣ m →
      ¬ IsIntegral 𝒪[F] ((m : L) / (chosenUniformizer F L : L))) →
    ∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ →
      Polynomial.aeval (ζ ^ qL F L) (minpoly L ζ) = 0 :=
by
  intro h_frob h_p h_not_int ζ hζ
  obtain ⟨m, hm_pos, hpm, hζ_m⟩ := hζ
  haveI : IsFractionRing 𝒪[F] F :=
    Valuation.Integers.isFractionRing (Valuation.integer.integers (valuation F))
  let R := ↥(integralClosure 𝒪[F] L)
  haveI : IsFractionRing R L := integralClosure.isFractionRing_of_finite_extension F L
  haveI : IsIntegrallyClosed R := integralClosure.isIntegrallyClosedOfFiniteExtension F
  have h_gauss_deriv :
      ∀ (R K E : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R]
        [Field K] [Algebra R K] [IsFractionRing R K] [Field E] [Algebra K E]
        (ζ y : E) (m : ℕ), 0 < m → ζ ^ m = 1 → y ^ m = 1 →
          Polynomial.aeval y (minpoly K ζ) ≠ 0 →
          ∃ (P₀ B : Polynomial R),
            Polynomial.aeval ζ (Polynomial.map (algebraMap R K) P₀) = 0 ∧
            minpoly K ζ = Polynomial.map (algebraMap R K) P₀ ∧
            (m : E) = (Polynomial.aeval y (minpoly K ζ)) *
              (y * Polynomial.aeval y (Polynomial.map (algebraMap R K) B)) := by
    clear * -
    intro R K E _ _ _ _ _ _ _ _ ζ y m hm_pos hζ_m hy_m hne
    letI : Algebra R E := ((algebraMap K E).comp (algebraMap R K)).toAlgebra
    haveI : IsScalarTower R K E := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Module.IsTorsionFree R E := Module.IsTorsionFree.trans_faithfulSMul R K E
    have hζ_int : IsIntegral R ζ := IsIntegral.of_pow hm_pos (by rw [hζ_m]; exact isIntegral_one)
    set P₀ := minpoly R ζ
    have hP₀_ζ : Polynomial.aeval ζ P₀ = 0 := minpoly.aeval R ζ
    have hmin_eq : minpoly K ζ = Polynomial.map (algebraMap R K) P₀ :=
      minpoly.isIntegrallyClosed_eq_field_fractions' K hζ_int
    have hP₀_y : Polynomial.aeval y (minpoly K ζ) = Polynomial.aeval y P₀ := by
      rw [hmin_eq, Polynomial.aeval_map_algebraMap]
    have hP₀_y_ne : Polynomial.aeval y P₀ ≠ 0 := hP₀_y ▸ hne
    have h_aeval_Xm1 : Polynomial.aeval ζ (Polynomial.X ^ m - 1 : Polynomial R) = 0 := by
      simp [hζ_m]
    obtain ⟨Q₀, hQ₀⟩ := minpoly.isIntegrallyClosed_dvd hζ_int h_aeval_Xm1
    have h_eval_y : (0 : E) = (Polynomial.aeval y P₀) * (Polynomial.aeval y Q₀) := by
      calc (0 : E) = y ^ m - 1 := by rw [hy_m, sub_self]
        _ = Polynomial.aeval y (Polynomial.X ^ m - 1 : Polynomial R) := by simp
        _ = (Polynomial.aeval y P₀) * (Polynomial.aeval y Q₀) := by rw [hQ₀, map_mul]
    have hQ₀_y : Polynomial.aeval y Q₀ = 0 :=
      (mul_eq_zero.mp h_eval_y.symm).resolve_left hP₀_y_ne
    have h_deriv := congr_arg Polynomial.derivative hQ₀
    rw [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_one,
        sub_zero, Polynomial.derivative_mul] at h_deriv
    have h_deriv_y := congr_arg (Polynomial.aeval y) h_deriv
    simp only [map_mul, map_add, Polynomial.aeval_X_pow, map_natCast,
      hQ₀_y, mul_zero, zero_add] at h_deriv_y
    refine ⟨P₀, Polynomial.derivative Q₀, ?_, hmin_eq, ?_⟩
    · rw [Polynomial.aeval_map_algebraMap, hP₀_ζ]
    · rw [hP₀_y, Polynomial.aeval_map_algebraMap]
      calc (m : E) = (m : E) * 1 := (mul_one _).symm
        _ = (m : E) * (y ^ (m - 1) * y) := by
            rw [← pow_succ, Nat.sub_add_cancel hm_pos, hy_m]
        _ = ((m : E) * y ^ (m - 1)) * y := (mul_assoc _ _ _).symm
        _ = ((Polynomial.aeval y P₀) * (Polynomial.aeval y (Polynomial.derivative Q₀))) * y := by
            rw [h_deriv_y]
        _ = (Polynomial.aeval y P₀) * (y * Polynomial.aeval y (Polynomial.derivative Q₀)) := by ring
  let π_L : L := (chosenUniformizer F L : L)
  let π_bar : AlgebraicClosure F := algebraMap L (AlgebraicClosure F) π_L
  let I : AlgebraicClosure F → Prop := fun z => IsIntegral 𝒪[F] (z / π_bar)
  have I_zero : I 0 := by
    change IsIntegral 𝒪[F] (0 / π_bar)
    rw [zero_div]
    exact isIntegral_zero
  have I_add : ∀ {z₁ z₂ : AlgebraicClosure F}, I z₁ → I z₂ → I (z₁ + z₂) := by
    intro z₁ z₂ h₁ h₂
    change IsIntegral 𝒪[F] ((z₁ + z₂) / π_bar)
    rw [add_div]
    exact h₁.add h₂
  have I_sub : ∀ {z₁ z₂ : AlgebraicClosure F}, I z₁ → I z₂ → I (z₁ - z₂) := by
    intro z₁ z₂ h₁ h₂
    change IsIntegral 𝒪[F] ((z₁ - z₂) / π_bar)
    rw [sub_div]
    exact h₁.sub h₂
  have I_mul_right : ∀ {z w : AlgebraicClosure F}, I z → IsIntegral 𝒪[F] w → I (z * w) := by
    intro z w hz hw
    change IsIntegral 𝒪[F] ((z * w) / π_bar)
    rw [mul_div_right_comm]
    exact hz.mul hw
  have I_sum : ∀ (s : Finset ℕ) (f : ℕ → AlgebraicClosure F),
      (∀ i ∈ s, I (f i)) → I (∑ i ∈ s, f i) := by
    intro s f hf
    induction s using Finset.induction_on with
    | empty =>
      rw [Finset.sum_empty]
      exact I_zero
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact I_add (hf a (Finset.mem_insert_self a s))
        (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi)))
  have I_p : I (p F : AlgebraicClosure F) := by
    change IsIntegral 𝒪[F] ((p F : AlgebraicClosure F) / algebraMap L (AlgebraicClosure F) π_L)
    have h_eq : (p F : AlgebraicClosure F) / algebraMap L (AlgebraicClosure F) π_L =
        algebraMap L (AlgebraicClosure F) ((p F : L) / π_L) := by
      rw [map_div₀, map_natCast]
    rw [h_eq]
    exact (isIntegral_algebraMap_iff (algebraMap L (AlgebraicClosure F)).injective).mpr h_p
  have hqL_pow : ∃ n : ℕ, Nat.Prime (p F) ∧ qL F L = (p F) ^ n := by
    haveI : Finite 𝓀[F] :=
      IsNonarchimedeanLocalField.instFiniteResidueFieldSubtypeMemSubringIntegerValueGroupWithZeroValuation F
    letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
    haveI : CharP 𝓀[F] (p F) := ringChar.charP 𝓀[F]
    obtain ⟨d, hp, hcard⟩ := FiniteField.card 𝓀[F] (p F)
    refine ⟨(d : ℕ) * resDeg F L, hp, ?_⟩
    unfold qL q
    rw [Nat.card_eq_fintype_card, hcard, ← pow_mul]
  obtain ⟨n_qL, hp, hqL_eq⟩ := hqL_pow
  have hqL_pos : 0 < qL F L := by
    rw [hqL_eq]
    exact pow_pos hp.pos n_qL
  have I_add_pow : ∀ {x w : AlgebraicClosure F},
      IsIntegral 𝒪[F] x → IsIntegral 𝒪[F] w →
      I ((x + w) ^ qL F L - (x ^ qL F L + w ^ qL F L)) := by
    intro x w hx hw
    rcases eq_or_lt_of_le (Nat.succ_le_of_lt hqL_pos) with h1 | hgt1
    · rw [← h1, pow_one, pow_one, pow_one, sub_self]
      exact I_zero
    · have hqL_split : qL F L + 1 = (qL F L - 1) + 1 + 1 := by omega
      have h_sum_split : ∑ m ∈ Finset.range (qL F L + 1),
          x ^ m * w ^ (qL F L - m) * ((qL F L).choose m : AlgebraicClosure F) =
          ((∑ j ∈ Finset.range (qL F L - 1),
            x ^ (j + 1) * w ^ (qL F L - (j + 1)) * ((qL F L).choose (j + 1) : AlgebraicClosure F)) +
            x ^ 0 * w ^ (qL F L - 0) * ((qL F L).choose 0 : AlgebraicClosure F)) +
          x ^ ((qL F L - 1) + 1) * w ^ (qL F L - ((qL F L - 1) + 1)) *
            ((qL F L).choose ((qL F L - 1) + 1) : AlgebraicClosure F) := by
        rw [hqL_split, Finset.sum_range_succ, Finset.sum_range_succ']
      have h_binom : (x + w) ^ qL F L - (x ^ qL F L + w ^ qL F L) =
          ∑ j ∈ Finset.range (qL F L - 1),
            x ^ (j + 1) * w ^ (qL F L - (j + 1)) * ((qL F L).choose (j + 1) : AlgebraicClosure F) := by
        rw [add_pow, h_sum_split]
        have h_sub1 : (qL F L - 1) + 1 = qL F L := by omega
        have h_top : x ^ ((qL F L - 1) + 1) * w ^ (qL F L - ((qL F L - 1) + 1)) *
            ((qL F L).choose ((qL F L - 1) + 1) : AlgebraicClosure F) = x ^ qL F L := by
          rw [h_sub1, Nat.sub_self, pow_zero, mul_one, Nat.choose_self, Nat.cast_one, mul_one]
        have h_bot : x ^ 0 * w ^ (qL F L - 0) * ((qL F L).choose 0 : AlgebraicClosure F) = w ^ qL F L := by
          rw [pow_zero, one_mul, Nat.sub_zero, Nat.choose_zero_right, Nat.cast_one, mul_one]
        rw [h_top, h_bot]
        ring
      rw [h_binom]
      apply I_sum
      intro j hj
      have hj_lt : j < qL F L - 1 := Finset.mem_range.mp hj
      have hk_ne_zero : j + 1 ≠ 0 := by omega
      have hk_ne_qL : j + 1 ≠ (p F) ^ n_qL := by omega
      have hdvd : p F ∣ (qL F L).choose (j + 1) := by
        rw [hqL_eq]
        exact hp.dvd_choose_pow hk_ne_zero hk_ne_qL
      obtain ⟨c, hc⟩ := hdvd
      have h_term : x ^ (j + 1) * w ^ (qL F L - (j + 1)) * ((qL F L).choose (j + 1) : AlgebraicClosure F) =
          (p F : AlgebraicClosure F) * (x ^ (j + 1) * w ^ (qL F L - (j + 1)) * (c : AlgebraicClosure F)) := by
        rw [hc, Nat.cast_mul]
        ring
      rw [h_term]
      apply I_mul_right I_p
      refine ((hx.pow (j + 1)).mul (hw.pow (qL F L - (j + 1)))).mul ?_
      have hc_eq : (c : AlgebraicClosure F) = algebraMap 𝒪[F] (AlgebraicClosure F) (c : 𝒪[F]) := by
        simp
      rw [hc_eq]
      exact isIntegral_algebraMap
  have I_sum_pow : ∀ (s : Finset ℕ) (f : ℕ → AlgebraicClosure F),
      (∀ i ∈ s, IsIntegral 𝒪[F] (f i)) →
      I ((∑ i ∈ s, f i) ^ qL F L - ∑ i ∈ s, (f i) ^ qL F L) := by
    intro s f hf
    induction s using Finset.induction_on with
    | empty =>
      rw [Finset.sum_empty, Finset.sum_empty, zero_pow hqL_pos.ne', sub_self]
      exact I_zero
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha]
      have h_split : (f a + ∑ i ∈ s, f i) ^ qL F L - (f a ^ qL F L + ∑ i ∈ s, f i ^ qL F L) =
          ((f a + ∑ i ∈ s, f i) ^ qL F L - (f a ^ qL F L + (∑ i ∈ s, f i) ^ qL F L)) +
          ((∑ i ∈ s, f i) ^ qL F L - ∑ i ∈ s, f i ^ qL F L) := by ring
      rw [h_split]
      have h_fa : IsIntegral 𝒪[F] (f a) := hf a (Finset.mem_insert_self a s)
      have h_sum_int : IsIntegral 𝒪[F] (∑ i ∈ s, f i) :=
        IsIntegral.sum _ (fun i hi => hf i (Finset.mem_insert_of_mem hi))
      exact I_add (I_add_pow h_fa h_sum_int)
        (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi)))
  set y := ζ ^ qL F L
  have hy_m : y ^ m = 1 := by
    change (ζ ^ qL F L) ^ m = 1
    rw [← pow_mul, mul_comm, pow_mul, hζ_m, one_pow]
  have hζ_int : IsIntegral 𝒪[F] ζ := IsIntegral.of_pow hm_pos (by rw [hζ_m]; exact isIntegral_one)
  have hy_int : IsIntegral 𝒪[F] y := hζ_int.pow (qL F L)
  by_contra hne
  have hR_int : ∀ r : R, IsIntegral 𝒪[F] (algebraMap L (AlgebraicClosure F) (r : L)) := by
    intro r
    exact (isIntegral_algebraMap_iff (algebraMap L (AlgebraicClosure F)).injective).mpr r.2
  have hR_frob : ∀ r : R,
      I ((algebraMap L (AlgebraicClosure F) (r : L)) ^ qL F L -
        algebraMap L (AlgebraicClosure F) (r : L)) := by
    intro r
    change IsIntegral 𝒪[F]
      (((algebraMap L (AlgebraicClosure F) (r : L)) ^ qL F L -
        algebraMap L (AlgebraicClosure F) (r : L)) / algebraMap L (AlgebraicClosure F) π_L)
    have h_eq : ((algebraMap L (AlgebraicClosure F) (r : L)) ^ qL F L -
        algebraMap L (AlgebraicClosure F) (r : L)) / algebraMap L (AlgebraicClosure F) π_L =
        algebraMap L (AlgebraicClosure F) (((r : L) ^ qL F L - (r : L)) / π_L) := by
      rw [map_div₀, map_sub, map_pow]
    rw [h_eq]
    exact (isIntegral_algebraMap_iff (algebraMap L (AlgebraicClosure F)).injective).mpr
      (h_frob (r : L) r.2)
  obtain ⟨P₀, B, hP₀_ζ, hmin_eq, hm_eq⟩ :=
    h_gauss_deriv R L (AlgebraicClosure F) ζ y m hm_pos hζ_m hy_m hne
  set P₁ := Polynomial.map (algebraMap R L) P₀
  set B₁ := Polynomial.map (algebraMap R L) B
  let N := P₁.natDegree + 1
  let c : ℕ → AlgebraicClosure F := fun i => algebraMap L (AlgebraicClosure F) (P₁.coeff i)
  have hc_int : ∀ i : ℕ, IsIntegral 𝒪[F] (c i) := by
    intro i
    dsimp [c, P₁]
    rw [Polynomial.coeff_map]
    exact hR_int (P₀.coeff i)
  have hc_frob : ∀ i : ℕ, I (c i ^ qL F L - c i) := by
    intro i
    dsimp [c, P₁]
    rw [Polynomial.coeff_map]
    exact hR_frob (P₀.coeff i)
  have hP₁_ζ_sum : Polynomial.aeval ζ P₁ = ∑ i ∈ Finset.range N, c i * ζ ^ i := by
    rw [Polynomial.aeval_def, Polynomial.eval₂_eq_sum_range]
  have hP₁_y_sum : Polynomial.aeval y P₁ = ∑ i ∈ Finset.range N, c i * y ^ i := by
    rw [Polynomial.aeval_def, Polynomial.eval₂_eq_sum_range]
  have h_sum1 : I ((∑ i ∈ Finset.range N, c i * ζ ^ i) ^ qL F L -
      ∑ i ∈ Finset.range N, (c i * ζ ^ i) ^ qL F L) := by
    apply I_sum_pow
    intro i _
    exact (hc_int i).mul (hζ_int.pow i)
  have h_sum2 : I (∑ i ∈ Finset.range N, (c i * ζ ^ i) ^ qL F L -
      ∑ i ∈ Finset.range N, c i * y ^ i) := by
    have h_diff : ∑ i ∈ Finset.range N, (c i * ζ ^ i) ^ qL F L -
        ∑ i ∈ Finset.range N, c i * y ^ i =
        ∑ i ∈ Finset.range N, (c i ^ qL F L - c i) * y ^ i := by
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      have hy_pow : (ζ ^ i) ^ qL F L = y ^ i := by
        change (ζ ^ i) ^ qL F L = (ζ ^ qL F L) ^ i
        rw [← pow_mul, mul_comm, pow_mul]
      rw [mul_pow, hy_pow, sub_mul]
    rw [h_diff]
    apply I_sum
    intro i _
    exact I_mul_right (hc_frob i) (hy_int.pow i)
  have h_I_P₁_y : I (Polynomial.aeval y (minpoly L ζ)) := by
    rw [hmin_eq]
    have h_zero_pow : (∑ i ∈ Finset.range N, c i * ζ ^ i) ^ qL F L = 0 := by
      rw [← hP₁_ζ_sum, hP₀_ζ, zero_pow hqL_pos.ne']
    have h_comb := I_sub I_zero (I_add h_sum1 h_sum2)
    have h_alg : (0 : AlgebraicClosure F) -
        (((∑ i ∈ Finset.range N, c i * ζ ^ i) ^ qL F L -
          ∑ i ∈ Finset.range N, (c i * ζ ^ i) ^ qL F L) +
         (∑ i ∈ Finset.range N, (c i * ζ ^ i) ^ qL F L -
          ∑ i ∈ Finset.range N, c i * y ^ i)) = Polynomial.aeval y P₁ := by
      rw [h_zero_pow, hP₁_y_sum]
      ring
    rwa [h_alg] at h_comb
  have hB₁_int : IsIntegral 𝒪[F] (y * Polynomial.aeval y B₁) := by
    refine hy_int.mul ?_
    rw [Polynomial.aeval_def, Polynomial.eval₂_eq_sum_range]
    refine IsIntegral.sum _ fun j _ => ?_
    rw [Polynomial.coeff_map]
    exact (hR_int (B.coeff j)).mul (hy_int.pow j)
  have h_I_m : I (m : AlgebraicClosure F) := by
    rw [hm_eq]
    exact I_mul_right h_I_P₁_y hB₁_int
  have hm_int_bar : IsIntegral 𝒪[F] (algebraMap L (AlgebraicClosure F) ((m : L) / π_L)) := by
    have h_eq : algebraMap L (AlgebraicClosure F) ((m : L) / π_L) =
        (m : AlgebraicClosure F) / π_bar := by
      rw [map_div₀, map_natCast]
    rw [h_eq]
    exact h_I_m
  have hm_int_L : IsIntegral 𝒪[F] ((m : L) / π_L) :=
    (isIntegral_algebraMap_iff (algebraMap L (AlgebraicClosure F)).injective).mp hm_int_bar
  exact h_not_int m hm_pos hpm hm_int_L

theorem exists_fixingSubgroup_actsAsFrobPow_of_aeval_minpoly (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] :
    (∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ →
      Polynomial.aeval (ζ ^ qL F L) (minpoly L ζ) = 0) →
    ∃ τ : AbsGal F, τ ∈ L.fixingSubgroup ∧ ActsAsFrobPow F τ (-(resDeg F L : ℤ)) :=
by
  intro h_minpoly
  have h_galois_lift :
      ∀ (K E : Type u) [Field K] [Field E] [Algebra K E] [Normal K E] [Algebra.IsAlgebraic K E]
        (S : Set E) (N : ℕ),
        (1 : E) ∈ S →
        (∀ ξ₁ ∈ S, ∀ ξ₂ ∈ S, ∃ ξ ∈ S, (∃ k₁ : ℕ, ξ ^ k₁ = ξ₁) ∧ (∃ k₂ : ℕ, ξ ^ k₂ = ξ₂)) →
        (∀ ξ ∈ S, Polynomial.aeval (ξ ^ N) (minpoly K ξ) = 0) →
        ∃ σ : E ≃ₐ[K] E, ∀ ζ ∈ S, σ ζ = ζ ^ N := by
    intro K E _ _ _ _ _ S N h1 h_dir h_min
    have hex_phi : ∃ phi : ∀ (ξ : E), ξ ∈ S → IntermediateField.adjoin K {ξ} →ₐ[K] E,
        (∀ (ξ : E) (hξ : ξ ∈ S) (hmem : ξ ∈ IntermediateField.adjoin K {ξ}),
          phi ξ hξ ⟨ξ, hmem⟩ = ξ ^ N) ∧
        (∀ (ξ₁ ξ : E) (hξ₁ : ξ₁ ∈ S) (hξ : ξ ∈ S) (k : ℕ) (_ : ξ ^ k = ξ₁),
          ∃ h_le : IntermediateField.adjoin K {ξ₁} ≤ IntermediateField.adjoin K {ξ},
            ∀ (x : E) (hx₁ : x ∈ IntermediateField.adjoin K {ξ₁}),
              phi ξ hξ ⟨x, h_le hx₁⟩ = phi ξ₁ hξ₁ ⟨x, hx₁⟩) := by
      let pb : ∀ ξ : E, PowerBasis K (IntermediateField.adjoin K {ξ}) :=
        fun ξ => IntermediateField.adjoin.powerBasis (Algebra.IsIntegral.isIntegral ξ)
      have h_pb_gen : ∀ ξ : E, (pb ξ).gen = IntermediateField.AdjoinSimple.gen K ξ :=
        fun ξ => IntermediateField.adjoin.powerBasis_gen (Algebra.IsIntegral.isIntegral ξ)
      have h_pb_coe : ∀ ξ : E, ((pb ξ).gen : E) = ξ := by
        intro ξ
        rw [h_pb_gen, IntermediateField.AdjoinSimple.coe_gen]
      have h_aeval : ∀ (ξ : E), ξ ∈ S →
          Polynomial.aeval (ξ ^ N) (minpoly K (pb ξ).gen) = 0 := by
        intro ξ hξ
        rw [h_pb_gen, IntermediateField.minpoly_gen]
        exact h_min ξ hξ
      let phi : ∀ (ξ : E), ξ ∈ S → IntermediateField.adjoin K {ξ} →ₐ[K] E :=
        fun ξ hξ => (pb ξ).lift (ξ ^ N) (h_aeval ξ hξ)
      have phi_gen : ∀ (ξ : E) (hξ : ξ ∈ S), phi ξ hξ (pb ξ).gen = ξ ^ N :=
        fun ξ hξ => (pb ξ).lift_gen (ξ ^ N) (h_aeval ξ hξ)
      refine ⟨phi, ?_, ?_⟩
      · intro ξ hξ hmem
        have h_eq : (⟨ξ, hmem⟩ : IntermediateField.adjoin K {ξ}) = (pb ξ).gen :=
          Subtype.ext (h_pb_coe ξ).symm
        rw [h_eq]
        exact phi_gen ξ hξ
      · intro ξ₁ ξ hξ₁ hξ k hk
        have h_ξ_mem : ξ ∈ IntermediateField.adjoin K {ξ} :=
          IntermediateField.subset_adjoin K {ξ} (Set.mem_singleton ξ)
        have h_ξ₁_mem : ξ₁ ∈ IntermediateField.adjoin K {ξ} := hk ▸ pow_mem h_ξ_mem k
        have h_le : IntermediateField.adjoin K {ξ₁} ≤ IntermediateField.adjoin K {ξ} :=
          IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr h_ξ₁_mem)
        refine ⟨h_le, ?_⟩
        have h_comp : (phi ξ hξ).comp (IntermediateField.inclusion h_le) = phi ξ₁ hξ₁ := by
          apply (pb ξ₁).algHom_ext
          have h_inc_gen : IntermediateField.inclusion h_le (pb ξ₁).gen = (pb ξ).gen ^ k := by
            apply Subtype.ext
            rw [IntermediateField.coe_inclusion, SubmonoidClass.coe_pow, h_pb_coe, h_pb_coe, hk]
          rw [AlgHom.comp_apply, h_inc_gen, map_pow, phi_gen ξ hξ, phi_gen ξ₁ hξ₁,
            ← pow_mul, mul_comm, pow_mul, hk]
        intro x hx₁
        exact AlgHom.congr_fun h_comp ⟨x, hx₁⟩
    obtain ⟨phi, phi_self, phi_compat_pow⟩ := hex_phi
    have exists_common : ∀ (ξ₁ ξ₂ : E) (hξ₁ : ξ₁ ∈ S) (hξ₂ : ξ₂ ∈ S),
        ∃ (ξ : E) (hξ : ξ ∈ S)
          (h_le₁ : IntermediateField.adjoin K {ξ₁} ≤ IntermediateField.adjoin K {ξ})
          (h_le₂ : IntermediateField.adjoin K {ξ₂} ≤ IntermediateField.adjoin K {ξ}),
          (∀ (x : E) (hx₁ : x ∈ IntermediateField.adjoin K {ξ₁}),
            phi ξ hξ ⟨x, h_le₁ hx₁⟩ = phi ξ₁ hξ₁ ⟨x, hx₁⟩) ∧
          (∀ (x : E) (hx₂ : x ∈ IntermediateField.adjoin K {ξ₂}),
            phi ξ hξ ⟨x, h_le₂ hx₂⟩ = phi ξ₂ hξ₂ ⟨x, hx₂⟩) := by
      intro ξ₁ ξ₂ hξ₁ hξ₂
      obtain ⟨ξ, hξ, ⟨k₁, hk₁⟩, ⟨k₂, hk₂⟩⟩ := h_dir ξ₁ hξ₁ ξ₂ hξ₂
      obtain ⟨h_le₁, h_eq₁⟩ := phi_compat_pow ξ₁ ξ hξ₁ hξ k₁ hk₁
      obtain ⟨h_le₂, h_eq₂⟩ := phi_compat_pow ξ₂ ξ hξ₂ hξ k₂ hk₂
      exact ⟨ξ, hξ, h_le₁, h_le₂, h_eq₁, h_eq₂⟩
    have phi_indep : ∀ (x : E) (ξ₁ ξ₂ : E) (hξ₁ : ξ₁ ∈ S) (hξ₂ : ξ₂ ∈ S)
        (hx₁ : x ∈ IntermediateField.adjoin K {ξ₁}) (hx₂ : x ∈ IntermediateField.adjoin K {ξ₂}),
        phi ξ₁ hξ₁ ⟨x, hx₁⟩ = phi ξ₂ hξ₂ ⟨x, hx₂⟩ := by
      intro x ξ₁ ξ₂ hξ₁ hξ₂ hx₁ hx₂
      obtain ⟨ξ, hξ, h_le₁, h_le₂, h_eq₁, h_eq₂⟩ := exists_common ξ₁ ξ₂ hξ₁ hξ₂
      rw [← h_eq₁ x hx₁, ← h_eq₂ x hx₂]
    let U : IntermediateField K E := {
      carrier := {x : E | ∃ ξ, ξ ∈ S ∧ x ∈ IntermediateField.adjoin K {ξ}}
      algebraMap_mem' := fun r => ⟨1, h1, (IntermediateField.adjoin K {(1 : E)}).algebraMap_mem r⟩
      add_mem' := fun ⟨ξ₁, hξ₁, hx₁⟩ ⟨ξ₂, hξ₂, hx₂⟩ => by
        obtain ⟨ξ, hξ, h_le₁, h_le₂, -, -⟩ := exists_common ξ₁ ξ₂ hξ₁ hξ₂
        exact ⟨ξ, hξ, add_mem (h_le₁ hx₁) (h_le₂ hx₂)⟩
      zero_mem' := ⟨1, h1, zero_mem _⟩
      mul_mem' := fun ⟨ξ₁, hξ₁, hx₁⟩ ⟨ξ₂, hξ₂, hx₂⟩ => by
        obtain ⟨ξ, hξ, h_le₁, h_le₂, -, -⟩ := exists_common ξ₁ ξ₂ hξ₁ hξ₂
        exact ⟨ξ, hξ, mul_mem (h_le₁ hx₁) (h_le₂ hx₂)⟩
      one_mem' := ⟨1, h1, one_mem _⟩
      inv_mem' := fun _ ⟨ξ, hξ, hx⟩ => ⟨ξ, hξ, inv_mem hx⟩
    }
    have hU : ∀ x : E, x ∈ U → ∃ ξ, ξ ∈ S ∧ x ∈ IntermediateField.adjoin K {ξ} :=
      fun _ hx => hx
    obtain ⟨f, hf_eq⟩ : ∃ f : E → E,
        ∀ (x : E) (_ : x ∈ U) (ξ : E) (hξ : ξ ∈ S) (hx : x ∈ IntermediateField.adjoin K {ξ}),
          f x = phi ξ hξ ⟨x, hx⟩ := by
      refine ⟨fun x => if hxU : x ∈ U then
          phi (hU x hxU).choose (hU x hxU).choose_spec.1 ⟨x, (hU x hxU).choose_spec.2⟩
        else 0, ?_⟩
      intro x hxU ξ hξ hx
      dsimp only
      rw [dif_pos hxU]
      exact phi_indep x (hU x hxU).choose ξ (hU x hxU).choose_spec.1 hξ (hU x hxU).choose_spec.2 hx
    let Phi : U →ₐ[K] E := {
      toFun := fun u => f u.1
      map_one' := by
        change f 1 = 1
        rw [hf_eq 1 U.one_mem 1 h1 (one_mem _)]
        exact map_one (phi 1 h1)
      map_mul' := fun u₁ u₂ => by
        change f (u₁.1 * u₂.1) = f u₁.1 * f u₂.1
        obtain ⟨ξ₁, hξ₁, hx₁⟩ := hU u₁.1 u₁.2
        obtain ⟨ξ₂, hξ₂, hx₂⟩ := hU u₂.1 u₂.2
        obtain ⟨ξ, hξ, h_le₁, h_le₂, -, -⟩ := exists_common ξ₁ ξ₂ hξ₁ hξ₂
        rw [hf_eq (u₁.1 * u₂.1) (U.mul_mem u₁.2 u₂.2) ξ hξ (mul_mem (h_le₁ hx₁) (h_le₂ hx₂)),
            hf_eq u₁.1 u₁.2 ξ hξ (h_le₁ hx₁),
            hf_eq u₂.1 u₂.2 ξ hξ (h_le₂ hx₂)]
        exact map_mul (phi ξ hξ) ⟨u₁.1, h_le₁ hx₁⟩ ⟨u₂.1, h_le₂ hx₂⟩
      map_zero' := by
        change f 0 = 0
        rw [hf_eq 0 U.zero_mem 1 h1 (zero_mem _)]
        exact map_zero (phi 1 h1)
      map_add' := fun u₁ u₂ => by
        change f (u₁.1 + u₂.1) = f u₁.1 + f u₂.1
        obtain ⟨ξ₁, hξ₁, hx₁⟩ := hU u₁.1 u₁.2
        obtain ⟨ξ₂, hξ₂, hx₂⟩ := hU u₂.1 u₂.2
        obtain ⟨ξ, hξ, h_le₁, h_le₂, -, -⟩ := exists_common ξ₁ ξ₂ hξ₁ hξ₂
        rw [hf_eq (u₁.1 + u₂.1) (U.add_mem u₁.2 u₂.2) ξ hξ (add_mem (h_le₁ hx₁) (h_le₂ hx₂)),
            hf_eq u₁.1 u₁.2 ξ hξ (h_le₁ hx₁),
            hf_eq u₂.1 u₂.2 ξ hξ (h_le₂ hx₂)]
        exact map_add (phi ξ hξ) ⟨u₁.1, h_le₁ hx₁⟩ ⟨u₂.1, h_le₂ hx₂⟩
      commutes' := fun r => by
        change f (algebraMap K E r) = algebraMap K E r
        rw [hf_eq (algebraMap K E r) (U.algebraMap_mem r) 1 h1 ((IntermediateField.adjoin K {(1 : E)}).algebraMap_mem r)]
        exact (phi 1 h1).commutes r
    }
    let sigma₀ : E →ₐ[K] E := Phi.liftNormal E
    let σ : E ≃ₐ[K] E := AlgEquiv.ofBijective sigma₀ (Algebra.IsAlgebraic.algHom_bijective sigma₀)
    refine ⟨σ, ?_⟩
    intro ζ hζ
    have hζ_mem : ζ ∈ IntermediateField.adjoin K {ζ} :=
      IntermediateField.subset_adjoin K {ζ} (Set.mem_singleton ζ)
    have hζ_U : ζ ∈ U := ⟨ζ, hζ, hζ_mem⟩
    have h_comm : σ ζ = Phi ⟨ζ, hζ_U⟩ := Phi.liftNormal_commutes E ⟨ζ, hζ_U⟩
    rw [h_comm]
    change f ζ = ζ ^ N
    rw [hf_eq ζ hζ_U ζ hζ hζ_mem]
    exact phi_self ζ hζ hζ_mem
  have hp : Nat.Prime (p F) := by
    haveI : Finite 𝓀[F] :=
      IsNonarchimedeanLocalField.instFiniteResidueFieldSubtypeMemSubringIntegerValueGroupWithZeroValuation F
    letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
    haveI : CharP 𝓀[F] (p F) := ringChar.charP 𝓀[F]
    exact (FiniteField.card 𝓀[F] (p F)).choose_spec.1
  have h_one_root : IsPrimeToPRootOfUnity F 1 := ⟨1, zero_lt_one, hp.not_dvd_one, one_pow 1⟩
  have h_dir : ∀ ξ₁ ∈ ({ζ : AlgebraicClosure F | IsPrimeToPRootOfUnity F ζ} : Set (AlgebraicClosure F)),
      ∀ ξ₂ ∈ ({ζ : AlgebraicClosure F | IsPrimeToPRootOfUnity F ζ} : Set (AlgebraicClosure F)),
        ∃ ξ ∈ ({ζ : AlgebraicClosure F | IsPrimeToPRootOfUnity F ζ} : Set (AlgebraicClosure F)),
          (∃ k₁ : ℕ, ξ ^ k₁ = ξ₁) ∧ (∃ k₂ : ℕ, ξ ^ k₂ = ξ₂) := by
    intro ξ₁ ⟨m₁, hm₁_pos, hpm₁, hξ₁_m⟩ ξ₂ ⟨m₂, hm₂_pos, hpm₂, hξ₂_m⟩
    set m := m₁ * m₂
    have hm_pos : 0 < m := mul_pos hm₁_pos hm₂_pos
    have hpm : ¬ p F ∣ m := fun hdvd => (hp.dvd_mul.mp hdvd).elim hpm₁ hpm₂
    have hm_ne_zero_F : (m : F) ≠ 0 := by
      intro hm0
      have h_int_m : (m : 𝒪[F]) = 0 := Subtype.ext (by push_cast; exact hm0)
      have h_res : (m : 𝓀[F]) = 0 := by
        rw [← map_natCast (IsLocalRing.residue 𝒪[F]) m, h_int_m, map_zero]
      exact hpm ((ringChar.spec 𝓀[F] m).mp h_res)
    haveI : NeZero (m : F) := ⟨hm_ne_zero_F⟩
    haveI : NeZero m := ⟨hm_pos.ne'⟩
    obtain ⟨ξ, hξ_prim⟩ := (AlgebraicClosure.hasEnoughRootsOfUnity F m).prim
    have hξ : IsPrimeToPRootOfUnity F ξ := ⟨m, hm_pos, hpm, hξ_prim.pow_eq_one⟩
    have h1 : ξ₁ ^ m = 1 := by rw [pow_mul, hξ₁_m, one_pow]
    have h2 : ξ₂ ^ m = 1 := by rw [pow_mul', hξ₂_m, one_pow]
    obtain ⟨k₁, -, hk₁⟩ := hξ_prim.eq_pow_of_pow_eq_one h1
    obtain ⟨k₂, -, hk₂⟩ := hξ_prim.eq_pow_of_pow_eq_one h2
    exact ⟨ξ, hξ, ⟨k₁, hk₁⟩, ⟨k₂, hk₂⟩⟩
  haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
  haveI : Algebra.IsAlgebraic L (AlgebraicClosure F) := Algebra.IsAlgebraic.tower_top (K := F) L
  obtain ⟨σ_L, hσ_L⟩ := h_galois_lift L (AlgebraicClosure F)
    {ζ : AlgebraicClosure F | IsPrimeToPRootOfUnity F ζ} (qL F L) h_one_root h_dir h_minpoly
  let sigma_sub : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ_L
  let σ : AbsGal F := sigma_sub.1
  have hσ_mem : σ ∈ L.fixingSubgroup := sigma_sub.2
  have hσ_apply : ∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ → σ ζ = ζ ^ qL F L :=
    fun ζ hζ => hσ_L ζ hζ
  refine ⟨σ⁻¹, L.fixingSubgroup.inv_mem hσ_mem, ?_⟩
  intro ζ hζ
  obtain ⟨m, hm_pos, hpm, hζm⟩ := hζ
  have h_inv_root : IsPrimeToPRootOfUnity F (σ⁻¹ ζ) := by
    refine ⟨m, hm_pos, hpm, ?_⟩
    rw [← map_pow, hζm, map_one]
  have h_neg : (-(-(resDeg F L : ℤ))).toNat = resDeg F L := by simp
  have h_pos : (-(resDeg F L : ℤ)).toNat = 0 := by simp
  rw [h_neg, h_pos, pow_zero, pow_one]
  change (σ⁻¹ ζ) ^ qL F L = ζ
  rw [← hσ_apply (σ⁻¹ ζ) h_inv_root]
  exact AlgEquiv.apply_symm_apply σ ζ

theorem exists_actsAsFrobPow_neg_resDeg (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] :
    ∃ τ : AbsGal F, τ ∈ L.fixingSubgroup ∧ ActsAsFrobPow F τ (-(resDeg F L : ℤ)) :=
by
  obtain ⟨h_frob, h_p⟩ := isIntegral_pow_qL_sub_and_p_div_chosenUniformizer F L
  have h_not_int : ∀ m : ℕ, 0 < m → ¬ p F ∣ m →
      ¬ IsIntegral 𝒪[F] ((m : L) / (chosenUniformizer F L : L)) := by
    have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
        addVal F (x * y) = addVal F x + addVal F y := by
      intro x y hx hy
      have hxy : x * y ≠ 0 := mul_ne_zero hx hy
      simp only [addVal, hx, hy, hxy, ↓reduceDIte]
      rw [← neg_add, neg_inj, ← toAdd_mul]
      congr 1
      rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
        WithZero.coe_unzero, ← map_mul, ← map_mul]
    have addVal_one : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have h := addVal_mul h1 h1
      rw [mul_one] at h
      omega
    let addValHom : Fˣ →* Multiplicative ℤ :=
      { toFun := fun u => Multiplicative.ofAdd (addVal F u)
        map_one' := by simp [addVal_one]
        map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
    let relValHom : Lˣ →* Multiplicative ℤ :=
      addValHom.comp (Units.map (Algebra.norm F))
    have relValHom_apply : ∀ u : Lˣ, Multiplicative.toAdd (relValHom u) = relVal F L u :=
      fun _ => rfl
    have relVal_units_mul : ∀ u v : Lˣ,
        relVal F L ((u * v : Lˣ) : L) = relVal F L u + relVal F L v := by
      intro u v
      rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
    have relVal_units_zpow : ∀ (u : Lˣ) (k : ℤ),
        relVal F L ((u ^ k : Lˣ) : L) = k * relVal F L u := by
      intro u k
      rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
      rfl
    have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
      let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
        (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
      have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
          WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
        (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
      obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
      have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
          WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
        rw [ha]
        exact hg
      have ha0 : a ≠ 0 := by
        intro h0
        rw [h0, map_zero, map_zero] at h1
        exact WithZero.coe_ne_zero h1.symm
      refine ⟨Units.mk0 a ha0, ?_⟩
      simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
      have h2 : WithZero.unzero
          (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
          (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
      rw [h2, toAdd_ofAdd, neg_neg]
    have resDeg_mem : 0 < resDeg F L ∧ ∃ π : Lˣ, relVal F L π = resDeg F L := by
      obtain ⟨u, hu⟩ := exists_addVal_eq_one
      let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
      have hS : S.Nonempty := by
        refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L u,
          (map_ne_zero (algebraMap F L)).mpr u.ne_zero, ?_⟩
        have hnorm : Algebra.norm F (algebraMap F L (u : F)) = (u : F) ^ Module.finrank F L :=
          Algebra.norm_algebraMap (u : F)
        have hpow : addVal F ((u : F) ^ Module.finrank F L) =
            (Module.finrank F L : ℤ) * addVal F u := by
          change Multiplicative.toAdd (addValHom (u ^ Module.finrank F L)) = _
          rw [map_pow, toAdd_pow, nsmul_eq_mul]
          rfl
        rw [relVal, hnorm, hpow, hu, mul_one]
      obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
      exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
    obtain ⟨hf, π, hπ⟩ := resDeg_mem
    have relVal_eq_resDeg_mul_valL_aux : ∀ u : Lˣ, relVal F L u = (resDeg F L : ℤ) * valL F L u := by
      intro u
      let q := relVal F L u / (resDeg F L : ℤ)
      let r := relVal F L u % (resDeg F L : ℤ)
      have hdiv : r + (resDeg F L : ℤ) * q = relVal F L u := Int.emod_add_mul_ediv _ _
      have hr0 : 0 ≤ r := Int.emod_nonneg _ (by positivity)
      have hrlt : r < (resDeg F L : ℤ) := Int.emod_lt_of_pos _ (by positivity)
      have hy : relVal F L ((u * π ^ (-q) : Lˣ) : L) = r := by
        rw [relVal_units_mul, relVal_units_zpow, hπ]
        linarith
      have hr_eq : r = 0 := by
        by_contra hr_ne
        have hr_pos : 0 < r.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
        have hmem : r.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k} := by
          refine ⟨hr_pos, ((u * π ^ (-q) : Lˣ) : L), Units.ne_zero _, ?_⟩
          rw [hy, Int.toNat_of_nonneg hr0]
        have hle : resDeg F L ≤ r.toNat := Nat.sInf_le hmem
        omega
      change relVal F L u = (resDeg F L : ℤ) * q
      linarith
    have hf_ne : (resDeg F L : ℤ) ≠ 0 := by positivity
    have hπ_val : valL F L π = 1 := by
      rw [valL, hπ, Int.ediv_self hf_ne]
    have h_valL_pi : valL F L (chosenUniformizer F L) = 1 :=
      Classical.epsilon_spec (p := fun π : Lˣ => valL F L π = 1) ⟨π, hπ_val⟩
    have h_rel_pi_pos : 0 < relVal F L (chosenUniformizer F L) := by
      rw [relVal_eq_resDeg_mul_valL_aux (chosenUniformizer F L), h_valL_pi, mul_one]
      exact_mod_cast hf
    intro m hm_pos hpm h_int
    have h_pi_norm_ne : Algebra.norm F (chosenUniformizer F L : L) ≠ 0 := by
      rw [Algebra.norm_ne_zero_iff]
      exact Units.ne_zero (chosenUniformizer F L)
    have h_val_pi_lt_one : valuation F (Algebra.norm F (chosenUniformizer F L : L)) < 1 := by
      have h_rel := h_rel_pi_pos
      unfold relVal addVal at h_rel
      rw [dif_neg h_pi_norm_ne] at h_rel
      set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
      set v_pi := valuation F (Algebra.norm F (chosenUniformizer F L : L))
      have hv_ne : iso v_pi ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr h_pi_norm_ne)
      have h_toAdd_neg : Multiplicative.toAdd (WithZero.unzero hv_ne) < 0 := by omega
      have h_unzero_lt : WithZero.unzero hv_ne < 1 := Multiplicative.toAdd_lt.mp h_toAdd_neg
      have h_iso_lt : iso v_pi < iso 1 := by
        rw [map_one, ← WithZero.coe_unzero hv_ne, ← WithZero.coe_one]
        exact WithZero.coe_lt_coe.mpr h_unzero_lt
      exact (map_lt_map_iff iso).mp h_iso_lt
    have h_res_m_ne : (m : 𝓀[F]) ≠ 0 := fun h_zero => hpm ((ringChar.spec 𝓀[F] m).mp h_zero)
    have h_unit_m : IsUnit (m : 𝒪[F]) := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, map_natCast]
      exact h_res_m_ne
    have h_val_m_eq_one : valuation F (m : F) = 1 := by
      have h_le : valuation F (m : F) ≤ 1 := (m : 𝒪[F]).2
      have h_not_lt : ¬ valuation F ((m : 𝒪[F]) : F) < 1 := by
        rw [← Valuation.Integer.not_isUnit_iff_valuation_lt_one]
        exact not_not.mpr h_unit_m
      exact le_antisymm h_le (not_lt.mp h_not_lt)
    have h_val_norm_m : valuation F (Algebra.norm F (m : L)) = 1 := by
      have hmL : (m : L) = algebraMap F L (m : F) := (map_natCast (algebraMap F L) m).symm
      rw [hmL, Algebra.norm_algebraMap, map_pow, h_val_m_eq_one, one_pow]
    have h_norm_int : IsIntegral 𝒪[F] (Algebra.norm F ((m : L) / (chosenUniformizer F L : L))) :=
      Algebra.isIntegral_norm F h_int
    have h_val_div_le : valuation F (Algebra.norm F ((m : L) / (chosenUniformizer F L : L))) ≤ 1 :=
      (Valuation.Integers.isIntegral_iff_v_le_one (Valuation.integer.integers (valuation F))).mp h_norm_int
    have h_mul : ((m : L) / (chosenUniformizer F L : L)) * (chosenUniformizer F L : L) = (m : L) :=
      div_mul_cancel₀ _ (Units.ne_zero _)
    have h_one_le : (1 : ValueGroupWithZero F) ≤ valuation F (Algebra.norm F (chosenUniformizer F L : L)) := by
      calc (1 : ValueGroupWithZero F)
        _ = valuation F (Algebra.norm F (m : L)) := h_val_norm_m.symm
        _ = valuation F (Algebra.norm F (((m : L) / (chosenUniformizer F L : L)) * (chosenUniformizer F L : L))) := by
            rw [h_mul]
        _ = valuation F (Algebra.norm F ((m : L) / (chosenUniformizer F L : L))) *
              valuation F (Algebra.norm F (chosenUniformizer F L : L)) := by
            rw [map_mul, map_mul]
        _ ≤ 1 * valuation F (Algebra.norm F (chosenUniformizer F L : L)) :=
            mul_le_mul_right' h_val_div_le _
        _ = valuation F (Algebra.norm F (chosenUniformizer F L : L)) := one_mul _
    exact not_lt_of_ge h_one_le h_val_pi_lt_one
  have h_minpoly := aeval_pow_qL_minpoly_eq_zero F L h_frob h_p h_not_int
  exact exists_fixingSubgroup_actsAsFrobPow_of_aeval_minpoly F L h_minpoly

theorem unramifiedLevelField_isGalois_and_finiteDimensional (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) (m : ℕ) (hm : 0 < m) (hpm : ¬ p F ∣ m) :
    IsGalois L (unramifiedLevelField F L m) ∧
      FiniteDimensional L (unramifiedLevelField F L m) :=
by
  have hmF : (m : F) ≠ 0 := by
    intro h0
    have h0' : (m : 𝒪[F]) = 0 := Subtype.ext (by simpa using h0)
    have hres : (m : 𝓀[F]) = 0 := by simpa using congr_arg (IsLocalRing.residue 𝒪[F]) h0'
    exact hpm ((ringChar.spec 𝓀[F] m).mp hres)
  have hmL : (m : L) ≠ 0 := by
    intro h0
    have h0' : algebraMap F L (m : F) = 0 := by simpa using h0
    exact hmF ((RingHom.injective (algebraMap F L)) (h0'.trans (map_zero _).symm))
  let P : Polynomial L := Polynomial.X ^ m - Polynomial.C 1
  have hP_ne : P ≠ 0 := Polynomial.X_pow_sub_C_ne_zero hm (1 : L)
  have hP_sep : P.Separable := Polynomial.separable_X_pow_sub_C (1 : L) hmL one_ne_zero
  have hset : {ζ : AlgebraicClosure F | ζ ^ m = 1} = P.rootSet (AlgebraicClosure F) := by
    ext ζ
    rw [Set.mem_setOf_eq, Polynomial.mem_rootSet_of_ne hP_ne]
    simp [P, sub_eq_zero]
  have hsplit : (P.map (algebraMap L (AlgebraicClosure F))).Splits := IsAlgClosed.splits _
  have hu : unramifiedLevelField F L m =
      IntermediateField.adjoin L (P.rootSet (AlgebraicClosure F)) := by
    dsimp [unramifiedLevelField]
    rw [hset]
  rw [hu]
  haveI : Polynomial.IsSplittingField L
      (IntermediateField.adjoin L (P.rootSet (AlgebraicClosure F))) P :=
    IntermediateField.adjoin_rootSet_isSplittingField hsplit
  exact ⟨IsGalois.of_separable_splitting_field hP_sep,
    Polynomial.IsSplittingField.finiteDimensional
      (IntermediateField.adjoin L (P.rootSet (AlgebraicClosure F))) P⟩

theorem exists_pow_eq_one_and_natCast_mul_eq_sum_trace (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) (m : ℕ) (hm : 0 < m) (hpm : ¬ p F ∣ m)
    [IsGalois L (unramifiedLevelField F L m)]
    [FiniteDimensional L (unramifiedLevelField F L m)] :
    ∃ ζ : unramifiedLevelField F L m, ζ ^ m = 1 ∧ ∀ y : unramifiedLevelField F L m,
      (m : unramifiedLevelField F L m) * y =
        ∑ k ∈ Finset.range m,
          algebraMap L (unramifiedLevelField F L m)
            (Algebra.trace L (unramifiedLevelField F L m) (y * ζ ^ k)) * (ζ⁻¹) ^ k :=
by
  have h_trace_id : ∀ (K E : Type u) [Field K] [Field E] [Algebra K E]
      [FiniteDimensional K E] [IsGalois K E] (m : ℕ) (hm : 0 < m) (ζ : E) (hζm : ζ ^ m = 1)
      (hfix : ∀ σ : E ≃ₐ[K] E, σ ζ = ζ → σ = 1) (y : E),
      (m : E) * y =
        ∑ k ∈ Finset.range m,
          algebraMap K E (Algebra.trace K E (y * ζ ^ k)) * (ζ⁻¹) ^ k := by
    clear! F L m hm hpm
    intro K E _ _ _ _ _ m hm ζ hζm hfix y
    have hsum_σ : ∀ σ : E ≃ₐ[K] E,
        (∑ k ∈ Finset.range m, (σ ζ * ζ⁻¹) ^ k) =
          if σ = 1 then (m : E) else 0 := by
      intro σ
      have hζ_ne : ζ ≠ 0 := by
        intro h0
        have : (1 : E) = 0 := by
          rw [← hζm, h0, zero_pow hm.ne']
        exact one_ne_zero this
      by_cases hσ1 : σ = 1
      · subst hσ1
        simp [mul_inv_cancel₀ hζ_ne]
      · rw [if_neg hσ1]
        have hne : σ ζ ≠ ζ := fun h => hσ1 (hfix σ h)
        have hr_ne : σ ζ * ζ⁻¹ ≠ 1 := by
          intro hr1
          exact hne (by simpa [mul_assoc, inv_mul_cancel₀ hζ_ne] using congr_arg (· * ζ) hr1)
        have hrm : (σ ζ * ζ⁻¹) ^ m = 1 := by
          rw [mul_pow, ← map_pow, hζm, map_one, inv_pow, hζm, inv_one, mul_one]
        have hgeom := geom_sum_mul (σ ζ * ζ⁻¹) m
        rw [hrm, sub_self] at hgeom
        exact (mul_eq_zero.mp hgeom).resolve_right (sub_ne_zero.mpr hr_ne)
    have h_expand : ∑ k ∈ Finset.range m,
        algebraMap K E (Algebra.trace K E (y * ζ ^ k)) * (ζ⁻¹) ^ k =
        ∑ σ : E ≃ₐ[K] E, σ y * (∑ k ∈ Finset.range m, (σ ζ * ζ⁻¹) ^ k) := by
      conv_lhs =>
        arg 2
        ext k
        rw [trace_eq_sum_automorphisms, Finset.sum_mul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun σ _ => ?_
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [map_mul, map_pow, mul_pow, mul_assoc]
    rw [h_expand]
    simp_rw [hsum_σ, mul_ite, mul_zero]
    rw [Finset.sum_ite_eq' Finset.univ (1 : E ≃ₐ[K] E)]
    simp [mul_comm]
  have hmF : (m : F) ≠ 0 := by
    intro h0
    have h0' : (m : 𝒪[F]) = 0 := Subtype.ext (by simpa using h0)
    have hres : (m : 𝓀[F]) = 0 := by simpa using congr_arg (IsLocalRing.residue 𝒪[F]) h0'
    exact hpm ((ringChar.spec 𝓀[F] m).mp hres)
  haveI : NeZero (m : F) := ⟨hmF⟩
  haveI : HasEnoughRootsOfUnity (AlgebraicClosure F) m :=
    AlgebraicClosure.hasEnoughRootsOfUnity F m
  obtain ⟨ζ₀, hζ₀⟩ := HasEnoughRootsOfUnity.prim (M := AlgebraicClosure F) (n := m)
  have hζ₀_mem : ζ₀ ∈ unramifiedLevelField F L m :=
    IntermediateField.subset_adjoin L {ξ : AlgebraicClosure F | ξ ^ m = 1} hζ₀.pow_eq_one
  let ζ : unramifiedLevelField F L m := ⟨ζ₀, hζ₀_mem⟩
  have hζm : ζ ^ m = 1 := Subtype.ext hζ₀.pow_eq_one
  refine ⟨ζ, hζm, ?_⟩
  intro y
  have hfix : ∀ σ : unramifiedLevelField F L m ≃ₐ[L] unramifiedLevelField F L m,
      σ ζ = ζ → σ = 1 := by
    intro σ hσ
    haveI : NeZero m := ⟨hm.ne'⟩
    have hσ_inv : σ⁻¹ ζ = ζ := (AlgEquiv.symm_apply_eq σ).mpr hσ.symm
    have hσn : ∀ n : ℤ, (σ ^ n) ζ = ζ := by
      intro n
      induction n with
      | zero => rfl
      | succ k ih =>
        rw [zpow_add_one, AlgEquiv.mul_apply, hσ, ih]
      | pred k ih =>
        rw [zpow_sub_one, AlgEquiv.mul_apply, hσ_inv, ih]
    let K : IntermediateField L (AlgebraicClosure F) :=
      (IntermediateField.fixedField (Subgroup.zpowers σ)).map (unramifiedLevelField F L m).val
    have hle : unramifiedLevelField F L m ≤ K := by
      unfold unramifiedLevelField
      rw [IntermediateField.adjoin_le_iff]
      intro ξ hξ
      obtain ⟨i, -, hi⟩ := hζ₀.eq_pow_of_pow_eq_one hξ
      refine ⟨ζ ^ i, ?_, by exact_mod_cast hi⟩
      change ζ ^ i ∈ IntermediateField.fixedField (Subgroup.zpowers σ)
      rw [IntermediateField.mem_fixedField_iff]
      intro τ hτ
      obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hτ
      change (σ ^ n) (ζ ^ i) = ζ ^ i
      rw [map_pow, hσn n]
    apply AlgEquiv.ext
    intro x
    obtain ⟨z, hz, hval⟩ := hle x.2
    have hzx : z = x := Subtype.ext hval
    subst hzx
    exact hz ⟨σ, Subgroup.mem_zpowers σ⟩
  exact h_trace_id ↥L ↥(unramifiedLevelField F L m) m hm ζ hζm hfix y

theorem isIntegral_iff_eq_zero_or_relVal_nonneg (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E] (z : E) :
    IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ relVal F E z :=
by
  have h_aux : ∀ (K : Type u) [Field K] [Algebra F K] [FiniteDimensional F K] (x : K),
      IsIntegral 𝒪[F] x ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x) := by
    intro K _ _ _ x
    have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
        0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
      intro a ha
      unfold addVal
      rw [dif_neg ha]
      set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
      set va := valuation F a
      have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
      constructor
      · intro h_nonneg
        have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
        have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
        have h_iso : iso va ≤ iso 1 := by
          rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
          exact WithZero.coe_le_coe.mpr h_unzero
        exact (map_le_map_iff iso).mp h_iso
      · intro h_le
        have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
        have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
          Multiplicative.toAdd_le.mpr h_iso
        omega
    constructor
    · intro hx
      by_cases hx0 : x = 0
      · exact Or.inl hx0
      · right
        have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
        have hnorm_int : IsIntegral 𝒪[F] (Algebra.norm F x) := Algebra.isIntegral_norm F hx
        have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
          (Valuation.Integers.isIntegral_iff_v_le_one
            (Valuation.integer.integers (valuation F))).mp hnorm_int
        exact (addVal_nonneg_iff_val_le_one hnorm0).mpr hval_le
    · rintro (rfl | h_rel)
      · exact isIntegral_zero
      · by_cases hx0 : x = 0
        · rw [hx0]
          exact isIntegral_zero
        · have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
          have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
            (addVal_nonneg_iff_val_le_one hnorm0).mp h_rel
          have hx_int_F : IsIntegral F x := Algebra.IsIntegral.isIntegral x
          let pb : PowerBasis F (IntermediateField.adjoin F ({x} : Set K)) :=
            IntermediateField.adjoin.powerBasis hx_int_F
          have h_gen_coe : (pb.gen : K) = x := IntermediateField.AdjoinSimple.coe_gen F x
          set dK : ℕ := Module.finrank (IntermediateField.adjoin F ({x} : Set K)) K
          have h_finrank_pos : 0 < dK := Module.finrank_pos
          have h_norm_tower : Algebra.norm F x = (Algebra.norm F pb.gen) ^ dK := by
            have h1 : Algebra.norm F (pb.gen : K) = (Algebra.norm F pb.gen) ^ dK := by
              rw [← Algebra.norm_norm (R := F) (S := IntermediateField.adjoin F ({x} : Set K))
                (A := K) (a := (pb.gen : K)), ← map_pow]
              congr 1
              exact Algebra.norm_algebraMap (L := K) pb.gen
            rwa [h_gen_coe] at h1
          have h_norm_pb : Algebra.norm F pb.gen =
              (-1) ^ pb.dim * (minpoly F pb.gen).coeff 0 :=
            Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb
          have h_minpoly_eq : minpoly F pb.gen = minpoly F x := by
            have h1 : minpoly F pb.gen = minpoly F (pb.gen : K) :=
              (minpoly.algHom_eq
                (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K)))
                (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K))).injective
                pb.gen).symm
            rwa [h_gen_coe] at h1
          letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
          haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
          haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
          letI : Valued F (ValueGroupWithZero F) :=
            IsValuativeTopology.instValuedValueGroupWithZeroOfIsUniformAddGroup
          let rlo : RankLeOneStruct F :=
            { emb := (WithZeroMulInt.toNNReal (by norm_num : (2 : NNReal) ≠ 0)).comp
                (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).toMonoidWithZeroHom
              strictMono := (WithZeroMulInt.toNNReal_strictMono (by norm_num : (1 : NNReal) < 2)).comp
                (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).strictMono }
          haveI : (Valued.v (R := F)).RankOne := Valuation.RankOne.ofRankLeOneStruct rlo
          letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
          haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F (ValueGroupWithZero F)
          have hnorm_norm_le : ‖Algebra.norm F x‖ ≤ 1 :=
            Valued.toNormedField.norm_le_one_iff.mpr hval_le
          have h_norm_coeff_pow : ‖Algebra.norm F x‖ =
              ‖(minpoly F x).coeff 0‖ ^ dK := by
            rw [h_norm_tower, h_norm_pb, h_minpoly_eq, norm_pow, norm_mul, norm_pow,
              norm_neg, norm_one, one_pow, one_mul]
          have h_coeff0_le : ‖(minpoly F x).coeff 0‖ ≤ 1 := by
            rw [h_norm_coeff_pow] at hnorm_norm_le
            exact (pow_le_one_iff_of_nonneg (norm_nonneg _) h_finrank_pos.ne').mp hnorm_norm_le
          have h_spec_le : spectralValue (minpoly F x) ≤ 1 := by
            change spectralNorm F K x ≤ 1
            rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow F K x]
            exact Real.rpow_le_one (norm_nonneg _) h_coeff0_le (by positivity)
          have h_all_coeffs : ∀ n : ℕ, ‖(minpoly F x).coeff n‖ ≤ 1 :=
            (spectralValue_le_one_iff (minpoly.monic hx_int_F)).mp h_spec_le
          have h_lifts : minpoly F x ∈ Polynomial.lifts (algebraMap 𝒪[F] F) := by
            rw [Polynomial.lifts_iff_coeff_lifts]
            intro n
            have hv : valuation F ((minpoly F x).coeff n) ≤ 1 :=
              Valued.toNormedField.norm_le_one_iff.mp (h_all_coeffs n)
            exact ⟨⟨(minpoly F x).coeff n, hv⟩, rfl⟩
          obtain ⟨P₀, hP₀_map, -, hP₀_monic⟩ :=
            Polynomial.lifts_and_degree_eq_and_monic h_lifts (minpoly.monic hx_int_F)
          refine ⟨P₀, hP₀_monic, ?_⟩
          have h_eval : Polynomial.aeval x (P₀.map (algebraMap 𝒪[F] F)) = 0 := by
            rw [hP₀_map]
            exact minpoly.aeval F x
          rwa [Polynomial.aeval_map_algebraMap] at h_eval
  exact h_aux E z

theorem finrank_mul_resDeg_le_of_trace_formula_and_isIntegral_iff (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (m : ℕ)
    (hm : 0 < m) (hpm : ¬ p F ∣ m) [IsGalois L (unramifiedLevelField F L m)]
    [FiniteDimensional L (unramifiedLevelField F L m)] (ζ : unramifiedLevelField F L m)
    (hζm : ζ ^ m = 1)
    (htrace : ∀ y : unramifiedLevelField F L m,
      (m : unramifiedLevelField F L m) * y =
        ∑ k ∈ Finset.range m,
          algebraMap L (unramifiedLevelField F L m)
            (Algebra.trace L (unramifiedLevelField F L m) (y * ζ ^ k)) * (ζ⁻¹) ^ k)
    (hint : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E] (z : E),
      IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ relVal F E z) :
    Module.finrank L (unramifiedLevelField F L m) * resDeg F L ≤
      resDeg F ((unramifiedLevelField F L m).restrictScalars F) :=
by
  let U : IntermediateField L (AlgebraicClosure F) := unramifiedLevelField F L m
  let M_F : IntermediateField F (AlgebraicClosure F) := U.restrictScalars F
  haveI : FiniteDimensional F U := FiniteDimensional.trans F L U
  haveI : FiniteDimensional F M_F := ‹FiniteDimensional F U›
  let d : ℕ := Module.finrank L U
  have hd_pos : 0 < d := Module.finrank_pos
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  have addVal_pow : ∀ (u : Fˣ) (n : ℕ), addVal F ((u : F) ^ n) = (n : ℤ) * addVal F u := by
    intro u n
    change Multiplicative.toAdd (addValHom (u ^ n)) = _
    rw [map_pow, toAdd_pow, nsmul_eq_mul]
    rfl
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E],
      0 < resDeg F E ∧ ∃ π : Eˣ, relVal F E π = resDeg F E := by
    intro E _
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : E, z ≠ 0 ∧ relVal F E z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F E, Module.finrank_pos, algebraMap F E u,
        (map_ne_zero (algebraMap F E)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F E (u : F)) = (u : F) ^ Module.finrank F E :=
        Algebra.norm_algebraMap (u : F)
      rw [relVal, hnorm, addVal_pow, hu, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  have relVal_mul : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      {x w : E}, x ≠ 0 → w ≠ 0 → relVal F E (x * w) = relVal F E x + relVal F E w := by
    intro E _ x w hx hw
    have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
    have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
    rw [relVal, map_mul, addVal_mul hnx hnw, ← relVal, ← relVal]
  have relVal_div : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      {x w : E}, x ≠ 0 → w ≠ 0 → relVal F E (x / w) = relVal F E x - relVal F E w := by
    intro E _ x w hx hw
    have hxw : x / w ≠ 0 := div_ne_zero hx hw
    have h := relVal_mul E hxw hw
    rw [div_mul_cancel₀ x hw] at h
    omega
  have relVal_algebraMap_L : ∀ {x : L}, x ≠ 0 →
      relVal F M_F (algebraMap L U x) = (d : ℤ) * relVal F L x := by
    intro x hx
    have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
    let z : U := algebraMap L U x
    have hnorm : Algebra.norm F z = (Algebra.norm F x) ^ d := by
      calc Algebra.norm F z
        _ = Algebra.norm F (Algebra.norm L (algebraMap L U x)) :=
            (@Algebra.norm_norm F L _ _ _ _ U _ _ _ _ _ z).symm
        _ = Algebra.norm F (x ^ d) := by rw [Algebra.norm_algebraMap]
        _ = (Algebra.norm F x) ^ d := map_pow (Algebra.norm F) x d
    let ux : Fˣ := Units.mk0 (Algebra.norm F x) hnx
    have hux : (ux : F) = Algebra.norm F x := rfl
    change addVal F (Algebra.norm F z) = (d : ℤ) * addVal F (Algebra.norm F x)
    rw [hnorm, ← hux, addVal_pow]
  obtain ⟨hresL_pos, π_L, hrel_πL⟩ := resDeg_mem L
  obtain ⟨hresM_pos, π_M, hrel_πM⟩ := resDeg_mem M_F
  have hπL_ne : (π_L : L) ≠ 0 := π_L.ne_zero
  let y : U := (π_M : M_F)
  have hy_ne : y ≠ 0 := π_M.ne_zero
  have hrel_y : relVal F M_F y = (resDeg F M_F : ℤ) := hrel_πM
  have h_root_int : ∀ {ξ : U}, ξ ^ m = 1 → IsIntegral 𝒪[F] ξ := by
    intro ξ hξ
    refine ⟨Polynomial.X ^ m - Polynomial.C 1,
      Polynomial.monic_X_pow_sub_C (1 : 𝒪[F]) hm.ne', ?_⟩
    simp [hξ]
  have hζ_inv_int : ∀ k : ℕ, IsIntegral 𝒪[F] ((ζ⁻¹) ^ k) := by
    intro k
    apply IsIntegral.pow
    apply h_root_int
    rw [inv_pow, hζm, inv_one]
  have hσζ_int : ∀ (σ : U ≃ₐ[L] U) (k : ℕ), IsIntegral 𝒪[F] (σ (ζ ^ k)) := by
    intro σ k
    apply h_root_int
    rw [← map_pow, pow_right_comm, hζm, one_pow, map_one]
  have hσy_div_int : ∀ σ : U ≃ₐ[L] U, IsIntegral 𝒪[F] (σ y / y) := by
    intro σ
    have hnorm_σy : Algebra.norm F (σ y) = Algebra.norm F y :=
      Algebra.norm_eq_of_algEquiv (AlgEquiv.restrictScalars F σ) y
    have hny_ne : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy_ne
    have hnorm_div : Algebra.norm F (σ y / y) = 1 := by
      apply mul_right_cancel₀ hny_ne
      rw [← map_mul, div_mul_cancel₀ (σ y) hy_ne, hnorm_σy, one_mul]
    have hrel_div : relVal F M_F (σ y / y) = 0 := by
      change addVal F (Algebra.norm F (σ y / y)) = 0
      rw [hnorm_div, addVal_one]
    exact (hint M_F (σ y / y)).mpr (Or.inr (by omega))
  have trace_div_eq : ∀ (K E : Type u) [Field K] [Field E] [Algebra K E]
      [FiniteDimensional K E] [IsGalois K E] (z w : E),
      algebraMap K E (Algebra.trace K E z) / w = ∑ σ : E ≃ₐ[K] E, σ z / w := by
    intro K E _ _ _ _ _ z w
    rw [trace_eq_sum_automorphisms, Finset.sum_div]
  have hb_y_int : ∀ k : ℕ,
      IsIntegral 𝒪[F] (algebraMap L U (Algebra.trace L U (y * ζ ^ k)) / y) := by
    intro k
    rw [trace_div_eq L U (y * ζ ^ k) y]
    refine (integralClosure 𝒪[F] U).sum_mem fun σ _ => ?_
    have h_eq : σ (y * ζ ^ k) / y = (σ y / y) * σ (ζ ^ k) := by
      rw [map_mul, mul_div_right_comm]
    rw [h_eq]
    exact IsIntegral.mul (hσy_div_int σ) (hσζ_int σ k)
  have hb_πL_int : ∀ k : ℕ,
      IsIntegral 𝒪[F] (Algebra.trace L U (y * ζ ^ k) / (π_L : L)) := by
    intro k
    set bk : L := Algebra.trace L U (y * ζ ^ k)
    by_cases hbk : bk = 0
    · rw [hbk, zero_div]
      exact isIntegral_zero
    · have hbk_U : algebraMap L U bk ≠ 0 := (map_ne_zero (algebraMap L U)).mpr hbk
      have hquot_ne : algebraMap L U bk / y ≠ 0 := div_ne_zero hbk_U hy_ne
      have h_rel_nonneg : 0 ≤ relVal F M_F (algebraMap L U bk / y) := by
        rcases (hint M_F (algebraMap L U bk / y)).mp (hb_y_int k) with h0 | hge
        · exact False.elim (hquot_ne h0)
        · exact hge
      rw [relVal_div M_F hbk_U hy_ne, relVal_algebraMap_L hbk, hrel_y] at h_rel_nonneg
      have h_rel_bk_pos : 0 < relVal F L bk := by nlinarith
      have h_res_le_bk : (resDeg F L : ℤ) ≤ relVal F L bk := by
        have hpos_nat : 0 < (relVal F L bk).toNat :=
          Int.pos_iff_toNat_pos.mp h_rel_bk_pos
        have hmem : (relVal F L bk).toNat ∈
            {n : ℕ | 0 < n ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = n} := by
          refine ⟨hpos_nat, bk, hbk, ?_⟩
          exact (Int.toNat_of_nonneg (by omega)).symm
        have hle : resDeg F L ≤ (relVal F L bk).toNat := Nat.sInf_le hmem
        omega
      have h_div_nonneg : 0 ≤ relVal F L (bk / (π_L : L)) := by
        rw [relVal_div L hbk hπL_ne, hrel_πL]
        omega
      exact (hint L (bk / (π_L : L))).mpr (Or.inr h_div_nonneg)
  have hmy_div_int : IsIntegral 𝒪[F] (((m : U) * y) / algebraMap L U (π_L : L)) := by
    rw [htrace y, Finset.sum_div]
    refine (integralClosure 𝒪[F] U).sum_mem fun k _ => ?_
    have h_term : (algebraMap L U (Algebra.trace L U (y * ζ ^ k)) * (ζ⁻¹) ^ k) /
        algebraMap L U (π_L : L) =
        algebraMap L U (Algebra.trace L U (y * ζ ^ k) / (π_L : L)) * (ζ⁻¹) ^ k := by
      rw [mul_div_right_comm, map_div₀]
    rw [h_term]
    exact IsIntegral.mul (IsIntegral.algebraMap (hb_πL_int k)) (hζ_inv_int k)
  have hm_res_ne : IsLocalRing.residue 𝒪[F] (m : 𝒪[F]) ≠ 0 := by
    rw [map_natCast]
    intro h0
    exact hpm ((ringChar.spec 𝓀[F] m).mp h0)
  have hm_unit : IsUnit (m : 𝒪[F]) :=
    (IsLocalRing.residue_ne_zero_iff_isUnit (m : 𝒪[F])).mp hm_res_ne
  obtain ⟨u₀, hu₀⟩ := hm_unit
  let v₀ : U := algebraMap 𝒪[F] U (↑(u₀⁻¹) : 𝒪[F])
  have hv₀_int : IsIntegral 𝒪[F] v₀ := isIntegral_algebraMap
  have hv₀_mul_m : v₀ * (m : U) = 1 := by
    have hm_eq : (m : U) = algebraMap 𝒪[F] U (u₀ : 𝒪[F]) := by
      rw [hu₀, map_natCast]
    rw [hm_eq, ← map_mul, Units.inv_mul, map_one]
  have hy_div_int : IsIntegral 𝒪[F] (y / algebraMap L U (π_L : L)) := by
    have hmul := IsIntegral.mul hv₀_int hmy_div_int
    have h_eq : v₀ * (((m : U) * y) / algebraMap L U (π_L : L)) =
        y / algebraMap L U (π_L : L) := by
      rw [← mul_div_assoc, ← mul_assoc, hv₀_mul_m, one_mul]
    rwa [h_eq] at hmul
  have hπL_U_ne : algebraMap L U (π_L : L) ≠ 0 := (map_ne_zero (algebraMap L U)).mpr hπL_ne
  have hy_div_ne : y / algebraMap L U (π_L : L) ≠ 0 := div_ne_zero hy_ne hπL_U_ne
  have h_final_rel : 0 ≤ relVal F M_F (y / algebraMap L U (π_L : L)) := by
    rcases (hint M_F (y / algebraMap L U (π_L : L))).mp hy_div_int with h0 | hge
    · exact False.elim (hy_div_ne h0)
    · exact hge
  have h_ineq : ((d * resDeg F L : ℕ) : ℤ) ≤ (resDeg F M_F : ℤ) := by
    have h1 : relVal F M_F (y / algebraMap L U (π_L : L)) =
        relVal F M_F y - relVal F M_F (algebraMap L U (π_L : L)) :=
      relVal_div M_F hy_ne hπL_U_ne
    have h2 : relVal F M_F (algebraMap L U (π_L : L)) = (d : ℤ) * relVal F L (π_L : L) :=
      relVal_algebraMap_L hπL_ne
    rw [h1, h2, hrel_y, hrel_πL] at h_final_rel
    push_cast
    linarith [h_final_rel]
  exact Nat.cast_le.mp h_ineq

theorem unramifiedLevelField_isGalois_and_resDeg (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (m : ℕ)
    (hm : 0 < m) (hpm : ¬ p F ∣ m) :
    IsGalois L (unramifiedLevelField F L m) ∧
      FiniteDimensional L (unramifiedLevelField F L m) ∧
      Module.finrank L (unramifiedLevelField F L m) * resDeg F L ≤
        resDeg F ((unramifiedLevelField F L m).restrictScalars F) :=
by
  obtain ⟨hGal, hFin⟩ := unramifiedLevelField_isGalois_and_finiteDimensional F L m hm hpm
  haveI : IsGalois L (unramifiedLevelField F L m) := hGal
  haveI : FiniteDimensional L (unramifiedLevelField F L m) := hFin
  obtain ⟨ζ, hζm, htrace⟩ := exists_pow_eq_one_and_natCast_mul_eq_sum_trace F L m hm hpm
  exact ⟨hGal, hFin,
    finrank_mul_resDeg_le_of_trace_formula_and_isIntegral_iff F L m hm hpm ζ hζm htrace
      (isIntegral_iff_eq_zero_or_relVal_nonneg F)⟩

theorem lubinTateIterPoly_monic_and_aeval_eq_zero_iff (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (ϖ : Lˣ) (n : ℕ) :
    (lubinTateIterPoly F L (ϖ : L) n).Monic ∧
      ∀ α : AlgebraicClosure F,
        Polynomial.aeval α (lubinTateIterPoly F L (ϖ : L) n) = 0 ↔ isLubinTateRoot F L ϖ n α :=
by
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_pos : 0 < resDeg F L := by
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L u,
        (map_ne_zero (algebraMap F L)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (u : F)) = (u : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (u : F)
      have hpow : addVal F ((u : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F u := by
        change Multiplicative.toAdd (addValHom (u ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu, mul_one]
    exact (Nat.sInf_mem hS).1
  have hres_ne : resDeg F L ≠ 0 := resDeg_pos.ne'
  have hq_gt : 1 < q F := Finite.one_lt_card
  have hqL_gt : 1 < qL F L := one_lt_pow₀ hq_gt hres_ne
  have h_gen : ∀ (K E : Type u) [Field K] [Field E] [Algebra K E] (c : K) (q0 : ℕ),
      1 < q0 →
      let f : Polynomial K := Polynomial.C c * Polynomial.X + Polynomial.X ^ q0
      ∀ (g : ℕ → Polynomial K),
        g 0 = Polynomial.X →
        (∀ m, g (m + 1) = f.comp (g m)) →
        ∀ m : ℕ, (g m).Monic ∧ (g m).natDegree = q0 ^ m ∧
          ∀ α : E, Polynomial.aeval α (g m) =
            ((fun y : E => algebraMap K E c * y + y ^ q0)^[m] α) := by
    intro K E _ _ _ c q0 hq0 f g hg0 hgs m
    have hdeg_lt : (Polynomial.C c * Polynomial.X).degree <
        (Polynomial.X ^ q0 : Polynomial K).degree := by
      rw [Polynomial.degree_X_pow]
      exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_le c) (WithBot.coe_lt_coe.mpr hq0)
    have hf_monic : f.Monic := by
      change (Polynomial.C c * Polynomial.X + Polynomial.X ^ q0).Monic
      rw [add_comm]
      exact Polynomial.Monic.add_of_left (Polynomial.monic_X_pow q0) hdeg_lt
    have hf_deg : f.natDegree = q0 := by
      change (Polynomial.C c * Polynomial.X + Polynomial.X ^ q0).natDegree = q0
      rw [add_comm, Polynomial.natDegree_add_eq_left_of_degree_lt hdeg_lt,
        Polynomial.natDegree_X_pow]
    induction m with
    | zero =>
      refine ⟨hg0 ▸ Polynomial.monic_X, ?_, ?_⟩
      · rw [hg0, Polynomial.natDegree_X, pow_zero]
      · intro α
        rw [hg0, Polynomial.aeval_X, Function.iterate_zero_apply]
    | succ m ih =>
      obtain ⟨ih_monic, ih_deg, ih_aeval⟩ := ih
      have h_deg_ne : (g m).natDegree ≠ 0 := by
        rw [ih_deg]
        exact pow_ne_zero m (by omega)
      refine ⟨?_, ?_, ?_⟩
      · rw [hgs m]
        exact hf_monic.comp ih_monic h_deg_ne
      · rw [hgs m, Polynomial.natDegree_comp, hf_deg, ih_deg, pow_succ']
      · intro α
        rw [hgs m, Polynomial.aeval_comp, ih_aeval, Function.iterate_succ_apply']
        change Polynomial.aeval _ (Polynomial.C c * Polynomial.X + Polynomial.X ^ q0) = _
        rw [map_add, map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
  obtain ⟨hm, _, ha⟩ := h_gen ↥L (AlgebraicClosure F) (ϖ : L) (qL F L) hqL_gt
    (lubinTateIterPoly F L (ϖ : L)) rfl (fun _ => rfl) n
  refine ⟨hm, fun α => ?_⟩
  rw [ha α]
  rfl

theorem lubinTateDivPoly_monic_coeff_zero_and_irreducible (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (ϖ : Lˣ)
    (hϖ : valL F L ϖ = 1) (n : ℕ) (hn : 1 ≤ n) :
    (lubinTateDivPoly F L (ϖ : L) n).Monic ∧
      (lubinTateDivPoly F L (ϖ : L) n).coeff 0 = (ϖ : L) ∧
      Irreducible (lubinTateDivPoly F L (ϖ : L) n) :=
by
  have hres_ne : resDeg F L ≠ 0 := by
    intro h0
    unfold valL at hϖ
    rw [h0, Nat.cast_zero, Int.ediv_zero] at hϖ
    omega
  have hf_pos : 0 < resDeg F L := Nat.pos_of_ne_zero hres_ne
  have hq_gt : 1 < q F := Finite.one_lt_card
  have hqL_gt : 1 < qL F L := one_lt_pow₀ hq_gt hres_ne
  set f0 : Polynomial L := lubinTatePoly F L (ϖ : L)
  have hdeg_lt0 : (Polynomial.C (ϖ : L) * Polynomial.X).degree <
      (Polynomial.X ^ qL F L : Polynomial L).degree := by
    rw [Polynomial.degree_X_pow]
    exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_le (ϖ : L)) (WithBot.coe_lt_coe.mpr hqL_gt)
  have hf0_monic : f0.Monic := by
    change (Polynomial.C (ϖ : L) * Polynomial.X + Polynomial.X ^ qL F L).Monic
    rw [add_comm]
    exact Polynomial.Monic.add_of_left (Polynomial.monic_X_pow (qL F L)) hdeg_lt0
  have hf0_deg : f0.natDegree = qL F L := by
    change (Polynomial.C (ϖ : L) * Polynomial.X + Polynomial.X ^ qL F L).natDegree = qL F L
    rw [add_comm, Polynomial.natDegree_add_eq_left_of_degree_lt hdeg_lt0,
      Polynomial.natDegree_X_pow]
  have hf0_eval0 : f0.eval 0 = 0 := by
    change (Polynomial.C (ϖ : L) * Polynomial.X + Polynomial.X ^ qL F L).eval 0 = 0
    rw [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
      Polynomial.eval_pow, Polynomial.eval_X, mul_zero, zero_add, zero_pow (by omega)]
  have hg_prop : ∀ m : ℕ,
      (lubinTateIterPoly F L (ϖ : L) m).Monic ∧
      (lubinTateIterPoly F L (ϖ : L) m).natDegree = (qL F L) ^ m ∧
      (lubinTateIterPoly F L (ϖ : L) m).eval 0 = 0 := by
    intro m
    induction m with
    | zero =>
      dsimp [lubinTateIterPoly]
      exact ⟨Polynomial.monic_X, Polynomial.natDegree_X, Polynomial.eval_X⟩
    | succ m ih =>
      obtain ⟨ih_monic, ih_deg, ih_eval0⟩ := ih
      have h_deg_ne : (lubinTateIterPoly F L (ϖ : L) m).natDegree ≠ 0 := by
        rw [ih_deg]
        exact pow_ne_zero m (by omega)
      dsimp [lubinTateIterPoly]
      refine ⟨hf0_monic.comp ih_monic h_deg_ne, ?_, ?_⟩
      · rw [Polynomial.natDegree_comp, hf0_deg, ih_deg, pow_succ']
      · rw [Polynomial.eval_comp, ih_eval0, hf0_eval0]
  obtain ⟨hg_monic, hg_deg, hg_eval0⟩ := hg_prop (n - 1)
  set P0 : Polynomial L := (lubinTateIterPoly F L (ϖ : L) (n - 1)) ^ (qL F L - 1)
  set d : ℕ := (qL F L - 1) * (qL F L) ^ (n - 1)
  have hP0_monic : P0.Monic := hg_monic.pow (qL F L - 1)
  have hP0_deg : P0.natDegree = d := by
    rw [hg_monic.natDegree_pow (qL F L - 1), hg_deg]
  have hd_pos : 1 ≤ d := by
    have h1 : 0 < qL F L - 1 := by omega
    have h2 : 0 < (qL F L) ^ (n - 1) := pow_pos (by omega) (n - 1)
    exact Nat.mul_pos h1 h2
  have hP0_coeff0 : P0.coeff 0 = 0 := by
    rw [Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_pow, hg_eval0, zero_pow (by omega)]
  have hdeg_C_lt : (Polynomial.C (ϖ : L)).degree < P0.degree := by
