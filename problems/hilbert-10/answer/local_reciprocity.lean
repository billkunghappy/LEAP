    have h_sum := polyDivPow_add h_tr_diff_div h_c_tr_P₁
    rwa [sub_add_cancel] at h_sum
  have h_s5 : polyDivPow 1 (c ^ (q - 1) * Matrix.trace H₀) := by
    have h_pow_split : c ^ (q - 1) * Matrix.trace H₀ =
        c ^ (q - 2) * (c * Matrix.trace H₀) := by
      have hq_sub : q - 1 = (q - 2) + 1 := by omega
      rw [hq_sub, pow_succ, mul_assoc]
