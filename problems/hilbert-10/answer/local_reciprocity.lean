          (d : L) - S := by
        dsimp [S]
        rw [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one]
        ring
      have hd_cast : (d : L) = (qL F L : L) - 1 := by
        dsimp [d]
        rw [Nat.cast_sub (by omega : 1 ≤ qL F L), Nat.cast_one]
      have h_phi_sub : Φ₁ y₁ - Φ₁ y₂ = (y₁ - y₂) + ((1 - y₂) ^ d - (1 - y₁) ^ d) := by
        dsimp [Φ₁]
        ring
      rw [h_phi_sub, ← hgeom, hS_eq, hd_cast]
      ring
    rw [h_factor]
    exact V_mul hdiff h_mult_V1
  obtain ⟨w, hw_V, hw_fp⟩ := h_picard hn Φ₁ hΦ₁_0 hΦ₁_lip
  have hw_eq : (1 - w) ^ (qL F L - 1) = (u : L) := by
    dsimp [Φ₁, d] at hw_fp
    linear_combination -hw_fp
  let ftilde : L → L := fun x => πL * (x - x ^ qL F L)
  have h_step2 : ∀ {k : ℕ}, 1 ≤ k → ∀ y : L, V (k + 1) y →
      ∃ x : L, V k x ∧ ftilde x = y := by
    intro k hk y hy
    let a : L := y / πL
    have ha : V k a := V_div_pi hy
    let Φ₂ : L → L := fun x => a + x ^ qL F L
    have hΦ₂_0 : V k (Φ₂ 0) := by
      dsimp [Φ₂]
      rw [zero_pow (by omega : qL F L ≠ 0), add_zero]
      exact ha
    have hΦ₂_lip : ∀ x₁ x₂ : L, V 1 x₁ → V 1 x₂ →
        ∀ m : ℕ, V m (x₁ - x₂) → V (m + 1) (Φ₂ x₁ - Φ₂ x₂) := by
      intro x₁ x₂ hx₁ hx₂ m hdiff
      have hgeom := geom_sum₂_mul x₁ x₂ (qL F L)
      have h_factor : Φ₂ x₁ - Φ₂ x₂ =
          (x₁ - x₂) * ∑ i ∈ Finset.range (qL F L), x₁ ^ i * x₂ ^ (qL F L - 1 - i) := by
        have h_phi2_sub : Φ₂ x₁ - Φ₂ x₂ = x₁ ^ qL F L - x₂ ^ qL F L := by
          dsimp [Φ₂]
          ring
        rw [h_phi2_sub, ← hgeom, mul_comm]
      rw [h_factor]
      have h_sum_V1 : V 1 (∑ i ∈ Finset.range (qL F L), x₁ ^ i * x₂ ^ (qL F L - 1 - i)) := by
        refine V_sum 1 (Finset.range (qL F L)) _ fun i hi => ?_
        rcases eq_or_ne i 0 with rfl | hi0
        · rw [pow_zero, one_mul, Nat.sub_zero]
          exact V_pow_pos hx₂ (by omega : 1 ≤ qL F L - 1)
        · exact V_mul_zero_right (V_pow_pos hx₁ (by omega : 1 ≤ i))
            (V_pow (V_mono (by omega) hx₂) (qL F L - 1 - i))
      exact V_mul hdiff h_sum_V1
    obtain ⟨x, hx_V, hx_fp⟩ := h_picard hk Φ₂ hΦ₂_0 hΦ₂_lip
    refine ⟨x, hx_V, ?_⟩
    have hx_sub : x - x ^ qL F L = y / πL := by
      dsimp [Φ₂, a] at hx_fp
      linear_combination -hx_fp
    dsimp [ftilde]
    rw [hx_sub, mul_div_cancel₀ y hπL_ne]
  have h_iter : ∀ (m : ℕ) (y : L), V (m + 1) y → ∃ c : L, V 1 c ∧ (ftilde^[m] c) = y := by
    intro m
    induction m with
    | zero =>
      intro y hy
      exact ⟨y, hy, Function.iterate_zero_apply ftilde y⟩
    | succ m ih =>
      intro y hy
      obtain ⟨y', hy'_V, hy'_eq⟩ := h_step2 (by omega : 1 ≤ m + 1) y hy
      obtain ⟨c, hc_V, hc_eq⟩ := ih y' hy'_V
      refine ⟨c, hc_V, ?_⟩
      rw [Function.iterate_succ_apply', hc_eq, hy'_eq]
  have hw_V' : V ((n - 1) + 1) w := by
    rwa [Nat.sub_add_cancel hn]
  obtain ⟨c, -, hc_eq⟩ := h_iter (n - 1) w hw_V'
  refine ⟨c, ?_⟩
  change (1 - (ftilde^[n - 1] c)) ^ (qL F L - 1) = (u : L)
  rw [hc_eq, hw_eq]

theorem valL_eq_zero_of_normLM_eq_of_le_valL_sub_one (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E] (hLE : L ≤ E)
    (n : ℕ) :
    1 ≤ n → ∀ (u : Lˣ), (n : ℤ) ≤ valL F L ((u : L) - 1) →
      ∀ (y : E), normLM F hLE y = (u : L) → y ≠ 0 ∧ valL F E y = 0 :=
by
  intro hn u hu y hy
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion hLE).toLinearMap
      (IntermediateField.inclusion hLE).injective
  letI : Algebra L E := (IntermediateField.inclusion hLE).toRingHom.toAlgebra
  letI : SMul L E := Algebra.toSMul
  letI : Module L E := Algebra.toModule
  haveI : IsScalarTower F L E :=
    IsScalarTower.of_algebraMap_eq (R := F) (S := L) (A := E) (fun _ => rfl)
  haveI : Module.Free F L := Module.Free.of_divisionRing F L
  haveI : Module.Free L E := Module.Free.of_divisionRing L E
  haveI : FiniteDimensional L E := FiniteDimensional.right F L E
  let eLE : E ≃ₐ[L] IntermediateField.extendScalars hLE := {
    toFun := toExtendScalars F hLE
    invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hLE).mp z.2⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl
    map_mul' := fun _ _ => rfl
    map_add' := fun _ _ => rfl
    commutes' := fun _ => rfl
  }
  have hy_norm : Algebra.norm L y = (u : L) := by
    calc Algebra.norm L y
      _ = Algebra.norm L (eLE y) := (Algebra.norm_eq_of_algEquiv eLE y).symm
      _ = normLM F hLE y := rfl
      _ = (u : L) := hy
  have hy_ne : y ≠ 0 := by
    intro hy0
    rw [hy0, Algebra.norm_zero (R := L) (S := E)] at hy_norm
    exact u.ne_zero hy_norm.symm
  have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
      0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
    intro a ha
    unfold addVal
    rw [dif_neg ha]
    set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    set va := valuation F a
    have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
    constructor
    · intro h_nonneg
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
      have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
      have h_iso : iso va ≤ iso 1 := by
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
        exact WithZero.coe_le_coe.mpr h_unzero
      exact (map_le_map_iff iso).mp h_iso
    · intro h_le
      have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
      rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
        Multiplicative.toAdd_le.mpr h_iso
      omega
  have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u₀ => Multiplicative.ofAdd (addVal F u₀)
      map_one' := by simp [addVal_one]
      map_mul' := fun u₀ v₀ => by simp [addVal_mul u₀.ne_zero v₀.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u₀ : Lˣ, Multiplicative.toAdd (relValHom u₀) = relVal F L u₀ :=
    fun _ => rfl
  have relVal_units_mul : ∀ u₀ v₀ : Lˣ,
      relVal F L ((u₀ * v₀ : Lˣ) : L) = relVal F L u₀ + relVal F L v₀ := by
    intro u₀ v₀
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u₀ : Lˣ) (k : ℤ),
      relVal F L ((u₀ ^ k : Lˣ) : L) = k * relVal F L u₀ := by
    intro u₀ k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have relVal_mul : ∀ {x z : L} (hx : x ≠ 0) (hz : z ≠ 0),
      relVal F L (x * z) = relVal F L x + relVal F L z := by
    intro x z hx hz
    exact relVal_units_mul (Units.mk0 x hx) (Units.mk0 z hz)
  have exists_addVal_eq_one : ∃ uF : Fˣ, addVal F uF = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F L ∧ ∃ π : Lˣ, relVal F L π = resDeg F L := by
    obtain ⟨uF, hu_val⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L uF,
        (map_ne_zero (algebraMap F L)).mpr uF.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (uF : F)) = (uF : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (uF : F)
      have hpow : addVal F ((uF : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F uF := by
        change Multiplicative.toAdd (addValHom (uF ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu_val, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hf_pos, π_ex, hπ_ex⟩ := resDeg_mem
  have relVal_eq_resDeg_mul_valL_aux :
      ∀ u₀ : Lˣ, relVal F L u₀ = (resDeg F L : ℤ) * valL F L u₀ := by
    intro u₀
    let q₀ := relVal F L u₀ / (resDeg F L : ℤ)
    let r₀ := relVal F L u₀ % (resDeg F L : ℤ)
    have hdiv : r₀ + (resDeg F L : ℤ) * q₀ = relVal F L u₀ := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r₀ := Int.emod_nonneg _ (by positivity)
    have hrlt : r₀ < (resDeg F L : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy_rem : relVal F L ((u₀ * π_ex ^ (-q₀) : Lˣ) : L) = r₀ := by
      rw [relVal_units_mul, relVal_units_zpow, hπ_ex]
      linarith
    have hr_eq : r₀ = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r₀.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r₀.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k} := by
        refine ⟨hr_pos, ((u₀ * π_ex ^ (-q₀) : Lˣ) : L), Units.ne_zero _, ?_⟩
        rw [hy_rem, Int.toNat_of_nonneg hr0]
      have hle : resDeg F L ≤ r₀.toNat := Nat.sInf_le hmem
      omega
    change relVal F L u₀ = (resDeg F L : ℤ) * q₀
    linarith
  have relVal_eq : ∀ {x : L} (hx : x ≠ 0), relVal F L x = (resDeg F L : ℤ) * valL F L x :=
    fun hx => relVal_eq_resDeg_mul_valL_aux (Units.mk0 _ hx)
  set πL : L := (chosenUniformizer F L : L)
  have hπL_ne : πL ≠ 0 := Units.ne_zero (chosenUniformizer F L)
  have hπ_val : valL F L πL = 1 := by
    have hf_ne : (resDeg F L : ℤ) ≠ 0 := by positivity
    have hπ_ex_val : valL F L π_ex = 1 := by
      rw [valL, hπ_ex, Int.ediv_self hf_ne]
    exact Classical.epsilon_spec (p := fun π : Lˣ => valL F L π = 1) ⟨π_ex, hπ_ex_val⟩
  have valL_mul : ∀ {x z : L} (hx : x ≠ 0) (hz : z ≠ 0),
      valL F L (x * z) = valL F L x + valL F L z := by
    intro x z hx hz
    have hxz : x * z ≠ 0 := mul_ne_zero hx hz
    have h := relVal_mul hx hz
    rw [relVal_eq hxz, relVal_eq hx, relVal_eq hz, ← mul_add] at h
    exact mul_left_cancel₀ (by positivity) h
  have valL_one : valL F L 1 = 0 := by
    have h1 : (1 : L) ≠ 0 := one_ne_zero
    have h := valL_mul h1 h1
    rw [mul_one] at h
    omega
  have valL_div : ∀ {x z : L} (hx : x ≠ 0) (hz : z ≠ 0),
      valL F L (x / z) = valL F L x - valL F L z := by
    intro x z hx hz
    have hxz : x / z ≠ 0 := div_ne_zero hx hz
    have h := valL_mul hxz hz
    rw [div_mul_cancel₀ _ hz] at h
    omega
  have valL_pow : ∀ {x : L} (hx : x ≠ 0) (k : ℕ), valL F L (x ^ k) = (k : ℤ) * valL F L x := by
    intro x hx k
    induction k with
    | zero => simp [valL_one]
    | succ k ih =>
      rw [pow_succ, valL_mul (pow_ne_zero k hx) hx, ih]
      push_cast
      ring
  have h_pow_val : ∀ m : ℕ, valL F L (πL ^ m) = (m : ℤ) := by
    intro m
    rw [valL_pow hπL_ne m, hπ_val, mul_one]
  letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
  haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
  haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
  letI : Valued F (ValueGroupWithZero F) :=
    IsValuativeTopology.instValuedValueGroupWithZeroOfIsUniformAddGroup
  let rlo : RankLeOneStruct F :=
    { emb := (WithZeroMulInt.toNNReal (by norm_num : (2 : NNReal) ≠ 0)).comp
        (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).toMonoidWithZeroHom
      strictMono := (WithZeroMulInt.toNNReal_strictMono (by norm_num : (1 : NNReal) < 2)).comp
        (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).strictMono }
  haveI : (Valued.v (R := F)).RankOne := Valuation.RankOne.ofRankLeOneStruct rlo
  letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
  haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F (ValueGroupWithZero F)
  have h_norm_and_int_aux : ∀ (K : Type u) [Field K] [Algebra F K] [FiniteDimensional F K] (x : K),
      (spectralNorm F K x ≤ 1 ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x)) ∧
      (IsIntegral 𝒪[F] x ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x)) := by
    intro K _ _ _ x
    letI : NormedField K := spectralNorm.normedField F K
    by_cases hx0 : x = 0
    · subst hx0
      refine ⟨⟨fun _ => Or.inl rfl, fun _ => by change ‖(0 : K)‖ ≤ 1; rw [norm_zero]; exact zero_le_one⟩,
        ⟨fun _ => Or.inl rfl, fun _ => isIntegral_zero⟩⟩
    · have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
      have hx_int_F : IsIntegral F x := Algebra.IsIntegral.isIntegral x
      let pb : PowerBasis F (IntermediateField.adjoin F ({x} : Set K)) :=
        IntermediateField.adjoin.powerBasis hx_int_F
      have h_gen_coe : (pb.gen : K) = x := IntermediateField.AdjoinSimple.coe_gen F x
      set dK : ℕ := Module.finrank (IntermediateField.adjoin F ({x} : Set K)) K
      have h_finrank_pos : 0 < dK := Module.finrank_pos
      have h_norm_tower : Algebra.norm F x = (Algebra.norm F pb.gen) ^ dK := by
        have h1 : Algebra.norm F (pb.gen : K) = (Algebra.norm F pb.gen) ^ dK := by
          rw [← Algebra.norm_norm (R := F) (S := IntermediateField.adjoin F ({x} : Set K))
            (A := K) (a := (pb.gen : K)), ← map_pow]
          congr 1
          exact Algebra.norm_algebraMap (L := K) pb.gen
        rwa [h_gen_coe] at h1
      have h_norm_pb : Algebra.norm F pb.gen =
          (-1) ^ pb.dim * (minpoly F pb.gen).coeff 0 :=
        Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb
      have h_minpoly_eq : minpoly F pb.gen = minpoly F x := by
        have h1 : minpoly F pb.gen = minpoly F (pb.gen : K) :=
          (minpoly.algHom_eq
            (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K)))
            (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K))).injective
            pb.gen).symm
        rwa [h_gen_coe] at h1
      have h_norm_coeff_pow : ‖Algebra.norm F x‖ =
          ‖(minpoly F x).coeff 0‖ ^ dK := by
        rw [h_norm_tower, h_norm_pb, h_minpoly_eq, norm_pow, norm_mul, norm_pow,
          norm_neg, norm_one, one_pow, one_mul]
      have h_spec_iff : spectralNorm F K x ≤ 1 ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x) := by
        rw [or_iff_right hx0]
        constructor
        · intro h_spec
          have h_spec_val : spectralValue (minpoly F x) ≤ 1 := h_spec
          have h_coeff0_le : ‖(minpoly F x).coeff 0‖ ≤ 1 :=
            (spectralValue_le_one_iff (minpoly.monic hx_int_F)).mp h_spec_val 0
          have h_norm_le : ‖Algebra.norm F x‖ ≤ 1 := by
            rw [h_norm_coeff_pow]
            exact pow_le_one₀ (norm_nonneg _) h_coeff0_le
          have h_val_le : valuation F (Algebra.norm F x) ≤ 1 :=
            Valued.toNormedField.norm_le_one_iff.mp h_norm_le
          exact (addVal_nonneg_iff_val_le_one hnorm0).mpr h_val_le
        · intro h_rel
          have h_val_le : valuation F (Algebra.norm F x) ≤ 1 :=
            (addVal_nonneg_iff_val_le_one hnorm0).mp h_rel
          have h_norm_le : ‖Algebra.norm F x‖ ≤ 1 :=
            Valued.toNormedField.norm_le_one_iff.mpr h_val_le
          have h_coeff0_le : ‖(minpoly F x).coeff 0‖ ≤ 1 := by
            rw [h_norm_coeff_pow] at h_norm_le
            exact (pow_le_one_iff_of_nonneg (norm_nonneg _) h_finrank_pos.ne').mp h_norm_le
          rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow F K x]
          exact Real.rpow_le_one (norm_nonneg _) h_coeff0_le (by positivity)
      refine ⟨h_spec_iff, ?_⟩
      rw [or_iff_right hx0]
      constructor
      · intro hx_int
        have hnorm_int : IsIntegral 𝒪[F] (Algebra.norm F x) := Algebra.isIntegral_norm F hx_int
        have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
          (Valuation.Integers.isIntegral_iff_v_le_one
            (Valuation.integer.integers (valuation F))).mp hnorm_int
        exact (addVal_nonneg_iff_val_le_one hnorm0).mpr hval_le
      · intro h_rel
        have h_spec_le : spectralValue (minpoly F x) ≤ 1 :=
          h_spec_iff.mpr (Or.inr h_rel)
        have h_all_coeffs : ∀ k : ℕ, ‖(minpoly F x).coeff k‖ ≤ 1 :=
          (spectralValue_le_one_iff (minpoly.monic hx_int_F)).mp h_spec_le
        have h_lifts : minpoly F x ∈ Polynomial.lifts (algebraMap 𝒪[F] F) := by
          rw [Polynomial.lifts_iff_coeff_lifts]
          intro k
          have hv : valuation F ((minpoly F x).coeff k) ≤ 1 :=
            Valued.toNormedField.norm_le_one_iff.mp (h_all_coeffs k)
          exact ⟨⟨(minpoly F x).coeff k, hv⟩, rfl⟩
        obtain ⟨P₀, hP₀_map, -, hP₀_monic⟩ :=
          Polynomial.lifts_and_degree_eq_and_monic h_lifts (minpoly.monic hx_int_F)
        refine ⟨P₀, hP₀_monic, ?_⟩
        have h_eval : Polynomial.aeval x (P₀.map (algebraMap 𝒪[F] F)) = 0 := by
          rw [hP₀_map]
          exact minpoly.aeval F x
        rwa [Polynomial.aeval_map_algebraMap] at h_eval
  have h_rel_iff_valL : ∀ z : L, (z = 0 ∨ 0 ≤ addVal F (Algebra.norm F z)) ↔ (z = 0 ∨ 0 ≤ valL F L z) := by
    intro z
    by_cases hz0 : z = 0
    · simp [hz0]
    · rw [or_iff_right hz0, or_iff_right hz0]
      change 0 ≤ relVal F L z ↔ 0 ≤ valL F L z
      rw [relVal_eq hz0]
      exact ⟨fun h => nonneg_of_mul_nonneg_right h (by positivity),
        fun h => mul_nonneg (by positivity) h⟩
  have mem_int_iff : ∀ z : L, IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ valL F L z :=
    fun z => ((h_norm_and_int_aux L z).2).trans (h_rel_iff_valL z)
  let V : ℕ → L → Prop := fun m z => z = 0 ∨ (m : ℤ) ≤ valL F L z
  have V_iff_int : ∀ (m : ℕ) (z : L), V m z ↔ IsIntegral 𝒪[F] (z / πL ^ m) := by
    intro m z
    rw [mem_int_iff]
    by_cases hz : z = 0
    · simp [V, hz]
    · have hpow_ne : πL ^ m ≠ 0 := pow_ne_zero m hπL_ne
      have hdiv_ne : z / πL ^ m ≠ 0 := div_ne_zero hz hpow_ne
      dsimp [V]
      rw [or_iff_right hz, or_iff_right hdiv_ne, valL_div hz hpow_ne, h_pow_val m]
      omega
  have V_one : V 0 1 := by
    rw [V_iff_int, pow_zero, div_one]
    exact isIntegral_one
  have V_mono : ∀ {m₁ m₂ : ℕ}, m₁ ≤ m₂ → ∀ {a : L}, V m₂ a → V m₁ a := by
    intro m₁ m₂ hle a ha
    rcases ha with rfl | ha
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have V_add : ∀ {m : ℕ} {a b : L}, V m a → V m b → V m (a + b) := by
    intro m a b ha hb
    rw [V_iff_int, add_div]
    exact IsIntegral.add ((V_iff_int m a).mp ha) ((V_iff_int m b).mp hb)
  have V_sub : ∀ {m : ℕ} {a b : L}, V m a → V m b → V m (a - b) := by
    intro m a b ha hb
    rw [V_iff_int, sub_div]
    exact IsIntegral.sub ((V_iff_int m a).mp ha) ((V_iff_int m b).mp hb)
  have hu_sub_V1 : V 1 ((u : L) - 1) := Or.inr (by omega)
  have hu_sub_V0 : V 0 ((u : L) - 1) := V_mono (by omega) hu_sub_V1
  have hu_V0 : V 0 (u : L) := by
    have heq : (u : L) = ((u : L) - 1) + 1 := by ring
    rw [heq]
    exact V_add hu_sub_V0 V_one
  have hu_val_nonneg : 0 ≤ valL F L (u : L) := by
    rcases hu_V0 with h0 | hle
    · exact False.elim (u.ne_zero h0)
    · exact hle
  have hu_not_V1 : ¬ V 1 (u : L) := by
    intro hu_V1
    have h_one_V1 : V 1 (1 : L) := by
      have heq : (1 : L) = (u : L) - ((u : L) - 1) := by ring
      rw [heq]
      exact V_sub hu_V1 hu_sub_V1
    rcases h_one_V1 with h10 | h1le
    · exact one_ne_zero h10
    · rw [valL_one] at h1le
      omega
  have hu_val_lt_one : valL F L (u : L) < 1 := by
    by_contra hge
    exact hu_not_V1 (Or.inr (by omega))
  have hu_val_zero : valL F L (u : L) = 0 := by omega
  have hu_relVal_zero : relVal F L (u : L) = 0 := by
    rw [relVal_eq u.ne_zero, hu_val_zero, mul_zero]
  have hy_relVal : relVal F E y = relVal F L (u : L) := by
    unfold relVal
    rw [← Algebra.norm_norm (R := F) (S := L) (a := y), hy_norm]
  have hy_val_zero : valL F E y = 0 := by
    unfold valL
    rw [hy_relVal, hu_relVal_zero, Int.zero_ediv]
  exact ⟨hy_ne, hy_val_zero⟩

theorem exists_normLM_lubinTateDivField_eq_of_le_valL_sub_one (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (n : ℕ) :
    1 ≤ n → ∀ (h_L_div : L ≤ lubinTateDivField F L n) (u : Lˣ),
      (n : ℤ) ≤ valL F L ((u : L) - 1) →
      ∃ v : (lubinTateDivField F L n)ˣ,
        valL F (lubinTateDivField F L n) (v : lubinTateDivField F L n) = 0 ∧
        normLM F h_L_div (v : lubinTateDivField F L n) = (u : L) :=
by
  intro hn h_L_div u hu
  have hπ : valL F L (chosenUniformizer F L) = 1 :=
    (valL_chosenUniformizer_and_mul_zpow F L 1).1
  haveI : FiniteDimensional F (lubinTateUnramField F L n 1) :=
    finiteDimensional_lubinTateUnramField F L n 1 le_rfl
  have h_div_le : lubinTateDivField F L n ≤ lubinTateUnramField F L n 1 :=
    sup_le_sup_left (IntermediateField.adjoin_le_iff.mpr
      (Set.subset_union_left.trans (IntermediateField.subset_adjoin F _))) L
  haveI : FiniteDimensional F (lubinTateDivField F L n) :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h_div_le).toLinearMap
      (IntermediateField.inclusion h_div_le).injective
  obtain ⟨π_n, hπ_aeval, h_level⟩ :=
    exists_aeval_lubinTateDivPoly_eq_zero_and_lubinTateLevelField_eq_adjoin F L
      (chosenUniformizer F L) hπ n hn
  obtain ⟨c, hc⟩ := exists_one_sub_iterate_pow_eq_of_le_valL_sub_one F L n hn u hu
  obtain ⟨y, hy⟩ :=
    exists_normLM_eq_one_sub_iterate_pow_of_lubinTateLevelField_eq_adjoin F L n hn π_n
      hπ_aeval h_level h_L_div c
  rw [hc] at hy
  obtain ⟨hy_ne, hy_val⟩ :=
    valL_eq_zero_of_normLM_eq_of_le_valL_sub_one F L (lubinTateDivField F L n) h_L_div
      n hn u hu y hy
  exact ⟨Units.mk0 y hy_ne, hy_val, hy⟩

theorem exists_normLM_lubinTateUnramField_eq_of_valL_eq_zero (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (n m : ℕ) :
    1 ≤ n → 1 ≤ m → ∀ (h_div : lubinTateDivField F L n ≤ lubinTateUnramField F L n m)
      (v : (lubinTateDivField F L n)ˣ),
      valL F (lubinTateDivField F L n) (v : lubinTateDivField F L n) = 0 →
      ∃ z : (lubinTateUnramField F L n m)ˣ,
        normLM F h_div (z : lubinTateUnramField F L n m) = (v : lubinTateDivField F L n) :=
by
  intro _hn hm
  set K := lubinTateDivField F L n
  set E := lubinTateUnramField F L n m
  intro h_div v hv
  haveI : FiniteDimensional F E := finiteDimensional_lubinTateUnramField F L n m hm
  haveI : FiniteDimensional F K :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h_div).toLinearMap
      (IntermediateField.inclusion h_div).injective
  have hϖ : valL F L (chosenUniformizer F L) = 1 :=
    (valL_chosenUniformizer_and_mul_zpow F L 1).1
  obtain ⟨τ, hτL, hτFrob⟩ := exists_actsAsFrobPow_neg_resDeg F L
  obtain ⟨σ, hσL, hσFrob, hσLT⟩ :=
    exists_isLubinTateFrob_of_frobLift F L (chosenUniformizer F L) hϖ τ hτL hτFrob
  have hσK : σ ∈ K.fixingSubgroup := by
    change σ ∈ (L ⊔ IntermediateField.adjoin F
      {α : AlgebraicClosure F | isLubinTateRoot F L (chosenUniformizer F L) n α}).fixingSubgroup
    rw [IntermediateField.fixingSubgroup_sup, Subgroup.mem_inf]
    refine ⟨hσL, ?_⟩
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    induction hz using IntermediateField.adjoin_induction with
    | mem x hx => exact hσLT n x hx
    | algebraMap r => exact AlgEquiv.commutes _ r
    | add a b _ _ ha hb => rw [map_add, ha, hb]
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
    | inv a _ ha => rw [map_inv₀, ha]
  have h_resDeg : resDeg F K = resDeg F L :=
    resDeg_eq_of_actsAsFrobPow_neg_resDeg_and_mem_fixingSubgroup F L K le_sup_left σ hσFrob hσK
  have h_qL : qL F K = qL F L := by
    unfold qL
    rw [h_resDeg]
  set U := unramifiedLevelField F K (qL F K ^ m - 1)
  have h_EU : E ≤ U.restrictScalars F := by
    change L ⊔ IntermediateField.adjoin F
      ({α : AlgebraicClosure F | isLubinTateRoot F L (chosenUniformizer F L) n α} ∪
       {ζ : AlgebraicClosure F | ζ ^ (qL F L ^ m - 1) = 1}) ≤ U.restrictScalars F
    apply sup_le
    · intro y hy
      rw [IntermediateField.mem_restrictScalars]
      exact U.algebraMap_mem ⟨y, (le_sup_left : L ≤ K) hy⟩
    · rw [IntermediateField.adjoin_le_iff]
      rintro x (hx | hx)
      · change x ∈ U
        exact U.algebraMap_mem
          ⟨x, (le_sup_right : _ ≤ K) (IntermediateField.subset_adjoin F _ hx)⟩
      · change x ∈ U
        apply IntermediateField.subset_adjoin K {ζ : AlgebraicClosure F | ζ ^ (qL F K ^ m - 1) = 1}
        simp only [Set.mem_setOf_eq, h_qL]
        exact hx
  have h_ext : IntermediateField.extendScalars h_div = U := by
    apply le_antisymm
    · intro y hy
      exact (IntermediateField.mem_restrictScalars F).mp
        (h_EU ((IntermediateField.mem_extendScalars h_div).mp hy))
    · change IntermediateField.adjoin K {ζ : AlgebraicClosure F | ζ ^ (qL F K ^ m - 1) = 1} ≤
        IntermediateField.extendScalars h_div
      rw [IntermediateField.adjoin_le_iff]
      intro ζ hζ
      change ζ ∈ IntermediateField.extendScalars h_div
      rw [IntermediateField.mem_extendScalars]
      apply (le_sup_right : _ ≤ E)
      apply IntermediateField.subset_adjoin F
      right
      simp only [Set.mem_setOf_eq] at hζ ⊢
      rwa [← h_qL]
  obtain ⟨ζ, u, hζ_pow, hu_val, hv_eq⟩ :=
    exists_pow_qL_sub_one_eq_one_and_valL_sub_one_of_valL_eq_zero F K v hv
  obtain ⟨ξ, hξ_norm⟩ :=
    exists_norm_unramifiedLevelField_eq_of_pow_qL_sub_one_eq_one F K m hm (ζ : K) hζ_pow
  obtain ⟨hGal, hFin, e₀, he₀_int, he₀_tr⟩ :=
    unramifiedLevelField_isGalois_and_exists_isIntegral_trace_eq_one F K m hm
  haveI : IsGalois K U := hGal
  haveI : FiniteDimensional K U := hFin
  obtain ⟨w, hw_norm⟩ :=
    exists_norm_eq_of_isIntegral_trace_eq_one_and_le_valL_sub_one F K U e₀ he₀_int he₀_tr u hu_val
  let y : U := ξ * w
  have hy_norm : Algebra.norm K y = (v : K) := by
    change Algebra.norm K (ξ * w) = (v : K)
    rw [map_mul, hξ_norm, hw_norm, hv_eq, Units.val_mul]
  let e : U ≃ₐ[K] IntermediateField.extendScalars h_div :=
    IntermediateField.equivOfEq h_ext.symm
  let y_E : E := ⟨(e y).1, (IntermediateField.mem_extendScalars h_div).mp (e y).2⟩
  have hy_E_norm : normLM F h_div y_E = (v : K) := by
    change Algebra.norm K (toExtendScalars F h_div y_E) = (v : K)
    have h_to : toExtendScalars F h_div y_E = e y := rfl
    rw [h_to, Algebra.norm_eq_of_algEquiv e y, hy_norm]
  have hy_E_ne : y_E ≠ 0 := by
    intro h0
    have hy0 : y = 0 := by
      apply e.injective
      rw [map_zero]
      change toExtendScalars F h_div y_E = 0
      rw [h0, map_zero]
    rw [hy0, Algebra.norm_zero] at hy_norm
    exact v.ne_zero hy_norm.symm
  exact ⟨Units.mk0 y_E hy_E_ne, hy_E_norm⟩

theorem unitGroup_mem_range_normLM_of_le_lubinTateUnramField (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (h : L ≤ M) :
    IsAbelianExt F h → ∀ (n m : ℕ), 1 ≤ n → 1 ≤ m → M ≤ lubinTateUnramField F L n m →
      ∀ u : Lˣ, u ∈ unitGroup F L n → (u : L) ∈ Set.range (normLM F h) :=
by
  intro _hab n m hn hm hM u hu
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion h).injective
  haveI : FiniteDimensional F (lubinTateUnramField F L n m) :=
    finiteDimensional_lubinTateUnramField F L n m hm
  have h_L_div : L ≤ lubinTateDivField F L n := le_sup_left
  have h_div : lubinTateDivField F L n ≤ lubinTateUnramField F L n m :=
    sup_le_sup_left (IntermediateField.adjoin_le_iff.mpr
      (Set.subset_union_left.trans (IntermediateField.subset_adjoin F _))) L
  suffices hu_mem : u ∈ (Units.map (normLM F h)).range by
    rcases hu_mem with ⟨y, hy⟩
    exact ⟨(y : M), congrArg Units.val hy⟩
  refine (Subgroup.closure_le _).mpr (fun u₀ hu₀ => ?_) hu
  have hn0 : n ≠ 0 := by omega
  simp only [Set.mem_setOf_eq, if_neg hn0] at hu₀
  rcases hu₀ with hu₀_one | hu₀_val
  · have hu₀_eq : u₀ = 1 := Units.ext hu₀_one
    rw [hu₀_eq]
    exact Subgroup.one_mem _
  · obtain ⟨v, hv_val, hv_norm⟩ :=
      exists_normLM_lubinTateDivField_eq_of_le_valL_sub_one F L n hn h_L_div u₀ hu₀_val
    obtain ⟨z, hz_norm⟩ :=
      exists_normLM_lubinTateUnramField_eq_of_valL_eq_zero F L n m hn hm h_div v hv_val
    refine ⟨Units.map (normLM F hM) z, Units.ext ?_⟩
    change normLM F h (normLM F hM (z : lubinTateUnramField F L n m)) = (u₀ : L)
    rw [← normLM_comp F L M (lubinTateUnramField F L n m) h hM (z : lubinTateUnramField F L n m)]
    have h_trans_eq : h.trans hM = h_L_div.trans h_div := Subsingleton.elim _ _
    rw [h_trans_eq, normLM_comp F L (lubinTateDivField F L n) (lubinTateUnramField F L n m)
      h_L_div h_div (z : lubinTateUnramField F L n m)]
    rw [hz_norm, hv_norm]

theorem uniformizer_zpow_mem_range_normLM_of_le_lubinTateUnramField (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (h : L ≤ M) :
    IsAbelianExt F h → ∀ (n m : ℕ), 1 ≤ n → 1 ≤ m → M ≤ lubinTateUnramField F L n m →
      ∀ k : ℤ,
        (((chosenUniformizer F L) ^ ((m : ℤ) * k) : Lˣ) : L) ∈ Set.range (normLM F h) :=
by
  intro _hab n m hn hm hM k
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion h).injective
  set K := lubinTateDivField F L n
  set E := lubinTateUnramField F L n m
  haveI : FiniteDimensional F E := finiteDimensional_lubinTateUnramField F L n m hm
  have h_L_div : L ≤ K := le_sup_left
  have h_div : K ≤ E :=
    sup_le_sup_left (IntermediateField.adjoin_le_iff.mpr
      (Set.subset_union_left.trans (IntermediateField.subset_adjoin F _))) L
  haveI : FiniteDimensional F K :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h_div).toLinearMap
      (IntermediateField.inclusion h_div).injective
  set ϖ : Lˣ := chosenUniformizer F L
  have hϖ : valL F L ϖ = 1 := (valL_chosenUniformizer_and_mul_zpow F L 1).1
  
  obtain ⟨hf_monic, hf_coeff0, hf_irr⟩ :=
    lubinTateDivPoly_monic_coeff_zero_and_irreducible F L ϖ hϖ n hn
  obtain ⟨π_n, hπ_aeval, h_level⟩ :=
    exists_aeval_lubinTateDivPoly_eq_zero_and_lubinTateLevelField_eq_adjoin F L ϖ hϖ n hn
  obtain ⟨z_lvl, hz_lvl⟩ :=
    exists_norm_eq_of_eq_adjoin_of_irreducible_monic F L (lubinTateLevelField F L ϖ n)
      (lubinTateDivPoly F L (ϖ : L) n) π_n h_level hf_monic hf_irr hπ_aeval
  rw [hf_coeff0] at hz_lvl
  have h_K_le : K ≤ (lubinTateLevelField F L ϖ n).restrictScalars F := by
    change L ⊔ IntermediateField.adjoin F
      {α : AlgebraicClosure F | isLubinTateRoot F L ϖ n α} ≤
        (lubinTateLevelField F L ϖ n).restrictScalars F
    apply sup_le
    · intro x hx
      rw [IntermediateField.mem_restrictScalars]
      exact (lubinTateLevelField F L ϖ n).algebraMap_mem ⟨x, hx⟩
    · rw [IntermediateField.adjoin_le_iff]
      intro α hα
      exact (IntermediateField.mem_restrictScalars F).mpr
        (IntermediateField.subset_adjoin L _ hα)
  have h_ext_K : IntermediateField.extendScalars h_L_div = lubinTateLevelField F L ϖ n := by
    apply le_antisymm
    · intro x hx
      exact (IntermediateField.mem_restrictScalars F).mp
        (h_K_le ((IntermediateField.mem_extendScalars h_L_div).mp hx))
    · change IntermediateField.adjoin L {α : AlgebraicClosure F | isLubinTateRoot F L ϖ n α} ≤
        IntermediateField.extendScalars h_L_div
      rw [IntermediateField.adjoin_le_iff]
      intro α hα
      exact (IntermediateField.mem_extendScalars h_L_div).mpr
        ((le_sup_right : _ ≤ K) (IntermediateField.subset_adjoin F _ hα))
  let e_K : lubinTateLevelField F L ϖ n ≃ₐ[L] IntermediateField.extendScalars h_L_div :=
    IntermediateField.equivOfEq h_ext_K.symm
  let z₀ : K := ⟨(e_K z_lvl).1, (IntermediateField.mem_extendScalars h_L_div).mp (e_K z_lvl).2⟩
  have hz₀_norm : normLM F h_L_div z₀ = (ϖ : L) := by
    change Algebra.norm L (toExtendScalars F h_L_div z₀) = (ϖ : L)
    have h_to : toExtendScalars F h_L_div z₀ = e_K z_lvl := rfl
    rw [h_to, Algebra.norm_eq_of_algEquiv e_K z_lvl, hz_lvl]
  
  obtain ⟨τ₀, hτ₀L, hτ₀Frob⟩ := exists_actsAsFrobPow_neg_resDeg F L
  obtain ⟨σ, hσL, hσFrob, hσLT⟩ :=
    exists_isLubinTateFrob_of_frobLift F L ϖ hϖ τ₀ hτ₀L hτ₀Frob
  have hσK : σ ∈ K.fixingSubgroup := by
    change σ ∈ (L ⊔ IntermediateField.adjoin F
      {α : AlgebraicClosure F | isLubinTateRoot F L ϖ n α}).fixingSubgroup
    rw [IntermediateField.fixingSubgroup_sup, Subgroup.mem_inf]
    refine ⟨hσL, ?_⟩
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    induction hz using IntermediateField.adjoin_induction with
    | mem x hx => exact hσLT n x hx
    | algebraMap r => exact AlgEquiv.commutes _ r
    | add a b _ _ ha hb => rw [map_add, ha, hb]
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
    | inv a _ ha => rw [map_inv₀, ha]
  have h_resDeg : resDeg F K = resDeg F L :=
    resDeg_eq_of_actsAsFrobPow_neg_resDeg_and_mem_fixingSubgroup F L K h_L_div σ hσFrob hσK
  have h_qL : qL F K = qL F L := by
    unfold qL
    rw [h_resDeg]
  set N := qL F K ^ m - 1
  set U := unramifiedLevelField F K N
  have h_EU : E ≤ U.restrictScalars F := by
    change L ⊔ IntermediateField.adjoin F
      ({α : AlgebraicClosure F | isLubinTateRoot F L ϖ n α} ∪
       {ζ : AlgebraicClosure F | ζ ^ (qL F L ^ m - 1) = 1}) ≤ U.restrictScalars F
    apply sup_le
    · intro y hy
      rw [IntermediateField.mem_restrictScalars]
      exact U.algebraMap_mem ⟨y, h_L_div hy⟩
    · rw [IntermediateField.adjoin_le_iff]
      rintro x (hx | hx)
      · change x ∈ U
        exact U.algebraMap_mem ⟨x, (le_sup_right : _ ≤ K) (IntermediateField.subset_adjoin F _ hx)⟩
      · change x ∈ U
        apply IntermediateField.subset_adjoin K {ζ : AlgebraicClosure F | ζ ^ N = 1}
        simp only [Set.mem_setOf_eq, N, h_qL]
        exact hx
  have h_ext : IntermediateField.extendScalars h_div = U := by
    apply le_antisymm
    · intro y hy
      exact (IntermediateField.mem_restrictScalars F).mp
        (h_EU ((IntermediateField.mem_extendScalars h_div).mp hy))
    · change IntermediateField.adjoin K {ζ : AlgebraicClosure F | ζ ^ N = 1} ≤
        IntermediateField.extendScalars h_div
      rw [IntermediateField.adjoin_le_iff]
      intro ζ hζ
      change ζ ∈ IntermediateField.extendScalars h_div
      rw [IntermediateField.mem_extendScalars]
      apply (le_sup_right : _ ≤ E)
      apply IntermediateField.subset_adjoin F
      right
      simp only [Set.mem_setOf_eq, N] at hζ ⊢
      rwa [← h_qL]
  
  have hres_ne : resDeg F L ≠ 0 := by
    intro h0
    unfold valL at hϖ
    rw [h0, Nat.cast_zero, Int.ediv_zero] at hϖ
    omega
  have hresK_pos : 0 < resDeg F K := by
    rw [h_resDeg]
    exact Nat.pos_of_ne_zero hres_ne
  haveI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  haveI : CharP 𝓀[F] (p F) := by unfold p; infer_instance
  obtain ⟨d_F, hp, hq⟩ := FiniteField.card 𝓀[F] (p F)
  have hq' : q F = p F ^ (d_F : ℕ) := by
    rw [q, Nat.card_eq_fintype_card, hq]
  have hp_ge_two : 2 ≤ p F := hp.two_le
  have hqK_ge_two : 2 ≤ qL F K := by
    dsimp [qL]
    rw [hq', ← pow_mul]
    have hpos : 0 < (d_F : ℕ) * resDeg F K := Nat.mul_pos d_F.pos hresK_pos
    calc 2 = 2 ^ 1 := by ring
      _ ≤ 2 ^ ((d_F : ℕ) * resDeg F K) := Nat.pow_le_pow_right (by omega) hpos
      _ ≤ p F ^ ((d_F : ℕ) * resDeg F K) := Nat.pow_le_pow_left hp_ge_two _
  have hqKm_ge_two : 2 ≤ qL F K ^ m := by
    calc 2 = 2 ^ 1 := by ring
      _ ≤ 2 ^ m := Nat.pow_le_pow_right (by omega) hm
      _ ≤ qL F K ^ m := Nat.pow_le_pow_left hqK_ge_two m
  have hN_pos : 0 < N := by omega
  have hpN : ¬ p F ∣ N := by
    intro hdvd
    have hdvd_pow : p F ∣ qL F K ^ m := by
      dsimp [qL]
      rw [hq', ← pow_mul, ← pow_mul]
      have hk_pos : 0 < (d_F : ℕ) * (resDeg F K * m) :=
        Nat.mul_pos d_F.pos (Nat.mul_pos hresK_pos (by omega))
      exact dvd_pow_self (p F) hk_pos.ne'
    have hdvd_one : p F ∣ 1 := by
      have hsub := Nat.dvd_sub hdvd_pow hdvd
      have heq : qL F K ^ m - N = 1 := by omega
      rwa [heq] at hsub
    exact hp.not_dvd_one hdvd_one
  obtain ⟨hGal, hFinU, hB⟩ := unramifiedLevelField_isGalois_and_resDeg F K N hN_pos hpN
  haveI : IsGalois K U := hGal
  haveI : FiniteDimensional K U := hFinU
  haveI : Fintype (U ≃ₐ[K] U) := Fintype.ofFinite (U ≃ₐ[K] U)
  have h_card_aut : Fintype.card (U ≃ₐ[K] U) = Module.finrank K U := by
    rw [← Nat.card_eq_fintype_card, IsGalois.card_aut_eq_finrank K U]
  obtain ⟨τ, hτK, hτFrob⟩ := exists_actsAsFrobPow_neg_resDeg F K
  have hτK_fix : ∀ x ∈ K, τ x = x := by
    rwa [IntermediateField.mem_fixingSubgroup_iff] at hτK
  let τ_K : AlgebraicClosure F ≃ₐ[K] AlgebraicClosure F :=
    { τ.toRingEquiv with
      commutes' := fun x => hτK_fix x.1 x.2 }
  let ϕ_τ : U ≃ₐ[K] U := AlgEquiv.restrictNormalHom U τ_K
  have h_ϕ_apply : ∀ x : U, ((ϕ_τ x : U) : AlgebraicClosure F) = τ (x : AlgebraicClosure F) := by
    intro x
    exact AlgEquiv.restrictNormal_commutes τ_K U x
  have h_ϕ_pow : ∀ (i : ℕ) (x : U),
      (((ϕ_τ ^ i) x : U) : AlgebraicClosure F) = (τ ^ i) (x : AlgebraicClosure F) := by
    intro i
    induction i with
    | zero => intro x; rfl
    | succ i ih =>
      intro x
      rw [pow_succ', pow_succ', AlgEquiv.mul_apply, AlgEquiv.mul_apply, h_ϕ_apply, ih]
  
  obtain ⟨ζ₀, hζ_U, _hζ_m, hζ_ne⟩ :=
    exists_root_unramDegSubfield_pow_apply_eq_and_ne F K m hm τ hτFrob
  have h_unram_le_U : unramDegSubfield F K m ≤ U.restrictScalars F := by
    change K ⊔ IntermediateField.adjoin F {ζ : AlgebraicClosure F | ζ ^ N = 1} ≤ U.restrictScalars F
    apply sup_le
    · intro x hx
      rw [IntermediateField.mem_restrictScalars]
      exact U.algebraMap_mem ⟨x, hx⟩
    · rw [IntermediateField.adjoin_le_iff]
      intro ζ hζ
      exact (IntermediateField.mem_restrictScalars F).mpr
        (IntermediateField.subset_adjoin K _ hζ)
  have hζ₀_mem_U : ζ₀ ∈ U := by
    have h0 := hζ_U 0
    rw [pow_zero, AlgEquiv.one_apply] at h0
    exact (IntermediateField.mem_restrictScalars F).mp (h_unram_le_U h0)
  let z_root : U := ⟨ζ₀, hζ₀_mem_U⟩
  have h_ϕ_pow_ne_one : ∀ j : ℕ, 1 ≤ j → j < m → ϕ_τ ^ j ≠ 1 := by
    intro j hj1 hj2 h_eq
    have h1 := congr_arg (fun g : U ≃ₐ[K] U => ((g z_root : U) : AlgebraicClosure F)) h_eq
    dsimp only at h1
    rw [h_ϕ_pow j z_root] at h1
    exact hζ_ne j hj1 hj2 h1
  let f_pow : Fin m → (U ≃ₐ[K] U) := fun i => ϕ_τ ^ (i : ℕ)
  have hf_inj : Function.Injective f_pow := by
    intro i₁ i₂ hf
    dsimp [f_pow] at hf
    rcases lt_trichotomy (i₁ : ℕ) (i₂ : ℕ) with hlt | heq | hgt
    · exfalso
      have h_add : (i₁ : ℕ) + ((i₂ : ℕ) - (i₁ : ℕ)) = (i₂ : ℕ) := Nat.add_sub_of_le hlt.le
      have h_mul : ϕ_τ ^ (i₁ : ℕ) * ϕ_τ ^ ((i₂ : ℕ) - (i₁ : ℕ)) = ϕ_τ ^ (i₁ : ℕ) * 1 := by
        rw [← pow_add, h_add, mul_one, hf]
      have h_one : ϕ_τ ^ ((i₂ : ℕ) - (i₁ : ℕ)) = 1 := mul_left_cancel h_mul
      exact h_ϕ_pow_ne_one ((i₂ : ℕ) - (i₁ : ℕ)) (by omega) (by omega) h_one
    · exact Fin.ext heq
    · exfalso
      have h_add : (i₂ : ℕ) + ((i₁ : ℕ) - (i₂ : ℕ)) = (i₁ : ℕ) := Nat.add_sub_of_le hgt.le
      have h_mul : ϕ_τ ^ (i₂ : ℕ) * ϕ_τ ^ ((i₁ : ℕ) - (i₂ : ℕ)) = ϕ_τ ^ (i₂ : ℕ) * 1 := by
        rw [← pow_add, h_add, mul_one, hf]
      have h_one : ϕ_τ ^ ((i₁ : ℕ) - (i₂ : ℕ)) = 1 := mul_left_cancel h_mul
      exact h_ϕ_pow_ne_one ((i₁ : ℕ) - (i₂ : ℕ)) (by omega) (by omega) h_one
  have hm_le_finrank : m ≤ Module.finrank K U := by
    rw [← h_card_aut, ← Fintype.card_fin m]
    exact Fintype.card_le_of_injective f_pow hf_inj
  
  have h_τ_step : ∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ →
      (τ ζ) ^ (qL F K) = ζ := by
    intro ζ hζ
    have h_eq := hτFrob ζ hζ
    have h_neg : (-(-(resDeg F K : ℤ))).toNat = resDeg F K := by
      rw [neg_neg, Int.toNat_natCast]
    have h_pos : (-(resDeg F K : ℤ)).toNat = 0 := by omega
    rw [h_neg, h_pos, pow_zero, pow_one] at h_eq
    exact h_eq
  have h_τ_frob_pow : ∀ (ζ : AlgebraicClosure F), ζ ^ N = 1 →
      ∀ k : ℕ, ((τ ^ k) ζ) ^ (qL F K ^ k) = ζ := by
    intro ζ hζN k
    induction k with
    | zero => rw [pow_zero, pow_zero, AlgEquiv.one_apply, pow_one]
    | succ k ih =>
      have h_p' : IsPrimeToPRootOfUnity F ((τ ^ k) ζ) := by
        refine ⟨N, hN_pos, hpN, ?_⟩
        rw [← map_pow, hζN, map_one]
      rw [pow_succ', AlgEquiv.mul_apply, pow_succ', pow_mul, h_τ_step ((τ ^ k) ζ) h_p', ih]
  have h_τm_fix_U : ∀ x ∈ U, (τ ^ m) x = x := by
    intro x hx
    induction hx using IntermediateField.adjoin_induction with
    | mem ζ hζ =>
      simp only [Set.mem_setOf_eq] at hζ
      have h_m := h_τ_frob_pow ζ hζ m
      have h_pow_N : ((τ ^ m) ζ) ^ N = 1 := by
        rw [← map_pow, hζ, map_one]
      have hN1 : N + 1 = qL F K ^ m := by omega
      calc (τ ^ m) ζ = ((τ ^ m) ζ) ^ N * (τ ^ m) ζ := by rw [h_pow_N, one_mul]
        _ = ((τ ^ m) ζ) ^ (N + 1) := (pow_succ _ N).symm
        _ = ((τ ^ m) ζ) ^ (qL F K ^ m) := by rw [hN1]
        _ = ζ := h_m
    | algebraMap r =>
      have h_pow_K : ∀ k : ℕ, (τ ^ k) (algebraMap K (AlgebraicClosure F) r) =
          algebraMap K (AlgebraicClosure F) r := by
        intro k
        induction k with
        | zero => rfl
        | succ k ih =>
          rw [pow_succ', AlgEquiv.mul_apply, ih]
          exact hτK_fix r.1 r.2
      exact h_pow_K m
    | add a b _ _ ha hb => rw [map_add, ha, hb]
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
    | inv a _ ha => rw [map_inv₀, ha]
  have h_ϕ_m : ϕ_τ ^ m = 1 := by
    ext x
    exact h_ϕ_pow m x ▸ h_τm_fix_U x.1 x.2
  let H_sub : Subgroup (U ≃ₐ[K] U) := Subgroup.zpowers ϕ_τ
  let F₀ : IntermediateField K U := IntermediateField.fixedField H_sub
  let A : IntermediateField K (AlgebraicClosure F) := F₀.map U.val
  have hA_le_U : A ≤ U := by
    rintro y ⟨x, _, rfl⟩
    exact x.2
  haveI : FiniteDimensional K A :=
    FiniteDimensional.of_injective (IntermediateField.inclusion hA_le_U).toLinearMap
      (IntermediateField.inclusion hA_le_U).injective
  haveI : FiniteDimensional F (A.restrictScalars F) := by
    change FiniteDimensional F A
    exact FiniteDimensional.trans F K A
  have hKA : K ≤ A.restrictScalars F := by
    intro x hx
    rw [IntermediateField.mem_restrictScalars]
    exact A.algebraMap_mem ⟨x, hx⟩
  have hτA : τ ∈ (A.restrictScalars F).fixingSubgroup := by
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro y hy
    rw [IntermediateField.mem_restrictScalars] at hy
    rcases hy with ⟨x, hxF₀, rfl⟩
    have hx_fix : ϕ_τ x = x := hxF₀ ⟨ϕ_τ, Subgroup.mem_zpowers ϕ_τ⟩
    have h1 := (h_ϕ_apply x).symm
    rw [hx_fix] at h1
    exact h1
  have h_resA : resDeg F (A.restrictScalars F) ≤ resDeg F K :=
    le_of_eq (resDeg_eq_of_actsAsFrobPow_neg_resDeg_and_mem_fixingSubgroup F K
      (A.restrictScalars F) hKA τ hτFrob hτA)
  have hA_bot : A = ⊥ := by
    have h_inf := inf_eq_bot_of_resDeg_le_and_finrank_mul_resDeg_le F K A U h_resA hB
    rwa [inf_of_le_left hA_le_U] at h_inf
  have hF₀_bot : F₀ = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    have hxA : (x : AlgebraicClosure F) ∈ A := ⟨x, hx, rfl⟩
    rw [hA_bot, IntermediateField.mem_bot] at hxA
    rcases hxA with ⟨c, hc⟩
    rw [IntermediateField.mem_bot]
    refine ⟨c, Subtype.ext hc⟩
  have hH_top : H_sub = ⊤ := by
    rw [← IntermediateField.fixingSubgroup_fixedField H_sub]
    change F₀.fixingSubgroup = ⊤
    rw [hF₀_bot, IntermediateField.fixingSubgroup_bot]
  have hf_surj : Function.Surjective f_pow := by
    intro g
    have hg : g ∈ H_sub := by
      rw [hH_top]
      exact Subgroup.mem_top g
    rw [Subgroup.mem_zpowers_iff] at hg
    rcases hg with ⟨r, rfl⟩
    have hm_pos_z : (0 : ℤ) < (m : ℤ) := by omega
    let i_nat : ℕ := (r % (m : ℤ)).toNat
    have hi_nonneg : 0 ≤ r % (m : ℤ) := Int.emod_nonneg r (by omega)
    have hi_lt_z : r % (m : ℤ) < (m : ℤ) := Int.emod_lt_of_pos r hm_pos_z
    have hi_cast : (i_nat : ℤ) = r % (m : ℤ) := Int.toNat_of_nonneg hi_nonneg
    have hi_lt : i_nat < m := by omega
    refine ⟨⟨i_nat, hi_lt⟩, ?_⟩
    dsimp [f_pow]
    have hr_eq : r = (m : ℤ) * (r / (m : ℤ)) + (i_nat : ℤ) := by
      rw [hi_cast]
      exact (Int.mul_ediv_add_emod r (m : ℤ)).symm
    have h_ϕ_m_z : ϕ_τ ^ (m : ℤ) = 1 := by
      rw [zpow_natCast, h_ϕ_m]
    rw [hr_eq, zpow_add, zpow_mul, h_ϕ_m_z, one_zpow, one_mul, zpow_natCast]
  have hfinrank_le_m : Module.finrank K U ≤ m := by
    rw [← h_card_aut, ← Fintype.card_fin m]
    exact Fintype.card_le_of_surjective f_pow hf_surj
  have h_finrank_U : Module.finrank K U = m := le_antisymm hfinrank_le_m hm_le_finrank
  let e_U : U ≃ₐ[K] IntermediateField.extendScalars h_div :=
    IntermediateField.equivOfEq h_ext.symm
  have h_finrank_ext : Module.finrank K (IntermediateField.extendScalars h_div) = m := by
    rw [← LinearEquiv.finrank_eq e_U.toLinearEquiv, h_finrank_U]
  
  let z_E : E := IntermediateField.inclusion h_div z₀
  have hz_E_norm_K : normLM F h_div z_E = z₀ ^ m := by
    change Algebra.norm K (toExtendScalars F h_div (IntermediateField.inclusion h_div z₀)) = z₀ ^ m
    have h_alg : toExtendScalars F h_div (IntermediateField.inclusion h_div z₀) =
        algebraMap K (IntermediateField.extendScalars h_div) z₀ := rfl
    rw [h_alg, Algebra.norm_algebraMap, h_finrank_ext]
  have hLn : L ≤ E := h.trans hM
  have hz_E_norm_L : normLM F hLn z_E = (ϖ : L) ^ m := by
    have h_trans_eq : hLn = h_L_div.trans h_div := Subsingleton.elim _ _
    rw [h_trans_eq, normLM_comp F L K E h_L_div h_div z_E, hz_E_norm_K, map_pow, hz₀_norm]
  haveI : FiniteDimensional F (IntermediateField.extendScalars hLn) := ‹FiniteDimensional F E›
  haveI : FiniteDimensional L (IntermediateField.extendScalars hLn) :=
    FiniteDimensional.right F L (IntermediateField.extendScalars hLn)
  have hz_E_ne : z_E ≠ 0 := by
    intro h0
    have h_norm0 : normLM F hLn z_E = 0 := by
      change Algebra.norm L (toExtendScalars F hLn z_E) = 0
      rw [h0, map_zero, Algebra.norm_zero]
    rw [hz_E_norm_L] at h_norm0
    exact (pow_ne_zero m ϖ.ne_zero) h_norm0
  let z_unit : Eˣ := Units.mk0 z_E hz_E_ne
  have hz_unit_map : Units.map (normLM F hLn) z_unit = ϖ ^ m := by
    apply Units.ext
    exact hz_E_norm_L
  have hz_zpow : Units.map (normLM F hLn) (z_unit ^ k) = ϖ ^ ((m : ℤ) * k) := by
    rw [map_zpow, hz_unit_map, ← zpow_natCast, ← zpow_mul]
  refine ⟨normLM F hM ((z_unit ^ k : Eˣ) : E), ?_⟩
  rw [← normLM_comp F L M E h hM ((z_unit ^ k : Eˣ) : E)]
  exact congr_arg Units.val hz_zpow

theorem canonicalRecMap_ker (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L M : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M] (h : L ≤ M) :
    IsAbelianExt F h → ∀ x : Lˣ,
      (canonicalRecMap F L x : AbsGal F) ∈ M.fixingSubgroup ↔ (x : L) ∈ Set.range (normLM F h) :=
by
  intro hab x
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion h).injective
  have hmem : rawRecMap F L x ∈ relWeil F L :=
    (rawRecMap_actsAsFrobPow_and_mem_relWeil F L x).1
  have hcoe : (canonicalRecMap F L x : AbsGal F) = rawRecMap F L x := by
    rw [canonicalRecMap, dif_pos hmem]
  rw [hcoe]
  constructor
  · intro hx
    obtain ⟨n, m, hn, hm, hM⟩ := exists_le_lubinTateUnramField F L M h hab
    obtain ⟨y, u, k, hu, hx_eq⟩ :=
      exists_normLM_mul_of_rawRecMap_mem_fixingSubgroup F L M h hab n m hn hm hM x hx
    obtain ⟨yu, hyu⟩ :=
      unitGroup_mem_range_normLM_of_le_lubinTateUnramField F L M h hab n m hn hm hM u hu
    obtain ⟨ypi, hypi⟩ :=
      uniformizer_zpow_mem_range_normLM_of_le_lubinTateUnramField F L M h hab n m hn hm hM k
    refine ⟨y * yu * ypi, ?_⟩
    rw [map_mul, map_mul, hyu, hypi, hx_eq]
  · rintro ⟨y, hy⟩
    exact rawRecMap_mem_fixingSubgroup_of_normLM_eq F L M h hab x y hy

theorem canonicalRecMap_surj (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L M : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M] (h : L ≤ M) :
    IsAbelianExt F h → ∀ w : relWeil F L, ∃ x : Lˣ,
      (((canonicalRecMap F L x)⁻¹ * w : relWeil F L) : AbsGal F) ∈ M.fixingSubgroup :=
by
  intro hab w
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion h).injective
  obtain ⟨k, hk⟩ := relWeil_exists_actsAsFrobPow_mul_resDeg F L w
  obtain ⟨u, hu, hu_LT⟩ :=
    exists_unit_rawRecMap_inv_mul_mem_lubinTateExtension_fixingSubgroup F L (w : AbsGal F) w.2.2
  let π := chosenUniformizer F L
  let x : Lˣ := u * π ^ k
  refine ⟨x, ?_⟩
  obtain ⟨hx_val, hx_rel⟩ := valL_and_relVal_unit_mul_chosenUniformizer_zpow F L u k hu
  obtain ⟨hx_mem, hx_frob⟩ := rawRecMap_actsAsFrobPow_and_mem_relWeil F L x
  rw [hx_rel] at hx_frob
  have hx_unram : (rawRecMap F L x)⁻¹ * (w : AbsGal F) ∈ (unramifiedClosure F).fixingSubgroup := by
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    unfold unramifiedClosure at hz
    induction hz using IntermediateField.adjoin_induction with
    | mem ζ hζ =>
      rcases le_total 0 (-((resDeg F L : ℤ) * k)) with hn | hn
      · have hn0 : (- -((resDeg F L : ℤ) * k)).toNat = 0 := Int.toNat_of_nonpos (by omega)
        have h1 := hx_frob ζ hζ
        have h2 := hk ζ hζ
        rw [hn0, pow_zero, pow_one] at h1 h2
        change (rawRecMap F L x)⁻¹ ((w : AbsGal F) ζ) = ζ
        rw [h2, ← h1]
        exact (rawRecMap F L x).symm_apply_apply ζ
      · have hn0 : (-((resDeg F L : ℤ) * k)).toNat = 0 := Int.toNat_of_nonpos hn
        have hζ' : IsPrimeToPRootOfUnity F (((rawRecMap F L x)⁻¹ * (w : AbsGal F)) ζ) := by
          rcases hζ with ⟨m, hm1, hm2, hm3⟩
          refine ⟨m, hm1, hm2, ?_⟩
          rw [← map_pow, hm3, map_one]
        have h1 := hx_frob (((rawRecMap F L x)⁻¹ * (w : AbsGal F)) ζ) hζ'
        have h2 := hk ζ hζ
        rw [hn0, pow_zero, pow_one] at h1 h2
        have h3 : (rawRecMap F L x) (((rawRecMap F L x)⁻¹ * (w : AbsGal F)) ζ) =
            (w : AbsGal F) ζ := by
          change (rawRecMap F L x) ((rawRecMap F L x).symm ((w : AbsGal F) ζ)) = (w : AbsGal F) ζ
          exact (rawRecMap F L x).apply_symm_apply _
        rw [h3, h2] at h1
        exact h1.symm
    | algebraMap a => exact AlgEquiv.commutes _ a
    | add a b _ _ ha hb => rw [map_add, ha, hb]
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
    | inv a _ ha => rw [map_inv₀, ha]
  have hraw_eq : rawRecMap F L x = rawRecMap F L u * (lubinTateFrob F L π) ^ k := by
    unfold rawRecMap
    have h_unif : x * π ^ (1 - valL F L x) = u * π ^ (1 - valL F L u) := by
      change (u * π ^ k) * π ^ (1 - valL F L x) = u * π ^ (1 - valL F L u)
      rw [hx_val, hu, mul_assoc, ← zpow_add]
      congr 2
      ring
    have h_exp : valL F L x - 1 = (valL F L u - 1) + k := by
      rw [hx_val, hu]
      ring
    rw [h_unif, h_exp, zpow_add, mul_assoc]
  have hx_LT : (rawRecMap F L x)⁻¹ * (w : AbsGal F) ∈
      (lubinTateExtension F L π).fixingSubgroup := by
    rw [hraw_eq, mul_inv_rev, mul_assoc]
    exact Subgroup.mul_mem _
      (Subgroup.inv_mem _ (Subgroup.zpow_mem _
        (lubinTateFrob_chosenUniformizer_mem_fixingSubgroup F L) k))
      hu_LT
  have hx_sup : (rawRecMap F L x)⁻¹ * (w : AbsGal F) ∈
      (lubinTateExtension F L π ⊔ unramifiedClosure F).fixingSubgroup := by
    rw [IntermediateField.fixingSubgroup_sup]
    exact ⟨hx_LT, hx_unram⟩
  have hx_M : (rawRecMap F L x)⁻¹ * (w : AbsGal F) ∈ M.fixingSubgroup :=
    IntermediateField.fixingSubgroup_le
      (abelianExt_le_lubinTateExtension_sup_unramifiedClosure F L M h hab) hx_sup
  have h_coe : (((canonicalRecMap F L x)⁻¹ * w : relWeil F L) : AbsGal F) =
      (rawRecMap F L x)⁻¹ * (w : AbsGal F) := by
    rw [Subgroup.coe_mul, Subgroup.coe_inv, canonicalRecMap, dif_pos hx_mem]
  rw [h_coe]
  exact hx_M

theorem local_reciprocity (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] :
    Nonempty (LocalReciprocity F) :=
by
  refine ⟨{
    recMap := canonicalRecMap F
