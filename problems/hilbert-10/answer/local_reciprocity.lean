    have hfinM_pos : 1 ≤ Module.finrank F M := Module.finrank_pos
    have hk : 1 ≤ k := Nat.mul_le_mul hm hfinM_pos
    obtain ⟨K_L, hLK_L, hFin_KL, hσ_KL, hres_KL, hnorm_KL⟩ :=
      exists_intermediateField_fixingSubgroup_and_valL_normLM_mul_inv_sub_one_ge
        F L u_σ hu_σ_val f₀ m hf₀_pos hm σ hσL hσFrobL (h_σ_apply m)
    have hσFrobM_one : ActsAsFrobPow F σ (-((resDeg F M : ℤ) * ((1 : ℕ) : ℤ))) := by
      simpa using hσFrobM
    obtain ⟨K_M, hMK_M, hFin_KM, hσ_KM, hres_KM, hnorm_KM⟩ :=
      exists_intermediateField_fixingSubgroup_and_valL_normLM_mul_inv_sub_one_ge
        F M u_M hu_M_val 1 k le_rfl hk σ hσM hσFrobM_one (h_σ_apply_M k)
    haveI : FiniteDimensional F K_L := hFin_KL
    haveI : FiniteDimensional F K_M := hFin_KM
    let E : IntermediateField F (AlgebraicClosure F) := K_M ⊔ K_L
    haveI : FiniteDimensional F E := IntermediateField.finiteDimensional_sup K_M K_L
    have hKME : K_M ≤ E := le_sup_left
    have hKLE : K_L ≤ E := le_sup_right
    have hME : M ≤ E := hMK_M.trans hKME
    have hσ_E : σ ∈ E.fixingSubgroup := by
      change σ ∈ (K_M ⊔ K_L).fixingSubgroup
      rw [IntermediateField.fixingSubgroup_sup, Subgroup.mem_inf]
      exact ⟨hσ_KM, hσ_KL⟩
    have hres_E : resDeg F E = resDeg F M :=
      resDeg_eq_of_actsAsFrobPow_neg_resDeg_and_mem_fixingSubgroup F M E hME σ hσFrobM hσ_E
    have hres_KM' : resDeg F K_M = resDeg F M := by omega
    have hres_KL' : resDeg F K_L = resDeg F M := by omega
    let π_E : Eˣ := chosenUniformizer F E
    have hπ_E : valL F E π_E = 1 := (valL_chosenUniformizer_and_mul_zpow F E 1).1
    let z_M : K_Mˣ := Units.map (normLM F hKME) π_E
    let z_L : K_Lˣ := Units.map (normLM F hKLE) π_E
    have hz_M : valL F K_M z_M = 1 := by
      have hrel := relVal_normLM hKME (π_E : E)
      change relVal F K_M (z_M : K_M) = relVal F E (π_E : E) at hrel
      rw [relVal_eq_resDeg_mul_valL F K_M z_M, relVal_eq_resDeg_mul_valL F E π_E,
        hπ_E, mul_one, hres_KM', hres_E] at hrel
      apply mul_left_cancel₀ hfM_ne
      linarith
    have hz_L : valL F K_L z_L = 1 := by
      have hrel := relVal_normLM hKLE (π_E : E)
      change relVal F K_L (z_L : K_L) = relVal F E (π_E : E) at hrel
      rw [relVal_eq_resDeg_mul_valL F K_L z_L, relVal_eq_resDeg_mul_valL F E π_E,
        hπ_E, mul_one, hres_KL', hres_E] at hrel
      apply mul_left_cancel₀ hfM_ne
      linarith
    let y_M : Mˣ := Units.map (normLM F hMK_M) z_M
    let y_L : Lˣ := Units.map (normLM F hLK_L) z_L
    have hy_norm : Units.map (normLM F h) y_M = y_L := by
      apply Units.ext
      change normLM F h (normLM F hMK_M (normLM F hKME (π_E : E))) =
        normLM F hLK_L (normLM F hKLE (π_E : E))
      rw [← normLM_comp F M K_M E hMK_M hKME (π_E : E),
        ← normLM_comp F L M E h hME (π_E : E),
        ← normLM_comp F L K_L E hLK_L hKLE (π_E : E)]
    have hy_L_val : valL F L y_L = (f₀ : ℤ) := by
      have hrel := relVal_normLM hLK_L (z_L : K_L)
      change relVal F L (y_L : L) = relVal F K_L (z_L : K_L) at hrel
      rw [relVal_eq_resDeg_mul_valL F L y_L, relVal_eq_resDeg_mul_valL F K_L z_L,
        hz_L, mul_one, hres_KL', hres_M_int] at hrel
      exact mul_left_cancel₀ hfL_ne hrel
    have h_KM_congr := hnorm_KM z_M hz_M
    rw [hu_M_zpow] at h_KM_congr
    have h1_raw := valL_normLM_sub_one_ge_of_valL_sub_one_ge F L M h m hm
      (y_M * ϖ⁻¹) h_KM_congr
    have h_map_yM : Units.map (normLM F h) (y_M * ϖ⁻¹) = y_L * w⁻¹ := by
      rw [map_mul, map_inv, hy_norm]
    rw [h_map_yM] at h1_raw
    let x_σ : Lˣ := u_σ * π_L ^ (f₀ : ℤ)
    have h2_raw : ((y_L * x_σ⁻¹ : Lˣ) : L) = 1 ∨
        (m : ℤ) ≤ valL F L (((y_L * x_σ⁻¹ : Lˣ) : L) - 1) :=
      hnorm_KL z_L hz_L
    have h1_sub : (((y_L * w⁻¹ : Lˣ) : L) - 1) = 0 ∨
        (m : ℤ) ≤ valL F L (((y_L * w⁻¹ : Lˣ) : L) - 1) :=
      h1_raw.imp sub_eq_zero.mpr id
    have h2_sub : (((y_L * x_σ⁻¹ : Lˣ) : L) - 1) = 0 ∨
        (m : ℤ) ≤ valL F L (((y_L * x_σ⁻¹ : Lˣ) : L) - 1) :=
      h2_raw.imp sub_eq_zero.mpr id
    have h1_int : IsIntegral 𝒪[F] ((((y_L * w⁻¹ : Lˣ) : L) - 1) / (π_L : L) ^ m) :=
      (h_div_iff m _).mp h1_sub
    have h2_int : IsIntegral 𝒪[F] ((((y_L * x_σ⁻¹ : Lˣ) : L) - 1) / (π_L : L) ^ m) :=
      (h_div_iff m _).mp h2_sub
    let v₀ : Lˣ := y_L⁻¹ * x_σ * u_w
    have hx_σ_val : valL F L x_σ = (f₀ : ℤ) := by
      change valL F L ((u_σ * π_L ^ (f₀ : ℤ) : Lˣ) : L) = (f₀ : ℤ)
      rw [valL_L_mul, valL_L_zpow, hu_σ_val, hπ_L]
      ring
    have hv₀_val : valL F L v₀ = 0 := by
      change valL F L ((y_L⁻¹ * x_σ * u_w : Lˣ) : L) = 0
      rw [valL_L_mul, valL_L_mul, valL_L_inv, hy_L_val, hx_σ_val, hu_w_val]
      ring
    have hv₀_int : IsIntegral 𝒪[F] (v₀ : L) := by
      have h := (h_div_iff 0 (v₀ : L)).mp (Or.inr (by omega))
      simpa using h
    have hxσ_uw : x_σ * u_w = w * u_σ := by
      calc (u_σ * π_L ^ (f₀ : ℤ)) * u_w
        _ = u_w * (u_σ * π_L ^ (f₀ : ℤ)) := mul_comm _ _
        _ = u_w * (π_L ^ (f₀ : ℤ) * u_σ) := by rw [mul_comm u_σ]
        _ = (u_w * π_L ^ (f₀ : ℤ)) * u_σ := (mul_assoc _ _ _).symm
        _ = w * u_σ := by rw [← hw_eq]
    have h_uσ_eq : (y_L * w⁻¹) * v₀ = u_σ := by
      change (y_L * w⁻¹) * (y_L⁻¹ * x_σ * u_w) = u_σ
      rw [mul_assoc y_L⁻¹ x_σ u_w, hxσ_uw, ← mul_assoc y_L⁻¹ w u_σ,
        mul_comm y_L⁻¹, ← mul_assoc, ← mul_assoc (y_L * w⁻¹) w y_L⁻¹,
        inv_mul_cancel_right, mul_inv_cancel, one_mul]
    have h_uw_eq : (y_L * x_σ⁻¹) * v₀ = u_w := by
      change (y_L * x_σ⁻¹) * (y_L⁻¹ * x_σ * u_w) = u_w
      rw [mul_comm y_L⁻¹, ← mul_assoc, ← mul_assoc (y_L * x_σ⁻¹) x_σ y_L⁻¹,
        inv_mul_cancel_right, mul_inv_cancel, one_mul]
    have h_uσ_val : ((y_L * w⁻¹ : Lˣ) : L) * (v₀ : L) = (u_σ : L) := by
      exact_mod_cast congr_arg Units.val h_uσ_eq
    have h_uw_val : ((y_L * x_σ⁻¹ : Lˣ) : L) * (v₀ : L) = (u_w : L) := by
      exact_mod_cast congr_arg Units.val h_uw_eq
    have h_diff_eq : ((u_σ : L) - (u_w : L)) / (π_L : L) ^ m =
        ((((y_L * w⁻¹ : Lˣ) : L) - 1) / (π_L : L) ^ m -
          (((y_L * x_σ⁻¹ : Lˣ) : L) - 1) / (π_L : L) ^ m) * (v₀ : L) := by
      rw [← h_uσ_val, ← h_uw_val]
      ring
    rw [h_div_iff m ((u_σ : L) - (u_w : L)), h_diff_eq]
    exact IsIntegral.mul (IsIntegral.sub h1_int h2_int) hv₀_int
  have hu_eq : u_w = u_σ := by
    apply Units.ext
    by_contra hne
    have hsub_ne : (u_σ : L) - (u_w : L) ≠ 0 := sub_ne_zero.mpr (Ne.symm hne)
    let m₀ : ℕ := (valL F L ((u_σ : L) - (u_w : L))).toNat + 1
    have hm₀ : 1 ≤ m₀ := by omega
    rcases h_congr_all m₀ hm₀ with h0 | hle
    · exact hsub_ne h0
    · omega
  rw [hw_shift_eq, hu_eq, ← h_σ_apply n α hα]

theorem rawRecMap_normLM_apply_isLubinTateRoot (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (h : L ≤ M) :
    IsAbelianExt F h → ∀ (x : Lˣ) (yu : Mˣ),
      normLM F h (yu : M) = (x : L) → ∀ (n : ℕ) (α : AlgebraicClosure F),
        isLubinTateRoot F L (chosenUniformizer F L) n α →
          rawRecMap F L x α = rawRecMap F M yu α :=
by
  intro hab x yu hyu n α hα
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion h).injective
  let π_L := chosenUniformizer F L
  let π_M := chosenUniformizer F M
  let r := valL F M yu
  let ϖ_M : Mˣ := yu * π_M ^ (1 - r)
  obtain ⟨hπ_L, -⟩ := valL_chosenUniformizer_and_mul_zpow F L x
  obtain ⟨hπ_M, hϖ_M⟩ := valL_chosenUniformizer_and_mul_zpow F M yu
  have hisRoot_apply : ∀ {γ : AbsGal F}, γ ∈ L.fixingSubgroup →
      ∀ {β : AlgebraicClosure F}, isLubinTateRoot F L π_L n β → isLubinTateRoot F L π_L n (γ β) := by
    intro γ hγ β hβ
    have hγπ : γ ((π_L : L) : AlgebraicClosure F) = ((π_L : L) : AlgebraicClosure F) :=
      (IntermediateField.mem_fixingSubgroup_iff L γ).mp hγ (π_L : L) (π_L : L).2
    let g : AlgebraicClosure F → AlgebraicClosure F :=
      fun w => ((π_L : L) : AlgebraicClosure F) * w + w ^ qL F L
    have hsc : Function.Semiconj γ g g := by
      intro w
      dsimp [g]
      rw [map_add, map_mul, map_pow, hγπ]
    have hiter : γ (g^[n] β) = g^[n] (γ β) := (hsc.iterate_right n) β
    change g^[n] (γ β) = 0
    have hβ' : g^[n] β = 0 := hβ
    rw [← hiter, hβ', map_zero]
  obtain ⟨τ, hτL, hτFrob⟩ := exists_actsAsFrobPow_neg_resDeg F L
  have hspec_πL : IsLubinTateFrob F L π_L (lubinTateFrob F L π_L) :=
    Classical.epsilon_spec (exists_isLubinTateFrob_of_frobLift F L π_L hπ_L τ hτL hτFrob)
  have hfix_πL : ∀ {β : AlgebraicClosure F}, isLubinTateRoot F L π_L n β →
      lubinTateFrob F L π_L β = β :=
    fun hβ => hspec_πL.2.2 n _ hβ
  have hfix_πL_nat : ∀ (m : ℕ) {β : AlgebraicClosure F}, isLubinTateRoot F L π_L n β →
      ((lubinTateFrob F L π_L) ^ m) β = β := by
    intro m
    induction m with
    | zero =>
      intro β _
      rfl
    | succ m ih =>
      intro β hβ
      rw [pow_succ', AlgEquiv.mul_apply, ih hβ, hfix_πL hβ]
  have hfix_πL_zpow : ∀ (k : ℤ) {β : AlgebraicClosure F}, isLubinTateRoot F L π_L n β →
      ((lubinTateFrob F L π_L) ^ k) β = β := by
    intro k β hβ
    cases k with
    | ofNat m =>
      change ((lubinTateFrob F L π_L) ^ (m : ℤ)) β = β
      rw [zpow_natCast]
      exact hfix_πL_nat m hβ
    | negSucc m =>
      change (((lubinTateFrob F L π_L) ^ (m + 1))⁻¹) β = β
      have hm := hfix_πL_nat (m + 1) hβ
      have hinv : (((lubinTateFrob F L π_L) ^ (m + 1))⁻¹)
          (((lubinTateFrob F L π_L) ^ (m + 1)) β) = β :=
        AlgEquiv.symm_apply_apply ((lubinTateFrob F L π_L) ^ (m + 1)) β
      rw [hm] at hinv
      exact hinv
  have hraw_eq : ∀ (z : Lˣ) {β : AlgebraicClosure F}, isLubinTateRoot F L π_L n β →
      rawRecMap F L z β = lubinTateFrob F L (z * π_L ^ (1 - valL F L z)) β := by
    intro z β hβ
    change (lubinTateFrob F L (z * π_L ^ (1 - valL F L z)) *
      (lubinTateFrob F L π_L) ^ (valL F L z - 1)) β = _
    rw [AlgEquiv.mul_apply, hfix_πL_zpow (valL F L z - 1) hβ]
  have h_unif : ∀ (ϖ : Mˣ), valL F M ϖ = 1 →
      ∀ {β : AlgebraicClosure F}, isLubinTateRoot F L π_L n β →
        rawRecMap F L (Units.map (normLM F h) ϖ) β = lubinTateFrob F M ϖ β := by
    intro ϖ hϖ β hβ
    rw [hraw_eq (Units.map (normLM F h) ϖ) hβ]
    exact lubinTateFrob_normLM_mul_zpow_apply_isLubinTateRoot F L M h hab ϖ hϖ n β hβ
  have h_raw_one : ∀ {β : AlgebraicClosure F}, isLubinTateRoot F L π_L n β →
      rawRecMap F L 1 β = β := by
    intro β hβ
    have hmul := rawRecMap_mul_apply_isLubinTateRoot F L 1 1 n β hβ
    rw [mul_one] at hmul
    exact (rawRecMap F L 1).injective hmul.symm
  have h_raw_fix : ∀ (z : Lˣ), rawRecMap F L z ∈ L.fixingSubgroup :=
    fun z => (rawRecMap_actsAsFrobPow_and_mem_relWeil F L z).1.2
  have h_raw_pow_root : ∀ (z : Lˣ) (m : ℕ) {β : AlgebraicClosure F},
      isLubinTateRoot F L π_L n β → isLubinTateRoot F L π_L n (((rawRecMap F L z) ^ m) β) := by
    intro z m β hβ
    exact hisRoot_apply (Subgroup.pow_mem _ (h_raw_fix z) m) hβ
  have h_raw_zpow_root : ∀ (z : Lˣ) (k : ℤ) {β : AlgebraicClosure F},
      isLubinTateRoot F L π_L n β → isLubinTateRoot F L π_L n (((rawRecMap F L z) ^ k) β) := by
    intro z k β hβ
    exact hisRoot_apply (Subgroup.zpow_mem _ (h_raw_fix z) k) hβ
  have h_raw_pow : ∀ (z : Lˣ) (m : ℕ) {β : AlgebraicClosure F},
      isLubinTateRoot F L π_L n β →
        rawRecMap F L (z ^ m) β = ((rawRecMap F L z) ^ m) β := by
    intro z m
    induction m with
    | zero =>
      intro β hβ
      rw [pow_zero, pow_zero]
      exact h_raw_one hβ
    | succ m ih =>
      intro β hβ
      rw [pow_succ', pow_succ', AlgEquiv.mul_apply,
        rawRecMap_mul_apply_isLubinTateRoot F L z (z ^ m) n β hβ, ih hβ]
  have h_raw_zpow : ∀ (z : Lˣ) (k : ℤ) {β : AlgebraicClosure F},
      isLubinTateRoot F L π_L n β →
        rawRecMap F L (z ^ k) β = ((rawRecMap F L z) ^ k) β := by
    intro z k β hβ
    cases k with
    | ofNat m =>
      change rawRecMap F L (z ^ (m : ℤ)) β = ((rawRecMap F L z) ^ (m : ℤ)) β
      rw [zpow_natCast, zpow_natCast]
      exact h_raw_pow z m hβ
    | negSucc m =>
      change rawRecMap F L ((z ^ (m + 1))⁻¹) β = (((rawRecMap F L z) ^ (m + 1))⁻¹) β
      let z' : Lˣ := (z ^ (m + 1))⁻¹
      have hβ' : isLubinTateRoot F L π_L n (rawRecMap F L z' β) :=
        hisRoot_apply (h_raw_fix z') hβ
      have hmul := rawRecMap_mul_apply_isLubinTateRoot F L (z ^ (m + 1)) z' n β hβ
      have hinv : z ^ (m + 1) * z' = 1 := mul_inv_cancel (z ^ (m + 1))
      rw [hinv, h_raw_one hβ, h_raw_pow z (m + 1) hβ'] at hmul
      have hcancel : (((rawRecMap F L z) ^ (m + 1))⁻¹)
          (((rawRecMap F L z) ^ (m + 1)) (rawRecMap F L z' β)) = rawRecMap F L z' β :=
        AlgEquiv.symm_apply_apply ((rawRecMap F L z) ^ (m + 1)) (rawRecMap F L z' β)
      rw [← hmul] at hcancel
      exact hcancel.symm
  let w₀ : Lˣ := Units.map (normLM F h) π_M
  let w₁ : Lˣ := Units.map (normLM F h) ϖ_M
  have h_πM_pow : ∀ (m : ℕ) {β : AlgebraicClosure F},
      isLubinTateRoot F L π_L n β →
        ((rawRecMap F L w₀) ^ m) β = ((lubinTateFrob F M π_M) ^ m) β := by
    intro m
    induction m with
    | zero =>
      intro β _
      rfl
    | succ m ih =>
      intro β hβ
      rw [pow_succ', pow_succ', AlgEquiv.mul_apply, AlgEquiv.mul_apply,
        h_unif π_M hπ_M (h_raw_pow_root w₀ m hβ), ih hβ]
  have h_πM_zpow : ∀ (k : ℤ) {β : AlgebraicClosure F},
      isLubinTateRoot F L π_L n β →
        ((rawRecMap F L w₀) ^ k) β = ((lubinTateFrob F M π_M) ^ k) β := by
    intro k β hβ
    cases k with
    | ofNat m =>
      change ((rawRecMap F L w₀) ^ (m : ℤ)) β = ((lubinTateFrob F M π_M) ^ (m : ℤ)) β
      rw [zpow_natCast, zpow_natCast]
      exact h_πM_pow m hβ
    | negSucc m =>
      change (((rawRecMap F L w₀) ^ (m + 1))⁻¹) β = (((lubinTateFrob F M π_M) ^ (m + 1))⁻¹) β
      let β' := (((rawRecMap F L w₀) ^ (m + 1))⁻¹) β
      have hβ' : isLubinTateRoot F L π_L n β' := h_raw_zpow_root w₀ (Int.negSucc m) hβ
      have hm := h_πM_pow (m + 1) hβ'
      have happly : ((rawRecMap F L w₀) ^ (m + 1)) β' = β :=
        AlgEquiv.apply_symm_apply ((rawRecMap F L w₀) ^ (m + 1)) β
      rw [happly] at hm
      have hcancel : (((lubinTateFrob F M π_M) ^ (m + 1))⁻¹)
          (((lubinTateFrob F M π_M) ^ (m + 1)) β') = β' :=
        AlgEquiv.symm_apply_apply ((lubinTateFrob F M π_M) ^ (m + 1)) β'
      rw [← hm] at hcancel
      exact hcancel.symm
  have hyu_eq : ϖ_M * π_M ^ (r - 1) = yu := by
    change (yu * π_M ^ (1 - r)) * π_M ^ (r - 1) = yu
    have hexp : (1 - r : ℤ) + (r - 1) = 0 := by ring
    rw [mul_assoc, ← zpow_add, hexp, zpow_zero, mul_one]
  have hx_eq : x = w₁ * w₀ ^ (r - 1) := by
    have hx_yu : x = Units.map (normLM F h) yu := Units.ext hyu.symm
    rw [hx_yu, ← hyu_eq, map_mul, map_zpow]
  rw [hx_eq, rawRecMap_mul_apply_isLubinTateRoot F L w₁ (w₀ ^ (r - 1)) n α hα,
    h_raw_zpow w₀ (r - 1) hα, h_unif ϖ_M hϖ_M (h_raw_zpow_root w₀ (r - 1) hα),
    h_πM_zpow (r - 1) hα]
  rfl

theorem rawRecMap_mem_fixingSubgroup_of_normLM_eq (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (h : L ≤ M) :
    IsAbelianExt F h → ∀ (x : Lˣ) (y : M),
      normLM F h y = (x : L) → rawRecMap F L x ∈ M.fixingSubgroup :=
by
  intro hab x y hy
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion h).injective
  let e : M ≃ₐ[F] IntermediateField.extendScalars h := {
    toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mpr z.2⟩
    invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl
    map_mul' := fun _ _ => rfl
    map_add' := fun _ _ => rfl
    commutes' := fun _ => rfl
  }
  haveI : FiniteDimensional F (IntermediateField.extendScalars h) :=
    Module.Finite.equiv e.toLinearEquiv
  haveI : FiniteDimensional L (IntermediateField.extendScalars h) :=
    FiniteDimensional.right F L (IntermediateField.extendScalars h)
  have hy_ne : y ≠ 0 := by
    intro hy0
    have h0 : normLM F h y = 0 := by
      change Algebra.norm L (e y) = 0
      rw [hy0, map_zero, Algebra.norm_zero]
    exact x.ne_zero (hy.symm.trans h0)
  let yu : Mˣ := Units.mk0 y hy_ne
  have hyu : normLM F h (yu : M) = (x : L) := hy
  have h_relVal : relVal F L (x : L) = relVal F M (yu : M) := by
    change addVal F (Algebra.norm F (x : L)) = addVal F (Algebra.norm F y)
    congr 1
    calc Algebra.norm F (x : L)
      _ = Algebra.norm F (Algebra.norm L (e y)) := by rw [← hy]; rfl
      _ = Algebra.norm F (e y) := Algebra.norm_norm
      _ = Algebra.norm F y := Algebra.norm_eq_of_algEquiv e y
  obtain ⟨hmem_x, hfrob_x⟩ := rawRecMap_actsAsFrobPow_and_mem_relWeil F L x
  obtain ⟨hmem_yu, hfrob_yu⟩ := rawRecMap_actsAsFrobPow_and_mem_relWeil F M yu
  set σ := rawRecMap F L x
  set τ := rawRecMap F M yu
  rw [← mul_inv_cancel_left τ σ]
  refine Subgroup.mul_mem _ hmem_yu.2 ?_
  apply IntermediateField.fixingSubgroup_le
    (le_lubinTate_sup_unramifiedClosure_of_isAbelianExt F L M h hab)
  rw [IntermediateField.fixingSubgroup_sup, IntermediateField.fixingSubgroup_sup,
    Subgroup.mem_inf, Subgroup.mem_inf]
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · exact Subgroup.mul_mem _
      (Subgroup.inv_mem _ (IntermediateField.fixingSubgroup_le h hmem_yu.2)) hmem_x.2
  · set k := -relVal F L (x : L)
    have hτ_k : ActsAsFrobPow F τ k := by
      change ActsAsFrobPow F τ (-relVal F L (x : L))
      rw [h_relVal]
      exact hfrob_yu
    have h_apply : ∀ (γ : AbsGal F) {ζ : AlgebraicClosure F},
        IsPrimeToPRootOfUnity F ζ → IsPrimeToPRootOfUnity F (γ ζ) := by
      intro γ ζ ⟨r, hr, hpr, hζr⟩
      exact ⟨r, hr, hpr, by rw [← map_pow, hζr, map_one]⟩
    rw [unramifiedClosure, IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    induction hz using IntermediateField.adjoin_induction with
    | mem ζ hζ =>
      change (τ⁻¹ * σ) ζ = ζ
      rw [AlgEquiv.mul_apply]
      rcases le_total 0 k with hk | hk
      · have hk' : (-k).toNat = 0 := by omega
        have h1 := hfrob_x ζ hζ
        have h2 := hτ_k ζ hζ
        rw [hk', pow_zero, pow_one] at h1 h2
        rw [h1, ← h2]
        exact AlgEquiv.symm_apply_apply τ ζ
      · have hk' : k.toNat = 0 := by omega
        have h1 := hfrob_x ζ hζ
        have h2 := hτ_k (τ⁻¹ (σ ζ)) (h_apply τ⁻¹ (h_apply σ hζ))
        have happly : τ (τ⁻¹ (σ ζ)) = σ ζ := AlgEquiv.apply_symm_apply τ (σ ζ)
        rw [hk', pow_zero, pow_one] at h1
        rw [happly, hk', pow_zero, pow_one] at h2
        rw [← h2, h1]
    | algebraMap r => exact AlgEquiv.commutes _ r
    | add a b _ _ ha hb => rw [map_add, ha, hb]
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
    | inv a _ ha => rw [map_inv₀, ha]
  · rw [IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    induction hz using IntermediateField.adjoin_induction with
    | mem α hα =>
      rcases hα with ⟨n, hα⟩
      change (τ⁻¹ * σ) α = α
      rw [AlgEquiv.mul_apply, rawRecMap_normLM_apply_isLubinTateRoot F L M h hab x yu hyu n α hα]
      exact AlgEquiv.symm_apply_apply τ α
    | algebraMap r => exact AlgEquiv.commutes _ r
    | add a b _ _ ha hb => rw [map_add, ha, hb]
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
    | inv a _ ha => rw [map_inv₀, ha]

theorem lubinTateUnramField_mono (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) {n₁ n₂ m₁ m₂ : ℕ} :
    n₁ ≤ n₂ → m₁ ∣ m₂ →
      lubinTateUnramField F L n₁ m₁ ≤ lubinTateUnramField F L n₂ m₂ :=
by
  intro hn hm
  unfold lubinTateUnramField
  apply sup_le_sup_left
  rw [IntermediateField.adjoin_le_iff]
  intro x hx
  apply IntermediateField.subset_adjoin
  rcases hx with hx | hx
  · left
    change isLubinTateRoot F L (chosenUniformizer F L) n₂ x
    unfold isLubinTateRoot at hx ⊢
    set g : AlgebraicClosure F → AlgebraicClosure F :=
      fun y => (((chosenUniformizer F L : Lˣ) : L) : AlgebraicClosure F) * y + y ^ qL F L
    have hg0 : g 0 = 0 := by
      have hqL : qL F L ≠ 0 := ne_of_gt (pow_pos (q_pos F) (resDeg F L))
      simp [g, zero_pow hqL]
    have hadd : n₂ = (n₂ - n₁) + n₁ := (Nat.sub_add_cancel hn).symm
    rw [hadd, Function.iterate_add_apply, hx, Function.iterate_fixed hg0]
  · right
    change x ^ (qL F L ^ m₂ - 1) = 1
    change x ^ (qL F L ^ m₁ - 1) = 1 at hx
    have hdvd : qL F L ^ m₁ - 1 ∣ qL F L ^ m₂ - 1 := by
      simpa using Nat.pow_sub_pow_dvd_pow_sub_pow (qL F L) 1 hm
    rcases hdvd with ⟨c, hc⟩
    rw [hc, pow_mul, hx, one_pow]

theorem exists_pow_qL_pow_sub_one_eq_one_of_isPrimeToPRootOfUnity (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) (ζ : AlgebraicClosure F) :
    IsPrimeToPRootOfUnity F ζ → ∃ m : ℕ, 1 ≤ m ∧ ζ ^ (qL F L ^ m - 1) = 1 :=
by
  rintro ⟨r, hr, hp_ndvd, hζr⟩
  haveI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  obtain ⟨d, hp_prime, hcard⟩ := FiniteField.card 𝓀[F] (p F)
  have hq : q F = (p F) ^ (d : ℕ) := by
    unfold q
    rw [Nat.card_eq_fintype_card, hcard]
  have hcop_p : Nat.Coprime (p F) r := (hp_prime.coprime_iff_not_dvd).mpr hp_ndvd
  have hcop_qL : Nat.Coprime (qL F L) r := by
    unfold qL
    rw [hq]
    exact (hcop_p.pow_left (d : ℕ)).pow_left (resDeg F L)
  refine ⟨r.totient, Nat.totient_pos.mpr hr, ?_⟩
  have hmod : (qL F L) ^ r.totient ≡ 1 [MOD r] := Nat.ModEq.pow_totient hcop_qL
  have h1 : 1 ≤ (qL F L) ^ r.totient :=
    Nat.one_le_pow _ _ (pow_pos (q_pos F) (resDeg F L))
  have hdvd : r ∣ (qL F L) ^ r.totient - 1 := (Nat.modEq_iff_dvd' h1).mp hmod.symm
  rcases hdvd with ⟨k, hk⟩
  rw [hk, pow_mul, hζr, one_pow]

theorem exists_le_of_le_iSup_of_directed (F : Type u) [Field F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    {ι : Type} [Nonempty ι] (K : ι → IntermediateField F (AlgebraicClosure F)) :
    Directed (· ≤ ·) K → M ≤ (⨆ i, K i) → ∃ i : ι, M ≤ K i :=
by
  intro hdir hM
  haveI : FiniteDimensional F ↥M.toSubmodule := ‹FiniteDimensional F M›
  have hfg : M.toSubmodule.FG := Submodule.FG.of_finite
  rcases hfg with ⟨s, hs⟩
  have hmem : ∀ x : {x // x ∈ s}, ∃ i : ι, x.1 ∈ K i := by
    intro x
    have hxM : x.1 ∈ M := by
      change x.1 ∈ M.toSubmodule
      rw [← hs]
      exact Submodule.subset_span x.2
    have hxSup : x.1 ∈ ((⨆ i, K i : IntermediateField F (AlgebraicClosure F)) : Set (AlgebraicClosure F)) :=
      hM hxM
    rw [IntermediateField.coe_iSup_of_directed hdir, Set.mem_iUnion] at hxSup
    exact hxSup
  choose f hf using hmem
  obtain ⟨i₀, hi₀⟩ := hdir.finset_le (Finset.univ.image f)
  refine ⟨i₀, ?_⟩
  change M.toSubmodule ≤ (K i₀).toSubmodule
  rw [← hs, Submodule.span_le]
  intro x hx
  let xs : {y // y ∈ s} := ⟨x, hx⟩
  have hle : K (f xs) ≤ K i₀ :=
    hi₀ (f xs) (Finset.mem_image_of_mem f (Finset.mem_univ xs))
  exact hle (hf xs)

theorem exists_le_lubinTateUnramField (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (h : L ≤ M) :
    IsAbelianExt F h → ∃ n m : ℕ, 1 ≤ n ∧ 1 ≤ m ∧ M ≤ lubinTateUnramField F L n m :=
by
  intro hab
  let ι := {p : ℕ × ℕ // 1 ≤ p.1 ∧ 1 ≤ p.2}
  let p₀ : ι := ⟨(1, 1), ⟨le_rfl, le_rfl⟩⟩
  haveI : Nonempty ι := ⟨p₀⟩
  let K : ι → IntermediateField F (AlgebraicClosure F) :=
    fun p => lubinTateUnramField F L p.1.1 p.1.2
  have hdir : Directed (· ≤ ·) K := by
    intro p₁ p₂
    refine ⟨⟨(max p₁.1.1 p₂.1.1, p₁.1.2 * p₂.1.2),
      ⟨le_max_of_le_left p₁.2.1, Nat.mul_pos p₁.2.2 p₂.2.2⟩⟩,
      lubinTateUnramField_mono F L (le_max_left _ _) (dvd_mul_right _ _),
      lubinTateUnramField_mono F L (le_max_right _ _) (dvd_mul_left _ _)⟩
  have hM_sup : M ≤ ⨆ p : ι, K p := by
    refine le_trans (le_lubinTate_sup_unramifiedClosure_of_isAbelianExt F L M h hab) ?_
    apply sup_le
    · apply sup_le
      · exact le_trans (le_sup_left : L ≤ K p₀) (le_iSup K p₀)
      · unfold unramifiedClosure
        rw [IntermediateField.adjoin_le_iff]
        intro ζ hζ
        obtain ⟨m, hm, hζm⟩ :=
          exists_pow_qL_pow_sub_one_eq_one_of_isPrimeToPRootOfUnity F L ζ hζ
        let pm : ι := ⟨(1, m), ⟨le_rfl, hm⟩⟩
        have hmem_pm : ζ ∈ K pm :=
          (@le_sup_right (IntermediateField F (AlgebraicClosure F)) _ L _)
            (IntermediateField.subset_adjoin F _ (Or.inr hζm))
        exact le_iSup K pm hmem_pm
    · rw [IntermediateField.adjoin_le_iff]
      rintro α ⟨n₀, hα⟩
      let pn : ι := ⟨(max 1 n₀, 1), ⟨le_max_left 1 n₀, le_rfl⟩⟩
      have hmem_n0 : α ∈ lubinTateUnramField F L n₀ 1 :=
        (@le_sup_right (IntermediateField F (AlgebraicClosure F)) _ L _)
          (IntermediateField.subset_adjoin F _ (Or.inl hα))
      have hmem_pn : α ∈ K pn :=
        lubinTateUnramField_mono F L (le_max_right 1 n₀) (dvd_refl 1) hmem_n0
      exact le_iSup K pn hmem_pn
  obtain ⟨⟨⟨n, m⟩, hn, hm⟩, hMK⟩ := exists_le_of_le_iSup_of_directed F M K hdir hM_sup
  exact ⟨n, m, hn, hm, hMK⟩

theorem relWeil_exists_actsAsFrobPow_mul_resDeg (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (w : relWeil F L) :
    ∃ k : ℤ, ActsAsFrobPow F (w : AbsGal F) (-((resDeg F L : ℤ) * k)) :=
by
  have h_res_card : ∃ d : ℕ+, Nat.Prime (p F) ∧ q F = p F ^ (d : ℕ) := by
    haveI : Finite 𝓀[F] :=
      IsNonarchimedeanLocalField.instFiniteResidueFieldSubtypeMemSubringIntegerValueGroupWithZeroValuation F
    letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
    haveI : CharP 𝓀[F] (p F) := ringChar.charP 𝓀[F]
    obtain ⟨d, hp, hcard⟩ := FiniteField.card 𝓀[F] (p F)
    refine ⟨d, hp, ?_⟩
    unfold q
    rw [Nat.card_eq_fintype_card, hcard]
  obtain ⟨d_F, hp, hq_eq⟩ := h_res_card
  have hp_dvd_q : p F ∣ q F := by
    rw [hq_eq]
    exact dvd_pow_self (p F) d_F.ne_zero
  have hq_ge_two : 2 ≤ q F := by
    rw [hq_eq]
    calc 2 ≤ p F := hp.two_le
      _ = p F ^ 1 := (pow_one (p F)).symm
      _ ≤ p F ^ (d_F : ℕ) := Nat.pow_le_pow_right hp.pos d_F.pos
  have isPrimeToP_map : ∀ (τ : AbsGal F) (ζ : AlgebraicClosure F),
      IsPrimeToPRootOfUnity F ζ → IsPrimeToPRootOfUnity F (τ ζ) := by
    intro τ ζ ⟨m, hm_pos, hpm, hζm⟩
    refine ⟨m, hm_pos, hpm, ?_⟩
    rw [← map_pow, hζm, map_one]
  have actsAsFrobPow_mul : ∀ (τ₁ τ₂ : AbsGal F) (n₁ n₂ : ℤ),
      ActsAsFrobPow F τ₁ n₁ → ActsAsFrobPow F τ₂ n₂ → ActsAsFrobPow F (τ₁ * τ₂) (n₁ + n₂) := by
    intro τ₁ τ₂ n₁ n₂ h₁ h₂ ζ hζ
    set a₁ : ℕ := n₁.toNat
    set b₁ : ℕ := (-n₁).toNat
    set a₂ : ℕ := n₂.toNat
    set b₂ : ℕ := (-n₂).toNat
    set A : ℕ := (n₁ + n₂).toNat
    set B : ℕ := (-(n₁ + n₂)).toNat
    set c : ℕ := (b₁ + b₂) - B
    have h_a_eq : a₁ + a₂ = A + c := by omega
    have h_b_eq : b₁ + b₂ = B + c := by omega
    set z₁ : AlgebraicClosure F := ((τ₁ * τ₂) ζ) ^ (q F ^ B)
    set z₂ : AlgebraicClosure F := ζ ^ (q F ^ A)
    set k : ℕ := q F ^ c
    have hz_pow_k : z₁ ^ k = z₂ ^ k := by
      have hτ₂ζ : IsPrimeToPRootOfUnity F (τ₂ ζ) := isPrimeToP_map τ₂ ζ hζ
      calc z₁ ^ k
        _ = ((τ₁ * τ₂) ζ) ^ (q F ^ B * q F ^ c) := (pow_mul _ _ _).symm
        _ = ((τ₁ * τ₂) ζ) ^ (q F ^ (B + c)) := by rw [← pow_add]
        _ = (τ₁ (τ₂ ζ)) ^ (q F ^ (b₁ + b₂)) := by rw [AlgEquiv.mul_apply, h_b_eq]
        _ = (τ₁ (τ₂ ζ)) ^ (q F ^ b₁ * q F ^ b₂) := by rw [pow_add]
        _ = ((τ₁ (τ₂ ζ)) ^ (q F ^ b₁)) ^ (q F ^ b₂) := pow_mul _ _ _
        _ = ((τ₂ ζ) ^ (q F ^ a₁)) ^ (q F ^ b₂) := by rw [h₁ (τ₂ ζ) hτ₂ζ]
        _ = ((τ₂ ζ) ^ (q F ^ b₂)) ^ (q F ^ a₁) := pow_right_comm _ _ _
        _ = (ζ ^ (q F ^ a₂)) ^ (q F ^ a₁) := by rw [h₂ ζ hζ]
        _ = ζ ^ (q F ^ a₂ * q F ^ a₁) := (pow_mul _ _ _).symm
        _ = ζ ^ (q F ^ (a₁ + a₂)) := by rw [← pow_add, add_comm a₂ a₁]
        _ = ζ ^ (q F ^ (A + c)) := by rw [h_a_eq]
        _ = ζ ^ (q F ^ A * q F ^ c) := by rw [pow_add]
        _ = z₂ ^ k := pow_mul _ _ _
    obtain ⟨m, hm_pos, hpm, hζm⟩ := hζ
    have hz₁_m : z₁ ^ m = 1 := by
      calc z₁ ^ m
        _ = (((τ₁ * τ₂) ζ) ^ m) ^ (q F ^ B) := pow_right_comm _ _ _
        _ = ((τ₁ * τ₂) (ζ ^ m)) ^ (q F ^ B) := by rw [map_pow]
        _ = 1 := by rw [hζm, map_one, one_pow]
    have hz₂_m : z₂ ^ m = 1 := by
      calc z₂ ^ m
        _ = (ζ ^ m) ^ (q F ^ A) := pow_right_comm _ _ _
        _ = 1 := by rw [hζm, one_pow]
    have hk_coprime : Nat.Coprime k m := by
      have hp_cop : Nat.Coprime (p F) m := hp.coprime_iff_not_dvd.mpr hpm
      have hq_cop : Nat.Coprime (q F) m := by
        rw [hq_eq]
        exact hp_cop.pow_left (d_F : ℕ)
      exact hq_cop.pow_left c
    have h_bezout : (k : ℤ) * k.gcdA m + (m : ℤ) * k.gcdB m = 1 := by
      have h_gcd := Nat.gcd_eq_gcd_ab k m
      rw [hk_coprime.gcd_eq_one] at h_gcd
      push_cast at h_gcd
      exact h_gcd.symm
    have pow_cancel : ∀ z : AlgebraicClosure F, z ^ m = 1 → z = (z ^ k) ^ (k.gcdA m) := by
      intro z hzm
      have hz_ne : z ≠ 0 := by
        intro hz0
        rw [hz0, zero_pow hm_pos.ne'] at hzm
        exact zero_ne_one hzm
      calc z
        _ = z ^ (1 : ℤ) := (zpow_one z).symm
        _ = z ^ ((k : ℤ) * k.gcdA m + (m : ℤ) * k.gcdB m) := by rw [h_bezout]
        _ = z ^ ((k : ℤ) * k.gcdA m) * z ^ ((m : ℤ) * k.gcdB m) := zpow_add₀ hz_ne _ _
        _ = (z ^ (k : ℤ)) ^ (k.gcdA m) * (z ^ (m : ℤ)) ^ (k.gcdB m) := by rw [zpow_mul, zpow_mul]
        _ = (z ^ k) ^ (k.gcdA m) * (z ^ m) ^ (k.gcdB m) := by rw [zpow_natCast, zpow_natCast]
        _ = (z ^ k) ^ (k.gcdA m) * 1 ^ (k.gcdB m) := by rw [hzm]
        _ = (z ^ k) ^ (k.gcdA m) := by rw [one_zpow, mul_one]
    rw [pow_cancel z₁ hz₁_m, pow_cancel z₂ hz₂_m, hz_pow_k]
  have actsAsFrobPow_inv : ∀ (τ : AbsGal F) (m : ℤ),
      ActsAsFrobPow F τ m → ActsAsFrobPow F τ⁻¹ (-m) := by
    intro τ m hm ζ hζ
    have hinvζ : IsPrimeToPRootOfUnity F (τ⁻¹ ζ) := isPrimeToP_map τ⁻¹ ζ hζ
    have h_app := hm (τ⁻¹ ζ) hinvζ
    have h_cancel : τ (τ⁻¹ ζ) = ζ := by
      rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
    rw [h_cancel] at h_app
    rw [neg_neg]
    exact h_app.symm
  have actsAsFrobPow_one : ActsAsFrobPow F 1 0 := by
    intro ζ _
    simp
  have weilGroup_exists : ∀ τ : weilGroup F, ∃ m : ℤ, ActsAsFrobPow F (τ : AbsGal F) m := by
    intro ⟨τ, hτ⟩
    exact Subgroup.closure_induction
      (fun g hg => hg)
      ⟨0, actsAsFrobPow_one⟩
      (fun g₁ g₂ _ _ ⟨m₁, hm₁⟩ ⟨m₂, hm₂⟩ => ⟨m₁ + m₂, actsAsFrobPow_mul g₁ g₂ m₁ m₂ hm₁ hm₂⟩)
      (fun g _ ⟨m, hm⟩ => ⟨-m, actsAsFrobPow_inv g m hm⟩)
      hτ
  obtain ⟨n_w, hn_w⟩ := weilGroup_exists ⟨(w : AbsGal F), w.2.1⟩
  have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
      0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
    intro a ha
    unfold addVal
    rw [dif_neg ha]
    set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    set va := valuation F a
    have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
    constructor
    · intro h_nonneg
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
      have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
      have h_iso : iso va ≤ iso 1 := by
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
        exact WithZero.coe_le_coe.mpr h_unzero
      exact (map_le_map_iff iso).mp h_iso
    · intro h_le
      have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
      rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
        Multiplicative.toAdd_le.mpr h_iso
      omega
  have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  have addVal_div : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x / y) = addVal F x - addVal F y := by
    intro x y hx hy
    have hxy : x / y ≠ 0 := div_ne_zero hx hy
    have h := addVal_mul hxy hy
    rw [div_mul_cancel₀ _ hy] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Lˣ, Multiplicative.toAdd (relValHom u) = relVal F L u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : Lˣ,
      relVal F L ((u * v : Lˣ) : L) = relVal F L u + relVal F L v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : Lˣ) (k : ℤ),
      relVal F L ((u ^ k : Lˣ) : L) = k * relVal F L u := by
    intro u k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have relVal_mul : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      relVal F L (x * y) = relVal F L x + relVal F L y := by
    intro x y hx hy
    exact relVal_units_mul (Units.mk0 x hx) (Units.mk0 y hy)
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F L ∧ ∃ π : Lˣ, relVal F L π = resDeg F L := by
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L u,
        (map_ne_zero (algebraMap F L)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (u : F)) = (u : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (u : F)
      have hpow : addVal F ((u : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F u := by
        change Multiplicative.toAdd (addValHom (u ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hf_pos, π_ex, hπ_ex⟩ := resDeg_mem
  have relVal_eq_resDeg_mul_valL_aux :
      ∀ u : Lˣ, relVal F L u = (resDeg F L : ℤ) * valL F L u := by
    intro u
    let q₀ := relVal F L u / (resDeg F L : ℤ)
    let r₀ := relVal F L u % (resDeg F L : ℤ)
    have hdiv : r₀ + (resDeg F L : ℤ) * q₀ = relVal F L u := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r₀ := Int.emod_nonneg _ (by positivity)
    have hrlt : r₀ < (resDeg F L : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F L ((u * π_ex ^ (-q₀) : Lˣ) : L) = r₀ := by
      rw [relVal_units_mul, relVal_units_zpow, hπ_ex]
      linarith
    have hr_eq : r₀ = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r₀.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r₀.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k} := by
        refine ⟨hr_pos, ((u * π_ex ^ (-q₀) : Lˣ) : L), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F L ≤ r₀.toNat := Nat.sInf_le hmem
      omega
    change relVal F L u = (resDeg F L : ℤ) * q₀
    linarith
  have relVal_eq : ∀ {x : L} (hx : x ≠ 0), relVal F L x = (resDeg F L : ℤ) * valL F L x :=
    fun hx => relVal_eq_resDeg_mul_valL_aux (Units.mk0 _ hx)
  set πL : L := (chosenUniformizer F L : L)
  have hπL_ne : πL ≠ 0 := Units.ne_zero (chosenUniformizer F L)
  have hπ_val : valL F L πL = 1 := by
    have hf_ne : (resDeg F L : ℤ) ≠ 0 := by positivity
    have hπ_ex_val : valL F L π_ex = 1 := by
      rw [valL, hπ_ex, Int.ediv_self hf_ne]
    exact Classical.epsilon_spec (p := fun π : Lˣ => valL F L π = 1) ⟨π_ex, hπ_ex_val⟩
  have valL_mul : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      valL F L (x * y) = valL F L x + valL F L y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    have h := relVal_mul hx hy
    rw [relVal_eq hxy, relVal_eq hx, relVal_eq hy, ← mul_add] at h
    exact mul_left_cancel₀ (by positivity) h
  have valL_one : valL F L 1 = 0 := by
    have h1 : (1 : L) ≠ 0 := one_ne_zero
    have h := valL_mul h1 h1
    rw [mul_one] at h
    omega
  have valL_div : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      valL F L (x / y) = valL F L x - valL F L y := by
    intro x y hx hy
    have hxy : x / y ≠ 0 := div_ne_zero hx hy
    have h := valL_mul hxy hy
    rw [div_mul_cancel₀ _ hy] at h
    omega
  have valL_pow : ∀ {x : L} (hx : x ≠ 0) (n : ℕ), valL F L (x ^ n) = (n : ℤ) * valL F L x := by
    intro x hx n
    induction n with
    | zero => simp [valL_one]
    | succ n ih =>
      rw [pow_succ, valL_mul (pow_ne_zero n hx) hx, ih]
      push_cast
      ring
  have h_pow_val : ∀ m : ℕ, valL F L (πL ^ m) = (m : ℤ) := by
    intro m
    rw [valL_pow hπL_ne m, hπ_val, mul_one]
  have h_inv_val : valL F L (πL⁻¹) = -1 := by
    have h := valL_mul hπL_ne (inv_ne_zero hπL_ne)
    rw [mul_inv_cancel₀ hπL_ne, valL_one, hπ_val] at h
    omega
  have h_int_aux : ∀ (K : Type u) [Field K] [Algebra F K] [FiniteDimensional F K] (x : K),
      IsIntegral 𝒪[F] x ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x) := by
    intro K _ _ _ x
    constructor
    · intro hx
      by_cases hx0 : x = 0
      · exact Or.inl hx0
      · right
        have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
        have hnorm_int : IsIntegral 𝒪[F] (Algebra.norm F x) := Algebra.isIntegral_norm F hx
        have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
          (Valuation.Integers.isIntegral_iff_v_le_one
            (Valuation.integer.integers (valuation F))).mp hnorm_int
        exact (addVal_nonneg_iff_val_le_one hnorm0).mpr hval_le
    · rintro (rfl | h_rel)
      · exact isIntegral_zero
      · by_cases hx0 : x = 0
        · rw [hx0]
          exact isIntegral_zero
        · have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
          have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
            (addVal_nonneg_iff_val_le_one hnorm0).mp h_rel
          have hx_int_F : IsIntegral F x := Algebra.IsIntegral.isIntegral x
          let pb : PowerBasis F (IntermediateField.adjoin F ({x} : Set K)) :=
            IntermediateField.adjoin.powerBasis hx_int_F
          have h_gen_coe : (pb.gen : K) = x := IntermediateField.AdjoinSimple.coe_gen F x
          set dK : ℕ := Module.finrank (IntermediateField.adjoin F ({x} : Set K)) K
          have h_finrank_pos : 0 < dK := Module.finrank_pos
          have h_norm_tower : Algebra.norm F x = (Algebra.norm F pb.gen) ^ dK := by
            have h1 : Algebra.norm F (pb.gen : K) = (Algebra.norm F pb.gen) ^ dK := by
              rw [← Algebra.norm_norm (R := F) (S := IntermediateField.adjoin F ({x} : Set K))
                (A := K) (a := (pb.gen : K)), ← map_pow]
              congr 1
              exact Algebra.norm_algebraMap (L := K) pb.gen
            rwa [h_gen_coe] at h1
          have h_norm_pb : Algebra.norm F pb.gen =
              (-1) ^ pb.dim * (minpoly F pb.gen).coeff 0 :=
            Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb
          have h_minpoly_eq : minpoly F pb.gen = minpoly F x := by
            have h1 : minpoly F pb.gen = minpoly F (pb.gen : K) :=
              (minpoly.algHom_eq
                (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K)))
                (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K))).injective
                pb.gen).symm
            rwa [h_gen_coe] at h1
          letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
          haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
          haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
          letI : Valued F (ValueGroupWithZero F) :=
            IsValuativeTopology.instValuedValueGroupWithZeroOfIsUniformAddGroup
          let rlo : RankLeOneStruct F :=
            { emb := (WithZeroMulInt.toNNReal (by norm_num : (2 : NNReal) ≠ 0)).comp
                (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).toMonoidWithZeroHom
              strictMono := (WithZeroMulInt.toNNReal_strictMono (by norm_num : (1 : NNReal) < 2)).comp
                (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).strictMono }
          haveI : (Valued.v (R := F)).RankOne := Valuation.RankOne.ofRankLeOneStruct rlo
          letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
          haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F (ValueGroupWithZero F)
          have hnorm_norm_le : ‖Algebra.norm F x‖ ≤ 1 :=
            Valued.toNormedField.norm_le_one_iff.mpr hval_le
          have h_norm_coeff_pow : ‖Algebra.norm F x‖ =
              ‖(minpoly F x).coeff 0‖ ^ dK := by
            rw [h_norm_tower, h_norm_pb, h_minpoly_eq, norm_pow, norm_mul, norm_pow,
              norm_neg, norm_one, one_pow, one_mul]
          have h_coeff0_le : ‖(minpoly F x).coeff 0‖ ≤ 1 := by
            rw [h_norm_coeff_pow] at hnorm_norm_le
            exact (pow_le_one_iff_of_nonneg (norm_nonneg _) h_finrank_pos.ne').mp hnorm_norm_le
          have h_spec_le : spectralValue (minpoly F x) ≤ 1 := by
            change spectralNorm F K x ≤ 1
            rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow F K x]
            exact Real.rpow_le_one (norm_nonneg _) h_coeff0_le (by positivity)
          have h_all_coeffs : ∀ n : ℕ, ‖(minpoly F x).coeff n‖ ≤ 1 :=
            (spectralValue_le_one_iff (minpoly.monic hx_int_F)).mp h_spec_le
          have h_lifts : minpoly F x ∈ Polynomial.lifts (algebraMap 𝒪[F] F) := by
            rw [Polynomial.lifts_iff_coeff_lifts]
            intro n
            have hv : valuation F ((minpoly F x).coeff n) ≤ 1 :=
              Valued.toNormedField.norm_le_one_iff.mp (h_all_coeffs n)
            exact ⟨⟨(minpoly F x).coeff n, hv⟩, rfl⟩
          obtain ⟨P₀, hP₀_map, -, hP₀_monic⟩ :=
            Polynomial.lifts_and_degree_eq_and_monic h_lifts (minpoly.monic hx_int_F)
          refine ⟨P₀, hP₀_monic, ?_⟩
          have h_eval : Polynomial.aeval x (P₀.map (algebraMap 𝒪[F] F)) = 0 := by
            rw [hP₀_map]
            exact minpoly.aeval F x
          rwa [Polynomial.aeval_map_algebraMap] at h_eval
  have h_int : ∀ z : L, IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ relVal F L z := h_int_aux L
  have h_int_valL : ∀ {z : L} (hz : z ≠ 0), IsIntegral 𝒪[F] z ↔ 0 ≤ valL F L z := by
    intro z hz
    rw [h_int, or_iff_right hz, relVal_eq hz]
    exact ⟨fun h => nonneg_of_mul_nonneg_right h (by positivity),
      fun h => mul_nonneg (by positivity) h⟩
  have relVal_algebraMap : ∀ {c : F} (hc : c ≠ 0),
      relVal F L (algebraMap F L c) = (Module.finrank F L : ℤ) * addVal F c := by
    intro c hc
    have hnorm : Algebra.norm F (algebraMap F L c) = c ^ Module.finrank F L :=
      Algebra.norm_algebraMap c
    have hpow : addVal F (c ^ Module.finrank F L) =
        (Module.finrank F L : ℤ) * addVal F c := by
      change Multiplicative.toAdd (addValHom ((Units.mk0 c hc) ^ Module.finrank F L)) = _
      rw [map_pow, toAdd_pow, nsmul_eq_mul]
      rfl
    rw [relVal, hnorm, hpow]
  have h_res_zero_div_int : ∀ d : 𝒪[F], IsLocalRing.residue 𝒪[F] d = 0 →
      IsIntegral 𝒪[F] (algebraMap 𝒪[F] L d / πL) := by
    intro d hd_res
    by_cases hd0 : (d : F) = 0
    · have hdL : algebraMap 𝒪[F] L d = 0 := by
        change algebraMap F L (d : F) = 0
        rw [hd0, map_zero]
      rw [hdL, zero_div]
      exact isIntegral_zero
    · have hdL0 : algebraMap 𝒪[F] L d ≠ 0 := by
        change algebraMap F L (d : F) ≠ 0
        exact (map_ne_zero (algebraMap F L)).mpr hd0
      have h_not_unit : ¬ IsUnit d := by
        rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
        exact not_not.mpr hd_res
      have h_val_lt : valuation F (d : F) < 1 :=
        (Valuation.Integer.not_isUnit_iff_valuation_lt_one).mp h_not_unit
      have h_addVal_pos : 0 < addVal F (d : F) := by
        by_contra hle
        have h_nonpos : addVal F (d : F) ≤ 0 := by omega
        unfold addVal at h_nonpos
        rw [dif_neg hd0] at h_nonpos
        set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
        set vd := valuation F (d : F)
        have hvd_ne : iso vd ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hd0)
        have h_iso_lt : iso vd < iso 1 := (map_lt_map_iff iso).mpr h_val_lt
        rw [map_one, ← WithZero.coe_unzero hvd_ne, ← WithZero.coe_one, WithZero.coe_lt_coe] at h_iso_lt
        have h_toAdd_neg : Multiplicative.toAdd (WithZero.unzero hvd_ne) < 0 :=
          Multiplicative.toAdd_lt.mpr h_iso_lt
        omega
      have h_rel_d : 0 < relVal F L (algebraMap 𝒪[F] L d) := by
        change 0 < relVal F L (algebraMap F L (d : F))
        rw [relVal_algebraMap hd0]
        have hfin : 0 < Module.finrank F L := Module.finrank_pos
        positivity
      have h_valL_pos : 1 ≤ valL F L (algebraMap 𝒪[F] L d) := by
        rw [relVal_eq hdL0] at h_rel_d
        by_contra hle
        have hle0 : valL F L (algebraMap 𝒪[F] L d) ≤ 0 := by omega
        have hnp : (resDeg F L : ℤ) * valL F L (algebraMap 𝒪[F] L d) ≤ 0 :=
          mul_nonpos_of_nonneg_of_nonpos (by omega) hle0
        omega
      rw [h_int_valL (div_ne_zero hdL0 hπL_ne), valL_div hdL0 hπL_ne, hπ_val]
      omega
  have h_span : ∀ (V : Submodule F L) (πF : F), πF ≠ 0 → 0 < addVal F πF →
      (∀ x : L, IsIntegral 𝒪[F] x → ∃ v ∈ V, ∃ y : L, IsIntegral 𝒪[F] y ∧ x = v + πF • y) →
      ∀ x : L, IsIntegral 𝒪[F] x → x ∈ V := by
    intro V πF hπF0 hπF hstep
    letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
    haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
    haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
    letI : Valued F (ValueGroupWithZero F) :=
      IsValuativeTopology.instValuedValueGroupWithZeroOfIsUniformAddGroup
    let rlo : RankLeOneStruct F :=
      { emb := (WithZeroMulInt.toNNReal (by norm_num : (2 : NNReal) ≠ 0)).comp
          (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).toMonoidWithZeroHom
        strictMono := (WithZeroMulInt.toNNReal_strictMono (by norm_num : (1 : NNReal) < 2)).comp
          (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).strictMono }
    haveI : (Valued.v (R := F)).RankOne := Valuation.RankOne.ofRankLeOneStruct rlo
    letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
    haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F (ValueGroupWithZero F)
    letI : NormedField L := spectralNorm.normedField F L
    letI : NormedSpace F L := spectralNorm.normedSpace F L
    have hπF_val_lt : valuation F πF < 1 := by
      unfold addVal at hπF
      rw [dif_neg hπF0] at hπF
      set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
      set vp := valuation F πF
      have hvp_ne : iso vp ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hπF0)
      have h_toAdd_neg : Multiplicative.toAdd (WithZero.unzero hvp_ne) < 0 := by omega
      have h_unzero_lt : WithZero.unzero hvp_ne < 1 := Multiplicative.toAdd_lt.mp h_toAdd_neg
      have h_iso_lt : iso vp < iso 1 := by
        rw [map_one, ← WithZero.coe_unzero hvp_ne, ← WithZero.coe_one]
        exact WithZero.coe_lt_coe.mpr h_unzero_lt
      exact (map_lt_map_iff iso).mp h_iso_lt
    have hπF_norm_lt : ‖πF‖ < 1 :=
      Valued.toNormedField.norm_lt_one_iff.mpr hπF_val_lt
    haveI : IsIntegrallyClosed 𝒪[F] :=
      Valuation.Integers.isIntegrallyClosed (Valuation.integer.integers (valuation F))
    have h_norm_le_one : ∀ y : L, IsIntegral 𝒪[F] y → ‖y‖ ≤ 1 := by
      intro y hy
      change spectralNorm F L y ≤ 1
      rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow F L y]
      have h_minpoly := minpoly.isIntegrallyClosed_eq_field_fractions' F hy
      have h_coeff : (minpoly F y).coeff 0 = algebraMap 𝒪[F] F ((minpoly 𝒪[F] y).coeff 0) := by
        rw [h_minpoly, Polynomial.coeff_map]
      have h_val_coeff : Valued.v ((minpoly F y).coeff 0) ≤ 1 := by
        rw [h_coeff]
        exact ((minpoly 𝒪[F] y).coeff 0).2
      have h_norm_coeff : ‖(minpoly F y).coeff 0‖ ≤ 1 :=
        Valued.toNormedField.norm_le_one_iff.mpr h_val_coeff
      exact Real.rpow_le_one (norm_nonneg _) h_norm_coeff (by positivity)
    have h_ind : ∀ (k : ℕ) (x : L), IsIntegral 𝒪[F] x →
        ∃ v ∈ V, ∃ y : L, IsIntegral 𝒪[F] y ∧ x = v + (πF ^ k) • y := by
      intro k
      induction k with
      | zero =>
        intro x hx
        exact ⟨0, V.zero_mem, x, hx, by simp⟩
      | succ k ih =>
        intro x hx
        obtain ⟨v₁, hv₁, y₁, hy₁, hxy₁⟩ := ih x hx
        obtain ⟨v₂, hv₂, y₂, hy₂, hy₁y₂⟩ := hstep y₁ hy₁
        refine ⟨v₁ + (πF ^ k) • v₂, V.add_mem hv₁ (V.smul_mem _ hv₂), y₂, hy₂, ?_⟩
        rw [hxy₁, hy₁y₂, smul_add, add_assoc, smul_smul, ← pow_succ]
    haveI : FiniteDimensional F V := Submodule.finiteDimensional_of_le (le_top : V ≤ ⊤)
    have hV_closed : IsClosed (V : Set L) := Submodule.closed_of_finiteDimensional V
    intro x hx
    change x ∈ (V : Set L)
    rw [← hV_closed.closure_eq, Metric.mem_closure_iff]
    intro ε hε
    obtain ⟨k, hk⟩ := exists_pow_lt_of_lt_one hε hπF_norm_lt
    obtain ⟨v, hv, y, hy, hxy⟩ := h_ind k x hx
    refine ⟨v, hv, ?_⟩
    have hsub : x - v = (πF ^ k) • y := by
      rw [hxy, add_sub_cancel_left]
    rw [dist_eq_norm, hsub, norm_smul, norm_pow]
    have hy_le := h_norm_le_one y hy
    have hpow_nonneg : 0 ≤ ‖πF‖ ^ k := pow_nonneg (norm_nonneg _) k
    calc ‖πF‖ ^ k * ‖y‖ ≤ ‖πF‖ ^ k * 1 := mul_le_mul_of_nonneg_left hy_le hpow_nonneg
      _ = ‖πF‖ ^ k := mul_one _
      _ < ε := hk
  let P1 : ∀ (r : ℕ), (Fin r → L) → Prop :=
    fun r ω => ∀ i : Fin r, IsIntegral 𝒪[F] (ω i)
  let P2 : ∀ (r : ℕ), (Fin r → L) → Prop :=
    fun r ω => ∀ x : L, IsIntegral 𝒪[F] x →
      ∃ a : Fin r → 𝒪[F], IsIntegral 𝒪[F] ((x - ∑ i, algebraMap 𝒪[F] L (a i) * ω i) / πL)
  let P3 : ∀ (r : ℕ), (Fin r → L) → Prop :=
    fun r ω => ∀ a : Fin r → 𝒪[F],
      IsIntegral 𝒪[F] ((∑ i, algebraMap 𝒪[F] L (a i) * ω i) / πL) →
      ∀ i : Fin r, IsLocalRing.residue 𝒪[F] (a i) = 0
  have h_le_finrank : ∀ (r : ℕ) (ω : Fin r → L), P3 r ω → r ≤ Module.finrank F L := by
    intro r ω hP3
    have hli : LinearIndependent F ω := by
      rw [Fintype.linearIndependent_iff]
      intro c hc_sum
      by_contra h_not_all
      push_neg at h_not_all
      obtain ⟨i₁, hi₁⟩ := h_not_all
      let S : Finset (Fin r) := Finset.univ.filter (fun i => c i ≠ 0)
      have hS_ne : S.Nonempty := ⟨i₁, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi₁⟩⟩
      obtain ⟨i₀, hi₀S, hi₀_min⟩ := Finset.exists_min_image S (fun i => addVal F (c i)) hS_ne
      have hci₀ : c i₀ ≠ 0 := (Finset.mem_filter.mp hi₀S).2
      have h_val_div : ∀ i : Fin r, valuation F (c i / c i₀) ≤ 1 := by
        intro i
        by_cases hci : c i = 0
        · rw [hci, zero_div, map_zero]
          exact zero_le_one
        · apply (addVal_nonneg_iff_val_le_one (div_ne_zero hci hci₀)).mp
          rw [addVal_div hci hci₀]
          have hiS : i ∈ S := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hci⟩
          have hle := hi₀_min i hiS
          omega
      let a : Fin r → 𝒪[F] := fun i => ⟨c i / c i₀, h_val_div i⟩
      have h_sum_zero : ∑ i : Fin r, algebraMap 𝒪[F] L (a i) * ω i = 0 := by
        have h_eq : ∀ i : Fin r, algebraMap 𝒪[F] L (a i) * ω i =
            (algebraMap F L (c i₀))⁻¹ * (c i • ω i) := by
          intro i
          change algebraMap F L (c i / c i₀) * ω i = _
          rw [Algebra.smul_def, map_div₀, div_eq_inv_mul, mul_assoc]
        simp_rw [h_eq, ← Finset.mul_sum, hc_sum, mul_zero]
      have h_div_int : IsIntegral 𝒪[F] ((∑ i : Fin r, algebraMap 𝒪[F] L (a i) * ω i) / πL) := by
        rw [h_sum_zero, zero_div]
        exact isIntegral_zero
      have h_res_i₀ := hP3 a h_div_int i₀
      have ha_i₀ : a i₀ = 1 := Subtype.ext (div_self hci₀)
      rw [ha_i₀, map_one] at h_res_i₀
      exact one_ne_zero h_res_i₀
    have hcard := hli.fintype_card_le_finrank
    rwa [Fintype.card_fin] at hcard
  have h_step : ∀ (r : ℕ) (ω : Fin r → L), P1 r ω → P3 r ω → ¬ P2 r ω →
      ∃ ω' : Fin (r + 1) → L, P1 (r + 1) ω' ∧ P3 (r + 1) ω' := by
    intro r ω hP1 hP3 hnotP2
    unfold P2 at hnotP2
    push_neg at hnotP2
    obtain ⟨x₀, hx₀_int, hx₀_not⟩ := hnotP2
    let ω' : Fin (r + 1) → L := @Fin.lastCases r (fun _ => L) x₀ ω
    refine ⟨ω', ?_, ?_⟩
    · intro j
      refine Fin.lastCases ?_ ?_ j
      · change IsIntegral 𝒪[F] (@Fin.lastCases r (fun _ => L) x₀ ω (Fin.last r))
        rw [Fin.lastCases_last]
        exact hx₀_int
      · intro i
        change IsIntegral 𝒪[F] (@Fin.lastCases r (fun _ => L) x₀ ω i.castSucc)
        rw [Fin.lastCases_castSucc]
        exact hP1 i
    · intro a ha_int
      have h_sum_split : ∑ j : Fin (r + 1), algebraMap 𝒪[F] L (a j) * ω' j =
          (∑ i : Fin r, algebraMap 𝒪[F] L (a i.castSucc) * ω i) +
            algebraMap 𝒪[F] L (a (Fin.last r)) * x₀ := by
        rw [Fin.sum_univ_castSucc]
        congr 1
        · refine Finset.sum_congr rfl fun i _ => ?_
          change _ * @Fin.lastCases r (fun _ => L) x₀ ω i.castSucc = _
          rw [Fin.lastCases_castSucc]
        · change _ * @Fin.lastCases r (fun _ => L) x₀ ω (Fin.last r) = _
          rw [Fin.lastCases_last]
      have h_last : IsLocalRing.residue 𝒪[F] (a (Fin.last r)) = 0 := by
        by_contra h_ne
        have h_unit : IsUnit (a (Fin.last r)) :=
          (IsLocalRing.residue_ne_zero_iff_isUnit (a (Fin.last r))).mp h_ne
        obtain ⟨u, hu⟩ := h_unit
        let u_inv : 𝒪[F] := ↑(u⁻¹)
        have hu_mul : u_inv * a (Fin.last r) = 1 := by
          rw [← hu]
          exact Units.inv_mul u
        have h_u_inv_int : IsIntegral 𝒪[F] (algebraMap 𝒪[F] L u_inv) := isIntegral_algebraMap
        have h_mul_int := IsIntegral.mul h_u_inv_int ha_int
        let b : Fin r → 𝒪[F] := fun i => -(u_inv * a i.castSucc)
        have h_alg : algebraMap 𝒪[F] L u_inv *
            ((∑ j : Fin (r + 1), algebraMap 𝒪[F] L (a j) * ω' j) / πL) =
            (x₀ - ∑ i : Fin r, algebraMap 𝒪[F] L (b i) * ω i) / πL := by
          rw [h_sum_split, ← mul_div_assoc]
          congr 1
          have h1 : algebraMap 𝒪[F] L u_inv * (algebraMap 𝒪[F] L (a (Fin.last r)) * x₀) = x₀ := by
            rw [← mul_assoc, ← map_mul, hu_mul, map_one, one_mul]
          have h2 : algebraMap 𝒪[F] L u_inv *
              (∑ i : Fin r, algebraMap 𝒪[F] L (a i.castSucc) * ω i) =
              -(∑ i : Fin r, algebraMap 𝒪[F] L (b i) * ω i) := by
            rw [Finset.mul_sum, ← Finset.sum_neg_distrib]
            refine Finset.sum_congr rfl fun i _ => ?_
            simp only [b, map_neg, map_mul, neg_mul, neg_neg, mul_assoc]
          rw [mul_add, h1, h2]
          ring
        rw [h_alg] at h_mul_int
        exact hx₀_not b h_mul_int
      have h_last_div_int : IsIntegral 𝒪[F] ((algebraMap 𝒪[F] L (a (Fin.last r)) * x₀) / πL) := by
        rw [mul_div_right_comm]
        exact IsIntegral.mul (h_res_zero_div_int (a (Fin.last r)) h_last) hx₀_int
      have h_init_int : IsIntegral 𝒪[F]
          ((∑ i : Fin r, algebraMap 𝒪[F] L (a i.castSucc) * ω i) / πL) := by
        have h_sub := IsIntegral.sub ha_int h_last_div_int
        have h_eq : ((∑ j : Fin (r + 1), algebraMap 𝒪[F] L (a j) * ω' j) / πL) -
            ((algebraMap 𝒪[F] L (a (Fin.last r)) * x₀) / πL) =
            (∑ i : Fin r, algebraMap 𝒪[F] L (a i.castSucc) * ω i) / πL := by
          rw [h_sum_split, add_div, add_sub_cancel_right]
        rwa [h_eq] at h_sub
      have h_init := hP3 (fun i => a i.castSucc) h_init_int
      intro j
      refine Fin.lastCases h_last (fun i => h_init i) j
  have h_basis_ind : ∀ (k : ℕ) (r : ℕ), Module.finrank F L - r ≤ k →
      ∀ (ω : Fin r → L), P1 r ω → P3 r ω →
      ∃ (f₀ : ℕ) (ω₀ : Fin f₀ → L), P1 f₀ ω₀ ∧ P2 f₀ ω₀ ∧ P3 f₀ ω₀ := by
    intro k
    induction k with
    | zero =>
      intro r hr ω hP1 hP3
      by_cases hP2 : P2 r ω
      · exact ⟨r, ω, hP1, hP2, hP3⟩
      · obtain ⟨ω', hP1', hP3'⟩ := h_step r ω hP1 hP3 hP2
        have hle := h_le_finrank (r + 1) ω' hP3'
        omega
    | succ k ih =>
      intro r hr ω hP1 hP3
      by_cases hP2 : P2 r ω
      · exact ⟨r, ω, hP1, hP2, hP3⟩
      · obtain ⟨ω', hP1', hP3'⟩ := h_step r ω hP1 hP3 hP2
        have hle := h_le_finrank (r + 1) ω' hP3'
        exact ih (r + 1) (by omega) ω' hP1' hP3'
  obtain ⟨f₀, ω, hω_int, hω_span, hω_ind⟩ :=
    h_basis_ind (Module.finrank F L) 0 (by omega) Fin.elim0
      (fun i => Fin.elim0 i) (fun _ _ i => Fin.elim0 i)
  obtain ⟨uF, huF⟩ := exists_addVal_eq_one
  set πF : F := (uF : F)
  have hπF0 : πF ≠ 0 := uF.ne_zero
  have hπF_L0 : algebraMap F L πF ≠ 0 := (map_ne_zero (algebraMap F L)).mpr hπF0
  have h_finrank_rel : (Module.finrank F L : ℤ) =
      (resDeg F L : ℤ) * valL F L (algebraMap F L πF) := by
    have h1 := relVal_algebraMap hπF0
    rw [huF, mul_one, relVal_eq hπF_L0] at h1
    exact h1.symm
  have h_finrank_pos : 0 < Module.finrank F L := Module.finrank_pos
  have h_valL_πF_pos : 0 < valL F L (algebraMap F L πF) := by
    by_contra hle
    have hle0 : valL F L (algebraMap F L πF) ≤ 0 := by omega
    have hnp : (resDeg F L : ℤ) * valL F L (algebraMap F L πF) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos (by omega) hle0
    omega
  let e : ℕ := (valL F L (algebraMap F L πF)).toNat
  have he_eq : (e : ℤ) = valL F L (algebraMap F L πF) :=
    Int.toNat_of_nonneg (by omega)
  have he_pos : 0 < e := by omega
  have h_finrank_eq : Module.finrank F L = resDeg F L * e := by
    have h : (Module.finrank F L : ℤ) = (resDeg F L * e : ℕ) := by
      push_cast
      rw [he_eq]
      exact h_finrank_rel
    exact Nat.cast_injective h
  have valL_algebraMap : ∀ {c : F} (hc : c ≠ 0),
      valL F L (algebraMap F L c) = (e : ℤ) * addVal F c := by
    intro c hc
    have hcL0 : algebraMap F L c ≠ 0 := (map_ne_zero (algebraMap F L)).mpr hc
    have h1 := relVal_algebraMap hc
    rw [relVal_eq hcL0, h_finrank_rel, ← he_eq, mul_assoc] at h1
    exact mul_left_cancel₀ (by positivity) h1
  have h_comb : ∀ (c : Fin f₀ → F), (∃ i, c i ≠ 0) →
      (∑ i, c i • ω i ≠ 0) ∧ ∃ m : ℤ, valL F L (∑ i, c i • ω i) = (e : ℤ) * m := by
    intro c ⟨i₁, hi₁⟩
    let S : Finset (Fin f₀) := Finset.univ.filter (fun i => c i ≠ 0)
    have hS_ne : S.Nonempty := ⟨i₁, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi₁⟩⟩
    obtain ⟨i₀, hi₀S, hi₀_min⟩ := Finset.exists_min_image S (fun i => addVal F (c i)) hS_ne
    have hci₀ : c i₀ ≠ 0 := (Finset.mem_filter.mp hi₀S).2
    have h_val_div : ∀ i : Fin f₀, valuation F (c i / c i₀) ≤ 1 := by
      intro i
      by_cases hci : c i = 0
      · rw [hci, zero_div, map_zero]
        exact zero_le_one
      · apply (addVal_nonneg_iff_val_le_one (div_ne_zero hci hci₀)).mp
        rw [addVal_div hci hci₀]
        have hiS : i ∈ S := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hci⟩
        have hle := hi₀_min i hiS
        omega
    let a : Fin f₀ → 𝒪[F] := fun i => ⟨c i / c i₀, h_val_div i⟩
    set s₀ : L := ∑ i : Fin f₀, algebraMap 𝒪[F] L (a i) * ω i
    have hs_eq : ∑ i : Fin f₀, c i • ω i = algebraMap F L (c i₀) * s₀ := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      change c i • ω i = algebraMap F L (c i₀) * (algebraMap F L (c i / c i₀) * ω i)
      rw [Algebra.smul_def, ← mul_assoc, ← map_mul, mul_div_cancel₀ _ hci₀]
    have ha_i₀ : a i₀ = 1 := Subtype.ext (div_self hci₀)
    have h_not_div : ¬ IsIntegral 𝒪[F] (s₀ / πL) := by
      intro hdiv
      have hres := hω_ind a hdiv i₀
      rw [ha_i₀, map_one] at hres
      exact one_ne_zero hres
    have hs₀_ne : s₀ ≠ 0 := by
      intro h0
      apply h_not_div
      rw [h0, zero_div]
      exact isIntegral_zero
    have hs_ne : ∑ i : Fin f₀, c i • ω i ≠ 0 := by
      rw [hs_eq]
      exact mul_ne_zero ((map_ne_zero (algebraMap F L)).mpr hci₀) hs₀_ne
    have hs₀_int : IsIntegral 𝒪[F] s₀ :=
      (integralClosure 𝒪[F] L).sum_mem fun i _ =>
        (integralClosure 𝒪[F] L).mul_mem isIntegral_algebraMap (hω_int i)
    have hs₀_val_nonneg : 0 ≤ valL F L s₀ := (h_int_valL hs₀_ne).mp hs₀_int
    have hs₀_val_lt : valL F L s₀ < 1 := by
      by_contra hge
      apply h_not_div
      rw [h_int_valL (div_ne_zero hs₀_ne hπL_ne), valL_div hs₀_ne hπL_ne, hπ_val]
      omega
    have hs₀_val_zero : valL F L s₀ = 0 := by omega
    refine ⟨hs_ne, addVal F (c i₀), ?_⟩
    rw [hs_eq, valL_mul ((map_ne_zero (algebraMap F L)).mpr hci₀) hs₀_ne,
      valL_algebraMap hci₀, hs₀_val_zero, add_zero]
  let B : Fin f₀ × Fin e → L := fun p => ω p.1 * πL ^ (p.2 : ℕ)
  have hB_li : LinearIndependent F B := by
    rw [Fintype.linearIndependent_iff]
    intro c hc_sum
    let s : Fin e → L := fun j => ∑ i : Fin f₀, c (i, j) • ω i
    have h_sum_s : ∑ j : Fin e, s j * πL ^ (j : ℕ) = 0 := by
      rw [← hc_sum, Fintype.sum_prod_type_right]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [s, B, Finset.sum_mul, smul_mul_assoc]
    have hs_all_zero : ∀ j : Fin e, s j = 0 := by
      by_contra h_not
      push_neg at h_not
      obtain ⟨j₁, hj₁⟩ := h_not
      let T : Finset (Fin e) := Finset.univ.filter (fun j => s j ≠ 0)
      have hT_ne : T.Nonempty := ⟨j₁, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj₁⟩⟩
      let t : Fin e → L := fun j => s j * πL ^ (j : ℕ)
      have ht_ne : ∀ j ∈ T, t j ≠ 0 := by
        intro j hjT
        exact mul_ne_zero (Finset.mem_filter.mp hjT).2 (pow_ne_zero _ hπL_ne)
      have ht_mod : ∀ j ∈ T, valL F L (t j) % (e : ℤ) = (j : ℤ) := by
        intro j hjT
        have hsj : s j ≠ 0 := (Finset.mem_filter.mp hjT).2
        have hex : ∃ i, c (i, j) ≠ 0 := by
          by_contra h_all0
          push_neg at h_all0
          apply hsj
          simp [s, h_all0]
        obtain ⟨-, m, hm⟩ := h_comb (fun i => c (i, j)) hex
        have h_val_t : valL F L (t j) = (j : ℤ) + (e : ℤ) * m := by
          change valL F L (s j * πL ^ (j : ℕ)) = _
          rw [valL_mul hsj (pow_ne_zero _ hπL_ne), hm, valL_pow hπL_ne, hπ_val, mul_one, add_comm]
        rw [h_val_t, Int.add_mul_emod_self_left, Int.emod_eq_of_lt (by positivity) (by omega)]
      obtain ⟨j₀, hj₀T, hj₀_min⟩ := Finset.exists_min_image T (fun j => valL F L (t j)) hT_ne
      have h_strict : ∀ j ∈ T.erase j₀, valL F L (t j₀) + 1 ≤ valL F L (t j) := by
        intro j hj
        have hj_ne : j ≠ j₀ := (Finset.mem_erase.mp hj).1
        have hjT : j ∈ T := (Finset.mem_erase.mp hj).2
        have hle := hj₀_min j hjT
        have hne_val : valL F L (t j) ≠ valL F L (t j₀) := by
          intro heq
          have hmod : valL F L (t j) % (e : ℤ) = valL F L (t j₀) % (e : ℤ) :=
            congrArg (fun z => z % (e : ℤ)) heq
          rw [ht_mod j hjT, ht_mod j₀ hj₀T] at hmod
          exact hj_ne (Fin.ext (Int.ofNat.inj hmod))
        omega
      have h_sum_T : ∑ j ∈ T, t j = 0 := by
        rw [← h_sum_s]
        refine Finset.sum_subset (Finset.subset_univ T) fun j _ hjT => ?_
        have hsj0 : s j = 0 := by
          by_contra hsj
          exact hjT (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hsj⟩)
        simp [t, hsj0]
      have h_erase_sum : ∑ j ∈ T.erase j₀, t j = -t j₀ := by
        have h := Finset.add_sum_erase T t hj₀T
        rw [h_sum_T] at h
        linear_combination h
      have h_div_sum_int : IsIntegral 𝒪[F]
          (∑ j ∈ T.erase j₀, ((t j / t j₀) / πL)) := by
        refine (integralClosure 𝒪[F] L).sum_mem fun j hj => ?_
        have hjT : j ∈ T := (Finset.mem_erase.mp hj).2
        have h_ne1 : t j / t j₀ ≠ 0 := div_ne_zero (ht_ne j hjT) (ht_ne j₀ hj₀T)
        have h_ne2 : (t j / t j₀) / πL ≠ 0 := div_ne_zero h_ne1 hπL_ne
        change IsIntegral 𝒪[F] ((t j / t j₀) / πL)
        rw [h_int_valL h_ne2, valL_div h_ne1 hπL_ne, valL_div (ht_ne j hjT) (ht_ne j₀ hj₀T), hπ_val]
        have hlt := h_strict j hj
        omega
      have h_sum_eq : (∑ j ∈ T.erase j₀, ((t j / t j₀) / πL)) = (-1 : L) / πL := by
        rw [← Finset.sum_div, ← Finset.sum_div, h_erase_sum, neg_div,
          div_self (ht_ne j₀ hj₀T)]
      rw [h_sum_eq] at h_div_sum_int
      have h_neg1_ne : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have h_neg1_val : valL F L (-1 : L) = 0 := by
        have hsq : valL F L ((-1 : L) * (-1 : L)) = valL F L (-1 : L) + valL F L (-1 : L) :=
