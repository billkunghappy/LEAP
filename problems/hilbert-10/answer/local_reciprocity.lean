    let pb : PowerBasis L_base B_adj := IntermediateField.adjoin.powerBasis h_int_π
    have h_pb_dim : pb.dim = q := by
      rw [← pb.finrank, h_fin]
    have h_pb_gen' : pb.gen = IntermediateField.AdjoinSimple.gen L_base π :=
      IntermediateField.adjoin.powerBasis_gen h_int_π
    have h_minpoly_deg : (minpoly L_base π).natDegree = q := by
      rw [← IntermediateField.adjoin.powerBasis_dim h_int_π, h_pb_dim]
