    fun hX hY j i => polyInt_add (hX j i) (hY j i)
  have matInt_mul : ∀ {X Y}, matInt X → matInt Y → matInt (X * Y) := by
    intro X Y hX hY j i
    rw [Matrix.mul_apply]
    exact polyInt_sum _ _ fun r _ => polyInt_mul (hX j r) (hY r i)
  have matInt_pow : ∀ {X}, matInt X → ∀ e : ℕ, matInt (X ^ e) := by
    intro X hX e
    induction e with
    | zero => exact matInt_one
    | succ e ih =>
      rw [pow_succ]
      exact matInt_mul ih hX
  have matInt_scalar : ∀ {P : Polynomial E₀}, polyInt P → matInt (Matrix.scalar (Fin q) P) := by
    intro P hP j i
