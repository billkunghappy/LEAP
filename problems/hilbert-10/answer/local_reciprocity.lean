    dsimp [t]
    rw [pow_zero, mul_one]
  have h_sub_πM_ne : galApply F hLM σbar π_M - π_M ≠ 0 :=
    sub_ne_zero.mpr hσbar_πM_ne
  have hD0_ne : D.coeff 0 ≠ 0 := by
    rw [hD0_eq]
    exact (map_ne_zero ι).mpr h_sub_πM_ne
  have hD0_val : valL F E (D.coeff 0) = W := by
    rw [hD0_eq, hι_apply, h_val_scale _ h_sub_πM_ne]
  have ht0_ne : t 0 ≠ 0 := by
    rw [ht0_eq]
    exact hD0_ne
  have ht0_val : valL F E (t 0) = W := by
    rw [ht0_eq]
    exact hD0_val
  have ht_other : ∀ j : ℕ, j ≠ 0 → V_val (W + 1) (t j) := by
    intro j hj_ne
    rcases lt_trichotomy j H.card with hj_lt | rfl | hj_gt
    · set a_j : M := P_M.coeff j
      set b_j : M := a_j / π_M
      have ha_j_eq : π_M * b_j = a_j := mul_div_cancel₀ a_j hπ_M_ne
      have hb_j : (b_j = 0 ∨ 0 ≤ valL F M b_j) ∧ V_val 0 (ι b_j) := by
        by_cases hb0 : b_j = 0
        · refine ⟨Or.inl hb0, Or.inl ?_⟩
          rw [hb0, map_zero]
        · have ha0 : a_j ≠ 0 := by
            rw [← ha_j_eq]
            exact mul_ne_zero hπ_M_ne hb0
          have hιa0 : ι a_j ≠ 0 := (map_ne_zero ι).mpr ha0
          have hιb0 : ι b_j ≠ 0 := (map_ne_zero ι).mpr hb0
          have h_va_E_ge1 : 1 ≤ valL F E (ι a_j) :=
            (hPM_coeff_V1 j hj_lt).resolve_left hιa0
          have h_va_scale : valL F E (ι a_j) = (H.card : ℤ) * valL F M a_j :=
            h_val_scale a_j ha0
          have h_va_M_ge1 : 1 ≤ valL F M a_j := by
            by_contra h_le0
            push_neg at h_le0
            have h_nonpos : (H.card : ℤ) * valL F M a_j ≤ 0 :=
              mul_nonpos_of_nonneg_of_nonpos (by omega) (by omega)
            omega
          have h_va_E_geH : (H.card : ℤ) ≤ valL F E (ι a_j) := by
            rw [h_va_scale]
            calc (H.card : ℤ) = (H.card : ℤ) * 1 := (mul_one _).symm
              _ ≤ (H.card : ℤ) * valL F M a_j :=
                mul_le_mul_of_nonneg_left h_va_M_ge1 (by omega)
          have h_mul_eq : ι a_j = ι π_M * ι b_j := by
            rw [← ha_j_eq, map_mul]
          have h_vb_E : valL F E (ι a_j) = (H.card : ℤ) + valL F E (ι b_j) := by
            rw [h_mul_eq, valL_mul hιπM_ne hιb0, hιπM_val_eq]
          have h_vb_E_nonneg : 0 ≤ valL F E (ι b_j) := by omega
          have h_vb_scale : valL F E (ι b_j) = (H.card : ℤ) * valL F M b_j :=
            h_val_scale b_j hb0
          have h_vb_M_nonneg : 0 ≤ valL F M b_j := by
            rw [h_vb_scale] at h_vb_E_nonneg
            exact nonneg_of_mul_nonneg_right h_vb_E_nonneg hH_pos_z
          exact ⟨Or.inr h_vb_M_nonneg, Or.inr h_vb_E_nonneg⟩
      have hD_j_decomp : D.coeff j =
          D.coeff 0 * galApply F hLE σ (ι b_j) +
            ι π_M * (galApply F hLE σ (ι b_j) - ι b_j) := by
        have h_aj_ι : ι (P_M.coeff j) = ι π_M * ι b_j := by
          change ι a_j = ι π_M * ι b_j
          rw [← ha_j_eq, map_mul]
        rw [hD_coeff j, hD_coeff 0, h_aj_ι, galApply_mul_val]
        ring
      have h_term1_W : V_val W (D.coeff 0 * galApply F hLE σ (ι b_j)) := by
        by_cases h0 : galApply F hLE σ (ι b_j) = 0
        · rw [h0, mul_zero]
          exact Or.inl rfl
        · right
          have h_ge0 : 0 ≤ valL F E (galApply F hLE σ (ι b_j)) :=
            (hV_gal σ hb_j.2).resolve_left h0
          rw [valL_mul hD0_ne h0, hD0_val]
          omega
      have h_term2_W : V_val W (ι π_M * (galApply F hLE σ (ι b_j) - ι b_j)) := by
        have h_comm_b : galApply F hLE σ (ι b_j) - ι b_j =
            ι (galApply F hLM σbar b_j - b_j) := by
          rw [map_sub, hι_apply, hι_apply, hres_comm σ b_j]
        rw [h_comm_b]
        rcases hb_ram b_j hb_j.1 with hb_fix | hb_ge
        · rw [hb_fix, sub_self, map_zero, mul_zero]
          exact Or.inl rfl
        · by_cases h_diff0 : galApply F hLM σbar b_j - b_j = 0
          · rw [h_diff0, map_zero, mul_zero]
            exact Or.inl rfl
          · right
            have hι_diff0 : ι (galApply F hLM σbar b_j - b_j) ≠ 0 :=
              (map_ne_zero ι).mpr h_diff0
            have h_val_diff : valL F E (ι (galApply F hLM σbar b_j - b_j)) =
                (H.card : ℤ) * valL F M (galApply F hLM σbar b_j - b_j) :=
              h_val_scale _ h_diff0
            have h_W_le : W ≤ valL F E (ι (galApply F hLM σbar b_j - b_j)) := by
              rw [h_val_diff]
              exact mul_le_mul_of_nonneg_left hb_ge (by omega)
            rw [valL_mul hιπM_ne hι_diff0, hιπM_val_eq]
            omega
      have hD_j_W : V_val W (D.coeff j) := by
        rw [hD_j_decomp]
        exact hV_add h_term1_W h_term2_W
      by_cases hDj0 : D.coeff j = 0
      · left
        dsimp [t]
        rw [hDj0, zero_mul]
      · right
        have hDj_ge : W ≤ valL F E (D.coeff j) := hD_j_W.resolve_left hDj0
        have hpow_ne : π_E ^ j ≠ 0 := pow_ne_zero j hπ_E_ne
        dsimp [t]
        rw [valL_mul hDj0 hpow_ne, valL_pow hπ_E_ne j, hπ_E, mul_one]
        omega
    · left
      have h_monic_coeff : P_M.coeff H.card = 1 := by
        rw [← hPM_deg]
        exact hPM_monic.coeff_natDegree
      dsimp [t]
      rw [hD_coeff H.card, h_monic_coeff, map_one, galApply_one_val, sub_self, zero_mul]
    · left
      have h_zero_coeff : P_M.coeff j = 0 :=
        Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
      dsimp [t]
      rw [hD_coeff j, h_zero_coeff, map_zero, galApply_zero, sub_self, zero_mul]
  have hD_eval_sum : Polynomial.eval π_E D =
      ∑ j ∈ Finset.range (D.natDegree + 1), t j :=
    Polynomial.eval_eq_sum_range π_E
  have h0_mem : 0 ∈ Finset.range (D.natDegree + 1) :=
    Finset.mem_range.mpr (Nat.succ_pos D.natDegree)
  set S_rem := (Finset.range (D.natDegree + 1)).erase 0
  set s : E := ∑ j ∈ S_rem, t j
  have hD_eval_split : Polynomial.eval π_E D = t 0 + s := by
    rw [hD_eval_sum, ← Finset.add_sum_erase _ _ h0_mem]
  have hs_val : V_val (W + 1) s :=
    Finset.sum_induction t (V_val (W + 1)) (fun _ _ hx hy => hV_add hx hy) (Or.inl rfl)
      (fun j hj => ht_other j (Finset.ne_of_mem_erase hj))
  have hs_lt : s = 0 ∨ valL F E (t 0) < valL F E s := by
    rcases hs_val with hs0 | hs_ge
    · exact Or.inl hs0
    · right
      rw [ht0_val]
      omega
  obtain ⟨_, hD_val⟩ := valL_add_of_lt ht0_ne hs_lt
  rw [← hD_eval_split, ht0_val] at hD_val
  have h_coset_ne : ∀ τ ∈ H,
      galApply F hLE (σ * τ) π_E ≠ π_E ∧
        1 ≤ valL F E (galApply F hLE (σ * τ) π_E - π_E) := by
    intro τ hτ
    have hστ_ne : σ * τ ≠ 1 := by
      intro h1
      apply hσ
      have h2 : res (σ * τ) = 1 := by rw [h1, map_one]
      rw [map_mul, (hH τ).mp hτ, mul_one] at h2
      exact h2
    exact hG_ne (σ * τ) hστ_ne
  have h_factor_ne : ∀ τ ∈ H, π_E - galApply F hLE (σ * τ) π_E ≠ 0 := by
    intro τ hτ
    exact sub_ne_zero.mpr (h_coset_ne τ hτ).1.symm
  obtain ⟨_, h_prod_val⟩ :=
    valL_prod H (fun τ => π_E - galApply F hLE (σ * τ) π_E) h_factor_ne
  have h_sum_val :
      ∑ τ ∈ H, valL F E (galApply F hLE (σ * τ) π_E - π_E) = W := by
    calc ∑ τ ∈ H, valL F E (galApply F hLE (σ * τ) π_E - π_E)
        = ∑ τ ∈ H, valL F E (π_E - galApply F hLE (σ * τ) π_E) := by
          refine Finset.sum_congr rfl fun τ _ => ?_
          rw [← neg_sub (galApply F hLE (σ * τ) π_E) π_E, valL_neg]
      _ = valL F E (∏ τ ∈ H, (π_E - galApply F hLE (σ * τ) π_E)) := h_prod_val.symm
      _ = valL F E (Polynomial.eval π_E D) := by rw [← hD_eval_prod]
      _ = W := hD_val
  let w : G → ℕ := fun τ => (valL F E (galApply F hLE (σ * τ) π_E - π_E)).toNat - 1
  let wbar : ℕ := v_σbar.toNat - 1
  have hw_eq : ∀ τ ∈ H,
      valL F E (galApply F hLE (σ * τ) π_E - π_E) = (w τ : ℤ) + 1 := by
    intro τ hτ
    have hge1 : 1 ≤ valL F E (galApply F hLE (σ * τ) π_E - π_E) := (h_coset_ne τ hτ).2
    dsimp [w]
    omega
  have hwbar_eq : v_σbar = (wbar : ℤ) + 1 := by
    dsimp [wbar]
    omega
  have h_sum_z : ((∑ τ ∈ H, w τ : ℕ) : ℤ) + (H.card : ℤ) =
      ((H.card * wbar : ℕ) : ℤ) + (H.card : ℤ) := by
    calc ((∑ τ ∈ H, w τ : ℕ) : ℤ) + (H.card : ℤ)
        = (∑ τ ∈ H, (w τ : ℤ)) + ∑ _τ ∈ H, (1 : ℤ) := by
          rw [Nat.cast_sum]
          simp
      _ = ∑ τ ∈ H, ((w τ : ℤ) + 1) := Finset.sum_add_distrib.symm
      _ = ∑ τ ∈ H, valL F E (galApply F hLE (σ * τ) π_E - π_E) :=
          Finset.sum_congr rfl fun τ hτ => (hw_eq τ hτ).symm
      _ = W := h_sum_val
      _ = ((H.card * wbar : ℕ) : ℤ) + (H.card : ℤ) := by
          dsimp [W]
          rw [hwbar_eq]
          ring
  exact Nat.cast_injective (add_right_cancel h_sum_z)

theorem herbrandSum_le_card_ker_mul_herbrandSum (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
    (hLM : L ≤ M) (hME : M ≤ E) (π_E : E) (π_M : M)
    (res : ((IntermediateField.extendScalars (hLM.trans hME)) ≃ₐ[L]
        (IntermediateField.extendScalars (hLM.trans hME))) →*
      ((IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM)))
    (H : Finset ((IntermediateField.extendScalars (hLM.trans hME)) ≃ₐ[L]
        (IntermediateField.extendScalars (hLM.trans hME)))) :
    Function.Surjective res →
    (∀ τ, τ ∈ H ↔ res τ = 1) →
    (∀ u σ, σ ∈ lowerRamSubgroup F (hLM.trans hME) u ↔
      galApply F (hLM.trans hME) σ π_E = π_E ∨
        (u + 1 : ℤ) ≤ valL F E (galApply F (hLM.trans hME) σ π_E - π_E)) →
    (∀ σ, σ ≠ 1 →
      galApply F (hLM.trans hME) σ π_E ≠ π_E ∧
        1 ≤ valL F E (galApply F (hLM.trans hME) σ π_E - π_E)) →
    (∀ u σbar, σbar ∈ lowerRamSubgroup F hLM u ↔
      galApply F hLM σbar π_M = π_M ∨
        (u + 1 : ℤ) ≤ valL F M (galApply F hLM σbar π_M - π_M)) →
    (∀ σbar, σbar ≠ 1 →
      galApply F hLM σbar π_M ≠ π_M ∧
        1 ≤ valL F M (galApply F hLM σbar π_M - π_M)) →
    (∀ σ, res σ ≠ 1 →
      ∑ τ ∈ H, ((valL F E (galApply F (hLM.trans hME) (σ * τ) π_E - π_E)).toNat - 1) =
        H.card * ((valL F M (galApply F hLM (res σ) π_M - π_M)).toNat - 1)) →
    ∀ (u : ℕ) (σ₀ : (IntermediateField.extendScalars (hLM.trans hME)) ≃ₐ[L]
        (IntermediateField.extendScalars (hLM.trans hME))),
      σ₀ ∈ lowerRamSubgroup F (hLM.trans hME) u → res σ₀ ≠ 1 →
      ∃ ubar : ℕ, lowerRamSubgroup F hLM ubar ≠ ⊥ ∧
        herbrandSum F (hLM.trans hME) u ≤ H.card * herbrandSum F hLM ubar :=
by
  intro hres_surj hH hG_mem hG_ne hGbar_mem hGbar_ne h_coset u σ₀ hσ₀ hres_σ₀
  let hLE : L ≤ E := hLM.trans hME
  let E_L : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLE
  let M_L : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLM
  let G := E_L ≃ₐ[L] E_L
  let Gbar := M_L ≃ₐ[L] M_L
  haveI : FiniteDimensional F E_L := ‹FiniteDimensional F E›
  haveI : FiniteDimensional F M :=
    FiniteDimensional.of_injective (IntermediateField.inclusion hME).toLinearMap
      (IntermediateField.inclusion hME).injective
  haveI : FiniteDimensional F M_L := ‹FiniteDimensional F M›
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion hLM).toLinearMap
      (IntermediateField.inclusion hLM).injective
  haveI : FiniteDimensional L E_L := FiniteDimensional.right F L E_L
  haveI : FiniteDimensional L M_L := FiniteDimensional.right F L M_L
  letI : Fintype G := AlgEquiv.fintype L E_L
  letI : Fintype Gbar := AlgEquiv.fintype L M_L
  let u_G : G → ℕ := fun ρ => (valL F E (galApply F hLE ρ π_E - π_E)).toNat - 1
  let u_Gbar : Gbar → ℕ := fun ρbar => (valL F M (galApply F hLM ρbar π_M - π_M)).toNat - 1
  have hG_iff : ∀ (k : ℕ) (ρ : G), ρ ≠ 1 → (ρ ∈ lowerRamSubgroup F hLE k ↔ k ≤ u_G ρ) := by
    intro k ρ hρ
    obtain ⟨h_ne, h_ge⟩ := hG_ne ρ hρ
    rw [hG_mem k ρ]
    dsimp [u_G]
    constructor
    · rintro (h_eq | h_le)
      · exact False.elim (h_ne h_eq)
      · omega
    · intro h_le
      right
      omega
  have hGbar_iff : ∀ (j : ℕ) (ρbar : Gbar),
      ρbar ≠ 1 → (ρbar ∈ lowerRamSubgroup F hLM j ↔ j ≤ u_Gbar ρbar) := by
    intro j ρbar hρbar
    obtain ⟨h_ne, h_ge⟩ := hGbar_ne ρbar hρbar
    rw [hGbar_mem j ρbar]
    dsimp [u_Gbar]
    constructor
    · rintro (h_eq | h_le)
      · exact False.elim (h_ne h_eq)
      · omega
    · intro h_le
      right
      omega
  have hG_antitone : ∀ {k u' : ℕ}, k ≤ u' →
      ∀ {ρ : G}, ρ ∈ lowerRamSubgroup F hLE u' → ρ ∈ lowerRamSubgroup F hLE k := by
    intro k u' hku ρ hρ
    rw [hG_mem u' ρ] at hρ
    rw [hG_mem k ρ]
    rcases hρ with h_eq | h_le
    · exact Or.inl h_eq
    · exact Or.inr (by omega)
  let σbar₀ : Gbar := res σ₀
  let ubar : ℕ := u_Gbar σbar₀
  have hσbar₀_mem : σbar₀ ∈ lowerRamSubgroup F hLM ubar :=
    (hGbar_iff ubar σbar₀ hres_σ₀).mpr (le_refl ubar)
  have hubar_ne : lowerRamSubgroup F hLM ubar ≠ ⊥ := by
    intro h_bot
    rw [h_bot, Subgroup.mem_bot] at hσbar₀_mem
    exact hres_σ₀ hσbar₀_mem
  let S_G : ℕ → Finset G := fun k =>
    Finset.univ.filter (fun ρ : G => ρ ∈ lowerRamSubgroup F hLE k)
  let C : Gbar → ℕ → Finset G := fun ρbar k =>
    (S_G k).filter (fun ρ : G => res ρ = ρbar)
  let F_Gbar : Gbar → Finset ℕ := fun ρbar =>
    (Finset.Icc 1 ubar).filter (fun j : ℕ => ρbar ∈ lowerRamSubgroup F hLM j)
  have h_lhs_eq : herbrandSum F hLE u =
      ∑ ρbar ∈ (Finset.univ : Finset Gbar), ∑ k ∈ Finset.Icc 1 u, (C ρbar k).card := by
    unfold herbrandSum
    trans ∑ k ∈ Finset.Icc 1 u, ∑ ρbar ∈ (Finset.univ : Finset Gbar), (C ρbar k).card
    · refine Finset.sum_congr rfl fun k _ => ?_
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
      exact Finset.card_eq_sum_card_fiberwise (fun ρ _ => Finset.mem_univ (res ρ))
    · exact Finset.sum_comm
  have h_rhs_eq : H.card * herbrandSum F hLM ubar =
      ∑ ρbar ∈ (Finset.univ : Finset Gbar), H.card * (F_Gbar ρbar).card := by
    unfold herbrandSum
    have h1 : (∑ k ∈ Finset.Icc 1 ubar, Nat.card (lowerRamSubgroup F hLM k)) =
        ∑ ρbar ∈ (Finset.univ : Finset Gbar), (F_Gbar ρbar).card := by
      trans ∑ k ∈ Finset.Icc 1 ubar,
          ∑ ρbar ∈ (Finset.univ : Finset Gbar),
            if ρbar ∈ lowerRamSubgroup F hLM k then 1 else 0
      · refine Finset.sum_congr rfl fun k _ => ?_
        rw [Nat.card_eq_fintype_card, Fintype.card_subtype, Finset.card_filter]
      · rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun ρbar _ => ?_
        rw [← Finset.card_filter]
    rw [h1, Finset.mul_sum]
  have hC_le_C0 : ∀ (ρbar : Gbar) (k : ℕ),
      k ∈ Finset.Icc 1 u → (C ρbar k).card ≤ (C σbar₀ k).card := by
    intro ρbar k hk
    have hσ₀_k : σ₀ ∈ lowerRamSubgroup F hLE k :=
      hG_antitone (Finset.mem_Icc.mp hk).2 hσ₀
    by_cases h_nonempty : (C ρbar k).Nonempty
    · obtain ⟨ρ₁, hρ₁⟩ := h_nonempty
      have hρ₁_S : ρ₁ ∈ S_G k := (Finset.mem_filter.mp hρ₁).1
      have hρ₁_res : res ρ₁ = ρbar := (Finset.mem_filter.mp hρ₁).2
      have hρ₁_G : ρ₁ ∈ lowerRamSubgroup F hLE k := (Finset.mem_filter.mp hρ₁_S).2
      refine Finset.card_le_card_of_injOn (fun ρ : G => σ₀ * (ρ₁⁻¹ * ρ)) ?_ ?_
      · intro ρ hρ
        have hρ_S : ρ ∈ S_G k := (Finset.mem_filter.mp hρ).1
        have hρ_res : res ρ = ρbar := (Finset.mem_filter.mp hρ).2
        have hρ_G : ρ ∈ lowerRamSubgroup F hLE k := (Finset.mem_filter.mp hρ_S).2
        simp only [C, S_G, Finset.mem_coe, Finset.mem_filter, Finset.mem_univ, true_and]
        refine ⟨?_, ?_⟩
        · exact Subgroup.mul_mem _ hσ₀_k (Subgroup.mul_mem _ (Subgroup.inv_mem _ hρ₁_G) hρ_G)
        · rw [map_mul, map_mul, map_inv, hρ₁_res, hρ_res, inv_mul_cancel, mul_one]
      · intro a _ b _ hab
        exact mul_left_cancel (mul_left_cancel hab)
    · rw [Finset.not_nonempty_iff_eq_empty.mp h_nonempty, Finset.card_empty]
      exact Nat.zero_le _
  have h_fiber_sum_le : ∀ ρbar : Gbar,
      ρbar ≠ 1 → ∑ k ∈ Finset.Icc 1 u, (C ρbar k).card ≤ H.card * u_Gbar ρbar := by
    intro ρbar hρbar_ne
    obtain ⟨σ, hσ_res⟩ := hres_surj ρbar
    have hσ_ne : res σ ≠ 1 := by
      rw [hσ_res]
      exact hρbar_ne
    have h_step4a : ∀ k : ℕ,
        (C ρbar k).card ≤ (H.filter (fun τ : G => k ≤ u_G (σ * τ))).card := by
      intro k
      refine Finset.card_le_card_of_injOn (fun ρ : G => σ⁻¹ * ρ) ?_ ?_
      · intro ρ hρ
        have hρ_S : ρ ∈ S_G k := (Finset.mem_filter.mp hρ).1
        have hρ_res : res ρ = ρbar := (Finset.mem_filter.mp hρ).2
        have hρ_G : ρ ∈ lowerRamSubgroup F hLE k := (Finset.mem_filter.mp hρ_S).2
        have hρ_ne1 : ρ ≠ 1 := by
          intro h1
          rw [h1, map_one] at hρ_res
          exact hρbar_ne hρ_res.symm
        simp only [Finset.mem_coe, Finset.mem_filter]
        refine ⟨?_, ?_⟩
        · rw [hH, map_mul, map_inv, hσ_res, hρ_res, inv_mul_cancel]
        · rw [mul_inv_cancel_left]
          exact (hG_iff k ρ hρ_ne1).mp hρ_G
      · intro a _ b _ hab
        exact mul_left_cancel hab
    have h_swap : (∑ k ∈ Finset.Icc 1 u, (H.filter (fun τ : G => k ≤ u_G (σ * τ))).card) =
        ∑ τ ∈ H, ((Finset.Icc 1 u).filter (fun k : ℕ => k ≤ u_G (σ * τ))).card := by
      trans ∑ k ∈ Finset.Icc 1 u, ∑ τ ∈ H, if k ≤ u_G (σ * τ) then 1 else 0
      · refine Finset.sum_congr rfl fun k _ => Finset.card_filter _ _
      · rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun τ _ => (Finset.card_filter _ _).symm
    have h_step4c : ∀ τ ∈ H,
        ((Finset.Icc 1 u).filter (fun k : ℕ => k ≤ u_G (σ * τ))).card ≤ u_G (σ * τ) := by
      intro τ _
      have h_sub : (Finset.Icc 1 u).filter (fun k : ℕ => k ≤ u_G (σ * τ)) ⊆
          Finset.Icc 1 (u_G (σ * τ)) := by
        intro k hk
        simp only [Finset.mem_filter, Finset.mem_Icc] at hk ⊢
        exact ⟨hk.1.1, hk.2⟩
      calc ((Finset.Icc 1 u).filter (fun k : ℕ => k ≤ u_G (σ * τ))).card
          ≤ (Finset.Icc 1 (u_G (σ * τ))).card := Finset.card_le_card h_sub
        _ = u_G (σ * τ) + 1 - 1 := Nat.card_Icc 1 (u_G (σ * τ))
        _ = u_G (σ * τ) := by omega
    calc ∑ k ∈ Finset.Icc 1 u, (C ρbar k).card
        ≤ ∑ k ∈ Finset.Icc 1 u, (H.filter (fun τ : G => k ≤ u_G (σ * τ))).card :=
          Finset.sum_le_sum fun k _ => h_step4a k
      _ = ∑ τ ∈ H, ((Finset.Icc 1 u).filter (fun k : ℕ => k ≤ u_G (σ * τ))).card := h_swap
      _ ≤ ∑ τ ∈ H, u_G (σ * τ) := Finset.sum_le_sum h_step4c
      _ = H.card * u_Gbar (res σ) := h_coset σ hσ_ne
      _ = H.card * u_Gbar ρbar := by rw [hσ_res]
  refine ⟨ubar, hubar_ne, ?_⟩
  rw [h_lhs_eq, h_rhs_eq]
  refine Finset.sum_le_sum fun ρbar _ => ?_
  have h_le_ubar : ∑ k ∈ Finset.Icc 1 u, (C ρbar k).card ≤ H.card * ubar := by
    calc ∑ k ∈ Finset.Icc 1 u, (C ρbar k).card
        ≤ ∑ k ∈ Finset.Icc 1 u, (C σbar₀ k).card :=
          Finset.sum_le_sum fun k hk => hC_le_C0 ρbar k hk
      _ ≤ H.card * ubar := h_fiber_sum_le σbar₀ hres_σ₀
  by_cases h_case : ρbar = 1 ∨ ubar ≤ u_Gbar ρbar
  · have h_sub : Finset.Icc 1 ubar ⊆ F_Gbar ρbar := by
      intro j hj
      simp only [F_Gbar, Finset.mem_filter, Finset.mem_Icc] at hj ⊢
      refine ⟨hj, ?_⟩
      rcases eq_or_ne ρbar 1 with rfl | h1
      · exact Subgroup.one_mem _
      · have hubar_le : ubar ≤ u_Gbar ρbar := h_case.resolve_left h1
        exact (hGbar_iff j ρbar h1).mpr (le_trans hj.2 hubar_le)
    have h_card : ubar ≤ (F_Gbar ρbar).card := by
      calc ubar = ubar + 1 - 1 := by omega
        _ = (Finset.Icc 1 ubar).card := (Nat.card_Icc 1 ubar).symm
        _ ≤ (F_Gbar ρbar).card := Finset.card_le_card h_sub
    exact le_trans h_le_ubar (Nat.mul_le_mul_left H.card h_card)
  · push_neg at h_case
    rcases h_case with ⟨hρbar_ne, h_lt⟩
    have h_sub : Finset.Icc 1 (u_Gbar ρbar) ⊆ F_Gbar ρbar := by
      intro j hj
      simp only [F_Gbar, Finset.mem_filter, Finset.mem_Icc] at hj ⊢
      refine ⟨⟨hj.1, by omega⟩, ?_⟩
      exact (hGbar_iff j ρbar hρbar_ne).mpr hj.2
    have h_card : u_Gbar ρbar ≤ (F_Gbar ρbar).card := by
      calc u_Gbar ρbar = u_Gbar ρbar + 1 - 1 := by omega
        _ = (Finset.Icc 1 (u_Gbar ρbar)).card := (Nat.card_Icc 1 (u_Gbar ρbar)).symm
        _ ≤ (F_Gbar ρbar).card := Finset.card_le_card h_sub
    exact le_trans (h_fiber_sum_le ρbar hρbar_ne) (Nat.mul_le_mul_left H.card h_card)

theorem herbrandSum_sup_lt_of_lt (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L M₁ M₂ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F ↥(M₁ ⊔ M₂)] (h₁ : L ≤ M₁) (h₂ : L ≤ M₂)
    (hab : IsAbelianExt F (h₁.trans (le_sup_left : M₁ ≤ M₁ ⊔ M₂)))
    (hres : resDeg F (M₁ ⊔ M₂) = resDeg F L) (n : ℕ) (hn : 1 ≤ n) :
    (∀ u : ℕ, lowerRamSubgroup F h₁ u ≠ ⊥ →
      herbrandSum F h₁ u < n * Module.finrank L (IntermediateField.extendScalars h₁)) →
    (∀ u : ℕ, lowerRamSubgroup F h₂ u ≠ ⊥ →
      herbrandSum F h₂ u < n * Module.finrank L (IntermediateField.extendScalars h₂)) →
    ∀ u : ℕ, lowerRamSubgroup F (h₁.trans (le_sup_left : M₁ ≤ M₁ ⊔ M₂)) u ≠ ⊥ →
      herbrandSum F (h₁.trans (le_sup_left : M₁ ≤ M₁ ⊔ M₂)) u <
        n * Module.finrank L
          (IntermediateField.extendScalars (h₁.trans (le_sup_left : M₁ ≤ M₁ ⊔ M₂))) :=
by
  intro hM₁ hM₂ u hu
  set E : IntermediateField F (AlgebraicClosure F) := M₁ ⊔ M₂
  set hLE : L ≤ E := h₁.trans (le_sup_left : M₁ ≤ M₁ ⊔ M₂)
  have h_tower : ∀ (M : IntermediateField F (AlgebraicClosure F)) (hLM : L ≤ M) (hME : M ≤ E),
      (∀ v : ℕ, lowerRamSubgroup F hLM v ≠ ⊥ →
        herbrandSum F hLM v < n * Module.finrank L (IntermediateField.extendScalars hLM)) →
      ∀ σ₀ ∈ lowerRamSubgroup F (hLM.trans hME) u,
        (∃ y : M, galApply F (hLM.trans hME) σ₀ (IntermediateField.inclusion hME y) ≠
          IntermediateField.inclusion hME y) →
        herbrandSum F (hLM.trans hME) u <
          n * Module.finrank L (IntermediateField.extendScalars (hLM.trans hME)) := by
    intro M hLM hME hM_bound σ₀ hσ₀ ⟨y₀, hy₀⟩
    have hab' : IsAbelianExt F (hLM.trans hME) := hab
    set π_E : E := (chosenUniformizer F E : E)
    have hπ_E : valL F E π_E = 1 := (valL_chosenUniformizer_and_mul_zpow F E 1).1
    have h_lift_E := exists_mem_valL_sub_ge_one_of_resDeg_eq F L E (hLM.trans hME) hres
    obtain ⟨hG_mem, hG_ne_full⟩ :=
      (mem_lowerRamSubgroup_iff_and_of_valL_eq_one F L E (hLM.trans hME)).2 h_lift_E π_E hπ_E
    have hπ_inj : ∀ τ, galApply F (hLM.trans hME) τ π_E = π_E → τ = 1 :=
      fun τ hτ => by_contra fun hne => (hG_ne_full τ hne).1 hτ
    have hG_ne : ∀ σ, σ ≠ 1 →
        galApply F (hLM.trans hME) σ π_E ≠ π_E ∧
          1 ≤ valL F E (galApply F (hLM.trans hME) σ π_E - π_E) :=
      fun σ hσ => ⟨(hG_ne_full σ hσ).1, (hG_ne_full σ hσ).2.1⟩
    obtain ⟨hres_M, res, H, P_M, hres_surj, hH, hres_comm, h_finrank_eq, h_val_scale,
      hPM_monic, hPM_deg, hPM_prod⟩ :=
      exists_surjective_galRestrict_and_prod_eq_map_minpoly F L M E hLM hME hab' hres π_E hπ_inj
    haveI : FiniteDimensional F M :=
      FiniteDimensional.of_injective (IntermediateField.inclusion hME).toLinearMap
        (IntermediateField.inclusion hME).injective
    have h_lift_M := exists_mem_valL_sub_ge_one_of_resDeg_eq F L M hLM hres_M
    have hM_ram : ∀ (π_M : M), valL F M π_M = 1 →
        ∀ σbar : (IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM),
          σbar ≠ 1 → galApply F hLM σbar π_M ≠ π_M ∧
            1 ≤ valL F M (galApply F hLM σbar π_M - π_M) ∧
            ∀ b : M, (b = 0 ∨ 0 ≤ valL F M b) →
              galApply F hLM σbar b = b ∨
                valL F M (galApply F hLM σbar π_M - π_M) ≤ valL F M (galApply F hLM σbar b - b) :=
      fun π_M hπ_M => ((mem_lowerRamSubgroup_iff_and_of_valL_eq_one F L M hLM).2 h_lift_M π_M hπ_M).2
    obtain ⟨hπ_M, h_coset⟩ :=
      sum_valL_galApply_sub_eq_card_ker_mul_valL_sub F L M E hLM hME π_E hπ_E res H P_M
        hH hres_comm h_val_scale hG_ne hM_ram hPM_monic hPM_deg hPM_prod
    obtain ⟨hGbar_mem, hGbar_ne_full⟩ :=
      (mem_lowerRamSubgroup_iff_and_of_valL_eq_one F L M hLM).2 h_lift_M (P_M.coeff 0) hπ_M
    have hGbar_ne : ∀ σbar, σbar ≠ 1 →
        galApply F hLM σbar (P_M.coeff 0) ≠ P_M.coeff 0 ∧
          1 ≤ valL F M (galApply F hLM σbar (P_M.coeff 0) - P_M.coeff 0) :=
      fun σbar hσbar => ⟨(hGbar_ne_full σbar hσbar).1, (hGbar_ne_full σbar hσbar).2.1⟩
    have hres_σ₀ : res σ₀ ≠ 1 := by
      intro h1
      have heq := hres_comm σ₀ y₀
      rw [h1] at heq
      have h1_apply : galApply F hLM 1 y₀ = y₀ := by
        ext
        rfl
      rw [h1_apply] at heq
      exact hy₀ heq
    obtain ⟨ubar, hubar_ne, h_sum_le⟩ :=
      herbrandSum_le_card_ker_mul_herbrandSum F L M E hLM hME π_E (P_M.coeff 0) res H
        hres_surj hH hG_mem hG_ne hGbar_mem hGbar_ne h_coset u σ₀ hσ₀ hres_σ₀
    have h1_mem : (1 : _) ∈ H := (hH 1).mpr (map_one res)
    have hH_pos : 0 < H.card := Finset.card_pos.mpr ⟨1, h1_mem⟩
    have h_lt := Nat.mul_lt_mul_of_pos_left (hM_bound ubar hubar_ne) hH_pos
    calc herbrandSum F (hLM.trans hME) u
        ≤ H.card * herbrandSum F hLM ubar := h_sum_le
      _ < H.card * (n * Module.finrank L (IntermediateField.extendScalars hLM)) := h_lt
      _ = n * (H.card * Module.finrank L (IntermediateField.extendScalars hLM)) := by ring
      _ = n * Module.finrank L (IntermediateField.extendScalars (hLM.trans hME)) := by
        rw [h_finrank_eq]
  obtain ⟨⟨σ₀, hσ₀_mem⟩, hσ₀_ne'⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hu
  have hσ₀_ne : σ₀ ≠ 1 := fun h => hσ₀_ne' (Subtype.ext h)
  have h_move :
      (∃ y : M₁, galApply F hLE σ₀ (IntermediateField.inclusion le_sup_left y) ≠
        IntermediateField.inclusion le_sup_left y) ∨
      (∃ y : M₂, galApply F hLE σ₀ (IntermediateField.inclusion le_sup_right y) ≠
        IntermediateField.inclusion le_sup_right y) := by
    by_contra! h_fix
    rcases h_fix with ⟨h_fix₁, h_fix₂⟩
    let K_fix : IntermediateField F (AlgebraicClosure F) :=
      { carrier := {w : AlgebraicClosure F | ∃ hw : w ∈ E,
          (galApply F hLE σ₀ ⟨w, hw⟩ : AlgebraicClosure F) = w}
        add_mem' := by
          intro a b ⟨ha, ha_eq⟩ ⟨hb, hb_eq⟩
          refine ⟨E.add_mem ha hb, ?_⟩
          change (σ₀ (⟨a, (IntermediateField.mem_extendScalars hLE).mpr ha⟩ +
            ⟨b, (IntermediateField.mem_extendScalars hLE).mpr hb⟩)).1 = a + b
          rw [map_add]
          exact congrArg₂ (· + ·) ha_eq hb_eq
        zero_mem' := by
          refine ⟨E.zero_mem, ?_⟩
          change (σ₀ 0).1 = 0
          rw [map_zero]
          rfl
        mul_mem' := by
          intro a b ⟨ha, ha_eq⟩ ⟨hb, hb_eq⟩
          refine ⟨E.mul_mem ha hb, ?_⟩
          change (σ₀ (⟨a, (IntermediateField.mem_extendScalars hLE).mpr ha⟩ *
            ⟨b, (IntermediateField.mem_extendScalars hLE).mpr hb⟩)).1 = a * b
          rw [map_mul]
          exact congrArg₂ (· * ·) ha_eq hb_eq
        one_mem' := by
          refine ⟨E.one_mem, ?_⟩
          change (σ₀ 1).1 = 1
          rw [map_one]
          rfl
        inv_mem' := by
          intro a ⟨ha, ha_eq⟩
          refine ⟨E.inv_mem ha, ?_⟩
          change (σ₀ (⟨a, (IntermediateField.mem_extendScalars hLE).mpr ha⟩⁻¹)).1 = a⁻¹
          rw [map_inv₀]
          exact congrArg Inv.inv ha_eq
        algebraMap_mem' := by
          intro r
          have hrL : algebraMap F (AlgebraicClosure F) r ∈ L := L.algebraMap_mem r
          have hrE : algebraMap F (AlgebraicClosure F) r ∈ E := hLE hrL
          refine ⟨hrE, ?_⟩
          change (σ₀ (algebraMap L (IntermediateField.extendScalars hLE)
            ⟨algebraMap F (AlgebraicClosure F) r, hrL⟩)).1 = algebraMap F (AlgebraicClosure F) r
          rw [AlgEquiv.commutes]
          rfl }
    have hM₁_le : M₁ ≤ K_fix := by
      intro w hw
      refine ⟨(le_sup_left : M₁ ≤ M₁ ⊔ M₂) hw, ?_⟩
      exact congrArg Subtype.val (h_fix₁ ⟨w, hw⟩)
    have hM₂_le : M₂ ≤ K_fix := by
      intro w hw
      refine ⟨(le_sup_right : M₂ ≤ M₁ ⊔ M₂) hw, ?_⟩
      exact congrArg Subtype.val (h_fix₂ ⟨w, hw⟩)
    have hE_le : E ≤ K_fix := sup_le hM₁_le hM₂_le
    apply hσ₀_ne
    ext ⟨w, hw⟩
    have hwE : w ∈ E := (IntermediateField.mem_extendScalars hLE).mp hw
    obtain ⟨_, hw_eq⟩ := hE_le hwE
    exact hw_eq
  rcases h_move with h₁_move | h₂_move
  · exact h_tower M₁ h₁ le_sup_left hM₁ σ₀ hσ₀_mem h₁_move
  · exact h_tower M₂ h₂ le_sup_right hM₂ σ₀ hσ₀_mem h₂_move

theorem card_lowerRamSubgroup_zero_and_succ_le (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E] (hLE : L ≤ E) :
    IsAbelianExt F hLE → resDeg F E = resDeg F L →
    ∀ (π_E : E), valL F E π_E = 1 →
    (∀ (x : E), (x = 0 ∨ 0 ≤ valL F E x) →
      ∃ c : L, (c = 0 ∨ 0 ≤ valL F L c) ∧
        (x - IntermediateField.inclusion hLE c = 0 ∨
          1 ≤ valL F E (x - IntermediateField.inclusion hLE c))) →
    (∀ (u : ℕ) (σ : (IntermediateField.extendScalars hLE) ≃ₐ[L] (IntermediateField.extendScalars hLE)),
      σ ∈ lowerRamSubgroup F hLE u ↔
        galApply F hLE σ π_E = π_E ∨ (u + 1 : ℤ) ≤ valL F E (galApply F hLE σ π_E - π_E)) →
    Nat.card (lowerRamSubgroup F hLE 0) = Module.finrank L (IntermediateField.extendScalars hLE) ∧
    Nat.card (lowerRamSubgroup F hLE 0) ≤ (qL F L - 1) * Nat.card (lowerRamSubgroup F hLE 1) ∧
    (∀ u : ℕ, 1 ≤ u →
      Nat.card (lowerRamSubgroup F hLE u) ≤ qL F L * Nat.card (lowerRamSubgroup F hLE (u + 1))) :=
by
  intro hab hres π_E hπ_E h_lift hG_mem
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion hLE).toLinearMap
      (IntermediateField.inclusion hLE).injective
  let E_L := IntermediateField.extendScalars hLE
  let G := ↥E_L ≃ₐ[↥L] ↥E_L
  let d := Module.finrank ↥L ↥E_L
  haveI : FiniteDimensional F ↥E_L := ‹FiniteDimensional F E›
  haveI : FiniteDimensional ↥L ↥E_L := FiniteDimensional.right F ↥L ↥E_L
  letI : Fintype G := AlgEquiv.fintype ↥L ↥E_L
  have hd_pos : 1 ≤ d := Nat.succ_le_of_lt (Module.finrank_pos (R := ↥L) (M := ↥E_L))
  let ϖ_L : Lˣ := chosenUniformizer F L
  let ϖ_E : Eˣ := chosenUniformizer F E
  have hϖ_L : valL F L ϖ_L = 1 := (valL_chosenUniformizer_and_mul_zpow F L 1).1
  have hϖ_E : valL F E ϖ_E = 1 := (valL_chosenUniformizer_and_mul_zpow F E 1).1
  have hres_L_ne : resDeg F L ≠ 0 := by
    intro h0
    have h1 : valL F L ϖ_L = 0 := by
      unfold valL
      rw [h0, Nat.cast_zero, Int.ediv_zero]
    omega
  have hres_L_pos : 0 < resDeg F L := Nat.pos_of_ne_zero hres_L_ne
  have hres_E_pos : 0 < resDeg F E := by omega
  have hq_gt : 1 < q F := by
    unfold q
    exact Finite.one_lt_card
  have hqL_gt : 1 < qL F L := by
    unfold qL
    exact one_lt_pow₀ hq_gt hres_L_ne
  have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom_L : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_L_apply : ∀ u : Lˣ, Multiplicative.toAdd (relValHom_L u) = relVal F L u :=
    fun _ => rfl
  have relVal_L_units_mul : ∀ u v : Lˣ,
      relVal F L ((u * v : Lˣ) : L) = relVal F L u + relVal F L v := by
    intro u v
    rw [← relValHom_L_apply, map_mul, toAdd_mul, relValHom_L_apply, relValHom_L_apply]
  have relVal_L_units_zpow : ∀ (u : Lˣ) (m : ℤ),
      relVal F L ((u ^ m : Lˣ) : L) = m * relVal F L u := by
    intro u m
    rw [← relValHom_L_apply, map_zpow, toAdd_zpow, relValHom_L_apply, zsmul_eq_mul]
    rfl
  have relVal_L_mul : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      relVal F L (x * y) = relVal F L x + relVal F L y := by
    intro x y hx hy
    exact relVal_L_units_mul (Units.mk0 x hx) (Units.mk0 y hy)
  have relVal_L_eq : ∀ {x : L} (hx : x ≠ 0), relVal F L x = (resDeg F L : ℤ) * valL F L x :=
    fun hx => relVal_eq_resDeg_mul_valL F L (Units.mk0 _ hx)
  have valL_L_mul : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      valL F L (x * y) = valL F L x + valL F L y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    have h := relVal_L_mul hx hy
    rw [relVal_L_eq hxy, relVal_L_eq hx, relVal_L_eq hy, ← mul_add] at h
    exact mul_left_cancel₀ (by positivity) h
  have valL_L_one : valL F L 1 = 0 := by
    have h1 : (1 : L) ≠ 0 := one_ne_zero
    have h := valL_L_mul h1 h1
    rw [mul_one] at h
    omega
  have valL_L_units_zpow : ∀ (u : Lˣ) (m : ℤ),
      valL F L ((u ^ m : Lˣ) : L) = m * valL F L u := by
    intro u m
    have h := relVal_L_units_zpow u m
    rw [relVal_L_eq (Units.ne_zero _), relVal_L_eq (Units.ne_zero _), ← mul_left_comm] at h
    exact mul_left_cancel₀ (by positivity) h
  let relValHom_E : Eˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_E_apply : ∀ u : Eˣ, Multiplicative.toAdd (relValHom_E u) = relVal F E u :=
    fun _ => rfl
  have relVal_E_units_mul : ∀ u v : Eˣ,
      relVal F E ((u * v : Eˣ) : E) = relVal F E u + relVal F E v := by
    intro u v
    rw [← relValHom_E_apply, map_mul, toAdd_mul, relValHom_E_apply, relValHom_E_apply]
  have relVal_E_units_zpow : ∀ (u : Eˣ) (m : ℤ),
      relVal F E ((u ^ m : Eˣ) : E) = m * relVal F E u := by
    intro u m
    rw [← relValHom_E_apply, map_zpow, toAdd_zpow, relValHom_E_apply, zsmul_eq_mul]
    rfl
  have relVal_E_mul : ∀ {x y : E} (hx : x ≠ 0) (hy : y ≠ 0),
      relVal F E (x * y) = relVal F E x + relVal F E y := by
    intro x y hx hy
    exact relVal_E_units_mul (Units.mk0 x hx) (Units.mk0 y hy)
  have relVal_E_eq : ∀ {x : E} (hx : x ≠ 0), relVal F E x = (resDeg F E : ℤ) * valL F E x :=
    fun hx => relVal_eq_resDeg_mul_valL F E (Units.mk0 _ hx)
  have valL_E_mul : ∀ {x y : E} (hx : x ≠ 0) (hy : y ≠ 0),
      valL F E (x * y) = valL F E x + valL F E y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    have h := relVal_E_mul hx hy
    rw [relVal_E_eq hxy, relVal_E_eq hx, relVal_E_eq hy, ← mul_add] at h
