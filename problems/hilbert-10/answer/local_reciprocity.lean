      relVal F L (algebraMap F L c) = (Module.finrank F L : ℤ) * addVal F c := by
    intro c hc
    have hnorm : Algebra.norm F (algebraMap F L c) = c ^ Module.finrank F L :=
      Algebra.norm_algebraMap c
    have hpow : addVal F (c ^ Module.finrank F L) =
