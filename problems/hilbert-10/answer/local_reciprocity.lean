            · exact combine_ge (Or.inr (by omega))
  intro n₀
  induction n₀ with
  | zero =>
    intro _ _ _ k hk1 hk0
    omega
  | succ n₀ ih =>
    intro τ h_w0 h_ne_succ k hk1 hk_le
    have h_pow_ne_and_ge := h_pow_step (n₀ + 1) τ h_w0 h_ne_succ
    have h_ne_n0 : τ ^ ((p F) ^ n₀) ≠ 1 := (h_pow_ne_and_ge n₀ (by omega)).1
    rcases Nat.lt_or_eq_of_le hk_le with hk_lt | rfl
    · exact ih τ h_w0 h_ne_n0 k hk1 (by omega)
    · set I : ℕ → ℤ := fun a => valL F M (galApply F hLM (τ ^ ((p F) ^ a)) π_M - π_M) - 1
      have h_diff_eq : valL F M (galApply F hLM (τ ^ ((p F) ^ (n₀ + 1))) π_M - π_M) -
          valL F M (galApply F hLM (τ ^ ((p F) ^ (n₀ + 1 - 1))) π_M - π_M) =
          I (n₀ + 1) - I n₀ := by
