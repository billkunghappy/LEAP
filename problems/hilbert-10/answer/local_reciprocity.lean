          exact hj_ne (Fin.ext (Int.ofNat.inj hmod))
        omega
      have h_sum_T : ∑ j ∈ T, t j = 0 := by
        rw [← h_sum_s]
        refine Finset.sum_subset (Finset.subset_univ T) fun j _ hjT => ?_
        have hsj0 : s j = 0 := by
          by_contra hsj
          exact hjT (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hsj⟩)
        simp [t, hsj0]
      have h_erase_sum : ∑ j ∈ T.erase j₀, t j = -t j₀ := by
        have h := Finset.add_sum_erase T t hj₀T
        rw [h_sum_T] at h
        linear_combination h
      have h_div_sum_int : IsIntegral 𝒪[F]
          (∑ j ∈ T.erase j₀, ((t j / t j₀) / πE)) := by
        refine (integralClosure 𝒪[F] E).sum_mem fun j hj => ?_
        have hjT : j ∈ T := (Finset.mem_erase.mp hj).2
        have h_ne1 : t j / t j₀ ≠ 0 := div_ne_zero (ht_ne j hjT) (ht_ne j₀ hj₀T)
        have h_ne2 : (t j / t j₀) / πE ≠ 0 := div_ne_zero h_ne1 hπE_ne
        change IsIntegral 𝒪[F] ((t j / t j₀) / πE)
        rw [h_int_valL h_ne2, valL_div h_ne1 hπE_ne, valL_div (ht_ne j hjT) (ht_ne j₀ hj₀T), hπ_val]
        have hlt := h_strict j hj
        omega
      have h_sum_eq : (∑ j ∈ T.erase j₀, ((t j / t j₀) / πE)) = (-1 : E) / πE := by
        rw [← Finset.sum_div, ← Finset.sum_div, h_erase_sum, neg_div,
          div_self (ht_ne j₀ hj₀T)]
      rw [h_sum_eq] at h_div_sum_int
      have h_neg1_ne : (-1 : E) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have h_neg1_val : valL F E (-1 : E) = 0 := by
        have hsq : valL F E ((-1 : E) * (-1 : E)) = valL F E (-1 : E) + valL F E (-1 : E) :=
          valL_mul h_neg1_ne h_neg1_ne
        rw [neg_mul_neg, mul_one, valL_one] at hsq
        omega
      have h_contra := (h_int_valL (div_ne_zero h_neg1_ne hπE_ne)).mp h_div_sum_int
      rw [valL_div h_neg1_ne hπE_ne, h_neg1_val, hπ_val] at h_contra
      omega
    intro ⟨i, j⟩
    by_contra hcij
    obtain ⟨hne, -⟩ := h_comb (fun i' => c (i', j)) ⟨i, hcij⟩
    exact hne (hs_all_zero j)
  let V : Submodule F E := Submodule.span F (Set.range B)
  have h_m_step : ∀ (m : ℕ), m ≤ e → ∀ x : E, IsIntegral 𝒪[F] x →
      ∃ v ∈ V, ∃ z : E, IsIntegral 𝒪[F] z ∧ x = v + πE ^ m * z := by
    intro m
    induction m with
    | zero =>
      intro _ x hx
      exact ⟨0, V.zero_mem, x, hx, by simp⟩
    | succ m ih =>
      intro hm x hx
