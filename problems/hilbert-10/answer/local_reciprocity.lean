      · dsimp [relColemanTheta]
        have h0 : (Polynomial.C ε * Polynomial.X).coeff 0 = 0 := by
          rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_zero, mul_zero]
        have h1 : (Polynomial.C ε * Polynomial.X).coeff 1 = ε := by
          rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_one, mul_one]
        have hgt : ∀ k > 1, (Polynomial.C ε * Polynomial.X).coeff k = 0 := by
