by
  let bareCompanion {K : Type u} [Field K] (q : ℕ) (ϖ : K) :
      Matrix (Fin q) (Fin q) (Polynomial K) :=
    fun j i =>
      if (i : ℕ) + 1 < q then
        if (j : ℕ) = (i : ℕ) + 1 then 1 else 0
      else
        if (j : ℕ) = 0 then Polynomial.X
        else if (j : ℕ) = 1 then -Polynomial.C ϖ
        else 0
  have h_base_companion : ∀ (K Ω : Type u) [Field K] [Field Ω] [Algebra K Ω]
