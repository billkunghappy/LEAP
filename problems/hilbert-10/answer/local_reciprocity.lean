      h_comp_ltPoly_sub_X_pow Sunram h_vpi_mem h_vpi_div hτψ
    exact polyDivMem_sub Sunram πbar
      (polyDivMem_add Sunram πbar h_comp1 (h_frob_sub_pow_unram hψ))
      (polyDivMem_C_mul Sunram πbar h_pi_div hψ)
  have h_master_semi : ∀ (m : ℕ) {ψ ϕ : Polynomial (AlgebraicClosure F)},
      ψ.coeff 0 = 0 → ϕ.coeff 0 = 0 → (∀ k ≤ m, (ψ - ϕ).coeff k = 0) →
      (∀ k ≤ m,
        (((ψ.map (τ : AlgebraicClosure F →+* AlgebraicClosure F)).comp f₀_poly) -
          fπ.comp ψ).coeff k =
        (((ϕ.map (τ : AlgebraicClosure F →+* AlgebraicClosure F)).comp f₀_poly) -
          fπ.comp ϕ).coeff k) ∧
      ((((ψ.map (τ : AlgebraicClosure F →+* AlgebraicClosure F)).comp f₀_poly) -
          fπ.comp ψ).coeff (m + 1) =
        (((ϕ.map (τ : AlgebraicClosure F →+* AlgebraicClosure F)).comp f₀_poly) -
          fπ.comp ϕ).coeff (m + 1) +
        (v_bar * πbar) ^ (m + 1) * τ ((ψ - ϕ).coeff (m + 1)) -
        πbar * (ψ - ϕ).coeff (m + 1)) := by
    intro m ψ ϕ hψ0 hϕ0 hD_le
    set D := ψ - ϕ
    set τψ := ψ.map (τ : AlgebraicClosure F →+* AlgebraicClosure F)
