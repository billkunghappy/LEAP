    rcases h_val_props with ⟨hf_pos, h_int_valL, valL_div, valL_one, hp_div_L⟩
    have hqL_pow : ∃ n : ℕ, 1 ≤ n ∧ Nat.Prime (p F) ∧ qL F L = (p F) ^ n := by
