    rw [Finset.card_univ, Fintype.card_fin q] at h
    rw [h_prod_eq]
    exact h
  have h_det_split : N.det = (∏ i : Fin q, N i i) +
      ∑ σ ∈ (Finset.univ : Finset (Equiv.Perm (Fin q))).erase 1,
        Equiv.Perm.sign σ • ∏ i : Fin q, N (σ i) i := by
    rw [Matrix.det_apply,
      ← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ (1 : Equiv.Perm (Fin q)))]
    simp
  have h_s4 : polyDivPow (2 * k)
      (N.det - (c ^ q + Polynomial.C (π ^ k) * c ^ (q - 1) * Matrix.trace H₀)) := by
    have h_eq : N.det - (c ^ q + Polynomial.C (π ^ k) * c ^ (q - 1) * Matrix.trace H₀) =
        ((∏ i : Fin q, N i i) - (c ^ q + Polynomial.C (π ^ k) * c ^ (q - 1) * Matrix.trace H₀)) +
