  have h_s4_k1 : polyDivPow (k + 1)
      (N.det - (c ^ q + Polynomial.C (π ^ k) * c ^ (q - 1) * Matrix.trace H₀)) :=
    polyDivPow_mono (by omega : k + 1 ≤ 2 * k) h_s4
  have h_Ck_s5 : polyDivPow (k + 1)
      (Polynomial.C (π ^ k) * (c ^ (q - 1) * Matrix.trace H₀)) :=
    polyDivPow_mul (polyDivPow_C_pow k) h_s5
  have h_cNA_sub : polyDivPow (k + 1) (c ^ (q - 1) * (N_A - c)) := by
    have h_cq : c ^ q = c ^ (q - 1) * c := by
      conv_lhs => rw [← Nat.sub_add_cancel hq1, pow_succ]
    have h_alg : c ^ (q - 1) * (N_A - c) =
        (N.det - (c ^ q + Polynomial.C (π ^ k) * c ^ (q - 1) * Matrix.trace H₀)) +
        Polynomial.C (π ^ k) * (c ^ (q - 1) * Matrix.trace H₀) := by
      rw [← h_det_N, h_cq]
      ring
    rw [h_alg]
    exact polyDivPow_add h_s4_k1 h_Ck_s5
  
  let U : Polynomial E₀ := c ^ (q - 1)
  let W : Polynomial E₀ := N_A - c
  have hU_div : polyDivPow 0 U := polyDivPow_pow hc_div (q - 1)
  have hU_coeff : ∀ j : ℕ, IsIntegral 𝒪[F] (U.coeff j) := by
    intro j
    have h := hU_div j
    rwa [pow_zero, div_one] at h
  have hU0_eq : U.coeff 0 = (c.coeff 0) ^ (q - 1) := by
    rw [Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_pow,
      ← Polynomial.coeff_zero_eq_eval_zero]
  have hU0_ne : U.coeff 0 ≠ 0 := by
    rw [hU0_eq]
    exact pow_ne_zero (q - 1) hc0_ne
  let c0_u : E₀ˣ := Units.mk0 (c.coeff 0) hc0_ne
  let U0_inv_u : E₀ˣ := (c0_u ^ ((q - 1 : ℕ) : ℤ))⁻¹
  have hU0_inv_coe : (U0_inv_u : E₀) = (U.coeff 0)⁻¹ := by
    rw [hU0_eq, Units.val_inv_eq_inv_val, zpow_natCast, Units.val_pow_eq_pow_val]
    rfl
  have hU0_inv_val : valL F E₀ (U.coeff 0)⁻¹ = 0 := by
    rw [← hU0_inv_coe, valL_E₀_inv, valL_E₀_zpow, show valL F E₀ c0_u = 0 from hc0_val,
      mul_zero, neg_zero]
  have hU0_inv_int : IsIntegral 𝒪[F] (U.coeff 0)⁻¹ := by
    have h := (h_div_iff 0 (U.coeff 0)⁻¹).mp (Or.inr (by rw [hU0_inv_val]; omega))
    simpa using h
  have hW_div : polyDivPow (k + 1) W := by
    intro i
    induction i using Nat.strong_induction_on with
    | h i ih =>
      have h_mem0 : (0, i) ∈ Finset.antidiagonal i :=
        Finset.mem_antidiagonal.mpr (zero_add i)
      have h_coeff_UW : (U * W).coeff i =
          U.coeff 0 * W.coeff i +
          ∑ x ∈ (Finset.antidiagonal i).erase (0, i), U.coeff x.1 * W.coeff x.2 := by
        rw [Polynomial.coeff_mul,
          ← Finset.add_sum_erase (Finset.antidiagonal i) _ h_mem0]
      have h_sum_div :
          (∑ x ∈ (Finset.antidiagonal i).erase (0, i), U.coeff x.1 * W.coeff x.2) / π ^ (k + 1) =
          ∑ x ∈ (Finset.antidiagonal i).erase (0, i),
            U.coeff x.1 * (W.coeff x.2 / π ^ (k + 1)) := by
        rw [Finset.sum_div]
        refine Finset.sum_congr rfl (fun x _ => ?_)
        rw [mul_div_assoc]
      have h_div_UW : U.coeff 0 * (W.coeff i / π ^ (k + 1)) =
          (U * W).coeff i / π ^ (k + 1) -
          ∑ x ∈ (Finset.antidiagonal i).erase (0, i),
            U.coeff x.1 * (W.coeff x.2 / π ^ (k + 1)) := by
        rw [h_coeff_UW, add_div, mul_div_assoc, h_sum_div, add_sub_cancel_right]
      have h_sum_erase_int : IsIntegral 𝒪[F]
          (∑ x ∈ (Finset.antidiagonal i).erase (0, i),
            U.coeff x.1 * (W.coeff x.2 / π ^ (k + 1))) := by
        have h_each : ∀ x ∈ (Finset.antidiagonal i).erase (0, i),
            IsIntegral 𝒪[F] (U.coeff x.1 * (W.coeff x.2 / π ^ (k + 1))) := by
