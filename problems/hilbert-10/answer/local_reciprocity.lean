    intro R _ A hA0 e
    induction e with
    | zero =>
      intro k hk
      omega
    | succ e ih =>
      intro k hk
      rw [pow_succ, Polynomial.coeff_mul]
      refine Finset.sum_eq_zero fun x hx => ?_
