      rw [Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_zero,
        Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_zero,
        hH₀, hH₁, hA_zero, hB_zero, pow_one, pow_one]
      ring
    | succ d ih =>
      obtain ⟨ihA, ihB, ih_eq⟩ := ih
      refine ⟨?_, ?_, ?_⟩
      · rw [hA_succ]
        exact IsIntegral.add ihA (IsIntegral.mul (hH_int (d + 2)) (hq_int (d + 1)))
      · rw [hB_succ]
        exact IsIntegral.add ihB (IsIntegral.mul (hH_int (d + 2)) (IsIntegral.pow hY_int d))
      · rw [Finset.sum_range_succ _ (d + 2), Finset.sum_range_succ _ (d + 2),
          add_sub_add_comm, ih_eq, ← mul_sub, ← hq_eq (d + 2), hq_succ2 d,
          hA_succ d, hB_succ d]
        ring
  obtain ⟨hA₀_int, hB₀_int, hH_factor_sum⟩ := hAB_ind H.natDegree
  let A₀ := A_seq H.natDegree
  let B₀ := B_seq H.natDegree
  have hH_deg_lt : H.natDegree < H.natDegree + 2 := by omega
  have hH_factor : Polynomial.eval X H - Polynomial.eval Y H =
      (X - Y) * (σ ε + X * A₀ + Y * B₀) := by
    rw [Polynomial.eval_eq_sum_range' hH_deg_lt X,
      Polynomial.eval_eq_sum_range' hH_deg_lt Y]
    exact hH_factor_sum
  let u₁ := -σ (ε * ε' - 1)
  let A₁ := -σ ε' * A₀
  let B₁ := -σ ε' * B₀
  let u₂ := Y * B₁
  let u_B := u₁ + u₂
  let u_A := X * A₁
  let w := u_A + u_B
  have hσε'_int : IsIntegral 𝒪[F] (σ ε') := isIntegral_algEquiv_apply σ hε'_int
  have hA₁_int : IsIntegral 𝒪[F] A₁ := IsIntegral.mul (IsIntegral.neg hσε'_int) hA₀_int
  have hB₁_int : IsIntegral 𝒪[F] B₁ := IsIntegral.mul (IsIntegral.neg hσε'_int) hB₀_int
  have hu₁_int : IsIntegral 𝒪[F] u₁ :=
    IsIntegral.neg (isIntegral_algEquiv_apply σ
      (IsIntegral.sub (IsIntegral.mul hε_int hε'_int) isIntegral_one))
  have hu₂_int : IsIntegral 𝒪[F] u₂ := IsIntegral.mul hY_int hB₁_int
  have huB_int : IsIntegral 𝒪[F] u_B := IsIntegral.add hu₁_int hu₂_int
  have huA_int : IsIntegral 𝒪[F] u_A := IsIntegral.mul hX_int hA₁_int
  have hw_int_bar : IsIntegral 𝒪[F] w := IsIntegral.add huA_int huB_int
  have h_one_sub_w : (X - Y) * (1 - w) = σ ε' * (Polynomial.eval X H - Polynomial.eval Y H) := by
    rw [hH_factor]
    dsimp [w, u_A, u_B, u₁, u₂, A₁, B₁]
    rw [map_sub, map_mul, map_one]
    ring
  have h_XY_one_sub_w_div : IsIntegralDivPow F L πL k₀ ((X - Y) * (1 - w)) := by
    rw [h_one_sub_w]
    exact divPow_mul_left hσε'_int hH_diff
  have hu₁_div : IsIntegralDivPow F L πL 1 u₁ :=
    divPow_neg (divPow_algEquiv hσL hε_unit)
  have hu₂N_div : IsIntegralDivPow F L πL 1 (u₂ ^ N) := by
    dsimp [u₂]
    rw [mul_pow]
    exact divPow_mul_right hYN_div (IsIntegral.pow hB₁_int N)
  have huB_sub_u₂_div : ∀ e : ℕ, IsIntegralDivPow F L πL 1 (u_B ^ e - u₂ ^ e) := by
    intro e
    induction e with
    | zero =>
      rw [pow_zero, pow_zero, sub_self]
      exact divPow_zero_elem 1
    | succ e ih =>
      have h_id : u_B ^ (e + 1) - u₂ ^ (e + 1) = u₁ * u_B ^ e + u₂ * (u_B ^ e - u₂ ^ e) := by
        dsimp [u_B]
        rw [pow_succ, pow_succ]
        ring
      rw [h_id]
      exact divPow_add
        (divPow_mul_right hu₁_div (IsIntegral.pow huB_int e))
        (divPow_mul_left hu₂_int ih)
  have huBN_div : IsIntegralDivPow F L πL 1 (u_B ^ N) := by
    have h_add := divPow_add (huB_sub_u₂_div N) hu₂N_div
    rwa [sub_add_cancel] at h_add
  have huAN_div : IsIntegralDivPow F L πL 1 (u_A ^ N) := by
    dsimp [u_A]
    rw [mul_pow]
    exact divPow_mul_right hXN_div (IsIntegral.pow hA₁_int N)
  have hw_2N_div : IsIntegralDivPow F L πL 1 (w ^ (2 * N)) := by
    dsimp [w]
    rw [add_pow]
    refine divPow_sum (Finset.range (2 * N + 1))
      (fun i => u_A ^ i * u_B ^ (2 * N - i) * ((2 * N).choose i : AlgebraicClosure F)) 1
      fun i _ => ?_
    have h_choose_int : IsIntegral 𝒪[F] ((2 * N).choose i : AlgebraicClosure F) := by
      have h_eq : ((2 * N).choose i : AlgebraicClosure F) =
          algebraMap L (AlgebraicClosure F) ((2 * N).choose i : L) := by
        rw [map_natCast]
      rw [h_eq]
      exact isIntegral_algebraMap_L (isIntegral_natCast _)
    refine divPow_mul_right ?_ h_choose_int
    rcases le_or_gt N i with hNi | hNi
    · exact divPow_mul_right
        (h_pow_divPow_of_ge huA_int huAN_div 1 i (by omega))
        (IsIntegral.pow huB_int (2 * N - i))
    · exact divPow_mul_left
        (IsIntegral.pow huA_int i)
        (h_pow_divPow_of_ge huB_int huBN_div 1 (2 * N - i) (by omega))
  have hw_2Nk₀_div : IsIntegralDivPow F L πL k₀ (w ^ (2 * N * k₀)) := by
    change IsIntegral 𝒪[F] (w ^ (2 * N * k₀) / πbar ^ k₀)
    have hw1 : IsIntegral 𝒪[F] (w ^ (2 * N) / πbar) := by
      have h1 : IsIntegral 𝒪[F] (w ^ (2 * N) / πbar ^ 1) := hw_2N_div
      rwa [pow_one] at h1
    have h_eq : w ^ (2 * N * k₀) / πbar ^ k₀ = (w ^ (2 * N) / πbar) ^ k₀ := by
      rw [div_pow, ← pow_mul]
    rw [h_eq]
    exact IsIntegral.pow hw1 k₀
  let geomSum : ℕ → AlgebraicClosure F :=
    fun K => Nat.rec 0 (fun j gj => gj + w ^ j) K
  have hgeom_zero : geomSum 0 = 0 := rfl
  have hgeom_succ : ∀ K : ℕ, geomSum (K + 1) = geomSum K + w ^ K := fun _ => rfl
  have hgeom_ind : ∀ K : ℕ,
      IsIntegral 𝒪[F] (geomSum K) ∧ (1 - w) * geomSum K = 1 - w ^ K := by
    intro K
    induction K with
    | zero =>
      refine ⟨hgeom_zero ▸ isIntegral_zero, ?_⟩
      rw [hgeom_zero, mul_zero, pow_zero, sub_self]
    | succ K ih =>
      refine ⟨?_, ?_⟩
      · rw [hgeom_succ]
        exact IsIntegral.add ih.1 (IsIntegral.pow hw_int_bar K)
      · calc (1 - w) * geomSum (K + 1)
            = (1 - w) * geomSum K + (1 - w) * w ^ K := by rw [hgeom_succ, mul_add]
          _ = (1 - w ^ K) + (1 - w) * w ^ K := by rw [ih.2]
          _ = 1 - w * w ^ K := by ring
          _ = 1 - w ^ (K + 1) := by rw [← pow_succ']
  obtain ⟨hgeom_int, hgeom_eq⟩ := hgeom_ind (2 * N * k₀)
  have h_final_id : X - Y =
      ((X - Y) * (1 - w)) * geomSum (2 * N * k₀) + (X - Y) * w ^ (2 * N * k₀) := by
    calc X - Y
        = (X - Y) * (1 - w ^ (2 * N * k₀)) + (X - Y) * w ^ (2 * N * k₀) := by ring
      _ = (X - Y) * ((1 - w) * geomSum (2 * N * k₀)) + (X - Y) * w ^ (2 * N * k₀) := by
          rw [← hgeom_eq]
      _ = ((X - Y) * (1 - w)) * geomSum (2 * N * k₀) + (X - Y) * w ^ (2 * N * k₀) := by ring
  change IsIntegralDivPow F L πL k₀ (X - Y)
  rw [h_final_id]
  exact divPow_add
    (divPow_mul_right h_XY_one_sub_w_div hgeom_int)
    (divPow_mul_left (IsIntegral.sub hX_int hY_int) hw_2Nk₀_div)

theorem apply_eq_of_aeval_relLubinTateIterPoly_eq_zero (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (u : Lˣ) : valL F L u = 0 → ∀ (f₀ m : ℕ), 1 ≤ f₀ → 1 ≤ m →
    ∀ (σ τ : AbsGal F), σ ∈ L.fixingSubgroup → τ ∈ L.fixingSubgroup →
    (∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ → τ ζ = ζ ^ qL F L) →
    (∀ x ∈ unramSubring F L, (τ ^ f₀) x = σ⁻¹ x) →
    (∀ α : AlgebraicClosure F,
      isLubinTateRoot F L (chosenUniformizer F L) m α →
      σ α = lubinTateFrob F L (u * chosenUniformizer F L) α) →
    let E₀ := unramDegSubfield F L f₀
    ∀ [FiniteDimensional F E₀],
    resDeg F E₀ = resDeg F L * f₀ →
    (∀ x ∈ E₀, τ x ∈ E₀) →
    (∀ x ∈ E₀, (τ ^ f₀) x = x) →
    ∀ (v : E₀ˣ), valL F E₀ v = 0 →
    (∏ j ∈ Finset.range f₀, (τ ^ j) ((v : E₀) : AlgebraicClosure F) =
      algebraMap L (AlgebraicClosure F) (u : L)) →
    ∀ (ϖ : E₀ˣ),
    ((ϖ : E₀) : AlgebraicClosure F) =
      ((v : E₀) : AlgebraicClosure F) *
        algebraMap L (AlgebraicClosure F) (chosenUniformizer F L : L) →
    ∀ (β : AlgebraicClosure F),
    Polynomial.aeval β (relLubinTateIterPoly F L E₀ τ (ϖ : E₀) m) = 0 →
    σ β = β :=
by
  intro hu f₀ m hf₀ hm σ τ hσL hτL hτFrob hτσ_unram hσ_apply E₀ hFin_E₀ hres_E₀ hτE₀ hτf₀_E₀
    v hv_val h_v_prod ϖ hϖ_coe β hβ_aeval
  let π := chosenUniformizer F L
  haveI : FiniteDimensional F E₀ := hFin_E₀
  obtain ⟨hπ, huπ_raw⟩ := valL_chosenUniformizer_and_mul_zpow F L u
  have huπ_eq : u * π ^ (1 - valL F L u) = u * π := by
    rw [hu, sub_zero, zpow_one]
  have huπ : valL F L ((u * π : Lˣ) : L) = 1 := by
    rw [← huπ_eq]
    exact huπ_raw
  obtain ⟨τ_L, hτ_L_fix, hτ_L_frob⟩ := exists_actsAsFrobPow_neg_resDeg F L
  let σ_LT := lubinTateFrob F L (u * π)
  have hσ_LT : IsLubinTateFrob F L (u * π) σ_LT :=
    Classical.epsilon_spec
      (exists_isLubinTateFrob_of_frobLift F L (u * π) huπ τ_L hτ_L_fix hτ_L_frob)
  obtain ⟨h_bridge, h_root⟩ :=
    isIntegralOverValL_of_isIntegral_and_exists_root_isIntegralDivPow F L π hπ
  have h_unram := unramSubring_frob_congr_and_div_pow_mem F L π hπ τ hτL hτFrob
  obtain ⟨hv_unram, h_rel_lift⟩ :=
    exists_unramSubring_rel_frob_unit_lift F L π u hπ hu f₀ hf₀ τ hτL hτFrob h_root h_unram
      hres_E₀ hτf₀_E₀ v hv_val h_v_prod
  apply eq_of_forall_sub_eq_pow_mul_sub_isIntegralOverValL F L π hπ (σ β) β
  intro k₀
  let N := (qL F L) ^ m
  let r := k₀ * N
  let M₀ := r * N
  let r₁ := M₀ * N
  obtain ⟨ε, hε_mem, ε', hε'_mem, hε_unit, hε_frob_v, hε_frob_u⟩ :=
    h_rel_lift (M₀ + r₁ + 1)
  obtain ⟨hθ₀, hθ₁, hθ_deg, hθ_unram, hθ_iter, hθ_comm⟩ :=
    relColemanTheta_iter_and_endoTrunc_congr F L π u hπ hu f₀ hf₀ τ hτL
      (fun x hx => ⟨(h_unram x hx).1, (h_unram x hx).2.1, (h_unram x hx).2.2.1⟩)
      E₀ hτE₀ hτf₀_E₀ ((v : E₀) : AlgebraicClosure F) hv_unram (ϖ : E₀) hϖ_coe
      ε hε_mem M₀ r₁ hε_frob_v hε_frob_u
  have h_σ_trunc : ∀ α : AlgebraicClosure F,
      isLubinTateRoot F L π m α →
      IsIntegralDivPow F L (π : L) k₀
        (σ α - Polynomial.aeval α (lubinTateEndoTrunc F L (π : L) (u : L) r)) := by
    intro α hα
    rw [hσ_apply α hα]
    let τ_LT : AbsGal F := σ_LT⁻¹
    have hτ_LT_L : τ_LT ∈ L.fixingSubgroup := Subgroup.inv_mem _ hσ_LT.1
    have hτ_LT_Frob :
        ∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ → τ_LT ζ = ζ ^ qL F L := by
      intro ζ hζ
      have hτζ : IsPrimeToPRootOfUnity F (τ_LT ζ) := by
        rcases hζ with ⟨d, hd, hpd, hζd⟩
        exact ⟨d, hd, hpd, by rw [← map_pow, hζd, map_one]⟩
      have h_eq := hσ_LT.2.1 (τ_LT ζ) hτζ
      have happly : σ_LT (τ_LT ζ) = ζ := AlgEquiv.apply_symm_apply σ_LT ζ
      have hpos : (-(-(resDeg F L : ℤ))).toNat = resDeg F L := by omega
      have hneg : (-(resDeg F L : ℤ)).toNat = 0 := by omega
      rw [happly, hpos, hneg, pow_zero, pow_one] at h_eq
      exact h_eq.symm
    have h_unram_LT :=
      unramSubring_frob_congr_and_div_pow_mem F L π hπ τ_LT hτ_LT_L hτ_LT_Frob
    obtain ⟨ε_L, hε_L_mem, ε'_L, hε'_L_mem, hε_L_unit, hε_L_frob⟩ :=
      exists_unramSubring_frob_unit_lift F L π u hπ hu τ_LT hτ_LT_L hτ_LT_Frob h_root
        h_unram_LT (M₀ + r₁ + 1)
    obtain ⟨hθL₀, hθL₁, hθL_deg, hθL_int, hθL_iter, hθL_comm⟩ :=
      colemanTheta_iter_and_endoTrunc_congr F L π u hπ hu τ_LT hτ_LT_L
        (fun x hx => ⟨(h_unram_LT x hx).1, (h_unram_LT x hx).2.1, (h_unram_LT x hx).2.2.1⟩)
        ε_L hε_L_mem M₀ r₁ hε_L_frob
    exact isIntegralDivPow_frob_sub_aeval_endoTrunc_of_colemanTheta F L π u hπ hu σ_LT hσ_LT
      m α hα k₀ ε_L ε'_L (colemanTheta F L (π : L) (u : L) τ_LT ε_L (M₀ + r₁) r₁)
      (h_unram_LT ε_L hε_L_mem).1 (h_unram_LT ε'_L hε'_L_mem).1 hε_L_unit
      hθL₀ hθL₁ hθL_deg hθL_int (hθL_iter m) hθL_comm h_root
  have h_div : IsIntegralDivPow F L (π : L) k₀ (σ β - β) :=
    isIntegralDivPow_apply_sub_of_relColemanTheta F L π u hπ hu f₀ m hm σ τ hσL hτL
      hτσ_unram E₀ hτE₀ ((v : E₀) : AlgebraicClosure F) (h_unram _ hv_unram).1
      (ϖ : E₀) hϖ_coe β hβ_aeval k₀ ε ε'
      (relColemanTheta F L (π : L) ((v : E₀) : AlgebraicClosure F) τ ε (M₀ + r₁) r₁)
      (h_unram ε hε_mem).1 (h_unram ε' hε'_mem).1 hε_unit hθ₀ hθ₁ hθ_deg hθ_unram
      (fun k => (h_unram _ (hθ_unram k)).1) (hθ_iter m) hθ_comm h_root h_σ_trunc
  let πbar : AlgebraicClosure F := algebraMap L (AlgebraicClosure F) (π : L)
  have hπ_ne : πbar ≠ 0 :=
    (map_ne_zero (algebraMap L (AlgebraicClosure F))).mpr (Units.ne_zero π)
  have hπk₀_ne : πbar ^ k₀ ≠ 0 := pow_ne_zero k₀ hπ_ne
  refine ⟨(σ β - β) / πbar ^ k₀, 0, h_bridge ((σ β - β) / πbar ^ k₀) h_div,
    h_bridge 0 isIntegral_zero, ?_⟩
  rw [sub_zero]
  exact (mul_div_cancel₀ (σ β - β) hπk₀_ne).symm

theorem exists_polyValLe_aeval_mul_sub_one_ge_of_valL_eq_zero (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E₀ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E₀]
    (D : Polynomial E₀) (π_m : AlgebraicClosure F) :
    D.Monic → Irreducible D → valL F E₀ (D.coeff 0) = 1 →
    Polynomial.aeval π_m D = 0 →
    let K := E₀ ⊔ IntermediateField.adjoin F {π_m}
    ∀ [FiniteDimensional F K],
    resDeg F K = resDeg F E₀ →
    ∀ (N : ℕ), 1 ≤ N →
    ∀ (w₀ : Kˣ), valL F K w₀ = 0 →
    ∃ (g : Polynomial E₀) (u_poly v_rem : Kˣ),
      polyValLe F E₀ 0 g ∧
      g.coeff 0 ≠ 0 ∧
      valL F E₀ (g.coeff 0) = 0 ∧
      ((u_poly : K) : AlgebraicClosure F) = Polynomial.aeval π_m g ∧
      ((v_rem : K) = 1 ∨ (N : ℤ) ≤ valL F K ((v_rem : K) - 1)) ∧
      w₀ = u_poly * v_rem :=
by
  intro hD_monic hD_irr hD_c0_val hπ_m_D K _ hres N hN w₀ hw₀
  let hE₀K : E₀ ≤ K := le_sup_left
  let A : IntermediateField ↥E₀ (AlgebraicClosure F) := IntermediateField.extendScalars hE₀K
  let d : ℕ := D.natDegree
  have hd_pos : 0 < d := hD_irr.natDegree_pos
  have hK_le : K ≤
      (IntermediateField.adjoin ↥E₀ ({π_m} : Set (AlgebraicClosure F))).restrictScalars F := by
    apply sup_le
    · intro x hx
      exact (IntermediateField.mem_restrictScalars F).mpr
        ((IntermediateField.adjoin ↥E₀ ({π_m} : Set (AlgebraicClosure F))).algebraMap_mem ⟨x, hx⟩)
    · rw [IntermediateField.adjoin_simple_le_iff]
      exact (IntermediateField.mem_restrictScalars F).mpr
        (IntermediateField.mem_adjoin_simple_self ↥E₀ π_m)
  have hA : A = IntermediateField.adjoin ↥E₀ ({π_m} : Set (AlgebraicClosure F)) := by
    apply le_antisymm
    · intro z hz
      exact (IntermediateField.mem_restrictScalars F).mp
        (hK_le ((IntermediateField.mem_extendScalars hE₀K).mp hz))
    · rw [IntermediateField.adjoin_simple_le_iff]
      exact (IntermediateField.mem_extendScalars hE₀K).mpr
        ((le_sup_right : IntermediateField.adjoin F ({π_m} : Set (AlgebraicClosure F)) ≤ K)
          (IntermediateField.mem_adjoin_simple_self F π_m))
  have hπ_m_mem : π_m ∈ K :=
    (le_sup_right : IntermediateField.adjoin F ({π_m} : Set (AlgebraicClosure F)) ≤ K)
      (IntermediateField.mem_adjoin_simple_self F π_m)
  let π_K : K := ⟨π_m, hπ_m_mem⟩
  have hπ_int : IsIntegral ↥E₀ π_m :=
    ⟨D, hD_monic, Polynomial.aeval_def π_m D ▸ hπ_m_D⟩
  have h_minpoly : minpoly ↥E₀ π_m = D :=
    (minpoly.eq_of_irreducible_of_monic hD_irr hπ_m_D hD_monic).symm
  have h_finrank : Module.finrank ↥E₀ ↥A = d := by
    rw [hA, IntermediateField.adjoin.finrank hπ_int, h_minpoly]
  haveI : FiniteDimensional ↥E₀ ↥A :=
    Module.finite_of_finrank_pos (by rw [h_finrank]; exact hd_pos)
  have hDc0_ne : D.coeff 0 ≠ 0 := by
    intro h0
    have h1 := hD_c0_val
    rw [h0] at h1
    simp [valL, relVal, addVal] at h1
  have hresE₀_ne : resDeg F E₀ ≠ 0 := by
    intro h0
    have h1 := hD_c0_val
    rw [valL, h0, Nat.cast_zero, Int.ediv_zero] at h1
    omega
  have hresK_ne : resDeg F K ≠ 0 := by
    rw [hres]
    exact hresE₀_ne
  have hfE₀_ne : (resDeg F E₀ : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr hresE₀_ne
  have hfK_ne : (resDeg F K : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr hresK_ne
  have hfK_pos : (0 : ℤ) < (resDeg F K : ℤ) :=
    Nat.cast_pos.mpr (Nat.pos_of_ne_zero hresK_ne)
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h2 := addVal_mul h1 h1
    rw [mul_one] at h2
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  have addVal_pow : ∀ {a : F} (ha : a ≠ 0) (k : ℕ),
      addVal F (a ^ k) = (k : ℤ) * addVal F a := by
    intro a ha k
    let u : Fˣ := Units.mk0 a ha
    change Multiplicative.toAdd (addValHom (u ^ k)) = (k : ℤ) * Multiplicative.toAdd (addValHom u)
    rw [map_pow, toAdd_pow, nsmul_eq_mul]
  have relVal_units_mul : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (v₁ v₂ : Mˣ), relVal F M ((v₁ * v₂ : Mˣ) : M) = relVal F M v₁ + relVal F M v₂ := by
    intro M _ v₁ v₂
    let relValHom : Mˣ →* Multiplicative ℤ := addValHom.comp (Units.map (Algebra.norm F))
    have h_app : ∀ u : Mˣ, Multiplicative.toAdd (relValHom u) = relVal F M u := fun _ => rfl
    rw [← h_app, map_mul, toAdd_mul, h_app, h_app]
  have relVal_units_zpow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (v₁ : Mˣ) (k : ℤ), relVal F M ((v₁ ^ k : Mˣ) : M) = k * relVal F M v₁ := by
    intro M _ v₁ k
    let relValHom : Mˣ →* Multiplicative ℤ := addValHom.comp (Units.map (Algebra.norm F))
    have h_app : ∀ u : Mˣ, Multiplicative.toAdd (relValHom u) = relVal F M u := fun _ => rfl
    rw [← h_app, map_zpow, toAdd_zpow, h_app, zsmul_eq_mul]
    rfl
  have valL_K_mul : ∀ v₁ v₂ : Kˣ,
      valL F K ((v₁ * v₂ : Kˣ) : K) = valL F K v₁ + valL F K v₂ := by
    intro v₁ v₂
    have hrel := relVal_eq_resDeg_mul_valL F K (v₁ * v₂)
    rw [relVal_units_mul K, relVal_eq_resDeg_mul_valL F K v₁,
      relVal_eq_resDeg_mul_valL F K v₂] at hrel
    apply mul_left_cancel₀ hfK_ne
    linarith
  have valL_K_zpow : ∀ (v₁ : Kˣ) (k : ℤ),
      valL F K ((v₁ ^ k : Kˣ) : K) = k * valL F K v₁ := by
    intro v₁ k
    have hrel := relVal_eq_resDeg_mul_valL F K (v₁ ^ k)
    rw [relVal_units_zpow K, relVal_eq_resDeg_mul_valL F K v₁] at hrel
    apply mul_left_cancel₀ hfK_ne
    linarith
  have valL_K_one : valL F K 1 = 0 := by
    have h := valL_K_mul 1 1
    rw [mul_one] at h
    change valL F K 1 = valL F K 1 + valL F K 1 at h
    omega
  have valL_K_mul_elem : ∀ {a b : K} (ha : a ≠ 0) (hb : b ≠ 0),
      valL F K (a * b) = valL F K a + valL F K b :=
    fun ha hb => valL_K_mul (Units.mk0 _ ha) (Units.mk0 _ hb)
  have valL_K_div_elem : ∀ {a b : K} (ha : a ≠ 0) (hb : b ≠ 0),
      valL F K (a / b) = valL F K a - valL F K b := by
    intro a b ha hb
    have hab : a / b ≠ 0 := div_ne_zero ha hb
    have h := valL_K_mul_elem hab hb
    rw [div_mul_cancel₀ _ hb] at h
    omega
  have h_gen_norm : ∀ (L₀ Ω : Type u) [Field L₀] [Field Ω] [Algebra L₀ Ω]
      (B : IntermediateField L₀ Ω) (p : Polynomial L₀) (α : Ω) (x : B),
      (x : Ω) = α → B = IntermediateField.adjoin L₀ {α} → p.Monic → Irreducible p →
      Polynomial.aeval α p = 0 → Algebra.norm L₀ (-x) = p.coeff 0 := by
    intro L₀ Ω _ _ _ B p α x hx hB hp_monic hp_irr hp_aeval
    subst hB
    have h_int : IsIntegral L₀ α :=
      ⟨p, hp_monic, Polynomial.aeval_def α p ▸ hp_aeval⟩
    let pb : PowerBasis L₀ ↥(IntermediateField.adjoin L₀ {α}) :=
      IntermediateField.adjoin.powerBasis h_int
    have h_min : minpoly L₀ pb.gen = p := by
      rw [IntermediateField.adjoin.powerBasis_gen h_int, IntermediateField.minpoly_gen L₀ α]
      exact (minpoly.eq_of_irreducible_of_monic hp_irr hp_aeval hp_monic).symm
    have h_norm_gen : Algebra.norm L₀ pb.gen = (-1 : L₀) ^ pb.dim * p.coeff 0 := by
      rw [Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, h_min]
    have hx_eq : x = pb.gen := by
      apply Subtype.ext
      rw [hx, IntermediateField.adjoin.powerBasis_gen h_int]
      rfl
    rw [hx_eq]
    have h_neg : (-pb.gen : ↥(IntermediateField.adjoin L₀ {α})) =
        algebraMap L₀ ↥(IntermediateField.adjoin L₀ {α}) (-1 : L₀) * pb.gen := by
      simp
    rw [h_neg, map_mul, Algebra.norm_algebraMap, pb.finrank, h_norm_gen, ← mul_assoc, ← mul_pow]
    simp
  let x_m : A := toExtendScalars F hE₀K π_K
  have h_norm_neg_E₀ : Algebra.norm ↥E₀ (-x_m) = D.coeff 0 :=
    h_gen_norm ↥E₀ (AlgebraicClosure F) A D π_m x_m rfl hA hD_monic hD_irr hπ_m_D
  have h_norm_neg_F : Algebra.norm F (-π_K : K) = Algebra.norm F (D.coeff 0) := by
    change Algebra.norm F (-x_m) = Algebra.norm F (D.coeff 0)
    rw [← Algebra.norm_norm (R := F) (S := ↥E₀) (a := -x_m), h_norm_neg_E₀]
  have h_norm_sq_F : (Algebra.norm F π_K) ^ 2 = (Algebra.norm F (D.coeff 0)) ^ 2 := by
    calc (Algebra.norm F π_K) ^ 2 = Algebra.norm F (π_K ^ 2) := (map_pow _ _ 2).symm
      _ = Algebra.norm F ((-π_K) ^ 2) := by rw [neg_sq]
      _ = (Algebra.norm F (-π_K)) ^ 2 := map_pow _ _ 2
      _ = (Algebra.norm F (D.coeff 0)) ^ 2 := by rw [h_norm_neg_F]
  let ϖ₀ : E₀ˣ := Units.mk0 (D.coeff 0) hDc0_ne
  have hn_Dc0 : Algebra.norm F (D.coeff 0) ≠ 0 := (ϖ₀.isUnit.map (Algebra.norm F)).ne_zero
  have hn_πK : Algebra.norm F π_K ≠ 0 := by
    intro h0
    have hsq : (Algebra.norm F (D.coeff 0)) ^ 2 = 0 := by
      rw [← h_norm_sq_F, h0, zero_pow two_ne_zero]
    exact hn_Dc0 (pow_eq_zero hsq)
  have hπK_ne : π_K ≠ 0 := by
    intro h0
    apply hn_πK
    have h0' : (π_K : K) = algebraMap F K 0 := by rw [h0, map_zero]
    rw [h0', Algebra.norm_algebraMap, zero_pow (Module.finrank_pos.ne')]
  have h_relVal_sq : 2 * relVal F K π_K = 2 * relVal F E₀ (D.coeff 0) := by
    have h1 := addVal_pow hn_πK 2
    have h2 := addVal_pow hn_Dc0 2
    rw [h_norm_sq_F] at h1
    change addVal F ((Algebra.norm F (D.coeff 0)) ^ 2) = (2 : ℤ) * relVal F K π_K at h1
    change addVal F ((Algebra.norm F (D.coeff 0)) ^ 2) = (2 : ℤ) * relVal F E₀ (D.coeff 0) at h2
    omega
  have h_relVal_πK : relVal F K π_K = relVal F E₀ (D.coeff 0) := by omega
  let u_πK : Kˣ := Units.mk0 π_K hπK_ne
  have hπK_val : valL F K π_K = 1 := by
    have h1 : relVal F K u_πK = (resDeg F K : ℤ) * valL F K u_πK :=
      relVal_eq_resDeg_mul_valL F K u_πK
    have h2 : relVal F E₀ ϖ₀ = (resDeg F E₀ : ℤ) * valL F E₀ ϖ₀ :=
      relVal_eq_resDeg_mul_valL F E₀ ϖ₀
    change relVal F K π_K = (resDeg F K : ℤ) * valL F K π_K at h1
    change relVal F E₀ (D.coeff 0) = (resDeg F E₀ : ℤ) * valL F E₀ (D.coeff 0) at h2
    rw [h_relVal_πK, h2, hres, hD_c0_val] at h1
    exact (mul_left_cancel₀ hfE₀_ne h1).symm
  have valL_πK_pow : ∀ k : ℕ, valL F K (π_K ^ k) = (k : ℤ) := by
    intro k
    change valL F K (((u_πK ^ (k : ℤ) : Kˣ) : K)) = (k : ℤ)
    rw [valL_K_zpow]
    change (k : ℤ) * valL F K π_K = (k : ℤ)
    rw [hπK_val, mul_one]
  have h_val_inc : ∀ c : E₀, c ≠ 0 →
      valL F K (IntermediateField.inclusion hE₀K c) = (d : ℤ) * valL F E₀ c := by
    intro c hc
    let cK : K := IntermediateField.inclusion hE₀K c
    let cA : A := algebraMap ↥E₀ ↥A c
    have h_norm_c_E₀ : Algebra.norm ↥E₀ cA = c ^ d := by
      rw [Algebra.norm_algebraMap, h_finrank]
    have h_norm_c_F : Algebra.norm F cK = (Algebra.norm F c) ^ d := by
      change Algebra.norm F cA = (Algebra.norm F c) ^ d
      rw [← Algebra.norm_norm (R := F) (S := ↥E₀) (a := cA), h_norm_c_E₀, map_pow]
    let u_c : E₀ˣ := Units.mk0 c hc
    have hcK_ne : cK ≠ 0 := (map_ne_zero (IntermediateField.inclusion hE₀K)).mpr hc
    let u_cK : Kˣ := Units.mk0 cK hcK_ne
    have hn_c : Algebra.norm F c ≠ 0 := (u_c.isUnit.map (Algebra.norm F)).ne_zero
    have h_relVal_c : relVal F K cK = (d : ℤ) * relVal F E₀ c := by
      change addVal F (Algebra.norm F cK) = (d : ℤ) * addVal F (Algebra.norm F c)
      rw [h_norm_c_F, addVal_pow hn_c d]
    have h1 : relVal F K u_cK = (resDeg F K : ℤ) * valL F K u_cK :=
      relVal_eq_resDeg_mul_valL F K u_cK
    have h2 : relVal F E₀ u_c = (resDeg F E₀ : ℤ) * valL F E₀ u_c :=
      relVal_eq_resDeg_mul_valL F E₀ u_c
    change relVal F K cK = (resDeg F K : ℤ) * valL F K cK at h1
    change relVal F E₀ c = (resDeg F E₀ : ℤ) * valL F E₀ c at h2
    rw [h_relVal_c, h2, hres] at h1
    have h1' : (resDeg F E₀ : ℤ) * valL F K cK =
        (resDeg F E₀ : ℤ) * ((d : ℤ) * valL F E₀ c) := by
      linarith
    exact mul_left_cancel₀ hfE₀_ne h1'
  have h_div_iff_K : ∀ (k : ℕ) (z : K),
      (z = 0 ∨ (k : ℤ) ≤ valL F K z) ↔ IsIntegral 𝒪[F] (z / π_K ^ k) := by
    intro k z
    rw [isIntegral_iff_eq_zero_or_relVal_nonneg F K (z / π_K ^ k)]
    have hpow_ne : π_K ^ k ≠ 0 := pow_ne_zero k hπK_ne
    by_cases hz0 : z = 0
    · simp [hz0]
    · have hdiv_ne : z / π_K ^ k ≠ 0 := div_ne_zero hz0 hpow_ne
      have hrel := relVal_eq_resDeg_mul_valL F K (Units.mk0 _ hdiv_ne)
      change relVal F K (z / π_K ^ k) =
        (resDeg F K : ℤ) * valL F K (z / π_K ^ k) at hrel
      rw [or_iff_right hz0, or_iff_right hdiv_ne, hrel,
        valL_K_div_elem hz0 hpow_ne, valL_πK_pow k]
      exact ⟨fun hle => mul_nonneg (by omega) (by omega),
        fun hle => by have := nonneg_of_mul_nonneg_right hle hfK_pos; omega⟩
  have hπK_int : IsIntegral 𝒪[F] π_K := by
    simpa using (h_div_iff_K 0 π_K).mp (Or.inr (by rw [hπK_val]; omega))
  have h_valL_eq_zero_of_sub_ge_one : ∀ {x z : K}, x ≠ 0 → valL F K x = 0 →
      (z = 0 ∨ 1 ≤ valL F K z) → x - z ≠ 0 ∧ valL F K (x - z) = 0 := by
    intro x z hx0 hx_val hz
    have hx_int : IsIntegral 𝒪[F] x := by
      simpa using (h_div_iff_K 0 x).mp (Or.inr (by rw [hx_val]; omega))
    have hx_inv_val : valL F K (x⁻¹) = 0 := by
      rw [← one_div, valL_K_div_elem one_ne_zero hx0, valL_K_one, hx_val, sub_zero]
    have hx_inv_int : IsIntegral 𝒪[F] (x⁻¹) := by
      simpa using (h_div_iff_K 0 (x⁻¹)).mp (Or.inr (by rw [hx_inv_val]; omega))
    have hz_div_int : IsIntegral 𝒪[F] (z / π_K) := by
      simpa using (h_div_iff_K 1 z).mp hz
    have hz_int : IsIntegral 𝒪[F] z := by
      have h_eq : z = π_K * (z / π_K) := (mul_div_cancel₀ z hπK_ne).symm
      rw [h_eq]
      exact IsIntegral.mul hπK_int hz_div_int
    have hy_int : IsIntegral 𝒪[F] (x - z) := IsIntegral.sub hx_int hz_int
    have hy_ge0 : x - z = 0 ∨ 0 ≤ valL F K (x - z) :=
      (h_div_iff_K 0 (x - z)).mpr (by simpa using hy_int)
    have hy_not_ge1 : ¬ (x - z = 0 ∨ 1 ≤ valL F K (x - z)) := by
      intro hy1
      have hy_div_int : IsIntegral 𝒪[F] ((x - z) / π_K) := by
        simpa using (h_div_iff_K 1 (x - z)).mp hy1
      have hx_div_int : IsIntegral 𝒪[F] (x / π_K) := by
        have h_eq : x / π_K = (x - z) / π_K + z / π_K := by ring
        rw [h_eq]
        exact IsIntegral.add hy_div_int hz_div_int
      have h1_div_int : IsIntegral 𝒪[F] ((1 : K) / π_K) := by
        have h_eq : (1 : K) / π_K = x⁻¹ * (x / π_K) := by
          rw [← mul_div_assoc, inv_mul_cancel₀ hx0]
        rw [h_eq]
        exact IsIntegral.mul hx_inv_int hx_div_int
      have h1_ge1 : (1 : K) = 0 ∨ 1 ≤ valL F K (1 : K) :=
        (h_div_iff_K 1 (1 : K)).mpr (by simpa using h1_div_int)
      rcases h1_ge1 with h0 | hle
      · exact one_ne_zero h0
      · rw [valL_K_one] at hle
        omega
    push_neg at hy_not_ge1
    refine ⟨hy_not_ge1.1, ?_⟩
    have h0 := hy_ge0.resolve_left hy_not_ge1.1
    have h1 := hy_not_ge1.2
    omega
  have h_taylor_ind : ∀ n : ℕ, ∃ (g : Polynomial E₀) (r : K),
      polyValLe F E₀ 0 g ∧
      (∀ k : ℕ, n ≤ k → g.coeff k = 0) ∧
      (r = 0 ∨ 0 ≤ valL F K r) ∧
      ((w₀ : K) : AlgebraicClosure F) =
        Polynomial.aeval π_m g + (r : AlgebraicClosure F) * π_m ^ n ∧
      (n = 0 → r = (w₀ : K)) ∧
      (1 ≤ n →
        (w₀ : K) - IntermediateField.inclusion hE₀K (g.coeff 0) = 0 ∨
        1 ≤ valL F K ((w₀ : K) - IntermediateField.inclusion hE₀K (g.coeff 0))) := by
    intro n
    induction n with
    | zero =>
      refine ⟨0, (w₀ : K), ?_, ?_, ?_, ?_, ?_, ?_⟩
      · intro k
        exact Or.inl (Polynomial.coeff_zero k)
      · intro k _
        exact Polynomial.coeff_zero k
      · exact Or.inr (by rw [hw₀])
      · rw [map_zero, zero_add, pow_zero, mul_one]
      · intro _
        rfl
      · intro h
        omega
    | succ n ih =>
      obtain ⟨g, r, hg, hdeg, hr, hw₀_eq, hr0, hc0_ih⟩ := ih
      obtain ⟨c, hc, hrc⟩ :=
        exists_mem_valL_sub_ge_one_of_resDeg_eq F E₀ K hE₀K hres r hr
      let g' : Polynomial E₀ := g + Polynomial.monomial n c
      let r' : K := (r - IntermediateField.inclusion hE₀K c) / π_K
      refine ⟨g', r', ?_, ?_, ?_, ?_, ?_, ?_⟩
      · intro k
        dsimp [g']
        rw [Polynomial.coeff_add, Polynomial.coeff_monomial]
        by_cases hnk : n = k
        · subst hnk
          rw [if_pos rfl, hdeg n le_rfl, zero_add]
          exact hc
        · rw [if_neg hnk, add_zero]
          exact hg k
      · intro k hk
        dsimp [g']
        rw [Polynomial.coeff_add, Polynomial.coeff_monomial, if_neg (by omega), add_zero]
        exact hdeg k (by omega)
      · rcases hrc with h0 | hle
        · left
          dsimp [r']
          rw [h0, zero_div]
        · by_cases h0 : r - IntermediateField.inclusion hE₀K c = 0
          · left
            dsimp [r']
            rw [h0, zero_div]
          · right
            dsimp [r']
            rw [valL_K_div_elem h0 hπK_ne, hπK_val]
            omega
      · have hr_eq : r = IntermediateField.inclusion hE₀K c + r' * π_K := by
          dsimp [r']
          rw [div_mul_cancel₀ _ hπK_ne, add_sub_cancel]
        have hr_coe : (r : AlgebraicClosure F) =
            (c : AlgebraicClosure F) + (r' : AlgebraicClosure F) * π_m := by
          exact congr_arg (algebraMap K (AlgebraicClosure F)) hr_eq
        have hg'_aeval : Polynomial.aeval π_m g' =
            Polynomial.aeval π_m g + (c : AlgebraicClosure F) * π_m ^ n := by
          change Polynomial.aeval π_m (g + Polynomial.monomial n c) = _
          rw [Polynomial.aeval_add, Polynomial.aeval_monomial]
          rfl
        rw [hw₀_eq, hg'_aeval, hr_coe, pow_succ]
        ring
      · intro h
        omega
      · intro _
        rcases Nat.eq_zero_or_pos n with rfl | hn_pos
        · have hg'0 : g'.coeff 0 = c := by
            change (g + Polynomial.monomial 0 c).coeff 0 = c
            rw [Polynomial.coeff_add, Polynomial.coeff_monomial, if_pos rfl, hdeg 0 le_rfl,
              zero_add]
          rw [hg'0, ← hr0 rfl]
          exact hrc
        · have hg'0 : g'.coeff 0 = g.coeff 0 := by
            change (g + Polynomial.monomial n c).coeff 0 = g.coeff 0
            rw [Polynomial.coeff_add, Polynomial.coeff_monomial, if_neg (by omega), add_zero]
          rw [hg'0]
          exact hc0_ih hn_pos
  obtain ⟨g, r, hg, _, hr, hw₀_eq, _, hc0_prop⟩ := h_taylor_ind N
  have hc0 := hc0_prop hN
  have hc0_K_both := h_valL_eq_zero_of_sub_ge_one w₀.ne_zero hw₀ hc0
  rw [sub_sub_cancel] at hc0_K_both
  obtain ⟨hc0_K_ne, hc0_K_val⟩ := hc0_K_both
  have hg_c0_ne : g.coeff 0 ≠ 0 := by
    intro h0
    apply hc0_K_ne
    rw [h0, map_zero]
  have hg_c0_val : valL F E₀ (g.coeff 0) = 0 := by
    rw [h_val_inc (g.coeff 0) hg_c0_ne] at hc0_K_val
    have hd_ne : (d : ℤ) ≠ 0 := by omega
    exact (mul_eq_zero.mp hc0_K_val).resolve_left hd_ne
  let z_N : K := r * π_K ^ N
  let y : K := (w₀ : K) - z_N
  have hzN_ge_N : z_N = 0 ∨ (N : ℤ) ≤ valL F K z_N := by
    by_cases hr0 : r = 0
    · left
      dsimp [z_N]
      rw [hr0, zero_mul]
    · right
      have hr_ge0 : 0 ≤ valL F K r := hr.resolve_left hr0
      have hpow_ne : π_K ^ N ≠ 0 := pow_ne_zero N hπK_ne
      dsimp [z_N]
      rw [valL_K_mul_elem hr0 hpow_ne, valL_πK_pow N]
      omega
  have hzN_ge_1 : z_N = 0 ∨ 1 ≤ valL F K z_N := by
    rcases hzN_ge_N with h0 | hle
    · exact Or.inl h0
    · exact Or.inr (by omega)
  obtain ⟨hy_ne, hy_val⟩ := h_valL_eq_zero_of_sub_ge_one w₀.ne_zero hw₀ hzN_ge_1
  have hy_coe : (y : AlgebraicClosure F) = Polynomial.aeval π_m g := by
    have hzN_coe : (z_N : AlgebraicClosure F) = (r : AlgebraicClosure F) * π_m ^ N := rfl
    change ((w₀ : K) : AlgebraicClosure F) - (z_N : AlgebraicClosure F) = Polynomial.aeval π_m g
    rw [hw₀_eq, hzN_coe, add_sub_cancel_right]
  let u_poly : Kˣ := Units.mk0 y hy_ne
  let v_rem : Kˣ := u_poly⁻¹ * w₀
  refine ⟨g, u_poly, v_rem, hg, hg_c0_ne, hg_c0_val, hy_coe, ?_,
    (mul_inv_cancel_left u_poly w₀).symm⟩
  have hv_sub : (v_rem : K) - 1 = z_N / y := by
    have hu_coe : (u_poly : K) = y := rfl
    have h_w0 : (w₀ : K) = y + z_N := by
      dsimp [y]
      ring
    change ((u_poly⁻¹ : Kˣ) : K) * (w₀ : K) - 1 = z_N / y
    rw [Units.val_inv_eq_inv_val, hu_coe, h_w0, mul_add, inv_mul_cancel₀ hy_ne, div_eq_inv_mul]
    ring
  by_cases hzN0 : z_N = 0
  · left
    apply sub_eq_zero.mp
    rw [hv_sub, hzN0, zero_div]
  · right
    have hle := hzN_ge_N.resolve_left hzN0
    rw [hv_sub, valL_K_div_elem hzN0 hy_ne, hy_val, sub_zero]
    exact hle

theorem relColemanNormIter_coeff_zero_eq_mul_norm (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E₀ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    [FiniteDimensional F E₀] (τ : AbsGal F) :
    (∀ x ∈ E₀, τ x ∈ E₀) →
    ∀ (ϖ : E₀),
    (∀ (j k : ℕ), 1 ≤ k →
      let D_jk := relLubinTateDivPoly F L E₀ τ (relLubinTateCoeff F E₀ τ ϖ j) k
      D_jk.Monic ∧
      D_jk.natDegree = (qL F L - 1) * (qL F L) ^ (k - 1) ∧
      Irreducible D_jk) →
    ∀ (m : ℕ), 1 ≤ m →
