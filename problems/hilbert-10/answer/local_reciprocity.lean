      exact ⟨le_rfl, by rw [Nat.sub_self]; exact dvd_zero _⟩
    · intro n hn ih d f h_unit h_mono h_sen
      set I := Finset.Icc 1 (p ^ (n + 1) - 1)
      set J := Finset.Icc 1 (p ^ n - 1)
      have h_pn_pos : 1 ≤ p ^ n := Nat.one_le_pow n p (by omega)
      have h_pn1_pos : 1 ≤ p ^ (n + 1) := Nat.one_le_pow (n + 1) p (by omega)
      have h_pn_le : p ^ n ≤ p ^ (n + 1) := Nat.pow_le_pow_right (by omega) (by omega)
      have h_split : ∑ r ∈ I, f r =
