    have hσ_r_τ : V_E ((k : ℤ) + 2) (galApply F hLE σ r_τ - r_τ) := by
      rw [hσ_r_τ_id]
      have h_t1 : V_E ((k : ℤ) + 2) ((galApply F hLE σ b_r - b_r) * galApply F hLE σ π_E) := by
        have h := hV_E_mul hσ_b_r (hV_E_gal 1 σ hπ_E_V1)
        have heq : ((k : ℤ) + 1) + 1 = (k : ℤ) + 2 := by ring
        rwa [heq] at h
      have h_t2 : V_E ((k : ℤ) + 2) (b_r * δ) := by
        have h := hV_E_mul hb_r_V1 hδ_Vk1
        have heq : 1 + ((k : ℤ) + 1) = (k : ℤ) + 2 := by ring
        rwa [heq] at h
      exact hV_E_add h_t1 h_t2
    have h_way1_eq : galApply F hLE τ δ - IntermediateField.inclusion hLE a * δ =
        galApply F hLE σ r_τ - r_τ := by
      have h_comm_π : galApply F hLE τ (galApply F hLE σ π_E) =
          galApply F hLE σ (galApply F hLE τ π_E) := by
        rw [← galApply_mul, hG_comm τ σ, galApply_mul]
      dsimp [δ, r_τ]
      rw [galApply_sub, galApply_sub, galApply_mul_val, galApply_inclusion, h_comm_π]
      ring
    have h_way1 : V_E ((k : ℤ) + 2)
        (galApply F hLE τ δ - IntermediateField.inclusion hLE a * δ) := by
      rwa [h_way1_eq]
    
    have h_pi_pow : ∀ j : ℕ,
        V_E ((j : ℤ) + 1)
          ((galApply F hLE τ π_E) ^ j -
            IntermediateField.inclusion hLE (a ^ j) * π_E ^ j) := by
      intro j
      induction j with
      | zero =>
        rw [pow_zero, pow_zero, map_one, pow_zero, one_mul, sub_self]
        exact Or.inl rfl
      | succ j ih =>
        have h_id : (galApply F hLE τ π_E) ^ (j + 1) -
            IntermediateField.inclusion hLE (a ^ (j + 1)) * π_E ^ (j + 1) =
            ((galApply F hLE τ π_E) ^ j -
              IntermediateField.inclusion hLE (a ^ j) * π_E ^ j) * galApply F hLE τ π_E +
            IntermediateField.inclusion hLE (a ^ j) * π_E ^ j * r_τ := by
          dsimp [r_τ]
          rw [pow_succ, pow_succ, pow_succ, map_mul]
          ring
        rw [h_id]
        have h_t1 : V_E (((j + 1 : ℕ) : ℤ) + 1)
            (((galApply F hLE τ π_E) ^ j -
              IntermediateField.inclusion hLE (a ^ j) * π_E ^ j) * galApply F hLE τ π_E) := by
          have h := hV_E_mul ih (hV_E_gal 1 τ hπ_E_V1)
          have heq : ((j : ℤ) + 1) + 1 = ((j + 1 : ℕ) : ℤ) + 1 := by
            push_cast
            ring
          rwa [heq] at h
        have h_aj_V0 : V_E 0 (IntermediateField.inclusion hLE (a ^ j)) := by
          right
          have h_aj_ne : a ^ j ≠ 0 := pow_ne_zero j ha_ne
          rw [valL_inclusion h_aj_ne, valL_L_pow ha_ne j, ha_val, mul_zero, mul_zero]
        have h_πj_Vj : V_E (j : ℤ) (π_E ^ j) := by
          right
          rw [valL_E_pow hπ_E_ne j, hπ_E, mul_one]
        have h_t2 : V_E (((j + 1 : ℕ) : ℤ) + 1)
            (IntermediateField.inclusion hLE (a ^ j) * π_E ^ j * r_τ) := by
          have h := hV_E_mul (hV_E_mul h_aj_V0 h_πj_Vj) hr_τ_V2
          have heq : (0 + (j : ℤ)) + 2 = ((j + 1 : ℕ) : ℤ) + 1 := by
            push_cast
            ring
          rwa [heq] at h
        exact hV_E_add h_t1 h_t2
    obtain ⟨c_δ, _, hc_δ_V1⟩ := h_lift u_δ hu_δ_V0
    have hτ_u_δ : V_E 1 (galApply F hLE τ u_δ - u_δ) := by
      have h_id : galApply F hLE τ u_δ - u_δ =
          galApply F hLE τ (u_δ - IntermediateField.inclusion hLE c_δ) -
            (u_δ - IntermediateField.inclusion hLE c_δ) := by
        rw [galApply_sub, galApply_inclusion]
        ring
      rw [h_id]
      exact hV_E_sub (hV_E_gal 1 τ hc_δ_V1) hc_δ_V1
    have h_way2_id : galApply F hLE τ δ -
        IntermediateField.inclusion hLE (a ^ (k + 1)) * δ =
        galApply F hLE τ u_δ *
          ((galApply F hLE τ π_E) ^ (k + 1) -
            IntermediateField.inclusion hLE (a ^ (k + 1)) * π_E ^ (k + 1)) +
        (galApply F hLE τ u_δ - u_δ) *
          IntermediateField.inclusion hLE (a ^ (k + 1)) * π_E ^ (k + 1) := by
      have h1 : galApply F hLE τ δ =
          galApply F hLE τ u_δ * (galApply F hLE τ π_E) ^ (k + 1) := by
        conv_lhs => rw [← hδ_decomp, galApply_mul_val, galApply_pow]
      rw [h1]
      conv_lhs => rw [← hδ_decomp]
      ring
    have h_way2 : V_E ((k : ℤ) + 2)
        (galApply F hLE τ δ - IntermediateField.inclusion hLE (a ^ (k + 1)) * δ) := by
      rw [h_way2_id]
      have h_t1 : V_E ((k : ℤ) + 2)
          (galApply F hLE τ u_δ *
            ((galApply F hLE τ π_E) ^ (k + 1) -
              IntermediateField.inclusion hLE (a ^ (k + 1)) * π_E ^ (k + 1))) := by
        have h_pow_k1 := h_pi_pow (k + 1)
        have h := hV_E_mul (hV_E_gal 0 τ hu_δ_V0) h_pow_k1
        have heq : 0 + (((k + 1 : ℕ) : ℤ) + 1) = (k : ℤ) + 2 := by
          push_cast
          ring
        rwa [heq] at h
      have h_ak1_V0 : V_E 0 (IntermediateField.inclusion hLE (a ^ (k + 1))) := by
        right
        have h_ak1_ne : a ^ (k + 1) ≠ 0 := pow_ne_zero (k + 1) ha_ne
        rw [valL_inclusion h_ak1_ne, valL_L_pow ha_ne (k + 1), ha_val, mul_zero, mul_zero]
      have h_t2 : V_E ((k : ℤ) + 2)
          ((galApply F hLE τ u_δ - u_δ) *
            IntermediateField.inclusion hLE (a ^ (k + 1)) * π_E ^ (k + 1)) := by
        have h := hV_E_mul (hV_E_mul hτ_u_δ h_ak1_V0) hπ_pow_Vk1
        have heq : (1 + 0) + ((k : ℤ) + 1) = (k : ℤ) + 2 := by ring
        rwa [heq] at h
      exact hV_E_add h_t1 h_t2
    
    have h_diff := hV_E_sub h_way1 h_way2
    have h_diff_eq :
        (galApply F hLE τ δ - IntermediateField.inclusion hLE a * δ) -
          (galApply F hLE τ δ - IntermediateField.inclusion hLE (a ^ (k + 1)) * δ) =
        IntermediateField.inclusion hLE (a ^ k - 1) *
          (IntermediateField.inclusion hLE a * δ) := by
      rw [pow_succ, map_mul, map_sub, map_one]
      ring
    rw [h_diff_eq] at h_diff
    have h_aδ_ne : IntermediateField.inclusion hLE a * δ ≠ 0 := mul_ne_zero h_inc_a_ne hδ_ne
    have h_aδ_inv_V : V_E (-((k : ℤ) + 1)) ((IntermediateField.inclusion hLE a * δ)⁻¹) := by
      right
      rw [valL_E_inv h_aδ_ne, valL_E_mul h_inc_a_ne hδ_ne, h_inc_a_val, hδ_val, zero_add]
    have h_mul := hV_E_mul h_diff h_aδ_inv_V
    have h_cancel :
        IntermediateField.inclusion hLE (a ^ k - 1) *
          (IntermediateField.inclusion hLE a * δ) *
          (IntermediateField.inclusion hLE a * δ)⁻¹ =
        IntermediateField.inclusion hLE (a ^ k - 1) :=
      mul_inv_cancel_right₀ h_aδ_ne _
    have heq : ((k : ℤ) + 2) + (-((k : ℤ) + 1)) = 1 := by ring
    rw [h_cancel, heq] at h_mul
    exact (hV_inclusion_iff_one (a ^ k - 1)).mp h_mul
  have h_dvd_wild_mul : ∀ u : ℕ, 1 ≤ u →
      Nat.card (lowerRamSubgroup F hLE (u + 1)) < Nat.card (lowerRamSubgroup F hLE u) →
      d ∣ Nat.card G₁ * herbrandSum F hLE u := by
    intro u hu hlt
    rw [hG_fin_card (u + 1), hG_fin_card u] at hlt
    have h_exists_jump : ∃ σ : G,
        σ ∈ lowerRamSubgroup F hLE u ∧ σ ∉ lowerRamSubgroup F hLE (u + 1) := by
      by_contra h_all
      push_neg at h_all
      have h_sub : G_fin u ⊆ G_fin (u + 1) := by
        intro σ hσ
        have hσ_u : σ ∈ lowerRamSubgroup F hLE u := (Finset.mem_filter.mp hσ).2
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ σ, h_all σ hσ_u⟩
      have h_le := Finset.card_le_card h_sub
      omega
    obtain ⟨σ_star, hσ_star_u, hσ_star_not_u1⟩ := h_exists_jump
    have hd_u : d ∣ Nat.card G₁ * u :=
      h_dvd_of_jump_elem u hu σ_star hσ_star_u hσ_star_not_u1
    let w_u : G → ℕ := fun σ =>
      ∑ k ∈ Finset.Icc 1 u, if σ ∈ lowerRamSubgroup F hLE k then 1 else 0
    have h_herbrand_eq : herbrandSum F hLE u = ∑ σ : G, w_u σ := by
      unfold herbrandSum
      have h_term : ∀ k : ℕ,
          Nat.card (lowerRamSubgroup F hLE k) =
            ∑ σ : G, (if σ ∈ lowerRamSubgroup F hLE k then 1 else 0) := by
        intro k
        rw [hG_fin_card k]
        dsimp [G_fin]
        rw [Finset.sum_boole, Nat.cast_id]
      simp_rw [h_term]
      exact Finset.sum_comm
    rw [h_herbrand_eq, Finset.mul_sum]
    apply Finset.dvd_sum
    intro σ _
    by_cases hσ_G1 : σ ∈ lowerRamSubgroup F hLE 1
    · by_cases hσ_Gu : σ ∈ lowerRamSubgroup F hLE u
      · have hw_eq : w_u σ = u := by
          dsimp [w_u]
          have h_all_mem : ∀ k ∈ Finset.Icc 1 u,
              (if σ ∈ lowerRamSubgroup F hLE k then 1 else 0) = 1 := by
            intro k hk
            have hk_le : k ≤ u := (Finset.mem_Icc.mp hk).2
            have hσ_Gk : σ ∈ lowerRamSubgroup F hLE k := by
              rw [hG_mem u σ] at hσ_Gu
              rw [hG_mem k σ]
              rcases hσ_Gu with h0 | hge
              · exact Or.inl h0
              · right
                omega
            rw [if_pos hσ_Gk]
          rw [Finset.sum_congr rfl h_all_mem]
          simp [Nat.card_Icc]
        rw [hw_eq]
        exact hd_u
      · have hσ_ne1 : σ ≠ 1 := fun h1 => hσ_Gu (h1 ▸ (lowerRamSubgroup F hLE u).one_mem)
        have hσ_ne_π : galApply F hLE σ π_E ≠ π_E := (hG_ne_full σ hσ_ne1).1
        set v_σ : ℤ := valL F E (galApply F hLE σ π_E - π_E)
        have hv_ge2 : 2 ≤ v_σ := by
          have h := ((hG_mem 1 σ).mp hσ_G1).resolve_left hσ_ne_π
          omega
        have hv_le_u : v_σ ≤ (u : ℤ) := by
          have h_not : ¬ ((u + 1 : ℤ) ≤ v_σ) :=
            fun hge => hσ_Gu ((hG_mem u σ).mpr (Or.inr hge))
          omega
        let k₀ : ℕ := v_σ.toNat - 1
        have hk₀_eq : (k₀ + 1 : ℤ) = v_σ := by omega
        have hk₀_ge1 : 1 ≤ k₀ := by omega
        have hk₀_lt_u : k₀ < u := by omega
        have hσ_k₀ : σ ∈ lowerRamSubgroup F hLE k₀ := by
          rw [hG_mem k₀ σ]
          right
          omega
        have hσ_not_k₀1 : σ ∉ lowerRamSubgroup F hLE (k₀ + 1) := by
          rw [hG_mem (k₀ + 1) σ]
          rintro (h0 | hge)
          · exact hσ_ne_π h0
          · push_cast at hge
            omega
        have hw_eq : w_u σ = k₀ := by
          dsimp [w_u]
          have h_iff : ∀ k : ℕ, σ ∈ lowerRamSubgroup F hLE k ↔ k ≤ k₀ := by
            intro k
            rw [hG_mem k σ, or_iff_right hσ_ne_π]
            omega
          simp_rw [h_iff]
          rw [← Finset.sum_filter]
          have h_filt : (Finset.Icc 1 u).filter (fun k => k ≤ k₀) = Finset.Icc 1 k₀ := by
            ext k
            simp only [Finset.mem_filter, Finset.mem_Icc]
            omega
          rw [h_filt]
          simp [Nat.card_Icc]
        rw [hw_eq]
        exact h_dvd_of_jump_elem k₀ hk₀_ge1 σ hσ_k₀ hσ_not_k₀1
    · have hw_eq : w_u σ = 0 := by
        dsimp [w_u]
        apply Finset.sum_eq_zero
        intro k hk
        have hk_ge1 : 1 ≤ k := (Finset.mem_Icc.mp hk).1
        have hσ_not_Gk : σ ∉ lowerRamSubgroup F hLE k := by
          intro hσ_Gk
          apply hσ_G1
          rw [hG_mem k σ] at hσ_Gk
          rw [hG_mem 1 σ]
          rcases hσ_Gk with h0 | hge
          · exact Or.inl h0
          · right
            omega
        rw [if_neg hσ_not_Gk]
      rw [hw_eq, mul_zero]
      exact dvd_zero d
  exact ⟨h_wild_pow, h_coprime, h_dvd_tame, h_dvd_wild_mul⟩

theorem exists_subextension_cyclic_quotient_herbrandSum_eq (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E] (hLE : L ≤ E) :
    IsAbelianExt F hLE →
    ∀ (π_E : E),
    (∀ (u : ℕ) (σ : (IntermediateField.extendScalars hLE) ≃ₐ[L]
        (IntermediateField.extendScalars hLE)),
      σ ∈ lowerRamSubgroup F hLE u ↔
        galApply F hLE σ π_E = π_E ∨ (u + 1 : ℤ) ≤ valL F E (galApply F hLE σ π_E - π_E)) →
    (∀ σ : (IntermediateField.extendScalars hLE) ≃ₐ[L] (IntermediateField.extendScalars hLE),
      σ ≠ 1 → galApply F hLE σ π_E ≠ π_E ∧ 1 ≤ valL F E (galApply F hLE σ π_E - π_E)) →
    (∀ (k : ℕ), 1 ≤ k → ∀ σ ∈ lowerRamSubgroup F hLE k,
      σ ^ (p F) ∈ lowerRamSubgroup F hLE (k + 1)) →
    ∀ u : ℕ, 1 ≤ u →
      Nat.card (lowerRamSubgroup F hLE (u + 1)) < Nat.card (lowerRamSubgroup F hLE u) →
      ∃ (M : IntermediateField F (AlgebraicClosure F)) (hLM : L ≤ M) (hME : M ≤ E) (m : ℕ)
        (σ₀ : (IntermediateField.extendScalars (hLM.trans hME)) ≃ₐ[L]
          (IntermediateField.extendScalars (hLM.trans hME))),
        1 ≤ m ∧
        ∀ (res : ((IntermediateField.extendScalars (hLM.trans hME)) ≃ₐ[L]
            (IntermediateField.extendScalars (hLM.trans hME))) →*
          ((IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM)))
        (H : Finset ((IntermediateField.extendScalars (hLM.trans hME)) ≃ₐ[L]
            (IntermediateField.extendScalars (hLM.trans hME))))
        (π_M : M),
        (∀ τ, τ ∈ H ↔ res τ = 1) →
        (∀ σ y,
          galApply F (hLM.trans hME) σ (IntermediateField.inclusion hME y) =
            IntermediateField.inclusion hME (galApply F hLM (res σ) y)) →
        (∀ σ, res σ ≠ 1 →
          ∑ τ ∈ H, ((valL F E (galApply F (hLM.trans hME) (σ * τ) π_E - π_E)).toNat - 1) =
            H.card * ((valL F M (galApply F hLM (res σ) π_M - π_M)).toNat - 1)) →
        (res σ₀) ^ ((p F) ^ m) = 1 ∧
        (∀ r : ℕ, 1 ≤ r → r < (p F) ^ m → (res σ₀) ^ r ≠ 1) ∧
        1 ≤ (valL F M (galApply F hLM (res σ₀) π_M - π_M)).toNat - 1 ∧
        Nat.card (lowerRamSubgroup F hLE 1) = H.card * (p F) ^ m ∧
        herbrandSum F hLE u =
          H.card * (((valL F M (galApply F hLM ((res σ₀) ^ ((p F) ^ (m - 1))) π_M - π_M)).toNat - 1) +
            ∑ r ∈ Finset.Icc 1 ((p F) ^ m - 1),
              ((valL F M (galApply F hLM ((res σ₀) ^ r) π_M - π_M)).toNat - 1)) :=
by
  
  have h_abs_group :
      ∀ (G : Type u) [CommGroup G] [Fintype G]
        (G_ram : ℕ → Subgroup G) (u_G : G → ℕ) (p₀ u : ℕ),
        Nat.Prime p₀ →
        1 ≤ u →
        (∀ (k : ℕ) (ρ : G), ρ ≠ 1 → (ρ ∈ G_ram k ↔ k ≤ u_G ρ)) →
        (∀ {k₁ k₂ : ℕ}, k₁ ≤ k₂ → G_ram k₂ ≤ G_ram k₁) →
        (∀ (k : ℕ), 1 ≤ k → ∀ σ ∈ G_ram k, σ ^ p₀ ∈ G_ram (k + 1)) →
        Nat.card (G_ram (u + 1)) < Nat.card (G_ram u) →
        ∃ (H_sub : Subgroup G) (m : ℕ) (σ₀ : G),
          1 ≤ m ∧
          σ₀ ^ (p₀ ^ m) ∈ H_sub ∧
          (∀ r : ℕ, 1 ≤ r → r < p₀ ^ m → σ₀ ^ r ∉ H_sub) ∧
          ∀ (H : Finset G) (f : ℕ → ℕ),
            (∀ τ : G, τ ∈ H ↔ τ ∈ H_sub) →
            (∀ r : ℕ, 1 ≤ r → r < p₀ ^ m → ∑ τ ∈ H, u_G (σ₀ ^ r * τ) = H.card * f r) →
            1 ≤ f 1 ∧
            Nat.card (G_ram 1) = H.card * p₀ ^ m ∧
            ∑ k ∈ Finset.Icc 1 u, Nat.card (G_ram k) =
              H.card * (f (p₀ ^ (m - 1)) + ∑ r ∈ Finset.Icc 1 (p₀ ^ m - 1), f r) := by
    clear * -
    intro G _ _ G_ram u_G p₀ u hp hu hG_iff hG_anti h_wild_pow hlt
    have hp_two : 2 ≤ p₀ := hp.two_le
    have h_bez_nat : ∀ (c N : ℕ), c.gcd N < N →
        ∃ a q : ℕ, a < N ∧ c * a = N * q + c.gcd N := by
      intro c N hd_lt
      have hN_pos : 0 < N := by omega
      have hN_z : (0 : ℤ) < (N : ℤ) := by omega
      set d := c.gcd N
      let u_z : ℤ := c.gcdA N
      let v_z : ℤ := c.gcdB N
      have h_bez : (d : ℤ) = (c : ℤ) * u_z + (N : ℤ) * v_z := Nat.gcd_eq_gcd_ab c N
      let a : ℕ := (u_z % (N : ℤ)).toNat
      have hu_nonneg : 0 ≤ u_z % (N : ℤ) := Int.emod_nonneg u_z (by omega)
      have hu_lt : u_z % (N : ℤ) < (N : ℤ) := Int.emod_lt_of_pos u_z hN_z
      have ha_z : (a : ℤ) = u_z % (N : ℤ) := Int.toNat_of_nonneg hu_nonneg
      have ha_lt : a < N := by omega
      have hu_div : u_z % (N : ℤ) + (N : ℤ) * (u_z / (N : ℤ)) = u_z :=
        Int.emod_add_mul_ediv u_z (N : ℤ)
      have h_ca : (c : ℤ) * (a : ℤ) =
          (d : ℤ) + (-(c : ℤ) * (u_z / (N : ℤ)) - v_z) * (N : ℤ) := by
        linear_combination -h_bez + (c : ℤ) * hu_div + (c : ℤ) * ha_z
      have h_mod_z : ((c * a : ℕ) : ℤ) % (N : ℤ) = ((d : ℕ) : ℤ) % (N : ℤ) := by
        push_cast
        rw [h_ca, Int.add_mul_emod_self_right]
      have h_mod : (c * a) % N = d := by
        have h1 : (((c * a) % N : ℕ) : ℤ) = ((d % N : ℕ) : ℤ) := by
          simpa [Int.natCast_emod] using h_mod_z
        have h2 : (c * a) % N = d % N := Int.ofNat.inj h1
        rwa [Nat.mod_eq_of_lt hd_lt] at h2
      refine ⟨a, (c * a) / N, ha_lt, ?_⟩
      have h_div := Nat.div_add_mod (c * a) N
      omega
    obtain ⟨U, hU_pos, hG1_pow_pU⟩ :
        ∃ U : ℕ, 0 < U ∧ ∀ σ ∈ G_ram 1, σ ^ (p₀ ^ U) = 1 := by
      let U₀ : ℕ := Finset.univ.sup u_G + 1
      have hGU_bot : ∀ ρ ∈ G_ram U₀, ρ = (1 : G) := by
        intro ρ hρ
        by_contra hne
        have h_le : U₀ ≤ u_G ρ := (hG_iff U₀ ρ hne).mp hρ
        have h_sup : u_G ρ ≤ Finset.univ.sup u_G :=
          Finset.le_sup (f := u_G) (Finset.mem_univ ρ)
        dsimp only [U₀] at h_le
        omega
      have h_pow_p_mem : ∀ (j : ℕ), ∀ σ ∈ G_ram 1,
          σ ^ (p₀ ^ j) ∈ G_ram (1 + j) := by
        intro j
        induction j with
        | zero =>
          intro σ hσ
          simpa using hσ
        | succ j ih =>
          intro σ hσ
          rw [pow_succ, pow_mul, ← Nat.add_assoc]
          exact h_wild_pow (1 + j) (by omega) (σ ^ (p₀ ^ j)) (ih σ hσ)
      refine ⟨U₀, Nat.succ_pos _, fun σ hσ => ?_⟩
      exact hGU_bot _ (hG_anti (by omega : U₀ ≤ 1 + U₀) (h_pow_p_mem U₀ σ hσ))
    have h_exists_σstar : ∃ σ ∈ G_ram u, σ ∉ G_ram (u + 1) := by
      by_contra h_all
      push_neg at h_all
      have h_card_le : Nat.card (G_ram u) ≤ Nat.card (G_ram (u + 1)) :=
        Subgroup.card_le_of_le h_all
      omega
    obtain ⟨σstar, hσstar_Gu, hσstar_not_Gu1⟩ := h_exists_σstar
    have hσstar_G1 : σstar ∈ G_ram 1 := hG_anti hu hσstar_Gu
    have hσstar_p : σstar ^ p₀ ∈ G_ram (u + 1) := h_wild_pow u hu σstar hσstar_Gu
    obtain ⟨H_sub, hGu1_le_H, hH_le_G1, hσstar_not_H, hH_max⟩ :
        ∃ H_sub : Subgroup G,
          G_ram (u + 1) ≤ H_sub ∧
          H_sub ≤ G_ram 1 ∧
          σstar ∉ H_sub ∧
          ∀ (K : Subgroup G), H_sub ≤ K → K ≤ G_ram 1 →
            (∃ w ∈ K, w ∉ H_sub) → σstar ∈ K := by
      let IsValidSub : Subgroup G → Prop := fun K =>
        G_ram (u + 1) ≤ K ∧ K ≤ G_ram 1 ∧ σstar ∉ K
      let subCard : Subgroup G → ℕ := fun K =>
        (Finset.univ.filter (fun g : G => g ∈ K)).card
      let S_card : Finset ℕ :=
        (Finset.Icc 0 (Fintype.card G)).filter
          (fun n => ∃ K : Subgroup G, IsValidSub K ∧ subCard K = n)
      have hGu1_valid : IsValidSub (G_ram (u + 1)) :=
        ⟨le_refl _, hG_anti (by omega), hσstar_not_Gu1⟩
      have hGu1_mem_S : subCard (G_ram (u + 1)) ∈ S_card := by
        rw [Finset.mem_filter, Finset.mem_Icc]
        refine ⟨⟨Nat.zero_le _, (Finset.card_filter_le _ _).trans_eq Finset.card_univ⟩,
          ⟨G_ram (u + 1), hGu1_valid, rfl⟩⟩
      have hS_ne : S_card.Nonempty := ⟨_, hGu1_mem_S⟩
      obtain ⟨n_max, hn_max_mem, hn_max_le⟩ :
          ∃ n_max ∈ S_card, ∀ x ∈ S_card, x ≤ n_max :=
        ⟨S_card.max' hS_ne, Finset.max'_mem S_card hS_ne, fun x hx => Finset.le_max' S_card x hx⟩
      obtain ⟨H_sub, ⟨hGu1_le_H, hH_le_G1, hσstar_not_H⟩, hH_card_max⟩ :=
        (Finset.mem_filter.mp hn_max_mem).2
      refine ⟨H_sub, hGu1_le_H, hH_le_G1, hσstar_not_H, ?_⟩
      intro K hHK hKG1 ⟨w, hwK, hwH⟩
      by_contra hσK
      have hK_valid : IsValidSub K := ⟨hGu1_le_H.trans hHK, hKG1, hσK⟩
      have hK_mem_S : subCard K ∈ S_card := by
        rw [Finset.mem_filter, Finset.mem_Icc]
        refine ⟨⟨Nat.zero_le _, (Finset.card_filter_le _ _).trans_eq Finset.card_univ⟩,
          ⟨K, hK_valid, rfl⟩⟩
      have h_le_max : subCard K ≤ n_max := hn_max_le (subCard K) hK_mem_S
      have h_ssub : Finset.univ.filter (fun g : G => g ∈ H_sub) ⊂
          Finset.univ.filter (fun g : G => g ∈ K) := by
        rw [Finset.ssubset_iff_subset_ne]
        refine ⟨fun g hg => ?_, fun h_eq => ?_⟩
        · rw [Finset.mem_filter] at hg ⊢
          exact ⟨hg.1, hHK hg.2⟩
        · have hw_in : w ∈ Finset.univ.filter (fun g : G => g ∈ K) :=
            Finset.mem_filter.mpr ⟨Finset.mem_univ w, hwK⟩
          rw [← h_eq, Finset.mem_filter] at hw_in
          exact hwH hw_in.2
      have h_lt : subCard H_sub < subCard K := Finset.card_lt_card h_ssub
      omega
    have h_order_p_rel : ∀ w ∈ G_ram 1, w ∉ H_sub → w ^ p₀ ∈ H_sub →
        (∃ c < p₀, ∃ h ∈ H_sub, σstar = w ^ c * h) ∧
        (∃ a < p₀, ∃ k ∈ H_sub, w = σstar ^ a * k) := by
      intro w hwG1 hw_not hw_p
      let extSubgroup : Subgroup G :=
        { carrier := {g : G | ∃ c < p₀, ∃ h ∈ H_sub, g = w ^ c * h}
          one_mem' := ⟨0, hp.pos, 1, H_sub.one_mem, by simp⟩
          mul_mem' := by
            rintro g₁ g₂ ⟨c₁, hc₁, h₁, hh₁, rfl⟩ ⟨c₂, hc₂, h₂, hh₂, rfl⟩
            have h_prod : (w ^ c₁ * h₁) * (w ^ c₂ * h₂) = w ^ (c₁ + c₂) * (h₁ * h₂) := by
              rw [mul_mul_mul_comm, ← pow_add]
            by_cases h_lt : c₁ + c₂ < p₀
            · exact ⟨c₁ + c₂, h_lt, h₁ * h₂, H_sub.mul_mem hh₁ hh₂, h_prod⟩
            · refine ⟨c₁ + c₂ - p₀, by omega, w ^ p₀ * (h₁ * h₂),
                H_sub.mul_mem hw_p (H_sub.mul_mem hh₁ hh₂), ?_⟩
              have h_add : c₁ + c₂ = (c₁ + c₂ - p₀) + p₀ := by omega
              conv_lhs => rw [h_prod, h_add, pow_add, mul_assoc]
          inv_mem' := by
            rintro g ⟨c, hc, h, hh, rfl⟩
            by_cases hc0 : c = 0
            · refine ⟨0, hp.pos, h⁻¹, H_sub.inv_mem hh, ?_⟩
              rw [hc0, pow_zero, one_mul, one_mul]
            · refine ⟨p₀ - c, by omega, (w ^ p₀)⁻¹ * h⁻¹,
                H_sub.mul_mem (H_sub.inv_mem hw_p) (H_sub.inv_mem hh), ?_⟩
              apply mul_eq_one_iff_inv_eq.mp
              have h_add : c + (p₀ - c) = p₀ := by omega
              calc (w ^ c * h) * (w ^ (p₀ - c) * ((w ^ p₀)⁻¹ * h⁻¹))
                _ = (w ^ c * w ^ (p₀ - c)) * (h * ((w ^ p₀)⁻¹ * h⁻¹)) :=
                    mul_mul_mul_comm _ _ _ _
                _ = w ^ p₀ * ((w ^ p₀)⁻¹ * (h * h⁻¹)) := by
                    rw [← pow_add, h_add, ← mul_assoc h, mul_comm h (w ^ p₀)⁻¹, mul_assoc]
                _ = 1 := by group }
      have h_le1 : H_sub ≤ extSubgroup := fun g hg => ⟨0, hp.pos, g, hg, by simp⟩
      have h_le2 : extSubgroup ≤ G_ram 1 := by
        rintro g ⟨c, _, h, hh, rfl⟩
        exact (G_ram 1).mul_mem ((G_ram 1).pow_mem hwG1 c) (hH_le_G1 hh)
      have hw_ext : w ∈ extSubgroup := ⟨1, hp_two, 1, H_sub.one_mem, by simp⟩
      have hσ_ext : σstar ∈ extSubgroup :=
        hH_max extSubgroup h_le1 h_le2 ⟨w, hw_ext, hw_not⟩
      rcases hσ_ext with ⟨c, hc_lt, h, hh_H, hσ_eq⟩
      refine ⟨⟨c, hc_lt, h, hh_H, hσ_eq⟩, ?_⟩
      have hc_pos : 0 < c := by
        by_contra hc0
        have hc_eq0 : c = 0 := by omega
        rw [hc_eq0, pow_zero, one_mul] at hσ_eq
        rw [hσ_eq] at hσstar_not_H
        exact hσstar_not_H hh_H
      have h_not_dvd : ¬ (p₀ ∣ c) := Nat.not_dvd_of_pos_of_lt hc_pos hc_lt
      have h_cop : c.gcd p₀ = 1 :=
        Nat.coprime_comm.mp ((hp.coprime_iff_not_dvd).mpr h_not_dvd)
      have hd_lt : c.gcd p₀ < p₀ := by rw [h_cop]; exact hp_two
      obtain ⟨a, q, ha_lt, h_ca⟩ := h_bez_nat c p₀ hd_lt
      rw [h_cop] at h_ca
      have hwc : w ^ c = σstar * h⁻¹ := by
        rw [hσ_eq, mul_inv_cancel_right]
      have h_pow_a : (w ^ c) ^ a = σstar ^ a * (h⁻¹) ^ a := by
        rw [hwc, mul_pow]
      have h_lhs : (w ^ c) ^ a = w * (w ^ p₀) ^ q := by
        rw [← pow_mul, h_ca, add_comm, pow_add, pow_one, pow_mul]
      rw [h_lhs] at h_pow_a
      have hw_eq : w = σstar ^ a * ((h⁻¹) ^ a * ((w ^ p₀) ^ q)⁻¹) := by
        calc w = (w * (w ^ p₀) ^ q) * ((w ^ p₀) ^ q)⁻¹ := by group
          _ = (σstar ^ a * (h⁻¹) ^ a) * ((w ^ p₀) ^ q)⁻¹ := by rw [h_pow_a]
          _ = σstar ^ a * ((h⁻¹) ^ a * ((w ^ p₀) ^ q)⁻¹) := by group
      exact ⟨a, ha_lt, (h⁻¹) ^ a * ((w ^ p₀) ^ q)⁻¹,
        H_sub.mul_mem (H_sub.pow_mem (H_sub.inv_mem hh_H) a)
          (H_sub.inv_mem (H_sub.pow_mem hw_p q)), hw_eq⟩
    obtain ⟨k_max, σ₀, hσ0_G1, hσ0_not, hG1_pow_pm⟩ :
        ∃ (k_max : ℕ) (σ₀ : G),
          σ₀ ∈ G_ram 1 ∧
          σ₀ ^ (p₀ ^ k_max) ∉ H_sub ∧
          ∀ g ∈ G_ram 1, g ^ (p₀ ^ (k_max + 1)) ∈ H_sub := by
      let E_exp : Finset ℕ :=
        (Finset.range U).filter (fun k => ∃ g ∈ G_ram 1, g ^ (p₀ ^ k) ∉ H_sub)
      have h0_mem_E : 0 ∈ E_exp := by
        rw [Finset.mem_filter, Finset.mem_range]
        exact ⟨hU_pos, ⟨σstar, hσstar_G1, by simpa using hσstar_not_H⟩⟩
      have hE_ne : E_exp.Nonempty := ⟨0, h0_mem_E⟩
      obtain ⟨k_max, hk_max_mem, hk_max_le⟩ :
          ∃ k_max ∈ E_exp, ∀ x ∈ E_exp, x ≤ k_max :=
        ⟨E_exp.max' hE_ne, Finset.max'_mem E_exp hE_ne, fun x hx => Finset.le_max' E_exp x hx⟩
      rw [Finset.mem_filter, Finset.mem_range] at hk_max_mem
      obtain ⟨hk_max_lt, σ₀, hσ0_G1, hσ0_not⟩ := hk_max_mem
      refine ⟨k_max, σ₀, hσ0_G1, hσ0_not, ?_⟩
      intro g hg
      by_cases hmU : k_max + 1 < U
      · by_contra hg_not
        have hm_in : k_max + 1 ∈ E_exp :=
          Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hmU, ⟨g, hg, hg_not⟩⟩
        have h_le : k_max + 1 ≤ k_max := hk_max_le (k_max + 1) hm_in
        omega
      · have hm_eq : k_max + 1 = U := by omega
        rw [hm_eq, hG1_pow_pU g hg]
        exact H_sub.one_mem
    let m : ℕ := k_max + 1
    have hm : 1 ≤ m := Nat.le_add_left 1 k_max
    have hm_sub : m - 1 = k_max := Nat.add_sub_cancel k_max 1
    have hσ0_pow_not_mem : ∀ r : ℕ, 1 ≤ r → r < p₀ ^ m → σ₀ ^ r ∉ H_sub := by
      intro r hr1 hr2 hr_mem
      set d := r.gcd (p₀ ^ m)
      obtain ⟨k, hk_le, hd_eq⟩ := (Nat.dvd_prime_pow hp).mp (Nat.gcd_dvd_right r (p₀ ^ m))
      have hd_le_r : d ≤ r := Nat.le_of_dvd (by omega) (Nat.gcd_dvd_left r (p₀ ^ m))
      have hd_lt : d < p₀ ^ m := lt_of_le_of_lt hd_le_r hr2
      have hk_lt : k < m := by
        by_contra h_ge
        have hk_eq : k = m := by omega
        rw [hk_eq] at hd_eq
        omega
      obtain ⟨a, q, _, h_ra⟩ := h_bez_nat r (p₀ ^ m) hd_lt
      have h_pow_ra : (σ₀ ^ r) ^ a = (σ₀ ^ (p₀ ^ m)) ^ q * σ₀ ^ d := by
        rw [← pow_mul, h_ra, pow_add, pow_mul]
      have h_d_mem : σ₀ ^ d ∈ H_sub := by
        have h_eq : σ₀ ^ d = ((σ₀ ^ (p₀ ^ m)) ^ q)⁻¹ * (σ₀ ^ r) ^ a := by
          rw [h_pow_ra, inv_mul_cancel_left]
        rw [h_eq]
        exact H_sub.mul_mem (H_sub.inv_mem (H_sub.pow_mem (hG1_pow_pm σ₀ hσ0_G1) q))
          (H_sub.pow_mem hr_mem a)
      have h_k_add : k + (k_max - k) = k_max := by omega
      have h_kmax_mem : σ₀ ^ (p₀ ^ k_max) ∈ H_sub := by
        rw [← h_k_add, pow_add, pow_mul, ← hd_eq]
        exact H_sub.pow_mem h_d_mem (p₀ ^ (k_max - k))
      exact hσ0_not h_kmax_mem
    set z₀ : G := σ₀ ^ (p₀ ^ k_max)
    have hz₀_G1 : z₀ ∈ G_ram 1 := (G_ram 1).pow_mem hσ0_G1 (p₀ ^ k_max)
    have hz₀_p : z₀ ^ p₀ ∈ H_sub := by
      change (σ₀ ^ (p₀ ^ k_max)) ^ p₀ ∈ H_sub
      rw [← pow_mul, ← pow_succ]
      exact hG1_pow_pm σ₀ hσ0_G1
    obtain ⟨⟨c₀, hc₀_lt, h₀, hh₀_H, hσstar_z₀⟩, ⟨a₀, ha₀_lt, τ₀, hτ₀_H, hz₀_σstar⟩⟩ :=
      h_order_p_rel z₀ hz₀_G1 hσ0_not hz₀_p
    let σ₁ : G := σstar ^ a₀
    have hσ₁_Gu : σ₁ ∈ G_ram u := (G_ram u).pow_mem hσstar_Gu a₀
    have h_elem_p_in_z₀ : ∀ w ∈ G_ram 1, w ^ p₀ ∈ H_sub →
        ∃ d : ℕ, ∃ h ∈ H_sub, w = z₀ ^ d * h := by
      intro w hwG1 hw_p
      by_cases hw_H : w ∈ H_sub
      · exact ⟨0, w, hw_H, by simp⟩
      · obtain ⟨_, ⟨a, _, k_w, hk_w, rfl⟩⟩ := h_order_p_rel w hwG1 hw_H hw_p
        refine ⟨c₀ * a, h₀ ^ a * k_w, H_sub.mul_mem (H_sub.pow_mem hh₀_H a) hk_w, ?_⟩
        rw [hσstar_z₀, mul_pow, ← pow_mul, mul_assoc]
    have h_gen_ind : ∀ k : ℕ, k ≤ m → ∀ g ∈ G_ram 1,
        g ^ (p₀ ^ k) ∈ H_sub → ∃ r₀ : ℕ, ∃ τ ∈ H_sub, g = σ₀ ^ r₀ * τ := by
      intro k
      induction k with
      | zero =>
        intro _ g _ hg0
        exact ⟨0, g, by simpa using hg0, by simp⟩
      | succ k ih =>
        intro hk_le g hgG1 hgk1
        let w : G := g ^ (p₀ ^ k)
        have hw_G1 : w ∈ G_ram 1 := (G_ram 1).pow_mem hgG1 (p₀ ^ k)
        have hw_p : w ^ p₀ ∈ H_sub := by
          change (g ^ (p₀ ^ k)) ^ p₀ ∈ H_sub
          rw [← pow_mul, ← pow_succ]
          exact hgk1
        obtain ⟨d, h, hh_H, hw_eq⟩ := h_elem_p_in_z₀ w hw_G1 hw_p
        let s : ℕ := d * p₀ ^ (k_max - k)
        have h_ks : p₀ ^ k * s = p₀ ^ k_max * d := by
          dsimp only [s]
          have hk_add : k + (k_max - k) = k_max := by omega
          calc p₀ ^ k * (d * p₀ ^ (k_max - k))
            _ = (p₀ ^ k * p₀ ^ (k_max - k)) * d := by ring
            _ = p₀ ^ k_max * d := by rw [← pow_add, hk_add]
        have h_pow_s : (σ₀ ^ s) ^ (p₀ ^ k) = z₀ ^ d := by
          rw [← pow_mul, mul_comm s, h_ks, pow_mul]
        let g' : G := g * (σ₀ ^ s)⁻¹
        have hg'_G1 : g' ∈ G_ram 1 :=
          (G_ram 1).mul_mem hgG1 ((G_ram 1).inv_mem ((G_ram 1).pow_mem hσ0_G1 s))
        have hg'_pow : g' ^ (p₀ ^ k) ∈ H_sub := by
          have h_eq : g' ^ (p₀ ^ k) = h := by
            dsimp only [g']
            rw [mul_pow, inv_pow, h_pow_s]
            change w * (z₀ ^ d)⁻¹ = h
            rw [hw_eq, mul_comm (z₀ ^ d) h, mul_inv_cancel_right]
          rw [h_eq]
          exact hh_H
        obtain ⟨r', τ', hτ'_H, hg'_eq⟩ := ih (by omega) g' hg'_G1 hg'_pow
        refine ⟨r' + s, τ', hτ'_H, ?_⟩
        calc g = g' * σ₀ ^ s := by dsimp only [g']; group
          _ = (σ₀ ^ r' * τ') * σ₀ ^ s := by rw [hg'_eq]
          _ = σ₀ ^ (r' + s) * τ' := by
              rw [mul_assoc, mul_comm τ' (σ₀ ^ s), ← mul_assoc, ← pow_add]
    have hpm_pos : 0 < p₀ ^ m := pow_pos hp.pos m
    have h1_lt_pm : 1 < p₀ ^ m := one_lt_pow₀ hp_two (by omega)
    have hG1_coset_gen : ∀ g ∈ G_ram 1,
        ∃ r < p₀ ^ m, ∃ τ ∈ H_sub, g = σ₀ ^ r * τ := by
      intro g hgG1
      obtain ⟨r₀, τ', hτ'_H, hg_eq⟩ := h_gen_ind m (le_refl m) g hgG1 (hG1_pow_pm g hgG1)
      let r : ℕ := r₀ % p₀ ^ m
      let q : ℕ := r₀ / p₀ ^ m
      refine ⟨r, Nat.mod_lt r₀ hpm_pos, (σ₀ ^ (p₀ ^ m)) ^ q * τ',
        H_sub.mul_mem (H_sub.pow_mem (hG1_pow_pm σ₀ hσ0_G1) q) hτ'_H, ?_⟩
      have h_div : r + p₀ ^ m * q = r₀ := Nat.mod_add_div r₀ (p₀ ^ m)
      rw [hg_eq, ← h_div, pow_add, pow_mul, mul_assoc]
    refine ⟨H_sub, m, σ₀, hm, hG1_pow_pm σ₀ hσ0_G1, hσ0_pow_not_mem, ?_⟩
    intro H f hH_iff_sub h_coset_r
    
    have hf1_pos : 1 ≤ f 1 := by
      have h_sum1 := h_coset_r 1 (le_refl 1) h1_lt_pm
      rw [pow_one] at h_sum1
      have h1_H : (1 : G) ∈ H := (hH_iff_sub 1).mpr H_sub.one_mem
      have hσ0_not_H : σ₀ ∉ H_sub := by
        simpa using hσ0_pow_not_mem 1 (le_refl 1) h1_lt_pm
      have hσ0_ne1 : σ₀ ≠ 1 := fun h1 => hσ0_not_H (h1 ▸ H_sub.one_mem)
      have hu_σ0 : 1 ≤ u_G (σ₀ * 1) := by
        rw [mul_one]
        exact (hG_iff 1 σ₀ hσ0_ne1).mp hσ0_G1
      have h_le_sum : u_G (σ₀ * 1) ≤ ∑ τ ∈ H, u_G (σ₀ * τ) :=
        Finset.single_le_sum (f := fun τ => u_G (σ₀ * τ)) (fun _ _ => Nat.zero_le _) h1_H
      have h_prod_pos : 1 ≤ H.card * f 1 := by omega
      by_contra h_not
      have hf0 : f 1 = 0 := by omega
      rw [hf0, mul_zero] at h_prod_pos
      omega
    
    let G1_fin : Finset G := Finset.univ.filter (fun g : G => g ∈ G_ram 1)
    let S_prod : Finset (ℕ × G) := Finset.range (p₀ ^ m) ×ˢ H
    have h_bij_maps : ∀ p ∈ S_prod, σ₀ ^ p.1 * p.2 ∈ G1_fin := by
      intro p hp_mem
      rw [Finset.mem_product] at hp_mem
      rw [Finset.mem_filter]
      refine ⟨Finset.mem_univ _, ?_⟩
      exact (G_ram 1).mul_mem ((G_ram 1).pow_mem hσ0_G1 p.1)
        (hH_le_G1 ((hH_iff_sub p.2).mp hp_mem.2))
    have h_lt_ne : ∀ r₁ r₂ : ℕ, r₁ < r₂ → r₂ < p₀ ^ m →
        ∀ τ₁ ∈ H_sub, ∀ τ₂ ∈ H_sub, σ₀ ^ r₁ * τ₁ ≠ σ₀ ^ r₂ * τ₂ := by
      intro r₁ r₂ hr_lt hr₂_lt τ₁ hτ₁ τ₂ hτ₂ h_eq
      have h_add : r₁ + (r₂ - r₁) = r₂ := by omega
      have h_eq2 : σ₀ ^ r₁ * τ₁ = σ₀ ^ r₁ * (σ₀ ^ (r₂ - r₁) * τ₂) := by
        rw [← mul_assoc, ← pow_add, h_add]
        exact h_eq
      have h_τ1 : τ₁ = σ₀ ^ (r₂ - r₁) * τ₂ := mul_left_cancel h_eq2
      have h_pow_eq : σ₀ ^ (r₂ - r₁) = τ₁ * τ₂⁻¹ := by
        rw [h_τ1, mul_inv_cancel_right]
      have h_mem : σ₀ ^ (r₂ - r₁) ∈ H_sub := by
        rw [h_pow_eq]
        exact H_sub.mul_mem hτ₁ (H_sub.inv_mem hτ₂)
      exact hσ0_pow_not_mem (r₂ - r₁) (by omega) (by omega) h_mem
    have h_bij_inj : ∀ p₁ ∈ S_prod, ∀ p₂ ∈ S_prod,
        σ₀ ^ p₁.1 * p₁.2 = σ₀ ^ p₂.1 * p₂.2 → p₁ = p₂ := by
      rintro ⟨r₁, τ₁⟩ hp₁ ⟨r₂, τ₂⟩ hp₂ h_eq
      rw [Finset.mem_product, Finset.mem_range, hH_iff_sub] at hp₁ hp₂
      have hr_eq : r₁ = r₂ := by
        rcases lt_trichotomy r₁ r₂ with hlt_r | rfl | hgt_r
        · exact False.elim (h_lt_ne r₁ r₂ hlt_r hp₂.1 τ₁ hp₁.2 τ₂ hp₂.2 h_eq)
        · rfl
        · exact False.elim (h_lt_ne r₂ r₁ hgt_r hp₁.1 τ₂ hp₂.2 τ₁ hp₁.2 h_eq.symm)
      subst hr_eq
      exact Prod.ext rfl (mul_left_cancel h_eq)
    have h_bij_surj : ∀ g ∈ G1_fin, ∃ p, ∃ (_ : p ∈ S_prod), σ₀ ^ p.1 * p.2 = g := by
      intro g hg
      rw [Finset.mem_filter] at hg
      obtain ⟨r, hr_lt, τ, hτ_H, rfl⟩ := hG1_coset_gen g hg.2
      exact ⟨⟨r, τ⟩, Finset.mem_product.mpr ⟨Finset.mem_range.mpr hr_lt,
        (hH_iff_sub τ).mpr hτ_H⟩, rfl⟩
    have h_card_G1 : Nat.card (G_ram 1) = H.card * p₀ ^ m := by
      have h1 : Nat.card (G_ram 1) = G1_fin.card := by
        rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
      have h2 : S_prod.card = G1_fin.card :=
        Finset.card_bij (fun (p : ℕ × G) _ => σ₀ ^ p.1 * p.2) h_bij_maps h_bij_inj h_bij_surj
