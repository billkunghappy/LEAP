    rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt]
    · exact Polynomial.natDegree_X_pow (qL F L)
    · rw [Polynomial.natDegree_X, Polynomial.natDegree_X_pow]
      exact hqL_gt
  have hL_rep : ∀ c : L, V_L 0 c → ∃ a ∈ S, V_L 1 (c - a) := by
    intro c hc
    by_contra h_none
    push_neg at h_none
    have hc_not_mem : c ∉ S := by
      intro hc_mem
      have h0 : V_L 1 (c - c) := by
        rw [sub_self]
        exact Or.inl rfl
      exact h_none c hc_mem h0
    have h_val_ca : ∀ a ∈ S, valL F L (c - a) = 0 ∧ valL F L (a - c) = 0 := by
      intro a ha
      have h_sub_V0 : V_L 0 (c - a) := hV_L_sub hc (hS_int a ha)
      have h_not_V1 : ¬ V_L 1 (c - a) := h_none a ha
      have h_ne0 : c - a ≠ 0 := fun h0 => h_not_V1 (Or.inl h0)
      have h_ge0 : 0 ≤ valL F L (c - a) := h_sub_V0.resolve_left h_ne0
      have h_lt1 : valL F L (c - a) < 1 := by
        by_contra h_ge1
        exact h_not_V1 (Or.inr (by omega))
      have h_eq0 : valL F L (c - a) = 0 := by omega
      have h_ac_V0 : V_L 0 (a - c) := hV_L_sub (hS_int a ha) hc
      have h_ac_not_V1 : ¬ V_L 1 (a - c) := by
        intro h_ac_V1
        have h_neg := hV_L_neg h_ac_V1
        rw [neg_sub] at h_neg
        exact h_not_V1 h_neg
      have h_ac_ne0 : a - c ≠ 0 := fun h0 => h_ac_not_V1 (Or.inl h0)
      have h_ac_ge0 : 0 ≤ valL F L (a - c) := h_ac_V0.resolve_left h_ac_ne0
      have h_ac_lt1 : valL F L (a - c) < 1 := by
        by_contra h_ge1
        exact h_ac_not_V1 (Or.inr (by omega))
      exact ⟨h_eq0, by omega⟩
    have h_ins_diff : ∀ a₁ ∈ insert c S, ∀ a₂ ∈ insert c S,
        a₁ ≠ a₂ → valL F L (a₁ - a₂) = 0 := by
      intro a₁ ha₁ a₂ ha₂ hne
      rcases Finset.mem_insert.mp ha₁ with rfl | ha₁_S <;>
        rcases Finset.mem_insert.mp ha₂ with rfl | ha₂_S
      · exact False.elim (hne rfl)
      · exact (h_val_ca a₂ ha₂_S).1
      · exact (h_val_ca a₁ ha₁_S).2
      · exact hS_diff a₁ ha₁_S a₂ ha₂_S hne
    have h_ins_eval : ∀ a ∈ insert c S, V_L 1 (P.eval a) := by
      intro a ha
      have ha_V0 : V_L 0 a := by
        rcases Finset.mem_insert.mp ha with rfl | ha_S
        · exact hc
        · exact hS_int a ha_S
      change V_L 1 ((Polynomial.X ^ qL F L - Polynomial.X : Polynomial L).eval a)
      rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X]
      exact h_fermat_V1 a ha_V0
    have h_bound := h_root_bound (insert c S) h_ins_diff P hP_monic h_ins_eval
    rw [Finset.card_insert_of_notMem hc_not_mem, hS_card, hP_deg] at h_bound
    omega
  have hE_rep : ∀ x : E, V_E 0 x →
      ∃ a ∈ S, V_E 1 (x - IntermediateField.inclusion hLE a) := by
    intro x hx
    obtain ⟨c, hc_V0, hxc_V1⟩ := h_lift x hx
    obtain ⟨a, ha_S, hca_V1⟩ := hL_rep c hc_V0
    have h_inc_ca : V_E 1 (IntermediateField.inclusion hLE c - IntermediateField.inclusion hLE a) := by
      rw [← map_sub]
      exact hV_inclusion_one hca_V1
    have h_sum := hV_E_add hxc_V1 h_inc_ca
    rw [sub_add_sub_cancel] at h_sum
    exact ⟨a, ha_S, h_sum⟩
  obtain ⟨a₀, ha₀_S, ha₀_V1_neg⟩ := hE_rep 0 (Or.inl rfl)
  have ha₀_V1 : V_E 1 (IntermediateField.inclusion hLE a₀) := by
    rw [zero_sub] at ha₀_V1_neg
    have h := hV_E_neg ha₀_V1_neg
    rwa [neg_neg] at h
  let S_unit : Finset L := S.erase a₀
  have hS_unit_card : S_unit.card = qL F L - 1 := by
    rw [Finset.card_erase_of_mem ha₀_S, hS_card]
  have hE_unit_rep : ∀ x : E, x ≠ 0 → valL F E x = 0 →
      ∃ a ∈ S_unit, V_E 1 (x - IntermediateField.inclusion hLE a) := by
    intro x hx0 hx_val
    obtain ⟨a, ha_S, hxa_V1⟩ := hE_rep x (Or.inr (by omega))
    have ha_ne_a₀ : a ≠ a₀ := by
      intro h_eq
      subst h_eq
      have hx_V1 : V_E 1 x := by
        have h := hV_E_add hxa_V1 ha₀_V1
        rwa [sub_add_cancel] at h
      rcases hx_V1 with rfl | hge1
      · exact hx0 rfl
      · omega
    exact ⟨a, Finset.mem_erase.mpr ⟨ha_ne_a₀, ha_S⟩, hxa_V1⟩
  let G_fin : ℕ → Finset G := fun k => Finset.univ.filter (fun σ => σ ∈ lowerRamSubgroup F hLE k)
  have hG_fin_card : ∀ k : ℕ, Nat.card (lowerRamSubgroup F hLE k) = (G_fin k).card := by
    intro k
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
  have hπ_E_ne : π_E ≠ 0 := by
    intro h0
    rw [h0, valL_E_zero] at hπ_E
    omega
  have hc_tame : Nat.card (lowerRamSubgroup F hLE 0) ≤
      (qL F L - 1) * Nat.card (lowerRamSubgroup F hLE 1) := by
    rw [hG_fin_card 0, hG_fin_card 1]
    let w₀ : G → E := fun σ => galApply F hLE σ π_E / π_E
    have hw₀ : ∀ σ : G, w₀ σ ≠ 0 ∧ valL F E (w₀ σ) = 0 := by
      intro σ
      have hσπ_ne : galApply F hLE σ π_E ≠ 0 := by
        intro h0
        have h1 : valL F E (galApply F hLE σ π_E) = 0 := by rw [h0, valL_E_zero]
        rw [valL_galApply, hπ_E] at h1
        omega
      refine ⟨div_ne_zero hσπ_ne hπ_E_ne, ?_⟩
      rw [valL_E_div hσπ_ne hπ_E_ne, valL_galApply, hπ_E, sub_self]
    let f₀ : G → L := fun σ => (hE_unit_rep (w₀ σ) (hw₀ σ).1 (hw₀ σ).2).choose
    have hf₀_mem : ∀ σ : G, f₀ σ ∈ S_unit :=
      fun σ => (hE_unit_rep (w₀ σ) (hw₀ σ).1 (hw₀ σ).2).choose_spec.1
    have hf₀_approx : ∀ σ : G,
        V_E 2 (galApply F hLE σ π_E - IntermediateField.inclusion hLE (f₀ σ) * π_E) := by
      intro σ
      have h1 : V_E 1 (w₀ σ - IntermediateField.inclusion hLE (f₀ σ)) :=
        (hE_unit_rep (w₀ σ) (hw₀ σ).1 (hw₀ σ).2).choose_spec.2
      have h2 : V_E (1 + 1) ((w₀ σ - IntermediateField.inclusion hLE (f₀ σ)) * π_E) :=
        hV_E_mul h1 hπ_E_V1
      have h_eq : (w₀ σ - IntermediateField.inclusion hLE (f₀ σ)) * π_E =
          galApply F hLE σ π_E - IntermediateField.inclusion hLE (f₀ σ) * π_E := by
        dsimp [w₀]
        rw [sub_mul, div_mul_cancel₀ _ hπ_E_ne]
      have h_two : (1 : ℤ) + 1 = 2 := rfl
      rwa [h_eq, h_two] at h2
    have h_fiber_le : ∀ a ∈ S_unit,
        ({σ ∈ G_fin 0 | f₀ σ = a}).card ≤ (G_fin 1).card := by
      intro a _
      set F_a := {σ ∈ G_fin 0 | f₀ σ = a}
      by_cases h_nonempty : F_a.Nonempty
      · obtain ⟨σ₁, hσ₁⟩ := h_nonempty
        have hf₀_σ₁ : f₀ σ₁ = a := (Finset.mem_filter.mp hσ₁).2
        let φ : G → G := fun σ => σ₁⁻¹ * σ
        have hφ_mapsTo : Set.MapsTo φ (F_a : Set G) (G_fin 1 : Set G) := by
          intro σ hσ
          have hf₀_σ : f₀ σ = a := (Finset.mem_filter.mp (Finset.mem_coe.mp hσ)).2
          have h_app_σ : V_E 2 (galApply F hLE σ π_E - IntermediateField.inclusion hLE a * π_E) := by
            rw [← hf₀_σ]
            exact hf₀_approx σ
          have h_app_σ₁ : V_E 2 (galApply F hLE σ₁ π_E - IntermediateField.inclusion hLE a * π_E) := by
            rw [← hf₀_σ₁]
            exact hf₀_approx σ₁
          have h_diff := hV_E_sub h_app_σ h_app_σ₁
          have h_diff_eq :
              (galApply F hLE σ π_E - IntermediateField.inclusion hLE a * π_E) -
                (galApply F hLE σ₁ π_E - IntermediateField.inclusion hLE a * π_E) =
              galApply F hLE σ π_E - galApply F hLE σ₁ π_E := by ring
          rw [h_diff_eq] at h_diff
          have h_inv_diff := hV_E_gal 2 σ₁⁻¹ h_diff
          rw [galApply_sub, galApply_inv_left, ← galApply_mul] at h_inv_diff
          have h_mem_G1 : σ₁⁻¹ * σ ∈ lowerRamSubgroup F hLE 1 := by
            rw [hG_mem 1 (σ₁⁻¹ * σ)]
            rcases h_inv_diff with h0 | hge2
            · exact Or.inl (sub_eq_zero.mp h0)
            · right
              omega
          exact Finset.mem_coe.mpr (Finset.mem_filter.mpr ⟨Finset.mem_univ _, h_mem_G1⟩)
        have hφ_inj : Set.InjOn φ (F_a : Set G) :=
          fun _ _ _ _ h_eq => mul_left_cancel h_eq
        exact Finset.card_le_card_of_injOn φ hφ_mapsTo hφ_inj
      · rw [Finset.not_nonempty_iff_eq_empty.mp h_nonempty, Finset.card_empty]
        exact Nat.zero_le _
    have hf₀_mapsTo : Set.MapsTo f₀ (G_fin 0 : Set G) (S_unit : Set L) :=
      fun σ _ => Finset.mem_coe.mpr (hf₀_mem σ)
    calc (G_fin 0).card
        = ∑ a ∈ S_unit, ({σ ∈ G_fin 0 | f₀ σ = a}).card :=
          Finset.card_eq_sum_card_fiberwise hf₀_mapsTo
      _ ≤ S_unit.card • (G_fin 1).card :=
          Finset.sum_le_card_nsmul S_unit _ (G_fin 1).card h_fiber_le
      _ = (qL F L - 1) * (G_fin 1).card := by rw [smul_eq_mul, hS_unit_card]
  have hc_wild : ∀ u : ℕ, 1 ≤ u →
      Nat.card (lowerRamSubgroup F hLE u) ≤ qL F L * Nat.card (lowerRamSubgroup F hLE (u + 1)) := by
    intro u _
    rw [hG_fin_card u, hG_fin_card (u + 1)]
    have hπ_pow_ne : π_E ^ (u + 1) ≠ 0 := pow_ne_zero (u + 1) hπ_E_ne
    have hπ_pow_val : valL F E (π_E ^ (u + 1)) = ((u + 1 : ℕ) : ℤ) := by
      rw [valL_E_pow hπ_E_ne (u + 1), hπ_E, mul_one]
    have hπ_pow_V : V_E ((u + 1 : ℕ) : ℤ) (π_E ^ (u + 1)) := Or.inr (by omega)
    have hπ_pow_inv_V : V_E (-((u + 1 : ℕ) : ℤ)) ((π_E ^ (u + 1))⁻¹) := by
      right
      rw [valL_E_inv hπ_pow_ne, hπ_pow_val]
    let w_u : G → E := fun σ => (galApply F hLE σ π_E - π_E) / (π_E ^ (u + 1))
    have hw_u : ∀ σ ∈ G_fin u, V_E 0 (w_u σ) := by
      intro σ hσ
      have hσ_mem : σ ∈ lowerRamSubgroup F hLE u := (Finset.mem_filter.mp hσ).2
      have h_diff_V : V_E ((u + 1 : ℕ) : ℤ) (galApply F hLE σ π_E - π_E) := by
        rcases (hG_mem u σ).mp hσ_mem with h_eq | h_ge
        · exact Or.inl (sub_eq_zero.mpr h_eq)
        · right
          simpa using h_ge
      have h_mul := hV_E_mul h_diff_V hπ_pow_inv_V
      rw [add_neg_cancel, ← div_eq_mul_inv] at h_mul
      exact h_mul
    let f_u : G → L := fun σ =>
      if h : V_E 0 (w_u σ) then (hE_rep (w_u σ) h).choose else a₀
    have hf_u_mem : ∀ σ ∈ G_fin u, f_u σ ∈ S := by
      intro σ hσ
      dsimp [f_u]
      rw [dif_pos (hw_u σ hσ)]
      exact (hE_rep (w_u σ) (hw_u σ hσ)).choose_spec.1
    have hf_u_approx : ∀ σ ∈ G_fin u,
        V_E (((u + 1 : ℕ) : ℤ) + 1)
          (galApply F hLE σ π_E - π_E -
            IntermediateField.inclusion hLE (f_u σ) * π_E ^ (u + 1)) := by
      intro σ hσ
      have h1 : V_E 1 (w_u σ - IntermediateField.inclusion hLE (f_u σ)) := by
        dsimp [f_u]
        rw [dif_pos (hw_u σ hσ)]
        exact (hE_rep (w_u σ) (hw_u σ hσ)).choose_spec.2
      have h2 := hV_E_mul h1 hπ_pow_V
      have h_eq : (w_u σ - IntermediateField.inclusion hLE (f_u σ)) * π_E ^ (u + 1) =
          galApply F hLE σ π_E - π_E -
            IntermediateField.inclusion hLE (f_u σ) * π_E ^ (u + 1) := by
        dsimp [w_u]
        rw [sub_mul, div_mul_cancel₀ _ hπ_pow_ne]
      have h_add_comm : (1 : ℤ) + ((u + 1 : ℕ) : ℤ) = ((u + 1 : ℕ) : ℤ) + 1 := by ring
      rwa [h_eq, h_add_comm] at h2
    have h_fiber_le : ∀ a ∈ S,
        ({σ ∈ G_fin u | f_u σ = a}).card ≤ (G_fin (u + 1)).card := by
      intro a _
      set F_a := {σ ∈ G_fin u | f_u σ = a}
      by_cases h_nonempty : F_a.Nonempty
      · obtain ⟨σ₁, hσ₁⟩ := h_nonempty
        have hσ₁_Gu : σ₁ ∈ G_fin u := (Finset.mem_filter.mp hσ₁).1
        have hf_u_σ₁ : f_u σ₁ = a := (Finset.mem_filter.mp hσ₁).2
        let φ : G → G := fun σ => σ₁⁻¹ * σ
        have hφ_mapsTo : Set.MapsTo φ (F_a : Set G) (G_fin (u + 1) : Set G) := by
          intro σ hσ
          have hσ_F : σ ∈ F_a := Finset.mem_coe.mp hσ
          have hσ_Gu : σ ∈ G_fin u := (Finset.mem_filter.mp hσ_F).1
          have hf_u_σ : f_u σ = a := (Finset.mem_filter.mp hσ_F).2
          have h_app_σ : V_E (((u + 1 : ℕ) : ℤ) + 1)
              (galApply F hLE σ π_E - π_E -
                IntermediateField.inclusion hLE a * π_E ^ (u + 1)) := by
            rw [← hf_u_σ]
            exact hf_u_approx σ hσ_Gu
          have h_app_σ₁ : V_E (((u + 1 : ℕ) : ℤ) + 1)
              (galApply F hLE σ₁ π_E - π_E -
                IntermediateField.inclusion hLE a * π_E ^ (u + 1)) := by
            rw [← hf_u_σ₁]
            exact hf_u_approx σ₁ hσ₁_Gu
          have h_diff := hV_E_sub h_app_σ h_app_σ₁
          have h_diff_eq :
              (galApply F hLE σ π_E - π_E -
                IntermediateField.inclusion hLE a * π_E ^ (u + 1)) -
              (galApply F hLE σ₁ π_E - π_E -
                IntermediateField.inclusion hLE a * π_E ^ (u + 1)) =
              galApply F hLE σ π_E - galApply F hLE σ₁ π_E := by ring
          rw [h_diff_eq] at h_diff
          have h_inv_diff := hV_E_gal (((u + 1 : ℕ) : ℤ) + 1) σ₁⁻¹ h_diff
          rw [galApply_sub, galApply_inv_left, ← galApply_mul] at h_inv_diff
          have h_mem_Gu1 : σ₁⁻¹ * σ ∈ lowerRamSubgroup F hLE (u + 1) := by
            rw [hG_mem (u + 1) (σ₁⁻¹ * σ)]
            rcases h_inv_diff with h0 | hge
            · exact Or.inl (sub_eq_zero.mp h0)
            · right
              omega
          exact Finset.mem_coe.mpr (Finset.mem_filter.mpr ⟨Finset.mem_univ _, h_mem_Gu1⟩)
        have hφ_inj : Set.InjOn φ (F_a : Set G) :=
          fun _ _ _ _ h_eq => mul_left_cancel h_eq
        exact Finset.card_le_card_of_injOn φ hφ_mapsTo hφ_inj
      · rw [Finset.not_nonempty_iff_eq_empty.mp h_nonempty, Finset.card_empty]
        exact Nat.zero_le _
    have hf_u_mapsTo : Set.MapsTo f_u (G_fin u : Set G) (S : Set L) :=
      fun σ hσ => Finset.mem_coe.mpr (hf_u_mem σ (Finset.mem_coe.mp hσ))
    calc (G_fin u).card
        = ∑ a ∈ S, ({σ ∈ G_fin u | f_u σ = a}).card :=
          Finset.card_eq_sum_card_fiberwise hf_u_mapsTo
      _ ≤ S.card • (G_fin (u + 1)).card :=
          Finset.sum_le_card_nsmul S _ (G_fin (u + 1)).card h_fiber_le
      _ = qL F L * (G_fin (u + 1)).card := by rw [smul_eq_mul, hS_card]
  exact ⟨hc0, hc_tame, hc_wild⟩

theorem coprime_and_finrank_dvd_mul_card_lowerRamSubgroup_one_and_herbrandSum (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E] (hLE : L ≤ E) :
    IsAbelianExt F hLE → resDeg F E = resDeg F L →
    ∀ (π_E : E), valL F E π_E = 1 →
    (∀ (x : E), (x = 0 ∨ 0 ≤ valL F E x) →
      ∃ c : L, (c = 0 ∨ 0 ≤ valL F L c) ∧
        (x - IntermediateField.inclusion hLE c = 0 ∨
          1 ≤ valL F E (x - IntermediateField.inclusion hLE c))) →
    (∀ (u : ℕ) (σ : (IntermediateField.extendScalars hLE) ≃ₐ[L]
        (IntermediateField.extendScalars hLE)),
      σ ∈ lowerRamSubgroup F hLE u ↔
        galApply F hLE σ π_E = π_E ∨ (u + 1 : ℤ) ≤ valL F E (galApply F hLE σ π_E - π_E)) →
    (∀ σ : (IntermediateField.extendScalars hLE) ≃ₐ[L] (IntermediateField.extendScalars hLE),
      σ ≠ 1 → galApply F hLE σ π_E ≠ π_E ∧ 1 ≤ valL F E (galApply F hLE σ π_E - π_E) ∧
        ∀ b : E, (b = 0 ∨ 0 ≤ valL F E b) →
          galApply F hLE σ b = b ∨
            valL F E (galApply F hLE σ π_E - π_E) ≤ valL F E (galApply F hLE σ b - b)) →
    (∀ (k : ℕ), 1 ≤ k → ∀ σ ∈ lowerRamSubgroup F hLE k,
      σ ^ (p F) ∈ lowerRamSubgroup F hLE (k + 1)) ∧
    Nat.Coprime (qL F L - 1) (Nat.card (lowerRamSubgroup F hLE 1)) ∧
    (Module.finrank L (IntermediateField.extendScalars hLE) ∣
      (qL F L - 1) * Nat.card (lowerRamSubgroup F hLE 1)) ∧
    (∀ u : ℕ, 1 ≤ u →
      Nat.card (lowerRamSubgroup F hLE (u + 1)) < Nat.card (lowerRamSubgroup F hLE u) →
      Module.finrank L (IntermediateField.extendScalars hLE) ∣
        Nat.card (lowerRamSubgroup F hLE 1) * herbrandSum F hLE u) :=
by
  intro hab hres π_E hπ_E h_lift hG_mem hG_ne_full
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion hLE).toLinearMap
      (IntermediateField.inclusion hLE).injective
  let E_L := IntermediateField.extendScalars hLE
  let G := ↥E_L ≃ₐ[↥L] ↥E_L
  let d := Module.finrank ↥L ↥E_L
  haveI : FiniteDimensional F ↥E_L := ‹FiniteDimensional F E›
  haveI : FiniteDimensional ↥L ↥E_L := FiniteDimensional.right F ↥L ↥E_L
  letI : Fintype G := AlgEquiv.fintype ↥L ↥E_L
  have hd_pos : 1 ≤ d := Nat.succ_le_of_lt (Module.finrank_pos (R := ↥L) (M := ↥E_L))
  let ϖ_L : Lˣ := chosenUniformizer F L
  let ϖ_E : Eˣ := chosenUniformizer F E
  have hϖ_L : valL F L ϖ_L = 1 := (valL_chosenUniformizer_and_mul_zpow F L 1).1
  have hϖ_E : valL F E ϖ_E = 1 := (valL_chosenUniformizer_and_mul_zpow F E 1).1
  have hres_L_ne : resDeg F L ≠ 0 := by
    intro h0
    have h1 : valL F L ϖ_L = 0 := by
      unfold valL
      rw [h0, Nat.cast_zero, Int.ediv_zero]
    omega
  have hres_L_pos : 0 < resDeg F L := Nat.pos_of_ne_zero hres_L_ne
  have hres_E_pos : 0 < resDeg F E := by omega
  have hq_gt : 1 < q F := by
    unfold q
    exact Finite.one_lt_card
  have hqL_gt : 1 < qL F L := by
    unfold qL
    exact one_lt_pow₀ hq_gt hres_L_ne
  haveI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  haveI : CharP 𝓀[F] (p F) := by unfold p; infer_instance
  obtain ⟨d_F, hp_prime, hq_card⟩ := FiniteField.card 𝓀[F] (p F)
  have hq_eq : q F = (p F) ^ (d_F : ℕ) := by
    rw [q, Nat.card_eq_fintype_card, hq_card]
  set k_L : ℕ := (d_F : ℕ) * resDeg F L
  have hk_L_pos : 0 < k_L := Nat.mul_pos d_F.pos hres_L_pos
  have hqL_eq_pow_p : qL F L = (p F) ^ k_L := by
    dsimp [qL, k_L]
    rw [hq_eq, ← pow_mul]
  have hp_dvd_qL : p F ∣ qL F L := by
    rw [hqL_eq_pow_p]
    exact dvd_pow_self (p F) (by omega)
  have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
