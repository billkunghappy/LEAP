  have isIntegral_iff_E₀ : ∀ z : E₀,
      IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ relVal F E₀ z :=
    isIntegral_aux E₀
  have h_div_iff : ∀ (m : ℕ) (d : E₀),
