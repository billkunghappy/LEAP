          Polynomial.X_comp, Polynomial.pow_comp]
        ring
      rw [← Polynomial.coeff_sub, h_id, Polynomial.coeff_add, Polynomial.coeff_C_mul,
        Polynomial.coeff_sub, hdeg₁, hdeg₂, sub_self, mul_zero, zero_add]
    have h_comp_f_sub_m : (ϕ₁.comp f).coeff m - (ϕ₂.comp f).coeff m =
        (Δ_prev.comp f).coeff m := by
      rw [← Polynomial.coeff_sub, ← Polynomial.sub_comp]
    have h_Em_id : den * d_m + c₀ =
        ((ϕ₁ ^ qL F L - ϕ₂ ^ qL F L) -
          (Δ_prev.comp f - Δ_prev.comp (Polynomial.X ^ qL F L))).coeff m := by
      have hc₀_eq : c₀ = (Δ_prev.comp (Polynomial.X ^ qL F L)).coeff m :=
        (h_comp_X_pow_coeff Δ_prev m).symm
      rw [hd_m_eq, hc₀_eq]
      simp only [Polynomial.coeff_sub] at h_f_comp_sub_m h_comp_f_sub_m ⊢
      linear_combination h_f_comp_sub_m - h_comp_f_sub_m
    have h_pow_diff_val : polyValLe F L (t + 1) (ϕ₁ ^ qL F L - ϕ₂ ^ qL F L) := by
      have hϕ₁_eq : ϕ₁ = ϕ₂ + Δ_prev := (add_sub_cancel ϕ₂ ϕ₁).symm
      let S_binom := ∑ j ∈ Finset.Ioo 0 ((p F) ^ e_p),
        ϕ₂ ^ (j - 1) * Δ_prev ^ ((p F) ^ e_p - j - 1) * ↑(((p F) ^ e_p).choose j / p F)
      have h_binom : ϕ₁ ^ qL F L - ϕ₂ ^ qL F L =
          Δ_prev ^ qL F L +
            (Polynomial.C (p F : L) * Δ_prev) * (ϕ₂ * S_binom) := by
        dsimp [S_binom]
        rw [hϕ₁_eq, hqL_eq_p_pow, add_pow_prime_pow_eq hp_prime ϕ₂ Δ_prev e_p,
          Polynomial.C_eq_natCast]
        ring
      rw [h_binom]
      have hΔ_1 : polyValLe F L 1 Δ_prev := polyValLe_mono ht hΔ
      have hΔ_0 : polyValLe F L 0 Δ_prev := polyValLe_mono (by omega) hΔ
      have hΔ_pow : polyValLe F L (t + 1) (Δ_prev ^ qL F L) := by
        obtain ⟨d, hd⟩ : ∃ d : ℕ, qL F L = 2 + d := ⟨qL F L - 2, by omega⟩
        rw [hd, pow_add, sq]
        have h_sq : polyValLe F L (t + 1) (Δ_prev * Δ_prev) := polyValLe_mul hΔ hΔ_1
        have h_rem : polyValLe F L 0 (Δ_prev ^ d) := polyValLe_pow_zero hΔ_0 d
        simpa using polyValLe_mul h_sq h_rem
      have hS_0 : polyValLe F L 0 S_binom := by
        refine polyValLe_sum 0 _ _ fun j _ => ?_
        exact polyValLe_mul
          (polyValLe_mul (polyValLe_pow_zero hϕ₂_int _) (polyValLe_pow_zero hΔ_0 _))
          (polyValLe_natCast _)
      have h_term2 : polyValLe F L (t + 1)
          ((Polynomial.C (p F : L) * Δ_prev) * (ϕ₂ * S_binom)) := by
        have h_pΔ : polyValLe F L (t + 1) (Polynomial.C (p F : L) * Δ_prev) := by
          have h := polyValLe_mul h_C_p_val1 hΔ
          rwa [Nat.add_comm 1 t] at h
        have h_ϕS : polyValLe F L 0 (ϕ₂ * S_binom) := polyValLe_mul hϕ₂_int hS_0
        simpa using polyValLe_mul h_pΔ h_ϕS
      exact (polyValLe_add_and_sub F L (t + 1) _ _ hΔ_pow h_term2).1
    have h_comp_diff_val : polyValLe F L (t + 1)
        (Δ_prev.comp f - Δ_prev.comp (Polynomial.X ^ qL F L)) :=
      h_comp_f_sub_X_pow t hΔ
    have h_Em_val : (den * d_m + c₀) = 0 ∨ ((t + 1 : ℕ) : ℤ) ≤ valL F L (den * d_m + c₀) := by
      rw [h_Em_id]
      exact (polyValLe_add_and_sub F L (t + 1) _ _ h_pow_diff_val h_comp_diff_val).2 m
    constructor
    · intro hc₀
      have h_prod : den * d_m = 0 ∨ ((t + 1 : ℕ) : ℤ) ≤ valL F L (den * d_m) := by
        have h := valLe_sub (t + 1) h_Em_val hc₀
        rwa [add_sub_cancel_right] at h
      rcases eq_or_ne d_m 0 with h0 | hd_ne
      · exact Or.inl h0
      · right
        have hprod_ne : den * d_m ≠ 0 := mul_ne_zero hden_ne hd_ne
        have hprod_ge := h_prod.resolve_left hprod_ne
        rw [valL_mul hden_ne hd_ne, hden_val] at hprod_ge
        omega
    · rintro ⟨hc₀_ne, hc₀_val⟩
      have hc₀_t : c₀ = 0 ∨ (t : ℤ) ≤ valL F L c₀ := Or.inr (by omega)
      have h_Em_t : (den * d_m + c₀) = 0 ∨ (t : ℤ) ≤ valL F L (den * d_m + c₀) := by
        rcases h_Em_val with h0 | hle
        · exact Or.inl h0
        · exact Or.inr (by omega)
      have h_prod_t : den * d_m = 0 ∨ (t : ℤ) ≤ valL F L (den * d_m) := by
        have h := valLe_sub t h_Em_t hc₀_t
        rwa [add_sub_cancel_right] at h
      have h_prod_not_t1 : ¬ (den * d_m = 0 ∨ ((t + 1 : ℕ) : ℤ) ≤ valL F L (den * d_m)) := by
        intro h_prod_t1
        have hc₀_t1 : c₀ = 0 ∨ ((t + 1 : ℕ) : ℤ) ≤ valL F L c₀ := by
          have h := valLe_sub (t + 1) h_Em_val h_prod_t1
          rwa [add_sub_cancel_left] at h
        rcases hc₀_t1 with h0 | hle
        · exact hc₀_ne h0
        · omega
      have hprod_ne : den * d_m ≠ 0 := fun h0 => h_prod_not_t1 (Or.inl h0)
      have hd_ne : d_m ≠ 0 := right_ne_zero_of_mul hprod_ne
      have hprod_ge : (t : ℤ) ≤ valL F L (den * d_m) := h_prod_t.resolve_left hprod_ne
      have hprod_not_ge : ¬ (((t + 1 : ℕ) : ℤ) ≤ valL F L (den * d_m)) :=
        fun hle => h_prod_not_t1 (Or.inr hle)
      have hprod_val : valL F L (den * d_m) = (t : ℤ) := by omega
      rw [valL_mul hden_ne hd_ne, hden_val] at hprod_val
      refine ⟨hd_ne, by omega⟩
  
  let Δ : ℕ → Polynomial L := fun r =>
    lubinTateEndoTrunc F L π a₁ r - lubinTateEndoTrunc F L π a₂ r
  let d : ℕ → L := fun m => (Δ m).coeff m
  have hΔ_coeff_le : ∀ (r j : ℕ), j ≤ r → (Δ r).coeff j = d j := by
    intro r j hjr
    dsimp [Δ, d]
    rw [Polynomial.coeff_sub, Polynomial.coeff_sub,
      h_trunc_stab a₁ ha₁ r j j hjr (le_refl j),
      h_trunc_stab a₂ ha₂ r j j hjr (le_refl j)]
  have hΔ_coeff_gt : ∀ (r j : ℕ), r < j → (Δ r).coeff j = 0 := by
    intro r j hjr
    dsimp [Δ]
    rw [Polynomial.coeff_sub, (h_s2 a₁ ha₁ r).2.2.2.2 j hjr,
      (h_s2 a₂ ha₂ r).2.2.2.2 j hjr, sub_self]
  have hΔ_polyValLe : ∀ (r t : ℕ),
      (∀ j ≤ r, d j = 0 ∨ (t : ℤ) ≤ valL F L (d j)) → polyValLe F L t (Δ r) := by
    intro r t hd_le j
    rcases le_or_gt j r with hjr | hjr
    · rw [hΔ_coeff_le r j hjr]
      exact hd_le j hjr
    · rw [hΔ_coeff_gt r j hjr]
      exact Or.inl rfl
  have h_staircase : ∀ s : ℕ, s ≤ k →
      (∀ j < (qL F L) ^ s, d j = 0 ∨ ((k - s + 1 : ℕ) : ℤ) ≤ valL F L (d j)) ∧
      (d ((qL F L) ^ s) ≠ 0 ∧ valL F L (d ((qL F L) ^ s)) = ((k - s : ℕ) : ℤ)) := by
    intro s
    induction s with
    | zero =>
      intro _
      rw [pow_zero]
      refine ⟨?_, ?_⟩
      · intro j hj
        have hj0 : j = 0 := by omega
        subst hj0
        left
        dsimp [d, Δ]
        rw [Polynomial.coeff_sub, (h_s2 a₁ ha₁ 0).2.2.1, (h_s2 a₂ ha₂ 0).2.2.1, sub_self]
      · have hd1 : d 1 = a₁ - a₂ := by
          dsimp [d, Δ]
          rw [Polynomial.coeff_sub, (h_s2 a₁ ha₁ 1).2.2.2.1 (le_refl 1),
            (h_s2 a₂ ha₂ 1).2.2.2.1 (le_refl 1)]
        rw [hd1, Nat.sub_zero]
        exact ⟨sub_ne_zero.mpr hne, hval⟩
    | succ s ih =>
      intro hs
      obtain ⟨ih_lt, ih_ne, ih_val⟩ := ih (by omega)
      set t : ℕ := k - s
      have ht : 1 ≤ t := by omega
      have h_inner : ∀ m : ℕ, (qL F L) ^ s ≤ m → m < (qL F L) ^ (s + 1) →
          ∀ j ≤ m, d j = 0 ∨ (t : ℤ) ≤ valL F L (d j) := by
        intro m
        induction m with
        | zero =>
          intro hm
          have : 1 ≤ (qL F L) ^ s := Nat.one_le_pow s (qL F L) (by omega)
          omega
        | succ m ih_m =>
          intro hm_lo hm_hi
          rcases lt_or_ge m ((qL F L) ^ s) with hm_lt | hm_ge
          · have hm_eq : m + 1 = (qL F L) ^ s := by omega
            intro j hj
            rw [hm_eq] at hj
            rcases lt_or_eq_of_le hj with hj_lt | rfl
            · rcases ih_lt j hj_lt with h0 | hle
              · exact Or.inl h0
              · exact Or.inr (by omega)
            · exact Or.inr (by rw [ih_val])
          · have ih_m' := ih_m hm_ge (by omega)
            have hΔ_m : polyValLe F L t (Δ m) := hΔ_polyValLe m t ih_m'
            have hm2 : 2 ≤ m + 1 := by
              have : 1 ≤ (qL F L) ^ s := Nat.one_le_pow s (qL F L) (by omega)
              omega
            have hc₀_bound :
                let c₀ := if qL F L ∣ (m + 1) then (Δ m).coeff ((m + 1) / qL F L) else 0
                c₀ = 0 ∨ ((t + 1 : ℕ) : ℤ) ≤ valL F L c₀ := by
              dsimp only
              split_ifs with h_dvd
              · set j₀ := (m + 1) / qL F L
                have hj₀_mul : qL F L * j₀ = m + 1 := Nat.mul_div_cancel' h_dvd
                have hj₀_lt : j₀ < (qL F L) ^ s := by
                  have h_pow_succ : (qL F L) ^ (s + 1) = qL F L * (qL F L) ^ s := pow_succ' _ _
                  have h_lt_mul : qL F L * j₀ < qL F L * (qL F L) ^ s := by omega
                  exact Nat.lt_of_mul_lt_mul_left h_lt_mul
                have hj₀_le_m : j₀ ≤ m := by omega
                rw [hΔ_coeff_le m j₀ hj₀_le_m]
                rcases ih_lt j₀ hj₀_lt with h0 | hle
                · exact Or.inl h0
                · exact Or.inr (by omega)
              · exact Or.inl rfl
            have hd_succ : d (m + 1) = 0 ∨ (t : ℤ) ≤ valL F L (d (m + 1)) :=
              (h_s4 (m + 1) t hm2 ht hΔ_m).1 hc₀_bound
            intro j hj
            rcases lt_or_eq_of_le hj with hj_lt | rfl
            · exact ih_m' j (by omega)
            · exact hd_succ
      have h_pow_lt : (qL F L) ^ s < (qL F L) ^ (s + 1) :=
        Nat.pow_lt_pow_right hqL (by omega)
      have h_pow_ge2 : 2 ≤ (qL F L) ^ (s + 1) := by
        have : 1 ≤ (qL F L) ^ s := Nat.one_le_pow s (qL F L) (by omega)
        omega
      have h_all_lt : ∀ j ≤ (qL F L) ^ (s + 1) - 1, d j = 0 ∨ (t : ℤ) ≤ valL F L (d j) :=
        h_inner ((qL F L) ^ (s + 1) - 1) (by omega) (by omega)
      have h_first : ∀ j < (qL F L) ^ (s + 1),
          d j = 0 ∨ ((k - (s + 1) + 1 : ℕ) : ℤ) ≤ valL F L (d j) := by
        intro j hj
        have h_sub : k - (s + 1) + 1 = t := by omega
        rw [h_sub]
        exact h_all_lt j (by omega)
      have hΔ_prev : polyValLe F L t (Δ ((qL F L) ^ (s + 1) - 1)) :=
        hΔ_polyValLe ((qL F L) ^ (s + 1) - 1) t h_all_lt
      have h_dvd_pow : qL F L ∣ (qL F L) ^ (s + 1) := ⟨(qL F L) ^ s, pow_succ' _ _⟩
      have h_div_pow : (qL F L) ^ (s + 1) / qL F L = (qL F L) ^ s := by
        rw [pow_succ', Nat.mul_div_cancel_left _ (by omega)]
      have hc₀_eq :
          (if qL F L ∣ (qL F L) ^ (s + 1) then
            (Δ ((qL F L) ^ (s + 1) - 1)).coeff ((qL F L) ^ (s + 1) / qL F L)
          else 0) = d ((qL F L) ^ s) := by
        rw [if_pos h_dvd_pow, h_div_pow,
          hΔ_coeff_le ((qL F L) ^ (s + 1) - 1) ((qL F L) ^ s) (by omega)]
      have h_second_raw := (h_s4 ((qL F L) ^ (s + 1)) t h_pow_ge2 ht hΔ_prev).2
      rw [hc₀_eq] at h_second_raw
      obtain ⟨hd_ne, hd_val⟩ := h_second_raw ⟨ih_ne, ih_val⟩
      have h_sub2 : t - 1 = k - (s + 1) := by omega
      rw [h_sub2] at hd_val
      exact ⟨h_first, hd_ne, hd_val⟩
  obtain ⟨h_st_lt, h_st_ne, h_st_val⟩ := h_staircase k (le_refl k)
  rw [Nat.sub_self, zero_add] at h_st_lt
  rw [Nat.sub_self] at h_st_val
  obtain ⟨hP₁_0, hP₁_sub⟩ := h_s3 a₁ ha₁
  obtain ⟨hP₂_0, hP₂_sub⟩ := h_s3 a₂ ha₂
  set P₁ := lubinTateEndoPoly F L π a₁ n
  set P₂ := lubinTateEndoPoly F L π a₂ n
  set D := P₁ - P₂
  set Δ_N1 := Δ (N - 1)
  set E := (P₁ - lubinTateEndoTrunc F L π a₁ (N - 1)) -
    (P₂ - lubinTateEndoTrunc F L π a₂ (N - 1))
  have hE_1 : polyValLe F L 1 E :=
    (polyValLe_add_and_sub F L 1 _ _ hP₁_sub hP₂_sub).2
  have hE_0 : polyValLe F L 0 E := polyValLe_mono (by omega) hE_1
  have hΔ_N1_0 : polyValLe F L 0 Δ_N1 :=
    (polyValLe_add_and_sub F L 0 _ _ (h_s2 a₁ ha₁ (N - 1)).1 (h_s2 a₂ ha₂ (N - 1)).1).2
  have hD_eq : D = Δ_N1 + E := by
    dsimp [D, Δ_N1, Δ, E]
    abel
  have hD_0 : polyValLe F L 0 D := by
    rw [hD_eq]
    exact (polyValLe_add_and_sub F L 0 _ _ hΔ_N1_0 hE_0).1
  have hD_coeff0 : D.coeff 0 = 0 := by
    dsimp [D]
    rw [Polynomial.coeff_sub, hP₁_0, hP₂_0, sub_self]
  have hqL_k_lt_N : (qL F L) ^ k < N := Nat.pow_lt_pow_right hqL hk
  have hqL_k_le_N1 : (qL F L) ^ k ≤ N - 1 := by omega
  have hD_lt : ∀ j < (qL F L) ^ k, D.coeff j = 0 ∨ 1 ≤ valL F L (D.coeff j) := by
    intro j hj
    rw [hD_eq, Polynomial.coeff_add, hΔ_coeff_le (N - 1) j (by omega)]
    exact valLe_add 1 (h_st_lt j hj) (hE_1 j)
  set M := (qL F L) ^ k
  have hD_M_eq : D.coeff M = d M + E.coeff M := by
    rw [hD_eq, Polynomial.coeff_add, hΔ_coeff_le (N - 1) M hqL_k_le_N1]
  have hD_M_not_1 : ¬ (D.coeff M = 0 ∨ ((1 : ℕ) : ℤ) ≤ valL F L (D.coeff M)) := by
    intro hDM_1
    have hdM_1 : d M = 0 ∨ ((1 : ℕ) : ℤ) ≤ valL F L (d M) := by
      have h := valLe_sub 1 hDM_1 (hE_1 M)
      rwa [hD_M_eq, add_sub_cancel_right] at h
    rcases hdM_1 with h0 | hle
    · exact h_st_ne h0
    · omega
  have hD_M_ne : D.coeff M ≠ 0 := fun h0 => hD_M_not_1 (Or.inl h0)
  have hD_M_ge0 : 0 ≤ valL F L (D.coeff M) := (hD_0 M).resolve_left hD_M_ne
  have hD_M_not_ge1 : ¬ (((1 : ℕ) : ℤ) ≤ valL F L (D.coeff M)) :=
    fun hle => hD_M_not_1 (Or.inr hle)
  refine ⟨hD_0, hD_coeff0, hD_lt, hD_M_ne, by omega⟩

theorem not_lubinTateDivPoly_dvd_of_valL_coeff_eq_zero (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (ϖ : Lˣ)
    (hϖ : valL F L ϖ = 1) (n : ℕ) (hn : 1 ≤ n) (D : Polynomial L)
    (hD0 : polyValLe F L 0 D) (hDc0 : D.coeff 0 = 0) (M : ℕ) (hM_pos : 1 ≤ M)
    (hM_le : M ≤ (qL F L) ^ (n - 1))
    (hD_lt : ∀ j < M, D.coeff j = 0 ∨ 1 ≤ valL F L (D.coeff j))
    (hD_eq : D.coeff M ≠ 0 ∧ valL F L (D.coeff M) = 0) :
    ¬ (lubinTateDivPoly F L (ϖ : L) n ∣ D) :=
by
  rintro ⟨Q, rfl⟩
  have hres_ne : resDeg F L ≠ 0 := by
    intro h0
    unfold valL at hϖ
    rw [h0, Nat.cast_zero, Int.ediv_zero] at hϖ
    omega
  have hf_pos : 0 < resDeg F L := Nat.pos_of_ne_zero hres_ne
  have hq_gt : 1 < q F := Finite.one_lt_card
  have hqL_gt : 1 < qL F L := one_lt_pow₀ hq_gt hres_ne
  set f0 : Polynomial L := lubinTatePoly F L (ϖ : L)
  have hdeg_lt0 : (Polynomial.C (ϖ : L) * Polynomial.X).degree <
      (Polynomial.X ^ qL F L : Polynomial L).degree := by
    rw [Polynomial.degree_X_pow]
    exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_le (ϖ : L)) (WithBot.coe_lt_coe.mpr hqL_gt)
  have hf0_monic : f0.Monic := by
    change (Polynomial.C (ϖ : L) * Polynomial.X + Polynomial.X ^ qL F L).Monic
    rw [add_comm]
    exact Polynomial.Monic.add_of_left (Polynomial.monic_X_pow (qL F L)) hdeg_lt0
  have hf0_deg : f0.natDegree = qL F L := by
    change (Polynomial.C (ϖ : L) * Polynomial.X + Polynomial.X ^ qL F L).natDegree = qL F L
    rw [add_comm, Polynomial.natDegree_add_eq_left_of_degree_lt hdeg_lt0,
      Polynomial.natDegree_X_pow]
  have hf0_eval0 : f0.eval 0 = 0 := by
    change (Polynomial.C (ϖ : L) * Polynomial.X + Polynomial.X ^ qL F L).eval 0 = 0
    rw [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
      Polynomial.eval_pow, Polynomial.eval_X, mul_zero, zero_add, zero_pow (by omega)]
  have hg_prop : ∀ m : ℕ,
      (lubinTateIterPoly F L (ϖ : L) m).Monic ∧
      (lubinTateIterPoly F L (ϖ : L) m).natDegree = (qL F L) ^ m ∧
      (lubinTateIterPoly F L (ϖ : L) m).eval 0 = 0 := by
    intro m
    induction m with
    | zero =>
      dsimp [lubinTateIterPoly]
      exact ⟨Polynomial.monic_X, Polynomial.natDegree_X, Polynomial.eval_X⟩
    | succ m ih =>
      obtain ⟨ih_monic, ih_deg, ih_eval0⟩ := ih
      have h_deg_ne : (lubinTateIterPoly F L (ϖ : L) m).natDegree ≠ 0 := by
        rw [ih_deg]
        exact pow_ne_zero m (by omega)
      dsimp [lubinTateIterPoly]
      refine ⟨hf0_monic.comp ih_monic h_deg_ne, ?_, ?_⟩
      · rw [Polynomial.natDegree_comp, hf0_deg, ih_deg, pow_succ']
      · rw [Polynomial.eval_comp, ih_eval0, hf0_eval0]
  obtain ⟨hg_monic, hg_deg, hg_eval0⟩ := hg_prop (n - 1)
  set P0 : Polynomial L := (lubinTateIterPoly F L (ϖ : L) (n - 1)) ^ (qL F L - 1)
  set d : ℕ := (qL F L - 1) * (qL F L) ^ (n - 1)
  have hP0_monic : P0.Monic := hg_monic.pow (qL F L - 1)
  have hP0_deg : P0.natDegree = d := by
    rw [hg_monic.natDegree_pow (qL F L - 1), hg_deg]
  have hd_ge : (qL F L) ^ (n - 1) ≤ d := by
    calc (qL F L) ^ (n - 1) = 1 * (qL F L) ^ (n - 1) := (one_mul _).symm
      _ ≤ (qL F L - 1) * (qL F L) ^ (n - 1) :=
        Nat.mul_le_mul_right ((qL F L) ^ (n - 1)) (by omega)
  have hM_le_d : M ≤ d := le_trans hM_le hd_ge
  have hd_pos : 1 ≤ d := le_trans hM_pos hM_le_d
  have hP0_coeff0 : P0.coeff 0 = 0 := by
    rw [Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_pow, hg_eval0, zero_pow (by omega)]
  have hdeg_C_lt : (Polynomial.C (ϖ : L)).degree < P0.degree := by
    rw [Polynomial.degree_eq_natDegree hP0_monic.ne_zero, hP0_deg]
    exact lt_of_le_of_lt Polynomial.degree_C_le (WithBot.coe_lt_coe.mpr hd_pos)
  set fn : Polynomial L := lubinTateDivPoly F L (ϖ : L) n
  have hfn_monic : fn.Monic := hP0_monic.add_of_left hdeg_C_lt
  have hfn_deg : fn.natDegree = d := by
    change (P0 + Polynomial.C (ϖ : L)).natDegree = d
    rw [Polynomial.natDegree_add_eq_left_of_degree_lt hdeg_C_lt, hP0_deg]
  have hfn_coeff0 : fn.coeff 0 = (ϖ : L) := by
    change (P0 + Polynomial.C (ϖ : L)).coeff 0 = (ϖ : L)
    rw [Polynomial.coeff_add, hP0_coeff0, Polynomial.coeff_C_zero, zero_add]
  have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
      0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
    intro a ha
    unfold addVal
    rw [dif_neg ha]
    set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    set va := valuation F a
    have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
    constructor
    · intro h_nonneg
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
      have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
      have h_iso : iso va ≤ iso 1 := by
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
        exact WithZero.coe_le_coe.mpr h_unzero
      exact (map_le_map_iff iso).mp h_iso
    · intro h_le
      have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
      rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
        Multiplicative.toAdd_le.mpr h_iso
      omega
  have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Lˣ, Multiplicative.toAdd (relValHom u) = relVal F L u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : Lˣ,
      relVal F L ((u * v : Lˣ) : L) = relVal F L u + relVal F L v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : Lˣ) (k : ℤ),
      relVal F L ((u ^ k : Lˣ) : L) = k * relVal F L u := by
    intro u k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have relVal_mul : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      relVal F L (x * y) = relVal F L x + relVal F L y := by
    intro x y hx hy
    exact relVal_units_mul (Units.mk0 x hx) (Units.mk0 y hy)
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨c, hc⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F c) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hc]
      exact hg
    have hc0 : c ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 c hc0, ?_⟩
    simp only [Units.val_mk0, addVal, hc0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F c))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F L ∧ ∃ π' : Lˣ, relVal F L π' = resDeg F L := by
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L u,
        (map_ne_zero (algebraMap F L)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (u : F)) = (u : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (u : F)
      have hpow : addVal F ((u : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F u := by
        change Multiplicative.toAdd (addValHom (u ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨_, π', hπ'⟩ := resDeg_mem
  have relVal_eq_resDeg_mul_valL_aux : ∀ u : Lˣ, relVal F L u = (resDeg F L : ℤ) * valL F L u := by
    intro u
    let q₀ := relVal F L u / (resDeg F L : ℤ)
    let r₀ := relVal F L u % (resDeg F L : ℤ)
    have hdiv : r₀ + (resDeg F L : ℤ) * q₀ = relVal F L u := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r₀ := Int.emod_nonneg _ (by positivity)
    have hrlt : r₀ < (resDeg F L : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F L ((u * π' ^ (-q₀) : Lˣ) : L) = r₀ := by
      rw [relVal_units_mul, relVal_units_zpow, hπ']
      linarith
    have hr_eq : r₀ = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r₀.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r₀.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k} := by
        refine ⟨hr_pos, ((u * π' ^ (-q₀) : Lˣ) : L), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F L ≤ r₀.toNat := Nat.sInf_le hmem
      omega
    change relVal F L u = (resDeg F L : ℤ) * q₀
    linarith
  have relVal_eq : ∀ {x : L} (hx : x ≠ 0), relVal F L x = (resDeg F L : ℤ) * valL F L x :=
    fun hx => relVal_eq_resDeg_mul_valL_aux (Units.mk0 _ hx)
  have valL_mul : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      valL F L (x * y) = valL F L x + valL F L y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    have h := relVal_mul hx hy
    rw [relVal_eq hxy, relVal_eq hx, relVal_eq hy, ← mul_add] at h
    exact mul_left_cancel₀ (by positivity) h
  have valL_one : valL F L 1 = 0 := by
    have h1 : (1 : L) ≠ 0 := one_ne_zero
    have h := valL_mul h1 h1
    rw [mul_one] at h
    omega
  have valL_ϖ_zpow : ∀ k : ℤ, valL F L ((ϖ ^ k : Lˣ) : L) = k := by
    intro k
    have h1 := relVal_eq_resDeg_mul_valL_aux (ϖ ^ k)
    rw [relVal_units_zpow, relVal_eq_resDeg_mul_valL_aux ϖ, hϖ, mul_one, mul_comm k] at h1
    exact mul_left_cancel₀ (by positivity) h1.symm
  have h_int_aux : ∀ (K : Type u) [Field K] [Algebra F K] [FiniteDimensional F K] (x : K),
      IsIntegral 𝒪[F] x ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x) := by
    intro K _ _ _ x
    constructor
    · intro hx
      by_cases hx0 : x = 0
      · exact Or.inl hx0
      · right
        have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
        have hnorm_int : IsIntegral 𝒪[F] (Algebra.norm F x) := Algebra.isIntegral_norm F hx
        have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
          (Valuation.Integers.isIntegral_iff_v_le_one
            (Valuation.integer.integers (valuation F))).mp hnorm_int
        exact (addVal_nonneg_iff_val_le_one hnorm0).mpr hval_le
    · rintro (rfl | h_rel)
      · exact isIntegral_zero
      · by_cases hx0 : x = 0
        · rw [hx0]
          exact isIntegral_zero
        · have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
          have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
            (addVal_nonneg_iff_val_le_one hnorm0).mp h_rel
          have hx_int_F : IsIntegral F x := Algebra.IsIntegral.isIntegral x
          let pb : PowerBasis F (IntermediateField.adjoin F ({x} : Set K)) :=
            IntermediateField.adjoin.powerBasis hx_int_F
          have h_gen_coe : (pb.gen : K) = x := IntermediateField.AdjoinSimple.coe_gen F x
          set dK : ℕ := Module.finrank (IntermediateField.adjoin F ({x} : Set K)) K
          have h_finrank_pos : 0 < dK := Module.finrank_pos
          have h_norm_tower : Algebra.norm F x = (Algebra.norm F pb.gen) ^ dK := by
            have h1 : Algebra.norm F (pb.gen : K) = (Algebra.norm F pb.gen) ^ dK := by
              rw [← Algebra.norm_norm (R := F) (S := IntermediateField.adjoin F ({x} : Set K))
                (A := K) (a := (pb.gen : K)), ← map_pow]
              congr 1
              exact Algebra.norm_algebraMap (L := K) pb.gen
            rwa [h_gen_coe] at h1
          have h_norm_pb : Algebra.norm F pb.gen =
              (-1) ^ pb.dim * (minpoly F pb.gen).coeff 0 :=
            Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb
          have h_minpoly_eq : minpoly F pb.gen = minpoly F x := by
            have h1 : minpoly F pb.gen = minpoly F (pb.gen : K) :=
              (minpoly.algHom_eq
                (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K)))
                (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K))).injective
                pb.gen).symm
            rwa [h_gen_coe] at h1
          letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
          haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
          haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
          letI : Valued F (ValueGroupWithZero F) :=
            IsValuativeTopology.instValuedValueGroupWithZeroOfIsUniformAddGroup
          let rlo : RankLeOneStruct F :=
            { emb := (WithZeroMulInt.toNNReal (by norm_num : (2 : NNReal) ≠ 0)).comp
                (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).toMonoidWithZeroHom
              strictMono := (WithZeroMulInt.toNNReal_strictMono (by norm_num : (1 : NNReal) < 2)).comp
                (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).strictMono }
          haveI : (Valued.v (R := F)).RankOne := Valuation.RankOne.ofRankLeOneStruct rlo
          letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
          haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F (ValueGroupWithZero F)
          have hnorm_norm_le : ‖Algebra.norm F x‖ ≤ 1 :=
            Valued.toNormedField.norm_le_one_iff.mpr hval_le
          have h_norm_coeff_pow : ‖Algebra.norm F x‖ =
              ‖(minpoly F x).coeff 0‖ ^ dK := by
            rw [h_norm_tower, h_norm_pb, h_minpoly_eq, norm_pow, norm_mul, norm_pow,
              norm_neg, norm_one, one_pow, one_mul]
          have h_coeff0_le : ‖(minpoly F x).coeff 0‖ ≤ 1 := by
            rw [h_norm_coeff_pow] at hnorm_norm_le
            exact (pow_le_one_iff_of_nonneg (norm_nonneg _) h_finrank_pos.ne').mp hnorm_norm_le
          have h_spec_le : spectralValue (minpoly F x) ≤ 1 := by
            change spectralNorm F K x ≤ 1
            rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow F K x]
            exact Real.rpow_le_one (norm_nonneg _) h_coeff0_le (by positivity)
          have h_all_coeffs : ∀ n : ℕ, ‖(minpoly F x).coeff n‖ ≤ 1 :=
            (spectralValue_le_one_iff (minpoly.monic hx_int_F)).mp h_spec_le
          have h_lifts : minpoly F x ∈ Polynomial.lifts (algebraMap 𝒪[F] F) := by
            rw [Polynomial.lifts_iff_coeff_lifts]
            intro n
            have hv : valuation F ((minpoly F x).coeff n) ≤ 1 :=
              Valued.toNormedField.norm_le_one_iff.mp (h_all_coeffs n)
            exact ⟨⟨(minpoly F x).coeff n, hv⟩, rfl⟩
          obtain ⟨P₀, hP₀_map, -, hP₀_monic⟩ :=
            Polynomial.lifts_and_degree_eq_and_monic h_lifts (minpoly.monic hx_int_F)
          refine ⟨P₀, hP₀_monic, ?_⟩
          have h_eval : Polynomial.aeval x (P₀.map (algebraMap 𝒪[F] F)) = 0 := by
            rw [hP₀_map]
            exact minpoly.aeval F x
          rwa [Polynomial.aeval_map_algebraMap] at h_eval
  have h_int_valL0 : ∀ z : L, (z = 0 ∨ 0 ≤ valL F L z) ↔ IsIntegral 𝒪[F] z := by
    intro z
    rw [h_int_aux L z]
    by_cases hz : z = 0
    · simp [hz]
    · rw [or_iff_right hz, or_iff_right hz]
      change 0 ≤ valL F L z ↔ 0 ≤ relVal F L z
      rw [relVal_eq hz]
      exact ⟨fun h => mul_nonneg (by positivity) h,
        fun h => nonneg_of_mul_nonneg_right h (by positivity)⟩
  let V : ℤ → L → Prop := fun m z => z = 0 ∨ m ≤ valL F L z
  have hV_iff_int : ∀ (m : ℤ) (z : L),
      V m z ↔ IsIntegral 𝒪[F] (z * ((ϖ ^ (-m) : Lˣ) : L)) := by
    intro m z
    rw [← h_int_valL0 (z * ((ϖ ^ (-m) : Lˣ) : L))]
    have hu_ne : ((ϖ ^ (-m) : Lˣ) : L) ≠ 0 := Units.ne_zero _
    by_cases hz : z = 0
    · simp [V, hz]
    · have hmul_ne : z * ((ϖ ^ (-m) : Lˣ) : L) ≠ 0 := mul_ne_zero hz hu_ne
      change (z = 0 ∨ m ≤ valL F L z) ↔ _
      rw [or_iff_right hz, or_iff_right hmul_ne, valL_mul hz hu_ne, valL_ϖ_zpow (-m)]
      omega
  have hV_add : ∀ (m : ℤ) {a b : L}, V m a → V m b → V m (a + b) := by
    intro m a b ha hb
    rw [hV_iff_int] at ha hb ⊢
    rw [add_mul]
    exact IsIntegral.add ha hb
  have hV_sub : ∀ (m : ℤ) {a b : L}, V m a → V m b → V m (a - b) := by
    intro m a b ha hb
    rw [hV_iff_int] at ha hb ⊢
    rw [sub_mul]
    exact IsIntegral.sub ha hb
  have hV_sum : ∀ (m : ℤ) (s : Finset (ℕ × ℕ)) (g : ℕ × ℕ → L),
      (∀ x ∈ s, V m (g x)) → V m (∑ x ∈ s, g x) := by
    intro m s g hg
    rw [hV_iff_int, Finset.sum_mul]
    exact (integralClosure 𝒪[F] L).sum_mem fun x hx => (hV_iff_int m (g x)).mp (hg x hx)
  have hV_mul : ∀ (m₁ m₂ : ℤ) (a b : L), V m₁ a → V m₂ b → V (m₁ + m₂) (a * b) := by
    intro m₁ m₂ a b ha hb
    by_cases ha0 : a = 0
    · rw [ha0, zero_mul]
      exact Or.inl rfl
    · by_cases hb0 : b = 0
      · rw [hb0, mul_zero]
        exact Or.inl rfl
      · right
        rcases ha with rfl | ha'
        · exact False.elim (ha0 rfl)
        · rcases hb with rfl | hb'
          · exact False.elim (hb0 rfl)
          · rw [valL_mul ha0 hb0]
            omega
  have hpoly_add : ∀ (m : ℕ) {P Q : Polynomial L},
      polyValLe F L m P → polyValLe F L m Q → polyValLe F L m (P + Q) := by
    intro m P Q hP hQ k
    rw [Polynomial.coeff_add]
    exact hV_add (m : ℤ) (hP k) (hQ k)
  have hpoly_mul : ∀ (m₁ m₂ : ℕ) {P Q : Polynomial L},
      polyValLe F L m₁ P → polyValLe F L m₂ Q → polyValLe F L (m₁ + m₂) (P * Q) := by
    intro m₁ m₂ P Q hP hQ k
    change V ((m₁ + m₂ : ℕ) : ℤ) ((P * Q).coeff k)
    rw [Nat.cast_add, Polynomial.coeff_mul]
    exact hV_sum ((m₁ : ℤ) + (m₂ : ℤ)) (Finset.antidiagonal k)
      (fun x => P.coeff x.1 * Q.coeff x.2)
      (fun x _ => hV_mul (m₁ : ℤ) (m₂ : ℤ) (P.coeff x.1) (Q.coeff x.2) (hP x.1) (hQ x.2))
  have hpoly_X_pow : ∀ r : ℕ, polyValLe F L 0 (Polynomial.X ^ r) := by
    intro r k
    rw [Polynomial.coeff_X_pow]
    split_ifs
    · right
      rw [Nat.cast_zero, valL_one]
    · left
      rfl
  have hpoly_C_ϖ : polyValLe F L 1 (Polynomial.C (ϖ : L)) := by
    intro k
    by_cases hk : k = 0
    · subst hk
      right
      rw [Polynomial.coeff_C_zero, Nat.cast_one, hϖ]
    · left
      exact Polynomial.coeff_C_ne_zero hk
  have hpoly_pow_sub : ∀ {A B : Polynomial L},
      polyValLe F L 0 A → polyValLe F L 0 B → polyValLe F L 1 (A - B) →
      ∀ r : ℕ, polyValLe F L 0 (A ^ r) ∧ polyValLe F L 0 (B ^ r) ∧ polyValLe F L 1 (A ^ r - B ^ r) := by
    intro A B hA hB hAB r
    induction r with
    | zero =>
      simp only [pow_zero, sub_self]
      have h1 : polyValLe F L 0 (1 : Polynomial L) := by
        simpa using hpoly_X_pow 0
      refine ⟨h1, h1, fun k => Or.inl (Polynomial.coeff_zero k)⟩
    | succ r ih =>
      obtain ⟨ihA, ihB, ihAB⟩ := ih
      refine ⟨by rw [pow_succ]; exact hpoly_mul 0 0 ihA hA,
        by rw [pow_succ]; exact hpoly_mul 0 0 ihB hB, ?_⟩
      have h_ring : A ^ (r + 1) - B ^ (r + 1) = (A ^ r - B ^ r) * A + B ^ r * (A - B) := by ring
      rw [h_ring]
      have h1 : polyValLe F L (1 + 0) ((A ^ r - B ^ r) * A) := hpoly_mul 1 0 ihAB hA
      have h2 : polyValLe F L (0 + 1) (B ^ r * (A - B)) := hpoly_mul 0 1 ihB hAB
      exact hpoly_add 1 h1 h2
  have hg_val : ∀ m : ℕ,
      polyValLe F L 0 (lubinTateIterPoly F L (ϖ : L) m) ∧
      polyValLe F L 1 (lubinTateIterPoly F L (ϖ : L) m - Polynomial.X ^ ((qL F L) ^ m)) := by
    intro m
    induction m with
    | zero =>
      dsimp [lubinTateIterPoly]
      rw [pow_one, sub_self]
      refine ⟨by simpa using hpoly_X_pow 1, fun k => Or.inl (Polynomial.coeff_zero k)⟩
    | succ m ih =>
      obtain ⟨ih0, ih1⟩ := ih
      set gm := lubinTateIterPoly F L (ϖ : L) m
      have h_comp : lubinTateIterPoly F L (ϖ : L) (m + 1) =
          Polynomial.C (ϖ : L) * gm + gm ^ qL F L := by
        change (Polynomial.C (ϖ : L) * Polynomial.X + Polynomial.X ^ qL F L).comp gm = _
        rw [Polynomial.add_comp, Polynomial.mul_comp, Polynomial.C_comp, Polynomial.X_comp,
          Polynomial.pow_comp, Polynomial.X_comp]
      obtain ⟨h_pow0, -, h_pow1⟩ := hpoly_pow_sub ih0 (hpoly_X_pow ((qL F L) ^ m)) ih1 (qL F L)
      have h_X_pow_eq : (Polynomial.X ^ ((qL F L) ^ m) : Polynomial L) ^ qL F L =
          Polynomial.X ^ ((qL F L) ^ (m + 1)) := by
        rw [← pow_mul, ← pow_succ]
      rw [h_X_pow_eq] at h_pow1
      have h_C_gm1 : polyValLe F L 1 (Polynomial.C (ϖ : L) * gm) := hpoly_mul 1 0 hpoly_C_ϖ ih0
      have h_C_gm0 : polyValLe F L 0 (Polynomial.C (ϖ : L) * gm) := by
        intro k
        rcases h_C_gm1 k with h0 | hle
        · exact Or.inl h0
        · right
          omega
      rw [h_comp]
      refine ⟨hpoly_add 0 h_C_gm0 h_pow0, ?_⟩
      have h_sub_eq : Polynomial.C (ϖ : L) * gm + gm ^ qL F L -
          Polynomial.X ^ ((qL F L) ^ (m + 1)) =
          Polynomial.C (ϖ : L) * gm + (gm ^ qL F L - Polynomial.X ^ ((qL F L) ^ (m + 1))) := by
        ring
      rw [h_sub_eq]
      exact hpoly_add 1 h_C_gm1 h_pow1
  have hfn_val : polyValLe F L 1 (fn - Polynomial.X ^ d) := by
    obtain ⟨hg0, hg1⟩ := hg_val (n - 1)
    obtain ⟨-, -, hP0_sub⟩ :=
      hpoly_pow_sub hg0 (hpoly_X_pow ((qL F L) ^ (n - 1))) hg1 (qL F L - 1)
    have h_X_d : (Polynomial.X ^ ((qL F L) ^ (n - 1)) : Polynomial L) ^ (qL F L - 1) =
        Polynomial.X ^ d := by
      rw [← pow_mul, mul_comm]
    rw [h_X_d] at hP0_sub
    have h_fn_sub : fn - Polynomial.X ^ d = (P0 - Polynomial.X ^ d) + Polynomial.C (ϖ : L) := by
      change P0 + Polynomial.C (ϖ : L) - Polynomial.X ^ d = _
      ring
    rw [h_fn_sub]
    exact hpoly_add 1 hP0_sub hpoly_C_ϖ
  have hQ0 : polyValLe F L 0 Q := by
    by_cases hQ_ne : Q = 0
    · subst hQ_ne
      intro k
      exact Or.inl (Polynomial.coeff_zero k)
    · obtain ⟨i₀, hi₀_mem, hi₀_min⟩ :=
        Finset.exists_min_image Q.support (fun i => valL F L (Q.coeff i))
          (Polynomial.support_nonempty.mpr hQ_ne)
      have hQi₀_ne : Q.coeff i₀ ≠ 0 := Polynomial.mem_support_iff.mp hi₀_mem
      set v₀ : ℤ := valL F L (Q.coeff i₀)
      have hQ_v₀ : ∀ i : ℕ, V v₀ (Q.coeff i) := by
        intro i
        by_cases hQi : Q.coeff i = 0
        · exact Or.inl hQi
        · exact Or.inr (hi₀_min i (Polynomial.mem_support_iff.mpr hQi))
      set k₀ : ℕ := d + i₀
      let x₀ : ℕ × ℕ := (d, i₀)
      have hx₀_mem : x₀ ∈ Finset.antidiagonal k₀ := Finset.mem_antidiagonal.mpr rfl
      let g : ℕ × ℕ → L := fun x => fn.coeff x.1 * Q.coeff x.2
      have hfn_lc : fn.coeff d = 1 := by
        rw [← hfn_deg, Polynomial.coeff_natDegree, hfn_monic.leadingCoeff]
      have hg_x₀_eq : g x₀ = Q.coeff i₀ := by
        dsimp [g, x₀]
        rw [hfn_lc, one_mul]
      have hg_other : ∀ x ∈ (Finset.antidiagonal k₀).erase x₀, V (v₀ + 1) (g x) := by
        intro x hx
        have hx_ne : x ≠ x₀ := (Finset.mem_erase.mp hx).1
        have hx_sum : x.1 + x.2 = d + i₀ := Finset.mem_antidiagonal.mp (Finset.mem_erase.mp hx).2
        have hx1_ne : x.1 ≠ d := by
          intro h1
          apply hx_ne
          ext
          · exact h1
          · change x.2 = i₀
            omega
        rcases lt_or_gt_of_ne hx1_ne with hlt | hgt
        · have hX_zero : (Polynomial.X ^ d : Polynomial L).coeff x.1 = 0 := by
            rw [Polynomial.coeff_X_pow, if_neg hx1_ne]
          have h_sub_coeff : (fn - Polynomial.X ^ d).coeff x.1 = fn.coeff x.1 := by
            rw [Polynomial.coeff_sub, hX_zero, sub_zero]
          have hV_fn : V 1 (fn.coeff x.1) := by
            have h1 : V 1 ((fn - Polynomial.X ^ d).coeff x.1) := hfn_val x.1
            rwa [h_sub_coeff] at h1
          have hV_prod := hV_mul 1 v₀ (fn.coeff x.1) (Q.coeff x.2) hV_fn (hQ_v₀ x.2)
          rwa [add_comm] at hV_prod
        · have hfn_zero : fn.coeff x.1 = 0 := by
            rw [← hfn_deg] at hgt
            exact Polynomial.coeff_eq_zero_of_natDegree_lt hgt
          dsimp [g]
          rw [hfn_zero, zero_mul]
          exact Or.inl rfl
      have h_sum_erase : V (v₀ + 1) (∑ x ∈ (Finset.antidiagonal k₀).erase x₀, g x) :=
        hV_sum (v₀ + 1) ((Finset.antidiagonal k₀).erase x₀) g hg_other
      have h_coeff_k₀ : (fn * Q).coeff k₀ =
          Q.coeff i₀ + ∑ x ∈ (Finset.antidiagonal k₀).erase x₀, g x := by
        rw [Polynomial.coeff_mul, ← Finset.add_sum_erase _ g hx₀_mem, hg_x₀_eq]
      have hv₀_nonneg : 0 ≤ v₀ := by
        by_contra hv₀_neg
        have h_D_v₀ : V (v₀ + 1) ((fn * Q).coeff k₀) := by
          rcases hD0 k₀ with h0 | hle
          · exact Or.inl h0
          · right
            omega
        have h_sub := hV_sub (v₀ + 1) h_D_v₀ h_sum_erase
        have h_eq : (fn * Q).coeff k₀ - ∑ x ∈ (Finset.antidiagonal k₀).erase x₀, g x =
            Q.coeff i₀ := by
          rw [h_coeff_k₀, add_sub_cancel_right]
        rw [h_eq] at h_sub
        rcases h_sub with h0 | hle
        · exact hQi₀_ne h0
        · change v₀ + 1 ≤ v₀ at hle
          omega
      intro k
      rcases hQ_v₀ k with h0 | hle
      · exact Or.inl h0
      · right
        omega
  have hQc0 : Q.coeff 0 = 0 := by
    have h0 : (fn * Q).coeff 0 = 0 := hDc0
    rw [Polynomial.mul_coeff_zero, hfn_coeff0] at h0
    exact (mul_eq_zero.mp h0).resolve_left (Units.ne_zero ϖ)
  have h_sub_val : polyValLe F L 1 (fn * Q - Polynomial.X ^ d * Q) := by
    have h_ring : fn * Q - Polynomial.X ^ d * Q = (fn - Polynomial.X ^ d) * Q := by ring
    rw [h_ring]
    exact hpoly_mul 1 0 hfn_val hQ0
  have h_X_mul_M : (Polynomial.X ^ d * Q).coeff M = 0 := by
    rw [Polynomial.coeff_X_pow_mul']
    split_ifs with hle
    · have h_zero : M - d = 0 := by omega
      rw [h_zero, hQc0]
    · rfl
  have h_coeff_M : (fn * Q - Polynomial.X ^ d * Q).coeff M = (fn * Q).coeff M := by
    rw [Polynomial.coeff_sub, h_X_mul_M, sub_zero]
  rcases h_sub_val M with h0 | hle
  · rw [h_coeff_M] at h0
    exact hD_eq.1 h0
  · rw [h_coeff_M, hD_eq.2] at hle
    omega

theorem exists_aeval_lubinTateDivPoly_eq_zero_and_lubinTateLevelField_eq_adjoin (F : Type u)
    [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (ϖ : Lˣ)
    (hϖ : valL F L ϖ = 1) (n : ℕ) (hn : 1 ≤ n) :
    ∃ π_n : AlgebraicClosure F,
      Polynomial.aeval π_n (lubinTateDivPoly F L (ϖ : L) n) = 0 ∧
      lubinTateLevelField F L ϖ n = IntermediateField.adjoin L {π_n} :=
by
  have h_gen : ∀ (K E : Type u) [Field K] [Field E] [Algebra K E] [IsAlgClosed E]
      (g_n f_n g_prev : Polynomial K) (P : K → Polynomial K) (Q_deg : ℕ) (S : Finset K),
      g_n.Monic → g_n.natDegree = Q_deg → f_n.Monic → Irreducible f_n →
      g_n = g_prev * f_n → S.card = Q_deg →
      (∀ a ∈ S, (g_n.comp (P a)) %ₘ g_n = 0) →
      (∀ a₁ ∈ S, ∀ a₂ ∈ S, a₁ ≠ a₂ → ¬ (f_n ∣ (P a₁ - P a₂))) →
      ∃ π_n : E, Polynomial.aeval π_n f_n = 0 ∧
        IntermediateField.adjoin K {α : E | Polynomial.aeval α g_n = 0} =
          IntermediateField.adjoin K {π_n} := by
    intro K E _ _ _ _ g_n f_n g_prev P Q_deg S hg_monic hg_deg hf_monic hf_irr
      h_gn_eq hS_card h_mod h_not_dvd
    have hf_deg_ne : f_n.degree ≠ 0 := hf_irr.degree_pos.ne'
    obtain ⟨π_n, hπ_aeval⟩ := IsAlgClosed.exists_aeval_eq_zero E f_n hf_deg_ne
    have hπ_gn : Polynomial.aeval π_n g_n = 0 := by
      rw [h_gn_eq, map_mul, hπ_aeval, mul_zero]
    refine ⟨π_n, hπ_aeval, le_antisymm ?_ ?_⟩
    · let Φ : K → E := fun a => Polynomial.aeval π_n (P a)
      set G_n : Polynomial E := g_n.map (algebraMap K E)
      set R : Finset E := G_n.roots.toFinset
      have hGn_monic : G_n.Monic := hg_monic.map (algebraMap K E)
      have hGn_ne : G_n ≠ 0 := hGn_monic.ne_zero
      have hGn_deg : G_n.natDegree = Q_deg := by
        rw [hg_monic.natDegree_map, hg_deg]
      have hR_card : R.card ≤ Q_deg := by
        calc R.card ≤ G_n.roots.card := Multiset.toFinset_card_le G_n.roots
          _ ≤ G_n.natDegree := Polynomial.card_roots' G_n
          _ = Q_deg := hGn_deg
      have h_sub : S.image Φ ⊆ R := by
        intro α hα
        obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hα
        have h_aeval_Phi : Polynomial.aeval (Φ a) g_n = 0 := by
          have h_div := (Polynomial.modByMonic_add_div (g_n.comp (P a)) hg_monic).symm
          have h_eval := congrArg (Polynomial.aeval π_n) h_div
          rw [Polynomial.aeval_comp, h_mod a ha, map_add, map_zero, zero_add, map_mul, hπ_gn,
            zero_mul] at h_eval
          exact h_eval
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hGn_ne, Polynomial.IsRoot.def,
          Polynomial.eval_map_algebraMap]
        exact h_aeval_Phi
      have h_inj : Set.InjOn Φ (S : Set K) := by
        intro a₁ ha₁ a₂ ha₂ h_eq
        by_contra hne
        have h_aeval_D : Polynomial.aeval π_n (P a₁ - P a₂) = 0 := by
          rw [map_sub]
          exact sub_eq_zero.mpr h_eq
        have h_minpoly : minpoly K π_n = f_n :=
          (minpoly.eq_of_irreducible_of_monic hf_irr hπ_aeval hf_monic).symm
        have h_dvd : f_n ∣ (P a₁ - P a₂) := by
          rw [← h_minpoly]
          exact minpoly.dvd K π_n h_aeval_D
        exact h_not_dvd a₁ ha₁ a₂ ha₂ hne h_dvd
      have h_im_card : (S.image Φ).card = Q_deg := by
        rw [Finset.card_image_of_injOn h_inj, hS_card]
      have h_card_le : R.card ≤ (S.image Φ).card := by
        rw [h_im_card]
        exact hR_card
      have h_eq_R : S.image Φ = R := (Finset.subset_iff_eq_of_card_le h_card_le).mp h_sub
      rw [IntermediateField.adjoin_le_iff]
      intro α hα
      have hα_R : α ∈ R := by
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hGn_ne, Polynomial.IsRoot.def,
          Polynomial.eval_map_algebraMap]
        exact hα
      rw [← h_eq_R] at hα_R
      obtain ⟨a, _, rfl⟩ := Finset.mem_image.mp hα_R
      let M : IntermediateField K E := IntermediateField.adjoin K {π_n}
      let π_M : M := ⟨π_n, IntermediateField.mem_adjoin_simple_self K π_n⟩
      have h_val : π_n = M.val π_M := rfl
      change Φ a ∈ M
      dsimp [Φ]
      rw [h_val, Polynomial.aeval_algHom_apply]
      exact (Polynomial.aeval π_M (P a)).2
    · rw [IntermediateField.adjoin_le_iff]
      intro x hx
      rw [Set.mem_singleton_iff.mp hx]
      exact IntermediateField.subset_adjoin K _ hπ_gn
  have hres_ne : resDeg F L ≠ 0 := by
    intro h0
    unfold valL at hϖ
    rw [h0, Nat.cast_zero, Int.ediv_zero] at hϖ
    omega
  have hq_gt : 1 < q F := Finite.one_lt_card
  have hqL_gt : 1 < qL F L := one_lt_pow₀ hq_gt hres_ne
  have hg_deg_all : ∀ m : ℕ,
      (lubinTateIterPoly F L (ϖ : L) m).Monic ∧
      (lubinTateIterPoly F L (ϖ : L) m).natDegree = (qL F L) ^ m := by
    intro m
    have hdeg_lt : (Polynomial.C (ϖ : L) * Polynomial.X).degree <
        (Polynomial.X ^ qL F L : Polynomial L).degree := by
      rw [Polynomial.degree_X_pow]
      exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_le (ϖ : L)) (WithBot.coe_lt_coe.mpr hqL_gt)
    have hf0_monic : (lubinTatePoly F L (ϖ : L)).Monic := by
      change (Polynomial.C (ϖ : L) * Polynomial.X + Polynomial.X ^ qL F L).Monic
      rw [add_comm]
      exact Polynomial.Monic.add_of_left (Polynomial.monic_X_pow (qL F L)) hdeg_lt
    have hf0_deg : (lubinTatePoly F L (ϖ : L)).natDegree = qL F L := by
      change (Polynomial.C (ϖ : L) * Polynomial.X + Polynomial.X ^ qL F L).natDegree = qL F L
      rw [add_comm, Polynomial.natDegree_add_eq_left_of_degree_lt hdeg_lt,
        Polynomial.natDegree_X_pow]
    induction m with
    | zero =>
      dsimp [lubinTateIterPoly]
      exact ⟨Polynomial.monic_X, Polynomial.natDegree_X⟩
    | succ m ih =>
      obtain ⟨ih_monic, ih_deg⟩ := ih
      have h_deg_ne : (lubinTateIterPoly F L (ϖ : L) m).natDegree ≠ 0 := by
        rw [ih_deg]
        exact pow_ne_zero m (by omega)
      dsimp [lubinTateIterPoly]
      refine ⟨hf0_monic.comp ih_monic h_deg_ne, ?_⟩
      rw [Polynomial.natDegree_comp, hf0_deg, ih_deg, pow_succ']
  have hg_deg : (lubinTateIterPoly F L (ϖ : L) n).natDegree = (qL F L) ^ n := (hg_deg_all n).2
  obtain ⟨hg_monic, hg_aeval⟩ := lubinTateIterPoly_monic_and_aeval_eq_zero_iff F L ϖ n
  obtain ⟨hf_monic, -, hf_irr⟩ :=
    lubinTateDivPoly_monic_coeff_zero_and_irreducible F L ϖ hϖ n hn
  set g_n : Polynomial L := lubinTateIterPoly F L (ϖ : L) n
  set f_n : Polynomial L := lubinTateDivPoly F L (ϖ : L) n
  have hn_eq : n = (n - 1) + 1 := (Nat.sub_add_cancel hn).symm
  have hqL_sub : (qL F L - 1) + 1 = qL F L := Nat.sub_add_cancel (by omega)
  have h_gn_eq : g_n = lubinTateIterPoly F L (ϖ : L) (n - 1) * f_n := by
    change lubinTateIterPoly F L (ϖ : L) n =
      lubinTateIterPoly F L (ϖ : L) (n - 1) *
        ((lubinTateIterPoly F L (ϖ : L) (n - 1)) ^ (qL F L - 1) + Polynomial.C (ϖ : L))
    conv_lhs => rw [hn_eq]
    change (Polynomial.C (ϖ : L) * Polynomial.X + Polynomial.X ^ qL F L).comp
      (lubinTateIterPoly F L (ϖ : L) (n - 1)) = _
    rw [Polynomial.add_comp, Polynomial.mul_comp, Polynomial.C_comp, Polynomial.X_comp,
      Polynomial.pow_comp, Polynomial.X_comp]
    conv_lhs => rw [← hqL_sub, pow_succ']
    ring
  obtain ⟨S, hS_card, hS_int, hS_diff⟩ :=
    exists_finset_card_qL_pow_and_valL_sub_lt F L ϖ hϖ n
  have h_mod : ∀ a ∈ S, (g_n.comp (lubinTateEndoPoly F L (ϖ : L) a n)) %ₘ g_n = 0 :=
    fun a ha => lubinTateIterPoly_comp_lubinTateEndoPoly_modByMonic_eq_zero F L ϖ hϖ n a (hS_int a ha)
  have h_not_dvd : ∀ a₁ ∈ S, ∀ a₂ ∈ S, a₁ ≠ a₂ →
      ¬ (f_n ∣ (lubinTateEndoPoly F L (ϖ : L) a₁ n - lubinTateEndoPoly F L (ϖ : L) a₂ n)) := by
    intro a₁ ha₁ a₂ ha₂ hne
    obtain ⟨k, hk_lt, hk_val⟩ := hS_diff a₁ ha₁ a₂ ha₂ hne
    obtain ⟨hD0, hDc0, hD_lt, hD_eq⟩ :=
      lubinTateEndoPoly_sub_coeff_valL_staircase F L ϖ hϖ n a₁ a₂
        (hS_int a₁ ha₁) (hS_int a₂ ha₂) hne k hk_lt hk_val
    set M : ℕ := (qL F L) ^ k
    have hM_pos : 1 ≤ M := Nat.one_le_pow k (qL F L) (by omega)
    have hM_le : M ≤ (qL F L) ^ (n - 1) :=
      Nat.pow_le_pow_right (by omega) (by omega)
    exact not_lubinTateDivPoly_dvd_of_valL_coeff_eq_zero F L ϖ hϖ n hn
      (lubinTateEndoPoly F L (ϖ : L) a₁ n - lubinTateEndoPoly F L (ϖ : L) a₂ n)
      hD0 hDc0 M hM_pos hM_le hD_lt hD_eq
  obtain ⟨π_n, hπ_aeval, h_adj⟩ :=
    h_gen ↥L (AlgebraicClosure F) g_n f_n (lubinTateIterPoly F L (ϖ : L) (n - 1))
      (fun a => lubinTateEndoPoly F L (ϖ : L) a n) ((qL F L) ^ n) S
      hg_monic hg_deg hf_monic hf_irr h_gn_eq hS_card h_mod h_not_dvd
  refine ⟨π_n, hπ_aeval, ?_⟩
  unfold lubinTateLevelField
  have h_set : {α : AlgebraicClosure F | isLubinTateRoot F L ϖ n α} =
      {α : AlgebraicClosure F | Polynomial.aeval α g_n = 0} := by
    ext α
    exact (hg_aeval α).symm
  rw [h_set]
  exact h_adj

theorem exists_norm_eq_of_eq_adjoin_of_irreducible_monic (F : Type u) [Field F]
    (L : IntermediateField F (AlgebraicClosure F))
    (A : IntermediateField L (AlgebraicClosure F)) (f : Polynomial L)
    (π : AlgebraicClosure F) (hA : A = IntermediateField.adjoin L {π})
    (hf_monic : f.Monic) (hf_irr : Irreducible f) (h_aeval : Polynomial.aeval π f = 0) :
    ∃ z : A, Algebra.norm L z = f.coeff 0 :=
by
  have h_gen : ∀ (K E : Type u) [Field K] [Field E] [Algebra K E] [Algebra.IsIntegral K E]
      (A : IntermediateField K E) (f : Polynomial K) (π : E),
      A = IntermediateField.adjoin K {π} → f.Monic → Irreducible f →
      Polynomial.aeval π f = 0 → ∃ z : A, Algebra.norm K z = f.coeff 0 := by
    intro K E _ _ _ _ B g α hB hg_monic hg_irr hg_aeval
    subst hB
    have h_int : IsIntegral K α := Algebra.IsIntegral.isIntegral α
    let pb : PowerBasis K ↥(IntermediateField.adjoin K {α}) :=
      IntermediateField.adjoin.powerBasis h_int
    have h_minpoly : minpoly K pb.gen = g := by
      rw [IntermediateField.adjoin.powerBasis_gen h_int, IntermediateField.minpoly_gen K α]
      exact (minpoly.eq_of_irreducible_of_monic hg_irr hg_aeval hg_monic).symm
    have h_norm_gen : Algebra.norm K pb.gen = (-1 : K) ^ pb.dim * g.coeff 0 := by
      rw [Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, h_minpoly]
    refine ⟨-pb.gen, ?_⟩
    have h_neg : (-pb.gen : ↥(IntermediateField.adjoin K {α})) =
        algebraMap K ↥(IntermediateField.adjoin K {α}) (-1 : K) * pb.gen := by
      simp
    rw [h_neg, map_mul, Algebra.norm_algebraMap, pb.finrank, h_norm_gen, ← mul_assoc, ← mul_pow]
    simp
  exact h_gen ↥L (AlgebraicClosure F) A f π hA hf_monic hf_irr h_aeval

theorem resDeg_restrictScalars_le_of_exists_norm_eq (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (ϖ : Lˣ)
    (hϖ : valL F L ϖ = 1) (A : IntermediateField L (AlgebraicClosure F))
    [FiniteDimensional L A] (h_norm : ∃ z : A, Algebra.norm L z = (ϖ : L)) :
    resDeg F (A.restrictScalars F) ≤ resDeg F L :=
by
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Lˣ, Multiplicative.toAdd (relValHom u) = relVal F L u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : Lˣ,
      relVal F L ((u * v : Lˣ) : L) = relVal F L u + relVal F L v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : Lˣ) (k : ℤ),
      relVal F L ((u ^ k : Lˣ) : L) = k * relVal F L u := by
    intro u k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F L ∧ ∃ π : Lˣ, relVal F L π = resDeg F L := by
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L u,
        (map_ne_zero (algebraMap F L)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (u : F)) = (u : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (u : F)
      have hpow : addVal F ((u : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F u := by
        change Multiplicative.toAdd (addValHom (u ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hres_pos, π, hπ⟩ := resDeg_mem
  have h_relVal_ϖ : relVal F L ϖ = (resDeg F L : ℤ) := by
    let q := relVal F L ϖ / (resDeg F L : ℤ)
    let r := relVal F L ϖ % (resDeg F L : ℤ)
    have hdiv : r + (resDeg F L : ℤ) * q = relVal F L ϖ := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r := Int.emod_nonneg _ (by positivity)
    have hrlt : r < (resDeg F L : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F L ((ϖ * π ^ (-q) : Lˣ) : L) = r := by
      rw [relVal_units_mul, relVal_units_zpow, hπ]
      linarith
    have hr_eq : r = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k} := by
        refine ⟨hr_pos, ((ϖ * π ^ (-q) : Lˣ) : L), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F L ≤ r.toNat := Nat.sInf_le hmem
      omega
    have hq : q = 1 := hϖ
    rw [hr_eq, hq, mul_one, zero_add] at hdiv
    exact hdiv.symm
  obtain ⟨z, hz⟩ := h_norm
  have hz_ne : z ≠ 0 := by
    intro h0
    rw [h0, Algebra.norm_zero] at hz
    exact ϖ.ne_zero hz.symm
  let E : IntermediateField F (AlgebraicClosure F) := A.restrictScalars F
  let zE : E := ⟨z.1, (IntermediateField.mem_restrictScalars F).mpr z.2⟩
  have hzE_ne : zE ≠ 0 := fun h => hz_ne (Subtype.ext (congrArg Subtype.val h))
  have h_norm_eq : Algebra.norm F zE = Algebra.norm F (ϖ : L) := by
    have h1 : Algebra.norm F zE = Algebra.norm F z := rfl
    rw [h1, ← Algebra.norm_norm (R := F) (S := L) (a := z), hz]
  have h_relVal : relVal F E zE = (resDeg F L : ℤ) := by
    unfold relVal
    rw [h_norm_eq]
    exact h_relVal_ϖ
  exact Nat.sInf_le ⟨hres_pos, zE, hzE_ne, h_relVal⟩

theorem lubinTateLevelField_finiteDimensional_and_resDeg_le (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (ϖ : Lˣ)
    (hϖ : valL F L ϖ = 1) (n : ℕ) :
    FiniteDimensional L (lubinTateLevelField F L ϖ n) ∧
      resDeg F ((lubinTateLevelField F L ϖ n).restrictScalars F) ≤ resDeg F L :=
by
  obtain ⟨h_monic, h_aeval⟩ := lubinTateIterPoly_monic_and_aeval_eq_zero_iff F L ϖ n
  set P : Polynomial L := lubinTateIterPoly F L (ϖ : L) n
  have hP_ne : P ≠ 0 := h_monic.ne_zero
  have h_set : {α : AlgebraicClosure F | isLubinTateRoot F L ϖ n α} =
      P.rootSet (AlgebraicClosure F) := by
    ext α
    simp only [Set.mem_setOf_eq]
    exact ((Polynomial.mem_rootSet_of_ne hP_ne).trans (h_aeval α)).symm
  have hFin : FiniteDimensional L (lubinTateLevelField F L ϖ n) := by
    unfold lubinTateLevelField
    rw [h_set]
    haveI : Polynomial.IsSplittingField L
        ↥(IntermediateField.adjoin L (P.rootSet (AlgebraicClosure F))) P :=
      IntermediateField.adjoin_rootSet_isSplittingField (IsAlgClosed.splits _)
    exact Polynomial.IsSplittingField.finiteDimensional
      ↥(IntermediateField.adjoin L (P.rootSet (AlgebraicClosure F))) P
  refine ⟨hFin, ?_⟩
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · have hbot : lubinTateLevelField F L ϖ 0 = ⊥ := by
      unfold lubinTateLevelField
      rw [IntermediateField.adjoin_eq_bot_iff]
      intro α hα
      change isLubinTateRoot F L ϖ 0 α at hα
      unfold isLubinTateRoot at hα
      rw [Function.iterate_zero_apply] at hα
      rw [hα]
      exact zero_mem ⊥
    rw [hbot, IntermediateField.restrictScalars_bot_eq_self L]
  · obtain ⟨hf_monic, hf_coeff, hf_irr⟩ :=
      lubinTateDivPoly_monic_coeff_zero_and_irreducible F L ϖ hϖ n hn
    obtain ⟨π_n, hπ_aeval, hM_eq⟩ :=
      exists_aeval_lubinTateDivPoly_eq_zero_and_lubinTateLevelField_eq_adjoin F L ϖ hϖ n hn
    obtain ⟨z, hz⟩ :=
      exists_norm_eq_of_eq_adjoin_of_irreducible_monic F L (lubinTateLevelField F L ϖ n)
        (lubinTateDivPoly F L (ϖ : L) n) π_n hM_eq hf_monic hf_irr hπ_aeval
    rw [hf_coeff] at hz
    haveI : FiniteDimensional L (lubinTateLevelField F L ϖ n) := hFin
    exact resDeg_restrictScalars_le_of_exists_norm_eq F L ϖ hϖ
      (lubinTateLevelField F L ϖ n) ⟨z, hz⟩

theorem inf_eq_bot_of_resDeg_le_and_finrank_mul_resDeg_le (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (A B : IntermediateField L (AlgebraicClosure F))
    [FiniteDimensional L A] [FiniteDimensional L B]
    (hA : resDeg F (A.restrictScalars F) ≤ resDeg F L)
    (hB : Module.finrank L B * resDeg F L ≤ resDeg F (B.restrictScalars F)) :
    A ⊓ B = ⊥ :=
by
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  have addVal_pow : ∀ (u : Fˣ) (n : ℕ), addVal F ((u : F) ^ n) = (n : ℤ) * addVal F u := by
    intro u n
    change Multiplicative.toAdd (addValHom (u ^ n)) = _
    rw [map_pow, toAdd_pow, nsmul_eq_mul]
    rfl
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E],
      0 < resDeg F E ∧ ∃ π : Eˣ, relVal F E π = resDeg F E := by
    intro E _
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : E, z ≠ 0 ∧ relVal F E z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F E, Module.finrank_pos, algebraMap F E u,
        (map_ne_zero (algebraMap F E)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F E (u : F)) = (u : F) ^ Module.finrank F E :=
        Algebra.norm_algebraMap (u : F)
      rw [relVal, hnorm, addVal_pow, hu, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  have resDeg_mono : ∀ {E₁ E₂ : IntermediateField F (AlgebraicClosure F)} (h : E₁ ≤ E₂)
      [FiniteDimensional F E₂], resDeg F E₁ ≤ resDeg F E₂ := by
    intro E₁ E₂ h _
    let M : IntermediateField E₁ (AlgebraicClosure F) := IntermediateField.extendScalars h
    haveI : FiniteDimensional F M := ‹FiniteDimensional F E₂›
    haveI : FiniteDimensional F E₁ := FiniteDimensional.left F E₁ M
    haveI : FiniteDimensional E₁ M := FiniteDimensional.right F E₁ M
    obtain ⟨hpos₂, π₂, hπ₂⟩ := resDeg_mem E₂
    let y : M := toExtendScalars F h (π₂ : E₂)
    have hy0 : y ≠ 0 := (map_ne_zero (toExtendScalars F h)).mpr π₂.ne_zero
    let x : E₁ := Algebra.norm E₁ y
    have hx0 : x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy0
    have hnorm : Algebra.norm F x = Algebra.norm F (π₂ : E₂) :=
      @Algebra.norm_norm F E₁ _ _ _ _ M _ _ _ _ _ y
    have hrel : relVal F E₁ x = (resDeg F E₂ : ℤ) := by
      rw [relVal, hnorm]
      exact hπ₂
    exact Nat.sInf_le ⟨hpos₂, x, hx0, hrel⟩
  have resDeg_le_finrank_mul : ∀ {E₁ E₂ : IntermediateField F (AlgebraicClosure F)} (h : E₁ ≤ E₂)
      [FiniteDimensional F E₂],
      resDeg F E₂ ≤ Module.finrank E₁ (IntermediateField.extendScalars h) * resDeg F E₁ := by
    intro E₁ E₂ h _
    let M : IntermediateField E₁ (AlgebraicClosure F) := IntermediateField.extendScalars h
    haveI : FiniteDimensional F M := ‹FiniteDimensional F E₂›
    haveI : FiniteDimensional F E₁ := FiniteDimensional.left F E₁ M
    haveI : FiniteDimensional E₁ M := FiniteDimensional.right F E₁ M
    obtain ⟨hpos₁, π₁, hπ₁⟩ := resDeg_mem E₁
    let y : M := algebraMap E₁ M (π₁ : E₁)
    have hy0 : y ≠ 0 := (map_ne_zero (algebraMap E₁ M)).mpr π₁.ne_zero
    have hnorm : Algebra.norm F y = (Algebra.norm F (π₁ : E₁)) ^ Module.finrank E₁ M := by
      calc Algebra.norm F y
        _ = Algebra.norm F (Algebra.norm E₁ (algebraMap E₁ M (π₁ : E₁))) :=
            (@Algebra.norm_norm F E₁ _ _ _ _ M _ _ _ _ _ y).symm
        _ = Algebra.norm F ((π₁ : E₁) ^ Module.finrank E₁ M) := by
            rw [Algebra.norm_algebraMap]
        _ = (Algebra.norm F (π₁ : E₁)) ^ Module.finrank E₁ M :=
            map_pow (Algebra.norm F) (π₁ : E₁) (Module.finrank E₁ M)
    let u₁ : Fˣ := Units.map (Algebra.norm F) π₁
    have hu₁ : (u₁ : F) = Algebra.norm F (π₁ : E₁) := rfl
    have hrel : relVal F E₂ y = ((Module.finrank E₁ M * resDeg F E₁ : ℕ) : ℤ) := by
      change addVal F (Algebra.norm F y) = _
      rw [hnorm, ← hu₁, addVal_pow, hu₁]
      change (Module.finrank E₁ M : ℤ) * relVal F E₁ π₁ = _
      rw [hπ₁, Nat.cast_mul]
    have hpos_mul : 0 < Module.finrank E₁ M * resDeg F E₁ :=
      Nat.mul_pos Module.finrank_pos hpos₁
    exact Nat.sInf_le ⟨hpos_mul, y, hy0, hrel⟩
  haveI : FiniteDimensional F (A.restrictScalars F) := by
    change FiniteDimensional F A
    exact FiniteDimensional.trans F L A
  haveI : FiniteDimensional F (B.restrictScalars F) := by
    change FiniteDimensional F B
    exact FiniteDimensional.trans F L B
  have hKA : (A ⊓ B).restrictScalars F ≤ A.restrictScalars F :=
    (IntermediateField.restrictScalars_le_iff F).mpr inf_le_left
  haveI : FiniteDimensional F (IntermediateField.extendScalars hKA) :=
    ‹FiniteDimensional F (A.restrictScalars F)›
  haveI : FiniteDimensional F ((A ⊓ B).restrictScalars F) :=
    FiniteDimensional.left F ((A ⊓ B).restrictScalars F) (IntermediateField.extendScalars hKA)
  have hLK : L ≤ (A ⊓ B).restrictScalars F := by
    have hbot : (⊥ : IntermediateField L (AlgebraicClosure F)).restrictScalars F ≤
        (A ⊓ B).restrictScalars F :=
      (IntermediateField.restrictScalars_le_iff F).mpr bot_le
    rwa [IntermediateField.restrictScalars_bot_eq_self] at hbot
  have hLK_res : resDeg F L ≤ resDeg F ((A ⊓ B).restrictScalars F) := resDeg_mono hLK
  have hKA_res : resDeg F ((A ⊓ B).restrictScalars F) ≤ resDeg F (A.restrictScalars F) :=
    resDeg_mono hKA
  have hK_res : resDeg F ((A ⊓ B).restrictScalars F) = resDeg F L := by omega
  have hKB : (A ⊓ B).restrictScalars F ≤ B.restrictScalars F :=
    (IntermediateField.restrictScalars_le_iff F).mpr inf_le_right
  haveI : FiniteDimensional F (IntermediateField.extendScalars hKB) :=
    ‹FiniteDimensional F (B.restrictScalars F)›
  haveI : FiniteDimensional ((A ⊓ B).restrictScalars F) (IntermediateField.extendScalars hKB) :=
    FiniteDimensional.right F ((A ⊓ B).restrictScalars F) (IntermediateField.extendScalars hKB)
  have h1 : Module.finrank F L * Module.finrank L ↥(A ⊓ B) =
      Module.finrank F ↥((A ⊓ B).restrictScalars F) :=
    Module.finrank_mul_finrank F L ↥(A ⊓ B)
  have h2 : Module.finrank F ↥((A ⊓ B).restrictScalars F) *
      Module.finrank ↥((A ⊓ B).restrictScalars F) ↥(IntermediateField.extendScalars hKB) =
      Module.finrank F ↥B :=
    Module.finrank_mul_finrank F ↥((A ⊓ B).restrictScalars F) ↥(IntermediateField.extendScalars hKB)
  have h3 : Module.finrank F L * Module.finrank L ↥B = Module.finrank F ↥B :=
    Module.finrank_mul_finrank F L ↥B
  have h_mul : Module.finrank L ↥(A ⊓ B) *
      Module.finrank ↥((A ⊓ B).restrictScalars F) ↥(IntermediateField.extendScalars hKB) =
      Module.finrank L ↥B := by
    apply Nat.eq_of_mul_eq_mul_left (Module.finrank_pos (R := F) (M := L))
    rw [← mul_assoc, h1, h2, h3]
  have hB_upper : resDeg F (B.restrictScalars F) ≤
      Module.finrank ↥((A ⊓ B).restrictScalars F) ↥(IntermediateField.extendScalars hKB) *
        resDeg F L := by
    have h4 := resDeg_le_finrank_mul hKB
    rwa [hK_res] at h4
  have h_ineq : Module.finrank L ↥(A ⊓ B) *
      (Module.finrank ↥((A ⊓ B).restrictScalars F) ↥(IntermediateField.extendScalars hKB) *
        resDeg F L) ≤
      1 * (Module.finrank ↥((A ⊓ B).restrictScalars F) ↥(IntermediateField.extendScalars hKB) *
        resDeg F L) := by
    calc Module.finrank L ↥(A ⊓ B) *
        (Module.finrank ↥((A ⊓ B).restrictScalars F) ↥(IntermediateField.extendScalars hKB) *
          resDeg F L)
      _ = (Module.finrank L ↥(A ⊓ B) *
            Module.finrank ↥((A ⊓ B).restrictScalars F) ↥(IntermediateField.extendScalars hKB)) *
          resDeg F L := (mul_assoc _ _ _).symm
      _ = Module.finrank L ↥B * resDeg F L := by rw [h_mul]
      _ ≤ resDeg F (B.restrictScalars F) := hB
      _ ≤ Module.finrank ↥((A ⊓ B).restrictScalars F) ↥(IntermediateField.extendScalars hKB) *
          resDeg F L := hB_upper
      _ = 1 * (Module.finrank ↥((A ⊓ B).restrictScalars F) ↥(IntermediateField.extendScalars hKB) *
          resDeg F L) := (one_mul _).symm
  have hpos_L : 0 < resDeg F L := (resDeg_mem L).1
  have hpos_prod : 0 <
      Module.finrank ↥((A ⊓ B).restrictScalars F) ↥(IntermediateField.extendScalars hKB) *
        resDeg F L :=
    Nat.mul_pos Module.finrank_pos hpos_L
  have hK_le_one : Module.finrank L ↥(A ⊓ B) ≤ 1 :=
    Nat.le_of_mul_le_mul_right h_ineq hpos_prod
  have hK_pos : 0 < Module.finrank L ↥(A ⊓ B) := Module.finrank_pos
  have hK_one : Module.finrank L ↥(A ⊓ B) = 1 := by omega
  exact IntermediateField.finrank_eq_one_iff.mp hK_one

theorem lubinTateTotalField_linearDisjoint_unramifiedTotalField_of_levels (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) (ϖ : Lˣ)
    (hlevels : ∀ (n m : ℕ), 0 < m → ¬ p F ∣ m →
      (lubinTateLevelField F L ϖ n).LinearDisjoint (unramifiedLevelField F L m)) :
    (lubinTateTotalField F L ϖ).LinearDisjoint (unramifiedTotalField F L) :=
by
  have h_gen : ∀ (K E : Type u) [Field K] [Field E] [Algebra K E]
      {ι₁ ι₂ : Type} [Nonempty ι₁] [Nonempty ι₂]
      (A : ι₁ → IntermediateField K E) (B : ι₂ → IntermediateField K E)
      (E₁ E₂ : IntermediateField K E),
      Directed (· ≤ ·) A → Directed (· ≤ ·) B →
      E₁ ≤ (⨆ i, A i) → E₂ ≤ (⨆ j, B j) →
      (∀ i j, (A i).LinearDisjoint (B j)) →
      E₁.LinearDisjoint E₂ := by
    intro K E _ _ _ ι₁ ι₂ _ _ A B E₁ E₂ hA hB hE₁ hE₂ hAB
    have h_fg : ∀ {ι : Type} [Nonempty ι] (C : ι → IntermediateField K E),
        Directed (· ≤ ·) C → ∀ (M : Submodule K E),
        M ≤ (⨆ i, C i).toSubalgebra.toSubmodule → M.FG →
        ∃ i : ι, M ≤ (C i).toSubalgebra.toSubmodule := by
      intro ι _ C hC M hM_le hM_fg
      rcases hM_fg with ⟨s, hs⟩
      have hmem : ∀ x : {x // x ∈ s}, ∃ i : ι, x.1 ∈ C i := by
        intro x
        have hxM : x.1 ∈ M := by
          rw [← hs]
          exact Submodule.subset_span x.2
        have hxSup : x.1 ∈ ((⨆ i, C i : IntermediateField K E) : Set E) := hM_le hxM
        rw [IntermediateField.coe_iSup_of_directed hC, Set.mem_iUnion] at hxSup
        exact hxSup
      choose f hf using hmem
      obtain ⟨i₀, hi₀⟩ := hC.finset_le (Finset.univ.image f)
      refine ⟨i₀, ?_⟩
      rw [← hs, Submodule.span_le]
      intro x hx
      let xs : {y // y ∈ s} := ⟨x, hx⟩
      have hle : C (f xs) ≤ C i₀ :=
        hi₀ (f xs) (Finset.mem_image_of_mem f (Finset.mem_univ xs))
      exact hle (hf xs)
    rw [IntermediateField.linearDisjoint_iff', Subalgebra.linearDisjoint_iff]
    apply Submodule.LinearDisjoint.of_linearDisjoint_fg
    intro M' N' hM' hN' hM'_fg hN'_fg
    obtain ⟨i, hi⟩ := h_fg A hA M' (le_trans hM' hE₁) hM'_fg
    obtain ⟨j, hj⟩ := h_fg B hB N' (le_trans hN' hE₂) hN'_fg
    have hij : (A i).toSubalgebra.toSubmodule.LinearDisjoint (B j).toSubalgebra.toSubmodule :=
      (IntermediateField.linearDisjoint_iff'.trans (Subalgebra.linearDisjoint_iff _ _)).mp (hAB i j)
    exact hij.of_le_of_flat_right hi hj
  have hdir_LT : Directed (· ≤ ·) (lubinTateLevelField F L ϖ) := by
    apply Monotone.directed_le
    intro n₁ n₂ hn
    unfold lubinTateLevelField
    rw [IntermediateField.adjoin_le_iff]
    intro α hα
    apply IntermediateField.subset_adjoin
    change isLubinTateRoot F L ϖ n₂ α
    unfold isLubinTateRoot at hα ⊢
    set g : AlgebraicClosure F → AlgebraicClosure F :=
      fun y => ((ϖ : L) : AlgebraicClosure F) * y + y ^ qL F L
    have hqL : qL F L ≠ 0 := ne_of_gt (pow_pos (q_pos F) (resDeg F L))
    have hg0 : g 0 = 0 := by simp [g, zero_pow hqL]
    have hadd : n₂ = (n₂ - n₁) + n₁ := (Nat.sub_add_cancel hn).symm
    rw [hadd, Function.iterate_add_apply, hα, Function.iterate_fixed hg0]
  have hE₁_le : lubinTateTotalField F L ϖ ≤ ⨆ n : ℕ, lubinTateLevelField F L ϖ n := by
    unfold lubinTateTotalField
    rw [IntermediateField.adjoin_le_iff]
    rintro α ⟨n, hα⟩
    have hα_mem : α ∈ lubinTateLevelField F L ϖ n := IntermediateField.subset_adjoin L _ hα
    exact (le_iSup (lubinTateLevelField F L ϖ) n) hα_mem
  haveI : CharP 𝓀[F] (p F) := ringChar.charP 𝓀[F]
  have hp : Nat.Prime (p F) := CharP.char_is_prime 𝓀[F] (p F)
  let IdxP := {m : ℕ // 0 < m ∧ ¬ p F ∣ m}
  haveI : Nonempty IdxP := ⟨⟨1, Nat.one_pos, hp.not_dvd_one⟩⟩
  let B : IdxP → IntermediateField L (AlgebraicClosure F) :=
    fun m => unramifiedLevelField F L m.1
  have hdir_unram : Directed (· ≤ ·) B := by
    intro m₁ m₂
    let m₃ : IdxP := ⟨m₁.1 * m₂.1, Nat.mul_pos m₁.2.1 m₂.2.1,
      fun h => (hp.dvd_mul.mp h).elim m₁.2.2 m₂.2.2⟩
    refine ⟨m₃, ?_, ?_⟩
    · dsimp [B]
      unfold unramifiedLevelField
      rw [IntermediateField.adjoin_le_iff]
      intro ζ hζ
      apply IntermediateField.subset_adjoin
      change ζ ^ (m₁.1 * m₂.1) = 1
      change ζ ^ m₁.1 = 1 at hζ
      rw [pow_mul, hζ, one_pow]
    · dsimp [B]
      unfold unramifiedLevelField
      rw [IntermediateField.adjoin_le_iff]
      intro ζ hζ
      apply IntermediateField.subset_adjoin
      change ζ ^ (m₁.1 * m₂.1) = 1
      change ζ ^ m₂.1 = 1 at hζ
      rw [mul_comm, pow_mul, hζ, one_pow]
  have hE₂_le : unramifiedTotalField F L ≤ ⨆ m : IdxP, B m := by
    unfold unramifiedTotalField
    rw [IntermediateField.adjoin_le_iff]
    rintro ζ ⟨m, hm, hpm, hζm⟩
    let idx : IdxP := ⟨m, hm, hpm⟩
    have hζ_mem : ζ ∈ B idx := IntermediateField.subset_adjoin L _ hζm
    exact (le_iSup B idx) hζ_mem
  exact h_gen L (AlgebraicClosure F) (lubinTateLevelField F L ϖ) B
    (lubinTateTotalField F L ϖ) (unramifiedTotalField F L)
    hdir_LT hdir_unram hE₁_le hE₂_le (fun n m => hlevels n m.1 m.2.1 m.2.2)

theorem exists_algEquiv_eq_on_of_linearDisjoint (F : Type u) [Field F]
    (L : IntermediateField F (AlgebraicClosure F))
    (E₁ E₂ : IntermediateField L (AlgebraicClosure F))
    (hdisj : E₁.LinearDisjoint E₂) (τ : AbsGal F) (hτL : τ ∈ L.fixingSubgroup) :
    ∃ σ : AbsGal F,
      σ ∈ L.fixingSubgroup ∧ (∀ x ∈ E₁, σ x = x) ∧ (∀ y ∈ E₂, σ y = τ y) :=
by
  have h_gen : ∀ (K E : Type u) [Field K] [Field E] [Algebra K E] [Normal K E]
      (A B : IntermediateField K E) (hAB : A.LinearDisjoint B) (τK : E ≃ₐ[K] E),
      ∃ σK : E ≃ₐ[K] E, (∀ x ∈ A, σK x = x) ∧ (∀ y ∈ B, σK y = τK y) := by
    intro K E _ _ _ _ A B hAB τK
    have hsub : A.toSubalgebra.LinearDisjoint B.toSubalgebra :=
      IntermediateField.linearDisjoint_iff'.mp hAB
    have hsup : (A ⊔ B).toSubalgebra = A.toSubalgebra ⊔ B.toSubalgebra :=
      IntermediateField.sup_toSubalgebra_of_isAlgebraic_right A B
    let μ : TensorProduct K A.toSubalgebra B.toSubalgebra ≃ₐ[K] (A ⊔ B).toSubalgebra :=
      hsub.mulMap.trans (Subalgebra.equivOfEq _ _ hsup.symm)
    let ψ : TensorProduct K A.toSubalgebra B.toSubalgebra →ₐ[K] E :=
      Algebra.TensorProduct.productMap A.toSubalgebra.val (τK.toAlgHom.comp B.toSubalgebra.val)
    let ϕ : ↥(A ⊔ B) →ₐ[K] E := ψ.comp μ.symm.toAlgHom
    let σK_hom : E →ₐ[K] E := ϕ.liftNormal E
    let σK : E ≃ₐ[K] E :=
      AlgEquiv.ofBijective σK_hom (Algebra.IsAlgebraic.algHom_bijective σK_hom)
    refine ⟨σK, ?_, ?_⟩
    · intro x hx
      have hx_sup : x ∈ A ⊔ B := (le_sup_left : A ≤ A ⊔ B) hx
      have hμ : μ (TensorProduct.tmul K (⟨x, hx⟩ : A.toSubalgebra) (1 : B.toSubalgebra)) =
          (⟨x, hx_sup⟩ : (A ⊔ B).toSubalgebra) := by
        apply Subtype.ext
        change (hsub.mulMap (TensorProduct.tmul K (⟨x, hx⟩ : A.toSubalgebra) 1) : E) = x
        rw [Subalgebra.LinearDisjoint.val_mulMap_tmul]
        exact mul_one x
      have hμ_symm : μ.symm (⟨x, hx_sup⟩ : (A ⊔ B).toSubalgebra) =
          TensorProduct.tmul K (⟨x, hx⟩ : A.toSubalgebra) (1 : B.toSubalgebra) := by
        rw [← hμ, AlgEquiv.symm_apply_apply]
      have hϕ : ϕ ⟨x, hx_sup⟩ = x := by
        change ψ (μ.symm (⟨x, hx_sup⟩ : (A ⊔ B).toSubalgebra)) = x
        rw [hμ_symm]
        simp [ψ]
        rfl
      have hσ : σK x = ϕ ⟨x, hx_sup⟩ := AlgHom.liftNormal_commutes ϕ E ⟨x, hx_sup⟩
      rw [hσ, hϕ]
    · intro y hy
      have hy_sup : y ∈ A ⊔ B := (le_sup_right : B ≤ A ⊔ B) hy
      have hμ : μ (TensorProduct.tmul K (1 : A.toSubalgebra) (⟨y, hy⟩ : B.toSubalgebra)) =
          (⟨y, hy_sup⟩ : (A ⊔ B).toSubalgebra) := by
        apply Subtype.ext
        change (hsub.mulMap (TensorProduct.tmul K 1 (⟨y, hy⟩ : B.toSubalgebra)) : E) = y
        rw [Subalgebra.LinearDisjoint.val_mulMap_tmul]
        exact one_mul y
      have hμ_symm : μ.symm (⟨y, hy_sup⟩ : (A ⊔ B).toSubalgebra) =
          TensorProduct.tmul K (1 : A.toSubalgebra) (⟨y, hy⟩ : B.toSubalgebra) := by
        rw [← hμ, AlgEquiv.symm_apply_apply]
      have hϕ : ϕ ⟨y, hy_sup⟩ = τK y := by
        change ψ (μ.symm (⟨y, hy_sup⟩ : (A ⊔ B).toSubalgebra)) = τK y
        rw [hμ_symm]
        simp [ψ]
        rfl
      have hσ : σK y = ϕ ⟨y, hy_sup⟩ := AlgHom.liftNormal_commutes ϕ E ⟨y, hy_sup⟩
      rw [hσ, hϕ]
  haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
  let τL : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F := L.fixingSubgroupEquiv ⟨τ, hτL⟩
  obtain ⟨σL, hσ₁, hσ₂⟩ := h_gen L (AlgebraicClosure F) E₁ E₂ hdisj τL
  let σ_sub : L.fixingSubgroup := L.fixingSubgroupEquiv.symm σL
  refine ⟨(σ_sub : AbsGal F), σ_sub.2, hσ₁, hσ₂⟩

theorem exists_isLubinTateFrob_of_frobLift (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (ϖ : Lˣ) (hϖ : valL F L ϖ = 1) (τ : AbsGal F) (hτL : τ ∈ L.fixingSubgroup)
    (hτFrob : ActsAsFrobPow F τ (-(resDeg F L : ℤ))) :
    ∃ σ : AbsGal F, IsLubinTateFrob F L ϖ σ :=
by
  have hlevels : ∀ (n m : ℕ), 0 < m → ¬ p F ∣ m →
      (lubinTateLevelField F L ϖ n).LinearDisjoint (unramifiedLevelField F L m) := by
    intro n m hm hpm
    obtain ⟨hGal, hFinB, hB⟩ := unramifiedLevelField_isGalois_and_resDeg F L m hm hpm
    obtain ⟨hFinA, hA⟩ := lubinTateLevelField_finiteDimensional_and_resDeg_le F L ϖ hϖ n
    haveI : IsGalois L (unramifiedLevelField F L m) := hGal
    haveI : FiniteDimensional L (unramifiedLevelField F L m) := hFinB
    haveI : FiniteDimensional L (lubinTateLevelField F L ϖ n) := hFinA
    have hinf : lubinTateLevelField F L ϖ n ⊓ unramifiedLevelField F L m = ⊥ :=
      inf_eq_bot_of_resDeg_le_and_finrank_mul_resDeg_le F L
        (lubinTateLevelField F L ϖ n) (unramifiedLevelField F L m) hA hB
    have hinf' : unramifiedLevelField F L m ⊓ lubinTateLevelField F L ϖ n = ⊥ := by
      rw [inf_comm, hinf]
    exact (IntermediateField.LinearDisjoint.of_inf_eq_bot hinf').symm
  have hdisj : (lubinTateTotalField F L ϖ).LinearDisjoint (unramifiedTotalField F L) :=
    lubinTateTotalField_linearDisjoint_unramifiedTotalField_of_levels F L ϖ hlevels
  obtain ⟨σ, hσL, hσ₁, hσ₂⟩ :=
    exists_algEquiv_eq_on_of_linearDisjoint F L
      (lubinTateTotalField F L ϖ) (unramifiedTotalField F L) hdisj τ hτL
  refine ⟨σ, hσL, ?_, ?_⟩
  · intro ζ hζ
    have hζ_mem : ζ ∈ unramifiedTotalField F L :=
      IntermediateField.subset_adjoin L {ζ : AlgebraicClosure F | IsPrimeToPRootOfUnity F ζ} hζ
    rw [hσ₂ ζ hζ_mem]
    exact hτFrob ζ hζ
  · intro n α hα
    have hα_mem : α ∈ lubinTateTotalField F L ϖ :=
      IntermediateField.subset_adjoin L
        {α : AlgebraicClosure F | ∃ n : ℕ, isLubinTateRoot F L ϖ n α} ⟨n, hα⟩
    exact hσ₁ α hα_mem

theorem rawRecMap_actsAsFrobPow_and_mem_relWeil (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (x : Lˣ) :
    rawRecMap F L x ∈ relWeil F L ∧ ActsAsFrobPow F (rawRecMap F L x) (-relVal F L x) :=
by
  obtain ⟨hπ₀, hϖ⟩ := valL_chosenUniformizer_and_mul_zpow F L x
  obtain ⟨τ, hτL, hτFrob⟩ := exists_actsAsFrobPow_neg_resDeg F L
  have hex_π₀ : ∃ σ : AbsGal F, IsLubinTateFrob F L (chosenUniformizer F L) σ :=
    exists_isLubinTateFrob_of_frobLift F L (chosenUniformizer F L) hπ₀ τ hτL hτFrob
  have hex_ϖ : ∃ σ : AbsGal F,
      IsLubinTateFrob F L (x * (chosenUniformizer F L) ^ (1 - valL F L x)) σ :=
    exists_isLubinTateFrob_of_frobLift F L
      (x * (chosenUniformizer F L) ^ (1 - valL F L x)) hϖ τ hτL hτFrob
  have hspec_π₀ : IsLubinTateFrob F L (chosenUniformizer F L)
      (lubinTateFrob F L (chosenUniformizer F L)) :=
    Classical.epsilon_spec hex_π₀
  have hspec_ϖ : IsLubinTateFrob F L (x * (chosenUniformizer F L) ^ (1 - valL F L x))
      (lubinTateFrob F L (x * (chosenUniformizer F L) ^ (1 - valL F L x))) :=
    Classical.epsilon_spec hex_ϖ
  obtain ⟨hL_π₀, hfrob_π₀, -⟩ := hspec_π₀
  obtain ⟨hL_ϖ, hfrob_ϖ, -⟩ := hspec_ϖ
  obtain ⟨hmul, hzpow⟩ := actsAsFrobPow_mul_and_zpow F
  have hfrob_pow : ActsAsFrobPow F
      ((lubinTateFrob F L (chosenUniformizer F L)) ^ (valL F L x - 1))
      ((valL F L x - 1) * -(resDeg F L : ℤ)) :=
    hzpow _ (-(resDeg F L : ℤ)) (valL F L x - 1) hfrob_π₀
  have hfrob_raw : ActsAsFrobPow F (rawRecMap F L x) (-relVal F L x) := by
    have h1 : ActsAsFrobPow F (rawRecMap F L x)
        (-(resDeg F L : ℤ) + (valL F L x - 1) * -(resDeg F L : ℤ)) :=
      hmul _ _ _ _ hfrob_ϖ hfrob_pow
    have h2 : -(resDeg F L : ℤ) + (valL F L x - 1) * -(resDeg F L : ℤ) = -relVal F L x := by
      rw [relVal_eq_resDeg_mul_valL F L x]
      ring
    rwa [h2] at h1
  have hmem_weil : rawRecMap F L x ∈ weilGroup F :=
    Subgroup.subset_closure ⟨-relVal F L x, hfrob_raw⟩
  have hmem_fix : rawRecMap F L x ∈ L.fixingSubgroup :=
    L.fixingSubgroup.mul_mem hL_ϖ (L.fixingSubgroup.zpow_mem hL_π₀ (valL F L x - 1))
  exact ⟨Subgroup.mem_inf.mpr ⟨hmem_weil, hmem_fix⟩, hfrob_raw⟩

theorem polyValLe_one_lubinTatePoly_comp_sub_comp (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (ϕ : Polynomial L) (hϕ : polyValLe F L 0 ϕ) :
    polyValLe F L 1
      ((lubinTatePoly F L (chosenUniformizer F L : L)).comp ϕ -
        ϕ.comp (lubinTatePoly F L (chosenUniformizer F L : L))) :=
by
  have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
      0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
    intro a ha
    unfold addVal
    rw [dif_neg ha]
    set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    set va := valuation F a
    have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
    constructor
    · intro h_nonneg
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
      have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
      have h_iso : iso va ≤ iso 1 := by
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
        exact WithZero.coe_le_coe.mpr h_unzero
      exact (map_le_map_iff iso).mp h_iso
    · intro h_le
      have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
      rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
        Multiplicative.toAdd_le.mpr h_iso
      omega
  have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  have addVal_div : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x / y) = addVal F x - addVal F y := by
    intro x y hx hy
    have hxy : x / y ≠ 0 := div_ne_zero hx hy
    have h := addVal_mul hxy hy
    rw [div_mul_cancel₀ _ hy] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Lˣ, Multiplicative.toAdd (relValHom u) = relVal F L u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : Lˣ,
      relVal F L ((u * v : Lˣ) : L) = relVal F L u + relVal F L v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : Lˣ) (k : ℤ),
      relVal F L ((u ^ k : Lˣ) : L) = k * relVal F L u := by
    intro u k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have relVal_mul : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      relVal F L (x * y) = relVal F L x + relVal F L y := by
    intro x y hx hy
    exact relVal_units_mul (Units.mk0 x hx) (Units.mk0 y hy)
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F L ∧ ∃ π : Lˣ, relVal F L π = resDeg F L := by
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L u,
        (map_ne_zero (algebraMap F L)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (u : F)) = (u : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (u : F)
      have hpow : addVal F ((u : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F u := by
        change Multiplicative.toAdd (addValHom (u ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hf_pos, π_ex, hπ_ex⟩ := resDeg_mem
  have relVal_eq_resDeg_mul_valL_aux :
      ∀ u : Lˣ, relVal F L u = (resDeg F L : ℤ) * valL F L u := by
    intro u
    let q := relVal F L u / (resDeg F L : ℤ)
    let r := relVal F L u % (resDeg F L : ℤ)
    have hdiv : r + (resDeg F L : ℤ) * q = relVal F L u := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r := Int.emod_nonneg _ (by positivity)
    have hrlt : r < (resDeg F L : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F L ((u * π_ex ^ (-q) : Lˣ) : L) = r := by
      rw [relVal_units_mul, relVal_units_zpow, hπ_ex]
      linarith
    have hr_eq : r = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k} := by
        refine ⟨hr_pos, ((u * π_ex ^ (-q) : Lˣ) : L), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F L ≤ r.toNat := Nat.sInf_le hmem
      omega
    change relVal F L u = (resDeg F L : ℤ) * q
    linarith
  have relVal_eq : ∀ {x : L} (hx : x ≠ 0), relVal F L x = (resDeg F L : ℤ) * valL F L x :=
