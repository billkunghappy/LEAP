        obtain ⟨v₂, hv₂, y₂, hy₂, hy₁y₂⟩ := hstep y₁ hy₁
        refine ⟨v₁ + (πF ^ k) • v₂, V.add_mem hv₁ (V.smul_mem _ hv₂), y₂, hy₂, ?_⟩
        rw [hxy₁, hy₁y₂, smul_add, add_assoc, smul_smul, ← pow_succ]
    haveI : FiniteDimensional F V := Submodule.finiteDimensional_of_le (le_top : V ≤ ⊤)
    have hV_closed : IsClosed (V : Set E) := Submodule.closed_of_finiteDimensional V
    intro x hx
    change x ∈ (V : Set E)
    rw [← hV_closed.closure_eq, Metric.mem_closure_iff]
    intro ε hε
    obtain ⟨k, hk⟩ := exists_pow_lt_of_lt_one hε hπF_norm_lt
    obtain ⟨v, hv, y, hy, hxy⟩ := h_ind k x hx
    refine ⟨v, hv, ?_⟩
    have hsub : x - v = (πF ^ k) • y := by
      rw [hxy, add_sub_cancel_left]
    rw [dist_eq_norm, hsub, norm_smul, norm_pow]
    have hy_le := h_norm_le_one y hy
    have hpow_nonneg : 0 ≤ ‖πF‖ ^ k := pow_nonneg (norm_nonneg _) k
    calc ‖πF‖ ^ k * ‖y‖ ≤ ‖πF‖ ^ k * 1 := mul_le_mul_of_nonneg_left hy_le hpow_nonneg
      _ = ‖πF‖ ^ k := mul_one _
      _ < ε := hk
  let P1 : ∀ (r : ℕ), (Fin r → E) → Prop :=
    fun r ω => ∀ i : Fin r, IsIntegral 𝒪[F] (ω i)
  let P2 : ∀ (r : ℕ), (Fin r → E) → Prop :=
    fun r ω => ∀ x : E, IsIntegral 𝒪[F] x →
      ∃ a : Fin r → 𝒪[F], IsIntegral 𝒪[F] ((x - ∑ i, algebraMap 𝒪[F] E (a i) * ω i) / πE)
  let P3 : ∀ (r : ℕ), (Fin r → E) → Prop :=
    fun r ω => ∀ a : Fin r → 𝒪[F],
      IsIntegral 𝒪[F] ((∑ i, algebraMap 𝒪[F] E (a i) * ω i) / πE) →
      ∀ i : Fin r, IsLocalRing.residue 𝒪[F] (a i) = 0
  have h_le_finrank : ∀ (r : ℕ) (ω : Fin r → E), P3 r ω → r ≤ Module.finrank F E := by
    intro r ω hP3
    have hli : LinearIndependent F ω := by
      rw [Fintype.linearIndependent_iff]
      intro c hc_sum
      by_contra h_not_all
      push_neg at h_not_all
      obtain ⟨i₁, hi₁⟩ := h_not_all
      let S_idx : Finset (Fin r) := Finset.univ.filter (fun i => c i ≠ 0)
      have hS_ne : S_idx.Nonempty := ⟨i₁, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi₁⟩⟩
      obtain ⟨i₀, hi₀S, hi₀_min⟩ := Finset.exists_min_image S_idx (fun i => addVal F (c i)) hS_ne
      have hci₀ : c i₀ ≠ 0 := (Finset.mem_filter.mp hi₀S).2
      have h_val_div : ∀ i : Fin r, valuation F (c i / c i₀) ≤ 1 := by
        intro i
        by_cases hci : c i = 0
        · rw [hci, zero_div, map_zero]
          exact zero_le_one
        · apply (addVal_nonneg_iff_val_le_one (div_ne_zero hci hci₀)).mp
          rw [addVal_div hci hci₀]
          have hiS : i ∈ S_idx := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hci⟩
          have hle := hi₀_min i hiS
          omega
      let a : Fin r → 𝒪[F] := fun i => ⟨c i / c i₀, h_val_div i⟩
      have h_sum_zero : ∑ i : Fin r, algebraMap 𝒪[F] E (a i) * ω i = 0 := by
        have h_eq : ∀ i : Fin r, algebraMap 𝒪[F] E (a i) * ω i =
            (algebraMap F E (c i₀))⁻¹ * (c i • ω i) := by
          intro i
          change algebraMap F E (c i / c i₀) * ω i = _
          rw [Algebra.smul_def, map_div₀, div_eq_inv_mul, mul_assoc]
        simp_rw [h_eq, ← Finset.mul_sum, hc_sum, mul_zero]
      have h_div_int : IsIntegral 𝒪[F] ((∑ i : Fin r, algebraMap 𝒪[F] E (a i) * ω i) / πE) := by
        rw [h_sum_zero, zero_div]
        exact isIntegral_zero
      have h_res_i₀ := hP3 a h_div_int i₀
      have ha_i₀ : a i₀ = 1 := Subtype.ext (div_self hci₀)
      rw [ha_i₀, map_one] at h_res_i₀
      exact one_ne_zero h_res_i₀
    have hcard := hli.fintype_card_le_finrank
    rwa [Fintype.card_fin] at hcard
  have h_step : ∀ (r : ℕ) (ω : Fin r → E), P1 r ω → P3 r ω → ¬ P2 r ω →
      ∃ ω' : Fin (r + 1) → E, P1 (r + 1) ω' ∧ P3 (r + 1) ω' := by
    intro r ω hP1 hP3 hnotP2
    unfold P2 at hnotP2
    push_neg at hnotP2
    obtain ⟨x₀, hx₀_int, hx₀_not⟩ := hnotP2
    let ω' : Fin (r + 1) → E := @Fin.lastCases r (fun _ => E) x₀ ω
    refine ⟨ω', ?_, ?_⟩
    · intro j
      refine Fin.lastCases ?_ ?_ j
      · change IsIntegral 𝒪[F] (@Fin.lastCases r (fun _ => E) x₀ ω (Fin.last r))
        rw [Fin.lastCases_last]
        exact hx₀_int
      · intro i
        change IsIntegral 𝒪[F] (@Fin.lastCases r (fun _ => E) x₀ ω i.castSucc)
        rw [Fin.lastCases_castSucc]
        exact hP1 i
    · intro a ha_int
      have h_sum_split : ∑ j : Fin (r + 1), algebraMap 𝒪[F] E (a j) * ω' j =
          (∑ i : Fin r, algebraMap 𝒪[F] E (a i.castSucc) * ω i) +
            algebraMap 𝒪[F] E (a (Fin.last r)) * x₀ := by
        rw [Fin.sum_univ_castSucc]
        congr 1
        · refine Finset.sum_congr rfl fun i _ => ?_
          change _ * @Fin.lastCases r (fun _ => E) x₀ ω i.castSucc = _
          rw [Fin.lastCases_castSucc]
        · change _ * @Fin.lastCases r (fun _ => E) x₀ ω (Fin.last r) = _
          rw [Fin.lastCases_last]
      have h_last : IsLocalRing.residue 𝒪[F] (a (Fin.last r)) = 0 := by
        by_contra h_ne
        have h_unit : IsUnit (a (Fin.last r)) :=
          (IsLocalRing.residue_ne_zero_iff_isUnit (a (Fin.last r))).mp h_ne
        obtain ⟨u, hu⟩ := h_unit
        let u_inv : 𝒪[F] := ↑(u⁻¹)
        have hu_mul : u_inv * a (Fin.last r) = 1 := by
          rw [← hu]
          exact Units.inv_mul u
        have h_u_inv_int : IsIntegral 𝒪[F] (algebraMap 𝒪[F] E u_inv) := isIntegral_algebraMap
        have h_mul_int := IsIntegral.mul h_u_inv_int ha_int
        let b : Fin r → 𝒪[F] := fun i => -(u_inv * a i.castSucc)
        have h_alg : algebraMap 𝒪[F] E u_inv *
            ((∑ j : Fin (r + 1), algebraMap 𝒪[F] E (a j) * ω' j) / πE) =
            (x₀ - ∑ i : Fin r, algebraMap 𝒪[F] E (b i) * ω i) / πE := by
          rw [h_sum_split, ← mul_div_assoc]
          congr 1
          have h1 : algebraMap 𝒪[F] E u_inv * (algebraMap 𝒪[F] E (a (Fin.last r)) * x₀) = x₀ := by
            rw [← mul_assoc, ← map_mul, hu_mul, map_one, one_mul]
          have h2 : algebraMap 𝒪[F] E u_inv *
              (∑ i : Fin r, algebraMap 𝒪[F] E (a i.castSucc) * ω i) =
              -(∑ i : Fin r, algebraMap 𝒪[F] E (b i) * ω i) := by
            rw [Finset.mul_sum, ← Finset.sum_neg_distrib]
            refine Finset.sum_congr rfl fun i _ => ?_
            simp only [b, map_neg, map_mul, neg_mul, neg_neg, mul_assoc]
          rw [mul_add, h1, h2]
          ring
        rw [h_alg] at h_mul_int
        exact hx₀_not b h_mul_int
      have h_last_div_int : IsIntegral 𝒪[F] ((algebraMap 𝒪[F] E (a (Fin.last r)) * x₀) / πE) := by
        rw [mul_div_right_comm]
        exact IsIntegral.mul (h_res_zero_div_int (a (Fin.last r)) h_last) hx₀_int
      have h_init_int : IsIntegral 𝒪[F]
          ((∑ i : Fin r, algebraMap 𝒪[F] E (a i.castSucc) * ω i) / πE) := by
        have h_sub := IsIntegral.sub ha_int h_last_div_int
        have h_eq : ((∑ j : Fin (r + 1), algebraMap 𝒪[F] E (a j) * ω' j) / πE) -
            ((algebraMap 𝒪[F] E (a (Fin.last r)) * x₀) / πE) =
            (∑ i : Fin r, algebraMap 𝒪[F] E (a i.castSucc) * ω i) / πE := by
          rw [h_sum_split, add_div, add_sub_cancel_right]
        rwa [h_eq] at h_sub
      have h_init := hP3 (fun i => a i.castSucc) h_init_int
      intro j
      refine Fin.lastCases h_last (fun i => h_init i) j
  have h_basis_ind : ∀ (k : ℕ) (r : ℕ), Module.finrank F E - r ≤ k →
      ∀ (ω : Fin r → E), P1 r ω → P3 r ω →
      ∃ (f₀ : ℕ) (ω₀ : Fin f₀ → E), P1 f₀ ω₀ ∧ P2 f₀ ω₀ ∧ P3 f₀ ω₀ := by
    intro k
    induction k with
    | zero =>
      intro r hr ω hP1 hP3
      by_cases hP2 : P2 r ω
      · exact ⟨r, ω, hP1, hP2, hP3⟩
      · obtain ⟨ω', hP1', hP3'⟩ := h_step r ω hP1 hP3 hP2
        have hle := h_le_finrank (r + 1) ω' hP3'
        omega
    | succ k ih =>
      intro r hr ω hP1 hP3
      by_cases hP2 : P2 r ω
      · exact ⟨r, ω, hP1, hP2, hP3⟩
      · obtain ⟨ω', hP1', hP3'⟩ := h_step r ω hP1 hP3 hP2
        have hle := h_le_finrank (r + 1) ω' hP3'
        exact ih (r + 1) (by omega) ω' hP1' hP3'
  obtain ⟨f₀, ω, hω_int, hω_span, hω_ind⟩ :=
    h_basis_ind (Module.finrank F E) 0 (by omega) Fin.elim0
      (fun i => Fin.elim0 i) (fun _ _ i => Fin.elim0 i)
  obtain ⟨uF, huF⟩ := exists_addVal_eq_one
  set πF : F := (uF : F)
  have hπF0 : πF ≠ 0 := uF.ne_zero
  have hπF_E0 : algebraMap F E πF ≠ 0 := (map_ne_zero (algebraMap F E)).mpr hπF0
  have h_finrank_rel : (Module.finrank F E : ℤ) =
      (resDeg F E : ℤ) * valL F E (algebraMap F E πF) := by
    have h1 := relVal_algebraMap hπF0
    rw [huF, mul_one, relVal_eq hπF_E0] at h1
    exact h1.symm
  have h_finrank_pos : 0 < Module.finrank F E := Module.finrank_pos
  have h_valL_πF_pos : 0 < valL F E (algebraMap F E πF) := by
    by_contra hle
    have hle0 : valL F E (algebraMap F E πF) ≤ 0 := by omega
    have hnp : (resDeg F E : ℤ) * valL F E (algebraMap F E πF) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos (by omega) hle0
    omega
  let e : ℕ := (valL F E (algebraMap F E πF)).toNat
  have he_eq : (e : ℤ) = valL F E (algebraMap F E πF) :=
    Int.toNat_of_nonneg (by omega)
  have he_pos : 0 < e := by omega
  have h_finrank_eq : Module.finrank F E = resDeg F E * e := by
    have h : (Module.finrank F E : ℤ) = (resDeg F E * e : ℕ) := by
      push_cast
      rw [he_eq]
      exact h_finrank_rel
    exact Nat.cast_injective h
  have valL_algebraMap : ∀ {c : F} (hc : c ≠ 0),
      valL F E (algebraMap F E c) = (e : ℤ) * addVal F c := by
    intro c hc
    have hcE0 : algebraMap F E c ≠ 0 := (map_ne_zero (algebraMap F E)).mpr hc
    have h1 := relVal_algebraMap hc
    rw [relVal_eq hcE0, h_finrank_rel, ← he_eq, mul_assoc] at h1
    exact mul_left_cancel₀ (by positivity) h1
  have h_comb : ∀ (c : Fin f₀ → F), (∃ i, c i ≠ 0) →
      (∑ i, c i • ω i ≠ 0) ∧ ∃ m : ℤ, valL F E (∑ i, c i • ω i) = (e : ℤ) * m := by
    intro c ⟨i₁, hi₁⟩
    let S_idx : Finset (Fin f₀) := Finset.univ.filter (fun i => c i ≠ 0)
    have hS_ne : S_idx.Nonempty := ⟨i₁, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi₁⟩⟩
    obtain ⟨i₀, hi₀S, hi₀_min⟩ := Finset.exists_min_image S_idx (fun i => addVal F (c i)) hS_ne
    have hci₀ : c i₀ ≠ 0 := (Finset.mem_filter.mp hi₀S).2
    have h_val_div : ∀ i : Fin f₀, valuation F (c i / c i₀) ≤ 1 := by
      intro i
      by_cases hci : c i = 0
      · rw [hci, zero_div, map_zero]
        exact zero_le_one
      · apply (addVal_nonneg_iff_val_le_one (div_ne_zero hci hci₀)).mp
        rw [addVal_div hci hci₀]
        have hiS : i ∈ S_idx := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hci⟩
        have hle := hi₀_min i hiS
        omega
    let a : Fin f₀ → 𝒪[F] := fun i => ⟨c i / c i₀, h_val_div i⟩
    set s₀ : E := ∑ i : Fin f₀, algebraMap 𝒪[F] E (a i) * ω i
    have hs_eq : ∑ i : Fin f₀, c i • ω i = algebraMap F E (c i₀) * s₀ := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      change c i • ω i = algebraMap F E (c i₀) * (algebraMap F E (c i / c i₀) * ω i)
      rw [Algebra.smul_def, ← mul_assoc, ← map_mul, mul_div_cancel₀ _ hci₀]
    have ha_i₀ : a i₀ = 1 := Subtype.ext (div_self hci₀)
    have h_not_div : ¬ IsIntegral 𝒪[F] (s₀ / πE) := by
      intro hdiv
      have hres := hω_ind a hdiv i₀
      rw [ha_i₀, map_one] at hres
      exact one_ne_zero hres
    have hs₀_ne : s₀ ≠ 0 := by
      intro h0
      apply h_not_div
      rw [h0, zero_div]
      exact isIntegral_zero
    have hs_ne : ∑ i : Fin f₀, c i • ω i ≠ 0 := by
      rw [hs_eq]
      exact mul_ne_zero ((map_ne_zero (algebraMap F E)).mpr hci₀) hs₀_ne
    have hs₀_int : IsIntegral 𝒪[F] s₀ :=
      (integralClosure 𝒪[F] E).sum_mem fun i _ =>
        (integralClosure 𝒪[F] E).mul_mem isIntegral_algebraMap (hω_int i)
    have hs₀_val_nonneg : 0 ≤ valL F E s₀ := (h_int_valL hs₀_ne).mp hs₀_int
    have hs₀_val_lt : valL F E s₀ < 1 := by
      by_contra hge
      apply h_not_div
      rw [h_int_valL (div_ne_zero hs₀_ne hπE_ne), valL_div hs₀_ne hπE_ne, hπ_val]
      omega
    have hs₀_val_zero : valL F E s₀ = 0 := by omega
    refine ⟨hs_ne, addVal F (c i₀), ?_⟩
    rw [hs_eq, valL_mul ((map_ne_zero (algebraMap F E)).mpr hci₀) hs₀_ne,
      valL_algebraMap hci₀, hs₀_val_zero, add_zero]
  let B : Fin f₀ × Fin e → E := fun p => ω p.1 * πE ^ (p.2 : ℕ)
  have hB_li : LinearIndependent F B := by
    rw [Fintype.linearIndependent_iff]
    intro c hc_sum
    let s : Fin e → E := fun j => ∑ i : Fin f₀, c (i, j) • ω i
    have h_sum_s : ∑ j : Fin e, s j * πE ^ (j : ℕ) = 0 := by
      rw [← hc_sum, Fintype.sum_prod_type_right]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [s, B, Finset.sum_mul, smul_mul_assoc]
    have hs_all_zero : ∀ j : Fin e, s j = 0 := by
      by_contra h_not
      push_neg at h_not
      obtain ⟨j₁, hj₁⟩ := h_not
      let T : Finset (Fin e) := Finset.univ.filter (fun j => s j ≠ 0)
      have hT_ne : T.Nonempty := ⟨j₁, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj₁⟩⟩
      let t : Fin e → E := fun j => s j * πE ^ (j : ℕ)
      have ht_ne : ∀ j ∈ T, t j ≠ 0 := by
        intro j hjT
        exact mul_ne_zero (Finset.mem_filter.mp hjT).2 (pow_ne_zero _ hπE_ne)
      have ht_mod : ∀ j ∈ T, valL F E (t j) % (e : ℤ) = (j : ℤ) := by
        intro j hjT
        have hsj : s j ≠ 0 := (Finset.mem_filter.mp hjT).2
        have hex : ∃ i, c (i, j) ≠ 0 := by
          by_contra h_all0
          push_neg at h_all0
          apply hsj
          simp [s, h_all0]
        obtain ⟨-, m, hm⟩ := h_comb (fun i => c (i, j)) hex
        have h_val_t : valL F E (t j) = (j : ℤ) + (e : ℤ) * m := by
          change valL F E (s j * πE ^ (j : ℕ)) = _
          rw [valL_mul hsj (pow_ne_zero _ hπE_ne), hm, valL_pow hπE_ne, hπ_val, mul_one, add_comm]
        rw [h_val_t, Int.add_mul_emod_self_left, Int.emod_eq_of_lt (by positivity) (by omega)]
      obtain ⟨j₀, hj₀T, hj₀_min⟩ := Finset.exists_min_image T (fun j => valL F E (t j)) hT_ne
      have h_strict : ∀ j ∈ T.erase j₀, valL F E (t j₀) + 1 ≤ valL F E (t j) := by
        intro j hj
        have hj_ne : j ≠ j₀ := (Finset.mem_erase.mp hj).1
        have hjT : j ∈ T := (Finset.mem_erase.mp hj).2
        have hle := hj₀_min j hjT
        have hne_val : valL F E (t j) ≠ valL F E (t j₀) := by
          intro heq
          have hmod : valL F E (t j) % (e : ℤ) = valL F E (t j₀) % (e : ℤ) :=
            congrArg (fun z => z % (e : ℤ)) heq
