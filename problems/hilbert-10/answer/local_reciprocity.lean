    · have h_zero : ∑ i : Fin q, Polynomial.X ^ (m / q) * (C₀ ^ (m % q)) i i = 0 := by
        refine Finset.sum_eq_zero fun i _ => ?_
        rw [hC₀_pow (m % q) (by omega) i i]
        by_cases hlt : (i : ℕ) + m % q < q
        · rw [if_pos hlt, if_neg (by omega), mul_zero]
        · rw [if_neg hlt, if_neg (by omega), mul_zero]
      rw [h_zero]
      exact polyDivPi_zero
  
  
  
  
  let relPolyCoeffPow : Polynomial E₀ → Polynomial E₀ := fun P =>
    ∑ i ∈ P.support, Polynomial.monomial i ((P.coeff i) ^ q)
  have h_coeffPow_coeff : ∀ (P : Polynomial E₀) (k : ℕ),
      (relPolyCoeffPow P).coeff k = (P.coeff k) ^ q := by
    intro P k
    dsimp [relPolyCoeffPow]
    rw [Polynomial.finset_sum_coeff]
    simp only [Polynomial.coeff_monomial]
    by_cases hk : k ∈ P.support
    · rw [Finset.sum_eq_single k (fun b _ hbk => if_neg hbk) (fun h => absurd hk h), if_pos rfl]
    · rw [Finset.sum_eq_zero (fun b hb => if_neg (by rintro rfl; exact hk hb)),
        Polynomial.notMem_support_iff.mp hk, zero_pow (by omega)]
  have polyInt_coeffPow : ∀ {P : Polynomial E₀}, polyInt P → polyInt (relPolyCoeffPow P) := by
    intro P hP k
    rw [h_coeffPow_coeff]
    exact IsIntegral.pow (hP k) q
  have h_comp_X_pow_coeff : ∀ (R : Polynomial E₀) (k : ℕ),
      (R.comp (Polynomial.X ^ q)).coeff (k * q) = R.coeff k := by
    intro R k
    rw [Polynomial.comp_eq_sum_left, Polynomial.sum_def, Polynomial.finset_sum_coeff]
    have h_term : ∀ e : ℕ,
        (Polynomial.C (R.coeff e) * (Polynomial.X ^ q) ^ e).coeff (k * q) =
          if k = e then R.coeff e else 0 := by
      intro e
      rw [← pow_mul, mul_comm q e, Polynomial.C_mul_X_pow_eq_monomial,
        Polynomial.coeff_monomial]
      have h_eq : (e * q = k * q) ↔ k = e := by
        constructor
        · intro h
          nlinarith
        · rintro rfl
          rfl
      simp [h_eq]
    rw [Finset.sum_congr rfl fun e _ => h_term e]
    by_cases hk : k ∈ R.support
    · rw [Finset.sum_eq_single k (fun b _ hbk => if_neg (Ne.symm hbk)) (fun h => absurd hk h),
        if_pos rfl]
    · rw [Finset.sum_eq_zero (fun b hb => if_neg (by rintro rfl; exact hk hb)),
        Polynomial.notMem_support_iff.mp hk]
  have h_pow_qL_sub_comp : ∀ {P : Polynomial E₀}, polyInt P →
      polyDivPi (P ^ q - (relPolyCoeffPow P).comp (Polynomial.X ^ q)) := by
    intro P hP
    let P_pref : ℕ → Polynomial E₀ := fun N =>
      ∑ i ∈ Finset.range N, Polynomial.monomial i (P.coeff i)
    let Q_pref : ℕ → Polynomial E₀ := fun N =>
      ∑ i ∈ Finset.range N, Polynomial.monomial i ((P.coeff i) ^ q)
    have h_ind : ∀ N : ℕ, polyInt (P_pref N) ∧
        polyDivPi ((P_pref N) ^ q - (Q_pref N).comp (Polynomial.X ^ q)) := by
      intro N
      induction N with
      | zero =>
        refine ⟨polyInt_zero, ?_⟩
        dsimp [P_pref, Q_pref]
        rw [zero_pow (by omega), Polynomial.zero_comp, sub_self]
        exact polyDivPi_zero
      | succ N ih =>
        set M := Polynomial.monomial N (P.coeff N)
        set M_q := Polynomial.monomial N ((P.coeff N) ^ q)
        have hM_int : polyInt M := polyInt_monomial N (hP N)
        have h_P_succ : P_pref (N + 1) = P_pref N + M := Finset.sum_range_succ _ N
        have h_Q_succ : Q_pref (N + 1) = Q_pref N + M_q := Finset.sum_range_succ _ N
        rw [h_P_succ, h_Q_succ]
        refine ⟨polyInt_add ih.1 hM_int, ?_⟩
        let S_rem := ∑ k ∈ Finset.Ioo 0 ((p F) ^ e_p),
          (P_pref N) ^ k * M ^ ((p F) ^ e_p - k) * ↑(((p F) ^ e_p).choose k / p F)
        have h_binom : (P_pref N + M) ^ q =
            (P_pref N) ^ q + M ^ q + Polynomial.C (p F : E₀) * S_rem := by
          dsimp [S_rem]
          rw [hq_eq_p_pow, add_pow_prime_pow_eq' hp_prime (P_pref N) M e_p,
            Polynomial.C_eq_natCast]
        have hM_eq : M ^ q = M_q.comp (Polynomial.X ^ q) := by
          dsimp [M, M_q]
          rw [Polynomial.monomial_pow, Polynomial.monomial_comp, ← pow_mul, mul_comm q N,
            Polynomial.C_mul_X_pow_eq_monomial]
        have h_id : (P_pref N + M) ^ q - (Q_pref N + M_q).comp (Polynomial.X ^ q) =
            ((P_pref N) ^ q - (Q_pref N).comp (Polynomial.X ^ q)) +
            Polynomial.C (p F : E₀) * S_rem := by
          rw [h_binom, Polynomial.add_comp, hM_eq]
          ring
        rw [h_id]
        have hS_int : polyInt S_rem :=
          polyInt_sum _ _ fun k _ =>
            polyInt_mul (polyInt_mul (polyInt_pow ih.1 k) (polyInt_pow hM_int _))
              (polyInt_natCast _)
        exact polyDivPi_add ih.2 (polyDivPi_C_mul h_p_div_pi hS_int)
    have hP_eq : P_pref (P.natDegree + 1) = P := (Polynomial.as_sum_range P).symm
    have hQ_eq : Q_pref (P.natDegree + 1) = relPolyCoeffPow P := by
      ext k
      rw [h_coeffPow_coeff, Polynomial.finset_sum_coeff]
      simp only [Polynomial.coeff_monomial]
      by_cases hk : k < P.natDegree + 1
      · rw [Finset.sum_eq_single k (fun b _ hbk => if_neg hbk)
          (fun h => absurd (Finset.mem_range.mpr hk) h), if_pos rfl]
      · rw [Finset.sum_eq_zero (fun b hb => if_neg (by
            have := Finset.mem_range.mp hb
            omega)),
          Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), zero_pow (by omega)]
    have h_res := (h_ind (P.natDegree + 1)).2
    rwa [hP_eq, hQ_eq] at h_res
  have h_polyDivPi_of_pow_qL_sub : ∀ {P Q : Polynomial E₀},
      polyInt P → polyInt Q → polyDivPi (P ^ q - Q ^ q) → polyDivPi (P - Q) := by
    intro P Q hP hQ hPQ_pow
    let D := P - Q
    have hD_int : polyInt D := polyInt_sub hP hQ
    have hP_decomp : P = Q + D := (add_sub_cancel Q P).symm
    let S_rem := ∑ k ∈ Finset.Ioo 0 ((p F) ^ e_p),
      Q ^ k * D ^ ((p F) ^ e_p - k) * ↑(((p F) ^ e_p).choose k / p F)
    have h_binom : P ^ q = Q ^ q + D ^ q + Polynomial.C (p F : E₀) * S_rem := by
      dsimp [S_rem]
      rw [hP_decomp, hq_eq_p_pow, add_pow_prime_pow_eq' hp_prime Q D e_p,
        Polynomial.C_eq_natCast]
    have hS_int : polyInt S_rem :=
      polyInt_sum _ _ fun k _ =>
        polyInt_mul (polyInt_mul (polyInt_pow hQ k) (polyInt_pow hD_int _))
          (polyInt_natCast _)
    have hDq_eq : D ^ q = (P ^ q - Q ^ q) - Polynomial.C (p F : E₀) * S_rem := by
      rw [h_binom]
      ring
    have hDq_div : polyDivPi (D ^ q) := by
      rw [hDq_eq]
      exact polyDivPi_sub hPQ_pow (polyDivPi_C_mul h_p_div_pi hS_int)
    have h_comp_div : polyDivPi ((relPolyCoeffPow D).comp (Polynomial.X ^ q)) := by
      have h_sub := polyDivPi_sub hDq_div (h_pow_qL_sub_comp hD_int)
      rwa [sub_sub_cancel] at h_sub
    intro k
    have hk_div := h_comp_div (k * q)
    rw [h_comp_X_pow_coeff, h_coeffPow_coeff] at hk_div
    rw [div_pi_int_iff] at hk_div ⊢
    by_cases hd0 : D.coeff k = 0
    · exact Or.inl hd0
    · right
      have hdq_ne : (D.coeff k) ^ q ≠ 0 := pow_ne_zero q hd0
      have hdq_val : 1 ≤ valL F E₀ ((D.coeff k) ^ q) := hk_div.resolve_left hdq_ne
      rw [valL_pow_elem hd0 q] at hdq_val
      have hd_nonneg : 0 ≤ valL F E₀ (D.coeff k) :=
        ((mem_int_iff (D.coeff k)).mp (hD_int k)).resolve_left hd0
      nlinarith
  
  
  
  let φ : E₀ →ₐ[F] E₀ := {
    toFun := fun x => ⟨τ (x : AlgebraicClosure F), hτE₀ (x : AlgebraicClosure F) x.2⟩
    map_one' := Subtype.ext (map_one τ)
    map_mul' := fun x y => Subtype.ext (map_mul τ (x : AlgebraicClosure F) (y : AlgebraicClosure F))
    map_zero' := Subtype.ext (map_zero τ)
    map_add' := fun x y => Subtype.ext (map_add τ (x : AlgebraicClosure F) (y : AlgebraicClosure F))
    commutes' := fun r => Subtype.ext (AlgEquiv.commutes τ r)
  }
  have hφ_inj : Function.Injective φ := φ.injective
  have hφ_surj : Function.Surjective φ :=
    (LinearMap.injective_iff_surjective (f := φ.toLinearMap)).mp hφ_inj
  let e_τ : E₀ ≃ₐ[F] E₀ := AlgEquiv.ofBijective φ ⟨hφ_inj, hφ_surj⟩
  have he_τ_coe : ∀ x : E₀, ((e_τ x : E₀) : AlgebraicClosure F) = τ (x : AlgebraicClosure F) :=
    fun _ => rfl
  have h_relCoeff_one : ∀ x : E₀, relLubinTateCoeff F E₀ τ x 1 = e_τ x := by
    intro x
    apply Subtype.ext
    have hmem : (τ ^ 1) (x : AlgebraicClosure F) ∈ E₀ := by
      rw [pow_one]
      exact hτE₀ (x : AlgebraicClosure F) x.2
    rw [relLubinTateCoeff, dif_pos hmem]
    change (τ ^ 1) (x : AlgebraicClosure F) = ((e_τ x : E₀) : AlgebraicClosure F)
    rw [pow_one, he_τ_coe]
  have h_relPolyFrob_coeff : ∀ (P : Polynomial E₀) (k : ℕ),
      (relPolyFrob F E₀ τ P).coeff k = e_τ (P.coeff k) := by
    intro P k
    rw [relPolyFrob, Polynomial.finset_sum_coeff]
    simp only [Polynomial.coeff_monomial]
    by_cases hk : k ∈ P.support
    · rw [Finset.sum_eq_single k (fun b _ hbk => if_neg hbk) (fun h => absurd hk h),
        if_pos rfl, h_relCoeff_one]
    · rw [Finset.sum_eq_zero (fun b hb => if_neg (by rintro rfl; exact hk hb)),
        Polynomial.notMem_support_iff.mp hk, map_zero]
  have h_valL_eτ : ∀ x : E₀, valL F E₀ (e_τ x) = valL F E₀ x := by
    intro x
    change addVal F (Algebra.norm F (e_τ x)) / (resDeg F E₀ : ℤ) =
      addVal F (Algebra.norm F x) / (resDeg F E₀ : ℤ)
    rw [Algebra.norm_eq_of_algEquiv e_τ x]
  have h_div_pi_eτ : ∀ {x : E₀}, IsIntegral 𝒪[F] (x / π) → IsIntegral 𝒪[F] (e_τ x / π) := by
    intro x hx
    rw [div_pi_int_iff] at hx ⊢
    rcases hx with rfl | hle
    · left
      exact map_zero e_τ
    · right
      rwa [h_valL_eτ]
  have h_eτ_teich : ∀ z : E₀, z ^ (q_E₀ - 1) = 1 → e_τ z = z ^ q := by
    intro z hz
    have h_root : IsPrimeToPRootOfUnity F (z : AlgebraicClosure F) := by
      refine ⟨q_E₀ - 1, by omega, hp_not_dvd_qE₀_sub_one, ?_⟩
      exact_mod_cast hz
    apply Subtype.ext
    rw [he_τ_coe, hτFrob (z : AlgebraicClosure F) h_root]
    rfl
  have hA_int : polyInt A := (polyValLe_zero_iff A).mp hA
  have h_frob_congr : polyDivPi (relPolyCoeffPow A - relPolyFrob F E₀ τ A) := by
    intro k
    rw [Polynomial.coeff_sub, h_coeffPow_coeff, h_relPolyFrob_coeff]
    set c := A.coeff k
    have hc_int : IsIntegral 𝒪[F] c := hA_int k
    by_cases hc_div : IsIntegral 𝒪[F] (c / π)
    · have hcq_div : IsIntegral 𝒪[F] (c ^ q / π) := by
        have hcq : c ^ q / π = (c / π) * c ^ (q - 1) := by
          conv_lhs => rw [← Nat.sub_add_cancel hq1, pow_succ', mul_div_right_comm]
        rw [hcq]
        exact IsIntegral.mul hc_div (IsIntegral.pow hc_int (q - 1))
      rw [sub_div]
      exact IsIntegral.sub hcq_div (h_div_pi_eτ hc_div)
    · have hc_not_one : ¬ (c = 0 ∨ 1 ≤ valL F E₀ c) := mt (div_pi_int_iff c).mpr hc_div
      push_neg at hc_not_one
      obtain ⟨hc_ne, hc_lt1⟩ := hc_not_one
      have hc_nonneg : 0 ≤ valL F E₀ c := ((mem_int_iff c).mp hc_int).resolve_left hc_ne
      have hc_val : valL F E₀ c = 0 := by omega
      obtain ⟨ζ, u₁, hζ_pow, hu₁_congr, huc_eq⟩ :=
        exists_pow_qL_sub_one_eq_one_and_valL_sub_one_of_valL_eq_zero F E₀ (Units.mk0 c hc_ne) hc_val
      let z : E₀ := (ζ : E₀)
      have hz_ne : z ≠ 0 := ζ.ne_zero
      have hz_val : valL F E₀ z = 0 := by
        have h1 : valL F E₀ (z ^ (q_E₀ - 1)) = 0 := by rw [hζ_pow, valL_one]
        rw [valL_pow_elem hz_ne (q_E₀ - 1)] at h1
        have hqE₀_pos : (0 : ℤ) < ((q_E₀ - 1 : ℕ) : ℤ) := by omega
        nlinarith
      have hz_int : IsIntegral 𝒪[F] z := (mem_int_iff z).mpr (Or.inr (by omega))
      have hu₁_sub_div : IsIntegral 𝒪[F] (((u₁ : E₀) - 1) / π) := by
        rw [div_pi_int_iff]
        exact hu₁_congr.imp sub_eq_zero.mpr id
      have hc_eq_zu₁ : c = z * (u₁ : E₀) := congr_arg Units.val huc_eq
      have hcz_div : IsIntegral 𝒪[F] ((c - z) / π) := by
        have h_eq : (c - z) / π = z * (((u₁ : E₀) - 1) / π) := by
          rw [hc_eq_zu₁]
          ring
        rw [h_eq]
        exact IsIntegral.mul hz_int hu₁_sub_div
      have heτ_cz_div : IsIntegral 𝒪[F] ((e_τ c - z ^ q) / π) := by
        have h_eq : e_τ c - z ^ q = e_τ (c - z) := by
          rw [map_sub, h_eτ_teich z hζ_pow]
        rw [h_eq]
        exact h_div_pi_eτ hcz_div
      have hcq_zq_div : IsIntegral 𝒪[F] ((c ^ q - z ^ q) / π) := by
        have h_geom : (c ^ q - z ^ q) / π =
            (∑ i ∈ Finset.range q, c ^ i * z ^ (q - 1 - i)) * ((c - z) / π) := by
          rw [← geom_sum₂_mul c z q, mul_div_assoc]
        rw [h_geom]
        refine IsIntegral.mul ?_ hcz_div
        exact isIntegral_sum _ _ fun i _ =>
          IsIntegral.mul (IsIntegral.pow hc_int i) (IsIntegral.pow hz_int _)
      have h_diff : (c ^ q - e_τ c) / π = (c ^ q - z ^ q) / π - (e_τ c - z ^ q) / π := by ring
      rw [h_diff]
      exact IsIntegral.sub hcq_zq_div heτ_cz_div
  
  
  
  let matInt (X : Matrix (Fin q) (Fin q) (Polynomial E₀)) : Prop :=
    ∀ j i : Fin q, polyInt (X j i)
  let matDivPi (X : Matrix (Fin q) (Fin q) (Polynomial E₀)) : Prop :=
    ∀ j i : Fin q, polyDivPi (X j i)
  have matInt_one : matInt 1 := by
    intro j i
    rw [Matrix.one_apply]
    split_ifs <;> [exact polyInt_one; exact polyInt_zero]
