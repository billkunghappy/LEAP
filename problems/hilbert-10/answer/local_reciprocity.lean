    have h_as_sum : P_pref (ψ.natDegree + 1) = ψ := (Polynomial.as_sum_range ψ).symm
    have h_res := (h_ind (ψ.natDegree + 1)).2
    rwa [h_as_sum] at h_res
  have h_semi_div_pi : ∀ {ψ : Polynomial (AlgebraicClosure F)}, polyMem Sunram ψ →
      polyDivMem Sunram πbar
        (((ψ.map (τ : AlgebraicClosure F →+* AlgebraicClosure F)).comp f₀_poly) -
          fπ.comp ψ) := by
    intro ψ hψ
    set τψ := ψ.map (τ : AlgebraicClosure F →+* AlgebraicClosure F)
    have hτψ : polyMem Sunram τψ := polyMem_map_τ hψ
