    have hs_eq : ∑ i : Fin f₀, c i • ω i = algebraMap F L (c i₀) * s₀ := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      change c i • ω i = algebraMap F L (c i₀) * (algebraMap F L (c i / c i₀) * ω i)
      rw [Algebra.smul_def, ← mul_assoc, ← map_mul, mul_div_cancel₀ _ hci₀]
