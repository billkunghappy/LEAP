      _ < ε := hk
  let P1 : ∀ (r : ℕ), (Fin r → L) → Prop :=
    fun r ω => ∀ i : Fin r, IsIntegral 𝒪[F] (ω i)
  let P2 : ∀ (r : ℕ), (Fin r → L) → Prop :=
    fun r ω => ∀ x : L, IsIntegral 𝒪[F] x →
      ∃ a : Fin r → 𝒪[F], IsIntegral 𝒪[F] ((x - ∑ i, algebraMap 𝒪[F] L (a i) * ω i) / πL)
  let P3 : ∀ (r : ℕ), (Fin r → L) → Prop :=
    fun r ω => ∀ a : Fin r → 𝒪[F],
      IsIntegral 𝒪[F] ((∑ i, algebraMap 𝒪[F] L (a i) * ω i) / πL) →
      ∀ i : Fin r, IsLocalRing.residue 𝒪[F] (a i) = 0
  have h_le_finrank : ∀ (r : ℕ) (ω : Fin r → L), P3 r ω → r ≤ Module.finrank F L := by
    intro r ω hP3
    have hli : LinearIndependent F ω := by
      rw [Fintype.linearIndependent_iff]
      intro c hc_sum
      by_contra h_not_all
      push_neg at h_not_all
      obtain ⟨i₁, hi₁⟩ := h_not_all
      let S : Finset (Fin r) := Finset.univ.filter (fun i => c i ≠ 0)
      have hS_ne : S.Nonempty := ⟨i₁, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi₁⟩⟩
      obtain ⟨i₀, hi₀S, hi₀_min⟩ := Finset.exists_min_image S (fun i => addVal F (c i)) hS_ne
      have hci₀ : c i₀ ≠ 0 := (Finset.mem_filter.mp hi₀S).2
      have h_val_div : ∀ i : Fin r, valuation F (c i / c i₀) ≤ 1 := by
        intro i
        by_cases hci : c i = 0
        · rw [hci, zero_div, map_zero]
          exact zero_le_one
        · apply (addVal_nonneg_iff_val_le_one (div_ne_zero hci hci₀)).mp
          rw [addVal_div hci hci₀]
          have hiS : i ∈ S := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hci⟩
          have hle := hi₀_min i hiS
          omega
      let a : Fin r → 𝒪[F] := fun i => ⟨c i / c i₀, h_val_div i⟩
      have h_sum_zero : ∑ i : Fin r, algebraMap 𝒪[F] L (a i) * ω i = 0 := by
        have h_eq : ∀ i : Fin r, algebraMap 𝒪[F] L (a i) * ω i =
