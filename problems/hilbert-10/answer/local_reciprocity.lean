        omega
      have h_contra := (h_int_valL (div_ne_zero h_neg1_ne hπL_ne)).mp h_div_sum_int
      rw [valL_div h_neg1_ne hπL_ne, h_neg1_val, hπ_val] at h_contra
      omega
    intro ⟨i, j⟩
    by_contra hcij
    obtain ⟨hne, -⟩ := h_comb (fun i' => c (i', j)) ⟨i, hcij⟩
    exact hne (hs_all_zero j)
  let V : Submodule F L := Submodule.span F (Set.range B)
  have h_m_step : ∀ (m : ℕ), m ≤ e → ∀ x : L, IsIntegral 𝒪[F] x →
      ∃ v ∈ V, ∃ z : L, IsIntegral 𝒪[F] z ∧ x = v + πL ^ m * z := by
    intro m
    induction m with
    | zero =>
      intro _ x hx
      exact ⟨0, V.zero_mem, x, hx, by simp⟩
    | succ m ih =>
      intro hm x hx
      obtain ⟨v₁, hv₁, z₁, hz₁, hxz₁⟩ := ih (by omega) x hx
      obtain ⟨a, ha⟩ := hω_span z₁ hz₁
      set z₂ : L := (z₁ - ∑ i : Fin f₀, algebraMap 𝒪[F] L (a i) * ω i) / πL
      have hz₁_eq : z₁ = (∑ i : Fin f₀, algebraMap 𝒪[F] L (a i) * ω i) + πL * z₂ := by
        rw [mul_div_cancel₀ _ hπL_ne, add_sub_cancel]
