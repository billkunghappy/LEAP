    have h_pb₁_gen : pb₁.gen = α₁ := h_pb₁_gen'
    have h_pb₁_minpoly : pb₁.minpolyGen = D₁ := by
      rw [pb₁.minpolyGen_eq, h_pb₁_gen', IntermediateField.minpoly_gen, ← h_minpoly₁]
    have h_pb₁_dim : pb₁.dim = q - 1 := by
      rw [IntermediateField.adjoin.powerBasis_dim, ← h_minpoly₁, hD₁_deg]
    have h_dim_succ : pb₁.dim + 1 = q := by omega
    let B₀ : Matrix (Fin pb₁.dim) (Fin pb₁.dim) K := (Algebra.leftMulMatrix pb₁.basis) pb₁.gen
    let eval₀ : Polynomial K →+* K := Polynomial.evalRingHom 0
    let C := bareCompanion q ϖ
    let C₀ : Matrix (Fin q) (Fin q) K := eval₀.mapMatrix C
    have h_aeval_C₀ : eval₀.mapMatrix (Polynomial.aeval C A) = Polynomial.aeval C₀ A := by
      let f₁ : Polynomial K →+* Matrix (Fin q) (Fin q) K :=
        eval₀.mapMatrix.comp (Polynomial.aeval C).toRingHom
      let f₂ : Polynomial K →+* Matrix (Fin q) (Fin q) K :=
        (Polynomial.aeval C₀).toRingHom
      have hf : f₁ = f₂ := by
        apply Polynomial.ringHom_ext'
        · refine RingHom.ext fun a => Matrix.ext fun j i => ?_
          change eval₀ ((Polynomial.aeval C (Polynomial.C a)) j i) =
            (Polynomial.aeval C₀ (Polynomial.C a)) j i
          rw [Polynomial.aeval_C, Polynomial.aeval_C]
