    intro m P
    exact ⟨fun hP n => (h_div_iff m (P.coeff n)).mp (hP n),
      fun hP n => (h_div_iff m (P.coeff n)).mpr (hP n)⟩
  have polyDivPow_zero : ∀ m : ℕ, polyDivPow m 0 := by
    intro m n
    rw [Polynomial.coeff_zero, zero_div]
    exact isIntegral_zero
