    have h_ne : g b₁ ≠ g b₂ := sub_ne_zero.mp h_sub_ne
    have h_sub_int : IsIntegral 𝒪[F] (g b₁ - g b₂) :=
      (integralClosure 𝒪[F] L).sub_mem (hg_int b₁) (hg_int b₂)
    have h_val_nonneg : 0 ≤ valL F L (g b₁ - g b₂) := (h_int_valL h_sub_ne).mp h_sub_int
    have h_val_lt : valL F L (g b₁ - g b₂) < 1 := by
      by_contra hge
      apply h_not_div
      rw [h_int_valL (div_ne_zero h_sub_ne hπL_ne), valL_div h_sub_ne hπL_ne, hπ_val]
      omega
    exact ⟨h_ne, by omega⟩
  have hg_inj : Function.Injective g :=
    fun b₁ b₂ h => by_contra fun hb => (hg_diff hb).1 h
  set S₁ : Finset L := Finset.univ.image g
  have hS₁_card : S₁.card = qL F L := by
    rw [Finset.card_image_of_injective _ hg_inj, Finset.card_univ, Fintype.card_fun,
      Fintype.card_fin, hf₀, qL, q, Nat.card_eq_fintype_card]
  let V_val : ℤ → L → Prop := fun m z => z = 0 ∨ m ≤ valL F L z
  have hV_iff : ∀ (m : ℤ) (z : L), V_val m z ↔ IsIntegral 𝒪[F] (z * ((ϖ ^ (-m) : Lˣ) : L)) := by
    intro m z
    by_cases hz0 : z = 0
    · simp [V_val, hz0, isIntegral_zero]
    · have hu_ne : ((ϖ ^ (-m) : Lˣ) : L) ≠ 0 := Units.ne_zero _
      have hmul_ne : z * ((ϖ ^ (-m) : Lˣ) : L) ≠ 0 := mul_ne_zero hz0 hu_ne
      change (z = 0 ∨ m ≤ valL F L z) ↔ IsIntegral 𝒪[F] (z * ((ϖ ^ (-m) : Lˣ) : L))
      rw [or_iff_right hz0, h_int_valL hmul_ne, valL_mul hz0 hu_ne, valL_units_zpow ϖ (-m), hϖ]
      omega
  have hV_add : ∀ {m : ℤ} {x y : L}, V_val m x → V_val m y → V_val m (x + y) := by
    intro m x y hx hy
    rw [hV_iff] at hx hy ⊢
    rw [add_mul]
    exact (integralClosure 𝒪[F] L).add_mem hx hy
  have hV_sub : ∀ {m : ℤ} {x y : L}, V_val m x → V_val m y → V_val m (x - y) := by
    intro m x y hx hy
    rw [hV_iff] at hx hy ⊢
    rw [sub_mul]
    exact (integralClosure 𝒪[F] L).sub_mem hx hy
  have valL_neg : ∀ x : L, valL F L (-x) = valL F L x := by
    intro x
    by_cases hx0 : x = 0
    · rw [hx0, neg_zero]
    · have h_eq : -x = (-1 : L) * x := neg_eq_neg_one_mul x
      rw [h_eq, valL_mul h_neg1_ne hx0, h_neg1_val, zero_add]
  have valL_add_of_lt : ∀ {x y : L}, x ≠ 0 → (y = 0 ∨ valL F L x < valL F L y) →
      x + y ≠ 0 ∧ valL F L (x + y) = valL F L x := by
    intro x y hx hy
    rcases hy with rfl | hy_lt
    · rw [add_zero]
      exact ⟨hx, rfl⟩
    · have hxy_ne : x + y ≠ 0 := by
        intro h0
        have hy_eq : y = -x := eq_neg_of_add_eq_zero_right h0
        rw [hy_eq, valL_neg] at hy_lt
        omega
      set m : ℤ := valL F L x
      have hx_m : V_val m x := Or.inr (le_refl m)
      have hy_m : V_val m y := Or.inr (by omega)
      have hxy_m : V_val m (x + y) := hV_add hx_m hy_m
      have h_ge : m ≤ valL F L (x + y) := by
        rcases hxy_m with h0 | hge
        · exact False.elim (hxy_ne h0)
        · exact hge
      have h_le : valL F L (x + y) ≤ m := by
        by_contra hgt
        have hxy_m1 : V_val (m + 1) (x + y) := Or.inr (by omega)
        have hy_m1 : V_val (m + 1) y := Or.inr (by omega)
        have hx_m1 : V_val (m + 1) ((x + y) - y) := hV_sub hxy_m1 hy_m1
        rw [add_sub_cancel_right] at hx_m1
        rcases hx_m1 with h0 | hge1
        · exact hx h0
        · omega
      exact ⟨hxy_ne, by omega⟩
  have hS₁_int : ∀ s ∈ S₁, V_val 0 s := by
    intro s hs
    obtain ⟨b, -, rfl⟩ := Finset.mem_image.mp hs
    rw [hV_iff 0 (g b), neg_zero, zpow_zero, Units.val_one, mul_one]
    exact hg_int b
  have hS₁_diff : ∀ s₁ ∈ S₁, ∀ s₂ ∈ S₁, s₁ ≠ s₂ → valL F L (s₁ - s₂) = 0 := by
    intro s₁ hs₁ s₂ hs₂ hs_ne
    obtain ⟨b₁, -, rfl⟩ := Finset.mem_image.mp hs₁
    obtain ⟨b₂, -, rfl⟩ := Finset.mem_image.mp hs₂
    have hb_ne : b₁ ≠ b₂ := fun h => hs_ne (congrArg g h)
    exact (hg_diff hb_ne).2
  induction n with
  | zero =>
    refine ⟨{0}, ?_, ?_, ?_⟩
    · rw [Finset.card_singleton, pow_zero]
    · intro a ha
      exact Or.inl (Finset.mem_singleton.mp ha)
    · intro a₁ ha₁ a₂ ha₂ hne
      exfalso
      apply hne
      rw [Finset.mem_singleton.mp ha₁, Finset.mem_singleton.mp ha₂]
  | succ n ih =>
    obtain ⟨Sn, hSn_card, hSn_int, hSn_diff⟩ := ih
    let ψ : L × L → L := fun p => p.1 + p.2 * πL ^ n
    have h_pair : ∀ p₁ ∈ Sn ×ˢ S₁, ∀ p₂ ∈ Sn ×ˢ S₁, p₁ ≠ p₂ →
        ψ p₁ ≠ ψ p₂ ∧ ∃ k : ℕ, k < n + 1 ∧ valL F L (ψ p₁ - ψ p₂) = (k : ℤ) := by
      rintro ⟨a₁, s₁⟩ hp₁ ⟨a₂, s₂⟩ hp₂ hp_ne
      obtain ⟨ha₁, hs₁⟩ := Finset.mem_product.mp hp₁
      obtain ⟨ha₂, hs₂⟩ := Finset.mem_product.mp hp₂
      have h_sub_eq : ψ (a₁, s₁) - ψ (a₂, s₂) = (a₁ - a₂) + (s₁ - s₂) * πL ^ n := by
        dsimp [ψ]
        ring
      by_cases ha_eq : a₁ = a₂
      · have hs_ne : s₁ ≠ s₂ := fun hs_eq => hp_ne (Prod.ext ha_eq hs_eq)
        have hs_sub_ne : s₁ - s₂ ≠ 0 := sub_ne_zero.mpr hs_ne
        have h_pow_ne : πL ^ n ≠ 0 := pow_ne_zero n hπL_ne
        have h_sub_eq' : ψ (a₁, s₁) - ψ (a₂, s₂) = (s₁ - s₂) * πL ^ n := by
          rw [h_sub_eq, ha_eq, sub_self, zero_add]
        have h_psi_sub_ne : ψ (a₁, s₁) - ψ (a₂, s₂) ≠ 0 := by
          rw [h_sub_eq']
          exact mul_ne_zero hs_sub_ne h_pow_ne
        have h_val_eq : valL F L (ψ (a₁, s₁) - ψ (a₂, s₂)) = (n : ℤ) := by
          rw [h_sub_eq', valL_mul hs_sub_ne h_pow_ne, hS₁_diff s₁ hs₁ s₂ hs₂ hs_ne,
            valL_pow hπL_ne n, hπ_val, mul_one, zero_add]
        exact ⟨sub_ne_zero.mp h_psi_sub_ne, ⟨n, by omega, h_val_eq⟩⟩
      · obtain ⟨k, hk_lt, hk_val⟩ := hSn_diff a₁ ha₁ a₂ ha₂ ha_eq
        have ha_sub_ne : a₁ - a₂ ≠ 0 := sub_ne_zero.mpr ha_eq
        have hs_sub_int : V_val 0 (s₁ - s₂) := hV_sub (hS₁_int s₁ hs₁) (hS₁_int s₂ hs₂)
        have hy_cond : (s₁ - s₂) * πL ^ n = 0 ∨
            valL F L (a₁ - a₂) < valL F L ((s₁ - s₂) * πL ^ n) := by
          rcases hs_sub_int with hs0 | hs_ge
          · left
            rw [hs0, zero_mul]
          · by_cases hs0 : s₁ - s₂ = 0
            · left
              rw [hs0, zero_mul]
            · right
              have h_pow_ne : πL ^ n ≠ 0 := pow_ne_zero n hπL_ne
              rw [valL_mul hs0 h_pow_ne, valL_pow hπL_ne n, hπ_val, mul_one, hk_val]
              omega
        obtain ⟨h_add_ne, h_add_val⟩ := valL_add_of_lt ha_sub_ne hy_cond
        rw [← h_sub_eq] at h_add_ne h_add_val
        exact ⟨sub_ne_zero.mp h_add_ne, ⟨k, by omega, h_add_val.trans hk_val⟩⟩
    have h_injOn : Set.InjOn ψ ((Sn ×ˢ S₁ : Finset (L × L)) : Set (L × L)) := by
      intro p₁ hp₁ p₂ hp₂ h_eq
      by_contra hp_ne
      exact (h_pair p₁ hp₁ p₂ hp₂ hp_ne).1 h_eq
    refine ⟨(Sn ×ˢ S₁).image ψ, ?_, ?_, ?_⟩
    · rw [Finset.card_image_of_injOn h_injOn, Finset.card_product, hSn_card, hS₁_card, pow_succ]
    · intro x hx
      obtain ⟨⟨a, s⟩, hp, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨ha, hs⟩ := Finset.mem_product.mp hp
      have ha_int : V_val 0 a := hSn_int a ha
      have hs_int : V_val 0 s := hS₁_int s hs
      have h_mul_int : V_val 0 (s * πL ^ n) := by
        by_cases hs0 : s = 0
        · left
          rw [hs0, zero_mul]
        · right
          have hs_ge : 0 ≤ valL F L s := hs_int.resolve_left hs0
          have h_pow_ne : πL ^ n ≠ 0 := pow_ne_zero n hπL_ne
          rw [valL_mul hs0 h_pow_ne, valL_pow hπL_ne n, hπ_val, mul_one]
          omega
      exact hV_add ha_int h_mul_int
    · intro x₁ hx₁ x₂ hx₂ hx_ne
      obtain ⟨p₁, hp₁, rfl⟩ := Finset.mem_image.mp hx₁
      obtain ⟨p₂, hp₂, rfl⟩ := Finset.mem_image.mp hx₂
      have hp_ne : p₁ ≠ p₂ := fun h => hx_ne (congrArg ψ h)
      exact (h_pair p₁ hp₁ p₂ hp₂ hp_ne).2

theorem exists_valL_cauchy_limit (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] (N : ℕ) (hN : 0 < N) (u : ℕ → L)
    (hu : ∀ m r k : ℕ, m * N ≤ r → u (r + k) - u r = 0 ∨ (m : ℤ) ≤ valL F L (u (r + k) - u r)) :
    ∃ x : L, ∀ m r : ℕ, m * N ≤ r → x - u r = 0 ∨ (m : ℤ) ≤ valL F L (x - u r) :=
by
  have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
      0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
    intro a ha
    unfold addVal
    rw [dif_neg ha]
    set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    set va := valuation F a
    have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
    constructor
    · intro h_nonneg
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
      have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
      have h_iso : iso va ≤ iso 1 := by
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
        exact WithZero.coe_le_coe.mpr h_unzero
      exact (map_le_map_iff iso).mp h_iso
    · intro h_le
      have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
      rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
        Multiplicative.toAdd_le.mpr h_iso
      omega
  have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Lˣ, Multiplicative.toAdd (relValHom u) = relVal F L u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : Lˣ,
      relVal F L ((u * v : Lˣ) : L) = relVal F L u + relVal F L v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : Lˣ) (k : ℤ),
      relVal F L ((u ^ k : Lˣ) : L) = k * relVal F L u := by
    intro u k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have relVal_mul : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      relVal F L (x * y) = relVal F L x + relVal F L y := by
    intro x y hx hy
    exact relVal_units_mul (Units.mk0 x hx) (Units.mk0 y hy)
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F L ∧ ∃ π : Lˣ, relVal F L π = resDeg F L := by
    obtain ⟨u, hu_val⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L u,
        (map_ne_zero (algebraMap F L)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (u : F)) = (u : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (u : F)
      have hpow : addVal F ((u : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F u := by
        change Multiplicative.toAdd (addValHom (u ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu_val, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hf_pos, π_ex, hπ_ex⟩ := resDeg_mem
  have relVal_eq_resDeg_mul_valL_aux :
      ∀ u : Lˣ, relVal F L u = (resDeg F L : ℤ) * valL F L u := by
    intro u
    let q₀ := relVal F L u / (resDeg F L : ℤ)
    let r₀ := relVal F L u % (resDeg F L : ℤ)
    have hdiv : r₀ + (resDeg F L : ℤ) * q₀ = relVal F L u := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r₀ := Int.emod_nonneg _ (by positivity)
    have hrlt : r₀ < (resDeg F L : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F L ((u * π_ex ^ (-q₀) : Lˣ) : L) = r₀ := by
      rw [relVal_units_mul, relVal_units_zpow, hπ_ex]
      linarith
    have hr_eq : r₀ = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r₀.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r₀.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k} := by
        refine ⟨hr_pos, ((u * π_ex ^ (-q₀) : Lˣ) : L), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F L ≤ r₀.toNat := Nat.sInf_le hmem
      omega
    change relVal F L u = (resDeg F L : ℤ) * q₀
    linarith
  have relVal_eq : ∀ {x : L} (hx : x ≠ 0), relVal F L x = (resDeg F L : ℤ) * valL F L x :=
    fun hx => relVal_eq_resDeg_mul_valL_aux (Units.mk0 _ hx)
  set πL : L := (chosenUniformizer F L : L)
  have hπL_ne : πL ≠ 0 := Units.ne_zero (chosenUniformizer F L)
  have hπ_val : valL F L πL = 1 := by
    have hf_ne : (resDeg F L : ℤ) ≠ 0 := by positivity
    have hπ_ex_val : valL F L π_ex = 1 := by
      rw [valL, hπ_ex, Int.ediv_self hf_ne]
    exact Classical.epsilon_spec (p := fun π : Lˣ => valL F L π = 1) ⟨π_ex, hπ_ex_val⟩
  have valL_mul : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      valL F L (x * y) = valL F L x + valL F L y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    have h := relVal_mul hx hy
    rw [relVal_eq hxy, relVal_eq hx, relVal_eq hy, ← mul_add] at h
    exact mul_left_cancel₀ (by positivity) h
  have valL_one : valL F L 1 = 0 := by
    have h1 : (1 : L) ≠ 0 := one_ne_zero
    have h := valL_mul h1 h1
    rw [mul_one] at h
    omega
  have valL_div : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      valL F L (x / y) = valL F L x - valL F L y := by
    intro x y hx hy
    have hxy : x / y ≠ 0 := div_ne_zero hx hy
    have h := valL_mul hxy hy
    rw [div_mul_cancel₀ _ hy] at h
    omega
  have valL_pow : ∀ {x : L} (hx : x ≠ 0) (n : ℕ), valL F L (x ^ n) = (n : ℤ) * valL F L x := by
    intro x hx n
    induction n with
    | zero => simp [valL_one]
    | succ n ih =>
      rw [pow_succ, valL_mul (pow_ne_zero n hx) hx, ih]
      push_cast
      ring
  have h_pow_val : ∀ m : ℕ, valL F L (πL ^ m) = (m : ℤ) := by
    intro m
    rw [valL_pow hπL_ne m, hπ_val, mul_one]
  have h_inv_val : valL F L (πL⁻¹) = -1 := by
    have h := valL_mul hπL_ne (inv_ne_zero hπL_ne)
    rw [mul_inv_cancel₀ hπL_ne, valL_one, hπ_val] at h
    omega
  letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
  haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
  haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
  letI : Valued F (ValueGroupWithZero F) :=
    IsValuativeTopology.instValuedValueGroupWithZeroOfIsUniformAddGroup
  let rlo : RankLeOneStruct F :=
    { emb := (WithZeroMulInt.toNNReal (by norm_num : (2 : NNReal) ≠ 0)).comp
        (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).toMonoidWithZeroHom
      strictMono := (WithZeroMulInt.toNNReal_strictMono (by norm_num : (1 : NNReal) < 2)).comp
        (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).strictMono }
  haveI : (Valued.v (R := F)).RankOne := Valuation.RankOne.ofRankLeOneStruct rlo
  letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
  haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F (ValueGroupWithZero F)
  have h_spec_iff_aux : ∀ (K : Type u) [Field K] [Algebra F K] [FiniteDimensional F K] (x : K),
      spectralNorm F K x ≤ 1 ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x) := by
    intro K _ _ _ x
    letI : NormedField K := spectralNorm.normedField F K
    by_cases hx0 : x = 0
    · constructor
      · intro _
        exact Or.inl hx0
      · intro _
        change ‖x‖ ≤ 1
        rw [hx0, norm_zero]
        exact zero_le_one
    · have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
      have hx_int_F : IsIntegral F x := Algebra.IsIntegral.isIntegral x
      let pb : PowerBasis F (IntermediateField.adjoin F ({x} : Set K)) :=
        IntermediateField.adjoin.powerBasis hx_int_F
      have h_gen_coe : (pb.gen : K) = x := IntermediateField.AdjoinSimple.coe_gen F x
      set dK : ℕ := Module.finrank (IntermediateField.adjoin F ({x} : Set K)) K
      have h_finrank_pos : 0 < dK := Module.finrank_pos
      have h_norm_tower : Algebra.norm F x = (Algebra.norm F pb.gen) ^ dK := by
        have h1 : Algebra.norm F (pb.gen : K) = (Algebra.norm F pb.gen) ^ dK := by
          rw [← Algebra.norm_norm (R := F) (S := IntermediateField.adjoin F ({x} : Set K))
            (A := K) (a := (pb.gen : K)), ← map_pow]
          congr 1
          exact Algebra.norm_algebraMap (L := K) pb.gen
        rwa [h_gen_coe] at h1
      have h_norm_pb : Algebra.norm F pb.gen =
          (-1) ^ pb.dim * (minpoly F pb.gen).coeff 0 :=
        Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb
      have h_minpoly_eq : minpoly F pb.gen = minpoly F x := by
        have h1 : minpoly F pb.gen = minpoly F (pb.gen : K) :=
          (minpoly.algHom_eq
            (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K)))
            (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K))).injective
            pb.gen).symm
        rwa [h_gen_coe] at h1
      have h_norm_coeff_pow : ‖Algebra.norm F x‖ =
          ‖(minpoly F x).coeff 0‖ ^ dK := by
        rw [h_norm_tower, h_norm_pb, h_minpoly_eq, norm_pow, norm_mul, norm_pow,
          norm_neg, norm_one, one_pow, one_mul]
      constructor
      · intro h_spec
        right
        have h_spec_val : spectralValue (minpoly F x) ≤ 1 := h_spec
        have h_coeff0_le : ‖(minpoly F x).coeff 0‖ ≤ 1 :=
          (spectralValue_le_one_iff (minpoly.monic hx_int_F)).mp h_spec_val 0
        have h_norm_le : ‖Algebra.norm F x‖ ≤ 1 := by
          rw [h_norm_coeff_pow]
          exact pow_le_one₀ (norm_nonneg _) h_coeff0_le
        have h_val_le : valuation F (Algebra.norm F x) ≤ 1 :=
          Valued.toNormedField.norm_le_one_iff.mp h_norm_le
        exact (addVal_nonneg_iff_val_le_one hnorm0).mpr h_val_le
      · rintro (h0 | h_rel)
        · exact absurd h0 hx0
        · have h_val_le : valuation F (Algebra.norm F x) ≤ 1 :=
            (addVal_nonneg_iff_val_le_one hnorm0).mp h_rel
          have h_norm_le : ‖Algebra.norm F x‖ ≤ 1 :=
            Valued.toNormedField.norm_le_one_iff.mpr h_val_le
          have h_coeff0_le : ‖(minpoly F x).coeff 0‖ ≤ 1 := by
            rw [h_norm_coeff_pow] at h_norm_le
            exact (pow_le_one_iff_of_nonneg (norm_nonneg _) h_finrank_pos.ne').mp h_norm_le
          rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow F K x]
          exact Real.rpow_le_one (norm_nonneg _) h_coeff0_le (by positivity)
  letI : NormedField L := spectralNorm.normedField F L
  letI : NormedSpace F L := spectralNorm.normedSpace F L
  haveI : CompleteSpace L := FiniteDimensional.complete F L
  have h_norm_le_one_iff : ∀ y : L, ‖y‖ ≤ 1 ↔ y = 0 ∨ 0 ≤ valL F L y := by
    intro y
    change spectralNorm F L y ≤ 1 ↔ y = 0 ∨ 0 ≤ valL F L y
    rw [h_spec_iff_aux L y]
    by_cases hy0 : y = 0
    · simp [hy0]
    · rw [or_iff_right hy0, or_iff_right hy0]
      change 0 ≤ relVal F L y ↔ 0 ≤ valL F L y
      rw [relVal_eq hy0]
      exact ⟨fun h => nonneg_of_mul_nonneg_right h (by positivity),
        fun h => mul_nonneg (by positivity) h⟩
  have hπ_norm_pos : 0 < ‖πL‖ := norm_pos_iff.mpr hπL_ne
  have hπ_norm_lt_one : ‖πL‖ < 1 := by
    have h_not : ¬ (‖πL⁻¹‖ ≤ 1) := by
      rw [h_norm_le_one_iff]
      rintro (h0 | hle)
      · exact inv_ne_zero hπL_ne h0
      · rw [h_inv_val] at hle
        omega
    rw [norm_inv, not_le] at h_not
    exact (one_lt_inv₀ hπ_norm_pos).mp h_not
  have h_val_iff_norm : ∀ (d : L) (m : ℕ),
      (d = 0 ∨ (m : ℤ) ≤ valL F L d) ↔ ‖d‖ ≤ ‖πL‖ ^ m := by
    intro d m
    have hpow_pos : 0 < ‖πL‖ ^ m := pow_pos hπ_norm_pos m
    have hpow_ne : πL ^ m ≠ 0 := pow_ne_zero m hπL_ne
    rw [← div_le_one hpow_pos, ← norm_pow, ← norm_div, h_norm_le_one_iff]
    by_cases hd0 : d = 0
    · simp [hd0]
    · have hdiv_ne : d / πL ^ m ≠ 0 := div_ne_zero hd0 hpow_ne
      rw [or_iff_right hd0, or_iff_right hdiv_ne, valL_div hd0 hpow_ne, h_pow_val m]
      omega
  have hu_norm : ∀ m r k : ℕ, m * N ≤ r → ‖u (r + k) - u r‖ ≤ ‖πL‖ ^ m :=
    fun m r k hmr => (h_val_iff_norm (u (r + k) - u r) m).mp (hu m r k hmr)
  have hu_dist : ∀ m r : ℕ, m * N ≤ r → dist (u r) (u (m * N)) ≤ ‖πL‖ ^ m := by
    intro m r hmr
    have hr_eq : m * N + (r - m * N) = r := Nat.add_sub_of_le hmr
    rw [dist_eq_norm, ← hr_eq]
    exact hu_norm m (m * N) (r - m * N) (le_refl _)
  have h_cauchy : CauchySeq u := by
    rw [Metric.cauchySeq_iff]
    intro ε hε
    obtain ⟨m, hm⟩ := exists_pow_lt_of_lt_one (half_pos hε) hπ_norm_lt_one
    refine ⟨m * N, fun r₁ hr₁ r₂ hr₂ => ?_⟩
    have hd1 : dist (u r₁) (u (m * N)) ≤ ‖πL‖ ^ m := hu_dist m r₁ hr₁
    have hd2 : dist (u r₂) (u (m * N)) ≤ ‖πL‖ ^ m := hu_dist m r₂ hr₂
    calc dist (u r₁) (u r₂)
        ≤ dist (u r₁) (u (m * N)) + dist (u r₂) (u (m * N)) :=
          dist_triangle_right (u r₁) (u r₂) (u (m * N))
      _ ≤ ‖πL‖ ^ m + ‖πL‖ ^ m := add_le_add hd1 hd2
      _ < ε / 2 + ε / 2 := add_lt_add hm hm
      _ = ε := add_halves ε
  obtain ⟨x, hx⟩ := cauchySeq_tendsto_of_complete h_cauchy
  refine ⟨x, fun m r hmr => (h_val_iff_norm (x - u r) m).mpr ?_⟩
  by_contra h_gt
  have hδ : 0 < ‖x - u r‖ - ‖πL‖ ^ m := by linarith
  obtain ⟨K, hK⟩ := Metric.tendsto_atTop.mp hx (‖x - u r‖ - ‖πL‖ ^ m) hδ
  have h_dist_x : dist x (u (r + K)) < ‖x - u r‖ - ‖πL‖ ^ m := by
    rw [dist_comm]
    exact hK (r + K) (Nat.le_add_left K r)
  have h_dist_u : dist (u (r + K)) (u r) ≤ ‖πL‖ ^ m := by
    rw [dist_eq_norm]
    exact hu_norm m r K hmr
  have h_tri : ‖x - u r‖ ≤ dist x (u (r + K)) + dist (u (r + K)) (u r) := by
    rw [← dist_eq_norm]
    exact dist_triangle x (u (r + K)) (u r)
  linarith

theorem lubinTateIterPoly_comp_lubinTateEndoPoly_modByMonic_eq_zero (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (ϖ : Lˣ)
    (hϖ : valL F L ϖ = 1) (n : ℕ) (a : L) (ha : a = 0 ∨ 0 ≤ valL F L a) :
    ((lubinTateIterPoly F L (ϖ : L) n).comp (lubinTateEndoPoly F L (ϖ : L) a n)) %ₘ
      (lubinTateIterPoly F L (ϖ : L) n) = 0 :=
by
  set πL : L := (ϖ : L)
  have hπL_ne : πL ≠ 0 := Units.ne_zero ϖ
  have hπ_val : valL F L πL = 1 := hϖ
  let π₀_u : Lˣ := chosenUniformizer F L
  let π₀ : L := (π₀_u : L)
  have hπ₀_ne : π₀ ≠ 0 := π₀_u.ne_zero
  have h_valL_pi0 : valL F L π₀ = 1 := (valL_chosenUniformizer_and_mul_zpow F L 1).1
  have h_relVal_eq : ∀ x : Lˣ, relVal F L x = (resDeg F L : ℤ) * valL F L x :=
    relVal_eq_resDeg_mul_valL F L
  have h_int_iff : ∀ z : L, IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ relVal F L z :=
    isIntegral_iff_eq_zero_or_relVal_nonneg F L
  have h_fermat_pi0 := isIntegral_pow_qL_sub_and_p_div_chosenUniformizer F L
  have h_cauchy_limit := exists_valL_cauchy_limit F L
  have hf_ne : (resDeg F L : ℤ) ≠ 0 := by
    intro h0
    have h1 : valL F L πL = 1 := hϖ
    rw [valL, h0, Int.ediv_zero] at h1
    omega
  have hres_ne : resDeg F L ≠ 0 := by omega
  have hf_pos : 0 < resDeg F L := by omega
  have hf_pos_int : 0 < (resDeg F L : ℤ) := by omega
  have hq : 1 < q F := by
    unfold q
    exact Finite.one_lt_card
  have hqL : 1 < qL F L := Nat.one_lt_pow hres_ne hq
  have addVal_mul : ∀ {x y : F}, x ≠ 0 → y ≠ 0 → addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Lˣ, Multiplicative.toAdd (relValHom u) = relVal F L u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : Lˣ,
      relVal F L ((u * v : Lˣ) : L) = relVal F L u + relVal F L v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : Lˣ) (k : ℤ),
      relVal F L ((u ^ k : Lˣ) : L) = k * relVal F L u := by
    intro u k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have valL_units_mul : ∀ u v : Lˣ,
      valL F L ((u * v : Lˣ) : L) = valL F L u + valL F L v := by
    intro u v
    have hrel := h_relVal_eq (u * v)
    rw [relVal_units_mul, h_relVal_eq u, h_relVal_eq v] at hrel
    apply mul_left_cancel₀ hf_ne
    linarith
  have valL_units_zpow : ∀ (u : Lˣ) (k : ℤ),
      valL F L ((u ^ k : Lˣ) : L) = k * valL F L u := by
    intro u k
    have hrel := h_relVal_eq (u ^ k)
    rw [relVal_units_zpow, h_relVal_eq u] at hrel
    apply mul_left_cancel₀ hf_ne
    linarith
  have valL_div : ∀ {x y : L}, x ≠ 0 → y ≠ 0 → valL F L (x / y) = valL F L x - valL F L y := by
    intro x y hx hy
    let ux : Lˣ := Units.mk0 x hx
    let uy : Lˣ := Units.mk0 y hy
    have hxy : x / y = ((ux * uy ^ (-1 : ℤ) : Lˣ) : L) := by
      simp [ux, uy, div_eq_mul_inv]
    rw [hxy, valL_units_mul, valL_units_zpow]
    change valL F L x + (-1 : ℤ) * valL F L y = valL F L x - valL F L y
    ring
  have h_pow_val : ∀ m : ℕ, valL F L (πL ^ m) = (m : ℤ) := by
    intro m
    have hpow : πL ^ m = ((ϖ ^ (m : ℤ) : Lˣ) : L) := by simp [πL]
    rw [hpow, valL_units_zpow, hϖ, mul_one]
  have valL_one : valL F L 1 = 0 := by simpa using h_pow_val 0
  have mem_int_iff : ∀ z : L, IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ valL F L z := by
    intro z
    rw [h_int_iff z]
    rcases eq_or_ne z 0 with rfl | hz
    · simp
    · have hrel := h_relVal_eq (Units.mk0 z hz)
      change relVal F L z = (resDeg F L : ℤ) * valL F L z at hrel
      rw [or_iff_right hz, or_iff_right hz, hrel, mul_nonneg_iff_of_pos_left hf_pos_int]
  have h_ratio_int : IsIntegral 𝒪[F] (π₀ / πL) := by
    rw [mem_int_iff]
    right
    rw [valL_div hπ₀_ne hπL_ne, h_valL_pi0, hϖ, sub_self]
  have h_transfer_div : ∀ x : L, IsIntegral 𝒪[F] (x / π₀) → IsIntegral 𝒪[F] (x / πL) := by
    intro x hx
    have h_eq : x / πL = (x / π₀) * (π₀ / πL) := by
      rw [div_mul_div_cancel₀ hπ₀_ne]
    rw [h_eq]
    exact IsIntegral.mul hx h_ratio_int
  have h_fermat_and_p :
      (∀ c : L, IsIntegral 𝒪[F] c → IsIntegral 𝒪[F] ((c ^ qL F L - c) / πL)) ∧
      IsIntegral 𝒪[F] ((p F : L) / πL) :=
    ⟨fun c hc => h_transfer_div _ (h_fermat_pi0.1 c hc), h_transfer_div _ h_fermat_pi0.2⟩
  have hπ_pow_sub_ne : ∀ m : ℕ, 1 ≤ m → πL ^ (m + 1) - πL ≠ 0 := by
    intro m hm h0
    have heq : πL ^ (m + 1) = πL := sub_eq_zero.mp h0
    have hval := congrArg (valL F L) heq
    rw [h_pow_val (m + 1), hπ_val] at hval
    omega
  have ha_mem : IsIntegral 𝒪[F] a := (mem_int_iff a).mpr ha
  have h_trunc_step : ∀ r : ℕ,
      polyValLe F L 0 (lubinTateEndoTrunc F L πL a r) ∧
      ∃ d : L, IsIntegral 𝒪[F] d ∧
        lubinTateEndoTrunc F L πL a (r + 1) =
          lubinTateEndoTrunc F L πL a r + Polynomial.monomial (r + 1) d := by
    let f : Polynomial L := lubinTatePoly F L πL
    have isIntegral_sum : ∀ {ι : Type} (s : Finset ι) (g : ι → L),
        (∀ i ∈ s, IsIntegral 𝒪[F] (g i)) → IsIntegral 𝒪[F] (∑ i ∈ s, g i) := by
      intro ι s g hg
      induction s using Finset.cons_induction with
      | empty => exact isIntegral_zero
      | cons x s hx ih =>
        rw [Finset.sum_cons]
        exact IsIntegral.add (hg x (Finset.mem_cons_self x s))
          (ih fun i hi => hg i (Finset.mem_cons.mpr (Or.inr hi)))
    have hπ_mem : IsIntegral 𝒪[F] πL := (mem_int_iff πL).mpr (Or.inr (by omega))
    have h_inv_pi_not_mem : ¬ IsIntegral 𝒪[F] (1 / πL) := by
      rw [mem_int_iff]
      rintro (h0 | hle)
      · exact one_div_ne_zero hπL_ne h0
      · rw [valL_div one_ne_zero hπL_ne, valL_one, hπ_val] at hle
        omega
    have h_div_unit_mem : ∀ (k : ℕ) {y : L},
        IsIntegral 𝒪[F] y → IsIntegral 𝒪[F] (y / (πL ^ (k + 1) - 1)) := by
      intro k y hy
      set u := πL ^ (k + 1) - 1
      have hu_mem : IsIntegral 𝒪[F] u :=
        IsIntegral.sub (IsIntegral.pow hπ_mem (k + 1)) isIntegral_one
      have hu_div_not_mem : ¬ IsIntegral 𝒪[F] (u / πL) := by
        intro hmem
        apply h_inv_pi_not_mem
        have h_id : 1 / πL = πL ^ k - u / πL := by
          dsimp [u]
          rw [sub_div, pow_succ', mul_div_cancel_left₀ _ hπL_ne, sub_sub_cancel]
        rw [h_id]
        exact IsIntegral.sub (IsIntegral.pow hπ_mem k) hmem
      have hu_ne : u ≠ 0 := by
        intro h0
        apply hu_div_not_mem
        rw [h0, zero_div]
        exact isIntegral_zero
      have hu_val_nonneg : 0 ≤ valL F L u := ((mem_int_iff u).mp hu_mem).resolve_left hu_ne
      have hu_val_lt : valL F L u < 1 := by
        by_contra hge
        apply hu_div_not_mem
        rw [mem_int_iff]
        right
        rw [valL_div hu_ne hπL_ne, hπ_val]
        omega
      have hu_val : valL F L u = 0 := by omega
      rw [mem_int_iff]
      rcases eq_or_ne y 0 with rfl | hy0
      · left
        exact zero_div u
      · right
        have hy_val : 0 ≤ valL F L y := ((mem_int_iff y).mp hy).resolve_left hy0
        rw [valL_div hy0 hu_ne, hu_val, sub_zero]
        exact hy_val
    let polyInt : Polynomial L → Prop := fun P => ∀ k : ℕ, IsIntegral 𝒪[F] (P.coeff k)
    have polyValLe_iff_polyInt : ∀ P : Polynomial L, polyValLe F L 0 P ↔ polyInt P := by
      intro P
      refine ⟨fun h k => (mem_int_iff (P.coeff k)).mpr (h k),
        fun h k => (mem_int_iff (P.coeff k)).mp (h k)⟩
    have polyInt_zero : polyInt 0 := fun k => by
      rw [Polynomial.coeff_zero]
      exact isIntegral_zero
    have polyInt_one : polyInt 1 := fun k => by
      rw [Polynomial.coeff_one]
      split_ifs <;> [exact isIntegral_one; exact isIntegral_zero]
    have polyInt_X : polyInt Polynomial.X := fun k => by
      rw [Polynomial.coeff_X]
      split_ifs <;> [exact isIntegral_one; exact isIntegral_zero]
    have polyInt_C : ∀ {c : L}, IsIntegral 𝒪[F] c → polyInt (Polynomial.C c) := fun {c} hc k => by
      rw [Polynomial.coeff_C]
      split_ifs <;> [exact hc; exact isIntegral_zero]
    have isIntegral_natCast : ∀ m : ℕ, IsIntegral 𝒪[F] (m : L) := by
      intro m
      induction m with
      | zero =>
        rw [Nat.cast_zero]
        exact isIntegral_zero
      | succ m ih =>
        rw [Nat.cast_succ]
        exact IsIntegral.add ih isIntegral_one
    have polyInt_natCast : ∀ m : ℕ, polyInt (m : Polynomial L) := by
      intro m
      rw [← Polynomial.C_eq_natCast]
      exact polyInt_C (isIntegral_natCast m)
    have polyInt_monomial : ∀ (j : ℕ) {c : L},
        IsIntegral 𝒪[F] c → polyInt (Polynomial.monomial j c) :=
      fun j {c} hc k => by
        rw [Polynomial.coeff_monomial]
        split_ifs <;> [exact hc; exact isIntegral_zero]
    have polyInt_add : ∀ {P Q : Polynomial L}, polyInt P → polyInt Q → polyInt (P + Q) :=
      fun {P Q} hP hQ k => by
        rw [Polynomial.coeff_add]
        exact IsIntegral.add (hP k) (hQ k)
    have polyInt_mul : ∀ {P Q : Polynomial L}, polyInt P → polyInt Q → polyInt (P * Q) :=
      fun {P Q} hP hQ k => by
        rw [Polynomial.coeff_mul]
        exact isIntegral_sum _ _ fun x _ => IsIntegral.mul (hP x.1) (hQ x.2)
    have polyInt_pow : ∀ {P : Polynomial L}, polyInt P → ∀ e : ℕ, polyInt (P ^ e) := by
      intro P hP e
      induction e with
      | zero => exact polyInt_one
      | succ e ih =>
        rw [pow_succ]
        exact polyInt_mul ih hP
    have polyInt_sum : ∀ {ι : Type} (s : Finset ι) (g : ι → Polynomial L),
        (∀ i ∈ s, polyInt (g i)) → polyInt (∑ i ∈ s, g i) := by
      intro ι s g hg k
      rw [Polynomial.finset_sum_coeff]
      exact isIntegral_sum s (fun i => (g i).coeff k) (fun i hi => hg i hi k)
    have polyInt_f : polyInt f :=
      polyInt_add (polyInt_mul (polyInt_C hπ_mem) polyInt_X) (polyInt_pow polyInt_X (qL F L))
    let polyDivPi : Polynomial L → Prop := fun P => ∀ k : ℕ, IsIntegral 𝒪[F] (P.coeff k / πL)
    have polyDivPi_zero : polyDivPi 0 := fun k => by
      rw [Polynomial.coeff_zero, zero_div]
      exact isIntegral_zero
    have polyDivPi_add : ∀ {P Q : Polynomial L}, polyDivPi P → polyDivPi Q → polyDivPi (P + Q) :=
      fun {P Q} hP hQ k => by
        rw [Polynomial.coeff_add, add_div]
        exact IsIntegral.add (hP k) (hQ k)
    have polyDivPi_sub : ∀ {P Q : Polynomial L}, polyDivPi P → polyDivPi Q → polyDivPi (P - Q) :=
      fun {P Q} hP hQ k => by
        rw [Polynomial.coeff_sub, sub_div]
        exact IsIntegral.sub (hP k) (hQ k)
    have polyDivPi_C_mul : ∀ {c : L} {Q : Polynomial L}, IsIntegral 𝒪[F] (c / πL) → polyInt Q →
        polyDivPi (Polynomial.C c * Q) := by
      intro c Q hc hQ k
      rw [Polynomial.coeff_C_mul, mul_div_right_comm]
      exact IsIntegral.mul hc (hQ k)
    have polyDivPi_mul_right : ∀ {P Q : Polynomial L}, polyDivPi P → polyInt Q →
        polyDivPi (P * Q) := by
      intro P Q hP hQ k
