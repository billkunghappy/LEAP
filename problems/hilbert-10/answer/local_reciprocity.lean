        have hj_eq : valL F M (galApply F hLM (τ ^ ((p F) ^ j)) π_M - π_M) -
            valL F M (galApply F hLM (τ ^ ((p F) ^ (j - 1))) π_M - π_M) = I j - I (j - 1) := by
          dsimp [I]; ring
        rwa [← hj_eq]
