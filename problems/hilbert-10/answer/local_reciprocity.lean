    · intro k
      rw [Polynomial.coeff_map]
      have hk_int : IsIntegral 𝒪[F] (algebraMap 𝒪[F] L (g₀.coeff k)) := isIntegral_algebraMap
      rcases (h_int_iff L (algebraMap 𝒪[F] L (g₀.coeff k))).mp hk_int with hk0 | hk_rel
      · exact Or.inl hk0
      · exact Or.inr (Int.ediv_nonneg hk_rel (Nat.cast_nonneg (resDeg F L)))
  · have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      simp only [addVal, ha, hb, hab, ↓reduceDIte]
      rw [← neg_add, neg_inj, ← toAdd_mul]
      congr 1
      rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
        WithZero.coe_unzero, ← map_mul, ← map_mul]
    have addVal_one : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have h := addVal_mul h1 h1
      rw [mul_one] at h
      omega
    have relVal_one : ∀ (E : IntermediateField F (AlgebraicClosure F)), relVal F E (1 : E) = 0 := by
      intro E
      unfold relVal
      rw [map_one, addVal_one]
    have relVal_mul : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
        {x y : E}, x ≠ 0 → y ≠ 0 → relVal F E (x * y) = relVal F E x + relVal F E y := by
      intro E _ x y hx hy
      have hx_norm : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hy_norm : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, addVal_mul hx_norm hy_norm]
    have exists_mem_isIntegral_of_prod_isIntegral :
        ∀ (t : Multiset (AlgebraicClosure F)),
          t ≠ 0 → IsIntegral 𝒪[F] t.prod → ∃ y ∈ t, IsIntegral 𝒪[F] y := by
      intro t ht_ne ht_int
      by_contra h_none
      push_neg at h_none
      let S : Set (AlgebraicClosure F) := (t.toFinset : Set (AlgebraicClosure F))
      let E : IntermediateField F (AlgebraicClosure F) := IntermediateField.adjoin F S
      haveI : Finite S := (Finset.finite_toSet t.toFinset).to_subtype
      haveI : FiniteDimensional F E :=
        IntermediateField.finiteDimensional_adjoin (fun y _ => Algebra.IsIntegral.isIntegral y)
      haveI : IsScalarTower 𝒪[F] E (AlgebraicClosure F) :=
        IsScalarTower.of_algebraMap_eq (fun _ => rfl)
