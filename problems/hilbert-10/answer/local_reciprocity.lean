          ∀ k : ℕ, 1 ≤ k → k < n → p ^ (d + 1 + k) ∣ (f (p * p ^ k) - f (p * p ^ (k - 1))) := by
        intro k hk1 hkn
        have h_eq1 : p * p ^ (k - 1) = p ^ k := by
          rw [← pow_succ', Nat.sub_add_cancel hk1]
        have h_eq2 : p * p ^ k = p ^ (k + 1) := (pow_succ' p k).symm
        have h_exp : d + 1 + k = d + (k + 1) := by omega
