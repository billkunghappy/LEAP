        intro k
        induction k with
        | zero =>
          intro x hx
          exact ⟨0, V.zero_mem, x, hx, by simp⟩
        | succ k ih =>
          intro x hx
          obtain ⟨v₁, hv₁, y₁, hy₁, hxy₁⟩ := ih x hx
          obtain ⟨v₂, hv₂, y₂, hy₂, hy₁y₂⟩ := hstep y₁ hy₁
          refine ⟨v₁ + (πF ^ k) • v₂, V.add_mem hv₁ (V.smul_mem _ hv₂), y₂, hy₂, ?_⟩
          rw [hxy₁, hy₁y₂, smul_add, add_assoc, smul_smul, ← pow_succ]
      haveI : FiniteDimensional F V := Submodule.finiteDimensional_of_le (le_top : V ≤ ⊤)
      have hV_closed : IsClosed (V : Set L) := Submodule.closed_of_finiteDimensional V
      intro x hx
