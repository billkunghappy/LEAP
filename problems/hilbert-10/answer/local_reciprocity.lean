        rw [h_sum]
        have hp0 : p ^ (1 - 1) = 1 := rfl
        rw [hp0, pow_one]
        have h_sub_mul : (p - 1) * f 1 = p * f 1 - 1 * f 1 := Nat.mul_sub_right_distrib p 1 (f 1)
        have h_le : 1 * f 1 ≤ p * f 1 := Nat.mul_le_mul_right (f 1) (by omega)
