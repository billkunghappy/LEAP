        rw [hh_eq]; exact hghat_diff.1
      have hh_val_eq : valL F M (galApply F hLM τ h - h) = I n₀ := by
        rw [hh_eq]; exact hghat_diff.2
      obtain ⟨h_nonhit_I, h_distinct_I⟩ := h_uniq n₀ I h_dvd_prev
      set K : ℕ := (I (n₀ + 1)).toNat
