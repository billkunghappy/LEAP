    have h_int₁ : IsIntegral K π₁ := ⟨D₁, hD₁_monic, hπ₁⟩
    let K₁ := IntermediateField.adjoin K ({π₁} : Set Ω)
    let α₁ : K₁ := ⟨π₁, IntermediateField.mem_adjoin_simple_self K π₁⟩
    let pb₁ : PowerBasis K K₁ := IntermediateField.adjoin.powerBasis h_int₁
    have h_minpoly₁ : D₁ = minpoly K π₁ :=
      minpoly.eq_of_irreducible_of_monic hD₁_irr hπ₁ hD₁_monic
    have h_pb₁_gen' : pb₁.gen = IntermediateField.AdjoinSimple.gen K π₁ :=
