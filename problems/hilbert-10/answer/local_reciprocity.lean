    (h_int_valL hπL_ne).mpr (by rw [hπ_val]; omega)
  let π₀ : integralClosure 𝒪[F] L := ⟨πL, hπL_int⟩
  have mem_I_iff : ∀ x : integralClosure 𝒪[F] L,
