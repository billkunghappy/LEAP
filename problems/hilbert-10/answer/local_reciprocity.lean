    have h_pb_minpoly : pb.minpolyGen = P := by
      rw [pb.minpolyGen_eq, h_pb_gen', IntermediateField.minpoly_gen, ← h_minpoly_eq]
    let ψ : Polynomial K →+* L_base := (Polynomial.aeval β_L).toRingHom
    let C := bareCompanion q ϖ
