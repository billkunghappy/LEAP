    intro n
    rw [pow_zero, div_one, Polynomial.coeff_one]
    split_ifs
    · exact isIntegral_one
    · exact isIntegral_zero
  have polyDivPow_add : ∀ {m : ℕ} {P Q : Polynomial E₀},
