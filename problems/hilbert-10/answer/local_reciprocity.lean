      have hp_lt : relVal F E p < 0 := hp_lt_imp ht_ne
      have hp_int_bar : IsIntegral 𝒪[F] (IsScalarTower.toAlgHom 𝒪[F] E (AlgebraicClosure F) p) := by
        change IsIntegral 𝒪[F] (p : AlgebraicClosure F)
