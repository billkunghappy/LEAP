        rw [map_one, ← WithZero.coe_unzero hvd_ne, ← WithZero.coe_one, WithZero.coe_lt_coe] at h_iso_lt
        have h_toAdd_neg : Multiplicative.toAdd (WithZero.unzero hvd_ne) < 0 :=
