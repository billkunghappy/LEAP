      Polynomial.modByMonicHom_apply, ← Polynomial.C_mul']
  have hmod_U₀ : (U₀ * Polynomial.C (π_R ^ m)) %ₘ f_n_R =
      Polynomial.C (π_R ^ m) * (U₀ %ₘ f_n_R) :=
    hmod_C_mul (π_R ^ m) U₀ f_n_R
  have hmod_eq : M_R %ₘ f_n_R = Polynomial.C (π_R ^ m) * (U₀ %ₘ f_n_R) := by
    rw [← hUV, Polynomial.add_modByMonic, hmod_U₀, hmod_V₀, add_zero]
  have hC_πm_map : (Polynomial.C (π_R ^ m)).map ι = Polynomial.C (π ^ m) := by
    rw [Polynomial.map_C]
    rfl
  have hmap_mod_eq := congrArg (Polynomial.map ι) hmod_eq
  rw [Polynomial.map_modByMonic ι hf_n_R, hM_map, hfn_map,
    Polynomial.map_mul, hC_πm_map] at hmap_mod_eq
  exact (hpoly_m_iff _).mpr ⟨U₀ %ₘ f_n_R, hmap_mod_eq⟩

theorem exists_isLubinTateEndoPoly (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] (c : L) (hc : 0 ≤ valL F L c) (n : ℕ) :
    ∃ P : Polynomial L, IsLubinTateEndoPoly F L (chosenUniformizer F L : L) c n P :=
by
  let π₀ : Lˣ := chosenUniformizer F L
  let π : L := (π₀ : L)
  let f : Polynomial L := lubinTatePoly F L π
  let f_n : Polynomial L := lubinTateIterPoly F L π n
  let N : ℕ := (qL F L) ^ n
  have hπ_ne : π ≠ 0 := π₀.ne_zero
  have addVal_mul : ∀ {x y : F}, x ≠ 0 → y ≠ 0 → addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Lˣ, Multiplicative.toAdd (relValHom u) = relVal F L u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : Lˣ,
      relVal F L ((u * v : Lˣ) : L) = relVal F L u + relVal F L v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : Lˣ) (k : ℤ),
      relVal F L ((u ^ k : Lˣ) : L) = k * relVal F L u := by
    intro u k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨c₀, hc₀⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F c₀) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hc₀]
      exact hg
    have hc0 : c₀ ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 c₀ hc0, ?_⟩
    simp only [Units.val_mk0, addVal, hc0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F c₀))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F L ∧ ∃ π' : Lˣ, relVal F L π' = resDeg F L := by
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L u,
        (map_ne_zero (algebraMap F L)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (u : F)) = (u : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (u : F)
      have hpow : addVal F ((u : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F u := by
        change Multiplicative.toAdd (addValHom (u ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hf_pos, π', hπ'⟩ := resDeg_mem
  have hf_ne : (resDeg F L : ℤ) ≠ 0 := by positivity
  have hres_ne : resDeg F L ≠ 0 := by omega
  have hπ_val : valL F L π = 1 := by
    have hex : ∃ u : Lˣ, valL F L u = 1 := ⟨π', by rw [valL, hπ', Int.ediv_self hf_ne]⟩
    exact Classical.epsilon_spec hex
  have relVal_eq_resDeg_mul_valL_aux : ∀ u : Lˣ, relVal F L u = (resDeg F L : ℤ) * valL F L u := by
    intro u
    let q₀ := relVal F L u / (resDeg F L : ℤ)
    let r₀ := relVal F L u % (resDeg F L : ℤ)
    have hdiv : r₀ + (resDeg F L : ℤ) * q₀ = relVal F L u := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r₀ := Int.emod_nonneg _ (by positivity)
    have hrlt : r₀ < (resDeg F L : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F L ((u * π' ^ (-q₀) : Lˣ) : L) = r₀ := by
      rw [relVal_units_mul, relVal_units_zpow, hπ']
      linarith
    have hr_eq : r₀ = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r₀.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r₀.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k} := by
        refine ⟨hr_pos, ((u * π' ^ (-q₀) : Lˣ) : L), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F L ≤ r₀.toNat := Nat.sInf_le hmem
      omega
    change relVal F L u = (resDeg F L : ℤ) * q₀
    linarith
  have valL_units_mul : ∀ u v : Lˣ,
      valL F L ((u * v : Lˣ) : L) = valL F L u + valL F L v := by
    intro u v
    have hrel := relVal_eq_resDeg_mul_valL_aux (u * v)
    rw [relVal_units_mul, relVal_eq_resDeg_mul_valL_aux u,
      relVal_eq_resDeg_mul_valL_aux v] at hrel
    apply mul_left_cancel₀ hf_ne
    linarith
  have valL_units_zpow : ∀ (u : Lˣ) (k : ℤ),
      valL F L ((u ^ k : Lˣ) : L) = k * valL F L u := by
    intro u k
    have hrel := relVal_eq_resDeg_mul_valL_aux (u ^ k)
    rw [relVal_units_zpow, relVal_eq_resDeg_mul_valL_aux u] at hrel
    apply mul_left_cancel₀ hf_ne
    linarith
  have valL_div : ∀ {x y : L}, x ≠ 0 → y ≠ 0 → valL F L (x / y) = valL F L x - valL F L y := by
    intro x y hx hy
    let ux : Lˣ := Units.mk0 x hx
    let uy : Lˣ := Units.mk0 y hy
    have hxy : x / y = ((ux * uy ^ (-1 : ℤ) : Lˣ) : L) := by
      simp [ux, uy, div_eq_mul_inv]
    rw [hxy, valL_units_mul, valL_units_zpow]
    change valL F L x + (-1 : ℤ) * valL F L y = valL F L x - valL F L y
    ring
  have valL_pi_pow : ∀ k : ℕ, valL F L (π ^ k) = (k : ℤ) := by
    intro k
    have hpow : π ^ k = ((π₀ ^ (k : ℤ) : Lˣ) : L) := by simp [π]
    rw [hpow, valL_units_zpow, hπ_val, mul_one]
  have polyValLe_C : ∀ (m : ℕ) (a : L), (a = 0 ∨ (m : ℤ) ≤ valL F L a) →
      polyValLe F L m (Polynomial.C a) := by
    intro m a ha k
    rcases eq_or_ne k 0 with rfl | hk
    · simpa [Polynomial.coeff_C_zero] using ha
    · exact Or.inl (Polynomial.coeff_C_ne_zero hk)
  have polyValLe_monomial : ∀ (m j : ℕ) (a : L), (a = 0 ∨ (m : ℤ) ≤ valL F L a) →
      polyValLe F L m (Polynomial.monomial j a) := by
    intro m j a ha k
    rw [Polynomial.coeff_monomial]
    split_ifs
    · exact ha
    · exact Or.inl rfl
  have hden_ne_and_val : ∀ r' : ℕ, π ^ (r' + 2) - π ≠ 0 ∧ valL F L (π ^ (r' + 2) - π) = 1 := by
    intro r'
    have hpow_val : valL F L (π ^ (r' + 2)) = (r' + 2 : ℤ) := valL_pi_pow (r' + 2)
    have hC_pow_2 : polyValLe F L 2 (Polynomial.C (π ^ (r' + 2))) :=
      polyValLe_C 2 _ (Or.inr (by omega))
    have hC_pow_1 : polyValLe F L 1 (Polynomial.C (π ^ (r' + 2))) :=
      polyValLe_C 1 _ (Or.inr (by omega))
    have hC_pi_1 : polyValLe F L 1 (Polynomial.C π) :=
      polyValLe_C 1 _ (Or.inr (by omega))
    have hC_den_1 : polyValLe F L 1 (Polynomial.C (π ^ (r' + 2) - π)) := by
      rw [map_sub]
      exact (polyValLe_add_and_sub F L 1 _ _ hC_pow_1 hC_pi_1).2
    have hden_ge1 : π ^ (r' + 2) - π = 0 ∨ ((1 : ℕ) : ℤ) ≤ valL F L (π ^ (r' + 2) - π) := by
      have h0 := hC_den_1 0
      rwa [Polynomial.coeff_C_zero] at h0
    have hden_not_ge2 : ¬ (π ^ (r' + 2) - π = 0 ∨ ((2 : ℕ) : ℤ) ≤ valL F L (π ^ (r' + 2) - π)) := by
      intro hden_ge2
      have hC_den_2 : polyValLe F L 2 (Polynomial.C (π ^ (r' + 2) - π)) :=
        polyValLe_C 2 _ hden_ge2
      have hC_pi_2 : polyValLe F L 2
          (Polynomial.C (π ^ (r' + 2)) - Polynomial.C (π ^ (r' + 2) - π)) :=
        (polyValLe_add_and_sub F L 2 _ _ hC_pow_2 hC_den_2).2
      rw [← map_sub, sub_sub_cancel] at hC_pi_2
      have hpi_ge2 : π = 0 ∨ ((2 : ℕ) : ℤ) ≤ valL F L π := by
        have h0 := hC_pi_2 0
        rwa [Polynomial.coeff_C_zero] at h0
      rcases hpi_ge2 with h0 | hle
      · exact hπ_ne h0
      · omega
    have hden_ne : π ^ (r' + 2) - π ≠ 0 := fun h0 => hden_not_ge2 (Or.inl h0)
    refine ⟨hden_ne, ?_⟩
    have h1 : ((1 : ℕ) : ℤ) ≤ valL F L (π ^ (r' + 2) - π) := hden_ge1.resolve_left hden_ne
    have h2 : ¬ (((2 : ℕ) : ℤ) ≤ valL F L (π ^ (r' + 2) - π)) :=
      fun hle => hden_not_ge2 (Or.inr hle)
    omega
  have h_trunc_step : ∀ r : ℕ,
      polyValLe F L 0 (lubinTateEndoTrunc F L π c r) ∧
      ∃ d : L, (d = 0 ∨ 0 ≤ valL F L d) ∧
        lubinTateEndoTrunc F L π c (r + 1) =
          lubinTateEndoTrunc F L π c r + Polynomial.monomial (r + 1) d := by
    intro r
    induction r with
    | zero =>
      refine ⟨fun k => Or.inl (Polynomial.coeff_zero k), c, Or.inr hc, ?_⟩
      dsimp [lubinTateEndoTrunc]
      rw [zero_add, Polynomial.C_mul_X_eq_monomial]
    | succ r' ih =>
      rcases ih with ⟨hϕ_r', d₀, hd₀, h_eq_r'⟩
      have hϕ_succ : polyValLe F L 0 (lubinTateEndoTrunc F L π c (r' + 1)) := by
        rw [h_eq_r']
        exact (polyValLe_add_and_sub F L 0 _ _ hϕ_r' (polyValLe_monomial 0 (r' + 1) d₀ hd₀)).1
      refine ⟨hϕ_succ, ?_⟩
      set ϕ₁ := lubinTateEndoTrunc F L π c (r' + 1)
      set num := (f.comp ϕ₁ - ϕ₁.comp f).coeff (r' + 2)
      set den := π ^ (r' + 2) - π
      refine ⟨num / den, ?_, rfl⟩
      have hnum : num = 0 ∨ ((1 : ℕ) : ℤ) ≤ valL F L num :=
        polyValLe_one_lubinTatePoly_comp_sub_comp F L ϕ₁ hϕ_succ (r' + 2)
      rcases eq_or_ne num 0 with hnum0 | hnum_ne
      · left
        rw [hnum0, zero_div]
      · right
        have hnum_ge : ((1 : ℕ) : ℤ) ≤ valL F L num := hnum.resolve_left hnum_ne
        obtain ⟨hden_ne, hden_val⟩ : den ≠ 0 ∧ valL F L den = 1 := hden_ne_and_val r'
        have hdiv : valL F L (num / den) = valL F L num - valL F L den :=
          valL_div hnum_ne hden_ne
        omega
  let R : ℕ → Polynomial L := fun r => lubinTateEndoTrunc F L π c r %ₘ f_n
  have hR_cauchy : ∀ (m r k : ℕ), m * N ≤ r → polyValLe F L m (R (r + k) - R r) := by
    intro m r k hmr
    induction k with
    | zero =>
      intro j
      simp [R]
    | succ k ih =>
      obtain ⟨-, d, hd, hstep⟩ := h_trunc_step (r + k)
      have hR_step : R (r + (k + 1)) - R r =
          (R (r + k) - R r) + (Polynomial.monomial (r + k + 1) d) %ₘ f_n := by
        dsimp [R]
        rw [← Nat.add_assoc, hstep, Polynomial.add_modByMonic]
        abel
      rw [hR_step]
      have hjm : m * (qL F L) ^ n ≤ r + k + 1 := by
        change m * N ≤ r + k + 1
        omega
      have hmon : polyValLe F L m ((Polynomial.monomial (r + k + 1) d) %ₘ f_n) :=
        polyValLe_monomial_modByMonic_lubinTateIterPoly F L n m (r + k + 1)
          (by omega) hjm d hd
      exact (polyValLe_add_and_sub F L m _ _ ih hmon).1
  have hq : 1 < q F := by
    unfold q
    exact Finite.one_lt_card
  have hqL : 1 < qL F L := Nat.one_lt_pow hres_ne hq
  have hN_pos : 0 < N := by
    dsimp [N]
    positivity
  have h_lim : ∀ j : ℕ, ∃ x : L, ∀ m r : ℕ, m * N ≤ r →
      x - (R r).coeff j = 0 ∨ (m : ℤ) ≤ valL F L (x - (R r).coeff j) := by
    intro j
    apply exists_valL_cauchy_limit F L N hN_pos (fun r => (R r).coeff j)
    intro m r k hmr
    have h := hR_cauchy m r k hmr j
    rwa [Polynomial.coeff_sub] at h
  choose p hp using h_lim
  let D := f_n.natDegree
  let P : Polynomial L := ∑ j ∈ Finset.range D, Polynomial.monomial j (p j)
  have hP_coeff : ∀ j : ℕ, P.coeff j = if j < D then p j else 0 := by
    intro j
    dsimp [P]
    rw [Polynomial.finset_sum_coeff]
    simp [Polynomial.coeff_monomial]
  have hdeg_lt : (Polynomial.C π * Polynomial.X).degree <
      (Polynomial.X ^ qL F L : Polynomial L).degree := by
    calc (Polynomial.C π * Polynomial.X).degree
        ≤ 1 := Polynomial.degree_C_mul_X_le π
      _ < (qL F L : WithBot ℕ) := by exact_mod_cast hqL
      _ = (Polynomial.X ^ qL F L : Polynomial L).degree :=
          (Polynomial.degree_X_pow (qL F L)).symm
  have hf_monic : f.Monic := by
    change (Polynomial.C π * Polynomial.X + Polynomial.X ^ qL F L).Monic
    exact (Polynomial.monic_X_pow (qL F L)).add_of_right hdeg_lt
  have hf_deg : f.natDegree ≠ 0 := by
    have hdeg_eq : f.degree = (Polynomial.X ^ qL F L : Polynomial L).degree := by
      change (Polynomial.C π * Polynomial.X + Polynomial.X ^ qL F L).degree = _
      exact Polynomial.degree_add_eq_right_of_degree_lt hdeg_lt
    have hnd : f.natDegree = qL F L := by
      rw [Polynomial.natDegree_eq_of_degree_eq hdeg_eq, Polynomial.natDegree_X_pow]
    omega
  have hfn_monic_deg : ∀ k : ℕ,
      (lubinTateIterPoly F L π k).Monic ∧ (lubinTateIterPoly F L π k).natDegree ≠ 0 := by
    intro k
    induction k with
    | zero =>
      dsimp [lubinTateIterPoly]
      exact ⟨Polynomial.monic_X, by simp⟩
    | succ k ih =>
      dsimp [lubinTateIterPoly]
      refine ⟨hf_monic.comp ih.1 ih.2, ?_⟩
      rw [Polynomial.natDegree_comp]
      exact mul_ne_zero hf_deg ih.2
  have hf_n_monic : f_n.Monic := (hfn_monic_deg n).1
  have hf_n_deg : f_n.degree = (D : WithBot ℕ) :=
    Polynomial.degree_eq_natDegree hf_n_monic.ne_zero
  have hP_deg_lt : P.degree < f_n.degree := by
    rw [hf_n_deg, Polynomial.degree_lt_iff_coeff_zero]
    intro m hm
    rw [hP_coeff m, if_neg (by omega)]
  refine ⟨P, (Polynomial.modByMonic_eq_self_iff hf_n_monic).mpr hP_deg_lt, ?_⟩
  intro m r hmr k
  change (P - R r).coeff k = 0 ∨ (m : ℤ) ≤ valL F L ((P - R r).coeff k)
  rw [Polynomial.coeff_sub, hP_coeff k]
  split_ifs with hk
  · exact hp k m r hmr
  · left
    have hR_deg : (R r).degree < (k : WithBot ℕ) := by
      calc (R r).degree
          < f_n.degree := Polynomial.degree_modByMonic_lt _ hf_n_monic
        _ = (D : WithBot ℕ) := hf_n_deg
        _ ≤ (k : WithBot ℕ) := by exact_mod_cast not_lt.mp hk
    rw [Polynomial.coeff_eq_zero_of_degree_lt hR_deg, sub_zero]

theorem lubinTateEndoTrunc_mul_and_iter_comm (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (a b : L) (ha : 0 ≤ valL F L a) (hb : 0 ≤ valL F L b) (n r : ℕ) :
    let π := (chosenUniformizer F L : L)
    let ϕ_a := lubinTateEndoTrunc F L π a r
    let ϕ_b := lubinTateEndoTrunc F L π b r
    let ϕ_ab := lubinTateEndoTrunc F L π (a * b) r
    let f_n := lubinTateIterPoly F L π n
    polyValLe F L 0 ϕ_a ∧ ϕ_a.coeff 0 = 0 ∧
    (polyValLe F L 0 (ϕ_ab - ϕ_a.comp ϕ_b) ∧ ∀ k ≤ r, (ϕ_ab - ϕ_a.comp ϕ_b).coeff k = 0) ∧
    (polyValLe F L 0 (f_n.comp ϕ_b - ϕ_b.comp f_n) ∧
      ∀ k ≤ r, (f_n.comp ϕ_b - ϕ_b.comp f_n).coeff k = 0) :=
by
  let π₀ : Lˣ := chosenUniformizer F L
  let π : L := (π₀ : L)
  let f : Polynomial L := lubinTatePoly F L π
  have h_valL_pi : valL F L π₀ = 1 := (valL_chosenUniformizer_and_mul_zpow F L 1).1
  have h_relVal_eq : ∀ x : Lˣ, relVal F L x = (resDeg F L : ℤ) * valL F L x :=
    relVal_eq_resDeg_mul_valL F L
  have h_int_iff : ∀ z : L, IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ relVal F L z :=
    isIntegral_iff_eq_zero_or_relVal_nonneg F L
  have h_fermat_and_p := isIntegral_pow_qL_sub_and_p_div_chosenUniformizer F L
  have hπ_ne : π ≠ 0 := π₀.ne_zero
  have hf_ne : (resDeg F L : ℤ) ≠ 0 := by
    intro h0
    have h1 : valL F L π = 1 := h_valL_pi
    rw [valL, h0, Int.ediv_zero] at h1
    omega
  have hres_ne : resDeg F L ≠ 0 := by omega
  have hf_pos : 0 < (resDeg F L : ℤ) := by omega
  have hq : 1 < q F := by
    unfold q
    exact Finite.one_lt_card
  have hqL : 1 < qL F L := Nat.one_lt_pow hres_ne hq
  have addVal_mul : ∀ {x y : F}, x ≠ 0 → y ≠ 0 → addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
