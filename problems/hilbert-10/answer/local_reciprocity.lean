      rw [h_det_split]
      ring
    rw [h_eq]
    exact polyDivPow_add h_diag_univ h_off_sum
  
  have h_adj_diff_eq :
      c • M_B.adjugate - c • (M_B ^ (q - 1)) =
        -(M_B.adjugate * (M_B ^ q - Matrix.scalar (Fin q) c)) := by
    have h_pow_q : M_B ^ q = M_B * M_B ^ (q - 1) := by
      conv_lhs => rw [← Nat.sub_add_cancel hq1, pow_succ']
    have h1 : M_B.adjugate * M_B ^ q = c • (M_B ^ (q - 1)) := by
      rw [h_pow_q, ← mul_assoc, h_adj_MB, h_scalar_eq_smul, smul_mul_assoc, one_mul]
    have h2 : M_B.adjugate * Matrix.scalar (Fin q) c = c • M_B.adjugate := by
      rw [h_scalar_eq_smul, mul_smul_comm, mul_one]
    rw [mul_sub, h1, h2, neg_sub]
  have h_adj_diff_div : ∀ j i : Fin q,
      polyDivPow 1 ((c • M_B.adjugate - c • (M_B ^ (q - 1))) j i) := by
    intro j i
    rw [h_adj_diff_eq, Matrix.neg_apply, Matrix.mul_apply]
    apply polyDivPow_neg
    apply polyDivPow_sum
    intro r _
    simpa using polyDivPow_mul (hMB_adj_div j r) (hMB_pow_div r i)
  have h_tr_diff_eq :
      Matrix.trace ((c • M_B.adjugate - c • (M_B ^ (q - 1))) * D) =
