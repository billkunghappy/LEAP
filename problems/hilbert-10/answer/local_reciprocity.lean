    h_basis_ind (Module.finrank F L) 0 (by omega) Fin.elim0
      (fun i => Fin.elim0 i) (fun _ _ i => Fin.elim0 i)
  obtain ⟨uF, huF⟩ := exists_addVal_eq_one
  set πF : F := (uF : F)
  have hπF0 : πF ≠ 0 := uF.ne_zero
  have hπF_L0 : algebraMap F L πF ≠ 0 := (map_ne_zero (algebraMap F L)).mpr hπF0
  have h_finrank_rel : (Module.finrank F L : ℤ) =
      (resDeg F L : ℤ) * valL F L (algebraMap F L πF) := by
    have h1 := relVal_algebraMap hπF0
    rw [huF, mul_one, relVal_eq hπF_L0] at h1
    exact h1.symm
  have h_finrank_pos : 0 < Module.finrank F L := Module.finrank_pos
  have h_valL_πF_pos : 0 < valL F L (algebraMap F L πF) := by
    by_contra hle
    have hle0 : valL F L (algebraMap F L πF) ≤ 0 := by omega
    have hnp : (resDeg F L : ℤ) * valL F L (algebraMap F L πF) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos (by omega) hle0
    omega
  let e : ℕ := (valL F L (algebraMap F L πF)).toNat
  have he_eq : (e : ℤ) = valL F L (algebraMap F L πF) :=
    Int.toNat_of_nonneg (by omega)
  have he_pos : 0 < e := by omega
  have h_finrank_eq : Module.finrank F L = resDeg F L * e := by
    have h : (Module.finrank F L : ℤ) = (resDeg F L * e : ℕ) := by
      push_cast
      rw [he_eq]
      exact h_finrank_rel
    exact Nat.cast_injective h
  have valL_algebraMap : ∀ {c : F} (hc : c ≠ 0),
