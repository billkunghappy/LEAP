    have hσ_e₀ : ∀ σ : U ≃ₐ[K] U, D_U 0 (σ e₀) :=
      fun σ => DU_of_int (he₀_int.map (σ.toAlgHom.restrictScalars 𝒪[F]))
    let P : Finset (U ≃ₐ[K] U) → K → U :=
      fun S c => ∏ σ ∈ S, (1 + algebraMap K U c * σ e₀)
    let T : Finset (U ≃ₐ[K] U) → U :=
      fun S => ∑ σ ∈ S, σ e₀
    have hT_DU0 : ∀ S : Finset (U ≃ₐ[K] U), D_U 0 (T S) := by
      intro S
      induction S using Finset.cons_induction with
      | empty => exact DU_zero 0
      | cons σ₀ S' hnotin ih =>
        dsimp [T] at ih ⊢
        rw [Finset.sum_cons]
        exact DU_add (hσ_e₀ σ₀) ih
    have h_prod_lin : ∀ (S : Finset (U ≃ₐ[K] U)) {c₁ c₂ : K} {k : ℕ},
        1 ≤ k → D_K 1 c₁ → D_K 1 c₂ → D_K k (c₁ - c₂) →
        (D_U 1 (P S c₁ - 1) ∧ D_U 0 (P S c₁)) ∧
        D_U k (P S c₁ - P S c₂) ∧
        D_U (k + 1) (P S c₁ - P S c₂ - algebraMap K U (c₁ - c₂) * T S) := by
      intro S c₁ c₂ k hk hc₁ hc₂ hdiff
      have hcbar₁ : D_U 1 (algebraMap K U c₁) := (DU_algebraMap_iff 1 c₁).mpr hc₁
      have hcbar₂ : D_U 1 (algebraMap K U c₂) := (DU_algebraMap_iff 1 c₂).mpr hc₂
      have hdiff_U : D_U k (algebraMap K U c₁ - algebraMap K U c₂) := by
        rw [← map_sub]
        exact (DU_algebraMap_iff k (c₁ - c₂)).mpr hdiff
      induction S using Finset.cons_induction with
      | empty =>
        dsimp [P, T]
        rw [sub_self, mul_zero, sub_zero]
        exact ⟨⟨DU_zero 1, DU_one⟩, DU_zero k, DU_zero (k + 1)⟩
      | cons σ₀ S' hnotin ih =>
        obtain ⟨⟨hP₁_sub, hP₁_0⟩, hP_diff, hP_lin⟩ := ih
        set a : U := σ₀ e₀
        set cbar₁ : U := algebraMap K U c₁
        set cbar₂ : U := algebraMap K U c₂
        set P₁ : U := P S' c₁
        set P₂ : U := P S' c₂
        set T' : U := T S'
        have ha : D_U 0 a := hσ_e₀ σ₀
        have hP_cons₁ : P (Finset.cons σ₀ S' hnotin) c₁ = (1 + cbar₁ * a) * P₁ :=
          Finset.prod_cons hnotin
        have hP_cons₂ : P (Finset.cons σ₀ S' hnotin) c₂ = (1 + cbar₂ * a) * P₂ :=
          Finset.prod_cons hnotin
        have hT_cons : T (Finset.cons σ₀ S' hnotin) = a + T' :=
          Finset.sum_cons hnotin
        have h1_sub : D_U 1 (P (Finset.cons σ₀ S' hnotin) c₁ - 1) := by
          have h_ring₁ : P (Finset.cons σ₀ S' hnotin) c₁ - 1 = (P₁ - 1) + cbar₁ * (a * P₁) := by
            rw [hP_cons₁]
            ring
          rw [h_ring₁]
          have haP₁ : D_U 0 (a * P₁) := by simpa using DU_mul ha hP₁_0
          have hc₁aP₁ : D_U 1 (cbar₁ * (a * P₁)) := by simpa using DU_mul hcbar₁ haP₁
          exact DU_add hP₁_sub hc₁aP₁
        have h1_0 : D_U 0 (P (Finset.cons σ₀ S' hnotin) c₁) := by
          have h_eq : P (Finset.cons σ₀ S' hnotin) c₁ =
              (P (Finset.cons σ₀ S' hnotin) c₁ - 1) + 1 := by ring
          rw [h_eq]
          exact DU_add (DU_mono (Nat.zero_le 1) h1_sub) DU_one
        have h3 : D_U (k + 1) (P (Finset.cons σ₀ S' hnotin) c₁ -
            P (Finset.cons σ₀ S' hnotin) c₂ -
            algebraMap K U (c₁ - c₂) * T (Finset.cons σ₀ S' hnotin)) := by
          have h_ring₃ : P (Finset.cons σ₀ S' hnotin) c₁ -
              P (Finset.cons σ₀ S' hnotin) c₂ -
              algebraMap K U (c₁ - c₂) * T (Finset.cons σ₀ S' hnotin) =
              (P₁ - P₂ - algebraMap K U (c₁ - c₂) * T') +
              ((cbar₁ - cbar₂) * a) * (P₁ - 1) +
              (cbar₂ * a) * (P₁ - P₂) := by
            rw [hP_cons₁, hP_cons₂, hT_cons, map_sub]
            change (1 + cbar₁ * a) * P₁ - (1 + cbar₂ * a) * P₂ - (cbar₁ - cbar₂) * (a + T') = _
            ring
          rw [h_ring₃]
          have h_t2_left : D_U k ((cbar₁ - cbar₂) * a) := by simpa using DU_mul hdiff_U ha
          have h_t2 : D_U (k + 1) (((cbar₁ - cbar₂) * a) * (P₁ - 1)) := DU_mul h_t2_left hP₁_sub
          have h_t3_left : D_U 1 (cbar₂ * a) := by simpa using DU_mul hcbar₂ ha
          have h_t3 : D_U (k + 1) ((cbar₂ * a) * (P₁ - P₂)) := by
            have h_m := DU_mul h_t3_left hP_diff
            rwa [Nat.add_comm 1 k] at h_m
          exact DU_add (DU_add hP_lin h_t2) h_t3
        have h2 : D_U k (P (Finset.cons σ₀ S' hnotin) c₁ -
            P (Finset.cons σ₀ S' hnotin) c₂) := by
          have h_ring₂ : P (Finset.cons σ₀ S' hnotin) c₁ -
              P (Finset.cons σ₀ S' hnotin) c₂ =
              (P (Finset.cons σ₀ S' hnotin) c₁ -
                P (Finset.cons σ₀ S' hnotin) c₂ -
                algebraMap K U (c₁ - c₂) * T (Finset.cons σ₀ S' hnotin)) +
              (cbar₁ - cbar₂) * T (Finset.cons σ₀ S' hnotin) := by
            rw [map_sub]
            change P (Finset.cons σ₀ S' hnotin) c₁ - P (Finset.cons σ₀ S' hnotin) c₂ =
              (P (Finset.cons σ₀ S' hnotin) c₁ - P (Finset.cons σ₀ S' hnotin) c₂ -
                (cbar₁ - cbar₂) * T (Finset.cons σ₀ S' hnotin)) +
              (cbar₁ - cbar₂) * T (Finset.cons σ₀ S' hnotin)
            ring
          rw [h_ring₂]
          have h_lin_k : D_U k (P (Finset.cons σ₀ S' hnotin) c₁ -
              P (Finset.cons σ₀ S' hnotin) c₂ -
              algebraMap K U (c₁ - c₂) * T (Finset.cons σ₀ S' hnotin)) :=
            DU_mono (Nat.le_succ k) h3
          have h_T_term : D_U k ((cbar₁ - cbar₂) * T (Finset.cons σ₀ S' hnotin)) := by
            simpa using DU_mul hdiff_U (hT_DU0 (Finset.cons σ₀ S' hnotin))
          exact DU_add h_lin_k h_T_term
        exact ⟨⟨h1_sub, h1_0⟩, h2, h3⟩
    let f : K → K := fun c => Algebra.norm K (1 + algebraMap K U c * e₀)
    let G : K → K := fun c => c + ((u : K) - f c)
    have hf_eq_P : ∀ c : K, algebraMap K U (f c) = P Finset.univ c := by
      intro c
      dsimp [f, P]
      rw [Algebra.norm_eq_prod_automorphisms K (1 + algebraMap K U c * e₀)]
      refine Finset.prod_congr rfl fun σ _ => ?_
      rw [map_add, map_one, map_mul, AlgEquiv.commutes]
    have hT_univ : T Finset.univ = 1 := by
      dsimp [T]
      have htr := (trace_eq_sum_automorphisms (K := K) (L := U) e₀).symm
      rw [he₀_tr, map_one] at htr
      exact htr
    have hf_lip : ∀ {c₁ c₂ : K} {k : ℕ},
        1 ≤ k → D_K 1 c₁ → D_K 1 c₂ → D_K k (c₁ - c₂) → D_K k (f c₁ - f c₂) := by
      intro c₁ c₂ k hk hc₁ hc₂ hdiff
      rw [← DU_algebraMap_iff k (f c₁ - f c₂), map_sub, hf_eq_P c₁, hf_eq_P c₂]
      exact (h_prod_lin Finset.univ hk hc₁ hc₂ hdiff).2.1
    have hG_contract : ∀ {c₁ c₂ : K} {k : ℕ},
        1 ≤ k → D_K 1 c₁ → D_K 1 c₂ → D_K k (c₁ - c₂) → D_K (k + 1) (G c₁ - G c₂) := by
      intro c₁ c₂ k hk hc₁ hc₂ hdiff
      have h3 := (h_prod_lin Finset.univ hk hc₁ hc₂ hdiff).2.2
      rw [hT_univ, mul_one, ← hf_eq_P c₁, ← hf_eq_P c₂] at h3
      have h_eq : algebraMap K U (G c₁ - G c₂) =
          -(algebraMap K U (f c₁) - algebraMap K U (f c₂) - algebraMap K U (c₁ - c₂)) := by
        dsimp [G]
        rw [map_sub, map_sub, map_add, map_add, map_sub, map_sub]
        ring
      rw [← DU_algebraMap_iff (k + 1) (G c₁ - G c₂), h_eq]
      exact DU_neg h3
    let cSeq : ℕ → K := fun r => Nat.rec 0 (fun _ cr => G cr) r
    have hcSeq_zero : cSeq 0 = 0 := rfl
    have hcSeq_succ : ∀ r : ℕ, cSeq (r + 1) = G (cSeq r) := fun _ => rfl
    have hf_zero : f 0 = 1 := by
      dsimp [f]
      rw [map_zero, zero_mul, add_zero, map_one]
    have hu_DK1 : D_K 1 ((u : K) - 1) := (DK_iff_valL 1 ((u : K) - 1)).mpr (Or.inr hu_val)
    have hcSeq_props : ∀ r : ℕ, D_K 1 (cSeq r) ∧ D_K (r + 1) (cSeq (r + 1) - cSeq r) := by
      intro r
      induction r with
      | zero =>
        refine ⟨?_, ?_⟩
        · rw [hcSeq_zero]
          exact DK_zero 1
        · have h1 : cSeq (0 + 1) - cSeq 0 = (u : K) - 1 := by
            rw [hcSeq_succ 0, hcSeq_zero]
            dsimp [G]
            rw [hf_zero, zero_add, sub_zero]
          rw [h1, Nat.zero_add]
          exact hu_DK1
      | succ r ih =>
        obtain ⟨hcr_1, hcr_step⟩ := ih
        have hcr1_1 : D_K 1 (cSeq (r + 1)) := by
          have h_eq : cSeq (r + 1) = (cSeq (r + 1) - cSeq r) + cSeq r := by ring
          rw [h_eq]
          exact DK_add (DK_mono (by omega : 1 ≤ r + 1) hcr_step) hcr_1
        have hcr1_step : D_K (r + 2) (cSeq (r + 2) - cSeq (r + 1)) := by
          rw [hcSeq_succ (r + 1), hcSeq_succ r]
          exact hG_contract (by omega : 1 ≤ r + 1) hcr1_1 hcr_1 hcr_step
        exact ⟨hcr1_1, hcr1_step⟩
    have hcSeq_cauchy_DK : ∀ r j : ℕ, D_K (r + 1) (cSeq (r + j) - cSeq r) := by
      intro r j
      induction j with
      | zero =>
        simp only [Nat.add_zero, sub_self]
        exact DK_zero (r + 1)
      | succ j ih =>
        have h_eq : cSeq (r + (j + 1)) - cSeq r =
            (cSeq (r + j) - cSeq r) + (cSeq (r + j + 1) - cSeq (r + j)) := by
          have h_idx : r + (j + 1) = r + j + 1 := by omega
          rw [h_idx]
          ring
        rw [h_eq]
        exact DK_add ih (DK_mono (by omega : r + 1 ≤ r + j + 1) (hcSeq_props (r + j)).2)
    have hcSeq_norm : ∀ m r k : ℕ, m ≤ r → ‖cSeq (r + k) - cSeq r‖ ≤ ‖πK‖ ^ m := by
      intro m r k hmr
      exact (DK_iff_norm m (cSeq (r + k) - cSeq r)).mp
        (DK_mono (by omega : m ≤ r + 1) (hcSeq_cauchy_DK r k))
    have hcSeq_dist : ∀ m r : ℕ, m ≤ r → dist (cSeq r) (cSeq m) ≤ ‖πK‖ ^ m := by
      intro m r hmr
      have hr_eq : m + (r - m) = r := Nat.add_sub_of_le hmr
      rw [dist_eq_norm, ← hr_eq]
      exact hcSeq_norm m m (r - m) (le_refl m)
    have h_cauchy : CauchySeq cSeq := by
      rw [Metric.cauchySeq_iff]
      intro ε hε
      obtain ⟨m, hm⟩ := exists_pow_lt_of_lt_one (half_pos hε) hπ_norm_lt_one
      refine ⟨m, fun r₁ hr₁ r₂ hr₂ => ?_⟩
      have hd1 : dist (cSeq r₁) (cSeq m) ≤ ‖πK‖ ^ m := hcSeq_dist m r₁ hr₁
      have hd2 : dist (cSeq r₂) (cSeq m) ≤ ‖πK‖ ^ m := hcSeq_dist m r₂ hr₂
      calc dist (cSeq r₁) (cSeq r₂)
          ≤ dist (cSeq r₁) (cSeq m) + dist (cSeq r₂) (cSeq m) :=
            dist_triangle_right (cSeq r₁) (cSeq r₂) (cSeq m)
        _ ≤ ‖πK‖ ^ m + ‖πK‖ ^ m := add_le_add hd1 hd2
        _ < ε / 2 + ε / 2 := add_lt_add hm hm
        _ = ε := add_halves ε
    obtain ⟨c_inf, hc_tendsto⟩ := cauchySeq_tendsto_of_complete h_cauchy
    have hc_lim : ∀ r : ℕ, D_K r (c_inf - cSeq r) := by
      intro r
      rw [DK_iff_norm]
      by_contra h_gt
      have hδ : 0 < ‖c_inf - cSeq r‖ - ‖πK‖ ^ r := by linarith
      obtain ⟨M₀, hM₀⟩ := Metric.tendsto_atTop.mp hc_tendsto (‖c_inf - cSeq r‖ - ‖πK‖ ^ r) hδ
      have h_dist_x : dist c_inf (cSeq (r + M₀)) < ‖c_inf - cSeq r‖ - ‖πK‖ ^ r := by
        rw [dist_comm]
        exact hM₀ (r + M₀) (Nat.le_add_left M₀ r)
      have h_dist_u : dist (cSeq (r + M₀)) (cSeq r) ≤ ‖πK‖ ^ r := by
        rw [dist_eq_norm]
        exact hcSeq_norm r r M₀ (le_refl r)
      have h_tri : ‖c_inf - cSeq r‖ ≤ dist c_inf (cSeq (r + M₀)) + dist (cSeq (r + M₀)) (cSeq r) := by
        rw [← dist_eq_norm]
        exact dist_triangle c_inf (cSeq (r + M₀)) (cSeq r)
      linarith
    have hc_inf_1 : D_K 1 c_inf := by
      have h_eq : c_inf = (c_inf - cSeq 1) + cSeq 1 := by ring
      rw [h_eq]
      exact DK_add (hc_lim 1) (hcSeq_props 1).1
    have hf_c_inf : f c_inf = (u : K) := by
      apply eq_of_forall_DK_sub
      intro m
      let r : ℕ := m + 1
      have h_eq : f c_inf - (u : K) =
          (f c_inf - f (cSeq r)) - (cSeq (r + 1) - cSeq r) := by
        rw [hcSeq_succ r]
        dsimp [G]
        ring
      rw [h_eq]
      have h_f_diff : D_K r (f c_inf - f (cSeq r)) :=
        hf_lip (by omega : 1 ≤ r) hc_inf_1 (hcSeq_props r).1 (hc_lim r)
      have h_step : D_K r (cSeq (r + 1) - cSeq r) :=
        DK_mono (Nat.le_succ r) (hcSeq_props r).2
      exact DK_mono (Nat.le_succ m) (DK_sub h_f_diff h_step)
    exact ⟨1 + algebraMap K U c_inf * e₀, hf_c_inf⟩

theorem valL_and_relVal_unit_mul_chosenUniformizer_zpow (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (u : Lˣ) (k : ℤ)
    (hu : valL F L u = 0) :
    valL F L ((u * (chosenUniformizer F L) ^ k : Lˣ) : L) = k ∧
      relVal F L ((u * (chosenUniformizer F L) ^ k : Lˣ) : L) = (resDeg F L : ℤ) * k :=
by
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun v => Multiplicative.ofAdd (addVal F v)
      map_one' := by simp [addVal_one]
      map_mul' := fun v w => by simp [addVal_mul v.ne_zero w.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ v : Lˣ, Multiplicative.toAdd (relValHom v) = relVal F L v :=
    fun _ => rfl
  have relVal_units_mul : ∀ v w : Lˣ,
      relVal F L ((v * w : Lˣ) : L) = relVal F L v + relVal F L w := by
    intro v w
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (v : Lˣ) (m : ℤ),
      relVal F L ((v ^ m : Lˣ) : L) = m * relVal F L v := by
    intro v m
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have exists_addVal_eq_one : ∃ v : Fˣ, addVal F v = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F L ∧ ∃ π : Lˣ, relVal F L π = resDeg F L := by
    obtain ⟨v, hv⟩ := exists_addVal_eq_one
    let S : Set ℕ := {m : ℕ | 0 < m ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = m}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L v,
        (map_ne_zero (algebraMap F L)).mpr v.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (v : F)) = (v : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (v : F)
      have hpow : addVal F ((v : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F v := by
        change Multiplicative.toAdd (addValHom (v ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hv, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hf, π, hπ⟩ := resDeg_mem
  have relVal_eq_resDeg_mul_valL_aux : ∀ v : Lˣ, relVal F L v = (resDeg F L : ℤ) * valL F L v := by
    intro v
    let q := relVal F L v / (resDeg F L : ℤ)
    let r := relVal F L v % (resDeg F L : ℤ)
    have hdiv : r + (resDeg F L : ℤ) * q = relVal F L v := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r := Int.emod_nonneg _ (by positivity)
    have hrlt : r < (resDeg F L : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F L ((v * π ^ (-q) : Lˣ) : L) = r := by
      rw [relVal_units_mul, relVal_units_zpow, hπ]
      linarith
    have hr_eq : r = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r.toNat ∈ {m : ℕ | 0 < m ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = m} := by
        refine ⟨hr_pos, ((v * π ^ (-q) : Lˣ) : L), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F L ≤ r.toNat := Nat.sInf_le hmem
      omega
    change relVal F L v = (resDeg F L : ℤ) * q
    linarith
  have hf_ne : (resDeg F L : ℤ) ≠ 0 := by positivity
  have hπ_val : valL F L π = 1 := by
    rw [valL, hπ, Int.ediv_self hf_ne]
  have hch : valL F L (chosenUniformizer F L) = 1 :=
    Classical.epsilon_spec (p := fun π : Lˣ => valL F L π = 1) ⟨π, hπ_val⟩
  have hrel : relVal F L ((u * (chosenUniformizer F L) ^ k : Lˣ) : L) = (resDeg F L : ℤ) * k := by
    rw [relVal_units_mul, relVal_units_zpow, relVal_eq_resDeg_mul_valL_aux u,
      relVal_eq_resDeg_mul_valL_aux (chosenUniformizer F L), hu, hch]
    ring
  have hval : valL F L ((u * (chosenUniformizer F L) ^ k : Lˣ) : L) = k := by
    rw [valL, hrel, Int.mul_ediv_cancel_left k hf_ne]
  exact ⟨hval, hrel⟩

theorem exists_unramDegSubfield_frob_and_normLM_eq (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (u : Lˣ) : valL F L u = 0 → ∀ (f₀ : ℕ), 1 ≤ f₀ →
    ∀ (σ : AbsGal F), σ ∈ L.fixingSubgroup →
    ActsAsFrobPow F σ (-((resDeg F L : ℤ) * (f₀ : ℤ))) →
    let E₀ := unramDegSubfield F L f₀
    let hLE₀ : L ≤ E₀ := le_sup_left
    FiniteDimensional F E₀ ∧
    σ ∈ E₀.fixingSubgroup ∧
    resDeg F E₀ = resDeg F L * f₀ ∧
    ∃ (τ : AbsGal F) (v : E₀ˣ),
      τ ∈ L.fixingSubgroup ∧
      (∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ → τ ζ = ζ ^ qL F L) ∧
      (∀ x ∈ unramSubring F L, (τ ^ f₀) x = σ⁻¹ x) ∧
      (∀ x ∈ E₀, τ x ∈ E₀) ∧
      (∀ x ∈ E₀, (τ ^ f₀) x = x) ∧
      (∀ x : E₀,
        ∏ j ∈ Finset.range f₀, (τ ^ j) (x : AlgebraicClosure F) =
          algebraMap L (AlgebraicClosure F) (normLM F hLE₀ x)) ∧
      (∀ (k : ℕ) (x : E₀), normLM F hLE₀ (relLubinTateCoeff F E₀ τ x k) = normLM F hLE₀ x) ∧
      valL F E₀ v = 0 ∧
      Units.map (normLM F hLE₀) v = u ∧
      valL F E₀
        ((v * Units.map (IntermediateField.inclusion hLE₀).toMonoidHom
          (chosenUniformizer F L) : E₀ˣ) : E₀) = 1 ∧
      Units.map (normLM F hLE₀)
        (v * Units.map (IntermediateField.inclusion hLE₀).toMonoidHom
          (chosenUniformizer F L)) =
        u * (chosenUniformizer F L) ^ (f₀ : ℤ) :=
by
  intro hu f₀ hf₀ σ hσL hσFrob E₀ hLE₀
  set N := qL F L ^ f₀ - 1
  set U := unramifiedLevelField F L N
  have h_E₀_le_U : E₀ ≤ U.restrictScalars F := by
    change L ⊔ IntermediateField.adjoin F {ζ : AlgebraicClosure F | ζ ^ N = 1} ≤ U.restrictScalars F
    apply sup_le
    · intro x hx
      rw [IntermediateField.mem_restrictScalars]
      exact U.algebraMap_mem ⟨x, hx⟩
    · rw [IntermediateField.adjoin_le_iff]
      intro ζ hζ
      exact (IntermediateField.mem_restrictScalars F).mpr
        (IntermediateField.subset_adjoin L _ hζ)
  have h_ext : IntermediateField.extendScalars hLE₀ = U := by
    apply le_antisymm
    · intro y hy
      exact (IntermediateField.mem_restrictScalars F).mp
        (h_E₀_le_U ((IntermediateField.mem_extendScalars hLE₀).mp hy))
    · change IntermediateField.adjoin L {ζ : AlgebraicClosure F | ζ ^ N = 1} ≤
        IntermediateField.extendScalars hLE₀
      rw [IntermediateField.adjoin_le_iff]
      intro ζ hζ
      change ζ ∈ IntermediateField.extendScalars hLE₀
      rw [IntermediateField.mem_extendScalars]
      exact (le_sup_right : _ ≤ E₀) (IntermediateField.subset_adjoin F _ hζ)
  have h_E₀_eq_U : E₀ = U.restrictScalars F := by
    apply le_antisymm h_E₀_le_U
    intro y hy
    have hyU : y ∈ U := (IntermediateField.mem_restrictScalars F).mp hy
    rw [← h_ext] at hyU
    exact (IntermediateField.mem_extendScalars hLE₀).mp hyU
  have hϖ : valL F L (chosenUniformizer F L) = 1 :=
    (valL_chosenUniformizer_and_mul_zpow F L 1).1
  have hres_ne : resDeg F L ≠ 0 := by
    intro h0
    unfold valL at hϖ
    rw [h0, Nat.cast_zero, Int.ediv_zero] at hϖ
    omega
  have hresL_pos : 0 < resDeg F L := Nat.pos_of_ne_zero hres_ne
  haveI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  haveI : CharP 𝓀[F] (p F) := by unfold p; infer_instance
  obtain ⟨d_F, hp, hq⟩ := FiniteField.card 𝓀[F] (p F)
  have hq' : q F = p F ^ (d_F : ℕ) := by
    rw [q, Nat.card_eq_fintype_card, hq]
  have hp_ge_two : 2 ≤ p F := hp.two_le
  have hqL_ge_two : 2 ≤ qL F L := by
    dsimp [qL]
    rw [hq', ← pow_mul]
    have hpos : 0 < (d_F : ℕ) * resDeg F L := Nat.mul_pos d_F.pos hresL_pos
    calc 2 = 2 ^ 1 := by ring
      _ ≤ 2 ^ ((d_F : ℕ) * resDeg F L) := Nat.pow_le_pow_right (by omega) hpos
      _ ≤ p F ^ ((d_F : ℕ) * resDeg F L) := Nat.pow_le_pow_left hp_ge_two _
  have hqLf₀_ge_two : 2 ≤ qL F L ^ f₀ := by
    calc 2 = 2 ^ 1 := by ring
      _ ≤ 2 ^ f₀ := Nat.pow_le_pow_right (by omega) hf₀
      _ ≤ qL F L ^ f₀ := Nat.pow_le_pow_left hqL_ge_two f₀
  have hN_pos : 0 < N := by omega
  have hpN : ¬ p F ∣ N := by
    intro hdvd
    have hdvd_pow : p F ∣ qL F L ^ f₀ := by
      dsimp [qL]
      rw [hq', ← pow_mul, ← pow_mul]
      have hk_pos : 0 < (d_F : ℕ) * (resDeg F L * f₀) :=
        Nat.mul_pos d_F.pos (Nat.mul_pos hresL_pos (by omega))
      exact dvd_pow_self (p F) hk_pos.ne'
    have hdvd_one : p F ∣ 1 := by
      have hsub := Nat.dvd_sub hdvd_pow hdvd
      have heq : qL F L ^ f₀ - N = 1 := by omega
      rwa [heq] at hsub
    exact hp.not_dvd_one hdvd_one
  obtain ⟨hGal, hFinU, hB⟩ := unramifiedLevelField_isGalois_and_resDeg F L N hN_pos hpN
  haveI : IsGalois L U := hGal
  haveI : FiniteDimensional L U := hFinU
  haveI : Fintype (U ≃ₐ[L] U) := Fintype.ofFinite (U ≃ₐ[L] U)
  have hFin_URest : FiniteDimensional F (U.restrictScalars F) := by
    change FiniteDimensional F U
    exact FiniteDimensional.trans F L U
  have hFin_E₀ : FiniteDimensional F E₀ := h_E₀_eq_U.symm ▸ hFin_URest
  haveI : FiniteDimensional F E₀ := hFin_E₀
  have h_card_aut : Fintype.card (U ≃ₐ[L] U) = Module.finrank L U := by
    rw [← Nat.card_eq_fintype_card, IsGalois.card_aut_eq_finrank L U]
  obtain ⟨τ₀, hτ₀L, hτ₀Frob⟩ := exists_actsAsFrobPow_neg_resDeg F L
  have hτ₀L_fix : ∀ x ∈ L, τ₀ x = x := by
    rwa [IntermediateField.mem_fixingSubgroup_iff] at hτ₀L
  let τ₀_L : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F :=
    { τ₀.toRingEquiv with
      commutes' := fun x => hτ₀L_fix x.1 x.2 }
  let ϕ_τ₀ : U ≃ₐ[L] U := AlgEquiv.restrictNormalHom U τ₀_L
  have h_ϕ_apply : ∀ x : U, ((ϕ_τ₀ x : U) : AlgebraicClosure F) = τ₀ (x : AlgebraicClosure F) := by
    intro x
    exact AlgEquiv.restrictNormal_commutes τ₀_L U x
  have h_ϕ_pow : ∀ (i : ℕ) (x : U),
      (((ϕ_τ₀ ^ i) x : U) : AlgebraicClosure F) = (τ₀ ^ i) (x : AlgebraicClosure F) := by
    intro i
    induction i with
    | zero => intro x; rfl
    | succ i ih =>
      intro x
      rw [pow_succ', pow_succ', AlgEquiv.mul_apply, AlgEquiv.mul_apply, h_ϕ_apply, ih]
  obtain ⟨ζ₀, hζ_U, _hζ_m, hζ_ne⟩ :=
    exists_root_unramDegSubfield_pow_apply_eq_and_ne F L f₀ hf₀ τ₀ hτ₀Frob
  have hζ₀_mem_U : ζ₀ ∈ U := by
    have h0 := hζ_U 0
    rw [pow_zero, AlgEquiv.one_apply] at h0
    exact (IntermediateField.mem_restrictScalars F).mp (h_E₀_le_U h0)
  let z_root : U := ⟨ζ₀, hζ₀_mem_U⟩
  have h_ϕ_pow_ne_one : ∀ j : ℕ, 1 ≤ j → j < f₀ → ϕ_τ₀ ^ j ≠ 1 := by
    intro j hj1 hj2 h_eq
    have h1 := congr_arg (fun g : U ≃ₐ[L] U => ((g z_root : U) : AlgebraicClosure F)) h_eq
    dsimp only at h1
    rw [h_ϕ_pow j z_root] at h1
    exact hζ_ne j hj1 hj2 h1
  let f_pow : Fin f₀ → (U ≃ₐ[L] U) := fun i => ϕ_τ₀ ^ (i : ℕ)
  have hf_inj : Function.Injective f_pow := by
    intro i₁ i₂ hf
    dsimp [f_pow] at hf
    rcases lt_trichotomy (i₁ : ℕ) (i₂ : ℕ) with hlt | heq | hgt
    · exfalso
      have h_add : (i₁ : ℕ) + ((i₂ : ℕ) - (i₁ : ℕ)) = (i₂ : ℕ) := Nat.add_sub_of_le hlt.le
      have h_mul : ϕ_τ₀ ^ (i₁ : ℕ) * ϕ_τ₀ ^ ((i₂ : ℕ) - (i₁ : ℕ)) = ϕ_τ₀ ^ (i₁ : ℕ) * 1 := by
        rw [← pow_add, h_add, mul_one, hf]
      have h_one : ϕ_τ₀ ^ ((i₂ : ℕ) - (i₁ : ℕ)) = 1 := mul_left_cancel h_mul
      exact h_ϕ_pow_ne_one ((i₂ : ℕ) - (i₁ : ℕ)) (by omega) (by omega) h_one
    · exact Fin.ext heq
    · exfalso
      have h_add : (i₂ : ℕ) + ((i₁ : ℕ) - (i₂ : ℕ)) = (i₁ : ℕ) := Nat.add_sub_of_le hgt.le
      have h_mul : ϕ_τ₀ ^ (i₂ : ℕ) * ϕ_τ₀ ^ ((i₁ : ℕ) - (i₂ : ℕ)) = ϕ_τ₀ ^ (i₂ : ℕ) * 1 := by
        rw [← pow_add, h_add, mul_one, hf]
      have h_one : ϕ_τ₀ ^ ((i₁ : ℕ) - (i₂ : ℕ)) = 1 := mul_left_cancel h_mul
      exact h_ϕ_pow_ne_one ((i₁ : ℕ) - (i₂ : ℕ)) (by omega) (by omega) h_one
  have hf₀_le_finrank : f₀ ≤ Module.finrank L U := by
    rw [← h_card_aut, ← Fintype.card_fin f₀]
    exact Fintype.card_le_of_injective f_pow hf_inj
  have h_τ₀_step : ∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ →
      (τ₀ ζ) ^ (qL F L) = ζ := by
    intro ζ hζ
    have h_eq := hτ₀Frob ζ hζ
    have h_neg : (-(-(resDeg F L : ℤ))).toNat = resDeg F L := by
      rw [neg_neg, Int.toNat_natCast]
    have h_pos : (-(resDeg F L : ℤ)).toNat = 0 := by omega
    rw [h_neg, h_pos, pow_zero, pow_one] at h_eq
    exact h_eq
  have h_τ₀_frob_pow : ∀ (ζ : AlgebraicClosure F), ζ ^ N = 1 →
      ∀ k : ℕ, ((τ₀ ^ k) ζ) ^ (qL F L ^ k) = ζ := by
    intro ζ hζN k
    induction k with
    | zero => rw [pow_zero, pow_zero, AlgEquiv.one_apply, pow_one]
    | succ k ih =>
      have h_p' : IsPrimeToPRootOfUnity F ((τ₀ ^ k) ζ) := by
        refine ⟨N, hN_pos, hpN, ?_⟩
        rw [← map_pow, hζN, map_one]
      rw [pow_succ', AlgEquiv.mul_apply, pow_succ', pow_mul, h_τ₀_step ((τ₀ ^ k) ζ) h_p', ih]
  have h_τ₀f₀_fix_U : ∀ x ∈ U, (τ₀ ^ f₀) x = x := by
    intro x hx
    induction hx using IntermediateField.adjoin_induction with
    | mem ζ hζ =>
      simp only [Set.mem_setOf_eq] at hζ
      have h_m := h_τ₀_frob_pow ζ hζ f₀
      have h_pow_N : ((τ₀ ^ f₀) ζ) ^ N = 1 := by
        rw [← map_pow, hζ, map_one]
      have hN1 : N + 1 = qL F L ^ f₀ := by omega
      calc (τ₀ ^ f₀) ζ = ((τ₀ ^ f₀) ζ) ^ N * (τ₀ ^ f₀) ζ := by rw [h_pow_N, one_mul]
        _ = ((τ₀ ^ f₀) ζ) ^ (N + 1) := (pow_succ _ N).symm
        _ = ((τ₀ ^ f₀) ζ) ^ (qL F L ^ f₀) := by rw [hN1]
        _ = ζ := h_m
    | algebraMap r =>
      have h_pow_L : ∀ k : ℕ, (τ₀ ^ k) (algebraMap L (AlgebraicClosure F) r) =
          algebraMap L (AlgebraicClosure F) r := by
        intro k
        induction k with
        | zero => rfl
        | succ k ih =>
          rw [pow_succ', AlgEquiv.mul_apply, ih]
          exact hτ₀L_fix r.1 r.2
      exact h_pow_L f₀
    | add a b _ _ ha hb => rw [map_add, ha, hb]
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
    | inv a _ ha => rw [map_inv₀, ha]
  have h_ϕ_f₀ : ϕ_τ₀ ^ f₀ = 1 := by
    ext x
    exact h_ϕ_pow f₀ x ▸ h_τ₀f₀_fix_U x.1 x.2
  let H_sub : Subgroup (U ≃ₐ[L] U) := Subgroup.zpowers ϕ_τ₀
  let F₀ : IntermediateField L U := IntermediateField.fixedField H_sub
  let A : IntermediateField L (AlgebraicClosure F) := F₀.map U.val
  have hA_le_U : A ≤ U := by
    rintro y ⟨x, _, rfl⟩
    exact x.2
  haveI : FiniteDimensional L A :=
    FiniteDimensional.of_injective (IntermediateField.inclusion hA_le_U).toLinearMap
      (IntermediateField.inclusion hA_le_U).injective
  haveI : FiniteDimensional F (A.restrictScalars F) := by
    change FiniteDimensional F A
    exact FiniteDimensional.trans F L A
  have hLA : L ≤ A.restrictScalars F := by
    intro x hx
    rw [IntermediateField.mem_restrictScalars]
    exact A.algebraMap_mem ⟨x, hx⟩
  have hτ₀A : τ₀ ∈ (A.restrictScalars F).fixingSubgroup := by
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro y hy
    rw [IntermediateField.mem_restrictScalars] at hy
    rcases hy with ⟨x, hxF₀, rfl⟩
    have hx_fix : ϕ_τ₀ x = x := hxF₀ ⟨ϕ_τ₀, Subgroup.mem_zpowers ϕ_τ₀⟩
    have h1 := (h_ϕ_apply x).symm
    rw [hx_fix] at h1
    exact h1
  have h_resA : resDeg F (A.restrictScalars F) ≤ resDeg F L :=
    le_of_eq (resDeg_eq_of_actsAsFrobPow_neg_resDeg_and_mem_fixingSubgroup F L
      (A.restrictScalars F) hLA τ₀ hτ₀Frob hτ₀A)
  have hA_bot : A = ⊥ := by
    have h_inf := inf_eq_bot_of_resDeg_le_and_finrank_mul_resDeg_le F L A U h_resA hB
    rwa [inf_of_le_left hA_le_U] at h_inf
  have hF₀_bot : F₀ = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    have hxA : (x : AlgebraicClosure F) ∈ A := ⟨x, hx, rfl⟩
    rw [hA_bot, IntermediateField.mem_bot] at hxA
    rcases hxA with ⟨c, hc⟩
    rw [IntermediateField.mem_bot]
    refine ⟨c, Subtype.ext hc⟩
  have hH_top : H_sub = ⊤ := by
    rw [← IntermediateField.fixingSubgroup_fixedField H_sub]
    change F₀.fixingSubgroup = ⊤
    rw [hF₀_bot, IntermediateField.fixingSubgroup_bot]
  have hf_surj : Function.Surjective f_pow := by
    intro g
    have hg : g ∈ H_sub := by
      rw [hH_top]
      exact Subgroup.mem_top g
    rw [Subgroup.mem_zpowers_iff] at hg
    rcases hg with ⟨r, rfl⟩
    have hm_pos_z : (0 : ℤ) < (f₀ : ℤ) := by omega
    let i_nat : ℕ := (r % (f₀ : ℤ)).toNat
    have hi_nonneg : 0 ≤ r % (f₀ : ℤ) := Int.emod_nonneg r (by omega)
    have hi_lt_z : r % (f₀ : ℤ) < (f₀ : ℤ) := Int.emod_lt_of_pos r hm_pos_z
    have hi_cast : (i_nat : ℤ) = r % (f₀ : ℤ) := Int.toNat_of_nonneg hi_nonneg
    have hi_lt : i_nat < f₀ := by omega
    refine ⟨⟨i_nat, hi_lt⟩, ?_⟩
    dsimp [f_pow]
    have hr_eq : r = (f₀ : ℤ) * (r / (f₀ : ℤ)) + (i_nat : ℤ) := by
      rw [hi_cast]
      exact (Int.mul_ediv_add_emod r (f₀ : ℤ)).symm
    have h_ϕ_m_z : ϕ_τ₀ ^ (f₀ : ℤ) = 1 := by
      rw [zpow_natCast, h_ϕ_f₀]
    rw [hr_eq, zpow_add, zpow_mul, h_ϕ_m_z, one_zpow, one_mul, zpow_natCast]
  have hfinrank_le_f₀ : Module.finrank L U ≤ f₀ := by
    rw [← h_card_aut, ← Fintype.card_fin f₀]
    exact Fintype.card_le_of_surjective f_pow hf_surj
  have h_finrank_U : Module.finrank L U = f₀ := le_antisymm hfinrank_le_f₀ hf₀_le_finrank
  let e_U : U ≃ₐ[L] IntermediateField.extendScalars hLE₀ :=
    IntermediateField.equivOfEq h_ext.symm
  have h_finrank_ext : Module.finrank L (IntermediateField.extendScalars hLE₀) = f₀ := by
    rw [← LinearEquiv.finrank_eq e_U.toLinearEquiv, h_finrank_U]
  let τ : AbsGal F := τ₀⁻¹
  have hτL : τ ∈ L.fixingSubgroup := Subgroup.inv_mem _ hτ₀L
  have hτL_fix : ∀ x ∈ L, τ x = x := by
    rwa [IntermediateField.mem_fixingSubgroup_iff] at hτL
  have h_p'_apply : ∀ (γ : AbsGal F) {ζ : AlgebraicClosure F},
      IsPrimeToPRootOfUnity F ζ → IsPrimeToPRootOfUnity F (γ ζ) := by
    intro γ ζ ⟨d, hd, hpd, hζd⟩
    exact ⟨d, hd, hpd, by rw [← map_pow, hζd, map_one]⟩
  have hτFrob : ∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ → τ ζ = ζ ^ qL F L := by
    intro ζ hζ
    have h_eq := h_τ₀_step (τ ζ) (h_p'_apply τ hζ)
    have happly : τ₀ (τ ζ) = ζ := AlgEquiv.apply_symm_apply τ₀ ζ
    rw [happly] at h_eq
    exact h_eq.symm
  have h_τ_pow : ∀ (j : ℕ) (ζ : AlgebraicClosure F),
      IsPrimeToPRootOfUnity F ζ → (τ ^ j) ζ = ζ ^ (qL F L ^ j) := by
    intro j
    induction j with
    | zero =>
      intro ζ _
      rw [pow_zero, pow_zero, AlgEquiv.one_apply, pow_one]
    | succ j ih =>
      intro ζ hζ
      rw [pow_succ', AlgEquiv.mul_apply, ih ζ hζ, map_pow, hτFrob ζ hζ, ← pow_mul, ← pow_succ']
  have h_σ_inv : ∀ ζ : AlgebraicClosure F,
      IsPrimeToPRootOfUnity F ζ → σ⁻¹ ζ = ζ ^ (qL F L ^ f₀) := by
    intro ζ hζ
    have h_eq := hσFrob (σ⁻¹ ζ) (h_p'_apply σ⁻¹ hζ)
    have happly : σ (σ⁻¹ ζ) = ζ := AlgEquiv.apply_symm_apply σ ζ
    have h_neg : (-(-((resDeg F L : ℤ) * (f₀ : ℤ)))).toNat = resDeg F L * f₀ := by
      rw [neg_neg, ← Nat.cast_mul, Int.toNat_natCast]
    have h_pos : (-((resDeg F L : ℤ) * (f₀ : ℤ))).toNat = 0 := by
      have h_nonneg : 0 ≤ (resDeg F L : ℤ) * (f₀ : ℤ) := by positivity
      omega
    have h_q : q F ^ (resDeg F L * f₀) = qL F L ^ f₀ := by
      dsimp [qL]
      exact pow_mul (q F) (resDeg F L) f₀
    rw [happly, h_neg, h_pos, pow_zero, pow_one, h_q] at h_eq
    exact h_eq.symm
  have hσE₀ : σ ∈ E₀.fixingSubgroup := by
    change σ ∈ (L ⊔ IntermediateField.adjoin F {ζ : AlgebraicClosure F | ζ ^ N = 1}).fixingSubgroup
    rw [IntermediateField.fixingSubgroup_sup, Subgroup.mem_inf]
    refine ⟨hσL, ?_⟩
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    induction hx using IntermediateField.adjoin_induction with
    | mem ζ hζ =>
      simp only [Set.mem_setOf_eq] at hζ
      have h_p' : IsPrimeToPRootOfUnity F ζ := ⟨N, hN_pos, hpN, hζ⟩
      have h_inv := h_σ_inv ζ h_p'
      have hN1 : N + 1 = qL F L ^ f₀ := by omega
      have h_pow : ζ ^ (qL F L ^ f₀) = ζ := by
        rw [← hN1, pow_succ, hζ, one_mul]
      rw [h_pow] at h_inv
      have happly : σ (σ⁻¹ ζ) = ζ := AlgEquiv.apply_symm_apply σ ζ
      rwa [h_inv] at happly
    | algebraMap r => exact AlgEquiv.commutes σ r
    | add a b _ _ ha hb => rw [map_add, ha, hb]
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
    | inv a _ ha => rw [map_inv₀, ha]
  have hτσ_unram : ∀ x ∈ unramSubring F L, (τ ^ f₀) x = σ⁻¹ x := by
    intro x hx
    have hτf₀_L : τ ^ f₀ ∈ L.fixingSubgroup := Subgroup.pow_mem _ hτL f₀
    have hσinv_L : σ⁻¹ ∈ L.fixingSubgroup := Subgroup.inv_mem _ hσL
    induction hx using Subring.closure_induction with
    | mem y hy =>
      rcases hy with ⟨c, _, rfl⟩ | hy_p'
      · have h1 : (τ ^ f₀) (algebraMap L (AlgebraicClosure F) c) =
            algebraMap L (AlgebraicClosure F) c :=
          (IntermediateField.mem_fixingSubgroup_iff L (τ ^ f₀)).mp hτf₀_L c.1 c.2
        have h2 : σ⁻¹ (algebraMap L (AlgebraicClosure F) c) =
            algebraMap L (AlgebraicClosure F) c :=
          (IntermediateField.mem_fixingSubgroup_iff L σ⁻¹).mp hσinv_L c.1 c.2
        rw [h1, h2]
      · rw [h_τ_pow f₀ y hy_p', h_σ_inv y hy_p']
    | zero => rw [map_zero, map_zero]
    | one => rw [map_one, map_one]
    | add a b _ _ ha hb => rw [map_add, map_add, ha, hb]
    | neg a _ ha => rw [map_neg, map_neg, ha]
    | mul a b _ _ ha hb => rw [map_mul, map_mul, ha, hb]
  let τ_L : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F :=
    { τ.toRingEquiv with
      commutes' := fun x => hτL_fix x.1 x.2 }
  let ϕ_τ : U ≃ₐ[L] U := AlgEquiv.restrictNormalHom U τ_L
  have h_ϕτ_apply : ∀ x : U, ((ϕ_τ x : U) : AlgebraicClosure F) = τ (x : AlgebraicClosure F) := by
    intro x
    exact AlgEquiv.restrictNormal_commutes τ_L U x
  have h_ϕτ_pow : ∀ (j : ℕ) (x : U),
      (((ϕ_τ ^ j) x : U) : AlgebraicClosure F) = (τ ^ j) (x : AlgebraicClosure F) := by
    intro j
    induction j with
    | zero => intro x; rfl
    | succ j ih =>
      intro x
      rw [pow_succ', pow_succ', AlgEquiv.mul_apply, AlgEquiv.mul_apply, h_ϕτ_apply, ih]
  have h_ϕτ_mul : ϕ_τ₀ * ϕ_τ = 1 := by
    ext x
    change ((ϕ_τ₀ (ϕ_τ x) : U) : AlgebraicClosure F) = (x : AlgebraicClosure F)
    rw [h_ϕ_apply, h_ϕτ_apply]
    exact AlgEquiv.apply_symm_apply τ₀ (x : AlgebraicClosure F)
  have h_ϕτ_eq_inv : ϕ_τ = ϕ_τ₀⁻¹ := eq_inv_of_mul_eq_one_right h_ϕτ_mul
  have h_ϕτ_pow_eq_inv : ∀ j : ℕ, ϕ_τ ^ j = (ϕ_τ₀ ^ j)⁻¹ := by
    intro j
    rw [h_ϕτ_eq_inv, inv_pow]
  have hτE₀ : ∀ x ∈ E₀, τ x ∈ E₀ := by
    intro x hx
    have hxU : x ∈ U := (IntermediateField.mem_restrictScalars F).mp (h_E₀_eq_U ▸ hx)
    have h1 := (h_ϕτ_apply ⟨x, hxU⟩).symm
    have hmemU : τ x ∈ U := h1 ▸ (ϕ_τ ⟨x, hxU⟩).2
    have hmemR : τ x ∈ U.restrictScalars F := (IntermediateField.mem_restrictScalars F).mpr hmemU
    rwa [← h_E₀_eq_U] at hmemR
  have hτf₀_E₀ : ∀ x ∈ E₀, (τ ^ f₀) x = x := by
    intro x hx
    have hxU : x ∈ U := (IntermediateField.mem_restrictScalars F).mp (h_E₀_eq_U ▸ hx)
    have h1 := (h_ϕτ_pow f₀ ⟨x, hxU⟩).symm
    have h_f₀_one : ϕ_τ ^ f₀ = 1 := by
      rw [h_ϕτ_pow_eq_inv f₀, h_ϕ_f₀, inv_one]
    rw [h_f₀_one, AlgEquiv.one_apply] at h1
    exact h1
  let e_aut : Fin f₀ ≃ (U ≃ₐ[L] U) :=
    (Equiv.ofBijective f_pow ⟨hf_inj, hf_surj⟩).trans (Equiv.inv (U ≃ₐ[L] U))
  have hτ_prod : ∀ x : E₀,
      ∏ j ∈ Finset.range f₀, (τ ^ j) (x : AlgebraicClosure F) =
        algebraMap L (AlgebraicClosure F) (normLM F hLE₀ x) := by
    intro x
    let x_U : U := ⟨x.1, (IntermediateField.mem_restrictScalars F).mp (h_E₀_eq_U ▸ x.2)⟩
    have h_norm_eq : normLM F hLE₀ x = Algebra.norm L x_U := by
      change Algebra.norm L (toExtendScalars F hLE₀ x) = Algebra.norm L x_U
      have h_to : toExtendScalars F hLE₀ x = e_U x_U := rfl
      rw [h_to, Algebra.norm_eq_of_algEquiv e_U x_U]
    have h_norm_prod : algebraMap L U (Algebra.norm L x_U) = ∏ g : U ≃ₐ[L] U, g x_U := by
      convert Algebra.norm_eq_prod_automorphisms L x_U
    have h_reindex : (∏ g : U ≃ₐ[L] U, g x_U) = ∏ j ∈ Finset.range f₀, (ϕ_τ ^ j) x_U := by
      rw [← e_aut.prod_comp (fun g : U ≃ₐ[L] U => g x_U)]
      have h_congr : (∏ i : Fin f₀, (e_aut i) x_U) = ∏ i : Fin f₀, (ϕ_τ ^ (i : ℕ)) x_U := by
        refine Finset.prod_congr rfl (fun i _ => ?_)
        change (ϕ_τ₀ ^ (i : ℕ))⁻¹ x_U = (ϕ_τ ^ (i : ℕ)) x_U
        rw [← h_ϕτ_pow_eq_inv (i : ℕ)]
      rw [h_congr, Fin.prod_univ_eq_prod_range (fun j : ℕ => (ϕ_τ ^ j) x_U) f₀]
    have h_val := congr_arg U.val (h_norm_prod.trans h_reindex)
    rw [map_prod] at h_val
    have h_lhs : U.val (algebraMap L U (Algebra.norm L x_U)) =
        algebraMap L (AlgebraicClosure F) (normLM F hLE₀ x) := by
      rw [← h_norm_eq]
      rfl
    have h_rhs : (∏ j ∈ Finset.range f₀, U.val ((ϕ_τ ^ j) x_U)) =
        ∏ j ∈ Finset.range f₀, (τ ^ j) (x : AlgebraicClosure F) := by
      refine Finset.prod_congr rfl (fun j _ => ?_)
      exact h_ϕτ_pow j x_U
    rw [h_lhs, h_rhs] at h_val
    exact h_val.symm
  have hτ_norm_coeff : ∀ (k : ℕ) (x : E₀),
      normLM F hLE₀ (relLubinTateCoeff F E₀ τ x k) = normLM F hLE₀ x := by
    intro k x
    let x_U : U := ⟨x.1, (IntermediateField.mem_restrictScalars F).mp (h_E₀_eq_U ▸ x.2)⟩
    have hk_U : (τ ^ k) (x : AlgebraicClosure F) ∈ U := by
      rw [← h_ϕτ_pow k x_U]
      exact ((ϕ_τ ^ k) x_U).2
    have hk_E₀ : (τ ^ k) (x : AlgebraicClosure F) ∈ E₀ := by
      rw [← h_ext] at hk_U
      exact (IntermediateField.mem_extendScalars hLE₀).mp hk_U
    have h_to_k : toExtendScalars F hLE₀ (relLubinTateCoeff F E₀ τ x k) = e_U ((ϕ_τ ^ k) x_U) := by
      apply Subtype.ext
      change (relLubinTateCoeff F E₀ τ x k : AlgebraicClosure F) =
        (((ϕ_τ ^ k) x_U : U) : AlgebraicClosure F)
      rw [relLubinTateCoeff, dif_pos hk_E₀, h_ϕτ_pow k x_U]
    change Algebra.norm L (toExtendScalars F hLE₀ (relLubinTateCoeff F E₀ τ x k)) =
      Algebra.norm L (toExtendScalars F hLE₀ x)
    have h_to_x : toExtendScalars F hLE₀ x = e_U x_U := rfl
    rw [h_to_k, h_to_x, Algebra.norm_eq_of_algEquiv e_U ((ϕ_τ ^ k) x_U),
      Algebra.norm_eq_of_algEquiv (ϕ_τ ^ k) x_U, Algebra.norm_eq_of_algEquiv e_U x_U]
  obtain ⟨ζ_u, u₁, hζ_pow, hu₁_val, hu_eq⟩ :=
    exists_pow_qL_sub_one_eq_one_and_valL_sub_one_of_valL_eq_zero F L u hu
  obtain ⟨ξ, hξ_norm⟩ :=
    exists_norm_unramifiedLevelField_eq_of_pow_qL_sub_one_eq_one F L f₀ hf₀ (ζ_u : L) hζ_pow
  obtain ⟨_, _, e₀, he₀_int, he₀_tr⟩ :=
    unramifiedLevelField_isGalois_and_exists_isIntegral_trace_eq_one F L f₀ hf₀
  obtain ⟨w, hw_norm⟩ :=
    exists_norm_eq_of_isIntegral_trace_eq_one_and_le_valL_sub_one F L U e₀ he₀_int he₀_tr u₁ hu₁_val
  let y : U := ξ * w
  have hy_norm : Algebra.norm L y = (u : L) := by
    change Algebra.norm L (ξ * w) = (u : L)
    rw [map_mul, hξ_norm, hw_norm, hu_eq, Units.val_mul]
  let y_E₀ : E₀ := ⟨(e_U y).1, (IntermediateField.mem_extendScalars hLE₀).mp (e_U y).2⟩
  have hy_E₀_norm : normLM F hLE₀ y_E₀ = (u : L) := by
    change Algebra.norm L (toExtendScalars F hLE₀ y_E₀) = (u : L)
    have h_to : toExtendScalars F hLE₀ y_E₀ = e_U y := rfl
    rw [h_to, Algebra.norm_eq_of_algEquiv e_U y, hy_norm]
  have hy_E₀_ne : y_E₀ ≠ 0 := by
    intro h0
    have hy0 : y = 0 := by
      apply e_U.injective
      rw [map_zero]
      change toExtendScalars F hLE₀ y_E₀ = 0
      rw [h0, map_zero]
    rw [hy0, Algebra.norm_zero] at hy_norm
    exact u.ne_zero hy_norm.symm
  let v : E₀ˣ := Units.mk0 y_E₀ hy_E₀_ne
  have hv_norm : Units.map (normLM F hLE₀) v = u := Units.ext hy_E₀_norm
  let π_L := chosenUniformizer F L
  let π_E₀ : E₀ˣ := Units.map (IntermediateField.inclusion hLE₀).toMonoidHom π_L
  let e_F : E₀ ≃ₐ[F] IntermediateField.extendScalars hLE₀ := {
    toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hLE₀).mpr z.2⟩
    invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hLE₀).mp z.2⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl
    map_mul' := fun _ _ => rfl
    map_add' := fun _ _ => rfl
    commutes' := fun _ => rfl
  }
  haveI : FiniteDimensional F (IntermediateField.extendScalars hLE₀) :=
    Module.Finite.equiv e_F.toLinearEquiv
  haveI : FiniteDimensional L (IntermediateField.extendScalars hLE₀) :=
    FiniteDimensional.right F L (IntermediateField.extendScalars hLE₀)
  have h_πE₀_norm : normLM F hLE₀ (π_E₀ : E₀) = (π_L : L) ^ f₀ := by
    change Algebra.norm L (toExtendScalars F hLE₀ (IntermediateField.inclusion hLE₀ (π_L : L))) =
      (π_L : L) ^ f₀
    have h_alg : toExtendScalars F hLE₀ (IntermediateField.inclusion hLE₀ (π_L : L)) =
        algebraMap L (IntermediateField.extendScalars hLE₀) (π_L : L) := rfl
    rw [h_alg, Algebra.norm_algebraMap, h_finrank_ext]
  have h_πE₀_map : Units.map (normLM F hLE₀) π_E₀ = π_L ^ (f₀ : ℤ) := by
    apply Units.ext
    change normLM F hLE₀ (π_E₀ : E₀) = ((π_L ^ (f₀ : ℤ) : Lˣ) : L)
    rw [h_πE₀_norm, zpow_natCast, Units.val_pow_eq_pow_val]
  have hϖ_norm : Units.map (normLM F hLE₀) (v * π_E₀) = u * π_L ^ (f₀ : ℤ) := by
    rw [map_mul, hv_norm, h_πE₀_map]
  have relVal_normLM : ∀ z : E₀, relVal F L (normLM F hLE₀ z) = relVal F E₀ z := by
    intro z
    change addVal F (Algebra.norm F (Algebra.norm L (e_F z))) = addVal F (Algebra.norm F z)
    rw [Algebra.norm_norm, Algebra.norm_eq_of_algEquiv e_F z]
  have h_rel_v : relVal F E₀ (v : E₀) = 0 := by
    have hv_norm_val : normLM F hLE₀ (v : E₀) = (u : L) := hy_E₀_norm
    rw [← relVal_normLM (v : E₀), hv_norm_val, relVal_eq_resDeg_mul_valL F L u, hu, mul_zero]
  have hv_val : valL F E₀ v = 0 := by
    unfold valL
    rw [h_rel_v, Int.zero_ediv]
  have h_rel_ϖ : (resDeg F E₀ : ℤ) * valL F E₀ ((v * π_E₀ : E₀ˣ) : E₀) =
      (resDeg F L : ℤ) * (f₀ : ℤ) := by
    rw [← relVal_eq_resDeg_mul_valL F E₀ (v * π_E₀), ← relVal_normLM ((v * π_E₀ : E₀ˣ) : E₀)]
    have h_norm_val : normLM F hLE₀ ((v * π_E₀ : E₀ˣ) : E₀) =
        ((u * π_L ^ (f₀ : ℤ) : Lˣ) : L) := congr_arg Units.val hϖ_norm
    rw [h_norm_val]
    exact (valL_and_relVal_unit_mul_chosenUniformizer_zpow F L u (f₀ : ℤ) hu).2
  have h_res_le : resDeg F L * f₀ ≤ resDeg F E₀ := by
    have hB' : Module.finrank L U * resDeg F L ≤ resDeg F E₀ := by
      rwa [← h_E₀_eq_U] at hB
    rw [h_finrank_U, mul_comm] at hB'
    exact hB'
  have h_res_le_z : (resDeg F L : ℤ) * (f₀ : ℤ) ≤ (resDeg F E₀ : ℤ) := by
    exact_mod_cast h_res_le
  have h_prod_pos : 0 < (resDeg F L : ℤ) * (f₀ : ℤ) :=
    mul_pos (Nat.cast_pos.mpr hresL_pos) (by omega)
  have h_resE₀_pos : 0 < (resDeg F E₀ : ℤ) := lt_of_lt_of_le h_prod_pos h_res_le_z
  have h_val_pos : 1 ≤ valL F E₀ ((v * π_E₀ : E₀ˣ) : E₀) := by
    by_contra hlt
    have hle : valL F E₀ ((v * π_E₀ : E₀ˣ) : E₀) ≤ 0 := by omega
    have h_nonpos : (resDeg F E₀ : ℤ) * valL F E₀ ((v * π_E₀ : E₀ˣ) : E₀) ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos (by positivity) hle
    linarith
  have h_val_le_one : valL F E₀ ((v * π_E₀ : E₀ˣ) : E₀) ≤ 1 := by
    by_contra hgt
    have hge : 2 ≤ valL F E₀ ((v * π_E₀ : E₀ˣ) : E₀) := by omega
    have h_mul_ge : (resDeg F E₀ : ℤ) * 2 ≤
        (resDeg F E₀ : ℤ) * valL F E₀ ((v * π_E₀ : E₀ˣ) : E₀) :=
      mul_le_mul_of_nonneg_left hge (le_of_lt h_resE₀_pos)
    linarith
  have hϖ_val : valL F E₀ ((v * π_E₀ : E₀ˣ) : E₀) = 1 := by omega
  have hres_E₀_z : (resDeg F E₀ : ℤ) = (resDeg F L : ℤ) * (f₀ : ℤ) := by
    rw [hϖ_val, mul_one] at h_rel_ϖ
    exact h_rel_ϖ
  have hres_E₀ : resDeg F E₀ = resDeg F L * f₀ := by exact_mod_cast hres_E₀_z
  exact ⟨hFin_E₀, hσE₀, hres_E₀, τ, v, hτL, hτFrob, hτσ_unram, hτE₀, hτf₀_E₀,
    hτ_prod, hτ_norm_coeff, hv_val, hv_norm, hϖ_val, hϖ_norm⟩

theorem relLubinTateDivPoly_monic_coeff_zero_and_irreducible (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E₀ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    [FiniteDimensional F E₀] (τ : AbsGal F) : (∀ x ∈ E₀, τ x ∈ E₀) →
    ∀ (ϖ : E₀ˣ), valL F E₀ ϖ = 1 → ∀ (m : ℕ), 1 ≤ m →
    let D_m := relLubinTateDivPoly F L E₀ τ (ϖ : E₀) m
    let F_m := relLubinTateIterPoly F L E₀ τ (ϖ : E₀) m
    D_m.Monic ∧
    D_m.natDegree = (qL F L - 1) * (qL F L) ^ (m - 1) ∧
    D_m.coeff 0 = relLubinTateCoeff F E₀ τ (ϖ : E₀) (m - 1) ∧
    valL F E₀ (D_m.coeff 0) = 1 ∧
    Irreducible D_m ∧
    F_m = relLubinTateIterPoly F L E₀ τ (ϖ : E₀) (m - 1) * D_m :=
by
  intro hτE₀ ϖ hϖ m hm
  have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
      0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
    intro a ha
    unfold addVal
    rw [dif_neg ha]
    set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    set va := valuation F a
    have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
    constructor
    · intro h_nonneg
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
      have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
      have h_iso : iso va ≤ iso 1 := by
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
        exact WithZero.coe_le_coe.mpr h_unzero
      exact (map_le_map_iff iso).mp h_iso
    · intro h_le
      have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
      rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
        Multiplicative.toAdd_le.mpr h_iso
      omega
  have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨c, hc⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F c) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hc]
      exact hg
    have hc0 : c ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 c hc0, ?_⟩
    simp only [Units.val_mk0, addVal, hc0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F c))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have hresL_pos : 0 < resDeg F L := by
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L u,
        (map_ne_zero (algebraMap F L)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (u : F)) = (u : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (u : F)
      have hpow : addVal F ((u : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F u := by
        change Multiplicative.toAdd (addValHom (u ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu, mul_one]
    exact (Nat.sInf_mem hS).1
  have hresL_ne : resDeg F L ≠ 0 := hresL_pos.ne'
  have hq_gt : 1 < q F := Finite.one_lt_card
  have hqL_gt : 1 < qL F L := one_lt_pow₀ hq_gt hresL_ne
  have hτ_pow : ∀ (j : ℕ) (x : AlgebraicClosure F), x ∈ E₀ → (τ ^ j) x ∈ E₀ := by
    intro j
    induction j with
    | zero =>
      intro x hx
      simpa using hx
    | succ j ih =>
      intro x hx
      rw [pow_succ', AlgEquiv.mul_apply]
      exact hτE₀ _ (ih x hx)
  have hϖ_j : ∀ j : ℕ, valL F E₀ (relLubinTateCoeff F E₀ τ (ϖ : E₀) j) = 1 := by
    intro j
    let ϕ_j : E₀ →ₐ[F] E₀ := {
      toFun := fun x => ⟨(τ ^ j) (x : AlgebraicClosure F), hτ_pow j x.1 x.2⟩
      map_one' := Subtype.ext (map_one (τ ^ j))
      map_mul' := fun x y => Subtype.ext (map_mul (τ ^ j) x.1 y.1)
      map_zero' := Subtype.ext (map_zero (τ ^ j))
      map_add' := fun x y => Subtype.ext (map_add (τ ^ j) x.1 y.1)
      commutes' := fun r => Subtype.ext ((τ ^ j).commutes r)
    }
    have h_inj : Function.Injective ϕ_j := ϕ_j.toRingHom.injective
    have h_surj : Function.Surjective ϕ_j :=
      LinearMap.surjective_of_injective (f := ϕ_j.toLinearMap) h_inj
    let e_j : E₀ ≃ₐ[F] E₀ := AlgEquiv.ofBijective ϕ_j ⟨h_inj, h_surj⟩
    have h_coeff_eq : relLubinTateCoeff F E₀ τ (ϖ : E₀) j = e_j (ϖ : E₀) := by
      dsimp [relLubinTateCoeff]
