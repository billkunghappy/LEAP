          rw [h_sum_zero, zero_div]
          exact isIntegral_zero
        have h_res_i₀ := hP3 a h_div_int i₀
        have ha_i₀ : a i₀ = 1 := Subtype.ext (div_self hci₀)
        rw [ha_i₀, map_one] at h_res_i₀
        exact one_ne_zero h_res_i₀
      have hcard := hli.fintype_card_le_finrank
      rwa [Fintype.card_fin] at hcard
    have h_step : ∀ (r : ℕ) (ω : Fin r → L), P1 r ω → P3 r ω → ¬ P2 r ω →
        ∃ ω' : Fin (r + 1) → L, P1 (r + 1) ω' ∧ P3 (r + 1) ω' := by
