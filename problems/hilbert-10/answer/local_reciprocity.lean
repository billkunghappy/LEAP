theorem valL_add_of_lt_and_valL_galApply_pow_coprime_eq (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (hLM : L ≤ M)
    (π_M : M) :
    valL F M π_M = 1 →
    (∀ τ : (IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM),
      τ ≠ 1 → galApply F hLM τ π_M ≠ π_M ∧ 1 ≤ valL F M (galApply F hLM τ π_M - π_M) ∧
        ∀ b : M, (b = 0 ∨ 0 ≤ valL F M b) →
          galApply F hLM τ b = b ∨
            valL F M (galApply F hLM τ π_M - π_M) ≤ valL F M (galApply F hLM τ b - b)) →
    let Gbar := (IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM)
    Nat.Prime (p F) ∧
    ((p F : M) = 0 ∨ 1 ≤ valL F M (p F : M)) ∧
    (valL F M 0 = 0 ∧ valL F M 1 = 0) ∧
    (∀ {x y : M}, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
    (∀ {x : M}, x ≠ 0 → valL F M x⁻¹ = -valL F M x) ∧
    (∀ (τ : Gbar) (x : M), valL F M (galApply F hLM τ x) = valL F M x) ∧
    (∀ (k : ℤ) {x y : M}, (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
      (x + y = 0 ∨ k ≤ valL F M (x + y)) ∧ (x - y = 0 ∨ k ≤ valL F M (x - y))) ∧
    (∀ (k : ℤ) {x y : M}, x ≠ 0 → valL F M x = k → (y = 0 ∨ k + 1 ≤ valL F M y) →
      x + y ≠ 0 ∧ valL F M (x + y) = k) ∧
    (∀ (τ : Gbar), τ ≠ 1 → ∀ (μ : ℤ) (x : M), (x = 0 ∨ μ ≤ valL F M x) →
      galApply F hLM τ x - x = 0 ∨
        μ + (valL F M (galApply F hLM τ π_M - π_M) - 1) ≤ valL F M (galApply F hLM τ x - x)) ∧
    (∀ (τ : Gbar), 2 ≤ valL F M (galApply F hLM τ π_M - π_M) →
      ∀ (c : ℕ), 1 ≤ c → ¬ (p F ∣ c) →
        galApply F hLM (τ ^ c) π_M ≠ π_M ∧
        valL F M (galApply F hLM (τ ^ c) π_M - π_M) = valL F M (galApply F hLM τ π_M - π_M)) ∧
    (∀ (τ : Gbar), 2 ≤ valL F M (galApply F hLM τ π_M - π_M) → τ ^ (p F) ≠ 1 →
      valL F M (galApply F hLM τ π_M - π_M) + 1 ≤
        valL F M (galApply F hLM (τ ^ (p F)) π_M - π_M)) :=
by
