      have h_int_fix : ∀ x : E, V 0 x → galApply F hLE σ x = x := by
        intro x hx
        let M₀ : ℕ := (valL F E (galApply F hLE σ x - x)).toNat + 1
        have h_π : V (M₀ : ℤ) (galApply F hLE σ π_E - π_E) :=
          Or.inl (sub_eq_zero.mpr h_fix)
        have h_x := h_ind σ M₀ h_π M₀ (le_refl _) x hx
        rcases h_x with h_zero | h_le
        · exact sub_eq_zero.mp h_zero
        · exfalso
          omega
      have h_all_fix : ∀ y : E, galApply F hLE σ y = y := by
        intro y
        by_cases hy : V 0 y
        · exact h_int_fix y hy
        · have hy_ne : y ≠ 0 := fun h0 => hy (Or.inl h0)
          have hy_lt : valL F E y < 0 := by
            by_contra h_ge
            exact hy (Or.inr (by omega))
          have hy_inv_V0 : V 0 (y⁻¹) := by
            right
            rw [valL_inv hy_ne]
            omega
          have h_inv_fix := h_int_fix (y⁻¹) hy_inv_V0
          rw [galApply_inv] at h_inv_fix
          exact inv_inj.mp h_inv_fix
      apply hσ
      ext ⟨w, hw⟩
      have hwE : w ∈ E := (IntermediateField.mem_extendScalars hLE).mp hw
      have h_eq := h_all_fix ⟨w, hwE⟩
      exact congrArg Subtype.val h_eq
    have hπ_val_ge_one : 1 ≤ valL F E (galApply F hLE σ π_E - π_E) := by
      have h_V1 : V 1 (galApply F hLE σ π_E - π_E) :=
        hV_sub 1 (hV_gal 1 σ hπ_E_V1) hπ_E_V1
      rcases h_V1 with h_zero | h_ge
      · exfalso
        exact hπ_ne (sub_eq_zero.mp h_zero)
      · exact h_ge
    refine ⟨hπ_ne, hπ_val_ge_one, ?_⟩
    intro b hb
    set v_σ : ℤ := valL F E (galApply F hLE σ π_E - π_E)
    let M₀ : ℕ := v_σ.toNat
    have hM₀_eq : (M₀ : ℤ) = v_σ := Int.toNat_of_nonneg (by omega)
    have h_π : V (M₀ : ℤ) (galApply F hLE σ π_E - π_E) := by
      right
      rw [hM₀_eq]
    have h_b := h_ind σ M₀ h_π M₀ (le_refl _) b hb
    change galApply F hLE σ b - b = 0 ∨ (M₀ : ℤ) ≤ valL F E (galApply F hLE σ b - b) at h_b
    rw [sub_eq_zero, hM₀_eq] at h_b
    exact h_b

theorem exists_surjective_galRestrict_and_prod_eq_map_minpoly (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
    (hLM : L ≤ M) (hME : M ≤ E) :
    IsAbelianExt F (hLM.trans hME) → resDeg F E = resDeg F L →
    ∀ (π_E : E), (∀ τ : (IntermediateField.extendScalars (hLM.trans hME)) ≃ₐ[L]
        (IntermediateField.extendScalars (hLM.trans hME)),
      galApply F (hLM.trans hME) τ π_E = π_E → τ = 1) →
    let hLE := hLM.trans hME
    let E_L := IntermediateField.extendScalars hLE
    let M_L := IntermediateField.extendScalars hLM
    let G := E_L ≃ₐ[L] E_L
    let Gbar := M_L ≃ₐ[L] M_L
    resDeg F M = resDeg F L ∧
    ∃ (res : G →* Gbar) (H : Finset G) (P_M : Polynomial M),
      Function.Surjective res ∧
      (∀ τ : G, τ ∈ H ↔ res τ = 1) ∧
      (∀ (σ : G) (y : M),
        galApply F hLE σ (IntermediateField.inclusion hME y) =
          IntermediateField.inclusion hME (galApply F hLM (res σ) y)) ∧
      Module.finrank L E_L = H.card * Module.finrank L M_L ∧
      (∀ y : M, y ≠ 0 →
        valL F E (IntermediateField.inclusion hME y) = (H.card : ℤ) * valL F M y) ∧
      P_M.Monic ∧ P_M.natDegree = H.card ∧
      P_M.map (IntermediateField.inclusion hME).toRingHom =
        ∏ τ ∈ H, (Polynomial.X - Polynomial.C (galApply F hLE τ π_E)) :=
by
  intro hab hres π_E hπ_inj
  dsimp only
  let hLE := hLM.trans hME
  let E_L := IntermediateField.extendScalars hLE
  let M_L := IntermediateField.extendScalars hLM
  let G := E_L ≃ₐ[L] E_L
  let Gbar := M_L ≃ₐ[L] M_L
  let M_E : IntermediateField M (AlgebraicClosure F) := IntermediateField.extendScalars hME
  haveI : FiniteDimensional F E_L := ‹FiniteDimensional F E›
  haveI : FiniteDimensional F L := FiniteDimensional.left F L E_L
  haveI : FiniteDimensional L E_L := FiniteDimensional.right F L E_L
  haveI : FiniteDimensional F M_E := ‹FiniteDimensional F E›
  haveI : FiniteDimensional F M := FiniteDimensional.left F M M_E
  haveI : FiniteDimensional M M_E := FiniteDimensional.right F M M_E
  haveI : FiniteDimensional F M_L := ‹FiniteDimensional F M›
  haveI : FiniteDimensional L M_L := FiniteDimensional.right F L M_L
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab_ne : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab_ne, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  have addVal_pow : ∀ (u : Fˣ) (n : ℕ), addVal F ((u : F) ^ n) = (n : ℤ) * addVal F u := by
    intro u n
    change Multiplicative.toAdd (addValHom (u ^ n)) = _
    rw [map_pow, toAdd_pow, nsmul_eq_mul]
    rfl
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K],
      0 < resDeg F K ∧ ∃ π : Kˣ, relVal F K π = resDeg F K := by
    intro K _
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : K, z ≠ 0 ∧ relVal F K z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F K, Module.finrank_pos, algebraMap F K u,
        (map_ne_zero (algebraMap F K)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F K (u : F)) = (u : F) ^ Module.finrank F K :=
        Algebra.norm_algebraMap (u : F)
      rw [relVal, hnorm, addVal_pow, hu, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  have resDeg_mono : ∀ {E₁ E₂ : IntermediateField F (AlgebraicClosure F)} (h : E₁ ≤ E₂)
      [FiniteDimensional F E₂], resDeg F E₁ ≤ resDeg F E₂ := by
    intro E₁ E₂ h _
    let K : IntermediateField E₁ (AlgebraicClosure F) := IntermediateField.extendScalars h
    haveI : FiniteDimensional F K := ‹FiniteDimensional F E₂›
    haveI : FiniteDimensional F E₁ := FiniteDimensional.left F E₁ K
    haveI : FiniteDimensional E₁ K := FiniteDimensional.right F E₁ K
    obtain ⟨hpos₂, π₂, hπ₂⟩ := resDeg_mem E₂
    let y : K := toExtendScalars F h (π₂ : E₂)
    have hy0 : y ≠ 0 := (map_ne_zero (toExtendScalars F h)).mpr π₂.ne_zero
    let x : E₁ := Algebra.norm E₁ y
    have hx0 : x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy0
    have hnorm : Algebra.norm F x = Algebra.norm F (π₂ : E₂) :=
      @Algebra.norm_norm F E₁ _ _ _ _ K _ _ _ _ _ y
    have hrel : relVal F E₁ x = (resDeg F E₂ : ℤ) := by
      rw [relVal, hnorm]
      exact hπ₂
    exact Nat.sInf_le ⟨hpos₂, x, hx0, hrel⟩
  have hres_LM : resDeg F L ≤ resDeg F M := resDeg_mono hLM
  have hres_ME : resDeg F M ≤ resDeg F E := resDeg_mono hME
  have hres_M : resDeg F M = resDeg F L := by omega
  have hres_EM : resDeg F E = resDeg F M := hres.trans hres_M.symm
  have relVal_eq_resDeg_mul_valL_aux :
      ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K] (x : Kˣ),
        relVal F K x = (resDeg F K : ℤ) * valL F K x := by
    intro K _ x
    let relValHom : Kˣ →* Multiplicative ℤ :=
      addValHom.comp (Units.map (Algebra.norm F))
    have relValHom_apply : ∀ u : Kˣ, Multiplicative.toAdd (relValHom u) = relVal F K u :=
      fun _ => rfl
    have relVal_units_mul : ∀ u v : Kˣ,
        relVal F K ((u * v : Kˣ) : K) = relVal F K u + relVal F K v := by
      intro u v
      rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
    have relVal_units_zpow : ∀ (u : Kˣ) (k : ℤ),
        relVal F K ((u ^ k : Kˣ) : K) = k * relVal F K u := by
      intro u k
      rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
      rfl
    obtain ⟨hf, π, hπ⟩ := resDeg_mem K
    let q := relVal F K x / (resDeg F K : ℤ)
    let r := relVal F K x % (resDeg F K : ℤ)
    have hdiv : r + (resDeg F K : ℤ) * q = relVal F K x := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r := Int.emod_nonneg _ (by positivity)
    have hrlt : r < (resDeg F K : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F K ((x * π ^ (-q) : Kˣ) : K) = r := by
      rw [relVal_units_mul, relVal_units_zpow, hπ]
      linarith
    have hr_eq : r = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : K, z ≠ 0 ∧ relVal F K z = k} := by
        refine ⟨hr_pos, ((x * π ^ (-q) : Kˣ) : K), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F K ≤ r.toNat := Nat.sInf_le hmem
      omega
    change relVal F K x = (resDeg F K : ℤ) * q
    linarith
  have h_val_dME : ∀ y : M, y ≠ 0 →
      valL F E (IntermediateField.inclusion hME y) =
        (Module.finrank M M_E : ℤ) * valL F M y := by
    intro y hy
    let y_E : E := IntermediateField.inclusion hME y
    have hy_E_ne : y_E ≠ 0 := (map_ne_zero (IntermediateField.inclusion hME)).mpr hy
    let y_ME : M_E := algebraMap M M_E y
    have hnorm : Algebra.norm F y_ME = (Algebra.norm F y) ^ Module.finrank M M_E := by
      calc Algebra.norm F y_ME
        _ = Algebra.norm F (Algebra.norm M (algebraMap M M_E y)) :=
            (@Algebra.norm_norm F M _ _ _ _ M_E _ _ _ _ _ y_ME).symm
        _ = Algebra.norm F (y ^ Module.finrank M M_E) := by
            rw [Algebra.norm_algebraMap]
        _ = (Algebra.norm F y) ^ Module.finrank M M_E :=
            map_pow (Algebra.norm F) y (Module.finrank M M_E)
    let u_M : Mˣ := Units.mk0 y hy
    let u_F : Fˣ := Units.map (Algebra.norm F) u_M
    have hu_F : (u_F : F) = Algebra.norm F y := rfl
    have hrel_eq : relVal F E y_E = (Module.finrank M M_E : ℤ) * relVal F M y := by
      change addVal F (Algebra.norm F y_ME) = _
      rw [hnorm, ← hu_F, addVal_pow, hu_F]
      rfl
    let u_E : Eˣ := Units.mk0 y_E hy_E_ne
    have hrel_E : relVal F E y_E = (resDeg F E : ℤ) * valL F E y_E :=
      relVal_eq_resDeg_mul_valL_aux E u_E
    have hrel_M : relVal F M y = (resDeg F M : ℤ) * valL F M y :=
      relVal_eq_resDeg_mul_valL_aux M u_M
    rw [hrel_E, hrel_M, hres_EM] at hrel_eq
    have hpos_M : (resDeg F M : ℤ) ≠ 0 := by
      have h1 := (resDeg_mem M).1
      omega
    apply mul_left_cancel₀ hpos_M
    linarith
  have h_comm_M : ∀ γ ∈ L.fixingSubgroup, ∀ ρ ∈ L.fixingSubgroup,
      γ * ρ * γ⁻¹ * ρ⁻¹ ∈ M.fixingSubgroup :=
    fun γ hγ ρ hρ => IntermediateField.fixingSubgroup_le hME (hab.2.1 γ hγ ρ hρ)
  have h_norm_M : ∀ γ ∈ L.fixingSubgroup, ∀ ρ ∈ M.fixingSubgroup,
      γ * ρ * γ⁻¹ ∈ M.fixingSubgroup := by
    intro γ hγ ρ hρ
    have hρL : ρ ∈ L.fixingSubgroup := IntermediateField.fixingSubgroup_le hLM hρ
    have hc := M.fixingSubgroup.mul_mem (h_comm_M γ hγ ρ hρL) hρ
    rwa [inv_mul_cancel_right] at hc
  have h_ext_le : M_L ≤ E_L := fun x hx =>
    (IntermediateField.mem_extendScalars hLE).mpr
      (hME ((IntermediateField.mem_extendScalars hLM).mp hx))
  have h_sep_M : Algebra.IsSeparable L M_L := by
    haveI : Algebra.IsSeparable L E_L := hab.2.2
    exact Algebra.IsSeparable.of_algHom L _ (IntermediateField.inclusion h_ext_le)
  have hab_M : IsAbelianExt F hLM := ⟨h_norm_M, h_comm_M, h_sep_M⟩
  have h_normal_of_abelian : ∀ (K : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F K] (hLK : L ≤ K),
      IsAbelianExt F hLK → Normal L (IntermediateField.extendScalars hLK) := by
    intro K _ hLK hab_K
    let K_L := IntermediateField.extendScalars hLK
    haveI : Algebra.IsAlgebraic L (AlgebraicClosure F) :=
      Algebra.IsAlgebraic.tower_top (K := F) L
    haveI : Normal L (AlgebraicClosure F) :=
      Normal.tower_top_of_normal F L (AlgebraicClosure F)
    haveI : Algebra.IsSeparable L K_L := hab_K.2.2
    have hstab : ∀ γ : AbsGal F, γ ∈ L.fixingSubgroup → ∀ y ∈ K, γ y ∈ K := by
      intro γ hγL y hy
      set z := γ y
      haveI : Algebra.IsAlgebraic K_L (AlgebraicClosure F) :=
        Algebra.IsAlgebraic.tower_top (K := L) K_L
      haveI : Normal K_L (AlgebraicClosure F) :=
        Normal.tower_top_of_normal L K_L (AlgebraicClosure F)
      have hz_alg : IsAlgebraic K_L z := Algebra.IsAlgebraic.isAlgebraic z
      have hz_int : IsIntegral K_L z := hz_alg.isIntegral
      let y_L : K_L := ⟨y, (IntermediateField.mem_extendScalars hLK).mpr hy⟩
      have hy_sep : (minpoly L y).Separable := by
        have h1 : (minpoly L y_L).Separable := Algebra.IsSeparable.isSeparable L y_L
        rwa [IntermediateField.minpoly_eq y_L] at h1
      let γ_L : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F := L.fixingSubgroupEquiv ⟨γ, hγL⟩
      have hz_eq : γ_L y = z := rfl
      have hz_sep_L : (minpoly L z).Separable := by
        rw [← hz_eq, minpoly.algEquiv_eq γ_L y]
        exact hy_sep
      have h_aeval_map :
          Polynomial.aeval z (Polynomial.map (algebraMap L K_L) (minpoly L z)) = 0 := by
        rw [Polynomial.aeval_map_algebraMap K_L z (minpoly L z), minpoly.aeval L z]
      have hP_dvd : minpoly K_L z ∣ Polynomial.map (algebraMap L K_L) (minpoly L z) :=
        minpoly.dvd K_L z h_aeval_map
      have hP_sep : (minpoly K_L z).Separable :=
        Polynomial.Separable.of_dvd (Polynomial.Separable.map hz_sep_L) hP_dvd
      have h_root_eq : ∀ w ∈ (minpoly K_L z).rootSet (AlgebraicClosure F), w = z := by
        intro w hw
        have hw_aeval : Polynomial.aeval w (minpoly K_L z) = 0 := (Polynomial.mem_rootSet.mp hw).2
        have h_mp : minpoly K_L z = minpoly K_L w :=
          minpoly.eq_of_irreducible_of_monic (minpoly.irreducible hz_int) hw_aeval
            (minpoly.monic hz_int)
        let e_zw := minpoly.algEquiv hz_alg h_mp
        let τ_K : AlgebraicClosure F ≃ₐ[K_L] AlgebraicClosure F :=
          e_zw.liftNormal (AlgebraicClosure F)
        have hτ_z : τ_K z = w := by
          have h1 := AlgEquiv.liftNormal_commutes e_zw (AlgebraicClosure F)
            (IntermediateField.AdjoinSimple.gen K_L z)
          have h2 : e_zw (IntermediateField.AdjoinSimple.gen K_L z) =
              IntermediateField.AdjoinSimple.gen K_L w :=
            minpoly.algEquiv_apply hz_alg h_mp
          rw [h2] at h1
          exact h1
        let τ : AbsGal F :=
          { toRingEquiv := τ_K.toRingEquiv
            commutes' := fun r => by
              rw [IsScalarTower.algebraMap_apply F L (AlgebraicClosure F),
                IsScalarTower.algebraMap_apply L K_L (AlgebraicClosure F)]
              exact τ_K.commutes _ }
        have hτK : τ ∈ K.fixingSubgroup := by
          rw [IntermediateField.mem_fixingSubgroup_iff]
          intro u hu
          let u_K : K_L := ⟨u, (IntermediateField.mem_extendScalars hLK).mpr hu⟩
          exact τ_K.commutes u_K
        have h_conj : γ⁻¹ * τ * (γ⁻¹)⁻¹ ∈ K.fixingSubgroup :=
          hab_K.1 γ⁻¹ (Subgroup.inv_mem _ hγL) τ hτK
        have h_fix : (γ⁻¹ * τ * (γ⁻¹)⁻¹) y = y :=
          (IntermediateField.mem_fixingSubgroup_iff K _).mp h_conj y hy
        rw [inv_inv, AlgEquiv.mul_apply, AlgEquiv.mul_apply] at h_fix
        have h_ap : γ (γ⁻¹ (τ z)) = z := congrArg γ h_fix
        have h_inv : γ (γ⁻¹ (τ z)) = τ z := AlgEquiv.apply_symm_apply γ (τ z)
        rw [h_inv] at h_ap
        exact hτ_z.symm.trans h_ap
      have h_sub : Subsingleton ↥((minpoly K_L z).rootSet (AlgebraicClosure F)) :=
        ⟨fun ⟨a, ha⟩ ⟨b, hb⟩ => Subtype.ext ((h_root_eq a ha).trans (h_root_eq b hb).symm)⟩
      have h_card_le : Fintype.card ↥((minpoly K_L z).rootSet (AlgebraicClosure F)) ≤ 1 :=
        Fintype.card_le_one_iff_subsingleton.mpr h_sub
      have h_card_eq : Fintype.card ↥((minpoly K_L z).rootSet (AlgebraicClosure F)) =
          (minpoly K_L z).natDegree :=
        Polynomial.card_rootSet_eq_natDegree hP_sep (IsAlgClosed.splits _)
      have h_deg_pos : 0 < (minpoly K_L z).natDegree := minpoly.natDegree_pos hz_int
      have h_deg_one : (minpoly K_L z).natDegree = 1 := by omega
      obtain ⟨u, hu⟩ := minpoly.natDegree_eq_one_iff.mp h_deg_one
      have hz_mem_KL : z ∈ K_L := by
        rw [← hu]
        exact u.2
      exact (IntermediateField.mem_extendScalars hLK).mp hz_mem_KL
    rw [IntermediateField.normal_iff_forall_map_le]
    intro ψ
    let ψ_equiv : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F :=
      AlgEquiv.ofBijective ψ (Algebra.IsAlgebraic.algHom_bijective ψ)
    let γ_sub := L.fixingSubgroupEquiv.symm ψ_equiv
    intro z hz
    rcases hz with ⟨y, hy, rfl⟩
    have hyK : y ∈ K := (IntermediateField.mem_extendScalars hLK).mp hy
    have hmem : (γ_sub : AbsGal F) y ∈ K_L :=
      (IntermediateField.mem_extendScalars hLK).mpr (hstab γ_sub.1 γ_sub.2 y hyK)
    exact hmem
  haveI : Normal L E_L := h_normal_of_abelian E hLE hab
  haveI : Algebra.IsSeparable L E_L := hab.2.2
  haveI : IsGalois L E_L := IsGalois.mk
  haveI : Normal L M_L := h_normal_of_abelian M hLM hab_M
  haveI : Algebra.IsSeparable L M_L := hab_M.2.2
  haveI : IsGalois L M_L := IsGalois.mk
  obtain ⟨res, hres_surj, hres_comm⟩ :
      ∃ res : G →* Gbar, Function.Surjective res ∧
        ∀ (σ : G) (y : M),
          galApply F hLE σ (IntermediateField.inclusion hME y) =
            IntermediateField.inclusion hME (galApply F hLM (res σ) y) := by
    letI algML_EL : Algebra M_L E_L := (IntermediateField.inclusion h_ext_le).toRingHom.toAlgebra
    letI smulML_EL : SMul M_L E_L := algML_EL.toSMul
    haveI : IsScalarTower L M_L E_L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    refine ⟨AlgEquiv.restrictNormalHom M_L, AlgEquiv.restrictNormalHom_surjective E_L, ?_⟩
    intro σ y
    let y_ML : M_L := ⟨y.1, (IntermediateField.mem_extendScalars hLM).mpr y.2⟩
    have h_comm := AlgEquiv.restrictNormal_commutes σ M_L y_ML
    ext
    exact (congrArg Subtype.val h_comm).symm
  obtain ⟨H, hH, h_card_ker⟩ :
      ∃ H : Finset G, (∀ τ : G, τ ∈ H ↔ res τ = 1) ∧ Nat.card ↥res.ker = H.card := by
    letI : Fintype G := AlgEquiv.fintype L E_L
    refine ⟨Finset.univ.filter (fun τ : G => res τ = 1), fun τ => by simp, ?_⟩
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
    congr 1
    ext τ
    simp
  have h_card_quot : Nat.card (G ⧸ res.ker) = Nat.card Gbar :=
    Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective res hres_surj).toEquiv
  have h_finrank_eq : Module.finrank L E_L = H.card * Module.finrank L M_L := by
    calc Module.finrank L E_L
      _ = Nat.card G := (IsGalois.card_aut_eq_finrank L E_L).symm
      _ = Nat.card (G ⧸ res.ker) * Nat.card ↥res.ker :=
          Subgroup.card_eq_card_quotient_mul_card_subgroup res.ker
      _ = Nat.card Gbar * H.card := by rw [h_card_quot, h_card_ker]
      _ = Module.finrank L M_L * H.card := by rw [IsGalois.card_aut_eq_finrank L M_L]
      _ = H.card * Module.finrank L M_L := mul_comm _ _
  have h_tower_LE : Module.finrank F L * Module.finrank L E_L = Module.finrank F E :=
    Module.finrank_mul_finrank F L E_L
  have h_tower_LM : Module.finrank F L * Module.finrank L M_L = Module.finrank F M :=
    Module.finrank_mul_finrank F L M_L
  have h_tower_ME : Module.finrank F M * Module.finrank M M_E = Module.finrank F E :=
    Module.finrank_mul_finrank F M M_E
  have h_dME_eq : Module.finrank M M_E = H.card := by
    have h1 : Module.finrank F M * Module.finrank M M_E = Module.finrank F M * H.card := by
      calc Module.finrank F M * Module.finrank M M_E
        _ = Module.finrank F E := h_tower_ME
        _ = Module.finrank F L * Module.finrank L E_L := h_tower_LE.symm
        _ = Module.finrank F L * (H.card * Module.finrank L M_L) := by rw [h_finrank_eq]
        _ = (Module.finrank F L * Module.finrank L M_L) * H.card := by ring
        _ = Module.finrank F M * H.card := by rw [h_tower_LM]
    exact Nat.eq_of_mul_eq_mul_left Module.finrank_pos h1
  have h_val_scale : ∀ y : M, y ≠ 0 →
      valL F E (IntermediateField.inclusion hME y) = (H.card : ℤ) * valL F M y := by
    intro y hy
    rw [h_val_dME y hy, h_dME_eq]
  obtain ⟨P_M, hPM_monic, hPM_deg_le, h_eval₂⟩ :
      ∃ P_M : Polynomial M, P_M.Monic ∧ P_M.natDegree ≤ H.card ∧
        Polynomial.eval₂ (IntermediateField.inclusion hME).toRingHom π_E P_M = 0 := by
    let π_ME : M_E := ⟨π_E.1, (IntermediateField.mem_extendScalars hME).mpr π_E.2⟩
    have hπ_int : IsIntegral M π_ME := Algebra.IsIntegral.isIntegral π_ME
    refine ⟨minpoly M π_ME, minpoly.monic hπ_int,
      (minpoly.natDegree_le π_ME).trans h_dME_eq.le, ?_⟩
    have h1 := minpoly.aeval M π_ME
    rw [Polynomial.aeval_def] at h1
    let j : M_E →+* E :=
      { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hME).mp z.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hj_comp : j.comp (algebraMap M M_E) = (IntermediateField.inclusion hME).toRingHom := rfl
    have hj_π : j π_ME = π_E := Subtype.ext rfl
    rw [← hj_comp, ← hj_π, ← Polynomial.hom_eval₂ (minpoly M π_ME) (algebraMap M M_E) j π_ME,
      h1, map_zero]
  have hQ_monic :
      (∏ τ ∈ H, (Polynomial.X - Polynomial.C (galApply F hLE τ π_E))).Monic :=
    Polynomial.monic_prod_of_monic H _ (fun τ _ => Polynomial.monic_X_sub_C _)
  have hQ_deg :
      (∏ τ ∈ H, (Polynomial.X - Polynomial.C (galApply F hLE τ π_E))).natDegree = H.card := by
    rw [Polynomial.natDegree_prod_of_monic H _ (fun τ _ => Polynomial.monic_X_sub_C _)]
    simp
  let ϕ_σ : G → (E →+* E) := fun σ =>
    { toFun := galApply F hLE σ
      map_one' := Subtype.ext (congrArg Subtype.val (map_one σ))
      map_mul' := fun a b => Subtype.ext (congrArg Subtype.val (map_mul σ _ _))
      map_zero' := Subtype.ext (congrArg Subtype.val (map_zero σ))
      map_add' := fun a b => Subtype.ext (congrArg Subtype.val (map_add σ _ _)) }
  have galApply_one_M : ∀ y : M, galApply F hLM 1 y = y := fun _ => Subtype.ext rfl
  have galApply_one_E : ∀ x : E, galApply F hLE 1 x = x := fun _ => Subtype.ext rfl
  have galApply_mul_E : ∀ (σ₁ σ₂ : G) (x : E),
      galApply F hLE (σ₁ * σ₂) x = galApply F hLE σ₁ (galApply F hLE σ₂ x) :=
    fun _ _ _ => Subtype.ext rfl
  have h_root : ∀ τ ∈ H,
      (P_M.map (IntermediateField.inclusion hME).toRingHom).IsRoot (galApply F hLE τ π_E) := by
    intro τ hτ
    rw [Polynomial.IsRoot.def, Polynomial.eval_map]
    have h_comp : (ϕ_σ τ).comp (IntermediateField.inclusion hME).toRingHom =
        (IntermediateField.inclusion hME).toRingHom := by
      apply RingHom.ext
      intro y
      change galApply F hLE τ (IntermediateField.inclusion hME y) =
        IntermediateField.inclusion hME y
      rw [hres_comm τ y, (hH τ).mp hτ, galApply_one_M]
    change Polynomial.eval₂ (IntermediateField.inclusion hME).toRingHom (ϕ_σ τ π_E) P_M = 0
    rw [← h_comp,
      ← Polynomial.hom_eval₂ P_M (IntermediateField.inclusion hME).toRingHom (ϕ_σ τ) π_E,
      h_eval₂, map_zero]
  have h_inj : ∀ τ₁ τ₂ : G, galApply F hLE τ₁ π_E = galApply F hLE τ₂ π_E → τ₁ = τ₂ := by
    intro τ₁ τ₂ h_eq
    have h1 : galApply F hLE (τ₁⁻¹ * τ₂) π_E = π_E := by
      rw [galApply_mul_E, ← h_eq, ← galApply_mul_E, inv_mul_cancel, galApply_one_E]
    exact inv_mul_eq_one.mp (hπ_inj (τ₁⁻¹ * τ₂) h1)
  have h_dvd :
      (∏ τ ∈ H, (Polynomial.X - Polynomial.C (galApply F hLE τ π_E))) ∣
        P_M.map (IntermediateField.inclusion hME).toRingHom := by
    apply Finset.prod_dvd_of_coprime
    · intro τ₁ hτ₁ τ₂ hτ₂ hne
      have h_sub_ne : galApply F hLE τ₁ π_E - galApply F hLE τ₂ π_E ≠ 0 :=
        sub_ne_zero.mpr (fun h => hne (h_inj τ₁ τ₂ h))
      exact Polynomial.isCoprime_X_sub_C_of_isUnit_sub h_sub_ne.isUnit
    · intro τ hτ
      exact Polynomial.dvd_iff_isRoot.mpr (h_root τ hτ)
  have h_map_monic : (P_M.map (IntermediateField.inclusion hME).toRingHom).Monic :=
    hPM_monic.map (IntermediateField.inclusion hME).toRingHom
  have h_map_deg :
      (P_M.map (IntermediateField.inclusion hME).toRingHom).natDegree = P_M.natDegree :=
    hPM_monic.natDegree_map (IntermediateField.inclusion hME).toRingHom
  have h_deg_ge : H.card ≤ P_M.natDegree := by
    have h1 := Polynomial.natDegree_le_of_dvd h_dvd h_map_monic.ne_zero
    rwa [hQ_deg, h_map_deg] at h1
  have hPM_deg : P_M.natDegree = H.card := by omega
  have hPM_prod :
      P_M.map (IntermediateField.inclusion hME).toRingHom =
        ∏ τ ∈ H, (Polynomial.X - Polynomial.C (galApply F hLE τ π_E)) :=
    Polynomial.eq_of_monic_of_dvd_of_natDegree_le hQ_monic h_map_monic h_dvd
      (by rw [h_map_deg, hPM_deg, hQ_deg])
  exact ⟨hres_M, res, H, P_M, hres_surj, hH, hres_comm, h_finrank_eq, h_val_scale,
    hPM_monic, hPM_deg, hPM_prod⟩

theorem sum_valL_galApply_sub_eq_card_ker_mul_valL_sub (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
    (hLM : L ≤ M) (hME : M ≤ E) (π_E : E) :
    valL F E π_E = 1 →
    ∀ (res : ((IntermediateField.extendScalars (hLM.trans hME)) ≃ₐ[L]
        (IntermediateField.extendScalars (hLM.trans hME))) →*
      ((IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM)))
    (H : Finset ((IntermediateField.extendScalars (hLM.trans hME)) ≃ₐ[L]
        (IntermediateField.extendScalars (hLM.trans hME))))
    (P_M : Polynomial M),
    (∀ τ, τ ∈ H ↔ res τ = 1) →
    (∀ σ y,
      galApply F (hLM.trans hME) σ (IntermediateField.inclusion hME y) =
        IntermediateField.inclusion hME (galApply F hLM (res σ) y)) →
    (∀ y : M, y ≠ 0 →
      valL F E (IntermediateField.inclusion hME y) = (H.card : ℤ) * valL F M y) →
    (∀ σ, σ ≠ 1 →
      galApply F (hLM.trans hME) σ π_E ≠ π_E ∧
        1 ≤ valL F E (galApply F (hLM.trans hME) σ π_E - π_E)) →
    (∀ (π_M : M), valL F M π_M = 1 →
      ∀ σbar : (IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM),
        σbar ≠ 1 → galApply F hLM σbar π_M ≠ π_M ∧
          1 ≤ valL F M (galApply F hLM σbar π_M - π_M) ∧
          ∀ b : M, (b = 0 ∨ 0 ≤ valL F M b) →
            galApply F hLM σbar b = b ∨
              valL F M (galApply F hLM σbar π_M - π_M) ≤ valL F M (galApply F hLM σbar b - b)) →
    P_M.Monic → P_M.natDegree = H.card →
    P_M.map (IntermediateField.inclusion hME).toRingHom =
      ∏ τ ∈ H, (Polynomial.X - Polynomial.C (galApply F (hLM.trans hME) τ π_E)) →
    let hLE := hLM.trans hME
    let π_M : M := P_M.coeff 0
    valL F M π_M = 1 ∧
      ∀ σ, res σ ≠ 1 →
        ∑ τ ∈ H, ((valL F E (galApply F hLE (σ * τ) π_E - π_E)).toNat - 1) =
          H.card * ((valL F M (galApply F hLM (res σ) π_M - π_M)).toNat - 1) :=
by
  intro hπ_E res H P_M hH hres_comm h_val_scale hG_ne hM_ram hPM_monic hPM_deg hPM_prod hLE π_M
  have hval_zero_E : valL F E 0 = 0 := by
    unfold valL relVal addVal
    rw [Algebra.norm_zero, dif_pos rfl, Int.zero_ediv]
  have hπ_E_ne : π_E ≠ 0 := by
    intro h0
    rw [h0, hval_zero_E] at hπ_E
    omega
  let ϖ : Eˣ := Units.mk0 π_E hπ_E_ne
  have hϖ : valL F E ϖ = 1 := hπ_E
  have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
      0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
    intro a ha
    unfold addVal
    rw [dif_neg ha]
    set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    set va := valuation F a
    have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
    constructor
    · intro h_nonneg
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
      have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
      have h_iso : iso va ≤ iso 1 := by
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
        exact WithZero.coe_le_coe.mpr h_unzero
      exact (map_le_map_iff iso).mp h_iso
    · intro h_le
      have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
      rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
        Multiplicative.toAdd_le.mpr h_iso
      omega
  have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom : Eˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Eˣ, Multiplicative.toAdd (relValHom u) = relVal F E u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : Eˣ,
      relVal F E ((u * v : Eˣ) : E) = relVal F E u + relVal F E v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : Eˣ) (m : ℤ),
      relVal F E ((u ^ m : Eˣ) : E) = m * relVal F E u := by
    intro u m
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have relVal_mul : ∀ {x y : E} (hx : x ≠ 0) (hy : y ≠ 0),
      relVal F E (x * y) = relVal F E x + relVal F E y := by
    intro x y hx hy
    exact relVal_units_mul (Units.mk0 x hx) (Units.mk0 y hy)
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F E ∧ ∃ π : Eˣ, relVal F E π = resDeg F E := by
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {m : ℕ | 0 < m ∧ ∃ z : E, z ≠ 0 ∧ relVal F E z = m}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F E, Module.finrank_pos, algebraMap F E u,
        (map_ne_zero (algebraMap F E)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F E (u : F)) = (u : F) ^ Module.finrank F E :=
        Algebra.norm_algebraMap (u : F)
      have hpow : addVal F ((u : F) ^ Module.finrank F E) =
          (Module.finrank F E : ℤ) * addVal F u := by
        change Multiplicative.toAdd (addValHom (u ^ Module.finrank F E)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hf_pos, π_ex, hπ_ex⟩ := resDeg_mem
  have relVal_eq_resDeg_mul_valL_aux :
      ∀ u : Eˣ, relVal F E u = (resDeg F E : ℤ) * valL F E u := by
    intro u
    let q_div := relVal F E u / (resDeg F E : ℤ)
    let r_rem := relVal F E u % (resDeg F E : ℤ)
    have hdiv : r_rem + (resDeg F E : ℤ) * q_div = relVal F E u := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r_rem := Int.emod_nonneg _ (by positivity)
    have hrlt : r_rem < (resDeg F E : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F E ((u * π_ex ^ (-q_div) : Eˣ) : E) = r_rem := by
      rw [relVal_units_mul, relVal_units_zpow, hπ_ex]
      linarith
    have hr_eq : r_rem = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r_rem.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r_rem.toNat ∈ {m : ℕ | 0 < m ∧ ∃ z : E, z ≠ 0 ∧ relVal F E z = m} := by
        refine ⟨hr_pos, ((u * π_ex ^ (-q_div) : Eˣ) : E), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F E ≤ r_rem.toNat := Nat.sInf_le hmem
      omega
    change relVal F E u = (resDeg F E : ℤ) * q_div
    linarith
  have relVal_eq : ∀ {x : E} (hx : x ≠ 0), relVal F E x = (resDeg F E : ℤ) * valL F E x :=
    fun hx => relVal_eq_resDeg_mul_valL_aux (Units.mk0 _ hx)
  have valL_mul : ∀ {x y : E} (hx : x ≠ 0) (hy : y ≠ 0),
      valL F E (x * y) = valL F E x + valL F E y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    have h := relVal_mul hx hy
    rw [relVal_eq hxy, relVal_eq hx, relVal_eq hy, ← mul_add] at h
    exact mul_left_cancel₀ (by positivity) h
  have valL_one : valL F E 1 = 0 := by
    have h1 : (1 : E) ≠ 0 := one_ne_zero
    have h := valL_mul h1 h1
    rw [mul_one] at h
    omega
  have valL_pow : ∀ {x : E} (hx : x ≠ 0) (m : ℕ), valL F E (x ^ m) = (m : ℤ) * valL F E x := by
    intro x hx m
    induction m with
    | zero => simp [valL_one]
    | succ m ih =>
      rw [pow_succ, valL_mul (pow_ne_zero m hx) hx, ih]
      push_cast
      ring
  have valL_units_zpow : ∀ (u : Eˣ) (m : ℤ),
      valL F E ((u ^ m : Eˣ) : E) = m * valL F E u := by
    intro u m
    have h := relVal_units_zpow u m
    rw [relVal_eq (Units.ne_zero _), relVal_eq (Units.ne_zero _), ← mul_left_comm] at h
    exact mul_left_cancel₀ (by positivity) h
  have h_int_aux : ∀ (K : Type u) [Field K] [Algebra F K] [FiniteDimensional F K] (x : K),
      IsIntegral 𝒪[F] x ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x) := by
    intro K _ _ _ x
    constructor
    · intro hx
      by_cases hx0 : x = 0
      · exact Or.inl hx0
      · right
        have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
        have hnorm_int : IsIntegral 𝒪[F] (Algebra.norm F x) := Algebra.isIntegral_norm F hx
        have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
          (Valuation.Integers.isIntegral_iff_v_le_one
            (Valuation.integer.integers (valuation F))).mp hnorm_int
        exact (addVal_nonneg_iff_val_le_one hnorm0).mpr hval_le
    · rintro (rfl | h_rel)
      · exact isIntegral_zero
      · by_cases hx0 : x = 0
        · rw [hx0]
          exact isIntegral_zero
        · have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
          have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
            (addVal_nonneg_iff_val_le_one hnorm0).mp h_rel
          have hx_int_F : IsIntegral F x := Algebra.IsIntegral.isIntegral x
          let pb : PowerBasis F (IntermediateField.adjoin F ({x} : Set K)) :=
            IntermediateField.adjoin.powerBasis hx_int_F
          have h_gen_coe : (pb.gen : K) = x := IntermediateField.AdjoinSimple.coe_gen F x
          set dK : ℕ := Module.finrank (IntermediateField.adjoin F ({x} : Set K)) K
          have h_finrank_pos : 0 < dK := Module.finrank_pos
