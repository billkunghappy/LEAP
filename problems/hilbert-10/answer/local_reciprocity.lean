    intro n
    induction n with
    | zero =>
      rw [Nat.cast_zero]
      exact Or.inl rfl
    | succ n ih =>
      rw [Nat.cast_add, Nat.cast_one]
      exact hV_add 0 ih (Or.inr (by rw [valL_one]))
