  have h_int : ∀ z : L, IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ relVal F L z := h_int_aux L
  have h_int_valL : ∀ {z : L} (hz : z ≠ 0), IsIntegral 𝒪[F] z ↔ 0 ≤ valL F L z := by
    intro z hz
    rw [h_int, or_iff_right hz, relVal_eq hz]
    exact ⟨fun h => nonneg_of_mul_nonneg_right h (by positivity),
      fun h => mul_nonneg (by positivity) h⟩
