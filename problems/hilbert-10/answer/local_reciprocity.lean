      by_contra h_not
      push_neg at h_not
      obtain ⟨j₁, hj₁⟩ := h_not
      let T : Finset (Fin e) := Finset.univ.filter (fun j => s j ≠ 0)
      have hT_ne : T.Nonempty := ⟨j₁, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj₁⟩⟩
      let t : Fin e → L := fun j => s j * πL ^ (j : ℕ)
      have ht_ne : ∀ j ∈ T, t j ≠ 0 := by
        intro j hjT
        exact mul_ne_zero (Finset.mem_filter.mp hjT).2 (pow_ne_zero _ hπL_ne)
      have ht_mod : ∀ j ∈ T, valL F L (t j) % (e : ℤ) = (j : ℤ) := by
        intro j hjT
        have hsj : s j ≠ 0 := (Finset.mem_filter.mp hjT).2
        have hex : ∃ i, c (i, j) ≠ 0 := by
          by_contra h_all0
          push_neg at h_all0
          apply hsj
          simp [s, h_all0]
        obtain ⟨-, m, hm⟩ := h_comb (fun i => c (i, j)) hex
        have h_val_t : valL F L (t j) = (j : ℤ) + (e : ℤ) * m := by
          change valL F L (s j * πL ^ (j : ℕ)) = _
          rw [valL_mul hsj (pow_ne_zero _ hπL_ne), hm, valL_pow hπL_ne, hπ_val, mul_one, add_comm]
        rw [h_val_t, Int.add_mul_emod_self_left, Int.emod_eq_of_lt (by positivity) (by omega)]
      obtain ⟨j₀, hj₀T, hj₀_min⟩ := Finset.exists_min_image T (fun j => valL F L (t j)) hT_ne
      have h_strict : ∀ j ∈ T.erase j₀, valL F L (t j₀) + 1 ≤ valL F L (t j) := by
        intro j hj
        have hj_ne : j ≠ j₀ := (Finset.mem_erase.mp hj).1
        have hjT : j ∈ T := (Finset.mem_erase.mp hj).2
        have hle := hj₀_min j hjT
        have hne_val : valL F L (t j) ≠ valL F L (t j₀) := by
          intro heq
          have hmod : valL F L (t j) % (e : ℤ) = valL F L (t j₀) % (e : ℤ) :=
            congrArg (fun z => z % (e : ℤ)) heq
          rw [ht_mod j hjT, ht_mod j₀ hj₀T] at hmod
          exact hj_ne (Fin.ext (Int.ofNat.inj hmod))
