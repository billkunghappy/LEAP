    Module.Basis.mk hB_li (by change ⊤ ≤ V; rw [hV_top])
  have h_finrank_B : Module.finrank F L = f₀ * e := by
    rw [Module.finrank_eq_card_basis bL, Fintype.card_prod, Fintype.card_fin, Fintype.card_fin]
  have hf₀ : f₀ = resDeg F L := by nlinarith
  have h_quot_pow : ∀ {R : Type u} [CommRing R] (I : Ideal R) [I.IsMaximal] [Fintype (R ⧸ I)]
