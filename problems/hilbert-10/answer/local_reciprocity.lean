          (s.map (fun β => x - β)).prod / c ^ s.card := by
      intro s
      induction s using Multiset.induction_on with
      | empty => simp
      | cons a s ih =>
        rw [Multiset.map_cons, Multiset.prod_cons, ih, div_mul_div_comm,
          Multiset.map_cons, Multiset.prod_cons, Multiset.card_cons, pow_succ']
    have hP_splits : (P.map (algebraMap L (AlgebraicClosure F))).Splits :=
      IsAlgClosed.splits _
    have h_aeval : Polynomial.aeval x P = (roots.map (fun β => x - β)).prod :=
      Polynomial.Splits.aeval_eq_prod_aroots_of_monic hP_splits hP_monic x
    have h_card : roots.card = P.natDegree := by
      dsimp [roots]
      rw [Polynomial.aroots_def, ← hP_splits.natDegree_eq_card_roots,
        hP_monic.natDegree_map (algebraMap L (AlgebraicClosure F))]
    have ht_prod : t.prod = Polynomial.aeval x P / πbar ^ (r * P.natDegree) := by
      change (roots.map (fun β => (x - β) / c)).prod = _
      rw [h_map_div roots, ← h_aeval, h_card]
      dsimp [c]
      rw [← pow_mul]
    have ht_int : IsIntegral 𝒪[F] t.prod := by
      rw [ht_prod]
      exact hx
    have ht_card : t.card = P.natDegree := by
      dsimp [t]
      rw [Multiset.card_map, h_card]
    have ht_ne : t ≠ 0 := by
      intro ht0
      have h0 : t.card = 0 := Multiset.card_eq_zero.mpr ht0
      omega
    obtain ⟨y, hy_mem, hy_int⟩ := exists_mem_isIntegral_of_prod_isIntegral t ht_ne ht_int
    obtain ⟨β, hβ_mem, rfl⟩ := Multiset.mem_map.mp hy_mem
    have hβ_root : Polynomial.aeval β P = 0 :=
      (Polynomial.mem_aroots.mp hβ_mem).2
    exact ⟨β, hβ_root, hy_int⟩

theorem unramSubring_frob_congr_and_div_pow_mem (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (π : Lˣ) :
    valL F L π = 1 →
      ∀ (τ : AbsGal F), τ ∈ L.fixingSubgroup →
        (∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ → τ ζ = ζ ^ qL F L) →
        ∀ x ∈ unramSubring F L,
          IsIntegral 𝒪[F] x ∧
          τ x ∈ unramSubring F L ∧
          (τ x - x ^ qL F L) / algebraMap L (AlgebraicClosure F) (π : L) ∈ unramSubring F L ∧
          (∃ s : ℕ, 1 ≤ s ∧ (τ ^ s) x = x) ∧
          (∀ k : ℕ, IsIntegralDivPow F L (π : L) k x →
            x / (algebraMap L (AlgebraicClosure F) (π : L)) ^ k ∈ unramSubring F L) :=
by
  intro hπ τ hτL hτFrob
  let π₀ : Lˣ := chosenUniformizer F L
  let πbar : AlgebraicClosure F := algebraMap L (AlgebraicClosure F) (π : L)
  obtain ⟨hπ₀, -⟩ := valL_chosenUniformizer_and_mul_zpow F L π
  obtain ⟨h_frob₀, h_p₀⟩ := isIntegral_pow_qL_sub_and_p_div_chosenUniformizer F L
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Lˣ, Multiplicative.toAdd (relValHom u) = relVal F L u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : Lˣ,
      relVal F L ((u * v : Lˣ) : L) = relVal F L u + relVal F L v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_inv : ∀ u : Lˣ,
      relVal F L ((u⁻¹ : Lˣ) : L) = -relVal F L u := by
    intro u
    rw [← relValHom_apply, map_inv, toAdd_inv, relValHom_apply]
  have hw_rel : relVal F L ((π₀ : L) / (π : L)) = 0 := by
    have hw_eq : (π₀ : L) / (π : L) = ((π₀ * π⁻¹ : Lˣ) : L) := by
      rw [div_eq_mul_inv, Units.val_mul, Units.val_inv_eq_inv_val]
    rw [hw_eq, relVal_units_mul, relVal_units_inv,
      relVal_eq_resDeg_mul_valL F L π₀, relVal_eq_resDeg_mul_valL F L π, hπ₀, hπ]
    ring
  have hw_int : IsIntegral 𝒪[F] ((π₀ : L) / (π : L)) :=
    (isIntegral_iff_eq_zero_or_relVal_nonneg F L ((π₀ : L) / (π : L))).mpr (Or.inr (by omega))
  have h_div_transfer : ∀ z : L, z / (π : L) = (z / (π₀ : L)) * ((π₀ : L) / (π : L)) := by
    intro z
    calc z / (π : L) = (z / (π₀ : L) * (π₀ : L)) / (π : L) := by rw [div_mul_cancel₀ z π₀.ne_zero]
      _ = (z / (π₀ : L)) * ((π₀ : L) / (π : L)) := mul_div_assoc _ _ _
  have h_mem_of_int : ∀ c : L, IsIntegral 𝒪[F] c →
      algebraMap L (AlgebraicClosure F) c ∈ unramSubring F L := by
    intro c hc
    exact Subring.subset_closure (Or.inl ⟨c, hc, rfl⟩)
  have h_mem_of_root : ∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ →
      ζ ∈ unramSubring F L := by
    intro ζ hζ
    exact Subring.subset_closure (Or.inr hζ)
  have hp_div_int : IsIntegral 𝒪[F] ((p F : L) / (π : L)) := by
    rw [h_div_transfer]
    exact h_p₀.mul hw_int
  have hp_div_mem : (p F : AlgebraicClosure F) / πbar ∈ unramSubring F L := by
    have h_eq : (p F : AlgebraicClosure F) / πbar =
        algebraMap L (AlgebraicClosure F) ((p F : L) / (π : L)) := by
      rw [map_div₀, map_natCast]
    rw [h_eq]
    exact h_mem_of_int _ hp_div_int
  have hc_frob_mem : ∀ c : L, IsIntegral 𝒪[F] c →
      (algebraMap L (AlgebraicClosure F) c - (algebraMap L (AlgebraicClosure F) c) ^ qL F L) / πbar ∈
        unramSubring F L := by
    intro c hc
    have hc_div : IsIntegral 𝒪[F] ((c ^ qL F L - c) / (π : L)) := by
      rw [h_div_transfer]
      exact (h_frob₀ c hc).mul hw_int
    have h_eq : (algebraMap L (AlgebraicClosure F) c -
        (algebraMap L (AlgebraicClosure F) c) ^ qL F L) / πbar =
        -algebraMap L (AlgebraicClosure F) ((c ^ qL F L - c) / (π : L)) := by
      rw [map_div₀, map_sub, map_pow, ← neg_div, neg_sub]
    rw [h_eq]
    exact (unramSubring F L).neg_mem (h_mem_of_int _ hc_div)
  have hqL_pow : ∃ n : ℕ, Nat.Prime (p F) ∧ qL F L = (p F) ^ n := by
    haveI : Finite 𝓀[F] :=
      IsNonarchimedeanLocalField.instFiniteResidueFieldSubtypeMemSubringIntegerValueGroupWithZeroValuation F
    letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
    haveI : CharP 𝓀[F] (p F) := ringChar.charP 𝓀[F]
    obtain ⟨d, hp, hcard⟩ := FiniteField.card 𝓀[F] (p F)
    refine ⟨(d : ℕ) * resDeg F L, hp, ?_⟩
    unfold qL q
    rw [Nat.card_eq_fintype_card, hcard, ← pow_mul]
  obtain ⟨n_qL, hp, hqL_eq⟩ := hqL_pow
  have hqL_pos : 0 < qL F L := by
    rw [hqL_eq]
    exact pow_pos hp.pos n_qL
  have h_add_pow_mem : ∀ {x y : AlgebraicClosure F},
      x ∈ unramSubring F L → y ∈ unramSubring F L →
      ((x + y) ^ qL F L - (x ^ qL F L + y ^ qL F L)) / πbar ∈ unramSubring F L := by
    intro x y hx hy
    rcases eq_or_lt_of_le (Nat.succ_le_of_lt hqL_pos) with h1 | hgt1
    · rw [← h1, pow_one, pow_one, pow_one, sub_self, zero_div]
      exact (unramSubring F L).zero_mem
    · have hqL_split : qL F L + 1 = (qL F L - 1) + 1 + 1 := by omega
      have h_sum_split : ∑ m ∈ Finset.range (qL F L + 1),
          x ^ m * y ^ (qL F L - m) * ((qL F L).choose m : AlgebraicClosure F) =
          ((∑ j ∈ Finset.range (qL F L - 1),
            x ^ (j + 1) * y ^ (qL F L - (j + 1)) * ((qL F L).choose (j + 1) : AlgebraicClosure F)) +
            x ^ 0 * y ^ (qL F L - 0) * ((qL F L).choose 0 : AlgebraicClosure F)) +
          x ^ ((qL F L - 1) + 1) * y ^ (qL F L - ((qL F L - 1) + 1)) *
            ((qL F L).choose ((qL F L - 1) + 1) : AlgebraicClosure F) := by
        rw [hqL_split, Finset.sum_range_succ, Finset.sum_range_succ']
      have h_binom : (x + y) ^ qL F L - (x ^ qL F L + y ^ qL F L) =
          ∑ j ∈ Finset.range (qL F L - 1),
            x ^ (j + 1) * y ^ (qL F L - (j + 1)) * ((qL F L).choose (j + 1) : AlgebraicClosure F) := by
        rw [add_pow, h_sum_split]
        have h_sub1 : (qL F L - 1) + 1 = qL F L := by omega
        have h_top : x ^ ((qL F L - 1) + 1) * y ^ (qL F L - ((qL F L - 1) + 1)) *
            ((qL F L).choose ((qL F L - 1) + 1) : AlgebraicClosure F) = x ^ qL F L := by
          rw [h_sub1, Nat.sub_self, pow_zero, mul_one, Nat.choose_self, Nat.cast_one, mul_one]
        have h_bot : x ^ 0 * y ^ (qL F L - 0) * ((qL F L).choose 0 : AlgebraicClosure F) = y ^ qL F L := by
          rw [pow_zero, one_mul, Nat.sub_zero, Nat.choose_zero_right, Nat.cast_one, mul_one]
        rw [h_top, h_bot]
        ring
      rw [h_binom, Finset.sum_div]
      refine (unramSubring F L).sum_mem fun j hj => ?_
      have hj_lt : j < qL F L - 1 := Finset.mem_range.mp hj
      have hk_ne_zero : j + 1 ≠ 0 := by omega
      have hk_ne_qL : j + 1 ≠ (p F) ^ n_qL := by omega
      have hdvd : p F ∣ (qL F L).choose (j + 1) := by
        rw [hqL_eq]
        exact hp.dvd_choose_pow hk_ne_zero hk_ne_qL
      obtain ⟨c, hc⟩ := hdvd
      have h_term : (x ^ (j + 1) * y ^ (qL F L - (j + 1)) *
          ((qL F L).choose (j + 1) : AlgebraicClosure F)) / πbar =
          ((p F : AlgebraicClosure F) / πbar) *
            (x ^ (j + 1) * y ^ (qL F L - (j + 1)) * (c : AlgebraicClosure F)) := by
        rw [hc, Nat.cast_mul]
        ring
      rw [h_term]
      exact (unramSubring F L).mul_mem hp_div_mem
        ((unramSubring F L).mul_mem
          ((unramSubring F L).mul_mem ((unramSubring F L).pow_mem hx (j + 1))
            ((unramSubring F L).pow_mem hy (qL F L - (j + 1))))
          (natCast_mem (unramSubring F L) c))
  let P1 : AlgebraicClosure F → Prop := fun x =>
    IsIntegral 𝒪[F] x ∧
    τ x ∈ unramSubring F L ∧
    (τ x - x ^ qL F L) / πbar ∈ unramSubring F L
  have hP1_mul : ∀ {x y : AlgebraicClosure F},
      x ∈ unramSubring F L → y ∈ unramSubring F L → P1 x → P1 y → P1 (x * y) := by
    intro x y hx hy ⟨hx_int, hτx, hdx⟩ ⟨hy_int, hτy, hdy⟩
    refine ⟨hx_int.mul hy_int, ?_, ?_⟩
    · rw [map_mul]
      exact (unramSubring F L).mul_mem hτx hτy
    · have h_alg : (τ (x * y) - (x * y) ^ qL F L) / πbar =
          ((τ x - x ^ qL F L) / πbar) * τ y +
            x ^ qL F L * ((τ y - y ^ qL F L) / πbar) := by
        rw [map_mul, mul_pow]
        ring
      rw [h_alg]
      exact (unramSubring F L).add_mem
        ((unramSubring F L).mul_mem hdx hτy)
        ((unramSubring F L).mul_mem ((unramSubring F L).pow_mem hx (qL F L)) hdy)
  have hP1_mem : ∀ z ∈ ({x : AlgebraicClosure F | ∃ c : L, IsIntegral 𝒪[F] c ∧ algebraMap L (AlgebraicClosure F) c = x} ∪
      {ζ : AlgebraicClosure F | IsPrimeToPRootOfUnity F ζ}), P1 z := by
    rintro z (⟨c, hc_int, rfl⟩ | hζ)
    · have hτc : τ (algebraMap L (AlgebraicClosure F) c) = algebraMap L (AlgebraicClosure F) c :=
        (IntermediateField.mem_fixingSubgroup_iff L τ).mp hτL c c.2
      refine ⟨(isIntegral_algebraMap_iff (algebraMap L (AlgebraicClosure F)).injective).mpr hc_int,
        ?_, ?_⟩
      · rw [hτc]
        exact h_mem_of_int c hc_int
      · rw [hτc]
        exact hc_frob_mem c hc_int
    · rcases hζ with ⟨m, hm_pos, hpm, hζm⟩
      have hζ_int : IsIntegral 𝒪[F] z :=
        IsIntegral.of_pow hm_pos (by rw [hζm]; exact isIntegral_one)
      have hτz : τ z = z ^ qL F L := hτFrob z ⟨m, hm_pos, hpm, hζm⟩
      refine ⟨hζ_int, ?_, ?_⟩
      · rw [hτz]
        exact (unramSubring F L).pow_mem (h_mem_of_root z ⟨m, hm_pos, hpm, hζm⟩) (qL F L)
      · rw [hτz, sub_self, zero_div]
        exact (unramSubring F L).zero_mem
  have hP1 : ∀ x ∈ unramSubring F L, P1 x := by
    intro x hx
    induction hx using Subring.closure_induction with
    | mem z hz => exact hP1_mem z hz
    | zero =>
      refine ⟨isIntegral_zero, ?_, ?_⟩
      · rw [map_zero]
        exact (unramSubring F L).zero_mem
      · rw [map_zero, zero_pow hqL_pos.ne', sub_self, zero_div]
        exact (unramSubring F L).zero_mem
    | one =>
      refine ⟨isIntegral_one, ?_, ?_⟩
      · rw [map_one]
        exact (unramSubring F L).one_mem
      · rw [map_one, one_pow, sub_self, zero_div]
        exact (unramSubring F L).zero_mem
    | add x y hx hy ihx ihy =>
      rcases ihx with ⟨hx_int, hτx, hdx⟩
      rcases ihy with ⟨hy_int, hτy, hdy⟩
      refine ⟨hx_int.add hy_int, ?_, ?_⟩
      · rw [map_add]
        exact (unramSubring F L).add_mem hτx hτy
      · have h_alg : (τ (x + y) - (x + y) ^ qL F L) / πbar =
            ((τ x - x ^ qL F L) / πbar + (τ y - y ^ qL F L) / πbar) -
              ((x + y) ^ qL F L - (x ^ qL F L + y ^ qL F L)) / πbar := by
          rw [map_add]
          ring
        rw [h_alg]
        exact (unramSubring F L).sub_mem
          ((unramSubring F L).add_mem hdx hdy)
          (h_add_pow_mem hx hy)
    | neg x hx ihx =>
      have h_neg1_mem : (-1 : AlgebraicClosure F) ∈ unramSubring F L :=
        (unramSubring F L).neg_mem (unramSubring F L).one_mem
      have h_neg1_P1 : P1 (-1 : AlgebraicClosure F) := by
        have h_eq : (-1 : AlgebraicClosure F) = algebraMap L (AlgebraicClosure F) (-1 : L) := by
          rw [map_neg, map_one]
        rw [h_eq]
        exact hP1_mem _ (Or.inl ⟨-1, isIntegral_one.neg, rfl⟩)
      have h_eq : -x = (-1 : AlgebraicClosure F) * x := by ring
      rw [h_eq]
      exact hP1_mul h_neg1_mem hx h_neg1_P1 ihx
    | mul x y hx hy ihx ihy =>
      exact hP1_mul hx hy ihx ihy
  have h_pow_fix : ∀ (γ : AbsGal F) (z : AlgebraicClosure F),
      γ z = z → ∀ k : ℕ, (γ ^ k) z = z := by
    intro γ z hγ k
    induction k with
    | zero => rfl
    | succ k ih => rw [pow_succ', AlgEquiv.mul_apply, ih, hγ]
  have h_pow_mul_fix : ∀ {z : AlgebraicClosure F} {a : ℕ},
      (τ ^ a) z = z → ∀ b : ℕ, (τ ^ (a * b)) z = z := by
    intro z a ha b
    rw [pow_mul]
    exact h_pow_fix (τ ^ a) z ha b
  have h_root_pow : ∀ {ζ : AlgebraicClosure F},
      IsPrimeToPRootOfUnity F ζ → ∀ e : ℕ, IsPrimeToPRootOfUnity F (ζ ^ e) := by
    intro ζ ⟨m, hm_pos, hpm, hζm⟩ e
    refine ⟨m, hm_pos, hpm, ?_⟩
    rw [← pow_mul, mul_comm, pow_mul, hζm, one_pow]
  have h_tau_pow_root : ∀ {ζ : AlgebraicClosure F},
      IsPrimeToPRootOfUnity F ζ → ∀ k : ℕ, (τ ^ k) ζ = ζ ^ ((qL F L) ^ k) := by
    intro ζ hζ k
    induction k with
    | zero =>
      change ζ = ζ ^ 1
      rw [pow_one]
    | succ k ih =>
      rw [pow_succ', AlgEquiv.mul_apply, ih, hτFrob _ (h_root_pow hζ ((qL F L) ^ k)),
        ← pow_mul, ← pow_succ]
  have hP2 : ∀ x ∈ unramSubring F L, ∃ s : ℕ, 1 ≤ s ∧ (τ ^ s) x = x := by
    intro x hx
    induction hx using Subring.closure_induction with
    | mem z hz =>
      rcases hz with ⟨c, -, rfl⟩ | hζ
      · refine ⟨1, le_refl 1, ?_⟩
        rw [pow_one]
        exact (IntermediateField.mem_fixingSubgroup_iff L τ).mp hτL c c.2
      · obtain ⟨m, hm_pos, hpm, hζm⟩ := hζ
        have h_coprime_p : (p F).Coprime m := (hp.coprime_iff_not_dvd).mpr hpm
        have h_coprime_qL : (qL F L).Coprime m := by
          rw [hqL_eq]
          exact h_coprime_p.pow_left n_qL
        let s := Nat.totient m
        have hs_pos : 1 ≤ s := Nat.totient_pos.mpr hm_pos
        have h_modeq : (qL F L) ^ s ≡ 1 [MOD m] := Nat.ModEq.pow_totient h_coprime_qL
        have h_pow_mod : ∀ N : ℕ, z ^ N = z ^ (N % m) := by
          intro N
          conv_lhs => rw [← Nat.mod_add_div N m]
          rw [pow_add, pow_mul, hζm, one_pow, mul_one]
        refine ⟨s, hs_pos, ?_⟩
        rw [h_tau_pow_root ⟨m, hm_pos, hpm, hζm⟩ s, h_pow_mod ((qL F L) ^ s),
          h_modeq, ← h_pow_mod 1, pow_one]
    | zero =>
      exact ⟨1, le_refl 1, map_zero _⟩
    | one =>
      exact ⟨1, le_refl 1, map_one _⟩
    | add x y _ _ ihx ihy =>
      rcases ihx with ⟨s₁, hs₁, hx_fix⟩
      rcases ihy with ⟨s₂, hs₂, hy_fix⟩
      refine ⟨s₁ * s₂, Nat.mul_pos hs₁ hs₂, ?_⟩
      rw [map_add, h_pow_mul_fix hx_fix s₂, mul_comm s₁ s₂, h_pow_mul_fix hy_fix s₁]
    | neg x _ ihx =>
      rcases ihx with ⟨s, hs, hx_fix⟩
      refine ⟨s, hs, ?_⟩
      rw [map_neg, hx_fix]
    | mul x y _ _ ihx ihy =>
      rcases ihx with ⟨s₁, hs₁, hx_fix⟩
      rcases ihy with ⟨s₂, hs₂, hy_fix⟩
      refine ⟨s₁ * s₂, Nat.mul_pos hs₁ hs₂, ?_⟩
      rw [map_mul, h_pow_mul_fix hx_fix s₂, mul_comm s₁ s₂, h_pow_mul_fix hy_fix s₁]
  have h_level_mono : ∀ {m₁ m₂ : ℕ}, m₁ ∣ m₂ →
      unramifiedLevelField F L m₁ ≤ unramifiedLevelField F L m₂ := by
    intro m₁ m₂ ⟨d, hd⟩
    unfold unramifiedLevelField
    rw [IntermediateField.adjoin_le_iff]
    intro ξ hξ
    apply IntermediateField.subset_adjoin
    change ξ ^ m₂ = 1
    rw [hd, pow_mul, hξ, one_pow]
  have h_exists_level : ∀ x ∈ unramSubring F L,
      ∃ m : ℕ, 0 < m ∧ ¬ p F ∣ m ∧ x ∈ unramifiedLevelField F L m := by
    intro x hx
    induction hx using Subring.closure_induction with
    | mem z hz =>
      rcases hz with ⟨c, -, rfl⟩ | ⟨m, hm_pos, hpm, hzm⟩
      · exact ⟨1, zero_lt_one, hp.not_dvd_one, (unramifiedLevelField F L 1).algebraMap_mem c⟩
      · exact ⟨m, hm_pos, hpm, IntermediateField.subset_adjoin L _ hzm⟩
    | zero =>
      exact ⟨1, zero_lt_one, hp.not_dvd_one, (unramifiedLevelField F L 1).zero_mem⟩
    | one =>
      exact ⟨1, zero_lt_one, hp.not_dvd_one, (unramifiedLevelField F L 1).one_mem⟩
    | add x y _ _ ihx ihy =>
      rcases ihx with ⟨m₁, hm₁, hpm₁, hx₁⟩
      rcases ihy with ⟨m₂, hm₂, hpm₂, hy₂⟩
      refine ⟨m₁ * m₂, mul_pos hm₁ hm₂, mt hp.dvd_mul.mp (not_or.mpr ⟨hpm₁, hpm₂⟩), ?_⟩
      exact (unramifiedLevelField F L (m₁ * m₂)).add_mem
        (h_level_mono (dvd_mul_right m₁ m₂) hx₁)
        (h_level_mono (dvd_mul_left m₂ m₁) hy₂)
    | neg x _ ihx =>
      rcases ihx with ⟨m, hm, hpm, hxm⟩
      exact ⟨m, hm, hpm, (unramifiedLevelField F L m).neg_mem hxm⟩
    | mul x y _ _ ihx ihy =>
      rcases ihx with ⟨m₁, hm₁, hpm₁, hx₁⟩
      rcases ihy with ⟨m₂, hm₂, hpm₂, hy₂⟩
      refine ⟨m₁ * m₂, mul_pos hm₁ hm₂, mt hp.dvd_mul.mp (not_or.mpr ⟨hpm₁, hpm₂⟩), ?_⟩
      exact (unramifiedLevelField F L (m₁ * m₂)).mul_mem
        (h_level_mono (dvd_mul_right m₁ m₂) hx₁)
        (h_level_mono (dvd_mul_left m₂ m₁) hy₂)
  have hP3 : ∀ x ∈ unramSubring F L, ∀ k : ℕ, IsIntegralDivPow F L (π : L) k x →
      x / πbar ^ k ∈ unramSubring F L := by
    intro x hx k hdiv
    obtain ⟨m, hm_pos, hpm, hxm⟩ := h_exists_level x hx
    let U : IntermediateField L (AlgebraicClosure F) := unramifiedLevelField F L m
    obtain ⟨hGal, hFin⟩ := unramifiedLevelField_isGalois_and_finiteDimensional F L m hm_pos hpm
    haveI : IsGalois L U := hGal
    haveI : FiniteDimensional L U := hFin
    obtain ⟨ζ, hζm, htrace⟩ := exists_pow_eq_one_and_natCast_mul_eq_sum_trace F L m hm_pos hpm
    let w : AlgebraicClosure F := x / πbar ^ k
    have hw_mem : w ∈ U :=
      U.div_mem hxm (U.toSubring.pow_mem (U.algebraMap_mem (π : L)) k)
    let y : U := ⟨w, hw_mem⟩
    haveI : IsScalarTower 𝒪[F] U (AlgebraicClosure F) := IsScalarTower.of_algebraMap_eq' rfl
    have hy_int : IsIntegral 𝒪[F] y :=
      (isIntegral_algebraMap_iff U.val.injective).mp hdiv
    have hζ_int : IsIntegral 𝒪[F] ζ :=
      IsIntegral.of_pow hm_pos (by rw [hζm]; exact isIntegral_one)
    haveI : IsScalarTower 𝒪[F] L U := IsScalarTower.of_algebraMap_eq' rfl
    have ht_int : ∀ j : ℕ, IsIntegral 𝒪[F] (Algebra.trace L U (y * ζ ^ j)) := by
      intro j
      exact Algebra.isIntegral_trace (hy_int.mul (hζ_int.pow j))
    have hm_res_ne : IsLocalRing.residue 𝒪[F] (m : 𝒪[F]) ≠ 0 := by
      rw [map_natCast]
      intro h0
      exact hpm ((ringChar.spec 𝓀[F] m).mp h0)
    have hm_unit : IsUnit (m : 𝒪[F]) :=
      (IsLocalRing.residue_ne_zero_iff_isUnit (m : 𝒪[F])).mp hm_res_ne
    obtain ⟨u₀, hu₀⟩ := hm_unit
    let m_inv : L := algebraMap 𝒪[F] L (↑(u₀⁻¹) : 𝒪[F])
    have hm_inv_int : IsIntegral 𝒪[F] m_inv := isIntegral_algebraMap
    have hm_inv_mul : algebraMap L (AlgebraicClosure F) m_inv * (m : AlgebraicClosure F) = 1 := by
      have hm_eq : (m : AlgebraicClosure F) =
          algebraMap 𝒪[F] (AlgebraicClosure F) (u₀ : 𝒪[F]) := by
        rw [hu₀, map_natCast]
      have h_tower : algebraMap L (AlgebraicClosure F) m_inv =
          algebraMap 𝒪[F] (AlgebraicClosure F) (↑(u₀⁻¹) : 𝒪[F]) :=
        IsScalarTower.algebraMap_apply 𝒪[F] L (AlgebraicClosure F) (↑(u₀⁻¹) : 𝒪[F])
      rw [h_tower, hm_eq, ← map_mul, Units.inv_mul, map_one]
    have h_val_trace := congr_arg U.val (htrace y)
    simp only [map_mul, map_natCast, map_sum, map_pow, map_inv₀] at h_val_trace
    have hw_eq : x / πbar ^ k = ∑ j ∈ Finset.range m,
        algebraMap L (AlgebraicClosure F) (m_inv * Algebra.trace L U (y * ζ ^ j)) *
          (U.val ζ)⁻¹ ^ j := by
      calc x / πbar ^ k = 1 * U.val y := (one_mul _).symm
        _ = (algebraMap L (AlgebraicClosure F) m_inv * (m : AlgebraicClosure F)) *
            U.val y := by rw [hm_inv_mul]
        _ = algebraMap L (AlgebraicClosure F) m_inv *
            ((m : AlgebraicClosure F) * U.val y) := by ring
        _ = _ := by
          rw [h_val_trace, Finset.mul_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          have h_alg_map : U.val (algebraMap L U (Algebra.trace L U (y * ζ ^ j))) =
              algebraMap L (AlgebraicClosure F) (Algebra.trace L U (y * ζ ^ j)) := rfl
          rw [h_alg_map, ← mul_assoc, ← map_mul]
    rw [hw_eq]
    refine (unramSubring F L).sum_mem fun j _ => ?_
    refine (unramSubring F L).mul_mem ?_ ?_
    · exact h_mem_of_int _ (hm_inv_int.mul (ht_int j))
    · refine (unramSubring F L).pow_mem (h_mem_of_root _ ?_) j
      refine ⟨m, hm_pos, hpm, ?_⟩
      have hζ_val_m : (U.val ζ) ^ m = 1 := by
        rw [← map_pow, hζm, map_one]
      rw [inv_pow, hζ_val_m, inv_one]
  intro x hx
  obtain ⟨h1, h2, h3⟩ := hP1 x hx
  exact ⟨h1, h2, h3, hP2 x hx, hP3 x hx⟩

theorem exists_unramSubring_frob_unit_lift (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (π u : Lˣ) :
    valL F L π = 1 → valL F L u = 0 →
      ∀ (τ : AbsGal F), τ ∈ L.fixingSubgroup →
        (∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ → τ ζ = ζ ^ qL F L) →
        (∀ (P : Polynomial L), P.Monic → 1 ≤ P.natDegree →
          ∀ (x : AlgebraicClosure F) (r : ℕ),
            IsIntegralDivPow F L (π : L) (r * P.natDegree) (Polynomial.aeval x P) →
            ∃ β : AlgebraicClosure F,
              Polynomial.aeval β P = 0 ∧ IsIntegralDivPow F L (π : L) r (x - β)) →
        (∀ x ∈ unramSubring F L,
          IsIntegral 𝒪[F] x ∧
          τ x ∈ unramSubring F L ∧
          (τ x - x ^ qL F L) / algebraMap L (AlgebraicClosure F) (π : L) ∈ unramSubring F L ∧
          (∃ s : ℕ, 1 ≤ s ∧ (τ ^ s) x = x) ∧
          (∀ k : ℕ, IsIntegralDivPow F L (π : L) k x →
            x / (algebraMap L (AlgebraicClosure F) (π : L)) ^ k ∈ unramSubring F L)) →
        ∀ (K : ℕ), ∃ ε ∈ unramSubring F L, ∃ ε' ∈ unramSubring F L,
          IsIntegralDivPow F L (π : L) 1 (ε * ε' - 1) ∧
          IsIntegralDivPow F L (π : L) K (τ ε - algebraMap L (AlgebraicClosure F) (u : L) * ε) :=
by
  intro hπ hu τ hτL hτFrob h_root h_unram K
  
  have h_s1 : 2 ≤ qL F L ∧ Nat.Prime (p F) ∧ p F ∣ qL F L ∧
      algebraMap L (AlgebraicClosure F) (π : L) ∈ unramSubring F L ∧
      IsIntegralDivPow F L (π : L) 1 (p F : AlgebraicClosure F) ∧
      ¬ IsIntegralDivPow F L (π : L) 1 (1 : AlgebraicClosure F) ∧
      algebraMap L (AlgebraicClosure F) (u : L) ∈ unramSubring F L ∧
      algebraMap L (AlgebraicClosure F) ((u⁻¹ : Lˣ) : L) ∈ unramSubring F L ∧
      (∀ x y : AlgebraicClosure F, IsIntegral 𝒪[F] x → IsIntegral 𝒪[F] y →
        IsIntegralDivPow F L (π : L) 1 ((x + y) ^ qL F L - (x ^ qL F L + y ^ qL F L))) := by
    have h_val_props : 0 < resDeg F L ∧
        (∀ {z : L}, z ≠ 0 → (IsIntegral 𝒪[F] z ↔ 0 ≤ valL F L z)) ∧
        (∀ {x y : L}, x ≠ 0 → y ≠ 0 → valL F L (x / y) = valL F L x - valL F L y) ∧
        valL F L 1 = 0 ∧
        IsIntegral 𝒪[F] ((p F : L) / (π : L)) := by
      have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
          0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
        intro a ha
        unfold addVal
        rw [dif_neg ha]
        set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
        set va := valuation F a
        have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
        constructor
        · intro h_nonneg
          have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
          have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
          have h_iso : iso va ≤ iso 1 := by
            rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
            exact WithZero.coe_le_coe.mpr h_unzero
          exact (map_le_map_iff iso).mp h_iso
        · intro h_le
          have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
          rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
          have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
            Multiplicative.toAdd_le.mpr h_iso
          omega
      have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
          addVal F (x * y) = addVal F x + addVal F y := by
        intro x y hx hy
        have hxy : x * y ≠ 0 := mul_ne_zero hx hy
        simp only [addVal, hx, hy, hxy, ↓reduceDIte]
        rw [← neg_add, neg_inj, ← toAdd_mul]
        congr 1
        rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
          WithZero.coe_unzero, ← map_mul, ← map_mul]
      have addVal_one : addVal F 1 = 0 := by
        have h1 : (1 : F) ≠ 0 := one_ne_zero
        have h := addVal_mul h1 h1
        rw [mul_one] at h
        omega
      let addValHom : Fˣ →* Multiplicative ℤ :=
        { toFun := fun v => Multiplicative.ofAdd (addVal F v)
          map_one' := by simp [addVal_one]
          map_mul' := fun v w => by simp [addVal_mul v.ne_zero w.ne_zero, ofAdd_add] }
      let relValHom : Lˣ →* Multiplicative ℤ :=
        addValHom.comp (Units.map (Algebra.norm F))
      have relValHom_apply : ∀ v : Lˣ, Multiplicative.toAdd (relValHom v) = relVal F L v :=
        fun _ => rfl
      have relVal_units_mul : ∀ v w : Lˣ,
          relVal F L ((v * w : Lˣ) : L) = relVal F L v + relVal F L w := by
        intro v w
        rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
      have relVal_units_zpow : ∀ (v : Lˣ) (k : ℤ),
          relVal F L ((v ^ k : Lˣ) : L) = k * relVal F L v := by
        intro v k
        rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
        rfl
      have relVal_mul : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
          relVal F L (x * y) = relVal F L x + relVal F L y :=
        fun hx hy => relVal_units_mul (Units.mk0 _ hx) (Units.mk0 _ hy)
      have exists_addVal_eq_one : ∃ v : Fˣ, addVal F v = 1 := by
        let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
          (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
        have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
            WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
          (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
        obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
        have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
            WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
          rw [ha]
          exact hg
        have ha0 : a ≠ 0 := by
          intro h0
          rw [h0, map_zero, map_zero] at h1
          exact WithZero.coe_ne_zero h1.symm
        refine ⟨Units.mk0 a ha0, ?_⟩
        simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
        have h2 : WithZero.unzero
            (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
            (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
          rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
        rw [h2, toAdd_ofAdd, neg_neg]
      have resDeg_mem : 0 < resDeg F L ∧ ∃ π_ex : Lˣ, relVal F L π_ex = resDeg F L := by
        obtain ⟨v, hv⟩ := exists_addVal_eq_one
        let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
        have hS : S.Nonempty := by
          refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L v,
            (map_ne_zero (algebraMap F L)).mpr v.ne_zero, ?_⟩
          have hnorm : Algebra.norm F (algebraMap F L (v : F)) = (v : F) ^ Module.finrank F L :=
            Algebra.norm_algebraMap (v : F)
          have hpow : addVal F ((v : F) ^ Module.finrank F L) =
              (Module.finrank F L : ℤ) * addVal F v := by
            change Multiplicative.toAdd (addValHom (v ^ Module.finrank F L)) = _
            rw [map_pow, toAdd_pow, nsmul_eq_mul]
            rfl
          rw [relVal, hnorm, hpow, hv, mul_one]
        obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
        exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
      obtain ⟨hf_pos, π_ex, hπ_ex⟩ := resDeg_mem
      have relVal_eq_resDeg_mul_valL_aux :
          ∀ v : Lˣ, relVal F L v = (resDeg F L : ℤ) * valL F L v := by
        intro v
        let q₀ := relVal F L v / (resDeg F L : ℤ)
        let r₀ := relVal F L v % (resDeg F L : ℤ)
        have hdiv : r₀ + (resDeg F L : ℤ) * q₀ = relVal F L v := Int.emod_add_mul_ediv _ _
        have hr0 : 0 ≤ r₀ := Int.emod_nonneg _ (by positivity)
        have hrlt : r₀ < (resDeg F L : ℤ) := Int.emod_lt_of_pos _ (by positivity)
        have hy : relVal F L ((v * π_ex ^ (-q₀) : Lˣ) : L) = r₀ := by
          rw [relVal_units_mul, relVal_units_zpow, hπ_ex]
          linarith
        have hr_eq : r₀ = 0 := by
          by_contra hr_ne
          have hr_pos : 0 < r₀.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
          have hmem : r₀.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k} := by
            refine ⟨hr_pos, ((v * π_ex ^ (-q₀) : Lˣ) : L), Units.ne_zero _, ?_⟩
            rw [hy, Int.toNat_of_nonneg hr0]
          have hle : resDeg F L ≤ r₀.toNat := Nat.sInf_le hmem
          omega
        change relVal F L v = (resDeg F L : ℤ) * q₀
        linarith
      have relVal_eq : ∀ {x : L} (hx : x ≠ 0), relVal F L x = (resDeg F L : ℤ) * valL F L x :=
        fun hx => relVal_eq_resDeg_mul_valL_aux (Units.mk0 _ hx)
      have valL_mul : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
          valL F L (x * y) = valL F L x + valL F L y := by
        intro x y hx hy
        have hxy : x * y ≠ 0 := mul_ne_zero hx hy
        have h := relVal_mul hx hy
        rw [relVal_eq hxy, relVal_eq hx, relVal_eq hy, ← mul_add] at h
        exact mul_left_cancel₀ (by positivity) h
      have valL_one : valL F L 1 = 0 := by
        have h1 : (1 : L) ≠ 0 := one_ne_zero
        have h := valL_mul h1 h1
        rw [mul_one] at h
        omega
      have valL_div : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
          valL F L (x / y) = valL F L x - valL F L y := by
        intro x y hx hy
        have hxy : x / y ≠ 0 := div_ne_zero hx hy
        have h := valL_mul hxy hy
        rw [div_mul_cancel₀ _ hy] at h
        omega
      have h_int_aux : ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E] (x : E),
          IsIntegral 𝒪[F] x ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x) := by
        intro E _ _ _ x
        constructor
        · intro hx
          by_cases hx0 : x = 0
          · exact Or.inl hx0
          · right
            have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
            have hnorm_int : IsIntegral 𝒪[F] (Algebra.norm F x) := Algebra.isIntegral_norm F hx
            have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
              (Valuation.Integers.isIntegral_iff_v_le_one
                (Valuation.integer.integers (valuation F))).mp hnorm_int
            exact (addVal_nonneg_iff_val_le_one hnorm0).mpr hval_le
        · rintro (rfl | h_rel)
          · exact isIntegral_zero
          · by_cases hx0 : x = 0
            · rw [hx0]
              exact isIntegral_zero
            · have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
              have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
                (addVal_nonneg_iff_val_le_one hnorm0).mp h_rel
              have hx_int_F : IsIntegral F x := Algebra.IsIntegral.isIntegral x
              let pb : PowerBasis F (IntermediateField.adjoin F ({x} : Set E)) :=
                IntermediateField.adjoin.powerBasis hx_int_F
              have h_gen_coe : (pb.gen : E) = x := IntermediateField.AdjoinSimple.coe_gen F x
              set dK : ℕ := Module.finrank (IntermediateField.adjoin F ({x} : Set E)) E
              have h_finrank_pos : 0 < dK := Module.finrank_pos
              have h_norm_tower : Algebra.norm F x = (Algebra.norm F pb.gen) ^ dK := by
                have h1 : Algebra.norm F (pb.gen : E) = (Algebra.norm F pb.gen) ^ dK := by
                  rw [← Algebra.norm_norm (R := F) (S := IntermediateField.adjoin F ({x} : Set E))
                    (A := E) (a := (pb.gen : E)), ← map_pow]
                  congr 1
                  exact Algebra.norm_algebraMap (L := E) pb.gen
                rwa [h_gen_coe] at h1
              have h_norm_pb : Algebra.norm F pb.gen =
                  (-1) ^ pb.dim * (minpoly F pb.gen).coeff 0 :=
                Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb
              have h_minpoly_eq : minpoly F pb.gen = minpoly F x := by
                have h1 : minpoly F pb.gen = minpoly F (pb.gen : E) :=
                  (minpoly.algHom_eq
                    (IntermediateField.val (IntermediateField.adjoin F ({x} : Set E)))
                    (IntermediateField.val (IntermediateField.adjoin F ({x} : Set E))).injective
                    pb.gen).symm
                rwa [h_gen_coe] at h1
              letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
              haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
              haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
              letI : Valued F (ValueGroupWithZero F) :=
                IsValuativeTopology.instValuedValueGroupWithZeroOfIsUniformAddGroup
              let rlo : RankLeOneStruct F :=
                { emb := (WithZeroMulInt.toNNReal (by norm_num : (2 : NNReal) ≠ 0)).comp
                    (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).toMonoidWithZeroHom
                  strictMono := (WithZeroMulInt.toNNReal_strictMono (by norm_num : (1 : NNReal) < 2)).comp
                    (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).strictMono }
              haveI : (Valued.v (R := F)).RankOne := Valuation.RankOne.ofRankLeOneStruct rlo
              letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
              haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F (ValueGroupWithZero F)
              have hnorm_norm_le : ‖Algebra.norm F x‖ ≤ 1 :=
                Valued.toNormedField.norm_le_one_iff.mpr hval_le
              have h_norm_coeff_pow : ‖Algebra.norm F x‖ =
                  ‖(minpoly F x).coeff 0‖ ^ dK := by
                rw [h_norm_tower, h_norm_pb, h_minpoly_eq, norm_pow, norm_mul, norm_pow,
                  norm_neg, norm_one, one_pow, one_mul]
              have h_coeff0_le : ‖(minpoly F x).coeff 0‖ ≤ 1 := by
                rw [h_norm_coeff_pow] at hnorm_norm_le
                exact (pow_le_one_iff_of_nonneg (norm_nonneg _) h_finrank_pos.ne').mp hnorm_norm_le
              have h_spec_le : spectralValue (minpoly F x) ≤ 1 := by
                change spectralNorm F E x ≤ 1
                rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow F E x]
                exact Real.rpow_le_one (norm_nonneg _) h_coeff0_le (by positivity)
              have h_all_coeffs : ∀ n : ℕ, ‖(minpoly F x).coeff n‖ ≤ 1 :=
                (spectralValue_le_one_iff (minpoly.monic hx_int_F)).mp h_spec_le
              have h_lifts : minpoly F x ∈ Polynomial.lifts (algebraMap 𝒪[F] F) := by
                rw [Polynomial.lifts_iff_coeff_lifts]
                intro n
                have hv : valuation F ((minpoly F x).coeff n) ≤ 1 :=
                  Valued.toNormedField.norm_le_one_iff.mp (h_all_coeffs n)
                exact ⟨⟨(minpoly F x).coeff n, hv⟩, rfl⟩
              obtain ⟨P₀, hP₀_map, -, hP₀_monic⟩ :=
                Polynomial.lifts_and_degree_eq_and_monic h_lifts (minpoly.monic hx_int_F)
              refine ⟨P₀, hP₀_monic, ?_⟩
              have h_eval : Polynomial.aeval x (P₀.map (algebraMap 𝒪[F] F)) = 0 := by
                rw [hP₀_map]
                exact minpoly.aeval F x
              rwa [Polynomial.aeval_map_algebraMap] at h_eval
      have h_int : ∀ z : L, IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ relVal F L z := h_int_aux L
      have h_int_valL : ∀ {z : L} (hz : z ≠ 0), IsIntegral 𝒪[F] z ↔ 0 ≤ valL F L z := by
        intro z hz
        rw [h_int, or_iff_right hz, relVal_eq hz]
        exact ⟨fun h => nonneg_of_mul_nonneg_right h (by positivity),
          fun h => mul_nonneg (by positivity) h⟩
      have relVal_algebraMap : ∀ {c : F} (hc : c ≠ 0),
