      · have h_not_lt : ¬ ((i : ℕ) + 1 < q) := by omega
        have hj_ne_q : (j : ℕ) ≠ q := by omega
        rw [if_neg h_not_lt, if_pos hi_end]
        dsimp [P, Q]
        rw [Polynomial.coeff_add, Polynomial.coeff_sub, Polynomial.coeff_X_pow,
