        rcases Nat.eq_zero_or_pos n₀ with rfl | hn0_pos
        · simp
        · have h_w1 : 2 ≤ valL F M (galApply F hLM (τ ^ (p F)) π_M - π_M) := by
            simpa using (h_pow_ne_and_ge 1 (by omega)).2
