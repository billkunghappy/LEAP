    rw [hDiter_map, Polynomial.map_sub, Polynomial.map_comp, Polynomial.map_comp,
      hfn_map, hϕb_map]
  let A_r_R : Polynomial R := ϕ_a_R %ₘ f_n_R
  let B_r_R : Polynomial R := ϕ_b_R %ₘ f_n_R
  have hAr_map : A_r_R.map ι = ϕ_a %ₘ f_n := by
    dsimp [A_r_R]
    rw [Polynomial.map_modByMonic ι hf_n_R, hϕa_map, hfn_map]
  have hBr_map : B_r_R.map ι = ϕ_b %ₘ f_n := by
    dsimp [B_r_R]
    rw [Polynomial.map_modByMonic ι hf_n_R, hϕb_map, hfn_map]
  obtain ⟨U_a_R, hUa_eq⟩ := (hpoly_m_iff (P_a - ϕ_a %ₘ f_n)).mp hPa
  obtain ⟨U_b_R, hUb_eq⟩ := (hpoly_m_iff (P_b - ϕ_b %ₘ f_n)).mp hPb
  let P_a_R : Polynomial R := A_r_R + Polynomial.C (π_R ^ m) * U_a_R
  let P_b_R : Polynomial R := B_r_R + Polynomial.C (π_R ^ m) * U_b_R
  have hC_πm_map : (Polynomial.C (π_R ^ m)).map ι = Polynomial.C (π ^ m) := by
    rw [Polynomial.map_C]
    rfl
  have hPa_map : P_a_R.map ι = P_a := by
    dsimp [P_a_R]
    rw [Polynomial.map_add, Polynomial.map_mul, hAr_map, hC_πm_map, ← hUa_eq, add_sub_cancel]
  have hPb_map : P_b_R.map ι = P_b := by
    dsimp [P_b_R]
    rw [Polynomial.map_add, Polynomial.map_mul, hBr_map, hC_πm_map, ← hUb_eq, add_sub_cancel]
  let I : Ideal (Polynomial R) := Ideal.span {Polynomial.C (π_R ^ m), f_n_R}
  have hC_I : Polynomial.C (π_R ^ m) ∈ I := Ideal.mem_span_pair.mpr ⟨1, 0, by ring⟩
  have hf_I : f_n_R ∈ I := Ideal.mem_span_pair.mpr ⟨0, 1, by ring⟩
  have hdvd_I : ∀ {x y : Polynomial R}, x ∈ I → x ∣ y → y ∈ I := by
    rintro x y hx ⟨c, rfl⟩
    exact I.mul_mem_right c hx
  have h_comp_dvd : ∀ (G X₁ X₂ : Polynomial R), X₁ - X₂ ∣ G.comp X₁ - G.comp X₂ := by
    intro G X₁ X₂
    induction G using Polynomial.induction_on' with
    | add p q hp hq =>
      rw [Polynomial.add_comp, Polynomial.add_comp, add_sub_add_comm]
      exact dvd_add hp hq
    | monomial k c =>
      rw [Polynomial.monomial_comp, Polynomial.monomial_comp, ← mul_sub]
      exact dvd_mul_of_dvd_right (sub_dvd_pow_sub_pow X₁ X₂ k) (Polynomial.C c)
  have hg_cong : ∀ k : ℕ, Polynomial.C π_R ∣ g_R k - Polynomial.X ^ (qL F L ^ k) := by
    intro k
    induction k with
    | zero =>
      change Polynomial.C π_R ∣ Polynomial.X - Polynomial.X ^ (qL F L ^ 0)
      rw [pow_zero, pow_one, sub_self]
      exact dvd_zero _
    | succ k ih =>
      change Polynomial.C π_R ∣ f₀_R.comp (g_R k) - Polynomial.X ^ (qL F L ^ (k + 1))
      have h_expand : f₀_R.comp (g_R k) = Polynomial.C π_R * g_R k + (g_R k) ^ qL F L := by
        dsimp [f₀_R]
        rw [Polynomial.add_comp, Polynomial.mul_comp, Polynomial.C_comp, Polynomial.X_comp,
          Polynomial.X_pow_comp]
      have h_pow : (Polynomial.X : Polynomial R) ^ (qL F L ^ (k + 1)) =
          (Polynomial.X ^ (qL F L ^ k)) ^ qL F L := by
        rw [pow_succ, pow_mul]
      have h_eq : f₀_R.comp (g_R k) - Polynomial.X ^ (qL F L ^ (k + 1)) =
          Polynomial.C π_R * g_R k + ((g_R k) ^ qL F L - (Polynomial.X ^ (qL F L ^ k)) ^ qL F L) := by
        rw [h_expand, h_pow, add_sub_assoc]
      rw [h_eq]
      refine dvd_add (dvd_mul_right (Polynomial.C π_R) (g_R k)) ?_
      exact dvd_trans ih (sub_dvd_pow_sub_pow (g_R k) (Polynomial.X ^ (qL F L ^ k)) (qL F L))
  have hXpow_I : (Polynomial.X : Polynomial R) ^ (m * (qL F L) ^ n) ∈ I := by
    obtain ⟨H₀, hH₀⟩ := hg_cong n
    change f_n_R - Polynomial.X ^ (qL F L ^ n) = Polynomial.C π_R * H₀ at hH₀
    let H : Polynomial R := -H₀
    have hfn_sub : (Polynomial.X : Polynomial R) ^ (qL F L ^ n) - Polynomial.C π_R * H = f_n_R := by
      dsimp [H]
      linear_combination -hH₀
    have hdvd_m :=
      sub_dvd_pow_sub_pow ((Polynomial.X : Polynomial R) ^ (qL F L ^ n)) (Polynomial.C π_R * H) m
    rw [hfn_sub, ← pow_mul, mul_comm (qL F L ^ n) m, mul_pow, ← Polynomial.C_pow] at hdvd_m
    obtain ⟨W, hW⟩ := hdvd_m
    rw [Ideal.mem_span_pair]
    refine ⟨H ^ m, W, ?_⟩
    linear_combination -hW
  have hvan_I : ∀ D : Polynomial R, (∀ k ≤ r, D.coeff k = 0) → D ∈ I := by
    intro D hD
    apply hdvd_I hXpow_I
    rw [Polynomial.X_pow_dvd_iff]
    intro d hd
    exact hD d (by omega)
  have hDab_I : D_ab_R ∈ I := hvan_I D_ab_R hDab_van
  have hDiter_I : D_iter_R ∈ I := hvan_I D_iter_R hDiter_van
  have hT1 : P_a_R.comp P_b_R - A_r_R.comp P_b_R ∈ I := by
    have h1 : P_a_R.comp P_b_R - A_r_R.comp P_b_R =
        Polynomial.C (π_R ^ m) * U_a_R.comp P_b_R := by
      dsimp [P_a_R]
      rw [Polynomial.add_comp, Polynomial.mul_comp, Polynomial.C_comp, add_sub_cancel_left]
    rw [h1]
    exact I.mul_mem_right _ hC_I
  have hT2 : A_r_R.comp P_b_R - A_r_R.comp B_r_R ∈ I := by
    have hsub : P_b_R - B_r_R ∈ I := by
      have h1 : P_b_R - B_r_R = Polynomial.C (π_R ^ m) * U_b_R := add_sub_cancel_left _ _
      rw [h1]
      exact I.mul_mem_right _ hC_I
    exact hdvd_I hsub (h_comp_dvd A_r_R P_b_R B_r_R)
  have hT3 : A_r_R.comp B_r_R - A_r_R.comp ϕ_b_R ∈ I := by
    have hdiv := Polynomial.modByMonic_add_div ϕ_b_R hf_n_R
    have hsub : B_r_R - ϕ_b_R = -(f_n_R * (ϕ_b_R /ₘ f_n_R)) := by
      dsimp [B_r_R]
      linear_combination hdiv
    have hsub_I : B_r_R - ϕ_b_R ∈ I := by
      rw [hsub]
      exact I.neg_mem (I.mul_mem_right _ hf_I)
    exact hdvd_I hsub_I (h_comp_dvd A_r_R B_r_R ϕ_b_R)
  have hT4 : A_r_R.comp ϕ_b_R - ϕ_a_R.comp ϕ_b_R ∈ I := by
    have hdiv := Polynomial.modByMonic_add_div ϕ_a_R hf_n_R
    have hsub : A_r_R - ϕ_a_R = -(f_n_R * (ϕ_a_R /ₘ f_n_R)) := by
      dsimp [A_r_R]
      linear_combination hdiv
    have hcomp : A_r_R.comp ϕ_b_R - ϕ_a_R.comp ϕ_b_R =
        -(f_n_R.comp ϕ_b_R * (ϕ_a_R /ₘ f_n_R).comp ϕ_b_R) := by
      rw [← Polynomial.sub_comp, hsub, Polynomial.neg_comp, Polynomial.mul_comp]
    have hϕb_comp0 : ϕ_b_R.comp 0 = 0 := by
      rw [Polynomial.comp_zero, ← Polynomial.coeff_zero_eq_eval_zero, hϕb_R_0, Polynomial.C_0]
    have hϕb_fn_dvd : f_n_R ∣ ϕ_b_R.comp f_n_R := by
      have hd := h_comp_dvd ϕ_b_R f_n_R 0
      rwa [sub_zero, hϕb_comp0, sub_zero] at hd
    have hϕb_fn_I : ϕ_b_R.comp f_n_R ∈ I := hdvd_I hf_I hϕb_fn_dvd
    have hfn_ϕb_I : f_n_R.comp ϕ_b_R ∈ I := by
      have heq : f_n_R.comp ϕ_b_R = ϕ_b_R.comp f_n_R + D_iter_R := by
        rw [hDiter_eq, add_sub_cancel]
      rw [heq]
      exact I.add_mem hϕb_fn_I hDiter_I
    rw [hcomp]
    exact I.neg_mem (I.mul_mem_right _ hfn_ϕb_I)
  have hT5 : ϕ_ab_R - ϕ_a_R.comp ϕ_b_R ∈ I := by
    have heq : ϕ_ab_R - ϕ_a_R.comp ϕ_b_R = D_ab_R := add_sub_cancel_left _ _
    rw [heq]
    exact hDab_I
  have h_tot_I : P_a_R.comp P_b_R - ϕ_ab_R ∈ I := by
    have h_tel : P_a_R.comp P_b_R - ϕ_ab_R =
        (P_a_R.comp P_b_R - A_r_R.comp P_b_R) +
        (A_r_R.comp P_b_R - A_r_R.comp B_r_R) +
        (A_r_R.comp B_r_R - A_r_R.comp ϕ_b_R) +
        (A_r_R.comp ϕ_b_R - ϕ_a_R.comp ϕ_b_R) -
        (ϕ_ab_R - ϕ_a_R.comp ϕ_b_R) := by ring
    rw [h_tel]
    exact I.sub_mem (I.add_mem (I.add_mem (I.add_mem hT1 hT2) hT3) hT4) hT5
  obtain ⟨U₀, V₀, hUV⟩ := Ideal.mem_span_pair.mp h_tot_I
  have hmod_V₀ : (V₀ * f_n_R) %ₘ f_n_R = 0 :=
    (Polynomial.modByMonic_eq_zero_iff_dvd hf_n_R).mpr (dvd_mul_left f_n_R V₀)
  have hmod_C_mul : ∀ {R₀ : Type u} [CommRing R₀] (c : R₀) (P Q : Polynomial R₀),
      (P * Polynomial.C c) %ₘ Q = Polynomial.C c * (P %ₘ Q) := by
    intro R₀ _ c P Q
    rw [mul_comm, Polynomial.C_mul', ← Polynomial.modByMonicHom_apply, LinearMap.map_smul,
      Polynomial.modByMonicHom_apply, ← Polynomial.C_mul']
  have hmod_U₀ : (U₀ * Polynomial.C (π_R ^ m)) %ₘ f_n_R =
      Polynomial.C (π_R ^ m) * (U₀ %ₘ f_n_R) :=
    hmod_C_mul (π_R ^ m) U₀ f_n_R
  have hmod_eq : (P_a_R.comp P_b_R) %ₘ f_n_R - ϕ_ab_R %ₘ f_n_R =
      Polynomial.C (π_R ^ m) * (U₀ %ₘ f_n_R) := by
    rw [← Polynomial.sub_modByMonic, ← hUV, Polynomial.add_modByMonic, hmod_U₀, hmod_V₀,
      add_zero]
  have hmap_mod_eq := congrArg (Polynomial.map ι) hmod_eq
  rw [Polynomial.map_sub, Polynomial.map_modByMonic ι hf_n_R,
    Polynomial.map_modByMonic ι hf_n_R, Polynomial.map_comp,
    hPa_map, hPb_map, hfn_map, hϕab_map,
    Polynomial.map_mul, hC_πm_map] at hmap_mod_eq
  exact (hpoly_m_iff _).mpr ⟨U₀ %ₘ f_n_R, hmap_mod_eq⟩

theorem aeval_lubinTateEndoPoly_mul_isLubinTateRoot (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (a b : L) (ha : 0 ≤ valL F L a) (hb : 0 ≤ valL F L b) (n : ℕ) (α : AlgebraicClosure F)
    (hα : isLubinTateRoot F L (chosenUniformizer F L) n α) :
    Polynomial.aeval α (lubinTateEndoPoly F L (chosenUniformizer F L : L) (a * b) n) =
      Polynomial.aeval (Polynomial.aeval α (lubinTateEndoPoly F L (chosenUniformizer F L : L) b n))
        (lubinTateEndoPoly F L (chosenUniformizer F L : L) a n) :=
by
  let π₀ := chosenUniformizer F L
  let π : L := (π₀ : L)
  have addVal_mul : ∀ {x y : F}, x ≠ 0 → y ≠ 0 → addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Lˣ, Multiplicative.toAdd (relValHom u) = relVal F L u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : Lˣ,
      relVal F L ((u * v : Lˣ) : L) = relVal F L u + relVal F L v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : Lˣ) (k : ℤ),
      relVal F L ((u ^ k : Lˣ) : L) = k * relVal F L u := by
    intro u k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨c, hc⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F c) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hc]
      exact hg
    have hc0 : c ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 c hc0, ?_⟩
    simp only [Units.val_mk0, addVal, hc0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F c))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F L ∧ ∃ π' : Lˣ, relVal F L π' = resDeg F L := by
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L u,
        (map_ne_zero (algebraMap F L)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (u : F)) = (u : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (u : F)
      have hpow : addVal F ((u : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F u := by
        change Multiplicative.toAdd (addValHom (u ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hf_pos, π', hπ'⟩ := resDeg_mem
  have hf_ne : (resDeg F L : ℤ) ≠ 0 := by positivity
  have hres_ne : resDeg F L ≠ 0 := by omega
  have relVal_eq_resDeg_mul_valL_aux : ∀ u : Lˣ, relVal F L u = (resDeg F L : ℤ) * valL F L u := by
    intro u
    let q₀ := relVal F L u / (resDeg F L : ℤ)
    let r₀ := relVal F L u % (resDeg F L : ℤ)
    have hdiv : r₀ + (resDeg F L : ℤ) * q₀ = relVal F L u := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r₀ := Int.emod_nonneg _ (by positivity)
    have hrlt : r₀ < (resDeg F L : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F L ((u * π' ^ (-q₀) : Lˣ) : L) = r₀ := by
      rw [relVal_units_mul, relVal_units_zpow, hπ']
      linarith
    have hr_eq : r₀ = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r₀.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r₀.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k} := by
        refine ⟨hr_pos, ((u * π' ^ (-q₀) : Lˣ) : L), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F L ≤ r₀.toNat := Nat.sInf_le hmem
      omega
    change relVal F L u = (resDeg F L : ℤ) * q₀
    linarith
  have hab : 0 ≤ valL F L (a * b) := by
    by_cases ha0 : a = 0
    · rw [ha0, zero_mul]
      rw [ha0] at ha
      exact ha
    · by_cases hb0 : b = 0
      · rw [hb0, mul_zero]
        rw [hb0] at hb
        exact hb
      · let ua : Lˣ := Units.mk0 a ha0
        let ub : Lˣ := Units.mk0 b hb0
        have hua : (ua : L) = a := rfl
        have hub : (ub : L) = b := rfl
        have huab : ((ua * ub : Lˣ) : L) = a * b := rfl
        have hrel := relVal_eq_resDeg_mul_valL_aux (ua * ub)
        rw [relVal_units_mul, relVal_eq_resDeg_mul_valL_aux ua,
          relVal_eq_resDeg_mul_valL_aux ub, huab, hua, hub] at hrel
        have hval_mul : valL F L (a * b) = valL F L a + valL F L b := by
          apply mul_left_cancel₀ hf_ne
          linarith
        omega
  set P_a := lubinTateEndoPoly F L π a n
  set P_b := lubinTateEndoPoly F L π b n
  set P_ab := lubinTateEndoPoly F L π (a * b) n
  set f_n := lubinTateIterPoly F L π n
  have hPa : IsLubinTateEndoPoly F L π a n P_a :=
    Classical.epsilon_spec (exists_isLubinTateEndoPoly F L a ha n)
  have hPb : IsLubinTateEndoPoly F L π b n P_b :=
    Classical.epsilon_spec (exists_isLubinTateEndoPoly F L b hb n)
  have hPab : IsLubinTateEndoPoly F L π (a * b) n P_ab :=
    Classical.epsilon_spec (exists_isLubinTateEndoPoly F L (a * b) hab n)
  have h_diff_val : ∀ m : ℕ, polyValLe F L m (P_ab - (P_a.comp P_b) %ₘ f_n) := by
    intro m
    let r := m * (qL F L) ^ n
    have hmr : m * (qL F L) ^ n ≤ r := le_refl r
    obtain ⟨hϕa, hϕa0, ⟨h_ab_int, h_ab_vanish⟩, ⟨h_iter_int, h_iter_vanish⟩⟩ :=
      lubinTateEndoTrunc_mul_and_iter_comm F L a b ha hb n r
    obtain ⟨hϕb, hϕb0, -, -⟩ :=
      lubinTateEndoTrunc_mul_and_iter_comm F L b a hb ha n r
    have hPa_m : polyValLe F L m (P_a - lubinTateEndoTrunc F L π a r %ₘ f_n) :=
      hPa.2 m r hmr
    have hPb_m : polyValLe F L m (P_b - lubinTateEndoTrunc F L π b r %ₘ f_n) :=
      hPb.2 m r hmr
    have hPab_m : polyValLe F L m (P_ab - lubinTateEndoTrunc F L π (a * b) r %ₘ f_n) :=
      hPab.2 m r hmr
    have h_comp_m : polyValLe F L m
        ((P_a.comp P_b) %ₘ f_n - lubinTateEndoTrunc F L π (a * b) r %ₘ f_n) :=
      polyValLe_comp_modByMonic_sub_of_trunc_comm F L n m r hmr
        (lubinTateEndoTrunc F L π a r)
        (lubinTateEndoTrunc F L π b r)
        (lubinTateEndoTrunc F L π (a * b) r)
        P_a P_b
        hϕa hϕa0 hϕb hϕb0 h_ab_int h_ab_vanish h_iter_int h_iter_vanish hPa_m hPb_m
    have h_sub := (polyValLe_add_and_sub F L m _ _ hPab_m h_comp_m).2
    rwa [sub_sub_sub_cancel_right] at h_sub
  have h_poly_eq : P_ab = (P_a.comp P_b) %ₘ f_n := by
    apply Polynomial.ext
    intro k
    set d := (P_ab - (P_a.comp P_b) %ₘ f_n).coeff k
    have hd : d = 0 := by
      rcases h_diff_val (valL F L d + 1).toNat k with h0 | hle
      · exact h0
      · change ((valL F L d + 1).toNat : ℤ) ≤ valL F L d at hle
        omega
    change (P_ab - (P_a.comp P_b) %ₘ f_n).coeff k = 0 at hd
    rw [Polynomial.coeff_sub] at hd
    exact sub_eq_zero.mp hd
  have hq : 1 < q F := by
    unfold q
    exact Finite.one_lt_card
  have hqL : 1 < qL F L := Nat.one_lt_pow hres_ne hq
  let f := lubinTatePoly F L π
  have hdeg_lt : (Polynomial.C π * Polynomial.X).degree <
      (Polynomial.X ^ qL F L : Polynomial L).degree := by
    calc (Polynomial.C π * Polynomial.X).degree
        ≤ 1 := Polynomial.degree_C_mul_X_le π
      _ < (qL F L : WithBot ℕ) := by exact_mod_cast hqL
      _ = (Polynomial.X ^ qL F L : Polynomial L).degree :=
          (Polynomial.degree_X_pow (qL F L)).symm
  have hf_monic : f.Monic := by
    change (Polynomial.C π * Polynomial.X + Polynomial.X ^ qL F L).Monic
    exact (Polynomial.monic_X_pow (qL F L)).add_of_right hdeg_lt
  have hf_deg : f.natDegree ≠ 0 := by
    have hdeg_eq : f.degree = (Polynomial.X ^ qL F L : Polynomial L).degree := by
      change (Polynomial.C π * Polynomial.X + Polynomial.X ^ qL F L).degree = _
      exact Polynomial.degree_add_eq_right_of_degree_lt hdeg_lt
    have hnd : f.natDegree = qL F L := by
      rw [Polynomial.natDegree_eq_of_degree_eq hdeg_eq, Polynomial.natDegree_X_pow]
    omega
  have hfn_monic_deg : ∀ k : ℕ,
      (lubinTateIterPoly F L π k).Monic ∧ (lubinTateIterPoly F L π k).natDegree ≠ 0 := by
    intro k
    induction k with
    | zero =>
      dsimp [lubinTateIterPoly]
      exact ⟨Polynomial.monic_X, by simp⟩
    | succ k ih =>
      dsimp [lubinTateIterPoly]
      refine ⟨hf_monic.comp ih.1 ih.2, ?_⟩
      rw [Polynomial.natDegree_comp]
      exact mul_ne_zero hf_deg ih.2
  have hfn_monic : f_n.Monic := (hfn_monic_deg n).1
  let g : AlgebraicClosure F → AlgebraicClosure F :=
    fun y => ((π : L) : AlgebraicClosure F) * y + y ^ qL F L
  have haeval_f : ∀ y : AlgebraicClosure F, Polynomial.aeval y f = g y := by
    intro y
    dsimp [f, lubinTatePoly, g]
    rw [Polynomial.aeval_def, Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C,
      Polynomial.eval₂_X, Polynomial.eval₂_X_pow]
    rfl
  have haeval_iter : ∀ (k : ℕ) (y : AlgebraicClosure F),
      Polynomial.aeval y (lubinTateIterPoly F L π k) = (g^[k]) y := by
    intro k
    induction k with
    | zero =>
      intro y
      dsimp [lubinTateIterPoly]
      exact Polynomial.aeval_X y
    | succ k ih =>
      intro y
      dsimp [lubinTateIterPoly]
      rw [Polynomial.aeval_comp, ih y, haeval_f]
      exact (Function.iterate_succ_apply' g k y).symm
  have haeval_fn : Polynomial.aeval α f_n = 0 := by
    rw [haeval_iter n α]
    exact hα
  have h_div := Polynomial.modByMonic_add_div (P_a.comp P_b) hfn_monic
  have h_aeval_div := congrArg (Polynomial.eval₂ (algebraMap L (AlgebraicClosure F)) α) h_div
  simp only [Polynomial.eval₂_add, Polynomial.eval₂_mul, ← Polynomial.aeval_def, haeval_fn,
    zero_mul, add_zero, Polynomial.aeval_comp] at h_aeval_div
  rw [h_poly_eq]
  exact h_aeval_div

theorem aeval_sub_aeval_lubinTateEndoTrunc_eq_pow_mul_isIntegralOverValL (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (ϖ : Lˣ) (hϖ : valL F L ϖ = 1) (a : L) (n : ℕ) (P : Polynomial L)
    (hP : IsLubinTateEndoPoly F L (ϖ : L) a n P)
    (α : AlgebraicClosure F) (hα : isLubinTateRoot F L ϖ n α) (m : ℕ) :
    ∃ γ : AlgebraicClosure F,
      IsIntegralOverValL F L γ ∧
      Polynomial.aeval α P -
        Polynomial.aeval α (lubinTateEndoTrunc F L (ϖ : L) a (m * (qL F L) ^ n)) =
          ((ϖ : L) : AlgebraicClosure F) ^ m * γ :=
by
  have addVal_mul : ∀ {x y : F}, x ≠ 0 → y ≠ 0 → addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun v => Multiplicative.ofAdd (addVal F v)
      map_one' := by simp [addVal_one]
      map_mul' := fun v w => by simp [addVal_mul v.ne_zero w.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ v : Lˣ, Multiplicative.toAdd (relValHom v) = relVal F L v :=
    fun _ => rfl
  have relVal_units_mul : ∀ v w : Lˣ,
      relVal F L ((v * w : Lˣ) : L) = relVal F L v + relVal F L w := by
    intro v w
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (v : Lˣ) (k : ℤ),
      relVal F L ((v ^ k : Lˣ) : L) = k * relVal F L v := by
    intro v k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have exists_addVal_eq_one : ∃ v : Fˣ, addVal F v = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨c, hc⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F c) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hc]
      exact hg
    have hc0 : c ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 c hc0, ?_⟩
    simp only [Units.val_mk0, addVal, hc0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F c))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F L ∧ ∃ π' : Lˣ, relVal F L π' = resDeg F L := by
    obtain ⟨v, hv⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L v,
        (map_ne_zero (algebraMap F L)).mpr v.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (v : F)) = (v : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (v : F)
      have hpow : addVal F ((v : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F v := by
        change Multiplicative.toAdd (addValHom (v ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hv, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hf_pos, π', hπ'⟩ := resDeg_mem
  have hf_ne : (resDeg F L : ℤ) ≠ 0 := by positivity
  have hres_ne : resDeg F L ≠ 0 := hf_pos.ne'
  have hq_gt : 1 < q F := Finite.one_lt_card
  have hqL_gt : 1 < qL F L := one_lt_pow₀ hq_gt hres_ne
  have relVal_eq_resDeg_mul_valL_aux : ∀ v : Lˣ, relVal F L v = (resDeg F L : ℤ) * valL F L v := by
    intro v
    let q₀ := relVal F L v / (resDeg F L : ℤ)
    let r₀ := relVal F L v % (resDeg F L : ℤ)
    have hdiv : r₀ + (resDeg F L : ℤ) * q₀ = relVal F L v := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r₀ := Int.emod_nonneg _ (by positivity)
    have hrlt : r₀ < (resDeg F L : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F L ((v * π' ^ (-q₀) : Lˣ) : L) = r₀ := by
      rw [relVal_units_mul, relVal_units_zpow, hπ']
      linarith
    have hr_eq : r₀ = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r₀.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r₀.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k} := by
        refine ⟨hr_pos, ((v * π' ^ (-q₀) : Lˣ) : L), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F L ≤ r₀.toNat := Nat.sInf_le hmem
      omega
    change relVal F L v = (resDeg F L : ℤ) * q₀
    linarith
  have valL_units_mul : ∀ u v : Lˣ,
      valL F L ((u * v : Lˣ) : L) = valL F L u + valL F L v := by
    intro u v
    have hrel := relVal_eq_resDeg_mul_valL_aux (u * v)
    rw [relVal_units_mul, relVal_eq_resDeg_mul_valL_aux u,
      relVal_eq_resDeg_mul_valL_aux v] at hrel
    apply mul_left_cancel₀ hf_ne
    linarith
  have valL_units_zpow : ∀ (u : Lˣ) (k : ℤ),
      valL F L ((u ^ k : Lˣ) : L) = k * valL F L u := by
    intro u k
    have hrel := relVal_eq_resDeg_mul_valL_aux (u ^ k)
    rw [relVal_units_zpow, relVal_eq_resDeg_mul_valL_aux u] at hrel
    apply mul_left_cancel₀ hf_ne
    linarith
  have h_int_iff : ∀ z : L, IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ relVal F L z := by
    have h_aux : ∀ (K : Type u) [Field K] [Algebra F K] [FiniteDimensional F K] (x : K),
        IsIntegral 𝒪[F] x ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x) := by
      intro K _ _ _ x
      have addVal_nonneg_iff_val_le_one : ∀ {b : F} (hb : b ≠ 0),
          0 ≤ addVal F b ↔ valuation F b ≤ 1 := by
        intro b hb
        unfold addVal
        rw [dif_neg hb]
        set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
        set vb := valuation F b
        have hvb_ne : iso vb ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hb)
        constructor
        · intro h_nonneg
          have h_toAdd : Multiplicative.toAdd (WithZero.unzero hvb_ne) ≤ 0 := by omega
          have h_unzero : WithZero.unzero hvb_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
          have h_iso : iso vb ≤ iso 1 := by
            rw [map_one, ← WithZero.coe_unzero hvb_ne, ← WithZero.coe_one]
            exact WithZero.coe_le_coe.mpr h_unzero
          exact (map_le_map_iff iso).mp h_iso
        · intro h_le
          have h_iso : iso vb ≤ iso 1 := (map_le_map_iff iso).mpr h_le
          rw [map_one, ← WithZero.coe_unzero hvb_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
          have h_toAdd : Multiplicative.toAdd (WithZero.unzero hvb_ne) ≤ 0 :=
            Multiplicative.toAdd_le.mpr h_iso
          omega
      constructor
      · intro hx
        by_cases hx0 : x = 0
        · exact Or.inl hx0
        · right
          have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
          have hnorm_int : IsIntegral 𝒪[F] (Algebra.norm F x) := Algebra.isIntegral_norm F hx
          have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
            (Valuation.Integers.isIntegral_iff_v_le_one
              (Valuation.integer.integers (valuation F))).mp hnorm_int
          exact (addVal_nonneg_iff_val_le_one hnorm0).mpr hval_le
      · rintro (rfl | h_rel)
        · exact isIntegral_zero
        · by_cases hx0 : x = 0
          · rw [hx0]
            exact isIntegral_zero
          · have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
            have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
              (addVal_nonneg_iff_val_le_one hnorm0).mp h_rel
            have hx_int_F : IsIntegral F x := Algebra.IsIntegral.isIntegral x
            let pb : PowerBasis F (IntermediateField.adjoin F ({x} : Set K)) :=
              IntermediateField.adjoin.powerBasis hx_int_F
            have h_gen_coe : (pb.gen : K) = x := IntermediateField.AdjoinSimple.coe_gen F x
            set dK : ℕ := Module.finrank (IntermediateField.adjoin F ({x} : Set K)) K
            have h_finrank_pos : 0 < dK := Module.finrank_pos
            have h_norm_tower : Algebra.norm F x = (Algebra.norm F pb.gen) ^ dK := by
              have h1 : Algebra.norm F (pb.gen : K) = (Algebra.norm F pb.gen) ^ dK := by
                rw [← Algebra.norm_norm (R := F) (S := IntermediateField.adjoin F ({x} : Set K))
                  (A := K) (a := (pb.gen : K)), ← map_pow]
                congr 1
                exact Algebra.norm_algebraMap (L := K) pb.gen
              rwa [h_gen_coe] at h1
            have h_norm_pb : Algebra.norm F pb.gen =
                (-1) ^ pb.dim * (minpoly F pb.gen).coeff 0 :=
              Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb
            have h_minpoly_eq : minpoly F pb.gen = minpoly F x := by
              have h1 : minpoly F pb.gen = minpoly F (pb.gen : K) :=
                (minpoly.algHom_eq
                  (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K)))
                  (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K))).injective
                  pb.gen).symm
              rwa [h_gen_coe] at h1
            letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
            haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
            haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
            letI : Valued F (ValueGroupWithZero F) :=
              IsValuativeTopology.instValuedValueGroupWithZeroOfIsUniformAddGroup
            let rlo : RankLeOneStruct F :=
              { emb := (WithZeroMulInt.toNNReal (by norm_num : (2 : NNReal) ≠ 0)).comp
                  (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).toMonoidWithZeroHom
                strictMono := (WithZeroMulInt.toNNReal_strictMono (by norm_num : (1 : NNReal) < 2)).comp
                  (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).strictMono }
            haveI : (Valued.v (R := F)).RankOne := Valuation.RankOne.ofRankLeOneStruct rlo
            letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
            haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F (ValueGroupWithZero F)
            have hnorm_norm_le : ‖Algebra.norm F x‖ ≤ 1 :=
              Valued.toNormedField.norm_le_one_iff.mpr hval_le
            have h_norm_coeff_pow : ‖Algebra.norm F x‖ =
                ‖(minpoly F x).coeff 0‖ ^ dK := by
              rw [h_norm_tower, h_norm_pb, h_minpoly_eq, norm_pow, norm_mul, norm_pow,
                norm_neg, norm_one, one_pow, one_mul]
            have h_coeff0_le : ‖(minpoly F x).coeff 0‖ ≤ 1 := by
              rw [h_norm_coeff_pow] at hnorm_norm_le
              exact (pow_le_one_iff_of_nonneg (norm_nonneg _) h_finrank_pos.ne').mp hnorm_norm_le
            have h_spec_le : spectralValue (minpoly F x) ≤ 1 := by
              change spectralNorm F K x ≤ 1
              rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow F K x]
              exact Real.rpow_le_one (norm_nonneg _) h_coeff0_le (by positivity)
            have h_all_coeffs : ∀ k : ℕ, ‖(minpoly F x).coeff k‖ ≤ 1 :=
              (spectralValue_le_one_iff (minpoly.monic hx_int_F)).mp h_spec_le
            have h_lifts : minpoly F x ∈ Polynomial.lifts (algebraMap 𝒪[F] F) := by
              rw [Polynomial.lifts_iff_coeff_lifts]
              intro k
              have hv : valuation F ((minpoly F x).coeff k) ≤ 1 :=
                Valued.toNormedField.norm_le_one_iff.mp (h_all_coeffs k)
              exact ⟨⟨(minpoly F x).coeff k, hv⟩, rfl⟩
            obtain ⟨P₀, hP₀_map, -, hP₀_monic⟩ :=
              Polynomial.lifts_and_degree_eq_and_monic h_lifts (minpoly.monic hx_int_F)
            refine ⟨P₀, hP₀_monic, ?_⟩
            have h_eval : Polynomial.aeval x (P₀.map (algebraMap 𝒪[F] F)) = 0 := by
              rw [hP₀_map]
              exact minpoly.aeval F x
            rwa [Polynomial.aeval_map_algebraMap] at h_eval
    exact h_aux L
  have isIntegral_of_valL_nonneg : ∀ c : L, (c = 0 ∨ 0 ≤ valL F L c) →
      IsIntegral 𝒪[F] (algebraMap L (AlgebraicClosure F) c) := by
    intro c hc
    have hc_L : IsIntegral 𝒪[F] c := by
      rcases hc with rfl | hc_ge
      · exact isIntegral_zero
      · by_cases hc0 : c = 0
        · rw [hc0]
          exact isIntegral_zero
        · apply (h_int_iff c).mpr
          right
          let u_c : Lˣ := Units.mk0 c hc0
          have hrel := relVal_eq_resDeg_mul_valL_aux u_c
          change relVal F L c = (resDeg F L : ℤ) * valL F L c at hrel
          rw [hrel]
          exact mul_nonneg (Nat.cast_nonneg _) hc_ge
    exact IsIntegral.map (IsScalarTower.toAlgHom 𝒪[F] L (AlgebraicClosure F)) hc_L
  have isIntegralOverValL_of_isIntegral : ∀ γ : AlgebraicClosure F,
      IsIntegral 𝒪[F] γ → IsIntegralOverValL F L γ := by
    intro γ ⟨g₀, hg₀_monic, hg₀_eval⟩
    refine ⟨g₀.map (algebraMap 𝒪[F] L), hg₀_monic.map (algebraMap 𝒪[F] L), ?_, ?_⟩
    · rw [Polynomial.aeval_map_algebraMap]
      exact hg₀_eval
    · intro k
      rw [Polynomial.coeff_map]
      have hk_int : IsIntegral 𝒪[F] (algebraMap 𝒪[F] L (g₀.coeff k)) := isIntegral_algebraMap
      rcases (h_int_iff (algebraMap 𝒪[F] L (g₀.coeff k))).mp hk_int with hk0 | hk_rel
      · exact Or.inl hk0
      · right
        rw [valL]
        exact Int.ediv_nonneg hk_rel (Nat.cast_nonneg _)
  have h_gen : ∀ (K E : Type u) [Field K] [Field E] [Algebra K E] (c : K) (q0 : ℕ),
      1 < q0 →
      let f : Polynomial K := Polynomial.C c * Polynomial.X + Polynomial.X ^ q0
      ∀ (g : ℕ → Polynomial K),
        g 0 = Polynomial.X →
        (∀ k, g (k + 1) = f.comp (g k)) →
        ∀ k : ℕ, (g k).Monic ∧ (g k).natDegree = q0 ^ k ∧
          ∀ β : E, Polynomial.aeval β (g k) =
            ((fun y : E => algebraMap K E c * y + y ^ q0)^[k] β) := by
    intro K E _ _ _ c q0 hq0 f g hg0 hgs k
    have hdeg_lt : (Polynomial.C c * Polynomial.X).degree <
        (Polynomial.X ^ q0 : Polynomial K).degree := by
      rw [Polynomial.degree_X_pow]
      exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_le c) (WithBot.coe_lt_coe.mpr hq0)
    have hf_monic : f.Monic := by
      change (Polynomial.C c * Polynomial.X + Polynomial.X ^ q0).Monic
      rw [add_comm]
      exact Polynomial.Monic.add_of_left (Polynomial.monic_X_pow q0) hdeg_lt
    have hf_deg : f.natDegree = q0 := by
      change (Polynomial.C c * Polynomial.X + Polynomial.X ^ q0).natDegree = q0
      rw [add_comm, Polynomial.natDegree_add_eq_left_of_degree_lt hdeg_lt,
        Polynomial.natDegree_X_pow]
    induction k with
    | zero =>
      refine ⟨hg0 ▸ Polynomial.monic_X, ?_, ?_⟩
      · rw [hg0, Polynomial.natDegree_X, pow_zero]
      · intro β
        rw [hg0, Polynomial.aeval_X, Function.iterate_zero_apply]
    | succ k ih =>
      obtain ⟨ih_monic, ih_deg, ih_aeval⟩ := ih
      have h_deg_ne : (g k).natDegree ≠ 0 := by
        rw [ih_deg]
        exact pow_ne_zero k (by omega)
      refine ⟨?_, ?_, ?_⟩
      · rw [hgs k]
        exact hf_monic.comp ih_monic h_deg_ne
      · rw [hgs k, Polynomial.natDegree_comp, hf_deg, ih_deg, pow_succ']
      · intro β
        rw [hgs k, Polynomial.aeval_comp, ih_aeval, Function.iterate_succ_apply']
        change Polynomial.aeval _ (Polynomial.C c * Polynomial.X + Polynomial.X ^ q0) = _
        rw [map_add, map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
  obtain ⟨hfn_monic, _, hfn_aeval⟩ := h_gen ↥L (AlgebraicClosure F) (ϖ : L) (qL F L) hqL_gt
    (lubinTateIterPoly F L (ϖ : L)) rfl (fun _ => rfl) n
  have haeval_fn : Polynomial.aeval α (lubinTateIterPoly F L (ϖ : L) n) = 0 := by
    rw [hfn_aeval α]
    exact hα
  let A : Subalgebra 𝒪[F] (AlgebraicClosure F) := integralClosure 𝒪[F] (AlgebraicClosure F)
  let ϖbar : AlgebraicClosure F := algebraMap L (AlgebraicClosure F) (ϖ : L)
  let g_lt : AlgebraicClosure F → AlgebraicClosure F := fun y => ϖbar * y + y ^ qL F L
  have hϖ_int : IsIntegral 𝒪[F] ϖbar :=
    isIntegral_of_valL_nonneg (ϖ : L) (Or.inr (by rw [hϖ]; omega))
  let w₁ : A := ⟨ϖbar, (mem_integralClosure_iff 𝒪[F] (AlgebraicClosure F)).mpr hϖ_int⟩
  have h_step : ∀ y : AlgebraicClosure F, IsIntegral 𝒪[F] (g_lt y) → IsIntegral 𝒪[F] y := by
    intro y hgy
    let w₀ : A := ⟨g_lt y, (mem_integralClosure_iff 𝒪[F] (AlgebraicClosure F)).mpr hgy⟩
    let Q : Polynomial A := Polynomial.X ^ qL F L + (Polynomial.C w₁ * Polynomial.X - Polynomial.C w₀)
    have hdeg_lt : (Polynomial.C w₁ * Polynomial.X - Polynomial.C w₀).degree <
        (Polynomial.X ^ qL F L : Polynomial A).degree := by
      rw [Polynomial.degree_X_pow]
      have hle1 : (Polynomial.C w₁ * Polynomial.X - Polynomial.C w₀).degree ≤ 1 := by
        refine le_trans (Polynomial.degree_sub_le _ _) (max_le (Polynomial.degree_C_mul_X_le w₁) ?_)
        exact le_trans (Polynomial.degree_C_le) (by decide)
      exact lt_of_le_of_lt hle1 (WithBot.coe_lt_coe.mpr hqL_gt)
    have hQ_monic : Q.Monic :=
      Polynomial.Monic.add_of_left (Polynomial.monic_X_pow (qL F L)) hdeg_lt
    have hQ_eval : Polynomial.aeval y Q = 0 := by
      change Polynomial.aeval y
        (Polynomial.X ^ qL F L + (Polynomial.C w₁ * Polynomial.X - Polynomial.C w₀)) = 0
      rw [Polynomial.aeval_add, Polynomial.aeval_sub, Polynomial.aeval_mul,
        Polynomial.aeval_X_pow, Polynomial.aeval_X, Polynomial.aeval_C, Polynomial.aeval_C]
      change y ^ qL F L + (ϖbar * y - (ϖbar * y + y ^ qL F L)) = 0
      ring
    have hy_A : IsIntegral A y := ⟨Q, hQ_monic, hQ_eval⟩
    exact @isIntegral_trans 𝒪[F] ↥A (AlgebraicClosure F) _ _ _ _ _ _ _ _ y hy_A
  have h_iter_int : ∀ (k : ℕ) (y : AlgebraicClosure F),
      IsIntegral 𝒪[F] (g_lt^[k] y) → IsIntegral 𝒪[F] y := by
    intro k
    induction k with
    | zero =>
      intro y hy
      exact hy
    | succ k ih =>
      intro y hy
      rw [Function.iterate_succ_apply] at hy
      exact h_step y (ih (g_lt y) hy)
  have hα_int : IsIntegral 𝒪[F] α := by
    apply h_iter_int n α
    have hα' : g_lt^[n] α = 0 := hα
    rw [hα']
    exact isIntegral_zero
  let r := m * (qL F L) ^ n
  let ϕ_r := lubinTateEndoTrunc F L (ϖ : L) a r
  let f_n := lubinTateIterPoly F L (ϖ : L) n
  let D := P - ϕ_r %ₘ f_n
  let u_m : Lˣ := ϖ ^ (-(m : ℤ))
  let R : Polynomial L := Polynomial.C (u_m : L) * D
  let γ : AlgebraicClosure F := Polynomial.aeval α R
  have hR_coeff_int : ∀ k : ℕ, IsIntegral 𝒪[F] (algebraMap L (AlgebraicClosure F) (R.coeff k)) := by
    intro k
    apply isIntegral_of_valL_nonneg
    change (Polynomial.C (u_m : L) * D).coeff k = 0 ∨
      0 ≤ valL F L ((Polynomial.C (u_m : L) * D).coeff k)
    rw [Polynomial.coeff_C_mul]
    set d := D.coeff k
    by_cases hd0 : d = 0
    · left
      rw [hd0, mul_zero]
    · right
      have hd_val : (m : ℤ) ≤ valL F L d := by
        rcases hP.2 m r (le_refl r) k with hd_eq | hd_ge
        · exact False.elim (hd0 hd_eq)
        · exact hd_ge
      let u_d : Lˣ := Units.mk0 d hd0
      have h_eq_unit : (u_m : L) * d = ((u_m * u_d : Lˣ) : L) := rfl
      have h_ud_val : valL F L (u_d : L) = valL F L d := rfl
      rw [h_eq_unit, valL_units_mul, valL_units_zpow, hϖ, h_ud_val]
      omega
  have hγ_mem : γ ∈ A := by
    change Polynomial.aeval α R ∈ A
    rw [Polynomial.aeval_def, Polynomial.eval₂_eq_sum_range]
    apply A.sum_mem
    intro i _
    apply A.mul_mem
    · exact (mem_integralClosure_iff 𝒪[F] (AlgebraicClosure F)).mpr (hR_coeff_int i)
    · exact A.pow_mem ((mem_integralClosure_iff 𝒪[F] (AlgebraicClosure F)).mpr hα_int) i
  have hγ_int : IsIntegral 𝒪[F] γ :=
    (mem_integralClosure_iff 𝒪[F] (AlgebraicClosure F)).mp hγ_mem
  refine ⟨γ, isIntegralOverValL_of_isIntegral γ hγ_int, ?_⟩
  have h_mod_eval : Polynomial.aeval α (ϕ_r %ₘ f_n) = Polynomial.aeval α ϕ_r := by
    have h_div := congrArg (Polynomial.aeval α) (Polynomial.modByMonic_add_div ϕ_r hfn_monic)
    rw [Polynomial.aeval_add, Polynomial.aeval_mul, haeval_fn, zero_mul, add_zero] at h_div
    exact h_div
  have h_D_eval : Polynomial.aeval α P - Polynomial.aeval α ϕ_r = Polynomial.aeval α D := by
    change Polynomial.aeval α P - Polynomial.aeval α ϕ_r = Polynomial.aeval α (P - ϕ_r %ₘ f_n)
    rw [Polynomial.aeval_sub, h_mod_eval]
  have h_unit_cancel : (ϖ : L) ^ m * (u_m : L) = 1 := by
    change ((ϖ ^ (m : ℤ) * ϖ ^ (-(m : ℤ)) : Lˣ) : L) = 1
    rw [← zpow_add, add_neg_cancel, zpow_zero, Units.val_one]
  have h_D_eq : D = Polynomial.C ((ϖ : L) ^ m) * R := by
    change D = Polynomial.C ((ϖ : L) ^ m) * (Polynomial.C (u_m : L) * D)
    rw [← mul_assoc, ← Polynomial.C_mul, h_unit_cancel, Polynomial.C_1, one_mul]
  rw [h_D_eval, h_D_eq, Polynomial.aeval_mul, Polynomial.aeval_C, map_pow]
  rfl

theorem isIntegralOverValL_of_isIntegral_and_exists_root_isIntegralDivPow (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (π : Lˣ) :
    valL F L π = 1 →
      (∀ γ : AlgebraicClosure F, IsIntegral 𝒪[F] γ → IsIntegralOverValL F L γ) ∧
      (∀ (P : Polynomial L), P.Monic → 1 ≤ P.natDegree →
        ∀ (x : AlgebraicClosure F) (r : ℕ),
          IsIntegralDivPow F L (π : L) (r * P.natDegree) (Polynomial.aeval x P) →
          ∃ β : AlgebraicClosure F,
            Polynomial.aeval β P = 0 ∧ IsIntegralDivPow F L (π : L) r (x - β)) :=
by
  have h_aux : ∀ (K : Type u) [Field K] [Algebra F K] [FiniteDimensional F K] (x : K),
      IsIntegral 𝒪[F] x ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x) := by
    intro K _ _ _ x
    have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
        0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
      intro a ha
      unfold addVal
      rw [dif_neg ha]
      set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
      set va := valuation F a
      have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
      constructor
      · intro h_nonneg
        have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
        have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
        have h_iso : iso va ≤ iso 1 := by
          rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
          exact WithZero.coe_le_coe.mpr h_unzero
        exact (map_le_map_iff iso).mp h_iso
      · intro h_le
        have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
        have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
          Multiplicative.toAdd_le.mpr h_iso
        omega
    constructor
    · intro hx
      by_cases hx0 : x = 0
      · exact Or.inl hx0
      · right
        have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
        have hnorm_int : IsIntegral 𝒪[F] (Algebra.norm F x) := Algebra.isIntegral_norm F hx
        have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
          (Valuation.Integers.isIntegral_iff_v_le_one
            (Valuation.integer.integers (valuation F))).mp hnorm_int
        exact (addVal_nonneg_iff_val_le_one hnorm0).mpr hval_le
    · rintro (rfl | h_rel)
      · exact isIntegral_zero
      · by_cases hx0 : x = 0
        · rw [hx0]
          exact isIntegral_zero
        · have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
          have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
            (addVal_nonneg_iff_val_le_one hnorm0).mp h_rel
          have hx_int_F : IsIntegral F x := Algebra.IsIntegral.isIntegral x
          let pb : PowerBasis F (IntermediateField.adjoin F ({x} : Set K)) :=
            IntermediateField.adjoin.powerBasis hx_int_F
          have h_gen_coe : (pb.gen : K) = x := IntermediateField.AdjoinSimple.coe_gen F x
          set dK : ℕ := Module.finrank (IntermediateField.adjoin F ({x} : Set K)) K
