      rcases (h_int_iff E p).mp hp_int with hp0 | hp_nonneg
      · exact hp_ne hp0
      · omega
    intro P hP_monic hP_deg x r hx
    let πbar : AlgebraicClosure F := algebraMap L (AlgebraicClosure F) (π : L)
    let c : AlgebraicClosure F := πbar ^ r
    let roots : Multiset (AlgebraicClosure F) := P.aroots (AlgebraicClosure F)
    let t : Multiset (AlgebraicClosure F) := roots.map (fun β => (x - β) / c)
    have h_map_div : ∀ s : Multiset (AlgebraicClosure F),
