      have hyx : y * x = 1 := Subtype.ext (inv_mul_cancel₀ hx0)
      rw [← hyx]
      exact J.mul_mem_left y hxJ
  haveI : Finite 𝓀[F] :=
    IsNonarchimedeanLocalField.instFiniteResidueFieldSubtypeMemSubringIntegerValueGroupWithZeroValuation F
  letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  let rep : 𝓀[F] → 𝒪[F] := fun b => (IsLocalRing.residue_surjective b).choose
  have hrep : ∀ b : 𝓀[F], IsLocalRing.residue 𝒪[F] (rep b) = b :=
    fun b => (IsLocalRing.residue_surjective b).choose_spec
  have hsum_int : ∀ b : Fin f₀ → 𝓀[F],
      IsIntegral 𝒪[F] (∑ i : Fin f₀, algebraMap 𝒪[F] L (rep (b i)) * ω i) :=
    fun b => (integralClosure 𝒪[F] L).sum_mem
      fun i _ => (integralClosure 𝒪[F] L).mul_mem isIntegral_algebraMap (hω_int i)
  let Ψ : (Fin f₀ → 𝓀[F]) → (integralClosure 𝒪[F] L ⧸ Ideal.span {π₀}) :=
    fun b => Ideal.Quotient.mk (Ideal.span {π₀})
      ⟨∑ i : Fin f₀, algebraMap 𝒪[F] L (rep (b i)) * ω i, hsum_int b⟩
  have hΨ_inj : Function.Injective Ψ := by
    intro b₁ b₂ hEq
