  have polyInt_zero : polyInt 0 := fun k => by
    rw [Polynomial.coeff_zero]
    exact isIntegral_zero
  have polyInt_one : polyInt 1 := fun k => by
    rw [Polynomial.coeff_one]
    split_ifs <;> [exact isIntegral_one; exact isIntegral_zero]
  have polyInt_X : polyInt Polynomial.X := fun k => by
    rw [Polynomial.coeff_X]
    split_ifs <;> [exact isIntegral_one; exact isIntegral_zero]
  have polyInt_C : ∀ {c : L}, IsIntegral 𝒪[F] c → polyInt (Polynomial.C c) := fun {c} hc k => by
    rw [Polynomial.coeff_C]
