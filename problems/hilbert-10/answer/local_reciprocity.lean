      exact divPow_zero_elem 1
    | succ e ih =>
      have h_id : u_B ^ (e + 1) - u₂ ^ (e + 1) = u₁ * u_B ^ e + u₂ * (u_B ^ e - u₂ ^ e) := by
        dsimp [u_B]
        rw [pow_succ, pow_succ]
        ring
      rw [h_id]
      exact divPow_add
        (divPow_mul_right hu₁_div (IsIntegral.pow huB_int e))
        (divPow_mul_left hu₂_int ih)
  have huBN_div : IsIntegralDivPow F L πL 1 (u_B ^ N) := by
    have h_add := divPow_add (huB_sub_u₂_div N) hu₂N_div
    rwa [sub_add_cancel] at h_add
  have huAN_div : IsIntegralDivPow F L πL 1 (u_A ^ N) := by
    dsimp [u_A]
    rw [mul_pow]
    exact divPow_mul_right hXN_div (IsIntegral.pow hA₁_int N)
  have hw_2N_div : IsIntegralDivPow F L πL 1 (w ^ (2 * N)) := by
    dsimp [w]
    rw [add_pow]
    refine divPow_sum (Finset.range (2 * N + 1))
      (fun i => u_A ^ i * u_B ^ (2 * N - i) * ((2 * N).choose i : AlgebraicClosure F)) 1
      fun i _ => ?_
    have h_choose_int : IsIntegral 𝒪[F] ((2 * N).choose i : AlgebraicClosure F) := by
      have h_eq : ((2 * N).choose i : AlgebraicClosure F) =
          algebraMap L (AlgebraicClosure F) ((2 * N).choose i : L) := by
        rw [map_natCast]
      rw [h_eq]
      exact isIntegral_algebraMap_L (isIntegral_natCast _)
    refine divPow_mul_right ?_ h_choose_int
    rcases le_or_gt N i with hNi | hNi
    · exact divPow_mul_right
        (h_pow_divPow_of_ge huA_int huAN_div 1 i (by omega))
        (IsIntegral.pow huB_int (2 * N - i))
    · exact divPow_mul_left
        (IsIntegral.pow huA_int i)
        (h_pow_divPow_of_ge huB_int huBN_div 1 (2 * N - i) (by omega))
  have hw_2Nm_div : IsIntegralDivPow F L πL m (w ^ (2 * N * m)) := by
    change IsIntegral 𝒪[F] (w ^ (2 * N * m) / πbar ^ m)
    have hw1 : IsIntegral 𝒪[F] (w ^ (2 * N) / πbar) := by
      have h1 : IsIntegral 𝒪[F] (w ^ (2 * N) / πbar ^ 1) := hw_2N_div
      rwa [pow_one] at h1
    have h_eq : w ^ (2 * N * m) / πbar ^ m = (w ^ (2 * N) / πbar) ^ m := by
      rw [div_pow, ← pow_mul]
    rw [h_eq]
    exact IsIntegral.pow hw1 m
  let geomSum : ℕ → AlgebraicClosure F :=
    fun K => Nat.rec 0 (fun j gj => gj + w ^ j) K
  have hgeom_zero : geomSum 0 = 0 := rfl
  have hgeom_succ : ∀ K : ℕ, geomSum (K + 1) = geomSum K + w ^ K := fun _ => rfl
  have hgeom_ind : ∀ K : ℕ,
      IsIntegral 𝒪[F] (geomSum K) ∧ (1 - w) * geomSum K = 1 - w ^ K := by
    intro K
    induction K with
    | zero =>
      refine ⟨hgeom_zero ▸ isIntegral_zero, ?_⟩
      rw [hgeom_zero, mul_zero, pow_zero, sub_self]
    | succ K ih =>
      refine ⟨?_, ?_⟩
      · rw [hgeom_succ]
        exact IsIntegral.add ih.1 (IsIntegral.pow hw_int_bar K)
      · calc (1 - w) * geomSum (K + 1)
            = (1 - w) * geomSum K + (1 - w) * w ^ K := by rw [hgeom_succ, mul_add]
          _ = (1 - w ^ K) + (1 - w) * w ^ K := by rw [ih.2]
          _ = 1 - w * w ^ K := by ring
          _ = 1 - w ^ (K + 1) := by rw [← pow_succ']
  obtain ⟨hgeom_int, hgeom_eq⟩ := hgeom_ind (2 * N * m)
  have h_final_id : X - Y =
      ((X - Y) * (1 - w)) * geomSum (2 * N * m) + (X - Y) * w ^ (2 * N * m) := by
    calc X - Y
        = (X - Y) * (1 - w ^ (2 * N * m)) + (X - Y) * w ^ (2 * N * m) := by ring
      _ = (X - Y) * ((1 - w) * geomSum (2 * N * m)) + (X - Y) * w ^ (2 * N * m) := by
          rw [← hgeom_eq]
      _ = ((X - Y) * (1 - w)) * geomSum (2 * N * m) + (X - Y) * w ^ (2 * N * m) := by ring
  change IsIntegralDivPow F L πL m (X - Y)
  rw [h_final_id]
  exact divPow_add
    (divPow_mul_right h_XY_one_sub_w_div hgeom_int)
    (divPow_mul_left (IsIntegral.sub hX_int hY_int) hw_2Nm_div)

theorem isLubinTateFrob_sub_aeval_lubinTateEndoTrunc_eq_pow_mul_isIntegralOverValL (F : Type u)
    [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (π u : Lˣ) (hπ : valL F L π = 1) (hu : valL F L u = 0)
    (σ : AbsGal F) (hσ : IsLubinTateFrob F L (u * π) σ)
    (n : ℕ) (α : AlgebraicClosure F) (hα : isLubinTateRoot F L π n α) (m : ℕ) :
    ∃ γ : AlgebraicClosure F,
      IsIntegralOverValL F L γ ∧
      σ α - Polynomial.aeval α (lubinTateEndoTrunc F L (π : L) (u : L) (m * (qL F L) ^ n)) =
        ((π : L) : AlgebraicClosure F) ^ m * γ :=
by
  let τ : AbsGal F := σ⁻¹
  have hτL : τ ∈ L.fixingSubgroup := Subgroup.inv_mem _ hσ.1
  have hτFrob : ∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ → τ ζ = ζ ^ qL F L := by
    intro ζ hζ
    have hτζ : IsPrimeToPRootOfUnity F (τ ζ) := by
      rcases hζ with ⟨d, hd, hpd, hζd⟩
      exact ⟨d, hd, hpd, by rw [← map_pow, hζd, map_one]⟩
    have h_eq := hσ.2.1 (τ ζ) hτζ
    have happly : σ (τ ζ) = ζ := AlgEquiv.apply_symm_apply σ ζ
    have hpos : (-(-(resDeg F L : ℤ))).toNat = resDeg F L := by omega
    have hneg : (-(resDeg F L : ℤ)).toNat = 0 := by omega
    rw [happly, hpos, hneg, pow_zero, pow_one] at h_eq
    exact h_eq.symm
  obtain ⟨h_bridge, h_root⟩ :=
    isIntegralOverValL_of_isIntegral_and_exists_root_isIntegralDivPow F L π hπ
  have h_unram := unramSubring_frob_congr_and_div_pow_mem F L π hπ τ hτL hτFrob
  let N := (qL F L) ^ n
  let r := m * N
  let M₀ := r * N
  let r₁ := M₀ * N
  obtain ⟨ε, hε_mem, ε', hε'_mem, hε_unit, hε_frob⟩ :=
    exists_unramSubring_frob_unit_lift F L π u hπ hu τ hτL hτFrob h_root h_unram (M₀ + r₁ + 1)
  obtain ⟨hθ₀, hθ₁, hθ_deg, hθ_int, hθ_iter, hθ_comm⟩ :=
    colemanTheta_iter_and_endoTrunc_congr F L π u hπ hu τ hτL
      (fun x hx => ⟨(h_unram x hx).1, (h_unram x hx).2.1, (h_unram x hx).2.2.1⟩)
      ε hε_mem M₀ r₁ hε_frob
  have hε_int : IsIntegral 𝒪[F] ε := (h_unram ε hε_mem).1
  have hε'_int : IsIntegral 𝒪[F] ε' := (h_unram ε' hε'_mem).1
  have h_div :=
    isIntegralDivPow_frob_sub_aeval_endoTrunc_of_colemanTheta F L π u hπ hu σ hσ n α hα m
      ε ε' (colemanTheta F L (π : L) (u : L) τ ε (M₀ + r₁) r₁)
      hε_int hε'_int hε_unit hθ₀ hθ₁ hθ_deg hθ_int (hθ_iter n) hθ_comm h_root
  let πbar : AlgebraicClosure F := algebraMap L (AlgebraicClosure F) (π : L)
  let diff : AlgebraicClosure F :=
    σ α - Polynomial.aeval α (lubinTateEndoTrunc F L (π : L) (u : L) r)
  refine ⟨diff / πbar ^ m, h_bridge (diff / πbar ^ m) h_div, ?_⟩
  have hπ_ne : πbar ≠ 0 := (map_ne_zero (algebraMap L (AlgebraicClosure F))).mpr (Units.ne_zero π)
  have hπm_ne : πbar ^ m ≠ 0 := pow_ne_zero m hπ_ne
  exact (mul_div_cancel₀ diff hπm_ne).symm

theorem eq_of_forall_sub_eq_pow_mul_sub_isIntegralOverValL (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (ϖ : Lˣ) (hϖ : valL F L ϖ = 1) (β₁ β₂ : AlgebraicClosure F)
    (h : ∀ m : ℕ, ∃ γ₁ γ₂ : AlgebraicClosure F,
      IsIntegralOverValL F L γ₁ ∧ IsIntegralOverValL F L γ₂ ∧
      β₁ - β₂ = ((ϖ : L) : AlgebraicClosure F) ^ m * (γ₁ - γ₂)) :
    β₁ = β₂ :=
by
  have addVal_mul : ∀ {x y : F}, x ≠ 0 → y ≠ 0 → addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun v => Multiplicative.ofAdd (addVal F v)
      map_one' := by simp [addVal_one]
      map_mul' := fun v w => by simp [addVal_mul v.ne_zero w.ne_zero, ofAdd_add] }
  let relValHom : ∀ (E : IntermediateField F (AlgebraicClosure F)), Eˣ →* Multiplicative ℤ :=
    fun E => addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ (E : IntermediateField F (AlgebraicClosure F)) (v : Eˣ),
      Multiplicative.toAdd (relValHom E v) = relVal F E v :=
    fun _ _ => rfl
  have relVal_units_mul : ∀ (E : IntermediateField F (AlgebraicClosure F)) (v w : Eˣ),
      relVal F E ((v * w : Eˣ) : E) = relVal F E v + relVal F E w := by
    intro E v w
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (E : IntermediateField F (AlgebraicClosure F)) (v : Eˣ) (k : ℤ),
      relVal F E ((v ^ k : Eˣ) : E) = k * relVal F E v := by
    intro E v k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have exists_addVal_eq_one : ∃ v : Fˣ, addVal F v = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨c, hc⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F c) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hc]
      exact hg
    have hc0 : c ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 c hc0, ?_⟩
    simp only [Units.val_mk0, addVal, hc0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F c))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F L ∧ ∃ π' : Lˣ, relVal F L π' = resDeg F L := by
    obtain ⟨v, hv⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L v,
        (map_ne_zero (algebraMap F L)).mpr v.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (v : F)) = (v : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (v : F)
      have hpow : addVal F ((v : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F v := by
        change Multiplicative.toAdd (addValHom (v ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hv, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hf_pos, π', hπ'⟩ := resDeg_mem
  have relVal_eq_resDeg_mul_valL_aux : ∀ v : Lˣ, relVal F L v = (resDeg F L : ℤ) * valL F L v := by
    intro v
    let q₀ := relVal F L v / (resDeg F L : ℤ)
    let r₀ := relVal F L v % (resDeg F L : ℤ)
    have hdiv : r₀ + (resDeg F L : ℤ) * q₀ = relVal F L v := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r₀ := Int.emod_nonneg _ (by positivity)
    have hrlt : r₀ < (resDeg F L : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F L ((v * π' ^ (-q₀) : Lˣ) : L) = r₀ := by
      rw [relVal_units_mul, relVal_units_zpow, hπ']
      linarith
    have hr_eq : r₀ = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r₀.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r₀.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k} := by
        refine ⟨hr_pos, ((v * π' ^ (-q₀) : Lˣ) : L), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F L ≤ r₀.toNat := Nat.sInf_le hmem
      omega
    change relVal F L v = (resDeg F L : ℤ) * q₀
    linarith
  have h_int_iff : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E] (z : E),
      IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ relVal F E z := by
    have h_aux : ∀ (K : Type u) [Field K] [Algebra F K] [FiniteDimensional F K] (x : K),
        IsIntegral 𝒪[F] x ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x) := by
      intro K _ _ _ x
      have addVal_nonneg_iff_val_le_one : ∀ {b : F} (hb : b ≠ 0),
          0 ≤ addVal F b ↔ valuation F b ≤ 1 := by
        intro b hb
        unfold addVal
        rw [dif_neg hb]
        set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
        set vb := valuation F b
        have hvb_ne : iso vb ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hb)
        constructor
        · intro h_nonneg
          have h_toAdd : Multiplicative.toAdd (WithZero.unzero hvb_ne) ≤ 0 := by omega
          have h_unzero : WithZero.unzero hvb_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
          have h_iso : iso vb ≤ iso 1 := by
            rw [map_one, ← WithZero.coe_unzero hvb_ne, ← WithZero.coe_one]
            exact WithZero.coe_le_coe.mpr h_unzero
          exact (map_le_map_iff iso).mp h_iso
        · intro h_le
          have h_iso : iso vb ≤ iso 1 := (map_le_map_iff iso).mpr h_le
          rw [map_one, ← WithZero.coe_unzero hvb_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
          have h_toAdd : Multiplicative.toAdd (WithZero.unzero hvb_ne) ≤ 0 :=
            Multiplicative.toAdd_le.mpr h_iso
          omega
      constructor
      · intro hx
        by_cases hx0 : x = 0
        · exact Or.inl hx0
        · right
          have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
          have hnorm_int : IsIntegral 𝒪[F] (Algebra.norm F x) := Algebra.isIntegral_norm F hx
          have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
            (Valuation.Integers.isIntegral_iff_v_le_one
              (Valuation.integer.integers (valuation F))).mp hnorm_int
          exact (addVal_nonneg_iff_val_le_one hnorm0).mpr hval_le
      · rintro (rfl | h_rel)
        · exact isIntegral_zero
        · by_cases hx0 : x = 0
          · rw [hx0]
            exact isIntegral_zero
          · have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
            have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
              (addVal_nonneg_iff_val_le_one hnorm0).mp h_rel
            have hx_int_F : IsIntegral F x := Algebra.IsIntegral.isIntegral x
            let pb : PowerBasis F (IntermediateField.adjoin F ({x} : Set K)) :=
              IntermediateField.adjoin.powerBasis hx_int_F
            have h_gen_coe : (pb.gen : K) = x := IntermediateField.AdjoinSimple.coe_gen F x
            set dK : ℕ := Module.finrank (IntermediateField.adjoin F ({x} : Set K)) K
            have h_finrank_pos : 0 < dK := Module.finrank_pos
            have h_norm_tower : Algebra.norm F x = (Algebra.norm F pb.gen) ^ dK := by
              have h1 : Algebra.norm F (pb.gen : K) = (Algebra.norm F pb.gen) ^ dK := by
                rw [← Algebra.norm_norm (R := F) (S := IntermediateField.adjoin F ({x} : Set K))
                  (A := K) (a := (pb.gen : K)), ← map_pow]
                congr 1
                exact Algebra.norm_algebraMap (L := K) pb.gen
              rwa [h_gen_coe] at h1
            have h_norm_pb : Algebra.norm F pb.gen =
                (-1) ^ pb.dim * (minpoly F pb.gen).coeff 0 :=
              Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb
            have h_minpoly_eq : minpoly F pb.gen = minpoly F x := by
              have h1 : minpoly F pb.gen = minpoly F (pb.gen : K) :=
                (minpoly.algHom_eq
                  (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K)))
                  (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K))).injective
                  pb.gen).symm
              rwa [h_gen_coe] at h1
            letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
            haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
            haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
            letI : Valued F (ValueGroupWithZero F) :=
              IsValuativeTopology.instValuedValueGroupWithZeroOfIsUniformAddGroup
            let rlo : RankLeOneStruct F :=
              { emb := (WithZeroMulInt.toNNReal (by norm_num : (2 : NNReal) ≠ 0)).comp
                  (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).toMonoidWithZeroHom
                strictMono := (WithZeroMulInt.toNNReal_strictMono (by norm_num : (1 : NNReal) < 2)).comp
                  (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).strictMono }
            haveI : (Valued.v (R := F)).RankOne := Valuation.RankOne.ofRankLeOneStruct rlo
            letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
            haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F (ValueGroupWithZero F)
            have hnorm_norm_le : ‖Algebra.norm F x‖ ≤ 1 :=
              Valued.toNormedField.norm_le_one_iff.mpr hval_le
            have h_norm_coeff_pow : ‖Algebra.norm F x‖ =
                ‖(minpoly F x).coeff 0‖ ^ dK := by
              rw [h_norm_tower, h_norm_pb, h_minpoly_eq, norm_pow, norm_mul, norm_pow,
                norm_neg, norm_one, one_pow, one_mul]
            have h_coeff0_le : ‖(minpoly F x).coeff 0‖ ≤ 1 := by
              rw [h_norm_coeff_pow] at hnorm_norm_le
              exact (pow_le_one_iff_of_nonneg (norm_nonneg _) h_finrank_pos.ne').mp hnorm_norm_le
            have h_spec_le : spectralValue (minpoly F x) ≤ 1 := by
              change spectralNorm F K x ≤ 1
              rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow F K x]
              exact Real.rpow_le_one (norm_nonneg _) h_coeff0_le (by positivity)
            have h_all_coeffs : ∀ k : ℕ, ‖(minpoly F x).coeff k‖ ≤ 1 :=
              (spectralValue_le_one_iff (minpoly.monic hx_int_F)).mp h_spec_le
            have h_lifts : minpoly F x ∈ Polynomial.lifts (algebraMap 𝒪[F] F) := by
              rw [Polynomial.lifts_iff_coeff_lifts]
              intro k
              have hv : valuation F ((minpoly F x).coeff k) ≤ 1 :=
                Valued.toNormedField.norm_le_one_iff.mp (h_all_coeffs k)
              exact ⟨⟨(minpoly F x).coeff k, hv⟩, rfl⟩
            obtain ⟨P₀, hP₀_map, -, hP₀_monic⟩ :=
              Polynomial.lifts_and_degree_eq_and_monic h_lifts (minpoly.monic hx_int_F)
            refine ⟨P₀, hP₀_monic, ?_⟩
            have h_eval : Polynomial.aeval x (P₀.map (algebraMap 𝒪[F] F)) = 0 := by
              rw [hP₀_map]
              exact minpoly.aeval F x
            rwa [Polynomial.aeval_map_algebraMap] at h_eval
    intro E _ z
    exact h_aux E z
  have isIntegral_of_valL_nonneg : ∀ c : L, (c = 0 ∨ 0 ≤ valL F L c) →
      IsIntegral 𝒪[F] (algebraMap L (AlgebraicClosure F) c) := by
    intro c hc
    have hc_L : IsIntegral 𝒪[F] c := by
      rcases hc with rfl | hc_ge
      · exact isIntegral_zero
      · by_cases hc0 : c = 0
        · rw [hc0]
          exact isIntegral_zero
        · apply (h_int_iff L c).mpr
          right
          let u_c : Lˣ := Units.mk0 c hc0
          have hrel := relVal_eq_resDeg_mul_valL_aux u_c
          change relVal F L c = (resDeg F L : ℤ) * valL F L c at hrel
          rw [hrel]
          exact mul_nonneg (Nat.cast_nonneg _) hc_ge
    exact IsIntegral.map (IsScalarTower.toAlgHom 𝒪[F] L (AlgebraicClosure F)) hc_L
  let A : Subalgebra 𝒪[F] (AlgebraicClosure F) := integralClosure 𝒪[F] (AlgebraicClosure F)
  have isIntegral_of_isIntegralOverValL : ∀ γ : AlgebraicClosure F,
      IsIntegralOverValL F L γ → IsIntegral 𝒪[F] γ := by
    intro γ ⟨g, hg_monic, hg_aeval, hg_coeff⟩
    let g_bar : Polynomial (AlgebraicClosure F) := g.map (algebraMap L (AlgebraicClosure F))
    have hg_bar_monic : g_bar.Monic := hg_monic.map (algebraMap L (AlgebraicClosure F))
    have hg_bar_lifts : g_bar ∈ Polynomial.lifts (algebraMap A (AlgebraicClosure F)) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro k
      have hk_int : IsIntegral 𝒪[F] (g_bar.coeff k) := by
        change IsIntegral 𝒪[F] ((g.map (algebraMap L (AlgebraicClosure F))).coeff k)
        rw [Polynomial.coeff_map]
        exact isIntegral_of_valL_nonneg (g.coeff k) (hg_coeff k)
      exact ⟨⟨g_bar.coeff k, (mem_integralClosure_iff 𝒪[F] (AlgebraicClosure F)).mpr hk_int⟩, rfl⟩
    obtain ⟨q, hq_map, -, hq_monic⟩ :=
      Polynomial.lifts_and_degree_eq_and_monic hg_bar_lifts hg_bar_monic
    have hq_aeval : Polynomial.aeval γ q = 0 := by
      have h1 : Polynomial.aeval γ (q.map (algebraMap A (AlgebraicClosure F))) = 0 := by
        rw [hq_map]
        change Polynomial.aeval γ (g.map (algebraMap L (AlgebraicClosure F))) = 0
        rw [Polynomial.aeval_map_algebraMap]
        exact hg_aeval
      rwa [Polynomial.aeval_map_algebraMap] at h1
    have hγ_A : IsIntegral A γ := ⟨q, hq_monic, hq_aeval⟩
    exact @isIntegral_trans 𝒪[F] ↥A (AlgebraicClosure F) _ _ _ _ _ _ _ _ γ hγ_A
  have hϖ_inv_not_int : ¬ IsIntegral 𝒪[F] (((ϖ⁻¹ : Lˣ) : L) : AlgebraicClosure F) := by
    intro h_int
    have h_int_L : IsIntegral 𝒪[F] ((ϖ⁻¹ : Lˣ) : L) :=
      (isIntegral_algHom_iff (IsScalarTower.toAlgHom 𝒪[F] L (AlgebraicClosure F)) L.val.injective).mp h_int
    have hrel_ϖ : relVal F L (ϖ : L) = (resDeg F L : ℤ) := by
      have h1 := relVal_eq_resDeg_mul_valL_aux ϖ
      rw [hϖ, mul_one] at h1
      exact h1
    have hrel_inv : relVal F L ((ϖ⁻¹ : Lˣ) : L) = -(resDeg F L : ℤ) := by
      have h1 := relVal_units_zpow L ϖ (-1)
      rw [zpow_neg_one, hrel_ϖ] at h1
      linarith
    rcases (h_int_iff L ((ϖ⁻¹ : Lˣ) : L)).mp h_int_L with h0 | hge
    · exact (ϖ⁻¹).ne_zero h0
    · omega
  by_contra hne
  set δ : AlgebraicClosure F := β₁ - β₂
  have hδ0 : δ ≠ 0 := sub_ne_zero.mpr hne
  let E : IntermediateField F (AlgebraicClosure F) :=
    L ⊔ IntermediateField.adjoin F ({δ} : Set (AlgebraicClosure F))
  haveI : FiniteDimensional F (IntermediateField.adjoin F ({δ} : Set (AlgebraicClosure F))) :=
    IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral δ)
  haveI : FiniteDimensional F E :=
    IntermediateField.finiteDimensional_sup L
      (IntermediateField.adjoin F ({δ} : Set (AlgebraicClosure F)))
  let i_LE : L →ₐ[F] E := IntermediateField.inclusion le_sup_left
  let u_π : Eˣ := Units.map i_LE.toMonoidHom ϖ
  have hu_π_inv_not_int : ¬ IsIntegral 𝒪[F] ((u_π⁻¹ : Eˣ) : E) := by
    intro h_int_E
    have h_int_bar : IsIntegral 𝒪[F] (((u_π⁻¹ : Eˣ) : E) : AlgebraicClosure F) :=
      IsIntegral.map (IsScalarTower.toAlgHom 𝒪[F] E (AlgebraicClosure F)) h_int_E
    have h_coe : (((u_π⁻¹ : Eˣ) : E) : AlgebraicClosure F) = (((ϖ⁻¹ : Lˣ) : L) : AlgebraicClosure F) := by
      change ((Units.map i_LE.toMonoidHom (ϖ⁻¹) : Eˣ) : E).val = _
      rfl
    rw [h_coe] at h_int_bar
    exact hϖ_inv_not_int h_int_bar
  have hrel_π_inv_neg : relVal F E ((u_π⁻¹ : Eˣ) : E) < 0 := by
    by_contra h_nonneg
    push_neg at h_nonneg
    exact hu_π_inv_not_int ((h_int_iff E ((u_π⁻¹ : Eˣ) : E)).mpr (Or.inr h_nonneg))
  have hrel_π_pos : 1 ≤ relVal F E (u_π : E) := by
    have h1 := relVal_units_zpow E u_π (-1)
    rw [zpow_neg_one] at h1
    omega
  have hle_right : IntermediateField.adjoin F ({δ} : Set (AlgebraicClosure F)) ≤ E := le_sup_right
  have hδ_mem : δ ∈ E := hle_right (IntermediateField.mem_adjoin_simple_self F δ)
  let δ_E : E := ⟨δ, hδ_mem⟩
  have hδ_E0 : δ_E ≠ 0 := fun h0 => hδ0 (congrArg Subtype.val h0)
  let u_δ : Eˣ := Units.mk0 δ_E hδ_E0
  let m : ℕ := (relVal F E (u_δ : E)).toNat + 1
  have hm_gt : relVal F E (u_δ : E) < (m : ℤ) := by
    change relVal F E (u_δ : E) < ↑((relVal F E (u_δ : E)).toNat + 1)
    omega
  obtain ⟨γ₁, γ₂, hγ₁, hγ₂, heq⟩ := h m
  have hγ_int : IsIntegral 𝒪[F] (γ₁ - γ₂) :=
    IsIntegral.sub (isIntegral_of_isIntegralOverValL γ₁ hγ₁)
      (isIntegral_of_isIntegralOverValL γ₂ hγ₂)
  let w_m : Eˣ := u_δ * (u_π ^ (-(m : ℤ)))
  have hw_m_coe : ((w_m : E) : AlgebraicClosure F) = γ₁ - γ₂ := by
    have h_val : ((w_m : E) : AlgebraicClosure F) =
        δ * ((((ϖ : L) : AlgebraicClosure F) ^ m)⁻¹) := by
      have h1 : (w_m : E) = (u_δ : E) * ((u_π : E) ^ m)⁻¹ := by
        change ((u_δ * (u_π ^ (-(m : ℤ))) : Eˣ) : E) = _
        rw [zpow_neg, zpow_natCast, Units.val_mul, Units.val_inv_eq_inv_val,
          Units.val_pow_eq_pow_val]
      change E.val (w_m : E) = δ * ((((ϖ : L) : AlgebraicClosure F) ^ m)⁻¹)
      rw [h1, map_mul, map_inv₀, map_pow]
      rfl
    have hπ_ne : (((ϖ : L) : AlgebraicClosure F) ^ m) ≠ 0 :=
      pow_ne_zero m ((map_ne_zero (algebraMap L (AlgebraicClosure F))).mpr ϖ.ne_zero)
    rw [h_val, heq, mul_right_comm, mul_inv_cancel₀ hπ_ne, one_mul]
  have hw_m_int_bar : IsIntegral 𝒪[F] ((w_m : E) : AlgebraicClosure F) := by
    rwa [hw_m_coe]
  have hw_m_int : IsIntegral 𝒪[F] (w_m : E) :=
    (isIntegral_algHom_iff (IsScalarTower.toAlgHom 𝒪[F] E (AlgebraicClosure F)) E.val.injective).mp
      hw_m_int_bar
  have hw_m_rel_nonneg : 0 ≤ relVal F E (w_m : E) := by
    rcases (h_int_iff E (w_m : E)).mp hw_m_int with h0 | hge
    · exact False.elim (w_m.ne_zero h0)
    · exact hge
  have hw_m_rel_eq : relVal F E (w_m : E) =
      relVal F E (u_δ : E) - (m : ℤ) * relVal F E (u_π : E) := by
    change relVal F E ((u_δ * (u_π ^ (-(m : ℤ))) : Eˣ) : E) = _
    rw [relVal_units_mul, relVal_units_zpow]
    ring
  have hm_le : (m : ℤ) ≤ (m : ℤ) * relVal F E (u_π : E) := by
    have h1 := mul_le_mul_of_nonneg_left hrel_π_pos (Nat.cast_nonneg m)
    linarith
  linarith

theorem lubinTateFrob_unit_mul_chosenUniformizer_apply_isLubinTateRoot (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (u : Lˣ) (hu : valL F L u = 0) (n : ℕ) (α : AlgebraicClosure F)
    (hα : isLubinTateRoot F L (chosenUniformizer F L) n α) :
    lubinTateFrob F L (u * chosenUniformizer F L) α =
      Polynomial.aeval α (lubinTateEndoPoly F L (chosenUniformizer F L : L) (u : L) n) :=
by
  let π := chosenUniformizer F L
  have addVal_mul : ∀ {x y : F}, x ≠ 0 → y ≠ 0 → addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun v => Multiplicative.ofAdd (addVal F v)
      map_one' := by simp [addVal_one]
      map_mul' := fun v w => by simp [addVal_mul v.ne_zero w.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ v : Lˣ, Multiplicative.toAdd (relValHom v) = relVal F L v :=
    fun _ => rfl
  have relVal_units_mul : ∀ v w : Lˣ,
      relVal F L ((v * w : Lˣ) : L) = relVal F L v + relVal F L w := by
    intro v w
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (v : Lˣ) (k : ℤ),
      relVal F L ((v ^ k : Lˣ) : L) = k * relVal F L v := by
    intro v k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have exists_addVal_eq_one : ∃ v : Fˣ, addVal F v = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨c, hc⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F c) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hc]
      exact hg
    have hc0 : c ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 c hc0, ?_⟩
    simp only [Units.val_mk0, addVal, hc0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F c))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F L ∧ ∃ π' : Lˣ, relVal F L π' = resDeg F L := by
    obtain ⟨v, hv⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L v,
        (map_ne_zero (algebraMap F L)).mpr v.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (v : F)) = (v : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (v : F)
      have hpow : addVal F ((v : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F v := by
        change Multiplicative.toAdd (addValHom (v ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hv, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hf_pos, π', hπ'⟩ := resDeg_mem
  have hf_ne : (resDeg F L : ℤ) ≠ 0 := by positivity
  have relVal_eq_resDeg_mul_valL_aux : ∀ v : Lˣ, relVal F L v = (resDeg F L : ℤ) * valL F L v := by
    intro v
    let q₀ := relVal F L v / (resDeg F L : ℤ)
    let r₀ := relVal F L v % (resDeg F L : ℤ)
    have hdiv : r₀ + (resDeg F L : ℤ) * q₀ = relVal F L v := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r₀ := Int.emod_nonneg _ (by positivity)
    have hrlt : r₀ < (resDeg F L : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F L ((v * π' ^ (-q₀) : Lˣ) : L) = r₀ := by
      rw [relVal_units_mul, relVal_units_zpow, hπ']
      linarith
    have hr_eq : r₀ = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r₀.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r₀.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k} := by
        refine ⟨hr_pos, ((v * π' ^ (-q₀) : Lˣ) : L), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F L ≤ r₀.toNat := Nat.sInf_le hmem
      omega
    change relVal F L v = (resDeg F L : ℤ) * q₀
    linarith
  have hπ'_val : valL F L π' = 1 := by
    rw [valL, hπ', Int.ediv_self hf_ne]
  have hπ : valL F L π = 1 :=
    Classical.epsilon_spec (p := fun w : Lˣ => valL F L w = 1) ⟨π', hπ'_val⟩
  have huπ : valL F L ((u * π : Lˣ) : L) = 1 := by
    have hrel := relVal_eq_resDeg_mul_valL_aux (u * π)
    rw [relVal_units_mul, relVal_eq_resDeg_mul_valL_aux u,
      relVal_eq_resDeg_mul_valL_aux π, hu, hπ] at hrel
    apply mul_left_cancel₀ hf_ne
    linarith
  obtain ⟨τ, hτL, hτFrob⟩ := exists_actsAsFrobPow_neg_resDeg F L
  have hσ : IsLubinTateFrob F L (u * π) (lubinTateFrob F L (u * π)) :=
    Classical.epsilon_spec (exists_isLubinTateFrob_of_frobLift F L (u * π) huπ τ hτL hτFrob)
  have hu_nonneg : 0 ≤ valL F L (u : L) := by omega
  have hP : IsLubinTateEndoPoly F L (π : L) (u : L) n (lubinTateEndoPoly F L (π : L) (u : L) n) :=
    Classical.epsilon_spec (exists_isLubinTateEndoPoly F L (u : L) hu_nonneg n)
  apply eq_of_forall_sub_eq_pow_mul_sub_isIntegralOverValL F L π hπ
  intro m
  obtain ⟨γ₂, hγ₂, heq₂⟩ :=
    aeval_sub_aeval_lubinTateEndoTrunc_eq_pow_mul_isIntegralOverValL F L π hπ (u : L) n
      (lubinTateEndoPoly F L (π : L) (u : L) n) hP α hα m
  obtain ⟨γ₁, hγ₁, heq₁⟩ :=
    isLubinTateFrob_sub_aeval_lubinTateEndoTrunc_eq_pow_mul_isIntegralOverValL F L π u hπ hu
      (lubinTateFrob F L (u * π)) hσ n α hα m
  refine ⟨γ₁, γ₂, hγ₁, hγ₂, ?_⟩
  linear_combination heq₁ - heq₂

theorem rawRecMap_mul_apply_isLubinTateRoot (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (x y : Lˣ) (n : ℕ) (α : AlgebraicClosure F) :
    isLubinTateRoot F L (chosenUniformizer F L) n α →
      rawRecMap F L (x * y) α = rawRecMap F L x (rawRecMap F L y α) :=
by
  intro hα
  let π := chosenUniformizer F L
  obtain ⟨hπ, -⟩ := valL_chosenUniformizer_and_mul_zpow F L x
  have hf_ne : (resDeg F L : ℤ) ≠ 0 := by
    intro h0
    have h1 : valL F L π = 1 := hπ
    rw [valL, h0, Int.ediv_zero] at h1
    omega
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Lˣ, Multiplicative.toAdd (relValHom u) = relVal F L u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u v : Lˣ,
      relVal F L ((u * v : Lˣ) : L) = relVal F L u + relVal F L v := by
    intro u v
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : Lˣ) (k : ℤ),
      relVal F L ((u ^ k : Lˣ) : L) = k * relVal F L u := by
    intro u k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have valL_units_mul : ∀ u v : Lˣ,
      valL F L ((u * v : Lˣ) : L) = valL F L u + valL F L v := by
    intro u v
    have hrel := relVal_eq_resDeg_mul_valL F L (u * v)
    rw [relVal_units_mul, relVal_eq_resDeg_mul_valL F L u,
      relVal_eq_resDeg_mul_valL F L v] at hrel
    apply mul_left_cancel₀ hf_ne
    linarith
  have valL_units_zpow : ∀ (u : Lˣ) (k : ℤ),
      valL F L ((u ^ k : Lˣ) : L) = k * valL F L u := by
    intro u k
    have hrel := relVal_eq_resDeg_mul_valL F L (u ^ k)
    rw [relVal_units_zpow, relVal_eq_resDeg_mul_valL F L u] at hrel
    apply mul_left_cancel₀ hf_ne
    linarith
  let unitPart : Lˣ → Lˣ := fun z => z * π ^ (-valL F L z)
  have hval_unitPart : ∀ z : Lˣ, valL F L (unitPart z) = 0 := by
    intro z
    change valL F L ((z * π ^ (-valL F L z) : Lˣ) : L) = 0
    rw [valL_units_mul, valL_units_zpow, hπ]
    ring
  have hshift_eq : ∀ z : Lˣ, z * π ^ (1 - valL F L z) = unitPart z * π := by
    intro z
    have hexp : (1 - valL F L z : ℤ) = -valL F L z + 1 := by ring
    change z * π ^ (1 - valL F L z) = (z * π ^ (-valL F L z)) * π
    rw [hexp, zpow_add, zpow_one, mul_assoc]
  have hunitPart_mul : unitPart (x * y) = unitPart x * unitPart y := by
    change (x * y) * π ^ (-valL F L ((x * y : Lˣ) : L)) =
      (x * π ^ (-valL F L x)) * (y * π ^ (-valL F L y))
    rw [valL_units_mul, neg_add, zpow_add]
    calc (x * y) * (π ^ (-valL F L x) * π ^ (-valL F L y))
        = x * (y * π ^ (-valL F L x)) * π ^ (-valL F L y) := by group
      _ = x * (π ^ (-valL F L x) * y) * π ^ (-valL F L y) := by rw [mul_comm y]
      _ = (x * π ^ (-valL F L x)) * (y * π ^ (-valL F L y)) := by group
  obtain ⟨τ, hτL, hτFrob⟩ := exists_actsAsFrobPow_neg_resDeg F L
  have hspec_π : IsLubinTateFrob F L π (lubinTateFrob F L π) :=
    Classical.epsilon_spec (exists_isLubinTateFrob_of_frobLift F L π hπ τ hτL hτFrob)
  have hfix_π : ∀ {β : AlgebraicClosure F}, isLubinTateRoot F L π n β →
      lubinTateFrob F L π β = β :=
    fun hβ => hspec_π.2.2 n _ hβ
  have hfix_π_nat : ∀ (m : ℕ) {β : AlgebraicClosure F}, isLubinTateRoot F L π n β →
      ((lubinTateFrob F L π) ^ m) β = β := by
    intro m
    induction m with
    | zero =>
      intro β _
      rfl
    | succ m ih =>
      intro β hβ
      rw [pow_succ', AlgEquiv.mul_apply, ih hβ, hfix_π hβ]
  have hfix_π_zpow : ∀ (k : ℤ) {β : AlgebraicClosure F}, isLubinTateRoot F L π n β →
      ((lubinTateFrob F L π) ^ k) β = β := by
    intro k β hβ
    cases k with
    | ofNat m =>
      change ((lubinTateFrob F L π) ^ (m : ℤ)) β = β
      rw [zpow_natCast]
      exact hfix_π_nat m hβ
    | negSucc m =>
      change (((lubinTateFrob F L π) ^ (m + 1))⁻¹) β = β
      have hm := hfix_π_nat (m + 1) hβ
      have hinv : (((lubinTateFrob F L π) ^ (m + 1))⁻¹)
          (((lubinTateFrob F L π) ^ (m + 1)) β) = β :=
        AlgEquiv.symm_apply_apply ((lubinTateFrob F L π) ^ (m + 1)) β
      rw [hm] at hinv
      exact hinv
  have hraw_eq : ∀ (z : Lˣ) {β : AlgebraicClosure F}, isLubinTateRoot F L π n β →
      rawRecMap F L z β = lubinTateFrob F L (unitPart z * π) β := by
    intro z β hβ
    change (lubinTateFrob F L (z * π ^ (1 - valL F L z)) *
      (lubinTateFrob F L π) ^ (valL F L z - 1)) β = _
    rw [AlgEquiv.mul_apply, hfix_π_zpow (valL F L z - 1) hβ, hshift_eq z]
  have hisRoot_apply : ∀ {γ : AbsGal F}, γ ∈ L.fixingSubgroup →
      ∀ {β : AlgebraicClosure F}, isLubinTateRoot F L π n β → isLubinTateRoot F L π n (γ β) := by
    intro γ hγ β hβ
    have hγπ : γ ((π : L) : AlgebraicClosure F) = ((π : L) : AlgebraicClosure F) :=
      (IntermediateField.mem_fixingSubgroup_iff L γ).mp hγ (π : L) (π : L).2
    let g : AlgebraicClosure F → AlgebraicClosure F :=
      fun w => ((π : L) : AlgebraicClosure F) * w + w ^ qL F L
    have hsc : Function.Semiconj γ g g := by
      intro w
      dsimp [g]
      rw [map_add, map_mul, map_pow, hγπ]
    have hiter : γ (g^[n] β) = g^[n] (γ β) := (hsc.iterate_right n) β
    change g^[n] (γ β) = 0
    have hβ' : g^[n] β = 0 := hβ
    rw [← hiter, hβ', map_zero]
  have huy_fix : lubinTateFrob F L (unitPart y * π) ∈ L.fixingSubgroup := by
    obtain ⟨-, hvy⟩ := valL_chosenUniformizer_and_mul_zpow F L y
    rw [hshift_eq y] at hvy
    exact (Classical.epsilon_spec
      (exists_isLubinTateFrob_of_frobLift F L (unitPart y * π) hvy τ hτL hτFrob)).1
  have hβ_root : isLubinTateRoot F L π n (lubinTateFrob F L (unitPart y * π) α) :=
    hisRoot_apply huy_fix hα
  have h_ux : valL F L (unitPart x) = 0 := hval_unitPart x
  have h_uy : valL F L (unitPart y) = 0 := hval_unitPart y
  have h_uxy : valL F L (unitPart (x * y)) = 0 := hval_unitPart (x * y)
  have h_ux_nonneg : 0 ≤ valL F L (unitPart x : L) := by omega
  have h_uy_nonneg : 0 ≤ valL F L (unitPart y : L) := by omega
  rw [hraw_eq (x * y) hα, hraw_eq y hα, hraw_eq x hβ_root]
  rw [lubinTateFrob_unit_mul_chosenUniformizer_apply_isLubinTateRoot F L (unitPart (x * y)) h_uxy n α hα]
  rw [hunitPart_mul, Units.val_mul]
  rw [aeval_lubinTateEndoPoly_mul_isLubinTateRoot F L (unitPart x : L) (unitPart y : L)
    h_ux_nonneg h_uy_nonneg n α hα]
  rw [← lubinTateFrob_unit_mul_chosenUniformizer_apply_isLubinTateRoot F L (unitPart y) h_uy n α hα]
  rw [← lubinTateFrob_unit_mul_chosenUniformizer_apply_isLubinTateRoot F L (unitPart x) h_ux n
    (lubinTateFrob F L (unitPart y * π) α) hβ_root]

theorem exists_root_unramDegSubfield_pow_apply_eq_and_ne (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (m : ℕ) :
    1 ≤ m → ∀ σ : AbsGal F, ActsAsFrobPow F σ (-(resDeg F L : ℤ)) →
      ∃ ζ₀ : AlgebraicClosure F,
        (∀ i : ℕ, (σ ^ i) ζ₀ ∈ unramDegSubfield F L m) ∧
        (σ ^ m) ζ₀ = ζ₀ ∧
        (∀ j : ℕ, 1 ≤ j → j < m → (σ ^ j) ζ₀ ≠ ζ₀) :=
by
  intro hm σ hσ
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab_ne : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab_ne, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h_eq := addVal_mul h1 h1
    rw [mul_one] at h_eq
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have hres : 0 < resDeg F L := by
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L u,
        (map_ne_zero (algebraMap F L)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (u : F)) = (u : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (u : F)
      have hpow : addVal F ((u : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F u := by
        change Multiplicative.toAdd (addValHom (u ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu, mul_one]
    exact (Nat.sInf_mem hS).1
  haveI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  haveI : CharP 𝓀[F] (p F) := by unfold p; infer_instance
  obtain ⟨d, hp, hq⟩ := FiniteField.card 𝓀[F] (p F)
  have hq' : q F = p F ^ (d : ℕ) := by
    rw [q, Nat.card_eq_fintype_card, hq]
  have hp_ge_two : 2 ≤ p F := hp.two_le
  have hqL_ge_two : 2 ≤ qL F L := by
    dsimp [qL]
    rw [hq', ← pow_mul]
    have hpos : 0 < (d : ℕ) * resDeg F L := Nat.mul_pos d.pos hres
    calc 2 = 2 ^ 1 := by ring
      _ ≤ 2 ^ ((d : ℕ) * resDeg F L) := Nat.pow_le_pow_right (by omega) hpos
      _ ≤ p F ^ ((d : ℕ) * resDeg F L) := Nat.pow_le_pow_left hp_ge_two _
  generalize hN_def : qL F L ^ m - 1 = N
  have hqLm_ge_two : 2 ≤ qL F L ^ m := by
    calc 2 = 2 ^ 1 := by ring
      _ ≤ 2 ^ m := Nat.pow_le_pow_right (by omega) hm
      _ ≤ qL F L ^ m := Nat.pow_le_pow_left hqL_ge_two m
  have hN_pos : 0 < N := by omega
  have hpN : ¬ p F ∣ N := by
    intro hdvd
    have hdvd_pow : p F ∣ qL F L ^ m := by
      dsimp [qL]
      rw [hq', ← pow_mul, ← pow_mul]
      have hk_pos : 0 < (d : ℕ) * (resDeg F L * m) :=
        Nat.mul_pos d.pos (Nat.mul_pos hres (by omega))
      exact dvd_pow_self (p F) hk_pos.ne'
    have hdvd_one : p F ∣ 1 := by
      have hsub := Nat.dvd_sub hdvd_pow hdvd
      have heq : qL F L ^ m - N = 1 := by omega
      rwa [heq] at hsub
    exact hp.not_dvd_one hdvd_one
  have hNF : (N : F) ≠ 0 := by
    intro h0
    have h0' : (N : 𝒪[F]) = 0 := Subtype.ext h0
    have hres_N : (N : 𝓀[F]) = 0 := by
      rw [← map_natCast (IsLocalRing.residue 𝒪[F]) N, h0', map_zero]
    exact hpN ((ringChar.spec 𝓀[F] N).mp hres_N)
  haveI : NeZero (N : F) := ⟨hNF⟩
  haveI : NeZero N := ⟨hN_pos.ne'⟩
  haveI : HasEnoughRootsOfUnity (AlgebraicClosure F) N :=
    AlgebraicClosure.hasEnoughRootsOfUnity F N
  obtain ⟨ζ₀, hprim⟩ := HasEnoughRootsOfUnity.prim (M := AlgebraicClosure F) (n := N)
  have hζ₀_pow : ζ₀ ^ N = 1 := hprim.pow_eq_one
  have hζ_p' : ∀ i : ℕ, IsPrimeToPRootOfUnity F ((σ ^ i) ζ₀) := by
    intro i
    refine ⟨N, hN_pos, hpN, ?_⟩
    rw [← map_pow, hζ₀_pow, map_one]
  have h_σ_step : ∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ →
      (σ ζ) ^ (qL F L) = ζ := by
    intro ζ hζ
    have h_eq := hσ ζ hζ
    have h_neg : (-(-(resDeg F L : ℤ))).toNat = resDeg F L := by
      rw [neg_neg, Int.toNat_natCast]
    have h_pos : (-(resDeg F L : ℤ)).toNat = 0 := by omega
    rw [h_neg, h_pos, pow_zero, pow_one] at h_eq
    exact h_eq
  have h_frob_pow : ∀ k : ℕ, ((σ ^ k) ζ₀) ^ (qL F L ^ k) = ζ₀ := by
    intro k
    induction k with
    | zero =>
      rw [pow_zero, pow_zero, AlgEquiv.one_apply, pow_one]
    | succ k ih =>
      rw [pow_succ', AlgEquiv.mul_apply, pow_succ', pow_mul, h_σ_step ((σ ^ k) ζ₀) (hζ_p' k), ih]
  refine ⟨ζ₀, ?_, ?_, ?_⟩
  · intro i
    unfold unramDegSubfield
    rw [hN_def]
    have h_adj : IntermediateField.adjoin F {ζ : AlgebraicClosure F | ζ ^ N = 1} ≤
        L ⊔ IntermediateField.adjoin F {ζ : AlgebraicClosure F | ζ ^ N = 1} := le_sup_right
    apply h_adj
    apply IntermediateField.subset_adjoin
    simp only [Set.mem_setOf_eq]
    rw [← map_pow, hζ₀_pow, map_one]
  · have h_m := h_frob_pow m
    have h_pow_N : ((σ ^ m) ζ₀) ^ N = 1 := by
      rw [← map_pow, hζ₀_pow, map_one]
    have hN1 : N + 1 = qL F L ^ m := by omega
    calc (σ ^ m) ζ₀ = ((σ ^ m) ζ₀) ^ N * (σ ^ m) ζ₀ := by rw [h_pow_N, one_mul]
      _ = ((σ ^ m) ζ₀) ^ (N + 1) := (pow_succ _ N).symm
      _ = ((σ ^ m) ζ₀) ^ (qL F L ^ m) := by rw [hN1]
      _ = ζ₀ := h_m
  · intro j hj1 hj2 h_eq
    have h_j := h_frob_pow j
    rw [h_eq] at h_j
    have hqLj_ge_two : 2 ≤ qL F L ^ j := by
      calc 2 = 2 ^ 1 := by ring
        _ ≤ 2 ^ j := Nat.pow_le_pow_right (by omega) hj1
        _ ≤ qL F L ^ j := Nat.pow_le_pow_left hqL_ge_two j
    have hqLj_lt : qL F L ^ j < qL F L ^ m :=
      Nat.pow_lt_pow_right (by omega) hj2
    generalize hl_def : qL F L ^ j - 1 = l
    have hl_pos : l ≠ 0 := by omega
    have hl_lt : l < N := by omega
    have hl1 : l + 1 = qL F L ^ j := by omega
    have hζ₀_ne_zero : ζ₀ ≠ 0 := hprim.ne_zero hN_pos.ne'
    have h_pow_l : ζ₀ ^ l = 1 := by
      apply mul_right_cancel₀ hζ₀_ne_zero
      rw [← pow_succ, hl1, one_mul, h_j]
    exact hprim.pow_ne_one_of_pos_of_lt hl_pos hl_lt h_pow_l

theorem pow_apply_mem_and_pow_finrank_apply_eq_of_isAbelianExt (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (h : L ≤ M) :
    IsAbelianExt F h → ∀ σ : AbsGal F, σ ∈ L.fixingSubgroup → ∀ x ∈ M,
      (∀ i : ℕ, (σ ^ i) x ∈ M) ∧ (σ ^ (Module.finrank F M)) x = x :=
by
  intro hab
  let M_L := IntermediateField.extendScalars h
  haveI : Algebra.IsAlgebraic ↥L (AlgebraicClosure F) :=
    Algebra.IsAlgebraic.tower_top (K := F) ↥L
  haveI : Normal ↥L (AlgebraicClosure F) :=
    Normal.tower_top_of_normal F ↥L (AlgebraicClosure F)
  haveI : Algebra.IsSeparable ↥L ↥M_L := hab.2.2
  have hstab : ∀ γ : AbsGal F, γ ∈ L.fixingSubgroup → ∀ y ∈ M, γ y ∈ M := by
    intro γ hγL y hy
    set z := γ y
    haveI : Algebra.IsAlgebraic ↥M_L (AlgebraicClosure F) :=
      Algebra.IsAlgebraic.tower_top (K := ↥L) ↥M_L
    haveI : Normal ↥M_L (AlgebraicClosure F) :=
      Normal.tower_top_of_normal ↥L ↥M_L (AlgebraicClosure F)
    have hz_alg : IsAlgebraic ↥M_L z := Algebra.IsAlgebraic.isAlgebraic z
    have hz_int : IsIntegral ↥M_L z := hz_alg.isIntegral
    let y_L : ↥M_L := ⟨y, (IntermediateField.mem_extendScalars h).mpr hy⟩
    have hy_sep : (minpoly ↥L y).Separable := by
      have h1 : (minpoly ↥L y_L).Separable := Algebra.IsSeparable.isSeparable ↥L y_L
      rwa [IntermediateField.minpoly_eq y_L] at h1
    let γ_L : AlgebraicClosure F ≃ₐ[↥L] AlgebraicClosure F := L.fixingSubgroupEquiv ⟨γ, hγL⟩
    have hz_eq : γ_L y = z := rfl
    have hz_sep_L : (minpoly ↥L z).Separable := by
      rw [← hz_eq, minpoly.algEquiv_eq γ_L y]
      exact hy_sep
    have h_aeval_map : Polynomial.aeval z (Polynomial.map (algebraMap ↥L ↥M_L) (minpoly ↥L z)) = 0 := by
      rw [Polynomial.aeval_map_algebraMap ↥M_L z (minpoly ↥L z), minpoly.aeval ↥L z]
    have hP_dvd : minpoly ↥M_L z ∣ Polynomial.map (algebraMap ↥L ↥M_L) (minpoly ↥L z) :=
      minpoly.dvd ↥M_L z h_aeval_map
    have hP_sep : (minpoly ↥M_L z).Separable :=
      Polynomial.Separable.of_dvd (Polynomial.Separable.map hz_sep_L) hP_dvd
    have h_root_eq : ∀ w ∈ (minpoly ↥M_L z).rootSet (AlgebraicClosure F), w = z := by
      intro w hw
      have hw_aeval : Polynomial.aeval w (minpoly ↥M_L z) = 0 := (Polynomial.mem_rootSet.mp hw).2
      have h_mp : minpoly ↥M_L z = minpoly ↥M_L w :=
        minpoly.eq_of_irreducible_of_monic (minpoly.irreducible hz_int) hw_aeval (minpoly.monic hz_int)
      let e_zw := minpoly.algEquiv hz_alg h_mp
      let τ_M : AlgebraicClosure F ≃ₐ[↥M_L] AlgebraicClosure F := e_zw.liftNormal (AlgebraicClosure F)
      have hτ_z : τ_M z = w := by
        have h1 := AlgEquiv.liftNormal_commutes e_zw (AlgebraicClosure F) (IntermediateField.AdjoinSimple.gen ↥M_L z)
        have h2 : e_zw (IntermediateField.AdjoinSimple.gen ↥M_L z) = IntermediateField.AdjoinSimple.gen ↥M_L w :=
          minpoly.algEquiv_apply hz_alg h_mp
        rw [h2] at h1
        exact h1
      let τ : AbsGal F :=
        { toRingEquiv := τ_M.toRingEquiv
          commutes' := fun r => by
            rw [IsScalarTower.algebraMap_apply F ↥L (AlgebraicClosure F),
              IsScalarTower.algebraMap_apply ↥L ↥M_L (AlgebraicClosure F)]
            exact τ_M.commutes _ }
      have hτM : τ ∈ M.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro u hu
        let u_M : ↥M_L := ⟨u, (IntermediateField.mem_extendScalars h).mpr hu⟩
        exact τ_M.commutes u_M
      have h_conj : γ⁻¹ * τ * (γ⁻¹)⁻¹ ∈ M.fixingSubgroup :=
        hab.1 γ⁻¹ (Subgroup.inv_mem _ hγL) τ hτM
      have h_fix : (γ⁻¹ * τ * (γ⁻¹)⁻¹) y = y :=
        (IntermediateField.mem_fixingSubgroup_iff M _).mp h_conj y hy
      rw [inv_inv, AlgEquiv.mul_apply, AlgEquiv.mul_apply] at h_fix
      have h_ap : γ (γ⁻¹ (τ z)) = z := congrArg γ h_fix
      have h_inv : γ (γ⁻¹ (τ z)) = τ z := AlgEquiv.apply_symm_apply γ (τ z)
      rw [h_inv] at h_ap
      exact hτ_z.symm.trans h_ap
    have h_sub : Subsingleton ↥((minpoly ↥M_L z).rootSet (AlgebraicClosure F)) :=
      ⟨fun ⟨a, ha⟩ ⟨b, hb⟩ => Subtype.ext ((h_root_eq a ha).trans (h_root_eq b hb).symm)⟩
    have h_card_le : Fintype.card ↥((minpoly ↥M_L z).rootSet (AlgebraicClosure F)) ≤ 1 :=
      Fintype.card_le_one_iff_subsingleton.mpr h_sub
    have h_card_eq : Fintype.card ↥((minpoly ↥M_L z).rootSet (AlgebraicClosure F)) = (minpoly ↥M_L z).natDegree :=
      Polynomial.card_rootSet_eq_natDegree hP_sep (IsAlgClosed.splits _)
    have h_deg_pos : 0 < (minpoly ↥M_L z).natDegree := minpoly.natDegree_pos hz_int
    have h_deg_one : (minpoly ↥M_L z).natDegree = 1 := by omega
    obtain ⟨u, hu⟩ := minpoly.natDegree_eq_one_iff.mp h_deg_one
    have hz_mem_ML : z ∈ M_L := by
      rw [← hu]
      exact u.2
    exact (IntermediateField.mem_extendScalars h).mp hz_mem_ML
  haveI : Normal ↥L ↥M_L := by
    rw [IntermediateField.normal_iff_forall_map_le]
    intro ψ
    let ψ_equiv : AlgebraicClosure F ≃ₐ[↥L] AlgebraicClosure F :=
      AlgEquiv.ofBijective ψ (Algebra.IsAlgebraic.algHom_bijective ψ)
    let γ_sub := L.fixingSubgroupEquiv.symm ψ_equiv
    intro z hz
    rcases hz with ⟨y, hy, rfl⟩
    have hyM : y ∈ M := (IntermediateField.mem_extendScalars h).mp hy
    have hmem : (γ_sub : AbsGal F) y ∈ M_L :=
      (IntermediateField.mem_extendScalars h).mpr (hstab γ_sub.1 γ_sub.2 y hyM)
    exact hmem
  haveI : IsGalois ↥L ↥M_L := IsGalois.mk
  haveI : FiniteDimensional F ↥L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion h).injective
  haveI : FiniteDimensional F ↥M_L := ‹FiniteDimensional F M›
  haveI : FiniteDimensional ↥L ↥M_L := FiniteDimensional.right F ↥L ↥M_L
  intro σ hσL x hx
  refine ⟨fun i => hstab (σ ^ i) (Subgroup.pow_mem _ hσL i) x hx, ?_⟩
  set m := Module.finrank F M
  let σ_sub : L.fixingSubgroup := ⟨σ, hσL⟩
  let σ_L : AlgebraicClosure F ≃ₐ[↥L] AlgebraicClosure F := L.fixingSubgroupEquiv σ_sub
  let resHom : (AlgebraicClosure F ≃ₐ[↥L] AlgebraicClosure F) →* (↥M_L ≃ₐ[↥L] ↥M_L) :=
    AlgEquiv.restrictNormalHom (F := ↥L) ↥M_L
  let σ_bar : ↥M_L ≃ₐ[↥L] ↥M_L := resHom σ_L
  have h_card : Fintype.card (↥M_L ≃ₐ[↥L] ↥M_L) = Module.finrank ↥L ↥M_L := by
    rw [← Nat.card_eq_fintype_card, IsGalois.card_aut_eq_finrank ↥L ↥M_L]
  have h_pow_rel : σ_bar ^ (Module.finrank ↥L ↥M_L) = 1 := by
    rw [← h_card, pow_card_eq_one]
  have h_finrank : m = Module.finrank ↥L ↥M_L * Module.finrank F ↥L := by
    rw [mul_comm, Module.finrank_mul_finrank F ↥L ↥M_L]
    rfl
  have h_pow_abs : σ_bar ^ m = 1 := by
    rw [h_finrank, pow_mul, h_pow_rel, one_pow]
  have h_res_pow : resHom (σ_L ^ m) = 1 :=
    (resHom.map_pow σ_L m).trans h_pow_abs
  let x_L : ↥M_L := ⟨x, (IntermediateField.mem_extendScalars h).mpr hx⟩
  have h_restrict : (((resHom (σ_L ^ m)) x_L : ↥M_L) : AlgebraicClosure F) = (σ_L ^ m) x :=
    AlgEquiv.restrictNormalHom_apply M_L (σ_L ^ m) x_L
  rw [h_res_pow, AlgEquiv.one_apply] at h_restrict
  have h_pow_eq : (σ_L ^ m) x = (σ ^ m) x := by
    change ((L.fixingSubgroupEquiv σ_sub) ^ m) x = _
    rw [← map_pow L.fixingSubgroupEquiv σ_sub m]
    rfl
  exact h_pow_eq.symm.trans h_restrict.symm

theorem le_ltFixedSubfield_sup_unramDegSubfield (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (h : L ≤ M) :
    IsAbelianExt F h →
      M ≤ ltFixedSubfield F L M (Module.finrank F M) ⊔
        unramDegSubfield F L (Module.finrank F M) :=
by
  intro hab
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion h).injective
  set m := Module.finrank F M
  have hm : 1 ≤ m := Nat.succ_le_of_lt (Module.finrank_pos (R := F) (M := M))
  set π := chosenUniformizer F L
  set σ := lubinTateFrob F L π
  have hπ : valL F L π = 1 := (valL_chosenUniformizer_and_mul_zpow F L 1).1
  have hraw_eq : rawRecMap F L π = σ := by
    dsimp [rawRecMap, σ, π]
    rw [hπ, sub_self, zpow_zero, mul_one, zpow_zero, mul_one]
  obtain ⟨hmem, hfrob⟩ := rawRecMap_actsAsFrobPow_and_mem_relWeil F L π
  have hσL : σ ∈ L.fixingSubgroup := by
    rw [← hraw_eq]
    exact hmem.2
  have hσFrob : ActsAsFrobPow F σ (-(resDeg F L : ℤ)) := by
    rw [← hraw_eq]
    have hrel : relVal F L π = (resDeg F L : ℤ) := by
      rw [relVal_eq_resDeg_mul_valL F L π, hπ, mul_one]
    rwa [← hrel]
  obtain ⟨ζ₀, hζ_U, hζ_m, hζ_ne⟩ :=
    exists_root_unramDegSubfield_pow_apply_eq_and_ne F L m hm σ hσFrob
  have hpow := pow_apply_mem_and_pow_finrank_apply_eq_of_isAbelianExt F L M h hab σ hσL
  set K := ltFixedSubfield F L M m
  set U := unramDegSubfield F L m
  have hM_MU : M ≤ M ⊔ U := le_sup_left
  have hU_MU : U ≤ M ⊔ U := le_sup_right
  have hK_KU : K ≤ K ⊔ U := le_sup_left
  have hU_KU : U ≤ K ⊔ U := le_sup_right
  have h_inf_K : (M ⊔ U) ⊓ IntermediateField.fixedField (Subgroup.zpowers σ) ≤ K := le_sup_right
  intro x hx
  obtain ⟨hx_M, hx_m⟩ := hpow x hx
  let w : ℕ → AlgebraicClosure F := fun k => ζ₀ ^ k * x
  let y : ℕ → AlgebraicClosure F := fun k => ∑ i ∈ Finset.range m, (σ ^ i) (w k)
  have hy_mem : ∀ k : ℕ, y k ∈ K ⊔ U := by
    intro k
    have hy_MU : y k ∈ M ⊔ U := by
      apply sum_mem
      intro i _
      dsimp [w]
      rw [map_mul, map_pow]
      apply mul_mem
      · apply pow_mem
        exact hU_MU (hζ_U i)
      · exact hM_MU (hx_M i)
    have hwm : (σ ^ m) (w k) = w k := by
      dsimp [w]
      rw [map_mul, map_pow, hζ_m, hx_m]
    have hy_fix1 : σ (y k) = y k := by
      dsimp [y]
      rw [map_sum]
      have h_step : ∀ i : ℕ, σ ((σ ^ i) (w k)) = (σ ^ (i + 1)) (w k) := by
        intro i
        rw [← AlgEquiv.mul_apply, ← pow_succ']
      simp_rw [h_step]
      have hm_eq : m = (m - 1) + 1 := (Nat.sub_add_cancel hm).symm
      conv_lhs => rw [hm_eq, Finset.sum_range_succ, ← hm_eq, hwm]
      conv_rhs => rw [hm_eq, Finset.sum_range_succ']
      simp [pow_zero]
    have hy_npow : ∀ n : ℕ, (σ ^ n) (y k) = y k := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [pow_succ', AlgEquiv.mul_apply, ih, hy_fix1]
    have hy_zpow : ∀ r : ℤ, (σ ^ r) (y k) = y k := by
      intro r
      cases r with
      | ofNat n =>
        rw [Int.ofNat_eq_natCast, zpow_natCast]
        exact hy_npow n
      | negSucc n =>
        rw [zpow_negSucc]
        have h1 := congrArg (fun z => (σ ^ (n + 1))⁻¹ z) (hy_npow (n + 1))
        dsimp only at h1
        have h2 : (σ ^ (n + 1))⁻¹ ((σ ^ (n + 1)) (y k)) = y k :=
          AlgEquiv.symm_apply_apply (σ ^ (n + 1)) (y k)
        rw [h2] at h1
        exact h1.symm
    have hy_fixed : y k ∈ IntermediateField.fixedField (Subgroup.zpowers σ) := by
      intro ⟨g, hg⟩
      rw [Subgroup.mem_zpowers_iff] at hg
      rcases hg with ⟨r, rfl⟩
      exact hy_zpow r
    have hy_K : y k ∈ K :=
      h_inf_K (IntermediateField.mem_inf.mpr ⟨hy_MU, hy_fixed⟩)
    exact hK_KU hy_K
  let P : Polynomial (AlgebraicClosure F) :=
    ∏ j ∈ Finset.Ico 1 m, (Polynomial.X - Polynomial.C ((σ ^ j) ζ₀))
  have hP_coeff : ∀ k : ℕ, P.coeff k ∈ K ⊔ U := by
    dsimp [P]
    refine Finset.prod_induction _
      (fun Q : Polynomial (AlgebraicClosure F) => ∀ k, Q.coeff k ∈ K ⊔ U) ?_ ?_ ?_
    · intro A B hA hB k
      rw [Polynomial.coeff_mul]
      exact sum_mem fun p _ => mul_mem (hA p.1) (hB p.2)
    · intro k
      rw [Polynomial.coeff_one]
      split_ifs
      · exact one_mem _
      · exact zero_mem _
    · intro j _ k
      rw [Polynomial.coeff_sub, Polynomial.coeff_X, Polynomial.coeff_C]
      apply sub_mem
      · split_ifs
        · exact one_mem _
        · exact zero_mem _
      · split_ifs
        · exact hU_KU (hζ_U j)
        · exact zero_mem _
  have hP_eval_zero : ∀ i : ℕ, 1 ≤ i → i < m → Polynomial.eval ((σ ^ i) ζ₀) P = 0 := by
    intro i hi1 hi2
    dsimp [P]
    rw [Polynomial.eval_prod]
    apply Finset.prod_eq_zero (Finset.mem_Ico.mpr ⟨hi1, hi2⟩)
    simp
  have hP_eval_mem : Polynomial.eval ζ₀ P ∈ K ⊔ U := by
    dsimp [P]
    rw [Polynomial.eval_prod]
    apply prod_mem
    intro j _
    simp only [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
    apply sub_mem
    · have h0 := hζ_U 0
      rw [pow_zero, AlgEquiv.one_apply] at h0
      exact hU_KU h0
    · exact hU_KU (hζ_U j)
  have hP_eval_ne : Polynomial.eval ζ₀ P ≠ 0 := by
    change Polynomial.eval ζ₀
      (∏ j ∈ Finset.Ico 1 m, (Polynomial.X - Polynomial.C ((σ ^ j) ζ₀))) ≠ 0
    rw [Polynomial.eval_prod, Finset.prod_ne_zero_iff]
    intro j hj
    rw [Finset.mem_Ico] at hj
    simp only [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
    exact sub_ne_zero.mpr (hζ_ne j hj.1 hj.2).symm
  let S : AlgebraicClosure F := ∑ k ∈ P.support, P.coeff k * y k
  have hS_mem : S ∈ K ⊔ U := sum_mem fun k _ => mul_mem (hP_coeff k) (hy_mem k)
  have hS_eq : S = Polynomial.eval ζ₀ P * x := by
    dsimp [S, y, w]
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    have h_inner : ∀ i : ℕ,
        ∑ k ∈ P.support, P.coeff k * (σ ^ i) (ζ₀ ^ k * x) =
          Polynomial.eval ((σ ^ i) ζ₀) P * (σ ^ i) x := by
      intro i
      have h_term : ∀ k : ℕ,
          P.coeff k * (σ ^ i) (ζ₀ ^ k * x) =
            (P.coeff k * ((σ ^ i) ζ₀) ^ k) * (σ ^ i) x := by
        intro k
        rw [map_mul, map_pow, mul_assoc]
      simp_rw [h_term]
      rw [← Finset.sum_mul, Polynomial.eval_eq_sum, Polynomial.sum_def]
    simp_rw [h_inner]
    rw [Finset.sum_eq_single 0]
    · simp [pow_zero]
    · intro i hi hi0
      rw [Finset.mem_range] at hi
      have hi1 : 1 ≤ i := Nat.one_le_iff_ne_zero.mpr hi0
      rw [hP_eval_zero i hi1 hi, zero_mul]
    · intro h0
      exfalso
      exact h0 (Finset.mem_range.mpr (by omega))
  have hx_eq : x = (Polynomial.eval ζ₀ P)⁻¹ * S := by
    rw [hS_eq, inv_mul_cancel_left₀ hP_eval_ne]
  rw [hx_eq]
  exact mul_mem (inv_mem hP_eval_mem) hS_mem

theorem finiteDimensional_lubinTateUnramField (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (n m : ℕ) :
    1 ≤ m → FiniteDimensional F (lubinTateUnramField F L n m) :=
by
  intro hm
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_pos : 0 < resDeg F L := by
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L u,
        (map_ne_zero (algebraMap F L)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F L (u : F)) = (u : F) ^ Module.finrank F L :=
        Algebra.norm_algebraMap (u : F)
      have hpow : addVal F ((u : F) ^ Module.finrank F L) =
          (Module.finrank F L : ℤ) * addVal F u := by
        change Multiplicative.toAdd (addValHom (u ^ Module.finrank F L)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu, mul_one]
    exact (Nat.sInf_mem hS).1
  have hres_ne : resDeg F L ≠ 0 := resDeg_pos.ne'
  have hq_gt : 1 < q F := Finite.one_lt_card
  have hqL_gt : 1 < qL F L := one_lt_pow₀ hq_gt hres_ne
  have h_gen : ∀ (K E : Type u) [Field K] [Field E] [Algebra K E] (c : K) (q0 : ℕ),
      1 < q0 →
      let f : Polynomial K := Polynomial.C c * Polynomial.X + Polynomial.X ^ q0
      ∀ (g : ℕ → Polynomial K),
        g 0 = Polynomial.X →
        (∀ k, g (k + 1) = f.comp (g k)) →
        ∀ k : ℕ, (g k).Monic ∧ (g k).natDegree = q0 ^ k ∧
          ∀ α : E, Polynomial.aeval α (g k) =
            ((fun y : E => algebraMap K E c * y + y ^ q0)^[k] α) := by
    intro K E _ _ _ c q0 hq0 f g hg0 hgs k
    have hdeg_lt : (Polynomial.C c * Polynomial.X).degree <
        (Polynomial.X ^ q0 : Polynomial K).degree := by
      rw [Polynomial.degree_X_pow]
      exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_le c) (WithBot.coe_lt_coe.mpr hq0)
    have hf_monic : f.Monic := by
      change (Polynomial.C c * Polynomial.X + Polynomial.X ^ q0).Monic
      rw [add_comm]
      exact Polynomial.Monic.add_of_left (Polynomial.monic_X_pow q0) hdeg_lt
    have hf_deg : f.natDegree = q0 := by
      change (Polynomial.C c * Polynomial.X + Polynomial.X ^ q0).natDegree = q0
      rw [add_comm, Polynomial.natDegree_add_eq_left_of_degree_lt hdeg_lt,
        Polynomial.natDegree_X_pow]
    induction k with
    | zero =>
      refine ⟨hg0 ▸ Polynomial.monic_X, ?_, ?_⟩
      · rw [hg0, Polynomial.natDegree_X, pow_zero]
      · intro α
        rw [hg0, Polynomial.aeval_X, Function.iterate_zero_apply]
    | succ k ih =>
      obtain ⟨ih_monic, ih_deg, ih_aeval⟩ := ih
      have h_deg_ne : (g k).natDegree ≠ 0 := by
        rw [ih_deg]
        exact pow_ne_zero k (by omega)
      refine ⟨?_, ?_, ?_⟩
      · rw [hgs k]
        exact hf_monic.comp ih_monic h_deg_ne
      · rw [hgs k, Polynomial.natDegree_comp, hf_deg, ih_deg, pow_succ']
      · intro α
        rw [hgs k, Polynomial.aeval_comp, ih_aeval, Function.iterate_succ_apply']
        change Polynomial.aeval _ (Polynomial.C c * Polynomial.X + Polynomial.X ^ q0) = _
        rw [map_add, map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
  let ϖ := chosenUniformizer F L
  let P : Polynomial L := lubinTateIterPoly F L (ϖ : L) n
  obtain ⟨hP_monic, _, hP_aeval⟩ := h_gen ↥L (AlgebraicClosure F) (ϖ : L) (qL F L) hqL_gt
    (lubinTateIterPoly F L (ϖ : L)) rfl (fun _ => rfl) n
  let S₁ : Set (AlgebraicClosure F) := {α : AlgebraicClosure F | isLubinTateRoot F L ϖ n α}
  have hS₁ : S₁.Finite := by
    refine (Polynomial.rootSet_finite P (AlgebraicClosure F)).subset (fun α hα => ?_)
    rw [Polynomial.Monic.mem_rootSet hP_monic, hP_aeval α]
    exact hα
  let S₂ : Set (AlgebraicClosure F) := {ζ : AlgebraicClosure F | ζ ^ (qL F L ^ m - 1) = 1}
  have hS₂ : S₂.Finite := by
    have hqLm_gt : 1 < qL F L ^ m := one_lt_pow₀ hqL_gt (by omega)
    have hN_pos : 0 < qL F L ^ m - 1 := by omega
    let Q : Polynomial F := Polynomial.X ^ (qL F L ^ m - 1) - Polynomial.C 1
    have hQ_ne : Q ≠ 0 := Polynomial.X_pow_sub_C_ne_zero hN_pos 1
    refine (Polynomial.rootSet_finite Q (AlgebraicClosure F)).subset (fun ζ hζ => ?_)
    rw [Polynomial.mem_rootSet_of_ne hQ_ne]
    change Polynomial.aeval ζ (Polynomial.X ^ (qL F L ^ m - 1) - Polynomial.C (1 : F)) = 0
    rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, map_one, sub_eq_zero]
    exact hζ
  haveI : Finite ↑(S₁ ∪ S₂) := (hS₁.union hS₂).to_subtype
  haveI : FiniteDimensional F (IntermediateField.adjoin F (S₁ ∪ S₂)) :=
    IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)
  unfold lubinTateUnramField
  exact IntermediateField.finiteDimensional_sup L (IntermediateField.adjoin F (S₁ ∪ S₂))

theorem isAbelianExt_lubinTateUnramField (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (n m : ℕ) :
    1 ≤ n → 1 ≤ m → IsAbelianExt F (le_sup_left : L ≤ lubinTateUnramField F L n m) :=
by
  intro hn hm
  set π := chosenUniformizer F L
  have hπ : valL F L π = 1 := (valL_chosenUniformizer_and_mul_zpow F L 1).1
  have hres_ne : resDeg F L ≠ 0 := by
    intro h0
    unfold valL at hπ
    rw [h0, Nat.cast_zero, Int.ediv_zero] at hπ
    omega
  have hres_pos : 0 < resDeg F L := Nat.pos_of_ne_zero hres_ne
  have hq_gt : 1 < q F := Finite.one_lt_card
  have hqL_gt : 1 < qL F L := one_lt_pow₀ hq_gt hres_ne
  
  have h_gen_lt : ∀ (K E : Type u) [Field K] [Field E] [Algebra K E] [IsAlgClosed E]
      (g_n f_n g_prev : Polynomial K) (P : K → Polynomial K) (Q_deg : ℕ) (S : Finset K),
      g_n.Monic → g_n.natDegree = Q_deg → f_n.Monic → Irreducible f_n →
      g_n = g_prev * f_n → S.card = Q_deg →
      (∀ a ∈ S, (g_n.comp (P a)) %ₘ g_n = 0) →
      (∀ a₁ ∈ S, ∀ a₂ ∈ S, a₁ ≠ a₂ → ¬ (f_n ∣ (P a₁ - P a₂))) →
      (∀ (π_n : E), Polynomial.aeval π_n g_n = 0 →
        ∀ a ∈ S, ∀ b ∈ S,
          Polynomial.aeval π_n (P (a * b)) =
            Polynomial.aeval (Polynomial.aeval π_n (P b)) (P a)) →
      ∀ (α : E), Polynomial.aeval α g_n = 0 →
        IsSeparable K α ∧ ∀ (σ τ : E ≃ₐ[K] E), σ (τ α) = τ (σ α) := by
    intro K E _ _ _ _ g_n f_n g_prev P Q_deg S hg_monic hg_deg hf_monic hf_irr
      h_gn_eq hS_card h_mod h_not_dvd h_comm_P α hα
    have hf_deg_ne : f_n.degree ≠ 0 := hf_irr.degree_pos.ne'
    obtain ⟨π_n, hπ_aeval⟩ := IsAlgClosed.exists_aeval_eq_zero E f_n hf_deg_ne
    have hπ_gn : Polynomial.aeval π_n g_n = 0 := by
      rw [h_gn_eq, map_mul, hπ_aeval, mul_zero]
    let Φ : K → E := fun a => Polynomial.aeval π_n (P a)
    set G_n : Polynomial E := g_n.map (algebraMap K E)
    set R : Finset E := (g_n.aroots E).toFinset
    have hGn_monic : G_n.Monic := hg_monic.map (algebraMap K E)
    have hGn_deg : G_n.natDegree = Q_deg := by
      rw [hg_monic.natDegree_map, hg_deg]
    have hR_card : R.card ≤ Q_deg := by
      calc R.card ≤ (g_n.aroots E).card := Multiset.toFinset_card_le (g_n.aroots E)
        _ ≤ G_n.natDegree := Polynomial.card_roots' G_n
        _ = Q_deg := hGn_deg
    have h_mem_R : ∀ β : E, β ∈ R ↔ Polynomial.aeval β g_n = 0 := by
      intro β
      rw [Multiset.mem_toFinset, Polynomial.mem_aroots]
      exact ⟨fun h => h.2, fun h => ⟨hg_monic.ne_zero, h⟩⟩
    have h_sub : S.image Φ ⊆ R := by
      intro β hβ
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hβ
      rw [h_mem_R]
      have h_div := (Polynomial.modByMonic_add_div (g_n.comp (P a)) hg_monic).symm
      have h_eval := congrArg (Polynomial.aeval π_n) h_div
      rw [Polynomial.aeval_comp, h_mod a ha, map_add, map_zero, zero_add, map_mul, hπ_gn,
        zero_mul] at h_eval
      exact h_eval
    have h_inj : Set.InjOn Φ (S : Set K) := by
      intro a₁ ha₁ a₂ ha₂ h_eq
      by_contra hne
      have h_aeval_D : Polynomial.aeval π_n (P a₁ - P a₂) = 0 := by
        rw [map_sub]
        exact sub_eq_zero.mpr h_eq
      have h_minpoly : minpoly K π_n = f_n :=
        (minpoly.eq_of_irreducible_of_monic hf_irr hπ_aeval hf_monic).symm
      have h_dvd : f_n ∣ (P a₁ - P a₂) := by
        rw [← h_minpoly]
        exact minpoly.dvd K π_n h_aeval_D
      exact h_not_dvd a₁ ha₁ a₂ ha₂ hne h_dvd
    have h_im_card : (S.image Φ).card = Q_deg := by
      rw [Finset.card_image_of_injOn h_inj, hS_card]
    have h_card_le : R.card ≤ (S.image Φ).card := by
      rw [h_im_card]
      exact hR_card
    have h_eq_R : S.image Φ = R := (Finset.subset_iff_eq_of_card_le h_card_le).mp h_sub
