            Polynomial.C_eq_natCast]
        have h_id :
            (((P_pref N + M_mon).map (τ : AlgebraicClosure F →+* AlgebraicClosure F)).comp
              (Polynomial.X ^ qL F L)) - (P_pref N + M_mon) ^ qL F L =
            ((((P_pref N).map (τ : AlgebraicClosure F →+* AlgebraicClosure F)).comp
              (Polynomial.X ^ qL F L)) - (P_pref N) ^ qL F L) +
            (((M_mon.map (τ : AlgebraicClosure F →+* AlgebraicClosure F)).comp
              (Polynomial.X ^ qL F L)) - M_mon ^ qL F L) -
            Polynomial.C (p F : AlgebraicClosure F) * S_rem := by
