        have hlhs_ne : π_M * (galApply F hLM τ (g_nat r) - g_nat r) ≠ 0 := by
          rw [htel_r]
          exact hrhs_ne
        have hd_ne : galApply F hLM τ (g_nat r) - g_nat r ≠ 0 :=
          right_ne_zero_of_mul hlhs_ne
        have hval_eq := congrArg (valL F M) htel_r
        rw [h_val_mul hπ_ne hd_ne, h_val_mul hg_r hδ_ne, hπ_M, hval_r] at hval_eq
        refine ⟨h_eq, hd_ne, by omega⟩
    rcases le_or_gt 0 μ with hμ | hμ
    · have hr_eq : (r : ℤ) = μ := Int.natAbs_of_nonneg hμ
      refine ⟨g_nat r, hg_r, ?_, ?_⟩
      · rw [hval_r, hr_eq]
      · rwa [hr_eq] at h_dich_r
    · have hr_eq : (r : ℤ) = -μ := by omega
      refine ⟨(g_nat r)⁻¹, inv_ne_zero hg_r, ?_, ?_⟩
      · rw [h_val_inv hg_r, hval_r]
        omega
      · have hτg_ne : galApply F hLM τ (g_nat r) ≠ 0 := by
          intro h0
          have h1 := congrArg (galApply F hLM τ⁻¹) h0
          rw [galApply_inv_left, galApply_zero] at h1
          exact hg_r h1
        have h_inv_diff :
            (galApply F hLM τ (g_nat r)⁻¹ - (g_nat r)⁻¹) *
              (galApply F hLM τ (g_nat r) * g_nat r) =
            -(galApply F hLM τ (g_nat r) - g_nat r) := by
          rw [galApply_inv]
          field_simp [hτg_ne, hg_r]
          ring
        have h_prod_ne : galApply F hLM τ (g_nat r) * g_nat r ≠ 0 :=
          mul_ne_zero hτg_ne hg_r
        rcases h_dich_r with ⟨h_eq, hd0⟩ | ⟨h_ne, hd_ne, hval_d⟩
        · left
          refine ⟨h_eq, ?_⟩
          have h0 : (galApply F hLM τ (g_nat r)⁻¹ - (g_nat r)⁻¹) *
              (galApply F hLM τ (g_nat r) * g_nat r) = 0 := by
            rw [h_inv_diff, hd0, neg_zero]
          rcases mul_eq_zero.mp h0 with hd_inv0 | hprod0
          · exact hd_inv0
          · exact False.elim (h_prod_ne hprod0)
        · right
          have hneg_ne : -(galApply F hLM τ (g_nat r) - g_nat r) ≠ 0 :=
            neg_ne_zero.mpr hd_ne
          have hlhs_ne : (galApply F hLM τ (g_nat r)⁻¹ - (g_nat r)⁻¹) *
              (galApply F hLM τ (g_nat r) * g_nat r) ≠ 0 := by
            rw [h_inv_diff]
            exact hneg_ne
          have hd_inv_ne : galApply F hLM τ (g_nat r)⁻¹ - (g_nat r)⁻¹ ≠ 0 :=
            left_ne_zero_of_mul hlhs_ne
          have hval_inv_eq := congrArg (valL F M) h_inv_diff
          rw [h_val_mul hd_inv_ne h_prod_ne, h_val_mul hτg_ne hg_r, h_val_gal, hval_r,
            valL_neg, hval_d] at hval_inv_eq
          refine ⟨h_ne, hd_inv_ne, by omega⟩
  have h_trace_sum : ∀ (τ : Gbar), 2 ≤ valL F M (galApply F hLM τ π_M - π_M) →
      ∀ (s : ℤ) (ghat : M), (ghat = 0 ∨ s ≤ valL F M ghat) →
        ∃ h : M, (h = 0 ∨ s + 1 ≤ valL F M h) ∧
          galApply F hLM τ h - h = galApply F hLM (τ ^ (p F)) ghat - ghat := by
    intro τ hw s ghat hghat
    have hτ_ne : τ ≠ 1 := by
      intro h1
      have hw' := hw
      rw [h1, galApply_one, sub_self, h_val_zero_one.1] at hw'
      omega
    have h_step1 : V (s + 1) (galApply F hLM τ ghat - ghat) := by
      rcases h_shift τ hτ_ne s ghat hghat with h0 | hle
      · exact Or.inl h0
      · right; omega
    have h_pow_diff : ∀ r : ℕ, V (s + 1) (galApply F hLM (τ ^ r) ghat - ghat) := by
      intro r
      induction r with
      | zero =>
        rw [pow_zero, galApply_one, sub_self]
        exact Or.inl rfl
      | succ r ih =>
        have h_decomp : galApply F hLM (τ ^ (r + 1)) ghat - ghat =
            galApply F hLM τ (galApply F hLM (τ ^ r) ghat - ghat) +
              (galApply F hLM τ ghat - ghat) := by
          rw [pow_succ', galApply_mul_aut, galApply_sub]
          ring
        rw [h_decomp]
        exact hV_add (s + 1) (hV_gal (s + 1) τ ih) h_step1
    let h_sum : ℕ → M := fun N => ∑ r ∈ Finset.range N, galApply F hLM (τ ^ r) ghat
    have h_sum_prop : ∀ N : ℕ,
        V (s + 1) (h_sum N - (N : M) * ghat) ∧
        galApply F hLM τ (h_sum N) - h_sum N = galApply F hLM (τ ^ N) ghat - ghat := by
      intro N
      induction N with
      | zero =>
        dsimp [h_sum]
        refine ⟨Or.inl (by rw [Nat.cast_zero]; ring), ?_⟩
        rw [galApply_zero, pow_zero, galApply_one]
        ring
      | succ N ih =>
        obtain ⟨ih_V, ih_tel⟩ := ih
        have h_sum_succ : h_sum (N + 1) = h_sum N + galApply F hLM (τ ^ N) ghat := by
          dsimp [h_sum]
          exact Finset.sum_range_succ _ N
        have h_sub_succ : h_sum (N + 1) - ((N + 1 : ℕ) : M) * ghat =
            (h_sum N - (N : M) * ghat) + (galApply F hLM (τ ^ N) ghat - ghat) := by
          rw [h_sum_succ]
          push_cast
          ring
        have hV_succ : V (s + 1) (h_sum (N + 1) - ((N + 1 : ℕ) : M) * ghat) := by
          rw [h_sub_succ]
          exact hV_add (s + 1) ih_V (h_pow_diff N)
        have h_gal_N : galApply F hLM τ (galApply F hLM (τ ^ N) ghat) =
            galApply F hLM (τ ^ (N + 1)) ghat := by
          rw [← galApply_mul_aut, ← pow_succ']
        have htel_succ : galApply F hLM τ (h_sum (N + 1)) - h_sum (N + 1) =
            galApply F hLM (τ ^ (N + 1)) ghat - ghat := by
          rw [h_sum_succ, galApply_add, h_gal_N]
          linear_combination ih_tel
        exact ⟨hV_succ, htel_succ⟩
    obtain ⟨hV_p, htel_p⟩ := h_sum_prop (p F)
    have hV_p_ghat : V (s + 1) ((p F : M) * ghat) := by
      have h1 := hV_mul hp_val hghat
      rwa [add_comm 1 s] at h1
    have hV_h : V (s + 1) (h_sum (p F)) := by
      have h_eq : h_sum (p F) = (h_sum (p F) - (p F : M) * ghat) + (p F : M) * ghat := by
        ring
      rw [h_eq]
      exact hV_add (s + 1) hV_p hV_p_ghat
    exact ⟨h_sum (p F), hV_h, htel_p⟩
  exact ⟨h_orbit_prod, h_trace_sum⟩

theorem pow_p_dvd_valL_galApply_pow_p_sub_of_ne_one (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (hLM : L ≤ M) :
    (∀ (x : M), (x = 0 ∨ 0 ≤ valL F M x) →
      ∃ c : L, (c = 0 ∨ 0 ≤ valL F L c) ∧
        (x - IntermediateField.inclusion hLM c = 0 ∨
          1 ≤ valL F M (x - IntermediateField.inclusion hLM c))) →
    ∀ (π_M : M), valL F M π_M = 1 →
    (∀ τ : (IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM),
      τ ≠ 1 → galApply F hLM τ π_M ≠ π_M ∧ 1 ≤ valL F M (galApply F hLM τ π_M - π_M) ∧
        ∀ b : M, (b = 0 ∨ 0 ≤ valL F M b) →
          galApply F hLM τ b = b ∨
            valL F M (galApply F hLM τ π_M - π_M) ≤ valL F M (galApply F hLM τ b - b)) →
    Nat.Prime (p F) →
    (valL F M 0 = 0 ∧ valL F M 1 = 0) →
    (∀ {x y : M}, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) →
    (∀ {x : M}, x ≠ 0 → valL F M x⁻¹ = -valL F M x) →
    (∀ (τ : (IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM))
      (x : M), valL F M (galApply F hLM τ x) = valL F M x) →
    (∀ (k : ℤ) {x y : M}, (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
      (x + y = 0 ∨ k ≤ valL F M (x + y)) ∧ (x - y = 0 ∨ k ≤ valL F M (x - y))) →
    (∀ (k : ℤ) {x y : M}, x ≠ 0 → valL F M x = k → (y = 0 ∨ k + 1 ≤ valL F M y) →
      x + y ≠ 0 ∧ valL F M (x + y) = k) →
    (∀ (τ : (IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM)),
      τ ≠ 1 → ∀ (μ : ℤ) (x : M), (x = 0 ∨ μ ≤ valL F M x) →
        galApply F hLM τ x - x = 0 ∨
          μ + (valL F M (galApply F hLM τ π_M - π_M) - 1) ≤ valL F M (galApply F hLM τ x - x)) →
    (∀ (τ : (IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM)),
      2 ≤ valL F M (galApply F hLM τ π_M - π_M) →
        ∀ (c : ℕ), 1 ≤ c → ¬ (p F ∣ c) →
          galApply F hLM (τ ^ c) π_M ≠ π_M ∧
          valL F M (galApply F hLM (τ ^ c) π_M - π_M) = valL F M (galApply F hLM τ π_M - π_M)) →
    (∀ (τ : (IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM)),
      2 ≤ valL F M (galApply F hLM τ π_M - π_M) → τ ^ (p F) ≠ 1 →
        valL F M (galApply F hLM τ π_M - π_M) + 1 ≤
          valL F M (galApply F hLM (τ ^ (p F)) π_M - π_M)) →
    (∀ (τ : (IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM))
      (μ : ℤ),
      ∃ g : M, g ≠ 0 ∧ valL F M g = μ ∧
        ((galApply F hLM (τ ^ μ.natAbs) π_M = π_M ∧ galApply F hLM τ g - g = 0) ∨
          (galApply F hLM (τ ^ μ.natAbs) π_M ≠ π_M ∧ galApply F hLM τ g - g ≠ 0 ∧
            valL F M (galApply F hLM τ g - g) =
              μ + valL F M (galApply F hLM (τ ^ μ.natAbs) π_M - π_M) - 1))) →
    (∀ (τ : (IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM)),
      2 ≤ valL F M (galApply F hLM τ π_M - π_M) →
        ∀ (s : ℤ) (ghat : M), (ghat = 0 ∨ s ≤ valL F M ghat) →
          ∃ h : M, (h = 0 ∨ s + 1 ≤ valL F M h) ∧
            galApply F hLM τ h - h = galApply F hLM (τ ^ (p F)) ghat - ghat) →
    ∀ (n₀ : ℕ) (τ : (IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM)),
      2 ≤ valL F M (galApply F hLM τ π_M - π_M) →
      τ ^ ((p F) ^ n₀) ≠ 1 →
