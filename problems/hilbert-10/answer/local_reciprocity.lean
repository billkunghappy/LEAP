        rw [← Polynomial.sub_comp, h_comp_right_succ m hf₀_coeff_0 hτD_le, hf₀_coeff_1,
          ← Polynomial.map_sub, Polynomial.coeff_map]
        rfl
      have h_id : (τψ.comp f₀_poly - fπ.comp ψ).coeff (m + 1) =
