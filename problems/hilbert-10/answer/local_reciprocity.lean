theorem isIntegralDivPow_frob_sub_aeval_endoTrunc_of_colemanTheta (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (π u : Lˣ) :
    valL F L π = 1 → valL F L u = 0 →
      ∀ (σ : AbsGal F), IsLubinTateFrob F L (u * π) σ →
        ∀ (n : ℕ) (α : AlgebraicClosure F), isLubinTateRoot F L π n α →
        ∀ (m : ℕ),
          let N := (qL F L) ^ n
          let r := m * N
          let M₀ := r * N
          let r₁ := M₀ * N
          ∀ (ε ε' : AlgebraicClosure F) (θ : Polynomial (AlgebraicClosure F)),
            IsIntegral 𝒪[F] ε →
            IsIntegral 𝒪[F] ε' →
            IsIntegralDivPow F L (π : L) 1 (ε * ε' - 1) →
            θ.coeff 0 = 0 →
            (1 ≤ r₁ → θ.coeff 1 = ε) →
            θ.natDegree ≤ r₁ →
            (∀ k : ℕ, IsIntegral 𝒪[F] (θ.coeff k)) →
            (∀ k : ℕ, k ≤ r₁ →
              IsIntegralDivPow F L (π : L) M₀
                ((((θ.map ((σ⁻¹ ^ n : AbsGal F) : AlgebraicClosure F →+* AlgebraicClosure F)).comp
                  ((lubinTateIterPoly F L (π : L) n).map (algebraMap L (AlgebraicClosure F)))) -
                  ((lubinTateIterPoly F L ((u * π : Lˣ) : L) n).map
                    (algebraMap L (AlgebraicClosure F))).comp θ).coeff k)) →
            (∀ k : ℕ, k ≤ r₁ →
              IsIntegralDivPow F L (π : L) M₀
                (((θ.map ((σ⁻¹ : AbsGal F) : AlgebraicClosure F →+* AlgebraicClosure F)) -
                  θ.comp ((lubinTateEndoTrunc F L (π : L) (u : L) r₁).map
                    (algebraMap L (AlgebraicClosure F)))).coeff k)) →
            (∀ (P : Polynomial L), P.Monic → 1 ≤ P.natDegree →
              ∀ (x : AlgebraicClosure F) (r₀ : ℕ),
                IsIntegralDivPow F L (π : L) (r₀ * P.natDegree) (Polynomial.aeval x P) →
                ∃ β : AlgebraicClosure F,
                  Polynomial.aeval β P = 0 ∧ IsIntegralDivPow F L (π : L) r₀ (x - β)) →
            IsIntegralDivPow F L (π : L) m
              (σ α - Polynomial.aeval α (lubinTateEndoTrunc F L (π : L) (u : L) r)) :=
by
  intro hπ hu σ hσ n α hα m
  dsimp only
  intro ε ε' θ hε_int hε'_int hε_unit hθ₀ hθ₁ hθ_deg hθ_int hθ_iter hθ_comm h_root
  let N := (qL F L) ^ n
  let r := m * N
  let M₀ := r * N
  let r₁ := M₀ * N
  let π₀ : Lˣ := chosenUniformizer F L
  let πL : L := (π : L)
  let uL : L := (u : L)
  let πbar : AlgebraicClosure F := algebraMap L (AlgebraicClosure F) πL
