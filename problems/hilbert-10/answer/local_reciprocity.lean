    | succ r ih =>
      obtain ⟨ihA, ihB, ihAB⟩ := ih
      refine ⟨by rw [pow_succ]; exact hpoly_mul 0 0 ihA hA,
        by rw [pow_succ]; exact hpoly_mul 0 0 ihB hB, ?_⟩
      have h_ring : A ^ (r + 1) - B ^ (r + 1) = (A ^ r - B ^ r) * A + B ^ r * (A - B) := by ring
      rw [h_ring]
      have h1 : polyValLe F E₀ (1 + 0) ((A ^ r - B ^ r) * A) := hpoly_mul 1 0 ihAB hA
      have h2 : polyValLe F E₀ (0 + 1) (B ^ r * (A - B)) := hpoly_mul 0 1 ihB hAB
      exact hpoly_add 1 h1 h2
  have hg_val : ∀ k : ℕ,
      polyValLe F E₀ 0 (relLubinTateIterPoly F L E₀ τ (ϖ : E₀) k) ∧
      polyValLe F E₀ 1 (relLubinTateIterPoly F L E₀ τ (ϖ : E₀) k - Polynomial.X ^ ((qL F L) ^ k)) := by
    intro k
    induction k with
    | zero =>
      dsimp [relLubinTateIterPoly]
      rw [pow_one, sub_self]
      refine ⟨by simpa using hpoly_X_pow 1, fun i => Or.inl (Polynomial.coeff_zero i)⟩
    | succ k ih =>
      obtain ⟨ih0, ih1⟩ := ih
      set gk := relLubinTateIterPoly F L E₀ τ (ϖ : E₀) k
      set ck := relLubinTateCoeff F E₀ τ (ϖ : E₀) k
      have h_comp : relLubinTateIterPoly F L E₀ τ (ϖ : E₀) (k + 1) =
          Polynomial.C ck * gk + gk ^ qL F L := by
        change (Polynomial.C ck * Polynomial.X + Polynomial.X ^ qL F L).comp gk = _
        rw [Polynomial.add_comp, Polynomial.mul_comp, Polynomial.C_comp, Polynomial.X_comp,
          Polynomial.pow_comp, Polynomial.X_comp]
      obtain ⟨h_pow0, -, h_pow1⟩ := hpoly_pow_sub ih0 (hpoly_X_pow ((qL F L) ^ k)) ih1 (qL F L)
      have h_X_pow_eq : (Polynomial.X ^ ((qL F L) ^ k) : Polynomial E₀) ^ qL F L =
          Polynomial.X ^ ((qL F L) ^ (k + 1)) := by
        rw [← pow_mul, ← pow_succ]
      rw [h_X_pow_eq] at h_pow1
      have h_C_gk1 : polyValLe F E₀ 1 (Polynomial.C ck * gk) := hpoly_mul 1 0 (hpoly_C_ϖ k) ih0
      have h_C_gk0 : polyValLe F E₀ 0 (Polynomial.C ck * gk) := by
        intro i
        rcases h_C_gk1 i with h0 | hle
        · exact Or.inl h0
        · right
          omega
      rw [h_comp]
      refine ⟨hpoly_add 0 h_C_gk0 h_pow0, ?_⟩
      have h_sub_eq : Polynomial.C ck * gk + gk ^ qL F L -
          Polynomial.X ^ ((qL F L) ^ (k + 1)) =
          Polynomial.C ck * gk + (gk ^ qL F L - Polynomial.X ^ ((qL F L) ^ (k + 1))) := by
        ring
      rw [h_sub_eq]
      exact hpoly_add 1 h_C_gk1 h_pow1
  have hfn_val : polyValLe F E₀ 1 (fn - Polynomial.X ^ d) := by
    obtain ⟨hg0, hg1⟩ := hg_val (m - 1)
    obtain ⟨-, -, hP0_sub⟩ :=
      hpoly_pow_sub hg0 (hpoly_X_pow ((qL F L) ^ (m - 1))) hg1 (qL F L - 1)
    have h_X_d : (Polynomial.X ^ ((qL F L) ^ (m - 1)) : Polynomial E₀) ^ (qL F L - 1) =
        Polynomial.X ^ d := by
      rw [← pow_mul, mul_comm]
    rw [h_X_d] at hP0_sub
    have h_fn_sub : fn - Polynomial.X ^ d = (P0 - Polynomial.X ^ d) + Polynomial.C c_prev := by
      change P0 + Polynomial.C c_prev - Polynomial.X ^ d = _
      ring
    rw [h_fn_sub]
    exact hpoly_add 1 hP0_sub (hpoly_C_ϖ (m - 1))
  refine ⟨hfn_monic, hfn_deg, hfn_coeff0, hfn_coeff0_val, ?_, hFm_eq⟩
  have hfn_not_unit : ¬ IsUnit fn := by
    intro hu
    have hdeg0 : fn.degree = 0 := Polynomial.isUnit_iff_degree_eq_zero.mp hu
    have hnd0 : fn.natDegree = 0 :=
      Polynomial.natDegree_eq_zero_iff_degree_le_zero.mpr (le_of_eq hdeg0)
    omega
  let W : Polynomial E₀ → ℕ → ℤ := fun P i => (d : ℤ) * valL F E₀ (P.coeff i) + (i : ℤ)
  have hW_fn : ∀ k : ℕ, fn.coeff k ≠ 0 → (d : ℤ) ≤ W fn k := by
    intro k hk_ne
    have hk_le : k ≤ d := by
      by_contra hlt
      push_neg at hlt
      rw [← hfn_deg] at hlt
      exact hk_ne (Polynomial.coeff_eq_zero_of_natDegree_lt hlt)
    by_cases hk_eq : k = d
    · subst hk_eq
      have h_lc : fn.coeff d = 1 := by
        rw [← hfn_deg, Polynomial.coeff_natDegree, hfn_monic.leadingCoeff]
      dsimp [W]
      rw [h_lc, valL_one, mul_zero, zero_add]
    · have hX_zero : (Polynomial.X ^ d : Polynomial E₀).coeff k = 0 := by
        rw [Polynomial.coeff_X_pow, if_neg hk_eq]
      have h_sub_coeff : (fn - Polynomial.X ^ d).coeff k = fn.coeff k := by
        rw [Polynomial.coeff_sub, hX_zero, sub_zero]
      rcases hfn_val k with h0 | hle
      · rw [h_sub_coeff] at h0
        exact False.elim (hk_ne h0)
      · rw [h_sub_coeff] at hle
        have hle' : 1 ≤ valL F E₀ (fn.coeff k) := hle
        have hd_ge : (d : ℤ) ≤ (d : ℤ) * valL F E₀ (fn.coeff k) := by
          calc (d : ℤ) = (d : ℤ) * 1 := (mul_one _).symm
            _ ≤ (d : ℤ) * valL F E₀ (fn.coeff k) :=
              mul_le_mul_of_nonneg_left hle' (by positivity)
        have hk_nn : (0 : ℤ) ≤ (k : ℤ) := Nat.cast_nonneg k
        dsimp [W]
        linarith
  rw [irreducible_iff]
  refine ⟨hfn_not_unit, fun A B hAB => ?_⟩
  by_contra h_neither
  push_neg at h_neither
  obtain ⟨hA_nu, hB_nu⟩ := h_neither
  have hfn_ne : fn ≠ 0 := hfn_monic.ne_zero
  have hA_ne : A ≠ 0 := by
    rintro rfl
    rw [zero_mul] at hAB
    exact hfn_ne hAB
  have hB_ne : B ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hAB
    exact hfn_ne hAB
  set r := A.natDegree
  set s := B.natDegree
  have hr_pos : 1 ≤ r := by
    by_contra hr0
    have hr_eq : r = 0 := by omega
    have hdeg_le : A.degree ≤ 0 := Polynomial.natDegree_eq_zero_iff_degree_le_zero.mp hr_eq
    have hdeg_eq : A.degree = 0 :=
      le_antisymm hdeg_le (Polynomial.zero_le_degree_iff.mpr hA_ne)
    exact hA_nu (Polynomial.isUnit_iff_degree_eq_zero.mpr hdeg_eq)
  have hs_pos : 1 ≤ s := by
    by_contra hs0
    have hs_eq : s = 0 := by omega
    have hdeg_le : B.degree ≤ 0 := Polynomial.natDegree_eq_zero_iff_degree_le_zero.mp hs_eq
    have hdeg_eq : B.degree = 0 :=
      le_antisymm hdeg_le (Polynomial.zero_le_degree_iff.mpr hB_ne)
    exact hB_nu (Polynomial.isUnit_iff_degree_eq_zero.mpr hdeg_eq)
  have hrs_eq : r + s = d := by
    have h := Polynomial.natDegree_mul hA_ne hB_ne
    rw [← hAB, hfn_deg] at h
    exact h.symm
  obtain ⟨i₀, hi₀_mem, hi₀_min⟩ :=
    Finset.exists_min_image A.support (W A) (Polynomial.support_nonempty.mpr hA_ne)
  obtain ⟨j₀, hj₀_mem, hj₀_min⟩ :=
    Finset.exists_min_image B.support (W B) (Polynomial.support_nonempty.mpr hB_ne)
  have hi₀_le : i₀ ≤ r := Polynomial.le_natDegree_of_mem_supp i₀ hi₀_mem
  have hj₀_le : j₀ ≤ s := Polynomial.le_natDegree_of_mem_supp j₀ hj₀_mem
  have hi₀_strict : ∀ i ∈ A.support, i ≠ i₀ → W A i₀ < W A i := by
    intro i hi_mem hi_ne
    have hi_le : i ≤ r := Polynomial.le_natDegree_of_mem_supp i hi_mem
    have hle := hi₀_min i hi_mem
    have hne : W A i₀ ≠ W A i := by
      intro heq
      dsimp [W] at heq
      have h_dvd : (d : ℤ) * (valL F E₀ (A.coeff i) - valL F E₀ (A.coeff i₀)) =
          (i₀ : ℤ) - (i : ℤ) := by linarith
      have h_abs : |(i₀ : ℤ) - (i : ℤ)| < (d : ℤ) := by
        rw [abs_lt]
        omega
      rcases eq_or_ne (valL F E₀ (A.coeff i) - valL F E₀ (A.coeff i₀)) 0 with h0 | hne0
      · rw [h0, mul_zero] at h_dvd
        omega
      · have h_one : 1 ≤ |valL F E₀ (A.coeff i) - valL F E₀ (A.coeff i₀)| :=
          Int.one_le_abs hne0
        have h_ge : (d : ℤ) ≤ |(d : ℤ) * (valL F E₀ (A.coeff i) - valL F E₀ (A.coeff i₀))| := by
          rw [abs_mul, abs_of_nonneg (by positivity)]
          nlinarith
        rw [h_dvd] at h_ge
        omega
    omega
  have hj₀_strict : ∀ j ∈ B.support, j ≠ j₀ → W B j₀ < W B j := by
    intro j hj_mem hj_ne
    have hj_le : j ≤ s := Polynomial.le_natDegree_of_mem_supp j hj_mem
    have hle := hj₀_min j hj_mem
    have hne : W B j₀ ≠ W B j := by
      intro heq
      dsimp [W] at heq
      have h_dvd : (d : ℤ) * (valL F E₀ (B.coeff j) - valL F E₀ (B.coeff j₀)) =
          (j₀ : ℤ) - (j : ℤ) := by linarith
      have h_abs : |(j₀ : ℤ) - (j : ℤ)| < (d : ℤ) := by
        rw [abs_lt]
        omega
      rcases eq_or_ne (valL F E₀ (B.coeff j) - valL F E₀ (B.coeff j₀)) 0 with h0 | hne0
      · rw [h0, mul_zero] at h_dvd
        omega
      · have h_one : 1 ≤ |valL F E₀ (B.coeff j) - valL F E₀ (B.coeff j₀)| :=
          Int.one_le_abs hne0
        have h_ge : (d : ℤ) ≤ |(d : ℤ) * (valL F E₀ (B.coeff j) - valL F E₀ (B.coeff j₀))| := by
          rw [abs_mul, abs_of_nonneg (by positivity)]
          nlinarith
        rw [h_dvd] at h_ge
        omega
    omega
  set k₀ : ℕ := i₀ + j₀
  set m₀ : ℤ := valL F E₀ (A.coeff i₀) + valL F E₀ (B.coeff j₀)
  let x₀ : ℕ × ℕ := (i₀, j₀)
  have hx₀_mem : x₀ ∈ Finset.antidiagonal k₀ := Finset.mem_antidiagonal.mpr rfl
  let g : ℕ × ℕ → E₀ := fun x => A.coeff x.1 * B.coeff x.2
  have hAi₀_ne : A.coeff i₀ ≠ 0 := Polynomial.mem_support_iff.mp hi₀_mem
  have hBj₀_ne : B.coeff j₀ ≠ 0 := Polynomial.mem_support_iff.mp hj₀_mem
  have hg_x₀_ne : g x₀ ≠ 0 := mul_ne_zero hAi₀_ne hBj₀_ne
  have hg_x₀_val : valL F E₀ (g x₀) = m₀ := valL_mul hAi₀_ne hBj₀_ne
  have hg_other : ∀ x ∈ (Finset.antidiagonal k₀).erase x₀, V (m₀ + 1) (g x) := by
    intro x hx
    have hx_ne : x ≠ x₀ := (Finset.mem_erase.mp hx).1
    have hx_sum : x.1 + x.2 = i₀ + j₀ := Finset.mem_antidiagonal.mp (Finset.mem_erase.mp hx).2
    have hx1_ne : x.1 ≠ i₀ := by
      intro h1
      apply hx_ne
      ext
      · exact h1
      · change x.2 = j₀
        omega
    have hx2_ne : x.2 ≠ j₀ := by
      intro h2
      apply hx_ne
      ext
      · change x.1 = i₀
        omega
      · exact h2
    by_cases hgx : g x = 0
    · exact Or.inl hgx
    · right
      have hAx : A.coeff x.1 ≠ 0 := left_ne_zero_of_mul hgx
      have hBx : B.coeff x.2 ≠ 0 := right_ne_zero_of_mul hgx
      have hWA := hi₀_strict x.1 (Polynomial.mem_support_iff.mpr hAx) hx1_ne
      have hWB := hj₀_strict x.2 (Polynomial.mem_support_iff.mpr hBx) hx2_ne
      have h_val_gx : valL F E₀ (g x) = valL F E₀ (A.coeff x.1) + valL F E₀ (B.coeff x.2) :=
        valL_mul hAx hBx
      dsimp [W] at hWA hWB
      have h_ineq : (d : ℤ) * m₀ < (d : ℤ) * valL F E₀ (g x) := by
        rw [h_val_gx]
        have : (x.1 : ℤ) + (x.2 : ℤ) = (i₀ : ℤ) + (j₀ : ℤ) := by exact_mod_cast hx_sum
        linarith
      have h_lt : m₀ < valL F E₀ (g x) := by
        by_contra hle
        have : (d : ℤ) * valL F E₀ (g x) ≤ (d : ℤ) * m₀ :=
          mul_le_mul_of_nonneg_left (by omega) (by positivity)
        omega
      omega
  have h_sum_erase : V (m₀ + 1) (∑ x ∈ (Finset.antidiagonal k₀).erase x₀, g x) :=
    hV_sum (m₀ + 1) ((Finset.antidiagonal k₀).erase x₀) g hg_other
  have h_coeff_k₀ : fn.coeff k₀ = g x₀ + ∑ x ∈ (Finset.antidiagonal k₀).erase x₀, g x := by
    rw [hAB, Polynomial.coeff_mul, ← Finset.add_sum_erase _ g hx₀_mem]
  have h_not_V_k₀ : ¬ V (m₀ + 1) (fn.coeff k₀) := by
    intro hV_k₀
    have h_sub := hV_sub (m₀ + 1) hV_k₀ h_sum_erase
    have h_eq : fn.coeff k₀ - ∑ x ∈ (Finset.antidiagonal k₀).erase x₀, g x = g x₀ := by
      rw [h_coeff_k₀, add_sub_cancel_right]
    rw [h_eq] at h_sub
    rcases h_sub with h0 | hle
    · exact hg_x₀_ne h0
    · rw [hg_x₀_val] at hle
      omega
  have hfn_k₀_ne : fn.coeff k₀ ≠ 0 := by
    intro h0
    exact h_not_V_k₀ (Or.inl h0)
  have hfn_k₀_val : valL F E₀ (fn.coeff k₀) ≤ m₀ := by
    by_contra hgt
    exact h_not_V_k₀ (Or.inr (by omega))
  have hW_lower : (d : ℤ) ≤ W A i₀ + W B j₀ := by
    have h1 := hW_fn k₀ hfn_k₀_ne
    dsimp [W, k₀, m₀] at h1 ⊢
    have h2 : (d : ℤ) * valL F E₀ (fn.coeff k₀) ≤ (d : ℤ) * m₀ :=
      mul_le_mul_of_nonneg_left hfn_k₀_val (by positivity)
    linarith
  have h_lc_mul : A.coeff r * B.coeff s = 1 := by
    rw [Polynomial.coeff_natDegree, Polynomial.coeff_natDegree, ← Polynomial.leadingCoeff_mul,
      ← hAB, hfn_monic.leadingCoeff]
  have hAr_ne : A.coeff r ≠ 0 := left_ne_zero_of_mul_eq_one h_lc_mul
  have hBs_ne : B.coeff s ≠ 0 := right_ne_zero_of_mul_eq_one h_lc_mul
  have hr_mem : r ∈ A.support := Polynomial.mem_support_iff.mpr hAr_ne
  have hs_mem : s ∈ B.support := Polynomial.mem_support_iff.mpr hBs_ne
  have hW_rs : W A r + W B s = (d : ℤ) := by
    dsimp [W]
    have h_val_rs : valL F E₀ (A.coeff r) + valL F E₀ (B.coeff s) = 0 := by
      rw [← valL_mul hAr_ne hBs_ne, h_lc_mul, valL_one]
    have hrs_cast : (r : ℤ) + (s : ℤ) = (d : ℤ) := by exact_mod_cast hrs_eq
    linear_combination (d : ℤ) * h_val_rs + hrs_cast
  have h_c0_mul : A.coeff 0 * B.coeff 0 = fn.coeff 0 := by
    rw [← Polynomial.mul_coeff_zero, ← hAB]
  have hc0_ne : fn.coeff 0 ≠ 0 := by
    intro h0
    have h1 := hfn_coeff0_val
    rw [h0] at h1
    simp [valL, relVal, addVal] at h1
  have hA0_ne : A.coeff 0 ≠ 0 := by
    intro h0
    rw [h0, zero_mul] at h_c0_mul
    exact hc0_ne h_c0_mul.symm
  have hB0_ne : B.coeff 0 ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at h_c0_mul
    exact hc0_ne h_c0_mul.symm
  have h0A_mem : 0 ∈ A.support := Polynomial.mem_support_iff.mpr hA0_ne
  have h0B_mem : 0 ∈ B.support := Polynomial.mem_support_iff.mpr hB0_ne
  have hW_00 : W A 0 + W B 0 = (d : ℤ) := by
    dsimp [W]
    have h_val_00 : valL F E₀ (A.coeff 0) + valL F E₀ (B.coeff 0) = 1 := by
      rw [← valL_mul hA0_ne hB0_ne, h_c0_mul, hfn_coeff0_val]
    linear_combination (d : ℤ) * h_val_00
  by_cases hi₀_zero : i₀ = 0
  · have hi₀_ne_r : r ≠ i₀ := by omega
    have h1 := hi₀_strict r hr_mem hi₀_ne_r
    have h2 := hj₀_min s hs_mem
    linarith
  · have h0_ne_i₀ : 0 ≠ i₀ := Ne.symm hi₀_zero
    have h1 := hi₀_strict 0 h0A_mem h0_ne_i₀
    have h2 := hj₀_min 0 h0B_mem
    linarith

theorem exists_unramSubring_rel_frob_unit_lift (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (π u : Lˣ) :
    valL F L π = 1 → valL F L u = 0 →
      ∀ (f₀ : ℕ), 1 ≤ f₀ →
      ∀ (τ : AbsGal F), τ ∈ L.fixingSubgroup →
        (∀ ζ : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ → τ ζ = ζ ^ qL F L) →
        (∀ (P : Polynomial L), P.Monic → 1 ≤ P.natDegree →
          ∀ (x : AlgebraicClosure F) (r : ℕ),
            IsIntegralDivPow F L (π : L) (r * P.natDegree) (Polynomial.aeval x P) →
            ∃ β : AlgebraicClosure F,
              Polynomial.aeval β P = 0 ∧ IsIntegralDivPow F L (π : L) r (x - β)) →
        (∀ x ∈ unramSubring F L,
          IsIntegral 𝒪[F] x ∧
          τ x ∈ unramSubring F L ∧
          (τ x - x ^ qL F L) / algebraMap L (AlgebraicClosure F) (π : L) ∈ unramSubring F L ∧
          (∃ s : ℕ, 1 ≤ s ∧ (τ ^ s) x = x) ∧
          (∀ k : ℕ, IsIntegralDivPow F L (π : L) k x →
            x / (algebraMap L (AlgebraicClosure F) (π : L)) ^ k ∈ unramSubring F L)) →
        let E₀ := unramDegSubfield F L f₀
        ∀ [FiniteDimensional F E₀],
        resDeg F E₀ = resDeg F L * f₀ →
        (∀ x ∈ E₀, (τ ^ f₀) x = x) →
        ∀ (v : E₀ˣ), valL F E₀ v = 0 →
        (∏ j ∈ Finset.range f₀, (τ ^ j) ((v : E₀) : AlgebraicClosure F) =
          algebraMap L (AlgebraicClosure F) (u : L)) →
        ((v : E₀) : AlgebraicClosure F) ∈ unramSubring F L ∧
        ∀ (K : ℕ), ∃ ε ∈ unramSubring F L, ∃ ε' ∈ unramSubring F L,
          IsIntegralDivPow F L (π : L) 1 (ε * ε' - 1) ∧
          IsIntegralDivPow F L (π : L) K
            (((v : E₀) : AlgebraicClosure F) * τ ε - ε) ∧
          IsIntegralDivPow F L (π : L) K
            (algebraMap L (AlgebraicClosure F) (u : L) * ((τ ^ f₀) ε) - ε) :=
by
  intro hπ hu f₀ hf₀ τ hτL hτFrob h_root h_unram E₀ hFin_E₀ hres_E₀ hτf₀_E₀ v hv_val h_v_prod
  haveI : FiniteDimensional F E₀ := hFin_E₀
  
  have h_s1 : 2 ≤ qL F L ∧ Nat.Prime (p F) ∧ p F ∣ qL F L ∧
      algebraMap L (AlgebraicClosure F) (π : L) ∈ unramSubring F L ∧
      IsIntegralDivPow F L (π : L) 1 (p F : AlgebraicClosure F) ∧
      ¬ IsIntegralDivPow F L (π : L) 1 (1 : AlgebraicClosure F) ∧
      ((v : E₀) : AlgebraicClosure F) ∈ unramSubring F L ∧
      (((v⁻¹ : E₀ˣ) : E₀) : AlgebraicClosure F) ∈ unramSubring F L ∧
      (∀ x y : AlgebraicClosure F, IsIntegral 𝒪[F] x → IsIntegral 𝒪[F] y →
        IsIntegralDivPow F L (π : L) 1 ((x + y) ^ qL F L - (x ^ qL F L + y ^ qL F L))) := by
    have h_val_props : 0 < resDeg F L ∧
        (∀ {z : L}, z ≠ 0 → (IsIntegral 𝒪[F] z ↔ 0 ≤ valL F L z)) ∧
        (∀ {x y : L}, x ≠ 0 → y ≠ 0 → valL F L (x / y) = valL F L x - valL F L y) ∧
        valL F L 1 = 0 ∧
        IsIntegral 𝒪[F] ((p F : L) / (π : L)) ∧
        IsIntegral 𝒪[F] (v : E₀) ∧
        IsIntegral 𝒪[F] ((v⁻¹ : E₀ˣ) : E₀) := by
      have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
          0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
        intro a ha
        unfold addVal
        rw [dif_neg ha]
