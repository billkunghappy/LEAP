        dsimp [I]; omega
      have hK_eq : (s + 1) + (K : ℤ) = I n₀ + 1 := by
        dsimp [K, s]; omega
      rcases h_s3 n₀ τ h_pow_ne_and_ge h_nonhit_I h_distinct_I K (s + 1) le_rfl hK_eq h hh_val with
