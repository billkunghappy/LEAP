      rw [PowerBasis.leftMulMatrix, h_pb₁_minpoly]
      refine Matrix.ext fun j i => ?_
      change eval₀ (C (e.symm j.succ) (e.symm i.succ)) = _
      have hj_val : ((e.symm j.succ : Fin q) : ℕ) = (j : ℕ) + 1 := rfl
      have hi_val : ((e.symm i.succ : Fin q) : ℕ) = (i : ℕ) + 1 := rfl
      have hj_lt : (j : ℕ) < q - 1 := by
        have := j.isLt
        omega
      have hi_lt : (i : ℕ) < q - 1 := by
        have := i.isLt
        omega
      dsimp [C, bareCompanion, Matrix.of_apply]
      rw [hj_val, hi_val]
      by_cases hi_end : (i : ℕ) + 1 = pb₁.dim
      · have h_not_lt : ¬ ((i : ℕ) + 1 + 1 < q) := by omega
        rw [if_neg h_not_lt, if_pos hi_end]
        have hj_ne0 : (j : ℕ) + 1 ≠ 0 := by omega
        have hj_ne_q1 : (j : ℕ) ≠ q - 1 := by omega
        rw [if_neg hj_ne0]
        dsimp [D₁]
        rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, Polynomial.coeff_C,
          if_neg hj_ne_q1, zero_add]
        by_cases hj0 : (j : ℕ) = 0
        · have hj1 : (j : ℕ) + 1 = 1 := by omega
          rw [if_pos hj1, if_pos hj0]
          simp [eval₀]
        · have hj1 : (j : ℕ) + 1 ≠ 1 := by omega
          rw [if_neg hj1, if_neg hj0]
          simp [eval₀]
      · have h_lt : (i : ℕ) + 1 + 1 < q := by omega
        rw [if_pos h_lt, if_neg hi_end]
        by_cases hji : (j : ℕ) = (i : ℕ) + 1
        · have hji' : (j : ℕ) + 1 = (i : ℕ) + 1 + 1 := by omega
          rw [if_pos hji', if_pos hji]
          simp [eval₀]
        · have hji' : (j : ℕ) + 1 ≠ (i : ℕ) + 1 + 1 := by omega
          rw [if_neg hji', if_neg hji]
          simp [eval₀]
    have hN₀_pow_row0 : ∀ (r : ℕ) (i : Fin (pb₁.dim + 1)), (N₀ ^ (r + 1)) 0 i = 0 := by
      intro r i
      rw [pow_succ', Matrix.mul_apply]
      refine Finset.sum_eq_zero fun k _ => ?_
      rw [hN₀_row0 k, zero_mul]
    have hN₀_pow_sub : ∀ r : ℕ, (N₀ ^ r).submatrix Fin.succ Fin.succ = B₀ ^ r := by
      intro r
      induction r with
      | zero =>
        ext j i
        simp [Matrix.one_apply, Fin.ext_iff]
      | succ r ih =>
        rw [pow_succ, pow_succ, ← ih, ← hN₀_sub]
        ext j i
        simp only [Matrix.submatrix_apply, Matrix.mul_apply]
        rw [Fin.sum_univ_succ, hN₀_row0, mul_zero, zero_add]
    let M₀ : Matrix (Fin (pb₁.dim + 1)) (Fin (pb₁.dim + 1)) K := Polynomial.aeval N₀ A
    have hM₀_00 : M₀ 0 0 = A.coeff 0 := by
      dsimp [M₀]
      rw [Polynomial.aeval_eq_sum_range, Finset.sum_range_succ', Matrix.add_apply,
        pow_zero, Matrix.smul_apply, Matrix.one_apply_eq, smul_eq_mul, mul_one]
      have h_rest : (∑ k ∈ Finset.range A.natDegree, A.coeff (k + 1) • N₀ ^ (k + 1)) 0 0 = 0 := by
        rw [Matrix.sum_apply]
        refine Finset.sum_eq_zero fun k _ => ?_
        rw [Matrix.smul_apply, hN₀_pow_row0 k 0, smul_zero]
