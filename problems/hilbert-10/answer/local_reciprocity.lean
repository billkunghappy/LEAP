        have h_erase_sum : ∑ j ∈ T.erase j₀, t j = -t j₀ := by
          have h := Finset.add_sum_erase T t hj₀T
          rw [h_sum_T] at h
          linear_combination h
        have h_div_sum_int : IsIntegral 𝒪[F]
            (∑ j ∈ T.erase j₀, ((t j / t j₀) / πK)) := by
          refine (integralClosure 𝒪[F] K).sum_mem fun j hj => ?_
          have hjT : j ∈ T := (Finset.mem_erase.mp hj).2
          have h_ne1 : t j / t j₀ ≠ 0 := div_ne_zero (ht_ne j hjT) (ht_ne j₀ hj₀T)
          have h_ne2 : (t j / t j₀) / πK ≠ 0 := div_ne_zero h_ne1 hπK_ne
          change IsIntegral 𝒪[F] ((t j / t j₀) / πK)
          rw [h_int_valL h_ne2, valL_div h_ne1 hπK_ne, valL_div (ht_ne j hjT) (ht_ne j₀ hj₀T), hπ_val]
          have hlt := h_strict j hj
          omega
        have h_sum_eq : (∑ j ∈ T.erase j₀, ((t j / t j₀) / πK)) = (-1 : K) / πK := by
          rw [← Finset.sum_div, ← Finset.sum_div, h_erase_sum, neg_div,
            div_self (ht_ne j₀ hj₀T)]
        rw [h_sum_eq] at h_div_sum_int
        have h_contra := (h_int_valL (div_ne_zero h_neg1_ne hπK_ne)).mp h_div_sum_int
        rw [valL_div h_neg1_ne hπK_ne, h_neg1_val, hπ_val] at h_contra
        omega
      intro ⟨i, j⟩
      by_contra hcij
      obtain ⟨hne, -⟩ := h_comb (fun i' => c (i', j)) ⟨i, hcij⟩
      exact hne (hs_all_zero j)
    have h_le_resDeg : ∀ (r : ℕ) (ω : Fin r → K), P1 K r ω → P3 K πK r ω → r ≤ resDeg F K := by
      intro r ω hP1 hP3
      have hcard := (hB_li_gen r ω hP1 hP3).fintype_card_le_finrank
      rw [Fintype.card_prod, Fintype.card_fin, Fintype.card_fin, h_finrank_eq] at hcard
      nlinarith
    have h_basis_ind : ∀ (k : ℕ) (r : ℕ), resDeg F K - r ≤ k →
        ∀ (ω : Fin r → K), P1 K r ω → P3 K πK r ω →
        ∃ (f₀ : ℕ) (ω₀ : Fin f₀ → K), P1 K f₀ ω₀ ∧ P2 K πK f₀ ω₀ ∧ P3 K πK f₀ ω₀ := by
      intro k
      induction k with
      | zero =>
        intro r hr ω hP1 hP3
        by_cases hP2 : P2 K πK r ω
        · exact ⟨r, ω, hP1, hP2, hP3⟩
        · obtain ⟨ω', hP1', hP3'⟩ := h_step r ω hP1 hP3 hP2
          have hle := h_le_resDeg (r + 1) ω' hP1' hP3'
          omega
      | succ k ih =>
        intro r hr ω hP1 hP3
        by_cases hP2 : P2 K πK r ω
        · exact ⟨r, ω, hP1, hP2, hP3⟩
        · obtain ⟨ω', hP1', hP3'⟩ := h_step r ω hP1 hP3 hP2
          have hle := h_le_resDeg (r + 1) ω' hP1' hP3'
          exact ih (r + 1) (by omega) ω' hP1' hP3'
    obtain ⟨f₀, ω, hω_int, hω_span, hω_ind⟩ :=
      h_basis_ind (resDeg F K) 0 (by omega) Fin.elim0
        (fun i => Fin.elim0 i) (fun _ _ i => Fin.elim0 i)
    let B : Fin f₀ × Fin e → K := fun p => ω p.1 * πK ^ (p.2 : ℕ)
    have hB_li : LinearIndependent F B := hB_li_gen f₀ ω hω_int hω_ind
    let V : Submodule F K := Submodule.span F (Set.range B)
    have h_m_step : ∀ (m : ℕ), m ≤ e → ∀ x : K, IsIntegral 𝒪[F] x →
        ∃ v ∈ V, ∃ z : K, IsIntegral 𝒪[F] z ∧ x = v + πK ^ m * z := by
      intro m
      induction m with
      | zero =>
        intro _ x hx
        exact ⟨0, V.zero_mem, x, hx, by simp⟩
      | succ m ih =>
        intro hm x hx
        obtain ⟨v₁, hv₁, z₁, hz₁, hxz₁⟩ := ih (by omega) x hx
        obtain ⟨a, ha⟩ := hω_span z₁ hz₁
        set z₂ : K := (z₁ - ∑ i : Fin f₀, algebraMap 𝒪[F] K (a i) * ω i) / πK
        have hz₁_eq : z₁ = (∑ i : Fin f₀, algebraMap 𝒪[F] K (a i) * ω i) + πK * z₂ := by
          rw [mul_div_cancel₀ _ hπK_ne, add_sub_cancel]
        let jm : Fin e := ⟨m, by omega⟩
        let v₂ : K := ∑ i : Fin f₀, (a i : F) • B (i, jm)
        have hv₂ : v₂ ∈ V :=
          V.sum_mem fun i _ => V.smul_mem _ (Submodule.subset_span ⟨(i, jm), rfl⟩)
        have hv₂_eq : v₂ = πK ^ m * ∑ i : Fin f₀, algebraMap 𝒪[F] K (a i) * ω i := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          change (a i : F) • (ω i * πK ^ m) = πK ^ m * (algebraMap 𝒪[F] K (a i) * ω i)
          rw [Algebra.smul_def]
          change algebraMap F K (a i : F) * (ω i * πK ^ m) =
            πK ^ m * (algebraMap F K (a i : F) * ω i)
          ring
        refine ⟨v₁ + v₂, V.add_mem hv₁ hv₂, z₂, ha, ?_⟩
        rw [hxz₁, hz₁_eq, mul_add, ← hv₂_eq, pow_succ, mul_assoc, add_assoc]
    have h_int_in_V : ∀ x : K, IsIntegral 𝒪[F] x → x ∈ V := by
      apply h_span V πF hπF0 (by omega)
      intro x hx
      obtain ⟨v, hv, z, hz, hxz⟩ := h_m_step e (le_refl e) x hx
      set u : K := πK ^ e / algebraMap F K πF
      have hu_ne : u ≠ 0 := div_ne_zero (pow_ne_zero e hπK_ne) hπF_K0
      have hu_int : IsIntegral 𝒪[F] u := by
        rw [h_int_valL hu_ne, valL_div (pow_ne_zero e hπK_ne) hπF_K0,
          valL_pow hπK_ne, hπ_val, mul_one, ← he_eq, sub_self]
      refine ⟨v, hv, u * z, IsIntegral.mul hu_int hz, ?_⟩
      rw [hxz, Algebra.smul_def, ← mul_assoc, mul_div_cancel₀ _ hπF_K0]
    have hV_top : V = ⊤ := by
      rw [Submodule.eq_top_iff']
      intro x
      by_cases hx0 : x = 0
      · rw [hx0]
        exact V.zero_mem
      · let k : ℕ := (-valL F K x).toNat
        have hk_ge : -valL F K x ≤ (k : ℤ) := by omega
        have h_smul_ne : (πF ^ k) • x ≠ 0 :=
          smul_ne_zero (pow_ne_zero k hπF0) hx0
        have h_smul_int : IsIntegral 𝒪[F] ((πF ^ k) • x) := by
          rw [h_int_valL h_smul_ne, Algebra.smul_def,
            valL_mul ((map_ne_zero (algebraMap F K)).mpr (pow_ne_zero k hπF0)) hx0,
            map_pow, valL_pow hπF_K0, ← he_eq]
          nlinarith
        have h_mem := h_int_in_V ((πF ^ k) • x) h_smul_int
        have h_inv := V.smul_mem ((πF ^ k)⁻¹) h_mem
        rwa [inv_smul_smul₀ (pow_ne_zero k hπF0)] at h_inv
    let bK : Module.Basis (Fin f₀ × Fin e) F K :=
      Module.Basis.mk hB_li (by change ⊤ ≤ V; rw [hV_top])
    have h_finrank_B : Module.finrank F K = f₀ * e := by
      rw [Module.finrank_eq_card_basis bK, Fintype.card_prod, Fintype.card_fin, Fintype.card_fin]
    have hf₀ : f₀ = resDeg F K := by nlinarith
    exact ⟨πK, hπK_ne, hπ_val, valL_div, valL_one, h_int_valL, h_le_resDeg, h_step,
      ⟨f₀, ω, hω_int, hω_span, hω_ind, hf₀⟩⟩
  obtain ⟨πL, hπL_ne, hπL_val, valL_div_L, valL_one_L, h_int_valL_L,
    -, -, ⟨f₀, ω₀, hω₀_int, hω₀_span, hω₀_ind, hf₀⟩⟩ := h_field L
  obtain ⟨πE, hπE_ne, hπE_val, valL_div_E, valL_one_E, h_int_valL_E,
    h_le_resDeg_E, h_step_E, -⟩ := h_field E
  let ι : L →ₐ[F] E := IntermediateField.inclusion hLE
  let ωE : Fin f₀ → E := fun i => ι (ω₀ i)
  have h_iota_int : ∀ {z : L}, IsIntegral 𝒪[F] z → IsIntegral 𝒪[F] (ι z) :=
    fun hz => IsIntegral.map (ι.restrictScalars 𝒪[F]) hz
  have hωE_int : P1 E f₀ ωE := fun i => h_iota_int (hω₀_int i)
  have h_iota_sum : ∀ (a : Fin f₀ → 𝒪[F]),
      ∑ i : Fin f₀, algebraMap 𝒪[F] E (a i) * ωE i =
        ι (∑ i : Fin f₀, algebraMap 𝒪[F] L (a i) * ω₀ i) := by
    intro a
    rw [map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul]
    congr 1
  have h_descend : ∀ {s : L}, IsIntegral 𝒪[F] s →
      IsIntegral 𝒪[F] (ι s / πE) → IsIntegral 𝒪[F] (s / πL) := by
    intro s hs_int hsE_div
    by_cases hs0 : s = 0
    · rw [hs0, zero_div]
      exact isIntegral_zero
    · by_contra h_not_div
      have hs_val_nonneg : 0 ≤ valL F L s := (h_int_valL_L hs0).mp hs_int
      have hs_val_lt : valL F L s < 1 := by
        by_contra hge
        apply h_not_div
        rw [h_int_valL_L (div_ne_zero hs0 hπL_ne), valL_div_L hs0 hπL_ne, hπL_val]
        omega
      have hs_val0 : valL F L s = 0 := by omega
      have hsinv_ne : s⁻¹ ≠ 0 := inv_ne_zero hs0
      have hsinv_int : IsIntegral 𝒪[F] (s⁻¹) := by
        rw [h_int_valL_L hsinv_ne, ← one_div, valL_div_L one_ne_zero hs0, valL_one_L, hs_val0]
        omega
      have hsinv_E_int : IsIntegral 𝒪[F] (ι (s⁻¹)) := h_iota_int hsinv_int
      have h_mul_int : IsIntegral 𝒪[F] (ι (s⁻¹) * (ι s / πE)) :=
        IsIntegral.mul hsinv_E_int hsE_div
      have h_mul_eq : ι (s⁻¹) * (ι s / πE) = (1 : E) / πE := by
        rw [← mul_div_assoc, ← map_mul, inv_mul_cancel₀ hs0, map_one]
      rw [h_mul_eq] at h_mul_int
      have h_contra := (h_int_valL_E (div_ne_zero one_ne_zero hπE_ne)).mp h_mul_int
      rw [valL_div_E one_ne_zero hπE_ne, valL_one_E, hπE_val] at h_contra
      omega
  have hωE_ind : P3 E πE f₀ ωE := by
    intro a haE
    set s : L := ∑ i : Fin f₀, algebraMap 𝒪[F] L (a i) * ω₀ i
    have hs_int : IsIntegral 𝒪[F] s :=
      (integralClosure 𝒪[F] L).sum_mem fun i _ =>
        (integralClosure 𝒪[F] L).mul_mem isIntegral_algebraMap (hω₀_int i)
    rw [h_iota_sum a] at haE
    exact hω₀_ind a (h_descend hs_int haE)
  have hωE_span : P2 E πE f₀ ωE := by
    by_contra hnotP2E
    obtain ⟨ωE', hωE'_int, hωE'_ind⟩ := h_step_E f₀ ωE hωE_int hωE_ind hnotP2E
    have hle := h_le_resDeg_E (f₀ + 1) ωE' hωE'_int hωE'_ind
    omega
  have hx_int : IsIntegral 𝒪[F] x := by
    rcases hx with rfl | hx_val
    · exact isIntegral_zero
    · by_cases hx0 : x = 0
      · rw [hx0]
        exact isIntegral_zero
      · exact (h_int_valL_E hx0).mpr hx_val
  obtain ⟨a, ha⟩ := hωE_span x hx_int
  set c : L := ∑ i : Fin f₀, algebraMap 𝒪[F] L (a i) * ω₀ i
  have hc_int : IsIntegral 𝒪[F] c :=
    (integralClosure 𝒪[F] L).sum_mem fun i _ =>
      (integralClosure 𝒪[F] L).mul_mem isIntegral_algebraMap (hω₀_int i)
  have hc_val : c = 0 ∨ 0 ≤ valL F L c := by
    by_cases hc0 : c = 0
    · exact Or.inl hc0
    · exact Or.inr ((h_int_valL_L hc0).mp hc_int)
  rw [h_iota_sum a] at ha
  refine ⟨c, hc_val, ?_⟩
  by_cases hsub0 : x - ι c = 0
  · exact Or.inl hsub0
  · right
    have h_div_val := (h_int_valL_E (div_ne_zero hsub0 hπE_ne)).mp ha
    rw [valL_div_E hsub0 hπE_ne, hπE_val] at h_div_val
    change 1 ≤ valL F E (x - ι c)
    omega

theorem mem_lowerRamSubgroup_iff_and_of_valL_eq_one (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E] (hLE : L ≤ E) :
    (∀ (u : ℕ) (σ : (IntermediateField.extendScalars hLE) ≃ₐ[L] (IntermediateField.extendScalars hLE)),
      σ ∈ lowerRamSubgroup F hLE u ↔
        ∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
          galApply F hLE σ x = x ∨ (u + 1 : ℤ) ≤ valL F E (galApply F hLE σ x - x)) ∧
    ((∀ (x : E), (x = 0 ∨ 0 ≤ valL F E x) →
      ∃ c : L, (c = 0 ∨ 0 ≤ valL F L c) ∧
        (x - IntermediateField.inclusion hLE c = 0 ∨
          1 ≤ valL F E (x - IntermediateField.inclusion hLE c))) →
      ∀ (π_E : E), valL F E π_E = 1 →
        (∀ (u : ℕ) (σ : (IntermediateField.extendScalars hLE) ≃ₐ[L] (IntermediateField.extendScalars hLE)),
          σ ∈ lowerRamSubgroup F hLE u ↔
            galApply F hLE σ π_E = π_E ∨ (u + 1 : ℤ) ≤ valL F E (galApply F hLE σ π_E - π_E)) ∧
        (∀ σ : (IntermediateField.extendScalars hLE) ≃ₐ[L] (IntermediateField.extendScalars hLE),
          σ ≠ 1 → galApply F hLE σ π_E ≠ π_E ∧ 1 ≤ valL F E (galApply F hLE σ π_E - π_E) ∧
            ∀ b : E, (b = 0 ∨ 0 ≤ valL F E b) →
              galApply F hLE σ b = b ∨
                valL F E (galApply F hLE σ π_E - π_E) ≤ valL F E (galApply F hLE σ b - b))) :=
by
  have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
      0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
    intro a ha
    unfold addVal
    rw [dif_neg ha]
    set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    set va := valuation F a
    have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
    constructor
    · intro h_nonneg
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
      have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
      have h_iso : iso va ≤ iso 1 := by
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
        exact WithZero.coe_le_coe.mpr h_unzero
      exact (map_le_map_iff iso).mp h_iso
    · intro h_le
      have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
      rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
        Multiplicative.toAdd_le.mpr h_iso
      omega
  have addVal_mul : ∀ {y₁ y₂ : F} (hy₁ : y₁ ≠ 0) (hy₂ : y₂ ≠ 0),
      addVal F (y₁ * y₂) = addVal F y₁ + addVal F y₂ := by
    intro y₁ y₂ hy₁ hy₂
    have hy₁₂ : y₁ * y₂ ≠ 0 := mul_ne_zero hy₁ hy₂
    simp only [addVal, hy₁, hy₂, hy₁₂, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun w => Multiplicative.ofAdd (addVal F w)
      map_one' := by simp [addVal_one]
      map_mul' := fun w₁ w₂ => by simp [addVal_mul w₁.ne_zero w₂.ne_zero, ofAdd_add] }
  let relValHom : Eˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ w : Eˣ, Multiplicative.toAdd (relValHom w) = relVal F E w :=
    fun _ => rfl
  have relVal_units_mul : ∀ w₁ w₂ : Eˣ,
      relVal F E ((w₁ * w₂ : Eˣ) : E) = relVal F E w₁ + relVal F E w₂ := by
    intro w₁ w₂
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (w : Eˣ) (k : ℤ),
      relVal F E ((w ^ k : Eˣ) : E) = k * relVal F E w := by
    intro w k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have exists_addVal_eq_one : ∃ w : Fˣ, addVal F w = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F E ∧ ∃ π : Eˣ, relVal F E π = resDeg F E := by
    obtain ⟨w, hw⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : E, z ≠ 0 ∧ relVal F E z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F E, Module.finrank_pos, algebraMap F E w,
        (map_ne_zero (algebraMap F E)).mpr w.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F E (w : F)) = (w : F) ^ Module.finrank F E :=
        Algebra.norm_algebraMap (w : F)
      have hpow : addVal F ((w : F) ^ Module.finrank F E) =
          (Module.finrank F E : ℤ) * addVal F w := by
        change Multiplicative.toAdd (addValHom (w ^ Module.finrank F E)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hw, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hf_pos, π_ex, hπ_ex⟩ := resDeg_mem
  have relVal_eq_resDeg_mul_valL_aux :
      ∀ w : Eˣ, relVal F E w = (resDeg F E : ℤ) * valL F E w := by
    intro w
    let q := relVal F E w / (resDeg F E : ℤ)
    let r := relVal F E w % (resDeg F E : ℤ)
    have hdiv : r + (resDeg F E : ℤ) * q = relVal F E w := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r := Int.emod_nonneg _ (by positivity)
    have hrlt : r < (resDeg F E : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy : relVal F E ((w * π_ex ^ (-q) : Eˣ) : E) = r := by
      rw [relVal_units_mul, relVal_units_zpow, hπ_ex]
      linarith
    have hr_eq : r = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r.toNat ∈ {k : ℕ | 0 < k ∧ ∃ z : E, z ≠ 0 ∧ relVal F E z = k} := by
        refine ⟨hr_pos, ((w * π_ex ^ (-q) : Eˣ) : E), Units.ne_zero _, ?_⟩
        rw [hy, Int.toNat_of_nonneg hr0]
      have hle : resDeg F E ≤ r.toNat := Nat.sInf_le hmem
      omega
    change relVal F E w = (resDeg F E : ℤ) * q
    linarith
  have hf_ne : (resDeg F E : ℤ) ≠ 0 := by positivity
