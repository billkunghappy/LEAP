        V.sum_mem fun i _ => V.smul_mem _ (Submodule.subset_span ⟨(i, jm), rfl⟩)
      have hv₂_eq : v₂ = πL ^ m * ∑ i : Fin f₀, algebraMap 𝒪[F] L (a i) * ω i := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        change (a i : F) • (ω i * πL ^ m) = πL ^ m * (algebraMap 𝒪[F] L (a i) * ω i)
        rw [Algebra.smul_def]
        change algebraMap F L (a i : F) * (ω i * πL ^ m) =
          πL ^ m * (algebraMap F L (a i : F) * ω i)
        ring
      refine ⟨v₁ + v₂, V.add_mem hv₁ hv₂, z₂, ha, ?_⟩
      rw [hxz₁, hz₁_eq, mul_add, ← hv₂_eq, pow_succ, mul_assoc, add_assoc]
  have h_int_in_V : ∀ x : L, IsIntegral 𝒪[F] x → x ∈ V := by
    apply h_span V πF hπF0 (by omega)
    intro x hx
    obtain ⟨v, hv, z, hz, hxz⟩ := h_m_step e (le_refl e) x hx
    set u : L := πL ^ e / algebraMap F L πF
    have hu_ne : u ≠ 0 := div_ne_zero (pow_ne_zero e hπL_ne) hπF_L0
    have hu_int : IsIntegral 𝒪[F] u := by
