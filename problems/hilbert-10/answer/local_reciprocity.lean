  have hθ_props : ∀ r : ℕ,
      let θ_r := relColemanTheta F L πL v_bar τ ε M r
      θ_r.coeff 0 = 0 ∧
      (1 ≤ r → θ_r.coeff 1 = ε) ∧
      (∀ k > r, θ_r.coeff k = 0) ∧
      polyMem Sunram θ_r ∧
      (∀ k ≤ r, IsIntegralDivPow F L πL (M + 1)
        ((((θ_r.map (τ : AlgebraicClosure F →+* AlgebraicClosure F)).comp f₀_poly) -
          fπ.comp θ_r).coeff k)) := by
    intro r
    induction r with
    | zero =>
      dsimp [relColemanTheta]
      refine ⟨Polynomial.coeff_zero 0, fun h => by omega, fun k _ => Polynomial.coeff_zero k,
        polyMem_zero Sunram, ?_⟩
      intro k hk
      have hk0 : k = 0 := by omega
