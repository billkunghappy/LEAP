        (ψ.mapMatrix.comp (Polynomial.aeval C).toRingHom)
    let f₂ : Polynomial K →+* Matrix (Fin pb.dim) (Fin pb.dim) L_base :=
      (Algebra.leftMulMatrix pb.basis).toRingHom.comp (Polynomial.aeval pb.gen).toRingHom
    have hf : f₁ = f₂ := by
      apply Polynomial.ringHom_ext'
      · refine RingHom.ext fun a => Matrix.ext fun j i => ?_
        change ψ ((Polynomial.aeval C (Polynomial.C a)) (e.symm j) (e.symm i)) =
          ((Algebra.leftMulMatrix pb.basis) (Polynomial.aeval pb.gen (Polynomial.C a))) j i
        rw [Polynomial.aeval_C, Polynomial.aeval_C]
        have h_alg : algebraMap K B_adj a = algebraMap L_base B_adj (algebraMap K L_base a) :=
          IsScalarTower.algebraMap_apply K L_base B_adj a
        rw [h_alg, AlgHom.commutes (Algebra.leftMulMatrix pb.basis) (algebraMap K L_base a)]
        change ψ ((Matrix.scalar (Fin q) (Polynomial.C a)) (e.symm j) (e.symm i)) =
