        fun hle => by have := nonneg_of_mul_nonneg_right hle hfE₀_pos; omega⟩
  let polyDivPow (m : ℕ) (P : Polynomial E₀) : Prop :=
    ∀ n : ℕ, IsIntegral 𝒪[F] (P.coeff n / π ^ m)
  have polyValLe_iff_polyDivPow : ∀ (m : ℕ) (P : Polynomial E₀),
