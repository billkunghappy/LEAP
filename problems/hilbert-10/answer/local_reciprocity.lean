        rw [pow_zero, galApply_one, galApply_one_val]
        exact ⟨one_ne_zero, h_val_zero_one.2, by ring⟩
      | succ r ih =>
        obtain ⟨hg_r, hval_r, htel_r⟩ := ih
        have h_prod_succ : g_nat (r + 1) = g_nat r * galApply F hLM (τ ^ r) π_M := by
          dsimp [g_nat]
          exact Finset.prod_range_succ _ r
        have h_val_ar : valL F M (galApply F hLM (τ ^ r) π_M) = 1 := by
          rw [h_val_gal, hπ_M]
        have ha_r_ne : galApply F hLM (τ ^ r) π_M ≠ 0 := by
          intro h0
          rw [h0, h_val_zero_one.1] at h_val_ar
          omega
        have hg_succ_ne : g_nat (r + 1) ≠ 0 := by
          rw [h_prod_succ]
          exact mul_ne_zero hg_r ha_r_ne
        have hval_succ : valL F M (g_nat (r + 1)) = ((r + 1 : ℕ) : ℤ) := by
          rw [h_prod_succ, h_val_mul hg_r ha_r_ne, hval_r, h_val_ar]
          push_cast
          ring
        have h_gal_ar : galApply F hLM τ (galApply F hLM (τ ^ r) π_M) =
