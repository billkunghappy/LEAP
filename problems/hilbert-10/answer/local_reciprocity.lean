        have hn_sub : (n + 1) - 1 = n := rfl
        rw [hn_sub, h_split, h_dvd_sum, h_not_dvd_sum, h_not_dvd_card, add_assoc]
      have h_mul_le : p ^ n * f 1 ≤ p ^ n * f p := Nat.mul_le_mul_left (p ^ n) h_f1_le_fp
      have h_sub_mul : (p ^ (n + 1) - p ^ n) * f 1 = p ^ (n + 1) * f 1 - p ^ n * f 1 :=
        Nat.mul_sub_right_distrib (p ^ (n + 1)) (p ^ n) (f 1)
      have h_pn_le_mul : p ^ n * f 1 ≤ p ^ (n + 1) * f 1 :=
        Nat.mul_le_mul_right (f 1) h_pn_le
      rw [h_tot_eq]
      have h_le_tot :
          p ^ (n + 1) * f 1 ≤
            (f (p ^ n) + ∑ q ∈ J, f (p * q)) + (p ^ (n + 1) - p ^ n) * f 1 := by
        omega
      have h_sub_tot :
          (f (p ^ n) + ∑ q ∈ J, f (p * q)) + (p ^ (n + 1) - p ^ n) * f 1 - p ^ (n + 1) * f 1 =
            (f (p ^ n) + ∑ q ∈ J, f (p * q) - p ^ n * f p) + (p ^ n * f p - p ^ n * f 1) := by
        omega
      refine ⟨h_le_tot, ?_⟩
      rw [h_sub_tot]
      exact Nat.dvd_add h_dvd_g h_dvd_step
  obtain ⟨h_le, h_dvd⟩ := h_ind m hm 0 f h_unit h_mono (by simpa using h_sen)
  rw [zero_add] at h_dvd
  have h_add := Nat.dvd_add h_dvd (dvd_mul_right (p ^ m) (f 1))
  rwa [Nat.sub_add_cancel h_le] at h_add

theorem pow_p_dvd_herbrand_cyclic_sum_of_order_eq_pow_p (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (hLM : L ≤ M) :
    resDeg F M = resDeg F L →
    (∀ (x : M), (x = 0 ∨ 0 ≤ valL F M x) →
      ∃ c : L, (c = 0 ∨ 0 ≤ valL F L c) ∧
        (x - IntermediateField.inclusion hLM c = 0 ∨
          1 ≤ valL F M (x - IntermediateField.inclusion hLM c))) →
    ∀ (π_M : M), valL F M π_M = 1 →
    ∀ (m : ℕ), 1 ≤ m →
    ∀ (σ : (IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM)),
      σ ^ ((p F) ^ m) = 1 →
      (∀ r : ℕ, 1 ≤ r → r < (p F) ^ m → σ ^ r ≠ 1) →
      1 ≤ (valL F M (galApply F hLM σ π_M - π_M)).toNat - 1 →
      ((p F) ^ m) ∣
        (((valL F M (galApply F hLM (σ ^ ((p F) ^ (m - 1))) π_M - π_M)).toNat - 1) +
          ∑ r ∈ Finset.Icc 1 ((p F) ^ m - 1),
            ((valL F M (galApply F hLM (σ ^ r) π_M - π_M)).toNat - 1)) :=
by
  intro _hres h_lift π_M hπ_M m hm σ _h_ord_eq h_ord_lt h_i0
  have hM_ram :
      ∀ τ : (IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM),
        τ ≠ 1 → galApply F hLM τ π_M ≠ π_M ∧ 1 ≤ valL F M (galApply F hLM τ π_M - π_M) ∧
          ∀ b : M, (b = 0 ∨ 0 ≤ valL F M b) →
            galApply F hLM τ b = b ∨
              valL F M (galApply F hLM τ π_M - π_M) ≤ valL F M (galApply F hLM τ b - b) :=
    ((mem_lowerRamSubgroup_iff_and_of_valL_eq_one F L M hLM).2 h_lift π_M hπ_M).2
  obtain ⟨hp_prime, hp_val, h_val_zero_one, h_val_mul, h_val_inv, h_val_gal, hV_add_sub,
    h_val_add_of_lt, h_shift, h_coprime_pow, h_pow_p_le⟩ :=
    valL_add_of_lt_and_valL_galApply_pow_coprime_eq F L M hLM π_M hπ_M hM_ram
  obtain ⟨h_orbit_prod, h_trace_sum⟩ :=
    exists_orbit_prod_and_trace_valL_galApply_sub_eq F L M hLM π_M hπ_M hp_val h_val_zero_one
      h_val_mul h_val_inv h_val_gal hV_add_sub h_shift
  have h_sen_int :=
    pow_p_dvd_valL_galApply_pow_p_sub_of_ne_one F L M hLM h_lift π_M hπ_M hM_ram hp_prime
      h_val_zero_one h_val_mul h_val_inv h_val_gal hV_add_sub h_val_add_of_lt h_shift
      h_coprime_pow h_pow_p_le h_orbit_prod h_trace_sum
  have hp_two : 2 ≤ p F := hp_prime.two_le
  have h_w0 : 2 ≤ valL F M (galApply F hLM σ π_M - π_M) := by omega
  have h_wk_ge_two : ∀ k : ℕ, k < m →
      2 ≤ valL F M (galApply F hLM (σ ^ ((p F) ^ k)) π_M - π_M) := by
    intro k
    induction k with
    | zero =>
      intro _
      simpa using h_w0
    | succ k ih =>
      intro hk_succ
      have hk : k < m := by omega
      have h_le_k := ih hk
      have h_pow_pos : 1 ≤ (p F) ^ (k + 1) := Nat.one_le_pow _ _ (by omega)
      have h_pow_lt : (p F) ^ (k + 1) < (p F) ^ m :=
        Nat.pow_lt_pow_right (by omega) hk_succ
      have h_ne_one : (σ ^ ((p F) ^ k)) ^ (p F) ≠ 1 := by
        rw [← pow_mul, ← pow_succ]
        exact h_ord_lt ((p F) ^ (k + 1)) h_pow_pos h_pow_lt
      have h_step := h_pow_p_le (σ ^ ((p F) ^ k)) h_le_k h_ne_one
      rw [← pow_mul, ← pow_succ] at h_step
      omega
  let f : ℕ → ℕ := fun r => (valL F M (galApply F hLM (σ ^ r) π_M - π_M)).toNat - 1
  apply pow_dvd_add_sum_Icc_of_coprime_eq_and_pow_dvd_sub (p F) m hp_two hm f
  · intro k hk c hc hcp hnotdvd
    dsimp [f]
    have h_eq_pow : σ ^ (c * (p F) ^ k) = (σ ^ ((p F) ^ k)) ^ c := by
      rw [mul_comm, pow_mul]
    rw [h_eq_pow, (h_coprime_pow (σ ^ ((p F) ^ k)) (h_wk_ge_two k hk) c hc hnotdvd).2]
  · intro k hk1 hkm
    dsimp [f]
    have hk_sub : k - 1 < m := by omega
    have h_le_sub := h_wk_ge_two (k - 1) hk_sub
    have h_pow_eq : (p F) ^ (k - 1) * (p F) = (p F) ^ k := by
      rw [← pow_succ, Nat.sub_add_cancel hk1]
    have h_pow_pos : 1 ≤ (p F) ^ k := Nat.one_le_pow _ _ (by omega)
    have h_pow_lt : (p F) ^ k < (p F) ^ m := Nat.pow_lt_pow_right (by omega) hkm
    have h_ne_one : (σ ^ ((p F) ^ (k - 1))) ^ (p F) ≠ 1 := by
      rw [← pow_mul, h_pow_eq]
      exact h_ord_lt ((p F) ^ k) h_pow_pos h_pow_lt
    have h_step := h_pow_p_le (σ ^ ((p F) ^ (k - 1))) h_le_sub h_ne_one
    rw [← pow_mul, h_pow_eq] at h_step
    omega
  · intro k hk1 hkm
    dsimp [f]
    have hm1_lt : m - 1 < m := by omega
    have h_pow_pos : 1 ≤ (p F) ^ (m - 1) := Nat.one_le_pow _ _ (by omega)
    have h_pow_lt : (p F) ^ (m - 1) < (p F) ^ m := Nat.pow_lt_pow_right (by omega) hm1_lt
    have h_ne_m1 : σ ^ ((p F) ^ (m - 1)) ≠ 1 := h_ord_lt ((p F) ^ (m - 1)) h_pow_pos h_pow_lt
    have hk_le : k ≤ m - 1 := by omega
    have h_dvd_int := h_sen_int (m - 1) σ h_w0 h_ne_m1 k hk1 hk_le
    have h_w_k : 2 ≤ valL F M (galApply F hLM (σ ^ ((p F) ^ k)) π_M - π_M) :=
      h_wk_ge_two k hkm
    have h_w_k1 : 2 ≤ valL F M (galApply F hLM (σ ^ ((p F) ^ (k - 1))) π_M - π_M) :=
      h_wk_ge_two (k - 1) (by omega)
    have h_pow_eq : (p F) ^ (k - 1) * (p F) = (p F) ^ k := by
      rw [← pow_succ, Nat.sub_add_cancel hk1]
    have h_ne_k : (σ ^ ((p F) ^ (k - 1))) ^ (p F) ≠ 1 := by
      rw [← pow_mul, h_pow_eq]
      exact h_ord_lt ((p F) ^ k) (Nat.one_le_pow _ _ (by omega)) (Nat.pow_lt_pow_right (by omega) hkm)
    have h_step := h_pow_p_le (σ ^ ((p F) ^ (k - 1))) h_w_k1 h_ne_k
    rw [← pow_mul, h_pow_eq] at h_step
    have h_diff_eq :
        valL F M (galApply F hLM (σ ^ ((p F) ^ k)) π_M - π_M) -
          valL F M (galApply F hLM (σ ^ ((p F) ^ (k - 1))) π_M - π_M) =
        (((valL F M (galApply F hLM (σ ^ ((p F) ^ k)) π_M - π_M)).toNat - 1 -
          ((valL F M (galApply F hLM (σ ^ ((p F) ^ (k - 1))) π_M - π_M)).toNat - 1) : ℕ) : ℤ) := by
      omega
    rw [h_diff_eq] at h_dvd_int
    exact Int.ofNat_dvd.mp (by exact_mod_cast h_dvd_int)

theorem finrank_dvd_herbrandSum_of_card_lt (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E] (hLE : L ≤ E) :
    IsAbelianExt F hLE → resDeg F E = resDeg F L →
    ∀ u : ℕ, 1 ≤ u →
      Nat.card (lowerRamSubgroup F hLE (u + 1)) < Nat.card (lowerRamSubgroup F hLE u) →
      Module.finrank L (IntermediateField.extendScalars hLE) ∣ herbrandSum F hLE u :=
by
  intro hab hres u hu hlt
  set π_E : E := (chosenUniformizer F E : E)
  have hπ_E : valL F E π_E = 1 := (valL_chosenUniformizer_and_mul_zpow F E 1).1
  have h_lift_E := exists_mem_valL_sub_ge_one_of_resDeg_eq F L E hLE hres
  obtain ⟨hG_mem, hG_ne_full⟩ :=
    (mem_lowerRamSubgroup_iff_and_of_valL_eq_one F L E hLE).2 h_lift_E π_E hπ_E
  have hG_ne : ∀ σ, σ ≠ 1 →
      galApply F hLE σ π_E ≠ π_E ∧ 1 ≤ valL F E (galApply F hLE σ π_E - π_E) :=
    fun σ hσ => ⟨(hG_ne_full σ hσ).1, (hG_ne_full σ hσ).2.1⟩
  have hπ_inj : ∀ τ, galApply F hLE τ π_E = π_E → τ = 1 :=
    fun τ hτ => by_contra fun hne => (hG_ne_full τ hne).1 hτ
  obtain ⟨h_wild_pow, h_coprime, h_dvd_tame, h_dvd_wild_mul⟩ :=
    coprime_and_finrank_dvd_mul_card_lowerRamSubgroup_one_and_herbrandSum F L E hLE hab hres
      π_E hπ_E h_lift_E hG_mem hG_ne_full
  obtain ⟨M, hLM, hME, m, σ₀, hm, h_sub_eval⟩ :=
    exists_subextension_cyclic_quotient_herbrandSum_eq F L E hLE hab π_E hG_mem hG_ne
      h_wild_pow u hu hlt
  haveI : FiniteDimensional F M :=
    FiniteDimensional.of_injective (IntermediateField.inclusion hME).toLinearMap
      (IntermediateField.inclusion hME).injective
  obtain ⟨hres_M, res, H, P_M, _, hH, hres_comm, _, h_val_scale,
    hPM_monic, hPM_deg, hPM_prod⟩ :=
    exists_surjective_galRestrict_and_prod_eq_map_minpoly F L M E hLM hME hab hres π_E hπ_inj
  have h_lift_M := exists_mem_valL_sub_ge_one_of_resDeg_eq F L M hLM hres_M
  have hM_ram : ∀ (π_M : M), valL F M π_M = 1 →
      ∀ σbar : (IntermediateField.extendScalars hLM) ≃ₐ[L] (IntermediateField.extendScalars hLM),
        σbar ≠ 1 → galApply F hLM σbar π_M ≠ π_M ∧
          1 ≤ valL F M (galApply F hLM σbar π_M - π_M) ∧
          ∀ b : M, (b = 0 ∨ 0 ≤ valL F M b) →
            galApply F hLM σbar b = b ∨
              valL F M (galApply F hLM σbar π_M - π_M) ≤ valL F M (galApply F hLM σbar b - b) :=
    fun π_M hπ_M => ((mem_lowerRamSubgroup_iff_and_of_valL_eq_one F L M hLM).2 h_lift_M π_M hπ_M).2
  obtain ⟨hπ_M, h_coset⟩ :=
    sum_valL_galApply_sub_eq_card_ker_mul_valL_sub F L M E hLM hME π_E hπ_E res H P_M
      hH hres_comm h_val_scale hG_ne hM_ram hPM_monic hPM_deg hPM_prod
  obtain ⟨h_ord_eq, h_ord_lt, h_i0_pos, h_card_G1, h_herbrand_eq⟩ :=
    h_sub_eval res H (P_M.coeff 0) hH hres_comm h_coset
  have h_pm_dvd :=
    pow_p_dvd_herbrand_cyclic_sum_of_order_eq_pow_p F L M hLM hres_M h_lift_M (P_M.coeff 0) hπ_M
      m hm (res σ₀) h_ord_eq h_ord_lt h_i0_pos
  have hc1_dvd_S : Nat.card (lowerRamSubgroup F hLE 1) ∣ herbrandSum F hLE u := by
    rw [h_card_G1, h_herbrand_eq]
    exact mul_dvd_mul_left H.card h_pm_dvd
  set d := Module.finrank L (IntermediateField.extendScalars hLE)
  set c₁ := Nat.card (lowerRamSubgroup F hLE 1)
  set S := herbrandSum F hLE u
  have hd_tame_S : d ∣ (qL F L - 1) * S :=
    dvd_trans h_dvd_tame (mul_dvd_mul_left (qL F L - 1) hc1_dvd_S)
  have hd_wild_S : d ∣ c₁ * S := h_dvd_wild_mul u hu hlt
  have hd_gcd : d ∣ Nat.gcd ((qL F L - 1) * S) (c₁ * S) :=
    Nat.dvd_gcd hd_tame_S hd_wild_S
  rwa [Nat.gcd_mul_right, h_coprime.gcd_eq_one, one_mul] at hd_gcd

theorem card_zero_le_of_dvd_sum_Icc_of_lt (d q n N₀ : ℕ) (hd : 1 ≤ d) (hq : 2 ≤ q) (hn : 1 ≤ n)
    (c : ℕ → ℕ)
    (hc_pos : ∀ u : ℕ, 1 ≤ c u)
    (hc_anti : ∀ u : ℕ, c (u + 1) ≤ c u)
    (hc0 : c 0 = d)
    (hc_tame : c 0 ≤ (q - 1) * c 1)
    (hc_wild : ∀ u : ℕ, 1 ≤ u → c u ≤ q * c (u + 1))
    (hc_term : ∀ u : ℕ, 2 ≤ c u → ∑ k ∈ Finset.Icc 1 u, c k < N₀ * d)
    (hc_bound : ∀ u : ℕ, 2 ≤ c u → ∑ k ∈ Finset.Icc 1 u, c k < n * d)
    (hc_dvd : ∀ u : ℕ, 1 ≤ u → c (u + 1) < c u → d ∣ ∑ k ∈ Finset.Icc 1 u, c k) :
    d ≤ (q - 1) * q ^ (n - 1) :=
by
  set U : ℕ := N₀ * d
  have h_anti : Antitone c := antitone_nat_of_succ_le hc_anti
  have h_le_one : c (U + 1) ≤ 1 := by
    by_contra h_not_le
    have h_ge_two : 2 ≤ c (U + 1) := by omega
    have h_all_ge : ∀ k ∈ Finset.Icc 1 (U + 1), 2 ≤ c k := by
      intro k hk
      exact le_trans h_ge_two (h_anti (Finset.mem_Icc.mp hk).2)
    have h_sum_ge : (Finset.Icc 1 (U + 1)).card • 2 ≤ ∑ k ∈ Finset.Icc 1 (U + 1), c k :=
      Finset.card_nsmul_le_sum (Finset.Icc 1 (U + 1)) c 2 h_all_ge
    rw [smul_eq_mul, Nat.card_Icc] at h_sum_ge
    have h_sum_lt : ∑ k ∈ Finset.Icc 1 (U + 1), c k < U := hc_term (U + 1) h_ge_two
    omega
  have h_term_one : c (U + 1) = 1 := by
    have h1 := hc_pos (U + 1)
    omega
  let J : ℕ → Finset ℕ := fun m => (Finset.Icc 1 m).filter (fun u => c (u + 1) < c u)
  have h_Icc_succ : ∀ m : ℕ, Finset.Icc 1 (m + 1) = insert (m + 1) (Finset.Icc 1 m) := by
    intro m
    ext x
    simp only [Finset.mem_Icc, Finset.mem_insert]
    omega
  have h_notMem_Icc : ∀ m : ℕ, m + 1 ∉ Finset.Icc 1 m := by
    intro m
    simp only [Finset.mem_Icc]
    omega
  have h_ind : ∀ m : ℕ, c 1 ≤ q ^ (J m).card * c (m + 1) := by
    intro m
    induction m with
    | zero =>
      have hJ0 : J 0 = ∅ := by
        ext x
        simp only [J, Finset.mem_filter, Finset.mem_Icc, Finset.notMem_empty, iff_false]
        omega
      rw [hJ0, Finset.card_empty, pow_zero, one_mul]
    | succ m ih =>
      have hJ_succ : J (m + 1) =
          if c (m + 2) < c (m + 1) then insert (m + 1) (J m) else J m := by
        dsimp only [J]
        rw [h_Icc_succ m, Finset.filter_insert]
      by_cases h_jump : c (m + 2) < c (m + 1)
      · rw [if_pos h_jump] at hJ_succ
        have h_notMem_J : m + 1 ∉ J m := by
          intro hmem
          exact h_notMem_Icc m (Finset.mem_filter.mp hmem).1
        have h_card : (J (m + 1)).card = (J m).card + 1 := by
          rw [hJ_succ, Finset.card_insert_of_notMem h_notMem_J]
        have hw : c (m + 1) ≤ q * c (m + 2) := hc_wild (m + 1) (by omega)
        calc c 1
            ≤ q ^ (J m).card * c (m + 1) := ih
          _ ≤ q ^ (J m).card * (q * c (m + 2)) := Nat.mul_le_mul_left _ hw
          _ = q ^ ((J m).card + 1) * c (m + 2) := by rw [pow_succ, mul_assoc]
          _ = q ^ (J (m + 1)).card * c (m + 2) := by rw [h_card]
      · rw [if_neg h_jump] at hJ_succ
        have h_anti_m : c (m + 2) ≤ c (m + 1) := hc_anti (m + 1)
        have h_eq : c (m + 1) = c (m + 2) := by omega
        rw [hJ_succ, ← h_eq]
        exact ih
  have hc1_le : c 1 ≤ q ^ (J U).card := by
    have hU := h_ind U
    rw [h_term_one, mul_one] at hU
    exact hU
  have hd_le_J : d ≤ (q - 1) * q ^ (J U).card := by
    calc d = c 0 := hc0.symm
      _ ≤ (q - 1) * c 1 := hc_tame
      _ ≤ (q - 1) * q ^ (J U).card := Nat.mul_le_mul_left (q - 1) hc1_le
  let S : ℕ → ℕ := fun u => ∑ k ∈ Finset.Icc 1 u, c k
  let f : ℕ → ℕ := fun u => S u / d
  have hJ_prop : ∀ u ∈ J U,
      1 ≤ u ∧ 2 ≤ c u ∧ c u ≤ S u ∧ d * f u = S u ∧ S u < n * d := by
    intro u hu
    have hu_mem := Finset.mem_filter.mp hu
    have hu_Icc := Finset.mem_Icc.mp hu_mem.1
    have hu_ge : 1 ≤ u := hu_Icc.1
    have hu_lt : c (u + 1) < c u := hu_mem.2
    have hc_pos_succ := hc_pos (u + 1)
    have hu_two : 2 ≤ c u := by omega
    have hu_in_Icc : u ∈ Finset.Icc 1 u := Finset.mem_Icc.mpr ⟨hu_ge, le_rfl⟩
    have hcu_le_S : c u ≤ S u :=
      Finset.single_le_sum (fun k _ => Nat.zero_le (c k)) hu_in_Icc
    have hd_dvd : d ∣ S u := hc_dvd u hu_ge hu_lt
    have hd_mul : d * f u = S u := Nat.mul_div_cancel' hd_dvd
    have hS_lt : S u < n * d := hc_bound u hu_two
    exact ⟨hu_ge, hu_two, hcu_le_S, hd_mul, hS_lt⟩
  have h_mapsTo : Set.MapsTo f (J U) (Finset.Icc 1 (n - 1)) := by
    intro u hu
    obtain ⟨_, hu_two, hcu_le_S, hd_mul, hS_lt⟩ := hJ_prop u hu
    rw [Finset.mem_coe, Finset.mem_Icc]
    have hS_ge_two : 2 ≤ S u := le_trans hu_two hcu_le_S
    have hf_ge_one : 1 ≤ f u := by
      by_contra h0
      have hf0 : f u = 0 := by omega
      rw [hf0, mul_zero] at hd_mul
      omega
    have hf_lt_n : f u < n := by
      have h_mul_lt : d * f u < d * n := by
        rw [hd_mul, mul_comm d n]
        exact hS_lt
      exact Nat.lt_of_mul_lt_mul_left h_mul_lt
    exact ⟨hf_ge_one, by omega⟩
  have h_mono : ∀ u₁ ∈ J U, ∀ u₂ ∈ J U, u₁ < u₂ → f u₁ < f u₂ := by
    intro u₁ hu₁ u₂ hu₂ h_lt
    obtain ⟨hu₁_ge, _, _, hd_mul₁, _⟩ := hJ_prop u₁ hu₁
    obtain ⟨_, hu₂_two, _, hd_mul₂, _⟩ := hJ_prop u₂ hu₂
    have h_notMem : u₂ ∉ Finset.Icc 1 u₁ := by
      simp only [Finset.mem_Icc]
      omega
    have h_sub : insert u₂ (Finset.Icc 1 u₁) ⊆ Finset.Icc 1 u₂ := by
      intro k hk
      simp only [Finset.mem_insert, Finset.mem_Icc] at hk ⊢
      omega
    have h_sum_le : c u₂ + S u₁ ≤ S u₂ := by
      calc c u₂ + S u₁
          = ∑ k ∈ insert u₂ (Finset.Icc 1 u₁), c k := (Finset.sum_insert h_notMem).symm
        _ ≤ ∑ k ∈ Finset.Icc 1 u₂, c k := Finset.sum_le_sum_of_subset h_sub
    have h_mul_lt : d * f u₁ < d * f u₂ := by
      omega
    exact Nat.lt_of_mul_lt_mul_left h_mul_lt
  have h_injOn : Set.InjOn f (J U) := by
    intro u₁ hu₁ u₂ hu₂ hf_eq
    rcases lt_trichotomy u₁ u₂ with h_lt | rfl | h_gt
    · have := h_mono u₁ hu₁ u₂ hu₂ h_lt
      omega
    · rfl
    · have := h_mono u₂ hu₂ u₁ hu₁ h_gt
      omega
  have h_card_le_Icc : (J U).card ≤ (Finset.Icc 1 (n - 1)).card :=
    Finset.card_le_card_of_injOn f h_mapsTo h_injOn
  rw [Nat.card_Icc] at h_card_le_Icc
  have h_card_le : (J U).card ≤ n - 1 := by omega
  have h_pow_le : q ^ (J U).card ≤ q ^ (n - 1) :=
    Nat.pow_le_pow_right (by omega) h_card_le
  exact le_trans hd_le_J (Nat.mul_le_mul_left (q - 1) h_pow_le)

theorem finrank_le_of_herbrandSum_lt (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F E] (hLE : L ≤ E) (hab : IsAbelianExt F hLE)
    (hres : resDeg F E = resDeg F L) (n : ℕ) (hn : 1 ≤ n) :
    (∀ u : ℕ, lowerRamSubgroup F hLE u ≠ ⊥ →
      herbrandSum F hLE u < n * Module.finrank L (IntermediateField.extendScalars hLE)) →
    Module.finrank F E ≤ Module.finrank F L * (qL F L - 1) * (qL F L) ^ (n - 1) :=
by
  intro h_ram
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion hLE).toLinearMap
      (IntermediateField.inclusion hLE).injective
  set E_L := IntermediateField.extendScalars hLE
  haveI : FiniteDimensional F ↥E_L := ‹FiniteDimensional F E›
  haveI : FiniteDimensional ↥L ↥E_L := FiniteDimensional.right F ↥L ↥E_L
  letI : Fintype (↥E_L ≃ₐ[↥L] ↥E_L) := AlgEquiv.fintype ↥L ↥E_L
  set d := Module.finrank ↥L ↥E_L
  have hd : 1 ≤ d := Nat.succ_le_of_lt (Module.finrank_pos (R := ↥L) (M := ↥E_L))
  set π_E : E := (chosenUniformizer F E : E)
  have hπ_E : valL F E π_E = 1 := (valL_chosenUniformizer_and_mul_zpow F E 1).1
  have hq : 2 ≤ qL F L := by
    have hres_pos : 0 < resDeg F L := by
      have h_ne : resDeg F E ≠ 0 := by
        intro h0
        have h_val0 : valL F E π_E = 0 := by
          unfold valL
          rw [h0, Nat.cast_zero, Int.ediv_zero]
        omega
      omega
    haveI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
    haveI : CharP 𝓀[F] (p F) := by unfold p; infer_instance
    obtain ⟨d_F, hp, hq_card⟩ := FiniteField.card 𝓀[F] (p F)
    have hq_ge_two : 2 ≤ q F := by
      rw [q, Nat.card_eq_fintype_card, hq_card]
      calc 2 = 2 ^ 1 := by ring
        _ ≤ 2 ^ (d_F : ℕ) := Nat.pow_le_pow_right (by omega) d_F.pos
        _ ≤ (p F) ^ (d_F : ℕ) := Nat.pow_le_pow_left hp.two_le (d_F : ℕ)
    unfold qL
    calc 2 = 2 ^ 1 := by ring
      _ ≤ 2 ^ resDeg F L := Nat.pow_le_pow_right (by omega) hres_pos
      _ ≤ (q F) ^ resDeg F L := Nat.pow_le_pow_left hq_ge_two (resDeg F L)
  have h_lift := exists_mem_valL_sub_ge_one_of_resDeg_eq F L E hLE hres
  have hG_mem := ((mem_lowerRamSubgroup_iff_and_of_valL_eq_one F L E hLE).2 h_lift π_E hπ_E).1
  obtain ⟨hc0, hc_tame, hc_wild⟩ :=
    card_lowerRamSubgroup_zero_and_succ_le F L E hLE hab hres π_E hπ_E h_lift hG_mem
  obtain ⟨N₀, _, h_term⟩ := exists_lowerRamSubgroup_eq_bot F L E hLE
  let c : ℕ → ℕ := fun u => Nat.card (lowerRamSubgroup F hLE u)
  have hc_pos : ∀ u : ℕ, 1 ≤ c u := fun u => Nat.succ_le_of_lt Nat.card_pos
  have hc_anti : ∀ u : ℕ, c (u + 1) ≤ c u := by
    intro u
    apply Subgroup.card_le_of_le
    intro σ hσ
    rw [hG_mem (u + 1) σ] at hσ
    rw [hG_mem u σ]
    rcases hσ with h_eq | h_val
    · exact Or.inl h_eq
    · right
      omega
  have h_ne_bot : ∀ u : ℕ, 2 ≤ c u → lowerRamSubgroup F hLE u ≠ ⊥ := by
    intro u hu hbot
    have h1 : c u = 1 := (Subgroup.eq_bot_iff_card _).mp hbot
    omega
  have hc_term : ∀ u : ℕ, 2 ≤ c u → ∑ k ∈ Finset.Icc 1 u, c k < N₀ * d :=
    fun u hu => h_term u (h_ne_bot u hu)
  have hc_bound : ∀ u : ℕ, 2 ≤ c u → ∑ k ∈ Finset.Icc 1 u, c k < n * d :=
    fun u hu => h_ram u (h_ne_bot u hu)
  have hc_dvd : ∀ u : ℕ, 1 ≤ u → c (u + 1) < c u → d ∣ ∑ k ∈ Finset.Icc 1 u, c k :=
    fun u hu hlt => finrank_dvd_herbrandSum_of_card_lt F L E hLE hab hres u hu hlt
  have hd_le : d ≤ (qL F L - 1) * (qL F L) ^ (n - 1) :=
    card_zero_le_of_dvd_sum_Icc_of_lt d (qL F L) n N₀ hd hq hn c
      hc_pos hc_anti hc0 hc_tame hc_wild hc_term hc_bound hc_dvd
  have h_tower : Module.finrank F L * d = Module.finrank F E :=
    Module.finrank_mul_finrank F ↥L ↥E_L
  calc Module.finrank F E
      = Module.finrank F L * d := h_tower.symm
    _ ≤ Module.finrank F L * ((qL F L - 1) * (qL F L) ^ (n - 1)) :=
      Nat.mul_le_mul_left (Module.finrank F L) hd_le
    _ = Module.finrank F L * (qL F L - 1) * (qL F L) ^ (n - 1) := by ring

theorem exists_le_ltDivSubfield_of_isAbelianExt_and_resDeg_eq (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K] (hLK : L ≤ K) :
    (∀ n : ℕ, 1 ≤ n →
      FiniteDimensional F ↥(K ⊔ ltDivSubfield F L n) ∧
      IsAbelianExt F (hLK.trans (le_sup_left : K ≤ K ⊔ ltDivSubfield F L n)) ∧
      resDeg F (K ⊔ ltDivSubfield F L n) = resDeg F L) →
    ∃ n : ℕ, 1 ≤ n ∧ K ≤ ltDivSubfield F L n :=
by
  intro h
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion hLK).toLinearMap
      (IntermediateField.inclusion hLK).injective
  obtain ⟨N, hN, hK_ram⟩ := exists_lowerRamSubgroup_eq_bot F L K hLK
  obtain ⟨hFin_N, hab_N, hres_N⟩ := h N hN
  haveI : FiniteDimensional F ↥(K ⊔ ltDivSubfield F L N) := hFin_N
  have hLT_ram := herbrandSum_ltDivSubfield_lt F L N hN
  have hEN_ram :=
    herbrandSum_sup_lt_of_lt F L K (ltDivSubfield F L N) hLK
      (le_sup_left : L ≤ ltDivSubfield F L N) hab_N hres_N N hN hK_ram hLT_ram
  have h_le :
      Module.finrank F ↥(K ⊔ ltDivSubfield F L N) ≤
        Module.finrank F L * (qL F L - 1) * (qL F L) ^ (N - 1) :=
    finrank_le_of_herbrandSum_lt F L (K ⊔ ltDivSubfield F L N)
      (hLK.trans (le_sup_left : K ≤ K ⊔ ltDivSubfield F L N)) hab_N hres_N N hN hEN_ram
  have h_finrank_le :
      Module.finrank F ↥(K ⊔ ltDivSubfield F L N) ≤
        Module.finrank F ↥(ltDivSubfield F L N) := by
    rw [finrank_ltDivSubfield F L N hN]
    exact h_le
  let S₁ : Submodule F (AlgebraicClosure F) := (ltDivSubfield F L N).toSubmodule
  let S₂ : Submodule F (AlgebraicClosure F) := (K ⊔ ltDivSubfield F L N).toSubmodule
  have hS₁S₂ : S₁ ≤ S₂ := fun _ hx =>
    (le_sup_right : ltDivSubfield F L N ≤ K ⊔ ltDivSubfield F L N) hx
  haveI : FiniteDimensional F ↥S₂ := hFin_N
  have h_sub_eq : S₁ = S₂ := Submodule.eq_of_le_of_finrank_le hS₁S₂ h_finrank_le
  refine ⟨N, hN, ?_⟩
  intro x hx
  have hx₂ : x ∈ S₂ := (le_sup_left : K ≤ K ⊔ ltDivSubfield F L N) hx
  rw [← h_sub_eq] at hx₂
  exact hx₂

theorem exists_ltFixedSubfield_le_ltDivSubfield (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (h : L ≤ M) :
    IsAbelianExt F h → ∀ m : ℕ, 1 ≤ m →
      ∃ n : ℕ, 1 ≤ n ∧ ltFixedSubfield F L M m ≤ ltDivSubfield F L n :=
by
  intro hab m hm
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion h).injective
  set K := ltFixedSubfield F L M m
  have hLK : L ≤ K := le_sup_left
  have h_sub : ∀ n : ℕ, K ⊔ ltDivSubfield F L n ≤ M ⊔ lubinTateUnramField F L n m := by
    intro n
    have h_unram_le : unramDegSubfield F L m ≤ lubinTateUnramField F L n m := by
      unfold unramDegSubfield lubinTateUnramField
      apply sup_le_sup_left
      rw [IntermediateField.adjoin_le_iff]
      exact Set.subset_union_right.trans (IntermediateField.subset_adjoin F _)
    have h_div_le : ltDivSubfield F L n ≤ lubinTateUnramField F L n m := by
      unfold ltDivSubfield lubinTateUnramField
      apply sup_le_sup_left
      rw [IntermediateField.adjoin_le_iff]
      exact Set.subset_union_left.trans (IntermediateField.subset_adjoin F _)
    have h_K_le : K ≤ M ⊔ lubinTateUnramField F L n m := by
      unfold K ltFixedSubfield
      apply sup_le (h.trans le_sup_left)
      exact inf_le_left.trans (sup_le_sup_left h_unram_le M)
    exact sup_le h_K_le (h_div_le.trans le_sup_right)
  haveI : FiniteDimensional F (lubinTateUnramField F L 1 m) :=
    finiteDimensional_lubinTateUnramField F L 1 m hm
  haveI : FiniteDimensional F K := by
    have hK_le : K ≤ M ⊔ lubinTateUnramField F L 1 m := le_sup_left.trans (h_sub 1)
    exact FiniteDimensional.of_injective (IntermediateField.inclusion hK_le).toLinearMap
      (IntermediateField.inclusion hK_le).injective
  set π := chosenUniformizer F L
  set σ := lubinTateFrob F L π
  have hπ : valL F L π = 1 := (valL_chosenUniformizer_and_mul_zpow F L 1).1
  obtain ⟨τ, hτL, hτFrob⟩ := exists_actsAsFrobPow_neg_resDeg F L
  obtain ⟨hσL, hσFrob, hσLT⟩ : IsLubinTateFrob F L π σ :=
    Classical.epsilon_spec (exists_isLubinTateFrob_of_frobLift F L π hπ τ hτL hτFrob)
  have hσ_fix_K : σ ∈ K.fixingSubgroup := by
    unfold K ltFixedSubfield
    rw [IntermediateField.fixingSubgroup_sup]
    refine Subgroup.mem_inf.mpr ⟨hσL, ?_⟩
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    have hx_fix : x ∈ IntermediateField.fixedField (Subgroup.zpowers σ) := hx.2
    exact hx_fix ⟨σ, Subgroup.mem_zpowers σ⟩
  have hσ_fix_div : ∀ n : ℕ, σ ∈ (ltDivSubfield F L n).fixingSubgroup := by
    intro n
    unfold ltDivSubfield
    rw [IntermediateField.fixingSubgroup_sup]
    refine Subgroup.mem_inf.mpr ⟨hσL, ?_⟩
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    induction hz using IntermediateField.adjoin_induction with
    | mem α hα => exact hσLT n α hα
    | algebraMap r => exact AlgEquiv.commutes _ r
    | add a b _ _ ha hb => rw [map_add, ha, hb]
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
    | inv a _ ha => rw [map_inv₀, ha]
  apply exists_le_ltDivSubfield_of_isAbelianExt_and_resDeg_eq F L K hLK
  intro n hn
  set E_n := K ⊔ ltDivSubfield F L n
  set N_n := lubinTateUnramField F L n m
  have hLE_n : L ≤ E_n := hLK.trans le_sup_left
  have hLN_n : L ≤ N_n := le_sup_left
  haveI : FiniteDimensional F N_n := finiteDimensional_lubinTateUnramField F L n m hm
  have hFin_n : FiniteDimensional F E_n :=
    FiniteDimensional.of_injective (IntermediateField.inclusion (h_sub n)).toLinearMap
      (IntermediateField.inclusion (h_sub n)).injective
  haveI : FiniteDimensional F E_n := hFin_n
  have hab_N : IsAbelianExt F hLN_n := isAbelianExt_lubinTateUnramField F L n m hn hm
  have h_comm : ∀ γ ∈ L.fixingSubgroup, ∀ ρ ∈ L.fixingSubgroup,
      γ * ρ * γ⁻¹ * ρ⁻¹ ∈ E_n.fixingSubgroup := by
    intro γ hγ ρ hρ
    have h_M : γ * ρ * γ⁻¹ * ρ⁻¹ ∈ M.fixingSubgroup := hab.2.1 γ hγ ρ hρ
    have h_N : γ * ρ * γ⁻¹ * ρ⁻¹ ∈ N_n.fixingSubgroup := hab_N.2.1 γ hγ ρ hρ
    have h_MN : γ * ρ * γ⁻¹ * ρ⁻¹ ∈ (M ⊔ N_n).fixingSubgroup := by
      rw [IntermediateField.fixingSubgroup_sup]
      exact Subgroup.mem_inf.mpr ⟨h_M, h_N⟩
    exact IntermediateField.fixingSubgroup_le (h_sub n) h_MN
  have h_norm : ∀ γ ∈ L.fixingSubgroup, ∀ ρ ∈ E_n.fixingSubgroup,
      γ * ρ * γ⁻¹ ∈ E_n.fixingSubgroup := by
    intro γ hγ ρ hρ
    have hρL : ρ ∈ L.fixingSubgroup := IntermediateField.fixingSubgroup_le hLE_n hρ
    have hc := E_n.fixingSubgroup.mul_mem (h_comm γ hγ ρ hρL) hρ
    rwa [inv_mul_cancel_right] at hc
  have h_sep : Algebra.IsSeparable L (IntermediateField.extendScalars hLE_n) := by
    haveI : Algebra.IsSeparable L (IntermediateField.extendScalars h) := hab.2.2
    haveI : Algebra.IsSeparable L (IntermediateField.extendScalars hLN_n) := hab_N.2.2
    have h_ext_le : IntermediateField.extendScalars hLE_n ≤
        IntermediateField.extendScalars h ⊔ IntermediateField.extendScalars hLN_n := by
      intro x hx
      rw [IntermediateField.extendScalars_sup]
      exact h_sub n hx
    exact Algebra.IsSeparable.of_algHom L _ (IntermediateField.inclusion h_ext_le)
  have hσ_fix_En : σ ∈ E_n.fixingSubgroup := by
    change σ ∈ (K ⊔ ltDivSubfield F L n).fixingSubgroup
    rw [IntermediateField.fixingSubgroup_sup]
    exact Subgroup.mem_inf.mpr ⟨hσ_fix_K, hσ_fix_div n⟩
  have h_resDeg : resDeg F E_n = resDeg F L :=
    resDeg_eq_of_actsAsFrobPow_neg_resDeg_and_mem_fixingSubgroup F L E_n hLE_n σ hσFrob hσ_fix_En
  exact ⟨hFin_n, ⟨h_norm, h_comm, h_sep⟩, h_resDeg⟩

theorem le_lubinTate_sup_unramifiedClosure_of_isAbelianExt (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (h : L ≤ M) :
    IsAbelianExt F h →
      M ≤ L ⊔ unramifiedClosure F ⊔
        IntermediateField.adjoin F {α : AlgebraicClosure F |
          ∃ n : ℕ, isLubinTateRoot F L (chosenUniformizer F L) n α} :=
by
  intro hab
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion h).injective
  set m := Module.finrank F M
  have hm : 1 ≤ m := Nat.succ_le_of_lt (Module.finrank_pos (R := F) (M := M))
  have h_unram : unramDegSubfield F L m ≤ L ⊔ unramifiedClosure F := by
    have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab_ne : a * b ≠ 0 := mul_ne_zero ha hb
      simp only [addVal, ha, hb, hab_ne, ↓reduceDIte]
      rw [← neg_add, neg_inj, ← toAdd_mul]
      congr 1
      rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
        WithZero.coe_unzero, ← map_mul, ← map_mul]
    have addVal_one : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have h_eq := addVal_mul h1 h1
      rw [mul_one] at h_eq
      omega
    let addValHom : Fˣ →* Multiplicative ℤ :=
      { toFun := fun u => Multiplicative.ofAdd (addVal F u)
        map_one' := by simp [addVal_one]
        map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
    have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
      let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
        (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
      have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
          WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
        (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
      obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
      have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
          WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
        rw [ha]
        exact hg
      have ha0 : a ≠ 0 := by
        intro h0
        rw [h0, map_zero, map_zero] at h1
        exact WithZero.coe_ne_zero h1.symm
      refine ⟨Units.mk0 a ha0, ?_⟩
      simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
      have h2 : WithZero.unzero
          (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
          (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
      rw [h2, toAdd_ofAdd, neg_neg]
    have hres : 0 < resDeg F L := by
      obtain ⟨u, hu⟩ := exists_addVal_eq_one
      let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : L, z ≠ 0 ∧ relVal F L z = k}
      have hS : S.Nonempty := by
        refine ⟨Module.finrank F L, Module.finrank_pos, algebraMap F L u,
          (map_ne_zero (algebraMap F L)).mpr u.ne_zero, ?_⟩
        have hnorm : Algebra.norm F (algebraMap F L (u : F)) = (u : F) ^ Module.finrank F L :=
          Algebra.norm_algebraMap (u : F)
        have hpow : addVal F ((u : F) ^ Module.finrank F L) =
            (Module.finrank F L : ℤ) * addVal F u := by
          change Multiplicative.toAdd (addValHom (u ^ Module.finrank F L)) = _
          rw [map_pow, toAdd_pow, nsmul_eq_mul]
          rfl
        rw [relVal, hnorm, hpow, hu, mul_one]
      exact (Nat.sInf_mem hS).1
    apply sup_le_sup_left
    rw [unramifiedClosure, IntermediateField.adjoin_le_iff]
    intro ζ hζ
    apply IntermediateField.subset_adjoin
    simp only [Set.mem_setOf_eq] at hζ ⊢
    haveI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
    haveI : CharP 𝓀[F] (p F) := by unfold p; infer_instance
    obtain ⟨d, hp, hq⟩ := FiniteField.card 𝓀[F] (p F)
    have hq' : q F = p F ^ (d : ℕ) := by
      rw [q, Nat.card_eq_fintype_card, hq]
    set k := (d : ℕ) * resDeg F L * m
    have hk_pos : 0 < k := Nat.mul_pos (Nat.mul_pos d.pos hres) (by omega)
    have hqLm : qL F L ^ m = p F ^ k := by
      dsimp [qL, k]
      rw [hq', ← pow_mul, ← pow_mul, mul_assoc]
    have hp_ge_two : 2 ≤ p F := hp.two_le
    have hpow_ge_two : 2 ≤ qL F L ^ m := by
      rw [hqLm]
      calc 2 = 2 ^ 1 := by ring
        _ ≤ 2 ^ k := Nat.pow_le_pow_right (by omega) hk_pos
        _ ≤ p F ^ k := Nat.pow_le_pow_left hp_ge_two k
    refine ⟨qL F L ^ m - 1, by omega, ?_, hζ⟩
    intro hdvd
    have hdvd_pow : p F ∣ qL F L ^ m := by
      rw [hqLm]
      exact dvd_pow_self (p F) (by omega)
    have hdvd_one : p F ∣ 1 := by
      have hsub := Nat.dvd_sub hdvd_pow hdvd
      have heq : qL F L ^ m - (qL F L ^ m - 1) = 1 := by omega
      rwa [heq] at hsub
    exact hp.not_dvd_one hdvd_one
  have h_split : M ≤ ltFixedSubfield F L M m ⊔ unramDegSubfield F L m :=
    le_ltFixedSubfield_sup_unramDegSubfield F L M h hab
  obtain ⟨n, _, h_fixed⟩ := exists_ltFixedSubfield_le_ltDivSubfield F L M h hab m hm
  have h_div : ltDivSubfield F L n ≤ L ⊔ unramifiedClosure F ⊔
      IntermediateField.adjoin F {α : AlgebraicClosure F |
        ∃ k : ℕ, isLubinTateRoot F L (chosenUniformizer F L) k α} := by
    apply sup_le
    · exact le_sup_of_le_left le_sup_left
    · apply le_sup_of_le_right
      rw [IntermediateField.adjoin_le_iff]
      intro α hα
      exact IntermediateField.subset_adjoin F _ ⟨n, hα⟩
  exact le_trans h_split (sup_le (le_trans h_fixed h_div) (le_sup_of_le_left h_unram))

theorem canonicalRecMap_mul (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L M : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M] (h : L ≤ M) :
    IsAbelianExt F h → ∀ x y : Lˣ,
      (((canonicalRecMap F L (x * y))⁻¹ * (canonicalRecMap F L x * canonicalRecMap F L y) :
        relWeil F L) : AbsGal F) ∈ M.fixingSubgroup :=
by
  intro hab x y
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion h).injective
  obtain ⟨hmem_xy, hfrob_xy⟩ := rawRecMap_actsAsFrobPow_and_mem_relWeil F L (x * y)
  obtain ⟨hmem_x, hfrob_x⟩ := rawRecMap_actsAsFrobPow_and_mem_relWeil F L x
  obtain ⟨hmem_y, hfrob_y⟩ := rawRecMap_actsAsFrobPow_and_mem_relWeil F L y
  rw [Subgroup.coe_mul, Subgroup.coe_inv, Subgroup.coe_mul,
    canonicalRecMap, dif_pos hmem_xy, canonicalRecMap, dif_pos hmem_x,
    canonicalRecMap, dif_pos hmem_y, Subgroup.coe_mk, Subgroup.coe_mk, Subgroup.coe_mk]
  apply IntermediateField.fixingSubgroup_le
    (le_lubinTate_sup_unramifiedClosure_of_isAbelianExt F L M h hab)
  rw [IntermediateField.fixingSubgroup_sup, IntermediateField.fixingSubgroup_sup,
    Subgroup.mem_inf, Subgroup.mem_inf]
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · exact Subgroup.mul_mem _ (Subgroup.inv_mem _ hmem_xy.2) (Subgroup.mul_mem _ hmem_x.2 hmem_y.2)
  · have h_relVal : relVal F L ((x * y : Lˣ) : L) = relVal F L (x : L) + relVal F L (y : L) := by
      have hne : ∀ u : Lˣ, Algebra.norm F (u : L) ≠ 0 := fun u =>
        (u.isUnit.map (Algebra.norm F)).ne_zero
      have ha : Algebra.norm F (x : L) ≠ 0 := hne x
      have hb : Algebra.norm F (y : L) ≠ 0 := hne y
      have hab_norm : Algebra.norm F (x : L) * Algebra.norm F (y : L) ≠ 0 := mul_ne_zero ha hb
      unfold relVal addVal
      rw [Units.val_mul, map_mul, dif_neg hab_norm, dif_neg ha, dif_neg hb, ← neg_add, neg_inj,
        ← toAdd_mul]
      congr 1
      have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
            (valuation F (Algebra.norm F (x : L) * Algebra.norm F (y : L))) =
          IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
            (valuation F (Algebra.norm F (x : L))) *
          IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
            (valuation F (Algebra.norm F (y : L))) := by
        rw [map_mul, map_mul]
      rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
        WithZero.coe_unzero, h1]
    set σ := rawRecMap F L x
    set τ := rawRecMap F L y
    set ρ := rawRecMap F L (x * y)
    set n := -relVal F L x
    set m := -relVal F L y
    have hρ : ActsAsFrobPow F ρ (n + m) := by
      have hnm : -relVal F L ((x * y : Lˣ) : L) = n + m := by
        change -relVal F L ((x * y : Lˣ) : L) = -relVal F L (x : L) + -relVal F L (y : L)
        rw [h_relVal, neg_add]
      rw [← hnm]
      exact hfrob_xy
    have h_apply : ∀ (γ : AbsGal F) {ζ : AlgebraicClosure F},
        IsPrimeToPRootOfUnity F ζ → IsPrimeToPRootOfUnity F (γ ζ) := by
      intro γ ζ ⟨r, hr, hpr, hζr⟩
      exact ⟨r, hr, hpr, by rw [← map_pow, hζr, map_one]⟩
    have h_nonneg : ∀ {γ : AbsGal F} {k : ℤ}, ActsAsFrobPow F γ k → 0 ≤ k →
        ∀ {ζ : AlgebraicClosure F}, IsPrimeToPRootOfUnity F ζ → γ ζ = ζ ^ (q F ^ k.toNat) := by
      intro γ k hγ hk ζ hζ
      have h_eq := hγ ζ hζ
      have hk' : (-k).toNat = 0 := by omega
      rw [hk', pow_zero, pow_one] at h_eq
      exact h_eq
    have h_nonpos : ∀ {γ : AbsGal F} {k : ℤ}, ActsAsFrobPow F γ k → k ≤ 0 →
        ∀ {ζ : AlgebraicClosure F}, IsPrimeToPRootOfUnity F ζ →
          γ⁻¹ ζ = ζ ^ (q F ^ (-k).toNat) := by
      intro γ k hγ hk ζ hζ
      have h_eq := hγ (γ⁻¹ ζ) (h_apply γ⁻¹ hζ)
      have hk' : k.toNat = 0 := by omega
      have happly : γ (γ⁻¹ ζ) = ζ := AlgEquiv.apply_symm_apply γ ζ
      rw [happly, hk', pow_zero, pow_one] at h_eq
      exact h_eq.symm
    have h_inv_apply : ∀ (γ : AbsGal F) (z : AlgebraicClosure F), γ (γ⁻¹ z) = z :=
      fun γ z => AlgEquiv.apply_symm_apply γ z
    have h_apply_inv : ∀ (γ : AbsGal F) (z : AlgebraicClosure F), γ⁻¹ (γ z) = z :=
      fun γ z => AlgEquiv.symm_apply_apply γ z
    rw [unramifiedClosure, IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    induction hz using IntermediateField.adjoin_induction with
    | mem ζ hζ =>
      suffices h_eq : σ (τ ζ) = ρ ζ by
        change (ρ⁻¹ * (σ * τ)) ζ = ζ
        rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, h_eq, h_apply_inv]
      rcases le_total 0 n with hn | hn <;> rcases le_total 0 m with hm | hm
      · have hnm : 0 ≤ n + m := by omega
        have he : (n + m).toNat = m.toNat + n.toNat := by omega
        rw [h_nonneg hfrob_x hn (h_apply τ hζ), h_nonneg hfrob_y hm hζ, h_nonneg hρ hnm hζ,
          ← pow_mul, ← pow_add, he]
      · rcases le_total 0 (n + m) with hnm | hnm
        · have he : n.toNat = (-m).toNat + (n + m).toNat := by omega
          have h1 := h_nonpos hfrob_y hm (h_apply τ hζ)
          rw [h_apply_inv] at h1
          rw [h_nonneg hfrob_x hn (h_apply τ hζ), h_nonneg hρ hnm hζ]
          conv_rhs => rw [h1, ← pow_mul, ← pow_add, ← he]
        · have he : (-m).toNat = n.toNat + (-(n + m)).toNat := by omega
          have h1 := h_nonpos hρ hnm (h_apply σ (h_apply τ hζ))
          rw [h_nonneg hfrob_x hn (h_apply τ hζ), ← pow_mul, ← pow_add, ← he,
            ← h_nonpos hfrob_y hm (h_apply τ hζ), h_apply_inv] at h1
          have h2 := congrArg ρ h1
          rw [h_inv_apply] at h2
          rw [h_nonneg hfrob_x hn (h_apply τ hζ), h2]
      · rcases le_total 0 (n + m) with hnm | hnm
        · have he : m.toNat = (n + m).toNat + (-n).toNat := by omega
          have h1 := h_nonpos hfrob_x hn (h_apply ρ hζ)
          rw [h_nonneg hρ hnm hζ, ← pow_mul, ← pow_add, ← he, ← h_nonneg hfrob_y hm hζ] at h1
          have h2 := congrArg σ h1
          rw [h_inv_apply] at h2
          rw [← h2, h_nonneg hρ hnm hζ]
        · have he : (-n).toNat = (-(n + m)).toNat + m.toNat := by omega
          have h1 := h_nonpos hρ hnm (h_apply ρ hζ)
          rw [h_apply_inv] at h1
          have h2 : τ ζ = σ⁻¹ (ρ ζ) := by
            rw [h_nonneg hfrob_y hm hζ, h_nonpos hfrob_x hn (h_apply ρ hζ)]
            conv_lhs => rw [h1, ← pow_mul, ← pow_add, ← he]
          have h3 := congrArg σ h2
          rw [h_inv_apply] at h3
          exact h3
      · have hnm : n + m ≤ 0 := by omega
        have he : (-(n + m)).toNat = (-n).toNat + (-m).toNat := by omega
        have h1 : τ⁻¹ (σ⁻¹ (ρ ζ)) = ζ := by
          rw [h_nonpos hfrob_y hm (h_apply σ⁻¹ (h_apply ρ hζ)),
            h_nonpos hfrob_x hn (h_apply ρ hζ),
            ← pow_mul, ← pow_add, ← he,
            ← h_nonpos hρ hnm (h_apply ρ hζ), h_apply_inv]
        have h2 := congrArg (fun w => σ (τ w)) h1
        dsimp only at h2
        rw [h_inv_apply, h_inv_apply] at h2
        exact h2.symm
    | algebraMap r => exact AlgEquiv.commutes _ r
    | add a b _ _ ha hb => rw [map_add, ha, hb]
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
    | inv a _ ha => rw [map_inv₀, ha]
  · rw [IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    induction hz using IntermediateField.adjoin_induction with
    | mem α hα =>
      rcases hα with ⟨n, hα⟩
      change ((rawRecMap F L (x * y))⁻¹ * (rawRecMap F L x * rawRecMap F L y)) α = α
      rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply,
        ← rawRecMap_mul_apply_isLubinTateRoot F L x y n α hα]
      exact AlgEquiv.symm_apply_apply (rawRecMap F L (x * y)) α
    | algebraMap r => exact AlgEquiv.commutes _ r
    | add a b _ _ ha hb => rw [map_add, ha, hb]
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
    | inv a _ ha => rw [map_inv₀, ha]

theorem lubinTateFrob_chosenUniformizer_mem_fixingSubgroup (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] :
    lubinTateFrob F L (chosenUniformizer F L) ∈
      (lubinTateExtension F L (chosenUniformizer F L)).fixingSubgroup :=
by
  let π := chosenUniformizer F L
  have hπ : valL F L π = 1 := (valL_chosenUniformizer_and_mul_zpow F L 1).1
  obtain ⟨τ, hτL, hτFrob⟩ := exists_actsAsFrobPow_neg_resDeg F L
  have hex : ∃ σ : AbsGal F, IsLubinTateFrob F L π σ :=
    exists_isLubinTateFrob_of_frobLift F L π hπ τ hτL hτFrob
  have hspec : IsLubinTateFrob F L π (lubinTateFrob F L π) :=
    Classical.epsilon_spec hex
  obtain ⟨hL, _, hroots⟩ := hspec
  unfold lubinTateExtension
  rw [IntermediateField.fixingSubgroup_sup, Subgroup.mem_inf]
  refine ⟨hL, ?_⟩
  rw [IntermediateField.mem_fixingSubgroup_iff]
  intro z hz
  induction hz using IntermediateField.adjoin_induction with
  | mem α hα =>
    rcases hα with ⟨n, hn⟩
    exact hroots n α hn
  | algebraMap a => exact AlgEquiv.commutes (lubinTateFrob F L π) a
  | add a b _ _ ha hb => rw [map_add, ha, hb]
  | mul a b _ _ ha hb => rw [map_mul, ha, hb]
  | inv a _ ha => rw [map_inv₀, ha]

theorem exists_unit_rawRecMap_inv_mul_mem_lubinTateExtension_fixingSubgroup (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (τ : AbsGal F)
    (hτ : τ ∈ L.fixingSubgroup) :
    ∃ u : Lˣ, valL F L u = 0 ∧
      (rawRecMap F L u)⁻¹ * τ ∈
        (lubinTateExtension F L (chosenUniformizer F L)).fixingSubgroup :=
by
  
  let π := chosenUniformizer F L
  have hπ : valL F L π = 1 := (valL_chosenUniformizer_and_mul_zpow F L 1).1
  have hres_ne : resDeg F L ≠ 0 := by
    intro h0
    have h1 : valL F L π = 1 := hπ
    rw [valL, h0, Nat.cast_zero, Int.ediv_zero] at h1
    omega
  have hres_pos : 0 < resDeg F L := Nat.pos_of_ne_zero hres_ne
  have hf_ne : (resDeg F L : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr hres_ne
  have hf_pos : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hres_pos
  have hq_gt : 1 < q F := Finite.one_lt_card
  have hqL_gt : 1 < qL F L := one_lt_pow₀ hq_gt hres_ne
  have hqL_pos : 0 < qL F L := by omega
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun v => Multiplicative.ofAdd (addVal F v)
      map_one' := by simp [addVal_one]
      map_mul' := fun v w => by simp [addVal_mul v.ne_zero w.ne_zero, ofAdd_add] }
  let relValHom : Lˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ v : Lˣ, Multiplicative.toAdd (relValHom v) = relVal F L v :=
    fun _ => rfl
  have relVal_units_mul : ∀ v w : Lˣ,
      relVal F L ((v * w : Lˣ) : L) = relVal F L v + relVal F L w := by
    intro v w
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (v : Lˣ) (k : ℤ),
      relVal F L ((v ^ k : Lˣ) : L) = k * relVal F L v := by
    intro v k
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have valL_units_mul : ∀ v w : Lˣ,
      valL F L ((v * w : Lˣ) : L) = valL F L v + valL F L w := by
    intro v w
    have hrel := relVal_eq_resDeg_mul_valL F L (v * w)
    rw [relVal_units_mul, relVal_eq_resDeg_mul_valL F L v,
      relVal_eq_resDeg_mul_valL F L w] at hrel
    apply mul_left_cancel₀ hf_ne
    linarith
  have valL_units_zpow : ∀ (v : Lˣ) (k : ℤ),
      valL F L ((v ^ k : Lˣ) : L) = k * valL F L v := by
    intro v k
    have hrel := relVal_eq_resDeg_mul_valL F L (v ^ k)
    rw [relVal_units_zpow, relVal_eq_resDeg_mul_valL F L v] at hrel
    apply mul_left_cancel₀ hf_ne
    linarith
  have h1_val : valL F L (1 : Lˣ) = 0 := by
    have h := valL_units_zpow π 0
    simp only [zpow_zero, zero_mul] at h
    exact h
  have valL_mul : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      valL F L (x * y) = valL F L x + valL F L y :=
    fun hx hy => valL_units_mul (Units.mk0 _ hx) (Units.mk0 _ hy)
  have valL_one : valL F L (1 : L) = 0 := h1_val
  have valL_zero : valL F L (0 : L) = 0 := by
    unfold valL relVal addVal
    simp
  have valL_div : ∀ {x y : L} (hx : x ≠ 0) (hy : y ≠ 0),
      valL F L (x / y) = valL F L x - valL F L y := by
    intro x y hx hy
    have hxy : x / y ≠ 0 := div_ne_zero hx hy
    have h := valL_mul hxy hy
    rw [div_mul_cancel₀ _ hy] at h
    omega
  have valL_pow : ∀ {x : L} (hx : x ≠ 0) (m : ℕ),
      valL F L (x ^ m) = (m : ℤ) * valL F L x := by
    intro x hx m
    induction m with
    | zero => simp [valL_one]
    | succ m ih =>
      rw [pow_succ, valL_mul (pow_ne_zero m hx) hx, ih]
      push_cast
      ring
  have hπL_ne : (π : L) ≠ 0 := Units.ne_zero π
  have h_pow_val : ∀ m : ℕ, valL F L ((π : L) ^ m) = (m : ℤ) := by
    intro m
    rw [valL_pow hπL_ne m, hπ, mul_one]
  have relVal_eq : ∀ {x : L} (hx : x ≠ 0), relVal F L x = (resDeg F L : ℤ) * valL F L x :=
    fun hx => relVal_eq_resDeg_mul_valL F L (Units.mk0 _ hx)
  have h_div_iff : ∀ (m : ℕ) (d : L),
      (d = 0 ∨ (m : ℤ) ≤ valL F L d) ↔ IsIntegral 𝒪[F] (d / (π : L) ^ m) := by
    intro m d
    rw [isIntegral_iff_eq_zero_or_relVal_nonneg F L (d / (π : L) ^ m)]
    have hpow_ne : (π : L) ^ m ≠ 0 := pow_ne_zero m hπL_ne
    by_cases hd0 : d = 0
    · simp [hd0]
    · have hdiv_ne : d / (π : L) ^ m ≠ 0 := div_ne_zero hd0 hpow_ne
      rw [or_iff_right hd0, or_iff_right hdiv_ne, relVal_eq hdiv_ne,
        valL_div hd0 hpow_ne, h_pow_val m]
      exact ⟨fun h => mul_nonneg (by omega) (by omega),
        fun h => by have := nonneg_of_mul_nonneg_right h hf_pos; omega⟩
  have h_int_iff : ∀ d : L, 0 ≤ valL F L d ↔ IsIntegral 𝒪[F] d := by
    intro d
    have h := h_div_iff 0 d
    simp only [Nat.cast_zero, pow_zero, div_one] at h
    rw [← h]
    by_cases hd0 : d = 0
    · simp [hd0, valL_zero]
    · simp [hd0]
  have h_neg_mod : ∀ (m : ℕ) {x y : L},
      (x - y = 0 ∨ (m : ℤ) ≤ valL F L (x - y)) →
      (y - x = 0 ∨ (m : ℤ) ≤ valL F L (y - x)) := by
    intro m x y hxy
    rw [h_div_iff] at hxy ⊢
    have h_eq : (y - x) / (π : L) ^ m = -((x - y) / (π : L) ^ m) := by ring
    rw [h_eq]
    exact IsIntegral.neg hxy
  have h_trans_mod : ∀ (m : ℕ) {x y z : L},
      (x - y = 0 ∨ (m : ℤ) ≤ valL F L (x - y)) →
      (y - z = 0 ∨ (m : ℤ) ≤ valL F L (y - z)) →
      (x - z = 0 ∨ (m : ℤ) ≤ valL F L (x - z)) := by
    intro m x y z hxy hyz
    rw [h_div_iff] at hxy hyz ⊢
    have h_eq : (x - z) / (π : L) ^ m = (x - y) / (π : L) ^ m + (y - z) / (π : L) ^ m := by ring
    rw [h_eq]
    exact IsIntegral.add hxy hyz
  have h_sub_val_nonneg : ∀ {x y : L}, 0 ≤ valL F L x → 0 ≤ valL F L y → 0 ≤ valL F L (x - y) := by
    intro x y hx hy
    rw [h_int_iff] at hx hy ⊢
    exact IsIntegral.sub hx hy
  have h_unit_of_mul_sub_one : ∀ {a b : L},
      0 ≤ valL F L a → 0 ≤ valL F L b →
      (a * b - 1 = 0 ∨ (1 : ℤ) ≤ valL F L (a * b - 1)) →
      a ≠ 0 ∧ valL F L a = 0 := by
    intro a b ha hb hab
    have h_not : ¬ (a = 0 ∨ (1 : ℤ) ≤ valL F L a) := by
      intro ha1
      have ha_int : IsIntegral 𝒪[F] (a / (π : L) ^ 1) := (h_div_iff 1 a).mp ha1
      have hb_int : IsIntegral 𝒪[F] b := (h_int_iff b).mp hb
      have hab_int : IsIntegral 𝒪[F] ((a * b - 1) / (π : L) ^ 1) := (h_div_iff 1 (a * b - 1)).mp hab
      have h1_int : IsIntegral 𝒪[F] ((1 : L) / (π : L) ^ 1) := by
        have h_eq : (1 : L) / (π : L) ^ 1 = (a / (π : L) ^ 1) * b - (a * b - 1) / (π : L) ^ 1 := by ring
        rw [h_eq]
        exact IsIntegral.sub (IsIntegral.mul ha_int hb_int) hab_int
      rcases (h_div_iff 1 1).mpr h1_int with h10 | h1_val_ge
      · exact one_ne_zero h10
      · rw [valL_one] at h1_val_ge
        omega
    push_neg at h_not
    exact ⟨h_not.1, by omega⟩
  have hfix_π : ∀ {n : ℕ} {α : AlgebraicClosure F},
      isLubinTateRoot F L π n α → lubinTateFrob F L π α = α := by
    intro n α hα
    have h_mem_ext : α ∈ lubinTateExtension F L π := by
      apply (le_sup_right : _ ≤ lubinTateExtension F L π)
      exact IntermediateField.subset_adjoin F
        {β : AlgebraicClosure F | ∃ k : ℕ, isLubinTateRoot F L π k β} ⟨n, hα⟩
    exact (IntermediateField.mem_fixingSubgroup_iff _ _).mp
      (lubinTateFrob_chosenUniformizer_mem_fixingSubgroup F L) α h_mem_ext
  have hg_deg_all : ∀ k : ℕ,
      (lubinTateIterPoly F L (π : L) k).Monic ∧
      (lubinTateIterPoly F L (π : L) k).natDegree = (qL F L) ^ k := by
    intro k
    have hdeg_lt : (Polynomial.C (π : L) * Polynomial.X).degree <
        (Polynomial.X ^ qL F L : Polynomial L).degree := by
      rw [Polynomial.degree_X_pow]
      exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_le (π : L)) (WithBot.coe_lt_coe.mpr hqL_gt)
    have hf0_monic : (lubinTatePoly F L (π : L)).Monic := by
      change (Polynomial.C (π : L) * Polynomial.X + Polynomial.X ^ qL F L).Monic
      rw [add_comm]
      exact Polynomial.Monic.add_of_left (Polynomial.monic_X_pow (qL F L)) hdeg_lt
    have hf0_deg : (lubinTatePoly F L (π : L)).natDegree = qL F L := by
      change (Polynomial.C (π : L) * Polynomial.X + Polynomial.X ^ qL F L).natDegree = qL F L
      rw [add_comm, Polynomial.natDegree_add_eq_left_of_degree_lt hdeg_lt,
        Polynomial.natDegree_X_pow]
    induction k with
    | zero =>
      dsimp [lubinTateIterPoly]
      exact ⟨Polynomial.monic_X, Polynomial.natDegree_X⟩
    | succ k ih =>
      obtain ⟨ih_monic, ih_deg⟩ := ih
      have h_deg_ne : (lubinTateIterPoly F L (π : L) k).natDegree ≠ 0 := by
        rw [ih_deg]
        exact pow_ne_zero k (by omega)
      dsimp [lubinTateIterPoly]
      refine ⟨hf0_monic.comp ih_monic h_deg_ne, ?_⟩
      rw [Polynomial.natDegree_comp, hf0_deg, ih_deg, pow_succ']
  
  have h_level : ∀ (n : ℕ), 1 ≤ n →
      (∀ (c₁ c₂ : L), 0 ≤ valL F L c₁ → 0 ≤ valL F L c₂ →
        ((∀ α : AlgebraicClosure F, isLubinTateRoot F L π n α →
            Polynomial.aeval α (lubinTateEndoPoly F L (π : L) c₁ n) =
              Polynomial.aeval α (lubinTateEndoPoly F L (π : L) c₂ n)) ↔
          (c₁ - c₂ = 0 ∨ (n : ℤ) ≤ valL F L (c₁ - c₂)))) ∧
      (∃ u_n : Lˣ, valL F L u_n = 0 ∧
        ∀ α : AlgebraicClosure F, isLubinTateRoot F L π n α →
          lubinTateFrob F L (u_n * π) α = τ α) := by
    intro n hn
    have hg_deg : (lubinTateIterPoly F L (π : L) n).natDegree = (qL F L) ^ n := (hg_deg_all n).2
    obtain ⟨hg_monic, hg_aeval⟩ := lubinTateIterPoly_monic_and_aeval_eq_zero_iff F L π n
    obtain ⟨hf_monic, -, hf_irr⟩ :=
      lubinTateDivPoly_monic_coeff_zero_and_irreducible F L π hπ n hn
    set g_n : Polynomial L := lubinTateIterPoly F L (π : L) n
    set f_n : Polynomial L := lubinTateDivPoly F L (π : L) n
    let P : L → Polynomial L := fun c => lubinTateEndoPoly F L (π : L) c n
    have hn_eq : n = (n - 1) + 1 := (Nat.sub_add_cancel hn).symm
    have hqL_sub : (qL F L - 1) + 1 = qL F L := Nat.sub_add_cancel (by omega)
    have h_gn_eq : g_n = lubinTateIterPoly F L (π : L) (n - 1) * f_n := by
      change lubinTateIterPoly F L (π : L) n =
        lubinTateIterPoly F L (π : L) (n - 1) *
          ((lubinTateIterPoly F L (π : L) (n - 1)) ^ (qL F L - 1) + Polynomial.C (π : L))
      conv_lhs => rw [hn_eq]
      change (Polynomial.C (π : L) * Polynomial.X + Polynomial.X ^ qL F L).comp
        (lubinTateIterPoly F L (π : L) (n - 1)) = _
      rw [Polynomial.add_comp, Polynomial.mul_comp, Polynomial.C_comp, Polynomial.X_comp,
        Polynomial.pow_comp, Polynomial.X_comp]
      conv_lhs => rw [← hqL_sub, pow_succ']
      ring
    obtain ⟨π_n, hπ_aeval⟩ :=
      IsAlgClosed.exists_aeval_eq_zero (AlgebraicClosure F) f_n hf_irr.degree_pos.ne'
    have hπ_gn : Polynomial.aeval π_n g_n = 0 := by
      rw [h_gn_eq, map_mul, hπ_aeval, mul_zero]
    have hπ_root : isLubinTateRoot F L π n π_n := (hg_aeval π_n).mp hπ_gn
    have h_minpoly : minpoly L π_n = f_n :=
      (minpoly.eq_of_irreducible_of_monic hf_irr hπ_aeval hf_monic).symm
    let Φ : L → AlgebraicClosure F := fun c => Polynomial.aeval π_n (P c)
    set G_n : Polynomial (AlgebraicClosure F) := g_n.map (algebraMap L (AlgebraicClosure F))
    set R : Finset (AlgebraicClosure F) := (g_n.aroots (AlgebraicClosure F)).toFinset
    have hGn_deg : G_n.natDegree = (qL F L) ^ n := by
      rw [hg_monic.natDegree_map, hg_deg]
    have hR_card : R.card ≤ (qL F L) ^ n := by
      calc R.card ≤ (g_n.aroots (AlgebraicClosure F)).card :=
            Multiset.toFinset_card_le (g_n.aroots (AlgebraicClosure F))
        _ ≤ G_n.natDegree := Polynomial.card_roots' G_n
        _ = (qL F L) ^ n := hGn_deg
    have h_mem_R : ∀ β : AlgebraicClosure F, β ∈ R ↔ isLubinTateRoot F L π n β := by
      intro β
      rw [Multiset.mem_toFinset, Polynomial.mem_aroots]
      exact ⟨fun h => (hg_aeval β).mp h.2, fun h => ⟨hg_monic.ne_zero, (hg_aeval β).mpr h⟩⟩
    have hΦ_mem_R : ∀ {c : L}, 0 ≤ valL F L c → Φ c ∈ R := by
      intro c hc
      rw [h_mem_R, ← hg_aeval]
      have h_mod :=
        lubinTateIterPoly_comp_lubinTateEndoPoly_modByMonic_eq_zero F L π hπ n c (Or.inr hc)
      have h_div := (Polynomial.modByMonic_add_div (g_n.comp (P c)) hg_monic).symm
      have h_eval := congrArg (Polynomial.aeval π_n) h_div
      rw [Polynomial.aeval_comp, h_mod, zero_add, map_mul, hπ_gn, zero_mul] at h_eval
      exact h_eval
    have hΦ_inj_mod : ∀ {c₁ c₂ : L}, 0 ≤ valL F L c₁ → 0 ≤ valL F L c₂ →
        Φ c₁ = Φ c₂ → (c₁ - c₂ = 0 ∨ (n : ℤ) ≤ valL F L (c₁ - c₂)) := by
      intro c₁ c₂ hc₁ hc₂ h_eq
      by_contra h_not
      push_neg at h_not
      obtain ⟨hsub_ne, hval_lt⟩ := h_not
      have hne : c₁ ≠ c₂ := sub_ne_zero.mp hsub_ne
      have hval_nonneg : 0 ≤ valL F L (c₁ - c₂) := h_sub_val_nonneg hc₁ hc₂
      set k : ℕ := (valL F L (c₁ - c₂)).toNat
      have hk_val : valL F L (c₁ - c₂) = (k : ℤ) := (Int.toNat_of_nonneg hval_nonneg).symm
      have hk_lt : k < n := by omega
      set D : Polynomial L := P c₁ - P c₂
      obtain ⟨hD0, hDc0, hD_lt, hD_eq⟩ :=
        lubinTateEndoPoly_sub_coeff_valL_staircase F L π hπ n c₁ c₂
          (Or.inr hc₁) (Or.inr hc₂) hne k hk_lt hk_val
      set M : ℕ := (qL F L) ^ k
      have hM_pos : 1 ≤ M := Nat.one_le_pow k (qL F L) hqL_pos
      have hM_le : M ≤ (qL F L) ^ (n - 1) := Nat.pow_le_pow_right hqL_pos (by omega)
      have h_not_dvd : ¬ (f_n ∣ D) :=
        not_lubinTateDivPoly_dvd_of_valL_coeff_eq_zero F L π hπ n hn D
          hD0 hDc0 M hM_pos hM_le hD_lt hD_eq
      have h_aeval_D : Polynomial.aeval π_n D = 0 := by
        change Polynomial.aeval π_n (P c₁ - P c₂) = 0
        rw [map_sub, sub_eq_zero]
        exact h_eq
      have h_dvd : f_n ∣ D := by
        rw [← h_minpoly]
        exact minpoly.dvd L π_n h_aeval_D
      exact h_not_dvd h_dvd
    obtain ⟨S, hS_card, hS_int, hS_diff⟩ :=
      exists_finset_card_qL_pow_and_valL_sub_lt F L π hπ n
    have hS_val_nonneg : ∀ a ∈ S, 0 ≤ valL F L a := by
      intro a ha
      rcases hS_int a ha with rfl | hge
      · rw [valL_zero]
      · exact hge
    have h_sub : S.image Φ ⊆ R := by
      intro β hβ
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hβ
      exact hΦ_mem_R (hS_val_nonneg a ha)
    have h_inj : Set.InjOn Φ (S : Set L) := by
      intro a₁ ha₁ a₂ ha₂ h_eq
      by_contra hne
      obtain ⟨k, hk_lt, hk_val⟩ := hS_diff a₁ ha₁ a₂ ha₂ hne
      rcases hΦ_inj_mod (hS_val_nonneg a₁ ha₁) (hS_val_nonneg a₂ ha₂) h_eq with hsub0 | hge
      · exact hne (sub_eq_zero.mp hsub0)
      · rw [hk_val] at hge
        omega
    have h_im_card : (S.image Φ).card = (qL F L) ^ n := by
      rw [Finset.card_image_of_injOn h_inj, hS_card]
    have h_card_le : R.card ≤ (S.image Φ).card := by
      rw [h_im_card]
      exact hR_card
    have h_eq_R : S.image Φ = R := (Finset.subset_iff_eq_of_card_le h_card_le).mp h_sub
    have hΦ_eq_of_mod : ∀ {c₁ c₂ : L}, 0 ≤ valL F L c₁ → 0 ≤ valL F L c₂ →
        (c₁ - c₂ = 0 ∨ (n : ℤ) ≤ valL F L (c₁ - c₂)) → Φ c₁ = Φ c₂ := by
      intro c₁ c₂ hc₁ hc₂ h_mod
      have hc₁_mem : Φ c₁ ∈ S.image Φ := h_eq_R.symm ▸ hΦ_mem_R hc₁
      have hc₂_mem : Φ c₂ ∈ S.image Φ := h_eq_R.symm ▸ hΦ_mem_R hc₂
      obtain ⟨a₁, ha₁, hΦ₁⟩ := Finset.mem_image.mp hc₁_mem
      obtain ⟨a₂, ha₂, hΦ₂⟩ := Finset.mem_image.mp hc₂_mem
      have h_mod₁ : c₁ - a₁ = 0 ∨ (n : ℤ) ≤ valL F L (c₁ - a₁) :=
        hΦ_inj_mod hc₁ (hS_val_nonneg a₁ ha₁) hΦ₁.symm
      have h_mod₂ : c₂ - a₂ = 0 ∨ (n : ℤ) ≤ valL F L (c₂ - a₂) :=
        hΦ_inj_mod hc₂ (hS_val_nonneg a₂ ha₂) hΦ₂.symm
      have h_a₁_a₂ : a₁ - a₂ = 0 ∨ (n : ℤ) ≤ valL F L (a₁ - a₂) :=
        h_trans_mod n (h_trans_mod n (h_neg_mod n h_mod₁) h_mod) h_mod₂
      have ha_eq : a₁ = a₂ := by
        by_contra hne
        obtain ⟨k, hk_lt, hk_val⟩ := hS_diff a₁ ha₁ a₂ ha₂ hne
        rcases h_a₁_a₂ with h0 | hge
        · exact hne (sub_eq_zero.mp h0)
        · rw [hk_val] at hge
          omega
      rw [← hΦ₁, ← hΦ₂, ha_eq]
    have h_symm_P : ∀ {b c : L}, 0 ≤ valL F L b → 0 ≤ valL F L c →
        Polynomial.aeval (Φ b) (P c) = Polynomial.aeval (Φ c) (P b) := by
      intro b c hb hc
      have h1 := aeval_lubinTateEndoPoly_mul_isLubinTateRoot F L c b hc hb n π_n hπ_root
      have h2 := aeval_lubinTateEndoPoly_mul_isLubinTateRoot F L b c hb hc n π_n hπ_root
      change Polynomial.aeval π_n (P (c * b)) = Polynomial.aeval (Φ b) (P c) at h1
      change Polynomial.aeval π_n (P (b * c)) = Polynomial.aeval (Φ c) (P b) at h2
      rw [← h1, ← h2, mul_comm]
    have h_aeval_of_Φ_eq : ∀ {c₁ c₂ : L}, 0 ≤ valL F L c₁ → 0 ≤ valL F L c₂ →
        Φ c₁ = Φ c₂ →
        ∀ α : AlgebraicClosure F, isLubinTateRoot F L π n α →
          Polynomial.aeval α (P c₁) = Polynomial.aeval α (P c₂) := by
      intro c₁ c₂ hc₁ hc₂ hΦ_eq α hα
      have hα_mem : α ∈ S.image Φ := h_eq_R.symm ▸ (h_mem_R α).mpr hα
      obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp hα_mem
      have hb_val : 0 ≤ valL F L b := hS_val_nonneg b hb
      rw [h_symm_P hb_val hc₁, hΦ_eq, ← h_symm_P hb_val hc₂]
    refine ⟨fun c₁ c₂ hc₁ hc₂ => ⟨fun h_all => hΦ_inj_mod hc₁ hc₂ (h_all π_n hπ_root),
      fun h_mod => h_aeval_of_Φ_eq hc₁ hc₂ (hΦ_eq_of_mod hc₁ hc₂ h_mod)⟩, ?_⟩
    have h_gal_rep : ∀ γ ∈ L.fixingSubgroup, ∃ a ∈ S,
        ∀ α : AlgebraicClosure F, isLubinTateRoot F L π n α →
          γ α = Polynomial.aeval α (P a) := by
      intro γ hγ
      let σ : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F :=
        (IntermediateField.fixingSubgroupEquiv L) ⟨γ, hγ⟩
      have h_aeval_σ : ∀ (x : AlgebraicClosure F) (Q : Polynomial L),
          Polynomial.aeval (σ x) Q = σ (Polynomial.aeval x Q) :=
        fun x Q => Polynomial.aeval_algHom_apply σ x Q
      have hσ_π_mem : σ π_n ∈ S.image Φ := by
        rw [h_eq_R, h_mem_R, ← hg_aeval, h_aeval_σ π_n g_n, hπ_gn, map_zero]
      obtain ⟨a, ha, hΦ_a⟩ := Finset.mem_image.mp hσ_π_mem
      refine ⟨a, ha, fun α hα => ?_⟩
      have hα_mem : α ∈ S.image Φ := h_eq_R.symm ▸ (h_mem_R α).mpr hα
      obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp hα_mem
      calc γ (Φ b) = σ (Polynomial.aeval π_n (P b)) := rfl
        _ = Polynomial.aeval (σ π_n) (P b) := (h_aeval_σ π_n (P b)).symm
        _ = Polynomial.aeval (Φ a) (P b) := by rw [← hΦ_a]
        _ = Polynomial.aeval (Φ b) (P a) := h_symm_P (hS_val_nonneg a ha) (hS_val_nonneg b hb)
    obtain ⟨a, haS, ha_eq⟩ := h_gal_rep τ hτ
    obtain ⟨b, hbS, hb_eq⟩ := h_gal_rep τ⁻¹ (Subgroup.inv_mem _ hτ)
    have ha_val : 0 ≤ valL F L a := hS_val_nonneg a haS
    have hb_val : 0 ≤ valL F L b := hS_val_nonneg b hbS
    have hab_val : 0 ≤ valL F L (a * b) := by
      rw [h_int_iff]
      exact IsIntegral.mul ((h_int_iff a).mp ha_val) ((h_int_iff b).mp hb_val)
    have hΦ_ab : Φ (a * b) = π_n := by
      have h_mul := aeval_lubinTateEndoPoly_mul_isLubinTateRoot F L a b ha_val hb_val n π_n hπ_root
      change Φ (a * b) = Polynomial.aeval (Φ b) (P a) at h_mul
      have hΦ_b_root : isLubinTateRoot F L π n (Φ b) := (h_mem_R (Φ b)).mp (hΦ_mem_R hb_val)
      have h_a_Φb : Polynomial.aeval (Φ b) (P a) = τ (Φ b) := (ha_eq (Φ b) hΦ_b_root).symm
      have h_b_π : Φ b = τ⁻¹ π_n := (hb_eq π_n hπ_root).symm
      have h_cancel : τ (τ⁻¹ π_n) = π_n := AlgEquiv.apply_symm_apply τ π_n
      rw [h_mul, h_a_Φb, h_b_π, h_cancel]
    have hΦ_1 : Φ 1 = π_n := by
      change Polynomial.aeval π_n (lubinTateEndoPoly F L (π : L) ((1 : Lˣ) : L) n) = π_n
      rw [← lubinTateFrob_unit_mul_chosenUniformizer_apply_isLubinTateRoot F L 1 h1_val n π_n hπ_root,
        one_mul]
      exact hfix_π hπ_root
    have h_ab_1_mod : a * b - 1 = 0 ∨ (n : ℤ) ≤ valL F L (a * b - 1) :=
      hΦ_inj_mod hab_val (by rw [valL_one]) (hΦ_ab.trans hΦ_1.symm)
    have h_ab_1_mod1 : a * b - 1 = 0 ∨ (1 : ℤ) ≤ valL F L (a * b - 1) :=
      h_ab_1_mod.imp id (fun hle => by omega)
    obtain ⟨ha0, ha_val0⟩ := h_unit_of_mul_sub_one ha_val hb_val h_ab_1_mod1
    let u_n : Lˣ := Units.mk0 a ha0
    refine ⟨u_n, ha_val0, fun α hα => ?_⟩
    rw [lubinTateFrob_unit_mul_chosenUniformizer_apply_isLubinTateRoot F L u_n ha_val0 n α hα]
    exact (ha_eq α hα).symm
  
  have isRoot_mono : ∀ {m r : ℕ}, m ≤ r → ∀ {α : AlgebraicClosure F},
      isLubinTateRoot F L π m α → isLubinTateRoot F L π r α := by
    intro m r hmr α hα
    let g_step : AlgebraicClosure F → AlgebraicClosure F :=
      fun y => ((π : L) : AlgebraicClosure F) * y + y ^ qL F L
    have hg_step_zero : g_step 0 = 0 := by
      dsimp [g_step]
      rw [mul_zero, zero_add, zero_pow (by omega)]
    have hg_iter_zero : ∀ k : ℕ, (g_step^[k]) 0 = 0 := by
      intro k
      induction k with
      | zero => rfl
      | succ k ih => rw [Function.iterate_succ_apply', ih, hg_step_zero]
    change (g_step^[r]) α = 0
    have hr_eq : r = (r - m) + m := (Nat.sub_add_cancel hmr).symm
    rw [hr_eq, Function.iterate_add_apply]
    change (g_step^[r - m]) ((g_step^[m]) α) = 0
    have hα' : (g_step^[m]) α = 0 := hα
    rw [hα', hg_iter_zero]
  let u_seq : ℕ → Lˣ := fun n =>
    if hn : 1 ≤ n then (h_level n hn).2.choose else 1
  have hu_seq_val : ∀ r : ℕ, valL F L (u_seq r) = 0 := by
    intro r
    dsimp [u_seq]
    split_ifs with hr
    · exact (h_level r hr).2.choose_spec.1
    · exact h1_val
  have hu_seq_nonneg : ∀ r : ℕ, 0 ≤ valL F L (u_seq r : L) := by
    intro r
    rw [hu_seq_val r]
  have hu_seq_apply : ∀ (r : ℕ) (hr : 1 ≤ r) (α : AlgebraicClosure F),
      isLubinTateRoot F L π r α → lubinTateFrob F L (u_seq r * π) α = τ α := by
    intro r hr α hα
    dsimp [u_seq]
    rw [dif_pos hr]
    exact (h_level r hr).2.choose_spec.2 α hα
  have hu_cauchy : ∀ m r k : ℕ, m * 1 ≤ r →
      (u_seq (r + k) : L) - (u_seq r : L) = 0 ∨
        (m : ℤ) ≤ valL F L ((u_seq (r + k) : L) - (u_seq r : L)) := by
    intro m r k hmr
    rcases Nat.eq_zero_or_pos m with rfl | hm_pos
    · right
      exact h_sub_val_nonneg (hu_seq_nonneg (r + k)) (hu_seq_nonneg r)
    · have hm1 : 1 ≤ m := hm_pos
      have hr1 : 1 ≤ r := by omega
      have hrk1 : 1 ≤ r + k := by omega
      have hmr' : m ≤ r := by omega
      have hmrk' : m ≤ r + k := by omega
      apply ((h_level m hm1).1 (u_seq (r + k) : L) (u_seq r : L)
        (hu_seq_nonneg (r + k)) (hu_seq_nonneg r)).mp
      intro α hα
      rw [← lubinTateFrob_unit_mul_chosenUniformizer_apply_isLubinTateRoot F L
          (u_seq (r + k)) (hu_seq_val (r + k)) m α hα,
        ← lubinTateFrob_unit_mul_chosenUniformizer_apply_isLubinTateRoot F L
          (u_seq r) (hu_seq_val r) m α hα,
        hu_seq_apply (r + k) hrk1 α (isRoot_mono hmrk' hα),
        hu_seq_apply r hr1 α (isRoot_mono hmr' hα)]
  obtain ⟨x, hx_lim⟩ :=
    exists_valL_cauchy_limit F L 1 zero_lt_one (fun r => (u_seq r : L)) hu_cauchy
  have hx_nonneg : 0 ≤ valL F L x := by
    have h0 := (h_div_iff 0 (x - (u_seq 0 : L))).mp (hx_lim 0 0 (by omega))
    simp only [ pow_zero, div_one ] at h0
    have hu0_int : IsIntegral 𝒪[F] (u_seq 0 : L) := (h_int_iff (u_seq 0 : L)).mp (hu_seq_nonneg 0)
    have hx_int : IsIntegral 𝒪[F] x := by
      have h_eq : x = (x - (u_seq 0 : L)) + (u_seq 0 : L) := by ring
      rw [h_eq]
      exact IsIntegral.add h0 hu0_int
    exact (h_int_iff x).mpr hx_int
  let v₁ : Lˣ := (u_seq 1)⁻¹
  have hv₁_val : valL F L v₁ = 0 := by
    have h := valL_units_mul (u_seq 1) v₁
    rw [mul_inv_cancel, h1_val, hu_seq_val 1, zero_add] at h
    exact h.symm
  have hv₁_nonneg : 0 ≤ valL F L (v₁ : L) := by rw [hv₁_val]
  have hx_v₁_mod : x * (v₁ : L) - 1 = 0 ∨ (1 : ℤ) ≤ valL F L (x * (v₁ : L) - 1) := by
    apply (h_div_iff 1 (x * (v₁ : L) - 1)).mpr
    have h1 := (h_div_iff 1 (x - (u_seq 1 : L))).mp (hx_lim 1 1 (by omega))
    have hv₁_int : IsIntegral 𝒪[F] (v₁ : L) := (h_int_iff (v₁ : L)).mp hv₁_nonneg
    have h_uv : (u_seq 1 : L) * (v₁ : L) = 1 := Units.mul_inv (u_seq 1)
    have h_eq : (x * (v₁ : L) - 1) / (π : L) ^ 1 =
        ((x - (u_seq 1 : L)) / (π : L) ^ 1) * (v₁ : L) := by
      linear_combination (1 / (π : L) ^ 1) * h_uv
    rw [h_eq]
    exact IsIntegral.mul h1 hv₁_int
  obtain ⟨hx0, hx_val⟩ := h_unit_of_mul_sub_one hx_nonneg hv₁_nonneg hx_v₁_mod
  let u : Lˣ := Units.mk0 x hx0
  have hu_val : valL F L u = 0 := hx_val
  have hu_nonneg : 0 ≤ valL F L (u : L) := by rw [hu_val]
  have hu_apply : ∀ (n : ℕ), 1 ≤ n → ∀ (α : AlgebraicClosure F),
      isLubinTateRoot F L π n α → lubinTateFrob F L (u * π) α = τ α := by
    intro n hn α hα
    have h_mod : (u : L) - (u_seq n : L) = 0 ∨ (n : ℤ) ≤ valL F L ((u : L) - (u_seq n : L)) :=
      hx_lim n n (by omega)
    have h_aeval :=
      ((h_level n hn).1 (u : L) (u_seq n : L) hu_nonneg (hu_seq_nonneg n)).mpr h_mod α hα
    rw [lubinTateFrob_unit_mul_chosenUniformizer_apply_isLubinTateRoot F L u hu_val n α hα,
      h_aeval,
      ← lubinTateFrob_unit_mul_chosenUniformizer_apply_isLubinTateRoot F L
        (u_seq n) (hu_seq_val n) n α hα,
      hu_seq_apply n hn α hα]
  
  refine ⟨u, hu_val, ?_⟩
  change (rawRecMap F L u)⁻¹ * τ ∈
    (L ⊔ IntermediateField.adjoin F
      {α : AlgebraicClosure F | ∃ n : ℕ, isLubinTateRoot F L π n α}).fixingSubgroup
  rw [IntermediateField.fixingSubgroup_sup, Subgroup.mem_inf]
  refine ⟨Subgroup.mul_mem _
    (Subgroup.inv_mem _ (rawRecMap_actsAsFrobPow_and_mem_relWeil F L u).1.2) hτ, ?_⟩
  rw [IntermediateField.mem_fixingSubgroup_iff]
  intro z hz
  induction hz using IntermediateField.adjoin_induction with
  | mem α hα =>
    obtain ⟨n, hn_root⟩ := hα
    change (rawRecMap F L u).symm (τ α) = α
    rw [AlgEquiv.symm_apply_eq]
    rcases Nat.eq_zero_or_pos n with rfl | hn_pos
    · have hα0 : α = 0 := hn_root
      rw [hα0, map_zero, map_zero]
    · have h_frob_inv : (lubinTateFrob F L π)⁻¹ α = α := by
        change (lubinTateFrob F L π).symm α = α
        rw [AlgEquiv.symm_apply_eq]
        exact (hfix_π hn_root).symm
      have hraw_u : rawRecMap F L u α = lubinTateFrob F L (u * π) α := by
        unfold rawRecMap
        rw [hu_val]
        have h1 : (1 - (0 : ℤ) : ℤ) = 1 := rfl
        have h2 : ((0 : ℤ) - 1 : ℤ) = -1 := rfl
        rw [h1, h2, zpow_one, zpow_neg_one, AlgEquiv.mul_apply, h_frob_inv]
      rw [hraw_u, hu_apply n hn_pos α hn_root]
  | algebraMap a => exact AlgEquiv.commutes _ a
  | add a b _ _ ha hb => rw [map_add, ha, hb]
  | mul a b _ _ ha hb => rw [map_mul, ha, hb]
  | inv a _ ha => rw [map_inv₀, ha]

theorem normLM_comp (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L M E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F E] (hLM : L ≤ M) (hME : M ≤ E) (z : E) :
    normLM F (hLM.trans hME) z = normLM F hLM (normLM F hME z) :=
by
  letI : Algebra L M := (IntermediateField.inclusion hLM).toRingHom.toAlgebra
  letI : SMul L M := Algebra.toSMul
  letI : Module L M := Algebra.toModule
  letI : Algebra M E := (IntermediateField.inclusion hME).toRingHom.toAlgebra
  letI : SMul M E := Algebra.toSMul
  letI : Module M E := Algebra.toModule
  letI : Algebra L E := (IntermediateField.inclusion (hLM.trans hME)).toRingHom.toAlgebra
  letI : SMul L E := Algebra.toSMul
  letI : Module L E := Algebra.toModule
  haveI : IsScalarTower L M E :=
    IsScalarTower.of_algebraMap_eq (R := L) (S := M) (A := E) (fun _ => rfl)
  haveI : Module.Free L M := Module.Free.of_divisionRing L M
  haveI : Module.Free M E := Module.Free.of_divisionRing M E
  let eLM : M ≃ₐ[L] IntermediateField.extendScalars hLM := {
    toFun := toExtendScalars F hLM
    invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLM).mp y.2⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl
    map_mul' := fun _ _ => rfl
    map_add' := fun _ _ => rfl
    commutes' := fun _ => rfl
  }
  let eME : E ≃ₐ[M] IntermediateField.extendScalars hME := {
    toFun := toExtendScalars F hME
    invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hME).mp y.2⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl
    map_mul' := fun _ _ => rfl
    map_add' := fun _ _ => rfl
    commutes' := fun _ => rfl
  }
  let eLE : E ≃ₐ[L] IntermediateField.extendScalars (hLM.trans hME) := {
    toFun := toExtendScalars F (hLM.trans hME)
    invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars (hLM.trans hME)).mp y.2⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl
    map_mul' := fun _ _ => rfl
    map_add' := fun _ _ => rfl
    commutes' := fun _ => rfl
  }
  calc normLM F (hLM.trans hME) z
    _ = Algebra.norm L (eLE z) := rfl
    _ = Algebra.norm L z := Algebra.norm_eq_of_algEquiv eLE z
    _ = Algebra.norm L (Algebra.norm M z) := (Algebra.norm_norm (R := L) (S := M) (a := z)).symm
    _ = Algebra.norm L (eLM (Algebra.norm M z)) := (Algebra.norm_eq_of_algEquiv eLM _).symm
    _ = Algebra.norm L (eLM (Algebra.norm M (eME z))) := by rw [Algebra.norm_eq_of_algEquiv eME z]
    _ = normLM F hLM (normLM F hME z) := rfl

theorem valL_normLM_sub_one_ge_of_valL_sub_one_ge (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (h : L ≤ M)
    (m : ℕ) :
    1 ≤ m → ∀ (v : Mˣ),
      ((v : M) = 1 ∨ ((m * Module.finrank F M : ℕ) : ℤ) ≤ valL F M ((v : M) - 1)) →
      ((Units.map (normLM F h) v : Lˣ) : L) = 1 ∨
        (m : ℤ) ≤ valL F L (((Units.map (normLM F h) v : Lˣ) : L) - 1) :=
by
  have h_shifted_gen_norm : ∀ (A₁ Ω : Type u) [Field A₁] [Field Ω] [Algebra A₁ Ω]
      (B : IntermediateField A₁ Ω) (π_n : Ω)
      (hB : B = IntermediateField.adjoin A₁ {π_n}) (G : Polynomial A₁) (hG_monic : G.Monic)
      (hG_deg : G.natDegree = Module.finrank A₁ B) (hG_aeval : Polynomial.aeval π_n G = 0)
      (y : A₁) (π_B : B) (hπ_B : (π_B : Ω) = π_n),
      Algebra.norm A₁ (π_B - algebraMap A₁ B y) =
        (-1 : A₁) ^ (Module.finrank A₁ B) * G.eval y := by
    clear! F L M h m
    intro A₁ Ω _ _ _ B π_n hB G hG_monic hG_deg hG_aeval y π_B hπ_B
    set α_y : Ω := π_n - algebraMap A₁ Ω y
    have h_adj_eq : IntermediateField.adjoin A₁ ({α_y} : Set Ω) = B := by
      rw [hB]
      apply le_antisymm
      · rw [IntermediateField.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        exact sub_mem (IntermediateField.mem_adjoin_simple_self A₁ π_n)
          (IntermediateField.algebraMap_mem _ y)
      · rw [IntermediateField.adjoin_le_iff]
        intro z hz
        rw [Set.mem_singleton_iff.mp hz]
        have h_eq : π_n = α_y + algebraMap A₁ Ω y := (sub_add_cancel π_n (algebraMap A₁ Ω y)).symm
        rw [h_eq]
        exact add_mem (IntermediateField.mem_adjoin_simple_self A₁ α_y)
          (IntermediateField.algebraMap_mem _ y)
    set G_y : Polynomial A₁ := G.comp (Polynomial.X + Polynomial.C y)
    have hGy_monic : G_y.Monic :=
      hG_monic.comp (Polynomial.monic_X_add_C y) (by rw [Polynomial.natDegree_X_add_C]; omega)
    have hGy_deg : G_y.natDegree = Module.finrank A₁ B := by
      dsimp [G_y]
      rw [Polynomial.natDegree_comp, hG_deg, Polynomial.natDegree_X_add_C, mul_one]
    have hGy_aeval_Ω : Polynomial.aeval α_y G_y = 0 := by
      dsimp [G_y, α_y]
      rw [Polynomial.aeval_comp, map_add, Polynomial.aeval_X, Polynomial.aeval_C,
        sub_add_cancel, hG_aeval]
    have h_int : IsIntegral A₁ α_y :=
      ⟨G_y, hGy_monic, Polynomial.aeval_def α_y G_y ▸ hGy_aeval_Ω⟩
    let pb₀ : PowerBasis A₁ ↥(IntermediateField.adjoin A₁ ({α_y} : Set Ω)) :=
      IntermediateField.adjoin.powerBasis h_int
    let pb : PowerBasis A₁ B := pb₀.map (IntermediateField.equivOfEq h_adj_eq)
    have h_gen_coe : (pb.gen : Ω) = α_y := by
      change (pb₀.gen : Ω) = α_y
      rw [IntermediateField.adjoin.powerBasis_gen h_int]
      rfl
    have h_gen_eq : pb.gen = π_B - algebraMap A₁ B y := by
      apply Subtype.ext
      change (pb.gen : Ω) = (π_B : Ω) - algebraMap A₁ Ω y
      rw [h_gen_coe, hπ_B]
    have hGy_aeval : Polynomial.aeval pb.gen G_y = 0 := by
      apply Subtype.ext
      change B.val (Polynomial.aeval pb.gen G_y) = 0
      rw [← Polynomial.aeval_algHom_apply B.val]
      change Polynomial.aeval (pb.gen : Ω) G_y = 0
      rw [h_gen_coe]
      exact hGy_aeval_Ω
    have h_int_gen : IsIntegral A₁ pb.gen :=
      ⟨G_y, hGy_monic, Polynomial.aeval_def pb.gen G_y ▸ hGy_aeval⟩
    have h_dvd : minpoly A₁ pb.gen ∣ G_y := minpoly.dvd A₁ pb.gen hGy_aeval
    have h_min_monic : (minpoly A₁ pb.gen).Monic := minpoly.monic h_int_gen
    have h_min_deg : (minpoly A₁ pb.gen).natDegree = Module.finrank A₁ B := by
      rw [PowerBasis.natDegree_minpoly pb, ← pb.finrank]
    have h_min_eq : minpoly A₁ pb.gen = G_y :=
      (Polynomial.eq_of_monic_of_dvd_of_natDegree_le h_min_monic hGy_monic h_dvd
        (by rw [hGy_deg, h_min_deg])).symm
    have h_coeff0 : G_y.coeff 0 = G.eval y := by
      dsimp [G_y]
      rw [Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_comp, Polynomial.eval_add,
        Polynomial.eval_X, Polynomial.eval_C, zero_add]
    rw [← h_gen_eq, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, h_min_eq, h_coeff0,
      ← pb.finrank]
  intro hm v hv
  by_cases hv1 : (v : M) = 1
  · left
    change normLM F h (v : M) = 1
    rw [hv1, map_one]
  have hval_y : ((m * Module.finrank F M : ℕ) : ℤ) ≤ valL F M ((v : M) - 1) :=
    hv.resolve_left hv1
  have hy_ne : (v : M) - 1 ≠ 0 := sub_ne_zero.mpr hv1
  haveI : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion h).injective
  have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
      0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
    intro a ha
    unfold addVal
    rw [dif_neg ha]
    set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    set va := valuation F a
    have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
    constructor
    · intro h_nonneg
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
      have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
      have h_iso : iso va ≤ iso 1 := by
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
        exact WithZero.coe_le_coe.mpr h_unzero
      exact (map_le_map_iff iso).mp h_iso
    · intro h_le
      have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
      rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
      have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
        Multiplicative.toAdd_le.mpr h_iso
      omega
  have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
      addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h0 := addVal_mul h1 h1
    rw [mul_one] at h0
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u₀ => Multiplicative.ofAdd (addVal F u₀)
      map_one' := by simp [addVal_one]
      map_mul' := fun u₀ v₀ => by simp [addVal_mul u₀.ne_zero v₀.ne_zero, ofAdd_add] }
  have relVal_units_mul : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K]
      (u₀ v₀ : Kˣ), relVal F K ((u₀ * v₀ : Kˣ) : K) = relVal F K u₀ + relVal F K v₀ := by
    intro K _ u₀ v₀
    let relValHom : Kˣ →* Multiplicative ℤ := addValHom.comp (Units.map (Algebra.norm F))
    have h_app : ∀ w : Kˣ, Multiplicative.toAdd (relValHom w) = relVal F K w := fun _ => rfl
    rw [← h_app, map_mul, toAdd_mul, h_app, h_app]
  have relVal_units_zpow : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K]
      (u₀ : Kˣ) (k : ℤ), relVal F K ((u₀ ^ k : Kˣ) : K) = k * relVal F K u₀ := by
    intro K _ u₀ k
    let relValHom : Kˣ →* Multiplicative ℤ := addValHom.comp (Units.map (Algebra.norm F))
    have h_app : ∀ w : Kˣ, Multiplicative.toAdd (relValHom w) = relVal F K w := fun _ => rfl
    rw [← h_app, map_zpow, toAdd_zpow, h_app, zsmul_eq_mul]
    rfl
  have relVal_mul : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K]
      {x z : K} (hx : x ≠ 0) (hz : z ≠ 0),
      relVal F K (x * z) = relVal F K x + relVal F K z :=
    fun K _ _ _ hx hz => relVal_units_mul K (Units.mk0 _ hx) (Units.mk0 _ hz)
  have relVal_div : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K]
      {x z : K} (hx : x ≠ 0) (hz : z ≠ 0),
      relVal F K (x / z) = relVal F K x - relVal F K z := by
    intro K _ x z hx hz
    have hxz : x / z ≠ 0 := div_ne_zero hx hz
    have h0 := relVal_mul K hxz hz
    rw [div_mul_cancel₀ _ hz] at h0
    omega
  have relVal_pow : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K]
      {x : K} (hx : x ≠ 0) (k : ℕ),
      relVal F K (x ^ k) = (k : ℤ) * relVal F K x := by
    intro K _ x hx k
    change relVal F K (((Units.mk0 x hx ^ (k : ℤ) : Kˣ) : K)) = (k : ℤ) * relVal F K (Units.mk0 x hx)
    exact relVal_units_zpow K (Units.mk0 x hx) k
  have exists_addVal_eq_one : ∃ uF : Fˣ, addVal F uF = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_props : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K],
      0 < resDeg F K ∧ resDeg F K ≤ Module.finrank F K ∧
      (∃ π : Kˣ, relVal F K π = resDeg F K) ∧
      (∀ u₀ : Kˣ, relVal F K u₀ = (resDeg F K : ℤ) * valL F K u₀) := by
    intro K _
    obtain ⟨uF, hu_val⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : K, z ≠ 0 ∧ relVal F K z = k}
    have hfin_mem : Module.finrank F K ∈ S := by
      refine ⟨Module.finrank_pos, algebraMap F K uF,
        (map_ne_zero (algebraMap F K)).mpr uF.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F K (uF : F)) = (uF : F) ^ Module.finrank F K :=
        Algebra.norm_algebraMap (uF : F)
      have hpow : addVal F ((uF : F) ^ Module.finrank F K) =
          (Module.finrank F K : ℤ) * addVal F uF := by
        change Multiplicative.toAdd (addValHom (uF ^ Module.finrank F K)) = _
        rw [map_pow, toAdd_pow, nsmul_eq_mul]
        rfl
      rw [relVal, hnorm, hpow, hu_val, mul_one]
    have hS : S.Nonempty := ⟨Module.finrank F K, hfin_mem⟩
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    have hle_fin : resDeg F K ≤ Module.finrank F K := Nat.sInf_le hfin_mem
    let π_ex : Kˣ := Units.mk0 z hz0
    have hπ_ex : relVal F K π_ex = resDeg F K := hrel
    refine ⟨hpos, hle_fin, ⟨π_ex, hπ_ex⟩, ?_⟩
    intro u₀
    let q₀ := relVal F K u₀ / (resDeg F K : ℤ)
    let r₀ := relVal F K u₀ % (resDeg F K : ℤ)
    have hdiv : r₀ + (resDeg F K : ℤ) * q₀ = relVal F K u₀ := Int.emod_add_mul_ediv _ _
    have hr0 : 0 ≤ r₀ := Int.emod_nonneg _ (by positivity)
    have hrlt : r₀ < (resDeg F K : ℤ) := Int.emod_lt_of_pos _ (by positivity)
    have hy_rem : relVal F K ((u₀ * π_ex ^ (-q₀) : Kˣ) : K) = r₀ := by
      rw [relVal_units_mul K, relVal_units_zpow K, hπ_ex]
      linarith
    have hr_eq : r₀ = 0 := by
      by_contra hr_ne
      have hr_pos : 0 < r₀.toNat := Int.pos_iff_toNat_pos.mp (lt_of_le_of_ne hr0 (Ne.symm hr_ne))
      have hmem : r₀.toNat ∈ S := by
        refine ⟨hr_pos, ((u₀ * π_ex ^ (-q₀) : Kˣ) : K), Units.ne_zero _, ?_⟩
        rw [hy_rem, Int.toNat_of_nonneg hr0]
      have hle : resDeg F K ≤ r₀.toNat := Nat.sInf_le hmem
      omega
    change relVal F K u₀ = (resDeg F K : ℤ) * q₀
    linarith
  obtain ⟨hfL_pos, hresL_le, ⟨π_ex, hπ_ex⟩, hrel_eq_L_units⟩ := resDeg_props L
  obtain ⟨hfM_pos, -, -, hrel_eq_M_units⟩ := resDeg_props M
  have relVal_eq_L : ∀ {x : L} (hx : x ≠ 0), relVal F L x = (resDeg F L : ℤ) * valL F L x :=
    fun hx => hrel_eq_L_units (Units.mk0 _ hx)
  have relVal_eq_M : ∀ {x : M} (hx : x ≠ 0), relVal F M x = (resDeg F M : ℤ) * valL F M x :=
    fun hx => hrel_eq_M_units (Units.mk0 _ hx)
  set πL : L := (chosenUniformizer F L : L)
  have hπL_ne : πL ≠ 0 := Units.ne_zero (chosenUniformizer F L)
  have hπ_val : valL F L πL = 1 := by
    have hf_ne : (resDeg F L : ℤ) ≠ 0 := by positivity
    have hπ_ex_val : valL F L π_ex = 1 := by
      rw [valL, hπ_ex, Int.ediv_self hf_ne]
    exact Classical.epsilon_spec (p := fun π : Lˣ => valL F L π = 1) ⟨π_ex, hπ_ex_val⟩
  have hrel_πL : relVal F L πL = (resDeg F L : ℤ) := by
    rw [relVal_eq_L hπL_ne, hπ_val, mul_one]
  letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
  haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
  haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
  letI : Valued F (ValueGroupWithZero F) :=
    IsValuativeTopology.instValuedValueGroupWithZeroOfIsUniformAddGroup
  let rlo : RankLeOneStruct F :=
    { emb := (WithZeroMulInt.toNNReal (by norm_num : (2 : NNReal) ≠ 0)).comp
        (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).toMonoidWithZeroHom
      strictMono := (WithZeroMulInt.toNNReal_strictMono (by norm_num : (1 : NNReal) < 2)).comp
        (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).strictMono }
  haveI : (Valued.v (R := F)).RankOne := Valuation.RankOne.ofRankLeOneStruct rlo
  letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
  haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F (ValueGroupWithZero F)
  have h_norm_and_int_aux : ∀ (K : Type u) [Field K] [Algebra F K] [FiniteDimensional F K] (x : K),
      IsIntegral 𝒪[F] x ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x) := by
    intro K _ _ _ x
    letI : NormedField K := spectralNorm.normedField F K
    by_cases hx0 : x = 0
    · subst hx0
      exact ⟨fun _ => Or.inl rfl, fun _ => isIntegral_zero⟩
    · have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
      have hx_int_F : IsIntegral F x := Algebra.IsIntegral.isIntegral x
      let pb : PowerBasis F (IntermediateField.adjoin F ({x} : Set K)) :=
        IntermediateField.adjoin.powerBasis hx_int_F
      have h_gen_coe : (pb.gen : K) = x := IntermediateField.AdjoinSimple.coe_gen F x
      set dK : ℕ := Module.finrank (IntermediateField.adjoin F ({x} : Set K)) K
      have h_finrank_pos : 0 < dK := Module.finrank_pos
      have h_norm_tower : Algebra.norm F x = (Algebra.norm F pb.gen) ^ dK := by
        have h1 : Algebra.norm F (pb.gen : K) = (Algebra.norm F pb.gen) ^ dK := by
          rw [← Algebra.norm_norm (R := F) (S := IntermediateField.adjoin F ({x} : Set K))
            (A := K) (a := (pb.gen : K)), ← map_pow]
          congr 1
          exact Algebra.norm_algebraMap (L := K) pb.gen
        rwa [h_gen_coe] at h1
      have h_norm_pb : Algebra.norm F pb.gen =
          (-1) ^ pb.dim * (minpoly F pb.gen).coeff 0 :=
        Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb
      have h_minpoly_eq : minpoly F pb.gen = minpoly F x := by
        have h1 : minpoly F pb.gen = minpoly F (pb.gen : K) :=
          (minpoly.algHom_eq
            (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K)))
            (IntermediateField.val (IntermediateField.adjoin F ({x} : Set K))).injective
            pb.gen).symm
        rwa [h_gen_coe] at h1
      have h_norm_coeff_pow : ‖Algebra.norm F x‖ =
          ‖(minpoly F x).coeff 0‖ ^ dK := by
        rw [h_norm_tower, h_norm_pb, h_minpoly_eq, norm_pow, norm_mul, norm_pow,
          norm_neg, norm_one, one_pow, one_mul]
      rw [or_iff_right hx0]
      constructor
      · intro hx_int
        have hnorm_int : IsIntegral 𝒪[F] (Algebra.norm F x) := Algebra.isIntegral_norm F hx_int
        have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
          (Valuation.Integers.isIntegral_iff_v_le_one
            (Valuation.integer.integers (valuation F))).mp hnorm_int
        exact (addVal_nonneg_iff_val_le_one hnorm0).mpr hval_le
      · intro h_rel
        have h_val_le : valuation F (Algebra.norm F x) ≤ 1 :=
          (addVal_nonneg_iff_val_le_one hnorm0).mp h_rel
        have h_norm_le : ‖Algebra.norm F x‖ ≤ 1 :=
          Valued.toNormedField.norm_le_one_iff.mpr h_val_le
        have h_coeff0_le : ‖(minpoly F x).coeff 0‖ ≤ 1 := by
          rw [h_norm_coeff_pow] at h_norm_le
          exact (pow_le_one_iff_of_nonneg (norm_nonneg _) h_finrank_pos.ne').mp h_norm_le
        have h_spec_le : spectralValue (minpoly F x) ≤ 1 := by
          change spectralNorm F K x ≤ 1
          rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow F K x]
          exact Real.rpow_le_one (norm_nonneg _) h_coeff0_le (by positivity)
        have h_all_coeffs : ∀ k : ℕ, ‖(minpoly F x).coeff k‖ ≤ 1 :=
          (spectralValue_le_one_iff (minpoly.monic hx_int_F)).mp h_spec_le
        have h_lifts : minpoly F x ∈ Polynomial.lifts (algebraMap 𝒪[F] F) := by
          rw [Polynomial.lifts_iff_coeff_lifts]
          intro k
          have hv : valuation F ((minpoly F x).coeff k) ≤ 1 :=
            Valued.toNormedField.norm_le_one_iff.mp (h_all_coeffs k)
          exact ⟨⟨(minpoly F x).coeff k, hv⟩, rfl⟩
        obtain ⟨P₀, hP₀_map, -, hP₀_monic⟩ :=
          Polynomial.lifts_and_degree_eq_and_monic h_lifts (minpoly.monic hx_int_F)
        refine ⟨P₀, hP₀_monic, ?_⟩
        have h_eval : Polynomial.aeval x (P₀.map (algebraMap 𝒪[F] F)) = 0 := by
          rw [hP₀_map]
          exact minpoly.aeval F x
        rwa [Polynomial.aeval_map_algebraMap] at h_eval
  have isIntegral_iff_relVal : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K]
      (x : K), IsIntegral 𝒪[F] x ↔ x = 0 ∨ 0 ≤ relVal F K x :=
    fun K _ x => h_norm_and_int_aux K x
  set c : L := πL ^ m
  have hc_ne : c ≠ 0 := pow_ne_zero m hπL_ne
  have hrel_c : relVal F L c = (m : ℤ) * (resDeg F L : ℤ) := by
    rw [relVal_pow L hπL_ne m, hrel_πL]
  have hc_int : IsIntegral 𝒪[F] c := by
    rw [isIntegral_iff_relVal L c, hrel_c]
    exact Or.inr (by positivity)
  letI : Algebra L M := (IntermediateField.inclusion h).toRingHom.toAlgebra
  letI : SMul L M := Algebra.toSMul
  letI : Module L M := Algebra.toModule
  haveI : IsScalarTower F L M :=
    IsScalarTower.of_algebraMap_eq (R := F) (S := L) (A := M) (fun _ => rfl)
  haveI : Module.Free F L := Module.Free.of_divisionRing F L
  haveI : Module.Free L M := Module.Free.of_divisionRing L M
  haveI : FiniteDimensional L M := FiniteDimensional.right F L M
  set c_M : M := algebraMap L M c
  have hcM_ne : c_M ≠ 0 := (map_ne_zero (algebraMap L M)).mpr hc_ne
  have hnorm_cM : Algebra.norm F c_M = (Algebra.norm F c) ^ Module.finrank L M := by
    rw [← Algebra.norm_norm (R := F) (S := L) (A := M) (a := c_M),
      Algebra.norm_algebraMap (L := M) c, map_pow]
  have hrel_cM : relVal F M c_M = (Module.finrank L M : ℤ) * relVal F L c := by
    unfold relVal
    rw [hnorm_cM]
    let uc : Fˣ := Units.mk0 (Algebra.norm F c) ((Algebra.norm_ne_zero_iff).mpr hc_ne)
    change Multiplicative.toAdd (addValHom (uc ^ Module.finrank L M)) =
      (Module.finrank L M : ℤ) * Multiplicative.toAdd (addValHom uc)
    rw [map_pow, toAdd_pow, nsmul_eq_mul]
  have hfin_tower : Module.finrank F L * Module.finrank L M = Module.finrank F M :=
    Module.finrank_mul_finrank F L M
  have hrel_cM_le : relVal F M c_M ≤ ((m * Module.finrank F M : ℕ) : ℤ) := by
    rw [hrel_cM, hrel_c]
    have h1 : resDeg F L * Module.finrank L M ≤ Module.finrank F M := by
      rw [← hfin_tower]
      exact Nat.mul_le_mul_right (Module.finrank L M) hresL_le
    have h2 : m * (resDeg F L * Module.finrank L M) ≤ m * Module.finrank F M :=
      Nat.mul_le_mul_left m h1
    have h3 : ((m * (resDeg F L * Module.finrank L M) : ℕ) : ℤ) ≤
        ((m * Module.finrank F M : ℕ) : ℤ) := by exact_mod_cast h2
    have h4 : (Module.finrank L M : ℤ) * ((m : ℤ) * (resDeg F L : ℤ)) =
        ((m * (resDeg F L * Module.finrank L M) : ℕ) : ℤ) := by
      push_cast
      ring
    linarith
  set y : M := (v : M) - 1
  have hrel_y_ge : ((m * Module.finrank F M : ℕ) : ℤ) ≤ relVal F M y := by
    rw [relVal_eq_M hy_ne]
    have h1 : (1 : ℤ) ≤ (resDeg F M : ℤ) := by omega
    have h2 : (0 : ℤ) ≤ valL F M y := by omega
    nlinarith
  set z : M := y / c_M
  have hz_ne : z ≠ 0 := div_ne_zero hy_ne hcM_ne
  have hrel_z_nonneg : 0 ≤ relVal F M z := by
    rw [relVal_div M hy_ne hcM_ne]
    linarith
  have hz_int : IsIntegral 𝒪[F] z :=
    (isIntegral_iff_relVal M z).mpr (Or.inr hrel_z_nonneg)
  have hv_eq : (v : M) = 1 + c_M * z := by
    dsimp [z, y]
    rw [mul_div_cancel₀ _ hcM_ne, add_sub_cancel]
  set E : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars h
  let eLE : M ≃ₐ[L] E := {
    toFun := toExtendScalars F h
    invFun := fun w => ⟨w.1, (IntermediateField.mem_extendScalars h).mp w.2⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl
    map_mul' := fun _ _ => rfl
    map_add' := fun _ _ => rfl
    commutes' := fun _ => rfl
  }
  haveI : FiniteDimensional L E := Module.Finite.equiv eLE.toLinearEquiv
  set z_tilde : E := toExtendScalars F h z
  have hv_ext : toExtendScalars F h (v : M) = 1 + algebraMap L E c * z_tilde := by
    change eLE (v : M) = 1 + algebraMap L E c * eLE z
    rw [hv_eq, map_add, map_one, map_mul, AlgEquiv.commutes]
  have h_norm_one_add_mul : ∀ (K₁ K₂ : Type u) [Field K₁] [Field K₂] [Algebra K₁ K₂]
      [FiniteDimensional K₁ K₂] (c₀ : K₁) (hc₀_ne : c₀ ≠ 0) (w₀ : K₂),
      let P₀ : Polynomial K₁ := minpoly K₁ w₀
      ∃ e : ℕ, Algebra.norm K₁ (1 + algebraMap K₁ K₂ c₀ * w₀) =
        ((-c₀) ^ P₀.natDegree * P₀.eval (-c₀⁻¹)) ^ e := by
    clear! F L M h m
    intro K₁ K₂ _ _ _ _ c₀ hc₀_ne w₀ P₀
    set A : IntermediateField K₁ K₂ := IntermediateField.adjoin K₁ ({w₀} : Set K₂)
    set d : ℕ := Module.finrank K₁ A
    set e : ℕ := Module.finrank A K₂
    let w_A : A := ⟨w₀, IntermediateField.mem_adjoin_simple_self K₁ w₀⟩
    have hw_int : IsIntegral K₁ w₀ := Algebra.IsIntegral.isIntegral w₀
    have hP₀_monic : P₀.Monic := minpoly.monic hw_int
    have hP₀_deg : P₀.natDegree = Module.finrank K₁ A :=
      (IntermediateField.adjoin.finrank hw_int).symm
    have hP₀_aeval : Polynomial.aeval w₀ P₀ = 0 := minpoly.aeval K₁ w₀
    have h_norm_shift : Algebra.norm K₁ (w_A - algebraMap K₁ A (-c₀⁻¹)) =
        (-1 : K₁) ^ d * P₀.eval (-c₀⁻¹) :=
      h_shifted_gen_norm K₁ K₂ A w₀ rfl P₀ hP₀_monic hP₀_deg hP₀_aeval (-c₀⁻¹) w_A rfl
    have h_lin_A : 1 + algebraMap K₁ A c₀ * w_A =
        algebraMap K₁ A c₀ * (w_A - algebraMap K₁ A (-c₀⁻¹)) := by
      have h1 : c₀ * (-c₀⁻¹) = -1 := by
        rw [mul_neg, mul_inv_cancel₀ hc₀_ne]
      calc 1 + algebraMap K₁ A c₀ * w_A
        _ = algebraMap K₁ A c₀ * w_A - algebraMap K₁ A (-1) := by
          rw [map_neg, map_one, sub_neg_eq_add, add_comm]
        _ = algebraMap K₁ A c₀ * w_A - algebraMap K₁ A (c₀ * (-c₀⁻¹)) := by rw [h1]
        _ = algebraMap K₁ A c₀ * (w_A - algebraMap K₁ A (-c₀⁻¹)) := by
          rw [map_mul, mul_sub]
    have h_norm_A : Algebra.norm K₁ (1 + algebraMap K₁ A c₀ * w_A) =
        (-c₀) ^ P₀.natDegree * P₀.eval (-c₀⁻¹) := by
      rw [h_lin_A, map_mul, Algebra.norm_algebraMap, h_norm_shift, hP₀_deg]
      change c₀ ^ d * ((-1 : K₁) ^ d * P₀.eval (-c₀⁻¹)) = (-c₀) ^ d * P₀.eval (-c₀⁻¹)
      rw [← mul_assoc, ← mul_pow, mul_neg_one]
    have h_coe_AE : algebraMap A K₂ (1 + algebraMap K₁ A c₀ * w_A) =
        1 + algebraMap K₁ K₂ c₀ * w₀ := rfl
    refine ⟨e, ?_⟩
    rw [← h_coe_AE, ← Algebra.norm_norm (R := K₁) (S := A) (A := K₂),
      Algebra.norm_algebraMap, map_pow, h_norm_A]
  set P : Polynomial L := minpoly L z_tilde
  set d : ℕ := P.natDegree
  have hz_tilde_int_L : IsIntegral L z_tilde := Algebra.IsIntegral.isIntegral z_tilde
  have hP_monic : P.Monic := minpoly.monic hz_tilde_int_L
  obtain ⟨e, h_norm_E_aux⟩ := h_norm_one_add_mul L E c hc_ne z_tilde
  have h_norm_E : normLM F h (v : M) = ((-c) ^ d * P.eval (-c⁻¹)) ^ e := by
    change Algebra.norm L (toExtendScalars F h (v : M)) = _
    rw [hv_ext]
    exact h_norm_E_aux
  set cbar : AlgebraicClosure F := algebraMap L (AlgebraicClosure F) c
  have hcbar_ne : cbar ≠ 0 := (map_ne_zero (algebraMap L (AlgebraicClosure F))).mpr hc_ne
  haveI : IsScalarTower 𝒪[F] L (AlgebraicClosure F) :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hcbar_int : IsIntegral 𝒪[F] cbar :=
    IsIntegral.map (IsScalarTower.toAlgHom 𝒪[F] L (AlgebraicClosure F)) hc_int
  set S : Multiset (AlgebraicClosure F) := P.aroots (AlgebraicClosure F)
  have hP_unit : IsUnit P.leadingCoeff := by
    rw [hP_monic.leadingCoeff]
    exact isUnit_one
  have hS_card : S.card = d :=
    IsAlgClosed.card_aroots_eq_natDegree_of_isUnit_leadingCoeff hP_unit
  have h_aeval_P : algebraMap L (AlgebraicClosure F) (P.eval (-c⁻¹)) =
      (S.map (fun r => -cbar⁻¹ - r)).prod := by
    have h1 : algebraMap L (AlgebraicClosure F) (P.eval (-c⁻¹)) =
        Polynomial.aeval (-cbar⁻¹) P := by
      change algebraMap L (AlgebraicClosure F) (Polynomial.aeval (-c⁻¹) P) =
        Polynomial.aeval (-cbar⁻¹) P
      rw [← Polynomial.aeval_algebraMap_apply, map_neg, map_inv₀]
    rw [h1]
    exact Polynomial.Splits.aeval_eq_prod_aroots_of_monic
      (IsAlgClosed.splits_codomain P) hP_monic (-cbar⁻¹)
  have h_multiset_scale : ∀ (T : Multiset (AlgebraicClosure F)),
      (-cbar) ^ T.card * (T.map (fun r => -cbar⁻¹ - r)).prod =
        (T.map (fun r => 1 + cbar * r)).prod := by
    intro T
    induction T using Multiset.induction_on with
    | empty => simp
    | cons a T ih =>
      rw [Multiset.card_cons, pow_succ', Multiset.map_cons, Multiset.prod_cons,
        Multiset.map_cons, Multiset.prod_cons]
      calc (-cbar) * (-cbar) ^ T.card * ((-cbar⁻¹ - a) * (T.map (fun r => -cbar⁻¹ - r)).prod)
        _ = ((-cbar) * (-cbar⁻¹ - a)) * ((-cbar) ^ T.card * (T.map (fun r => -cbar⁻¹ - r)).prod) := by ring
        _ = (1 + cbar * a) * (T.map (fun r => 1 + cbar * r)).prod := by
          rw [ih]
          congr 1
          have hinv : cbar * cbar⁻¹ = 1 := mul_inv_cancel₀ hcbar_ne
          calc (-cbar) * (-cbar⁻¹ - a) = cbar * cbar⁻¹ + cbar * a := by ring
            _ = 1 + cbar * a := by rw [hinv]
  have h_base_eq : algebraMap L (AlgebraicClosure F) ((-c) ^ d * P.eval (-c⁻¹)) =
      (S.map (fun r => 1 + cbar * r)).prod := by
    rw [map_mul, map_pow, map_neg, ← hS_card, h_aeval_P]
    exact h_multiset_scale S
  have hS_int : ∀ r ∈ S, IsIntegral 𝒪[F] r := by
    obtain ⟨Q, hQ_monic, hQ_eval⟩ := hz_int
    have hQ_z_tilde : Polynomial.aeval z_tilde (Q.map (algebraMap 𝒪[F] L)) = 0 := by
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      have h_comp : (algebraMap L E).comp (algebraMap 𝒪[F] L) =
          (toExtendScalars F h).comp (algebraMap 𝒪[F] M) := RingHom.ext fun _ => rfl
      rw [h_comp, ← Polynomial.hom_eval₂ Q (algebraMap 𝒪[F] M) (toExtendScalars F h) z,
        hQ_eval, map_zero]
    have h_dvd : P ∣ Q.map (algebraMap 𝒪[F] L) := minpoly.dvd L z_tilde hQ_z_tilde
    intro r hr
    have hr_root : Polynomial.aeval r P = 0 := (Polynomial.mem_aroots.mp hr).2
    have hr_Q_L : Polynomial.aeval r (Q.map (algebraMap 𝒪[F] L)) = 0 :=
      Polynomial.aeval_eq_zero_of_dvd_aeval_eq_zero h_dvd hr_root
    rw [Polynomial.aeval_map_algebraMap] at hr_Q_L
    exact ⟨Q, hQ_monic, hr_Q_L⟩
  have h_prod_int : ∀ (T : Multiset (AlgebraicClosure F)),
      (∀ r ∈ T, IsIntegral 𝒪[F] r) →
      ∃ w : AlgebraicClosure F, IsIntegral 𝒪[F] w ∧
        (T.map (fun r => 1 + cbar * r)).prod = 1 + cbar * w := by
    intro T
    induction T using Multiset.induction_on with
    | empty =>
      intro _
      exact ⟨0, isIntegral_zero, by simp⟩
    | cons a T ih =>
      intro hT
      have ha : IsIntegral 𝒪[F] a := hT a (Multiset.mem_cons_self a T)
      obtain ⟨w, hw_int, hw_eq⟩ := ih (fun r hr => hT r (Multiset.mem_cons_of_mem hr))
      refine ⟨a + w + cbar * a * w,
        IsIntegral.add (IsIntegral.add ha hw_int) (IsIntegral.mul (IsIntegral.mul hcbar_int ha) hw_int),
        ?_⟩
      rw [Multiset.map_cons, Multiset.prod_cons, hw_eq]
      ring
  obtain ⟨w₀, hw₀_int, hw₀_eq⟩ := h_prod_int S hS_int
  have h_pow_int : ∀ (k : ℕ), ∃ w : AlgebraicClosure F, IsIntegral 𝒪[F] w ∧
      (1 + cbar * w₀) ^ k = 1 + cbar * w := by
    intro k
    induction k with
    | zero => exact ⟨0, isIntegral_zero, by simp⟩
    | succ k ih =>
      obtain ⟨w, hw_int, hw_eq⟩ := ih
      refine ⟨w + w₀ + cbar * w * w₀,
        IsIntegral.add (IsIntegral.add hw_int hw₀_int)
          (IsIntegral.mul (IsIntegral.mul hcbar_int hw_int) hw₀_int),
        ?_⟩
      rw [pow_succ, hw_eq]
      ring
  obtain ⟨w_e, hw_e_int, hw_e_eq⟩ := h_pow_int e
  set u_L : L := ((Units.map (normLM F h) v : Lˣ) : L)
  have hu_L_eq : u_L = normLM F h (v : M) := rfl
  have hu_L_bar : algebraMap L (AlgebraicClosure F) u_L = 1 + cbar * w_e := by
    rw [hu_L_eq, h_norm_E, map_pow, h_base_eq, hw₀_eq, hw_e_eq]
  have h_quo_bar : algebraMap L (AlgebraicClosure F) ((u_L - 1) / c) = w_e := by
    rw [map_div₀, map_sub, map_one, hu_L_bar]
    change ((1 + cbar * w_e) - 1) / cbar = w_e
    rw [add_sub_cancel_left, mul_div_cancel_left₀ w_e hcbar_ne]
  have h_quo_int_bar : IsIntegral 𝒪[F] (algebraMap L (AlgebraicClosure F) ((u_L - 1) / c)) := by
    rw [h_quo_bar]
    exact hw_e_int
  have h_quo_int : IsIntegral 𝒪[F] ((u_L - 1) / c) :=
    (isIntegral_algebraMap_iff L.val.injective).mp h_quo_int_bar
  by_cases huL1 : u_L = 1
  · exact Or.inl huL1
  · right
    have hsub_ne : u_L - 1 ≠ 0 := sub_ne_zero.mpr huL1
    have hdiv_ne : (u_L - 1) / c ≠ 0 := div_ne_zero hsub_ne hc_ne
    have hrel_div_nonneg : 0 ≤ relVal F L ((u_L - 1) / c) :=
      ((isIntegral_iff_relVal L ((u_L - 1) / c)).mp h_quo_int).resolve_left hdiv_ne
    rw [relVal_div L hsub_ne hc_ne, relVal_eq_L hsub_ne, hrel_c] at hrel_div_nonneg
    have h_mul_nonneg : 0 ≤ (resDeg F L : ℤ) * (valL F L (u_L - 1) - (m : ℤ)) := by
      linarith
    have h_diff_nonneg : 0 ≤ valL F L (u_L - 1) - (m : ℤ) :=
      nonneg_of_mul_nonneg_right h_mul_nonneg (by positivity)
    omega

theorem exists_pow_qL_sub_one_eq_one_and_valL_sub_one_of_valL_eq_zero (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K] (v : Kˣ) :
    valL F K (v : K) = 0 →
    ∃ (ζ u : Kˣ), (ζ : K) ^ (qL F K - 1) = 1 ∧
      ((u : K) = 1 ∨ 1 ≤ valL F K ((u : K) - 1)) ∧ v = ζ * u :=
by
  intro hv
  let ϖ : Kˣ := chosenUniformizer F K
  let π_K : K := (ϖ : K)
  let q_K : ℕ := qL F K
  let v₀ : K := (v : K)
  have hπ_val : valL F K π_K = 1 := (valL_chosenUniformizer_and_mul_zpow F K 1).1
  have hπ_ne : π_K ≠ 0 := ϖ.ne_zero
  have hv₀_ne : v₀ ≠ 0 := v.ne_zero
  have hf_ne : (resDeg F K : ℤ) ≠ 0 := by
    intro h0
    have h1 : valL F K π_K = 1 := hπ_val
    rw [valL, h0, Int.ediv_zero] at h1
    omega
  have hres_ne : resDeg F K ≠ 0 := by omega
  have hf_pos : 0 < resDeg F K := by omega
  have hf_pos_int : 0 < (resDeg F K : ℤ) := by omega
  haveI : Finite 𝓀[F] :=
    IsNonarchimedeanLocalField.instFiniteResidueFieldSubtypeMemSubringIntegerValueGroupWithZeroValuation F
  letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  haveI : CharP 𝓀[F] (p F) := ringChar.charP 𝓀[F]
  obtain ⟨d_p, hp_prime, hcard_p⟩ := FiniteField.card 𝓀[F] (p F)
  let e_p : ℕ := (d_p : ℕ) * resDeg F K
  have he_p_pos : 1 ≤ e_p := Nat.mul_pos d_p.2 hf_pos
  have hq_K_eq : q_K = (p F) ^ e_p := by
    dsimp [q_K, qL, q, e_p]
    rw [Nat.card_eq_fintype_card, hcard_p, ← pow_mul]
  have hq_K_two : 2 ≤ q_K := by
    rw [hq_K_eq]
    calc 2 = 2 ^ 1 := (pow_one 2).symm
      _ ≤ (p F) ^ 1 := Nat.pow_le_pow_left hp_prime.two_le 1
      _ ≤ (p F) ^ e_p := Nat.pow_le_pow_right hp_prime.pos he_p_pos
  have hp_dvd_qK : p F ∣ q_K := by
    rw [hq_K_eq]
    exact dvd_pow_self (p F) (by omega)
  have h_relVal_eq : ∀ x : Kˣ, relVal F K x = (resDeg F K : ℤ) * valL F K x :=
    relVal_eq_resDeg_mul_valL F K
  have h_int_iff : ∀ z : K, IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ relVal F K z :=
    isIntegral_iff_eq_zero_or_relVal_nonneg F K
  have h_fermat_and_p := isIntegral_pow_qL_sub_and_p_div_chosenUniformizer F K
  have addVal_mul : ∀ {x y : F}, x ≠ 0 → y ≠ 0 → addVal F (x * y) = addVal F x + addVal F y := by
    intro x y hx hy
    have hxy : x * y ≠ 0 := mul_ne_zero hx hy
    simp only [addVal, hx, hy, hxy, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u w => by simp [addVal_mul u.ne_zero w.ne_zero, ofAdd_add] }
  let relValHom : Kˣ →* Multiplicative ℤ :=
    addValHom.comp (Units.map (Algebra.norm F))
  have relValHom_apply : ∀ u : Kˣ, Multiplicative.toAdd (relValHom u) = relVal F K u :=
    fun _ => rfl
  have relVal_units_mul : ∀ u w : Kˣ,
      relVal F K ((u * w : Kˣ) : K) = relVal F K u + relVal F K w := by
    intro u w
    rw [← relValHom_apply, map_mul, toAdd_mul, relValHom_apply, relValHom_apply]
  have relVal_units_zpow : ∀ (u : Kˣ) (m : ℤ),
      relVal F K ((u ^ m : Kˣ) : K) = m * relVal F K u := by
    intro u m
    rw [← relValHom_apply, map_zpow, toAdd_zpow, relValHom_apply, zsmul_eq_mul]
    rfl
  have valL_units_mul : ∀ u w : Kˣ,
      valL F K ((u * w : Kˣ) : K) = valL F K u + valL F K w := by
    intro u w
    have hrel := h_relVal_eq (u * w)
    rw [relVal_units_mul, h_relVal_eq u, h_relVal_eq w] at hrel
    apply mul_left_cancel₀ hf_ne
    linarith
  have valL_units_zpow : ∀ (u : Kˣ) (m : ℤ),
      valL F K ((u ^ m : Kˣ) : K) = m * valL F K u := by
    intro u m
    have hrel := h_relVal_eq (u ^ m)
    rw [relVal_units_zpow, h_relVal_eq u] at hrel
    apply mul_left_cancel₀ hf_ne
    linarith
  have valL_div : ∀ {x y : K} (hx : x ≠ 0) (hy : y ≠ 0),
      valL F K (x / y) = valL F K x - valL F K y := by
    intro x y hx hy
    let ux : Kˣ := Units.mk0 x hx
    let uy : Kˣ := Units.mk0 y hy
    have hxy : x / y = ((ux * uy ^ (-1 : ℤ) : Kˣ) : K) := by
      simp [ux, uy, div_eq_mul_inv]
    rw [hxy, valL_units_mul, valL_units_zpow]
    change valL F K x + (-1 : ℤ) * valL F K y = valL F K x - valL F K y
    ring
  have valL_pi_pow : ∀ m : ℕ, valL F K (π_K ^ m) = (m : ℤ) := by
    intro m
    have hpow : π_K ^ m = ((ϖ ^ (m : ℤ) : Kˣ) : K) := by simp [π_K]
    rw [hpow, valL_units_zpow, hπ_val, mul_one]
  have valL_one : valL F K 1 = 0 := by simpa using valL_pi_pow 0
  have mem_int_iff : ∀ z : K, IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ valL F K z := by
    intro z
    rw [h_int_iff z]
    rcases eq_or_ne z 0 with rfl | hz
    · simp
    · have hrel := h_relVal_eq (Units.mk0 z hz)
      change relVal F K z = (resDeg F K : ℤ) * valL F K z at hrel
      rw [or_iff_right hz, or_iff_right hz, hrel, mul_nonneg_iff_of_pos_left hf_pos_int]
  let V : ℕ → K → Prop := fun m x => x = 0 ∨ (m : ℤ) ≤ valL F K x
  have V_iff_int : ∀ (m : ℕ) (x : K), V m x ↔ IsIntegral 𝒪[F] (x / π_K ^ m) := by
    intro m x
    rw [mem_int_iff]
    rcases eq_or_ne x 0 with rfl | hx
    · simp [V]
    · have hpow_ne : π_K ^ m ≠ 0 := pow_ne_zero m hπ_ne
      have hdiv_ne : x / π_K ^ m ≠ 0 := div_ne_zero hx hpow_ne
      dsimp [V]
      rw [or_iff_right hx, or_iff_right hdiv_ne, valL_div hx hpow_ne, valL_pi_pow m]
      omega
  have V_zero : ∀ m : ℕ, V m 0 := fun _ => Or.inl rfl
  have V_one : V 0 1 := by
    rw [V_iff_int, pow_zero, div_one]
    exact isIntegral_one
  have V_natCast : ∀ k : ℕ, V 0 (k : K) := by
    intro k
    rw [V_iff_int, pow_zero, div_one]
    exact (integralClosure 𝒪[F] K).natCast_mem k
  have V_mono : ∀ {m₁ m₂ : ℕ}, m₁ ≤ m₂ → ∀ {a : K}, V m₂ a → V m₁ a := by
    intro m₁ m₂ hle a ha
    rcases ha with rfl | ha
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have V_add : ∀ {m : ℕ} {a b : K}, V m a → V m b → V m (a + b) := by
    intro m a b ha hb
    rw [V_iff_int, add_div]
    exact IsIntegral.add ((V_iff_int m a).mp ha) ((V_iff_int m b).mp hb)
  have V_sub : ∀ {m : ℕ} {a b : K}, V m a → V m b → V m (a - b) := by
    intro m a b ha hb
    rw [V_iff_int, sub_div]
    exact IsIntegral.sub ((V_iff_int m a).mp ha) ((V_iff_int m b).mp hb)
  have V_neg : ∀ {m : ℕ} {a : K}, V m a → V m (-a) := by
    intro m a ha
    have h := V_sub (V_zero m) ha
    rwa [zero_sub] at h
  have V_mul : ∀ {m₁ m₂ : ℕ} {a b : K}, V m₁ a → V m₂ b → V (m₁ + m₂) (a * b) := by
    intro m₁ m₂ a b ha hb
    rw [V_iff_int, pow_add, ← div_mul_div_comm]
    exact IsIntegral.mul ((V_iff_int m₁ a).mp ha) ((V_iff_int m₂ b).mp hb)
  have V_mul_zero_right : ∀ {m : ℕ} {a b : K}, V m a → V 0 b → V m (a * b) := by
    intro m a b ha hb
    simpa using V_mul ha hb
  have V_mul_zero_left : ∀ {m : ℕ} {a b : K}, V 0 a → V m b → V m (a * b) := by
    intro m a b ha hb
    simpa [Nat.zero_add] using V_mul ha hb
  have V_pow : ∀ {a : K}, V 0 a → ∀ e : ℕ, V 0 (a ^ e) := by
    intro a ha e
    induction e with
    | zero =>
      rw [pow_zero]
      exact V_one
    | succ e ih =>
      rw [pow_succ]
      exact V_mul_zero_right ih ha
  have V_sum : ∀ (m : ℕ) (s : Finset ℕ) (g : ℕ → K),
      (∀ i ∈ s, V m (g i)) → V m (∑ i ∈ s, g i) := by
    intro m s g hg
    induction s using Finset.cons_induction with
    | empty => exact V_zero m
    | cons x s hx ih =>
      rw [Finset.sum_cons]
      exact V_add (hg x (Finset.mem_cons_self x s))
        (ih fun i hi => hg i (Finset.mem_cons.mpr (Or.inr hi)))
  have eq_of_forall_V_sub : ∀ {a b : K}, (∀ m : ℕ, V m (a - b)) → a = b := by
    intro a b h
    by_contra hne
    have hsub : a - b ≠ 0 := sub_ne_zero.mpr hne
    let m : ℕ := (valL F K (a - b) + 1).toNat
    rcases h m with h0 | hle
    · exact hsub h0
    · omega
  have hp_V1 : V 1 (p F : K) := by
    rw [V_iff_int, pow_one]
    exact h_fermat_and_p.2
  have hq_V1 : V 1 (q_K : K) := by
    obtain ⟨c_q, hc_q⟩ := hp_dvd_qK
    have h_cast : (q_K : K) = (p F : K) * (c_q : K) := by
      rw [hc_q, Nat.cast_mul]
    rw [h_cast]
    exact V_mul_zero_right hp_V1 (V_natCast c_q)
  have h_fermat : ∀ {c : K}, V 0 c → V 1 (c ^ q_K - c) := by
    intro c hc
    have hc_int : IsIntegral 𝒪[F] c := by
      have h := (V_iff_int 0 c).mp hc
      rwa [pow_zero, div_one] at h
    rw [V_iff_int, pow_one]
    exact h_fermat_and_p.1 c hc_int
  have h_boost : ∀ {a b : K} {k : ℕ}, 1 ≤ k →
      V 0 a → V 0 b → V k (a - b) → V (k + 1) (a ^ q_K - b ^ q_K) := by
    intro a b k hk ha hb hab
    let S₂ : K :=
      ∑ j ∈ Finset.range q_K, (∑ i ∈ Finset.range j, a ^ i * b ^ (j - 1 - i)) * b ^ (q_K - 1 - j)
    have hS₂_V0 : V 0 S₂ := by
      refine V_sum 0 (Finset.range q_K) _ fun j _ => V_mul_zero_right ?_ (V_pow hb _)
      exact V_sum 0 (Finset.range j) _ fun i _ => V_mul_zero_right (V_pow ha i) (V_pow hb _)
    have h_geom2 : a ^ q_K - b ^ q_K =
        (q_K : K) * b ^ (q_K - 1) * (a - b) + S₂ * (a - b) * (a - b) := by
      have h1 : a ^ q_K - b ^ q_K = (∑ j ∈ Finset.range q_K, a ^ j * b ^ (q_K - 1 - j)) * (a - b) :=
        (geom_sum₂_mul a b q_K).symm
      have h2 : ∑ j ∈ Finset.range q_K, a ^ j * b ^ (q_K - 1 - j) =
          (q_K : K) * b ^ (q_K - 1) + S₂ * (a - b) := by
        have h_const : (q_K : K) * b ^ (q_K - 1) =
            ∑ _j ∈ Finset.range q_K, b ^ (q_K - 1) := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
        rw [h_const, Finset.sum_mul, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun j hj => ?_
        have hj_lt : j < q_K := Finset.mem_range.mp hj
        have h_bpow : b ^ (q_K - 1) = b ^ j * b ^ (q_K - 1 - j) := by
          rw [← pow_add, Nat.add_sub_of_le (by omega)]
        have h_j : (∑ i ∈ Finset.range j, a ^ i * b ^ (j - 1 - i)) * (a - b) = a ^ j - b ^ j :=
          geom_sum₂_mul a b j
        calc a ^ j * b ^ (q_K - 1 - j)
            = b ^ j * b ^ (q_K - 1 - j) + (a ^ j - b ^ j) * b ^ (q_K - 1 - j) := by ring
          _ = b ^ (q_K - 1) + ((∑ i ∈ Finset.range j, a ^ i * b ^ (j - 1 - i)) * (a - b)) *
                b ^ (q_K - 1 - j) := by rw [← h_bpow, ← h_j]
          _ = b ^ (q_K - 1) + (∑ i ∈ Finset.range j, a ^ i * b ^ (j - 1 - i)) *
                b ^ (q_K - 1 - j) * (a - b) := by ring
      rw [h1, h2]
      ring
    rw [h_geom2]
    have h_term1 : V (k + 1) ((q_K : K) * b ^ (q_K - 1) * (a - b)) := by
      have h_qb : V 1 ((q_K : K) * b ^ (q_K - 1)) :=
        V_mul_zero_right hq_V1 (V_pow hb (q_K - 1))
      have h_prod := V_mul h_qb hab
      rwa [Nat.add_comm 1 k] at h_prod
    have h_term2 : V (k + 1) (S₂ * (a - b) * (a - b)) := by
      have h_S_ab : V k (S₂ * (a - b)) := V_mul_zero_left hS₂_V0 hab
      exact V_mul h_S_ab (V_mono hk hab)
    exact V_add h_term1 h_term2
  have hv₀_val : valL F K v₀ = 0 := hv
  have hv₀_V0 : V 0 v₀ := Or.inr (by omega)
  have hv₀_fermat : V 1 (v₀ ^ q_K - v₀) := h_fermat hv₀_V0
  let y : ℕ → K := fun r => ((fun x : K => x ^ q_K)^[r] v₀)
  have hy_zero : y 0 = v₀ := rfl
  have hy_succ : ∀ r : ℕ, y (r + 1) = (y r) ^ q_K :=
    fun r => Function.iterate_succ_apply' (fun x : K => x ^ q_K) r v₀
  have hy_props : ∀ r : ℕ, V 0 (y r) ∧ V 1 (y r - v₀) ∧ V (r + 1) (y (r + 1) - y r) := by
    intro r
    induction r with
    | zero =>
      rw [hy_zero, hy_succ 0, hy_zero, sub_self]
      exact ⟨hv₀_V0, V_zero 1, hv₀_fermat⟩
    | succ r ih =>
      rcases ih with ⟨hy_V0, hy_diff, hy_step⟩
      have hy_next_V0 : V 0 (y (r + 1)) := by
        rw [hy_succ r]
        exact V_pow hy_V0 q_K
      have hy_next_diff : V 1 (y (r + 1) - v₀) := by
        have h_split : y (r + 1) - v₀ = (y (r + 1) - y r) + (y r - v₀) := by ring
        rw [h_split]
        exact V_add (V_mono (by omega : 1 ≤ r + 1) hy_step) hy_diff
      have hy_next_step : V (r + 1 + 1) (y (r + 1 + 1) - y (r + 1)) := by
        have h_step2 : y (r + 1 + 1) - y (r + 1) = (y (r + 1)) ^ q_K - (y r) ^ q_K :=
          congrArg₂ (· - ·) (hy_succ (r + 1)) (hy_succ r)
        rw [h_step2]
        exact h_boost (by omega : 1 ≤ r + 1) hy_next_V0 hy_V0 hy_step
      exact ⟨hy_next_V0, hy_next_diff, hy_next_step⟩
  have hy_cauchy_step : ∀ (k r : ℕ), V (r + 1) (y (r + k) - y r) := by
    intro k
    induction k with
    | zero =>
      intro r
      change V (r + 1) (y r - y r)
      rw [sub_self]
      exact V_zero (r + 1)
    | succ k ih =>
      intro r
      have h_split : y (r + (k + 1)) - y r = (y (r + k) - y r) + (y (r + k + 1) - y (r + k)) := by
        rw [← Nat.add_assoc]
        ring
      rw [h_split]
      exact V_add (ih r) (V_mono (by omega : r + 1 ≤ r + k + 1) (hy_props (r + k)).2.2)
  obtain ⟨z, hz_lim⟩ := exists_valL_cauchy_limit F K 1 zero_lt_one y
    (fun m r k hmr => V_mono (by omega : m ≤ r + 1) (hy_cauchy_step k r))
  have hz_r : ∀ r : ℕ, V r (z - y r) := fun r => hz_lim r r (by omega)
  have hz_V0 : V 0 z := by
    have h_eq : z = (z - y 0) + v₀ := by rw [hy_zero]; ring
    rw [h_eq]
    exact V_add (hz_r 0) hv₀_V0
  have hv₀_z : V 1 (v₀ - z) := by
    have h_eq : v₀ - z = -((z - y 1) + (y 1 - v₀)) := by ring
    rw [h_eq]
    exact V_neg (V_add (hz_r 1) (hy_props 1).2.1)
  have hz_pow : z ^ q_K = z := by
    apply eq_of_forall_V_sub
    intro m
    let r : ℕ := m + 1
    have h_eq : z ^ q_K - z = (z ^ q_K - (y r) ^ q_K) + (y (r + 1) - y r) - (z - y r) := by
      rw [hy_succ r]
      ring
    rw [h_eq]
    have h1 : V (r + 1) (z ^ q_K - (y r) ^ q_K) :=
      h_boost (by omega : 1 ≤ r) hz_V0 (hy_props r).1 (hz_r r)
    have h2 : V (r + 1) (y (r + 1) - y r) := (hy_props r).2.2
    have h3 : V r (z - y r) := hz_r r
    exact V_mono (by omega : m ≤ r)
      (V_sub (V_add (V_mono (by omega : r ≤ r + 1) h1) (V_mono (by omega : r ≤ r + 1) h2)) h3)
  have hz_ne : z ≠ 0 := by
    intro hz0
    have hv₀_V1 : V 1 v₀ := by simpa [hz0] using hv₀_z
    rcases hv₀_V1 with h0 | hle
    · exact hv₀_ne h0
    · omega
  let ζ : Kˣ := Units.mk0 z hz_ne
  let u : Kˣ := ζ⁻¹ * v
  have hζ_coe : (ζ : K) = z := rfl
  have hζ_pow1 : (ζ : K) ^ (q_K - 1) = 1 := by
    rw [hζ_coe]
    have h_mul : z * (z ^ (q_K - 1) - 1) = 0 := by
      calc z * (z ^ (q_K - 1) - 1) = z ^ 1 * z ^ (q_K - 1) - z := by ring
        _ = z ^ (1 + (q_K - 1)) - z := by rw [← pow_add]
        _ = z ^ q_K - z := by congr 2; omega
        _ = 0 := sub_eq_zero.mpr hz_pow
    exact sub_eq_zero.mp ((mul_eq_zero.mp h_mul).resolve_left hz_ne)
  have hv_eq : v = ζ * u := (mul_inv_cancel_left ζ v).symm
  have hζ_inv_eq : ((ζ⁻¹ : Kˣ) : K) = z ^ (q_K - 2) := by
    apply mul_left_cancel₀ hz_ne
    have h_lhs : z * ((ζ⁻¹ : Kˣ) : K) = 1 := by
      change (ζ : K) * ((ζ⁻¹ : Kˣ) : K) = 1
      exact Units.mul_inv ζ
    have h_rhs : z * z ^ (q_K - 2) = 1 := by
      calc z * z ^ (q_K - 2) = z ^ 1 * z ^ (q_K - 2) := by rw [pow_one]
        _ = z ^ (1 + (q_K - 2)) := (pow_add _ _ _).symm
        _ = z ^ (q_K - 1) := by congr 1; omega
        _ = 1 := hζ_pow1
    rw [h_lhs, h_rhs]
  have hζ_inv_V0 : V 0 ((ζ⁻¹ : Kˣ) : K) := by
    rw [hζ_inv_eq]
    exact V_pow hz_V0 (q_K - 2)
  have hu_sub_one_V1 : V 1 ((u : K) - 1) := by
    have h_eq : (u : K) - 1 = ((ζ⁻¹ : Kˣ) : K) * (v₀ - z) := by
      have h1 : ((ζ⁻¹ : Kˣ) : K) * z = 1 := by
        change ((ζ⁻¹ : Kˣ) : K) * (ζ : K) = 1
        exact Units.inv_mul ζ
      have h2 : (u : K) = ((ζ⁻¹ : Kˣ) : K) * v₀ := Units.val_mul ζ⁻¹ v
      rw [h2, ← h1, ← mul_sub]
    rw [h_eq]
    exact V_mul_zero_left hζ_inv_V0 hv₀_z
  refine ⟨ζ, u, hζ_pow1, ?_, hv_eq⟩
  dsimp [V] at hu_sub_one_V1
  rwa [sub_eq_zero] at hu_sub_one_V1

theorem exists_norm_unramifiedLevelField_eq_of_pow_qL_sub_one_eq_one (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K] (m : ℕ) :
    1 ≤ m → ∀ (ζ : K), ζ ^ (qL F K - 1) = 1 →
      ∃ ξ : unramifiedLevelField F K (qL F K ^ m - 1), Algebra.norm K ξ = ζ :=
by
  intro hm ζ hζ
  set N := qL F K ^ m - 1
  set U := unramifiedLevelField F K N
  have hϖ : valL F K (chosenUniformizer F K) = 1 :=
    (valL_chosenUniformizer_and_mul_zpow F K 1).1
  have hres_ne : resDeg F K ≠ 0 := by
    intro h0
    unfold valL at hϖ
    rw [h0, Nat.cast_zero, Int.ediv_zero] at hϖ
    omega
  have hresK_pos : 0 < resDeg F K := Nat.pos_of_ne_zero hres_ne
  haveI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  haveI : CharP 𝓀[F] (p F) := by unfold p; infer_instance
  obtain ⟨d_F, hp, hq⟩ := FiniteField.card 𝓀[F] (p F)
  have hq' : q F = p F ^ (d_F : ℕ) := by
    rw [q, Nat.card_eq_fintype_card, hq]
  have hp_ge_two : 2 ≤ p F := hp.two_le
  have hqK_ge_two : 2 ≤ qL F K := by
    dsimp [qL]
    rw [hq', ← pow_mul]
    have hpos : 0 < (d_F : ℕ) * resDeg F K := Nat.mul_pos d_F.pos hresK_pos
    calc 2 = 2 ^ 1 := by ring
      _ ≤ 2 ^ ((d_F : ℕ) * resDeg F K) := Nat.pow_le_pow_right (by omega) hpos
      _ ≤ p F ^ ((d_F : ℕ) * resDeg F K) := Nat.pow_le_pow_left hp_ge_two _
  have hqKm_ge_two : 2 ≤ qL F K ^ m := by
    calc 2 = 2 ^ 1 := by ring
      _ ≤ 2 ^ m := Nat.pow_le_pow_right (by omega) hm
      _ ≤ qL F K ^ m := Nat.pow_le_pow_left hqK_ge_two m
  have hN_pos : 0 < N := by omega
  have hpN : ¬ p F ∣ N := by
    intro hdvd
    have hdvd_pow : p F ∣ qL F K ^ m := by
      dsimp [qL]
      rw [hq', ← pow_mul, ← pow_mul]
      have hk_pos : 0 < (d_F : ℕ) * (resDeg F K * m) :=
        Nat.mul_pos d_F.pos (Nat.mul_pos hresK_pos (by omega))
      exact dvd_pow_self (p F) hk_pos.ne'
    have hdvd_one : p F ∣ 1 := by
      have hsub := Nat.dvd_sub hdvd_pow hdvd
      have heq : qL F K ^ m - N = 1 := by omega
      rwa [heq] at hsub
    exact hp.not_dvd_one hdvd_one
  obtain ⟨hGal, hFinU, hB⟩ := unramifiedLevelField_isGalois_and_resDeg F K N hN_pos hpN
  haveI : IsGalois K U := hGal
  haveI : FiniteDimensional K U := hFinU
  haveI : Fintype (U ≃ₐ[K] U) := Fintype.ofFinite (U ≃ₐ[K] U)
  obtain ⟨τ, hτK, hτFrob⟩ := exists_actsAsFrobPow_neg_resDeg F K
  have hτK_fix : ∀ x ∈ K, τ x = x := by
    rwa [IntermediateField.mem_fixingSubgroup_iff] at hτK
  let τ_K : AlgebraicClosure F ≃ₐ[K] AlgebraicClosure F :=
    { τ.toRingEquiv with
      commutes' := fun x => hτK_fix x.1 x.2 }
  let ϕ_τ : U ≃ₐ[K] U := AlgEquiv.restrictNormalHom U τ_K
  have h_ϕ_apply : ∀ x : U, ((ϕ_τ x : U) : AlgebraicClosure F) = τ (x : AlgebraicClosure F) := by
    intro x
    exact AlgEquiv.restrictNormal_commutes τ_K U x
  have h_ϕ_pow : ∀ (i : ℕ) (x : U),
      (((ϕ_τ ^ i) x : U) : AlgebraicClosure F) = (τ ^ i) (x : AlgebraicClosure F) := by
    intro i
    induction i with
    | zero => intro x; rfl
    | succ i ih =>
      intro x
      rw [pow_succ', pow_succ', AlgEquiv.mul_apply, AlgEquiv.mul_apply, h_ϕ_apply, ih]
  obtain ⟨ζ₀, hζ_U, _hζ_m, hζ_ne⟩ :=
    exists_root_unramDegSubfield_pow_apply_eq_and_ne F K m hm τ hτFrob
  have h_unram_le_U : unramDegSubfield F K m ≤ U.restrictScalars F := by
    change K ⊔ IntermediateField.adjoin F {ζ' : AlgebraicClosure F | ζ' ^ N = 1} ≤ U.restrictScalars F
    apply sup_le
    · intro x hx
      rw [IntermediateField.mem_restrictScalars]
      exact U.algebraMap_mem ⟨x, hx⟩
    · rw [IntermediateField.adjoin_le_iff]
      intro ζ' hζ'
      exact (IntermediateField.mem_restrictScalars F).mpr
        (IntermediateField.subset_adjoin K _ hζ')
  have hζ₀_mem_U : ζ₀ ∈ U := by
    have h0 := hζ_U 0
    rw [pow_zero, AlgEquiv.one_apply] at h0
    exact (IntermediateField.mem_restrictScalars F).mp (h_unram_le_U h0)
  let z_root : U := ⟨ζ₀, hζ₀_mem_U⟩
  have h_ϕ_pow_ne_one : ∀ j : ℕ, 1 ≤ j → j < m → ϕ_τ ^ j ≠ 1 := by
    intro j hj1 hj2 h_eq
    have h1 := congr_arg (fun g : U ≃ₐ[K] U => ((g z_root : U) : AlgebraicClosure F)) h_eq
    dsimp only at h1
    rw [h_ϕ_pow j z_root] at h1
    exact hζ_ne j hj1 hj2 h1
  let f_pow : Fin m → (U ≃ₐ[K] U) := fun i => ϕ_τ ^ (i : ℕ)
  have hf_inj : Function.Injective f_pow := by
    intro i₁ i₂ hf
    dsimp [f_pow] at hf
    rcases lt_trichotomy (i₁ : ℕ) (i₂ : ℕ) with hlt | heq | hgt
    · exfalso
      have h_add : (i₁ : ℕ) + ((i₂ : ℕ) - (i₁ : ℕ)) = (i₂ : ℕ) := Nat.add_sub_of_le hlt.le
      have h_mul : ϕ_τ ^ (i₁ : ℕ) * ϕ_τ ^ ((i₂ : ℕ) - (i₁ : ℕ)) = ϕ_τ ^ (i₁ : ℕ) * 1 := by
        rw [← pow_add, h_add, mul_one, hf]
      have h_one : ϕ_τ ^ ((i₂ : ℕ) - (i₁ : ℕ)) = 1 := mul_left_cancel h_mul
      exact h_ϕ_pow_ne_one ((i₂ : ℕ) - (i₁ : ℕ)) (by omega) (by omega) h_one
    · exact Fin.ext heq
    · exfalso
      have h_add : (i₂ : ℕ) + ((i₁ : ℕ) - (i₂ : ℕ)) = (i₁ : ℕ) := Nat.add_sub_of_le hgt.le
      have h_mul : ϕ_τ ^ (i₂ : ℕ) * ϕ_τ ^ ((i₁ : ℕ) - (i₂ : ℕ)) = ϕ_τ ^ (i₂ : ℕ) * 1 := by
        rw [← pow_add, h_add, mul_one, hf]
      have h_one : ϕ_τ ^ ((i₁ : ℕ) - (i₂ : ℕ)) = 1 := mul_left_cancel h_mul
      exact h_ϕ_pow_ne_one ((i₁ : ℕ) - (i₂ : ℕ)) (by omega) (by omega) h_one
  have h_τ_step : ∀ ζ' : AlgebraicClosure F, IsPrimeToPRootOfUnity F ζ' →
      (τ ζ') ^ (qL F K) = ζ' := by
    intro ζ' hζ'
    have h_eq := hτFrob ζ' hζ'
    have h_neg : (-(-(resDeg F K : ℤ))).toNat = resDeg F K := by
      rw [neg_neg, Int.toNat_natCast]
    have h_pos : (-(resDeg F K : ℤ)).toNat = 0 := by omega
    rw [h_neg, h_pos, pow_zero, pow_one] at h_eq
    exact h_eq
  have h_τ_frob_pow : ∀ (ζ' : AlgebraicClosure F), ζ' ^ N = 1 →
      ∀ k : ℕ, ((τ ^ k) ζ') ^ (qL F K ^ k) = ζ' := by
    intro ζ' hζ'N k
    induction k with
    | zero => rw [pow_zero, pow_zero, AlgEquiv.one_apply, pow_one]
    | succ k ih =>
      have h_p' : IsPrimeToPRootOfUnity F ((τ ^ k) ζ') := by
        refine ⟨N, hN_pos, hpN, ?_⟩
        rw [← map_pow, hζ'N, map_one]
      rw [pow_succ', AlgEquiv.mul_apply, pow_succ', pow_mul, h_τ_step ((τ ^ k) ζ') h_p', ih]
  have h_τm_fix_U : ∀ x ∈ U, (τ ^ m) x = x := by
    intro x hx
    induction hx using IntermediateField.adjoin_induction with
    | mem ζ' hζ' =>
      simp only [Set.mem_setOf_eq] at hζ'
      have h_m := h_τ_frob_pow ζ' hζ' m
      have h_pow_N : ((τ ^ m) ζ') ^ N = 1 := by
        rw [← map_pow, hζ', map_one]
      have hN1 : N + 1 = qL F K ^ m := by omega
      calc (τ ^ m) ζ' = ((τ ^ m) ζ') ^ N * (τ ^ m) ζ' := by rw [h_pow_N, one_mul]
        _ = ((τ ^ m) ζ') ^ (N + 1) := (pow_succ _ N).symm
        _ = ((τ ^ m) ζ') ^ (qL F K ^ m) := by rw [hN1]
        _ = ζ' := h_m
    | algebraMap r =>
      have h_pow_K : ∀ k : ℕ, (τ ^ k) (algebraMap K (AlgebraicClosure F) r) =
          algebraMap K (AlgebraicClosure F) r := by
        intro k
        induction k with
        | zero => rfl
        | succ k ih =>
          rw [pow_succ', AlgEquiv.mul_apply, ih]
          exact hτK_fix r.1 r.2
      exact h_pow_K m
    | add a b _ _ ha hb => rw [map_add, ha, hb]
    | mul a b _ _ ha hb => rw [map_mul, ha, hb]
    | inv a _ ha => rw [map_inv₀, ha]
  have h_ϕ_m : ϕ_τ ^ m = 1 := by
    ext x
    exact h_ϕ_pow m x ▸ h_τm_fix_U x.1 x.2
  let H_sub : Subgroup (U ≃ₐ[K] U) := Subgroup.zpowers ϕ_τ
  let F₀ : IntermediateField K U := IntermediateField.fixedField H_sub
  let A : IntermediateField K (AlgebraicClosure F) := F₀.map U.val
  have hA_le_U : A ≤ U := by
    rintro y ⟨x, _, rfl⟩
    exact x.2
  haveI : FiniteDimensional K A :=
    FiniteDimensional.of_injective (IntermediateField.inclusion hA_le_U).toLinearMap
      (IntermediateField.inclusion hA_le_U).injective
  haveI : FiniteDimensional F (A.restrictScalars F) := by
    change FiniteDimensional F A
    exact FiniteDimensional.trans F K A
  have hKA : K ≤ A.restrictScalars F := by
    intro x hx
    rw [IntermediateField.mem_restrictScalars]
    exact A.algebraMap_mem ⟨x, hx⟩
  have hτA : τ ∈ (A.restrictScalars F).fixingSubgroup := by
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro y hy
    rw [IntermediateField.mem_restrictScalars] at hy
    rcases hy with ⟨x, hxF₀, rfl⟩
    have hx_fix : ϕ_τ x = x := hxF₀ ⟨ϕ_τ, Subgroup.mem_zpowers ϕ_τ⟩
    have h1 := (h_ϕ_apply x).symm
    rw [hx_fix] at h1
    exact h1
  have h_resA : resDeg F (A.restrictScalars F) ≤ resDeg F K :=
    le_of_eq (resDeg_eq_of_actsAsFrobPow_neg_resDeg_and_mem_fixingSubgroup F K
      (A.restrictScalars F) hKA τ hτFrob hτA)
  have hA_bot : A = ⊥ := by
    have h_inf := inf_eq_bot_of_resDeg_le_and_finrank_mul_resDeg_le F K A U h_resA hB
    rwa [inf_of_le_left hA_le_U] at h_inf
  have hF₀_bot : F₀ = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    have hxA : (x : AlgebraicClosure F) ∈ A := ⟨x, hx, rfl⟩
    rw [hA_bot, IntermediateField.mem_bot] at hxA
    rcases hxA with ⟨c, hc⟩
    rw [IntermediateField.mem_bot]
    refine ⟨c, Subtype.ext hc⟩
  have hH_top : H_sub = ⊤ := by
    rw [← IntermediateField.fixingSubgroup_fixedField H_sub]
    change F₀.fixingSubgroup = ⊤
    rw [hF₀_bot, IntermediateField.fixingSubgroup_bot]
  have hf_surj : Function.Surjective f_pow := by
    intro g
    have hg : g ∈ H_sub := by
      rw [hH_top]
      exact Subgroup.mem_top g
    rw [Subgroup.mem_zpowers_iff] at hg
    rcases hg with ⟨r, rfl⟩
    have hm_pos_z : (0 : ℤ) < (m : ℤ) := by omega
    let i_nat : ℕ := (r % (m : ℤ)).toNat
    have hi_nonneg : 0 ≤ r % (m : ℤ) := Int.emod_nonneg r (by omega)
    have hi_lt_z : r % (m : ℤ) < (m : ℤ) := Int.emod_lt_of_pos r hm_pos_z
    have hi_cast : (i_nat : ℤ) = r % (m : ℤ) := Int.toNat_of_nonneg hi_nonneg
    have hi_lt : i_nat < m := by omega
    refine ⟨⟨i_nat, hi_lt⟩, ?_⟩
    dsimp [f_pow]
    have hr_eq : r = (m : ℤ) * (r / (m : ℤ)) + (i_nat : ℤ) := by
      rw [hi_cast]
      exact (Int.mul_ediv_add_emod r (m : ℤ)).symm
    have h_ϕ_m_z : ϕ_τ ^ (m : ℤ) = 1 := by
      rw [zpow_natCast, h_ϕ_m]
    rw [hr_eq, zpow_add, zpow_mul, h_ϕ_m_z, one_zpow, one_mul, zpow_natCast]
  let S_m : ℕ := ∑ i ∈ Finset.range m, qL F K ^ i
  have h_geom : ∀ k : ℕ, (∑ i ∈ Finset.range k, qL F K ^ i) * (qL F K - 1) + 1 = qL F K ^ k := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      rw [Finset.sum_range_succ, add_mul, add_right_comm, ih]
      calc qL F K ^ k + qL F K ^ k * (qL F K - 1)
          = qL F K ^ k * (1 + (qL F K - 1)) := by ring
        _ = qL F K ^ k * qL F K := by rw [Nat.add_sub_of_le (by omega)]
        _ = qL F K ^ (k + 1) := (pow_succ _ _).symm
  have h_geom_m := h_geom m
  have hSm_mul : S_m * (qL F K - 1) = N := by
    dsimp [S_m, N]
    omega
  have hSm_pos : 0 < S_m := by
    by_contra h0
    have hSm_zero : S_m = 0 := by omega
    rw [hSm_zero, zero_mul] at hSm_mul
    omega
  obtain ⟨ξ₀, hξ₀_pow⟩ :=
    IsAlgClosed.exists_pow_nat_eq (algebraMap K (AlgebraicClosure F) ζ) hSm_pos
  have hξ₀_N : ξ₀ ^ N = 1 := by
    rw [← hSm_mul, pow_mul, hξ₀_pow, ← map_pow, hζ, map_one]
  have hξ₀_mem : ξ₀ ∈ U := by
    exact IntermediateField.subset_adjoin K {ζ' : AlgebraicClosure F | ζ' ^ N = 1} hξ₀_N
  let ξ : U := ⟨ξ₀, hξ₀_mem⟩
  have hξ_Sm : ξ ^ S_m = algebraMap K U ζ := by
    apply Subtype.ext
    change ξ₀ ^ S_m = algebraMap K (AlgebraicClosure F) ζ
    exact hξ₀_pow
  have h_inv_pow : ∀ k : ℕ, (ϕ_τ ^ k)⁻¹ ξ = ξ ^ (qL F K ^ k) := by
    intro k
    apply (ϕ_τ ^ k).injective
    apply Subtype.ext
    have h_lhs : (ϕ_τ ^ k) ((ϕ_τ ^ k)⁻¹ ξ) = ξ := by
      rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
    rw [h_lhs, h_ϕ_pow k (ξ ^ (qL F K ^ k))]
    change ξ₀ = (τ ^ k) (ξ₀ ^ (qL F K ^ k))
    rw [map_pow]
    exact (h_τ_frob_pow ξ₀ hξ₀_N k).symm
  let e_aut : Fin m ≃ (U ≃ₐ[K] U) :=
    (Equiv.ofBijective f_pow ⟨hf_inj, hf_surj⟩).trans (Equiv.inv (U ≃ₐ[K] U))
  have h_norm_prod : algebraMap K U (Algebra.norm K ξ) = ∏ σ : U ≃ₐ[K] U, σ ξ := by
    convert Algebra.norm_eq_prod_automorphisms K ξ
  have h_norm_alg : algebraMap K U (Algebra.norm K ξ) = algebraMap K U ζ := by
    rw [h_norm_prod, ← e_aut.prod_comp (fun σ : U ≃ₐ[K] U => σ ξ)]
    have h_prod_eq : (∏ i : Fin m, (e_aut i) ξ) = ∏ i : Fin m, ξ ^ (qL F K ^ (i : ℕ)) := by
      refine Finset.prod_congr rfl (fun i _ => ?_)
      exact h_inv_pow (i : ℕ)
    rw [h_prod_eq]
    rw [Fin.prod_univ_eq_prod_range (fun i : ℕ => ξ ^ (qL F K ^ i)) m]
    rw [Finset.prod_pow_eq_pow_sum]
    exact hξ_Sm
  exact ⟨ξ, (algebraMap K U).injective h_norm_alg⟩

theorem unramifiedLevelField_isGalois_and_exists_isIntegral_trace_eq_one (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K] (m : ℕ) :
    1 ≤ m →
      IsGalois K (unramifiedLevelField F K (qL F K ^ m - 1)) ∧
      FiniteDimensional K (unramifiedLevelField F K (qL F K ^ m - 1)) ∧
      ∃ e₀ : unramifiedLevelField F K (qL F K ^ m - 1),
        IsIntegral 𝒪[F] e₀ ∧
        Algebra.trace K (unramifiedLevelField F K (qL F K ^ m - 1)) e₀ = 1 :=
by
  intro hm
  have addVal_mul : ∀ {a b : F}, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    simp only [addVal, ha, hb, hab, ↓reduceDIte]
    rw [← neg_add, neg_inj, ← toAdd_mul]
    congr 1
    rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
      WithZero.coe_unzero, ← map_mul, ← map_mul]
  have addVal_one : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have h := addVal_mul h1 h1
    rw [mul_one] at h
    omega
  let addValHom : Fˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (addVal F u)
      map_one' := by simp [addVal_one]
      map_mul' := fun u v => by simp [addVal_mul u.ne_zero v.ne_zero, ofAdd_add] }
  have addVal_pow : ∀ (u : Fˣ) (n : ℕ), addVal F ((u : F) ^ n) = (n : ℤ) * addVal F u := by
    intro u n
    change Multiplicative.toAdd (addValHom (u ^ n)) = _
    rw [map_pow, toAdd_pow, nsmul_eq_mul]
    rfl
  have exists_addVal_eq_one : ∃ u : Fˣ, addVal F u = 1 := by
    let g := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
      (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)))
    have hg : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F g =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) :=
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).apply_symm_apply _
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := F) g
    have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a) =
        WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [ha]
      exact hg
    have ha0 : a ≠ 0 := by
      intro h0
      rw [h0, map_zero, map_zero] at h1
      exact WithZero.coe_ne_zero h1.symm
    refine ⟨Units.mk0 a ha0, ?_⟩
    simp only [Units.val_mk0, addVal, ha0, ↓reduceDIte]
    have h2 : WithZero.unzero
        (x := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (valuation F a))
        (by rw [h1]; exact WithZero.coe_ne_zero) = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, h1]
    rw [h2, toAdd_ofAdd, neg_neg]
  have resDeg_mem : 0 < resDeg F K ∧ ∃ π : Kˣ, relVal F K π = resDeg F K := by
    obtain ⟨u, hu⟩ := exists_addVal_eq_one
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ z : K, z ≠ 0 ∧ relVal F K z = k}
    have hS : S.Nonempty := by
      refine ⟨Module.finrank F K, Module.finrank_pos, algebraMap F K u,
        (map_ne_zero (algebraMap F K)).mpr u.ne_zero, ?_⟩
      have hnorm : Algebra.norm F (algebraMap F K (u : F)) = (u : F) ^ Module.finrank F K :=
        Algebra.norm_algebraMap (u : F)
      rw [relVal, hnorm, addVal_pow, hu, mul_one]
    obtain ⟨hpos, z, hz0, hrel⟩ := Nat.sInf_mem hS
    exact ⟨hpos, ⟨Units.mk0 z hz0, hrel⟩⟩
  obtain ⟨hres_pos, π_K, hrel_πK⟩ := resDeg_mem
  have hπK_ne : (π_K : K) ≠ 0 := π_K.ne_zero
  have relVal_one : relVal F K 1 = 0 := by
    change addVal F (Algebra.norm F (1 : K)) = 0
    rw [map_one, addVal_one]
  have relVal_mul : ∀ {x w : K}, x ≠ 0 → w ≠ 0 → relVal F K (x * w) = relVal F K x + relVal F K w := by
    intro x w hx hw
    have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
    have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
    rw [relVal, map_mul, addVal_mul hnx hnw, ← relVal, ← relVal]
  have relVal_div : ∀ {x w : K}, x ≠ 0 → w ≠ 0 → relVal F K (x / w) = relVal F K x - relVal F K w := by
    intro x w hx hw
    have hxw : x / w ≠ 0 := div_ne_zero hx hw
    have h := relVal_mul hxw hw
    rw [div_mul_cancel₀ x hw] at h
    omega
  have relVal_inv : ∀ {x : K}, x ≠ 0 → relVal F K x⁻¹ = -relVal F K x := by
    intro x hx
    have h := relVal_mul (inv_ne_zero hx) hx
    rw [inv_mul_cancel₀ hx, relVal_one] at h
    omega
  have h_aux : ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E] (x : E),
      IsIntegral 𝒪[F] x ↔ x = 0 ∨ 0 ≤ addVal F (Algebra.norm F x) := by
    clear! K m
    intro E _ _ _ x
    have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
        0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
      intro a ha
      unfold addVal
      rw [dif_neg ha]
      set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
      set va := valuation F a
      have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
      constructor
      · intro h_nonneg
        have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
        have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
        have h_iso : iso va ≤ iso 1 := by
          rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
          exact WithZero.coe_le_coe.mpr h_unzero
        exact (map_le_map_iff iso).mp h_iso
      · intro h_le
        have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
        have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
          Multiplicative.toAdd_le.mpr h_iso
        omega
    constructor
    · intro hx
      by_cases hx0 : x = 0
      · exact Or.inl hx0
      · right
        have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
        have hnorm_int : IsIntegral 𝒪[F] (Algebra.norm F x) := Algebra.isIntegral_norm F hx
        have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
          (Valuation.Integers.isIntegral_iff_v_le_one
            (Valuation.integer.integers (valuation F))).mp hnorm_int
        exact (addVal_nonneg_iff_val_le_one hnorm0).mpr hval_le
    · rintro (rfl | h_rel)
      · exact isIntegral_zero
      · by_cases hx0 : x = 0
        · rw [hx0]
          exact isIntegral_zero
        · have hnorm0 : Algebra.norm F x ≠ 0 := (Algebra.norm_ne_zero_iff).mpr hx0
          have hval_le : valuation F (Algebra.norm F x) ≤ 1 :=
            (addVal_nonneg_iff_val_le_one hnorm0).mp h_rel
          have hx_int_F : IsIntegral F x := Algebra.IsIntegral.isIntegral x
          let pb : PowerBasis F (IntermediateField.adjoin F ({x} : Set E)) :=
            IntermediateField.adjoin.powerBasis hx_int_F
          have h_gen_coe : (pb.gen : E) = x := IntermediateField.AdjoinSimple.coe_gen F x
          set dK : ℕ := Module.finrank (IntermediateField.adjoin F ({x} : Set E)) E
          have h_finrank_pos : 0 < dK := Module.finrank_pos
          have h_norm_tower : Algebra.norm F x = (Algebra.norm F pb.gen) ^ dK := by
            have h1 : Algebra.norm F (pb.gen : E) = (Algebra.norm F pb.gen) ^ dK := by
              rw [← Algebra.norm_norm (R := F) (S := IntermediateField.adjoin F ({x} : Set E))
                (A := E) (a := (pb.gen : E)), ← map_pow]
              congr 1
              exact Algebra.norm_algebraMap (L := E) pb.gen
            rwa [h_gen_coe] at h1
          have h_norm_pb : Algebra.norm F pb.gen =
              (-1) ^ pb.dim * (minpoly F pb.gen).coeff 0 :=
            Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb
          have h_minpoly_eq : minpoly F pb.gen = minpoly F x := by
            have h1 : minpoly F pb.gen = minpoly F (pb.gen : E) :=
              (minpoly.algHom_eq
                (IntermediateField.val (IntermediateField.adjoin F ({x} : Set E)))
                (IntermediateField.val (IntermediateField.adjoin F ({x} : Set E))).injective
                pb.gen).symm
            rwa [h_gen_coe] at h1
          letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
          haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
          haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
          letI : Valued F (ValueGroupWithZero F) :=
            IsValuativeTopology.instValuedValueGroupWithZeroOfIsUniformAddGroup
          let rlo : RankLeOneStruct F :=
            { emb := (WithZeroMulInt.toNNReal (by norm_num : (2 : NNReal) ≠ 0)).comp
                (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).toMonoidWithZeroHom
              strictMono := (WithZeroMulInt.toNNReal_strictMono (by norm_num : (1 : NNReal) < 2)).comp
                (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).strictMono }
          haveI : (Valued.v (R := F)).RankOne := Valuation.RankOne.ofRankLeOneStruct rlo
          letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
          haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F (ValueGroupWithZero F)
          have hnorm_norm_le : ‖Algebra.norm F x‖ ≤ 1 :=
            Valued.toNormedField.norm_le_one_iff.mpr hval_le
          have h_norm_coeff_pow : ‖Algebra.norm F x‖ =
              ‖(minpoly F x).coeff 0‖ ^ dK := by
            rw [h_norm_tower, h_norm_pb, h_minpoly_eq, norm_pow, norm_mul, norm_pow,
              norm_neg, norm_one, one_pow, one_mul]
          have h_coeff0_le : ‖(minpoly F x).coeff 0‖ ≤ 1 := by
            rw [h_norm_coeff_pow] at hnorm_norm_le
            exact (pow_le_one_iff_of_nonneg (norm_nonneg _) h_finrank_pos.ne').mp hnorm_norm_le
          have h_spec_le : spectralValue (minpoly F x) ≤ 1 := by
            change spectralNorm F E x ≤ 1
            rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow F E x]
            exact Real.rpow_le_one (norm_nonneg _) h_coeff0_le (by positivity)
          have h_all_coeffs : ∀ n : ℕ, ‖(minpoly F x).coeff n‖ ≤ 1 :=
            (spectralValue_le_one_iff (minpoly.monic hx_int_F)).mp h_spec_le
          have h_lifts : minpoly F x ∈ Polynomial.lifts (algebraMap 𝒪[F] F) := by
            rw [Polynomial.lifts_iff_coeff_lifts]
            intro n
            have hv : valuation F ((minpoly F x).coeff n) ≤ 1 :=
              Valued.toNormedField.norm_le_one_iff.mp (h_all_coeffs n)
            exact ⟨⟨(minpoly F x).coeff n, hv⟩, rfl⟩
          obtain ⟨P₀, hP₀_map, -, hP₀_monic⟩ :=
            Polynomial.lifts_and_degree_eq_and_monic h_lifts (minpoly.monic hx_int_F)
          refine ⟨P₀, hP₀_monic, ?_⟩
          have h_eval : Polynomial.aeval x (P₀.map (algebraMap 𝒪[F] F)) = 0 := by
            rw [hP₀_map]
            exact minpoly.aeval F x
          rwa [Polynomial.aeval_map_algebraMap] at h_eval
  have hint_K : ∀ z : K, IsIntegral 𝒪[F] z ↔ z = 0 ∨ 0 ≤ relVal F K z := h_aux K
  haveI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  haveI : CharP 𝓀[F] (p F) := by unfold p; infer_instance
  obtain ⟨d, hp, hq_card⟩ := FiniteField.card 𝓀[F] (p F)
  have hq_eq : q F = (p F) ^ (d : ℕ) := by
    unfold q
    rw [Nat.card_eq_fintype_card, hq_card]
  have hqL_eq : qL F K = (p F) ^ ((d : ℕ) * resDeg F K) := by
    unfold qL
    rw [hq_eq, ← pow_mul]
  have hd_pos : 0 < (d : ℕ) := d.pos
  have hp_ge : 2 ≤ p F := hp.two_le
  have h_exp_pos : 1 ≤ (d : ℕ) * resDeg F K := Nat.mul_pos hd_pos hres_pos
  have hqL_ge : 2 ≤ qL F K := by
    rw [hqL_eq]
    calc 2 = 2 ^ 1 := (pow_one 2).symm
      _ ≤ (p F) ^ 1 := Nat.pow_le_pow_left hp_ge 1
      _ ≤ (p F) ^ ((d : ℕ) * resDeg F K) := Nat.pow_le_pow_right (by omega) h_exp_pos
  have hqLm_ge : 2 ≤ qL F K ^ m := by
    calc 2 = 2 ^ 1 := (pow_one 2).symm
      _ ≤ qL F K ^ 1 := Nat.pow_le_pow_left hqL_ge 1
      _ ≤ qL F K ^ m := Nat.pow_le_pow_right (by omega) hm
  set N : ℕ := qL F K ^ m - 1
  have hN_pos : 0 < N := by omega
  have hN_add : N + 1 = qL F K ^ m := by omega
  have hpN : ¬ p F ∣ N := by
    intro hdvd
    have h_exp_m_pos : 0 < (d : ℕ) * resDeg F K * m :=
      Nat.mul_pos (Nat.mul_pos hd_pos hres_pos) (by omega)
    have hqLm_eq : qL F K ^ m = (p F) ^ ((d : ℕ) * resDeg F K * m) := by
      rw [hqL_eq, ← pow_mul]
    have hdvd_pow : p F ∣ qL F K ^ m := by
      rw [hqLm_eq]
      exact dvd_pow_self (p F) h_exp_m_pos.ne'
    rw [← hN_add] at hdvd_pow
    exact hp.not_dvd_one ((Nat.dvd_add_right hdvd).mp hdvd_pow)
  have hN_res_ne : IsLocalRing.residue 𝒪[F] (N : 𝒪[F]) ≠ 0 := by
    rw [map_natCast]
    intro h0
    exact hpN ((ringChar.spec 𝓀[F] N).mp h0)
  have hNF : (N : F) ≠ 0 := by
    intro h0
    have h0' : (N : 𝒪[F]) = 0 := Subtype.ext (by simpa using h0)
    exact hN_res_ne (by rw [h0', map_zero])
  have hNK : (N : K) ≠ 0 := by
    intro h0
    have h0' : algebraMap F K (N : F) = 0 := by simpa using h0
    exact hNF ((RingHom.injective (algebraMap F K)) (h0'.trans (map_zero _).symm))
  set U : IntermediateField K (AlgebraicClosure F) := unramifiedLevelField F K N
  have hGalFin : IsGalois K U ∧ FiniteDimensional K U := by
    let P : Polynomial K := Polynomial.X ^ N - Polynomial.C 1
    have hP_ne : P ≠ 0 := Polynomial.X_pow_sub_C_ne_zero hN_pos (1 : K)
    have hP_sep : P.Separable := Polynomial.separable_X_pow_sub_C (1 : K) hNK one_ne_zero
    have hset : {ζ : AlgebraicClosure F | ζ ^ N = 1} = P.rootSet (AlgebraicClosure F) := by
      ext ζ
      rw [Set.mem_setOf_eq, Polynomial.mem_rootSet_of_ne hP_ne]
      simp [P, sub_eq_zero]
    have hsplit : (P.map (algebraMap K (AlgebraicClosure F))).Splits := IsAlgClosed.splits _
    have hu : U = IntermediateField.adjoin K (P.rootSet (AlgebraicClosure F)) := by
      change unramifiedLevelField F K N = _
      dsimp [unramifiedLevelField]
      rw [hset]
    rw [hu]
    haveI : Polynomial.IsSplittingField K
        (IntermediateField.adjoin K (P.rootSet (AlgebraicClosure F))) P :=
      IntermediateField.adjoin_rootSet_isSplittingField hsplit
    exact ⟨IsGalois.of_separable_splitting_field hP_sep,
      Polynomial.IsSplittingField.finiteDimensional
        (IntermediateField.adjoin K (P.rootSet (AlgebraicClosure F))) P⟩
  obtain ⟨hGal, hFin⟩ := hGalFin
  haveI : IsGalois K U := hGal
  haveI : FiniteDimensional K U := hFin
  refine ⟨hGal, hFin, ?_⟩
  have h_exists_ζ : ∃ ζ : U, ζ ^ N = 1 ∧
      (N : U) = ∑ k ∈ Finset.range N,
        algebraMap K U (Algebra.trace K U (ζ ^ k)) * (ζ⁻¹) ^ k := by
    haveI : NeZero (N : F) := ⟨hNF⟩
    haveI : HasEnoughRootsOfUnity (AlgebraicClosure F) N :=
      AlgebraicClosure.hasEnoughRootsOfUnity F N
    obtain ⟨ζ₀, hζ₀⟩ := HasEnoughRootsOfUnity.prim (M := AlgebraicClosure F) (n := N)
    have hζ₀_mem : ζ₀ ∈ U :=
      IntermediateField.subset_adjoin K {ξ : AlgebraicClosure F | ξ ^ N = 1} hζ₀.pow_eq_one
    let ζ : U := ⟨ζ₀, hζ₀_mem⟩
    have hζN : ζ ^ N = 1 := Subtype.ext hζ₀.pow_eq_one
    have hfix : ∀ σ : U ≃ₐ[K] U, σ ζ = ζ → σ = 1 := by
      intro σ hσ
      haveI : NeZero N := ⟨hN_pos.ne'⟩
      have hσ_inv : σ⁻¹ ζ = ζ := (AlgEquiv.symm_apply_eq σ).mpr hσ.symm
      have hσn : ∀ n : ℤ, (σ ^ n) ζ = ζ := by
        intro n
        induction n with
        | zero => rfl
        | succ k ih =>
          rw [zpow_add_one, AlgEquiv.mul_apply, hσ, ih]
        | pred k ih =>
          rw [zpow_sub_one, AlgEquiv.mul_apply, hσ_inv, ih]
      let K_fix : IntermediateField K (AlgebraicClosure F) :=
        (IntermediateField.fixedField (Subgroup.zpowers σ)).map U.val
      have hle : U ≤ K_fix := by
        change unramifiedLevelField F K N ≤ K_fix
        unfold unramifiedLevelField
        rw [IntermediateField.adjoin_le_iff]
        intro ξ hξ
        obtain ⟨i, -, hi⟩ := hζ₀.eq_pow_of_pow_eq_one hξ
        refine ⟨ζ ^ i, ?_, by exact_mod_cast hi⟩
        change ζ ^ i ∈ IntermediateField.fixedField (Subgroup.zpowers σ)
        rw [IntermediateField.mem_fixedField_iff]
        intro τ hτ
        obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hτ
        change (σ ^ n) (ζ ^ i) = ζ ^ i
        rw [map_pow, hσn n]
      apply AlgEquiv.ext
      intro x
      obtain ⟨z, hz, hval⟩ := hle x.2
      have hzx : z = x := Subtype.ext hval
      subst hzx
      exact hz ⟨σ, Subgroup.mem_zpowers σ⟩
    have hsum_σ : ∀ σ : U ≃ₐ[K] U,
        (∑ k ∈ Finset.range N, (σ ζ * ζ⁻¹) ^ k) =
          if σ = 1 then (N : U) else 0 := by
      intro σ
      have hζ_ne : ζ ≠ 0 := by
        intro h0
        have : (1 : U) = 0 := by
          rw [← hζN, h0, zero_pow hN_pos.ne']
        exact one_ne_zero this
      by_cases hσ1 : σ = 1
      · subst hσ1
        simp [mul_inv_cancel₀ hζ_ne]
      · rw [if_neg hσ1]
        have hne : σ ζ ≠ ζ := fun h => hσ1 (hfix σ h)
        have hr_ne : σ ζ * ζ⁻¹ ≠ 1 := by
          intro hr1
          exact hne (by simpa [mul_assoc, inv_mul_cancel₀ hζ_ne] using congr_arg (· * ζ) hr1)
        have hrN : (σ ζ * ζ⁻¹) ^ N = 1 := by
          rw [mul_pow, ← map_pow, hζN, map_one, inv_pow, hζN, inv_one, mul_one]
        have hgeom := geom_sum_mul (σ ζ * ζ⁻¹) N
        rw [hrN, sub_self] at hgeom
        exact (mul_eq_zero.mp hgeom).resolve_right (sub_ne_zero.mpr hr_ne)
    refine ⟨ζ, hζN, ?_⟩
    have h_expand : ∑ k ∈ Finset.range N,
        algebraMap K U (Algebra.trace K U (ζ ^ k)) * (ζ⁻¹) ^ k =
        ∑ σ : U ≃ₐ[K] U, (∑ k ∈ Finset.range N, (σ ζ * ζ⁻¹) ^ k) := by
      conv_lhs =>
        arg 2
        ext k
        rw [trace_eq_sum_automorphisms, Finset.sum_mul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun σ _ => ?_
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [map_pow, mul_pow]
    rw [h_expand]
    simp_rw [hsum_σ]
    rw [Finset.sum_ite_eq' Finset.univ (1 : U ≃ₐ[K] U)]
    simp
  obtain ⟨ζ, hζN, h_sum⟩ := h_exists_ζ
  have h_root_int : ∀ {ξ : U}, ξ ^ N = 1 → IsIntegral 𝒪[F] ξ := by
    intro ξ hξ
    refine ⟨Polynomial.X ^ N - Polynomial.C 1,
      Polynomial.monic_X_pow_sub_C (1 : 𝒪[F]) hN_pos.ne', ?_⟩
    simp [hξ]
  have hζ_int : IsIntegral 𝒪[F] ζ := h_root_int hζN
  have hζk_int : ∀ k : ℕ, IsIntegral 𝒪[F] (ζ ^ k) := fun k => IsIntegral.pow hζ_int k
  have hζinv_int : ∀ k : ℕ, IsIntegral 𝒪[F] ((ζ⁻¹) ^ k) := by
    intro k
    apply IsIntegral.pow
    apply h_root_int
    rw [inv_pow, hζN, inv_one]
  set b : ℕ → K := fun k => Algebra.trace K U (ζ ^ k)
  have hb_int : ∀ k : ℕ, IsIntegral 𝒪[F] (b k) := by
    intro k
    rw [← isIntegral_algebraMap_iff (algebraMap K U).injective]
    change IsIntegral 𝒪[F] (algebraMap K U (Algebra.trace K U (ζ ^ k)))
    rw [trace_eq_sum_automorphisms]
    refine (integralClosure 𝒪[F] U).sum_mem fun σ _ => ?_
    apply h_root_int
    rw [← map_pow, pow_right_comm, hζN, one_pow, map_one]
  have h_exists_unit : ∃ k ∈ Finset.range N, b k ≠ 0 ∧ IsIntegral 𝒪[F] ((b k)⁻¹) := by
    by_contra! h_no_unit
    have hb_div_int : ∀ k ∈ Finset.range N, IsIntegral 𝒪[F] (b k / (π_K : K)) := by
      intro k hk
      by_cases hbk : b k = 0
      · rw [hbk, zero_div]
        exact isIntegral_zero
      · have h_not_inv_int : ¬ IsIntegral 𝒪[F] ((b k)⁻¹) := h_no_unit k hk hbk
        have h_rel_nonneg : 0 ≤ relVal F K (b k) := by
          rcases (hint_K (b k)).mp (hb_int k) with h0 | hge
          · exact False.elim (hbk h0)
          · exact hge
        have h_rel_pos : 0 < relVal F K (b k) := by
          by_contra h_le
          have h_inv_nonneg : 0 ≤ relVal F K ((b k)⁻¹) := by
            rw [relVal_inv hbk]
            omega
          exact h_not_inv_int ((hint_K ((b k)⁻¹)).mpr (Or.inr h_inv_nonneg))
        have h_res_le_bk : (resDeg F K : ℤ) ≤ relVal F K (b k) := by
          have hpos_nat : 0 < (relVal F K (b k)).toNat :=
            Int.pos_iff_toNat_pos.mp h_rel_pos
          have hmem : (relVal F K (b k)).toNat ∈
              {n : ℕ | 0 < n ∧ ∃ z : K, z ≠ 0 ∧ relVal F K z = n} := by
            refine ⟨hpos_nat, b k, hbk, ?_⟩
            exact (Int.toNat_of_nonneg h_rel_nonneg).symm
          have hle : resDeg F K ≤ (relVal F K (b k)).toNat := Nat.sInf_le hmem
          omega
        have h_div_nonneg : 0 ≤ relVal F K (b k / (π_K : K)) := by
          rw [relVal_div hbk hπK_ne, hrel_πK]
          omega
        exact (hint_K (b k / (π_K : K))).mpr (Or.inr h_div_nonneg)
    have hN_div_U_int : IsIntegral 𝒪[F] ((N : U) / algebraMap K U (π_K : K)) := by
      rw [h_sum, Finset.sum_div]
      refine (integralClosure 𝒪[F] U).sum_mem fun k hk => ?_
      have h_term : (algebraMap K U (b k) * (ζ⁻¹) ^ k) / algebraMap K U (π_K : K) =
          algebraMap K U (b k / (π_K : K)) * (ζ⁻¹) ^ k := by
        rw [mul_div_right_comm, map_div₀]
      rw [h_term]
      exact IsIntegral.mul (IsIntegral.algebraMap (hb_div_int k hk)) (hζinv_int k)
    have hN_unit : IsUnit (N : 𝒪[F]) :=
      (IsLocalRing.residue_ne_zero_iff_isUnit (N : 𝒪[F])).mp hN_res_ne
    obtain ⟨u₀, hu₀⟩ := hN_unit
    let v₀ : U := algebraMap 𝒪[F] U (↑(u₀⁻¹) : 𝒪[F])
    have hv₀_int : IsIntegral 𝒪[F] v₀ := isIntegral_algebraMap
    have hv₀_mul_N : v₀ * (N : U) = 1 := by
      have hN_eq : (N : U) = algebraMap 𝒪[F] U (u₀ : 𝒪[F]) := by
        rw [hu₀, map_natCast]
      rw [hN_eq, ← map_mul, Units.inv_mul, map_one]
    have hπK_inv_U_int : IsIntegral 𝒪[F] (algebraMap K U ((π_K : K)⁻¹)) := by
      have hmul := IsIntegral.mul hv₀_int hN_div_U_int
      have h_eq : v₀ * ((N : U) / algebraMap K U (π_K : K)) =
          algebraMap K U ((π_K : K)⁻¹) := by
        rw [← mul_div_assoc, hv₀_mul_N, map_inv₀, one_div]
      rwa [h_eq] at hmul
    have hπK_inv_int : IsIntegral 𝒪[F] ((π_K : K)⁻¹) :=
      (isIntegral_algebraMap_iff (algebraMap K U).injective).mp hπK_inv_U_int
    have hπK_inv_ne : (π_K : K)⁻¹ ≠ 0 := inv_ne_zero hπK_ne
    have h_inv_nonneg : 0 ≤ relVal F K ((π_K : K)⁻¹) := by
      rcases (hint_K ((π_K : K)⁻¹)).mp hπK_inv_int with h0 | hge
      · exact False.elim (hπK_inv_ne h0)
      · exact hge
    rw [relVal_inv hπK_ne, hrel_πK] at h_inv_nonneg
    omega
  obtain ⟨k, -, hb_ne, hb_inv_int⟩ := h_exists_unit
  refine ⟨algebraMap K U ((b k)⁻¹) * (ζ ^ k), ?_, ?_⟩
  · exact IsIntegral.mul (IsIntegral.algebraMap hb_inv_int) (hζk_int k)
  · apply (algebraMap K U).injective
    rw [trace_eq_sum_automorphisms, map_one]
    have h_sum_tr : (∑ σ : U ≃ₐ[K] U, σ (algebraMap K U ((b k)⁻¹) * ζ ^ k)) =
        algebraMap K U ((b k)⁻¹) * ∑ σ : U ≃ₐ[K] U, σ (ζ ^ k) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun σ _ => ?_
      rw [map_mul, AlgEquiv.commutes]
    rw [h_sum_tr, ← trace_eq_sum_automorphisms]
    change algebraMap K U ((b k)⁻¹) * algebraMap K U (b k) = 1
    rw [← map_mul, inv_mul_cancel₀ hb_ne, map_one]

theorem exists_norm_eq_of_isIntegral_trace_eq_one_and_le_valL_sub_one (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K]
    (U : IntermediateField K (AlgebraicClosure F)) [IsGalois K U] [FiniteDimensional K U]
    (e₀ : U) :
    IsIntegral 𝒪[F] e₀ → Algebra.trace K U e₀ = 1 →
    ∀ (u : Kˣ), ((u : K) = 1 ∨ 1 ≤ valL F K ((u : K) - 1)) →
      ∃ w : U, Algebra.norm K w = (u : K) :=
by
  intro he₀_int he₀_tr u hu
  rcases hu with hu_one | hu_val
  · refine ⟨(1 : U), ?_⟩
    rw [map_one, hu_one]
  · have addVal_nonneg_iff_val_le_one : ∀ {a : F} (ha : a ≠ 0),
        0 ≤ addVal F a ↔ valuation F a ≤ 1 := by
      intro a ha
      unfold addVal
      rw [dif_neg ha]
      set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
      set va := valuation F a
      have hva_ne : iso va ≠ 0 := (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
      constructor
      · intro h_nonneg
        have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 := by omega
        have h_unzero : WithZero.unzero hva_ne ≤ 1 := Multiplicative.toAdd_le.mp h_toAdd
        have h_iso : iso va ≤ iso 1 := by
          rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one]
          exact WithZero.coe_le_coe.mpr h_unzero
        exact (map_le_map_iff iso).mp h_iso
      · intro h_le
        have h_iso : iso va ≤ iso 1 := (map_le_map_iff iso).mpr h_le
        rw [map_one, ← WithZero.coe_unzero hva_ne, ← WithZero.coe_one, WithZero.coe_le_coe] at h_iso
        have h_toAdd : Multiplicative.toAdd (WithZero.unzero hva_ne) ≤ 0 :=
          Multiplicative.toAdd_le.mpr h_iso
        omega
    have addVal_mul : ∀ {x y : F} (hx : x ≠ 0) (hy : y ≠ 0),
        addVal F (x * y) = addVal F x + addVal F y := by
      intro x y hx hy
      have hxy : x * y ≠ 0 := mul_ne_zero hx hy
      simp only [addVal, hx, hy, hxy, ↓reduceDIte]
      rw [← neg_add, neg_inj, ← toAdd_mul]
      congr 1
      rw [← WithZero.coe_inj, WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero,
        WithZero.coe_unzero, ← map_mul, ← map_mul]
    have addVal_one : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have h := addVal_mul h1 h1
      rw [mul_one] at h
      omega
    let addValHom : Fˣ →* Multiplicative ℤ :=
      { toFun := fun v => Multiplicative.ofAdd (addVal F v)
        map_one' := by simp [addVal_one]
        map_mul' := fun v₁ v₂ => by simp [addVal_mul v₁.ne_zero v₂.ne_zero, ofAdd_add] }
