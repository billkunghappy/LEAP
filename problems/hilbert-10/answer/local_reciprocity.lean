                  ((∏ i ∈ Finset.range M, g i) * (τ ^ M) d) := by rw [← pow_add]
              _ = (πbar ^ (M + 1) * πbar ^ (M * m)) *
                  ((∏ i ∈ Finset.range M, g i) * (τ ^ M) d) := by
                  rw [hexp, pow_add]
              _ = πbar ^ (M + 1) *
                  ((∏ i ∈ Finset.range M, g i) * πbar ^ (M * m) * (τ ^ M) d) := by ring
          rw [h_tM_eq, mul_div_cancel_left₀ _ (pow_ne_zero (M + 1) hπbar_ne)]
