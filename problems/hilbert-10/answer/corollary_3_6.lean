  have hcong : ∀ (z z' : F) (hz : ValuativeRel.valuation F z ≤ 1)
      (hz' : ValuativeRel.valuation F z' ≤ 1),
      Ideal.Quotient.mk (Ideal.span {a₀}) (⟨z, hz⟩ : ↥(ValuativeRel.valuation F).integer) =
        Ideal.Quotient.mk (Ideal.span {a₀}) (⟨z', hz'⟩ : ↥(ValuativeRel.valuation F).integer) →
