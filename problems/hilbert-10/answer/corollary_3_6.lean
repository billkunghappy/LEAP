      IsDedekindDomain.HeightOneSpectrum.valuation L v (a₁ - a₂) ≤ 1 →
      IsDedekindDomain.HeightOneSpectrum.valuation L v (a₁ - a₃) ≤ 1 →
      ¬ (IsDedekindDomain.HeightOneSpectrum.valuation L v (a₁ - a₂) < 1 ∧
        IsDedekindDomain.HeightOneSpectrum.valuation L v (a₁ - a₃) < 1) →
      LocalIdentityAt a₁ a₂ a₃ v := by
    intro L _ _ a₁ a₂ a₃ h12 h13 h23 v h2 hα hβ hnot
    have hγ : IsDedekindDomain.HeightOneSpectrum.valuation L v (a₂ - a₃) ≤ 1 := by
