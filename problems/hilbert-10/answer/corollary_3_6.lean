    have hy₁x : y₁ = x * j := by rw [← hxy, mul_assoc, msq, mul_one]
    refine Subgroup.mem_sup.mpr ⟨y₁, Subgroup.mem_inf.mpr ⟨?_, hy₁⟩, j, Subgroup.mem_inf.mpr hj, hxy⟩
