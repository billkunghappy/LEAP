        (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F L)) with hcdef
      set s : EllipticRootNumber.relWeil F L := (Quotient.out c)⁻¹ with hsdef
      have hx : x = (k₀ : EllipticRootNumber.relWeil F L) * s := by
        rw [hsdef, hk]; group
