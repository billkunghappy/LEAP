        ∀ g : EllipticRootNumber.relWeil F (M i), (g : EllipticRootNumber.AbsGal F) ∈ N'.fixingSubgroup →
          (g : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → χ i g = 1 ∧ χ' i g = 1 := by
      intro i
      haveI := hMfin i
      obtain ⟨-, U₁, hU₁, hk₁⟩ := hχW i
      obtain ⟨-, U₂, hU₂, hk₂⟩ := hχ'W i
      have hσW : EllipticRootNumber.IsWeilRep F (M i)
          ((EllipticRootNumber.charRep F (M i) (χ i)).prod (EllipticRootNumber.charRep F (M i) (χ' i))) := by
        refine ⟨Module.Finite.prod, U₁ ∩ U₂, Filter.inter_mem hU₁ hU₂, ?_⟩
        intro w hwU hwI
        apply LinearMap.ext
        intro x
        change ((EllipticRootNumber.charRep F (M i) (χ i) w x.1,
          EllipticRootNumber.charRep F (M i) (χ' i) w x.2) : _ × _) = x
        rw [hk₁ w hwU.1 hwI, hk₂ w hwU.2 hwI]
        rfl
      have hσc : ∀ w w' : EllipticRootNumber.relWeil F (M i),
          ((EllipticRootNumber.charRep F (M i) (χ i)).prod (EllipticRootNumber.charRep F (M i) (χ' i))) w *
            ((EllipticRootNumber.charRep F (M i) (χ i)).prod (EllipticRootNumber.charRep F (M i) (χ' i))) w' =
          ((EllipticRootNumber.charRep F (M i) (χ i)).prod (EllipticRootNumber.charRep F (M i) (χ' i))) w' *
            ((EllipticRootNumber.charRep F (M i) (χ i)).prod (EllipticRootNumber.charRep F (M i) (χ' i))) w := by
        intro w w'
        apply LinearMap.ext
        intro x
        change (((EllipticRootNumber.charRep F (M i) (χ i) w * EllipticRootNumber.charRep F (M i) (χ i) w') x.1,
          (EllipticRootNumber.charRep F (M i) (χ' i) w * EllipticRootNumber.charRep F (M i) (χ' i) w') x.2) : _ × _) =
          ((EllipticRootNumber.charRep F (M i) (χ i) w' * EllipticRootNumber.charRep F (M i) (χ i) w) x.1,
          (EllipticRootNumber.charRep F (M i) (χ' i) w' * EllipticRootNumber.charRep F (M i) (χ' i) w) x.2)
        rw [hcommChar (M i) (χ i) w w', hcommChar (M i) (χ' i) w w']
      obtain ⟨N', hN', hMN', hab', hk'⟩ := weilRep_abTriv_of_comm F rec (M i) _ hσW hσc
      refine ⟨N', hN', hMN', hab', fun g hg1 hg2 => ?_⟩
      have h1 := LinearMap.congr_fun (hk' g hg1 hg2)
        ((ULift.up 1, 0) : ULift.{u} (EllipticRootNumber.Ω F) × ULift.{u} (EllipticRootNumber.Ω F))
      have h2 := LinearMap.congr_fun (hk' g hg1 hg2)
        ((0, ULift.up 1) : ULift.{u} (EllipticRootNumber.Ω F) × ULift.{u} (EllipticRootNumber.Ω F))
      exact ⟨hval (M i) (χ i) g (congrArg Prod.fst h1), hval (M i) (χ' i) g (congrArg Prod.snd h2)⟩
    
    obtain ⟨N₀, hN₀, hle₀, hab₀, hk₀⟩ := weilRep_abTriv_of_comm F rec ⊥ _ hωW (hcommChar ⊥ ω)
    
    obtain ⟨e₀, he₀⟩ := hrel
      (fun i => (EllipticRootNumber.charRep F (M i) (χ i)).comp
        (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M i))).toMonoidHom)
      (fun i => (EllipticRootNumber.charRep F (M i) (χ' i)).comp
        (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M i))).toMonoidHom)
      (fun i t => by
        apply LinearMap.ext
        intro v
        change ((θ i ((Subgroup.subgroupOfEquivOfLe _).symm (Subgroup.subgroupOfEquivOfLe _ t)) :
          (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) • v = _
        rw [MulEquiv.symm_apply_apply]
        rfl)
      (fun i t => by
        apply LinearMap.ext
        intro v
        change ((θ' i ((Subgroup.subgroupOfEquivOfLe _).symm (Subgroup.subgroupOfEquivOfLe _ t)) :
          (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) • v = _
        rw [MulEquiv.symm_apply_apply]
        rfl)
    
    refine ⟨n, 0, 2, M, hMfin, χ, χ', fun j => j.elim0, fun _ => ω, hχW, hχ'W,
      fun j => j.elim0, fun _ => hωW, hAbM, ⟨N₀, hN₀, hab₀, fun g hg1 hg2 =>
        ⟨fun j => j.elim0, fun _ => hval ⊥ ω g
          (LinearMap.congr_fun (hk₀ g hg1 hg2) (ULift.up 1))⟩⟩,
      LinearEquiv.prodUnique.trans e₀, fun w => ?_⟩
    apply LinearMap.ext
    intro x
    exact LinearMap.congr_fun (he₀ w) x.1

theorem eps_ellAdicRep_threeRootsCurve_lc_indep (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    (t₁ t₂ t₃ : F) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃)
    (hE : EllipticRootNumber.IsPotentiallyGood F (threeRootsCurve t₁ t₂ t₃))
    {rec rec' : EllipticRootNumber.LocalReciprocity F}
    (lc : EllipticRootNumber.LocalConstants F rec) (lc' : EllipticRootNumber.LocalConstants F rec')
    (ψ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F))
    (hψ : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1) :
    lc.eps ⊥ ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
        (EllipticRootNumber.relWeil F ⊥).subtype) ψ =
      lc'.eps ⊥ ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
        (EllipticRootNumber.relWeil F ⊥).subtype) ψ :=
by
  classical
  
  have hψA : EllipticRootNumber.IsAdmissibleChar F ⊥ ψ := by
    obtain ⟨h0, x, -, hx⟩ := hψ
    exact ⟨fun h => hx (by rw [h, AddChar.one_apply]), 0, h0⟩
  
  have hρW : EllipticRootNumber.IsWeilRep F ⊥
      ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
        (EllipticRootNumber.relWeil F ⊥).subtype) :=
    ⟨finiteDimensional_vBar_threeRootsCurve F t₁ t₂ t₃ h₁₂ h₁₃ h₂₃,
      ellAdicRep_threeRootsCurve_inertia F t₁ t₂ t₃ h₁₂ h₁₃ h₂₃ hE⟩
  
  have hchar : ∀ (L M₀ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
      [FiniteDimensional F M₀] (hLM : L ≤ M₀), EllipticRootNumber.IsAbelianExt F hLM →
      ∀ (φ : AddChar L (EllipticRootNumber.Ω F)), EllipticRootNumber.IsAdmissibleChar F L φ →
      ∀ (χ : EllipticRootNumber.relWeil F L →* (EllipticRootNumber.Ω F)ˣ),
      EllipticRootNumber.IsWeilRep F L (EllipticRootNumber.charRep F L χ) →
      (∀ g : EllipticRootNumber.relWeil F L, (g : EllipticRootNumber.AbsGal F) ∈ M₀.fixingSubgroup →
        (g : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → χ g = 1) →
      lc.eps L (EllipticRootNumber.charRep F L χ) φ =
        lc'.eps L (EllipticRootNumber.charRep F L χ) φ := by
    intro L M₀ _ _ hLM hab φ hφ χ hχW hχ
    exact eps_charRep_lc_indep F lc lc' L M₀ hLM hab
      (fun x => localReciprocity_eq_mod_abelian F rec rec' L M₀ hLM hab x) φ hφ χ hχW hχ
  
  have hcommBranch :
      ((∀ w w' : EllipticRootNumber.relWeil F ⊥,
        ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
            (EllipticRootNumber.relWeil F ⊥).subtype) w *
          ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
            (EllipticRootNumber.relWeil F ⊥).subtype) w' =
        ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
            (EllipticRootNumber.relWeil F ⊥).subtype) w' *
          ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
            (EllipticRootNumber.relWeil F ⊥).subtype) w) ∧
      ∃ M₀ : IntermediateField F (AlgebraicClosure F), FiniteDimensional F M₀ ∧
        EllipticRootNumber.IsAbelianExt F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M₀) ∧
        ∀ g : EllipticRootNumber.relWeil F ⊥, (g : EllipticRootNumber.AbsGal F) ∈ M₀.fixingSubgroup →
          (g : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
          ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
            (EllipticRootNumber.relWeil F ⊥).subtype) g = 1) →
      lc.eps ⊥ ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
          (EllipticRootNumber.relWeil F ⊥).subtype) ψ =
        lc'.eps ⊥ ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
          (EllipticRootNumber.relWeil F ⊥).subtype) ψ := by
    rintro ⟨hcomm, M₀, hfin, hab, hkill⟩
    haveI := hfin
    exact eps_lc_indep_of_commuting F lc lc' ⊥ M₀ ψ hψA
      (fun χ hW hk => hchar ⊥ M₀ bot_le hab ψ hψA χ hW hk) _ hρW hkill hcomm
  
  have hind : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (h : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
      (χ χ' : EllipticRootNumber.relWeil F M →* (EllipticRootNumber.Ω F)ˣ),
      EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M χ) →
      EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M χ') →
      lc.eps M (EllipticRootNumber.charRep F M χ) (EllipticRootNumber.traceChar F h ψ) =
        lc'.eps M (EllipticRootNumber.charRep F M χ) (EllipticRootNumber.traceChar F h ψ) →
      lc.eps M (EllipticRootNumber.charRep F M χ') (EllipticRootNumber.traceChar F h ψ) =
        lc'.eps M (EllipticRootNumber.charRep F M χ') (EllipticRootNumber.traceChar F h ψ) →
      lc.eps ⊥ (EllipticRootNumber.indLM F h (EllipticRootNumber.charRep F M χ)) ψ *
          lc'.eps ⊥ (EllipticRootNumber.indLM F h (EllipticRootNumber.charRep F M χ')) ψ =
        lc'.eps ⊥ (EllipticRootNumber.indLM F h (EllipticRootNumber.charRep F M χ)) ψ *
          lc.eps ⊥ (EllipticRootNumber.indLM F h (EllipticRootNumber.charRep F M χ')) ψ := by
    intro M _ h χ χ' hχ hχ' hagr hagr'
    have hsep : Algebra.IsSeparable (⊥ : IntermediateField F (AlgebraicClosure F))
        (IntermediateField.extendScalars h) := inferInstance
    have e1 := lc.eps_ind ⊥ M h hsep ψ hψA (EllipticRootNumber.charRep F M χ)
      (EllipticRootNumber.charRep F M χ') hχ hχ' rfl
    have e2 := lc'.eps_ind ⊥ M h hsep ψ hψA (EllipticRootNumber.charRep F M χ)
      (EllipticRootNumber.charRep F M χ') hχ hχ' rfl
    rw [← hagr, ← hagr'] at e2
    apply mul_right_cancel (b := lc.eps M (EllipticRootNumber.charRep F M χ)
        (EllipticRootNumber.traceChar F h ψ) *
      lc.eps M (EllipticRootNumber.charRep F M χ') (EllipticRootNumber.traceChar F h ψ))
    calc _ = (lc.eps ⊥ (EllipticRootNumber.indLM F h (EllipticRootNumber.charRep F M χ)) ψ *
            lc.eps M (EllipticRootNumber.charRep F M χ') (EllipticRootNumber.traceChar F h ψ)) *
          (lc'.eps ⊥ (EllipticRootNumber.indLM F h (EllipticRootNumber.charRep F M χ')) ψ *
            lc.eps M (EllipticRootNumber.charRep F M χ) (EllipticRootNumber.traceChar F h ψ)) := by
          ac_rfl
      _ = (lc.eps ⊥ (EllipticRootNumber.indLM F h (EllipticRootNumber.charRep F M χ')) ψ *
            lc.eps M (EllipticRootNumber.charRep F M χ) (EllipticRootNumber.traceChar F h ψ)) *
          (lc'.eps ⊥ (EllipticRootNumber.indLM F h (EllipticRootNumber.charRep F M χ)) ψ *
            lc.eps M (EllipticRootNumber.charRep F M χ') (EllipticRootNumber.traceChar F h ψ)) := by
          rw [e1, e2]
      _ = _ := by ac_rfl
  
  have hrelBranch :
      (∃ (n a b : ℕ) (M : Fin n → IntermediateField F (AlgebraicClosure F))
        (_ : ∀ i, FiniteDimensional F (M i))
        (χ χ' : ∀ i, EllipticRootNumber.relWeil F (M i) →* (EllipticRootNumber.Ω F)ˣ)
        (lam : Fin a → EllipticRootNumber.relWeil F ⊥ →* (EllipticRootNumber.Ω F)ˣ)
        (μ : Fin b → EllipticRootNumber.relWeil F ⊥ →* (EllipticRootNumber.Ω F)ˣ),
      (∀ i, EllipticRootNumber.IsWeilRep F (M i) (EllipticRootNumber.charRep F (M i) (χ i))) ∧
      (∀ i, EllipticRootNumber.IsWeilRep F (M i) (EllipticRootNumber.charRep F (M i) (χ' i))) ∧
      (∀ j, EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ (lam j))) ∧
      (∀ k, EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ (μ k))) ∧
      (∀ i, ∃ (N : IntermediateField F (AlgebraicClosure F)) (_ : FiniteDimensional F N) (hMN : M i ≤ N),
        EllipticRootNumber.IsAbelianExt F hMN ∧
        ∀ g : EllipticRootNumber.relWeil F (M i), (g : EllipticRootNumber.AbsGal F) ∈ N.fixingSubgroup →
          (g : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → χ i g = 1 ∧ χ' i g = 1) ∧
      (∃ (N : IntermediateField F (AlgebraicClosure F)) (_ : FiniteDimensional F N),
        EllipticRootNumber.IsAbelianExt F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ N) ∧
        ∀ g : EllipticRootNumber.relWeil F ⊥, (g : EllipticRootNumber.AbsGal F) ∈ N.fixingSubgroup →
          (g : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
          (∀ j, lam j g = 1) ∧ (∀ k, μ k g = 1)) ∧
      ∃ e : ((EllipticRootNumber.VBar F (threeRootsCurve t₁ t₂ t₃) ×
            (∀ i, EllipticRootNumber.indSpace
              ((EllipticRootNumber.relWeil F (M i)).subgroupOf (EllipticRootNumber.relWeil F ⊥))
              ((EllipticRootNumber.charRep F (M i) (χ' i)).comp
                (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
                  (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M i))).toMonoidHom))) ×
            (Fin a → ULift.{u} (EllipticRootNumber.Ω F))) ≃ₗ[EllipticRootNumber.Ω F]
          ((∀ i, EllipticRootNumber.indSpace
              ((EllipticRootNumber.relWeil F (M i)).subgroupOf (EllipticRootNumber.relWeil F ⊥))
              ((EllipticRootNumber.charRep F (M i) (χ i)).comp
                (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
                  (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M i))).toMonoidHom)) ×
            (Fin b → ULift.{u} (EllipticRootNumber.Ω F))),
        ∀ w : EllipticRootNumber.relWeil F ⊥,
          e.toLinearMap ∘ₗ
              (((((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
                  (EllipticRootNumber.relWeil F ⊥).subtype) w).prodMap
                (LinearMap.pi fun i =>
                  (EllipticRootNumber.indLM F bot_le (EllipticRootNumber.charRep F (M i) (χ' i)) w) ∘ₗ
                    LinearMap.proj i)).prodMap
                (LinearMap.pi fun j =>
                  (((lam j w : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) • LinearMap.proj j))) =
            ((LinearMap.pi fun i =>
                (EllipticRootNumber.indLM F bot_le (EllipticRootNumber.charRep F (M i) (χ i)) w) ∘ₗ
                  LinearMap.proj i).prodMap
              (LinearMap.pi fun k =>
                (((μ k w : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) • LinearMap.proj k))) ∘ₗ
              e.toLinearMap) →
      lc.eps ⊥ ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
          (EllipticRootNumber.relWeil F ⊥).subtype) ψ =
        lc'.eps ⊥ ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
          (EllipticRootNumber.relWeil F ⊥).subtype) ψ := by
    rintro ⟨n, a, b, M, hM, χ, χ', lam, μ, hχW, hχ'W, hlamW, hμW, hAbM, ⟨N, hN, hab, hk⟩, e, he⟩
    haveI := hN
    refine eps_lc_indep_of_relation F lc lc' ψ hψA _ hρW n a b
      (fun i => EllipticRootNumber.indLM F bot_le (EllipticRootNumber.charRep F (M i) (χ' i)))
      (fun i => EllipticRootNumber.indLM F bot_le (EllipticRootNumber.charRep F (M i) (χ i)))
      (fun i => by
        haveI := hM i
        exact indLM_charRep_isWeilRep F ⊥ (M i) bot_le (χ' i) (hχ'W i))
      (fun i => by
        haveI := hM i
        exact indLM_charRep_isWeilRep F ⊥ (M i) bot_le (χ i) (hχW i))
      (fun i => ?_) lam μ hlamW hμW
      (fun j => hchar ⊥ N bot_le hab ψ hψA (lam j) (hlamW j) (fun g h1 h2 => (hk g h1 h2).1 j))
      (fun k => hchar ⊥ N bot_le hab ψ hψA (μ k) (hμW k) (fun g h1 h2 => (hk g h1 h2).2 k))
      e he
    haveI := hM i
    obtain ⟨Ni, hNi, hMNi, habi, hki⟩ := hAbM i
    haveI := hNi
    have hφ := traceChar_isAdmissibleChar F ⊥ (M i) bot_le ψ hψA
    exact hind (M i) bot_le (χ i) (χ' i) (hχW i) (hχ'W i)
      (hchar (M i) Ni hMNi habi _ hφ (χ i) (hχW i) (fun g h1 h2 => (hki g h1 h2).1))
      (hchar (M i) Ni hMNi habi _ hφ (χ' i) (hχ'W i) (fun g h1 h2 => (hki g h1 h2).2))
  
  by_cases hp : EllipticRootNumber.p F = 2
  · rcases ellAdicRep_threeRootsCurve_structure_dyadic F t₁ t₂ t₃ h₁₂ h₁₃ h₂₃ hE hp with hC | hR
    · exact hcommBranch hC
    · exact hrelBranch hR
  · exact hcommBranch (ellAdicRep_threeRootsCurve_commBranch_of_odd F t₁ t₂ t₃ h₁₂ h₁₃ h₂₃ hE hp)

theorem rootNumber_threeRootsCurve_ringEquiv {F₁ F₂ : Type u} [Field F₁] [Field F₂] [CharZero F₁]
    (τ : F₁ ≃+* F₂) (t₁ t₂ t₃ : F₁) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃) :
    rootNumber (threeRootsCurve (τ t₁) (τ t₂) (τ t₃)) = rootNumber (threeRootsCurve t₁ t₂ t₃) :=
by
  classical
  
  have hs1 : threeRootsCurve (τ t₁) (τ t₂) (τ t₃) =
      (threeRootsCurve t₁ t₂ t₃).map (τ : F₁ →+* F₂) := by
    ext <;> simp [threeRootsCurve, WeierstrassCurve.map]
  
  have rep : ∀ {F : Type u} [Field F] (X : WeierstrassCurve F),
      ∃ C : WeierstrassCurve.VariableChange F, rootNumber X = rootNumberRaw (C • X) := by
    intro F _ X
    obtain ⟨C, hC⟩ := MulAction.mem_orbit_iff.mp (Quotient.mk_out
      (s := MulAction.orbitRel (WeierstrassCurve.VariableChange F) (WeierstrassCurve F)) X)
    exact ⟨C, by rw [hC]; rfl⟩
  obtain ⟨C₁, hC₁⟩ := rep (threeRootsCurve t₁ t₂ t₃)
  obtain ⟨C₂, hC₂⟩ := rep ((threeRootsCurve t₁ t₂ t₃).map (τ : F₁ →+* F₂))
  obtain ⟨C₂', hmapC⟩ : ∃ C₂' : WeierstrassCurve.VariableChange F₁,
      C₂ • (threeRootsCurve t₁ t₂ t₃).map (τ : F₁ →+* F₂) =
        (C₂' • threeRootsCurve t₁ t₂ t₃).map (τ : F₁ →+* F₂) := by
    refine ⟨C₂.map (τ.symm : F₂ →+* F₁), ?_⟩
    rw [← WeierstrassCurve.map_variableChange, WeierstrassCurve.VariableChange.map_map]
    have hcomp : (τ : F₁ →+* F₂).comp (τ.symm : F₂ →+* F₁) = RingHom.id F₂ := by
      ext x; simp
    rw [hcomp, WeierstrassCurve.VariableChange.map_id]
  rw [hs1, hC₂, hC₁, hmapC]
  
  have main : ∀ (S₁ : EllipticRootNumber.LocalFieldStructure F₁)
      (S₂ : EllipticRootNumber.LocalFieldStructure F₂),
      @EllipticRootNumber.rootNumberNonarch F₂ _ S₂.rel S₂.top S₂.isLocalField
          ((C₂' • threeRootsCurve t₁ t₂ t₃).map (τ : F₁ →+* F₂)) =
        @EllipticRootNumber.rootNumberNonarch F₁ _ S₁.rel S₁.top S₁.isLocalField
          (C₁ • threeRootsCurve t₁ t₂ t₃) := by
    rintro ⟨r₁, tp₁, i₁⟩ ⟨r₂, tp₂, i₂⟩
    dsimp only
    have hS := localFieldStructure_ringEquiv_le_one_iff (F₁ := F₁) (F₂ := F₂) τ
    have hW := isWeilRep_wdRep_variableChange_threeRootsCurve F₁ t₁ t₂ t₃ h₁₂ h₁₃ h₂₃ C₂'
    obtain ⟨hiff, hex⟩ := rootNumberNonarch_map_ringEquiv τ hS _ hW
    have hC₁ : EllipticRootNumber.HasLocalConstants F₁ :=
      ⟨EllipticRootNumber.localReciprocity F₁, ⟨EllipticRootNumber.localConstants F₁⟩⟩
    obtain ⟨rec, lc, ψ, hψ, hL⟩ := hex (hiff.mpr hC₁)
    rw [hL, EllipticRootNumber.rootNumberNonarch_of_hasLocalConstants F₁ _ hC₁]
    
    have adm : ∀ φ : AddChar (⊥ : IntermediateField F₁ (AlgebraicClosure F₁))
        (EllipticRootNumber.Ω F₁),
        ((∀ x, 0 ≤ EllipticRootNumber.valL F₁ ⊥ x → φ x = 1) ∧
          ∃ x, EllipticRootNumber.valL F₁ ⊥ x = -1 ∧ φ x ≠ 1) →
        EllipticRootNumber.IsAdmissibleChar F₁ ⊥ φ := by
      rintro φ ⟨h0, x, -, hx⟩
      exact ⟨fun h => hx (by rw [h, AddChar.one_apply]), 0, h0⟩
    
    have hstd : (∀ x, 0 ≤ EllipticRootNumber.valL F₁ ⊥ x → EllipticRootNumber.stdChar F₁ x = 1) ∧
        ∃ x, EllipticRootNumber.valL F₁ ⊥ x = -1 ∧ EllipticRootNumber.stdChar F₁ x ≠ 1 := by
      unfold EllipticRootNumber.stdChar
      exact Classical.epsilon_spec
        (p := fun φ : AddChar (⊥ : IntermediateField F₁ (AlgebraicClosure F₁))
            (EllipticRootNumber.Ω F₁) =>
          (∀ x, 0 ≤ EllipticRootNumber.valL F₁ ⊥ x → φ x = 1) ∧
            ∃ x, EllipticRootNumber.valL F₁ ⊥ x = -1 ∧ φ x ≠ 1) ⟨ψ, hψ⟩
    set lc₁ := EllipticRootNumber.localConstants F₁ with hlc₁
    
    have key : (lc.eps ⊥ (EllipticRootNumber.wdRep F₁ (threeRootsCurve t₁ t₂ t₃)).ρ ψ :
          EllipticRootNumber.Ω F₁) =
        (lc₁.eps ⊥ (EllipticRootNumber.wdRep F₁ (threeRootsCurve t₁ t₂ t₃)).ρ
          (EllipticRootNumber.stdChar F₁) : EllipticRootNumber.Ω F₁) := by
      by_cases hPG : EllipticRootNumber.IsPotentiallyGood F₁ (threeRootsCurve t₁ t₂ t₃)
      · have hw : EllipticRootNumber.wdRep F₁ (threeRootsCurve t₁ t₂ t₃) =
            { V := EllipticRootNumber.VBar F₁ (threeRootsCurve t₁ t₂ t₃)
              ρ := (EllipticRootNumber.ellAdicRep F₁ (threeRootsCurve t₁ t₂ t₃)).comp
                (EllipticRootNumber.relWeil F₁ ⊥).subtype
              N := 0 } := if_pos hPG
        have gen : ∀ W : EllipticRootNumber.WDRep F₁ ⊥,
            W = { V := EllipticRootNumber.VBar F₁ (threeRootsCurve t₁ t₂ t₃)
                  ρ := (EllipticRootNumber.ellAdicRep F₁ (threeRootsCurve t₁ t₂ t₃)).comp
                    (EllipticRootNumber.relWeil F₁ ⊥).subtype
                  N := 0 } →
            (lc.eps ⊥ W.ρ ψ : EllipticRootNumber.Ω F₁) =
              (lc₁.eps ⊥ W.ρ (EllipticRootNumber.stdChar F₁) : EllipticRootNumber.Ω F₁) := by
          rintro W rfl
          dsimp only
          rw [eps_ellAdicRep_threeRootsCurve_char_indep F₁ t₁ t₂ t₃ h₁₂ h₁₃ h₂₃ hPG lc ψ
              (EllipticRootNumber.stdChar F₁) hψ hstd,
            eps_ellAdicRep_threeRootsCurve_lc_indep F₁ t₁ t₂ t₃ h₁₂ h₁₃ h₂₃ hPG lc lc₁
              (EllipticRootNumber.stdChar F₁) hstd]
        exact gen _ hw
      · have hw : EllipticRootNumber.wdRep F₁ (threeRootsCurve t₁ t₂ t₃) =
            { V := Fin 2 → ULift.{u} (EllipticRootNumber.Ω F₁)
              ρ := EllipticRootNumber.spTwistRep F₁ ⊥
                (EllipticRootNumber.quadCharΩ F₁ (threeRootsCurve t₁ t₂ t₃) ⊥)
              N := EllipticRootNumber.spN F₁ } := if_neg hPG
        have gen : ∀ W : EllipticRootNumber.WDRep F₁ ⊥,
            W = { V := Fin 2 → ULift.{u} (EllipticRootNumber.Ω F₁)
                  ρ := EllipticRootNumber.spTwistRep F₁ ⊥
                    (EllipticRootNumber.quadCharΩ F₁ (threeRootsCurve t₁ t₂ t₃) ⊥)
                  N := EllipticRootNumber.spN F₁ } →
            (lc.eps ⊥ W.ρ ψ : EllipticRootNumber.Ω F₁) =
              (lc₁.eps ⊥ W.ρ (EllipticRootNumber.stdChar F₁) : EllipticRootNumber.Ω F₁) := by
          rintro W rfl
          dsimp only
          rw [eps_spTwistRep_quadChar_eq F₁ (threeRootsCurve t₁ t₂ t₃) lc lc₁ ψ
            (EllipticRootNumber.stdChar F₁) hψ hstd]
        exact gen _ hw
    have e1 := localEps_variableChange_threeRootsCurve F₁ t₁ t₂ t₃ h₁₂ h₁₃ h₂₃ C₂' lc ψ (adm ψ hψ)
    have e2 := localEps_variableChange_threeRootsCurve F₁ t₁ t₂ t₃ h₁₂ h₁₃ h₂₃ C₁ lc₁
      (EllipticRootNumber.stdChar F₁) (adm _ hstd)
    have hloc : EllipticRootNumber.localEps F₁ (C₁ • threeRootsCurve t₁ t₂ t₃) lc₁ =
        (lc₁.eps ⊥ (EllipticRootNumber.wdRep F₁ (C₁ • threeRootsCurve t₁ t₂ t₃)).ρ
            (EllipticRootNumber.stdChar F₁) : EllipticRootNumber.Ω F₁) *
          EllipticRootNumber.frobDet F₁ ⊥
            (EllipticRootNumber.wdRep F₁ (C₁ • threeRootsCurve t₁ t₂ t₃)) := rfl
    rw [hloc, e1, e2, key]
  
  unfold rootNumberRaw
  have hA : (Nonempty (F₂ ≃+* ℝ) ∨ Nonempty (F₂ ≃+* ℂ)) ↔
      (Nonempty (F₁ ≃+* ℝ) ∨ Nonempty (F₁ ≃+* ℂ)) := by
    constructor
    · rintro (h | h)
      · obtain ⟨e⟩ := h
        exact Or.inl ⟨τ.trans e⟩
      · obtain ⟨e⟩ := h
        exact Or.inr ⟨τ.trans e⟩
    · rintro (h | h)
      · obtain ⟨e⟩ := h
        exact Or.inl ⟨τ.symm.trans e⟩
      · obtain ⟨e⟩ := h
        exact Or.inr ⟨τ.symm.trans e⟩
  by_cases hA₁ : Nonempty (F₁ ≃+* ℝ) ∨ Nonempty (F₁ ≃+* ℂ)
  · rw [if_pos (hA.mpr hA₁), if_pos hA₁]
  rw [if_neg (fun h => hA₁ (hA.mp h)), if_neg hA₁]
  have hB : Nonempty (EllipticRootNumber.LocalFieldStructure F₂) ↔
      Nonempty (EllipticRootNumber.LocalFieldStructure F₁) :=
    ⟨nonempty_localFieldStructure_of_ringEquiv τ, nonempty_localFieldStructure_of_ringEquiv τ.symm⟩
  by_cases hB₁ : Nonempty (EllipticRootNumber.LocalFieldStructure F₁)
  · rw [dif_pos (hB.mpr hB₁), dif_pos hB₁]
    exact main _ _
  · rw [dif_neg (fun h => hB₁ (hB.mp h)), dif_neg hB₁]

theorem adicCompletion_exists_pow_eq_one_add {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    (∀ n : ℕ, Valued.v (n : v.adicCompletion K) = 1 → ∀ z : v.adicCompletion K,
       Valued.v z < 1 → ∃ y : v.adicCompletion K, y ^ n = 1 + z) ∧
    (∀ z : v.adicCompletion K, Valued.v z < Valued.v (4 : v.adicCompletion K) →
       ∃ y : v.adicCompletion K, y ^ 2 = 1 + z) :=
by
  
  have G3 : ∀ y : WithZero (Multiplicative ℤ), y < 1 → y ≤ WithZero.exp (-1 : ℤ) := by
    intro y hy
    by_cases hy0 : y = 0
    · rw [hy0]; exact zero_le'
    · rw [← WithZero.exp_log hy0] at hy ⊢
      rw [← WithZero.exp_zero, WithZero.exp_lt_exp] at hy
      rw [WithZero.exp_le_exp]; omega
  have G1 : ∀ N k : ℕ, N ≤ k →
      WithZero.exp (-((k : ℤ) + 1)) ≤ WithZero.exp (-((N : ℤ) + 1)) := by
    intro N k h; rw [WithZero.exp_le_exp]; omega
  have G2 : ∀ γ : (WithZero (Multiplicative ℤ))ˣ, ∃ N : ℕ,
      WithZero.exp (-((N : ℤ) + 1)) < (γ : WithZero (Multiplicative ℤ)) := by
    intro γ
    have hγ0 : (γ : WithZero (Multiplicative ℤ)) ≠ 0 := Units.ne_zero γ
    refine ⟨(-WithZero.log (γ : WithZero (Multiplicative ℤ))).toNat, ?_⟩
    conv_rhs => rw [← WithZero.exp_log hγ0]
    rw [WithZero.exp_lt_exp]
    have := Int.self_le_toNat (-WithZero.log (γ : WithZero (Multiplicative ℤ)))
    omega
  have G4 : WithZero.exp (-1 : ℤ) ≤ 1 := by
    rw [← WithZero.exp_zero, WithZero.exp_le_exp]; norm_num
  have G5 : ∀ k : ℕ, WithZero.exp (-((k : ℤ) + 1)) * WithZero.exp (-1 : ℤ) =
      WithZero.exp (-(((k + 1 : ℕ) : ℤ) + 1)) := by
    intro k
    rw [← WithZero.exp_add] <;> congr 1 <;> push_cast <;> ring
  
  have T : ∀ x : ℕ → v.adicCompletion K,
      (∀ k : ℕ, Valued.v (x (k + 1) - x k) ≤ WithZero.exp (-((k : ℤ) + 1))) →
      ∃ L : v.adicCompletion K, Filter.Tendsto x Filter.atTop (nhds L) := by
    intro x hinc
    have T1 : ∀ N n : ℕ, N ≤ n → Valued.v (x n - x N) ≤ WithZero.exp (-((N : ℤ) + 1)) := by
      intro N n hn
      induction n, hn using Nat.le_induction with
      | base => rw [sub_self, map_zero]; exact zero_le'
      | succ n hn ih =>
        have e : x (n + 1) - x N = (x (n + 1) - x n) + (x n - x N) := by ring
        rw [e]
        exact Valuation.map_add_le _ (le_trans (hinc n) (G1 N n hn)) ih
    have hcauchy : CauchySeq x := by
      refine (Valued.cauchy_iff).2 ⟨Filter.map_neBot, fun γ => ?_⟩
      obtain ⟨N, hN⟩ := G2 γ
      refine ⟨x '' Set.Ici N, Filter.image_mem_map (Filter.Ici_mem_atTop N), ?_⟩
      rintro _ ⟨m, hm, rfl⟩ _ ⟨n, hn, rfl⟩
      have e : x n - x m = (x n - x N) - (x m - x N) := by ring
      rw [e]
      exact lt_of_le_of_lt (Valuation.map_sub_le _ (T1 N n hn) (T1 N m hm)) hN
    exact cauchySeq_tendsto_of_complete hcauchy
  have Z : ∀ g : ℕ → v.adicCompletion K,
      (∀ k : ℕ, Valued.v (g k) ≤ WithZero.exp (-((k : ℤ) + 1))) →
      Filter.Tendsto g Filter.atTop (nhds 0) := by
    intro g hg
    rw [Filter.tendsto_def]
    intro s hs
    obtain ⟨γ, hγ⟩ := Valued.mem_nhds_zero.mp hs
    obtain ⟨N, hN⟩ := G2 γ
    rw [Filter.mem_atTop_sets]
    refine ⟨N, fun k hk => hγ ?_⟩
    exact lt_of_le_of_lt (le_trans (hg k) (G1 N k hk)) hN
  
  have M1 : ∀ a : v.adicCompletion K, Valued.v (a - 1) ≤ WithZero.exp (-1 : ℤ) →
      Valued.v a ≤ 1 := by
    intro a ha
    calc Valued.v a = Valued.v ((a - 1) + 1) := by rw [sub_add_cancel]
      _ ≤ 1 := Valuation.map_add_le _ (le_trans ha G4) (by rw [map_one])
  have Mmul : ∀ a b : v.adicCompletion K, Valued.v (a - 1) ≤ WithZero.exp (-1 : ℤ) →
      Valued.v (b - 1) ≤ WithZero.exp (-1 : ℤ) →
      Valued.v (a * b - 1) ≤ WithZero.exp (-1 : ℤ) := by
    intro a b ha hb
    have e : a * b - 1 = a * (b - 1) + (a - 1) := by ring
    rw [e]
    refine Valuation.map_add_le _ ?_ ha
    rw [map_mul]
    calc Valued.v a * Valued.v (b - 1) ≤ 1 * WithZero.exp (-1 : ℤ) := mul_le_mul' (M1 a ha) hb
      _ = WithZero.exp (-1 : ℤ) := one_mul _
  have Mpow : ∀ a : v.adicCompletion K, Valued.v (a - 1) ≤ WithZero.exp (-1 : ℤ) →
      ∀ i : ℕ, Valued.v (a ^ i - 1) ≤ WithZero.exp (-1 : ℤ) := by
    intro a ha i
    induction i with
    | zero => rw [pow_zero, sub_self, map_zero]; exact zero_le'
    | succ i ih => rw [pow_succ]; exact Mmul _ _ ih ha
  have S2a : ∀ (b c : v.adicCompletion K) (n : ℕ), Valued.v (b - 1) ≤ WithZero.exp (-1 : ℤ) →
      Valued.v (c - 1) ≤ WithZero.exp (-1 : ℤ) →
      Valued.v ((∑ i ∈ Finset.range n, b ^ i * c ^ (n - 1 - i)) - (n : v.adicCompletion K)) ≤
        WithZero.exp (-1 : ℤ) := by
    intro b c n hb hc
    have e : (∑ i ∈ Finset.range n, b ^ i * c ^ (n - 1 - i)) - (n : v.adicCompletion K) =
        ∑ i ∈ Finset.range n, (b ^ i * c ^ (n - 1 - i) - 1) := by
      rw [Finset.sum_sub_distrib]; simp
    rw [e]
    exact Valuation.map_sum_le _ (fun i _ => Mmul _ _ (Mpow _ hb i) (Mpow _ hc _))
  refine ⟨?_, ?_⟩
  · 
    intro n hn z hz
    have hu : Valued.v ((1 + z) - 1) ≤ WithZero.exp (-1 : ℤ) := by
      rw [add_sub_cancel_left]; exact G3 _ hz
    generalize 1 + z = u at hu ⊢
    have hn0 : (n : v.adicCompletion K) ≠ 0 := by
      intro h; rw [h, map_zero] at hn; exact zero_ne_one hn
    have hd : ∀ a : v.adicCompletion K, Valued.v (a / n) = Valued.v a := by
      intro a; rw [map_div₀, hn, div_one]
    obtain ⟨x, hx0, hxs⟩ : ∃ x : ℕ → v.adicCompletion K, x 0 = 1 ∧
        ∀ k, x (k + 1) = x k - (x k ^ n - u) / n :=
      ⟨fun m => Nat.rec (1 : v.adicCompletion K) (fun _ a => a - (a ^ n - u) / n) m,
        rfl, fun _ => rfl⟩
    have P : ∀ k : ℕ, Valued.v (x k - 1) ≤ WithZero.exp (-1 : ℤ) ∧
        Valued.v (x k ^ n - u) ≤ WithZero.exp (-((k : ℤ) + 1)) := by
      intro k
      induction k with
      | zero =>
        refine ⟨by rw [hx0, sub_self, map_zero]; exact zero_le', ?_⟩
        rw [hx0, one_pow, Valuation.map_sub_swap]
        simpa using hu
      | succ k ih =>
        obtain ⟨ha, he⟩ := ih
        have hdn : (x k ^ n - u) / n * n = x k ^ n - u := div_mul_cancel₀ _ hn0
        have he1 : Valued.v (x k ^ n - u) ≤ WithZero.exp (-1 : ℤ) :=
          le_trans he (by rw [WithZero.exp_le_exp]; omega)
        have h1 : Valued.v (x (k + 1) - 1) ≤ WithZero.exp (-1 : ℤ) := by
          have e : x (k + 1) - 1 = (x k - 1) - (x k ^ n - u) / n := by rw [hxs]; ring
          rw [e]; exact Valuation.map_sub_le _ ha (by rw [hd]; exact he1)
        refine ⟨h1, ?_⟩
        have hg := geom_sum₂_mul (x (k + 1)) (x k) n
        have hxk : x (k + 1) - x k = -((x k ^ n - u) / n) := by rw [hxs]; ring
        have hS1 := S2a (x (k + 1)) (x k) n h1 ha
        set S := ∑ i ∈ Finset.range n, x (k + 1) ^ i * x k ^ (n - 1 - i) with hS
        have key : x (k + 1) ^ n - u = (x k ^ n - u) / n * ((n : v.adicCompletion K) - S) := by
          linear_combination -hg + S * hxk - hdn
        rw [Valuation.map_sub_swap] at hS1
        rw [key, map_mul, hd]
        calc Valued.v (x k ^ n - u) * Valued.v ((n : v.adicCompletion K) - S)
            ≤ WithZero.exp (-((k : ℤ) + 1)) * WithZero.exp (-1 : ℤ) := mul_le_mul' he hS1
          _ = WithZero.exp (-(((k + 1 : ℕ) : ℤ) + 1)) := G5 k
    have hinc : ∀ k : ℕ, Valued.v (x (k + 1) - x k) ≤ WithZero.exp (-((k : ℤ) + 1)) := by
      intro k
      have e : x (k + 1) - x k = -((x k ^ n - u) / n) := by rw [hxs]; ring
      rw [e, Valuation.map_neg, hd]
      exact (P k).2
    obtain ⟨L, hL⟩ := T x hinc
    have h0 := Z (fun k => x k ^ n - u) (fun k => (P k).2)
    have hL' : Filter.Tendsto (fun k => x k ^ n - u) Filter.atTop (nhds (L ^ n - u)) :=
      (hL.pow n).sub_const u
    exact ⟨L, sub_eq_zero.mp (tendsto_nhds_unique hL' h0)⟩
  · 
    intro z hz
    have h4pos : 0 < Valued.v (4 : v.adicCompletion K) := lt_of_le_of_lt zero_le' hz
    have h40 : (4 : v.adicCompletion K) ≠ 0 := by
      intro h; rw [h, map_zero] at h4pos; exact lt_irrefl _ h4pos
    have hζ : Valued.v (z / 4) ≤ WithZero.exp (-1 : ℤ) :=
      G3 _ (by rw [map_div₀, div_lt_one₀ h4pos]; exact hz)
    have h4 : 4 * (z / 4) = z := mul_div_cancel₀ z h40
    generalize z / 4 = ζ at hζ h4
    obtain ⟨W, hW0, hWs⟩ : ∃ W : ℕ → v.adicCompletion K, W 0 = 0 ∧
        ∀ k, W (k + 1) = ζ - W k ^ 2 :=
      ⟨fun m => Nat.rec (0 : v.adicCompletion K) (fun _ a => ζ - a ^ 2) m, rfl, fun _ => rfl⟩
    have Q : ∀ k : ℕ, Valued.v (W k) ≤ WithZero.exp (-1 : ℤ) ∧
        Valued.v (W (k + 1) - W k) ≤ WithZero.exp (-((k : ℤ) + 1)) := by
      intro k
      induction k with
      | zero =>
        refine ⟨by rw [hW0, map_zero]; exact zero_le', ?_⟩
        rw [hWs, hW0]
        simpa using hζ
      | succ k ih =>
        obtain ⟨ha, hinc⟩ := ih
        have hsq : Valued.v (W k ^ 2) ≤ WithZero.exp (-1 : ℤ) := by
          rw [map_pow, sq]
          calc Valued.v (W k) * Valued.v (W k) ≤ WithZero.exp (-1 : ℤ) * 1 :=
                mul_le_mul' ha (le_trans ha G4)
            _ = WithZero.exp (-1 : ℤ) := mul_one _
        have h1 : Valued.v (W (k + 1)) ≤ WithZero.exp (-1 : ℤ) := by
          rw [hWs]; exact Valuation.map_sub_le _ hζ hsq
        refine ⟨h1, ?_⟩
        have e : W (k + 1 + 1) - W (k + 1) = -((W (k + 1) - W k) * (W (k + 1) + W k)) := by
          have h1' := hWs (k + 1)
          have h0' := hWs k
          linear_combination h1' - h0'
        rw [e, Valuation.map_neg, map_mul]
        calc Valued.v (W (k + 1) - W k) * Valued.v (W (k + 1) + W k)
            ≤ WithZero.exp (-((k : ℤ) + 1)) * WithZero.exp (-1 : ℤ) :=
              mul_le_mul' hinc (Valuation.map_add_le _ h1 ha)
          _ = WithZero.exp (-(((k + 1 : ℕ) : ℤ) + 1)) := G5 k
    obtain ⟨M, hM⟩ := T W (fun k => (Q k).2)
    have hres : ∀ k : ℕ, Valued.v (W k ^ 2 + W k - ζ) ≤ WithZero.exp (-((k : ℤ) + 1)) := by
      intro k
      have e : W k ^ 2 + W k - ζ = -(W (k + 1) - W k) := by linear_combination hWs k
      rw [e, Valuation.map_neg]
      exact (Q k).2
    have h0 := Z (fun k => W k ^ 2 + W k - ζ) hres
    have hM' : Filter.Tendsto (fun k => W k ^ 2 + W k - ζ) Filter.atTop
        (nhds (M ^ 2 + M - ζ)) := ((hM.pow 2).add hM).sub_const ζ
    have hMζ : M ^ 2 + M - ζ = 0 := tendsto_nhds_unique hM' h0
    exact ⟨1 + 2 * M, by linear_combination 4 * hMζ + h4⟩

theorem localFieldStructure_adicCompletion_eq {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (S : EllipticRootNumber.LocalFieldStructure (v.adicCompletion K)) :
    (∀ x : v.adicCompletion K,
       (@ValuativeRel.valuation (v.adicCompletion K) _ S.rel x ≤ 1 ↔ Valued.v x ≤ 1)) ∧
    S.top = (inferInstance : TopologicalSpace (v.adicCompletion K)) :=
by
  classical
  
  have key : ∀ (E : Type u) [Field E] [ValuativeRel E] [TopologicalSpace E]
      [IsNonarchimedeanLocalField E] (w : Valuation E (WithZero (Multiplicative ℤ))),
      (∃ z : E, 1 < w z) →
      ∀ x : E, ValuativeRel.valuation E x ≤ 1 ↔ w x ≤ 1 := by
    intro E _ _ _ _ w hwnt
    
    
    have hHens : HenselianLocalRing ↥(ValuativeRel.valuation E).integer := by
      have hclosed : ∀ (n : ℕ) (a : ↥(ValuativeRel.valuation E).integer),
          IsClosed {y : ↥(ValuativeRel.valuation E).integer |
            y - a ∈ (IsLocalRing.maximalIdeal ↥(ValuativeRel.valuation E).integer) ^ n} := by
        intro n a
        obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible
          ↥(ValuativeRel.valuation E).integer
        have hset := Irreducible.maximalIdeal_pow_eq_setOf_le_v_coe_pow
          (v := ValuativeRel.valuation E) hϖ n
        have hpre : {y : ↥(ValuativeRel.valuation E).integer |
            y - a ∈ (IsLocalRing.maximalIdeal ↥(ValuativeRel.valuation E).integer) ^ n} =
            (fun y : ↥(ValuativeRel.valuation E).integer => ((y : E) - (a : E))) ⁻¹'
              {x : E | ValuativeRel.valuation E x ≤ ValuativeRel.valuation E (ϖ : E) ^ n} := by
          ext y
          have h := congrArg (fun s : Set ↥(ValuativeRel.valuation E).integer => (y - a) ∈ s) hset
          simp only [SetLike.mem_coe, eq_iff_iff] at h
          simp only [Set.mem_setOf_eq, Set.mem_preimage]
          rw [h]
          rfl
        rw [hpre]
        exact (IsValuativeTopology.isClosed_closedBall _).preimage
          (continuous_subtype_val.sub continuous_const)
      have hpc : IsPrecomplete (IsLocalRing.maximalIdeal ↥(ValuativeRel.valuation E).integer)
          ↥(ValuativeRel.valuation E).integer := by
        refine ⟨fun {f} hf => ?_⟩
        obtain ⟨L, -, hL⟩ := (isCompact_univ (X := ↥(ValuativeRel.valuation E).integer)).exists_clusterPt
          (f := Filter.map f Filter.atTop) (by simp)
        refine ⟨L, fun n => ?_⟩
        have hC : {y : ↥(ValuativeRel.valuation E).integer |
            y - f n ∈ (IsLocalRing.maximalIdeal ↥(ValuativeRel.valuation E).integer) ^ n} ∈
              Filter.map f Filter.atTop := by
          rw [Filter.mem_map, Filter.mem_atTop_sets]
          refine ⟨n, fun k hk => ?_⟩
          have h' := (hf hk).symm
          rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top] at h'
          exact h'
        have hmem := hL.mem_closure_of_mem _ hC
        rw [(hclosed n (f n)).closure_eq] at hmem
        rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top]
        have h' : f n - L = -(L - f n) := by ring
        rw [h']
        exact neg_mem hmem
      haveI := hpc
      haveI : IsAdicComplete (IsLocalRing.maximalIdeal ↥(ValuativeRel.valuation E).integer)
          ↥(ValuativeRel.valuation E).integer := {}
      haveI := IsAdicComplete.henselianRing ↥(ValuativeRel.valuation E).integer
        (IsLocalRing.maximalIdeal ↥(ValuativeRel.valuation E).integer)
      refine ⟨fun f hf a₀ h₁ h₂ => ?_⟩
      exact HenselianRing.is_henselian f hf a₀ h₁ (h₂.map (Ideal.Quotient.mk _))
    
    have hroot : ∀ n : ℕ, ValuativeRel.valuation E (n : E) = 1 → ∀ y : E,
        ValuativeRel.valuation E y < 1 → ∃ a : E, a ^ n = 1 + y := by
      intro n hn y hy
      haveI := hHens
      have hmax : ∀ z : (ValuativeRel.valuation E).integer,
          z ∈ IsLocalRing.maximalIdeal (ValuativeRel.valuation E).integer ↔
            ValuativeRel.valuation E (z : E) < 1 := by
        intro z
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
          (Valuation.integer.integers (ValuativeRel.valuation E)).isUnit_iff_valuation_eq_one]
        exact ⟨fun h => lt_of_le_of_ne z.2 h, fun h => ne_of_lt h⟩
      have hn0 : n ≠ 0 := by
        rintro rfl
        simp at hn
      let y' : (ValuativeRel.valuation E).integer := ⟨y, le_of_lt hy⟩
      have hy' : (y' : E) = y := rfl
      let f : Polynomial (ValuativeRel.valuation E).integer :=
        Polynomial.X ^ n - Polynomial.C (1 + y')
      have hf : f.Monic := Polynomial.monic_X_pow_sub_C _ hn0
      have h1 : f.eval 1 ∈ IsLocalRing.maximalIdeal (ValuativeRel.valuation E).integer := by
        rw [hmax]
        have e : ((f.eval 1 : (ValuativeRel.valuation E).integer) : E) = -y := by
          simp only [f, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
            Polynomial.eval_C, one_pow]
          push_cast
          rw [hy']
          ring
        rw [e, Valuation.map_neg]
        exact hy
      have h2 : IsUnit ((Polynomial.derivative f).eval 1) := by
        have e2 : (Polynomial.derivative f).eval 1 = (n : (ValuativeRel.valuation E).integer) := by
          simp [f, Polynomial.derivative_X_pow]
        rw [e2, (Valuation.integer.integers (ValuativeRel.valuation E)).isUnit_iff_valuation_eq_one,
          map_natCast]
        exact hn
      obtain ⟨a, ha, -⟩ := HenselianLocalRing.is_henselian f hf 1 h1 h2
      have ha' : a ^ n = 1 + y' := by
        have h3 := ha
        rw [Polynomial.IsRoot.def] at h3
        simp only [f, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
          Polynomial.eval_C] at h3
        exact sub_eq_zero.mp h3
      refine ⟨(a : E), ?_⟩
      have h4 := congrArg (fun z : (ValuativeRel.valuation E).integer => (z : E)) ha'
      simp only at h4
      push_cast at h4
      rw [h4, hy']
    
    have hnat : ∀ n : ℕ, ValuativeRel.valuation E (n : E) ≤ 1 := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        push_cast
        exact le_trans (Valuation.map_add _ _ _) (max_le ih (by simp))
    obtain ⟨ℓ, hℓ1, hℓ⟩ : ∃ ℓ : ℕ, 1 < ℓ ∧ ValuativeRel.valuation E (ℓ : E) = 1 := by
      by_cases h3 : ValuativeRel.valuation E ((3 : ℕ) : E) = 1
      · exact ⟨3, by norm_num, h3⟩
      by_cases h2 : ValuativeRel.valuation E ((2 : ℕ) : E) = 1
      · exact ⟨2, by norm_num, h2⟩
      exfalso
      have h3' := lt_of_le_of_ne (hnat 3) h3
      have h2' := lt_of_le_of_ne (hnat 2) h2
      have e : (1 : E) = ((3 : ℕ) : E) - ((2 : ℕ) : E) := by push_cast; norm_num
      have h5 := Valuation.map_sub (ValuativeRel.valuation E) ((3 : ℕ) : E) ((2 : ℕ) : E)
      rw [← e, Valuation.map_one] at h5
      exact lt_irrefl _ (lt_of_le_of_lt h5 (max_lt h3' h2'))
    
    have P1 : ∀ y : E, ValuativeRel.valuation E y < 1 → w (1 + y) = 1 := by
      intro y hy
      have hne : (1 + y) ≠ 0 := by
        intro h
        have hy1 : y = -1 := by linear_combination h
        rw [hy1, Valuation.map_neg, Valuation.map_one] at hy
        exact lt_irrefl _ hy
      have hw0 : w (1 + y) ≠ 0 := (Valuation.ne_zero_iff w).mpr hne
      obtain ⟨g, hg⟩ : ∃ g : ℤ, w (1 + y) = WithZero.exp g :=
        ⟨_, (WithZero.exp_log hw0).symm⟩
      by_contra hne1
      have hg0 : g ≠ 0 := by
        intro h0; apply hne1; rw [hg, h0, WithZero.exp_zero]
      obtain ⟨a, ha⟩ := hroot (ℓ ^ g.natAbs)
        (by rw [Nat.cast_pow, Valuation.map_pow, hℓ, one_pow]) y hy
      have ha0 : a ≠ 0 := by
        rintro rfl
        rw [zero_pow (pow_ne_zero _ (by omega))] at ha
        exact hne ha.symm
      have hwa : w a ≠ 0 := (Valuation.ne_zero_iff w).mpr ha0
      have hlog : g = ((ℓ ^ g.natAbs : ℕ) : ℤ) * WithZero.log (w a) := by
        have h6 : WithZero.log (w (1 + y)) = g := by rw [hg, WithZero.log_exp]
        have h6' : WithZero.log (w (1 + y)) = ((ℓ ^ g.natAbs : ℕ) : ℤ) * WithZero.log (w a) := by
          rw [← ha, Valuation.map_pow, WithZero.log_pow, nsmul_eq_mul]
        exact h6.symm.trans h6'
      have hdvd : ((ℓ ^ g.natAbs : ℕ) : ℤ) ∣ g := ⟨_, hlog⟩
      have h1 : ℓ ^ g.natAbs ∣ g.natAbs := by
        have h7 := Int.natAbs_dvd_natAbs.mpr hdvd
        simpa using h7
      have h2 : ℓ ^ g.natAbs ≤ g.natAbs := Nat.le_of_dvd (Int.natAbs_pos.mpr hg0) h1
      have h3 : g.natAbs < ℓ ^ g.natAbs := Nat.lt_pow_self hℓ1
      omega
    
    have P2 : ∀ y : E, ValuativeRel.valuation E y < 1 → w y ≤ 1 := by
      intro y hy
      by_contra h
      push_neg at h
      have h1 : w (1 : E) < w y := by rw [Valuation.map_one]; exact h
      have h5 := Valuation.map_add_eq_of_lt_left w h1
      rw [add_comm, P1 y hy] at h5
      rw [← h5] at h
      exact lt_irrefl _ h
    
    obtain ⟨m, hm0, hm⟩ : ∃ m : E, m ≠ 0 ∧ ValuativeRel.valuation E m < 1 := by
      obtain ⟨γ, hγ0, hγ1⟩ := (IsNonarchimedeanLocalField.toIsNontrivial (K := E)).condition
      obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective (K := E) γ
      have ha0 : a ≠ 0 := by
        rintro rfl; rw [Valuation.map_zero] at ha; exact hγ0 ha.symm
      rcases lt_or_gt_of_ne hγ1 with h | h
      · exact ⟨a, ha0, lt_of_eq_of_lt ha h⟩
      · refine ⟨a⁻¹, inv_ne_zero ha0, ?_⟩
        rw [map_inv₀, ha]
        exact inv_lt_one_of_one_lt₀ h
    
    have P3 : ∀ x : E, ValuativeRel.valuation E x ≤ 1 → w x ≤ 1 := by
      intro x hx
      by_contra h
      push_neg at h
      have hx0 : x ≠ 0 := by
        rintro rfl; rw [Valuation.map_zero] at h; exact absurd h (not_lt.mpr zero_le')
      have hk : ∀ k : ℕ, w x ^ k * w m ≤ 1 := by
        intro k
        have h8 : ValuativeRel.valuation E (x ^ k * m) < 1 := by
          rw [Valuation.map_mul, Valuation.map_pow]
          calc _ ≤ 1 * ValuativeRel.valuation E m := mul_le_mul_right' (pow_le_one' hx k) _
            _ = _ := one_mul _
            _ < 1 := hm
        have h9 := P2 _ h8
        rwa [Valuation.map_mul, Valuation.map_pow] at h9
      have hwx0 : w x ≠ 0 := (Valuation.ne_zero_iff w).mpr hx0
      have hwm0 : w m ≠ 0 := (Valuation.ne_zero_iff w).mpr hm0
      obtain ⟨e, he⟩ : ∃ e : ℤ, w x = WithZero.exp e := ⟨_, (WithZero.exp_log hwx0).symm⟩
      obtain ⟨c, hc⟩ : ∃ c : ℤ, w m = WithZero.exp c := ⟨_, (WithZero.exp_log hwm0).symm⟩
      have he1 : 1 ≤ e := by
        have h10 : WithZero.exp (0 : ℤ) < WithZero.exp e := by
          rw [WithZero.exp_zero, ← he]; exact h
        have h11 := WithZero.exp_lt_exp.mp h10
        omega
      have h12 := hk (c.natAbs + 1)
      rw [he, hc, ← WithZero.exp_nsmul, ← WithZero.exp_add, ← WithZero.exp_zero,
        WithZero.exp_le_exp] at h12
      simp only [nsmul_eq_mul] at h12
      push_cast at h12
      have hc1 : -c ≤ |c| := neg_le_abs c
      have hc2 : (0 : ℤ) ≤ |c| := abs_nonneg c
      nlinarith [mul_nonneg (add_nonneg hc2 zero_le_one) (sub_nonneg.mpr he1)]
    
    have R : ∀ x : E, w x ≤ 1 → ValuativeRel.valuation E x ≤ 1 := by
      intro x hx
      by_contra h
      push_neg at h
      have hx0 : x ≠ 0 := by
        rintro rfl; rw [Valuation.map_zero] at h; exact absurd h (not_lt.mpr zero_le')
      obtain ⟨z, hz⟩ := hwnt
      have hz0 : z ≠ 0 := by
        rintro rfl; rw [Valuation.map_zero] at hz; exact absurd hz (not_lt.mpr zero_le')
      let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt E
      have hφ0 : ∀ t : E, t ≠ 0 → φ (ValuativeRel.valuation E t) ≠ 0 := by
        intro t ht h0
        have h13 : φ (ValuativeRel.valuation E t) = φ 0 := by rw [h0, map_zero]
        exact ht ((Valuation.zero_iff _).mp (φ.injective h13))
      obtain ⟨e, he⟩ : ∃ e : ℤ, φ (ValuativeRel.valuation E x⁻¹) = WithZero.exp e :=
        ⟨_, (WithZero.exp_log (hφ0 _ (inv_ne_zero hx0))).symm⟩
      obtain ⟨c, hc⟩ : ∃ c : ℤ, φ (ValuativeRel.valuation E z) = WithZero.exp c :=
        ⟨_, (WithZero.exp_log (hφ0 _ hz0)).symm⟩
      have hlt : ValuativeRel.valuation E x⁻¹ < 1 := by
        rw [map_inv₀]; exact inv_lt_one_of_one_lt₀ h
      have he1 : e ≤ -1 := by
        have h14 : φ (ValuativeRel.valuation E x⁻¹) < φ 1 := (map_lt_map_iff φ).mpr hlt
        rw [map_one, he, ← WithZero.exp_zero, WithZero.exp_lt_exp] at h14
        omega
      have hle : ValuativeRel.valuation E (z * x⁻¹ ^ c.natAbs) ≤ 1 := by
        have h15 : φ (ValuativeRel.valuation E (z * x⁻¹ ^ c.natAbs)) ≤ φ 1 := by
          rw [Valuation.map_mul, Valuation.map_pow, map_mul φ, map_pow φ, he, hc, map_one,
            ← WithZero.exp_nsmul, ← WithZero.exp_add, ← WithZero.exp_zero, WithZero.exp_le_exp]
          simp only [nsmul_eq_mul]
          have hc1 : c ≤ (c.natAbs : ℤ) := by omega
          have hc2 : (0 : ℤ) ≤ (c.natAbs : ℤ) := by omega
          nlinarith [mul_nonneg hc2 (by omega : (0 : ℤ) ≤ -1 - e)]
        exact (map_le_map_iff φ).mp h15
      have h16 := P3 _ hle
      rw [Valuation.map_mul, Valuation.map_pow, map_inv₀] at h16
      have hwx0 : w x ≠ 0 := (Valuation.ne_zero_iff w).mpr hx0
      have h17 : w z ≤ 1 := by
        calc w z = (w z * (w x)⁻¹ ^ c.natAbs) * w x ^ c.natAbs := by
                rw [mul_assoc, ← mul_pow, inv_mul_cancel₀ hwx0, one_pow, mul_one]
          _ ≤ 1 * 1 := mul_le_mul' h16 (pow_le_one' hx _)
          _ = 1 := one_mul 1
      exact absurd hz (not_lt.mpr h17)
    exact fun x => ⟨P3 x, R x⟩
  
  obtain ⟨π, hπ⟩ := IsDedekindDomain.HeightOneSpectrum.valuation_exists_uniformizer K v
  set ϖ : v.adicCompletion K := algebraMap K (v.adicCompletion K) π with hϖdef
  have hϖ : Valued.v ϖ = WithZero.exp (-1 : ℤ) := by
    rw [hϖdef]
    exact (IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v π).trans hπ
  have hϖ0 : ϖ ≠ 0 := by
    intro h; rw [h, map_zero] at hϖ; exact WithZero.exp_ne_zero hϖ.symm
  have hwnt : ∃ z : v.adicCompletion K, 1 < Valued.v z := by
    refine ⟨ϖ⁻¹, ?_⟩
    rw [map_inv₀, hϖ, ← WithZero.exp_neg, neg_neg, ← WithZero.exp_zero, WithZero.exp_lt_exp]
    norm_num
  have hval := @key (v.adicCompletion K) _ S.rel S.top S.isLocalField Valued.v hwnt
  refine ⟨hval, ?_⟩
  have he : (@ValuativeRel.valuation (v.adicCompletion K) _ S.rel).IsEquiv
      (Valued.v : Valuation (v.adicCompletion K) (WithZero (Multiplicative ℤ))) :=
    Valuation.isEquiv_iff_val_le_one.mpr (fun {x} => hval x)
  apply TopologicalSpace.ext_nhds
  intro x
  ext s
  refine (@IsValuativeTopology.mem_nhds_iff _ _ S.rel S.top
    (@IsNonarchimedeanLocalField.toIsValuativeTopology _ _ S.rel S.top S.isLocalField) s x).trans
    (Iff.trans ?_ Valued.mem_nhds.symm)
  constructor
  · rintro ⟨γ, hγ⟩
    obtain ⟨a, ha⟩ := @ValuativeRel.valuation_surjective _ _ S.rel (γ : _)
    have ha0 : a ≠ 0 := by
      rintro rfl; rw [Valuation.map_zero] at ha; exact Units.ne_zero γ ha.symm
    refine ⟨Units.mk0 (Valued.v a) ((Valuation.ne_zero_iff _).mpr ha0), fun y hy => hγ ?_⟩
    simp only [Set.mem_setOf_eq, Units.val_mk0] at hy
    refine ⟨y - x, ?_, by dsimp only; ring⟩
    rw [Set.mem_setOf_eq, ← ha]
    exact he.lt_iff_lt.mpr hy
  · rintro ⟨γ₀, hγ₀⟩
    have hγne : (γ₀ : WithZero (Multiplicative ℤ)) ≠ 0 := Units.ne_zero γ₀
    set N : ℕ := (WithZero.log (γ₀ : WithZero (Multiplicative ℤ))).natAbs with hN
    have ha : Valued.v (ϖ ^ N) ≤ (γ₀ : WithZero (Multiplicative ℤ)) := by
      rw [map_pow, hϖ, ← WithZero.exp_nsmul, ← WithZero.exp_log hγne, WithZero.exp_le_exp]
      simp only [nsmul_eq_mul, mul_neg, mul_one]
      omega
    have ha0 : ϖ ^ N ≠ 0 := pow_ne_zero _ hϖ0
    refine ⟨Units.mk0 (@ValuativeRel.valuation (v.adicCompletion K) _ S.rel (ϖ ^ N))
      ((Valuation.ne_zero_iff _).mpr ha0), ?_⟩
    rintro _ ⟨z, hz, rfl⟩
    apply hγ₀
    simp only [Set.mem_setOf_eq, Units.val_mk0] at hz ⊢
    rw [add_sub_cancel_left]
    exact lt_of_lt_of_le (he.lt_iff_lt.mp hz) ha

theorem threeRootsCurve_eventually_adic {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (t₁ t₂ t₃ : v.adicCompletion K) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃) :
    ∀ᶠ s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K in nhds (t₁, t₂, t₃),
      s.1 ≠ s.2.1 ∧ s.1 ≠ s.2.2 ∧ s.2.1 ≠ s.2.2 ∧
      (Valued.v ((threeRootsCurve s.1 s.2.1 s.2.2).c₄ ^ 3 / (threeRootsCurve s.1 s.2.1 s.2.2).Δ) ≤ 1 ↔
        Valued.v ((threeRootsCurve t₁ t₂ t₃).c₄ ^ 3 / (threeRootsCurve t₁ t₂ t₃).Δ) ≤ 1) ∧
      ((threeRootsCurve t₁ t₂ t₃).c₆ ≠ 0 →
        Valued.v ((threeRootsCurve s.1 s.2.1 s.2.2).c₆ / (threeRootsCurve t₁ t₂ t₃).c₆ - 1) <
          Valued.v (4 : v.adicCompletion K)) :=
by
  haveI : CharZero (v.adicCompletion K) :=
    charZero_of_injective_algebraMap (algebraMap K (v.adicCompletion K)).injective
  have cc4 : Continuous fun s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K =>
      (threeRootsCurve s.1 s.2.1 s.2.2).c₄ := by
    simp only [WeierstrassCurve.c₄, WeierstrassCurve.b₂, WeierstrassCurve.b₄, threeRootsCurve]
    fun_prop
  have cc6 : Continuous fun s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K =>
      (threeRootsCurve s.1 s.2.1 s.2.2).c₆ := by
    simp only [WeierstrassCurve.c₆, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
      WeierstrassCurve.b₆, threeRootsCurve]
    fun_prop
  have cΔ : Continuous fun s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K =>
      (threeRootsCurve s.1 s.2.1 s.2.2).Δ := by
    simp only [WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
      WeierstrassCurve.b₆, WeierstrassCurve.b₈, threeRootsCurve]
    fun_prop
  have hΔ : (threeRootsCurve t₁ t₂ t₃).Δ ≠ 0 := by
    have e : (threeRootsCurve t₁ t₂ t₃).Δ = 16 * ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) ^ 2 := by
      simp only [WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
        WeierstrassCurve.b₆, WeierstrassCurve.b₈, threeRootsCurve]
      ring
    rw [e]
    exact mul_ne_zero (by norm_num) (pow_ne_zero _ (mul_ne_zero (mul_ne_zero
      (sub_ne_zero.mpr h₁₂) (sub_ne_zero.mpr h₁₃)) (sub_ne_zero.mpr h₂₃)))
  
  have H12 : ∀ᶠ s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K in
      nhds (t₁, t₂, t₃), s.1 ≠ s.2.1 := by
    have hc : ContinuousAt (fun s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K =>
        s.1 - s.2.1) (t₁, t₂, t₃) := by
      fun_prop
    filter_upwards [hc.eventually_ne (sub_ne_zero.mpr h₁₂)] with s hs
    exact sub_ne_zero.mp hs
  have H13 : ∀ᶠ s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K in
      nhds (t₁, t₂, t₃), s.1 ≠ s.2.2 := by
    have hc : ContinuousAt (fun s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K =>
        s.1 - s.2.2) (t₁, t₂, t₃) := by
      fun_prop
    filter_upwards [hc.eventually_ne (sub_ne_zero.mpr h₁₃)] with s hs
    exact sub_ne_zero.mp hs
  have H23 : ∀ᶠ s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K in
      nhds (t₁, t₂, t₃), s.2.1 ≠ s.2.2 := by
    have hc : ContinuousAt (fun s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K =>
        s.2.1 - s.2.2) (t₁, t₂, t₃) := by
      fun_prop
    filter_upwards [hc.eventually_ne (sub_ne_zero.mpr h₂₃)] with s hs
    exact sub_ne_zero.mp hs
  
  have hJ : ContinuousAt (fun s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K =>
      (threeRootsCurve s.1 s.2.1 s.2.2).c₄ ^ 3 / (threeRootsCurve s.1 s.2.1 s.2.2).Δ)
      (t₁, t₂, t₃) :=
    ((cc4.pow 3).continuousAt).div cΔ.continuousAt hΔ
  have hB : IsClopen {x : v.adicCompletion K | Valued.v x ≤ (1 : WithZero (Multiplicative ℤ))} :=
    Valued.isClopen_closedBall (v.adicCompletion K) one_ne_zero
  have Hiff : ∀ᶠ s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K in
      nhds (t₁, t₂, t₃),
      (Valued.v ((threeRootsCurve s.1 s.2.1 s.2.2).c₄ ^ 3 / (threeRootsCurve s.1 s.2.1 s.2.2).Δ) ≤ 1 ↔
        Valued.v ((threeRootsCurve t₁ t₂ t₃).c₄ ^ 3 / (threeRootsCurve t₁ t₂ t₃).Δ) ≤ 1) := by
    by_cases hJt : Valued.v ((threeRootsCurve t₁ t₂ t₃).c₄ ^ 3 / (threeRootsCurve t₁ t₂ t₃).Δ) ≤ 1
    · have hmem := hJ.eventually_mem (hB.isOpen.mem_nhds hJt)
      filter_upwards [hmem] with s hs
      exact iff_of_true hs hJt
    · have hmem := hJ.eventually_mem (hB.isClosed.isOpen_compl.mem_nhds hJt)
      filter_upwards [hmem] with s hs
      exact iff_of_false hs hJt
  
  have Hc6 : ∀ᶠ s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K in
      nhds (t₁, t₂, t₃),
      ((threeRootsCurve t₁ t₂ t₃).c₆ ≠ 0 →
        Valued.v ((threeRootsCurve s.1 s.2.1 s.2.2).c₆ / (threeRootsCurve t₁ t₂ t₃).c₆ - 1) <
          Valued.v (4 : v.adicCompletion K)) := by
    by_cases hc : (threeRootsCurve t₁ t₂ t₃).c₆ = 0
    · exact Filter.Eventually.of_forall (fun s h => absurd hc h)
    · have hG : ContinuousAt
          (fun s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K =>
            (threeRootsCurve s.1 s.2.1 s.2.2).c₆ / (threeRootsCurve t₁ t₂ t₃).c₆ - 1)
          (t₁, t₂, t₃) :=
        ((cc6.div_const _).sub continuous_const).continuousAt
      have hU : IsOpen {x : v.adicCompletion K | Valued.v x < Valued.v (4 : v.adicCompletion K)} :=
        Valued.isOpen_ball (v.adicCompletion K) _
      have h4 : (4 : v.adicCompletion K) ≠ 0 := by norm_num
      have hU0 : (threeRootsCurve t₁ t₂ t₃).c₆ / (threeRootsCurve t₁ t₂ t₃).c₆ - 1 ∈
          {x : v.adicCompletion K | Valued.v x < Valued.v (4 : v.adicCompletion K)} := by
        rw [div_self hc, sub_self]
        simp only [Set.mem_setOf_eq, map_zero]
        exact zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr h4)
      have hmem := hG.eventually_mem (hU.mem_nhds hU0)
      filter_upwards [hmem] with s hs
      exact fun _ => hs
  filter_upwards [H12, H13, H23, Hiff, Hc6] with s h12 h13 h23 hiff hc6
  exact ⟨h12, h13, h23, hiff, hc6⟩

theorem localEps_of_isPotentiallyGood (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] {rec : EllipticRootNumber.LocalReciprocity F}
    (lc : EllipticRootNumber.LocalConstants F rec) (E : WeierstrassCurve F)
    (hE : EllipticRootNumber.IsPotentiallyGood F E) :
    EllipticRootNumber.localEps F E lc =
      ((lc.eps ⊥ ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype)
        (EllipticRootNumber.stdChar F) : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) :=
by
  classical
  have s7 : ∀ W' : EllipticRootNumber.WDRep F ⊥, W'.N = 0 →
      EllipticRootNumber.frobDet F ⊥ W' = 1 := by
    intro W' hN
    unfold EllipticRootNumber.frobDet
    dsimp only
    split_ifs with hI hK
    · haveI : Subsingleton (↥(EllipticRootNumber.inertiaInvariants F ⊥ W') ⧸
          (LinearMap.ker W'.N).comap
            (EllipticRootNumber.inertiaInvariants F ⊥ W').subtype) := by
        rw [Submodule.Quotient.subsingleton_iff, hN, LinearMap.ker_zero, Submodule.comap_top]
      exact LinearMap.det_eq_one_of_subsingleton _
    · rfl
    · rfl
  have hwd : EllipticRootNumber.wdRep F E =
      { V := EllipticRootNumber.VBar F E
        ρ := (EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype
        N := 0 } := by
    unfold EllipticRootNumber.wdRep
    rw [if_pos hE]
  have e2 : EllipticRootNumber.frobDet F ⊥ (EllipticRootNumber.wdRep F E) = 1 :=
    s7 _ (by rw [hwd])
  unfold EllipticRootNumber.localEps EllipticRootNumber.epsWD
  rw [e2, mul_one, hwd]

theorem stdChar_isAdmissibleChar (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] :
    EllipticRootNumber.IsAdmissibleChar F ⊥ (EllipticRootNumber.stdChar F) :=
by
  classical
  suffices spec : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → EllipticRootNumber.stdChar F x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ EllipticRootNumber.stdChar F x ≠ 1 by
    obtain ⟨h0, x, -, hx⟩ := spec
    unfold EllipticRootNumber.IsAdmissibleChar
    exact ⟨AddChar.ne_one_iff.mpr ⟨x, hx⟩, 0, h0⟩
  
  
  have absChar : ∀ (B : AddSubgroup F) (a : F), a ∉ B →
      ∃ ψ : AddChar F (EllipticRootNumber.Ω F), (∀ b ∈ B, ψ b = 1) ∧ ψ a ≠ 1 := by
    intro B a ha
    have hc0 : (a : F ⧸ B) ≠ 0 := by
      intro h; exact ha ((QuotientAddGroup.eq_zero_iff a).mp h)
    have hN1 : addOrderOf (a : F ⧸ B) ≠ 1 := by
      intro h; exact hc0 (AddMonoid.addOrderOf_eq_one_iff.mp h)
    obtain ⟨ζ, hζ0, hζN, hζ1⟩ : ∃ ζ : EllipticRootNumber.Ω F,
        ζ ≠ 0 ∧ ζ ^ addOrderOf (a : F ⧸ B) = 1 ∧ ζ ≠ 1 := by
      by_cases hN0 : addOrderOf (a : F ⧸ B) = 0
      · refine ⟨-1, by norm_num, by rw [hN0, pow_zero], ?_⟩
        intro h
        have h2 : (2 : EllipticRootNumber.Ω F) = 0 := by linear_combination -h
        exact two_ne_zero h2
      · haveI : NeZero ((addOrderOf (a : F ⧸ B) : ℕ) : EllipticRootNumber.Ω F) :=
          ⟨Nat.cast_ne_zero.mpr hN0⟩
        have hdeg := Polynomial.degree_cyclotomic_pos (addOrderOf (a : F ⧸ B))
          (EllipticRootNumber.Ω F) (by omega)
        obtain ⟨ζ, hζ⟩ := IsAlgClosed.exists_root
          (Polynomial.cyclotomic (addOrderOf (a : F ⧸ B)) (EllipticRootNumber.Ω F))
          (ne_of_gt hdeg)
        have hprim : IsPrimitiveRoot ζ (addOrderOf (a : F ⧸ B)) :=
          Polynomial.isRoot_cyclotomic_iff.mp hζ
        refine ⟨ζ, ?_, hprim.pow_eq_one, hprim.ne_one (by omega)⟩
        intro h0
        have h1 := hprim.pow_eq_one
        rw [h0, zero_pow hN0] at h1
        exact zero_ne_one h1
    set u : (EllipticRootNumber.Ω F)ˣ := Units.mk0 ζ hζ0 with hu
    have huN : u ^ ((addOrderOf (a : F ⧸ B) : ℕ) : ℤ) = 1 := by
      rw [zpow_natCast]; ext; simp [hu, hζN]
    have root : ∀ (w : (EllipticRootNumber.Ω F)ˣ) (n : ℤ), n ≠ 0 →
        ∃ x : (EllipticRootNumber.Ω F)ˣ, x ^ n = w := by
      intro w n hn
      have hm : 0 < n.natAbs := Int.natAbs_pos.mpr hn
      rcases Int.natAbs_eq n with h | h
      · obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (w : EllipticRootNumber.Ω F) hm
        have hz0 : z ≠ 0 := by
          rintro rfl; rw [zero_pow hm.ne'] at hz; exact w.ne_zero hz.symm
        refine ⟨Units.mk0 z hz0, ?_⟩
        rw [h, zpow_natCast]; ext; simp [hz]
      · obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq
          ((w⁻¹ : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) hm
        have hz0 : z ≠ 0 := by
          rintro rfl; rw [zero_pow hm.ne'] at hz; exact (w⁻¹).ne_zero hz.symm
        refine ⟨Units.mk0 z hz0, ?_⟩
        have h3 : Units.mk0 z hz0 ^ n.natAbs = w⁻¹ := by ext; simp [hz]
        rw [h, zpow_neg, zpow_natCast, h3, inv_inv]
    letI : DivisibleBy (Additive (EllipticRootNumber.Ω F)ˣ) ℤ :=
      DivisibleBy.mk
        (fun d n => if hn : n = 0 then 0
          else Additive.ofMul (Classical.choose (root (Additive.toMul d) n hn)))
        (fun d => dif_pos rfl)
        (fun {n} d hn => by
          simp only [dif_neg hn]
          rw [← ofMul_zpow, Classical.choose_spec (root (Additive.toMul d) n hn)]
          rfl)
    have hBaer : Module.Baer ℤ (Additive (EllipticRootNumber.Ω F)ˣ) :=
      Module.Baer.of_divisible _
    set h : ℤ →+ F ⧸ B := zmultiplesHom (F ⧸ B) (a : F ⧸ B) with hh
    set g₀ : ℤ →+ Additive (EllipticRootNumber.Ω F)ˣ :=
      zmultiplesHom (Additive (EllipticRootNumber.Ω F)ˣ) (Additive.ofMul u) with hg₀
    have hker : h.ker ≤ g₀.ker := by
      intro n hn
      rw [AddMonoidHom.mem_ker] at hn ⊢
      rw [hh, zmultiplesHom_apply] at hn
      obtain ⟨k, rfl⟩ := addOrderOf_dvd_iff_zsmul_eq_zero.mpr hn
      rw [hg₀, zmultiplesHom_apply, ← ofMul_zpow, zpow_mul, huN, one_zpow]
      rfl
    obtain ⟨G, hG⟩ := Module.Baer.extension_property hBaer
      (QuotientAddGroup.kerLift h).toIntLinearMap (QuotientAddGroup.kerLift_injective h)
      (QuotientAddGroup.lift h.ker g₀ hker).toIntLinearMap
    have hGc : G (a : F ⧸ B) = Additive.ofMul u := by
      have h1 := LinearMap.congr_fun hG ((1 : ℤ) : ℤ ⧸ h.ker)
      change G (QuotientAddGroup.kerLift h ((1 : ℤ) : ℤ ⧸ h.ker)) =
          QuotientAddGroup.lift h.ker g₀ hker ((1 : ℤ) : ℤ ⧸ h.ker) at h1
      rw [QuotientAddGroup.kerLift_mk, QuotientAddGroup.lift_mk, hh, hg₀, zmultiplesHom_apply,
        zmultiplesHom_apply, one_zsmul, one_zsmul] at h1
      exact h1
    refine ⟨AddChar.mk (fun x => ((Additive.toMul (G (x : F ⧸ B)) :
      (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F)) ?_ ?_, ?_, ?_⟩
    · simp
    · intro x y
      simp [QuotientAddGroup.mk_add, map_add, toMul_add]
    · intro b hb
      have hb0 : (b : F ⧸ B) = 0 := (QuotientAddGroup.eq_zero_iff b).mpr hb
      simp [hb0]
    · simp only [AddChar.coe_mk]
      rw [hGc, toMul_ofMul, hu, Units.val_mk0]
      exact hζ1
  
  set ι := IntermediateField.botEquiv F (AlgebraicClosure F) with hι
  set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F with hiso
  
  have hav0 : EllipticRootNumber.addVal F 0 = 0 := by
    unfold EllipticRootNumber.addVal
    exact dif_pos rfl
  have key : ∀ (y : F) (m : Multiplicative ℤ),
      iso (ValuativeRel.valuation F y) = (m : WithZero (Multiplicative ℤ)) →
      EllipticRootNumber.addVal F y = -Multiplicative.toAdd m := by
    intro y m hm
    have hy : y ≠ 0 := by
      rintro rfl
      rw [map_zero, map_zero] at hm
      exact WithZero.zero_ne_coe hm
    unfold EllipticRootNumber.addVal
    rw [dif_neg hy]
    congr 2
    apply WithZero.coe_injective
    rw [WithZero.coe_unzero]
    exact hm
  have hiff : ∀ y : F, 0 ≤ EllipticRootNumber.addVal F y ↔ ValuativeRel.valuation F y ≤ 1 := by
    intro y
    by_cases hy : y = 0
    · subst hy
      rw [hav0, map_zero]
      exact ⟨fun _ => zero_le_one, fun _ => le_rfl⟩
    · have hne : iso (ValuativeRel.valuation F y) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hy)
      obtain ⟨m, hm⟩ : ∃ m : Multiplicative ℤ,
          iso (ValuativeRel.valuation F y) = (m : WithZero (Multiplicative ℤ)) :=
        ⟨_, (WithZero.coe_unzero hne).symm⟩
      rw [key y _ hm, neg_nonneg, ← map_le_map_iff iso, map_one, hm, WithZero.coe_le_one]
      show Multiplicative.toAdd m ≤ Multiplicative.toAdd (1 : Multiplicative ℤ) ↔ m ≤ 1
      exact Multiplicative.toAdd_le
  have hex : ∀ k : ℤ, ∃ y : F, EllipticRootNumber.addVal F y = -k := by
    intro k
    obtain ⟨y, hy⟩ := ValuativeRel.valuation_surjective
      (iso.symm ((Multiplicative.ofAdd k : Multiplicative ℤ) : WithZero (Multiplicative ℤ)))
    refine ⟨y, ?_⟩
    rw [key y (Multiplicative.ofAdd k) (by rw [hy]; exact iso.apply_symm_apply _), toAdd_ofAdd]
  
  have hnorm : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.addVal F (ι x) := by
    intro x
    unfold EllipticRootNumber.relVal
    congr 1
    conv_lhs => rw [← ι.symm_apply_apply x]
    rw [hι, IntermediateField.botEquiv_symm, Algebra.norm_algebraMap,
      IntermediateField.finrank_bot, pow_one]
  
  have hres : EllipticRootNumber.resDeg F ⊥ = 1 := by
    obtain ⟨y₁, hy₁⟩ := hex (-1)
    have hy₁0 : y₁ ≠ 0 := by
      rintro rfl
      rw [hav0] at hy₁
      norm_num at hy₁
    have hmem : (1 : ℕ) ∈ {k : ℕ | 0 < k ∧ ∃ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        x ≠ 0 ∧ EllipticRootNumber.relVal F ⊥ x = k} := by
      refine ⟨one_pos, ι.symm y₁, (map_ne_zero ι.symm).mpr hy₁0, ?_⟩
      rw [hnorm, ι.apply_symm_apply, hy₁]
      norm_num
    unfold EllipticRootNumber.resDeg
    exact le_antisymm (Nat.sInf_le hmem) (Nat.sInf_mem ⟨1, hmem⟩).1
  have hvalL : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.addVal F (ι x) := by
    intro x
    unfold EllipticRootNumber.valL
    rw [hres, hnorm, Nat.cast_one, Int.ediv_one]
  
  obtain ⟨y₀, hy₀⟩ := hex 1
  set B : AddSubgroup F := (ValuativeRel.valuation F).integer.toAddSubgroup with hB
  have hmemB : ∀ t : F, t ∈ B ↔ ValuativeRel.valuation F t ≤ 1 := by
    intro t
    rw [hB, Subring.mem_toAddSubgroup, Valuation.mem_integer_iff]
  have hy₀B : y₀ ∉ B := by
    intro h
    have h1 := (hiff y₀).mpr ((hmemB y₀).mp h)
    rw [hy₀] at h1
    norm_num at h1
  obtain ⟨ψ₀, hψB, hψa⟩ := absChar B y₀ hy₀B
  set ψ := ψ₀.compAddMonoidHom ι.toRingEquiv.toRingHom.toAddMonoidHom with hψ
  have hψapp : ∀ x, ψ x = ψ₀ (ι x) := fun x => rfl
  have hP : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1 := by
    refine ⟨fun x hx => ?_, ι.symm y₀, ?_, ?_⟩
    · rw [hψapp]
      apply hψB
      rw [hmemB, ← hiff, ← hvalL]
      exact hx
    · rw [hvalL, ι.apply_symm_apply, hy₀]
    · rw [hψapp, ι.apply_symm_apply]
      exact hψa
  have hexψ : ∃ φ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F),
      (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → φ x = 1) ∧
        ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ φ x ≠ 1 := ⟨ψ, hP⟩
  unfold EllipticRootNumber.stdChar
  exact Classical.epsilon_spec hexψ

theorem threeRootsCurve_baseChange_variableChange_eventually (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (w : Valuation (AlgebraicClosure F) NNReal)
    (hw₁ : ∀ a : F, w (algebraMap F (AlgebraicClosure F) a) ≤ 1 ↔ ValuativeRel.valuation F a ≤ 1)
    (C : WeierstrassCurve.VariableChange (AlgebraicClosure F)) (t₁ t₂ t₃ : F) :
    ∀ᶠ s : F × F × F in nhds (t₁, t₂, t₃),
      w ((C • (threeRootsCurve s.1 s.2.1 s.2.2).baseChange (AlgebraicClosure F)).a₁ -
          (C • (threeRootsCurve t₁ t₂ t₃).baseChange (AlgebraicClosure F)).a₁) < 1 ∧
      w ((C • (threeRootsCurve s.1 s.2.1 s.2.2).baseChange (AlgebraicClosure F)).a₂ -
          (C • (threeRootsCurve t₁ t₂ t₃).baseChange (AlgebraicClosure F)).a₂) < 1 ∧
      w ((C • (threeRootsCurve s.1 s.2.1 s.2.2).baseChange (AlgebraicClosure F)).a₃ -
          (C • (threeRootsCurve t₁ t₂ t₃).baseChange (AlgebraicClosure F)).a₃) < 1 ∧
      w ((C • (threeRootsCurve s.1 s.2.1 s.2.2).baseChange (AlgebraicClosure F)).a₄ -
          (C • (threeRootsCurve t₁ t₂ t₃).baseChange (AlgebraicClosure F)).a₄) < 1 ∧
      w ((C • (threeRootsCurve s.1 s.2.1 s.2.2).baseChange (AlgebraicClosure F)).a₆ -
          (C • (threeRootsCurve t₁ t₂ t₃).baseChange (AlgebraicClosure F)).a₆) < 1 ∧
      w ((C • (threeRootsCurve s.1 s.2.1 s.2.2).baseChange (AlgebraicClosure F)).Δ -
          (C • (threeRootsCurve t₁ t₂ t₃).baseChange (AlgebraicClosure F)).Δ) < 1 :=
by
  classical
  
  have key : ∀ κ : AlgebraicClosure F, ∀ᶠ a : F in nhds 0,
      w (κ * algebraMap F (AlgebraicClosure F) a) < 1 := by
    intro κ
    obtain ⟨π, hπ0, hπ⟩ := Valuation.IsNontrivial.exists_lt_one (v := ValuativeRel.valuation F)
    have hwπ : w (algebraMap F (AlgebraicClosure F) π) < 1 := by
      by_contra hcon
      push_neg at hcon
      have h1 : w (algebraMap F (AlgebraicClosure F) π⁻¹) ≤ 1 := by
        rw [map_inv₀, map_inv₀]
        exact inv_le_one_of_one_le₀ hcon
      have h2 := (hw₁ _).mp h1
      have h3 : 1 < ValuativeRel.valuation F π⁻¹ :=
        (Valuation.one_lt_val_iff _ (inv_ne_zero hπ0)).mpr (by rw [inv_inv]; exact hπ)
      exact absurd h2 (not_le.mpr h3)
    obtain ⟨n, hn⟩ := NNReal.exists_pow_lt_of_lt_one
      (inv_pos.mpr (add_pos_of_nonneg_of_pos (zero_le (w κ)) zero_lt_one)) hwπ
    have hc0 : π ^ n ≠ 0 := pow_ne_zero _ hπ0
    have hwc : w (algebraMap F (AlgebraicClosure F) (π ^ n)) =
        w (algebraMap F (AlgebraicClosure F) π) ^ n := by
      rw [map_pow, map_pow]
    have hMc : w κ * w (algebraMap F (AlgebraicClosure F) (π ^ n)) < 1 := by
      rw [hwc]
      have hpos : (0 : NNReal) < w κ + 1 := add_pos_of_nonneg_of_pos (zero_le _) zero_lt_one
      calc w κ * w (algebraMap F (AlgebraicClosure F) π) ^ n
          ≤ (w κ + 1) * w (algebraMap F (AlgebraicClosure F) π) ^ n :=
            mul_le_mul_of_nonneg_right (le_add_of_nonneg_right zero_le_one) (zero_le _)
        _ < (w κ + 1) * (w κ + 1)⁻¹ := mul_lt_mul_of_pos_left hn hpos
        _ = 1 := mul_inv_cancel₀ hpos.ne'
    have hvc : ValuativeRel.valuation F (π ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr hc0
    have hnhds : {x : F | ValuativeRel.valuation F x < ValuativeRel.valuation F (π ^ n)} ∈
        nhds (0 : F) :=
      (IsValuativeTopology.mem_nhds_zero_iff _).mpr ⟨Units.mk0 _ hvc, by simp⟩
    filter_upwards [hnhds] with a ha
    have hdiv : ValuativeRel.valuation F (a / π ^ n) ≤ 1 := by
      rw [Valuation.map_div]
      exact (div_le_one₀ (zero_lt_iff.mpr hvc)).mpr (le_of_lt ha)
    have hw2 := (hw₁ _).mpr hdiv
    have hac : algebraMap F (AlgebraicClosure F) a =
        algebraMap F (AlgebraicClosure F) (π ^ n) *
          algebraMap F (AlgebraicClosure F) (a / π ^ n) := by
      rw [← map_mul, mul_div_cancel₀ a hc0]
    rw [hac, map_mul, map_mul, ← mul_assoc]
    calc w κ * w (algebraMap F (AlgebraicClosure F) (π ^ n)) *
          w (algebraMap F (AlgebraicClosure F) (a / π ^ n))
        ≤ w κ * w (algebraMap F (AlgebraicClosure F) (π ^ n)) * 1 :=
          mul_le_mul_of_nonneg_left hw2 (zero_le _)
      _ < 1 := by rw [mul_one]; exact hMc
  
  have comp : ∀ (κ : AlgebraicClosure F) (g : F × F × F → F), Continuous g →
      g (t₁, t₂, t₃) = 0 →
      ∀ᶠ s in nhds (t₁, t₂, t₃), w (κ * algebraMap F (AlgebraicClosure F) (g s)) < 1 := by
    intro κ g hg hg0
    have h := hg.tendsto (t₁, t₂, t₃)
    rw [hg0] at h
    exact h.eventually (key κ)
  
  have bc : ∀ a₁ a₂ a₃ : F, (threeRootsCurve a₁ a₂ a₃).baseChange (AlgebraicClosure F) =
      threeRootsCurve (algebraMap F (AlgebraicClosure F) a₁) (algebraMap F (AlgebraicClosure F) a₂)
        (algebraMap F (AlgebraicClosure F) a₃) := by
    intro a₁ a₂ a₃
    ext <;> simp [threeRootsCurve, WeierstrassCurve.baseChange, WeierstrassCurve.map]
  have hΔ : ∀ x y z : AlgebraicClosure F,
      (threeRootsCurve x y z).Δ = 16 * ((x - y) * (x - z) * (y - z)) ^ 2 := by
    intro x y z
    simp only [WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
      WeierstrassCurve.b₆, WeierstrassCurve.b₈, threeRootsCurve]
    ring
  have E₁ := comp (((C.u⁻¹ : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) ^ 2)
    (fun s => (t₁ + t₂ + t₃) - (s.1 + s.2.1 + s.2.2)) (by fun_prop) (by simp)
  have E₂ := comp (((C.u⁻¹ : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) ^ 4)
    (fun s => (s.1 * s.2.1 + s.1 * s.2.2 + s.2.1 * s.2.2) - (t₁ * t₂ + t₁ * t₃ + t₂ * t₃))
    (by fun_prop) (by simp)
  have E₃ := comp (((C.u⁻¹ : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) ^ 4 * 2 * C.r)
    (fun s => (t₁ + t₂ + t₃) - (s.1 + s.2.1 + s.2.2)) (by fun_prop) (by simp)
  have E₄ := comp (((C.u⁻¹ : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) ^ 6)
    (fun s => t₁ * t₂ * t₃ - s.1 * s.2.1 * s.2.2) (by fun_prop) (by simp)
  have E₅ := comp (((C.u⁻¹ : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) ^ 6 * C.r)
    (fun s => (s.1 * s.2.1 + s.1 * s.2.2 + s.2.1 * s.2.2) - (t₁ * t₂ + t₁ * t₃ + t₂ * t₃))
    (by fun_prop) (by simp)
  have E₆ := comp (((C.u⁻¹ : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) ^ 6 * C.r ^ 2)
    (fun s => (t₁ + t₂ + t₃) - (s.1 + s.2.1 + s.2.2)) (by fun_prop) (by simp)
  have E₇ := comp (((C.u⁻¹ : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) ^ 12)
    (fun s => 16 * ((s.1 - s.2.1) * (s.1 - s.2.2) * (s.2.1 - s.2.2)) ^ 2 -
      16 * ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) ^ 2) (by fun_prop) (by simp)
  filter_upwards [E₁, E₂, E₃, E₄, E₅, E₆, E₇] with s h₁ h₂ h₃ h₄ h₅ h₆ h₇
  rw [bc s.1 s.2.1 s.2.2, bc t₁ t₂ t₃]
  simp only [WeierstrassCurve.variableChange_a₁, WeierstrassCurve.variableChange_a₂,
    WeierstrassCurve.variableChange_a₃, WeierstrassCurve.variableChange_a₄,
    WeierstrassCurve.variableChange_a₆, WeierstrassCurve.variableChange_Δ, hΔ]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · simp [threeRootsCurve]
  · refine lt_of_eq_of_lt (congrArg w ?_) h₁
    simp only [threeRootsCurve, map_sub, map_add, map_mul, map_neg]
    ring
  · simp [threeRootsCurve]
  · refine lt_of_eq_of_lt (congrArg w ?_) (Valuation.map_add_lt w h₂ h₃)
    simp only [threeRootsCurve, map_sub, map_add, map_mul, map_neg]
    ring
  · refine lt_of_eq_of_lt (congrArg w ?_)
      (Valuation.map_add_lt w (Valuation.map_add_lt w h₄ h₅) h₆)
    simp only [threeRootsCurve, map_sub, map_add, map_mul, map_neg]
    ring
  · refine lt_of_eq_of_lt (congrArg w ?_) h₇
    simp only [map_sub, map_mul, map_pow, map_ofNat]
    ring

theorem variableChange_goodModel_rigid {K : Type*} [Field K] (w : Valuation K NNReal)
    (W : WeierstrassCurve K) (C C' : WeierstrassCurve.VariableChange K)
    (h₁ : w (C • W).a₁ ≤ 1) (h₂ : w (C • W).a₂ ≤ 1) (h₃ : w (C • W).a₃ ≤ 1)
    (h₄ : w (C • W).a₄ ≤ 1) (h₆ : w (C • W).a₆ ≤ 1) (hΔ : w (C • W).Δ = 1)
    (h₁' : w (C' • W).a₁ ≤ 1) (h₂' : w (C' • W).a₂ ≤ 1) (h₃' : w (C' • W).a₃ ≤ 1)
    (h₄' : w (C' • W).a₄ ≤ 1) (h₆' : w (C' • W).a₆ ≤ 1) (hΔ' : w (C' • W).Δ = 1) :
    w (C.u : K) = w (C'.u : K) ∧ w (C'.s - C.s) ≤ w (C.u : K) :=
by
  
  have dom : ∀ (n : ℕ) (c : ℕ → K) (z : K), (∀ i < n, w (c i) ≤ 1) →
      z ^ n = ∑ i ∈ Finset.range n, c i * z ^ i → w z ≤ 1 := by
    intro n c z hc hz
    by_contra hlt
    push_neg at hlt
    cases n with
    | zero => simp at hz
    | succ m =>
      have hle : w (∑ i ∈ Finset.range (m + 1), c i * z ^ i) ≤ w z ^ m := by
        apply Valuation.map_sum_le
        intro i hi
        have hi' := Finset.mem_range.mp hi
        rw [map_mul, map_pow]
        calc w (c i) * w z ^ i ≤ 1 * w z ^ i := mul_le_mul_right' (hc i hi') _
          _ = w z ^ i := one_mul _
          _ ≤ w z ^ m := pow_le_pow_right₀ hlt.le (Nat.lt_succ_iff.mp hi')
      rw [← hz, map_pow] at hle
      exact absurd hle (not_le.mpr (pow_lt_pow_right₀ hlt (Nat.lt_succ_self m)))
  have natle : ∀ n : ℕ, w (n : K) ≤ 1 := by
    intro n
    induction n with
    | zero => rw [Nat.cast_zero, map_zero]; exact zero_le'
    | succ n ih =>
      rw [Nat.cast_succ]
      exact (Valuation.map_add _ _ _).trans (max_le ih (by rw [map_one]))
  have iadd : ∀ x y : K, w x ≤ 1 → w y ≤ 1 → w (x + y) ≤ 1 :=
    fun x y hx hy => (Valuation.map_add _ _ _).trans (max_le hx hy)
  have isub : ∀ x y : K, w x ≤ 1 → w y ≤ 1 → w (x - y) ≤ 1 :=
    fun x y hx hy => (Valuation.map_sub _ _ _).trans (max_le hx hy)
  have imul : ∀ x y : K, w x ≤ 1 → w y ≤ 1 → w (x * y) ≤ 1 :=
    fun x y hx hy => by rw [map_mul]; exact mul_le_one' hx hy
  have ineg : ∀ x : K, w x ≤ 1 → w (-x) ≤ 1 := fun x hx => by rw [Valuation.map_neg]; exact hx
  have ipow : ∀ (x : K) (n : ℕ), w x ≤ 1 → w (x ^ n) ≤ 1 :=
    fun x n hx => by rw [map_pow]; exact pow_le_one₀ (zero_le _) hx
  have n2 : w (2 : K) ≤ 1 := by exact_mod_cast natle 2
  have n3 : w (3 : K) ≤ 1 := by exact_mod_cast natle 3
  have n4 : w (4 : K) ≤ 1 := by exact_mod_cast natle 4
  have n8 : w (8 : K) ≤ 1 := by exact_mod_cast natle 8
  have n9 : w (9 : K) ≤ 1 := by exact_mod_cast natle 9
  have n16 : w (16 : K) ≤ 1 := by exact_mod_cast natle 16
  have n27 : w (27 : K) ≤ 1 := by exact_mod_cast natle 27
  
  obtain ⟨W₁, hW₁⟩ : ∃ X, X = C • W := ⟨_, rfl⟩
  obtain ⟨D, hD⟩ : ∃ X, X = C' * C⁻¹ := ⟨_, rfl⟩
  have hCW : C' • W = D • W₁ := by rw [hD, hW₁, ← mul_smul, inv_mul_cancel_right]
  rw [← hW₁] at h₁ h₂ h₃ h₄ h₆ hΔ
  rw [hCW] at h₁' h₂' h₃' h₄' h₆' hΔ'
  have hDu : (D.u : K) * (C.u : K) = (C'.u : K) := by
    rw [hD, ← Units.val_mul]
    show ((C'.u * C.u⁻¹ * C.u : Kˣ) : K) = C'.u
    rw [inv_mul_cancel_right]
  have hDs : (C.u : K) * D.s = C'.s - C.s := by
    rw [hD]
    show (C.u : K) * (((C.u⁻¹ : Kˣ) : K) * C'.s + -C.s * ((C.u⁻¹ : Kˣ) : K)) = C'.s - C.s
    linear_combination (C'.s - C.s) * (Units.mul_inv C.u)
  
  have hv : w ((D.u⁻¹ : Kˣ) : K) = 1 := by
    rw [WeierstrassCurve.variableChange_Δ, map_mul, map_pow, hΔ, mul_one] at hΔ'
    exact (pow_eq_one_iff_of_nonneg (zero_le _) (by norm_num)).mp hΔ'
  have hu : w (D.u : K) = 1 := by
    have h := congrArg w (Units.mul_inv D.u)
    rw [map_mul, map_one, hv, mul_one] at h
    exact h
  
  have hb2 : w W₁.b₂ ≤ 1 := by
    rw [WeierstrassCurve.b₂]; exact iadd _ _ (ipow _ _ h₁) (imul _ _ n4 h₂)
  have hb4 : w W₁.b₄ ≤ 1 := by
    rw [WeierstrassCurve.b₄]; exact iadd _ _ (imul _ _ n2 h₄) (imul _ _ h₁ h₃)
  have hb6 : w W₁.b₆ ≤ 1 := by
    rw [WeierstrassCurve.b₆]; exact iadd _ _ (ipow _ _ h₃) (imul _ _ n4 h₆)
  have hb8 : w W₁.b₈ ≤ 1 := by
    rw [WeierstrassCurve.b₈]
    exact isub _ _ (iadd _ _ (isub _ _ (iadd _ _ (imul _ _ (ipow _ _ h₁) h₆)
      (imul _ _ (imul _ _ n4 h₂) h₆)) (imul _ _ (imul _ _ h₁ h₃) h₄))
      (imul _ _ h₂ (ipow _ _ h₃))) (ipow _ _ h₄)
  have hb6' : w (D • W₁).b₆ ≤ 1 := by
    rw [WeierstrassCurve.b₆]; exact iadd _ _ (ipow _ _ h₃') (imul _ _ n4 h₆')
  have hb8' : w (D • W₁).b₈ ≤ 1 := by
    rw [WeierstrassCurve.b₈]
    exact isub _ _ (iadd _ _ (isub _ _ (iadd _ _ (imul _ _ (ipow _ _ h₁') h₆')
      (imul _ _ (imul _ _ n4 h₂') h₆')) (imul _ _ (imul _ _ h₁' h₃') h₄'))
      (imul _ _ h₂' (ipow _ _ h₃'))) (ipow _ _ h₄')
  obtain ⟨r, hr⟩ : ∃ x, x = D.r := ⟨_, rfl⟩
  obtain ⟨P, hP⟩ : ∃ x, x = W₁.b₆ + 2 * r * W₁.b₄ + r ^ 2 * W₁.b₂ + 4 * r ^ 3 := ⟨_, rfl⟩
  obtain ⟨Q, hQ⟩ : ∃ x, x = W₁.b₈ + 3 * r * W₁.b₆ + 3 * r ^ 2 * W₁.b₄ + r ^ 3 * W₁.b₂ +
      3 * r ^ 4 := ⟨_, rfl⟩
  have hPi : w P ≤ 1 := by
    rw [WeierstrassCurve.variableChange_b₆, map_mul, map_pow, hv, one_pow, one_mul, ← hr,
      ← hP] at hb6'
    exact hb6'
  have hQi : w Q ≤ 1 := by
    rw [WeierstrassCurve.variableChange_b₈, map_mul, map_pow, hv, one_pow, one_mul, ← hr,
      ← hQ] at hb8'
    exact hb8'
  have h4r : w (4 * r) ≤ 1 := by
    refine dom 3 (fun i => if i = 0 then 16 * P - 16 * W₁.b₆ else if i = 1 then -8 * W₁.b₄
      else -W₁.b₂) (4 * r) ?_ ?_
    · intro i hi
      rcases i with _ | _ | _ | i
      · show w (16 * P - 16 * W₁.b₆) ≤ 1
        exact isub _ _ (imul _ _ n16 hPi) (imul _ _ n16 hb6)
      · show w (-8 * W₁.b₄) ≤ 1
        rw [neg_mul]; exact ineg _ (imul _ _ n8 hb4)
      · show w (-W₁.b₂) ≤ 1
        exact ineg _ hb2
      · omega
    · rw [Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_succ,
        Finset.sum_range_zero]
      show (4 * r) ^ 3 = 0 + (16 * P - 16 * W₁.b₆) * (4 * r) ^ 0 + (-8 * W₁.b₄) * (4 * r) ^ 1 +
        (-W₁.b₂) * (4 * r) ^ 2
      rw [hP]; ring
  have h3r : w (3 * r) ≤ 1 := by
    refine dom 4 (fun i => if i = 0 then 27 * Q - 27 * W₁.b₈ else if i = 1 then -27 * W₁.b₆
      else if i = 2 then -9 * W₁.b₄ else -W₁.b₂) (3 * r) ?_ ?_
    · intro i hi
      rcases i with _ | _ | _ | _ | i
      · show w (27 * Q - 27 * W₁.b₈) ≤ 1
        exact isub _ _ (imul _ _ n27 hQi) (imul _ _ n27 hb8)
      · show w (-27 * W₁.b₆) ≤ 1
        rw [neg_mul]; exact ineg _ (imul _ _ n27 hb6)
      · show w (-9 * W₁.b₄) ≤ 1
        rw [neg_mul]; exact ineg _ (imul _ _ n9 hb4)
      · show w (-W₁.b₂) ≤ 1
        exact ineg _ hb2
      · omega
    · rw [Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_succ,
        Finset.sum_range_succ, Finset.sum_range_zero]
      show (3 * r) ^ 4 = 0 + (27 * Q - 27 * W₁.b₈) * (3 * r) ^ 0 + (-27 * W₁.b₆) * (3 * r) ^ 1 +
        (-9 * W₁.b₄) * (3 * r) ^ 2 + (-W₁.b₂) * (3 * r) ^ 3
      rw [hQ]; ring
  have hri : w r ≤ 1 := by
    have e : r = 4 * r - 3 * r := by ring
    rw [e]; exact isub _ _ h4r h3r
  
  obtain ⟨s, hs⟩ : ∃ x, x = D.s := ⟨_, rfl⟩
  obtain ⟨X, hX⟩ : ∃ x, x = W₁.a₂ - s * W₁.a₁ + 3 * r - s ^ 2 := ⟨_, rfl⟩
  have hXi : w X ≤ 1 := by
    rw [WeierstrassCurve.variableChange_a₂, map_mul, map_pow, hv, one_pow, one_mul, ← hr,
      ← hs, ← hX] at h₂'
    exact h₂'
  have hsi : w s ≤ 1 := by
    refine dom 2 (fun i => if i = 0 then W₁.a₂ + 3 * r - X else -W₁.a₁) s ?_ ?_
    · intro i hi
      rcases i with _ | _ | i
      · show w (W₁.a₂ + 3 * r - X) ≤ 1
        exact isub _ _ (iadd _ _ h₂ (imul _ _ n3 hri)) hXi
      · show w (-W₁.a₁) ≤ 1
        exact ineg _ h₁
      · omega
    · rw [Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_zero]
      show s ^ 2 = 0 + (W₁.a₂ + 3 * r - X) * s ^ 0 + (-W₁.a₁) * s ^ 1
      rw [hX]; ring
  refine ⟨?_, ?_⟩
  · rw [← hDu, map_mul, hu, one_mul]
  · rw [← hDs, map_mul, ← hs]
    exact mul_le_of_le_one_right' hsi

theorem weierstrass_integral_of_nsmul_eq_zero {K : Type*} [Field K] [DecidableEq K]
    (w : Valuation K NNReal) (W : WeierstrassCurve K) (h₁ : w W.a₁ ≤ 1) (h₂ : w W.a₂ ≤ 1)
    (h₃ : w W.a₃ ≤ 1) (h₄ : w W.a₄ ≤ 1) (h₆ : w W.a₆ ≤ 1) (m : ℕ) (hm : w (m : K) = 1) {x y : K}
    (h : W.toAffine.Nonsingular x y) (hmh : m • WeierstrassCurve.Affine.Point.some h = 0) :
    w x ≤ 1 ∧ w y ≤ 1 :=
by
  classical
  have hb := weierstrass_E1_basic w W h₁ h₂ h₃ h₄ h₆ h.1
  have hnat : ∀ n : ℕ, w (n : K) ≤ 1 := by
    intro n
    induction n with
    | zero => rw [Nat.cast_zero, map_zero]; exact zero_le'
    | succ n ih =>
      rw [Nat.cast_succ]
      exact (Valuation.map_add _ _ _).trans (max_le ih (by rw [map_one]))
  have hxle : w x ≤ 1 := by
    by_contra hxn
    have hx : 1 < w x := lt_of_not_ge hxn
    obtain ⟨hy2, hρ1, hneg⟩ := hb.2 hx
    have hx0 : x ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hx
      exact absurd hx (not_lt.mpr zero_le')
    have hy0 : y ≠ 0 := by
      intro h0
      rw [h0, map_zero, zero_pow two_ne_zero] at hy2
      have h3 : w x = 0 := (pow_eq_zero_iff (n := 3) (by norm_num)).mp hy2.symm
      rw [h3] at hx
      exact absurd hx (not_lt.mpr zero_le')
    have hρ0 : 0 < w (x / y) :=
      pos_iff_ne_zero.mpr ((Valuation.ne_zero_iff w).mpr (div_ne_zero hx0 hy0))
    have hρlt : w (x / y) ^ 2 < w (x / y) := by
      rw [pow_two]; exact mul_lt_of_lt_one_right hρ0 hρ1
    have hρρ : w (x / y) ^ 2 ≤ w (x / y) := hρlt.le
    have hm0 : 0 < m := by
      rcases Nat.eq_zero_or_pos m with h0 | h0
      · rw [h0, Nat.cast_zero, map_zero] at hm; exact absurd hm zero_ne_one
      · exact h0
    obtain ⟨P, hP⟩ : ∃ P, P = WeierstrassCurve.Affine.Point.some h := ⟨_, rfl⟩
    rw [← hP] at hmh
    have hfin : IsOfFinAddOrder P := isOfFinAddOrder_iff_nsmul_eq_zero.mpr ⟨m, hm0, hmh⟩
    obtain ⟨k, hk⟩ : ∃ k, addOrderOf P = k := ⟨_, rfl⟩
    have hk0 : 0 < k := hk ▸ hfin.addOrderOf_pos
    have hkP : k • P = 0 := hk ▸ addOrderOf_nsmul_eq_zero P
    have hkdvd : k ∣ m := hk ▸ addOrderOf_dvd_of_nsmul_eq_zero hmh
    have hkmin : ∀ n, 0 < n → n • P = 0 → k ≤ n := fun n hn hnP =>
      hk ▸ addOrderOf_le_of_nsmul_eq_zero hn hnP
    have hk1 : k ≠ 1 := by
      intro h1
      rw [h1, one_nsmul, hP] at hkP
      exact WeierstrassCurve.Affine.Point.some_ne_zero h hkP
    have hwk : w (k : K) = 1 := by
      obtain ⟨q, hq⟩ := hkdvd
      have e : w (m : K) = w (k : K) * w (q : K) := by rw [hq, Nat.cast_mul, map_mul]
      rw [hm] at e
      refine le_antisymm (hnat k) ?_
      calc (1 : NNReal) = w (k : K) * w (q : K) := e
        _ ≤ w (k : K) * 1 := mul_le_mul_left' (hnat q) _
        _ = w (k : K) := mul_one _
    have key : ∀ j, 1 ≤ j → j < k → ∃ (xj yj : K) (hj : W.toAffine.Nonsingular xj yj),
        j • P = WeierstrassCurve.Affine.Point.some hj ∧ 1 < w xj ∧
          w (xj / yj - (j : K) * (x / y)) ≤ w (x / y) ^ 2 := by
      intro j hj1
      induction j, hj1 using Nat.le_induction with
      | base =>
        intro _
        refine ⟨x, y, h, by rw [one_nsmul, hP], hx, ?_⟩
        rw [Nat.cast_one, one_mul, sub_self, map_zero]; exact zero_le'
      | succ j hj1 ih =>
        intro hjk
        obtain ⟨xj, yj, hj, hjP, hxj, herr⟩ := ih (by omega)
        have hne : ¬(xj = x ∧ yj = W.toAffine.negY x y) := by
          rintro ⟨hxe, hye⟩
          have h0 : WeierstrassCurve.Affine.Point.some hj + WeierstrassCurve.Affine.Point.some h = 0 :=
            WeierstrassCurve.Affine.Point.add_of_Y_eq hxe hye
          have h1 : (j + 1) • P = 0 := by rw [succ_nsmul, hjP, hP, h0]
          have := hkmin (j + 1) (Nat.succ_pos j) h1
          omega
        obtain ⟨x', y', h', hadd, hx', E⟩ :=
          weierstrass_E1_add_estimate w W h₁ h₂ h₃ h₄ h₆ hj h hxj hx hne
        have hbd : w (xj / yj) ≤ w (x / y) := by
          have e : xj / yj = (xj / yj - (j : K) * (x / y)) + (j : K) * (x / y) := by ring
          rw [e]
          refine (Valuation.map_add _ _ _).trans (max_le (herr.trans hρρ) ?_)
          rw [map_mul]
          calc w (j : K) * w (x / y) ≤ 1 * w (x / y) := mul_le_mul_right' (hnat j) _
            _ = w (x / y) := one_mul _
        rw [max_eq_right hbd] at E
        refine ⟨x', y', h', ?_, hx', ?_⟩
        · rw [succ_nsmul, hjP, hP, hadd]
        · have e : x' / y' - ((j + 1 : ℕ) : K) * (x / y) =
              (x' / y' - xj / yj - x / y) + (xj / yj - (j : K) * (x / y)) := by
            push_cast; ring
          rw [e]
          exact (Valuation.map_add _ _ _).trans (max_le E herr)
    obtain ⟨x', y', h', hP', -, herr'⟩ := key (k - 1) (by omega) (by omega)
    have hsum : (k - 1) • P + P = 0 := by
      rw [← succ_nsmul, Nat.sub_add_cancel hk0]; exact hkP
    rw [hP'] at hsum
    have hnegP := eq_neg_of_add_eq_zero_left hsum
    rw [hP, WeierstrassCurve.Affine.Point.neg_some, WeierstrassCurve.Affine.Point.some.injEq]
      at hnegP
    obtain ⟨hxe, hye⟩ := hnegP
    have hcast : ((k - 1 : ℕ) : K) = (k : K) - 1 := Nat.cast_pred hk0
    rw [hcast, hxe, hye] at herr'
    have e : (k : K) * (x / y) = (x / W.toAffine.negY x y + x / y) -
        (x / W.toAffine.negY x y - ((k : K) - 1) * (x / y)) := by ring
    have hle : w ((k : K) * (x / y)) ≤ w (x / y) ^ 2 := by
      rw [e]; exact (Valuation.map_sub _ _ _).trans (max_le hneg herr')
    rw [map_mul, hwk, one_mul] at hle
    exact absurd hle (not_le.mpr hρlt)
  exact ⟨hxle, hb.1 hxle⟩

theorem weierstrass_eq_of_close_of_nsmul_eq_zero {K : Type*} [Field K] [DecidableEq K]
    (w : Valuation K NNReal) (W : WeierstrassCurve K)
    (h₁ : w W.a₁ ≤ 1) (h₂ : w W.a₂ ≤ 1) (h₃ : w W.a₃ ≤ 1) (h₄ : w W.a₄ ≤ 1) (h₆ : w W.a₆ ≤ 1)
    (hΔ : w W.Δ = 1) (m : ℕ) (hm : w (m : K) = 1) {x y x' y' : K}
    (h : W.toAffine.Nonsingular x y) (h' : W.toAffine.Nonsingular x' y')
    (hP : m • WeierstrassCurve.Affine.Point.some h = 0)
    (hQ : m • WeierstrassCurve.Affine.Point.some h' = 0)
    (hx : w (x - x') < 1) (hy : w (y - y') < 1) :
    x = x' ∧ y = y' :=
by
  
  obtain ⟨hxi, hyi⟩ := weierstrass_integral_of_nsmul_eq_zero w W h₁ h₂ h₃ h₄ h₆ m hm h hP
  obtain ⟨hxi', hyi'⟩ := weierstrass_integral_of_nsmul_eq_zero w W h₁ h₂ h₃ h₄ h₆ m hm h' hQ
  have hx' : w (x' - x) < 1 := by rwa [Valuation.map_sub_swap]
  have hy' : w (y' - y) < 1 := by rwa [Valuation.map_sub_swap]
  
  rcases weierstrass_sub_eq_zero_or_one_lt_of_close w W h₁ h₂ h₃ h₄ h₆ hΔ h h' hxi hyi hxi' hyi'
      hx' hy' with h0 | ⟨x₃, y₃, hP₃, heq, hlt⟩
  · have hQP := sub_eq_zero.mp h0
    rw [WeierstrassCurve.Affine.Point.some.injEq] at hQP
    exact ⟨hQP.1.symm, hQP.2.symm⟩
  · exfalso
    
    have hm3 : m • WeierstrassCurve.Affine.Point.some hP₃ = 0 := by
      rw [← heq, nsmul_sub, hP, hQ, sub_zero]
    have hint := (weierstrass_integral_of_nsmul_eq_zero w W h₁ h₂ h₃ h₄ h₆ m hm hP₃ hm3).1
    exact absurd hlt (not_lt.mpr hint)

theorem weierstrass_nsmul_lift_of_close {K : Type*} [Field K] [IsAlgClosed K] [CharZero K]
    [DecidableEq K] (w : Valuation K NNReal) (W₁ W₂ : WeierstrassCurve K)
    (h₁ : w W₁.a₁ ≤ 1) (h₂ : w W₁.a₂ ≤ 1) (h₃ : w W₁.a₃ ≤ 1) (h₄ : w W₁.a₄ ≤ 1)
    (h₆ : w W₁.a₆ ≤ 1) (hΔ : w W₁.Δ = 1)
    (h₁' : w W₂.a₁ ≤ 1) (h₂' : w W₂.a₂ ≤ 1) (h₃' : w W₂.a₃ ≤ 1) (h₄' : w W₂.a₄ ≤ 1)
    (h₆' : w W₂.a₆ ≤ 1) (hΔ' : w W₂.Δ = 1)
    (c₁ : w (W₁.a₁ - W₂.a₁) < 1) (c₂ : w (W₁.a₂ - W₂.a₂) < 1) (c₃ : w (W₁.a₃ - W₂.a₃) < 1)
    (c₄ : w (W₁.a₄ - W₂.a₄) < 1) (c₆ : w (W₁.a₆ - W₂.a₆) < 1)
    (N : ℕ) (hN : 0 < N) (hwN : w (N : K) = 1)
    {x y : K} (h : W₁.toAffine.Nonsingular x y)
    (hP : N • WeierstrassCurve.Affine.Point.some h = 0) :
    ∃ (x' y' : K) (h' : W₂.toAffine.Nonsingular x' y'),
      N • WeierstrassCurve.Affine.Point.some h' = 0 ∧ w (x - x') < 1 ∧ w (y - y') < 1 :=
by
  
  have natle : ∀ k : ℕ, w (k : K) ≤ 1 := by
    intro k
    induction k with
    | zero => rw [Nat.cast_zero, map_zero]; exact zero_le'
    | succ n ih =>
      rw [Nat.cast_succ]
      exact (Valuation.map_add _ _ _).trans (max_le ih (by rw [map_one]))
  have hΔ0' : W₂.Δ ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hΔ'
    exact zero_ne_one hΔ'
  
  obtain ⟨G, hG⟩ : ∃ G : K → K → Prop, ∀ a a', G a a' ↔ (w a ≤ 1 ∧ w (a - a') < 1) :=
    ⟨_, fun _ _ => Iff.rfl⟩
  have Gint : ∀ a a', G a a' → w a' ≤ 1 := by
    intro a a' h
    rw [hG] at h
    have e : a' = a - (a - a') := by ring
    rw [e]
    exact (Valuation.map_sub _ _ _).trans (max_le h.1 h.2.le)
  have Grefl : ∀ a, w a ≤ 1 → G a a := by
    intro a ha
    rw [hG, sub_self, map_zero]
    exact ⟨ha, zero_lt_one⟩
  have Gadd : ∀ a a' b b', G a a' → G b b' → G (a + b) (a' + b') := by
    intro a a' b b' ha hb
    rw [hG] at ha hb ⊢
    refine ⟨(Valuation.map_add _ _ _).trans (max_le ha.1 hb.1), ?_⟩
    rw [show a + b - (a' + b') = (a - a') + (b - b') by ring]
    exact Valuation.map_add_lt _ ha.2 hb.2
  have Gsub : ∀ a a' b b', G a a' → G b b' → G (a - b) (a' - b') := by
    intro a a' b b' ha hb
    rw [hG] at ha hb ⊢
    refine ⟨(Valuation.map_sub _ _ _).trans (max_le ha.1 hb.1), ?_⟩
    rw [show a - b - (a' - b') = (a - a') - (b - b') by ring]
    exact lt_of_le_of_lt (Valuation.map_sub _ _ _) (max_lt ha.2 hb.2)
  have Gmul : ∀ a a' b b', G a a' → G b b' → G (a * b) (a' * b') := by
    intro a a' b b' ha hb
    have hb' := Gint _ _ hb
    rw [hG] at ha hb ⊢
    refine ⟨by rw [map_mul]; exact mul_le_one' ha.1 hb.1, ?_⟩
    rw [show a * b - a' * b' = a * (b - b') + (a - a') * b' by ring]
    refine Valuation.map_add_lt _ ?_ ?_
    · rw [map_mul]; exact lt_of_le_of_lt (mul_le_of_le_one_left' ha.1) hb.2
    · rw [map_mul]; exact lt_of_le_of_lt (mul_le_of_le_one_right' hb') ha.2
  have Gpow : ∀ a a' (k : ℕ), G a a' → G (a ^ k) (a' ^ k) := by
    intro a a' k h
    induction k with
    | zero => simp only [pow_zero]; exact Grefl 1 (by rw [map_one])
    | succ k ih => simp only [pow_succ]; exact Gmul _ _ _ _ ih h
  have G1 : G (1 : K) 1 := Grefl 1 (by rw [map_one])
  have G0 : G (0 : K) 0 := Grefl 0 (by rw [map_zero]; exact zero_le')
  have G2 : G (2 : K) 2 := by
    have := Grefl _ (natle 2)
    rwa [Nat.cast_ofNat] at this
  have G4 : G (4 : K) 4 := by
    have := Grefl _ (natle 4)
    rwa [Nat.cast_ofNat] at this
  have g1 : G W₁.a₁ W₂.a₁ := (hG _ _).mpr ⟨h₁, c₁⟩
  have g2 : G W₁.a₂ W₂.a₂ := (hG _ _).mpr ⟨h₂, c₂⟩
  have g3 : G W₁.a₃ W₂.a₃ := (hG _ _).mpr ⟨h₃, c₃⟩
  have g4 : G W₁.a₄ W₂.a₄ := (hG _ _).mpr ⟨h₄, c₄⟩
  have g6 : G W₁.a₆ W₂.a₆ := (hG _ _).mpr ⟨h₆, c₆⟩
  have gb2 : G W₁.b₂ W₂.b₂ := by
    simp only [WeierstrassCurve.b₂]
    exact Gadd _ _ _ _ (Gpow _ _ 2 g1) (Gmul _ _ _ _ G4 g2)
  have gb4 : G W₁.b₄ W₂.b₄ := by
    simp only [WeierstrassCurve.b₄]
    exact Gadd _ _ _ _ (Gmul _ _ _ _ G2 g4) (Gmul _ _ _ _ g1 g3)
  have gb6 : G W₁.b₆ W₂.b₆ := by
    simp only [WeierstrassCurve.b₆]
    exact Gadd _ _ _ _ (Gpow _ _ 2 g3) (Gmul _ _ _ _ G4 g6)
  have gb8 : G W₁.b₈ W₂.b₈ := by
    simp only [WeierstrassCurve.b₈]
    exact Gsub _ _ _ _ (Gadd _ _ _ _ (Gsub _ _ _ _ (Gadd _ _ _ _
      (Gmul _ _ _ _ (Gpow _ _ 2 g1) g6) (Gmul _ _ _ _ (Gmul _ _ _ _ G4 g2) g6))
      (Gmul _ _ _ _ (Gmul _ _ _ _ g1 g3) g4)) (Gmul _ _ _ _ g2 (Gpow _ _ 2 g3))) (Gpow _ _ 2 g4)
  
  obtain ⟨hx, hy⟩ := weierstrass_integral_of_nsmul_eq_zero w W₁ h₁ h₂ h₃ h₄ h₆ N hwN h hP
  have Gx : G x x := Grefl x hx
  
  have hZ1 : (ladderXZ W₁ N).2.eval x = 0 := (ladderXZ_eval_nsmul W₁ N hN h).1 hP
  
  have U2 : ∀ (W : WeierstrassCurve K) (m : ℕ), 0 < m →
      ladderXZ W (2 * m) = ladderDbl W (ladderXZ W m) := by
    intro W m hm
    obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
    rw [show 2 * (k + 1) = 2 * k + 2 by ring, ladderXZ.eq_3,
      dif_pos (show (2 * k + 2) % 2 = 0 by omega), show (2 * k + 2) / 2 = k + 1 by omega]
  have U3 : ∀ (W : WeierstrassCurve K) (m : ℕ), 0 < m →
      ladderXZ W (2 * m + 1) = ladderAdd W (ladderXZ W (m + 1)) (ladderXZ W m) := by
    intro W m hm
    obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
    rw [show 2 * (k + 1) + 1 = (2 * k + 1) + 2 by ring, ladderXZ.eq_3,
      dif_neg (show ¬ ((2 * k + 1) + 2) % 2 = 0 by omega),
      show ((2 * k + 1) + 2) / 2 = k + 1 by omega]
  have lad : ∀ n : ℕ, G ((ladderXZ W₁ n).1.eval x) ((ladderXZ W₂ n).1.eval x) ∧
      G ((ladderXZ W₁ n).2.eval x) ((ladderXZ W₂ n).2.eval x) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      obtain ⟨m, rfl | rfl⟩ := Nat.even_or_odd' n
      · rcases Nat.eq_zero_or_pos m with rfl | hm
        · rw [show 2 * 0 = 0 by rfl, ladderXZ.eq_1, ladderXZ.eq_1]
          simp only [Polynomial.eval_one, Polynomial.eval_zero]
          exact ⟨G1, G0⟩
        · obtain ⟨i1, i2⟩ := ih m (by omega)
          rw [U2 W₁ m hm, U2 W₂ m hm]
          simp only [ladderDbl, Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_mul,
            Polynomial.eval_pow, Polynomial.eval_C, Polynomial.eval_ofNat]
          constructor
          · exact Gsub _ _ _ _ (Gsub _ _ _ _ (Gsub _ _ _ _ (Gpow _ _ 4 i1)
              (Gmul _ _ _ _ (Gmul _ _ _ _ gb4 (Gpow _ _ 2 i1)) (Gpow _ _ 2 i2)))
              (Gmul _ _ _ _ (Gmul _ _ _ _ (Gmul _ _ _ _ G2 gb6) i1) (Gpow _ _ 3 i2)))
              (Gmul _ _ _ _ gb8 (Gpow _ _ 4 i2))
          · exact Gadd _ _ _ _ (Gadd _ _ _ _ (Gadd _ _ _ _
              (Gmul _ _ _ _ (Gmul _ _ _ _ G4 (Gpow _ _ 3 i1)) i2)
              (Gmul _ _ _ _ (Gmul _ _ _ _ gb2 (Gpow _ _ 2 i1)) (Gpow _ _ 2 i2)))
              (Gmul _ _ _ _ (Gmul _ _ _ _ (Gmul _ _ _ _ G2 gb4) i1) (Gpow _ _ 3 i2)))
              (Gmul _ _ _ _ gb6 (Gpow _ _ 4 i2))
      · rcases Nat.eq_zero_or_pos m with rfl | hm
        · rw [show 2 * 0 + 1 = 1 by rfl, ladderXZ.eq_2, ladderXZ.eq_2]
          simp only [Polynomial.eval_X, Polynomial.eval_one]
          exact ⟨Gx, G1⟩
        · obtain ⟨p1, p2⟩ := ih (m + 1) (by omega)
          obtain ⟨q1, q2⟩ := ih m (by omega)
          rw [U3 W₁ m hm, U3 W₂ m hm]
          simp only [ladderAdd, Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_mul,
            Polynomial.eval_pow, Polynomial.eval_C, Polynomial.eval_ofNat, Polynomial.eval_X]
          have S := Gadd _ _ _ _ (Gmul _ _ _ _ p1 q2) (Gmul _ _ _ _ q1 p2)
          have D := Gsub _ _ _ _ (Gmul _ _ _ _ p1 q2) (Gmul _ _ _ _ q1 p2)
          constructor
          · exact Gsub _ _ _ _ (Gadd _ _ _ _ (Gadd _ _ _ _ (Gadd _ _ _ _
              (Gmul _ _ _ _ (Gmul _ _ _ _ (Gmul _ _ _ _ G2 p1) q1) S)
              (Gmul _ _ _ _ (Gmul _ _ _ _ (Gmul _ _ _ _ (Gmul _ _ _ _ gb2 p1) q1) p2) q2))
              (Gmul _ _ _ _ (Gmul _ _ _ _ (Gmul _ _ _ _ gb4 S) p2) q2))
              (Gmul _ _ _ _ (Gmul _ _ _ _ gb6 (Gpow _ _ 2 p2)) (Gpow _ _ 2 q2)))
              (Gmul _ _ _ _ Gx (Gpow _ _ 2 D))
          · exact Gpow _ _ 2 D
  have hZ2 : w ((ladderXZ W₂ N).2.eval x) < 1 := by
    have hd := ((hG _ _).mp (lad N).2).2
    rw [hZ1, zero_sub, Valuation.map_neg] at hd
    exact hd
  
  have hlc : w (ladderXZ W₂ N).2.leadingCoeff = 1 := by
    rw [(ladderXZ_degree W₂ N hN).2.2.2, map_pow, hwN, one_pow]
  
  obtain ⟨r, hr0, hxr⟩ : ∃ r : K, (ladderXZ W₂ N).2.IsRoot r ∧ w (x - r) < 1 := by
    by_contra hcon
    push_neg at hcon
    set Gp := (ladderXZ W₂ N).2 with hGp
    have hsplit := Polynomial.Splits.eq_prod_roots (IsAlgClosed.splits Gp)
    have heval : w (Gp.eval x) =
        (Multiset.map (fun a => w (x - a)) Gp.roots).prod := by
      conv_lhs => rw [hsplit]
      rw [Polynomial.eval_mul, Polynomial.eval_C, map_mul, hlc, one_mul,
        Polynomial.eval_multiset_prod, map_multiset_prod, Multiset.map_map, Multiset.map_map]
      congr 1
      apply Multiset.map_congr rfl
      intro a _
      simp only [Function.comp_apply, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
    have hge : 1 ≤ (Multiset.map (fun a => w (x - a)) Gp.roots).prod := by
      apply Multiset.one_le_prod_of_one_le
      intro t ht
      obtain ⟨a, ha, rfl⟩ := Multiset.mem_map.mp ht
      exact hcon a (Polynomial.isRoot_of_mem_roots ha)
    rw [← heval] at hge
    exact absurd hZ2 (not_lt.mpr hge)
  have hr0' : (ladderXZ W₂ N).2.eval r = 0 := hr0
  
  have Gr : G x r := (hG _ _).mpr ⟨hx, hxr⟩
  have Gy : G y y := Grefl y hy
  obtain ⟨B, hB⟩ : ∃ B : K, B = W₂.a₁ * r + W₂.a₃ := ⟨_, rfl⟩
  obtain ⟨Cc, hCc⟩ : ∃ Cc : K, Cc = r ^ 3 + W₂.a₂ * r ^ 2 + W₂.a₄ * r + W₂.a₆ := ⟨_, rfl⟩
  obtain ⟨s, hs⟩ := IsAlgClosed.exists_eq_mul_self (B ^ 2 + 4 * Cc)
  obtain ⟨y₁, e₁⟩ : ∃ y₁ : K, 2 * y₁ = s - B := ⟨(s - B) / 2, by field_simp⟩
  have q4 : 4 * (y₁ ^ 2 + B * y₁ - Cc) = 0 := by
    linear_combination (2 * y₁ + s + B) * e₁ - hs
  have q1 : y₁ ^ 2 + B * y₁ - Cc = 0 := by
    rcases mul_eq_zero.mp q4 with h4 | h4
    · exact absurd h4 (by norm_num)
    · exact h4
  have q2 : (-B - y₁) ^ 2 + B * (-B - y₁) - Cc = 0 := by linear_combination q1
  have hE : y ^ 2 + (W₁.a₁ * x + W₁.a₃) * y - (x ^ 3 + W₁.a₂ * x ^ 2 + W₁.a₄ * x + W₁.a₆) = 0 := by
    have := (WeierstrassCurve.Affine.equation_iff x y).mp h.1
    linear_combination this
  have Gq := Gsub _ _ _ _ (Gadd _ _ _ _ (Gpow _ _ 2 Gy)
    (Gmul _ _ _ _ (Gadd _ _ _ _ (Gmul _ _ _ _ g1 Gr) g3) Gy))
    (Gadd _ _ _ _ (Gadd _ _ _ _ (Gadd _ _ _ _ (Gpow _ _ 3 Gr) (Gmul _ _ _ _ g2 (Gpow _ _ 2 Gr)))
      (Gmul _ _ _ _ g4 Gr)) g6)
  have hq := ((hG _ _).mp Gq).2
  rw [hE, zero_sub, Valuation.map_neg] at hq
  have hprod : w (y - y₁) * w (y - (-B - y₁)) < 1 := by
    rw [← map_mul]
    have e : (y - y₁) * (y - (-B - y₁)) = y ^ 2 + (W₂.a₁ * r + W₂.a₃) * y -
        (r ^ 3 + W₂.a₂ * r ^ 2 + W₂.a₄ * r + W₂.a₆) := by
      rw [← hB, ← hCc]
      linear_combination (-1 : K) * q1
    rw [e]
    exact hq
  have hW₂ : W₂.IsElliptic := ⟨isUnit_iff_ne_zero.mpr hΔ0'⟩
  have mkpt : ∀ y' : K, y' ^ 2 + B * y' - Cc = 0 → W₂.toAffine.Nonsingular r y' := by
    intro y' hq'
    apply WeierstrassCurve.Affine.equation_iff_nonsingular.mp
    rw [WeierstrassCurve.Affine.equation_iff]
    rw [hB, hCc] at hq'
    linear_combination hq'
  obtain ⟨y', h', hyy⟩ : ∃ y' : K, W₂.toAffine.Nonsingular r y' ∧ w (y - y') < 1 := by
    by_cases hc : w (y - y₁) < 1
    · exact ⟨y₁, mkpt y₁ q1, hc⟩
    · refine ⟨-B - y₁, mkpt _ q2, ?_⟩
      by_contra hc2
      have := one_le_mul (not_lt.mp hc) (not_lt.mp hc2)
      exact absurd hprod (not_lt.mpr this)
  
  have hNQ : N • WeierstrassCurve.Affine.Point.some h' = 0 := by
    obtain ⟨Q, hQ⟩ : ∃ Q, N • WeierstrassCurve.Affine.Point.some h' = Q := ⟨_, rfl⟩
    cases Q with
    | zero => exact hQ
    | @some x'' y'' h'' =>
      exfalso
      have hX := (ladderXZ_eval_nsmul W₂ N hN h').2 h'' hQ
      rw [hr0', mul_zero] at hX
      exact ladderXZ_no_common_root W₂ hΔ0' N hN r ⟨hX, hr0'⟩
  exact ⟨r, y', h', hNQ, hxr, hyy⟩

theorem weierstrass_add_close_of_unit_sub {K : Type*} [Field K] [DecidableEq K]
    (w : Valuation K NNReal) (W₁ W₂ : WeierstrassCurve K)
    (h₁ : w W₁.a₁ ≤ 1) (h₂ : w W₁.a₂ ≤ 1) (h₃ : w W₁.a₃ ≤ 1) (h₄ : w W₁.a₄ ≤ 1)
    (h₆ : w W₁.a₆ ≤ 1)
    (c₁ : w (W₁.a₁ - W₂.a₁) < 1) (c₂ : w (W₁.a₂ - W₂.a₂) < 1) (c₃ : w (W₁.a₃ - W₂.a₃) < 1)
    (c₄ : w (W₁.a₄ - W₂.a₄) < 1) (c₆ : w (W₁.a₆ - W₂.a₆) < 1)
    {x₁ y₁ x₂ y₂ x₁' y₁' x₂' y₂' : K}
    (hP₁ : W₁.toAffine.Nonsingular x₁ y₁) (hP₂ : W₁.toAffine.Nonsingular x₂ y₂)
    (hQ₁ : W₂.toAffine.Nonsingular x₁' y₁') (hQ₂ : W₂.toAffine.Nonsingular x₂' y₂')
    (hx₁ : w x₁ ≤ 1) (hy₁ : w y₁ ≤ 1) (hx₂ : w x₂ ≤ 1) (hy₂ : w y₂ ≤ 1)
    (e₁ : w (x₁ - x₁') < 1) (f₁ : w (y₁ - y₁') < 1) (e₂ : w (x₂ - x₂') < 1) (f₂ : w (y₂ - y₂') < 1)
    (hu : w (x₁ - x₂) = 1) :
    ∃ (x₃ y₃ x₃' y₃' : K) (h₃ : W₁.toAffine.Nonsingular x₃ y₃) (h₃' : W₂.toAffine.Nonsingular x₃' y₃'),
      WeierstrassCurve.Affine.Point.some hP₁ + WeierstrassCurve.Affine.Point.some hP₂ =
        WeierstrassCurve.Affine.Point.some h₃ ∧
      WeierstrassCurve.Affine.Point.some hQ₁ + WeierstrassCurve.Affine.Point.some hQ₂ =
        WeierstrassCurve.Affine.Point.some h₃' ∧
      w (x₃ - x₃') < 1 ∧ w (y₃ - y₃') < 1 :=
by
  have sadd : ∀ a b : K, w a < 1 → w b < 1 → w (a + b) < 1 := fun a b ha hb =>
    lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt ha hb)
  have ssub : ∀ a b : K, w a < 1 → w b < 1 → w (a - b) < 1 := fun a b ha hb =>
    lt_of_le_of_lt (Valuation.map_sub _ _ _) (max_lt ha hb)
  have sneg : ∀ a : K, w a < 1 → w (-a) < 1 := fun a ha => by
    rw [Valuation.map_neg]; exact ha
  have iadd : ∀ a b : K, w a ≤ 1 → w b ≤ 1 → w (a + b) ≤ 1 := fun a b ha hb =>
    le_trans (Valuation.map_add _ _ _) (max_le ha hb)
  have isub : ∀ a b : K, w a ≤ 1 → w b ≤ 1 → w (a - b) ≤ 1 := fun a b ha hb =>
    le_trans (Valuation.map_sub _ _ _) (max_le ha hb)
  have imul : ∀ a b : K, w a ≤ 1 → w b ≤ 1 → w (a * b) ≤ 1 := fun a b ha hb => by
    rw [map_mul]; exact mul_le_one' ha hb
  have smulL : ∀ a b : K, w a ≤ 1 → w b < 1 → w (a * b) < 1 := fun a b ha hb => by
    rw [map_mul]; exact lt_of_le_of_lt (mul_le_of_le_one_left' ha) hb
  have smulR : ∀ a b : K, w a < 1 → w b ≤ 1 → w (a * b) < 1 := fun a b ha hb => by
    rw [map_mul]; exact lt_of_le_of_lt (mul_le_of_le_one_right' hb) ha
  have close : ∀ a a' : K, w a ≤ 1 → w (a - a') < 1 → w a' ≤ 1 := fun a a' ha h => by
    have e : a' = a - (a - a') := by ring
    rw [e]; exact isub _ _ ha h.le
  
  have hne : x₁ ≠ x₂ := by
    intro h; rw [h, sub_self, map_zero] at hu; exact zero_ne_one hu
  have hu' : w (x₁' - x₂') = 1 := by
    have e : x₁' - x₂' = (x₁ - x₂) + ((x₂ - x₂') - (x₁ - x₁')) := by ring
    rw [e, Valuation.map_add_eq_of_lt_left]
    · exact hu
    · rw [hu]; exact ssub _ _ e₂ e₁
  have hne' : x₁' ≠ x₂' := by
    intro h; rw [h, sub_self, map_zero] at hu'; exact zero_ne_one hu'
  have hd : x₁ - x₂ ≠ 0 := sub_ne_zero.mpr hne
  have hd' : x₁' - x₂' ≠ 0 := sub_ne_zero.mpr hne'
  obtain ⟨ℓ, hℓdef⟩ : ∃ ℓ : K, (y₁ - y₂) / (x₁ - x₂) = ℓ := ⟨_, rfl⟩
  obtain ⟨ℓ', hℓ'def⟩ : ∃ ℓ' : K, (y₁' - y₂') / (x₁' - x₂') = ℓ' := ⟨_, rfl⟩
  have hℓ : w ℓ ≤ 1 := by
    rw [← hℓdef, map_div₀, hu, div_one]; exact isub _ _ hy₁ hy₂
  have hg : w (ℓ - ℓ') < 1 := by
    have e : ℓ - ℓ' = ((y₁ - y₂) * ((x₂ - x₂') - (x₁ - x₁')) +
        ((y₁ - y₁') - (y₂ - y₂')) * (x₁ - x₂)) / ((x₁ - x₂) * (x₁' - x₂')) := by
      rw [← hℓdef, ← hℓ'def, div_sub_div _ _ hd hd']
      congr 1
      ring
    rw [e, map_div₀, map_mul, hu, hu', mul_one, div_one]
    exact sadd _ _ (smulL _ _ (isub _ _ hy₁ hy₂) (ssub _ _ e₂ e₁))
      (smulR _ _ (ssub _ _ f₁ f₂) hu.le)
  
  have ha₁' := close _ _ h₁ c₁
  have ha₂' := close _ _ h₂ c₂
  have hx₁' := close _ _ hx₁ e₁
  have hx₂' := close _ _ hx₂ e₂
  have hℓ' := close _ _ hℓ hg
  have hXX : w (W₁.toAffine.addX x₁ x₂ ℓ - W₂.toAffine.addX x₁' x₂' ℓ') < 1 := by
    have e : W₁.toAffine.addX x₁ x₂ ℓ - W₂.toAffine.addX x₁' x₂' ℓ' =
        (ℓ - ℓ') * (ℓ + ℓ') + (W₁.a₁ * (ℓ - ℓ') + (W₁.a₁ - W₂.a₁) * ℓ') - (W₁.a₂ - W₂.a₂) -
          (x₁ - x₁') - (x₂ - x₂') := by
      simp only [WeierstrassCurve.Affine.addX]; ring
    rw [e]
    exact ssub _ _ (ssub _ _ (ssub _ _ (sadd _ _ (smulR _ _ hg (iadd _ _ hℓ hℓ'))
      (sadd _ _ (smulL _ _ h₁ hg) (smulR _ _ c₁ hℓ'))) c₂) e₁) e₂
  have hX' : w (W₂.toAffine.addX x₁' x₂' ℓ') ≤ 1 := by
    have e : W₂.toAffine.addX x₁' x₂' ℓ' = ℓ' * ℓ' + W₂.a₁ * ℓ' - W₂.a₂ - x₁' - x₂' := by
      simp only [WeierstrassCurve.Affine.addX]; ring
    rw [e]
    exact isub _ _ (isub _ _ (isub _ _ (iadd _ _ (imul _ _ hℓ' hℓ') (imul _ _ ha₁' hℓ')) ha₂')
      hx₁') hx₂'
  have hYY : w (W₁.toAffine.addY x₁ x₂ y₁ ℓ - W₂.toAffine.addY x₁' x₂' y₁' ℓ') < 1 := by
    have e : W₁.toAffine.addY x₁ x₂ y₁ ℓ - W₂.toAffine.addY x₁' x₂' y₁' ℓ' =
        -(ℓ * ((W₁.toAffine.addX x₁ x₂ ℓ - W₂.toAffine.addX x₁' x₂' ℓ') - (x₁ - x₁')) +
            (ℓ - ℓ') * (W₂.toAffine.addX x₁' x₂' ℓ' - x₁') + (y₁ - y₁')) -
          (W₁.a₁ * (W₁.toAffine.addX x₁ x₂ ℓ - W₂.toAffine.addX x₁' x₂' ℓ') +
            (W₁.a₁ - W₂.a₁) * W₂.toAffine.addX x₁' x₂' ℓ') - (W₁.a₃ - W₂.a₃) := by
      simp only [WeierstrassCurve.Affine.addY, WeierstrassCurve.Affine.negY,
        WeierstrassCurve.Affine.negAddY]
      ring
    rw [e]
    exact ssub _ _ (ssub _ _ (sneg _ (sadd _ _ (sadd _ _ (smulL _ _ hℓ (ssub _ _ hXX e₁))
      (smulR _ _ hg (isub _ _ hX' hx₁'))) f₁))
      (sadd _ _ (smulL _ _ h₁ hXX) (smulR _ _ c₁ hX'))) c₃
  
  have hsl : W₁.toAffine.slope x₁ x₂ y₁ y₂ = ℓ := by
    rw [WeierstrassCurve.Affine.slope_of_X_ne hne, hℓdef]
  have hsl' : W₂.toAffine.slope x₁' x₂' y₁' y₂' = ℓ' := by
    rw [WeierstrassCurve.Affine.slope_of_X_ne hne', hℓ'def]
  refine ⟨_, _, _, _, _, _, WeierstrassCurve.Affine.Point.add_of_X_ne hne,
    WeierstrassCurve.Affine.Point.add_of_X_ne hne', ?_, ?_⟩
  · rw [hsl, hsl']; exact hXX
  · rw [hsl, hsl']; exact hYY

theorem weierstrass_double_close {K : Type*} [Field K] [DecidableEq K]
    (w : Valuation K NNReal) (W₁ W₂ : WeierstrassCurve K)
    (h₁ : w W₁.a₁ ≤ 1) (h₂ : w W₁.a₂ ≤ 1) (h₃ : w W₁.a₃ ≤ 1) (h₄ : w W₁.a₄ ≤ 1)
    (h₆ : w W₁.a₆ ≤ 1)
    (c₁ : w (W₁.a₁ - W₂.a₁) < 1) (c₂ : w (W₁.a₂ - W₂.a₂) < 1) (c₃ : w (W₁.a₃ - W₂.a₃) < 1)
    (c₄ : w (W₁.a₄ - W₂.a₄) < 1) (c₆ : w (W₁.a₆ - W₂.a₆) < 1)
    {x y x' y' : K} (hP : W₁.toAffine.Nonsingular x y) (hQ : W₂.toAffine.Nonsingular x' y')
    (hx : w x ≤ 1) (hy : w y ≤ 1) (e : w (x - x') < 1) (f : w (y - y') < 1)
    (hd : w (2 * y + W₁.a₁ * x + W₁.a₃) = 1) :
    ∃ (x₃ y₃ x₃' y₃' : K) (h₃ : W₁.toAffine.Nonsingular x₃ y₃) (h₃' : W₂.toAffine.Nonsingular x₃' y₃'),
      WeierstrassCurve.Affine.Point.some hP + WeierstrassCurve.Affine.Point.some hP =
        WeierstrassCurve.Affine.Point.some h₃ ∧
      WeierstrassCurve.Affine.Point.some hQ + WeierstrassCurve.Affine.Point.some hQ =
        WeierstrassCurve.Affine.Point.some h₃' ∧
      w (x₃ - x₃') < 1 ∧ w (y₃ - y₃') < 1 :=
by
  classical
  have iadd : ∀ a b : K, w a ≤ 1 → w b ≤ 1 → w (a + b) ≤ 1 := fun a b ha hb =>
    le_trans (Valuation.map_add _ _ _) (max_le ha hb)
  have isub : ∀ a b : K, w a ≤ 1 → w b ≤ 1 → w (a - b) ≤ 1 := fun a b ha hb =>
    le_trans (Valuation.map_sub _ _ _) (max_le ha hb)
  have imul : ∀ a b : K, w a ≤ 1 → w b ≤ 1 → w (a * b) ≤ 1 := fun a b ha hb => by
    rw [map_mul]; exact mul_le_one' ha hb
  have ipow : ∀ a : K, w a ≤ 1 → w (a ^ 2) ≤ 1 := fun a ha => by
    rw [pow_two]; exact imul _ _ ha ha
  have sadd : ∀ a b : K, w a < 1 → w b < 1 → w (a + b) < 1 := fun a b ha hb =>
    Valuation.map_add_lt w ha hb
  have ssub : ∀ a b : K, w a < 1 → w b < 1 → w (a - b) < 1 := fun a b ha hb =>
    lt_of_le_of_lt (Valuation.map_sub _ _ _) (max_lt ha hb)
  have sneg : ∀ a : K, w a < 1 → w (-a) < 1 := fun a ha => by
    rw [Valuation.map_neg]; exact ha
  have smulL : ∀ a b : K, w a ≤ 1 → w b < 1 → w (a * b) < 1 := fun a b ha hb => by
    rw [map_mul]; exact lt_of_le_of_lt (mul_le_of_le_one_left' ha) hb
  have smulR : ∀ a b : K, w a < 1 → w b ≤ 1 → w (a * b) < 1 := fun a b ha hb => by
    rw [map_mul]; exact lt_of_le_of_lt (mul_le_of_le_one_right' hb) ha
  have iclose : ∀ a b : K, w a ≤ 1 → w (a - b) < 1 → w b ≤ 1 := fun a b ha hab => by
    have e : b = a - (a - b) := by ring
    rw [e]; exact isub _ _ ha hab.le
  have two : w (2 : K) ≤ 1 := by
    have e : (2 : K) = 1 + 1 := by norm_num
    rw [e]; exact iadd _ _ (le_of_eq (map_one w)) (le_of_eq (map_one w))
  have three : w (3 : K) ≤ 1 := by
    have e : (3 : K) = 2 + 1 := by norm_num
    rw [e]; exact iadd _ _ two (le_of_eq (map_one w))
  
  have hx' : w x' ≤ 1 := iclose _ _ hx e
  have hy' : w y' ≤ 1 := iclose _ _ hy f
  have h₁' : w W₂.a₁ ≤ 1 := iclose _ _ h₁ c₁
  have h₂' : w W₂.a₂ ≤ 1 := iclose _ _ h₂ c₂
  
  have hdd : w ((2 * y + W₁.a₁ * x + W₁.a₃) - (2 * y' + W₂.a₁ * x' + W₂.a₃)) < 1 := by
    have e' : (2 * y + W₁.a₁ * x + W₁.a₃) - (2 * y' + W₂.a₁ * x' + W₂.a₃) =
        2 * (y - y') + (W₁.a₁ * (x - x') + (W₁.a₁ - W₂.a₁) * x') + (W₁.a₃ - W₂.a₃) := by ring
    rw [e']
    exact sadd _ _ (sadd _ _ (smulL _ _ two f) (sadd _ _ (smulL _ _ h₁ e) (smulR _ _ c₁ hx'))) c₃
  have hd' : w (2 * y' + W₂.a₁ * x' + W₂.a₃) = 1 := by
    have e' : 2 * y' + W₂.a₁ * x' + W₂.a₃ = (2 * y + W₁.a₁ * x + W₁.a₃) +
        -((2 * y + W₁.a₁ * x + W₁.a₃) - (2 * y' + W₂.a₁ * x' + W₂.a₃)) := by ring
    rw [e', Valuation.map_add_eq_of_lt_left, hd]
    rw [Valuation.map_neg, hd]; exact hdd
  have hd0 : (2 * y + W₁.a₁ * x + W₁.a₃) ≠ 0 := by
    intro h0; rw [h0, map_zero] at hd; exact zero_ne_one hd
  have hd0' : (2 * y' + W₂.a₁ * x' + W₂.a₃) ≠ 0 := by
    intro h0; rw [h0, map_zero] at hd'; exact zero_ne_one hd'
  have ey : y - W₁.toAffine.negY x y = 2 * y + W₁.a₁ * x + W₁.a₃ := by
    simp only [WeierstrassCurve.Affine.negY]; ring
  have ey' : y' - W₂.toAffine.negY x' y' = 2 * y' + W₂.a₁ * x' + W₂.a₃ := by
    simp only [WeierstrassCurve.Affine.negY]; ring
  have hne : y ≠ W₁.toAffine.negY x y := by
    intro h; apply hd0; rw [← ey, ← h, sub_self]
  have hne' : y' ≠ W₂.toAffine.negY x' y' := by
    intro h; apply hd0'; rw [← ey', ← h, sub_self]
  have hs1 : W₁.toAffine.slope x x y y =
      (3 * x ^ 2 + 2 * W₁.a₂ * x + W₁.a₄ - W₁.a₁ * y) / (2 * y + W₁.a₁ * x + W₁.a₃) := by
    rw [WeierstrassCurve.Affine.slope_of_Y_ne rfl hne, ey]
  have hs2 : W₂.toAffine.slope x' x' y' y' =
      (3 * x' ^ 2 + 2 * W₂.a₂ * x' + W₂.a₄ - W₂.a₁ * y') / (2 * y' + W₂.a₁ * x' + W₂.a₃) := by
    rw [WeierstrassCurve.Affine.slope_of_Y_ne rfl hne', ey']
  
  have hM : w (3 * x ^ 2 + 2 * W₁.a₂ * x + W₁.a₄ - W₁.a₁ * y) ≤ 1 :=
    isub _ _ (iadd _ _ (iadd _ _ (imul _ _ three (ipow _ hx)) (imul _ _ (imul _ _ two h₂) hx)) h₄)
      (imul _ _ h₁ hy)
  have hMM : w ((3 * x ^ 2 + 2 * W₁.a₂ * x + W₁.a₄ - W₁.a₁ * y) -
      (3 * x' ^ 2 + 2 * W₂.a₂ * x' + W₂.a₄ - W₂.a₁ * y')) < 1 := by
    have e' : (3 * x ^ 2 + 2 * W₁.a₂ * x + W₁.a₄ - W₁.a₁ * y) -
        (3 * x' ^ 2 + 2 * W₂.a₂ * x' + W₂.a₄ - W₂.a₁ * y') =
        3 * (x * (x - x') + (x - x') * x') + 2 * (W₁.a₂ * (x - x') + (W₁.a₂ - W₂.a₂) * x') +
          (W₁.a₄ - W₂.a₄) - (W₁.a₁ * (y - y') + (W₁.a₁ - W₂.a₁) * y') := by ring
    rw [e']
    exact ssub _ _ (sadd _ _ (sadd _ _ (smulL _ _ three (sadd _ _ (smulL _ _ hx e) (smulR _ _ e hx')))
      (smulL _ _ two (sadd _ _ (smulL _ _ h₂ e) (smulR _ _ c₂ hx')))) c₄)
      (sadd _ _ (smulL _ _ h₁ f) (smulR _ _ c₁ hy'))
  
  have quot : ∀ M M' D D' : K, w M ≤ 1 → w (M - M') < 1 → w D = 1 → w D' = 1 →
      w (D - D') < 1 → w (M / D) ≤ 1 ∧ w (M / D - M' / D') < 1 := by
    intro M M' D D' hM hMM hD hD' hDD
    have hD0 : D ≠ 0 := by intro h0; rw [h0, map_zero] at hD; exact zero_ne_one hD
    have hD0' : D' ≠ 0 := by intro h0; rw [h0, map_zero] at hD'; exact zero_ne_one hD'
    refine ⟨?_, ?_⟩
    · rw [Valuation.map_div, hD, div_one]; exact hM
    · have e' : M / D - M' / D' = (M * (D' - D) + (M - M') * D) / (D * D') := by
        rw [div_sub_div _ _ hD0 hD0']; congr 1; ring
      rw [e', Valuation.map_div, map_mul, hD, hD', mul_one, div_one]
      exact sadd _ _ (smulL _ _ hM (by rw [Valuation.map_sub_swap]; exact hDD))
        (smulR _ _ hMM (le_of_eq hD))
  obtain ⟨hℓ, hℓℓ⟩ := quot _ _ _ _ hM hMM hd hd' hdd
  rw [← hs1] at hℓ
  rw [← hs1, ← hs2] at hℓℓ
  
  have key : ∀ ℓ ℓ' : K, w ℓ ≤ 1 → w (ℓ - ℓ') < 1 →
      w (W₁.toAffine.addX x x ℓ - W₂.toAffine.addX x' x' ℓ') < 1 ∧
        w (W₁.toAffine.addY x x y ℓ - W₂.toAffine.addY x' x' y' ℓ') < 1 := by
    intro ℓ ℓ' hl hll
    have hl' : w ℓ' ≤ 1 := iclose _ _ hl hll
    have hX : w (W₁.toAffine.addX x x ℓ - W₂.toAffine.addX x' x' ℓ') < 1 := by
      have e' : W₁.toAffine.addX x x ℓ - W₂.toAffine.addX x' x' ℓ' =
          (ℓ * (ℓ - ℓ') + (ℓ - ℓ') * ℓ') + (W₁.a₁ * (ℓ - ℓ') + (W₁.a₁ - W₂.a₁) * ℓ') -
            (W₁.a₂ - W₂.a₂) - (x - x') - (x - x') := by
        simp only [WeierstrassCurve.Affine.addX]; ring
      rw [e']
      exact ssub _ _ (ssub _ _ (ssub _ _ (sadd _ _ (sadd _ _ (smulL _ _ hl hll) (smulR _ _ hll hl'))
        (sadd _ _ (smulL _ _ h₁ hll) (smulR _ _ c₁ hl'))) c₂) e) e
    have hXi : w (W₁.toAffine.addX x x ℓ) ≤ 1 := by
      simp only [WeierstrassCurve.Affine.addX]
      exact isub _ _ (isub _ _ (isub _ _ (iadd _ _ (ipow _ hl) (imul _ _ h₁ hl)) h₂) hx) hx
    have hXi' : w (W₂.toAffine.addX x' x' ℓ') ≤ 1 := iclose _ _ hXi hX
    have hN : w (W₁.toAffine.negAddY x x y ℓ - W₂.toAffine.negAddY x' x' y' ℓ') < 1 := by
      have e' : W₁.toAffine.negAddY x x y ℓ - W₂.toAffine.negAddY x' x' y' ℓ' =
          ℓ * ((W₁.toAffine.addX x x ℓ - W₂.toAffine.addX x' x' ℓ') - (x - x')) +
            (ℓ - ℓ') * (W₂.toAffine.addX x' x' ℓ' - x') + (y - y') := by
        simp only [WeierstrassCurve.Affine.negAddY]; ring
      rw [e']
      exact sadd _ _ (sadd _ _ (smulL _ _ hl (ssub _ _ hX e)) (smulR _ _ hll (isub _ _ hXi' hx'))) f
    refine ⟨hX, ?_⟩
    have e' : W₁.toAffine.addY x x y ℓ - W₂.toAffine.addY x' x' y' ℓ' =
        -(W₁.toAffine.negAddY x x y ℓ - W₂.toAffine.negAddY x' x' y' ℓ') -
          (W₁.a₁ * (W₁.toAffine.addX x x ℓ - W₂.toAffine.addX x' x' ℓ') +
            (W₁.a₁ - W₂.a₁) * W₂.toAffine.addX x' x' ℓ') - (W₁.a₃ - W₂.a₃) := by
      simp only [WeierstrassCurve.Affine.addY, WeierstrassCurve.Affine.negY]; ring
    rw [e']
    exact ssub _ _ (ssub _ _ (sneg _ hN) (sadd _ _ (smulL _ _ h₁ hX) (smulR _ _ c₁ hXi'))) c₃
  obtain ⟨kX, kY⟩ := key _ _ hℓ hℓℓ
  exact ⟨_, _, _, _, _, _, WeierstrassCurve.Affine.Point.add_self_of_Y_ne hne,
    WeierstrassCurve.Affine.Point.add_self_of_Y_ne hne', kX, kY⟩

theorem weierstrass_partialY_unit_of_odd_nsmul_eq_zero {K : Type*} [Field K] [DecidableEq K]
    (w : Valuation K NNReal) (W : WeierstrassCurve K)
    (h₁ : w W.a₁ ≤ 1) (h₂ : w W.a₂ ≤ 1) (h₃ : w W.a₃ ≤ 1) (h₄ : w W.a₄ ≤ 1) (h₆ : w W.a₆ ≤ 1)
    (hΔ : w W.Δ = 1) (N : ℕ) (hN : Odd N) (hwN : w (N : K) = 1) {x y : K}
    (h : W.toAffine.Nonsingular x y) (hNP : N • WeierstrassCurve.Affine.Point.some h = 0) :
    w (2 * y + W.a₁ * x + W.a₃) = 1 :=
by
  obtain ⟨hx, hy⟩ := weierstrass_integral_of_nsmul_eq_zero w W h₁ h₂ h₃ h₄ h₆ N hwN h hNP
  have hnegY : w (W.toAffine.negY x y) ≤ 1 := by
    simp only [WeierstrassCurve.Affine.negY]
    refine le_trans (Valuation.map_sub _ _ _) (max_le ?_ h₃)
    refine le_trans (Valuation.map_sub _ _ _) (max_le ?_ ?_)
    · rw [Valuation.map_neg]; exact hy
    · rw [Valuation.map_mul]; exact mul_le_one' h₁ hx
  have hd_eq : y - W.toAffine.negY x y = 2 * y + W.a₁ * x + W.a₃ := by
    simp only [WeierstrassCurve.Affine.negY]; ring
  have hd_le : w (2 * y + W.a₁ * x + W.a₃) ≤ 1 := by
    rw [← hd_eq]
    exact le_trans (Valuation.map_sub _ _ _) (max_le hy hnegY)
  have h2P : 2 • WeierstrassCurve.Affine.Point.some h ≠ 0 := by
    intro h0
    obtain ⟨k, hk⟩ := hN
    apply WeierstrassCurve.Affine.Point.some_ne_zero h
    rw [← hNP, hk, add_nsmul, mul_nsmul, h0, nsmul_zero, zero_add, one_nsmul]
  have hlt : ¬ w (2 * y + W.a₁ * x + W.a₃) < 1 := by
    intro hlt
    have hn : W.toAffine.Nonsingular x (W.toAffine.negY x y) :=
      (WeierstrassCurve.Affine.nonsingular_neg x y).mpr h
    have hxx : w (x - x) < 1 := by rw [sub_self, map_zero]; exact zero_lt_one
    have hyy : w (y - W.toAffine.negY x y) < 1 := by rw [hd_eq]; exact hlt
    have key := weierstrass_sub_eq_zero_or_one_lt_of_close w W h₁ h₂ h₃ h₄ h₆ hΔ hn h
      hx hnegY hx hy hxx hyy
    have e : WeierstrassCurve.Affine.Point.some hn = -WeierstrassCurve.Affine.Point.some h :=
      (WeierstrassCurve.Affine.Point.neg_some h).symm
    have hsub : WeierstrassCurve.Affine.Point.some h - WeierstrassCurve.Affine.Point.some hn =
        2 • WeierstrassCurve.Affine.Point.some h := by
      rw [e, sub_neg_eq_add, two_nsmul]
    rcases key with h0 | ⟨x₃, y₃, hP₃, hP₃eq, h1⟩
    · exact h2P (hsub ▸ h0)
    · have hN3 : N • WeierstrassCurve.Affine.Point.some hP₃ = 0 := by
        rw [← hP₃eq, hsub, nsmul_left_comm, hNP, nsmul_zero]
      have := (weierstrass_integral_of_nsmul_eq_zero w W h₁ h₂ h₃ h₄ h₆ N hwN hP₃ hN3).1
      exact absurd h1 (not_lt.mpr this)
  exact le_antisymm hd_le (not_lt.mp hlt)

theorem weierstrass_torsion_close_add {K : Type*} [Field K] [DecidableEq K]
    (w : Valuation K NNReal) (W₁ W₂ : WeierstrassCurve K)
    (h₁ : w W₁.a₁ ≤ 1) (h₂ : w W₁.a₂ ≤ 1) (h₃ : w W₁.a₃ ≤ 1) (h₄ : w W₁.a₄ ≤ 1)
    (h₆ : w W₁.a₆ ≤ 1) (hΔ : w W₁.Δ = 1)
    (h₁' : w W₂.a₁ ≤ 1) (h₂' : w W₂.a₂ ≤ 1) (h₃' : w W₂.a₃ ≤ 1) (h₄' : w W₂.a₄ ≤ 1)
    (h₆' : w W₂.a₆ ≤ 1) (hΔ' : w W₂.Δ = 1)
    (c₁ : w (W₁.a₁ - W₂.a₁) < 1) (c₂ : w (W₁.a₂ - W₂.a₂) < 1) (c₃ : w (W₁.a₃ - W₂.a₃) < 1)
    (c₄ : w (W₁.a₄ - W₂.a₄) < 1) (c₆ : w (W₁.a₆ - W₂.a₆) < 1)
    (N : ℕ) (hN : Odd N) (hwN : w (N : K) = 1)
    (P₁ P₂ : W₁.toAffine.Point) (Q₁ Q₂ : W₂.toAffine.Point)
    (hP₁ : N • P₁ = 0) (hP₂ : N • P₂ = 0) (hQ₁ : N • Q₁ = 0) (hQ₂ : N • Q₂ = 0)
    (hR₁ : (P₁ = 0 ∧ Q₁ = 0) ∨
      ∃ (x y x' y' : K) (h : W₁.toAffine.Nonsingular x y) (h' : W₂.toAffine.Nonsingular x' y'),
        P₁ = WeierstrassCurve.Affine.Point.some h ∧ Q₁ = WeierstrassCurve.Affine.Point.some h' ∧
        w (x - x') < 1 ∧ w (y - y') < 1)
    (hR₂ : (P₂ = 0 ∧ Q₂ = 0) ∨
      ∃ (x y x' y' : K) (h : W₁.toAffine.Nonsingular x y) (h' : W₂.toAffine.Nonsingular x' y'),
        P₂ = WeierstrassCurve.Affine.Point.some h ∧ Q₂ = WeierstrassCurve.Affine.Point.some h' ∧
        w (x - x') < 1 ∧ w (y - y') < 1) :
    (P₁ + P₂ = 0 ∧ Q₁ + Q₂ = 0) ∨
      ∃ (x y x' y' : K) (h : W₁.toAffine.Nonsingular x y) (h' : W₂.toAffine.Nonsingular x' y'),
        P₁ + P₂ = WeierstrassCurve.Affine.Point.some h ∧
        Q₁ + Q₂ = WeierstrassCurve.Affine.Point.some h' ∧
        w (x - x') < 1 ∧ w (y - y') < 1 :=
by
  classical
  
  have iadd : ∀ a b : K, w a ≤ 1 → w b ≤ 1 → w (a + b) ≤ 1 := fun a b ha hb =>
    le_trans (Valuation.map_add _ _ _) (max_le ha hb)
  have isub : ∀ a b : K, w a ≤ 1 → w b ≤ 1 → w (a - b) ≤ 1 := fun a b ha hb =>
    le_trans (Valuation.map_sub _ _ _) (max_le ha hb)
  have imul : ∀ a b : K, w a ≤ 1 → w b ≤ 1 → w (a * b) ≤ 1 := fun a b ha hb => by
    rw [map_mul]; exact mul_le_one' ha hb
  have sadd : ∀ a b : K, w a < 1 → w b < 1 → w (a + b) < 1 := fun a b ha hb =>
    Valuation.map_add_lt w ha hb
  have ssub : ∀ a b : K, w a < 1 → w b < 1 → w (a - b) < 1 := fun a b ha hb =>
    lt_of_le_of_lt (Valuation.map_sub _ _ _) (max_lt ha hb)
  have sneg : ∀ a : K, w a < 1 → w (-a) < 1 := fun a ha => by
    rw [Valuation.map_neg]; exact ha
  have smulL : ∀ a b : K, w a ≤ 1 → w b < 1 → w (a * b) < 1 := fun a b ha hb => by
    rw [map_mul]; exact lt_of_le_of_lt (mul_le_of_le_one_left' ha) hb
  have smulR : ∀ a b : K, w a < 1 → w b ≤ 1 → w (a * b) < 1 := fun a b ha hb => by
    rw [map_mul]; exact lt_of_le_of_lt (mul_le_of_le_one_right' hb) ha
  have hlt : ∀ a b c : K, w (a - b) < 1 → w (a - c) < 1 → w (b - c) < 1 := by
    intro a b c hab hac
    have e : b - c = (a - c) - (a - b) := by ring
    rw [e]
    exact ssub _ _ hac hab
  
  rcases hR₁ with ⟨rfl, rfl⟩ | ⟨x₁, y₁, x₁', y₁', hp₁, hq₁, rfl, rfl, e₁, f₁⟩
  · rw [zero_add, zero_add]; exact hR₂
  rcases hR₂ with ⟨rfl, rfl⟩ | ⟨x₂, y₂, x₂', y₂', hp₂, hq₂, rfl, rfl, e₂, f₂⟩
  · rw [add_zero, add_zero]; exact Or.inr ⟨x₁, y₁, x₁', y₁', hp₁, hq₁, rfl, rfl, e₁, f₁⟩
  
  obtain ⟨hx₁, hy₁⟩ := weierstrass_integral_of_nsmul_eq_zero w W₁ h₁ h₂ h₃ h₄ h₆ N hwN hp₁ hP₁
  obtain ⟨hx₂, hy₂⟩ := weierstrass_integral_of_nsmul_eq_zero w W₁ h₁ h₂ h₃ h₄ h₆ N hwN hp₂ hP₂
  by_cases hx : w (x₁ - x₂) < 1
  swap
  · 
    have hu : w (x₁ - x₂) = 1 := le_antisymm (isub _ _ hx₁ hx₂) (not_lt.mp hx)
    exact Or.inr (weierstrass_add_close_of_unit_sub w W₁ W₂ h₁ h₂ h₃ h₄ h₆ c₁ c₂ c₃ c₄ c₆
      hp₁ hp₂ hq₁ hq₂ hx₁ hy₁ hx₂ hy₂ e₁ f₁ e₂ f₂ hu)
  by_cases hy : w (y₁ - y₂) < 1
  · 
    obtain ⟨hxe, hye⟩ := weierstrass_eq_of_close_of_nsmul_eq_zero w W₁ h₁ h₂ h₃ h₄ h₆ hΔ N hwN
      hp₁ hp₂ hP₁ hP₂ hx hy
    subst x₂
    subst y₂
    have ex' : w (x₁' - x₂') < 1 := hlt _ _ _ e₁ e₂
    have fy' : w (y₁' - y₂') < 1 := hlt _ _ _ f₁ f₂
    obtain ⟨hxe', hye'⟩ := weierstrass_eq_of_close_of_nsmul_eq_zero w W₂ h₁' h₂' h₃' h₄' h₆' hΔ' N
      hwN hq₁ hq₂ hQ₁ hQ₂ ex' fy'
    subst x₂'
    subst y₂'
    have hd := weierstrass_partialY_unit_of_odd_nsmul_eq_zero w W₁ h₁ h₂ h₃ h₄ h₆ hΔ N hN hwN hp₁ hP₁
    exact Or.inr (weierstrass_double_close w W₁ W₂ h₁ h₂ h₃ h₄ h₆ c₁ c₂ c₃ c₄ c₆ hp₁ hq₁
      hx₁ hy₁ e₁ f₁ hd)
  · 
    have hy' : 1 ≤ w (y₂ - y₁) := by rw [Valuation.map_sub_swap]; exact not_lt.mp hy
    have eq₁ := hp₁.1
    have eq₂ := hp₂.1
    rw [WeierstrassCurve.Affine.equation_iff] at eq₁ eq₂
    have chord : (y₂ - y₁) * (y₂ - W₁.toAffine.negY x₁ y₁) =
        (x₁ - x₂) * (W₁.a₁ * y₂ - (x₁ * x₁ + x₁ * x₂ + x₂ * x₂) - W₁.a₂ * (x₁ + x₂) - W₁.a₄) := by
      simp only [WeierstrassCurve.Affine.negY]
      linear_combination eq₂ - eq₁
    have hB : w (W₁.a₁ * y₂ - (x₁ * x₁ + x₁ * x₂ + x₂ * x₂) - W₁.a₂ * (x₁ + x₂) - W₁.a₄) ≤ 1 :=
      isub _ _ (isub _ _ (isub _ _ (imul _ _ h₁ hy₂)
        (iadd _ _ (iadd _ _ (imul _ _ hx₁ hx₁) (imul _ _ hx₁ hx₂)) (imul _ _ hx₂ hx₂)))
        (imul _ _ h₂ (iadd _ _ hx₁ hx₂))) h₄
    have hprod : w ((y₂ - y₁) * (y₂ - W₁.toAffine.negY x₁ y₁)) < 1 := by
      rw [chord]; exact smulR _ _ hx hB
    have g : w (y₂ - W₁.toAffine.negY x₁ y₁) < 1 := by
      by_contra hg
      rw [not_lt] at hg
      rw [map_mul] at hprod
      exact absurd hprod (not_lt.mpr (one_le_mul hy' hg))
    have hn₁ : W₁.toAffine.Nonsingular x₁ (W₁.toAffine.negY x₁ y₁) :=
      (WeierstrassCurve.Affine.nonsingular_neg x₁ y₁).mpr hp₁
    have tn₁ : N • WeierstrassCurve.Affine.Point.some hn₁ = 0 := by
      have t : N • (-WeierstrassCurve.Affine.Point.some hp₁) = 0 := by
        rw [smul_neg, hP₁, neg_zero]
      rw [WeierstrassCurve.Affine.Point.neg_some] at t
      exact t
    have hx21 : w (x₂ - x₁) < 1 := by rw [Valuation.map_sub_swap]; exact hx
    obtain ⟨hxe, hye⟩ := weierstrass_eq_of_close_of_nsmul_eq_zero w W₁ h₁ h₂ h₃ h₄ h₆ hΔ N hwN
      hp₂ hn₁ hP₂ tn₁ hx21 g
    subst y₂
    subst x₂
    have sum1 : WeierstrassCurve.Affine.Point.some hp₁ + WeierstrassCurve.Affine.Point.some hp₂ = 0 :=
      WeierstrassCurve.Affine.Point.add_of_Y_eq rfl
        (WeierstrassCurve.Affine.negY_negY x₁ y₁).symm
    
    have hx₁' : w x₁' ≤ 1 := by
      have e : x₁' = x₁ - (x₁ - x₁') := by ring
      rw [e]; exact isub _ _ hx₁ e₁.le
    have hx21' : w (x₂' - x₁') < 1 := hlt _ _ _ e₂ e₁
    have ey : y₂' - W₂.toAffine.negY x₁' y₁' =
        -(W₁.toAffine.negY x₁ y₁ - y₂') + (-(y₁ - y₁') -
          (W₁.a₁ * (x₁ - x₁') + (W₁.a₁ - W₂.a₁) * x₁') - (W₁.a₃ - W₂.a₃)) := by
      simp only [WeierstrassCurve.Affine.negY]
      ring
    have g' : w (y₂' - W₂.toAffine.negY x₁' y₁') < 1 := by
      rw [ey]
      exact sadd _ _ (sneg _ f₂) (ssub _ _ (ssub _ _ (sneg _ f₁)
        (sadd _ _ (smulL _ _ h₁ e₁) (smulR _ _ c₁ hx₁'))) c₃)
    have hm₁ : W₂.toAffine.Nonsingular x₁' (W₂.toAffine.negY x₁' y₁') :=
      (WeierstrassCurve.Affine.nonsingular_neg x₁' y₁').mpr hq₁
    have tm₁ : N • WeierstrassCurve.Affine.Point.some hm₁ = 0 := by
      have t : N • (-WeierstrassCurve.Affine.Point.some hq₁) = 0 := by
        rw [smul_neg, hQ₁, neg_zero]
      rw [WeierstrassCurve.Affine.Point.neg_some] at t
      exact t
    obtain ⟨hxe', hye'⟩ := weierstrass_eq_of_close_of_nsmul_eq_zero w W₂ h₁' h₂' h₃' h₄' h₆' hΔ' N
      hwN hq₂ hm₁ hQ₂ tm₁ hx21' g'
    subst y₂'
    subst x₂'
    have sum2 : WeierstrassCurve.Affine.Point.some hq₁ + WeierstrassCurve.Affine.Point.some hq₂ = 0 :=
      WeierstrassCurve.Affine.Point.add_of_Y_eq rfl
        (WeierstrassCurve.Affine.negY_negY x₁' y₁').symm
    exact Or.inl ⟨sum1, sum2⟩

theorem weierstrass_torsion_correspondence_of_close {K : Type*} [Field K] [IsAlgClosed K]
    [CharZero K] [DecidableEq K] (w : Valuation K NNReal) (W₁ W₂ : WeierstrassCurve K)
    (h₁ : w W₁.a₁ ≤ 1) (h₂ : w W₁.a₂ ≤ 1) (h₃ : w W₁.a₃ ≤ 1) (h₄ : w W₁.a₄ ≤ 1)
    (h₆ : w W₁.a₆ ≤ 1) (hΔ : w W₁.Δ = 1)
    (h₁' : w W₂.a₁ ≤ 1) (h₂' : w W₂.a₂ ≤ 1) (h₃' : w W₂.a₃ ≤ 1) (h₄' : w W₂.a₄ ≤ 1)
    (h₆' : w W₂.a₆ ≤ 1) (hΔ' : w W₂.Δ = 1)
    (c₁ : w (W₁.a₁ - W₂.a₁) < 1) (c₂ : w (W₁.a₂ - W₂.a₂) < 1) (c₃ : w (W₁.a₃ - W₂.a₃) < 1)
    (c₄ : w (W₁.a₄ - W₂.a₄) < 1) (c₆ : w (W₁.a₆ - W₂.a₆) < 1)
    (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓ2 : ℓ ≠ 2) (hwℓ : w (ℓ : K) = 1) :
    ∃ Ψ : W₁.toAffine.Point → W₂.toAffine.Point,
      (∀ (n : ℕ) (P Q : W₁.toAffine.Point), (ℓ ^ (n + 1)) • P = 0 → (ℓ ^ (n + 1)) • Q = 0 →
        Ψ (P + Q) = Ψ P + Ψ Q) ∧
      (∀ n : ℕ, Set.BijOn Ψ {P | (ℓ ^ (n + 1)) • P = 0} {Q | (ℓ ^ (n + 1)) • Q = 0}) ∧
      (∀ (n : ℕ) (P : W₁.toAffine.Point) (Q : W₂.toAffine.Point),
        (ℓ ^ (n + 1)) • P = 0 → (ℓ ^ (n + 1)) • Q = 0 →
        (Ψ P = Q ↔ ((P = 0 ∧ Q = 0) ∨
          ∃ (x y x' y' : K) (h : W₁.toAffine.Nonsingular x y) (h' : W₂.toAffine.Nonsingular x' y'),
            P = WeierstrassCurve.Affine.Point.some h ∧ Q = WeierstrassCurve.Affine.Point.some h' ∧
            w (x - x') < 1 ∧ w (y - y') < 1))) :=
by
  classical
  
  obtain ⟨R, hR⟩ : ∃ R : W₁.toAffine.Point → W₂.toAffine.Point → Prop, ∀ P Q, R P Q ↔
      ((P = 0 ∧ Q = 0) ∨
        ∃ (x y x' y' : K) (h : W₁.toAffine.Nonsingular x y) (h' : W₂.toAffine.Nonsingular x' y'),
          P = WeierstrassCurve.Affine.Point.some h ∧ Q = WeierstrassCurve.Affine.Point.some h' ∧
          w (x - x') < 1 ∧ w (y - y') < 1) := ⟨_, fun _ _ => Iff.rfl⟩
  
  have hNpos : ∀ n : ℕ, 0 < ℓ ^ (n + 1) := fun n => pow_pos hℓ.pos _
  have hNodd : ∀ n : ℕ, Odd (ℓ ^ (n + 1)) := fun n => (hℓ.odd_of_ne_two hℓ2).pow
  have hNw : ∀ n : ℕ, w ((ℓ ^ (n + 1) : ℕ) : K) = 1 := by
    intro n
    rw [Nat.cast_pow, map_pow, hwℓ, one_pow]
  have hlt : ∀ a b c : K, w (a - b) < 1 → w (a - c) < 1 → w (b - c) < 1 := by
    intro a b c hab hac
    have e : b - c = (a - c) - (a - b) := by ring
    rw [e]
    exact lt_of_le_of_lt (Valuation.map_sub _ _ _) (max_lt hac hab)
  
  have U₂ : ∀ (M : ℕ), w (M : K) = 1 → ∀ (P : W₁.toAffine.Point) (Q Q' : W₂.toAffine.Point),
      M • Q = 0 → M • Q' = 0 → R P Q → R P Q' → Q = Q' := by
    intro M hM P Q Q' hQ hQ' hPQ hPQ'
    rw [hR] at hPQ hPQ'
    rcases hPQ with ⟨rfl, rfl⟩ | ⟨x, y, x', y', h, h', rfl, rfl, hx, hy⟩
    · rcases hPQ' with ⟨-, rfl⟩ | ⟨x, y, x', y', h, h', hP0, -, -, -⟩
      · rfl
      · exact absurd hP0.symm (WeierstrassCurve.Affine.Point.some_ne_zero _)
    · rcases hPQ' with ⟨hP0, -⟩ | ⟨x₂, y₂, x'', y'', h₂, h'', hP2, rfl, hx2, hy2⟩
      · exact absurd hP0 (WeierstrassCurve.Affine.Point.some_ne_zero _)
      · rw [WeierstrassCurve.Affine.Point.some.injEq] at hP2
        obtain ⟨rfl, rfl⟩ := hP2
        obtain ⟨rfl, rfl⟩ := weierstrass_eq_of_close_of_nsmul_eq_zero w W₂ h₁' h₂' h₃' h₄' h₆' hΔ'
          M hM h' h'' hQ hQ' (hlt _ _ _ hx hx2) (hlt _ _ _ hy hy2)
        rfl
  
  have U₁ : ∀ (M : ℕ), w (M : K) = 1 → ∀ (P P' : W₁.toAffine.Point) (Q : W₂.toAffine.Point),
      M • P = 0 → M • P' = 0 → R P Q → R P' Q → P = P' := by
    intro M hM P P' Q hP hP' hPQ hPQ'
    rw [hR] at hPQ hPQ'
    rcases hPQ with ⟨rfl, rfl⟩ | ⟨x, y, x', y', h, h', rfl, rfl, hx, hy⟩
    · rcases hPQ' with ⟨rfl, -⟩ | ⟨x, y, x', y', h, h', -, hQ0, -, -⟩
      · rfl
      · exact absurd hQ0.symm (WeierstrassCurve.Affine.Point.some_ne_zero _)
    · rcases hPQ' with ⟨-, hQ0⟩ | ⟨x₂, y₂, x'', y'', hn₂, h'', rfl, hQ2, hx2, hy2⟩
      · exact absurd hQ0 (WeierstrassCurve.Affine.Point.some_ne_zero _)
      · rw [WeierstrassCurve.Affine.Point.some.injEq] at hQ2
        obtain ⟨rfl, rfl⟩ := hQ2
        have ex : w (x - x₂) < 1 := by
          rw [Valuation.map_sub_swap] at hx2
          exact hlt _ _ _ (by rw [Valuation.map_sub_swap]; exact hx) hx2
        have ey : w (y - y₂) < 1 := by
          rw [Valuation.map_sub_swap] at hy2
          exact hlt _ _ _ (by rw [Valuation.map_sub_swap]; exact hy) hy2
        obtain ⟨rfl, rfl⟩ := weierstrass_eq_of_close_of_nsmul_eq_zero w W₁ h₁ h₂ h₃ h₄ h₆ hΔ
          M hM h hn₂ hP hP' ex ey
        rfl
  
  have E₁₂ : ∀ (n : ℕ) (P : W₁.toAffine.Point), (ℓ ^ (n + 1)) • P = 0 →
      ∃ Q : W₂.toAffine.Point, (ℓ ^ (n + 1)) • Q = 0 ∧ R P Q := by
    intro n P hP
    cases P with
    | zero =>
      refine ⟨0, smul_zero _, (hR _ _).mpr (Or.inl ⟨rfl, rfl⟩)⟩
    | @some x y h =>
      obtain ⟨x', y', h', hQ, hx, hy⟩ := weierstrass_nsmul_lift_of_close w W₁ W₂
        h₁ h₂ h₃ h₄ h₆ hΔ h₁' h₂' h₃' h₄' h₆' hΔ' c₁ c₂ c₃ c₄ c₆
        (ℓ ^ (n + 1)) (hNpos n) (hNw n) h hP
      exact ⟨_, hQ, (hR _ _).mpr (Or.inr ⟨x, y, x', y', h, h', rfl, rfl, hx, hy⟩)⟩
  
  have E₂₁ : ∀ (n : ℕ) (Q : W₂.toAffine.Point), (ℓ ^ (n + 1)) • Q = 0 →
      ∃ P : W₁.toAffine.Point, (ℓ ^ (n + 1)) • P = 0 ∧ R P Q := by
    intro n Q hQ
    cases Q with
    | zero =>
      refine ⟨0, smul_zero _, (hR _ _).mpr (Or.inl ⟨rfl, rfl⟩)⟩
    | @some x' y' h' =>
      obtain ⟨x, y, h, hP, hx, hy⟩ := weierstrass_nsmul_lift_of_close w W₂ W₁
        h₁' h₂' h₃' h₄' h₆' hΔ' h₁ h₂ h₃ h₄ h₆ hΔ
        (by rw [Valuation.map_sub_swap]; exact c₁) (by rw [Valuation.map_sub_swap]; exact c₂)
        (by rw [Valuation.map_sub_swap]; exact c₃) (by rw [Valuation.map_sub_swap]; exact c₄)
        (by rw [Valuation.map_sub_swap]; exact c₆)
        (ℓ ^ (n + 1)) (hNpos n) (hNw n) h' hQ
      refine ⟨_, hP, (hR _ _).mpr (Or.inr ⟨x, y, x', y', h, h', rfl, rfl, ?_, ?_⟩)⟩
      · rw [Valuation.map_sub_swap]; exact hx
      · rw [Valuation.map_sub_swap]; exact hy
  
  have hex : ∀ P : W₁.toAffine.Point, ∃ Q : W₂.toAffine.Point,
      (∃ Q' : W₂.toAffine.Point, (∃ m : ℕ, (ℓ ^ (m + 1)) • Q' = 0) ∧ R P Q') →
        (∃ m : ℕ, (ℓ ^ (m + 1)) • Q = 0) ∧ R P Q := by
    intro P
    by_cases hP : ∃ Q' : W₂.toAffine.Point, (∃ m : ℕ, (ℓ ^ (m + 1)) • Q' = 0) ∧ R P Q'
    · exact ⟨hP.choose, fun _ => hP.choose_spec⟩
    · exact ⟨0, fun h => absurd h hP⟩
  choose Ψ hΨ using hex
  
  have Spec : ∀ (n : ℕ) (P : W₁.toAffine.Point), (ℓ ^ (n + 1)) • P = 0 →
      (ℓ ^ (n + 1)) • Ψ P = 0 ∧ R P (Ψ P) := by
    intro n P hP
    obtain ⟨Q₀, hQ₀, hRQ₀⟩ := E₁₂ n P hP
    obtain ⟨⟨m, hm⟩, hRΨ⟩ := hΨ P ⟨Q₀, ⟨n, hQ₀⟩, hRQ₀⟩
    have hMw : w (((ℓ ^ (n + 1) * ℓ ^ (m + 1) : ℕ)) : K) = 1 := by
      rw [Nat.cast_mul, map_mul, hNw n, hNw m, one_mul]
    have hEq : Ψ P = Q₀ := U₂ _ hMw P _ _
      (by rw [mul_comm, mul_nsmul, hm, smul_zero])
      (by rw [mul_nsmul, hQ₀, smul_zero]) hRΨ hRQ₀
    rw [hEq]
    exact ⟨hQ₀, hRQ₀⟩
  
  have Char : ∀ (n : ℕ) (P : W₁.toAffine.Point) (Q : W₂.toAffine.Point),
      (ℓ ^ (n + 1)) • P = 0 → (ℓ ^ (n + 1)) • Q = 0 → (Ψ P = Q ↔ R P Q) := by
    intro n P Q hP hQ
    constructor
    · rintro rfl
      exact (Spec n P hP).2
    · intro hPQ
      exact U₂ _ (hNw n) P _ _ (Spec n P hP).1 hQ (Spec n P hP).2 hPQ
  refine ⟨Ψ, ?_, ?_, ?_⟩
  · 
    intro n P P' hP hP'
    have k := weierstrass_torsion_close_add w W₁ W₂ h₁ h₂ h₃ h₄ h₆ hΔ h₁' h₂' h₃' h₄' h₆' hΔ'
      c₁ c₂ c₃ c₄ c₆ (ℓ ^ (n + 1)) (hNodd n) (hNw n) P P' (Ψ P) (Ψ P') hP hP'
      (Spec n P hP).1 (Spec n P' hP').1 ((hR _ _).mp (Spec n P hP).2)
      ((hR _ _).mp (Spec n P' hP').2)
    have hs1 : (ℓ ^ (n + 1)) • (P + P') = 0 := by rw [smul_add, hP, hP', add_zero]
    have hs2 : (ℓ ^ (n + 1)) • (Ψ P + Ψ P') = 0 := by
      rw [smul_add, (Spec n P hP).1, (Spec n P' hP').1, add_zero]
    exact (Char n _ _ hs1 hs2).mpr ((hR _ _).mpr k)
  · 
    intro n
    refine ⟨fun P hP => (Spec n P hP).1, fun P hP P' hP' hPP' => ?_, fun Q hQ => ?_⟩
    · have h1 := (Spec n P hP).2
      have h2 := (Spec n P' hP').2
      rw [← hPP'] at h2
      exact U₁ _ (hNw n) P P' (Ψ P) hP hP' h1 h2
    · obtain ⟨P, hP, hPQ⟩ := E₂₁ n Q hQ
      exact ⟨P, hP, (Char n P Q hP hQ).mpr hPQ⟩
  · 
    intro n P Q hP hQ
    rw [Char n P Q hP hQ, hR]

theorem vBar_linearEquiv_of_torsion_bijOn (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [DecidableEq (AlgebraicClosure F)]
    (E₁ E₂ : WeierstrassCurve F)
    (Ψ : EllipticRootNumber.Pts F E₁ → EllipticRootNumber.Pts F E₂)
    (hadd : ∀ (n : ℕ) (P Q : EllipticRootNumber.Pts F E₁),
      P ∈ EllipticRootNumber.torsion F E₁ (EllipticRootNumber.ell F ^ (n + 1)) →
      Q ∈ EllipticRootNumber.torsion F E₁ (EllipticRootNumber.ell F ^ (n + 1)) →
      Ψ (P + Q) = Ψ P + Ψ Q)
    (hbij : ∀ n : ℕ, Set.BijOn Ψ
      (EllipticRootNumber.torsion F E₁ (EllipticRootNumber.ell F ^ (n + 1)) :
        Set (EllipticRootNumber.Pts F E₁))
      (EllipticRootNumber.torsion F E₂ (EllipticRootNumber.ell F ^ (n + 1)) :
        Set (EllipticRootNumber.Pts F E₂)))
    (hgal : ∀ (σ : EllipticRootNumber.AbsGal F) (n : ℕ) (P : EllipticRootNumber.Pts F E₁),
      P ∈ EllipticRootNumber.torsion F E₁ (EllipticRootNumber.ell F ^ (n + 1)) →
      Ψ (EllipticRootNumber.galHom F E₁ σ P) = EllipticRootNumber.galHom F E₂ σ (Ψ P)) :
    ∃ e : EllipticRootNumber.VBar F E₁ ≃ₗ[EllipticRootNumber.Ω F] EllipticRootNumber.VBar F E₂,
      ∀ σ : EllipticRootNumber.AbsGal F,
        e.toLinearMap ∘ₗ EllipticRootNumber.ellAdicRep F E₁ σ =
          EllipticRootNumber.ellAdicRep F E₂ σ ∘ₗ e.toLinearMap :=
by
  have hinst : ‹DecidableEq (AlgebraicClosure F)› =
      (fun a b => Classical.propDecidable (a = b)) := Subsingleton.elim _ _
  subst hinst
  classical
  
  have hzero : Ψ 0 = 0 := by
    have h0 : (0 : EllipticRootNumber.Pts F E₁) ∈
        EllipticRootNumber.torsion F E₁ (EllipticRootNumber.ell F ^ (0 + 1)) :=
      AddSubgroup.zero_mem _
    have h := hadd 0 0 0 h0 h0
    rw [add_zero] at h
    exact left_eq_add.mp h
  have hsmul : ∀ (n k : ℕ) (P : EllipticRootNumber.Pts F E₁),
      P ∈ EllipticRootNumber.torsion F E₁ (EllipticRootNumber.ell F ^ (n + 1)) →
      Ψ (k • P) = k • Ψ P := by
    intro n k P hP
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, hzero]
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul, hadd n _ _ (AddSubgroup.nsmul_mem _ hP k) hP, ih]
  
  have hmem : ∀ (n : ℕ)
      (P : EllipticRootNumber.torsion F E₁ (EllipticRootNumber.ell F ^ (n + 1))),
      Ψ P.1 ∈ EllipticRootNumber.torsion F E₂ (EllipticRootNumber.ell F ^ (n + 1)) :=
    fun n P => (hbij n).mapsTo P.2
  let fn : ∀ n : ℕ, EllipticRootNumber.torsion F E₁ (EllipticRootNumber.ell F ^ (n + 1))
      →ₗ[ℤ_[EllipticRootNumber.ell F]]
        EllipticRootNumber.torsion F E₂ (EllipticRootNumber.ell F ^ (n + 1)) := fun n =>
    { toFun := fun P => ⟨Ψ P.1, hmem n P⟩
      map_add' := fun P Q => Subtype.ext (hadd n P.1 Q.1 P.2 Q.2)
      map_smul' := fun a P => Subtype.ext (by
        show Ψ (a • P).1 = (a • (⟨Ψ P.1, hmem n P⟩ :
          EllipticRootNumber.torsion F E₂ (EllipticRootNumber.ell F ^ (n + 1)))).1
        rw [EllipticRootNumber.padic_smul_torsion, EllipticRootNumber.padic_smul_torsion]
        exact hsmul n _ P.1 P.2) }
  let Pi : (∀ n : ℕ, EllipticRootNumber.torsion F E₁ (EllipticRootNumber.ell F ^ (n + 1)))
      →ₗ[ℤ_[EllipticRootNumber.ell F]]
        (∀ n : ℕ, EllipticRootNumber.torsion F E₂ (EllipticRootNumber.ell F ^ (n + 1))) :=
    LinearMap.pi fun n => (fn n).comp (LinearMap.proj n)
  have hPi : ∀ x : EllipticRootNumber.tateModule F E₁,
      Pi.comp (EllipticRootNumber.tateModule F E₁).subtype x ∈
        EllipticRootNumber.tateModule F E₂ := by
    intro x n
    show EllipticRootNumber.ell F • Ψ (x.1 (n + 1)).1 = Ψ (x.1 n).1
    rw [← hsmul (n + 1) _ _ (x.1 (n + 1)).2, x.2 n]
  let f : EllipticRootNumber.tateModule F E₁ →ₗ[ℤ_[EllipticRootNumber.ell F]]
      EllipticRootNumber.tateModule F E₂ :=
    LinearMap.codRestrict (EllipticRootNumber.tateModule F E₂)
      (Pi.comp (EllipticRootNumber.tateModule F E₁).subtype) hPi
  have hf : ∀ (x : EllipticRootNumber.tateModule F E₁) (n : ℕ),
      ((f x).1 n).1 = Ψ (x.1 n).1 := fun x n => rfl
  have hinj : Function.Injective f := by
    intro x y hxy
    apply Subtype.ext
    funext n
    apply Subtype.ext
    have h1 : ((f x).1 n).1 = ((f y).1 n).1 := by rw [hxy]
    rw [hf, hf] at h1
    exact (hbij n).injOn (x.1 n).2 (y.1 n).2 h1
  have hsurj : Function.Surjective f := by
    intro y
    have hex : ∀ n : ℕ, ∃ P : EllipticRootNumber.Pts F E₁,
        P ∈ EllipticRootNumber.torsion F E₁ (EllipticRootNumber.ell F ^ (n + 1)) ∧
          Ψ P = (y.1 n).1 := by
      intro n
      obtain ⟨P, hP, hPy⟩ := (hbij n).surjOn (y.1 n).2
      exact ⟨P, hP, hPy⟩
    choose xs hxs hΨ using hex
    have hx : (fun n => (⟨xs n, hxs n⟩ :
        EllipticRootNumber.torsion F E₁ (EllipticRootNumber.ell F ^ (n + 1)))) ∈
          EllipticRootNumber.tateModule F E₁ := by
      intro n
      show EllipticRootNumber.ell F • xs (n + 1) = xs n
      have hR : EllipticRootNumber.ell F • xs (n + 1) ∈
          EllipticRootNumber.torsion F E₁ (EllipticRootNumber.ell F ^ (n + 1)) := by
        show EllipticRootNumber.ell F ^ (n + 1) • EllipticRootNumber.ell F • xs (n + 1) = 0
        rw [← mul_nsmul', ← pow_succ]
        exact hxs (n + 1)
      refine (hbij n).injOn hR (hxs n) ?_
      rw [hsmul (n + 1) _ _ (hxs (n + 1)), hΨ, hΨ]
      exact y.2 n
    refine ⟨⟨_, hx⟩, ?_⟩
    apply Subtype.ext
    funext n
    apply Subtype.ext
    exact hΨ n
  obtain ⟨T, hT⟩ : ∃ T : EllipticRootNumber.tateModule F E₁ ≃ₗ[ℤ_[EllipticRootNumber.ell F]]
      EllipticRootNumber.tateModule F E₂, ∀ x, T x = f x :=
    ⟨LinearEquiv.ofBijective f ⟨hinj, hsurj⟩, fun _ => rfl⟩
  have hrep : ∀ (E' : WeierstrassCurve F) (σ : EllipticRootNumber.AbsGal F)
      (x : EllipticRootNumber.tateModule F E') (n : ℕ),
      ((EllipticRootNumber.tateRep F E' σ x).1 n).1 =
        EllipticRootNumber.galHom F E' σ (x.1 n).1 :=
    fun _ _ _ _ => rfl
  have heT : ∀ σ : EllipticRootNumber.AbsGal F,
      (T : EllipticRootNumber.tateModule F E₁ →ₗ[ℤ_[EllipticRootNumber.ell F]]
        EllipticRootNumber.tateModule F E₂) ∘ₗ EllipticRootNumber.tateRep F E₁ σ =
        EllipticRootNumber.tateRep F E₂ σ ∘ₗ (T : EllipticRootNumber.tateModule F E₁
          →ₗ[ℤ_[EllipticRootNumber.ell F]] EllipticRootNumber.tateModule F E₂) := by
    intro σ
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    funext n
    apply Subtype.ext
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe]
    rw [hT, hT, hf, hrep, hrep, hf]
    exact hgal σ n _ (x.1 n).2
