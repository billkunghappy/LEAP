  have d13 : algebraMap F (AlgebraicClosure F) t₁ ≠ algebraMap F (AlgebraicClosure F) t₃ :=
    fun e => h₁₃ (hinj e)
  have d23 : algebraMap F (AlgebraicClosure F) t₂ ≠ algebraMap F (AlgebraicClosure F) t₃ :=
