      Nat.card A = 2 ^ m → Nat.card B' = 2 ^ m → Nat.card C = 2 ^ m →
      Nat.card (A ⊓ (B' ⊔ C) : Subgroup W) * Nat.card (B' ⊓ C : Subgroup W) =
