      (Submodule.span (algebraMap ℚ (v.adicCompletion K)).fieldRange.topologicalClosure
        (Set.range s))
      (⟨_, hQ i⟩ : (algebraMap ℚ (v.adicCompletion K)).fieldRange.topologicalClosure)
      (Submodule.subset_span ⟨i, rfl⟩)
    rwa [Subfield.smul_def, smul_eq_mul] at hm
  have hball : ∀ x : v.adicCompletion K, Valued.v x ≤ 1 →
      x ∈ Submodule.span (algebraMap ℚ (v.adicCompletion K)).fieldRange.topologicalClosure
        (Set.range fun ij : Fin ((Ideal.span {(p : ℤ)}).inertiaDeg w.asIdeal) ×
            Fin (Ideal.ramificationIdx (algebraMap ℤ (NumberField.RingOfIntegers L))
              (Ideal.span {(p : ℤ)}) w.asIdeal) =>
          ((algebraMap (NumberField.RingOfIntegers L) L (ω ij.1) : L) : v.adicCompletion K) *
            ((π₀ : L) : v.adicCompletion K) ^ (ij.2 : ℕ)) := by
    intro x hx
    refine s6 _ ?_ x hx
    intro x' hx'
    obtain ⟨y, hy, hxy⟩ := h5 x' hx'
    exact ⟨y, hy, hpF ▸ hxy⟩
  
  have he1 : (1 : ℤ) ≤ ((Ideal.ramificationIdx (algebraMap ℤ (NumberField.RingOfIntegers L))
        (Ideal.span {(p : ℤ)}) w.asIdeal : ℕ) : ℤ) := by
    have h1 := hpv
    rw [hpF, ← WithZero.exp_zero, WithZero.exp_lt_exp] at h1
    omega
  have hmemQ : ∀ q : ℚ, algebraMap ℚ (v.adicCompletion K) q ∈
      (algebraMap ℚ (v.adicCompletion K)).fieldRange.topologicalClosure := fun q =>
    Subfield.le_topologicalClosure _ (RingHom.mem_fieldRange.mpr ⟨q, rfl⟩)
  have htop : Submodule.span (algebraMap ℚ (v.adicCompletion K)).fieldRange.topologicalClosure
      (Set.range fun ij : Fin ((Ideal.span {(p : ℤ)}).inertiaDeg w.asIdeal) ×
            Fin (Ideal.ramificationIdx (algebraMap ℤ (NumberField.RingOfIntegers L))
              (Ideal.span {(p : ℤ)}) w.asIdeal) =>
          ((algebraMap (NumberField.RingOfIntegers L) L (ω ij.1) : L) : v.adicCompletion K) *
            ((π₀ : L) : v.adicCompletion K) ^ (ij.2 : ℕ)) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    by_cases hx0 : x = 0
    · rw [hx0]
      exact Submodule.zero_mem _
    have hvx : Valued.v x ≠ 0 := (Valuation.ne_zero_iff _).mpr hx0
    obtain ⟨g, hg⟩ : ∃ g : ℤ, Valued.v x = WithZero.exp g :=
      ⟨_, (WithZero.exp_log hvx).symm⟩
    have hpN : Valued.v ((p : v.adicCompletion K) ^ g.toNat * x) ≤ 1 := by
      rw [Valuation.map_mul, Valuation.map_pow, hpF, hg, ← WithZero.exp_nsmul,
        ← WithZero.exp_add, ← WithZero.exp_zero, WithZero.exp_le_exp, nsmul_eq_mul]
      have h2 : g ≤ ((g.toNat : ℕ) : ℤ) := Int.self_le_toNat _
      have h3 : (0 : ℤ) ≤ ((g.toNat : ℕ) : ℤ) := Int.natCast_nonneg _
      nlinarith
    have hq : ((p : v.adicCompletion K) ^ g.toNat)⁻¹ ∈
        (algebraMap ℚ (v.adicCompletion K)).fieldRange.topologicalClosure := by
      have e2 : ((p : v.adicCompletion K) ^ g.toNat)⁻¹ =
          algebraMap ℚ (v.adicCompletion K) (((p : ℚ) ^ g.toNat)⁻¹) := by
        simp
      rw [e2]
      exact hmemQ _
    have hmem := Submodule.smul_mem _ (⟨_, hq⟩ :
      (algebraMap ℚ (v.adicCompletion K)).fieldRange.topologicalClosure) (hball _ hpN)
    rw [Subfield.smul_def, smul_eq_mul] at hmem
    convert hmem using 1
    rw [← mul_assoc, inv_mul_cancel₀ (pow_ne_zero _ hp0), one_mul]
  refine ⟨Module.Finite.of_fg_top (htop ▸ Submodule.fg_span (Set.finite_range _)), ?_⟩
  have hle := finrank_le_of_span_eq_top htop
  rw [Fintype.card_prod, Fintype.card_fin, Fintype.card_fin, Nat.mul_comm] at hle
  exact hle

theorem exists_totally_real_completion_model {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    ∃ (K' : Type u) (_ : Field K') (_ : NumberField K') (_ : NumberField.IsTotallyReal K')
      (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K')),
      Nonempty (v.adicCompletion K ≃+* v₀.adicCompletion K') ∧
      (IsDedekindDomain.HeightOneSpectrum.valuation K v 2 < 1 →
        ∀ v' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'),
          IsDedekindDomain.HeightOneSpectrum.valuation K' v' 2 < 1 → v' = v₀) :=
by
  
  have s4 : ∀ {E : Type u} [Field E] [Algebra ℚ E] (β : E) (G : Polynomial ℚ) (hG : G.Monic)
      (hβ : Polynomial.aeval β G = 0)
      (hreal : (G.map (algebraMap ℚ ℝ)).roots.card = G.natDegree),
      NumberField.IsTotallyReal (IntermediateField.adjoin ℚ {β}) := by
    intro E _ _ β G hG hβ hreal
    rw [NumberField.isTotallyReal_iff]
    intro w
    rw [NumberField.InfinitePlace.isReal_iff, NumberField.ComplexEmbedding.isReal_iff]
    set φ := w.embedding with hφ
    have hreal' : (G.map (algebraMap ℚ ℝ)).roots.card = (G.map (algebraMap ℚ ℝ)).natDegree := by
      rw [Polynomial.natDegree_map]; exact hreal
    have hprod := Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C hreal'
    rw [(hG.map (algebraMap ℚ ℝ)).leadingCoeff, map_one, one_mul] at hprod
    set gen := IntermediateField.AdjoinSimple.gen ℚ β with hgen
    have hβ' : Polynomial.eval₂ (algebraMap ℚ ↥(IntermediateField.adjoin ℚ {β})) gen G = 0 := by
      apply (IntermediateField.adjoin ℚ {β}).toSubfield.subtype.injective
      rw [Polynomial.hom_eval₂, map_zero]
      have hs : ((IntermediateField.adjoin ℚ {β}).toSubfield.subtype).comp
          (algebraMap ℚ ↥(IntermediateField.adjoin ℚ {β})) = algebraMap ℚ E :=
        RingHom.ext_rat _ _
      rw [hs, ← Polynomial.aeval_def]
      exact hβ
    have hz : Polynomial.aeval (φ gen) G = 0 := by
      rw [Polynomial.aeval_def]
      have hs : φ.comp (algebraMap ℚ ↥(IntermediateField.adjoin ℚ {β})) = algebraMap ℚ ℂ :=
        RingHom.ext_rat _ _
      rw [← hs, ← Polynomial.hom_eval₂, hβ', map_zero]
    have hz2 : ((G.map (algebraMap ℚ ℝ)).map (algebraMap ℝ ℂ)).eval (φ gen) = 0 := by
      rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq, Polynomial.eval_map_algebraMap]
      exact hz
    rw [← hprod, Polynomial.map_multiset_prod, Polynomial.eval_multiset_prod,
      Multiset.prod_eq_zero_iff] at hz2
    simp only [Multiset.map_map, Multiset.mem_map, Function.comp_apply, Polynomial.map_sub,
      Polynomial.map_X, Polynomial.map_C, Polynomial.eval_sub, Polynomial.eval_X,
      Polynomial.eval_C] at hz2
    obtain ⟨a, -, ha⟩ := hz2
    have hzr : φ gen = (a : ℂ) := sub_eq_zero.mp ha
    have key : ∀ f g : ↥(IntermediateField.adjoin ℚ {β}) →+* ℂ, f gen = g gen → f = g := by
      intro f g hfg
      have h := IntermediateField.adjoin_algHom_ext ℚ (K := ℂ) (s := {β})
        (φ₁ := @AlgHom.mk ℚ _ ℂ _ _ _ (IntermediateField.adjoin ℚ {β}).algebra' _ f
          (by intro r; simp [eq_ratCast]))
        (φ₂ := @AlgHom.mk ℚ _ ℂ _ _ _ (IntermediateField.adjoin ℚ {β}).algebra' _ g
          (by intro r; simp [eq_ratCast]))
        (by
          intro x hx
          rw [Set.mem_singleton_iff] at hx
          subst hx
          exact hfg)
      exact RingHom.ext fun x => DFunLike.congr_fun h x
    apply key
    show (starRingEnd ℂ) (φ gen) = φ gen
    rw [hzr, Complex.conj_ofReal]
  
  have s6 : ∀ {L : Type u} [Field L] [NumberField L] (p : ℕ) (hp : p.Prime)
      (w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L))
      (hw : (p : NumberField.RingOfIntegers L) ∈ w.asIdeal)
      (hef : Module.finrank ℚ L ≤
        Ideal.ramificationIdx (algebraMap ℤ (NumberField.RingOfIntegers L))
          (Ideal.span {(p : ℤ)}) w.asIdeal * (Ideal.span {(p : ℤ)}).inertiaDeg w.asIdeal)
      (w' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L))
      (hw' : (p : NumberField.RingOfIntegers L) ∈ w'.asIdeal), w' = w := by
    intro L _ _ p hp w hw hef w' hw'
    classical
    haveI : Fact p.Prime := ⟨hp⟩
    haveI hmax : (Ideal.span {(p : ℤ)}).IsMaximal := Int.ideal_span_isMaximal_of_prime p
    have h0 : Ideal.span {(p : ℤ)} ≠ ⊥ := by
      rw [Ne, Ideal.span_singleton_eq_bot]; exact_mod_cast hp.ne_zero
    have hover : ∀ P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L),
        (p : NumberField.RingOfIntegers L) ∈ P.asIdeal →
        P.asIdeal ∈ primesOverFinset (Ideal.span {(p : ℤ)}) (NumberField.RingOfIntegers L) := by
      intro P hP
      haveI := P.isPrime
      rw [mem_primesOverFinset_iff h0]
      refine ⟨P.isPrime, ⟨?_⟩⟩
      apply hmax.eq_of_le
      · exact (Ideal.IsPrime.comap (K := P.asIdeal) (algebraMap ℤ _)).ne_top
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        show (algebraMap ℤ (NumberField.RingOfIntegers L) (p : ℤ)) ∈ P.asIdeal
        simpa using hP
    have hsum := Ideal.sum_ramification_inertia (NumberField.RingOfIntegers L) ℚ L h0
    by_contra hne
    have hne' : w'.asIdeal ≠ w.asIdeal := fun h => hne (IsDedekindDomain.HeightOneSpectrum.ext h)
    have hsub : ({w.asIdeal, w'.asIdeal} : Finset (Ideal (NumberField.RingOfIntegers L))) ⊆
        primesOverFinset (Ideal.span {(p : ℤ)}) (NumberField.RingOfIntegers L) := by
      intro P hP
      rw [Finset.mem_insert, Finset.mem_singleton] at hP
      rcases hP with rfl | rfl
      · exact hover w hw
      · exact hover w' hw'
    have hle := Finset.sum_le_sum_of_subset (f := fun P => Ideal.ramificationIdx
      (algebraMap ℤ (NumberField.RingOfIntegers L)) (Ideal.span {(p : ℤ)}) P *
        (Ideal.span {(p : ℤ)}).inertiaDeg P) hsub
    rw [Finset.sum_pair hne'.symm, hsum] at hle
    have he : Ideal.ramificationIdx (algebraMap ℤ (NumberField.RingOfIntegers L))
        (Ideal.span {(p : ℤ)}) w'.asIdeal ≠ 0 := by
      apply Ideal.IsDedekindDomain.ramificationIdx_ne_zero
      · rw [Ne, Ideal.map_eq_bot_iff_of_injective]
        · exact h0
        · exact (algebraMap ℤ (NumberField.RingOfIntegers L)).injective_int
      · exact w'.isPrime
      · rw [Ideal.map_le_iff_le_comap, Ideal.span_le, Set.singleton_subset_iff]
        show (algebraMap ℤ (NumberField.RingOfIntegers L) (p : ℤ)) ∈ w'.asIdeal
        simpa using hw'
    have hf : 0 < (Ideal.span {(p : ℤ)}).inertiaDeg w'.asIdeal := by
      haveI : w'.asIdeal.LiesOver (Ideal.span {(p : ℤ)}) :=
        ((mem_primesOverFinset_iff h0 _).mp (hover w' hw')).2
      exact Ideal.inertiaDeg_pos _ _
    have hpos := Nat.mul_pos (Nat.pos_of_ne_zero he) hf
    omega
  obtain ⟨β, G, hGm, hβ, hreal, hdense, hdeg⟩ := exists_dense_real_rooted_generator v
  have hint : IsIntegral ℚ β := ⟨G, hGm, by rwa [Polynomial.aeval_def] at hβ⟩
  let K' : IntermediateField ℚ (v.adicCompletion K) := IntermediateField.adjoin ℚ {β}
  haveI hfd : FiniteDimensional ℚ K' := IntermediateField.adjoin.finiteDimensional hint
  haveI hczK : CharZero K' := charZero_of_injective_algebraMap (algebraMap ℚ K').injective
  haveI hnf : NumberField K' := by
    refine @NumberField.mk K' _ hczK ?_
    convert hfd <;> first | rfl | exact Subsingleton.elim _ _
  have htr : NumberField.IsTotallyReal K' := s4 β G hGm hβ hreal
  obtain ⟨v₀, hv₀⟩ := exists_place_of_dense_numberField_subfield v K' hdense
  have hiso := adicCompletion_ringEquiv_of_dense v K' hdense v₀ hv₀
  refine ⟨K', inferInstance, hnf, htr, v₀, hiso, ?_⟩
  intro h2 v' hv'
  have h2F : Valued.v ((2 : ℕ) : v.adicCompletion K) < 1 := by
    have e : Valued.v ((2 : ℕ) : v.adicCompletion K) =
        IsDedekindDomain.HeightOneSpectrum.valuation K v 2 := by
      rw [← IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation']
      congr 1
      rw [Nat.cast_ofNat]
      exact (map_ofNat (UniformSpace.Completion.coeRingHom) 2).symm
    rw [e]
    exact h2
  have h2K' : IsDedekindDomain.HeightOneSpectrum.valuation K' v₀ 2 < 1 := by
    rw [hv₀]
    have e : ((2 : K') : v.adicCompletion K) = ((2 : ℕ) : v.adicCompletion K) := by
      rw [Nat.cast_ofNat]
      exact map_ofNat K'.val 2
    rw [e]
    exact h2F
  have hmem : ∀ w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'),
      IsDedekindDomain.HeightOneSpectrum.valuation K' w 2 < 1 →
        ((2 : ℕ) : NumberField.RingOfIntegers K') ∈ w.asIdeal := by
    intro w hw
    rw [← IsDedekindDomain.HeightOneSpectrum.valuation_lt_one_iff_mem (K := K')]
    simpa using hw
  obtain ⟨hfdQ, hle⟩ := finrank_closure_rat_le_ramificationIdx_mul_inertiaDeg v K' hdense v₀ hv₀
    2 Nat.prime_two h2F
  have hdvd : minpoly ℚ β ∣ G := minpoly.dvd ℚ β hβ
  have hG0 : G ≠ 0 := hGm.ne_zero
  have hnat : (minpoly ℚ β).natDegree ≤ G.natDegree := Polynomial.natDegree_le_of_dvd hdvd hG0
  have hef0 := (IntermediateField.adjoin.finrank hint).trans_le
    (hnat.trans ((hdeg hfdQ).trans hle))
  refine s6 2 Nat.prime_two v₀ (hmem v₀ h2K') ?_ v'
    (hmem v' hv')
  convert hef0 <;> first | rfl | exact Subsingleton.elim _ _

theorem localFieldStructure_ringEquiv_le_one_iff {F₁ F₂ : Type u} [Field F₁] [Field F₂]
    [CharZero F₁]
    [ValuativeRel F₁] [TopologicalSpace F₁] [IsNonarchimedeanLocalField F₁]
    [ValuativeRel F₂] [TopologicalSpace F₂] [IsNonarchimedeanLocalField F₂]
    (τ : F₁ ≃+* F₂) (x : F₁) :
    ValuativeRel.valuation F₂ (τ x) ≤ 1 ↔ ValuativeRel.valuation F₁ x ≤ 1 :=
by
  classical
  
  
  have gen : ∀ {R : Type u} [CommRing R] [HenselianLocalRing R] (c : R) (ℓ : ℕ), ℓ ≠ 0 →
      c - 1 ∈ IsLocalRing.maximalIdeal R → IsUnit (ℓ : R) → ∃ a : R, a ^ ℓ = c := by
    intro R _ _ c ℓ hℓ hc hu
    obtain ⟨a, ha, -⟩ := HenselianLocalRing.is_henselian (Polynomial.X ^ ℓ - Polynomial.C c)
      (Polynomial.monic_X_pow_sub_C c hℓ) 1
      (by
        rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
          one_pow, ← neg_sub]
        exact (IsLocalRing.maximalIdeal R).neg_mem hc)
      (by
        rw [Polynomial.derivative_sub, Polynomial.derivative_C, sub_zero,
          Polynomial.derivative_X_pow]
        simpa using hu)
    refine ⟨a, ?_⟩
    have ha' : a ^ ℓ - c = 0 := by simpa [Polynomial.IsRoot] using ha
    exact sub_eq_zero.mp ha'
  
  have hens : ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F], HenselianLocalRing ↥(ValuativeRel.valuation F).integer := by
    intro F _ _ _ _
    set O := ↥(ValuativeRel.valuation F).integer
    have hclosed : ∀ (n : ℕ) (a : O),
        IsClosed {y : O | y - a ∈ (IsLocalRing.maximalIdeal O) ^ n} := by
      intro n a
      obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O
      have hset := Irreducible.maximalIdeal_pow_eq_setOf_le_v_coe_pow
        (v := ValuativeRel.valuation F) hϖ n
      have : {y : O | y - a ∈ (IsLocalRing.maximalIdeal O) ^ n} =
          (fun y : O => ((y : F) - (a : F))) ⁻¹'
            {x : F | ValuativeRel.valuation F x ≤ ValuativeRel.valuation F (ϖ : F) ^ n} := by
        ext y
        have h := congrArg (fun s : Set O => (y - a) ∈ s) hset
        simp only [SetLike.mem_coe, eq_iff_iff] at h
        simp only [Set.mem_setOf_eq, Set.mem_preimage]
        rw [h]
        rfl
      rw [this]
      exact (IsValuativeTopology.isClosed_closedBall _).preimage
        (continuous_subtype_val.sub continuous_const)
    have hpre : IsPrecomplete (IsLocalRing.maximalIdeal O) O := by
      refine ⟨fun {f} hf => ?_⟩
      obtain ⟨L, -, hL⟩ := (isCompact_univ (X := O)).exists_clusterPt
        (f := Filter.map f Filter.atTop) (by simp)
      refine ⟨L, fun n => ?_⟩
      have hC : {y : O | y - f n ∈ (IsLocalRing.maximalIdeal O) ^ n} ∈
          Filter.map f Filter.atTop := by
        rw [Filter.mem_map, Filter.mem_atTop_sets]
        refine ⟨n, fun k hk => ?_⟩
        have := (hf hk).symm
        rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top] at this
        exact this
      have hmem := hL.mem_closure_of_mem _ hC
      rw [(hclosed n (f n)).closure_eq] at hmem
      rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top]
      have : f n - L = -(L - f n) := by ring
      rw [this]
      exact neg_mem hmem
    haveI := hpre
    haveI : IsAdicComplete (IsLocalRing.maximalIdeal O) O := {}
    haveI := IsAdicComplete.henselianRing O (IsLocalRing.maximalIdeal O)
    refine ⟨fun f hf a₀ h₁ h₂ => ?_⟩
    exact HenselianRing.is_henselian f hf a₀ h₁ (h₂.map (Ideal.Quotient.mk _))
  
  have reval : ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F], ∃ v : Valuation F (WithZero (Multiplicative ℤ)),
        ∀ y : F, v y ≤ 1 ↔ ValuativeRel.valuation F y ≤ 1 := by
    intro F _ _ _ _
    let e := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    refine ⟨(ValuativeRel.valuation F).map
      (e : ValuativeRel.ValueGroupWithZero F →*₀ WithZero (Multiplicative ℤ))
      e.toOrderIso.monotone, fun y => ?_⟩
    rw [Valuation.map_apply]
    show e (ValuativeRel.valuation F y) ≤ 1 ↔ _
    rw [← map_one e]
    exact e.toOrderIso.le_iff_le
  
  have key : ∀ {A B : Type u} [Field A] [Field B]
      [ValuativeRel A] [TopologicalSpace A] [IsNonarchimedeanLocalField A]
      [ValuativeRel B] [TopologicalSpace B] [IsNonarchimedeanLocalField B]
      (σ : A ≃+* B) (y : A),
      ValuativeRel.valuation A y ≤ 1 → ValuativeRel.valuation B (σ y) ≤ 1 := by
    intro A B _ _ _ _ _ _ _ _ σ y hy
    haveI hH : HenselianLocalRing ↥(ValuativeRel.valuation A).integer := hens A
    obtain ⟨v₂, hv₂⟩ := reval B
    let v : Valuation A (WithZero (Multiplicative ℤ)) := v₂.comap (σ : A →+* B)
    have hv : ∀ t : A, v t = v₂ (σ t) := fun t => rfl
    
    have hnat : ∀ n : ℕ, ValuativeRel.valuation A (n : A) ≤ 1 := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        push_cast
        exact le_trans (Valuation.map_add _ _ _) (max_le ih (by simp))
    
    have hgood : ∀ N : ℕ, ∃ ℓ : ℕ, N < ℓ ∧ ValuativeRel.valuation A (ℓ : A) = 1 := by
      intro N
      by_cases h : ValuativeRel.valuation A ((N + 1 : ℕ) : A) = 1
      · exact ⟨N + 1, by omega, h⟩
      · have hlt : ValuativeRel.valuation A ((N + 1 : ℕ) : A) < 1 := lt_of_le_of_ne (hnat _) h
        refine ⟨N + 2, by omega, ?_⟩
        have e : ((N + 2 : ℕ) : A) = ((N + 1 : ℕ) : A) + 1 := by
          push_cast; ring
        rw [e, Valuation.map_add_eq_of_lt_right _ (by rw [map_one]; exact hlt), map_one]
    
    have hroot : ∀ ℓ : ℕ, ValuativeRel.valuation A (ℓ : A) = 1 →
        ∀ z : A, ValuativeRel.valuation A z < 1 → ∃ a : A, a ^ ℓ = 1 + z := by
      intro ℓ hℓ z hz
      have hℓ0 : ℓ ≠ 0 := by
        rintro rfl
        simp at hℓ
      have hint := Valuation.integer.integers (ValuativeRel.valuation A)
      have hzO : z ∈ (ValuativeRel.valuation A).integer := le_of_lt hz
      let z' : (ValuativeRel.valuation A).integer := ⟨z, hzO⟩
      have hmem : (1 + z') - 1 ∈ IsLocalRing.maximalIdeal (ValuativeRel.valuation A).integer := by
        rw [add_sub_cancel_left, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
          hint.isUnit_iff_valuation_eq_one]
        intro h
        have h' : ValuativeRel.valuation A z = 1 := h
        exact absurd h' (ne_of_lt hz)
      have hunit : IsUnit (ℓ : (ValuativeRel.valuation A).integer) := by
        rw [hint.isUnit_iff_valuation_eq_one, map_natCast]
        exact hℓ
      obtain ⟨a, ha⟩ := gen (1 + z') ℓ hℓ0 hmem hunit
      refine ⟨(a : A), ?_⟩
      have := congrArg (fun t : (ValuativeRel.valuation A).integer => (t : A)) ha
      simpa [z'] using this
    
    obtain ⟨π, hπ0, hπ⟩ : ∃ π : A, π ≠ 0 ∧ ValuativeRel.valuation A π < 1 := by
      obtain ⟨γ, hγ0, hγ1⟩ := (inferInstance : ValuativeRel.IsNontrivial A).condition
      obtain ⟨y₀, hy₀⟩ := ValuativeRel.valuation_surjective γ
      have hy0 : y₀ ≠ 0 := by
        rintro rfl
        rw [map_zero] at hy₀
        exact hγ0 hy₀.symm
      rcases lt_or_gt_of_ne hγ1 with h | h
      · exact ⟨y₀, hy0, hy₀ ▸ h⟩
      · refine ⟨y₀⁻¹, inv_ne_zero hy0, ?_⟩
        rw [map_inv₀, hy₀]
        exact inv_lt_one_of_one_lt₀ h
    
    have hB : v y ≤ 1 := by
      by_contra hcon
      have hγ : 1 < v y := lt_of_not_ge hcon
      obtain ⟨ℓ, hNℓ, hℓ⟩ := hgood (WithZero.log (v y)).toNat
      have hvπ0 : v π ≠ 0 := (Valuation.ne_zero_iff _).mpr hπ0
      obtain ⟨m, hm⟩ := MulArchimedean.arch (v π)⁻¹ hγ
      have hm' : 1 ≤ v π * v y ^ m := by
        calc (1 : WithZero (Multiplicative ℤ)) = v π * (v π)⁻¹ :=
              (mul_inv_cancel₀ hvπ0).symm
          _ ≤ _ := mul_le_mul_left' hm _
      have hvz₁ : 1 < v (π * y ^ (m + 1)) := by
        have e : v (π * y ^ (m + 1)) = (v π * v y ^ m) * v y := by
          rw [map_mul, map_pow, pow_succ, mul_assoc]
        rw [e]
        calc (1 : WithZero (Multiplicative ℤ)) < v y := hγ
          _ = 1 * v y := (one_mul _).symm
          _ ≤ _ := mul_le_mul_right' hm' _
      have hwz₁ : ValuativeRel.valuation A (π * y ^ (m + 1)) < 1 := by
        rw [map_mul, map_pow]
        exact lt_of_le_of_lt (mul_le_of_le_one_right' (pow_le_one' hy _)) hπ
      have hwz₂ : ValuativeRel.valuation A (π * y ^ (m + 1) * y) < 1 := by
        rw [map_mul]
        exact lt_of_le_of_lt (mul_le_of_le_one_right' hy) hwz₁
      obtain ⟨a₁, ha₁⟩ := hroot ℓ hℓ _ hwz₁
      obtain ⟨a₂, ha₂⟩ := hroot ℓ hℓ _ hwz₂
      have hvz₂ : 1 < v (π * y ^ (m + 1) * y) := by
        rw [map_mul]
        calc (1 : WithZero (Multiplicative ℤ)) < v (π * y ^ (m + 1)) := hvz₁
          _ = v (π * y ^ (m + 1)) * 1 := (mul_one _).symm
          _ ≤ _ := mul_le_mul_left' hγ.le _
      have e1 : v (1 + π * y ^ (m + 1)) = v (π * y ^ (m + 1)) :=
        Valuation.map_add_eq_of_lt_right _ (by rw [map_one]; exact hvz₁)
      have e2 : v (1 + π * y ^ (m + 1) * y) = v (π * y ^ (m + 1)) * v y := by
        rw [Valuation.map_add_eq_of_lt_right _ (by rw [map_one]; exact hvz₂), map_mul]
      have hvz₁0 : v (π * y ^ (m + 1)) ≠ 0 := ne_of_gt (lt_trans zero_lt_one hvz₁)
      have hδ : (v (a₂ / a₁)) ^ ℓ = v y := by
        rw [← map_pow, div_pow, ha₁, ha₂, map_div₀, e1, e2, mul_div_cancel_left₀ _ hvz₁0]
      generalize v (a₂ / a₁) = δ at hδ
      have hδ1 : 1 < δ := by
        by_contra h
        have h' : δ ^ ℓ ≤ 1 := pow_le_one' (le_of_not_gt h) _
        rw [hδ] at h'
        exact absurd hγ (not_lt.mpr h')
      have hδ0 : δ ≠ 0 := ne_of_gt (lt_trans zero_lt_one hδ1)
      have hj : 0 < WithZero.log δ := by
        have h' : WithZero.exp (0 : ℤ) < WithZero.exp (WithZero.log δ) := by
          rw [WithZero.exp_zero, WithZero.exp_log hδ0]
          exact hδ1
        exact WithZero.exp_lt_exp.mp h'
      have hlog : WithZero.log (v y) = (ℓ : ℤ) * WithZero.log δ := by
        rw [← hδ]
        conv_lhs => rw [← WithZero.exp_log hδ0]
        rw [← WithZero.exp_nsmul, WithZero.log_exp, nsmul_eq_mul]
      have h3 := Int.self_le_toNat (WithZero.log (v y))
      have h4 : ((WithZero.log (v y)).toNat : ℤ) < ℓ := by exact_mod_cast hNℓ
      have h5 : (ℓ : ℤ) ≤ (ℓ : ℤ) * WithZero.log δ :=
        le_mul_of_one_le_right (by positivity) hj
      linarith
    rw [hv] at hB
    exact (hv₂ (σ y)).mp hB
  
  constructor
  · intro h
    have := key τ.symm (τ x) h
    rwa [RingEquiv.symm_apply_apply] at this
  · exact key τ x

theorem nonempty_localFieldStructure_of_ringEquiv {F₁ F₂ : Type u} [Field F₁] [Field F₂]
    (τ : F₁ ≃+* F₂) (h : Nonempty (EllipticRootNumber.LocalFieldStructure F₂)) :
    Nonempty (EllipticRootNumber.LocalFieldStructure F₁) :=
by
  obtain ⟨⟨r₂, t₂, hL₂⟩⟩ := h
  have key : ∀ (r₁ : ValuativeRel F₁),
      (∀ x y : F₁, ValuativeRel.vle x y ↔ ValuativeRel.vle (τ x) (τ y)) →
      @IsNonarchimedeanLocalField F₁ _ r₁ (TopologicalSpace.induced (⇑τ) t₂) := by
    intro r₁ hrel
    
    have hC : ∀ a z : F₁, ValuativeRel.valuation F₁ z < ValuativeRel.valuation F₁ a ↔
        ValuativeRel.valuation F₂ (τ z) < ValuativeRel.valuation F₂ (τ a) := by
      intro a z
      rw [← not_le, ← not_le, ← Valuation.vle_iff_le (ValuativeRel.valuation F₁),
        ← Valuation.vle_iff_le (ValuativeRel.valuation F₂), hrel]
    have hb₁ : ∀ γ₁ : (ValuativeRel.ValueGroupWithZero F₁)ˣ,
        ∃ γ₂ : (ValuativeRel.ValueGroupWithZero F₂)ˣ,
        ∀ z : F₁, ValuativeRel.valuation F₁ z < γ₁ ↔ ValuativeRel.valuation F₂ (τ z) < γ₂ := by
      intro γ₁
      obtain ⟨a, ha⟩ :=
        ValuativeRel.valuation_surjective (γ₁ : ValuativeRel.ValueGroupWithZero F₁)
      have ha0 : a ≠ 0 := by
        rintro rfl
        rw [map_zero] at ha
        exact γ₁.ne_zero ha.symm
      have hτa : ValuativeRel.valuation F₂ (τ a) ≠ 0 :=
        (Valuation.ne_zero_iff _).mpr ((map_ne_zero τ).mpr ha0)
      refine ⟨Units.mk0 _ hτa, fun z => ?_⟩
      rw [Units.val_mk0, ← ha]
      exact hC a z
    have hb₂ : ∀ γ₂ : (ValuativeRel.ValueGroupWithZero F₂)ˣ,
        ∃ γ₁ : (ValuativeRel.ValueGroupWithZero F₁)ˣ,
        ∀ z : F₁, ValuativeRel.valuation F₁ z < γ₁ ↔ ValuativeRel.valuation F₂ (τ z) < γ₂ := by
      intro γ₂
      obtain ⟨b, hb⟩ :=
        ValuativeRel.valuation_surjective (γ₂ : ValuativeRel.ValueGroupWithZero F₂)
      have hb0 : b ≠ 0 := by
        rintro rfl
        rw [map_zero] at hb
        exact γ₂.ne_zero hb.symm
      have ha0 : τ.symm b ≠ 0 := (map_ne_zero τ.symm).mpr hb0
      have hva : ValuativeRel.valuation F₁ (τ.symm b) ≠ 0 := (Valuation.ne_zero_iff _).mpr ha0
      refine ⟨Units.mk0 _ hva, fun z => ?_⟩
      rw [Units.val_mk0, ← hb, hC, RingEquiv.apply_symm_apply]
    letI t₁ : TopologicalSpace F₁ := TopologicalSpace.induced (⇑τ) t₂
    
    have hT : IsValuativeTopology F₁ := by
      refine ⟨fun {s} {x} => ?_⟩
      have e1 : s ∈ nhds x ↔ (⇑τ) '' s ∈ nhds (τ x) := by
        rw [nhds_induced, Filter.mem_comap]
        constructor
        · rintro ⟨t, ht, hts⟩
          refine Filter.mem_of_superset ht (fun w hw => ⟨τ.symm w, hts ?_, by simp⟩)
          show τ (τ.symm w) ∈ t
          simpa using hw
        · intro hs
          exact ⟨(⇑τ) '' s, hs, by rw [Set.preimage_image_eq s τ.injective]⟩
      have e2 : ∀ γ₂ : (ValuativeRel.ValueGroupWithZero F₂)ˣ,
          (fun y => τ x + y) '' {w | ValuativeRel.valuation F₂ w < ↑γ₂} ⊆ (⇑τ) '' s ↔
          ∀ z : F₁, ValuativeRel.valuation F₂ (τ z) < ↑γ₂ → x + z ∈ s := by
        intro γ₂
        constructor
        · intro hsub z hz
          obtain ⟨y, hy, hyeq⟩ := hsub ⟨τ z, hz, rfl⟩
          have : y = x + z := τ.injective (by rw [hyeq, map_add])
          exact this ▸ hy
        · rintro hall _ ⟨w, hw, rfl⟩
          refine ⟨x + τ.symm w, hall (τ.symm w) (by simpa using hw), ?_⟩
          simp
      have e3 : ∀ γ₁ : (ValuativeRel.ValueGroupWithZero F₁)ˣ,
          (fun y => x + y) '' {z | ValuativeRel.valuation F₁ z < ↑γ₁} ⊆ s ↔
          ∀ z : F₁, ValuativeRel.valuation F₁ z < ↑γ₁ → x + z ∈ s := by
        intro γ₁
        constructor
        · intro hsub z hz
          exact hsub ⟨z, hz, rfl⟩
        · rintro hall _ ⟨z, hz, rfl⟩
          exact hall z hz
      rw [e1, IsValuativeTopology.mem_nhds_iff]
      simp only [e2, e3]
      constructor
      · rintro ⟨γ₂, hγ₂⟩
        obtain ⟨γ₁, hγ₁⟩ := hb₂ γ₂
        exact ⟨γ₁, fun z hz => hγ₂ z ((hγ₁ z).mp hz)⟩
      · rintro ⟨γ₁, hγ₁⟩
        obtain ⟨γ₂, hγ₂⟩ := hb₁ γ₁
        exact ⟨γ₂, fun z hz => hγ₁ z ((hγ₂ z).mpr hz)⟩
    
    have hLC : LocallyCompactSpace F₁ := by
      let hτ : F₁ ≃ₜ F₂ :=
        { toEquiv := τ.toEquiv
          continuous_toFun := continuous_induced_dom
          continuous_invFun := by
            refine continuous_induced_rng.mpr ?_
            have : (⇑τ ∘ fun y => τ.toEquiv.symm y) = id := funext fun y => by simp
            show Continuous (⇑τ ∘ fun y => τ.toEquiv.symm y)
            rw [this]
            exact continuous_id }
      exact (Homeomorph.locallyCompactSpace_iff hτ).mpr inferInstance
    
    have hN : ValuativeRel.IsNontrivial F₁ := by
      let w : Valuation F₁ (ValuativeRel.ValueGroupWithZero F₂) :=
        (ValuativeRel.valuation F₂).comap (τ : F₁ →+* F₂)
      haveI : w.Compatible := Valuation.Compatible.mk (fun x y =>
        (hrel x y).trans (Valuation.vle_iff_le (ValuativeRel.valuation F₂)))
      rw [ValuativeRel.isNontrivial_iff_isNontrivial w, Valuation.isNontrivial_iff_exists_lt_one]
      have h2 : (ValuativeRel.valuation F₂).IsNontrivial :=
        (ValuativeRel.isNontrivial_iff_isNontrivial (ValuativeRel.valuation F₂)).mp inferInstance
      obtain ⟨y, hy0, hy1⟩ := (Valuation.isNontrivial_iff_exists_lt_one _).mp h2
      refine ⟨τ.symm y, (map_ne_zero τ.symm).mpr hy0, ?_⟩
      show ValuativeRel.valuation F₂ (τ (τ.symm y)) < 1
      rw [RingEquiv.apply_symm_apply]
      exact hy1
    exact @IsNonarchimedeanLocalField.mk F₁ _ r₁ t₁ hT hLC hN
  exact ⟨⟨ValuativeRel.ofValuation ((ValuativeRel.valuation F₂).comap (τ : F₁ →+* F₂)),
    TopologicalSpace.induced (⇑τ) t₂,
    key _ (fun x y => (Valuation.vle_iff_le (ValuativeRel.valuation F₂)).symm)⟩⟩

theorem ringEquiv_localField_invariants {F₁ F₂ : Type u} [Field F₁] [Field F₂]
    [ValuativeRel F₁] [TopologicalSpace F₁] [IsNonarchimedeanLocalField F₁]
    [ValuativeRel F₂] [TopologicalSpace F₂] [IsNonarchimedeanLocalField F₂]
    (τ : F₁ ≃+* F₂)
    (hS : ∀ x : F₁, ValuativeRel.valuation F₂ (τ x) ≤ 1 ↔ ValuativeRel.valuation F₁ x ≤ 1) :
    EllipticRootNumber.q F₂ = EllipticRootNumber.q F₁ ∧
    EllipticRootNumber.p F₂ = EllipticRootNumber.p F₁ ∧
    (∀ x : F₁, EllipticRootNumber.addVal F₂ (τ x) = EllipticRootNumber.addVal F₁ x) ∧
    Nonempty (EllipticRootNumber.Ω F₁ ≃+* EllipticRootNumber.Ω F₂) :=
by
  classical
  
  have hS' : ∀ y : F₂, ValuativeRel.valuation F₁ (τ.symm y) ≤ 1 ↔
      ValuativeRel.valuation F₂ y ≤ 1 := by
    intro y
    rw [← hS (τ.symm y), RingEquiv.apply_symm_apply]
  let τO : (ValuativeRel.valuation F₁).integer ≃+* (ValuativeRel.valuation F₂).integer :=
    { toFun := fun x => ⟨τ x, (Valuation.mem_integer_iff _ _).mpr
        ((hS x).mpr ((Valuation.mem_integer_iff _ _).mp x.2))⟩
      invFun := fun y => ⟨τ.symm y, (Valuation.mem_integer_iff _ _).mpr
        ((hS' y).mpr ((Valuation.mem_integer_iff _ _).mp y.2))⟩
      left_inv := fun x => Subtype.ext (τ.symm_apply_apply x)
      right_inv := fun y => Subtype.ext (τ.apply_symm_apply y)
      map_mul' := fun x y => Subtype.ext (map_mul τ x.1 y.1)
      map_add' := fun x y => Subtype.ext (map_add τ x.1 y.1) }
  let e := IsLocalRing.ResidueField.mapEquiv τO
  have hq : EllipticRootNumber.q F₂ = EllipticRootNumber.q F₁ := by
    unfold EllipticRootNumber.q
    exact (Nat.card_congr e.toEquiv).symm
  have hp : EllipticRootNumber.p F₂ = EllipticRootNumber.p F₁ := by
    unfold EllipticRootNumber.p
    haveI := ringChar.charP (IsLocalRing.ResidueField (ValuativeRel.valuation F₁).integer)
    haveI : CharP (IsLocalRing.ResidueField (ValuativeRel.valuation F₂).integer)
        (ringChar (IsLocalRing.ResidueField (ValuativeRel.valuation F₁).integer)) :=
      charP_of_injective_ringHom (f := e.toRingHom) e.injective _
    exact ringChar.eq _ _
  
  have hell : EllipticRootNumber.ell F₁ = EllipticRootNumber.ell F₂ := by
    have hgen : ∀ a b : ℕ, a = b → (Nat.exists_infinite_primes (a + 1)).choose =
        (Nat.exists_infinite_primes (b + 1)).choose := by
      intro a b h
      subst h
      rfl
    exact hgen _ _ hp.symm
  have gen : ∀ (a b : ℕ) [Fact a.Prime] [Fact b.Prime], a = b →
      Nonempty (AlgebraicClosure ℚ_[a] ≃+* AlgebraicClosure ℚ_[b]) := by
    intro a b ha hb h
    subst h
    exact ⟨RingEquiv.refl _⟩
  
  have key : ∀ (z : WithZero (Multiplicative ℤ)) (hz : z ≠ 0),
      Multiplicative.toAdd (WithZero.unzero hz) = WithZero.log z := by
    intro z hz
    obtain ⟨u, rfl⟩ := WithZero.ne_zero_iff_exists.mp hz
    rw [WithZero.unzero_coe]
    show _ = WithZero.log (WithZero.exp (Multiplicative.toAdd u))
    rw [WithZero.log_exp]
  have hne : ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F] (c : F), c ≠ 0 →
      IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (ValuativeRel.valuation F c) ≠ 0 :=
    fun F _ _ _ _ c hc => (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hc)
  have P0 : ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F] (a : F), a ≠ 0 → EllipticRootNumber.addVal F a =
      -WithZero.log (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
        (ValuativeRel.valuation F a)) := by
    intro F _ _ _ _ a ha
    unfold EllipticRootNumber.addVal
    rw [dif_neg ha, key]
  have P1 : ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F] (a b : F), a ≠ 0 → b ≠ 0 →
      EllipticRootNumber.addVal F (a * b) =
        EllipticRootNumber.addVal F a + EllipticRootNumber.addVal F b := by
    intro F _ _ _ _ a b ha hb
    rw [P0 F _ (mul_ne_zero ha hb), P0 F _ ha, P0 F _ hb, map_mul, map_mul,
      WithZero.log_mul (hne F a ha) (hne F b hb), neg_add]
  have P1' : ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F] (a : F) (n : ℤ), a ≠ 0 →
      EllipticRootNumber.addVal F (a ^ n) = n * EllipticRootNumber.addVal F a := by
    intro F _ _ _ _ a n ha
    rw [P0 F _ (zpow_ne_zero n ha), P0 F _ ha, map_zpow₀, map_zpow₀, WithZero.log_zpow]
    ring
  have P2 : ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F] (a : F), a ≠ 0 →
      (ValuativeRel.valuation F a ≤ 1 ↔ 0 ≤ EllipticRootNumber.addVal F a) := by
    intro F _ _ _ _ a ha
    rw [P0 F a ha, neg_nonneg]
    have h1 : ValuativeRel.valuation F a ≤ 1 ↔
        IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (ValuativeRel.valuation F a) ≤ 1 := by
      rw [← map_one (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F), map_le_map_iff]
    rw [h1]
    have hz := hne F a ha
    generalize IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
      (ValuativeRel.valuation F a) = z at hz ⊢
    conv_lhs => rw [← WithZero.exp_log hz, ← WithZero.exp_zero, WithZero.exp_le_exp]
  have P3 : ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F], ∃ a : F, a ≠ 0 ∧ EllipticRootNumber.addVal F a = 1 := by
    intro F _ _ _ _
    obtain ⟨γ, hγ⟩ := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).surjective
      (WithZero.exp (-1 : ℤ))
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective γ
    have ha0 : a ≠ 0 := by
      intro h
      apply WithZero.exp_ne_zero (a := (-1 : ℤ))
      rw [← hγ, ← ha, h, map_zero, map_zero]
    refine ⟨a, ha0, ?_⟩
    have hγ' : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F γ =
        WithZero.exp (-1 : ℤ) := hγ
    rw [P0 F a ha0, ha, hγ', WithZero.log_exp, neg_neg]
  have P4 : ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F], EllipticRootNumber.addVal F 0 = 0 := by
    intro F _ _ _ _
    unfold EllipticRootNumber.addVal
    rw [dif_pos rfl]
  have P5 : ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F], EllipticRootNumber.addVal F 1 = 0 := by
    intro F _ _ _ _
    have h := P1' F (1 : F) 0 one_ne_zero
    rw [zpow_zero, zero_mul] at h
    exact h
  
  have hτ0 : ∀ x : F₁, x ≠ 0 → τ x ≠ 0 := fun x hx => (map_ne_zero τ).mpr hx
  have H : ∀ x : F₁, x ≠ 0 →
      (0 ≤ EllipticRootNumber.addVal F₂ (τ x) ↔ 0 ≤ EllipticRootNumber.addVal F₁ x) := by
    intro x hx
    rw [← P2 F₂ _ (hτ0 x hx), ← P2 F₁ _ hx]
    exact hS x
  have hval : ∀ x : F₁, EllipticRootNumber.addVal F₂ (τ x) = EllipticRootNumber.addVal F₁ x := by
    obtain ⟨π, hπ0, hπ1⟩ := P3 F₁
    obtain ⟨m, hm⟩ : ∃ m, EllipticRootNumber.addVal F₂ (τ π) = m := ⟨_, rfl⟩
    have hm0 : 0 ≤ m := by
      rw [← hm]
      exact (H π hπ0).mpr (by rw [hπ1]; norm_num)
    have hmul : ∀ x : F₁, x ≠ 0 →
        EllipticRootNumber.addVal F₂ (τ x) = EllipticRootNumber.addVal F₁ x * m := by
      intro x hx
      obtain ⟨n, hn⟩ : ∃ n, EllipticRootNumber.addVal F₁ x = n := ⟨_, rfl⟩
      have hpn : π ^ (-n) ≠ 0 := zpow_ne_zero _ hπ0
      obtain ⟨w, hw⟩ : ∃ w, w = x * π ^ (-n) := ⟨_, rfl⟩
      have hw0 : w ≠ 0 := by rw [hw]; exact mul_ne_zero hx hpn
      have hwi0 : w⁻¹ ≠ 0 := inv_ne_zero hw0
      have hvw : EllipticRootNumber.addVal F₁ w = 0 := by
        rw [hw, P1 F₁ _ _ hx hpn, P1' F₁ _ _ hπ0, hπ1, hn]
        ring
      have hvwi : EllipticRootNumber.addVal F₁ w⁻¹ = 0 := by
        have h := P1 F₁ w w⁻¹ hw0 hwi0
        rw [mul_inv_cancel₀ hw0, hvw, P5 F₁] at h
        linarith
      have hfw : EllipticRootNumber.addVal F₂ (τ w) = 0 := by
        have a1 := (H w hw0).mpr (le_of_eq hvw.symm)
        have a2 := (H w⁻¹ hwi0).mpr (le_of_eq hvwi.symm)
        have h := P1 F₂ (τ w) (τ w⁻¹) (hτ0 w hw0) (hτ0 _ hwi0)
        rw [← map_mul, mul_inv_cancel₀ hw0, map_one, P5 F₂] at h
        linarith
      have hx' : x = w * π ^ n := by
        rw [hw, mul_assoc, ← zpow_add₀ hπ0, neg_add_cancel, zpow_zero, mul_one]
      have hτx : τ x = τ w * τ π ^ n := by
        rw [← map_zpow₀, ← map_mul, ← hx']
      rw [hτx, P1 F₂ _ _ (hτ0 w hw0) (zpow_ne_zero _ (hτ0 π hπ0)),
        P1' F₂ _ _ (hτ0 π hπ0), hfw, hm, hn]
      ring
    obtain ⟨y, hy0, hy1⟩ := P3 F₂
    have hy0' : τ.symm y ≠ 0 := (map_ne_zero τ.symm).mpr hy0
    have hy' := hmul (τ.symm y) hy0'
    rw [RingEquiv.apply_symm_apply, hy1] at hy'
    have hm1 : m = 1 := Int.eq_one_of_mul_eq_one_left hm0 hy'.symm
    intro x
    by_cases hx : x = 0
    · rw [hx, map_zero, P4 F₁, P4 F₂]
    · rw [hmul x hx, hm1, mul_one]
  exact ⟨hq, hp, hval, gen _ _ hell⟩

theorem weilDegreeHom_spec_of_localField (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] :
    (∀ σ ∈ EllipticRootNumber.weilGroup F, ∃ n : ℤ, EllipticRootNumber.ActsAsFrobPow F σ n) ∧
    (∀ (σ : EllipticRootNumber.weilGroup F) (n : ℤ), EllipticRootNumber.ActsAsFrobPow F σ n →
      EllipticRootNumber.weilDegreeHom F σ = Multiplicative.ofAdd n) :=
by
  classical
  
  have hfin : ∀ (k : Type u) [Field k] [Finite k],
      (ringChar k).Prime ∧ ∃ f : ℕ, 0 < f ∧ Nat.card k = ringChar k ^ f := by
    intro k _ _
    letI := Fintype.ofFinite k
    haveI := ringChar.charP k
    obtain ⟨n, hpk, hn⟩ := FiniteField.card k (ringChar k)
    exact ⟨hpk, n, n.pos, by rw [Nat.card_eq_fintype_card, hn]⟩
  have hp : (EllipticRootNumber.p F).Prime := by
    unfold EllipticRootNumber.p
    exact (hfin _).1
  obtain ⟨f, hfpos, hqf⟩ : ∃ f : ℕ, 0 < f ∧
      EllipticRootNumber.q F = EllipticRootNumber.p F ^ f := by
    unfold EllipticRootNumber.q EllipticRootNumber.p
    exact (hfin _).2
  have hq : 2 ≤ EllipticRootNumber.q F := by
    rw [hqf]
    exact le_trans hp.two_le (Nat.le_self_pow hfpos.ne' _)
  
  have hcancel : ∀ (x y : AlgebraicClosure F) (N k : ℕ), 0 < N → ¬ EllipticRootNumber.p F ∣ N →
      x ^ N = 1 → y ^ N = 1 →
      x ^ (EllipticRootNumber.q F ^ k) = y ^ (EllipticRootNumber.q F ^ k) → x = y := by
    intro x y N k hN hpN hx hy h
    have hcop : Nat.Coprime (EllipticRootNumber.q F ^ k) N := by
      rw [hqf, ← pow_mul]
      exact Nat.Coprime.pow_left _ ((Nat.Prime.coprime_iff_not_dvd hp).mpr hpN)
    have hy0 : y ≠ 0 := by
      rintro rfl
      rw [zero_pow hN.ne'] at hy
      exact zero_ne_one hy
    have hzL : (x / y) ^ N = 1 := by rw [div_pow, hx, hy, div_one]
    have hzQ : (x / y) ^ (EllipticRootNumber.q F ^ k) = 1 := by
      rw [div_pow, h, div_self (pow_ne_zero _ hy0)]
    have h1 : (x / y) ^ (Nat.gcd (EllipticRootNumber.q F ^ k) N) = 1 :=
      pow_gcd_eq_one.mpr ⟨hzQ, hzL⟩
    rw [Nat.Coprime.gcd_eq_one hcop, pow_one] at h1
    exact (div_eq_one_iff_eq hy0).mp h1
  
  have hroots : ∀ B : ℕ, ∃ (ζ : AlgebraicClosure F) (ℓ : ℕ), B < ℓ ∧
      EllipticRootNumber.IsPrimeToPRootOfUnity F ζ ∧ ∀ k : ℕ, ζ ^ k = 1 → ℓ ∣ k := by
    intro B
    obtain ⟨ℓ, hℓge, hℓ⟩ := Nat.exists_infinite_primes
      (B + EllipticRootNumber.p F + ringChar (AlgebraicClosure F) + 1)
    have hℓ0 : (ℓ : AlgebraicClosure F) ≠ 0 := by
      intro h0
      have hc := ringChar.dvd h0
      rcases Nat.Prime.eq_one_or_self_of_dvd hℓ _ hc with h | h
      · exact CharP.ringChar_ne_one h
      · omega
    haveI : NeZero (ℓ : AlgebraicClosure F) := ⟨hℓ0⟩
    have hdeg : (Polynomial.cyclotomic ℓ (AlgebraicClosure F)).degree ≠ 0 :=
      (Polynomial.degree_cyclotomic_pos ℓ (AlgebraicClosure F) hℓ.pos).ne'
    obtain ⟨ζ, hζroot⟩ := IsAlgClosed.exists_root _ hdeg
    have hζ : IsPrimitiveRoot ζ ℓ := (Polynomial.isRoot_cyclotomic_iff).mp hζroot
    refine ⟨ζ, ℓ, by omega, ⟨ℓ, hℓ.pos, ?_, hζ.pow_eq_one⟩,
      fun k hk => hζ.dvd_of_pow_eq_one k hk⟩
    intro hdvd
    rcases Nat.Prime.eq_one_or_self_of_dvd hℓ _ hdvd with h | h
    · exact absurd h hp.one_lt.ne'
    · omega
  
  have huniq : ∀ (σ : EllipticRootNumber.AbsGal F) (n m : ℤ),
      EllipticRootNumber.ActsAsFrobPow F σ n → EllipticRootNumber.ActsAsFrobPow F σ m →
      n = m := by
    intro σ n m hn hm
    have key : ∀ ζ, EllipticRootNumber.IsPrimeToPRootOfUnity F ζ →
        ζ ^ (EllipticRootNumber.q F ^ (n.toNat + (-m).toNat)) =
          ζ ^ (EllipticRootNumber.q F ^ ((-n).toNat + m.toNat)) := by
      intro ζ hζ
      have h1 := hn ζ hζ
      have h2 := hm ζ hζ
      calc ζ ^ (EllipticRootNumber.q F ^ (n.toNat + (-m).toNat))
          = (ζ ^ EllipticRootNumber.q F ^ n.toNat) ^ (EllipticRootNumber.q F ^ (-m).toNat) := by
            rw [pow_add, pow_mul]
        _ = (σ ζ ^ EllipticRootNumber.q F ^ (-n).toNat) ^ (EllipticRootNumber.q F ^ (-m).toNat) := by
            rw [h1]
        _ = (σ ζ ^ EllipticRootNumber.q F ^ (-m).toNat) ^ (EllipticRootNumber.q F ^ (-n).toNat) := by
            rw [← pow_mul, ← pow_mul, Nat.mul_comm]
        _ = (ζ ^ EllipticRootNumber.q F ^ m.toNat) ^ (EllipticRootNumber.q F ^ (-n).toNat) := by
            rw [h2]
        _ = ζ ^ (EllipticRootNumber.q F ^ ((-n).toNat + m.toNat)) := by
            rw [← pow_mul, ← pow_add, Nat.add_comm m.toNat (-n).toNat]
    have hstep : ∀ S T : ℕ, S < T → (∀ ζ, EllipticRootNumber.IsPrimeToPRootOfUnity F ζ →
        ζ ^ (EllipticRootNumber.q F ^ T) = ζ ^ (EllipticRootNumber.q F ^ S)) → False := by
      intro S T hST hall
      obtain ⟨ζ, ℓ, hℓ, hζ, hdvd⟩ := hroots (EllipticRootNumber.q F ^ T)
      have heq := hall ζ hζ
      obtain ⟨N, hN, -, hζN⟩ := hζ
      have hζ0 : ζ ≠ 0 := by
        rintro rfl
        rw [zero_pow hN.ne'] at hζN
        exact zero_ne_one hζN
      have hlt : EllipticRootNumber.q F ^ S < EllipticRootNumber.q F ^ T :=
        Nat.pow_lt_pow_right hq hST
      have hD : ζ ^ (EllipticRootNumber.q F ^ T - EllipticRootNumber.q F ^ S) = 1 := by
        have e : ζ ^ (EllipticRootNumber.q F ^ T) = ζ ^ (EllipticRootNumber.q F ^ S) *
            ζ ^ (EllipticRootNumber.q F ^ T - EllipticRootNumber.q F ^ S) := by
          rw [← pow_add, Nat.add_sub_cancel' hlt.le]
        rw [e] at heq
        exact mul_left_cancel₀ (pow_ne_zero _ hζ0) (heq.trans (mul_one _).symm)
      have := Nat.le_of_dvd (Nat.sub_pos_of_lt hlt) (hdvd _ hD)
      omega
    by_contra hne
    have h1 := Int.toNat_sub_toNat_neg n
    have h2 := Int.toNat_sub_toNat_neg m
    rcases Nat.lt_or_gt_of_ne (show n.toNat + (-m).toNat ≠ (-n).toNat + m.toNat by omega)
      with h | h
    · exact hstep _ _ h (fun ζ hζ => (key ζ hζ).symm)
    · exact hstep _ _ h key
  
  have hmul : ∀ (σ τ : EllipticRootNumber.AbsGal F) (n m : ℤ),
      EllipticRootNumber.ActsAsFrobPow F σ n → EllipticRootNumber.ActsAsFrobPow F τ m →
      EllipticRootNumber.ActsAsFrobPow F (σ * τ) (n + m) := by
    intro σ τ n m hn hm ζ hζ
    have h1 := Int.toNat_sub_toNat_neg n
    have h2 := Int.toNat_sub_toNat_neg m
    have h3 := Int.toNat_sub_toNat_neg (n + m)
    have h0 : (-(n + m)).toNat = 0 ∨ (n + m).toNat = 0 := by
      rcases le_total (n + m) 0 with h | h
      · exact Or.inr (Int.toNat_eq_zero.mpr h)
      · exact Or.inl (Int.toNat_eq_zero.mpr (by omega))
    obtain ⟨k, hA, hB⟩ : ∃ k, (-n).toNat + (-m).toNat = (-(n + m)).toNat + k ∧
        n.toNat + m.toNat = (n + m).toNat + k :=
      ⟨min ((-n).toNat + (-m).toNat) (n.toNat + m.toNat), by omega, by omega⟩
    have hζ' := hζ
    obtain ⟨N, hN, hpN, hζN⟩ := hζ
    have comp : ((σ * τ) ζ) ^ (EllipticRootNumber.q F ^ ((-n).toNat + (-m).toNat)) =
        ζ ^ (EllipticRootNumber.q F ^ (n.toNat + m.toNat)) := by
      rw [AlgEquiv.mul_apply]
      calc (σ (τ ζ)) ^ (EllipticRootNumber.q F ^ ((-n).toNat + (-m).toNat))
          = ((σ (τ ζ)) ^ (EllipticRootNumber.q F ^ (-m).toNat)) ^
              (EllipticRootNumber.q F ^ (-n).toNat) := by
            rw [← pow_mul, ← pow_add, Nat.add_comm]
        _ = (σ ((τ ζ) ^ (EllipticRootNumber.q F ^ (-m).toNat))) ^
              (EllipticRootNumber.q F ^ (-n).toNat) := by rw [map_pow]
        _ = (σ (ζ ^ (EllipticRootNumber.q F ^ m.toNat))) ^
              (EllipticRootNumber.q F ^ (-n).toNat) := by rw [hm ζ hζ']
        _ = ((σ ζ) ^ (EllipticRootNumber.q F ^ (-n).toNat)) ^
              (EllipticRootNumber.q F ^ m.toNat) := by
            rw [map_pow, ← pow_mul, ← pow_mul, Nat.mul_comm]
        _ = (ζ ^ (EllipticRootNumber.q F ^ n.toNat)) ^ (EllipticRootNumber.q F ^ m.toNat) := by
            rw [hn ζ hζ']
        _ = ζ ^ (EllipticRootNumber.q F ^ (n.toNat + m.toNat)) := by
            rw [← pow_mul, ← pow_add]
    have hxy : (((σ * τ) ζ) ^ (EllipticRootNumber.q F ^ (-(n + m)).toNat)) ^
          (EllipticRootNumber.q F ^ k) =
        (ζ ^ (EllipticRootNumber.q F ^ (n + m).toNat)) ^ (EllipticRootNumber.q F ^ k) := by
      rw [← pow_mul, ← pow_mul, ← pow_add, ← pow_add, ← hA, ← hB]
      exact comp
    have hxN : (((σ * τ) ζ) ^ (EllipticRootNumber.q F ^ (-(n + m)).toNat)) ^ N = 1 := by
      rw [← pow_mul, Nat.mul_comm, pow_mul, ← map_pow, hζN, map_one, one_pow]
    have hyN : (ζ ^ (EllipticRootNumber.q F ^ (n + m).toNat)) ^ N = 1 := by
      rw [← pow_mul, Nat.mul_comm, pow_mul, hζN, one_pow]
    exact hcancel _ _ N k hN hpN hxN hyN hxy
  
  have hone : EllipticRootNumber.ActsAsFrobPow F 1 0 := by
    intro ζ _
    simp
  have hinv : ∀ (σ : EllipticRootNumber.AbsGal F) (n : ℤ),
      EllipticRootNumber.ActsAsFrobPow F σ n → EllipticRootNumber.ActsAsFrobPow F σ⁻¹ (-n) := by
    intro σ n hn ζ hζ
    obtain ⟨N, hN, hpN, hζN⟩ := hζ
    have hζ' : EllipticRootNumber.IsPrimeToPRootOfUnity F (σ⁻¹ ζ) :=
      ⟨N, hN, hpN, by rw [← map_pow, hζN, map_one]⟩
    have h := hn _ hζ'
    have hs : σ (σ⁻¹ ζ) = ζ := by
      rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
    rw [hs] at h
    rw [neg_neg]
    exact h.symm
  
  have part1 : ∀ σ ∈ EllipticRootNumber.weilGroup F,
      ∃ n : ℤ, EllipticRootNumber.ActsAsFrobPow F σ n := by
    intro σ hσ
    unfold EllipticRootNumber.weilGroup at hσ
    induction hσ using Subgroup.closure_induction with
    | mem x hx => exact hx
    | one => exact ⟨0, hone⟩
    | mul x y _ _ hx hy =>
      obtain ⟨n, hn⟩ := hx
      obtain ⟨m, hm⟩ := hy
      exact ⟨n + m, hmul x y n m hn hm⟩
    | inv x _ hx =>
      obtain ⟨n, hn⟩ := hx
      exact ⟨-n, hinv x n hn⟩
  
  have hdeg : ∀ (σ : EllipticRootNumber.AbsGal F) (n : ℤ),
      EllipticRootNumber.ActsAsFrobPow F σ n → EllipticRootNumber.weilDegree F σ = n := by
    intro σ n h
    have hex : ∃ n : ℤ, EllipticRootNumber.ActsAsFrobPow F σ n := ⟨n, h⟩
    unfold EllipticRootNumber.weilDegree
    rw [dif_pos hex]
    exact huniq σ _ n hex.choose_spec h
  
  let f : EllipticRootNumber.weilGroup F →* Multiplicative ℤ :=
    MonoidHom.mk' (fun σ => Multiplicative.ofAdd (EllipticRootNumber.weilDegree F σ)) (by
      intro σ τ
      obtain ⟨n, hn⟩ := part1 σ σ.2
      obtain ⟨m, hm⟩ := part1 τ τ.2
      have hστ := hmul σ τ n m hn hm
      beta_reduce
      rw [Subgroup.coe_mul, hdeg _ _ hστ, hdeg _ _ hn, hdeg _ _ hm, ofAdd_add])
  have hf : ∀ (σ : EllipticRootNumber.weilGroup F) (n : ℤ),
      EllipticRootNumber.ActsAsFrobPow F σ n → f σ = Multiplicative.ofAdd n := by
    intro σ n h
    show Multiplicative.ofAdd (EllipticRootNumber.weilDegree F σ) = _
    rw [hdeg _ _ h]
  refine ⟨part1, ?_⟩
  unfold EllipticRootNumber.weilDegreeHom
  exact Classical.epsilon_spec
    (p := fun g : EllipticRootNumber.weilGroup F →* Multiplicative ℤ =>
      ∀ (σ : EllipticRootNumber.weilGroup F) (n : ℤ), EllipticRootNumber.ActsAsFrobPow F σ n →
        g σ = Multiplicative.ofAdd n) ⟨f, hf⟩

theorem galConj_naturality {F₁ F₂ : Type u} [Field F₁] [Field F₂]
    [ValuativeRel F₁] [TopologicalSpace F₁] [IsNonarchimedeanLocalField F₁]
    [ValuativeRel F₂] [TopologicalSpace F₂] [IsNonarchimedeanLocalField F₂]
    (τb : AlgebraicClosure F₁ ≃+* AlgebraicClosure F₂)
    (κ : EllipticRootNumber.AbsGal F₁ ≃* EllipticRootNumber.AbsGal F₂)
    (hκ : ∀ σ x, κ σ (τb x) = τb (σ x))
    (hp : EllipticRootNumber.p F₂ = EllipticRootNumber.p F₁)
    (hq : EllipticRootNumber.q F₂ = EllipticRootNumber.q F₁) :
    (∀ σ, κ σ ∈ EllipticRootNumber.inertia F₂ ↔ σ ∈ EllipticRootNumber.inertia F₁) ∧
    (∀ σ (n : ℤ), EllipticRootNumber.ActsAsFrobPow F₂ (κ σ) n ↔
       EllipticRootNumber.ActsAsFrobPow F₁ σ n) ∧
    (∀ σ, κ σ ∈ EllipticRootNumber.weilGroup F₂ ↔ σ ∈ EllipticRootNumber.weilGroup F₁) ∧
    (∀ (L₁ : IntermediateField F₁ (AlgebraicClosure F₁))
       (L₂ : IntermediateField F₂ (AlgebraicClosure F₂)),
       (∀ y, y ∈ L₂ ↔ τb.symm y ∈ L₁) → ∀ σ, κ σ ∈ L₂.fixingSubgroup ↔ σ ∈ L₁.fixingSubgroup) :=
by
  
  have hR : ∀ ζ : AlgebraicClosure F₁, EllipticRootNumber.IsPrimeToPRootOfUnity F₂ (τb ζ) ↔
      EllipticRootNumber.IsPrimeToPRootOfUnity F₁ ζ := by
    intro ζ
    unfold EllipticRootNumber.IsPrimeToPRootOfUnity
    rw [hp]
    refine exists_congr (fun n => and_congr Iff.rfl (and_congr Iff.rfl ?_))
    rw [← map_pow]
    constructor
    · intro h
      apply τb.injective
      rw [h, map_one]
    · intro h
      rw [h, map_one]
  have hR' : ∀ η : AlgebraicClosure F₂, EllipticRootNumber.IsPrimeToPRootOfUnity F₂ η ↔
      EllipticRootNumber.IsPrimeToPRootOfUnity F₁ (τb.symm η) := by
    intro η
    rw [← hR, RingEquiv.apply_symm_apply]
  
  have hA : ∀ {F : Type u} [Field F] (S : Set (AlgebraicClosure F))
      (σ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F),
      σ ∈ (IntermediateField.adjoin F S).fixingSubgroup ↔ ∀ x ∈ S, σ x = x := by
    intro F _ S σ
    rw [IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro h x hx
      exact h x (IntermediateField.subset_adjoin F S hx)
    · intro h x hx
      induction hx using IntermediateField.adjoin_induction with
      | mem x hx => exact h x hx
      | algebraMap r => exact σ.commutes r
      | add x y _ _ hx hy => rw [map_add, hx, hy]
      | inv x _ hx => rw [map_inv₀, hx]
      | mul x y _ _ hx hy => rw [map_mul, hx, hy]
  
  have c2 : ∀ σ (n : ℤ), EllipticRootNumber.ActsAsFrobPow F₂ (κ σ) n ↔
      EllipticRootNumber.ActsAsFrobPow F₁ σ n := by
    intro σ n
    unfold EllipticRootNumber.ActsAsFrobPow
    rw [hq]
    constructor
    · intro H ζ hζ
      have h := H (τb ζ) ((hR ζ).mpr hζ)
      rw [hκ, ← map_pow τb (σ ζ), ← map_pow τb ζ] at h
      exact τb.injective h
    · intro H η hη
      have hζ := (hR' η).mp hη
      rw [← RingEquiv.apply_symm_apply τb η, hκ, ← map_pow τb (σ (τb.symm η)),
        ← map_pow τb (τb.symm η), H _ hζ]
  refine ⟨?_, c2, ?_, ?_⟩
  · intro σ
    unfold EllipticRootNumber.inertia EllipticRootNumber.unramifiedClosure
    rw [hA, hA]
    constructor
    · intro H ζ hζ
      have h := H (τb ζ) ((hR ζ).mpr hζ)
      rw [hκ] at h
      exact τb.injective h
    · intro H η hη
      have hζ := (hR' η).mp hη
      rw [← RingEquiv.apply_symm_apply τb η, hκ, H _ hζ]
  · intro σ
    unfold EllipticRootNumber.weilGroup
    have hST : ∀ g, κ g ∈ {σ | ∃ n : ℤ, EllipticRootNumber.ActsAsFrobPow F₂ σ n} ↔
        g ∈ {σ | ∃ n : ℤ, EllipticRootNumber.ActsAsFrobPow F₁ σ n} := by
      intro g
      simp only [Set.mem_setOf_eq]
      exact exists_congr (fun n => c2 g n)
    constructor
    · intro h
      have hle : Subgroup.closure {σ | ∃ n : ℤ, EllipticRootNumber.ActsAsFrobPow F₂ σ n} ≤
          Subgroup.comap κ.symm.toMonoidHom
            (Subgroup.closure {σ | ∃ n : ℤ, EllipticRootNumber.ActsAsFrobPow F₁ σ n}) := by
        rw [Subgroup.closure_le]
        intro t ht
        rw [SetLike.mem_coe, Subgroup.mem_comap]
        apply Subgroup.subset_closure
        rw [← hST]
        simpa using ht
      have := hle h
      rw [Subgroup.mem_comap] at this
      simpa using this
    · intro h
      have hle : Subgroup.closure {σ | ∃ n : ℤ, EllipticRootNumber.ActsAsFrobPow F₁ σ n} ≤
          Subgroup.comap κ.toMonoidHom
            (Subgroup.closure {σ | ∃ n : ℤ, EllipticRootNumber.ActsAsFrobPow F₂ σ n}) := by
        rw [Subgroup.closure_le]
        intro s hs
        rw [SetLike.mem_coe, Subgroup.mem_comap]
        apply Subgroup.subset_closure
        exact (hST s).mpr hs
      have := hle h
      rw [Subgroup.mem_comap] at this
      simpa using this
  · intro L₁ L₂ hC σ
    rw [IntermediateField.mem_fixingSubgroup_iff, IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro H x hx
      have hx' : τb x ∈ L₂ := (hC (τb x)).mpr (by rw [RingEquiv.symm_apply_apply]; exact hx)
      have h := H (τb x) hx'
      rw [hκ] at h
      exact τb.injective h
    · intro H y hy
      have hx := (hC y).mp hy
      rw [← RingEquiv.apply_symm_apply τb y, hκ, H _ hx]

theorem intermediateField_transport {F₁ F₂ : Type u} [Field F₁] [Field F₂]
    [ValuativeRel F₁] [TopologicalSpace F₁] [IsNonarchimedeanLocalField F₁]
    [ValuativeRel F₂] [TopologicalSpace F₂] [IsNonarchimedeanLocalField F₂]
    (τ : F₁ ≃+* F₂)
    (hv : ∀ x : F₁, EllipticRootNumber.addVal F₂ (τ x) = EllipticRootNumber.addVal F₁ x)
    (τb : AlgebraicClosure F₁ ≃+* AlgebraicClosure F₂)
    (hτb : ∀ x : F₁, τb (algebraMap F₁ (AlgebraicClosure F₁) x) =
        algebraMap F₂ (AlgebraicClosure F₂) (τ x)) :
    (∀ L₁ : IntermediateField F₁ (AlgebraicClosure F₁),
       ∃ L₂ : IntermediateField F₂ (AlgebraicClosure F₂), ∀ y, y ∈ L₂ ↔ τb.symm y ∈ L₁) ∧
    ∀ (L₁ : IntermediateField F₁ (AlgebraicClosure F₁))
      (L₂ : IntermediateField F₂ (AlgebraicClosure F₂)), (∀ y, y ∈ L₂ ↔ τb.symm y ∈ L₁) →
      (FiniteDimensional F₁ L₁ ↔ FiniteDimensional F₂ L₂) ∧
      Module.finrank F₂ L₂ = Module.finrank F₁ L₁ ∧
      EllipticRootNumber.resDeg F₂ L₂ = EllipticRootNumber.resDeg F₁ L₁ ∧
      ∀ (x₁ : L₁) (x₂ : L₂), (x₂ : AlgebraicClosure F₂) = τb (x₁ : AlgebraicClosure F₁) →
        Algebra.norm F₂ x₂ = τ (Algebra.norm F₁ x₁) ∧
        EllipticRootNumber.relVal F₂ L₂ x₂ = EllipticRootNumber.relVal F₁ L₁ x₁ ∧
        EllipticRootNumber.valL F₂ L₂ x₂ = EllipticRootNumber.valL F₁ L₁ x₁ :=
by
  classical
  have hτbs : ∀ y : F₂, τb.symm (algebraMap F₂ (AlgebraicClosure F₂) y) =
      algebraMap F₁ (AlgebraicClosure F₁) (τ.symm y) := by
    intro y
    apply τb.injective
    rw [RingEquiv.apply_symm_apply, hτb, RingEquiv.apply_symm_apply]
  refine ⟨fun L₁ => ?_, fun L₁ L₂ hC => ?_⟩
  · refine ⟨(Subfield.comap (τb.symm : AlgebraicClosure F₂ →+* AlgebraicClosure F₁)
        L₁.toSubfield).toIntermediateField (fun b => ?_), fun y => Iff.rfl⟩
    show τb.symm (algebraMap F₂ (AlgebraicClosure F₂) b) ∈ L₁
    rw [hτbs]
    exact L₁.algebraMap_mem _
  · let e : L₁ ≃+* L₂ :=
      { toFun := fun x => ⟨τb x, (hC _).mpr (by rw [RingEquiv.symm_apply_apply]; exact x.2)⟩
        invFun := fun y => ⟨τb.symm y, (hC y).mp y.2⟩
        left_inv := fun x => Subtype.ext (τb.symm_apply_apply _)
        right_inv := fun y => Subtype.ext (τb.apply_symm_apply _)
        map_mul' := fun x y => Subtype.ext (map_mul τb _ _)
        map_add' := fun x y => Subtype.ext (map_add τb _ _) }
    have he : ∀ x : L₁, ((e x : L₂) : AlgebraicClosure F₂) = τb (x : AlgebraicClosure F₁) :=
      fun _ => rfl
    have hes : ∀ y : L₂, ((e.symm y : L₁) : AlgebraicClosure F₁) =
        τb.symm (y : AlgebraicClosure F₂) := fun _ => rfl
    have hcomp : (algebraMap F₂ L₂).comp (τ : F₁ →+* F₂) =
        (e : L₁ →+* L₂).comp (algebraMap F₁ L₁) := by
      refine RingHom.ext fun a => Subtype.ext ?_
      show algebraMap F₂ (AlgebraicClosure F₂) (τ a) = τb (algebraMap F₁ (AlgebraicClosure F₁) a)
      exact (hτb a).symm
    have hcomp' : (algebraMap F₁ L₁).comp (τ.symm : F₂ →+* F₁) =
        (e.symm : L₂ →+* L₁).comp (algebraMap F₂ L₂) := by
      refine RingHom.ext fun b => Subtype.ext ?_
      show algebraMap F₁ (AlgebraicClosure F₁) (τ.symm b) =
        τb.symm (algebraMap F₂ (AlgebraicClosure F₂) b)
      exact (hτbs b).symm
    have hsmul : ∀ (r : F₁) (m : L₁), e (r • m) = τ r • e m := by
      intro r m
      rw [Algebra.smul_def, Algebra.smul_def, map_mul]
      congr 1
      exact (RingHom.congr_fun hcomp r).symm
    have hrank : Module.rank F₁ L₁ = Module.rank F₂ L₂ :=
      rank_eq_of_equiv_equiv τ e.toAddEquiv τ.bijective (fun r m => hsmul r m)
    have hn : ∀ (x₁ : L₁) (x₂ : L₂), (x₂ : AlgebraicClosure F₂) = τb (x₁ : AlgebraicClosure F₁) →
        Algebra.norm F₂ x₂ = τ (Algebra.norm F₁ x₁) := by
      intro x₁ x₂ hx
      have hxe : x₂ = e x₁ := Subtype.ext hx
      subst hxe
      rw [Algebra.norm_eq_of_equiv_equiv τ e hcomp x₁, RingEquiv.apply_symm_apply]
    have hrel : ∀ (x₁ : L₁) (x₂ : L₂), (x₂ : AlgebraicClosure F₂) = τb (x₁ : AlgebraicClosure F₁) →
        EllipticRootNumber.relVal F₂ L₂ x₂ = EllipticRootNumber.relVal F₁ L₁ x₁ := by
      intro x₁ x₂ hx
      unfold EllipticRootNumber.relVal
      rw [hn x₁ x₂ hx, hv]
    have hres : EllipticRootNumber.resDeg F₂ L₂ = EllipticRootNumber.resDeg F₁ L₁ := by
      unfold EllipticRootNumber.resDeg
      congr 1
      ext k
      simp only [Set.mem_setOf_eq]
      constructor
      · rintro ⟨hk, x₂, hx0, hxk⟩
        refine ⟨hk, e.symm x₂, (RingEquiv.map_ne_zero_iff e.symm).mpr hx0, ?_⟩
        rw [← hrel (e.symm x₂) x₂ (by rw [hes, RingEquiv.apply_symm_apply])]
        exact hxk
      · rintro ⟨hk, x₁, hx0, hxk⟩
        refine ⟨hk, e x₁, (RingEquiv.map_ne_zero_iff e).mpr hx0, ?_⟩
        rw [hrel x₁ (e x₁) rfl]
        exact hxk
    refine ⟨⟨fun h => ?_, fun h => ?_⟩, ?_, hres, fun x₁ x₂ hx => ⟨hn x₁ x₂ hx, hrel x₁ x₂ hx, ?_⟩⟩
    · haveI : Module.Finite F₁ L₁ := h
      exact Module.Finite.of_equiv_equiv τ e hcomp
    · haveI : Module.Finite F₂ L₂ := h
      exact Module.Finite.of_equiv_equiv τ.symm e.symm hcomp'
    · show Cardinal.toNat (Module.rank F₂ L₂) = Cardinal.toNat (Module.rank F₁ L₁)
      rw [hrank]
    · unfold EllipticRootNumber.valL
      rw [hrel x₁ x₂ hx, hres]

theorem intermediateField_pair_transport {F₁ F₂ : Type u} [Field F₁] [Field F₂]
    [ValuativeRel F₁] [TopologicalSpace F₁] [IsNonarchimedeanLocalField F₁]
    [ValuativeRel F₂] [TopologicalSpace F₂] [IsNonarchimedeanLocalField F₂]
    (τb : AlgebraicClosure F₁ ≃+* AlgebraicClosure F₂)
    (κ : EllipticRootNumber.AbsGal F₁ ≃* EllipticRootNumber.AbsGal F₂)
    (hκ : ∀ σ x, κ σ (τb x) = τb (σ x))
    (L₁ M₁ : IntermediateField F₁ (AlgebraicClosure F₁))
    (L₂ M₂ : IntermediateField F₂ (AlgebraicClosure F₂)) (h₁ : L₁ ≤ M₁) (h₂ : L₂ ≤ M₂)
    (hL : ∀ y, y ∈ L₂ ↔ τb.symm y ∈ L₁) (hM : ∀ y, y ∈ M₂ ↔ τb.symm y ∈ M₁) :
    (∀ (y₁ : M₁) (y₂ : M₂), (y₂ : AlgebraicClosure F₂) = τb (y₁ : AlgebraicClosure F₁) →
       ((EllipticRootNumber.normLM F₂ h₂ y₂ : L₂) : AlgebraicClosure F₂) =
         τb (EllipticRootNumber.normLM F₁ h₁ y₁ : L₁) ∧
       ((EllipticRootNumber.traceLM F₂ h₂ y₂ : L₂) : AlgebraicClosure F₂) =
         τb (EllipticRootNumber.traceLM F₁ h₁ y₁ : L₁)) ∧
    (Algebra.IsSeparable L₂ (IntermediateField.extendScalars h₂) ↔
       Algebra.IsSeparable L₁ (IntermediateField.extendScalars h₁)) ∧
    (EllipticRootNumber.IsAbelianExt F₂ h₂ ↔ EllipticRootNumber.IsAbelianExt F₁ h₁) :=
by
  classical
  have mL : ∀ x : AlgebraicClosure F₁, τb x ∈ L₂ ↔ x ∈ L₁ := fun x => by
    rw [hL, RingEquiv.symm_apply_apply]
  have mM : ∀ x : AlgebraicClosure F₁, τb x ∈ M₂ ↔ x ∈ M₁ := fun x => by
    rw [hM, RingEquiv.symm_apply_apply]
  let eL : L₁ ≃+* L₂ :=
    { toFun := fun x => ⟨τb x, (mL x).mpr x.2⟩
      invFun := fun y => ⟨τb.symm y, (hL y).mp y.2⟩
      left_inv := fun x => Subtype.ext (τb.symm_apply_apply _)
      right_inv := fun y => Subtype.ext (τb.apply_symm_apply _)
      map_mul' := fun x y => Subtype.ext (map_mul τb _ _)
      map_add' := fun x y => Subtype.ext (map_add τb _ _) }
  let eM : IntermediateField.extendScalars h₁ ≃+* IntermediateField.extendScalars h₂ :=
    { toFun := fun z => ⟨τb z, (IntermediateField.mem_extendScalars h₂).mpr
          ((mM z).mpr ((IntermediateField.mem_extendScalars h₁).mp z.2))⟩
      invFun := fun w => ⟨τb.symm w, (IntermediateField.mem_extendScalars h₁).mpr
          ((hM w).mp ((IntermediateField.mem_extendScalars h₂).mp w.2))⟩
      left_inv := fun x => Subtype.ext (τb.symm_apply_apply _)
      right_inv := fun y => Subtype.ext (τb.apply_symm_apply _)
      map_mul' := fun x y => Subtype.ext (map_mul τb _ _)
      map_add' := fun x y => Subtype.ext (map_add τb _ _) }
  have hcomp : (algebraMap L₂ (IntermediateField.extendScalars h₂)).comp (eL : L₁ →+* L₂) =
      (eM : IntermediateField.extendScalars h₁ →+* IntermediateField.extendScalars h₂).comp
        (algebraMap L₁ (IntermediateField.extendScalars h₁)) :=
    RingHom.ext fun x => Subtype.ext rfl
  have hcomp' : (algebraMap L₁ (IntermediateField.extendScalars h₁)).comp (eL.symm : L₂ →+* L₁) =
      (eM.symm : IntermediateField.extendScalars h₂ →+* IntermediateField.extendScalars h₁).comp
        (algebraMap L₂ (IntermediateField.extendScalars h₂)) :=
    RingHom.ext fun x => Subtype.ext rfl
  have hsep : Algebra.IsSeparable L₂ (IntermediateField.extendScalars h₂) ↔
      Algebra.IsSeparable L₁ (IntermediateField.extendScalars h₁) :=
    ⟨fun h => by haveI := h; exact Algebra.IsSeparable.of_equiv_equiv eL.symm eM.symm hcomp',
     fun h => by haveI := h; exact Algebra.IsSeparable.of_equiv_equiv eL eM hcomp⟩
  have hFix : ∀ (A₁ : IntermediateField F₁ (AlgebraicClosure F₁))
      (A₂ : IntermediateField F₂ (AlgebraicClosure F₂)),
      (∀ y, y ∈ A₂ ↔ τb.symm y ∈ A₁) →
        ∀ σ, κ σ ∈ A₂.fixingSubgroup ↔ σ ∈ A₁.fixingSubgroup := by
    intro A₁ A₂ hA σ
    rw [IntermediateField.mem_fixingSubgroup_iff, IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro H x hx
      apply τb.injective
      rw [← hκ]
      exact H _ ((hA _).mpr (by rwa [RingEquiv.symm_apply_apply]))
    · intro H y hy
      have e := H _ ((hA y).mp hy)
      calc κ σ y = κ σ (τb (τb.symm y)) := by rw [RingEquiv.apply_symm_apply]
        _ = τb (σ (τb.symm y)) := hκ _ _
        _ = y := by rw [e, RingEquiv.apply_symm_apply]
  have hab : EllipticRootNumber.IsAbelianExt F₂ h₂ ↔ EllipticRootNumber.IsAbelianExt F₁ h₁ := by
    unfold EllipticRootNumber.IsAbelianExt
    refine and_congr ?_ (and_congr ?_ hsep)
    · constructor
      · intro H σ hσ τ hτ
        rw [← hFix M₁ M₂ hM, map_mul, map_mul, map_inv]
        exact H _ ((hFix L₁ L₂ hL σ).mpr hσ) _ ((hFix M₁ M₂ hM τ).mpr hτ)
      · intro H σ hσ τ hτ
        obtain ⟨σ', rfl⟩ := κ.surjective σ
        obtain ⟨τ', rfl⟩ := κ.surjective τ
        rw [← map_inv, ← map_mul, ← map_mul, hFix M₁ M₂ hM]
        exact H _ ((hFix L₁ L₂ hL σ').mp hσ) _ ((hFix M₁ M₂ hM τ').mp hτ)
    · constructor
      · intro H σ hσ τ hτ
        rw [← hFix M₁ M₂ hM, map_mul, map_mul, map_mul, map_inv, map_inv]
        exact H _ ((hFix L₁ L₂ hL σ).mpr hσ) _ ((hFix L₁ L₂ hL τ).mpr hτ)
      · intro H σ hσ τ hτ
        obtain ⟨σ', rfl⟩ := κ.surjective σ
        obtain ⟨τ', rfl⟩ := κ.surjective τ
        rw [← map_inv, ← map_inv, ← map_mul, ← map_mul, ← map_mul, hFix M₁ M₂ hM]
        exact H _ ((hFix L₁ L₂ hL σ').mp hσ) _ ((hFix L₁ L₂ hL τ').mp hτ)
  refine ⟨fun y₁ y₂ hy => ?_, hsep, hab⟩
  have hz : eM (EllipticRootNumber.toExtendScalars F₁ h₁ y₁) =
      EllipticRootNumber.toExtendScalars F₂ h₂ y₂ := Subtype.ext hy.symm
  have kN := Algebra.norm_eq_of_equiv_equiv eL eM hcomp
    (EllipticRootNumber.toExtendScalars F₁ h₁ y₁)
  have kT := Algebra.trace_eq_of_equiv_equiv eL eM hcomp
    (EllipticRootNumber.toExtendScalars F₁ h₁ y₁)
  rw [hz] at kN kT
  constructor
  · show ((Algebra.norm L₂ (EllipticRootNumber.toExtendScalars F₂ h₂ y₂) : L₂) :
        AlgebraicClosure F₂) =
      τb ((Algebra.norm L₁ (EllipticRootNumber.toExtendScalars F₁ h₁ y₁) : L₁) :
        AlgebraicClosure F₁)
    rw [kN]
    exact congrArg Subtype.val (eL.apply_symm_apply _).symm
  · show ((Algebra.trace L₂ _ (EllipticRootNumber.toExtendScalars F₂ h₂ y₂) : L₂) :
        AlgebraicClosure F₂) =
      τb ((Algebra.trace L₁ _ (EllipticRootNumber.toExtendScalars F₁ h₁ y₁) : L₁) :
        AlgebraicClosure F₁)
    rw [kT]
    exact congrArg Subtype.val (eL.apply_symm_apply _).symm

theorem localReciprocity_transport {F₁ F₂ : Type u} [Field F₁] [Field F₂]
    [ValuativeRel F₁] [TopologicalSpace F₁] [IsNonarchimedeanLocalField F₁]
    [ValuativeRel F₂] [TopologicalSpace F₂] [IsNonarchimedeanLocalField F₂]
    (τ : F₁ ≃+* F₂)
    (hS : ∀ x : F₁, ValuativeRel.valuation F₂ (τ x) ≤ 1 ↔ ValuativeRel.valuation F₁ x ≤ 1)
    (τb : AlgebraicClosure F₁ ≃+* AlgebraicClosure F₂)
    (hτb : ∀ x : F₁, τb (algebraMap F₁ (AlgebraicClosure F₁) x) =
        algebraMap F₂ (AlgebraicClosure F₂) (τ x))
    (κ : EllipticRootNumber.AbsGal F₁ ≃* EllipticRootNumber.AbsGal F₂)
    (hκ : ∀ σ x, κ σ (τb x) = τb (σ x))
    (rec₂ : EllipticRootNumber.LocalReciprocity F₂) :
    ∃ rec₁ : EllipticRootNumber.LocalReciprocity F₁,
      ∀ (L₁ : IntermediateField F₁ (AlgebraicClosure F₁))
        (L₂ : IntermediateField F₂ (AlgebraicClosure F₂)), (∀ y, y ∈ L₂ ↔ τb.symm y ∈ L₁) →
        ∀ (x₁ : L₁ˣ) (x₂ : L₂ˣ),
          ((x₂ : L₂) : AlgebraicClosure F₂) = τb ((x₁ : L₁) : AlgebraicClosure F₁) →
          ((rec₂.recMap L₂ x₂ : EllipticRootNumber.relWeil F₂ L₂) :
              EllipticRootNumber.AbsGal F₂) =
            κ (rec₁.recMap L₁ x₁ : EllipticRootNumber.AbsGal F₁) :=
by
  classical
  
  obtain ⟨hq, hp, hv, -⟩ := ringEquiv_localField_invariants τ hS
  obtain ⟨-, hFrob, hWeil, hFix⟩ := galConj_naturality τb κ hκ hp hq
  obtain ⟨-, D₁b⟩ := weilDegreeHom_spec_of_localField F₁
  obtain ⟨D₂a, D₂b⟩ := weilDegreeHom_spec_of_localField F₂
  obtain ⟨hEx, hT⟩ := intermediateField_transport τ hv τb hτb
  choose L₂of hL₂of using hEx
  
  have hRW : ∀ (L₁ : IntermediateField F₁ (AlgebraicClosure F₁))
      (L₂ : IntermediateField F₂ (AlgebraicClosure F₂)), (∀ y, y ∈ L₂ ↔ τb.symm y ∈ L₁) →
      ∀ σ, κ σ ∈ EllipticRootNumber.relWeil F₂ L₂ ↔ σ ∈ EllipticRootNumber.relWeil F₁ L₁ := by
    intro L₁ L₂ hC σ
    unfold EllipticRootNumber.relWeil
    rw [Subgroup.mem_inf, Subgroup.mem_inf, hWeil σ, hFix L₁ L₂ hC σ]
  
  have hmemL : ∀ (L₁ : IntermediateField F₁ (AlgebraicClosure F₁)) (x : L₁),
      τb (x : AlgebraicClosure F₁) ∈ L₂of L₁ := fun L₁ x =>
    (hL₂of L₁ _).mpr (by rw [RingEquiv.symm_apply_apply]; exact x.2)
  let eL : ∀ L₁ : IntermediateField F₁ (AlgebraicClosure F₁), L₁ ≃* L₂of L₁ := fun L₁ =>
    { toFun := fun x => ⟨τb x, hmemL L₁ x⟩
      invFun := fun y => ⟨τb.symm y, (hL₂of L₁ y).mp y.2⟩
      left_inv := fun x => Subtype.ext (τb.symm_apply_apply _)
      right_inv := fun y => Subtype.ext (τb.apply_symm_apply _)
      map_mul' := fun x y => Subtype.ext (map_mul τb _ _) }
  let tr : ∀ L₁ : IntermediateField F₁ (AlgebraicClosure F₁), L₁ˣ →* (L₂of L₁)ˣ := fun L₁ =>
    Units.map (eL L₁).toMonoidHom
  have htr : ∀ (L₁ : IntermediateField F₁ (AlgebraicClosure F₁)) (x : L₁ˣ),
      (((tr L₁ x : (L₂of L₁)ˣ) : L₂of L₁) : AlgebraicClosure F₂) =
        τb ((x : L₁) : AlgebraicClosure F₁) := fun _ _ => rfl
  have htrinv : ∀ (L₁ : IntermediateField F₁ (AlgebraicClosure F₁)) (z : (L₂of L₁)ˣ),
      tr L₁ (Units.map (eL L₁).symm.toMonoidHom z) = z := fun L₁ z =>
    Units.ext (Subtype.ext (τb.apply_symm_apply _))
  
  let R : ∀ L₁ : IntermediateField F₁ (AlgebraicClosure F₁), L₁ˣ →
      EllipticRootNumber.relWeil F₁ L₁ := fun L₁ x =>
    ⟨κ.symm (rec₂.recMap (L₂of L₁) (tr L₁ x) : EllipticRootNumber.AbsGal F₂),
      (hRW L₁ (L₂of L₁) (hL₂of L₁) _).mp
        (by rw [MulEquiv.apply_symm_apply]; exact (rec₂.recMap (L₂of L₁) (tr L₁ x)).2)⟩
  have hR : ∀ (L₁ : IntermediateField F₁ (AlgebraicClosure F₁)) (x : L₁ˣ),
      κ (R L₁ x : EllipticRootNumber.AbsGal F₁) =
        (rec₂.recMap (L₂of L₁) (tr L₁ x) : EllipticRootNumber.AbsGal F₂) := fun L₁ x =>
    κ.apply_symm_apply _
  have hle : ∀ {L M : IntermediateField F₁ (AlgebraicClosure F₁)}, L ≤ M → L₂of L ≤ L₂of M :=
    fun {L M} h y hy => (hL₂of M y).mpr (h ((hL₂of L y).mp hy))
  
  have hdeg : ∀ (L : IntermediateField F₁ (AlgebraicClosure F₁)) [FiniteDimensional F₁ L]
      (x : Lˣ), EllipticRootNumber.weilDegreeHom F₁
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F₁ L) (R L x)) =
        Multiplicative.ofAdd (-EllipticRootNumber.relVal F₁ L x) := by
    intro L _ x
    haveI : FiniteDimensional F₂ (L₂of L) := ((hT L (L₂of L) (hL₂of L)).1).mp inferInstance
    have h2 := rec₂.degree_rec (L₂of L) (tr L x)
    have hgW : (rec₂.recMap (L₂of L) (tr L x) : EllipticRootNumber.AbsGal F₂) ∈
        EllipticRootNumber.weilGroup F₂ :=
      EllipticRootNumber.relWeil_le_weilGroup F₂ _ (rec₂.recMap (L₂of L) (tr L x)).2
    obtain ⟨n, hn⟩ := D₂a _ hgW
    have e2 : EllipticRootNumber.weilDegreeHom F₂
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F₂ (L₂of L))
          (rec₂.recMap (L₂of L) (tr L x))) = Multiplicative.ofAdd n := D₂b _ n hn
    have hn1 : EllipticRootNumber.ActsAsFrobPow F₁ (R L x : EllipticRootNumber.AbsGal F₁) n :=
      (hFrob _ n).mp (by rw [hR]; exact hn)
    have e1 : EllipticRootNumber.weilDegreeHom F₁
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F₁ L) (R L x)) =
        Multiplicative.ofAdd n := D₁b _ n hn1
    have hrv := ((hT L (L₂of L) (hL₂of L)).2.2.2 (x : L) (tr L x : L₂of L) (htr L x)).2.1
    rw [e1, ← e2, h2, hrv]
  
  have hmul : ∀ (L M : IntermediateField F₁ (AlgebraicClosure F₁)) [FiniteDimensional F₁ M]
      (h : L ≤ M), EllipticRootNumber.IsAbelianExt F₁ h → ∀ x y : Lˣ,
        (((R L (x * y))⁻¹ * (R L x * R L y) : EllipticRootNumber.relWeil F₁ L) :
          EllipticRootNumber.AbsGal F₁) ∈ M.fixingSubgroup := by
    intro L M _ h hab x y
    haveI : FiniteDimensional F₂ (L₂of M) := ((hT M (L₂of M) (hL₂of M)).1).mp inferInstance
    have hab₂ : EllipticRootNumber.IsAbelianExt F₂ (hle h) :=
      (intermediateField_pair_transport τb κ hκ L M (L₂of L) (L₂of M) h (hle h) (hL₂of L)
        (hL₂of M)).2.2.mpr hab
    have H := rec₂.mul_rec (L₂of L) (L₂of M) (hle h) hab₂ (tr L x) (tr L y)
    rw [← map_mul] at H
    rw [← hFix M (L₂of M) (hL₂of M)]
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, map_mul, map_inv, hR] at H ⊢
    exact H
  
  have hker : ∀ (L M : IntermediateField F₁ (AlgebraicClosure F₁)) [FiniteDimensional F₁ M]
      (h : L ≤ M), EllipticRootNumber.IsAbelianExt F₁ h → ∀ x : Lˣ,
        ((R L x : EllipticRootNumber.relWeil F₁ L) : EllipticRootNumber.AbsGal F₁) ∈
          M.fixingSubgroup ↔ (x : L) ∈ Set.range (EllipticRootNumber.normLM F₁ h) := by
    intro L M _ h hab x
    haveI : FiniteDimensional F₂ (L₂of M) := ((hT M (L₂of M) (hL₂of M)).1).mp inferInstance
    obtain ⟨hN, -, hab_iff⟩ := intermediateField_pair_transport τb κ hκ L M (L₂of L) (L₂of M) h
      (hle h) (hL₂of L) (hL₂of M)
    have hab₂ := hab_iff.mpr hab
    rw [← hFix M (L₂of M) (hL₂of M), hR,
      rec₂.ker_rec (L₂of L) (L₂of M) (hle h) hab₂ (tr L x)]
    constructor
    · rintro ⟨z₂, hz₂⟩
      let z₁ : M := ⟨τb.symm (z₂ : AlgebraicClosure F₂), (hL₂of M _).mp z₂.2⟩
      have hz : (z₂ : AlgebraicClosure F₂) = τb (z₁ : AlgebraicClosure F₁) :=
        (τb.apply_symm_apply _).symm
      refine ⟨z₁, ?_⟩
      apply Subtype.ext
      apply τb.injective
      rw [← (hN z₁ z₂ hz).1, hz₂]
      exact htr L x
    · rintro ⟨z₁, hz₁⟩
      let z₂ : L₂of M := ⟨τb (z₁ : AlgebraicClosure F₁), hmemL M z₁⟩
      refine ⟨z₂, ?_⟩
      apply Subtype.ext
      rw [(hN z₁ z₂ rfl).1, hz₁]
      exact (htr L x).symm
  
  have hsurj : ∀ (L M : IntermediateField F₁ (AlgebraicClosure F₁)) [FiniteDimensional F₁ M]
      (h : L ≤ M), EllipticRootNumber.IsAbelianExt F₁ h →
        ∀ w : EllipticRootNumber.relWeil F₁ L, ∃ x : Lˣ,
          (((R L x)⁻¹ * w : EllipticRootNumber.relWeil F₁ L) : EllipticRootNumber.AbsGal F₁) ∈
            M.fixingSubgroup := by
    intro L M _ h hab w
    haveI : FiniteDimensional F₂ (L₂of M) := ((hT M (L₂of M) (hL₂of M)).1).mp inferInstance
    have hab₂ : EllipticRootNumber.IsAbelianExt F₂ (hle h) :=
      (intermediateField_pair_transport τb κ hκ L M (L₂of L) (L₂of M) h (hle h) (hL₂of L)
        (hL₂of M)).2.2.mpr hab
    obtain ⟨x₂, hx₂⟩ := rec₂.surj_rec (L₂of L) (L₂of M) (hle h) hab₂
      ⟨κ w, (hRW L (L₂of L) (hL₂of L) w).mpr w.2⟩
    refine ⟨Units.map (eL L).symm.toMonoidHom x₂, ?_⟩
    rw [← hFix M (L₂of M) (hL₂of M)]
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, map_mul, map_inv, hR, htrinv] at hx₂ ⊢
    exact hx₂
  
  let rec₁ : EllipticRootNumber.LocalReciprocity F₁ :=
    { recMap := R
      degree_rec := hdeg
      mul_rec := hmul
      ker_rec := hker
      surj_rec := hsurj }
  refine ⟨rec₁, ?_⟩
  intro L₁ L₂ hC x₁ x₂ hx
  have hL : L₂ = L₂of L₁ := SetLike.ext fun y => (hC y).trans (hL₂of L₁ y).symm
  subst hL
  have hxx : x₂ = tr L₁ x₁ := Units.ext (Subtype.ext (hx.trans (htr L₁ x₁).symm))
  subst hxx
  exact (hR L₁ x₁).symm

theorem eps_eq_of_linearEquiv (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] {rec : EllipticRootNumber.LocalReciprocity F}
    (lc : EllipticRootNumber.LocalConstants F rec) (L : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] (ψ : AddChar L (EllipticRootNumber.Ω F))
    (hψ : EllipticRootNumber.IsAdmissibleChar F L ψ)
    {V₁ V₂ : Type u} [AddCommGroup V₁] [Module (EllipticRootNumber.Ω F) V₁]
    [AddCommGroup V₂] [Module (EllipticRootNumber.Ω F) V₂]
    (σ₁ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F L) V₁)
    (σ₂ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F L) V₂)
    (h₁ : EllipticRootNumber.IsWeilRep F L σ₁) (h₂ : EllipticRootNumber.IsWeilRep F L σ₂)
    (e : V₁ ≃ₗ[EllipticRootNumber.Ω F] V₂)
    (he : ∀ w, e.toLinearMap ∘ₗ σ₁ w = σ₂ w ∘ₗ e.toLinearMap) :
    lc.eps L σ₁ ψ = lc.eps L σ₂ ψ :=
by
  let T : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F L) PUnit.{u+1} :=
    Representation.trivial (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F L) PUnit.{u+1}
  have hT : EllipticRootNumber.IsWeilRep F L T :=
    ⟨inferInstance, Set.univ, Filter.univ_mem, fun _ _ _ => Subsingleton.elim _ _⟩
  have hTT := lc.eps_exact L ψ hψ T T T hT hT hT LinearMap.id LinearMap.id
    (fun _ => Subsingleton.elim _ _) (fun _ => Subsingleton.elim _ _)
    Function.injective_id Function.surjective_id (Subsingleton.elim _ _)
  have h0 : lc.eps L T ψ = 1 := mul_eq_left.mp hTT.symm
  have h := lc.eps_exact L ψ hψ σ₁ σ₂ T h₁ h₂ hT e.toLinearMap
    (0 : V₂ →ₗ[EllipticRootNumber.Ω F] PUnit.{u+1}) he (fun _ => Subsingleton.elim _ _)
    e.injective (fun _ => ⟨0, Subsingleton.elim _ _⟩)
    (by rw [LinearMap.range_eq_top.mpr e.surjective, LinearMap.ker_zero])
  rw [h, h0, mul_one]

theorem galConj_nhds_one {F₁ F₂ : Type u} [Field F₁] [Field F₂] (τ : F₁ ≃+* F₂)
    (τb : AlgebraicClosure F₁ ≃+* AlgebraicClosure F₂)
    (hτb : ∀ x : F₁, τb (algebraMap F₁ _ x) = algebraMap F₂ _ (τ x))
    (κ : (AlgebraicClosure F₁ ≃ₐ[F₁] AlgebraicClosure F₁) ≃*
      (AlgebraicClosure F₂ ≃ₐ[F₂] AlgebraicClosure F₂))
    (hκ : ∀ σ x, κ σ (τb x) = τb (σ x))
    (U : Set (AlgebraicClosure F₁ ≃ₐ[F₁] AlgebraicClosure F₁)) :
    U ∈ nhds (1 : AlgebraicClosure F₁ ≃ₐ[F₁] AlgebraicClosure F₁) ↔
      κ '' U ∈ nhds (1 : AlgebraicClosure F₂ ≃ₐ[F₂] AlgebraicClosure F₂) :=
by
  classical
  have s1 : ∀ {A : Type u} [Field A] (E : IntermediateField A (AlgebraicClosure A))
      [FiniteDimensional A E], ∃ S : Set (AlgebraicClosure A), S.Finite ∧
        ∀ σ : AlgebraicClosure A ≃ₐ[A] AlgebraicClosure A,
          (∀ s ∈ S, σ s = s) → σ ∈ E.fixingSubgroup := by
    intro A _ E _
    let b := Module.finBasis A E
    refine ⟨Set.range (fun i => ((b i : E) : AlgebraicClosure A)), Set.finite_range _, ?_⟩
    intro σ hσ
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    have hx' : x = ∑ i, (b.repr ⟨x, hx⟩ i) • ((b i : E) : AlgebraicClosure A) := by
      calc x = E.val ⟨x, hx⟩ := rfl
        _ = E.val (∑ i, (b.repr ⟨x, hx⟩ i) • b i) := by rw [b.sum_repr]
        _ = _ := by rw [map_sum]; simp only [map_smul]; rfl
    rw [hx', map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_smul, hσ _ ⟨i, rfl⟩]
  have H : ∀ {A B : Type u} [Field A] [Field B]
      (t : AlgebraicClosure A ≃+* AlgebraicClosure B)
      (k : (AlgebraicClosure A ≃ₐ[A] AlgebraicClosure A) ≃*
        (AlgebraicClosure B ≃ₐ[B] AlgebraicClosure B))
      (_hk : ∀ σ x, k σ (t x) = t (σ x))
      (V : Set (AlgebraicClosure A ≃ₐ[A] AlgebraicClosure A)),
      V ∈ nhds (1 : AlgebraicClosure A ≃ₐ[A] AlgebraicClosure A) →
        k '' V ∈ nhds (1 : AlgebraicClosure B ≃ₐ[B] AlgebraicClosure B) := by
    intro A B _ _ t k hk V hV
    obtain ⟨E, hE, hEV⟩ := (krullTopology_mem_nhds_one_iff A _ V).mp hV
    haveI := hE
    obtain ⟨S, hSfin, hS⟩ := s1 E
    haveI : Finite (t '' S) := (hSfin.image t).to_subtype
    have fd : FiniteDimensional B (IntermediateField.adjoin B (t '' S)) :=
      IntermediateField.finiteDimensional_adjoin (fun y _ => Algebra.IsIntegral.isIntegral y)
    refine (krullTopology_mem_nhds_one_iff B _ (k '' V)).mpr ⟨_, fd, ?_⟩
    intro ρ hρ
    refine ⟨k.symm ρ, hEV (hS _ (fun s hs => ?_)), MulEquiv.apply_symm_apply k ρ⟩
    apply t.injective
    rw [← hk, MulEquiv.apply_symm_apply]
    exact (IntermediateField.mem_fixingSubgroup_iff _ _).mp hρ _
      (IntermediateField.subset_adjoin B _ ⟨s, hs, rfl⟩)
  have hκ' : ∀ ρ y, κ.symm ρ (τb.symm y) = τb.symm (ρ y) := by
    intro ρ y
    have h := hκ (κ.symm ρ) (τb.symm y)
    rw [MulEquiv.apply_symm_apply, RingEquiv.apply_symm_apply] at h
    rw [h, RingEquiv.symm_apply_apply]
  constructor
  · exact H τb κ hκ U
  · intro h
    have h2 := H τb.symm κ.symm hκ' _ h
    simpa only [Set.image_image, MulEquiv.symm_apply_apply, Set.image_id'] using h2

theorem isWeilRep_transport {F₁ F₂ : Type u} [Field F₁] [Field F₂]
    [ValuativeRel F₁] [TopologicalSpace F₁] [IsNonarchimedeanLocalField F₁]
    [ValuativeRel F₂] [TopologicalSpace F₂] [IsNonarchimedeanLocalField F₂]
    (κ : EllipticRootNumber.AbsGal F₁ ≃* EllipticRootNumber.AbsGal F₂)
    (hI : ∀ σ, κ σ ∈ EllipticRootNumber.inertia F₂ ↔ σ ∈ EllipticRootNumber.inertia F₁)
    (hU : ∀ U : Set (EllipticRootNumber.AbsGal F₁), U ∈ nhds (1 : EllipticRootNumber.AbsGal F₁) →
      κ '' U ∈ nhds (1 : EllipticRootNumber.AbsGal F₂))
    (L₁ : IntermediateField F₁ (AlgebraicClosure F₁))
    (L₂ : IntermediateField F₂ (AlgebraicClosure F₂))
    (hW : ∀ σ, κ σ ∈ EllipticRootNumber.relWeil F₂ L₂ ↔ σ ∈ EllipticRootNumber.relWeil F₁ L₁)
    (ι : EllipticRootNumber.Ω F₁ ≃+* EllipticRootNumber.Ω F₂)
    {V₁ V₂ : Type u} [AddCommGroup V₁] [Module (EllipticRootNumber.Ω F₁) V₁]
    [AddCommGroup V₂] [Module (EllipticRootNumber.Ω F₂) V₂]
    (ρ₁ : Representation (EllipticRootNumber.Ω F₁) (EllipticRootNumber.relWeil F₁ L₁) V₁)
    (ρ₂ : Representation (EllipticRootNumber.Ω F₂) (EllipticRootNumber.relWeil F₂ L₂) V₂)
    (e : V₁ ≃+ V₂) (he : ∀ (c : EllipticRootNumber.Ω F₁) (v : V₁), e (c • v) = ι c • e v)
    (hρ : ∀ (w₁ : EllipticRootNumber.relWeil F₁ L₁) (w₂ : EllipticRootNumber.relWeil F₂ L₂),
      (w₂ : EllipticRootNumber.AbsGal F₂) = κ w₁ → ∀ v, e (ρ₁ w₁ v) = ρ₂ w₂ (e v))
    (h₁ : EllipticRootNumber.IsWeilRep F₁ L₁ ρ₁) :
    EllipticRootNumber.IsWeilRep F₂ L₂ ρ₂ :=
by
  obtain ⟨hfin, U₁, hU₁, hU₁ρ⟩ := h₁
  refine ⟨?_, κ '' U₁, hU U₁ hU₁, ?_⟩
  · have hr : Module.rank (EllipticRootNumber.Ω F₁) V₁ = Module.rank (EllipticRootNumber.Ω F₂) V₂ :=
      rank_eq_of_equiv_equiv (⇑ι) e ι.bijective he
    have h1 : Module.rank (EllipticRootNumber.Ω F₁) V₁ < Cardinal.aleph0 :=
      Module.rank_lt_aleph0_iff.mpr hfin
    rw [hr] at h1
    exact Module.rank_lt_aleph0_iff.mp h1
  · intro w₂ hw₂U hw₂I
    obtain ⟨σ, hσU, hσ⟩ := hw₂U
    have hσW : σ ∈ EllipticRootNumber.relWeil F₁ L₁ := (hW σ).mp (hσ ▸ w₂.2)
    have hσI : σ ∈ EllipticRootNumber.inertia F₁ := (hI σ).mp (hσ ▸ hw₂I)
    let w₁ : EllipticRootNumber.relWeil F₁ L₁ := ⟨σ, hσW⟩
    have hρ₁ : ρ₁ w₁ = 1 := hU₁ρ w₁ hσU hσI
    apply LinearMap.ext
    intro y
    have key := hρ w₁ w₂ hσ.symm (e.symm y)
    rw [hρ₁, Module.End.one_apply, AddEquiv.apply_symm_apply] at key
    rw [Module.End.one_apply]
    exact key.symm

theorem isWeilRep_indLM (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L M : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M] (h : L ≤ M) {V : Type u} [AddCommGroup V]
    [Module (EllipticRootNumber.Ω F) V]
    (σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F M) V)
    (hσ : EllipticRootNumber.IsWeilRep F M σ) :
    EllipticRootNumber.IsWeilRep F L (EllipticRootNumber.indLM F h σ) :=
by
  classical
  obtain ⟨hfd, U, hU, hUσ⟩ := hσ
  set H : Subgroup (EllipticRootNumber.relWeil F L) :=
    (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F L) with hH
  set ρ := σ.comp (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F h)).toMonoidHom
    with hρ
  
  have hfinQ : Finite (EllipticRootNumber.relWeil F L ⧸ H) := by
    let Ψ : (EllipticRootNumber.relWeil F L ⧸ H) → (M →ₐ[F] AlgebraicClosure F) :=
      fun q => ((Quotient.out q : EllipticRootNumber.relWeil F L) :
        EllipticRootNumber.AbsGal F).toAlgHom.comp M.val
    refine Finite.of_injective Ψ ?_
    intro q₁ q₂ hq
    rw [← QuotientGroup.out_eq' q₁, ← QuotientGroup.out_eq' q₂, QuotientGroup.eq,
      Subgroup.mem_subgroupOf]
    show _ ∈ EllipticRootNumber.weilGroup F ⊓ M.fixingSubgroup
    rw [Subgroup.mem_inf]
    refine ⟨(Subgroup.mem_inf.mp ((Quotient.out q₁)⁻¹ * Quotient.out q₂ :
      EllipticRootNumber.relWeil F L).2).1, ?_⟩
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    have e := congrArg (fun φ : M →ₐ[F] AlgebraicClosure F => φ ⟨x, hx⟩) hq
    simp only [Ψ, AlgHom.comp_apply, IntermediateField.val_mk, AlgEquiv.toAlgHom_eq_coe,
      AlgHom.coe_coe] at e
    rw [Subgroup.coe_mul, Subgroup.coe_inv, AlgEquiv.mul_apply, ← e, ← AlgEquiv.mul_apply,
      inv_mul_cancel, AlgEquiv.one_apply]
  
  have hstab : ∀ (g : EllipticRootNumber.AbsGal F) (x : AlgebraicClosure F),
      x ∈ EllipticRootNumber.unramifiedClosure F →
        g x ∈ EllipticRootNumber.unramifiedClosure F := by
    intro g x hx
    have hle : (EllipticRootNumber.unramifiedClosure F).map
        (g : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) ≤
        EllipticRootNumber.unramifiedClosure F := by
      unfold EllipticRootNumber.unramifiedClosure
      rw [IntermediateField.adjoin_map, IntermediateField.adjoin_le_iff]
      rintro _ ⟨ζ, ⟨n, hn, hp, hζ⟩, rfl⟩
      apply IntermediateField.subset_adjoin
      refine ⟨n, hn, hp, ?_⟩
      rw [← map_pow, hζ, map_one]
    apply hle
    rw [← SetLike.mem_coe, IntermediateField.coe_map]
    exact ⟨x, hx, rfl⟩
  have hconj : ∀ (g n : EllipticRootNumber.AbsGal F), n ∈ EllipticRootNumber.inertia F →
      g * n * g⁻¹ ∈ EllipticRootNumber.inertia F := by
    intro g n hn
    unfold EllipticRootNumber.inertia at hn ⊢
    rw [IntermediateField.mem_fixingSubgroup_iff] at hn ⊢
    intro x hx
    rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, hn _ (hstab g⁻¹ x hx), ← AlgEquiv.mul_apply,
      mul_inv_cancel, AlgEquiv.one_apply]
  
  have hdec : ∀ x : EllipticRootNumber.relWeil F L, ∃ k₀ : H,
      x = (k₀ : EllipticRootNumber.relWeil F L) *
        (Quotient.out ((x⁻¹ : EllipticRootNumber.relWeil F L) :
          EllipticRootNumber.relWeil F L ⧸ H))⁻¹ := by
    intro x
    obtain ⟨k₀, hk⟩ := QuotientGroup.mk_out_eq_mul H x⁻¹
    refine ⟨k₀, ?_⟩
    rw [hk]
    group
  refine ⟨?_, ?_⟩
  · 
    haveI := hfd
    let Φ : EllipticRootNumber.indSpace H ρ →ₗ[EllipticRootNumber.Ω F]
        (EllipticRootNumber.relWeil F L ⧸ H → V) :=
      LinearMap.pi fun q => (LinearMap.proj (Quotient.out q)⁻¹).comp
        (EllipticRootNumber.indSpace H ρ).subtype
    refine Module.Finite.of_injective Φ ?_
    rw [injective_iff_map_eq_zero]
    intro f hf
    apply Subtype.ext
    funext x
    obtain ⟨k₀, hx⟩ := hdec x
    have h0 := congrFun hf ((x⁻¹ : EllipticRootNumber.relWeil F L) :
      EllipticRootNumber.relWeil F L ⧸ H)
    simp only [Φ, LinearMap.pi_apply, LinearMap.coe_comp, Function.comp_apply,
      Submodule.coe_subtype, LinearMap.proj_apply, Pi.zero_apply] at h0
    show (f : EllipticRootNumber.relWeil F L → V) x = 0
    have h0' : (f : EllipticRootNumber.relWeil F L → V)
        (Quotient.out ((x⁻¹ : EllipticRootNumber.relWeil F L) :
          EllipticRootNumber.relWeil F L ⧸ H))⁻¹ = 0 := h0
    rw [hx, f.2 k₀, h0', map_zero]
  · 
    let S : Set (EllipticRootNumber.AbsGal F) := U ∩ (M.fixingSubgroup : Set _)
    have hS : S ∈ nhds (1 : EllipticRootNumber.AbsGal F) :=
      Filter.inter_mem hU ((IntermediateField.fixingSubgroup_isOpen M).mem_nhds (one_mem _))
    let a : (EllipticRootNumber.relWeil F L ⧸ H) → EllipticRootNumber.AbsGal F :=
      fun q => ((Quotient.out q : EllipticRootNumber.relWeil F L) : EllipticRootNumber.AbsGal F)
    have hpre : ∀ q, (fun y => (a q)⁻¹ * y * a q) ⁻¹' S ∈ nhds (1 : EllipticRootNumber.AbsGal F) := by
      intro q
      have hc : Continuous (fun y : EllipticRootNumber.AbsGal F => (a q)⁻¹ * y * a q) :=
        (continuous_const.mul continuous_id).mul continuous_const
      apply hc.continuousAt.preimage_mem_nhds
      simpa using hS
    refine ⟨⋂ q, (fun y => (a q)⁻¹ * y * a q) ⁻¹' S, Filter.iInter_mem.mpr hpre, ?_⟩
    intro w hwU hwI
    apply LinearMap.ext
    intro f
    apply Subtype.ext
    funext x
    show (f : EllipticRootNumber.relWeil F L → V) (x * w) = (f : EllipticRootNumber.relWeil F L → V) x
    obtain ⟨k₀, hx⟩ := hdec x
    set t := Quotient.out ((x⁻¹ : EllipticRootNumber.relWeil F L) :
      EllipticRootNumber.relWeil F L ⧸ H) with ht
    have hcS : (a ((x⁻¹ : EllipticRootNumber.relWeil F L) : EllipticRootNumber.relWeil F L ⧸ H))⁻¹ *
        (w : EllipticRootNumber.AbsGal F) *
        a ((x⁻¹ : EllipticRootNumber.relWeil F L) : EllipticRootNumber.relWeil F L ⧸ H) ∈ S :=
      Set.mem_iInter.mp hwU _
    have hcI : (a ((x⁻¹ : EllipticRootNumber.relWeil F L) : EllipticRootNumber.relWeil F L ⧸ H))⁻¹ *
        (w : EllipticRootNumber.AbsGal F) *
        a ((x⁻¹ : EllipticRootNumber.relWeil F L) : EllipticRootNumber.relWeil F L ⧸ H) ∈
        EllipticRootNumber.inertia F := by
      have := hconj (a ((x⁻¹ : EllipticRootNumber.relWeil F L) :
        EllipticRootNumber.relWeil F L ⧸ H))⁻¹ _ hwI
      rwa [inv_inv] at this
    have hc : t⁻¹ * w * t ∈ H := by
      rw [Subgroup.mem_subgroupOf]
      show _ ∈ EllipticRootNumber.weilGroup F ⊓ M.fixingSubgroup
      exact ⟨(Subgroup.mem_inf.mp (t⁻¹ * w * t).2).1, hcS.2⟩
    have hρc : ρ ⟨t⁻¹ * w * t, hc⟩ = 1 := hUσ _ hcS.1 hcI
    have hxw : x * w = ((k₀ * ⟨t⁻¹ * w * t, hc⟩ : H) : EllipticRootNumber.relWeil F L) * t⁻¹ := by
      rw [Subgroup.coe_mul, Subgroup.coe_mk, hx]
      group
    rw [hxw, f.2, map_mul, Module.End.mul_apply, hρc, Module.End.one_apply, ← f.2, ← hx]

theorem indLM_transport {F₁ F₂ : Type u} [Field F₁] [Field F₂]
    [ValuativeRel F₁] [TopologicalSpace F₁] [IsNonarchimedeanLocalField F₁]
    [ValuativeRel F₂] [TopologicalSpace F₂] [IsNonarchimedeanLocalField F₂]
    (κ : EllipticRootNumber.AbsGal F₁ ≃* EllipticRootNumber.AbsGal F₂)
    (L₁ M₁ : IntermediateField F₁ (AlgebraicClosure F₁))
    (L₂ M₂ : IntermediateField F₂ (AlgebraicClosure F₂)) (h₁ : L₁ ≤ M₁) (h₂ : L₂ ≤ M₂)
    (hWL : ∀ σ, κ σ ∈ EllipticRootNumber.relWeil F₂ L₂ ↔ σ ∈ EllipticRootNumber.relWeil F₁ L₁)
    (hWM : ∀ σ, κ σ ∈ EllipticRootNumber.relWeil F₂ M₂ ↔ σ ∈ EllipticRootNumber.relWeil F₁ M₁)
    (ι : EllipticRootNumber.Ω F₁ ≃+* EllipticRootNumber.Ω F₂)
    {V₁ V₂ : Type u} [AddCommGroup V₁] [Module (EllipticRootNumber.Ω F₁) V₁]
    [AddCommGroup V₂] [Module (EllipticRootNumber.Ω F₂) V₂]
    (σ₁ : Representation (EllipticRootNumber.Ω F₁) (EllipticRootNumber.relWeil F₁ M₁) V₁)
    (σ₂ : Representation (EllipticRootNumber.Ω F₂) (EllipticRootNumber.relWeil F₂ M₂) V₂)
    (e : V₁ ≃+ V₂) (he : ∀ (c : EllipticRootNumber.Ω F₁) (v : V₁), e (c • v) = ι c • e v)
    (hσ : ∀ (w₁ : EllipticRootNumber.relWeil F₁ M₁) (w₂ : EllipticRootNumber.relWeil F₂ M₂),
      (w₂ : EllipticRootNumber.AbsGal F₂) = κ w₁ → ∀ v, e (σ₁ w₁ v) = σ₂ w₂ (e v)) :
    ∃ e' : ↥(EllipticRootNumber.indSpace
          ((EllipticRootNumber.relWeil F₁ M₁).subgroupOf (EllipticRootNumber.relWeil F₁ L₁))
          (σ₁.comp (Subgroup.subgroupOfEquivOfLe
            (EllipticRootNumber.relWeil_antitone F₁ h₁)).toMonoidHom)) ≃+
        ↥(EllipticRootNumber.indSpace
          ((EllipticRootNumber.relWeil F₂ M₂).subgroupOf (EllipticRootNumber.relWeil F₂ L₂))
          (σ₂.comp (Subgroup.subgroupOfEquivOfLe
            (EllipticRootNumber.relWeil_antitone F₂ h₂)).toMonoidHom)),
      (∀ (c : EllipticRootNumber.Ω F₁) v, e' (c • v) = ι c • e' v) ∧
      ∀ (w₁ : EllipticRootNumber.relWeil F₁ L₁) (w₂ : EllipticRootNumber.relWeil F₂ L₂),
        (w₂ : EllipticRootNumber.AbsGal F₂) = κ w₁ → ∀ v,
          e' (EllipticRootNumber.indLM F₁ h₁ σ₁ w₁ v) =
            EllipticRootNumber.indLM F₂ h₂ σ₂ w₂ (e' v) :=
by
  classical
  let φ : EllipticRootNumber.relWeil F₁ L₁ ≃* EllipticRootNumber.relWeil F₂ L₂ :=
    { toFun := fun g => ⟨κ g, (hWL g).mpr g.2⟩
      invFun := fun t => ⟨κ.symm t, (hWL (κ.symm t)).mp (by rw [MulEquiv.apply_symm_apply]; exact t.2)⟩
      left_inv := fun g => Subtype.ext (κ.symm_apply_apply g)
      right_inv := fun t => Subtype.ext (κ.apply_symm_apply t)
      map_mul' := fun a b => Subtype.ext (map_mul κ (a : EllipticRootNumber.AbsGal F₁)
        (b : EllipticRootNumber.AbsGal F₁)) }
  have hφs : ∀ t, ((φ.symm t : EllipticRootNumber.relWeil F₁ L₁) : EllipticRootNumber.AbsGal F₁) =
      κ.symm t := fun _ => rfl
  have key : ∀ (a : (EllipticRootNumber.relWeil F₁ M₁).subgroupOf (EllipticRootNumber.relWeil F₁ L₁))
      (b : (EllipticRootNumber.relWeil F₂ M₂).subgroupOf (EllipticRootNumber.relWeil F₂ L₂)),
      ((b : EllipticRootNumber.relWeil F₂ L₂) : EllipticRootNumber.AbsGal F₂) =
        κ ((a : EllipticRootNumber.relWeil F₁ L₁) : EllipticRootNumber.AbsGal F₁) → ∀ v,
      e ((σ₁.comp (Subgroup.subgroupOfEquivOfLe
            (EllipticRootNumber.relWeil_antitone F₁ h₁)).toMonoidHom) a v) =
        (σ₂.comp (Subgroup.subgroupOfEquivOfLe
            (EllipticRootNumber.relWeil_antitone F₂ h₂)).toMonoidHom) b (e v) := by
    intro a b hab v
    exact hσ _ _ hab v
  have mem1 : ∀ f : ↥(EllipticRootNumber.indSpace
          ((EllipticRootNumber.relWeil F₁ M₁).subgroupOf (EllipticRootNumber.relWeil F₁ L₁))
          (σ₁.comp (Subgroup.subgroupOfEquivOfLe
            (EllipticRootNumber.relWeil_antitone F₁ h₁)).toMonoidHom)),
      (fun g₂ => e ((f : EllipticRootNumber.relWeil F₁ L₁ → V₁) (φ.symm g₂))) ∈
        EllipticRootNumber.indSpace
          ((EllipticRootNumber.relWeil F₂ M₂).subgroupOf (EllipticRootNumber.relWeil F₂ L₂))
          (σ₂.comp (Subgroup.subgroupOfEquivOfLe
            (EllipticRootNumber.relWeil_antitone F₂ h₂)).toMonoidHom) := by
    intro f h₂' g₂
    have hm : ((φ.symm (h₂' : EllipticRootNumber.relWeil F₂ L₂) : EllipticRootNumber.relWeil F₁ L₁) :
        EllipticRootNumber.AbsGal F₁) ∈ EllipticRootNumber.relWeil F₁ M₁ :=
      (hWM _).mp (by rw [hφs, MulEquiv.apply_symm_apply]; exact h₂'.2)
    have hf := f.2 ⟨φ.symm h₂', hm⟩ (φ.symm g₂)
    show e ((f : EllipticRootNumber.relWeil F₁ L₁ → V₁) (φ.symm (↑h₂' * g₂))) = _
    rw [map_mul]
    exact (congrArg e hf).trans (key _ _ (κ.apply_symm_apply _).symm _)
  have mem2 : ∀ f : ↥(EllipticRootNumber.indSpace
          ((EllipticRootNumber.relWeil F₂ M₂).subgroupOf (EllipticRootNumber.relWeil F₂ L₂))
          (σ₂.comp (Subgroup.subgroupOfEquivOfLe
            (EllipticRootNumber.relWeil_antitone F₂ h₂)).toMonoidHom)),
      (fun g₁ => e.symm ((f : EllipticRootNumber.relWeil F₂ L₂ → V₂) (φ g₁))) ∈
        EllipticRootNumber.indSpace
          ((EllipticRootNumber.relWeil F₁ M₁).subgroupOf (EllipticRootNumber.relWeil F₁ L₁))
          (σ₁.comp (Subgroup.subgroupOfEquivOfLe
            (EllipticRootNumber.relWeil_antitone F₁ h₁)).toMonoidHom) := by
    intro f h₁' g₁
    have hm : ((φ (h₁' : EllipticRootNumber.relWeil F₁ L₁) : EllipticRootNumber.relWeil F₂ L₂) :
        EllipticRootNumber.AbsGal F₂) ∈ EllipticRootNumber.relWeil F₂ M₂ :=
      (hWM _).mpr h₁'.2
    have hf := f.2 ⟨φ h₁', hm⟩ (φ g₁)
    show e.symm ((f : EllipticRootNumber.relWeil F₂ L₂ → V₂) (φ (↑h₁' * g₁))) = _
    rw [map_mul]
    apply e.injective
    rw [AddEquiv.apply_symm_apply, key h₁' ⟨φ h₁', hm⟩ rfl, AddEquiv.apply_symm_apply]
    exact hf
  refine ⟨{ toFun := fun f => ⟨_, mem1 f⟩
            invFun := fun f => ⟨_, mem2 f⟩
            left_inv := fun f => Subtype.ext (funext fun g₁ => by
              show e.symm (e ((f : EllipticRootNumber.relWeil F₁ L₁ → V₁) (φ.symm (φ g₁)))) = _
              rw [AddEquiv.symm_apply_apply, MulEquiv.symm_apply_apply])
            right_inv := fun f => Subtype.ext (funext fun g₂ => by
              show e (e.symm ((f : EllipticRootNumber.relWeil F₂ L₂ → V₂) (φ (φ.symm g₂)))) = _
              rw [AddEquiv.apply_symm_apply, MulEquiv.apply_symm_apply])
            map_add' := fun f f' => Subtype.ext (funext fun g₂ => map_add e _ _) },
          fun c f => Subtype.ext (funext fun g₂ => he c _), fun w₁ w₂ hw f => ?_⟩
  have hw' : w₂ = φ w₁ := Subtype.ext hw
  subst hw'
  apply Subtype.ext
  funext g₂
  show e ((f : EllipticRootNumber.relWeil F₁ L₁ → V₁) (φ.symm g₂ * w₁)) =
    e ((f : EllipticRootNumber.relWeil F₁ L₁ → V₁) (φ.symm (g₂ * φ w₁)))
  rw [map_mul, MulEquiv.symm_apply_apply]

theorem valL_spec (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] :
    0 < EllipticRootNumber.resDeg F L ∧
    (∀ x : L, x ≠ 0 → EllipticRootNumber.relVal F L x =
      (EllipticRootNumber.resDeg F L : ℤ) * EllipticRootNumber.valL F L x) ∧
    (∀ x y : L, x ≠ 0 → y ≠ 0 →
      EllipticRootNumber.valL F L (x * y) = EllipticRootNumber.valL F L x + EllipticRootNumber.valL F L y) ∧
    (∀ x y : L, x ≠ 0 → y ≠ 0 → x + y ≠ 0 →
      min (EllipticRootNumber.valL F L x) (EllipticRootNumber.valL F L y) ≤
        EllipticRootNumber.valL F L (x + y)) ∧
    (∃ x : L, EllipticRootNumber.valL F L x = 1) ∧
    ∀ w : Valuation (AlgebraicClosure F) NNReal,
      (∀ a : F, w (algebraMap F _ a) ≤ 1 ↔ ValuativeRel.valuation F a ≤ 1) →
      (∀ (σ : EllipticRootNumber.AbsGal F) α, w (σ α) = w α) →
      ∃ r : NNReal, 0 < r ∧ r < 1 ∧ ∀ x : L, x ≠ 0 →
        w (x : AlgebraicClosure F) ^ Module.finrank F L = r ^ EllipticRootNumber.relVal F L x :=
by
  classical
  
  have key : ∀ (z : WithZero (Multiplicative ℤ)) (hz : z ≠ 0),
      Multiplicative.toAdd (WithZero.unzero hz) = WithZero.log z := by
    intro z hz
    obtain ⟨u, rfl⟩ := WithZero.ne_zero_iff_exists.mp hz
    rw [WithZero.unzero_coe]
    show _ = WithZero.log (WithZero.exp (Multiplicative.toAdd u))
    rw [WithZero.log_exp]
  have hne : ∀ c : F, c ≠ 0 →
      IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (ValuativeRel.valuation F c) ≠ 0 :=
    fun c hc => (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hc)
  have av : ∀ a : F, a ≠ 0 → EllipticRootNumber.addVal F a =
      -WithZero.log (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
        (ValuativeRel.valuation F a)) := by
    intro a ha
    unfold EllipticRootNumber.addVal
    rw [dif_neg ha, key]
  have hexp : ∀ a : F, a ≠ 0 →
      IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (ValuativeRel.valuation F a) =
        WithZero.exp (-EllipticRootNumber.addVal F a) := by
    intro a ha
    rw [av a ha, neg_neg, WithZero.exp_log (hne a ha)]
  have av_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → EllipticRootNumber.addVal F (a * b) =
      EllipticRootNumber.addVal F a + EllipticRootNumber.addVal F b := by
    intro a b ha hb
    rw [av _ (mul_ne_zero ha hb), av _ ha, av _ hb, map_mul, map_mul,
      WithZero.log_mul (hne a ha) (hne b hb), neg_add]
  have av_one : EllipticRootNumber.addVal F 1 = 0 := by
    have h := av_mul 1 1 one_ne_zero one_ne_zero
    rw [mul_one] at h
    omega
  have av_inv : ∀ a : F, a ≠ 0 →
      EllipticRootNumber.addVal F a⁻¹ = -EllipticRootNumber.addVal F a := by
    intro a ha
    have h := av_mul a a⁻¹ ha (inv_ne_zero ha)
    rw [mul_inv_cancel₀ ha, av_one] at h
    omega
  have av_le : ∀ a : F, a ≠ 0 →
      (ValuativeRel.valuation F a ≤ 1 ↔ 0 ≤ EllipticRootNumber.addVal F a) := by
    intro a ha
    rw [← map_le_map_iff (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F), map_one,
      hexp a ha, ← WithZero.exp_zero, WithZero.exp_le_exp, neg_nonpos]
  obtain ⟨π, hπ0, hπ1⟩ : ∃ a : F, a ≠ 0 ∧ EllipticRootNumber.addVal F a = 1 := by
    obtain ⟨γ, hγ⟩ := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).surjective
      (WithZero.exp (-1 : ℤ))
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective γ
    have ha0 : a ≠ 0 := by
      intro h
      apply WithZero.exp_ne_zero (a := (-1 : ℤ))
      rw [← hγ, ← ha, h, map_zero, map_zero]
    refine ⟨a, ha0, ?_⟩
    have hγ' : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F γ =
        WithZero.exp (-1 : ℤ) := hγ
    rw [av a ha0, ha, hγ', WithZero.log_exp, neg_neg]
  have av_zpow : ∀ k : ℤ, EllipticRootNumber.addVal F (π ^ k) = k := by
    intro k
    refine Int.induction_on k ?_ ?_ ?_
    · rw [zpow_zero, av_one]
    · intro k ih
      rw [zpow_add_one₀ hπ0, av_mul _ _ (zpow_ne_zero _ hπ0) hπ0, ih, hπ1]
    · intro k ih
      rw [zpow_sub_one₀ hπ0, av_mul _ _ (zpow_ne_zero _ hπ0) (inv_ne_zero hπ0), ih,
        av_inv _ hπ0, hπ1]
      ring
  
  have s5 : ∀ w : Valuation (AlgebraicClosure F) NNReal,
      (∀ a : F, w (algebraMap F _ a) ≤ 1 ↔ ValuativeRel.valuation F a ≤ 1) →
      ∃ r : NNReal, 0 < r ∧ r < 1 ∧ ∀ a : F, a ≠ 0 →
        w (algebraMap F (AlgebraicClosure F) a) = r ^ EllipticRootNumber.addVal F a := by
    intro w hw
    have hw0 : ∀ a : F, a ≠ 0 → w (algebraMap F (AlgebraicClosure F) a) ≠ 0 :=
      fun a ha => (Valuation.ne_zero_iff w).mpr ((map_ne_zero _).mpr ha)
    have hunit : ∀ u : F, u ≠ 0 → EllipticRootNumber.addVal F u = 0 →
        w (algebraMap F (AlgebraicClosure F) u) = 1 := by
      intro u hu h0
      have h1 : w (algebraMap F (AlgebraicClosure F) u) ≤ 1 :=
        (hw u).mpr ((av_le u hu).mpr h0.ge)
      have h2 : w (algebraMap F (AlgebraicClosure F) u⁻¹) ≤ 1 :=
        (hw _).mpr ((av_le _ (inv_ne_zero hu)).mpr (by simp [av_inv u hu, h0]))
      have h3 : w (algebraMap F (AlgebraicClosure F) u) *
          w (algebraMap F (AlgebraicClosure F) u⁻¹) = 1 := by
        rw [← map_mul, ← map_mul, mul_inv_cancel₀ hu, map_one, map_one]
      apply le_antisymm h1
      calc (1 : NNReal) = _ := h3.symm
        _ ≤ _ := mul_le_of_le_one_right (zero_le _) h2
    refine ⟨w (algebraMap F (AlgebraicClosure F) π), pos_iff_ne_zero.mpr (hw0 π hπ0), ?_, ?_⟩
    · have hle : w (algebraMap F (AlgebraicClosure F) π) ≤ 1 :=
        (hw π).mpr ((av_le π hπ0).mpr (by rw [hπ1]; norm_num))
      refine lt_of_le_of_ne hle (fun heq => ?_)
      have hinv : w (algebraMap F (AlgebraicClosure F) π⁻¹) = 1 := by
        rw [map_inv₀, map_inv₀, heq, inv_one]
      have h := (av_le _ (inv_ne_zero hπ0)).mp ((hw _).mp hinv.le)
      rw [av_inv π hπ0, hπ1] at h
      norm_num at h
    · intro a ha
      obtain ⟨k, hk⟩ : ∃ k : ℤ, EllipticRootNumber.addVal F a = k := ⟨_, rfl⟩
      have hπk : π ^ k ≠ 0 := zpow_ne_zero _ hπ0
      have hu0 : a * (π ^ k)⁻¹ ≠ 0 := mul_ne_zero ha (inv_ne_zero hπk)
      have hu : EllipticRootNumber.addVal F (a * (π ^ k)⁻¹) = 0 := by
        rw [av_mul _ _ ha (inv_ne_zero hπk), av_inv _ hπk, av_zpow, hk]
        ring
      have hdecomp : a = (a * (π ^ k)⁻¹) * π ^ k := (inv_mul_cancel_right₀ hπk a).symm
      rw [hk]
      conv_lhs => rw [hdecomp]
      rw [map_mul, map_mul, hunit _ hu0 hu, one_mul, map_zpow₀, map_zpow₀]
  
  have s4 : ∀ w : Valuation (AlgebraicClosure F) NNReal,
      (∀ (σ : EllipticRootNumber.AbsGal F) α, w (σ α) = w α) → ∀ x : L,
      w (algebraMap F (AlgebraicClosure F) (Algebra.norm F x)) =
        w (x : AlgebraicClosure F) ^ Module.finrank F L := by
    intro w hw x
    have hint : IsIntegral F x := IsIntegral.of_finite F x
    have hsplit : ((minpoly F x).map (algebraMap F (AlgebraicClosure F))).Splits :=
      IsAlgClosed.splits _
    rw [Algebra.norm_eq_prod_roots (AlgebraicClosure F) hsplit, map_pow, map_multiset_prod]
    have hroots : ∀ β ∈ (minpoly F x).aroots (AlgebraicClosure F),
        w β = w (x : AlgebraicClosure F) := by
      intro β hβ
      rw [Polynomial.mem_aroots] at hβ
      have hmin : minpoly F x = minpoly F β :=
        minpoly.eq_of_irreducible_of_monic (minpoly.irreducible hint) hβ.2 (minpoly.monic hint)
      rw [IntermediateField.minpoly_eq] at hmin
      obtain ⟨σ, hσ⟩ := (Normal.minpoly_eq_iff_mem_orbit (AlgebraicClosure F)).mp hmin.symm
      rw [← hσ]
      exact hw σ _
    rw [Multiset.map_congr rfl hroots, Multiset.map_const', Multiset.prod_replicate,
      IsAlgClosed.card_aroots_eq_natDegree, ← pow_mul]
    congr 1
    rw [← IntermediateField.adjoin.finrank hint, Module.finrank_mul_finrank]
  
  have KEY : ∀ w : Valuation (AlgebraicClosure F) NNReal,
      (∀ a : F, w (algebraMap F _ a) ≤ 1 ↔ ValuativeRel.valuation F a ≤ 1) →
      (∀ (σ : EllipticRootNumber.AbsGal F) α, w (σ α) = w α) →
      ∃ r : NNReal, 0 < r ∧ r < 1 ∧ ∀ x : L, x ≠ 0 →
        w (x : AlgebraicClosure F) ^ Module.finrank F L = r ^ EllipticRootNumber.relVal F L x := by
    intro w hw hσ
    obtain ⟨r, hr0, hr1, hr⟩ := s5 w hw
    refine ⟨r, hr0, hr1, fun x hx => ?_⟩
    unfold EllipticRootNumber.relVal
    rw [← s4 w hσ x, hr _ (Algebra.norm_ne_zero_iff.mpr hx)]
  
  have rv_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → EllipticRootNumber.relVal F L (x * y) =
      EllipticRootNumber.relVal F L x + EllipticRootNumber.relVal F L y := by
    intro x y hx hy
    unfold EllipticRootNumber.relVal
    rw [map_mul, av_mul _ _ (Algebra.norm_ne_zero_iff.mpr hx) (Algebra.norm_ne_zero_iff.mpr hy)]
  have hn : 0 < Module.finrank F L := Module.finrank_pos
  have rv_pi : EllipticRootNumber.relVal F L (algebraMap F L π) = (Module.finrank F L : ℤ) := by
    unfold EllipticRootNumber.relVal
    rw [Algebra.norm_algebraMap, ← zpow_natCast, av_zpow]
  have hx0 : algebraMap F L π ≠ 0 := (map_ne_zero _).mpr hπ0
  
  have hmem := Nat.sInf_mem
    (s := {k : ℕ | 0 < k ∧ ∃ x : L, x ≠ 0 ∧ EllipticRootNumber.relVal F L x = k})
    ⟨Module.finrank F L, hn, _, hx0, rv_pi⟩
  obtain ⟨hfpos, x₁, hx₁, hx₁v⟩ : 0 < EllipticRootNumber.resDeg F L ∧ ∃ x : L, x ≠ 0 ∧
      EllipticRootNumber.relVal F L x = (EllipticRootNumber.resDeg F L : ℤ) := hmem
  have hmin : ∀ k : ℕ, 0 < k → (∃ x : L, x ≠ 0 ∧ EllipticRootNumber.relVal F L x = k) →
      EllipticRootNumber.resDeg F L ≤ k :=
    fun k hk hx => Nat.sInf_le ⟨hk, hx⟩
  have hf0 : (0 : ℤ) < (EllipticRootNumber.resDeg F L : ℤ) := by exact_mod_cast hfpos
  have rv_one : EllipticRootNumber.relVal F L 1 = 0 := by
    have h := rv_mul 1 1 one_ne_zero one_ne_zero
    rw [mul_one] at h
    omega
  have rv_inv : ∀ x : L, x ≠ 0 →
      EllipticRootNumber.relVal F L x⁻¹ = -EllipticRootNumber.relVal F L x := by
    intro x hx
    have h := rv_mul x x⁻¹ hx (inv_ne_zero hx)
    rw [mul_inv_cancel₀ hx, rv_one] at h
    omega
  have rv_zpow : ∀ q : ℤ, EllipticRootNumber.relVal F L (x₁ ^ q) =
      q * (EllipticRootNumber.resDeg F L : ℤ) := by
    intro q
    refine Int.induction_on q ?_ ?_ ?_
    · rw [zpow_zero, rv_one, zero_mul]
    · intro k ih
      rw [zpow_add_one₀ hx₁, rv_mul _ _ (zpow_ne_zero _ hx₁) hx₁, ih, hx₁v]
      ring
    · intro k ih
      rw [zpow_sub_one₀ hx₁, rv_mul _ _ (zpow_ne_zero _ hx₁) (inv_ne_zero hx₁), ih,
        rv_inv _ hx₁, hx₁v]
      ring
  have c2 : ∀ x : L, x ≠ 0 → EllipticRootNumber.relVal F L x =
      (EllipticRootNumber.resDeg F L : ℤ) * EllipticRootNumber.valL F L x := by
    intro x hx
    unfold EllipticRootNumber.valL
    obtain ⟨m, hm⟩ : ∃ m : ℤ, EllipticRootNumber.relVal F L x = m := ⟨_, rfl⟩
    rw [hm]
    have hρ0 : 0 ≤ m % (EllipticRootNumber.resDeg F L : ℤ) := Int.emod_nonneg m hf0.ne'
    have hρlt : m % (EllipticRootNumber.resDeg F L : ℤ) < (EllipticRootNumber.resDeg F L : ℤ) :=
      Int.emod_lt_of_pos m hf0
    have hsum := Int.emod_add_ediv m (EllipticRootNumber.resDeg F L : ℤ)
    have hq0 : x₁ ^ (m / (EllipticRootNumber.resDeg F L : ℤ)) ≠ 0 := zpow_ne_zero _ hx₁
    have hy0 : x * (x₁ ^ (m / (EllipticRootNumber.resDeg F L : ℤ)))⁻¹ ≠ 0 :=
      mul_ne_zero hx (inv_ne_zero hq0)
    have hyv : EllipticRootNumber.relVal F L
        (x * (x₁ ^ (m / (EllipticRootNumber.resDeg F L : ℤ)))⁻¹) =
          m % (EllipticRootNumber.resDeg F L : ℤ) := by
      rw [rv_mul _ _ hx (inv_ne_zero hq0), rv_inv _ hq0, rv_zpow, hm]
      linarith
    by_contra hne
    have hρpos : 0 < m % (EllipticRootNumber.resDeg F L : ℤ) := by
      rcases hρ0.lt_or_eq with h | h
      · exact h
      · exfalso
        apply hne
        rw [← h] at hsum
        linarith
    have hle := hmin (m % (EllipticRootNumber.resDeg F L : ℤ)).toNat (by omega)
      ⟨_, hy0, by rw [hyv, Int.toNat_of_nonneg hρ0]⟩
    have hle' : ((EllipticRootNumber.resDeg F L : ℕ) : ℤ) ≤
        (((m % (EllipticRootNumber.resDeg F L : ℤ)).toNat : ℕ) : ℤ) := by exact_mod_cast hle
    rw [Int.toNat_of_nonneg hρ0] at hle'
    linarith
  have c3 : ∀ x y : L, x ≠ 0 → y ≠ 0 →
      EllipticRootNumber.valL F L (x * y) =
        EllipticRootNumber.valL F L x + EllipticRootNumber.valL F L y := by
    intro x y hx hy
    have h := rv_mul x y hx hy
    rw [c2 _ (mul_ne_zero hx hy), c2 x hx, c2 y hy, ← mul_add] at h
    exact mul_left_cancel₀ hf0.ne' h
  have c5 : EllipticRootNumber.valL F L x₁ = 1 := by
    unfold EllipticRootNumber.valL
    rw [hx₁v, Int.ediv_self hf0.ne']
  
  
  have hWex : ∃ w : Valuation (AlgebraicClosure F) NNReal,
      (∀ a : F, w (algebraMap F (AlgebraicClosure F) a) ≤ 1 ↔ ValuativeRel.valuation F a ≤ 1) ∧
      ∀ (σ : EllipticRootNumber.AbsGal F) (α : AlgebraicClosure F), w (σ α) = w α := by
    have s2 : ∀ (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
        (L : Type u) [Field L] [Algebra K L] [Algebra.IsAlgebraic K L],
        ∃ w : Valuation L NNReal, (∀ a : K, ((w (algebraMap K L a) : NNReal) : ℝ) = ‖a‖) ∧
          ∀ (σ : L ≃ₐ[K] L) (x : L), w (σ x) = w x := by
      intro K _ _ _ L _ _ _
      refine ⟨{ toFun := fun x => ⟨spectralNorm K L x, spectralNorm_nonneg x⟩
                map_zero' := Subtype.ext spectralNorm_zero
                map_one' := Subtype.ext spectralNorm_one
                map_mul' := fun x y => Subtype.ext (by
                  show spectralNorm K L (x * y) = spectralNorm K L x * spectralNorm K L y
                  rw [← spectralMulAlgNorm_def, ← spectralMulAlgNorm_def, ← spectralMulAlgNorm_def]
                  exact map_mul (spectralMulAlgNorm K L) x y)
                map_add_le_max' := fun x y => by
                  show (⟨spectralNorm K L (x + y), spectralNorm_nonneg _⟩ : NNReal) ≤
                    max ⟨spectralNorm K L x, spectralNorm_nonneg _⟩
                      ⟨spectralNorm K L y, spectralNorm_nonneg _⟩
                  rw [← NNReal.coe_le_coe, NNReal.coe_max]
                  exact isNonarchimedean_spectralNorm x y }, ?_, ?_⟩
      · intro a
        exact spectralNorm_extends a
      · intro σ x
        exact Subtype.ext (spectralNorm_eq_of_equiv σ x).symm
    let φ : ValuativeRel.ValueGroupWithZero F →*₀ NNReal :=
      (WithZeroMulInt.toNNReal (two_ne_zero : (2 : NNReal) ≠ 0)).comp
        (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F :
          ValuativeRel.ValueGroupWithZero F →*₀ WithZero (Multiplicative ℤ))
    have hφ : StrictMono φ :=
      (WithZeroMulInt.toNNReal_strictMono (one_lt_two : (1 : NNReal) < 2)).comp
        (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).strictMono
    have s3 : ∀ (u : ℕ → F), (∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ m ≥ N, ∀ n ≥ N,
            ((φ (ValuativeRel.valuation F (u m - u n)) : NNReal) : ℝ) < ε) →
          ∃ a : F, ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ n ≥ N,
            ((φ (ValuativeRel.valuation F (u n - a)) : NNReal) : ℝ) < ε := by
      intro u hu
      letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
      haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
      haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
      have hpos : ∀ γ : (ValuativeRel.ValueGroupWithZero F)ˣ,
          (0 : ℝ) < ((φ (γ : ValuativeRel.ValueGroupWithZero F) : NNReal) : ℝ) := by
        intro γ
        have h : φ 0 < φ γ := hφ (zero_lt_iff.mpr γ.ne_zero)
        rw [map_zero] at h
        exact_mod_cast h
      have hc : CauchySeq u := by
        rw [cauchySeq_iff_tendsto, uniformity_eq_comap_nhds_zero F, Filter.tendsto_comap_iff]
        intro s hs
        obtain ⟨γ, hγ⟩ := (IsValuativeTopology.mem_nhds_zero_iff s).mp hs
        obtain ⟨N, hN⟩ := hu _ (hpos γ)
        rw [Filter.mem_map, Filter.mem_atTop_sets]
        refine ⟨(N, N), fun p hp => hγ ?_⟩
        have h := hN p.2 hp.2 p.1 hp.1
        show ValuativeRel.valuation F (u p.2 - u p.1) < γ
        exact hφ.lt_iff_lt.mp (by exact_mod_cast h)
      obtain ⟨a, ha⟩ := cauchySeq_tendsto_of_complete hc
      obtain ⟨γ₀, h0, h1⟩ := ValuativeRel.IsNontrivial.exists_lt_one (R := F)
      refine ⟨a, fun ε hε => ?_⟩
      have hq1 : ((φ γ₀ : NNReal) : ℝ) < 1 := by
        have h : φ γ₀ < φ 1 := hφ h1
        rw [map_one] at h
        exact_mod_cast h
      obtain ⟨k, hk⟩ := exists_pow_lt_of_lt_one hε hq1
      have hS : {z | ValuativeRel.valuation F (z - a) <
          ((Units.mk0 (γ₀ ^ k) (pow_ne_zero k h0.ne') : (ValuativeRel.ValueGroupWithZero F)ˣ) :
            ValuativeRel.ValueGroupWithZero F)} ∈ nhds a :=
        IsValuativeTopology.mem_nhds_iff'.mpr ⟨_, subset_rfl⟩
      obtain ⟨N, hN⟩ := Filter.mem_atTop_sets.mp (ha hS)
      refine ⟨N, fun n hn => ?_⟩
      have h := hN n hn
      simp only [Set.mem_preimage, Set.mem_setOf_eq, Units.val_mk0] at h
      have h2 : φ (ValuativeRel.valuation F (u n - a)) < φ γ₀ ^ k := by
        rw [← map_pow]; exact hφ h
      calc ((φ (ValuativeRel.valuation F (u n - a)) : NNReal) : ℝ) < ((φ γ₀ ^ k : NNReal) : ℝ) := by
            exact_mod_cast h2
        _ = ((φ γ₀ : NNReal) : ℝ) ^ k := NNReal.coe_pow _ _
        _ < ε := hk
    haveI hnt : (ValuativeRel.valuation F).IsNontrivial :=
      (ValuativeRel.isNontrivial_iff_isNontrivial (ValuativeRel.valuation F)).mp inferInstance
    letI VF : Valued F (ValuativeRel.ValueGroupWithZero F) := Valued.mk' (ValuativeRel.valuation F)
    letI R1 : (Valued.v : Valuation F (ValuativeRel.ValueGroupWithZero F)).RankOne :=
      @Valuation.RankOne.mk _ _ _ _ _ hnt φ hφ
    letI NF : NontriviallyNormedField F := Valued.toNontriviallyNormedField
    have hnorm : ∀ x : F, ‖x‖ = ((φ (ValuativeRel.valuation F x) : NNReal) : ℝ) := fun x => rfl
    haveI UM : IsUltrametricDist F := IsUltrametricDist.isUltrametricDist_of_isNonarchimedean_norm
      (fun x y => by
        rw [hnorm, hnorm, hnorm, ← NNReal.coe_max, NNReal.coe_le_coe, ← hφ.monotone.map_max]
        exact hφ.monotone (Valuation.map_add _ _ _))
    haveI CS : CompleteSpace F := by
      apply Metric.complete_of_cauchySeq_tendsto
      intro u hu
      rw [Metric.cauchySeq_iff] at hu
      obtain ⟨a, ha⟩ := s3 u (fun ε hε => by
        obtain ⟨N, hN⟩ := hu ε hε
        exact ⟨N, fun m hm n hn => by
          have := hN m hm n hn
          rwa [dist_eq_norm, hnorm] at this⟩)
      refine ⟨a, Metric.tendsto_atTop.mpr fun ε hε => ?_⟩
      obtain ⟨N, hN⟩ := ha ε hε
      exact ⟨N, fun n hn => by rw [dist_eq_norm, hnorm]; exact hN n hn⟩
    obtain ⟨w, hext, hinv⟩ := s2 F (AlgebraicClosure F)
    refine ⟨w, fun a => ?_, fun σ α => hinv σ α⟩
    rw [← NNReal.coe_le_one, hext a, hnorm, NNReal.coe_le_one, ← map_one φ, hφ.le_iff_le]
  obtain ⟨W, hW1, hW2⟩ := hWex
  obtain ⟨rW, hr0, hr1, hrW⟩ := KEY W hW1 hW2
  have hle : ∀ a b : L, a ≠ 0 → a + b ≠ 0 →
      W (b : AlgebraicClosure F) ≤ W (a : AlgebraicClosure F) →
      EllipticRootNumber.relVal F L a ≤ EllipticRootNumber.relVal F L (a + b) := by
    intro a b ha hab hba
    have h1 : W ((a + b : L) : AlgebraicClosure F) ≤ W (a : AlgebraicClosure F) := by
      show W ((a : AlgebraicClosure F) + (b : AlgebraicClosure F)) ≤ _
      exact (Valuation.map_add W _ _).trans (max_le le_rfl hba)
    have h2 : W ((a + b : L) : AlgebraicClosure F) ^ Module.finrank F L ≤
        W (a : AlgebraicClosure F) ^ Module.finrank F L := pow_le_pow_left₀ (zero_le _) h1 _
    rw [hrW _ hab, hrW _ ha] at h2
    exact (zpow_le_zpow_iff_right_of_lt_one₀ hr0 hr1).mp h2
  have c4 : ∀ x y : L, x ≠ 0 → y ≠ 0 → x + y ≠ 0 →
      min (EllipticRootNumber.valL F L x) (EllipticRootNumber.valL F L y) ≤
        EllipticRootNumber.valL F L (x + y) := by
    intro x y hx hy hxy
    have hmin_rv : min (EllipticRootNumber.relVal F L x) (EllipticRootNumber.relVal F L y) ≤
        EllipticRootNumber.relVal F L (x + y) := by
      rcases le_total (W (y : AlgebraicClosure F)) (W (x : AlgebraicClosure F)) with h | h
      · exact (min_le_left _ _).trans (hle x y hx hxy h)
      · have h' := hle y x hy (by rwa [add_comm]) h
        rw [add_comm] at h'
        exact (min_le_right _ _).trans h'
    rw [c2 x hx, c2 y hy, c2 _ hxy, ← mul_min_of_nonneg _ _ hf0.le] at hmin_rv
    exact le_of_mul_le_mul_left hmin_rv hf0
  exact ⟨hfpos, c2, c3, c4, ⟨x₁, c5⟩, KEY⟩

theorem tateEps_eq_of_valL_section (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] (χ : Lˣ →* (EllipticRootNumber.Ω F)ˣ)
    (ψ : AddChar L (EllipticRootNumber.Ω F)) (hψ : EllipticRootNumber.IsAdmissibleChar F L ψ)
    (hχ : ∃ a : ℕ, ∀ u ∈ EllipticRootNumber.unitGroup F L a, χ u = 1)
    (a : ℕ) (ha : EllipticRootNumber.condExp F L χ = a)
    (n : ℤ) (hn : EllipticRootNumber.condExpChar F L ψ = n)
    (c : Lˣ) (hc : EllipticRootNumber.valL F L (c : L) = (a : ℤ) + n)
    (s : Lˣ ⧸ EllipticRootNumber.unitGroup F L a → Lˣ)
    (hs : ∀ q, (QuotientGroup.mk (s q) : Lˣ ⧸ EllipticRootNumber.unitGroup F L a) = q) :
    EllipticRootNumber.tateEps F L χ ψ =
      (EllipticRootNumber.qL F L : EllipticRootNumber.Ω F) ^ n *
        if a = 0 then (χ c : EllipticRootNumber.Ω F)
        else ∑ᶠ (q : Lˣ ⧸ EllipticRootNumber.unitGroup F L a)
            (_ : EllipticRootNumber.valL F L ((s q : Lˣ) : L) = 0),
          ((χ (c⁻¹ * s q) : EllipticRootNumber.Ω F))⁻¹ * ψ ((c⁻¹ * s q : Lˣ) : L) :=
by
  classical
  obtain ⟨-, -, hmul, hultra, -, -⟩ := valL_spec F L
  have hv1 : EllipticRootNumber.valL F L 1 = 0 := by
    have h := hmul 1 1 one_ne_zero one_ne_zero
    rw [mul_one] at h
    omega
  have hvu : ∀ u w : Lˣ, EllipticRootNumber.valL F L ((u * w : Lˣ) : L) =
      EllipticRootNumber.valL F L (u : L) + EllipticRootNumber.valL F L (w : L) :=
    fun u w => by rw [Units.val_mul]; exact hmul _ _ u.ne_zero w.ne_zero
  have hvinv : ∀ u : Lˣ, EllipticRootNumber.valL F L ((u⁻¹ : Lˣ) : L) =
      -EllipticRootNumber.valL F L (u : L) := by
    intro u
    have h := hvu u u⁻¹
    rw [mul_inv_cancel, Units.val_one, hv1] at h
    omega
  have hvneg1 : EllipticRootNumber.valL F L (-1) = 0 := by
    have h := hmul (-1) (-1) (neg_ne_zero.mpr one_ne_zero) (neg_ne_zero.mpr one_ne_zero)
    rw [neg_one_mul, neg_neg, hv1] at h
    omega
  
  have hχa : ∀ u ∈ EllipticRootNumber.unitGroup F L a, χ u = 1 := by
    rw [← ha]
    exact Nat.sInf_mem (s := {a : ℕ | ∀ u ∈ EllipticRootNumber.unitGroup F L a, χ u = 1}) hχ
  
  have hψn : ∀ x : L, -n ≤ EllipticRootNumber.valL F L x → ψ x = 1 := by
    rw [← hn]
    obtain ⟨hne, d, hd⟩ := hψ
    obtain ⟨x₀, hx₀⟩ : ∃ x₀, ψ x₀ ≠ 1 := by
      by_contra hcon
      push_neg at hcon
      exact hne (by ext x; rw [hcon x, AddChar.one_apply])
    have hmem : EllipticRootNumber.condExpChar F L ψ ∈
        {d : ℤ | ∀ x : L, -d ≤ EllipticRootNumber.valL F L x → ψ x = 1} := by
      unfold EllipticRootNumber.condExpChar
      apply Int.csSup_mem
      · exact ⟨-d, fun x hx => hd x (by omega)⟩
      · refine ⟨-EllipticRootNumber.valL F L x₀, fun e he => ?_⟩
        have he' : ∀ x : L, -e ≤ EllipticRootNumber.valL F L x → ψ x = 1 := he
        by_contra hlt
        exact hx₀ (he' x₀ (by omega))
    exact hmem
  
  have ht : EllipticRootNumber.valL F L ((EllipticRootNumber.tateElt F L χ ψ : Lˣ) : L) =
      (a : ℤ) + n := by
    have h : EllipticRootNumber.valL F L ((EllipticRootNumber.tateElt F L χ ψ : Lˣ) : L) =
        (EllipticRootNumber.condExp F L χ : ℤ) + EllipticRootNumber.condExpChar F L ψ :=
      Classical.epsilon_spec (p := fun c : Lˣ => EllipticRootNumber.valL F L (c : L) =
        (EllipticRootNumber.condExp F L χ : ℤ) + EllipticRootNumber.condExpChar F L ψ)
        ⟨c, by rw [ha, hn]; exact hc⟩
    rw [ha, hn] at h
    exact h
  unfold EllipticRootNumber.tateEps
  rw [ha, hn]
  set t := EllipticRootNumber.tateElt F L χ ψ with ht_def
  have hε : EllipticRootNumber.valL F L ((t⁻¹ * c : Lˣ) : L) = 0 := by
    rw [hvu, hvinv, ht, hc]; ring
  have hcε : c = t * (t⁻¹ * c) := (mul_inv_cancel_left t c).symm
  by_cases h0 : a = 0
  · rw [if_pos h0, if_pos h0]
    have hεU : t⁻¹ * c ∈ EllipticRootNumber.unitGroup F L a := by
      apply Subgroup.subset_closure
      show (if a = 0 then _ else _)
      rw [if_pos h0]
      exact hε
    rw [hcε, map_mul, hχa _ hεU, mul_one]
  · rw [if_neg h0, if_neg h0]
    have ha1 : (1 : ℤ) ≤ a := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr h0
    obtain ⟨h, hh⟩ : ∃ h : Lˣ → Lˣ → EllipticRootNumber.Ω F, ∀ d u, h d u =
        ∑ᶠ (_ : EllipticRootNumber.valL F L ((u : Lˣ) : L) = 0),
          ((χ (d⁻¹ * u) : EllipticRootNumber.Ω F))⁻¹ * ψ ((d⁻¹ * u : Lˣ) : L) :=
      ⟨_, fun _ _ => rfl⟩
    
    have hinv : ∀ d : Lˣ, EllipticRootNumber.valL F L (d : L) = (a : ℤ) + n →
        ∀ g ∈ EllipticRootNumber.unitGroup F L a, ∀ u : Lˣ, h d (u * g) = h d u := by
      intro d hd g hg
      unfold EllipticRootNumber.unitGroup at hg
      induction hg using Subgroup.closure_induction with
      | mem g hgS =>
        intro u
        have hgU : g ∈ EllipticRootNumber.unitGroup F L a := Subgroup.subset_closure hgS
        have hgS' : (g : L) = 1 ∨ (a : ℤ) ≤ EllipticRootNumber.valL F L ((g : L) - 1) := by
          have h' := hgS
          simp only [Set.mem_setOf_eq, if_neg h0] at h'
          exact h'
        by_cases hg1 : (g : L) = 1
        · rw [show g = 1 from Units.ext hg1, mul_one]
        have hga : (a : ℤ) ≤ EllipticRootNumber.valL F L ((g : L) - 1) := hgS'.resolve_left hg1
        have hy0 : (g : L) - 1 ≠ 0 := sub_ne_zero.mpr hg1
        have hvg : EllipticRootNumber.valL F L (g : L) = 0 := by
          have e1 : (1 : L) + ((g : L) - 1) = g := by ring
          have e2 : (g : L) + -((g : L) - 1) = 1 := by ring
          have h1 := hultra 1 ((g : L) - 1) one_ne_zero hy0 (by rw [e1]; exact g.ne_zero)
          rw [e1, hv1] at h1
          have h2 := hultra (g : L) (-((g : L) - 1)) g.ne_zero (neg_ne_zero.mpr hy0)
            (by rw [e2]; exact one_ne_zero)
          rw [e2, hv1] at h2
          have h3 : EllipticRootNumber.valL F L (-((g : L) - 1)) =
              EllipticRootNumber.valL F L ((g : L) - 1) := by
            rw [neg_eq_neg_one_mul, hmul _ _ (neg_ne_zero.mpr one_ne_zero) hy0, hvneg1, zero_add]
          rw [h3] at h2
          simp only [min_le_iff] at h1 h2
          omega
        have hvug : EllipticRootNumber.valL F L ((u * g : Lˣ) : L) =
            EllipticRootNumber.valL F L (u : L) := by rw [hvu, hvg, add_zero]
        rw [hh, hh, finsum_eq_if, finsum_eq_if, hvug]
        by_cases hu : EllipticRootNumber.valL F L (u : L) = 0
        · rw [if_pos hu, if_pos hu]
          have e3 : d⁻¹ * (u * g) = (d⁻¹ * u) * g := (mul_assoc _ _ _).symm
          rw [e3, map_mul, hχa g hgU, mul_one]
          have e4 : ((d⁻¹ * u * g : Lˣ) : L) =
              ((d⁻¹ * u : Lˣ) : L) + ((d⁻¹ * u : Lˣ) : L) * ((g : L) - 1) := by
            rw [Units.val_mul]; ring
          have hvz : -n ≤ EllipticRootNumber.valL F L (((d⁻¹ * u : Lˣ) : L) * ((g : L) - 1)) := by
            rw [hmul _ _ (Units.ne_zero _) hy0, hvu, hvinv, hd, hu]
            omega
          rw [e4, AddChar.map_add_eq_mul, hψn _ hvz, mul_one]
        · rw [if_neg hu, if_neg hu]
      | one => intro u; rw [mul_one]
      | mul g₁ g₂ _ _ ih₁ ih₂ => intro u; rw [← mul_assoc, ih₂, ih₁]
      | inv g _ ih => intro u; rw [← ih (u * g⁻¹), inv_mul_cancel_right]
    have hcr : ∀ q : Lˣ ⧸ EllipticRootNumber.unitGroup F L a,
        (QuotientGroup.mk (EllipticRootNumber.cosetRep q) :
          Lˣ ⧸ EllipticRootNumber.unitGroup F L a) = q :=
      fun q => QuotientGroup.out_eq' q
    
    have hA : ∀ q, h c (s q) = h c (EllipticRootNumber.cosetRep q) := by
      intro q
      have hg : (EllipticRootNumber.cosetRep q)⁻¹ * s q ∈ EllipticRootNumber.unitGroup F L a :=
        QuotientGroup.eq.mp ((hcr q).trans (hs q).symm)
      have := hinv c hc _ hg (EllipticRootNumber.cosetRep q)
      rwa [mul_inv_cancel_left] at this
    
    have hB : ∀ u : Lˣ, h c u = h t ((t⁻¹ * c)⁻¹ * u) := by
      intro u
      have e1 : t⁻¹ * ((t⁻¹ * c)⁻¹ * u) = c⁻¹ * u := by
        rw [mul_inv_rev, inv_inv, mul_comm c⁻¹ t, mul_assoc, inv_mul_cancel_left]
      have e2 : EllipticRootNumber.valL F L (((t⁻¹ * c)⁻¹ * u : Lˣ) : L) =
          EllipticRootNumber.valL F L (u : L) := by
        rw [hvu, hvinv, hε, neg_zero, zero_add]
      rw [hh, hh, e1, e2]
    obtain ⟨m, hm⟩ : ∃ m : Lˣ ⧸ EllipticRootNumber.unitGroup F L a,
        m = (QuotientGroup.mk (t⁻¹ * c)⁻¹ : Lˣ ⧸ EllipticRootNumber.unitGroup F L a) :=
      ⟨_, rfl⟩
    
    have hC : ∀ q, h t ((t⁻¹ * c)⁻¹ * EllipticRootNumber.cosetRep q) =
        h t (EllipticRootNumber.cosetRep (m * q)) := by
      intro q
      have hg : ((t⁻¹ * c)⁻¹ * EllipticRootNumber.cosetRep q)⁻¹ *
          EllipticRootNumber.cosetRep (m * q) ∈ EllipticRootNumber.unitGroup F L a := by
        apply QuotientGroup.eq.mp
        rw [QuotientGroup.mk_mul, hcr, hcr, hm]
      have := hinv t ht _ hg ((t⁻¹ * c)⁻¹ * EllipticRootNumber.cosetRep q)
      rw [mul_inv_cancel_left] at this
      exact this.symm
    
    have hD : ∑ᶠ q, h t (EllipticRootNumber.cosetRep (m * q)) =
        ∑ᶠ q, h t (EllipticRootNumber.cosetRep q) :=
      finsum_comp_equiv (Equiv.mulLeft m) (f := fun q => h t (EllipticRootNumber.cosetRep q))
    have key : ∑ᶠ q, h c (s q) = ∑ᶠ (q : Lˣ ⧸ EllipticRootNumber.unitGroup F L a),
        h t (EllipticRootNumber.cosetRep q) := by
      rw [finsum_congr hA, finsum_congr (fun q => hB _), finsum_congr hC, hD]
    simp only [hh] at key
    rw [key]

theorem tateEps_transport {F₁ F₂ : Type u} [Field F₁] [Field F₂]
    [ValuativeRel F₁] [TopologicalSpace F₁] [IsNonarchimedeanLocalField F₁]
    [ValuativeRel F₂] [TopologicalSpace F₂] [IsNonarchimedeanLocalField F₂]
    (τb : AlgebraicClosure F₁ ≃+* AlgebraicClosure F₂)
    (L₁ : IntermediateField F₁ (AlgebraicClosure F₁))
    (L₂ : IntermediateField F₂ (AlgebraicClosure F₂))
    (hL : ∀ y, y ∈ L₂ ↔ τb.symm y ∈ L₁)
    [FiniteDimensional F₁ L₁] [FiniteDimensional F₂ L₂]
    (hq : EllipticRootNumber.qL F₂ L₂ = EllipticRootNumber.qL F₁ L₁)
    (hval : ∀ (x₁ : L₁) (x₂ : L₂), (x₂ : AlgebraicClosure F₂) = τb (x₁ : AlgebraicClosure F₁) →
      EllipticRootNumber.valL F₂ L₂ x₂ = EllipticRootNumber.valL F₁ L₁ x₁)
    (ι : EllipticRootNumber.Ω F₁ ≃+* EllipticRootNumber.Ω F₂)
    (χ₁ : L₁ˣ →* (EllipticRootNumber.Ω F₁)ˣ) (χ₂ : L₂ˣ →* (EllipticRootNumber.Ω F₂)ˣ)
    (hχ : ∀ (x₁ : L₁ˣ) (x₂ : L₂ˣ),
      ((x₂ : L₂) : AlgebraicClosure F₂) = τb ((x₁ : L₁) : AlgebraicClosure F₁) →
      ((χ₂ x₂ : (EllipticRootNumber.Ω F₂)ˣ) : EllipticRootNumber.Ω F₂) =
        ι (χ₁ x₁ : EllipticRootNumber.Ω F₁))
    (ψ₁ : AddChar L₁ (EllipticRootNumber.Ω F₁)) (ψ₂ : AddChar L₂ (EllipticRootNumber.Ω F₂))
    (hψ : ∀ (x₁ : L₁) (x₂ : L₂), (x₂ : AlgebraicClosure F₂) = τb (x₁ : AlgebraicClosure F₁) →
      ψ₂ x₂ = ι (ψ₁ x₁))
    (hψ₁ : EllipticRootNumber.IsAdmissibleChar F₁ L₁ ψ₁)
    (hcont : ∃ a : ℕ, ∀ u ∈ EllipticRootNumber.unitGroup F₁ L₁ a, χ₁ u = 1) :
    EllipticRootNumber.tateEps F₂ L₂ χ₂ ψ₂ = ι (EllipticRootNumber.tateEps F₁ L₁ χ₁ ψ₁) :=
by
  
  obtain ⟨r, hr⟩ : ∃ r : L₁ ≃+* L₂, ∀ x : L₁, ((r x : L₂) : AlgebraicClosure F₂) = τb x :=
    ⟨{ toFun := fun x => ⟨τb x, (hL _).mpr (by rw [RingEquiv.symm_apply_apply]; exact x.2)⟩
       invFun := fun y => ⟨τb.symm y, (hL y).mp y.2⟩
       left_inv := fun x => Subtype.ext (τb.symm_apply_apply _)
       right_inv := fun y => Subtype.ext (τb.apply_symm_apply _)
       map_mul' := fun a b => Subtype.ext (map_mul τb (a : AlgebraicClosure F₁) b)
       map_add' := fun a b => Subtype.ext (map_add τb (a : AlgebraicClosure F₁) b) },
     fun _ => rfl⟩
  obtain ⟨θ, hθ⟩ : ∃ θ : L₁ˣ ≃* L₂ˣ, ∀ u : L₁ˣ, ((θ u : L₂ˣ) : L₂) = r (u : L₁) :=
    ⟨Units.mapEquiv r.toMulEquiv, fun _ => rfl⟩
  have hv : ∀ x : L₁, EllipticRootNumber.valL F₂ L₂ (r x) = EllipticRootNumber.valL F₁ L₁ x :=
    fun x => hval x (r x) (hr x)
  have hvs : ∀ y : L₂,
      EllipticRootNumber.valL F₂ L₂ y = EllipticRootNumber.valL F₁ L₁ (r.symm y) := by
    intro y
    rw [← hv, RingEquiv.apply_symm_apply]
  have hχ' : ∀ u : L₁ˣ, ((χ₂ (θ u) : (EllipticRootNumber.Ω F₂)ˣ) : EllipticRootNumber.Ω F₂) =
      ι (χ₁ u : EllipticRootNumber.Ω F₁) :=
    fun u => hχ u (θ u) (by rw [hθ, hr])
  have hψ' : ∀ x : L₁, ψ₂ (r x) = ι (ψ₁ x) := fun x => hψ x (r x) (hr x)
  have hψs : ∀ y : L₂, ψ₂ y = ι (ψ₁ (r.symm y)) := by
    intro y
    rw [← hψ', RingEquiv.apply_symm_apply]
  
  have hψ₂ : EllipticRootNumber.IsAdmissibleChar F₂ L₂ ψ₂ := by
    obtain ⟨hne, d, hd⟩ := hψ₁
    refine ⟨fun h => hne ?_, d, fun y hy => ?_⟩
    · ext x
      apply ι.injective
      rw [← hψ', h]
      simp
    · rw [hψs, hd _ (by rw [← hvs]; exact hy), map_one]
  have hD : EllipticRootNumber.condExpChar F₂ L₂ ψ₂ =
      EllipticRootNumber.condExpChar F₁ L₁ ψ₁ := by
    unfold EllipticRootNumber.condExpChar
    congr 1
    ext d
    simp only [Set.mem_setOf_eq]
    constructor
    · intro h x hx
      apply ι.injective
      rw [← hψ', map_one]
      exact h (r x) (by rw [hv]; exact hx)
    · intro h y hy
      rw [hψs, h _ (by rw [← hvs]; exact hy), map_one]
  have hU : ∀ a : ℕ, Subgroup.map (θ : L₁ˣ →* L₂ˣ) (EllipticRootNumber.unitGroup F₁ L₁ a) =
      EllipticRootNumber.unitGroup F₂ L₂ a := by
    intro a
    have mem : ∀ u : L₁ˣ,
        (θ u ∈ {u : L₂ˣ | if a = 0 then EllipticRootNumber.valL F₂ L₂ (u : L₂) = 0
          else ((u : L₂) = 1 ∨ (a : ℤ) ≤ EllipticRootNumber.valL F₂ L₂ ((u : L₂) - 1))}) ↔
        (u ∈ {u : L₁ˣ | if a = 0 then EllipticRootNumber.valL F₁ L₁ (u : L₁) = 0
          else ((u : L₁) = 1 ∨ (a : ℤ) ≤ EllipticRootNumber.valL F₁ L₁ ((u : L₁) - 1))}) := by
      intro u
      simp only [Set.mem_setOf_eq]
      have e2 : r (u : L₁) - 1 = r ((u : L₁) - 1) := by rw [map_sub, map_one]
      have e3 : r (u : L₁) = 1 ↔ (u : L₁) = 1 := by
        rw [← map_one r]
        exact r.injective.eq_iff
      rw [hθ, e2, hv, hv, e3]
    unfold EllipticRootNumber.unitGroup
    rw [MonoidHom.map_closure]
    congr 1
    ext u₂
    constructor
    · rintro ⟨u, hu, rfl⟩
      exact (mem u).mpr hu
    · intro hu₂
      refine ⟨θ.symm u₂, (mem _).mp ?_, θ.apply_symm_apply u₂⟩
      rw [MulEquiv.apply_symm_apply]
      exact hu₂
  have hT : ∀ a : ℕ, (∀ u ∈ EllipticRootNumber.unitGroup F₂ L₂ a, χ₂ u = 1) ↔
      (∀ u ∈ EllipticRootNumber.unitGroup F₁ L₁ a, χ₁ u = 1) := by
    intro a
    constructor
    · intro h u hu
      have hm : (θ : L₁ˣ →* L₂ˣ) u ∈ EllipticRootNumber.unitGroup F₂ L₂ a := by
        rw [← hU a]
        exact Subgroup.mem_map_of_mem _ hu
      have h1 := congrArg Units.val (h _ hm)
      apply Units.ext
      apply ι.injective
      rw [← hχ' u, Units.val_one, map_one]
      exact h1.trans Units.val_one
    · intro h u₂ hu₂
      rw [← hU a] at hu₂
      obtain ⟨u, hu, rfl⟩ := hu₂
      apply Units.ext
      have h1 := hχ' u
      rw [h u hu, Units.val_one, map_one] at h1
      rw [Units.val_one]
      exact h1
  have hE : EllipticRootNumber.condExp F₂ L₂ χ₂ = EllipticRootNumber.condExp F₁ L₁ χ₁ := by
    unfold EllipticRootNumber.condExp
    congr 1
    ext a
    exact hT a
  have hcont₂ : ∃ a : ℕ, ∀ u ∈ EllipticRootNumber.unitGroup F₂ L₂ a, χ₂ u = 1 := by
    obtain ⟨a, ha⟩ := hcont
    exact ⟨a, (hT a).mpr ha⟩
  obtain ⟨a₀, ha₀⟩ : ∃ a : ℕ, EllipticRootNumber.condExp F₁ L₁ χ₁ = a := ⟨_, rfl⟩
  obtain ⟨n, hn⟩ : ∃ m : ℤ, EllipticRootNumber.condExpChar F₁ L₁ ψ₁ = m := ⟨_, rfl⟩
  
  obtain ⟨c₁, hc₁⟩ : ∃ c : L₁ˣ, EllipticRootNumber.valL F₁ L₁ (c : L₁) = (a₀ : ℤ) + n := by
    obtain ⟨-, -, hmul, -, ⟨x, hx⟩, -⟩ := valL_spec F₁ L₁
    have hv1 : EllipticRootNumber.valL F₁ L₁ 1 = 0 := by
      have h := hmul 1 1 one_ne_zero one_ne_zero
      rw [mul_one] at h
      omega
    have hx0 : x ≠ 0 := by
      rintro rfl
      have h0 : EllipticRootNumber.valL F₁ L₁ 0 = 0 := by
        unfold EllipticRootNumber.valL EllipticRootNumber.relVal
        rw [Algebra.norm_zero]
        unfold EllipticRootNumber.addVal
        rw [dif_pos rfl, Int.zero_ediv]
      omega
    have hvu : ∀ u w : L₁ˣ, EllipticRootNumber.valL F₁ L₁ ((u * w : L₁ˣ) : L₁) =
        EllipticRootNumber.valL F₁ L₁ (u : L₁) + EllipticRootNumber.valL F₁ L₁ (w : L₁) :=
      fun u w => by rw [Units.val_mul]; exact hmul _ _ u.ne_zero w.ne_zero
    have hvinv : ∀ u : L₁ˣ, EllipticRootNumber.valL F₁ L₁ ((u⁻¹ : L₁ˣ) : L₁) =
        -EllipticRootNumber.valL F₁ L₁ (u : L₁) := by
      intro u
      have h := hvu u u⁻¹
      rw [mul_inv_cancel, Units.val_one, hv1] at h
      omega
    have hX : EllipticRootNumber.valL F₁ L₁ ((Units.mk0 x hx0 : L₁ˣ) : L₁) = 1 := by
      rw [Units.val_mk0]
      exact hx
    have hpow : ∀ m : ℤ,
        EllipticRootNumber.valL F₁ L₁ (((Units.mk0 x hx0) ^ m : L₁ˣ) : L₁) = m := by
      intro m
      refine Int.induction_on m ?_ ?_ ?_
      · rw [zpow_zero, Units.val_one, hv1]
      · intro k ih
        rw [zpow_add_one, hvu, ih, hX]
      · intro k ih
        rw [zpow_sub_one, hvu, ih, hvinv, hX]
        ring
    exact ⟨_, hpow _⟩
  have hc₂ : EllipticRootNumber.valL F₂ L₂ ((θ c₁ : L₂ˣ) : L₂) = (a₀ : ℤ) + n := by
    rw [hθ, hv, hc₁]
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : (L₁ˣ ⧸ EllipticRootNumber.unitGroup F₁ L₁ a₀) ≃*
      (L₂ˣ ⧸ EllipticRootNumber.unitGroup F₂ L₂ a₀),
      ∀ u : L₁ˣ, Θ (QuotientGroup.mk u) = QuotientGroup.mk (θ u) :=
    ⟨QuotientGroup.congr _ _ θ (hU a₀), fun u => QuotientGroup.congr_mk _ _ θ (hU a₀) u⟩
  let s₁ : L₁ˣ ⧸ EllipticRootNumber.unitGroup F₁ L₁ a₀ → L₁ˣ := fun q => Quotient.out q
  have hs₁ : ∀ q,
      (QuotientGroup.mk (s₁ q) : L₁ˣ ⧸ EllipticRootNumber.unitGroup F₁ L₁ a₀) = q :=
    fun q => QuotientGroup.out_eq' q
  let s₂ : L₂ˣ ⧸ EllipticRootNumber.unitGroup F₂ L₂ a₀ → L₂ˣ := fun q => θ (s₁ (Θ.symm q))
  have hs₂ : ∀ q,
      (QuotientGroup.mk (s₂ q) : L₂ˣ ⧸ EllipticRootNumber.unitGroup F₂ L₂ a₀) = q := by
    intro q
    show (QuotientGroup.mk (θ (s₁ (Θ.symm q))) : L₂ˣ ⧸ _) = q
    rw [← hΘ, hs₁, MulEquiv.apply_symm_apply]
  have E1 := tateEps_eq_of_valL_section F₁ L₁ χ₁ ψ₁ hψ₁ hcont a₀ ha₀ n hn c₁ hc₁ s₁ hs₁
  have E2 := tateEps_eq_of_valL_section F₂ L₂ χ₂ ψ₂ hψ₂ hcont₂ a₀ (hE.trans ha₀) n
    (hD.trans hn) (θ c₁) hc₂ s₂ hs₂
  
  rw [E1, E2, map_mul, map_zpow₀, map_natCast, hq]
  congr 1
  by_cases ha : a₀ = 0
  · rw [if_pos ha, if_pos ha]
    exact hχ' c₁
  · rw [if_neg ha, if_neg ha]
    have step : ∀ q : L₁ˣ ⧸ EllipticRootNumber.unitGroup F₁ L₁ a₀,
        (∑ᶠ (_ : EllipticRootNumber.valL F₂ L₂ ((s₂ (Θ q) : L₂ˣ) : L₂) = 0),
          ((χ₂ ((θ c₁)⁻¹ * s₂ (Θ q)) : EllipticRootNumber.Ω F₂))⁻¹ *
            ψ₂ (((θ c₁)⁻¹ * s₂ (Θ q) : L₂ˣ) : L₂)) =
        ι (∑ᶠ (_ : EllipticRootNumber.valL F₁ L₁ ((s₁ q : L₁ˣ) : L₁) = 0),
          ((χ₁ (c₁⁻¹ * s₁ q) : EllipticRootNumber.Ω F₁))⁻¹ *
            ψ₁ ((c₁⁻¹ * s₁ q : L₁ˣ) : L₁)) := by
      intro q
      have hs : s₂ (Θ q) = θ (s₁ q) := by
        show θ (s₁ (Θ.symm (Θ q))) = θ (s₁ q)
        rw [MulEquiv.symm_apply_apply]
      have e : (θ c₁)⁻¹ * θ (s₁ q) = θ (c₁⁻¹ * s₁ q) := by rw [map_mul, map_inv]
      rw [hs, e, finsum_eq_if, finsum_eq_if, hθ (s₁ q), hv]
      split_ifs with h
      · rw [map_mul ι, map_inv₀ ι, hχ', hθ (c₁⁻¹ * s₁ q), hψ']
      · exact (map_zero ι).symm
    have h1 := finsum_comp_equiv Θ.toEquiv
      (f := fun q₂ : L₂ˣ ⧸ EllipticRootNumber.unitGroup F₂ L₂ a₀ =>
        ∑ᶠ (_ : EllipticRootNumber.valL F₂ L₂ ((s₂ q₂ : L₂ˣ) : L₂) = 0),
          ((χ₂ ((θ c₁)⁻¹ * s₂ q₂) : EllipticRootNumber.Ω F₂))⁻¹ *
            ψ₂ (((θ c₁)⁻¹ * s₂ q₂ : L₂ˣ) : L₂))
    have h3 := AddMonoidHom.map_finsum_of_injective ι.toRingHom.toAddMonoidHom ι.injective
      (fun q : L₁ˣ ⧸ EllipticRootNumber.unitGroup F₁ L₁ a₀ =>
        ∑ᶠ (_ : EllipticRootNumber.valL F₁ L₁ ((s₁ q : L₁ˣ) : L₁) = 0),
          ((χ₁ (c₁⁻¹ * s₁ q) : EllipticRootNumber.Ω F₁))⁻¹ * ψ₁ ((c₁⁻¹ * s₁ q : L₁ˣ) : L₁))
    exact h1.symm.trans ((finsum_congr step).trans h3.symm)

theorem weilGroup_restrict_surj (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (Φ : EllipticRootNumber.AbsGal F)
    (hΦ : EllipticRootNumber.ActsAsFrobPow F Φ 1)
    (N : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F N] [Normal F N]
    (σ : EllipticRootNumber.AbsGal F) :
    ∃ w ∈ EllipticRootNumber.weilGroup F, ∀ x ∈ N, w x = σ x :=
by
  classical
  
  
  
  have s3 : ∀ (w : Valuation (AlgebraicClosure F) NNReal)
      (hw₁ : ∀ a : F, w (algebraMap F (AlgebraicClosure F) a) ≤ 1 ↔
        ValuativeRel.valuation F a ≤ 1)
      (m : ℕ) (hm : 0 < m)
      (hmp : ¬ ringChar (IsLocalRing.ResidueField (ValuativeRel.valuation F).integer) ∣ m)
      (ζ ζ' : AlgebraicClosure F) (hζ : ζ ^ m = 1) (hζ' : ζ' ^ m = 1)
      (h : w (ζ - ζ') < 1), ζ = ζ' := by
    intro w hw₁ m hm hmp ζ ζ' hζ hζ' h
    have hvm : ValuativeRel.valuation F (m : F) = 1 := by
      have hint : ((m : (ValuativeRel.valuation F).integer) : F) = (m : F) := by simp
      by_contra hne
      have hnu : ¬ IsUnit (m : (ValuativeRel.valuation F).integer) := by
        rw [(Valuation.integer.integers (ValuativeRel.valuation F)).isUnit_iff_valuation_eq_one,
          map_natCast]
        exact hne
      have hmax : (m : (ValuativeRel.valuation F).integer) ∈
          IsLocalRing.maximalIdeal (ValuativeRel.valuation F).integer := hnu
      have hres : IsLocalRing.residue (ValuativeRel.valuation F).integer
          (m : (ValuativeRel.valuation F).integer) = 0 :=
        (IsLocalRing.residue_eq_zero_iff _).mpr hmax
      rw [map_natCast] at hres
      exact hmp ((ringChar.spec _ m).mp hres)
    have hm0 : (m : F) ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hvm
      exact zero_ne_one hvm
    have hwm : w (m : AlgebraicClosure F) = 1 := by
      have h1 : w (algebraMap F (AlgebraicClosure F) (m : F)) ≤ 1 := (hw₁ _).mpr hvm.le
      have h2 : w (algebraMap F (AlgebraicClosure F) (m : F)⁻¹) ≤ 1 :=
        (hw₁ _).mpr (by rw [map_inv₀, hvm, inv_one])
      have h3 : w (algebraMap F (AlgebraicClosure F) (m : F)) *
          w (algebraMap F (AlgebraicClosure F) (m : F)⁻¹) = 1 := by
        rw [← map_mul, ← map_mul, mul_inv_cancel₀ hm0, map_one, map_one]
      rw [map_natCast] at h1 h3
      refine le_antisymm h1 (not_lt.mp fun hlt => ?_)
      have h4 : w (m : AlgebraicClosure F) *
          w (algebraMap F (AlgebraicClosure F) (m : F)⁻¹) < 1 :=
        lt_of_le_of_lt (mul_le_of_le_one_right (zero_le _) h2) hlt
      rw [h3] at h4
      exact lt_irrefl _ h4
    have hunit : ∀ η : AlgebraicClosure F, η ^ m = 1 → w η = 1 := by
      intro η hη
      have h1 : w η ^ m = 1 := by rw [← map_pow, hη, map_one]
      exact (pow_eq_one_iff_of_nonneg (zero_le _) hm.ne').mp h1
    by_contra hne
    have hζ0 : ζ ≠ 0 := by
      rintro rfl
      rw [zero_pow hm.ne'] at hζ
      exact zero_ne_one hζ
    set u := ζ' * ζ⁻¹ with hu
    have hum : u ^ m = 1 := by rw [hu, mul_pow, inv_pow, hζ, hζ', inv_one, mul_one]
    have hu1 : u ≠ 1 := by
      intro h1
      apply hne
      rw [hu] at h1
      exact ((mul_inv_eq_one₀ hζ0).mp h1).symm
    have hsum : ∑ i ∈ Finset.range m, u ^ i = 0 := by
      have h1 := geom_sum_mul u m
      rw [hum, sub_self] at h1
      exact (mul_eq_zero.mp h1).resolve_right (sub_ne_zero.mpr hu1)
    have hmR : (m : AlgebraicClosure F) =
        (∑ i ∈ Finset.range m, ∑ l ∈ Finset.range i, u ^ l) * (1 - u) := by
      rw [Finset.sum_mul]
      simp_rw [geom_sum_mul_neg]
      rw [Finset.sum_sub_distrib, hsum]
      simp
    have hR : w (∑ i ∈ Finset.range m, ∑ l ∈ Finset.range i, u ^ l) ≤ 1 :=
      Valuation.map_sum_le _ (fun i _ => Valuation.map_sum_le _ (fun l _ => by
        rw [map_pow, hunit u hum, one_pow]))
    have h1u : 1 ≤ w (1 - u) := by
      have h1 := congrArg w hmR
      rw [hwm, map_mul] at h1
      calc (1 : NNReal) = _ := h1
        _ ≤ 1 * w (1 - u) := mul_le_mul_of_nonneg_right hR (zero_le _)
        _ = w (1 - u) := one_mul _
    have hζu : ζ * (ζ' * ζ⁻¹) = ζ' := by
      rw [mul_comm ζ', ← mul_assoc, mul_inv_cancel₀ hζ0, one_mul]
    have hdiff : ζ - ζ' = ζ * (1 - u) := by rw [hu, mul_sub, mul_one, hζu]
    rw [hdiff, map_mul, hunit ζ hζ, one_mul] at h
    exact absurd h (not_lt.mpr h1u)
  
  
  
  
  
  have s45 : ∀ (w : Valuation (AlgebraicClosure F) NNReal)
      (hw₁ : ∀ a : F, w (algebraMap F (AlgebraicClosure F) a) ≤ 1 ↔
        ValuativeRel.valuation F a ≤ 1),
      (∀ c : AlgebraicClosure F, w c ≤ 1 →
        w (c ^ Nat.card (IsLocalRing.ResidueField (ValuativeRel.valuation F).integer) - c) < 1 →
        ∃ a : F, w (c - algebraMap F (AlgebraicClosure F) a) < 1) ∧
      (∀ (f : ℕ) (z : ℕ → AlgebraicClosure F), (∀ j, w (z j) ≤ 1) →
        (∀ j, z (j + 1) =
          z j ^ Nat.card (IsLocalRing.ResidueField (ValuativeRel.valuation F).integer)) →
        z f = z 0 → ∀ i : ℕ,
          w ((∏ j ∈ Finset.range f, (Polynomial.X - Polynomial.C (z j))).coeff i) ≤ 1 ∧
          w (((∏ j ∈ Finset.range f, (Polynomial.X - Polynomial.C (z j))).coeff i) ^
                Nat.card (IsLocalRing.ResidueField (ValuativeRel.valuation F).integer) -
              (∏ j ∈ Finset.range f, (Polynomial.X - Polynomial.C (z j))).coeff i) < 1) := by
    intro w hw₁
    set k := IsLocalRing.ResidueField (ValuativeRel.valuation F).integer with hk
    set q := Nat.card k with hq
    set A := w.valuationSubring with hA
    have hiff : ∀ a : F, w (algebraMap F (AlgebraicClosure F) a) < 1 ↔
        ValuativeRel.valuation F a < 1 := by
      intro a
      by_cases ha0 : a = 0
      · simp [ha0]
      have hι0 : algebraMap F (AlgebraicClosure F) a ≠ 0 := (map_ne_zero _).mpr ha0
      rw [Valuation.val_lt_one_iff _ hι0, Valuation.val_lt_one_iff _ ha0,
        ← map_inv₀ (algebraMap F (AlgebraicClosure F)) a, lt_iff_not_ge, lt_iff_not_ge, hw₁]
    have hV : ∀ x : A, IsLocalRing.residue A x = 0 ↔ w (x : AlgebraicClosure F) < 1 := by
      intro x
      rw [IsLocalRing.residue_eq_zero_iff, ValuationSubring.valuation_lt_one_iff]
      have h := (Valuation.isEquiv_valuation_valuationSubring w).lt_iff_lt
        (x := (x : AlgebraicClosure F)) (y := 1)
      rw [map_one, map_one] at h
      exact h.symm
    let j : (ValuativeRel.valuation F).integer →+* A :=
      (algebraMap F (AlgebraicClosure F)).restrict (ValuativeRel.valuation F).integer A
        (fun x hx => (Valuation.mem_valuationSubring_iff w _).mpr ((hw₁ x).mpr hx))
    have hj : ∀ x, ((j x : A) : AlgebraicClosure F) = algebraMap F (AlgebraicClosure F) x :=
      fun _ => rfl
    haveI : IsLocalHom j := ⟨fun a ha => by
      have h1 : ¬ w (algebraMap F (AlgebraicClosure F) a) < 1 := by
        intro hlt
        have h2 : IsLocalRing.residue A (j a) = 0 := (hV _).mpr hlt
        rw [IsLocalRing.residue_eq_zero_iff] at h2
        exact (IsLocalRing.mem_maximalIdeal _).mp h2 ha
      rw [hiff] at h1
      rw [(Valuation.integer.integers _).isUnit_iff_valuation_eq_one]
      exact le_antisymm a.2 (not_lt.mp h1)⟩
    let ψ : k →+* IsLocalRing.ResidueField A := IsLocalRing.ResidueField.map j
    haveI : Fintype k := Fintype.ofFinite k
    have hqcard : q = Fintype.card k := Nat.card_eq_fintype_card
    have hq1 : 1 < q := by rw [hqcard]; exact Fintype.one_lt_card
    have hψ : ∀ t : k, (ψ t) ^ q = ψ t := fun t => by
      rw [← map_pow, hqcard, FiniteField.pow_card]
    refine ⟨?_, ?_⟩
    · intro c hc hcq
      set cA : A := ⟨c, (Valuation.mem_valuationSubring_iff w c).mpr hc⟩ with hcA
      have hR0 : (Polynomial.X ^ q - Polynomial.X : Polynomial (IsLocalRing.ResidueField A)) ≠ 0 :=
        FiniteField.X_pow_card_sub_X_ne_zero _ hq1
      have hroot : ∀ y : IsLocalRing.ResidueField A, y ^ q = y →
          y ∈ (Polynomial.X ^ q - Polynomial.X : Polynomial (IsLocalRing.ResidueField A)).roots :=
        fun y hy => (Polynomial.mem_roots hR0).mpr (by simp [Polynomial.IsRoot, hy])
      have hcbar : (IsLocalRing.residue A cA) ^ q = IsLocalRing.residue A cA := by
        have h1 : IsLocalRing.residue A (cA ^ q - cA) = 0 := (hV _).mpr (by simpa [hcA] using hcq)
        rw [map_sub, map_pow, sub_eq_zero] at h1
        exact h1
      by_cases hmem : IsLocalRing.residue A cA ∈ Set.range ψ
      · obtain ⟨t, ht⟩ := hmem
        obtain ⟨a₀, rfl⟩ := IsLocalRing.residue_surjective t
        refine ⟨(a₀ : F), ?_⟩
        have h1 : IsLocalRing.residue A (cA - j a₀) = 0 := by
          rw [map_sub, ← ht, IsLocalRing.ResidueField.map_residue, sub_self]
        have h2 := (hV _).mp h1
        simpa [hcA, hj] using h2
      · exfalso
        have hS : (insert (IsLocalRing.residue A cA) (Finset.univ.image ψ)).card = q + 1 := by
          rw [Finset.card_insert_of_notMem (by simpa using hmem),
            Finset.card_image_of_injective _ ψ.injective, Finset.card_univ, hqcard]
        have hSsub : insert (IsLocalRing.residue A cA) (Finset.univ.image ψ) ⊆
            (Polynomial.X ^ q - Polynomial.X :
              Polynomial (IsLocalRing.ResidueField A)).roots.toFinset := by
          intro y hy
          rw [Multiset.mem_toFinset]
          rcases Finset.mem_insert.mp hy with rfl | hy
          · exact hroot _ hcbar
          · obtain ⟨t, -, rfl⟩ := Finset.mem_image.mp hy
            exact hroot _ (hψ t)
        have h1 := (Finset.card_le_card hSsub).trans
          ((Multiset.toFinset_card_le _).trans (Polynomial.card_roots' _))
        rw [hS, FiniteField.X_pow_card_sub_X_natDegree_eq _ hq1] at h1
        omega
    · intro f z hz hzq hper i
      haveI := ringChar.charP k
      have hp : (ringChar k).Prime := CharP.char_is_prime k _
      have hpκ : ((ringChar k : ℕ) : IsLocalRing.ResidueField A) = 0 := by
        rw [← map_natCast ψ, ringChar.Nat.cast_ringChar, map_zero]
      haveI : CharP (IsLocalRing.ResidueField A) (ringChar k) :=
        (CharP.charP_iff_prime_eq_zero hp).mpr hpκ
      haveI : ExpChar (IsLocalRing.ResidueField A) (ringChar k) := ExpChar.prime hp
      obtain ⟨r, -, hcard⟩ := FiniteField.card k (ringChar k)
      have hqr : q = ringChar k ^ (r : ℕ) := hqcard.trans hcard
      let φ := iterateFrobenius (IsLocalRing.ResidueField A) (ringChar k) r
      have hφ : ∀ x, φ x = x ^ q := fun x => by
        rw [iterateFrobenius_def, hqr]
      let zA : ℕ → A := fun j => ⟨z j, (Valuation.mem_valuationSubring_iff w _).mpr (hz j)⟩
      let PA : Polynomial A := ∏ j ∈ Finset.range f, (Polynomial.X - Polynomial.C (zA j))
      have hPmap : PA.map (algebraMap A (AlgebraicClosure F)) =
          ∏ j ∈ Finset.range f, (Polynomial.X - Polynomial.C (z j)) := by
        simp only [PA, Polynomial.map_prod, Polynomial.map_sub, Polynomial.map_X,
          Polynomial.map_C]
        rfl
      have hcoe : ∀ i, ((PA.coeff i : A) : AlgebraicClosure F) =
          (∏ j ∈ Finset.range f, (Polynomial.X - Polynomial.C (z j))).coeff i := fun i => by
        rw [← hPmap, Polynomial.coeff_map]
        rfl
      refine ⟨?_, ?_⟩
      · rw [← hcoe]
        exact (Valuation.mem_valuationSubring_iff w _).mp (PA.coeff i).2
      · have hzq' : ∀ j, zA (j + 1) = zA j ^ q := fun j => Subtype.ext (by
          show z (j + 1) = z j ^ q
          exact hzq j)
        set g : ℕ → Polynomial (IsLocalRing.ResidueField A) := fun j =>
          Polynomial.X - Polynomial.C (IsLocalRing.residue A (zA j)) with hg
        have hPb : PA.map (IsLocalRing.residue A) = ∏ j ∈ Finset.range f, g j := by
          simp only [PA, hg, Polynomial.map_prod, Polynomial.map_sub, Polynomial.map_X,
            Polynomial.map_C]
        have hzf : zA f = zA 0 := Subtype.ext hper
        have hgf : g f = g 0 := by
          simp only [hg, hzf]
        have hPbφ : (PA.map (IsLocalRing.residue A)).map φ =
            PA.map (IsLocalRing.residue A) := by
          rw [hPb, Polynomial.map_prod]
          have h1 : ∀ j, (g j).map φ = g (j + 1) := by
            intro j
            simp only [hg, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, hφ, hzq',
              map_pow]
          simp only [h1]
          rcases f with _ | n
          · simp
          · rw [Finset.prod_range_succ, Finset.prod_range_succ' g, hgf]
        have h2 := congrArg (fun P => Polynomial.coeff P i) hPbφ
        simp only [Polynomial.coeff_map, hφ] at h2
        have h3 : IsLocalRing.residue A (PA.coeff i ^ q - PA.coeff i) = 0 := by
          rw [map_sub, map_pow, h2, sub_self]
        have h4 := (hV _).mp h3
        rw [← hcoe]
        simpa using h4
  
  
  
  
  have s6 : ∀ (q : ℕ) (Φ σ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F)
      (w : Valuation (AlgebraicClosure F) NNReal)
      (hw₂ : ∀ (σ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) (α : AlgebraicClosure F),
        w (σ α) = w α)
      (m : ℕ) (hm : 0 < m)
      (hΦm : ∀ ζ : AlgebraicClosure F, ζ ^ m = 1 → Φ ζ = ζ ^ q)
      (hdist : ∀ ζ ζ' : AlgebraicClosure F, ζ ^ m = 1 → ζ' ^ m = 1 → w (ζ - ζ') < 1 → ζ = ζ')
      (hfix : ∀ c : AlgebraicClosure F, w c ≤ 1 → w (c ^ q - c) < 1 →
        ∃ a : F, w (c - algebraMap F (AlgebraicClosure F) a) < 1)
      (hsym : ∀ (f : ℕ) (z : ℕ → AlgebraicClosure F), (∀ j, w (z j) ≤ 1) →
        (∀ j, z (j + 1) = z j ^ q) → z f = z 0 → ∀ i : ℕ,
          w ((∏ j ∈ Finset.range f, (Polynomial.X - Polynomial.C (z j))).coeff i) ≤ 1 ∧
          w (((∏ j ∈ Finset.range f, (Polynomial.X - Polynomial.C (z j))).coeff i) ^ q -
              (∏ j ∈ Finset.range f, (Polynomial.X - Polynomial.C (z j))).coeff i) < 1),
      ∃ k : ℕ, ∀ ζ : AlgebraicClosure F, ζ ^ m = 1 → σ ζ = (Φ ^ k) ζ := by
    intro q Φ σ w hw₂ m hm hΦm hdist hfix hsym
    have hunit : ∀ η : AlgebraicClosure F, η ^ m = 1 → w η = 1 := by
      intro η hη
      have h1 : w η ^ m = 1 := by rw [← map_pow, hη, map_one]
      exact (pow_eq_one_iff_of_nonneg (zero_le _) hm.ne').mp h1
    haveI : NeZero m := ⟨hm.ne'⟩
    obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := rootsOfUnity m (AlgebraicClosure F))
    set ζ₀ : AlgebraicClosure F := (((g : (AlgebraicClosure F)ˣ)) : AlgebraicClosure F) with hζ₀
    have hζ₀m : ζ₀ ^ m = 1 := by
      rw [hζ₀, ← Units.val_pow_eq_pow_val,
        (mem_rootsOfUnity m (g : (AlgebraicClosure F)ˣ)).mp g.2, Units.val_one]
    have hgen : ∀ ζ : AlgebraicClosure F, ζ ^ m = 1 → ∃ i : ℤ, ζ = ζ₀ ^ i := by
      intro ζ hζ
      have hζ0 : ζ ≠ 0 := by
        rintro rfl
        rw [zero_pow hm.ne'] at hζ
        exact zero_ne_one hζ
      have hu : Units.mk0 ζ hζ0 ∈ rootsOfUnity m (AlgebraicClosure F) := by
        rw [mem_rootsOfUnity]
        ext
        simp [hζ]
      obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp (hg ⟨_, hu⟩)
      refine ⟨i, ?_⟩
      have := congrArg (fun x : rootsOfUnity m (AlgebraicClosure F) =>
        ((x : (AlgebraicClosure F)ˣ) : AlgebraicClosure F)) hi
      simp only [Subgroup.coe_zpow, Units.val_zpow_eq_zpow_val, Units.val_mk0] at this
      rw [hζ₀]
      exact this.symm
    set z : ℕ → AlgebraicClosure F := fun j => (Φ ^ j) ζ₀ with hz
    have hzm : ∀ j, z j ^ m = 1 := by
      intro j
      simp only [hz]
      rw [← map_pow, hζ₀m, map_one]
    have hfin : {x : AlgebraicClosure F | x ^ m = 1}.Finite :=
      (Polynomial.nthRoots m (1 : AlgebraicClosure F)).toFinset.finite_toSet.subset
        (fun x hx => by
          simp only [Finset.mem_coe, Multiset.mem_toFinset]
          exact (Polynomial.mem_nthRoots hm).mpr hx)
    obtain ⟨a, b, hab, hzab⟩ := hfin.exists_lt_map_eq_of_forall_mem (f := z) (fun j => hzm j)
    set f := b - a with hf
    have hf0 : 0 < f := Nat.sub_pos_of_lt hab
    have hper : z f = z 0 := by
      have h1 : (Φ ^ a) ((Φ ^ f) ζ₀) = (Φ ^ a) ζ₀ := by
        rw [← AlgEquiv.mul_apply, ← pow_add, hf, Nat.add_sub_cancel' hab.le]
        exact hzab.symm
      have h2 := (Φ ^ a).injective h1
      simp only [hz, pow_zero, AlgEquiv.one_apply]
      exact h2
    have hzq : ∀ j, z (j + 1) = z j ^ q := by
      intro j
      simp only [hz]
      rw [pow_succ', AlgEquiv.mul_apply]
      exact hΦm _ (hzm j)
    set P : Polynomial (AlgebraicClosure F) :=
      ∏ j ∈ Finset.range f, (Polynomial.X - Polynomial.C (z j)) with hP
    have hcoef := hsym f z (fun j => le_of_eq (hunit _ (hzm j))) hzq hper
    have hex : ∀ i, ∃ a : F, w (P.coeff i - algebraMap F (AlgebraicClosure F) a) < 1 :=
      fun i => hfix _ (hcoef i).1 (hcoef i).2
    choose c hc using hex
    have hdeg : P.natDegree < f + 1 := by
      have h : P.natDegree ≤
          ∑ j ∈ Finset.range f, (Polynomial.X - Polynomial.C (z j)).natDegree :=
        Polynomial.natDegree_prod_le _ _
      simp only [Polynomial.natDegree_X_sub_C, Finset.sum_const, Finset.card_range, smul_eq_mul,
        mul_one] at h
      omega
    set A : AlgebraicClosure F → AlgebraicClosure F := fun y =>
      ∑ i ∈ Finset.range (f + 1), algebraMap F (AlgebraicClosure F) (c i) * y ^ i with hA
    set E : AlgebraicClosure F → AlgebraicClosure F := fun y =>
      ∑ i ∈ Finset.range (f + 1), (P.coeff i - algebraMap F (AlgebraicClosure F) (c i)) * y ^ i
      with hE
    have hPAE : ∀ y, P.eval y = A y + E y := by
      intro y
      simp only [hA, hE]
      rw [Polynomial.eval_eq_sum_range' hdeg, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun i _ => by ring)
    have hEsmall : ∀ y, w y ≤ 1 → w (E y) < 1 := by
      intro y hy
      simp only [hE]
      apply Valuation.map_sum_lt _ one_ne_zero
      intro i _
      rw [map_mul, map_pow]
      calc w (P.coeff i - algebraMap F (AlgebraicClosure F) (c i)) * w y ^ i
          ≤ w (P.coeff i - algebraMap F (AlgebraicClosure F) (c i)) :=
            mul_le_of_le_one_right (zero_le _) (pow_le_one₀ (zero_le _) hy)
        _ < 1 := hc i
    have hAσ : ∀ y, σ (A y) = A (σ y) := by
      intro y
      simp only [hA, map_sum, map_mul, map_pow, AlgEquiv.commutes]
    have hP0 : P.eval ζ₀ = 0 := by
      rw [hP, Polynomial.eval_prod]
      apply Finset.prod_eq_zero (Finset.mem_range.mpr hf0)
      simp [hz]
    have hAζ : w (A ζ₀) < 1 := by
      have h0 : A ζ₀ = -E ζ₀ := by
        have h := hPAE ζ₀
        rw [hP0] at h
        linear_combination -h
      rw [h0, Valuation.map_neg]
      exact hEsmall _ (le_of_eq (hunit _ hζ₀m))
    have hσζm : (σ ζ₀) ^ m = 1 := by rw [← map_pow, hζ₀m, map_one]
    have hPσ : w (P.eval (σ ζ₀)) < 1 := by
      rw [hPAE]
      apply Valuation.map_add_lt
      · rw [← hAσ, hw₂]
        exact hAζ
      · exact hEsmall _ (le_of_eq (hunit _ hσζm))
    obtain ⟨j, hj, hlt⟩ : ∃ j ∈ Finset.range f, w (σ ζ₀ - z j) < 1 := by
      by_contra hcon
      push_neg at hcon
      have h1 : (1 : NNReal) ≤ w (P.eval (σ ζ₀)) := by
        rw [hP, Polynomial.eval_prod, map_prod]
        calc (1 : NNReal) = ∏ j ∈ Finset.range f, (1 : NNReal) := by simp
          _ ≤ ∏ j ∈ Finset.range f,
              w (Polynomial.eval (σ ζ₀) (Polynomial.X - Polynomial.C (z j))) :=
            Finset.prod_le_prod (fun _ _ => zero_le_one) (fun j hj => by simpa using hcon j hj)
      exact absurd hPσ (not_lt.mpr h1)
    have hσζ : σ ζ₀ = z j := hdist _ _ hσζm (hzm j) hlt
    refine ⟨j, fun ζ hζ => ?_⟩
    obtain ⟨i, rfl⟩ := hgen ζ hζ
    rw [map_zpow₀, map_zpow₀, hσζ]
  
  
  
  have s8 : ∀ (M : IntermediateField F (AlgebraicClosure F)) (x : AlgebraicClosure F),
      (∀ τ ∈ M.fixingSubgroup, τ x = x) → ∃ n : ℕ, x ^ (ringExpChar F) ^ n ∈ M := by
    intro M x hx
    haveI : ExpChar F (ringExpChar F) := ringExpChar.expChar F
    haveI : ExpChar M (ringExpChar F) :=
      expChar_of_injective_algebraMap (algebraMap F M).injective _
    haveI : Algebra.IsAlgebraic M (AlgebraicClosure F) :=
      Algebra.IsAlgebraic.tower_top (K := F) M
    haveI : IsAlgClosure M (AlgebraicClosure F) := IsAlgClosure.mk inferInstance inferInstance
    haveI : Normal M (AlgebraicClosure F) := IsAlgClosure.normal M (AlgebraicClosure F)
    have hint : IsIntegral M x := Algebra.IsIntegral.isIntegral x
    have hμ0 : minpoly M x ≠ 0 := minpoly.ne_zero hint
    have hroots : ((minpoly M x).aroots (AlgebraicClosure F)).toFinset = {x} := by
      ext y
      simp only [Multiset.mem_toFinset, Finset.mem_singleton, Polynomial.mem_aroots]
      constructor
      · rintro ⟨-, hy⟩
        have hmy : minpoly M x = minpoly M y :=
          minpoly.eq_of_irreducible_of_monic (minpoly.irreducible hint) hy (minpoly.monic hint)
        obtain ⟨g, hg⟩ := (Normal.minpoly_eq_iff_mem_orbit (AlgebraicClosure F)).mp hmy.symm
        have hgF : (g.restrictScalars F) ∈ M.fixingSubgroup := by
          rw [IntermediateField.mem_fixingSubgroup_iff]
          intro a ha
          show g a = a
          have := g.commutes ⟨a, ha⟩
          simpa using this
        have := hx _ hgF
        rw [← hg]
        exact this
      · intro hy
        rw [hy]
        exact ⟨hμ0, minpoly.aeval M x⟩
    have hsep : (minpoly M x).natSepDegree = 1 := by
      rw [Polynomial.natSepDegree_eq_of_isAlgClosed (AlgebraicClosure F), hroots,
        Finset.card_singleton]
    obtain ⟨n, hn⟩ := (minpoly.natSepDegree_eq_one_iff_pow_mem (ringExpChar F)).mp hsep
    refine ⟨n, ?_⟩
    obtain ⟨a, ha⟩ := hn
    rw [← ha]
    exact a.2
  
  
  
  
  have s9 : ∀ (U : IntermediateField F (AlgebraicClosure F))
      (hpi : ∀ x : AlgebraicClosure F, (∀ τ ∈ U.fixingSubgroup, τ x = x) →
        ∃ n : ℕ, x ^ (ringExpChar F) ^ n ∈ U)
      (ρ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F)
      (hρ : ∀ x ∈ N, x ∈ U → ρ x = x),
      ∃ τ ∈ U.fixingSubgroup, ∀ x ∈ N, τ x = ρ x := by
    intro U hpi ρ hρ
    let res := AlgEquiv.restrictNormalHom (F := F) (K₁ := AlgebraicClosure F) N
    have hres : ∀ (g : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) (y : N),
        ((res g y : N) : AlgebraicClosure F) = g y :=
      fun g y => AlgEquiv.restrictNormal_commutes g N y
    let H : Subgroup (N ≃ₐ[F] N) := U.fixingSubgroup.map res
    have hmem : res ρ ∈ (IntermediateField.fixedField H).fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro y hy
      rw [IntermediateField.mem_fixedField_iff] at hy
      have hfix : ∀ τ ∈ U.fixingSubgroup, τ (y : AlgebraicClosure F) = y := by
        intro τ hτ
        have := hy (res τ) (Subgroup.mem_map_of_mem res hτ)
        rw [← hres τ y, this]
      obtain ⟨n, hn⟩ := hpi _ hfix
      have hN : (y : AlgebraicClosure F) ^ (ringExpChar F) ^ n ∈ N := pow_mem y.2 _
      have h1 := hρ _ hN hn
      rw [map_pow] at h1
      haveI : ExpChar F (ringExpChar F) := ringExpChar.expChar F
      haveI : ExpChar (AlgebraicClosure F) (ringExpChar F) :=
        expChar_of_injective_algebraMap (algebraMap F (AlgebraicClosure F)).injective _
      have h2 : iterateFrobenius (AlgebraicClosure F) (ringExpChar F) n (ρ y) =
          iterateFrobenius (AlgebraicClosure F) (ringExpChar F) n y := by
        rw [iterateFrobenius_def, iterateFrobenius_def, h1]
      have h3 := (iterateFrobenius (AlgebraicClosure F) (ringExpChar F) n).injective h2
      apply Subtype.ext
      rw [hres]
      exact h3
    rw [IntermediateField.fixingSubgroup_fixedField] at hmem
    obtain ⟨τ, hτ, hτρ⟩ := Subgroup.mem_map.mp hmem
    refine ⟨τ, hτ, fun x hx => ?_⟩
    have := congrArg (fun g => ((g ⟨x, hx⟩ : N) : AlgebraicClosure F)) hτρ
    simpa only [hres] using this
  
  
  
  have hp : (EllipticRootNumber.p F).Prime := by
    unfold EllipticRootNumber.p
    exact @CharP.char_is_prime _ _ _ _ _ _ (ringChar.charP _)
  obtain ⟨m, hm, hmp, hagree⟩ : ∃ m : ℕ, 0 < m ∧ ¬ EllipticRootNumber.p F ∣ m ∧
      ∀ σ τ : EllipticRootNumber.AbsGal F,
        (∀ ζ : AlgebraicClosure F, ζ ^ m = 1 → σ ζ = τ ζ) →
        ∀ x ∈ N, x ∈ EllipticRootNumber.unramifiedClosure F → σ x = τ x := by
    set U := EllipticRootNumber.unramifiedClosure F with hU
    haveI hfd : FiniteDimensional F ↥(U ⊓ N) := inferInstance
    have hfg : (U ⊓ N).FG :=
      IntermediateField.fg_of_fg_toSubalgebra _ (Subalgebra.fg_of_fg_toSubmodule
        ((Submodule.fg_iff_finiteDimensional _).mpr hfd))
    obtain ⟨s, hs⟩ := hfg
    have hT : ∀ y ∈ s, ∃ T : Finset (AlgebraicClosure F),
        (T : Set (AlgebraicClosure F)) ⊆ {ζ | EllipticRootNumber.IsPrimeToPRootOfUnity F ζ} ∧
        y ∈ IntermediateField.adjoin F (T : Set (AlgebraicClosure F)) := by
      intro y hy
      have hyL : y ∈ U ⊓ N := by
        rw [← hs]
        exact IntermediateField.subset_adjoin F _ hy
      exact IntermediateField.exists_finset_of_mem_adjoin (IntermediateField.mem_inf.mp hyL).1
    choose! T hTS hyT using hT
    set T' := s.biUnion T with hT'
    have hT'S : ∀ ζ ∈ T', ∃ n : ℕ, 0 < n ∧ ¬ EllipticRootNumber.p F ∣ n ∧ ζ ^ n = 1 := by
      intro ζ hζ
      obtain ⟨y, hy, hζy⟩ := Finset.mem_biUnion.mp hζ
      exact hTS y hy hζy
    choose! n hn0 hnp hnz using hT'S
    refine ⟨∏ ζ ∈ T', n ζ, Finset.prod_pos hn0, ?_, ?_⟩
    · intro hdvd
      obtain ⟨ζ, hζ, hd⟩ := (Prime.dvd_finset_prod_iff hp.prime n).mp hdvd
      exact hnp ζ hζ hd
    · intro σ τ hστ x hxN hxU
      have hgen : ∀ ζ ∈ (T' : Set (AlgebraicClosure F)), σ ζ = τ ζ := by
        intro ζ hζ
        apply hστ
        obtain ⟨k, hk⟩ := Finset.dvd_prod_of_mem n hζ
        rw [hk, pow_mul, hnz ζ hζ, one_pow]
      have hLe : U ⊓ N ≤ IntermediateField.adjoin F (T' : Set (AlgebraicClosure F)) := by
        rw [← hs, IntermediateField.adjoin_le_iff]
        intro y hy
        exact IntermediateField.adjoin.mono F _ _
          (fun ζ hζ => Finset.mem_biUnion.mpr ⟨y, hy, hζ⟩) (hyT y hy)
      have hx : x ∈ IntermediateField.adjoin F (T' : Set (AlgebraicClosure F)) :=
        hLe (IntermediateField.mem_inf.mpr ⟨hxU, hxN⟩)
      clear hxN hxU
      induction hx using IntermediateField.adjoin_induction with
      | mem x hx => exact hgen x hx
      | algebraMap x => simp only [AlgEquiv.commutes]
      | add x y _ _ hx hy => rw [map_add, map_add, hx, hy]
      | inv x _ hx => rw [map_inv₀, map_inv₀, hx]
      | mul x y _ _ hx hy => rw [map_mul, map_mul, hx, hy]
  
  
  
  obtain ⟨w, hw₁, hw₂⟩ := exists_galoisInvariant_valuation_algebraicClosure F
  have hΦm : ∀ ζ : AlgebraicClosure F, ζ ^ m = 1 → Φ ζ = ζ ^ EllipticRootNumber.q F := by
    intro ζ hζ
    have := hΦ ζ ⟨m, hm, hmp, hζ⟩
    simpa using this
  obtain ⟨k, hk⟩ := s6 (EllipticRootNumber.q F) Φ σ w hw₂ m hm hΦm
    (fun ζ ζ' h₁ h₂ h₃ => s3 w hw₁ m hm hmp ζ ζ' h₁ h₂ h₃)
    (fun c hc hcq => (s45 w hw₁).1 c hc hcq)
    (fun f z hz hzq hper i => (s45 w hw₁).2 f z hz hzq hper i)
  set ρ : EllipticRootNumber.AbsGal F := (Φ ^ k)⁻¹ * σ with hρdef
  have hρ : ∀ x ∈ N, x ∈ EllipticRootNumber.unramifiedClosure F → ρ x = x := by
    intro x hx hxU
    have h := hagree σ (Φ ^ k) hk x hx hxU
    rw [hρdef, AlgEquiv.mul_apply, h, AlgEquiv.aut_inv]
    exact (Φ ^ k).symm_apply_apply x
  obtain ⟨τ, hτI, hτ⟩ := s9 (EllipticRootNumber.unramifiedClosure F)
    (fun x hx => s8 _ x hx) ρ hρ
  
  have hτW : τ ∈ EllipticRootNumber.weilGroup F := by
    apply Subgroup.subset_closure
    refine ⟨0, fun ζ hζ => ?_⟩
    have hτζ : τ ζ = ζ := (IntermediateField.mem_fixingSubgroup_iff _ _).mp hτI ζ
      (IntermediateField.subset_adjoin _ _ hζ)
    simp [hτζ]
  have hΦW : Φ ∈ EllipticRootNumber.weilGroup F := Subgroup.subset_closure ⟨1, hΦ⟩
  refine ⟨Φ ^ k * τ, Subgroup.mul_mem _ (Subgroup.pow_mem _ hΦW k) hτW, fun x hx => ?_⟩
  rw [AlgEquiv.mul_apply, hτ x hx, hρdef, AlgEquiv.mul_apply, AlgEquiv.aut_inv]
  exact (Φ ^ k).apply_symm_apply (σ x)

theorem relVal_eq_zero_of_mem_unitGroup (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (a : ℕ) (ha : 0 < a) (u : Lˣ) (hu : u ∈ EllipticRootNumber.unitGroup F L a) :
    EllipticRootNumber.relVal F L (u : L) = 0 :=
by
  classical
  obtain ⟨w, hwF, hwG⟩ := exists_galoisInvariant_valuation_algebraicClosure F
  
  have hN : ∀ x : L, w (algebraMap F (AlgebraicClosure F) (Algebra.norm F x)) =
      w ((x : L) : AlgebraicClosure F) ^ Module.finrank F L := by
    intro x
    have hx : IsIntegral F x := IsIntegral.of_finite F x
    have hX : IsIntegral F (x : AlgebraicClosure F) := Algebra.IsIntegral.isIntegral _
    have hS : ((minpoly F x).map (algebraMap F (AlgebraicClosure F))).Splits :=
      IsAlgClosed.splits _
    rw [Algebra.norm_eq_prod_roots (AlgebraicClosure F) hS, map_pow, map_multiset_prod]
    have hroots : ∀ r ∈ (minpoly F x).aroots (AlgebraicClosure F),
        w r = w (x : AlgebraicClosure F) := by
      intro r hr
      rw [Polynomial.mem_aroots] at hr
      have h1 : Polynomial.aeval r (minpoly F (x : AlgebraicClosure F)) = 0 := by
        rw [← IntermediateField.minpoly_eq]; exact hr.2
      obtain ⟨σ, hσ⟩ := (isConjRoot_of_aeval_eq_zero hX h1).exists_algEquiv
      rw [← hσ]
      exact (hwG σ r).symm
    rw [Multiset.map_congr rfl hroots, Multiset.map_const', Multiset.prod_replicate, ← pow_mul]
    congr 1
    rw [Polynomial.aroots_def, ← hS.natDegree_eq_card_roots, Polynomial.natDegree_map,
      ← IntermediateField.adjoin.finrank hx, Module.finrank_mul_finrank]
  
  have hE : (w.comap (algebraMap F (AlgebraicClosure F))).IsEquiv (ValuativeRel.valuation F) :=
    Valuation.isEquiv_iff_val_le_one.mpr (fun {x} => by rw [Valuation.comap_apply]; exact hwF x)
  have key : ∀ (z : WithZero (Multiplicative ℤ)) (hz : z ≠ 0),
      Multiplicative.toAdd (WithZero.unzero hz) = WithZero.log z := by
    intro z hz
    obtain ⟨u, rfl⟩ := WithZero.ne_zero_iff_exists.mp hz
    rw [WithZero.unzero_coe]
    show _ = WithZero.log (WithZero.exp (Multiplicative.toAdd u))
    rw [WithZero.log_exp]
  have hne : ∀ c : F, c ≠ 0 →
      IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (ValuativeRel.valuation F c) ≠ 0 :=
    fun c hc => (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hc)
  have s1 : ∀ c : F, c ≠ 0 → EllipticRootNumber.addVal F c =
      -WithZero.log (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
        (ValuativeRel.valuation F c)) := by
    intro c hc
    unfold EllipticRootNumber.addVal
    rw [dif_neg hc, key]
  have hA : ∀ c : F, 0 < EllipticRootNumber.addVal F c →
      w (algebraMap F (AlgebraicClosure F) c) < 1 := by
    intro c hc
    have hc0 : c ≠ 0 := by
      rintro rfl
      unfold EllipticRootNumber.addVal at hc
      simp at hc
    rw [s1 c hc0] at hc
    have hlog : WithZero.log (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
        (ValuativeRel.valuation F c)) < 0 := by linarith
    have hz : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
        (ValuativeRel.valuation F c) < IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F 1 := by
      rw [map_one, ← WithZero.exp_log (hne c hc0), ← WithZero.exp_zero]
      exact WithZero.exp_lt_exp.mpr hlog
    have hv : ValuativeRel.valuation F c < 1 := (map_lt_map_iff _).mp hz
    have h := hE.lt_one_iff_lt_one.mpr hv
    rwa [Valuation.comap_apply] at h
  have hB : ∀ c : F, c ≠ 0 → w (algebraMap F (AlgebraicClosure F) c) = 1 →
      EllipticRootNumber.addVal F c = 0 := by
    intro c hc0 h1
    have h1' : (w.comap (algebraMap F (AlgebraicClosure F))) c = 1 := by
      rwa [Valuation.comap_apply]
    have hv : ValuativeRel.valuation F c = 1 := hE.eq_one_iff_eq_one.mp h1'
    rw [s1 c hc0, hv, map_one, WithZero.log_one, neg_zero]
  
  have ha0 : a ≠ 0 := Nat.pos_iff_ne_zero.mp ha
  have hgen : ∀ x : Lˣ, ((x : L) = 1 ∨ (a : ℤ) ≤ EllipticRootNumber.valL F L ((x : L) - 1)) →
      w (((x : L)) : AlgebraicClosure F) = 1 := by
    intro x hx
    rcases hx with h | h
    · rw [h]; simp
    · set y : L := (x : L) - 1 with hy
      have hrel : 0 < EllipticRootNumber.relVal F L y := by
        unfold EllipticRootNumber.valL at h
        rcases Nat.eq_zero_or_pos (EllipticRootNumber.resDeg F L) with h0 | h0
        · rw [h0] at h
          simp at h
          omega
        · have h0' : (0 : ℤ) < (EllipticRootNumber.resDeg F L : ℤ) := by exact_mod_cast h0
          have h1a : (1 : ℤ) ≤ (a : ℤ) := by exact_mod_cast ha
          have := (Int.le_ediv_iff_mul_le h0').mp (le_trans h1a h)
          linarith
      have hlt := hA (Algebra.norm F y) hrel
      rw [hN y] at hlt
      have hy1 : w ((y : L) : AlgebraicClosure F) < 1 := by
        by_contra hc
        push_neg at hc
        exact absurd hlt (not_lt.mpr (one_le_pow₀ hc))
      have hx' : (((x : L)) : AlgebraicClosure F) = 1 + ((y : L) : AlgebraicClosure F) := by
        rw [hy]; push_cast; ring
      rw [hx']
      exact Valuation.map_one_add_of_lt w hy1
  
  have hall : ∀ v ∈ EllipticRootNumber.unitGroup F L a,
      w (((v : L)) : AlgebraicClosure F) = 1 := by
    intro v hv
    unfold EllipticRootNumber.unitGroup at hv
    induction hv using Subgroup.closure_induction with
    | mem x hx =>
      rw [Set.mem_setOf_eq, if_neg ha0] at hx
      exact hgen x hx
    | one => simp
    | mul x y _ _ hx hy =>
      rw [Units.val_mul, IntermediateField.coe_mul, map_mul, hx, hy, one_mul]
    | inv x _ hx =>
      rw [Units.val_inv_eq_inv_val, IntermediateField.coe_inv, map_inv₀, hx, inv_one]
  
  have hu1 := hall u hu
  have hNu := hN (u : L)
  rw [hu1, one_pow] at hNu
  have hne0 : Algebra.norm F (u : L) ≠ 0 := by
    intro h0
    rw [h0, map_zero, map_zero] at hNu
    exact zero_ne_one hNu
  unfold EllipticRootNumber.relVal
  exact hB _ hne0 hNu

theorem exists_small_root_of_valuation {K : Type*} [Field K] [IsAlgClosed K]
    (w : Valuation K NNReal) (Q : Polynomial K) (h1 : Q.coeff 1 ≠ 0)
    (h0 : w (Q.coeff 0) < w (Q.coeff 1) ^ 2) :
    ∃ y : K, Q.IsRoot y ∧ w y < w (Q.coeff 1) :=
by
  classical
  have key : ∀ (m : NNReal) (s : Multiset K), (∀ r ∈ s, m ≤ w r) →
      m * w ((s.map (fun r => Polynomial.X - Polynomial.C r)).prod.coeff 1) ≤
        w ((s.map (fun r => Polynomial.X - Polynomial.C r)).prod.coeff 0) := by
    intro m s
    induction s using Multiset.induction_on with
    | empty =>
      intro _
      simp [Polynomial.coeff_one]
    | cons a s ih =>
      intro hs
      have ha : m ≤ w a := hs a (Multiset.mem_cons_self a s)
      have IH := ih (fun r hr => hs r (Multiset.mem_cons_of_mem hr))
      rw [Multiset.map_cons, Multiset.prod_cons]
      generalize (s.map (fun r => Polynomial.X - Polynomial.C r)).prod = P at IH ⊢
      have e0 : ((Polynomial.X - Polynomial.C a) * P).coeff 0 = -a * P.coeff 0 := by
        rw [Polynomial.mul_coeff_zero]
        simp
      have e1 : ((Polynomial.X - Polynomial.C a) * P).coeff 1 = P.coeff 0 - a * P.coeff 1 := by
        have := Polynomial.coeff_X_sub_C_mul (p := P) (r := a) (a := 0)
        simpa using this
      rw [e0, e1, Valuation.map_mul, Valuation.map_neg]
      have hsub : w (P.coeff 0 - a * P.coeff 1) ≤ max (w (P.coeff 0)) (w a * w (P.coeff 1)) := by
        have := Valuation.map_sub w (P.coeff 0) (a * P.coeff 1)
        rwa [Valuation.map_mul] at this
      calc m * w (P.coeff 0 - a * P.coeff 1)
          ≤ m * max (w (P.coeff 0)) (w a * w (P.coeff 1)) := mul_le_mul_left' hsub m
        _ ≤ w a * w (P.coeff 0) := by
          rcases le_total (w (P.coeff 0)) (w a * w (P.coeff 1)) with h | h
          · rw [max_eq_right h]
            calc m * (w a * w (P.coeff 1)) = w a * (m * w (P.coeff 1)) := by ring
              _ ≤ w a * w (P.coeff 0) := mul_le_mul_left' IH _
          · rw [max_eq_left h]
            exact mul_le_mul_right' ha _
  by_contra hcon
  push_neg at hcon
  have hfac := Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C
    (IsAlgClosed.card_roots_eq_natDegree (p := Q))
  have B := key (w (Q.coeff 1)) Q.roots
    (fun r hr => hcon r (Polynomial.isRoot_of_mem_roots hr))
  have hQ0 : Q.coeff 0 = Q.leadingCoeff *
      (Q.roots.map (fun r => Polynomial.X - Polynomial.C r)).prod.coeff 0 := by
    rw [← Polynomial.coeff_C_mul, hfac]
  have hQ1 : Q.coeff 1 = Q.leadingCoeff *
      (Q.roots.map (fun r => Polynomial.X - Polynomial.C r)).prod.coeff 1 := by
    rw [← Polynomial.coeff_C_mul, hfac]
  generalize (Q.roots.map (fun r => Polynomial.X - Polynomial.C r)).prod = P at B hQ0 hQ1
  have e : w (Q.coeff 1) = w Q.leadingCoeff * w (P.coeff 1) := by
    rw [hQ1, Valuation.map_mul]
  have hle : w (Q.coeff 1) ^ 2 ≤ w (Q.coeff 0) := by
    calc w (Q.coeff 1) ^ 2 = w (Q.coeff 1) * w (Q.coeff 1) := sq _
      _ = w (Q.coeff 1) * (w Q.leadingCoeff * w (P.coeff 1)) := by rw [← e]
      _ = w Q.leadingCoeff * (w (Q.coeff 1) * w (P.coeff 1)) := mul_left_comm _ _ _
      _ ≤ w Q.leadingCoeff * w (P.coeff 0) := mul_le_mul_left' B _
      _ = w (Q.coeff 0) := by rw [hQ0, Valuation.map_mul]
  exact absurd (lt_of_le_of_lt hle h0) (lt_irrefl _)

theorem small_root_unique_of_valuation {K : Type*} [Field K]
    (w : Valuation K NNReal) (Q : Polynomial K) (h1 : Q.coeff 1 ≠ 0)
    (hw1 : w (Q.coeff 1) ≤ 1) (hk : ∀ k, 2 ≤ k → w (Q.coeff k) ≤ 1) :
    (∀ y y' : K, Q.IsRoot y → Q.IsRoot y' → w y < w (Q.coeff 1) → w y' < w (Q.coeff 1) →
      y = y') ∧
    (∀ y : K, w y < w (Q.coeff 1) → (Polynomial.derivative Q).eval y ≠ 0) :=
by
  have hc0 : w (Q.coeff 1) ≠ 0 := (Valuation.ne_zero_iff w).2 h1
  have hnat : ∀ n : ℕ, w (n : K) ≤ 1 := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [Nat.cast_succ]
      exact Valuation.map_add_le w ih (le_of_eq (map_one w))
  refine ⟨?_, ?_⟩
  · intro y y' hy hy' hwy hwy'
    have hev : ∀ z, Q.eval z = ∑ i ∈ Finset.range (Q.natDegree + 2), Q.coeff i * z ^ i :=
      fun z => Polynomial.eval_eq_sum_range' (by omega) z
    set G : ℕ → K := fun i => ∑ j ∈ Finset.range i, y ^ j * y' ^ (i - 1 - j) with hG
    have hfac : Q.eval y - Q.eval y' =
        (∑ i ∈ Finset.range (Q.natDegree + 2), Q.coeff i * G i) * (y - y') := by
      rw [hev y, hev y', ← Finset.sum_sub_distrib, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [mul_assoc, hG]
      simp only
      rw [geom_sum₂_mul, mul_sub]
    have hT : ∑ i ∈ Finset.range (Q.natDegree + 2), Q.coeff i * G i =
        ∑ i ∈ Finset.range Q.natDegree, Q.coeff (i + 2) * G (i + 2) + Q.coeff 1 := by
      rw [Finset.sum_range_succ', Finset.sum_range_succ']
      simp [hG]
    have hm : max (w y) (w y') < w (Q.coeff 1) := max_lt hwy hwy'
    have hm1 : max (w y) (w y') ≤ 1 := hm.le.trans hw1
    have hS : w (∑ i ∈ Finset.range Q.natDegree, Q.coeff (i + 2) * G (i + 2)) <
        w (Q.coeff 1) := by
      apply Valuation.map_sum_lt w hc0
      intro i _
      have hGi : w (G (i + 2)) < w (Q.coeff 1) := by
        apply Valuation.map_sum_lt w hc0
        intro j hj
        rw [Finset.mem_range] at hj
        rw [map_mul, map_pow, map_pow]
        calc w y ^ j * w y' ^ (i + 2 - 1 - j)
            ≤ (max (w y) (w y')) ^ j * (max (w y) (w y')) ^ (i + 2 - 1 - j) :=
              mul_le_mul' (pow_le_pow_left₀ (zero_le _) (le_max_left _ _) _)
                (pow_le_pow_left₀ (zero_le _) (le_max_right _ _) _)
          _ = (max (w y) (w y')) ^ (i + 1) := by rw [← pow_add]; congr 1; omega
          _ ≤ max (w y) (w y') := pow_le_of_le_one (zero_le _) hm1 (by omega)
          _ < w (Q.coeff 1) := hm
      rw [map_mul]
      exact lt_of_le_of_lt (mul_le_of_le_one_left (zero_le _) (hk (i + 2) (by omega))) hGi
    have hne : ∑ i ∈ Finset.range Q.natDegree, Q.coeff (i + 2) * G (i + 2) + Q.coeff 1 ≠ 0 := by
      intro h0
      have := Valuation.map_add_eq_of_lt_right w hS
      rw [h0, map_zero] at this
      exact hc0 this.symm
    have h0 : (∑ i ∈ Finset.range Q.natDegree, Q.coeff (i + 2) * G (i + 2) + Q.coeff 1) *
        (y - y') = 0 := by
      rw [← hT, ← hfac, hy.eq_zero, hy'.eq_zero, sub_zero]
    rcases mul_eq_zero.mp h0 with h | h
    · exact absurd h hne
    · exact sub_eq_zero.mp h
  · intro y hwy
    have hD : (Polynomial.derivative Q).natDegree < Q.natDegree + 1 := by
      have := Polynomial.natDegree_derivative_le Q
      omega
    have hy1 : w y ≤ 1 := hwy.le.trans hw1
    have e : (Polynomial.derivative Q).eval y =
        (∑ i ∈ Finset.range Q.natDegree,
          Q.coeff (i + 1 + 1) * (((i + 1 : ℕ) : K) + 1) * y ^ (i + 1)) + Q.coeff 1 := by
      rw [Polynomial.eval_eq_sum_range' hD, Finset.sum_range_succ']
      congr 1
      · refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Polynomial.coeff_derivative]
      · rw [Polynomial.coeff_derivative]
        simp
    have hS : w (∑ i ∈ Finset.range Q.natDegree,
          Q.coeff (i + 1 + 1) * (((i + 1 : ℕ) : K) + 1) * y ^ (i + 1)) < w (Q.coeff 1) := by
      apply Valuation.map_sum_lt w hc0
      intro i _
      have ha : w (((i + 1 : ℕ) : K) + 1) ≤ 1 :=
        Valuation.map_add_le w (hnat _) (le_of_eq (map_one w))
      rw [map_mul, map_mul, map_pow]
      calc w (Q.coeff (i + 1 + 1)) * w (((i + 1 : ℕ) : K) + 1) * w y ^ (i + 1)
          ≤ w y ^ (i + 1) :=
            mul_le_of_le_one_left (zero_le _) (mul_le_one' (hk _ (by omega)) ha)
        _ ≤ w y := pow_le_of_le_one (zero_le _) hy1 (by omega)
        _ < w (Q.coeff 1) := hwy
    rw [e]
    intro h0
    have := Valuation.map_add_eq_of_lt_right w hS
    rw [h0, map_zero] at this
    exact hc0 this.symm

theorem mem_of_fixed_of_separable {F : Type u} [Field F]
    (K : IntermediateField F (AlgebraicClosure F)) (x : AlgebraicClosure F)
    (hsep : IsSeparable K x)
    (hfix : ∀ σ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F, σ ∈ K.fixingSubgroup → σ x = x) :
    x ∈ K :=
by
  classical
  by_contra hx
  have hint : IsIntegral K x := hsep.isIntegral
  have hne : minpoly K x ≠ 0 := minpoly.ne_zero hint
  have hirr : Irreducible (minpoly K x) := minpoly.irreducible hint
  have hmon : (minpoly K x).Monic := minpoly.monic hint
  have hpos : 0 < (minpoly K x).natDegree := minpoly.natDegree_pos hint
  have hne1 : (minpoly K x).natDegree ≠ 1 := by
    intro h1
    obtain ⟨k, hk⟩ := (minpoly.natDegree_eq_one_iff).mp h1
    apply hx
    rw [← hk, IntermediateField.algebraMap_apply]
    exact k.2
  have hcard : Fintype.card ((minpoly K x).rootSet (AlgebraicClosure F)) =
      (minpoly K x).natDegree :=
    Polynomial.card_rootSet_eq_natDegree hsep
      (IsAlgClosed.splits ((minpoly K x).map (algebraMap K (AlgebraicClosure F))))
  have hxmem : x ∈ (minpoly K x).rootSet (AlgebraicClosure F) :=
    (Polynomial.mem_rootSet).mpr ⟨hne, minpoly.aeval K x⟩
  obtain ⟨b, hb⟩ := Fintype.exists_ne_of_one_lt_card (by rw [hcard]; omega)
    (⟨x, hxmem⟩ : (minpoly K x).rootSet (AlgebraicClosure F))
  have hyx : (b : AlgebraicClosure F) ≠ x := fun h => hb (Subtype.ext h)
  have hyroot : Polynomial.aeval (b : AlgebraicClosure F) (minpoly K x) = 0 :=
    ((Polynomial.mem_rootSet).mp b.2).2
  have hmin : minpoly K x = minpoly K (b : AlgebraicClosure F) :=
    minpoly.eq_of_irreducible_of_monic hirr hyroot hmon
  haveI : IsAlgClosure K (AlgebraicClosure F) :=
    IsAlgClosure.mk inferInstance (inferInstance : Algebra.IsAlgebraic K (AlgebraicClosure F))
  haveI : Normal K (AlgebraicClosure F) := IsAlgClosure.normal K (AlgebraicClosure F)
  have horb := (Normal.minpoly_eq_iff_mem_orbit (AlgebraicClosure F)).mp hmin.symm
  obtain ⟨τ, hτ⟩ := MulAction.mem_orbit_iff.mp horb
  have hτ' : τ x = (b : AlgebraicClosure F) := hτ
  let σ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F := AlgEquiv.restrictScalars F τ
  have hσ : σ ∈ K.fixingSubgroup := by
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    show τ z = z
    have := τ.commutes (⟨z, hz⟩ : K)
    rw [IntermediateField.algebraMap_apply] at this
    exact this
  have h := hfix σ hσ
  have h2 : σ x = τ x := rfl
  rw [h2, hτ'] at h
  exact hyx h

theorem exists_norm_poly_integral {K E : Type*} [Field K] [Field E] [Algebra K E]
    [FiniteDimensional K E] [Algebra.IsSeparable K E]
    (v : Valuation K NNReal) (ϖ : K) (hϖ0 : ϖ ≠ 0) (hϖ : v ϖ < 1) :
    ∃ (θ : E) (P : Polynomial K),
      (∀ y : K, P.eval y = Algebra.norm K (1 + y • θ)) ∧
      P.coeff 0 = 1 ∧ P.coeff 1 ≠ 0 ∧ ∀ k, v (P.coeff k) ≤ 1 :=
by
  classical
  obtain ⟨θ₀, hθ₀⟩ := Algebra.trace_surjective K E 1
  let b := Module.finBasis K E
  set M := Algebra.leftMulMatrix b θ₀ with hM
  set P₀ : Polynomial K := Matrix.det (1 + (Polynomial.X : Polynomial K) • M.map Polynomial.C)
    with hP₀
  have hev : ∀ y : K, P₀.eval y = Algebra.norm K (1 + y • θ₀) := by
    intro y
    have hX := Matrix.det_one_add_X_smul M
    rw [← hP₀] at hX
    rw [Algebra.norm_eq_matrix_det b, map_add, map_one, map_smul, ← hM, Matrix.det_one_add_smul,
      ← hP₀]
    conv_lhs => rw [hX]
    simp only [Polynomial.eval_add, Polynomial.eval_one, Polynomial.eval_smul,
      Polynomial.eval_X, Polynomial.eval_mul, Polynomial.eval_pow, smul_eq_mul]
  have hc0 : P₀.coeff 0 = 1 := by
    rw [Polynomial.coeff_zero_eq_eval_zero, hev]; simp
  have hc1 : P₀.coeff 1 = 1 := by
    rw [hP₀, Matrix.coeff_det_one_add_X_smul_one, hM, ← Algebra.trace_eq_matrix_trace, hθ₀]
  set B : NNReal := ∑ i ∈ Finset.range (P₀.natDegree + 1), v (P₀.coeff i) with hBdef
  have hB : ∀ k, v (P₀.coeff k) ≤ B := by
    intro k
    by_cases hk : k ≤ P₀.natDegree
    · exact Finset.single_le_sum (f := fun i => v (P₀.coeff i)) (fun i _ => zero_le _)
        (Finset.mem_range.mpr (Nat.lt_succ_of_le hk))
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (not_le.mp hk), Valuation.map_zero]
      exact zero_le _
  have hB1 : (0 : NNReal) < (B + 1)⁻¹ := inv_pos.mpr (add_pos_of_nonneg_of_pos (zero_le _) one_pos)
  obtain ⟨m, hm⟩ := exists_pow_lt_of_lt_one hB1 hϖ
  refine ⟨ϖ ^ m • θ₀, P₀.comp (Polynomial.C (ϖ ^ m) * Polynomial.X), ?_, ?_, ?_, ?_⟩
  · intro y
    rw [Polynomial.eval_comp]
    simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X]
    rw [hev, smul_smul, mul_comm]
  · rw [Polynomial.comp_C_mul_X_coeff, hc0, pow_zero, mul_one]
  · rw [Polynomial.comp_C_mul_X_coeff, hc1, pow_one, one_mul]
    exact pow_ne_zero m hϖ0
  · intro k
    rw [Polynomial.comp_C_mul_X_coeff, Valuation.map_mul, Valuation.map_pow, Valuation.map_pow]
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · simp [hc0]
    · have hvm : v ϖ ^ m ≤ 1 := pow_le_one₀ (zero_le _) hϖ.le
      calc v (P₀.coeff k) * (v ϖ ^ m) ^ k ≤ B * (v ϖ ^ m) :=
            mul_le_mul (hB k) (pow_le_of_le_one (zero_le _) hvm hk.ne') (zero_le _) (zero_le _)
        _ ≤ B * (B + 1)⁻¹ := by gcongr
        _ ≤ 1 := by
          rw [← div_eq_mul_inv]
          exact div_le_one_of_le₀ (le_add_of_nonneg_right zero_le_one) (zero_le _)

theorem unitGroup_le_range_normLM (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L M : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M] (h : L ≤ M)
    (hsep : Algebra.IsSeparable L (IntermediateField.extendScalars h)) :
    ∃ a : ℕ, 0 < a ∧ ∀ u ∈ EllipticRootNumber.unitGroup F L a,
      ((u : Lˣ) : L) ∈ Set.range (EllipticRootNumber.normLM F h) :=
by
  classical
  
  haveI hFL : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion h).injective
  haveI : Module.Finite F (IntermediateField.extendScalars h) := by
    let f : M →ₗ[F] IntermediateField.extendScalars h :=
      { toFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars h).mpr y.2⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    exact Module.Finite.of_surjective f
      (fun z => ⟨⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩, rfl⟩)
  haveI hLM : FiniteDimensional L (IntermediateField.extendScalars h) :=
    Module.Finite.of_restrictScalars_finite F L _
  
  obtain ⟨w, hwF, hwG⟩ := exists_galoisInvariant_valuation_algebraicClosure F
  obtain ⟨hf, hrel, -, -, ⟨ϖ, hϖ1⟩, hlast⟩ := valL_spec F L
  obtain ⟨r, hr0, hr1, hr⟩ := hlast w hwF hwG
  set ι : L →+* AlgebraicClosure F := algebraMap L (AlgebraicClosure F) with hι
  have hιinj : Function.Injective ι := ι.injective
  have hvalL0 : EllipticRootNumber.valL F L 0 = 0 := by
    unfold EllipticRootNumber.valL EllipticRootNumber.relVal
    rw [Algebra.norm_zero]
    unfold EllipticRootNumber.addVal
    simp
  have hϖ0 : ϖ ≠ 0 := by
    rintro rfl
    rw [hvalL0] at hϖ1
    exact zero_ne_one hϖ1
  have hfZ : (1 : ℤ) ≤ (EllipticRootNumber.resDeg F L : ℤ) := by exact_mod_cast hf
  have hϖrel : (1 : ℤ) ≤ EllipticRootNumber.relVal F L ϖ := by
    rw [hrel ϖ hϖ0, hϖ1, mul_one]
    exact hfZ
  have hwϖ : w (ι ϖ) < 1 := by
    by_contra hcon
    push_neg at hcon
    have h1 : (1 : NNReal) ≤ w (ι ϖ) ^ Module.finrank F L := one_le_pow₀ hcon
    have h2 : w (ι ϖ) ^ Module.finrank F L = r ^ EllipticRootNumber.relVal F L ϖ := hr ϖ hϖ0
    have h3 : r ^ EllipticRootNumber.relVal F L ϖ ≤ r ^ (1 : ℤ) :=
      zpow_le_zpow_right_of_le_one₀ hr0 hr1.le hϖrel
    rw [zpow_one] at h3
    rw [h2] at h1
    exact absurd (lt_of_le_of_lt (h1.trans h3) hr1) (lt_irrefl _)
  let v : Valuation L NNReal := w.comap ι
  have hv : ∀ z : L, v z = w (ι z) := fun z => rfl
  obtain ⟨θ, P, hPev, hP0, hP1, hPk⟩ :=
    exists_norm_poly_integral (K := L) (E := IntermediateField.extendScalars h) v ϖ hϖ0
      (by rw [hv]; exact hwϖ)
  set t : L := P.coeff 1 with ht
  set τ : NNReal := w (ι t) with hτ
  have hτ0 : 0 < τ := by
    rw [hτ]
    refine lt_of_le_of_ne (zero_le _) (Ne.symm ?_)
    rw [ne_eq, Valuation.zero_iff, map_eq_zero_iff ι hιinj]
    exact hP1
  have hτ1 : τ ≤ 1 := by rw [hτ, ← hv]; exact hPk 1
  set c : NNReal := (τ ^ 2) ^ Module.finrank F L with hc
  have hc0 : 0 < c := pow_pos (pow_pos hτ0 2) _
  obtain ⟨a₀, ha₀⟩ := exists_pow_lt_of_lt_one hc0 hr1
  
  have hmain : ∀ u : Lˣ, (u : L) - 1 ≠ 0 →
      (((a₀ + 1 : ℕ) : ℤ) ≤ EllipticRootNumber.valL F L ((u : L) - 1)) →
      ∃ m : M, EllipticRootNumber.normLM F h m = (u : L) := by
    intro u hx hval
    set x : L := (u : L) - 1 with hxdef
    
    have hvalpos : (1 : ℤ) ≤ EllipticRootNumber.valL F L x := by
      have : (1 : ℤ) ≤ ((a₀ + 1 : ℕ) : ℤ) := by push_cast; omega
      exact this.trans hval
    have hrelx : ((a₀ : ℕ) : ℤ) ≤ EllipticRootNumber.relVal F L x := by
      rw [hrel x hx]
      have : ((a₀ : ℕ) : ℤ) ≤ EllipticRootNumber.valL F L x := by
        have : ((a₀ : ℕ) : ℤ) ≤ ((a₀ + 1 : ℕ) : ℤ) := by push_cast; omega
        exact this.trans hval
      nlinarith
    have hwx : w (ι x) < τ ^ 2 := by
      have e1 : w (ι x) ^ Module.finrank F L = r ^ EllipticRootNumber.relVal F L x := hr x hx
      have e2 : r ^ EllipticRootNumber.relVal F L x ≤ r ^ ((a₀ : ℕ) : ℤ) :=
        zpow_le_zpow_right_of_le_one₀ hr0 hr1.le hrelx
      rw [zpow_natCast] at e2
      have e4 : w (ι x) ^ Module.finrank F L < (τ ^ 2) ^ Module.finrank F L := by
        rw [e1]
        exact lt_of_le_of_lt e2 ha₀
      exact lt_of_pow_lt_pow_left₀ _ (zero_le _) e4
    
    set QL : Polynomial L := P - Polynomial.C (u : L) with hQL
    set Q : Polynomial (AlgebraicClosure F) := QL.map ι with hQ
    have hQeval : ∀ z, Q.eval z = QL.eval₂ ι z := fun z => by
      rw [hQ, Polynomial.eval_map]
    have hQc0 : Q.coeff 0 = -(ι x) := by
      rw [hQ, Polynomial.coeff_map, hQL, Polynomial.coeff_sub, Polynomial.coeff_C_zero, hP0,
        hxdef, ← map_neg]
      congr 1
      ring
    have hQc1 : Q.coeff 1 = ι t := by
      rw [hQ, Polynomial.coeff_map, hQL, Polynomial.coeff_sub, Polynomial.coeff_C,
        if_neg one_ne_zero, sub_zero]
    have hQck : ∀ k, 2 ≤ k → Q.coeff k = ι (P.coeff k) := by
      intro k hk
      rw [hQ, Polynomial.coeff_map, hQL, Polynomial.coeff_sub, Polynomial.coeff_C,
        if_neg (by omega), sub_zero]
    have hQ1ne : Q.coeff 1 ≠ 0 := by
      rw [hQc1, ne_eq, map_eq_zero_iff ι hιinj]
      exact hP1
    have hQ0lt : w (Q.coeff 0) < w (Q.coeff 1) ^ 2 := by
      rw [hQc0, hQc1, Valuation.map_neg]
      exact hwx
    obtain ⟨y₀, hroot, hy₀⟩ := exists_small_root_of_valuation w Q hQ1ne hQ0lt
    obtain ⟨huniq, hsimple⟩ := small_root_unique_of_valuation w Q hQ1ne
      (by rw [hQc1]; exact hτ1)
      (fun k hk => by rw [hQck k hk, ← hv]; exact hPk k)
    have hr0' : QL.eval₂ ι y₀ = 0 := by
      rw [← hQeval]
      exact hroot
    
    have hfix : ∀ σ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F,
        σ ∈ L.fixingSubgroup → σ y₀ = y₀ := by
      intro σ hσ
      have hcomp : (σ : AlgebraicClosure F →+* AlgebraicClosure F).comp ι = ι := by
        ext z
        exact (IntermediateField.mem_fixingSubgroup_iff _ _).mp hσ (z : AlgebraicClosure F) z.2
      have hr' : Q.IsRoot (σ y₀) := by
        have e := Polynomial.hom_eval₂ QL ι (σ : AlgebraicClosure F →+* AlgebraicClosure F) y₀
        rw [hcomp, hr0', map_zero] at e
        rw [Polynomial.IsRoot, hQeval]
        exact e.symm
      exact huniq _ _ hr' hroot (by rw [hwG]; exact hy₀) hy₀
    
    have haev : Polynomial.aeval y₀ QL = 0 := by
      rw [Polynomial.aeval_def]
      exact hr0'
    have hsimple' : (Polynomial.derivative QL).eval₂ ι y₀ ≠ 0 := by
      have := hsimple y₀ hy₀
      rw [hQ, Polynomial.derivative_map, Polynomial.eval_map] at this
      exact this
    have hsepy : IsSeparable L y₀ := by
      have hg0 : QL ≠ 0 := by
        rintro hz
        rw [hz, Polynomial.derivative_zero, Polynomial.eval₂_zero] at hsimple'
        exact hsimple' rfl
      have hint : IsIntegral L y₀ := IsAlgebraic.isIntegral ⟨QL, hg0, haev⟩
      obtain ⟨q, hq⟩ := minpoly.dvd L y₀ haev
      have hmin : (minpoly L y₀).eval₂ ι y₀ = 0 := by
        have := minpoly.aeval L y₀
        rw [Polynomial.aeval_def] at this
        exact this
      have hd : (Polynomial.derivative QL).eval₂ ι y₀ =
          (Polynomial.derivative (minpoly L y₀)).eval₂ ι y₀ * q.eval₂ ι y₀ := by
        rw [hq, Polynomial.derivative_mul, Polynomial.eval₂_add, Polynomial.eval₂_mul,
          Polynomial.eval₂_mul, hmin, zero_mul, add_zero]
      have hmd : Polynomial.derivative (minpoly L y₀) ≠ 0 := by
        intro hz
        rw [hd, hz, Polynomial.eval₂_zero, zero_mul] at hsimple'
        exact hsimple' rfl
      exact (Polynomial.separable_iff_derivative_ne_zero (minpoly.irreducible hint)).mpr hmd
    
    have hmem : y₀ ∈ L := mem_of_fixed_of_separable L y₀ hsepy hfix
    set y : L := ⟨y₀, hmem⟩ with hy
    have hιy : ι y = y₀ := rfl
    have hPy : P.eval y = (u : L) := by
      have e : ι (QL.eval y) = 0 := by
        rw [← Polynomial.eval₂_at_apply, hιy]
        exact hr0'
      rw [map_eq_zero_iff ι hιinj, hQL, Polynomial.eval_sub, Polynomial.eval_C, sub_eq_zero] at e
      exact e
    rw [hPev y] at hPy
    refine ⟨⟨((1 + y • θ : IntermediateField.extendScalars h) : AlgebraicClosure F),
      (IntermediateField.mem_extendScalars h).mp (1 + y • θ).2⟩, ?_⟩
    rw [← hPy]
    rfl
  
  have hgen : ∀ u : Lˣ, ((u : L) = 1 ∨
      ((a₀ + 1 : ℕ) : ℤ) ≤ EllipticRootNumber.valL F L ((u : L) - 1)) →
      u ∈ (Units.map (EllipticRootNumber.normLM F h)).range := by
    intro u hu
    by_cases hx : (u : L) - 1 = 0
    · have hu1 : u = 1 := Units.ext (by rw [Units.val_one]; exact sub_eq_zero.mp hx)
      rw [hu1]
      exact one_mem _
    · have hval : ((a₀ + 1 : ℕ) : ℤ) ≤ EllipticRootNumber.valL F L ((u : L) - 1) := by
        rcases hu with hu | hu
        · exact absurd (sub_eq_zero.mpr hu) hx
        · exact hu
      obtain ⟨m, hm⟩ := hmain u hx hval
      have hm0 : m ≠ 0 := by
        rintro rfl
        have h0 : EllipticRootNumber.normLM F h (0 : M) = 0 := by
          show Algebra.norm L (EllipticRootNumber.toExtendScalars F h 0) = 0
          rw [map_zero, Algebra.norm_zero]
        rw [h0] at hm
        exact u.ne_zero hm.symm
      refine ⟨Units.mk0 m hm0, Units.ext ?_⟩
      rw [Units.coe_map, Units.val_mk0]
      exact hm
  have hle : EllipticRootNumber.unitGroup F L (a₀ + 1) ≤
      (Units.map (EllipticRootNumber.normLM F h)).range := by
    unfold EllipticRootNumber.unitGroup
    rw [Subgroup.closure_le]
    intro u hu
    have hu' : (u : L) = 1 ∨ ((a₀ + 1 : ℕ) : ℤ) ≤ EllipticRootNumber.valL F L ((u : L) - 1) := by
      have := hu
      simp only [Set.mem_setOf_eq, Nat.add_one_ne_zero, if_false] at this
      exact this
    exact hgen u hu'
  refine ⟨a₀ + 1, Nat.succ_pos a₀, ?_⟩
  intro u hu
  obtain ⟨m, hm⟩ := hle hu
  refine ⟨(m : M), ?_⟩
  rw [← hm, Units.coe_map]

theorem exists_abelianExt_commutator_cover (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (hdense : ∀ N : IntermediateField F (AlgebraicClosure F), FiniteDimensional F N → Normal F N →
      ∀ σ : EllipticRootNumber.AbsGal F,
        ∃ w ∈ EllipticRootNumber.weilGroup F, ∀ x ∈ N, w x = σ x)
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (U : Set (EllipticRootNumber.AbsGal F)) (hU : U ∈ nhds (1 : EllipticRootNumber.AbsGal F)) :
    ∃ (M : IntermediateField F (AlgebraicClosure F)) (h : L ≤ M),
      FiniteDimensional F M ∧ EllipticRootNumber.IsAbelianExt F h ∧
      ∀ g ∈ EllipticRootNumber.relWeil F L, g ∈ M.fixingSubgroup →
        ∃ c ∈ ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆, c⁻¹ * g ∈ U :=
by
  classical
  
  obtain ⟨N, hNfin, hNgal, hNU⟩ : ∃ N : IntermediateField F (AlgebraicClosure F),
      FiniteDimensional F N ∧ IsGalois F N ∧ ∀ σ ∈ N.fixingSubgroup, σ ∈ U := by
    obtain ⟨E, hE, hEU⟩ := (krullTopology_mem_nhds_one_iff F (AlgebraicClosure F) U).mp hU
    let Sc := separableClosure F (AlgebraicClosure F)
    let Es := E ⊓ Sc
    have hEsE : Es ≤ E := inf_le_left
    haveI : FiniteDimensional F Es :=
      FiniteDimensional.of_injective (IntermediateField.inclusion hEsE).toLinearMap
        (IntermediateField.inclusion hEsE).injective
    let N := IntermediateField.normalClosure F Es (AlgebraicClosure F)
    haveI : FiniteDimensional F N := normalClosure.is_finiteDimensional F Es (AlgebraicClosure F)
    haveI : Normal F N := normalClosure.normal F Es (AlgebraicClosure F)
    haveI : IsGalois F Sc := separableClosure.isGalois F (AlgebraicClosure F)
    have hNSc : N ≤ Sc := IntermediateField.normalClosure_le_iff_of_normal.mpr inf_le_right
    haveI : Algebra.IsSeparable F N :=
      Algebra.IsSeparable.of_algHom F Sc (IntermediateField.inclusion hNSc)
    refine ⟨N, inferInstance, IsGalois.mk, ?_⟩
    intro σ hσ
    apply hEU
    have hσs : σ ∈ Es.fixingSubgroup :=
      IntermediateField.fixingSubgroup_le (IntermediateField.le_normalClosure Es) hσ
    rw [SetLike.mem_coe, IntermediateField.mem_fixingSubgroup_iff]
    rw [IntermediateField.mem_fixingSubgroup_iff] at hσs
    intro x hx
    haveI : ExpChar F (ringExpChar F) := ringExpChar.expChar F
    haveI : ExpChar (AlgebraicClosure F) (ringExpChar F) :=
      expChar_of_injective_algebraMap (algebraMap F _).injective _
    haveI : ExpChar Sc (ringExpChar F) :=
      expChar_of_injective_algebraMap (algebraMap F Sc).injective _
    obtain ⟨n, y, hy⟩ := IsPurelyInseparable.pow_mem Sc (ringExpChar F) x
    have hxs : x ^ ringExpChar F ^ n ∈ Es := by
      refine ⟨pow_mem hx _, ?_⟩
      rw [← hy]
      exact y.2
    have h1 := hσs _ hxs
    rw [map_pow] at h1
    apply iterateFrobenius_inj (AlgebraicClosure F) (ringExpChar F) n
    rw [iterateFrobenius_def, iterateFrobenius_def]
    exact h1
  haveI := hNfin
  haveI := hNgal
  haveI : Normal F N := IsGalois.to_normal
  haveI : Algebra.IsSeparable F N := IsGalois.to_isSeparable
  
  let r : EllipticRootNumber.AbsGal F →* (N ≃ₐ[F] N) := AlgEquiv.restrictNormalHom N
  have hr : ∀ (σ : EllipticRootNumber.AbsGal F) (y : N),
      ((r σ y : N) : AlgebraicClosure F) = σ y :=
    fun σ y => AlgEquiv.restrictNormalHom_apply _ σ y
  let Hb : Subgroup (N ≃ₐ[F] N) := L.fixingSubgroup.map r
  let Kb : Subgroup (N ≃ₐ[F] N) := ⁅Hb, Hb⁆
  let M₀ : IntermediateField F (AlgebraicClosure F) :=
    IntermediateField.lift (IntermediateField.fixedField Kb)
  have hM₀N : M₀ ≤ N := IntermediateField.lift_le _
  
  have KF : ∀ σ : EllipticRootNumber.AbsGal F, σ ∈ M₀.fixingSubgroup ↔ r σ ∈ Kb := by
    intro σ
    conv_rhs => rw [← IntermediateField.fixingSubgroup_fixedField Kb]
    simp only [IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro h y hy
      apply Subtype.ext
      rw [hr]
      exact h _ ((IntermediateField.mem_lift y).mpr hy)
    · intro h z hz
      have hzN : z ∈ N := IntermediateField.lift_le _ hz
      have hy : (⟨z, hzN⟩ : N) ∈ IntermediateField.fixedField Kb :=
        (IntermediateField.mem_lift (⟨z, hzN⟩ : N)).mp hz
      have := congrArg Subtype.val (h _ hy)
      rw [hr] at this
      exact this
  have KF0 : ∀ σ : EllipticRootNumber.AbsGal F, r σ = 1 → σ ∈ N.fixingSubgroup := by
    intro σ h
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    have := hr σ ⟨x, hx⟩
    rw [h, AlgEquiv.one_apply] at this
    exact this.symm
  have hGM : (L ⊔ M₀).fixingSubgroup = L.fixingSubgroup ⊓ M₀.fixingSubgroup :=
    IntermediateField.fixingSubgroup_sup
  have hb : ∀ σ ∈ L.fixingSubgroup, ∀ τ ∈ L.fixingSubgroup,
      σ * τ * σ⁻¹ * τ⁻¹ ∈ (L ⊔ M₀).fixingSubgroup := by
    intro σ hσ τ hτ
    rw [hGM]
    refine Subgroup.mem_inf.mpr ⟨?_, ?_⟩
    · exact mul_mem (mul_mem (mul_mem hσ hτ) (inv_mem hσ)) (inv_mem hτ)
    · rw [KF]
      have e : r (σ * τ * σ⁻¹ * τ⁻¹) = ⁅r σ, r τ⁆ := by
        rw [commutatorElement_def]
        simp only [map_mul, map_inv]
      rw [e]
      exact Subgroup.commutator_mem_commutator (Subgroup.mem_map_of_mem r hσ)
        (Subgroup.mem_map_of_mem r hτ)
  refine ⟨L ⊔ M₀, le_sup_left, ?_, ⟨?_, hb, ?_⟩, ?_⟩
  · 
    have hle : L ⊔ M₀ ≤ L ⊔ N := sup_le_sup_left hM₀N L
    haveI : FiniteDimensional F ↥(L ⊔ N) := IntermediateField.finiteDimensional_sup L N
    exact FiniteDimensional.of_injective (IntermediateField.inclusion hle).toLinearMap
      (IntermediateField.inclusion hle).injective
  · 
    intro σ hσ τ hτ
    have hτL : τ ∈ L.fixingSubgroup := by
      rw [hGM] at hτ
      exact (Subgroup.mem_inf.mp hτ).1
    have e : σ * τ * σ⁻¹ = (σ * τ * σ⁻¹ * τ⁻¹) * τ := by group
    rw [e]
    exact mul_mem (hb σ hσ τ hτL) hτ
  · 
    let S := separableClosure L (AlgebraicClosure F)
    have hle : L ⊔ M₀ ≤ S.restrictScalars F := by
      apply sup_le
      · intro x hx
        rw [IntermediateField.mem_restrictScalars]
        exact S.algebraMap_mem ⟨x, hx⟩
      · intro x hx
        rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
        have hxN : x ∈ N := hM₀N hx
        have h2 : IsSeparable F x := by
          have h1 : IsSeparable F (⟨x, hxN⟩ : N) := Algebra.IsSeparable.isSeparable F _
          have h3 := IntermediateField.minpoly_eq (⟨x, hxN⟩ : N)
          unfold IsSeparable at h1 ⊢
          rw [h3] at h1
          exact h1
        exact IsSeparable.tower_top L h2
    have hle' : IntermediateField.extendScalars (le_sup_left : L ≤ L ⊔ M₀) ≤ S := fun x hx =>
      (IntermediateField.mem_restrictScalars F).mp
        (hle ((IntermediateField.mem_extendScalars _).mp hx))
    exact Algebra.IsSeparable.of_algHom L S (IntermediateField.inclusion hle')
  · 
    intro g hg hgM
    have hgM₀ : g ∈ M₀.fixingSubgroup := by
      rw [hGM] at hgM
      exact (Subgroup.mem_inf.mp hgM).2
    have hrg : r g ∈ Kb := (KF g).mp hgM₀
    
    have s2 : ∀ σ : EllipticRootNumber.AbsGal F, σ ∈ L.fixingSubgroup →
        ∃ w ∈ EllipticRootNumber.relWeil F L, ∀ x ∈ N, w x = σ x := by
      intro σ hσ
      haveI : FiniteDimensional F ↥(L ⊔ N) := IntermediateField.finiteDimensional_sup L N
      obtain ⟨w, hw, hwσ⟩ := hdense (IntermediateField.normalClosure F ↥(L ⊔ N) (AlgebraicClosure F))
        (normalClosure.is_finiteDimensional F _ _) (normalClosure.normal F _ _) σ
      have hle : L ⊔ N ≤ IntermediateField.normalClosure F ↥(L ⊔ N) (AlgebraicClosure F) :=
        IntermediateField.le_normalClosure _
      refine ⟨w, Subgroup.mem_inf.mpr ⟨hw, ?_⟩, fun x hx => hwσ x (hle (le_sup_right (a := L) hx))⟩
      rw [IntermediateField.mem_fixingSubgroup_iff] at hσ ⊢
      intro x hx
      rw [hwσ x (hle (le_sup_left (b := N) hx))]
      exact hσ x hx
    have hHW : Hb ≤ (EllipticRootNumber.relWeil F L).map r := by
      rintro _ ⟨σ, hσ, rfl⟩
      obtain ⟨w, hw, hwσ⟩ := s2 σ hσ
      refine ⟨w, hw, ?_⟩
      apply AlgEquiv.ext
      intro y
      apply Subtype.ext
      rw [hr, hr]
      exact hwσ y y.2
    have hK : Kb ≤ (⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆).map r := by
      rw [Subgroup.map_commutator]
      exact Subgroup.commutator_mono hHW hHW
    obtain ⟨c, hc, hcg⟩ := Subgroup.mem_map.mp (hK hrg)
    refine ⟨c, hc, hNU _ (KF0 _ ?_)⟩
    rw [map_mul, map_inv, hcg, inv_mul_cancel]

theorem charRec_trivial_on_unitGroup (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : EllipticRootNumber.LocalReciprocity F)
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (χ : EllipticRootNumber.relWeil F L →* (EllipticRootNumber.Ω F)ˣ)
    (hχ : EllipticRootNumber.IsWeilRep F L (EllipticRootNumber.charRep F L χ))
    (χ' : Lˣ →* (EllipticRootNumber.Ω F)ˣ) (hχ' : ∀ x : Lˣ, χ' x = χ (rec.recMap L x)) :
    ∃ a : ℕ, ∀ u ∈ EllipticRootNumber.unitGroup F L a, χ' u = 1 :=
by
  
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : EllipticRootNumber.AbsGal F, EllipticRootNumber.ActsAsFrobPow F Φ 1 := by
    obtain ⟨-, hmul, x, hx1⟩ := relVal_bot_spec F
    have hx : x ≠ 0 := by
      rintro rfl
      have h0 : EllipticRootNumber.relVal F ⊥
          (0 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
        unfold EllipticRootNumber.relVal
        rw [Algebra.norm_zero]
        unfold EllipticRootNumber.addVal
        simp
      rw [h0] at hx1
      exact zero_ne_one hx1
    have hinv : EllipticRootNumber.relVal F ⊥ x⁻¹ = -1 := by
      have h := hmul x x⁻¹ hx (inv_ne_zero hx)
      rw [mul_inv_cancel₀ hx, hx1] at h
      have h1 := hmul 1 1 one_ne_zero one_ne_zero
      rw [mul_one] at h1
      omega
    have hd := rec.degree_rec ⊥ (Units.mk0 x hx)⁻¹
    have hval : (((Units.mk0 x hx)⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) = x⁻¹ := by
      rw [Units.val_inv_eq_inv_val, Units.val_mk0]
    rw [hval, hinv, neg_neg] at hd
    obtain ⟨hspec1, hspec2⟩ := weilDegreeHom_spec_of_localField F
    obtain ⟨n, hn⟩ := hspec1 _ (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥)
      (rec.recMap ⊥ (Units.mk0 x hx)⁻¹)).2
    have hn' := hspec2 _ n hn
    rw [hd] at hn'
    have hn1 : (1 : ℤ) = n := Multiplicative.ofAdd.injective hn'
    subst hn1
    exact ⟨_, hn⟩
  
  have hdense : ∀ N : IntermediateField F (AlgebraicClosure F), FiniteDimensional F N →
      Normal F N → ∀ σ : EllipticRootNumber.AbsGal F,
        ∃ w ∈ EllipticRootNumber.weilGroup F, ∀ x ∈ N, w x = σ x := by
    intro N hN hNn σ
    haveI := hN
    haveI := hNn
    exact weilGroup_restrict_surj F Φ hΦ N σ
  
  obtain ⟨-, U, hU, hUχ⟩ := hχ
  have key : ∀ w : EllipticRootNumber.relWeil F L, (w : EllipticRootNumber.AbsGal F) ∈ U →
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → χ w = 1 := by
    intro w hw1 hw2
    have h := hUχ w hw1 hw2
    have h' := LinearMap.congr_fun h (ULift.up (1 : EllipticRootNumber.Ω F))
    have h'' := congrArg ULift.down h'
    apply Units.ext
    simpa [EllipticRootNumber.charRep] using h''
  
  have hHH : ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆ ≤
      EllipticRootNumber.relWeil F L := by
    rw [Subgroup.commutator_le]
    intro g₁ h₁ g₂ h₂
    rw [commutatorElement_def]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ h₁ h₂)
      (Subgroup.inv_mem _ h₁)) (Subgroup.inv_mem _ h₂)
  have hHI : ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆ ≤
      EllipticRootNumber.inertia F := by
    rw [Subgroup.commutator_le]
    intro g₁ h₁ g₂ h₂
    have hdeg : EllipticRootNumber.weilDegreeHom F
        ⁅(⟨g₁, EllipticRootNumber.relWeil_le_weilGroup F L h₁⟩ : EllipticRootNumber.weilGroup F),
          (⟨g₂, EllipticRootNumber.relWeil_le_weilGroup F L h₂⟩ :
            EllipticRootNumber.weilGroup F)⁆ = 1 := by
      rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
      exact mul_comm _ _
    exact weilDegreeHom_ker_le_inertia F _ hdeg
  have hχcomm : ∀ c ∈ ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆,
      ∀ hc : c ∈ EllipticRootNumber.relWeil F L, χ ⟨c, hc⟩ = 1 := by
    have hle : ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆ ≤
        χ.ker.map (EllipticRootNumber.relWeil F L).subtype := by
      rw [Subgroup.commutator_le]
      intro g₁ h₁ g₂ h₂
      refine Subgroup.mem_map.mpr ⟨⁅(⟨g₁, h₁⟩ : EllipticRootNumber.relWeil F L), ⟨g₂, h₂⟩⁆, ?_, rfl⟩
      rw [MonoidHom.mem_ker, map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
      exact mul_comm _ _
    intro c hc hcH
    obtain ⟨k, hk, hkc⟩ := Subgroup.mem_map.mp (hle hc)
    have hk' : k = ⟨c, hcH⟩ := Subtype.ext hkc
    rw [← hk']
    exact hk
  
  obtain ⟨M, h, hMfin, hab, hcov⟩ := exists_abelianExt_commutator_cover F hdense L U hU
  haveI := hMfin
  obtain ⟨a, ha, hnorm⟩ := unitGroup_le_range_normLM F L M h hab.2.2
  refine ⟨a, fun u hu => ?_⟩
  have hgM : ((rec.recMap L u : EllipticRootNumber.relWeil F L) : EllipticRootNumber.AbsGal F) ∈
      M.fixingSubgroup := (rec.ker_rec L M h hab u).mpr (hnorm u hu)
  have hgI : ((rec.recMap L u : EllipticRootNumber.relWeil F L) : EllipticRootNumber.AbsGal F) ∈
      EllipticRootNumber.inertia F := by
    have hd := rec.degree_rec L u
    rw [relVal_eq_zero_of_mem_unitGroup F L a ha u hu, neg_zero, ofAdd_zero] at hd
    exact weilDegreeHom_ker_le_inertia F _ hd
  obtain ⟨c, hc, hcU⟩ := hcov _ (rec.recMap L u).2 hgM
  have hcH : c ∈ EllipticRootNumber.relWeil F L := hHH hc
  have hcI : c ∈ EllipticRootNumber.inertia F := hHI hc
  have hχc : χ ⟨c, hcH⟩ = 1 := hχcomm c hc hcH
  have hn : χ ((⟨c, hcH⟩ : EllipticRootNumber.relWeil F L)⁻¹ * rec.recMap L u) = 1 :=
    key _ hcU ((EllipticRootNumber.inertia F).mul_mem
      ((EllipticRootNumber.inertia F).inv_mem hcI) hgI)
  rw [hχ']
  calc χ (rec.recMap L u)
      = χ ((⟨c, hcH⟩ : EllipticRootNumber.relWeil F L) *
          ((⟨c, hcH⟩ : EllipticRootNumber.relWeil F L)⁻¹ * rec.recMap L u)) := by
        rw [mul_inv_cancel_left]
    _ = 1 := by rw [map_mul, hχc, hn, one_mul]

theorem localConstants_transport {F₁ F₂ : Type u} [Field F₁] [Field F₂]
    [ValuativeRel F₁] [TopologicalSpace F₁] [IsNonarchimedeanLocalField F₁]
    [ValuativeRel F₂] [TopologicalSpace F₂] [IsNonarchimedeanLocalField F₂]
    (τ : F₁ ≃+* F₂)
    (hS : ∀ x : F₁, ValuativeRel.valuation F₂ (τ x) ≤ 1 ↔ ValuativeRel.valuation F₁ x ≤ 1)
    (τb : AlgebraicClosure F₁ ≃+* AlgebraicClosure F₂)
    (hτb : ∀ x : F₁, τb (algebraMap F₁ (AlgebraicClosure F₁) x) =
        algebraMap F₂ (AlgebraicClosure F₂) (τ x))
    (κ : EllipticRootNumber.AbsGal F₁ ≃* EllipticRootNumber.AbsGal F₂)
    (hκ : ∀ σ x, κ σ (τb x) = τb (σ x))
    (ι : EllipticRootNumber.Ω F₁ ≃+* EllipticRootNumber.Ω F₂)
    (rec₁ : EllipticRootNumber.LocalReciprocity F₁)
    (rec₂ : EllipticRootNumber.LocalReciprocity F₂)
    (hrec : ∀ (L₁ : IntermediateField F₁ (AlgebraicClosure F₁))
      (L₂ : IntermediateField F₂ (AlgebraicClosure F₂)), (∀ y, y ∈ L₂ ↔ τb.symm y ∈ L₁) →
      ∀ (x₁ : L₁ˣ) (x₂ : L₂ˣ),
        ((x₂ : L₂) : AlgebraicClosure F₂) = τb ((x₁ : L₁) : AlgebraicClosure F₁) →
        ((rec₂.recMap L₂ x₂ : EllipticRootNumber.relWeil F₂ L₂) :
            EllipticRootNumber.AbsGal F₂) =
          κ (rec₁.recMap L₁ x₁ : EllipticRootNumber.AbsGal F₁))
    (lc₂ : EllipticRootNumber.LocalConstants F₂ rec₂) :
    ∃ lc₁ : EllipticRootNumber.LocalConstants F₁ rec₁,
      ∀ (L₁ : IntermediateField F₁ (AlgebraicClosure F₁))
        (L₂ : IntermediateField F₂ (AlgebraicClosure F₂)), (∀ y, y ∈ L₂ ↔ τb.symm y ∈ L₁) →
        [FiniteDimensional F₁ L₁] →
        ∀ {V₁ V₂ : Type u} [AddCommGroup V₁] [Module (EllipticRootNumber.Ω F₁) V₁]
          [AddCommGroup V₂] [Module (EllipticRootNumber.Ω F₂) V₂]
          (ρ₁ : Representation (EllipticRootNumber.Ω F₁) (EllipticRootNumber.relWeil F₁ L₁) V₁)
          (ρ₂ : Representation (EllipticRootNumber.Ω F₂) (EllipticRootNumber.relWeil F₂ L₂) V₂)
          (e : V₁ ≃+ V₂), (∀ (c : EllipticRootNumber.Ω F₁) (v : V₁), e (c • v) = ι c • e v) →
          (∀ (w₁ : EllipticRootNumber.relWeil F₁ L₁) (w₂ : EllipticRootNumber.relWeil F₂ L₂),
             (w₂ : EllipticRootNumber.AbsGal F₂) = κ w₁ → ∀ v, e (ρ₁ w₁ v) = ρ₂ w₂ (e v)) →
          ∀ (ψ₁ : AddChar L₁ (EllipticRootNumber.Ω F₁)) (ψ₂ : AddChar L₂ (EllipticRootNumber.Ω F₂)),
          (∀ (x₁ : L₁) (x₂ : L₂), (x₂ : AlgebraicClosure F₂) = τb (x₁ : AlgebraicClosure F₁) →
             ψ₂ x₂ = ι (ψ₁ x₁)) →
          EllipticRootNumber.IsWeilRep F₁ L₁ ρ₁ → EllipticRootNumber.IsAdmissibleChar F₁ L₁ ψ₁ →
          ((lc₂.eps L₂ ρ₂ ψ₂ : (EllipticRootNumber.Ω F₂)ˣ) : EllipticRootNumber.Ω F₂) =
            ι ((lc₁.eps L₁ ρ₁ ψ₁ : (EllipticRootNumber.Ω F₁)ˣ) : EllipticRootNumber.Ω F₁) :=
by
  classical
  obtain ⟨hq, hp, hv, -⟩ := ringEquiv_localField_invariants τ hS
  obtain ⟨hI, -, hWG, hFix⟩ := galConj_naturality τb κ hκ hp hq
  obtain ⟨hEx, hT⟩ := intermediateField_transport τ hv τb hτb
  have hU : ∀ U : Set (EllipticRootNumber.AbsGal F₁),
      U ∈ nhds (1 : EllipticRootNumber.AbsGal F₁) →
      κ '' U ∈ nhds (1 : EllipticRootNumber.AbsGal F₂) :=
    fun U hU => (galConj_nhds_one τ τb hτb κ hκ U).mp hU
  have hRW : ∀ (L₁ : IntermediateField F₁ (AlgebraicClosure F₁))
      (L₂ : IntermediateField F₂ (AlgebraicClosure F₂)), (∀ y, y ∈ L₂ ↔ τb.symm y ∈ L₁) →
      ∀ σ, κ σ ∈ EllipticRootNumber.relWeil F₂ L₂ ↔ σ ∈ EllipticRootNumber.relWeil F₁ L₁ := by
    intro L₁ L₂ hL σ
    simp only [EllipticRootNumber.relWeil, Subgroup.mem_inf]
    rw [hWG σ, hFix L₁ L₂ hL σ]
  choose T hT' using hEx
  
  let rL : ∀ L : IntermediateField F₁ (AlgebraicClosure F₁), T L →+* L := fun L =>
    { toFun := fun y => ⟨τb.symm y, (hT' L y).mp y.2⟩
      map_one' := Subtype.ext (map_one τb.symm)
      map_mul' := fun a b => Subtype.ext
        (map_mul τb.symm (a : AlgebraicClosure F₂) (b : AlgebraicClosure F₂))
      map_zero' := Subtype.ext (map_zero τb.symm)
      map_add' := fun a b => Subtype.ext
        (map_add τb.symm (a : AlgebraicClosure F₂) (b : AlgebraicClosure F₂)) }
  have hrL : ∀ (L : IntermediateField F₁ (AlgebraicClosure F₁)) (y : T L),
      ((rL L y : L) : AlgebraicClosure F₁) = τb.symm y :=
    fun _ _ => rfl
  
  let kL : ∀ L : IntermediateField F₁ (AlgebraicClosure F₁),
      EllipticRootNumber.relWeil F₂ (T L) →* EllipticRootNumber.relWeil F₁ L := fun L =>
    { toFun := fun g => ⟨κ.symm g, (hRW L (T L) (hT' L) (κ.symm g)).mp
        (by rw [MulEquiv.apply_symm_apply]; exact g.2)⟩
      map_one' := Subtype.ext (map_one κ.symm)
      map_mul' := fun a b => Subtype.ext
        (map_mul κ.symm (a : EllipticRootNumber.AbsGal F₂) (b : EllipticRootNumber.AbsGal F₂)) }
  have hkL : ∀ (L : IntermediateField F₁ (AlgebraicClosure F₁))
      (g : EllipticRootNumber.relWeil F₂ (T L)),
      ((kL L g : EllipticRootNumber.relWeil F₁ L) : EllipticRootNumber.AbsGal F₁) =
        κ.symm g := fun _ _ => rfl
  have hkL' : ∀ (L : IntermediateField F₁ (AlgebraicClosure F₁))
      (w₁ : EllipticRootNumber.relWeil F₁ L)
      (w₂ : EllipticRootNumber.relWeil F₂ (T L)),
      (w₂ : EllipticRootNumber.AbsGal F₂) = κ w₁ → kL L w₂ = w₁ := by
    intro L w₁ w₂ h
    apply Subtype.ext
    rw [hkL, h, MulEquiv.symm_apply_apply]
  
  let chT : ∀ L : IntermediateField F₁ (AlgebraicClosure F₁),
      AddChar L (EllipticRootNumber.Ω F₁) → AddChar (T L) (EllipticRootNumber.Ω F₂) :=
    fun L ψ => ι.toMonoidHom.compAddChar (ψ.compAddMonoidHom (rL L).toAddMonoidHom)
  have hchT : ∀ (L : IntermediateField F₁ (AlgebraicClosure F₁))
      (ψ : AddChar L (EllipticRootNumber.Ω F₁)) (y : T L),
      chT L ψ y = ι (ψ (rL L y)) := fun _ _ _ => rfl
  
  let eps₁ : ∀ (L : IntermediateField F₁ (AlgebraicClosure F₁)) {V : Type u} [AddCommGroup V]
      [Module (EllipticRootNumber.Ω F₁) V],
      Representation (EllipticRootNumber.Ω F₁) (EllipticRootNumber.relWeil F₁ L) V →
      AddChar L (EllipticRootNumber.Ω F₁) → (EllipticRootNumber.Ω F₁)ˣ :=
    fun L V _ _ ρ ψ => Units.map ι.symm.toMonoidHom
      (lc₂.eps (T L) (ellTwistRep ι (kL L) ρ) (chT L ψ))
  have heps₁ : ∀ (L : IntermediateField F₁ (AlgebraicClosure F₁)) {V : Type u}
      [AddCommGroup V] [Module (EllipticRootNumber.Ω F₁) V]
      (ρ : Representation (EllipticRootNumber.Ω F₁) (EllipticRootNumber.relWeil F₁ L) V)
      (ψ : AddChar L (EllipticRootNumber.Ω F₁)),
      ι ((eps₁ L ρ ψ : (EllipticRootNumber.Ω F₁)ˣ) : EllipticRootNumber.Ω F₁) =
        ((lc₂.eps (T L) (ellTwistRep ι (kL L) ρ) (chT L ψ) : (EllipticRootNumber.Ω F₂)ˣ) :
          EllipticRootNumber.Ω F₂) := by
    intro L V _ _ ρ ψ
    exact ι.apply_symm_apply _
  
  have hWT : ∀ (L : IntermediateField F₁ (AlgebraicClosure F₁)) {V : Type u}
      [AddCommGroup V] [Module (EllipticRootNumber.Ω F₁) V]
      (ρ : Representation (EllipticRootNumber.Ω F₁) (EllipticRootNumber.relWeil F₁ L) V),
      EllipticRootNumber.IsWeilRep F₁ L ρ →
      EllipticRootNumber.IsWeilRep F₂ (T L) (ellTwistRep ι (kL L) ρ) := by
    intro L V _ _ ρ hρ
    refine isWeilRep_transport κ hI hU L (T L) (hRW L (T L) (hT' L)) ι ρ
      (ellTwistRep ι (kL L) ρ) (EllTwist.equiv ι V) (fun c v => ?_) (fun w₁ w₂ hw v => ?_) hρ
    · show c • v = ι.symm (ι c) • v
      rw [RingEquiv.symm_apply_apply]
    · show ρ w₁ v = ρ (kL L w₂) v
      rw [hkL' L w₁ w₂ hw]
  
  have hAdmT : ∀ (L : IntermediateField F₁ (AlgebraicClosure F₁))
      (ψ : AddChar L (EllipticRootNumber.Ω F₁)),
      EllipticRootNumber.IsAdmissibleChar F₁ L ψ →
      EllipticRootNumber.IsAdmissibleChar F₂ (T L) (chT L ψ) := by
    intro L ψ hψ
    obtain ⟨hne, d, hd⟩ := hψ
    refine ⟨fun h => hne ?_, d, fun x hx => ?_⟩
    · ext x
      have hmem : τb (x : AlgebraicClosure F₁) ∈ T L :=
        (hT' L _).mpr (by rw [RingEquiv.symm_apply_apply]; exact x.2)
      have h1 := congrArg (fun φ : AddChar (T L) (EllipticRootNumber.Ω F₂) =>
        φ ⟨τb x, hmem⟩) h
      have hx : rL L ⟨τb x, hmem⟩ = x :=
        Subtype.ext (by rw [hrL]; exact RingEquiv.symm_apply_apply _ _)
      simp only [hchT, hx, AddChar.one_apply] at h1
      rw [AddChar.one_apply]
      exact ι.injective (h1.trans (map_one ι).symm)
    · rw [hchT]
      have hval := ((hT L (T L) (hT' L)).2.2.2 (rL L x) x
        (by rw [hrL, RingEquiv.apply_symm_apply])).2.2
      rw [hd _ (hval ▸ hx), map_one]
  
  have Rel : ∀ (L₁ : IntermediateField F₁ (AlgebraicClosure F₁))
        (L₂ : IntermediateField F₂ (AlgebraicClosure F₂)), (∀ y, y ∈ L₂ ↔ τb.symm y ∈ L₁) →
        [FiniteDimensional F₁ L₁] →
        ∀ {V₁ V₂ : Type u} [AddCommGroup V₁] [Module (EllipticRootNumber.Ω F₁) V₁]
          [AddCommGroup V₂] [Module (EllipticRootNumber.Ω F₂) V₂]
          (ρ₁ : Representation (EllipticRootNumber.Ω F₁) (EllipticRootNumber.relWeil F₁ L₁) V₁)
          (ρ₂ : Representation (EllipticRootNumber.Ω F₂) (EllipticRootNumber.relWeil F₂ L₂) V₂)
          (e : V₁ ≃+ V₂), (∀ (c : EllipticRootNumber.Ω F₁) (v : V₁), e (c • v) = ι c • e v) →
          (∀ (w₁ : EllipticRootNumber.relWeil F₁ L₁) (w₂ : EllipticRootNumber.relWeil F₂ L₂),
             (w₂ : EllipticRootNumber.AbsGal F₂) = κ w₁ → ∀ v, e (ρ₁ w₁ v) = ρ₂ w₂ (e v)) →
          ∀ (ψ₁ : AddChar L₁ (EllipticRootNumber.Ω F₁))
            (ψ₂ : AddChar L₂ (EllipticRootNumber.Ω F₂)),
          (∀ (x₁ : L₁) (x₂ : L₂), (x₂ : AlgebraicClosure F₂) = τb (x₁ : AlgebraicClosure F₁) →
             ψ₂ x₂ = ι (ψ₁ x₁)) →
          EllipticRootNumber.IsWeilRep F₁ L₁ ρ₁ → EllipticRootNumber.IsAdmissibleChar F₁ L₁ ψ₁ →
          ((lc₂.eps L₂ ρ₂ ψ₂ : (EllipticRootNumber.Ω F₂)ˣ) : EllipticRootNumber.Ω F₂) =
            ι ((eps₁ L₁ ρ₁ ψ₁ : (EllipticRootNumber.Ω F₁)ˣ) : EllipticRootNumber.Ω F₁) := by
    intro L₁ L₂ hL _ V₁ V₂ _ _ _ _ ρ₁ ρ₂ e he hρ ψ₁ ψ₂ hψ hW hadm
    obtain rfl : L₂ = T L₁ := SetLike.ext fun y => (hL y).trans (hT' L₁ y).symm
    have hψeq : ψ₂ = chT L₁ ψ₁ := by
      ext y
      rw [hchT]
      exact hψ _ _ (by rw [hrL, RingEquiv.apply_symm_apply])
    subst hψeq
    have hW₂ : EllipticRootNumber.IsWeilRep F₂ (T L₁) ρ₂ :=
      isWeilRep_transport κ hI hU L₁ (T L₁) (hRW _ _ hL) ι ρ₁ ρ₂ e he hρ hW
    haveI : FiniteDimensional F₂ (T L₁) := (hT L₁ (T L₁) hL).1.mp inferInstance
    let eι : EllTwist ι V₁ ≃ₗ[EllipticRootNumber.Ω F₂] V₂ :=
      { toFun := fun v => e v
        invFun := fun v => e.symm v
        left_inv := e.left_inv
        right_inv := e.right_inv
        map_add' := e.map_add
        map_smul' := fun c v => by
          show e (ι.symm c • (show V₁ from v)) = c • e v
          rw [he, RingEquiv.apply_symm_apply] }
    have hint : ∀ w, eι.toLinearMap ∘ₗ ellTwistRep ι (kL L₁) ρ₁ w = ρ₂ w ∘ₗ eι.toLinearMap := by
      intro w
      apply LinearMap.ext
      intro v
      show e (ρ₁ (kL L₁ w) v) = ρ₂ w (e v)
      exact hρ _ _ (by rw [hkL, MulEquiv.apply_symm_apply]) v
    have key := eps_eq_of_linearEquiv F₂ lc₂ (T L₁) (chT L₁ ψ₁) (hAdmT L₁ ψ₁ hadm)
      (ellTwistRep ι (kL L₁) ρ₁) ρ₂ (hWT L₁ ρ₁ hW) hW₂ eι hint
    rw [heps₁, key]
  refine ⟨⟨eps₁, ?_, ?_, ?_⟩, Rel⟩
  · 
    intro L _ ψ hψ V₁ V V₂ _ _ _ _ _ _ σ₁ σ σ₂ h₁ h h₂ f g hf hg hfi hgs hfg
    haveI : FiniteDimensional F₂ (T L) := (hT L (T L) (hT' L)).1.mp inferInstance
    have E := lc₂.eps_exact (T L) (chT L ψ) (hAdmT L ψ hψ) (ellTwistRep ι (kL L) σ₁)
      (ellTwistRep ι (kL L) σ) (ellTwistRep ι (kL L) σ₂) (hWT L σ₁ h₁) (hWT L σ h)
      (hWT L σ₂ h₂) (ellTwistLin ι f) (ellTwistLin ι g)
      (fun w => LinearMap.ext fun v => LinearMap.congr_fun (hf (kL L w)) v)
      (fun w => LinearMap.ext fun v => LinearMap.congr_fun (hg (kL L w)) v) hfi hgs
      (by ext v; exact SetLike.ext_iff.mp hfg v)
    show Units.map _ _ = Units.map _ _ * Units.map _ _
    rw [E, map_mul]
  · 
    intro L M _ h hsep ψ hψ V₁ V₂ _ _ _ _ σ₁ σ₂ h₁ h₂ hfin
    haveI : FiniteDimensional F₁ L :=
      FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
        (IntermediateField.inclusion h).injective
    have h₂' : T L ≤ T M := fun y hy => (hT' M y).mpr (h ((hT' L y).mp hy))
    haveI : FiniteDimensional F₂ (T M) := (hT M (T M) (hT' M)).1.mp inferInstance
    haveI : FiniteDimensional F₂ (T L) := (hT L (T L) (hT' L)).1.mp inferInstance
    obtain ⟨hpair, hsepI, -⟩ :=
      intermediateField_pair_transport τb κ hκ L M (T L) (T M) h h₂' (hT' L) (hT' M)
    have hrk : ∀ (V : Type u) [AddCommGroup V] [Module (EllipticRootNumber.Ω F₁) V],
        Module.finrank (EllipticRootNumber.Ω F₂) (EllTwist ι V) =
          Module.finrank (EllipticRootNumber.Ω F₁) V := by
      intro V _ _
      have := rank_eq_of_equiv_equiv (ι.symm : EllipticRootNumber.Ω F₂ → EllipticRootNumber.Ω F₁)
        (EllTwist.equiv ι V).symm ι.symm.bijective (fun c v => rfl)
      exact congrArg Cardinal.toNat this
    have E := lc₂.eps_ind (T L) (T M) h₂' (hsepI.mpr hsep) (chT L ψ) (hAdmT L ψ hψ)
      (ellTwistRep ι (kL M) σ₁) (ellTwistRep ι (kL M) σ₂) (hWT M σ₁ h₁) (hWT M σ₂ h₂)
      (by rw [hrk, hrk, hfin])
    have htr : chT M (EllipticRootNumber.traceChar F₁ h ψ) =
        EllipticRootNumber.traceChar F₂ h₂' (chT L ψ) := by
      ext y
      show ι (ψ (EllipticRootNumber.traceLM F₁ h (rL M y))) =
        ι (ψ (rL L (EllipticRootNumber.traceLM F₂ h₂' y)))
      congr 2
      apply Subtype.ext
      rw [hrL, (hpair (rL M y) y (by rw [hrL, RingEquiv.apply_symm_apply])).2,
        RingEquiv.symm_apply_apply]
    have hind : ∀ {V : Type u} [AddCommGroup V] [Module (EllipticRootNumber.Ω F₁) V]
        (σ : Representation (EllipticRootNumber.Ω F₁) (EllipticRootNumber.relWeil F₁ M) V),
        EllipticRootNumber.IsWeilRep F₁ M σ →
        ((lc₂.eps (T L) (EllipticRootNumber.indLM F₂ h₂' (ellTwistRep ι (kL M) σ)) (chT L ψ) :
            (EllipticRootNumber.Ω F₂)ˣ) : EllipticRootNumber.Ω F₂) =
          ι ((eps₁ L (EllipticRootNumber.indLM F₁ h σ) ψ : (EllipticRootNumber.Ω F₁)ˣ) :
            EllipticRootNumber.Ω F₁) := by
      intro V _ _ σ hσ
      obtain ⟨e', he', hρ'⟩ := indLM_transport κ L M (T L) (T M) h h₂'
        (hRW L (T L) (hT' L)) (hRW M (T M) (hT' M)) ι σ (ellTwistRep ι (kL M) σ)
        (EllTwist.equiv ι V)
        (fun c v => by
          show c • v = ι.symm (ι c) • v
          rw [RingEquiv.symm_apply_apply])
        (fun w₁ w₂ hw v => by
          show σ w₁ v = σ (kL M w₂) v
          rw [hkL' M w₁ w₂ hw])
      exact Rel L (T L) (hT' L) (EllipticRootNumber.indLM F₁ h σ)
        (EllipticRootNumber.indLM F₂ h₂' (ellTwistRep ι (kL M) σ)) e' he' hρ' ψ (chT L ψ)
        (fun x₁ x₂ hx => by
          rw [hchT]
          congr 2
          apply Subtype.ext
          rw [hrL, hx, RingEquiv.symm_apply_apply])
        (isWeilRep_indLM F₁ L M h σ hσ) hψ
    apply Units.ext
    apply ι.injective
    simp only [Units.val_mul, map_mul]
    rw [← hind σ₁ h₁, ← hind σ₂ h₂, heps₁, heps₁, htr]
    exact congrArg Units.val E
  · 
    intro L _ ψ hψ χ hχ χ' hχ'
    haveI : FiniteDimensional F₂ (T L) := (hT L (T L) (hT' L)).1.mp inferInstance
    let χ₂ : EllipticRootNumber.relWeil F₂ (T L) →* (EllipticRootNumber.Ω F₂)ˣ :=
      (Units.map ι.toMonoidHom).comp (χ.comp (kL L))
    let θ : (T L)ˣ →* Lˣ := Units.map (rL L).toMonoidHom
    let χ₂' : (T L)ˣ →* (EllipticRootNumber.Ω F₂)ˣ := (Units.map ι.toMonoidHom).comp (χ'.comp θ)
    have hθ : ∀ x₂ : (T L)ˣ, (((θ x₂ : L) : AlgebraicClosure F₁)) =
        τb.symm ((x₂ : T L) : AlgebraicClosure F₂) := fun _ => rfl
    have hχ₂' : ∀ x₂, χ₂' x₂ = χ₂ (rec₂.recMap (T L) x₂) := by
      intro x₂
      have hr := hrec L (T L) (hT' L) (θ x₂) x₂ (by rw [hθ, RingEquiv.apply_symm_apply])
      have hk : kL L (rec₂.recMap (T L) x₂) = rec₁.recMap L (θ x₂) :=
        Subtype.ext (by rw [hkL, hr, MulEquiv.symm_apply_apply])
      show Units.map ι.toMonoidHom (χ' (θ x₂)) =
        Units.map ι.toMonoidHom (χ (kL L (rec₂.recMap (T L) x₂)))
      rw [hk, hχ']
    let ec : ULift.{u} (EllipticRootNumber.Ω F₁) ≃+ ULift.{u} (EllipticRootNumber.Ω F₂) :=
      { toFun := fun a => ⟨ι a.down⟩
        invFun := fun b => ⟨ι.symm b.down⟩
        left_inv := fun a => ULift.ext _ _ (ι.symm_apply_apply a.down)
        right_inv := fun b => ULift.ext _ _ (ι.apply_symm_apply b.down)
        map_add' := fun a b => ULift.ext _ _ (map_add ι a.down b.down) }
    have hec : ∀ (c : EllipticRootNumber.Ω F₁) (v : ULift.{u} (EllipticRootNumber.Ω F₁)),
        ec (c • v) = ι c • ec v := fun c v => ULift.ext _ _ (map_mul ι c v.down)
    have hρc : ∀ (w₁ : EllipticRootNumber.relWeil F₁ L)
        (w₂ : EllipticRootNumber.relWeil F₂ (T L)),
        (w₂ : EllipticRootNumber.AbsGal F₂) = κ w₁ → ∀ v,
          ec (EllipticRootNumber.charRep F₁ L χ w₁ v) =
            EllipticRootNumber.charRep F₂ (T L) χ₂ w₂ (ec v) := by
      intro w₁ w₂ hw v
      apply ULift.ext
      show ι ((χ w₁ : EllipticRootNumber.Ω F₁) * v.down) =
        ((χ₂ w₂ : (EllipticRootNumber.Ω F₂)ˣ) : EllipticRootNumber.Ω F₂) * ι v.down
      rw [map_mul]
      show ι (χ w₁ : EllipticRootNumber.Ω F₁) * _ =
        ι (χ (kL L w₂) : EllipticRootNumber.Ω F₁) * _
      rw [hkL' L w₁ w₂ hw]
    have hWc₂ : EllipticRootNumber.IsWeilRep F₂ (T L) (EllipticRootNumber.charRep F₂ (T L) χ₂) :=
      isWeilRep_transport κ hI hU L (T L) (hRW L (T L) (hT' L)) ι
        (EllipticRootNumber.charRep F₁ L χ) (EllipticRootNumber.charRep F₂ (T L) χ₂) ec hec hρc hχ
    have hψc : ∀ (x₁ : L) (x₂ : T L), (x₂ : AlgebraicClosure F₂) = τb (x₁ : AlgebraicClosure F₁) →
        chT L ψ x₂ = ι (ψ x₁) := by
      intro x₁ x₂ hx
      rw [hchT]
      congr 2
      apply Subtype.ext
      rw [hrL, hx, RingEquiv.symm_apply_apply]
    have h1 := lc₂.eps_char (T L) (chT L ψ) (hAdmT L ψ hψ) χ₂ hWc₂ χ₂' hχ₂'
    have h2 := Rel L (T L) (hT' L) (EllipticRootNumber.charRep F₁ L χ)
      (EllipticRootNumber.charRep F₂ (T L) χ₂) ec hec hρc ψ (chT L ψ) hψc hχ hψ
    have hcont := charRec_trivial_on_unitGroup F₁ rec₁ L χ hχ χ' hχ'
    have hq' : EllipticRootNumber.qL F₂ (T L) = EllipticRootNumber.qL F₁ L := by
      unfold EllipticRootNumber.qL
      rw [hq, (hT L (T L) (hT' L)).2.2.1]
    have h3 := tateEps_transport τb L (T L) (hT' L) hq'
      (fun x₁ x₂ hx => ((hT L (T L) (hT' L)).2.2.2 x₁ x₂ hx).2.2) ι χ' χ₂'
      (fun x₁ x₂ hx => by
        have hθx : θ x₂ = x₁ :=
          Units.ext (Subtype.ext (by rw [hθ, hx, RingEquiv.symm_apply_apply]))
        show ι ((χ' (θ x₂) : (EllipticRootNumber.Ω F₁)ˣ) : EllipticRootNumber.Ω F₁) = _
        rw [hθx])
      ψ (chT L ψ) hψc hψ hcont
    apply ι.injective
    rw [← h2, h1, h3]

theorem pts_transport {F₁ F₂ : Type u} [Field F₁] [Field F₂]
    [ValuativeRel F₁] [TopologicalSpace F₁] [IsNonarchimedeanLocalField F₁]
    [ValuativeRel F₂] [TopologicalSpace F₂] [IsNonarchimedeanLocalField F₂]
    [DecidableEq (AlgebraicClosure F₁)] [DecidableEq (AlgebraicClosure F₂)]
    (τ : F₁ ≃+* F₂)
    (τb : AlgebraicClosure F₁ ≃+* AlgebraicClosure F₂)
    (hτb : ∀ x : F₁, τb (algebraMap F₁ (AlgebraicClosure F₁) x) =
        algebraMap F₂ (AlgebraicClosure F₂) (τ x))
    (κ : EllipticRootNumber.AbsGal F₁ ≃* EllipticRootNumber.AbsGal F₂)
    (hκ : ∀ σ x, κ σ (τb x) = τb (σ x)) (E : WeierstrassCurve F₁) :
    ∃ φ : EllipticRootNumber.Pts F₁ E ≃+ EllipticRootNumber.Pts F₂ (E.map (τ : F₁ →+* F₂)),
      ∀ (σ : EllipticRootNumber.AbsGal F₁) (P : EllipticRootNumber.Pts F₁ E),
        φ (EllipticRootNumber.galHom F₁ E σ P) =
          EllipticRootNumber.galHom F₂ (E.map (τ : F₁ →+* F₂)) (κ σ) (φ P) :=
by
  
  have gen : ∀ {K₁ K₂ : Type u} [Field K₁] [Field K₂] [DecidableEq K₁] [DecidableEq K₂]
      (f : K₁ →+* K₂) (W₁ : WeierstrassCurve K₁) (W₂ : WeierstrassCurve K₂), W₂ = W₁.map f →
      ∃ T : W₁.toAffine.Point →+ W₂.toAffine.Point,
        ∀ (x y : K₁) (h : W₁.toAffine.Nonsingular x y),
          ∃ h' : W₂.toAffine.Nonsingular (f x) (f y),
            T (WeierstrassCurve.Affine.Point.some h) = WeierstrassCurve.Affine.Point.some h' := by
    intro K₁ K₂ _ _ _ _ f W₁ W₂ hW
    subst hW
    have hinj : Function.Injective f := f.injective
    have hns : ∀ x y, W₁.toAffine.Nonsingular x y →
        (W₁.map f).toAffine.Nonsingular (f x) (f y) := fun x y h =>
      (WeierstrassCurve.Affine.map_nonsingular (W := W₁.toAffine) x y hinj).mpr h
    obtain ⟨T, hT0, hTs⟩ : ∃ T : W₁.toAffine.Point → (W₁.map f).toAffine.Point,
        T WeierstrassCurve.Affine.Point.zero = WeierstrassCurve.Affine.Point.zero ∧
        ∀ (x y : K₁) (h : W₁.toAffine.Nonsingular x y),
          T (WeierstrassCurve.Affine.Point.some h) =
            WeierstrassCurve.Affine.Point.some (hns x y h) :=
      ⟨fun P => match P with
        | .zero => .zero
        | @WeierstrassCurve.Affine.Point.some _ _ _ x y h => .some (hns x y h),
        rfl, fun _ _ _ => rfl⟩
    have hadd : ∀ P Q : W₁.toAffine.Point, T (P + Q) = T P + T Q := by
      intro P Q
      cases P with
      | zero =>
        show T (0 + Q) = T 0 + T Q
        rw [zero_add]
        show T Q = T WeierstrassCurve.Affine.Point.zero + T Q
        rw [hT0]
        exact (zero_add _).symm
      | @some x₁ y₁ h₁ =>
        cases Q with
        | zero =>
          show T (WeierstrassCurve.Affine.Point.some h₁ + 0) =
            T (WeierstrassCurve.Affine.Point.some h₁) + T 0
          rw [add_zero]
          show _ = _ + T WeierstrassCurve.Affine.Point.zero
          rw [hT0]
          exact (add_zero _).symm
        | @some x₂ y₂ h₂ =>
          by_cases hxy : x₁ = x₂ ∧ y₁ = W₁.toAffine.negY x₂ y₂
          · rw [WeierstrassCurve.Affine.Point.add_of_Y_eq hxy.1 hxy.2, hTs, hTs]
            rw [WeierstrassCurve.Affine.Point.add_of_Y_eq (congrArg f hxy.1)
              ((congrArg f hxy.2).trans
                (WeierstrassCurve.Affine.map_negY (W' := W₁.toAffine) f x₂ y₂).symm)]
            exact hT0
          · have hxy' : ¬(f x₁ = f x₂ ∧
                f y₁ = (W₁.map f).toAffine.negY (f x₂) (f y₂)) := by
              rintro ⟨e1, e2⟩
              exact hxy ⟨hinj e1,
                hinj (e2.trans (WeierstrassCurve.Affine.map_negY (W' := W₁.toAffine) f x₂ y₂))⟩
            rw [WeierstrassCurve.Affine.Point.add_some hxy, hTs, hTs, hTs,
              WeierstrassCurve.Affine.Point.add_some hxy', WeierstrassCurve.Affine.Point.some.injEq,
              WeierstrassCurve.Affine.map_slope (W := W₁.toAffine) f x₁ x₂ y₁ y₂]
            exact ⟨(WeierstrassCurve.Affine.map_addX (W' := W₁.toAffine) f _ _ _).symm,
              (WeierstrassCurve.Affine.map_addY (W' := W₁.toAffine) f _ _ _ _).symm⟩
    exact ⟨AddMonoidHom.mk' T hadd, fun x y h => ⟨hns x y h, hTs x y h⟩⟩
  
  have hW : (E.map (τ : F₁ →+* F₂)).baseChange (AlgebraicClosure F₂) =
      (E.baseChange (AlgebraicClosure F₁)).map
        (τb : AlgebraicClosure F₁ →+* AlgebraicClosure F₂) := by
    simp only [WeierstrassCurve.baseChange, WeierstrassCurve.map_map]
    congr 1
    ext x
    show algebraMap F₂ (AlgebraicClosure F₂) (τ x) = τb (algebraMap F₁ (AlgebraicClosure F₁) x)
    exact (hτb x).symm
  have hW' : E.baseChange (AlgebraicClosure F₁) =
      ((E.map (τ : F₁ →+* F₂)).baseChange (AlgebraicClosure F₂)).map
        (τb.symm : AlgebraicClosure F₂ →+* AlgebraicClosure F₁) := by
    rw [hW, WeierstrassCurve.map_map]
    have hid : (τb.symm : AlgebraicClosure F₂ →+* AlgebraicClosure F₁).comp
        (τb : AlgebraicClosure F₁ →+* AlgebraicClosure F₂) = RingHom.id _ :=
      RingHom.ext fun x => τb.symm_apply_apply x
    rw [hid, WeierstrassCurve.map_id]
  
  obtain ⟨T, hT⟩ := gen (τb : AlgebraicClosure F₁ →+* AlgebraicClosure F₂)
    (E.baseChange (AlgebraicClosure F₁))
    ((E.map (τ : F₁ →+* F₂)).baseChange (AlgebraicClosure F₂)) hW
  obtain ⟨S, hS⟩ := gen (τb.symm : AlgebraicClosure F₂ →+* AlgebraicClosure F₁)
    ((E.map (τ : F₁ →+* F₂)).baseChange (AlgebraicClosure F₂))
    (E.baseChange (AlgebraicClosure F₁)) hW'
  
  have hST : ∀ P, S (T P) = P := by
    intro P
    cases P with
    | zero =>
      show S (T 0) = 0
      rw [map_zero, map_zero]
    | @some x y h =>
      obtain ⟨h', e1⟩ := hT x y h
      obtain ⟨h'', e2⟩ := hS _ _ h'
      rw [e1, e2, WeierstrassCurve.Affine.Point.some.injEq]
      exact ⟨τb.symm_apply_apply x, τb.symm_apply_apply y⟩
  have hTS : ∀ Q, T (S Q) = Q := by
    intro Q
    cases Q with
    | zero =>
      show T (S 0) = 0
      rw [map_zero, map_zero]
    | @some x y h =>
      obtain ⟨h', e1⟩ := hS x y h
      obtain ⟨h'', e2⟩ := hT _ _ h'
      rw [e1, e2, WeierstrassCurve.Affine.Point.some.injEq]
      exact ⟨τb.apply_symm_apply x, τb.apply_symm_apply y⟩
  let φ : EllipticRootNumber.Pts F₁ E ≃+ EllipticRootNumber.Pts F₂ (E.map (τ : F₁ →+* F₂)) :=
    { toFun := T, invFun := S, left_inv := hST, right_inv := hTS, map_add' := map_add T }
  refine ⟨φ, ?_⟩
  
  intro σ P
  show T (EllipticRootNumber.galHom F₁ E σ P) =
    EllipticRootNumber.galHom F₂ (E.map (τ : F₁ →+* F₂)) (κ σ) (T P)
  cases P with
  | zero =>
    have e : EllipticRootNumber.galHom F₁ E σ WeierstrassCurve.Affine.Point.zero = 0 := rfl
    have e' : EllipticRootNumber.galHom F₂ (E.map (τ : F₁ →+* F₂)) (κ σ) 0 = 0 := rfl
    show T (EllipticRootNumber.galHom F₁ E σ WeierstrassCurve.Affine.Point.zero) =
      EllipticRootNumber.galHom F₂ (E.map (τ : F₁ →+* F₂)) (κ σ) (T 0)
    rw [e, map_zero T, e']
  | @some x y h =>
    obtain ⟨hσ, g1⟩ : ∃ hσ : (E.baseChange (AlgebraicClosure F₁)).toAffine.Nonsingular (σ x) (σ y),
        EllipticRootNumber.galHom F₁ E σ (WeierstrassCurve.Affine.Point.some h) =
          WeierstrassCurve.Affine.Point.some hσ := ⟨_, rfl⟩
    obtain ⟨h₁, e1⟩ := hT (σ x) (σ y) hσ
    obtain ⟨h₂, e2⟩ := hT x y h
    obtain ⟨h₃, g2⟩ : ∃ h₃ : ((E.map (τ : F₁ →+* F₂)).baseChange
          (AlgebraicClosure F₂)).toAffine.Nonsingular (κ σ (τb x)) (κ σ (τb y)),
        EllipticRootNumber.galHom F₂ (E.map (τ : F₁ →+* F₂)) (κ σ)
            (WeierstrassCurve.Affine.Point.some h₂) =
          WeierstrassCurve.Affine.Point.some h₃ := ⟨_, rfl⟩
    rw [g1, e1, e2, g2, WeierstrassCurve.Affine.Point.some.injEq]
    exact ⟨(hκ σ x).symm, (hκ σ y).symm⟩

theorem tateModule_transport_of_pts {F₁ F₂ : Type u} [Field F₁] [Field F₂]
    [ValuativeRel F₁] [TopologicalSpace F₁] [IsNonarchimedeanLocalField F₁]
    [ValuativeRel F₂] [TopologicalSpace F₂] [IsNonarchimedeanLocalField F₂]
    [DecidableEq (AlgebraicClosure F₁)] [DecidableEq (AlgebraicClosure F₂)]
    (hℓ : EllipticRootNumber.ell F₂ = EllipticRootNumber.ell F₁)
    (κ : EllipticRootNumber.AbsGal F₁ ≃* EllipticRootNumber.AbsGal F₂)
    (E₁ : WeierstrassCurve F₁) (E₂ : WeierstrassCurve F₂)
    (φ : EllipticRootNumber.Pts F₁ E₁ ≃+ EllipticRootNumber.Pts F₂ E₂)
    (hφ : ∀ (σ : EllipticRootNumber.AbsGal F₁) (P : EllipticRootNumber.Pts F₁ E₁),
      φ (EllipticRootNumber.galHom F₁ E₁ σ P) = EllipticRootNumber.galHom F₂ E₂ (κ σ) (φ P)) :
    ∃ f : EllipticRootNumber.tateModule F₁ E₁ ≃+ EllipticRootNumber.tateModule F₂ E₂,
      (∀ (a₁ : ℤ_[EllipticRootNumber.ell F₁]) (a₂ : ℤ_[EllipticRootNumber.ell F₂]),
        (∀ n : ℕ, (PadicInt.toZModPow n a₁).val = (PadicInt.toZModPow n a₂).val) →
        ∀ x, f (a₁ • x) = a₂ • f x) ∧
      ∀ (σ : EllipticRootNumber.AbsGal F₁) (x : EllipticRootNumber.tateModule F₁ E₁),
        f (EllipticRootNumber.tateRep F₁ E₁ σ x) = EllipticRootNumber.tateRep F₂ E₂ (κ σ) (f x) :=
by
  classical
  obtain rfl : ‹DecidableEq (AlgebraicClosure F₁)› = fun a b => Classical.propDecidable (a = b) :=
    Subsingleton.elim _ _
  obtain rfl : ‹DecidableEq (AlgebraicClosure F₂)› = fun a b => Classical.propDecidable (a = b) :=
    Subsingleton.elim _ _
  
  have tmapA : ∀ {Fa Fb : Type u} [Field Fa] [Field Fb]
      [ValuativeRel Fa] [TopologicalSpace Fa] [IsNonarchimedeanLocalField Fa]
      [ValuativeRel Fb] [TopologicalSpace Fb] [IsNonarchimedeanLocalField Fb]
      (Ea : WeierstrassCurve Fa) (Eb : WeierstrassCurve Fb)
      (_h : EllipticRootNumber.ell Fb = EllipticRootNumber.ell Fa)
      (ψ : EllipticRootNumber.Pts Fa Ea →+ EllipticRootNumber.Pts Fb Eb),
      ∃ g : EllipticRootNumber.tateModule Fa Ea →+ EllipticRootNumber.tateModule Fb Eb,
        ∀ x n, ((g x).1 n).1 = ψ (x.1 n).1 := by
    intro Fa Fb _ _ _ _ _ _ _ _ Ea Eb h ψ
    have hmem : ∀ (n : ℕ)
        (P : EllipticRootNumber.torsion Fa Ea (EllipticRootNumber.ell Fa ^ (n + 1))),
        ψ P.1 ∈ EllipticRootNumber.torsion Fb Eb (EllipticRootNumber.ell Fb ^ (n + 1)) := by
      intro n P
      show (EllipticRootNumber.ell Fb ^ (n + 1)) • ψ P.1 = 0
      rw [h, ← map_nsmul, (EllipticRootNumber.mem_torsion Fa Ea).mp P.2, map_zero]
    let G : EllipticRootNumber.tateModule Fa Ea → EllipticRootNumber.tateModule Fb Eb := fun x =>
      ⟨fun n => ⟨ψ (x.1 n).1, hmem n (x.1 n)⟩, by
        intro n
        show EllipticRootNumber.ell Fb • ψ (x.1 (n + 1)).1 = ψ (x.1 n).1
        rw [h, ← map_nsmul, x.2 n]⟩
    refine ⟨{ toFun := G, map_zero' := ?_, map_add' := ?_ }, fun x n => rfl⟩
    · exact Subtype.ext (funext fun n => Subtype.ext (map_zero ψ))
    · intro x y
      exact Subtype.ext (funext fun n => Subtype.ext (map_add ψ _ _))
  obtain ⟨fT, hF⟩ := tmapA E₁ E₂ hℓ φ.toAddMonoidHom
  obtain ⟨gT, hG⟩ := tmapA E₂ E₁ hℓ.symm φ.symm.toAddMonoidHom
  simp only [AddEquiv.coe_toAddMonoidHom] at hF hG
  have hl : ∀ x, gT (fT x) = x := fun x => Subtype.ext (funext fun n => Subtype.ext (by
    rw [hG, hF, φ.symm_apply_apply]))
  have hr : ∀ y, fT (gT y) = y := fun y => Subtype.ext (funext fun n => Subtype.ext (by
    rw [hF, hG, φ.apply_symm_apply]))
  let f : EllipticRootNumber.tateModule F₁ E₁ ≃+ EllipticRootNumber.tateModule F₂ E₂ :=
    { toFun := fT, invFun := gT, left_inv := hl, right_inv := hr, map_add' := map_add fT }
  have hf : ∀ x n, ((f x).1 n).1 = φ (x.1 n).1 := hF
  have hrep : ∀ {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F] (E : WeierstrassCurve F) (σ : EllipticRootNumber.AbsGal F)
      (x : EllipticRootNumber.tateModule F E) (n : ℕ),
      ((EllipticRootNumber.tateRep F E σ x).1 n).1 = EllipticRootNumber.galHom F E σ (x.1 n).1 :=
    fun _ _ _ _ => rfl
  refine ⟨f, ?_, ?_⟩
  · intro a₁ a₂ h x
    apply Subtype.ext
    funext n
    apply Subtype.ext
    have e1 : ((a₁ • x).1 n).1 = (PadicInt.toZModPow (n + 1) a₁).val • (x.1 n).1 :=
      EllipticRootNumber.padic_smul_torsion F₁ E₁ n a₁ (x.1 n)
    have e2 : ((a₂ • f x).1 n).1 = (PadicInt.toZModPow (n + 1) a₂).val • ((f x).1 n).1 :=
      EllipticRootNumber.padic_smul_torsion F₂ E₂ n a₂ ((f x).1 n)
    rw [hf, e1, map_nsmul, e2, hf, h (n + 1)]
  · intro σ x
    apply Subtype.ext
    funext n
    apply Subtype.ext
    rw [hf, hrep, hφ, hrep, hf]

theorem wdRep_transport {F₁ F₂ : Type u} [Field F₁] [Field F₂]
    [ValuativeRel F₁] [TopologicalSpace F₁] [IsNonarchimedeanLocalField F₁]
    [ValuativeRel F₂] [TopologicalSpace F₂] [IsNonarchimedeanLocalField F₂]
    (τ : F₁ ≃+* F₂)
    (hS : ∀ x : F₁, ValuativeRel.valuation F₂ (τ x) ≤ 1 ↔ ValuativeRel.valuation F₁ x ≤ 1)
    (τb : AlgebraicClosure F₁ ≃+* AlgebraicClosure F₂)
    (hτb : ∀ x : F₁, τb (algebraMap F₁ (AlgebraicClosure F₁) x) =
        algebraMap F₂ (AlgebraicClosure F₂) (τ x))
    (κ : EllipticRootNumber.AbsGal F₁ ≃* EllipticRootNumber.AbsGal F₂)
    (hκ : ∀ σ x, κ σ (τb x) = τb (σ x)) (E : WeierstrassCurve F₁) :
    ∃ (ι : EllipticRootNumber.Ω F₁ ≃+* EllipticRootNumber.Ω F₂)
      (e : (EllipticRootNumber.wdRep F₁ E).V ≃+
        (EllipticRootNumber.wdRep F₂ (E.map (τ : F₁ →+* F₂))).V),
      (∀ (c : EllipticRootNumber.Ω F₁) v, e (c • v) = ι c • e v) ∧
      (∀ (w₁ : EllipticRootNumber.relWeil F₁ ⊥) (w₂ : EllipticRootNumber.relWeil F₂ ⊥),
         (w₂ : EllipticRootNumber.AbsGal F₂) = κ w₁ → ∀ v,
         e ((EllipticRootNumber.wdRep F₁ E).ρ w₁ v) =
           (EllipticRootNumber.wdRep F₂ (E.map (τ : F₁ →+* F₂))).ρ w₂ (e v)) ∧
      (∀ v, e ((EllipticRootNumber.wdRep F₁ E).N v) =
           (EllipticRootNumber.wdRep F₂ (E.map (τ : F₁ →+* F₂))).N (e v)) :=
by
  classical
  
  obtain ⟨hq, hp, -, ⟨ι₀⟩⟩ := ringEquiv_localField_invariants τ hS
  have hℓ : EllipticRootNumber.ell F₂ = EllipticRootNumber.ell F₁ :=
    congrArg (fun m => (Nat.exists_infinite_primes (m + 1)).choose) hp
  have hFrob := (galConj_naturality τb κ hκ hp hq).2.1
  have hs₁ := weilDegreeHom_spec_of_localField F₁
  have hs₂ := weilDegreeHom_spec_of_localField F₂
  
  have hqs : ∀ σ : EllipticRootNumber.AbsGal F₁,
      EllipticRootNumber.quadSign F₂ (E.map (τ : F₁ →+* F₂)) (κ σ) =
        EllipticRootNumber.quadSign F₁ E σ := by
    intro σ
    have hsq : EllipticRootNumber.sqrtNegC₆ F₂ (E.map (τ : F₁ →+* F₂)) ^ 2 =
        (τb (EllipticRootNumber.sqrtNegC₆ F₁ E)) ^ 2 := by
      rw [EllipticRootNumber.sqrtNegC₆_sq, ← map_pow, EllipticRootNumber.sqrtNegC₆_sq, hτb,
        WeierstrassCurve.map_c₆]
      simp only [map_neg, RingEquiv.coe_toRingHom]
    have key : (κ σ) (EllipticRootNumber.sqrtNegC₆ F₂ (E.map (τ : F₁ →+* F₂))) =
          EllipticRootNumber.sqrtNegC₆ F₂ (E.map (τ : F₁ →+* F₂)) ↔
        σ (EllipticRootNumber.sqrtNegC₆ F₁ E) = EllipticRootNumber.sqrtNegC₆ F₁ E := by
      rcases sq_eq_sq_iff_eq_or_eq_neg.mp hsq with h | h
      · rw [h, hκ]
        exact τb.injective.eq_iff
      · rw [h, map_neg, hκ, neg_inj]
        exact τb.injective.eq_iff
    unfold EllipticRootNumber.quadSign
    by_cases hc : σ (EllipticRootNumber.sqrtNegC₆ F₁ E) = EllipticRootNumber.sqrtNegC₆ F₁ E
    · rw [if_pos hc, if_pos (key.mpr hc)]
    · rw [if_neg hc, if_neg (fun h => hc (key.mp h))]
  
  have tower : ∀ (ℓ₁ ℓ₂ : ℕ) [Fact ℓ₁.Prime] [Fact ℓ₂.Prime], ℓ₁ = ℓ₂ →
      ∀ {M₁ M₂ : Type u} [AddCommGroup M₁] [Module ℤ_[ℓ₁] M₁] [AddCommGroup M₂]
        [Module ℤ_[ℓ₂] M₂] (f : M₁ ≃+ M₂),
      (∀ (a₁ : ℤ_[ℓ₁]) (a₂ : ℤ_[ℓ₂]),
        (∀ n : ℕ, (PadicInt.toZModPow n a₁).val = (PadicInt.toZModPow n a₂).val) →
        ∀ x, f (a₁ • x) = a₂ • f x) →
      ∃ (ι : AlgebraicClosure ℚ_[ℓ₁] ≃+* AlgebraicClosure ℚ_[ℓ₂])
        (e : TensorProduct ℚ_[ℓ₁] (AlgebraicClosure ℚ_[ℓ₁]) (TensorProduct ℤ_[ℓ₁] ℚ_[ℓ₁] M₁) ≃+
          TensorProduct ℚ_[ℓ₂] (AlgebraicClosure ℚ_[ℓ₂]) (TensorProduct ℤ_[ℓ₂] ℚ_[ℓ₂] M₂)),
        (∀ (c : AlgebraicClosure ℚ_[ℓ₁]) v, e (c • v) = ι c • e v) ∧
        ∀ (g₁ : M₁ →ₗ[ℤ_[ℓ₁]] M₁) (g₂ : M₂ →ₗ[ℤ_[ℓ₂]] M₂), (∀ x, f (g₁ x) = g₂ (f x)) →
          ∀ v, e (LinearMap.baseChange (AlgebraicClosure ℚ_[ℓ₁])
              (LinearMap.baseChange ℚ_[ℓ₁] g₁) v) =
            LinearMap.baseChange (AlgebraicClosure ℚ_[ℓ₂]) (LinearMap.baseChange ℚ_[ℓ₂] g₂) (e v) := by
    intro ℓ₁ ℓ₂ i₁ i₂ h M₁ M₂ _ _ _ _ f hf
    subst h
    obtain rfl : i₂ = i₁ := Subsingleton.elim _ _
    let fL : M₁ ≃ₗ[ℤ_[ℓ₁]] M₂ :=
      { f with map_smul' := fun a x => hf a a (fun _ => rfl) x }
    let eL := LinearEquiv.baseChange ℚ_[ℓ₁] (AlgebraicClosure ℚ_[ℓ₁]) _ _
      (LinearEquiv.baseChange ℤ_[ℓ₁] ℚ_[ℓ₁] _ _ fL)
    refine ⟨RingEquiv.refl _, eL.toAddEquiv, fun c v => eL.map_smul c v, ?_⟩
    intro g₁ g₂ hg v
    have hc : (fL : M₁ →ₗ[ℤ_[ℓ₁]] M₂) ∘ₗ g₁ = g₂ ∘ₗ (fL : M₁ →ₗ[ℤ_[ℓ₁]] M₂) :=
      LinearMap.ext fun x => hg x
    have key : (eL : _ →ₗ[AlgebraicClosure ℚ_[ℓ₁]] _) ∘ₗ
          LinearMap.baseChange (AlgebraicClosure ℚ_[ℓ₁]) (LinearMap.baseChange ℚ_[ℓ₁] g₁) =
        LinearMap.baseChange (AlgebraicClosure ℚ_[ℓ₁]) (LinearMap.baseChange ℚ_[ℓ₁] g₂) ∘ₗ
          (eL : _ →ₗ[AlgebraicClosure ℚ_[ℓ₁]] _) := by
      simp only [eL, LinearEquiv.coe_baseChange, ← LinearMap.baseChange_comp, hc]
    exact LinearMap.congr_fun key v
  
  have hPG : EllipticRootNumber.IsPotentiallyGood F₂ (E.map (τ : F₁ →+* F₂)) ↔
      EllipticRootNumber.IsPotentiallyGood F₁ E := by
    unfold EllipticRootNumber.IsPotentiallyGood
    rw [WeierstrassCurve.map_c₄, WeierstrassCurve.map_Δ, ← map_pow, ← map_div₀]
    exact hS _
  
  have hnorm : ∀ (ι : EllipticRootNumber.Ω F₁ ≃+* EllipticRootNumber.Ω F₂)
      (w₁ : EllipticRootNumber.relWeil F₁ ⊥) (w₂ : EllipticRootNumber.relWeil F₂ ⊥),
      (w₂ : EllipticRootNumber.AbsGal F₂) = κ w₁ →
      ι (EllipticRootNumber.relNorm F₁ ⊥ w₁ : EllipticRootNumber.Ω F₁) =
        (EllipticRootNumber.relNorm F₂ ⊥ w₂ : EllipticRootNumber.Ω F₂) := by
    intro ι w₁ w₂ hw
    obtain ⟨n, hn⟩ := hs₁.1 (w₁ : EllipticRootNumber.AbsGal F₁)
      (EllipticRootNumber.relWeil_le_weilGroup F₁ ⊥ w₁.2)
    have hn₂ : EllipticRootNumber.ActsAsFrobPow F₂ (w₂ : EllipticRootNumber.AbsGal F₂) n := by
      rw [hw]; exact (hFrob _ n).2 hn
    have d₁ := hs₁.2 (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F₁ ⊥) w₁) n hn
    have d₂ := hs₂.2 (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F₂ ⊥) w₂) n hn₂
    have r : ∀ {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
        [IsNonarchimedeanLocalField F] (w : EllipticRootNumber.relWeil F ⊥),
        EllipticRootNumber.weilDegreeHom F
          (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) w) =
          Multiplicative.ofAdd n →
        (EllipticRootNumber.relNorm F ⊥ w : EllipticRootNumber.Ω F) =
          ((EllipticRootNumber.q F : ℕ) : EllipticRootNumber.Ω F) ^ n := by
      intro F _ _ _ _ w hd
      simp only [EllipticRootNumber.relNorm, EllipticRootNumber.weilNormHom,
        MonoidHom.comp_apply, hd, zpowersHom_apply, toAdd_ofAdd, Units.val_zpow_eq_zpow_val,
        EllipticRootNumber.qUnit, Units.val_mk0]
    rw [r w₁ d₁, r w₂ d₂, map_zpow₀, map_natCast, hq]
  
  have hquad : ∀ (ι : EllipticRootNumber.Ω F₁ ≃+* EllipticRootNumber.Ω F₂)
      (w₁ : EllipticRootNumber.relWeil F₁ ⊥) (w₂ : EllipticRootNumber.relWeil F₂ ⊥),
      (w₂ : EllipticRootNumber.AbsGal F₂) = κ w₁ →
      ι (EllipticRootNumber.quadCharΩ F₁ E ⊥ w₁ : EllipticRootNumber.Ω F₁) =
        (EllipticRootNumber.quadCharΩ F₂ (E.map (τ : F₁ →+* F₂)) ⊥ w₂ :
          EllipticRootNumber.Ω F₂) := by
    intro ι w₁ w₂ hw
    have hs : EllipticRootNumber.quadSign F₂ (E.map (τ : F₁ →+* F₂))
        (w₂ : EllipticRootNumber.AbsGal F₂) =
        EllipticRootNumber.quadSign F₁ E (w₁ : EllipticRootNumber.AbsGal F₁) := by
      rw [hw]; exact hqs _
    show ι (((EllipticRootNumber.quadSign F₁ E (w₁ : EllipticRootNumber.AbsGal F₁) : ℤˣ) : ℤ) :
        EllipticRootNumber.Ω F₁) =
      (((EllipticRootNumber.quadSign F₂ (E.map (τ : F₁ →+* F₂))
        (w₂ : EllipticRootNumber.AbsGal F₂) : ℤˣ) : ℤ) : EllipticRootNumber.Ω F₂)
    rw [hs, map_intCast]
  obtain ⟨φ, hφ⟩ := pts_transport τ τb hτb κ hκ E
  obtain ⟨f, hfs, hfρ⟩ := tateModule_transport_of_pts hℓ κ E (E.map (τ : F₁ →+* F₂)) φ hφ
  obtain ⟨ι, e, he, hnat⟩ := tower (EllipticRootNumber.ell F₁)
    (EllipticRootNumber.ell F₂) hℓ.symm f hfs
  
  have genPG : ∀ (W₁ : EllipticRootNumber.WDRep F₁ ⊥) (W₂ : EllipticRootNumber.WDRep F₂ ⊥),
      W₁ = { V := EllipticRootNumber.VBar F₁ E
             ρ := (EllipticRootNumber.ellAdicRep F₁ E).comp
               (EllipticRootNumber.relWeil F₁ ⊥).subtype
             N := 0 } →
      W₂ = { V := EllipticRootNumber.VBar F₂ (E.map (τ : F₁ →+* F₂))
             ρ := (EllipticRootNumber.ellAdicRep F₂ (E.map (τ : F₁ →+* F₂))).comp
               (EllipticRootNumber.relWeil F₂ ⊥).subtype
             N := 0 } →
      ∃ (ι : EllipticRootNumber.Ω F₁ ≃+* EllipticRootNumber.Ω F₂) (e : W₁.V ≃+ W₂.V),
        (∀ (c : EllipticRootNumber.Ω F₁) v, e (c • v) = ι c • e v) ∧
        (∀ (w₁ : EllipticRootNumber.relWeil F₁ ⊥) (w₂ : EllipticRootNumber.relWeil F₂ ⊥),
          (w₂ : EllipticRootNumber.AbsGal F₂) = κ w₁ → ∀ v, e (W₁.ρ w₁ v) = W₂.ρ w₂ (e v)) ∧
        (∀ v, e (W₁.N v) = W₂.N (e v)) := by
    rintro W₁ W₂ rfl rfl
    refine ⟨ι, e, he, ?_, ?_⟩
    · intro w₁ w₂ hw v
      show e (LinearMap.baseChange (EllipticRootNumber.Ω F₁)
          (LinearMap.baseChange ℚ_[EllipticRootNumber.ell F₁]
            (EllipticRootNumber.tateRep F₁ E (w₁ : EllipticRootNumber.AbsGal F₁))) v) =
        LinearMap.baseChange (EllipticRootNumber.Ω F₂)
          (LinearMap.baseChange ℚ_[EllipticRootNumber.ell F₂]
            (EllipticRootNumber.tateRep F₂ (E.map (τ : F₁ →+* F₂))
              (w₂ : EllipticRootNumber.AbsGal F₂))) (e v)
      rw [hw]
      exact hnat _ _ (hfρ _) v
    · intro v
      show e 0 = 0
      exact e.map_zero
  
  have genM : ∀ (W₁ : EllipticRootNumber.WDRep F₁ ⊥) (W₂ : EllipticRootNumber.WDRep F₂ ⊥),
      W₁ = { V := Fin 2 → ULift.{u} (EllipticRootNumber.Ω F₁)
             ρ := EllipticRootNumber.spTwistRep F₁ ⊥ (EllipticRootNumber.quadCharΩ F₁ E ⊥)
             N := EllipticRootNumber.spN F₁ } →
      W₂ = { V := Fin 2 → ULift.{u} (EllipticRootNumber.Ω F₂)
             ρ := EllipticRootNumber.spTwistRep F₂ ⊥
               (EllipticRootNumber.quadCharΩ F₂ (E.map (τ : F₁ →+* F₂)) ⊥)
             N := EllipticRootNumber.spN F₂ } →
      ∃ (ι : EllipticRootNumber.Ω F₁ ≃+* EllipticRootNumber.Ω F₂) (e : W₁.V ≃+ W₂.V),
        (∀ (c : EllipticRootNumber.Ω F₁) v, e (c • v) = ι c • e v) ∧
        (∀ (w₁ : EllipticRootNumber.relWeil F₁ ⊥) (w₂ : EllipticRootNumber.relWeil F₂ ⊥),
          (w₂ : EllipticRootNumber.AbsGal F₂) = κ w₁ → ∀ v, e (W₁.ρ w₁ v) = W₂.ρ w₂ (e v)) ∧
        (∀ v, e (W₁.N v) = W₂.N (e v)) := by
    rintro W₁ W₂ rfl rfl
    obtain ⟨e, he⟩ : ∃ e : (Fin 2 → ULift.{u} (EllipticRootNumber.Ω F₁)) ≃+
        (Fin 2 → ULift.{u} (EllipticRootNumber.Ω F₂)),
        ∀ v i, (e v i).down = ι₀ (v i).down :=
      ⟨{ toFun := fun v i => ULift.up (ι₀ (v i).down)
         invFun := fun v i => ULift.up (ι₀.symm (v i).down)
         left_inv := fun v => by
           funext i
           apply ULift.ext
           simp
         right_inv := fun v => by
           funext i
           apply ULift.ext
           simp
         map_add' := fun v w => by
           funext i
           apply ULift.ext
           simp }, fun _ _ => rfl⟩
    refine ⟨ι₀, e, ?_, ?_, ?_⟩
    · intro c v
      funext i
      apply ULift.ext
      show (e (c • v) i).down = (ι₀ c • (e v i)).down
      rw [he, ULift.smul_down, he, Pi.smul_apply, ULift.smul_down, smul_eq_mul, smul_eq_mul,
        map_mul]
    · intro w₁ w₂ hw v
      funext i
      apply ULift.ext
      have h1 := hquad ι₀ w₁ w₂ hw
      have h2 := hnorm ι₀ w₁ w₂ hw
      show (e (EllipticRootNumber.spTwistRep F₁ ⊥ (EllipticRootNumber.quadCharΩ F₁ E ⊥) w₁ v) i).down =
        (EllipticRootNumber.spTwistRep F₂ ⊥
          (EllipticRootNumber.quadCharΩ F₂ (E.map (τ : F₁ →+* F₂)) ⊥) w₂ (e v) i).down
      rw [he]
      simp only [EllipticRootNumber.spTwistRep, MonoidHom.coe_mk, OneHom.coe_mk,
        LinearMap.pi_apply, LinearMap.smul_apply, LinearMap.proj_apply, ULift.smul_down,
        smul_eq_mul, map_mul, he]
      split_ifs
      · rw [map_one, h1]
      · rw [h1, h2]
    · intro v
      funext i
      apply ULift.ext
      show (e (EllipticRootNumber.spN F₁ v) i).down = (EllipticRootNumber.spN F₂ (e v) i).down
      rw [he]
      simp only [EllipticRootNumber.spN, LinearMap.pi_apply]
      split_ifs
      · simp only [LinearMap.proj_apply, he]
      · simp only [LinearMap.zero_apply, ULift.zero_down, map_zero]
  
  by_cases hG : EllipticRootNumber.IsPotentiallyGood F₁ E
  · exact genPG _ _ (if_pos hG) (if_pos (hPG.mpr hG))
  · exact genM _ _ (if_neg hG) (if_neg (fun h => hG (hPG.mp h)))

theorem stdChar_transport {F₁ F₂ : Type u} [Field F₁] [Field F₂]
    [ValuativeRel F₁] [TopologicalSpace F₁] [IsNonarchimedeanLocalField F₁]
    [ValuativeRel F₂] [TopologicalSpace F₂] [IsNonarchimedeanLocalField F₂]
    (τ : F₁ ≃+* F₂)
    (hS : ∀ x : F₁, ValuativeRel.valuation F₂ (τ x) ≤ 1 ↔ ValuativeRel.valuation F₁ x ≤ 1)
    (τb : AlgebraicClosure F₁ ≃+* AlgebraicClosure F₂)
    (hτb : ∀ x : F₁, τb (algebraMap F₁ (AlgebraicClosure F₁) x) =
        algebraMap F₂ (AlgebraicClosure F₂) (τ x))
    (ι : EllipticRootNumber.Ω F₁ ≃+* EllipticRootNumber.Ω F₂) :
    ∃ ψ : AddChar (⊥ : IntermediateField F₁ (AlgebraicClosure F₁)) (EllipticRootNumber.Ω F₁),
      ((∀ x, 0 ≤ EllipticRootNumber.valL F₁ ⊥ x → ψ x = 1) ∧
        ∃ x, EllipticRootNumber.valL F₁ ⊥ x = -1 ∧ ψ x ≠ 1) ∧
      ∀ (x₁ : (⊥ : IntermediateField F₁ (AlgebraicClosure F₁)))
        (x₂ : (⊥ : IntermediateField F₂ (AlgebraicClosure F₂))),
        (x₂ : AlgebraicClosure F₂) = τb (x₁ : AlgebraicClosure F₁) →
          EllipticRootNumber.stdChar F₂ x₂ = ι (ψ x₁) :=
by
  classical
  
  have addVal_facts : ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F],
      EllipticRootNumber.addVal F 0 = 0 ∧
      (∀ x y : F, x ≠ 0 → y ≠ 0 →
        EllipticRootNumber.addVal F (x * y) =
          EllipticRootNumber.addVal F x + EllipticRootNumber.addVal F y) ∧
      (∀ y : F, 0 ≤ EllipticRootNumber.addVal F y ↔ ValuativeRel.valuation F y ≤ 1) ∧
      (∀ k : ℤ, ∃ y : F, EllipticRootNumber.addVal F y = -k) ∧
      (∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.valL F ⊥ x =
          EllipticRootNumber.addVal F (IntermediateField.botEquiv F (AlgebraicClosure F) x)) := by
    intro F _ _ _ _
    set ιF := IntermediateField.botEquiv F (AlgebraicClosure F) with hιF
    set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F with hiso
    have hav0 : EllipticRootNumber.addVal F 0 = 0 := by
      unfold EllipticRootNumber.addVal
      exact dif_pos rfl
    have key : ∀ (y : F) (m : Multiplicative ℤ),
        iso (ValuativeRel.valuation F y) = (m : WithZero (Multiplicative ℤ)) →
        EllipticRootNumber.addVal F y = -Multiplicative.toAdd m := by
      intro y m hm
      have hy : y ≠ 0 := by
        rintro rfl
        rw [map_zero, map_zero] at hm
        exact WithZero.zero_ne_coe hm
      unfold EllipticRootNumber.addVal
      rw [dif_neg hy]
      congr 2
      apply WithZero.coe_injective
      rw [WithZero.coe_unzero]
      exact hm
    have hcoe : ∀ y : F, y ≠ 0 → ∃ m : Multiplicative ℤ,
        iso (ValuativeRel.valuation F y) = (m : WithZero (Multiplicative ℤ)) := by
      intro y hy
      have hne : iso (ValuativeRel.valuation F y) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hy)
      exact ⟨_, (WithZero.coe_unzero hne).symm⟩
    have hmul : ∀ x y : F, x ≠ 0 → y ≠ 0 →
        EllipticRootNumber.addVal F (x * y) =
          EllipticRootNumber.addVal F x + EllipticRootNumber.addVal F y := by
      intro x y hx hy
      obtain ⟨m₁, hm₁⟩ := hcoe x hx
      obtain ⟨m₂, hm₂⟩ := hcoe y hy
      have hm : iso (ValuativeRel.valuation F (x * y)) =
          ((m₁ * m₂ : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) := by
        rw [map_mul, map_mul, hm₁, hm₂, WithZero.coe_mul]
      rw [key _ _ hm, key _ _ hm₁, key _ _ hm₂, toAdd_mul]
      ring
    have hiff : ∀ y : F, 0 ≤ EllipticRootNumber.addVal F y ↔ ValuativeRel.valuation F y ≤ 1 := by
      intro y
      by_cases hy : y = 0
      · subst hy
        rw [hav0, map_zero]
        exact ⟨fun _ => zero_le_one, fun _ => le_rfl⟩
      · obtain ⟨m, hm⟩ := hcoe y hy
        rw [key y _ hm, neg_nonneg, ← map_le_map_iff iso, map_one, hm, WithZero.coe_le_one]
        show Multiplicative.toAdd m ≤ Multiplicative.toAdd (1 : Multiplicative ℤ) ↔ m ≤ 1
        exact Multiplicative.toAdd_le
    have hex : ∀ k : ℤ, ∃ y : F, EllipticRootNumber.addVal F y = -k := by
      intro k
      obtain ⟨y, hy⟩ := ValuativeRel.valuation_surjective
        (iso.symm ((Multiplicative.ofAdd k : Multiplicative ℤ) : WithZero (Multiplicative ℤ)))
      refine ⟨y, ?_⟩
      rw [key y (Multiplicative.ofAdd k) (by rw [hy]; exact iso.apply_symm_apply _), toAdd_ofAdd]
    have hnorm : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.addVal F (ιF x) := by
      intro x
      unfold EllipticRootNumber.relVal
      congr 1
      conv_lhs => rw [← ιF.symm_apply_apply x]
      rw [hιF, IntermediateField.botEquiv_symm, Algebra.norm_algebraMap,
        IntermediateField.finrank_bot, pow_one]
    have hres : EllipticRootNumber.resDeg F ⊥ = 1 := by
      obtain ⟨y₁, hy₁⟩ := hex (-1)
      have hy₁0 : y₁ ≠ 0 := by
        rintro rfl
        rw [hav0] at hy₁
        norm_num at hy₁
      have hmem : (1 : ℕ) ∈ {k : ℕ | 0 < k ∧ ∃ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
          x ≠ 0 ∧ EllipticRootNumber.relVal F ⊥ x = k} := by
        refine ⟨one_pos, ιF.symm y₁, (map_ne_zero ιF.symm).mpr hy₁0, ?_⟩
        rw [hnorm, ιF.apply_symm_apply, hy₁]
        norm_num
      unfold EllipticRootNumber.resDeg
      exact le_antisymm (Nat.sInf_le hmem) (Nat.sInf_mem ⟨1, hmem⟩).1
    have hvalL : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.addVal F (ιF x) := by
      intro x
      unfold EllipticRootNumber.valL
      rw [hres, hnorm, Nat.cast_one, Int.ediv_one]
    exact ⟨hav0, hmul, hiff, hex, hvalL⟩
  
  have stdSpec : ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F],
      (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → EllipticRootNumber.stdChar F x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ EllipticRootNumber.stdChar F x ≠ 1 := by
    intro F _ _ _ _
    have absChar : ∀ (B : AddSubgroup F) (a : F), a ∉ B →
        ∃ ψ : AddChar F (EllipticRootNumber.Ω F), (∀ b ∈ B, ψ b = 1) ∧ ψ a ≠ 1 := by
      intro B a ha
      have hc0 : (a : F ⧸ B) ≠ 0 := by
        intro h; exact ha ((QuotientAddGroup.eq_zero_iff a).mp h)
      have hN1 : addOrderOf (a : F ⧸ B) ≠ 1 := by
        intro h; exact hc0 (AddMonoid.addOrderOf_eq_one_iff.mp h)
      obtain ⟨ζ, hζ0, hζN, hζ1⟩ : ∃ ζ : EllipticRootNumber.Ω F,
          ζ ≠ 0 ∧ ζ ^ addOrderOf (a : F ⧸ B) = 1 ∧ ζ ≠ 1 := by
        by_cases hN0 : addOrderOf (a : F ⧸ B) = 0
        · refine ⟨-1, by norm_num, by rw [hN0, pow_zero], ?_⟩
          intro h
          have h2 : (2 : EllipticRootNumber.Ω F) = 0 := by linear_combination -h
          exact two_ne_zero h2
        · haveI : NeZero ((addOrderOf (a : F ⧸ B) : ℕ) : EllipticRootNumber.Ω F) :=
            ⟨Nat.cast_ne_zero.mpr hN0⟩
          have hdeg := Polynomial.degree_cyclotomic_pos (addOrderOf (a : F ⧸ B))
            (EllipticRootNumber.Ω F) (by omega)
          obtain ⟨ζ, hζ⟩ := IsAlgClosed.exists_root
            (Polynomial.cyclotomic (addOrderOf (a : F ⧸ B)) (EllipticRootNumber.Ω F))
            (ne_of_gt hdeg)
          have hprim : IsPrimitiveRoot ζ (addOrderOf (a : F ⧸ B)) :=
            Polynomial.isRoot_cyclotomic_iff.mp hζ
          refine ⟨ζ, ?_, hprim.pow_eq_one, hprim.ne_one (by omega)⟩
          intro h0
          have h1 := hprim.pow_eq_one
          rw [h0, zero_pow hN0] at h1
          exact zero_ne_one h1
      set u : (EllipticRootNumber.Ω F)ˣ := Units.mk0 ζ hζ0 with hu
      have huN : u ^ ((addOrderOf (a : F ⧸ B) : ℕ) : ℤ) = 1 := by
        rw [zpow_natCast]; ext; simp [hu, hζN]
      have root : ∀ (w : (EllipticRootNumber.Ω F)ˣ) (n : ℤ), n ≠ 0 →
          ∃ x : (EllipticRootNumber.Ω F)ˣ, x ^ n = w := by
        intro w n hn
        have hm : 0 < n.natAbs := Int.natAbs_pos.mpr hn
        rcases Int.natAbs_eq n with h | h
        · obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (w : EllipticRootNumber.Ω F) hm
          have hz0 : z ≠ 0 := by
            rintro rfl; rw [zero_pow hm.ne'] at hz; exact w.ne_zero hz.symm
          refine ⟨Units.mk0 z hz0, ?_⟩
          rw [h, zpow_natCast]; ext; simp [hz]
        · obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq
            ((w⁻¹ : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) hm
          have hz0 : z ≠ 0 := by
            rintro rfl; rw [zero_pow hm.ne'] at hz; exact (w⁻¹).ne_zero hz.symm
          refine ⟨Units.mk0 z hz0, ?_⟩
          have h3 : Units.mk0 z hz0 ^ n.natAbs = w⁻¹ := by ext; simp [hz]
          rw [h, zpow_neg, zpow_natCast, h3, inv_inv]
      letI : DivisibleBy (Additive (EllipticRootNumber.Ω F)ˣ) ℤ :=
        DivisibleBy.mk
          (fun d n => if hn : n = 0 then 0
            else Additive.ofMul (Classical.choose (root (Additive.toMul d) n hn)))
          (fun d => dif_pos rfl)
          (fun {n} d hn => by
            simp only [dif_neg hn]
            rw [← ofMul_zpow, Classical.choose_spec (root (Additive.toMul d) n hn)]
            rfl)
      have hBaer : Module.Baer ℤ (Additive (EllipticRootNumber.Ω F)ˣ) :=
        Module.Baer.of_divisible _
      set h : ℤ →+ F ⧸ B := zmultiplesHom (F ⧸ B) (a : F ⧸ B) with hh
      set g₀ : ℤ →+ Additive (EllipticRootNumber.Ω F)ˣ :=
        zmultiplesHom (Additive (EllipticRootNumber.Ω F)ˣ) (Additive.ofMul u) with hg₀
      have hker : h.ker ≤ g₀.ker := by
        intro n hn
        rw [AddMonoidHom.mem_ker] at hn ⊢
        rw [hh, zmultiplesHom_apply] at hn
        obtain ⟨k, rfl⟩ := addOrderOf_dvd_iff_zsmul_eq_zero.mpr hn
        rw [hg₀, zmultiplesHom_apply, ← ofMul_zpow, zpow_mul, huN, one_zpow]
        rfl
      obtain ⟨G, hG⟩ := Module.Baer.extension_property hBaer
        (QuotientAddGroup.kerLift h).toIntLinearMap (QuotientAddGroup.kerLift_injective h)
        (QuotientAddGroup.lift h.ker g₀ hker).toIntLinearMap
      have hGc : G (a : F ⧸ B) = Additive.ofMul u := by
        have h1 := LinearMap.congr_fun hG ((1 : ℤ) : ℤ ⧸ h.ker)
        change G (QuotientAddGroup.kerLift h ((1 : ℤ) : ℤ ⧸ h.ker)) =
            QuotientAddGroup.lift h.ker g₀ hker ((1 : ℤ) : ℤ ⧸ h.ker) at h1
        rw [QuotientAddGroup.kerLift_mk, QuotientAddGroup.lift_mk, hh, hg₀, zmultiplesHom_apply,
          zmultiplesHom_apply, one_zsmul, one_zsmul] at h1
        exact h1
      refine ⟨AddChar.mk (fun x => ((Additive.toMul (G (x : F ⧸ B)) :
        (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F)) ?_ ?_, ?_, ?_⟩
      · simp
      · intro x y
        simp [QuotientAddGroup.mk_add, map_add, toMul_add]
      · intro b hb
        have hb0 : (b : F ⧸ B) = 0 := (QuotientAddGroup.eq_zero_iff b).mpr hb
        simp [hb0]
      · simp only [AddChar.coe_mk]
        rw [hGc, toMul_ofMul, hu, Units.val_mk0]
        exact hζ1
    set ιF := IntermediateField.botEquiv F (AlgebraicClosure F) with hιF
    obtain ⟨_, _, hiff, hex, hvalL⟩ := addVal_facts F
    obtain ⟨y₀, hy₀⟩ := hex 1
    set B : AddSubgroup F := (ValuativeRel.valuation F).integer.toAddSubgroup with hB
    have hmemB : ∀ t : F, t ∈ B ↔ ValuativeRel.valuation F t ≤ 1 := by
      intro t
      rw [hB, Subring.mem_toAddSubgroup, Valuation.mem_integer_iff]
    have hy₀B : y₀ ∉ B := by
      intro h
      have h1 := (hiff y₀).mpr ((hmemB y₀).mp h)
      rw [hy₀] at h1
      norm_num at h1
    obtain ⟨ψ₀, hψB, hψa⟩ := absChar B y₀ hy₀B
    set ψ := ψ₀.compAddMonoidHom ιF.toRingEquiv.toRingHom.toAddMonoidHom with hψ
    have hψapp : ∀ x, ψ x = ψ₀ (ιF x) := fun x => rfl
    have hP : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1) ∧
        ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1 := by
      refine ⟨fun x hx => ?_, ιF.symm y₀, ?_, ?_⟩
      · rw [hψapp]
        apply hψB
        rw [hmemB, ← hiff, ← hvalL]
        exact hx
      · rw [hvalL, ιF.apply_symm_apply, hy₀]
      · rw [hψapp, ιF.apply_symm_apply]
        exact hψa
    have hexψ : ∃ φ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F))
        (EllipticRootNumber.Ω F),
        (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → φ x = 1) ∧
          ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ φ x ≠ 1 := ⟨ψ, hP⟩
    unfold EllipticRootNumber.stdChar
    exact Classical.epsilon_spec hexψ
  
  have intHom : ∀ {G : Type u} [CommGroup G] (f g : G → ℤ),
      (∀ x y, f (x * y) = f x + f y) → (∀ x y, g (x * y) = g x + g y) →
      (∀ x, 0 ≤ f x ↔ 0 ≤ g x) → (∃ a, f a = 1) → (∃ b, g b = 1) → ∀ x, f x = g x := by
    intro G _ f g hf hg hfg ⟨a, ha⟩ ⟨b, hb⟩
    have base : ∀ (h : G → ℤ), (∀ x y, h (x * y) = h x + h y) →
        (∀ z, h z⁻¹ = -h z) ∧ ∀ (x : G) (n : ℤ), h (x ^ n) = n * h x := by
      intro h hh
      have h1 : h 1 = 0 := by
        have := hh 1 1
        rw [mul_one] at this
        omega
      have hinv : ∀ z, h z⁻¹ = -h z := by
        intro z
        have := hh z z⁻¹
        rw [mul_inv_cancel, h1] at this
        omega
      refine ⟨hinv, fun x n => ?_⟩
      induction n using Int.induction_on with
      | zero => rw [zpow_zero, h1, zero_mul]
      | succ k ih => rw [zpow_add_one, hh, ih]; ring
      | pred k ih => rw [zpow_sub_one, hh, ih, hinv]; ring
    obtain ⟨finv, fpow⟩ := base f hf
    obtain ⟨ginv, gpow⟩ := base g hg
    have kerf : ∀ z, f z = 0 → g z = 0 := by
      intro z hz
      have h1 := (hfg z).mp (by omega)
      have h2 := (hfg z⁻¹).mp (by rw [finv]; omega)
      rw [ginv] at h2
      omega
    have hgx : ∀ x, g x = f x * g a := by
      intro x
      have hz : f (x * a ^ (-(f x))) = 0 := by
        rw [hf, fpow, ha]; ring
      have h0 := kerf _ hz
      rw [hg, gpow] at h0
      linear_combination h0
    have hc : g a * f b = 1 := by
      have h0 := hgx b
      rw [hb] at h0
      linear_combination -h0
    have hc' : g a = 1 ∨ g a = -1 := Int.eq_one_or_neg_one_of_mul_eq_one hc
    have hpos : 0 ≤ g a := (hfg a).mp (by omega)
    have hc1 : g a = 1 := by omega
    intro x
    rw [hgx x, hc1, mul_one]
  
  obtain ⟨z1, mul1, iff1, ex1, val1⟩ := addVal_facts F₁
  obtain ⟨z2, mul2, iff2, ex2, val2⟩ := addVal_facts F₂
  have trans : ∀ a : F₁, EllipticRootNumber.addVal F₂ (τ a) = EllipticRootNumber.addVal F₁ a := by
    intro a
    by_cases ha : a = 0
    · rw [ha, map_zero, z1, z2]
    · obtain ⟨y, hy⟩ := ex1 (-1)
      have hy0 : y ≠ 0 := by
        rintro rfl
        rw [z1] at hy
        norm_num at hy
      obtain ⟨z, hz⟩ := ex2 (-1)
      have hz0 : z ≠ 0 := by
        rintro rfl
        rw [z2] at hz
        norm_num at hz
      have hτz0 : τ.symm z ≠ 0 := (map_ne_zero τ.symm).mpr hz0
      have key := intHom (G := F₁ˣ) (fun u => EllipticRootNumber.addVal F₁ (u : F₁))
        (fun u => EllipticRootNumber.addVal F₂ (τ (u : F₁)))
        (fun u w => by
          simp only [Units.val_mul]
          exact mul1 _ _ u.ne_zero w.ne_zero)
        (fun u w => by
          simp only [Units.val_mul, map_mul]
          exact mul2 _ _ ((map_ne_zero τ).mpr u.ne_zero) ((map_ne_zero τ).mpr w.ne_zero))
        (fun u => by
          show 0 ≤ EllipticRootNumber.addVal F₁ (u : F₁) ↔
            0 ≤ EllipticRootNumber.addVal F₂ (τ (u : F₁))
          rw [iff1, iff2, hS])
        ⟨Units.mk0 y hy0, by
          show EllipticRootNumber.addVal F₁ y = 1
          rw [hy]; norm_num⟩
        ⟨Units.mk0 (τ.symm z) hτz0, by
          show EllipticRootNumber.addVal F₂ (τ (τ.symm z)) = 1
          rw [RingEquiv.apply_symm_apply, hz]; norm_num⟩
        (Units.mk0 a ha)
      exact key.symm
  
  set b1 := IntermediateField.botEquiv F₁ (AlgebraicClosure F₁) with hb1
  set b2 := IntermediateField.botEquiv F₂ (AlgebraicClosure F₂) with hb2
  let T : (⊥ : IntermediateField F₁ (AlgebraicClosure F₁)) ≃+*
      (⊥ : IntermediateField F₂ (AlgebraicClosure F₂)) :=
    (b1.toRingEquiv.trans τ).trans b2.symm.toRingEquiv
  have hTapp : ∀ x, T x = b2.symm (τ (b1 x)) := fun x => rfl
  have hcoe1 : ∀ c : F₁, ((b1.symm c : (⊥ : IntermediateField F₁ (AlgebraicClosure F₁))) :
      AlgebraicClosure F₁) = algebraMap F₁ (AlgebraicClosure F₁) c := by
    intro c
    rw [hb1, IntermediateField.botEquiv_symm, IntermediateField.coe_algebraMap_apply]
  have hcoe2 : ∀ c : F₂, ((b2.symm c : (⊥ : IntermediateField F₂ (AlgebraicClosure F₂))) :
      AlgebraicClosure F₂) = algebraMap F₂ (AlgebraicClosure F₂) c := by
    intro c
    rw [hb2, IntermediateField.botEquiv_symm, IntermediateField.coe_algebraMap_apply]
  have hT : ∀ x : (⊥ : IntermediateField F₁ (AlgebraicClosure F₁)),
      ((T x : (⊥ : IntermediateField F₂ (AlgebraicClosure F₂))) : AlgebraicClosure F₂) =
        τb (x : AlgebraicClosure F₁) := by
    intro x
    have e1 : (x : AlgebraicClosure F₁) = algebraMap F₁ (AlgebraicClosure F₁) (b1 x) := by
      rw [← hcoe1 (b1 x), AlgEquiv.symm_apply_apply]
    rw [hTapp, hcoe2, e1, hτb]
  
  have hvT : ∀ x : (⊥ : IntermediateField F₁ (AlgebraicClosure F₁)),
      EllipticRootNumber.valL F₂ ⊥ (T x) = EllipticRootNumber.valL F₁ ⊥ x := by
    intro x
    rw [val2, val1, hTapp, AlgEquiv.apply_symm_apply, trans]
  
  obtain ⟨h0, y₂, hy₂v, hy₂ne⟩ := stdSpec F₂
  let ψ : AddChar (⊥ : IntermediateField F₁ (AlgebraicClosure F₁)) (EllipticRootNumber.Ω F₁) :=
    AddChar.mk (fun x => ι.symm (EllipticRootNumber.stdChar F₂ (T x)))
      (by simp only [map_zero, AddChar.map_zero_eq_one, map_one])
      (by intro a b; simp only [map_add, AddChar.map_add_eq_mul, map_mul])
  have hψ : ∀ x, ψ x = ι.symm (EllipticRootNumber.stdChar F₂ (T x)) := fun x => rfl
  refine ⟨ψ, ⟨fun x hx => ?_, T.symm y₂, ?_, ?_⟩, fun x₁ x₂ hx => ?_⟩
  · rw [hψ, h0 _ (by rw [hvT]; exact hx), map_one]
  · rw [← hvT, RingEquiv.apply_symm_apply, hy₂v]
  · intro h
    apply hy₂ne
    rw [hψ, RingEquiv.apply_symm_apply] at h
    have h' := congrArg ι h
    rwa [RingEquiv.apply_symm_apply, map_one] at h'
  · have hx' : x₂ = T x₁ := Subtype.ext (by rw [hx, hT])
    rw [hx', hψ, RingEquiv.apply_symm_apply]

theorem frobDet_transport {F₁ F₂ : Type u} [Field F₁] [Field F₂]
    [ValuativeRel F₁] [TopologicalSpace F₁] [IsNonarchimedeanLocalField F₁]
    [ValuativeRel F₂] [TopologicalSpace F₂] [IsNonarchimedeanLocalField F₂]
    (κ : EllipticRootNumber.AbsGal F₁ ≃* EllipticRootNumber.AbsGal F₂)
    (L₁ : IntermediateField F₁ (AlgebraicClosure F₁))
    (L₂ : IntermediateField F₂ (AlgebraicClosure F₂))
    (hW : ∀ σ, κ σ ∈ EllipticRootNumber.relWeil F₂ L₂ ↔ σ ∈ EllipticRootNumber.relWeil F₁ L₁)
    (hI : ∀ σ, κ σ ∈ EllipticRootNumber.inertia F₂ ↔ σ ∈ EllipticRootNumber.inertia F₁)
    (hΦ : ∃ i : EllipticRootNumber.relWeil F₁ L₁,
      (i : EllipticRootNumber.AbsGal F₁) ∈ EllipticRootNumber.inertia F₁ ∧
      κ ((EllipticRootNumber.geomFrobL F₁ L₁ (EllipticRootNumber.resDeg F₁ L₁) * i :
          EllipticRootNumber.relWeil F₁ L₁) : EllipticRootNumber.AbsGal F₁) =
        ((EllipticRootNumber.geomFrobL F₂ L₂ (EllipticRootNumber.resDeg F₂ L₂) :
          EllipticRootNumber.relWeil F₂ L₂) : EllipticRootNumber.AbsGal F₂))
    (ι : EllipticRootNumber.Ω F₁ ≃+* EllipticRootNumber.Ω F₂)
    (σ₁ : EllipticRootNumber.WDRep F₁ L₁) (σ₂ : EllipticRootNumber.WDRep F₂ L₂)
    (e : σ₁.V ≃+ σ₂.V)
    (he : ∀ (c : EllipticRootNumber.Ω F₁) (v : σ₁.V), e (c • v) = ι c • e v)
    (hρ : ∀ (w₁ : EllipticRootNumber.relWeil F₁ L₁) (w₂ : EllipticRootNumber.relWeil F₂ L₂),
      (w₂ : EllipticRootNumber.AbsGal F₂) = κ w₁ → ∀ v, e (σ₁.ρ w₁ v) = σ₂.ρ w₂ (e v))
    (hN : ∀ v, e (σ₁.N v) = σ₂.N (e v)) :
    EllipticRootNumber.frobDet F₂ L₂ σ₂ = ι (EllipticRootNumber.frobDet F₁ L₁ σ₁) :=
by
  classical
  
  have basisT : ∀ {k k' : Type} [Field k] [Field k'] {A B : Type u} [AddCommGroup A]
      [Module k A] [AddCommGroup B] [Module k' B] (j : k ≃+* k') (ε : A ≃+ B)
      (_hε : ∀ (c : k) (a : A), ε (c • a) = j c • ε a) {m : ℕ} (b : Module.Basis (Fin m) k A),
      ∃ b₂ : Module.Basis (Fin m) k' B, ∀ (a : A) (i : Fin m), b₂.repr (ε a) i = j (b.repr a i) := by
    intro k k' _ _ A B _ _ _ _ j ε hε m b
    have hεs : ∀ (c : k') (y : B), ε.symm (c • y) = j.symm c • ε.symm y := by
      intro c y
      apply ε.injective
      rw [hε, RingEquiv.apply_symm_apply, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
    let R0 : B ≃+ (Fin m →₀ k') :=
      ε.symm.trans (b.repr.toAddEquiv.trans (Finsupp.mapRange.addEquiv j.toAddEquiv))
    have hR0 : ∀ y, R0 y = Finsupp.mapRange j (map_zero j) (b.repr (ε.symm y)) := fun y => rfl
    let R : B ≃ₗ[k'] (Fin m →₀ k') := R0.toLinearEquiv (by
      intro c y
      rw [hR0, hR0, hεs, map_smul]
      ext i
      simp [Finsupp.mapRange_apply, map_mul])
    refine ⟨Module.Basis.ofRepr R, fun a i => ?_⟩
    show R0 (ε a) i = _
    rw [hR0, AddEquiv.symm_apply_apply, Finsupp.mapRange_apply]
  
  have detT : ∀ {A B : Type u} [AddCommGroup A] [Module (EllipticRootNumber.Ω F₁) A]
      [AddCommGroup B] [Module (EllipticRootNumber.Ω F₂) B] (ε : A ≃+ B)
      (_hε : ∀ (c : EllipticRootNumber.Ω F₁) (a : A), ε (c • a) = ι c • ε a)
      (f₁ : A →ₗ[EllipticRootNumber.Ω F₁] A) (f₂ : B →ₗ[EllipticRootNumber.Ω F₂] B)
      (_hf : ∀ a, ε (f₁ a) = f₂ (ε a)), LinearMap.det f₂ = ι (LinearMap.det f₁) := by
    intro A B _ _ _ _ ε hε f₁ f₂ hf
    have hεs : ∀ (c : EllipticRootNumber.Ω F₂) (y : B), ε.symm (c • y) = ι.symm c • ε.symm y := by
      intro c y
      apply ε.injective
      rw [hε, RingEquiv.apply_symm_apply, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
    by_cases hfin : Module.Finite (EllipticRootNumber.Ω F₁) A
    · haveI := hfin
      let b := Module.finBasis (EllipticRootNumber.Ω F₁) A
      obtain ⟨b₂, hb₂⟩ := basisT ι ε hε b
      have hb₂j : ∀ j, b₂ j = ε (b j) := by
        intro j
        apply b₂.repr.injective
        ext i
        rw [hb₂, Module.Basis.repr_self, Module.Basis.repr_self]
        by_cases h : j = i <;> simp [Finsupp.single_apply, h]
      have hM : LinearMap.toMatrix b₂ b₂ f₂ =
          (ι : EllipticRootNumber.Ω F₁ →+* EllipticRootNumber.Ω F₂).mapMatrix
            (LinearMap.toMatrix b b f₁) := by
        ext i j
        rw [LinearMap.toMatrix_apply, RingHom.mapMatrix_apply, Matrix.map_apply,
          LinearMap.toMatrix_apply, hb₂j, ← hf, hb₂]
        rfl
      rw [← LinearMap.det_toMatrix b₂ f₂, hM, ← RingHom.map_det, LinearMap.det_toMatrix]
      rfl
    · have hfin2 : ¬ Module.Finite (EllipticRootNumber.Ω F₂) B := by
        intro h2
        haveI := h2
        obtain ⟨b₁, -⟩ := basisT ι.symm ε.symm hεs (Module.finBasis (EllipticRootNumber.Ω F₂) B)
        exact hfin (Module.Finite.of_basis b₁)
      rw [LinearMap.det_eq_one_of_not_module_finite hfin,
        LinearMap.det_eq_one_of_not_module_finite hfin2, map_one]
  
  have memI₁ : ∀ v : σ₁.V, v ∈ EllipticRootNumber.inertiaInvariants F₁ L₁ σ₁ ↔
      ∀ w : EllipticRootNumber.relWeil F₁ L₁, (w : EllipticRootNumber.AbsGal F₁) ∈
        EllipticRootNumber.inertia F₁ → σ₁.ρ w v = v := fun _ => Iff.rfl
  have memI₂ : ∀ v : σ₂.V, v ∈ EllipticRootNumber.inertiaInvariants F₂ L₂ σ₂ ↔
      ∀ w : EllipticRootNumber.relWeil F₂ L₂, (w : EllipticRootNumber.AbsGal F₂) ∈
        EllipticRootNumber.inertia F₂ → σ₂.ρ w v = v := fun _ => Iff.rfl
  have T : ∀ v : σ₁.V, e v ∈ EllipticRootNumber.inertiaInvariants F₂ L₂ σ₂ ↔
      v ∈ EllipticRootNumber.inertiaInvariants F₁ L₁ σ₁ := by
    intro v
    rw [memI₁, memI₂]
    constructor
    · intro hv w₁ hw₁
      have h := hρ w₁ ⟨κ w₁, (hW w₁).2 w₁.2⟩ rfl v
      apply e.injective
      rw [h]
      exact hv _ ((hI w₁).2 hw₁)
    · intro hv w₂ hw₂
      have hk : κ (κ.symm (w₂ : EllipticRootNumber.AbsGal F₂)) = w₂ := MulEquiv.apply_symm_apply κ _
      have hs : κ.symm (w₂ : EllipticRootNumber.AbsGal F₂) ∈ EllipticRootNumber.relWeil F₁ L₁ :=
        (hW _).1 (by rw [hk]; exact w₂.2)
      have hsI : κ.symm (w₂ : EllipticRootNumber.AbsGal F₂) ∈ EllipticRootNumber.inertia F₁ :=
        (hI _).1 (by rw [hk]; exact hw₂)
      have h := hρ ⟨_, hs⟩ w₂ hk.symm v
      rw [← h, hv ⟨_, hs⟩ hsI]
  
  obtain ⟨i, hiI, hκΦ⟩ := hΦ
  have star : ∀ v ∈ EllipticRootNumber.inertiaInvariants F₁ L₁ σ₁,
      e (σ₁.ρ (EllipticRootNumber.geomFrobL F₁ L₁ (EllipticRootNumber.resDeg F₁ L₁)) v) =
        σ₂.ρ (EllipticRootNumber.geomFrobL F₂ L₂ (EllipticRootNumber.resDeg F₂ L₂)) (e v) := by
    intro v hv
    have h1 : σ₁.ρ (EllipticRootNumber.geomFrobL F₁ L₁ (EllipticRootNumber.resDeg F₁ L₁) * i) v =
        σ₁.ρ (EllipticRootNumber.geomFrobL F₁ L₁ (EllipticRootNumber.resDeg F₁ L₁)) v := by
      rw [map_mul, Module.End.mul_apply, (memI₁ v).1 hv i hiI]
    rw [← h1]
    exact hρ _ _ hκΦ.symm v
  
  unfold EllipticRootNumber.frobDet
  dsimp only
  have C12 : (∀ v ∈ EllipticRootNumber.inertiaInvariants F₁ L₁ σ₁,
      σ₁.ρ (EllipticRootNumber.geomFrobL F₁ L₁ (EllipticRootNumber.resDeg F₁ L₁)) v ∈
        EllipticRootNumber.inertiaInvariants F₁ L₁ σ₁) →
      ∀ y ∈ EllipticRootNumber.inertiaInvariants F₂ L₂ σ₂,
      σ₂.ρ (EllipticRootNumber.geomFrobL F₂ L₂ (EllipticRootNumber.resDeg F₂ L₂)) y ∈
        EllipticRootNumber.inertiaInvariants F₂ L₂ σ₂ := by
    intro hC y hy
    have hv : e.symm y ∈ EllipticRootNumber.inertiaInvariants F₁ L₁ σ₁ :=
      (T _).1 (by rw [AddEquiv.apply_symm_apply]; exact hy)
    have h := star _ hv
    rw [AddEquiv.apply_symm_apply] at h
    rw [← h]
    exact (T _).2 (hC _ hv)
  have C21 : (∀ y ∈ EllipticRootNumber.inertiaInvariants F₂ L₂ σ₂,
      σ₂.ρ (EllipticRootNumber.geomFrobL F₂ L₂ (EllipticRootNumber.resDeg F₂ L₂)) y ∈
        EllipticRootNumber.inertiaInvariants F₂ L₂ σ₂) →
      ∀ v ∈ EllipticRootNumber.inertiaInvariants F₁ L₁ σ₁,
      σ₁.ρ (EllipticRootNumber.geomFrobL F₁ L₁ (EllipticRootNumber.resDeg F₁ L₁)) v ∈
        EllipticRootNumber.inertiaInvariants F₁ L₁ σ₁ := by
    intro hC v hv
    apply (T _).1
    rw [star v hv]
    exact hC _ ((T v).2 hv)
  by_cases hC₁ : ∀ v ∈ EllipticRootNumber.inertiaInvariants F₁ L₁ σ₁,
      σ₁.ρ (EllipticRootNumber.geomFrobL F₁ L₁ (EllipticRootNumber.resDeg F₁ L₁)) v ∈
        EllipticRootNumber.inertiaInvariants F₁ L₁ σ₁
  swap
  · have hC₂ : ¬ ∀ y ∈ EllipticRootNumber.inertiaInvariants F₂ L₂ σ₂,
        σ₂.ρ (EllipticRootNumber.geomFrobL F₂ L₂ (EllipticRootNumber.resDeg F₂ L₂)) y ∈
          EllipticRootNumber.inertiaInvariants F₂ L₂ σ₂ := fun h => hC₁ (C21 h)
    rw [dif_neg hC₂, dif_neg hC₁, map_one]
  have hC₂ := C12 hC₁
  rw [dif_pos hC₂, dif_pos hC₁]
  set VI₁ := EllipticRootNumber.inertiaInvariants F₁ L₁ σ₁ with hVI₁
  set VI₂ := EllipticRootNumber.inertiaInvariants F₂ L₂ σ₂ with hVI₂
  set fI₁ := (σ₁.ρ (EllipticRootNumber.geomFrobL F₁ L₁ (EllipticRootNumber.resDeg F₁ L₁))).restrict
    hC₁ with hfI₁
  set fI₂ := (σ₂.ρ (EllipticRootNumber.geomFrobL F₂ L₂ (EllipticRootNumber.resDeg F₂ L₂))).restrict
    hC₂ with hfI₂
  set K₁ := (LinearMap.ker σ₁.N).comap VI₁.subtype with hK₁
  set K₂ := (LinearMap.ker σ₂.N).comap VI₂.subtype with hK₂
  
  obtain ⟨e', he'smul, he'coe⟩ : ∃ e' : VI₁ ≃+ VI₂,
      (∀ (c : EllipticRootNumber.Ω F₁) (x : VI₁), e' (c • x) = ι c • e' x) ∧
        ∀ x : VI₁, (e' x : σ₂.V) = e x :=
    ⟨{ toFun := fun x => ⟨e x, (T x).2 x.2⟩
       invFun := fun y => ⟨e.symm y, (T _).1 (by rw [AddEquiv.apply_symm_apply]; exact y.2)⟩
       left_inv := fun x => Subtype.ext (e.symm_apply_apply _)
       right_inv := fun y => Subtype.ext (e.apply_symm_apply _)
       map_add' := fun x y => Subtype.ext (map_add e _ _) },
     fun c x => Subtype.ext (he c x), fun _ => rfl⟩
  have hfI : ∀ x : VI₁, e' (fI₁ x) = fI₂ (e' x) := by
    intro x
    apply Subtype.ext
    rw [he'coe]
    show e (σ₁.ρ (EllipticRootNumber.geomFrobL F₁ L₁ (EllipticRootNumber.resDeg F₁ L₁)) x) =
      σ₂.ρ (EllipticRootNumber.geomFrobL F₂ L₂ (EllipticRootNumber.resDeg F₂ L₂)) (e' x : σ₂.V)
    rw [he'coe]
    exact star x x.2
  have hKc : ∀ x : VI₁, e' x ∈ K₂ ↔ x ∈ K₁ := by
    intro x
    rw [hK₁, hK₂, Submodule.mem_comap, Submodule.mem_comap, Submodule.coe_subtype,
      Submodule.coe_subtype, LinearMap.mem_ker, LinearMap.mem_ker, he'coe, ← hN,
      AddEquiv.map_eq_zero_iff]
  
  have D12 : K₁ ≤ K₁.comap fI₁ → K₂ ≤ K₂.comap fI₂ := by
    intro hD y hy
    rw [Submodule.mem_comap]
    have hx : e'.symm y ∈ K₁ := (hKc _).1 (by rw [AddEquiv.apply_symm_apply]; exact hy)
    have h := hfI (e'.symm y)
    rw [AddEquiv.apply_symm_apply] at h
    rw [← h]
    exact (hKc (fI₁ (e'.symm y))).2 (hD hx)
  have D21 : K₂ ≤ K₂.comap fI₂ → K₁ ≤ K₁.comap fI₁ := by
    intro hD x hx
    rw [Submodule.mem_comap]
    apply (hKc _).1
    rw [hfI]
    exact hD ((hKc x).2 hx)
  by_cases hD₁ : K₁ ≤ K₁.comap fI₁
  swap
  · have hD₂ : ¬ K₂ ≤ K₂.comap fI₂ := fun h => hD₁ (D21 h)
    rw [dif_neg hD₂, dif_neg hD₁, map_one]
  have hD₂ := D12 hD₁
  rw [dif_pos hD₂, dif_pos hD₁]
  
  let E : VI₁ →ₛₗ[(ι : EllipticRootNumber.Ω F₁ →+* EllipticRootNumber.Ω F₂)] VI₂ :=
    { toFun := e', map_add' := map_add e', map_smul' := he'smul }
  have he's : ∀ (c : EllipticRootNumber.Ω F₂) (y : VI₂), e'.symm (c • y) = ι.symm c • e'.symm y := by
    intro c y
    apply e'.injective
    rw [he'smul, RingEquiv.apply_symm_apply, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply]
  let E' : VI₂ →ₛₗ[(ι.symm : EllipticRootNumber.Ω F₂ →+* EllipticRootNumber.Ω F₁)] VI₁ :=
    { toFun := e'.symm, map_add' := map_add e'.symm, map_smul' := he's }
  have hE1 : K₁ ≤ K₂.comap E := fun x hx => (hKc x).2 hx
  have hE2 : K₂ ≤ K₁.comap E' := fun y hy =>
    (hKc (e'.symm y)).1 (by rw [AddEquiv.apply_symm_apply]; exact hy)
  let q := K₁.mapQ K₂ E hE1
  let q' := K₂.mapQ K₁ E' hE2
  have hqq' : ∀ z, q' (q z) = z := by
    intro z
    induction z using Submodule.Quotient.induction_on with
    | H x =>
      show Submodule.Quotient.mk (e'.symm (e' x)) = Submodule.Quotient.mk x
      rw [AddEquiv.symm_apply_apply]
  have hq'q : ∀ z, q (q' z) = z := by
    intro z
    induction z using Submodule.Quotient.induction_on with
    | H y =>
      show Submodule.Quotient.mk (e' (e'.symm y)) = Submodule.Quotient.mk y
      rw [AddEquiv.apply_symm_apply]
  let ε : (VI₁ ⧸ K₁) ≃+ (VI₂ ⧸ K₂) :=
    { toFun := q, invFun := q', left_inv := hqq', right_inv := hq'q, map_add' := map_add q }
  have hεsmul : ∀ (c : EllipticRootNumber.Ω F₁) (z : VI₁ ⧸ K₁), ε (c • z) = ι c • ε z :=
    fun c z => map_smulₛₗ q c z
  have hg : ∀ z, ε ((-(K₁.mapQ K₁ fI₁ hD₁)) z) = (-(K₂.mapQ K₂ fI₂ hD₂)) (ε z) := by
    intro z
    induction z using Submodule.Quotient.induction_on with
    | H x =>
      show q (-(K₁.mapQ K₁ fI₁ hD₁ (Submodule.Quotient.mk x))) =
        -(K₂.mapQ K₂ fI₂ hD₂ (q (Submodule.Quotient.mk x)))
      rw [map_neg]
      show -(Submodule.Quotient.mk (e' (fI₁ x)) : VI₂ ⧸ K₂) =
        -(Submodule.Quotient.mk (fI₂ (e' x)))
      rw [hfI]
  exact detT ε hεsmul _ _ hg

theorem frobDet_bot_transport {F₁ F₂ : Type u} [Field F₁] [Field F₂]
    [ValuativeRel F₁] [TopologicalSpace F₁] [IsNonarchimedeanLocalField F₁]
    [ValuativeRel F₂] [TopologicalSpace F₂] [IsNonarchimedeanLocalField F₂]
    (τ : F₁ ≃+* F₂)
    (hS : ∀ x : F₁, ValuativeRel.valuation F₂ (τ x) ≤ 1 ↔ ValuativeRel.valuation F₁ x ≤ 1)
    (τb : AlgebraicClosure F₁ ≃+* AlgebraicClosure F₂)
    (hτb : ∀ x : F₁, τb (algebraMap F₁ (AlgebraicClosure F₁) x) =
        algebraMap F₂ (AlgebraicClosure F₂) (τ x))
    (κ : EllipticRootNumber.AbsGal F₁ ≃* EllipticRootNumber.AbsGal F₂)
    (hκ : ∀ σ x, κ σ (τb x) = τb (σ x))
    (rec₁ : EllipticRootNumber.LocalReciprocity F₁)
    (rec₂ : EllipticRootNumber.LocalReciprocity F₂)
    (ι : EllipticRootNumber.Ω F₁ ≃+* EllipticRootNumber.Ω F₂)
    (σ₁ : EllipticRootNumber.WDRep F₁ ⊥) (σ₂ : EllipticRootNumber.WDRep F₂ ⊥)
    (e : σ₁.V ≃+ σ₂.V)
    (he : ∀ (c : EllipticRootNumber.Ω F₁) (v : σ₁.V), e (c • v) = ι c • e v)
    (hρ : ∀ (w₁ : EllipticRootNumber.relWeil F₁ ⊥) (w₂ : EllipticRootNumber.relWeil F₂ ⊥),
      (w₂ : EllipticRootNumber.AbsGal F₂) = κ w₁ → ∀ v, e (σ₁.ρ w₁ v) = σ₂.ρ w₂ (e v))
    (hN : ∀ v, e (σ₁.N v) = σ₂.N (e v)) :
    EllipticRootNumber.frobDet F₂ ⊥ σ₂ = ι (EllipticRootNumber.frobDet F₁ ⊥ σ₁) :=
by
  classical
  
  obtain ⟨hq, hp, -, -⟩ := ringEquiv_localField_invariants τ hS
  obtain ⟨hIn, hFr, hWg, -⟩ := galConj_naturality τb κ hκ hp hq
  have spec₁ := weilDegreeHom_spec_of_localField F₁
  have spec₂ := weilDegreeHom_spec_of_localField F₂
  
  have hW : ∀ σ, κ σ ∈ EllipticRootNumber.relWeil F₂ ⊥ ↔
      σ ∈ EllipticRootNumber.relWeil F₁ ⊥ := by
    intro σ
    simp only [EllipticRootNumber.relWeil, Subgroup.mem_inf, IntermediateField.fixingSubgroup_bot,
      Subgroup.mem_top, and_true]
    exact hWg σ
  
  have hE : ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F] (rec : EllipticRootNumber.LocalReciprocity F),
      EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥)
          (EllipticRootNumber.geomFrobL F ⊥ (EllipticRootNumber.resDeg F ⊥))) =
        Multiplicative.ofAdd (-1) := by
    intro F _ _ _ _ rec
    obtain ⟨hres, -, x, hx⟩ := relVal_bot_spec F
    have hx0 : x ≠ 0 := by
      rintro rfl
      have h0 : EllipticRootNumber.relVal F ⊥
          (0 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
        rw [EllipticRootNumber.relVal, Algebra.norm_zero]
        simp [EllipticRootNumber.addVal]
      rw [h0] at hx
      exact absurd hx (by norm_num)
    have hspec := Classical.epsilon_spec
      (p := fun w : EllipticRootNumber.relWeil F ⊥ =>
        EllipticRootNumber.weilDegreeHom F
          (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) w) =
            Multiplicative.ofAdd (-((EllipticRootNumber.resDeg F ⊥ : ℕ) : ℤ)))
      ⟨rec.recMap ⊥ (Units.mk0 x hx0), by
        show EllipticRootNumber.weilDegreeHom F _ = _
        rw [rec.degree_rec ⊥ (Units.mk0 x hx0), Units.val_mk0, hx, hres]
        rfl⟩
    unfold EllipticRootNumber.geomFrobL
    rw [hspec, hres]
    rfl
  have E₁ := hE F₁ rec₁
  have E₂ := hE F₂ rec₂
  
  have hΦ₂W : ((EllipticRootNumber.geomFrobL F₂ ⊥ (EllipticRootNumber.resDeg F₂ ⊥) :
      EllipticRootNumber.relWeil F₂ ⊥) : EllipticRootNumber.AbsGal F₂) ∈
      EllipticRootNumber.weilGroup F₂ :=
    EllipticRootNumber.relWeil_le_weilGroup F₂ ⊥
      (EllipticRootNumber.geomFrobL F₂ ⊥ (EllipticRootNumber.resDeg F₂ ⊥)).2
  obtain ⟨n, hn⟩ := spec₂.1 _ hΦ₂W
  have hn1 : n = -1 := by
    have hD := spec₂.2 ⟨_, hΦ₂W⟩ n hn
    have hD' : EllipticRootNumber.weilDegreeHom F₂
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F₂ ⊥)
          (EllipticRootNumber.geomFrobL F₂ ⊥ (EllipticRootNumber.resDeg F₂ ⊥))) =
        Multiplicative.ofAdd n := hD
    rw [E₂] at hD'
    exact (Multiplicative.ofAdd.injective hD').symm
  subst hn1
  
  set Φ₂ := EllipticRootNumber.geomFrobL F₂ ⊥ (EllipticRootNumber.resDeg F₂ ⊥) with hΦ₂def
  set Φ₁ := EllipticRootNumber.geomFrobL F₁ ⊥ (EllipticRootNumber.resDeg F₁ ⊥) with hΦ₁def
  have hw₁ : κ.symm (Φ₂ : EllipticRootNumber.AbsGal F₂) ∈ EllipticRootNumber.relWeil F₁ ⊥ :=
    (hW _).1 (by rw [MulEquiv.apply_symm_apply]; exact Φ₂.2)
  have hfr : EllipticRootNumber.ActsAsFrobPow F₁
      (κ.symm (Φ₂ : EllipticRootNumber.AbsGal F₂)) (-1) :=
    (hFr _ (-1)).1 (by rw [MulEquiv.apply_symm_apply]; exact hn)
  have hD₁ : EllipticRootNumber.weilDegreeHom F₁
      (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F₁ ⊥)
        (⟨_, hw₁⟩ : EllipticRootNumber.relWeil F₁ ⊥)) = Multiplicative.ofAdd (-1) :=
    spec₁.2 ⟨_, EllipticRootNumber.relWeil_le_weilGroup F₁ ⊥ hw₁⟩ (-1) hfr
  
  have hi : (((Φ₁⁻¹ * ⟨_, hw₁⟩ : EllipticRootNumber.relWeil F₁ ⊥)) :
      EllipticRootNumber.AbsGal F₁) ∈ EllipticRootNumber.inertia F₁ := by
    apply weilDegreeHom_ker_le_inertia F₁
      (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F₁ ⊥)
        (Φ₁⁻¹ * ⟨_, hw₁⟩))
    have hmul : EllipticRootNumber.weilDegreeHom F₁
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F₁ ⊥)
          (Φ₁ * (Φ₁⁻¹ * ⟨_, hw₁⟩))) =
        EllipticRootNumber.weilDegreeHom F₁
          (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F₁ ⊥) Φ₁) *
        EllipticRootNumber.weilDegreeHom F₁
          (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F₁ ⊥)
            (Φ₁⁻¹ * ⟨_, hw₁⟩)) := by
      rw [map_mul, map_mul]
    rw [mul_inv_cancel_left, hD₁, E₁] at hmul
    exact left_eq_mul.mp hmul
  
  refine frobDet_transport κ ⊥ ⊥ hW hIn ⟨Φ₁⁻¹ * ⟨_, hw₁⟩, hi, ?_⟩ ι σ₁ σ₂ e he hρ hN
  rw [mul_inv_cancel_left]
  exact MulEquiv.apply_symm_apply κ _

theorem rootNumberNonarch_map_ringEquiv {F₁ F₂ : Type u} [Field F₁] [Field F₂]
    [ValuativeRel F₁] [TopologicalSpace F₁] [IsNonarchimedeanLocalField F₁]
    [ValuativeRel F₂] [TopologicalSpace F₂] [IsNonarchimedeanLocalField F₂]
    (τ : F₁ ≃+* F₂)
    (hS : ∀ x : F₁, ValuativeRel.valuation F₂ (τ x) ≤ 1 ↔ ValuativeRel.valuation F₁ x ≤ 1)
    (E : WeierstrassCurve F₁)
    (hW : EllipticRootNumber.IsWeilRep F₁ ⊥ (EllipticRootNumber.wdRep F₁ E).ρ) :
    (EllipticRootNumber.HasLocalConstants F₂ ↔ EllipticRootNumber.HasLocalConstants F₁) ∧
    (EllipticRootNumber.HasLocalConstants F₂ →
      ∃ (rec : EllipticRootNumber.LocalReciprocity F₁)
        (lc : EllipticRootNumber.LocalConstants F₁ rec)
        (ψ : AddChar (⊥ : IntermediateField F₁ (AlgebraicClosure F₁)) (EllipticRootNumber.Ω F₁)),
        ((∀ x, 0 ≤ EllipticRootNumber.valL F₁ ⊥ x → ψ x = 1) ∧
          ∃ x, EllipticRootNumber.valL F₁ ⊥ x = -1 ∧ ψ x ≠ 1) ∧
        EllipticRootNumber.rootNumberNonarch F₂ (E.map (τ : F₁ →+* F₂)) =
          @ite ℤˣ ((lc.eps ⊥ (EllipticRootNumber.wdRep F₁ E).ρ ψ : EllipticRootNumber.Ω F₁) *
              EllipticRootNumber.frobDet F₁ ⊥ (EllipticRootNumber.wdRep F₁ E) = -1)
            (Classical.propDecidable _) (-1) 1) :=
by
  classical
  
  have hLC : ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F], EllipticRootNumber.HasLocalConstants F := by
    intro F _ _ _ _
    obtain ⟨rec⟩ := local_reciprocity F
    exact ⟨rec, langlands_deligne F rec⟩
  refine ⟨⟨fun _ => hLC F₁, fun _ => hLC F₂⟩, ?_⟩
  intro h₂
  
  let τb : AlgebraicClosure F₁ ≃+* AlgebraicClosure F₂ :=
    IsAlgClosure.equivOfEquiv (AlgebraicClosure F₁) (AlgebraicClosure F₂) τ
  have hτb : ∀ x : F₁, τb (algebraMap F₁ (AlgebraicClosure F₁) x) =
      algebraMap F₂ (AlgebraicClosure F₂) (τ x) := fun x =>
    IsAlgClosure.equivOfEquiv_algebraMap (AlgebraicClosure F₁) (AlgebraicClosure F₂) τ x
  have hτbs : ∀ y : F₂, τb.symm (algebraMap F₂ (AlgebraicClosure F₂) y) =
      algebraMap F₁ (AlgebraicClosure F₁) (τ.symm y) := by
    intro y
    apply τb.injective
    rw [RingEquiv.apply_symm_apply, hτb, RingEquiv.apply_symm_apply]
  
  let conj : EllipticRootNumber.AbsGal F₁ → EllipticRootNumber.AbsGal F₂ := fun σ =>
    AlgEquiv.ofRingEquiv (f := τb.symm.trans (σ.toRingEquiv.trans τb)) (fun y => by
      simp only [RingEquiv.trans_apply, AlgEquiv.toRingEquiv_eq_coe, AlgEquiv.coe_ringEquiv, hτbs,
        AlgEquiv.commutes, hτb, RingEquiv.apply_symm_apply])
  let conj' : EllipticRootNumber.AbsGal F₂ → EllipticRootNumber.AbsGal F₁ := fun σ =>
    AlgEquiv.ofRingEquiv (f := τb.trans (σ.toRingEquiv.trans τb.symm)) (fun x => by
      simp only [RingEquiv.trans_apply, AlgEquiv.toRingEquiv_eq_coe, AlgEquiv.coe_ringEquiv, hτb,
        AlgEquiv.commutes, hτbs, RingEquiv.symm_apply_apply])
  have hconj : ∀ σ y, conj σ y = τb (σ (τb.symm y)) := fun σ y => rfl
  have hconj' : ∀ σ x, conj' σ x = τb.symm (σ (τb x)) := fun σ x => rfl
  let κ : EllipticRootNumber.AbsGal F₁ ≃* EllipticRootNumber.AbsGal F₂ :=
    { toFun := conj
      invFun := conj'
      left_inv := fun σ => by
        ext x
        rw [hconj', hconj, RingEquiv.symm_apply_apply, RingEquiv.symm_apply_apply]
      right_inv := fun σ => by
        ext y
        rw [hconj, hconj', RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply]
      map_mul' := fun σ σ' => by
        ext y
        simp only [hconj, AlgEquiv.mul_apply, RingEquiv.symm_apply_apply] }
  have hκ : ∀ σ x, κ σ (τb x) = τb (σ x) := fun σ x => by
    show conj σ (τb x) = _
    rw [hconj, RingEquiv.symm_apply_apply]
  
  have hcorr : ∀ y : AlgebraicClosure F₂, y ∈ (⊥ : IntermediateField F₂ (AlgebraicClosure F₂)) ↔
      τb.symm y ∈ (⊥ : IntermediateField F₁ (AlgebraicClosure F₁)) := by
    intro y
    simp only [IntermediateField.mem_bot, Set.mem_range]
    constructor
    · rintro ⟨b, rfl⟩
      exact ⟨τ.symm b, (hτbs b).symm⟩
    · rintro ⟨a, ha⟩
      refine ⟨τ a, ?_⟩
      rw [← hτb, ha, RingEquiv.apply_symm_apply]
  
  obtain ⟨rec₁, hrec⟩ := localReciprocity_transport τ hS τb hτb κ hκ (EllipticRootNumber.localReciprocity F₂)
  obtain ⟨ι, e, he, hρE, hNE⟩ := wdRep_transport τ hS τb hτb κ hκ E
  obtain ⟨lc₁, hlc⟩ := localConstants_transport τ hS τb hτb κ hκ ι rec₁ (EllipticRootNumber.localReciprocity F₂) hrec
    (EllipticRootNumber.localConstants F₂)
  obtain ⟨ψ₁, hstd, hψ⟩ := stdChar_transport τ hS τb hτb ι
  have hadm : EllipticRootNumber.IsAdmissibleChar F₁ ⊥ ψ₁ := by
    obtain ⟨h0, x, -, hx⟩ := hstd
    exact ⟨fun h => hx (by rw [h, AddChar.one_apply]), 0, h0⟩
  
  have E1 := hlc ⊥ ⊥ hcorr (EllipticRootNumber.wdRep F₁ E).ρ
    (EllipticRootNumber.wdRep F₂ (E.map (τ : F₁ →+* F₂))).ρ e he hρE ψ₁
    (EllipticRootNumber.stdChar F₂) hψ hW hadm
  
  have E2 := frobDet_bot_transport τ hS τb hτb κ hκ rec₁ (EllipticRootNumber.localReciprocity F₂) ι
    (EllipticRootNumber.wdRep F₁ E) (EllipticRootNumber.wdRep F₂ (E.map (τ : F₁ →+* F₂)))
    e he hρE hNE
  refine ⟨rec₁, lc₁, ψ₁, hstd, ?_⟩
  rw [EllipticRootNumber.rootNumberNonarch_of_hasLocalConstants F₂ _ h₂]
  have hloc : EllipticRootNumber.localEps F₂ (E.map (τ : F₁ →+* F₂))
      (EllipticRootNumber.localConstants F₂) =
      ι ((lc₁.eps ⊥ (EllipticRootNumber.wdRep F₁ E).ρ ψ₁ : EllipticRootNumber.Ω F₁) *
        EllipticRootNumber.frobDet F₁ ⊥ (EllipticRootNumber.wdRep F₁ E)) := by
    rw [map_mul, ← E1, ← E2]
    rfl
  rw [hloc]
  split_ifs with h1 h2 h2
  · rfl
  · exact absurd (ι.injective (h1.trans (by rw [map_neg, map_one]))) h2
  · exact (h1 (by rw [h2, map_neg, map_one])).elim
  · rfl

theorem quadCharΩ_recMap_spec (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] (E : WeierstrassCurve F)
    (rec rec' : EllipticRootNumber.LocalReciprocity F) :
    (∀ x y : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      EllipticRootNumber.quadCharΩ F E ⊥ (rec.recMap ⊥ (x * y)) =
        EllipticRootNumber.quadCharΩ F E ⊥ (rec.recMap ⊥ x) *
          EllipticRootNumber.quadCharΩ F E ⊥ (rec.recMap ⊥ y)) ∧
    (∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      EllipticRootNumber.quadCharΩ F E ⊥ (rec.recMap ⊥ x) =
        EllipticRootNumber.quadCharΩ F E ⊥ (rec'.recMap ⊥ x)) :=
by
  classical
  haveI hfd : FiniteDimensional F
      (IntermediateField.adjoin F {EllipticRootNumber.sqrtNegC₆ F E}) :=
    IntermediateField.adjoin.finiteDimensional
      (Algebra.IsIntegral.isIntegral (R := F) (EllipticRootNumber.sqrtNegC₆ F E))
  have hBM : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤
      IntermediateField.adjoin F {EllipticRootNumber.sqrtNegC₆ F E} := bot_le
  have key : ∀ σ : EllipticRootNumber.AbsGal F,
      EllipticRootNumber.quadSign F E σ = 1 ↔
        σ ∈ (IntermediateField.adjoin F {EllipticRootNumber.sqrtNegC₆ F E}).fixingSubgroup := by
    intro σ
    have h1 : σ ∈ (IntermediateField.adjoin F {EllipticRootNumber.sqrtNegC₆ F E}).fixingSubgroup ↔
        σ (EllipticRootNumber.sqrtNegC₆ F E) = EllipticRootNumber.sqrtNegC₆ F E := by
      constructor
      · intro h
        exact (IntermediateField.mem_fixingSubgroup_iff _ _).mp h _
          (IntermediateField.mem_adjoin_simple_self F _)
      · intro h
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        induction hx using IntermediateField.adjoin_induction with
        | mem x hx => rw [Set.mem_singleton_iff.mp hx]; exact h
        | algebraMap c => exact σ.commutes c
        | add x y _ _ hx hy => rw [map_add, hx, hy]
        | inv x _ hx => rw [map_inv₀, hx]
        | mul x y _ _ hx hy => rw [map_mul, hx, hy]
    rw [h1]
    unfold EllipticRootNumber.quadSign
    by_cases hσ : σ (EllipticRootNumber.sqrtNegC₆ F E) = EllipticRootNumber.sqrtNegC₆ F E
    · rw [if_pos hσ]
      exact ⟨fun _ => hσ, fun _ => rfl⟩
    · rw [if_neg hσ]
      exact ⟨fun h => absurd h (by decide), fun h => absurd h hσ⟩
  have hq : ∀ σ : EllipticRootNumber.AbsGal F,
      EllipticRootNumber.quadChar F E σ = EllipticRootNumber.quadSign F E σ := fun _ => rfl
  have hab : EllipticRootNumber.IsAbelianExt F hBM := by
    refine ⟨?_, ?_, inferInstance⟩
    · intro σ _ τ hτ
      rw [← key] at hτ ⊢
      rw [← hq, map_mul, map_mul, map_inv, hq τ, hτ, mul_one, mul_inv_cancel]
    · intro σ _ τ _
      rw [← key, ← hq, map_mul, map_mul, map_mul, map_inv, map_inv,
        mul_right_comm (EllipticRootNumber.quadChar F E σ), mul_inv_cancel, one_mul,
        mul_inv_cancel]
  have hχ : ∀ w : EllipticRootNumber.relWeil F (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.quadCharΩ F E ⊥ w =
        Units.map (Int.castRingHom (EllipticRootNumber.Ω F)).toMonoidHom
          (EllipticRootNumber.quadSign F E (w : EllipticRootNumber.AbsGal F)) := fun _ => rfl
  refine ⟨fun x y => ?_, fun x => ?_⟩
  · have hm := rec.mul_rec ⊥ _ hBM hab x y
    rw [← key] at hm
    have h1 : EllipticRootNumber.quadCharΩ F E ⊥
        ((rec.recMap ⊥ (x * y))⁻¹ * (rec.recMap ⊥ x * rec.recMap ⊥ y)) = 1 := by
      rw [hχ, hm, map_one]
    rw [map_mul, map_mul, map_inv, inv_mul_eq_one] at h1
    exact h1
  · have h1 := rec.ker_rec ⊥ _ hBM hab x
    have h2 := rec'.ker_rec ⊥ _ hBM hab x
    rw [← key] at h1 h2
    have H := h1.trans h2.symm
    rw [hχ, hχ]
    congr 1
    rcases Int.units_eq_one_or
        (EllipticRootNumber.quadSign F E (rec.recMap ⊥ x : EllipticRootNumber.AbsGal F)) with
      ha | ha <;>
    rcases Int.units_eq_one_or
        (EllipticRootNumber.quadSign F E (rec'.recMap ⊥ x : EllipticRootNumber.AbsGal F)) with
      hb | hb
    · rw [ha, hb]
    · exact absurd (H.mp ha) (by rw [hb]; decide)
    · exact absurd (H.mpr hb) (by rw [ha]; decide)
    · rw [ha, hb]

theorem unitGroup_bot_spec (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (a : ℕ)
    (ε : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ)
    (hε : ε ∈ EllipticRootNumber.unitGroup F ⊥ a) :
    EllipticRootNumber.valL F ⊥ (ε : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 ∧
      (1 ≤ a → (ε : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 ∨
        (a : ℤ) ≤ EllipticRootNumber.valL F ⊥
          ((ε : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1)) :=
by
  classical
  
  have key : ∀ (z : WithZero (Multiplicative ℤ)) (hz : z ≠ 0),
      Multiplicative.toAdd (WithZero.unzero hz) = WithZero.log z := by
    intro z hz
    obtain ⟨u, rfl⟩ := WithZero.ne_zero_iff_exists.mp hz
    rw [WithZero.unzero_coe]
    show _ = WithZero.log (WithZero.exp (Multiplicative.toAdd u))
    rw [WithZero.log_exp]
  have hne : ∀ c : F, c ≠ 0 →
      IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (ValuativeRel.valuation F c) ≠ 0 :=
    fun c hc => (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hc)
  have s1 : ∀ c : F, c ≠ 0 → EllipticRootNumber.addVal F c =
      -WithZero.log (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
        (ValuativeRel.valuation F c)) := by
    intro c hc
    unfold EllipticRootNumber.addVal
    rw [dif_neg hc, key]
  have s4 : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.relVal F ⊥ x =
        EllipticRootNumber.addVal F (IntermediateField.botEquiv F (AlgebraicClosure F) x) := by
    intro x
    unfold EllipticRootNumber.relVal
    congr 1
    have hx : x = algebraMap F (⊥ : IntermediateField F (AlgebraicClosure F))
        (IntermediateField.botEquiv F (AlgebraicClosure F) x) := by
      rw [← IntermediateField.botEquiv_symm, AlgEquiv.symm_apply_apply]
    conv_lhs => rw [hx]
    rw [Algebra.norm_algebraMap, IntermediateField.finrank_bot, pow_one]
  have s2 : ∀ c d : F, c ≠ 0 → d ≠ 0 → EllipticRootNumber.addVal F (c * d) =
      EllipticRootNumber.addVal F c + EllipticRootNumber.addVal F d := by
    intro c d hc hd
    rw [s1 _ (mul_ne_zero hc hd), s1 _ hc, s1 _ hd, map_mul, map_mul,
      WithZero.log_mul (hne c hc) (hne d hd), neg_add]
  have s3 : ∃ c : F, c ≠ 0 ∧ EllipticRootNumber.addVal F c = 1 := by
    obtain ⟨γ, hγ⟩ := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).surjective
      (WithZero.exp (-1 : ℤ))
    obtain ⟨c, hc⟩ := ValuativeRel.valuation_surjective γ
    have hc0 : c ≠ 0 := by
      intro h
      apply WithZero.exp_ne_zero (a := (-1 : ℤ))
      rw [← hγ, ← hc, h, map_zero, map_zero]
    refine ⟨c, hc0, ?_⟩
    have hγ' : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F γ =
        WithZero.exp (-1 : ℤ) := hγ
    rw [s1 c hc0, hc, hγ', WithZero.log_exp, neg_neg]
  have hres : EllipticRootNumber.resDeg F ⊥ = 1 := by
    obtain ⟨c, hc0, hc1⟩ := s3
    have h3 : EllipticRootNumber.relVal F ⊥
        ((IntermediateField.botEquiv F (AlgebraicClosure F)).symm c) = 1 := by
      rw [s4, AlgEquiv.apply_symm_apply, hc1]
    have hx0 : (IntermediateField.botEquiv F (AlgebraicClosure F)).symm c ≠ 0 :=
      (map_ne_zero_iff _ (IntermediateField.botEquiv F (AlgebraicClosure F)).symm.injective).mpr hc0
    unfold EllipticRootNumber.resDeg
    have hmem : 1 ∈ {k : ℕ | 0 < k ∧ ∃ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        x ≠ 0 ∧ EllipticRootNumber.relVal F ⊥ x = k} :=
      ⟨one_pos, _, hx0, h3.trans Nat.cast_one.symm⟩
    apply le_antisymm (Nat.sInf_le hmem)
    exact (Nat.sInf_mem ⟨1, hmem⟩).1
  have hmul : ∀ x y : (⊥ : IntermediateField F (AlgebraicClosure F)), x ≠ 0 → y ≠ 0 →
      EllipticRootNumber.relVal F ⊥ (x * y) =
        EllipticRootNumber.relVal F ⊥ x + EllipticRootNumber.relVal F ⊥ y := by
    intro x y hx hy
    have hx' : IntermediateField.botEquiv F (AlgebraicClosure F) x ≠ 0 :=
      (map_ne_zero_iff _ (IntermediateField.botEquiv F (AlgebraicClosure F)).injective).mpr hx
    have hy' : IntermediateField.botEquiv F (AlgebraicClosure F) y ≠ 0 :=
      (map_ne_zero_iff _ (IntermediateField.botEquiv F (AlgebraicClosure F)).injective).mpr hy
    rw [s4, s4, s4, map_mul, s2 _ _ hx' hy']
  have hvr : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.relVal F ⊥ x := by
    intro x
    unfold EllipticRootNumber.valL
    rw [hres, Nat.cast_one, Int.ediv_one]
  have hv : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x =
        EllipticRootNumber.addVal F (IntermediateField.botEquiv F (AlgebraicClosure F) x) := by
    intro x
    rw [hvr, s4]
  have hβne : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)), x ≠ 0 →
      IntermediateField.botEquiv F (AlgebraicClosure F) x ≠ 0 := fun x hx =>
    (map_ne_zero_iff _ (IntermediateField.botEquiv F (AlgebraicClosure F)).injective).mpr hx
  have V1 : EllipticRootNumber.valL F ⊥ (1 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
    rw [hv, map_one, s1 _ one_ne_zero, map_one, map_one, WithZero.log_one, neg_zero]
  have V2 : ∀ x y : (⊥ : IntermediateField F (AlgebraicClosure F)), x ≠ 0 → y ≠ 0 →
      EllipticRootNumber.valL F ⊥ (x * y) =
        EllipticRootNumber.valL F ⊥ x + EllipticRootNumber.valL F ⊥ y := by
    intro x y hx hy
    rw [hvr, hvr, hvr]
    exact hmul x y hx hy
  have V4 : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ (-x) = EllipticRootNumber.valL F ⊥ x := by
    intro x
    by_cases hx : x = 0
    · rw [hx, neg_zero]
    rw [hv, hv, map_neg, s1 _ (neg_ne_zero.mpr (hβne x hx)), s1 _ (hβne x hx),
      Valuation.map_neg]
  have V3 : ∀ x y : (⊥ : IntermediateField F (AlgebraicClosure F)), x ≠ 0 → y ≠ 0 → x + y ≠ 0 →
      min (EllipticRootNumber.valL F ⊥ x) (EllipticRootNumber.valL F ⊥ y) ≤
        EllipticRootNumber.valL F ⊥ (x + y) := by
    intro x y hx hy hxy
    have ha := hβne x hx
    have hb := hβne y hy
    have hab : IntermediateField.botEquiv F (AlgebraicClosure F) x +
        IntermediateField.botEquiv F (AlgebraicClosure F) y ≠ 0 := by
      rw [← map_add]; exact hβne _ hxy
    rw [hv, hv, hv, map_add, s1 _ ha, s1 _ hb, s1 _ hab]
    have hle := Valuation.map_add (ValuativeRel.valuation F)
      (IntermediateField.botEquiv F (AlgebraicClosure F) x)
      (IntermediateField.botEquiv F (AlgebraicClosure F) y)
    rcases le_total (ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) x))
        (ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) y)) with h | h
    · have h1 := hle.trans (max_le h le_rfl)
      have h2 := (map_le_map_iff (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F)).mpr h1
      have h3 := (WithZero.log_le_log (hne _ hab) (hne _ hb)).mpr h2
      exact (min_le_right _ _).trans (neg_le_neg h3)
    · have h1 := hle.trans (max_le le_rfl h)
      have h2 := (map_le_map_iff (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F)).mpr h1
      have h3 := (WithZero.log_le_log (hne _ hab) (hne _ ha)).mpr h2
      exact (min_le_left _ _).trans (neg_le_neg h3)
  have D1 : ∀ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      EllipticRootNumber.valL F ⊥ ((u⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) =
        -EllipticRootNumber.valL F ⊥ (u : (⊥ : IntermediateField F (AlgebraicClosure F))) := by
    intro u
    have h := V2 (u : (⊥ : IntermediateField F (AlgebraicClosure F)))
      ((u⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) u.ne_zero (u⁻¹).ne_zero
    rw [Units.mul_inv, V1] at h
    omega
  
  unfold EllipticRootNumber.unitGroup at hε
  induction hε using Subgroup.closure_induction with
  | mem u hu =>
    rw [Set.mem_setOf_eq] at hu
    by_cases ha : a = 0
    · rw [if_pos ha] at hu
      exact ⟨hu, fun h => absurd h (by omega)⟩
    · rw [if_neg ha] at hu
      by_cases h1 : (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1
      · exact ⟨by rw [h1, V1], fun _ => Or.inl h1⟩
      · have hge := hu.resolve_left h1
        have ha1 : (1 : ℤ) ≤ (a : ℤ) := by
          have : 1 ≤ a := Nat.one_le_iff_ne_zero.mpr ha
          exact_mod_cast this
        have hsub : (u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1 ≠ 0 :=
          sub_ne_zero.mpr h1
        refine ⟨?_, fun _ => Or.inr hge⟩
        have hid1 : (1 : (⊥ : IntermediateField F (AlgebraicClosure F))) +
            ((u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) = u := by ring
        have hid2 : (u : (⊥ : IntermediateField F (AlgebraicClosure F))) +
            -((u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) = 1 := by ring
        have e1 := V3 1 ((u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) one_ne_zero hsub
          (by rw [hid1]; exact u.ne_zero)
        rw [hid1, V1] at e1
        have e2 := V3 (u : (⊥ : IntermediateField F (AlgebraicClosure F)))
          (-((u : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1)) u.ne_zero
          (neg_ne_zero.mpr hsub) (by rw [hid2]; exact one_ne_zero)
        rw [hid2, V1, V4] at e2
        simp only [min_le_iff] at e1 e2
        omega
  | one =>
    exact ⟨by rw [Units.val_one, V1], fun _ => Or.inl Units.val_one⟩
  | mul x y _ _ hx hy =>
    obtain ⟨hx0, hx1⟩ := hx
    obtain ⟨hy0, hy1⟩ := hy
    rw [Units.val_mul]
    refine ⟨by rw [V2 _ _ x.ne_zero y.ne_zero, hx0, hy0, add_zero], fun ha => ?_⟩
    by_cases hp : (x : (⊥ : IntermediateField F (AlgebraicClosure F))) * y = 1
    · exact Or.inl hp
    right
    by_cases hxe : (x : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1
    · rw [hxe, one_mul] at hp ⊢
      exact (hy1 ha).resolve_left hp
    by_cases hye : (y : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1
    · rw [hye, mul_one] at hp ⊢
      exact (hx1 ha).resolve_left hp
    have hxa := (hx1 ha).resolve_left hxe
    have hya := (hy1 ha).resolve_left hye
    have hX : ((x : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) * y ≠ 0 :=
      mul_ne_zero (sub_ne_zero.mpr hxe) y.ne_zero
    have hY : (y : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1 ≠ 0 := sub_ne_zero.mpr hye
    have hid : (x : (⊥ : IntermediateField F (AlgebraicClosure F))) * y - 1 =
        ((x : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) * y +
          ((y : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) := by ring
    have hXY : ((x : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) * y +
        ((y : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) ≠ 0 := by
      rw [← hid]; exact sub_ne_zero.mpr hp
    have e := V3 _ _ hX hY hXY
    rw [← hid, V2 _ _ (sub_ne_zero.mpr hxe) y.ne_zero, hy0, add_zero] at e
    exact le_trans (le_min hxa hya) e
  | inv x _ hx =>
    obtain ⟨hx0, hx1⟩ := hx
    refine ⟨by rw [D1, hx0, neg_zero], fun ha => ?_⟩
    rw [Units.val_inv_eq_inv_val]
    by_cases hxe : (x : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1
    · left
      rw [hxe, inv_one]
    right
    have hxa := (hx1 ha).resolve_left hxe
    have hid : (x : (⊥ : IntermediateField F (AlgebraicClosure F)))⁻¹ - 1 =
        -(((x : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) *
          (x : (⊥ : IntermediateField F (AlgebraicClosure F)))⁻¹) := by
      rw [sub_mul, mul_inv_cancel₀ x.ne_zero, one_mul, neg_sub]
    rw [hid, V4, V2 _ _ (sub_ne_zero.mpr hxe) (inv_ne_zero x.ne_zero),
      ← Units.val_inv_eq_inv_val, D1, hx0, neg_zero, add_zero]
    exact hxa

theorem exists_unit_addChar_twist (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (ψ ψ' : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F))
    (hψ : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1)
    (hψ' : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ' x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ' x ≠ 1)
    (a : ℕ) :
    ∃ b : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      EllipticRootNumber.valL F ⊥ (b : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 ∧
      ∀ y : (⊥ : IntermediateField F (AlgebraicClosure F)),
        -(a : ℤ) ≤ EllipticRootNumber.valL F ⊥ y → ψ' y = ψ (b * y) :=
by
  classical
  
  have key : ∀ (z : WithZero (Multiplicative ℤ)) (hz : z ≠ 0),
      Multiplicative.toAdd (WithZero.unzero hz) = WithZero.log z := by
    intro z hz
    obtain ⟨u, rfl⟩ := WithZero.ne_zero_iff_exists.mp hz
    rw [WithZero.unzero_coe]
    show _ = WithZero.log (WithZero.exp (Multiplicative.toAdd u))
    rw [WithZero.log_exp]
  have hne : ∀ c : F, c ≠ 0 →
      IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (ValuativeRel.valuation F c) ≠ 0 :=
    fun c hc => (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hc)
  have s1 : ∀ c : F, c ≠ 0 → EllipticRootNumber.addVal F c =
      -WithZero.log (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
        (ValuativeRel.valuation F c)) := by
    intro c hc
    unfold EllipticRootNumber.addVal
    rw [dif_neg hc, key]
  have s0 : EllipticRootNumber.addVal F 0 = 0 := by
    unfold EllipticRootNumber.addVal
    rw [dif_pos rfl]
  have s4 : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.relVal F ⊥ x =
        EllipticRootNumber.addVal F (IntermediateField.botEquiv F (AlgebraicClosure F) x) := by
    intro x
    unfold EllipticRootNumber.relVal
    congr 1
    have hx : x = algebraMap F (⊥ : IntermediateField F (AlgebraicClosure F))
        (IntermediateField.botEquiv F (AlgebraicClosure F) x) := by
      rw [← IntermediateField.botEquiv_symm, AlgEquiv.symm_apply_apply]
    conv_lhs => rw [hx]
    rw [Algebra.norm_algebraMap, IntermediateField.finrank_bot, pow_one]
  have s2 : ∀ c d : F, c ≠ 0 → d ≠ 0 → EllipticRootNumber.addVal F (c * d) =
      EllipticRootNumber.addVal F c + EllipticRootNumber.addVal F d := by
    intro c d hc hd
    rw [s1 _ (mul_ne_zero hc hd), s1 _ hc, s1 _ hd, map_mul, map_mul,
      WithZero.log_mul (hne c hc) (hne d hd), neg_add]
  have s3 : ∃ c : F, c ≠ 0 ∧ EllipticRootNumber.addVal F c = 1 := by
    obtain ⟨γ, hγ⟩ := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).surjective
      (WithZero.exp (-1 : ℤ))
    obtain ⟨c, hc⟩ := ValuativeRel.valuation_surjective γ
    have hc0 : c ≠ 0 := by
      intro h
      apply WithZero.exp_ne_zero (a := (-1 : ℤ))
      rw [← hγ, ← hc, h, map_zero, map_zero]
    refine ⟨c, hc0, ?_⟩
    have hγ' : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F γ =
        WithZero.exp (-1 : ℤ) := hγ
    rw [s1 c hc0, hc, hγ', WithZero.log_exp, neg_neg]
  have hres : EllipticRootNumber.resDeg F ⊥ = 1 := by
    obtain ⟨c, hc0, hc1⟩ := s3
    have h3 : EllipticRootNumber.relVal F ⊥
        ((IntermediateField.botEquiv F (AlgebraicClosure F)).symm c) = 1 := by
      rw [s4, AlgEquiv.apply_symm_apply, hc1]
    have hx0 : (IntermediateField.botEquiv F (AlgebraicClosure F)).symm c ≠ 0 :=
      (map_ne_zero_iff _ (IntermediateField.botEquiv F (AlgebraicClosure F)).symm.injective).mpr hc0
    unfold EllipticRootNumber.resDeg
    have hmem : 1 ∈ {k : ℕ | 0 < k ∧ ∃ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        x ≠ 0 ∧ EllipticRootNumber.relVal F ⊥ x = k} :=
      ⟨one_pos, _, hx0, h3.trans Nat.cast_one.symm⟩
    apply le_antisymm (Nat.sInf_le hmem)
    exact (Nat.sInf_mem ⟨1, hmem⟩).1
  have hvr : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.relVal F ⊥ x := by
    intro x
    unfold EllipticRootNumber.valL
    rw [hres, Nat.cast_one, Int.ediv_one]
  have hv : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x =
        EllipticRootNumber.addVal F (IntermediateField.botEquiv F (AlgebraicClosure F) x) := by
    intro x
    rw [hvr, s4]
  have hβne : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)), x ≠ 0 →
      IntermediateField.botEquiv F (AlgebraicClosure F) x ≠ 0 := fun x hx =>
    (map_ne_zero_iff _ (IntermediateField.botEquiv F (AlgebraicClosure F)).injective).mpr hx
  have V0 : EllipticRootNumber.valL F ⊥ (0 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
    rw [hv, map_zero, s0]
  have V1 : EllipticRootNumber.valL F ⊥ (1 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
    rw [hv, map_one, s1 _ one_ne_zero, map_one, map_one, WithZero.log_one, neg_zero]
  have V2 : ∀ x y : (⊥ : IntermediateField F (AlgebraicClosure F)), x ≠ 0 → y ≠ 0 →
      EllipticRootNumber.valL F ⊥ (x * y) =
        EllipticRootNumber.valL F ⊥ x + EllipticRootNumber.valL F ⊥ y := by
    intro x y hx hy
    rw [hv, hv, hv, map_mul, s2 _ _ (hβne x hx) (hβne y hy)]
  have V4 : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ (-x) = EllipticRootNumber.valL F ⊥ x := by
    intro x
    by_cases hx : x = 0
    · rw [hx, neg_zero]
    rw [hv, hv, map_neg, s1 _ (neg_ne_zero.mpr (hβne x hx)), s1 _ (hβne x hx),
      Valuation.map_neg]
  have V3 : ∀ x y : (⊥ : IntermediateField F (AlgebraicClosure F)), x ≠ 0 → y ≠ 0 → x + y ≠ 0 →
      min (EllipticRootNumber.valL F ⊥ x) (EllipticRootNumber.valL F ⊥ y) ≤
        EllipticRootNumber.valL F ⊥ (x + y) := by
    intro x y hx hy hxy
    have ha := hβne x hx
    have hb := hβne y hy
    have hab : IntermediateField.botEquiv F (AlgebraicClosure F) x +
        IntermediateField.botEquiv F (AlgebraicClosure F) y ≠ 0 := by
      rw [← map_add]; exact hβne _ hxy
    rw [hv, hv, hv, map_add, s1 _ ha, s1 _ hb, s1 _ hab]
    have hle := Valuation.map_add (ValuativeRel.valuation F)
      (IntermediateField.botEquiv F (AlgebraicClosure F) x)
      (IntermediateField.botEquiv F (AlgebraicClosure F) y)
    rcases le_total (ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) x))
        (ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) y)) with h | h
    · have h1 := hle.trans (max_le h le_rfl)
      have h2 := (map_le_map_iff (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F)).mpr h1
      have h3 := (WithZero.log_le_log (hne _ hab) (hne _ hb)).mpr h2
      exact (min_le_right _ _).trans (neg_le_neg h3)
    · have h1 := hle.trans (max_le le_rfl h)
      have h2 := (map_le_map_iff (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F)).mpr h1
      have h3 := (WithZero.log_le_log (hne _ hab) (hne _ ha)).mpr h2
      exact (min_le_left _ _).trans (neg_le_neg h3)
  have Vinv : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)), x ≠ 0 →
      EllipticRootNumber.valL F ⊥ x⁻¹ = -EllipticRootNumber.valL F ⊥ x := by
    intro x hx
    have h := V2 x x⁻¹ hx (inv_ne_zero hx)
    rw [mul_inv_cancel₀ hx, V1] at h
    omega
  
  obtain ⟨π, hπ0, hπ⟩ : ∃ π : (⊥ : IntermediateField F (AlgebraicClosure F)),
      π ≠ 0 ∧ EllipticRootNumber.valL F ⊥ π = 1 := by
    obtain ⟨c, hc0, hc1⟩ := s3
    refine ⟨(IntermediateField.botEquiv F (AlgebraicClosure F)).symm c,
      (map_ne_zero_iff _ (IntermediateField.botEquiv F (AlgebraicClosure F)).symm.injective).mpr hc0,
      ?_⟩
    rw [hv, AlgEquiv.apply_symm_apply, hc1]
  have Vpow : ∀ n : ℕ, π ^ n ≠ 0 ∧ EllipticRootNumber.valL F ⊥ (π ^ n) = n := by
    intro n
    induction n with
    | zero => exact ⟨by rw [pow_zero]; exact one_ne_zero, by rw [pow_zero, V1]; rfl⟩
    | succ n ih =>
      refine ⟨by rw [pow_succ]; exact mul_ne_zero ih.1 hπ0, ?_⟩
      rw [pow_succ, V2 _ _ ih.1 hπ0, ih.2, hπ]
      push_cast
      ring
  
  rcases Nat.eq_zero_or_pos a with ha0 | ha1
  · subst ha0
    refine ⟨1, by rw [Units.val_one, V1], fun y hy => ?_⟩
    rw [Units.val_one, one_mul]
    have hy' : 0 ≤ EllipticRootNumber.valL F ⊥ y := by simpa using hy
    rw [hψ.1 y hy', hψ'.1 y hy']
  
  
  obtain ⟨Q, hQ⟩ : ∃ Q : ℕ → AddSubgroup (⊥ : IntermediateField F (AlgebraicClosure F)),
      ∀ n y, y ∈ Q n ↔ -(n : ℤ) ≤ EllipticRootNumber.valL F ⊥ y := by
    refine ⟨fun n =>
      { carrier := {y | -(n : ℤ) ≤ EllipticRootNumber.valL F ⊥ y}
        zero_mem' := by
          show -(n : ℤ) ≤ EllipticRootNumber.valL F ⊥ 0
          rw [V0]; omega
        add_mem' := by
          intro y z hy hz
          show -(n : ℤ) ≤ EllipticRootNumber.valL F ⊥ (y + z)
          have hy' : -(n : ℤ) ≤ EllipticRootNumber.valL F ⊥ y := hy
          have hz' : -(n : ℤ) ≤ EllipticRootNumber.valL F ⊥ z := hz
          by_cases h1 : y = 0
          · rw [h1, zero_add]; exact hz'
          by_cases h2 : z = 0
          · rw [h2, add_zero]; exact hy'
          by_cases h3 : y + z = 0
          · rw [h3, V0]; omega
          exact le_trans (le_min hy' hz') (V3 y z h1 h2 h3)
        neg_mem' := by
          intro y hy
          show -(n : ℤ) ≤ EllipticRootNumber.valL F ⊥ (-y)
          rw [V4]; exact hy }, fun _ _ => Iff.rfl⟩
  have hH : ∀ y, y ∈ Q 0 ↔ 0 ≤ EllipticRootNumber.valL F ⊥ y := by
    intro y
    rw [hQ, Nat.cast_zero, neg_zero]
  have hHP : Q 0 ≤ Q a := by
    intro y hy
    rw [hQ]
    have := (hH y).mp hy
    omega
  
  obtain ⟨c, hc0, hcv⟩ : ∃ c : (⊥ : IntermediateField F (AlgebraicClosure F)),
      c ≠ 0 ∧ EllipticRootNumber.valL F ⊥ c = a := ⟨π ^ a, Vpow a⟩
  have htriv : ∀ s y : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ (a : ℤ) + EllipticRootNumber.valL F ⊥ s + EllipticRootNumber.valL F ⊥ y →
      ψ (c * s * y) = 1 := by
    intro s y h
    by_cases hs : s = 0
    · rw [hs, mul_zero, zero_mul, AddChar.map_zero_eq_one]
    by_cases hy : y = 0
    · rw [hy, mul_zero, AddChar.map_zero_eq_one]
    apply hψ.1
    rw [V2 _ _ (mul_ne_zero hc0 hs) hy, V2 _ _ hc0 hs, hcv]
    exact h
  have hβr : ∀ s ∈ Q a, ∀ y ∈ Q 0, ψ (c * s * y) = 1 := by
    intro s hs y hy
    apply htriv
    have h1 := (hQ a s).mp hs
    have h2 := (hH y).mp hy
    omega
  have hnd : ∀ s ∈ Q a, (∀ y ∈ Q a, ψ (c * s * y) = 1) → s ∈ Q 0 := by
    intro s hsP hall
    have hsv := (hQ a s).mp hsP
    rw [hH]
    by_contra hneg
    obtain ⟨x, hx1, hx2⟩ := hψ.2
    have hx0 : x ≠ 0 := by
      intro h
      rw [h, V0] at hx1
      omega
    have hs0 : s ≠ 0 := by
      intro h
      rw [h, V0] at hneg
      exact hneg le_rfl
    have hd : c * s ≠ 0 := mul_ne_zero hc0 hs0
    have hvy : EllipticRootNumber.valL F ⊥ ((c * s)⁻¹ * x) =
        -((a : ℤ) + EllipticRootNumber.valL F ⊥ s) + -1 := by
      rw [V2 _ _ (inv_ne_zero hd) hx0, Vinv _ hd, V2 _ _ hc0 hs0, hcv, hx1]
    apply hx2
    have hyP : (c * s)⁻¹ * x ∈ Q a := by
      rw [hQ, hvy]
      omega
    have := hall ((c * s)⁻¹ * x) hyP
    rwa [mul_inv_cancel_left₀ hd] at this
  have hψ'H : ∀ y ∈ Q 0, ψ' y = 1 := fun y hy => hψ'.1 y ((hH y).mp hy)
  
  have hS : ∃ S : Finset (⊥ : IntermediateField F (AlgebraicClosure F)),
      ∀ y ∈ Q a, ∃ s ∈ S, y - s ∈ Q 0 := by
    have hK := IsNonarchimedeanLocalField.isCompact_closedBall F
      ((IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm (WithZero.exp (a : ℤ)))
    have hUo : ∀ t : F, IsOpen ((fun z : F => z - t) ⁻¹'
        {w : F | ValuativeRel.valuation F w ≤ 1}) := fun t =>
      (IsValuativeTopology.isOpen_closedBall (R := F)
        (r := (1 : ValuativeRel.ValueGroupWithZero F)) one_ne_zero).preimage (continuous_sub_right t)
    have hcov : {x : F | ValuativeRel.valuation F x ≤
        (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm (WithZero.exp (a : ℤ))} ⊆
        ⋃ t : F, (fun z : F => z - t) ⁻¹' {w : F | ValuativeRel.valuation F w ≤ 1} := by
      intro z _
      refine Set.mem_iUnion.mpr ⟨z, ?_⟩
      show ValuativeRel.valuation F (z - z) ≤ 1
      rw [sub_self, map_zero]
      exact zero_le'
    obtain ⟨T, hT⟩ := hK.elim_finite_subcover _ hUo hcov
    refine ⟨T.image (IntermediateField.botEquiv F (AlgebraicClosure F)).symm, fun y hy => ?_⟩
    have hy' := (hQ a y).mp hy
    rw [hv] at hy'
    have hz : IntermediateField.botEquiv F (AlgebraicClosure F) y ∈
        {x : F | ValuativeRel.valuation F x ≤
          (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm (WithZero.exp (a : ℤ))} := by
      show ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) y) ≤ _
      by_cases hy0 : IntermediateField.botEquiv F (AlgebraicClosure F) y = 0
      · rw [hy0, map_zero]
        exact zero_le'
      rw [s1 _ hy0] at hy'
      have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
          (ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) y)) ≤
          WithZero.exp (a : ℤ) := by
        rw [← WithZero.exp_log (hne _ hy0)]
        exact WithZero.exp_le_exp.mpr (by omega)
      have h2 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
          (ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) y)) ≤
          IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
            ((IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
              (WithZero.exp (a : ℤ))) := by
        simpa using h1
      exact (map_le_map_iff (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F)).mp h2
    obtain ⟨t, ht, hzt⟩ := Set.mem_iUnion₂.mp (hT hz)
    refine ⟨(IntermediateField.botEquiv F (AlgebraicClosure F)).symm t,
      Finset.mem_image_of_mem _ ht, ?_⟩
    have hzt' : ValuativeRel.valuation F
        (IntermediateField.botEquiv F (AlgebraicClosure F) y - t) ≤ 1 := hzt
    rw [hH, hv, map_sub, AlgEquiv.apply_symm_apply]
    by_cases h0 : IntermediateField.botEquiv F (AlgebraicClosure F) y - t = 0
    · rw [h0, s0]
    rw [s1 _ h0]
    have h2 := (map_le_map_iff (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F)).mpr hzt'
    rw [map_one] at h2
    have h3 := (WithZero.log_le_log (hne _ h0) one_ne_zero).mpr h2
    rw [WithZero.log_one] at h3
    omega
  obtain ⟨S, hScov⟩ := hS
  
  have duality : ∀ (P H : AddSubgroup (⊥ : IntermediateField F (AlgebraicClosure F)))
      (S : Finset (⊥ : IntermediateField F (AlgebraicClosure F))),
      (∀ y ∈ P, ∃ s ∈ S, y - s ∈ H) → H ≤ P →
      (∀ s ∈ P, ∀ y ∈ H, ψ (c * s * y) = 1) →
      (∀ s ∈ P, (∀ y ∈ P, ψ (c * s * y) = 1) → s ∈ H) →
      (∀ y ∈ H, ψ' y = 1) →
      ∃ s ∈ P, ∀ y ∈ P, ψ' y = ψ (c * s * y) := by
    intro P H S hS hHP hβr hnd hχ
    
    haveI hGfin : Finite (↥P ⧸ H.addSubgroupOf P) := by
      refine Finite.of_surjective (fun s : {x // x ∈ S} =>
        if h : (s : (⊥ : IntermediateField F (AlgebraicClosure F))) ∈ P then
          (QuotientAddGroup.mk (⟨s, h⟩ : ↥P) : ↥P ⧸ H.addSubgroupOf P) else 0) ?_
      intro g
      obtain ⟨y, rfl⟩ := QuotientAddGroup.mk_surjective g
      obtain ⟨s, hsS, hys⟩ := hS y y.2
      have hsP : s ∈ P := by
        have e : s = (y : (⊥ : IntermediateField F (AlgebraicClosure F))) - (y - s) := by abel
        rw [e]
        exact P.sub_mem y.2 (hHP hys)
      refine ⟨⟨s, hsS⟩, ?_⟩
      show (if h : s ∈ P then
          (QuotientAddGroup.mk (⟨s, h⟩ : ↥P) : ↥P ⧸ H.addSubgroupOf P) else 0) = _
      rw [dif_pos hsP, QuotientAddGroup.eq, AddSubgroup.mem_addSubgroupOf]
      have e : ((-(⟨s, hsP⟩ : ↥P) + y : ↥P) : (⊥ : IntermediateField F (AlgebraicClosure F))) =
          (y : (⊥ : IntermediateField F (AlgebraicClosure F))) - s := by
        rw [AddSubgroup.coe_add, AddSubgroup.coe_neg]
        abel
      rw [e]
      exact hys
    
    have liftC : ∀ χ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F))
        (EllipticRootNumber.Ω F), (∀ y ∈ H, χ y = 1) →
        ∃ χ' : AddChar (↥P ⧸ H.addSubgroupOf P) (EllipticRootNumber.Ω F),
          ∀ y : ↥P, χ' (QuotientAddGroup.mk y) = χ y := by
      intro χ hχH
      refine ⟨AddChar.toAddMonoidHomEquiv.symm (QuotientAddGroup.lift (H.addSubgroupOf P)
        ((AddChar.toAddMonoidHomEquiv χ).comp P.subtype) ?_), fun y => rfl⟩
      intro h hh
      rw [AddMonoidHom.mem_ker]
      show Additive.ofMul (χ (h : (⊥ : IntermediateField F (AlgebraicClosure F)))) = 0
      rw [hχH _ (AddSubgroup.mem_addSubgroupOf.mp hh)]
      rfl
    
    obtain ⟨rep, hrep⟩ : ∃ rep : (↥P ⧸ H.addSubgroupOf P) → ↥P,
        ∀ g, (QuotientAddGroup.mk (rep g) : ↥P ⧸ H.addSubgroupOf P) = g :=
      ⟨fun g => (QuotientAddGroup.mk_surjective g).choose,
        fun g => (QuotientAddGroup.mk_surjective g).choose_spec⟩
    have hβc : ∀ s : (⊥ : IntermediateField F (AlgebraicClosure F)), s ∈ P →
        ∃ χ' : AddChar (↥P ⧸ H.addSubgroupOf P) (EllipticRootNumber.Ω F),
          ∀ y : ↥P, χ' (QuotientAddGroup.mk y) = ψ (c * s * y) := by
      intro s hs
      obtain ⟨χ', h⟩ := liftC (ψ.compAddMonoidHom (AddMonoidHom.mulLeft (c * s)))
        (fun y hy => hβr s hs y hy)
      exact ⟨χ', fun y => h y⟩
    choose Φ hΦ using fun g => hβc (rep g : (⊥ : IntermediateField F (AlgebraicClosure F)))
      (rep g).2
    have hinj : Function.Injective Φ := by
      intro g₁ g₂ h12
      have hall : ∀ y ∈ P, ψ (c * ((rep g₂ : (⊥ : IntermediateField F (AlgebraicClosure F))) -
          (rep g₁ : (⊥ : IntermediateField F (AlgebraicClosure F)))) * y) = 1 := by
        intro y hy
        have e1 := hΦ g₁ ⟨y, hy⟩
        have e2 := hΦ g₂ ⟨y, hy⟩
        rw [h12] at e1
        have e3 : ψ (c * (rep g₁ : (⊥ : IntermediateField F (AlgebraicClosure F))) * y) =
            ψ (c * (rep g₂ : (⊥ : IntermediateField F (AlgebraicClosure F))) * y) :=
          e1.symm.trans e2
        have hsplit : c * ((rep g₂ : (⊥ : IntermediateField F (AlgebraicClosure F))) -
            (rep g₁ : (⊥ : IntermediateField F (AlgebraicClosure F)))) * y =
            c * (rep g₂ : (⊥ : IntermediateField F (AlgebraicClosure F))) * y +
              -(c * (rep g₁ : (⊥ : IntermediateField F (AlgebraicClosure F))) * y) := by ring
        rw [hsplit, AddChar.map_add_eq_mul, ← e3, ← AddChar.map_add_eq_mul, add_neg_cancel,
          AddChar.map_zero_eq_one]
      have hmem := hnd _ (P.sub_mem (rep g₂).2 (rep g₁).2) hall
      calc g₁ = (QuotientAddGroup.mk (rep g₁) : ↥P ⧸ H.addSubgroupOf P) := (hrep g₁).symm
        _ = (QuotientAddGroup.mk (rep g₂) : ↥P ⧸ H.addSubgroupOf P) := by
          rw [QuotientAddGroup.eq, AddSubgroup.mem_addSubgroupOf]
          have e : ((-(rep g₁) + rep g₂ : ↥P) : (⊥ : IntermediateField F (AlgebraicClosure F))) =
              (rep g₂ : (⊥ : IntermediateField F (AlgebraicClosure F))) - rep g₁ := by
            rw [AddSubgroup.coe_add, AddSubgroup.coe_neg]
            abel
          rw [e]
          exact hmem
        _ = g₂ := hrep g₂
    
    have hli := (linearIndependent_monoidHom (Multiplicative (↥P ⧸ H.addSubgroupOf P))
      (EllipticRootNumber.Ω F)).comp AddChar.toMonoidHomEquiv AddChar.toMonoidHomEquiv.injective
    haveI hfinC : Finite (AddChar (↥P ⧸ H.addSubgroupOf P) (EllipticRootNumber.Ω F)) := hli.finite
    haveI := Fintype.ofFinite (AddChar (↥P ⧸ H.addSubgroupOf P) (EllipticRootNumber.Ω F))
    haveI := Fintype.ofFinite (Multiplicative (↥P ⧸ H.addSubgroupOf P))
    have hcard : Nat.card (AddChar (↥P ⧸ H.addSubgroupOf P) (EllipticRootNumber.Ω F)) ≤
        Nat.card (↥P ⧸ H.addSubgroupOf P) := by
      have h1 := hli.fintype_card_le_finrank
      rw [Fintype.card_eq_nat_card, Module.finrank_fintype_fun_eq_card,
        Fintype.card_eq_nat_card] at h1
      exact h1
    have hbij := hinj.bijective_of_nat_card_le hcard
    obtain ⟨χ', hχ'⟩ := liftC ψ' hχ
    obtain ⟨g, hg⟩ := hbij.2 χ'
    refine ⟨rep g, (rep g).2, fun y hy => ?_⟩
    have := hχ' ⟨y, hy⟩
    rw [← hg, hΦ g ⟨y, hy⟩] at this
    exact this.symm
  obtain ⟨s, hsP, hs⟩ := duality (Q a) (Q 0) S hScov hHP hβr hnd hψ'H
  
  obtain ⟨x', hx'1, hx'2⟩ := hψ'.2
  have hx'P : x' ∈ Q a := by
    rw [hQ, hx'1]
    omega
  have h1 : ψ (c * s * x') ≠ 1 := by
    rw [← hs x' hx'P]
    exact hx'2
  have hb0 : c * s ≠ 0 := by
    intro h
    apply h1
    rw [h, zero_mul, AddChar.map_zero_eq_one]
  have hs0 : s ≠ 0 := by
    intro h
    apply hb0
    rw [h, mul_zero]
  have hx'0 : x' ≠ 0 := by
    intro h
    rw [h, V0] at hx'1
    omega
  have hvb : EllipticRootNumber.valL F ⊥ (c * s) = a + EllipticRootNumber.valL F ⊥ s := by
    rw [V2 _ _ hc0 hs0, hcv]
  have hsv := (hQ a s).mp hsP
  have hvb0 : EllipticRootNumber.valL F ⊥ (c * s) = 0 := by
    by_contra hne0
    apply h1
    apply hψ.1
    rw [V2 _ _ hb0 hx'0, hvb, hx'1]
    omega
  refine ⟨Units.mk0 (c * s) hb0, by rw [Units.val_mk0]; exact hvb0, fun y hy => ?_⟩
  rw [Units.val_mk0]
  exact hs y ((hQ a y).mpr hy)

theorem tateEps_twist_unit (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (χ₀ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (EllipticRootNumber.Ω F)ˣ)
    (ψ ψ' : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F))
    (hψ0 : ∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1)
    (hc : EllipticRootNumber.condExpChar F ⊥ ψ = 0)
    (hc' : EllipticRootNumber.condExpChar F ⊥ ψ' = 0)
    (ha : 1 ≤ EllipticRootNumber.condExp F ⊥ χ₀)
    (b : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ)
    (hb : EllipticRootNumber.valL F ⊥ (b : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0)
    (hbψ : ∀ y : (⊥ : IntermediateField F (AlgebraicClosure F)),
      -(EllipticRootNumber.condExp F ⊥ χ₀ : ℤ) ≤ EllipticRootNumber.valL F ⊥ y →
        ψ' y = ψ (b * y)) :
    EllipticRootNumber.tateEps F ⊥ χ₀ ψ' =
      (χ₀ b : EllipticRootNumber.Ω F) * EllipticRootNumber.tateEps F ⊥ χ₀ ψ :=
by
  classical
  obtain ⟨hres, hmul, π, hπ⟩ := relVal_bot_spec F
  
  have V0 : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.relVal F ⊥ x := by
    intro x
    unfold EllipticRootNumber.valL
    rw [hres, Nat.cast_one, Int.ediv_one]
  have V1 : ∀ x y : (⊥ : IntermediateField F (AlgebraicClosure F)), x ≠ 0 → y ≠ 0 →
      EllipticRootNumber.valL F ⊥ (x * y) =
        EllipticRootNumber.valL F ⊥ x + EllipticRootNumber.valL F ⊥ y := by
    intro x y hx hy
    rw [V0, V0, V0]
    exact hmul x y hx hy
  have V2 : EllipticRootNumber.valL F ⊥ (1 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
    have h := V1 1 1 one_ne_zero one_ne_zero
    rw [one_mul] at h
    omega
  have V3 : ∀ x y : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      EllipticRootNumber.valL F ⊥ ((x * y : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) =
        EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))) +
          EllipticRootNumber.valL F ⊥ (y : (⊥ : IntermediateField F (AlgebraicClosure F))) := by
    intro x y
    rw [Units.val_mul]
    exact V1 _ _ x.ne_zero y.ne_zero
  have V4 : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      EllipticRootNumber.valL F ⊥ ((x⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) =
        -EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))) := by
    intro x
    have h := V3 x x⁻¹
    rw [mul_inv_cancel, Units.val_one, V2] at h
    omega
  
  have hπ0 : π ≠ 0 := by
    intro h0
    rw [h0] at hπ
    have h00 : EllipticRootNumber.relVal F ⊥ (0 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
      unfold EllipticRootNumber.relVal
      rw [Algebra.norm_zero]
      unfold EllipticRootNumber.addVal
      rw [dif_pos rfl]
    omega
  have hpow : ∀ k : ℕ, EllipticRootNumber.valL F ⊥ (π ^ k) = k := by
    intro k
    induction k with
    | zero => rw [pow_zero, V2]; rfl
    | succ k ih =>
      rw [pow_succ, V1 _ _ (pow_ne_zero _ hπ0) hπ0, ih, V0, hπ]
      push_cast
      ring
  have hwit : ∃ c₀ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      EllipticRootNumber.valL F ⊥ (c₀ : (⊥ : IntermediateField F (AlgebraicClosure F))) =
        EllipticRootNumber.condExp F ⊥ χ₀ := by
    refine ⟨(Units.mk0 π hπ0) ^ (EllipticRootNumber.condExp F ⊥ χ₀), ?_⟩
    rw [Units.val_pow_eq_pow_val, Units.val_mk0, hpow]
  
  have hT : EllipticRootNumber.tateElt F ⊥ χ₀ ψ' = EllipticRootNumber.tateElt F ⊥ χ₀ ψ := by
    unfold EllipticRootNumber.tateElt
    rw [hc, hc']
  have hvc : EllipticRootNumber.valL F ⊥
      ((EllipticRootNumber.tateElt F ⊥ χ₀ ψ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) =
        EllipticRootNumber.condExp F ⊥ χ₀ := by
    obtain ⟨c₀, hc₀⟩ := hwit
    have hspec := Classical.epsilon_spec
      (p := fun c : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ =>
        EllipticRootNumber.valL F ⊥ (c : (⊥ : IntermediateField F (AlgebraicClosure F))) =
          EllipticRootNumber.condExp F ⊥ χ₀ + EllipticRootNumber.condExpChar F ⊥ ψ)
      ⟨c₀, by rw [hc, add_zero]; exact hc₀⟩
    unfold EllipticRootNumber.tateElt
    refine hspec.trans ?_
    rw [hc, add_zero]
  
  have hK2 : ∀ ε ∈ EllipticRootNumber.unitGroup F ⊥ (EllipticRootNumber.condExp F ⊥ χ₀),
      χ₀ ε = 1 := by
    have hne : {n : ℕ | ∀ u ∈ EllipticRootNumber.unitGroup F ⊥ n, χ₀ u = 1}.Nonempty := by
      by_contra h
      rw [Set.not_nonempty_iff_eq_empty] at h
      have h0 : EllipticRootNumber.condExp F ⊥ χ₀ = 0 := by
        unfold EllipticRootNumber.condExp
        rw [h, Nat.sInf_empty]
      omega
    exact Nat.sInf_mem hne
  have ha0 : EllipticRootNumber.condExp F ⊥ χ₀ ≠ 0 := by omega
  
  haveI hN : (EllipticRootNumber.unitGroup F ⊥ (EllipticRootNumber.condExp F ⊥ χ₀)).Normal :=
    Subgroup.normal_of_comm _
  have key : ∀ (f f' : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ → EllipticRootNumber.Ω F),
      (∀ x, ∀ ε ∈ EllipticRootNumber.unitGroup F ⊥ (EllipticRootNumber.condExp F ⊥ χ₀),
        f (x * ε) = f x) →
      (∀ x, f' x = (χ₀ b : EllipticRootNumber.Ω F) * f (b * x)) →
      ∑ᶠ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸
          EllipticRootNumber.unitGroup F ⊥ (EllipticRootNumber.condExp F ⊥ χ₀),
          f' (EllipticRootNumber.cosetRep u) =
        (χ₀ b : EllipticRootNumber.Ω F) *
          ∑ᶠ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸
            EllipticRootNumber.unitGroup F ⊥ (EllipticRootNumber.condExp F ⊥ χ₀),
            f (EllipticRootNumber.cosetRep u) := by
    intro f f' hf htw
    have R1 : ∀ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸
        EllipticRootNumber.unitGroup F ⊥ (EllipticRootNumber.condExp F ⊥ χ₀),
        f (EllipticRootNumber.cosetRep
            (((b : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
              (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸
                EllipticRootNumber.unitGroup F ⊥ (EllipticRootNumber.condExp F ⊥ χ₀)) * u)) =
          f (b * EllipticRootNumber.cosetRep u) := by
      intro u
      have h1 : ((b * EllipticRootNumber.cosetRep u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸
              EllipticRootNumber.unitGroup F ⊥ (EllipticRootNumber.condExp F ⊥ χ₀)) =
          ((EllipticRootNumber.cosetRep
            (((b : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
              (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸
                EllipticRootNumber.unitGroup F ⊥ (EllipticRootNumber.condExp F ⊥ χ₀)) * u) :
              (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸
              EllipticRootNumber.unitGroup F ⊥ (EllipticRootNumber.condExp F ⊥ χ₀)) := by
        rw [QuotientGroup.mk_mul]
        unfold EllipticRootNumber.cosetRep
        rw [QuotientGroup.out_eq', QuotientGroup.out_eq']
      rw [QuotientGroup.eq] at h1
      have h2 := hf (b * EllipticRootNumber.cosetRep u) _ h1
      rw [mul_inv_cancel_left] at h2
      exact h2
    calc ∑ᶠ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸
          EllipticRootNumber.unitGroup F ⊥ (EllipticRootNumber.condExp F ⊥ χ₀),
          f' (EllipticRootNumber.cosetRep u)
        = ∑ᶠ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸
          EllipticRootNumber.unitGroup F ⊥ (EllipticRootNumber.condExp F ⊥ χ₀),
          (χ₀ b : EllipticRootNumber.Ω F) * f (EllipticRootNumber.cosetRep
            (((b : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
              (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸
                EllipticRootNumber.unitGroup F ⊥ (EllipticRootNumber.condExp F ⊥ χ₀)) * u)) :=
          finsum_congr (fun u => by rw [htw, R1])
      _ = (χ₀ b : EllipticRootNumber.Ω F) * ∑ᶠ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸
          EllipticRootNumber.unitGroup F ⊥ (EllipticRootNumber.condExp F ⊥ χ₀),
          f (EllipticRootNumber.cosetRep
            (((b : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
              (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸
                EllipticRootNumber.unitGroup F ⊥ (EllipticRootNumber.condExp F ⊥ χ₀)) * u)) :=
          (mul_finsum _ _).symm
      _ = (χ₀ b : EllipticRootNumber.Ω F) * ∑ᶠ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸
          EllipticRootNumber.unitGroup F ⊥ (EllipticRootNumber.condExp F ⊥ χ₀),
          f (EllipticRootNumber.cosetRep u) := by
        congr 1
        exact finsum_comp_equiv (Equiv.mulLeft
          ((b : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
              (⊥ : IntermediateField F (AlgebraicClosure F))ˣ ⧸
                EllipticRootNumber.unitGroup F ⊥ (EllipticRootNumber.condExp F ⊥ χ₀)))
          (f := fun u => f (EllipticRootNumber.cosetRep u))
  
  unfold EllipticRootNumber.tateEps
  rw [hc, hc', zpow_zero, one_mul, one_mul, if_neg ha0, if_neg ha0, hT]
  generalize hcdef : EllipticRootNumber.tateElt F ⊥ χ₀ ψ = c at hvc ⊢
  simp only [finsum_eq_if]
  refine key
    (fun x => if EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0
      then (χ₀ (c⁻¹ * x) : EllipticRootNumber.Ω F)⁻¹ *
        ψ ((c⁻¹ * x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
          (⊥ : IntermediateField F (AlgebraicClosure F)))
      else 0)
    (fun x => if EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0
      then (χ₀ (c⁻¹ * x) : EllipticRootNumber.Ω F)⁻¹ *
        ψ' ((c⁻¹ * x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
          (⊥ : IntermediateField F (AlgebraicClosure F)))
      else 0) ?_ ?_
  · 
    intro x ε hε
    obtain ⟨hε0, hε1⟩ := unitGroup_bot_spec F _ ε hε
    have hvxe : EllipticRootNumber.valL F ⊥
        ((x * ε : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
          (⊥ : IntermediateField F (AlgebraicClosure F))) =
        EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))) := by
      rw [V3, hε0, add_zero]
    beta_reduce
    rw [hvxe]
    split_ifs with hx
    · have e1 : c⁻¹ * (x * ε) = (c⁻¹ * x) * ε := (mul_assoc _ _ _).symm
      rw [e1, map_mul χ₀ (c⁻¹ * x) ε, hK2 ε hε, mul_one, Units.val_mul (c⁻¹ * x) ε]
      congr 1
      have hsplit : ((c⁻¹ * x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) *
            (ε : (⊥ : IntermediateField F (AlgebraicClosure F))) =
          ((c⁻¹ * x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) +
          ((c⁻¹ * x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) *
            ((ε : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1) := by ring
      rw [hsplit, AddChar.map_add_eq_mul]
      have h1 : ψ (((c⁻¹ * x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) *
            ((ε : (⊥ : IntermediateField F (AlgebraicClosure F))) - 1)) = 1 := by
        by_cases hε' : (ε : (⊥ : IntermediateField F (AlgebraicClosure F))) = 1
        · rw [hε', sub_self, mul_zero, AddChar.map_zero_eq_one]
        · rcases hε1 ha with h | h
          · exact absurd h hε'
          · apply hψ0
            rw [V1 _ _ (Units.ne_zero _) (sub_ne_zero.mpr hε'), V3, V4, hvc, hx]
            omega
      rw [h1, mul_one]
    · rfl
  · 
    intro x
    have hvbx : EllipticRootNumber.valL F ⊥
        ((b * x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
          (⊥ : IntermediateField F (AlgebraicClosure F))) =
        EllipticRootNumber.valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))) := by
      rw [V3, hb, zero_add]
    beta_reduce
    rw [hvbx]
    split_ifs with hx
    · have hvy : EllipticRootNumber.valL F ⊥
          ((c⁻¹ * x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) =
          -(EllipticRootNumber.condExp F ⊥ χ₀ : ℤ) := by
        rw [V3, V4, hvc, hx, add_zero]
      have h1 := hbψ ((c⁻¹ * x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) (le_of_eq hvy.symm)
      have h2 : c⁻¹ * (b * x) = b * (c⁻¹ * x) := mul_left_comm _ _ _
      have e1 : ((c⁻¹ * (b * x) : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) =
          (b : (⊥ : IntermediateField F (AlgebraicClosure F))) *
            ((c⁻¹ * x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
              (⊥ : IntermediateField F (AlgebraicClosure F))) := by
        rw [h2, Units.val_mul]
      have e2 : (χ₀ (c⁻¹ * (b * x)) : EllipticRootNumber.Ω F) =
          (χ₀ b : EllipticRootNumber.Ω F) * (χ₀ (c⁻¹ * x) : EllipticRootNumber.Ω F) := by
        rw [h2, map_mul, Units.val_mul]
      have hne : (χ₀ b : EllipticRootNumber.Ω F) ≠ 0 := Units.ne_zero _
      rw [e1, e2, ← h1, mul_inv, ← mul_assoc, ← mul_assoc, mul_inv_cancel₀ hne, one_mul]
    · rw [mul_zero]

theorem eps_spTwistRep_quadChar_eq (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] (E : WeierstrassCurve F)
    {rec rec' : EllipticRootNumber.LocalReciprocity F}
    (lc : EllipticRootNumber.LocalConstants F rec) (lc' : EllipticRootNumber.LocalConstants F rec')
    (ψ ψ' : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F))
    (hψ : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1)
    (hψ' : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ' x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ' x ≠ 1) :
    lc.eps ⊥ (EllipticRootNumber.spTwistRep F ⊥ (EllipticRootNumber.quadCharΩ F E ⊥)) ψ =
      lc'.eps ⊥ (EllipticRootNumber.spTwistRep F ⊥ (EllipticRootNumber.quadCharΩ F E ⊥)) ψ' :=
by
  classical
  open EllipticRootNumber in
  
  obtain ⟨hres, hmulv, -⟩ := relVal_bot_spec F
  have valL_eq : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      valL F ⊥ x = relVal F ⊥ x := by
    intro x
    unfold valL
    rw [hres, Nat.cast_one, Int.ediv_one]
  
  have adm : ∀ φ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (Ω F),
      ((∀ x, 0 ≤ valL F ⊥ x → φ x = 1) ∧ ∃ x, valL F ⊥ x = -1 ∧ φ x ≠ 1) →
      IsAdmissibleChar F ⊥ φ := by
    rintro φ ⟨h0, x, -, hx⟩
    exact ⟨fun h => hx (by rw [h, AddChar.one_apply]), 0, h0⟩
  have cond0 : ∀ φ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (Ω F),
      ((∀ x, 0 ≤ valL F ⊥ x → φ x = 1) ∧ ∃ x, valL F ⊥ x = -1 ∧ φ x ≠ 1) →
      condExpChar F ⊥ φ = 0 := by
    rintro φ ⟨h0, x₁, hx₁, hne⟩
    unfold condExpChar
    apply IsGreatest.csSup_eq
    refine ⟨fun x hx => h0 x (by simpa using hx), fun d hd => ?_⟩
    by_contra hlt
    push_neg at hlt
    exact hne (hd x₁ (by omega))
  
  have hdeg := weilDegreeHom_spec F
  have hinN : ∀ w : relWeil F ⊥, (w : AbsGal F) ∈ inertia F → relNorm F ⊥ w = 1 := by
    intro w hw
    have h0 : ActsAsFrobPow F (w : AbsGal F) 0 := by
      intro ζ hζ
      have h1 : (w : AbsGal F) ζ = ζ :=
        (IntermediateField.mem_fixingSubgroup_iff (unramifiedClosure F) _).mp hw ζ
          (IntermediateField.subset_adjoin F _ hζ)
      simp [h1]
    show zpowersHom (Ω F)ˣ (qUnit F)
      (weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F ⊥) w)) = 1
    rw [hdeg.2 (Subgroup.inclusion (relWeil_le_weilGroup F ⊥) w) 0 h0, ofAdd_zero, map_one]
  have hsint : IsIntegral F (sqrtNegC₆ F E) := Algebra.IsIntegral.isIntegral _
  haveI hfd : FiniteDimensional F (IntermediateField.adjoin F {sqrtNegC₆ F E}) :=
    IntermediateField.adjoin.finiteDimensional hsint
  have hU : ((IntermediateField.adjoin F {sqrtNegC₆ F E}).fixingSubgroup : Set (AbsGal F)) ∈
      nhds (1 : AbsGal F) :=
    (IntermediateField.fixingSubgroup_isOpen _).mem_nhds (Subgroup.one_mem _)
  have hχU : ∀ w : relWeil F ⊥,
      (w : AbsGal F) ∈ ((IntermediateField.adjoin F {sqrtNegC₆ F E}).fixingSubgroup : Set (AbsGal F)) →
      quadCharΩ F E ⊥ w = 1 := by
    intro w hw
    have h1 : (w : AbsGal F) (sqrtNegC₆ F E) = sqrtNegC₆ F E :=
      (IntermediateField.mem_fixingSubgroup_iff _ _).mp hw _
        (IntermediateField.mem_adjoin_simple_self F _)
    show Units.map (Int.castRingHom (Ω F)).toMonoidHom (quadSign F E (w : AbsGal F)) = 1
    unfold quadSign
    rw [if_pos h1, map_one]
  have W1 : IsWeilRep F ⊥ (charRep F ⊥ (quadCharΩ F E ⊥)) := by
    refine ⟨inferInstance, _, hU, fun w hwU _ => ?_⟩
    show ((quadCharΩ F E ⊥ w : (Ω F)ˣ) : Ω F) • LinearMap.id = 1
    rw [hχU w hwU, Units.val_one, one_smul]
    rfl
  have W2 : IsWeilRep F ⊥ (charRep F ⊥ (quadCharΩ F E ⊥ * relNorm F ⊥)) := by
    refine ⟨inferInstance, _, hU, fun w hwU hw => ?_⟩
    show (((quadCharΩ F E ⊥ * relNorm F ⊥) w : (Ω F)ˣ) : Ω F) • LinearMap.id = 1
    rw [MonoidHom.mul_apply, hχU w hwU, hinN w hw, mul_one, Units.val_one, one_smul]
    rfl
  have W3 : IsWeilRep F ⊥ (spTwistRep F ⊥ (quadCharΩ F E ⊥)) := by
    refine ⟨inferInstance, _, hU, fun w hwU hw => ?_⟩
    apply LinearMap.ext
    intro v
    funext i
    simp [spTwistRep, hχU w hwU, hinN w hw]
  
  have s4 : ∀ {R : LocalReciprocity F} (l : LocalConstants F R)
      (φ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (Ω F)),
      IsAdmissibleChar F ⊥ φ →
      l.eps ⊥ (spTwistRep F ⊥ (quadCharΩ F E ⊥)) φ =
        l.eps ⊥ (charRep F ⊥ (quadCharΩ F E ⊥ * relNorm F ⊥)) φ *
          l.eps ⊥ (charRep F ⊥ (quadCharΩ F E ⊥)) φ := by
    intro R l φ hφ
    let f : ULift.{u} (Ω F) →ₗ[Ω F] (Fin 2 → ULift.{u} (Ω F)) :=
      LinearMap.single (Ω F) (fun _ : Fin 2 => ULift.{u} (Ω F)) 1
    let g : (Fin 2 → ULift.{u} (Ω F)) →ₗ[Ω F] ULift.{u} (Ω F) := LinearMap.proj 0
    have hf : ∀ w, f ∘ₗ charRep F ⊥ (quadCharΩ F E ⊥ * relNorm F ⊥) w =
        spTwistRep F ⊥ (quadCharΩ F E ⊥) w ∘ₗ f := by
      intro w
      apply LinearMap.ext
      intro x
      funext i
      fin_cases i <;> simp [f, charRep, spTwistRep]
    have hg : ∀ w, g ∘ₗ spTwistRep F ⊥ (quadCharΩ F E ⊥) w =
        charRep F ⊥ (quadCharΩ F E ⊥) w ∘ₗ g := by
      intro w
      apply LinearMap.ext
      intro v
      simp [g, charRep, spTwistRep]
    have hfi : Function.Injective f := by
      intro x y hxy
      simpa [f] using congrFun hxy 1
    have hgs : Function.Surjective g := fun y => ⟨fun _ => y, rfl⟩
    have hrange : LinearMap.range f = LinearMap.ker g := by
      ext v
      simp only [LinearMap.mem_range, LinearMap.mem_ker]
      constructor
      · rintro ⟨x, rfl⟩
        simp [f, g]
      · intro hv
        have hv' : v 0 = 0 := hv
        refine ⟨v 1, ?_⟩
        funext i
        fin_cases i
        · simp [f, hv']
        · simp [f]
    exact l.eps_exact ⊥ φ hφ _ _ _ W2 W3 W1 f g hf hg hfi hgs hrange
  
  obtain ⟨hmulrec, hrecind⟩ := quadCharΩ_recMap_spec F E rec rec'
  have hν : ∀ (R : LocalReciprocity F) (x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ),
      relNorm F ⊥ (R.recMap ⊥ x) =
        qUnit F ^ (-relVal F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F)))) := by
    intro R x
    show zpowersHom (Ω F)ˣ (qUnit F)
      (weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F ⊥) (R.recMap ⊥ x))) = _
    rw [R.degree_rec ⊥ x, zpowersHom_apply, toAdd_ofAdd]
  obtain ⟨χ', hχ'⟩ : ∃ χ' : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (Ω F)ˣ,
      ∀ x, χ' x = quadCharΩ F E ⊥ (rec.recMap ⊥ x) :=
    ⟨MonoidHom.mk' (fun x => quadCharΩ F E ⊥ (rec.recMap ⊥ x)) hmulrec, fun _ => rfl⟩
  obtain ⟨χ'', hχ''⟩ : ∃ χ'' : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (Ω F)ˣ,
      ∀ x, χ'' x = quadCharΩ F E ⊥ (rec.recMap ⊥ x) *
        qUnit F ^ (-relVal F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F)))) := by
    refine ⟨MonoidHom.mk' (fun x => quadCharΩ F E ⊥ (rec.recMap ⊥ x) *
        qUnit F ^ (-relVal F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))))) ?_,
      fun _ => rfl⟩
    intro x y
    dsimp only
    rw [hmulrec, Units.val_mul, hmulv _ _ x.ne_zero y.ne_zero, neg_add, zpow_add]
    exact mul_mul_mul_comm _ _ _ _
  have hb1 : ∀ x, χ' x = quadCharΩ F E ⊥ (rec.recMap ⊥ x) := hχ'
  have hb2 : ∀ x, χ' x = quadCharΩ F E ⊥ (rec'.recMap ⊥ x) := fun x => (hχ' x).trans (hrecind x)
  have hc1 : ∀ x, χ'' x = (quadCharΩ F E ⊥ * relNorm F ⊥) (rec.recMap ⊥ x) := by
    intro x
    rw [hχ'', MonoidHom.mul_apply, hν rec x]
  have hc2 : ∀ x, χ'' x = (quadCharΩ F E ⊥ * relNorm F ⊥) (rec'.recMap ⊥ x) := by
    intro x
    rw [hχ'', MonoidHom.mul_apply, hν rec' x, hrecind x]
  have hsq : ∀ x, χ' x * χ' x = 1 := by
    intro x
    rw [hχ']
    show Units.map (Int.castRingHom (Ω F)).toMonoidHom (quadChar F E (rec.recMap ⊥ x : AbsGal F)) *
      Units.map (Int.castRingHom (Ω F)).toMonoidHom (quadChar F E (rec.recMap ⊥ x : AbsGal F)) = 1
    rw [← map_mul, Int.units_mul_self, map_one]
  have he : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      valL F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 → χ'' x = χ' x := by
    intro x hx
    rw [hχ'', hχ', ← valL_eq, hx, neg_zero, zpow_zero, mul_one]
  
  have hA := adm ψ hψ
  have hA' := adm ψ' hψ'
  have E1 : (lc.eps ⊥ (spTwistRep F ⊥ (quadCharΩ F E ⊥)) ψ : Ω F) =
      tateEps F ⊥ χ'' ψ * tateEps F ⊥ χ' ψ := by
    rw [s4 lc ψ hA, Units.val_mul, lc.eps_char ⊥ ψ hA _ W2 χ'' hc1,
      lc.eps_char ⊥ ψ hA _ W1 χ' hb1]
  have E2 : (lc'.eps ⊥ (spTwistRep F ⊥ (quadCharΩ F E ⊥)) ψ' : Ω F) =
      tateEps F ⊥ χ'' ψ' * tateEps F ⊥ χ' ψ' := by
    rw [s4 lc' ψ' hA', Units.val_mul, lc'.eps_char ⊥ ψ' hA' _ W2 χ'' hc2,
      lc'.eps_char ⊥ ψ' hA' _ W1 χ' hb2]
  apply Units.ext
  rw [E1, E2]
  
  have hcond : condExp F ⊥ χ'' = condExp F ⊥ χ' := by
    unfold condExp
    congr 1
    ext n
    simp only [Set.mem_setOf_eq]
    constructor
    · intro h u hu
      rw [← he u (unitGroup_bot_spec F n u hu).1]
      exact h u hu
    · intro h u hu
      rw [he u (unitGroup_bot_spec F n u hu).1]
      exact h u hu
  
  have hc := cond0 ψ hψ
  have hc' := cond0 ψ' hψ'
  by_cases ha : condExp F ⊥ χ' = 0
  · have ha'' : condExp F ⊥ χ'' = 0 := hcond.trans ha
    have unr : ∀ χ₀ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (Ω F)ˣ,
        condExp F ⊥ χ₀ = 0 → tateEps F ⊥ χ₀ ψ = tateEps F ⊥ χ₀ ψ' := by
      intro χ₀ h0
      have ht : tateElt F ⊥ χ₀ ψ = tateElt F ⊥ χ₀ ψ' := by
        unfold tateElt
        rw [hc, hc']
      unfold tateEps
      rw [hc, hc', if_pos h0, if_pos h0, ht]
    rw [unr χ'' ha'', unr χ' ha]
  · have ha1 : 1 ≤ condExp F ⊥ χ' := Nat.one_le_iff_ne_zero.mpr ha
    obtain ⟨b, hb, hbψ⟩ := exists_unit_addChar_twist F ψ ψ' hψ hψ' (condExp F ⊥ χ')
    have T1 := tateEps_twist_unit F χ' ψ ψ' hψ.1 hc hc' ha1 b hb hbψ
    have T2 := tateEps_twist_unit F χ'' ψ ψ' hψ.1 hc hc' (by rw [hcond]; exact ha1) b hb
      (by rw [hcond]; exact hbψ)
    have hsq' : ((χ' b : (Ω F)ˣ) : Ω F) * (χ' b : Ω F) = 1 := by
      rw [← Units.val_mul, hsq b, Units.val_one]
    rw [T1, T2, he b hb]
    linear_combination (-(tateEps F ⊥ χ'' ψ * tateEps F ⊥ χ' ψ)) * hsq'

theorem vBar_linearEquiv_variableChange (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (C : WeierstrassCurve.VariableChange F) (E : WeierstrassCurve F) :
    ∃ e : EllipticRootNumber.VBar F (C • E) ≃ₗ[EllipticRootNumber.Ω F] EllipticRootNumber.VBar F E,
      ∀ σ : EllipticRootNumber.AbsGal F,
        e.toLinearMap ∘ₗ EllipticRootNumber.ellAdicRep F (C • E) σ =
          EllipticRootNumber.ellAdicRep F E σ ∘ₗ e.toLinearMap :=
by
  classical
  
  have s1 : ∀ {K : Type u} [Field K] (W : WeierstrassCurve K)
      (C : WeierstrassCurve.VariableChange K) (x y : K), W.toAffine.Nonsingular x y →
      (C • W).toAffine.Nonsingular (↑C.u⁻¹ ^ 2 * (x - C.r))
        (↑C.u⁻¹ ^ 3 * (y - C.s * (x - C.r) - C.t)) := by
    intro K _ W C x y h
    have hv : ((C.u⁻¹ : Kˣ) : K) ≠ 0 := Units.ne_zero _
    rw [WeierstrassCurve.Affine.nonsingular_iff', WeierstrassCurve.Affine.equation_iff'] at h ⊢
    simp only [WeierstrassCurve.variableChange_a₁, WeierstrassCurve.variableChange_a₂,
      WeierstrassCurve.variableChange_a₃, WeierstrassCurve.variableChange_a₄,
      WeierstrassCurve.variableChange_a₆]
    obtain ⟨he, hp⟩ := h
    refine ⟨by linear_combination ((C.u⁻¹ : Kˣ) : K) ^ 6 * he, ?_⟩
    by_cases hq : 2 * y + W.a₁ * x + W.a₃ = 0
    · left
      have hp' : W.a₁ * y - (3 * x ^ 2 + 2 * W.a₂ * x + W.a₄) ≠ 0 :=
        hp.resolve_right (not_not.mpr hq)
      intro h0
      apply hp'
      have h4 : ((C.u⁻¹ : Kˣ) : K) ^ 4 * (W.a₁ * y - (3 * x ^ 2 + 2 * W.a₂ * x + W.a₄)) = 0 := by
        linear_combination h0 - ((C.u⁻¹ : Kˣ) : K) ^ 4 * C.s * hq
      exact (mul_eq_zero.mp h4).resolve_left (pow_ne_zero 4 hv)
    · right
      intro h0
      apply hq
      have h3 : ((C.u⁻¹ : Kˣ) : K) ^ 3 * (2 * y + W.a₁ * x + W.a₃) = 0 := by
        linear_combination h0
      exact (mul_eq_zero.mp h3).resolve_left (pow_ne_zero 3 hv)
  
  have alg3 : ∀ {K : Type u} [Field K] (a b a' b' v s : K), b ≠ 0 → v ≠ 0 →
      b' = v ^ 3 * b → a' = v ^ 4 * (a - s * b) → a' / b' = v * (a / b - s) := by
    intro K _ a b a' b' v s hb hv hb' ha'
    subst hb' ha'
    field_simp
  have alg2 : ∀ {K : Type u} [Field K] (a b a' b' v s : K), b ≠ 0 → v ≠ 0 →
      b' = v ^ 2 * b → a' = v ^ 3 * (a - s * b) → a' / b' = v * (a / b - s) := by
    intro K _ a b a' b' v s hb hv hb' ha'
    subst hb' ha'
    field_simp
  
  have s2 : ∀ {K : Type u} [Field K] [DecidableEq K] (W : WeierstrassCurve K)
      (C : WeierstrassCurve.VariableChange K) (x₁ x₂ y₁ y₂ : K),
      W.toAffine.Equation x₁ y₁ → W.toAffine.Equation x₂ y₂ →
      ¬(x₁ = x₂ ∧ y₁ = W.toAffine.negY x₂ y₂) →
      (C • W).toAffine.slope (↑C.u⁻¹ ^ 2 * (x₁ - C.r)) (↑C.u⁻¹ ^ 2 * (x₂ - C.r))
          (↑C.u⁻¹ ^ 3 * (y₁ - C.s * (x₁ - C.r) - C.t))
          (↑C.u⁻¹ ^ 3 * (y₂ - C.s * (x₂ - C.r) - C.t)) =
        ↑C.u⁻¹ * (W.toAffine.slope x₁ x₂ y₁ y₂ - C.s) := by
    intro K _ _ W C x₁ x₂ y₁ y₂ h₁ h₂ hxy
    have hv : ((C.u⁻¹ : Kˣ) : K) ≠ 0 := Units.ne_zero _
    by_cases hx : x₁ = x₂
    · subst hx
      have hy : y₁ ≠ W.toAffine.negY x₁ y₂ := fun e => hxy ⟨rfl, e⟩
      obtain rfl : y₁ = y₂ := WeierstrassCurve.Affine.Y_eq_of_Y_ne h₁ h₂ rfl hy
      have hD : y₁ - W.toAffine.negY x₁ y₁ ≠ 0 := sub_ne_zero.mpr hy
      have hy' : ((C.u⁻¹ : Kˣ) : K) ^ 3 * (y₁ - C.s * (x₁ - C.r) - C.t) ≠
          (C • W).toAffine.negY (((C.u⁻¹ : Kˣ) : K) ^ 2 * (x₁ - C.r))
            (((C.u⁻¹ : Kˣ) : K) ^ 3 * (y₁ - C.s * (x₁ - C.r) - C.t)) := by
        intro e
        apply hD
        have h3 : ((C.u⁻¹ : Kˣ) : K) ^ 3 * (y₁ - W.toAffine.negY x₁ y₁) = 0 := by
          simp only [WeierstrassCurve.Affine.negY, WeierstrassCurve.variableChange_a₁,
            WeierstrassCurve.variableChange_a₃] at e ⊢
          linear_combination e
        exact (mul_eq_zero.mp h3).resolve_left (pow_ne_zero 3 hv)
      rw [WeierstrassCurve.Affine.slope_of_Y_ne rfl hy, WeierstrassCurve.Affine.slope_of_Y_ne rfl hy']
      refine alg3 _ _ _ _ _ _ hD hv ?_ ?_
      · simp only [WeierstrassCurve.Affine.negY, WeierstrassCurve.variableChange_a₁,
          WeierstrassCurve.variableChange_a₃]
        ring
      · simp only [WeierstrassCurve.Affine.negY, WeierstrassCurve.variableChange_a₁,
          WeierstrassCurve.variableChange_a₂, WeierstrassCurve.variableChange_a₃,
          WeierstrassCurve.variableChange_a₄]
        ring
    · have hX : ((C.u⁻¹ : Kˣ) : K) ^ 2 * (x₁ - C.r) ≠ ((C.u⁻¹ : Kˣ) : K) ^ 2 * (x₂ - C.r) := by
        intro e
        apply hx
        have h2 : ((C.u⁻¹ : Kˣ) : K) ^ 2 * (x₁ - x₂) = 0 := by linear_combination e
        exact sub_eq_zero.mp ((mul_eq_zero.mp h2).resolve_left (pow_ne_zero 2 hv))
      rw [WeierstrassCurve.Affine.slope_of_X_ne hX, WeierstrassCurve.Affine.slope_of_X_ne hx]
      exact alg2 _ _ _ _ _ _ (sub_ne_zero.mpr hx) hv (by ring) (by ring)
  
  have gen : ∀ {K : Type u} [Field K] [DecidableEq K] (W W' : WeierstrassCurve K)
      (C : WeierstrassCurve.VariableChange K), W' = C • W →
      ∃ T : W.toAffine.Point →+ W'.toAffine.Point, Function.Injective T ∧
        Function.Surjective T ∧
        ∀ (x y : K) (h : W.toAffine.Nonsingular x y),
          ∃ h' : W'.toAffine.Nonsingular (↑C.u⁻¹ ^ 2 * (x - C.r))
              (↑C.u⁻¹ ^ 3 * (y - C.s * (x - C.r) - C.t)),
            T (WeierstrassCurve.Affine.Point.some h) = WeierstrassCurve.Affine.Point.some h' := by
    intro K _ _ W W' C hW
    subst hW
    have hv : ((C.u⁻¹ : Kˣ) : K) ≠ 0 := Units.ne_zero _
    obtain ⟨T, hT0, hTs⟩ : ∃ T : W.toAffine.Point → (C • W).toAffine.Point,
        T WeierstrassCurve.Affine.Point.zero = WeierstrassCurve.Affine.Point.zero ∧
        ∀ (x y : K) (h : W.toAffine.Nonsingular x y),
          T (WeierstrassCurve.Affine.Point.some h) =
            WeierstrassCurve.Affine.Point.some (s1 W C x y h) :=
      ⟨fun P => match P with
        | .zero => .zero
        | @WeierstrassCurve.Affine.Point.some _ _ _ x y h => .some (s1 W C x y h),
        rfl, fun _ _ _ => rfl⟩
    have hadd : ∀ P Q : W.toAffine.Point, T (P + Q) = T P + T Q := by
      intro P Q
      cases P with
      | zero =>
        show T (0 + Q) = T 0 + T Q
        rw [zero_add]
        show T Q = T WeierstrassCurve.Affine.Point.zero + T Q
        rw [hT0]
        exact (zero_add _).symm
      | @some x₁ y₁ h₁ =>
        cases Q with
        | zero =>
          show T (WeierstrassCurve.Affine.Point.some h₁ + 0) =
            T (WeierstrassCurve.Affine.Point.some h₁) + T 0
          rw [add_zero]
          show _ = _ + T WeierstrassCurve.Affine.Point.zero
          rw [hT0]
          exact (add_zero _).symm
        | @some x₂ y₂ h₂ =>
          by_cases hxy : x₁ = x₂ ∧ y₁ = W.toAffine.negY x₂ y₂
          · rw [WeierstrassCurve.Affine.Point.add_of_Y_eq hxy.1 hxy.2, hTs, hTs]
            obtain ⟨rfl, rfl⟩ := hxy
            rw [WeierstrassCurve.Affine.Point.add_of_Y_eq rfl (by
              simp only [WeierstrassCurve.Affine.negY, WeierstrassCurve.variableChange_a₁,
                WeierstrassCurve.variableChange_a₃]
              ring)]
            exact hT0
          · have hxy' : ¬(((C.u⁻¹ : Kˣ) : K) ^ 2 * (x₁ - C.r) =
                  ((C.u⁻¹ : Kˣ) : K) ^ 2 * (x₂ - C.r) ∧
                ((C.u⁻¹ : Kˣ) : K) ^ 3 * (y₁ - C.s * (x₁ - C.r) - C.t) =
                  (C • W).toAffine.negY (((C.u⁻¹ : Kˣ) : K) ^ 2 * (x₂ - C.r))
                    (((C.u⁻¹ : Kˣ) : K) ^ 3 * (y₂ - C.s * (x₂ - C.r) - C.t))) := by
              rintro ⟨e1, e2⟩
              have hx : x₁ = x₂ := by
                have h2 : ((C.u⁻¹ : Kˣ) : K) ^ 2 * (x₁ - x₂) = 0 := by linear_combination e1
                exact sub_eq_zero.mp ((mul_eq_zero.mp h2).resolve_left (pow_ne_zero 2 hv))
              subst hx
              refine hxy ⟨rfl, ?_⟩
              have h3 : ((C.u⁻¹ : Kˣ) : K) ^ 3 * (y₁ - W.toAffine.negY x₁ y₂) = 0 := by
                simp only [WeierstrassCurve.Affine.negY, WeierstrassCurve.variableChange_a₁,
                  WeierstrassCurve.variableChange_a₃] at e2 ⊢
                linear_combination e2
              exact sub_eq_zero.mp ((mul_eq_zero.mp h3).resolve_left (pow_ne_zero 3 hv))
            rw [WeierstrassCurve.Affine.Point.add_some hxy, hTs, hTs, hTs,
              WeierstrassCurve.Affine.Point.add_some hxy', WeierstrassCurve.Affine.Point.some.injEq,
              s2 W C x₁ x₂ y₁ y₂ h₁.1 h₂.1 hxy]
            constructor
            · simp only [WeierstrassCurve.Affine.addX, WeierstrassCurve.variableChange_a₁,
                WeierstrassCurve.variableChange_a₂]
              ring
            · simp only [WeierstrassCurve.Affine.addY, WeierstrassCurve.Affine.negAddY,
                WeierstrassCurve.Affine.addX, WeierstrassCurve.Affine.negY,
                WeierstrassCurve.variableChange_a₁, WeierstrassCurve.variableChange_a₂,
                WeierstrassCurve.variableChange_a₃]
              ring
    have hinj : Function.Injective T := by
      intro P Q hPQ
      cases P with
      | zero =>
        cases Q with
        | zero => rfl
        | @some x₂ y₂ h₂ =>
          rw [hT0, hTs] at hPQ
          cases hPQ
      | @some x₁ y₁ h₁ =>
        cases Q with
        | zero =>
          rw [hT0, hTs] at hPQ
          cases hPQ
        | @some x₂ y₂ h₂ =>
          rw [hTs, hTs, WeierstrassCurve.Affine.Point.some.injEq] at hPQ
          obtain ⟨e1, e2⟩ := hPQ
          have hx : x₁ = x₂ := by
            have h2 : ((C.u⁻¹ : Kˣ) : K) ^ 2 * (x₁ - x₂) = 0 := by linear_combination e1
            exact sub_eq_zero.mp ((mul_eq_zero.mp h2).resolve_left (pow_ne_zero 2 hv))
          subst hx
          have hy : y₁ = y₂ := by
            have h3 : ((C.u⁻¹ : Kˣ) : K) ^ 3 * (y₁ - y₂) = 0 := by linear_combination e2
            exact sub_eq_zero.mp ((mul_eq_zero.mp h3).resolve_left (pow_ne_zero 3 hv))
          subst hy
          rfl
    have hsurj : Function.Surjective T := by
      intro Q
      cases Q with
      | zero => exact ⟨_, hT0⟩
      | @some X Y h' =>
        have huv : ((C.u : Kˣ) : K) * ((C.u⁻¹ : Kˣ) : K) = 1 := by
          rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
        obtain ⟨x, y, rfl, rfl⟩ : ∃ x y : K, X = ((C.u⁻¹ : Kˣ) : K) ^ 2 * (x - C.r) ∧
            Y = ((C.u⁻¹ : Kˣ) : K) ^ 3 * (y - C.s * (x - C.r) - C.t) :=
          ⟨((C.u : Kˣ) : K) ^ 2 * X + C.r,
            ((C.u : Kˣ) : K) ^ 3 * Y + C.s * (((C.u : Kˣ) : K) ^ 2 * X) + C.t,
            by linear_combination (-(((C.u : Kˣ) : K) * ((C.u⁻¹ : Kˣ) : K)) - 1) * X * huv,
            by linear_combination (-(((C.u : Kˣ) : K) ^ 2 * ((C.u⁻¹ : Kˣ) : K) ^ 2) -
              ((C.u : Kˣ) : K) * ((C.u⁻¹ : Kˣ) : K) - 1) * Y * huv⟩
        have hxy : W.toAffine.Nonsingular x y := by
          have h'' := h'
          rw [WeierstrassCurve.Affine.nonsingular_iff', WeierstrassCurve.Affine.equation_iff'] at h'' ⊢
          simp only [WeierstrassCurve.variableChange_a₁, WeierstrassCurve.variableChange_a₂,
            WeierstrassCurve.variableChange_a₃, WeierstrassCurve.variableChange_a₄,
            WeierstrassCurve.variableChange_a₆] at h''
          obtain ⟨he, hp⟩ := h''
          refine ⟨?_, ?_⟩
          · have h6 : ((C.u⁻¹ : Kˣ) : K) ^ 6 * (y ^ 2 + W.a₁ * x * y + W.a₃ * y -
                (x ^ 3 + W.a₂ * x ^ 2 + W.a₄ * x + W.a₆)) = 0 := by
              linear_combination he
            exact (mul_eq_zero.mp h6).resolve_left (pow_ne_zero 6 hv)
          · by_cases hq : 2 * y + W.a₁ * x + W.a₃ = 0
            · left
              intro h0
              rcases hp with hp | hp
              · exact hp (by linear_combination ((C.u⁻¹ : Kˣ) : K) ^ 4 * h0 +
                  ((C.u⁻¹ : Kˣ) : K) ^ 4 * C.s * hq)
              · exact hp (by linear_combination ((C.u⁻¹ : Kˣ) : K) ^ 3 * hq)
            · right
              exact hq
        exact ⟨_, hTs x y hxy⟩
    exact ⟨AddMonoidHom.mk' T hadd, hinj, hsurj, fun x y h => ⟨s1 W C x y h, hTs x y h⟩⟩
  
  obtain ⟨C', hC'⟩ : ∃ C' : WeierstrassCurve.VariableChange (AlgebraicClosure F),
      C' = C.map (algebraMap F (AlgebraicClosure F)) := ⟨_, rfl⟩
  have hW : (C • E).baseChange (AlgebraicClosure F) = C' • E.baseChange (AlgebraicClosure F) := by
    rw [hC']
    exact (WeierstrassCurve.map_variableChange E (algebraMap F (AlgebraicClosure F)) C).symm
  obtain ⟨T, hTinj, hTsurj, hTs⟩ := gen (E.baseChange (AlgebraicClosure F))
    ((C • E).baseChange (AlgebraicClosure F)) C' hW
  have hu : ∀ σ : EllipticRootNumber.AbsGal F,
      σ ((C'.u⁻¹ : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) = ↑C'.u⁻¹ := by
    intro σ
    rw [hC']
    exact AlgEquiv.commutes σ ((C.u⁻¹ : Fˣ) : F)
  have hr : ∀ σ : EllipticRootNumber.AbsGal F, σ C'.r = C'.r := by
    intro σ; rw [hC']; exact AlgEquiv.commutes σ C.r
  have hs : ∀ σ : EllipticRootNumber.AbsGal F, σ C'.s = C'.s := by
    intro σ; rw [hC']; exact AlgEquiv.commutes σ C.s
  have ht : ∀ σ : EllipticRootNumber.AbsGal F, σ C'.t = C'.t := by
    intro σ; rw [hC']; exact AlgEquiv.commutes σ C.t
  have hT : ∀ (σ : EllipticRootNumber.AbsGal F) (P : EllipticRootNumber.Pts F E),
      T (EllipticRootNumber.galHom F E σ P) = EllipticRootNumber.galHom F (C • E) σ (T P) := by
    intro σ P
    cases P with
    | zero =>
      show T (EllipticRootNumber.galHom F E σ 0) = EllipticRootNumber.galHom F (C • E) σ (T 0)
      simp only [map_zero]
    | @some x y h =>
      obtain ⟨h', hh'⟩ := hTs x y h
      obtain ⟨hσ, hg1⟩ : ∃ hσ : (E.baseChange (AlgebraicClosure F)).toAffine.Nonsingular (σ x) (σ y),
          EllipticRootNumber.galHom F E σ (WeierstrassCurve.Affine.Point.some h) =
            WeierstrassCurve.Affine.Point.some hσ := ⟨_, rfl⟩
      obtain ⟨h'', hh''⟩ := hTs (σ x) (σ y) hσ
      obtain ⟨hσ', hg2⟩ : ∃ hσ' : ((C • E).baseChange (AlgebraicClosure F)).toAffine.Nonsingular
            (σ (↑C'.u⁻¹ ^ 2 * (x - C'.r))) (σ (↑C'.u⁻¹ ^ 3 * (y - C'.s * (x - C'.r) - C'.t))),
          EllipticRootNumber.galHom F (C • E) σ (WeierstrassCurve.Affine.Point.some h') =
            WeierstrassCurve.Affine.Point.some hσ' := ⟨_, rfl⟩
      rw [hg1, hh'', hh', hg2, WeierstrassCurve.Affine.Point.some.injEq]
      simp only [map_mul, map_pow, map_sub, hu, hr, hs, ht]
      exact ⟨trivial, trivial⟩
  
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : EllipticRootNumber.Pts F E ≃+ EllipticRootNumber.Pts F (C • E),
      ∀ P, Φ P = T P := ⟨AddEquiv.ofBijective T ⟨hTinj, hTsurj⟩, fun _ => rfl⟩
  have hΦs : ∀ (σ : EllipticRootNumber.AbsGal F) (P : EllipticRootNumber.Pts F (C • E)),
      Φ.symm (EllipticRootNumber.galHom F (C • E) σ P) =
        EllipticRootNumber.galHom F E σ (Φ.symm P) := by
    intro σ P
    apply Φ.injective
    rw [Φ.apply_symm_apply, hΦ, hT, ← hΦ, Φ.apply_symm_apply]
  
  have tmap : ∀ (E₁ E₂ : WeierstrassCurve F)
      (φ : EllipticRootNumber.Pts F E₁ →+ EllipticRootNumber.Pts F E₂),
      ∃ f : EllipticRootNumber.tateModule F E₁ →ₗ[ℤ_[EllipticRootNumber.ell F]]
          EllipticRootNumber.tateModule F E₂,
        ∀ (x : EllipticRootNumber.tateModule F E₁) (n : ℕ), ((f x).1 n).1 = φ (x.1 n).1 := by
    intro E₁ E₂ φ
    have hmem : ∀ (n : ℕ) (P : EllipticRootNumber.torsion F E₁ (EllipticRootNumber.ell F ^ (n + 1))),
        φ P.1 ∈ EllipticRootNumber.torsion F E₂ (EllipticRootNumber.ell F ^ (n + 1)) := by
      intro n P
      show (EllipticRootNumber.ell F ^ (n + 1)) • φ P.1 = 0
      rw [← map_nsmul, (EllipticRootNumber.mem_torsion F E₁).mp P.2, map_zero]
    let fn : ∀ n : ℕ, EllipticRootNumber.torsion F E₁ (EllipticRootNumber.ell F ^ (n + 1)) →ₗ[ℤ_[EllipticRootNumber.ell F]]
        EllipticRootNumber.torsion F E₂ (EllipticRootNumber.ell F ^ (n + 1)) := fun n =>
      { toFun := fun P => ⟨φ P.1, hmem n P⟩
        map_add' := fun P Q => Subtype.ext (map_add φ P.1 Q.1)
        map_smul' := fun a P => Subtype.ext (by
          show φ (a • P).1 = (a • (⟨φ P.1, hmem n P⟩ :
            EllipticRootNumber.torsion F E₂ (EllipticRootNumber.ell F ^ (n + 1)))).1
          rw [EllipticRootNumber.padic_smul_torsion, EllipticRootNumber.padic_smul_torsion,
            map_nsmul]) }
    let Pi : (∀ n : ℕ, EllipticRootNumber.torsion F E₁ (EllipticRootNumber.ell F ^ (n + 1))) →ₗ[ℤ_[EllipticRootNumber.ell F]]
        (∀ n : ℕ, EllipticRootNumber.torsion F E₂ (EllipticRootNumber.ell F ^ (n + 1))) :=
      LinearMap.pi fun n => (fn n).comp (LinearMap.proj n)
    have hPi : ∀ x : EllipticRootNumber.tateModule F E₁,
        Pi.comp (EllipticRootNumber.tateModule F E₁).subtype x ∈ EllipticRootNumber.tateModule F E₂ := by
      intro x n
      show EllipticRootNumber.ell F • φ (x.1 (n + 1)).1 = φ (x.1 n).1
      rw [← map_nsmul, x.2 n]
    exact ⟨LinearMap.codRestrict (EllipticRootNumber.tateModule F E₂)
      (Pi.comp (EllipticRootNumber.tateModule F E₁).subtype) hPi, fun x n => rfl⟩
  obtain ⟨f, hf⟩ := tmap E (C • E) Φ.toAddMonoidHom
  obtain ⟨g, hg⟩ := tmap (C • E) E Φ.symm.toAddMonoidHom
  simp only [AddEquiv.coe_toAddMonoidHom] at hf hg
  have hrep : ∀ (E' : WeierstrassCurve F) (σ : EllipticRootNumber.AbsGal F)
      (x : EllipticRootNumber.tateModule F E') (n : ℕ),
      ((EllipticRootNumber.tateRep F E' σ x).1 n).1 = EllipticRootNumber.galHom F E' σ (x.1 n).1 :=
    fun _ _ _ _ => rfl
  obtain ⟨eT, heTdef⟩ : ∃ eT : EllipticRootNumber.tateModule F (C • E) ≃ₗ[ℤ_[EllipticRootNumber.ell F]]
      EllipticRootNumber.tateModule F E, ∀ y, eT y = g y :=
    ⟨LinearEquiv.ofLinear g f
      (LinearMap.ext fun x => Subtype.ext (funext fun n => Subtype.ext (by
        show ((g (f x)).1 n).1 = (x.1 n).1
        rw [hg, hf, Φ.symm_apply_apply])))
      (LinearMap.ext fun y => Subtype.ext (funext fun n => Subtype.ext (by
        show ((f (g y)).1 n).1 = (y.1 n).1
        rw [hf, hg, Φ.apply_symm_apply]))), fun _ => rfl⟩
  have heT : ∀ σ : EllipticRootNumber.AbsGal F,
      (eT : EllipticRootNumber.tateModule F (C • E) →ₗ[ℤ_[EllipticRootNumber.ell F]]
        EllipticRootNumber.tateModule F E) ∘ₗ EllipticRootNumber.tateRep F (C • E) σ =
        EllipticRootNumber.tateRep F E σ ∘ₗ (eT : EllipticRootNumber.tateModule F (C • E)
          →ₗ[ℤ_[EllipticRootNumber.ell F]] EllipticRootNumber.tateModule F E) := by
    intro σ
    apply LinearMap.ext
    intro y
    apply Subtype.ext
    funext n
    apply Subtype.ext
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, heTdef, hrep, hg, hΦs]
  have hV : ∀ (E' : WeierstrassCurve F) (σ : EllipticRootNumber.AbsGal F),
      EllipticRootNumber.ellAdicRep F E' σ =
        LinearMap.baseChange (EllipticRootNumber.Ω F)
          (LinearMap.baseChange ℚ_[EllipticRootNumber.ell F] (EllipticRootNumber.tateRep F E' σ)) :=
    fun _ _ => rfl
  refine ⟨LinearEquiv.baseChange ℚ_[EllipticRootNumber.ell F] (EllipticRootNumber.Ω F) _ _
      (LinearEquiv.baseChange ℤ_[EllipticRootNumber.ell F] ℚ_[EllipticRootNumber.ell F] _ _ eT),
    fun σ => ?_⟩
  rw [hV, hV]
  simp only [LinearEquiv.coe_baseChange, ← LinearMap.baseChange_comp, heT]

theorem galHom_eq_self_of_mem_inertia_of_algClosure_goodModel (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    (E : WeierstrassCurve F)
    (w : Valuation (AlgebraicClosure F) NNReal)
    (hw₁ : ∀ a : F, w (algebraMap F (AlgebraicClosure F) a) ≤ 1 ↔ ValuativeRel.valuation F a ≤ 1)
    (hw₂ : ∀ (τ : EllipticRootNumber.AbsGal F) (α : AlgebraicClosure F), w (τ α) = w α)
    (C : WeierstrassCurve.VariableChange (AlgebraicClosure F))
    (h₁ : w (C • E.baseChange (AlgebraicClosure F)).a₁ ≤ 1)
    (h₂ : w (C • E.baseChange (AlgebraicClosure F)).a₂ ≤ 1)
    (h₃ : w (C • E.baseChange (AlgebraicClosure F)).a₃ ≤ 1)
    (h₄ : w (C • E.baseChange (AlgebraicClosure F)).a₄ ≤ 1)
    (h₆ : w (C • E.baseChange (AlgebraicClosure F)).a₆ ≤ 1)
    (hΔ : w (C • E.baseChange (AlgebraicClosure F)).Δ = 1)
    (σ : EllipticRootNumber.AbsGal F) (hσ : σ ∈ EllipticRootNumber.inertia F)
    (hu : σ (C.u : AlgebraicClosure F) = (C.u : AlgebraicClosure F)) (hr : σ C.r = C.r)
    (hs : σ C.s = C.s) (ht : σ C.t = C.t)
    (m : ℕ) (hm0 : 0 < m) (hm : Nat.Coprime m (EllipticRootNumber.p F))
    (P : EllipticRootNumber.Pts F E) (hP : P ∈ EllipticRootNumber.torsion F E m) :
    EllipticRootNumber.galHom F E σ P = P :=
by
  classical
  
  
  have s1 : ∀ {K : Type u} [Field K] (W : WeierstrassCurve K)
      (C : WeierstrassCurve.VariableChange K) (x y : K), W.toAffine.Nonsingular x y →
      (C • W).toAffine.Nonsingular (↑C.u⁻¹ ^ 2 * (x - C.r))
        (↑C.u⁻¹ ^ 3 * (y - C.s * (x - C.r) - C.t)) := by
    intro K _ W C x y h
    have hv : ((C.u⁻¹ : Kˣ) : K) ≠ 0 := Units.ne_zero _
    rw [WeierstrassCurve.Affine.nonsingular_iff', WeierstrassCurve.Affine.equation_iff'] at h ⊢
    simp only [WeierstrassCurve.variableChange_a₁, WeierstrassCurve.variableChange_a₂,
      WeierstrassCurve.variableChange_a₃, WeierstrassCurve.variableChange_a₄,
      WeierstrassCurve.variableChange_a₆]
    obtain ⟨he, hp⟩ := h
    refine ⟨by linear_combination ((C.u⁻¹ : Kˣ) : K) ^ 6 * he, ?_⟩
    by_cases hq : 2 * y + W.a₁ * x + W.a₃ = 0
    · left
      have hp' : W.a₁ * y - (3 * x ^ 2 + 2 * W.a₂ * x + W.a₄) ≠ 0 :=
        hp.resolve_right (not_not.mpr hq)
      intro h0
      apply hp'
      have h4 : ((C.u⁻¹ : Kˣ) : K) ^ 4 * (W.a₁ * y - (3 * x ^ 2 + 2 * W.a₂ * x + W.a₄)) = 0 := by
        linear_combination h0 - ((C.u⁻¹ : Kˣ) : K) ^ 4 * C.s * hq
      exact (mul_eq_zero.mp h4).resolve_left (pow_ne_zero 4 hv)
    · right
      intro h0
      apply hq
      have h3 : ((C.u⁻¹ : Kˣ) : K) ^ 3 * (2 * y + W.a₁ * x + W.a₃) = 0 := by
        linear_combination h0
      exact (mul_eq_zero.mp h3).resolve_left (pow_ne_zero 3 hv)
  have alg3 : ∀ {K : Type u} [Field K] (a b a' b' v s : K), b ≠ 0 → v ≠ 0 →
      b' = v ^ 3 * b → a' = v ^ 4 * (a - s * b) → a' / b' = v * (a / b - s) := by
    intro K _ a b a' b' v s hb hv hb' ha'
    subst hb' ha'
    field_simp
  have alg2 : ∀ {K : Type u} [Field K] (a b a' b' v s : K), b ≠ 0 → v ≠ 0 →
      b' = v ^ 2 * b → a' = v ^ 3 * (a - s * b) → a' / b' = v * (a / b - s) := by
    intro K _ a b a' b' v s hb hv hb' ha'
    subst hb' ha'
    field_simp
  have s2 : ∀ {K : Type u} [Field K] [DecidableEq K] (W : WeierstrassCurve K)
      (C : WeierstrassCurve.VariableChange K) (x₁ x₂ y₁ y₂ : K),
