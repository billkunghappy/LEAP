      exact hd0
    have hn : algebraMap (NumberField.RingOfIntegers K) K n =
        k * algebraMap (NumberField.RingOfIntegers K) K d := by
      rw [← hnd, div_mul_cancel₀ _ hιd]
    have hv0 : v.intValuation d ≠ 0 := v.intValuation_ne_zero d hd0
    have hv1 : v.intValuation d ≤ 1 := v.intValuation_le_one d
    have hlog : WithZero.log (v.intValuation d) ≤ 0 := by
      have h1 : WithZero.exp (WithZero.log (v.intValuation d)) ≤ WithZero.exp (0 : ℤ) := by
        rw [WithZero.exp_log hv0, WithZero.exp_zero]; exact hv1
      exact WithZero.exp_le_exp.mp h1
    obtain ⟨m, hm⟩ : ∃ m : ℕ, v.intValuation d = WithZero.exp (-(m : ℤ)) := by
      refine ⟨(-WithZero.log (v.intValuation d)).toNat, ?_⟩
      rw [Int.toNat_of_nonneg (by omega), neg_neg, WithZero.exp_log hv0]
    obtain ⟨J, hJ⟩ : v.asIdeal ^ m ∣ Ideal.span {d} :=
      (v.intValuation_le_pow_iff_dvd d m).mp hm.le
    have hJP : ¬ J ≤ v.asIdeal := by
      intro hle
      have h3 : v.asIdeal ^ (m + 1) ∣ Ideal.span {d} := by
        rw [hJ, pow_succ]
        exact mul_dvd_mul_left _ (Ideal.dvd_iff_le.mpr hle)
      have h2 := (v.intValuation_le_pow_iff_dvd d (m + 1)).mpr h3
      rw [hm, WithZero.exp_le_exp] at h2
      push_cast at h2
      omega
    obtain ⟨t, htJ, htP⟩ := Set.not_subset.mp hJP
    have hnv : v.intValuation n ≤ WithZero.exp (-(m : ℤ)) := by
      have e1 : v.intValuation n = IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K n) :=
        (v.valuation_of_algebraMap (K := K) n).symm
      have e2 : v.intValuation d = IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K d) :=
        (v.valuation_of_algebraMap (K := K) d).symm
      rw [e1, hn, map_mul, ← e2, hm]
      calc _ ≤ 1 * WithZero.exp (-(m : ℤ)) := mul_le_mul_right' hk _
        _ = _ := one_mul _
    have hnP : n ∈ v.asIdeal ^ m :=
      Ideal.dvd_span_singleton.mp ((v.intValuation_le_pow_iff_dvd n m).mp hnv)
    have hnt : n * t ∈ Ideal.span {d} := by
      rw [hJ]; exact Ideal.mul_mem_mul hnP htJ
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hnt
    have hbk : algebraMap (NumberField.RingOfIntegers K) K b =
        algebraMap (NumberField.RingOfIntegers K) K t * k := by
      have h4 := congrArg (algebraMap (NumberField.RingOfIntegers K) K) hb
      rw [map_mul, map_mul, hn] at h4
      apply mul_right_cancel₀ hιd
      rw [h4]; ring
    obtain ⟨s, i, hi, hsi⟩ := v.isMaximal.exists_inv htP
    refine ⟨s * b, ?_⟩
    have h1 : algebraMap (NumberField.RingOfIntegers K) K s *
        algebraMap (NumberField.RingOfIntegers K) K t +
        algebraMap (NumberField.RingOfIntegers K) K i = 1 := by
      rw [← map_mul, ← map_add, hsi, map_one]
    have key : algebraMap (NumberField.RingOfIntegers K) K t *
        (k - algebraMap (NumberField.RingOfIntegers K) K (s * b)) =
        algebraMap (NumberField.RingOfIntegers K) K b *
          algebraMap (NumberField.RingOfIntegers K) K i := by
      rw [map_mul]
      linear_combination (-1 : K) * hbk - algebraMap (NumberField.RingOfIntegers K) K b * h1
    have hvt : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K t) = 1 := by
      rw [v.valuation_of_algebraMap]; exact (v.intValuation_eq_one_iff).mpr htP
    have hvb : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K b) ≤ 1 := v.valuation_le_one (K := K) b
    have hvi : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K i) < 1 :=
      (v.valuation_lt_one_iff_mem (K := K) i).mpr hi
    have h5 := congrArg (IsDedekindDomain.HeightOneSpectrum.valuation K v) key
    rw [map_mul (IsDedekindDomain.HeightOneSpectrum.valuation K v), hvt, one_mul,
      map_mul (IsDedekindDomain.HeightOneSpectrum.valuation K v)] at h5
    rw [h5]
    calc _ ≤ 1 * IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K i) := mul_le_mul_right' hvb _
      _ = _ := one_mul _
      _ < 1 := hvi
  have hval : ∀ x : K, Valued.v (algebraMap K (v.adicCompletion K) x) =
      IsDedekindDomain.HeightOneSpectrum.valuation K v x := fun x =>
    IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v x
  
  have hker : ∀ x : v.adicCompletionIntegers K,
      IsLocalRing.residue _ x = 0 ↔ Valued.v (x : v.adicCompletion K) < 1 := fun x =>
    (IsLocalRing.residue_eq_zero_iff x).trans
      (Valuation.mem_maximalIdeal_iff (v.adicCompletion K) Valued.v (a := x))
  
  have hfin : Finite (IsLocalRing.ResidueField (v.adicCompletionIntegers K)) := by
    have hRK : ∀ r : NumberField.RingOfIntegers K,
        algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r =
          algebraMap K (v.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K r) :=
      fun r => IsScalarTower.algebraMap_apply _ _ _ r
    have hint : ∀ r : NumberField.RingOfIntegers K,
        algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r ∈
          v.adicCompletionIntegers K := by
      intro r
      rw [IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers, hRK, hval]
      exact v.valuation_le_one r
    let φ := (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K)).codRestrict
      (v.adicCompletionIntegers K) hint
    let ψ := (IsLocalRing.residue (v.adicCompletionIntegers K)).comp φ
    have hψ : ∀ r ∈ v.asIdeal, ψ r = 0 := by
      intro r hr
      show IsLocalRing.residue _ (φ r) = 0
      rw [hker]
      show Valued.v (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r) < 1
      rw [hRK, hval]
      exact (v.valuation_lt_one_iff_mem r).mpr hr
    let ψbar := Ideal.Quotient.lift v.asIdeal ψ hψ
    have hdense : DenseRange (algebraMap K (v.adicCompletion K)) := by
      have h := @UniformSpace.Completion.denseRange_coe
        (WithVal (IsDedekindDomain.HeightOneSpectrum.valuation K v)) _
      exact h
    have hsurj : Function.Surjective ψbar := by
      intro y
      obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective y
      have hU : {z : v.adicCompletion K | Valued.v (z - (x : v.adicCompletion K)) < 1} ∈
          nhds (x : v.adicCompletion K) :=
        Valued.mem_nhds.mpr ⟨1, fun z hz => by simpa using hz⟩
      obtain ⟨k, hk⟩ := hdense.mem_nhds hU
      simp only [Set.mem_setOf_eq] at hk
      have hk1 : IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 := by
        rw [← hval]
        have e : algebraMap K (v.adicCompletion K) k =
            (algebraMap K (v.adicCompletion K) k - x) + x := by ring
        rw [e]
        exact le_trans (Valuation.map_add _ _ _) (max_le hk.le x.2)
      obtain ⟨a, ha⟩ := approx k hk1
      refine ⟨Ideal.Quotient.mk v.asIdeal a, ?_⟩
      show ψ a = IsLocalRing.residue _ x
      show IsLocalRing.residue _ (φ a) = IsLocalRing.residue _ x
      rw [← sub_eq_zero, ← map_sub, hker]
      show Valued.v (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) a -
        (x : v.adicCompletion K)) < 1
      have e : algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) a -
          (x : v.adicCompletion K) =
          -(algebraMap K (v.adicCompletion K)
              (k - algebraMap (NumberField.RingOfIntegers K) K a)) +
            (algebraMap K (v.adicCompletion K) k - x) := by
        rw [hRK, map_sub]; ring
      rw [e]
      refine Valuation.map_add_lt _ ?_ hk
      rw [Valuation.map_neg, hval]
      exact ha
    haveI : Finite (NumberField.RingOfIntegers K ⧸ v.asIdeal) :=
      Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
    exact Finite.of_surjective ψbar hsurj
  haveI := hfin
  
  have h2le : Valued.v (2 : v.adicCompletion K) ≤ 1 := by
    have e : (2 : v.adicCompletion K) = 1 + 1 := by norm_num
    rw [e]
    exact le_trans (Valuation.map_add _ _ _) (by simp)
  have h2lt : Valued.v (2 : v.adicCompletion K) < 1 := lt_of_le_of_ne h2le h2
  have hρ1 : Valued.v ρ = 1 := by
    have h := hρ 0 (by simp)
    simpa using h
  
  have h2R : (2 : IsLocalRing.ResidueField (v.adicCompletionIntegers K)) = 0 := by
    have h : IsLocalRing.residue (v.adicCompletionIntegers K) 2 = 0 := by
      rw [hker]
      have e : ((2 : v.adicCompletionIntegers K) : v.adicCompletion K) = 2 := rfl
      rw [e]
      exact h2lt
    rwa [map_ofNat] at h
  
  let wp : IsLocalRing.ResidueField (v.adicCompletionIntegers K) →+
      IsLocalRing.ResidueField (v.adicCompletionIntegers K) :=
    { toFun := fun t => t ^ 2 + t
      map_zero' := by simp
      map_add' := by
        intro s t
        linear_combination (s * t) * h2R }
  have hwp : ∀ t, wp t = t ^ 2 + t := fun t => rfl
  have hker2 : Nat.card wp.ker = 2 := by
    rw [Nat.card_eq_two_iff]
    have h0 : (0 : IsLocalRing.ResidueField (v.adicCompletionIntegers K)) ∈ wp.ker :=
      AddMonoidHom.mem_ker.mpr (by rw [hwp]; ring)
    have h1 : (1 : IsLocalRing.ResidueField (v.adicCompletionIntegers K)) ∈ wp.ker :=
      AddMonoidHom.mem_ker.mpr (by rw [hwp]; linear_combination h2R)
    refine ⟨⟨0, h0⟩, ⟨1, h1⟩, ?_, ?_⟩
    · intro h
      exact zero_ne_one (congrArg Subtype.val h)
    · apply Set.eq_univ_of_forall
      rintro ⟨x, hx⟩
      have hx' : x * (x + 1) = 0 := by
        have := AddMonoidHom.mem_ker.mp hx
        rw [hwp] at this
        linear_combination this
      rcases mul_eq_zero.mp hx' with hx0 | hx1
      · left
        exact Subtype.ext hx0
      · right
        rw [Set.mem_singleton_iff]
        apply Subtype.ext
        show x = 1
        linear_combination hx1 - h2R
  have hidx : wp.range.index = 2 := by
    have hk : Nat.card wp.ker * wp.ker.index =
        Nat.card (IsLocalRing.ResidueField (v.adicCompletionIntegers K)) :=
      wp.ker.card_mul_index
    have hr : Nat.card wp.range * wp.range.index =
        Nat.card (IsLocalRing.ResidueField (v.adicCompletionIntegers K)) :=
      wp.range.card_mul_index
    rw [AddSubgroup.index_ker, hker2] at hk
    have hpos : 0 < Nat.card wp.range := Nat.card_pos
    have h' : Nat.card wp.range * wp.range.index = Nat.card wp.range * 2 := by
      rw [hr, ← hk, mul_comm]
    exact Nat.eq_of_mul_eq_mul_left hpos h'
  
  let ρ' : v.adicCompletionIntegers K :=
    ⟨ρ, (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mpr (le_of_eq hρ1)⟩
  let β' : v.adicCompletionIntegers K :=
    ⟨β, (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mpr hβ⟩
  have hρnot : IsLocalRing.residue _ ρ' ∉ wp.range := by
    rintro ⟨t, ht⟩
    rw [hwp] at ht
    obtain ⟨y', rfl⟩ := IsLocalRing.residue_surjective t
    have h0 : IsLocalRing.residue (v.adicCompletionIntegers K) (y' ^ 2 + y' - ρ') = 0 := by
      rw [map_sub, map_add, map_pow, ht, sub_self]
    have hlt := (hker _).mp h0
    have e : (((y' ^ 2 + y' - ρ' : v.adicCompletionIntegers K)) : v.adicCompletion K) =
        (y' : v.adicCompletion K) ^ 2 + (y' : v.adicCompletion K) - ρ := rfl
    rw [e, hρ (y' : v.adicCompletion K) y'.2] at hlt
    exact lt_irrefl _ hlt
  have hdich := AddSubgroup.add_mem_iff_of_index_two hidx
    (a := IsLocalRing.residue _ β' - IsLocalRing.residue _ ρ') (b := IsLocalRing.residue _ ρ')
  rw [sub_add_cancel] at hdich
  by_cases hb : IsLocalRing.residue _ β' ∈ wp.range
  · obtain ⟨t, ht⟩ := hb
    rw [hwp] at ht
    obtain ⟨τ', rfl⟩ := IsLocalRing.residue_surjective t
    refine ⟨(τ' : v.adicCompletion K), τ'.2, Or.inl ?_⟩
    have h0 : IsLocalRing.residue (v.adicCompletionIntegers K) (τ' ^ 2 + τ' - β') = 0 := by
      rw [map_sub, map_add, map_pow, ht, sub_self]
    have hlt := (hker _).mp h0
    have e : (((τ' ^ 2 + τ' - β' : v.adicCompletionIntegers K)) : v.adicCompletion K) =
        (τ' : v.adicCompletion K) ^ 2 + (τ' : v.adicCompletion K) - β := rfl
    rw [e] at hlt
    exact hlt
  · have hm : IsLocalRing.residue _ β' - IsLocalRing.residue _ ρ' ∈ wp.range := by
      by_contra hc
      exact hb (hdich.mpr (iff_of_false hc hρnot))
    obtain ⟨t, ht⟩ := hm
    rw [hwp] at ht
    obtain ⟨τ', rfl⟩ := IsLocalRing.residue_surjective t
    refine ⟨(τ' : v.adicCompletion K), τ'.2, Or.inr ?_⟩
    have h0 : IsLocalRing.residue (v.adicCompletionIntegers K) (τ' ^ 2 + τ' - β' + ρ') = 0 := by
      rw [map_add, map_sub, map_add, map_pow, ht]
      ring
    have hlt := (hker _).mp h0
    have e : (((τ' ^ 2 + τ' - β' + ρ' : v.adicCompletionIntegers K)) : v.adicCompletion K) =
        (τ' : v.adicCompletion K) ^ 2 + (τ' : v.adicCompletion K) - β + ρ := rfl
    rw [e] at hlt
    exact hlt

theorem exists_odd_valuation_sub_artinSchreier_smul_sq {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : Valued.v (2 : v.adicCompletion K) ≠ 1)
    (ρ : v.adicCompletion K)
    (hρ : ∀ y : v.adicCompletion K, Valued.v y ≤ 1 → Valued.v (y ^ 2 + y - ρ) = 1)
    (ϖ : v.adicCompletion K)
    (hϖ : Valued.v ϖ = ((Multiplicative.ofAdd (-1 : ℤ) : Multiplicative ℤ) :
        WithZero (Multiplicative ℤ)))
    (c : v.adicCompletion K) (hc : Valued.v c = 1)
    (hnsq : ∀ s : v.adicCompletion K, s ^ 2 ≠ c)
    (hna : ∀ s : v.adicCompletion K, (1 + 4 * ρ) * s ^ 2 ≠ c) :
    ∃ (x : v.adicCompletion K) (k : ℤ) (ω : v.adicCompletion K),
      Valued.v ω = 1 ∧ c - (1 + 4 * ρ) * x ^ 2 = ϖ ^ (2 * k + 1) * ω :=
by
  classical
  
  have hK2 : (2 : K) ≠ 0 := by norm_num
  have h2ne : (2 : v.adicCompletion K) ≠ 0 := by
    intro hcon
    apply hK2
    apply (algebraMap K (v.adicCompletion K)).injective
    rw [map_ofNat, map_zero]
    exact hcon
  have h2le : Valued.v (2 : v.adicCompletion K) ≤ 1 := by
    have e : (2 : v.adicCompletion K) = 1 + 1 := by norm_num
    rw [e]
    calc Valued.v ((1 : v.adicCompletion K) + 1)
        ≤ max (Valued.v (1 : v.adicCompletion K)) (Valued.v (1 : v.adicCompletion K)) :=
          Valuation.map_add _ _ _
      _ = 1 := by simp
  have h2lt : Valued.v (2 : v.adicCompletion K) < 1 := lt_of_le_of_ne h2le h2
  have h4eq2 : (4 : v.adicCompletion K) = 2 * 2 := by norm_num
  have hv4 : Valued.v (4 : v.adicCompletion K)
      = Valued.v (2 : v.adicCompletion K) * Valued.v (2 : v.adicCompletion K) := by
    rw [h4eq2, map_mul]
  have h4ne : (4 : v.adicCompletion K) ≠ 0 := by
    rw [h4eq2]; exact mul_ne_zero h2ne h2ne
  have hv4ne : Valued.v (4 : v.adicCompletion K) ≠ 0 :=
    (Valuation.ne_zero_iff Valued.v).mpr h4ne
  have h4pos : (0 : WithZero (Multiplicative ℤ)) < Valued.v (4 : v.adicCompletion K) :=
    zero_lt_iff.mpr hv4ne
  have hv4lt : Valued.v (4 : v.adicCompletion K) < 1 := by
    rw [hv4]
    calc Valued.v (2 : v.adicCompletion K) * Valued.v (2 : v.adicCompletion K)
        ≤ Valued.v (2 : v.adicCompletion K) * 1 := mul_le_mul_left' h2le _
      _ = Valued.v (2 : v.adicCompletion K) := mul_one _
      _ < 1 := h2lt
  have hv4le : Valued.v (4 : v.adicCompletion K) ≤ 1 := le_of_lt hv4lt
  have hρ1 : Valued.v ρ = 1 := by
    have h := hρ 0 (by rw [map_zero]; exact zero_le')
    have e : (0 : v.adicCompletion K) ^ 2 + 0 - ρ = -ρ := by ring
    rw [e, Valuation.map_neg] at h
    exact h
  have ha1 : Valued.v (1 + 4 * ρ : v.adicCompletion K) = 1 := by
    have hmul : Valued.v (4 * ρ : v.adicCompletion K)
        = Valued.v (4 : v.adicCompletion K) := by
      rw [map_mul, hρ1, mul_one]
    have hne : Valued.v (1 : v.adicCompletion K)
        ≠ Valued.v (4 * ρ : v.adicCompletion K) := by
      rw [map_one, hmul]
      exact (ne_of_lt hv4lt).symm
    rw [Valuation.map_add_of_distinct_val _ hne, map_one, hmul]
    exact max_eq_left hv4le
  have ha0 : (1 + 4 * ρ : v.adicCompletion K) ≠ 0 := by
    intro hcon
    rw [hcon, map_zero] at ha1
    exact zero_ne_one ha1
  have hainv : (1 + 4 * ρ : v.adicCompletion K)⁻¹ * (1 + 4 * ρ) = 1 :=
    inv_mul_cancel₀ ha0
  have hainv' : (1 + 4 * ρ : v.adicCompletion K) * (1 + 4 * ρ)⁻¹ = 1 :=
    mul_inv_cancel₀ ha0
  have hϖ' : Valued.v ϖ = WithZero.exp (-1 : ℤ) := hϖ
  have hϖ0 : ϖ ≠ 0 := by
    intro hcon
    rw [hcon, map_zero] at hϖ'
    exact WithZero.exp_ne_zero hϖ'.symm
  have hϖpow : ∀ n : ℕ, Valued.v (ϖ ^ n) = WithZero.exp (-(n : ℤ)) := by
    intro n
    induction n with
    | zero => simp
    | succ m ih =>
        rw [pow_succ, map_mul, ih, hϖ', ← WithZero.exp_add]
        have e : (-(m : ℤ)) + (-1 : ℤ) = -((m + 1 : ℕ) : ℤ) := by push_cast; ring
        rw [e]
  
  have hone : (1 : WithZero (Multiplicative ℤ)) = WithZero.exp (0 : ℤ) := WithZero.exp_zero.symm
  have hdisc : ∀ (g : WithZero (Multiplicative ℤ)) (m : ℤ),
      g < WithZero.exp m → g ≤ WithZero.exp (m - 1) := by
    intro g m hg
    rcases eq_or_ne g 0 with rfl | hg0
    · exact zero_le'
    · obtain ⟨t, rfl⟩ : ∃ t : ℤ, g = WithZero.exp t :=
        ⟨WithZero.log g, (WithZero.exp_log hg0).symm⟩
      rw [WithZero.exp_lt_exp] at hg
      rw [WithZero.exp_le_exp]
      omega
  have hexact : ∀ (g : WithZero (Multiplicative ℤ)) (m : ℤ),
      g ≤ WithZero.exp m → ¬ (g ≤ WithZero.exp (m - 1)) → g = WithZero.exp m := by
    intro g m hle hnot
    have hlt : WithZero.exp (m - 1) < g := not_le.mp hnot
    have hg0 : g ≠ 0 := by
      intro h
      rw [h] at hlt
      exact absurd hlt (not_lt.mpr zero_le')
    obtain ⟨t, rfl⟩ : ∃ t : ℤ, g = WithZero.exp t :=
      ⟨WithZero.log g, (WithZero.exp_log hg0).symm⟩
    rw [WithZero.exp_le_exp] at hle
    rw [WithZero.exp_lt_exp] at hlt
    have ht : t = m := by omega
    rw [ht]
  have htors : ∀ γ : WithZero (Multiplicative ℤ), γ ^ 2 = 1 → γ = 1 := by
    intro γ hγ
    have h0 : γ ≠ 0 := by
      intro hh
      rw [hh] at hγ
      simp at hγ
    have hk := WithZero.exp_log h0
    rw [← hk] at hγ ⊢
    rw [← WithZero.exp_nsmul, hone] at hγ
    have hz := WithZero.exp_inj.mp hγ
    simp only [nsmul_eq_mul, Nat.cast_ofNat] at hz
    rw [show WithZero.log γ = 0 by omega, WithZero.exp_zero]
  have mulstrict : ∀ g h : WithZero (Multiplicative ℤ), g ≠ 0 → h < 1 → g * h < g := by
    intro g h hg hh
    have hle : g * h ≤ g := by
      calc g * h ≤ g * 1 := mul_le_mul_left' hh.le g
        _ = g := mul_one g
    refine lt_of_le_of_ne hle ?_
    intro heq
    have h1 : g * h = g * 1 := by rw [heq, mul_one]
    exact absurd (mul_left_cancel₀ hg h1) (ne_of_lt hh)
  
  have SQ : ∀ b y : v.adicCompletion K, Valued.v y = 1 →
      Valued.v (b - y ^ 2) < Valued.v (4 : v.adicCompletion K) →
      ∃ z : v.adicCompletion K, z ^ 2 = b := by
    intro b y hy hb
    have hy0 : y ≠ 0 := by
      intro h
      rw [h, map_zero] at hy
      exact zero_ne_one hy
    have hden : (4 : v.adicCompletion K) * y ^ 2 ≠ 0 := mul_ne_zero h4ne (pow_ne_zero 2 hy0)
    have hv4y : Valued.v ((4 : v.adicCompletion K) * y ^ 2)
        = Valued.v (4 : v.adicCompletion K) := by
      rw [map_mul, map_pow, hy, one_pow, mul_one]
    obtain ⟨ζ, hζdef⟩ :
        ∃ z : v.adicCompletion K, z = (b - y ^ 2) / ((4 : v.adicCompletion K) * y ^ 2) :=
      ⟨_, rfl⟩
    have hζ : Valued.v ζ < 1 := by
      rw [hζdef, map_div₀, hv4y]
      exact (div_lt_one₀ h4pos).mpr hb
    obtain ⟨W, hW⟩ := adicCompletion_exists_sq_add_self_eq_of_valued_lt_one v ζ hζ
    have key : (4 : v.adicCompletion K) * y ^ 2 * (W ^ 2 + W) = b - y ^ 2 := by
      rw [hW, hζdef]
      field_simp
    exact ⟨y * (1 + 2 * W), by linear_combination key⟩
  
  have hkill : ∀ x : v.adicCompletion K, Valued.v x = 1 →
      Valued.v (c - (1 + 4 * ρ) * x ^ 2) < Valued.v (4 : v.adicCompletion K) → False := by
    intro x hx hlt
    have e : c * (1 + 4 * ρ)⁻¹ - x ^ 2
        = (1 + 4 * ρ)⁻¹ * (c - (1 + 4 * ρ) * x ^ 2) := by
      linear_combination (x ^ 2) * hainv
    have hstep : Valued.v (c * (1 + 4 * ρ)⁻¹ - x ^ 2)
        = Valued.v (c - (1 + 4 * ρ) * x ^ 2) := by
      rw [e, map_mul, map_inv₀, ha1, inv_one, one_mul]
    obtain ⟨y, hy⟩ := SQ (c * (1 + 4 * ρ)⁻¹) x hx (by rw [hstep]; exact hlt)
    refine hna y ?_
    rw [hy]
    linear_combination c * hainv'
  have hkillb : ∀ x : v.adicCompletion K, Valued.v x = 1 →
      Valued.v (c - x ^ 2) < Valued.v (4 : v.adicCompletion K) → False := by
    intro x hx hlt
    obtain ⟨y, hy⟩ := SQ c x hx hlt
    exact hnsq y hy
  
  have improve : ∀ (x : v.adicCompletion K) (n : ℕ), Valued.v x = 1 →
      Valued.v (2 : v.adicCompletion K) ≤ WithZero.exp (-(n : ℤ) - 1) →
      Valued.v (c - (1 + 4 * ρ) * x ^ 2) = WithZero.exp (-(2 * (n : ℤ))) →
      ∃ x' : v.adicCompletion K, Valued.v x' = 1 ∧
        Valued.v (c - (1 + 4 * ρ) * x' ^ 2) ≤ WithZero.exp (-(2 * (n : ℤ)) - 1) := by
    intro x n hx h2n hval
    have hP : Valued.v (ϖ ^ n) = WithZero.exp (-(n : ℤ)) := hϖpow n
    have hP0 : (ϖ ^ n : v.adicCompletion K) ≠ 0 := pow_ne_zero _ hϖ0
    have hP2 : Valued.v ((ϖ ^ n) ^ 2) = WithZero.exp (-(2 * (n : ℤ))) := by
      rw [map_pow, hP, ← WithZero.exp_nsmul]
      congr 1
      simp only [nsmul_eq_mul, Nat.cast_ofNat]
      ring
    have hD0 : (1 + 4 * ρ) * (ϖ ^ n) ^ 2 ≠ 0 := mul_ne_zero ha0 (pow_ne_zero 2 hP0)
    have hDv : Valued.v ((1 + 4 * ρ) * (ϖ ^ n) ^ 2) = WithZero.exp (-(2 * (n : ℤ))) := by
      rw [map_mul, ha1, one_mul, hP2]
    obtain ⟨u, hudef⟩ : ∃ u : v.adicCompletion K,
        u = (c - (1 + 4 * ρ) * x ^ 2) / ((1 + 4 * ρ) * (ϖ ^ n) ^ 2) := ⟨_, rfl⟩
    have hu1 : Valued.v u = 1 := by
      rw [hudef, map_div₀, hval, hDv]
      exact div_self WithZero.exp_ne_zero
