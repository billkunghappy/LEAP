  have V3 := divisorCalc_degree_zero W hW ord V1 V2 hnonneg hinf hXo hconj
  have V5 := divisorCalc_abelJacobi W hW ord V1 Vultra hnonneg hXo hYneo hYge hY2 V3
  obtain ⟨V4, RR⟩ := divisorCalc_constants_and_RR ord V1 V2 Vultra hres hunif V3
  exact ⟨ord, τ, γ, V1, V2, V3, V4, V5, RR, T1, hτ, hγc', G2, G3⟩

theorem exists_commutatorPairing {K L G : Type*} [Field K] [Field L] [Algebra K L]
    [AddCommGroup G] (ord : G → L → ℤ) (τ : G → (L ≃ₐ[K] L))
    (hmul : ∀ R f g, f ≠ 0 → g ≠ 0 → ord R (f * g) = ord R f + ord R g)
    (hpole : ∀ f, f ≠ 0 → (∀ R, 0 ≤ ord R f) → ∃ c : K, algebraMap K L c = f)
    (htr : ∀ Q R f, f ≠ 0 → ord R (τ Q f) = ord (R + Q) f)
    (hτ : ∀ P Q f, τ P (τ Q f) = τ (P + Q) f)
    (N : ℕ)
    (hAJ : ∀ Q : G, N • Q = 0 → ∃ f, f ≠ 0 ∧ ∀ R,
      ord R f = @ite ℤ (R = -Q) (Classical.propDecidable _) (N : ℤ) 0 -
        @ite ℤ (R = 0) (Classical.propDecidable _) (N : ℤ) 0) :
    ∃ e : G → G → K,
      (∀ P₁ P₂ Q : G, N • P₁ = 0 → N • P₂ = 0 → N • Q = 0 →
        e (P₁ + P₂) Q = e P₁ Q * e P₂ Q) ∧
      (∀ P Q₁ Q₂ : G, N • P = 0 → N • Q₁ = 0 → N • Q₂ = 0 →
        e P (Q₁ + Q₂) = e P Q₁ * e P Q₂) ∧
      (∀ P : G, N • P = 0 → e P P = 1) ∧
      (∀ P Q : G, N • P = 0 → N • Q = 0 → ∀ g h : L, g ≠ 0 → h ≠ 0 →
        (∀ R, ord R g = @ite ℤ (R = -P) (Classical.propDecidable _) (N : ℤ) 0 -
          @ite ℤ (R = 0) (Classical.propDecidable _) (N : ℤ) 0) →
        (∀ R, ord R h = @ite ℤ (R = -Q) (Classical.propDecidable _) (N : ℤ) 0 -
          @ite ℤ (R = 0) (Classical.propDecidable _) (N : ℤ) 0) →
        algebraMap K L (e P Q) * (h * τ Q g) = g * τ P h) :=
by
  classical
  
  have s1 : ∀ f f' : L, f ≠ 0 → f' ≠ 0 → (∀ R, ord R f' = ord R f) →
      ∃ a : K, f' = algebraMap K L a * f := by
    intro f f' hf hf' hord
    have hφ : f' / f ≠ 0 := div_ne_zero hf' hf
    obtain ⟨a, ha⟩ := hpole (f' / f) hφ (fun R => by
      have h1 := hmul R (f' / f) f hφ hf
      rw [div_mul_cancel₀ f' hf, hord R] at h1
      linarith)
    exact ⟨a, by rw [ha, div_mul_cancel₀ f' hf]⟩
  
  have s2 : ∀ (P Q : G) (g h : L), g ≠ 0 → h ≠ 0 →
      (∀ R, ord R g = @ite ℤ (R = -P) (Classical.propDecidable _) (N : ℤ) 0 -
        @ite ℤ (R = 0) (Classical.propDecidable _) (N : ℤ) 0) →
      (∀ R, ord R h = @ite ℤ (R = -Q) (Classical.propDecidable _) (N : ℤ) 0 -
        @ite ℤ (R = 0) (Classical.propDecidable _) (N : ℤ) 0) →
      ∀ R, ord R (g * τ P h) = @ite ℤ (R = -(P + Q)) (Classical.propDecidable _) (N : ℤ) 0 -
        @ite ℤ (R = 0) (Classical.propDecidable _) (N : ℤ) 0 := by
    intro P Q g h hg hh hgd hhd R
    have hτh : τ P h ≠ 0 := (map_ne_zero (τ P)).mpr hh
    rw [hmul R g (τ P h) hg hτh, htr P R h hh, hgd R, hhd (R + P)]
    have e1 : (R + P = 0) ↔ (R = -P) := add_eq_zero_iff_eq_neg
    have e2 : (R + P = -Q) ↔ (R = -(P + Q)) := by
      constructor
      · intro hR
        calc R = (R + P) - P := by abel
          _ = -Q - P := by rw [hR]
          _ = -(P + Q) := by abel
      · intro hR
        rw [hR]; abel
    rw [show (R + P = 0) = (R = -P) from propext e1,
      show (R + P = -Q) = (R = -(P + Q)) from propext e2]
    ring
  
  have s3 : ∀ (P₁ P₂ Q : G) (g₁ g₂ h : L), g₁ ≠ 0 → g₂ ≠ 0 → h ≠ 0 → ∀ c₁ c₂ c₃ : K,
      algebraMap K L c₁ * (h * τ Q g₁) = g₁ * τ P₁ h →
      algebraMap K L c₂ * (h * τ Q g₂) = g₂ * τ P₂ h →
      algebraMap K L c₃ * (h * τ Q (g₁ * τ P₁ g₂)) = g₁ * τ P₁ g₂ * τ (P₁ + P₂) h →
      c₃ = c₁ * c₂ := by
    intro P₁ P₂ Q g₁ g₂ h hg₁ hg₂ hh c₁ c₂ c₃ h₁ h₂ h₃
    have hcomm : τ Q (τ P₁ g₂) = τ P₁ (τ Q g₂) := by rw [hτ, hτ, add_comm]
    rw [map_mul, hcomm, ← hτ P₁ P₂ h] at h₃
    have H2 := congrArg (τ P₁) h₂
    simp only [map_mul, AlgEquiv.commutes] at H2
    have hX : h * (τ Q g₁ * τ P₁ (τ Q g₂)) ≠ 0 :=
      mul_ne_zero hh (mul_ne_zero ((map_ne_zero _).mpr hg₁)
        ((map_ne_zero _).mpr ((map_ne_zero _).mpr hg₂)))
    have key : algebraMap K L c₃ * (h * (τ Q g₁ * τ P₁ (τ Q g₂))) =
        (algebraMap K L c₁ * algebraMap K L c₂) * (h * (τ Q g₁ * τ P₁ (τ Q g₂))) := by
      linear_combination h₃ - g₁ * H2 - (algebraMap K L c₂ * τ P₁ (τ Q g₂)) * h₁
    have hc := mul_right_cancel₀ hX key
    rw [← map_mul] at hc
    exact (algebraMap K L).injective hc
  
  have s4 : ∀ (P Q₁ Q₂ : G) (g h₁ h₂ : L), g ≠ 0 → h₁ ≠ 0 → h₂ ≠ 0 → ∀ c₁ c₂ c₃ : K,
      algebraMap K L c₁ * (h₁ * τ Q₁ g) = g * τ P h₁ →
      algebraMap K L c₂ * (h₂ * τ Q₂ g) = g * τ P h₂ →
      algebraMap K L c₃ * (h₁ * τ Q₁ h₂ * τ (Q₁ + Q₂) g) = g * τ P (h₁ * τ Q₁ h₂) →
      c₃ = c₁ * c₂ := by
    intro P Q₁ Q₂ g h₁ h₂ hg hh₁ hh₂ c₁ c₂ c₃ e₁ e₂ e₃
    have hcomm : τ P (τ Q₁ h₂) = τ Q₁ (τ P h₂) := by rw [hτ, hτ, add_comm]
    rw [← hτ Q₁ Q₂ g, map_mul, hcomm] at e₃
    have H2 := congrArg (τ Q₁) e₂
    simp only [map_mul, AlgEquiv.commutes] at H2
    have hX : h₁ * τ Q₁ h₂ * τ Q₁ (τ Q₂ g) ≠ 0 :=
      mul_ne_zero (mul_ne_zero hh₁ ((map_ne_zero _).mpr hh₂))
        ((map_ne_zero _).mpr ((map_ne_zero _).mpr hg))
    have key : algebraMap K L c₃ * (h₁ * τ Q₁ h₂ * τ Q₁ (τ Q₂ g)) =
        (algebraMap K L c₁ * algebraMap K L c₂) * (h₁ * τ Q₁ h₂ * τ Q₁ (τ Q₂ g)) := by
      linear_combination e₃ - (algebraMap K L c₁ * h₁) * H2 - τ Q₁ (τ P h₂) * e₁
    have hc := mul_right_cancel₀ hX key
    rw [← map_mul] at hc
    exact (algebraMap K L).injective hc
  
  let Spec : G → G → K → Prop := fun P Q c => ∀ g h : L, g ≠ 0 → h ≠ 0 →
      (∀ R, ord R g = @ite ℤ (R = -P) (Classical.propDecidable _) (N : ℤ) 0 -
        @ite ℤ (R = 0) (Classical.propDecidable _) (N : ℤ) 0) →
      (∀ R, ord R h = @ite ℤ (R = -Q) (Classical.propDecidable _) (N : ℤ) 0 -
        @ite ℤ (R = 0) (Classical.propDecidable _) (N : ℤ) 0) →
      algebraMap K L c * (h * τ Q g) = g * τ P h
  have hex : ∀ P Q : G, N • P = 0 → N • Q = 0 → ∃ c, Spec P Q c := by
    intro P Q hP hQ
    obtain ⟨g₀, hg₀, hg₀d⟩ := hAJ P hP
    obtain ⟨h₀, hh₀, hh₀d⟩ := hAJ Q hQ
    have hX : h₀ * τ Q g₀ ≠ 0 := mul_ne_zero hh₀ ((map_ne_zero _).mpr hg₀)
    have hY : g₀ * τ P h₀ ≠ 0 := mul_ne_zero hg₀ ((map_ne_zero _).mpr hh₀)
    have dY := s2 P Q g₀ h₀ hg₀ hh₀ hg₀d hh₀d
    have dX := s2 Q P h₀ g₀ hh₀ hg₀ hh₀d hg₀d
    obtain ⟨c, hc⟩ := s1 _ _ hX hY (fun R => by rw [dY R, dX R, add_comm Q P])
    refine ⟨c, ?_⟩
    intro g h hg hh hgd hhd
    obtain ⟨a, rfl⟩ := s1 g₀ g hg₀ hg (fun R => by rw [hgd R, hg₀d R])
    obtain ⟨b, rfl⟩ := s1 h₀ h hh₀ hh (fun R => by rw [hhd R, hh₀d R])
    simp only [map_mul, AlgEquiv.commutes]
    linear_combination (-(algebraMap K L a * algebraMap K L b)) * hc
  let e : G → G → K := fun P Q => if hx : ∃ c, Spec P Q c then Classical.choose hx else 1
  have he : ∀ P Q : G, N • P = 0 → N • Q = 0 → Spec P Q (e P Q) := by
    intro P Q hP hQ
    have hx := hex P Q hP hQ
    have hep : e P Q = Classical.choose hx := dif_pos hx
    rw [hep]
    exact Classical.choose_spec hx
  refine ⟨e, ?_, ?_, ?_, ?_⟩
  · intro P₁ P₂ Q h₁ h₂ hQ
    have hS : N • (P₁ + P₂) = 0 := by rw [nsmul_add, h₁, h₂, add_zero]
    obtain ⟨g₁, hg₁, hd₁⟩ := hAJ P₁ h₁
    obtain ⟨g₂, hg₂, hd₂⟩ := hAJ P₂ h₂
    obtain ⟨h, hh, hhd⟩ := hAJ Q hQ
    have hg₃ : g₁ * τ P₁ g₂ ≠ 0 := mul_ne_zero hg₁ ((map_ne_zero _).mpr hg₂)
    have hd₃ := s2 P₁ P₂ g₁ g₂ hg₁ hg₂ hd₁ hd₂
    exact s3 P₁ P₂ Q g₁ g₂ h hg₁ hg₂ hh _ _ _ (he P₁ Q h₁ hQ g₁ h hg₁ hh hd₁ hhd)
      (he P₂ Q h₂ hQ g₂ h hg₂ hh hd₂ hhd) (he (P₁ + P₂) Q hS hQ _ h hg₃ hh hd₃ hhd)
  · intro P Q₁ Q₂ hP h₁ h₂
    have hS : N • (Q₁ + Q₂) = 0 := by rw [nsmul_add, h₁, h₂, add_zero]
    obtain ⟨g, hg, hgd⟩ := hAJ P hP
    obtain ⟨k₁, hk₁, hd₁⟩ := hAJ Q₁ h₁
    obtain ⟨k₂, hk₂, hd₂⟩ := hAJ Q₂ h₂
    have hk₃ : k₁ * τ Q₁ k₂ ≠ 0 := mul_ne_zero hk₁ ((map_ne_zero _).mpr hk₂)
    have hd₃ := s2 Q₁ Q₂ k₁ k₂ hk₁ hk₂ hd₁ hd₂
    exact s4 P Q₁ Q₂ g k₁ k₂ hg hk₁ hk₂ _ _ _ (he P Q₁ hP h₁ g k₁ hg hk₁ hgd hd₁)
      (he P Q₂ hP h₂ g k₂ hg hk₂ hgd hd₂) (he P (Q₁ + Q₂) hP hS g _ hg hk₃ hgd hd₃)
  · intro P hP
    obtain ⟨g, hg, hgd⟩ := hAJ P hP
    have H := he P P hP hP g g hg hg hgd hgd
    have hX : g * τ P g ≠ 0 := mul_ne_zero hg ((map_ne_zero _).mpr hg)
    have H' : algebraMap K L (e P P) * (g * τ P g) = algebraMap K L 1 * (g * τ P g) := by
      rw [map_one, one_mul]; exact H
    exact (algebraMap K L).injective (mul_right_cancel₀ hX H')
  · intro P Q hP hQ
    exact he P Q hP hQ

theorem card_le_of_commuting_translates {K L G : Type*} [Field K] [IsAlgClosed K] [Field L]
    [Algebra K L] [AddCommGroup G] (ord : G → L → ℤ) (τ : G → (L ≃ₐ[K] L))
    (hmul : ∀ R f g, f ≠ 0 → g ≠ 0 → ord R (f * g) = ord R f + ord R g)
    (hconst : ∀ R (c : K), c ≠ 0 → ord R (algebraMap K L c) = 0)
    (hdeg : ∀ f, f ≠ 0 → ∃ s : Finset G, (∀ R, R ∉ s → ord R f = 0) ∧ ∑ R ∈ s, ord R f = 0)
    (htr : ∀ Q R f, f ≠ 0 → ord R (τ Q f) = ord (R + Q) f)
    (hτ : ∀ P Q f, τ P (τ Q f) = τ (P + Q) f)
    (N : ℕ) (hN : 0 < N)
    (V : Submodule K L) (hVfin : FiniteDimensional K V)
    (hV : ∀ f, f ∈ V ↔ (f = 0 ∨ ((∀ R, R ≠ 0 → 0 ≤ ord R f) ∧ -(N : ℤ) ≤ ord 0 f)))
    (I : AddSubgroup G) (f : G → L)
    (hf0 : ∀ Q ∈ I, f Q ≠ 0)
    (hfdiv : ∀ Q ∈ I, ∀ R, ord R (f Q) =
      @ite ℤ (R = -Q) (Classical.propDecidable _) (N : ℤ) 0 -
        @ite ℤ (R = 0) (Classical.propDecidable _) (N : ℤ) 0)
    (hcomm : ∀ P ∈ I, ∀ Q ∈ I, f P * τ P (f Q) = f Q * τ Q (f P)) :
    Nat.card I ≤ N :=
by
  classical
  
  have hmem : ∀ Q ∈ I, ∀ g ∈ V, f Q * τ Q g ∈ V := by
    intro Q hQ g hg
    by_cases hg0 : g = 0
    · subst hg0; simp
    rcases (hV g).mp hg with h | ⟨hpos, h0⟩
    · exact absurd h hg0
    have hτg : τ Q g ≠ 0 := by
      intro h; apply hg0; exact (τ Q).injective (by rw [h, map_zero])
    refine (hV _).mpr (Or.inr ⟨?_, ?_⟩)
    · intro R hR
      rw [hmul R _ _ (hf0 Q hQ) hτg, hfdiv Q hQ R, htr Q R g hg0]
      by_cases hRQ : R = -Q
      · have e : R + Q = 0 := by rw [hRQ]; exact neg_add_cancel Q
        rw [if_pos hRQ, if_neg hR, e]; omega
      · have e : R + Q ≠ 0 := fun h => hRQ (eq_neg_of_add_eq_zero_left h)
        rw [if_neg hRQ, if_neg hR]; have := hpos _ e; omega
    · rw [hmul 0 _ _ (hf0 Q hQ) hτg, hfdiv Q hQ 0, htr Q 0 g hg0, zero_add]
      by_cases hQ0 : Q = 0
      · subst hQ0; rw [if_pos neg_zero.symm, if_pos rfl]; omega
      · have e : (0:G) ≠ -Q := fun h => hQ0 (neg_eq_zero.mp h.symm)
        rw [if_neg e, if_pos rfl]; have := hpos Q hQ0; omega
  
  let U : G → L →ₗ[K] L := fun Q => (LinearMap.mulLeft K (f Q)).comp (τ Q).toLinearMap
  have hU : ∀ Q g, U Q g = f Q * τ Q g := fun Q g => rfl
  have hUcomm : ∀ P ∈ I, ∀ Q ∈ I, ∀ g, U P (U Q g) = U Q (U P g) := by
    intro P hP Q hQ g
    simp only [hU, map_mul, hτ]
    rw [← mul_assoc, ← mul_assoc, hcomm P hP Q hQ, add_comm P Q]
  
  have h1V : (1 : L) ∈ V := by
    refine (hV 1).mpr (Or.inr ⟨fun R _ => ?_, ?_⟩)
    · have := hconst R 1 one_ne_zero; rw [map_one] at this; omega
    · have := hconst 0 1 one_ne_zero; rw [map_one] at this; omega
  
  let Pinv : Submodule K L → Prop := fun W => W ≤ V ∧ W ≠ ⊥ ∧ ∀ Q ∈ I, ∀ x ∈ W, U Q x ∈ W
  have hVinv : Pinv V := by
    refine ⟨le_rfl, fun h => ?_, fun Q hQ x hx => hmem Q hQ x hx⟩
    have h1 := h1V
    rw [h] at h1
    exact one_ne_zero ((Submodule.mem_bot K).mp h1)
  have hex : ∃ n, ∃ W, Pinv W ∧ Module.finrank K W = n := ⟨_, V, hVinv, rfl⟩
  obtain ⟨W, hW, hWn⟩ := Nat.find_spec hex
  have hmin : ∀ W', Pinv W' → Module.finrank K W ≤ Module.finrank K W' := by
    intro W' hW'
    rw [hWn]; exact Nat.find_min' hex ⟨W', hW', rfl⟩
  obtain ⟨hWV, hWbot, hWinv⟩ := hW
  haveI : FiniteDimensional K V := hVfin
  haveI : FiniteDimensional K W := Submodule.finiteDimensional_of_le hWV
  haveI : Nontrivial W := Submodule.nontrivial_iff_ne_bot.mpr hWbot
  have heig : ∀ Q ∈ I, ∃ c : K, ∀ x ∈ W, U Q x = c • x := by
    intro Q hQ
    let T : Module.End K W := (U Q).restrict (hWinv Q hQ)
    obtain ⟨c, hc⟩ := Module.End.exists_eigenvalue T
    obtain ⟨w, hw⟩ := hc.exists_hasEigenvector
    have hTw : T w = c • w := hw.apply_eq_smul
    let E : Submodule K L := W ⊓ LinearMap.ker (U Q - c • LinearMap.id)
    have hmemE : ∀ x, x ∈ E ↔ x ∈ W ∧ U Q x = c • x := by
      intro x
      simp only [E, Submodule.mem_inf, LinearMap.mem_ker, LinearMap.sub_apply,
        LinearMap.smul_apply, LinearMap.id_apply, sub_eq_zero]
    have hEinv : Pinv E := by
      refine ⟨inf_le_left.trans hWV, ?_, ?_⟩
      · intro hE
        apply hw.2
        have hwE : (w : L) ∈ E := (hmemE _).mpr ⟨w.2, by
          have := congrArg Subtype.val hTw
          simpa [T] using this⟩
        rw [hE] at hwE
        exact Subtype.ext ((Submodule.mem_bot K).mp hwE)
      · intro P hP x hx
        rw [hmemE] at hx ⊢
        refine ⟨hWinv P hP x hx.1, ?_⟩
        rw [hUcomm Q hQ P hP, hx.2, map_smul]
    have hEW : E = W := Submodule.eq_of_le_of_finrank_le inf_le_left (hmin E hEinv)
    refine ⟨c, fun x hx => ?_⟩
    rw [← hEW] at hx
    exact ((hmemE x).mp hx).2
  
  obtain ⟨g, hgW, hg0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hWbot
  have hgV := hWV hgW
  rcases (hV g).mp hgV with hg | ⟨hpos, h0⟩
  · exact absurd hg hg0
  have hshift : ∀ Q ∈ I, ∀ R, ord (R + Q) g = ord R g -
      @ite ℤ (R = -Q) (Classical.propDecidable _) (N : ℤ) 0 +
        @ite ℤ (R = 0) (Classical.propDecidable _) (N : ℤ) 0 := by
    intro Q hQ R
    obtain ⟨c, hc⟩ := heig Q hQ
    have he : f Q * τ Q g = algebraMap K L c * g := by
      rw [← Algebra.smul_def]; exact hc g hgW
    have hτg : τ Q g ≠ 0 := by
      intro h; apply hg0; exact (τ Q).injective (by rw [h, map_zero])
    have hc0 : c ≠ 0 := by
      rintro rfl
      rw [map_zero, zero_mul] at he
      exact mul_ne_zero (hf0 Q hQ) hτg he
    have := congrArg (ord R) he
    rw [hmul R _ _ (hf0 Q hQ) hτg, hmul R _ _ ((map_ne_zero _).mpr hc0) hg0, hconst R c hc0,
      hfdiv Q hQ R, htr Q R g hg0] at this
    linarith
  
  obtain ⟨s, hs, hsum⟩ := hdeg g hg0
  let h : G → ℤ := fun R => ord R g + @ite ℤ (R = 0) (Classical.propDecidable _) (N : ℤ) 0
  have hnn : ∀ R, 0 ≤ h R := by
    intro R
    by_cases hR : R = 0
    · simp only [h, if_pos hR]; subst hR; omega
    · simp only [h, if_neg hR]; have := hpos R hR; omega
  have hinv : ∀ Q ∈ I, ∀ R, h (R + Q) = h R := by
    intro Q hQ R
    simp only [h]
    rw [hshift Q hQ R]
    by_cases hRQ : R = -Q
    · have e : R + Q = 0 := by rw [hRQ]; exact neg_add_cancel Q
      rw [if_pos hRQ, if_pos e]; ring
    · have e : R + Q ≠ 0 := fun e => hRQ (eq_neg_of_add_eq_zero_left e)
      rw [if_neg hRQ, if_neg e]; ring
  let s' := insert (0:G) s
  have hout : ∀ R, R ∉ s' → h R = 0 := by
    intro R hR
    have hR0 : R ≠ 0 := fun e => hR (e ▸ Finset.mem_insert_self 0 s)
    have hRs : R ∉ s := fun e => hR (Finset.mem_insert_of_mem e)
    simp only [h, if_neg hR0, hs R hRs, add_zero]
  have hmass : ∑ R ∈ s', h R = N := by
    simp only [h]
    rw [Finset.sum_add_distrib]
    have h1 : ∑ R ∈ s', ord R g = 0 := by
      rw [← hsum]; symm
      apply Finset.sum_subset (Finset.subset_insert 0 s)
      intro x _ hxs
      exact hs x hxs
    have h2 : ∑ R ∈ s', @ite ℤ (R = 0) (Classical.propDecidable _) (N : ℤ) 0 = N := by
      rw [Finset.sum_eq_single (0:G)]
      · rw [if_pos rfl]
      · intro b _ hb; rw [if_neg hb]
      · intro hn; exact absurd (Finset.mem_insert_self 0 s) hn
    rw [h1, h2, zero_add]
  have hR₀ex : ∃ R₀ ∈ s', 0 < h R₀ := by
    by_contra hcon
    push_neg at hcon
    have hle : ∑ R ∈ s', h R ≤ 0 := Finset.sum_nonpos hcon
    rw [hmass] at hle; omega
  obtain ⟨R₀, -, hR₀⟩ := hR₀ex
  let A := s'.filter (fun R => 0 < h R)
  have hφ : ∀ Q : I, R₀ + (Q : G) ∈ A := by
    intro Q
    have hh : h (R₀ + Q) = h R₀ := hinv Q Q.2 R₀
    rw [Finset.mem_filter]
    refine ⟨?_, by rw [hh]; exact hR₀⟩
    by_contra hn
    have := hout _ hn
    rw [hh] at this; omega
  let φ : I → A := fun Q => ⟨R₀ + Q, hφ Q⟩
  have hφinj : Function.Injective φ := by
    intro a b hab
    apply Subtype.ext
    have := congrArg Subtype.val hab
    exact add_left_cancel this
  have hcard1 : Nat.card I ≤ A.card := by
    have := Nat.card_le_card_of_injective φ hφinj
    rwa [Nat.card_eq_finsetCard] at this
  have hcard2 : (A.card : ℤ) ≤ N := by
    calc (A.card : ℤ) = ∑ R ∈ A, (1 : ℤ) := by simp
      _ ≤ ∑ R ∈ A, h R := Finset.sum_le_sum (fun R hR => by
          have := (Finset.mem_filter.mp hR).2; omega)
      _ ≤ ∑ R ∈ s', h R := Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
          (fun R _ _ => hnn R)
      _ = N := hmass
  omega

theorem exists_levelPairing_of_divisorCalculus (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    [DecidableEq (AlgebraicClosure F)] (E : WeierstrassCurve F)
    {L : Type u} [Field L] [Algebra (AlgebraicClosure F) L]
    (ord : EllipticRootNumber.Pts F E → L → ℤ)
    (τ : EllipticRootNumber.Pts F E → (L ≃ₐ[AlgebraicClosure F] L))
    (γ : EllipticRootNumber.AbsGal F → (L ≃+* L))
    (hmul : ∀ R f g, f ≠ 0 → g ≠ 0 → ord R (f * g) = ord R f + ord R g)
    (hconst : ∀ R (c : AlgebraicClosure F), c ≠ 0 →
      ord R (algebraMap (AlgebraicClosure F) L c) = 0)
    (hdeg : ∀ f, f ≠ 0 → ∃ s : Finset (EllipticRootNumber.Pts F E),
      (∀ R, R ∉ s → ord R f = 0) ∧ ∑ R ∈ s, ord R f = 0)
    (hpole : ∀ f, f ≠ 0 → (∀ R, 0 ≤ ord R f) →
      ∃ c : AlgebraicClosure F, algebraMap (AlgebraicClosure F) L c = f)
    (hAJ : ∀ (N : ℕ) (Q : EllipticRootNumber.Pts F E), N • Q = 0 → ∃ f, f ≠ 0 ∧ ∀ R,
      ord R f = @ite ℤ (R = -Q) (Classical.propDecidable _) (N : ℤ) 0 -
        @ite ℤ (R = 0) (Classical.propDecidable _) (N : ℤ) 0)
    (hRR : ∀ N : ℕ, ∃ V : Submodule (AlgebraicClosure F) L,
      FiniteDimensional (AlgebraicClosure F) V ∧
      ∀ f, f ∈ V ↔ (f = 0 ∨ ((∀ R, R ≠ 0 → 0 ≤ ord R f) ∧ -(N : ℤ) ≤ ord 0 f)))
    (htr : ∀ Q R f, f ≠ 0 → ord R (τ Q f) = ord (R + Q) f)
    (hτ : ∀ P Q f, τ P (τ Q f) = τ (P + Q) f)
    (hγc : ∀ (σ : EllipticRootNumber.AbsGal F) (c : AlgebraicClosure F),
      γ σ (algebraMap (AlgebraicClosure F) L c) = algebraMap (AlgebraicClosure F) L (σ c))
    (hγo : ∀ σ R f, f ≠ 0 → ord (EllipticRootNumber.galHom F E σ R) (γ σ f) = ord R f)
    (hγτ : ∀ σ Q f, γ σ (τ Q f) = τ (EllipticRootNumber.galHom F E σ Q) (γ σ f))
    (N : ℕ) (hN : 0 < N) :
    ∃ e : EllipticRootNumber.Pts F E → EllipticRootNumber.Pts F E → AlgebraicClosure F,
      (∀ P₁ P₂ Q : EllipticRootNumber.Pts F E,
        P₁ ∈ EllipticRootNumber.torsion F E N → P₂ ∈ EllipticRootNumber.torsion F E N →
        Q ∈ EllipticRootNumber.torsion F E N → e (P₁ + P₂) Q = e P₁ Q * e P₂ Q) ∧
      (∀ P Q₁ Q₂ : EllipticRootNumber.Pts F E,
        P ∈ EllipticRootNumber.torsion F E N → Q₁ ∈ EllipticRootNumber.torsion F E N →
        Q₂ ∈ EllipticRootNumber.torsion F E N → e P (Q₁ + Q₂) = e P Q₁ * e P Q₂) ∧
      (∀ P : EllipticRootNumber.Pts F E, P ∈ EllipticRootNumber.torsion F E N → e P P = 1) ∧
      (∀ (σ : EllipticRootNumber.AbsGal F) (P Q : EllipticRootNumber.Pts F E),
        P ∈ EllipticRootNumber.torsion F E N → Q ∈ EllipticRootNumber.torsion F E N →
        e (EllipticRootNumber.galHom F E σ P) (EllipticRootNumber.galHom F E σ Q) = σ (e P Q)) ∧
      (∀ I : AddSubgroup (EllipticRootNumber.Pts F E),
        (∀ P ∈ I, P ∈ EllipticRootNumber.torsion F E N) →
        (∀ P ∈ I, ∀ Q ∈ I, e P Q = 1) → Nat.card I ≤ N) :=
by
  classical
  obtain rfl : ‹DecidableEq (AlgebraicClosure F)› = (fun a b => Classical.propDecidable (a = b)) :=
    Subsingleton.elim _ _
  obtain ⟨e, hl, hr, halt, hchar⟩ := exists_commutatorPairing (K := AlgebraicClosure F) (L := L)
    (G := EllipticRootNumber.Pts F E) ord τ hmul hpole htr hτ N (hAJ N)
  refine ⟨e, ?_, ?_, ?_, ?_, ?_⟩
  · intro P₁ P₂ Q h₁ h₂ h₃
    exact hl P₁ P₂ Q ((EllipticRootNumber.mem_torsion F E).mp h₁)
      ((EllipticRootNumber.mem_torsion F E).mp h₂) ((EllipticRootNumber.mem_torsion F E).mp h₃)
  · intro P Q₁ Q₂ h₁ h₂ h₃
    exact hr P Q₁ Q₂ ((EllipticRootNumber.mem_torsion F E).mp h₁)
      ((EllipticRootNumber.mem_torsion F E).mp h₂) ((EllipticRootNumber.mem_torsion F E).mp h₃)
  · intro P hP
    exact halt P ((EllipticRootNumber.mem_torsion F E).mp hP)
  · 
    intro σ P Q hP hQ
    have hP' : N • P = 0 := (EllipticRootNumber.mem_torsion F E).mp hP
    have hQ' : N • Q = 0 := (EllipticRootNumber.mem_torsion F E).mp hQ
    have hinv1 : ∀ R, EllipticRootNumber.galHom F E σ (EllipticRootNumber.galHom F E σ⁻¹ R) = R :=
      fun R => by
        rw [← EllipticRootNumber.galHom_mul, mul_inv_cancel, EllipticRootNumber.galHom_one]
    have hinv2 : ∀ R, EllipticRootNumber.galHom F E σ⁻¹ (EllipticRootNumber.galHom F E σ R) = R :=
      fun R => by
        rw [← EllipticRootNumber.galHom_mul, inv_mul_cancel, EllipticRootNumber.galHom_one]
    have hdivγ : ∀ X : EllipticRootNumber.Pts F E, ∀ f : L, f ≠ 0 →
        (∀ R, ord R f = @ite ℤ (R = -X) (Classical.propDecidable _) (N : ℤ) 0 -
          @ite ℤ (R = 0) (Classical.propDecidable _) (N : ℤ) 0) →
        ∀ R, ord R (γ σ f) =
          @ite ℤ (R = -EllipticRootNumber.galHom F E σ X) (Classical.propDecidable _) (N : ℤ) 0 -
          @ite ℤ (R = 0) (Classical.propDecidable _) (N : ℤ) 0 := by
      intro X f hf hfd R
      have h1 := hγo σ (EllipticRootNumber.galHom F E σ⁻¹ R) f hf
      rw [hinv1] at h1
      rw [h1, hfd]
      have e1 : (EllipticRootNumber.galHom F E σ⁻¹ R = -X) ↔
          (R = -EllipticRootNumber.galHom F E σ X) := by
        constructor
        · intro h
          rw [← hinv1 R, h, map_neg]
        · intro h
          rw [h, ← map_neg, hinv2]
      have e2 : (EllipticRootNumber.galHom F E σ⁻¹ R = 0) ↔ (R = 0) := by
        constructor
        · intro h
          rw [← hinv1 R, h, map_zero]
        · intro h
          rw [h, map_zero]
      by_cases c1 : R = -EllipticRootNumber.galHom F E σ X
      · rw [if_pos (e1.mpr c1), if_pos c1]
        by_cases c2 : R = 0
        · rw [if_pos (e2.mpr c2), if_pos c2]
        · rw [if_neg (fun h => c2 (e2.mp h)), if_neg c2]
      · rw [if_neg (fun h => c1 (e1.mp h)), if_neg c1]
        by_cases c2 : R = 0
        · rw [if_pos (e2.mpr c2), if_pos c2]
        · rw [if_neg (fun h => c2 (e2.mp h)), if_neg c2]
    obtain ⟨fP, hfP0, hfPd⟩ := hAJ N P hP'
    obtain ⟨fQ, hfQ0, hfQd⟩ := hAJ N Q hQ'
    have hsP : N • EllipticRootNumber.galHom F E σ P = 0 := by
      rw [← map_nsmul, hP', map_zero]
    have hsQ : N • EllipticRootNumber.galHom F E σ Q = 0 := by
      rw [← map_nsmul, hQ', map_zero]
    have hg0 : γ σ fP ≠ 0 := (map_ne_zero _).mpr hfP0
    have hh0 : γ σ fQ ≠ 0 := (map_ne_zero _).mpr hfQ0
    have A := hchar _ _ hsP hsQ (γ σ fP) (γ σ fQ) hg0 hh0 (hdivγ P fP hfP0 hfPd)
      (hdivγ Q fQ hfQ0 hfQd)
    have B := hchar P Q hP' hQ' fP fQ hfP0 hfQ0 hfPd hfQd
    have B' := congrArg (γ σ) B
    simp only [map_mul, hγc, hγτ] at B'
    have hX : γ σ fQ * τ (EllipticRootNumber.galHom F E σ Q) (γ σ fP) ≠ 0 :=
      mul_ne_zero hh0 ((map_ne_zero _).mpr hg0)
    exact (algebraMap (AlgebraicClosure F) L).injective (mul_right_cancel₀ hX (A.trans B'.symm))
  · 
    intro I hI hiso
    obtain ⟨V, hVfin, hV⟩ := hRR N
    let f : EllipticRootNumber.Pts F E → L := fun Q =>
      if h : N • Q = 0 then Classical.choose (hAJ N Q h) else 1
    have hfspec : ∀ Q ∈ I, f Q ≠ 0 ∧ ∀ R, ord R (f Q) =
        @ite ℤ (R = -Q) (Classical.propDecidable _) (N : ℤ) 0 -
          @ite ℤ (R = 0) (Classical.propDecidable _) (N : ℤ) 0 := by
      intro Q hQI
      have hQ : N • Q = 0 := (EllipticRootNumber.mem_torsion F E).mp (hI Q hQI)
      have hfQ : f Q = Classical.choose (hAJ N Q hQ) := dif_pos hQ
      rw [hfQ]
      exact Classical.choose_spec (hAJ N Q hQ)
    have hf0 : ∀ Q ∈ I, f Q ≠ 0 := fun Q hQ => (hfspec Q hQ).1
    have hfdiv : ∀ Q ∈ I, ∀ R, ord R (f Q) =
        @ite ℤ (R = -Q) (Classical.propDecidable _) (N : ℤ) 0 -
          @ite ℤ (R = 0) (Classical.propDecidable _) (N : ℤ) 0 := fun Q hQ => (hfspec Q hQ).2
    have hcomm : ∀ P ∈ I, ∀ Q ∈ I, f P * τ P (f Q) = f Q * τ Q (f P) := by
      intro P hP Q hQ
      have h := hchar P Q ((EllipticRootNumber.mem_torsion F E).mp (hI P hP))
        ((EllipticRootNumber.mem_torsion F E).mp (hI Q hQ)) (f P) (f Q) (hf0 P hP) (hf0 Q hQ)
        (hfdiv P hP) (hfdiv Q hQ)
      rw [hiso P hP Q hQ, map_one, one_mul] at h
      exact h.symm
    exact card_le_of_commuting_translates ord τ hmul hconst hdeg htr hτ N hN V hVfin hV I f
      hf0 hfdiv hcomm

theorem nondegenerate_of_isotropic_card_le {A : Type*} [AddCommGroup A] {K : Type*} [Field K]
    (H : AddSubgroup A) (N : ℕ) (hN : 0 < N) (hcard : Nat.card H = N ^ 2) (e : A → A → K)
    (hl : ∀ P₁ P₂ Q, P₁ ∈ H → P₂ ∈ H → Q ∈ H → e (P₁ + P₂) Q = e P₁ Q * e P₂ Q)
    (hr : ∀ P Q₁ Q₂, P ∈ H → Q₁ ∈ H → Q₂ ∈ H → e P (Q₁ + Q₂) = e P Q₁ * e P Q₂)
    (halt : ∀ P, P ∈ H → e P P = 1)
    (hiso : ∀ I : AddSubgroup A, I ≤ H → (∀ P ∈ I, ∀ Q ∈ I, e P Q = 1) → Nat.card I ≤ N) :
    ∀ P, P ∈ H → (∀ Q, Q ∈ H → e P Q = 1) → P = 0 :=
by
  classical
  intro P hP hPrad
  by_contra hP0
  
  haveI hHfin : Finite H := Nat.finite_of_card_ne_zero (by rw [hcard]; positivity)
  
  have hskew : ∀ x y, x ∈ H → y ∈ H → e x y * e y x = 1 := by
    intro x y hx hy
    have h := halt (x + y) (H.add_mem hx hy)
    rw [hl x y (x + y) hx hy (H.add_mem hx hy), hr x x y hx hx hy, hr y x y hy hx hy,
      halt x hx, halt y hy] at h
    rw [← h]; ring
  have hne : ∀ x y, x ∈ H → y ∈ H → e x y ≠ 0 := by
    intro x y hx hy h0
    have h := hskew x y hx hy
    rw [h0, zero_mul] at h
    exact zero_ne_one h
  have h0l : ∀ y, y ∈ H → e 0 y = 1 := by
    intro y hy
    have h := hl 0 0 y H.zero_mem H.zero_mem hy
    rw [add_zero] at h
    exact mul_left_cancel₀ (hne 0 y H.zero_mem hy) (by rw [mul_one]; exact h.symm)
  have h0r : ∀ x, x ∈ H → e x 0 = 1 := by
    intro x hx
    have h := hr x 0 0 hx H.zero_mem H.zero_mem
    rw [add_zero] at h
    exact mul_left_cancel₀ (hne x 0 hx H.zero_mem) (by rw [mul_one]; exact h.symm)
  
  let T : Set ℕ := {n | ∃ J : AddSubgroup A, J ≤ H ∧ (∀ x ∈ J, ∀ y ∈ J, e x y = 1) ∧
    Nat.card J = n}
  have hT1 : 1 ∈ T := by
    refine ⟨⊥, bot_le, ?_, AddSubgroup.card_bot⟩
    intro x hx y hy
    rw [AddSubgroup.mem_bot] at hx hy
    subst hx hy
    exact halt 0 H.zero_mem
  have hTbdd : BddAbove T := by
    refine ⟨N, ?_⟩
    rintro n ⟨J, hJH, hJiso, rfl⟩
    exact hiso J hJH hJiso
  obtain ⟨I, hIH, hIiso, hIcard⟩ := Nat.sSup_mem ⟨1, hT1⟩ hTbdd
  have hImax : ∀ J : AddSubgroup A, J ≤ H → (∀ x ∈ J, ∀ y ∈ J, e x y = 1) →
      Nat.card J ≤ Nat.card I := by
    intro J hJH hJiso
    rw [hIcard]
    exact le_csSup hTbdd ⟨J, hJH, hJiso, rfl⟩
  haveI hIfin : Finite I := Finite.of_injective (AddSubgroup.inclusion hIH)
    (AddSubgroup.inclusion_injective hIH)
  
  let Lft : ∀ y : A, y ∈ H → AddSubgroup A := fun y hy =>
    { carrier := {x | x ∈ H ∧ e x y = 1}
      add_mem' := by
        rintro a b ⟨ha1, ha2⟩ ⟨hb1, hb2⟩
        exact ⟨H.add_mem ha1 hb1, by rw [hl a b y ha1 hb1 hy, ha2, hb2, one_mul]⟩
      zero_mem' := ⟨H.zero_mem, h0l y hy⟩
      neg_mem' := by
        rintro x ⟨hx1, hx2⟩
        refine ⟨H.neg_mem hx1, ?_⟩
        have h := hl (-x) x y (H.neg_mem hx1) hx1 hy
        rw [neg_add_cancel, h0l y hy, hx2, mul_one] at h
        exact h.symm }
  let Rgt : ∀ x : A, x ∈ H → AddSubgroup A := fun x hx =>
    { carrier := {y | y ∈ H ∧ e x y = 1}
      add_mem' := by
        rintro a b ⟨ha1, ha2⟩ ⟨hb1, hb2⟩
        exact ⟨H.add_mem ha1 hb1, by rw [hr x a b hx ha1 hb1, ha2, hb2, one_mul]⟩
      zero_mem' := ⟨H.zero_mem, h0r x hx⟩
      neg_mem' := by
        rintro y ⟨hy1, hy2⟩
        refine ⟨H.neg_mem hy1, ?_⟩
        have h := hr x (-y) y hx (H.neg_mem hy1) hy1
        rw [neg_add_cancel, h0r x hx, hy2, mul_one] at h
        exact h.symm }
  have hLft : ∀ y (hy : y ∈ H) x, x ∈ Lft y hy ↔ x ∈ H ∧ e x y = 1 := fun _ _ _ => Iff.rfl
  have hRgt : ∀ x (hx : x ∈ H) y, y ∈ Rgt x hx ↔ y ∈ H ∧ e x y = 1 := fun _ _ _ => Iff.rfl
  have hperp : ∀ Q, Q ∈ H → (∀ x, x ∈ I → e x Q = 1) → Q ∈ I := by
    intro Q hQ hQperp
    let J := I ⊔ AddSubgroup.zmultiples Q
    have hJH : J ≤ H := sup_le hIH (AddSubgroup.zmultiples_le.mpr hQ)
    have hJRz : ∀ z (hz : z ∈ I), J ≤ Rgt z (hIH hz) := by
      intro z hz
      refine sup_le (fun i hi => (hRgt z (hIH hz) i).mpr ⟨hIH hi, hIiso z hz i hi⟩) ?_
      exact AddSubgroup.zmultiples_le.mpr ((hRgt z (hIH hz) Q).mpr ⟨hQ, hQperp z hz⟩)
    have hJRQ : J ≤ Rgt Q hQ := by
      refine sup_le (fun i hi => (hRgt Q hQ i).mpr ⟨hIH hi, ?_⟩) ?_
      · have h := hskew i Q (hIH hi) hQ
        rw [hQperp i hi, one_mul] at h
        exact h
      · exact AddSubgroup.zmultiples_le.mpr ((hRgt Q hQ Q).mpr ⟨hQ, halt Q hQ⟩)
    have hJiso : ∀ x ∈ J, ∀ y ∈ J, e x y = 1 := by
      intro x hx y hy
      have hyH : y ∈ H := hJH hy
      have hJL : J ≤ Lft y hyH := by
        refine sup_le (fun z hz => (hLft y hyH z).mpr
          ⟨hIH hz, ((hRgt z (hIH hz) y).mp (hJRz z hz hy)).2⟩) ?_
        exact AddSubgroup.zmultiples_le.mpr ((hLft y hyH Q).mpr
          ⟨hQ, ((hRgt Q hQ y).mp (hJRQ hy)).2⟩)
      exact ((hLft y hyH x).mp (hJL hx)).2
    haveI : Finite J := Finite.of_injective (AddSubgroup.inclusion hJH)
      (AddSubgroup.inclusion_injective hJH)
    have hIJ : I = J := AddSubgroup.eq_of_le_of_card_ge le_sup_left (hImax J hJH hJiso)
    rw [hIJ]
    exact AddSubgroup.mem_sup_right (AddSubgroup.mem_zmultiples Q)
  
  have hPI : P ∈ I := by
    apply hperp P hP
    intro i hi
    have h := hskew i P (hIH hi) hP
    rw [hPrad i (hIH hi), mul_one] at h
    exact h
  let g : I := ⟨P, hPI⟩
  have hg0 : g ≠ 0 := by
    intro h
    apply hP0
    have := congrArg Subtype.val h
    exact this
  
  let Φ : H → (I → K) := fun Q x => e (x : A) (Q : A)
  have hfib : ∀ Q Q' : H, Φ Q = Φ Q' → (Q : A) - Q' ∈ I := by
    intro Q Q' h
    apply hperp _ (H.sub_mem Q.2 Q'.2)
    intro x hx
    have h1 : e x Q = e x Q' := congrFun h ⟨x, hx⟩
    have h2 := hr x ((Q : A) - Q') Q' (hIH hx) (H.sub_mem Q.2 Q'.2) Q'.2
    rw [sub_add_cancel] at h2
    have h3 : e x ((Q : A) - Q') * e x Q' = 1 * e x Q' := by rw [← h2, one_mul]; exact h1
    exact mul_right_cancel₀ (hne _ _ (hIH hx) Q'.2) h3
  let R := Set.range Φ
  let σ : R → H := fun y => Classical.choose y.2
  have hσ : ∀ y : R, Φ (σ y) = y := fun y => Classical.choose_spec y.2
  let F : H → R × I := fun Q =>
    (⟨Φ Q, Q, rfl⟩, ⟨(Q : A) - σ ⟨Φ Q, Q, rfl⟩, hfib _ _ (hσ ⟨Φ Q, Q, rfl⟩).symm⟩)
  have hF : Function.Injective F := by
    intro Q Q' h
    obtain ⟨h1, h2⟩ := Prod.ext_iff.mp h
    have h2' : (Q : A) - σ ⟨Φ Q, Q, rfl⟩ = (Q' : A) - σ ⟨Φ Q', Q', rfl⟩ :=
      congrArg Subtype.val h2
    have h1' : (⟨Φ Q, Q, rfl⟩ : R) = ⟨Φ Q', Q', rfl⟩ := h1
    rw [h1'] at h2'
    exact Subtype.ext (sub_left_inj.mp h2')
  have hs5 : Nat.card H ≤ Nat.card R * Nat.card I := by
    rw [← Nat.card_prod]
    exact Nat.card_le_card_of_injective F hF
  
  have hchar : ∀ y ∈ R, y 0 = 1 ∧ (∀ a b : I, y (a + b) = y a * y b) ∧ y g = 1 := by
    rintro _ ⟨Q, rfl⟩
    exact ⟨h0l Q Q.2, fun a b => hl a b Q (hIH a.2) (hIH b.2) Q.2, hPrad Q Q.2⟩
  let m : R → (Multiplicative I →* K) := fun y =>
    { toFun := fun x => (y : I → K) (Multiplicative.toAdd x)
      map_one' := (hchar y.1 y.2).1
      map_mul' := fun a b => (hchar y.1 y.2).2.1 (Multiplicative.toAdd a) (Multiplicative.toAdd b) }
  have hm : Function.Injective m := by
    intro y y' h
    apply Subtype.ext
    funext a
    exact DFunLike.congr_fun h (Multiplicative.ofAdd a)
  have hli : LinearIndependent K (fun y : R => ((m y : Multiplicative I →* K) :
      Multiplicative I → K)) :=
    (linearIndependent_monoidHom (Multiplicative I) K).comp m hm
  haveI : Fintype I := Fintype.ofFinite I
  haveI : Fintype R := Fintype.ofFinite R
  let lf : (Multiplicative I → K) →ₗ[K] K :=
    (LinearMap.proj (R := K) (φ := fun _ : Multiplicative I => K) (Multiplicative.ofAdd g)) -
      LinearMap.proj (R := K) (φ := fun _ : Multiplicative I => K) (1 : Multiplicative I)
  let W := LinearMap.ker lf
  have hmemW : ∀ y : R, ((m y : Multiplicative I →* K) : Multiplicative I → K) ∈ W := by
    intro y
    rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.proj_apply, LinearMap.proj_apply,
      sub_eq_zero, map_one]
    exact (hchar y.1 y.2).2.2
  have hWtop : W ≠ ⊤ := by
    intro h
    have hδ : (Pi.single (Multiplicative.ofAdd g) (1 : K) : Multiplicative I → K) ∈ W := by
      rw [h]; exact Submodule.mem_top
    rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.proj_apply, LinearMap.proj_apply,
      Pi.single_eq_same] at hδ
    have hne1 : (1 : Multiplicative I) ≠ Multiplicative.ofAdd g := by
      intro h1
      apply hg0
      have := congrArg Multiplicative.toAdd h1
      exact this.symm
    rw [Pi.single_eq_of_ne hne1, sub_zero] at hδ
    exact one_ne_zero hδ
  let w : R → W := fun y => ⟨_, hmemW y⟩
  have hwli : LinearIndependent K w := LinearIndependent.of_comp W.subtype hli
  have hs4 : Nat.card R < Nat.card I := by
    rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
    calc Fintype.card R ≤ Module.finrank K W := hwli.fintype_card_le_finrank
      _ < Module.finrank K (Multiplicative I → K) := Submodule.finrank_lt hWtop
      _ = Fintype.card I := by
        rw [Module.finrank_fintype_fun_eq_card, Fintype.card_multiplicative]
  
  have hcN : Nat.card I ≤ N := hiso I hIH hIiso
  rw [hcard] at hs5
  have h1 : Nat.card R * Nat.card I < Nat.card I * Nat.card I :=
    Nat.mul_lt_mul_of_pos_right hs4 (by omega)
  have h2 : Nat.card I * Nat.card I ≤ N * N := Nat.mul_le_mul hcN hcN
  nlinarith

theorem exists_compatible_pairing_family (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    [DecidableEq (AlgebraicClosure F)] (E : WeierstrassCurve F)
    (hfin : ∀ n : ℕ, 0 < n → Finite (EllipticRootNumber.torsion F E n))
    (hlift : ∀ m k : ℕ, 0 < m → 0 < k → ∀ Q : EllipticRootNumber.Pts F E,
      Q ∈ EllipticRootNumber.torsion F E m →
      ∃ Q', Q' ∈ EllipticRootNumber.torsion F E (m * k) ∧ k • Q' = Q)
    (hlevel : ∀ n : ℕ, 0 < n →
      ∃ e : EllipticRootNumber.Pts F E → EllipticRootNumber.Pts F E → AlgebraicClosure F,
        (∀ P₁ P₂ Q : EllipticRootNumber.Pts F E,
          P₁ ∈ EllipticRootNumber.torsion F E n → P₂ ∈ EllipticRootNumber.torsion F E n →
          Q ∈ EllipticRootNumber.torsion F E n → e (P₁ + P₂) Q = e P₁ Q * e P₂ Q) ∧
        (∀ P Q₁ Q₂ : EllipticRootNumber.Pts F E,
          P ∈ EllipticRootNumber.torsion F E n → Q₁ ∈ EllipticRootNumber.torsion F E n →
          Q₂ ∈ EllipticRootNumber.torsion F E n → e P (Q₁ + Q₂) = e P Q₁ * e P Q₂) ∧
        (∀ P : EllipticRootNumber.Pts F E, P ∈ EllipticRootNumber.torsion F E n → e P P = 1) ∧
        (∀ P : EllipticRootNumber.Pts F E, P ∈ EllipticRootNumber.torsion F E n →
          (∀ Q : EllipticRootNumber.Pts F E, Q ∈ EllipticRootNumber.torsion F E n → e P Q = 1) →
          P = 0) ∧
        (∀ (σ : EllipticRootNumber.AbsGal F) (P Q : EllipticRootNumber.Pts F E),
          P ∈ EllipticRootNumber.torsion F E n → Q ∈ EllipticRootNumber.torsion F E n →
          e (EllipticRootNumber.galHom F E σ P) (EllipticRootNumber.galHom F E σ Q) = σ (e P Q))) :
    ∃ e : ℕ → EllipticRootNumber.Pts F E → EllipticRootNumber.Pts F E → AlgebraicClosure F,
      (∀ n : ℕ, 0 < n → ∀ P₁ P₂ Q : EllipticRootNumber.Pts F E,
        P₁ ∈ EllipticRootNumber.torsion F E n → P₂ ∈ EllipticRootNumber.torsion F E n →
        Q ∈ EllipticRootNumber.torsion F E n → e n (P₁ + P₂) Q = e n P₁ Q * e n P₂ Q) ∧
      (∀ n : ℕ, 0 < n → ∀ P Q₁ Q₂ : EllipticRootNumber.Pts F E,
        P ∈ EllipticRootNumber.torsion F E n → Q₁ ∈ EllipticRootNumber.torsion F E n →
        Q₂ ∈ EllipticRootNumber.torsion F E n → e n P (Q₁ + Q₂) = e n P Q₁ * e n P Q₂) ∧
      (∀ n : ℕ, 0 < n → ∀ P : EllipticRootNumber.Pts F E,
        P ∈ EllipticRootNumber.torsion F E n → e n P P = 1) ∧
      (∀ n : ℕ, 0 < n → ∀ P : EllipticRootNumber.Pts F E,
        P ∈ EllipticRootNumber.torsion F E n →
        (∀ Q : EllipticRootNumber.Pts F E, Q ∈ EllipticRootNumber.torsion F E n → e n P Q = 1) →
        P = 0) ∧
      (∀ n : ℕ, 0 < n → ∀ (σ : EllipticRootNumber.AbsGal F) (P Q : EllipticRootNumber.Pts F E),
        P ∈ EllipticRootNumber.torsion F E n → Q ∈ EllipticRootNumber.torsion F E n →
        e n (EllipticRootNumber.galHom F E σ P) (EllipticRootNumber.galHom F E σ Q) =
          σ (e n P Q)) ∧
      (∀ m m' : ℕ, 0 < m → 0 < m' → ∀ P Q : EllipticRootNumber.Pts F E,
        P ∈ EllipticRootNumber.torsion F E (m * m') → Q ∈ EllipticRootNumber.torsion F E m →
        e (m * m') P Q = e m (m' • P) Q) :=
by
  classical
  obtain rfl : ‹DecidableEq (AlgebraicClosure F)› = (fun a b => Classical.propDecidable (a = b)) :=
    Subsingleton.elim _ _
  
  have T_koenig : ∀ {X : ℕ → Type u} [∀ n, Finite (X n)] [∀ n, Nonempty (X n)]
      (f : ∀ n, X (n + 1) → X n), ∃ x : ∀ n, X n, ∀ n, f n (x (n + 1)) = x n := by
    intro X _ _ f
    haveI : ∀ j : ℕᵒᵖ, Finite ((CategoryTheory.Functor.ofOpSequence (C := Type u) f).obj j) :=
      fun j => (inferInstance : Finite (X j.unop))
    haveI : ∀ j : ℕᵒᵖ, Nonempty ((CategoryTheory.Functor.ofOpSequence (C := Type u) f).obj j) :=
      fun j => (inferInstance : Nonempty (X j.unop))
    obtain ⟨s, hs⟩ := nonempty_sections_of_finite_inverse_system
      (CategoryTheory.Functor.ofOpSequence (C := Type u) f)
    refine ⟨fun n => s (Opposite.op n), fun n => ?_⟩
    have h := hs (CategoryTheory.homOfLE (Nat.le_succ n)).op
    rw [CategoryTheory.Functor.ofOpSequence_map_homOfLE_succ] at h
    exact h
  
  have T_trans : ∀ {A K : Type u} [AddCommGroup A] (N N' d c c' : ℕ) (_hN : N = d * c)
      (_hN' : N' = N * c') (p p' q : A → A → K)
      (_h1 : ∀ P Q : A, N • P = 0 → d • Q = 0 → p P Q = q (c • P) Q)
      (_h2 : ∀ P Q : A, N' • P = 0 → N • Q = 0 → p' P Q = p (c' • P) Q),
      ∀ P Q : A, N' • P = 0 → d • Q = 0 → p' P Q = q ((c * c') • P) Q := by
    intro A K _ N N' d c c' hN hN' p p' q h1 h2 P Q hP hQ
    have hQ' : N • Q = 0 := by rw [hN, mul_comm, ← smul_smul, hQ, smul_zero]
    have hP' : N • (c' • P) = 0 := by rw [smul_smul, ← hN', hP]
    rw [h2 P Q hP hQ', h1 _ Q hP' hQ, smul_smul]
  
  have T_unique : ∀ {A K : Type u} [AddCommGroup A] [One K]
      (_hlift : ∀ m k : ℕ, 0 < m → 0 < k → ∀ Q : A, m • Q = 0 →
        ∃ Q' : A, (m * k) • Q' = 0 ∧ k • Q' = Q)
      (N d c c' : ℕ) (_hd : 0 < d) (_hc : 0 < c) (_hN : N = d * c) (_hN' : N = d * c')
      (p q q' : A → A → K)
      (_hq : ∀ P Q : A, ¬ (d • P = 0 ∧ d • Q = 0) → q P Q = 1)
      (_hq' : ∀ P Q : A, ¬ (d • P = 0 ∧ d • Q = 0) → q' P Q = 1)
      (_h : ∀ P Q : A, N • P = 0 → d • Q = 0 → p P Q = q (c • P) Q)
      (_h' : ∀ P Q : A, N • P = 0 → d • Q = 0 → p P Q = q' (c' • P) Q), q = q' := by
    intro A K _ _ hlift N d c c' hd hc hN hN' p q q' hq hq' h h'
    have hcc : c = c' := Nat.eq_of_mul_eq_mul_left hd (hN.symm.trans hN')
    subst hcc
    subst hN
    funext P Q
    by_cases hPQ : d • P = 0 ∧ d • Q = 0
    · obtain ⟨X, hX, rfl⟩ := hlift d c hd hc P hPQ.1
      rw [← h X Q hX hPQ.2, h' X Q hX hPQ.2]
    · rw [hq P Q hPQ, hq' P Q hPQ]
  
  have T_finite : ∀ {A K ι : Type u} [AddCommGroup A] [Field K] (act : ι → A →+ A)
      (s : ι → K → K) (n : ℕ) (_hn : 0 < n) (_hfin : Set.Finite {P : A | n • P = 0}),
      Set.Finite {p : A → A → K | cpfGood act s n p} := by
    intro A K ι _ _ act s n hn hfin
    classical
    haveI : Finite {P : A | n • P = 0} := hfin.to_subtype
    let Φ : (A → A → K) → ({P : A | n • P = 0} × {P : A | n • P = 0} → K) :=
      fun p z => p z.1.1 z.2.1
    have himg : Φ '' {p | cpfGood act s n p} ⊆
        Set.univ.pi (fun _ => (Polynomial.nthRootsFinset n (1 : K) : Set K)) := by
      rintro _ ⟨p, ⟨hJ, hL, hR, hA, hND, hG⟩, rfl⟩ z -
      obtain ⟨⟨P, hP⟩, ⟨Q, hQ⟩⟩ := z
      simp only [Set.mem_setOf_eq] at hP hQ
      rw [Finset.mem_coe, Polynomial.mem_nthRootsFinset hn]
      show p P Q ^ n = 1
      have a1 : p 0 Q = 1 := by
        have := hL Q 0 Q hQ (smul_zero _) hQ
        rw [add_zero, hA Q hQ, one_mul] at this
        exact this.symm
      have a3 : ∀ k : ℕ, p (k • P) Q = p P Q ^ k := by
        intro k
        induction k with
        | zero => rw [zero_smul, a1, pow_zero]
        | succ k ih =>
          rw [succ_nsmul, hL _ _ _ (by rw [smul_comm, hP, smul_zero]) hP hQ, ih, pow_succ]
      rw [← a3 n, hP, a1]
    have hfinpi : (Set.univ.pi (fun _ : {P : A | n • P = 0} × {P : A | n • P = 0} =>
        (Polynomial.nthRootsFinset n (1 : K) : Set K))).Finite :=
      Set.Finite.pi (fun _ => Finset.finite_toSet _)
    refine Set.Finite.of_finite_image (hfinpi.subset himg) ?_
    intro p hp p' hp' hpp
    funext P Q
    by_cases h : n • P = 0 ∧ n • Q = 0
    · exact congrFun hpp (⟨P, h.1⟩, ⟨Q, h.2⟩)
    · rw [hp.1 P Q h, hp'.1 P Q h]
  
  have T_restrict : ∀ {A K ι : Type u} [AddCommGroup A] [Field K] (act : ι → A →+ A)
      (s : ι → K → K)
      (_hlift : ∀ m k : ℕ, 0 < m → 0 < k → ∀ Q : A, m • Q = 0 →
        ∃ Q' : A, (m * k) • Q' = 0 ∧ k • Q' = Q)
      (d c : ℕ) (_hd : 0 < d) (_hc : 0 < c) (p : A → A → K) (_hp : cpfGood act s (d * c) p),
      ∃ q : A → A → K, cpfGood act s d q ∧
        ∀ P Q : A, (d * c) • P = 0 → d • Q = 0 → p P Q = q (c • P) Q := by
    intro A K ι _ _ act s hlift d c hd hc p hp
    classical
    obtain ⟨-, hL, hR, hA, hND, hG⟩ := hp
    have tdN : ∀ P : A, d • P = 0 → (d * c) • P = 0 := fun P h => by
      rw [mul_comm, ← smul_smul, h, smul_zero]
    have tNd : ∀ P : A, (d * c) • P = 0 → d • (c • P) = 0 := fun P h => by
      rw [smul_smul, h]
    have tact : ∀ (k : ℕ) (σ : ι) (P : A), k • P = 0 → k • act σ P = 0 := fun k σ P h => by
      rw [← map_nsmul, h, map_zero]
    have a1 : ∀ Q : A, (d * c) • Q = 0 → p 0 Q = 1 := fun Q hQ => by
      have := hL Q 0 Q hQ (smul_zero _) hQ
      rw [add_zero, hA Q hQ, one_mul] at this
      exact this.symm
    have a2 : ∀ P : A, (d * c) • P = 0 → p P 0 = 1 := fun P hP => by
      have := hR P P 0 hP hP (smul_zero _)
      rw [add_zero, hA P hP, one_mul] at this
      exact this.symm
    have a3 : ∀ (k : ℕ) (P Q : A), (d * c) • P = 0 → (d * c) • Q = 0 →
        p (k • P) Q = p P Q ^ k := by
      intro k P Q hP hQ
      induction k with
      | zero => rw [zero_smul, a1 Q hQ, pow_zero]
      | succ k ih =>
        rw [succ_nsmul, hL _ _ _ (by rw [smul_comm, hP, smul_zero]) hP hQ, ih, pow_succ]
    have a4 : ∀ (k : ℕ) (P Q : A), (d * c) • P = 0 → (d * c) • Q = 0 →
        p P (k • Q) = p P Q ^ k := by
      intro k P Q hP hQ
      induction k with
      | zero => rw [zero_smul, a2 P hP, pow_zero]
      | succ k ih =>
        rw [succ_nsmul, hR _ _ _ hP (by rw [smul_comm, hQ, smul_zero]) hQ, ih, pow_succ]
    have hl : ∀ P' : A, ∃ X : A, d • P' = 0 → (d * c) • X = 0 ∧ c • X = P' := fun P' => by
      by_cases h : d • P' = 0
      · obtain ⟨X, hX⟩ := hlift d c hd hc P' h
        exact ⟨X, fun _ => hX⟩
      · exact ⟨0, fun h' => absurd h' h⟩
    choose lift hlift' using hl
    have indep : ∀ X₁ X₂ Q : A, (d * c) • X₁ = 0 → (d * c) • X₂ = 0 → c • X₁ = c • X₂ →
        d • Q = 0 → p X₁ Q = p X₂ Q := by
      intro X₁ X₂ Q h1 h2 h12 hQ
      obtain ⟨Q', hQ', rfl⟩ := hlift d c hd hc Q hQ
      have hD : (d * c) • (X₁ - X₂) = 0 := by rw [smul_sub, h1, h2, sub_zero]
      have hcD : c • (X₁ - X₂) = 0 := by rw [smul_sub, h12, sub_self]
      have hcQ : (d * c) • (c • Q') = 0 := tdN _ hQ
      have key : p (X₁ - X₂) (c • Q') = 1 := by
        rw [a4 c _ _ hD hQ', ← a3 c _ _ hD hQ', hcD, a1 _ hQ']
      calc p X₁ (c • Q') = p ((X₁ - X₂) + X₂) (c • Q') := by rw [sub_add_cancel]
        _ = p (X₁ - X₂) (c • Q') * p X₂ (c • Q') := hL _ _ _ hD h2 hcQ
        _ = p X₂ (c • Q') := by rw [key, one_mul]
    obtain ⟨q, hq1, hq2⟩ : ∃ q : A → A → K,
        (∀ P' Q : A, d • P' = 0 → d • Q = 0 → q P' Q = p (lift P') Q) ∧
        (∀ P Q : A, ¬ (d • P = 0 ∧ d • Q = 0) → q P Q = 1) :=
      ⟨fun P' Q => if d • P' = 0 ∧ d • Q = 0 then p (lift P') Q else 1,
        fun P' Q h1 h2 => if_pos ⟨h1, h2⟩, fun P Q h => if_neg h⟩
    refine ⟨q, ⟨hq2, ?_, ?_, ?_, ?_, ?_⟩, ?_⟩
    · intro P₁ P₂ Q hP₁ hP₂ hQ
      have hP : d • (P₁ + P₂) = 0 := by rw [smul_add, hP₁, hP₂, add_zero]
      obtain ⟨l1, l1'⟩ := hlift' P₁ hP₁
      obtain ⟨l2, l2'⟩ := hlift' P₂ hP₂
      obtain ⟨l, l'⟩ := hlift' _ hP
      rw [hq1 _ _ hP hQ, hq1 _ _ hP₁ hQ, hq1 _ _ hP₂ hQ,
        indep (lift (P₁ + P₂)) (lift P₁ + lift P₂) Q l
          (by rw [smul_add, l1, l2, add_zero]) (by rw [smul_add, l1', l2', l']) hQ]
      exact hL _ _ _ l1 l2 (tdN _ hQ)
    · intro P Q₁ Q₂ hP hQ₁ hQ₂
      have hQ : d • (Q₁ + Q₂) = 0 := by rw [smul_add, hQ₁, hQ₂, add_zero]
      rw [hq1 _ _ hP hQ, hq1 _ _ hP hQ₁, hq1 _ _ hP hQ₂]
      exact hR _ _ _ (hlift' P hP).1 (tdN _ hQ₁) (tdN _ hQ₂)
    · intro P hP
      obtain ⟨l, l'⟩ := hlift' P hP
      rw [hq1 _ _ hP hP]
      calc p (lift P) P = p (lift P) (c • lift P) := by rw [l']
        _ = 1 := by rw [a4 c _ _ l l, hA _ l, one_pow]
    · intro P hP h
      obtain ⟨l, l'⟩ := hlift' P hP
      refine hND P (tdN P hP) (fun Y hY => ?_)
      calc p P Y = p (c • lift P) Y := by rw [l']
        _ = p (lift P) (c • Y) := by rw [a3 c _ _ l hY, a4 c _ _ l hY]
        _ = q P (c • Y) := (hq1 _ _ hP (tNd _ hY)).symm
        _ = 1 := h _ (tNd _ hY)
    · intro σ P Q hP hQ
      obtain ⟨l, l'⟩ := hlift' P hP
      obtain ⟨m, m'⟩ := hlift' _ (tact d σ P hP)
      rw [hq1 _ _ (tact d σ P hP) (tact d σ Q hQ), hq1 _ _ hP hQ,
        indep (lift (act σ P)) (act σ (lift P)) (act σ Q) m (tact _ σ _ l)
          (by rw [m', ← map_nsmul, l']) (tact d σ Q hQ)]
      exact hG σ _ _ l (tdN _ hQ)
    · intro P Q hP hQ
      obtain ⟨l, l'⟩ := hlift' _ (tNd P hP)
      rw [hq1 _ _ (tNd P hP) hQ]
      exact indep _ _ Q hP l l'.symm hQ
  
  have hl' : ∀ m k : ℕ, 0 < m → 0 < k → ∀ Q : EllipticRootNumber.Pts F E, m • Q = 0 →
      ∃ Q' : EllipticRootNumber.Pts F E, (m * k) • Q' = 0 ∧ k • Q' = Q := hlift
  have restr := T_restrict (EllipticRootNumber.galHom F E)
    (fun (σ : EllipticRootNumber.AbsGal F) (z : AlgebraicClosure F) => σ z) hl'
  choose R hRgood hRrel using restr
  have hM : ∀ k : ℕ, (k + 1 + 1).factorial = (k + 1).factorial * (k + 2) := fun k => by
    rw [Nat.factorial_succ (k + 1)]; ring
  have hpos : ∀ k : ℕ, 0 < (k + 1).factorial := fun k => Nat.factorial_pos _
  have hMn : ∀ n : ℕ, 0 < n → (n - 1 + 1).factorial = n * (n - 1).factorial := fun n hn => by
    rw [Nat.sub_add_cancel hn]; exact (Nat.mul_factorial_pred hn.ne').symm
  
  have gne : ∀ n : ℕ, 0 < n → ∃ p, cpfGood (EllipticRootNumber.galHom F E)
      (fun (σ : EllipticRootNumber.AbsGal F) (z : AlgebraicClosure F) => σ z) n p := by
    intro n hn
    obtain ⟨e₀, h1, h2, h3, h4, h5⟩ := hlevel n hn
    obtain ⟨p₀, hp1, hp2⟩ : ∃ p₀ : EllipticRootNumber.Pts F E → EllipticRootNumber.Pts F E →
        AlgebraicClosure F,
        (∀ P Q, n • P = 0 → n • Q = 0 → p₀ P Q = e₀ P Q) ∧
        (∀ P Q, ¬ (n • P = 0 ∧ n • Q = 0) → p₀ P Q = 1) :=
      ⟨fun P Q => if n • P = 0 ∧ n • Q = 0 then e₀ P Q else 1, fun P Q a b => if_pos ⟨a, b⟩,
        fun P Q h => if_neg h⟩
    have tadd : ∀ P Q : EllipticRootNumber.Pts F E, n • P = 0 → n • Q = 0 → n • (P + Q) = 0 :=
      fun P Q a b => (EllipticRootNumber.torsion F E n).add_mem a b
    have tgal : ∀ (σ : EllipticRootNumber.AbsGal F) (P : EllipticRootNumber.Pts F E),
        n • P = 0 → n • EllipticRootNumber.galHom F E σ P = 0 :=
      fun σ P h => EllipticRootNumber.galHom_mem_torsion F E σ h
    refine ⟨p₀, hp2, ?_, ?_, ?_, ?_, ?_⟩
    · intro P₁ P₂ Q a b c
      rw [hp1 _ _ (tadd _ _ a b) c, hp1 _ _ a c, hp1 _ _ b c]
      exact h1 P₁ P₂ Q a b c
    · intro P Q₁ Q₂ a b c
      rw [hp1 _ _ a (tadd _ _ b c), hp1 _ _ a b, hp1 _ _ a c]
      exact h2 P Q₁ Q₂ a b c
    · intro P a
      rw [hp1 _ _ a a]
      exact h3 P a
    · intro P a h
      exact h4 P a (fun Q b => by rw [← hp1 _ _ a b]; exact h Q b)
    · intro σ P Q a b
      rw [hp1 _ _ (tgal σ P a) (tgal σ Q b), hp1 _ _ a b]
      exact h5 σ P Q a b
  
  have gfin : ∀ n : ℕ, 0 < n → Finite {p // cpfGood (EllipticRootNumber.galHom F E)
      (fun (σ : EllipticRootNumber.AbsGal F) (z : AlgebraicClosure F) => σ z) n p} := by
    intro n hn
    have hT : Set.Finite {P : EllipticRootNumber.Pts F E | n • P = 0} :=
      Set.finite_coe_iff.mp (hfin n hn)
    exact (T_finite (EllipticRootNumber.galHom F E)
      (fun (σ : EllipticRootNumber.AbsGal F) (z : AlgebraicClosure F) => σ z) n hn hT).to_subtype
  
  haveI instF : ∀ k : ℕ, Finite {p // cpfGood (EllipticRootNumber.galHom F E)
      (fun (σ : EllipticRootNumber.AbsGal F) (z : AlgebraicClosure F) => σ z)
      (k + 1).factorial p} := fun k => gfin _ (hpos k)
  haveI instN : ∀ k : ℕ, Nonempty {p // cpfGood (EllipticRootNumber.galHom F E)
      (fun (σ : EllipticRootNumber.AbsGal F) (z : AlgebraicClosure F) => σ z)
      (k + 1).factorial p} := fun k => (gne _ (hpos k)).elim fun p hp => ⟨⟨p, hp⟩⟩
  obtain ⟨x, hx⟩ := T_koenig (X := fun k => {p // cpfGood (EllipticRootNumber.galHom F E)
      (fun (σ : EllipticRootNumber.AbsGal F) (z : AlgebraicClosure F) => σ z)
      (k + 1).factorial p})
    (fun k p => ⟨R _ (k + 2) (hpos k) (by omega) p.1 (by rw [← hM k]; exact p.2),
      hRgood _ (k + 2) (hpos k) (by omega) p.1 (by rw [← hM k]; exact p.2)⟩)
  have hxrel : ∀ (k : ℕ) (P Q : EllipticRootNumber.Pts F E),
      ((k + 1).factorial * (k + 2)) • P = 0 → (k + 1).factorial • Q = 0 →
      (x (k + 1)).1 P Q = (x k).1 ((k + 2) • P) Q := by
    intro k P Q hP hQ
    rw [← hx k]
    exact hRrel _ _ _ _ _ _ P Q hP hQ
  have tel : ∀ j k : ℕ, j ≤ k → ∃ c : ℕ, 0 < c ∧ (k + 1).factorial = (j + 1).factorial * c ∧
      ∀ P Q : EllipticRootNumber.Pts F E, (k + 1).factorial • P = 0 →
        (j + 1).factorial • Q = 0 → (x k).1 P Q = (x j).1 (c • P) Q := by
    intro j k hjk
    induction k, hjk using Nat.le_induction with
    | base => exact ⟨1, one_pos, (mul_one _).symm, fun P Q _ _ => by rw [one_nsmul]⟩
    | succ k _ ih =>
      obtain ⟨c, hc, hck, hrel⟩ := ih
      refine ⟨c * (k + 2), Nat.mul_pos hc (by omega), by rw [hM k, hck, mul_assoc], ?_⟩
      exact T_trans _ _ _ c (k + 2) hck (hM k) _ _ _ hrel
        (fun P Q hP hQ => hxrel k P Q (by rw [← hM k]; exact hP) hQ)
  
  have hxg : ∀ n (hn : 0 < n), cpfGood (EllipticRootNumber.galHom F E)
      (fun (σ : EllipticRootNumber.AbsGal F) (z : AlgebraicClosure F) => σ z)
      (n * (n - 1).factorial) (x (n - 1)).1 := fun n hn => by
    rw [← hMn n hn]; exact (x (n - 1)).2
  obtain ⟨e, hegood, herel⟩ : ∃ e : ℕ → EllipticRootNumber.Pts F E →
      EllipticRootNumber.Pts F E → AlgebraicClosure F,
      (∀ n, 0 < n → cpfGood (EllipticRootNumber.galHom F E)
        (fun (σ : EllipticRootNumber.AbsGal F) (z : AlgebraicClosure F) => σ z) n (e n)) ∧
      (∀ n, 0 < n → ∀ P Q : EllipticRootNumber.Pts F E, (n * (n - 1).factorial) • P = 0 →
        n • Q = 0 → (x (n - 1)).1 P Q = e n ((n - 1).factorial • P) Q) :=
    ⟨fun n => if h : 0 < n then R n (n - 1).factorial h (Nat.factorial_pos _) (x (n - 1)).1
        (hxg n h) else fun _ _ => 1,
      fun n h => by simp only [h, ↓reduceDIte]; exact hRgood _ _ _ _ _ _,
      fun n h => by simp only [h, ↓reduceDIte]; exact hRrel _ _ _ _ _ _⟩
  refine ⟨e, fun n hn => (hegood n hn).2.1, fun n hn => (hegood n hn).2.2.1,
    fun n hn => (hegood n hn).2.2.2.1, fun n hn => (hegood n hn).2.2.2.2.1,
    fun n hn => (hegood n hn).2.2.2.2.2, ?_⟩
  
  intro m m' hm hm' P Q hP hQ
  have hn : 0 < m * m' := Nat.mul_pos hm hm'
  have hrg := hRgood m m' hm hm' (e (m * m')) (hegood _ hn)
  have hrr := hRrel m m' hm hm' (e (m * m')) (hegood _ hn)
  set r := R m m' hm hm' (e (m * m')) (hegood _ hn) with hr
  rw [hrr P Q hP hQ]
  obtain ⟨c₁, hc₁, hMc, hT⟩ := tel (m - 1) (m * m' - 1)
    (by have h1 : m * 1 ≤ m * m' := Nat.mul_le_mul_left m hm'; omega)
  have relA := T_trans (m * m') (m * m' - 1 + 1).factorial m m' (m * m' - 1).factorial rfl
    (hMn _ hn) (e (m * m')) (x (m * m' - 1)).1 r hrr
    (fun P Q hP hQ => herel _ hn P Q (by rw [← hMn _ hn]; exact hP) hQ)
  have relB := T_trans (m - 1 + 1).factorial (m * m' - 1 + 1).factorial m (m - 1).factorial c₁
    (hMn m hm) hMc (x (m - 1)).1 (x (m * m' - 1)).1 (e m)
    (fun P Q hP hQ => herel m hm P Q (by rw [← hMn m hm]; exact hP) hQ) hT
  have huniq := T_unique hl' (m * m' - 1 + 1).factorial m (m' * (m * m' - 1).factorial)
    ((m - 1).factorial * c₁) hm (Nat.mul_pos hm' (Nat.factorial_pos _))
    (by rw [hMn _ hn, mul_assoc]) (by rw [hMc, hMn m hm, mul_assoc])
    (x (m * m' - 1)).1 r (e m) hrg.1 (hegood m hm).1 relA relB
  rw [huniq]

theorem pts_nsmul_surjective (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] [DecidableEq (AlgebraicClosure F)]
    (E : WeierstrassCurve F) (hΔ : E.Δ ≠ 0)
    (n : ℕ) (hn : 0 < n) (Q : EllipticRootNumber.Pts F E) :
    ∃ P : EllipticRootNumber.Pts F E, n • P = Q :=
by
  have hW : (E.baseChange (AlgebraicClosure F)).Δ ≠ 0 := by
    rw [WeierstrassCurve.baseChange, WeierstrassCurve.map_Δ]
    exact (map_ne_zero _).mpr hΔ
  have key : ∀ W : WeierstrassCurve (AlgebraicClosure F), W.Δ ≠ 0 →
      ∀ Q : W.toAffine.Point, ∃ P : W.toAffine.Point, n • P = Q := by
    intro W hW Q
    have exists_pt : ∀ t : AlgebraicClosure F, ∃ y : AlgebraicClosure F,
        W.toAffine.Nonsingular t y := by
      intro t
      obtain ⟨y, hy⟩ := IsAlgClosed.exists_root
        (Polynomial.C (1 : AlgebraicClosure F) * Polynomial.X ^ 2
          + Polynomial.C (W.a₁ * t + W.a₃) * Polynomial.X
          + Polynomial.C (-(t ^ 3 + W.a₂ * t ^ 2 + W.a₄ * t + W.a₆)))
        (by rw [Polynomial.degree_quadratic one_ne_zero]; decide)
      refine ⟨y, (WeierstrassCurve.Affine.equation_iff_nonsingular_of_Δ_ne_zero hW).mp ?_⟩
      rw [WeierstrassCurve.Affine.equation_iff]
      simp only [Polynomial.IsRoot, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
        Polynomial.eval_pow, Polynomial.eval_X] at hy
      linear_combination hy
    have pt : ∀ R : W.toAffine.Point, R = 0 ∨
        ∃ (a b : AlgebraicClosure F) (h : W.toAffine.Nonsingular a b),
          R = WeierstrassCurve.Affine.Point.some h := by
      intro R
      cases R with
      | zero => exact Or.inl rfl
      | some h => exact Or.inr ⟨_, _, h, rfl⟩
    cases Q with
    | zero => exact ⟨0, by rw [nsmul_zero]; rfl⟩
    | @some x₀ y₀ h₀ =>
      obtain ⟨hXd, -, hZd', -⟩ := ladderXZ_degree W n hn
      have hm : 0 < n ^ 2 := pow_pos hn 2
      have hZd : (ladderXZ W n).2.natDegree < n ^ 2 := by rw [hZd']; omega
      have hfd : ((ladderXZ W n).1 - Polynomial.C x₀ * (ladderXZ W n).2).natDegree = n ^ 2 := by
        rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt]
        · exact hXd
        · rw [hXd]
          exact lt_of_le_of_lt (Polynomial.natDegree_C_mul_le _ _) hZd
      have hf0 : (ladderXZ W n).1 - Polynomial.C x₀ * (ladderXZ W n).2 ≠ 0 := by
        intro h0
        rw [h0, Polynomial.natDegree_zero] at hfd
        omega
      have hfdeg : ((ladderXZ W n).1 - Polynomial.C x₀ * (ladderXZ W n).2).degree ≠ 0 := by
        rw [Polynomial.degree_eq_natDegree hf0, hfd]
        exact_mod_cast hm.ne'
      obtain ⟨t, ht⟩ := IsAlgClosed.exists_root _ hfdeg
      have ht' : (ladderXZ W n).1.eval t = x₀ * (ladderXZ W n).2.eval t := by
        have h0 : ((ladderXZ W n).1 - Polynomial.C x₀ * (ladderXZ W n).2).eval t = 0 := ht
        rw [Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_C] at h0
        exact sub_eq_zero.mp h0
      have hZt : (ladderXZ W n).2.eval t ≠ 0 := by
        intro h0
        exact ladderXZ_no_common_root W hW n hn t ⟨by rw [ht', h0, mul_zero], h0⟩
      obtain ⟨y₁, h₁⟩ := exists_pt t
      obtain ⟨hz, hs⟩ := ladderXZ_eval_nsmul W n hn h₁
      rcases pt (n • WeierstrassCurve.Affine.Point.some h₁) with hR | ⟨x', y', h', hR⟩
      · exact absurd (hz hR) hZt
      · have e := hs h' hR
        have hx : x' = x₀ := by
          have h2 : (x' - x₀) * (ladderXZ W n).2.eval t = 0 := by linear_combination ht' - e
          exact sub_eq_zero.mp ((mul_eq_zero.mp h2).resolve_right hZt)
        subst hx
        rcases WeierstrassCurve.Affine.Y_eq_of_X_eq h'.1 h₀.1 rfl with hy | hy
        · subst hy
          exact ⟨_, hR⟩
        · subst hy
          refine ⟨-WeierstrassCurve.Affine.Point.some h₁, ?_⟩
          rw [neg_nsmul, hR, WeierstrassCurve.Affine.Point.neg_some]
          simp only [WeierstrassCurve.Affine.negY_negY]
  exact key _ hW Q

theorem exists_weilPairing (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] [DecidableEq (AlgebraicClosure F)]
    (E : WeierstrassCurve F) (hΔ : E.Δ ≠ 0) :
    ∃ e : ℕ → EllipticRootNumber.Pts F E → EllipticRootNumber.Pts F E → AlgebraicClosure F,
      (∀ n : ℕ, 0 < n → ∀ P₁ P₂ Q : EllipticRootNumber.Pts F E,
        P₁ ∈ EllipticRootNumber.torsion F E n → P₂ ∈ EllipticRootNumber.torsion F E n →
        Q ∈ EllipticRootNumber.torsion F E n → e n (P₁ + P₂) Q = e n P₁ Q * e n P₂ Q) ∧
      (∀ n : ℕ, 0 < n → ∀ P Q₁ Q₂ : EllipticRootNumber.Pts F E,
        P ∈ EllipticRootNumber.torsion F E n → Q₁ ∈ EllipticRootNumber.torsion F E n →
        Q₂ ∈ EllipticRootNumber.torsion F E n → e n P (Q₁ + Q₂) = e n P Q₁ * e n P Q₂) ∧
      (∀ n : ℕ, 0 < n → ∀ P : EllipticRootNumber.Pts F E,
        P ∈ EllipticRootNumber.torsion F E n → e n P P = 1) ∧
      (∀ n : ℕ, 0 < n → ∀ P : EllipticRootNumber.Pts F E,
        P ∈ EllipticRootNumber.torsion F E n →
        (∀ Q : EllipticRootNumber.Pts F E, Q ∈ EllipticRootNumber.torsion F E n → e n P Q = 1) →
        P = 0) ∧
      (∀ n : ℕ, 0 < n → ∀ (σ : EllipticRootNumber.AbsGal F) (P Q : EllipticRootNumber.Pts F E),
        P ∈ EllipticRootNumber.torsion F E n → Q ∈ EllipticRootNumber.torsion F E n →
        e n (EllipticRootNumber.galHom F E σ P) (EllipticRootNumber.galHom F E σ Q) =
          σ (e n P Q)) ∧
      (∀ m m' : ℕ, 0 < m → 0 < m' → ∀ P Q : EllipticRootNumber.Pts F E,
        P ∈ EllipticRootNumber.torsion F E (m * m') → Q ∈ EllipticRootNumber.torsion F E m →
        e (m * m') P Q = e m (m' • P) Q) :=
by
  classical
  obtain rfl : ‹DecidableEq (AlgebraicClosure F)› = (fun a b => Classical.propDecidable (a = b)) :=
    Subsingleton.elim _ _
  
  obtain ⟨ord, τ, γ, hmul, hconst, hdeg, hpole, hAJ, hRR, htr, hτ, hγc, hγo, hγτ⟩ :=
    exists_ellipticDivisorCalculus F E hΔ
  
  have hcard : ∀ n : ℕ, 0 < n → Nat.card (EllipticRootNumber.torsion F E n) = n ^ 2 := by
    intro n hn
    haveI : CharZero (AlgebraicClosure F) :=
      charZero_of_injective_algebraMap (algebraMap F (AlgebraicClosure F)).injective
    have hW : (E.baseChange (AlgebraicClosure F)).Δ ≠ 0 := by
      show (E.map (algebraMap F (AlgebraicClosure F))).Δ ≠ 0
      rw [WeierstrassCurve.map_Δ]
      exact (map_ne_zero _).mpr hΔ
    obtain ⟨h1, h2, h3, h4⟩ := ladderXZ_degree (E.baseChange (AlgebraicClosure F)) n hn
    have hZ0 : (ladderXZ (E.baseChange (AlgebraicClosure F)) n).2 ≠ 0 := by
      intro h
      rw [h, Polynomial.leadingCoeff_zero] at h4
      exact (pow_ne_zero 2 (Nat.cast_ne_zero.mpr hn.ne')) h4.symm
    have hZd : (ladderXZ (E.baseChange (AlgebraicClosure F)) n).2.natDegree < n ^ 2 := by
      rw [h3]
      have : 0 < n ^ 2 := by positivity
      omega
    have key := card_nsmul_eq_zero_of_xz_polys (E.baseChange (AlgebraicClosure F)) hW n hn
      (ladderXZ (E.baseChange (AlgebraicClosure F)) n).1
      (ladderXZ (E.baseChange (AlgebraicClosure F)) n).2 h1 h2 hZ0 hZd
      (fun h hP => (ladderXZ_eval_nsmul (E.baseChange (AlgebraicClosure F)) n hn h).1 hP)
      (fun h h' hP => (ladderXZ_eval_nsmul (E.baseChange (AlgebraicClosure F)) n hn h).2 h' hP)
      (ladderXZ_no_common_root (E.baseChange (AlgebraicClosure F)) hW n hn)
    exact key
  have hfin : ∀ n : ℕ, 0 < n → Finite (EllipticRootNumber.torsion F E n) := fun n hn =>
    Nat.finite_of_card_ne_zero (by rw [hcard n hn]; positivity)
  
  have hlift : ∀ m k : ℕ, 0 < m → 0 < k → ∀ Q : EllipticRootNumber.Pts F E,
      Q ∈ EllipticRootNumber.torsion F E m →
      ∃ Q', Q' ∈ EllipticRootNumber.torsion F E (m * k) ∧ k • Q' = Q := by
    intro m k _ hk Q hQ
    obtain ⟨Q', hQ'⟩ := pts_nsmul_surjective F E hΔ k hk Q
    refine ⟨Q', ?_, hQ'⟩
    rw [EllipticRootNumber.mem_torsion] at hQ ⊢
    rw [← smul_smul, hQ', hQ]
  
  refine exists_compatible_pairing_family F E hfin hlift (fun n hn => ?_)
  obtain ⟨e, hl, hr, halt, hgal, hiso⟩ := exists_levelPairing_of_divisorCalculus F E ord τ γ
    hmul hconst hdeg hpole hAJ hRR htr hτ hγc hγo hγτ n hn
  exact ⟨e, hl, hr, halt,
    nondegenerate_of_isotropic_card_le (EllipticRootNumber.torsion F E n) n hn (hcard n hn) e
      hl hr halt (fun I hI hI' => hiso I (fun P hP => hI hP) hI'), hgal⟩

theorem weilPairing_tateBasis_ne_one (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [DecidableEq (AlgebraicClosure F)]
    (E : WeierstrassCurve F)
    (e : ℕ → EllipticRootNumber.Pts F E → EllipticRootNumber.Pts F E → AlgebraicClosure F)
    (he_addl : ∀ n : ℕ, 0 < n → ∀ P₁ P₂ Q : EllipticRootNumber.Pts F E,
      P₁ ∈ EllipticRootNumber.torsion F E n → P₂ ∈ EllipticRootNumber.torsion F E n →
      Q ∈ EllipticRootNumber.torsion F E n → e n (P₁ + P₂) Q = e n P₁ Q * e n P₂ Q)
    (he_addr : ∀ n : ℕ, 0 < n → ∀ P Q₁ Q₂ : EllipticRootNumber.Pts F E,
      P ∈ EllipticRootNumber.torsion F E n → Q₁ ∈ EllipticRootNumber.torsion F E n →
      Q₂ ∈ EllipticRootNumber.torsion F E n → e n P (Q₁ + Q₂) = e n P Q₁ * e n P Q₂)
    (he_self : ∀ n : ℕ, 0 < n → ∀ P : EllipticRootNumber.Pts F E,
      P ∈ EllipticRootNumber.torsion F E n → e n P P = 1)
    (he_nondeg : ∀ n : ℕ, 0 < n → ∀ P : EllipticRootNumber.Pts F E,
      P ∈ EllipticRootNumber.torsion F E n →
      (∀ Q : EllipticRootNumber.Pts F E, Q ∈ EllipticRootNumber.torsion F E n → e n P Q = 1) →
      P = 0)
    (hsurj : ∀ P : EllipticRootNumber.Pts F E,
      P ∈ EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1)) →
      ∃ x : EllipticRootNumber.tateModule F E,
        (((x : ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0 :
          EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) :
            EllipticRootNumber.Pts F E) = P)
    (b : Module.Basis (Fin 2) ℤ_[EllipticRootNumber.ell F] (EllipticRootNumber.tateModule F E)) :
    e (EllipticRootNumber.ell F ^ (0 + 1))
      ((((b 0 : EllipticRootNumber.tateModule F E) :
        ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0 :
          EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) :
            EllipticRootNumber.Pts F E)
      ((((b 1 : EllipticRootNumber.tateModule F E) :
        ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0 :
          EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) :
            EllipticRootNumber.Pts F E) ≠ 1 :=
by
  have hinst : ‹DecidableEq (AlgebraicClosure F)› =
      (fun a b => Classical.propDecidable (a = b)) := Subsingleton.elim _ _
  subst hinst
  classical
  have hℓ : (EllipticRootNumber.ell F).Prime := Fact.out
  have hN : 0 < EllipticRootNumber.ell F ^ (0 + 1) := pow_pos hℓ.pos _
  have addl := he_addl _ hN
  have addr := he_addr _ hN
  have hself := he_self _ hN
  have nondeg := he_nondeg _ hN
  
  have hU : ∀ P Q : EllipticRootNumber.Pts F E,
      P ∈ EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1)) →
      Q ∈ EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1)) →
      e (EllipticRootNumber.ell F ^ (0 + 1)) P Q * e (EllipticRootNumber.ell F ^ (0 + 1)) Q P = 1 := by
    intro P Q hP hQ
    have hPQ := add_mem hP hQ
    have h1 := hself _ hPQ
    rw [addl P Q _ hP hQ hPQ, addr P P Q hP hP hQ, addr Q P Q hQ hP hQ, hself P hP,
      hself Q hQ] at h1
    simpa [mul_comm] using h1
  
  have hZ : ∀ P : EllipticRootNumber.Pts F E,
      P ∈ EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1)) →
      e (EllipticRootNumber.ell F ^ (0 + 1)) P 0 = 1 := by
    intro P hP
    have h0 : (0 : EllipticRootNumber.Pts F E) ∈
        EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1)) := zero_mem _
    have hne : e (EllipticRootNumber.ell F ^ (0 + 1)) P 0 ≠ 0 :=
      left_ne_zero_of_mul_eq_one (hU P 0 hP h0)
    have h2 : e (EllipticRootNumber.ell F ^ (0 + 1)) P 0 =
        e (EllipticRootNumber.ell F ^ (0 + 1)) P 0 * e (EllipticRootNumber.ell F ^ (0 + 1)) P 0 := by
      have h3 := addr P 0 0 hP h0 h0
      rw [add_zero] at h3
      exact h3
    exact (left_eq_mul₀ hne).mp h2
  
  have hpow : ∀ P Q : EllipticRootNumber.Pts F E,
      P ∈ EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1)) →
      Q ∈ EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1)) →
      ∀ m : ℕ, e (EllipticRootNumber.ell F ^ (0 + 1)) P (m • Q) =
        e (EllipticRootNumber.ell F ^ (0 + 1)) P Q ^ m := by
    intro P Q hP hQ m
    induction m with
    | zero => rw [zero_nsmul, pow_zero]; exact hZ P hP
    | succ m ih =>
      rw [succ_nsmul, addr P _ _ hP (AddSubgroup.nsmul_mem _ hQ m) hQ, ih,
        pow_succ (e (EllipticRootNumber.ell F ^ (0 + 1)) P Q) m]
  
  have hdec : ∀ x : EllipticRootNumber.tateModule F E, ∃ m₀ m₁ : ℕ,
      (((x : ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0 :
          EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) :
            EllipticRootNumber.Pts F E) =
        m₀ • ((((b 0 : EllipticRootNumber.tateModule F E) :
            ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0 :
              EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) :
                EllipticRootNumber.Pts F E) +
        m₁ • ((((b 1 : EllipticRootNumber.tateModule F E) :
            ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0 :
              EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) :
                EllipticRootNumber.Pts F E) := by
    intro x
    have hx := (b.sum_repr x).symm
    rw [Fin.sum_univ_two] at hx
    generalize b.repr x 0 = c₀ at hx
    generalize b.repr x 1 = c₁ at hx
    subst hx
    refine ⟨(PadicInt.toZModPow (0 + 1) c₀).val, (PadicInt.toZModPow (0 + 1) c₁).val, ?_⟩
    change ((c₀ • ((b 0 : EllipticRootNumber.tateModule F E) :
            ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0 +
          c₁ • ((b 1 : EllipticRootNumber.tateModule F E) :
            ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0 :
          EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) :
            EllipticRootNumber.Pts F E) = _
    rw [AddSubgroup.coe_add, EllipticRootNumber.padic_smul_torsion,
      EllipticRootNumber.padic_smul_torsion]
  have hP₀m : ((((b 0 : EllipticRootNumber.tateModule F E) :
      ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0 :
        EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) :
          EllipticRootNumber.Pts F E) ∈
      EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1)) :=
    (((b 0 : EllipticRootNumber.tateModule F E) :
      ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0).2
  have hP₁m : ((((b 1 : EllipticRootNumber.tateModule F E) :
      ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0 :
        EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) :
          EllipticRootNumber.Pts F E) ∈
      EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1)) :=
    (((b 1 : EllipticRootNumber.tateModule F E) :
      ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0).2
  generalize hP₀ : ((((b 0 : EllipticRootNumber.tateModule F E) :
      ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0 :
        EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) :
          EllipticRootNumber.Pts F E) = P₀ at hdec hP₀m ⊢
  generalize hP₁ : ((((b 1 : EllipticRootNumber.tateModule F E) :
      ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0 :
        EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) :
          EllipticRootNumber.Pts F E) = P₁ at hdec hP₁m ⊢
  intro h01
  have hspan : ∀ Q : EllipticRootNumber.Pts F E,
      Q ∈ EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1)) →
      ∃ m₀ m₁ : ℕ, Q = m₀ • P₀ + m₁ • P₁ := by
    intro Q hQ
    obtain ⟨x, hx⟩ := hsurj Q hQ
    obtain ⟨m₀, m₁, h⟩ := hdec x
    exact ⟨m₀, m₁, hx.symm.trans h⟩
  have h0 : P₀ = 0 := by
    apply nondeg P₀ hP₀m
    intro Q hQ
    obtain ⟨m₀, m₁, rfl⟩ := hspan Q hQ
    rw [addr P₀ _ _ hP₀m (AddSubgroup.nsmul_mem _ hP₀m m₀) (AddSubgroup.nsmul_mem _ hP₁m m₁),
      hpow P₀ P₀ hP₀m hP₀m, hpow P₀ P₁ hP₀m hP₁m, hself P₀ hP₀m, h01, one_pow, one_pow, one_mul]
  have h1 : P₁ = 0 := by
    apply nondeg P₁ hP₁m
    intro Q hQ
    obtain ⟨m₀, m₁, rfl⟩ := hspan Q hQ
    rw [h0, nsmul_zero, zero_add (m₁ • P₁), hpow P₁ P₁ hP₁m hP₁m, hself P₁ hP₁m, one_pow]
  have htriv : ∀ Q : EllipticRootNumber.Pts F E,
      Q ∈ EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1)) → Q = 0 := by
    intro Q hQ
    obtain ⟨m₀, m₁, rfl⟩ := hspan Q hQ
    rw [h0, h1, nsmul_zero, nsmul_zero, add_zero]
  have hkill : ∀ k : ℕ, ∀ R : EllipticRootNumber.Pts F E,
      EllipticRootNumber.ell F ^ (k + 1) • R = 0 → R = 0 := by
    intro k
    induction k with
    | zero => intro R hR; exact htriv R ((EllipticRootNumber.mem_torsion F E).mpr hR)
    | succ k ih =>
      intro R hR
      have h' : EllipticRootNumber.ell F ^ (k + 1) • (EllipticRootNumber.ell F • R) = 0 := by
        rw [smul_smul, ← pow_succ]
        exact hR
      have h'' := ih _ h'
      apply htriv R
      rw [EllipticRootNumber.mem_torsion, zero_add, pow_one]
      exact h''
  have hb0 : b 0 = 0 := by
    apply Subtype.ext
    funext n
    apply Subtype.ext
    have := hkill n _ ((EllipticRootNumber.mem_torsion F E).mp
      (((b 0 : EllipticRootNumber.tateModule F E) :
        ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) n).2)
    rw [this]
    rfl
  exact b.ne_zero 0 hb0

theorem det_tateRep_eq_one_of_weilPairing (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [DecidableEq (AlgebraicClosure F)]
    (E : WeierstrassCurve F)
    (e : ℕ → EllipticRootNumber.Pts F E → EllipticRootNumber.Pts F E → AlgebraicClosure F)
    (he_addl : ∀ n : ℕ, 0 < n → ∀ P₁ P₂ Q : EllipticRootNumber.Pts F E,
      P₁ ∈ EllipticRootNumber.torsion F E n → P₂ ∈ EllipticRootNumber.torsion F E n →
      Q ∈ EllipticRootNumber.torsion F E n → e n (P₁ + P₂) Q = e n P₁ Q * e n P₂ Q)
    (he_addr : ∀ n : ℕ, 0 < n → ∀ P Q₁ Q₂ : EllipticRootNumber.Pts F E,
      P ∈ EllipticRootNumber.torsion F E n → Q₁ ∈ EllipticRootNumber.torsion F E n →
      Q₂ ∈ EllipticRootNumber.torsion F E n → e n P (Q₁ + Q₂) = e n P Q₁ * e n P Q₂)
    (he_self : ∀ n : ℕ, 0 < n → ∀ P : EllipticRootNumber.Pts F E,
      P ∈ EllipticRootNumber.torsion F E n → e n P P = 1)
    (he_gal : ∀ n : ℕ, 0 < n → ∀ (σ : EllipticRootNumber.AbsGal F) (P Q : EllipticRootNumber.Pts F E),
      P ∈ EllipticRootNumber.torsion F E n → Q ∈ EllipticRootNumber.torsion F E n →
      e n (EllipticRootNumber.galHom F E σ P) (EllipticRootNumber.galHom F E σ Q) =
        σ (e n P Q))
    (he_compat : ∀ m m' : ℕ, 0 < m → 0 < m' → ∀ P Q : EllipticRootNumber.Pts F E,
      P ∈ EllipticRootNumber.torsion F E (m * m') → Q ∈ EllipticRootNumber.torsion F E m →
      e (m * m') P Q = e m (m' • P) Q)
    (b : Module.Basis (Fin 2) ℤ_[EllipticRootNumber.ell F] (EllipticRootNumber.tateModule F E))
    (hne : e (EllipticRootNumber.ell F ^ (0 + 1))
      ((((b 0 : EllipticRootNumber.tateModule F E) :
        ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0 :
          EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) :
            EllipticRootNumber.Pts F E)
      ((((b 1 : EllipticRootNumber.tateModule F E) :
        ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0 :
          EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) :
            EllipticRootNumber.Pts F E) ≠ 1)
    (σ : EllipticRootNumber.AbsGal F) (hσ : σ ∈ EllipticRootNumber.inertia F) :
    LinearMap.det (EllipticRootNumber.tateRep F E σ) = 1 :=
by
  rename_i hdec
  obtain rfl : hdec = (fun a b => Classical.propDecidable (a = b)) := Subsingleton.elim _ _
  classical
  have hℓp : (EllipticRootNumber.ell F).Prime := Fact.out
  
  have alg : ∀ N : ℕ, 0 < N → ∀ P Q : EllipticRootNumber.Pts F E,
      P ∈ EllipticRootNumber.torsion F E N → Q ∈ EllipticRootNumber.torsion F E N →
      (∀ n : ℕ, e N (n • P) Q = e N P Q ^ n) ∧ (∀ n : ℕ, e N P (n • Q) = e N P Q ^ n) ∧
      (∀ a b' c d : ℕ, e N (a • P + c • Q) (b' • P + d • Q) * e N P Q ^ (c * b') =
        e N P Q ^ (a * d)) := by
    intro N hN P Q hP hQ
    have z1 : ∀ X, X ∈ EllipticRootNumber.torsion F E N → e N 0 X = 1 := by
      intro X hX
      have h := he_addl N hN X 0 X hX (zero_mem _) hX
      rw [add_zero, he_self N hN X hX, one_mul] at h
      exact h.symm
    have z2 : ∀ X, X ∈ EllipticRootNumber.torsion F E N → e N X 0 = 1 := by
      intro X hX
      have h := he_addr N hN X X 0 hX hX (zero_mem _)
      rw [add_zero, he_self N hN X hX, one_mul] at h
      exact h.symm
    have L : ∀ X Y, X ∈ EllipticRootNumber.torsion F E N → Y ∈ EllipticRootNumber.torsion F E N →
        ∀ n : ℕ, e N (n • X) Y = e N X Y ^ n := by
      intro X Y hX hY n
      induction n with
      | zero => rw [zero_nsmul, pow_zero, z1 Y hY]
      | succ n ih =>
        rw [succ_nsmul, he_addl N hN _ _ _ (AddSubgroup.nsmul_mem _ hX n) hX hY, ih, pow_succ]
    have R : ∀ X Y, X ∈ EllipticRootNumber.torsion F E N → Y ∈ EllipticRootNumber.torsion F E N →
        ∀ n : ℕ, e N X (n • Y) = e N X Y ^ n := by
      intro X Y hX hY n
      induction n with
      | zero => rw [zero_nsmul, pow_zero, z2 X hX]
      | succ n ih =>
        rw [succ_nsmul, he_addr N hN _ _ _ hX (AddSubgroup.nsmul_mem _ hY n) hY, ih, pow_succ]
    have anti : e N Q P * e N P Q = 1 := by
      have h := he_self N hN (P + Q) (add_mem hP hQ)
      rw [he_addl N hN _ _ _ hP hQ (add_mem hP hQ), he_addr N hN _ _ _ hP hP hQ,
        he_addr N hN _ _ _ hQ hP hQ, he_self N hN P hP, he_self N hN Q hQ, one_mul, mul_one,
        mul_comm] at h
      exact h
    refine ⟨L P Q hP hQ, R P Q hP hQ, ?_⟩
    intro a b' c d
    have haP := AddSubgroup.nsmul_mem _ hP a
    have hbP := AddSubgroup.nsmul_mem _ hP b'
    have hcQ := AddSubgroup.nsmul_mem _ hQ c
    have hdQ := AddSubgroup.nsmul_mem _ hQ d
    rw [he_addl N hN _ _ _ haP hcQ (add_mem hbP hdQ), he_addr N hN _ _ _ haP hbP hdQ,
      he_addr N hN _ _ _ hcQ hbP hdQ, L P _ hP hbP a, L P _ hP hdQ a, L Q _ hQ hbP c,
      L Q _ hQ hdQ c, R P P hP hP b', R P Q hP hQ d, R Q P hQ hP b', R Q Q hQ hQ d,
      he_self N hN P hP, he_self N hN Q hQ, one_pow, one_pow, one_pow, one_pow, one_mul, mul_one,
      ← pow_mul, ← pow_mul, mul_comm d a, mul_comm b' c, mul_assoc, ← mul_pow, anti, one_pow,
      mul_one]
  
  have hfix : ∀ k : ℕ, ∀ ζ : AlgebraicClosure F,
      ζ ^ (EllipticRootNumber.ell F ^ (k + 1)) = 1 → σ ζ = ζ := by
    intro k ζ hζ
    have hpos : 0 < EllipticRootNumber.ell F ^ (k + 1) := pow_pos hℓp.pos _
    have hndvd : ¬ EllipticRootNumber.p F ∣ EllipticRootNumber.ell F ^ (k + 1) := by
      intro hd
      unfold EllipticRootNumber.p at hd
      rcases CharP.char_is_prime_or_zero
          (IsLocalRing.ResidueField (ValuativeRel.valuation F).integer)
          (ringChar (IsLocalRing.ResidueField (ValuativeRel.valuation F).integer)) with hp | hp
      · have := (Nat.prime_dvd_prime_iff_eq hp hℓp).mp (hp.dvd_of_dvd_pow hd)
        exact EllipticRootNumber.ell_ne_p F this.symm
      · rw [hp, zero_dvd_iff] at hd
        omega
    have hmem : ζ ∈ EllipticRootNumber.unramifiedClosure F :=
      IntermediateField.subset_adjoin F _ ⟨EllipticRootNumber.ell F ^ (k + 1), hpos, hndvd, hζ⟩
    exact (IntermediateField.mem_fixingSubgroup_iff _ σ).mp hσ ζ hmem
  
  have hiter : ∀ x : EllipticRootNumber.tateModule F E, ∀ k : ℕ,
      EllipticRootNumber.ell F ^ k •
        (((x : ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) k :
          EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E) =
      (((x : ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0 :
          EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E) := by
    intro x k
    induction k with
    | zero => rw [pow_zero, one_nsmul]
    | succ k ih =>
      rw [pow_succ, ← smul_smul]
      have h := x.2 k
      rw [← ih]
      exact congrArg (fun Q => EllipticRootNumber.ell F ^ k • Q) h
  
  have hbasis : ∀ j : Fin 2, EllipticRootNumber.tateRep F E σ (b j) =
      LinearMap.toMatrix b b (EllipticRootNumber.tateRep F E σ) 0 j • b 0 +
        LinearMap.toMatrix b b (EllipticRootNumber.tateRep F E σ) 1 j • b 1 := by
    intro j
    have h := b.sum_repr (EllipticRootNumber.tateRep F E σ (b j))
    rw [Fin.sum_univ_two] at h
    rw [LinearMap.toMatrix_apply, LinearMap.toMatrix_apply]
    exact h.symm
  have hlev : ∀ (k : ℕ) (j : Fin 2), EllipticRootNumber.galHom F E σ
      ((((b j : EllipticRootNumber.tateModule F E) :
        ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) k :
          EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1))) :
            EllipticRootNumber.Pts F E) =
      (PadicInt.toZModPow (k + 1)
          (LinearMap.toMatrix b b (EllipticRootNumber.tateRep F E σ) 0 j)).val •
        ((((b 0 : EllipticRootNumber.tateModule F E) :
          ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) k :
            EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1))) :
              EllipticRootNumber.Pts F E) +
      (PadicInt.toZModPow (k + 1)
          (LinearMap.toMatrix b b (EllipticRootNumber.tateRep F E σ) 1 j)).val •
        ((((b 1 : EllipticRootNumber.tateModule F E) :
          ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) k :
            EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1))) :
              EllipticRootNumber.Pts F E) := by
    intro k j
    have h1 : EllipticRootNumber.galHom F E σ
        ((((b j : EllipticRootNumber.tateModule F E) :
          ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) k :
            EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1))) :
              EllipticRootNumber.Pts F E) =
        ((((EllipticRootNumber.tateRep F E σ (b j) : EllipticRootNumber.tateModule F E) :
          ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) k :
            EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1))) :
              EllipticRootNumber.Pts F E) := rfl
    have hadd : ∀ x y : EllipticRootNumber.tateModule F E,
        ((((x + y : EllipticRootNumber.tateModule F E) :
          ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) k :
            EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1))) :
              EllipticRootNumber.Pts F E) =
        ((((x : EllipticRootNumber.tateModule F E) :
          ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) k :
            EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1))) :
              EllipticRootNumber.Pts F E) +
        ((((y : EllipticRootNumber.tateModule F E) :
          ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) k :
            EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1))) :
              EllipticRootNumber.Pts F E) := fun _ _ => rfl
    have hsmul : ∀ (r : ℤ_[EllipticRootNumber.ell F]) (x : EllipticRootNumber.tateModule F E),
        ((((r • x : EllipticRootNumber.tateModule F E) :
          ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) k :
            EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1))) :
              EllipticRootNumber.Pts F E) =
        (PadicInt.toZModPow (k + 1) r).val •
        ((((x : EllipticRootNumber.tateModule F E) :
          ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) k :
            EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1))) :
              EllipticRootNumber.Pts F E) :=
      fun r x => EllipticRootNumber.padic_smul_torsion F E k r _
    rw [h1, hbasis j, hadd, hsmul, hsmul]
  
  have hdet : LinearMap.det (EllipticRootNumber.tateRep F E σ) =
      LinearMap.toMatrix b b (EllipticRootNumber.tateRep F E σ) 0 0 *
        LinearMap.toMatrix b b (EllipticRootNumber.tateRep F E σ) 1 1 -
      LinearMap.toMatrix b b (EllipticRootNumber.tateRep F E σ) 0 1 *
        LinearMap.toMatrix b b (EllipticRootNumber.tateRep F E σ) 1 0 := by
    rw [← LinearMap.det_toMatrix b, Matrix.det_fin_two]
  rw [hdet]
  apply PadicInt.ext_of_toZModPow.mp
  intro n
  cases n with
  | zero =>
    haveI : Subsingleton (ZMod (EllipticRootNumber.ell F ^ 0)) :=
      ZMod.subsingleton_iff.mpr (pow_zero _)
    exact Subsingleton.elim _ _
  | succ k =>
    have hN : 0 < EllipticRootNumber.ell F ^ (k + 1) := pow_pos hℓp.pos _
    have hP := ((((b 0 : EllipticRootNumber.tateModule F E) :
          ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) k)).2
    have hQ := ((((b 1 : EllipticRootNumber.tateModule F E) :
          ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) k)).2
    obtain ⟨hL, hR, hD⟩ := alg _ hN _ _ hP hQ
    
    have h1 := hL (EllipticRootNumber.ell F ^ (k + 1))
    have h0 := hL 0
    rw [zero_nsmul, pow_zero] at h0
    rw [(EllipticRootNumber.mem_torsion F E).mp hP, h0] at h1
    
    have h2 := hR (EllipticRootNumber.ell F ^ k)
    rw [hiter (b 1) k] at h2
    have hNeq : EllipticRootNumber.ell F ^ (0 + 1) * EllipticRootNumber.ell F ^ k =
        EllipticRootNumber.ell F ^ (k + 1) := by ring
    have hP'' : (EllipticRootNumber.ell F ^ (0 + 1) * EllipticRootNumber.ell F ^ k) •
        ((((b 0 : EllipticRootNumber.tateModule F E) :
          ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) k :
            EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1))) :
              EllipticRootNumber.Pts F E) = 0 := by
      rw [hNeq]; exact (EllipticRootNumber.mem_torsion F E).mp hP
    have hP' := (EllipticRootNumber.mem_torsion F E).mpr hP''
    have hc := he_compat (EllipticRootNumber.ell F ^ (0 + 1)) (EllipticRootNumber.ell F ^ k)
      (pow_pos hℓp.pos _) (pow_pos hℓp.pos _) _ _ hP'
      ((((b 1 : EllipticRootNumber.tateModule F E) :
          ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0)).2
    rw [hNeq, hiter (b 0) k] at hc
    rw [hc] at h2
    have h2' : e (EllipticRootNumber.ell F ^ (k + 1))
        ((((b 0 : EllipticRootNumber.tateModule F E) :
          ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) k :
            EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1))) :
              EllipticRootNumber.Pts F E)
        ((((b 1 : EllipticRootNumber.tateModule F E) :
          ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) k :
            EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1))) :
              EllipticRootNumber.Pts F E) ^ (EllipticRootNumber.ell F ^ k) ≠ 1 := by
      rw [← h2]; exact hne
    
    have h3 := hfix k _ h1.symm
    
    have hg := he_gal _ hN σ _ _ hP hQ
    rw [hlev k 0, hlev k 1, h3] at hg
    have hD' := hD (PadicInt.toZModPow (k + 1)
          (LinearMap.toMatrix b b (EllipticRootNumber.tateRep F E σ) 0 0)).val
      (PadicInt.toZModPow (k + 1)
          (LinearMap.toMatrix b b (EllipticRootNumber.tateRep F E σ) 0 1)).val
      (PadicInt.toZModPow (k + 1)
          (LinearMap.toMatrix b b (EllipticRootNumber.tateRep F E σ) 1 0)).val
      (PadicInt.toZModPow (k + 1)
          (LinearMap.toMatrix b b (EllipticRootNumber.tateRep F E σ) 1 1)).val
    rw [hg, ← pow_succ'] at hD'
    
    have hord := orderOf_eq_prime_pow h2' h1.symm
    have hfin : IsOfFinOrder (e (EllipticRootNumber.ell F ^ (k + 1))
        ((((b 0 : EllipticRootNumber.tateModule F E) :
          ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) k :
            EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1))) :
              EllipticRootNumber.Pts F E)
        ((((b 1 : EllipticRootNumber.tateModule F E) :
          ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) k :
            EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1))) :
              EllipticRootNumber.Pts F E)) :=
      isOfFinOrder_iff_pow_eq_one.mpr ⟨_, hN, h1.symm⟩
    have hmod := (hfin.pow_eq_pow_iff_modEq).mp hD'
    rw [hord] at hmod
    have hz := (ZMod.natCast_eq_natCast_iff _ _ _).mpr hmod
    push_cast at hz
    simp only [ZMod.natCast_val, ZMod.cast_id', id] at hz
    rw [map_sub, map_mul, map_mul, map_one]
    linear_combination -hz

theorem det_ellAdicRep_eq_one_of_mem_inertia (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F] (E : WeierstrassCurve F)
    (hΔ : E.Δ ≠ 0) (σ : EllipticRootNumber.AbsGal F) (hσ : σ ∈ EllipticRootNumber.inertia F) :
    LinearMap.det (EllipticRootNumber.ellAdicRep F E σ) = 1 :=
by
  classical
  obtain ⟨e, he_addl, he_addr, he_self, he_nondeg, he_gal, he_compat⟩ :=
    exists_weilPairing F E hΔ
  have hℓp : (EllipticRootNumber.ell F).Prime := Fact.out
  
  have hsurj : ∀ P : EllipticRootNumber.Pts F E,
      P ∈ EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1)) →
      ∃ x : EllipticRootNumber.tateModule F E,
        (((x : ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) 0 :
          EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (0 + 1))) :
            EllipticRootNumber.Pts F E) = P := by
    intro P hP
    have hdiv : ∀ Q : EllipticRootNumber.Pts F E, ∃ R : EllipticRootNumber.Pts F E,
        EllipticRootNumber.ell F • R = Q :=
      fun Q => pts_nsmul_surjective F E hΔ _ hℓp.pos Q
    choose d hd using hdiv
    let s : ℕ → EllipticRootNumber.Pts F E := fun n => Nat.rec P (fun _ Q => d Q) n
    have hs_succ : ∀ n, EllipticRootNumber.ell F • s (n + 1) = s n := fun n => hd (s n)
    have hs_mem : ∀ n,
        s n ∈ EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1)) := by
      intro n
      induction n with
      | zero => exact hP
      | succ n ih =>
        rw [EllipticRootNumber.mem_torsion] at ih ⊢
        rw [pow_succ, ← smul_smul, hs_succ, ih]
    let y : ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1)) :=
      fun n => ⟨s n, hs_mem n⟩
    have hy : y ∈ EllipticRootNumber.tateModule F E := fun n => hs_succ n
    exact ⟨⟨y, hy⟩, rfl⟩
  
  haveI hfin : Module.Finite ℤ_[EllipticRootNumber.ell F] (EllipticRootNumber.tateModule F E) :=
    tateModule_finite F E hΔ
  
  have hiter : ∀ x : EllipticRootNumber.tateModule F E, ∀ n k : ℕ,
      EllipticRootNumber.ell F ^ k •
        (((x : ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1)))
          (n + k) : EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E) =
      (((x : ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1))) n :
          EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E) := by
    intro x n k
    induction k with
    | zero => simp
    | succ k ih =>
      rw [pow_succ, ← smul_smul]
      have h := x.2 (n + k)
      rw [← ih]
      exact congrArg (fun Q => EllipticRootNumber.ell F ^ k • Q) h
  haveI htf : Module.IsTorsionFree ℤ_[EllipticRootNumber.ell F]
      (EllipticRootNumber.tateModule F E) := by
    rw [Module.isTorsionFree_iff_smul_eq_zero]
    intro r x hrx
    by_cases hr : r = 0
    · exact Or.inl hr
    right
    have hspec := PadicInt.unitCoeff_spec hr
    set k := r.valuation
    set w := PadicInt.unitCoeff hr
    have hk : ((EllipticRootNumber.ell F ^ k : ℕ) : ℤ_[EllipticRootNumber.ell F]) • x = 0 := by
      have e1 : ((EllipticRootNumber.ell F ^ k : ℕ) : ℤ_[EllipticRootNumber.ell F]) =
          ((w⁻¹ : (ℤ_[EllipticRootNumber.ell F])ˣ) : ℤ_[EllipticRootNumber.ell F]) * r := by
        rw [hspec, ← mul_assoc, Units.inv_mul, one_mul]
        push_cast
        ring
      rw [e1, mul_smul, hrx, smul_zero]
    rw [Nat.cast_smul_eq_nsmul] at hk
    have hcomp : ∀ n, (((x : ∀ n : ℕ, EllipticRootNumber.torsion F E
        (EllipticRootNumber.ell F ^ (n + 1))) n : EllipticRootNumber.torsion F E _) :
          EllipticRootNumber.Pts F E) = 0 := by
      intro n
      rw [← hiter x n k]
      have h2 := congrArg (fun z : EllipticRootNumber.tateModule F E =>
        (((z : ∀ n : ℕ, EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (n + 1)))
          (n + k) : EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E)) hk
      simpa using h2
    exact Subtype.ext (funext fun n => Subtype.ext (hcomp n))
  haveI hfree : Module.Free ℤ_[EllipticRootNumber.ell F] (EllipticRootNumber.tateModule F E) :=
    Module.free_of_finite_type_torsion_free'
  
  have hrank : Module.finrank ℤ_[EllipticRootNumber.ell F]
      (EllipticRootNumber.tateModule F E) = 2 := by
    have h1 := finrank_vBar_eq_two F E hΔ
    rw [Module.finrank_baseChange, Module.finrank_baseChange] at h1
    exact h1
  let b := Module.finBasisOfFinrankEq ℤ_[EllipticRootNumber.ell F]
    (EllipticRootNumber.tateModule F E) hrank
  have hne := weilPairing_tateBasis_ne_one F E e he_addl he_addr he_self he_nondeg hsurj b
  have hT := det_tateRep_eq_one_of_weilPairing F E e he_addl he_addr he_self he_gal he_compat
    b hne σ hσ
  
  change LinearMap.det (LinearMap.baseChange (EllipticRootNumber.Ω F)
    (LinearMap.baseChange ℚ_[EllipticRootNumber.ell F] (EllipticRootNumber.tateRep F E σ))) = 1
  rw [LinearMap.det_baseChange, LinearMap.det_baseChange, hT, map_one, map_one]

theorem weilChar_recMap_mul (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] (rec : EllipticRootNumber.LocalReciprocity F)
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (χ : EllipticRootNumber.relWeil F L →* (EllipticRootNumber.Ω F)ˣ)
    (hχ : EllipticRootNumber.IsWeilRep F L (EllipticRootNumber.charRep F L χ)) (x y : Lˣ) :
    χ (rec.recMap L (x * y)) = χ (rec.recMap L x) * χ (rec.recMap L y) :=
by
  
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : EllipticRootNumber.AbsGal F, EllipticRootNumber.ActsAsFrobPow F Φ 1 := by
    obtain ⟨-, hmul, x₀, hx1⟩ := relVal_bot_spec F
    have hx : x₀ ≠ 0 := by
      rintro rfl
      have h0 : EllipticRootNumber.relVal F ⊥
          (0 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
        unfold EllipticRootNumber.relVal
        rw [Algebra.norm_zero]
        unfold EllipticRootNumber.addVal
        simp
      rw [h0] at hx1
      exact zero_ne_one hx1
    have hinv : EllipticRootNumber.relVal F ⊥ x₀⁻¹ = -1 := by
      have h := hmul x₀ x₀⁻¹ hx (inv_ne_zero hx)
      rw [mul_inv_cancel₀ hx, hx1] at h
      have h1 := hmul 1 1 one_ne_zero one_ne_zero
      rw [mul_one] at h1
      omega
    have hd := rec.degree_rec ⊥ (Units.mk0 x₀ hx)⁻¹
    have hval : (((Units.mk0 x₀ hx)⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) = x₀⁻¹ := by
      rw [Units.val_inv_eq_inv_val, Units.val_mk0]
    rw [hval, hinv, neg_neg] at hd
    obtain ⟨hspec1, hspec2⟩ := weilDegreeHom_spec_of_localField F
    obtain ⟨n, hn⟩ := hspec1 _ (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥)
      (rec.recMap ⊥ (Units.mk0 x₀ hx)⁻¹)).2
    have hn' := hspec2 _ n hn
    rw [hd] at hn'
    have hn1 : (1 : ℤ) = n := Multiplicative.ofAdd.injective hn'
    subst hn1
    exact ⟨_, hn⟩
  
  have hdense : ∀ N : IntermediateField F (AlgebraicClosure F), FiniteDimensional F N →
      Normal F N → ∀ σ : EllipticRootNumber.AbsGal F,
        ∃ w ∈ EllipticRootNumber.weilGroup F, ∀ x ∈ N, w x = σ x := by
    intro N hN hNn σ
    haveI := hN
    haveI := hNn
    exact weilGroup_restrict_surj F Φ hΦ N σ
  
  obtain ⟨-, U, hU, hUχ⟩ := hχ
  have key : ∀ w : EllipticRootNumber.relWeil F L, (w : EllipticRootNumber.AbsGal F) ∈ U →
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → χ w = 1 := by
    intro w hw1 hw2
    have h := hUχ w hw1 hw2
    have h' := LinearMap.congr_fun h (ULift.up (1 : EllipticRootNumber.Ω F))
    have h'' := congrArg ULift.down h'
    apply Units.ext
    simpa [EllipticRootNumber.charRep] using h''
  
  have hHH : ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆ ≤
      EllipticRootNumber.relWeil F L := by
    rw [Subgroup.commutator_le]
    intro g₁ h₁ g₂ h₂
    rw [commutatorElement_def]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ h₁ h₂)
      (Subgroup.inv_mem _ h₁)) (Subgroup.inv_mem _ h₂)
  have hHI : ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆ ≤
      EllipticRootNumber.inertia F := by
    rw [Subgroup.commutator_le]
    intro g₁ h₁ g₂ h₂
    have hdeg : EllipticRootNumber.weilDegreeHom F
        ⁅(⟨g₁, EllipticRootNumber.relWeil_le_weilGroup F L h₁⟩ : EllipticRootNumber.weilGroup F),
          (⟨g₂, EllipticRootNumber.relWeil_le_weilGroup F L h₂⟩ :
            EllipticRootNumber.weilGroup F)⁆ = 1 := by
      rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
      exact mul_comm _ _
    exact weilDegreeHom_ker_le_inertia F _ hdeg
  have hχcomm : ∀ c ∈ ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆,
      ∀ hc : c ∈ EllipticRootNumber.relWeil F L, χ ⟨c, hc⟩ = 1 := by
    have hle : ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆ ≤
        χ.ker.map (EllipticRootNumber.relWeil F L).subtype := by
      rw [Subgroup.commutator_le]
      intro g₁ h₁ g₂ h₂
      refine Subgroup.mem_map.mpr ⟨⁅(⟨g₁, h₁⟩ : EllipticRootNumber.relWeil F L), ⟨g₂, h₂⟩⁆, ?_, rfl⟩
      rw [MonoidHom.mem_ker, map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
      exact mul_comm _ _
    intro c hc hcH
    obtain ⟨k, hk, hkc⟩ := Subgroup.mem_map.mp (hle hc)
    have hk' : k = ⟨c, hcH⟩ := Subtype.ext hkc
    rw [← hk']
    exact hk
  
  obtain ⟨M, h, hMfin, hab, hcov⟩ := exists_abelianExt_commutator_cover F hdense L U hU
  haveI := hMfin
  
  set g : EllipticRootNumber.relWeil F L :=
    (rec.recMap L (x * y))⁻¹ * (rec.recMap L x * rec.recMap L y) with hg
  have hgM : ((g : EllipticRootNumber.relWeil F L) : EllipticRootNumber.AbsGal F) ∈
      M.fixingSubgroup := rec.mul_rec L M h hab x y
  
  have hadd : EllipticRootNumber.relVal F L ((x * y : Lˣ) : L) =
      EllipticRootNumber.relVal F L (x : L) + EllipticRootNumber.relVal F L (y : L) := by
    obtain ⟨-, hrel, hmulv, -⟩ := valL_spec F L
    have hx0 : (x : L) ≠ 0 := x.ne_zero
    have hy0 : (y : L) ≠ 0 := y.ne_zero
    rw [Units.val_mul, hrel _ (mul_ne_zero hx0 hy0), hmulv _ _ hx0 hy0, mul_add,
      ← hrel _ hx0, ← hrel _ hy0]
  
  have hgI : ((g : EllipticRootNumber.relWeil F L) : EllipticRootNumber.AbsGal F) ∈
      EllipticRootNumber.inertia F := by
    have hd : ((EllipticRootNumber.weilDegreeHom F).comp
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L))) g = 1 := by
      rw [hg, MonoidHom.map_mul, MonoidHom.map_inv, MonoidHom.map_mul, MonoidHom.comp_apply,
        MonoidHom.comp_apply, MonoidHom.comp_apply]
      rw [rec.degree_rec L (x * y), rec.degree_rec L x, rec.degree_rec L y, hadd]
      apply Multiplicative.toAdd.injective
      simp only [toAdd_mul, toAdd_inv, toAdd_ofAdd, toAdd_one]
      ring
    exact weilDegreeHom_ker_le_inertia F
      (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L) g) hd
  
  obtain ⟨c, hc, hcU⟩ := hcov _ g.2 hgM
  have hcH : c ∈ EllipticRootNumber.relWeil F L := hHH hc
  have hcI : c ∈ EllipticRootNumber.inertia F := hHI hc
  have hχc : χ ⟨c, hcH⟩ = 1 := hχcomm c hc hcH
  have hn : χ ((⟨c, hcH⟩ : EllipticRootNumber.relWeil F L)⁻¹ * g) = 1 :=
    key _ hcU ((EllipticRootNumber.inertia F).mul_mem
      ((EllipticRootNumber.inertia F).inv_mem hcI) hgI)
  have hχg : χ g = 1 := by
    calc χ g
        = χ ((⟨c, hcH⟩ : EllipticRootNumber.relWeil F L) *
            ((⟨c, hcH⟩ : EllipticRootNumber.relWeil F L)⁻¹ * g)) := by
          rw [mul_inv_cancel_left]
      _ = 1 := by rw [map_mul, hχc, hn, one_mul]
  rw [hg, map_mul, map_inv, map_mul] at hχg
  exact inv_mul_eq_one.mp hχg

theorem eps_psi_indep_of_line (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    {rec : EllipticRootNumber.LocalReciprocity F} (lc : EllipticRootNumber.LocalConstants F rec)
    {V : Type u} [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
    (ρ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V)
    (hW : EllipticRootNumber.IsWeilRep F ⊥ ρ)
    (hdim : Module.finrank (EllipticRootNumber.Ω F) V = 2)
    (hdet : ∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → LinearMap.det (ρ w) = 1)
    (hline : ∃ L : Submodule (EllipticRootNumber.Ω F) V, Module.finrank (EllipticRootNumber.Ω F) L = 1 ∧
      ∀ w : EllipticRootNumber.relWeil F ⊥, ∀ v ∈ L, ρ w v ∈ L)
    (ψ ψ' : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F))
    (hψ : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1)
    (hψ' : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ' x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ' x ≠ 1) :
    lc.eps ⊥ ρ ψ = lc.eps ⊥ ρ ψ' :=
by
  classical
  open EllipticRootNumber in
  
  obtain ⟨hres, -, -⟩ := relVal_bot_spec F
  have valL_eq : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      valL F ⊥ x = relVal F ⊥ x := by
    intro x
    unfold valL
    rw [hres, Nat.cast_one, Int.ediv_one]
  
  have adm : ∀ φ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (Ω F),
      ((∀ x, 0 ≤ valL F ⊥ x → φ x = 1) ∧ ∃ x, valL F ⊥ x = -1 ∧ φ x ≠ 1) →
      IsAdmissibleChar F ⊥ φ := by
    rintro φ ⟨h0, x, -, hx⟩
    exact ⟨fun h => hx (by rw [h, AddChar.one_apply]), 0, h0⟩
  have cond0 : ∀ φ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (Ω F),
      ((∀ x, 0 ≤ valL F ⊥ x → φ x = 1) ∧ ∃ x, valL F ⊥ x = -1 ∧ φ x ≠ 1) →
      condExpChar F ⊥ φ = 0 := by
    rintro φ ⟨h0, x₁, hx₁, hne⟩
    unfold condExpChar
    apply IsGreatest.csSup_eq
    refine ⟨fun x hx => h0 x (by simpa using hx), fun d hd => ?_⟩
    by_contra hlt
    push_neg at hlt
    exact hne (hd x₁ (by omega))
  
  have s1 : ∀ {k : Type} [Field k] {G : Type u} [Group G]
      {W : Type u} [AddCommGroup W] [Module k W] [FiniteDimensional k W]
      (σ : Representation k G W), Module.finrank k W = 2 →
      ∀ (Ls : Submodule k W), Module.finrank k Ls = 1 → (∀ g : G, ∀ v ∈ Ls, σ g v ∈ Ls) →
      ∃ (χ₁ χ₂ : G →* kˣ) (f : ULift.{u} k →ₗ[k] W) (g : W →ₗ[k] ULift.{u} k),
        (∀ w : G, f ∘ₗ ((χ₁ w : k) • LinearMap.id) = σ w ∘ₗ f) ∧
        (∀ w : G, g ∘ₗ σ w = ((χ₂ w : k) • LinearMap.id) ∘ₗ g) ∧
        Function.Injective f ∧ Function.Surjective g ∧ LinearMap.range f = LinearMap.ker g ∧
        (∀ w : G, LinearMap.det (σ w) = (χ₁ w : k) * (χ₂ w : k)) ∧
        (∀ w : G, σ w = 1 → χ₁ w = 1 ∧ χ₂ w = 1) := by
    intro k _ G _ W _ _ _ σ hdim2 Ls hLs hst
    have expand : ∀ (M : Type u) [AddCommGroup M] [Module k M] (b : Module.Basis (Fin 1) k M)
        (x : M), x = b.repr x 0 • b 0 := by
      intro M _ _ b x
      conv_lhs => rw [← b.sum_repr x]
      rw [Fin.sum_univ_one]
    have one_dim : ∀ (M : Type u) [AddCommGroup M] [Module k M] (b : Module.Basis (Fin 1) k M)
        (T : M →ₗ[k] M) (x : M), T x = LinearMap.det T • x := by
      intro M _ _ b T x
      have hdetT : LinearMap.det T = b.repr (T (b 0)) 0 := by
        rw [← LinearMap.det_toMatrix b, Matrix.det_unique, LinearMap.toMatrix_apply]
        rfl
      calc T x = T (b.repr x 0 • b 0) := congrArg T (expand M b x)
        _ = b.repr x 0 • T (b 0) := map_smul _ _ _
        _ = b.repr x 0 • (b.repr (T (b 0)) 0 • b 0) :=
            congrArg (b.repr x 0 • ·) (expand M b (T (b 0)))
        _ = b.repr (T (b 0)) 0 • (b.repr x 0 • b 0) := smul_comm _ _ _
        _ = LinearMap.det T • x := by rw [hdetT, ← expand M b x]
    have hQ : Module.finrank k (W ⧸ Ls) = 1 := by
      have := Submodule.finrank_quotient_add_finrank Ls
      omega
    let bL := Module.finBasisOfFinrankEq k Ls hLs
    let bQ := Module.finBasisOfFinrankEq k (W ⧸ Ls) hQ
    let rL : G →* Module.End k Ls :=
      { toFun := fun w => (σ w).restrict (hst w)
        map_one' := by
          apply LinearMap.ext; intro x; apply Subtype.ext
          simp
        map_mul' := fun w w' => by
          apply LinearMap.ext; intro x; apply Subtype.ext
          simp }
    let rQ : G →* Module.End k (W ⧸ Ls) :=
      { toFun := fun w => Ls.mapQ Ls (σ w) (fun v hv => hst w v hv)
        map_one' := by
          apply Submodule.linearMap_qext; apply LinearMap.ext; intro x
          simp
        map_mul' := fun w w' => by
          apply Submodule.linearMap_qext; apply LinearMap.ext; intro x
          simp }
    let a : G →* k := LinearMap.det.comp rL
    let d : G →* k := LinearMap.det.comp rQ
    let eU : ULift.{u} k ≃ₗ[k] k := ULift.moduleEquiv
    have hv₀ : (bL 0 : W) ≠ 0 := fun h => bL.ne_zero 0 ((Submodule.coe_eq_zero).mp h)
    have hρv₀ : ∀ w, σ w (bL 0 : W) = a w • (bL 0 : W) := by
      intro w
      have := one_dim Ls bL (rL w) (bL 0)
      exact congrArg Subtype.val this
    have hρQ : ∀ w v, Ls.mkQ (σ w v) = d w • Ls.mkQ v := by
      intro w v
      exact one_dim (W ⧸ Ls) bQ (rQ w) (Ls.mkQ v)
    refine ⟨a.toHomUnits, d.toHomUnits,
      (LinearMap.toSpanSingleton k W (bL 0 : W)).comp eU.toLinearMap,
      eU.symm.toLinearMap ∘ₗ (bQ.coord 0) ∘ₗ Ls.mkQ, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro w
      apply LinearMap.ext
      intro c
      show (eU (a w • c)) • (bL 0 : W) = σ w ((eU c) • (bL 0 : W))
      rw [map_smul, map_smul, hρv₀, smul_assoc, smul_comm]
    · intro w
      apply LinearMap.ext
      intro v
      show eU.symm (bQ.coord 0 (Ls.mkQ (σ w v))) =
        d w • eU.symm (bQ.coord 0 (Ls.mkQ v))
      rw [hρQ, map_smul, map_smul]
    · intro c c' h
      have h' : (eU c) • (bL 0 : W) = (eU c') • (bL 0 : W) := h
      exact eU.injective (smul_left_injective k hv₀ h')
    · intro y
      obtain ⟨v', hv'⟩ := Ls.mkQ_surjective (bQ 0)
      refine ⟨(eU y) • v', ?_⟩
      show eU.symm (bQ.coord 0 (Ls.mkQ ((eU y) • v'))) = y
      rw [map_smul, hv', map_smul, Module.Basis.coord_apply, Module.Basis.repr_self,
        Finsupp.single_eq_same, smul_eq_mul, mul_one, LinearEquiv.symm_apply_apply]
    · ext v
      simp only [LinearMap.mem_range, LinearMap.mem_ker]
      constructor
      · rintro ⟨c, rfl⟩
        show eU.symm (bQ.coord 0 (Ls.mkQ ((eU c) • (bL 0 : W)))) = 0
        have h0 : Ls.mkQ (eU c • (bL 0 : W)) = 0 :=
          (Submodule.Quotient.mk_eq_zero Ls).mpr (Ls.smul_mem _ (bL 0).2)
        rw [h0, map_zero, map_zero]
      · intro hv
        have h1 : bQ.coord 0 (Ls.mkQ v) = 0 := by
          have h2 : eU.symm (bQ.coord 0 (Ls.mkQ v)) = 0 := hv
          exact (LinearEquiv.map_eq_zero_iff eU.symm).mp h2
        have h3 : Ls.mkQ v = 0 := by
          rw [expand _ bQ (Ls.mkQ v), ← Module.Basis.coord_apply, h1, zero_smul]
        have hvL : v ∈ Ls := (Submodule.Quotient.mk_eq_zero Ls).mp h3
        refine ⟨ULift.up (bL.repr ⟨v, hvL⟩ 0), ?_⟩
        show (bL.repr ⟨v, hvL⟩ 0) • (bL 0 : W) = v
        have := congrArg Subtype.val (expand Ls bL ⟨v, hvL⟩)
        exact this.symm
    · intro w
      show LinearMap.det (σ w) = LinearMap.det ((σ w).restrict (hst w)) *
        LinearMap.det (Ls.mapQ Ls (σ w) (fun v hv => hst w v hv))
      exact LinearMap.det_eq_det_mul_det Ls (σ w) (fun v hv => hst w v hv)
    · intro w hw
      have e1 : (σ w).restrict (hst w) = LinearMap.id := by
        apply LinearMap.ext; intro x; apply Subtype.ext
        simp [hw]
      have e2 : Ls.mapQ Ls (σ w) (fun v hv => hst w v hv) = LinearMap.id := by
        apply Submodule.linearMap_qext; apply LinearMap.ext; intro x
        simp [hw]
      constructor
      · apply Units.ext
        show LinearMap.det ((σ w).restrict (hst w)) = 1
        rw [e1, LinearMap.det_id]
      · apply Units.ext
        show LinearMap.det (Ls.mapQ Ls (σ w) (fun v hv => hst w v hv)) = 1
        rw [e2, LinearMap.det_id]
  
  obtain ⟨Lin, hLin1, hLinst⟩ := hline
  haveI : FiniteDimensional (Ω F) V := hW.1
  obtain ⟨χ₁, χ₂, f, g, hf, hg, hfi, hgs, hrange, hdetχ, htriv⟩ := s1 ρ hdim Lin hLin1 hLinst
  obtain ⟨U, hU, hUρ⟩ := hW.2
  have W1 : IsWeilRep F ⊥ (charRep F ⊥ χ₁) := by
    refine ⟨inferInstance, U, hU, fun w hwU hwI => ?_⟩
    show ((χ₁ w : (Ω F)ˣ) : Ω F) • LinearMap.id = 1
    rw [(htriv w (hUρ w hwU hwI)).1, Units.val_one, one_smul]
    rfl
  have W2 : IsWeilRep F ⊥ (charRep F ⊥ χ₂) := by
    refine ⟨inferInstance, U, hU, fun w hwU hwI => ?_⟩
    show ((χ₂ w : (Ω F)ˣ) : Ω F) • LinearMap.id = 1
    rw [(htriv w (hUρ w hwU hwI)).2, Units.val_one, one_smul]
    rfl
  
  have s7 : ∀ φ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (Ω F),
      IsAdmissibleChar F ⊥ φ →
      lc.eps ⊥ ρ φ = lc.eps ⊥ (charRep F ⊥ χ₁) φ * lc.eps ⊥ (charRep F ⊥ χ₂) φ := by
    intro φ hφ
    exact lc.eps_exact ⊥ φ hφ (charRep F ⊥ χ₁) ρ (charRep F ⊥ χ₂) W1 hW W2 f g hf hg hfi hgs
      hrange
  
  obtain ⟨χ₁', hχ₁'⟩ : ∃ χ' : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (Ω F)ˣ,
      ∀ x, χ' x = χ₁ (rec.recMap ⊥ x) :=
    ⟨MonoidHom.mk' (fun x => χ₁ (rec.recMap ⊥ x)) (weilChar_recMap_mul F rec ⊥ χ₁ W1),
      fun _ => rfl⟩
  obtain ⟨χ₂', hχ₂'⟩ : ∃ χ' : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (Ω F)ˣ,
      ∀ x, χ' x = χ₂ (rec.recMap ⊥ x) :=
    ⟨MonoidHom.mk' (fun x => χ₂ (rec.recMap ⊥ x)) (weilChar_recMap_mul F rec ⊥ χ₂ W2),
      fun _ => rfl⟩
  have hA := adm ψ hψ
  have hA' := adm ψ' hψ'
  have E1 : (lc.eps ⊥ ρ ψ : Ω F) = tateEps F ⊥ χ₁' ψ * tateEps F ⊥ χ₂' ψ := by
    rw [s7 ψ hA, Units.val_mul, lc.eps_char ⊥ ψ hA χ₁ W1 χ₁' hχ₁',
      lc.eps_char ⊥ ψ hA χ₂ W2 χ₂' hχ₂']
  have E2 : (lc.eps ⊥ ρ ψ' : Ω F) = tateEps F ⊥ χ₁' ψ' * tateEps F ⊥ χ₂' ψ' := by
    rw [s7 ψ' hA', Units.val_mul, lc.eps_char ⊥ ψ' hA' χ₁ W1 χ₁' hχ₁',
      lc.eps_char ⊥ ψ' hA' χ₂ W2 χ₂' hχ₂']
  
  have hinert : ∀ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      valL F ⊥ (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 →
      ((rec.recMap ⊥ u : relWeil F ⊥) : AbsGal F) ∈ inertia F := by
    intro u hu
    have h1 := rec.degree_rec ⊥ u
    rw [← valL_eq, hu, neg_zero, ofAdd_zero] at h1
    exact weilDegreeHom_ker_le_inertia F _ h1
  
  have hunit : ∀ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      valL F ⊥ (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 →
      ((χ₁' u : (Ω F)ˣ) : Ω F) * ((χ₂' u : (Ω F)ˣ) : Ω F) = 1 := by
    intro u hu
    rw [hχ₁', hχ₂', ← hdetχ]
    exact hdet _ (hinert u hu)
  have hunitU : ∀ u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      valL F ⊥ (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 →
      χ₁' u * χ₂' u = 1 := by
    intro u hu
    apply Units.ext
    rw [Units.val_mul, Units.val_one]
    exact hunit u hu
  have hcond : condExp F ⊥ χ₂' = condExp F ⊥ χ₁' := by
    unfold condExp
    congr 1
    ext n
    simp only [Set.mem_setOf_eq]
    constructor
    · intro h u hu
      have h1 := hunitU u (unitGroup_bot_spec F n u hu).1
      rw [h u hu, mul_one] at h1
      exact h1
    · intro h u hu
      have h1 := hunitU u (unitGroup_bot_spec F n u hu).1
      rw [h u hu, one_mul] at h1
      exact h1
  
  apply Units.ext
  rw [E1, E2]
  have hc := cond0 ψ hψ
  have hc' := cond0 ψ' hψ'
  by_cases ha : condExp F ⊥ χ₁' = 0
  · have ha2 : condExp F ⊥ χ₂' = 0 := hcond.trans ha
    have unr : ∀ χ₀ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (Ω F)ˣ,
        condExp F ⊥ χ₀ = 0 → tateEps F ⊥ χ₀ ψ = tateEps F ⊥ χ₀ ψ' := by
      intro χ₀ h0
      have ht : tateElt F ⊥ χ₀ ψ = tateElt F ⊥ χ₀ ψ' := by
        unfold tateElt
        rw [hc, hc']
      unfold tateEps
      rw [hc, hc', if_pos h0, if_pos h0, ht]
    rw [unr χ₁' ha, unr χ₂' ha2]
  · have ha1 : 1 ≤ condExp F ⊥ χ₁' := Nat.one_le_iff_ne_zero.mpr ha
    obtain ⟨b, hb, hbψ⟩ := exists_unit_addChar_twist F ψ ψ' hψ hψ' (condExp F ⊥ χ₁')
    have T1 := tateEps_twist_unit F χ₁' ψ ψ' hψ.1 hc hc' ha1 b hb hbψ
    have T2 := tateEps_twist_unit F χ₂' ψ ψ' hψ.1 hc hc' (by rw [hcond]; exact ha1) b hb
      (by rw [hcond]; exact hbψ)
    have hprod := hunit b hb
    rw [T1, T2]
    linear_combination (-(tateEps F ⊥ χ₁' ψ * tateEps F ⊥ χ₂' ψ)) * hprod

theorem exists_indRep_linearEquiv_of_index_two {k : Type} [Field k] {G : Type u} [Group G]
    (H : Subgroup G) (t : G) (ht : t ∉ H) (hH : ∀ g : G, g ∉ H → g * t⁻¹ ∈ H)
    {V : Type u} [AddCommGroup V] [Module k V] (ρ : Representation k G V)
    (hdim : Module.finrank k V = 2) (L₀ : Submodule k V) (hL₀ : Module.finrank k L₀ = 1)
    (hst : ∀ h : G, h ∈ H → ∀ v ∈ L₀, ρ h v ∈ L₀) (hmove : ∃ v ∈ L₀, ρ t v ∉ L₀) :
    ∃ θ : H →* kˣ,
      (∀ h : H, ∀ v ∈ L₀, ρ h v = (θ h : k) • v) ∧
      (∀ h h' : H, (h' : G) = t * h * t⁻¹ → LinearMap.det (ρ h) = (θ h : k) * (θ h' : k)) ∧
      (∀ (g : G) (h : H), g ∉ H → (h : G) = g * g → LinearMap.det (ρ g) = -(θ h : k)) ∧
      ∀ σ : Representation k H (ULift.{u} k), (∀ h : H, σ h = (θ h : k) • LinearMap.id) →
        ∃ e : V ≃ₗ[k] EllipticRootNumber.indSpace H σ,
          ∀ g : G, e.toLinearMap ∘ₗ ρ g = EllipticRootNumber.indRep H σ g ∘ₗ e.toLinearMap :=
by
  classical
  
  have htinv : t⁻¹ ∉ H := fun h => ht (by simpa using H.inv_mem h)
  have htt : t * t ∈ H := by
    have h1 := H.inv_mem (hH t⁻¹ htinv)
    simpa [mul_inv_rev] using h1
  
  obtain ⟨v₁, hv₁, hmv⟩ := hmove
  have hv₁0 : v₁ ≠ 0 := by
    rintro rfl
    exact hmv (by rw [map_zero]; exact L₀.zero_mem)
  have hspan : ∀ x : L₀, ∃ c : k, c • (⟨v₁, hv₁⟩ : L₀) = x :=
    (finrank_eq_one_iff_of_nonzero' (⟨v₁, hv₁⟩ : L₀)
      (fun h => hv₁0 (congrArg Subtype.val h))).mp hL₀
  have hspanV : ∀ x ∈ L₀, ∃ c : k, c • v₁ = x := by
    intro x hx
    obtain ⟨c, hc⟩ := hspan ⟨x, hx⟩
    exact ⟨c, congrArg Subtype.val hc⟩
  have hsmul_inj : ∀ a b : k, a • v₁ = b • v₁ → a = b :=
    fun a b h => smul_left_injective k hv₁0 h
  choose c hc using fun h : H => hspanV (ρ h v₁) (hst h h.2 v₁ hv₁)
  have c_one : c 1 = 1 := hsmul_inj _ _ (by
    rw [hc, OneMemClass.coe_one, map_one, Module.End.one_apply, one_smul])
  have c_mul : ∀ a b : H, c (a * b) = c a * c b := by
    intro a b
    apply hsmul_inj
    rw [hc, Subgroup.coe_mul, map_mul, Module.End.mul_apply, ← hc b, map_smul, ← hc a,
      smul_smul, mul_comm]
  let cM : H →* k := { toFun := c, map_one' := c_one, map_mul' := c_mul }
  let θ : H →* kˣ := cM.toHomUnits
  have hθ : ∀ h : H, (θ h : k) = c h := fun h => rfl
  
  have concl1 : ∀ h : H, ∀ v ∈ L₀, ρ h v = (θ h : k) • v := by
    intro h v hv
    obtain ⟨a, rfl⟩ := hspanV v hv
    rw [map_smul, ← hc h, hθ, smul_comm]
  have A1 : ∀ (g : G) (hg : g ∈ H), ρ g v₁ = (θ ⟨g, hg⟩ : k) • v₁ :=
    fun g hg => concl1 ⟨g, hg⟩ v₁ hv₁
  
  have hnot : ∀ g : G, g ∉ H → ρ g v₁ ∉ L₀ := by
    intro g hg hmem
    apply hmv
    have h0 : (g * t⁻¹)⁻¹ ∈ H := H.inv_mem (hH g hg)
    have h1 := hst _ h0 _ hmem
    rwa [← Module.End.mul_apply, ← map_mul, show (g * t⁻¹)⁻¹ * g = t by group] at h1
  
  have hli : ∀ u : V, u ∉ L₀ → LinearIndependent k ![v₁, u] := by
    intro u hu
    rw [LinearIndependent.pair_iff]
    intro s r hsr
    by_cases hr : r = 0
    · subst hr
      rw [zero_smul, add_zero] at hsr
      exact ⟨(smul_eq_zero.mp hsr).resolve_right hv₁0, rfl⟩
    · exfalso
      apply hu
      have h1 : r • u = -(s • v₁) := eq_neg_of_add_eq_zero_right hsr
      have h2 : r • u ∈ L₀ := by
        rw [h1]
        exact L₀.neg_mem (L₀.smul_mem s hv₁)
      exact (L₀.smul_mem_iff hr).mp h2
  
  have detpair : ∀ (x y : V), LinearIndependent k ![x, y] → ∀ (f : V →ₗ[k] V) (a b c d : k),
      f x = a • x + c • y → f y = b • x + d • y → LinearMap.det f = a * d - b * c := by
    intro x y hxy f a b c d hx hy
    let B := basisOfLinearIndependentOfCardEqFinrank hxy (by simp [hdim])
    have hB0 : B 0 = x := by simp [B]
    have hB1 : B 1 = y := by simp [B]
    have hx' : f (B 0) = a • B 0 + c • B 1 := by rw [hB0, hB1]; exact hx
    have hy' : f (B 1) = b • B 0 + d • B 1 := by rw [hB0, hB1]; exact hy
    rw [← LinearMap.det_toMatrix B f, Matrix.det_fin_two]
    simp only [LinearMap.toMatrix_apply, hx', hy', map_add, map_smul, Module.Basis.repr_self,
      Finsupp.add_apply, Finsupp.smul_apply, Finsupp.single_apply]
    simp
  
  obtain ⟨w, hw⟩ : ∃ w, w = ρ t⁻¹ v₁ := ⟨_, rfl⟩
  have hwL : w ∉ L₀ := hw ▸ hnot t⁻¹ htinv
  have hvw := hli w hwL
  have A2 : ∀ h h' : H, (h' : G) = t * h * t⁻¹ → ρ h w = (θ h' : k) • w := by
    intro h h' hh'
    have e : (h : G) * t⁻¹ = t⁻¹ * h' := by rw [hh']; group
    rw [hw, ← Module.End.mul_apply, ← map_mul, e, map_mul, Module.End.mul_apply,
      concl1 h' v₁ hv₁, map_smul]
  
  have concl2 : ∀ h h' : H, (h' : G) = t * h * t⁻¹ →
      LinearMap.det (ρ h) = (θ h : k) * (θ h' : k) := by
    intro h h' hh'
    rw [detpair v₁ w hvw (ρ h) (θ h) 0 0 (θ h')
      (by rw [concl1 h v₁ hv₁, zero_smul, add_zero])
      (by rw [A2 h h' hh', zero_smul, zero_add])]
    ring
  
  have concl3 : ∀ (g : G) (h : H), g ∉ H → (h : G) = g * g →
      LinearMap.det (ρ g) = -(θ h : k) := by
    intro g h hg hh
    have hu := hli (ρ g v₁) (hnot g hg)
    rw [detpair v₁ (ρ g v₁) hu (ρ g) 0 (θ h) 1 0 (by rw [zero_smul, one_smul, zero_add])
      (by rw [← Module.End.mul_apply, ← map_mul, ← hh, concl1 h v₁ hv₁, zero_smul, add_zero])]
    ring
  
  obtain ⟨φ, μ, φv, φw, μv, μw, hdec⟩ : ∃ φ μ : V →ₗ[k] k, φ v₁ = 1 ∧ φ w = 0 ∧ μ v₁ = 0 ∧
      μ w = 1 ∧ ∀ x, x = φ x • v₁ + μ x • w := by
    let B := basisOfLinearIndependentOfCardEqFinrank hvw (by simp [hdim])
    have hB0 : B 0 = v₁ := by simp [B]
    have hB1 : B 1 = w := by simp [B]
    refine ⟨B.coord 0, B.coord 1, ?_, ?_, ?_, ?_, ?_⟩
    · rw [← hB0]; simp
    · rw [← hB1]; simp
    · rw [← hB0]; simp
    · rw [← hB1]; simp
    · intro x
      have h1 := (B.sum_repr x).symm
      rw [Fin.sum_univ_two, hB0, hB1] at h1
      rw [Module.Basis.coord_apply, Module.Basis.coord_apply]
      exact h1
  have A3 : ρ t v₁ = (θ ⟨t * t, htt⟩ : k) • w := by
    have e : t = t⁻¹ * (t * t) := by group
    conv_lhs => rw [e]
    rw [map_mul, Module.End.mul_apply, A1 (t * t) htt, map_smul, hw]
  have A4 : ρ t w = v₁ := by
    rw [hw, ← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one, Module.End.one_apply]
  have hφ : ∀ (h : H) (x : V), φ (ρ h x) = (θ h : k) * φ x := by
    intro h x
    have hconj : t * (h : G) * t⁻¹ ∈ H := by
      apply hH
      intro hth
      apply ht
      have h2 := H.mul_mem hth (H.inv_mem h.2)
      simpa using h2
    conv_lhs => rw [hdec x]
    simp only [map_add, map_smul, concl1 h v₁ hv₁, A2 h ⟨_, hconj⟩ rfl, smul_eq_mul, φv, φw]
    ring
  have key : ∀ x, φ (ρ t x) = μ x := by
    intro x
    conv_lhs => rw [hdec x]
    simp only [map_add, map_smul, A3, A4, smul_eq_mul, φv, φw]
    ring
  
  refine ⟨θ, concl1, concl2, concl3, fun σ hσ => ?_⟩
  let E : V →ₗ[k] EllipticRootNumber.indSpace H σ :=
    { toFun := fun x => ⟨fun g => ULift.up (φ (ρ g x)), by
        intro h g
        show ULift.up (φ (ρ ((h : G) * g) x)) = σ h (ULift.up (φ (ρ g x)))
        rw [hσ h, map_mul, Module.End.mul_apply, hφ]
        rfl⟩
      map_add' := fun x y => by
        apply Subtype.ext
        funext g
        show ULift.up (φ (ρ g (x + y))) = ULift.up (φ (ρ g x)) + ULift.up (φ (ρ g y))
        rw [map_add, map_add]
        rfl
      map_smul' := fun a x => by
        apply Subtype.ext
        funext g
        show ULift.up (φ (ρ g (a • x))) = a • ULift.up (φ (ρ g x))
        rw [map_smul, map_smul]
        rfl }
  have hE : ∀ x g, ((E x : EllipticRootNumber.indSpace H σ) : G → ULift.{u} k) g =
      ULift.up (φ (ρ g x)) := fun x g => rfl
  have hEq : ∀ g : G, E ∘ₗ ρ g = EllipticRootNumber.indRep H σ g ∘ₗ E := by
    intro g
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    funext y
    show ULift.up (φ (ρ y (ρ g x))) = ULift.up (φ (ρ (y * g) x))
    rw [map_mul, Module.End.mul_apply]
  have ext2 : ∀ f₁ f₂ : EllipticRootNumber.indSpace H σ,
      (f₁ : G → ULift.{u} k) 1 = (f₂ : G → ULift.{u} k) 1 →
      (f₁ : G → ULift.{u} k) t = (f₂ : G → ULift.{u} k) t → f₁ = f₂ := by
    intro f₁ f₂ h1 h2
    have m1 : ∀ (h : H) (g : G), (f₁ : G → ULift.{u} k) ((h : G) * g) =
        σ h ((f₁ : G → ULift.{u} k) g) := f₁.2
    have m2 : ∀ (h : H) (g : G), (f₂ : G → ULift.{u} k) ((h : G) * g) =
        σ h ((f₂ : G → ULift.{u} k) g) := f₂.2
    apply Subtype.ext
    funext g
    by_cases hg : g ∈ H
    · have e1 := m1 ⟨g, hg⟩ 1
      have e2 := m2 ⟨g, hg⟩ 1
      simp only [mul_one] at e1 e2
      rw [e1, e2, h1]
    · have e1 := m1 ⟨g * t⁻¹, hH g hg⟩ t
      have e2 := m2 ⟨g * t⁻¹, hH g hg⟩ t
      simp only [inv_mul_cancel_right] at e1 e2
      rw [e1, e2, h2]
  have hinj : Function.Injective E := by
    refine (injective_iff_map_eq_zero E).mpr fun x hx => ?_
    have h1 := congrArg (fun f : EllipticRootNumber.indSpace H σ => (f : G → ULift.{u} k) 1) hx
    have h2 := congrArg (fun f : EllipticRootNumber.indSpace H σ => (f : G → ULift.{u} k) t) hx
    change ULift.up (φ (ρ 1 x)) = (0 : ULift.{u} k) at h1
    change ULift.up (φ (ρ t x)) = (0 : ULift.{u} k) at h2
    rw [map_one, Module.End.one_apply] at h1
    rw [key] at h2
    have e1 : φ x = 0 := congrArg ULift.down h1
    have e2 : μ x = 0 := congrArg ULift.down h2
    rw [hdec x, e1, e2, zero_smul, zero_smul, add_zero]
  have hsurj : Function.Surjective E := by
    intro f
    refine ⟨((f : G → ULift.{u} k) 1).down • v₁ + ((f : G → ULift.{u} k) t).down • w, ?_⟩
    apply ext2
    · rw [hE, map_one, Module.End.one_apply, map_add, map_smul, map_smul, φv, φw]
      simp
    · rw [hE, key, map_add, map_smul, map_smul, μv, μw]
      simp
  refine ⟨LinearEquiv.ofBijective E ⟨hinj, hsurj⟩, fun g => ?_⟩
  apply LinearMap.ext
  intro x
  have h1 := LinearMap.congr_fun (hEq g) x
  simp only [LinearMap.comp_apply] at h1 ⊢
  simpa only [LinearEquiv.coe_coe, LinearEquiv.ofBijective_apply] using h1

theorem indRep_trivial_exact_of_index_two {k : Type} [Field k] {G : Type u} [Group G]
    (H : Subgroup G) (t : G) (ht : t ∉ H) (hH : ∀ g : G, g ∉ H → g * t⁻¹ ∈ H)
    (σ : Representation k H (ULift.{u} k)) (hσ : ∀ h : H, σ h = 1) :
    ∃ (η : G →* kˣ) (f : ULift.{u} k →ₗ[k] EllipticRootNumber.indSpace H σ)
      (q : EllipticRootNumber.indSpace H σ →ₗ[k] ULift.{u} k),
      (∀ g : G, g ∈ H → η g = 1) ∧ (∀ g : G, g ∉ H → η g = -1) ∧
      (∀ g : G, EllipticRootNumber.indRep H σ g ∘ₗ f = f) ∧
      (∀ g : G, q ∘ₗ EllipticRootNumber.indRep H σ g = ((η g : k) • LinearMap.id) ∘ₗ q) ∧
      Function.Injective f ∧ Function.Surjective q ∧ LinearMap.range f = LinearMap.ker q :=
by
  classical
  
  have hmul2 : ∀ x y : G, x ∉ H → y ∉ H → x * y ∈ H := by
    intro x y hx hy
    have hy' : y⁻¹ ∉ H := fun h => hy (by simpa using H.inv_mem h)
    have h1 : t * y ∈ H := by
      have h3 := H.inv_mem (hH y⁻¹ hy')
      simpa [mul_inv_rev] using h3
    have h2 := H.mul_mem (hH x hx) h1
    simpa [mul_assoc] using h2
  
  let ηf : G → kˣ := fun g => if g ∈ H then 1 else -1
  have hηmul : ∀ a b : G, ηf (a * b) = ηf a * ηf b := by
    intro a b
    by_cases ha : a ∈ H <;> by_cases hb : b ∈ H
    · have hab : a * b ∈ H := H.mul_mem ha hb
      simp only [ηf, if_pos ha, if_pos hb, if_pos hab, mul_one]
    · have hab : a * b ∉ H := fun h => hb (by simpa using H.mul_mem (H.inv_mem ha) h)
      simp only [ηf, if_pos ha, if_neg hb, if_neg hab, one_mul]
    · have hab : a * b ∉ H := fun h => ha (by simpa using H.mul_mem h (H.inv_mem hb))
      simp only [ηf, if_neg ha, if_pos hb, if_neg hab, mul_one]
    · have hab : a * b ∈ H := hmul2 a b ha hb
      simp only [ηf, if_neg ha, if_neg hb, if_pos hab, neg_mul_neg, mul_one]
  let η : G →* kˣ := MonoidHom.mk' ηf hηmul
  have hηH : ∀ g : G, g ∈ H → η g = 1 := by
    intro g hg
    show (if g ∈ H then (1 : kˣ) else -1) = 1
    rw [if_pos hg]
  have hηN : ∀ g : G, g ∉ H → η g = -1 := by
    intro g hg
    show (if g ∈ H then (1 : kˣ) else -1) = -1
    rw [if_neg hg]
  
  have hev : ∀ (φ : EllipticRootNumber.indSpace H σ) (h x : G), h ∈ H →
      (φ : G → ULift.{u} k) (h * x) = (φ : G → ULift.{u} k) x := by
    intro φ h x hh
    have h3 := φ.2 ⟨h, hh⟩ x
    rw [hσ] at h3
    exact h3
  
  have memc : ∀ c : ULift.{u} k, (fun _ : G => c) ∈ EllipticRootNumber.indSpace H σ := by
    intro c h g
    show c = σ h c
    rw [hσ]
    rfl
  let f : ULift.{u} k →ₗ[k] EllipticRootNumber.indSpace H σ :=
    { toFun := fun c => ⟨fun _ => c, memc c⟩
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  
  let q : EllipticRootNumber.indSpace H σ →ₗ[k] ULift.{u} k :=
    { toFun := fun φ => (φ : G → ULift.{u} k) 1 - (φ : G → ULift.{u} k) t
      map_add' := fun φ ψ => by
        simp only [Submodule.coe_add, Pi.add_apply]
        abel
      map_smul' := fun c φ => by
        simp only [Submodule.coe_smul, Pi.smul_apply, RingHom.id_apply, smul_sub] }
  have hiii : ∀ g : G, EllipticRootNumber.indRep H σ g ∘ₗ f = f := by
    intro g
    exact LinearMap.ext fun c => Subtype.ext (funext fun x => rfl)
  have hiv : ∀ g : G, q ∘ₗ EllipticRootNumber.indRep H σ g = ((η g : k) • LinearMap.id) ∘ₗ q := by
    intro g
    apply LinearMap.ext
    intro φ
    show (φ : G → ULift.{u} k) (1 * g) - (φ : G → ULift.{u} k) (t * g) =
      (η g : k) • ((φ : G → ULift.{u} k) 1 - (φ : G → ULift.{u} k) t)
    rw [one_mul]
    by_cases hg : g ∈ H
    · have h1 : (φ : G → ULift.{u} k) g = (φ : G → ULift.{u} k) 1 := by
        simpa using hev φ g 1 hg
      have htg : t * g ∉ H := fun h => ht (by simpa using H.mul_mem h (H.inv_mem hg))
      have h2 : (φ : G → ULift.{u} k) (t * g) = (φ : G → ULift.{u} k) t := by
        simpa using hev φ (t * g * t⁻¹) t (hH _ htg)
      rw [h1, h2, hηH g hg, Units.val_one, one_smul]
    · have h1 : (φ : G → ULift.{u} k) g = (φ : G → ULift.{u} k) t := by
        simpa using hev φ (g * t⁻¹) t (hH g hg)
      have h2 : (φ : G → ULift.{u} k) (t * g) = (φ : G → ULift.{u} k) 1 := by
        simpa using hev φ (t * g) 1 (hmul2 t g ht hg)
      rw [h1, h2, hηN g hg, Units.val_neg, Units.val_one, neg_one_smul, neg_sub]
  have hinj : Function.Injective f := by
    intro a b hab
    exact congrArg (fun φ : EllipticRootNumber.indSpace H σ => (φ : G → ULift.{u} k) 1) hab
  have hsurj : Function.Surjective q := by
    intro c
    have mem0 : (fun g : G => if g ∈ H then c else 0) ∈ EllipticRootNumber.indSpace H σ := by
      intro h g
      show (if (h : G) * g ∈ H then c else 0) = σ h (if g ∈ H then c else 0)
      rw [hσ, Subgroup.mul_mem_cancel_left H h.2]
      rfl
    refine ⟨⟨_, mem0⟩, ?_⟩
    show (if (1 : G) ∈ H then c else 0) - (if t ∈ H then c else 0) = c
    rw [if_pos H.one_mem, if_neg ht, sub_zero]
  have hrk : LinearMap.range f = LinearMap.ker q := by
    ext φ
    rw [LinearMap.mem_range, LinearMap.mem_ker]
    constructor
    · rintro ⟨c, rfl⟩
      show c - c = 0
      exact sub_self c
    · intro h0
      have h1 : (φ : G → ULift.{u} k) 1 - (φ : G → ULift.{u} k) t = 0 := h0
      have h0' : (φ : G → ULift.{u} k) 1 = (φ : G → ULift.{u} k) t := sub_eq_zero.mp h1
      refine ⟨(φ : G → ULift.{u} k) 1, Subtype.ext (funext fun x => ?_)⟩
      show (φ : G → ULift.{u} k) 1 = (φ : G → ULift.{u} k) x
      by_cases hx : x ∈ H
      · simpa using (hev φ x 1 hx).symm
      · rw [h0']
        simpa using (hev φ (x * t⁻¹) t (hH x hx)).symm
  exact ⟨η, f, q, hηH, hηN, hiii, hiv, hinj, hsurj, hrk⟩

theorem quadratic_fixingSubgroup_spec (F : Type u) [Field F] [CharZero F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (hM : Module.finrank F M = 2) :
    (∀ σ τ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F,
      σ ∉ M.fixingSubgroup → τ ∉ M.fixingSubgroup → σ * τ⁻¹ ∈ M.fixingSubgroup) ∧
    Algebra.IsSeparable (⊥ : IntermediateField F (AlgebraicClosure F))
      (IntermediateField.extendScalars
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) :=
by
  classical
  refine ⟨fun σ τ hσ hτ => ?_, inferInstance⟩
  let r : (AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) → (M →ₐ[F] AlgebraicClosure F) :=
    fun g => (g : AlgebraicClosure F →ₐ[F] AlgebraicClosure F).comp M.val
  have hr : ∀ g, r g = M.val → g ∈ M.fixingSubgroup := by
    intro g hg
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    have h := AlgHom.congr_fun hg ⟨x, hx⟩
    simpa [r] using h
  have hσ' : r σ⁻¹ ≠ M.val := fun h => hσ (by simpa using M.fixingSubgroup.inv_mem (hr _ h))
  have hτ' : r τ⁻¹ ≠ M.val := fun h => hτ (by simpa using M.fixingSubgroup.inv_mem (hr _ h))
  have hab : r σ⁻¹ = r τ⁻¹ := by
    by_contra hne
    have hcard := card_algHom_le_finrank F M (AlgebraicClosure F)
    rw [hM, Nat.card_eq_fintype_card] at hcard
    have h3 : 2 < Fintype.card (M →ₐ[F] AlgebraicClosure F) :=
      Fintype.two_lt_card_iff.mpr ⟨_, _, _, hne, hσ', hτ'⟩
    omega
  rw [IntermediateField.mem_fixingSubgroup_iff]
  intro x hx
  have h := AlgHom.congr_fun hab ⟨x, hx⟩
  simp only [r, AlgHom.comp_apply, IntermediateField.val_mk, AlgEquiv.coe_algHom] at h
  have h' : σ⁻¹ x = τ⁻¹ x := h
  rw [AlgEquiv.mul_apply, ← h', AlgEquiv.aut_inv, AlgEquiv.apply_symm_apply]

theorem unitGroup_valL_spec (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] (a : ℕ) (ε : Lˣ) (hε : ε ∈ EllipticRootNumber.unitGroup F L a) :
    EllipticRootNumber.valL F L (ε : L) = 0 ∧
      (1 ≤ a → (ε : L) = 1 ∨ (a : ℤ) ≤ EllipticRootNumber.valL F L ((ε : L) - 1)) :=
by
  obtain ⟨-, -, V2, V3, -, -⟩ := valL_spec F L
  have V1 : EllipticRootNumber.valL F L (1 : L) = 0 := by
    have h := V2 1 1 one_ne_zero one_ne_zero
    rw [mul_one] at h
    omega
  have V4 : ∀ x : L, EllipticRootNumber.valL F L (-x) = EllipticRootNumber.valL F L x := by
    have hm1 : EllipticRootNumber.valL F L (-1 : L) = 0 := by
      have h := V2 (-1) (-1) (neg_ne_zero.mpr one_ne_zero) (neg_ne_zero.mpr one_ne_zero)
      rw [neg_one_mul, neg_neg, V1] at h
      omega
    intro x
    by_cases hx : x = 0
    · rw [hx, neg_zero]
    rw [← neg_one_mul, V2 _ _ (neg_ne_zero.mpr one_ne_zero) hx, hm1, zero_add]
  have D1 : ∀ u : Lˣ, EllipticRootNumber.valL F L ((u⁻¹ : Lˣ) : L) =
      -EllipticRootNumber.valL F L (u : L) := by
    intro u
    have h := V2 (u : L) ((u⁻¹ : Lˣ) : L) u.ne_zero (u⁻¹).ne_zero
    rw [Units.mul_inv, V1] at h
    omega
  unfold EllipticRootNumber.unitGroup at hε
  induction hε using Subgroup.closure_induction with
  | mem u hu =>
    rw [Set.mem_setOf_eq] at hu
    by_cases ha : a = 0
    · rw [if_pos ha] at hu
      exact ⟨hu, fun h => absurd h (by omega)⟩
    · rw [if_neg ha] at hu
      by_cases h1 : (u : L) = 1
      · exact ⟨by rw [h1, V1], fun _ => Or.inl h1⟩
      · have hge := hu.resolve_left h1
        have ha1 : (1 : ℤ) ≤ (a : ℤ) := by
          have : 1 ≤ a := Nat.one_le_iff_ne_zero.mpr ha
          exact_mod_cast this
        have hsub : (u : L) - 1 ≠ 0 := sub_ne_zero.mpr h1
        refine ⟨?_, fun _ => Or.inr hge⟩
        have hid1 : (1 : L) + ((u : L) - 1) = u := by ring
        have hid2 : (u : L) + -((u : L) - 1) = 1 := by ring
        have e1 := V3 1 ((u : L) - 1) one_ne_zero hsub (by rw [hid1]; exact u.ne_zero)
        rw [hid1, V1] at e1
        have e2 := V3 (u : L) (-((u : L) - 1)) u.ne_zero (neg_ne_zero.mpr hsub)
          (by rw [hid2]; exact one_ne_zero)
        rw [hid2, V1, V4] at e2
        simp only [min_le_iff] at e1 e2
        omega
  | one =>
    exact ⟨by rw [Units.val_one, V1], fun _ => Or.inl Units.val_one⟩
  | mul x y _ _ hx hy =>
    obtain ⟨hx0, hx1⟩ := hx
    obtain ⟨hy0, hy1⟩ := hy
    rw [Units.val_mul]
    refine ⟨by rw [V2 _ _ x.ne_zero y.ne_zero, hx0, hy0, add_zero], fun ha => ?_⟩
    by_cases hp : (x : L) * y = 1
    · exact Or.inl hp
    right
    by_cases hxe : (x : L) = 1
    · rw [hxe, one_mul] at hp ⊢
      exact (hy1 ha).resolve_left hp
    by_cases hye : (y : L) = 1
    · rw [hye, mul_one] at hp ⊢
      exact (hx1 ha).resolve_left hp
    have hxa := (hx1 ha).resolve_left hxe
    have hya := (hy1 ha).resolve_left hye
    have hX : ((x : L) - 1) * y ≠ 0 := mul_ne_zero (sub_ne_zero.mpr hxe) y.ne_zero
    have hY : (y : L) - 1 ≠ 0 := sub_ne_zero.mpr hye
    have hid : (x : L) * y - 1 = ((x : L) - 1) * y + ((y : L) - 1) := by ring
    have hXY : ((x : L) - 1) * y + ((y : L) - 1) ≠ 0 := by
      rw [← hid]; exact sub_ne_zero.mpr hp
    have e := V3 _ _ hX hY hXY
    rw [← hid, V2 _ _ (sub_ne_zero.mpr hxe) y.ne_zero, hy0, add_zero] at e
    exact le_trans (le_min hxa hya) e
  | inv x _ hx =>
    obtain ⟨hx0, hx1⟩ := hx
    refine ⟨by rw [D1, hx0, neg_zero], fun ha => ?_⟩
    rw [Units.val_inv_eq_inv_val]
    by_cases hxe : (x : L) = 1
    · left
      rw [hxe, inv_one]
    right
    have hxa := (hx1 ha).resolve_left hxe
    have hid : (x : L)⁻¹ - 1 = -(((x : L) - 1) * (x : L)⁻¹) := by
      rw [sub_mul, mul_inv_cancel₀ x.ne_zero, one_mul, neg_sub]
    rw [hid, V4, V2 _ _ (sub_ne_zero.mpr hxe) (inv_ne_zero x.ne_zero),
      ← Units.val_inv_eq_inv_val, D1, hx0, neg_zero, add_zero]
    exact hxa

theorem traceChar_quadratic_spec (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (hM : Module.finrank F M = 2)
    (ψ ψ' : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F))
    (hψ : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1)
    (hψ' : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ' x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ' x ≠ 1) :
    EllipticRootNumber.IsAdmissibleChar F M (EllipticRootNumber.traceChar F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) ψ) ∧
    EllipticRootNumber.IsAdmissibleChar F M (EllipticRootNumber.traceChar F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) ψ') ∧
    EllipticRootNumber.condExpChar F M (EllipticRootNumber.traceChar F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) ψ') =
      EllipticRootNumber.condExpChar F M (EllipticRootNumber.traceChar F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) ψ) ∧
    (∀ y : M, -EllipticRootNumber.condExpChar F M (EllipticRootNumber.traceChar F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) ψ) ≤
          EllipticRootNumber.valL F M y →
      EllipticRootNumber.traceChar F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) ψ y = 1) ∧
    ∀ K : ℕ, ∃ b : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      EllipticRootNumber.valL F ⊥ (b : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 ∧
      (∀ y : (⊥ : IntermediateField F (AlgebraicClosure F)),
        -(K : ℤ) ≤ EllipticRootNumber.valL F ⊥ y → ψ' y = ψ (b * y)) ∧
      (∀ y : M, -(K : ℤ) ≤ EllipticRootNumber.valL F M y →
        EllipticRootNumber.traceChar F
            (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) ψ' y =
          EllipticRootNumber.traceChar F
            (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) ψ
            (IntermediateField.inclusion
              (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
              (b : (⊥ : IntermediateField F (AlgebraicClosure F))) * y)) :=
by
  classical
  open EllipticRootNumber in
  
  obtain ⟨hres, hrelmul, x₀, hx₀⟩ := relVal_bot_spec F
  obtain ⟨hfpos, hrv, hvmul, hult, -, -⟩ := valL_spec F M
  obtain ⟨-, -, hvmulB, -, -, -⟩ := valL_spec F (⊥ : IntermediateField F (AlgebraicClosure F))
  have haddVal0 : addVal F 0 = 0 := by
    unfold addVal
    rw [dif_pos rfl]
  have hR : ∀ a : F, relVal F (⊥ : IntermediateField F (AlgebraicClosure F))
      (algebraMap F (⊥ : IntermediateField F (AlgebraicClosure F)) a) = addVal F a := by
    intro a
    unfold relVal
    rw [Algebra.norm_algebraMap, IntermediateField.finrank_bot, pow_one]
  have hvB : ∀ a : F, valL F (⊥ : IntermediateField F (AlgebraicClosure F))
      (algebraMap F (⊥ : IntermediateField F (AlgebraicClosure F)) a) = addVal F a := by
    intro a
    unfold valL
    rw [hres, Nat.cast_one, Int.ediv_one, hR]
  have hAdd : ∀ a c : F, a ≠ 0 → c ≠ 0 → addVal F (a * c) = addVal F a + addVal F c := by
    intro a c ha hc
    rw [← hR, ← hR, ← hR, map_mul]
    exact hrelmul _ _ ((map_ne_zero _).mpr ha) ((map_ne_zero _).mpr hc)
  have hrelM : ∀ a : F, relVal F M (algebraMap F M a) = 2 * addVal F a := by
    intro a
    unfold relVal
    rw [Algebra.norm_algebraMap, hM]
    by_cases ha : a = 0
    · rw [ha, zero_pow two_ne_zero, haddVal0, mul_zero]
    · rw [pow_two, hAdd a a ha ha]
      ring
  have hbotmem : ∀ c : (⊥ : IntermediateField F (AlgebraicClosure F)),
      ∃ a : F, algebraMap F (⊥ : IntermediateField F (AlgebraicClosure F)) a = c := by
    intro c
    have hmem := c.2
    rw [IntermediateField.mem_bot] at hmem
    obtain ⟨a, ha⟩ := hmem
    exact ⟨a, Subtype.ext ha⟩
  obtain ⟨a₀, ha₀⟩ := hbotmem x₀
  have ha₀v : addVal F a₀ = 1 := by
    rw [← hR, ha₀]
    exact hx₀
  have ha₀ne : a₀ ≠ 0 := by
    rintro rfl
    rw [haddVal0] at ha₀v
    exact zero_ne_one ha₀v
  have hfle : resDeg F M ≤ 2 := by
    unfold resDeg
    apply Nat.sInf_le
    refine ⟨two_pos, algebraMap F M a₀, (map_ne_zero _).mpr ha₀ne, ?_⟩
    rw [hrelM, ha₀v]
    norm_num
  
  have hTr : ∀ y : M, traceLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) y =
      algebraMap F (⊥ : IntermediateField F (AlgebraicClosure F)) (Algebra.trace F M y) := by
    intro y
    let M' := IntermediateField.extendScalars
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
    let e : M ≃ₐ[F] M' :=
      { toFun := fun x => ⟨x.1, (IntermediateField.mem_extendScalars _).mpr x.2⟩
        invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars _).mp z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl }
    haveI : FiniteDimensional F M' := LinearEquiv.finiteDimensional e.toLinearEquiv
    haveI : FiniteDimensional (⊥ : IntermediateField F (AlgebraicClosure F)) M' :=
      Module.Finite.of_restrictScalars_finite F _ _
    have hinv : ∀ c : (⊥ : IntermediateField F (AlgebraicClosure F)),
        algebraMap F (⊥ : IntermediateField F (AlgebraicClosure F))
          (Algebra.trace F (⊥ : IntermediateField F (AlgebraicClosure F)) c) = c := by
      intro c
      obtain ⟨a, rfl⟩ := hbotmem c
      rw [Algebra.trace_algebraMap, IntermediateField.finrank_bot, one_smul]
    have h1 : traceLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) y =
        Algebra.trace (⊥ : IntermediateField F (AlgebraicClosure F)) M' (e y) := rfl
    rw [h1, ← hinv (Algebra.trace (⊥ : IntermediateField F (AlgebraicClosure F)) M' (e y)),
      Algebra.trace_trace, Algebra.trace_eq_of_algEquiv]
  
  have hι : ∀ a : F, IntermediateField.inclusion
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
      (algebraMap F (⊥ : IntermediateField F (AlgebraicClosure F)) a) = algebraMap F M a :=
    fun a => (IntermediateField.inclusion _).commutes a
  have hA1 : ∀ c : (⊥ : IntermediateField F (AlgebraicClosure F)),
      traceLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
        (IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) c) = 2 * c := by
    intro c
    obtain ⟨a, rfl⟩ := hbotmem c
    rw [hι, hTr, Algebra.trace_algebraMap, hM, map_nsmul, two_nsmul, two_mul]
  have hA2 : ∀ (c : (⊥ : IntermediateField F (AlgebraicClosure F))) (y : M),
      traceLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
        (IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) c * y) =
        c * traceLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) y := by
    intro c y
    obtain ⟨a, rfl⟩ := hbotmem c
    rw [hι, hTr, hTr, ← Algebra.smul_def, map_smul, smul_eq_mul, map_mul]
  
  have hCH : ∀ y : M, y ^ 2 - algebraMap F M (Algebra.trace F M y) * y +
      algebraMap F M (Algebra.norm F y) = 0 := by
    intro y
    let b := Module.finBasisOfFinrankEq F M hM
    have h0 := Matrix.aeval_self_charpoly (Algebra.leftMulMatrix b y)
    rw [Matrix.charpoly_fin_two, ← Algebra.trace_eq_matrix_trace b y,
      ← Algebra.norm_eq_matrix_det b y, Polynomial.aeval_algHom_apply] at h0
    have h1 := Algebra.leftMulMatrix_injective b (h0.trans (map_zero _).symm)
    simpa only [map_add, map_sub, map_mul, Polynomial.aeval_X_pow, Polynomial.aeval_X,
      Polynomial.aeval_C] using h1
  
  have s2 : ∀ y : M, Algebra.trace F M y ≠ 0 →
      relVal F M y ≤ 2 * addVal F (Algebra.trace F M y) := by
    intro y ht
    have hy : y ≠ 0 := by
      rintro rfl
      exact ht (map_zero _)
    have hn : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
    have hT : algebraMap F M (Algebra.trace F M y) ≠ 0 := (map_ne_zero _).mpr ht
    have hN : algebraMap F M (Algebra.norm F y) ≠ 0 := (map_ne_zero _).mpr hn
    have hid : algebraMap F M (Algebra.trace F M y) * y =
        y * y + algebraMap F M (Algebra.norm F y) := by
      linear_combination -(hCH y)
    have hyy : y * y ≠ 0 := mul_ne_zero hy hy
    have hsum : y * y + algebraMap F M (Algebra.norm F y) ≠ 0 := by
      rw [← hid]
      exact mul_ne_zero hT hy
    have hf0 : (resDeg F M : ℤ) ≠ 0 := by
      have := hfpos
      omega
    have hvN : valL F M (algebraMap F M (Algebra.norm F y)) = 2 * valL F M y := by
      have e1 := hrv _ hN
      have e2 := hrv y hy
      rw [hrelM] at e1
      have e3 : relVal F M y = addVal F (Algebra.norm F y) := rfl
      apply mul_left_cancel₀ hf0
      linear_combination -e1 + 2 * e2 - 2 * e3
    have hvT : (resDeg F M : ℤ) * valL F M (algebraMap F M (Algebra.trace F M y)) =
        2 * addVal F (Algebra.trace F M y) := by
      rw [← hrv _ hT, hrelM]
    have hult' := hult (y * y) _ hyy hN hsum
    rw [hvmul y y hy hy, hvN, ← hid, hvmul _ _ hT hy] at hult'
    have hle : valL F M y ≤ valL F M (algebraMap F M (Algebra.trace F M y)) := by
      rcases min_le_iff.mp hult' with h | h <;> linarith
    rw [hrv y hy, ← hvT]
    exact mul_le_mul_of_nonneg_left hle (by positivity)
  
  have hbound : ∀ (y : M) (k : ℤ), k ≤ 0 → k ≤ valL F M y →
      k ≤ valL F (⊥ : IntermediateField F (AlgebraicClosure F))
        (traceLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) y) := by
    intro y k hk hky
    rw [hTr y, hvB]
    by_cases ht : Algebra.trace F M y = 0
    · rw [ht, haddVal0]
      exact hk
    · have hy : y ≠ 0 := by
        rintro rfl
        exact ht (map_zero _)
      have key := s2 y ht
      rw [hrv y hy] at key
      have hf1 : (1 : ℤ) ≤ (resDeg F M : ℤ) := by
        have := hfpos
        omega
      have hf2 : (resDeg F M : ℤ) ≤ 2 := by
        have := hfle
        omega
      have h2k : 2 * k ≤ (resDeg F M : ℤ) * valL F M y := by
        rcases le_or_gt 0 (valL F M y) with h | h
        · nlinarith
        · nlinarith
      linarith
  have hTC : ∀ (φ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (Ω F)) (y : M),
      traceChar F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) φ y =
        φ (traceLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) y) :=
    fun _ _ => rfl
  
  have adm : ∀ φ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (Ω F),
      ((∀ x, 0 ≤ valL F ⊥ x → φ x = 1) ∧ ∃ x, valL F ⊥ x = -1 ∧ φ x ≠ 1) →
      IsAdmissibleChar F M
        (traceChar F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) φ) := by
    rintro φ ⟨h0, x₁, -, hx₁⟩
    refine ⟨fun h => hx₁ ?_, 0, fun y hy => ?_⟩
    · have h2 : traceLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
          (IntermediateField.inclusion
            (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) (x₁ * 2⁻¹)) = x₁ := by
        rw [hA1, mul_comm x₁, ← mul_assoc, mul_inv_cancel₀ two_ne_zero, one_mul]
      rw [← h2, ← hTC, h, AddChar.one_apply]
    · rw [hTC]
      exact h0 _ (hbound y 0 le_rfl hy)
  
  have twist : ∀ K : ℕ, ∃ b : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      valL F ⊥ (b : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 ∧
      (∀ y : (⊥ : IntermediateField F (AlgebraicClosure F)),
        -(K : ℤ) ≤ valL F ⊥ y → ψ' y = ψ (b * y)) ∧
      (∀ y : M, -(K : ℤ) ≤ valL F M y →
        traceChar F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) ψ' y =
          traceChar F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) ψ
            (IntermediateField.inclusion
              (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
              (b : (⊥ : IntermediateField F (AlgebraicClosure F))) * y)) := by
    intro K
    obtain ⟨b, hb, hbB⟩ := exists_unit_addChar_twist F ψ ψ' hψ hψ' K
    refine ⟨b, hb, hbB, fun y hy => ?_⟩
    rw [hTC, hTC, hA2, hbB _ (hbound y _ (by omega) hy)]
  
  have hV : ∀ c : (⊥ : IntermediateField F (AlgebraicClosure F)), c ≠ 0 → valL F ⊥ c = 0 →
      ∀ y : M, valL F M (IntermediateField.inclusion
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) c * y) = valL F M y := by
    intro c hc hc0 y
    obtain ⟨a, rfl⟩ := hbotmem c
    rw [hι]
    have ha : addVal F a = 0 := by
      rw [← hvB]
      exact hc0
    have hane : a ≠ 0 := by
      rintro rfl
      exact hc (map_zero _)
    have hvι : valL F M (algebraMap F M a) = 0 := by
      unfold valL
      rw [hrelM, ha, mul_zero, Int.zero_ediv]
    by_cases hy : y = 0
    · rw [hy, mul_zero]
    · rw [hvmul _ _ ((map_ne_zero _).mpr hane) hy, hvι, zero_add]
  
  have s4 : ∀ φ : AddChar M (Ω F), IsAdmissibleChar F M φ →
      (∀ y : M, -condExpChar F M φ ≤ valL F M y → φ y = 1) ∧
      ∀ d : ℤ, (∀ y : M, -d ≤ valL F M y → φ y = 1) → d ≤ condExpChar F M φ := by
    rintro φ ⟨hne, d₀, hd₀⟩
    obtain ⟨x₁, hx₁⟩ : ∃ x₁, φ x₁ ≠ 1 := by
      by_contra hcon
      push_neg at hcon
      exact hne (by ext x; rw [hcon x, AddChar.one_apply])
    have hS : ({d : ℤ | ∀ x : M, -d ≤ valL F M x → φ x = 1}).Nonempty :=
      ⟨-d₀, fun x hx => hd₀ x (by omega)⟩
    have hB : BddAbove {d : ℤ | ∀ x : M, -d ≤ valL F M x → φ x = 1} := by
      refine ⟨-valL F M x₁, fun d hd => ?_⟩
      by_contra hlt
      push_neg at hlt
      exact hx₁ (hd x₁ (by omega))
    unfold condExpChar
    exact ⟨Int.csSup_mem hS hB, fun d hd => le_csSup hB hd⟩
  
  obtain ⟨E1, E2⟩ := s4 _ (adm ψ hψ)
  obtain ⟨E1', E2'⟩ := s4 _ (adm ψ' hψ')
  set n := condExpChar F M
    (traceChar F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) ψ) with hn
  set n' := condExpChar F M
    (traceChar F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) ψ') with hn'
  obtain ⟨b, hb, -, hbM⟩ := twist (max n n' + 1).toNat
  have hK1 : n + 1 ≤ (((max n n' + 1).toNat : ℕ) : ℤ) := by
    have := Int.self_le_toNat (max n n' + 1)
    have := le_max_left n n'
    omega
  have hK2 : n' + 1 ≤ (((max n n' + 1).toNat : ℕ) : ℤ) := by
    have := Int.self_le_toNat (max n n' + 1)
    have := le_max_right n n'
    omega
  have hb0 : (b : (⊥ : IntermediateField F (AlgebraicClosure F))) ≠ 0 := b.ne_zero
  have hbinv : valL F ⊥ ((b⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
      (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
    have h1 := hvmulB _ _ hb0 (b⁻¹).ne_zero
    rw [Units.mul_inv] at h1
    have h11 := hvmulB 1 1 one_ne_zero one_ne_zero
    rw [mul_one] at h11
    omega
  have h1 : n ≤ n' := E2' n (fun y hy => by
    rw [hbM y (by omega)]
    exact E1 _ (by rw [hV _ hb0 hb]; exact hy))
  have h2 : n' ≤ n := E2 n' (fun y hy => by
    have hyy : IntermediateField.inclusion
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
        (b : (⊥ : IntermediateField F (AlgebraicClosure F))) *
        (IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
          ((b⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) * y) = y := by
      rw [← mul_assoc, ← map_mul, Units.mul_inv, map_one, one_mul]
    have hvy := hV _ (b⁻¹).ne_zero hbinv y
    have hz := hbM (IntermediateField.inclusion
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
        ((b⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
          (⊥ : IntermediateField F (AlgebraicClosure F))) * y) (by rw [hvy]; omega)
    rw [hyy] at hz
    rw [← hz]
    exact E1' _ (by rw [hvy]; omega))
  exact ⟨adm ψ hψ, adm ψ' hψ', le_antisymm h2 h1, E1, twist⟩

theorem tateEps_twist_of_valL (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F))
    (hmul : ∀ x y : L, x ≠ 0 → y ≠ 0 →
      EllipticRootNumber.valL F L (x * y) = EllipticRootNumber.valL F L x + EllipticRootNumber.valL F L y)
    (hU : ∀ (a : ℕ) (ε : Lˣ), ε ∈ EllipticRootNumber.unitGroup F L a →
      EllipticRootNumber.valL F L (ε : L) = 0 ∧
        (1 ≤ a → (ε : L) = 1 ∨ (a : ℤ) ≤ EllipticRootNumber.valL F L ((ε : L) - 1)))
    (hwit : ∃ x : L, EllipticRootNumber.valL F L x = 1)
    (χ₀ : Lˣ →* (EllipticRootNumber.Ω F)ˣ)
    (hcont : ∃ a : ℕ, ∀ u ∈ EllipticRootNumber.unitGroup F L a, χ₀ u = 1)
    (φ φ' : AddChar L (EllipticRootNumber.Ω F)) (n : ℤ)
    (hn : EllipticRootNumber.condExpChar F L φ = n) (hn' : EllipticRootNumber.condExpChar F L φ' = n)
    (hφ : ∀ y : L, -n ≤ EllipticRootNumber.valL F L y → φ y = 1)
    (b : Lˣ) (hb : EllipticRootNumber.valL F L (b : L) = 0)
    (hbφ : ∀ y : L, -((EllipticRootNumber.condExp F L χ₀ : ℤ) + n) ≤ EllipticRootNumber.valL F L y →
      φ' y = φ (b * y)) :
    EllipticRootNumber.tateEps F L χ₀ φ' =
      (χ₀ b : EllipticRootNumber.Ω F) * EllipticRootNumber.tateEps F L χ₀ φ :=
by
  classical
  
  have V2 : EllipticRootNumber.valL F L (1 : L) = 0 := by
    have h := hmul 1 1 one_ne_zero one_ne_zero
    rw [one_mul] at h
    omega
  have V3 : ∀ x y : Lˣ, EllipticRootNumber.valL F L ((x * y : Lˣ) : L) =
      EllipticRootNumber.valL F L (x : L) + EllipticRootNumber.valL F L (y : L) := by
    intro x y
    rw [Units.val_mul]
    exact hmul _ _ x.ne_zero y.ne_zero
  have V4 : ∀ x : Lˣ, EllipticRootNumber.valL F L ((x⁻¹ : Lˣ) : L) =
      -EllipticRootNumber.valL F L (x : L) := by
    intro x
    have h := V3 x x⁻¹
    rw [mul_inv_cancel, Units.val_one, V2] at h
    omega
  
  have hv0 : EllipticRootNumber.valL F L (0 : L) = 0 := by
    by_cases hfin : ∃ s : Finset L, Nonempty (Module.Basis s F L)
    · obtain ⟨s, ⟨B⟩⟩ := hfin
      haveI := Module.Finite.of_basis B
      haveI := Module.Free.of_basis B
      unfold EllipticRootNumber.valL EllipticRootNumber.relVal
      rw [Algebra.norm_zero]
      unfold EllipticRootNumber.addVal
      rw [dif_pos rfl]
      exact Int.zero_ediv _
    · have h01 : Algebra.norm F (0 : L) = Algebra.norm F (1 : L) := by
        rw [Algebra.norm_eq_one_of_not_exists_basis F hfin,
          Algebra.norm_eq_one_of_not_exists_basis F hfin]
      have h : EllipticRootNumber.valL F L (0 : L) = EllipticRootNumber.valL F L (1 : L) := by
        unfold EllipticRootNumber.valL EllipticRootNumber.relVal
        rw [h01]
      rw [h, V2]
  obtain ⟨x, hx1⟩ := hwit
  have hx0 : x ≠ 0 := by
    rintro rfl
    rw [hv0] at hx1
    exact zero_ne_one hx1
  
  set π : Lˣ := Units.mk0 x hx0 with hπdef
  have hπ : EllipticRootNumber.valL F L (π : L) = 1 := by
    rw [hπdef, Units.val_mk0]; exact hx1
  have hpow : ∀ m : ℕ, EllipticRootNumber.valL F L ((π ^ m : Lˣ) : L) = m := by
    intro m
    induction m with
    | zero => rw [pow_zero, Units.val_one, V2]; rfl
    | succ m ih =>
      rw [pow_succ, V3, ih, hπ]
      push_cast
      ring
  have hzpow : ∀ k : ℤ, EllipticRootNumber.valL F L ((π ^ k : Lˣ) : L) = k := by
    intro k
    cases k with
    | ofNat m => rw [Int.ofNat_eq_coe, zpow_natCast, hpow]
    | negSucc m =>
      rw [zpow_negSucc, V4, hpow, Int.negSucc_eq]
      push_cast
      ring
  have hex : ∃ c₀ : Lˣ, EllipticRootNumber.valL F L (c₀ : L) =
      (EllipticRootNumber.condExp F L χ₀ : ℤ) + n :=
    ⟨π ^ ((EllipticRootNumber.condExp F L χ₀ : ℤ) + n), hzpow _⟩
  
  have hT : EllipticRootNumber.tateElt F L χ₀ φ' = EllipticRootNumber.tateElt F L χ₀ φ := by
    unfold EllipticRootNumber.tateElt
    rw [hn, hn']
  have hvc : EllipticRootNumber.valL F L ((EllipticRootNumber.tateElt F L χ₀ φ : Lˣ) : L) =
      (EllipticRootNumber.condExp F L χ₀ : ℤ) + n := by
    obtain ⟨c₀, hc₀⟩ := hex
    have hspec := Classical.epsilon_spec
      (p := fun c : Lˣ => EllipticRootNumber.valL F L (c : L) =
          EllipticRootNumber.condExp F L χ₀ + EllipticRootNumber.condExpChar F L φ)
      ⟨c₀, by rw [hn]; exact hc₀⟩
    unfold EllipticRootNumber.tateElt
    refine hspec.trans ?_
    rw [hn]
  
  have hK2 : ∀ ε ∈ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ₀),
      χ₀ ε = 1 :=
    Nat.sInf_mem (s := {a : ℕ | ∀ u ∈ EllipticRootNumber.unitGroup F L a, χ₀ u = 1}) hcont
  by_cases ha0 : EllipticRootNumber.condExp F L χ₀ = 0
  · 
    have hbU : b ∈ EllipticRootNumber.unitGroup F L 0 := by
      apply Subgroup.subset_closure
      show (if (0 : ℕ) = 0 then EllipticRootNumber.valL F L (b : L) = 0
        else ((b : L) = 1 ∨ ((0 : ℕ) : ℤ) ≤ EllipticRootNumber.valL F L ((b : L) - 1)))
      rw [if_pos rfl]
      exact hb
    rw [ha0] at hK2
    have hb1 : χ₀ b = 1 := hK2 b hbU
    unfold EllipticRootNumber.tateEps
    rw [hT, hn, hn', if_pos ha0, if_pos ha0, hb1, Units.val_one, one_mul]
  
  have ha1 : 1 ≤ EllipticRootNumber.condExp F L χ₀ := Nat.one_le_iff_ne_zero.mpr ha0
  haveI hN : (EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ₀)).Normal :=
    Subgroup.normal_of_comm _
  have key : ∀ (f f' : Lˣ → EllipticRootNumber.Ω F),
      (∀ x, ∀ ε ∈ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ₀),
        f (x * ε) = f x) →
      (∀ x, f' x = (χ₀ b : EllipticRootNumber.Ω F) * f (b * x)) →
      ∑ᶠ u : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ₀),
          f' (EllipticRootNumber.cosetRep u) =
        (χ₀ b : EllipticRootNumber.Ω F) *
          ∑ᶠ u : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ₀),
            f (EllipticRootNumber.cosetRep u) := by
    intro f f' hf htw
    have R1 : ∀ u : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ₀),
        f (EllipticRootNumber.cosetRep
            (((b : Lˣ) : Lˣ ⧸ EllipticRootNumber.unitGroup F L
              (EllipticRootNumber.condExp F L χ₀)) * u)) =
          f (b * EllipticRootNumber.cosetRep u) := by
      intro u
      have h1 : ((b * EllipticRootNumber.cosetRep u : Lˣ) :
            Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ₀)) =
          ((EllipticRootNumber.cosetRep
            (((b : Lˣ) : Lˣ ⧸ EllipticRootNumber.unitGroup F L
              (EllipticRootNumber.condExp F L χ₀)) * u) : Lˣ) :
            Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ₀)) := by
        rw [QuotientGroup.mk_mul]
        unfold EllipticRootNumber.cosetRep
        rw [QuotientGroup.out_eq', QuotientGroup.out_eq']
      rw [QuotientGroup.eq] at h1
      have h2 := hf (b * EllipticRootNumber.cosetRep u) _ h1
      rw [mul_inv_cancel_left] at h2
      exact h2
    calc ∑ᶠ u : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ₀),
          f' (EllipticRootNumber.cosetRep u)
        = ∑ᶠ u : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ₀),
          (χ₀ b : EllipticRootNumber.Ω F) * f (EllipticRootNumber.cosetRep
            (((b : Lˣ) : Lˣ ⧸ EllipticRootNumber.unitGroup F L
              (EllipticRootNumber.condExp F L χ₀)) * u)) :=
          finsum_congr (fun u => by rw [htw, R1])
      _ = (χ₀ b : EllipticRootNumber.Ω F) *
          ∑ᶠ u : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ₀),
          f (EllipticRootNumber.cosetRep
            (((b : Lˣ) : Lˣ ⧸ EllipticRootNumber.unitGroup F L
              (EllipticRootNumber.condExp F L χ₀)) * u)) :=
          (mul_finsum _ _).symm
      _ = (χ₀ b : EllipticRootNumber.Ω F) *
          ∑ᶠ u : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ₀),
          f (EllipticRootNumber.cosetRep u) := by
        congr 1
        exact finsum_comp_equiv (Equiv.mulLeft
          ((b : Lˣ) : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ₀)))
          (f := fun u => f (EllipticRootNumber.cosetRep u))
  
  unfold EllipticRootNumber.tateEps
  rw [hT, hn, hn', if_neg ha0, if_neg ha0]
  generalize hcdef : EllipticRootNumber.tateElt F L χ₀ φ = c at hvc ⊢
  simp only [finsum_eq_if]
  rw [mul_left_comm (χ₀ b : EllipticRootNumber.Ω F)]
  congr 1
  refine key
    (fun x => if EllipticRootNumber.valL F L (x : L) = 0
      then (χ₀ (c⁻¹ * x) : EllipticRootNumber.Ω F)⁻¹ * φ ((c⁻¹ * x : Lˣ) : L)
      else 0)
    (fun x => if EllipticRootNumber.valL F L (x : L) = 0
      then (χ₀ (c⁻¹ * x) : EllipticRootNumber.Ω F)⁻¹ * φ' ((c⁻¹ * x : Lˣ) : L)
      else 0) ?_ ?_
  · 
    intro x ε hε
    obtain ⟨hε0, hε1⟩ := hU _ ε hε
    have hvxe : EllipticRootNumber.valL F L ((x * ε : Lˣ) : L) =
        EllipticRootNumber.valL F L (x : L) := by
      rw [V3, hε0, add_zero]
    beta_reduce
    rw [hvxe]
    split_ifs with hx
    · have e1 : c⁻¹ * (x * ε) = (c⁻¹ * x) * ε := (mul_assoc _ _ _).symm
      rw [e1, map_mul χ₀ (c⁻¹ * x) ε, hK2 ε hε, mul_one, Units.val_mul (c⁻¹ * x) ε]
      congr 1
      have hsplit : ((c⁻¹ * x : Lˣ) : L) * (ε : L) =
          ((c⁻¹ * x : Lˣ) : L) + ((c⁻¹ * x : Lˣ) : L) * ((ε : L) - 1) := by ring
      rw [hsplit, AddChar.map_add_eq_mul]
      have h1 : φ (((c⁻¹ * x : Lˣ) : L) * ((ε : L) - 1)) = 1 := by
        by_cases hε' : (ε : L) = 1
        · rw [hε', sub_self, mul_zero, AddChar.map_zero_eq_one]
        · rcases hε1 ha1 with h | h
          · exact absurd h hε'
          · apply hφ
            rw [hmul _ _ (Units.ne_zero _) (sub_ne_zero.mpr hε'), V3, V4, hvc, hx]
            omega
      rw [h1, mul_one]
    · rfl
  · 
    intro x
    have hvbx : EllipticRootNumber.valL F L ((b * x : Lˣ) : L) =
        EllipticRootNumber.valL F L (x : L) := by
      rw [V3, hb, zero_add]
    beta_reduce
    rw [hvbx]
    split_ifs with hx
    · have hvy : EllipticRootNumber.valL F L ((c⁻¹ * x : Lˣ) : L) =
          -((EllipticRootNumber.condExp F L χ₀ : ℤ) + n) := by
        rw [V3, V4, hvc, hx, add_zero]
      have h1 := hbφ ((c⁻¹ * x : Lˣ) : L) (le_of_eq hvy.symm)
      have h2 : c⁻¹ * (b * x) = b * (c⁻¹ * x) := mul_left_comm _ _ _
      have e1 : ((c⁻¹ * (b * x) : Lˣ) : L) = (b : L) * ((c⁻¹ * x : Lˣ) : L) := by
        rw [h2, Units.val_mul]
      have e2 : (χ₀ (c⁻¹ * (b * x)) : EllipticRootNumber.Ω F) =
          (χ₀ b : EllipticRootNumber.Ω F) * (χ₀ (c⁻¹ * x) : EllipticRootNumber.Ω F) := by
        rw [h2, map_mul, Units.val_mul]
      have hne : (χ₀ b : EllipticRootNumber.Ω F) ≠ 0 := Units.ne_zero _
      rw [e1, e2, ← h1, mul_inv, ← mul_assoc, ← mul_assoc, mul_inv_cancel₀ hne, one_mul]
    · rw [mul_zero]

theorem transfer_index_two_mod {G : Type*} [Group G] (H K : Subgroup G) (t : G) (ht : t ∉ H)
    (hH : ∀ σ τ : G, σ ∉ H → τ ∉ H → σ * τ⁻¹ ∈ H)
    (hKn : ∀ g : G, ∀ k ∈ K, g * k * g⁻¹ ∈ K) (hKH : K ≤ H)
    (hab : ∀ a ∈ H, ∀ b ∈ H, a * b * a⁻¹ * b⁻¹ ∈ K)
    (V : G → G) (hV₁ : ∀ g ∈ H, V g = g * (t * g * t⁻¹)) (hV₂ : ∀ g ∉ H, V g = g * g) :
    (∀ g₁ g₂, (V (g₁ * g₂))⁻¹ * (V g₁ * V g₂) ∈ K) ∧
    (∀ g c k, c ∈ ⁅(⊤ : Subgroup G), (⊤ : Subgroup G)⁆ → k ∈ K →
      (V g)⁻¹ * V (g * (c * k)) ∈ K) :=
by
  haveI hN : K.Normal := ⟨fun k hk g => hKn g k hk⟩
  have F1 : ∀ g, g ∉ H → g * t⁻¹ ∈ H := fun g hg => hH g t hg ht
  have F2 : ∀ x ∈ H, t * x * t⁻¹ ∈ H := by
    intro x hx
    have htx : t * x ∉ H := fun h => ht (by simpa using H.mul_mem h (H.inv_mem hx))
    exact hH (t * x) t htx ht
  have F5 : ∀ σ τ : G, σ ∉ H → τ ∉ H → σ * τ ∈ H := by
    intro σ τ hσ hτ
    have := hH σ τ⁻¹ hσ (fun h => hτ (by simpa using H.inv_mem h))
    simpa using this
  have F4l : ∀ x g : G, x ∈ H → g ∉ H → x * g ∉ H := fun x g hx hg h =>
    hg (by simpa using H.mul_mem (H.inv_mem hx) h)
  have F4r : ∀ x g : G, x ∈ H → g ∉ H → g * x ∉ H := fun x g hx hg h =>
    hg (by simpa using H.mul_mem h (H.inv_mem hx))
  have hs : t * t ∈ H := F5 t t ht ht
  have CM : ∀ a ∈ H, ∀ b ∈ H, Commute ((a : G ⧸ K)) ((b : G ⧸ K)) := by
    intro a ha b hb
    show (a : G ⧸ K) * b = b * a
    rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq]
    have e : (a * b)⁻¹ * (b * a) = b⁻¹ * a⁻¹ * b⁻¹⁻¹ * a⁻¹⁻¹ := by group
    rw [e]
    exact hab _ (H.inv_mem hb) _ (H.inv_mem ha)
  have hVmem : ∀ g, V g ∈ H := by
    intro g
    by_cases hg : g ∈ H
    · rw [hV₁ g hg]; exact H.mul_mem hg (F2 g hg)
    · rw [hV₂ g hg]; exact F5 g g hg hg
  have hVK : ∀ k ∈ K, V k ∈ K := by
    intro k hk
    rw [hV₁ k (hKH hk)]
    exact K.mul_mem hk (hKn t k hk)
  have hmulQ : ∀ g₁ g₂ : G, ((V (g₁ * g₂) : G) : G ⧸ K) = (V g₁ : G ⧸ K) * (V g₂ : G ⧸ K) := by
    intro g₁ g₂
    by_cases h1 : g₁ ∈ H <;> by_cases h2 : g₂ ∈ H
    · have m1 := F2 g₁ h1
      have m2 := F2 g₂ h2
      rw [hV₁ _ (H.mul_mem h1 h2), hV₁ _ h1, hV₁ _ h2]
      have e : g₁ * g₂ * (t * (g₁ * g₂) * t⁻¹) =
          g₁ * (g₂ * ((t * g₁ * t⁻¹) * (t * g₂ * t⁻¹))) := by group
      rw [e]
      generalize t * g₁ * t⁻¹ = c1 at m1 ⊢
      generalize t * g₂ * t⁻¹ = c2 at m2 ⊢
      simp only [QuotientGroup.mk_mul, mul_assoc]
      rw [(CM _ h2 _ m1).left_comm]
    · obtain ⟨h, hh, rfl⟩ : ∃ h ∈ H, g₂ = h * t := ⟨g₂ * t⁻¹, F1 g₂ h2, by group⟩
      have m1 := F2 g₁ h1
      have mh := F2 h hh
      rw [hV₂ _ (F4l _ _ h1 h2), hV₁ _ h1, hV₂ _ h2]
      have e1 : g₁ * (h * t) * (g₁ * (h * t)) =
          g₁ * (h * ((t * g₁ * t⁻¹) * ((t * h * t⁻¹) * (t * t)))) := by group
      have e2 : h * t * (h * t) = h * ((t * h * t⁻¹) * (t * t)) := by group
      rw [e1, e2]
      generalize t * g₁ * t⁻¹ = c1 at m1 ⊢
      generalize t * h * t⁻¹ = ch at mh ⊢
      generalize t * t = s at hs ⊢
      simp only [QuotientGroup.mk_mul, mul_assoc]
      rw [(CM _ hh _ m1).left_comm]
    · obtain ⟨h₁, hh₁, rfl⟩ : ∃ h ∈ H, g₁ = h * t := ⟨g₁ * t⁻¹, F1 g₁ h1, by group⟩
      have m2 := F2 g₂ h2
      have mh := F2 h₁ hh₁
      rw [hV₂ _ (F4r _ _ h2 h1), hV₂ _ h1, hV₁ _ h2]
      have e1 : h₁ * t * g₂ * (h₁ * t * g₂) =
          h₁ * ((t * g₂ * t⁻¹) * ((t * h₁ * t⁻¹) * ((t * t) * g₂))) := by group
      have e2 : h₁ * t * (h₁ * t) = h₁ * ((t * h₁ * t⁻¹) * (t * t)) := by group
      rw [e1, e2]
      generalize t * g₂ * t⁻¹ = c2 at m2 ⊢
      generalize t * h₁ * t⁻¹ = ch at mh ⊢
      generalize t * t = s at hs ⊢
      simp only [QuotientGroup.mk_mul, mul_assoc]
      conv_lhs => rw [(CM _ m2 _ mh).left_comm, (CM _ m2 _ hs).left_comm, (CM _ m2 _ h2).eq]
    · obtain ⟨h₁, hh₁, rfl⟩ : ∃ h ∈ H, g₁ = h * t := ⟨g₁ * t⁻¹, F1 g₁ h1, by group⟩
      obtain ⟨h₂, hh₂, rfl⟩ : ∃ h ∈ H, g₂ = h * t := ⟨g₂ * t⁻¹, F1 g₂ h2, by group⟩
      have m1 := F2 h₁ hh₁
      have m2 := F2 h₂ hh₂
      rw [hV₁ _ (F5 _ _ h1 h2), hV₂ _ h1, hV₂ _ h2]
      have e1 : h₁ * t * (h₂ * t) * (t * (h₁ * t * (h₂ * t)) * t⁻¹) =
          h₁ * ((t * h₂ * t⁻¹) * ((t * t) * ((t * h₁ * t⁻¹) * ((t * t) * h₂)))) := by group
      have e2 : h₁ * t * (h₁ * t) = h₁ * ((t * h₁ * t⁻¹) * (t * t)) := by group
      have e3 : h₂ * t * (h₂ * t) = h₂ * ((t * h₂ * t⁻¹) * (t * t)) := by group
      rw [e1, e2, e3]
      generalize t * h₁ * t⁻¹ = c1 at m1 ⊢
      generalize t * h₂ * t⁻¹ = c2 at m2 ⊢
      generalize t * t = s at hs ⊢
      simp only [QuotientGroup.mk_mul, mul_assoc]
      conv_lhs =>
        rw [(CM _ m2 _ hs).left_comm, (CM _ m2 _ m1).left_comm, (CM _ m2 _ hs).left_comm,
          (CM _ m2 _ hh₂).eq, (CM _ hs _ m1).left_comm, (CM _ hs _ hh₂).left_comm,
          (CM _ hs _ m2).eq]
  refine ⟨fun g₁ g₂ => ?_, ?_⟩
  · apply QuotientGroup.eq.mp
    rw [QuotientGroup.mk_mul]
    exact hmulQ g₁ g₂
  · intro g c k hc hk
    let φ : G →* G ⧸ K := MonoidHom.mk' (fun g => ((V g : G) : G ⧸ K)) hmulQ
    have hker : ⁅(⊤ : Subgroup G), (⊤ : Subgroup G)⁆ ≤ φ.ker := by
      rw [Subgroup.commutator_le]
      intro x _ y _
      rw [MonoidHom.mem_ker, map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
      exact (CM _ (hVmem x) _ (hVmem y)).eq
    have hφc : φ c = 1 := hker hc
    have hφk : φ k = 1 := by
      show ((V k : G) : G ⧸ K) = 1
      exact (QuotientGroup.eq_one_iff _).mpr (hVK k hk)
    have key : φ g = φ (g * (c * k)) := by
      rw [map_mul, map_mul, hφc, hφk, one_mul, mul_one]
    change ((V g : G) : G ⧸ K) = ((V (g * (c * k)) : G) : G ⧸ K) at key
    exact QuotientGroup.eq.mp key

theorem exists_galois_abelian_hull (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (hM : Module.finrank F M = 2)
    (N : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F N] (hMN : M ≤ N)
    (hab : EllipticRootNumber.IsAbelianExt F hMN) :
    ∃ (N' : IntermediateField F (AlgebraicClosure F)) (h' : M ≤ N'),
      FiniteDimensional F N' ∧ EllipticRootNumber.IsAbelianExt F h' ∧ N ≤ N' ∧
      ∀ (σ : EllipticRootNumber.AbsGal F) (y : AlgebraicClosure F), y ∈ N' ↔ σ y ∈ N' :=
by
  classical
  have hA : ∀ σ τ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F,
      σ ∉ M.fixingSubgroup → τ ∉ M.fixingSubgroup → σ * τ⁻¹ ∈ M.fixingSubgroup := by
    intro σ τ hσ hτ
    let r : (AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) → (M →ₐ[F] AlgebraicClosure F) :=
      fun g => (g : AlgebraicClosure F →ₐ[F] AlgebraicClosure F).comp M.val
    have hr : ∀ g, r g = M.val → g ∈ M.fixingSubgroup := by
      intro g hg
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      have h := AlgHom.congr_fun hg ⟨x, hx⟩
      simpa [r] using h
    have hσ' : r σ⁻¹ ≠ M.val := fun h =>
      hσ (by simpa using M.fixingSubgroup.inv_mem (hr _ h))
    have hτ' : r τ⁻¹ ≠ M.val := fun h =>
      hτ (by simpa using M.fixingSubgroup.inv_mem (hr _ h))
    have hrr : r σ⁻¹ = r τ⁻¹ := by
      by_contra hne
      have hcard := card_algHom_le_finrank F M (AlgebraicClosure F)
      rw [hM, Nat.card_eq_fintype_card] at hcard
      have h3 : 2 < Fintype.card (M →ₐ[F] AlgebraicClosure F) :=
        Fintype.two_lt_card_iff.mpr ⟨_, _, _, hne, hσ', hτ'⟩
      omega
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    have h := AlgHom.congr_fun hrr ⟨x, hx⟩
    simp only [r, AlgHom.comp_apply, IntermediateField.val_mk, AlgEquiv.coe_algHom] at h
    have h' : σ⁻¹ x = τ⁻¹ x := h
    rw [AlgEquiv.mul_apply, ← h', AlgEquiv.aut_inv, AlgEquiv.apply_symm_apply]
  obtain ⟨hB, hB2, -⟩ := hab
  
  obtain ⟨t, ht⟩ : ∃ t : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F,
      ∀ σ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F,
        σ ∉ M.fixingSubgroup → t ∉ M.fixingSubgroup := by
    by_cases h : ∃ t₀ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F, t₀ ∉ M.fixingSubgroup
    · obtain ⟨t₀, ht₀⟩ := h
      exact ⟨t₀, fun _ _ => ht₀⟩
    · exact ⟨1, fun σ hσ => absurd ⟨σ, hσ⟩ h⟩
  
  have N1 : ∀ g ∈ M.fixingSubgroup, t⁻¹ * g * t ∈ M.fixingSubgroup := by
    intro g hg
    by_cases htA : t ∈ M.fixingSubgroup
    · exact M.fixingSubgroup.mul_mem
        (M.fixingSubgroup.mul_mem (M.fixingSubgroup.inv_mem htA) hg) htA
    · have hx : t⁻¹ ∉ M.fixingSubgroup := fun h =>
        htA (by simpa using M.fixingSubgroup.inv_mem h)
      have hy : t⁻¹ * g⁻¹ ∉ M.fixingSubgroup := fun h =>
        hx (by simpa using M.fixingSubgroup.mul_mem h hg)
      have h3 := hA _ _ hx hy
      have e : t⁻¹ * (t⁻¹ * g⁻¹)⁻¹ = t⁻¹ * g * t := by group
      rw [e] at h3
      exact h3
  
  have H1 : ∀ σ τ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F,
      τ ∈ N.fixingSubgroup → t⁻¹ * τ * t ∈ N.fixingSubgroup →
        σ * τ * σ⁻¹ ∈ N.fixingSubgroup ∧ t⁻¹ * (σ * τ * σ⁻¹) * t ∈ N.fixingSubgroup := by
    intro σ τ hτ htτ
    by_cases hσ : σ ∈ M.fixingSubgroup
    · refine ⟨hB σ hσ τ hτ, ?_⟩
      have h3 := hB _ (N1 σ hσ) _ htτ
      have e : t⁻¹ * σ * t * (t⁻¹ * τ * t) * (t⁻¹ * σ * t)⁻¹ = t⁻¹ * (σ * τ * σ⁻¹) * t := by
        group
      rw [e] at h3
      exact h3
    · have htA := ht σ hσ
      have hti : t⁻¹ ∉ M.fixingSubgroup := fun h =>
        htA (by simpa using M.fixingSubgroup.inv_mem h)
      have hσi : σ⁻¹ ∉ M.fixingSubgroup := fun h =>
        hσ (by simpa using M.fixingSubgroup.inv_mem h)
      have hg : σ * t⁻¹ ∈ M.fixingSubgroup := hA σ t hσ htA
      have htt : t * t ∈ M.fixingSubgroup := by
        have h3 := hA t t⁻¹ htA hti
        rw [inv_inv] at h3
        exact h3
      have h1 : t * τ * t⁻¹ ∈ N.fixingSubgroup := by
        have h3 := hB _ htt _ htτ
        have e : t * t * (t⁻¹ * τ * t) * (t * t)⁻¹ = t * τ * t⁻¹ := by group
        rw [e] at h3
        exact h3
      refine ⟨?_, ?_⟩
      · have h3 := hB _ hg _ h1
        have e : σ * t⁻¹ * (t * τ * t⁻¹) * (σ * t⁻¹)⁻¹ = σ * τ * σ⁻¹ := by group
        rw [e] at h3
        exact h3
      · have hh : t⁻¹ * σ ∈ M.fixingSubgroup := by
          have h3 := hA t⁻¹ σ⁻¹ hti hσi
          rw [inv_inv] at h3
          exact h3
        have h3 := hB _ hh _ hτ
        have e : t⁻¹ * σ * τ * (t⁻¹ * σ)⁻¹ = t⁻¹ * (σ * τ * σ⁻¹) * t := by group
        rw [e] at h3
        exact h3
  have H2 : ∀ σ ∈ M.fixingSubgroup, ∀ τ ∈ M.fixingSubgroup,
      t⁻¹ * (σ * τ * σ⁻¹ * τ⁻¹) * t ∈ N.fixingSubgroup := by
    intro σ hσ τ hτ
    have h3 := hB2 _ (N1 σ hσ) _ (N1 τ hτ)
    have e : t⁻¹ * σ * t * (t⁻¹ * τ * t) * (t⁻¹ * σ * t)⁻¹ * (t⁻¹ * τ * t)⁻¹ =
        t⁻¹ * (σ * τ * σ⁻¹ * τ⁻¹) * t := by group
    rw [e] at h3
    exact h3
  
  set N' : IntermediateField F (AlgebraicClosure F) :=
    N ⊔ IntermediateField.map (t : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) N with hN'
  have hfd : FiniteDimensional F N' := inferInstance
  have hC : ∀ τ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F,
      τ ∈ N'.fixingSubgroup ↔ τ ∈ N.fixingSubgroup ∧ t⁻¹ * τ * t ∈ N.fixingSubgroup := by
    intro τ
    rw [hN', IntermediateField.fixingSubgroup_sup, Subgroup.mem_inf]
    apply and_congr Iff.rfl
    rw [IntermediateField.mem_fixingSubgroup_iff, IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro h y hy
      have hmem : t y ∈ IntermediateField.map (t : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) N := by
        rw [← SetLike.mem_coe, IntermediateField.coe_map]
        exact ⟨y, hy, rfl⟩
      have h2 : τ (t y) = t y := h _ hmem
      rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, h2, ← AlgEquiv.mul_apply, inv_mul_cancel,
        AlgEquiv.one_apply]
    · intro h x hx
      rw [← SetLike.mem_coe, IntermediateField.coe_map] at hx
      obtain ⟨y, hy, rfl⟩ := hx
      have h2 := congrArg t (h y hy)
      rw [← AlgEquiv.mul_apply] at h2
      have e : t * (t⁻¹ * τ * t) = τ * t := by group
      rw [e, AlgEquiv.mul_apply] at h2
      exact h2
  have hnorm : ∀ σ τ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F,
      τ ∈ N'.fixingSubgroup → σ * τ * σ⁻¹ ∈ N'.fixingSubgroup := by
    intro σ τ hτ
    obtain ⟨h₁, h₂⟩ := (hC τ).1 hτ
    exact (hC _).2 (H1 σ τ h₁ h₂)
  have h' : M ≤ N' := hMN.trans le_sup_left
  have hab' : EllipticRootNumber.IsAbelianExt F h' := by
    refine ⟨fun σ _ τ hτ => hnorm σ τ hτ,
      fun σ hσ τ hτ => (hC _).2 ⟨hB2 σ hσ τ hτ, H2 σ hσ τ hτ⟩, ?_⟩
    exact Algebra.IsAlgebraic.isSeparable_of_perfectField
  have fwd : ∀ (σ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) (y : AlgebraicClosure F),
      y ∈ N' → σ y ∈ N' := by
    intro σ y hy
    have hfix := InfiniteGalois.fixedField_fixingSubgroup N'
    rw [← hfix, IntermediateField.mem_fixedField_iff]
    intro τ hτ
    have h1 := hnorm σ⁻¹ τ hτ
    rw [inv_inv, IntermediateField.mem_fixingSubgroup_iff] at h1
    have h2 := h1 y hy
    rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply] at h2
    have h3 := congrArg σ h2
    rw [← AlgEquiv.mul_apply σ σ⁻¹, mul_inv_cancel, AlgEquiv.one_apply] at h3
    exact h3
  refine ⟨N', h', hfd, hab', le_sup_left, fun σ y => ⟨fwd σ y, fun hσy => ?_⟩⟩
  have h4 := fwd σ⁻¹ (σ y) hσy
  rw [← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply] at h4
  exact h4

theorem exists_abelian_commutator_field (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    (N' : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F N'] :
    ∃ N₀ : IntermediateField F (AlgebraicClosure F),
      FiniteDimensional F N₀ ∧
      EllipticRootNumber.IsAbelianExt F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ N₀) ∧
      N'.fixingSubgroup ≤ N₀.fixingSubgroup ∧
      ∀ k ∈ N₀.fixingSubgroup, ∃ c ∈ ⁅(⊤ : Subgroup (EllipticRootNumber.AbsGal F)),
          (⊤ : Subgroup (EllipticRootNumber.AbsGal F))⁆,
        ∃ n ∈ N'.fixingSubgroup, k = c * n :=
by
  classical
  let N : IntermediateField F (AlgebraicClosure F) :=
    IntermediateField.normalClosure F N' (AlgebraicClosure F)
  haveI : FiniteDimensional F N := normalClosure.is_finiteDimensional F N' (AlgebraicClosure F)
  haveI : Normal F N := normalClosure.normal F N' (AlgebraicClosure F)
  have hN'N : N' ≤ N := IntermediateField.le_normalClosure N'
  let r : EllipticRootNumber.AbsGal F →* (N ≃ₐ[F] N) := AlgEquiv.restrictNormalHom N
  have hr : ∀ (σ : EllipticRootNumber.AbsGal F) (y : N),
      ((r σ y : N) : AlgebraicClosure F) = σ y :=
    fun σ y => AlgEquiv.restrictNormalHom_apply _ σ y
  let D : Subgroup (EllipticRootNumber.AbsGal F) :=
    ⁅(⊤ : Subgroup (EllipticRootNumber.AbsGal F)), (⊤ : Subgroup (EllipticRootNumber.AbsGal F))⁆
  let S : Subgroup (EllipticRootNumber.AbsGal F) := D ⊔ N'.fixingSubgroup
  let Kb : Subgroup (N ≃ₐ[F] N) := S.map r
  let N₀ : IntermediateField F (AlgebraicClosure F) :=
    IntermediateField.lift (IntermediateField.fixedField Kb)
  have hN₀N : N₀ ≤ N := IntermediateField.lift_le _
  haveI hfin : FiniteDimensional F N₀ :=
    FiniteDimensional.of_injective (IntermediateField.inclusion hN₀N).toLinearMap
      (IntermediateField.inclusion hN₀N).injective
  have KF : ∀ σ : EllipticRootNumber.AbsGal F, σ ∈ N₀.fixingSubgroup ↔ r σ ∈ Kb := by
    intro σ
    conv_rhs => rw [← IntermediateField.fixingSubgroup_fixedField Kb]
    simp only [IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro h y hy
      apply Subtype.ext
      rw [hr]
      exact h _ ((IntermediateField.mem_lift y).mpr hy)
    · intro h z hz
      have hzN : z ∈ N := IntermediateField.lift_le _ hz
      have hy : (⟨z, hzN⟩ : N) ∈ IntermediateField.fixedField Kb :=
        (IntermediateField.mem_lift (⟨z, hzN⟩ : N)).mp hz
      have := congrArg Subtype.val (h _ hy)
      rw [hr] at this
      exact this
  have KF0 : ∀ σ : EllipticRootNumber.AbsGal F, r σ = 1 → σ ∈ N.fixingSubgroup := by
    intro σ h
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    have := hr σ ⟨x, hx⟩
    rw [h, AlgEquiv.one_apply] at this
    exact this.symm
  have key : ∀ σ : EllipticRootNumber.AbsGal F, σ ∈ N₀.fixingSubgroup ↔ σ ∈ S := by
    intro σ
    rw [KF]
    constructor
    · intro h
      obtain ⟨s, hs, hsσ⟩ := Subgroup.mem_map.mp h
      have h1 : r (s⁻¹ * σ) = 1 := by
        rw [map_mul, map_inv, hsσ, inv_mul_cancel]
      have h2 : s⁻¹ * σ ∈ S :=
        Subgroup.mem_sup_right (IntermediateField.fixingSubgroup_le hN'N (KF0 _ h1))
      have h3 := S.mul_mem hs h2
      rwa [mul_inv_cancel_left] at h3
    · intro h
      exact Subgroup.mem_map_of_mem r h
  have comm : ∀ σ τ : EllipticRootNumber.AbsGal F,
      σ * τ * σ⁻¹ * τ⁻¹ ∈ N₀.fixingSubgroup := by
    intro σ τ
    rw [key]
    apply Subgroup.mem_sup_left
    have h := Subgroup.commutator_mem_commutator (Subgroup.mem_top σ) (Subgroup.mem_top τ)
    rw [commutatorElement_def] at h
    exact h
  refine ⟨N₀, hfin, ⟨?_, fun σ _ τ _ => comm σ τ, inferInstance⟩, ?_, ?_⟩
  · intro σ _ τ hτ
    have e : σ * τ * σ⁻¹ = (σ * τ * σ⁻¹ * τ⁻¹) * τ := by group
    rw [e]
    exact mul_mem (comm σ τ) hτ
  · intro k hk
    exact (key k).mpr (Subgroup.mem_sup_right hk)
  · intro k hk
    have hkS : k ∈ ((D ⊔ N'.fixingSubgroup : Subgroup (EllipticRootNumber.AbsGal F)) :
        Set (EllipticRootNumber.AbsGal F)) := (key k).mp hk
    rw [Subgroup.normal_mul D N'.fixingSubgroup] at hkS
    obtain ⟨c, hc, n, hn, hcn⟩ := Set.mem_mul.mp hkS
    exact ⟨c, hc, n, hn, hcn.symm⟩

theorem exists_cyclic_abelian_subfield (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    (B : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B]
    (hBn : ∀ σ : EllipticRootNumber.AbsGal F, ∀ k ∈ B.fixingSubgroup,
      σ * k * σ⁻¹ ∈ B.fixingSubgroup)
    (s : EllipticRootNumber.AbsGal F) :
    ∃ (Q : IntermediateField F (AlgebraicClosure F)) (h : Q ≤ B),
      FiniteDimensional F Q ∧ s ∈ Q.fixingSubgroup ∧ EllipticRootNumber.IsAbelianExt F h :=
by
  classical
  haveI hHn : B.fixingSubgroup.Normal := ⟨fun k hk g => hBn g k hk⟩
  set K : Subgroup (EllipticRootNumber.AbsGal F) := Subgroup.zpowers s ⊔ B.fixingSubgroup with hKdef
  have hHK : B.fixingSubgroup ≤ K := le_sup_right
  have hsK : s ∈ K := le_sup_left (a := Subgroup.zpowers s) (Subgroup.mem_zpowers s)
  set Q : IntermediateField F (AlgebraicClosure F) := IntermediateField.fixedField K with hQdef
  have hB : IntermediateField.fixedField B.fixingSubgroup = B :=
    InfiniteGalois.fixedField_fixingSubgroup B
  have hQB : Q ≤ B := by
    have h1 : IntermediateField.fixedField K ≤ IntermediateField.fixedField B.fixingSubgroup :=
      IntermediateField.fixedField_le hHK
    rw [hB] at h1
    exact h1
  have hQfd : FiniteDimensional F Q :=
    FiniteDimensional.of_injective (IntermediateField.inclusion hQB).toLinearMap
      (fun a b hab => IntermediateField.inclusion_injective hQB hab)
  have hsQ : s ∈ Q.fixingSubgroup := by
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    exact (IntermediateField.mem_fixedField_iff K x).mp hx s hsK
  have hKopen : IsOpen (K : Set (EllipticRootNumber.AbsGal F)) :=
    Subgroup.isOpen_mono hHK (IntermediateField.fixingSubgroup_isOpen B)
  have hKclosed : IsClosed (K : Set (EllipticRootNumber.AbsGal F)) :=
    Subgroup.isClosed_of_isOpen K hKopen
  have hQK : Q.fixingSubgroup = K :=
    InfiniteGalois.fixingSubgroup_fixedField (⟨K, hKclosed⟩ : ClosedSubgroup _)
  have hpow : ∀ x ∈ K, ∃ k : ℤ,
      (QuotientGroup.mk x : EllipticRootNumber.AbsGal F ⧸ B.fixingSubgroup) =
        (QuotientGroup.mk s : EllipticRootNumber.AbsGal F ⧸ B.fixingSubgroup) ^ k := by
    intro x hx
    obtain ⟨y, hy, z, hz, rfl⟩ := (Subgroup.mem_sup_of_normal_right).mp hx
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hy
    refine ⟨k, ?_⟩
    rw [QuotientGroup.mk_mul, (QuotientGroup.eq_one_iff z).mpr hz, mul_one, QuotientGroup.mk_zpow]
  have hcomm : ∀ σ ∈ K, ∀ τ ∈ K, σ * τ * σ⁻¹ * τ⁻¹ ∈ B.fixingSubgroup := by
    intro σ hσ τ hτ
    obtain ⟨a, ha⟩ := hpow σ hσ
    obtain ⟨b, hb⟩ := hpow τ hτ
    rw [← QuotientGroup.eq_one_iff]
    rw [QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_inv,
      QuotientGroup.mk_inv, ha, hb, (Commute.zpow_zpow_self _ a b).eq]
    group
  refine ⟨Q, hQB, hQfd, hsQ, ⟨fun σ _ τ hτ => hBn σ τ hτ, fun σ hσ τ hτ => ?_, inferInstance⟩⟩
  rw [hQK] at hσ hτ
  exact hcomm σ hσ τ hτ

theorem relWeil_eq_mod_abelian_of_degree_fix (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (h : L ≤ M) (hab : EllipticRootNumber.IsAbelianExt F h)
    (w w' : EllipticRootNumber.relWeil F L) (n : ℤ) (hn : n ≠ 0)
    (hdeg : EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L) w) = Multiplicative.ofAdd n)
    (hdeg' : EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L) w') = Multiplicative.ofAdd n)
    (hfix : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K] (hLK : L ≤ K),
      EllipticRootNumber.IsAbelianExt F hLK →
      (w : EllipticRootNumber.AbsGal F) ∈ K.fixingSubgroup →
      (w' : EllipticRootNumber.AbsGal F) ∈ K.fixingSubgroup) :
    ((w⁻¹ * w' : EllipticRootNumber.relWeil F L) : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup :=
by
  classical
  
  have residue_q_ge_two_and_p_not_dvd : 2 ≤ EllipticRootNumber.q F ∧
      ∀ a : ℕ, 0 < a → ¬ (EllipticRootNumber.p F ∣ EllipticRootNumber.q F ^ a - 1) := by
    have gen : ∀ (k : Type u) [Field k] [Finite k],
        2 ≤ Nat.card k ∧ ∀ a : ℕ, 0 < a → ¬ (ringChar k ∣ Nat.card k ^ a - 1) := by
      intro k _ _
      letI := Fintype.ofFinite k
      obtain ⟨r, hp, hcard⟩ := FiniteField.card k (ringChar k)
      rw [Nat.card_eq_fintype_card, hcard]
      have hr : (r : ℕ) ≠ 0 := r.ne_zero
      have hp2 := hp.two_le
      refine ⟨le_trans hp2 (Nat.le_self_pow hr _), fun a ha hdvd => ?_⟩
      have h1 : ringChar k ∣ (ringChar k ^ (r : ℕ)) ^ a := dvd_pow (dvd_pow_self _ hr) ha.ne'
      have hpos : 1 ≤ (ringChar k ^ (r : ℕ)) ^ a := Nat.one_le_pow _ _ (pow_pos hp.pos _)
      have h2 : ringChar k ∣ ((ringChar k ^ (r : ℕ)) ^ a - 1) + 1 := by
        rwa [Nat.sub_add_cancel hpos]
      have h3 : ringChar k ∣ 1 := (Nat.dvd_add_right hdvd).mp h2
      exact hp.one_lt.ne' (Nat.dvd_one.mp h3)
    unfold EllipticRootNumber.q EllipticRootNumber.p
    exact gen _
  
  have exists_pos_pow_mem_fixingSubgroup : ∀ σ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F,
      ∃ m : ℕ, 0 < m ∧ σ ^ m ∈ M.fixingSubgroup := by
    intro σ
    let f : ℕ → (M →ₐ[F] AlgebraicClosure F) := fun k =>
      ((σ ^ k : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) :
        AlgebraicClosure F →ₐ[F] AlgebraicClosure F).comp M.val
    have key : ∀ i j : ℕ, i < j → f i = f j → ∃ m : ℕ, 0 < m ∧ σ ^ m ∈ M.fixingSubgroup := by
      intro i j hlt heq
      refine ⟨j - i, Nat.sub_pos_of_lt hlt, ?_⟩
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro y hy
      have h1 : (σ ^ i) y = (σ ^ j) y := by
        have := DFunLike.congr_fun heq ⟨y, hy⟩
        simpa [f] using this
      have h2 : σ ^ j = σ ^ i * σ ^ (j - i) := by
        rw [← pow_add, Nat.add_sub_cancel' hlt.le]
      rw [h2, AlgEquiv.mul_apply] at h1
      exact ((σ ^ i).injective h1).symm
    obtain ⟨i, j, hij, hfij⟩ := Finite.exists_ne_map_eq_of_infinite f
    rcases lt_or_gt_of_ne hij with hlt | hlt
    · exact key i j hlt hfij
    · exact key j i hlt hfij.symm
  
  have commutator_mem_fixingSubgroup_adjoin_primitiveRoot : ∀ (N : ℕ) (_ : 0 < N)
      (ζ : AlgebraicClosure F) (_ : IsPrimitiveRoot ζ N)
      (σ τ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F),
      σ * τ * σ⁻¹ * τ⁻¹ ∈ (IntermediateField.adjoin F {ζ}).fixingSubgroup := by
    intro N hN ζ hζ σ τ
    haveI : NeZero N := ⟨hN.ne'⟩
    have hpow : ∀ α : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F, ∃ a : ℕ, α ζ = ζ ^ a := by
      intro α
      have : (α ζ) ^ N = 1 := by rw [← map_pow, hζ.pow_eq_one, map_one]
      obtain ⟨i, -, hi⟩ := hζ.eq_pow_of_pow_eq_one this
      exact ⟨i, hi.symm⟩
    have hcom : ∀ α β : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F, α (β ζ) = β (α ζ) := by
      intro α β
      obtain ⟨a, ha⟩ := hpow α
      obtain ⟨b, hb⟩ := hpow β
      rw [hb, map_pow, ha, map_pow, hb, ← pow_mul, ← pow_mul, mul_comm]
    have hinv : ∀ (α : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) (x : AlgebraicClosure F),
        α (α⁻¹ x) = x := by
      intro α x
      rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
    have hfix : (σ * τ * σ⁻¹ * τ⁻¹) ζ = ζ := by
      simp only [AlgEquiv.mul_apply]
      rw [hcom σ⁻¹ τ⁻¹, hinv τ, hinv σ]
    have hc : σ * τ * σ⁻¹ * τ⁻¹ ∈
        MulAction.stabilizer (AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) ζ :=
      MulAction.mem_stabilizer_iff.mpr (by rw [AlgEquiv.smul_def]; exact hfix)
    have hle := (Subgroup.zpowers_le).mpr hc
    have hadj : IntermediateField.adjoin F {ζ} ≤
        IntermediateField.fixedField (Subgroup.zpowers (σ * τ * σ⁻¹ * τ⁻¹)) := by
      rw [IntermediateField.adjoin_simple_le_iff]
      exact (IntermediateField.mem_fixedField_iff _ _).mpr fun g hg => by
        have := MulAction.mem_stabilizer_iff.mp (hle hg)
        rwa [AlgEquiv.smul_def] at this
    exact (IntermediateField.le_iff_le _ _).mp hadj (Subgroup.mem_zpowers _)
  
  have exists_fixedField_zpowers_sup : ∀ (N : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F N] (_ : L ≤ N)
      (_ : ∀ σ ∈ L.fixingSubgroup, ∀ ρ ∈ N.fixingSubgroup, σ * ρ * σ⁻¹ ∈ N.fixingSubgroup)
      (w : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) (_ : w ∈ L.fixingSubgroup),
      ∃ K : IntermediateField F (AlgebraicClosure F), L ≤ K ∧ K ≤ N ∧ FiniteDimensional F K ∧
        w ∈ K.fixingSubgroup ∧
        ∀ τ ∈ K.fixingSubgroup, ∃ j : ℤ, w ^ (-j) * τ ∈ N.fixingSubgroup := by
    intro N _ hLN hnorm w hw
    let H : Subgroup (AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) :=
      { carrier := {τ | ∃ j : ℤ, w ^ (-j) * τ ∈ N.fixingSubgroup}
        one_mem' := ⟨0, by simp⟩
        mul_mem' := by
          rintro τ₁ τ₂ ⟨j₁, h₁⟩ ⟨j₂, h₂⟩
          refine ⟨j₁ + j₂, ?_⟩
          have e : w ^ (-(j₁ + j₂)) * (τ₁ * τ₂) =
              (w ^ (-j₂) * (w ^ (-j₁) * τ₁) * (w ^ (-j₂))⁻¹) * (w ^ (-j₂) * τ₂) := by group
          rw [e]
          exact N.fixingSubgroup.mul_mem (hnorm _ (L.fixingSubgroup.zpow_mem hw _) _ h₁) h₂
        inv_mem' := by
          rintro τ ⟨j, hj⟩
          refine ⟨-j, ?_⟩
          have e : w ^ (-(-j)) * τ⁻¹ = w ^ j * (w ^ (-j) * τ)⁻¹ * (w ^ j)⁻¹ := by group
          rw [e]
          exact hnorm _ (L.fixingSubgroup.zpow_mem hw _) _ (N.fixingSubgroup.inv_mem hj) }
    have hNH : N.fixingSubgroup ≤ H := fun τ hτ => ⟨0, by simpa using hτ⟩
    have hopen : IsOpen (H : Set (AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F)) :=
      Subgroup.isOpen_mono hNH (IntermediateField.fixingSubgroup_isOpen N)
    have hclosed : IsClosed (H : Set (AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F)) :=
      Subgroup.isClosed_of_isOpen H hopen
    let Hc : ClosedSubgroup (AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) := ⟨H, hclosed⟩
    have hKH : (IntermediateField.fixedField H).fixingSubgroup = H :=
      InfiniteGalois.fixingSubgroup_fixedField Hc
    have hKN : IntermediateField.fixedField H ≤ N := by
      have := (IntermediateField.le_iff_le N.fixingSubgroup (IntermediateField.fixedField H)).mpr
        (by rw [hKH]; exact hNH)
      rwa [InfiniteGalois.fixedField_fixingSubgroup N] at this
    have hHL : H ≤ L.fixingSubgroup := by
      rintro τ ⟨j, hj⟩
      have e : τ = w ^ j * (w ^ (-j) * τ) := by group
      rw [e]
      exact L.fixingSubgroup.mul_mem (L.fixingSubgroup.zpow_mem hw _)
        (IntermediateField.fixingSubgroup_le hLN hj)
    refine ⟨IntermediateField.fixedField H, (IntermediateField.le_iff_le H L).mpr hHL, hKN,
      FiniteDimensional.of_injective (IntermediateField.inclusion hKN).toLinearMap
        (IntermediateField.inclusion hKN).toRingHom.injective, ?_, ?_⟩
    · rw [hKH]
      exact ⟨1, by simp⟩
    · intro τ hτ
      rw [hKH] at hτ
      exact hτ
  have hwL : (w : EllipticRootNumber.AbsGal F) ∈ L.fixingSubgroup := (Subgroup.mem_inf.mp w.2).2
  
  obtain ⟨m, hm, hσm⟩ := exists_pos_pow_mem_fixingSubgroup (w : EllipticRootNumber.AbsGal F)
  
  obtain ⟨hQ2, hpQ⟩ := residue_q_ge_two_and_p_not_dvd
  have ha0 : 0 < n.natAbs * m := Nat.mul_pos (Int.natAbs_pos.mpr hn) hm
  have hNn0 : 0 < EllipticRootNumber.q F ^ (n.natAbs * m) - 1 := by
    have : 2 ≤ EllipticRootNumber.q F ^ (n.natAbs * m) :=
      le_trans hQ2 (Nat.le_self_pow ha0.ne' _)
    omega
  haveI : NeZero (EllipticRootNumber.q F ^ (n.natAbs * m) - 1) := ⟨hNn0.ne'⟩
  haveI : NeZero (((EllipticRootNumber.q F ^ (n.natAbs * m) - 1 : ℕ)) : F) :=
    ⟨Nat.cast_ne_zero.mpr hNn0.ne'⟩
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (AlgebraicClosure F)
    (EllipticRootNumber.q F ^ (n.natAbs * m) - 1)
  have hpζ : EllipticRootNumber.IsPrimeToPRootOfUnity F ζ :=
    ⟨_, hNn0, hpQ _ ha0, hζ.pow_eq_one⟩
  
  haveI hZfin : FiniteDimensional F (IntermediateField.adjoin F {ζ}) :=
    IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral ζ)
  haveI : FiniteDimensional F
      ↥(M ⊔ IntermediateField.adjoin F {ζ} : IntermediateField F (AlgebraicClosure F)) :=
    IntermediateField.finiteDimensional_sup _ _
  have hLM' : L ≤ M ⊔ IntermediateField.adjoin F {ζ} := h.trans le_sup_left
  have hM'eq : (M ⊔ IntermediateField.adjoin F {ζ}).fixingSubgroup =
      M.fixingSubgroup ⊓ (IntermediateField.adjoin F {ζ}).fixingSubgroup :=
    IntermediateField.fixingSubgroup_sup
  have hcomm : ∀ ρ ∈ L.fixingSubgroup, ∀ τ ∈ L.fixingSubgroup,
      ρ * τ * ρ⁻¹ * τ⁻¹ ∈ (M ⊔ IntermediateField.adjoin F {ζ}).fixingSubgroup := by
    intro ρ hρ τ hτ
    rw [hM'eq]
    exact Subgroup.mem_inf.mpr ⟨hab.2.1 ρ hρ τ hτ,
      commutator_mem_fixingSubgroup_adjoin_primitiveRoot _ hNn0 ζ hζ ρ τ⟩
  have hM'L : (M ⊔ IntermediateField.adjoin F {ζ}).fixingSubgroup ≤ L.fixingSubgroup :=
    IntermediateField.fixingSubgroup_le hLM'
  have hnorm : ∀ ρ ∈ L.fixingSubgroup, ∀ τ ∈ (M ⊔ IntermediateField.adjoin F {ζ}).fixingSubgroup,
      ρ * τ * ρ⁻¹ ∈ (M ⊔ IntermediateField.adjoin F {ζ}).fixingSubgroup := by
    intro ρ hρ τ hτ
    have e : ρ * τ * ρ⁻¹ = (ρ * τ * ρ⁻¹ * τ⁻¹) * τ := by group
    rw [e]
    exact Subgroup.mul_mem _ (hcomm ρ hρ τ (hM'L hτ)) hτ
  
  obtain ⟨K, hLK, hKM', hKfin, hwK, hKdesc⟩ :=
    exists_fixedField_zpowers_sup _ hLM' hnorm (w : EllipticRootNumber.AbsGal F) hwL
  haveI := hKfin
  have hM'K : (M ⊔ IntermediateField.adjoin F {ζ}).fixingSubgroup ≤ K.fixingSubgroup :=
    IntermediateField.fixingSubgroup_le hKM'
  have hKL : K.fixingSubgroup ≤ L.fixingSubgroup := IntermediateField.fixingSubgroup_le hLK
  
  have habK : EllipticRootNumber.IsAbelianExt F hLK := by
    refine ⟨?_, ?_, inferInstance⟩
    · intro ρ hρ τ hτ
      have e : ρ * τ * ρ⁻¹ = (ρ * τ * ρ⁻¹ * τ⁻¹) * τ := by group
      rw [e]
      exact Subgroup.mul_mem _ (hM'K (hcomm ρ hρ τ (hKL hτ))) hτ
    · intro ρ hρ τ hτ
      exact hM'K (hcomm ρ hρ τ hτ)
  
  have hw'K := hfix K hLK habK hwK
  obtain ⟨j, hj⟩ := hKdesc _ hw'K
  have hρZ : (w : EllipticRootNumber.AbsGal F) ^ (-j) * (w' : EllipticRootNumber.AbsGal F) ∈
      (IntermediateField.adjoin F {ζ}).fixingSubgroup := by
    rw [hM'eq] at hj
    exact (Subgroup.mem_inf.mp hj).2
  have hρM : (w : EllipticRootNumber.AbsGal F) ^ (-j) * (w' : EllipticRootNumber.AbsGal F) ∈
      M.fixingSubgroup := by
    rw [hM'eq] at hj
    exact (Subgroup.mem_inf.mp hj).1
  
  letI iW : Group (EllipticRootNumber.weilGroup F) := Subgroup.toGroup _
  letI iWL : Group (EllipticRootNumber.relWeil F L) := Subgroup.toGroup _
  obtain ⟨spec1, spec2⟩ := weilDegreeHom_spec F
  have hg0 : EllipticRootNumber.weilDegreeHom F
      (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L) (w⁻¹ * w')) = 1 := by
    rw [MonoidHom.map_mul, MonoidHom.map_inv, MonoidHom.map_mul, MonoidHom.map_inv, hdeg, hdeg',
      inv_mul_cancel]
  obtain ⟨n₀, hn₀⟩ := spec1 _
    (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L) (w⁻¹ * w')).2
  have hn₀' := spec2 _ n₀ hn₀
  rw [hg0] at hn₀'
  have hn00 : n₀ = 0 := by
    have := congrArg Multiplicative.toAdd hn₀'
    simpa using this.symm
  subst hn00
  have hgζ : ((w : EllipticRootNumber.AbsGal F)⁻¹ * (w' : EllipticRootNumber.AbsGal F)) ζ = ζ := by
    have h1 := hn₀ ζ hpζ
    simp only [neg_zero, Int.toNat_zero, pow_zero, pow_one] at h1
    rw [Subgroup.coe_inclusion, Subgroup.coe_mul, Subgroup.coe_inv] at h1
    exact h1
  
  have hρζ : ((w : EllipticRootNumber.AbsGal F) ^ (-j) * (w' : EllipticRootNumber.AbsGal F))⁻¹ ζ
      = ζ := by
    have := (IntermediateField.mem_fixingSubgroup_iff _ _).mp (Subgroup.inv_mem _ hρZ) ζ
      (IntermediateField.mem_adjoin_simple_self F ζ)
    simpa using this
  have hid : (w : EllipticRootNumber.AbsGal F) ^ (j - 1) =
      ((w : EllipticRootNumber.AbsGal F)⁻¹ * (w' : EllipticRootNumber.AbsGal F)) *
        ((w : EllipticRootNumber.AbsGal F) ^ (-j) * (w' : EllipticRootNumber.AbsGal F))⁻¹ := by
    group
  have hk : ((w : EllipticRootNumber.AbsGal F) ^ (j - 1)) ζ = ζ := by
    rw [hid, AlgEquiv.mul_apply, hρζ, hgζ]
  
  have s6 : ∀ k : ℤ, ((w : EllipticRootNumber.AbsGal F) ^ k) ζ = ζ → (m : ℤ) ∣ k := by
    intro k hk'
    have hgdeg : EllipticRootNumber.weilDegreeHom F
        ((Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L) w) ^ k) =
          Multiplicative.ofAdd (k * n) := by
      rw [MonoidHom.map_zpow, hdeg, ← ofAdd_zsmul, smul_eq_mul]
    obtain ⟨n₁, hn₁⟩ := spec1 _
      ((Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L) w) ^ k).2
    have h1 := spec2 _ n₁ hn₁
    rw [hgdeg] at h1
    have hn₁e : n₁ = k * n := Multiplicative.ofAdd.injective h1.symm
    subst hn₁e
    have h2 := hn₁ ζ hpζ
    rw [Subgroup.coe_zpow, Subgroup.coe_inclusion, hk'] at h2
    obtain ⟨c, hc⟩ : ∃ c : ℤ, c = k * n := ⟨_, rfl⟩
    rw [← hc] at h2
    have h3 : ζ ^ (EllipticRootNumber.q F ^ c.natAbs) = ζ ^ 1 := by
      rcases le_total 0 c with hkn | hkn
      · have e1 : (-c).toNat = 0 := by omega
        have e2 : c.toNat = c.natAbs := by omega
        rw [e1, e2, pow_zero] at h2
        exact h2.symm
      · have e1 : (-c).toNat = c.natAbs := by omega
        have e2 : c.toNat = 0 := by omega
        rw [e1, e2, pow_zero] at h2
        exact h2
    have hQ1 : 0 < EllipticRootNumber.q F := by omega
    have hc1 : 1 ≤ EllipticRootNumber.q F ^ c.natAbs := Nat.one_le_pow _ _ hQ1
    have h4 : ζ ^ (EllipticRootNumber.q F ^ c.natAbs - 1) = 1 := by
      have e : EllipticRootNumber.q F ^ c.natAbs = (EllipticRootNumber.q F ^ c.natAbs - 1) + 1 := by
        omega
      rw [e, pow_succ, pow_one] at h3
      exact mul_right_cancel₀ (hζ.ne_zero hNn0.ne') (h3.trans (one_mul ζ).symm)
    have hdvd := hζ.dvd_of_pow_eq_one _ h4
    have hg := Nat.pow_sub_one_gcd_pow_sub_one (EllipticRootNumber.q F) (n.natAbs * m) c.natAbs
    rw [Nat.gcd_eq_left hdvd] at hg
    have hpa : 1 ≤ EllipticRootNumber.q F ^ (n.natAbs * m) := Nat.one_le_pow _ _ hQ1
    have hpg : 1 ≤ EllipticRootNumber.q F ^ (Nat.gcd (n.natAbs * m) c.natAbs) :=
      Nat.one_le_pow _ _ hQ1
    have heq : EllipticRootNumber.q F ^ (n.natAbs * m) =
        EllipticRootNumber.q F ^ (Nat.gcd (n.natAbs * m) c.natAbs) := by omega
    have hgcd : n.natAbs * m = Nat.gcd (n.natAbs * m) c.natAbs := Nat.pow_right_injective hQ2 heq
    have hdiv := Nat.gcd_dvd_right (n.natAbs * m) c.natAbs
    rw [← hgcd, hc, Int.natAbs_mul, mul_comm k.natAbs] at hdiv
    exact Int.natCast_dvd.mpr (Nat.dvd_of_mul_dvd_mul_left (Int.natAbs_pos.mpr hn) hdiv)
  obtain ⟨t, ht⟩ := s6 (j - 1) hk
  
  have hpow : (w : EllipticRootNumber.AbsGal F) ^ (j - 1) ∈ M.fixingSubgroup := by
    rw [ht, zpow_mul, zpow_natCast]
    exact Subgroup.zpow_mem _ hσm t
  have hfin : (w : EllipticRootNumber.AbsGal F)⁻¹ * (w' : EllipticRootNumber.AbsGal F) =
      (w : EllipticRootNumber.AbsGal F) ^ (j - 1) *
        ((w : EllipticRootNumber.AbsGal F) ^ (-j) * (w' : EllipticRootNumber.AbsGal F)) := by
    group
  rw [Subgroup.coe_mul, Subgroup.coe_inv, hfin]
  exact Subgroup.mul_mem _ hpow hρM

theorem relVal_mul_and_exists_ne_zero (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] :
    (∀ x y : L, x ≠ 0 → y ≠ 0 →
      EllipticRootNumber.relVal F L (x * y) =
        EllipticRootNumber.relVal F L x + EllipticRootNumber.relVal F L y) ∧
    ∃ y : L, y ≠ 0 ∧ EllipticRootNumber.relVal F L y ≠ 0 :=
by
  classical
  have key : ∀ x : F, x ≠ 0 →
      IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (ValuativeRel.valuation F x) =
        ((Multiplicative.ofAdd (-EllipticRootNumber.addVal F x) : Multiplicative ℤ) :
          WithZero (Multiplicative ℤ)) := by
    intro x hx
    unfold EllipticRootNumber.addVal
    rw [dif_neg hx, neg_neg]
    exact (WithZero.coe_unzero _).symm
  have hmul : ∀ a b : F, a ≠ 0 → b ≠ 0 →
      EllipticRootNumber.addVal F (a * b) =
        EllipticRootNumber.addVal F a + EllipticRootNumber.addVal F b := by
    intro a b ha hb
    have h1 := key (a * b) (mul_ne_zero ha hb)
    rw [Valuation.map_mul, map_mul, key a ha, key b hb, ← WithZero.coe_mul, ← ofAdd_add] at h1
    have h2 := Multiplicative.ofAdd.injective (WithZero.coe_injective h1)
    linarith
  have hpow : ∀ a : F, a ≠ 0 → ∀ k : ℕ,
      EllipticRootNumber.addVal F (a ^ k) = (k : ℤ) * EllipticRootNumber.addVal F a := by
    intro a ha k
    induction k with
    | zero =>
      have h1 := hmul 1 1 one_ne_zero one_ne_zero
      rw [mul_one] at h1
      simp only [pow_zero, Nat.cast_zero, zero_mul]
      linarith
    | succ k ih =>
      rw [pow_succ, hmul _ _ (pow_ne_zero _ ha) ha, ih]
      push_cast
      ring
  have hex : ∃ a : F, a ≠ 0 ∧ EllipticRootNumber.addVal F a ≠ 0 := by
    obtain ⟨γ, hγ0, hγ1⟩ := (inferInstance : ValuativeRel.IsNontrivial F).condition
    obtain ⟨a, rfl⟩ := ValuativeRel.valuation_surjective γ
    have ha : a ≠ 0 := by
      rintro rfl
      exact hγ0 (map_zero _)
    refine ⟨a, ha, fun h0 => hγ1 ?_⟩
    have h1 := key a ha
    rw [h0, neg_zero, ofAdd_zero, WithZero.coe_one,
      ← map_one (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F)] at h1
    exact (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).injective h1
  refine ⟨fun x y hx hy => ?_, ?_⟩
  · unfold EllipticRootNumber.relVal
    rw [map_mul]
    exact hmul _ _ (Algebra.norm_ne_zero_iff.mpr hx) (Algebra.norm_ne_zero_iff.mpr hy)
  · obtain ⟨a, ha, hav⟩ := hex
    refine ⟨algebraMap F L a, (map_ne_zero _).mpr ha, ?_⟩
    unfold EllipticRootNumber.relVal
    rw [Algebra.norm_algebraMap, hpow a ha]
    have hn : 0 < Module.finrank F L := Module.finrank_pos
    exact mul_ne_zero (by exact_mod_cast hn.ne') hav

theorem recMap_norm_compat (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] (rec : EllipticRootNumber.LocalReciprocity F)
    (L L' : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    [FiniteDimensional F L'] (hLL' : L ≤ L')
    (N : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F N] (hLN : L ≤ N)
    (hab : EllipticRootNumber.IsAbelianExt F hLN) (x : L'ˣ) :
    ((rec.recMap L (Units.map (EllipticRootNumber.normLM F hLL') x) :
        EllipticRootNumber.AbsGal F))⁻¹ *
      (rec.recMap L' x : EllipticRootNumber.AbsGal F) ∈ N.fixingSubgroup :=
by
  
  have nLM : ∀ {X Y : IntermediateField F (AlgebraicClosure F)} (hXY : X ≤ Y) (y : Y),
      @Algebra.norm X Y _ _ (IntermediateField.inclusion hXY).toRingHom.toAlgebra y =
        EllipticRootNumber.normLM F hXY y := by
    intro X Y hXY y
    letI : Algebra X Y := (IntermediateField.inclusion hXY).toRingHom.toAlgebra
    let e : Y ≃ₐ[X] IntermediateField.extendScalars hXY :=
      { toFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hXY).mpr y.2⟩
        invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hXY).mp y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl }
    exact (Algebra.norm_eq_of_algEquiv e y).symm
  
  have normTrans : ∀ {X Y Z : IntermediateField F (AlgebraicClosure F)} (hXY : X ≤ Y)
      (hYZ : Y ≤ Z) (z : Z),
      EllipticRootNumber.normLM F hXY (EllipticRootNumber.normLM F hYZ z) =
        EllipticRootNumber.normLM F (hXY.trans hYZ) z := by
    intro X Y Z hXY hYZ z
    rw [← nLM hYZ, ← nLM hXY, ← nLM (hXY.trans hYZ)]
    letI i1 : Algebra X Y := (IntermediateField.inclusion hXY).toRingHom.toAlgebra
    letI i2 : Algebra Y Z := (IntermediateField.inclusion hYZ).toRingHom.toAlgebra
    letI i3 : Algebra X Z := (IntermediateField.inclusion (hXY.trans hYZ)).toRingHom.toAlgebra
    haveI hT := @IsScalarTower.of_algebraMap_eq X Y Z _ _ _ i1 i2 i3 (fun _ => rfl)
    exact Algebra.norm_norm (a := z)
  
  have normF : ∀ {X Y : IntermediateField F (AlgebraicClosure F)} (hXY : X ≤ Y) (y : Y),
      Algebra.norm F ((EllipticRootNumber.normLM F hXY y : X)) = Algebra.norm F y := by
    intro X Y hXY y
    rw [← nLM hXY]
    letI i1 : Algebra X Y := (IntermediateField.inclusion hXY).toRingHom.toAlgebra
    haveI hT := @IsScalarTower.of_algebraMap_eq F X Y _ _ _ _ i1 _ (fun _ => rfl)
    exact Algebra.norm_norm (a := y)
  
  have absup : ∀ (K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K),
      EllipticRootNumber.IsAbelianExt F hLK →
      EllipticRootNumber.IsAbelianExt F (le_sup_right : L' ≤ K ⊔ L') := by
    intro K hLK habK
    have hL'L : L'.fixingSubgroup ≤ L.fixingSubgroup := IntermediateField.fixingSubgroup_le hLL'
    refine ⟨?_, ?_, ?_⟩
    · intro σ hσ τ hτ
      rw [IntermediateField.fixingSubgroup_sup] at hτ ⊢
      obtain ⟨hτK, hτL'⟩ := Subgroup.mem_inf.mp hτ
      exact Subgroup.mem_inf.mpr ⟨habK.1 σ (hL'L hσ) τ hτK,
        L'.fixingSubgroup.mul_mem (L'.fixingSubgroup.mul_mem hσ hτL')
          (L'.fixingSubgroup.inv_mem hσ)⟩
    · intro σ hσ τ hτ
      rw [IntermediateField.fixingSubgroup_sup]
      exact Subgroup.mem_inf.mpr ⟨habK.2.1 σ (hL'L hσ) τ (hL'L hτ),
        L'.fixingSubgroup.mul_mem (L'.fixingSubgroup.mul_mem (L'.fixingSubgroup.mul_mem hσ hτ)
          (L'.fixingSubgroup.inv_mem hσ)) (L'.fixingSubgroup.inv_mem hτ)⟩
    · haveI : CharZero L' := charZero_of_injective_algebraMap (algebraMap F L').injective
      infer_instance
  
  have case1 : ∀ y : L'ˣ, EllipticRootNumber.relVal F L' (y : L') ≠ 0 →
      ((rec.recMap L (Units.map (EllipticRootNumber.normLM F hLL') y) :
        EllipticRootNumber.AbsGal F))⁻¹ *
      (rec.recMap L' y : EllipticRootNumber.AbsGal F) ∈ N.fixingSubgroup := by
    intro y hy
    let w : EllipticRootNumber.relWeil F L :=
      ⟨(rec.recMap L' y : EllipticRootNumber.AbsGal F),
        EllipticRootNumber.relWeil_antitone F hLL' (rec.recMap L' y).2⟩
    have hdeg : EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L) w) =
          Multiplicative.ofAdd (-EllipticRootNumber.relVal F L' (y : L')) := by
      have e : Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L) w =
          Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L') (rec.recMap L' y) :=
        rfl
      rw [e]
      exact rec.degree_rec L' y
    have hv : EllipticRootNumber.relVal F L
        ((Units.map (EllipticRootNumber.normLM F hLL') y : Lˣ) : L) =
          EllipticRootNumber.relVal F L' (y : L') := by
      show EllipticRootNumber.addVal F
          (Algebra.norm F (EllipticRootNumber.normLM F hLL' (y : L'))) =
        EllipticRootNumber.addVal F (Algebra.norm F (y : L'))
      rw [normF]
    have hdeg' : EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L)
          (rec.recMap L (Units.map (EllipticRootNumber.normLM F hLL') y))) =
          Multiplicative.ofAdd (-EllipticRootNumber.relVal F L' (y : L')) := by
      rw [rec.degree_rec L, hv]
    have hfix : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K]
        (hLK : L ≤ K), EllipticRootNumber.IsAbelianExt F hLK →
        (w : EllipticRootNumber.AbsGal F) ∈ K.fixingSubgroup →
        ((rec.recMap L (Units.map (EllipticRootNumber.normLM F hLL') y) :
          EllipticRootNumber.AbsGal F)) ∈ K.fixingSubgroup := by
      intro K _ hLK habK hwK
      have habK' := absup K hLK habK
      have hx' : (rec.recMap L' y : EllipticRootNumber.AbsGal F) ∈ (K ⊔ L').fixingSubgroup := by
        rw [IntermediateField.fixingSubgroup_sup]
        exact Subgroup.mem_inf.mpr ⟨hwK, (Subgroup.mem_inf.mp (rec.recMap L' y).2).2⟩
      obtain ⟨z, hz⟩ := (rec.ker_rec L' (K ⊔ L') le_sup_right habK' y).mp hx'
      apply (rec.ker_rec L K hLK habK _).mpr
      refine ⟨EllipticRootNumber.normLM F (le_sup_left : K ≤ K ⊔ L') z, ?_⟩
      rw [normTrans, Units.coe_map, ← hz, normTrans]
    have h := relWeil_eq_mod_abelian_of_degree_fix F L N hLN hab w
      (rec.recMap L (Units.map (EllipticRootNumber.normLM F hLL') y))
      (-EllipticRootNumber.relVal F L' (y : L')) (neg_ne_zero.mpr hy) hdeg hdeg' hfix
    rw [Subgroup.coe_mul, Subgroup.coe_inv] at h
    have h2 := N.fixingSubgroup.inv_mem h
    rw [mul_inv_rev, inv_inv] at h2
    exact h2
  
  have comb : ∀ a₁ a₂ A b₁ b₂ B : EllipticRootNumber.AbsGal F,
      b₁⁻¹ * a₁ ∈ N.fixingSubgroup → b₂⁻¹ * a₂ ∈ N.fixingSubgroup →
      A⁻¹ * (a₁ * a₂) ∈ N.fixingSubgroup → B⁻¹ * (b₁ * b₂) ∈ N.fixingSubgroup →
      b₂ ∈ L.fixingSubgroup → B⁻¹ * A ∈ N.fixingSubgroup := by
    intro a₁ a₂ A b₁ b₂ B H1 H2 H3 H4 hb
    have Hn := hab.1 b₂⁻¹ (L.fixingSubgroup.inv_mem hb) _ H1
    have e : B⁻¹ * A = (B⁻¹ * (b₁ * b₂)) * (b₂⁻¹ * (b₁⁻¹ * a₁) * b₂⁻¹⁻¹) * (b₂⁻¹ * a₂) *
        (A⁻¹ * (a₁ * a₂))⁻¹ := by group
    rw [e]
    exact N.fixingSubgroup.mul_mem
      (N.fixingSubgroup.mul_mem (N.fixingSubgroup.mul_mem H4 Hn) H2)
      (N.fixingSubgroup.inv_mem H3)
  have key : ∀ y₁ y₂ : L'ˣ, EllipticRootNumber.relVal F L' (y₁ : L') ≠ 0 →
      EllipticRootNumber.relVal F L' (y₂ : L') ≠ 0 →
      ((rec.recMap L (Units.map (EllipticRootNumber.normLM F hLL') (y₁ * y₂)) :
        EllipticRootNumber.AbsGal F))⁻¹ *
      (rec.recMap L' (y₁ * y₂) : EllipticRootNumber.AbsGal F) ∈ N.fixingSubgroup := by
    intro y₁ y₂ hy₁ hy₂
    have H1 := case1 y₁ hy₁
    have H2 := case1 y₂ hy₂
    have H3 := rec.mul_rec L' (N ⊔ L') le_sup_right (absup N hLN hab) y₁ y₂
    simp only [Subgroup.coe_mul, Subgroup.coe_inv] at H3
    have H3' := IntermediateField.fixingSubgroup_le (le_sup_left : N ≤ N ⊔ L') H3
    have H4 := rec.mul_rec L N hLN hab (Units.map (EllipticRootNumber.normLM F hLL') y₁)
      (Units.map (EllipticRootNumber.normLM F hLL') y₂)
    rw [← map_mul (Units.map (EllipticRootNumber.normLM F hLL'))] at H4
    simp only [Subgroup.coe_mul, Subgroup.coe_inv] at H4
    have hb₂ : (rec.recMap L (Units.map (EllipticRootNumber.normLM F hLL') y₂) :
        EllipticRootNumber.AbsGal F) ∈ L.fixingSubgroup :=
      (Subgroup.mem_inf.mp (rec.recMap L (Units.map (EllipticRootNumber.normLM F hLL') y₂)).2).2
    exact comb _ _ _ _ _ _ H1 H2 H3' H4 hb₂
  obtain ⟨hmul, c, hc, hcv⟩ := relVal_mul_and_exists_ne_zero F L'
  by_cases hx : EllipticRootNumber.relVal F L' (x : L') = 0
  swap
  · exact case1 x hx
  let cu : L'ˣ := Units.mk0 c hc
  have h1 : EllipticRootNumber.relVal F L' ((1 : L'ˣ) : L') = 0 := by
    have h11 := hmul 1 1 one_ne_zero one_ne_zero
    rw [mul_one] at h11
    simp only [Units.val_one]
    omega
  have hx1 : EllipticRootNumber.relVal F L' ((x * cu : L'ˣ) : L') ≠ 0 := by
    rw [Units.val_mul, hmul _ _ x.ne_zero cu.ne_zero, hx, zero_add]
    exact hcv
  have hx2 : EllipticRootNumber.relVal F L' ((cu⁻¹ : L'ˣ) : L') ≠ 0 := by
    have e := hmul _ _ cu.ne_zero cu⁻¹.ne_zero
    rw [← Units.val_mul, mul_inv_cancel, h1] at e
    intro h0
    rw [h0, add_zero] at e
    exact hcv e.symm
  have hfin := key _ _ hx1 hx2
  rwa [mul_inv_cancel_right] at hfin

theorem recMap_conj_compat (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] (rec : EllipticRootNumber.LocalReciprocity F)
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (t : EllipticRootNumber.AbsGal F) (ht₀ : t ∈ EllipticRootNumber.weilGroup F)
    (htL : ∀ y : AlgebraicClosure F, y ∈ L ↔ t y ∈ L)
    (N : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F N] (hLN : L ≤ N)
    (hab : EllipticRootNumber.IsAbelianExt F hLN)
    (htN : ∀ y : AlgebraicClosure F, y ∈ N ↔ t y ∈ N)
    (x x' : Lˣ) (hx : ((x' : L) : AlgebraicClosure F) = t ((x : L) : AlgebraicClosure F)) :
    ((rec.recMap L x' : EllipticRootNumber.AbsGal F))⁻¹ *
      (t * (rec.recMap L x : EllipticRootNumber.AbsGal F) * t⁻¹) ∈ N.fixingSubgroup :=
by
  classical
  
  have tinv : ∀ y : AlgebraicClosure F, t⁻¹ (t y) = y := by
    intro y
    rw [← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]
  have tinv' : ∀ y : AlgebraicClosure F, t (t⁻¹ y) = y := by
    intro y
    rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
  
  have invStab : ∀ (X : IntermediateField F (AlgebraicClosure F)) (s : EllipticRootNumber.AbsGal F),
      (∀ y, y ∈ X ↔ s y ∈ X) → ∀ y, y ∈ X ↔ s⁻¹ y ∈ X := by
    intro X s hs y
    have e : s (s⁻¹ y) = y := by rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
    rw [hs (s⁻¹ y), e]
  have conjStab : ∀ (X : IntermediateField F (AlgebraicClosure F)) (s : EllipticRootNumber.AbsGal F),
      (∀ y, y ∈ X ↔ s y ∈ X) → ∀ σ, σ ∈ X.fixingSubgroup → s * σ * s⁻¹ ∈ X.fixingSubgroup := by
    intro X s hs σ hσ
    rw [IntermediateField.mem_fixingSubgroup_iff] at hσ ⊢
    intro y hy
    have hy' : s⁻¹ y ∈ X := (invStab X s hs y).mp hy
    rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, hσ _ hy', ← AlgEquiv.mul_apply, mul_inv_cancel,
      AlgEquiv.one_apply]
  have htL' : ∀ y, y ∈ L ↔ t⁻¹ y ∈ L := invStab L t htL
  have conjL : ∀ σ, σ ∈ L.fixingSubgroup → t⁻¹ * σ * t ∈ L.fixingSubgroup := by
    intro σ hσ
    have h := conjStab L t⁻¹ htL' σ hσ
    rwa [inv_inv] at h
  
  let eL : L ≃ₐ[F] L :=
    { toFun := fun y => ⟨t y, (htL y).mp y.2⟩
      invFun := fun y => ⟨t⁻¹ y, (htL' y).mp y.2⟩
      left_inv := fun y => Subtype.ext (tinv y)
      right_inv := fun y => Subtype.ext (tinv' y)
      map_mul' := fun a b => Subtype.ext (map_mul t _ _)
      map_add' := fun a b => Subtype.ext (map_add t _ _)
      commutes' := fun r => Subtype.ext (t.commutes r) }
  have relValConj : ∀ z z' : L, (z' : AlgebraicClosure F) = t (z : AlgebraicClosure F) →
      EllipticRootNumber.relVal F L z' = EllipticRootNumber.relVal F L z := by
    intro z z' hz
    have e : z' = eL z := Subtype.ext hz
    unfold EllipticRootNumber.relVal
    rw [e, Algebra.norm_eq_of_algEquiv]
  
  have transport : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K]
      (hLK : L ≤ K), EllipticRootNumber.IsAbelianExt F hLK → ∀ z z' : Lˣ,
      ((z' : L) : AlgebraicClosure F) = t ((z : L) : AlgebraicClosure F) →
      (rec.recMap L z : EllipticRootNumber.AbsGal F) ∈ K.fixingSubgroup →
      t⁻¹ * (rec.recMap L z' : EllipticRootNumber.AbsGal F) * t ∈ K.fixingSubgroup := by
    intro K _ hLK habK z z' hz hzK
    set K' : IntermediateField F (AlgebraicClosure F) :=
      IntermediateField.map (t : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) K with hK'def
    haveI : FiniteDimensional F K' := IntermediateField.finiteDimensional_map _
    have hK'mem : ∀ y, y ∈ K' ↔ t⁻¹ y ∈ K := by
      intro y
      rw [← SetLike.mem_coe, hK'def, IntermediateField.coe_map]
      constructor
      · rintro ⟨w, hw, rfl⟩
        show t⁻¹ (t w) ∈ K
        rw [tinv]
        exact hw
      · intro h
        exact ⟨t⁻¹ y, h, tinv' y⟩
    have htK : ∀ y, y ∈ K ↔ t y ∈ K' := by
      intro y
      rw [hK'mem, tinv]
    have hfixK' : ∀ σ : EllipticRootNumber.AbsGal F,
        σ ∈ K'.fixingSubgroup ↔ t⁻¹ * σ * t ∈ K.fixingSubgroup := by
      intro σ
      rw [IntermediateField.mem_fixingSubgroup_iff, IntermediateField.mem_fixingSubgroup_iff]
      constructor
      · intro h w hw
        rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, h (t w) ((htK w).mp hw), tinv]
      · intro h y hy
        have h1 := h _ ((hK'mem y).mp hy)
        rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, tinv'] at h1
        exact (t⁻¹).injective h1
    have hLK' : L ≤ K' := by
      intro y hy
      exact (hK'mem y).mpr (hLK ((htL' y).mp hy))
    have habK' : EllipticRootNumber.IsAbelianExt F hLK' := by
      refine ⟨?_, ?_, inferInstance⟩
      · intro σ hσ τ hτ
        rw [hfixK']
        have e : t⁻¹ * (σ * τ * σ⁻¹) * t =
            (t⁻¹ * σ * t) * (t⁻¹ * τ * t) * (t⁻¹ * σ * t)⁻¹ := by group
        rw [e]
        exact habK.1 _ (conjL σ hσ) _ ((hfixK' τ).mp hτ)
      · intro σ hσ τ hτ
        rw [hfixK']
        have e : t⁻¹ * (σ * τ * σ⁻¹ * τ⁻¹) * t =
            (t⁻¹ * σ * t) * (t⁻¹ * τ * t) * (t⁻¹ * σ * t)⁻¹ * (t⁻¹ * τ * t)⁻¹ := by group
        rw [e]
        exact habK.2.1 _ (conjL σ hσ) _ (conjL τ hτ)
    
    obtain ⟨c, hc⟩ := (rec.ker_rec L K hLK habK z).mp hzK
    let e₂ : IntermediateField.extendScalars hLK ≃+* IntermediateField.extendScalars hLK' :=
      { toFun := fun y => ⟨t y, (IntermediateField.mem_extendScalars hLK').mpr
          ((htK y).mp ((IntermediateField.mem_extendScalars hLK).mp y.2))⟩
        invFun := fun y => ⟨t⁻¹ y, (IntermediateField.mem_extendScalars hLK).mpr
          ((hK'mem y).mp ((IntermediateField.mem_extendScalars hLK').mp y.2))⟩
        left_inv := fun y => Subtype.ext (tinv y)
        right_inv := fun y => Subtype.ext (tinv' y)
        map_mul' := fun a b => Subtype.ext (map_mul t _ _)
        map_add' := fun a b => Subtype.ext (map_add t _ _) }
    have he : (algebraMap L (IntermediateField.extendScalars hLK')).comp
        (eL.toRingEquiv : L →+* L) =
        (e₂ : IntermediateField.extendScalars hLK →+* IntermediateField.extendScalars hLK').comp
          (algebraMap L (IntermediateField.extendScalars hLK)) := by
      ext y
      rfl
    have key := Algebra.norm_eq_of_equiv_equiv eL.toRingEquiv e₂ he
      (EllipticRootNumber.toExtendScalars F hLK c)
    let c' : K' := ⟨t (c : AlgebraicClosure F), (htK _).mp c.2⟩
    have h1 : e₂ (EllipticRootNumber.toExtendScalars F hLK c) =
        EllipticRootNumber.toExtendScalars F hLK' c' := Subtype.ext rfl
    have hz'N : ((z' : L)) ∈ Set.range (EllipticRootNumber.normLM F hLK') := by
      refine ⟨c', ?_⟩
      show Algebra.norm L (EllipticRootNumber.toExtendScalars F hLK' c') = (z' : L)
      rw [← h1]
      have h2 := congrArg eL.toRingEquiv key
      rw [RingEquiv.apply_symm_apply] at h2
      rw [← h2]
      have hc' : Algebra.norm L (EllipticRootNumber.toExtendScalars F hLK c) = (z : L) := hc
      rw [hc']
      exact Subtype.ext hz.symm
    have hrK' := (rec.ker_rec L K' hLK' habK' z').mpr hz'N
    exact (hfixK' _).mp hrK'
  
  have KEY : ∀ z z' : Lˣ, ((z' : L) : AlgebraicClosure F) = t ((z : L) : AlgebraicClosure F) →
      EllipticRootNumber.relVal F L (z : L) ≠ 0 →
      ((rec.recMap L z' : EllipticRootNumber.AbsGal F))⁻¹ *
        (t * (rec.recMap L z : EllipticRootNumber.AbsGal F) * t⁻¹) ∈ N.fixingSubgroup := by
    intro z z' hz hz0
    have hr' := (rec.recMap L z').2
    have hmemW : t⁻¹ * (rec.recMap L z' : EllipticRootNumber.AbsGal F) * t ∈
        EllipticRootNumber.weilGroup F :=
      (EllipticRootNumber.weilGroup F).mul_mem ((EllipticRootNumber.weilGroup F).mul_mem
        ((EllipticRootNumber.weilGroup F).inv_mem ht₀)
        (EllipticRootNumber.relWeil_le_weilGroup F L hr')) ht₀
    have hmemL : t⁻¹ * (rec.recMap L z' : EllipticRootNumber.AbsGal F) * t ∈ L.fixingSubgroup :=
      conjL _ (Subgroup.mem_inf.mp hr').2
    have hmem : t⁻¹ * (rec.recMap L z' : EllipticRootNumber.AbsGal F) * t ∈
        EllipticRootNumber.relWeil F L := Subgroup.mem_inf.mpr ⟨hmemW, hmemL⟩
    have hdeg' : EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L)
          (⟨t⁻¹ * (rec.recMap L z' : EllipticRootNumber.AbsGal F) * t, hmem⟩ :
            EllipticRootNumber.relWeil F L)) =
          Multiplicative.ofAdd (-EllipticRootNumber.relVal F L z) := by
      have e0 : Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L)
          (⟨t⁻¹ * (rec.recMap L z' : EllipticRootNumber.AbsGal F) * t, hmem⟩ :
            EllipticRootNumber.relWeil F L) =
          (⟨t, ht₀⟩ : EllipticRootNumber.weilGroup F)⁻¹ *
            Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L) (rec.recMap L z') *
            (⟨t, ht₀⟩ : EllipticRootNumber.weilGroup F) := Subtype.ext rfl
      rw [e0, map_mul, map_mul, map_inv, rec.degree_rec L z',
        relValConj (z : L) (z' : L) hz, mul_comm, ← mul_assoc, mul_inv_cancel, one_mul]
    have hRD := relWeil_eq_mod_abelian_of_degree_fix F L N hLN hab (rec.recMap L z)
      ⟨t⁻¹ * (rec.recMap L z' : EllipticRootNumber.AbsGal F) * t, hmem⟩
      (-EllipticRootNumber.relVal F L z) (neg_ne_zero.mpr hz0) (rec.degree_rec L z) hdeg'
      (fun K _ hLK habK hK => transport K hLK habK z z' hz hK)
    change ((rec.recMap L z : EllipticRootNumber.AbsGal F))⁻¹ *
      (t⁻¹ * (rec.recMap L z' : EllipticRootNumber.AbsGal F) * t) ∈ N.fixingSubgroup at hRD
    have h1 := conjStab N t htN _ (N.fixingSubgroup.inv_mem hRD)
    have e : t * (((rec.recMap L z : EllipticRootNumber.AbsGal F))⁻¹ *
        (t⁻¹ * (rec.recMap L z' : EllipticRootNumber.AbsGal F) * t))⁻¹ * t⁻¹ =
        ((rec.recMap L z' : EllipticRootNumber.AbsGal F))⁻¹ *
          (t * (rec.recMap L z : EllipticRootNumber.AbsGal F) * t⁻¹) := by group
    rw [e] at h1
    exact h1
  
  by_cases hx0 : EllipticRootNumber.relVal F L (x : L) ≠ 0
  · exact KEY x x' hx hx0
  push_neg at hx0
  obtain ⟨hmulrel, π₀, hπ0, hrelπ⟩ := relVal_mul_and_exists_ne_zero F L
  set π : Lˣ := Units.mk0 π₀ hπ0 with hπdef
  have Tex : ∀ y : Lˣ, ∃ y' : Lˣ,
      ((y' : L) : AlgebraicClosure F) = t ((y : L) : AlgebraicClosure F) := by
    intro y
    have hmem : t ((y : L) : AlgebraicClosure F) ∈ L := (htL _).mp (y : L).2
    have hne : (⟨t ((y : L) : AlgebraicClosure F), hmem⟩ : L) ≠ 0 := by
      intro h
      have h1 : t ((y : L) : AlgebraicClosure F) = 0 := congrArg Subtype.val h
      have h2 : ((y : L) : AlgebraicClosure F) = 0 := by
        rw [← map_zero t] at h1
        exact t.injective h1
      exact y.ne_zero (Subtype.ext h2)
    exact ⟨Units.mk0 _ hne, rfl⟩
  obtain ⟨π', hπ'⟩ := Tex π
  have hy : (((x' * π' : Lˣ) : L) : AlgebraicClosure F) =
      t (((x * π : Lˣ) : L) : AlgebraicClosure F) := by
    simp only [Units.val_mul, IntermediateField.coe_mul, map_mul, hx, hπ']
  have hrelπ' : EllipticRootNumber.relVal F L ((π : Lˣ) : L) ≠ 0 := hrelπ
  have hrely : EllipticRootNumber.relVal F L ((x * π : Lˣ) : L) ≠ 0 := by
    have hxne : (x : L) ≠ 0 := x.ne_zero
    rw [Units.val_mul, hmulrel _ _ hxne π.ne_zero, hx0, zero_add]
    exact hrelπ'
  have K1 := KEY π π' hπ' hrelπ'
  have K2 := KEY (x * π) (x' * π') hy hrely
  have M1 := rec.mul_rec L N hLN hab x' π'
  have M2 := rec.mul_rec L N hLN hab x π
  simp only [Subgroup.coe_mul, Subgroup.coe_inv] at M1 M2
  have M2' := conjStab N t htN _ M2
  
  set a : EllipticRootNumber.AbsGal F := (rec.recMap L (x' * π') : EllipticRootNumber.AbsGal F)
  set a₁ : EllipticRootNumber.AbsGal F := (rec.recMap L x' : EllipticRootNumber.AbsGal F)
  set a₂ : EllipticRootNumber.AbsGal F := (rec.recMap L π' : EllipticRootNumber.AbsGal F)
  set g : EllipticRootNumber.AbsGal F := (rec.recMap L (x * π) : EllipticRootNumber.AbsGal F)
  set g₁ : EllipticRootNumber.AbsGal F := (rec.recMap L x : EllipticRootNumber.AbsGal F)
  set g₂ : EllipticRootNumber.AbsGal F := (rec.recMap L π : EllipticRootNumber.AbsGal F)
  have ha₂ : a₂ ∈ L.fixingSubgroup := (Subgroup.mem_inf.mp (rec.recMap L π').2).2
  have hb : (t * g * t⁻¹)⁻¹ * ((t * g₁ * t⁻¹) * (t * g₂ * t⁻¹)) ∈ N.fixingSubgroup := by
    have e : (t * g * t⁻¹)⁻¹ * ((t * g₁ * t⁻¹) * (t * g₂ * t⁻¹)) =
        t * (g⁻¹ * (g₁ * g₂)) * t⁻¹ := by group
    rw [e]
    exact M2'
  have hk := N.fixingSubgroup.mul_mem
    (N.fixingSubgroup.mul_mem (N.fixingSubgroup.inv_mem M1) K2) hb
  have e1 := hab.1 a₂ ha₂ _ hk
  have e2 := hab.1 a₂ ha₂ _ (N.fixingSubgroup.inv_mem K1)
  have e3 := N.fixingSubgroup.mul_mem e1 e2
  have e : a₁⁻¹ * (t * g₁ * t⁻¹) =
      a₂ * ((a⁻¹ * (a₁ * a₂))⁻¹ * (a⁻¹ * (t * g * t⁻¹)) *
        ((t * g * t⁻¹)⁻¹ * ((t * g₁ * t⁻¹) * (t * g₂ * t⁻¹)))) * a₂⁻¹ *
      (a₂ * (a₂⁻¹ * (t * g₂ * t⁻¹))⁻¹ * a₂⁻¹) := by group
  rw [e]
  exact e3

theorem finrank_sup_left_eq_two_of_quadratic (F : Type u) [Field F] [CharZero F]
    (M K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    [FiniteDimensional F K] (hM : Module.finrank F M = 2) (hMK : ¬ M ≤ K) :
    Module.finrank K (IntermediateField.extendScalars (le_sup_left : K ≤ K ⊔ M)) = 2 :=
by
  have hr : K.relfinrank (K ⊔ M) =
      Module.finrank K (IntermediateField.extendScalars (le_sup_left : K ≤ K ⊔ M)) :=
    IntermediateField.relfinrank_eq_finrank_of_le le_sup_left
  rw [← hr]
  have T : Module.finrank F K * K.relfinrank (K ⊔ M) = Module.finrank F ↥(K ⊔ M) := by
    have h := IntermediateField.relfinrank_mul_relfinrank
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ K) (le_sup_left : K ≤ K ⊔ M)
    rwa [IntermediateField.relfinrank_bot_left, IntermediateField.relfinrank_bot_left] at h
  haveI : FiniteDimensional F ↥(K ⊔ M) := IntermediateField.finiteDimensional_sup K M
  have hc : 0 < Module.finrank F ↥(K ⊔ M) := Module.finrank_pos
  have hbound : Module.finrank F ↥(K ⊔ M) ≤ Module.finrank F K * Module.finrank F M :=
    IntermediateField.finrank_sup_le K M
  rw [hM] at hbound
  have ha : 0 < Module.finrank F K := by
    rcases Nat.eq_zero_or_pos (Module.finrank F K) with h0 | h0
    · rw [h0, zero_mul] at T; omega
    · exact h0
  have hr0 : K.relfinrank (K ⊔ M) ≠ 0 := by
    intro h0; rw [h0, mul_zero] at T; omega
  have hr2 : K.relfinrank (K ⊔ M) ≤ 2 :=
    Nat.le_of_mul_le_mul_left (T.le.trans hbound) ha
  have hr1 : K.relfinrank (K ⊔ M) ≠ 1 := by
    intro h1
    rw [hr, IntermediateField.finrank_eq_one_iff] at h1
    apply hMK
    intro x hx
    have hx' : x ∈ IntermediateField.extendScalars (le_sup_left : K ≤ K ⊔ M) :=
      (IntermediateField.mem_extendScalars _).mpr (le_sup_right (a := K) hx)
    rw [h1, IntermediateField.mem_bot] at hx'
    obtain ⟨y, rfl⟩ := hx'
    exact y.2
  omega

theorem normLM_sup_right_inclusion_eq (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    (K M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K]
    [FiniteDimensional F M]
    (hdeg : Module.finrank K (IntermediateField.extendScalars (le_sup_left : K ≤ K ⊔ M)) =
      Module.finrank F M)
    (y : K) :
    ((EllipticRootNumber.normLM F (le_sup_right : M ≤ K ⊔ M)
        (IntermediateField.inclusion (le_sup_left : K ≤ K ⊔ M) y) : M) : AlgebraicClosure F) =
      ((EllipticRootNumber.normLM F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ K) y :
          (⊥ : IntermediateField F (AlgebraicClosure F))) : AlgebraicClosure F) :=
by
  have hKP : K ≤ K ⊔ M := le_sup_left
  have hMP : M ≤ K ⊔ M := le_sup_right
  have hbK : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ K := bot_le
  
  have hb : 0 < Module.finrank F M := Module.finrank_pos
  have hKpos : 0 < Module.finrank F K := Module.finrank_pos
  have e1 := IntermediateField.relfinrank_eq_finrank_of_le hKP
  have e2 := IntermediateField.finrank_bot_mul_relfinrank hKP
  have e3 := IntermediateField.finrank_bot_mul_relfinrank hMP
  have e4 := IntermediateField.relfinrank_eq_finrank_of_le hMP
  have h1 : Module.finrank M (IntermediateField.extendScalars hMP) = Module.finrank F K := by
    rw [← e4]
    apply Nat.eq_of_mul_eq_mul_left hb
    rw [e3, ← e2, e1, hdeg, mul_comm]
  have h0 : Module.finrank (⊥ : IntermediateField F (AlgebraicClosure F))
      (IntermediateField.extendScalars hbK) = Module.finrank F K := by
    rw [← IntermediateField.relfinrank_eq_finrank_of_le, IntermediateField.relfinrank_bot_left]
  
  haveI : FiniteDimensional M (IntermediateField.extendScalars hMP) :=
    Module.finite_of_finrank_pos (h1 ▸ hKpos)
  haveI : FiniteDimensional (⊥ : IntermediateField F (AlgebraicClosure F))
      (IntermediateField.extendScalars hbK) :=
    Module.finite_of_finrank_pos (h0 ▸ hKpos)
  haveI : CharZero M := charZero_of_injective_algebraMap (algebraMap F M).injective
  haveI : CharZero (⊥ : IntermediateField F (AlgebraicClosure F)) :=
    charZero_of_injective_algebraMap (algebraMap F (⊥ : IntermediateField F (AlgebraicClosure F))).injective
  haveI : Algebra.IsSeparable M (IntermediateField.extendScalars hMP) :=
    Algebra.IsAlgebraic.isSeparable_of_perfectField
  haveI : Algebra.IsSeparable (⊥ : IntermediateField F (AlgebraicClosure F))
      (IntermediateField.extendScalars hbK) :=
    Algebra.IsAlgebraic.isSeparable_of_perfectField
  
  let ι : IntermediateField.extendScalars hbK →+* IntermediateField.extendScalars hMP :=
    { toFun := fun x => ⟨x.1, (IntermediateField.mem_extendScalars hMP).mpr
        (hKP ((IntermediateField.mem_extendScalars hbK).mp x.2))⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let r : (IntermediateField.extendScalars hMP →ₐ[M] AlgebraicClosure F) →
      (IntermediateField.extendScalars hbK →ₐ[(⊥ : IntermediateField F (AlgebraicClosure F))]
        AlgebraicClosure F) := fun σ =>
    { σ.toRingHom.comp ι with
      commutes' := fun c => by
        have hc : (c : AlgebraicClosure F) ∈ M := (bot_le : (⊥ : IntermediateField F _) ≤ M) c.2
        have hι : ι (algebraMap _ (IntermediateField.extendScalars hbK) c) =
            algebraMap M (IntermediateField.extendScalars hMP) ⟨c, hc⟩ := Subtype.ext rfl
        show σ (ι (algebraMap _ (IntermediateField.extendScalars hbK) c)) = _
        rw [hι, σ.commutes]
        rfl }
  
  have hS : IntermediateField.extendScalars hMP =
      IntermediateField.adjoin M (K : Set (AlgebraicClosure F)) := by
    apply le_antisymm
    · rw [IntermediateField.extendScalars_le_iff]
      apply sup_le
      · intro x hx
        exact IntermediateField.subset_adjoin M (K : Set (AlgebraicClosure F)) hx
      · intro x hx
        exact (IntermediateField.adjoin M (K : Set (AlgebraicClosure F))).algebraMap_mem ⟨x, hx⟩
    · rw [IntermediateField.adjoin_le_iff]
      intro x hx
      exact (IntermediateField.mem_extendScalars hMP).mpr (hKP hx)
  have hinj : Function.Injective r := by
    intro σ₁ σ₂ h
    apply IntermediateField.algHom_ext_of_eq_adjoin M hS
    intro x hx
    exact DFunLike.congr_fun h ⟨x, (IntermediateField.mem_extendScalars hbK).mpr hx⟩
  have hbij : Function.Bijective r := by
    rw [Fintype.bijective_iff_injective_and_card]
    refine ⟨hinj, ?_⟩
    rw [AlgHom.card, AlgHom.card, h1, h0]
  show algebraMap M (AlgebraicClosure F)
      (Algebra.norm M (⟨(y : AlgebraicClosure F), (IntermediateField.mem_extendScalars hMP).mpr
        (hKP y.2)⟩ : IntermediateField.extendScalars hMP)) =
    algebraMap (⊥ : IntermediateField F (AlgebraicClosure F)) (AlgebraicClosure F)
      (Algebra.norm (⊥ : IntermediateField F (AlgebraicClosure F))
        (⟨(y : AlgebraicClosure F), (IntermediateField.mem_extendScalars hbK).mpr y.2⟩ :
          IntermediateField.extendScalars hbK))
  rw [Algebra.norm_eq_prod_embeddings, Algebra.norm_eq_prod_embeddings]
  exact Fintype.prod_bijective r hbij _ _ (fun σ => rfl)

theorem recMap_quadratic_disjoint_norm (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    (rec : EllipticRootNumber.LocalReciprocity F)
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (hM : Module.finrank F M = 2)
    (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K] (hMK : ¬ M ≤ K)
    (N : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F N]
    (hMN : M ≤ N) (hKN : K ≤ N)
    (habM : EllipticRootNumber.IsAbelianExt F hMN) (habK : EllipticRootNumber.IsAbelianExt F hKN)
    (y : Kˣ) :
    ((rec.recMap M (Units.map (IntermediateField.inclusion
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)).toRingHom.toMonoidHom
        (Units.map (EllipticRootNumber.normLM F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ K)) y)) :
        EllipticRootNumber.AbsGal F))⁻¹ *
      ((rec.recMap K y : EllipticRootNumber.AbsGal F) ^ 2) ∈ N.fixingSubgroup :=
by
  classical
  haveI : FiniteDimensional F (K ⊔ M : IntermediateField F (AlgebraicClosure F)) :=
    IntermediateField.finiteDimensional_sup K M
  have hd : Module.finrank K (IntermediateField.extendScalars (le_sup_left : K ≤ K ⊔ M)) = 2 :=
    finrank_sup_left_eq_two_of_quadratic F M K hM hMK
  set yP : (K ⊔ M : IntermediateField F (AlgebraicClosure F))ˣ :=
    Units.map (IntermediateField.inclusion (le_sup_left : K ≤ K ⊔ M)).toRingHom.toMonoidHom y
    with hyP
  
  have s6 : Units.map (EllipticRootNumber.normLM F (le_sup_right : M ≤ K ⊔ M)) yP =
      Units.map (IntermediateField.inclusion
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)).toRingHom.toMonoidHom
        (Units.map (EllipticRootNumber.normLM F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ K)) y) := by
    apply Units.ext
    apply Subtype.ext
    exact normLM_sup_right_inclusion_eq F K M (hd.trans hM.symm) (y : K)
  
  have s7 : Units.map (EllipticRootNumber.normLM F (le_sup_left : K ≤ K ⊔ M)) yP = y * y := by
    apply Units.ext
    have h1 : EllipticRootNumber.toExtendScalars F (le_sup_left : K ≤ K ⊔ M)
        (IntermediateField.inclusion (le_sup_left : K ≤ K ⊔ M) (y : K)) =
        algebraMap K (IntermediateField.extendScalars (le_sup_left : K ≤ K ⊔ M)) (y : K) :=
      Subtype.ext rfl
    show Algebra.norm K (EllipticRootNumber.toExtendScalars F (le_sup_left : K ≤ K ⊔ M)
        (IntermediateField.inclusion (le_sup_left : K ≤ K ⊔ M) (y : K))) = ((y * y : Kˣ) : K)
    rw [h1, Algebra.norm_algebraMap, hd, pow_two, Units.val_mul]
  have cA := recMap_norm_compat F rec M (K ⊔ M) le_sup_right N hMN habM yP
  rw [s6] at cA
  have cC := recMap_norm_compat F rec K (K ⊔ M) le_sup_left N hKN habK yP
  rw [s7] at cC
  have cD := rec.mul_rec K N hKN habK y y
  simp only [Subgroup.coe_mul, Subgroup.coe_inv] at cD
  have key := N.fixingSubgroup.mul_mem cA
    (N.fixingSubgroup.mul_mem (N.fixingSubgroup.inv_mem cC) cD)
  convert key using 1
  simp only [pow_two, mul_inv_rev, inv_inv, mul_assoc, mul_inv_cancel_left]

theorem quadratic_norm_eq_mul_conj (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (hM : Module.finrank F M = 2)
    (t : EllipticRootNumber.AbsGal F) (ht : t ∉ M.fixingSubgroup) :
    (∀ y : AlgebraicClosure F, y ∈ M ↔ t y ∈ M) ∧
    ∀ c : M, (((EllipticRootNumber.normLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) c :
        (⊥ : IntermediateField F (AlgebraicClosure F))) : AlgebraicClosure F) =
      (c : AlgebraicClosure F) * t (c : AlgebraicClosure F)) :=
by
  classical
  
  have hstab : ∀ σ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F, ∀ y : AlgebraicClosure F,
      y ∈ M → σ y ∈ M := by
    intro σ y hy
    haveI : Algebra.IsQuadraticExtension F M := ⟨hM⟩
    haveI : Normal F M := Algebra.IsQuadraticExtension.normal F M
    have h := IntermediateField.normal_iff_forall_map_le.mp ‹Normal F M›
      (σ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)
    apply h
    rw [← SetLike.mem_coe, IntermediateField.coe_map]
    exact Set.mem_image_of_mem _ hy
  refine ⟨fun y => ⟨fun hy => hstab t y hy, fun hy => ?_⟩, fun c => ?_⟩
  · have := hstab t⁻¹ (t y) hy
    rwa [AlgEquiv.aut_inv, AlgEquiv.symm_apply_apply] at this
  
  set K := (⊥ : IntermediateField F (AlgebraicClosure F)) with hK
  set L := IntermediateField.extendScalars (bot_le : K ≤ M) with hL
  have hfr : Module.finrank K L = 2 :=
    ((IntermediateField.relfinrank_eq_finrank_of_le (bot_le : K ≤ M)).symm.trans
      (IntermediateField.relfinrank_bot_left M)).trans hM
  haveI : Module.Free K L := Module.Free.of_divisionRing K L
  haveI : FiniteDimensional K L := Module.finite_of_finrank_eq_succ hfr
  haveI : Algebra.IsSeparable K L := inferInstance
  let z : L := ⟨(c : AlgebraicClosure F), (IntermediateField.mem_extendScalars _).mpr c.2⟩
  let t' : AlgebraicClosure F →ₐ[K] AlgebraicClosure F :=
    { toRingHom := (t : AlgebraicClosure F →+* AlgebraicClosure F)
      commutes' := by
        intro r
        obtain ⟨a, ha⟩ := IntermediateField.mem_bot.mp r.2
        rw [IntermediateField.algebraMap_apply]
        show t (r : AlgebraicClosure F) = (r : AlgebraicClosure F)
        rw [← ha]
        exact t.commutes a }
  let σ₁ : L →ₐ[K] AlgebraicClosure F := L.val
  let σ₂ : L →ₐ[K] AlgebraicClosure F := t'.comp L.val
  have hne : σ₁ ≠ σ₂ := by
    intro heq
    apply ht
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    have := AlgHom.congr_fun heq ⟨x, (IntermediateField.mem_extendScalars _).mpr hx⟩
    exact this.symm
  have hcard : Fintype.card (L →ₐ[K] AlgebraicClosure F) = 2 := by
    rw [AlgHom.card K L (AlgebraicClosure F), hfr]
  have huniv : (Finset.univ : Finset (L →ₐ[K] AlgebraicClosure F)) = {σ₁, σ₂} :=
    (Finset.eq_univ_of_card {σ₁, σ₂} (by rw [Finset.card_pair hne, hcard])).symm
  have hnorm := Algebra.norm_eq_prod_embeddings K (AlgebraicClosure F) z
  rw [huniv, Finset.prod_pair hne] at hnorm
  have hlhs : EllipticRootNumber.normLM F (bot_le : K ≤ M) c = Algebra.norm K z := rfl
  rw [hlhs, ← IntermediateField.algebraMap_apply, hnorm]
  rfl

theorem recMap_transfer_quadratic (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] (rec : EllipticRootNumber.LocalReciprocity F)
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (hM : Module.finrank F M = 2)
    (N : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F N] (hMN : M ≤ N)
    (hab : EllipticRootNumber.IsAbelianExt F hMN)
    (t : EllipticRootNumber.AbsGal F) (ht₀ : t ∈ EllipticRootNumber.weilGroup F)
    (ht : t ∉ M.fixingSubgroup)
    (b : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
    ((rec.recMap ⊥ b : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup →
      ((rec.recMap M (Units.map (IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)).toRingHom.toMonoidHom b) :
          EllipticRootNumber.AbsGal F))⁻¹ *
        ((rec.recMap ⊥ b : EllipticRootNumber.AbsGal F) *
          (t * (rec.recMap ⊥ b : EllipticRootNumber.AbsGal F) * t⁻¹)) ∈ N.fixingSubgroup) ∧
    ((rec.recMap ⊥ b : EllipticRootNumber.AbsGal F) ∉ M.fixingSubgroup →
      ((rec.recMap M (Units.map (IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)).toRingHom.toMonoidHom b) :
          EllipticRootNumber.AbsGal F))⁻¹ *
        ((rec.recMap ⊥ b : EllipticRootNumber.AbsGal F) *
          (rec.recMap ⊥ b : EllipticRootNumber.AbsGal F)) ∈ N.fixingSubgroup) :=
by
  classical
  open EllipticRootNumber in
  
  generalize hι : Units.map (IntermediateField.inclusion
    (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)).toRingHom.toMonoidHom = ι
  have relWeil_fix : ∀ (L : IntermediateField F (AlgebraicClosure F)) (w : relWeil F L),
      (w : AbsGal F) ∈ L.fixingSubgroup := fun L w => (Subgroup.mem_inf.mp w.2).2
  have botTop : ∀ σ : AbsGal F,
      σ ∈ (⊥ : IntermediateField F (AlgebraicClosure F)).fixingSubgroup := by
    intro σ
    rw [IntermediateField.fixingSubgroup_bot]
    exact Subgroup.mem_top σ
  
  obtain ⟨hG2, hsep⟩ := quadratic_fixingSubgroup_spec F M hM
  have hMnorm : ∀ σ : AbsGal F, ∀ h ∈ M.fixingSubgroup, σ * h * σ⁻¹ ∈ M.fixingSubgroup := by
    intro σ h hh
    by_cases hσ : σ ∈ M.fixingSubgroup
    · exact M.fixingSubgroup.mul_mem (M.fixingSubgroup.mul_mem hσ hh)
        (M.fixingSubgroup.inv_mem hσ)
    · have h1 : σ * h ∉ M.fixingSubgroup := by
        intro h'
        apply hσ
        have h2 := M.fixingSubgroup.mul_mem h' (M.fixingSubgroup.inv_mem hh)
        rwa [mul_inv_cancel_right] at h2
      exact hG2 _ _ h1 hσ
  have hMcomm : ∀ x y : AbsGal F, x * y * x⁻¹ * y⁻¹ ∈ M.fixingSubgroup := by
    intro x y
    by_cases hx : x ∈ M.fixingSubgroup
    · have h1 := hMnorm y x⁻¹ (M.fixingSubgroup.inv_mem hx)
      have h2 := M.fixingSubgroup.mul_mem hx h1
      simpa only [mul_assoc, inv_inv] using h2
    · by_cases hy : y ∈ M.fixingSubgroup
      · have h1 := hMnorm x y hy
        exact M.fixingSubgroup.mul_mem h1 (M.fixingSubgroup.inv_mem hy)
      · have hy' : y⁻¹ ∉ M.fixingSubgroup := fun h => hy (by simpa using M.fixingSubgroup.inv_mem h)
        have hx' : x⁻¹ ∉ M.fixingSubgroup := fun h => hx (by simpa using M.fixingSubgroup.inv_mem h)
        have h1 : x * y ∈ M.fixingSubgroup := by simpa using hG2 x y⁻¹ hx hy'
        have h2 : x⁻¹ * y⁻¹ ∈ M.fixingSubgroup := hG2 x⁻¹ y hx' hy
        have h3 := M.fixingSubgroup.mul_mem h1 h2
        simpa only [mul_assoc] using h3
  have habM : IsAbelianExt F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) :=
    ⟨fun σ _ τ hτ => hMnorm σ τ hτ, fun σ _ τ _ => hMcomm σ τ, hsep⟩
  have hcommM : ⁅(⊤ : Subgroup (AbsGal F)), (⊤ : Subgroup (AbsGal F))⁆ ≤ M.fixingSubgroup := by
    rw [Subgroup.commutator_le]
    intro x _ y _
    rw [commutatorElement_def]
    exact hMcomm x y
  
  obtain ⟨N', h', hN'fd, hab', hNN', hstab⟩ := exists_galois_abelian_hull F M hM N hMN hab
  haveI := hN'fd
  have hN'N : N'.fixingSubgroup ≤ N.fixingSubgroup := IntermediateField.fixingSubgroup_le hNN'
  have hN'M : N'.fixingSubgroup ≤ M.fixingSubgroup := IntermediateField.fixingSubgroup_le h'
  have hN'norm : ∀ σ : AbsGal F, ∀ k ∈ N'.fixingSubgroup, σ * k * σ⁻¹ ∈ N'.fixingSubgroup := by
    intro σ k hk
    rw [IntermediateField.mem_fixingSubgroup_iff] at hk ⊢
    intro y hy
    have hy' : σ⁻¹ y ∈ N' := (hstab σ⁻¹ y).mp hy
    have e := hk _ hy'
    rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, e, ← AlgEquiv.mul_apply, mul_inv_cancel,
      AlgEquiv.one_apply]
  haveI : N'.fixingSubgroup.Normal := ⟨fun k hk g => hN'norm g k hk⟩
  obtain ⟨π, πeq⟩ : ∃ π : AbsGal F →* AbsGal F ⧸ N'.fixingSubgroup,
      ∀ x y : AbsGal F, π x = π y ↔ x⁻¹ * y ∈ N'.fixingSubgroup :=
    ⟨QuotientGroup.mk' _, fun x y => by
      rw [QuotientGroup.mk'_apply, QuotientGroup.mk'_apply]
      exact QuotientGroup.eq⟩
  
  obtain ⟨N₀, hN₀fd, hab₀, hN'N₀, hdec⟩ := exists_abelian_commutator_field F N'
  haveI := hN₀fd
  have hN₀M : N₀.fixingSubgroup ≤ M.fixingSubgroup := by
    intro k hk
    obtain ⟨c, hc, n, hn, rfl⟩ := hdec k hk
    exact M.fixingSubgroup.mul_mem (hcommM hc) (hN'M hn)
  have hN₀norm : ∀ σ : AbsGal F, ∀ k ∈ N₀.fixingSubgroup, σ * k * σ⁻¹ ∈ N₀.fixingSubgroup :=
    fun σ k hk => hab₀.1 σ (botTop σ) k hk
  
  obtain ⟨V, hV₁, hV₂⟩ : ∃ V : AbsGal F → AbsGal F,
      (∀ g ∈ M.fixingSubgroup, V g = g * (t * g * t⁻¹)) ∧
      (∀ g ∉ M.fixingSubgroup, V g = g * g) :=
    ⟨fun g => if g ∈ M.fixingSubgroup then g * (t * g * t⁻¹) else g * g,
      fun g hg => if_pos hg, fun g hg => if_neg hg⟩
  obtain ⟨hVb, hVd⟩ := transfer_index_two_mod M.fixingSubgroup N'.fixingSubgroup t ht hG2
    hN'norm hN'M hab'.2.1 V hV₁ hV₂
  have hVe : ∀ x y : AbsGal F, x⁻¹ * y ∈ N₀.fixingSubgroup →
      π (V x) = π (V y) := by
    intro x y hxy
    obtain ⟨c, hc, n, hn, hcn⟩ := hdec _ hxy
    have hy : y = x * (c * n) := by rw [← hcn, mul_inv_cancel_left]
    rw [πeq, hy]
    exact hVd x c n hc hn
  have hVmul : ∀ g₁ g₂ : AbsGal F, π (V (g₁ * g₂)) = π (V g₁) * π (V g₂) := by
    intro g₁ g₂
    rw [← map_mul π, πeq]
    exact hVb g₁ g₂
  
  have recMulM : ∀ x y : Mˣ, π (rec.recMap M (x * y) : AbsGal F) =
      π (rec.recMap M x : AbsGal F) * π (rec.recMap M y : AbsGal F) := by
    intro x y
    rw [← map_mul π, πeq]
    have h := rec.mul_rec M N' h' hab' x y
    simpa only [Subgroup.coe_mul, Subgroup.coe_inv] using h
  
  have Zmult : ∀ a₁ a₂ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      π (rec.recMap M (ι a₁) : AbsGal F) = π (V (rec.recMap ⊥ a₁ : AbsGal F)) →
      π (rec.recMap M (ι a₂) : AbsGal F) = π (V (rec.recMap ⊥ a₂ : AbsGal F)) →
      π (rec.recMap M (ι (a₁ * a₂)) : AbsGal F) = π (V (rec.recMap ⊥ (a₁ * a₂) : AbsGal F)) := by
    intro a₁ a₂ h₁ h₂
    rw [map_mul ι, recMulM, h₁, h₂]
    have e1 : π (V (rec.recMap ⊥ (a₁ * a₂) : AbsGal F)) =
        π (V ((rec.recMap ⊥ a₁ : AbsGal F) * (rec.recMap ⊥ a₂ : AbsGal F))) := by
      apply hVe
      have h := rec.mul_rec ⊥ N₀ bot_le hab₀ a₁ a₂
      simpa only [Subgroup.coe_mul, Subgroup.coe_inv] using h
    rw [e1, hVmul]
  
  obtain ⟨hQ1, hQ2⟩ := quadratic_norm_eq_mul_conj F M hM t ht
  have Znorm : ∀ c : Mˣ,
      π (rec.recMap M (ι (Units.map (normLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) c)) : AbsGal F) =
      π (V (rec.recMap ⊥ (Units.map (normLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) c) : AbsGal F)) := by
    intro c
    have hc'mem : t ((c : M) : AlgebraicClosure F) ∈ M := (hQ1 _).mp (c : M).2
    have hc'ne : (⟨t ((c : M) : AlgebraicClosure F), hc'mem⟩ : M) ≠ 0 := by
      intro h
      have h1 : t ((c : M) : AlgebraicClosure F) = 0 := congrArg Subtype.val h
      have h2 : ((c : M) : AlgebraicClosure F) = 0 := by
        rw [← map_zero t] at h1
        exact t.injective h1
      exact c.ne_zero (Subtype.ext h2)
    set c' : Mˣ := Units.mk0 _ hc'ne with hc'def
    have hιa : ι (Units.map (normLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) c) = c * c' := by
      rw [← hι]
      apply Units.ext
      apply Subtype.ext
      exact hQ2 c
    rw [hιa, recMulM]
    have hC6 := recMap_conj_compat F rec M t ht₀ hQ1 N' h' hab' (hstab t) c c' rfl
    rw [(πeq _ _).mpr hC6, ← map_mul π]
    have hrc : (rec.recMap M c : AbsGal F) ∈ M.fixingSubgroup := relWeil_fix M _
    rw [← hV₁ _ hrc]
    apply hVe
    have h5 := recMap_norm_compat F rec ⊥ M bot_le N₀ bot_le hab₀ c
    have h6 := N₀.fixingSubgroup.inv_mem h5
    simpa only [mul_inv_rev, inv_inv] using h6
  
  have normUnit : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      (rec.recMap ⊥ x : AbsGal F) ∈ M.fixingSubgroup →
      ∃ c : Mˣ, Units.map (normLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) c = x := by
    intro x hx
    obtain ⟨c₀, hc₀⟩ := (rec.ker_rec ⊥ M bot_le habM x).mp hx
    have hc₀ne : c₀ ≠ 0 := by
      rintro rfl
      have h0 : (((x : (⊥ : IntermediateField F (AlgebraicClosure F)))) :
          AlgebraicClosure F) = 0 := by
        rw [← hc₀, hQ2 0]
        simp
      exact x.ne_zero (Subtype.ext h0)
    refine ⟨Units.mk0 c₀ hc₀ne, ?_⟩
    apply Units.ext
    exact hc₀
  
  have Znonnorm : ∀ a : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      (rec.recMap ⊥ a : AbsGal F) ∉ M.fixingSubgroup →
      π (rec.recMap M (ι a) : AbsGal F) = π (V (rec.recMap ⊥ a : AbsGal F)) := by
    intro a hs
    obtain ⟨K', h₂, hK'fd, hsK, habK⟩ :=
      exists_cyclic_abelian_subfield F N' hN'norm (rec.recMap ⊥ a : AbsGal F)
    haveI := hK'fd
    have hMK : ¬ M ≤ K' := fun hle => hs (IntermediateField.fixingSubgroup_le hle hsK)
    have hsW : (rec.recMap ⊥ a : AbsGal F) ∈ relWeil F K' :=
      Subgroup.mem_inf.mpr ⟨relWeil_le_weilGroup F ⊥ (rec.recMap ⊥ a).2, hsK⟩
    obtain ⟨y, hy⟩ := rec.surj_rec K' N' h₂ habK ⟨_, hsW⟩
    have hy' : (rec.recMap K' y : AbsGal F)⁻¹ * (rec.recMap ⊥ a : AbsGal F) ∈
        N'.fixingSubgroup := by
      simpa only [Subgroup.coe_mul, Subgroup.coe_inv] using hy
    have h5 := recMap_norm_compat F rec ⊥ K' bot_le N₀ bot_le hab₀ y
    have ha's : (rec.recMap ⊥ (Units.map (normLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ K')) y) : AbsGal F)⁻¹ *
        (rec.recMap ⊥ a : AbsGal F) ∈ N₀.fixingSubgroup := by
      have h := N₀.fixingSubgroup.mul_mem h5 (hN'N₀ hy')
      simpa only [mul_assoc, mul_inv_cancel_left] using h
    have Za' : π (rec.recMap M (ι (Units.map (normLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ K')) y)) : AbsGal F) =
        π (V (rec.recMap ⊥ (Units.map (normLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ K')) y) : AbsGal F)) := by
      have h7 := recMap_quadratic_disjoint_norm F rec M hM K' hMK N' h' h₂ hab' habK y
      rw [hι] at h7
      rw [(πeq _ _).mpr h7, hVe _ _ ha's, hV₂ _ hs, map_mul π, pow_two, map_mul π,
        (πeq _ _).mpr hy']
    have hX : (rec.recMap ⊥ (a * (Units.map (normLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ K')) y)⁻¹) : AbsGal F) ∈
        N₀.fixingSubgroup := by
      have hm := rec.mul_rec ⊥ N₀ bot_le hab₀ (a * (Units.map (normLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ K')) y)⁻¹)
        (Units.map (normLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ K')) y)
      rw [inv_mul_cancel_right] at hm
      simp only [Subgroup.coe_mul, Subgroup.coe_inv] at hm
      have h1 := N₀.fixingSubgroup.mul_mem hm ha's
      have h2 : (rec.recMap ⊥ a : AbsGal F)⁻¹ * (rec.recMap ⊥ (a * (Units.map (normLM F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ K')) y)⁻¹) : AbsGal F) *
          (rec.recMap ⊥ a : AbsGal F) ∈ N₀.fixingSubgroup := by
        simpa only [mul_assoc, mul_inv_cancel_left] using h1
      have h3 := hN₀norm (rec.recMap ⊥ a : AbsGal F) _ h2
      simpa only [mul_assoc, mul_inv_cancel_left, mul_inv_cancel, mul_one] using h3
    obtain ⟨c, hc⟩ := normUnit _ (hN₀M hX)
    have Z1 := Znorm c
    rw [hc] at Z1
    have Z2 := Zmult _ _ Z1 Za'
    rwa [inv_mul_cancel_right] at Z2
  
  have Zb : π (rec.recMap M (ι b) : AbsGal F) = π (V (rec.recMap ⊥ b : AbsGal F)) := by
    by_cases hb : (rec.recMap ⊥ b : AbsGal F) ∈ M.fixingSubgroup
    · obtain ⟨c, hc⟩ := normUnit b hb
      have Z1 := Znorm c
      rw [hc] at Z1
      exact Z1
    · exact Znonnorm b hb
  have hZb := (πeq _ _).mp Zb
  refine ⟨fun hb => ?_, fun hb => ?_⟩
  · rw [← hV₁ _ hb]
    exact hN'N hZb
  · rw [← hV₂ _ hb]
    exact hN'N hZb

theorem eps_psi_indep_of_quadratic_line (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    {rec : EllipticRootNumber.LocalReciprocity F} (lc : EllipticRootNumber.LocalConstants F rec)
    {V : Type u} [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
    (ρ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V)
    (hW : EllipticRootNumber.IsWeilRep F ⊥ ρ)
    (hdim : Module.finrank (EllipticRootNumber.Ω F) V = 2)
    (hdet : ∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → LinearMap.det (ρ w) = 1)
    (hnl : ¬ ∃ L : Submodule (EllipticRootNumber.Ω F) V, Module.finrank (EllipticRootNumber.Ω F) L = 1 ∧
      ∀ w : EllipticRootNumber.relWeil F ⊥, ∀ v ∈ L, ρ w v ∈ L)
    (hq : ∃ M : IntermediateField F (AlgebraicClosure F), FiniteDimensional F M ∧
      Module.finrank F M = 2 ∧ ∃ L : Submodule (EllipticRootNumber.Ω F) V,
        Module.finrank (EllipticRootNumber.Ω F) L = 1 ∧
        ∀ w : EllipticRootNumber.relWeil F ⊥, (w : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup →
          ∀ v ∈ L, ρ w v ∈ L)
    (ψ ψ' : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F))
    (hψ : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1)
    (hψ' : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ' x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ' x ≠ 1) :
    lc.eps ⊥ ρ ψ = lc.eps ⊥ ρ ψ' :=
by
  classical
