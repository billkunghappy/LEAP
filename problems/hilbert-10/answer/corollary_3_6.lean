      intro ε hε y
      by_cases hy0 : y = 0
      · rw [hy0, zero_mul]
      · rw [hmul _ _ hy0 ε.ne_zero, hU0 ε hε, add_zero]
    
    have hs4 : ∀ ε ∈ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ'), ∀ y : L,
