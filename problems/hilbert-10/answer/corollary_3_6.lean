theorem exists_unit_supported_at_prime {K : Type u} [Field K] [NumberField K]
    (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    ∃ z : Kˣ, p.valuationOfNeZero z ≠ 1 ∧ ∀ v, v ≠ p → v.valuationOfNeZero z = 1 :=
by
  classical
  have hP0 : p.asIdeal ≠ 0 := p.ne_bot
  have hPmem : p.asIdeal ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
    mem_nonZeroDivisors_of_ne_zero hP0
  set x : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) := ⟨p.asIdeal, hPmem⟩ with hx
  set n := orderOf (ClassGroup.mk0 x) with hn
  have hnpos : 0 < n := orderOf_pos _
  have hcn : ClassGroup.mk0 (x ^ n) = 1 := by rw [map_pow, hn, pow_orderOf_eq_one]
  have hxn : x ^ n = ⟨p.asIdeal ^ n, (x ^ n).2⟩ := Subtype.ext (by simp [hx])
  rw [hxn, ClassGroup.mk0_eq_one_iff] at hcn
  obtain ⟨α, hα⟩ := hcn.principal
  have hspan : Ideal.span {α} = p.asIdeal ^ n := hα.symm
  have hα0 : α ≠ 0 := by
    rintro rfl
    rw [Ideal.span_singleton_eq_bot.mpr rfl] at hspan
    exact pow_ne_zero n hP0 hspan.symm
  have hαK : algebraMap (NumberField.RingOfIntegers K) K α ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ K)).mpr hα0
  have key : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      v.valuationOfNeZero (Units.mk0 _ hαK) = 1 ↔ v.intValuation α = 1 := by
    intro v
    have h := IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq v (Units.mk0 _ hαK)
    rw [Units.val_mk0, IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap] at h
    rw [← h]
    constructor
    · intro h1
      rw [h1]
      rfl
    · intro h1
      exact_mod_cast h1
  refine ⟨Units.mk0 _ hαK, ?_, ?_⟩
  · rw [Ne, key]
    have hdvd : p.asIdeal ∣ Ideal.span {α} := by
      rw [hspan]
      exact dvd_pow_self _ (Nat.pos_iff_ne_zero.mp hnpos)
    exact ne_of_lt ((p.intValuation_lt_one_iff_dvd α).mpr hdvd)
  · intro v hv
    rw [key]
    refine le_antisymm (v.intValuation_le_one α) (not_lt.mp ?_)
    intro hlt
    have hdvd : v.asIdeal ∣ p.asIdeal ^ n := by
      rw [← hspan]
      exact (v.intValuation_lt_one_iff_dvd α).mp hlt
    have h1 : v.asIdeal ∣ p.asIdeal := v.prime.dvd_of_dvd_pow hdvd
    have h2 : p.asIdeal ≤ v.asIdeal := Ideal.le_of_dvd h1
    have h3 : p.asIdeal = v.asIdeal := p.isMaximal.eq_of_le v.isPrime.ne_top h2
    exact hv (IsDedekindDomain.HeightOneSpectrum.ext h3.symm)

theorem ncard_unitClasses_empty {K : Type u} [Field K] [NumberField K] :
    Set.ncard {c : SqCl K | ∃ x : Kˣ, c = sqCl x ∧
        ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          v.valuationOfNeZero x = 1} =
      Nat.card ((NumberField.RingOfIntegers K)ˣ ⧸
        (powMonoidHom 2 : (NumberField.RingOfIntegers K)ˣ →* (NumberField.RingOfIntegers K)ˣ).range) :=
by
  classical
  let ι : (NumberField.RingOfIntegers K)ˣ →* Kˣ :=
    Units.map (algebraMap (NumberField.RingOfIntegers K) K : NumberField.RingOfIntegers K →* K)
  let φ : (NumberField.RingOfIntegers K)ˣ →* SqCl K :=
    (QuotientGroup.mk' (powMonoidHom 2 : Kˣ →* Kˣ).range).comp ι
  have hφ : ∀ u, φ u = sqCl (ι u) := fun u => rfl
  have hinj : Function.Injective (algebraMap (NumberField.RingOfIntegers K) K) :=
    IsFractionRing.injective (NumberField.RingOfIntegers K) K
  have hle : ∀ y : Kˣ, (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      v.valuationOfNeZero y = 1) →
      ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        IsDedekindDomain.HeightOneSpectrum.valuation K v (y : K) ≤ 1 := by
    intro y hy v
    rw [← IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq, hy v]
    simp
  have s1 : ∀ x : Kˣ, (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      v.valuationOfNeZero x = 1) → ∃ u, ι u = x := by
    intro x hx
    have hx' : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        v.valuationOfNeZero x⁻¹ = 1 := by
      intro v
      rw [map_inv, hx v, inv_one]
    obtain ⟨a, ha⟩ := IsDedekindDomain.HeightOneSpectrum.mem_integers_of_valuation_le_one K
      (x : K) (hle x hx)
    obtain ⟨b, hb⟩ := IsDedekindDomain.HeightOneSpectrum.mem_integers_of_valuation_le_one K
      ((x⁻¹ : Kˣ) : K) (hle _ hx')
    have hab : a * b = 1 := hinj (by rw [map_mul, ha, hb, Units.mul_inv, map_one])
    refine ⟨⟨a, b, hab, by rw [mul_comm]; exact hab⟩, Units.ext ?_⟩
    show algebraMap (NumberField.RingOfIntegers K) K a = (x : K)
    exact ha
  have s3 : {c : SqCl K | ∃ x : Kˣ, c = sqCl x ∧
        ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
          v.valuationOfNeZero x = 1} = Set.range φ := by
    ext c
    constructor
    · rintro ⟨x, rfl, hx⟩
      obtain ⟨u, hu⟩ := s1 x hx
      exact ⟨u, by rw [hφ, hu]⟩
    · rintro ⟨u, rfl⟩
      exact ⟨ι u, hφ u, fun v => IsDedekindDomain.HeightOneSpectrum.valuation_of_unit_eq v u⟩
  have s4 : φ.ker = (powMonoidHom 2 : (NumberField.RingOfIntegers K)ˣ →*
      (NumberField.RingOfIntegers K)ˣ).range := by
    haveI : Fact (0 < 2) := ⟨two_pos⟩
    rw [← IsDedekindDomain.selmerGroup.fromUnit_ker (R := NumberField.RingOfIntegers K) (K := K)
      (n := 2)]
    ext u
    rw [MonoidHom.mem_ker, MonoidHom.mem_ker]
    exact ⟨fun h => Subtype.ext h, fun h => congrArg Subtype.val h⟩
  rw [s3, ← Nat.card_coe_set_eq, ← MonoidHom.coe_range]
  exact Nat.card_congr ((QuotientGroup.quotientKerEquivRange φ).toEquiv.symm.trans
    (QuotientGroup.quotientMulEquivOfEq s4).toEquiv)

theorem card_units_mod_squares {K : Type u} [Field K] [NumberField K] :
    Nat.card ((NumberField.RingOfIntegers K)ˣ ⧸
        (powMonoidHom 2 : (NumberField.RingOfIntegers K)ˣ →* (NumberField.RingOfIntegers K)ˣ).range) =
      2 ^ Fintype.card (NumberField.InfinitePlace K) :=
by
  
  have s1 : ∀ {G : Type u} [CommGroup G] (H : Subgroup G),
      (∀ g : G, g ^ 2 ∈ H → g ∈ H) →
      (powMonoidHom 2 : G →* G).range.index =
        (powMonoidHom 2 : H →* H).range.index *
          (powMonoidHom 2 : G ⧸ H →* G ⧸ H).range.index := by
    intro G _ H hsat
    set S := (powMonoidHom 2 : G →* G).range with hS
    set S' := (powMonoidHom 2 : G ⧸ H →* G ⧸ H).range with hS'
    have hSM : S ≤ H ⊔ S := le_sup_right
    rw [← Subgroup.relIndex_mul_index hSM, Subgroup.relIndex_sup_right]
    congr 1
    · unfold Subgroup.relIndex
      congr 1
      ext h
      rw [Subgroup.mem_subgroupOf]
      simp only [hS, MonoidHom.mem_range, powMonoidHom_apply]
      constructor
      · rintro ⟨g, hg⟩
        have hgH : g ∈ H := hsat g (hg ▸ h.2)
        exact ⟨⟨g, hgH⟩, Subtype.ext (by simpa using hg)⟩
      · rintro ⟨k, hk⟩
        exact ⟨k, by rw [← hk]; simp⟩
    · have hM : H ⊔ S = S'.comap (QuotientGroup.mk' H) := by
        apply le_antisymm
        · refine sup_le ?_ ?_
          · intro h hh
            simp only [Subgroup.mem_comap, hS', MonoidHom.mem_range, powMonoidHom_apply]
            exact ⟨1, by simp [(QuotientGroup.eq_one_iff h).mpr hh]⟩
          · rintro x ⟨g, rfl⟩
            simp only [Subgroup.mem_comap, hS', MonoidHom.mem_range, powMonoidHom_apply]
            exact ⟨QuotientGroup.mk' H g, by simp⟩
        · intro x hx
          simp only [Subgroup.mem_comap, hS', MonoidHom.mem_range, powMonoidHom_apply] at hx
          obtain ⟨q, hq⟩ := hx
          obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective H q
          have h0 : (QuotientGroup.mk (g ^ 2) : G ⧸ H) = QuotientGroup.mk x := by
            rw [QuotientGroup.mk_pow]; exact hq
          have h1 : (g ^ 2)⁻¹ * x ∈ H := QuotientGroup.eq.mp h0
          have e : x = g ^ 2 * ((g ^ 2)⁻¹ * x) := by group
          rw [e]
          exact mul_mem (Subgroup.mem_sup_right ⟨g, rfl⟩) (Subgroup.mem_sup_left h1)
      rw [hM, Subgroup.index_comap_of_surjective _ (QuotientGroup.mk'_surjective H)]
  
  have s2 : ∀ {A : Type u} [CommGroup A] {r : ℕ} (b : Module.Basis (Fin r) ℤ (Additive A)),
      (powMonoidHom 2 : A →* A).range.index = 2 ^ r := by
    intro A _ r b
    haveI := Module.Free.of_basis b
    haveI := Module.Finite.of_basis b
    have hr : Module.finrank ℤ (Additive A) = r :=
      (Module.finrank_eq_card_basis b).trans (Fintype.card_fin r)
    have h1 := ModN.natCard_eq (Additive A) 2
    rw [hr] at h1
    rw [← h1, ← Subgroup.index_toAddSubgroup]
    have e : Subgroup.toAddSubgroup (powMonoidHom 2 : A →* A).range =
        (LinearMap.range (LinearMap.lsmul ℤ (Additive A) ((2:ℕ):ℤ))).toAddSubgroup := by
      ext x
      rw [Submodule.mem_toAddSubgroup, LinearMap.mem_range]
      change Additive.toMul x ∈ (powMonoidHom 2 : A →* A).range ↔ _
      rw [MonoidHom.mem_range]
      constructor
      · rintro ⟨a, ha⟩
        refine ⟨Additive.ofMul a, ?_⟩
        apply Additive.toMul.injective
        rw [LinearMap.lsmul_apply, toMul_zsmul, toMul_ofMul, ← ha, powMonoidHom_apply,
          zpow_natCast]
      · rintro ⟨y, hy⟩
        refine ⟨Additive.toMul y, ?_⟩
        rw [← hy, LinearMap.lsmul_apply, toMul_zsmul, powMonoidHom_apply, zpow_natCast]
    rw [e]
    rfl
  
  have s3 : (powMonoidHom 2 : NumberField.Units.torsion K →*
      NumberField.Units.torsion K).range.index = 2 := by
    rw [IsCyclic.index_powMonoidHom_range, Nat.card_eq_fintype_card]
    exact Nat.gcd_eq_right (even_iff_two_dvd.mp (NumberField.Units.even_torsionOrder K))
  
  have s4 : ∀ g : (NumberField.RingOfIntegers K)ˣ,
      g ^ 2 ∈ NumberField.Units.torsion K → g ∈ NumberField.Units.torsion K := by
    intro g hg
    change g ^ 2 ∈ CommGroup.torsion _ at hg
    change g ∈ CommGroup.torsion _
    rw [CommGroup.mem_torsion] at hg ⊢
    exact hg.of_pow two_ne_zero
  
  have s5 : NumberField.Units.rank K + 1 = Fintype.card (NumberField.InfinitePlace K) := by
    have := Fintype.card_pos (α := NumberField.InfinitePlace K)
    show Fintype.card (NumberField.InfinitePlace K) - 1 + 1 = _
    omega
  
  show (powMonoidHom 2 : (NumberField.RingOfIntegers K)ˣ →*
    (NumberField.RingOfIntegers K)ˣ).range.index = _
  rw [s1 _ s4, s3, s2 (NumberField.Units.basisModTorsion K), ← s5, pow_succ, mul_comm]

theorem ncard_KT2_of_sqGen {K : Type u} [Field K] [NumberField K]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (hgen : ∀ q, q ∉ T → ∃ y : Kˣ, ¬ EvenVal q y ∧ ∀ v, v ∉ T → v ≠ q → EvenVal v y) :
    Set.ncard {c : SqCl K | ∃ x : Kˣ, c = sqCl x ∧ ∀ v, v ∉ T → EvenVal v x} =
      2 ^ (T.card + Fintype.card (NumberField.InfinitePlace K)) :=
by
  classical
  
  have νmul : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x y : Kˣ), Multiplicative.toAdd (v.valuationOfNeZero (x * y)) =
        Multiplicative.toAdd (v.valuationOfNeZero x) +
          Multiplicative.toAdd (v.valuationOfNeZero y) := by
    intro v x y
    rw [map_mul, toAdd_mul]
  have νsq : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x : Kˣ), Multiplicative.toAdd (v.valuationOfNeZero (x ^ 2)) =
        2 * Multiplicative.toAdd (v.valuationOfNeZero x) := by
    intro v x
    rw [map_pow, toAdd_pow, nsmul_eq_mul]
    norm_num
  have νzpow : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x : Kˣ) (n : ℤ), Multiplicative.toAdd (v.valuationOfNeZero (x ^ n)) =
        n * Multiplicative.toAdd (v.valuationOfNeZero x) := by
    intro v x n
    rw [map_zpow, toAdd_zpow, smul_eq_mul]
  have νone : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x : Kˣ), v.valuationOfNeZero x = 1 ↔ Multiplicative.toAdd (v.valuationOfNeZero x) = 0 := by
    intro v x
    constructor
    · intro h
      rw [h]
      rfl
    · intro h
      exact Multiplicative.toAdd.injective (h.trans toAdd_one.symm)
  
  have Q1 : ∀ a b : Kˣ, sqCl a = sqCl b → ∃ w : Kˣ, b = a * w ^ 2 := by
    intro a b h
    unfold sqCl at h
    rw [QuotientGroup.eq] at h
    obtain ⟨w, hw⟩ := h
    refine ⟨w, ?_⟩
    rw [powMonoidHom_apply] at hw
    rw [hw, mul_inv_cancel_left]
  have Q2 : ∀ a w : Kˣ, sqCl (a * w ^ 2) = sqCl a := by
    intro a w
    unfold sqCl
    rw [QuotientGroup.eq]
    refine ⟨w⁻¹, ?_⟩
    rw [powMonoidHom_apply, mul_inv_rev, inv_mul_cancel_right, inv_pow]
  have Q3 : ∀ g : SqCl K, g * g = 1 := by
    intro g
    obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective g
    rw [← QuotientGroup.mk_mul, QuotientGroup.eq_one_iff]
    exact ⟨u, by rw [powMonoidHom_apply, sq]⟩
  
  have split : ∀ (B B' : Set (SqCl K)) (g : SqCl K), g * g = 1 → B ⊆ B' →
      (∀ c ∈ B, g * c ∈ B') → (∀ c ∈ B', c ∈ B ∨ g * c ∈ B) → (∀ c ∈ B, g * c ∉ B) →
      B'.ncard = 2 * B.ncard := by
    intro B B' g hg hBB' h1 h2 h3
    have hU : B' = B ∪ (fun c => g * c) '' B := by
      ext c
      constructor
      · intro hc
        rcases h2 c hc with h | h
        · exact Or.inl h
        · exact Or.inr ⟨g * c, h, by
            show g * (g * c) = c
            rw [← mul_assoc, hg]
            exact one_mul c⟩
      · rintro (h | ⟨b, hb, rfl⟩)
        · exact hBB' h
        · exact h1 b hb
    have hD : Disjoint B ((fun c => g * c) '' B) := by
      rw [Set.disjoint_left]
      rintro c hc ⟨b, hb, rfl⟩
      exact h3 b hb hc
    have hinj : Function.Injective (fun c : SqCl K => g * c) := by
      intro a b hab
      have hab' : g * a = g * b := hab
      have e : g * (g * a) = g * (g * b) := by rw [hab']
      rw [← mul_assoc, ← mul_assoc, hg] at e
      exact (one_mul a).symm.trans (e.trans (one_mul b))
    by_cases hfin : B.Finite
    · rw [hU, Set.ncard_union_eq hD hfin (hfin.image _),
        Set.ncard_image_of_injective _ hinj, two_mul]
    · have hinf : B'.Infinite := fun h => hfin (h.subset hBB')
      rw [hinf.ncard, Set.Infinite.ncard hfin, mul_zero]
  
  obtain ⟨KT, hKT⟩ : ∃ KT : Finset (IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers K)) → Set (SqCl K), ∀ S, KT S =
        {c : SqCl K | ∃ x : Kˣ, c = sqCl x ∧ ∀ v, v ∉ S → EvenVal v x} := ⟨_, fun _ => rfl⟩
  obtain ⟨AT, hAT⟩ : ∃ AT : Finset (IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers K)) → Set (SqCl K), ∀ S, AT S =
        {c : SqCl K | ∃ x : Kˣ, c = sqCl x ∧ ∀ v, v ∉ S → v.valuationOfNeZero x = 1} :=
    ⟨_, fun _ => rfl⟩
  
  have s10 : ∀ A : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      Disjoint A T → (KT (T ∪ A)).ncard = 2 ^ A.card * (KT T).ncard := by
    intro A
    refine Finset.induction_on A ?_ ?_
    · intro _
      simp
    · intro p A' hp ih hdis
      have hpT : p ∉ T := Finset.disjoint_left.mp hdis (Finset.mem_insert_self p A')
      have hdis' : Disjoint A' T :=
        Finset.disjoint_of_subset_left (Finset.subset_insert p A') hdis
      obtain ⟨y, hyp, hyv⟩ := hgen p hpT
      unfold EvenVal at hyp
      have hpS : p ∉ T ∪ A' := by
        rw [Finset.mem_union, not_or]
        exact ⟨hpT, hp⟩
      have key : (KT (insert p (T ∪ A'))).ncard = 2 * (KT (T ∪ A')).ncard := by
        refine split (KT (T ∪ A')) (KT (insert p (T ∪ A'))) (sqCl y) (Q3 _) ?_ ?_ ?_ ?_
        · intro c hc
          rw [hKT] at hc
          rw [hKT]
          obtain ⟨x, rfl, hx⟩ := hc
          exact ⟨x, rfl, fun v hv => hx v (fun h => hv (Finset.mem_insert_of_mem h))⟩
        · intro c hc
          rw [hKT] at hc
          rw [hKT]
          obtain ⟨x, rfl, hx⟩ := hc
          refine ⟨y * x, rfl, fun v hv => ?_⟩
          rw [Finset.mem_insert, Finset.mem_union, not_or, not_or] at hv
          obtain ⟨r, hr⟩ := hyv v hv.2.1 hv.1
          obtain ⟨s, hs⟩ := hx v (by rw [Finset.mem_union, not_or]; exact hv.2)
          exact ⟨r + s, by rw [νmul, hr, hs]; ring⟩
        · intro c hc
          rw [hKT] at hc
          rw [hKT]
          obtain ⟨x, rfl, hx⟩ := hc
          by_cases hpx : EvenVal p x
          · left
            refine ⟨x, rfl, fun v hv => ?_⟩
            by_cases hvp : v = p
            · rw [hvp]
              exact hpx
            · exact hx v (by rw [Finset.mem_insert, not_or]; exact ⟨hvp, hv⟩)
          · right
            unfold EvenVal at hpx
            refine ⟨y * x, rfl, fun v hv => ?_⟩
            by_cases hvp : v = p
            · rw [hvp]
              obtain ⟨a, ha⟩ := Int.not_even_iff_odd.mp hyp
              obtain ⟨b, hb⟩ := Int.not_even_iff_odd.mp hpx
              exact ⟨a + b + 1, by rw [νmul, ha, hb]; ring⟩
            · have hvT : v ∉ T := fun h => hv (Finset.mem_union_left _ h)
              obtain ⟨r, hr⟩ := hyv v hvT hvp
              obtain ⟨s, hs⟩ := hx v (by rw [Finset.mem_insert, not_or]; exact ⟨hvp, hv⟩)
              exact ⟨r + s, by rw [νmul, hr, hs]; ring⟩
        · intro c hc hc'
          rw [hKT] at hc hc'
          obtain ⟨x, rfl, hx⟩ := hc
          obtain ⟨x', hx'e, hx'⟩ := hc'
          have hx'e' : sqCl (y * x) = sqCl x' := hx'e
          obtain ⟨w, hw⟩ := Q1 (y * x) x' hx'e'
          obtain ⟨a, ha⟩ := hx' p hpS
          obtain ⟨b, hb⟩ := hx p hpS
          rw [hw, νmul, νmul, νsq] at ha
          apply hyp
          exact ⟨a - b - Multiplicative.toAdd (p.valuationOfNeZero w), by omega⟩
      rw [Finset.union_insert, key, ih hdis', Finset.card_insert_of_notMem hp]
      ring
  
  have s4 : ∀ S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      (∀ q, q ∉ S → ∃ y : Kˣ, Multiplicative.toAdd (q.valuationOfNeZero y) = -1 ∧
        ∀ v, v ∉ S → v ≠ q → v.valuationOfNeZero y = 1) → KT S = AT S := by
    intro S hS
    have P : ∀ F : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
        ∀ x : Kˣ, (∀ v, v ∉ S → EvenVal v x) →
          (∀ v, v ∉ S → v.valuationOfNeZero x ≠ 1 → v ∈ F) → sqCl x ∈ AT S := by
      intro F
      refine Finset.induction_on F ?_ ?_
      · intro x _ hF
        rw [hAT]
        exact ⟨x, rfl, fun v hv => by
          by_contra h
          exact Finset.notMem_empty v (hF v hv h)⟩
      · intro q F' hq ih x hx hF
        by_cases hqS : q ∈ S
        · refine ih x hx (fun v hv hne => ?_)
          rcases Finset.mem_insert.mp (hF v hv hne) with h | h
          · exact absurd (h ▸ hqS) hv
          · exact h
        · obtain ⟨m, hm⟩ := hx q hqS
          obtain ⟨y, hy1, hy2⟩ := hS q hqS
          have hν : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
              Multiplicative.toAdd (v.valuationOfNeZero (x * (y ^ m) ^ 2)) =
                Multiplicative.toAdd (v.valuationOfNeZero x) +
                  2 * (m * Multiplicative.toAdd (v.valuationOfNeZero y)) := by
            intro v
            rw [νmul, νsq, νzpow]
          have hmain := ih (x * (y ^ m) ^ 2) ?_ ?_
          · rwa [Q2] at hmain
          · intro v hv
            by_cases hvq : v = q
            · rw [hvq]
              refine ⟨0, ?_⟩
              rw [hν, hy1, hm]
              ring
            · obtain ⟨r, hr⟩ := hx v hv
              have h0 := (νone v y).mp (hy2 v hv hvq)
              refine ⟨r, ?_⟩
              rw [hν, h0, hr]
              ring
          · intro v hv hne
            have hvq : v ≠ q := by
              rintro rfl
              apply hne
              rw [νone, hν, hy1, hm]
              ring
            have hne' : v.valuationOfNeZero x ≠ 1 := by
              intro h1
              apply hne
              rw [νone, hν, (νone v y).mp (hy2 v hv hvq), (νone v x).mp h1]
              ring
            rcases Finset.mem_insert.mp (hF v hv hne') with h | h
            · exact absurd h hvq
            · exact h
    apply Set.Subset.antisymm
    · intro c hc
      rw [hKT] at hc
      obtain ⟨x, rfl, hx⟩ := hc
      have hfin0 : {v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
          IsDedekindDomain.HeightOneSpectrum.valuation K v (x : K) ≠ 1}.Finite := by
        refine ((IsDedekindDomain.HeightOneSpectrum.Support.finite
          (NumberField.RingOfIntegers K) (x : K)).union
          (IsDedekindDomain.HeightOneSpectrum.Support.finite
            (NumberField.RingOfIntegers K) (x : K)⁻¹)).subset ?_
        intro v hv
        simp only [Set.mem_setOf_eq] at hv
        rcases lt_or_gt_of_ne hv with h | h
        · right
          show 1 < IsDedekindDomain.HeightOneSpectrum.valuation K v (x : K)⁻¹
          exact (Valuation.one_lt_val_iff _ (inv_ne_zero x.ne_zero)).mpr (by rwa [inv_inv])
        · left
          exact h
      have hfin : {v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
          v.valuationOfNeZero x ≠ 1}.Finite := by
        refine hfin0.subset (fun v hv h1 => hv ?_)
        have h := IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq v x
        rw [h1] at h
        exact_mod_cast h
      exact P hfin.toFinset x hx (fun v _ hne => hfin.mem_toFinset.mpr hne)
    · intro c hc
      rw [hAT] at hc
      rw [hKT]
      obtain ⟨x, rfl, hx⟩ := hc
      exact ⟨x, rfl, fun v hv => ⟨0, by simp [(νone v x).mp (hx v hv)]⟩⟩
  
  have s9 : ∀ S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      (AT S).ncard = 2 ^ (S.card + Fintype.card (NumberField.InfinitePlace K)) := by
    intro S
    refine Finset.induction_on S ?_ ?_
    · have e : AT ∅ = {c : SqCl K | ∃ x : Kˣ, c = sqCl x ∧
          ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
            v.valuationOfNeZero x = 1} := by
        rw [hAT]
        ext c
        simp only [Set.mem_setOf_eq, Finset.notMem_empty, not_false_eq_true, forall_const]
      rw [e, ncard_unitClasses_empty, card_units_mod_squares, Finset.card_empty, zero_add]
    · intro p S' hp ih
      obtain ⟨g, h1, h2, h3⟩ :=
        unitClasses_insert_split S' p hp (exists_unit_supported_at_prime p)
      have e : AT (insert p S') = {c : SqCl K | ∃ x : Kˣ, c = sqCl x ∧
          ∀ v, v ∉ S' → v ≠ p → v.valuationOfNeZero x = 1} := by
        rw [hAT]
        ext c
        simp only [Set.mem_setOf_eq, Finset.mem_insert, not_or]
        constructor
        · rintro ⟨x, hc, hx⟩
          exact ⟨x, hc, fun v hv1 hv2 => hx v ⟨hv2, hv1⟩⟩
        · rintro ⟨x, hc, hx⟩
          exact ⟨x, hc, fun v hv => hx v hv.2 hv.1⟩
      have hmono : {c : SqCl K | ∃ x : Kˣ, c = sqCl x ∧
          ∀ v, v ∉ S' → v.valuationOfNeZero x = 1} ⊆
          {c : SqCl K | ∃ x : Kˣ, c = sqCl x ∧
            ∀ v, v ∉ S' → v ≠ p → v.valuationOfNeZero x = 1} := by
        rintro c ⟨x, hc, hx⟩
        exact ⟨x, hc, fun v hv _ => hx v hv⟩
      have hd := split _ _ g (Q3 g) hmono h1 h2 h3
      rw [e, hd, ← hAT S', ih, Finset.card_insert_of_notMem hp]
      ring
  
  obtain ⟨T', hTT', hT'⟩ := exists_finset_unitGen T
  have e1 := s10 (T' \ T) Finset.sdiff_disjoint
  rw [Finset.union_sdiff_of_subset hTT', s4 T' hT', s9 T'] at e1
  have hc : T'.card = (T' \ T).card + T.card := (Finset.card_sdiff_add_card_eq_card hTT').symm
  rw [hc, add_assoc, pow_add] at e1
  have h2 := Nat.eq_of_mul_eq_mul_left (pow_pos two_pos _) e1
  rw [← hKT T]
  exact h2.symm

theorem adicCompletion_valued_le_one_of_isIntegral {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (z : v.adicCompletion K) (hz : IsIntegral ℤ z) : Valued.v z ≤ 1 :=
by
  have h1 : IsIntegral
      (↥(Valued.v : Valuation (v.adicCompletion K) (WithZero (Multiplicative ℤ))).integer) z :=
    hz.tower_top
  have h2 : z ∈ (Valued.v : Valuation (v.adicCompletion K) (WithZero (Multiplicative ℤ))).integer :=
    (Valuation.integer.integers _).mem_of_integral h1
  exact (Valuation.mem_integer_iff _ _).mp h2

theorem adicCompletion_exists_ringOfIntegers_approx {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (z : v.adicCompletion K) (hz : Valued.v z ≤ 1) :
    ∃ a : NumberField.RingOfIntegers K,
      Valued.v (z - algebraMap K (v.adicCompletion K)
        (algebraMap (NumberField.RingOfIntegers K) K a)) < 1 :=
by
  
  have approx : ∀ k : K, IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 →
      ∃ a : NumberField.RingOfIntegers K,
        IsDedekindDomain.HeightOneSpectrum.valuation K v
          (k - algebraMap (NumberField.RingOfIntegers K) K a) < 1 := by
    intro k hk
    obtain ⟨n, d, hd, hnd⟩ := IsFractionRing.div_surjective (A := NumberField.RingOfIntegers K) k
    have hd0 : d ≠ 0 := nonZeroDivisors.ne_zero hd
    have hιd : algebraMap (NumberField.RingOfIntegers K) K d ≠ 0 := by
      rw [ne_eq, map_eq_zero_iff _ (IsFractionRing.injective (NumberField.RingOfIntegers K) K)]
      exact hd0
    have hn : algebraMap (NumberField.RingOfIntegers K) K n =
        k * algebraMap (NumberField.RingOfIntegers K) K d := by
      rw [← hnd, div_mul_cancel₀ _ hιd]
    have hv0 : v.intValuation d ≠ 0 := v.intValuation_ne_zero d hd0
    have hv1 : v.intValuation d ≤ 1 := v.intValuation_le_one d
    have hlog : WithZero.log (v.intValuation d) ≤ 0 := by
      have h1 : WithZero.exp (WithZero.log (v.intValuation d)) ≤ WithZero.exp (0 : ℤ) := by
        rw [WithZero.exp_log hv0, WithZero.exp_zero]; exact hv1
      exact WithZero.exp_le_exp.mp h1
    obtain ⟨m, hm⟩ : ∃ m : ℕ, v.intValuation d = WithZero.exp (-(m : ℤ)) := by
      refine ⟨(-WithZero.log (v.intValuation d)).toNat, ?_⟩
      rw [Int.toNat_of_nonneg (by omega), neg_neg, WithZero.exp_log hv0]
    obtain ⟨J, hJ⟩ : v.asIdeal ^ m ∣ Ideal.span {d} :=
      (v.intValuation_le_pow_iff_dvd d m).mp hm.le
    have hJP : ¬ J ≤ v.asIdeal := by
      intro hle
      have h3 : v.asIdeal ^ (m + 1) ∣ Ideal.span {d} := by
        rw [hJ, pow_succ]
        exact mul_dvd_mul_left _ (Ideal.dvd_iff_le.mpr hle)
      have h2 := (v.intValuation_le_pow_iff_dvd d (m + 1)).mpr h3
      rw [hm, WithZero.exp_le_exp] at h2
      push_cast at h2
      omega
    obtain ⟨t, htJ, htP⟩ := Set.not_subset.mp hJP
    have hnv : v.intValuation n ≤ WithZero.exp (-(m : ℤ)) := by
      have e1 : v.intValuation n = IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K n) :=
        (v.valuation_of_algebraMap (K := K) n).symm
      have e2 : v.intValuation d = IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K d) :=
        (v.valuation_of_algebraMap (K := K) d).symm
      rw [e1, hn, map_mul, ← e2, hm]
      calc _ ≤ 1 * WithZero.exp (-(m : ℤ)) := mul_le_mul_right' hk _
        _ = _ := one_mul _
    have hnP : n ∈ v.asIdeal ^ m :=
      Ideal.dvd_span_singleton.mp ((v.intValuation_le_pow_iff_dvd n m).mp hnv)
    have hnt : n * t ∈ Ideal.span {d} := by
      rw [hJ]; exact Ideal.mul_mem_mul hnP htJ
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hnt
    have hbk : algebraMap (NumberField.RingOfIntegers K) K b =
        algebraMap (NumberField.RingOfIntegers K) K t * k := by
      have h4 := congrArg (algebraMap (NumberField.RingOfIntegers K) K) hb
      rw [map_mul, map_mul, hn] at h4
      apply mul_right_cancel₀ hιd
      rw [h4]; ring
    obtain ⟨s, i, hi, hsi⟩ := v.isMaximal.exists_inv htP
    refine ⟨s * b, ?_⟩
    have h1 : algebraMap (NumberField.RingOfIntegers K) K s *
        algebraMap (NumberField.RingOfIntegers K) K t +
        algebraMap (NumberField.RingOfIntegers K) K i = 1 := by
      rw [← map_mul, ← map_add, hsi, map_one]
    have key : algebraMap (NumberField.RingOfIntegers K) K t *
        (k - algebraMap (NumberField.RingOfIntegers K) K (s * b)) =
        algebraMap (NumberField.RingOfIntegers K) K b *
          algebraMap (NumberField.RingOfIntegers K) K i := by
      rw [map_mul]
      linear_combination (-1 : K) * hbk - algebraMap (NumberField.RingOfIntegers K) K b * h1
    have hvt : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K t) = 1 := by
      rw [v.valuation_of_algebraMap]; exact (v.intValuation_eq_one_iff).mpr htP
    have hvb : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K b) ≤ 1 := v.valuation_le_one (K := K) b
    have hvi : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K i) < 1 :=
      (v.valuation_lt_one_iff_mem (K := K) i).mpr hi
    have h5 := congrArg (IsDedekindDomain.HeightOneSpectrum.valuation K v) key
    rw [map_mul (IsDedekindDomain.HeightOneSpectrum.valuation K v), hvt, one_mul,
      map_mul (IsDedekindDomain.HeightOneSpectrum.valuation K v)] at h5
    rw [h5]
    calc _ ≤ 1 * IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K i) := mul_le_mul_right' hvb _
      _ = _ := one_mul _
      _ < 1 := hvi
  have hval : ∀ x : K, Valued.v (algebraMap K (v.adicCompletion K) x) =
      IsDedekindDomain.HeightOneSpectrum.valuation K v x := fun x =>
    IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v x
  have hdense : DenseRange (algebraMap K (v.adicCompletion K)) := by
    have h := @UniformSpace.Completion.denseRange_coe
      (WithVal (IsDedekindDomain.HeightOneSpectrum.valuation K v)) _
    exact h
  have hU : {y : v.adicCompletion K | Valued.v (y - z) < 1} ∈ nhds z :=
    Valued.mem_nhds.mpr ⟨1, fun y hy => by simpa using hy⟩
  obtain ⟨k, hk⟩ := hdense.mem_nhds hU
  simp only [Set.mem_setOf_eq] at hk
  have hk1 : IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 := by
    rw [← hval]
    have e : algebraMap K (v.adicCompletion K) k =
        (algebraMap K (v.adicCompletion K) k - z) + z := by ring
    rw [e]
    exact le_trans (Valuation.map_add _ _ _) (max_le hk.le hz)
  obtain ⟨a, ha⟩ := approx k hk1
  refine ⟨a, ?_⟩
  have e : z - algebraMap K (v.adicCompletion K)
        (algebraMap (NumberField.RingOfIntegers K) K a) =
      algebraMap K (v.adicCompletion K)
          (k - algebraMap (NumberField.RingOfIntegers K) K a) +
        -(algebraMap K (v.adicCompletion K) k - z) := by
    rw [map_sub]; ring
  rw [e]
  refine Valuation.map_add_lt _ ?_ ?_
  · rw [hval]; exact ha
  · rw [Valuation.map_neg]; exact hk

theorem exists_heightOneSpectrum_of_algHom_adicCompletion {K L : Type u} [Field K] [NumberField K]
    [Field L] [NumberField L] [Algebra K L]
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (happrox : ∀ z : q.adicCompletion K, Valued.v z ≤ 1 → ∃ a : NumberField.RingOfIntegers K,
      Valued.v (z - algebraMap K (q.adicCompletion K)
        (algebraMap (NumberField.RingOfIntegers K) K a)) < 1)
    (hint : ∀ z : q.adicCompletion K, IsIntegral ℤ z → Valued.v z ≤ 1)
    (σ : L →ₐ[K] q.adicCompletion K) :
    ∃ P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L),
      Ideal.absNorm P.asIdeal = Ideal.absNorm q.asIdeal ∧
      ∀ z : NumberField.RingOfIntegers L,
        z ∈ P.asIdeal ↔ Valued.v (σ (algebraMap (NumberField.RingOfIntegers L) L z)) < 1 :=
by
  classical
  let f : NumberField.RingOfIntegers L →+* q.adicCompletion K :=
    (σ.toRingHom).comp (algebraMap (NumberField.RingOfIntegers L) L)
  have hfz : ∀ z, f z = σ (algebraMap (NumberField.RingOfIntegers L) L z) := fun z => rfl
  
  have F1 : ∀ z : NumberField.RingOfIntegers L, Valued.v (f z) ≤ 1 := by
    intro z
    apply hint
    have h1 : IsIntegral ℤ (algebraMap (NumberField.RingOfIntegers L) L z) :=
      NumberField.RingOfIntegers.isIntegral_coe z
    obtain ⟨p, hp, hev⟩ := h1
    refine ⟨p, hp, ?_⟩
    have hcomp : algebraMap ℤ (q.adicCompletion K) =
        (σ.toRingHom).comp (algebraMap ℤ L) := RingHom.ext_int _ _
    rw [hcomp]
    exact (Polynomial.hom_eval₂ p (algebraMap ℤ L) σ.toRingHom _).symm.trans
      (by rw [hev, map_zero])
  
  let I : Ideal (NumberField.RingOfIntegers L) :=
    { carrier := {z | Valued.v (f z) < 1}
      add_mem' := by
        intro x y hx hy
        simp only [Set.mem_setOf_eq, map_add] at hx hy ⊢
        exact lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt hx hy)
      zero_mem' := by
        simp only [Set.mem_setOf_eq, map_zero]
        exact zero_lt_one
      smul_mem' := by
        intro c x hx
        simp only [Set.mem_setOf_eq, smul_eq_mul, map_mul] at hx ⊢
        calc Valued.v (f c) * Valued.v (f x) ≤ 1 * Valued.v (f x) :=
              mul_le_mul_right' (F1 c) _
          _ = Valued.v (f x) := one_mul _
          _ < 1 := hx }
  have hmemI : ∀ z, z ∈ I ↔ Valued.v (f z) < 1 := fun z => Iff.rfl
  have hprime : I.IsPrime := by
    refine ⟨?_, ?_⟩
    · rw [Ne, Ideal.eq_top_iff_one, hmemI, map_one, map_one]
      exact lt_irrefl 1
    · intro x y hxy
      rw [hmemI, hmemI]
      rw [hmemI, map_mul, map_mul] at hxy
      by_contra hcon
      push_neg at hcon
      have hx1 := le_antisymm (F1 x) hcon.1
      have hy1 := le_antisymm (F1 y) hcon.2
      rw [hx1, hy1, one_mul] at hxy
      exact lt_irrefl _ hxy
  
  let ι : NumberField.RingOfIntegers K →+* NumberField.RingOfIntegers L :=
    NumberField.RingOfIntegers.mapRingHom (algebraMap K L)
  have hι : ∀ a : NumberField.RingOfIntegers K,
      f (ι a) = algebraMap K (q.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K a) := by
    intro a
    rw [hfz]
    exact σ.commutes _
  have F3 : ∀ a : NumberField.RingOfIntegers K, ι a ∈ I ↔ a ∈ q.asIdeal := by
    intro a
    have hw : Valued.v (algebraMap K (q.adicCompletion K)
        (algebraMap (NumberField.RingOfIntegers K) K a)) =
        IsDedekindDomain.HeightOneSpectrum.valuation K q
          (algebraMap (NumberField.RingOfIntegers K) K a) :=
      IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' q _
    rw [hmemI, hι, hw, IsDedekindDomain.HeightOneSpectrum.valuation_lt_one_iff_mem]
  have hne : I ≠ ⊥ := by
    obtain ⟨a, ha, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot q.ne_bot
    intro hbot
    have h1 : ι a ∈ I := (F3 a).mpr ha
    rw [hbot, Ideal.mem_bot] at h1
    apply ha0
    have h2 : algebraMap (NumberField.RingOfIntegers L) L (ι a) = 0 := by rw [h1, map_zero]
    have h3 : algebraMap K L (algebraMap (NumberField.RingOfIntegers K) K a) = 0 := h2
    rw [map_eq_zero] at h3
    exact NumberField.RingOfIntegers.coe_injective (by rw [h3]; rfl)
  let P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L) := ⟨I, hprime, hne⟩
  refine ⟨P, ?_, fun z => hmemI z⟩
  
  let φ : NumberField.RingOfIntegers K →+* NumberField.RingOfIntegers L ⧸ I :=
    (Ideal.Quotient.mk I).comp ι
  have hsurj : Function.Surjective φ := by
    intro y
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨a, ha⟩ := happrox (f z) (F1 z)
    refine ⟨a, ?_⟩
    show Ideal.Quotient.mk I (ι a) = Ideal.Quotient.mk I z
    rw [Ideal.Quotient.eq, ← neg_mem_iff, neg_sub, hmemI, map_sub, hι]
    exact ha
  have hker : RingHom.ker φ = q.asIdeal := by
    ext a
    rw [RingHom.mem_ker]
    show Ideal.Quotient.mk I (ι a) = 0 ↔ _
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact F3 a
  let e : (NumberField.RingOfIntegers K ⧸ q.asIdeal) ≃+* (NumberField.RingOfIntegers L ⧸ I) :=
    (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj)
  show Ideal.absNorm I = Ideal.absNorm q.asIdeal
  rw [Ideal.absNorm_apply, Ideal.absNorm_apply, Submodule.cardQuot_apply, Submodule.cardQuot_apply]
  exact (Nat.card_congr e.toEquiv).symm

theorem exists_two_primes_of_same_norm_of_local_squares {K : Type u} [Field K] [NumberField K]
    (x : K) (hx0 : x ≠ 0) (hns : ¬ IsSquare x)
    (hloc : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      IsSquare (algebraMap K (v.adicCompletion K) x)) :
    ∃ (L : Type u) (_ : Field L) (_ : NumberField L)
      (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
      (P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → Bool →
        IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L)),
      (∀ q, q ∉ S → ∀ b, Ideal.absNorm (P q b).asIdeal = Ideal.absNorm q.asIdeal) ∧
      (∀ q₁ q₂ b₁ b₂, q₁ ∉ S → q₂ ∉ S → P q₁ b₁ = P q₂ b₂ → q₁ = q₂ ∧ b₁ = b₂) :=
by
  classical
  
  obtain ⟨n, d, hd, hnd⟩ := IsFractionRing.div_surjective (A := NumberField.RingOfIntegers K) x
  have hd0 : algebraMap (NumberField.RingOfIntegers K) K d ≠ 0 := by
    intro h
    apply nonZeroDivisors.ne_zero hd
    apply IsFractionRing.injective (NumberField.RingOfIntegers K) K
    rw [h, map_zero]
  obtain ⟨c, hc⟩ : ∃ c : NumberField.RingOfIntegers K, c = n * d := ⟨_, rfl⟩
  obtain ⟨x₀, hx₀⟩ : ∃ y : K, y = algebraMap (NumberField.RingOfIntegers K) K c := ⟨_, rfl⟩
  have hx₀eq : x₀ = x * (algebraMap (NumberField.RingOfIntegers K) K d) ^ 2 := by
    rw [hx₀, hc, map_mul, ← hnd, sq, ← mul_assoc, div_mul_cancel₀ _ hd0]
  have hx₀0 : x₀ ≠ 0 := by
    rw [hx₀eq]; exact mul_ne_zero hx0 (pow_ne_zero 2 hd0)
  have hx₀ns : ¬ IsSquare x₀ := by
    rintro ⟨t, ht⟩
    apply hns
    refine ⟨t / algebraMap (NumberField.RingOfIntegers K) K d, ?_⟩
    have hd2 : (algebraMap (NumberField.RingOfIntegers K) K d) ^ 2 ≠ 0 := pow_ne_zero 2 hd0
    calc x = x * (algebraMap (NumberField.RingOfIntegers K) K d) ^ 2 /
          (algebraMap (NumberField.RingOfIntegers K) K d) ^ 2 := by
            rw [mul_div_cancel_right₀ _ hd2]
      _ = t * t / (algebraMap (NumberField.RingOfIntegers K) K d) ^ 2 := by rw [← hx₀eq, ht]
      _ = t / algebraMap (NumberField.RingOfIntegers K) K d *
          (t / algebraMap (NumberField.RingOfIntegers K) K d) := by ring
  have hx₀loc : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ∃ r : q.adicCompletion K, algebraMap K (q.adicCompletion K) x₀ = r * r := by
    intro q
    obtain ⟨s, hs⟩ := hloc q
    refine ⟨s * algebraMap K _ (algebraMap (NumberField.RingOfIntegers K) K d), ?_⟩
    rw [hx₀eq, map_mul, map_pow, hs]; ring
  
  obtain ⟨f, hf⟩ : ∃ f : Polynomial K, f = Polynomial.X ^ 2 - Polynomial.C x₀ := ⟨_, rfl⟩
  have hirr : Irreducible f := by
    rw [hf]
    apply X_pow_sub_C_irreducible_of_prime Nat.prime_two
    intro b hb
    exact hx₀ns ⟨b, by rw [← hb, sq]⟩
  haveI hfact : Fact (Irreducible f) := ⟨hirr⟩
  have hf0 : f ≠ 0 := hirr.ne_zero
  haveI : Module.Finite K (AdjoinRoot f) := (AdjoinRoot.powerBasis hf0).finite
  haveI : NumberField (AdjoinRoot f) := NumberField.of_module_finite K (AdjoinRoot f)
  have hθ : (AdjoinRoot.root f) ^ 2 = algebraMap K (AdjoinRoot f) x₀ := by
    have h : Polynomial.aeval (AdjoinRoot.root f) (Polynomial.X ^ 2 - Polynomial.C x₀) = 0 := by
      rw [← hf, AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
    rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C] at h
    exact sub_eq_zero.mp h
  have hintK : ∀ a : NumberField.RingOfIntegers K,
      IsIntegral ℤ (algebraMap K (AdjoinRoot f) (algebraMap (NumberField.RingOfIntegers K) K a)) :=
    fun a => (NumberField.RingOfIntegers.isIntegral_coe a).algebraMap
  have hθint : IsIntegral ℤ (AdjoinRoot.root f) := by
    have h1 := hintK c
    rw [← hx₀, ← hθ] at h1
    exact IsIntegral.of_pow two_pos h1
  
  choose r hr using hx₀loc
  have hε : ∀ q (b : Bool), Polynomial.aeval (if b then r q else -r q) f = 0 := by
    intro q b
    rw [hf, map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, hr q]
    cases b <;> simp [sq]
  obtain ⟨σ, hσθ⟩ : ∃ σ : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      Bool → (AdjoinRoot f →ₐ[K] q.adicCompletion K),
      ∀ q b, σ q b (AdjoinRoot.root f) = if b then r q else -r q :=
    ⟨fun q b => AdjoinRoot.liftHom f _ (hε q b), fun q b => AdjoinRoot.liftHom_root f (hε q b)⟩
  
  choose P hN hM using fun q b => exists_heightOneSpectrum_of_algHom_adicCompletion q
    (adicCompletion_exists_ringOfIntegers_approx q)
    (adicCompletion_valued_le_one_of_isIntegral q) (σ q b)
  have hfinbad : ∀ y : K, y ≠ 0 →
      {v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
        IsDedekindDomain.HeightOneSpectrum.valuation K v y ≠ 1}.Finite := by
    intro y hy
    refine ((IsDedekindDomain.HeightOneSpectrum.Support.finite
      (NumberField.RingOfIntegers K) y).union
      (IsDedekindDomain.HeightOneSpectrum.Support.finite
        (NumberField.RingOfIntegers K) y⁻¹)).subset ?_
    intro v hv
    simp only [Set.mem_setOf_eq] at hv
    rcases lt_or_gt_of_ne hv with h | h
    · right
      show 1 < IsDedekindDomain.HeightOneSpectrum.valuation K v y⁻¹
      exact (Valuation.one_lt_val_iff _ (inv_ne_zero hy)).mpr (by rwa [inv_inv])
    · left
      exact h
  have h20 : (2 : K) ≠ 0 := two_ne_zero
  have hw : ∀ (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (y : K),
      Valued.v (algebraMap K (q.adicCompletion K) y) =
        IsDedekindDomain.HeightOneSpectrum.valuation K q y :=
    fun q y => IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' q y
  
  have hmemK : ∀ q b (a : NumberField.RingOfIntegers K),
      (⟨algebraMap K (AdjoinRoot f) (algebraMap (NumberField.RingOfIntegers K) K a), hintK a⟩ :
        NumberField.RingOfIntegers (AdjoinRoot f)) ∈ (P q b).asIdeal ↔ a ∈ q.asIdeal := by
    intro q b a
    rw [hM q b]
    show Valued.v (σ q b (algebraMap K (AdjoinRoot f)
      (algebraMap (NumberField.RingOfIntegers K) K a))) < 1 ↔ _
    rw [AlgHom.commutes, hw, IsDedekindDomain.HeightOneSpectrum.valuation_lt_one_iff_mem]
  refine ⟨AdjoinRoot f, inferInstance, inferInstance,
    ((hfinbad 2 h20).union (hfinbad x₀ hx₀0)).toFinset, P, fun q _ b => hN q b, ?_⟩
  intro q₁ q₂ b₁ b₂ hq₁ hq₂ hPeq
  have hq : q₁ = q₂ := by
    apply IsDedekindDomain.HeightOneSpectrum.ext
    ext a
    rw [← hmemK q₁ b₁ a, ← hmemK q₂ b₂ a, hPeq]
  subst hq
  refine ⟨rfl, ?_⟩
  simp only [Set.Finite.mem_toFinset, Set.mem_union, Set.mem_setOf_eq, not_or, not_not] at hq₁
  
  have hr1 : Valued.v (r q₁) = 1 := by
    have h := congrArg Valued.v (hr q₁)
    rw [hw, hq₁.2, map_mul] at h
    rcases lt_trichotomy (Valued.v (r q₁)) 1 with hlt | heq | hgt
    · exfalso
      have : Valued.v (r q₁) * Valued.v (r q₁) < 1 :=
        calc Valued.v (r q₁) * Valued.v (r q₁) ≤ 1 * Valued.v (r q₁) :=
              mul_le_mul_right' hlt.le _
          _ = Valued.v (r q₁) := one_mul _
          _ < 1 := hlt
      rw [← h] at this
      exact lt_irrefl _ this
    · exact heq
    · exfalso
      have : 1 < Valued.v (r q₁) * Valued.v (r q₁) :=
        calc (1 : WithZero (Multiplicative ℤ)) < Valued.v (r q₁) := hgt
          _ = 1 * Valued.v (r q₁) := (one_mul _).symm
          _ ≤ Valued.v (r q₁) * Valued.v (r q₁) := mul_le_mul_right' hgt.le _
      rw [← h] at this
      exact lt_irrefl _ this
  obtain ⟨a, ha⟩ := adicCompletion_exists_ringOfIntegers_approx q₁ (r q₁) hr1.le
  obtain ⟨z, hz⟩ : ∃ z : NumberField.RingOfIntegers (AdjoinRoot f),
      algebraMap (NumberField.RingOfIntegers (AdjoinRoot f)) (AdjoinRoot f) z =
        AdjoinRoot.root f - algebraMap K (AdjoinRoot f) (algebraMap (NumberField.RingOfIntegers K) K a) :=
    ⟨⟨_, hθint.sub (hintK a)⟩, rfl⟩
  have hσz : ∀ b, σ q₁ b (algebraMap (NumberField.RingOfIntegers (AdjoinRoot f)) (AdjoinRoot f) z) =
      (if b then r q₁ else -r q₁) -
        algebraMap K (q₁.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K a) := by
    intro b
    rw [hz, map_sub, hσθ, AlgHom.commutes]
  have hzT : z ∈ (P q₁ true).asIdeal := by
    rw [hM, hσz]
    simpa using ha
  have hzF : z ∉ (P q₁ false).asIdeal := by
    rw [hM, hσz]
    simp only [Bool.false_eq_true, if_false]
    have h2r : Valued.v (2 * r q₁) = 1 := by
      rw [map_mul, show (2 : q₁.adicCompletion K) = algebraMap K (q₁.adicCompletion K) 2 from
        (map_ofNat _ 2).symm, hw, hq₁.1, hr1, one_mul]
    have e : -r q₁ - algebraMap K (q₁.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K a)
        = -(2 * r q₁ - (r q₁ - algebraMap K (q₁.adicCompletion K)
          (algebraMap (NumberField.RingOfIntegers K) K a))) := by ring
    rw [e, Valuation.map_neg, Valuation.map_sub_eq_of_lt_left _ (by rw [h2r]; exact ha), h2r]
    exact lt_irrefl 1
  
  cases b₁ <;> cases b₂
  · rfl
  · exfalso
    rw [hPeq] at hzF
    exact hzF hzT
  · exfalso
    rw [hPeq] at hzT
    exact hzF hzT
  · rfl

theorem false_of_two_primes_of_same_norm {K L : Type u} [Field K] [NumberField K]
    [Field L] [NumberField L]
    (S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → Bool →
      IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L))
    (hnorm : ∀ q, q ∉ S → ∀ b, Ideal.absNorm (P q b).asIdeal = Ideal.absNorm q.asIdeal)
    (hinj : ∀ q₁ q₂ b₁ b₂, q₁ ∉ S → q₂ ∉ S → P q₁ b₁ = P q₂ b₂ → q₁ = q₂ ∧ b₁ = b₂) :
    False :=
by
  classical
  
  have s1 : ∀ {X Y : Type u} (g : X → Y), Function.Injective g →
      ∀ (a : X → ENNReal) (b : Y → ENNReal), (∀ x, b (g x) = a x) →
      ∑' e : X →₀ ℕ, e.prod (fun x k => a x ^ k) ≤
        ∑' f : Y →₀ ℕ, f.prod (fun y k => b y ^ k) := by
    intro X Y g hg a b hab
    have h : ∀ e : X →₀ ℕ, e.prod (fun x k => a x ^ k) =
        (e.mapDomain g).prod (fun y k => b y ^ k) := by
      intro e
      rw [Finsupp.prod_mapDomain_index (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _)]
      simp [hab]
    simp_rw [h]
    exact ENNReal.tsum_comp_le_tsum_of_injective (Finsupp.mapDomain_injective hg) _
  
  have s2 : ∀ {X Y : Type u} (a : X → ENNReal) (b : Y → ENNReal),
      ∑' e : X ⊕ Y →₀ ℕ, e.prod (fun z k => Sum.elim a b z ^ k) =
        (∑' e : X →₀ ℕ, e.prod (fun x k => a x ^ k)) *
          ∑' f : Y →₀ ℕ, f.prod (fun y k => b y ^ k) := by
    intro X Y a b
    rw [← Finsupp.sumFinsuppEquivProdFinsupp.symm.tsum_eq, ENNReal.tsum_prod',
      ← ENNReal.tsum_mul_right]
    refine tsum_congr (fun e₁ => ?_)
    rw [← ENNReal.tsum_mul_left]
    refine tsum_congr (fun e₂ => ?_)
    rw [Finsupp.sumFinsuppEquivProdFinsupp_symm_apply, Finsupp.prod_sumElim]
    rfl
  
  have s3 : ∀ {X : Type u} [Fintype X] (a : X → ENNReal), (∀ x, a x ≤ 2⁻¹) →
      ∑' e : X →₀ ℕ, e.prod (fun x k => a x ^ k) ≤ 2 ^ Fintype.card X := by
    intro X _ a ha
    have h1 : ∀ e : X →₀ ℕ, e.prod (fun x k => a x ^ k) = ∏ x, a x ^ (e x) := by
      intro e
      exact Finsupp.prod_fintype _ _ (fun _ => pow_zero _)
    simp_rw [h1]
    rw [← (Finsupp.equivFunOnFinite (α := X) (M := ℕ)).symm.tsum_eq]
    simp only [Finsupp.coe_equivFunOnFinite_symm]
    rw [ENNReal.tsum_eq_iSup_sum]
    refine iSup_le (fun s => ?_)
    set n := 1 + ∑ f ∈ s, ∑ x, f x with hn
    have hsub : s ⊆ Fintype.piFinset (fun _ : X => Finset.range n) := by
      intro f hf
      rw [Fintype.mem_piFinset]
      intro x
      rw [Finset.mem_range]
      have h1 : f x ≤ ∑ x, f x :=
        Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ x)
      have h2 : ∑ x, f x ≤ ∑ f ∈ s, ∑ x, f x :=
        Finset.single_le_sum (f := fun f : X → ℕ => ∑ x, f x) (fun _ _ => Nat.zero_le _) hf
      omega
    calc ∑ f ∈ s, ∏ x, a x ^ f x
        ≤ ∑ f ∈ Fintype.piFinset (fun _ : X => Finset.range n), ∏ x, a x ^ f x :=
          Finset.sum_le_sum_of_subset hsub
      _ = ∏ x, ∑ k ∈ Finset.range n, a x ^ k := (Finset.prod_univ_sum _ _).symm
      _ ≤ ∏ _x : X, (2 : ENNReal) := by
          refine Finset.prod_le_prod' (fun x _ => ?_)
          calc ∑ k ∈ Finset.range n, a x ^ k ≤ ∑' k, a x ^ k := ENNReal.sum_le_tsum _
            _ = (1 - a x)⁻¹ := ENNReal.tsum_geometric _
            _ ≤ (2⁻¹)⁻¹ := by
                refine ENNReal.inv_le_inv.mpr ?_
                calc (2 : ENNReal)⁻¹ = 1 - 2⁻¹ := ENNReal.one_sub_inv_two.symm
                  _ ≤ 1 - a x := tsub_le_tsub_left (ha x) 1
            _ = 2 := inv_inv _
      _ = 2 ^ Fintype.card X := by rw [Finset.prod_const, Finset.card_univ]
  
  have s4 : ∀ {F : Type u} [Field F] [NumberField F] (σ : ℝ), 0 ≤ σ →
      ∀ (e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ),
      (if Ideal.absNorm (e.prod fun v k => v.asIdeal ^ k) = 0 then (0 : ENNReal)
        else (((Ideal.absNorm (e.prod fun v k => v.asIdeal ^ k) : ℕ) : ENNReal) ^ σ)⁻¹) =
      e.prod (fun v k => ((((Ideal.absNorm v.asIdeal : ℕ) : ENNReal) ^ σ)⁻¹) ^ k) := by
    intro F _ _ σ hσ e
    have hn0 : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
        Ideal.absNorm v.asIdeal ≠ 0 := by
      intro v h
      exact v.ne_bot (Ideal.absNorm_eq_zero_iff.mp h)
    rw [map_finsuppProd]
    simp only [map_pow]
    have hne : (e.prod fun v k => Ideal.absNorm v.asIdeal ^ k) ≠ 0 := by
      rw [Finsupp.prod_ne_zero_iff]
      intro v _
      exact pow_ne_zero _ (hn0 v)
    rw [if_neg hne, Nat.cast_finsuppProd]
    simp only [Nat.cast_pow]
    unfold Finsupp.prod
    rw [← ENNReal.prod_rpow_of_nonneg hσ, ENNReal.prod_inv_distrib]
    · refine Finset.prod_congr rfl (fun v _ => ?_)
      beta_reduce
      rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul, mul_comm, ENNReal.rpow_mul,
        ENNReal.rpow_natCast, ENNReal.inv_pow]
    · intro i _ j _ _
      right
      exact ENNReal.rpow_ne_top_of_nonneg hσ (ENNReal.pow_ne_top (ENNReal.natCast_ne_top _))
  
  have s5 : ∀ {R : Type u} [CommRing R] [IsDedekindDomain R],
      Function.Injective (fun e : IsDedekindDomain.HeightOneSpectrum R →₀ ℕ =>
        e.prod (fun v k => v.asIdeal ^ k)) := by
    intro R _ _
    have hne : ∀ e : IsDedekindDomain.HeightOneSpectrum R →₀ ℕ,
        e.prod (fun v k => v.asIdeal ^ k) ≠ 0 := by
      intro e
      rw [Finsupp.prod_ne_zero_iff]
      intro v _
      exact pow_ne_zero _ v.ne_bot
    have key : ∀ (e : IsDedekindDomain.HeightOneSpectrum R →₀ ℕ)
        (w : IsDedekindDomain.HeightOneSpectrum R),
        Multiset.count w.asIdeal
          (UniqueFactorizationMonoid.normalizedFactors (e.prod (fun v k => v.asIdeal ^ k))) =
            e w := by
      intro e w
      induction e using Finsupp.induction with
      | zero =>
        rw [Finsupp.prod_zero_index, UniqueFactorizationMonoid.normalizedFactors_one]
        simp
      | single_add a b f _ _ ih =>
        have hp : ((Finsupp.single a b + f).prod fun v k => v.asIdeal ^ k) =
            a.asIdeal ^ b * f.prod (fun v k => v.asIdeal ^ k) := by
          rw [Finsupp.prod_add_index' (fun _ => pow_zero _) (fun _ _ _ => pow_add _ _ _)]
          congr 1
          exact Finsupp.prod_single_index (pow_zero _)
        rw [hp,
          UniqueFactorizationMonoid.normalizedFactors_mul ?_ (hne f), Multiset.count_add, ih,
          UniqueFactorizationMonoid.normalizedFactors_pow,
          UniqueFactorizationMonoid.normalizedFactors_irreducible a.prime.irreducible,
          normalize_eq, Multiset.count_nsmul, Multiset.count_singleton, Finsupp.add_apply,
          Finsupp.single_apply]
        · by_cases h : a = w
          · subst h; simp
          · have h' : w.asIdeal ≠ a.asIdeal := fun h'' =>
              h (IsDedekindDomain.HeightOneSpectrum.ext h''.symm)
            simp [h, h']
        · exact pow_ne_zero _ a.ne_bot
    intro e₁ e₂ h
    ext w
    have h1 := key e₁ w
    have h2 := key e₂ w
    simp only at h
    rw [h] at h1
    rw [← h1, h2]
  
  have s6 : ∀ {R : Type u} [CommRing R] [IsDedekindDomain R] (I : Ideal R), I ≠ ⊥ →
      ∃ e : IsDedekindDomain.HeightOneSpectrum R →₀ ℕ,
        e.prod (fun v k => v.asIdeal ^ k) = I := by
    intro R _ _ I hI
    have hI0 : I ≠ 0 := hI
    have hfin := Ideal.finite_mulSupport hI0
    set c : IsDedekindDomain.HeightOneSpectrum R → ℕ := fun v =>
      Multiset.count v.asIdeal (UniqueFactorizationMonoid.normalizedFactors I) with hcdef
    have hc : ∀ v : IsDedekindDomain.HeightOneSpectrum R,
        v.maxPowDividing I = v.asIdeal ^ c v :=
      fun v => v.maxPowDividing_eq_pow_multiset_count hI0
    have hsupp : Function.support c ⊆ Function.mulSupport (fun v => v.maxPowDividing I) := by
      intro v hv
      rw [Function.mem_mulSupport, hc]
      intro h1
      have h2 : v.asIdeal ^ c v ≤ v.asIdeal := Ideal.pow_le_self hv
      rw [h1, Ideal.one_eq_top, top_le_iff] at h2
      exact v.isPrime.ne_top h2
    refine ⟨Finsupp.ofSupportFinite c (hfin.subset hsupp), ?_⟩
    conv_rhs => rw [← Ideal.finprod_heightOneSpectrum_factorization hI0]
    rw [Finsupp.prod, finprod_eq_prod_of_mulSupport_subset]
    · refine Finset.prod_congr rfl (fun v _ => ?_)
      rw [hc, Finsupp.ofSupportFinite_coe]
    · intro v hv
      rw [Function.mem_mulSupport, hc] at hv
      rw [Finset.mem_coe, Finsupp.mem_support_iff, Finsupp.ofSupportFinite_coe]
      intro h0
      exact hv (by rw [h0, pow_zero])
  
  have s7 : ∀ (F : Type u) [Field F] [NumberField F] (σ : ℝ), 0 ≤ σ →
      ∑' I : Ideal (NumberField.RingOfIntegers F),
        (if Ideal.absNorm I = 0 then (0 : ENNReal)
          else (((Ideal.absNorm I : ℕ) : ENNReal) ^ σ)⁻¹) =
      ∑' e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F) →₀ ℕ,
        e.prod (fun v k => ((((Ideal.absNorm v.asIdeal : ℕ) : ENNReal) ^ σ)⁻¹) ^ k) := by
    intro F _ _ σ hσ
    have h := (s5 (R := NumberField.RingOfIntegers F)).tsum_eq
      (f := fun I : Ideal (NumberField.RingOfIntegers F) =>
        (if Ideal.absNorm I = 0 then (0 : ENNReal)
          else (((Ideal.absNorm I : ℕ) : ENNReal) ^ σ)⁻¹)) (by
        intro I hI
        rw [Function.mem_support] at hI
        have hN : Ideal.absNorm I ≠ 0 := fun h => hI (if_pos h)
        have hI0 : I ≠ ⊥ := fun h => hN (Ideal.absNorm_eq_zero_iff.mpr h)
        obtain ⟨e, he⟩ := s6 I hI0
        exact ⟨e, he⟩)
    rw [← h]
    exact tsum_congr (fun e => s4 σ hσ e)
  
  have s8 : ∀ {F : Type u} [Field F] [NumberField F] (σ : ℝ), 1 < σ →
      LSeriesSummable
        (fun n => (Nat.card {I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = n} : ℂ))
        (σ : ℂ) →
      ∑' I : Ideal (NumberField.RingOfIntegers F),
          (if Ideal.absNorm I = 0 then (0 : ENNReal)
            else (((Ideal.absNorm I : ℕ) : ENNReal) ^ σ)⁻¹) =
        ENNReal.ofReal (NumberField.dedekindZeta F σ).re := by
    intro F _ _ σ hσ hs
    set c : ℕ → ℂ := fun n =>
      (Nat.card {I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = n} : ℂ) with hc
    set w : ℕ → ENNReal := fun n => if n = 0 then (0 : ENNReal) else (((n : ℕ) : ENNReal) ^ σ)⁻¹
      with hw
    have hd : ∑' I : Ideal (NumberField.RingOfIntegers F), w (Ideal.absNorm I) =
        ∑' n : ℕ, (Nat.card {I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = n} :
          ENNReal) * w n := by
      rw [← ENNReal.tsum_fiberwise (fun I => w (Ideal.absNorm I)) Ideal.absNorm]
      refine tsum_congr (fun n => ?_)
      have h1 : ∀ b : ↑(Ideal.absNorm ⁻¹' {n} : Set (Ideal (NumberField.RingOfIntegers F))),
          w (Ideal.absNorm (b : Ideal (NumberField.RingOfIntegers F))) = w n := by
        intro b
        have := b.2
        simp only [Set.mem_preimage, Set.mem_singleton_iff] at this
        rw [this]
      rw [tsum_congr h1, ENNReal.tsum_const]
      congr 1
      haveI : Finite ↑(Ideal.absNorm ⁻¹' {n} : Set (Ideal (NumberField.RingOfIntegers F))) :=
        (Ideal.finite_setOf_absNorm_eq n).to_subtype
      rw [ENat.card_eq_coe_natCard]
      rfl
    change ∑' I : Ideal (NumberField.RingOfIntegers F), w (Ideal.absNorm I) = _
    rw [hd]
    set r : ℕ → ℝ := fun n => if n = 0 then 0 else
      (Nat.card {I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = n} : ℝ) /
        (n : ℝ) ^ σ with hr
    have hterm : ∀ n, LSeries.term c σ n = (r n : ℂ) := by
      intro n
      rw [LSeries.term_def]
      by_cases hn : n = 0
      · simp [hr, hn]
      · simp only [hr, hn, if_false]
        rw [Complex.ofReal_div, Complex.ofReal_cpow (Nat.cast_nonneg n), Complex.ofReal_natCast,
          Complex.ofReal_natCast]
    have hr0 : ∀ n, 0 ≤ r n := by
      intro n
      simp only [hr]
      split_ifs
      · exact le_refl 0
      · positivity
    have hzeta : NumberField.dedekindZeta F σ = ∑' n, (r n : ℂ) := by
      rw [NumberField.dedekindZeta.eq_1, LSeries.eq_1]
      exact tsum_congr hterm
    have hsr : Summable r := by
      have h2 : Summable (fun n => (r n : ℂ)) := by
        have := hs
        rw [LSeriesSummable.eq_1] at this
        exact this.congr hterm
      exact Complex.summable_ofReal.mp h2
    rw [hzeta, ← Complex.ofReal_tsum, Complex.ofReal_re, ENNReal.ofReal_tsum_of_nonneg hr0 hsr]
    refine tsum_congr (fun n => ?_)
    by_cases hn : n = 0
    · simp [hr, hw, hn]
    · simp only [hr, hw, hn, if_false]
      have hpos : 0 < (n : ℝ) ^ σ := by
        have : (0 : ℝ) < n := by exact_mod_cast Nat.pos_of_ne_zero hn
        positivity
      rw [ENNReal.ofReal_div_of_pos hpos, ENNReal.ofReal_natCast,
        ← ENNReal.ofReal_rpow_of_nonneg (Nat.cast_nonneg n) (by linarith), ENNReal.ofReal_natCast,
        div_eq_mul_inv]
  
  have s9 : ∀ C : ℝ, ∃ σ : ℝ, 1 < σ ∧
      LSeriesSummable
        (fun n => (Nat.card {I : Ideal (NumberField.RingOfIntegers K) // Ideal.absNorm I = n} : ℂ))
        (σ : ℂ) ∧
      LSeriesSummable
        (fun n => (Nat.card {I : Ideal (NumberField.RingOfIntegers L) // Ideal.absNorm I = n} : ℂ))
        (σ : ℂ) ∧
      0 < (NumberField.dedekindZeta K σ).re ∧
      C * (NumberField.dedekindZeta L σ).re < ((NumberField.dedekindZeta K σ).re) ^ 2 := by
    intro C
    set cK := NumberField.dedekindZeta_residue K with hcKdef
    set cL := NumberField.dedekindZeta_residue L with hcLdef
    have hcK : 0 < cK := NumberField.dedekindZeta_residue_pos K
    have hcL : 0 < cL := NumberField.dedekindZeta_residue_pos L
    have hK : Filter.Tendsto (fun s : ℝ => (s - 1) * (NumberField.dedekindZeta K s).re)
        (nhdsWithin 1 (Set.Ioi 1)) (nhds cK) := by
      have h := (Complex.continuous_re.tendsto _).comp
        (NumberField.tendsto_sub_one_mul_dedekindZeta_nhdsGT K)
      rw [Complex.ofReal_re] at h
      refine h.congr (fun s => ?_)
      simp [Complex.mul_re]
    have hL : Filter.Tendsto (fun s : ℝ => (s - 1) * (NumberField.dedekindZeta L s).re)
        (nhdsWithin 1 (Set.Ioi 1)) (nhds cL) := by
      have h := (Complex.continuous_re.tendsto _).comp
        (NumberField.tendsto_sub_one_mul_dedekindZeta_nhdsGT L)
      rw [Complex.ofReal_re] at h
      refine h.congr (fun s => ?_)
      simp [Complex.mul_re]
    set A : ℝ := |C| + 1 with hA
    set B : ℝ := cL + 1 with hB
    have hA0 : 0 < A := by positivity
    have hB0 : 0 < B := by linarith
    set δ : ℝ := cK ^ 2 / (4 * A * B) with hδ
    have hδ0 : 0 < δ := by positivity
    have ev1 := hK.eventually_const_lt (half_lt_self hcK)
    have ev2 := hL.eventually_const_lt hcL
    have ev3 := hL.eventually_lt_const (show cL < B by linarith)
    have ev4 : ∀ᶠ s in nhdsWithin (1 : ℝ) (Set.Ioi 1), s ∈ Set.Ioo 1 (1 + δ) :=
      Ioo_mem_nhdsGT (by linarith)
    obtain ⟨s, h1, h2, h3, h4⟩ := (ev1.and (ev2.and (ev3.and ev4))).exists
    obtain ⟨hs1, hs2⟩ := h4
    set x := (NumberField.dedekindZeta K s).re with hx
    set y := (NumberField.dedekindZeta L s).re with hy
    set t := s - 1 with ht
    have ht0 : 0 < t := by linarith
    have htδ : t < δ := by linarith
    have hx0 : 0 < x := by
      by_contra hneg
      push_neg at hneg
      have : t * x ≤ 0 := mul_nonpos_of_nonneg_of_nonpos ht0.le hneg
      linarith
    have hδeq : A * B * δ = cK ^ 2 / 4 := by
      rw [hδ]; field_simp
    have k1 : C * (t * y) ≤ |C| * (t * y) := mul_le_mul_of_nonneg_right (le_abs_self C) h2.le
    have k2 : |C| * (t * y) ≤ |C| * B := mul_le_mul_of_nonneg_left h3.le (abs_nonneg C)
    have k3 : |C| * B < A * B := mul_lt_mul_of_pos_right (by linarith) hB0
    have k4 : C * (t * y) * t < A * B * δ := by
      have : C * (t * y) < A * B := by linarith
      calc C * (t * y) * t < A * B * t := mul_lt_mul_of_pos_right this ht0
        _ < A * B * δ := mul_lt_mul_of_pos_left htδ (by positivity)
    have k5 : cK ^ 2 / 4 < (t * x) ^ 2 := by
      have : cK / 2 < t * x := h1
      nlinarith
    have k6 : C * y * t ^ 2 < x ^ 2 * t ^ 2 := by
      have e1 : C * y * t ^ 2 = C * (t * y) * t := by ring
      have e2 : x ^ 2 * t ^ 2 = (t * x) ^ 2 := by ring
      rw [e1, e2]
      linarith
    have hfin : ∀ (F : Type u) [Field F] [NumberField F] (r : ℝ),
        (NumberField.dedekindZeta F r) ≠ 0 →
        LSeriesSummable
          (fun n => (Nat.card {I : Ideal (NumberField.RingOfIntegers F) // Ideal.absNorm I = n} :
            ℂ)) (r : ℂ) := by
      intro F _ _ r hr
      by_contra hns
      apply hr
      rw [NumberField.dedekindZeta.eq_1, LSeries.eq_1]
      exact tsum_eq_zero_of_not_summable hns
    refine ⟨s, hs1, hfin K s ?_, hfin L s ?_, hx0, ?_⟩
    · intro h0
      have : x = 0 := by rw [hx, h0]; simp
      linarith
    · intro h0
      have : y = 0 := by rw [hy, h0]; simp
      rw [this] at h2
      simp at h2
    · exact lt_of_mul_lt_mul_right k6 (by positivity)
  
  obtain ⟨σ, hσ1, hsK, hsL, hx0, hlt⟩ := s9 ((4 : ℝ) ^ S.card)
  have hσ0 : (0 : ℝ) ≤ σ := by linarith
  have hZK := (s8 σ hσ1 hsK).symm.trans (s7 K σ hσ0)
  have hZL := (s8 σ hσ1 hsL).symm.trans (s7 L σ hσ0)
  set aK : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ENNReal :=
    fun v => (((Ideal.absNorm v.asIdeal : ℕ) : ENNReal) ^ σ)⁻¹ with haK
  set aL : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L) → ENNReal :=
    fun v => (((Ideal.absNorm v.asIdeal : ℕ) : ENNReal) ^ σ)⁻¹ with haL
  
  have hhalf : ∀ v, aK v ≤ 2⁻¹ := by
    intro v
    have hn0 : Ideal.absNorm v.asIdeal ≠ 0 := fun h => v.ne_bot (Ideal.absNorm_eq_zero_iff.mp h)
    have hn1 : Ideal.absNorm v.asIdeal ≠ 1 := fun h =>
      v.isPrime.ne_top (Ideal.absNorm_eq_one_iff.mp h)
    have hn2 : 2 ≤ Ideal.absNorm v.asIdeal := by omega
    have h2 : (2 : ENNReal) ≤ ((Ideal.absNorm v.asIdeal : ℕ) : ENNReal) := by exact_mod_cast hn2
    have h1 : (1 : ENNReal) ≤ ((Ideal.absNorm v.asIdeal : ℕ) : ENNReal) :=
      le_trans (by norm_num) h2
    have h3 : ((Ideal.absNorm v.asIdeal : ℕ) : ENNReal) ≤
        ((Ideal.absNorm v.asIdeal : ℕ) : ENNReal) ^ σ := by
      conv_lhs => rw [← ENNReal.rpow_one ((Ideal.absNorm v.asIdeal : ℕ) : ENNReal)]
      exact ENNReal.rpow_le_rpow_of_exponent_le h1 hσ1.le
    exact ENNReal.inv_le_inv.mpr (le_trans h2 h3)
  
  have hsplit : (∑' e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) →₀ ℕ,
        e.prod (fun v k => aK v ^ k)) ≤
      2 ^ S.card * ∑' e : {v // v ∉ S} →₀ ℕ, e.prod (fun v k => aK v.1 ^ k) := by
    have h1 := s1 (Equiv.sumCompl (fun v => v ∈ S)).symm (Equiv.injective _) aK
      (Sum.elim (fun v : {v // v ∈ S} => aK v.1) (fun v : {v // v ∉ S} => aK v.1)) (by
        intro v
        by_cases h : v ∈ S
        · rw [Equiv.sumCompl_symm_apply_of_pos h]; rfl
        · rw [Equiv.sumCompl_symm_apply_of_neg h]; rfl)
    rw [s2] at h1
    refine le_trans h1 ?_
    gcongr
    have h3 := s3 (fun v : {v // v ∈ S} => aK v.1) (fun v => hhalf v.1)
    simpa using h3
  
  have hpair : (∑' e : {v // v ∉ S} →₀ ℕ, e.prod (fun v k => aK v.1 ^ k)) *
      (∑' e : {v // v ∉ S} →₀ ℕ, e.prod (fun v k => aK v.1 ^ k)) ≤
      ∑' e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L) →₀ ℕ,
        e.prod (fun v k => aL v ^ k) := by
    rw [← s2]
    refine s1 (Sum.elim (fun q : {v // v ∉ S} => P q.1 true) (fun q : {v // v ∉ S} => P q.1 false))
      ?_ _ aL ?_
    · rintro (q | q) (q' | q') h
      · simp only [Sum.elim_inl] at h
        exact congrArg Sum.inl (Subtype.ext (hinj _ _ _ _ q.2 q'.2 h).1)
      · simp only [Sum.elim_inl, Sum.elim_inr] at h
        exact absurd (hinj _ _ _ _ q.2 q'.2 h).2 (by decide)
      · simp only [Sum.elim_inl, Sum.elim_inr] at h
        exact absurd (hinj _ _ _ _ q.2 q'.2 h).2 (by decide)
      · simp only [Sum.elim_inr] at h
        exact congrArg Sum.inr (Subtype.ext (hinj _ _ _ _ q.2 q'.2 h).1)
    · rintro (q | q)
      · simp only [Sum.elim_inl, haL, haK, hnorm q.1 q.2]
      · simp only [Sum.elim_inr, haL, haK, hnorm q.1 q.2]
  
  have hmain : (ENNReal.ofReal (NumberField.dedekindZeta K σ).re) ^ 2 ≤
      (4 : ENNReal) ^ S.card * ENNReal.ofReal (NumberField.dedekindZeta L σ).re := by
    rw [hZK, hZL]
    calc (∑' e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) →₀ ℕ,
          e.prod (fun v k => aK v ^ k)) ^ 2
        ≤ (2 ^ S.card * ∑' e : {v // v ∉ S} →₀ ℕ, e.prod (fun v k => aK v.1 ^ k)) ^ 2 := by
          gcongr
      _ = (4 : ENNReal) ^ S.card * ((∑' e : {v // v ∉ S} →₀ ℕ, e.prod (fun v k => aK v.1 ^ k)) *
          (∑' e : {v // v ∉ S} →₀ ℕ, e.prod (fun v k => aK v.1 ^ k))) := by
          rw [mul_pow, sq, sq, ← mul_pow]; norm_num
      _ ≤ (4 : ENNReal) ^ S.card * ∑' e : IsDedekindDomain.HeightOneSpectrum
          (NumberField.RingOfIntegers L) →₀ ℕ, e.prod (fun v k => aL v ^ k) := by
          gcongr
  
  set x := (NumberField.dedekindZeta K σ).re with hx
  set y := (NumberField.dedekindZeta L σ).re with hy
  have hC : (0 : ℝ) ≤ (4 : ℝ) ^ S.card := by positivity
  rw [← ENNReal.ofReal_pow hx0.le, show (4 : ENNReal) ^ S.card = ENNReal.ofReal ((4 : ℝ) ^ S.card) by
    rw [ENNReal.ofReal_pow (by norm_num)]; norm_num, ← ENNReal.ofReal_mul hC,
    ENNReal.ofReal_le_ofReal_iff'] at hmain
  rcases hmain with h | h
  · linarith
  · have : 0 < x ^ 2 := by positivity
    linarith

theorem isSquare_of_local_squares_KT2 {K : Type u} [Field K] [NumberField K]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (hT2 : ∀ v, v ∉ T → IsDedekindDomain.HeightOneSpectrum.valuation K v 2 = 1)
    (hgen : ∀ q, q ∉ T → ∃ y : Kˣ, ¬ EvenVal q y ∧ ∀ v, v ∉ T → v ≠ q → EvenVal v y)
    (x : Kˣ) (hx : ∀ v, v ∉ T → EvenVal v x)
    (hfin : ∀ v ∈ T, IsSquare (algebraMap K (v.adicCompletion K) (x : K)))
    (hinf : ∀ w : NumberField.InfinitePlace K, IsSquare (algebraMap K w.Completion (x : K))) :
    IsSquare (x : K) :=
by
  classical
  
  have s1 : ∀ {F : Type u} [Field F] (a b : F), a ≠ 0 → IsSquare a → hilbSym F a b = 1 := by
    intro F _ a b ha hsq
    obtain ⟨s, hs⟩ := hsq
    have hs0 : s ≠ 0 := by
      rintro rfl
      exact ha (by simpa using hs)
    unfold hilbSym
    rw [if_pos]
    refine ⟨s⁻¹, 0, ?_⟩
    rw [hs, zero_pow two_ne_zero, mul_zero, add_zero, inv_pow, ← sq,
      mul_inv_cancel₀ (pow_ne_zero 2 hs0)]
  
  have s3 : ∀ (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      IsDedekindDomain.HeightOneSpectrum.valuation K q 2 = 1 →
      ∀ (y : Kˣ), EvenVal q x → ¬ EvenVal q y →
      hilbSym (q.adicCompletion K) (algebraMap K _ (x : K)) (algebraMap K _ (y : K)) = 1 →
      IsSquare (algebraMap K (q.adicCompletion K) (x : K)) := by
    intro q h2 y hxq hyq h
    have hw : ∀ z : Kˣ, Valued.v (algebraMap K (q.adicCompletion K) (z : K)) =
        WithZero.exp (Multiplicative.toAdd (q.valuationOfNeZero z)) := by
      intro z
      rw [show Valued.v (algebraMap K (q.adicCompletion K) (z : K)) = q.valuation K (z : K) from
        IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' q (z : K),
        ← IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq]
      rfl
    obtain ⟨n, hn⟩ : ∃ n : ℤ, n = Multiplicative.toAdd (q.valuationOfNeZero x) := ⟨_, rfl⟩
    obtain ⟨k, hk⟩ : ∃ k : ℤ, k = Multiplicative.toAdd (q.valuationOfNeZero y) := ⟨_, rfl⟩
    have hwa := hw x
    have hwb := hw y
    rw [← hn] at hwa
    rw [← hk] at hwb
    unfold EvenVal at hxq hyq
    rw [← hn] at hxq
    rw [← hk] at hyq
    obtain ⟨r, hr⟩ := hxq
    have hsol : ∃ X Y : q.adicCompletion K, algebraMap K _ (x : K) * X ^ 2 +
        algebraMap K _ (y : K) * Y ^ 2 = 1 := by
      by_contra hne
      unfold hilbSym at h
      rw [if_neg hne] at h
      exact absurd (congrArg Units.val h) (by norm_num)
    obtain ⟨X, Y, hXY⟩ := hsol
    have hBne : ∀ Y : q.adicCompletion K, Y ≠ 0 → ∃ j : ℤ,
        Valued.v (algebraMap K (q.adicCompletion K) (y : K) * Y ^ 2) =
          WithZero.exp (k + (j + j)) := by
      intro Y hY
      obtain ⟨j, hj⟩ : ∃ j : ℤ, Valued.v Y = WithZero.exp j :=
        ⟨_, (WithZero.exp_log ((Valuation.ne_zero_iff _).mpr hY)).symm⟩
      refine ⟨j, ?_⟩
      rw [map_mul, map_pow, hwb, hj, sq, ← WithZero.exp_add, ← WithZero.exp_add]
    have hB1 : ∀ j : ℤ, WithZero.exp (k + (j + j)) ≠ (1 : WithZero (Multiplicative ℤ)) := by
      intro j hj
      rw [show (1 : WithZero (Multiplicative ℤ)) = WithZero.exp 0 from rfl] at hj
      have := WithZero.exp_injective hj
      exact hyq ⟨-j, by omega⟩
    have hB : Valued.v (algebraMap K (q.adicCompletion K) (y : K) * Y ^ 2) < 1 := by
      by_cases hY : Y = 0
      · rw [hY]; simp
      obtain ⟨j, hj⟩ := hBne Y hY
      by_cases hX : X = 0
      · exfalso
        rw [hX, zero_pow two_ne_zero, mul_zero, zero_add] at hXY
        rw [hXY, map_one] at hj
        exact hB1 j hj.symm
      obtain ⟨i, hi⟩ : ∃ i : ℤ, Valued.v X = WithZero.exp i :=
        ⟨_, (WithZero.exp_log ((Valuation.ne_zero_iff _).mpr hX)).symm⟩
      have hA : Valued.v (algebraMap K (q.adicCompletion K) (x : K) * X ^ 2) =
          WithZero.exp (n + (i + i)) := by
        rw [map_mul, map_pow, hwa, hi, sq, ← WithZero.exp_add, ← WithZero.exp_add]
      have hne : Valued.v (algebraMap K (q.adicCompletion K) (x : K) * X ^ 2) ≠
          Valued.v (algebraMap K (q.adicCompletion K) (y : K) * Y ^ 2) := by
        rw [hA, hj]
        intro he
        have := WithZero.exp_injective he
        exact hyq ⟨r + i - j, by omega⟩
      have hmax := Valuation.map_add_of_distinct_val _ hne
      rw [hXY, map_one] at hmax
      have hle : Valued.v (algebraMap K (q.adicCompletion K) (y : K) * Y ^ 2) ≤ 1 := by
        have := le_max_right (Valued.v (algebraMap K (q.adicCompletion K) (x : K) * X ^ 2))
          (Valued.v (algebraMap K (q.adicCompletion K) (y : K) * Y ^ 2))
        rw [← hmax] at this
        exact this
      refine lt_of_le_of_ne hle ?_
      rw [hj]
      exact hB1 j
    have hX : X ≠ 0 := by
      rintro rfl
      rw [zero_pow two_ne_zero, mul_zero, zero_add] at hXY
      rw [hXY, map_one] at hB
      exact lt_irrefl _ hB
    have hsub : Valued.v (algebraMap K (q.adicCompletion K) (x : K) * X ^ 2 - 1) < 1 := by
      have e : algebraMap K (q.adicCompletion K) (x : K) * X ^ 2 - 1 =
          -(algebraMap K (q.adicCompletion K) (y : K) * Y ^ 2) := by
        rw [← hXY]; ring
      rw [e, Valuation.map_neg]
      exact hB
    obtain ⟨t, ht⟩ := adicCompletion_isSquare_of_valued_sub_one_lt_one q h2 _ hsub
    refine ⟨t / X, ?_⟩
    rw [div_mul_div_comm, ← ht, sq, mul_div_assoc, div_self (mul_ne_zero hX hX), mul_one]
  
  have s4 : ∀ q, q ∉ T → IsSquare (algebraMap K (q.adicCompletion K) (x : K)) := by
    intro q hq
    obtain ⟨y, hyq, hyo⟩ := hgen q hq
    have hT2' : ∀ v, v ∉ insert q T →
        IsDedekindDomain.HeightOneSpectrum.valuation K v 2 = 1 :=
      fun v hv => hT2 v (fun h => hv (Finset.mem_insert_of_mem h))
    have hx' : ∀ v, v ∉ insert q T → EvenVal v x :=
      fun v hv => hx v (fun h => hv (Finset.mem_insert_of_mem h))
    have hy' : ∀ v, v ∉ insert q T → EvenVal v y := by
      intro v hv
      refine hyo v (fun h => hv (Finset.mem_insert_of_mem h)) ?_
      rintro rfl
      exact hv (Finset.mem_insert_self _ T)
    have key := global_isotropy_KT2 (insert q T) hT2' x y hx' hy'
    rw [Finset.prod_insert hq] at key
    have hT1 : ∏ v ∈ T, hilbSym (v.adicCompletion K) (algebraMap K _ (x : K))
        (algebraMap K _ (y : K)) = 1 :=
      Finset.prod_eq_one (fun v hv =>
        s1 _ _ (by rw [ne_eq, map_eq_zero]; exact x.ne_zero) (hfin v hv))
    have hI1 : ∏ w : NumberField.InfinitePlace K, hilbSym w.Completion (algebraMap K _ (x : K))
        (algebraMap K _ (y : K)) = 1 :=
      Finset.prod_eq_one (fun w _ =>
        s1 _ _ (by rw [ne_eq, map_eq_zero]; exact x.ne_zero) (hinf w))
    rw [hT1, hI1, mul_one, mul_one] at key
    exact s3 q (hT2 q hq) y (hx q hq) hyq key
  
  have s5 : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      IsSquare (algebraMap K (v.adicCompletion K) (x : K)) := by
    intro v
    by_cases hv : v ∈ T
    · exact hfin v hv
    · exact s4 v hv
  
  by_contra hns
  obtain ⟨L, _, _, S, P, hnorm, hinj⟩ :=
    exists_two_primes_of_same_norm_of_local_squares (x : K) x.ne_zero hns s5
  exact false_of_two_primes_of_same_norm S P hnorm hinj

theorem localFieldStructure_adicCompletion_le_one_iff {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (S : EllipticRootNumber.LocalFieldStructure (v.adicCompletion K)) (x : v.adicCompletion K) :
    @ValuativeRel.valuation (v.adicCompletion K) _ S.rel x ≤ 1 ↔ Valued.v x ≤ 1 :=
by
  classical
  letI := S.rel
  letI := S.top
  haveI := S.isLocalField
  
  haveI hH : HenselianLocalRing ↥(ValuativeRel.valuation (v.adicCompletion K)).integer :=
    henselianLocalRing_integer_of_isNonarchimedeanLocalField (v.adicCompletion K)
  
  have hnat : ∀ n : ℕ,
      ValuativeRel.valuation (v.adicCompletion K) (n : v.adicCompletion K) ≤ 1 := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      push_cast
      exact le_trans (Valuation.map_add _ _ _) (max_le ih (by simp))
  
  have hgood : ∀ N : ℕ, ∃ ℓ : ℕ, N < ℓ ∧
      ValuativeRel.valuation (v.adicCompletion K) (ℓ : v.adicCompletion K) = 1 := by
    intro N
    by_cases h : ValuativeRel.valuation (v.adicCompletion K)
        ((N + 1 : ℕ) : v.adicCompletion K) = 1
    · exact ⟨N + 1, by omega, h⟩
    · have hlt : ValuativeRel.valuation (v.adicCompletion K)
          ((N + 1 : ℕ) : v.adicCompletion K) < 1 := lt_of_le_of_ne (hnat _) h
      refine ⟨N + 2, by omega, ?_⟩
      have e : ((N + 2 : ℕ) : v.adicCompletion K) = ((N + 1 : ℕ) : v.adicCompletion K) + 1 := by
        push_cast; ring
      rw [e, Valuation.map_add_eq_of_lt_right _ (by rw [map_one]; exact hlt), map_one]
  
  
  have gen : ∀ {R : Type u} [CommRing R] [HenselianLocalRing R] (c : R) (ℓ : ℕ), ℓ ≠ 0 →
      c - 1 ∈ IsLocalRing.maximalIdeal R → IsUnit (ℓ : R) → ∃ a : R, a ^ ℓ = c := by
    intro R _ _ c ℓ hℓ hc hu
    obtain ⟨a, ha, -⟩ := HenselianLocalRing.is_henselian (Polynomial.X ^ ℓ - Polynomial.C c)
      (Polynomial.monic_X_pow_sub_C c hℓ) 1
      (by
        rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
          one_pow, ← neg_sub]
        exact (IsLocalRing.maximalIdeal R).neg_mem hc)
      (by
        rw [Polynomial.derivative_sub, Polynomial.derivative_C, sub_zero,
          Polynomial.derivative_X_pow]
        simpa using hu)
    refine ⟨a, ?_⟩
    have ha' : a ^ ℓ - c = 0 := by simpa [Polynomial.IsRoot] using ha
    exact sub_eq_zero.mp ha'
  
  have hroot : ∀ ℓ : ℕ, ValuativeRel.valuation (v.adicCompletion K) (ℓ : v.adicCompletion K) = 1 →
      ∀ z : v.adicCompletion K, ValuativeRel.valuation (v.adicCompletion K) z < 1 →
      ∃ a : v.adicCompletion K, a ^ ℓ = 1 + z := by
    intro ℓ hℓ z hz
    have hℓ0 : ℓ ≠ 0 := by
      rintro rfl
      simp at hℓ
    have hint := Valuation.integer.integers (ValuativeRel.valuation (v.adicCompletion K))
    have hzO : z ∈ (ValuativeRel.valuation (v.adicCompletion K)).integer := le_of_lt hz
    let z' : (ValuativeRel.valuation (v.adicCompletion K)).integer := ⟨z, hzO⟩
    have hmem : (1 + z') - 1 ∈
        IsLocalRing.maximalIdeal (ValuativeRel.valuation (v.adicCompletion K)).integer := by
      rw [add_sub_cancel_left, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
        hint.isUnit_iff_valuation_eq_one]
      intro h
      have h' : ValuativeRel.valuation (v.adicCompletion K) z = 1 := h
      exact absurd h' (ne_of_lt hz)
    have hunit : IsUnit (ℓ : (ValuativeRel.valuation (v.adicCompletion K)).integer) := by
      rw [hint.isUnit_iff_valuation_eq_one, map_natCast]
      exact hℓ
    obtain ⟨a, ha⟩ := gen (1 + z') ℓ hℓ0 hmem hunit
    refine ⟨(a : v.adicCompletion K), ?_⟩
    have := congrArg
      (fun t : (ValuativeRel.valuation (v.adicCompletion K)).integer => (t : v.adicCompletion K)) ha
    simpa [z'] using this
  
  obtain ⟨π, hπ0, hπ⟩ : ∃ π : v.adicCompletion K, π ≠ 0 ∧
      ValuativeRel.valuation (v.adicCompletion K) π < 1 := by
    obtain ⟨γ, hγ0, hγ1⟩ :=
      (inferInstance : ValuativeRel.IsNontrivial (v.adicCompletion K)).condition
    obtain ⟨y₀, hy₀⟩ := ValuativeRel.valuation_surjective γ
    have hy0 : y₀ ≠ 0 := by
      rintro rfl
      rw [map_zero] at hy₀
      exact hγ0 hy₀.symm
    rcases lt_or_gt_of_ne hγ1 with h | h
    · exact ⟨y₀, hy0, hy₀ ▸ h⟩
    · refine ⟨y₀⁻¹, inv_ne_zero hy0, ?_⟩
      rw [map_inv₀, hy₀]
      exact inv_lt_one_of_one_lt₀ h
  
  have hB : ∀ y : v.adicCompletion K,
      ValuativeRel.valuation (v.adicCompletion K) y ≤ 1 → Valued.v y ≤ 1 := by
    intro y hy
    by_contra hcon
    have hγ : 1 < Valued.v y := lt_of_not_ge hcon
    obtain ⟨ℓ, hNℓ, hℓ⟩ := hgood (WithZero.log (Valued.v y)).toNat
    have hvπ0 : Valued.v π ≠ 0 := (Valuation.ne_zero_iff _).mpr hπ0
    obtain ⟨m, hm⟩ := MulArchimedean.arch (Valued.v π)⁻¹ hγ
    have hm' : 1 ≤ Valued.v π * Valued.v y ^ m := by
      calc (1 : WithZero (Multiplicative ℤ)) = Valued.v π * (Valued.v π)⁻¹ :=
            (mul_inv_cancel₀ hvπ0).symm
        _ ≤ _ := mul_le_mul_left' hm _
    have hvz₁ : 1 < Valued.v (π * y ^ (m + 1)) := by
      have e : Valued.v (π * y ^ (m + 1)) = (Valued.v π * Valued.v y ^ m) * Valued.v y := by
        rw [map_mul, map_pow, pow_succ, mul_assoc]
      rw [e]
      calc (1 : WithZero (Multiplicative ℤ)) < Valued.v y := hγ
        _ = 1 * Valued.v y := (one_mul _).symm
        _ ≤ _ := mul_le_mul_right' hm' _
    have hwz₁ : ValuativeRel.valuation (v.adicCompletion K) (π * y ^ (m + 1)) < 1 := by
      rw [map_mul, map_pow]
      exact lt_of_le_of_lt (mul_le_of_le_one_right' (pow_le_one' hy _)) hπ
    have hwz₂ : ValuativeRel.valuation (v.adicCompletion K) (π * y ^ (m + 1) * y) < 1 := by
      rw [map_mul]
      exact lt_of_le_of_lt (mul_le_of_le_one_right' hy) hwz₁
    obtain ⟨a₁, ha₁⟩ := hroot ℓ hℓ _ hwz₁
    obtain ⟨a₂, ha₂⟩ := hroot ℓ hℓ _ hwz₂
    have hvz₂ : 1 < Valued.v (π * y ^ (m + 1) * y) := by
      rw [map_mul]
      calc (1 : WithZero (Multiplicative ℤ)) < Valued.v (π * y ^ (m + 1)) := hvz₁
        _ = Valued.v (π * y ^ (m + 1)) * 1 := (mul_one _).symm
        _ ≤ _ := mul_le_mul_left' hγ.le _
    have e1 : Valued.v (1 + π * y ^ (m + 1)) = Valued.v (π * y ^ (m + 1)) :=
      Valuation.map_add_eq_of_lt_right _ (by rw [map_one]; exact hvz₁)
    have e2 : Valued.v (1 + π * y ^ (m + 1) * y) = Valued.v (π * y ^ (m + 1)) * Valued.v y := by
      rw [Valuation.map_add_eq_of_lt_right _ (by rw [map_one]; exact hvz₂), map_mul]
    have hvz₁0 : Valued.v (π * y ^ (m + 1)) ≠ 0 := ne_of_gt (lt_trans zero_lt_one hvz₁)
    have hδ : (Valued.v (a₂ / a₁)) ^ ℓ = Valued.v y := by
      rw [← map_pow, div_pow, ha₁, ha₂, map_div₀, e1, e2, mul_div_cancel_left₀ _ hvz₁0]
    generalize Valued.v (a₂ / a₁) = δ at hδ
    have hδ1 : 1 < δ := by
      by_contra h
      have h' : δ ^ ℓ ≤ 1 := pow_le_one' (le_of_not_gt h) _
      rw [hδ] at h'
      exact absurd hγ (not_lt.mpr h')
    have hδ0 : δ ≠ 0 := ne_of_gt (lt_trans zero_lt_one hδ1)
    have hj : 0 < WithZero.log δ := by
      have h' : WithZero.exp (0 : ℤ) < WithZero.exp (WithZero.log δ) := by
        rw [WithZero.exp_zero, WithZero.exp_log hδ0]
        exact hδ1
      exact WithZero.exp_lt_exp.mp h'
    have hlog : WithZero.log (Valued.v y) = (ℓ : ℤ) * WithZero.log δ := by
      rw [← hδ]
      conv_lhs => rw [← WithZero.exp_log hδ0]
      rw [← WithZero.exp_nsmul, WithZero.log_exp, nsmul_eq_mul]
    have h3 := Int.self_le_toNat (WithZero.log (Valued.v y))
    have h4 : ((WithZero.log (Valued.v y)).toNat : ℤ) < ℓ := by exact_mod_cast hNℓ
    have h5 : (ℓ : ℤ) ≤ (ℓ : ℤ) * WithZero.log δ :=
      le_mul_of_one_le_right (by positivity) hj
    linarith
  
  obtain ⟨y, hy1⟩ : ∃ y : v.adicCompletion K, 1 < Valued.v y := by
    obtain ⟨ϖ, hϖ⟩ := IsDedekindDomain.HeightOneSpectrum.valuation_exists_uniformizer K v
    have ht : Valued.v (ϖ : v.adicCompletion K) = WithZero.exp (-1) := by
      rw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation']
      exact hϖ
    refine ⟨(ϖ : v.adicCompletion K)⁻¹, ?_⟩
    rw [map_inv₀, ht, WithZero.exp_neg, inv_inv, ← WithZero.exp_zero]
    exact WithZero.exp_lt_exp.mpr one_pos
  constructor
  · exact hB x
  · intro hx
    by_contra hcon
    have h1 : 1 < ValuativeRel.valuation (v.adicCompletion K) x := lt_of_not_ge hcon
    have hx0 : x ≠ 0 := by
      rintro rfl
      rw [map_zero] at h1
      exact absurd h1 (not_lt.mpr zero_le')
    obtain ⟨k, hk⟩ := MulArchimedean.arch (ValuativeRel.valuation (v.adicCompletion K) y) h1
    have hxk : x ^ k ≠ 0 := pow_ne_zero _ hx0
    have hwk0 : ValuativeRel.valuation (v.adicCompletion K) (x ^ k) ≠ 0 :=
      (Valuation.ne_zero_iff _).mpr hxk
    have hwz : ValuativeRel.valuation (v.adicCompletion K) (y * (x ^ k)⁻¹) ≤ 1 := by
      rw [map_mul, map_inv₀, ← div_eq_mul_inv]
      rw [map_pow] at hwk0
      rw [map_pow]
      exact (div_le_one₀ (zero_lt_iff.mpr hwk0)).mpr hk
    have hvz := hB _ hwz
    have hvy : Valued.v y ≤ 1 := by
      rw [← inv_mul_cancel_right₀ hxk y, map_mul, map_pow]
      exact mul_le_one' hvz (pow_le_one' hx _)
    exact absurd hy1 (not_lt.mpr hvy)

theorem card_sqCl_places {K : Type u} [Field K] [NumberField K]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (hT2 : ∀ v, v ∉ T → IsDedekindDomain.HeightOneSpectrum.valuation K v 2 = 1) :
    (∏ v ∈ T, Nat.card (SqCl (v.adicCompletion K))) *
      ∏ w : NumberField.InfinitePlace K, Nat.card (SqCl w.Completion) =
      4 ^ (T.card + Fintype.card (NumberField.InfinitePlace K)) :=
by
  classical
  
  have s5 : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      Nat.card (SqCl (v.adicCompletion K)) =
        4 * Nat.card (↥(v.adicCompletionIntegers K) ⧸
          Ideal.span {(2 : ↥(v.adicCompletionIntegers K))}) := by
    intro v
    obtain ⟨S⟩ := adicCompletion_nonempty_localFieldStructure v
    haveI : CharZero (v.adicCompletion K) :=
      charZero_of_injective_algebraMap (algebraMap K (v.adicCompletion K)).injective
    have hR := localFieldStructure_adicCompletion_le_one_iff v S
    rw [@card_sqCl_localField (v.adicCompletion K) _ S.rel S.top S.isLocalField _]
    have transfer : ∀ (A B : Subring (v.adicCompletion K)), A = B →
        Nat.card (↥A ⧸ Ideal.span {(2 : ↥A)}) = Nat.card (↥B ⧸ Ideal.span {(2 : ↥B)}) := by
      intro A B h; subst h; rfl
    have hAB : (@ValuativeRel.valuation (v.adicCompletion K) _ S.rel).integer =
        (v.adicCompletionIntegers K).toSubring := by
      ext x
      rw [Valuation.mem_integer_iff, hR]
      exact (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).symm
    exact congrArg (fun c => 4 * c) (transfer _ _ hAB)
  
  have s6 : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (k : K),
      IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 → ∀ N : ℕ,
      ∃ a : NumberField.RingOfIntegers K,
        IsDedekindDomain.HeightOneSpectrum.valuation K v
          (k - algebraMap (NumberField.RingOfIntegers K) K a) ≤ WithZero.exp (-(N : ℤ)) := by
    intro v k hk N
    obtain ⟨x, y, hy, rfl⟩ := IsFractionRing.div_surjective (A := NumberField.RingOfIntegers K) k
    have hy0 : y ≠ 0 := nonZeroDivisors.ne_zero hy
    have hyK : algebraMap (NumberField.RingOfIntegers K) K y ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hy
    have hne := v.intValuation_ne_zero y hy0
    have hlog : WithZero.log (v.intValuation y) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hne, WithZero.exp_zero]
      exact v.intValuation_le_one y
    obtain ⟨m, hym⟩ : ∃ m : ℕ, v.intValuation y = WithZero.exp (-(m : ℤ)) := by
      refine ⟨(-WithZero.log (v.intValuation y)).toNat, ?_⟩
      rw [Int.toNat_of_nonneg (by omega), neg_neg, WithZero.exp_log hne]
    obtain ⟨J, hJ⟩ := (v.intValuation_le_pow_iff_dvd y m).mp hym.le
    have hJP : ¬ J ≤ v.asIdeal := by
      intro hle
      have hd : v.asIdeal ^ (m + 1) ∣ Ideal.span {y} := by
        rw [hJ, pow_succ]
        exact mul_dvd_mul_left _ (Ideal.dvd_iff_le.mpr hle)
      have h2 := (v.intValuation_le_pow_iff_dvd y (m + 1)).mpr hd
      rw [hym, WithZero.exp_le_exp] at h2
      push_cast at h2
      omega
    obtain ⟨t, htJ, htP⟩ := Set.not_subset.mp hJP
    have hxm : x ∈ v.asIdeal ^ m := by
      rw [← v.intValuation_le_pow_iff_mem]
      have h1 : IsDedekindDomain.HeightOneSpectrum.valuation K v
            (algebraMap (NumberField.RingOfIntegers K) K x) =
          IsDedekindDomain.HeightOneSpectrum.valuation K v
              (algebraMap (NumberField.RingOfIntegers K) K x /
                algebraMap (NumberField.RingOfIntegers K) K y) *
            IsDedekindDomain.HeightOneSpectrum.valuation K v
              (algebraMap (NumberField.RingOfIntegers K) K y) := by
        rw [← map_mul, div_mul_cancel₀ _ hyK]
      rw [IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap,
        IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap, hym] at h1
      rw [h1]
      calc _ ≤ 1 * WithZero.exp (-(m : ℤ)) := mul_le_mul_right' hk _
        _ = _ := one_mul _
    have hxt : x * t ∈ Ideal.span {y} := by
      rw [hJ]; exact Ideal.mul_mem_mul hxm htJ
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hxt
    have hcop : IsCoprime (Ideal.span {t}) (v.asIdeal ^ N) := by
      apply IsCoprime.pow_right
      obtain ⟨s, i, hi, hsi⟩ := v.isMaximal.exists_inv htP
      rw [Ideal.isCoprime_iff_sup_eq, Ideal.eq_top_iff_one, ← hsi]
      exact Submodule.add_mem_sup (Ideal.mul_mem_left _ s (Ideal.mem_span_singleton_self t)) hi
    have h1 : (1 : NumberField.RingOfIntegers K) ∈ Ideal.span {t} ⊔ v.asIdeal ^ N := by
      rw [Ideal.isCoprime_iff_sup_eq.mp hcop]; exact Submodule.mem_top
    obtain ⟨st, hst, i, hi, hsum⟩ := Submodule.mem_sup.mp h1
    obtain ⟨s, rfl⟩ := Ideal.mem_span_singleton'.mp hst
    refine ⟨s * b, ?_⟩
    have hb' : algebraMap (NumberField.RingOfIntegers K) K b *
        algebraMap (NumberField.RingOfIntegers K) K y =
        algebraMap (NumberField.RingOfIntegers K) K x *
          algebraMap (NumberField.RingOfIntegers K) K t := by
      rw [← map_mul, ← map_mul, hb]
    have hsi' : algebraMap (NumberField.RingOfIntegers K) K s *
        algebraMap (NumberField.RingOfIntegers K) K t +
          algebraMap (NumberField.RingOfIntegers K) K i = 1 := by
      rw [← map_mul, ← map_add, hsum, map_one]
    have hY : algebraMap (NumberField.RingOfIntegers K) K y *
        (algebraMap (NumberField.RingOfIntegers K) K y)⁻¹ = 1 := mul_inv_cancel₀ hyK
    have hkey : algebraMap (NumberField.RingOfIntegers K) K t *
        (algebraMap (NumberField.RingOfIntegers K) K x /
            algebraMap (NumberField.RingOfIntegers K) K y -
          algebraMap (NumberField.RingOfIntegers K) K (s * b)) =
        algebraMap (NumberField.RingOfIntegers K) K b *
          algebraMap (NumberField.RingOfIntegers K) K i := by
      rw [map_mul]
      linear_combination (-(algebraMap (NumberField.RingOfIntegers K) K y)⁻¹) * hb' +
        algebraMap (NumberField.RingOfIntegers K) K b * hY -
        algebraMap (NumberField.RingOfIntegers K) K b * hsi'
    have hv := congrArg (IsDedekindDomain.HeightOneSpectrum.valuation K v) hkey
    rw [Valuation.map_mul, Valuation.map_mul,
      IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap,
      IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap,
      IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap,
      IsDedekindDomain.HeightOneSpectrum.intValuation_eq_one_iff.mpr htP, one_mul] at hv
    rw [hv]
    calc v.intValuation b * v.intValuation i ≤ 1 * WithZero.exp (-(N : ℤ)) :=
          mul_le_mul' (v.intValuation_le_one b) ((v.intValuation_le_pow_iff_mem i N).mpr hi)
      _ = _ := one_mul _
  
  have s7 : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (m : ℕ),
      v.intValuation (2 : NumberField.RingOfIntegers K) = WithZero.exp (-(m : ℤ)) →
      Nat.card (↥(v.adicCompletionIntegers K) ⧸
          Ideal.span {(2 : ↥(v.adicCompletionIntegers K))}) =
        Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal ^ m) := by
    intro v m hm
    have hval : ∀ x : K, Valued.v (algebraMap K (v.adicCompletion K) x) =
        IsDedekindDomain.HeightOneSpectrum.valuation K v x := fun x =>
      IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v x
    have hRK : ∀ r : NumberField.RingOfIntegers K,
        algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r =
          algebraMap K (v.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K r) :=
      fun r => IsScalarTower.algebraMap_apply _ _ _ r
    have hint : ∀ r : NumberField.RingOfIntegers K,
        algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r ∈
          v.adicCompletionIntegers K := by
      intro r
      rw [IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers, hRK, hval]
      exact v.valuation_le_one r
    let φ := (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K)).codRestrict
      (v.adicCompletionIntegers K) hint
    have hφ : ∀ r, ((φ r : v.adicCompletionIntegers K) : v.adicCompletion K) =
        algebraMap K (v.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K r) :=
      fun r => hRK r
    have hexp0 : WithZero.exp (-(m : ℤ)) ≠ 0 := WithZero.exp_ne_zero
    have hexp1 : WithZero.exp (-(m : ℤ)) ≤ 1 := by
      rw [← WithZero.exp_zero, WithZero.exp_le_exp]; omega
    have h2F : Valued.v ((2 : v.adicCompletionIntegers K) : v.adicCompletion K) =
        WithZero.exp (-(m : ℤ)) := by
      have e : ((2 : v.adicCompletionIntegers K) : v.adicCompletion K) =
          algebraMap K (v.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K 2) := by
        rw [map_ofNat, map_ofNat]; rfl
      rw [e, hval, IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap, hm]
    have h2ne : ((2 : v.adicCompletionIntegers K) : v.adicCompletion K) ≠ 0 := by
      intro h0
      rw [h0, map_zero] at h2F
      exact hexp0 h2F.symm
    have hmem : ∀ y : v.adicCompletionIntegers K,
        y ∈ Ideal.span {(2 : v.adicCompletionIntegers K)} ↔
          Valued.v (y : v.adicCompletion K) ≤ WithZero.exp (-(m : ℤ)) := by
      intro y
      rw [Ideal.mem_span_singleton']
      constructor
      · rintro ⟨c, rfl⟩
        show Valued.v ((c : v.adicCompletion K) * ((2 : v.adicCompletionIntegers K) :
          v.adicCompletion K)) ≤ _
        rw [Valuation.map_mul, h2F]
        calc _ ≤ 1 * WithZero.exp (-(m : ℤ)) :=
              mul_le_mul_right' ((IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers
                _ _ _).mp c.2) _
          _ = _ := one_mul _
      · intro hy
        have hz : (y : v.adicCompletion K) / ((2 : v.adicCompletionIntegers K) :
            v.adicCompletion K) ∈ v.adicCompletionIntegers K := by
          rw [IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers, map_div₀, h2F]
          calc Valued.v (y : v.adicCompletion K) / WithZero.exp (-(m : ℤ))
              = Valued.v (y : v.adicCompletion K) * (WithZero.exp (-(m : ℤ)))⁻¹ :=
                div_eq_mul_inv _ _
            _ ≤ WithZero.exp (-(m : ℤ)) * (WithZero.exp (-(m : ℤ)))⁻¹ := mul_le_mul_right' hy _
            _ = 1 := mul_inv_cancel₀ hexp0
        refine ⟨⟨_, hz⟩, Subtype.ext ?_⟩
        show (y : v.adicCompletion K) / ((2 : v.adicCompletionIntegers K) : v.adicCompletion K) *
          ((2 : v.adicCompletionIntegers K) : v.adicCompletion K) = y
        exact div_mul_cancel₀ _ h2ne
    let ψ := (Ideal.Quotient.mk (Ideal.span {(2 : v.adicCompletionIntegers K)})).comp φ
    have hker : RingHom.ker ψ = v.asIdeal ^ m := by
      ext r
      rw [RingHom.mem_ker]
      show Ideal.Quotient.mk _ (φ r) = 0 ↔ _
      rw [Ideal.Quotient.eq_zero_iff_mem, hmem, hφ, hval,
        IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap,
        IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_mem]
    have hdense : DenseRange (algebraMap K (v.adicCompletion K)) := by
      have h := @UniformSpace.Completion.denseRange_coe
        (WithVal (IsDedekindDomain.HeightOneSpectrum.valuation K v)) _
      exact h
    have hsurj : Function.Surjective ψ := by
      intro q
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective q
      have hU : {z : v.adicCompletion K | Valued.v (z - (y : v.adicCompletion K)) <
          WithZero.exp (-(m : ℤ))} ∈ nhds (y : v.adicCompletion K) :=
        Valued.mem_nhds.mpr ⟨Units.mk0 _ hexp0, fun z hz => by simpa using hz⟩
      obtain ⟨k, hk⟩ := hdense.mem_nhds hU
      simp only [Set.mem_setOf_eq] at hk
      have hk1 : IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 := by
        rw [← hval]
        have e : algebraMap K (v.adicCompletion K) k =
            (algebraMap K (v.adicCompletion K) k - y) + y := by ring
        rw [e]
        exact le_trans (Valuation.map_add _ _ _) (max_le (hk.le.trans hexp1) y.2)
      obtain ⟨a, ha⟩ := s6 v k hk1 m
      refine ⟨a, ?_⟩
      show Ideal.Quotient.mk _ (φ a) = Ideal.Quotient.mk _ y
      rw [Ideal.Quotient.eq, hmem]
      show Valued.v ((φ a : v.adicCompletion K) - (y : v.adicCompletion K)) ≤ _
      rw [hφ]
      have e : algebraMap K (v.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K a) -
          (y : v.adicCompletion K) =
          -(algebraMap K (v.adicCompletion K)
              (k - algebraMap (NumberField.RingOfIntegers K) K a)) +
            (algebraMap K (v.adicCompletion K) k - y) := by
        rw [map_sub]; ring
      rw [e]
      refine le_trans (Valuation.map_add _ _ _) (max_le ?_ hk.le)
      rw [Valuation.map_neg, hval]
      exact ha
    rw [← hker]
    exact (Nat.card_congr (RingHom.quotientKerEquivOfSurjective hsurj).toEquiv).symm
  
  have s10 : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ∃ n : ℕ, v.intValuation (2 : NumberField.RingOfIntegers K) = WithZero.exp (-(n : ℤ)) := by
    intro v
    have h2ne : (2 : NumberField.RingOfIntegers K) ≠ 0 := two_ne_zero
    have hne := v.intValuation_ne_zero 2 h2ne
    have hle := v.intValuation_le_one 2
    have hlog : WithZero.log (v.intValuation 2) ≤ 0 := by
      rw [← WithZero.exp_le_exp, WithZero.exp_log hne, WithZero.exp_zero]
      exact hle
    refine ⟨(-WithZero.log (v.intValuation 2)).toNat, ?_⟩
    rw [Int.toNat_of_nonneg (by omega), neg_neg, WithZero.exp_log hne]
  choose n hn using s10
  
  have s8 : ∏ v ∈ T, Nat.card (NumberField.RingOfIntegers K ⧸ v.asIdeal ^ n v) =
      Nat.card (NumberField.RingOfIntegers K ⧸ Ideal.span {(2 : NumberField.RingOfIntegers K)}) := by
    let f : ↥T → Ideal (NumberField.RingOfIntegers K) := fun i => i.1.asIdeal ^ n i.1
    have hcop : Pairwise (Function.onFun IsCoprime f) := by
      intro i j hij
      have hne : i.1.asIdeal ≠ j.1.asIdeal := fun h =>
        hij (Subtype.ext (IsDedekindDomain.HeightOneSpectrum.ext h))
      have hsup := Ideal.IsMaximal.coprime_of_ne i.1.isMaximal j.1.isMaximal hne
      exact (Ideal.isCoprime_iff_sup_eq.mpr hsup).pow
    have hinf : (⨅ i, f i) = Ideal.span {(2 : NumberField.RingOfIntegers K)} := by
      apply le_antisymm
      · intro r hr
        rw [Ideal.mem_iInf] at hr
        have hle : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
            v.intValuation r ≤ v.intValuation 2 := by
          intro v
          by_cases hv : v ∈ T
          · rw [hn v]; exact (v.intValuation_le_pow_iff_mem r (n v)).mpr (hr ⟨v, hv⟩)
          · have h1 : v.intValuation 2 = 1 := by
              have := hT2 v hv
              rwa [show (2 : K) = algebraMap (NumberField.RingOfIntegers K) K 2 from
                  (map_ofNat _ 2).symm,
                IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap] at this
            rw [h1]; exact v.intValuation_le_one r
        have h2K : (algebraMap (NumberField.RingOfIntegers K) K 2) ≠ 0 := by simp
        obtain ⟨a, ha⟩ := IsDedekindDomain.HeightOneSpectrum.mem_integers_of_valuation_le_one K
          (algebraMap (NumberField.RingOfIntegers K) K r /
            algebraMap (NumberField.RingOfIntegers K) K 2) (fun v => by
            rw [map_div₀, IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap,
              IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap]
            have h0 : v.intValuation (2 : NumberField.RingOfIntegers K) ≠ 0 :=
              v.intValuation_ne_zero 2 two_ne_zero
            calc v.intValuation r / v.intValuation 2
                = v.intValuation r * (v.intValuation 2)⁻¹ := div_eq_mul_inv _ _
              _ ≤ v.intValuation 2 * (v.intValuation 2)⁻¹ := mul_le_mul_right' (hle v) _
              _ = 1 := mul_inv_cancel₀ h0)
        rw [Ideal.mem_span_singleton']
        refine ⟨a, ?_⟩
        apply IsFractionRing.injective (NumberField.RingOfIntegers K) K
        rw [map_mul, ha, div_mul_cancel₀ _ h2K]
      · refine le_iInf (fun i => ?_)
        rw [Ideal.span_singleton_le_iff_mem]
        exact (i.1.intValuation_le_pow_iff_mem 2 (n i.1)).mp (hn i.1).le
    rw [← Finset.prod_coe_sort T, ← hinf,
      Nat.card_congr (Ideal.quotientInfRingEquivPiQuotient f hcop).toEquiv, Nat.card_pi]
  
  have s9 : Nat.card (NumberField.RingOfIntegers K ⧸ Ideal.span {(2 : NumberField.RingOfIntegers K)}) =
      2 ^ Module.finrank ℚ K := by
    rw [← Submodule.cardQuot_apply, ← Ideal.absNorm_apply, Ideal.absNorm_span_singleton]
    have h2 : (2 : NumberField.RingOfIntegers K) = algebraMap ℤ (NumberField.RingOfIntegers K) 2 :=
      (map_ofNat _ 2).symm
    rw [h2, Algebra.norm_algebraMap_of_basis (NumberField.RingOfIntegers.basis K),
      ← Module.finrank_eq_card_basis (NumberField.RingOfIntegers.basis K),
      NumberField.RingOfIntegers.rank, Int.natAbs_pow]
    rfl
  
  have s11 : ∏ v ∈ T, Nat.card (↥(v.adicCompletionIntegers K) ⧸
      Ideal.span {(2 : ↥(v.adicCompletionIntegers K))}) = 2 ^ Module.finrank ℚ K := by
    rw [Finset.prod_congr rfl (fun v _ => s7 v (n v) (hn v)), s8, s9]
  
  have s12R : ∀ {F : Type u} [Field F], Nonempty (F ≃+* ℝ) → Nat.card (SqCl F) = 2 := by
    intro F _ h
    obtain ⟨e⟩ := h
    have hsq : ∀ u : Fˣ, (QuotientGroup.mk u : SqCl F) = 1 ↔ 0 < e (u : F) := by
      intro u
      rw [QuotientGroup.eq_one_iff]
      constructor
      · rintro ⟨y, hy⟩
        have h1 : ((y : F)) ^ 2 = (u : F) := by
          rw [← hy]; simp
        rw [← h1, map_pow]
        have hne : e (y : F) ≠ 0 := by simp
        exact lt_of_le_of_ne (sq_nonneg _) (Ne.symm (pow_ne_zero 2 hne))
      · intro hpos
        have hs : e.symm (Real.sqrt (e u)) ≠ 0 := by
          intro h0
          have := congrArg e h0
          simp only [RingEquiv.apply_symm_apply, map_zero] at this
          exact (Real.sqrt_pos.mpr hpos).ne' this
        refine ⟨Units.mk0 _ hs, ?_⟩
        ext
        simp only [powMonoidHom_apply, Units.val_pow_eq_pow_val, Units.val_mk0]
        apply e.injective
        rw [map_pow, RingEquiv.apply_symm_apply, Real.sq_sqrt hpos.le]
    have hc : (QuotientGroup.mk (-1 : Fˣ) : SqCl F) ≠ 1 := by
      rw [Ne, hsq]; simp
    rw [Nat.card_eq_two_iff]
    refine ⟨1, QuotientGroup.mk (-1 : Fˣ), hc.symm, ?_⟩
    ext x
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_univ, iff_true]
    obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective x
    have hu : e (u : F) ≠ 0 := by simp
    rcases lt_or_gt_of_ne hu with hneg | hpos
    · right
      have h1 : (QuotientGroup.mk (-u) : SqCl F) = 1 := (hsq (-u)).mpr (by simp; linarith)
      obtain ⟨y, hy⟩ := (QuotientGroup.eq_one_iff _).mp h1
      rw [QuotientGroup.eq]
      refine ⟨y⁻¹, ?_⟩
      rw [map_inv, hy]
      ext
      simp
    · left; exact (hsq u).mpr hpos
  have s12C : ∀ {F : Type u} [Field F], Nonempty (F ≃+* ℂ) → Nat.card (SqCl F) = 1 := by
    intro F _ h
    obtain ⟨e⟩ := h
    have hall : ∀ x : SqCl F, x = 1 := by
      intro x
      obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective x
      rw [QuotientGroup.eq_one_iff]
      obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (e (u : F)) two_pos
      have hs : e.symm z ≠ 0 := by
        intro h0
        have := congrArg e h0
        simp only [RingEquiv.apply_symm_apply, map_zero] at this
        subst this
        simp at hz
        exact u.ne_zero (by simpa using hz.symm)
      refine ⟨Units.mk0 _ hs, ?_⟩
      ext
      simp only [powMonoidHom_apply, Units.val_pow_eq_pow_val, Units.val_mk0]
      apply e.injective
      rw [map_pow, RingEquiv.apply_symm_apply, hz]
    haveI : Subsingleton (SqCl F) := ⟨fun a b => (hall a).trans (hall b).symm⟩
    exact Nat.card_unique
  
  have s13 : ∏ w : NumberField.InfinitePlace K, Nat.card (SqCl w.Completion) =
      2 ^ NumberField.InfinitePlace.nrRealPlaces K := by
    have hw : ∀ w : NumberField.InfinitePlace K,
        Nat.card (SqCl w.Completion) = if w.IsReal then 2 else 1 := by
      intro w
      split_ifs with h
      · exact s12R ⟨NumberField.InfinitePlace.Completion.ringEquivRealOfIsReal h⟩
      · exact s12C ⟨NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex
          (NumberField.InfinitePlace.not_isReal_iff_isComplex.mp h)⟩
    rw [Finset.prod_congr rfl (fun w _ => hw w), Finset.prod_ite, Finset.prod_const,
      Finset.prod_const_one, mul_one]
    congr 1
    rw [NumberField.InfinitePlace.nrRealPlaces, Fintype.card_subtype]
  
  rw [Finset.prod_congr rfl (fun v _ => s5 v), Finset.prod_mul_distrib, Finset.prod_const, s11,
    s13, NumberField.InfinitePlace.card_eq_nrRealPlaces_add_nrComplexPlaces,
    ← NumberField.InfinitePlace.card_add_two_mul_card_eq_rank,
    show (4 : ℕ) = 2 ^ 2 by norm_num, ← pow_mul, ← pow_mul, ← pow_add, ← pow_add]
  congr 1
  ring

theorem selmer_parity_phi {K : Type u} [Field K] [NumberField K]
    (e₁ e₂ e₃ : K) (h₁₂ : e₁ ≠ e₂) (h₁₃ : e₁ ≠ e₃) (h₂₃ : e₂ ≠ e₃) :
    (Function.mulSupport fun v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) =>
        phiSign (v.adicCompletion K) (algebraMap K _ e₁) (algebraMap K _ e₂)
          (algebraMap K _ e₃)).Finite ∧
    ∃ d : ℕ, (twoSelmerSet K e₁ e₂ e₃).encard = 2 ^ d ∧
      (-1 : ℤˣ) ^ d =
        (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
            phiSign (v.adicCompletion K) (algebraMap K _ e₁) (algebraMap K _ e₂)
              (algebraMap K _ e₃)) *
        ∏ w : NumberField.InfinitePlace K,
            phiSign w.Completion (algebraMap K _ e₁) (algebraMap K _ e₂) (algebraMap K _ e₃) :=
by
  classical
  
  have H1 : ∀ {F : Type u} [Field F] (a b : F), hilbSym F a b = hilbSym F b a := by
    intro F _ a b
    have hiff : (∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1) ↔ (∃ x y : F, b * x ^ 2 + a * y ^ 2 = 1) :=
      ⟨fun ⟨x, y, h⟩ => ⟨y, x, by rw [← h]; ring⟩, fun ⟨x, y, h⟩ => ⟨y, x, by rw [← h]; ring⟩⟩
    unfold hilbSym
    by_cases h : ∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1
    · rw [if_pos h, if_pos (hiff.mp h)]
    · rw [if_neg h, if_neg (fun h' => h (hiff.mpr h'))]
  have H2 : ∀ {F : Type u} [Field F] (a b s : F), s ≠ 0 →
      hilbSym F (a * s ^ 2) b = hilbSym F a b := by
    intro F _ a b s hs
    have hiff : (∃ x y : F, a * s ^ 2 * x ^ 2 + b * y ^ 2 = 1) ↔
        (∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1) := by
      constructor
      · rintro ⟨x, y, h⟩
        exact ⟨s * x, y, by rw [← h]; ring⟩
      · rintro ⟨x, y, h⟩
        refine ⟨x / s, y, ?_⟩
        rw [← h]
        have e : s ^ 2 * (x / s) ^ 2 = x ^ 2 := by
          rw [← mul_pow]
          congr 1
          field_simp
        calc a * s ^ 2 * (x / s) ^ 2 + b * y ^ 2 = a * (s ^ 2 * (x / s) ^ 2) + b * y ^ 2 := by ring
          _ = a * x ^ 2 + b * y ^ 2 := by rw [e]
    unfold hilbSym
    by_cases h : ∃ x y : F, a * s ^ 2 * x ^ 2 + b * y ^ 2 = 1
    · rw [if_pos h, if_pos (hiff.mp h)]
    · rw [if_neg h, if_neg (fun h' => h (hiff.mpr h'))]
  have H3 : ∀ {F : Type u} [Field F] (u : Fˣ), sqCl u = 1 ↔ IsSquare (u : F) := by
    intro F _ u
    unfold sqCl
    rw [QuotientGroup.eq_one_iff]
    constructor
    · rintro ⟨y, hy⟩
      refine ⟨(y : F), ?_⟩
      rw [← hy]
      simp [sq]
    · rintro ⟨r, hr⟩
      have hr0 : r ≠ 0 := by
        rintro rfl
        exact u.ne_zero (by simpa using hr)
      refine ⟨Units.mk0 r hr0, ?_⟩
      ext
      simp [hr, sq]
  have Hsq : ∀ {F : Type u} [Field F] (a : Fˣ), ∃ s : F, s ≠ 0 ∧
      ((Quotient.out (sqCl a) : Fˣ) : F) = (a : F) * s ^ 2 := by
    intro F _ a
    obtain ⟨⟨h, y, rfl⟩, e⟩ := QuotientGroup.mk_out_eq_mul (powMonoidHom 2 : Fˣ →* Fˣ).range a
    refine ⟨(y : F), y.ne_zero, ?_⟩
    unfold sqCl
    rw [e]
    simp
  have H4 : ∀ {F : Type u} [Field F] (a b : Fˣ), spPair F (sqCl a) (sqCl b) = hilbSym F a b := by
    intro F _ a b
    obtain ⟨s, hs, es⟩ := Hsq a
    obtain ⟨r, hr, er⟩ := Hsq b
    unfold spPair
    rw [es, er, H2 _ _ _ hs, H1, H2 _ _ _ hr, H1]
  have H5f : ∀ {F : Type u} [Field F] (t₁ t₂ t₃ d₁ d₂ s r : F), s ≠ 0 → r ≠ 0 →
      IsDescentClass t₁ t₂ t₃ (d₁ * s ^ 2) (d₂ * r ^ 2) → IsDescentClass t₁ t₂ t₃ d₁ d₂ := by
    rintro F _ t₁ t₂ t₃ d₁ d₂ s r hs hr ⟨z₀, z₁, z₂, z₃, hnt, e1, e2⟩
    refine ⟨z₀, z₁ * s, z₂ * r, z₃ * (s * r), ?_, ?_, ?_⟩
    · rintro ⟨h0, h1, h2, h3⟩
      exact hnt ⟨h0, (mul_eq_zero.mp h1).resolve_right hs, (mul_eq_zero.mp h2).resolve_right hr,
        (mul_eq_zero.mp h3).resolve_right (mul_ne_zero hs hr)⟩
    · rw [← e1]; ring
    · rw [← e2]; ring
  have H5 : ∀ {F : Type u} [Field F] (t₁ t₂ t₃ d₁ d₂ s r : F), s ≠ 0 → r ≠ 0 →
      (IsDescentClass t₁ t₂ t₃ (d₁ * s ^ 2) (d₂ * r ^ 2) ↔ IsDescentClass t₁ t₂ t₃ d₁ d₂) := by
    intro F _ t₁ t₂ t₃ d₁ d₂ s r hs hr
    refine ⟨H5f t₁ t₂ t₃ d₁ d₂ s r hs hr, fun h => ?_⟩
    apply H5f t₁ t₂ t₃ (d₁ * s ^ 2) (d₂ * r ^ 2) s⁻¹ r⁻¹ (inv_ne_zero hs) (inv_ne_zero hr)
    have e1 : d₁ * s ^ 2 * s⁻¹ ^ 2 = d₁ := by field_simp
    have e2 : d₂ * r ^ 2 * r⁻¹ ^ 2 = d₂ := by field_simp
    rw [e1, e2]
    exact h
  have H6 : ∀ {F : Type u} [Field F] (t₁ t₂ t₃ : F), IsDescentClass t₁ t₂ t₃ 1 1 := by
    intro F _ t₁ t₂ t₃
    exact ⟨0, 1, 1, 1, by simp, by ring, by ring⟩
  have H7 : ∀ {F : Type u} [Field F] (t₁ t₂ t₃ : F), t₁ ≠ t₂ →
      IsDescentClass t₁ t₂ t₃ (-(t₁ - t₂)) (-(t₁ - t₂) * (t₂ - t₃)) := by
    intro F _ t₁ t₂ t₃ h
    have ha : t₁ - t₂ ≠ 0 := sub_ne_zero.mpr h
    have hinv : (t₁ - t₂) * (t₁ - t₂)⁻¹ = 1 := mul_inv_cancel₀ ha
    refine ⟨1, 1, 0, (t₁ - t₂)⁻¹, by simp, by ring, ?_⟩
    linear_combination (-(t₂ - t₃) * ((t₁ - t₂) * (t₁ - t₂)⁻¹ + 1)) * hinv
  have H8 : ∀ {F : Type u} [Field F] (a d : Fˣ), sqCl a = sqCl d →
      ∃ s : F, s ≠ 0 ∧ (d : F) = (a : F) * s ^ 2 := by
    intro F _ a d h
    unfold sqCl at h
    rw [QuotientGroup.eq] at h
    obtain ⟨y, hy⟩ := h
    refine ⟨(y : F), y.ne_zero, ?_⟩
    have hy' : (y : F) ^ 2 = (a : F)⁻¹ * d := by
      have := congrArg Units.val hy
      simpa using this
    rw [hy', ← mul_assoc, mul_inv_cancel₀ a.ne_zero, one_mul]
  have H9 : ∀ {F : Type u} [Field F] (x : SqCl F), x ^ 2 = 1 := by
    intro F _ x
    obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective x
    rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
    exact ⟨u, rfl⟩
  have Hmem : ∀ {F : Type u} [Field F] (t₁ t₂ t₃ : F) (a b : Fˣ),
      (sqCl a, sqCl b) ∈ spDesc F t₁ t₂ t₃ ↔ IsDescentClass t₁ t₂ t₃ (a : F) (b : F) := by
    intro F _ t₁ t₂ t₃ a b
    constructor
    · rintro ⟨d₁, d₂, heq, hd⟩
      obtain ⟨s, hs, es⟩ := H8 a d₁ (Prod.ext_iff.mp heq).1
      obtain ⟨r, hr, er⟩ := H8 b d₂ (Prod.ext_iff.mp heq).2
      rw [es, er] at hd
      exact (H5 t₁ t₂ t₃ a b s r hs hr).mp hd
    · intro h
      exact ⟨a, b, rfl, h⟩
  have Hphi : ∀ {F : Type u} [Field F] (t₁ t₂ t₃ : F),
      phiImg F t₁ t₂ t₃ = {x : SqCl F | ((1 : SqCl F), x) ∈ spDesc F t₁ t₂ t₃} := by
    intro F _ t₁ t₂ t₃
    ext x
    constructor
    · rintro ⟨u, rfl, hu⟩
      refine ⟨1, u, ?_, ?_⟩
      · rfl
      · rw [Units.val_one]; exact hu
    · rintro ⟨d₁, d₂, heq, hd⟩
      refine ⟨d₂, (Prod.ext_iff.mp heq).2, ?_⟩
      obtain ⟨s, hs, es⟩ := H8 1 d₁ (Prod.ext_iff.mp heq).1
      rw [es, Units.val_one] at hd
      have hd' : IsDescentClass t₁ t₂ t₃ ((1 : F) * s ^ 2) ((d₂ : F) * 1 ^ 2) := by
        rw [one_pow, mul_one]; exact hd
      exact (H5 t₁ t₂ t₃ 1 (d₂ : F) s 1 hs one_ne_zero).mp hd'
  have GPhi : ∀ {F : Type u} [Field F] (t₁ t₂ t₃ : F) (k : ℕ),
      {x : SqCl F | ((1 : SqCl F), x) ∈ spDesc F t₁ t₂ t₃}.encard = 2 ^ k →
      phiSign F t₁ t₂ t₃ = (-1) ^ (k + 1) := by
    intro F _ t₁ t₂ t₃ k hk
    unfold phiSign
    rw [Hphi, hk]
    by_cases hev : Even k
    · rw [if_pos ⟨k, rfl, hev⟩, (Even.add_one hev).neg_one_pow]
    · rw [if_neg, (Nat.not_even_iff_odd.mp hev).add_one.neg_one_pow]
      rintro ⟨k', hk', hev'⟩
      have h2 : (2 : ℕ) ^ k = 2 ^ k' := by exact_mod_cast hk'
      obtain rfl := Nat.pow_right_injective le_rfl h2
      exact hev hev'
  
  have GRho : ∀ {F L : Type u} [Field F] [Field L] (f : F →+* L) (x : Fˣ),
      spSqClMap f (sqCl x) = sqCl (Units.map f.toMonoidHom x) := by
    intro F L _ _ f x
    rfl
  have GPair : ∀ {F : Type u} [Field F] [Algebra K F] (x y : Kˣ),
      spPair F (spSqClMap (algebraMap K F) (sqCl x)) (spSqClMap (algebraMap K F) (sqCl y)) =
        hilbSym F (algebraMap K F (x : K)) (algebraMap K F (y : K)) := by
    intro F _ _ x y
    rw [GRho, GRho]
    exact H4 _ _
  have GInj : ∀ {F : Type u} [Field F] [Algebra K F] (x : Kˣ),
      spSqClMap (algebraMap K F) (sqCl x) = 1 → IsSquare (algebraMap K F (x : K)) := by
    intro F _ _ x h
    rw [GRho, H3] at h
    exact h
  have GLoc : ∀ {F : Type u} [Field F] [Algebra K F] (x y : Kˣ),
      (spSqClMap (algebraMap K F) (sqCl x), spSqClMap (algebraMap K F) (sqCl y)) ∈
          spDesc F (algebraMap K F e₁) (algebraMap K F e₂) (algebraMap K F e₃) ↔
        IsDescentClass (algebraMap K F e₁) (algebraMap K F e₂) (algebraMap K F e₃)
          (algebraMap K F (x : K)) (algebraMap K F (y : K)) := by
    intro F _ _ x y
    rw [GRho, GRho]
    exact Hmem _ _ _ _ _
  have GPmul : ∀ {F : Type u} [Field F],
      (∀ a a' b : F, a ≠ 0 → a' ≠ 0 → b ≠ 0 →
        hilbSym F (a * a') b = hilbSym F a b * hilbSym F a' b) →
      ∀ x x' y : SqCl F, spPair F (x * x') y = spPair F x y * spPair F x' y := by
    intro F _ hmul x x' y
    obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective x
    obtain ⟨a', rfl⟩ := QuotientGroup.mk_surjective x'
    obtain ⟨b, rfl⟩ := QuotientGroup.mk_surjective y
    rw [← QuotientGroup.mk_mul]
    have e : ∀ c d : Fˣ, spPair F (QuotientGroup.mk c) (QuotientGroup.mk d) = hilbSym F c d :=
      fun c d => H4 c d
    rw [e, e, e, Units.val_mul]
    exact hmul _ _ _ a.ne_zero a'.ne_zero b.ne_zero
  have GPsymm : ∀ {F : Type u} [Field F] (x y : SqCl F), spPair F x y = spPair F y x := by
    intro F _ x y
    unfold spPair
    exact H1 _ _
  have GPnd : ∀ {F : Type u} [Field F],
      (∀ b : F, b ≠ 0 → ¬ IsSquare b → ∃ a : F, a ≠ 0 ∧ hilbSym F a b = -1) →
      ∀ x : SqCl F, (∀ y, spPair F x y = 1) → x = 1 := by
    intro F _ hnd x hx
    obtain ⟨b, rfl⟩ := QuotientGroup.mk_surjective x
    by_contra hne
    have hns : ¬ IsSquare (b : F) := fun hsq => hne ((H3 b).mpr hsq)
    obtain ⟨a, ha0, ha⟩ := hnd b b.ne_zero hns
    have h1 := hx (sqCl (Units.mk0 a ha0))
    have e : spPair F (QuotientGroup.mk b) (sqCl (Units.mk0 a ha0)) = hilbSym F a b := by
      rw [show (QuotientGroup.mk b : SqCl F) = sqCl b from rfl, H4, H1, Units.val_mk0]
    rw [e, ha] at h1
    exact absurd (congrArg Units.val h1) (by norm_num)
  have GZone : ∀ {F : Type u} [Field F] (t₁ t₂ t₃ : F),
      (1 : SqCl F × SqCl F) ∈ spDesc F t₁ t₂ t₃ := by
    intro F _ t₁ t₂ t₃
    refine ⟨1, 1, rfl, ?_⟩
    rw [Units.val_one]
    exact H6 t₁ t₂ t₃
  have GZmul : ∀ {F : Type u} [Field F] (t₁ t₂ t₃ : F), (2 : F) ≠ 0 → t₁ ≠ t₂ → t₁ ≠ t₃ →
      t₂ ≠ t₃ → ∀ p ∈ spDesc F t₁ t₂ t₃, ∀ q ∈ spDesc F t₁ t₂ t₃, p * q ∈ spDesc F t₁ t₂ t₃ := by
    rintro F _ t₁ t₂ t₃ h2 h12 h13 h23 p ⟨d₁, d₂, rfl, hd⟩ q ⟨d₁', d₂', rfl, hd'⟩
    refine ⟨d₁ * d₁', d₂ * d₂', rfl, ?_⟩
    rw [Units.val_mul, Units.val_mul]
    exact isDescentClass_mul h2 t₁ t₂ t₃ h12 h13 h23 _ _ _ _ d₁.ne_zero d₂.ne_zero
      d₁'.ne_zero d₂'.ne_zero hd hd'
  have hF2 : ∀ {F : Type u} [Field F] [Algebra K F], (2 : F) ≠ 0 := by
    intro F _ _
    haveI : CharZero F := charZero_of_injective_algebraMap (algebraMap K F).injective
    exact two_ne_zero
  have hdist : ∀ {F : Type u} [Field F] [Algebra K F],
      algebraMap K F e₁ ≠ algebraMap K F e₂ ∧ algebraMap K F e₁ ≠ algebraMap K F e₃ ∧
        algebraMap K F e₂ ≠ algebraMap K F e₃ := by
    intro F _ _
    have inj := (algebraMap K F).injective
    exact ⟨fun h => h₁₂ (inj h), fun h => h₁₃ (inj h), fun h => h₂₃ (inj h)⟩
  
  have hα0 : e₁ - e₂ ≠ 0 := sub_ne_zero.mpr h₁₂
  have hβ0 : e₁ - e₃ ≠ 0 := sub_ne_zero.mpr h₁₃
  have hγ0 : e₂ - e₃ ≠ 0 := sub_ne_zero.mpr h₂₃
  obtain ⟨αu, hαu⟩ : ∃ u : Kˣ, (u : K) = e₁ - e₂ := ⟨Units.mk0 _ hα0, rfl⟩
  obtain ⟨cu, hcu⟩ : ∃ u : Kˣ, (u : K) = -(e₁ - e₂) := ⟨Units.mk0 _ (neg_ne_zero.mpr hα0), rfl⟩
  obtain ⟨hu, hhu⟩ : ∃ u : Kˣ, (u : K) = -(e₁ - e₂) * (e₂ - e₃) :=
    ⟨Units.mk0 _ (mul_ne_zero (neg_ne_zero.mpr hα0) hγ0), rfl⟩
  have GR3 : ∀ {F : Type u} [Field F] [Algebra K F],
      (∀ a a' b : F, a ≠ 0 → a' ≠ 0 → b ≠ 0 →
        hilbSym F (a * a') b = hilbSym F a b * hilbSym F a' b) →
      ∀ d ∈ spDesc F (algebraMap K F e₁) (algebraMap K F e₂) (algebraMap K F e₃),
        spPair F d.1 d.2 = spPair F d.1 (spSqClMap (algebraMap K F) (sqCl αu)) *
          spPair F d.2 (spSqClMap (algebraMap K F) (sqCl cu)) := by
    rintro F _ _ hmul d ⟨d₁, d₂, rfl, hD⟩
    obtain ⟨e12, e13, e23⟩ := hdist (F := F)
    rw [GRho, GRho]
    show spPair F (sqCl d₁) (sqCl d₂) =
      spPair F (sqCl d₁) (sqCl (Units.map (algebraMap K F).toMonoidHom αu)) *
        spPair F (sqCl d₂) (sqCl (Units.map (algebraMap K F).toMonoidHom cu))
    rw [H4, H4, H4]
    have ea : ((Units.map (algebraMap K F).toMonoidHom αu : Fˣ) : F) =
        algebraMap K F e₁ - algebraMap K F e₂ := by
      show algebraMap K F (αu : K) = _
      rw [hαu, map_sub]
    have ec : ((Units.map (algebraMap K F).toMonoidHom cu : Fˣ) : F) =
        -(algebraMap K F e₁ - algebraMap K F e₂) := by
      show algebraMap K F (cu : K) = _
      rw [hcu, map_neg, map_sub]
    rw [ea, ec]
    exact isDescentClass_hilbSym_identity hF2 hmul _ _ _ e12 e13 e23 _ _ d₁.ne_zero d₂.ne_zero hD
  have GC : ∀ {F : Type u} [Field F] [Algebra K F],
      (spSqClMap (algebraMap K F) (sqCl cu), spSqClMap (algebraMap K F) (sqCl hu)) ∈
        spDesc F (algebraMap K F e₁) (algebraMap K F e₂) (algebraMap K F e₃) := by
    intro F _ _
    rw [GLoc]
    have ec : algebraMap K F (cu : K) = -(algebraMap K F e₁ - algebraMap K F e₂) := by
      rw [hcu, map_neg, map_sub]
    have eh : algebraMap K F (hu : K) =
        -(algebraMap K F e₁ - algebraMap K F e₂) * (algebraMap K F e₂ - algebraMap K F e₃) := by
      rw [hhu, map_mul, map_neg, map_sub, map_sub]
    rw [ec, eh]
    exact H7 _ _ _ (hdist (F := F)).1
  
  have hfinbad : ∀ x : K, x ≠ 0 →
      {v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) |
        IsDedekindDomain.HeightOneSpectrum.valuation K v x ≠ 1}.Finite := by
    intro x hx
    refine ((IsDedekindDomain.HeightOneSpectrum.Support.finite
      (NumberField.RingOfIntegers K) x).union
      (IsDedekindDomain.HeightOneSpectrum.Support.finite
        (NumberField.RingOfIntegers K) x⁻¹)).subset ?_
    intro v hv
    simp only [Set.mem_setOf_eq] at hv
    rcases lt_or_gt_of_ne hv with h | h
    · right
      show 1 < IsDedekindDomain.HeightOneSpectrum.valuation K v x⁻¹
      exact (Valuation.one_lt_val_iff _ (inv_ne_zero hx)).mpr (by rwa [inv_inv])
    · left
      exact h
  have h20 : (2 : K) ≠ 0 := two_ne_zero
  obtain ⟨T, hT₀T, hgen⟩ := exists_finset_sqGen
    ((((hfinbad 2 h20).union (hfinbad _ hα0)).union (hfinbad _ hβ0)).union (hfinbad _ hγ0)).toFinset
  have hTgood : ∀ v, v ∉ T →
      IsDedekindDomain.HeightOneSpectrum.valuation K v 2 = 1 ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) = 1 ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) = 1 ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K v (e₂ - e₃) = 1 := by
    intro v hv
    have hv' := fun h => hv (hT₀T h)
    simp only [Set.Finite.mem_toFinset, Set.mem_union, Set.mem_setOf_eq, not_or, not_not,
      imp_false] at hv'
    exact ⟨hv'.1.1.1, hv'.1.1.2, hv'.1.2, hv'.2⟩
  have hT2 : ∀ v, v ∉ T → IsDedekindDomain.HeightOneSpectrum.valuation K v 2 = 1 :=
    fun v hv => (hTgood v hv).1
  
  have Ev1 : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (x : Kˣ),
      IsDedekindDomain.HeightOneSpectrum.valuation K v (x : K) = 1 → EvenVal v x := by
    intro v x hx
    unfold EvenVal
    have h := IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq v x
    rw [hx] at h
    have h' : v.valuationOfNeZero x = 1 := by exact_mod_cast h
    rw [h']
    simp
  have EvMul : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x y : Kˣ), EvenVal v x → EvenVal v y → EvenVal v (x * y) := by
    intro v x y hx hy
    unfold EvenVal at *
    rw [map_mul, toAdd_mul]
    exact hx.add hy
  obtain ⟨G, hGdef⟩ : ∃ G : Set (SqCl K),
      G = {c | ∃ x : Kˣ, c = sqCl x ∧ ∀ v, v ∉ T → EvenVal v x} := ⟨_, rfl⟩
  have hGmem : ∀ c, c ∈ G ↔ ∃ x : Kˣ, c = sqCl x ∧ ∀ v, v ∉ T → EvenVal v x := by
    intro c
    rw [hGdef]
    rfl
  have hG1 : (1 : SqCl K) ∈ G := by
    refine (hGmem 1).mpr ⟨1, rfl, fun v _ => ?_⟩
    unfold EvenVal
    simp
  have hGmul : ∀ g ∈ G, ∀ h ∈ G, g * h ∈ G := by
    intro g hg h hh
    obtain ⟨x, rfl, hx⟩ := (hGmem g).mp hg
    obtain ⟨y, rfl, hy⟩ := (hGmem h).mp hh
    exact (hGmem _).mpr ⟨x * y, rfl, fun v hv => EvMul v x y (hx v hv) (hy v hv)⟩
  have hGcard : G.ncard = 2 ^ (T.card + Fintype.card (NumberField.InfinitePlace K)) := by
    rw [hGdef]
    exact ncard_KT2_of_sqGen T hgen
  have haG : sqCl αu ∈ G := (hGmem _).mpr ⟨αu, rfl, fun v hv =>
    Ev1 v αu (by rw [hαu]; exact (hTgood v hv).2.1)⟩
  have hcG : sqCl cu ∈ G := (hGmem _).mpr ⟨cu, rfl, fun v hv =>
    Ev1 v cu (by rw [hcu, Valuation.map_neg]; exact (hTgood v hv).2.1)⟩
  have hhuG : sqCl hu ∈ G := (hGmem _).mpr ⟨hu, rfl, fun v hv =>
    Ev1 v hu (by rw [hhu, Valuation.map_mul, Valuation.map_neg, (hTgood v hv).2.1,
      (hTgood v hv).2.2.2, one_mul])⟩
  
  have iV2 : ∀ i (x : spV T i), x ^ 2 = 1 := by
    rintro (v | w) x
    · exact H9 (F := v.1.adicCompletion K) x
    · exact H9 (F := w.Completion) x
  have iPmul : ∀ i (x x' y : spV T i), spP T i (x * x') y = spP T i x y * spP T i x' y := by
    rintro (v | w)
    · exact GPmul (F := v.1.adicCompletion K) (hilbSym_adicCompletion_mul_nondeg v.1).1
    · exact GPmul (F := w.Completion) (hilbSym_infinitePlace_mul_nondeg w).1
  have iPsymm : ∀ i (x y : spV T i), spP T i x y = spP T i y x := by
    rintro (v | w)
    · exact GPsymm (F := v.1.adicCompletion K)
    · exact GPsymm (F := w.Completion)
  have iPnd : ∀ i (x : spV T i), (∀ y, spP T i x y = 1) → x = 1 := by
    rintro (v | w)
    · exact GPnd (F := v.1.adicCompletion K) (hilbSym_adicCompletion_mul_nondeg v.1).2
    · exact GPnd (F := w.Completion) (hilbSym_infinitePlace_mul_nondeg w).2
  have iZone : ∀ i, (1 : spV T i × spV T i) ∈ spZ T e₁ e₂ e₃ i := by
    rintro (v | w)
    · exact GZone (F := v.1.adicCompletion K) _ _ _
    · exact GZone (F := w.Completion) _ _ _
  have iZmul : ∀ i, ∀ p ∈ spZ T e₁ e₂ e₃ i, ∀ q ∈ spZ T e₁ e₂ e₃ i,
      p * q ∈ spZ T e₁ e₂ e₃ i := by
    rintro (v | w)
    · obtain ⟨d12, d13, d23⟩ := hdist (F := v.1.adicCompletion K)
      exact GZmul (F := v.1.adicCompletion K) _ _ _ hF2 d12 d13 d23
    · obtain ⟨d12, d13, d23⟩ := hdist (F := w.Completion)
      exact GZmul (F := w.Completion) _ _ _ hF2 d12 d13 d23
  have iZcard : ∀ i, (spZ T e₁ e₂ e₃ i).ncard = Nat.card (spV T i) := by
    rintro (v | w)
    · obtain ⟨d12, d13, d23⟩ := hdist (F := v.1.adicCompletion K)
      exact descentSet_ncard_adicCompletion v.1 _ _ _ d12 d13 d23
    · obtain ⟨d12, d13, d23⟩ := hdist (F := w.Completion)
      exact descentSet_ncard_infinitePlace w _ _ _ d12 d13 d23
  have iρinj : ∀ g ∈ G, (∀ i, spRho T i g = 1) → g = 1 := by
    intro g hg hall
    obtain ⟨x, rfl, hx⟩ := (hGmem g).mp hg
    have hsq : IsSquare (x : K) := by
      refine isSquare_of_local_squares_KT2 T hT2 hgen x hx (fun v hv => ?_) (fun w => ?_)
      · exact GInj (F := v.adicCompletion K) x (hall (Sum.inl ⟨v, hv⟩))
      · exact GInj (F := w.Completion) x (hall (Sum.inr w))
    exact (H3 x).mpr hsq
  have hVcard : ∏ i, Nat.card (spV T i) =
      4 ^ (T.card + Fintype.card (NumberField.InfinitePlace K)) := by
    rw [Fintype.prod_sum_type]
    have key := card_sqCl_places T hT2
    rw [← Finset.prod_coe_sort T] at key
    exact key
  have iiso : ∀ g ∈ G, ∀ h ∈ G, ∏ i, spP T i (spRho T i g) (spRho T i h) = 1 := by
    intro g hg h hh
    obtain ⟨x, rfl, hx⟩ := (hGmem g).mp hg
    obtain ⟨y, rfl, hy⟩ := (hGmem h).mp hh
    rw [Fintype.prod_sum_type]
    have key := global_isotropy_KT2 T hT2 x y hx hy
    rw [← Finset.prod_coe_sort T] at key
    refine Eq.trans ?_ key
    congr 1
    · exact Finset.prod_congr rfl (fun v _ => GPair (F := v.1.adicCompletion K) x y)
    · exact Finset.prod_congr rfl (fun w _ => GPair (F := w.Completion) x y)
  have iR3 : ∀ i, ∀ d ∈ spZ T e₁ e₂ e₃ i, spP T i d.1 d.2 =
      spP T i d.1 (spRho T i (sqCl αu)) * spP T i d.2 (spRho T i (sqCl cu)) := by
    rintro (v | w) d hd
    · exact GR3 (F := v.1.adicCompletion K) (hilbSym_adicCompletion_mul_nondeg v.1).1 d hd
    · exact GR3 (F := w.Completion) (hilbSym_infinitePlace_mul_nondeg w).1 d hd
  have ihc : ∃ h ∈ G, ∀ i, (spRho T i (sqCl cu), spRho T i h) ∈ spZ T e₁ e₂ e₃ i := by
    refine ⟨sqCl hu, hhuG, ?_⟩
    rintro (v | w)
    · exact GC (F := v.1.adicCompletion K)
    · exact GC (F := w.Completion)
  
  obtain ⟨d, k, hSel, hk, hpar⟩ := selmer_parity_abstract (V := spV T) iV2 (spP T) iPmul iPsymm
    iPnd (spZ T e₁ e₂ e₃) iZone iZmul iZcard (H9 (F := K)) G hG1 hGmul (spRho T) iρinj
    (T.card + Fintype.card (NumberField.InfinitePlace K)) hGcard hVcard iiso (sqCl αu) (sqCl cu)
    haG hcG iR3 ihc
  
  have hSelEq : twoSelmerSet K e₁ e₂ e₃ =
      {p : SqCl K × SqCl K | p.1 ∈ G ∧ p.2 ∈ G ∧
        ∀ i, (spRho T i p.1, spRho T i p.2) ∈ spZ T e₁ e₂ e₃ i} := by
    ext ⟨c₁, c₂⟩
    unfold twoSelmerSet
    constructor
    · rintro ⟨⟨p₁, p₂⟩, ⟨hfin, hinf⟩, heq⟩
      simp only [Prod.mk.injEq] at heq
      obtain ⟨rfl, rfl⟩ := heq
      have hev : ∀ v, v ∉ T → EvenVal v p₁ ∧ EvenVal v p₂ := fun v hv =>
        (isDescentClass_good_odd_iff e₁ e₂ e₃ v (hTgood v hv).1 (hTgood v hv).2.1
          (hTgood v hv).2.2.1 (hTgood v hv).2.2.2 p₁ p₂).mp (hfin v)
      refine ⟨(hGmem _).mpr ⟨p₁, rfl, fun v hv => (hev v hv).1⟩,
        (hGmem _).mpr ⟨p₂, rfl, fun v hv => (hev v hv).2⟩, ?_⟩
      rintro (v | w)
      · exact (GLoc (F := v.1.adicCompletion K) p₁ p₂).mpr (hfin v.1)
      · exact (GLoc (F := w.Completion) p₁ p₂).mpr (hinf w)
    · rintro ⟨hc₁, hc₂, hloc⟩
      obtain ⟨x, rfl, hx⟩ := (hGmem _).mp hc₁
      obtain ⟨y, rfl, hy⟩ := (hGmem _).mp hc₂
      refine ⟨(x, y), ⟨fun v => ?_, fun w => ?_⟩, rfl⟩
      · by_cases hv : v ∈ T
        · exact (GLoc (F := v.adicCompletion K) x y).mp (hloc (Sum.inl ⟨v, hv⟩))
        · exact (isDescentClass_good_odd_iff e₁ e₂ e₃ v (hTgood v hv).1 (hTgood v hv).2.1
            (hTgood v hv).2.2.1 (hTgood v hv).2.2.2 x y).mpr ⟨hx v hv, hy v hv⟩
      · exact (GLoc (F := w.Completion) x y).mp (hloc (Sum.inr w))
  have hencard : (twoSelmerSet K e₁ e₂ e₃).encard = 2 ^ d := by
    rw [hSelEq]
    exact hSel
  have hsupp : Function.mulSupport (fun v : IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers K) =>
        phiSign (v.adicCompletion K) (algebraMap K _ e₁) (algebraMap K _ e₂)
          (algebraMap K _ e₃)) ⊆ ↑T := by
    intro v hv
    by_contra hvT
    exact (Function.mem_mulSupport.mp hv) (phiSign_hilbTerm_good_odd e₁ e₂ e₃ v (hTgood v hvT).1
      (hTgood v hvT).2.1 (hTgood v hvT).2.2.1 (hTgood v hvT).2.2.2).1
  refine ⟨T.finite_toSet.subset hsupp, d, hencard, ?_⟩
  have hT' : (∏ v ∈ T, phiSign (v.adicCompletion K) (algebraMap K _ e₁) (algebraMap K _ e₂)
      (algebraMap K _ e₃)) = ∏ v : ↥T, (-1 : ℤˣ) ^ (k (Sum.inl v) + 1) := by
    rw [← Finset.prod_coe_sort T]
    exact Finset.prod_congr rfl
      (fun v _ => GPhi (F := v.1.adicCompletion K) _ _ _ _ (hk (Sum.inl v)))
  have hI' : (∏ w : NumberField.InfinitePlace K, phiSign w.Completion (algebraMap K _ e₁)
      (algebraMap K _ e₂) (algebraMap K _ e₃)) = ∏ w, (-1 : ℤˣ) ^ (k (Sum.inr w) + 1) :=
    Finset.prod_congr rfl (fun w _ => GPhi (F := w.Completion) _ _ _ _ (hk (Sum.inr w)))
  have hprod : (∏ i, (-1 : ℤˣ) ^ (k i + 1)) =
      (∏ v : ↥T, (-1 : ℤˣ) ^ (k (Sum.inl v) + 1)) * ∏ w, (-1 : ℤˣ) ^ (k (Sum.inr w) + 1) :=
    Fintype.prod_sum_type _
  rw [finprod_eq_prod_of_mulSupport_subset _ hsupp, hT', hI', ← hprod, hpar,
    Finset.prod_congr rfl (fun i _ => pow_succ (-1 : ℤˣ) (k i)), Finset.prod_mul_distrib,
    Finset.prod_const, Finset.card_univ, Fintype.card_sum, Fintype.card_coe, mul_comm]

theorem phiSign_hilbTerm_real_complex : (∀ t₁ t₂ t₃ : ℝ, t₁ ≠ t₂ → t₁ ≠ t₃ → t₂ ≠ t₃ →
      phiSign ℝ t₁ t₂ t₃ * hilbTerm ℝ t₁ t₂ t₃ = -1) ∧
    (∀ t₁ t₂ t₃ : ℂ, t₁ ≠ t₂ → t₁ ≠ t₃ → t₂ ≠ t₃ →
      phiSign ℂ t₁ t₂ t₃ * hilbTerm ℂ t₁ t₂ t₃ = -1) :=
by
  
  have F1 : ∀ {F : Type} [Field F] (t₁ t₂ t₃ : F), IsDescentClass t₁ t₂ t₃ 1 ((1 : Fˣ) : F) := by
    intro F _ t₁ t₂ t₃
    refine ⟨0, 1, 1, 1, ?_, ?_, ?_⟩ <;> simp
  
  have S1 : ∀ {F : Type} [Field F] (t₁ t₂ t₃ : F),
      (phiImg F t₁ t₂ t₃).encard = 1 → phiSign F t₁ t₂ t₃ = -1 := by
    intro F _ t₁ t₂ t₃ h
    unfold phiSign
    rw [if_pos ⟨0, by rw [h, pow_zero], ⟨0, rfl⟩⟩]
  have S2 : ∀ {F : Type} [Field F] (t₁ t₂ t₃ : F),
      (phiImg F t₁ t₂ t₃).encard = 2 → phiSign F t₁ t₂ t₃ = 1 := by
    intro F _ t₁ t₂ t₃ h
    unfold phiSign
    rw [if_neg]
    rintro ⟨k, hk, hev⟩
    rw [h] at hk
    have hk' : (2 : ℕ) = 2 ^ k := by exact_mod_cast hk
    have hk1 : k = 1 := Nat.pow_right_injective le_rfl (show 2 ^ k = 2 ^ 1 by rw [pow_one]; exact hk'.symm)
    subst hk1
    exact Nat.not_even_one hev
  
  have SQ : ∀ {F : Type} [Field F] (u : Fˣ) (z : F) (hz : z ≠ 0), z ^ 2 = (u : F) →
      sqCl u = sqCl 1 := by
    intro F _ u z hz h
    symm
    unfold sqCl
    rw [QuotientGroup.eq]
    refine ⟨Units.mk0 z hz, ?_⟩
    ext
    simp [h]
  refine ⟨?_, ?_⟩
  · 
    have F2 : ∀ u : ℝˣ, 0 < (u : ℝ) → sqCl u = sqCl 1 := fun u hu =>
      SQ u (Real.sqrt u) (Real.sqrt_pos.2 hu).ne' (Real.sq_sqrt hu.le)
    have F3 : ∀ u : ℝˣ, (u : ℝ) < 0 → sqCl u = sqCl (-1) := by
      intro u hu
      symm
      unfold sqCl
      rw [QuotientGroup.eq]
      refine ⟨Units.mk0 (Real.sqrt (-(u : ℝ))) (Real.sqrt_pos.2 (by linarith)).ne', ?_⟩
      ext
      simp only [powMonoidHom_apply, Units.val_pow_eq_pow_val, Units.val_mk0, Units.val_mul,
        Units.val_inv_eq_inv_val, Units.val_neg, Units.val_one]
      rw [Real.sq_sqrt (by linarith)]
      ring
    have s2 : sqCl (1 : ℝˣ) ≠ sqCl (-1 : ℝˣ) := by
      intro h
      unfold sqCl at h
      rw [QuotientGroup.eq] at h
      obtain ⟨w, hw⟩ := h
      have h2 := congrArg Units.val hw
      simp only [powMonoidHom_apply, Units.val_pow_eq_pow_val, Units.val_mul,
        Units.val_inv_eq_inv_val, Units.val_neg, Units.val_one, inv_one, one_mul] at h2
      nlinarith [sq_nonneg (w : ℝ)]
    have F4 : ∀ t₁ t₂ t₃ u : ℝ, u < 0 → IsDescentClass t₁ t₂ t₃ 1 u → t₁ ≤ t₂ ∧ t₁ ≤ t₃ := by
      intro t₁ t₂ t₃ u hu hd
      obtain ⟨z₀, z₁, z₂, z₃, hnt, e1, e2⟩ := hd
      have hA : 0 ≤ -u * z₂ ^ 2 := mul_nonneg (by linarith) (sq_nonneg z₂)
      have hB : 0 ≤ -u * z₃ ^ 2 := mul_nonneg (by linarith) (sq_nonneg z₃)
      by_cases hz : z₀ = 0
      · exfalso
        apply hnt
        subst hz
        have a1 : z₁ ^ 2 = 0 := by nlinarith [sq_nonneg z₁]
        have a2 : u * z₂ ^ 2 = 0 := by nlinarith [sq_nonneg z₁]
        have a3 : u * z₃ ^ 2 = 0 := by nlinarith [sq_nonneg z₁]
        have b2 : z₂ ^ 2 = 0 := (mul_eq_zero.1 a2).resolve_left hu.ne
        have b3 : z₃ ^ 2 = 0 := (mul_eq_zero.1 a3).resolve_left hu.ne
        exact ⟨rfl, pow_eq_zero_iff two_ne_zero |>.1 a1, pow_eq_zero_iff two_ne_zero |>.1 b2,
          pow_eq_zero_iff two_ne_zero |>.1 b3⟩
      · have hz2 : 0 < z₀ ^ 2 := lt_of_le_of_ne (sq_nonneg _) (Ne.symm (pow_ne_zero 2 hz))
        constructor
        · by_contra hc
          push_neg at hc
          nlinarith [mul_neg_of_neg_of_pos (sub_neg.2 hc) hz2, sq_nonneg z₁]
        · by_contra hc
          push_neg at hc
          nlinarith [mul_neg_of_neg_of_pos (sub_neg.2 hc) hz2, sq_nonneg z₁]
    have F5 : ∀ t₁ t₂ t₃ : ℝ, t₁ ≤ t₂ → t₁ ≤ t₃ → IsDescentClass t₁ t₂ t₃ 1 ((-1 : ℝˣ) : ℝ) := by
      intro t₁ t₂ t₃ h2 h3
      refine ⟨1, 0, Real.sqrt (t₂ - t₁), Real.sqrt (t₃ - t₁), by simp, ?_, ?_⟩
      · rw [Units.val_neg, Units.val_one, Real.sq_sqrt (sub_nonneg.2 h2)]; ring
      · rw [Units.val_neg, Units.val_one, Real.sq_sqrt (sub_nonneg.2 h3)]; ring
    have PR1 : ∀ t₁ t₂ t₃ : ℝ, (t₁ < t₂ ∧ t₁ < t₃) →
        phiImg ℝ t₁ t₂ t₃ = {sqCl (1 : ℝˣ), sqCl (-1 : ℝˣ)} := by
      intro t₁ t₂ t₃ hmin
      ext c
      simp only [phiImg, Set.mem_setOf_eq, Set.mem_insert_iff, Set.mem_singleton_iff]
      constructor
      · rintro ⟨u, rfl, -⟩
        rcases lt_or_gt_of_ne (Units.ne_zero u) with h | h
        · right; exact F3 u h
        · left; exact F2 u h
      · rintro (rfl | rfl)
        · exact ⟨1, rfl, F1 t₁ t₂ t₃⟩
        · exact ⟨-1, rfl, F5 t₁ t₂ t₃ hmin.1.le hmin.2.le⟩
    have PR2 : ∀ t₁ t₂ t₃ : ℝ, t₁ ≠ t₂ → t₁ ≠ t₃ → ¬ (t₁ < t₂ ∧ t₁ < t₃) →
        phiImg ℝ t₁ t₂ t₃ = {sqCl (1 : ℝˣ)} := by
      intro t₁ t₂ t₃ h12 h13 hmin
      ext c
      simp only [phiImg, Set.mem_setOf_eq, Set.mem_singleton_iff]
      constructor
      · rintro ⟨u, rfl, hd⟩
        rcases lt_or_gt_of_ne (Units.ne_zero u) with h | h
        · exfalso
          obtain ⟨a, b⟩ := F4 t₁ t₂ t₃ _ h hd
          exact hmin ⟨lt_of_le_of_ne a h12, lt_of_le_of_ne b h13⟩
        · exact F2 u h
      · rintro rfl
        exact ⟨1, rfl, F1 t₁ t₂ t₃⟩
    have H1 : ∀ a b : ℝ, a ≤ 0 → b ≤ 0 → hilbSym ℝ a b = -1 := by
      intro a b ha hb
      unfold hilbSym
      rw [if_neg]
      rintro ⟨x, y, h⟩
      nlinarith [mul_nonpos_of_nonpos_of_nonneg ha (sq_nonneg x),
        mul_nonpos_of_nonpos_of_nonneg hb (sq_nonneg y)]
    have H2 : ∀ a b : ℝ, (0 < a ∨ 0 < b) → hilbSym ℝ a b = 1 := by
      intro a b hab
      unfold hilbSym
      rw [if_pos]
      rcases hab with h | h
      · refine ⟨(Real.sqrt a)⁻¹, 0, ?_⟩
        rw [inv_pow, Real.sq_sqrt h.le]
        simp [h.ne']
      · refine ⟨0, (Real.sqrt b)⁻¹, ?_⟩
        rw [inv_pow, Real.sq_sqrt h.le]
        simp [h.ne']
    intro t₁ t₂ t₃ h12 h13 _
    by_cases hmin : t₁ < t₂ ∧ t₁ < t₃
    · have hs : phiSign ℝ t₁ t₂ t₃ = 1 :=
        S2 t₁ t₂ t₃ (by rw [PR1 t₁ t₂ t₃ hmin]; exact Set.encard_pair s2)
      have hh : hilbTerm ℝ t₁ t₂ t₃ = -1 := by
        unfold hilbTerm
        rw [if_neg (by intro h; linarith [hmin.1, hmin.2])]
        exact H1 _ _ (by linarith [hmin.1, hmin.2])
          (by nlinarith [mul_pos_of_neg_of_neg (sub_neg.2 hmin.1) (sub_neg.2 hmin.2)])
      rw [hs, hh, one_mul]
    · have hs : phiSign ℝ t₁ t₂ t₃ = -1 :=
        S1 t₁ t₂ t₃ (by rw [PR2 t₁ t₂ t₃ h12 h13 hmin]; exact Set.encard_singleton _)
      have hh : hilbTerm ℝ t₁ t₂ t₃ = 1 := by
        unfold hilbTerm
        split_ifs with ha
        · rfl
        · apply H2
          by_contra hcon
          push_neg at hcon
          obtain ⟨hapos, hbpos⟩ := hcon
          rw [not_and_or, not_lt, not_lt] at hmin
          rcases hmin with h | h
          · have h' : t₂ < t₁ := lt_of_le_of_ne h (Ne.symm h12)
            have hβ : t₁ - t₃ < 0 := by linarith
            nlinarith [mul_neg_of_pos_of_neg (sub_pos.2 h') hβ]
          · have h' : t₃ < t₁ := lt_of_le_of_ne h (Ne.symm h13)
            have hα : t₁ - t₂ < 0 := by linarith
            nlinarith [mul_neg_of_neg_of_pos hα (sub_pos.2 h')]
      rw [hs, hh, mul_one]
  · 
    have PC : ∀ t₁ t₂ t₃ : ℂ, phiImg ℂ t₁ t₂ t₃ = {sqCl (1 : ℂˣ)} := by
      intro t₁ t₂ t₃
      ext c
      simp only [phiImg, Set.mem_setOf_eq, Set.mem_singleton_iff]
      constructor
      · rintro ⟨u, rfl, -⟩
        obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (u : ℂ) two_pos
        have hz0 : z ≠ 0 := by
          rintro rfl
          apply u.ne_zero
          rw [← hz]
          simp
        exact SQ u z hz0 hz
      · rintro rfl
        exact ⟨1, rfl, F1 t₁ t₂ t₃⟩
    have HC : ∀ t₁ t₂ t₃ : ℂ, hilbTerm ℂ t₁ t₂ t₃ = 1 := by
      intro t₁ t₂ t₃
      unfold hilbTerm
      split_ifs with ha
      · rfl
      · unfold hilbSym
        rw [if_pos]
        obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (2 * t₁ - t₂ - t₃) two_pos
        refine ⟨z⁻¹, 0, ?_⟩
        rw [inv_pow, hz]
        simp [ha]
    intro t₁ t₂ t₃ _ _ _
    rw [S1 t₁ t₂ t₃ (by rw [PC]; exact Set.encard_singleton _), HC, mul_one]

theorem exists_pts_variableChange_hom (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [DecidableEq (AlgebraicClosure F)]
    (E : WeierstrassCurve F) (C : WeierstrassCurve.VariableChange F) :
    ∃ φ : EllipticRootNumber.Pts F E →+ EllipticRootNumber.Pts F (C • E),
      Function.Injective φ ∧
      ∀ (σ : EllipticRootNumber.AbsGal F) (P : EllipticRootNumber.Pts F E),
        φ (EllipticRootNumber.galHom F E σ P) = EllipticRootNumber.galHom F (C • E) σ (φ P) :=
by
  
  have s1 : ∀ {K : Type u} [Field K] (W : WeierstrassCurve K)
      (C : WeierstrassCurve.VariableChange K) (x y : K), W.toAffine.Nonsingular x y →
      (C • W).toAffine.Nonsingular (↑C.u⁻¹ ^ 2 * (x - C.r))
        (↑C.u⁻¹ ^ 3 * (y - C.s * (x - C.r) - C.t)) := by
    intro K _ W C x y h
    have hv : ((C.u⁻¹ : Kˣ) : K) ≠ 0 := Units.ne_zero _
    rw [WeierstrassCurve.Affine.nonsingular_iff', WeierstrassCurve.Affine.equation_iff'] at h ⊢
    simp only [WeierstrassCurve.variableChange_a₁, WeierstrassCurve.variableChange_a₂,
      WeierstrassCurve.variableChange_a₃, WeierstrassCurve.variableChange_a₄,
      WeierstrassCurve.variableChange_a₆]
    obtain ⟨he, hp⟩ := h
    refine ⟨by linear_combination ((C.u⁻¹ : Kˣ) : K) ^ 6 * he, ?_⟩
    by_cases hq : 2 * y + W.a₁ * x + W.a₃ = 0
    · left
      have hp' : W.a₁ * y - (3 * x ^ 2 + 2 * W.a₂ * x + W.a₄) ≠ 0 :=
        hp.resolve_right (not_not.mpr hq)
      intro h0
      apply hp'
      have h4 : ((C.u⁻¹ : Kˣ) : K) ^ 4 * (W.a₁ * y - (3 * x ^ 2 + 2 * W.a₂ * x + W.a₄)) = 0 := by
        linear_combination h0 - ((C.u⁻¹ : Kˣ) : K) ^ 4 * C.s * hq
      exact (mul_eq_zero.mp h4).resolve_left (pow_ne_zero 4 hv)
    · right
      intro h0
      apply hq
      have h3 : ((C.u⁻¹ : Kˣ) : K) ^ 3 * (2 * y + W.a₁ * x + W.a₃) = 0 := by
        linear_combination h0
      exact (mul_eq_zero.mp h3).resolve_left (pow_ne_zero 3 hv)
  
  have alg3 : ∀ {K : Type u} [Field K] (a b a' b' v s : K), b ≠ 0 → v ≠ 0 →
      b' = v ^ 3 * b → a' = v ^ 4 * (a - s * b) → a' / b' = v * (a / b - s) := by
    intro K _ a b a' b' v s hb hv hb' ha'
    subst hb' ha'
    field_simp
  have alg2 : ∀ {K : Type u} [Field K] (a b a' b' v s : K), b ≠ 0 → v ≠ 0 →
      b' = v ^ 2 * b → a' = v ^ 3 * (a - s * b) → a' / b' = v * (a / b - s) := by
    intro K _ a b a' b' v s hb hv hb' ha'
    subst hb' ha'
    field_simp
  
  have s2 : ∀ {K : Type u} [Field K] [DecidableEq K] (W : WeierstrassCurve K)
      (C : WeierstrassCurve.VariableChange K) (x₁ x₂ y₁ y₂ : K),
      W.toAffine.Equation x₁ y₁ → W.toAffine.Equation x₂ y₂ →
      ¬(x₁ = x₂ ∧ y₁ = W.toAffine.negY x₂ y₂) →
      (C • W).toAffine.slope (↑C.u⁻¹ ^ 2 * (x₁ - C.r)) (↑C.u⁻¹ ^ 2 * (x₂ - C.r))
          (↑C.u⁻¹ ^ 3 * (y₁ - C.s * (x₁ - C.r) - C.t))
          (↑C.u⁻¹ ^ 3 * (y₂ - C.s * (x₂ - C.r) - C.t)) =
        ↑C.u⁻¹ * (W.toAffine.slope x₁ x₂ y₁ y₂ - C.s) := by
    intro K _ _ W C x₁ x₂ y₁ y₂ h₁ h₂ hxy
    have hv : ((C.u⁻¹ : Kˣ) : K) ≠ 0 := Units.ne_zero _
    by_cases hx : x₁ = x₂
    · subst hx
      have hy : y₁ ≠ W.toAffine.negY x₁ y₂ := fun e => hxy ⟨rfl, e⟩
      obtain rfl : y₁ = y₂ := WeierstrassCurve.Affine.Y_eq_of_Y_ne h₁ h₂ rfl hy
      have hD : y₁ - W.toAffine.negY x₁ y₁ ≠ 0 := sub_ne_zero.mpr hy
      have hy' : ((C.u⁻¹ : Kˣ) : K) ^ 3 * (y₁ - C.s * (x₁ - C.r) - C.t) ≠
          (C • W).toAffine.negY (((C.u⁻¹ : Kˣ) : K) ^ 2 * (x₁ - C.r))
            (((C.u⁻¹ : Kˣ) : K) ^ 3 * (y₁ - C.s * (x₁ - C.r) - C.t)) := by
        intro e
        apply hD
        have h3 : ((C.u⁻¹ : Kˣ) : K) ^ 3 * (y₁ - W.toAffine.negY x₁ y₁) = 0 := by
          simp only [WeierstrassCurve.Affine.negY, WeierstrassCurve.variableChange_a₁,
            WeierstrassCurve.variableChange_a₃] at e ⊢
          linear_combination e
        exact (mul_eq_zero.mp h3).resolve_left (pow_ne_zero 3 hv)
      rw [WeierstrassCurve.Affine.slope_of_Y_ne rfl hy, WeierstrassCurve.Affine.slope_of_Y_ne rfl hy']
      refine alg3 _ _ _ _ _ _ hD hv ?_ ?_
      · simp only [WeierstrassCurve.Affine.negY, WeierstrassCurve.variableChange_a₁,
          WeierstrassCurve.variableChange_a₃]
        ring
      · simp only [WeierstrassCurve.Affine.negY, WeierstrassCurve.variableChange_a₁,
          WeierstrassCurve.variableChange_a₂, WeierstrassCurve.variableChange_a₃,
          WeierstrassCurve.variableChange_a₄]
        ring
    · have hX : ((C.u⁻¹ : Kˣ) : K) ^ 2 * (x₁ - C.r) ≠ ((C.u⁻¹ : Kˣ) : K) ^ 2 * (x₂ - C.r) := by
        intro e
        apply hx
        have h2 : ((C.u⁻¹ : Kˣ) : K) ^ 2 * (x₁ - x₂) = 0 := by linear_combination e
        exact sub_eq_zero.mp ((mul_eq_zero.mp h2).resolve_left (pow_ne_zero 2 hv))
      rw [WeierstrassCurve.Affine.slope_of_X_ne hX, WeierstrassCurve.Affine.slope_of_X_ne hx]
      exact alg2 _ _ _ _ _ _ (sub_ne_zero.mpr hx) hv (by ring) (by ring)
  
  have gen : ∀ {K : Type u} [Field K] [DecidableEq K] (W W' : WeierstrassCurve K)
      (C : WeierstrassCurve.VariableChange K), W' = C • W →
      ∃ T : W.toAffine.Point →+ W'.toAffine.Point, Function.Injective T ∧
        ∀ (x y : K) (h : W.toAffine.Nonsingular x y),
          ∃ h' : W'.toAffine.Nonsingular (↑C.u⁻¹ ^ 2 * (x - C.r))
              (↑C.u⁻¹ ^ 3 * (y - C.s * (x - C.r) - C.t)),
            T (WeierstrassCurve.Affine.Point.some h) = WeierstrassCurve.Affine.Point.some h' := by
    intro K _ _ W W' C hW
    subst hW
    have hv : ((C.u⁻¹ : Kˣ) : K) ≠ 0 := Units.ne_zero _
    obtain ⟨T, hT0, hTs⟩ : ∃ T : W.toAffine.Point → (C • W).toAffine.Point,
        T WeierstrassCurve.Affine.Point.zero = WeierstrassCurve.Affine.Point.zero ∧
        ∀ (x y : K) (h : W.toAffine.Nonsingular x y),
          T (WeierstrassCurve.Affine.Point.some h) =
            WeierstrassCurve.Affine.Point.some (s1 W C x y h) :=
      ⟨fun P => match P with
        | .zero => .zero
        | @WeierstrassCurve.Affine.Point.some _ _ _ x y h => .some (s1 W C x y h),
        rfl, fun _ _ _ => rfl⟩
    have hadd : ∀ P Q : W.toAffine.Point, T (P + Q) = T P + T Q := by
      intro P Q
      cases P with
      | zero =>
        show T (0 + Q) = T 0 + T Q
        rw [zero_add]
        show T Q = T WeierstrassCurve.Affine.Point.zero + T Q
        rw [hT0]
        exact (zero_add _).symm
      | @some x₁ y₁ h₁ =>
        cases Q with
        | zero =>
          show T (WeierstrassCurve.Affine.Point.some h₁ + 0) =
            T (WeierstrassCurve.Affine.Point.some h₁) + T 0
          rw [add_zero]
          show _ = _ + T WeierstrassCurve.Affine.Point.zero
          rw [hT0]
          exact (add_zero _).symm
        | @some x₂ y₂ h₂ =>
          by_cases hxy : x₁ = x₂ ∧ y₁ = W.toAffine.negY x₂ y₂
          · rw [WeierstrassCurve.Affine.Point.add_of_Y_eq hxy.1 hxy.2, hTs, hTs]
            obtain ⟨rfl, rfl⟩ := hxy
            rw [WeierstrassCurve.Affine.Point.add_of_Y_eq rfl (by
              simp only [WeierstrassCurve.Affine.negY, WeierstrassCurve.variableChange_a₁,
                WeierstrassCurve.variableChange_a₃]
              ring)]
            exact hT0
          · have hxy' : ¬(((C.u⁻¹ : Kˣ) : K) ^ 2 * (x₁ - C.r) =
                  ((C.u⁻¹ : Kˣ) : K) ^ 2 * (x₂ - C.r) ∧
                ((C.u⁻¹ : Kˣ) : K) ^ 3 * (y₁ - C.s * (x₁ - C.r) - C.t) =
                  (C • W).toAffine.negY (((C.u⁻¹ : Kˣ) : K) ^ 2 * (x₂ - C.r))
                    (((C.u⁻¹ : Kˣ) : K) ^ 3 * (y₂ - C.s * (x₂ - C.r) - C.t))) := by
              rintro ⟨e1, e2⟩
              have hx : x₁ = x₂ := by
                have h2 : ((C.u⁻¹ : Kˣ) : K) ^ 2 * (x₁ - x₂) = 0 := by linear_combination e1
                exact sub_eq_zero.mp ((mul_eq_zero.mp h2).resolve_left (pow_ne_zero 2 hv))
              subst hx
              refine hxy ⟨rfl, ?_⟩
              have h3 : ((C.u⁻¹ : Kˣ) : K) ^ 3 * (y₁ - W.toAffine.negY x₁ y₂) = 0 := by
                simp only [WeierstrassCurve.Affine.negY, WeierstrassCurve.variableChange_a₁,
                  WeierstrassCurve.variableChange_a₃] at e2 ⊢
                linear_combination e2
              exact sub_eq_zero.mp ((mul_eq_zero.mp h3).resolve_left (pow_ne_zero 3 hv))
            rw [WeierstrassCurve.Affine.Point.add_some hxy, hTs, hTs, hTs,
              WeierstrassCurve.Affine.Point.add_some hxy', WeierstrassCurve.Affine.Point.some.injEq,
              s2 W C x₁ x₂ y₁ y₂ h₁.1 h₂.1 hxy]
            constructor
            · simp only [WeierstrassCurve.Affine.addX, WeierstrassCurve.variableChange_a₁,
                WeierstrassCurve.variableChange_a₂]
              ring
            · simp only [WeierstrassCurve.Affine.addY, WeierstrassCurve.Affine.negAddY,
                WeierstrassCurve.Affine.addX, WeierstrassCurve.Affine.negY,
                WeierstrassCurve.variableChange_a₁, WeierstrassCurve.variableChange_a₂,
                WeierstrassCurve.variableChange_a₃]
              ring
    have hinj : Function.Injective T := by
      intro P Q hPQ
      cases P with
      | zero =>
        cases Q with
        | zero => rfl
        | @some x₂ y₂ h₂ =>
          rw [hT0, hTs] at hPQ
          cases hPQ
      | @some x₁ y₁ h₁ =>
        cases Q with
        | zero =>
          rw [hT0, hTs] at hPQ
          cases hPQ
        | @some x₂ y₂ h₂ =>
          rw [hTs, hTs, WeierstrassCurve.Affine.Point.some.injEq] at hPQ
          obtain ⟨e1, e2⟩ := hPQ
          have hx : x₁ = x₂ := by
            have h2 : ((C.u⁻¹ : Kˣ) : K) ^ 2 * (x₁ - x₂) = 0 := by linear_combination e1
            exact sub_eq_zero.mp ((mul_eq_zero.mp h2).resolve_left (pow_ne_zero 2 hv))
          subst hx
          have hy : y₁ = y₂ := by
            have h3 : ((C.u⁻¹ : Kˣ) : K) ^ 3 * (y₁ - y₂) = 0 := by linear_combination e2
            exact sub_eq_zero.mp ((mul_eq_zero.mp h3).resolve_left (pow_ne_zero 3 hv))
          subst hy
          rfl
    exact ⟨AddMonoidHom.mk' T hadd, hinj, fun x y h => ⟨s1 W C x y h, hTs x y h⟩⟩
  
  obtain ⟨C', hC'⟩ : ∃ C' : WeierstrassCurve.VariableChange (AlgebraicClosure F),
      C' = C.map (algebraMap F (AlgebraicClosure F)) := ⟨_, rfl⟩
  have hW : (C • E).baseChange (AlgebraicClosure F) = C' • E.baseChange (AlgebraicClosure F) := by
    rw [hC']
    exact (WeierstrassCurve.map_variableChange E (algebraMap F (AlgebraicClosure F)) C).symm
  obtain ⟨T, hTinj, hTs⟩ := gen (E.baseChange (AlgebraicClosure F))
    ((C • E).baseChange (AlgebraicClosure F)) C' hW
  refine ⟨T, hTinj, ?_⟩
  have hu : ∀ σ : EllipticRootNumber.AbsGal F,
      σ ((C'.u⁻¹ : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) = ↑C'.u⁻¹ := by
    intro σ
    rw [hC']
    exact AlgEquiv.commutes σ ((C.u⁻¹ : Fˣ) : F)
  have hr : ∀ σ : EllipticRootNumber.AbsGal F, σ C'.r = C'.r := by
    intro σ; rw [hC']; exact AlgEquiv.commutes σ C.r
  have hs : ∀ σ : EllipticRootNumber.AbsGal F, σ C'.s = C'.s := by
    intro σ; rw [hC']; exact AlgEquiv.commutes σ C.s
  have ht : ∀ σ : EllipticRootNumber.AbsGal F, σ C'.t = C'.t := by
    intro σ; rw [hC']; exact AlgEquiv.commutes σ C.t
  intro σ P
  cases P with
  | zero =>
    show T (EllipticRootNumber.galHom F E σ 0) = EllipticRootNumber.galHom F (C • E) σ (T 0)
    simp only [map_zero]
  | @some x y h =>
    obtain ⟨h', hh'⟩ := hTs x y h
    obtain ⟨hσ, hg1⟩ : ∃ hσ : (E.baseChange (AlgebraicClosure F)).toAffine.Nonsingular (σ x) (σ y),
        EllipticRootNumber.galHom F E σ (WeierstrassCurve.Affine.Point.some h) =
          WeierstrassCurve.Affine.Point.some hσ := ⟨_, rfl⟩
    obtain ⟨h'', hh''⟩ := hTs (σ x) (σ y) hσ
    obtain ⟨hσ', hg2⟩ : ∃ hσ' : ((C • E).baseChange (AlgebraicClosure F)).toAffine.Nonsingular
          (σ (↑C'.u⁻¹ ^ 2 * (x - C'.r))) (σ (↑C'.u⁻¹ ^ 3 * (y - C'.s * (x - C'.r) - C'.t))),
        EllipticRootNumber.galHom F (C • E) σ (WeierstrassCurve.Affine.Point.some h') =
          WeierstrassCurve.Affine.Point.some hσ' := ⟨_, rfl⟩
    rw [hg1, hh'', hh', hg2, WeierstrassCurve.Affine.Point.some.injEq]
    simp only [map_mul, map_pow, map_sub, hu, hr, hs, ht]
    exact ⟨trivial, trivial⟩

theorem exists_galoisInvariant_valuation_algebraicClosure (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] :
    ∃ w : Valuation (AlgebraicClosure F) NNReal,
      (∀ a : F, w (algebraMap F (AlgebraicClosure F) a) ≤ 1 ↔ ValuativeRel.valuation F a ≤ 1) ∧
      ∀ (σ : EllipticRootNumber.AbsGal F) (α : AlgebraicClosure F), w (σ α) = w α :=
by
  have s2 : ∀ (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]
      (L : Type u) [Field L] [Algebra K L] [Algebra.IsAlgebraic K L],
      ∃ w : Valuation L NNReal, (∀ a : K, ((w (algebraMap K L a) : NNReal) : ℝ) = ‖a‖) ∧
        ∀ (σ : L ≃ₐ[K] L) (x : L), w (σ x) = w x := by
    intro K _ _ _ L _ _ _
    refine ⟨{ toFun := fun x => ⟨spectralNorm K L x, spectralNorm_nonneg x⟩
              map_zero' := Subtype.ext spectralNorm_zero
              map_one' := Subtype.ext spectralNorm_one
              map_mul' := fun x y => Subtype.ext (by
                show spectralNorm K L (x * y) = spectralNorm K L x * spectralNorm K L y
                rw [← spectralMulAlgNorm_def, ← spectralMulAlgNorm_def, ← spectralMulAlgNorm_def]
                exact map_mul (spectralMulAlgNorm K L) x y)
              map_add_le_max' := fun x y => by
                show (⟨spectralNorm K L (x + y), spectralNorm_nonneg _⟩ : NNReal) ≤
                  max ⟨spectralNorm K L x, spectralNorm_nonneg _⟩
                    ⟨spectralNorm K L y, spectralNorm_nonneg _⟩
                rw [← NNReal.coe_le_coe, NNReal.coe_max]
                exact isNonarchimedean_spectralNorm x y }, ?_, ?_⟩
    · intro a
      exact spectralNorm_extends a
    · intro σ x
      exact Subtype.ext (spectralNorm_eq_of_equiv σ x).symm
  let φ : ValuativeRel.ValueGroupWithZero F →*₀ NNReal :=
    (WithZeroMulInt.toNNReal (two_ne_zero : (2 : NNReal) ≠ 0)).comp
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F :
        ValuativeRel.ValueGroupWithZero F →*₀ WithZero (Multiplicative ℤ))
  have hφ : StrictMono φ :=
    (WithZeroMulInt.toNNReal_strictMono (one_lt_two : (1 : NNReal) < 2)).comp
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).strictMono
  have s3 : ∀ (u : ℕ → F), (∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ m ≥ N, ∀ n ≥ N,
          ((φ (ValuativeRel.valuation F (u m - u n)) : NNReal) : ℝ) < ε) →
        ∃ a : F, ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ n ≥ N,
          ((φ (ValuativeRel.valuation F (u n - a)) : NNReal) : ℝ) < ε := by
    intro u hu
    letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
    haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
    haveI : CompleteSpace F := IsNonarchimedeanLocalField.instCompleteSpace F
    have hpos : ∀ γ : (ValuativeRel.ValueGroupWithZero F)ˣ,
        (0 : ℝ) < ((φ (γ : ValuativeRel.ValueGroupWithZero F) : NNReal) : ℝ) := by
      intro γ
      have h : φ 0 < φ γ := hφ (zero_lt_iff.mpr γ.ne_zero)
      rw [map_zero] at h
      exact_mod_cast h
    have hc : CauchySeq u := by
      rw [cauchySeq_iff_tendsto, uniformity_eq_comap_nhds_zero F, Filter.tendsto_comap_iff]
      intro s hs
      obtain ⟨γ, hγ⟩ := (IsValuativeTopology.mem_nhds_zero_iff s).mp hs
      obtain ⟨N, hN⟩ := hu _ (hpos γ)
      rw [Filter.mem_map, Filter.mem_atTop_sets]
      refine ⟨(N, N), fun p hp => hγ ?_⟩
      have h := hN p.2 hp.2 p.1 hp.1
      show ValuativeRel.valuation F (u p.2 - u p.1) < γ
      exact hφ.lt_iff_lt.mp (by exact_mod_cast h)
    obtain ⟨a, ha⟩ := cauchySeq_tendsto_of_complete hc
    obtain ⟨γ₀, h0, h1⟩ := ValuativeRel.IsNontrivial.exists_lt_one (R := F)
    refine ⟨a, fun ε hε => ?_⟩
    have hq1 : ((φ γ₀ : NNReal) : ℝ) < 1 := by
      have h : φ γ₀ < φ 1 := hφ h1
      rw [map_one] at h
      exact_mod_cast h
    obtain ⟨k, hk⟩ := exists_pow_lt_of_lt_one hε hq1
    have hS : {z | ValuativeRel.valuation F (z - a) <
        ((Units.mk0 (γ₀ ^ k) (pow_ne_zero k h0.ne') : (ValuativeRel.ValueGroupWithZero F)ˣ) :
          ValuativeRel.ValueGroupWithZero F)} ∈ nhds a :=
      IsValuativeTopology.mem_nhds_iff'.mpr ⟨_, subset_rfl⟩
    obtain ⟨N, hN⟩ := Filter.mem_atTop_sets.mp (ha hS)
    refine ⟨N, fun n hn => ?_⟩
    have h := hN n hn
    simp only [Set.mem_preimage, Set.mem_setOf_eq, Units.val_mk0] at h
    have h2 : φ (ValuativeRel.valuation F (u n - a)) < φ γ₀ ^ k := by
      rw [← map_pow]; exact hφ h
    calc ((φ (ValuativeRel.valuation F (u n - a)) : NNReal) : ℝ) < ((φ γ₀ ^ k : NNReal) : ℝ) := by
          exact_mod_cast h2
      _ = ((φ γ₀ : NNReal) : ℝ) ^ k := NNReal.coe_pow _ _
      _ < ε := hk
  haveI hnt : (ValuativeRel.valuation F).IsNontrivial :=
    (ValuativeRel.isNontrivial_iff_isNontrivial (ValuativeRel.valuation F)).mp inferInstance
  letI VF : Valued F (ValuativeRel.ValueGroupWithZero F) := Valued.mk' (ValuativeRel.valuation F)
  letI R1 : (Valued.v : Valuation F (ValuativeRel.ValueGroupWithZero F)).RankOne :=
    @Valuation.RankOne.mk _ _ _ _ _ hnt φ hφ
  letI NF : NontriviallyNormedField F := Valued.toNontriviallyNormedField
  have hnorm : ∀ x : F, ‖x‖ = ((φ (ValuativeRel.valuation F x) : NNReal) : ℝ) := fun x => rfl
  haveI UM : IsUltrametricDist F := IsUltrametricDist.isUltrametricDist_of_isNonarchimedean_norm
    (fun x y => by
      rw [hnorm, hnorm, hnorm, ← NNReal.coe_max, NNReal.coe_le_coe, ← hφ.monotone.map_max]
      exact hφ.monotone (Valuation.map_add _ _ _))
  haveI CS : CompleteSpace F := by
    apply Metric.complete_of_cauchySeq_tendsto
    intro u hu
    rw [Metric.cauchySeq_iff] at hu
    obtain ⟨a, ha⟩ := s3 u (fun ε hε => by
      obtain ⟨N, hN⟩ := hu ε hε
      exact ⟨N, fun m hm n hn => by
        have := hN m hm n hn
        rwa [dist_eq_norm, hnorm] at this⟩)
    refine ⟨a, Metric.tendsto_atTop.mpr fun ε hε => ?_⟩
    obtain ⟨N, hN⟩ := ha ε hε
    exact ⟨N, fun n hn => by rw [dist_eq_norm, hnorm]; exact hN n hn⟩
  obtain ⟨w, hext, hinv⟩ := s2 F (AlgebraicClosure F)
  refine ⟨w, fun a => ?_, fun σ α => hinv σ α⟩
  rw [← NNReal.coe_le_one, hext a, hnorm, NNReal.coe_le_one, ← map_one φ, hφ.le_iff_le]

theorem valuation_sub_lt_one_of_mem_inertia (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (w : Valuation (AlgebraicClosure F) NNReal)
    (hw₁ : ∀ a : F, w (algebraMap F (AlgebraicClosure F) a) ≤ 1 ↔ ValuativeRel.valuation F a ≤ 1)
    (hw₂ : ∀ (τ : EllipticRootNumber.AbsGal F) (α : AlgebraicClosure F), w (τ α) = w α)
    (σ : EllipticRootNumber.AbsGal F) (hσ : σ ∈ EllipticRootNumber.inertia F)
    (α : AlgebraicClosure F) (hα : w α ≤ 1) :
    w (σ α - α) < 1 :=
by
  classical
  
  rcases lt_or_eq_of_le hα with hlt | heq
  · refine lt_of_le_of_lt (Valuation.map_sub _ _ _) (max_lt ?_ hlt)
    rw [hw₂]; exact hlt
  
  have hT : ∀ a : F, ValuativeRel.valuation F a < 1 →
      w (algebraMap F (AlgebraicClosure F) a) < 1 := by
    intro a ha
    by_cases ha0 : a = 0
    · subst ha0; simp
    by_contra hc
    push_neg at hc
    have h2 : w (algebraMap F (AlgebraicClosure F) a⁻¹) ≤ 1 := by
      rw [map_inv₀, map_inv₀]; exact inv_le_one_of_one_le₀ hc
    have h3 : ValuativeRel.valuation F a⁻¹ ≤ 1 := (hw₁ _).mp h2
    have h4 : (1 : ValuativeRel.ValueGroupWithZero F) ≤ ValuativeRel.valuation F a := by
      calc (1 : ValuativeRel.ValueGroupWithZero F) = ValuativeRel.valuation F (a * a⁻¹) := by
            rw [mul_inv_cancel₀ ha0, map_one]
        _ = ValuativeRel.valuation F a * ValuativeRel.valuation F a⁻¹ := map_mul _ _ _
        _ ≤ ValuativeRel.valuation F a * 1 := mul_le_mul_left' h3 _
        _ = ValuativeRel.valuation F a := mul_one _
    exact absurd (lt_of_le_of_lt h4 ha) (lt_irrefl 1)
  
  have hint : IsIntegral F α := Algebra.IsIntegral.isIntegral α
  have s2 : ∀ k : ℕ, ValuativeRel.valuation F ((minpoly F α).coeff k) ≤ 1 := by
    intro k
    set f := minpoly F α with hf
    set P := f.map (algebraMap F (AlgebraicClosure F)) with hP
    have hPmon : P.Monic := (minpoly.monic hint).map _
    have hPeq := Polynomial.Splits.eq_prod_roots_of_monic (IsAlgClosed.splits P) hPmon
    have hroots : ∀ β ∈ P.roots, w β ≤ 1 := by
      intro β hβ
      have hr : Polynomial.aeval β f = 0 := by
        have := (Polynomial.mem_roots hPmon.ne_zero).mp hβ
        rw [Polynomial.IsRoot.def, hP, Polynomial.eval_map_algebraMap] at this
        exact this
      have hmin : minpoly F β = minpoly F α :=
        (minpoly.eq_of_irreducible_of_monic (minpoly.irreducible hint) hr
          (minpoly.monic hint)).symm
      haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
      obtain ⟨τ, hτ⟩ := (Normal.minpoly_eq_iff_mem_orbit (AlgebraicClosure F)).mp hmin
      rw [← hτ]
      dsimp only
      rw [AlgEquiv.smul_def, hw₂]
      exact heq.le
    have hmem : P ∈ Polynomial.lifts w.integer.subtype := by
      rw [hPeq]
      refine Subsemiring.multiset_prod_mem _ _ (fun q hq => ?_)
      obtain ⟨β, hβ, rfl⟩ := Multiset.mem_map.mp hq
      refine (Polynomial.mem_lifts _).mpr
        ⟨Polynomial.X - Polynomial.C ⟨β, (Valuation.mem_integer_iff _ _).mpr (hroots β hβ)⟩, ?_⟩
      simp
    obtain ⟨c, hc⟩ := (Polynomial.lifts_iff_coeff_lifts _).mp hmem k
    rw [hP, Polynomial.coeff_map] at hc
    rw [← hw₁, ← hc]
    exact (Valuation.mem_integer_iff _ _).mp c.2
  
  have s3 : ∃ N : ℕ, 0 < N ∧ w (α ^ N - 1) < 1 := by
    set f := minpoly F α with hf
    have hroot : Polynomial.aeval α f = 0 := minpoly.aeval F α
    set O := (ValuativeRel.valuation F).integer with hO
    have hlift : f ∈ Polynomial.lifts O.subtype := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      exact ⟨⟨f.coeff n, (Valuation.mem_integer_iff _ _).mpr (s2 n)⟩, rfl⟩
    obtain ⟨g, hgmap, -, hgmon⟩ :=
      Polynomial.lifts_and_natDegree_eq_and_monic hlift (minpoly.monic hint)
    set ψ : O →+* AlgebraicClosure F := (algebraMap F (AlgebraicClosure F)).comp O.subtype
      with hψ
    have hgα : Polynomial.eval₂ ψ α g = 0 := by
      rw [hψ, ← Polynomial.eval₂_map, hgmap, ← Polynomial.aeval_def, hroot]
    have hg1 : g ≠ 1 := by
      rintro rfl
      simp at hgα
    have hrep : ∀ n : ℕ, α ^ n = ∑ i ∈ Finset.range g.natDegree,
        ψ ((Polynomial.X ^ n %ₘ g).coeff i) * α ^ i := by
      intro n
      have h1 := Polynomial.modByMonic_add_div (Polynomial.X ^ n) hgmon
      have h2 := congrArg (Polynomial.eval₂ ψ α) h1
      rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, hgα, zero_mul, add_zero,
        Polynomial.eval₂_X_pow] at h2
      rw [← h2]
      exact Polynomial.eval₂_eq_sum_range' ψ (Polynomial.natDegree_modByMonic_lt _ hgmon hg1) α
    let Φ : ℕ → (Fin g.natDegree → IsLocalRing.ResidueField O) :=
      fun n i => IsLocalRing.residue O ((Polynomial.X ^ n %ₘ g).coeff i)
    obtain ⟨n₁, n₂, hne, hΦ⟩ := Finite.exists_ne_map_eq_of_infinite Φ
    have key : ∀ a b : ℕ, a < b → Φ a = Φ b → ∃ N : ℕ, 0 < N ∧ w (α ^ N - 1) < 1 := by
      intro a b hab hab'
      refine ⟨b - a, by omega, ?_⟩
      have hdiff : α ^ b - α ^ a = ∑ i ∈ Finset.range g.natDegree,
          ψ ((Polynomial.X ^ b %ₘ g).coeff i - (Polynomial.X ^ a %ₘ g).coeff i) * α ^ i := by
        rw [hrep b, hrep a, ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [map_sub, sub_mul]
      have hsmall : w (α ^ b - α ^ a) < 1 := by
        rw [hdiff]
        apply w.map_sum_lt one_ne_zero
        intro i hi
        rw [map_mul, map_pow, heq, one_pow, mul_one]
        have hi' : i < g.natDegree := Finset.mem_range.mp hi
        have hres : IsLocalRing.residue O
            ((Polynomial.X ^ b %ₘ g).coeff i - (Polynomial.X ^ a %ₘ g).coeff i) = 0 := by
          rw [map_sub, sub_eq_zero]
          exact (congrFun hab' ⟨i, hi'⟩).symm
        set c := (Polynomial.X ^ b %ₘ g).coeff i - (Polynomial.X ^ a %ₘ g).coeff i
        have hnu : ¬ IsUnit c :=
          (IsLocalRing.mem_maximalIdeal _).mp ((IsLocalRing.residue_eq_zero_iff _).mp hres)
        have hlt : ValuativeRel.valuation F (c : F) < 1 := by
          refine lt_of_le_of_ne ((Valuation.mem_integer_iff _ _).mp c.2) ?_
          intro h1
          exact hnu ((Valuation.integer.integers
            (ValuativeRel.valuation F)).isUnit_iff_valuation_eq_one.mpr h1)
        exact hT _ hlt
      have hfac : α ^ b - α ^ a = α ^ a * (α ^ (b - a) - 1) := by
        rw [mul_sub, ← pow_add, mul_one, Nat.add_sub_cancel' hab.le]
      rw [hfac, map_mul, map_pow, heq, one_pow, one_mul] at hsmall
      exact hsmall
    rcases lt_or_gt_of_ne hne with h | h
    · exact key _ _ h hΦ
    · exact key _ _ h hΦ.symm
  
  have hp : (EllipticRootNumber.p F).Prime := by
    unfold EllipticRootNumber.p
    exact CharP.char_is_prime (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) _
  have hvp : ValuativeRel.valuation F ((EllipticRootNumber.p F : ℕ) : F) < 1 := by
    have hres : IsLocalRing.residue (ValuativeRel.valuation F).integer
        ((EllipticRootNumber.p F : ℕ) : (ValuativeRel.valuation F).integer) = 0 := by
      rw [map_natCast]
      unfold EllipticRootNumber.p
      exact ringChar.Nat.cast_ringChar
    have hnu : ¬ IsUnit ((EllipticRootNumber.p F : ℕ) : (ValuativeRel.valuation F).integer) :=
      (IsLocalRing.mem_maximalIdeal _).mp ((IsLocalRing.residue_eq_zero_iff _).mp hres)
    have hle : ValuativeRel.valuation F ((EllipticRootNumber.p F : ℕ) : F) ≤ 1 :=
      natCast_mem (ValuativeRel.valuation F).integer _
    refine lt_of_le_of_ne hle ?_
    intro h1
    apply hnu
    exact (Valuation.integer.integers
      (ValuativeRel.valuation F)).isUnit_iff_valuation_eq_one.mpr (by simpa using h1)
  have hwp : w ((EllipticRootNumber.p F : ℕ) : AlgebraicClosure F) < 1 := by
    rw [← map_natCast (algebraMap F (AlgebraicClosure F))]
    exact hT _ hvp
  
  have claim : ∀ γ : AlgebraicClosure F, w γ ≤ 1 → w (γ ^ EllipticRootNumber.p F - 1) < 1 →
      w (γ - 1) < 1 := by
    intro γ hγ h
    obtain ⟨r, hr⟩ := exists_add_pow_prime_eq hp
      (⟨γ, (Valuation.mem_integer_iff _ _).mpr hγ⟩ : w.integer) (-1)
    have hr' : (γ - 1) ^ EllipticRootNumber.p F = (γ ^ EllipticRootNumber.p F - 1) +
        ((-1) ^ EllipticRootNumber.p F + 1) -
          ((EllipticRootNumber.p F : ℕ) : AlgebraicClosure F) * γ * (r : AlgebraicClosure F) := by
      have := congrArg Subtype.val hr
      push_cast at this
      rw [sub_eq_add_neg, this]
      ring
    have h2 : w ((-1 : AlgebraicClosure F) ^ EllipticRootNumber.p F + 1) < 1 := by
      rcases hp.eq_two_or_odd' with h2p | hodd
      · rw [h2p] at hwp ⊢
        norm_num
        exact_mod_cast hwp
      · rw [hodd.neg_one_pow]
        simp
    have h3 : w (((EllipticRootNumber.p F : ℕ) : AlgebraicClosure F) * γ *
        (r : AlgebraicClosure F)) < 1 := by
      rw [map_mul, map_mul]
      calc w ((EllipticRootNumber.p F : ℕ) : AlgebraicClosure F) * w γ * w (r : AlgebraicClosure F)
          ≤ w ((EllipticRootNumber.p F : ℕ) : AlgebraicClosure F) * 1 * 1 := by
            gcongr
            exact (Valuation.mem_integer_iff _ _).mp r.2
        _ < 1 := by simpa using hwp
    have h4 : w ((γ - 1) ^ EllipticRootNumber.p F) < 1 := by
      rw [hr']
      refine lt_of_le_of_lt (Valuation.map_sub _ _ _) (max_lt ?_ h3)
      exact lt_of_le_of_lt (Valuation.map_add _ _ _) (max_lt h h2)
    rw [map_pow] at h4
    by_contra hc
    push_neg at hc
    exact absurd h4 (not_lt.mpr (one_le_pow₀ hc))
  have s4 : ∀ (a : ℕ) (β : AlgebraicClosure F), w β ≤ 1 →
      w (β ^ (EllipticRootNumber.p F ^ a) - 1) < 1 → w (β - 1) < 1 := by
    intro a
    induction a with
    | zero => intro β _ h; simpa using h
    | succ a ih =>
      intro β hβ h
      apply ih β hβ
      apply claim _ (by rw [map_pow]; exact pow_le_one₀ zero_le' hβ)
      rw [← pow_mul, ← pow_succ]
      exact h
  
  obtain ⟨N, hNpos, hN⟩ := s3
  obtain ⟨e, N', hN'ndvd, hNeq⟩ := Nat.exists_eq_pow_mul_and_not_dvd hNpos.ne' _ hp.ne_one
  have hN'pos : 0 < N' := by
    rcases Nat.eq_zero_or_pos N' with h | h
    · rw [h, mul_zero] at hNeq; omega
    · exact h
  have hβ : w (α ^ N' - 1) < 1 := by
    apply s4 e (α ^ N') (by rw [map_pow, heq, one_pow])
    rw [← pow_mul, mul_comm, ← hNeq]
    exact hN
  
  obtain ⟨ζ, hζ, hαζ⟩ : ∃ ζ : AlgebraicClosure F, ζ ^ N' = 1 ∧ w (α - ζ) < 1 := by
    set P : Polynomial (AlgebraicClosure F) := Polynomial.X ^ N' - Polynomial.C 1 with hP
    have hmon : P.Monic := Polynomial.monic_X_pow_sub_C 1 hN'pos.ne'
    have hPeq := Polynomial.Splits.eq_prod_roots_of_monic (IsAlgClosed.splits P) hmon
    have hev : α ^ N' - 1 = (P.roots.map (fun ζ => α - ζ)).prod := by
      have := congrArg (Polynomial.eval α) hPeq
      rw [Polynomial.eval_multiset_prod, Multiset.map_map] at this
      simpa [hP] using this
    by_contra hne
    push_neg at hne
    apply (not_lt.mpr _) hβ
    rw [hev, map_multiset_prod, Multiset.map_map]
    apply Multiset.one_le_prod_of_one_le
    intro x hx
    obtain ⟨ζ, hζ, rfl⟩ := Multiset.mem_map.mp hx
    have hroot : ζ ^ N' = 1 := by
      have := (Polynomial.mem_roots hmon.ne_zero).mp hζ
      simpa [hP, sub_eq_zero] using this
    exact hne ζ hroot
  
  have hζmem : ζ ∈ EllipticRootNumber.unramifiedClosure F :=
    IntermediateField.subset_adjoin F _ ⟨N', hN'pos, hN'ndvd, hζ⟩
  have hσζ : σ ζ = ζ := (IntermediateField.mem_fixingSubgroup_iff _ _).mp hσ ζ hζmem
  have e1 : σ α - α = σ (α - ζ) - (α - ζ) := by
    rw [map_sub, hσζ]; ring
  rw [e1]
  refine lt_of_le_of_lt (Valuation.map_sub _ _ _) (max_lt ?_ hαζ)
  rw [hw₂]
  exact hαζ

theorem weierstrass_E1_basic {K : Type*} [Field K] {Γ₀ : Type*}
    [LinearOrderedCommGroupWithZero Γ₀] (w : Valuation K Γ₀) (W : WeierstrassCurve K)
    (h₁ : w W.a₁ ≤ 1) (h₂ : w W.a₂ ≤ 1) (h₃ : w W.a₃ ≤ 1) (h₄ : w W.a₄ ≤ 1) (h₆ : w W.a₆ ≤ 1)
    {x y : K} (h : W.toAffine.Equation x y) :
    (w x ≤ 1 → w y ≤ 1) ∧
    (1 < w x → w y ^ 2 = w x ^ 3 ∧ w (x / y) < 1 ∧
      w (x / W.toAffine.negY x y + x / y) ≤ w (x / y) ^ 2) :=
by
  have h' := (WeierstrassCurve.Affine.equation_iff x y).mp h
  have e1 : y ^ 2 + (W.a₁ * x * y + W.a₃ * y) = x ^ 3 + (W.a₂ * x ^ 2 + W.a₄ * x + W.a₆) := by
    linear_combination h'
  have hE : w (y ^ 2 + (W.a₁ * x * y + W.a₃ * y)) =
      w (x ^ 3 + (W.a₂ * x ^ 2 + W.a₄ * x + W.a₆)) := by rw [e1]
  
  have v1 : w (W.a₁ * x * y) = w W.a₁ * w x * w y := by rw [map_mul, map_mul]
  have v3 : w (W.a₃ * y) = w W.a₃ * w y := map_mul _ _ _
  have v2 : w (W.a₂ * x ^ 2) = w W.a₂ * w x ^ 2 := by rw [map_mul, map_pow]
  have v4 : w (W.a₄ * x) = w W.a₄ * w x := map_mul _ _ _
  have a3le : w (W.a₃ * y) ≤ w y := by rw [v3]; exact mul_le_of_le_one_left' h₃
  refine ⟨fun hx => ?_, fun hx => ?_⟩
  · 
    by_contra hy
    push_neg at hy
    have hY0 : 0 < w y := zero_lt_one.trans hy
    have hR : w (x ^ 3 + (W.a₂ * x ^ 2 + W.a₄ * x + W.a₆)) ≤ 1 := by
      refine Valuation.map_add_le w ?_ (Valuation.map_add_le w (Valuation.map_add_le w ?_ ?_) h₆)
      · rw [map_pow]; exact pow_le_one₀ zero_le' hx
      · rw [v2]; exact mul_le_one' h₂ (pow_le_one₀ zero_le' hx)
      · rw [v4]; exact mul_le_one' h₄ hx
    have hYY : w y < w y ^ 2 := by
      have := mul_lt_mul_of_pos_left hy hY0
      rwa [mul_one, ← sq] at this
    have hrest : w (W.a₁ * x * y + W.a₃ * y) < w (y ^ 2) := by
      rw [map_pow]
      refine lt_of_le_of_lt (Valuation.map_add_le w ?_ a3le) hYY
      rw [v1]; exact mul_le_of_le_one_left' (mul_le_one' h₁ hx)
    have hL := Valuation.map_add_eq_of_lt_left w hrest
    rw [hE, map_pow] at hL
    have : w y ^ 2 ≤ 1 := hL ▸ hR
    exact absurd (hy.trans hYY) (not_lt.mpr this)
  · 
    have hX0 : 0 < w x := zero_lt_one.trans hx
    have hXX : w x ≤ w x ^ 2 := by
      rw [sq]; exact le_mul_of_one_le_right' hx.le
    have h1X2 : 1 ≤ w x ^ 2 := hx.le.trans hXX
    have hX23 : w x ^ 2 < w x ^ 3 := by
      have := mul_lt_mul_of_pos_left hx (pow_pos hX0 2)
      rwa [mul_one, ← pow_succ] at this
    have hrestR : w (W.a₂ * x ^ 2 + W.a₄ * x + W.a₆) ≤ w x ^ 2 := by
      refine Valuation.map_add_le w (Valuation.map_add_le w ?_ ?_) (h₆.trans h1X2)
      · rw [v2]; exact mul_le_of_le_one_left' h₂
      · rw [v4]; exact (mul_le_of_le_one_left' h₄).trans hXX
    have hR : w (x ^ 3 + (W.a₂ * x ^ 2 + W.a₄ * x + W.a₆)) = w x ^ 3 := by
      rw [Valuation.map_add_eq_of_lt_left w (by rw [map_pow]; exact hrestR.trans_lt hX23),
        map_pow]
    have a1le : w (W.a₁ * x * y) ≤ w x * w y := by
      rw [v1]; exact mul_le_mul_right' (mul_le_of_le_one_left' h₁) _
    have hXY : w x < w y := by
      by_contra hYX
      push_neg at hYX
      have hLle : w (y ^ 2 + (W.a₁ * x * y + W.a₃ * y)) ≤ w x ^ 2 := by
        refine Valuation.map_add_le w ?_ (Valuation.map_add_le w ?_ ?_)
        · rw [map_pow]; exact pow_le_pow_left₀ zero_le' hYX 2
        · refine a1le.trans ?_
          rw [sq]; exact mul_le_mul_left' hYX _
        · exact (a3le.trans hYX).trans hXX
      rw [hE, hR] at hLle
      exact absurd hX23 (not_lt.mpr hLle)
    have hY0 : 0 < w y := hX0.trans hXY
    have hy0 : y ≠ 0 := (Valuation.ne_zero_iff w).mp hY0.ne'
    have hsq : w y ^ 2 = w x ^ 3 := by
      have hrest : w (W.a₁ * x * y + W.a₃ * y) < w (y ^ 2) := by
        rw [map_pow]
        refine lt_of_le_of_lt (Valuation.map_add_le w a1le
          (a3le.trans (le_mul_of_one_le_left' hx.le))) ?_
        rw [sq]; exact mul_lt_mul_of_pos_right hXY hY0
      have hL := Valuation.map_add_eq_of_lt_left w hrest
      rw [hE, hR, map_pow] at hL
      exact hL.symm
    refine ⟨hsq, ?_, ?_⟩
    · rw [map_div₀]
      exact (div_lt_one₀ hY0).mpr hXY
    · set c := W.a₁ * x + W.a₃ with hc
      have hNeq : W.toAffine.negY x y = -(y + c) := by
        rw [WeierstrassCurve.Affine.negY, hc]; ring
      have hcle : w c ≤ w x := by
        refine Valuation.map_add_le w ?_ (h₃.trans hx.le)
        rw [map_mul]; exact mul_le_of_le_one_left' h₁
      have hwN : w (W.toAffine.negY x y) = w y := by
        rw [hNeq, Valuation.map_neg, Valuation.map_add_eq_of_lt_left w (hcle.trans_lt hXY)]
      have hN0 : W.toAffine.negY x y ≠ 0 := (Valuation.ne_zero_iff w).mp (hwN ▸ hY0.ne')
      have hid : x / W.toAffine.negY x y + x / y = -(x * c) / (W.toAffine.negY x y * y) := by
        rw [div_add_div _ _ hN0 hy0]
        congr 1
        rw [hNeq]; ring
      rw [hid, map_div₀, map_div₀, Valuation.map_neg, map_mul, map_mul, hwN, div_pow, sq, sq,
        div_eq_mul_inv, div_eq_mul_inv]
      exact mul_le_mul_right' (mul_le_mul_left' hcle _) _

theorem weierstrass_E1_add_estimate {K : Type*} [Field K] [DecidableEq K] {Γ₀ : Type*}
    [LinearOrderedCommGroupWithZero Γ₀] (w : Valuation K Γ₀) (W : WeierstrassCurve K)
    (h₁ : w W.a₁ ≤ 1) (h₂ : w W.a₂ ≤ 1) (h₃ : w W.a₃ ≤ 1) (h₄ : w W.a₄ ≤ 1) (h₆ : w W.a₆ ≤ 1)
    {x₁ y₁ x₂ y₂ : K} (hP₁ : W.toAffine.Nonsingular x₁ y₁) (hP₂ : W.toAffine.Nonsingular x₂ y₂)
    (hx₁ : 1 < w x₁) (hx₂ : 1 < w x₂) (hne : ¬(x₁ = x₂ ∧ y₁ = W.toAffine.negY x₂ y₂)) :
    ∃ (x₃ y₃ : K) (hP₃ : W.toAffine.Nonsingular x₃ y₃),
      WeierstrassCurve.Affine.Point.some hP₁ + WeierstrassCurve.Affine.Point.some hP₂ =
        WeierstrassCurve.Affine.Point.some hP₃ ∧
      1 < w x₃ ∧ w (x₃ / y₃ - x₁ / y₁ - x₂ / y₂) ≤ max (w (x₁ / y₁)) (w (x₂ / y₂)) ^ 2 :=
by
  have hE₁ := hP₁.1
  have hE₂ := hP₂.1
  obtain ⟨hy1sq, ht1, -⟩ := (weierstrass_E1_basic w W h₁ h₂ h₃ h₄ h₆ hE₁).2 hx₁
  obtain ⟨hy2sq, ht2, -⟩ := (weierstrass_E1_basic w W h₁ h₂ h₃ h₄ h₆ hE₂).2 hx₂
  have ypos : ∀ {x y : K}, 1 < w x → w y ^ 2 = w x ^ 3 → y ≠ 0 := by
    intro x y hx hy h0
    rw [h0, map_zero, zero_pow two_ne_zero] at hy
    exact pow_ne_zero 3 (ne_of_gt (lt_trans zero_lt_one hx)) hy.symm
  have hy₁ := ypos hx₁ hy1sq
  have hy₂ := ypos hx₂ hy2sq
  have scube : ∀ {x y : K}, y ≠ 0 → w y ^ 2 = w x ^ 3 → w (1 / y) = w (x / y) ^ 3 := by
    intro x y hy h
    have hwy : w y ≠ 0 := (Valuation.ne_zero_iff w).mpr hy
    rw [map_div₀, map_div₀, map_one, div_pow, ← h, div_eq_div_iff hwy (pow_ne_zero 3 hwy)]
    rw [one_mul, pow_succ]
  have hs1 := scube hy₁ hy1sq
  have hs2 := scube hy₂ hy2sq
  have Gzero : ∀ {x y t s : K}, W.toAffine.Equation x y → y ≠ 0 → x = t * y → s * y = 1 →
      t ^ 3 + W.a₂ * t ^ 2 * s + W.a₄ * t * s ^ 2 + W.a₆ * s ^ 3 - s - W.a₁ * t * s
        - W.a₃ * s ^ 2 = 0 := by
    intro x y t s h hy ht hs
    have h' := (WeierstrassCurve.Affine.equation_iff x y).mp h
    obtain rfl : t = x / y := by rw [eq_div_iff hy]; exact ht.symm
    obtain rfl : s = 1 / y := by rw [eq_div_iff hy]; exact hs
    have key : ((x / y) ^ 3 + W.a₂ * (x / y) ^ 2 * (1 / y) + W.a₄ * (x / y) * (1 / y) ^ 2
        + W.a₆ * (1 / y) ^ 3 - 1 / y - W.a₁ * (x / y) * (1 / y) - W.a₃ * (1 / y) ^ 2) * y ^ 3 =
        -(y ^ 2 + W.a₁ * x * y + W.a₃ * y - (x ^ 3 + W.a₂ * x ^ 2 + W.a₄ * x + W.a₆)) := by
      field_simp
      ring
    have h0 : ((x / y) ^ 3 + W.a₂ * (x / y) ^ 2 * (1 / y) + W.a₄ * (x / y) * (1 / y) ^ 2
        + W.a₆ * (1 / y) ^ 3 - 1 / y - W.a₁ * (x / y) * (1 / y) - W.a₃ * (1 / y) ^ 2) * y ^ 3
        = 0 := by
      rw [key]; linear_combination -h'
    exact (mul_eq_zero.mp h0).resolve_right (pow_ne_zero 3 hy)
  refine ⟨W.toAffine.addX x₁ x₂ (W.toAffine.slope x₁ x₂ y₁ y₂),
    W.toAffine.addY x₁ x₂ y₁ (W.toAffine.slope x₁ x₂ y₁ y₂),
    WeierstrassCurve.Affine.nonsingular_add hP₁ hP₂ hne,
    WeierstrassCurve.Affine.Point.add_some hne, ?_⟩
  have hE₃ := WeierstrassCurve.Affine.equation_negAdd hE₁ hE₂ hne
  have hcase : (x₁ ≠ x₂ ∧ W.toAffine.slope x₁ x₂ y₁ y₂ * (x₁ - x₂) = y₁ - y₂) ∨
      (x₁ = x₂ ∧ y₁ = y₂ ∧ y₁ ≠ W.toAffine.negY x₁ y₁ ∧
        W.toAffine.slope x₁ x₂ y₁ y₂ * (y₁ - W.toAffine.negY x₁ y₁) =
          3 * x₁ ^ 2 + 2 * W.a₂ * x₁ + W.a₄ - W.a₁ * y₁) := by
    by_cases hx : x₁ = x₂
    · have hy : y₁ = y₂ := by
        rcases WeierstrassCurve.Affine.Y_eq_of_X_eq hE₁ hE₂ hx with h | h
        · exact h
        · exact absurd ⟨hx, h⟩ hne
      have hF : y₁ ≠ W.toAffine.negY x₁ y₁ := fun h => hne ⟨hx, by rw [← hx, ← hy]; exact h⟩
      refine Or.inr ⟨hx, hy, hF, ?_⟩
      have hF' : y₁ ≠ W.toAffine.negY x₂ y₂ := by rw [← hx, ← hy]; exact hF
      rw [WeierstrassCurve.Affine.slope_of_Y_ne hx hF', div_mul_cancel₀ _ (sub_ne_zero.mpr hF)]
    · refine Or.inl ⟨hx, ?_⟩
      rw [WeierstrassCurve.Affine.slope_of_X_ne hx, div_mul_cancel₀ _ (sub_ne_zero.mpr hx)]
  unfold WeierstrassCurve.Affine.addY
  have hx3e : W.toAffine.addX x₁ x₂ (W.toAffine.slope x₁ x₂ y₁ y₂) =
      (W.toAffine.slope x₁ x₂ y₁ y₂) ^ 2 + W.a₁ * W.toAffine.slope x₁ x₂ y₁ y₂ - W.a₂
        - x₁ - x₂ := rfl
  have hy3e : W.toAffine.negAddY x₁ x₂ y₁ (W.toAffine.slope x₁ x₂ y₁ y₂) =
      W.toAffine.slope x₁ x₂ y₁ y₂ * (W.toAffine.addX x₁ x₂ (W.toAffine.slope x₁ x₂ y₁ y₂)
        - x₁) + y₁ := rfl
  generalize W.toAffine.slope x₁ x₂ y₁ y₂ = ℓ at hcase hE₃ hx3e hy3e ⊢
  generalize W.toAffine.negAddY x₁ x₂ y₁ ℓ = y₃ at hE₃ hy3e ⊢
  generalize W.toAffine.addX x₁ x₂ ℓ = x₃ at hE₃ hx3e hy3e ⊢
  obtain ⟨ν, hν⟩ : ∃ ν, ν = y₁ - ℓ * x₁ := ⟨_, rfl⟩
  have hline1 : y₁ = ℓ * x₁ + ν := by rw [hν]; ring
  have hline2 : y₂ = ℓ * x₂ + ν := by
    rcases hcase with ⟨-, hsl⟩ | ⟨hx, hy, -, -⟩
    · linear_combination hsl - hν
    · rw [← hx, ← hy]; exact hline1
  have hy3line : y₃ = ℓ * x₃ + ν := by rw [hy3e, hν]; ring
  have hG1 := Gzero hE₁ hy₁ (div_mul_cancel₀ x₁ hy₁).symm (one_div_mul_cancel hy₁)
  have hG2 := Gzero hE₂ hy₂ (div_mul_cancel₀ x₂ hy₂).symm (one_div_mul_cancel hy₂)
  have ht₁ : x₁ = x₁ / y₁ * y₁ := (div_mul_cancel₀ x₁ hy₁).symm
  have ht₂ : x₂ = x₂ / y₂ * y₂ := (div_mul_cancel₀ x₂ hy₂).symm
  have hs₁ : 1 / y₁ * y₁ = 1 := one_div_mul_cancel hy₁
  have hs₂ : 1 / y₂ * y₂ = 1 := one_div_mul_cancel hy₂
  generalize x₁ / y₁ = t₁ at ht1 hs1 hG1 ht₁ ⊢
  generalize x₂ / y₂ = t₂ at ht2 hs2 hG2 ht₂ ⊢
  generalize 1 / y₁ = s₁ at hs1 hG1 hs₁
  generalize 1 / y₂ = s₂ at hs2 hG2 hs₂
  obtain ⟨r, hr⟩ : ∃ r, r = max (w t₁) (w t₂) := ⟨_, rfl⟩
  rw [← hr]
  have hr1 : r < 1 := by rw [hr]; exact max_lt ht1 ht2
  have hrle : r ≤ 1 := hr1.le
  have hwt1 : w t₁ ≤ r ^ 1 := by rw [pow_one, hr]; exact le_max_left _ _
  have hwt2 : w t₂ ≤ r ^ 1 := by rw [pow_one, hr]; exact le_max_right _ _
  have hws1 : w s₁ ≤ r ^ 3 := by
    rw [hs1]; exact pow_le_pow_left₀ zero_le' (by rw [hr]; exact le_max_left _ _) 3
  have hws2 : w s₂ ≤ r ^ 3 := by
    rw [hs2]; exact pow_le_pow_left₀ zero_le' (by rw [hr]; exact le_max_right _ _) 3
  have Vw : ∀ (k : ℕ) {a : K} {i : ℕ}, w a ≤ r ^ i → k ≤ i → w a ≤ r ^ k :=
    fun k a i ha hk => ha.trans (pow_le_pow_right_of_le_one' hrle hk)
  have Vm : ∀ (k : ℕ) {a b : K} {i j : ℕ}, w a ≤ r ^ i → w b ≤ r ^ j → k ≤ i + j →
      w (a * b) ≤ r ^ k := by
    intro k a b i j ha hb hk
    rw [map_mul]
    exact (mul_le_mul' ha hb).trans (by rw [← pow_add]; exact pow_le_pow_right_of_le_one' hrle hk)
  have Vp : ∀ (k : ℕ) {a : K} {i : ℕ} (n : ℕ), w a ≤ r ^ i → k ≤ i * n → w (a ^ n) ≤ r ^ k := by
    intro k a i n ha hk
    rw [map_pow]
    exact (pow_le_pow_left₀ zero_le' ha n).trans
      (by rw [← pow_mul]; exact pow_le_pow_right_of_le_one' hrle hk)
  have Va : ∀ {a b : K} {k : ℕ}, w a ≤ r ^ k → w b ≤ r ^ k → w (a + b) ≤ r ^ k :=
    fun ha hb => Valuation.map_add_le w ha hb
  have Vs : ∀ {a b : K} {k : ℕ}, w a ≤ r ^ k → w b ≤ r ^ k → w (a - b) ≤ r ^ k :=
    fun ha hb => Valuation.map_sub_le w ha hb
  have Vn : ∀ {a : K} {k : ℕ}, w a ≤ r ^ k → w (-a) ≤ r ^ k := fun ha => by
    rw [Valuation.map_neg]; exact ha
  have V0 : ∀ {a : K}, w a ≤ 1 → w a ≤ r ^ 0 := fun ha => by rw [pow_zero]; exact ha
  have w2 : w (2 : K) ≤ 1 := by
    have e : (2 : K) = 1 + 1 := by norm_num
    rw [e]; exact Valuation.map_add_le w (map_one w).le (map_one w).le
  have w3 : w (3 : K) ≤ 1 := by
    have e : (3 : K) = 1 + 1 + 1 := by norm_num
    rw [e]
    exact Valuation.map_add_le w (Valuation.map_add_le w (map_one w).le (map_one w).le)
      (map_one w).le
  have lineRel : ∀ {x y t s m b : K}, x = t * y → s * y = 1 → b * ν = 1 → ℓ = m * ν →
      y = ℓ * x + ν → b = s + m * t := by
    intro x y t s m b ht hs hb hℓm hl
    linear_combination (b * s) * (hl + x * hℓm + m * ν * ht) + (m * t - b) * hs +
      (m * t * s * y + s) * hb
  
  have hLD : ν ≠ 0 ∧ w (ℓ / ν) ≤ r ^ 2 := by
    rcases hcase with ⟨hx, hsl⟩ | ⟨hx, hy, hF, hsl⟩
    · obtain ⟨L, hL⟩ : ∃ L, L = 1 + (W.a₁ * t₂ + W.a₃ * (s₁ + s₂) - W.a₂ * t₂ ^ 2
          - W.a₄ * t₂ * (s₁ + s₂) - W.a₆ * (s₁ ^ 2 + s₁ * s₂ + s₂ ^ 2)) := ⟨_, rfl⟩
      obtain ⟨R, hR⟩ : ∃ R, R = t₁ ^ 2 + t₁ * t₂ + t₂ ^ 2 + W.a₂ * s₁ * (t₁ + t₂)
          + W.a₄ * s₁ ^ 2 - W.a₁ * s₁ := ⟨_, rfl⟩
      have hdiff : (s₂ - s₁) * L = (t₂ - t₁) * R := by
        rw [hL, hR]; linear_combination hG1 - hG2
      have hwL : w L = 1 := by
        rw [hL]; apply Valuation.map_one_add_of_lt
        refine lt_of_le_of_lt (?_ : _ ≤ r ^ 1) (by rwa [pow_one])
        exact Vs (Vs (Vs (Va (Vm 1 (V0 h₁) hwt2 (by norm_num))
          (Vm 1 (V0 h₃) (Va (Vw 1 hws1 (by norm_num)) (Vw 1 hws2 (by norm_num))) (by norm_num)))
          (Vm 1 (V0 h₂) (Vp 2 2 hwt2 (by norm_num)) (by norm_num)))
          (Vm 1 (Vm 1 (V0 h₄) hwt2 (by norm_num))
            (Va (Vw 1 hws1 (by norm_num)) (Vw 1 hws2 (by norm_num))) (by norm_num)))
          (Vm 1 (V0 h₆) (Va (Va (Vp 1 2 hws1 (by norm_num)) (Vm 1 hws1 hws2 (by norm_num)))
            (Vp 1 2 hws2 (by norm_num))) (by norm_num))
      have hL0 : L ≠ 0 := fun h => by rw [h, map_zero] at hwL; exact zero_ne_one hwL
      have hwR : w R ≤ r ^ 2 := by
        rw [hR]
        exact Vs (Va (Va (Va (Va (Vp 2 2 hwt1 (by norm_num)) (Vm 2 hwt1 hwt2 (by norm_num)))
          (Vp 2 2 hwt2 (by norm_num)))
          (Vm 2 (Vm 3 (V0 h₂) hws1 (by norm_num)) (Va hwt1 hwt2) (by norm_num)))
          (Vm 2 (V0 h₄) (Vp 6 2 hws1 (by norm_num)) (by norm_num)))
          (Vm 2 (V0 h₁) hws1 (by norm_num))
      have htne : t₁ ≠ t₂ := by
        intro heq
        have h0 : (s₂ - s₁) * L = 0 := by rw [hdiff, heq, sub_self, zero_mul]
        have hss : s₂ = s₁ := sub_eq_zero.mp ((mul_eq_zero.mp h0).resolve_right hL0)
        have hyy : y₁ = y₂ := by linear_combination (-y₁) * hs₂ + y₂ * hs₁ + y₁ * y₂ * hss
        exact hx (by linear_combination ht₁ - ht₂ + y₁ * heq + t₂ * hyy)
      have hν0 : ν ≠ 0 := by
        intro h0
        have : y₁ * y₂ * (t₁ - t₂) = 0 := by
          linear_combination (x₁ - x₂) * h0 - (x₁ - x₂) * hν + x₁ * hsl - y₂ * ht₁ + y₁ * ht₂
        rcases mul_eq_zero.mp this with h | h
        · exact mul_ne_zero hy₁ hy₂ h
        · exact htne (sub_eq_zero.mp h)
      refine ⟨hν0, ?_⟩
      have hℓm : ℓ = ℓ / ν * ν := (div_mul_cancel₀ ℓ hν0).symm
      have hbν : 1 / ν * ν = 1 := one_div_mul_cancel hν0
      have L1 := lineRel ht₁ hs₁ hbν hℓm hline1
      have L2 := lineRel ht₂ hs₂ hbν hℓm hline2
      have hz : (t₁ - t₂) * (ℓ / ν * L + R) = 0 := by
        linear_combination L * L2 - L * L1 + hdiff
      have hmL : ℓ / ν * L = -R := by
        have := (mul_eq_zero.mp hz).resolve_left (sub_ne_zero.mpr htne)
        linear_combination this
      have hh : w (ℓ / ν) * w L = w R := by rw [← map_mul, hmL, Valuation.map_neg]
      rw [hwL, mul_one] at hh
      rw [hh]; exact hwR
    · obtain ⟨P, hP⟩ : ∃ P, P = 3 * t₁ ^ 2 + 2 * W.a₂ * t₁ * s₁ + W.a₄ * s₁ ^ 2 - W.a₁ * s₁ :=
        ⟨_, rfl⟩
      obtain ⟨Q, hQ⟩ : ∃ Q, Q = -(1 + (W.a₁ * t₁ + 2 * W.a₃ * s₁ - W.a₂ * t₁ ^ 2
          - 2 * W.a₄ * t₁ * s₁ - 3 * W.a₆ * s₁ ^ 2)) := ⟨_, rfl⟩
      have hwQ : w Q = 1 := by
        rw [hQ, Valuation.map_neg]; apply Valuation.map_one_add_of_lt
        refine lt_of_le_of_lt (?_ : _ ≤ r ^ 1) (by rwa [pow_one])
        exact Vs (Vs (Vs (Va (Vm 1 (V0 h₁) hwt1 (by norm_num))
          (Vm 1 (Vm 0 (V0 w2) (V0 h₃) (by norm_num)) hws1 (by norm_num)))
          (Vm 1 (V0 h₂) (Vp 2 2 hwt1 (by norm_num)) (by norm_num)))
          (Vm 1 (Vm 1 (Vm 0 (V0 w2) (V0 h₄) (by norm_num)) hwt1 (by norm_num)) hws1
            (by norm_num)))
          (Vm 1 (Vm 0 (V0 w3) (V0 h₆) (by norm_num)) (Vp 6 2 hws1 (by norm_num)) (by norm_num))
      have hQ0 : Q ≠ 0 := fun h => by rw [h, map_zero] at hwQ; exact zero_ne_one hwQ
      have hwP : w P ≤ r ^ 2 := by
        rw [hP]
        exact Vs (Va (Va (Vm 2 (V0 w3) (Vp 2 2 hwt1 (by norm_num)) (by norm_num))
          (Vm 2 (Vm 1 (Vm 0 (V0 w2) (V0 h₂) (by norm_num)) hwt1 (by norm_num)) hws1
            (by norm_num)))
          (Vm 2 (V0 h₄) (Vp 6 2 hws1 (by norm_num)) (by norm_num)))
          (Vm 2 (V0 h₁) hws1 (by norm_num))
      have hΦ : Q * s₁ + P * t₁ = s₁ * (2 + W.a₁ * t₁ + W.a₃ * s₁) := by
        rw [hQ, hP]; linear_combination 3 * hG1
      have hΦF : s₁ * (2 + W.a₁ * t₁ + W.a₃ * s₁) * y₁ ^ 2 = y₁ - W.toAffine.negY x₁ y₁ := by
        rw [WeierstrassCurve.Affine.negY]
        linear_combination (2 * y₁ + W.a₁ * t₁ * y₁ + W.a₃ * (s₁ * y₁ + 1)) * hs₁ - W.a₁ * ht₁
      have hPM : P * y₁ ^ 2 = 3 * x₁ ^ 2 + 2 * W.a₂ * x₁ + W.a₄ - W.a₁ * y₁ := by
        rw [hP]
        linear_combination (2 * W.a₂ * t₁ * y₁ + W.a₄ * (s₁ * y₁ + 1) - W.a₁ * y₁) * hs₁ +
          (-3 * (x₁ + t₁ * y₁) - 2 * W.a₂) * ht₁
      have hℓΦ : ℓ * (s₁ * (2 + W.a₁ * t₁ + W.a₃ * s₁)) = P := by
        have h0 : (ℓ * (s₁ * (2 + W.a₁ * t₁ + W.a₃ * s₁)) - P) * y₁ ^ 2 = 0 := by
          linear_combination ℓ * hΦF + hsl - hPM
        exact sub_eq_zero.mp ((mul_eq_zero.mp h0).resolve_right (pow_ne_zero 2 hy₁))
      have hνΦ : ν * (s₁ * (2 + W.a₁ * t₁ + W.a₃ * s₁)) = Q := by
        linear_combination (s₁ * (2 + W.a₁ * t₁ + W.a₃ * s₁)) * hν - x₁ * hℓΦ + Q * hs₁
          - P * ht₁ - y₁ * hΦ
      have hν0 : ν ≠ 0 := fun h => hQ0 (by rw [← hνΦ, h, zero_mul])
      refine ⟨hν0, ?_⟩
      have hmQ : ℓ / ν * Q = P := by
        rw [← hνΦ, ← mul_assoc, div_mul_cancel₀ _ hν0, hℓΦ]
      have hh : w (ℓ / ν) * w Q = w P := by rw [← map_mul, hmQ]
      rw [hwQ, mul_one] at hh
      rw [hh]; exact hwP
  obtain ⟨hν0, hwm⟩ := hLD
  generalize hm : ℓ / ν = m at hwm
  have hℓm : ℓ = m * ν := by rw [← hm, div_mul_cancel₀ _ hν0]
  obtain ⟨b, hb⟩ : ∃ b, b = 1 / ν := ⟨_, rfl⟩
  have hbν : b * ν = 1 := by rw [hb, one_div_mul_cancel hν0]
  have L1 := lineRel ht₁ hs₁ hbν hℓm hline1
  have hwb : w b ≤ r ^ 3 := by rw [L1]; exact Va hws1 (Vm 3 hwm hwt1 (by norm_num))
  have vieta : ∀ (X1 X2 l n X3 : K), X3 = l ^ 2 + W.a₁ * l - W.a₂ - X1 - X2 →
      (l * X1 + n) ^ 2 + W.a₁ * X1 * (l * X1 + n) + W.a₃ * (l * X1 + n) =
        X1 ^ 3 + W.a₂ * X1 ^ 2 + W.a₄ * X1 + W.a₆ →
      ((X1 - X2 ≠ 0 ∧ (l * X2 + n) ^ 2 + W.a₁ * X2 * (l * X2 + n) + W.a₃ * (l * X2 + n) =
          X2 ^ 3 + W.a₂ * X2 ^ 2 + W.a₄ * X2 + W.a₆) ∨
        (X2 = X1 ∧ l * (2 * (l * X1 + n) + W.a₁ * X1 + W.a₃) =
          3 * X1 ^ 2 + 2 * W.a₂ * X1 + W.a₄ - W.a₁ * (l * X1 + n))) →
      (l * X1 + n) * (l * X2 + n) * (l * X3 + n) =
          n ^ 3 - W.a₂ * l * n ^ 2 + W.a₄ * l ^ 2 * n - W.a₆ * l ^ 3 ∧
        X1 * (l * X2 + n) * (l * X3 + n) + X2 * (l * X1 + n) * (l * X3 + n) +
          X3 * (l * X1 + n) * (l * X2 + n) =
          W.a₃ * l ^ 2 * n - 3 * W.a₆ * l ^ 2 - W.a₁ * l * n ^ 2 + 2 * W.a₄ * l * n
            - W.a₂ * n ^ 2 := by
    intro X1 X2 l n X3 hX3 e1 hc
    subst hX3
    have hα : (2 * l * n + W.a₁ * n + W.a₃ * l - W.a₄) + (X1 * X2
        + X1 * (l ^ 2 + W.a₁ * l - W.a₂ - X1 - X2)
        + X2 * (l ^ 2 + W.a₁ * l - W.a₂ - X1 - X2)) = 0 := by
      rcases hc with ⟨hne', e2⟩ | ⟨rfl, hsl⟩
      · have h0 : (X1 - X2) * ((2 * l * n + W.a₁ * n + W.a₃ * l - W.a₄) + (X1 * X2
            + X1 * (l ^ 2 + W.a₁ * l - W.a₂ - X1 - X2)
            + X2 * (l ^ 2 + W.a₁ * l - W.a₂ - X1 - X2))) = 0 := by
          linear_combination e1 - e2
        exact (mul_eq_zero.mp h0).resolve_left hne'
      · linear_combination hsl
    have hβ : (n ^ 2 + W.a₃ * n - W.a₆) - X1 * X2 * (l ^ 2 + W.a₁ * l - W.a₂ - X1 - X2) = 0 := by
      linear_combination e1 - X1 * hα
    constructor
    · linear_combination (-l ^ 3) * hβ + l ^ 2 * n * hα
    · linear_combination (-3 * l ^ 2) * hβ + 2 * l * n * hα
  have e1 := (WeierstrassCurve.Affine.equation_iff x₁ y₁).mp hE₁
  have e2 := (WeierstrassCurve.Affine.equation_iff x₂ y₂).mp hE₂
  obtain ⟨hD, hN⟩ := vieta x₁ x₂ ℓ ν x₃ hx3e (by rw [← hline1]; linear_combination e1) (by
    rcases hcase with ⟨hx, -⟩ | ⟨hx, hy, -, hsl⟩
    · exact Or.inl ⟨sub_ne_zero.mpr hx, by rw [← hline2]; linear_combination e2⟩
    · refine Or.inr ⟨hx.symm, ?_⟩
      rw [WeierstrassCurve.Affine.negY] at hsl
      rw [← hline1]; linear_combination hsl)
  rw [← hline1, ← hline2, ← hy3line] at hD hN
  obtain ⟨A, hA⟩ : ∃ A, A = 1 + (-(W.a₂ * m) + W.a₄ * m ^ 2 - W.a₆ * m ^ 3) := ⟨_, rfl⟩
  obtain ⟨B', hB'⟩ : ∃ B', B' = W.a₃ * m ^ 2 - 3 * W.a₆ * m ^ 2 * b - W.a₁ * m
      + 2 * W.a₄ * m * b - W.a₂ * b := ⟨_, rfl⟩
  have hDA : y₁ * y₂ * y₃ = ν ^ 3 * A := by rw [hD, hA, hℓm]; ring
  have hNB : x₁ * y₂ * y₃ + x₂ * y₁ * y₃ + x₃ * y₁ * y₂ = ν ^ 3 * B' := by
    rw [hN, hB', hℓm]
    linear_combination (3 * W.a₆ * m ^ 2 * ν ^ 2 - 2 * W.a₄ * m * ν ^ 2 + W.a₂ * ν ^ 2) * hbν
  have hwA : w A = 1 := by
    rw [hA]; apply Valuation.map_one_add_of_lt
    refine lt_of_le_of_lt (?_ : _ ≤ r ^ 1) (by rwa [pow_one])
    exact Vs (Va (Vn (Vm 1 (V0 h₂) hwm (by norm_num)))
      (Vm 1 (V0 h₄) (Vp 4 2 hwm (by norm_num)) (by norm_num)))
      (Vm 1 (V0 h₆) (Vp 6 3 hwm (by norm_num)) (by norm_num))
  have hwB : w B' ≤ r ^ 2 := by
    rw [hB']
    exact Vs (Va (Vs (Vs (Vm 2 (V0 h₃) (Vp 4 2 hwm (by norm_num)) (by norm_num))
      (Vm 2 (Vm 4 (Vm 0 (V0 w3) (V0 h₆) (by norm_num)) (Vp 4 2 hwm (by norm_num))
        (by norm_num)) hwb (by norm_num)))
      (Vm 2 (V0 h₁) hwm (by norm_num)))
      (Vm 2 (Vm 2 (Vm 0 (V0 w2) (V0 h₄) (by norm_num)) hwm (by norm_num)) hwb (by norm_num)))
      (Vm 2 (V0 h₂) hwb (by norm_num))
  have hA0 : A ≠ 0 := fun h => by rw [h, map_zero] at hwA; exact zero_ne_one hwA
  have hy₃ : y₃ ≠ 0 := by
    intro h; rw [h, mul_zero] at hDA
    exact mul_ne_zero (pow_ne_zero 3 hν0) hA0 hDA.symm
  obtain ⟨t₃, ht₃d⟩ : ∃ t, t = x₃ / y₃ := ⟨_, rfl⟩
  have ht₃ : x₃ = t₃ * y₃ := by rw [ht₃d, div_mul_cancel₀ _ hy₃]
  have hS : (t₁ + t₂ + t₃) * A = B' := by
    have h0 : ν ^ 3 * ((t₁ + t₂ + t₃) * A - B') = 0 := by
      linear_combination (-(t₁ + t₂ + t₃)) * hDA + hNB +
        ((-(y₂ * y₃)) * ht₁ - (y₁ * y₃) * ht₂ - (y₁ * y₂) * ht₃)
    exact sub_eq_zero.mp ((mul_eq_zero.mp h0).resolve_left (pow_ne_zero 3 hν0))
  have hwS : w (t₁ + t₂ + t₃) ≤ r ^ 2 := by
    have hh : w (t₁ + t₂ + t₃) * w A = w B' := by rw [← map_mul, hS]
    rw [hwA, mul_one] at hh; rw [hh]; exact hwB
  have hwt3 : w t₃ ≤ r ^ 1 := by
    rw [show t₃ = (t₁ + t₂ + t₃) - t₁ - t₂ by ring]
    exact Vs (Vs (Vw 1 hwS (by norm_num)) hwt1) hwt2
  have hprod : y₃ * (b - m * t₃) = 1 := by
    linear_combination b * (hy3line + x₃ * hℓm + m * ν * ht₃) + (m * t₃ * y₃ + 1) * hbν
  have hwbt : w (b - m * t₃) < 1 :=
    (Vw 1 (Vs hwb (Vm 3 hwm hwt3 (by norm_num))) (by norm_num)).trans_lt (by rwa [pow_one])
  have hy3big : 1 < w y₃ := by
    by_contra hle
    push_neg at hle
    have h1 : w y₃ * w (b - m * t₃) = 1 := by rw [← map_mul, hprod, map_one]
    have h2 : w y₃ * w (b - m * t₃) ≤ 1 * w (b - m * t₃) := mul_le_mul_right' hle _
    rw [h1, one_mul] at h2
    exact absurd hwbt (not_lt.mpr h2)
  have hx3big : 1 < w x₃ := by
    by_contra hle
    push_neg at hle
    exact absurd ((weierstrass_E1_basic w W h₁ h₂ h₃ h₄ h₆ hE₃).1 hle) (not_le.mpr hy3big)
  obtain ⟨-, -, hneg⟩ := (weierstrass_E1_basic w W h₁ h₂ h₃ h₄ h₆ hE₃).2 hx3big
  rw [← ht₃d] at hneg
  refine ⟨hx3big, ?_⟩
  have hwt3' : w t₃ ≤ r := by rw [← pow_one r]; exact hwt3
  have key : w ((x₃ / W.toAffine.negY x₃ y₃ + t₃) - (t₁ + t₂ + t₃)) ≤ r ^ 2 :=
    Vs (hneg.trans (pow_le_pow_left₀ zero_le' hwt3' 2)) hwS
  have e : (x₃ / W.toAffine.negY x₃ y₃ + t₃) - (t₁ + t₂ + t₃) =
      x₃ / W.toAffine.negY x₃ y₃ - t₁ - t₂ := by ring
  rw [e] at key
  exact key

theorem weierstrass_sub_eq_zero_or_one_lt_of_close {K : Type*} [Field K] [DecidableEq K]
    {Γ₀ : Type*} [LinearOrderedCommGroupWithZero Γ₀] (w : Valuation K Γ₀) (W : WeierstrassCurve K)
    (h₁ : w W.a₁ ≤ 1) (h₂ : w W.a₂ ≤ 1) (h₃ : w W.a₃ ≤ 1) (h₄ : w W.a₄ ≤ 1) (h₆ : w W.a₆ ≤ 1)
    (hΔ : w W.Δ = 1) {x₁ y₁ x₂ y₂ : K} (hP₁ : W.toAffine.Nonsingular x₁ y₁)
    (hP₂ : W.toAffine.Nonsingular x₂ y₂) (hx₁ : w x₁ ≤ 1) (hy₁ : w y₁ ≤ 1) (hx₂ : w x₂ ≤ 1)
    (hy₂ : w y₂ ≤ 1) (hx : w (x₂ - x₁) < 1) (hy : w (y₂ - y₁) < 1) :
    WeierstrassCurve.Affine.Point.some hP₂ - WeierstrassCurve.Affine.Point.some hP₁ = 0 ∨
      ∃ (x₃ y₃ : K) (hP₃ : W.toAffine.Nonsingular x₃ y₃),
        WeierstrassCurve.Affine.Point.some hP₂ - WeierstrassCurve.Affine.Point.some hP₁ =
          WeierstrassCurve.Affine.Point.some hP₃ ∧ 1 < w x₃ :=
by
  
  have iadd : ∀ {a b : K}, w a ≤ 1 → w b ≤ 1 → w (a + b) ≤ 1 := fun ha hb =>
    (Valuation.map_add _ _ _).trans (max_le ha hb)
  have isub : ∀ {a b : K}, w a ≤ 1 → w b ≤ 1 → w (a - b) ≤ 1 := fun ha hb =>
    (Valuation.map_sub _ _ _).trans (max_le ha hb)
  have imul : ∀ {a b : K}, w a ≤ 1 → w b ≤ 1 → w (a * b) ≤ 1 := by
    intro a b ha hb; rw [map_mul]; exact mul_le_one' ha hb
  have ipow : ∀ {a : K} (n : ℕ), w a ≤ 1 → w (a ^ n) ≤ 1 := by
    intro a n ha; rw [map_pow]; exact pow_le_one' ha n
  have inat : ∀ n : ℕ, w (n : K) ≤ 1 := by
    intro n
    induction n with
    | zero => rw [Nat.cast_zero, map_zero]; exact zero_le'
    | succ n ih =>
      rw [Nat.cast_succ]
      exact iadd ih (by rw [map_one])
  have i2 : w (2 : K) ≤ 1 := by simpa using inat 2
  have i3 : w (3 : K) ≤ 1 := by simpa using inat 3
  have i4 : w (4 : K) ≤ 1 := by simpa using inat 4
  have i8 : w (8 : K) ≤ 1 := by simpa using inat 8
  have i9 : w (9 : K) ≤ 1 := by simpa using inat 9
  have i27 : w (27 : K) ≤ 1 := by simpa using inat 27
  have sadd : ∀ {a b : K}, w a < 1 → w b < 1 → w (a + b) < 1 := fun ha hb =>
    Valuation.map_add_lt w ha hb
  have ssub : ∀ {a b : K}, w a < 1 → w b < 1 → w (a - b) < 1 := fun ha hb =>
    (Valuation.map_sub _ _ _).trans_lt (max_lt ha hb)
  have smul : ∀ {a b : K}, w a ≤ 1 → w b < 1 → w (a * b) < 1 := by
    intro a b ha hb; rw [map_mul]; exact (mul_le_of_le_one_left' ha).trans_lt hb
  have smul' : ∀ {a b : K}, w a < 1 → w b ≤ 1 → w (a * b) < 1 := by
    intro a b ha hb; rw [mul_comm]; exact smul hb ha
  have sneg : ∀ {a : K}, w a < 1 → w (-a) < 1 := by
    intro a ha; rwa [Valuation.map_neg]
  have ssq : ∀ {a : K}, w a < 1 → w (a ^ 2) < 1 := by
    intro a ha; rw [sq]; exact smul ha.le ha
  
  have Δsmall : ∀ V : WeierstrassCurve K, w V.a₁ ≤ 1 → w V.a₂ ≤ 1 → w V.a₃ < 1 →
      w V.a₄ < 1 → w V.a₆ < 1 → w V.Δ < 1 := by
    intro V g₁ g₂ g₃ g₄ g₆
    have b2 : w V.b₂ ≤ 1 := by
      show w (V.a₁ ^ 2 + 4 * V.a₂) ≤ 1
      exact iadd (ipow 2 g₁) (imul i4 g₂)
    have b4 : w V.b₄ < 1 := by
      show w (2 * V.a₄ + V.a₁ * V.a₃) < 1
      exact sadd (smul i2 g₄) (smul g₁ g₃)
    have b6 : w V.b₆ < 1 := by
      show w (V.a₃ ^ 2 + 4 * V.a₆) < 1
      exact sadd (ssq g₃) (smul i4 g₆)
    have b8 : w V.b₈ < 1 := by
      show w (V.a₁ ^ 2 * V.a₆ + 4 * V.a₂ * V.a₆ - V.a₁ * V.a₃ * V.a₄ + V.a₂ * V.a₃ ^ 2
        - V.a₄ ^ 2) < 1
      exact ssub (sadd (ssub (sadd (smul (ipow 2 g₁) g₆) (smul (imul i4 g₂) g₆))
        (smul (imul g₁ g₃.le) g₄)) (smul g₂ (ssq g₃))) (ssq g₄)
    have e : V.Δ = -(V.b₂ ^ 2 * V.b₈) - 8 * V.b₄ ^ 2 * V.b₄ - 27 * V.b₆ * V.b₆
        + 9 * V.b₂ * V.b₆ * V.b₄ := by
      unfold WeierstrassCurve.Δ; ring
    rw [e]
    exact sadd (ssub (ssub (sneg (smul (ipow 2 b2) b8)) (smul (imul i8 (ipow 2 b4.le)) b4))
      (smul (imul i27 b6.le) b6)) (smul (imul (imul i9 b2) b6.le) b4)
  
  have s1 : ∀ {x y : K}, W.toAffine.Equation x y → w x ≤ 1 → w y ≤ 1 →
      w (2 * y + W.a₁ * x + W.a₃) < 1 →
        w (3 * x ^ 2 + 2 * W.a₂ * x + W.a₄ - W.a₁ * y) = 1 := by
    intro x y hE hx hy hF
    refine le_antisymm (isub (iadd (iadd (imul i3 (ipow 2 hx)) (imul (imul i2 h₂) hx)) h₄)
      (imul h₁ hy)) (not_lt.mp fun hG => ?_)
    have hE' : y ^ 2 + W.a₁ * x * y + W.a₃ * y = x ^ 3 + W.a₂ * x ^ 2 + W.a₄ * x + W.a₆ :=
      (WeierstrassCurve.Affine.equation_iff x y).mp hE
    let C : WeierstrassCurve.VariableChange K := ⟨1, x, 0, y⟩
    have hu : ((C.u⁻¹ : Kˣ) : K) = 1 := by simp [C]
    have hr : C.r = x := rfl
    have hs : C.s = 0 := rfl
    have ht : C.t = y := rfl
    have e1 : (C • W).a₁ = W.a₁ := by
      rw [WeierstrassCurve.variableChange_a₁, hu, hs]; ring
    have e2 : (C • W).a₂ = W.a₂ + 3 * x := by
      rw [WeierstrassCurve.variableChange_a₂, hu, hs, hr]; ring
    have e3 : (C • W).a₃ = 2 * y + W.a₁ * x + W.a₃ := by
      rw [WeierstrassCurve.variableChange_a₃, hu, hr, ht]; ring
    have e4 : (C • W).a₄ = 3 * x ^ 2 + 2 * W.a₂ * x + W.a₄ - W.a₁ * y := by
      rw [WeierstrassCurve.variableChange_a₄, hu, hs, hr, ht]; ring
    have e6 : (C • W).a₆ = 0 := by
      rw [WeierstrassCurve.variableChange_a₆, hu, hr, ht]
      linear_combination (-1 : K) * hE'
    have eΔ : (C • W).Δ = W.Δ := by
      rw [WeierstrassCurve.variableChange_Δ, hu]; ring
    have hlt := Δsmall (C • W) (by rw [e1]; exact h₁) (by rw [e2]; exact iadd h₂ (imul i3 hx))
      (by rw [e3]; exact hF) (by rw [e4]; exact hG) (by rw [e6, map_zero]; exact zero_lt_one)
    rw [eΔ, hΔ] at hlt
    exact lt_irrefl _ hlt
  
  have s2 : ∀ {u v ℓ : K}, w u ≤ 1 → w v ≤ 1 → 1 < w ℓ → 1 < w (W.toAffine.addX u v ℓ) := by
    intro u v ℓ hu hv hℓ
    have e : W.toAffine.addX u v ℓ = ℓ * (ℓ + W.a₁) + (-W.a₂ - u - v) := by
      unfold WeierstrassCurve.Affine.addX; ring
    have e1 : w (ℓ + W.a₁) = w ℓ := Valuation.map_add_eq_of_lt_left w (h₁.trans_lt hℓ)
    have e2 : 1 < w (ℓ * (ℓ + W.a₁)) := by
      rw [map_mul, e1]; exact hℓ.trans_le (le_mul_of_one_le_right' hℓ.le)
    have e3 : w (-W.a₂ - u - v) ≤ 1 := isub (isub (by rw [Valuation.map_neg]; exact h₂) hu) hv
    rw [e, Valuation.map_add_eq_of_lt_left w (e3.trans_lt e2)]
    exact e2
  
  have hP : ∀ {ℓ z : K}, w ℓ * w z = 1 → w z < 1 → 1 < w ℓ := by
    intro ℓ z h hz
    by_contra hle
    push_neg at hle
    have h' := mul_le_of_le_one_left' (a := w z) hle
    rw [h] at h'
    exact lt_irrefl _ (h'.trans_lt hz)
  
  have h₁' : W.toAffine.Nonsingular x₁ (W.toAffine.negY x₁ y₁) :=
    (WeierstrassCurve.Affine.nonsingular_neg x₁ y₁).mpr hP₁
  have hneg : -WeierstrassCurve.Affine.Point.some hP₁ = WeierstrassCurve.Affine.Point.some h₁' :=
    WeierstrassCurve.Affine.Point.neg_some hP₁
  rw [sub_eq_add_neg, hneg]
  by_cases hc : x₂ = x₁ ∧ y₂ = W.toAffine.negY x₁ (W.toAffine.negY x₁ y₁)
  · left; exact WeierstrassCurve.Affine.Point.add_of_Y_eq hc.1 hc.2
  right
  rw [WeierstrassCurve.Affine.Point.add_some hc]
  refine ⟨_, _, _, rfl, ?_⟩
  apply s2 hx₂ hx₁
  have hE₁ : y₁ ^ 2 + W.a₁ * x₁ * y₁ + W.a₃ * y₁ = x₁ ^ 3 + W.a₂ * x₁ ^ 2 + W.a₄ * x₁ + W.a₆ :=
    (WeierstrassCurve.Affine.equation_iff x₁ y₁).mp hP₁.1
  have hE₂ : y₂ ^ 2 + W.a₁ * x₂ * y₂ + W.a₃ * y₂ = x₂ ^ 3 + W.a₂ * x₂ ^ 2 + W.a₄ * x₂ + W.a₆ :=
    (WeierstrassCurve.Affine.equation_iff x₂ y₂).mp hP₂.1
  by_cases hxe : x₂ = x₁
  · 
    have hyne : y₂ ≠ y₁ := by
      intro h; exact hc ⟨hxe, by rw [WeierstrassCurve.Affine.negY_negY]; exact h⟩
    have hy2 : y₂ = W.toAffine.negY x₁ y₁ :=
      (WeierstrassCurve.Affine.Y_eq_of_X_eq hP₂.1 hP₁.1 hxe).resolve_left hyne
    have hy' : y₂ ≠ W.toAffine.negY x₁ (W.toAffine.negY x₁ y₁) := by
      rw [WeierstrassCurve.Affine.negY_negY]; exact hyne
    rw [WeierstrassCurve.Affine.slope_of_Y_ne hxe hy']
    have hden : y₂ - W.toAffine.negY x₂ y₂ = y₂ - y₁ := by
      have h2 : y₂ = -y₁ - W.a₁ * x₁ - W.a₃ := hy2
      rw [hxe]; unfold WeierstrassCurve.Affine.negY; rw [h2]; ring
    have hFy : w (2 * y₂ + W.a₁ * x₂ + W.a₃) < 1 := by
      have e : 2 * y₂ + W.a₁ * x₂ + W.a₃ = y₂ - W.toAffine.negY x₂ y₂ := by
        unfold WeierstrassCurve.Affine.negY; ring
      rw [e, hden]; exact hy
    have hG := s1 hP₂.1 hx₂ hy₂ hFy
    have hd0 : y₂ - W.toAffine.negY x₂ y₂ ≠ 0 := by rw [hden]; exact sub_ne_zero.mpr hyne
    apply hP (z := y₂ - W.toAffine.negY x₂ y₂)
    · rw [← map_mul, div_mul_cancel₀ _ hd0]; exact hG
    · rw [hden]; exact hy
  · 
    have hd : x₂ - x₁ ≠ 0 := sub_ne_zero.mpr hxe
    have hI : W.toAffine.slope x₂ x₁ y₂ (W.toAffine.negY x₁ y₁) * (x₂ - x₁) =
        (y₂ - y₁) + (2 * y₁ + W.a₁ * x₁ + W.a₃) := by
      rw [WeierstrassCurve.Affine.slope_of_X_ne hxe, div_mul_cancel₀ _ hd]
      unfold WeierstrassCurve.Affine.negY; ring
    have hII : W.toAffine.slope x₂ x₁ y₂ (W.toAffine.negY x₁ y₁) *
        ((y₂ - y₁) + W.a₁ * (x₂ - x₁)) =
        (3 * x₁ ^ 2 + 2 * W.a₂ * x₁ + W.a₄ - W.a₁ * y₁) +
          (W.a₁ * (2 * y₁ + W.a₁ * x₁ + W.a₃) + (x₂ - x₁) * (x₂ + 2 * x₁ + W.a₂)) := by
      apply mul_left_cancel₀ hd
      linear_combination ((y₂ - y₁) + W.a₁ * (x₂ - x₁)) * hI + hE₂ - hE₁
    have hF1 : w (2 * y₁ + W.a₁ * x₁ + W.a₃) ≤ 1 := iadd (iadd (imul i2 hy₁) (imul h₁ hx₁)) h₃
    by_cases hF : w (2 * y₁ + W.a₁ * x₁ + W.a₃) < 1
    · have hG := s1 hP₁.1 hx₁ hy₁ hF
      have hsm : w (W.a₁ * (2 * y₁ + W.a₁ * x₁ + W.a₃) +
          (x₂ - x₁) * (x₂ + 2 * x₁ + W.a₂)) < 1 :=
        sadd (smul h₁ hF) (smul' hx (iadd (iadd hx₂ (imul i2 hx₁)) h₂))
      apply hP (z := (y₂ - y₁) + W.a₁ * (x₂ - x₁))
      · rw [← map_mul, hII, Valuation.map_add_eq_of_lt_left w (hsm.trans_le hG.ge), hG]
      · exact sadd hy (smul h₁ hx)
    · have hF' : w (2 * y₁ + W.a₁ * x₁ + W.a₃) = 1 := le_antisymm hF1 (not_lt.mp hF)
      apply hP (z := x₂ - x₁)
      · rw [← map_mul, hI, Valuation.map_add_eq_of_lt_right w (hy.trans_le hF'.ge), hF']
      · exact hx

theorem galHom_eq_self_of_mem_inertia_of_goodModel (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F] (E : WeierstrassCurve F)
    (hE : ∃ C : WeierstrassCurve.VariableChange F,
      ValuativeRel.valuation F (C • E).a₁ ≤ 1 ∧ ValuativeRel.valuation F (C • E).a₂ ≤ 1 ∧
      ValuativeRel.valuation F (C • E).a₃ ≤ 1 ∧ ValuativeRel.valuation F (C • E).a₄ ≤ 1 ∧
      ValuativeRel.valuation F (C • E).a₆ ≤ 1 ∧ ValuativeRel.valuation F (C • E).Δ = 1)
    (σ : EllipticRootNumber.AbsGal F) (hσ : σ ∈ EllipticRootNumber.inertia F)
    (m : ℕ) (hm0 : 0 < m) (hm : Nat.Coprime m (EllipticRootNumber.p F))
    (P : EllipticRootNumber.Pts F E) (hP : P ∈ EllipticRootNumber.torsion F E m) :
    EllipticRootNumber.galHom F E σ P = P :=
by
  classical
  obtain ⟨C, h₁, h₂, h₃, h₄, h₆, hΔ⟩ := hE
  
  obtain ⟨φ, hφinj, hφσ⟩ := exists_pts_variableChange_hom F E C
  suffices key : ∀ Q : EllipticRootNumber.Pts F (C • E), m • Q = 0 →
      EllipticRootNumber.galHom F (C • E) σ Q = Q by
    apply hφinj
    rw [hφσ]
    apply key
    rw [← map_nsmul φ, (EllipticRootNumber.mem_torsion F E).mp hP, map_zero]
  
  obtain ⟨w, hw₁, hw₂⟩ := exists_galoisInvariant_valuation_algebraicClosure F
  
  have unit : ∀ a : F, ValuativeRel.valuation F a = 1 →
      w (algebraMap F (AlgebraicClosure F) a) = 1 := by
    intro a ha
    have ha0 : a ≠ 0 := by
      rintro rfl
      rw [map_zero] at ha
      exact zero_ne_one ha
    have hle : w (algebraMap F (AlgebraicClosure F) a) ≤ 1 := (hw₁ a).mpr ha.le
    have hinv : w (algebraMap F (AlgebraicClosure F) a⁻¹) ≤ 1 :=
      (hw₁ a⁻¹).mpr (by rw [map_inv₀, ha, inv_one])
    have hmul : w (algebraMap F (AlgebraicClosure F) a) *
        w (algebraMap F (AlgebraicClosure F) a⁻¹) = 1 := by
      rw [← map_mul, ← map_mul, mul_inv_cancel₀ ha0, map_one, map_one]
    refine le_antisymm hle ?_
    calc (1 : NNReal) = _ := hmul.symm
      _ ≤ w (algebraMap F (AlgebraicClosure F) a) * 1 := mul_le_mul_left' hinv _
      _ = _ := mul_one _
  
  set W := (C • E).baseChange (AlgebraicClosure F) with hW
  have hW₁ : w W.a₁ ≤ 1 := (hw₁ (C • E).a₁).mpr h₁
  have hW₂ : w W.a₂ ≤ 1 := (hw₁ (C • E).a₂).mpr h₂
  have hW₃ : w W.a₃ ≤ 1 := (hw₁ (C • E).a₃).mpr h₃
  have hW₄ : w W.a₄ ≤ 1 := (hw₁ (C • E).a₄).mpr h₄
  have hW₆ : w W.a₆ ≤ 1 := (hw₁ (C • E).a₆).mpr h₆
  have hWΔ : w W.Δ = 1 := by
    rw [hW, WeierstrassCurve.baseChange, WeierstrassCurve.map_Δ]
    exact unit _ hΔ
  
  have hp : (EllipticRootNumber.p F).Prime := by
    unfold EllipticRootNumber.p
    exact CharP.char_is_prime (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) _
  have hvm : ValuativeRel.valuation F (m : F) = 1 := by
    have hres : IsLocalRing.residue (ValuativeRel.valuation F).integer
        (m : (ValuativeRel.valuation F).integer) ≠ 0 := by
      rw [map_natCast]
      intro h0
      haveI := ringChar.charP (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
      rw [CharP.cast_eq_zero_iff (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
        (ringChar (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer))] at h0
      have hdvd : EllipticRootNumber.p F ∣ m := h0
      have h1 : EllipticRootNumber.p F ∣ Nat.gcd m (EllipticRootNumber.p F) :=
        Nat.dvd_gcd hdvd dvd_rfl
      rw [Nat.Coprime.gcd_eq_one hm] at h1
      exact hp.one_lt.ne' (Nat.dvd_one.mp h1)
    have hunit : IsUnit (m : (ValuativeRel.valuation F).integer) := by
      by_contra hnu
      exact hres ((IsLocalRing.residue_eq_zero_iff _).mpr
        ((IsLocalRing.mem_maximalIdeal _).mpr hnu))
    have h1 := (Valuation.integer.integers
      (ValuativeRel.valuation F)).isUnit_iff_valuation_eq_one.mp hunit
    simpa using h1
  
  have hwm : w (m : AlgebraicClosure F) = 1 := by
    rw [← map_natCast (algebraMap F (AlgebraicClosure F))]
    exact unit _ hvm
  have natle : ∀ n : ℕ, w (n : AlgebraicClosure F) ≤ 1 := by
    intro n
    induction n with
    | zero => rw [Nat.cast_zero, map_zero]; exact zero_le'
    | succ n ih =>
      rw [Nat.cast_succ]
      exact (Valuation.map_add _ _ _).trans (max_le ih (by rw [map_one]))
  
  have b6 : ∀ {x y : AlgebraicClosure F}, W.toAffine.Equation x y →
      (w x ≤ 1 → w y ≤ 1) ∧
      (1 < w x → w y ^ 2 = w x ^ 3 ∧ w (x / y) < 1 ∧
        w (x / W.toAffine.negY x y + x / y) ≤ w (x / y) ^ 2) :=
    fun h => weierstrass_E1_basic w W hW₁ hW₂ hW₃ hW₄ hW₆ h
  
  obtain ⟨τ, hτ0, hτs⟩ : ∃ τ : W.toAffine.Point → AlgebraicClosure F, τ 0 = 0 ∧
      ∀ {x y : AlgebraicClosure F} (h : W.toAffine.Nonsingular x y),
        τ (WeierstrassCurve.Affine.Point.some h) = x / y :=
    ⟨fun R => match R with
      | .zero => 0
      | @WeierstrassCurve.Affine.Point.some _ _ _ x y _ => x / y, rfl, fun _ => rfl⟩
  obtain ⟨S, hS⟩ : ∃ S : Set W.toAffine.Point, ∀ R, R ∈ S ↔ (R = 0 ∨
      ∃ (x y : AlgebraicClosure F) (h : W.toAffine.Nonsingular x y),
        R = WeierstrassCurve.Affine.Point.some h ∧ 1 < w x) :=
    ⟨{R | R = 0 ∨ ∃ (x y : AlgebraicClosure F) (h : W.toAffine.Nonsingular x y),
        R = WeierstrassCurve.Affine.Point.some h ∧ 1 < w x}, fun _ => Iff.rfl⟩
  have hS_some : ∀ {x y : AlgebraicClosure F} (h : W.toAffine.Nonsingular x y), 1 < w x →
      w (x / y) < 1 ∧ x / y ≠ 0 := by
    intro x y h hx
    obtain ⟨hy2, hlt, -⟩ := (b6 h.1).2 hx
    refine ⟨hlt, div_ne_zero ?_ ?_⟩
    · rintro rfl
      rw [map_zero] at hx
      exact absurd hx (not_lt.mpr zero_le')
    · rintro rfl
      rw [map_zero, zero_pow two_ne_zero] at hy2
      exact pow_ne_zero 3 (ne_of_gt (lt_trans zero_lt_one hx)) hy2.symm
  have hadd : ∀ P ∈ S, ∀ Q ∈ S, P + Q ∈ S ∧
      w (τ (P + Q) - τ P - τ Q) ≤ max (w (τ P)) (w (τ Q)) ^ 2 := by
    intro P hPS Q hQS
    rcases (hS P).mp hPS with rfl | ⟨x₁, y₁, h₁', rfl, hx₁⟩
    · rw [zero_add, hτ0, sub_zero, sub_self, map_zero]
      exact ⟨hQS, zero_le'⟩
    rcases (hS Q).mp hQS with rfl | ⟨x₂, y₂, h₂', rfl, hx₂⟩
    · rw [add_zero, hτ0, sub_zero, sub_self, map_zero]
      exact ⟨hPS, zero_le'⟩
    by_cases hxy : x₁ = x₂ ∧ y₁ = W.toAffine.negY x₂ y₂
    · have hsum : WeierstrassCurve.Affine.Point.some h₁' + WeierstrassCurve.Affine.Point.some h₂'
          = 0 := WeierstrassCurve.Affine.Point.add_of_Y_eq hxy.1 hxy.2
      rw [hsum]
      refine ⟨(hS 0).mpr (Or.inl rfl), ?_⟩
      obtain ⟨-, -, hneg⟩ := (b6 h₂'.1).2 hx₂
      have e : τ 0 - τ (WeierstrassCurve.Affine.Point.some h₁') -
          τ (WeierstrassCurve.Affine.Point.some h₂') =
          -(x₂ / W.toAffine.negY x₂ y₂ + x₂ / y₂) := by
        rw [hτ0, hτs, hτs, hxy.1, hxy.2]
        ring
      rw [e, Valuation.map_neg, hτs, hτs]
      exact hneg.trans (pow_le_pow_left₀ zero_le' (le_max_right _ _) 2)
    · obtain ⟨x₃, y₃, h₃', hsum, hx₃, hest⟩ :=
        weierstrass_E1_add_estimate w W hW₁ hW₂ hW₃ hW₄ hW₆ h₁' h₂' hx₁ hx₂ hxy
      rw [hsum, hτs, hτs, hτs]
      exact ⟨(hS _).mpr (Or.inr ⟨x₃, y₃, h₃', rfl, hx₃⟩), hest⟩
  
  have tf : ∀ R ∈ S, m • R = 0 → R = 0 := by
    intro R hR hmR
    by_contra hR0
    obtain ⟨x, y, h, rfl, hx⟩ := ((hS R).mp hR).resolve_left hR0
    obtain ⟨hρ1, hτne⟩ := hS_some h hx
    have hρ0 : 0 < w (x / y) :=
      lt_of_le_of_ne zero_le' ((Valuation.ne_zero_iff w).mpr hτne).symm
    have hρ2 : w (x / y) ^ 2 ≤ w (x / y) := by
      rw [sq]
      exact mul_le_of_le_one_left' hρ1.le
    have hRS : WeierstrassCurve.Affine.Point.some h ∈ S := (hS _).mpr (Or.inr ⟨x, y, h, rfl, hx⟩)
    have claim : ∀ k : ℕ, (k + 1) • WeierstrassCurve.Affine.Point.some h ∈ S ∧
        w (τ ((k + 1) • WeierstrassCurve.Affine.Point.some h) -
          ((k + 1 : ℕ) : AlgebraicClosure F) * (x / y)) ≤ w (x / y) ^ 2 := by
      intro k
      induction k with
      | zero =>
        rw [zero_add, one_nsmul, Nat.cast_one, one_mul, hτs, sub_self, map_zero]
        exact ⟨hRS, zero_le'⟩
      | succ k ih =>
        obtain ⟨hkS, hest⟩ := ih
        have hb : w (τ ((k + 1) • WeierstrassCurve.Affine.Point.some h)) ≤ w (x / y) := by
          have e : τ ((k + 1) • WeierstrassCurve.Affine.Point.some h) =
              (τ ((k + 1) • WeierstrassCurve.Affine.Point.some h) -
                ((k + 1 : ℕ) : AlgebraicClosure F) * (x / y)) +
              ((k + 1 : ℕ) : AlgebraicClosure F) * (x / y) := by ring
          rw [e]
          refine (Valuation.map_add _ _ _).trans (max_le (hest.trans hρ2) ?_)
          rw [map_mul]
          exact mul_le_of_le_one_left' (natle _)
        obtain ⟨hS', hest'⟩ := hadd _ hkS _ hRS
        rw [hτs] at hest'
        rw [succ_nsmul _ (k + 1)]
        refine ⟨hS', ?_⟩
        have e3 : τ ((k + 1) • WeierstrassCurve.Affine.Point.some h +
              WeierstrassCurve.Affine.Point.some h) -
            ((k + 1 + 1 : ℕ) : AlgebraicClosure F) * (x / y) =
            (τ ((k + 1) • WeierstrassCurve.Affine.Point.some h +
              WeierstrassCurve.Affine.Point.some h) -
              τ ((k + 1) • WeierstrassCurve.Affine.Point.some h) - x / y) +
            (τ ((k + 1) • WeierstrassCurve.Affine.Point.some h) -
              ((k + 1 : ℕ) : AlgebraicClosure F) * (x / y)) := by
          push_cast
          ring
        rw [e3]
        refine (Valuation.map_add _ _ _).trans (max_le (hest'.trans ?_) hest)
        exact pow_le_pow_left₀ zero_le' (max_le hb le_rfl) 2
    obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
    obtain ⟨-, hest⟩ := claim k
    rw [hmR, hτ0, zero_sub, Valuation.map_neg, map_mul, hwm, one_mul] at hest
    have h1 : w (x / y) * 1 ≤ w (x / y) * w (x / y) := by
      rw [mul_one, ← sq]
      exact hest
    exact absurd hρ1 (not_lt.mpr (le_of_mul_le_mul_left h1 hρ0))
  
  have integ : ∀ {x y : AlgebraicClosure F} (h : W.toAffine.Nonsingular x y),
      m • WeierstrassCurve.Affine.Point.some h = 0 → w x ≤ 1 ∧ w y ≤ 1 := by
    intro x y h hmh
    have hx : w x ≤ 1 := by
      by_contra hx
      push_neg at hx
      exact WeierstrassCurve.Affine.Point.some_ne_zero h
        (tf _ ((hS _).mpr (Or.inr ⟨x, y, h, rfl, hx⟩)) hmh)
    exact ⟨hx, (b6 h.1).1 hx⟩
  
  intro Q hQ
  cases Q with
  | zero => exact map_zero _
  | @some x y h =>
    obtain ⟨hx, hy⟩ := integ h hQ
    obtain ⟨h', hgal⟩ : ∃ h' : W.toAffine.Nonsingular (σ x) (σ y),
        EllipticRootNumber.galHom F (C • E) σ (WeierstrassCurve.Affine.Point.some h) =
          WeierstrassCurve.Affine.Point.some h' := ⟨_, rfl⟩
    have hσx1 : w (σ x) ≤ 1 := by rw [hw₂]; exact hx
    have hσy1 : w (σ y) ≤ 1 := by rw [hw₂]; exact hy
    have hdx : w (σ x - x) < 1 := valuation_sub_lt_one_of_mem_inertia F w hw₁ hw₂ σ hσ x hx
    have hdy : w (σ y - y) < 1 := valuation_sub_lt_one_of_mem_inertia F w hw₁ hw₂ σ hσ y hy
    have hdiff := weierstrass_sub_eq_zero_or_one_lt_of_close w W hW₁ hW₂ hW₃ hW₄ hW₆ hWΔ h h'
      hx hy hσx1 hσy1 hdx hdy
    have hmd : m • (WeierstrassCurve.Affine.Point.some h' -
        WeierstrassCurve.Affine.Point.some h) = 0 := by
      rw [nsmul_sub, ← hgal, ← map_nsmul (EllipticRootNumber.galHom F (C • E) σ), hQ, map_zero,
        sub_zero]
    rw [hgal]
    rcases hdiff with hz | ⟨x₃, y₃, h₃', heq, hx₃⟩
    · exact sub_eq_zero.mp hz
    · exfalso
      rw [heq] at hmd
      exact WeierstrassCurve.Affine.Point.some_ne_zero h₃'
        (tf _ ((hS _).mpr (Or.inr ⟨x₃, y₃, h₃', rfl, hx₃⟩)) hmd)

theorem weierstrass_odd_torsion_finite {K : Type*} [Field K] [CharZero K] [DecidableEq K]
    (W : WeierstrassCurve K) (n : ℕ) (hn : Odd n) :
    {P : W.toAffine.Point | n • P = 0}.Finite :=
by
  
  have s1 : ∀ (x y : K), W.toAffine.Equation x y → y ≠ W.toAffine.negY x y →
      4 * x ^ 3 + W.b₂ * x ^ 2 + 2 * W.b₄ * x + W.b₆ ≠ 0 ∧
      W.toAffine.addX x x (W.toAffine.slope x x y y) *
          (4 * x ^ 3 + W.b₂ * x ^ 2 + 2 * W.b₄ * x + W.b₆) =
        x ^ 4 - W.b₄ * x ^ 2 - 2 * W.b₆ * x - W.b₈ := by
    intro x y hxy hy
    rw [WeierstrassCurve.Affine.equation_iff] at hxy
    have hneg : W.toAffine.negY x y = -y - W.a₁ * x - W.a₃ := rfl
    have hd : 2 * y + W.a₁ * x + W.a₃ ≠ 0 := by
      intro h; apply hy; rw [hneg]; linear_combination h
    have hB : 4 * x ^ 3 + W.b₂ * x ^ 2 + 2 * W.b₄ * x + W.b₆ =
        (2 * y + W.a₁ * x + W.a₃) ^ 2 := by
      simp only [WeierstrassCurve.b₂, WeierstrassCurve.b₄, WeierstrassCurve.b₆]
      linear_combination (-4) * hxy
    refine ⟨hB ▸ pow_ne_zero 2 hd, ?_⟩
    have hsl : W.toAffine.slope x x y y =
        (3 * x ^ 2 + 2 * W.a₂ * x + W.a₄ - W.a₁ * y) / (2 * y + W.a₁ * x + W.a₃) := by
      rw [WeierstrassCurve.Affine.slope_of_Y_ne rfl hy, hneg]
      congr 1; ring
    have hadd : W.toAffine.addX x x (W.toAffine.slope x x y y) *
        (2 * y + W.a₁ * x + W.a₃) ^ 2 =
        (3 * x ^ 2 + 2 * W.a₂ * x + W.a₄ - W.a₁ * y) ^ 2 +
          W.a₁ * (3 * x ^ 2 + 2 * W.a₂ * x + W.a₄ - W.a₁ * y) * (2 * y + W.a₁ * x + W.a₃) -
          (W.a₂ + 2 * x) * (2 * y + W.a₁ * x + W.a₃) ^ 2 := by
      rw [hsl]
      simp only [WeierstrassCurve.Affine.addX]
      generalize 3 * x ^ 2 + 2 * W.a₂ * x + W.a₄ - W.a₁ * y = m
      generalize 2 * y + W.a₁ * x + W.a₃ = d at hd ⊢
      field_simp
      ring
    rw [hB, hadd]
    simp only [WeierstrassCurve.b₄, WeierstrassCurve.b₆, WeierstrassCurve.b₈]
    linear_combination (-(W.a₁ ^ 2 + 4 * W.a₂ + 8 * x)) * hxy
  
  have s4 : ∀ P : W.toAffine.Point, n • P = 0 → P ≠ 0 →
      (2 ^ n.totient) • P = P ∧ ∀ j : ℕ, (2 ^ j) • P ≠ 0 := by
    intro P hP hP0
    have hcop : Nat.Coprime 2 n := Nat.coprime_two_left.mpr hn
    have hmod : 2 ^ n.totient ≡ 1 [MOD n] := Nat.ModEq.pow_totient hcop
    have hdvd : n ∣ 2 ^ n.totient - 1 := (Nat.modEq_iff_dvd' Nat.one_le_two_pow).mp hmod.symm
    obtain ⟨t, ht⟩ := hdvd
    have h2 : 2 ^ n.totient = 1 + n * t := by
      have := @Nat.one_le_two_pow n.totient; omega
    have hfix : (2 ^ n.totient) • P = P := by
      rw [h2, add_nsmul, one_nsmul, mul_comm, mul_smul, hP, smul_zero, add_zero]
    refine ⟨hfix, ?_⟩
    have hk : 1 ≤ n.totient := Nat.totient_pos.mpr hn.pos
    have hiter : ∀ m, (2 ^ (n.totient * m)) • P = P := by
      intro m
      induction m with
      | zero => simp
      | succ m ih => rw [Nat.mul_succ, pow_add, mul_smul, hfix, ih]
    intro j hj
    apply hP0
    have hle : j ≤ n.totient * j := Nat.le_mul_of_pos_left j hk
    obtain ⟨a, ha⟩ : ∃ a, n.totient * j = a + j := ⟨n.totient * j - j, by omega⟩
    rw [← hiter j, ha, pow_add, mul_smul, hj, smul_zero]
  
  have s5 : ∀ (S : Set K), S.Finite → ∀ (T : Set W.toAffine.Point),
      (∀ (x y : K) (h : W.toAffine.Nonsingular x y),
        WeierstrassCurve.Affine.Point.some h ∈ T → x ∈ S) → T.Finite := by
    intro S hS T hT
    let f : W.toAffine.Point → Option (K × K) := fun P => match P with
      | .zero => none
      | .some (x := x) (y := y) _ => some (x, y)
    have hf : Function.Injective f := by
      intro P Q h
      cases P <;> cases Q <;> simp_all [f]
    let p : K → Polynomial K := fun x => Polynomial.X ^ 2 +
      Polynomial.C (W.a₁ * x + W.a₃) * Polynomial.X -
      Polynomial.C (x ^ 3 + W.a₂ * x ^ 2 + W.a₄ * x + W.a₆)
    have hp : ∀ x, p x ≠ 0 := by
      intro x h
      have := congrArg (fun r => Polynomial.coeff r 2) h
      simp only [p, Polynomial.coeff_sub, Polynomial.coeff_add, Polynomial.coeff_X_pow,
        Polynomial.coeff_C_mul_X, Polynomial.coeff_C, Polynomial.coeff_zero] at this
      simp at this
    let Z : Set (K × K) := ⋃ x ∈ S, (fun y => (x, y)) '' {y | (p x).IsRoot y}
    have hZ : Z.Finite :=
      hS.biUnion (fun x _ => (Polynomial.finite_setOf_isRoot (hp x)).image _)
    refine Set.Finite.of_finite_image ?_ hf.injOn
    refine ((hZ.image Option.some).insert none).subset ?_
    rintro _ ⟨P, hPT, rfl⟩
    match P, hPT with
    | .zero, _ => exact Set.mem_insert _ _
    | .some (x := x) (y := y) h, hPT =>
      refine Set.mem_insert_of_mem _ ⟨(x, y), ?_, rfl⟩
      simp only [Z, Set.mem_iUnion]
      refine ⟨x, hT x y h hPT, y, ?_, rfl⟩
      have he := (WeierstrassCurve.Affine.equation_iff _ _).mp h.1
      simp only [Set.mem_setOf_eq, Polynomial.IsRoot, p, Polynomial.eval_sub, Polynomial.eval_add,
        Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_C, Polynomial.eval_X]
      linear_combination he
  
  obtain ⟨N, D, hN0, hD0, hN, hD⟩ : ∃ N D : ℕ → Polynomial K, N 0 = Polynomial.X ∧ D 0 = 1 ∧
      (∀ j, N (j + 1) = N j ^ 4 - Polynomial.C W.b₄ * N j ^ 2 * D j ^ 2
        - Polynomial.C (2 * W.b₆) * N j * D j ^ 3 - Polynomial.C W.b₈ * D j ^ 4) ∧
      (∀ j, D (j + 1) = Polynomial.C 4 * N j ^ 3 * D j + Polynomial.C W.b₂ * N j ^ 2 * D j ^ 2
        + Polynomial.C (2 * W.b₄) * N j * D j ^ 3 + Polynomial.C W.b₆ * D j ^ 4) := by
    let ND : ℕ → Polynomial K × Polynomial K := fun j =>
      Nat.rec (motive := fun _ => Polynomial K × Polynomial K) (Polynomial.X, 1)
        (fun _ pq => (pq.1 ^ 4 - Polynomial.C W.b₄ * pq.1 ^ 2 * pq.2 ^ 2
            - Polynomial.C (2 * W.b₆) * pq.1 * pq.2 ^ 3 - Polynomial.C W.b₈ * pq.2 ^ 4,
          Polynomial.C 4 * pq.1 ^ 3 * pq.2 + Polynomial.C W.b₂ * pq.1 ^ 2 * pq.2 ^ 2
            + Polynomial.C (2 * W.b₄) * pq.1 * pq.2 ^ 3 + Polynomial.C W.b₆ * pq.2 ^ 4)) j
    exact ⟨fun j => (ND j).1, fun j => (ND j).2, rfl, rfl, fun j => rfl, fun j => rfl⟩
  
  have s2 : ∀ j : ℕ, (N j).natDegree ≤ 4 ^ j ∧ (N j).coeff (4 ^ j) = 1 ∧
      (D j).natDegree ≤ 4 ^ j - 1 ∧ (D j).coeff (4 ^ j - 1) = (4 : K) ^ j := by
    intro j
    induction j with
    | zero => simp [hN0, hD0]
    | succ j ih =>
      obtain ⟨h1, h2, h3, h4⟩ := ih
      have he1 : 1 ≤ 4 ^ j := Nat.one_le_pow _ _ (by norm_num)
      have hpow : 4 ^ (j + 1) = 4 * 4 ^ j := by rw [pow_succ]; ring
      rw [hpow, hN j, hD j]
      generalize 4 ^ j = e at h1 h2 h3 h4 he1
      generalize N j = p at h1 h2 h3 h4
      generalize D j = q at h1 h2 h3 h4
      have key : ∀ (c : K) (a b : ℕ),
          (Polynomial.C c * p ^ a * q ^ b).natDegree ≤ a * e + b * (e - 1) := by
        intro c a b
        refine Polynomial.natDegree_mul_le_of_le ?_ (Polynomial.natDegree_pow_le_of_le b h3)
        exact (Polynomial.natDegree_C_mul_le _ _).trans (Polynomial.natDegree_pow_le_of_le a h1)
      have k1 : (Polynomial.C W.b₄ * p ^ 2 * q ^ 2).natDegree < 4 * e := by
        have := key W.b₄ 2 2; omega
      have k2 : (Polynomial.C (2 * W.b₆) * p * q ^ 3).natDegree < 4 * e := by
        have := key (2 * W.b₆) 1 3; rw [pow_one] at this; omega
      have k3 : (Polynomial.C W.b₈ * q ^ 4).natDegree < 4 * e := by
        have := key W.b₈ 0 4; rw [pow_zero, mul_one] at this; omega
      have k0 : (p ^ 4).natDegree ≤ 4 * e := Polynomial.natDegree_pow_le_of_le 4 h1
      have l1 : (Polynomial.C W.b₂ * p ^ 2 * q ^ 2).natDegree < 4 * e - 1 := by
        have := key W.b₂ 2 2; omega
      have l2 : (Polynomial.C (2 * W.b₄) * p * q ^ 3).natDegree < 4 * e - 1 := by
        have := key (2 * W.b₄) 1 3; rw [pow_one] at this; omega
      have l3 : (Polynomial.C W.b₆ * q ^ 4).natDegree < 4 * e - 1 := by
        have := key W.b₆ 0 4; rw [pow_zero, mul_one] at this; omega
      have l0 : (Polynomial.C 4 * p ^ 3 * q).natDegree ≤ 4 * e - 1 := by
        have := key 4 3 1; rw [pow_one] at this; omega
      refine ⟨?_, ?_, ?_, ?_⟩
      · refine (Polynomial.natDegree_sub_le _ _).trans (max_le ?_ k3.le)
        refine (Polynomial.natDegree_sub_le _ _).trans (max_le ?_ k2.le)
        exact (Polynomial.natDegree_sub_le _ _).trans (max_le k0 k1.le)
      · rw [Polynomial.coeff_sub, Polynomial.coeff_sub, Polynomial.coeff_sub,
          Polynomial.coeff_eq_zero_of_natDegree_lt k1, Polynomial.coeff_eq_zero_of_natDegree_lt k2,
          Polynomial.coeff_eq_zero_of_natDegree_lt k3, Polynomial.coeff_pow_of_natDegree_le h1, h2]
        simp
      · refine (Polynomial.natDegree_add_le _ _).trans (max_le ?_ l3.le)
        refine (Polynomial.natDegree_add_le _ _).trans (max_le ?_ l2.le)
        exact (Polynomial.natDegree_add_le _ _).trans (max_le l0 l1.le)
      · rw [Polynomial.coeff_add, Polynomial.coeff_add, Polynomial.coeff_add,
          Polynomial.coeff_eq_zero_of_natDegree_lt l1, Polynomial.coeff_eq_zero_of_natDegree_lt l2,
          Polynomial.coeff_eq_zero_of_natDegree_lt l3, mul_assoc, Polynomial.coeff_C_mul]
        have hidx : 4 * e - 1 = 3 * e + (e - 1) := by omega
        rw [hidx, Polynomial.coeff_mul_add_eq_of_natDegree_le
          (Polynomial.natDegree_pow_le_of_le 3 h1) h3, Polynomial.coeff_pow_of_natDegree_le h1,
          h2, h4]
        ring
  
  have s3 : ∀ (x : ℕ → K),
      (∀ j, 4 * x j ^ 3 + W.b₂ * x j ^ 2 + 2 * W.b₄ * x j + W.b₆ ≠ 0 ∧
        x (j + 1) * (4 * x j ^ 3 + W.b₂ * x j ^ 2 + 2 * W.b₄ * x j + W.b₆) =
          x j ^ 4 - W.b₄ * x j ^ 2 - 2 * W.b₆ * x j - W.b₈) →
      ∀ j : ℕ, (D j).eval (x 0) ≠ 0 ∧ x j * (D j).eval (x 0) = (N j).eval (x 0) := by
    intro x hx j
    induction j with
    | zero => simp [hN0, hD0]
    | succ j ih =>
      obtain ⟨hv, hu⟩ := ih
      obtain ⟨hB, hA⟩ := hx j
      have eN : (N (j + 1)).eval (x 0) = (D j).eval (x 0) ^ 4 *
          (x j ^ 4 - W.b₄ * x j ^ 2 - 2 * W.b₆ * x j - W.b₈) := by
        rw [hN j]
        simp only [Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_pow,
          Polynomial.eval_C]
        rw [← hu]; ring
      have eD : (D (j + 1)).eval (x 0) = (D j).eval (x 0) ^ 4 *
          (4 * x j ^ 3 + W.b₂ * x j ^ 2 + 2 * W.b₄ * x j + W.b₆) := by
        rw [hD j]
        simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_pow,
          Polynomial.eval_C]
        rw [← hu]; ring
      refine ⟨by rw [eD]; exact mul_ne_zero (pow_ne_zero 4 hv) hB, ?_⟩
      rw [eN, eD]
      linear_combination (D j).eval (x 0) ^ 4 * hA
  
  set k := n.totient with hk_def
  have hk : 1 ≤ k := Nat.totient_pos.mpr hn.pos
  obtain ⟨-, hcN, -, hcD⟩ := s2 k
  set G : Polynomial K := N k - Polynomial.X * D k with hG
  have hG0 : G ≠ 0 := by
    intro h0
    have hle : 1 ≤ 4 ^ k := Nat.one_le_pow _ _ (by norm_num)
    have h1 : G.coeff (4 ^ k) = 1 - (4 : K) ^ k := by
      rw [hG, Polynomial.coeff_sub, hcN, ← Nat.sub_add_cancel hle, Polynomial.coeff_X_mul, hcD]
    rw [h0, Polynomial.coeff_zero] at h1
    have h4K : (4 : K) ^ k = 1 := by linear_combination h1
    have h4 : ((4 ^ k : ℕ) : K) = ((1 : ℕ) : K) := by push_cast; exact h4K
    have h4N := Nat.cast_injective h4
    have h44 : 4 ^ 1 ≤ 4 ^ k := Nat.pow_le_pow_right (by norm_num) hk
    omega
  
  apply s5 {t | G.IsRoot t} (Polynomial.finite_setOf_isRoot hG0)
  intro x y h hP
  simp only [Set.mem_setOf_eq] at hP ⊢
  have hP0 : WeierstrassCurve.Affine.Point.some h ≠ 0 :=
    WeierstrassCurve.Affine.Point.some_ne_zero h
  obtain ⟨hfix, hnz⟩ := s4 _ hP hP0
  let xc : W.toAffine.Point → K := fun Q => match Q with
    | .zero => 0
    | .some (x := x) _ => x
  let xs : ℕ → K := fun j => xc (2 ^ j • WeierstrassCurve.Affine.Point.some h)
  have hxs0 : xs 0 = x := by
    show xc (2 ^ 0 • WeierstrassCurve.Affine.Point.some h) = x
    rw [pow_zero, one_smul]
  have hxsk : xs k = x := by
    show xc (2 ^ k • WeierstrassCurve.Affine.Point.some h) = x
    rw [hfix]
  have hstep : ∀ j, 4 * xs j ^ 3 + W.b₂ * xs j ^ 2 + 2 * W.b₄ * xs j + W.b₆ ≠ 0 ∧
      xs (j + 1) * (4 * xs j ^ 3 + W.b₂ * xs j ^ 2 + 2 * W.b₄ * xs j + W.b₆) =
        xs j ^ 4 - W.b₄ * xs j ^ 2 - 2 * W.b₆ * xs j - W.b₈ := by
    intro j
    have h2 := hnz (j + 1)
    have hQ := hnz j
    have hsucc : 2 ^ (j + 1) • WeierstrassCurve.Affine.Point.some h =
        2 ^ j • WeierstrassCurve.Affine.Point.some h +
          2 ^ j • WeierstrassCurve.Affine.Point.some h := by
      rw [pow_succ, mul_comm, mul_smul, two_nsmul]
    simp only [xs]
    rw [hsucc] at h2 ⊢
    generalize 2 ^ j • WeierstrassCurve.Affine.Point.some h = Q at hQ h2 ⊢
    match Q, hQ, h2 with
    | .zero, hQ, _ => exact absurd rfl hQ
    | .some (x := x₀) (y := y₀) h₀, _, h2 =>
      have hy : y₀ ≠ W.toAffine.negY x₀ y₀ := fun hy =>
        h2 (WeierstrassCurve.Affine.Point.add_of_Y_eq rfl hy)
      rw [WeierstrassCurve.Affine.Point.add_self_of_Y_ne hy]
      exact s1 x₀ y₀ h₀.1 hy
  obtain ⟨-, hev⟩ := s3 xs hstep k
  rw [hxsk, hxs0] at hev
  simp only [Polynomial.IsRoot, hG, Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_X]
  rw [← hev]
  ring

theorem tateModule_finite (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] (E : WeierstrassCurve F) (hΔ : E.Δ ≠ 0) :
    Module.Finite ℤ_[EllipticRootNumber.ell F] (EllipticRootNumber.tateModule F E) :=
by
  classical
  
  have padicInt_module_finite_of_separated : ∀ {p : ℕ} [Fact p.Prime] {M : Type u}
      [AddCommGroup M] [Module ℤ_[p] M],
      (∀ x : M, (∀ m : ℕ, ∃ y : M, x = ((p : ℤ_[p]) ^ m) • y) → x = 0) →
      ∀ (S : Set M), S.Finite →
      (∀ x : M, ∃ s ∈ S, ∃ y : M, x = s + (p : ℤ_[p]) • y) →
      Module.Finite ℤ_[p] M := by
    intro p _ M _ _ hsep S hSfin hS
    have hp : p.Prime := Fact.out
    choose σ hσS τ hστ using hS
    set S' : Finset M := hSfin.toFinset with hS'
    have hmemS : ∀ z, σ z ∈ S' := fun z => (Set.Finite.mem_toFinset hSfin).mpr (hσS z)
    refine ⟨⟨S', ?_⟩⟩
    rw [eq_top_iff]
    intro x _
    let xs : ℕ → M := fun m => τ^[m] x
    let ss : ℕ → M := fun m => σ (xs m)
    have hxs_succ : ∀ m, xs (m + 1) = τ (xs m) := fun m => Function.iterate_succ_apply' τ m x
    have h1 : ∀ N, xs N = ss N + (p : ℤ_[p]) • xs (N + 1) := by
      intro N
      rw [hxs_succ]
      exact hστ (xs N)
    have hdecomp : ∀ N, x = ∑ m ∈ Finset.range N, ((p : ℤ_[p]) ^ m) • ss m +
        ((p : ℤ_[p]) ^ N) • xs N := by
      intro N
      induction N with
      | zero => simp [xs]
      | succ N ih =>
        rw [Finset.sum_range_succ, add_assoc, pow_succ, ← smul_smul, ← smul_add, ← h1]
        exact ih
    have hbound : ∀ (P : ℕ → Prop) [DecidablePred P] (k : ℕ),
        ‖(if P k then (p : ℤ_[p]) ^ k else 0)‖ ≤ ((p : ℝ)⁻¹) ^ k := by
      intro P _ k
      split_ifs
      · rw [norm_pow, PadicInt.norm_p]
      · rw [norm_zero]; positivity
    have hsummable : ∀ (P : ℕ → Prop) [DecidablePred P],
        Summable (fun k => if P k then (p : ℤ_[p]) ^ k else 0) := by
      intro P _
      refine Summable.of_norm_bounded (summable_geometric_of_lt_one (by positivity) ?_) (hbound P)
      exact inv_lt_one_of_one_lt₀ (by exact_mod_cast hp.one_lt)
    let f : M → ℕ → ℤ_[p] := fun s m => if ss m = s then (p : ℤ_[p]) ^ m else 0
    let G : M → ℕ → ℤ_[p] := fun s N => ∑' k, if ss (k + N) = s then (p : ℤ_[p]) ^ k else 0
    let α : M → ℤ_[p] := fun s => ∑' m, f s m
    have hα : ∀ s N, α s = ∑ m ∈ Finset.range N, f s m + (p : ℤ_[p]) ^ N * G s N := by
      intro s N
      have e := (hsummable (fun m => ss m = s)).sum_add_tsum_nat_add N
      simp only [α, f, G]
      rw [← e]
      congr 1
      rw [← (hsummable (fun k => ss (k + N) = s)).tsum_mul_left]
      apply tsum_congr
      intro k
      split_ifs
      · rw [pow_add, mul_comm]
      · rw [mul_zero]
    have hregroup : ∀ N, ∑ m ∈ Finset.range N, ((p : ℤ_[p]) ^ m) • ss m =
        ∑ s ∈ S', (∑ m ∈ Finset.range N, f s m) • s := by
      intro N
      simp_rw [Finset.sum_smul]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro m _
      simp only [f, ite_smul, zero_smul, Finset.sum_ite_eq]
      exact (if_pos (hmemS (xs m))).symm
    set v : M := ∑ s ∈ S', α s • s with hv
    have hkey : x - v = 0 := by
      apply hsep
      intro N
      refine ⟨xs N - ∑ s ∈ S', G s N • s, ?_⟩
      have e1 : v = ∑ s ∈ S', (∑ m ∈ Finset.range N, f s m) • s +
          ((p : ℤ_[p]) ^ N) • ∑ s ∈ S', G s N • s := by
        rw [hv, Finset.smul_sum, ← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro s _
        rw [hα s N, add_smul, mul_smul]
      have hd := hdecomp N
      rw [hregroup N] at hd
      rw [e1]
      conv_lhs => rw [hd]
      rw [smul_sub]
      abel
    have hx : x = v := sub_eq_zero.mp hkey
    rw [hx, hv]
    exact Submodule.sum_mem _ (fun s hs => Submodule.smul_mem _ _ (Submodule.subset_span hs))
  
  have hp : (EllipticRootNumber.p F).Prime := by
    unfold EllipticRootNumber.p
    exact CharP.char_is_prime (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) _
  have hℓge : EllipticRootNumber.p F + 1 ≤ EllipticRootNumber.ell F := by
    have h := (Nat.exists_infinite_primes (EllipticRootNumber.p F + 1)).choose_spec.1
    unfold EllipticRootNumber.ell
    exact h
  have hodd : Odd (EllipticRootNumber.ell F) := by
    refine (EllipticRootNumber.ell_prime F).out.odd_of_ne_two ?_
    have := hp.two_le
    omega
  haveI : CharZero (AlgebraicClosure F) :=
    charZero_of_injective_algebraMap (algebraMap F (AlgebraicClosure F)).injective
  
  set ℓ := EllipticRootNumber.ell F with hℓ
  
  have hsep : ∀ x : EllipticRootNumber.tateModule F E,
      (∀ m : ℕ, ∃ y : EllipticRootNumber.tateModule F E, x = ((ℓ : ℤ_[ℓ]) ^ m) • y) → x = 0 := by
    intro x hx
    apply Subtype.ext
    funext n
    apply Subtype.ext
    obtain ⟨y, rfl⟩ := hx (n + 1)
    show ((((ℓ : ℤ_[ℓ]) ^ (n + 1)) • (y : ∀ k : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (k + 1))) n :
        EllipticRootNumber.torsion F E (ℓ ^ (n + 1))) : EllipticRootNumber.Pts F E) = 0
    rw [EllipticRootNumber.padic_smul_torsion]
    have h0 : PadicInt.toZModPow (n + 1) ((ℓ : ℤ_[ℓ]) ^ (n + 1)) = 0 := by
      rw [map_pow, map_natCast, ← Nat.cast_pow, ZMod.natCast_self]
    rw [h0, ZMod.val_zero, zero_nsmul]
  
  have hker : ∀ x : EllipticRootNumber.tateModule F E,
      (((x : ∀ k : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (k + 1))) 0 :
        EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E) = 0 →
      ∃ y : EllipticRootNumber.tateModule F E, x = (ℓ : ℤ_[ℓ]) • y := by
    intro x hx0
    set xs : ∀ k : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (k + 1)) := x.1 with hxs
    have hmem : ∀ n, ℓ • ((xs (n + 1) : EllipticRootNumber.torsion F E _) :
        EllipticRootNumber.Pts F E) = (xs n : EllipticRootNumber.Pts F E) := x.2
    have hi : ∀ n : ℕ, ℓ ^ (n + 1) • ((xs (n + 1) : EllipticRootNumber.torsion F E _) :
        EllipticRootNumber.Pts F E) = 0 := by
      intro n
      induction n with
      | zero => rw [zero_add, pow_one, hmem 0, hx0]
      | succ k ih =>
        rw [pow_succ', mul_nsmul, hmem (k + 1), ih]
    let ys : ∀ k : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (k + 1)) := fun k =>
      ⟨(xs (k + 1) : EllipticRootNumber.Pts F E), (EllipticRootNumber.mem_torsion F E).mpr (hi k)⟩
    have hys : ys ∈ EllipticRootNumber.tateModule F E := by
      intro n
      exact hmem (n + 1)
    refine ⟨⟨ys, hys⟩, ?_⟩
    apply Subtype.ext
    funext n
    apply Subtype.ext
    show (xs n : EllipticRootNumber.Pts F E) =
      (((ℓ : ℤ_[ℓ]) • ys n : EllipticRootNumber.torsion F E (ℓ ^ (n + 1))) :
        EllipticRootNumber.Pts F E)
    rw [EllipticRootNumber.padic_smul_torsion, map_natCast, ZMod.val_natCast]
    rw [EllipticRootNumber.nsmul_eq_of_modEq F E (hi n) (Nat.mod_modEq ℓ (ℓ ^ (n + 1)))]
    exact (hmem n).symm
  
  let π₀ : EllipticRootNumber.tateModule F E → EllipticRootNumber.Pts F E := fun x =>
    (((x : ∀ k : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (k + 1))) 0 :
      EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E)
  have hfinT : {P : EllipticRootNumber.Pts F E | ℓ • P = 0}.Finite :=
    weierstrass_odd_torsion_finite (E.baseChange (AlgebraicClosure F)) ℓ hodd
  have hfin : (Set.range π₀).Finite := by
    refine hfinT.subset ?_
    rintro _ ⟨x, rfl⟩
    have h := ((x : ∀ k : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (k + 1))) 0).2
    rw [EllipticRootNumber.mem_torsion] at h
    show ℓ • π₀ x = 0
    calc ℓ • π₀ x = ℓ ^ (0 + 1) • π₀ x := by rw [zero_add, pow_one]
      _ = 0 := h
  
  haveI : Finite (Set.range π₀) := hfin.to_subtype
  let g : Set.range π₀ → EllipticRootNumber.tateModule F E := fun P => P.2.choose
  have hS : ∀ x : EllipticRootNumber.tateModule F E, ∃ s ∈ Set.range g,
      ∃ y : EllipticRootNumber.tateModule F E, x = s + (ℓ : ℤ_[ℓ]) • y := by
    intro x
    let P : Set.range π₀ := ⟨π₀ x, x, rfl⟩
    have hgP : π₀ (g P) = π₀ x := P.2.choose_spec
    refine ⟨g P, ⟨P, rfl⟩, ?_⟩
    obtain ⟨y, hy⟩ := hker (x - g P) (by
      change π₀ (x - g P) = 0
      have e : π₀ (x - g P) = π₀ x - π₀ (g P) := rfl
      rw [e, hgP, sub_self])
    exact ⟨y, sub_eq_iff_eq_add'.mp hy⟩
  
  haveI hℓprime : Fact ℓ.Prime := EllipticRootNumber.ell_prime F
  exact padicInt_module_finite_of_separated hsep (Set.range g) (Set.finite_range g) hS

theorem relVal_bot_spec (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] :
    EllipticRootNumber.resDeg F ⊥ = 1 ∧
    (∀ x y : (⊥ : IntermediateField F (AlgebraicClosure F)), x ≠ 0 → y ≠ 0 →
      EllipticRootNumber.relVal F ⊥ (x * y) =
        EllipticRootNumber.relVal F ⊥ x + EllipticRootNumber.relVal F ⊥ y) ∧
    (∃ x : (⊥ : IntermediateField F (AlgebraicClosure F)), EllipticRootNumber.relVal F ⊥ x = 1) :=
by
  classical
  have key : ∀ (z : WithZero (Multiplicative ℤ)) (hz : z ≠ 0),
      Multiplicative.toAdd (WithZero.unzero hz) = WithZero.log z := by
    intro z hz
    obtain ⟨u, rfl⟩ := WithZero.ne_zero_iff_exists.mp hz
    rw [WithZero.unzero_coe]
    show _ = WithZero.log (WithZero.exp (Multiplicative.toAdd u))
    rw [WithZero.log_exp]
  have hne : ∀ c : F, c ≠ 0 →
      IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (ValuativeRel.valuation F c) ≠ 0 :=
    fun c hc => (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hc)
  have s1 : ∀ a : F, a ≠ 0 → EllipticRootNumber.addVal F a =
      -WithZero.log (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
        (ValuativeRel.valuation F a)) := by
    intro a ha
    unfold EllipticRootNumber.addVal
    rw [dif_neg ha, key]
  have s2 : ∀ a b : F, a ≠ 0 → b ≠ 0 → EllipticRootNumber.addVal F (a * b) =
      EllipticRootNumber.addVal F a + EllipticRootNumber.addVal F b := by
    intro a b ha hb
    rw [s1 _ (mul_ne_zero ha hb), s1 _ ha, s1 _ hb, map_mul, map_mul,
      WithZero.log_mul (hne a ha) (hne b hb), neg_add]
  have s3 : ∃ a : F, a ≠ 0 ∧ EllipticRootNumber.addVal F a = 1 := by
    obtain ⟨γ, hγ⟩ := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).surjective
      (WithZero.exp (-1 : ℤ))
    obtain ⟨a, ha⟩ := ValuativeRel.valuation_surjective γ
    have ha0 : a ≠ 0 := by
      intro h
      apply WithZero.exp_ne_zero (a := (-1 : ℤ))
      rw [← hγ, ← ha, h, map_zero, map_zero]
    refine ⟨a, ha0, ?_⟩
    have hγ' : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F γ =
        WithZero.exp (-1 : ℤ) := hγ
    rw [s1 a ha0, ha, hγ', WithZero.log_exp, neg_neg]
  have s4 : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.relVal F ⊥ x =
        EllipticRootNumber.addVal F (IntermediateField.botEquiv F (AlgebraicClosure F) x) := by
    intro x
    unfold EllipticRootNumber.relVal
    congr 1
    have hx : x = algebraMap F (⊥ : IntermediateField F (AlgebraicClosure F))
        (IntermediateField.botEquiv F (AlgebraicClosure F) x) := by
      rw [← IntermediateField.botEquiv_symm, AlgEquiv.symm_apply_apply]
    conv_lhs => rw [hx]
    rw [Algebra.norm_algebraMap, IntermediateField.finrank_bot, pow_one]
  obtain ⟨a, ha0, ha1⟩ := s3
  have h3 : EllipticRootNumber.relVal F ⊥
      ((IntermediateField.botEquiv F (AlgebraicClosure F)).symm a) = 1 := by
    rw [s4, AlgEquiv.apply_symm_apply, ha1]
  have hx0 : (IntermediateField.botEquiv F (AlgebraicClosure F)).symm a ≠ 0 :=
    (map_ne_zero_iff _ (IntermediateField.botEquiv F (AlgebraicClosure F)).symm.injective).mpr ha0
  refine ⟨?_, ?_, ⟨_, h3⟩⟩
  · unfold EllipticRootNumber.resDeg
    have hmem : 1 ∈ {k : ℕ | 0 < k ∧ ∃ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        x ≠ 0 ∧ EllipticRootNumber.relVal F ⊥ x = k} :=
      ⟨one_pos, _, hx0, h3.trans Nat.cast_one.symm⟩
    apply le_antisymm (Nat.sInf_le hmem)
    exact (Nat.sInf_mem ⟨1, hmem⟩).1
  · intro x y hx hy
    have hx' : IntermediateField.botEquiv F (AlgebraicClosure F) x ≠ 0 :=
      (map_ne_zero_iff _ (IntermediateField.botEquiv F (AlgebraicClosure F)).injective).mpr hx
    have hy' : IntermediateField.botEquiv F (AlgebraicClosure F) y ≠ 0 :=
      (map_ne_zero_iff _ (IntermediateField.botEquiv F (AlgebraicClosure F)).injective).mpr hy
    rw [s4, s4, s4, map_mul, s2 _ _ hx' hy']

theorem stdChar_spec (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] :
    (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → EllipticRootNumber.stdChar F x = 1) ∧
    ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ EllipticRootNumber.stdChar F x ≠ 1 :=
by
  classical
  
  have absChar : ∀ (B : AddSubgroup F) (a : F), a ∉ B →
      ∃ ψ : AddChar F (EllipticRootNumber.Ω F), (∀ b ∈ B, ψ b = 1) ∧ ψ a ≠ 1 := by
    intro B a ha
    have hc0 : (a : F ⧸ B) ≠ 0 := by
      intro h; exact ha ((QuotientAddGroup.eq_zero_iff a).mp h)
    have hN1 : addOrderOf (a : F ⧸ B) ≠ 1 := by
      intro h; exact hc0 (AddMonoid.addOrderOf_eq_one_iff.mp h)
    obtain ⟨ζ, hζ0, hζN, hζ1⟩ : ∃ ζ : EllipticRootNumber.Ω F,
        ζ ≠ 0 ∧ ζ ^ addOrderOf (a : F ⧸ B) = 1 ∧ ζ ≠ 1 := by
      by_cases hN0 : addOrderOf (a : F ⧸ B) = 0
      · refine ⟨-1, by norm_num, by rw [hN0, pow_zero], ?_⟩
        intro h
        have h2 : (2 : EllipticRootNumber.Ω F) = 0 := by linear_combination -h
        exact two_ne_zero h2
      · haveI : NeZero ((addOrderOf (a : F ⧸ B) : ℕ) : EllipticRootNumber.Ω F) :=
          ⟨Nat.cast_ne_zero.mpr hN0⟩
        have hdeg := Polynomial.degree_cyclotomic_pos (addOrderOf (a : F ⧸ B))
          (EllipticRootNumber.Ω F) (by omega)
        obtain ⟨ζ, hζ⟩ := IsAlgClosed.exists_root
          (Polynomial.cyclotomic (addOrderOf (a : F ⧸ B)) (EllipticRootNumber.Ω F))
          (ne_of_gt hdeg)
        have hprim : IsPrimitiveRoot ζ (addOrderOf (a : F ⧸ B)) :=
          Polynomial.isRoot_cyclotomic_iff.mp hζ
        refine ⟨ζ, ?_, hprim.pow_eq_one, hprim.ne_one (by omega)⟩
        intro h0
        have h1 := hprim.pow_eq_one
        rw [h0, zero_pow hN0] at h1
        exact zero_ne_one h1
    set u : (EllipticRootNumber.Ω F)ˣ := Units.mk0 ζ hζ0 with hu
    have huN : u ^ ((addOrderOf (a : F ⧸ B) : ℕ) : ℤ) = 1 := by
      rw [zpow_natCast]; ext; simp [hu, hζN]
    have root : ∀ (w : (EllipticRootNumber.Ω F)ˣ) (n : ℤ), n ≠ 0 →
        ∃ x : (EllipticRootNumber.Ω F)ˣ, x ^ n = w := by
      intro w n hn
      have hm : 0 < n.natAbs := Int.natAbs_pos.mpr hn
      rcases Int.natAbs_eq n with h | h
      · obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (w : EllipticRootNumber.Ω F) hm
        have hz0 : z ≠ 0 := by
          rintro rfl; rw [zero_pow hm.ne'] at hz; exact w.ne_zero hz.symm
        refine ⟨Units.mk0 z hz0, ?_⟩
        rw [h, zpow_natCast]; ext; simp [hz]
      · obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq
          ((w⁻¹ : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) hm
        have hz0 : z ≠ 0 := by
          rintro rfl; rw [zero_pow hm.ne'] at hz; exact (w⁻¹).ne_zero hz.symm
        refine ⟨Units.mk0 z hz0, ?_⟩
        have h3 : Units.mk0 z hz0 ^ n.natAbs = w⁻¹ := by ext; simp [hz]
        rw [h, zpow_neg, zpow_natCast, h3, inv_inv]
    letI : DivisibleBy (Additive (EllipticRootNumber.Ω F)ˣ) ℤ :=
      DivisibleBy.mk
        (fun d n => if hn : n = 0 then 0
          else Additive.ofMul (Classical.choose (root (Additive.toMul d) n hn)))
        (fun d => dif_pos rfl)
        (fun {n} d hn => by
          simp only [dif_neg hn]
          rw [← ofMul_zpow, Classical.choose_spec (root (Additive.toMul d) n hn)]
          rfl)
    have hBaer : Module.Baer ℤ (Additive (EllipticRootNumber.Ω F)ˣ) :=
      Module.Baer.of_divisible _
    set h : ℤ →+ F ⧸ B := zmultiplesHom (F ⧸ B) (a : F ⧸ B) with hh
    set g₀ : ℤ →+ Additive (EllipticRootNumber.Ω F)ˣ :=
      zmultiplesHom (Additive (EllipticRootNumber.Ω F)ˣ) (Additive.ofMul u) with hg₀
    have hker : h.ker ≤ g₀.ker := by
      intro n hn
      rw [AddMonoidHom.mem_ker] at hn ⊢
      rw [hh, zmultiplesHom_apply] at hn
      obtain ⟨k, rfl⟩ := addOrderOf_dvd_iff_zsmul_eq_zero.mpr hn
      rw [hg₀, zmultiplesHom_apply, ← ofMul_zpow, zpow_mul, huN, one_zpow]
      rfl
    obtain ⟨G, hG⟩ := Module.Baer.extension_property hBaer
      (QuotientAddGroup.kerLift h).toIntLinearMap (QuotientAddGroup.kerLift_injective h)
      (QuotientAddGroup.lift h.ker g₀ hker).toIntLinearMap
    have hGc : G (a : F ⧸ B) = Additive.ofMul u := by
      have h1 := LinearMap.congr_fun hG ((1 : ℤ) : ℤ ⧸ h.ker)
      change G (QuotientAddGroup.kerLift h ((1 : ℤ) : ℤ ⧸ h.ker)) =
          QuotientAddGroup.lift h.ker g₀ hker ((1 : ℤ) : ℤ ⧸ h.ker) at h1
      rw [QuotientAddGroup.kerLift_mk, QuotientAddGroup.lift_mk, hh, hg₀, zmultiplesHom_apply,
        zmultiplesHom_apply, one_zsmul, one_zsmul] at h1
      exact h1
    refine ⟨AddChar.mk (fun x => ((Additive.toMul (G (x : F ⧸ B)) :
      (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F)) ?_ ?_, ?_, ?_⟩
    · simp
    · intro x y
      simp [QuotientAddGroup.mk_add, map_add, toMul_add]
    · intro b hb
      have hb0 : (b : F ⧸ B) = 0 := (QuotientAddGroup.eq_zero_iff b).mpr hb
      simp [hb0]
    · simp only [AddChar.coe_mk]
      rw [hGc, toMul_ofMul, hu, Units.val_mk0]
      exact hζ1
  
  set ι := IntermediateField.botEquiv F (AlgebraicClosure F) with hι
  set iso := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F with hiso
  
  have hav0 : EllipticRootNumber.addVal F 0 = 0 := by
    unfold EllipticRootNumber.addVal
    exact dif_pos rfl
  have key : ∀ (y : F) (m : Multiplicative ℤ),
      iso (ValuativeRel.valuation F y) = (m : WithZero (Multiplicative ℤ)) →
      EllipticRootNumber.addVal F y = -Multiplicative.toAdd m := by
    intro y m hm
    have hy : y ≠ 0 := by
      rintro rfl
      rw [map_zero, map_zero] at hm
      exact WithZero.zero_ne_coe hm
    unfold EllipticRootNumber.addVal
    rw [dif_neg hy]
    congr 2
    apply WithZero.coe_injective
    rw [WithZero.coe_unzero]
    exact hm
  have hiff : ∀ y : F, 0 ≤ EllipticRootNumber.addVal F y ↔ ValuativeRel.valuation F y ≤ 1 := by
    intro y
    by_cases hy : y = 0
    · subst hy
      rw [hav0, map_zero]
      exact ⟨fun _ => zero_le_one, fun _ => le_rfl⟩
    · have hne : iso (ValuativeRel.valuation F y) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hy)
      obtain ⟨m, hm⟩ : ∃ m : Multiplicative ℤ,
          iso (ValuativeRel.valuation F y) = (m : WithZero (Multiplicative ℤ)) :=
        ⟨_, (WithZero.coe_unzero hne).symm⟩
      rw [key y _ hm, neg_nonneg, ← map_le_map_iff iso, map_one, hm, WithZero.coe_le_one]
      show Multiplicative.toAdd m ≤ Multiplicative.toAdd (1 : Multiplicative ℤ) ↔ m ≤ 1
      exact Multiplicative.toAdd_le
  have hex : ∀ k : ℤ, ∃ y : F, EllipticRootNumber.addVal F y = -k := by
    intro k
    obtain ⟨y, hy⟩ := ValuativeRel.valuation_surjective
      (iso.symm ((Multiplicative.ofAdd k : Multiplicative ℤ) : WithZero (Multiplicative ℤ)))
    refine ⟨y, ?_⟩
    rw [key y (Multiplicative.ofAdd k) (by rw [hy]; exact iso.apply_symm_apply _), toAdd_ofAdd]
  
  have hnorm : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.relVal F ⊥ x = EllipticRootNumber.addVal F (ι x) := by
    intro x
    unfold EllipticRootNumber.relVal
    congr 1
    conv_lhs => rw [← ι.symm_apply_apply x]
    rw [hι, IntermediateField.botEquiv_symm, Algebra.norm_algebraMap,
      IntermediateField.finrank_bot, pow_one]
  
  have hres : EllipticRootNumber.resDeg F ⊥ = 1 := by
    obtain ⟨y₁, hy₁⟩ := hex (-1)
    have hy₁0 : y₁ ≠ 0 := by
      rintro rfl
      rw [hav0] at hy₁
      norm_num at hy₁
    have hmem : (1 : ℕ) ∈ {k : ℕ | 0 < k ∧ ∃ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        x ≠ 0 ∧ EllipticRootNumber.relVal F ⊥ x = k} := by
      refine ⟨one_pos, ι.symm y₁, (map_ne_zero ι.symm).mpr hy₁0, ?_⟩
      rw [hnorm, ι.apply_symm_apply, hy₁]
      norm_num
    unfold EllipticRootNumber.resDeg
    exact le_antisymm (Nat.sInf_le hmem) (Nat.sInf_mem ⟨1, hmem⟩).1
  have hvalL : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.addVal F (ι x) := by
    intro x
    unfold EllipticRootNumber.valL
    rw [hres, hnorm, Nat.cast_one, Int.ediv_one]
  
  obtain ⟨y₀, hy₀⟩ := hex 1
  set B : AddSubgroup F := (ValuativeRel.valuation F).integer.toAddSubgroup with hB
  have hmemB : ∀ t : F, t ∈ B ↔ ValuativeRel.valuation F t ≤ 1 := by
    intro t
    rw [hB, Subring.mem_toAddSubgroup, Valuation.mem_integer_iff]
  have hy₀B : y₀ ∉ B := by
    intro h
    have h1 := (hiff y₀).mpr ((hmemB y₀).mp h)
    rw [hy₀] at h1
    norm_num at h1
  obtain ⟨ψ₀, hψB, hψa⟩ := absChar B y₀ hy₀B
  set ψ := ψ₀.compAddMonoidHom ι.toRingEquiv.toRingHom.toAddMonoidHom with hψ
  have hψapp : ∀ x, ψ x = ψ₀ (ι x) := fun x => rfl
  have hP : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1 := by
    refine ⟨fun x hx => ?_, ι.symm y₀, ?_, ?_⟩
    · rw [hψapp]
      apply hψB
      rw [hmemB, ← hiff, ← hvalL]
      exact hx
    · rw [hvalL, ι.apply_symm_apply, hy₀]
    · rw [hψapp, ι.apply_symm_apply]
      exact hψa
  have hexψ : ∃ φ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F),
      (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → φ x = 1) ∧
        ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ φ x ≠ 1 := ⟨ψ, hP⟩
  unfold EllipticRootNumber.stdChar
  exact Classical.epsilon_spec hexψ

theorem weilDegreeHom_ker_le_inertia (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] :
    ∀ w : EllipticRootNumber.weilGroup F, EllipticRootNumber.weilDegreeHom F w = 1 →
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F :=
by
  classical
  
  have s1 : (EllipticRootNumber.p F).Prime ∧
      ∃ f : ℕ, 0 < f ∧ EllipticRootNumber.q F = EllipticRootNumber.p F ^ f := by
    letI := Fintype.ofFinite (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
    haveI := ringChar.charP (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
    obtain ⟨n, hp, hn⟩ := FiniteField.card
      (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
      (ringChar (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer))
    refine ⟨hp, n, n.pos, ?_⟩
    unfold EllipticRootNumber.q EllipticRootNumber.p
    rw [Nat.card_eq_fintype_card, hn]
  
  have s2 : ∀ N : ℕ, ¬ EllipticRootNumber.p F ∣ N → (N : AlgebraicClosure F) ≠ 0 := by
    intro N hN h0
    apply hN
    have h1 : (N : F) = 0 := by
      apply (algebraMap F (AlgebraicClosure F)).injective
      rw [map_natCast, map_zero]
      exact h0
    have h2 : (N : ↥(ValuativeRel.valuation F).integer) = 0 := by
      apply Subtype.ext
      simp [h1]
    have h3 : (N : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) = 0 := by
      rw [← map_natCast (IsLocalRing.residue ↥(ValuativeRel.valuation F).integer), h2, map_zero]
    exact ringChar.dvd h3
  obtain ⟨hp, f, hf, hq⟩ := s1
  
  have memσ : ∀ (σ : EllipticRootNumber.AbsGal F) (ζ : AlgebraicClosure F),
      EllipticRootNumber.IsPrimeToPRootOfUnity F ζ →
      EllipticRootNumber.IsPrimeToPRootOfUnity F (σ ζ) := by
    rintro σ ζ ⟨N, hN0, hpN, hζ⟩
    exact ⟨N, hN0, hpN, by rw [← map_pow, hζ, map_one]⟩
  have mempow : ∀ (ζ : AlgebraicClosure F) (k : ℕ),
      EllipticRootNumber.IsPrimeToPRootOfUnity F ζ →
      EllipticRootNumber.IsPrimeToPRootOfUnity F (ζ ^ k) := by
    rintro ζ k ⟨N, hN0, hpN, hζ⟩
    exact ⟨N, hN0, hpN, by rw [← pow_mul, mul_comm, pow_mul, hζ, one_pow]⟩
  
  have hcancel : ∀ x y : AlgebraicClosure F, EllipticRootNumber.IsPrimeToPRootOfUnity F x →
      EllipticRootNumber.IsPrimeToPRootOfUnity F y → ∀ c : ℕ,
      x ^ (EllipticRootNumber.q F ^ c) = y ^ (EllipticRootNumber.q F ^ c) → x = y := by
    rintro x y ⟨a, ha0, hpa, hxa⟩ ⟨b, hb0, hpb, hyb⟩ c h
    have hy0 : y ≠ 0 := by
      rintro rfl
      rw [zero_pow hb0.ne'] at hyb
      exact zero_ne_one hyb
    have hz1 : (x * y⁻¹) ^ (a * b) = 1 := by
      rw [mul_pow, inv_pow, pow_mul, hxa, one_pow, mul_comm a b, pow_mul, hyb, one_pow, inv_one,
        mul_one]
    have hz2 : (x * y⁻¹) ^ (EllipticRootNumber.q F ^ c) = 1 := by
      rw [mul_pow, inv_pow, h, mul_inv_cancel₀ (pow_ne_zero _ hy0)]
    have hcop : Nat.Coprime (EllipticRootNumber.q F ^ c) (a * b) := by
      rw [hq, ← pow_mul]
      apply Nat.Coprime.pow_left
      exact (Nat.Prime.coprime_iff_not_dvd hp).mpr (fun hd => (hp.dvd_mul.mp hd).elim hpa hpb)
    have h3 : (x * y⁻¹) ^ (Nat.gcd (EllipticRootNumber.q F ^ c) (a * b)) = 1 :=
      pow_gcd_eq_one.mpr ⟨hz2, hz1⟩
    rw [hcop.gcd_eq_one, pow_one] at h3
    exact (mul_inv_eq_one₀ hy0).mp h3
  
  have hsep : ∀ s t : ℕ, s < t → ∃ ζ : AlgebraicClosure F,
      EllipticRootNumber.IsPrimeToPRootOfUnity F ζ ∧
        ζ ^ (EllipticRootNumber.q F ^ s) ≠ ζ ^ (EllipticRootNumber.q F ^ t) := by
    intro s t hst
    have hq2 : 2 ≤ EllipticRootNumber.q F := by
      rw [hq]
      calc 2 ≤ EllipticRootNumber.p F := hp.two_le
        _ = EllipticRootNumber.p F ^ 1 := (pow_one _).symm
        _ ≤ EllipticRootNumber.p F ^ f := Nat.pow_le_pow_right hp.pos hf
    have hpq : EllipticRootNumber.p F ∣ EllipticRootNumber.q F ^ t := by
      rw [hq, ← pow_mul]
      exact dvd_pow_self _ (Nat.mul_ne_zero (by omega) (by omega))
    have hpM : ¬ EllipticRootNumber.p F ∣ EllipticRootNumber.q F ^ t + 1 := by
      intro h
      exact hp.not_dvd_one ((Nat.dvd_add_right hpq).mp h)
    haveI : NeZero ((EllipticRootNumber.q F ^ t + 1 : ℕ) : AlgebraicClosure F) := ⟨s2 _ hpM⟩
    obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (AlgebraicClosure F)
      (EllipticRootNumber.q F ^ t + 1)
    refine ⟨ζ, ⟨_, Nat.succ_pos _, hpM, hζ.pow_eq_one⟩, fun heq => ?_⟩
    have h1 : ζ ^ (EllipticRootNumber.q F ^ s + 1) = 1 := by
      rw [pow_succ, heq, ← pow_succ, hζ.pow_eq_one]
    have h2 := Nat.le_of_dvd (Nat.succ_pos _) ((hζ.pow_eq_one_iff_dvd _).mp h1)
    have h3 : EllipticRootNumber.q F ^ s < EllipticRootNumber.q F ^ t :=
      Nat.pow_lt_pow_right hq2 hst
    omega
  
  have hone : EllipticRootNumber.ActsAsFrobPow F 1 0 := by
    intro ζ _
    simp
  have hinv : ∀ (σ : EllipticRootNumber.AbsGal F) (n : ℤ), EllipticRootNumber.ActsAsFrobPow F σ n →
      EllipticRootNumber.ActsAsFrobPow F σ⁻¹ (-n) := by
    intro σ n h ζ hζ
    have h1 := h (σ⁻¹ ζ) (memσ _ _ hζ)
    have h2 : σ (σ⁻¹ ζ) = ζ := by
      rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
    rw [h2] at h1
    rw [neg_neg]
    exact h1.symm
  have hmul : ∀ (σ τ : EllipticRootNumber.AbsGal F) (n m : ℤ),
      EllipticRootNumber.ActsAsFrobPow F σ n → EllipticRootNumber.ActsAsFrobPow F τ m →
      EllipticRootNumber.ActsAsFrobPow F (σ * τ) (n + m) := by
    intro σ τ n m hn hm ζ hζ
    have e1 := hm ζ hζ
    have e2 := hn (τ ζ) (memσ _ _ hζ)
    rw [AlgEquiv.mul_apply]
    have E : (σ (τ ζ)) ^ (EllipticRootNumber.q F ^ ((-n).toNat + (-m).toNat)) =
        ζ ^ (EllipticRootNumber.q F ^ (n.toNat + m.toNat)) := by
      calc (σ (τ ζ)) ^ (EllipticRootNumber.q F ^ ((-n).toNat + (-m).toNat))
          = ((σ (τ ζ)) ^ (EllipticRootNumber.q F ^ (-n).toNat)) ^
              (EllipticRootNumber.q F ^ (-m).toNat) := by rw [pow_add, pow_mul]
        _ = ((τ ζ) ^ (EllipticRootNumber.q F ^ (-m).toNat)) ^
              (EllipticRootNumber.q F ^ n.toNat) := by rw [e2, pow_right_comm]
        _ = ζ ^ (EllipticRootNumber.q F ^ (n.toNat + m.toNat)) := by
              rw [e1, ← pow_mul, ← pow_add, Nat.add_comm m.toNat]
    have t1 := Int.toNat_eq_max n
    have t2 := Int.toNat_eq_max m
    have t3 := Int.toNat_eq_max (-n)
    have t4 := Int.toNat_eq_max (-m)
    have t5 := Int.toNat_eq_max (n + m)
    have t6 := Int.toNat_eq_max (-(n + m))
    obtain ⟨c, hc1, hc2⟩ : ∃ c : ℕ, n.toNat + m.toNat = (n + m).toNat + c ∧
        (-n).toNat + (-m).toNat = (-(n + m)).toNat + c := by
      refine ⟨n.toNat + m.toNat - (n + m).toNat, ?_, ?_⟩ <;> omega
    have hx := mempow (σ (τ ζ)) (EllipticRootNumber.q F ^ (-(n + m)).toNat)
      (memσ _ _ (memσ _ _ hζ))
    have hy := mempow ζ (EllipticRootNumber.q F ^ (n + m).toNat) hζ
    apply hcancel _ _ hx hy c
    rw [← pow_mul, ← pow_mul, ← pow_add, ← pow_add, ← hc1, ← hc2]
    exact E
  
  have huniq : ∀ (σ : EllipticRootNumber.AbsGal F) (n m : ℤ),
      EllipticRootNumber.ActsAsFrobPow F σ n → EllipticRootNumber.ActsAsFrobPow F σ m → n = m := by
    intro σ n m hn hm
    have U : ∀ ζ : AlgebraicClosure F, EllipticRootNumber.IsPrimeToPRootOfUnity F ζ →
        ζ ^ (EllipticRootNumber.q F ^ (n.toNat + (-m).toNat)) =
          ζ ^ (EllipticRootNumber.q F ^ (m.toNat + (-n).toNat)) := by
      intro ζ hζ
      calc ζ ^ (EllipticRootNumber.q F ^ (n.toNat + (-m).toNat))
          = (ζ ^ (EllipticRootNumber.q F ^ n.toNat)) ^ (EllipticRootNumber.q F ^ (-m).toNat) := by
            rw [pow_add, pow_mul]
        _ = ((σ ζ) ^ (EllipticRootNumber.q F ^ (-n).toNat)) ^
              (EllipticRootNumber.q F ^ (-m).toNat) := by rw [hn ζ hζ]
        _ = ((σ ζ) ^ (EllipticRootNumber.q F ^ (-m).toNat)) ^
              (EllipticRootNumber.q F ^ (-n).toNat) := pow_right_comm _ _ _
        _ = (ζ ^ (EllipticRootNumber.q F ^ m.toNat)) ^ (EllipticRootNumber.q F ^ (-n).toNat) := by
            rw [hm ζ hζ]
        _ = ζ ^ (EllipticRootNumber.q F ^ (m.toNat + (-n).toNat)) := by
            rw [← pow_mul, ← pow_add]
    by_contra hne
    have t1 := Int.toNat_eq_max n
    have t2 := Int.toNat_eq_max m
    have t3 := Int.toNat_eq_max (-n)
    have t4 := Int.toNat_eq_max (-m)
    rcases lt_or_gt_of_ne (show n.toNat + (-m).toNat ≠ m.toNat + (-n).toNat by omega) with h | h
    · obtain ⟨ζ, hζ, hne'⟩ := hsep _ _ h
      exact hne' (U ζ hζ)
    · obtain ⟨ζ, hζ, hne'⟩ := hsep _ _ h
      exact hne' (U ζ hζ).symm
  
  have s7 : ∀ σ : EllipticRootNumber.AbsGal F,
      (∀ ζ : AlgebraicClosure F, EllipticRootNumber.IsPrimeToPRootOfUnity F ζ → σ ζ = ζ) →
      σ ∈ EllipticRootNumber.inertia F := by
    intro σ hσ
    unfold EllipticRootNumber.inertia EllipticRootNumber.unramifiedClosure
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    induction hx using IntermediateField.adjoin_induction with
    | mem x hx => exact hσ x hx
    | algebraMap r => exact σ.commutes r
    | add x y _ _ hx hy => rw [map_add, hx, hy]
    | inv x _ hx => rw [map_inv₀, hx]
    | mul x y _ _ hx hy => rw [map_mul, hx, hy]
  
  have hex : ∀ σ ∈ EllipticRootNumber.weilGroup F,
      ∃ n : ℤ, EllipticRootNumber.ActsAsFrobPow F σ n := by
    intro σ hσ
    unfold EllipticRootNumber.weilGroup at hσ
    induction hσ using Subgroup.closure_induction with
    | mem x hx => exact hx
    | one => exact ⟨0, hone⟩
    | mul x y _ _ hx hy =>
      obtain ⟨n, hn⟩ := hx
      obtain ⟨m, hm⟩ := hy
      exact ⟨n + m, hmul _ _ _ _ hn hm⟩
    | inv x _ hx =>
      obtain ⟨n, hn⟩ := hx
      exact ⟨-n, hinv _ _ hn⟩
  let deg : EllipticRootNumber.weilGroup F → ℤ := fun σ => Classical.choose (hex σ σ.2)
  have hdeg : ∀ σ : EllipticRootNumber.weilGroup F,
      EllipticRootNumber.ActsAsFrobPow F σ (deg σ) := fun σ => Classical.choose_spec (hex σ σ.2)
  let φ : EllipticRootNumber.weilGroup F →* Multiplicative ℤ :=
    { toFun := fun σ => Multiplicative.ofAdd (deg σ)
      map_one' := by
        show Multiplicative.ofAdd (deg 1) = 1
        rw [huniq _ _ _ (hdeg 1) hone]
        rfl
      map_mul' := by
        intro σ τ
        show Multiplicative.ofAdd (deg (σ * τ)) =
          Multiplicative.ofAdd (deg σ) * Multiplicative.ofAdd (deg τ)
        rw [huniq _ _ _ (hdeg (σ * τ)) (hmul _ _ _ _ (hdeg σ) (hdeg τ))]
        rfl }
  have hP : ∀ (σ : EllipticRootNumber.weilGroup F) (n : ℤ),
      EllipticRootNumber.ActsAsFrobPow F σ n →
        EllipticRootNumber.weilDegreeHom F σ = Multiplicative.ofAdd n := by
    have key := Classical.epsilon_spec
      (p := fun g : EllipticRootNumber.weilGroup F →* Multiplicative ℤ =>
        ∀ (σ : EllipticRootNumber.weilGroup F) (n : ℤ),
          EllipticRootNumber.ActsAsFrobPow F σ n → g σ = Multiplicative.ofAdd n)
      ⟨φ, fun σ n hn => by
        show Multiplicative.ofAdd (deg σ) = Multiplicative.ofAdd n
        rw [huniq _ _ _ (hdeg σ) hn]⟩
    intro σ n hn
    exact key σ n hn
  
  intro w hw
  obtain ⟨n, hn⟩ := hex w w.2
  have h1 := hP w n hn
  rw [hw] at h1
  have hn0 : n = 0 := ofAdd_eq_one.mp h1.symm
  subst hn0
  apply s7
  intro ζ hζ
  have := hn ζ hζ
  simpa using this

theorem eps_eq_one_of_unramified (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] {rec : EllipticRootNumber.LocalReciprocity F}
    (lc : EllipticRootNumber.LocalConstants F rec)
    {V : Type u} [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
    [FiniteDimensional (EllipticRootNumber.Ω F) V]
    (ρ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V)
    (hρ : ∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → ρ w = 1) :
    lc.eps ⊥ ρ (EllipticRootNumber.stdChar F) = 1 :=
by
  have hbot := relVal_bot_spec F
  have hstd := stdChar_spec F
  have hker := weilDegreeHom_ker_le_inertia F
  have hψ : EllipticRootNumber.IsAdmissibleChar F ⊥ (EllipticRootNumber.stdChar F) := by
    refine ⟨fun h => ?_, 0, fun x hx => hstd.1 x hx⟩
    obtain ⟨x, -, hx⟩ := hstd.2
    exact hx (by rw [h, AddChar.one_apply])
  
  have hchar : ∀ χ : EllipticRootNumber.relWeil F ⊥ →* (EllipticRootNumber.Ω F)ˣ,
      (∀ w : EllipticRootNumber.relWeil F ⊥,
        (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → χ w = 1) →
      lc.eps ⊥ (EllipticRootNumber.charRep F ⊥ χ) (EllipticRootNumber.stdChar F) = 1 := by
    intro χ hχ
    obtain ⟨hres, hadd, -⟩ := hbot
    have hvalL : ∀ x, EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.relVal F ⊥ x := by
      intro x
      unfold EllipticRootNumber.valL
      rw [hres]
      simp
    have hrel1 : EllipticRootNumber.relVal F ⊥ 1 = 0 := by
      have h := hadd 1 1 one_ne_zero one_ne_zero
      rw [mul_one] at h
      omega
    have hK' : ∀ g : EllipticRootNumber.relWeil F ⊥,
        EllipticRootNumber.weilDegreeHom F
          (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) g) = 1 → χ g = 1 :=
      fun g hg => hχ g (hker _ hg)
    have hK : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
        EllipticRootNumber.relVal F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 →
          χ (rec.recMap ⊥ x) = 1 := by
      intro x hx
      apply hK'
      rw [rec.degree_rec ⊥ x, hx, neg_zero, ofAdd_zero]
    let χ' : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (EllipticRootNumber.Ω F)ˣ :=
      { toFun := fun x => χ (rec.recMap ⊥ x)
        map_one' := hK 1 (by rw [Units.val_one]; exact hrel1)
        map_mul' := by
          intro x y
          have hg : χ ((rec.recMap ⊥ (x * y))⁻¹ * (rec.recMap ⊥ x * rec.recMap ⊥ y)) = 1 := by
            apply hK'
            have h1 := congrArg (fun g => EllipticRootNumber.weilDegreeHom F
              (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) g))
              (mul_inv_cancel_left (rec.recMap ⊥ (x * y)) (rec.recMap ⊥ x * rec.recMap ⊥ y))
            have hxy := hadd _ _ (Units.ne_zero x) (Units.ne_zero y)
            rw [← Units.val_mul] at hxy
            simp only [map_mul, rec.degree_rec] at h1 ⊢
            apply Multiplicative.toAdd.injective
            have h2 := congrArg Multiplicative.toAdd h1
            simp only [toAdd_mul, toAdd_ofAdd, toAdd_one] at h2 ⊢
            omega
          show χ (rec.recMap ⊥ (x * y)) = χ (rec.recMap ⊥ x) * χ (rec.recMap ⊥ y)
          rw [← map_mul, ← mul_inv_cancel_left (rec.recMap ⊥ (x * y))
            (rec.recMap ⊥ x * rec.recMap ⊥ y), map_mul χ (rec.recMap ⊥ (x * y)), hg, mul_one] }
    have hW : EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ χ) := by
      refine ⟨?_, Set.univ, Filter.univ_mem, fun w _ hw => ?_⟩
      · exact Module.Finite.equiv ULift.moduleEquiv.symm
      · show (χ w : EllipticRootNumber.Ω F) • LinearMap.id = 1
        rw [hχ w hw, Units.val_one, one_smul]
        rfl
    have he := lc.eps_char ⊥ (EllipticRootNumber.stdChar F) hψ χ hW χ' (fun x => rfl)
    have hc1 : EllipticRootNumber.condExpChar F ⊥ (EllipticRootNumber.stdChar F) = 0 := by
      unfold EllipticRootNumber.condExpChar
      apply IsGreatest.csSup_eq
      refine ⟨fun x hx => hstd.1 x (by simpa using hx), fun d hd => ?_⟩
      by_contra hlt
      push_neg at hlt
      obtain ⟨x, hx1, hx2⟩ := hstd.2
      exact hx2 (hd x (by omega))
    have hc2 : EllipticRootNumber.condExp F ⊥ χ' = 0 := by
      unfold EllipticRootNumber.condExp
      apply Nat.sInf_eq_zero.mpr
      left
      intro u hu
      unfold EllipticRootNumber.unitGroup at hu
      simp only [if_true] at hu
      refine MonoidHom.mem_ker.mp ((Subgroup.closure_le χ'.ker).mpr ?_ hu)
      intro v hv
      exact MonoidHom.mem_ker.mpr (hK v (by rw [← hvalL]; exact hv))
    have hte : EllipticRootNumber.valL F ⊥
        (EllipticRootNumber.tateElt F ⊥ χ' (EllipticRootNumber.stdChar F) :
          (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
      have h := Classical.epsilon_spec
        (p := fun c : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ =>
          EllipticRootNumber.valL F ⊥ c = EllipticRootNumber.condExp F ⊥ χ' +
            EllipticRootNumber.condExpChar F ⊥ (EllipticRootNumber.stdChar F))
        ⟨1, by beta_reduce; rw [hc1, hc2, hvalL, Units.val_one, hrel1]; simp⟩
      exact h.trans (by rw [hc1, hc2]; simp)
    have hχt : χ' (EllipticRootNumber.tateElt F ⊥ χ' (EllipticRootNumber.stdChar F)) = 1 :=
      hK _ (by rw [← hvalL]; exact hte)
    apply Units.ext
    rw [he, Units.val_one]
    unfold EllipticRootNumber.tateEps
    rw [hc1, if_pos hc2, zpow_zero, one_mul, hχt, Units.val_one]
  
  have heig : ∀ (n : ℕ) (W : Type u) [AddCommGroup W] [Module (EllipticRootNumber.Ω F) W]
      [FiniteDimensional (EllipticRootNumber.Ω F) W],
      Module.finrank (EllipticRootNumber.Ω F) W = n → Nontrivial W →
      ∀ (f : EllipticRootNumber.relWeil F ⊥ → Module.End (EllipticRootNumber.Ω F) W),
      (∀ i j, f i * f j = f j * f i) →
      ∃ v : W, v ≠ 0 ∧ ∀ i, ∃ c : EllipticRootNumber.Ω F, f i v = c • v := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
    intro W _ _ _ hn hW f hf
    by_cases hsc : ∀ i, ∃ c : EllipticRootNumber.Ω F, f i = c • 1
    · obtain ⟨v, hv⟩ := exists_ne (0 : W)
      refine ⟨v, hv, fun i => ?_⟩
      obtain ⟨c, hc⟩ := hsc i
      exact ⟨c, by rw [hc]; rfl⟩
    · push_neg at hsc
      obtain ⟨i₀, hi₀⟩ := hsc
      obtain ⟨μ, hμ⟩ := Module.End.exists_eigenvalue (f i₀)
      have hEbot : (f i₀).eigenspace μ ≠ ⊥ := Module.End.hasEigenvalue_iff.mp hμ
      have hEtop : (f i₀).eigenspace μ ≠ ⊤ := by
        intro htop
        apply hi₀ μ
        apply LinearMap.ext
        intro x
        have hx : x ∈ (f i₀).eigenspace μ := htop ▸ Submodule.mem_top
        rw [Module.End.mem_eigenspace_iff] at hx
        rw [hx]
        rfl
      have hinv : ∀ j, ∀ x ∈ (f i₀).eigenspace μ, f j x ∈ (f i₀).eigenspace μ := by
        intro j x hx
        rw [Module.End.mem_eigenspace_iff] at hx ⊢
        rw [← Module.End.mul_apply, hf i₀ j, Module.End.mul_apply, hx, map_smul]
      let g : EllipticRootNumber.relWeil F ⊥ →
          Module.End (EllipticRootNumber.Ω F) ((f i₀).eigenspace μ) :=
        fun j => (f j).restrict (hinv j)
      have hg : ∀ i j, g i * g j = g j * g i := by
        intro i j
        apply LinearMap.ext
        intro x
        apply Subtype.ext
        show f i (f j x) = f j (f i x)
        rw [← Module.End.mul_apply, hf i j, Module.End.mul_apply]
      have hlt : Module.finrank (EllipticRootNumber.Ω F) ((f i₀).eigenspace μ) < n :=
        hn ▸ Submodule.finrank_lt hEtop
      haveI : Nontrivial ((f i₀).eigenspace μ) := Submodule.nontrivial_iff_ne_bot.mpr hEbot
      obtain ⟨v, hv, hvc⟩ := ih _ hlt ((f i₀).eigenspace μ) rfl inferInstance g hg
      refine ⟨(v : W), fun h => hv (Submodule.coe_eq_zero.mp h), fun i => ?_⟩
      obtain ⟨c, hc⟩ := hvc i
      exact ⟨c, congrArg Subtype.val hc⟩
  
  have hWeil : ∀ (X : Type u) [AddCommGroup X] [Module (EllipticRootNumber.Ω F) X]
      [FiniteDimensional (EllipticRootNumber.Ω F) X]
      (τ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) X),
      (∀ w : EllipticRootNumber.relWeil F ⊥,
        (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → τ w = 1) →
      EllipticRootNumber.IsWeilRep F ⊥ τ :=
    fun X _ _ _ τ hτ => ⟨inferInstance, Set.univ, Filter.univ_mem, fun w _ hw => hτ w hw⟩
  
  have main : ∀ (n : ℕ) (W : Type u) [AddCommGroup W] [Module (EllipticRootNumber.Ω F) W]
      [FiniteDimensional (EllipticRootNumber.Ω F) W]
      (σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) W),
      (∀ w : EllipticRootNumber.relWeil F ⊥,
        (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → σ w = 1) →
      Module.finrank (EllipticRootNumber.Ω F) W = n →
      lc.eps ⊥ σ (EllipticRootNumber.stdChar F) = 1 := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
    intro W _ _ _ σ hσ hn
    rcases Nat.eq_zero_or_pos n with h0 | hpos
    · subst h0
      haveI : Subsingleton W := Module.finrank_zero_iff.mp hn
      have h := lc.eps_exact ⊥ (EllipticRootNumber.stdChar F) hψ σ σ σ
        (hWeil W σ hσ) (hWeil W σ hσ) (hWeil W σ hσ) LinearMap.id LinearMap.id
        (fun w => by rw [LinearMap.id_comp, LinearMap.comp_id])
        (fun w => by rw [LinearMap.id_comp, LinearMap.comp_id])
        Function.injective_id Function.surjective_id (Subsingleton.elim _ _)
      exact mul_eq_left.mp h.symm
    · haveI : Nontrivial W := Module.finrank_pos_iff.mp (hn ▸ hpos)
      have hcomm : ∀ w w' : EllipticRootNumber.relWeil F ⊥, σ w * σ w' = σ w' * σ w := by
        intro w w'
        have hc : σ ((w' * w)⁻¹ * (w * w')) = 1 := by
          apply hσ
          refine hker (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥)
            ((w' * w)⁻¹ * (w * w'))) ?_
          have h1 := congrArg (fun g => EllipticRootNumber.weilDegreeHom F
            (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) g))
            (mul_inv_cancel_left (w' * w) (w * w'))
          simp only [map_mul] at h1 ⊢
          apply Multiplicative.toAdd.injective
          have h2 := congrArg Multiplicative.toAdd h1
          simp only [toAdd_mul, toAdd_one] at h2 ⊢
          omega
        calc σ w * σ w' = σ (w * w') := (map_mul σ w w').symm
          _ = σ ((w' * w) * ((w' * w)⁻¹ * (w * w'))) := by rw [mul_inv_cancel_left]
          _ = σ w' * σ w := by rw [map_mul σ (w' * w), hc, mul_one, map_mul]
      obtain ⟨v, hv0, hv⟩ := heig _ W rfl inferInstance (fun w => σ w) hcomm
      choose c hc using hv
      have huniq : ∀ a b : EllipticRootNumber.Ω F, a • v = b • v → a = b :=
        fun a b h => smul_left_injective _ hv0 h
      have hcne : ∀ w, c w ≠ 0 := by
        intro w h0
        apply hv0
        have h1 : σ w⁻¹ (σ w v) = v := by
          rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one, Module.End.one_apply]
        rw [hc w, h0, zero_smul, map_zero] at h1
        exact h1.symm
      let χ : EllipticRootNumber.relWeil F ⊥ →* (EllipticRootNumber.Ω F)ˣ :=
        { toFun := fun w => Units.mk0 (c w) (hcne w)
          map_one' := by
            apply Units.ext
            show c 1 = 1
            apply huniq
            rw [← hc 1, map_one, Module.End.one_apply, one_smul]
          map_mul' := by
            intro a b
            apply Units.ext
            show c (a * b) = c a * c b
            apply huniq
            rw [← hc (a * b), map_mul, Module.End.mul_apply, hc b, map_smul, hc a, smul_smul,
              mul_comm] }
      have hχ : ∀ w : EllipticRootNumber.relWeil F ⊥,
          (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → χ w = 1 := by
        intro w hw
        apply Units.ext
        show c w = 1
        apply huniq
        rw [← hc w, hσ w hw, Module.End.one_apply, one_smul]
      set P : Submodule (EllipticRootNumber.Ω F) W := Submodule.span (EllipticRootNumber.Ω F) {v}
        with hP
      have hPinv : ∀ w, P ≤ P.comap (σ w) := by
        intro w x hx
        obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hx
        show σ w (a • v) ∈ P
        rw [map_smul, hc w, smul_smul]
        exact Submodule.mem_span_singleton.mpr ⟨_, rfl⟩
      let σbar : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥)
          (W ⧸ P) :=
        { toFun := fun w => P.mapQ P (σ w) (hPinv w)
          map_one' := by
            apply Submodule.linearMap_qext
            apply LinearMap.ext
            intro x
            simp only [LinearMap.comp_apply, Submodule.mkQ_apply, Submodule.mapQ_apply, map_one,
              Module.End.one_apply]
          map_mul' := by
            intro a b
            apply Submodule.linearMap_qext
            apply LinearMap.ext
            intro x
            simp only [LinearMap.comp_apply, Submodule.mkQ_apply, Submodule.mapQ_apply, map_mul,
              Module.End.mul_apply] }
      have hσbar : ∀ w : EllipticRootNumber.relWeil F ⊥,
          (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → σbar w = 1 := by
        intro w hw
        apply Submodule.linearMap_qext
        apply LinearMap.ext
        intro x
        simp only [σbar, MonoidHom.coe_mk, OneHom.coe_mk, LinearMap.comp_apply,
          Submodule.mkQ_apply, Submodule.mapQ_apply, hσ w hw, Module.End.one_apply]
      have hdim : Module.finrank (EllipticRootNumber.Ω F) (W ⧸ P) < n := by
        have h1 := Submodule.finrank_quotient_add_finrank P
        have h2 : Module.finrank (EllipticRootNumber.Ω F) P = 1 := finrank_span_singleton hv0
        omega
      let f : ULift.{u} (EllipticRootNumber.Ω F) →ₗ[EllipticRootNumber.Ω F] W :=
        (LinearMap.toSpanSingleton (EllipticRootNumber.Ω F) W v).comp
          ULift.moduleEquiv.toLinearMap
      have hfinj : Function.Injective f := by
        intro s t hst
        apply ULift.ext
        exact huniq _ _ hst
      have hrk : LinearMap.range f = LinearMap.ker P.mkQ := by
        rw [Submodule.ker_mkQ]
        ext x
        constructor
        · rintro ⟨t, rfl⟩
          exact Submodule.mem_span_singleton.mpr ⟨t.down, rfl⟩
        · intro hx
          obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hx
          exact ⟨ULift.up a, rfl⟩
      have hfint : ∀ w, f ∘ₗ EllipticRootNumber.charRep F ⊥ χ w = σ w ∘ₗ f := by
        intro w
        apply LinearMap.ext
        intro t
        show (c w * t.down) • v = σ w (t.down • v)
        rw [map_smul, hc w, smul_smul, mul_comm]
      have hgint : ∀ w, P.mkQ ∘ₗ σ w = σbar w ∘ₗ P.mkQ := by
        intro w
        apply LinearMap.ext
        intro x
        rfl
      haveI : FiniteDimensional (EllipticRootNumber.Ω F) (ULift.{u} (EllipticRootNumber.Ω F)) :=
        Module.Finite.equiv ULift.moduleEquiv.symm
      have hWχ : EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ χ) :=
        hWeil _ _ (fun w hw => by
          show (χ w : EllipticRootNumber.Ω F) • LinearMap.id = 1
          rw [hχ w hw, Units.val_one, one_smul]
          rfl)
      have h := lc.eps_exact ⊥ (EllipticRootNumber.stdChar F) hψ
        (EllipticRootNumber.charRep F ⊥ χ) σ σbar hWχ (hWeil W σ hσ) (hWeil (W ⧸ P) σbar hσbar)
        f P.mkQ hfint hgint hfinj (Submodule.mkQ_surjective P) hrk
      rw [h, hchar χ hχ, ih _ hdim (W ⧸ P) σbar hσbar rfl, mul_one]
  exact main _ V ρ hρ rfl

theorem rootNumber_good_odd {K : Type u} [Field K] [NumberField K] (e₁ e₂ e₃ : K)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : IsDedekindDomain.HeightOneSpectrum.valuation K v 2 = 1)
    (hα : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) = 1)
    (hβ : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) = 1)
    (hγ : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₂ - e₃) = 1) :
    rootNumber ((threeRootsCurve e₁ e₂ e₃).baseChange (v.adicCompletion K)) = 1 :=
by
  classical
  
  
  
  have abstract : ∀ (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
      [IsNonarchimedeanLocalField F] [CharZero F] (E : WeierstrassCurve F)
      (C : WeierstrassCurve.VariableChange F),
      ValuativeRel.valuation F (C • E).a₁ ≤ 1 → ValuativeRel.valuation F (C • E).a₂ ≤ 1 →
      ValuativeRel.valuation F (C • E).a₃ ≤ 1 → ValuativeRel.valuation F (C • E).a₄ ≤ 1 →
      ValuativeRel.valuation F (C • E).a₆ ≤ 1 → ValuativeRel.valuation F (C • E).Δ = 1 →
      EllipticRootNumber.rootNumberNonarch F E = 1 := by
    intro F _ _ _ _ _ E C h₁ h₂ h₃ h₄ h₆ hΔ
    have hWΔ : (C • E).Δ ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hΔ
      exact zero_ne_one hΔ
    have hu : ((C.u⁻¹ : Fˣ) : F) ≠ 0 := Units.ne_zero _
    have hEΔ : E.Δ ≠ 0 := by
      intro h0
      apply hWΔ
      rw [WeierstrassCurve.variableChange_Δ, h0, mul_zero]
    
    have hc4 : ValuativeRel.valuation F (C • E).c₄ ≤ 1 := by
      have e : (C • E).c₄ = ((C • E).a₁ ^ 2 + ((4 : ℕ) : F) * (C • E).a₂) ^ 2 -
          ((24 : ℕ) : F) * (((2 : ℕ) : F) * (C • E).a₄ + (C • E).a₁ * (C • E).a₃) := by
        simp only [WeierstrassCurve.c₄, WeierstrassCurve.b₂, WeierstrassCurve.b₄]
        push_cast
        ring
      rw [e]
      have m := fun n : ℕ => natCast_mem (ValuativeRel.valuation F).integer n
      exact sub_mem (pow_mem (add_mem (pow_mem h₁ 2) (mul_mem (m 4) h₂)) 2)
        (mul_mem (m 24) (add_mem (mul_mem (m 2) h₄) (mul_mem h₁ h₃)))
    have hpg : EllipticRootNumber.IsPotentiallyGood F E := by
      unfold EllipticRootNumber.IsPotentiallyGood
      have e : E.c₄ ^ 3 / E.Δ = (C • E).c₄ ^ 3 / (C • E).Δ := by
        rw [WeierstrassCurve.variableChange_c₄, WeierstrassCurve.variableChange_Δ]
        field_simp
      rw [e, map_div₀, map_pow, hΔ, div_one]
      exact pow_le_one' hc4 3
    
    have s7 : ∀ W' : EllipticRootNumber.WDRep F ⊥, W'.N = 0 →
        EllipticRootNumber.frobDet F ⊥ W' = 1 := by
      intro W' hN
      unfold EllipticRootNumber.frobDet
      dsimp only
      split_ifs with hI hK
      · haveI : Subsingleton (↥(EllipticRootNumber.inertiaInvariants F ⊥ W') ⧸
            (LinearMap.ker W'.N).comap
              (EllipticRootNumber.inertiaInvariants F ⊥ W').subtype) := by
          rw [Submodule.Quotient.subsingleton_iff, hN, LinearMap.ker_zero, Submodule.comap_top]
        exact LinearMap.det_eq_one_of_subsingleton _
      · rfl
      · rfl
    have hwd : EllipticRootNumber.wdRep F E =
        { V := EllipticRootNumber.VBar F E
          ρ := (EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype
          N := 0 } := by
      unfold EllipticRootNumber.wdRep
      rw [if_pos hpg]
    
    have hp : (EllipticRootNumber.p F).Prime := by
      unfold EllipticRootNumber.p
      exact CharP.char_is_prime (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) _
    have hcop : ∀ n : ℕ,
        Nat.Coprime (EllipticRootNumber.ell F ^ (n + 1)) (EllipticRootNumber.p F) := fun n =>
      Nat.Coprime.pow_left _ ((Nat.coprime_primes (EllipticRootNumber.ell_prime F).out hp).mpr
        (EllipticRootNumber.ell_ne_p F))
    have hgood : ∃ C' : WeierstrassCurve.VariableChange F,
        ValuativeRel.valuation F (C' • E).a₁ ≤ 1 ∧ ValuativeRel.valuation F (C' • E).a₂ ≤ 1 ∧
        ValuativeRel.valuation F (C' • E).a₃ ≤ 1 ∧ ValuativeRel.valuation F (C' • E).a₄ ≤ 1 ∧
        ValuativeRel.valuation F (C' • E).a₆ ≤ 1 ∧ ValuativeRel.valuation F (C' • E).Δ = 1 :=
      ⟨C, h₁, h₂, h₃, h₄, h₆, hΔ⟩
    have hunr : ∀ w : EllipticRootNumber.relWeil F ⊥,
        (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
        ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) w
          = 1 := by
      intro w hw
      have hT : EllipticRootNumber.tateRep F E (w : EllipticRootNumber.AbsGal F) =
          LinearMap.id := by
        apply LinearMap.ext
        intro x
        apply Subtype.ext
        funext n
        apply Subtype.ext
        exact galHom_eq_self_of_mem_inertia_of_goodModel F E hgood w hw _
          (pow_pos (EllipticRootNumber.ell_prime F).out.pos _) (hcop n) _ (x.1 n).2
      show LinearMap.baseChange (EllipticRootNumber.Ω F)
          (LinearMap.baseChange ℚ_[EllipticRootNumber.ell F]
            (EllipticRootNumber.tateRep F E (w : EllipticRootNumber.AbsGal F))) = 1
      rw [hT, LinearMap.baseChange_id, LinearMap.baseChange_id]
      rfl
    
    haveI := tateModule_finite F E hEΔ
    haveI : Module.Finite ℚ_[EllipticRootNumber.ell F] (EllipticRootNumber.VQ F E) :=
      Module.Finite.base_change _ _ _
    haveI : FiniteDimensional (EllipticRootNumber.Ω F) (EllipticRootNumber.VBar F E) :=
      Module.Finite.base_change _ _ _
    haveI : CharZero (EllipticRootNumber.Ω F) :=
      charZero_of_injective_algebraMap
        (algebraMap ℚ_[EllipticRootNumber.ell F] (EllipticRootNumber.Ω F)).injective
    
    have hloc : ∀ {rec : EllipticRootNumber.LocalReciprocity F}
        (lc : EllipticRootNumber.LocalConstants F rec), EllipticRootNumber.localEps F E lc = 1 := by
      intro rec lc
      have e1 := eps_eq_one_of_unramified F lc
        ((EllipticRootNumber.ellAdicRep F E).comp (EllipticRootNumber.relWeil F ⊥).subtype) hunr
      have e2 : EllipticRootNumber.frobDet F ⊥ (EllipticRootNumber.wdRep F E) = 1 :=
        s7 _ (by rw [hwd])
      unfold EllipticRootNumber.localEps EllipticRootNumber.epsWD
      rw [e2, mul_one, hwd]
      exact (congrArg Units.val e1).trans Units.val_one
    unfold EllipticRootNumber.rootNumberNonarch
    split_ifs with hm
    · exfalso
      rw [hloc] at hm
      have h2' : (2 : EllipticRootNumber.Ω F) = 0 := by
        calc (2 : EllipticRootNumber.Ω F) = 1 + 1 := by norm_num
          _ = 1 + -1 := by rw [← hm]
          _ = 0 := by ring
      exact two_ne_zero h2'
    · rfl
  
  
  
  have hnotRC : ¬ (Nonempty (v.adicCompletion K ≃+* ℝ) ∨ Nonempty (v.adicCompletion K ≃+* ℂ)) := by
    obtain ⟨π₀, hπ₀⟩ := IsDedekindDomain.HeightOneSpectrum.valuation_exists_uniformizer K v
    have hvπ : Valued.v (algebraMap K (v.adicCompletion K) π₀) = WithZero.exp (-1 : ℤ) :=
      (IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v π₀).trans hπ₀
    have key : ∀ y : v.adicCompletion K, Valued.v (y ^ 2) ≠ WithZero.exp (-1 : ℤ) := by
      intro y h
      rw [map_pow] at h
      rcases eq_or_ne (Valued.v y) 0 with h0 | h0
      · rw [h0, zero_pow two_ne_zero] at h
        exact WithZero.zero_ne_coe h
      · obtain ⟨a, ha⟩ := WithZero.ne_zero_iff_exists.mp h0
        rw [← ha, ← WithZero.coe_pow, WithZero.exp, WithZero.coe_inj] at h
        have h' := congrArg Multiplicative.toAdd h
        simp only [toAdd_pow, toAdd_ofAdd, nsmul_eq_mul, Nat.cast_ofNat] at h'
        omega
    have nsq : ∀ y : v.adicCompletion K, y ^ 2 ≠ algebraMap K (v.adicCompletion K) π₀ ∧
        y ^ 2 ≠ -algebraMap K (v.adicCompletion K) π₀ := by
      intro y
      refine ⟨fun h => key y (by rw [h, hvπ]), fun h => key y (by rw [h, Valuation.map_neg, hvπ])⟩
    rintro (hR | hC)
    · obtain ⟨τ⟩ := hR
      rcases le_total 0 (τ (algebraMap K (v.adicCompletion K) π₀)) with h | h
      · apply (nsq (τ.symm (Real.sqrt (τ (algebraMap K (v.adicCompletion K) π₀))))).1
        rw [← map_pow, Real.sq_sqrt h, RingEquiv.symm_apply_apply]
      · apply (nsq (τ.symm (Real.sqrt (-τ (algebraMap K (v.adicCompletion K) π₀))))).2
        rw [← map_pow, Real.sq_sqrt (neg_nonneg.mpr h), map_neg, RingEquiv.symm_apply_apply]
    · obtain ⟨τ⟩ := hC
      obtain ⟨z, hz⟩ :=
        IsAlgClosed.exists_pow_nat_eq (τ (algebraMap K (v.adicCompletion K) π₀)) two_pos
      apply (nsq (τ.symm z)).1
      rw [← map_pow, hz, RingEquiv.symm_apply_apply]
  
  
  
  have hCZ : CharZero (v.adicCompletion K) :=
    charZero_of_injective_algebraMap (algebraMap K (v.adicCompletion K)).injective
  obtain ⟨C, hC⟩ : ∃ C : WeierstrassCurve.VariableChange (v.adicCompletion K),
      C • ((threeRootsCurve e₁ e₂ e₃).baseChange (v.adicCompletion K)) =
        Quotient.out (Quotient.mk (MulAction.orbitRel
          (WeierstrassCurve.VariableChange (v.adicCompletion K))
          (WeierstrassCurve (v.adicCompletion K)))
          ((threeRootsCurve e₁ e₂ e₃).baseChange (v.adicCompletion K))) := by
    have h := Quotient.mk_out (s := MulAction.orbitRel
      (WeierstrassCurve.VariableChange (v.adicCompletion K))
      (WeierstrassCurve (v.adicCompletion K)))
      ((threeRootsCurve e₁ e₂ e₃).baseChange (v.adicCompletion K))
    exact MulAction.mem_orbit_iff.mp (MulAction.orbitRel_apply.mp h)
  show rootNumberRaw (Quotient.out (Quotient.mk (MulAction.orbitRel
    (WeierstrassCurve.VariableChange (v.adicCompletion K)) (WeierstrassCurve (v.adicCompletion K)))
    ((threeRootsCurve e₁ e₂ e₃).baseChange (v.adicCompletion K)))) = 1
  generalize Quotient.out (Quotient.mk (MulAction.orbitRel
    (WeierstrassCurve.VariableChange (v.adicCompletion K)) (WeierstrassCurve (v.adicCompletion K)))
    ((threeRootsCurve e₁ e₂ e₃).baseChange (v.adicCompletion K))) = E' at hC ⊢
  
  
  
  let C₀ : WeierstrassCurve.VariableChange (v.adicCompletion K) :=
    ⟨1, algebraMap K (v.adicCompletion K) e₁, 0, 0⟩
  have hC₁ : (C₀ * C⁻¹) • E' =
      C₀ • ((threeRootsCurve e₁ e₂ e₃).baseChange (v.adicCompletion K)) := by
    rw [← hC, mul_smul, inv_smul_smul]
  have ha₁ : (C₀ • ((threeRootsCurve e₁ e₂ e₃).baseChange (v.adicCompletion K))).a₁ =
      algebraMap K (v.adicCompletion K) 0 := by
    simp [C₀, threeRootsCurve, WeierstrassCurve.variableChange_a₁]
  have ha₂ : (C₀ • ((threeRootsCurve e₁ e₂ e₃).baseChange (v.adicCompletion K))).a₂ =
      algebraMap K (v.adicCompletion K) ((e₁ - e₂) + (e₁ - e₃)) := by
    simp [C₀, threeRootsCurve, WeierstrassCurve.variableChange_a₂]
    ring
  have ha₃ : (C₀ • ((threeRootsCurve e₁ e₂ e₃).baseChange (v.adicCompletion K))).a₃ =
      algebraMap K (v.adicCompletion K) 0 := by
    simp [C₀, threeRootsCurve, WeierstrassCurve.variableChange_a₃]
  have ha₄ : (C₀ • ((threeRootsCurve e₁ e₂ e₃).baseChange (v.adicCompletion K))).a₄ =
      algebraMap K (v.adicCompletion K) ((e₁ - e₂) * (e₁ - e₃)) := by
    simp [C₀, threeRootsCurve, WeierstrassCurve.variableChange_a₄]
    ring
  have ha₆ : (C₀ • ((threeRootsCurve e₁ e₂ e₃).baseChange (v.adicCompletion K))).a₆ =
      algebraMap K (v.adicCompletion K) 0 := by
    simp [C₀, threeRootsCurve, WeierstrassCurve.variableChange_a₆]
    ring
  have hΔ0 : (threeRootsCurve e₁ e₂ e₃).Δ = 2 ^ 4 * ((e₁ - e₂) ^ 2 * (e₁ - e₃) ^ 2 * (e₂ - e₃) ^ 2) := by
    simp only [WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄, WeierstrassCurve.b₆,
      WeierstrassCurve.b₈, threeRootsCurve]
    ring
  have haΔ : (C₀ • ((threeRootsCurve e₁ e₂ e₃).baseChange (v.adicCompletion K))).Δ =
      algebraMap K (v.adicCompletion K) (threeRootsCurve e₁ e₂ e₃).Δ := by
    rw [WeierstrassCurve.variableChange_Δ, WeierstrassCurve.baseChange, WeierstrassCurve.map_Δ]
    simp [C₀]
  
  have hvD : IsDedekindDomain.HeightOneSpectrum.valuation K v (threeRootsCurve e₁ e₂ e₃).Δ = 1 := by
    rw [hΔ0, map_mul, map_pow, map_mul, map_mul, map_pow, map_pow, map_pow, h2, hα, hβ, hγ]
    simp
  have hDne : (threeRootsCurve e₁ e₂ e₃).Δ ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hvD
    exact zero_ne_one hvD
  
  have tr : ∀ S : EllipticRootNumber.LocalFieldStructure (v.adicCompletion K), ∀ k : K,
      IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 →
      @ValuativeRel.valuation (v.adicCompletion K) _ S.rel
        (algebraMap K (v.adicCompletion K) k) ≤ 1 := by
    intro S k hk
    rw [localFieldStructure_adicCompletion_le_one_iff v S]
    exact (IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v k).trans_le hk
  
  
  
  unfold rootNumberRaw
  rw [if_neg hnotRC]
  by_cases hS : Nonempty (EllipticRootNumber.LocalFieldStructure (v.adicCompletion K))
  · rw [dif_pos hS]
    have main : ∀ S : EllipticRootNumber.LocalFieldStructure (v.adicCompletion K),
        @EllipticRootNumber.rootNumberNonarch (v.adicCompletion K) _ S.rel S.top S.isLocalField
          E' = 1 := by
      intro S
      have hz : @ValuativeRel.valuation (v.adicCompletion K) _ S.rel
          (algebraMap K (v.adicCompletion K) 0) ≤ 1 :=
        tr S 0 (by rw [map_zero]; exact zero_le')
      have hDle := tr S _ hvD.le
      have hDinv := tr S ((threeRootsCurve e₁ e₂ e₃).Δ)⁻¹ (by rw [map_inv₀, hvD, inv_one])
      have hmul : @ValuativeRel.valuation (v.adicCompletion K) _ S.rel
            (algebraMap K (v.adicCompletion K) (threeRootsCurve e₁ e₂ e₃).Δ) *
          @ValuativeRel.valuation (v.adicCompletion K) _ S.rel
            (algebraMap K (v.adicCompletion K) ((threeRootsCurve e₁ e₂ e₃).Δ)⁻¹) = 1 := by
        rw [← map_mul, ← map_mul, mul_inv_cancel₀ hDne, map_one, map_one]
      have hD1 : @ValuativeRel.valuation (v.adicCompletion K) _ S.rel
          (algebraMap K (v.adicCompletion K) (threeRootsCurve e₁ e₂ e₃).Δ) = 1 := by
        refine le_antisymm hDle ?_
        have hle := mul_le_mul_left' hDinv (@ValuativeRel.valuation (v.adicCompletion K) _ S.rel
          (algebraMap K (v.adicCompletion K) (threeRootsCurve e₁ e₂ e₃).Δ))
        rw [hmul, mul_one] at hle
        exact hle
      refine @abstract (v.adicCompletion K) _ S.rel S.top S.isLocalField hCZ E' (C₀ * C⁻¹)
        ?_ ?_ ?_ ?_ ?_ ?_
      · rw [hC₁, ha₁]; exact hz
      · rw [hC₁, ha₂]
        exact tr S _ ((Valuation.map_add _ _ _).trans (by rw [hα, hβ, max_self]))
      · rw [hC₁, ha₃]; exact hz
      · rw [hC₁, ha₄]
        exact tr S _ (by rw [map_mul, hα, hβ, mul_one])
      · rw [hC₁, ha₆]; exact hz
      · rw [hC₁, haΔ]; exact hD1
    exact main _
  · rw [dif_neg hS]

theorem adicCompletion_not_real_complex {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    ¬ (Nonempty (v.adicCompletion K ≃+* ℝ) ∨ Nonempty (v.adicCompletion K ≃+* ℂ)) :=
by
  rintro h
  obtain ⟨π, hπ⟩ := IsDedekindDomain.HeightOneSpectrum.valuation_exists_uniformizer K v
  set x : v.adicCompletion K := algebraMap K (v.adicCompletion K) π with hx
  have hvx : Valued.v x = WithZero.exp (-1 : ℤ) := by
    rw [hx]
    exact (IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v π).trans hπ
  have key : ∀ z : v.adicCompletion K, Valued.v z = WithZero.exp (-1 : ℤ) → ¬ IsSquare z := by
    rintro z hz ⟨y, rfl⟩
    rw [Valuation.map_mul] at hz
    have ha : Valued.v y ≠ 0 := by
      intro h0
      rw [h0, zero_mul] at hz
      exact WithZero.exp_ne_zero hz.symm
    have hl := congrArg WithZero.log hz
    rw [WithZero.log_mul ha ha, WithZero.log_exp] at hl
    omega
  have h1 := key x hvx
  have h2 := key (-x) (by rw [Valuation.map_neg]; exact hvx)
  have trans : ∀ {S : Type} [Field S] (φ : v.adicCompletion K ≃+* S) (y : v.adicCompletion K),
      IsSquare (φ y) → IsSquare y := by
    intro S _ φ y hs
    obtain ⟨s, hs⟩ := hs
    exact ⟨φ.symm s, by rw [← map_mul, ← hs, RingEquiv.symm_apply_apply]⟩
  rcases h with h | h
  · obtain ⟨φ⟩ := h
    rcases le_total 0 (φ x) with ht | ht
    · exact h1 (trans φ x ⟨Real.sqrt (φ x), (Real.mul_self_sqrt ht).symm⟩)
    · have ht' : 0 ≤ φ (-x) := by rw [map_neg]; linarith
      exact h2 (trans φ (-x) ⟨Real.sqrt (φ (-x)), (Real.mul_self_sqrt ht').symm⟩)
  · obtain ⟨φ⟩ := h
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_eq_mul_self (φ x)
    exact h1 (trans φ x ⟨z, hz⟩)

theorem threeRootsCurve_mult_odd_val {K : Type u} [Field K] [NumberField K] (e₁ e₂ e₃ : K)
    (h₁₂ : e₁ ≠ e₂) (h₁₃ : e₁ ≠ e₃) (h₂₃ : e₂ ≠ e₃)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : IsDedekindDomain.HeightOneSpectrum.valuation K v 2 = 1)
    (hα : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) ≤ 1)
    (hβ : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) ≤ 1)
    (hγ : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₂ - e₃) ≤ 1)
    (hbad : ¬ (IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) = 1 ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) = 1 ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K v (e₂ - e₃) = 1))
    (hnot : ¬ (IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) < 1 ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) < 1))
    (r : K)
    (hr : (IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) < 1 ∧ r = e₁ - e₃) ∨
      (¬ IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) < 1 ∧
        IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) < 1 ∧ r = e₁ - e₂) ∨
      (¬ IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) < 1 ∧
        ¬ IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) < 1 ∧ r = -(e₁ - e₂))) :
    1 < IsDedekindDomain.HeightOneSpectrum.valuation K v
        ((threeRootsCurve e₁ e₂ e₃).c₄ ^ 3 / (threeRootsCurve e₁ e₂ e₃).Δ) ∧
    IsDedekindDomain.HeightOneSpectrum.valuation K v r = 1 ∧
    IsDedekindDomain.HeightOneSpectrum.valuation K v
        (-(threeRootsCurve e₁ e₂ e₃).c₆ / (64 * r ^ 3) - 1) < 1 :=
by
  set w := IsDedekindDomain.HeightOneSpectrum.valuation K v with hw
  
  have hmul : ∀ x y : K, w x ≤ 1 → w y ≤ 1 → w (x * y) ≤ 1 := fun x y hx hy => by
    rw [map_mul]; exact mul_le_one' hx hy
  have hadd : ∀ x y : K, w x ≤ 1 → w y ≤ 1 → w (x + y) ≤ 1 := fun x y hx hy =>
    le_trans (w.map_add x y) (max_le hx hy)
  have hsub : ∀ x y : K, w x ≤ 1 → w y ≤ 1 → w (x - y) ≤ 1 := fun x y hx hy =>
    le_trans (w.map_sub x y) (max_le hx hy)
  have hpow : ∀ (x : K) (n : ℕ), w x ≤ 1 → w (x ^ n) ≤ 1 := fun x n hx => by
    rw [map_pow]; exact pow_le_one' hx n
  have hsmall : ∀ t P : K, w t < 1 → w P ≤ 1 → w (t * P) < 1 := fun t P ht hP => by
    rw [map_mul]; exact mul_lt_one_of_lt_of_le ht hP
  
  have h2p : ∀ n : ℕ, w ((2 : K) ^ n) = 1 := fun n => by rw [map_pow, h2, one_pow]
  have h16 : w 16 = 1 := by
    have e : (16 : K) = 2 ^ 4 := by norm_num
    rw [e]; exact h2p 4
  have h64 : w 64 = 1 := by
    have e : (64 : K) = 2 ^ 6 := by norm_num
    rw [e]; exact h2p 6
  have h96 : w 96 ≤ 1 := by
    have e : (96 : K) = 2 ^ 6 + 2 ^ 5 := by norm_num
    rw [e]; exact hadd _ _ (le_of_eq (h2p 6)) (le_of_eq (h2p 5))
  have h16' : w 16 ≤ 1 := le_of_eq h16
  have h64' : w 64 ≤ 1 := le_of_eq h64
  
  have hc4 : (threeRootsCurve e₁ e₂ e₃).c₄ =
      16 * ((e₁ - e₂) ^ 2 - (e₁ - e₂) * (e₁ - e₃) + (e₁ - e₃) ^ 2) := by
    simp only [threeRootsCurve, WeierstrassCurve.c₄, WeierstrassCurve.b₂, WeierstrassCurve.b₄]
    ring
  have hc6 : (threeRootsCurve e₁ e₂ e₃).c₆ =
      -(64 * (e₁ - e₂) ^ 3 - 96 * (e₁ - e₂) ^ 2 * (e₁ - e₃) - 96 * (e₁ - e₂) * (e₁ - e₃) ^ 2 +
        64 * (e₁ - e₃) ^ 3) := by
    simp only [threeRootsCurve, WeierstrassCurve.c₆, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
      WeierstrassCurve.b₆]
    ring
  have hΔ : (threeRootsCurve e₁ e₂ e₃).Δ = 16 * (e₁ - e₂) ^ 2 * (e₁ - e₃) ^ 2 * (e₂ - e₃) ^ 2 := by
    simp only [threeRootsCurve, WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
      WeierstrassCurve.b₆, WeierstrassCurve.b₈]
    ring
  have hΔ0 : (threeRootsCurve e₁ e₂ e₃).Δ ≠ 0 := by
    rw [hΔ]
    have h16z : (16 : K) ≠ 0 := by norm_num
    exact mul_ne_zero (mul_ne_zero (mul_ne_zero h16z (pow_ne_zero _ (sub_ne_zero.mpr h₁₂)))
      (pow_ne_zero _ (sub_ne_zero.mpr h₁₃))) (pow_ne_zero _ (sub_ne_zero.mpr h₂₃))
  
  have fin : ∀ s : K, w s = 1 → w (-(threeRootsCurve e₁ e₂ e₃).c₆ - 64 * s ^ 3) < 1 →
      w (threeRootsCurve e₁ e₂ e₃).c₄ = 1 → w (threeRootsCurve e₁ e₂ e₃).Δ < 1 →
      1 < w ((threeRootsCurve e₁ e₂ e₃).c₄ ^ 3 / (threeRootsCurve e₁ e₂ e₃).Δ) ∧
      w s = 1 ∧ w (-(threeRootsCurve e₁ e₂ e₃).c₆ / (64 * s ^ 3) - 1) < 1 := by
    intro s hs hN hc hD
    have hc0 : (threeRootsCurve e₁ e₂ e₃).c₄ ≠ 0 := by
      intro h
      rw [h, map_zero] at hc
      exact zero_ne_one hc
    have hwden : w (64 * s ^ 3) = 1 := by rw [map_mul, map_pow, h64, hs, one_pow, one_mul]
    have hden : (64 : K) * s ^ 3 ≠ 0 := by
      intro h
      rw [h, map_zero] at hwden
      exact zero_ne_one hwden
    refine ⟨?_, hs, ?_⟩
    · have hx : (threeRootsCurve e₁ e₂ e₃).c₄ ^ 3 / (threeRootsCurve e₁ e₂ e₃).Δ ≠ 0 :=
        div_ne_zero (pow_ne_zero 3 hc0) hΔ0
      rw [Valuation.one_lt_val_iff w hx, inv_div, map_div₀, map_pow, hc, one_pow, div_one]
      exact hD
    · rw [div_sub_one hden, map_div₀, hwden, div_one]
      exact hN
  rcases hr with ⟨h1, rfl⟩ | ⟨h1, h1', rfl⟩ | ⟨h1, h1', rfl⟩
  · 
    have hb1 : w (e₁ - e₃) = 1 := le_antisymm hβ (not_lt.mp fun h => hnot ⟨h1, h⟩)
    refine fin _ hb1 ?_ ?_ ?_
    · have e : -(threeRootsCurve e₁ e₂ e₃).c₆ - 64 * (e₁ - e₃) ^ 3 =
          (e₁ - e₂) * (64 * (e₁ - e₂) ^ 2 - 96 * (e₁ - e₂) * (e₁ - e₃) - 96 * (e₁ - e₃) ^ 2) := by
        rw [hc6]; ring
      rw [e]
      exact hsmall _ _ h1 (hsub _ _ (hsub _ _ (hmul _ _ h64' (hpow _ _ hα))
        (hmul _ _ (hmul _ _ h96 hα) hβ)) (hmul _ _ h96 (hpow _ _ hβ)))
    · have e : (e₁ - e₂) ^ 2 - (e₁ - e₂) * (e₁ - e₃) + (e₁ - e₃) ^ 2 =
          (e₁ - e₂) * ((e₁ - e₂) - (e₁ - e₃)) + (e₁ - e₃) ^ 2 := by ring
      rw [hc4, map_mul, h16, one_mul, e, Valuation.map_add_eq_of_lt_right, map_pow, hb1, one_pow]
      rw [map_pow, hb1, one_pow]
      exact hsmall _ _ h1 (hsub _ _ hα hβ)
    · have e : (threeRootsCurve e₁ e₂ e₃).Δ =
          (e₁ - e₂) * (16 * (e₁ - e₂) * (e₁ - e₃) ^ 2 * (e₂ - e₃) ^ 2) := by
        rw [hΔ]; ring
      rw [e]
      exact hsmall _ _ h1
        (hmul _ _ (hmul _ _ (hmul _ _ h16' hα) (hpow _ _ hβ)) (hpow _ _ hγ))
  · 
    have ha1 : w (e₁ - e₂) = 1 := le_antisymm hα (not_lt.mp h1)
    refine fin _ ha1 ?_ ?_ ?_
    · have e : -(threeRootsCurve e₁ e₂ e₃).c₆ - 64 * (e₁ - e₂) ^ 3 =
          (e₁ - e₃) * (64 * (e₁ - e₃) ^ 2 - 96 * (e₁ - e₂) ^ 2 - 96 * (e₁ - e₂) * (e₁ - e₃)) := by
        rw [hc6]; ring
      rw [e]
      exact hsmall _ _ h1' (hsub _ _ (hsub _ _ (hmul _ _ h64' (hpow _ _ hβ))
        (hmul _ _ h96 (hpow _ _ hα))) (hmul _ _ (hmul _ _ h96 hα) hβ))
    · have e : (e₁ - e₂) ^ 2 - (e₁ - e₂) * (e₁ - e₃) + (e₁ - e₃) ^ 2 =
          (e₁ - e₃) * ((e₁ - e₃) - (e₁ - e₂)) + (e₁ - e₂) ^ 2 := by ring
      rw [hc4, map_mul, h16, one_mul, e, Valuation.map_add_eq_of_lt_right, map_pow, ha1, one_pow]
      rw [map_pow, ha1, one_pow]
      exact hsmall _ _ h1' (hsub _ _ hβ hα)
    · have e : (threeRootsCurve e₁ e₂ e₃).Δ =
          (e₁ - e₃) * (16 * (e₁ - e₂) ^ 2 * (e₁ - e₃) * (e₂ - e₃) ^ 2) := by
        rw [hΔ]; ring
      rw [e]
      exact hsmall _ _ h1'
        (hmul _ _ (hmul _ _ (hmul _ _ h16' (hpow _ _ hα)) hβ) (hpow _ _ hγ))
  · 
    have ha1 : w (e₁ - e₂) = 1 := le_antisymm hα (not_lt.mp h1)
    have hb1 : w (e₁ - e₃) = 1 := le_antisymm hβ (not_lt.mp h1')
    have hg1 : w (e₂ - e₃) < 1 := lt_of_le_of_ne hγ (fun h => hbad ⟨ha1, hb1, h⟩)
    have hr1 : w (-(e₁ - e₂)) = 1 := by rw [Valuation.map_neg]; exact ha1
    refine fin _ hr1 ?_ ?_ ?_
    · have e : -(threeRootsCurve e₁ e₂ e₃).c₆ - 64 * (-(e₁ - e₂)) ^ 3 =
          (e₂ - e₃) * (64 * (e₂ - e₃) ^ 2 + 96 * (e₁ - e₂) * (e₂ - e₃) - 96 * (e₁ - e₂) ^ 2) := by
        rw [hc6]; ring
      rw [e]
      exact hsmall _ _ hg1 (hsub _ _ (hadd _ _ (hmul _ _ h64' (hpow _ _ hγ))
        (hmul _ _ (hmul _ _ h96 hα) hγ)) (hmul _ _ h96 (hpow _ _ hα)))
    · have e : (e₁ - e₂) ^ 2 - (e₁ - e₂) * (e₁ - e₃) + (e₁ - e₃) ^ 2 =
          (e₂ - e₃) * (e₁ - e₃) + (e₁ - e₂) ^ 2 := by ring
      rw [hc4, map_mul, h16, one_mul, e, Valuation.map_add_eq_of_lt_right, map_pow, ha1, one_pow]
      rw [map_pow, ha1, one_pow]
      exact hsmall _ _ hg1 hβ
    · have e : (threeRootsCurve e₁ e₂ e₃).Δ =
          (e₂ - e₃) * (16 * (e₁ - e₂) ^ 2 * (e₁ - e₃) ^ 2 * (e₂ - e₃)) := by
        rw [hΔ]; ring
      rw [e]
      exact hsmall _ _ hg1
        (hmul _ _ (hmul _ _ (hmul _ _ h16' (hpow _ _ hα)) (hpow _ _ hβ)) hγ)

theorem weilDegreeHom_spec (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] :
    (∀ σ ∈ EllipticRootNumber.weilGroup F, ∃ n : ℤ, EllipticRootNumber.ActsAsFrobPow F σ n) ∧
    (∀ (σ : EllipticRootNumber.weilGroup F) (n : ℤ), EllipticRootNumber.ActsAsFrobPow F σ n →
      EllipticRootNumber.weilDegreeHom F σ = Multiplicative.ofAdd n) :=
by
  classical
  
  have hfin : ∀ (k : Type u) [Field k] [Finite k],
      (ringChar k).Prime ∧ ∃ f : ℕ, 0 < f ∧ Nat.card k = ringChar k ^ f := by
    intro k _ _
    letI := Fintype.ofFinite k
    haveI := ringChar.charP k
    obtain ⟨n, hpk, hn⟩ := FiniteField.card k (ringChar k)
    exact ⟨hpk, n, n.pos, by rw [Nat.card_eq_fintype_card, hn]⟩
  have hp : (EllipticRootNumber.p F).Prime := by
    unfold EllipticRootNumber.p
    exact (hfin _).1
  obtain ⟨f, hfpos, hqf⟩ : ∃ f : ℕ, 0 < f ∧
      EllipticRootNumber.q F = EllipticRootNumber.p F ^ f := by
    unfold EllipticRootNumber.q EllipticRootNumber.p
    exact (hfin _).2
  have hq : 2 ≤ EllipticRootNumber.q F := by
    rw [hqf]
    exact le_trans hp.two_le (Nat.le_self_pow hfpos.ne' _)
  
  have hcancel : ∀ (x y : AlgebraicClosure F) (N k : ℕ), 0 < N → ¬ EllipticRootNumber.p F ∣ N →
      x ^ N = 1 → y ^ N = 1 →
      x ^ (EllipticRootNumber.q F ^ k) = y ^ (EllipticRootNumber.q F ^ k) → x = y := by
    intro x y N k hN hpN hx hy h
    have hcop : Nat.Coprime (EllipticRootNumber.q F ^ k) N := by
      rw [hqf, ← pow_mul]
      exact Nat.Coprime.pow_left _ ((Nat.Prime.coprime_iff_not_dvd hp).mpr hpN)
    have hy0 : y ≠ 0 := by
      rintro rfl
      rw [zero_pow hN.ne'] at hy
      exact zero_ne_one hy
    have hzL : (x / y) ^ N = 1 := by rw [div_pow, hx, hy, div_one]
    have hzQ : (x / y) ^ (EllipticRootNumber.q F ^ k) = 1 := by
      rw [div_pow, h, div_self (pow_ne_zero _ hy0)]
    have h1 : (x / y) ^ (Nat.gcd (EllipticRootNumber.q F ^ k) N) = 1 :=
      pow_gcd_eq_one.mpr ⟨hzQ, hzL⟩
    rw [Nat.Coprime.gcd_eq_one hcop, pow_one] at h1
    exact (div_eq_one_iff_eq hy0).mp h1
  
  have hroots : ∀ B : ℕ, ∃ (ζ : AlgebraicClosure F) (ℓ : ℕ), B < ℓ ∧
      EllipticRootNumber.IsPrimeToPRootOfUnity F ζ ∧ ∀ k : ℕ, ζ ^ k = 1 → ℓ ∣ k := by
    intro B
    obtain ⟨ℓ, hℓge, hℓ⟩ := Nat.exists_infinite_primes (B + EllipticRootNumber.p F + 1)
    haveI : NeZero (ℓ : AlgebraicClosure F) := ⟨Nat.cast_ne_zero.mpr hℓ.ne_zero⟩
    have hdeg : (Polynomial.cyclotomic ℓ (AlgebraicClosure F)).degree ≠ 0 :=
      (Polynomial.degree_cyclotomic_pos ℓ (AlgebraicClosure F) hℓ.pos).ne'
    obtain ⟨ζ, hζroot⟩ := IsAlgClosed.exists_root _ hdeg
    have hζ : IsPrimitiveRoot ζ ℓ := (Polynomial.isRoot_cyclotomic_iff).mp hζroot
    refine ⟨ζ, ℓ, by omega, ⟨ℓ, hℓ.pos, ?_, hζ.pow_eq_one⟩,
      fun k hk => hζ.dvd_of_pow_eq_one k hk⟩
    intro hdvd
    rcases Nat.Prime.eq_one_or_self_of_dvd hℓ _ hdvd with h | h
    · exact absurd h hp.one_lt.ne'
    · omega
  
  have huniq : ∀ (σ : EllipticRootNumber.AbsGal F) (n m : ℤ),
      EllipticRootNumber.ActsAsFrobPow F σ n → EllipticRootNumber.ActsAsFrobPow F σ m →
      n = m := by
    intro σ n m hn hm
    have key : ∀ ζ, EllipticRootNumber.IsPrimeToPRootOfUnity F ζ →
        ζ ^ (EllipticRootNumber.q F ^ (n.toNat + (-m).toNat)) =
          ζ ^ (EllipticRootNumber.q F ^ ((-n).toNat + m.toNat)) := by
      intro ζ hζ
      have h1 := hn ζ hζ
      have h2 := hm ζ hζ
      calc ζ ^ (EllipticRootNumber.q F ^ (n.toNat + (-m).toNat))
          = (ζ ^ EllipticRootNumber.q F ^ n.toNat) ^ (EllipticRootNumber.q F ^ (-m).toNat) := by
            rw [pow_add, pow_mul]
        _ = (σ ζ ^ EllipticRootNumber.q F ^ (-n).toNat) ^ (EllipticRootNumber.q F ^ (-m).toNat) := by
            rw [h1]
        _ = (σ ζ ^ EllipticRootNumber.q F ^ (-m).toNat) ^ (EllipticRootNumber.q F ^ (-n).toNat) := by
            rw [← pow_mul, ← pow_mul, Nat.mul_comm]
        _ = (ζ ^ EllipticRootNumber.q F ^ m.toNat) ^ (EllipticRootNumber.q F ^ (-n).toNat) := by
            rw [h2]
        _ = ζ ^ (EllipticRootNumber.q F ^ ((-n).toNat + m.toNat)) := by
            rw [← pow_mul, ← pow_add, Nat.add_comm m.toNat (-n).toNat]
    have hstep : ∀ S T : ℕ, S < T → (∀ ζ, EllipticRootNumber.IsPrimeToPRootOfUnity F ζ →
        ζ ^ (EllipticRootNumber.q F ^ T) = ζ ^ (EllipticRootNumber.q F ^ S)) → False := by
      intro S T hST hall
      obtain ⟨ζ, ℓ, hℓ, hζ, hdvd⟩ := hroots (EllipticRootNumber.q F ^ T)
      have heq := hall ζ hζ
      obtain ⟨N, hN, -, hζN⟩ := hζ
      have hζ0 : ζ ≠ 0 := by
        rintro rfl
        rw [zero_pow hN.ne'] at hζN
        exact zero_ne_one hζN
      have hlt : EllipticRootNumber.q F ^ S < EllipticRootNumber.q F ^ T :=
        Nat.pow_lt_pow_right hq hST
      have hD : ζ ^ (EllipticRootNumber.q F ^ T - EllipticRootNumber.q F ^ S) = 1 := by
        have e : ζ ^ (EllipticRootNumber.q F ^ T) = ζ ^ (EllipticRootNumber.q F ^ S) *
            ζ ^ (EllipticRootNumber.q F ^ T - EllipticRootNumber.q F ^ S) := by
          rw [← pow_add, Nat.add_sub_cancel' hlt.le]
        rw [e] at heq
        exact mul_left_cancel₀ (pow_ne_zero _ hζ0) (heq.trans (mul_one _).symm)
      have := Nat.le_of_dvd (Nat.sub_pos_of_lt hlt) (hdvd _ hD)
      omega
    by_contra hne
    have h1 := Int.toNat_sub_toNat_neg n
    have h2 := Int.toNat_sub_toNat_neg m
    rcases Nat.lt_or_gt_of_ne (show n.toNat + (-m).toNat ≠ (-n).toNat + m.toNat by omega)
      with h | h
    · exact hstep _ _ h (fun ζ hζ => (key ζ hζ).symm)
    · exact hstep _ _ h key
  
  have hmul : ∀ (σ τ : EllipticRootNumber.AbsGal F) (n m : ℤ),
      EllipticRootNumber.ActsAsFrobPow F σ n → EllipticRootNumber.ActsAsFrobPow F τ m →
      EllipticRootNumber.ActsAsFrobPow F (σ * τ) (n + m) := by
    intro σ τ n m hn hm ζ hζ
    have h1 := Int.toNat_sub_toNat_neg n
    have h2 := Int.toNat_sub_toNat_neg m
    have h3 := Int.toNat_sub_toNat_neg (n + m)
    have h0 : (-(n + m)).toNat = 0 ∨ (n + m).toNat = 0 := by
      rcases le_total (n + m) 0 with h | h
      · exact Or.inr (Int.toNat_eq_zero.mpr h)
      · exact Or.inl (Int.toNat_eq_zero.mpr (by omega))
    obtain ⟨k, hA, hB⟩ : ∃ k, (-n).toNat + (-m).toNat = (-(n + m)).toNat + k ∧
        n.toNat + m.toNat = (n + m).toNat + k :=
      ⟨min ((-n).toNat + (-m).toNat) (n.toNat + m.toNat), by omega, by omega⟩
    have hζ' := hζ
    obtain ⟨N, hN, hpN, hζN⟩ := hζ
    have comp : ((σ * τ) ζ) ^ (EllipticRootNumber.q F ^ ((-n).toNat + (-m).toNat)) =
        ζ ^ (EllipticRootNumber.q F ^ (n.toNat + m.toNat)) := by
      rw [AlgEquiv.mul_apply]
      calc (σ (τ ζ)) ^ (EllipticRootNumber.q F ^ ((-n).toNat + (-m).toNat))
          = ((σ (τ ζ)) ^ (EllipticRootNumber.q F ^ (-m).toNat)) ^
              (EllipticRootNumber.q F ^ (-n).toNat) := by
            rw [← pow_mul, ← pow_add, Nat.add_comm]
        _ = (σ ((τ ζ) ^ (EllipticRootNumber.q F ^ (-m).toNat))) ^
              (EllipticRootNumber.q F ^ (-n).toNat) := by rw [map_pow]
        _ = (σ (ζ ^ (EllipticRootNumber.q F ^ m.toNat))) ^
              (EllipticRootNumber.q F ^ (-n).toNat) := by rw [hm ζ hζ']
        _ = ((σ ζ) ^ (EllipticRootNumber.q F ^ (-n).toNat)) ^
              (EllipticRootNumber.q F ^ m.toNat) := by
            rw [map_pow, ← pow_mul, ← pow_mul, Nat.mul_comm]
        _ = (ζ ^ (EllipticRootNumber.q F ^ n.toNat)) ^ (EllipticRootNumber.q F ^ m.toNat) := by
            rw [hn ζ hζ']
        _ = ζ ^ (EllipticRootNumber.q F ^ (n.toNat + m.toNat)) := by
            rw [← pow_mul, ← pow_add]
    have hxy : (((σ * τ) ζ) ^ (EllipticRootNumber.q F ^ (-(n + m)).toNat)) ^
          (EllipticRootNumber.q F ^ k) =
        (ζ ^ (EllipticRootNumber.q F ^ (n + m).toNat)) ^ (EllipticRootNumber.q F ^ k) := by
      rw [← pow_mul, ← pow_mul, ← pow_add, ← pow_add, ← hA, ← hB]
      exact comp
    have hxN : (((σ * τ) ζ) ^ (EllipticRootNumber.q F ^ (-(n + m)).toNat)) ^ N = 1 := by
      rw [← pow_mul, Nat.mul_comm, pow_mul, ← map_pow, hζN, map_one, one_pow]
    have hyN : (ζ ^ (EllipticRootNumber.q F ^ (n + m).toNat)) ^ N = 1 := by
      rw [← pow_mul, Nat.mul_comm, pow_mul, hζN, one_pow]
    exact hcancel _ _ N k hN hpN hxN hyN hxy
  
  have hone : EllipticRootNumber.ActsAsFrobPow F 1 0 := by
    intro ζ _
    simp
  have hinv : ∀ (σ : EllipticRootNumber.AbsGal F) (n : ℤ),
      EllipticRootNumber.ActsAsFrobPow F σ n → EllipticRootNumber.ActsAsFrobPow F σ⁻¹ (-n) := by
    intro σ n hn ζ hζ
    obtain ⟨N, hN, hpN, hζN⟩ := hζ
    have hζ' : EllipticRootNumber.IsPrimeToPRootOfUnity F (σ⁻¹ ζ) :=
      ⟨N, hN, hpN, by rw [← map_pow, hζN, map_one]⟩
    have h := hn _ hζ'
    have hs : σ (σ⁻¹ ζ) = ζ := by
      rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
    rw [hs] at h
    rw [neg_neg]
    exact h.symm
  
  have part1 : ∀ σ ∈ EllipticRootNumber.weilGroup F,
      ∃ n : ℤ, EllipticRootNumber.ActsAsFrobPow F σ n := by
    intro σ hσ
    unfold EllipticRootNumber.weilGroup at hσ
    induction hσ using Subgroup.closure_induction with
    | mem x hx => exact hx
    | one => exact ⟨0, hone⟩
    | mul x y _ _ hx hy =>
      obtain ⟨n, hn⟩ := hx
      obtain ⟨m, hm⟩ := hy
      exact ⟨n + m, hmul x y n m hn hm⟩
    | inv x _ hx =>
      obtain ⟨n, hn⟩ := hx
      exact ⟨-n, hinv x n hn⟩
  
  have hdeg : ∀ (σ : EllipticRootNumber.AbsGal F) (n : ℤ),
      EllipticRootNumber.ActsAsFrobPow F σ n → EllipticRootNumber.weilDegree F σ = n := by
    intro σ n h
    have hex : ∃ n : ℤ, EllipticRootNumber.ActsAsFrobPow F σ n := ⟨n, h⟩
    unfold EllipticRootNumber.weilDegree
    rw [dif_pos hex]
    exact huniq σ _ n hex.choose_spec h
  
  let f : EllipticRootNumber.weilGroup F →* Multiplicative ℤ :=
    MonoidHom.mk' (fun σ => Multiplicative.ofAdd (EllipticRootNumber.weilDegree F σ)) (by
      intro σ τ
      obtain ⟨n, hn⟩ := part1 σ σ.2
      obtain ⟨m, hm⟩ := part1 τ τ.2
      have hστ := hmul σ τ n m hn hm
      beta_reduce
      rw [Subgroup.coe_mul, hdeg _ _ hστ, hdeg _ _ hn, hdeg _ _ hm, ofAdd_add])
  have hf : ∀ (σ : EllipticRootNumber.weilGroup F) (n : ℤ),
      EllipticRootNumber.ActsAsFrobPow F σ n → f σ = Multiplicative.ofAdd n := by
    intro σ n h
    show Multiplicative.ofAdd (EllipticRootNumber.weilDegree F σ) = _
    rw [hdeg _ _ h]
  refine ⟨part1, ?_⟩
  unfold EllipticRootNumber.weilDegreeHom
  exact Classical.epsilon_spec
    (p := fun g : EllipticRootNumber.weilGroup F →* Multiplicative ℤ =>
      ∀ (σ : EllipticRootNumber.weilGroup F) (n : ℤ), EllipticRootNumber.ActsAsFrobPow F σ n →
        g σ = Multiplicative.ofAdd n) ⟨f, hf⟩

theorem quadSign_eq_of_unit_twist {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (hH : HenselianLocalRing ↥(ValuativeRel.valuation F).integer)
    (h2 : ValuativeRel.valuation F 2 = 1) (E : WeierstrassCurve F) (r z u₀ : F)
    (hr : ValuativeRel.valuation F r = 1) (hz : z ≠ 0)
    (hu₀ : ValuativeRel.valuation F (u₀ - 1) < 1) (hc : -E.c₆ = r * z ^ 2 * u₀)
    (ε : ℤˣ) (hε : (IsSquare r → ε = 1) ∧ (¬ IsSquare r → ε = -1)) :
    ∀ (σ : EllipticRootNumber.AbsGal F) (n : ℤ), EllipticRootNumber.ActsAsFrobPow F σ n →
      EllipticRootNumber.quadSign F E σ = ε ^ n :=
by
  intro σ n hσ
  
  have hmax : ∀ x : ↥(ValuativeRel.valuation F).integer,
      x ∈ IsLocalRing.maximalIdeal ↥(ValuativeRel.valuation F).integer ↔
        ValuativeRel.valuation F (x : F) < 1 := by
    intro x
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
      (Valuation.integer.integers (ValuativeRel.valuation F)).isUnit_iff_valuation_eq_one]
    have hx : ValuativeRel.valuation F (x : F) ≤ 1 := x.2
    constructor
    · intro h; exact lt_of_le_of_ne hx h
    · intro h; exact ne_of_lt h
  
  have hensel : ∀ (m : ℕ), 0 < m → ValuativeRel.valuation F (m : F) = 1 →
      ∀ u : F, ValuativeRel.valuation F (u - 1) < 1 → ∃ b : F, b ^ m = u := by
    intro m hm hmv u hu
    have hu1 : ValuativeRel.valuation F u = 1 := by
      have e : u = 1 + (u - 1) := by ring
      rw [e, Valuation.map_add_eq_of_lt_left _ (by rw [map_one]; exact hu), map_one]
    have huO : u ∈ (ValuativeRel.valuation F).integer :=
      (Valuation.mem_integer_iff _ _).mpr hu1.le
    set û : ↥(ValuativeRel.valuation F).integer := ⟨u, huO⟩ with hû
    have hmO : IsUnit ((m : ℕ) : ↥(ValuativeRel.valuation F).integer) := by
      rw [(Valuation.integer.integers (ValuativeRel.valuation F)).isUnit_iff_valuation_eq_one]
      simpa using hmv
    obtain ⟨a, ha, -⟩ := HenselianLocalRing.is_henselian (Polynomial.X ^ m - Polynomial.C û)
      (Polynomial.monic_X_pow_sub_C û hm.ne') 1 (by
        rw [hmax]
        simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
          Polynomial.eval_C, one_pow]
        rw [show ((1 - û : ↥(ValuativeRel.valuation F).integer) : F) = 1 - u from rfl,
          Valuation.map_sub_swap]
        exact hu) (by
        simp only [Polynomial.derivative_sub, Polynomial.derivative_X_pow,
          Polynomial.derivative_C, sub_zero, Polynomial.eval_mul, Polynomial.eval_C,
          Polynomial.eval_pow, Polynomial.eval_X, one_pow, mul_one]
        simpa using hmO)
    refine ⟨(a : F), ?_⟩
    have h := ha
    simp only [Polynomial.IsRoot, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_C, sub_eq_zero] at h
    have := congrArg (fun x : ↥(ValuativeRel.valuation F).integer => (x : F)) h
    simpa using this
  have hsq : ∀ u : F, ValuativeRel.valuation F (u - 1) < 1 → IsSquare u := by
    intro u hu
    obtain ⟨b, hb⟩ := hensel 2 two_pos (by exact_mod_cast h2) u hu
    exact ⟨b, by rw [← hb, sq]⟩
  
  have hres_facts :
      Odd (Nat.card (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)) ∧
      1 < Nat.card (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) ∧
      ValuativeRel.valuation F
        ((Nat.card (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) - 1 : ℕ) : F)
          = 1 ∧
      ¬ ringChar (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) ∣
        2 * (Nat.card (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) - 1) ∧
      (¬ IsSquare r →
        ValuativeRel.valuation F (r ^ ((Nat.card (IsLocalRing.ResidueField
          ↥(ValuativeRel.valuation F).integer) - 1) / 2) + 1) < 1) := by
    letI : Fintype (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) :=
      Fintype.ofFinite _
    have hres : ∀ x : ↥(ValuativeRel.valuation F).integer,
        IsLocalRing.residue _ x = 0 ↔ ValuativeRel.valuation F (x : F) < 1 := fun x => by
      rw [IsLocalRing.residue_eq_zero_iff, hmax]
    have hres1 : ∀ x : ↥(ValuativeRel.valuation F).integer,
        IsLocalRing.residue _ x ≠ 0 → ValuativeRel.valuation F (x : F) = 1 := fun x hx =>
      le_antisymm x.2 (not_lt.mp fun h => hx ((hres x).mpr h))
    have h2k : (2 : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) ≠ 0 := by
      intro h
      have h' : IsLocalRing.residue (↥(ValuativeRel.valuation F).integer) 2 = 0 := by
        rw [map_ofNat]; exact h
      rw [hres] at h'
      have e : ((2 : ↥(ValuativeRel.valuation F).integer) : F) = 2 := rfl
      rw [e, h2] at h'
      exact lt_irrefl _ h'
    have hcard : Nat.card (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) =
        Fintype.card (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) :=
      Nat.card_eq_fintype_card
    have hodd : Fintype.card (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
        % 2 = 1 := by
      by_contra h
      have h0 : Fintype.card (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
          % 2 = 0 := by omega
      have hc := FiniteField.even_card_iff_char_two.mpr h0
      apply h2k
      have := ringChar.Nat.cast_ringChar
        (R := IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
      rw [hc] at this
      exact_mod_cast this
    have hchar : ringChar (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) ≠ 2 :=
      fun h => by
        have := FiniteField.even_card_iff_char_two.mp h
        omega
    have hq1 : 1 < Fintype.card (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) :=
      Fintype.one_lt_card
    have hqm1 : ((Fintype.card (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
        - 1 : ℕ) : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) = -1 := by
      rw [Nat.cast_sub hq1.le, FiniteField.cast_card_eq_zero]; simp
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · rw [hcard]; exact Nat.odd_iff.mpr hodd
    · rw [hcard]; exact hq1
    · rw [hcard]
      have h := hres1 ((Fintype.card (IsLocalRing.ResidueField
        ↥(ValuativeRel.valuation F).integer) - 1 : ℕ) : ↥(ValuativeRel.valuation F).integer) (by
        rw [map_natCast, hqm1]; exact neg_ne_zero.mpr one_ne_zero)
      simpa using h
    · rw [hcard]
      intro hdvd
      have h0 : ((2 * (Fintype.card (IsLocalRing.ResidueField
          ↥(ValuativeRel.valuation F).integer) - 1) : ℕ) :
            IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) = 0 :=
        (ringChar.spec (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) _).mpr hdvd
      rw [Nat.cast_mul, hqm1, Nat.cast_ofNat, mul_neg_one, neg_eq_zero] at h0
      exact h2k h0
    · intro hns
      rw [hcard]
      set m := Fintype.card (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) / 2
        with hm
      have hm2 : 2 * m =
          Fintype.card (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) - 1 := by
        omega
      have hm' : (Fintype.card (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
          - 1) / 2 = m := by omega
      rw [hm']
      have hrO : r ∈ (ValuativeRel.valuation F).integer :=
        (Valuation.mem_integer_iff _ _).mpr hr.le
      set rh : ↥(ValuativeRel.valuation F).integer := ⟨r, hrO⟩ with hrh
      set a := IsLocalRing.residue (↥(ValuativeRel.valuation F).integer) rh with ha
      have ha0 : a ≠ 0 := by
        rw [ha, Ne, hres]
        show ¬ ValuativeRel.valuation F r < 1
        rw [hr]; exact lt_irrefl _
      have hc2 : (a ^ m) * (a ^ m) = 1 := by
        rw [← pow_add, ← two_mul, hm2]
        exact FiniteField.pow_card_sub_one_eq_one a ha0
      rcases mul_self_eq_one_iff.mp hc2 with hc | hc
      · exfalso
        obtain ⟨g, hg⟩ := (FiniteField.isSquare_iff hchar ha0).mpr (by rw [← hm]; exact hc)
        obtain ⟨b, hb⟩ := IsLocalRing.residue_surjective g
        have hg0 : g ≠ 0 := by
          rintro rfl; rw [mul_zero] at hg; exact ha0 hg
        have hbv : ValuativeRel.valuation F (b : F) = 1 := hres1 b (by rw [hb]; exact hg0)
        have hb0 : (b : F) ≠ 0 := by
          intro h; rw [h, map_zero] at hbv; exact zero_ne_one hbv
        have hdiff : ValuativeRel.valuation F (r - (b : F) * b) < 1 := by
          have h := (hres (rh - b * b)).mp (by rw [map_sub, map_mul, hb, ← ha, hg, sub_self])
          simpa using h
        obtain ⟨e, he⟩ := hsq (r / ((b : F) * b)) (by
          have e1 : r / ((b : F) * b) - 1 = (r - (b : F) * b) / ((b : F) * b) := by
            field_simp
          rw [e1, map_div₀, map_mul, hbv, mul_one, div_one]
          exact hdiff)
        apply hns
        refine ⟨e * b, ?_⟩
        have : r = r / ((b : F) * b) * ((b : F) * b) := by field_simp
        rw [this, he]; ring
      · have h := (hres (rh ^ m + 1)).mp
          (by rw [map_add, map_pow, map_one, ← ha, hc, neg_add_cancel])
        simpa using h
  obtain ⟨hQodd, hQ1, hQv, hp, heuler⟩ := hres_facts
  
  have hr0 : r ≠ 0 := by
    rintro rfl; rw [map_zero] at hr; exact zero_ne_one hr
  have hu₀1 : ValuativeRel.valuation F u₀ = 1 := by
    have e : u₀ = 1 + (u₀ - 1) := by ring
    rw [e, Valuation.map_add_eq_of_lt_left _ (by rw [map_one]; exact hu₀), map_one]
  obtain ⟨w₀, hw₀⟩ := hsq u₀ hu₀
  have hw0 : w₀ ≠ 0 := by
    rintro rfl; rw [mul_zero] at hw₀; rw [hw₀, map_zero] at hu₀1; exact zero_ne_one hu₀1
  have hd0 : z * w₀ ≠ 0 := mul_ne_zero hz hw0
  have hcd : -E.c₆ = r * (z * w₀) ^ 2 := by rw [hc, hw₀]; ring
  
  obtain ⟨t, ht⟩ := IsAlgClosed.exists_pow_nat_eq
    (algebraMap F (AlgebraicClosure F) r) two_pos
  have H : (σ t = t → EllipticRootNumber.quadSign F E σ = 1) ∧
      (σ t = -t → EllipticRootNumber.quadSign F E σ = -1) := by
    have hs2 : EllipticRootNumber.sqrtNegC₆ F E ^ 2 =
        (t * algebraMap F (AlgebraicClosure F) (z * w₀)) ^ 2 := by
      rw [EllipticRootNumber.sqrtNegC₆_sq, hcd, map_mul, map_pow, mul_pow, ht]
    have hσD : σ (algebraMap F (AlgebraicClosure F) (z * w₀)) =
        algebraMap F (AlgebraicClosure F) (z * w₀) := AlgEquiv.commutes σ _
    unfold EllipticRootNumber.quadSign
    generalize EllipticRootNumber.sqrtNegC₆ F E = s at hs2 ⊢
    have hs0 : s ≠ 0 := by
      intro h0
      have h1 : (t * algebraMap F (AlgebraicClosure F) (z * w₀)) ^ 2 = 0 := by
        rw [← hs2, h0]; ring
      have h' : algebraMap F (AlgebraicClosure F) (r * (z * w₀) ^ 2) = 0 := by
        rw [map_mul, map_pow, ← ht, ← mul_pow]; exact h1
      exact mul_ne_zero hr0 (pow_ne_zero 2 hd0)
        ((map_eq_zero_iff _ (algebraMap F (AlgebraicClosure F)).injective).mp h')
    have hneg : -s ≠ s := by
      intro h
      have h3 : (2 : AlgebraicClosure F) * s = 0 := by linear_combination -h
      rcases mul_eq_zero.mp h3 with h4 | h4
      · exact two_ne_zero h4
      · exact hs0 h4
    have hfix : σ t = t → σ s = s := by
      intro h
      rcases sq_eq_sq_iff_eq_or_eq_neg.mp hs2 with he | he
      · rw [he, map_mul σ, h, hσD]
      · rw [he, map_neg σ, map_mul σ, h, hσD]
    have hmove : σ t = -t → σ s = -s := by
      intro h
      rcases sq_eq_sq_iff_eq_or_eq_neg.mp hs2 with he | he
      · rw [he, map_mul σ, h, hσD, neg_mul]
      · rw [he, map_neg σ, map_mul σ, h, hσD, neg_mul, neg_neg]
    exact ⟨fun h => if_pos (hfix h), fun h => if_neg (by rw [hmove h]; exact hneg)⟩
  by_cases hrs : IsSquare r
  · 
    obtain ⟨a, ha⟩ := hrs
    have ht2 : t ^ 2 = (algebraMap F (AlgebraicClosure F) a) ^ 2 := by
      rw [ht, ha, map_mul, sq]
    have hσt : σ t = t := by
      rcases sq_eq_sq_iff_eq_or_eq_neg.mp ht2 with he | he <;> rw [he] <;>
        simp only [map_neg, AlgEquiv.commutes]
    rw [hε.1 ⟨a, ha⟩, one_zpow]
    exact H.1 hσt
  · 
    rw [hε.2 hrs]
    set Q := Nat.card (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) with hQ
    obtain ⟨j, hj⟩ := hQodd
    set m := (Q - 1) / 2 with hm
    have hm2 : 2 * m = Q - 1 := by omega
    have hc1 : ValuativeRel.valuation F (-(r ^ m) - 1) < 1 := by
      have e : -(r ^ m) - 1 = -(r ^ m + 1) := by ring
      rw [e, Valuation.map_neg]
      exact heuler hrs
    obtain ⟨b, hb⟩ := hensel (Q - 1) (by omega) hQv _ hc1
    have hrm0 : r ^ m ≠ 0 := pow_ne_zero _ hr0
    have hb0 : b ≠ 0 := by
      rintro rfl
      rw [zero_pow (by omega)] at hb
      exact hrm0 (neg_eq_zero.mp hb.symm)
    have hιb : algebraMap F (AlgebraicClosure F) b ≠ 0 := (map_ne_zero _).mpr hb0
    set y := t / algebraMap F (AlgebraicClosure F) b with hy_def
    have hy : y ^ (Q - 1) = -1 := by
      rw [hy_def, div_pow, ← hm2, pow_mul, ht, ← map_pow, ← map_pow, hm2, hb, map_neg,
        div_neg, div_self ((map_ne_zero _).mpr hrm0)]
    have hty : t = y * algebraMap F (AlgebraicClosure F) b := by
      rw [hy_def, div_mul_cancel₀ _ hιb]
    
    have hQneg : (-1 : AlgebraicClosure F) ^ Q = -1 := Odd.neg_one_pow ⟨j, hj⟩
    have hstar : ∀ x : AlgebraicClosure F, x ^ (Q - 1) = -1 →
        ∀ k : ℕ, x ^ (Q ^ k) = (-1) ^ k * x := by
      intro x hx k
      have hxQ : x ^ Q = -x := by
        have e : Q = (Q - 1) + 1 := by omega
        rw [e, pow_succ, hx]; ring
      induction k with
      | zero => simp
      | succ k ih =>
        calc x ^ (Q ^ (k + 1)) = (x ^ (Q ^ k)) ^ Q := by rw [pow_succ, pow_mul]
          _ = ((-1) ^ k * x) ^ Q := by rw [ih]
          _ = ((-1) ^ Q) ^ k * x ^ Q := by
            rw [mul_pow, ← pow_mul, ← pow_mul, mul_comm k Q]
          _ = (-1) ^ (k + 1) * x := by rw [hQneg, hxQ]; ring
    have hroot : EllipticRootNumber.IsPrimeToPRootOfUnity F y :=
      ⟨2 * (Q - 1), by omega, hp, by rw [mul_comm, pow_mul, hy]; norm_num⟩
    have hσy := hσ y hroot
    change σ y ^ (Q ^ (-n).toNat) = y ^ (Q ^ n.toNat) at hσy
    have hσy1 : σ y ^ (Q - 1) = -1 := by rw [← map_pow, hy, map_neg, map_one]
    obtain ⟨k, hk, hσyk⟩ : ∃ k : ℕ, (n = k ∨ n = -k) ∧ σ y = (-1) ^ k * y := by
      rcases le_or_gt 0 n with hn | hn
      · refine ⟨n.toNat, Or.inl (Int.toNat_of_nonneg hn).symm, ?_⟩
        rw [Int.toNat_eq_zero.mpr (by omega), pow_zero, pow_one] at hσy
        rw [hσy, hstar y hy]
      · refine ⟨(-n).toNat, Or.inr (by rw [Int.toNat_of_nonneg (by omega)]; ring), ?_⟩
        have hz0 : n.toNat = 0 := Int.toNat_eq_zero.mpr (by omega)
        rw [hz0, pow_zero, pow_one, hstar (σ y) hσy1] at hσy
        have hsq1 : ((-1 : AlgebraicClosure F) ^ (-n).toNat) * (-1) ^ (-n).toNat = 1 := by
          rw [← pow_add, ← two_mul, pow_mul]
          norm_num
        linear_combination ((-1 : AlgebraicClosure F) ^ (-n).toNat) * hσy - σ y * hsq1
    have hσιb : σ (algebraMap F (AlgebraicClosure F) b) = algebraMap F (AlgebraicClosure F) b :=
      AlgEquiv.commutes σ b
    rcases Int.even_or_odd n with hn | hn
    · have hke : Even k := by
        rcases hk with h | h
        · rw [h] at hn; exact (Int.even_coe_nat _).mp hn
        · rw [h, even_neg] at hn; exact (Int.even_coe_nat _).mp hn
      have hσt : σ t = t := by
        rw [hty, map_mul σ, hσιb, hσyk, Even.neg_one_pow hke, one_mul]
      rw [Even.neg_one_zpow hn]
      exact H.1 hσt
    · have hko : Odd k := by
        rcases hk with h | h
        · rw [h] at hn; exact (Int.odd_coe_nat _).mp hn
        · rw [h, odd_neg] at hn; exact (Int.odd_coe_nat _).mp hn
      have hσt : σ t = -t := by
        rw [hty, map_mul σ, hσιb, hσyk, Odd.neg_one_pow hko, neg_one_mul, neg_mul]
      obtain ⟨l, rfl⟩ := hn
      rw [zpow_add, zpow_mul, even_two.neg_one_zpow, one_zpow, one_mul, zpow_one]
      exact H.2 hσt

theorem rootNumberNonarch_of_unramified_twist {F : Type u} [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (E : WeierstrassCurve F) (ε : ℤˣ)
    (hpg : ¬ EllipticRootNumber.IsPotentiallyGood F E)
    (hdeg : (∀ σ ∈ EllipticRootNumber.weilGroup F, ∃ n : ℤ, EllipticRootNumber.ActsAsFrobPow F σ n) ∧
      (∀ (σ : EllipticRootNumber.weilGroup F) (n : ℤ), EllipticRootNumber.ActsAsFrobPow F σ n →
        EllipticRootNumber.weilDegreeHom F σ = Multiplicative.ofAdd n))
    (hbot : EllipticRootNumber.resDeg F ⊥ = 1 ∧
      (∀ x y : (⊥ : IntermediateField F (AlgebraicClosure F)), x ≠ 0 → y ≠ 0 →
        EllipticRootNumber.relVal F ⊥ (x * y) =
          EllipticRootNumber.relVal F ⊥ x + EllipticRootNumber.relVal F ⊥ y) ∧
      (∃ x : (⊥ : IntermediateField F (AlgebraicClosure F)), EllipticRootNumber.relVal F ⊥ x = 1))
    (hstd : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → EllipticRootNumber.stdChar F x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ EllipticRootNumber.stdChar F x ≠ 1)
    (hquad : ∀ (σ : EllipticRootNumber.AbsGal F) (n : ℤ), EllipticRootNumber.ActsAsFrobPow F σ n →
      EllipticRootNumber.quadSign F E σ = ε ^ n) :
    EllipticRootNumber.rootNumberNonarch F E = -ε :=
by
  open EllipticRootNumber in
  
  have relVal1 : relVal F ⊥ (1 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
    have h := hbot.2.1 1 1 one_ne_zero one_ne_zero
    rw [mul_one] at h
    omega
  have valL_eq : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      valL F ⊥ x = relVal F ⊥ x := by
    intro x
    unfold valL
    rw [hbot.1, Nat.cast_one, Int.ediv_one]
  have relVal0 : relVal F ⊥ (0 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
    unfold relVal
    rw [Algebra.norm_zero]
    unfold addVal
    rw [dif_pos rfl]
  
  have hdeg0 : ∀ w : relWeil F ⊥, (w : AbsGal F) ∈ inertia F →
      Multiplicative.toAdd (weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F ⊥) w)) = 0 := by
    intro w hw
    have h0 : ActsAsFrobPow F (w : AbsGal F) 0 := by
      intro ζ hζ
      have h1 : (w : AbsGal F) ζ = ζ :=
        (IntermediateField.mem_fixingSubgroup_iff (unramifiedClosure F) _).mp hw ζ
          (IntermediateField.subset_adjoin F _ hζ)
      simp [h1]
    rw [hdeg.2 (Subgroup.inclusion (relWeil_le_weilGroup F ⊥) w) 0 h0, toAdd_ofAdd]
  
  obtain ⟨εΩ, hεΩ⟩ : ∃ e : (Ω F)ˣ, Units.map (Int.castRingHom (Ω F)).toMonoidHom ε = e := ⟨_, rfl⟩
  have s2 : ∀ w : relWeil F ⊥, quadCharΩ F E ⊥ w =
      εΩ ^ Multiplicative.toAdd (weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F ⊥) w)) := by
    intro w
    obtain ⟨n, hn⟩ := hdeg.1 (w : AbsGal F) (relWeil_le_weilGroup F ⊥ w.2)
    rw [hdeg.2 (Subgroup.inclusion (relWeil_le_weilGroup F ⊥) w) n hn, toAdd_ofAdd]
    show Units.map (Int.castRingHom (Ω F)).toMonoidHom (quadSign F E (w : AbsGal F)) = _
    rw [hquad _ n hn, map_zpow, hεΩ]
  have hnorm : ∀ w : relWeil F ⊥, relNorm F ⊥ w = qUnit F ^
      Multiplicative.toAdd (weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F ⊥) w)) := by
    intro w
    first
    | rfl
    | simp [relNorm, weilNormHom, zpowersHom_apply]
  have hinN : ∀ w : relWeil F ⊥, (w : AbsGal F) ∈ inertia F → relNorm F ⊥ w = 1 := by
    intro w hw
    rw [hnorm, hdeg0 w hw, zpow_zero]
  have hdegrec : ∀ (rec : LocalReciprocity F) (x : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ),
      Multiplicative.toAdd (weilDegreeHom F
        (Subgroup.inclusion (relWeil_le_weilGroup F ⊥) (rec.recMap ⊥ x))) = -relVal F ⊥ x := by
    intro rec x
    rw [rec.degree_rec ⊥ x, toAdd_ofAdd]
  
  have mkChar : ∀ c : (Ω F)ˣ, ∃ χ' : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (Ω F)ˣ,
      ∀ x, χ' x = c ^ relVal F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F))) := by
    intro c
    refine ⟨{ toFun := fun x => c ^ relVal F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F)))
              map_one' := by simp only [Units.val_one, relVal1, zpow_zero]
              map_mul' := fun x y => by
                simp only [Units.val_mul]
                rw [hbot.2.1 _ _ x.ne_zero y.ne_zero, zpow_add] }, fun x => rfl⟩
  
  have hcX : condExpChar F ⊥ (stdChar F) = 0 := by
    unfold condExpChar
    apply IsGreatest.csSup_eq
    refine ⟨fun x hx => hstd.1 x (by simpa using hx), fun d hd => ?_⟩
    by_contra hlt
    push_neg at hlt
    obtain ⟨x₁, hx₁, hne⟩ := hstd.2
    exact hne (hd x₁ (by omega))
  have s3 : ∀ (c : (Ω F)ˣ) (χ' : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (Ω F)ˣ),
      (∀ x, χ' x = c ^ relVal F ⊥ (x : (⊥ : IntermediateField F (AlgebraicClosure F)))) →
      tateEps F ⊥ χ' (stdChar F) = 1 := by
    intro c χ' hχ'
    have hcE : condExp F ⊥ χ' = 0 := by
      unfold condExp
      apply Nat.sInf_eq_zero.mpr
      left
      show ∀ u ∈ unitGroup F ⊥ 0, χ' u = 1
      intro u hu
      unfold unitGroup at hu
      refine (Subgroup.closure_le χ'.ker).mpr ?_ hu
      intro v hv
      rw [Set.mem_setOf_eq, if_pos rfl] at hv
      rw [SetLike.mem_coe, MonoidHom.mem_ker, hχ', ← valL_eq, hv, zpow_zero]
    have ht : valL F ⊥ ((tateElt F ⊥ χ' (stdChar F) :
        (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
          (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
      have h : valL F ⊥ ((tateElt F ⊥ χ' (stdChar F) :
          (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
            (⊥ : IntermediateField F (AlgebraicClosure F))) =
          (condExp F ⊥ χ' : ℤ) + condExpChar F ⊥ (stdChar F) :=
        Classical.epsilon_spec
          (p := fun c : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ =>
            valL F ⊥ (c : (⊥ : IntermediateField F (AlgebraicClosure F))) =
              (condExp F ⊥ χ' : ℤ) + condExpChar F ⊥ (stdChar F))
          ⟨1, by simp [hcE, hcX, valL_eq, relVal1]⟩
      simp [h, hcE, hcX]
    unfold tateEps
    rw [hcX, zpow_zero, one_mul, if_pos hcE, hχ', ← valL_eq, ht, zpow_zero, Units.val_one]
  
  have hψ : IsAdmissibleChar F ⊥ (stdChar F) := by
    refine ⟨fun h => ?_, 0, hstd.1⟩
    obtain ⟨x₁, -, hne⟩ := hstd.2
    rw [h, AddChar.one_apply] at hne
    exact hne rfl
  have weilChar : ∀ ψc : relWeil F ⊥ →* (Ω F)ˣ,
      (∀ w : relWeil F ⊥, (w : AbsGal F) ∈ inertia F → ψc w = 1) →
      IsWeilRep F ⊥ (charRep F ⊥ ψc) := by
    intro ψc hc
    refine ⟨inferInstance, Set.univ, Filter.univ_mem, fun w _ hw => ?_⟩
    show ((ψc w : (Ω F)ˣ) : Ω F) • LinearMap.id = 1
    rw [hc w hw, Units.val_one, one_smul]
    rfl
  
  have s4 : ∀ (rec : LocalReciprocity F) (lc : LocalConstants F rec)
      (χ : relWeil F ⊥ →* (Ω F)ˣ) (a : (Ω F)ˣ),
      (∀ w, χ w = a ^ Multiplicative.toAdd
        (weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F ⊥) w))) →
      lc.eps ⊥ (spTwistRep F ⊥ χ) (stdChar F) = 1 := by
    intro rec lc χ a hχ
    have hinχ : ∀ w : relWeil F ⊥, (w : AbsGal F) ∈ inertia F → χ w = 1 := by
      intro w hw
      rw [hχ, hdeg0 w hw, zpow_zero]
    have hcharEps : ∀ (ψc : relWeil F ⊥ →* (Ω F)ˣ) (b : (Ω F)ˣ),
        (∀ w, ψc w = b ^ Multiplicative.toAdd
          (weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F ⊥) w))) →
        IsWeilRep F ⊥ (charRep F ⊥ ψc) ∧ lc.eps ⊥ (charRep F ⊥ ψc) (stdChar F) = 1 := by
      intro ψc b hb
      have hW := weilChar ψc (fun w hw => by rw [hb, hdeg0 w hw, zpow_zero])
      refine ⟨hW, ?_⟩
      obtain ⟨χ', hχ'⟩ := mkChar b⁻¹
      have hrec : ∀ x, χ' x = ψc (rec.recMap ⊥ x) := by
        intro x
        rw [hχ', hb, hdegrec rec x, zpow_neg, inv_zpow]
      have h := lc.eps_char ⊥ (stdChar F) hψ ψc hW χ' hrec
      rw [s3 b⁻¹ χ' hχ'] at h
      exact Units.val_eq_one.mp h
    obtain ⟨hW₁, he₁⟩ := hcharEps (χ * relNorm F ⊥) (a * qUnit F) (fun w => by
      rw [MonoidHom.mul_apply, hχ, hnorm, mul_zpow])
    obtain ⟨hW₂, he₂⟩ := hcharEps χ a hχ
    have hWsp : IsWeilRep F ⊥ (spTwistRep F ⊥ χ) := by
      refine ⟨inferInstance, Set.univ, Filter.univ_mem, fun w _ hw => ?_⟩
      apply LinearMap.ext
      intro v
      funext i
      simp [spTwistRep, hinχ w hw, hinN w hw]
    let f : ULift.{u} (Ω F) →ₗ[Ω F] (Fin 2 → ULift.{u} (Ω F)) :=
      LinearMap.single (Ω F) (fun _ : Fin 2 => ULift.{u} (Ω F)) 1
    let g : (Fin 2 → ULift.{u} (Ω F)) →ₗ[Ω F] ULift.{u} (Ω F) := LinearMap.proj 0
    have hf : ∀ w, f ∘ₗ charRep F ⊥ (χ * relNorm F ⊥) w = spTwistRep F ⊥ χ w ∘ₗ f := by
      intro w
      apply LinearMap.ext
      intro x
      funext i
      fin_cases i <;> simp [f, charRep, spTwistRep]
    have hg : ∀ w, g ∘ₗ spTwistRep F ⊥ χ w = charRep F ⊥ χ w ∘ₗ g := by
      intro w
      apply LinearMap.ext
      intro v
      simp [g, charRep, spTwistRep]
    have hfi : Function.Injective f := by
      intro x y hxy
      simpa [f] using congrFun hxy 1
    have hgs : Function.Surjective g := fun y => ⟨fun _ => y, rfl⟩
    have hrange : LinearMap.range f = LinearMap.ker g := by
      ext v
      simp only [LinearMap.mem_range, LinearMap.mem_ker]
      constructor
      · rintro ⟨x, rfl⟩
        simp [f, g]
      · intro hv
        have hv' : v 0 = 0 := hv
        refine ⟨v 1, ?_⟩
        funext i
        fin_cases i
        · simp [f, hv']
        · simp [f]
    have h := lc.eps_exact ⊥ (stdChar F) hψ (charRep F ⊥ (χ * relNorm F ⊥)) (spTwistRep F ⊥ χ)
      (charRep F ⊥ χ) hW₁ hWsp hW₂ f g hf hg hfi hgs hrange
    rw [h, he₁, he₂, mul_one]
  
  have G : ∀ {M : Type u} [AddCommGroup M] [Module (Ω F) M] (K : Submodule (Ω F) M)
      (T : M →ₗ[Ω F] M) (hK : K ≤ K.comap T) (a : Ω F),
      (∀ x, T x - a • x ∈ K) →
      (∃ π : M →ₗ[Ω F] Ω F, Function.Surjective π ∧ LinearMap.ker π = K) →
      LinearMap.det (-(Submodule.mapQ K K T hK)) = -a := by
    intro M _ _ K T hK a h1 h2
    obtain ⟨π, hπs, hπk⟩ := h2
    have hmap : Submodule.mapQ K K T hK = a • LinearMap.id := by
      apply Submodule.linearMap_qext
      refine LinearMap.ext fun x => ?_
      show Submodule.mapQ K K T hK (Submodule.Quotient.mk x) = a • Submodule.Quotient.mk x
      rw [Submodule.mapQ_apply, ← Submodule.Quotient.mk_smul, Submodule.Quotient.eq]
      exact h1 x
    have hfin : Module.finrank (Ω F) (M ⧸ K) = 1 := by
      have e : (M ⧸ K) ≃ₗ[Ω F] Ω F :=
        (Submodule.quotEquivOfEq K (LinearMap.ker π) hπk.symm).trans
          (π.quotKerEquivOfSurjective hπs)
      rw [e.finrank_eq, Module.finrank_self]
    rw [hmap, ← neg_smul, LinearMap.det_smul, LinearMap.det_id, hfin, pow_one, mul_one]
  have s5abs : ∀ (σ' : WDRep F ⊥) (a : Ω F),
      (∀ v : σ'.V, ∀ w : relWeil F ⊥, (w : AbsGal F) ∈ inertia F → σ'.ρ w v = v) →
      ∀ π : σ'.V →ₗ[Ω F] Ω F, Function.Surjective π → LinearMap.ker π = LinearMap.ker σ'.N →
      (∀ v, π (σ'.ρ (geomFrobL F ⊥ (resDeg F ⊥)) v) = a * π v) →
      frobDet F ⊥ σ' = -a := by
    intro σ' a hall π hπs hπk hπΦ
    have hall' : ∀ v, v ∈ inertiaInvariants F ⊥ σ' := fun v w hw => hall v w hw
    have hmemK : ∀ x : inertiaInvariants F ⊥ σ',
        x ∈ (LinearMap.ker σ'.N).comap (inertiaInvariants F ⊥ σ').subtype ↔ π x = 0 := by
      intro x
      rw [Submodule.mem_comap, ← hπk, LinearMap.mem_ker, Submodule.subtype_apply]
    have hI : ∀ v ∈ inertiaInvariants F ⊥ σ',
        σ'.ρ (geomFrobL F ⊥ (resDeg F ⊥)) v ∈ inertiaInvariants F ⊥ σ' :=
      fun v _ => hall' _
    have h1 : ∀ x, (σ'.ρ (geomFrobL F ⊥ (resDeg F ⊥))).restrict hI x - a • x ∈
        (LinearMap.ker σ'.N).comap (inertiaInvariants F ⊥ σ').subtype := by
      intro x
      rw [hmemK]
      simp [hπΦ]
    have hK : (LinearMap.ker σ'.N).comap (inertiaInvariants F ⊥ σ').subtype ≤
        ((LinearMap.ker σ'.N).comap (inertiaInvariants F ⊥ σ').subtype).comap
          ((σ'.ρ (geomFrobL F ⊥ (resDeg F ⊥))).restrict hI) := by
      intro x hx
      have := Submodule.add_mem _ (h1 x) (Submodule.smul_mem _ a hx)
      simpa using this
    unfold frobDet
    dsimp only
    rw [dif_pos hI, dif_pos hK]
    refine G _ _ hK a h1 ⟨π ∘ₗ (inertiaInvariants F ⊥ σ').subtype, ?_, ?_⟩
    · intro t
      obtain ⟨v, hv⟩ := hπs t
      exact ⟨⟨v, hall' v⟩, hv⟩
    · rw [LinearMap.ker_comp, hπk]
  have hspN : ∀ v : Fin 2 → ULift.{u} (Ω F), spN F v = 0 ↔ v 0 = 0 := by
    intro v
    constructor
    · intro h
      have := congrFun h 1
      simpa [spN] using this
    · intro h
      funext i
      fin_cases i <;> simp [spN, h]
  have s5 : ∀ χ : relWeil F ⊥ →* (Ω F)ˣ,
      (∀ w : relWeil F ⊥, (w : AbsGal F) ∈ inertia F → χ w = 1) →
      frobDet F ⊥ { V := Fin 2 → ULift.{u} (Ω F), ρ := spTwistRep F ⊥ χ, N := spN F } =
        -((χ (geomFrobL F ⊥ (resDeg F ⊥)) : (Ω F)ˣ) : Ω F) := by
    intro χ hinχ
    refine s5abs _ _ ?_
      ((ULift.moduleEquiv : ULift.{u} (Ω F) ≃ₗ[Ω F] Ω F).toLinearMap ∘ₗ LinearMap.proj 0)
      ?_ ?_ ?_
    · intro v w hw
      funext i
      simp [spTwistRep, hinχ w hw, hinN w hw]
    · intro t
      exact ⟨fun _ => ⟨t⟩, rfl⟩
    · ext v
      change _ = (0 : Ω F) ↔ spN F v = 0
      rw [hspN]
      exact ⟨fun h => ULift.ext _ _ h, fun h => by
        show (v 0).down = 0
        rw [h]
        rfl⟩
    · intro v
      have hv : (spTwistRep F ⊥ χ (geomFrobL F ⊥ (resDeg F ⊥)) v) 0 =
          ((χ (geomFrobL F ⊥ (resDeg F ⊥)) : (Ω F)ˣ) : Ω F) • v 0 := by
        simp [spTwistRep]
      show ((spTwistRep F ⊥ χ (geomFrobL F ⊥ (resDeg F ⊥)) v) 0).down =
        ((χ (geomFrobL F ⊥ (resDeg F ⊥)) : (Ω F)ˣ) : Ω F) * (v 0).down
      rw [hv]
      rfl
  
  have s6 : ∀ rec : LocalReciprocity F,
      weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F ⊥)
        (geomFrobL F ⊥ (resDeg F ⊥))) = Multiplicative.ofAdd (-1 : ℤ) := by
    intro rec
    obtain ⟨x₀, hx₀⟩ := hbot.2.2
    have hx0 : x₀ ≠ 0 := by
      rintro rfl
      rw [relVal0] at hx₀
      exact absurd hx₀ (by norm_num)
    have h : weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F ⊥)
        (geomFrobL F ⊥ (resDeg F ⊥))) = Multiplicative.ofAdd (-((resDeg F ⊥ : ℕ) : ℤ)) :=
      Classical.epsilon_spec (p := fun w : relWeil F ⊥ =>
        weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F ⊥) w) =
          Multiplicative.ofAdd (-((resDeg F ⊥ : ℕ) : ℤ)))
        ⟨rec.recMap ⊥ (Units.mk0 x₀ hx0), by
          show weilDegreeHom F _ = _
          rw [rec.degree_rec ⊥ (Units.mk0 x₀ hx0), Units.val_mk0, hx₀]
          simp [hbot.1]⟩
    rw [h]
    simp [hbot.1]
  
  have key : ∀ (rec : LocalReciprocity F) (lc : LocalConstants F rec),
      localEps F E lc = -((ε : ℤ) : Ω F) := by
    intro rec lc
    have hw : wdRep F E =
        { V := Fin 2 → ULift.{u} (Ω F), ρ := spTwistRep F ⊥ (quadCharΩ F E ⊥), N := spN F } := by
      unfold wdRep
      exact if_neg hpg
    have hinχ : ∀ w : relWeil F ⊥, (w : AbsGal F) ∈ inertia F → quadCharΩ F E ⊥ w = 1 := by
      intro w hw
      rw [s2, hdeg0 w hw, zpow_zero]
    unfold localEps
    rw [hw]
    unfold epsWD
    dsimp only
    rw [s4 rec lc _ εΩ s2, s5 _ hinχ, s2, s6 rec, toAdd_ofAdd, zpow_neg_one, ← hεΩ, ← map_inv,
      Int.units_inv_eq_self, Units.val_one, one_mul]
    simp [Units.coe_map]
  have hLC : HasLocalConstants F :=
    ⟨Classical.choice (local_reciprocity F), langlands_deligne F _⟩
  rw [rootNumberNonarch_of_hasLocalConstants F E hLC, key]
  rcases Int.units_eq_one_or ε with rfl | rfl
  · rw [Units.val_one, Int.cast_one, if_pos rfl]
  · have h2 : -((((-1 : ℤˣ) : ℤ) : Ω F)) ≠ -1 := by
      rw [Units.val_neg, Units.val_one, Int.cast_neg, Int.cast_one, neg_neg]
      intro h
      have h' : (2 : Ω F) = 0 := by linear_combination h
      exact two_ne_zero h'
    rw [if_neg h2, neg_neg]

theorem rootNumber_mult_odd {K : Type u} [Field K] [NumberField K] (e₁ e₂ e₃ : K)
    (h₁₂ : e₁ ≠ e₂) (h₁₃ : e₁ ≠ e₃) (h₂₃ : e₂ ≠ e₃)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : IsDedekindDomain.HeightOneSpectrum.valuation K v 2 = 1)
    (hα : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) ≤ 1)
    (hβ : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) ≤ 1)
    (hγ : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₂ - e₃) ≤ 1)
    (hbad : ¬ (IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) = 1 ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) = 1 ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K v (e₂ - e₃) = 1))
    (hnot : ¬ (IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) < 1 ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) < 1)) :
    rootNumber ((threeRootsCurve e₁ e₂ e₃).baseChange (v.adicCompletion K)) =
      multSplitSign e₁ e₂ e₃ v :=
by
  classical
  set E₀ := (threeRootsCurve e₁ e₂ e₃).baseChange (v.adicCompletion K) with hE₀
  have hval : ∀ x : K, Valued.v (algebraMap K (v.adicCompletion K) x) =
      IsDedekindDomain.HeightOneSpectrum.valuation K v x := fun x =>
    IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v x
  
  obtain ⟨rK, hr, hms⟩ : ∃ rK : K,
      ((IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) < 1 ∧ rK = e₁ - e₃) ∨
      (¬ IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) < 1 ∧
        IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) < 1 ∧ rK = e₁ - e₂) ∨
      (¬ IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) < 1 ∧
        ¬ IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) < 1 ∧ rK = -(e₁ - e₂))) ∧
      (IsSquare (algebraMap K (v.adicCompletion K) rK) → multSplitSign e₁ e₂ e₃ v = -1) ∧
      (¬ IsSquare (algebraMap K (v.adicCompletion K) rK) → multSplitSign e₁ e₂ e₃ v = 1) := by
    by_cases c1 : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) < 1
    · refine ⟨e₁ - e₃, Or.inl ⟨c1, rfl⟩, ?_⟩
      unfold multSplitSign
      rw [if_pos c1]
      exact ⟨fun h => if_pos h, fun h => if_neg h⟩
    · by_cases c2 : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) < 1
      · refine ⟨e₁ - e₂, Or.inr (Or.inl ⟨c1, c2, rfl⟩), ?_⟩
        unfold multSplitSign
        rw [if_neg c1, if_pos c2]
        exact ⟨fun h => if_pos h, fun h => if_neg h⟩
      · refine ⟨-(e₁ - e₂), Or.inr (Or.inr ⟨c1, c2, rfl⟩), ?_⟩
        unfold multSplitSign
        rw [if_neg c1, if_neg c2]
        exact ⟨fun h => if_pos h, fun h => if_neg h⟩
  
  obtain ⟨hj, hrv, hu⟩ :=
    threeRootsCurve_mult_odd_val e₁ e₂ e₃ h₁₂ h₁₃ h₂₃ v h2 hα hβ hγ hbad hnot rK hr
  
  have hnarch := adicCompletion_not_real_complex v
  have hS := adicCompletion_nonempty_localFieldStructure v
  obtain ⟨C, hC⟩ : ∃ C : WeierstrassCurve.VariableChange (v.adicCompletion K),
      C • E₀ = Quotient.out (Quotient.mk (MulAction.orbitRel
        (WeierstrassCurve.VariableChange (v.adicCompletion K))
        (WeierstrassCurve (v.adicCompletion K))) E₀) := by
    have h := Quotient.mk_out (s := MulAction.orbitRel
      (WeierstrassCurve.VariableChange (v.adicCompletion K))
      (WeierstrassCurve (v.adicCompletion K))) E₀
    exact MulAction.mem_orbit_iff.mp (MulAction.orbitRel_apply.mp h)
  unfold rootNumber rootNumberCl
  rw [← hC]
  unfold rootNumberRaw
  rw [if_neg hnarch, dif_pos hS]
  suffices H : ∀ S : EllipticRootNumber.LocalFieldStructure (v.adicCompletion K),
      @EllipticRootNumber.rootNumberNonarch (v.adicCompletion K) _ S.rel S.top S.isLocalField
        (C • E₀) = multSplitSign e₁ e₂ e₃ v from H _
  intro S
  letI := S.rel
  letI := S.top
  haveI := S.isLocalField
  haveI : CharZero (v.adicCompletion K) :=
    charZero_of_injective_algebraMap (algebraMap K (v.adicCompletion K)).injective
  
  have hle : ∀ y : v.adicCompletion K,
      ValuativeRel.valuation (v.adicCompletion K) y ≤ 1 ↔ Valued.v y ≤ 1 :=
    fun y => localFieldStructure_adicCompletion_le_one_iff v S y
  have hlt : ∀ y : v.adicCompletion K, Valued.v y < 1 →
      ValuativeRel.valuation (v.adicCompletion K) y < 1 := by
    intro y hy
    by_cases hy0 : y = 0
    · rw [hy0, map_zero]; exact zero_lt_one
    have hyi : y⁻¹ ≠ 0 := inv_ne_zero hy0
    have h1 : 1 < Valued.v y⁻¹ := (Valuation.one_lt_val_iff _ hyi).mpr (by rw [inv_inv]; exact hy)
    have h2' : ¬ ValuativeRel.valuation (v.adicCompletion K) y⁻¹ ≤ 1 :=
      fun h => absurd ((hle _).mp h) (not_le.mpr h1)
    have h3 := (Valuation.one_lt_val_iff _ hyi).mp (lt_of_not_ge h2')
    rwa [inv_inv] at h3
  have heq : ∀ y : v.adicCompletion K, Valued.v y = 1 →
      ValuativeRel.valuation (v.adicCompletion K) y = 1 := by
    intro y hy
    have hy0 : y ≠ 0 := by
      rintro rfl
      rw [map_zero] at hy
      exact zero_ne_one hy
    have hyi : y⁻¹ ≠ 0 := inv_ne_zero hy0
    refine le_antisymm ((hle y).mpr hy.le) (not_lt.mp fun hlt1 => ?_)
    have h1 : 1 < ValuativeRel.valuation (v.adicCompletion K) y⁻¹ :=
      (Valuation.one_lt_val_iff _ hyi).mpr (by rw [inv_inv]; exact hlt1)
    have h2' : ¬ Valued.v y⁻¹ ≤ 1 := fun h => absurd ((hle _).mpr h) (not_le.mpr h1)
    have h3 := (Valuation.one_lt_val_iff _ hyi).mp (lt_of_not_ge h2')
    rw [inv_inv, hy] at h3
    exact lt_irrefl _ h3
  
  have hc4 : E₀.c₄ = algebraMap K (v.adicCompletion K) (threeRootsCurve e₁ e₂ e₃).c₄ :=
    WeierstrassCurve.map_c₄ _ _
  have hc6 : E₀.c₆ = algebraMap K (v.adicCompletion K) (threeRootsCurve e₁ e₂ e₃).c₆ :=
    WeierstrassCurve.map_c₆ _ _
  have hΔ : E₀.Δ = algebraMap K (v.adicCompletion K) (threeRootsCurve e₁ e₂ e₃).Δ :=
    WeierstrassCurve.map_Δ _ _
  set u : v.adicCompletion K := ((C.u⁻¹ : (v.adicCompletion K)ˣ) : v.adicCompletion K) with hu_def
  have hu0 : u ≠ 0 := Units.ne_zero _
  set r : v.adicCompletion K := algebraMap K (v.adicCompletion K) rK with hrdef
  have hrK0 : rK ≠ 0 := by
    rintro h
    rw [h, map_zero] at hrv
    exact zero_ne_one hrv
  have hr0 : r ≠ 0 := by
    rw [hrdef]
    exact (map_ne_zero _).mpr hrK0
  have hj' : (C • E₀).c₄ ^ 3 / (C • E₀).Δ = algebraMap K (v.adicCompletion K)
      ((threeRootsCurve e₁ e₂ e₃).c₄ ^ 3 / (threeRootsCurve e₁ e₂ e₃).Δ) := by
    rw [WeierstrassCurve.variableChange_c₄, WeierstrassCurve.variableChange_Δ, map_div₀, map_pow,
      ← hc4, ← hΔ, mul_pow, ← pow_mul]
    exact mul_div_mul_left _ _ (pow_ne_zero _ hu0)
  have hpg : ¬ EllipticRootNumber.IsPotentiallyGood (v.adicCompletion K) (C • E₀) := by
    intro h
    unfold EllipticRootNumber.IsPotentiallyGood at h
    rw [hj', hle, hval] at h
    exact absurd hj (not_lt.mpr h)
  have h2S : ValuativeRel.valuation (v.adicCompletion K) 2 = 1 := by
    apply heq
    have e2 : (2 : v.adicCompletion K) = algebraMap K (v.adicCompletion K) 2 :=
      (map_ofNat _ 2).symm
    rw [e2, hval, h2]
  have hrS : ValuativeRel.valuation (v.adicCompletion K) r = 1 :=
    heq _ (by rw [hrdef, hval, hrv])
  set u₀ : v.adicCompletion K := -E₀.c₆ / (64 * r ^ 3) with hu₀def
  have hu₀S : ValuativeRel.valuation (v.adicCompletion K) (u₀ - 1) < 1 := by
    apply hlt
    have e3 : u₀ - 1 = algebraMap K (v.adicCompletion K)
        (-(threeRootsCurve e₁ e₂ e₃).c₆ / (64 * rK ^ 3) - 1) := by
      rw [hu₀def, hc6, hrdef]
      simp only [map_sub, map_div₀, map_neg, map_mul, map_pow, map_ofNat, map_one]
    rw [e3, hval]
    exact hu
  set z : v.adicCompletion K := 8 * r * u ^ 3 with hz_def
  have hz : z ≠ 0 := by
    rw [hz_def]
    exact mul_ne_zero (mul_ne_zero (by norm_num) hr0) (pow_ne_zero _ hu0)
  have hc : -(C • E₀).c₆ = r * z ^ 2 * u₀ := by
    rw [WeierstrassCurve.variableChange_c₆, ← hu_def, hu₀def, hz_def]
    field_simp
    ring
  
  have hH := henselianLocalRing_integer_of_isNonarchimedeanLocalField (v.adicCompletion K)
  obtain ⟨ε, hε⟩ : ∃ ε : ℤˣ, (IsSquare r → ε = 1) ∧ (¬ IsSquare r → ε = -1) :=
    ⟨if IsSquare r then 1 else -1, fun h => if_pos h, fun h => if_neg h⟩
  have hquad := quadSign_eq_of_unit_twist hH h2S (C • E₀) r z u₀ hrS hz hu₀S hc ε hε
  rw [rootNumberNonarch_of_unramified_twist (C • E₀) ε hpg
    (weilDegreeHom_spec (v.adicCompletion K)) (relVal_bot_spec (v.adicCompletion K))
    (stdChar_spec (v.adicCompletion K)) hquad]
  by_cases hsq : IsSquare r
  · rw [hε.1 hsq, hms.1 hsq]
  · rw [hε.2 hsq, hms.2 hsq, neg_neg]

theorem phiSign_eq_of_descentClasses {F : Type*} [Field F]
    (w : Valuation F (WithZero (Multiplicative ℤ)))
    (π : F) (hπ : w π = WithZero.exp (-1 : ℤ))
    (ε : F) (hεw : w ε = 1) (hεns : ¬ IsSquare ε)
    (hεd : ∀ u : F, w u = 1 → IsSquare u ∨ IsSquare (ε * u))
    (t₁ t₂ t₃ : F) :
    phiSign F t₁ t₂ t₃ = -1 ↔
      ((IsDescentClass t₁ t₂ t₃ 1 ε ↔ IsDescentClass t₁ t₂ t₃ 1 π) ∧
        (IsDescentClass t₁ t₂ t₃ 1 π ↔ IsDescentClass t₁ t₂ t₃ 1 (ε * π))) :=
by
  classical
  
  have hπ0 : π ≠ 0 := by
    intro h; rw [h, map_zero] at hπ; exact WithZero.exp_ne_zero hπ.symm
  have hε0 : ε ≠ 0 := by
    intro h; rw [h, map_zero] at hεw; exact zero_ne_one hεw
  
  have notSq : ∀ y : F, w y = WithZero.exp (-1 : ℤ) → ¬ IsSquare y := by
    rintro y hy ⟨r, rfl⟩
    have hr : w r ≠ 0 := by
      intro h; rw [map_mul, h, zero_mul] at hy; exact WithZero.exp_ne_zero hy.symm
    obtain ⟨k, hk⟩ : ∃ k : ℤ, w r = WithZero.exp k := ⟨_, (WithZero.exp_log hr).symm⟩
    rw [map_mul, hk, ← WithZero.exp_add] at hy
    have := WithZero.exp_injective hy
    omega
  have hεπ : w (ε * π) = WithZero.exp (-1 : ℤ) := by rw [map_mul, hεw, hπ, one_mul]
  have hπε : w (π / ε) = WithZero.exp (-1 : ℤ) := by rw [map_div₀, hεw, hπ, div_one]
  
  have sqEq : ∀ a b : Fˣ, sqCl a = sqCl b ↔ IsSquare ((b : F) / (a : F)) := by
    intro a b
    unfold sqCl
    rw [QuotientGroup.eq, MonoidHom.mem_range]
    constructor
    · rintro ⟨s, hs⟩
      refine ⟨(s : F), ?_⟩
      have h' := congrArg Units.val hs
      simp only [powMonoidHom_apply, Units.val_pow_eq_pow_val, Units.val_mul,
        Units.val_inv_eq_inv_val] at h'
      rw [div_eq_inv_mul, ← h', pow_two]
    · rintro ⟨r, hr⟩
      have hr0 : r ≠ 0 := by
        rintro rfl
        rw [mul_zero, div_eq_zero_iff] at hr
        rcases hr with h | h
        · exact b.ne_zero h
        · exact a.ne_zero h
      refine ⟨Units.mk0 r hr0, ?_⟩
      ext
      simp only [powMonoidHom_apply, Units.val_pow_eq_pow_val, Units.val_mul,
        Units.val_inv_eq_inv_val, Units.val_mk0]
      rw [pow_two, ← hr, div_eq_inv_mul]
  
  have memImg : ∀ u : Fˣ, sqCl u ∈ phiImg F t₁ t₂ t₃ ↔ IsDescentClass t₁ t₂ t₃ 1 (u : F) := by
    intro u
    constructor
    · rintro ⟨u', hu', z₀, z₁, z₂, z₃, hnz, e1, e2⟩
      obtain ⟨σ, hσ⟩ := (sqEq u' u).mp hu'.symm
      have hu'0 : (u' : F) ≠ 0 := u'.ne_zero
      have hσ0 : σ ≠ 0 := by
        rintro rfl
        rw [mul_zero, div_eq_zero_iff] at hσ
        rcases hσ with h | h
        · exact u.ne_zero h
        · exact u'.ne_zero h
      have hu : (u : F) = (u' : F) * (σ * σ) := by
        rw [← hσ]; field_simp
      have k2 : (u' : F) * (σ * σ) * (z₂ / σ) ^ 2 = (u' : F) * z₂ ^ 2 := by
        field_simp
      have k3 : (u' : F) * (σ * σ) * (z₃ / σ) ^ 2 = (u' : F) * z₃ ^ 2 := by
        field_simp
      refine ⟨z₀, z₁, z₂ / σ, z₃ / σ, ?_, ?_, ?_⟩
      · rintro ⟨h0, h1, h2, h3⟩
        apply hnz
        refine ⟨h0, h1, ?_, ?_⟩
        · rcases div_eq_zero_iff.mp h2 with h | h
          · exact h
          · exact absurd h hσ0
        · rcases div_eq_zero_iff.mp h3 with h | h
          · exact h
          · exact absurd h hσ0
      · rw [hu]; linear_combination e1 - k2
      · rw [hu]; linear_combination e2 - k3
    · intro h
      exact ⟨u, rfl, h⟩
  
  have exh : ∀ x : F, x ≠ 0 →
      IsSquare x ∨ IsSquare (x / ε) ∨ IsSquare (x / π) ∨ IsSquare (x / (ε * π)) := by
    intro x hx
    have hwx : w x ≠ 0 := (Valuation.ne_zero_iff w).mpr hx
    obtain ⟨j, hj⟩ : ∃ j : ℤ, w x = WithZero.exp j := ⟨_, (WithZero.exp_log hwx).symm⟩
    have hwu : w (x * π ^ j) = 1 := by
      rw [map_mul, map_zpow₀, hπ, hj, ← WithZero.exp_zsmul, ← WithZero.exp_add]
      have : j + j • (-1 : ℤ) = 0 := by simp
      rw [this, WithZero.exp_zero]
    obtain ⟨m, hm | hm⟩ := Int.even_or_odd' j
    · have hp0 : π ^ m ≠ 0 := zpow_ne_zero m hπ0
      have hpj : π ^ j = π ^ m * π ^ m := by rw [hm, two_mul, zpow_add₀ hπ0]
      rcases hεd _ hwu with ⟨r, hr⟩ | ⟨r, hr⟩
      · left
        have hx' : x = r * r / (π ^ m * π ^ m) := by
          rw [eq_div_iff (mul_ne_zero hp0 hp0), ← hr, hpj]
        exact ⟨r / π ^ m, by rw [hx']; ring⟩
      · right; left
        have hx' : x = r * r / (ε * (π ^ m * π ^ m)) := by
          rw [eq_div_iff (mul_ne_zero hε0 (mul_ne_zero hp0 hp0)), ← hr, hpj]; ring
        exact ⟨r / (ε * π ^ m), by rw [hx']; ring⟩
    · have hp0 : π ^ m ≠ 0 := zpow_ne_zero m hπ0
      have hpj : π ^ j = π ^ m * π ^ m * π := by
        rw [hm, zpow_add₀ hπ0, two_mul, zpow_add₀ hπ0, zpow_one]
      rcases hεd _ hwu with ⟨r, hr⟩ | ⟨r, hr⟩
      · right; right; left
        have hx' : x = r * r / (π ^ m * π ^ m * π) := by
          rw [eq_div_iff (mul_ne_zero (mul_ne_zero hp0 hp0) hπ0), ← hr, hpj]
        exact ⟨r / (π ^ m * π), by rw [hx']; ring⟩
      · right; right; right
        have hx' : x = r * r / (ε * (π ^ m * π ^ m * π)) := by
          rw [eq_div_iff (mul_ne_zero hε0 (mul_ne_zero (mul_ne_zero hp0 hp0) hπ0)), ← hr, hpj]
          ring
        exact ⟨r / (ε * (π ^ m * π)), by rw [hx']; ring⟩
  
  obtain ⟨Uε, hUε⟩ : ∃ U : Fˣ, (U : F) = ε := ⟨Units.mk0 ε hε0, rfl⟩
  obtain ⟨Uπ, hUπ⟩ : ∃ U : Fˣ, (U : F) = π := ⟨Units.mk0 π hπ0, rfl⟩
  have hUεπ : ((Uε * Uπ : Fˣ) : F) = ε * π := by rw [Units.val_mul, hUε, hUπ]
  have n12 : sqCl (1 : Fˣ) ≠ sqCl Uε := by
    intro h; have := (sqEq _ _).mp h
    rw [Units.val_one, div_one, hUε] at this; exact hεns this
  have n13 : sqCl (1 : Fˣ) ≠ sqCl Uπ := by
    intro h; have := (sqEq _ _).mp h
    rw [Units.val_one, div_one, hUπ] at this; exact notSq π hπ this
  have n14 : sqCl (1 : Fˣ) ≠ sqCl (Uε * Uπ) := by
    intro h; have := (sqEq _ _).mp h
    rw [Units.val_one, div_one, hUεπ] at this; exact notSq _ hεπ this
  have n23 : sqCl Uε ≠ sqCl Uπ := by
    intro h; have := (sqEq _ _).mp h
    rw [hUε, hUπ] at this; exact notSq _ hπε this
  have n24 : sqCl Uε ≠ sqCl (Uε * Uπ) := by
    intro h; have := (sqEq _ _).mp h
    rw [hUεπ, hUε, show ε * π / ε = π by field_simp] at this
    exact notSq π hπ this
  have n34 : sqCl Uπ ≠ sqCl (Uε * Uπ) := by
    intro h; have := (sqEq _ _).mp h
    rw [hUεπ, hUπ, show ε * π / π = ε by field_simp] at this
    exact hεns this
  
  have hD1 : IsDescentClass t₁ t₂ t₃ 1 1 := ⟨0, 1, 1, 1, by simp, by ring, by ring⟩
  
  have hsurj : ∀ c : SqCl F, ∃ x : Fˣ, sqCl x = c := fun c => QuotientGroup.mk_surjective c
  have hS : ∀ c, c ∈ phiImg F t₁ t₂ t₃ ↔ (c = sqCl 1 ∨
      (c = sqCl Uε ∧ IsDescentClass t₁ t₂ t₃ 1 ε) ∨
      (c = sqCl Uπ ∧ IsDescentClass t₁ t₂ t₃ 1 π) ∨
      (c = sqCl (Uε * Uπ) ∧ IsDescentClass t₁ t₂ t₃ 1 (ε * π))) := by
    intro c
    obtain ⟨x, rfl⟩ := hsurj c
    rcases exh (x : F) x.ne_zero with h | h | h | h
    · rw [← (sqEq 1 x).mpr (by rwa [Units.val_one, div_one]), memImg, Units.val_one]
      simp [hD1, n12, n13, n14]
    · rw [← (sqEq Uε x).mpr (by rwa [hUε]), memImg, hUε]
      simp [n12.symm, n23, n24]
    · rw [← (sqEq Uπ x).mpr (by rwa [hUπ]), memImg, hUπ]
      simp [n13.symm, n23.symm, n34]
    · rw [← (sqEq (Uε * Uπ) x).mpr (by rwa [hUεπ]), memImg, hUεπ]
      simp [n14.symm, n24.symm, n34.symm]
  
  have hsign : phiSign F t₁ t₂ t₃ = -1 ↔
      ∃ k : ℕ, (phiImg F t₁ t₂ t₃).encard = 2 ^ k ∧ Even k := by
    unfold phiSign
    split_ifs with h
    · exact ⟨fun _ => h, fun _ => rfl⟩
    · exact ⟨fun h' => absurd h' (by decide), fun h' => absurd h' h⟩
  have hnat : ∀ n : ℕ, (∃ k : ℕ, ((n : ℕ) : ℕ∞) = 2 ^ k ∧ Even k) ↔
      (∃ k : ℕ, n = 2 ^ k ∧ Even k) := by
    intro n
    constructor
    · rintro ⟨k, hk, hev⟩; exact ⟨k, by exact_mod_cast hk, hev⟩
    · rintro ⟨k, hk, hev⟩; exact ⟨k, by exact_mod_cast hk, hev⟩
  have e1 : ∃ k : ℕ, (1 : ℕ) = 2 ^ k ∧ Even k := ⟨0, rfl, ⟨0, rfl⟩⟩
  have e4 : ∃ k : ℕ, (4 : ℕ) = 2 ^ k ∧ Even k := ⟨2, rfl, ⟨1, rfl⟩⟩
  have e2 : ¬ ∃ k : ℕ, (2 : ℕ) = 2 ^ k ∧ Even k := by
    rintro ⟨k, hk, hev⟩
    have : k = 1 := Nat.pow_right_injective le_rfl (hk.symm.trans (pow_one 2).symm)
    subst this; exact Nat.not_even_one hev
  have e3 : ¬ ∃ k : ℕ, (3 : ℕ) = 2 ^ k ∧ Even k := by
    rintro ⟨k, hk, -⟩
    rcases k with _ | k
    · simp at hk
    · rw [pow_succ] at hk; omega
  set c₁ : SqCl F := sqCl (1 : Fˣ) with hc₁
  set c₂ : SqCl F := sqCl Uε with hc₂
  set c₃ : SqCl F := sqCl Uπ with hc₃
  set c₄ : SqCl F := sqCl (Uε * Uπ) with hc₄
  have m1_234 : c₁ ∉ ({c₂, c₃, c₄} : Set (SqCl F)) := by simp [n12, n13, n14]
  have m2_34 : c₂ ∉ ({c₃, c₄} : Set (SqCl F)) := by simp [n23, n24]
  have m1_23 : c₁ ∉ ({c₂, c₃} : Set (SqCl F)) := by simp [n12, n13]
  have m1_24 : c₁ ∉ ({c₂, c₄} : Set (SqCl F)) := by simp [n12, n14]
  have m1_34 : c₁ ∉ ({c₃, c₄} : Set (SqCl F)) := by simp [n13, n14]
  rw [hsign]
  by_cases h2 : IsDescentClass t₁ t₂ t₃ 1 ε <;> by_cases h3 : IsDescentClass t₁ t₂ t₃ 1 π <;>
    by_cases h4 : IsDescentClass t₁ t₂ t₃ 1 (ε * π)
  · 
    have hE : phiImg F t₁ t₂ t₃ = {c₁, c₂, c₃, c₄} := by
      ext c; rw [hS]; simp [h2, h3, h4]
    have hc : (phiImg F t₁ t₂ t₃).encard = ((4 : ℕ) : ℕ∞) := by
      rw [hE, Set.encard_insert_of_notMem m1_234, Set.encard_insert_of_notMem m2_34,
        Set.encard_pair n34]
      norm_num
    rw [hc, hnat]
    exact iff_of_true e4 (by simp [h2, h3, h4])
  · 
    have hE : phiImg F t₁ t₂ t₃ = {c₁, c₂, c₃} := by
      ext c; rw [hS]; simp [h2, h3, h4]
    have hc : (phiImg F t₁ t₂ t₃).encard = ((3 : ℕ) : ℕ∞) := by
      rw [hE, Set.encard_insert_of_notMem m1_23, Set.encard_pair n23]
      norm_num
    rw [hc, hnat]
    exact iff_of_false e3 (by simp [h2, h3, h4])
  · 
    have hE : phiImg F t₁ t₂ t₃ = {c₁, c₂, c₄} := by
      ext c; rw [hS]; simp [h2, h3, h4]
    have hc : (phiImg F t₁ t₂ t₃).encard = ((3 : ℕ) : ℕ∞) := by
      rw [hE, Set.encard_insert_of_notMem m1_24, Set.encard_pair n24]
      norm_num
    rw [hc, hnat]
    exact iff_of_false e3 (by simp [h2, h3, h4])
  · 
