      have hyM : (s * w * s⁻¹ : EllipticRootNumber.relWeil F L) ∈
          (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F L) := by
        rw [Subgroup.mem_subgroupOf]
        show _ ∈ EllipticRootNumber.weilGroup F ⊓ M.fixingSubgroup
        exact Subgroup.mem_inf.mpr ⟨EllipticRootNumber.relWeil_le_weilGroup F L (s * w * s⁻¹).2,
          hyV.2⟩
