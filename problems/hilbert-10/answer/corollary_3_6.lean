by
  
  have V1 : ∀ y : F, y ≠ 0 → ∃ k : ℤ, w y = WithZero.exp k := fun y hy =>
    ⟨WithZero.log (w y), (WithZero.exp_log ((Valuation.ne_zero_iff w).mpr hy)).symm⟩
  
