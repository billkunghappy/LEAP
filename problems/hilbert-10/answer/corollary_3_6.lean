    generalize z₁ / z₀ = x at hC
    generalize z₂ / z₀ = a at hC
    have hx2 : x ^ 2 = (x ^ 2 + (t₁ - t₂)) + (-(t₁ - t₂)) := by ring
    rcases lt_trichotomy (w (x ^ 2 + (t₁ - t₂))) 1 with hlt | heq | hgt
    · have h1 : w ((x ^ 2 + (t₁ - t₂)) + (-(t₁ - t₂))) = w (-(t₁ - t₂)) :=
        Valuation.map_add_eq_of_lt_right w (by rw [hwnα]; exact hlt)
      rw [← hx2, hwnα] at h1
      have hx0 : x ≠ 0 := by
        rintro rfl; rw [zero_pow two_ne_zero, map_zero] at h1; exact zero_ne_one h1
      have hxinv : x * x⁻¹ = 1 := mul_inv_cancel₀ hx0
      obtain ⟨r, hr⟩ := hsq (1 - (x ^ 2 + (t₁ - t₂)) / x ^ 2) (by
        rw [sub_sub_cancel_left, Valuation.map_neg, Valuation.map_div, h1, div_one]; exact hlt)
      exact ⟨x * r, by
        linear_combination x ^ 2 * hr + (x ^ 2 + (t₁ - t₂)) * (x * x⁻¹ + 1) * hxinv⟩
    · exfalso
      have ha0 : a ≠ 0 := by
        rintro rfl
        rw [hC, zero_pow two_ne_zero, mul_zero, map_zero] at heq
        exact zero_ne_one heq
      exact hP a 1 ha0 (by rw [← hC, heq, one_pow, map_one])
    · exfalso
      have h1 : w ((x ^ 2 + (t₁ - t₂)) + (-(t₁ - t₂))) = w (x ^ 2 + (t₁ - t₂)) :=
        Valuation.map_add_eq_of_lt_left w (by rw [hwnα]; exact hgt)
      rw [← hx2] at h1
      have ha0 : a ≠ 0 := by
        rintro rfl
        rw [hC, zero_pow two_ne_zero, mul_zero, map_zero] at hgt
        exact (lt_irrefl _) (lt_of_lt_of_le hgt zero_le')
      exact hP a x ha0 (by rw [← hC, h1])
  · 
    rintro ⟨s, hs⟩
    have hu0 : u ≠ 0 := by
      intro h; rw [h, map_zero] at hu; exact WithZero.exp_ne_zero hu.symm
    have huinv : u * u⁻¹ = 1 := mul_inv_cancel₀ hu0
    have h20 : (2 : F) ≠ 0 := by
      intro h; rw [h, map_zero] at h2; exact zero_ne_one h2
    have h2inv : (2 : F) * 2⁻¹ = 1 := mul_inv_cancel₀ h20
    have hnα0 : -(t₁ - t₂) ≠ 0 := by
      intro h; rw [h, map_zero] at hwnα; exact zero_ne_one hwnα
    have hnαinv : (-(t₁ - t₂)) * (-(t₁ - t₂))⁻¹ = 1 := mul_inv_cancel₀ hnα0
    obtain ⟨m, hm_def⟩ : ∃ m : F, m = (t₂ - t₃) / u := ⟨_, rfl⟩
    have hum : u * m = t₂ - t₃ := by
      rw [hm_def]; linear_combination (t₂ - t₃) * huinv
    have hwm : w m ≤ 1 := by
      rw [hm_def, Valuation.map_div,
        div_le_one₀ (zero_lt_iff.mpr ((Valuation.ne_zero_iff w).mpr hu0)), hu]
      exact hV2 _ hγ
    obtain ⟨t, ht_def⟩ : ∃ t : F, t = (m - 1) / 2 := ⟨_, rfl⟩
    obtain ⟨s', hs'_def⟩ : ∃ s' : F, s' = (m + 1) / 2 := ⟨_, rfl⟩
    have hst : s' ^ 2 - t ^ 2 = m := by
      rw [ht_def, hs'_def]; linear_combination m * (2 * 2⁻¹ + 1) * h2inv
    have hwt : w t ≤ 1 := by
      rw [ht_def, Valuation.map_div, h2, div_one]
      exact (Valuation.map_sub w m 1).trans (max_le hwm (map_one w).le)
    have he1 : WithZero.exp (-1 : ℤ) < 1 := by
      rw [← WithZero.exp_zero, WithZero.exp_lt_exp]; norm_num
    have hy : w (u * t ^ 2 / (-(t₁ - t₂))) < 1 := by
      rw [Valuation.map_div, hwnα, div_one, map_mul, map_pow, hu]
      calc WithZero.exp (-1 : ℤ) * w t ^ 2 ≤ WithZero.exp (-1 : ℤ) * 1 :=
            mul_le_mul_left' (pow_le_one' hwt 2) _
        _ < 1 := by rw [mul_one]; exact he1
    obtain ⟨r, hr⟩ := hsq (1 + u * t ^ 2 / (-(t₁ - t₂))) (by
      rw [add_sub_cancel_left]; exact hy)
    have hx2 : (s * r) ^ 2 = -(t₁ - t₂) + u * t ^ 2 := by
      linear_combination (-r ^ 2) * hs + (t₁ - t₂) * hr + u * t ^ 2 * hnαinv
    refine ⟨1, s * r, t, s', fun h => one_ne_zero h.1, ?_, ?_⟩
    · linear_combination hx2
    · linear_combination hx2 - u * hst - hum

theorem phiSign_hilbTerm_mult_odd {K : Type u} [Field K] [NumberField K] (e₁ e₂ e₃ : K)
    (h₁₂ : e₁ ≠ e₂) (h₁₃ : e₁ ≠ e₃) (h₂₃ : e₂ ≠ e₃)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : IsDedekindDomain.HeightOneSpectrum.valuation K v 2 = 1)
    (hα : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) ≤ 1)
    (hβ : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) ≤ 1)
    (hγ : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₂ - e₃) ≤ 1)
    (hbad : ¬ (IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) = 1 ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) = 1 ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K v (e₂ - e₃) = 1))
    (hnot : ¬ (IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) < 1 ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) < 1)) :
    phiSign (v.adicCompletion K) (algebraMap K _ e₁) (algebraMap K _ e₂) (algebraMap K _ e₃) *
      hilbTerm (v.adicCompletion K) (algebraMap K _ e₁) (algebraMap K _ e₂) (algebraMap K _ e₃) =
      multSplitSign e₁ e₂ e₃ v :=
by
  classical
  
  have hval : ∀ x : K, Valued.v (algebraMap K (v.adicCompletion K) x) =
      IsDedekindDomain.HeightOneSpectrum.valuation K v x :=
    fun x => IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v x
  
  have hsq := adicCompletion_isSquare_of_valued_sub_one_lt_one v h2
  obtain ⟨ε, hεw, hεns, hεd⟩ := adicCompletion_exists_nonsquare_unit_dichotomy v h2 hsq
  have hres := adicCompletion_exists_sq_add_nonsquare_unit v h2
  obtain ⟨π₀, hπ₀⟩ := IsDedekindDomain.HeightOneSpectrum.valuation_exists_uniformizer K v
  set π : v.adicCompletion K := algebraMap K (v.adicCompletion K) π₀ with hπdef
  have hπ : Valued.v π = WithZero.exp (-1 : ℤ) := by rw [hπdef, hval, hπ₀]
  have h2F : Valued.v (2 : v.adicCompletion K) = 1 := by
    rw [← map_ofNat (algebraMap K (v.adicCompletion K)) 2, hval, h2]
  have hεπ : Valued.v (ε * π) = WithZero.exp (-1 : ℤ) := by rw [map_mul, hεw, hπ, one_mul]
  
  have phiSign_pm : ∀ s₁ s₂ s₃ : v.adicCompletion K,
      phiSign (v.adicCompletion K) s₁ s₂ s₃ = 1 ∨ phiSign (v.adicCompletion K) s₁ s₂ s₃ = -1 := by
    intro s₁ s₂ s₃; unfold phiSign; split_ifs <;> simp
  have hilbSym_pm : ∀ a b : v.adicCompletion K,
      hilbSym (v.adicCompletion K) a b = 1 ∨ hilbSym (v.adicCompletion K) a b = -1 := by
    intro a b; unfold hilbSym; split_ifs <;> simp
  have hilbTerm_pm : ∀ s₁ s₂ s₃ : v.adicCompletion K,
      hilbTerm (v.adicCompletion K) s₁ s₂ s₃ = 1 ∨ hilbTerm (v.adicCompletion K) s₁ s₂ s₃ = -1 := by
    intro s₁ s₂ s₃; unfold hilbTerm; split_ifs
    · exact Or.inl rfl
    · exact hilbSym_pm _ _
  have prod_pm : ∀ s₁ s₂ s₃ : v.adicCompletion K,
      phiSign (v.adicCompletion K) s₁ s₂ s₃ * hilbTerm (v.adicCompletion K) s₁ s₂ s₃ = 1 ∨
      phiSign (v.adicCompletion K) s₁ s₂ s₃ * hilbTerm (v.adicCompletion K) s₁ s₂ s₃ = -1 := by
    intro s₁ s₂ s₃
    rcases phiSign_pm s₁ s₂ s₃ with h | h <;> rcases hilbTerm_pm s₁ s₂ s₃ with h' | h' <;>
      rw [h, h'] <;> decide
  have finish : ∀ (x : ℤˣ) (P : Prop) [Decidable P], (x = 1 ∨ x = -1) → (x = -1 ↔ P) →
      x = if P then -1 else 1 := by
    intro x P _ hx hP
    split_ifs with h
    · exact hP.mpr h
    · rcases hx with hx | hx
      · exact hx
      · exact absurd (hP.mp hx) h
  
  have dswap : ∀ (s₁ a b u : v.adicCompletion K),
      IsDescentClass s₁ a b 1 u → IsDescentClass s₁ b a 1 u := by
    rintro s₁ a b u ⟨z₀, z₁, z₂, z₃, hnz, e1, e2⟩
    refine ⟨z₀, z₁, z₃, z₂, ?_, ?_, ?_⟩
    · tauto
    · linear_combination e2
    · linear_combination e1
  have symm : ∀ s₁ s₂ s₃ : v.adicCompletion K,
      phiSign (v.adicCompletion K) s₁ s₃ s₂ * hilbTerm (v.adicCompletion K) s₁ s₃ s₂ =
        phiSign (v.adicCompletion K) s₁ s₂ s₃ * hilbTerm (v.adicCompletion K) s₁ s₂ s₃ := by
    intro s₁ s₂ s₃
    have himg : phiImg (v.adicCompletion K) s₁ s₃ s₂ = phiImg (v.adicCompletion K) s₁ s₂ s₃ := by
      ext c
      simp only [phiImg, Set.mem_setOf_eq]
      exact ⟨fun ⟨u, hu, hd⟩ => ⟨u, hu, dswap _ _ _ _ hd⟩,
        fun ⟨u, hu, hd⟩ => ⟨u, hu, dswap _ _ _ _ hd⟩⟩
    have hph : phiSign (v.adicCompletion K) s₁ s₃ s₂ = phiSign (v.adicCompletion K) s₁ s₂ s₃ := by
      unfold phiSign; rw [himg]
    have hht : hilbTerm (v.adicCompletion K) s₁ s₃ s₂ = hilbTerm (v.adicCompletion K) s₁ s₂ s₃ := by
      unfold hilbTerm
      rw [show 2 * s₁ - s₃ - s₂ = 2 * s₁ - s₂ - s₃ by ring,
        show (s₁ - s₃) * (s₁ - s₂) = (s₁ - s₂) * (s₁ - s₃) by ring]
    rw [hph, hht]
  
  have caseA : ∀ s₁ s₂ s₃ : v.adicCompletion K, s₁ ≠ s₂ → Valued.v (s₁ - s₂) < 1 →
      Valued.v (s₁ - s₃) = 1 →
      (phiSign (v.adicCompletion K) s₁ s₂ s₃ * hilbTerm (v.adicCompletion K) s₁ s₂ s₃ = -1 ↔
        IsSquare (s₁ - s₃)) := by
    intro s₁ s₂ s₃ hne hlt hβ1
    have hα0 : Valued.v (s₁ - s₂) ≠ 0 := by
      rw [ne_eq, Valuation.zero_iff]; exact sub_ne_zero.mpr hne
    obtain ⟨n, hαn⟩ : ∃ n : ℤ, Valued.v (s₁ - s₂) = WithZero.exp (-n) :=
      ⟨-WithZero.log (Valued.v (s₁ - s₂)), by rw [neg_neg, WithZero.exp_log hα0]⟩
    have hnpos : 0 < n := by
      have h' : WithZero.exp (-n) < WithZero.exp (0 : ℤ) := by
        rw [← hαn, WithZero.exp_zero]; exact hlt
      rw [WithZero.exp_lt_exp] at h'
      omega
    obtain ⟨hDε, hDu⟩ := descentClass_odd_caseA Valued.v hsq ε hεw hεns hεd hres π hπ
      s₁ s₂ s₃ n hnpos hαn hβ1
    have hσ := phiSign_eq_of_descentClasses Valued.v π hπ ε hεw hεns hεd s₁ s₂ s₃
    have hDπ := hDu π hπ
    have hDεπ := hDu (ε * π) hεπ
    have hσ' : phiSign (v.adicCompletion K) s₁ s₂ s₃ = -1 ↔
        ¬ (Even n ∧ ¬ IsSquare (s₁ - s₃)) := by
      rw [hσ, ← hDε]; simp [hDπ, hDεπ]
    have ha_eq : 2 * s₁ - s₂ - s₃ = (s₁ - s₂) + (s₁ - s₃) := by ring
    have ha1 : Valued.v (2 * s₁ - s₂ - s₃) = 1 := by
      rw [ha_eq, Valuation.map_add_eq_of_lt_right _ (by rw [hβ1]; exact hlt), hβ1]
    have ha0 : 2 * s₁ - s₂ - s₃ ≠ 0 := by
      intro h; rw [h, map_zero] at ha1; exact zero_ne_one ha1
    have hb : Valued.v (-((s₁ - s₂) * (s₁ - s₃))) = WithZero.exp (-n) := by
      rw [Valuation.map_neg, map_mul, hαn, hβ1, mul_one]
    have hh : hilbTerm (v.adicCompletion K) s₁ s₂ s₃ =
        hilbSym (v.adicCompletion K) (2 * s₁ - s₂ - s₃) (-((s₁ - s₂) * (s₁ - s₃))) := by
      unfold hilbTerm; rw [if_neg ha0]
    have hS := hilbSym_odd_unit_formula Valued.v hsq ε hεw hεns hεd hres π hπ _ _ n ha1 hb
    have hsqa : IsSquare (2 * s₁ - s₂ - s₃) ↔ IsSquare (s₁ - s₃) := by
      have hβ0 : s₁ - s₃ ≠ 0 := by
        intro h; rw [h, map_zero] at hβ1; exact zero_ne_one hβ1
      obtain ⟨r, hr⟩ := hsq (1 + (s₁ - s₂) / (s₁ - s₃)) (by
        rw [add_sub_cancel_left, map_div₀, hβ1, div_one]; exact hlt)
      have hfac : 2 * s₁ - s₂ - s₃ = (s₁ - s₃) * (r * r) := by
        rw [← hr, ha_eq]; field_simp; ring
      have hr0 : r ≠ 0 := by
        rintro rfl; apply ha0; rw [hfac]; ring
      constructor
      · rintro ⟨p, hp⟩
        refine ⟨p / r, ?_⟩
        rw [hfac] at hp
        field_simp
        linear_combination hp
      · rintro ⟨q, hq⟩
        exact ⟨q * r, by rw [hfac, hq]; ring⟩
    have hS' : hilbSym (v.adicCompletion K) (2 * s₁ - s₂ - s₃) (-((s₁ - s₂) * (s₁ - s₃))) = 1 ↔
        (Even n ∨ IsSquare (s₁ - s₃)) := by rw [hS, hsqa]
    have hσv : phiSign (v.adicCompletion K) s₁ s₂ s₃ =
        if (Even n ∧ ¬ IsSquare (s₁ - s₃)) then 1 else -1 := by
      split_ifs with hc
      · rcases phiSign_pm s₁ s₂ s₃ with h | h
        · exact h
        · exact absurd hc (hσ'.mp h)
      · exact hσ'.mpr hc
    have hhv : hilbSym (v.adicCompletion K) (2 * s₁ - s₂ - s₃) (-((s₁ - s₂) * (s₁ - s₃))) =
        if (Even n ∨ IsSquare (s₁ - s₃)) then 1 else -1 := by
      split_ifs with hc
      · exact hS'.mpr hc
      · rcases hilbSym_pm (2 * s₁ - s₂ - s₃) (-((s₁ - s₂) * (s₁ - s₃))) with h | h
        · exact absurd (hS'.mp h) hc
        · exact h
    rw [hh, hσv, hhv]
    by_cases E : Even n <;> by_cases Q : IsSquare (s₁ - s₃) <;>
      simp only [E, Q, not_true_eq_false, not_false_eq_true, and_true, and_false, true_and,
        false_and, or_true, true_or, or_false, false_or, ↓reduceIte, iff_true, iff_false] <;>
      decide
  
  have caseC : ∀ s₁ s₂ s₃ : v.adicCompletion K, Valued.v (s₁ - s₂) = 1 →
      Valued.v (s₁ - s₃) = 1 → Valued.v (s₂ - s₃) < 1 →
      (phiSign (v.adicCompletion K) s₁ s₂ s₃ * hilbTerm (v.adicCompletion K) s₁ s₂ s₃ = -1 ↔
        IsSquare (-(s₁ - s₂))) := by
    intro s₁ s₂ s₃ hα1 hβ1 hγ1
    obtain ⟨hDε, hDu⟩ := descentClass_odd_caseC Valued.v h2F hsq ε hεw hεns hεd hres
      s₁ s₂ s₃ hα1 hβ1 hγ1
    have hσ := phiSign_eq_of_descentClasses Valued.v π hπ ε hεw hεns hεd s₁ s₂ s₃
    rw [hDu π hπ, hDu (ε * π) hεπ] at hσ
    have hσ' : phiSign (v.adicCompletion K) s₁ s₂ s₃ = -1 ↔ IsSquare (-(s₁ - s₂)) := by
      rw [hσ]; simp [hDε]
    have ha_eq : 2 * s₁ - s₂ - s₃ = 2 * (s₁ - s₂) + (s₂ - s₃) := by ring
    have h2α : Valued.v (2 * (s₁ - s₂)) = 1 := by rw [map_mul, h2F, hα1, one_mul]
    have ha1 : Valued.v (2 * s₁ - s₂ - s₃) = 1 := by
      rw [ha_eq, Valuation.map_add_eq_of_lt_left _ (by rw [h2α]; exact hγ1), h2α]
    have ha0 : 2 * s₁ - s₂ - s₃ ≠ 0 := by
      intro h; rw [h, map_zero] at ha1; exact zero_ne_one ha1
    have hb : Valued.v (-((s₁ - s₂) * (s₁ - s₃))) = WithZero.exp (-(0 : ℤ)) := by
      rw [Valuation.map_neg, map_mul, hα1, hβ1, mul_one, neg_zero, WithZero.exp_zero]
    have hS := hilbSym_odd_unit_formula Valued.v hsq ε hεw hεns hεd hres π hπ _ _ 0 ha1 hb
    have hh : hilbTerm (v.adicCompletion K) s₁ s₂ s₃ = 1 := by
      unfold hilbTerm; rw [if_neg ha0]; exact hS.mpr (Or.inl ⟨0, rfl⟩)
    rw [hh, mul_one]; exact hσ'
  
  have hinj := (algebraMap K (v.adicCompletion K)).injective
  have e12 : Valued.v (algebraMap K (v.adicCompletion K) e₁ - algebraMap K (v.adicCompletion K) e₂) =
      IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) := by rw [← map_sub, hval]
  have e13 : Valued.v (algebraMap K (v.adicCompletion K) e₁ - algebraMap K (v.adicCompletion K) e₃) =
      IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) := by rw [← map_sub, hval]
  have e23 : Valued.v (algebraMap K (v.adicCompletion K) e₂ - algebraMap K (v.adicCompletion K) e₃) =
      IsDedekindDomain.HeightOneSpectrum.valuation K v (e₂ - e₃) := by rw [← map_sub, hval]
  by_cases hA : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) < 1
  · have hB1 : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) = 1 :=
      le_antisymm hβ (not_lt.mp fun h => hnot ⟨hA, h⟩)
    have key := caseA (algebraMap K (v.adicCompletion K) e₁) (algebraMap K (v.adicCompletion K) e₂)
      (algebraMap K (v.adicCompletion K) e₃) (fun h => h₁₂ (hinj h)) (by rw [e12]; exact hA)
      (by rw [e13]; exact hB1)
    unfold multSplitSign
    rw [if_pos hA, map_sub]
    exact finish _ _ (prod_pm _ _ _) key
  · have hA1 : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) = 1 :=
      le_antisymm hα (not_lt.mp hA)
    by_cases hB : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) < 1
    · have key := caseA (algebraMap K (v.adicCompletion K) e₁)
        (algebraMap K (v.adicCompletion K) e₃) (algebraMap K (v.adicCompletion K) e₂)
        (fun h => h₁₃ (hinj h)) (by rw [e13]; exact hB) (by rw [e12]; exact hA1)
      rw [← symm]
      unfold multSplitSign
      rw [if_neg hA, if_pos hB, map_sub]
      exact finish _ _ (prod_pm _ _ _) key
    · have hB1 : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) = 1 :=
        le_antisymm hβ (not_lt.mp hB)
      have hC : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₂ - e₃) < 1 :=
        lt_of_le_of_ne hγ (fun h => hbad ⟨hA1, hB1, h⟩)
      have key := caseC (algebraMap K (v.adicCompletion K) e₁)
        (algebraMap K (v.adicCompletion K) e₂) (algebraMap K (v.adicCompletion K) e₃)
        (by rw [e12]; exact hA1) (by rw [e13]; exact hB1) (by rw [e23]; exact hC)
      unfold multSplitSign
      rw [if_neg hA, if_neg hB, map_neg, map_sub]
      exact finish _ _ (prod_pm _ _ _) key

theorem exists_integral_primitive_element_sep {K : Type u} [Field K] [NumberField K] :
    ∃ (α : K) (f : Polynomial ℤ), IntermediateField.adjoin ℚ {α} = ⊤ ∧ f.Monic ∧
      Polynomial.aeval α f = 0 ∧ Polynomial.aeval α (Polynomial.derivative f) ≠ 0 :=
by
  obtain ⟨α₀, h₀⟩ := Field.exists_primitive_element ℚ K
  have halg : IsAlgebraic ℤ α₀ :=
    (IsFractionRing.isAlgebraic_iff ℤ ℚ K).mpr
      (Algebra.IsIntegral.isIntegral (R := ℚ) α₀).isAlgebraic
  obtain ⟨y, hy, hint⟩ := halg.exists_integral_multiple
  set α : K := y • α₀ with hα
  have hyK : (y : K) ≠ 0 := Int.cast_ne_zero.mpr hy
  have hadj : IntermediateField.adjoin ℚ {α} = ⊤ := by
    refine le_antisymm le_top ?_
    rw [← h₀, IntermediateField.adjoin_simple_le_iff]
    have hmem : ((y : ℚ)⁻¹) • α ∈ IntermediateField.adjoin ℚ {α} :=
      IntermediateField.smul_mem _ (IntermediateField.mem_adjoin_simple_self ℚ α)
    have he : ((y : ℚ)⁻¹) • α = α₀ := by
      rw [hα, Algebra.smul_def, zsmul_eq_mul, map_inv₀, map_intCast, ← mul_assoc,
        inv_mul_cancel₀ hyK, one_mul]
    rwa [he] at hmem
  have hG : minpoly ℚ α = (minpoly ℤ α).map (algebraMap ℤ ℚ) :=
    minpoly.isIntegrallyClosed_eq_field_fractions' ℚ hint
  have hαℚ : IsIntegral ℚ α := Algebra.IsIntegral.isIntegral α
  have hsep : (minpoly ℚ α).Separable := (minpoly.irreducible hαℚ).separable
  have hne := hsep.aeval_derivative_ne_zero (minpoly.aeval ℚ α)
  rw [hG, Polynomial.derivative_map, Polynomial.aeval_map_algebraMap] at hne
  exact ⟨α, minpoly ℤ α, hadj, minpoly.monic hint, minpoly.aeval ℤ α, hne⟩

theorem adicCompletion_int_valuation_facts {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    (∀ m : ℤ, Valued.v ((m : v.adicCompletion K)) ≤ 1) ∧
    (∃ N : ℕ, 0 < N ∧ Valued.v ((N : v.adicCompletion K)) < 1) ∧
    (∀ w B : WithZero (Multiplicative ℤ), w < 1 → ∃ k : ℕ, w ^ k * B ≤ 1) :=
by
  refine ⟨?_, ?_, ?_⟩
  · intro m
    exact (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers _ K v).mp
      (intCast_mem _ m)
  · refine ⟨Ideal.absNorm v.asIdeal, ?_, ?_⟩
    · apply Nat.pos_of_ne_zero
      intro h
      exact v.ne_bot (Ideal.absNorm_eq_zero_iff.mp h)
    · have hmem := Ideal.absNorm_mem v.asIdeal
      have hlt :=
        (IsDedekindDomain.HeightOneSpectrum.valuation_lt_one_iff_mem (K := K) v _).mpr hmem
      replace hlt : IsDedekindDomain.HeightOneSpectrum.valuation K v
          ((Ideal.absNorm v.asIdeal : ℕ) : K) < 1 := by
        exact_mod_cast hlt
      have e : ((Ideal.absNorm v.asIdeal : ℕ) : v.adicCompletion K) =
          algebraMap K (v.adicCompletion K) ((Ideal.absNorm v.asIdeal : ℕ) : K) :=
        (map_natCast (algebraMap K (v.adicCompletion K)) _).symm
      rw [e]
      have e2 := IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v
        ((Ideal.absNorm v.asIdeal : ℕ) : K)
      exact (e2.trans_lt hlt)
  · intro w B hw
    by_cases hw0 : w = 0
    · exact ⟨1, by rw [hw0, pow_one, zero_mul]; exact zero_le'⟩
    by_cases hB0 : B = 0
    · exact ⟨0, by rw [hB0, mul_zero]; exact zero_le'⟩
    obtain ⟨a, rfl⟩ : ∃ a, WithZero.exp a = w := ⟨_, WithZero.exp_log hw0⟩
    obtain ⟨b, rfl⟩ : ∃ b, WithZero.exp b = B := ⟨_, WithZero.exp_log hB0⟩
    have ha : a < 0 := by
      rw [← WithZero.exp_zero, WithZero.exp_lt_exp] at hw
      exact hw
    refine ⟨b.toNat, ?_⟩
    rw [← WithZero.exp_nsmul, ← WithZero.exp_add, ← WithZero.exp_zero, WithZero.exp_le_exp,
      nsmul_eq_mul]
    have h1 := Int.self_le_toNat b
    have h2 := mul_nonpos_of_nonneg_of_nonpos (Int.natCast_nonneg b.toNat)
      (show a + 1 ≤ 0 by omega)
    nlinarith

theorem adicCompletion_poly_estimates {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    (∀ (P : Polynomial (v.adicCompletion K)) (γ : WithZero (Multiplicative ℤ))
        (x : v.adicCompletion K), (∀ i, Valued.v (P.coeff i) < γ) → Valued.v x ≤ 1 →
        Valued.v (P.eval x) < γ ∧ Valued.v (P.derivative.eval x) < γ) ∧
    (∀ (P : Polynomial (v.adicCompletion K)) (x : v.adicCompletion K),
        (∀ i, Valued.v (P.coeff i) ≤ 1) → Valued.v x ≤ 1 → Valued.v (P.eval x) ≤ 1) ∧
    (∀ (P : Polynomial (v.adicCompletion K)) (x y : v.adicCompletion K),
        (∀ i, Valued.v (P.coeff i) ≤ 1) → Valued.v x ≤ 1 → Valued.v y ≤ 1 →
        Valued.v (P.eval x - P.eval y) ≤ Valued.v (x - y) ∧
        Valued.v (P.derivative.eval x - P.derivative.eval y) ≤ Valued.v (x - y)) ∧
    (∀ (P : Polynomial (v.adicCompletion K)) (x : v.adicCompletion K), P.Monic →
        (∀ i, Valued.v (P.coeff i) ≤ 1) → P.eval x = 0 → Valued.v x ≤ 1) :=
by
  have gen : ∀ (w : Valuation (v.adicCompletion K) (WithZero (Multiplicative ℤ))),
      (∀ (P : Polynomial (v.adicCompletion K)) (γ : WithZero (Multiplicative ℤ))
          (x : v.adicCompletion K), (∀ i, w (P.coeff i) < γ) → w x ≤ 1 →
          w (P.eval x) < γ ∧ w (P.derivative.eval x) < γ) ∧
      (∀ (P : Polynomial (v.adicCompletion K)) (x : v.adicCompletion K),
          (∀ i, w (P.coeff i) ≤ 1) → w x ≤ 1 → w (P.eval x) ≤ 1) ∧
      (∀ (P : Polynomial (v.adicCompletion K)) (x y : v.adicCompletion K),
          (∀ i, w (P.coeff i) ≤ 1) → w x ≤ 1 → w y ≤ 1 →
          w (P.eval x - P.eval y) ≤ w (x - y) ∧
          w (P.derivative.eval x - P.derivative.eval y) ≤ w (x - y)) ∧
      (∀ (P : Polynomial (v.adicCompletion K)) (x : v.adicCompletion K), P.Monic →
          (∀ i, w (P.coeff i) ≤ 1) → P.eval x = 0 → w x ≤ 1) := by
    intro w
    have hnat : ∀ n : ℕ, w (n : v.adicCompletion K) ≤ 1 := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [Nat.cast_succ]
        exact le_trans (w.map_add _ _) (max_le ih (le_of_eq w.map_one))
    have hder : ∀ (P : Polynomial (v.adicCompletion K)) (i : ℕ),
        w ((Polynomial.derivative P).coeff i) ≤ w (P.coeff (i + 1)) := by
      intro P i
      rw [Polynomial.coeff_derivative, w.map_mul]
      apply mul_le_of_le_one_right'
      have h := hnat (i + 1)
      rw [Nat.cast_succ] at h
      exact h
    have hterm : ∀ (c x : v.adicCompletion K), w x ≤ 1 → ∀ i : ℕ, w (c * x ^ i) ≤ w c := by
      intro c x hx i
      rw [w.map_mul, w.map_pow]
      exact mul_le_of_le_one_right' (pow_le_one₀ zero_le' hx)
    have hle : ∀ (P : Polynomial (v.adicCompletion K)) (γ : WithZero (Multiplicative ℤ))
        (x : v.adicCompletion K), w x ≤ 1 → (∀ i, w (P.coeff i) ≤ γ) → w (P.eval x) ≤ γ := by
      intro P γ x hx hc
      rw [Polynomial.eval_eq_sum_range]
      exact w.map_sum_le (fun i _ => (hterm _ _ hx i).trans (hc i))
    have hlt : ∀ (P : Polynomial (v.adicCompletion K)) (γ : WithZero (Multiplicative ℤ))
        (x : v.adicCompletion K), w x ≤ 1 → (∀ i, w (P.coeff i) < γ) → w (P.eval x) < γ := by
      intro P γ x hx hc
      have hγ : γ ≠ 0 := ne_of_gt (lt_of_le_of_lt zero_le' (hc 0))
      rw [Polynomial.eval_eq_sum_range]
      exact w.map_sum_lt hγ (fun i _ => lt_of_le_of_lt (hterm _ _ hx i) (hc i))
    have hlip : ∀ (P : Polynomial (v.adicCompletion K)) (x y : v.adicCompletion K),
        (∀ i, w (P.coeff i) ≤ 1) → w x ≤ 1 → w y ≤ 1 →
        w (P.eval x - P.eval y) ≤ w (x - y) := by
      intro P x y hc hx hy
      rw [Polynomial.eval_eq_sum_range, Polynomial.eval_eq_sum_range, ← Finset.sum_sub_distrib]
      apply w.map_sum_le
      intro i _
      rw [← mul_sub, ← geom_sum₂_mul, w.map_mul, w.map_mul]
      have hS : w (∑ j ∈ Finset.range i, x ^ j * y ^ (i - 1 - j)) ≤ 1 := by
        apply w.map_sum_le
        intro j _
        rw [w.map_mul, w.map_pow, w.map_pow]
        exact mul_le_one' (pow_le_one₀ zero_le' hx) (pow_le_one₀ zero_le' hy)
      calc w (P.coeff i) * (w (∑ j ∈ Finset.range i, x ^ j * y ^ (i - 1 - j)) * w (x - y))
          ≤ 1 * (1 * w (x - y)) := mul_le_mul' (hc i) (mul_le_mul_right' hS _)
        _ = w (x - y) := by rw [one_mul, one_mul]
    have hmon : ∀ (P : Polynomial (v.adicCompletion K)) (x : v.adicCompletion K), P.Monic →
        (∀ i, w (P.coeff i) ≤ 1) → P.eval x = 0 → w x ≤ 1 := by
      intro P x hm hc h0
      by_contra hgt
      push_neg at hgt
      rw [Polynomial.eval_eq_sum_range, Finset.sum_range_succ, hm.coeff_natDegree, one_mul] at h0
      have hS : (∑ i ∈ Finset.range P.natDegree, P.coeff i * x ^ i) = -(x ^ P.natDegree) :=
        eq_neg_of_add_eq_zero_left h0
      have hx0 : w x ≠ 0 := ne_of_gt (lt_trans zero_lt_one hgt)
      have hlt' : w (∑ i ∈ Finset.range P.natDegree, P.coeff i * x ^ i) <
          w x ^ P.natDegree := by
        apply w.map_sum_lt (pow_ne_zero _ hx0)
        intro i hi
        rw [Finset.mem_range] at hi
        rw [w.map_mul, w.map_pow]
        calc w (P.coeff i) * w x ^ i ≤ w x ^ i := mul_le_of_le_one_left' (hc i)
          _ < w x ^ P.natDegree := pow_lt_pow_right₀ hgt hi
      rw [hS, w.map_neg, w.map_pow] at hlt'
      exact lt_irrefl _ hlt'
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro P γ x hc hx
      exact ⟨hlt P γ x hx hc,
        hlt _ γ x hx (fun i => lt_of_le_of_lt (hder P i) (hc (i + 1)))⟩
    · intro P x hc hx
      exact hle P 1 x hx hc
    · intro P x y hc hx hy
      exact ⟨hlip P x y hc hx hy,
        hlip _ x y (fun i => (hder P i).trans (hc (i + 1))) hx hy⟩
    · intro P x hm hc h0
      exact hmon P x hm hc h0
  exact gen Valued.v

theorem exists_closureRat_minpoly {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (a : v.adicCompletion K) (f : Polynomial ℤ) (hf : f.Monic) (hfa : Polynomial.aeval a f = 0) :
    ∃ H : Polynomial (v.adicCompletion K), H.Monic ∧ 1 ≤ H.natDegree ∧ H.eval a = 0 ∧
      H.derivative.eval a ≠ 0 ∧
      (∀ i, H.coeff i ∈ closure (Set.range (algebraMap ℚ (v.adicCompletion K)))) ∧
      (FiniteDimensional (algebraMap ℚ (v.adicCompletion K)).fieldRange.topologicalClosure
          (v.adicCompletion K) →
        H.natDegree ≤ Module.finrank
          (algebraMap ℚ (v.adicCompletion K)).fieldRange.topologicalClosure (v.adicCompletion K)) :=
by
  set E : Subfield (v.adicCompletion K) :=
    (algebraMap ℚ (v.adicCompletion K)).fieldRange.topologicalClosure with hE
  haveI hcE : CharZero E := by
    haveI hcF : CharZero (v.adicCompletion K) :=
      charZero_of_injective_algebraMap (algebraMap ℚ (v.adicCompletion K)).injective
    exact SubsemiringClass.instCharZero E
  have hint : IsIntegral E a := by
    refine ⟨f.map (algebraMap ℤ E), hf.map _, ?_⟩
    rw [← Polynomial.aeval_def, Polynomial.aeval_map_algebraMap]
    exact hfa
  have hsep : (minpoly E a).Separable := Irreducible.separable (minpoly.irreducible hint)
  refine ⟨(minpoly E a).map (algebraMap E (v.adicCompletion K)), (minpoly.monic hint).map _,
    ?_, ?_, ?_, ?_, ?_⟩
  · rw [Polynomial.natDegree_map]
    exact minpoly.natDegree_pos hint
  · rw [Polynomial.eval_map_algebraMap]
    exact minpoly.aeval E a
  · rw [Polynomial.derivative_map, Polynomial.eval_map_algebraMap]
    exact hsep.aeval_derivative_ne_zero (minpoly.aeval E a)
  · intro i
    rw [Polynomial.coeff_map]
    have hmem : ((minpoly E a).coeff i : v.adicCompletion K) ∈ (E : Set (v.adicCompletion K)) :=
      ((minpoly E a).coeff i).2
    have hset : (E : Set (v.adicCompletion K)) =
        closure (Set.range (algebraMap ℚ (v.adicCompletion K))) := by
      rw [← RingHom.coe_fieldRange]
      rfl
    rw [hset] at hmem
    exact hmem
  · intro hfd
    rw [Polynomial.natDegree_map]
    exact minpoly.natDegree_le a

theorem exists_rat_approx_closure_and_real {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (c : v.adicCompletion K)
    (hc : c ∈ closure (Set.range (algebraMap ℚ (v.adicCompletion K))))
    (t : ℝ) (γ : WithZero (Multiplicative ℤ)) (hγ : γ ≠ 0) (δ : ℝ) (hδ : 0 < δ) :
    ∃ r : ℚ, Valued.v (algebraMap ℚ (v.adicCompletion K) r - c) < γ ∧ |(r : ℝ) - t| < δ :=
by
  classical
  
  obtain ⟨q₀, hq₀⟩ : ∃ q₀ : ℚ, Valued.v (algebraMap ℚ (v.adicCompletion K) q₀ - c) < γ := by
    have hU : {y : v.adicCompletion K | Valued.v (y - c) < γ} ∈ nhds c := by
      rw [Valued.mem_nhds]
      exact ⟨Units.mk0 γ hγ, fun y hy => by simpa using hy⟩
    obtain ⟨y, hyU, q, rfl⟩ := mem_closure_iff_nhds.mp hc _ hU
    exact ⟨q, hyU⟩
  
  have hint : ∀ m : ℤ, Valued.v ((m : v.adicCompletion K)) ≤ 1 := fun m =>
    (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mp (intCast_mem _ m)
  
  obtain ⟨N, hNdef⟩ : ∃ N : ℕ, N = Ideal.absNorm v.asIdeal := ⟨_, rfl⟩
  have hNpos : 0 < N := by
    rw [Nat.pos_iff_ne_zero, hNdef, Ne, Ideal.absNorm_eq_zero_iff]
    exact v.ne_bot
  have hNlt : Valued.v ((N : v.adicCompletion K)) < 1 := by
    have hmem : ((N : NumberField.RingOfIntegers K)) ∈ v.asIdeal := by
      rw [hNdef]; exact Ideal.absNorm_mem _
    have h1 := (IsDedekindDomain.HeightOneSpectrum.valuation_lt_one_iff_mem (K := K) v _).mpr hmem
    have h1' : IsDedekindDomain.HeightOneSpectrum.valuation K v (N : K) < 1 := by
      simpa using h1
    have e2 : (((N : K)) : v.adicCompletion K) = (N : v.adicCompletion K) :=
      map_natCast (UniformSpace.Completion.coeRingHom) N
    rw [← e2, IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation']
    exact h1'
  
  have hγpos : 0 < γ := zero_lt_iff.mpr hγ
  obtain ⟨e, he⟩ : ∃ e : ℕ, Valued.v ((N : v.adicCompletion K)) ^ e < γ := by
    by_cases hw0 : Valued.v ((N : v.adicCompletion K)) = 0
    · exact ⟨1, by rw [hw0, pow_one]; exact hγpos⟩
    · have hα : (Valued.v ((N : v.adicCompletion K))).log < 0 := by
        have := (WithZero.log_lt_log hw0 one_ne_zero).mpr hNlt
        simpa using this
      obtain ⟨n, hn⟩ : ∃ n : ℕ, n = γ.log.natAbs + 1 := ⟨_, rfl⟩
      have hb : -(n : ℤ) < γ.log := by omega
      refine ⟨n, ?_⟩
      rw [← WithZero.exp_log hw0, ← WithZero.exp_log hγ, ← WithZero.exp_nsmul,
        WithZero.exp_lt_exp, nsmul_eq_mul]
      have hα1 : (Valued.v ((N : v.adicCompletion K))).log ≤ -1 := by omega
      have hx0 : (0 : ℤ) ≤ (n : ℤ) := by omega
      have := mul_le_mul_of_nonneg_left hα1 hx0
      linarith
  
  have hsmall : ∀ (a : ℤ) (M : ℕ), Valued.v (algebraMap ℚ (v.adicCompletion K)
      ((N : ℚ) ^ e * ((a : ℚ) / ((N : ℚ) * (M : ℚ) + 1)))) < γ := by
    intro a M
    have hM : Valued.v ((M : v.adicCompletion K)) ≤ 1 := by
      have := hint (M : ℤ); simpa using this
    have hNM : Valued.v ((N : v.adicCompletion K) * (M : v.adicCompletion K)) < 1 := by
      rw [Valuation.map_mul]
      calc Valued.v ((N : v.adicCompletion K)) * Valued.v ((M : v.adicCompletion K))
          ≤ Valued.v ((N : v.adicCompletion K)) * 1 := mul_le_mul_left' hM _
        _ = Valued.v ((N : v.adicCompletion K)) := mul_one _
        _ < 1 := hNlt
    have hden : Valued.v ((N : v.adicCompletion K) * (M : v.adicCompletion K) + 1) = 1 := by
      rw [add_comm]; exact Valuation.map_one_add_of_lt _ hNM
    have hι : algebraMap ℚ (v.adicCompletion K) ((N : ℚ) ^ e * ((a : ℚ) / ((N : ℚ) * (M : ℚ) + 1)))
        = (N : v.adicCompletion K) ^ e *
          ((a : v.adicCompletion K) / ((N : v.adicCompletion K) * (M : v.adicCompletion K) + 1)) := by
      simp only [map_mul, map_pow, map_div₀, map_add, map_one, map_natCast, map_intCast]
    rw [hι, Valuation.map_mul, Valuation.map_pow, Valuation.map_div, hden, div_one]
    calc Valued.v ((N : v.adicCompletion K)) ^ e * Valued.v ((a : v.adicCompletion K))
        ≤ Valued.v ((N : v.adicCompletion K)) ^ e * 1 := mul_le_mul_left' (hint a) _
      _ = Valued.v ((N : v.adicCompletion K)) ^ e := mul_one _
      _ < γ := he
  
  have hNR : (1 : ℝ) ≤ N := by exact_mod_cast hNpos
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = (N : ℝ) ^ e := ⟨_, rfl⟩
  have hApos : 0 < A := by rw [hA]; exact pow_pos (by linarith) e
  obtain ⟨M, hM⟩ := exists_nat_gt (A / δ)
  obtain ⟨m, hm⟩ : ∃ m : ℝ, m = (N : ℝ) * (M : ℝ) + 1 := ⟨_, rfl⟩
  have hM0 : (0 : ℝ) ≤ M := Nat.cast_nonneg M
  have hmM : (M : ℝ) < m := by rw [hm]; nlinarith
  have hmpos : 0 < m := by linarith
  obtain ⟨x, hx⟩ : ∃ x : ℝ, x = ((t - q₀) * m) / A := ⟨_, rfl⟩
  obtain ⟨a, ha⟩ : ∃ a : ℤ, a = ⌊x⌋ := ⟨_, rfl⟩
  have ha1 : (a : ℝ) ≤ x := by rw [ha]; exact Int.floor_le x
  have ha2 : x < a + 1 := by rw [ha]; exact Int.lt_floor_add_one x
  obtain ⟨u, hu⟩ : ∃ u : ℝ, u = A / m := ⟨_, rfl⟩
  have hupos : 0 < u := by rw [hu]; exact div_pos hApos hmpos
  have hux : u * x = t - q₀ := by
    rw [hu, hx]; field_simp
  have hua : A * ((a : ℝ) / m) = u * a := by rw [hu]; ring
  have hudelta : u < δ := by
    rw [hu, div_lt_iff₀ hmpos]
    have h1 : A < M * δ := (div_lt_iff₀ hδ).mp hM
    nlinarith
  have hr1 : u * (x - a) < u := by nlinarith
  have hr2 : 0 ≤ u * (x - a) := mul_nonneg hupos.le (by linarith)
  
  refine ⟨q₀ + (N : ℚ) ^ e * ((a : ℚ) / ((N : ℚ) * (M : ℚ) + 1)), ?_, ?_⟩
  · rw [map_add, add_sub_right_comm]
    exact Valuation.map_add_lt _ hq₀ (hsmall a M)
  · have hcast : ((q₀ + (N : ℚ) ^ e * ((a : ℚ) / ((N : ℚ) * (M : ℚ) + 1)) : ℚ) : ℝ) =
        (q₀ : ℝ) + A * ((a : ℝ) / m) := by
      rw [hA, hm]; push_cast; ring
    rw [hcast, hua, abs_lt]
    constructor <;> nlinarith

theorem card_roots_eq_of_coeff_close (n : ℕ) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ g : Polynomial ℝ, g.Monic → g.natDegree = n →
      (∀ i < n, |g.coeff i - (∏ j ∈ Finset.range n,
          (Polynomial.X - Polynomial.C ((j : ℝ) + 1))).coeff i| < δ) →
      g.roots.card = n :=
by
  classical
  set T : Polynomial ℝ := ∏ j ∈ Finset.range n,
    (Polynomial.X - Polynomial.C ((j : ℝ) + 1)) with hT
  have hTeval : ∀ t : ℝ, T.eval t = ∏ j ∈ Finset.range n, (t - ((j : ℝ) + 1)) := by
    intro t
    rw [hT, Polynomial.eval_prod]
    simp [Polynomial.eval_sub, Polynomial.eval_X]
  
  have s1 : ∀ k : ℕ, (1/2 : ℝ) ^ n ≤ |T.eval ((k : ℝ) + 1/2)| := by
    intro k
    rw [hTeval, Finset.abs_prod]
    calc (1/2 : ℝ) ^ n = ∏ j ∈ Finset.range n, (1/2 : ℝ) := by
          rw [Finset.prod_const, Finset.card_range]
      _ ≤ ∏ j ∈ Finset.range n, |(k : ℝ) + 1/2 - ((j : ℝ) + 1)| := by
          apply Finset.prod_le_prod
          · intro j _; norm_num
          · intro j _
            rcases lt_or_ge j k with h | h
            · have : (j : ℝ) + 1 ≤ k := by exact_mod_cast h
              rw [le_abs]; left; linarith
            · have : (k : ℝ) ≤ j := by exact_mod_cast h
              rw [le_abs]; right; linarith
  
  have s2 : ∀ k : ℕ, k < n → T.eval ((k : ℝ) + 1/2) * T.eval ((k : ℝ) + 3/2) < 0 := by
    intro k hk
    rw [hTeval, hTeval, ← Finset.prod_mul_distrib,
      ← Finset.mul_prod_erase _ _ (Finset.mem_range.mpr hk)]
    apply mul_neg_of_neg_of_pos
    · have e : ((k : ℝ) + 1/2 - ((k : ℝ) + 1)) * ((k : ℝ) + 3/2 - ((k : ℝ) + 1)) = -1/4 := by
        ring
      rw [e]; norm_num
    · apply Finset.prod_pos
      intro j hj
      rw [Finset.mem_erase] at hj
      rcases lt_or_gt_of_ne hj.1 with h | h
      · have : (j : ℝ) + 1 ≤ k := by exact_mod_cast h
        apply mul_pos <;> linarith
      · have : (k : ℝ) + 1 ≤ j := by exact_mod_cast h
        apply mul_pos_of_neg_of_neg <;> linarith
  
  have s3 : ∀ (h : Polynomial ℝ) (ε t : ℝ), h.natDegree ≤ n → (∀ i, |h.coeff i| ≤ ε) →
      0 ≤ t → t ≤ (n : ℝ) + 1 → |h.eval t| ≤ ((n : ℝ) + 1) ^ (n + 1) * ε := by
    intro h ε t hdeg hc ht0 ht1
    have hε : 0 ≤ ε := le_trans (abs_nonneg _) (hc 0)
    have hn1 : (1 : ℝ) ≤ (n : ℝ) + 1 := by linarith [(Nat.cast_nonneg n : (0 : ℝ) ≤ n)]
    rw [Polynomial.eval_eq_sum_range' (Nat.lt_succ_of_le hdeg)]
    calc |∑ i ∈ Finset.range (n + 1), h.coeff i * t ^ i|
        ≤ ∑ i ∈ Finset.range (n + 1), |h.coeff i * t ^ i| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i ∈ Finset.range (n + 1), ε * ((n : ℝ) + 1) ^ n := by
          apply Finset.sum_le_sum
          intro i hi
          rw [Finset.mem_range] at hi
          rw [abs_mul, abs_of_nonneg (pow_nonneg ht0 i)]
          have h1 : t ^ i ≤ ((n : ℝ) + 1) ^ i := pow_le_pow_left₀ ht0 ht1 i
          have h2 : ((n : ℝ) + 1) ^ i ≤ ((n : ℝ) + 1) ^ n := pow_le_pow_right₀ hn1 (by omega)
          exact mul_le_mul (hc i) (h1.trans h2) (pow_nonneg ht0 i) hε
      _ = ((n : ℝ) + 1) ^ (n + 1) * ε := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul, pow_succ]; push_cast; ring
  
  have s4 : ∀ g : Polynomial ℝ, g ≠ 0 → g.natDegree = n →
      (∀ k : ℕ, k < n → g.eval ((k : ℝ) + 1/2) * g.eval ((k : ℝ) + 3/2) < 0) →
      g.roots.card = n := by
    intro g hg hdeg hsign
    have hex : ∀ k : ℕ, ∃ x : ℝ, k < n →
        ((k : ℝ) + 1/2 < x ∧ x < (k : ℝ) + 3/2 ∧ g.eval x = 0) := by
      intro k
      by_cases hk : k < n
      · have hs := hsign k hk
        have hab : (k : ℝ) + 1/2 ≤ (k : ℝ) + 3/2 := by linarith
        have hcont : ContinuousOn (fun x => g.eval x)
            (Set.Icc ((k : ℝ) + 1/2) ((k : ℝ) + 3/2)) :=
          g.continuous.continuousOn
        have hne : g.eval ((k : ℝ) + 1/2) ≠ 0 := by
          intro h0; rw [h0, zero_mul] at hs; exact lt_irrefl _ hs
        rcases lt_or_gt_of_ne hne with ha | ha
        · have hb : 0 < g.eval ((k : ℝ) + 3/2) := by
            by_contra hb; push_neg at hb
            have := mul_nonneg_of_nonpos_of_nonpos ha.le hb
            linarith
          obtain ⟨x, hx, hx0⟩ := intermediate_value_Ioo hab hcont ⟨ha, hb⟩
          exact ⟨x, fun _ => ⟨hx.1, hx.2, hx0⟩⟩
        · have hb : g.eval ((k : ℝ) + 3/2) < 0 := by
            by_contra hb; push_neg at hb
            have := mul_nonneg ha.le hb
            linarith
          obtain ⟨x, hx, hx0⟩ := intermediate_value_Ioo' hab hcont ⟨hb, ha⟩
          exact ⟨x, fun _ => ⟨hx.1, hx.2, hx0⟩⟩
      · exact ⟨0, fun h => absurd h hk⟩
    choose ρ hρ using hex
    have hinj : Set.InjOn ρ ↑(Finset.range n) := by
      intro k hk l hl hkl
      simp only [Finset.coe_range, Set.mem_Iio] at hk hl
      obtain ⟨hk1, hk2, -⟩ := hρ k hk
      obtain ⟨hl1, hl2, -⟩ := hρ l hl
      by_contra hne
      rcases lt_or_gt_of_ne hne with h | h
      · have : (k : ℝ) + 1 ≤ l := by exact_mod_cast h
        linarith
      · have : (l : ℝ) + 1 ≤ k := by exact_mod_cast h
        linarith
    have hmaps : Set.MapsTo ρ ↑(Finset.range n) ↑(g.roots.toFinset) := by
      intro k hk
      rw [Finset.mem_coe, Finset.mem_range] at hk
      rw [Finset.mem_coe, Multiset.mem_toFinset, Polynomial.mem_roots hg, Polynomial.IsRoot.def]
      exact (hρ k hk).2.2
    have hle := Finset.card_le_card_of_injOn ρ hmaps hinj
    rw [Finset.card_range] at hle
    apply le_antisymm
    · rw [← hdeg]; exact Polynomial.card_roots' g
    · exact hle.trans (Multiset.toFinset_card_le _)
  
  have hTm : T.Monic :=
    Polynomial.monic_prod_of_monic _ _ (fun j _ => Polynomial.monic_X_sub_C _)
  have hTd : T.natDegree = n := by
    rw [hT, Polynomial.natDegree_prod_of_monic _ _ (fun j _ => Polynomial.monic_X_sub_C _),
      Finset.sum_congr rfl (fun (j : ℕ) _ => Polynomial.natDegree_X_sub_C ((j : ℝ) + 1))]
    simp
  have hCpos : (0 : ℝ) < ((n : ℝ) + 1) ^ (n + 1) := by positivity
  have hhalf : (0 : ℝ) < (1/2 : ℝ) ^ n := by positivity
  refine ⟨(1/2 : ℝ) ^ n / (2 * ((n : ℝ) + 1) ^ (n + 1)), by positivity, ?_⟩
  intro g hm hd hclose
  set δ : ℝ := (1/2 : ℝ) ^ n / (2 * ((n : ℝ) + 1) ^ (n + 1)) with hδ
  have hδpos : 0 < δ := by positivity
  have hCδ : ((n : ℝ) + 1) ^ (n + 1) * δ < (1/2 : ℝ) ^ n := by
    have e : ((n : ℝ) + 1) ^ (n + 1) * δ = (1/2 : ℝ) ^ n / 2 := by
      rw [hδ]; field_simp
    rw [e]; linarith
  set h : Polynomial ℝ := g - T with hh
  have hhdeg : h.natDegree ≤ n := by
    rw [hh]; refine (Polynomial.natDegree_sub_le _ _).trans ?_; rw [hd, hTd, max_self]
  have hhc : ∀ i, |h.coeff i| ≤ δ := by
    intro i
    rw [hh, Polynomial.coeff_sub]
    rcases lt_trichotomy i n with hi | hi | hi
    · exact (hclose i hi).le
    · have h1 : g.coeff i = 1 := by rw [hi, ← hd]; exact hm.coeff_natDegree
      have h2 : T.coeff i = 1 := by rw [hi, ← hTd]; exact hTm.coeff_natDegree
      rw [h1, h2, sub_self, abs_zero]; exact hδpos.le
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (p := g) (by omega),
        Polynomial.coeff_eq_zero_of_natDegree_lt (p := T) (by omega), sub_zero, abs_zero]
      exact hδpos.le
  have hK : ∀ t : ℝ, 0 ≤ t → t ≤ (n : ℝ) + 1 → (1/2 : ℝ) ^ n ≤ |T.eval t| →
      0 < g.eval t * T.eval t := by
    intro t ht0 ht1 hTt
    have hb := s3 h δ t hhdeg hhc ht0 ht1
    have hge : g.eval t = T.eval t + h.eval t := by rw [hh, Polynomial.eval_sub]; ring
    rw [hge]
    have h1 : |h.eval t| < |T.eval t| := by linarith
    have h2 : -(|h.eval t| * |T.eval t|) ≤ h.eval t * T.eval t := by
      rw [← abs_mul]; exact neg_abs_le _
    have h3 : T.eval t * T.eval t = |T.eval t| * |T.eval t| := by
      rw [← abs_mul, abs_mul_self]
    have h4 := mul_pos (sub_pos.mpr h1) (lt_of_lt_of_le hhalf hTt)
    nlinarith
  apply s4 g hm.ne_zero hd
  intro k hk
  have hk1 : (k : ℝ) + 1 ≤ n := by exact_mod_cast hk
  have hk0 : (0 : ℝ) ≤ k := Nat.cast_nonneg k
  have A := hK ((k : ℝ) + 1/2) (by linarith) (by linarith) (s1 k)
  have hs1' : (1/2 : ℝ) ^ n ≤ |T.eval ((k : ℝ) + 3/2)| := by
    have e : (k : ℝ) + 3/2 = ((k + 1 : ℕ) : ℝ) + 1/2 := by push_cast; ring
    rw [e]; exact s1 (k + 1)
  have B := hK ((k : ℝ) + 3/2) (by linarith) (by linarith) hs1'
  have c := s2 k hk
  by_contra hcon
  push_neg at hcon
  have hle : g.eval ((k : ℝ) + 1/2) * g.eval ((k : ℝ) + 3/2) *
      (T.eval ((k : ℝ) + 1/2) * T.eval ((k : ℝ) + 3/2)) ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos hcon c.le
  nlinarith [mul_pos A B]

theorem newton_root_adicCompletion {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (P : Polynomial (v.adicCompletion K)) (a : v.adicCompletion K)
    (hP : ∀ i, Valued.v (P.coeff i) ≤ 1) (ha : Valued.v a ≤ 1)
    (hlt : Valued.v (P.eval a) < Valued.v (P.derivative.eval a) ^ 2) :
    ∃ z : v.adicCompletion K, P.eval z = 0 ∧
      Valued.v (z - a) * Valued.v (P.derivative.eval a) ≤ Valued.v (P.eval a) ∧
      z ∈ closure ((Subfield.closure (insert a (Set.range P.coeff)) :
        Subfield (v.adicCompletion K)) : Set (v.adicCompletion K)) ∧
      ∀ z' : v.adicCompletion K, P.eval z' = 0 →
        Valued.v (z' - a) < Valued.v (P.derivative.eval a) → z' = z :=
by
  classical
  
  have powlt : ∀ T y : WithZero (Multiplicative ℤ), T < 1 → y ≠ 0 → ∃ k : ℕ, T ^ k < y := by
    intro T y hT hy
    obtain ⟨n, hn⟩ := exists_pow_lt₀ hT (Units.mk0 y hy)
    exact ⟨n, by simpa using hn⟩
  have powbd : ∀ T y R : WithZero (Multiplicative ℤ), T < 1 →
      (∀ k : ℕ, y ≤ max (T ^ k) R) → y ≤ R := by
    intro T y R hT h
    by_contra hc
    push_neg at hc
    have hy : y ≠ 0 := ne_of_gt (lt_of_le_of_lt zero_le' hc)
    obtain ⟨k, hk⟩ := powlt T y hT hy
    exact absurd (h k) (not_le.mpr (max_lt hk hc))
  have cancel : ∀ {A B C : WithZero (Multiplicative ℤ)}, C ≠ 0 → A * C ≤ B * C → A ≤ B := by
    intro A B C hC h
    have h' := mul_le_mul_right' h C⁻¹
    rwa [mul_inv_cancel_right₀ hC, mul_inv_cancel_right₀ hC] at h'
  have cancel_lt : ∀ {A B C : WithZero (Multiplicative ℤ)}, A * C < B * C → A < B := by
    intro A B C h
    by_contra hc
    push_neg at hc
    exact absurd h (not_lt.mpr (mul_le_mul_right' hc C))
  
  set R := (Valued.v : Valuation (v.adicCompletion K) (WithZero (Multiplicative ℤ))).integer
    with hR
  have memR : ∀ y : v.adicCompletion K, y ∈ R ↔ Valued.v y ≤ 1 := fun y =>
    Valuation.mem_integer_iff _ _
  have lift : ∀ W : Polynomial (v.adicCompletion K), (∀ i, Valued.v (W.coeff i) ≤ 1) →
      ∃ Q : Polynomial R, Q.map R.subtype = W := by
    intro W hW
    have hcoeffs : (↑W.coeffs : Set (v.adicCompletion K)) ⊆ R := by
      intro c hc
      rw [Finset.mem_coe, Polynomial.mem_coeffs_iff] at hc
      obtain ⟨n, -, rfl⟩ := hc
      exact (memR _).mpr (hW n)
    exact ⟨W.toSubring R hcoeffs, Polynomial.map_toSubring _ _ _⟩
  have hev : ∀ (W : Polynomial R) (y : v.adicCompletion K) (hy : y ∈ R),
      (W.map R.subtype).eval y = ((W.eval ⟨y, hy⟩ : R) : v.adicCompletion K) := by
    intro W y hy
    rw [Polynomial.eval_map]
    exact Polynomial.eval₂_at_apply R.subtype ⟨y, hy⟩
  obtain ⟨Q0, hQ0⟩ := lift P hP
  
  have hP' : ∀ i, Valued.v (P.derivative.coeff i) ≤ 1 := by
    intro i
    rw [← hQ0, Polynomial.derivative_map, Polynomial.coeff_map]
    exact (memR _).mp (Q0.derivative.coeff i).2
  
  have E_le : ∀ (W : Polynomial (v.adicCompletion K)) (x : v.adicCompletion K),
      (∀ i, Valued.v (W.coeff i) ≤ 1) → Valued.v x ≤ 1 → Valued.v (W.eval x) ≤ 1 := by
    intro W x hW hx
    obtain ⟨Q, rfl⟩ := lift W hW
    rw [hev Q x ((memR x).mpr hx)]
    exact (memR _).mp (Q.eval _).2
  have E_lip : ∀ (W : Polynomial (v.adicCompletion K)) (x y : v.adicCompletion K),
      (∀ i, Valued.v (W.coeff i) ≤ 1) → Valued.v x ≤ 1 → Valued.v y ≤ 1 →
      Valued.v (W.eval x - W.eval y) ≤ Valued.v (x - y) := by
    intro W x y hW hx hy
    obtain ⟨Q, rfl⟩ := lift W hW
    have hx' := (memR x).mpr hx
    have hy' := (memR y).mpr hy
    obtain ⟨c, hc⟩ := Polynomial.sub_dvd_eval_sub (⟨x, hx'⟩ : R) ⟨y, hy'⟩ Q
    rw [hev Q x hx', hev Q y hy']
    have hc' : ((Q.eval ⟨x, hx'⟩ : R) : v.adicCompletion K) - ((Q.eval ⟨y, hy'⟩ : R) :
        v.adicCompletion K) = (x - y) * (c : v.adicCompletion K) :=
      congrArg Subtype.val hc
    rw [hc', map_mul]
    exact mul_le_of_le_one_right' ((memR _).mp c.2)
  
  have taylor : ∀ x t : v.adicCompletion K, Valued.v x ≤ 1 → Valued.v t ≤ 1 →
      ∃ c : v.adicCompletion K, Valued.v c ≤ 1 ∧
        P.eval (x + t) = P.eval x + P.derivative.eval x * t + c * t ^ 2 := by
    intro x t hx ht
    have hx' := (memR x).mpr hx
    have ht' := (memR t).mpr ht
    have hxt : x + t ∈ R := add_mem hx' ht'
    obtain ⟨k, hk⟩ := Polynomial.binomExpansion Q0 (⟨x, hx'⟩ : R) (⟨t, ht'⟩ : R)
    refine ⟨(k : v.adicCompletion K), (memR _).mp k.2, ?_⟩
    rw [← hQ0, Polynomial.derivative_map, hev Q0 (x + t) hxt, hev Q0 x hx',
      hev Q0.derivative x hx']
    exact congrArg Subtype.val hk
  
  set D := Valued.v (P.derivative.eval a) with hD
  set e := Valued.v (P.eval a) with he
  have hD0 : D ≠ 0 := by
    intro h
    rw [h, zero_pow two_ne_zero] at hlt
    exact not_lt_zero' hlt
  have hD1 : D ≤ 1 := E_le _ a hP' ha
  have hD2 : D ^ 2 ≠ 0 := pow_ne_zero 2 hD0
  set T := e * (D ^ 2)⁻¹ with hT
  have hTD : T * D ^ 2 = e := by rw [hT, inv_mul_cancel_right₀ hD2]
  have hT1 : T < 1 := by
    apply cancel_lt (C := D ^ 2)
    rw [hTD, one_mul]
    exact hlt
  have hTle : T ≤ 1 := hT1.le
  have hTk : ∀ k : ℕ, T ^ k ≤ 1 := fun k => pow_le_one' hTle k
  have he1 : e ≤ 1 := hlt.le.trans (pow_le_one' hD1 2)
  
  set S := Subfield.closure (insert a (Set.range P.coeff)) with hS
  have haS : a ∈ S := Subfield.subset_closure (Set.mem_insert _ _)
  have hPS : ∀ i, P.coeff i ∈ S := fun i =>
    Subfield.subset_closure (Set.mem_insert_of_mem _ ⟨i, rfl⟩)
  have evalS : ∀ Q : Polynomial (v.adicCompletion K), (∀ i, Q.coeff i ∈ S) →
      ∀ x ∈ S, Q.eval x ∈ S := by
    intro Q hQ x hx
    rw [Polynomial.eval_eq_sum_range]
    exact sum_mem (fun i _ => mul_mem (hQ i) (pow_mem hx i))
  have hP'S : ∀ i, P.derivative.coeff i ∈ S := by
    intro i
    rw [Polynomial.coeff_derivative]
    exact mul_mem (hPS _) (add_mem (natCast_mem S i) (one_mem S))
  
  set N : v.adicCompletion K → v.adicCompletion K :=
    fun y => y - P.eval y / P.derivative.eval y with hN
  set aseq : ℕ → v.adicCompletion K := fun k => N^[k] a with haseq
  have haseq0 : aseq 0 = a := rfl
  have haseqs : ∀ k, aseq (k + 1) = N (aseq k) := fun k => Function.iterate_succ_apply' N k a
  
  have step : ∀ (k : ℕ) (x : v.adicCompletion K), Valued.v x ≤ 1 →
      Valued.v (P.derivative.eval x) = D → Valued.v (P.eval x) ≤ e * T ^ k →
      Valued.v (x - a) * D ≤ e → x ∈ S →
      Valued.v (N x) ≤ 1 ∧ Valued.v (P.derivative.eval (N x)) = D ∧
      Valued.v (P.eval (N x)) ≤ e * T ^ (k + 1) ∧ Valued.v (N x - a) * D ≤ e ∧ N x ∈ S ∧
      Valued.v (N x - x) ≤ T ^ k := by
    intro k x hx hDx hPx hxa hxS
    have hP'x0 : P.derivative.eval x ≠ 0 := by
      intro h; apply hD0; rw [← hDx, h, map_zero]
    set q := P.eval x / P.derivative.eval x with hq
    have hNx : N x = x - q := rfl
    have hqD : Valued.v q * D = Valued.v (P.eval x) := by
      rw [hq, Valuation.map_div, ← hDx]
      exact div_mul_cancel₀ _ (by rw [hDx]; exact hD0)
    have hePos : e * T ^ k ≤ e := mul_le_of_le_one_right' (hTk k)
    have hqltD : Valued.v q < D := by
      apply cancel_lt (C := D)
      rw [hqD]
      calc Valued.v (P.eval x) ≤ e := hPx.trans hePos
        _ < D ^ 2 := hlt
        _ = D * D := sq D
    have hq1 : Valued.v q ≤ 1 := hqltD.le.trans hD1
    have hNx1 : Valued.v (N x) ≤ 1 := by
      rw [hNx]; exact (Valuation.map_sub _ _ _).trans (max_le hx hq1)
    have hNxx : N x - x = -q := by rw [hNx]; ring
    obtain ⟨c, hc, hcx⟩ := taylor x (-q) hx (by rw [Valuation.map_neg]; exact hq1)
    have hPNx : P.eval (N x) = c * q ^ 2 := by
      have e1 : P.derivative.eval x * q = P.eval x := by rw [hq, mul_div_cancel₀ _ hP'x0]
      rw [hNx, sub_eq_add_neg, hcx]
      linear_combination -e1
    have hPNxv : Valued.v (P.eval (N x)) ≤ Valued.v q ^ 2 := by
      rw [hPNx, map_mul, map_pow]
      exact mul_le_of_le_one_left' hc
    have hq2 : Valued.v q ^ 2 ≤ e * T ^ (k + 1) := by
      have h1 : Valued.v q ^ 2 * D ^ 2 ≤ (e * T ^ k * T ^ (k + 1)) * D ^ 2 := by
        calc Valued.v q ^ 2 * D ^ 2 = (Valued.v q * D) ^ 2 := (mul_pow _ _ _).symm
          _ = Valued.v (P.eval x) ^ 2 := by rw [hqD]
          _ ≤ (e * T ^ k) ^ 2 := by rw [sq, sq]; exact mul_le_mul' hPx hPx
          _ = (e * T ^ k * T ^ (k + 1)) * D ^ 2 := by
            rw [← hTD, sq (T * D ^ 2 * T ^ k), pow_succ T k]; ac_rfl
      have h2 := cancel hD2 h1
      calc Valued.v q ^ 2 ≤ e * T ^ k * T ^ (k + 1) := h2
        _ = e * T ^ (k + 1) * T ^ k := mul_right_comm _ _ _
        _ ≤ e * T ^ (k + 1) := mul_le_of_le_one_right' (hTk k)
    have hP'Nx : Valued.v (P.derivative.eval (N x)) = D := by
      rw [← hDx]
      apply Valuation.map_eq_of_sub_lt
      rw [hDx]
      calc _ ≤ Valued.v (N x - x) := E_lip _ (N x) x hP' hNx1 hx
        _ = Valued.v q := by rw [hNxx, Valuation.map_neg]
        _ < D := hqltD
    have hNxa : Valued.v (N x - a) * D ≤ e := by
      have e2 : N x - a = -q + (x - a) := by rw [hNx]; ring
      rw [e2]
      have hm := Valuation.map_add Valued.v (-q) (x - a)
      rw [Valuation.map_neg] at hm
      rcases max_choice (Valued.v q) (Valued.v (x - a)) with h | h <;> rw [h] at hm
      · calc _ ≤ Valued.v q * D := mul_le_mul_right' hm D
          _ ≤ e := by rw [hqD]; exact hPx.trans hePos
      · exact (mul_le_mul_right' hm D).trans hxa
    have hNxS : N x ∈ S := by
      rw [hNx]
      exact sub_mem hxS (div_mem (evalS P hPS x hxS) (evalS _ hP'S x hxS))
    have hstep : Valued.v (N x - x) ≤ T ^ k := by
      rw [hNxx, Valuation.map_neg]
      have h1 : Valued.v q * D ≤ (T ^ (k + 1) * D) * D := by
        rw [hqD]
        calc Valued.v (P.eval x) ≤ e * T ^ k := hPx
          _ = T ^ (k + 1) * D * D := by rw [← hTD, pow_succ T k, sq D]; ac_rfl
      have h2 := cancel hD0 h1
      calc Valued.v q ≤ T ^ (k + 1) * D := h2
        _ ≤ T ^ (k + 1) := mul_le_of_le_one_right' hD1
        _ ≤ T ^ k := pow_le_pow_right_of_le_one' hTle (Nat.le_succ k)
    exact ⟨hNx1, hP'Nx, hPNxv.trans hq2, hNxa, hNxS, hstep⟩
  
  have inv : ∀ k : ℕ, Valued.v (aseq k) ≤ 1 ∧ Valued.v (P.derivative.eval (aseq k)) = D ∧
      Valued.v (P.eval (aseq k)) ≤ e * T ^ k ∧ Valued.v (aseq k - a) * D ≤ e ∧ aseq k ∈ S := by
    intro k
    induction k with
    | zero =>
      rw [haseq0]
      refine ⟨ha, rfl, le_of_eq (by rw [pow_zero, mul_one]), ?_, haS⟩
      rw [sub_self, map_zero, zero_mul]
      exact zero_le'
    | succ k ih =>
      obtain ⟨h1, h2, h3, h4, h5⟩ := ih
      obtain ⟨g1, g2, g3, g4, g5, -⟩ := step k (aseq k) h1 h2 h3 h4 h5
      rw [haseqs]
      exact ⟨g1, g2, g3, g4, g5⟩
  have hstepb : ∀ k, Valued.v (aseq (k + 1) - aseq k) ≤ T ^ k := by
    intro k
    obtain ⟨h1, h2, h3, h4, h5⟩ := inv k
    rw [haseqs]
    exact (step k (aseq k) h1 h2 h3 h4 h5).2.2.2.2.2
  have tele : ∀ k m, Valued.v (aseq (k + m) - aseq k) ≤ T ^ k := by
    intro k m
    induction m with
    | zero => rw [add_zero, sub_self, map_zero]; exact zero_le'
    | succ m ih =>
      have e3 : aseq (k + (m + 1)) - aseq k =
          (aseq (k + m + 1) - aseq (k + m)) + (aseq (k + m) - aseq k) := by
        rw [← add_assoc]; ring
      rw [e3]
      exact (Valuation.map_add _ _ _).trans (max_le ((hstepb (k + m)).trans
        (pow_le_pow_right_of_le_one' hTle (Nat.le_add_right k m))) ih)
  have tele' : ∀ k m, k ≤ m → Valued.v (aseq m - aseq k) ≤ T ^ k := by
    intro k m hkm
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hkm
    exact tele k j
  
  have hcs : CauchySeq aseq := by
    rw [(Valued.hasBasis_uniformity (v.adicCompletion K)
      (WithZero (Multiplicative ℤ))).cauchySeq_iff]
    intro γ _
    obtain ⟨N0, hN0⟩ := powlt T (γ : WithZero (Multiplicative ℤ)) hT1 γ.ne_zero
    refine ⟨N0, fun m hm n hn => ?_⟩
    show Valued.v (aseq n - aseq m) < γ
    have e4 : aseq n - aseq m = (aseq n - aseq N0) - (aseq m - aseq N0) := by ring
    rw [e4]
    exact lt_of_le_of_lt (Valuation.map_sub _ _ _)
      (max_lt ((tele' _ _ hn).trans_lt hN0) ((tele' _ _ hm).trans_lt hN0))
  obtain ⟨z, hz⟩ := cauchySeq_tendsto_of_complete hcs
  have hzk : ∀ k, Valued.v (z - aseq k) ≤ T ^ k := by
    intro k
    have hC : IsClosed ((fun y => y - aseq k) ⁻¹'
        {y : v.adicCompletion K | Valued.v y ≤ T ^ k}) :=
      (Valued.isClosed_closedBall (v.adicCompletion K) (T ^ k)).preimage (continuous_sub_right _)
    have hmem := hC.mem_of_tendsto hz
      (Filter.eventually_atTop.mpr ⟨k, fun m hm => tele' k m hm⟩)
    exact hmem
  
  have hz1 : Valued.v z ≤ 1 := by
    have e6 : z = (z - aseq 0) + a := by rw [haseq0]; ring
    rw [e6]
    exact (Valuation.map_add _ _ _).trans (max_le ((hzk 0).trans (hTk 0)) ha)
  have hPz : P.eval z = 0 := by
    have hb : ∀ k, Valued.v (P.eval z) ≤ max (T ^ k) 0 := by
      intro k
      obtain ⟨h1, -, h3, -, -⟩ := inv k
      rw [max_eq_left zero_le']
      have e7 : P.eval z = (P.eval z - P.eval (aseq k)) + P.eval (aseq k) := by ring
      rw [e7]
      exact (Valuation.map_add _ _ _).trans (max_le
        ((E_lip P z (aseq k) hP hz1 h1).trans (hzk k))
        (h3.trans (mul_le_of_le_one_left' he1)))
    have h0 := powbd T _ 0 hT1 hb
    exact (Valuation.zero_iff _).mp (le_antisymm h0 zero_le')
  have hbd : Valued.v (z - a) * D ≤ e := by
    apply powbd T _ e hT1
    intro k
    obtain ⟨-, -, -, h4, -⟩ := inv k
    have e8 : z - a = (z - aseq k) + (aseq k - a) := by ring
    rw [e8]
    have hm := Valuation.map_add Valued.v (z - aseq k) (aseq k - a)
    rcases max_choice (Valued.v (z - aseq k)) (Valued.v (aseq k - a)) with h | h <;>
      rw [h] at hm
    · exact le_max_of_le_left ((mul_le_mul_right' hm D).trans
        ((mul_le_of_le_one_right' hD1).trans (hzk k)))
    · exact le_max_of_le_right ((mul_le_mul_right' hm D).trans h4)
  have hcl : z ∈ closure (S : Set (v.adicCompletion K)) :=
    mem_closure_of_tendsto hz (Filter.Eventually.of_forall fun k => (inv k).2.2.2.2)
  have hza : Valued.v (z - a) < D := by
    apply cancel_lt (C := D)
    calc Valued.v (z - a) * D ≤ e := hbd
      _ < D ^ 2 := hlt
      _ = D * D := sq D
  have hP'z : Valued.v (P.derivative.eval z) = D := by
    rw [hD]
    apply Valuation.map_eq_of_sub_lt
    exact lt_of_le_of_lt (E_lip _ z a hP' hz1 ha) hza
  refine ⟨z, hPz, hbd, hcl, ?_⟩
  intro z' hz' hz'a
  have hs : Valued.v (z' - z) < D := by
    have e9 : z' - z = (z' - a) - (z - a) := by ring
    rw [e9]
    exact lt_of_le_of_lt (Valuation.map_sub _ _ _) (max_lt hz'a hza)
  have hs1 : Valued.v (z' - z) ≤ 1 := hs.le.trans hD1
  obtain ⟨c, hc, hcz⟩ := taylor z (z' - z) hz1 hs1
  rw [show z + (z' - z) = z' by ring] at hcz
  have hfac : (z' - z) * (P.derivative.eval z + c * (z' - z)) = 0 := by
    linear_combination -hcz + hz' - hPz
  have hne : P.derivative.eval z + c * (z' - z) ≠ 0 := by
    intro h0
    have hv : Valued.v (P.derivative.eval z + c * (z' - z)) =
        Valued.v (P.derivative.eval z) := by
      apply Valuation.map_eq_of_sub_lt
      rw [show P.derivative.eval z + c * (z' - z) - P.derivative.eval z = c * (z' - z) by ring,
        map_mul, hP'z]
      exact lt_of_le_of_lt (mul_le_of_le_one_left' hc) hs
    rw [h0, map_zero, hP'z] at hv
    exact hD0 hv.symm
  exact sub_eq_zero.mp ((mul_eq_zero.mp hfac).resolve_right hne)

theorem dense_adjoin_of_primitive_mem_closure {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (α : K) (hα : IntermediateField.adjoin ℚ {α} = ⊤) (β : v.adicCompletion K)
    (h : algebraMap K (v.adicCompletion K) α ∈
      closure ((IntermediateField.adjoin ℚ {β} : IntermediateField ℚ (v.adicCompletion K)) :
        Set (v.adicCompletion K))) :
    Dense ((IntermediateField.adjoin ℚ {β} : IntermediateField ℚ (v.adicCompletion K)) :
      Set (v.adicCompletion K)) :=
by
  let C : Subfield (v.adicCompletion K) :=
    (IntermediateField.adjoin ℚ {β} : IntermediateField ℚ (v.adicCompletion K)).toSubfield.topologicalClosure
  let C' : Subfield K := C.comap (algebraMap K (v.adicCompletion K))
  have hQ : ∀ q : ℚ, algebraMap ℚ K q ∈ C' := fun q => by
    rw [eq_ratCast]; exact SubfieldClass.ratCast_mem C' q
  let E : IntermediateField ℚ K := C'.toIntermediateField hQ
  have memE : ∀ x : K, x ∈ E ↔ algebraMap K (v.adicCompletion K) x ∈
      closure ((IntermediateField.adjoin ℚ {β} : IntermediateField ℚ (v.adicCompletion K)) :
        Set (v.adicCompletion K)) := fun x => Iff.rfl
  have hle : IntermediateField.adjoin ℚ {α} ≤ E :=
    IntermediateField.adjoin_simple_le_iff.mpr ((memE α).mpr h)
  rw [hα] at hle
  have hall : Set.range (algebraMap K (v.adicCompletion K)) ⊆
      closure ((IntermediateField.adjoin ℚ {β} : IntermediateField ℚ (v.adicCompletion K)) :
        Set (v.adicCompletion K)) := by
    rintro _ ⟨x, rfl⟩
    exact (memE x).mp (hle IntermediateField.mem_top)
  have hD : DenseRange (algebraMap K (v.adicCompletion K)) := by
    rw [DenseRange, IsDedekindDomain.HeightOneSpectrum.algebraMap_adicCompletion
      (NumberField.RingOfIntegers K) K (S := K) v]
    rw [Algebra.algebraMap_self, RingHom.coe_id, Function.comp_id]
    exact UniformSpace.Completion.denseRange_coe
      (α := WithVal (IsDedekindDomain.HeightOneSpectrum.valuation K v))
  exact (hD.mono hall).of_closure

theorem exists_dense_real_rooted_generator {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    ∃ (β : v.adicCompletion K) (G : Polynomial ℚ), G.Monic ∧ Polynomial.aeval β G = 0 ∧
      (G.map (algebraMap ℚ ℝ)).roots.card = G.natDegree ∧
      Dense ((IntermediateField.adjoin ℚ {β} : IntermediateField ℚ (v.adicCompletion K)) :
        Set (v.adicCompletion K)) ∧
      (FiniteDimensional (algebraMap ℚ (v.adicCompletion K)).fieldRange.topologicalClosure
          (v.adicCompletion K) →
        G.natDegree ≤ Module.finrank
          (algebraMap ℚ (v.adicCompletion K)).fieldRange.topologicalClosure (v.adicCompletion K)) :=
by
  classical
  obtain ⟨α, f, hα, hfm, hfα, hfα'⟩ := exists_integral_primitive_element_sep (K := K)
  obtain ⟨hint, ⟨N, hNpos, hN⟩, hpow⟩ := adicCompletion_int_valuation_facts v
  obtain ⟨E_lt, E_le, E_lip, E_monic⟩ := adicCompletion_poly_estimates v
  
  obtain ⟨a, ha_def⟩ : ∃ a : v.adicCompletion K, a = algebraMap K (v.adicCompletion K) α :=
    ⟨_, rfl⟩
  obtain ⟨P₂, hP₂⟩ : ∃ P₂ : Polynomial (v.adicCompletion K),
      P₂ = f.map (algebraMap ℤ (v.adicCompletion K)) := ⟨_, rfl⟩
  have hP₂eval : ∀ x, P₂.eval x = Polynomial.aeval x f := fun x => by
    rw [hP₂, Polynomial.eval_map_algebraMap]
  have hP₂d : Polynomial.derivative P₂ =
      (Polynomial.derivative f).map (algebraMap ℤ (v.adicCompletion K)) := by
    rw [hP₂, Polynomial.derivative_map]
  have hP₂deval : ∀ x, (Polynomial.derivative P₂).eval x =
      Polynomial.aeval x (Polynomial.derivative f) := fun x => by
    rw [hP₂d, Polynomial.eval_map_algebraMap]
  have hfa : Polynomial.aeval a f = 0 := by
    rw [ha_def, Polynomial.aeval_algebraMap_apply, hfα, map_zero]
  have hfa' : Polynomial.aeval a (Polynomial.derivative f) ≠ 0 := by
    rw [ha_def, Polynomial.aeval_algebraMap_apply]
    exact (map_ne_zero _).mpr hfα'
  have hP₂c : ∀ i, Valued.v (P₂.coeff i) ≤ 1 := fun i => by
    rw [hP₂, Polynomial.coeff_map, eq_intCast]; exact hint _
  have hP₂dc : ∀ i, Valued.v ((Polynomial.derivative P₂).coeff i) ≤ 1 := fun i => by
    rw [hP₂d, Polynomial.coeff_map, eq_intCast]; exact hint _
  have hP₂m : P₂.Monic := by rw [hP₂]; exact hfm.map _
  have hP₂a : P₂.eval a = 0 := by rw [hP₂eval]; exact hfa
  have ha1 : Valued.v a ≤ 1 := E_monic P₂ a hP₂m hP₂c hP₂a
  obtain ⟨δf, hδf⟩ : ∃ δf : WithZero (Multiplicative ℤ),
      δf = Valued.v ((Polynomial.derivative P₂).eval a) := ⟨_, rfl⟩
  have hδf0 : δf ≠ 0 := by
    rw [hδf, hP₂deval]; exact (Valuation.ne_zero_iff _).mpr hfa'
  have hδf1 : δf ≤ 1 := by rw [hδf]; exact E_le _ a hP₂dc ha1
  have hδf2 : δf ^ 2 ≤ δf := by
    rw [sq]; exact mul_le_of_le_one_left' hδf1
  have hδf21 : δf ^ 2 ≤ 1 := hδf2.trans hδf1
  
  obtain ⟨H, hHm, hHdeg, hHa, hH'a, hHc, hHfin⟩ := exists_closureRat_minpoly v a f hfm hfa
  obtain ⟨n, hn⟩ : ∃ n : ℕ, n = H.natDegree := ⟨_, rfl⟩
  obtain ⟨δh, hδh⟩ : ∃ δh : WithZero (Multiplicative ℤ),
      δh = Valued.v ((Polynomial.derivative H).eval a) := ⟨_, rfl⟩
  have hδh0 : δh ≠ 0 := by rw [hδh]; exact (Valuation.ne_zero_iff _).mpr hH'a
  have hHn : H.coeff n = 1 := by rw [hn]; exact hHm.coeff_natDegree
  obtain ⟨B, hB⟩ : ∃ B : WithZero (Multiplicative ℤ),
      B = max 1 ((Finset.range (n + 1)).sup fun i => Valued.v (H.coeff i)) := ⟨_, rfl⟩
  have hB1 : 1 ≤ B := by rw [hB]; exact le_max_left _ _
  have hHB : ∀ i, Valued.v (H.coeff i) ≤ B := by
    intro i
    by_cases hi : i ≤ n
    · rw [hB]
      exact le_trans (Finset.le_sup (f := fun i => Valued.v (H.coeff i))
        (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))) (le_max_right _ _)
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), map_zero]
      exact zero_le'
  obtain ⟨w, hw⟩ : ∃ w : WithZero (Multiplicative ℤ),
      w = Valued.v ((N : v.adicCompletion K)) := ⟨_, rfl⟩
  have hw1 : w < 1 := by rw [hw]; exact hN
  have hw0 : w ≠ 0 := by
    haveI : CharZero (v.adicCompletion K) :=
      charZero_of_injective_algebraMap (algebraMap ℚ (v.adicCompletion K)).injective
    rw [hw]; exact (Valuation.ne_zero_iff _).mpr (Nat.cast_ne_zero.mpr (by omega))
  obtain ⟨k, hk⟩ := hpow w B hw1
  obtain ⟨ϖ, hϖ⟩ : ∃ ϖ : v.adicCompletion K, ϖ = (N : v.adicCompletion K) ^ k := ⟨_, rfl⟩
  have hϖv : Valued.v ϖ = w ^ k := by rw [hϖ, map_pow, hw]
  have hwk0 : w ^ k ≠ 0 := pow_ne_zero _ hw0
  have hϖ0 : ϖ ≠ 0 := by
    intro h; apply hwk0; rw [← hϖv, h, map_zero]
  obtain ⟨γ, hγ⟩ : ∃ γ : WithZero (Multiplicative ℤ),
      γ = min 1 (min (w ^ k * δh ^ 2) (δf ^ 2 * δh)) := ⟨_, rfl⟩
  have hγ0 : γ ≠ 0 := by
    rw [hγ]
    rcases min_choice (1 : WithZero (Multiplicative ℤ)) (min (w ^ k * δh ^ 2) (δf ^ 2 * δh))
      with h | h <;> rw [h]
    · exact one_ne_zero
    · rcases min_choice (w ^ k * δh ^ 2) (δf ^ 2 * δh) with h' | h' <;> rw [h']
      · exact mul_ne_zero hwk0 (pow_ne_zero _ hδh0)
      · exact mul_ne_zero (pow_ne_zero _ hδf0) hδh0
  have hγpos : 0 < γ := zero_lt_iff.mpr hγ0
  have hγ1 : γ ≤ 1 := by rw [hγ]; exact min_le_left _ _
  have hγ2 : γ ≤ w ^ k * δh ^ 2 := by
    rw [hγ]; exact (min_le_right _ _).trans (min_le_left _ _)
  have hγ3 : γ ≤ δf ^ 2 * δh := by
    rw [hγ]; exact (min_le_right _ _).trans (min_le_right _ _)
  have hγ4 : γ ≤ δh := hγ3.trans (mul_le_of_le_one_left' hδf21)
  
  obtain ⟨δ, hδ, hreal⟩ := card_roots_eq_of_coeff_close n
  have hr : ∀ i : ℕ, ∃ r : ℚ,
      Valued.v (algebraMap ℚ (v.adicCompletion K) r - H.coeff i) < γ ∧
      |(r : ℝ) - (∏ j ∈ Finset.range n,
          (Polynomial.X - Polynomial.C ((j : ℝ) + 1))).coeff i| < δ := fun i =>
    exists_rat_approx_closure_and_real v (H.coeff i) (hHc i) _ γ hγ0 δ hδ
  choose r hrF hrR using hr
  obtain ⟨L, hL⟩ : ∃ L : Polynomial ℚ,
      L = ∑ j ∈ Finset.range n, Polynomial.C (r j) * Polynomial.X ^ j := ⟨_, rfl⟩
  have hLc : ∀ m, L.coeff m = if m < n then r m else 0 := by
    intro m
    rw [hL, Polynomial.finset_sum_coeff]
    simp only [Polynomial.coeff_C_mul_X_pow]
    rw [Finset.sum_ite_eq]
    simp only [Finset.mem_range]
  have hLdeg : L.degree < n := by
    rw [Polynomial.degree_lt_iff_coeff_zero]
    intro m hm
    rw [hLc, if_neg (by omega)]
  obtain ⟨G, hG⟩ : ∃ G : Polynomial ℚ, G = Polynomial.X ^ n + L := ⟨_, rfl⟩
  have hGm : G.Monic := by rw [hG]; exact Polynomial.monic_X_pow_add hLdeg
  have hGdeg : G.natDegree = n := by
    rw [hG, Polynomial.natDegree_add_eq_left_of_degree_lt, Polynomial.natDegree_X_pow]
    rw [Polynomial.degree_X_pow]; exact hLdeg
  have hGc : ∀ m, m < n → G.coeff m = r m := by
    intro m hm
    rw [hG, Polynomial.coeff_add, Polynomial.coeff_X_pow, if_neg (by omega), hLc, if_pos hm,
      zero_add]
  have hGn : G.coeff n = 1 := by
    have h := hGm.coeff_natDegree
    rwa [hGdeg] at h
  have hGgt : ∀ m, n < m → G.coeff m = 0 := fun m hm =>
    Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
  have hconj2 : (G.map (algebraMap ℚ ℝ)).roots.card = G.natDegree := by
    rw [hGdeg]
    refine hreal _ (hGm.map _) (by rw [Polynomial.natDegree_map, hGdeg]) ?_
    intro i hi
    rw [Polynomial.coeff_map, hGc i hi, eq_ratCast]
    exact hrR i
  
  obtain ⟨GF, hGF⟩ : ∃ GF : Polynomial (v.adicCompletion K),
      GF = G.map (algebraMap ℚ (v.adicCompletion K)) := ⟨_, rfl⟩
  obtain ⟨Dif, hDif⟩ : ∃ Dif : Polynomial (v.adicCompletion K), Dif = GF - H := ⟨_, rfl⟩
  have hDc : ∀ i, Valued.v (Dif.coeff i) < γ := by
    intro i
    rw [hDif, Polynomial.coeff_sub, hGF, Polynomial.coeff_map]
    rcases lt_trichotomy i n with hi | hi | hi
    · rw [hGc i hi]; exact hrF i
    · rw [hi, hGn, map_one, hHn, sub_self, map_zero]; exact hγpos
    · rw [hGgt i hi, map_zero, Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), sub_zero,
        map_zero]
      exact hγpos
  obtain ⟨hDa, hD'a⟩ := E_lt Dif γ a hDc ha1
  have hGFa_eq : GF.eval a = Dif.eval a := by
    rw [hDif, Polynomial.eval_sub, hHa, sub_zero]
  have hGFa : Valued.v (GF.eval a) < γ := by rw [hGFa_eq]; exact hDa
  have hGF'a : Valued.v ((Polynomial.derivative GF).eval a) = δh := by
    rw [hδh]
    apply Valuation.map_eq_of_sub_lt
    have e : (Polynomial.derivative GF).eval a - (Polynomial.derivative H).eval a =
        (Polynomial.derivative Dif).eval a := by
      rw [hDif, Polynomial.derivative_sub, Polynomial.eval_sub]
    rw [e, ← hδh]
    exact lt_of_lt_of_le hD'a hγ4
  have hGFc : ∀ i, Valued.v (GF.coeff i) ≤ B := by
    intro i
    have e : GF.coeff i = Dif.coeff i + H.coeff i := by
      rw [hDif, Polynomial.coeff_sub, sub_add_cancel]
    rw [e]
    exact le_trans (Valuation.map_add _ _ _)
      (max_le ((hDc i).le.trans (hγ1.trans hB1)) (hHB i))
  obtain ⟨P, hP⟩ : ∃ P : Polynomial (v.adicCompletion K), P = Polynomial.C ϖ * GF := ⟨_, rfl⟩
  have hPc : ∀ i, Valued.v (P.coeff i) ≤ 1 := by
    intro i
    rw [hP, Polynomial.coeff_C_mul, map_mul, hϖv]
    exact le_trans (mul_le_mul_left' (hGFc i) _) hk
  have hPev : ∀ x, P.eval x = ϖ * GF.eval x := fun x => by
    rw [hP, Polynomial.eval_mul, Polynomial.eval_C]
  have hP'a : (Polynomial.derivative P).eval a = ϖ * (Polynomial.derivative GF).eval a := by
    rw [hP, Polynomial.derivative_C_mul, Polynomial.eval_mul, Polynomial.eval_C]
  have hPav : Valued.v (P.eval a) = w ^ k * Valued.v (GF.eval a) := by
    rw [hPev, map_mul, hϖv]
  have hP'av : Valued.v ((Polynomial.derivative P).eval a) = w ^ k * δh := by
    rw [hP'a, map_mul, hϖv, hGF'a]
  have hstrict : w ^ k * Valued.v (GF.eval a) < w ^ k * γ := by
    by_contra hc
    push_neg at hc
    have h := mul_le_mul_left' hc (w ^ k)⁻¹
    rw [inv_mul_cancel_left₀ hwk0, inv_mul_cancel_left₀ hwk0] at h
    exact absurd hGFa (not_lt.mpr h)
  have hlt1 : Valued.v (P.eval a) < Valued.v ((Polynomial.derivative P).eval a) ^ 2 := by
    rw [hPav, hP'av]
    calc w ^ k * Valued.v (GF.eval a) < w ^ k * γ := hstrict
      _ ≤ w ^ k * (w ^ k * δh ^ 2) := mul_le_mul_left' hγ2 _
      _ = (w ^ k * δh) ^ 2 := by rw [mul_pow, ← mul_assoc, sq (w ^ k)]
  obtain ⟨β, hPβ, hβbd, -, -⟩ := newton_root_adicCompletion v P a hPc ha1 hlt1
  have hGFβ : GF.eval β = 0 := by
    rw [hPev] at hPβ
    exact (mul_eq_zero.mp hPβ).resolve_left hϖ0
  have hconj1 : Polynomial.aeval β G = 0 := by
    rw [← Polynomial.eval_map_algebraMap, ← hGF]; exact hGFβ
  have hβa : Valued.v (β - a) < δf ^ 2 := by
    by_contra hcon
    push_neg at hcon
    have h2 : δf ^ 2 * (w ^ k * δh) < δf ^ 2 * (w ^ k * δh) := by
      calc δf ^ 2 * (w ^ k * δh) ≤ Valued.v (β - a) * (w ^ k * δh) := mul_le_mul_right' hcon _
        _ = Valued.v (β - a) * Valued.v ((Polynomial.derivative P).eval a) := by rw [hP'av]
        _ ≤ Valued.v (P.eval a) := hβbd
        _ = w ^ k * Valued.v (GF.eval a) := hPav
        _ < w ^ k * γ := hstrict
        _ ≤ w ^ k * (δf ^ 2 * δh) := mul_le_mul_left' hγ3 _
        _ = δf ^ 2 * (w ^ k * δh) := mul_left_comm _ _ _
    exact lt_irrefl _ h2
  
  have hβ1 : Valued.v β ≤ 1 := by
    have e : β = a + (β - a) := by ring
    rw [e]
    exact le_trans (Valuation.map_add _ _ _) (max_le ha1 (hβa.le.trans hδf21))
  obtain ⟨hlip1, hlip2⟩ := E_lip P₂ β a hP₂c hβ1 ha1
  have hP₂β : Valued.v (P₂.eval β) < δf ^ 2 := by
    rw [hP₂a, sub_zero] at hlip1
    exact lt_of_le_of_lt hlip1 hβa
  have hP₂'β : Valued.v ((Polynomial.derivative P₂).eval β) = δf := by
    rw [hδf]
    apply Valuation.map_eq_of_sub_lt
    rw [← hδf]
    exact lt_of_le_of_lt hlip2 (lt_of_lt_of_le hβa hδf2)
  have hlt2 : Valued.v (P₂.eval β) < Valued.v ((Polynomial.derivative P₂).eval β) ^ 2 := by
    rw [hP₂'β]; exact hP₂β
  obtain ⟨z, -, -, hzcl, huniq⟩ := newton_root_adicCompletion v P₂ β hP₂c hβ1 hlt2
  have haz : a = z := by
    apply huniq a hP₂a
    rw [hP₂'β, Valuation.map_sub_swap]
    exact lt_of_lt_of_le hβa hδf2
  have hsub : Subfield.closure (insert β (Set.range P₂.coeff)) ≤
      (IntermediateField.adjoin ℚ {β}).toSubfield := by
    rw [Subfield.closure_le, Set.insert_subset_iff]
    refine ⟨IntermediateField.mem_adjoin_simple_self ℚ β, ?_⟩
    rintro _ ⟨i, rfl⟩
    rw [hP₂, Polynomial.coeff_map, eq_intCast]
    exact intCast_mem _ _
  have hacl : algebraMap K (v.adicCompletion K) α ∈
      closure ((IntermediateField.adjoin ℚ {β} : IntermediateField ℚ (v.adicCompletion K)) :
        Set (v.adicCompletion K)) := by
    rw [← ha_def, haz]
    exact closure_mono (fun x hx => hsub hx) hzcl
  have hconj3 := dense_adjoin_of_primitive_mem_closure v α hα β hacl
  
  refine ⟨β, G, hGm, hconj1, hconj2, hconj3, ?_⟩
  intro hfd
  rw [hGdeg, hn]
  exact hHfin hfd

theorem exists_place_of_dense_numberField_subfield {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (L : IntermediateField ℚ (v.adicCompletion K)) [NumberField L]
    (hL : Dense (L : Set (v.adicCompletion K))) :
    ∃ w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L),
      ∀ x : L, IsDedekindDomain.HeightOneSpectrum.valuation L w x =
        Valued.v (x : v.adicCompletion K) :=
by
  classical
  have hexp1 : WithZero.exp (-1 : ℤ) < 1 := by
    rw [← WithZero.exp_zero, WithZero.exp_lt_exp]; norm_num
  have hexp0 : (0 : WithZero (Multiplicative ℤ)) < WithZero.exp (-1 : ℤ) :=
    zero_lt_iff.mpr WithZero.exp_ne_zero
  have hinjR : Function.Injective (algebraMap (NumberField.RingOfIntegers L) L) :=
    IsFractionRing.injective _ _
  
  have loc : ∀ (w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L)) (x : L),
      IsDedekindDomain.HeightOneSpectrum.valuation L w x ≤ 1 →
      ∃ a s : NumberField.RingOfIntegers L, s ∉ w.asIdeal ∧
        x = algebraMap (NumberField.RingOfIntegers L) L a /
          algebraMap (NumberField.RingOfIntegers L) L s := by
    intro w x hx
    by_cases hx0 : x = 0
    · refine ⟨0, 1, ?_, by simp [hx0]⟩
      exact fun h => w.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    obtain ⟨b, c, hc, hbc⟩ :=
      IsFractionRing.div_surjective (A := NumberField.RingOfIntegers L) x
    have hc0 : c ≠ 0 := nonZeroDivisors.ne_zero hc
    have hιc : algebraMap (NumberField.RingOfIntegers L) L c ≠ 0 := by
      intro h; exact hc0 (hinjR (h.trans (map_zero _).symm))
    have hcv : w.intValuation c ≠ 0 := w.intValuation_ne_zero c hc0
    have hcm : w.intValuation c = WithZero.exp (WithZero.log (w.intValuation c)) :=
      (WithZero.exp_log hcv).symm
    have hm0 : WithZero.log (w.intValuation c) ≤ 0 := by
      have h1 := w.intValuation_le_one c
      rw [hcm, ← WithZero.exp_zero, WithZero.exp_le_exp] at h1
      exact h1
    obtain ⟨k, hk⟩ : ∃ k : ℕ, WithZero.log (w.intValuation c) = -(k : ℤ) :=
      ⟨(-WithZero.log (w.intValuation c)).toNat, by omega⟩
    have hck : w.intValuation c = WithZero.exp (-(k : ℤ)) := by rw [hcm, hk]
    have hdvd : w.asIdeal ^ k ∣ Ideal.span {c} := by
      rw [← IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_dvd, hck]
    have hndvd : ¬ w.asIdeal ^ (k + 1) ∣ Ideal.span {c} := by
      rw [← IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_dvd, hck,
        WithZero.exp_le_exp]
      push_cast; omega
    obtain ⟨J, hJ⟩ := hdvd
    have hJw : ¬ J ≤ w.asIdeal := by
      intro hle
      apply hndvd
      rw [hJ, pow_succ]
      exact mul_dvd_mul_left _ (Ideal.dvd_iff_le.mpr hle)
    obtain ⟨s, hsJ, hsw⟩ := SetLike.not_le_iff_exists.mp hJw
    have hb : b ∈ w.asIdeal ^ k := by
      have h1 : IsDedekindDomain.HeightOneSpectrum.valuation L w x =
          w.intValuation b / w.intValuation c := by
        rw [← hbc, map_div₀, IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap,
          IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap]
      rw [h1, div_le_one₀ (zero_lt_iff.mpr hcv), hck,
        IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_dvd,
        Ideal.dvd_span_singleton] at hx
      exact hx
    have hsb : s * b ∈ Ideal.span {c} := by
      rw [hJ, mul_comm]; exact Ideal.mul_mem_mul hsJ hb
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hsb
    have hs0 : s ≠ 0 := fun h => hsw (h ▸ w.asIdeal.zero_mem)
    have hιs : algebraMap (NumberField.RingOfIntegers L) L s ≠ 0 := by
      intro h; exact hs0 (hinjR (h.trans (map_zero _).symm))
    refine ⟨a, s, hsw, ?_⟩
    rw [← hbc, div_eq_div_iff hιc hιs, ← map_mul, ← map_mul, ha, mul_comm]
  
  let μ : Valuation L (WithZero (Multiplicative ℤ)) :=
    (Valued.v : Valuation (v.adicCompletion K) (WithZero (Multiplicative ℤ))).comap
      L.toSubfield.subtype
  have hμ : ∀ x : L, μ x = Valued.v (x : v.adicCompletion K) := fun x => rfl
  
  have intle : ∀ {E : Type u} [Field E] (ν : Valuation E (WithZero (Multiplicative ℤ))) (x : E),
      IsIntegral ℤ x → ν x ≤ 1 := by
    intro E _ ν x hx
    exact (Valuation.integer.integers ν).mem_of_integral (hx.tower_top (A := ν.integer))
  have hle : ∀ r : NumberField.RingOfIntegers L,
      μ (algebraMap (NumberField.RingOfIntegers L) L r) ≤ 1 := by
    intro r
    exact intle μ _ (NumberField.RingOfIntegers.isIntegral_coe r)
  
  obtain ⟨ϖ, hϖ⟩ := IsDedekindDomain.HeightOneSpectrum.valuation_exists_uniformizer K v
  have hy : Valued.v (ϖ : v.adicCompletion K) = WithZero.exp (-1 : ℤ) := by
    rw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation', hϖ]
  have hU : IsOpen ((fun z => z - (ϖ : v.adicCompletion K)) ⁻¹'
      {t : v.adicCompletion K | Valued.v t < WithZero.exp (-1 : ℤ)}) :=
    (Valued.isOpen_ball _ _).preimage (continuous_sub_right _)
  obtain ⟨x0, hx0U, hx0L⟩ := hL.inter_open_nonempty _ hU
    ⟨(ϖ : v.adicCompletion K), by
      show Valued.v ((ϖ : v.adicCompletion K) - (ϖ : v.adicCompletion K)) < _
      rw [sub_self, map_zero]; exact hexp0⟩
  have hx0 : Valued.v x0 = WithZero.exp (-1 : ℤ) := by
    have h1 : Valued.v (x0 - (ϖ : v.adicCompletion K)) < Valued.v (ϖ : v.adicCompletion K) := by
      rw [hy]; exact hx0U
    rw [Valuation.map_eq_of_sub_lt _ h1, hy]
  set ℓ : L := ⟨x0, hx0L⟩ with hℓdef
  have hμℓ : μ ℓ = WithZero.exp (-1 : ℤ) := hx0
  have hℓ0 : ℓ ≠ 0 := by
    intro h; rw [h, map_zero] at hμℓ; exact WithZero.exp_ne_zero hμℓ.symm
  
  let P : Ideal (NumberField.RingOfIntegers L) :=
    { carrier := {r | μ (algebraMap (NumberField.RingOfIntegers L) L r) < 1}
      add_mem' := by
        intro a b ha hb
        simp only [Set.mem_setOf_eq, map_add] at *
        exact lt_of_le_of_lt (μ.map_add _ _) (max_lt ha hb)
      zero_mem' := by
        simp only [Set.mem_setOf_eq, map_zero]; exact zero_lt_one
      smul_mem' := by
        intro c a ha
        simp only [Set.mem_setOf_eq, smul_eq_mul, map_mul] at *
        exact lt_of_le_of_lt (mul_le_of_le_one_left' (hle c)) ha }
  have hPmem : ∀ r, r ∈ P ↔ μ (algebraMap (NumberField.RingOfIntegers L) L r) < 1 :=
    fun r => Iff.rfl
  have hPprime : P.IsPrime := by
    refine Ideal.isPrime_iff.mpr ⟨?_, ?_⟩
    · intro h
      have h1 : (1 : NumberField.RingOfIntegers L) ∈ P := h ▸ Submodule.mem_top
      rw [hPmem, map_one, map_one] at h1
      exact lt_irrefl _ h1
    · intro a b hab
      by_contra hcon
      push_neg at hcon
      obtain ⟨ha, hb⟩ := hcon
      have ha1 : μ (algebraMap (NumberField.RingOfIntegers L) L a) = 1 :=
        le_antisymm (hle a) (not_lt.mp ((hPmem a).not.mp ha))
      have hb1 : μ (algebraMap (NumberField.RingOfIntegers L) L b) = 1 :=
        le_antisymm (hle b) (not_lt.mp ((hPmem b).not.mp hb))
      rw [hPmem, map_mul, map_mul, ha1, hb1, one_mul] at hab
      exact lt_irrefl _ hab
  have hPne : P ≠ ⊥ := by
    obtain ⟨a, b, hb, hab⟩ :=
      IsFractionRing.div_surjective (A := NumberField.RingOfIntegers L) ℓ
    have hb0 : algebraMap (NumberField.RingOfIntegers L) L b ≠ 0 := by
      intro h; exact nonZeroDivisors.ne_zero hb (hinjR (h.trans (map_zero _).symm))
    have ha : algebraMap (NumberField.RingOfIntegers L) L a =
        ℓ * algebraMap (NumberField.RingOfIntegers L) L b := by
      rw [← hab, div_mul_cancel₀ _ hb0]
    have ha0 : a ≠ 0 := by
      intro h; rw [h, map_zero] at ha; exact mul_ne_zero hℓ0 hb0 ha.symm
    intro hbot
    have haP : a ∈ P := by
      rw [hPmem, ha, map_mul, hμℓ]
      calc WithZero.exp (-1 : ℤ) * μ (algebraMap (NumberField.RingOfIntegers L) L b)
          ≤ WithZero.exp (-1 : ℤ) * 1 := mul_le_mul_left' (hle b) _
        _ < 1 := by rw [mul_one]; exact hexp1
    rw [hbot, Ideal.mem_bot] at haP
    exact ha0 haP
  let w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L) :=
    ⟨P, hPprime, hPne⟩
  have hw : ∀ r, r ∈ w.asIdeal ↔ μ (algebraMap (NumberField.RingOfIntegers L) L r) < 1 :=
    fun r => Iff.rfl
  refine ⟨w, ?_⟩
  set ψ := IsDedekindDomain.HeightOneSpectrum.valuation L w with hψdef
  
  obtain ⟨π₀, hπ₀⟩ := w.intValuation_exists_uniformizer
  set π : L := algebraMap (NumberField.RingOfIntegers L) L π₀ with hπdef
  have hψπ : ψ π = WithZero.exp (-1 : ℤ) := by
    rw [hπdef, hψdef, IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap, hπ₀]
  have hπμ : μ π < 1 := by
    rw [hπdef, ← hw]
    rw [← IsDedekindDomain.HeightOneSpectrum.intValuation_lt_one_iff_mem, hπ₀]
    exact hexp1
  
  have hunit : ∀ x : L, ψ x = 1 → μ x = 1 := by
    intro x hx
    obtain ⟨a, s, hsw, rfl⟩ := loc w x hx.le
    have hψs : ψ (algebraMap (NumberField.RingOfIntegers L) L s) = 1 := by
      rw [hψdef, IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap]
      exact IsDedekindDomain.HeightOneSpectrum.intValuation_eq_one_iff.mpr hsw
    have hψa : ψ (algebraMap (NumberField.RingOfIntegers L) L a) = 1 := by
      rw [map_div₀, hψs, div_one] at hx; exact hx
    have haw : a ∉ w.asIdeal := by
      rw [← IsDedekindDomain.HeightOneSpectrum.intValuation_eq_one_iff,
        ← IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap (K := L)]
      exact hψa
    have hμs : μ (algebraMap (NumberField.RingOfIntegers L) L s) = 1 :=
      le_antisymm (hle s) (not_lt.mp fun h => hsw ((hw s).mpr h))
    have hμa : μ (algebraMap (NumberField.RingOfIntegers L) L a) = 1 :=
      le_antisymm (hle a) (not_lt.mp fun h => haw ((hw a).mpr h))
    rw [map_div₀, hμa, hμs, div_one]
  
  have hπ0 : π ≠ 0 := by
    intro h; rw [h, map_zero] at hψπ; exact WithZero.exp_ne_zero hψπ.symm
  have hμπ0 : μ π ≠ 0 := (Valuation.ne_zero_iff μ).mpr hπ0
  have hμπ : μ π = WithZero.exp (WithZero.log (μ π)) := (WithZero.exp_log hμπ0).symm
  have hm : WithZero.log (μ π) < 0 := by
    have h1 := hπμ
    rw [hμπ, ← WithZero.exp_zero, WithZero.exp_lt_exp] at h1
    exact h1
  have key : ∀ y : L, y ≠ 0 →
      μ y = WithZero.exp (-(WithZero.log (μ π) * WithZero.log (ψ y))) := by
    intro y hy
    have hψy : ψ y = WithZero.exp (WithZero.log (ψ y)) :=
      (WithZero.exp_log ((Valuation.ne_zero_iff ψ).mpr hy)).symm
    have hz : ψ (y * π ^ (WithZero.log (ψ y))) = 1 := by
      rw [map_mul, map_zpow₀, hψπ, ← WithZero.exp_zsmul, hψy, WithZero.log_exp,
        ← WithZero.exp_add, smul_eq_mul, mul_neg, mul_one, add_neg_cancel, WithZero.exp_zero]
    have hz' := hunit _ hz
    rw [map_mul, map_zpow₀, hμπ, ← WithZero.exp_zsmul] at hz'
    rw [eq_inv_of_mul_eq_one_left hz', ← WithZero.exp_neg, smul_eq_mul, mul_comm]
  have hmj := key ℓ hℓ0
  rw [hμℓ] at hmj
  have hmj' : WithZero.log (μ π) * WithZero.log (ψ ℓ) = 1 := by
    have h1 := WithZero.exp_injective hmj
    omega
  have hm1 : WithZero.log (μ π) = -1 := by
    rcases Int.eq_one_or_neg_one_of_mul_eq_one hmj' with h | h
    · omega
    · exact h
  intro x
  by_cases hx : x = 0
  · rw [hx, map_zero]
    show (0 : WithZero (Multiplicative ℤ)) = Valued.v ((0 : L) : v.adicCompletion K)
    rw [IntermediateField.coe_zero, map_zero]
  · rw [← hμ x, key x hx, hm1, neg_one_mul, neg_neg,
      WithZero.exp_log ((Valuation.ne_zero_iff ψ).mpr hx)]

theorem adicCompletion_ringEquiv_of_dense {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (L : IntermediateField ℚ (v.adicCompletion K)) [NumberField L]
    (hL : Dense (L : Set (v.adicCompletion K)))
    (w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L))
    (hw : ∀ x : L, IsDedekindDomain.HeightOneSpectrum.valuation L w x =
      Valued.v (x : v.adicCompletion K)) :
    Nonempty (v.adicCompletion K ≃+* w.adicCompletion L) :=
by
  classical
  let j : WithVal (IsDedekindDomain.HeightOneSpectrum.valuation L w) →+* v.adicCompletion K :=
    L.toSubfield.subtype.comp
      (WithVal.equiv (IsDedekindDomain.HeightOneSpectrum.valuation L w)).toRingHom
  have hj : ∀ x, Valued.v (j x) = Valued.v x := by
    intro x
    exact (hw _).symm
  have hui : IsUniformInducing j := by
    rw [isUniformInducing_iff]
    have hS := (Valued.hasBasis_uniformity (v.adicCompletion K)
      (WithZero (Multiplicative ℤ))).comap
        (fun p : WithVal (IsDedekindDomain.HeightOneSpectrum.valuation L w) ×
          WithVal (IsDedekindDomain.HeightOneSpectrum.valuation L w) => (j p.1, j p.2))
    refine hS.eq_of_same_basis ?_
    convert Valued.hasBasis_uniformity
      (WithVal (IsDedekindDomain.HeightOneSpectrum.valuation L w))
      (WithZero (Multiplicative ℤ)) using 1
    funext γ
    ext p
    simp only [Set.mem_preimage, Set.mem_setOf_eq, ← map_sub, hj]
  have hd : DenseRange j := by
    have hr : Set.range j = (L : Set (v.adicCompletion K)) := by
      ext y
      constructor
      · rintro ⟨x, rfl⟩
        exact (WithVal.equiv _ x).2
      · intro hy
        refine ⟨(WithVal.equiv (IsDedekindDomain.HeightOneSpectrum.valuation L w)).symm ⟨y, hy⟩, ?_⟩
        show (((WithVal.equiv (IsDedekindDomain.HeightOneSpectrum.valuation L w))
          ((WithVal.equiv (IsDedekindDomain.HeightOneSpectrum.valuation L w)).symm ⟨y, hy⟩) : L) :
            v.adicCompletion K) = y
        rw [RingEquiv.apply_symm_apply]
    unfold DenseRange
    rw [hr]
    exact hL
  let pkg : AbstractCompletion (WithVal (IsDedekindDomain.HeightOneSpectrum.valuation L w)) :=
    ⟨v.adicCompletion K, j, inferInstance, inferInstance, inferInstance, hui, hd⟩
  let φ := UniformSpace.Completion.extensionHom j hui.uniformContinuous.continuous
  have hφ : (φ : UniformSpace.Completion
      (WithVal (IsDedekindDomain.HeightOneSpectrum.valuation L w)) → v.adicCompletion K) =
      UniformSpace.Completion.cPkg.compareEquiv pkg := rfl
  have hbij : Function.Bijective φ := by
    rw [hφ]
    exact (@UniformEquiv.toEquiv _ _ UniformSpace.Completion.cPkg.uniformStruct pkg.uniformStruct
      (UniformSpace.Completion.cPkg.compareEquiv pkg)).bijective
  exact ⟨(RingEquiv.ofBijective φ hbij).symm⟩

theorem finrank_closure_rat_le_ramificationIdx_mul_inertiaDeg {K : Type u} [Field K]
    [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (L : IntermediateField ℚ (v.adicCompletion K)) [NumberField L]
    (hL : Dense (L : Set (v.adicCompletion K)))
    (w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L))
    (hw : ∀ x : L, IsDedekindDomain.HeightOneSpectrum.valuation L w x =
      Valued.v (x : v.adicCompletion K))
    (p : ℕ) (hp : p.Prime) (hpv : Valued.v ((p : v.adicCompletion K)) < 1) :
    FiniteDimensional (algebraMap ℚ (v.adicCompletion K)).fieldRange.topologicalClosure
        (v.adicCompletion K) ∧
    Module.finrank (algebraMap ℚ (v.adicCompletion K)).fieldRange.topologicalClosure
        (v.adicCompletion K) ≤
      Ideal.ramificationIdx (algebraMap ℤ (NumberField.RingOfIntegers L)) (Ideal.span {(p : ℤ)})
          w.asIdeal * (Ideal.span {(p : ℤ)}).inertiaDeg w.asIdeal :=
by
  classical
  
  have hpL : ((p : L) : v.adicCompletion K) = (p : v.adicCompletion K) := by
    simp
  have hvalp : IsDedekindDomain.HeightOneSpectrum.valuation L w (p : L) =
      Valued.v (p : v.adicCompletion K) := by
    rw [hw, hpL]
  have hpw : (p : NumberField.RingOfIntegers L) ∈ w.asIdeal := by
    rw [← IsDedekindDomain.HeightOneSpectrum.valuation_lt_one_iff_mem (K := L)]
    have key : IsDedekindDomain.HeightOneSpectrum.valuation L w (p : L) < 1 := hvalp ▸ hpv
    convert key using 2
  
  have he : IsDedekindDomain.HeightOneSpectrum.valuation L w (p : L) =
      WithZero.exp (-((Ideal.ramificationIdx (algebraMap ℤ (NumberField.RingOfIntegers L))
        (Ideal.span {(p : ℤ)}) w.asIdeal : ℕ) : ℤ)) := by
    have hP0 : (p : NumberField.RingOfIntegers L) ≠ 0 := by
      intro h
      have h' : (((p : NumberField.RingOfIntegers L) : L)) = 0 := by rw [h]; rfl
      have e0 : (((p : NumberField.RingOfIntegers L) : L)) = (p : L) := by simp
      rw [e0] at h'
      exact hp.ne_zero (by exact_mod_cast h')
    have e1 : (p : L) = algebraMap (NumberField.RingOfIntegers L) L
        (p : NumberField.RingOfIntegers L) := (map_natCast _ _).symm
    rw [e1, IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap]
    have hval := IsDedekindDomain.HeightOneSpectrum.intValuation_if_neg w hP0
    set k := (Associates.mk w.asIdeal).count
      (Associates.mk (Ideal.span {(p : NumberField.RingOfIntegers L)})).factors with hk
    have hmap : Ideal.map (algebraMap ℤ (NumberField.RingOfIntegers L)) (Ideal.span {(p : ℤ)}) =
        Ideal.span {(p : NumberField.RingOfIntegers L)} := by
      rw [Ideal.map_span, Set.image_singleton, map_natCast]
    have hram : Ideal.ramificationIdx (algebraMap ℤ (NumberField.RingOfIntegers L))
        (Ideal.span {(p : ℤ)}) w.asIdeal = k := by
      apply Ideal.ramificationIdx_spec
      · rw [hmap, Ideal.span_singleton_le_iff_mem,
          ← IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_mem, hval]
      · rw [hmap, Ideal.span_singleton_le_iff_mem,
          ← IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_mem, hval,
          WithZero.exp_le_exp]
        push_cast
        omega
    rw [hval, hram]
  have hpF : Valued.v (p : v.adicCompletion K) =
      WithZero.exp (-((Ideal.ramificationIdx (algebraMap ℤ (NumberField.RingOfIntegers L))
        (Ideal.span {(p : ℤ)}) w.asIdeal : ℕ) : ℤ)) := by
    rw [← hvalp, he]
  have hp0 : (p : v.adicCompletion K) ≠ 0 := by
    intro h
    rw [h, Valuation.map_zero] at hpF
    exact WithZero.exp_ne_zero hpF.symm
  
  obtain ⟨π₀, hπ₀⟩ := IsDedekindDomain.HeightOneSpectrum.valuation_exists_uniformizer L w
  have hπ : Valued.v ((π₀ : L) : v.adicCompletion K) = WithZero.exp (-1 : ℤ) := by
    rw [← hw, hπ₀]
  
  
  have s2 : ∀ {L' : Type u} [Field L'] [NumberField L']
      (w' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L')),
      (p : NumberField.RingOfIntegers L') ∈ w'.asIdeal →
      ∃ ω : Fin ((Ideal.span {(p : ℤ)}).inertiaDeg w'.asIdeal) →
        NumberField.RingOfIntegers L',
        ∀ a : NumberField.RingOfIntegers L',
          ∃ c : Fin ((Ideal.span {(p : ℤ)}).inertiaDeg w'.asIdeal) → ℤ,
            a - ∑ i, (c i : NumberField.RingOfIntegers L') * ω i ∈ w'.asIdeal := by
    intro L' _ _ w' hpw'
    haveI : Fact p.Prime := ⟨hp⟩
    haveI hmax : (Ideal.span {(p : ℤ)}).IsMaximal := Int.ideal_span_isMaximal_of_prime p
    haveI := w'.isPrime
    haveI hlo : w'.asIdeal.LiesOver (Ideal.span {(p : ℤ)}) := by
      refine ⟨?_⟩
      apply hmax.eq_of_le
      · exact (Ideal.IsPrime.comap (K := w'.asIdeal) (algebraMap ℤ _)).ne_top
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        show (algebraMap ℤ (NumberField.RingOfIntegers L') (p : ℤ)) ∈ w'.asIdeal
        simpa using hpw'
    have hf := Ideal.inertiaDeg_algebraMap (Ideal.span {(p : ℤ)}) w'.asIdeal
    letI : Field (ℤ ⧸ Ideal.span {(p : ℤ)}) := Ideal.Quotient.field _
    haveI : Module.Free (ℤ ⧸ Ideal.span {(p : ℤ)}) (NumberField.RingOfIntegers L' ⧸ w'.asIdeal) :=
      Module.Free.of_divisionRing _ _
    let b := Module.finBasisOfFinrankEq (ℤ ⧸ Ideal.span {(p : ℤ)})
      (NumberField.RingOfIntegers L' ⧸ w'.asIdeal) hf.symm
    choose ω hω' using fun i => Ideal.Quotient.mk_surjective (I := w'.asIdeal) (b i)
    refine ⟨ω, fun a => ?_⟩
