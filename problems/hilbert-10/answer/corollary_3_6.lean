        (⟨z, hz⟩ : ↥(ValuativeRel.valuation F).integer) :=
    ⟨fun z => if hz : ValuativeRel.valuation F z ≤ 1 then
      Ideal.Quotient.mk (Ideal.span {a₀}) (⟨z, hz⟩ : ↥(ValuativeRel.valuation F).integer) else 0,
      fun z hz => dif_pos hz⟩
  have key : ∀ r : (↥(ValuativeRel.valuation F).integer ⧸ Ideal.span {a₀}) ×
      (↥(ValuativeRel.valuation F).integer ⧸ Ideal.span {a₀}),
      ∃ Q : (threeRootsCurve t₁ t₂ t₃).toAffine.Point, ∀ (x y : F)
        (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y),
        ValuativeRel.valuation F x ≤ 1 → (ρ x, ρ y) = r →
        (QuotientAddGroup.mk Q : (threeRootsCurve t₁ t₂ t₃).toAffine.Point ⧸ U ϖ) =
          QuotientAddGroup.mk (WeierstrassCurve.Affine.Point.some h) := by
    intro r
    by_cases hr : ∃ (x y : F) (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y),
        ValuativeRel.valuation F x ≤ 1 ∧ (ρ x, ρ y) = r
    · obtain ⟨x', y', h', hx', hr'⟩ := hr
      refine ⟨WeierstrassCurve.Affine.Point.some h', fun x y h hx hxy => ?_⟩
      rw [QuotientAddGroup.eq, hU ϖ hϖ1]
      intro x₃ y₃ h₃ heq
      have hy : ValuativeRel.valuation F y ≤ 1 := hyint x y h hx
      have hy' : ValuativeRel.valuation F y' ≤ 1 := hyint x' y' h' hx'
      have hρeq : (ρ x, ρ y) = (ρ x', ρ y') := hxy.trans hr'.symm
      rw [Prod.mk.injEq] at hρeq
      have hcx : ValuativeRel.valuation F (x - x') ≤ ValuativeRel.valuation F a :=
