      have := congrArg Units.val hm
      simpa using this
    have he2 : (e₂ : v.adicCompletion K) = (u : v.adicCompletion K) * (m : v.adicCompletion K) ^ 2 := by
      rw [hm', ← mul_assoc, mul_inv_cancel₀ u.ne_zero, one_mul]
    obtain ⟨z₀, z₁, z₂, z₃, hnt, f1, f2⟩ := he
    rw [← hk', he2] at f1 f2
    refine ⟨u, rfl, z₀, (k : v.adicCompletion K) * z₁, (m : v.adicCompletion K) * z₂,
      (k : v.adicCompletion K) * (m : v.adicCompletion K) * z₃, ?_, ?_, ?_⟩
    · rintro ⟨h0, h1', h2', h3'⟩
      apply hnt
      refine ⟨h0, ?_, ?_, ?_⟩
      · exact (mul_eq_zero.1 h1').resolve_left k.ne_zero
      · exact (mul_eq_zero.1 h2').resolve_left m.ne_zero
      · exact (mul_eq_zero.1 h3').resolve_left (mul_ne_zero k.ne_zero m.ne_zero)
    · linear_combination f1
    · linear_combination f2
  
  have hall : ∀ c ∈ spDesc (v.adicCompletion K) t₁ t₂ t₃,
      ∀ᶠ s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K in nhds (t₁, t₂, t₃),
        c ∈ spDesc (v.adicCompletion K) s.1 s.2.1 s.2.2 := by
    rintro c ⟨d₁, d₂, rfl, hc⟩
    exact (persist _ _ d₁.ne_zero d₂.ne_zero hc).mono fun s hs => ⟨d₁, d₂, rfl, hs⟩
  have hsub : ∀ᶠ s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K in
      nhds (t₁, t₂, t₃),
      spDesc (v.adicCompletion K) t₁ t₂ t₃ ⊆ spDesc (v.adicCompletion K) s.1 s.2.1 s.2.2 :=
    ((Filter.eventually_all_finite (Set.toFinite (spDesc (v.adicCompletion K) t₁ t₂ t₃))).2
      hall).mono fun s hs c hc => hs c hc
  have hd12 := pull (fun s => s.1 - s.2.1) (t₁ - t₂) (by fun_prop) rfl (sub_ne_zero.2 h₁₂)
  have hd13 := pull (fun s => s.1 - s.2.2) (t₁ - t₃) (by fun_prop) rfl (sub_ne_zero.2 h₁₃)
  have hd23 := pull (fun s => s.2.1 - s.2.2) (t₂ - t₃) (by fun_prop) rfl (sub_ne_zero.2 h₂₃)
  have hphi : ∀ᶠ s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K in
      nhds (t₁, t₂, t₃),
      phiSign (v.adicCompletion K) s.1 s.2.1 s.2.2 = phiSign (v.adicCompletion K) t₁ t₂ t₃ := by
    filter_upwards [hsub, hd12, hd13, hd23] with s hs hs12 hs13 hs23
    obtain ⟨r12, hr12, e12⟩ := hs12
    obtain ⟨r13, hr13, e13⟩ := hs13
    obtain ⟨r23, hr23, e23⟩ := hs23
    have n12 : s.1 ≠ s.2.1 := sub_ne_zero.1 (by
      rw [e12]; exact mul_ne_zero (sub_ne_zero.2 h₁₂) (pow_ne_zero 2 hr12))
    have n13 : s.1 ≠ s.2.2 := sub_ne_zero.1 (by
      rw [e13]; exact mul_ne_zero (sub_ne_zero.2 h₁₃) (pow_ne_zero 2 hr13))
    have n23 : s.2.1 ≠ s.2.2 := sub_ne_zero.1 (by
      rw [e23]; exact mul_ne_zero (sub_ne_zero.2 h₂₃) (pow_ne_zero 2 hr23))
    have hn1 := descentSet_ncard_adicCompletion v s.1 s.2.1 s.2.2 n12 n13 n23
    have hn2 := descentSet_ncard_adicCompletion v t₁ t₂ t₃ h₁₂ h₁₃ h₂₃
    have heq : spDesc (v.adicCompletion K) t₁ t₂ t₃ =
        spDesc (v.adicCompletion K) s.1 s.2.1 s.2.2 :=
      Set.eq_of_subset_of_ncard_le hs (by rw [hn1, hn2]) (Set.toFinite _)
    have himg : phiImg (v.adicCompletion K) s.1 s.2.1 s.2.2 =
        phiImg (v.adicCompletion K) t₁ t₂ t₃ :=
      Set.Subset.antisymm (phiImg_mono _ _ _ _ _ _ heq.symm.subset)
        (phiImg_mono _ _ _ _ _ _ heq.subset)
    unfold phiSign
    rw [himg]
  exact hphi.and hhilb

theorem phiSign_hilbTerm_ringEquiv {F₁ F₂ : Type*} [Field F₁] [Field F₂] (τ : F₁ ≃+* F₂)
    (t₁ t₂ t₃ : F₁) :
    phiSign F₂ (τ t₁) (τ t₂) (τ t₃) = phiSign F₁ t₁ t₂ t₃ ∧
    hilbTerm F₂ (τ t₁) (τ t₂) (τ t₃) = hilbTerm F₁ t₁ t₂ t₃ :=
by
  classical
  
  have hD : ∀ u : F₁, IsDescentClass (τ t₁) (τ t₂) (τ t₃) 1 (τ u) ↔
      IsDescentClass t₁ t₂ t₃ 1 u := by
    intro u
    constructor
    · rintro ⟨z₀, z₁, z₂, z₃, hnz, h1, h2⟩
      refine ⟨τ.symm z₀, τ.symm z₁, τ.symm z₂, τ.symm z₃, ?_, ?_, ?_⟩
      · rintro ⟨e0, e1, e2, e3⟩
        apply hnz
        refine ⟨?_, ?_, ?_, ?_⟩
        · simpa using congrArg τ e0
        · simpa using congrArg τ e1
        · simpa using congrArg τ e2
        · simpa using congrArg τ e3
      · apply τ.injective
        simp only [map_sub, map_mul, map_pow, map_one, RingEquiv.apply_symm_apply]
        exact h1
      · apply τ.injective
        simp only [map_sub, map_mul, map_pow, map_one, RingEquiv.apply_symm_apply]
        exact h2
    · rintro ⟨z₀, z₁, z₂, z₃, hnz, h1, h2⟩
      refine ⟨τ z₀, τ z₁, τ z₂, τ z₃, ?_, ?_, ?_⟩
      · rintro ⟨e0, e1, e2, e3⟩
        apply hnz
        refine ⟨?_, ?_, ?_, ?_⟩
        · simpa using e0
        · simpa using e1
        · simpa using e2
        · simpa using e3
      · have := congrArg τ h1
        simpa only [map_sub, map_mul, map_pow, map_one] using this
      · have := congrArg τ h2
        simpa only [map_sub, map_mul, map_pow, map_one] using this
  
  set e : F₁ˣ ≃* F₂ˣ := Units.mapEquiv τ.toMulEquiv with he_def
  have he : ∀ u : F₁ˣ, ((e u : F₂ˣ) : F₂) = τ (u : F₁) := fun u => rfl
  have hS : Subgroup.map (e : F₁ˣ →* F₂ˣ) (powMonoidHom 2 : F₁ˣ →* F₁ˣ).range =
      (powMonoidHom 2 : F₂ˣ →* F₂ˣ).range := by
    ext v
    simp only [Subgroup.mem_map, MonoidHom.mem_range, powMonoidHom_apply]
    constructor
    · rintro ⟨x, ⟨w, rfl⟩, rfl⟩
      exact ⟨e w, by simp⟩
    · rintro ⟨w, rfl⟩
      exact ⟨e.symm w ^ 2, ⟨e.symm w, rfl⟩, by simp⟩
  set Φ : SqCl F₁ ≃* SqCl F₂ := QuotientGroup.congr _ _ e hS with hΦ_def
  have hΦ : ∀ u : F₁ˣ, Φ (sqCl u) = sqCl (e u) := fun u => QuotientGroup.congr_mk _ _ _ _ u
  have hset : phiImg F₂ (τ t₁) (τ t₂) (τ t₃) = Φ '' phiImg F₁ t₁ t₂ t₃ := by
    ext c
    simp only [phiImg, Set.mem_setOf_eq, Set.mem_image]
    constructor
    · rintro ⟨v, rfl, hv⟩
      have hv' : τ ((e.symm v : F₁ˣ) : F₁) = (v : F₂) := by
        rw [← he, MulEquiv.apply_symm_apply]
      refine ⟨sqCl (e.symm v), ⟨e.symm v, rfl, ?_⟩, ?_⟩
      · rw [← hD, hv']
        exact hv
      · rw [hΦ, MulEquiv.apply_symm_apply]
    · rintro ⟨c', ⟨u, rfl, hu⟩, rfl⟩
      exact ⟨e u, hΦ u, by rw [he]; exact (hD u).mpr hu⟩
  have hE : (phiImg F₂ (τ t₁) (τ t₂) (τ t₃)).encard = (phiImg F₁ t₁ t₂ t₃).encard := by
    rw [hset]
    exact (EquivLike.injective Φ).encard_image _
  
  have hsym : ∀ a b : F₁, hilbSym F₂ (τ a) (τ b) = hilbSym F₁ a b := by
    intro a b
    have H : (∃ x y : F₂, τ a * x ^ 2 + τ b * y ^ 2 = 1) ↔
        (∃ x y : F₁, a * x ^ 2 + b * y ^ 2 = 1) := by
      constructor
      · rintro ⟨x, y, h⟩
        refine ⟨τ.symm x, τ.symm y, τ.injective ?_⟩
        simpa only [map_add, map_mul, map_pow, map_one, RingEquiv.apply_symm_apply] using h
      · rintro ⟨x, y, h⟩
        refine ⟨τ x, τ y, ?_⟩
        simpa only [map_add, map_mul, map_pow, map_one] using congrArg τ h
    unfold hilbSym
    by_cases hc : ∃ x y : F₁, a * x ^ 2 + b * y ^ 2 = 1
    · rw [if_pos hc, if_pos (H.mpr hc)]
    · rw [if_neg hc, if_neg (fun h => hc (H.mp h))]
  refine ⟨?_, ?_⟩
  · unfold phiSign
    by_cases hk : ∃ k : ℕ, (phiImg F₁ t₁ t₂ t₃).encard = 2 ^ k ∧ Even k
    · rw [if_pos hk, if_pos (by rw [hE]; exact hk)]
    · rw [if_neg hk, if_neg (by rw [hE]; exact hk)]
  · have ha : 2 * τ t₁ - τ t₂ - τ t₃ = τ (2 * t₁ - t₂ - t₃) := by
      simp only [map_sub, map_mul, map_ofNat]
    have hb : -((τ t₁ - τ t₂) * (τ t₁ - τ t₃)) = τ (-((t₁ - t₂) * (t₁ - t₃))) := by
      simp only [map_neg, map_mul, map_sub]
    unfold hilbTerm
    rw [ha, hb]
    by_cases h0 : 2 * t₁ - t₂ - t₃ = 0
    · rw [if_pos h0, if_pos (by rw [h0, map_zero])]
    · rw [if_neg h0, if_neg ((map_ne_zero τ).mpr h0), hsym]

theorem exists_nice_global_approx {K : Type u} [Field K] [NumberField K]
    (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (t₁ t₂ t₃ : v₀.adicCompletion K) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃)
    (U : Set (v₀.adicCompletion K × v₀.adicCompletion K × v₀.adicCompletion K))
    (hU : U ∈ nhds (t₁, t₂, t₃)) :
    ∃ e₁ e₂ e₃ : K, e₁ ≠ e₂ ∧ e₁ ≠ e₃ ∧ e₂ ≠ e₃ ∧
      (algebraMap K (v₀.adicCompletion K) e₁, algebraMap K (v₀.adicCompletion K) e₂,
        algebraMap K (v₀.adicCompletion K) e₃) ∈ U ∧
      (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K), v ≠ v₀ →
        IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) ≤ 1 ∧
        IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) ≤ 1 ∧
        ¬ (IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) < 1 ∧
          IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) < 1)) ∧
      ∃ v₁ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        1 < IsDedekindDomain.HeightOneSpectrum.valuation K v₁
          ((threeRootsCurve e₁ e₂ e₃).c₄ ^ 3 / (threeRootsCurve e₁ e₂ e₃).Δ) :=
by
  classical
  
  have nice_local : ∀ (w : Valuation K (WithZero (Multiplicative ℤ))) (p x y : K),
      w p ≤ 1 → w x ≤ 1 → w y ≤ 1 →
      w (p * (1 + (1 + p * x) * y)) ≤ 1 ∧ w (1 + p * x) ≤ 1 ∧
      ¬ (w (p * (1 + (1 + p * x) * y)) < 1 ∧ w (1 + p * x) < 1) ∧
      (w p < 1 → w (p * (1 + (1 + p * x) * y)) < 1 ∧ w (1 + p * x) = 1) := by
    intro w p x y hp hx hy
    have hβ : w (1 + p * x) ≤ 1 := by
      refine le_trans (w.map_add _ _) (max_le (le_of_eq w.map_one) ?_)
      rw [w.map_mul]; exact mul_le_one' hp hx
    have hβy : w ((1 + p * x) * y) ≤ w (1 + p * x) := by
      rw [w.map_mul]; exact mul_le_of_le_one_right' hy
    have h1 : w (1 + (1 + p * x) * y) ≤ 1 :=
      le_trans (w.map_add _ _) (max_le (le_of_eq w.map_one) (hβy.trans hβ))
    have hα : w (p * (1 + (1 + p * x) * y)) ≤ 1 := by
      rw [w.map_mul]; exact mul_le_one' hp h1
    have hlast : w p < 1 → w (p * (1 + (1 + p * x) * y)) < 1 ∧ w (1 + p * x) = 1 := by
      intro hp1
      refine ⟨?_, ?_⟩
      · rw [w.map_mul]; exact lt_of_le_of_lt (mul_le_of_le_one_right' h1) hp1
      · apply Valuation.map_one_add_of_lt
        rw [w.map_mul]; exact lt_of_le_of_lt (mul_le_of_le_one_right' hx) hp1
    refine ⟨hα, hβ, ?_, hlast⟩
    rintro ⟨ha, hb⟩
    rcases lt_or_eq_of_le hp with hp1 | hp1
    · exact absurd (hlast hp1).2 (ne_of_lt hb)
    · have h3 : w (1 + (1 + p * x) * y) = 1 :=
        Valuation.map_one_add_of_lt _ (lt_of_le_of_lt hβy hb)
      rw [w.map_mul, hp1, h3, one_mul] at ha
      exact lt_irrefl _ ha
  
  have jval : ∀ (w : Valuation K (WithZero (Multiplicative ℤ))) (e₁ e₂ e₃ : K), e₁ ≠ e₂ →
      w 2 = 1 → w (e₁ - e₂) < 1 → w (e₁ - e₃) = 1 →
      1 < w ((threeRootsCurve e₁ e₂ e₃).c₄ ^ 3 / (threeRootsCurve e₁ e₂ e₃).Δ) := by
    intro w e₁ e₂ e₃ h12 h2 hα hβ
    have hc4 : (threeRootsCurve e₁ e₂ e₃).c₄ =
        16 * ((e₁ - e₃) ^ 2 + (e₁ - e₂) * ((e₁ - e₂) - (e₁ - e₃))) := by
      simp only [threeRootsCurve, WeierstrassCurve.c₄, WeierstrassCurve.b₂, WeierstrassCurve.b₄]
      ring
    have hΔ : (threeRootsCurve e₁ e₂ e₃).Δ =
        16 * ((e₁ - e₂) ^ 2 * (e₁ - e₃) ^ 2 * ((e₁ - e₂) - (e₁ - e₃)) ^ 2) := by
      simp only [threeRootsCurve, WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
        WeierstrassCurve.b₆, WeierstrassCurve.b₈]
      ring
    have h16 : w 16 = 1 := by
      have e : (16 : K) = 2 ^ 4 := by norm_num
      rw [e, map_pow, h2, one_pow]
    have hα0 : w (e₁ - e₂) ≠ 0 := (Valuation.ne_zero_iff w).mpr (sub_ne_zero.mpr h12)
    have hγ : w ((e₁ - e₂) - (e₁ - e₃)) = 1 := by
      rw [sub_eq_add_neg, add_comm, Valuation.map_add_eq_of_lt_left, Valuation.map_neg, hβ]
      rw [Valuation.map_neg, hβ]; exact hα
    have hQ : w ((e₁ - e₃) ^ 2 + (e₁ - e₂) * ((e₁ - e₂) - (e₁ - e₃))) = 1 := by
      rw [Valuation.map_add_eq_of_lt_left, map_pow, hβ, one_pow]
      rw [map_pow, hβ, one_pow, map_mul, hγ, mul_one]; exact hα
    rw [hc4, hΔ]
    simp only [map_div₀, map_pow, map_mul, h16, hQ, hγ, hβ, one_pow, mul_one, one_mul, one_div]
    have hpos : 0 < w (e₁ - e₂) ^ 2 := pow_pos (zero_lt_iff.mpr hα0) 2
    have hlt : w (e₁ - e₂) ^ 2 < 1 := pow_lt_one₀ (zero_lt_iff.mpr hα0).le hα (by norm_num)
    exact (one_lt_inv₀ hpos).mpr hlt
  
  obtain ⟨P, v₁, hP0, hv₁, hPint, hPv₁, h2v₁⟩ : ∃ (P : K)
      (v₁ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      P ≠ 0 ∧ v₁ ≠ v₀ ∧
      (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
        IsDedekindDomain.HeightOneSpectrum.valuation K v P ≤ 1) ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K v₁ P < 1 ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K v₁ 2 = 1 := by
    obtain ⟨p, hp35, hpv₀⟩ : ∃ p : ℕ, (p = 3 ∨ p = 5) ∧
        ((p : NumberField.RingOfIntegers K) ∉ v₀.asIdeal) := by
      by_contra hcon
      push_neg at hcon
      have h3 := hcon 3 (Or.inl rfl)
      have h5 := hcon 5 (Or.inr rfl)
      apply v₀.isPrime.ne_top
      rw [Ideal.eq_top_iff_one]
      have e : (1 : NumberField.RingOfIntegers K) =
          2 * ((3 : ℕ) : NumberField.RingOfIntegers K) - ((5 : ℕ) : NumberField.RingOfIntegers K) := by
        push_cast; ring
      rw [e]
      exact Ideal.sub_mem _ (Ideal.mul_mem_left _ _ h3) h5
    have hpprime : Prime (p : ℤ) := by
      rcases hp35 with rfl | rfl
      · exact Int.prime_three
      · exact Nat.prime_iff_prime_int.mp (by norm_num)
    haveI hpZ : (Ideal.span {(p : ℤ)}).IsPrime :=
      (Ideal.span_singleton_prime hpprime.ne_zero).mpr hpprime
    obtain ⟨Q, -, hQprime, hQcomap⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral (S := NumberField.RingOfIntegers K)
        (Ideal.span {(p : ℤ)}) ⊥ (by
          intro z hz
          rw [Ideal.mem_comap, Ideal.mem_bot] at hz
          have hz0 : z = 0 :=
            RingHom.injective_int (algebraMap ℤ (NumberField.RingOfIntegers K))
              (hz.trans (map_zero _).symm)
          rw [hz0]; exact zero_mem _)
    have hpQ : (p : NumberField.RingOfIntegers K) ∈ Q := by
      have h : (p : ℤ) ∈ Q.comap (algebraMap ℤ (NumberField.RingOfIntegers K)) := by
        rw [hQcomap]; exact Ideal.subset_span rfl
      rwa [Ideal.mem_comap, map_natCast] at h
    have h2Q : (2 : NumberField.RingOfIntegers K) ∉ Q := by
      intro h
      have h' : (2 : ℤ) ∈ Q.comap (algebraMap ℤ (NumberField.RingOfIntegers K)) := by
        rw [Ideal.mem_comap, map_ofNat]; exact h
      rw [hQcomap, Ideal.mem_span_singleton] at h'
      rcases hp35 with rfl | rfl <;> omega
    have hQbot : Q ≠ ⊥ := by
      intro h
      rw [h, Ideal.mem_bot] at hpQ
      exact absurd (Nat.cast_eq_zero.mp hpQ) (by omega)
    let v₁ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) :=
      ⟨Q, hQprime, hQbot⟩
    refine ⟨(p : K), v₁, Nat.cast_ne_zero.mpr (by omega), ?_, ?_, ?_, ?_⟩
    · intro h
      apply hpv₀
      have h' := congrArg IsDedekindDomain.HeightOneSpectrum.asIdeal h
      rw [← h']; exact hpQ
    · intro v
      have h := v.valuation_le_one (K := K) (p : NumberField.RingOfIntegers K)
      simpa using h
    · have h := (v₁.valuation_lt_one_iff_mem (K := K) (p : NumberField.RingOfIntegers K)).mpr hpQ
      simpa using h
    · refine le_antisymm ?_ (not_lt.mp fun h => h2Q ?_)
      · have h := v₁.valuation_le_one (K := K) (2 : NumberField.RingOfIntegers K)
        simpa using h
      · refine (v₁.valuation_lt_one_iff_mem (K := K) (2 : NumberField.RingOfIntegers K)).mp ?_
        simpa using h
  
  have s1 : ∀ (k : K) (γ : (WithZero (Multiplicative ℤ))ˣ), ∃ r : K,
      (∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K), v ≠ v₀ →
        IsDedekindDomain.HeightOneSpectrum.valuation K v r ≤ 1) ∧
      IsDedekindDomain.HeightOneSpectrum.valuation K v₀ (r - k) <
        (γ : WithZero (Multiplicative ℤ)) := by
    intro k γ
    obtain ⟨x, d, hd, hk⟩ := IsFractionRing.div_surjective (A := NumberField.RingOfIntegers K) k
    have hd0 : d ≠ 0 := nonZeroDivisors.ne_zero hd
    have hdK : algebraMap (NumberField.RingOfIntegers K) K d ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hd
    have hspan : Ideal.span {d} ≠ ⊥ := by
      rwa [ne_eq, Ideal.span_singleton_eq_bot]
    haveI := v₀.isMaximal
    obtain ⟨J, hJ, hdJ⟩ := Ideal.eq_prime_pow_mul_coprime hspan v₀.asIdeal
    set m := Multiset.count v₀.asIdeal (UniqueFactorizationMonoid.normalizedFactors (Ideal.span {d}))
      with hm
    obtain ⟨L, hL⟩ : ∃ L : ℕ, IsDedekindDomain.HeightOneSpectrum.valuation K v₀ k *
        WithZero.exp (-(L : ℤ)) < (γ : WithZero (Multiplicative ℤ)) := by
      by_cases hk0 : IsDedekindDomain.HeightOneSpectrum.valuation K v₀ k = 0
      · exact ⟨0, by rw [hk0, zero_mul]; exact Units.zero_lt γ⟩
      · obtain ⟨a, ha⟩ : ∃ a : ℤ, IsDedekindDomain.HeightOneSpectrum.valuation K v₀ k =
            WithZero.exp a := ⟨_, (WithZero.exp_log hk0).symm⟩
        obtain ⟨g, hg⟩ : ∃ g : ℤ, (γ : WithZero (Multiplicative ℤ)) = WithZero.exp g :=
          ⟨_, (WithZero.exp_log γ.ne_zero).symm⟩
        refine ⟨(a - g + 1).toNat, ?_⟩
        rw [ha, hg, ← WithZero.exp_add, WithZero.exp_lt_exp]
