          ((EllipticRootNumber.charRep F M χ).comp
            (Subgroup.subgroupOfEquivOfLe hle).toMonoidHom) k (f.1 g) := f.2
      obtain ⟨k₀, hk⟩ := QuotientGroup.mk_out_eq_mul
        ((EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F L)) x⁻¹
