      obtain ⟨q, hq⟩ := (hεd _ hβ).resolve_left hβns
      refine ⟨P * y, P * σ / ε, q * r / ε, ?_, ?_⟩
      · field_simp
        linear_combination hσ'
      · rw [add_comm, hr]
        field_simp
        linear_combination hq
  · 
    intro u hu hD
    have hns : ¬ IsSquare u := by
      rintro ⟨r, rfl⟩
