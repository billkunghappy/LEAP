    · exact ⟨0, fun x y h hx hxy => absurd ⟨x, y, h, hx, hxy⟩ hr⟩
  choose Ψ hΨ using key
  have hsurj : Function.Surjective (fun o : Option ((↥(ValuativeRel.valuation F).integer ⧸
      Ideal.span {a₀}) × (↥(ValuativeRel.valuation F).integer ⧸ Ideal.span {a₀})) =>
      (o.elim 0 (fun r => QuotientAddGroup.mk (Ψ r)) :
        (threeRootsCurve t₁ t₂ t₃).toAffine.Point ⧸ U ϖ)) := by
    intro C
    obtain ⟨P, rfl⟩ := QuotientAddGroup.mk_surjective C
    cases P with
    | zero => exact ⟨none, (QuotientAddGroup.mk_zero _).symm⟩
    | @some x y h =>
      by_cases hx : ValuativeRel.valuation F x ≤ 1
      · exact ⟨some (ρ x, ρ y), hΨ (ρ x, ρ y) x y h hx rfl⟩
      · refine ⟨none, ?_⟩
        show (0 : (threeRootsCurve t₁ t₂ t₃).toAffine.Point ⧸ U ϖ) = _
        rw [eq_comm, QuotientAddGroup.eq_zero_iff, hU ϖ hϖ1]
        intro x' y' h' heq
        simp only [WeierstrassCurve.Affine.Point.some.injEq] at heq
        obtain ⟨rfl, rfl⟩ := heq
        exact E1 x y h (not_le.mp hx)
  haveI := Finite.of_surjective _ hsurj
  exact AddSubgroup.index_ne_zero_of_finite

theorem threeRootsCurve_filtration_relIndex_ne_zero (F : Type*) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [DecidableEq F]
    (t₁ t₂ t₃ : F) (ht₁ : ValuativeRel.valuation F t₁ ≤ 1) (ht₂ : ValuativeRel.valuation F t₂ ≤ 1)
    (ht₃ : ValuativeRel.valuation F t₃ ≤ 1)
    (U : F → AddSubgroup (threeRootsCurve t₁ t₂ t₃).toAffine.Point)
    (hU : ∀ c : F, ValuativeRel.valuation F c < 1 → ∀ P, P ∈ U c ↔
      ∀ (x y : F) (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y),
        P = WeierstrassCurve.Affine.Point.some h → 1 ≤ ValuativeRel.valuation F (c ^ 2 * x))
    (ϖ : F) (hϖ0 : ϖ ≠ 0) (hϖ1 : ValuativeRel.valuation F ϖ < 1)
    (hϖ : ∀ b : F, ValuativeRel.valuation F b < 1 →
      ValuativeRel.valuation F b ≤ ValuativeRel.valuation F ϖ)
    (c : F) (hc0 : c ≠ 0) (hc : ValuativeRel.valuation F c < 1) :
    (U c).relIndex (U ϖ) ≠ 0 :=
by
  classical
  
  have hunit : ∀ b : (ValuativeRel.valuation F).integer,
      IsUnit b ↔ ValuativeRel.valuation F (b : F) = 1 :=
    fun b => (Valuation.integer.integers _).isUnit_iff_valuation_eq_one
  have hRZ : ∀ r : (ValuativeRel.valuation F).integer,
      IsLocalRing.residue _ r = 0 ↔ ValuativeRel.valuation F (r : F) < 1 := by
    intro r
    rw [IsLocalRing.residue_eq_zero_iff, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hunit]
    exact ⟨fun h => lt_of_le_of_ne r.2 h, fun h => ne_of_lt h⟩
  have hval := fun {x y : F} (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y) =>
    threeRootsCurve_valuation_of_nonsingular t₁ t₂ t₃ ht₁ ht₂ ht₃ h
  
  have step : ∀ c : F, c ≠ 0 → ValuativeRel.valuation F c < 1 →
      (U (ϖ * c)).relIndex (U c) ≠ 0 := by
    intro c hc0 hc
    have hVc0 : ValuativeRel.valuation F c ≠ 0 := (Valuation.ne_zero_iff _).mpr hc0
    have hϖc : ValuativeRel.valuation F (ϖ * c) < 1 := by
      rw [map_mul]; exact mul_lt_one_of_lt_of_le hϖ1 hc.le
    
    have hbound : ∀ P ∈ U c, ValuativeRel.valuation F (affinePointZCoord P) ≤
        ValuativeRel.valuation F c := by
      intro P hP
      cases P with
      | zero =>
        show ValuativeRel.valuation F 0 ≤ _
        rw [map_zero]; exact zero_le'
      | @some x y h =>
        exact (((hval h).2.2 c hc).mp ((hU c hc _).mp hP x y h rfl)).2
    have hO : ∀ P : U c, affinePointZCoord (P : (threeRootsCurve t₁ t₂ t₃).toAffine.Point) / c ∈
        (ValuativeRel.valuation F).integer := by
      intro P
      show ValuativeRel.valuation F _ ≤ 1
      by_contra hgt
      push_neg at hgt
      have : ValuativeRel.valuation F c < ValuativeRel.valuation F
          (affinePointZCoord (P : (threeRootsCurve t₁ t₂ t₃).toAffine.Point)) := by
        calc ValuativeRel.valuation F c = 1 * ValuativeRel.valuation F c := (one_mul _).symm
          _ < ValuativeRel.valuation F (affinePointZCoord
                (P : (threeRootsCurve t₁ t₂ t₃).toAffine.Point) / c) * ValuativeRel.valuation F c :=
              mul_lt_mul_of_pos_right hgt (zero_lt_iff.mpr hVc0)
          _ = _ := by rw [← map_mul, div_mul_cancel₀ _ hc0]
      exact absurd (hbound P.1 P.2) (not_le.mpr this)
    
    have hdef : ∀ P ∈ U c, ∀ Q ∈ U c, ValuativeRel.valuation F
        (affinePointZCoord (P + Q) - affinePointZCoord P - affinePointZCoord Q) ≤
        ValuativeRel.valuation F c ^ 3 := by
      intro P hP Q hQ
      cases P with
      | zero =>
        have e : (WeierstrassCurve.Affine.Point.zero :
            (threeRootsCurve t₁ t₂ t₃).toAffine.Point) + Q = Q := zero_add Q
        rw [e]
        have e2 : affinePointZCoord Q - affinePointZCoord (WeierstrassCurve.Affine.Point.zero :
            (threeRootsCurve t₁ t₂ t₃).toAffine.Point) - affinePointZCoord Q = 0 := by
          show affinePointZCoord Q - 0 - affinePointZCoord Q = 0
          ring
        rw [e2, map_zero]; exact zero_le'
      | @some x₁ y₁ h₁ =>
        cases Q with
        | zero =>
          have e : WeierstrassCurve.Affine.Point.some h₁ + (WeierstrassCurve.Affine.Point.zero :
              (threeRootsCurve t₁ t₂ t₃).toAffine.Point) = WeierstrassCurve.Affine.Point.some h₁ :=
            add_zero _
          rw [e]
          have e2 : affinePointZCoord (WeierstrassCurve.Affine.Point.some h₁) -
              affinePointZCoord (WeierstrassCurve.Affine.Point.some h₁) -
              affinePointZCoord (WeierstrassCurve.Affine.Point.zero :
                (threeRootsCurve t₁ t₂ t₃).toAffine.Point) = 0 := by
            show x₁ / y₁ - x₁ / y₁ - 0 = 0
            ring
          rw [e2, map_zero]; exact zero_le'
        | @some x₂ y₂ h₂ =>
          obtain ⟨hx₁, hz₁⟩ := ((hval h₁).2.2 c hc).mp ((hU c hc _).mp hP x₁ y₁ h₁ rfl)
          obtain ⟨hx₂, hz₂⟩ := ((hval h₂).2.2 c hc).mp ((hU c hc _).mp hQ x₂ y₂ h₂ rfl)
          cases hS : WeierstrassCurve.Affine.Point.some h₁ + WeierstrassCurve.Affine.Point.some h₂ with
          | zero =>
            have hneg : WeierstrassCurve.Affine.Point.some h₂ =
                -WeierstrassCurve.Affine.Point.some h₁ :=
              eq_neg_of_add_eq_zero_right hS
            rw [WeierstrassCurve.Affine.Point.neg_some, WeierstrassCurve.Affine.Point.some.injEq]
              at hneg
            obtain ⟨hx₂₁, hy₂₁⟩ := hneg
            have e2 : affinePointZCoord (WeierstrassCurve.Affine.Point.zero :
                (threeRootsCurve t₁ t₂ t₃).toAffine.Point) -
                affinePointZCoord (WeierstrassCurve.Affine.Point.some h₁) -
                affinePointZCoord (WeierstrassCurve.Affine.Point.some h₂) = 0 := by
              show 0 - x₁ / y₁ - x₂ / y₂ = 0
              rw [hx₂₁, hy₂₁]
              show 0 - x₁ / y₁ - x₁ / (-y₁ - 0 * x₁ - 0) = 0
              rw [zero_mul, sub_zero, sub_zero, div_neg]
              ring
            rw [e2, map_zero]; exact zero_le'
          | @some x₃ y₃ h₃ =>
            have est := (threeRootsCurve_add_z_estimate t₁ t₂ t₃ ht₁ ht₂ ht₃ h₁ h₂ h₃ hx₁ hx₂
              hS).2
            show ValuativeRel.valuation F (x₃ / y₃ - x₁ / y₁ - x₂ / y₂) ≤ _
            exact le_trans est (pow_le_pow_left₀ zero_le' (max_le hz₁ hz₂) 3)
    
    let r : U c → (ValuativeRel.valuation F).integer := fun P => ⟨affinePointZCoord P.1 / c, hO P⟩
    have hadd : ∀ P Q : U c, IsLocalRing.residue _ (r (P + Q)) =
        IsLocalRing.residue _ (r P) + IsLocalRing.residue _ (r Q) := by
      intro P Q
      have hd := hdef P.1 P.2 Q.1 Q.2
      have hlt : ValuativeRel.valuation F
          ((r (P + Q) - r P - r Q : (ValuativeRel.valuation F).integer) : F) < 1 := by
        show ValuativeRel.valuation F (affinePointZCoord (P.1 + Q.1) / c -
          affinePointZCoord P.1 / c - affinePointZCoord Q.1 / c) < 1
        rw [← sub_div, ← sub_div]
        by_contra hge
        push_neg at hge
        have h1 : ValuativeRel.valuation F c ≤ ValuativeRel.valuation F c ^ 3 := by
          calc ValuativeRel.valuation F c = 1 * ValuativeRel.valuation F c := (one_mul _).symm
            _ ≤ ValuativeRel.valuation F ((affinePointZCoord (P.1 + Q.1) - affinePointZCoord P.1 -
                  affinePointZCoord Q.1) / c) * ValuativeRel.valuation F c :=
                mul_le_mul_right' hge _
            _ = ValuativeRel.valuation F (affinePointZCoord (P.1 + Q.1) - affinePointZCoord P.1 -
                  affinePointZCoord Q.1) := by rw [← map_mul, div_mul_cancel₀ _ hc0]
            _ ≤ _ := hd
        have h2 : ValuativeRel.valuation F c ^ 3 < ValuativeRel.valuation F c := by
          calc ValuativeRel.valuation F c ^ 3 =
                ValuativeRel.valuation F c ^ 2 * ValuativeRel.valuation F c := pow_succ _ 2
            _ < 1 * ValuativeRel.valuation F c :=
                mul_lt_mul_of_pos_right (pow_lt_one₀ zero_le' hc two_ne_zero) (zero_lt_iff.mpr hVc0)
            _ = _ := one_mul _
        exact absurd (lt_of_le_of_lt h1 h2) (lt_irrefl _)
      have h0 := (hRZ _).mpr hlt
      rw [map_sub, map_sub, sub_sub, sub_eq_zero] at h0
      exact h0
    let φ : U c →+ IsLocalRing.ResidueField (ValuativeRel.valuation F).integer :=
      AddMonoidHom.mk' (fun P => IsLocalRing.residue _ (r P)) hadd
    
    have hker : φ.ker ≤ (U (ϖ * c)).addSubgroupOf (U c) := by
      intro P hP
      rw [AddMonoidHom.mem_ker] at hP
      have hlt : ValuativeRel.valuation F (affinePointZCoord P.1 / c) < 1 := (hRZ (r P)).mp hP
      have hle : ValuativeRel.valuation F (affinePointZCoord P.1) ≤
          ValuativeRel.valuation F (ϖ * c) := by
        calc ValuativeRel.valuation F (affinePointZCoord P.1) =
              ValuativeRel.valuation F (affinePointZCoord P.1 / c) * ValuativeRel.valuation F c := by
              rw [← map_mul, div_mul_cancel₀ _ hc0]
          _ ≤ ValuativeRel.valuation F ϖ * ValuativeRel.valuation F c :=
              mul_le_mul_right' (hϖ _ hlt) _
          _ = _ := (map_mul _ _ _).symm
      rw [AddSubgroup.mem_addSubgroupOf, hU (ϖ * c) hϖc]
      intro x y h hPeq
      have hPc := P.2
      rw [hPeq] at hPc hle
      obtain ⟨hx, -⟩ := ((hval h).2.2 c hc).mp ((hU c hc _).mp hPc x y h rfl)
      exact ((hval h).2.2 (ϖ * c) hϖc).mpr ⟨hx, hle⟩
    
    have hfin : φ.ker.index ≠ 0 := by
      rw [AddSubgroup.index_ker]
      exact Nat.card_ne_zero.mpr ⟨inferInstance, inferInstance⟩
    show ((U (ϖ * c)).addSubgroupOf (U c)).index ≠ 0
    exact ne_zero_of_dvd_ne_zero hfin (AddSubgroup.index_dvd_of_le hker)
  
  obtain ⟨n, hn, hVc⟩ : ∃ n : ℕ, 1 ≤ n ∧
      ValuativeRel.valuation F c = ValuativeRel.valuation F ϖ ^ n := by
    have hϖne : ValuativeRel.valuation F ϖ ≠ 0 := (Valuation.ne_zero_iff _).mpr hϖ0
    have hmax : IsLocalRing.maximalIdeal (ValuativeRel.valuation F).integer =
        Ideal.span {(⟨ϖ, hϖ1.le⟩ : (ValuativeRel.valuation F).integer)} := by
      apply le_antisymm
      · intro b hb
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hunit] at hb
        have hb1 : ValuativeRel.valuation F (b : F) < 1 := lt_of_le_of_ne b.2 hb
        have hbϖ := hϖ _ hb1
        have ha : (b : F) / ϖ ∈ (ValuativeRel.valuation F).integer := by
          show ValuativeRel.valuation F ((b : F) / ϖ) ≤ 1
          by_contra hgt
          push_neg at hgt
          have : ValuativeRel.valuation F ϖ < ValuativeRel.valuation F (b : F) := by
            calc ValuativeRel.valuation F ϖ = 1 * ValuativeRel.valuation F ϖ := (one_mul _).symm
              _ < ValuativeRel.valuation F ((b : F) / ϖ) * ValuativeRel.valuation F ϖ :=
                  mul_lt_mul_of_pos_right hgt (zero_lt_iff.mpr hϖne)
              _ = _ := by rw [← map_mul, div_mul_cancel₀ _ hϖ0]
          exact absurd hbϖ (not_le.mpr this)
        rw [Ideal.mem_span_singleton']
        exact ⟨⟨(b : F) / ϖ, ha⟩, Subtype.ext (div_mul_cancel₀ _ hϖ0)⟩
      · rw [Ideal.span_singleton_le_iff_mem, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hunit]
        exact ne_of_lt hϖ1
    have hirr := (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr hmax
    have hc' : (⟨c, hc.le⟩ : (ValuativeRel.valuation F).integer) ≠ 0 :=
      fun h => hc0 (congrArg Subtype.val h)
    obtain ⟨n, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hc' hirr
    have hcF : c = ((u : (ValuativeRel.valuation F).integer) : F) * ϖ ^ n := by
      have := congrArg Subtype.val hu
      simpa using this
    have hu1 : ValuativeRel.valuation F ((u : (ValuativeRel.valuation F).integer) : F) = 1 :=
      (hunit _).mp u.isUnit
    have hVc : ValuativeRel.valuation F c = ValuativeRel.valuation F ϖ ^ n := by
      rw [hcF, map_mul, map_pow, hu1, one_mul]
    refine ⟨n, Nat.one_le_iff_ne_zero.mpr ?_, hVc⟩
    rintro rfl
    rw [pow_zero] at hVc
    exact absurd hVc (ne_of_lt hc)
  
  have hpow : ∀ k : ℕ, 1 ≤ k → (U (ϖ ^ k)).relIndex (U ϖ) ≠ 0 := by
    intro k hk
    induction k, hk using Nat.le_induction with
    | base => rw [pow_one, AddSubgroup.relIndex_self]; exact one_ne_zero
    | succ k hk ih =>
      have hk0 : ϖ ^ k ≠ 0 := pow_ne_zero k hϖ0
      have hk1 : ValuativeRel.valuation F (ϖ ^ k) < 1 := by
        rw [map_pow]; exact pow_lt_one₀ zero_le' hϖ1 (by omega)
      have := step (ϖ ^ k) hk0 hk1
      rw [← pow_succ'] at this
      exact AddSubgroup.relIndex_ne_zero_trans this ih
  have hUc : U c = U (ϖ ^ n) := by
    have hpn : ValuativeRel.valuation F (ϖ ^ n) < 1 := by rw [map_pow, ← hVc]; exact hc
    ext P
    rw [hU c hc, hU (ϖ ^ n) hpn]
    have hx : ∀ x : F, ValuativeRel.valuation F (c ^ 2 * x) =
        ValuativeRel.valuation F ((ϖ ^ n) ^ 2 * x) := by
      intro x; rw [map_mul, map_mul, map_pow, map_pow, hVc, map_pow]
    simp only [hx]
  rw [hUc]
  exact hpow n hn

theorem threeRootsCurve_filtration_comap_two (F : Type*) [Field F] [ValuativeRel F] [CharZero F]
    [DecidableEq F] (t₁ t₂ t₃ : F) (ht₁ : ValuativeRel.valuation F t₁ ≤ 1)
    (ht₂ : ValuativeRel.valuation F t₂ ≤ 1) (ht₃ : ValuativeRel.valuation F t₃ ≤ 1)
    (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃)
    (U : F → AddSubgroup (threeRootsCurve t₁ t₂ t₃).toAffine.Point)
    (hU : ∀ c : F, ValuativeRel.valuation F c < 1 → ∀ P, P ∈ U c ↔
      ∀ (x y : F) (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y),
        P = WeierstrassCurve.Affine.Point.some h → 1 ≤ ValuativeRel.valuation F (c ^ 2 * x))
    (c : F) (hc0 : c ≠ 0)
    (hc : ValuativeRel.valuation F c <
      ValuativeRel.valuation F ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) ^ 2) :
    (U (2 * c)).comap (nsmulAddMonoidHom 2 : (threeRootsCurve t₁ t₂ t₃).toAffine.Point →+
        (threeRootsCurve t₁ t₂ t₃).toAffine.Point) =
      (nsmulAddMonoidHom 2 : (threeRootsCurve t₁ t₂ t₃).toAffine.Point →+
        (threeRootsCurve t₁ t₂ t₃).toAffine.Point).ker ⊔ U c :=
by
  have h2 : (2 : F) ≠ 0 := two_ne_zero
  have h4 : (4 : F) ≠ 0 := by
    rw [show (4 : F) = 2 * 2 by norm_num]; exact mul_ne_zero h2 h2
  
  have heqn : ∀ {x y : F}, (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y →
      y ^ 2 = x ^ 3 - (t₁ + t₂ + t₃) * x ^ 2 + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) * x
        - t₁ * t₂ * t₃ := by
    intro x y h
    have := h.1
    rw [WeierstrassCurve.Affine.equation_iff] at this
    simp only [threeRootsCurve] at this
    linear_combination this
  
  have dbl : ∀ {x y : F} (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y), y ≠ 0 →
      ∃ (x' y' : F) (h' : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x' y'),
        2 • WeierstrassCurve.Affine.Point.some h = WeierstrassCurve.Affine.Point.some h' ∧
        4 * y ^ 2 * x' = x ^ 4 - 2 * (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) * x ^ 2 +
          8 * (t₁ * t₂ * t₃) * x + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) ^ 2 -
          4 * (t₁ + t₂ + t₃) * (t₁ * t₂ * t₃) := by
    intro x y h hy
    have hneg : (threeRootsCurve t₁ t₂ t₃).toAffine.negY x y = -y := by
      simp [WeierstrassCurve.Affine.negY, threeRootsCurve]
    have hy' : y ≠ (threeRootsCurve t₁ t₂ t₃).toAffine.negY x y := by
      rw [hneg]
      intro hc
      apply hy
      have : (2 : F) * y = 0 := by linear_combination hc
      exact (mul_eq_zero.mp this).resolve_left h2
    have heq := heqn h
    refine ⟨_, _, _, by rw [two_nsmul]; exact WeierstrassCurve.Affine.Point.add_self_of_Y_ne hy',
      ?_⟩
    rw [WeierstrassCurve.Affine.slope_of_Y_ne rfl hy', hneg]
    simp only [WeierstrassCurve.Affine.addX, threeRootsCurve]
    rw [show y - -y = 2 * y by ring]
    have hℓ : ∀ n : F, 2 * y * (n / (2 * y)) = n := fun n => by field_simp
    linear_combination (2 * y * ((3 * x ^ 2 + 2 * -(t₁ + t₂ + t₃) * x +
      (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) - 0 * y) / (2 * y)) + (3 * x ^ 2 + 2 * -(t₁ + t₂ + t₃) * x +
      (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) - 0 * y)) * hℓ (3 * x ^ 2 + 2 * -(t₁ + t₂ + t₃) * x +
      (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) - 0 * y) + (4 * ((t₁ + t₂ + t₃) - 2 * x)) * heq
  
  have trans : ∀ (r : F) (hr : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular r 0) {x y : F}
      (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y), y ≠ 0 →
      ∃ (x'' y'' : F) (h'' : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x'' y''),
        WeierstrassCurve.Affine.Point.some h + WeierstrassCurve.Affine.Point.some hr =
          WeierstrassCurve.Affine.Point.some h'' ∧
        (x'' - r) * (x - r) =
          3 * r ^ 2 - 2 * (t₁ + t₂ + t₃) * r + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) := by
    intro r hr x y h hy
    have heq := heqn h
    have hfr := heqn hr
    have hx : x ≠ r := by
      rintro rfl
      apply hy
      have : y ^ 2 = 0 := by linear_combination heq - hfr
      exact pow_eq_zero_iff two_ne_zero |>.mp this
    have hxr : x - r ≠ 0 := sub_ne_zero.mpr hx
    refine ⟨_, _, _, WeierstrassCurve.Affine.Point.add_of_X_ne hx, ?_⟩
    rw [WeierstrassCurve.Affine.slope_of_X_ne hx]
    simp only [WeierstrassCurve.Affine.addX, threeRootsCurve]
    field_simp
    linear_combination heq - hfr
  
  have hv2 : ValuativeRel.valuation F 2 ≤ 1 := by
    rw [← one_add_one_eq_two]
    exact Valuation.map_add_le _ (map_one _).le (map_one _).le
  have hv4 : ValuativeRel.valuation F 4 ≤ 1 := by
    rw [show (4 : F) = 2 * 2 by norm_num, map_mul]; exact mul_le_one' hv2 hv2
  have hv8 : ValuativeRel.valuation F 8 ≤ 1 := by
    rw [show (8 : F) = 2 * 4 by norm_num, map_mul]; exact mul_le_one' hv2 hv4
  have hs₁ : ValuativeRel.valuation F (t₁ + t₂ + t₃) ≤ 1 :=
    Valuation.map_add_le _ (Valuation.map_add_le _ ht₁ ht₂) ht₃
  have hs₂ : ValuativeRel.valuation F (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) ≤ 1 := by
    refine Valuation.map_add_le _ (Valuation.map_add_le _ ?_ ?_) ?_ <;> rw [map_mul] <;>
      exact mul_le_one' (by assumption) (by assumption)
  have hs₃ : ValuativeRel.valuation F (t₁ * t₂ * t₃) ≤ 1 := by
    rw [map_mul, map_mul]; exact mul_le_one' (mul_le_one' ht₁ ht₂) ht₃
  
  have polyN : ∀ x : F, (1 < ValuativeRel.valuation F x →
      ValuativeRel.valuation F (x ^ 4 - 2 * (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) * x ^ 2 +
        8 * (t₁ * t₂ * t₃) * x + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) ^ 2 -
        4 * (t₁ + t₂ + t₃) * (t₁ * t₂ * t₃)) = ValuativeRel.valuation F x ^ 4) ∧
      (ValuativeRel.valuation F x ≤ 1 →
      ValuativeRel.valuation F (x ^ 4 - 2 * (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) * x ^ 2 +
        8 * (t₁ * t₂ * t₃) * x + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) ^ 2 -
        4 * (t₁ + t₂ + t₃) * (t₁ * t₂ * t₃)) ≤ 1) := by
    intro x
    constructor
    · intro hx
      have hX1 : 1 ≤ ValuativeRel.valuation F x := hx.le
      have hX2 : 1 ≤ ValuativeRel.valuation F x ^ 2 := one_le_pow₀ hX1
      have hXX : ValuativeRel.valuation F x ≤ ValuativeRel.valuation F x ^ 2 := by
        rw [sq]; exact le_mul_of_one_le_right' hX1
      have hR : ValuativeRel.valuation F (- (2 * (t₁ * t₂ + t₁ * t₃ + t₂ * t₃)) * x ^ 2 +
          8 * (t₁ * t₂ * t₃) * x + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) ^ 2 -
          4 * (t₁ + t₂ + t₃) * (t₁ * t₂ * t₃)) ≤ ValuativeRel.valuation F x ^ 2 := by
        refine Valuation.map_sub_le _ (Valuation.map_add_le _ (Valuation.map_add_le _ ?_ ?_) ?_) ?_
        · rw [map_mul, Valuation.map_neg, map_mul, map_pow]
          exact mul_le_of_le_one_left' (mul_le_one' hv2 hs₂)
        · rw [map_mul, map_mul]
          exact le_trans (mul_le_of_le_one_left' (mul_le_one' hv8 hs₃)) hXX
        · rw [map_pow]; exact le_trans (pow_le_one' hs₂ 2) hX2
        · rw [map_mul, map_mul]
          exact le_trans (mul_le_one' (mul_le_one' hv4 hs₁) hs₃) hX2
      have hlt : ValuativeRel.valuation F x ^ 2 < ValuativeRel.valuation F x ^ 4 :=
        pow_lt_pow_right₀ hx (by norm_num)
      have e : x ^ 4 - 2 * (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) * x ^ 2 + 8 * (t₁ * t₂ * t₃) * x +
          (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) ^ 2 - 4 * (t₁ + t₂ + t₃) * (t₁ * t₂ * t₃) =
          x ^ 4 + (- (2 * (t₁ * t₂ + t₁ * t₃ + t₂ * t₃)) * x ^ 2 + 8 * (t₁ * t₂ * t₃) * x +
          (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) ^ 2 - 4 * (t₁ + t₂ + t₃) * (t₁ * t₂ * t₃)) := by ring
      rw [e, Valuation.map_add_eq_of_lt_left, map_pow]
      rw [map_pow]
      exact lt_of_le_of_lt hR hlt
    · intro hx
      refine Valuation.map_sub_le _ (Valuation.map_add_le _ (Valuation.map_add_le _
        (Valuation.map_sub_le _ ?_ ?_) ?_) ?_) ?_
      · rw [map_pow]; exact pow_le_one' hx 4
      · rw [map_mul, map_mul, map_pow]
        exact mul_le_one' (mul_le_one' hv2 hs₂) (pow_le_one' hx 2)
      · rw [map_mul, map_mul]
        exact mul_le_one' (mul_le_one' hv8 hs₃) hx
      · rw [map_pow]; exact pow_le_one' hs₂ 2
      · rw [map_mul, map_mul]
        exact mul_le_one' (mul_le_one' hv4 hs₁) hs₃
  
  have transl : ∀ (x x₁ x₂ x₃ : F), ValuativeRel.valuation F x₁ ≤ 1 →
      ValuativeRel.valuation F x₂ ≤ 1 → ValuativeRel.valuation F x₃ ≤ 1 →
      (x₁ - t₁) * (x - t₁) = (t₁ - t₂) * (t₁ - t₃) →
      (x₂ - t₂) * (x - t₂) = (t₂ - t₁) * (t₂ - t₃) →
      (x₃ - t₃) * (x - t₃) = (t₃ - t₁) * (t₃ - t₂) →
      ValuativeRel.valuation F ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) ^ 2 ≤
        ValuativeRel.valuation F ((x - t₁) * (x - t₂) * (x - t₃)) := by
    intro x x₁ x₂ x₃ hx₁ hx₂ hx₃ e₁ e₂ e₃
    have key : ∀ a b t A : F, ValuativeRel.valuation F a ≤ 1 → ValuativeRel.valuation F t ≤ 1 →
        (a - t) * (b - t) = A → ValuativeRel.valuation F A ≤ ValuativeRel.valuation F (b - t) := by
      intro a b t A ha ht hA
      rw [← hA, map_mul]
      exact mul_le_of_le_one_left' (le_trans (Valuation.map_sub _ _ _) (max_le ha ht))
    have k1 := key _ _ _ _ hx₁ ht₁ e₁
    have k2 := key _ _ _ _ hx₂ ht₂ e₂
    have k3 := key _ _ _ _ hx₃ ht₃ e₃
    have hprod := mul_le_mul' (mul_le_mul' k1 k2) k3
    rw [← map_mul, ← map_mul, ← map_mul, ← map_mul] at hprod
    have e : (t₁ - t₂) * (t₁ - t₃) * ((t₂ - t₁) * (t₂ - t₃)) * ((t₃ - t₁) * (t₃ - t₂)) =
        -(((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) ^ 2) := by ring
    rw [e, Valuation.map_neg, map_pow] at hprod
    exact hprod
  
  have E1 : ∀ {x y : F} (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y),
      1 < ValuativeRel.valuation F x →
      ∃ (x' y' : F) (h' : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x' y'),
        2 • WeierstrassCurve.Affine.Point.some h = WeierstrassCurve.Affine.Point.some h' ∧
        ValuativeRel.valuation F (4 * x') = ValuativeRel.valuation F x := by
    intro x y h hx
    have hsubx : ∀ t : F, ValuativeRel.valuation F t ≤ 1 →
        ValuativeRel.valuation F (x - t) = ValuativeRel.valuation F x := by
      intro t ht
      rw [sub_eq_add_neg, Valuation.map_add_eq_of_lt_left]
      rw [Valuation.map_neg]
      exact lt_of_le_of_lt ht hx
    have hy2 : ValuativeRel.valuation F y ^ 2 = ValuativeRel.valuation F x ^ 3 := by
      rw [← map_pow, heqn h,
        show x ^ 3 - (t₁ + t₂ + t₃) * x ^ 2 + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) * x - t₁ * t₂ * t₃ =
          (x - t₁) * (x - t₂) * (x - t₃) by ring,
        map_mul, map_mul, hsubx t₁ ht₁, hsubx t₂ ht₂, hsubx t₃ ht₃,
        show (3 : ℕ) = 1 + 1 + 1 from rfl, pow_add, pow_add, pow_one]
    have hX0 : ValuativeRel.valuation F x ≠ 0 := ne_of_gt (lt_trans zero_lt_one hx)
    have hX3 : ValuativeRel.valuation F x ^ 3 ≠ 0 := pow_ne_zero 3 hX0
    have hy : y ≠ 0 := by
      rintro rfl
      rw [map_zero, zero_pow two_ne_zero] at hy2
      exact hX3 hy2.symm
    obtain ⟨x', y', h', hd, hN⟩ := dbl h hy
    refine ⟨x', y', h', hd, ?_⟩
    have hv := congrArg (ValuativeRel.valuation F) hN
    rw [(polyN x).1 hx, show 4 * y ^ 2 * x' = (4 * x') * y ^ 2 by ring, map_mul, map_pow,
      hy2] at hv
    apply mul_right_cancel₀ hX3
    rw [hv, show (4 : ℕ) = 1 + 3 from rfl, pow_add, pow_one]
  
  have memU : ∀ c' : F, ValuativeRel.valuation F c' < 1 → ∀ {x y : F}
      (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y),
      WeierstrassCurve.Affine.Point.some h ∈ U c' ↔ 1 ≤ ValuativeRel.valuation F (c' ^ 2 * x) := by
    intro c' hc' x y h
    rw [hU c' hc']
    constructor
    · intro H; exact H x y h rfl
    · intro H x₀ y₀ h₀ heq
      simp only [WeierstrassCurve.Affine.Point.some.injEq] at heq
      obtain ⟨rfl, rfl⟩ := heq
      exact H
  
  have hsub : ∀ a b : F, ValuativeRel.valuation F a ≤ 1 → ValuativeRel.valuation F b ≤ 1 →
      ValuativeRel.valuation F (a - b) ≤ 1 := fun a b ha hb =>
    le_trans (Valuation.map_sub _ _ _) (max_le ha hb)
  have hVD : ValuativeRel.valuation F ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) ≤ 1 := by
    rw [map_mul, map_mul]
    exact mul_le_one' (mul_le_one' (hsub _ _ ht₁ ht₂) (hsub _ _ ht₁ ht₃)) (hsub _ _ ht₂ ht₃)
  have hVD2 : ValuativeRel.valuation F ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) ^ 2 ≤
      ValuativeRel.valuation F ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) := by
    rw [sq]; exact mul_le_of_le_one_right' hVD
  have hcD : ValuativeRel.valuation F c <
      ValuativeRel.valuation F ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) := lt_of_lt_of_le hc hVD2
  have hc1 : ValuativeRel.valuation F c < 1 := lt_of_lt_of_le hcD hVD
  have h2c1 : ValuativeRel.valuation F (2 * c) < 1 := by
    rw [map_mul]
    exact lt_of_le_of_lt (mul_le_of_le_one_left' hv2) hc1
  
  have crit : ∀ {x y : F} (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y),
      1 < ValuativeRel.valuation F x →
      (2 • WeierstrassCurve.Affine.Point.some h ∈ U (2 * c) ↔
        WeierstrassCurve.Affine.Point.some h ∈ U c) := by
    intro x y h hx
    obtain ⟨x', y', h', hd, hv'⟩ := E1 h hx
    rw [hd, memU _ h2c1, memU _ hc1]
    have e : ValuativeRel.valuation F ((2 * c) ^ 2 * x') = ValuativeRel.valuation F (c ^ 2 * x) := by
      rw [show (2 * c) ^ 2 * x' = c ^ 2 * (4 * x') by ring, map_mul, hv', ← map_mul]
    rw [e]
  
  have inE1 : ∀ x : F, 1 ≤ ValuativeRel.valuation F (c ^ 2 * x) → 1 < ValuativeRel.valuation F x := by
    intro x hx
    by_contra hle
    push_neg at hle
    rw [map_mul, map_pow] at hx
    have : ValuativeRel.valuation F c ^ 2 * ValuativeRel.valuation F x < 1 :=
      lt_of_le_of_lt (mul_le_of_le_one_right' hle) (pow_lt_one₀ zero_le' hc1 two_ne_zero)
    exact absurd (lt_of_le_of_lt hx this) (lt_irrefl 1)
  
  have tors : ∀ {x₀ : F} (h₀ : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x₀ 0),
      2 • WeierstrassCurve.Affine.Point.some h₀ = 0 := by
    intro x₀ h₀
    rw [two_nsmul]
    exact WeierstrassCurve.Affine.Point.add_of_Y_eq rfl
      (by simp [WeierstrassCurve.Affine.negY, threeRootsCurve])
  have hTgen : ∀ r : F, (r - t₁) * (r - t₂) * (r - t₃) = 0 →
      3 * r ^ 2 - 2 * (t₁ + t₂ + t₃) * r + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) ≠ 0 →
      (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular r 0 := by
    intro r hr hd
    rw [WeierstrassCurve.Affine.nonsingular_iff, WeierstrassCurve.Affine.equation_iff]
    simp only [threeRootsCurve]
    refine ⟨by linear_combination -hr, Or.inl ?_⟩
    intro hh; apply hd; linear_combination -hh
  have d12 : t₁ - t₂ ≠ 0 := sub_ne_zero.mpr h₁₂
  have d13 : t₁ - t₃ ≠ 0 := sub_ne_zero.mpr h₁₃
  have d23 : t₂ - t₃ ≠ 0 := sub_ne_zero.mpr h₂₃
  have f1 : 3 * t₁ ^ 2 - 2 * (t₁ + t₂ + t₃) * t₁ + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) =
      (t₁ - t₂) * (t₁ - t₃) := by ring
  have f2 : 3 * t₂ ^ 2 - 2 * (t₁ + t₂ + t₃) * t₂ + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) =
      (t₂ - t₁) * (t₂ - t₃) := by ring
  have f3 : 3 * t₃ ^ 2 - 2 * (t₁ + t₂ + t₃) * t₃ + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) =
      (t₃ - t₁) * (t₃ - t₂) := by ring
  have hT₁ : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular t₁ 0 :=
    hTgen t₁ (by ring) (by rw [f1]; exact mul_ne_zero d12 d13)
  have hT₂ : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular t₂ 0 :=
    hTgen t₂ (by ring) (by
      rw [f2]; exact mul_ne_zero (sub_ne_zero.mpr (Ne.symm h₁₂)) d23)
  have hT₃ : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular t₃ 0 :=
    hTgen t₃ (by ring) (by
      rw [f3]; exact mul_ne_zero (sub_ne_zero.mpr (Ne.symm h₁₃)) (sub_ne_zero.mpr (Ne.symm h₂₃)))
  apply le_antisymm
  · 
    intro P hP
    rw [AddSubgroup.mem_comap, nsmulAddMonoidHom_apply] at hP
    cases P with
    | zero => exact zero_mem _
    | @some x y h =>
      by_cases hy : y = 0
      · subst hy
        exact AddSubgroup.mem_sup_left (by
          rw [AddMonoidHom.mem_ker, nsmulAddMonoidHom_apply]; exact tors h)
      by_cases hx : 1 < ValuativeRel.valuation F x
      · exact AddSubgroup.mem_sup_right ((crit h hx).mp hP)
      push_neg at hx
      have key : ∀ (r : F) (hr : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular r 0) {x'' y'' : F}
          (h'' : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x'' y''),
          WeierstrassCurve.Affine.Point.some h + WeierstrassCurve.Affine.Point.some hr =
            WeierstrassCurve.Affine.Point.some h'' →
          1 < ValuativeRel.valuation F x'' →
          WeierstrassCurve.Affine.Point.some h ∈
            (nsmulAddMonoidHom 2 : (threeRootsCurve t₁ t₂ t₃).toAffine.Point →+
              (threeRootsCurve t₁ t₂ t₃).toAffine.Point).ker ⊔ U c := by
        intro r hr x'' y'' h'' hadd hx''
        have h2Q : 2 • WeierstrassCurve.Affine.Point.some h'' =
            2 • WeierstrassCurve.Affine.Point.some h := by
          rw [← hadd, nsmul_add, tors hr, add_zero]
        have hQ : WeierstrassCurve.Affine.Point.some h'' ∈ U c :=
          (crit h'' hx'').mp (by rw [h2Q]; exact hP)
        have hTk : WeierstrassCurve.Affine.Point.some hr ∈
            (nsmulAddMonoidHom 2 : (threeRootsCurve t₁ t₂ t₃).toAffine.Point →+
              (threeRootsCurve t₁ t₂ t₃).toAffine.Point).ker := by
          rw [AddMonoidHom.mem_ker, nsmulAddMonoidHom_apply]; exact tors hr
        have e : -WeierstrassCurve.Affine.Point.some hr + WeierstrassCurve.Affine.Point.some h'' =
            WeierstrassCurve.Affine.Point.some h := by
          rw [← hadd]; abel
        rw [← e]
        exact AddSubgroup.add_mem_sup (neg_mem hTk) hQ
      obtain ⟨x₁, y₁, h₁, hadd₁, e₁⟩ := trans t₁ hT₁ h hy
      obtain ⟨x₂, y₂, h₂, hadd₂, e₂⟩ := trans t₂ hT₂ h hy
      obtain ⟨x₃, y₃, h₃, hadd₃, e₃⟩ := trans t₃ hT₃ h hy
      by_cases g₁ : 1 < ValuativeRel.valuation F x₁
      · exact key _ _ h₁ hadd₁ g₁
      by_cases g₂ : 1 < ValuativeRel.valuation F x₂
      · exact key _ _ h₂ hadd₂ g₂
      by_cases g₃ : 1 < ValuativeRel.valuation F x₃
      · exact key _ _ h₃ hadd₃ g₃
      push_neg at g₁ g₂ g₃
      exfalso
      rw [f1] at e₁
      rw [f2] at e₂
      rw [f3] at e₃
      have hDf := transl x x₁ x₂ x₃ g₁ g₂ g₃ e₁ e₂ e₃
      have hyf : ValuativeRel.valuation F y ^ 2 =
          ValuativeRel.valuation F ((x - t₁) * (x - t₂) * (x - t₃)) := by
        rw [← map_pow, heqn h]; congr 1; ring
      obtain ⟨x', y', h', hd, hN⟩ := dbl h hy
      have h1 : 1 ≤ ValuativeRel.valuation F ((2 * c) ^ 2 * x') :=
        (memU _ h2c1 h').mp (by rw [← hd]; exact hP)
      have hNle := (polyN x).2 hx
      rw [← hN] at hNle
      have e1 : ValuativeRel.valuation F ((2 * c) ^ 2 * x') =
          ValuativeRel.valuation F c ^ 2 * ValuativeRel.valuation F (4 * x') := by
        rw [show (2 * c) ^ 2 * x' = c ^ 2 * (4 * x') by ring, map_mul, map_pow]
      have e2 : ValuativeRel.valuation F (4 * y ^ 2 * x') =
          ValuativeRel.valuation F (4 * x') * ValuativeRel.valuation F y ^ 2 := by
        rw [show 4 * y ^ 2 * x' = (4 * x') * y ^ 2 by ring, map_mul, map_pow]
      rw [e2] at hNle
      have hyc : ValuativeRel.valuation F y ^ 2 ≤ ValuativeRel.valuation F c ^ 2 := by
        calc ValuativeRel.valuation F y ^ 2
            ≤ ValuativeRel.valuation F ((2 * c) ^ 2 * x') * ValuativeRel.valuation F y ^ 2 :=
              le_mul_of_one_le_left' h1
          _ = ValuativeRel.valuation F c ^ 2 *
                (ValuativeRel.valuation F (4 * x') * ValuativeRel.valuation F y ^ 2) := by
              rw [e1, mul_assoc]
          _ ≤ ValuativeRel.valuation F c ^ 2 := mul_le_of_le_one_right' hNle
      have hle : ValuativeRel.valuation F ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) ^ 2 ≤
          ValuativeRel.valuation F c ^ 2 := le_trans hDf (hyf ▸ hyc)
      have hlt : ValuativeRel.valuation F c ^ 2 <
          ValuativeRel.valuation F ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) ^ 2 :=
        pow_lt_pow_left₀ hcD zero_le' two_ne_zero
      exact absurd (lt_of_le_of_lt hle hlt) (lt_irrefl _)
  · 
    refine sup_le ?_ ?_
    · intro P hP
      rw [AddMonoidHom.mem_ker] at hP
      rw [AddSubgroup.mem_comap, hP]
      exact zero_mem _
    · intro P hP
      rw [AddSubgroup.mem_comap, nsmulAddMonoidHom_apply]
      cases P with
      | zero =>
        show 2 • (0 : (threeRootsCurve t₁ t₂ t₃).toAffine.Point) ∈ U (2 * c)
        rw [smul_zero]
        exact zero_mem _
      | @some x y h =>
        have h1 := (memU _ hc1 h).mp hP
        exact (crit h (inE1 x h1)).mpr hP

theorem threeRootsCurve_two_torsion {F : Type*} [Field F] [DecidableEq F] (h2 : (2 : F) ≠ 0)
    (t₁ t₂ t₃ : F) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃) :
    Nat.card (nsmulAddMonoidHom 2 : (threeRootsCurve t₁ t₂ t₃).toAffine.Point →+
        (threeRootsCurve t₁ t₂ t₃).toAffine.Point).ker = 4 ∧
    ∀ (x y : F) (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y),
      2 • WeierstrassCurve.Affine.Point.some h = 0 → y = 0 ∧ (x = t₁ ∨ x = t₂ ∨ x = t₃) :=
by
  have hnegY : ∀ x y : F, (threeRootsCurve t₁ t₂ t₃).toAffine.negY x y = -y := by
    intro x y
    simp [WeierstrassCurve.Affine.negY, threeRootsCurve]
  have heq : ∀ x y : F, (threeRootsCurve t₁ t₂ t₃).toAffine.Equation x y ↔
      y ^ 2 = (x - t₁) * (x - t₂) * (x - t₃) := by
    intro x y
    rw [WeierstrassCurve.Affine.equation_iff]
    simp only [threeRootsCurve]
    constructor <;> intro h <;> linear_combination h
  
  have two_tors : ∀ (x y : F) (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y),
      2 • WeierstrassCurve.Affine.Point.some h = 0 → y = 0 ∧ (x = t₁ ∨ x = t₂ ∨ x = t₃) := by
    intro x y h h2P
    rw [two_nsmul] at h2P
    have hyeq : y = (threeRootsCurve t₁ t₂ t₃).toAffine.negY x y := by
      by_contra hy
      rw [WeierstrassCurve.Affine.Point.add_self_of_Y_ne hy] at h2P
      exact WeierstrassCurve.Affine.Point.some_ne_zero _ h2P
    rw [hnegY] at hyeq
    have hy0 : y = 0 := by
      have h2y : (2 : F) * y = 0 := by linear_combination hyeq
      exact (mul_eq_zero.mp h2y).resolve_left h2
    refine ⟨hy0, ?_⟩
    have hc := (heq x y).mp h.1
    rw [hy0] at hc
    have hprod : (x - t₁) * (x - t₂) * (x - t₃) = 0 := by rw [← hc]; ring
    rcases mul_eq_zero.mp hprod with h12 | h3
    · rcases mul_eq_zero.mp h12 with h1 | h2'
      · exact Or.inl (sub_eq_zero.mp h1)
      · exact Or.inr (Or.inl (sub_eq_zero.mp h2'))
    · exact Or.inr (Or.inr (sub_eq_zero.mp h3))
  
  have hT : ∀ s : F, (s - t₁) * (s - t₂) * (s - t₃) = 0 →
      3 * s ^ 2 - 2 * (t₁ + t₂ + t₃) * s + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) ≠ 0 →
      (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular s 0 := by
    intro s hs hd
    rw [WeierstrassCurve.Affine.nonsingular_iff, heq]
    refine ⟨by rw [hs]; ring, Or.inl ?_⟩
    intro h0
    apply hd
    simp only [threeRootsCurve] at h0
    linear_combination -h0
  have hd1 : 3 * t₁ ^ 2 - 2 * (t₁ + t₂ + t₃) * t₁ + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) ≠ 0 := by
    have e : 3 * t₁ ^ 2 - 2 * (t₁ + t₂ + t₃) * t₁ + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) =
        (t₁ - t₂) * (t₁ - t₃) := by ring
    rw [e]; exact mul_ne_zero (sub_ne_zero.mpr h₁₂) (sub_ne_zero.mpr h₁₃)
  have hd2 : 3 * t₂ ^ 2 - 2 * (t₁ + t₂ + t₃) * t₂ + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) ≠ 0 := by
    have e : 3 * t₂ ^ 2 - 2 * (t₁ + t₂ + t₃) * t₂ + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) =
        (t₂ - t₁) * (t₂ - t₃) := by ring
    rw [e]; exact mul_ne_zero (sub_ne_zero.mpr h₁₂.symm) (sub_ne_zero.mpr h₂₃)
  have hd3 : 3 * t₃ ^ 2 - 2 * (t₁ + t₂ + t₃) * t₃ + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) ≠ 0 := by
    have e : 3 * t₃ ^ 2 - 2 * (t₁ + t₂ + t₃) * t₃ + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) =
        (t₃ - t₁) * (t₃ - t₂) := by ring
    rw [e]; exact mul_ne_zero (sub_ne_zero.mpr h₁₃.symm) (sub_ne_zero.mpr h₂₃.symm)
  have hT₁ := hT t₁ (by ring) hd1
  have hT₂ := hT t₂ (by ring) hd2
  have hT₃ := hT t₃ (by ring) hd3
  have h2T : ∀ (s : F) (hs : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular s 0),
      2 • WeierstrassCurve.Affine.Point.some hs = 0 := by
    intro s hs
    rw [two_nsmul]
    exact WeierstrassCurve.Affine.Point.add_self_of_Y_eq (by rw [hnegY, neg_zero])
  
  have hker : ((nsmulAddMonoidHom 2 : (threeRootsCurve t₁ t₂ t₃).toAffine.Point →+
        (threeRootsCurve t₁ t₂ t₃).toAffine.Point).ker :
        Set (threeRootsCurve t₁ t₂ t₃).toAffine.Point) =
      {0, WeierstrassCurve.Affine.Point.some hT₁, WeierstrassCurve.Affine.Point.some hT₂,
        WeierstrassCurve.Affine.Point.some hT₃} := by
    ext P
    simp only [SetLike.mem_coe, AddMonoidHom.mem_ker, nsmulAddMonoidHom_apply,
      Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · intro hP
      cases P with
      | zero => exact Or.inl rfl
      | @some x y h =>
        obtain ⟨rfl, rfl | rfl | rfl⟩ := two_tors x y h hP
        · exact Or.inr (Or.inl rfl)
        · exact Or.inr (Or.inr (Or.inl rfl))
        · exact Or.inr (Or.inr (Or.inr rfl))
    · rintro (rfl | rfl | rfl | rfl)
      · exact smul_zero 2
      · exact h2T _ hT₁
      · exact h2T _ hT₂
      · exact h2T _ hT₃
  
  have n12 : WeierstrassCurve.Affine.Point.some hT₁ ≠ WeierstrassCurve.Affine.Point.some hT₂ := by
    intro e
    rw [WeierstrassCurve.Affine.Point.some.injEq] at e
    exact h₁₂ e.1
  have n13 : WeierstrassCurve.Affine.Point.some hT₁ ≠ WeierstrassCurve.Affine.Point.some hT₃ := by
    intro e
    rw [WeierstrassCurve.Affine.Point.some.injEq] at e
    exact h₁₃ e.1
  have n23 : WeierstrassCurve.Affine.Point.some hT₂ ≠ WeierstrassCurve.Affine.Point.some hT₃ := by
    intro e
    rw [WeierstrassCurve.Affine.Point.some.injEq] at e
    exact h₂₃ e.1
  have m1 : WeierstrassCurve.Affine.Point.some hT₁ ∉
      ({WeierstrassCurve.Affine.Point.some hT₂, WeierstrassCurve.Affine.Point.some hT₃} :
        Set (threeRootsCurve t₁ t₂ t₃).toAffine.Point) := by
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
    exact ⟨n12, n13⟩
  have m0 : (0 : (threeRootsCurve t₁ t₂ t₃).toAffine.Point) ∉
      ({WeierstrassCurve.Affine.Point.some hT₁, WeierstrassCurve.Affine.Point.some hT₂,
        WeierstrassCurve.Affine.Point.some hT₃} :
        Set (threeRootsCurve t₁ t₂ t₃).toAffine.Point) := by
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
    exact ⟨(WeierstrassCurve.Affine.Point.some_ne_zero hT₁).symm,
      (WeierstrassCurve.Affine.Point.some_ne_zero hT₂).symm,
      (WeierstrassCurve.Affine.Point.some_ne_zero hT₃).symm⟩
  have e1 := Set.ncard_insert_of_notMem m0
  have e2 := Set.ncard_insert_of_notMem m1
  have e3 := Set.ncard_pair n23
  refine ⟨?_, two_tors⟩
  rw [← SetLike.coe_sort_coe, Nat.card_coe_set_eq, hker]
  omega

theorem index_range_nsmul_two_eq_relIndex_comap {A : Type*} [AddCommGroup A] (U : AddSubgroup A)
    (hU : U.index ≠ 0) (hU2 : U ≤ (nsmulAddMonoidHom 2 : A →+ A).range) :
    (nsmulAddMonoidHom 2 : A →+ A).range.index =
      U.relIndex (U.comap (nsmulAddMonoidHom 2 : A →+ A)) :=
by
  have hUK : U ≤ U.comap (nsmulAddMonoidHom 2 : A →+ A) := by
    intro u hu
    rw [AddSubgroup.mem_comap, nsmulAddMonoidHom_apply]
    exact U.nsmul_mem hu 2
  have hK : (U.comap (nsmulAddMonoidHom 2 : A →+ A)).index =
      U.relIndex (nsmulAddMonoidHom 2 : A →+ A).range :=
    AddSubgroup.index_comap U (nsmulAddMonoidHom 2 : A →+ A)
  have e1 := AddSubgroup.relIndex_mul_index hU2
  have e2 := AddSubgroup.relIndex_mul_index hUK
  have hne : U.relIndex (nsmulAddMonoidHom 2 : A →+ A).range ≠ 0 := by
    intro h
    apply hU
    rw [← e1, h, zero_mul]
  rw [hK] at e2
  apply mul_right_cancel₀ hne
  rw [mul_comm, e1, e2]

theorem exists_two_nsmul_eq_some_of_sub_eq_sq {F : Type*} [Field F] [DecidableEq F]
    (h2 : (2 : F) ≠ 0) (t₁ t₂ t₃ : F) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃) {x₀ y₀ : F}
    (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x₀ y₀) (r₁ r₂ r₃ : F)
    (hr₁ : x₀ - t₁ = r₁ ^ 2) (hr₂ : x₀ - t₂ = r₂ ^ 2) (hr₃ : x₀ - t₃ = r₃ ^ 2) :
    ∃ Q : (threeRootsCurve t₁ t₂ t₃).toAffine.Point, 2 • Q = WeierstrassCurve.Affine.Point.some h :=
by
  have hy0 : y₀ ^ 2 = (r₁ * r₂ * r₃) ^ 2 := by
    have := h.1
    rw [WeierstrassCurve.Affine.equation_iff] at this
    simp only [threeRootsCurve] at this
    linear_combination this + (x₀ - t₂) * (x₀ - t₃) * hr₁ + r₁ ^ 2 * (x₀ - t₃) * hr₂ +
      r₁ ^ 2 * r₂ ^ 2 * hr₃
  obtain ⟨ρ, hρ, hyρ⟩ : ∃ ρ : F, x₀ - t₁ = ρ ^ 2 ∧ y₀ = ρ * r₂ * r₃ := by
    rcases sq_eq_sq_iff_eq_or_eq_neg.mp hy0 with h' | h'
    · exact ⟨r₁, hr₁, h'⟩
    · exact ⟨-r₁, by rw [hr₁]; ring, by rw [h']; ring⟩
  clear hy0 hr₁
  obtain rfl : t₁ = x₀ - ρ ^ 2 := by linear_combination -hρ
  obtain rfl : t₂ = x₀ - r₂ ^ 2 := by linear_combination -hr₂
  obtain rfl : t₃ = x₀ - r₃ ^ 2 := by linear_combination -hr₃
  subst hyρ
  have n12 : ρ + r₂ ≠ 0 := by
    intro hs
    apply h₁₂
    linear_combination (r₂ - ρ) * hs
  have n13 : ρ + r₃ ≠ 0 := by
    intro hs
    apply h₁₃
    linear_combination (r₃ - ρ) * hs
  have n23 : r₂ + r₃ ≠ 0 := by
    intro hs
    apply h₂₃
    linear_combination (r₃ - r₂) * hs
  obtain ⟨x, hx⟩ : ∃ x : F, x = x₀ + (ρ * r₂ + ρ * r₃ + r₂ * r₃) := ⟨_, rfl⟩
  obtain ⟨y, hy⟩ : ∃ y : F, y = (ρ + r₂) * (ρ + r₃) * (r₂ + r₃) := ⟨_, rfl⟩
  have hy0 : y ≠ 0 := by
    rw [hy]; exact mul_ne_zero (mul_ne_zero n12 n13) n23
  have h2y : 2 * y ≠ 0 := mul_ne_zero h2 hy0
  have hQ : (threeRootsCurve (x₀ - ρ ^ 2) (x₀ - r₂ ^ 2) (x₀ - r₃ ^ 2)).toAffine.Nonsingular x y := by
    rw [WeierstrassCurve.Affine.nonsingular_iff']
    refine ⟨?_, Or.inr ?_⟩
    · rw [WeierstrassCurve.Affine.equation_iff]
      simp only [threeRootsCurve]
      rw [hx, hy]; ring
    · simp only [threeRootsCurve]
      intro h'
      apply h2y
      linear_combination h'
  have hyne : y ≠ (threeRootsCurve (x₀ - ρ ^ 2) (x₀ - r₂ ^ 2) (x₀ - r₃ ^ 2)).toAffine.negY x y := by
    rw [WeierstrassCurve.Affine.negY]
    simp only [threeRootsCurve]
    intro h'
    apply h2y
    linear_combination h'
  have hslope : (threeRootsCurve (x₀ - ρ ^ 2) (x₀ - r₂ ^ 2) (x₀ - r₃ ^ 2)).toAffine.slope x x y y =
      ρ + r₂ + r₃ := by
    rw [WeierstrassCurve.Affine.slope_of_Y_ne rfl hyne, div_eq_iff (sub_ne_zero.mpr hyne)]
    rw [WeierstrassCurve.Affine.negY]
    simp only [threeRootsCurve]
    rw [hx, hy]; ring
  refine ⟨WeierstrassCurve.Affine.Point.some hQ, ?_⟩
  rw [two_nsmul, WeierstrassCurve.Affine.Point.add_self_of_Y_ne hyne]
  simp only [WeierstrassCurve.Affine.Point.some.injEq]
  rw [hslope]
  constructor
  · rw [WeierstrassCurve.Affine.addX]
    simp only [threeRootsCurve]
    rw [hx]; ring
  · rw [WeierstrassCurve.Affine.addY, WeierstrassCurve.Affine.negAddY,
      WeierstrassCurve.Affine.negY, WeierstrassCurve.Affine.addX]
    simp only [threeRootsCurve]
    rw [hx, hy]; ring

theorem isSquare_of_valuation_sub_one_lt_valuation_four (F : Type*) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (u : F)
    (hu : ValuativeRel.valuation F (u - 1) < ValuativeRel.valuation F 4) : IsSquare u :=
by
  classical
  by_cases h4 : (4 : F) = 0
  · exfalso
    rw [h4, Valuation.map_zero] at hu
    exact not_lt_zero' hu
  obtain ⟨w, hwdef⟩ : ∃ w : F, w = (u - 1) / 4 := ⟨_, rfl⟩
  have hw4 : w * 4 = u - 1 := by rw [hwdef]; exact div_mul_cancel₀ (u - 1) h4
  have hw : ValuativeRel.valuation F w < 1 := by
    by_contra hge
    push_neg at hge
    have hle : ValuativeRel.valuation F 4 ≤ ValuativeRel.valuation F (u - 1) := by
      rw [← hw4, map_mul]
      calc ValuativeRel.valuation F 4 = 1 * ValuativeRel.valuation F 4 := (one_mul _).symm
        _ ≤ ValuativeRel.valuation F w * ValuativeRel.valuation F 4 := mul_le_mul_right' hge _
    exact absurd hu (not_lt.mpr hle)
  haveI : HenselianLocalRing ↥(ValuativeRel.valuation F).integer := by
    set O := ↥(ValuativeRel.valuation F).integer
    have hclosed : ∀ (n : ℕ) (a : O),
        IsClosed {y : O | y - a ∈ (IsLocalRing.maximalIdeal O) ^ n} := by
      intro n a
      obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O
      have hset := Irreducible.maximalIdeal_pow_eq_setOf_le_v_coe_pow
        (v := ValuativeRel.valuation F) hϖ n
      have : {y : O | y - a ∈ (IsLocalRing.maximalIdeal O) ^ n} =
          (fun y : O => ((y : F) - (a : F))) ⁻¹'
            {x : F | ValuativeRel.valuation F x ≤ ValuativeRel.valuation F (ϖ : F) ^ n} := by
        ext y
        have h := congrArg (fun s : Set O => (y - a) ∈ s) hset
        simp only [SetLike.mem_coe, eq_iff_iff] at h
        simp only [Set.mem_setOf_eq, Set.mem_preimage]
        rw [h]
        rfl
      rw [this]
      exact (IsValuativeTopology.isClosed_closedBall _).preimage
        (continuous_subtype_val.sub continuous_const)
    have hpre : IsPrecomplete (IsLocalRing.maximalIdeal O) O := by
      refine ⟨fun {f} hf => ?_⟩
      obtain ⟨L, -, hL⟩ := (isCompact_univ (X := O)).exists_clusterPt
        (f := Filter.map f Filter.atTop) (by simp)
      refine ⟨L, fun n => ?_⟩
      have hC : {y : O | y - f n ∈ (IsLocalRing.maximalIdeal O) ^ n} ∈
          Filter.map f Filter.atTop := by
        rw [Filter.mem_map, Filter.mem_atTop_sets]
        refine ⟨n, fun k hk => ?_⟩
        have := (hf hk).symm
        rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top] at this
        exact this
      have hmem := hL.mem_closure_of_mem _ hC
      rw [(hclosed n (f n)).closure_eq] at hmem
      rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top]
      have : f n - L = -(L - f n) := by ring
      rw [this]
      exact neg_mem hmem
    haveI := hpre
    haveI : IsAdicComplete (IsLocalRing.maximalIdeal O) O := {}
    haveI := IsAdicComplete.henselianRing O (IsLocalRing.maximalIdeal O)
    refine ⟨fun f hf a₀ h₁ h₂ => ?_⟩
    exact HenselianRing.is_henselian f hf a₀ h₁ (h₂.map (Ideal.Quotient.mk _))
  let wO : ↥(ValuativeRel.valuation F).integer :=
    ⟨w, (Valuation.mem_integer_iff (ValuativeRel.valuation F) w).mpr hw.le⟩
  have hwO : (wO : F) = w := rfl
  let f : Polynomial ↥(ValuativeRel.valuation F).integer :=
    Polynomial.X ^ 2 + (Polynomial.X - Polynomial.C wO)
  have hmonic : f.Monic := by
    apply Polynomial.monic_X_pow_add
    exact lt_of_le_of_lt (Polynomial.degree_X_sub_C_le wO) (by decide)
  have heval : f.eval 0 ∈ IsLocalRing.maximalIdeal ↥(ValuativeRel.valuation F).integer := by
    have he : f.eval 0 = -wO := by simp [f]
    rw [he, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, IsUnit.neg_iff]
    intro hu'
    have h1 := ((Valuation.integer.integers (ValuativeRel.valuation F)).isUnit_iff_valuation_eq_one).mp hu'
    exact (ne_of_lt hw) h1
  have hder : IsUnit ((Polynomial.derivative f).eval 0) := by
    have he : (Polynomial.derivative f).eval 0 = 1 := by simp [f]
    rw [he]; exact isUnit_one
  obtain ⟨a, ha, -⟩ := HenselianLocalRing.is_henselian f hmonic 0 heval hder
  have hroot0 : a ^ 2 + (a - wO) = 0 := by
    have h0 := ha.eq_zero
    simpa [f] using h0
  have hroot : (a : F) ^ 2 + (a : F) - w = 0 := by
    have h1 := congrArg (fun z : ↥(ValuativeRel.valuation F).integer => (z : F)) hroot0
    have hs : ((a - wO : ↥(ValuativeRel.valuation F).integer) : F) = (a : F) - w := by
      rw [AddSubgroupClass.coe_sub, hwO]
    simp only [Subring.coe_add, Subring.coe_pow, Subring.coe_zero, hs] at h1
    linear_combination h1
  exact ⟨1 + 2 * (a : F), by linear_combination (-4 : F) * hroot - hw4⟩

theorem index_two_nsmul_threeRootsCurve_localField (F : Type*) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F] [DecidableEq F]
    (t₁ t₂ t₃ : F) (ht₁ : ValuativeRel.valuation F t₁ ≤ 1) (ht₂ : ValuativeRel.valuation F t₂ ≤ 1)
    (ht₃ : ValuativeRel.valuation F t₃ ≤ 1) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃) :
    (nsmulAddMonoidHom 2 : (threeRootsCurve t₁ t₂ t₃).toAffine.Point →+
        (threeRootsCurve t₁ t₂ t₃).toAffine.Point).range.index =
      4 * Nat.card (↥(ValuativeRel.valuation F).integer ⧸
        Ideal.span {(2 : ↥(ValuativeRel.valuation F).integer)}) :=
by
  
  have h2 : (2 : F) ≠ 0 := two_ne_zero
  have h4 : (4 : F) ≠ 0 := by norm_num
  have hV2 : ValuativeRel.valuation F 2 ≤ 1 := by
    rw [← one_add_one_eq_two]
    exact Valuation.map_add_le _ (map_one _).le (map_one _).le
  have hV2ne : ValuativeRel.valuation F 2 ≠ 0 := (Valuation.ne_zero_iff _).mpr h2
  have hV4ne : ValuativeRel.valuation F 4 ≠ 0 := (Valuation.ne_zero_iff _).mpr h4
  have hV4 : ValuativeRel.valuation F 4 ≤ 1 := by
    rw [show (4 : F) = 2 * 2 by norm_num, map_mul]
    exact mul_le_one' hV2 hV2
  have hsub : ∀ a b : F, ValuativeRel.valuation F a ≤ 1 → ValuativeRel.valuation F b ≤ 1 →
      ValuativeRel.valuation F (a - b) ≤ 1 := fun a b ha hb =>
    le_trans (Valuation.map_sub _ _ _) (max_le ha hb)
  obtain ⟨D, hDdef⟩ : ∃ D : F, D = (t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃) := ⟨_, rfl⟩
  have hD0 : D ≠ 0 := by
    rw [hDdef]
    exact mul_ne_zero (mul_ne_zero (sub_ne_zero.mpr h₁₂) (sub_ne_zero.mpr h₁₃))
      (sub_ne_zero.mpr h₂₃)
  have hVD : ValuativeRel.valuation F D ≤ 1 := by
    rw [hDdef, map_mul, map_mul]
    exact mul_le_one' (mul_le_one' (hsub _ _ ht₁ ht₂) (hsub _ _ ht₁ ht₃)) (hsub _ _ ht₂ ht₃)
  have hVDne : ValuativeRel.valuation F D ≠ 0 := (Valuation.ne_zero_iff _).mpr hD0
  
  obtain ⟨ϖ₀, hϖ₀⟩ := IsDiscreteValuationRing.exists_irreducible (ValuativeRel.valuation F).integer
  have hϖ0 : (ϖ₀ : F) ≠ 0 := fun h => hϖ₀.ne_zero (Subtype.ext h)
  have hunit : ∀ b : (ValuativeRel.valuation F).integer,
      IsUnit b ↔ ValuativeRel.valuation F (b : F) = 1 :=
    fun b => (Valuation.integer.integers _).isUnit_iff_valuation_eq_one
  have hϖ1 : ValuativeRel.valuation F (ϖ₀ : F) < 1 :=
    lt_of_le_of_ne ϖ₀.2 (fun h => hϖ₀.not_isUnit ((hunit ϖ₀).mpr h))
  have hϖ : ∀ b : F, ValuativeRel.valuation F b < 1 →
      ValuativeRel.valuation F b ≤ ValuativeRel.valuation F (ϖ₀ : F) := by
    intro b hb
    have hbO : b ∈ (ValuativeRel.valuation F).integer := le_of_lt hb
    have hmem : (⟨b, hbO⟩ : (ValuativeRel.valuation F).integer) ∈
        IsLocalRing.maximalIdeal (ValuativeRel.valuation F).integer :=
      (IsLocalRing.mem_maximalIdeal _).mpr
        (mem_nonunits_iff.mpr fun hu => (ne_of_lt hb) ((hunit _).mp hu))
    rw [(IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ₀).mp hϖ₀,
      Ideal.mem_span_singleton'] at hmem
    obtain ⟨r, hr⟩ := hmem
    have hb' : b = (r : F) * (ϖ₀ : F) := by
      have := congrArg Subtype.val hr
      simpa using this.symm
    rw [hb', map_mul]
    exact mul_le_of_le_one_left' r.2
  
  have hfilt : ∀ c : F, ValuativeRel.valuation F c < 1 →
      ∃ U : AddSubgroup (threeRootsCurve t₁ t₂ t₃).toAffine.Point, ∀ P, P ∈ U ↔
        ∀ (x y : F) (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y),
          P = WeierstrassCurve.Affine.Point.some h → 1 ≤ ValuativeRel.valuation F (c ^ 2 * x) := by
    intro c hc
    refine ⟨
      { carrier := {P | ∀ (x y : F) (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y),
            P = WeierstrassCurve.Affine.Point.some h → 1 ≤ ValuativeRel.valuation F (c ^ 2 * x)}
        zero_mem' := ?zero
        add_mem' := ?add
        neg_mem' := ?neg }, fun P => Iff.rfl⟩
    case zero =>
      intro x y h heq
      cases heq
    case add =>
      intro P Q hP hQ x₃ y₃ h₃ heq
      cases P with
      | zero =>
        change (0 : (threeRootsCurve t₁ t₂ t₃).toAffine.Point) + Q = _ at heq
        rw [zero_add] at heq
        exact hQ x₃ y₃ h₃ heq
      | @some x₁ y₁ h₁ =>
        cases Q with
        | zero =>
          change WeierstrassCurve.Affine.Point.some h₁ +
            (0 : (threeRootsCurve t₁ t₂ t₃).toAffine.Point) = _ at heq
          rw [add_zero] at heq
          exact hP x₃ y₃ h₃ heq
        | @some x₂ y₂ h₂ =>
          obtain ⟨hx₁, hz₁⟩ := ((threeRootsCurve_valuation_of_nonsingular t₁ t₂ t₃ ht₁ ht₂ ht₃
            h₁).2.2 c hc).mp (hP x₁ y₁ h₁ rfl)
          obtain ⟨hx₂, hz₂⟩ := ((threeRootsCurve_valuation_of_nonsingular t₁ t₂ t₃ ht₁ ht₂ ht₃
            h₂).2.2 c hc).mp (hQ x₂ y₂ h₂ rfl)
          obtain ⟨hx₃, hest⟩ := threeRootsCurve_add_z_estimate t₁ t₂ t₃ ht₁ ht₂ ht₃ h₁ h₂ h₃
            hx₁ hx₂ heq
          refine ((threeRootsCurve_valuation_of_nonsingular t₁ t₂ t₃ ht₁ ht₂ ht₃
            h₃).2.2 c hc).mpr ⟨hx₃, ?_⟩
          have hm : max (ValuativeRel.valuation F (x₁ / y₁)) (ValuativeRel.valuation F (x₂ / y₂)) ≤
              ValuativeRel.valuation F c := max_le hz₁ hz₂
          have hm1 : max (ValuativeRel.valuation F (x₁ / y₁))
              (ValuativeRel.valuation F (x₂ / y₂)) ≤ 1 := le_trans hm (le_of_lt hc)
          have hm3 : max (ValuativeRel.valuation F (x₁ / y₁))
              (ValuativeRel.valuation F (x₂ / y₂)) ^ 3 ≤ ValuativeRel.valuation F c := by
            rw [pow_succ']
            exact le_trans (mul_le_of_le_one_right' (pow_le_one' hm1 2)) hm
          have e : x₃ / y₃ = (x₃ / y₃ - x₁ / y₁ - x₂ / y₂) + x₁ / y₁ + x₂ / y₂ := by ring
          rw [e]
          exact Valuation.map_add_le _ (Valuation.map_add_le _ (le_trans hest hm3) hz₁) hz₂
    case neg =>
      intro P hP x y h heq
      have hP' : P = -WeierstrassCurve.Affine.Point.some h := by rw [← heq, neg_neg]
      rw [WeierstrassCurve.Affine.Point.neg_some] at hP'
      exact hP _ _ _ hP'
  choose! U hU using hfilt
  
  obtain ⟨c, hcdef⟩ : ∃ c : F, c = 2 * (ϖ₀ : F) * D ^ 2 := ⟨_, rfl⟩
  have hc0 : c ≠ 0 := by
    rw [hcdef]
    exact mul_ne_zero (mul_ne_zero h2 hϖ0) (pow_ne_zero 2 hD0)
  have hVD2 : ValuativeRel.valuation F D ^ 2 ≤ 1 := pow_le_one' hVD 2
  have hcV2 : ValuativeRel.valuation F c < ValuativeRel.valuation F 2 := by
    rw [hcdef, mul_assoc, map_mul]
    have hlt : ValuativeRel.valuation F ((ϖ₀ : F) * D ^ 2) < 1 := by
      rw [map_mul, map_pow]
      exact mul_lt_one_of_lt_of_le hϖ1 hVD2
    calc ValuativeRel.valuation F 2 * ValuativeRel.valuation F ((ϖ₀ : F) * D ^ 2)
        < ValuativeRel.valuation F 2 * 1 := mul_lt_mul_of_pos_left hlt (zero_lt_iff.mpr hV2ne)
      _ = ValuativeRel.valuation F 2 := mul_one _
  have hcD : ValuativeRel.valuation F c < ValuativeRel.valuation F D ^ 2 := by
    rw [hcdef, map_mul, map_pow]
    have hlt : ValuativeRel.valuation F (2 * (ϖ₀ : F)) < 1 := by
      rw [map_mul]
      exact Right.mul_lt_one_of_le_of_lt hV2 hϖ1
    calc ValuativeRel.valuation F (2 * (ϖ₀ : F)) * ValuativeRel.valuation F D ^ 2
        < 1 * ValuativeRel.valuation F D ^ 2 :=
          mul_lt_mul_of_pos_right hlt (zero_lt_iff.mpr (pow_ne_zero 2 hVDne))
      _ = ValuativeRel.valuation F D ^ 2 := one_mul _
  have hc1 : ValuativeRel.valuation F c < 1 := lt_of_lt_of_le hcV2 hV2
  have h2c1 : ValuativeRel.valuation F (2 * c) < 1 := by
    rw [map_mul]
    exact Right.mul_lt_one_of_le_of_lt hV2 hc1
  have h2c0 : 2 * c ≠ 0 := mul_ne_zero h2 hc0
  
  have hle : U (2 * c) ≤ U c := by
    intro P hP
    rw [hU c hc1]
    rw [hU (2 * c) h2c1] at hP
    intro x y h heq
    calc (1 : ValuativeRel.ValueGroupWithZero F) ≤ ValuativeRel.valuation F ((2 * c) ^ 2 * x) := hP x y h heq
      _ = ValuativeRel.valuation F 4 * ValuativeRel.valuation F (c ^ 2 * x) := by
          rw [← map_mul]; congr 1; ring
      _ ≤ ValuativeRel.valuation F (c ^ 2 * x) := mul_le_of_le_one_left' hV4
  
  have hhalf : U (2 * c) ≤ (nsmulAddMonoidHom 2 : (threeRootsCurve t₁ t₂ t₃).toAffine.Point →+
      (threeRootsCurve t₁ t₂ t₃).toAffine.Point).range := by
    intro P hP
    rw [hU (2 * c) h2c1] at hP
    cases P with
    | zero => exact ⟨0, by simp; rfl⟩
    | @some x y h =>
      have hx := hP x y h rfl
      have hx0 : x ≠ 0 := by
        rintro rfl
        simp at hx
      have key : ∀ t : F, ValuativeRel.valuation F t ≤ 1 →
          ValuativeRel.valuation F ((1 - t / x) - 1) < ValuativeRel.valuation F 4 := by
        intro t ht
        have e1 : (1 - t / x) - 1 = -(t / x) := by ring
        rw [e1, Valuation.map_neg]
        have hlt : ValuativeRel.valuation F t * ValuativeRel.valuation F c ^ 2 < 1 :=
          Right.mul_lt_one_of_le_of_lt ht (pow_lt_one₀ zero_le' hc1 two_ne_zero)
        calc ValuativeRel.valuation F (t / x)
            ≤ ValuativeRel.valuation F (t / x) * ValuativeRel.valuation F ((2 * c) ^ 2 * x) :=
              le_mul_of_one_le_right' hx
          _ = ValuativeRel.valuation F (4 * (t * c ^ 2)) := by
              rw [← map_mul]; congr 1; field_simp; ring
          _ = ValuativeRel.valuation F 4 *
                (ValuativeRel.valuation F t * ValuativeRel.valuation F c ^ 2) := by
              rw [map_mul, map_mul, map_pow]
          _ < ValuativeRel.valuation F 4 * 1 :=
              mul_lt_mul_of_pos_left hlt (zero_lt_iff.mpr hV4ne)
          _ = ValuativeRel.valuation F 4 := mul_one _
      have hne : ∀ t : F, ValuativeRel.valuation F t ≤ 1 → (1 - t / x) ≠ 0 := by
        intro t ht h0
        have := key t ht
        rw [h0, zero_sub, Valuation.map_neg, map_one] at this
        exact absurd (lt_of_lt_of_le this hV4) (lt_irrefl 1)
      obtain ⟨s₁, hs₁⟩ := isSquare_of_valuation_sub_one_lt_valuation_four F _ (key t₁ ht₁)
      obtain ⟨s₂, hs₂⟩ := isSquare_of_valuation_sub_one_lt_valuation_four F _ (key t₂ ht₂)
      obtain ⟨s₃, hs₃⟩ := isSquare_of_valuation_sub_one_lt_valuation_four F _ (key t₃ ht₃)
      have hs₁0 : s₁ ≠ 0 := by
        rintro rfl
        exact hne t₁ ht₁ (by rw [hs₁]; ring)
      have hs₂0 : s₂ ≠ 0 := by
        rintro rfl
        exact hne t₂ ht₂ (by rw [hs₂]; ring)
      have hs₃0 : s₃ ≠ 0 := by
        rintro rfl
        exact hne t₃ ht₃ (by rw [hs₃]; ring)
      have e₁ : x - t₁ = x * s₁ ^ 2 := by
        rw [sq, ← hs₁]; field_simp
      have e₂ : x - t₂ = x * s₂ ^ 2 := by
        rw [sq, ← hs₂]; field_simp
      have e₃ : x - t₃ = x * s₃ ^ 2 := by
        rw [sq, ← hs₃]; field_simp
      have hy2 : y ^ 2 = (x - t₁) * (x - t₂) * (x - t₃) := by
        have := h.1
        rw [WeierstrassCurve.Affine.equation_iff] at this
        simp only [threeRootsCurve] at this
        linear_combination this
      have hy3 : y ^ 2 = x ^ 3 * s₁ ^ 2 * s₂ ^ 2 * s₃ ^ 2 := by
        rw [hy2, e₁, e₂, e₃]; ring
      have hden : (x * s₁ * s₂ * s₃) ^ 2 ≠ 0 :=
        pow_ne_zero 2 (mul_ne_zero (mul_ne_zero (mul_ne_zero hx0 hs₁0) hs₂0) hs₃0)
      obtain ⟨Q, hQ⟩ := exists_two_nsmul_eq_some_of_sub_eq_sq h2 t₁ t₂ t₃ h₁₂ h₁₃ h₂₃ h
        (y / (x * s₁ * s₂ * s₃) * s₁) (y / (x * s₁ * s₂ * s₃) * s₂) (y / (x * s₁ * s₂ * s₃) * s₃)
        (by rw [div_mul_eq_mul_div, div_pow, eq_div_iff hden, mul_pow y, hy3, e₁]; ring)
        (by rw [div_mul_eq_mul_div, div_pow, eq_div_iff hden, mul_pow y, hy3, e₂]; ring)
        (by rw [div_mul_eq_mul_div, div_pow, eq_div_iff hden, mul_pow y, hy3, e₃]; ring)
      exact ⟨Q, by rw [nsmulAddMonoidHom_apply]; exact hQ⟩
  
  have hidx : (U (2 * c)).index ≠ 0 := by
    have h5 := threeRootsCurve_filtration_index_ne_zero_of_uniformizer F t₁ t₂ t₃ ht₁ ht₂ ht₃
      h₁₂ h₁₃ h₂₃ U hU (ϖ₀ : F) hϖ0 hϖ1 hϖ
    have h6 := threeRootsCurve_filtration_relIndex_ne_zero F t₁ t₂ t₃ ht₁ ht₂ ht₃ U hU
      (ϖ₀ : F) hϖ0 hϖ1 hϖ (2 * c) h2c0 h2c1
    rw [← AddSubgroup.relIndex_top_right] at h5 ⊢
    exact AddSubgroup.relIndex_ne_zero_trans h6 h5
  
  obtain ⟨hker4, htors⟩ := threeRootsCurve_two_torsion h2 t₁ t₂ t₃ h₁₂ h₁₃ h₂₃
  
  have hbot : (nsmulAddMonoidHom 2 : (threeRootsCurve t₁ t₂ t₃).toAffine.Point →+
      (threeRootsCurve t₁ t₂ t₃).toAffine.Point).ker ⊓ U c = ⊥ := by
    rw [AddSubgroup.eq_bot_iff_forall]
    intro P hP
    obtain ⟨hk, hu⟩ := AddSubgroup.mem_inf.mp hP
    rw [hU c hc1] at hu
    rw [AddMonoidHom.mem_ker, nsmulAddMonoidHom_apply] at hk
    cases P with
    | zero => rfl
    | @some x y h =>
      exfalso
      obtain ⟨-, hx⟩ := htors x y h hk
      have hVx : ValuativeRel.valuation F x ≤ 1 := by
        rcases hx with rfl | rfl | rfl <;> assumption
      have h1 := hu x y h rfl
      rw [map_mul, map_pow] at h1
      have h2' : ValuativeRel.valuation F c ^ 2 * ValuativeRel.valuation F x < 1 :=
        mul_lt_one_of_lt_of_le (pow_lt_one₀ zero_le' hc1 two_ne_zero) hVx
      exact absurd (lt_of_le_of_lt h1 h2') (lt_irrefl 1)
  
  have hs9 : ∀ (T U' U₀ : AddSubgroup (threeRootsCurve t₁ t₂ t₃).toAffine.Point),
      U₀ ≤ U' → T ⊓ U' = ⊥ → U₀.relIndex (T ⊔ U') = Nat.card T * U₀.relIndex U' := by
    intro T U' U₀ hUU' hT
    rw [← AddSubgroup.relIndex_mul_relIndex U₀ U' (T ⊔ U') hUU' le_sup_right,
      AddSubgroup.relIndex_sup_right, ← AddSubgroup.inf_relIndex_right U' T, inf_comm U' T, hT,
      AddSubgroup.relIndex_bot_left, mul_comm]
  
  rw [index_range_nsmul_two_eq_relIndex_comap (U (2 * c)) hidx hhalf,
    threeRootsCurve_filtration_comap_two F t₁ t₂ t₃ ht₁ ht₂ ht₃ h₁₂ h₁₃ h₂₃ U hU c hc0
      (by rw [← hDdef]; exact hcD),
    hs9 _ _ _ hle hbot, hker4,
    threeRootsCurve_filtration_relIndex_two F t₁ t₂ t₃ ht₁ ht₂ ht₃
      (isSquare_of_valuation_sub_one_lt_valuation_four F) U hU c hc0 hcV2]

theorem henselianLocalRing_integer_of_isNonarchimedeanLocalField (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] :
    HenselianLocalRing ↥(ValuativeRel.valuation F).integer :=
by
  set O := ↥(ValuativeRel.valuation F).integer
  have hclosed : ∀ (n : ℕ) (a : O),
      IsClosed {y : O | y - a ∈ (IsLocalRing.maximalIdeal O) ^ n} := by
    intro n a
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O
    have hset := Irreducible.maximalIdeal_pow_eq_setOf_le_v_coe_pow
      (v := ValuativeRel.valuation F) hϖ n
    have : {y : O | y - a ∈ (IsLocalRing.maximalIdeal O) ^ n} =
        (fun y : O => ((y : F) - (a : F))) ⁻¹'
          {x : F | ValuativeRel.valuation F x ≤ ValuativeRel.valuation F (ϖ : F) ^ n} := by
      ext y
      have h := congrArg (fun s : Set O => (y - a) ∈ s) hset
      simp only [SetLike.mem_coe, eq_iff_iff] at h
      simp only [Set.mem_setOf_eq, Set.mem_preimage]
      rw [h]
      rfl
    rw [this]
    exact (IsValuativeTopology.isClosed_closedBall _).preimage
      (continuous_subtype_val.sub continuous_const)
  have hpre : IsPrecomplete (IsLocalRing.maximalIdeal O) O := by
    refine ⟨fun {f} hf => ?_⟩
    obtain ⟨L, -, hL⟩ := (isCompact_univ (X := O)).exists_clusterPt
      (f := Filter.map f Filter.atTop) (by simp)
    refine ⟨L, fun n => ?_⟩
    have hC : {y : O | y - f n ∈ (IsLocalRing.maximalIdeal O) ^ n} ∈ Filter.map f Filter.atTop := by
      rw [Filter.mem_map, Filter.mem_atTop_sets]
      refine ⟨n, fun k hk => ?_⟩
      have := (hf hk).symm
      rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top] at this
      exact this
    have hmem := hL.mem_closure_of_mem _ hC
    rw [(hclosed n (f n)).closure_eq] at hmem
    rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top]
    have : f n - L = -(L - f n) := by ring
    rw [this]
    exact neg_mem hmem
  haveI := hpre
  haveI : IsAdicComplete (IsLocalRing.maximalIdeal O) O := {}
  haveI := IsAdicComplete.henselianRing O (IsLocalRing.maximalIdeal O)
  refine ⟨fun f hf a₀ h₁ h₂ => ?_⟩
  exact HenselianRing.is_henselian f hf a₀ h₁ (h₂.map (Ideal.Quotient.mk _))

theorem card_sqCl_eq_two_mul_index_range_sq_units {O K : Type*} [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [Field K] [Algebra O K] [IsFractionRing O K] :
    Nat.card (SqCl K) = 2 * (powMonoidHom 2 : Oˣ →* Oˣ).range.index :=
by
  classical
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O
  have finj : Function.Injective (algebraMap O K) := IsFractionRing.injective O K
  have hfϖ : algebraMap O K ϖ ≠ 0 := (map_ne_zero_iff _ finj).mpr hϖ.ne_zero
  obtain ⟨π, hπ⟩ : ∃ π : Kˣ, (π : K) = algebraMap O K ϖ := ⟨Units.mk0 _ hfϖ, rfl⟩
  obtain ⟨ι, hιinj, hιval⟩ : ∃ ι : Oˣ →* Kˣ, Function.Injective ι ∧
      ∀ u : Oˣ, ((ι u : Kˣ) : K) = algebraMap O K (u : O) :=
    ⟨Units.map (algebraMap O K).toMonoidHom, Units.map_injective (by exact finj), fun u => rfl⟩
  
  have hdec : ∀ x : Kˣ, ∃ n : ℤ, ∃ u : Oˣ, x = π ^ n * ι u := by
    intro x
    obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (A := O) (x : K)
    have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
    have ha0 : a ≠ 0 := by
      rintro rfl
      apply x.ne_zero
      rw [← hab]; simp
    obtain ⟨n₁, u₁, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha0 hϖ
    obtain ⟨n₂, u₂, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb0 hϖ
    refine ⟨(n₁ : ℤ) - n₂, u₁ * u₂⁻¹, ?_⟩
    apply Units.ext
    have hu2 : algebraMap O K (u₂ : O) * algebraMap O K ((u₂⁻¹ : Oˣ) : O) = 1 := by
      rw [← map_mul, Units.mul_inv, map_one]
    have hu2' : algebraMap O K (u₂ : O) ≠ 0 := left_ne_zero_of_mul_eq_one hu2
    have hu2i : algebraMap O K ((u₂⁻¹ : Oˣ) : O) = (algebraMap O K (u₂ : O))⁻¹ :=
      eq_inv_of_mul_eq_one_right hu2
    rw [← hab, Units.val_mul, Units.val_zpow_eq_zpow_val, hιval, hπ, Units.val_mul]
    simp only [map_mul, map_pow, hu2i]
    rw [zpow_sub₀ hfϖ, zpow_natCast, zpow_natCast]
    field_simp
  
  have huq0 : ∀ (k : ℕ) (w : Oˣ), π ^ k * ι w = 1 → k = 0 := by
    intro k w h
    rcases k with _ | j
    · rfl
    · exfalso
      have h' := congrArg Units.val h
      rw [Units.val_mul, Units.val_pow_eq_pow_val, hπ, hιval, Units.val_one, ← map_pow,
        ← map_mul] at h'
      have h'' : ϖ ^ (j + 1) * (w : O) = 1 := finj (by rw [h', map_one])
      apply hϖ.not_isUnit
      have h3 : ϖ * (ϖ ^ j * (w : O)) = 1 := by rw [← h'']; ring
      exact isUnit_of_mul_isUnit_left (y := ϖ ^ j * (w : O)) (by rw [h3]; exact isUnit_one)
  have huq : ∀ (n : ℤ) (u : Oˣ), π ^ n * ι u = 1 → n = 0 := by
    intro n u h
    obtain ⟨k, rfl | rfl⟩ := Int.eq_nat_or_neg n
    · rw [zpow_natCast] at h; simp [huq0 k u h]
    · have h2 : π ^ k * ι u⁻¹ = 1 := by
        have : ι u = (π ^ (-(k : ℤ)))⁻¹ := eq_inv_of_mul_eq_one_right h
        rw [map_inv, this, inv_inv, zpow_neg, zpow_natCast, mul_inv_cancel]
      simp [huq0 k _ h2]
  have huq' : ∀ (n m : ℤ) (u w : Oˣ), π ^ n * ι u = π ^ m * ι w → n = m ∧ u = w := by
    intro n m u w h
    have e : π ^ (n - m) * ι (u * w⁻¹) = 1 := by
      rw [zpow_sub, map_mul, map_inv]
      rw [show π ^ n * (π ^ m)⁻¹ * (ι u * (ι w)⁻¹) = (π ^ n * ι u) * (π ^ m * ι w)⁻¹ by
        rw [mul_inv]; ac_rfl]
      rw [h, mul_inv_cancel]
    have hnm := huq _ _ e
    have hnm' : n = m := by omega
    subst hnm'
    refine ⟨rfl, ?_⟩
    rw [sub_self, zpow_zero, one_mul] at e
    have : u * w⁻¹ = 1 := hιinj (by rw [e, map_one])
    exact mul_inv_eq_one.mp this
  have hsq : ∀ (k : ℤ) (w : Oˣ), (π ^ k * ι w) ^ 2 = π ^ (k + k) * ι (w ^ 2) := by
    intro k w
    rw [sq, sq, map_mul, zpow_add, mul_mul_mul_comm]
  have hsqmem : ∀ (n : ℤ) (u : Oˣ), π ^ n * ι u ∈ (powMonoidHom 2 : Kˣ →* Kˣ).range ↔
      Even n ∧ u ∈ (powMonoidHom 2 : Oˣ →* Oˣ).range := by
    intro n u
    simp only [MonoidHom.mem_range, powMonoidHom_apply]
    constructor
    · rintro ⟨y, hy⟩
      obtain ⟨k, w, rfl⟩ := hdec y
      rw [hsq] at hy
      obtain ⟨h1, h2⟩ := huq' _ _ _ _ hy
      exact ⟨⟨k, h1.symm⟩, ⟨w, h2⟩⟩
    · rintro ⟨⟨k, rfl⟩, ⟨w, rfl⟩⟩
      exact ⟨π ^ k * ι w, hsq k w⟩
  set SG := (powMonoidHom 2 : Kˣ →* Kˣ).range with hSG
  set SU := (powMonoidHom 2 : Oˣ →* Oˣ).range with hSU
  have hHm : ∀ (n : ℤ) (u : Oˣ), π ^ n * ι u ∈ SG ⊔ ι.range ↔ Even n := by
    intro n u
    rw [Subgroup.mem_sup]
    constructor
    · rintro ⟨y, ⟨t, rfl⟩, z, ⟨u', rfl⟩, hyz⟩
      obtain ⟨k, w, rfl⟩ := hdec t
      rw [powMonoidHom_apply, hsq, mul_assoc, ← map_mul] at hyz
      exact ⟨k, (huq' _ _ _ _ hyz).1.symm⟩
    · rintro ⟨k, rfl⟩
      exact ⟨π ^ k * π ^ k, ⟨π ^ k, by rw [powMonoidHom_apply, sq]⟩, ι u, ⟨u, rfl⟩,
        by rw [zpow_add]⟩
  have hI2 : (SG ⊔ ι.range).index = 2 := by
    rw [Subgroup.index_eq_two_iff]
    refine ⟨π, fun b => ?_⟩
    obtain ⟨n, u, rfl⟩ := hdec b
    have e : π ^ n * ι u * π = π ^ (n + 1) * ι u := by
      rw [zpow_add_one]; exact mul_right_comm _ _ _
    rw [e, hHm, hHm, Int.even_add_one]
    by_cases h : Even n <;> simp [Xor', h]
  have hcomap : SG.comap ι = SU := by
    ext u
    rw [Subgroup.mem_comap]
    have := hsqmem 0 u
    rw [zpow_zero, one_mul] at this
    rw [this]; simp
  have hM := Subgroup.relIndex_mul_index (le_sup_left : SG ≤ SG ⊔ ι.range)
  rw [Subgroup.relIndex_sup_left, ← Subgroup.index_comap, hcomap, hI2] at hM
  show SG.index = 2 * SU.index
  rw [← hM, mul_comm]

theorem index_range_powMonoidHom_two_eq_relIndex_comap {A : Type*} [CommGroup A] (U : Subgroup A)
    (hU : U.index ≠ 0) (hU2 : U ≤ (powMonoidHom 2 : A →* A).range) :
    (powMonoidHom 2 : A →* A).range.index = U.relIndex (U.comap (powMonoidHom 2 : A →* A)) :=
by
  have hUK : U ≤ U.comap (powMonoidHom 2 : A →* A) := by
    intro u hu
    rw [Subgroup.mem_comap, powMonoidHom_apply]
    exact U.pow_mem hu 2
  have hK : (U.comap (powMonoidHom 2 : A →* A)).index =
      U.relIndex (powMonoidHom 2 : A →* A).range := Subgroup.index_comap U _
  have e1 := Subgroup.relIndex_mul_index hU2
  have e2 := Subgroup.relIndex_mul_index hUK
  rw [hK] at e2
  have hne : U.relIndex (powMonoidHom 2 : A →* A).range ≠ 0 := by
    intro h0
    rw [h0, zero_mul] at e1
    exact hU e1.symm
  apply mul_right_cancel₀ hne
  rw [mul_comm, e1, e2]

theorem index_ker_units_quot_four_maximalIdeal_ne_zero {O : Type*} [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [Finite (IsLocalRing.ResidueField O)] (h2 : (2 : O) ≠ 0) :
    (Units.map (Ideal.Quotient.mk (Ideal.span {(4 : O)} * IsLocalRing.maximalIdeal O)).toMonoidHom).ker.index ≠ 0 :=
by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O
  have hm : IsLocalRing.maximalIdeal O = Ideal.span {ϖ} := hϖ.maximalIdeal_eq
  have h4 : (4 : O) ≠ 0 := by
    have e : (4 : O) = 2 * 2 := by norm_num
    rw [e]
    exact mul_ne_zero h2 h2
  have h4ϖ : (4 : O) * ϖ ≠ 0 := mul_ne_zero h4 hϖ.ne_zero
  obtain ⟨n, w, hw⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible h4ϖ hϖ
  have hI : Ideal.span {(4 : O)} * IsLocalRing.maximalIdeal O =
      IsLocalRing.maximalIdeal O ^ n := by
    rw [hm, Ideal.span_singleton_mul_span_singleton, hw,
      Ideal.span_singleton_mul_left_unit w.isUnit, Ideal.span_singleton_pow]
  haveI : Finite (O ⧸ IsLocalRing.maximalIdeal O) :=
    inferInstanceAs (Finite (IsLocalRing.ResidueField O))
  have hfg : (IsLocalRing.maximalIdeal O).FG := IsNoetherian.noetherian _
  haveI hfinpow : Finite (O ⧸ IsLocalRing.maximalIdeal O ^ n) :=
    Ideal.finite_quotient_pow hfg n
  haveI hfin : Finite (O ⧸ Ideal.span {(4 : O)} * IsLocalRing.maximalIdeal O) := by
    rw [hI]; exact hfinpow
  haveI : Finite (O ⧸ Ideal.span {(4 : O)} * IsLocalRing.maximalIdeal O)ˣ := inferInstance
  haveI : Finite (Units.map (Ideal.Quotient.mk
      (Ideal.span {(4 : O)} * IsLocalRing.maximalIdeal O)).toMonoidHom).range := inferInstance
  exact Subgroup.FiniteIndex.index_ne_zero

theorem relIndex_ker_units_two_maximalIdeal_comap_sq {O : Type*} [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] (h2 : (2 : O) ≠ 0) :
    (Units.map (Ideal.Quotient.mk (Ideal.span {(2 : O)} * IsLocalRing.maximalIdeal O)).toMonoidHom).ker ≤
      (Units.map (Ideal.Quotient.mk (Ideal.span {(4 : O)} * IsLocalRing.maximalIdeal O)).toMonoidHom).ker.comap
        (powMonoidHom 2 : Oˣ →* Oˣ) ∧
    (Units.map (Ideal.Quotient.mk (Ideal.span {(2 : O)} * IsLocalRing.maximalIdeal O)).toMonoidHom).ker.relIndex
      ((Units.map (Ideal.Quotient.mk (Ideal.span {(4 : O)} * IsLocalRing.maximalIdeal O)).toMonoidHom).ker.comap
        (powMonoidHom 2 : Oˣ →* Oˣ)) = 2 :=
by
  have hprime : (IsLocalRing.maximalIdeal O).IsPrime :=
    (IsLocalRing.maximalIdeal.isMaximal O).isPrime
  have M1 : ∀ (I : Ideal O) (u : Oˣ),
      u ∈ (Units.map (Ideal.Quotient.mk I).toMonoidHom).ker ↔ (u : O) - 1 ∈ I := by
    intro I u
    rw [MonoidHom.mem_ker, Units.ext_iff, Units.coe_map, Units.val_one, ← Ideal.Quotient.eq,
      map_one]
    rfl
  have M2 : ∀ u : Oˣ,
      u ∈ (Units.map (Ideal.Quotient.mk (Ideal.span {(4 : O)} *
          IsLocalRing.maximalIdeal O)).toMonoidHom).ker.comap (powMonoidHom 2 : Oˣ →* Oˣ) ↔
        (u : O) ^ 2 - 1 ∈ Ideal.span {(4 : O)} * IsLocalRing.maximalIdeal O := by
    intro u
    rw [Subgroup.mem_comap, M1, powMonoidHom_apply, Units.val_pow_eq_pow_val]
  have dich : ∀ u : O, u ^ 2 - 1 ∈ Ideal.span {(4 : O)} * IsLocalRing.maximalIdeal O →
      u - 1 ∈ Ideal.span {(2 : O)} * IsLocalRing.maximalIdeal O ∨
        -u - 1 ∈ Ideal.span {(2 : O)} * IsLocalRing.maximalIdeal O := by
    intro u hu
    obtain ⟨z, hzm, hz⟩ := Ideal.mem_span_singleton_mul.mp hu
    have h4 : (4 : O) ≠ 0 := by
      have e : (4 : O) = 2 * 2 := by norm_num
      rw [e]
      exact mul_ne_zero h2 h2
    obtain ⟨c, hc | hc⟩ := ValuationRing.cond (u - 1) 2
    · have hne : u - 1 ≠ 0 := by
        intro h0
        apply h2
        rw [← hc, h0, zero_mul]
      have key : (u - 1) * (u + 1) = (u - 1) * (2 * (c * z)) := by
        linear_combination (-1 : O) * hz + (-2 * z) * hc
      have h' := mul_left_cancel₀ hne key
      right
      refine Ideal.mem_span_singleton_mul.mpr ⟨-(c * z), ?_, ?_⟩
      · exact (IsLocalRing.maximalIdeal O).neg_mem_iff.mpr
          ((IsLocalRing.maximalIdeal O).mul_mem_left c hzm)
      · linear_combination h'
    · have key : 4 * z = 4 * (c * (c + 1)) := by
        linear_combination hz - (u + 1 + 2 * c) * hc
      have h' := mul_left_cancel₀ h4 key
      have hcm : c * (c + 1) ∈ IsLocalRing.maximalIdeal O := h' ▸ hzm
      rcases hprime.mem_or_mem hcm with h | h
      · left
        exact Ideal.mem_span_singleton_mul.mpr ⟨c, h, hc⟩
      · right
        refine Ideal.mem_span_singleton_mul.mpr
          ⟨-(c + 1), (IsLocalRing.maximalIdeal O).neg_mem_iff.mpr h, ?_⟩
        linear_combination -hc
  have hA : (Units.map (Ideal.Quotient.mk (Ideal.span {(2 : O)} *
        IsLocalRing.maximalIdeal O)).toMonoidHom).ker ≤
      (Units.map (Ideal.Quotient.mk (Ideal.span {(4 : O)} *
        IsLocalRing.maximalIdeal O)).toMonoidHom).ker.comap (powMonoidHom 2 : Oˣ →* Oˣ) := by
    intro u hu
    rw [M1] at hu
    rw [M2]
    obtain ⟨y, hy, hyu⟩ := Ideal.mem_span_singleton_mul.mp hu
    refine Ideal.mem_span_singleton_mul.mpr
      ⟨y * (y + 1), (IsLocalRing.maximalIdeal O).mul_mem_right _ hy, ?_⟩
    linear_combination ((u : O) + 1 + 2 * y) * hyu
  have hnegT : (-1 : Oˣ) ∈ (Units.map (Ideal.Quotient.mk (Ideal.span {(4 : O)} *
        IsLocalRing.maximalIdeal O)).toMonoidHom).ker.comap (powMonoidHom 2 : Oˣ →* Oˣ) := by
    rw [M2]
    simp
  have hnegU : (-1 : Oˣ) ∉ (Units.map (Ideal.Quotient.mk (Ideal.span {(2 : O)} *
        IsLocalRing.maximalIdeal O)).toMonoidHom).ker := by
    rw [M1]
    intro h
    obtain ⟨y, hy, hyu⟩ := Ideal.mem_span_singleton_mul.mp h
    simp only [Units.val_neg, Units.val_one] at hyu
    have e2 : 2 * (y + 1) = 0 := by linear_combination hyu
    have h0 : y + 1 = 0 := (mul_eq_zero.mp e2).resolve_left h2
    have e1 : (1 : O) = -y := by linear_combination h0
    apply (IsLocalRing.notMem_maximalIdeal (R := O) (x := 1)).mpr isUnit_one
    rw [e1]
    exact (IsLocalRing.maximalIdeal O).neg_mem_iff.mpr hy
  refine ⟨hA, ?_⟩
  rw [Subgroup.relIndex_eq_two_iff]
  refine ⟨-1, hnegT, fun b hb => ?_⟩
  by_cases hbU : b ∈ (Units.map (Ideal.Quotient.mk (Ideal.span {(2 : O)} *
        IsLocalRing.maximalIdeal O)).toMonoidHom).ker
  · refine Or.inr ⟨hbU, fun h => hnegU ?_⟩
    have := Subgroup.mul_mem _ (Subgroup.inv_mem _ hbU) h
    simpa using this
  · rcases dich _ ((M2 b).mp hb) with h | h
    · exact absurd ((M1 _ b).mpr h) hbU
    · refine Or.inl ⟨(M1 _ _).mpr ?_, hbU⟩
      simpa using h

theorem relIndex_ker_units_four_two_maximalIdeal {O : Type*} [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] (h2 : (2 : O) ≠ 0) :
    (Units.map (Ideal.Quotient.mk (Ideal.span {(4 : O)} * IsLocalRing.maximalIdeal O)).toMonoidHom).ker ≤
      (Units.map (Ideal.Quotient.mk (Ideal.span {(2 : O)} * IsLocalRing.maximalIdeal O)).toMonoidHom).ker ∧
    (Units.map (Ideal.Quotient.mk (Ideal.span {(4 : O)} * IsLocalRing.maximalIdeal O)).toMonoidHom).ker.relIndex
      (Units.map (Ideal.Quotient.mk (Ideal.span {(2 : O)} * IsLocalRing.maximalIdeal O)).toMonoidHom).ker =
      Nat.card (O ⧸ Ideal.span {(2 : O)}) :=
by
  classical
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O
  have hm : IsLocalRing.maximalIdeal O = Ideal.span {ϖ} := hϖ.maximalIdeal_eq
  have hϖ0 : ϖ ≠ 0 := hϖ.ne_zero
  have hϖm : ϖ ∈ IsLocalRing.maximalIdeal O := by
    rw [hm]; exact Ideal.mem_span_singleton_self ϖ
  have hd : (2 : O) * ϖ ≠ 0 := mul_ne_zero h2 hϖ0
  have E1 : Ideal.span {(2 : O)} * IsLocalRing.maximalIdeal O = Ideal.span {2 * ϖ} := by
    rw [hm, Ideal.span_singleton_mul_span_singleton]
  have E2 : Ideal.span {(4 : O)} * IsLocalRing.maximalIdeal O = Ideal.span {2 * ϖ * 2} := by
    rw [hm, Ideal.span_singleton_mul_span_singleton, show (4 : O) * ϖ = 2 * ϖ * 2 by ring]
  have mem : ∀ (I : Ideal O) (u : Oˣ),
      u ∈ (Units.map (Ideal.Quotient.mk I).toMonoidHom).ker ↔ (u : O) - 1 ∈ I := by
    intro I u
    rw [MonoidHom.mem_ker, Units.ext_iff, Units.coe_map, Units.val_one]
    constructor
    · intro h
      exact Ideal.Quotient.eq.mp (h.trans (map_one _).symm)
    · intro h
      exact (Ideal.Quotient.eq.mpr h).trans (map_one _)
  set U := (Units.map (Ideal.Quotient.mk
    (Ideal.span {(2 : O)} * IsLocalRing.maximalIdeal O)).toMonoidHom).ker with hU
  set U' := (Units.map (Ideal.Quotient.mk
    (Ideal.span {(4 : O)} * IsLocalRing.maximalIdeal O)).toMonoidHom).ker with hU'
  have memU : ∀ u : Oˣ, u ∈ U ↔ 2 * ϖ ∣ (u : O) - 1 := by
    intro u
    rw [hU, mem, E1, Ideal.mem_span_singleton]
  have memU' : ∀ u : Oˣ, u ∈ U' ↔ 2 * ϖ * 2 ∣ (u : O) - 1 := by
    intro u
    rw [hU', mem, E2, Ideal.mem_span_singleton]
  have hle : U' ≤ U := by
    intro u hu
    rw [memU'] at hu
    rw [memU]
    exact dvd_trans (dvd_mul_right _ _) hu
  refine ⟨hle, ?_⟩
  
  let x : ↥U → O := fun u => Classical.choose ((memU u).1 u.2)
  have hx : ∀ u : ↥U, ((u : Oˣ) : O) - 1 = 2 * ϖ * x u :=
    fun u => Classical.choose_spec ((memU u).1 u.2)
  have hxeq : ∀ (u : ↥U) (t : O), ((u : Oˣ) : O) - 1 = 2 * ϖ * t → x u = t :=
    fun u t h => mul_left_cancel₀ hd ((hx u).symm.trans h)
  have hx1 : x 1 = 0 := hxeq 1 0 (by simp)
  have hxmul : ∀ u w : ↥U, x (u * w) = x u + x w + 2 * (ϖ * x u * x w) := by
    intro u w
    apply hxeq
    have h1 := hx u
    have h2' := hx w
    rw [Subgroup.coe_mul, Units.val_mul]
    linear_combination ((w : Oˣ) : O) * h1 + (2 * ϖ * x u + 1) * h2'
  
  let θ : ↥U →* Multiplicative (O ⧸ Ideal.span {(2 : O)}) :=
    { toFun := fun u => Multiplicative.ofAdd (Ideal.Quotient.mk _ (x u))
      map_one' := by
        show Multiplicative.ofAdd (Ideal.Quotient.mk _ (x 1)) = 1
        rw [hx1, map_zero, ofAdd_zero]
      map_mul' := by
        intro u w
        show Multiplicative.ofAdd (Ideal.Quotient.mk _ (x (u * w))) =
          Multiplicative.ofAdd (Ideal.Quotient.mk _ (x u)) *
            Multiplicative.ofAdd (Ideal.Quotient.mk _ (x w))
        have h0 : Ideal.Quotient.mk (Ideal.span {(2 : O)}) (2 * (ϖ * x u * x w)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr
            (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self 2))
        rw [hxmul, map_add (Ideal.Quotient.mk (Ideal.span {(2 : O)})),
          map_add (Ideal.Quotient.mk (Ideal.span {(2 : O)})), h0, add_zero, ofAdd_add] }
  have hθ : ∀ u : ↥U, θ u = Multiplicative.ofAdd (Ideal.Quotient.mk _ (x u)) := fun u => rfl
  have hsurj : Function.Surjective θ := by
    intro y
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (Multiplicative.toAdd y)
    have hr : 2 * ϖ * a ∈ IsLocalRing.maximalIdeal O := by
      rw [show 2 * ϖ * a = ϖ * (2 * a) by ring]
      exact Ideal.mul_mem_right _ _ hϖm
    have hunit : IsUnit (1 + 2 * ϖ * a) := by
      apply IsLocalRing.isUnit_of_mem_nonunits_one_sub_self
      rw [show (1 : O) - (1 + 2 * ϖ * a) = -(2 * ϖ * a) by ring]
      exact (IsLocalRing.mem_maximalIdeal _).mp ((Ideal.neg_mem_iff _).mpr hr)
    have hval : ((hunit.unit : Oˣ) : O) - 1 = 2 * ϖ * a := by
      rw [IsUnit.unit_spec]; ring
    have hmem : hunit.unit ∈ U := (memU _).mpr ⟨a, hval⟩
    refine ⟨⟨hunit.unit, hmem⟩, ?_⟩
    rw [hθ, hxeq ⟨hunit.unit, hmem⟩ a hval, ha, ofAdd_toAdd]
  have hker : θ.ker = U'.subgroupOf U := by
    ext u
    rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf, memU', hθ, ofAdd_eq_one,
      Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton, hx u]
    constructor
    · rintro ⟨t, ht⟩
      exact ⟨t, by rw [ht]; ring⟩
    · rintro ⟨t, ht⟩
      exact ⟨t, mul_left_cancel₀ hd (ht.trans (by ring))⟩
  show (U'.subgroupOf U).index = _
  rw [← hker, Subgroup.index_ker, MonoidHom.range_eq_top.mpr hsurj, Subgroup.card_top]
  rfl

theorem card_sqCl_localField (F : Type*) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] :
    Nat.card (SqCl F) =
      4 * Nat.card (↥(ValuativeRel.valuation F).integer ⧸
        Ideal.span {(2 : ↥(ValuativeRel.valuation F).integer)}) :=
by
  have h2 : (2 : ↥(ValuativeRel.valuation F).integer) ≠ 0 := two_ne_zero
  have e3 := card_sqCl_eq_two_mul_index_range_sq_units
    (O := ↥(ValuativeRel.valuation F).integer) (K := F)
  have e7 := relIndex_ker_units_two_maximalIdeal_comap_sq h2
  have e8 := relIndex_ker_units_four_two_maximalIdeal h2
  have e := Subgroup.relIndex_mul_relIndex _ _ _ e8.1 e7.1
  have e6 := index_ker_units_quot_four_maximalIdeal_ne_zero h2
  
  have e4 := index_range_powMonoidHom_two_eq_relIndex_comap
    (A := (↥(ValuativeRel.valuation F).integer)ˣ) _ e6 ?_
  · rw [e8.2, e7.2] at e
    rw [e3, e4, ← e]
    ring
  · 
    intro u hu
    rw [MonoidHom.mem_ker, Units.ext_iff, Units.coe_map, Units.val_one] at hu
    have hu' := Ideal.Quotient.eq.mp (hu.trans (map_one _).symm)
    obtain ⟨t, ht, hte⟩ := Ideal.mem_span_singleton_mul.mp hu'
    have ht' : ¬ IsUnit t := ht
    haveI hH : HenselianLocalRing ↥(ValuativeRel.valuation F).integer :=
      henselianLocalRing_integer_of_isNonarchimedeanLocalField F
    set f : Polynomial ↥(ValuativeRel.valuation F).integer :=
      Polynomial.X ^ 2 + Polynomial.X - Polynomial.C t with hf
    have hmonic : f.Monic := by
      rw [hf]
      monicity!
    have hf0 : f.eval 0 ∈ IsLocalRing.maximalIdeal ↥(ValuativeRel.valuation F).integer := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hf]
      simpa using ht'
    have hf1 : IsUnit (f.derivative.eval 0) := by
      rw [hf]
      simp
    obtain ⟨a, ha, -⟩ := HenselianLocalRing.is_henselian f hmonic 0 hf0 hf1
    have ha' : a ^ 2 + a - t = 0 := by
      rw [Polynomial.IsRoot.def, hf] at ha
      simpa using ha
    have hsq : (1 + 2 * a) * (1 + 2 * a) = (u : ↥(ValuativeRel.valuation F).integer) := by
      linear_combination 4 * ha' + hte
    have hs : IsUnit (1 + 2 * a) := isUnit_of_mul_isUnit_left (hsq ▸ u.isUnit)
    refine ⟨hs.unit, Units.ext ?_⟩
    simp [sq, hsq]

theorem descentSet_ncard_adicCompletion {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (t₁ t₂ t₃ : v.adicCompletion K) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃) :
    (spDesc (v.adicCompletion K) t₁ t₂ t₃).ncard = Nat.card (SqCl (v.adicCompletion K)) :=
by
  classical
  
  obtain ⟨S⟩ := adicCompletion_nonempty_localFieldStructure v
  
  haveI hchar : CharZero (v.adicCompletion K) :=
    charZero_of_injective_algebraMap (algebraMap K (v.adicCompletion K)).injective
  have h2 : (2 : v.adicCompletion K) ≠ 0 := two_ne_zero
  
  have resc : ∀ {F : Type u} [Field F] [ValuativeRel F] (a₁ a₂ a₃ : F), ∃ u : F, u ≠ 0 ∧
      ValuativeRel.valuation F (u ^ 2 * a₁) ≤ 1 ∧ ValuativeRel.valuation F (u ^ 2 * a₂) ≤ 1 ∧
      ValuativeRel.valuation F (u ^ 2 * a₃) ≤ 1 := by
    intro F _ _ a₁ a₂ a₃
    have hs : ∀ a : F, ∃ s : F, s ≠ 0 ∧ ValuativeRel.valuation F s ≤ 1 ∧
        ValuativeRel.valuation F (s * a) ≤ 1 := by
      intro a
      by_cases ha : ValuativeRel.valuation F a ≤ 1
      · exact ⟨1, one_ne_zero, by simp, by simpa using ha⟩
      · have ha0 : a ≠ 0 := by
          rintro rfl
          exact ha (by simp)
        refine ⟨a⁻¹, inv_ne_zero ha0, ?_, ?_⟩
        · exact le_of_lt ((Valuation.one_lt_val_iff _ ha0).mp (not_le.mp ha))
        · rw [inv_mul_cancel₀ ha0, map_one]
    obtain ⟨s₁, hs₁, hv₁, hw₁⟩ := hs a₁
    obtain ⟨s₂, hs₂, hv₂, hw₂⟩ := hs a₂
    obtain ⟨s₃, hs₃, hv₃, hw₃⟩ := hs a₃
    refine ⟨s₁ * s₂ * s₃, mul_ne_zero (mul_ne_zero hs₁ hs₂) hs₃, ?_, ?_, ?_⟩
    · rw [show (s₁ * s₂ * s₃) ^ 2 * a₁ = (s₁ * a₁) * (s₁ * s₂ ^ 2 * s₃ ^ 2) by ring]
      have hb := mul_le_one' hw₁
        (mul_le_one' (mul_le_one' hv₁ (pow_le_one' hv₂ 2)) (pow_le_one' hv₃ 2))
      simpa only [map_mul, map_pow] using hb
    · rw [show (s₁ * s₂ * s₃) ^ 2 * a₂ = (s₂ * a₂) * (s₂ * s₁ ^ 2 * s₃ ^ 2) by ring]
      have hb := mul_le_one' hw₂
        (mul_le_one' (mul_le_one' hv₂ (pow_le_one' hv₁ 2)) (pow_le_one' hv₃ 2))
      simpa only [map_mul, map_pow] using hb
    · rw [show (s₁ * s₂ * s₃) ^ 2 * a₃ = (s₃ * a₃) * (s₃ * s₁ ^ 2 * s₂ ^ 2) by ring]
      have hb := mul_le_one' hw₃
        (mul_le_one' (mul_le_one' hv₃ (pow_le_one' hv₁ 2)) (pow_le_one' hv₂ 2))
      simpa only [map_mul, map_pow] using hb
  
  have hresc : ∀ (u : v.adicCompletion K), u ≠ 0 → ∀ (a₁ a₂ a₃ d₁ d₂ : v.adicCompletion K),
      IsDescentClass a₁ a₂ a₃ d₁ d₂ →
        IsDescentClass (u ^ 2 * a₁) (u ^ 2 * a₂) (u ^ 2 * a₃) d₁ d₂ := by
    rintro u hu a₁ a₂ a₃ d₁ d₂ ⟨z₀, z₁, z₂, z₃, hnt, e1, e2⟩
    have hinv : u * u⁻¹ = 1 := mul_inv_cancel₀ hu
    refine ⟨z₀ / u, z₁, z₂, z₃, ?_, ?_, ?_⟩
    · rintro ⟨h0, h1, h2', h3⟩
      exact hnt ⟨(div_eq_zero_iff.mp h0).resolve_right hu, h1, h2', h3⟩
    · linear_combination e1 - (a₂ - a₁) * z₀ ^ 2 * (u * u⁻¹ + 1) * hinv
    · linear_combination e2 - (a₃ - a₁) * z₀ ^ 2 * (u * u⁻¹ + 1) * hinv
  have hdesc : ∀ (u : v.adicCompletion K), u ≠ 0 →
      spDesc (v.adicCompletion K) t₁ t₂ t₃ =
        spDesc (v.adicCompletion K) (u ^ 2 * t₁) (u ^ 2 * t₂) (u ^ 2 * t₃) := by
    intro u hu
    have e : ∀ a : v.adicCompletion K, u⁻¹ ^ 2 * (u ^ 2 * a) = a := by
      intro a
      rw [← mul_assoc, ← mul_pow, inv_mul_cancel₀ hu, one_pow, one_mul]
    ext c
    constructor
    · rintro ⟨d₁, d₂, rfl, hd⟩
      exact ⟨d₁, d₂, rfl, hresc u hu _ _ _ _ _ hd⟩
    · rintro ⟨d₁, d₂, rfl, hd⟩
      refine ⟨d₁, d₂, rfl, ?_⟩
      have h := hresc u⁻¹ (inv_ne_zero hu) _ _ _ _ _ hd
      rwa [e, e, e] at h
  
  obtain ⟨u, hu, hv₁, hv₂, hv₃⟩ := @resc _ _ S.rel t₁ t₂ t₃
  have hu2 : u ^ 2 ≠ 0 := pow_ne_zero 2 hu
  have d12 : u ^ 2 * t₁ ≠ u ^ 2 * t₂ := fun h => h₁₂ (mul_left_cancel₀ hu2 h)
  have d13 : u ^ 2 * t₁ ≠ u ^ 2 * t₃ := fun h => h₁₃ (mul_left_cancel₀ hu2 h)
  have d23 : u ^ 2 * t₂ ≠ u ^ 2 * t₃ := fun h => h₂₃ (mul_left_cancel₀ hu2 h)
  rw [hdesc u hu, descentSet_ncard_eq_index_two_nsmul h2 _ _ _ d12 d13 d23,
    @index_two_nsmul_threeRootsCurve_localField _ _ S.rel S.top S.isLocalField _ _ _ _ _
      hv₁ hv₂ hv₃ d12 d13 d23,
    @card_sqCl_localField _ _ S.rel S.top S.isLocalField _]

theorem descentSet_ncard_infinitePlace {K : Type u} [Field K] [NumberField K]
    (w : NumberField.InfinitePlace K)
    (t₁ t₂ t₃ : w.Completion) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃) :
    (spDesc w.Completion t₁ t₂ t₃).ncard = Nat.card (SqCl w.Completion) :=
by
  classical
  suffices main : ∀ (F : Type u) [Field F] (s₁ s₂ s₃ : F), s₁ ≠ s₂ → s₁ ≠ s₃ → s₂ ≠ s₃ →
      (Nonempty (F ≃+* ℝ) ∨ Nonempty (F ≃+* ℂ)) →
      (spDesc F s₁ s₂ s₃).ncard = Nat.card (SqCl F) by
    refine main w.Completion t₁ t₂ t₃ h₁₂ h₁₃ h₂₃ ?_
    rcases w.isReal_or_isComplex with hw | hw
    · exact Or.inl ⟨NumberField.InfinitePlace.Completion.ringEquivRealOfIsReal hw⟩
    · exact Or.inr ⟨NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex hw⟩
  clear h₁₂ h₁₃ h₂₃ t₁ t₂ t₃
  intro F _ t₁ t₂ t₃ h₁₂ h₁₃ h₂₃ hF
  
  have transport : ∀ {L : Type} [Field L] (τ : F ≃+* L),
      (spDesc L (τ t₁) (τ t₂) (τ t₃)).ncard = (spDesc F t₁ t₂ t₃).ncard ∧
      Nat.card (SqCl L) = Nat.card (SqCl F) := by
    intro L _ τ
    set Φ : SqCl F →* SqCl L := spSqClMap (τ : F →+* L) with hΦ
    set Ψ : SqCl L →* SqCl F := spSqClMap (τ.symm : L →+* F) with hΨ
    have hΨΦ : ∀ x, Ψ (Φ x) = x := by
      intro x
      obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective x
      show (QuotientGroup.mk (Units.map (τ.symm : L →+* F).toMonoidHom
        (Units.map (τ : F →+* L).toMonoidHom u)) : SqCl F) =
          QuotientGroup.mk u
      congr 1
      ext
      exact τ.symm_apply_apply (u : F)
    have hΦΨ : ∀ y, Φ (Ψ y) = y := by
      intro y
      obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective y
      show (QuotientGroup.mk (Units.map (τ : F →+* L).toMonoidHom
        (Units.map (τ.symm : L →+* F).toMonoidHom u)) : SqCl L) =
          QuotientGroup.mk u
      congr 1
      ext
      exact τ.apply_symm_apply (u : L)
    have pres1 : ∀ a₁ a₂ a₃ d₁ d₂ : F, IsDescentClass a₁ a₂ a₃ d₁ d₂ →
        IsDescentClass (τ a₁) (τ a₂) (τ a₃) (τ d₁) (τ d₂) := by
      rintro a₁ a₂ a₃ d₁ d₂ ⟨z₀, z₁, z₂, z₃, hnt, e1, e2⟩
      refine ⟨τ z₀, τ z₁, τ z₂, τ z₃, ?_, ?_, ?_⟩
      · rintro ⟨h0, h1, h2, h3⟩
        exact hnt ⟨τ.injective (h0.trans (map_zero τ).symm),
          τ.injective (h1.trans (map_zero τ).symm), τ.injective (h2.trans (map_zero τ).symm),
          τ.injective (h3.trans (map_zero τ).symm)⟩
      · have := congrArg τ e1
        simpa only [map_sub, map_mul, map_pow] using this
      · have := congrArg τ e2
        simpa only [map_sub, map_mul, map_pow] using this
    have pres2 : ∀ a₁ a₂ a₃ d₁ d₂ : L, IsDescentClass a₁ a₂ a₃ d₁ d₂ →
        IsDescentClass (τ.symm a₁) (τ.symm a₂) (τ.symm a₃) (τ.symm d₁) (τ.symm d₂) := by
      rintro a₁ a₂ a₃ d₁ d₂ ⟨z₀, z₁, z₂, z₃, hnt, e1, e2⟩
      refine ⟨τ.symm z₀, τ.symm z₁, τ.symm z₂, τ.symm z₃, ?_, ?_, ?_⟩
      · rintro ⟨h0, h1, h2, h3⟩
        exact hnt ⟨τ.symm.injective (h0.trans (map_zero τ.symm).symm),
          τ.symm.injective (h1.trans (map_zero τ.symm).symm),
          τ.symm.injective (h2.trans (map_zero τ.symm).symm),
          τ.symm.injective (h3.trans (map_zero τ.symm).symm)⟩
      · have := congrArg τ.symm e1
        simpa only [map_sub, map_mul, map_pow] using this
      · have := congrArg τ.symm e2
        simpa only [map_sub, map_mul, map_pow] using this
    have hset : spDesc L (τ t₁) (τ t₂) (τ t₃) =
        Prod.map Φ Φ '' spDesc F t₁ t₂ t₃ := by
      ext ⟨c₁, c₂⟩
      constructor
      · rintro ⟨e₁, e₂, heq, hd⟩
        refine ⟨(Ψ (sqCl e₁), Ψ (sqCl e₂)),
          ⟨Units.map (τ.symm : L →+* F).toMonoidHom e₁,
            Units.map (τ.symm : L →+* F).toMonoidHom e₂, rfl, ?_⟩, ?_⟩
        · have h := pres2 _ _ _ _ _ hd
          simp only [RingEquiv.symm_apply_apply] at h
          exact h
        · rw [heq]
          exact Prod.ext (hΦΨ _) (hΦΨ _)
      · rintro ⟨⟨p₁, p₂⟩, ⟨d₁, d₂, heq, hd⟩, hmap⟩
        simp only [Prod.mk.injEq] at heq
        obtain ⟨rfl, rfl⟩ := heq
        exact ⟨Units.map (τ : F →+* L).toMonoidHom d₁,
          Units.map (τ : F →+* L).toMonoidHom d₂, hmap.symm, pres1 _ _ _ _ _ hd⟩
    have hinj : Function.Injective (Prod.map Φ Φ) :=
      Function.Injective.prodMap (Function.LeftInverse.injective hΨΦ)
        (Function.LeftInverse.injective hΨΦ)
    refine ⟨?_, ?_⟩
    · rw [hset]
      exact Set.ncard_image_of_injective _ hinj
    · exact Nat.card_congr ⟨Ψ, Φ, hΦΨ, hΨΦ⟩
  
  have hsqcount : (∀ x : F, IsSquare x) →
      (spDesc F t₁ t₂ t₃).ncard = Nat.card (SqCl F) := by
    intro hsq
    have htriv : ∀ x : SqCl F, x = 1 := by
      intro x
      obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective x
      rw [QuotientGroup.eq_one_iff]
      obtain ⟨r, hr⟩ := hsq (u : F)
      have hr0 : r ≠ 0 := by
        rintro rfl
        exact u.ne_zero (by simpa using hr)
      exact ⟨Units.mk0 r hr0, Units.ext (by simp [hr, sq])⟩
    haveI : Unique (SqCl F) := { default := 1, uniq := htriv }
    have hcard : Nat.card (SqCl F) = 1 := Nat.card_unique
    have hS : spDesc F t₁ t₂ t₃ = {1} := by
      ext ⟨a, b⟩
      simp only [Set.mem_singleton_iff]
      constructor
      · intro _
        rw [htriv a, htriv b]
        rfl
      · intro _
        rw [htriv a, htriv b]
        refine ⟨1, 1, rfl, ?_⟩
        rw [Units.val_one]
        exact ⟨0, 1, 1, 1, by simp, by ring, by ring⟩
    rw [hS, Set.ncard_singleton, hcard]
  
  have real : ∀ a₁ a₂ a₃ : ℝ, a₁ ≠ a₂ → a₁ ≠ a₃ → a₂ ≠ a₃ →
      (spDesc ℝ a₁ a₂ a₃).ncard = Nat.card (SqCl ℝ) := by
    intro a₁ a₂ a₃ g12 g13 g23
    have P' : ∀ v : ℝˣ, 0 < (v : ℝ) → v ∈ (powMonoidHom 2 : ℝˣ →* ℝˣ).range := by
      intro v hv
      refine ⟨Units.mk0 (Real.sqrt v) (Real.sqrt_pos.mpr hv).ne', ?_⟩
      ext
      simp [Real.sq_sqrt hv.le]
    have P : ∀ v : ℝˣ, 0 < (v : ℝ) → sqCl v = 1 := by
      intro v hv
      unfold sqCl
      rw [QuotientGroup.eq_one_iff]
      exact P' v hv
    have N : ∀ u : ℝˣ, (u : ℝ) < 0 → sqCl u = sqCl (-1 : ℝˣ) := by
      intro u hu
      unfold sqCl
      rw [QuotientGroup.eq]
      apply P'
      have h1 : (u : ℝ)⁻¹ < 0 := inv_lt_zero.mpr hu
      simp only [Units.val_mul, Units.val_inv_eq_inv_val, Units.val_neg, Units.val_one]
      linarith
    have G1 : sqCl (-1 : ℝˣ) ≠ 1 := by
      intro h
      unfold sqCl at h
      rw [QuotientGroup.eq_one_iff] at h
      obtain ⟨y, hy⟩ := h
      have h2 := congrArg Units.val hy
      simp only [powMonoidHom_apply, Units.val_pow_eq_pow_val, Units.val_neg,
        Units.val_one] at h2
      nlinarith [sq_nonneg (y : ℝ)]
    have C2 : Nat.card (SqCl ℝ) = 2 := by
      rw [Nat.card_eq_two_iff]
      refine ⟨1, sqCl (-1 : ℝˣ), G1.symm, ?_⟩
      ext x
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_univ, iff_true]
      obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective x
      rcases lt_or_gt_of_ne u.ne_zero with h | h
      · right
        exact N u h
      · left
        exact P u h
    
    have sign : ∀ b₁ b₂ b₃ d₁ d₂ : ℝ, IsDescentClass b₁ b₂ b₃ d₁ d₂ →
        (0 < d₁ → d₂ < 0 → b₁ ≤ b₂ ∧ b₁ ≤ b₃) ∧ (d₁ < 0 → 0 < d₂ → b₂ ≤ b₁ ∧ b₂ ≤ b₃) ∧
        (d₁ < 0 → d₂ < 0 → b₃ ≤ b₁ ∧ b₃ ≤ b₂) := by
      rintro b₁ b₂ b₃ d₁ d₂ ⟨z₀, z₁, z₂, z₃, hnt, e1, e2⟩
      have pinch : ∀ P Q s u : ℝ, 0 ≤ P → Q ≤ 0 → s < 0 → 0 ≤ u → P - Q = s * u →
          P = 0 ∧ Q = 0 ∧ u = 0 := by
        intro P Q s u hP hQ hs hu h
        have h1 : s * u ≤ 0 := by nlinarith
        have hP0 : P = 0 := by linarith
        have hQ0 : Q = 0 := by linarith
        refine ⟨hP0, hQ0, ?_⟩
        have h2 : s * u = 0 := by linarith
        exact (mul_eq_zero.mp h2).resolve_left hs.ne
      have zero : ∀ c z : ℝ, c ≠ 0 → c * z ^ 2 = 0 → z = 0 := by
        intro c z hc h
        exact (pow_eq_zero_iff two_ne_zero).mp ((mul_eq_zero.mp h).resolve_left hc)
      have nn : ∀ c z : ℝ, 0 ≤ c → 0 ≤ c * z ^ 2 := fun c z hc => mul_nonneg hc (sq_nonneg z)
      have np : ∀ c z : ℝ, c ≤ 0 → c * z ^ 2 ≤ 0 := fun c z hc => by nlinarith [sq_nonneg z]
      have hu : 0 ≤ z₀ ^ 2 := sq_nonneg z₀
      have fin : d₁ ≠ 0 → d₂ ≠ 0 → d₁ * z₁ ^ 2 = 0 → d₂ * z₂ ^ 2 = 0 →
          d₁ * d₂ * z₃ ^ 2 = 0 → z₀ ^ 2 = 0 → False := fun hd1 hd2 hA hB hC h0 =>
        hnt ⟨(pow_eq_zero_iff two_ne_zero).mp h0, zero _ _ hd1 hA, zero _ _ hd2 hB,
          zero _ _ (mul_ne_zero hd1 hd2) hC⟩
      refine ⟨fun h1 h2 => ⟨?_, ?_⟩, fun h1 h2 => ⟨?_, ?_⟩, fun h1 h2 => ⟨?_, ?_⟩⟩
      · by_contra hlt
        push_neg at hlt
        obtain ⟨hA, hB, h0⟩ := pinch (d₁ * z₁ ^ 2) (d₂ * z₂ ^ 2) (b₂ - b₁) (z₀ ^ 2)
          (nn d₁ z₁ h1.le) (np d₂ z₂ h2.le) (by linarith) hu e1
        have hC : d₁ * d₂ * z₃ ^ 2 = 0 := by linear_combination -e2 + hA - (b₃ - b₁) * h0
        exact fin h1.ne' h2.ne hA hB hC h0
      · by_contra hlt
        push_neg at hlt
        obtain ⟨hA, hC, h0⟩ := pinch (d₁ * z₁ ^ 2) (d₁ * d₂ * z₃ ^ 2) (b₃ - b₁) (z₀ ^ 2)
          (nn d₁ z₁ h1.le) (np (d₁ * d₂) z₃ (mul_neg_of_pos_of_neg h1 h2).le) (by linarith) hu e2
        have hB : d₂ * z₂ ^ 2 = 0 := by linear_combination -e1 + hA - (b₂ - b₁) * h0
        exact fin h1.ne' h2.ne hA hB hC h0
      · by_contra hlt
        push_neg at hlt
        obtain ⟨hB, hA, h0⟩ := pinch (d₂ * z₂ ^ 2) (d₁ * z₁ ^ 2) (b₁ - b₂) (z₀ ^ 2)
          (nn d₂ z₂ h2.le) (np d₁ z₁ h1.le) (by linarith) hu (by linear_combination -e1)
        have hC : d₁ * d₂ * z₃ ^ 2 = 0 := by linear_combination -e2 + hA - (b₃ - b₁) * h0
        exact fin h1.ne h2.ne' hA hB hC h0
      · by_contra hlt
        push_neg at hlt
        obtain ⟨hB, hC, h0⟩ := pinch (d₂ * z₂ ^ 2) (d₁ * d₂ * z₃ ^ 2) (b₃ - b₂) (z₀ ^ 2)
          (nn d₂ z₂ h2.le) (np (d₁ * d₂) z₃ (mul_neg_of_neg_of_pos h1 h2).le) (by linarith) hu
          (by linear_combination e2 - e1)
        have hA : d₁ * z₁ ^ 2 = 0 := by linear_combination e1 + hB + (b₂ - b₁) * h0
        exact fin h1.ne h2.ne' hA hB hC h0
      · by_contra hlt
        push_neg at hlt
        obtain ⟨hC, hA, h0⟩ := pinch (d₁ * d₂ * z₃ ^ 2) (d₁ * z₁ ^ 2) (b₁ - b₃) (z₀ ^ 2)
          (nn (d₁ * d₂) z₃ (mul_pos_of_neg_of_neg h1 h2).le) (np d₁ z₁ h1.le) (by linarith) hu
          (by linear_combination -e2)
        have hB : d₂ * z₂ ^ 2 = 0 := by linear_combination -e1 + hA - (b₂ - b₁) * h0
        exact fin h1.ne h2.ne hA hB hC h0
      · by_contra hlt
        push_neg at hlt
        obtain ⟨hC, hB, h0⟩ := pinch (d₁ * d₂ * z₃ ^ 2) (d₂ * z₂ ^ 2) (b₂ - b₃) (z₀ ^ 2)
          (nn (d₁ * d₂) z₃ (mul_pos_of_neg_of_neg h1 h2).le) (np d₂ z₂ h2.le) (by linarith) hu
          (by linear_combination e1 - e2)
        have hA : d₁ * z₁ ^ 2 = 0 := by linear_combination e1 + hB + (b₂ - b₁) * h0
        exact fin h1.ne h2.ne hA hB hC h0
    
    have hmem : ∀ (D₁ D₂ : ℝ) (h₁ : D₁ ≠ 0) (h₂ : D₂ ≠ 0), IsDescentClass a₁ a₂ a₃ D₁ D₂ →
        (sqCl (Units.mk0 D₁ h₁), sqCl (Units.mk0 D₂ h₂)) ∈ spDesc ℝ a₁ a₂ a₃ :=
      fun D₁ D₂ h₁ h₂ hd => ⟨_, _, rfl, hd⟩
    have pair : ∀ c : SqCl ℝ × SqCl ℝ, c ∈ spDesc ℝ a₁ a₂ a₃ → c ≠ 1 →
        (∀ x ∈ spDesc ℝ a₁ a₂ a₃, x = 1 ∨ x = c) →
        (spDesc ℝ a₁ a₂ a₃).ncard = Nat.card (SqCl ℝ) := by
      intro c hc hne hall
      have h1 : (1 : SqCl ℝ × SqCl ℝ) ∈ spDesc ℝ a₁ a₂ a₃ := by
        refine ⟨1, 1, rfl, ?_⟩
        rw [Units.val_one]
        exact ⟨0, 1, 1, 1, by simp, by ring, by ring⟩
      have hS : spDesc ℝ a₁ a₂ a₃ = {1, c} := by
        ext x
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
        exact ⟨hall x, by rintro (rfl | rfl) <;> assumption⟩
      rw [hS, Set.ncard_pair hne.symm, C2]
    have hmin : (a₁ < a₂ ∧ a₁ < a₃) ∨ (a₂ < a₁ ∧ a₂ < a₃) ∨ (a₃ < a₁ ∧ a₃ < a₂) := by
      rcases lt_or_gt_of_ne g12 with h | h <;> rcases lt_or_gt_of_ne g13 with h' | h' <;>
        rcases lt_or_gt_of_ne g23 with h'' | h''
      all_goals first
        | exact Or.inl ⟨by linarith, by linarith⟩
        | exact Or.inr (Or.inl ⟨by linarith, by linarith⟩)
        | exact Or.inr (Or.inr ⟨by linarith, by linarith⟩)
    rcases hmin with ⟨m1, m2⟩ | ⟨m1, m2⟩ | ⟨m1, m2⟩
    · 
      have hD1 : 0 < (a₁ - a₂) * (a₁ - a₃) := mul_pos_of_neg_of_neg (by linarith) (by linarith)
      have hD2 : a₁ - a₂ < 0 := by linarith
      have hd : IsDescentClass a₁ a₂ a₃ ((a₁ - a₂) * (a₁ - a₃)) (a₁ - a₂) := by
        have hinv : (a₁ - a₂) * (a₁ - a₂)⁻¹ = 1 := mul_inv_cancel₀ hD2.ne
        refine ⟨1, 0, 1, (a₁ - a₂)⁻¹, by simp, by ring, ?_⟩
        linear_combination (-(a₁ - a₃) * ((a₁ - a₂) * (a₁ - a₂)⁻¹ + 1)) * hinv
      have hc := hmem _ _ hD1.ne' hD2.ne hd
      rw [P (Units.mk0 _ hD1.ne') hD1, N (Units.mk0 _ hD2.ne) hD2] at hc
      refine pair (1, sqCl (-1 : ℝˣ)) hc (fun h => G1 (congrArg Prod.snd h)) ?_
      rintro x ⟨d₁, d₂, rfl, hx⟩
      obtain ⟨s1, s2, s3⟩ := sign _ _ _ _ _ hx
      rcases lt_or_gt_of_ne d₁.ne_zero with h1 | h1 <;>
        rcases lt_or_gt_of_ne d₂.ne_zero with h2 | h2
      · exact absurd (s3 h1 h2).1 (not_le.mpr m2)
      · exact absurd (s2 h1 h2).1 (not_le.mpr m1)
      · exact Or.inr (Prod.ext (P d₁ h1) (N d₂ h2))
      · exact Or.inl (Prod.ext (P d₁ h1) (P d₂ h2))
    · 
      have hD1 : a₂ - a₁ < 0 := by linarith
      have hD2 : 0 < (a₂ - a₁) * (a₂ - a₃) := mul_pos_of_neg_of_neg (by linarith) (by linarith)
      have hd : IsDescentClass a₁ a₂ a₃ (a₂ - a₁) ((a₂ - a₁) * (a₂ - a₃)) := by
        have hinv : (a₂ - a₁) * (a₂ - a₁)⁻¹ = 1 := mul_inv_cancel₀ hD1.ne
        refine ⟨1, 1, 0, (a₂ - a₁)⁻¹, by simp, by ring, ?_⟩
        linear_combination (-(a₂ - a₃) * ((a₂ - a₁) * (a₂ - a₁)⁻¹ + 1)) * hinv
      have hc := hmem _ _ hD1.ne hD2.ne' hd
      rw [N (Units.mk0 _ hD1.ne) hD1, P (Units.mk0 _ hD2.ne') hD2] at hc
      refine pair (sqCl (-1 : ℝˣ), 1) hc (fun h => G1 (congrArg Prod.fst h)) ?_
      rintro x ⟨d₁, d₂, rfl, hx⟩
      obtain ⟨s1, s2, s3⟩ := sign _ _ _ _ _ hx
      rcases lt_or_gt_of_ne d₁.ne_zero with h1 | h1 <;>
        rcases lt_or_gt_of_ne d₂.ne_zero with h2 | h2
      · exact absurd (s3 h1 h2).2 (not_le.mpr m2)
      · exact Or.inr (Prod.ext (N d₁ h1) (P d₂ h2))
      · exact absurd (s1 h1 h2).1 (not_le.mpr m1)
      · exact Or.inl (Prod.ext (P d₁ h1) (P d₂ h2))
    · 
      have hD1 : a₃ - a₁ < 0 := by linarith
      have hD2 : a₃ - a₂ < 0 := by linarith
      have hd : IsDescentClass a₁ a₂ a₃ (a₃ - a₁) (a₃ - a₂) :=
        ⟨1, 1, 1, 0, by simp, by ring, by ring⟩
      have hc := hmem _ _ hD1.ne hD2.ne hd
      rw [N (Units.mk0 _ hD1.ne) hD1, N (Units.mk0 _ hD2.ne) hD2] at hc
      refine pair (sqCl (-1 : ℝˣ), sqCl (-1 : ℝˣ)) hc (fun h => G1 (congrArg Prod.fst h)) ?_
      rintro x ⟨d₁, d₂, rfl, hx⟩
      obtain ⟨s1, s2, s3⟩ := sign _ _ _ _ _ hx
      rcases lt_or_gt_of_ne d₁.ne_zero with h1 | h1 <;>
        rcases lt_or_gt_of_ne d₂.ne_zero with h2 | h2
      · exact Or.inr (Prod.ext (N d₁ h1) (N d₂ h2))
      · exact absurd (s2 h1 h2).2 (not_le.mpr m2)
      · exact absurd (s1 h1 h2).2 (not_le.mpr m1)
      · exact Or.inl (Prod.ext (P d₁ h1) (P d₂ h2))
  
  rcases hF with ⟨⟨τ⟩⟩ | ⟨⟨τ⟩⟩
  · obtain ⟨hD, hC⟩ := transport τ
    rw [← hD, ← hC]
    exact real _ _ _ (fun h => h₁₂ (τ.injective h)) (fun h => h₁₃ (τ.injective h))
      (fun h => h₂₃ (τ.injective h))
  · apply hsqcount
    intro x
    obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq (τ x) two_pos
    refine ⟨τ.symm r, ?_⟩
    apply τ.injective
    rw [map_mul, RingEquiv.apply_symm_apply, ← sq, hr]

theorem isDescentClass_good_odd_iff {K : Type u} [Field K] [NumberField K] (e₁ e₂ e₃ : K)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : IsDedekindDomain.HeightOneSpectrum.valuation K v 2 = 1)
    (hα : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) = 1)
    (hβ : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) = 1)
    (hγ : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₂ - e₃) = 1)
    (x y : Kˣ) :
    IsDescentClass (algebraMap K (v.adicCompletion K) e₁) (algebraMap K (v.adicCompletion K) e₂)
        (algebraMap K (v.adicCompletion K) e₃) (algebraMap K (v.adicCompletion K) (x : K))
        (algebraMap K (v.adicCompletion K) (y : K)) ↔
      EvenVal v x ∧ EvenVal v y :=
by
  classical
  
  have hval : ∀ z : K, Valued.v (algebraMap K (v.adicCompletion K) z) =
      IsDedekindDomain.HeightOneSpectrum.valuation K v z := by
    intro z
    rw [IsDedekindDomain.HeightOneSpectrum.algebraMap_adicCompletion, Function.comp_apply,
      Algebra.algebraMap_self, RingHom.id_apply]
    exact IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v z
  have hα' : Valued.v (algebraMap K (v.adicCompletion K) e₁ -
      algebraMap K (v.adicCompletion K) e₂) = 1 := by rw [← map_sub, hval, hα]
  have hβ' : Valued.v (algebraMap K (v.adicCompletion K) e₁ -
      algebraMap K (v.adicCompletion K) e₃) = 1 := by rw [← map_sub, hval, hβ]
  have hγ' : Valued.v (algebraMap K (v.adicCompletion K) e₂ -
      algebraMap K (v.adicCompletion K) e₃) = 1 := by rw [← map_sub, hval, hγ]
  have hι0 : ∀ z : Kˣ, algebraMap K (v.adicCompletion K) (z : K) ≠ 0 := fun z =>
    (map_ne_zero _).mpr z.ne_zero
  have nz1 : ∀ a : v.adicCompletion K, Valued.v a = 1 → a ≠ 0 := by
    intro a ha h
    rw [h, map_zero] at ha
    exact zero_ne_one ha
  
  have s3 : ∀ z : Kˣ, EvenVal v z ↔ ∃ s : v.adicCompletion K,
      Valued.v (algebraMap K (v.adicCompletion K) (z : K)) = Valued.v s ^ 2 := by
    intro z
    have hg : Valued.v (algebraMap K (v.adicCompletion K) (z : K)) =
        ((v.valuationOfNeZero z : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) := by
      rw [hval, IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq]
    rw [hg]
    unfold EvenVal
    constructor
    · rintro ⟨m, hm⟩
      obtain ⟨π, hπ⟩ := IsDedekindDomain.HeightOneSpectrum.valuation_exists_uniformizer K v
      refine ⟨(algebraMap K (v.adicCompletion K) π) ^ (-m), ?_⟩
      have e1 : (WithZero.exp (-1 : ℤ)) ^ (-m) = WithZero.exp m := by
        rw [← WithZero.exp_zsmul]; simp
      rw [map_zpow₀, hval, hπ, e1, ← WithZero.exp_nsmul, two_nsmul, ← hm]
      rfl
    · rintro ⟨s, hs⟩
      have hs0 : Valued.v s ≠ 0 := by
        intro h
        rw [h, zero_pow two_ne_zero] at hs
        exact WithZero.coe_ne_zero hs
      obtain ⟨h, hh⟩ := WithZero.ne_zero_iff_exists.mp hs0
      rw [← hh, ← WithZero.coe_pow, WithZero.coe_inj] at hs
      rw [hs, toAdd_pow]
      exact ⟨Multiplicative.toAdd h, two_nsmul _⟩
  
  have tri : ∀ P Q : v.adicCompletion K, Valued.v (P - Q) = 1 →
      (Valued.v P = Valued.v Q ∧ 1 ≤ Valued.v P) ∨ (Valued.v P = 1 ∧ Valued.v Q < 1) ∨
        (Valued.v P < 1 ∧ Valued.v Q = 1) := by
    intro P Q h
    rcases lt_trichotomy (Valued.v P) (Valued.v Q) with hlt | heq | hgt
    · right; right
      have h' : Valued.v (P - Q) = Valued.v Q := Valuation.map_sub_eq_of_lt_right _ hlt
      rw [h] at h'
      exact ⟨lt_of_lt_of_eq hlt h'.symm, h'.symm⟩
    · left
      refine ⟨heq, ?_⟩
      have hle := Valuation.map_sub Valued.v P Q
      rw [h, ← heq, max_self] at hle
      exact hle
    · right; left
      have h' : Valued.v (P - Q) = Valued.v P := Valuation.map_sub_eq_of_lt_left _ hgt
      rw [h] at h'
      exact ⟨h'.symm, lt_of_lt_of_eq hgt h'.symm⟩
  
  have s2 : ∀ t₁ t₂ t₃ d₁ d₂ : v.adicCompletion K, Valued.v (t₁ - t₂) = 1 →
      Valued.v (t₁ - t₃) = 1 → Valued.v (t₂ - t₃) = 1 → d₁ ≠ 0 → d₂ ≠ 0 →
      IsDescentClass t₁ t₂ t₃ d₁ d₂ →
      (∃ s : v.adicCompletion K, Valued.v d₁ = Valued.v s ^ 2) ∧
        (∃ s : v.adicCompletion K, Valued.v d₂ = Valued.v s ^ 2) := by
    intro t₁ t₂ t₃ d₁ d₂ h12 h13 h23 hd₁ hd₂ hD
    obtain ⟨z₀, z₁, z₂, z₃, hnt, E1, E2⟩ := hD
    by_cases hz₀ : z₀ = 0
    · subst hz₀
      by_cases hz₃ : z₃ = 0
      · exfalso
        subst hz₃
        have h1 : d₁ * z₁ ^ 2 = 0 := by linear_combination E2
        have hz₁ : z₁ = 0 :=
          (pow_eq_zero_iff two_ne_zero).mp ((mul_eq_zero.mp h1).resolve_left hd₁)
        subst hz₁
        have h2' : d₂ * z₂ ^ 2 = 0 := by linear_combination -E1
        have hz₂ : z₂ = 0 :=
          (pow_eq_zero_iff two_ne_zero).mp ((mul_eq_zero.mp h2').resolve_left hd₂)
        exact hnt ⟨rfl, rfl, hz₂, rfl⟩
      · have e2 : d₂ = (z₁ / z₃) ^ 2 := by
          have h0 : d₁ * (z₁ ^ 2 - d₂ * z₃ ^ 2) = 0 := by linear_combination E2
          have h' := (mul_eq_zero.mp h0).resolve_left hd₁
          rw [div_pow, eq_div_iff (pow_ne_zero 2 hz₃)]
          linear_combination -h'
        have e1 : d₁ = (z₂ / z₃) ^ 2 := by
          have h0 : d₂ * (d₁ * z₃ ^ 2 - z₂ ^ 2) = 0 := by linear_combination E1 - E2
          have h' := (mul_eq_zero.mp h0).resolve_left hd₂
          rw [div_pow, eq_div_iff (pow_ne_zero 2 hz₃)]
          linear_combination h'
        exact ⟨⟨z₂ / z₃, by rw [e1, map_pow]⟩, ⟨z₁ / z₃, by rw [e2, map_pow]⟩⟩
    · have e1 : d₁ * (z₁ / z₀) ^ 2 - d₂ * (z₂ / z₀) ^ 2 = t₂ - t₁ := by
        field_simp
        linear_combination E1
      have e2 : d₁ * (z₁ / z₀) ^ 2 - d₁ * d₂ * (z₃ / z₀) ^ 2 = t₃ - t₁ := by
        field_simp
        linear_combination E2
      generalize z₁ / z₀ = X at e1 e2
      generalize z₂ / z₀ = Y at e1 e2
      generalize z₃ / z₀ = W at e1 e2
      have u21 : Valued.v (t₂ - t₁) = 1 := by rw [Valuation.map_sub_swap]; exact h12
      have u31 : Valued.v (t₃ - t₁) = 1 := by rw [Valuation.map_sub_swap]; exact h13
      have u32 : Valued.v (t₃ - t₂) = 1 := by rw [Valuation.map_sub_swap]; exact h23
      have e3 : d₂ * Y ^ 2 - d₁ * d₂ * W ^ 2 = t₃ - t₂ := by linear_combination e2 - e1
      have tAB := tri (d₁ * X ^ 2) (d₂ * Y ^ 2) (by rw [e1]; exact u21)
      have tAC := tri (d₁ * X ^ 2) (d₁ * d₂ * W ^ 2) (by rw [e2]; exact u31)
      have tBC := tri (d₂ * Y ^ 2) (d₁ * d₂ * W ^ 2) (by rw [e3]; exact u32)
      have P1 : ∀ d P q : v.adicCompletion K, Valued.v P = 1 → d = P * q ^ 2 →
          ∃ s : v.adicCompletion K, Valued.v d = Valued.v s ^ 2 := by
        intro d P q hP hd
        exact ⟨q, by rw [hd, map_mul, map_pow, hP, one_mul]⟩
      have P2 : ∀ d P Q q : v.adicCompletion K, Valued.v P = Valued.v Q → Q ≠ 0 →
          d = P / Q * q ^ 2 → ∃ s : v.adicCompletion K, Valued.v d = Valued.v s ^ 2 := by
        intro d P Q q hPQ hQ hd
        refine ⟨q, ?_⟩
        rw [hd, map_mul, map_div₀, map_pow, hPQ, div_self ((Valuation.ne_zero_iff _).mpr hQ),
          one_mul]
      have nzle : ∀ P : v.adicCompletion K, 1 ≤ Valued.v P → P ≠ 0 := by
        intro P hP
        exact (Valuation.ne_zero_iff _).mp (lt_of_lt_of_le zero_lt_one hP).ne'
      have hXne : d₁ * X ^ 2 ≠ 0 → X ≠ 0 := fun h hX => h (by rw [hX]; ring)
      have hYne : d₂ * Y ^ 2 ≠ 0 → Y ≠ 0 := fun h hY => h (by rw [hY]; ring)
      have hWne : d₁ * d₂ * W ^ 2 ≠ 0 → W ≠ 0 := fun h hW => h (by rw [hW]; ring)
      
      have iA : X ≠ 0 → d₁ = d₁ * X ^ 2 * (X⁻¹) ^ 2 := fun hX => by field_simp
      have iB : Y ≠ 0 → d₂ = d₂ * Y ^ 2 * (Y⁻¹) ^ 2 := fun hY => by field_simp
      have iCA : X ≠ 0 → W ≠ 0 → d₂ = d₁ * d₂ * W ^ 2 / (d₁ * X ^ 2) * (X / W) ^ 2 :=
        fun hX hW => by field_simp
      have iCB : Y ≠ 0 → W ≠ 0 → d₁ = d₁ * d₂ * W ^ 2 / (d₂ * Y ^ 2) * (Y / W) ^ 2 :=
        fun hY hW => by field_simp
      rcases tAB with ⟨hAB, hA1⟩ | ⟨hA1, hB1⟩ | ⟨hA1, hB1⟩
      · rcases tAC with ⟨hAC, -⟩ | ⟨hA1', hC1⟩ | ⟨hA1', hC1⟩
        · 
          have hA0 := nzle _ hA1
          have hB0 := nzle _ (hAB ▸ hA1)
          have hC0 := nzle _ (hAC ▸ hA1)
          have hX := hXne hA0
          have hY := hYne hB0
          have hW := hWne hC0
          exact ⟨P2 _ _ _ _ (hAC.symm.trans hAB) hB0 (iCB hY hW),
            P2 _ _ _ _ hAC.symm hA0 (iCA hX hW)⟩
        · 
          have hB1 : Valued.v (d₂ * Y ^ 2) = 1 := hAB.symm.trans hA1'
          exact ⟨P1 _ _ _ hA1' (iA (hXne (nz1 _ hA1'))), P1 _ _ _ hB1 (iB (hYne (nz1 _ hB1)))⟩
        · exact absurd hA1 (not_le.mpr hA1')
      · 
        rcases tBC with ⟨-, hB1'⟩ | ⟨hB1', -⟩ | ⟨-, hC1⟩
        · exact absurd hB1' (not_le.mpr hB1)
        · exact absurd hB1' (ne_of_lt hB1)
        · have hX := hXne (nz1 _ hA1)
          have hW := hWne (nz1 _ hC1)
          exact ⟨P1 _ _ _ hA1 (iA hX),
            P2 _ _ _ _ (hC1.trans hA1.symm) (nz1 _ hA1) (iCA hX hW)⟩
      · 
        rcases tAC with ⟨-, hA1'⟩ | ⟨hA1', -⟩ | ⟨-, hC1⟩
        · exact absurd hA1' (not_le.mpr hA1)
        · exact absurd hA1' (ne_of_lt hA1)
        · have hY := hYne (nz1 _ hB1)
          have hW := hWne (nz1 _ hC1)
          exact ⟨P2 _ _ _ _ (hC1.trans hB1.symm) (nz1 _ hB1) (iCB hY hW),
            P1 _ _ _ hB1 (iB hY)⟩
  
  obtain ⟨k, instk, instfin, r, hk, hr, hker⟩ := adicCompletionIntegers_exists_finite_residue v h2
  
  have hsq : ∀ x : v.adicCompletionIntegers K, r x ≠ 0 → IsSquare (r x) →
      IsSquare (x : v.adicCompletion K) := by
    intro x hx0 hxsq
    obtain ⟨y, hy⟩ := hxsq
    obtain ⟨s, hs⟩ := hr y
    have hy0 : y ≠ 0 := by
      rintro rfl
      apply hx0
      rw [hy, mul_zero]
    have hs1 : Valued.v (s : v.adicCompletion K) = 1 := by
      have hle : Valued.v (s : v.adicCompletion K) ≤ 1 := s.2
      have hnlt : ¬ Valued.v (s : v.adicCompletion K) < 1 := by
        rw [← hker, hs]
        exact hy0
      exact le_antisymm hle (not_lt.mp hnlt)
    have hsub : Valued.v ((x : v.adicCompletion K) - (s : v.adicCompletion K) * s) < 1 := by
      have h0 : r (x - s * s) = 0 := by rw [map_sub, map_mul, hs, hy, sub_self]
      have h1 := (hker _).mp h0
      simpa using h1
    have hs0 : (s : v.adicCompletion K) ≠ 0 := by
      intro h
      rw [h, map_zero] at hs1
      exact zero_ne_one hs1
    have hw : Valued.v ((x : v.adicCompletion K) / ((s : v.adicCompletion K) * s) - 1) < 1 := by
      have e : (x : v.adicCompletion K) / ((s : v.adicCompletion K) * s) - 1 =
          ((x : v.adicCompletion K) - (s : v.adicCompletion K) * s) /
            ((s : v.adicCompletion K) * s) := by
        field_simp
      rw [e, map_div₀, map_mul, hs1, mul_one, div_one]
      exact hsub
    obtain ⟨c, hc⟩ := adicCompletion_isSquare_of_valued_sub_one_lt_one v h2 _ hw
    refine ⟨c * s, ?_⟩
    have e : (x : v.adicCompletion K) =
        (x : v.adicCompletion K) / ((s : v.adicCompletion K) * s) *
          ((s : v.adicCompletion K) * s) := by
      field_simp
    rw [e, hc]
    ring
  
  haveI : Fintype k := Fintype.ofFinite k
  have hunit : ∀ x : v.adicCompletionIntegers K, r x ≠ 0 →
      Valued.v (x : v.adicCompletion K) = 1 := fun x hx =>
    le_antisymm x.2 (not_lt.mp (fun h => hx ((hker x).mpr h)))
  obtain ⟨c, hc⟩ := FiniteField.exists_nonsquare hk
  have hc0 : c ≠ 0 := by
    rintro rfl
    exact hc ⟨0, by simp⟩
  obtain ⟨x₀, hx₀⟩ := hr c
  have hx₀0 : r x₀ ≠ 0 := by rw [hx₀]; exact hc0
  obtain ⟨u₀, hu₀v, hns, hdich⟩ : ∃ u₀ : v.adicCompletion K, Valued.v u₀ = 1 ∧
      ¬ IsSquare u₀ ∧
      ∀ w : v.adicCompletion K, Valued.v w = 1 → IsSquare w ∨ IsSquare (w * u₀) := by
    refine ⟨x₀, hunit x₀ hx₀0, ?_, ?_⟩
    · rintro ⟨s, hs⟩
      have hvs2 : Valued.v s ^ 2 = 1 := by
        rw [← map_pow, pow_two, ← hs]
        exact hunit x₀ hx₀0
      have hvs : Valued.v s = 1 := (pow_eq_one_iff.mp hvs2).resolve_right two_ne_zero
      let s' : v.adicCompletionIntegers K := ⟨s, hvs.le⟩
      have hss : x₀ = s' * s' := Subtype.ext hs
      apply hc
      exact ⟨r s', by rw [← hx₀, hss, map_mul]⟩
    · intro w hw
      let w' : v.adicCompletionIntegers K := ⟨w, hw.le⟩
      have hw0 : r w' ≠ 0 := by
        intro h
        have h' := (hker w').mp h
        change Valued.v w < 1 at h'
        rw [hw] at h'
        exact lt_irrefl _ h'
      by_cases hsqw : IsSquare (r w')
      · left
        exact hsq w' hw0 hsqw
      · right
        have hprod0 : r (w' * x₀) ≠ 0 := by
          rw [map_mul, hx₀]
          exact mul_ne_zero hw0 hc0
        have hsqp : IsSquare (r (w' * x₀)) := by
          have h1 := (quadraticChar_neg_one_iff_not_isSquare (F := k)).mpr hsqw
          have h2 := (quadraticChar_neg_one_iff_not_isSquare (F := k)).mpr hc
          rw [← quadraticChar_one_iff_isSquare hprod0, map_mul, map_mul, hx₀, h1, h2]
          norm_num
        exact hsq (w' * x₀) hprod0 hsqp
  have hu₀ : u₀ ≠ 0 := nz1 u₀ hu₀v
  
  have s4 : ∀ t₁ t₂ t₃ u : v.adicCompletion K, Valued.v (t₁ - t₂) = 1 →
      Valued.v (t₁ - t₃) = 1 → Valued.v (t₂ - t₃) = 1 → Valued.v u = 1 →
      IsDescentClass t₁ t₂ t₃ 1 u := by
    intro t₁ t₂ t₃ u hα' hβ' hγ' huv
    have hu : u ≠ 0 := nz1 u huv
    obtain ⟨uO, huO⟩ : ∃ a : v.adicCompletionIntegers K, (a : v.adicCompletion K) = u :=
      ⟨⟨u, huv.le⟩, rfl⟩
    obtain ⟨αO, hαO⟩ : ∃ a : v.adicCompletionIntegers K, (a : v.adicCompletion K) = t₁ - t₂ :=
      ⟨⟨t₁ - t₂, hα'.le⟩, rfl⟩
    obtain ⟨βO, hβO⟩ : ∃ a : v.adicCompletionIntegers K, (a : v.adicCompletion K) = t₁ - t₃ :=
      ⟨⟨t₁ - t₃, hβ'.le⟩, rfl⟩
    obtain ⟨γO, hγO⟩ : ∃ a : v.adicCompletionIntegers K, (a : v.adicCompletion K) = t₂ - t₃ :=
      ⟨⟨t₂ - t₃, hγ'.le⟩, rfl⟩
    have hres0 : ∀ a : v.adicCompletionIntegers K, Valued.v (a : v.adicCompletion K) = 1 →
        r a ≠ 0 := by
      intro a ha h
      have h' := (hker a).mp h
      rw [ha] at h'
      exact lt_irrefl _ h'
    have huO0 : r uO ≠ 0 := hres0 uO (by rw [huO]; exact huv)
    by_cases huOsq : IsSquare (r uO)
    · 
      obtain ⟨s, hs⟩ := hsq uO huO0 huOsq
      rw [huO] at hs
      refine ⟨0, s, 1, 1, by simp, ?_, ?_⟩
      · rw [hs]; ring
      · rw [hs]; ring
    have huOns : ¬ IsSquare (r uO) := huOsq
    have hA : r αO ≠ 0 := hres0 αO (by rw [hαO]; exact hα')
    have hB : r βO ≠ 0 := hres0 βO (by rw [hβO]; exact hβ')
    have hγ0 : r γO ≠ 0 := hres0 γO (by rw [hγO]; exact hγ')
    have hBA : r βO - r αO = r γO := by
      rw [← map_sub]
      congr 1
      apply Subtype.ext
      show (βO : v.adicCompletion K) - αO = γO
      rw [hαO, hβO, hγO]
      ring
    have hAB : r αO ≠ r βO := fun h => hγ0 (by rw [← hBA, h, sub_self])
    have rdiv : ∀ X : v.adicCompletionIntegers K, ∃ Y : v.adicCompletionIntegers K,
        (Y : v.adicCompletion K) = X / u ∧ r Y = r X / r uO := by
      intro X
      have hle : Valued.v ((X : v.adicCompletion K) / u) ≤ 1 := by
        rw [map_div₀, huv, div_one]
        exact X.2
      refine ⟨⟨_, hle⟩, rfl, ?_⟩
      rw [eq_div_iff huO0, ← map_mul]
      congr 1
      apply Subtype.ext
      show (X : v.adicCompletion K) / u * uO = X
      rw [huO]
      field_simp
    obtain ⟨zb, ⟨wb, hwb⟩, ⟨sb, hsb⟩⟩ :=
      finiteField_exists_isSquare_div_pair hk (r αO) (r βO) (r uO) hA hB hAB huOns
    obtain ⟨z, hz⟩ := hr zb
    unfold IsDescentClass
    by_cases hw0 : wb = 0
    · 
      have hzA : zb ^ 2 + r αO = 0 := by
        rw [hw0, mul_zero, div_eq_zero_iff] at hwb
        exact hwb.resolve_right huO0
      have hneg : r (-αO) = zb * zb := by
        rw [map_neg]
        linear_combination -hzA
      have hzb : zb ≠ 0 := by
        intro h
        apply hA
        rw [h] at hzA
        simpa using hzA
      obtain ⟨a, ha⟩ := hsq (-αO) (by rw [hneg]; exact mul_ne_zero hzb hzb) ⟨zb, hneg⟩
      have ha' : -(t₁ - t₂) = a * a := by
        rw [← hαO]
        exact ha
      obtain ⟨Y, hYc, hYr⟩ := rdiv γO
      have hY : r Y = sb * sb := by
        rw [hYr, ← hBA, ← hsb]
        congr 1
        linear_combination -hzA
      have hY0 : r Y ≠ 0 := by
        rw [hYr]
        exact div_ne_zero hγ0 huO0
      obtain ⟨b, hb⟩ := hsq Y hY0 ⟨sb, hY⟩
      have hb' : t₂ - t₃ = b * b * u := by
        rw [← div_eq_iff hu, ← hγO, ← hYc]
        exact hb
      refine ⟨1, a, 0, b, by simp, ?_, ?_⟩
      · linear_combination -ha'
      · linear_combination -ha' + hb'
    by_cases hs0 : sb = 0
    · 
      have hzB : zb ^ 2 + r βO = 0 := by
        rw [hs0, mul_zero, div_eq_zero_iff] at hsb
        exact hsb.resolve_right huO0
      have hneg : r (-βO) = zb * zb := by
        rw [map_neg]
        linear_combination -hzB
      have hzb : zb ≠ 0 := by
        intro h
        apply hB
        rw [h] at hzB
        simpa using hzB
      obtain ⟨a, ha⟩ := hsq (-βO) (by rw [hneg]; exact mul_ne_zero hzb hzb) ⟨zb, hneg⟩
      have ha' : -(t₁ - t₃) = a * a := by
        rw [← hβO]
        exact ha
      obtain ⟨Y, hYc, hYr⟩ := rdiv (-γO)
      have hY : r Y = wb * wb := by
        rw [hYr, map_neg, ← hBA, ← hwb]
        congr 1
        linear_combination -hzB
      have hY0 : r Y ≠ 0 := by
        rw [hYr, map_neg]
        exact div_ne_zero (neg_ne_zero.mpr hγ0) huO0
      obtain ⟨b, hb⟩ := hsq Y hY0 ⟨wb, hY⟩
      have hb' : -(t₂ - t₃) = b * b * u := by
        rw [← div_eq_iff hu, ← hγO]
        exact hYc.symm.trans hb
      refine ⟨1, a, b, 0, by simp, ?_, ?_⟩
      · linear_combination -ha' + hb'
      · linear_combination -ha'
    · 
      obtain ⟨XA, hXAc, hXAr⟩ := rdiv (z * z + αO)
      have hXA : r XA = wb * wb := by
        rw [hXAr, map_add, map_mul, hz, ← hwb, pow_two]
      obtain ⟨a, ha⟩ := hsq XA (by rw [hXA]; exact mul_ne_zero hw0 hw0) ⟨wb, hXA⟩
      have ha' : (z : v.adicCompletion K) * z + (t₁ - t₂) = a * a * u := by
        rw [← div_eq_iff hu, ← hαO]
        exact hXAc.symm.trans ha
      obtain ⟨XB, hXBc, hXBr⟩ := rdiv (z * z + βO)
      have hXB : r XB = sb * sb := by
        rw [hXBr, map_add, map_mul, hz, ← hsb, pow_two]
      obtain ⟨b, hb⟩ := hsq XB (by rw [hXB]; exact mul_ne_zero hs0 hs0) ⟨sb, hXB⟩
      have hb' : (z : v.adicCompletion K) * z + (t₁ - t₃) = b * b * u := by
        rw [← div_eq_iff hu, ← hβO]
        exact hXBc.symm.trans hb
      refine ⟨1, z, a, b, by simp, ?_, ?_⟩
      · linear_combination ha'
      · linear_combination hb'
  
  have SC : ∀ t₁ t₂ t₃ A B A' B' a b : v.adicCompletion K, a ≠ 0 → b ≠ 0 → A' = A * a ^ 2 →
      B' = B * b ^ 2 → IsDescentClass t₁ t₂ t₃ A' B' → IsDescentClass t₁ t₂ t₃ A B := by
    rintro t₁ t₂ t₃ A B A' B' a b ha hb rfl rfl ⟨z₀, z₁, z₂, z₃, hnt, e1, e2⟩
    refine ⟨z₀, z₁ * a, z₂ * b, z₃ * (a * b), ?_, ?_, ?_⟩
    · rintro ⟨h0, h1, h2, h3⟩
      exact hnt ⟨h0, (mul_eq_zero.mp h1).resolve_right ha, (mul_eq_zero.mp h2).resolve_right hb,
        (mul_eq_zero.mp h3).resolve_right (mul_ne_zero ha hb)⟩
    · rw [← e1]; ring
    · rw [← e2]; ring
  have SWAP : ∀ t₁ t₂ t₃ d : v.adicCompletion K, IsDescentClass t₂ t₁ t₃ 1 d →
      IsDescentClass t₁ t₂ t₃ d 1 := by
    rintro t₁ t₂ t₃ d ⟨w₀, w₁, w₂, w₃, hnt, H1, H2⟩
    refine ⟨w₀, w₂, w₁, w₃, ?_, ?_, ?_⟩
    · rintro ⟨h0, h2, h1, h3⟩
      exact hnt ⟨h0, h1, h2, h3⟩
    · linear_combination -H1
    · linear_combination H2 - H1
  have ROT : ∀ t₁ t₂ t₃ u : v.adicCompletion K, u ≠ 0 → IsDescentClass t₃ t₁ t₂ 1 u →
      IsDescentClass t₁ t₂ t₃ u u := by
    rintro t₁ t₂ t₃ u hu ⟨w₀, w₁, w₂, w₃, hnt, H1, H2⟩
    refine ⟨w₀, w₂, w₃, w₁ / u, ?_, ?_, ?_⟩
    · rintro ⟨h0, h2, h3, h1⟩
      exact hnt ⟨h0, (div_eq_zero_iff.mp h1).resolve_right hu, h2, h3⟩
    · linear_combination H2 - H1
    · have hu2 : u * u * (w₁ / u) ^ 2 = w₁ ^ 2 := by field_simp
      linear_combination -H1 - hu2
  
  have s8 : ∀ t₁ t₂ t₃ d₁ d₂ : v.adicCompletion K, Valued.v (t₁ - t₂) = 1 →
      Valued.v (t₁ - t₃) = 1 → Valued.v (t₂ - t₃) = 1 → Valued.v d₁ = 1 → Valued.v d₂ = 1 →
      IsDescentClass t₁ t₂ t₃ d₁ d₂ := by
    intro t₁ t₂ t₃ d₁ d₂ h12 h13 h23 hd₁ hd₂
    have h21 : Valued.v (t₂ - t₁) = 1 := by rw [Valuation.map_sub_swap]; exact h12
    have h31 : Valued.v (t₃ - t₁) = 1 := by rw [Valuation.map_sub_swap]; exact h13
    have h32 : Valued.v (t₃ - t₂) = 1 := by rw [Valuation.map_sub_swap]; exact h23
    by_cases hs1 : IsSquare d₁
    · obtain ⟨s, hs⟩ := hs1
      have hs0 : s ≠ 0 := by
        rintro rfl
        exact nz1 d₁ hd₁ (by rw [hs, mul_zero])
      refine SC t₁ t₂ t₃ d₁ d₂ 1 d₂ s⁻¹ 1 (inv_ne_zero hs0) one_ne_zero ?_ (by ring)
        (s4 t₁ t₂ t₃ d₂ h12 h13 h23 hd₂)
      rw [hs, inv_pow, ← pow_two, mul_inv_cancel₀ (pow_ne_zero 2 hs0)]
    by_cases hs2 : IsSquare d₂
    · obtain ⟨q, hq⟩ := hs2
      have hq0 : q ≠ 0 := by
        rintro rfl
        exact nz1 d₂ hd₂ (by rw [hq, mul_zero])
      refine SC t₁ t₂ t₃ d₁ d₂ d₁ 1 1 q⁻¹ one_ne_zero (inv_ne_zero hq0) (by ring) ?_
        (SWAP t₁ t₂ t₃ d₁ (s4 t₂ t₁ t₃ d₁ h21 h23 h13 hd₁))
      rw [hq, inv_pow, ← pow_two, mul_inv_cancel₀ (pow_ne_zero 2 hq0)]
    · obtain ⟨a, ha⟩ := (hdich d₁ hd₁).resolve_left hs1
      obtain ⟨b, hb⟩ := (hdich d₂ hd₂).resolve_left hs2
      have ha0 : a ≠ 0 := by
        rintro rfl
        exact mul_ne_zero (nz1 d₁ hd₁) hu₀ (by rw [ha, mul_zero])
      have hb0 : b ≠ 0 := by
        rintro rfl
        exact mul_ne_zero (nz1 d₂ hd₂) hu₀ (by rw [hb, mul_zero])
      have hid : d₂ * (a / b) ^ 2 = d₁ := by
        rw [div_pow, mul_div_assoc', div_eq_iff (pow_ne_zero 2 hb0)]
        linear_combination d₁ * hb - d₂ * ha
      exact SC t₁ t₂ t₃ d₁ d₂ d₁ d₁ 1 (a / b) one_ne_zero (div_ne_zero ha0 hb0) (by ring)
        hid.symm (ROT t₁ t₂ t₃ d₁ (nz1 d₁ hd₁) (s4 t₃ t₁ t₂ d₁ h31 h32 h12 hd₁))
  
  constructor
  · intro h
    obtain ⟨hs1, hs2⟩ := s2 _ _ _ _ _ hα' hβ' hγ' (hι0 x) (hι0 y) h
    exact ⟨(s3 x).mpr hs1, (s3 y).mpr hs2⟩
  · rintro ⟨hx, hy⟩
    obtain ⟨sx, hsx⟩ := (s3 x).mp hx
    obtain ⟨sy, hsy⟩ := (s3 y).mp hy
    have hsx0 : sx ≠ 0 := by
      rintro rfl
      apply hι0 x
      rw [map_zero, zero_pow two_ne_zero] at hsx
      exact (Valuation.zero_iff _).mp hsx
    have hsy0 : sy ≠ 0 := by
      rintro rfl
      apply hι0 y
      rw [map_zero, zero_pow two_ne_zero] at hsy
      exact (Valuation.zero_iff _).mp hsy
    have hux : Valued.v (algebraMap K (v.adicCompletion K) (x : K) * sx⁻¹ ^ 2) = 1 := by
      rw [map_mul, map_pow, hsx, map_inv₀, inv_pow,
        mul_inv_cancel₀ (pow_ne_zero 2 ((Valuation.ne_zero_iff _).mpr hsx0))]
    have huy : Valued.v (algebraMap K (v.adicCompletion K) (y : K) * sy⁻¹ ^ 2) = 1 := by
      rw [map_mul, map_pow, hsy, map_inv₀, inv_pow,
        mul_inv_cancel₀ (pow_ne_zero 2 ((Valuation.ne_zero_iff _).mpr hsy0))]
    exact SC _ _ _ _ _ _ _ sx⁻¹ sy⁻¹ (inv_ne_zero hsx0) (inv_ne_zero hsy0) rfl rfl
      (s8 _ _ _ _ _ hα' hβ' hγ' hux huy)

theorem phiSign_hilbTerm_good_odd {K : Type u} [Field K] [NumberField K] (e₁ e₂ e₃ : K)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : IsDedekindDomain.HeightOneSpectrum.valuation K v 2 = 1)
    (hα : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) = 1)
    (hβ : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) = 1)
    (hγ : IsDedekindDomain.HeightOneSpectrum.valuation K v (e₂ - e₃) = 1) :
    phiSign (v.adicCompletion K) (algebraMap K _ e₁) (algebraMap K _ e₂) (algebraMap K _ e₃) = 1 ∧
    hilbTerm (v.adicCompletion K) (algebraMap K _ e₁) (algebraMap K _ e₂) (algebraMap K _ e₃) = 1 :=
by
  classical
  
  have hval : ∀ x : K, Valued.v (algebraMap K (v.adicCompletion K) x) =
      IsDedekindDomain.HeightOneSpectrum.valuation K v x := by
    intro x
    rw [IsDedekindDomain.HeightOneSpectrum.algebraMap_adicCompletion, Function.comp_apply,
      Algebra.algebraMap_self, RingHom.id_apply]
    exact IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v x
  have hα' : Valued.v (algebraMap K (v.adicCompletion K) e₁ -
      algebraMap K (v.adicCompletion K) e₂) = 1 := by rw [← map_sub, hval, hα]
  have hβ' : Valued.v (algebraMap K (v.adicCompletion K) e₁ -
      algebraMap K (v.adicCompletion K) e₃) = 1 := by rw [← map_sub, hval, hβ]
  have hγ' : Valued.v (algebraMap K (v.adicCompletion K) e₂ -
      algebraMap K (v.adicCompletion K) e₃) = 1 := by rw [← map_sub, hval, hγ]
  
  obtain ⟨k, instk, instfin, r, hk, hr, hker⟩ := adicCompletionIntegers_exists_finite_residue v h2
  
  have hsq : ∀ x : v.adicCompletionIntegers K, r x ≠ 0 → IsSquare (r x) →
      IsSquare (x : v.adicCompletion K) := by
    intro x hx0 hxsq
    obtain ⟨y, hy⟩ := hxsq
    obtain ⟨s, hs⟩ := hr y
    have hy0 : y ≠ 0 := by
      rintro rfl
      apply hx0
      rw [hy, mul_zero]
    have hs1 : Valued.v (s : v.adicCompletion K) = 1 := by
      have hle : Valued.v (s : v.adicCompletion K) ≤ 1 := s.2
      have hnlt : ¬ Valued.v (s : v.adicCompletion K) < 1 := by
        rw [← hker, hs]
        exact hy0
      exact le_antisymm hle (not_lt.mp hnlt)
    have hsub : Valued.v ((x : v.adicCompletion K) - (s : v.adicCompletion K) * s) < 1 := by
      have h0 : r (x - s * s) = 0 := by rw [map_sub, map_mul, hs, hy, sub_self]
      have h1 := (hker _).mp h0
      simpa using h1
    have hs0 : (s : v.adicCompletion K) ≠ 0 := by
      intro h
      rw [h, map_zero] at hs1
      exact zero_ne_one hs1
    have hw : Valued.v ((x : v.adicCompletion K) / ((s : v.adicCompletion K) * s) - 1) < 1 := by
      have e : (x : v.adicCompletion K) / ((s : v.adicCompletion K) * s) - 1 =
          ((x : v.adicCompletion K) - (s : v.adicCompletion K) * s) /
            ((s : v.adicCompletion K) * s) := by
        field_simp
      rw [e, map_div₀, map_mul, hs1, mul_one, div_one]
      exact hsub
    obtain ⟨c, hc⟩ := adicCompletion_isSquare_of_valued_sub_one_lt_one v h2 _ hw
    refine ⟨c * s, ?_⟩
    have e : (x : v.adicCompletion K) =
        (x : v.adicCompletion K) / ((s : v.adicCompletion K) * s) *
          ((s : v.adicCompletion K) * s) := by
      field_simp
    rw [e, hc]
    ring
  
  
  haveI : Fintype k := Fintype.ofFinite k
  have hunit : ∀ x : v.adicCompletionIntegers K, r x ≠ 0 →
      Valued.v (x : v.adicCompletion K) = 1 := fun x hx =>
    le_antisymm x.2 (not_lt.mp (fun h => hx ((hker x).mpr h)))
  obtain ⟨c, hc⟩ := FiniteField.exists_nonsquare hk
  have hc0 : c ≠ 0 := by
    rintro rfl
    exact hc ⟨0, by simp⟩
  obtain ⟨x₀, hx₀⟩ := hr c
  have hx₀0 : r x₀ ≠ 0 := by rw [hx₀]; exact hc0
  obtain ⟨u₀, hu₀v, hns, hdich⟩ : ∃ u₀ : v.adicCompletion K, Valued.v u₀ = 1 ∧
      ¬ IsSquare u₀ ∧
      ∀ w : v.adicCompletion K, Valued.v w = 1 → IsSquare w ∨ IsSquare (w * u₀) := by
    refine ⟨x₀, hunit x₀ hx₀0, ?_, ?_⟩
    · rintro ⟨s, hs⟩
      have hvs2 : Valued.v s ^ 2 = 1 := by
        rw [← map_pow, pow_two, ← hs]
        exact hunit x₀ hx₀0
      have hvs : Valued.v s = 1 := (pow_eq_one_iff.mp hvs2).resolve_right two_ne_zero
      let s' : v.adicCompletionIntegers K := ⟨s, hvs.le⟩
      have hss : x₀ = s' * s' := Subtype.ext hs
      apply hc
      exact ⟨r s', by rw [← hx₀, hss, map_mul]⟩
    · intro w hw
      let w' : v.adicCompletionIntegers K := ⟨w, hw.le⟩
      have hw0 : r w' ≠ 0 := by
        intro h
        have h' := (hker w').mp h
        change Valued.v w < 1 at h'
        rw [hw] at h'
        exact lt_irrefl _ h'
      by_cases hsqw : IsSquare (r w')
      · left
        exact hsq w' hw0 hsqw
      · right
        have hprod0 : r (w' * x₀) ≠ 0 := by
          rw [map_mul, hx₀]
          exact mul_ne_zero hw0 hc0
        have hsqp : IsSquare (r (w' * x₀)) := by
          have h1 := (quadraticChar_neg_one_iff_not_isSquare (F := k)).mpr hsqw
          have h2 := (quadraticChar_neg_one_iff_not_isSquare (F := k)).mpr hc
          rw [← quadraticChar_one_iff_isSquare hprod0, map_mul, map_mul, hx₀, h1, h2]
          norm_num
        exact hsq (w' * x₀) hprod0 hsqp
  have hu₀ : u₀ ≠ 0 := by
    intro h
    rw [h, map_zero] at hu₀v
    exact zero_ne_one hu₀v
  generalize algebraMap K (v.adicCompletion K) e₁ = t₁ at hα' hβ' hγ' ⊢
  generalize algebraMap K (v.adicCompletion K) e₂ = t₂ at hα' hβ' hγ' ⊢
  generalize algebraMap K (v.adicCompletion K) e₃ = t₃ at hα' hβ' hγ' ⊢
  
  have rdiv' : ∀ X D : v.adicCompletionIntegers K, r D ≠ 0 → ∃ Y : v.adicCompletionIntegers K,
      (Y : v.adicCompletion K) = X / D ∧ r Y = r X / r D := by
    intro X D hD
    have hDv := hunit D hD
    have hD0 : (D : v.adicCompletion K) ≠ 0 := by
      intro h
      rw [h, map_zero] at hDv
      exact zero_ne_one hDv
    have hle : Valued.v ((X : v.adicCompletion K) / D) ≤ 1 := by
      rw [map_div₀, hDv, div_one]
      exact X.2
    refine ⟨⟨_, hle⟩, rfl, ?_⟩
    rw [eq_div_iff hD, ← map_mul]
    congr 1
    apply Subtype.ext
    show (X : v.adicCompletion K) / D * D = X
    field_simp
  refine ⟨?_, ?_⟩
  swap
  · 
    obtain ⟨αO, hαO⟩ : ∃ a : v.adicCompletionIntegers K, (a : v.adicCompletion K) = t₁ - t₂ :=
      ⟨⟨t₁ - t₂, hα'.le⟩, rfl⟩
    obtain ⟨βO, hβO⟩ : ∃ a : v.adicCompletionIntegers K, (a : v.adicCompletion K) = t₁ - t₃ :=
      ⟨⟨t₁ - t₃, hβ'.le⟩, rfl⟩
    have hA : r αO ≠ 0 := fun h => by
      have h' := (hker αO).mp h
      rw [hαO, hα'] at h'
      exact lt_irrefl _ h'
    have hB : r βO ≠ 0 := fun h => by
      have h' := (hker βO).mp h
      rw [hβO, hβ'] at h'
      exact lt_irrefl _ h'
    unfold hilbTerm
    split_ifs with ha
    · rfl
    unfold hilbSym
    refine if_pos ?_
    have hbE : ((-(αO * βO) : v.adicCompletionIntegers K) : v.adicCompletion K) =
        -((t₁ - t₂) * (t₁ - t₃)) := by
      show -((αO : v.adicCompletion K) * βO) = _
      rw [hαO, hβO]
    have hb0 : r (-(αO * βO)) ≠ 0 := by
      rw [map_neg, map_mul]
      exact neg_ne_zero.mpr (mul_ne_zero hA hB)
    by_cases hbsq : IsSquare (r (-(αO * βO)))
    · obtain ⟨s, hs⟩ := hsq _ hb0 hbsq
      rw [hbE] at hs
      have hs0 : s ≠ 0 := by
        rintro rfl
        rw [mul_zero, neg_eq_zero, mul_eq_zero] at hs
        rcases hs with h | h
        · rw [h, map_zero] at hα'
          exact zero_ne_one hα'
        · rw [h, map_zero] at hβ'
          exact zero_ne_one hβ'
      refine ⟨0, s⁻¹, ?_⟩
      rw [hs, zero_pow two_ne_zero, mul_zero, zero_add, inv_pow, ← pow_two,
        mul_inv_cancel₀ (pow_ne_zero 2 hs0)]
    · have haO0 : r (αO + βO) ≠ 0 := by
        intro h
        apply hbsq
        rw [map_add] at h
        refine ⟨r αO, ?_⟩
        rw [map_neg, map_mul]
        linear_combination (-(r αO)) * h
      have hcard : Fintype.card k % 2 = 1 := by
        by_contra h
        apply hk
        apply FiniteField.even_card_iff_char_two.mpr
        omega
      have d1 : (Polynomial.C (r (αO + βO)) * Polynomial.X ^ 2).degree = 2 :=
        Polynomial.degree_C_mul_X_pow 2 haO0
      have d2 : (Polynomial.C (r (-(αO * βO))) * Polynomial.X ^ 2).degree = 2 :=
        Polynomial.degree_C_mul_X_pow 2 hb0
      have d3 : (Polynomial.C (r (-(αO * βO))) * Polynomial.X ^ 2 - Polynomial.C 1).degree = 2 := by
        rw [Polynomial.degree_sub_C (by rw [d2]; norm_num), d2]
      obtain ⟨xb, yb, hxy⟩ := FiniteField.exists_root_sum_quadratic d1 d3 hcard
      simp only [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_sub] at hxy
      have hxb : xb ≠ 0 := by
        rintro rfl
        apply hbsq
        have hyb : r (-(αO * βO)) * yb ^ 2 = 1 := by linear_combination hxy
        refine ⟨yb⁻¹, ?_⟩
        rw [← mul_inv]
        exact eq_inv_of_mul_eq_one_left (by rw [← pow_two]; exact hyb)
      obtain ⟨y, hy⟩ := hr yb
      obtain ⟨Y, hYc, hYr⟩ := rdiv' (1 - -(αO * βO) * y * y) (αO + βO) haO0
      have hY : r Y = xb * xb := by
        rw [hYr, div_eq_iff haO0]
        simp only [map_sub, map_one, map_mul, map_neg, map_add, hy] at hxy ⊢
        linear_combination -hxy
      obtain ⟨c, hc⟩ := hsq Y (by rw [hY]; exact mul_ne_zero hxb hxb) ⟨xb, hY⟩
      have h1 := hYc.symm.trans hc
      have hNe : ((1 - -(αO * βO) * y * y : v.adicCompletionIntegers K) : v.adicCompletion K) =
          1 - (-((t₁ - t₂) * (t₁ - t₃))) * y * y := by
        show 1 - -((αO : v.adicCompletion K) * βO) * y * y = _
        rw [hαO, hβO]
      have hDe : ((αO + βO : v.adicCompletionIntegers K) : v.adicCompletion K) =
          2 * t₁ - t₂ - t₃ := by
        show (αO : v.adicCompletion K) + βO = _
        rw [hαO, hβO]
        ring
      rw [hNe, hDe, div_eq_iff ha] at h1
      refine ⟨c, y, ?_⟩
      linear_combination -h1
  
  have hdesc : IsDescentClass t₁ t₂ t₃ 1 u₀ := by
    obtain ⟨uO, huO⟩ : ∃ a : v.adicCompletionIntegers K, (a : v.adicCompletion K) = u₀ :=
      ⟨⟨u₀, hu₀v.le⟩, rfl⟩
    obtain ⟨αO, hαO⟩ : ∃ a : v.adicCompletionIntegers K, (a : v.adicCompletion K) = t₁ - t₂ :=
      ⟨⟨t₁ - t₂, hα'.le⟩, rfl⟩
    obtain ⟨βO, hβO⟩ : ∃ a : v.adicCompletionIntegers K, (a : v.adicCompletion K) = t₁ - t₃ :=
      ⟨⟨t₁ - t₃, hβ'.le⟩, rfl⟩
    obtain ⟨γO, hγO⟩ : ∃ a : v.adicCompletionIntegers K, (a : v.adicCompletion K) = t₂ - t₃ :=
      ⟨⟨t₂ - t₃, hγ'.le⟩, rfl⟩
    have hres0 : ∀ a : v.adicCompletionIntegers K, Valued.v (a : v.adicCompletion K) = 1 →
        r a ≠ 0 := by
      intro a ha h
      have h' := (hker a).mp h
      rw [ha] at h'
      exact lt_irrefl _ h'
    have huO0 : r uO ≠ 0 := hres0 uO (by rw [huO]; exact hu₀v)
    have huOns : ¬ IsSquare (r uO) := fun h => hns (huO ▸ hsq uO huO0 h)
    have hA : r αO ≠ 0 := hres0 αO (by rw [hαO]; exact hα')
    have hB : r βO ≠ 0 := hres0 βO (by rw [hβO]; exact hβ')
    have hγ0 : r γO ≠ 0 := hres0 γO (by rw [hγO]; exact hγ')
    have hBA : r βO - r αO = r γO := by
      rw [← map_sub]
      congr 1
      apply Subtype.ext
      show (βO : v.adicCompletion K) - αO = γO
      rw [hαO, hβO, hγO]
      ring
    have hAB : r αO ≠ r βO := fun h => hγ0 (by rw [← hBA, h, sub_self])
    have rdiv : ∀ X : v.adicCompletionIntegers K, ∃ Y : v.adicCompletionIntegers K,
        (Y : v.adicCompletion K) = X / u₀ ∧ r Y = r X / r uO := by
      intro X
      have hle : Valued.v ((X : v.adicCompletion K) / u₀) ≤ 1 := by
        rw [map_div₀, hu₀v, div_one]
        exact X.2
      refine ⟨⟨_, hle⟩, rfl, ?_⟩
      rw [eq_div_iff huO0, ← map_mul]
      congr 1
      apply Subtype.ext
      show (X : v.adicCompletion K) / u₀ * uO = X
      rw [huO]
      field_simp
    obtain ⟨zb, ⟨wb, hwb⟩, ⟨sb, hsb⟩⟩ :=
      finiteField_exists_isSquare_div_pair hk (r αO) (r βO) (r uO) hA hB hAB huOns
    obtain ⟨z, hz⟩ := hr zb
    unfold IsDescentClass
    by_cases hw0 : wb = 0
    · 
      have hzA : zb ^ 2 + r αO = 0 := by
        rw [hw0, mul_zero, div_eq_zero_iff] at hwb
        exact hwb.resolve_right huO0
      have hneg : r (-αO) = zb * zb := by
        rw [map_neg]
        linear_combination -hzA
      have hzb : zb ≠ 0 := by
        intro h
        apply hA
        rw [h] at hzA
        simpa using hzA
      obtain ⟨a, ha⟩ := hsq (-αO) (by rw [hneg]; exact mul_ne_zero hzb hzb) ⟨zb, hneg⟩
      have ha' : -(t₁ - t₂) = a * a := by
        rw [← hαO]
        exact ha
      obtain ⟨Y, hYc, hYr⟩ := rdiv γO
      have hY : r Y = sb * sb := by
        rw [hYr, ← hBA, ← hsb]
        congr 1
        linear_combination -hzA
      have hY0 : r Y ≠ 0 := by
        rw [hYr]
        exact div_ne_zero hγ0 huO0
      obtain ⟨b, hb⟩ := hsq Y hY0 ⟨sb, hY⟩
      have hb' : t₂ - t₃ = b * b * u₀ := by
        rw [← div_eq_iff hu₀, ← hγO, ← hYc]
        exact hb
      refine ⟨1, a, 0, b, by simp, ?_, ?_⟩
      · linear_combination -ha'
      · linear_combination -ha' + hb'
    by_cases hs0 : sb = 0
    · 
      have hzB : zb ^ 2 + r βO = 0 := by
        rw [hs0, mul_zero, div_eq_zero_iff] at hsb
        exact hsb.resolve_right huO0
      have hneg : r (-βO) = zb * zb := by
        rw [map_neg]
        linear_combination -hzB
      have hzb : zb ≠ 0 := by
        intro h
        apply hB
        rw [h] at hzB
        simpa using hzB
      obtain ⟨a, ha⟩ := hsq (-βO) (by rw [hneg]; exact mul_ne_zero hzb hzb) ⟨zb, hneg⟩
      have ha' : -(t₁ - t₃) = a * a := by
        rw [← hβO]
        exact ha
      obtain ⟨Y, hYc, hYr⟩ := rdiv (-γO)
      have hY : r Y = wb * wb := by
        rw [hYr, map_neg, ← hBA, ← hwb]
        congr 1
        linear_combination -hzB
      have hY0 : r Y ≠ 0 := by
        rw [hYr, map_neg]
        exact div_ne_zero (neg_ne_zero.mpr hγ0) huO0
      obtain ⟨b, hb⟩ := hsq Y hY0 ⟨wb, hY⟩
      have hb' : -(t₂ - t₃) = b * b * u₀ := by
        rw [← div_eq_iff hu₀, ← hγO]
        exact hYc.symm.trans hb
      refine ⟨1, a, b, 0, by simp, ?_, ?_⟩
      · linear_combination -ha' + hb'
      · linear_combination -ha'
    · 
      obtain ⟨XA, hXAc, hXAr⟩ := rdiv (z * z + αO)
      have hXA : r XA = wb * wb := by
        rw [hXAr, map_add, map_mul, hz, ← hwb, pow_two]
      obtain ⟨a, ha⟩ := hsq XA (by rw [hXA]; exact mul_ne_zero hw0 hw0) ⟨wb, hXA⟩
      have ha' : (z : v.adicCompletion K) * z + (t₁ - t₂) = a * a * u₀ := by
        rw [← div_eq_iff hu₀, ← hαO]
        exact hXAc.symm.trans ha
      obtain ⟨XB, hXBc, hXBr⟩ := rdiv (z * z + βO)
      have hXB : r XB = sb * sb := by
        rw [hXBr, map_add, map_mul, hz, ← hsb, pow_two]
      obtain ⟨b, hb⟩ := hsq XB (by rw [hXB]; exact mul_ne_zero hs0 hs0) ⟨sb, hXB⟩
      have hb' : (z : v.adicCompletion K) * z + (t₁ - t₃) = b * b * u₀ := by
        rw [← div_eq_iff hu₀, ← hβO]
        exact hXBc.symm.trans hb
      refine ⟨1, z, a, b, by simp, ?_, ?_⟩
      · linear_combination ha'
      · linear_combination hb'
  
  have hcls : ∀ u : v.adicCompletion K, u ≠ 0 → IsDescentClass t₁ t₂ t₃ 1 u →
      IsSquare u ∨ IsSquare (u * u₀) := by
    intro u hu hD
    have hsv : ∃ s : v.adicCompletion K, Valued.v u = Valued.v s ^ 2 := by
      obtain ⟨z₀, z₁, z₂, z₃, hnt, h1, h2⟩ := hD
      by_cases hz₀ : z₀ = 0
      · subst hz₀
        by_cases hz₂ : z₂ = 0
        · by_cases hz₃ : z₃ = 0
          · exfalso
            subst hz₂ hz₃
            apply hnt
            refine ⟨rfl, ?_, rfl, rfl⟩
            have h1' : z₁ ^ 2 = 0 := by linear_combination h1
            exact pow_eq_zero_iff two_ne_zero |>.mp h1'
          · refine ⟨z₁ / z₃, ?_⟩
            have e : u = (z₁ / z₃) ^ 2 := by
              rw [div_pow, eq_div_iff (pow_ne_zero 2 hz₃)]
              linear_combination -h2
            rw [e, map_pow]
        · refine ⟨z₁ / z₂, ?_⟩
          have e : u = (z₁ / z₂) ^ 2 := by
            rw [div_pow, eq_div_iff (pow_ne_zero 2 hz₂)]
            linear_combination -h1
          rw [e, map_pow]
      · by_contra H
        push_neg at H
        have e1 : (z₁ / z₀) ^ 2 - u * (z₂ / z₀) ^ 2 = t₂ - t₁ := by
          field_simp
          linear_combination h1
        have e2 : (z₁ / z₀) ^ 2 - u * (z₃ / z₀) ^ 2 = t₃ - t₁ := by
          field_simp
          linear_combination h2
        generalize z₁ / z₀ = x at e1 e2
        generalize z₂ / z₀ = y at e1 e2
        generalize z₃ / z₀ = w at e1 e2
        have key : ∀ (y c : v.adicCompletion K), Valued.v c = 1 → x ^ 2 - u * y ^ 2 = c →
            Valued.v (u * y ^ 2) < 1 := by
          intro y c hc e
          by_cases hy : y = 0
          · rw [hy]
            simp
          rcases lt_trichotomy (Valued.v (u * y ^ 2)) (Valued.v (x ^ 2)) with hlt | heq | hgt
          · have h' := Valuation.map_sub_eq_of_lt_left _ hlt
            rw [e, hc] at h'
            rw [← h'] at hlt
            exact hlt
          · exfalso
            apply H (x / y)
            rw [map_mul, map_pow, map_pow] at heq
            rw [map_div₀, div_pow,
              eq_div_iff (pow_ne_zero _ ((Valuation.ne_zero_iff _).mpr hy))]
            exact heq
          · exfalso
            have h' := Valuation.map_sub_eq_of_lt_right _ hgt
            rw [e, hc, map_mul, map_pow] at h'
            apply H y⁻¹
            rw [map_inv₀, inv_pow]
            exact eq_inv_of_mul_eq_one_left h'.symm
        have h21 : Valued.v (t₂ - t₁) = 1 := by rw [Valuation.map_sub_swap]; exact hα'
        have h31 : Valued.v (t₃ - t₁) = 1 := by rw [Valuation.map_sub_swap]; exact hβ'
        have hy' := key y _ h21 e1
        have hw' := key w _ h31 e2
        have e3 : t₂ - t₃ = u * w ^ 2 - u * y ^ 2 := by linear_combination e2 - e1
        have hle := Valuation.map_sub Valued.v (u * w ^ 2) (u * y ^ 2)
        rw [← e3, hγ'] at hle
        exact absurd (lt_of_le_of_lt hle (max_lt hw' hy')) (lt_irrefl _)
    obtain ⟨s, hs⟩ := hsv
    have hs0 : s ≠ 0 := by
      rintro rfl
      apply hu
      rw [map_zero, zero_pow two_ne_zero] at hs
      exact (Valuation.zero_iff _).mp hs
    have hvs : Valued.v s ≠ 0 := (Valuation.ne_zero_iff _).mpr hs0
    have hwv : Valued.v (u / (s * s)) = 1 := by
      rw [map_div₀, map_mul, hs, pow_two]
      exact div_self (mul_ne_zero hvs hvs)
    rcases hdich _ hwv with ⟨m, hm⟩ | ⟨m, hm⟩
    · left
      refine ⟨m * s, ?_⟩
      have e : u = u / (s * s) * (s * s) := by field_simp
      rw [e, hm]
      ring
    · right
      refine ⟨m * s, ?_⟩
      have e : u * u₀ = u / (s * s) * u₀ * (s * s) := by field_simp
      rw [e, hm]
      ring
  
  have hne : sqCl (1 : (v.adicCompletion K)ˣ) ≠ sqCl (Units.mk0 u₀ hu₀) := by
    intro h
    unfold sqCl at h
    rw [QuotientGroup.eq, MonoidHom.mem_range] at h
    obtain ⟨c, hc⟩ := h
    apply hns
    refine ⟨(c : v.adicCompletion K), ?_⟩
    have hc' := congrArg Units.val hc
    simp only [powMonoidHom_apply, Units.val_pow_eq_pow_val, inv_one, one_mul,
      Units.val_mk0] at hc'
    rw [← hc', pow_two]
  have himg : phiImg (v.adicCompletion K) t₁ t₂ t₃ =
      {sqCl 1, sqCl (Units.mk0 u₀ hu₀)} := by
    ext c
    simp only [phiImg, Set.mem_setOf_eq, Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · rintro ⟨u, rfl, hD⟩
      rcases hcls u u.ne_zero hD with ⟨m, hm⟩ | ⟨m, hm⟩
      · left
        have hm0 : m ≠ 0 := by
          rintro rfl
          exact u.ne_zero (by rw [hm, mul_zero])
        refine Eq.symm ?_
        unfold sqCl
        rw [QuotientGroup.eq, MonoidHom.mem_range]
        refine ⟨Units.mk0 m hm0, ?_⟩
        ext
        simp only [powMonoidHom_apply, Units.val_pow_eq_pow_val, Units.val_mk0, inv_one,
          one_mul]
        rw [hm, pow_two]
      · right
        have hm0 : m ≠ 0 := by
          rintro rfl
          exact mul_ne_zero u.ne_zero hu₀ (by rw [hm, mul_zero])
        refine Eq.symm ?_
        unfold sqCl
        rw [QuotientGroup.eq, MonoidHom.mem_range]
        refine ⟨Units.mk0 (m / u₀) (div_ne_zero hm0 hu₀), ?_⟩
        ext
        simp only [powMonoidHom_apply, Units.val_pow_eq_pow_val, Units.val_mk0, Units.val_mul,
          Units.val_inv_eq_inv_val]
        rw [div_pow, pow_two m, ← hm, pow_two, mul_div_mul_right _ _ hu₀, inv_mul_eq_div]
    · rintro (rfl | rfl)
      · refine ⟨1, rfl, ?_⟩
        unfold IsDescentClass
        exact ⟨0, 1, 1, 1, by simp, by simp, by simp⟩
      · refine ⟨Units.mk0 u₀ hu₀, rfl, ?_⟩
        rw [Units.val_mk0]
        exact hdesc
  unfold phiSign
  refine if_neg ?_
  rintro ⟨n, hn, hev⟩
  rw [himg, Set.encard_pair hne] at hn
  have h2n : (2 : ℕ) = 2 ^ n := by exact_mod_cast hn
  have hn1 : n = 1 := Nat.pow_right_injective le_rfl (h2n.symm.trans (pow_one 2).symm)
  subst hn1
  exact Nat.not_even_one hev

theorem global_isotropy_KT2 {K : Type u} [Field K] [NumberField K]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (hT2 : ∀ v, v ∉ T → IsDedekindDomain.HeightOneSpectrum.valuation K v 2 = 1)
    (x y : Kˣ) (hx : ∀ v, v ∉ T → EvenVal v x) (hy : ∀ v, v ∉ T → EvenVal v y) :
    (∏ v ∈ T, hilbSym (v.adicCompletion K) (algebraMap K _ (x : K)) (algebraMap K _ (y : K))) *
      ∏ w : NumberField.InfinitePlace K,
        hilbSym w.Completion (algebraMap K _ (x : K)) (algebraMap K _ (y : K)) = 1 :=
by
  classical
  
  have approx : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (a : K),
      IsDedekindDomain.HeightOneSpectrum.valuation K v a ≤ 1 →
      ∃ r : NumberField.RingOfIntegers K,
        IsDedekindDomain.HeightOneSpectrum.valuation K v
          (a - algebraMap (NumberField.RingOfIntegers K) K r) < 1 := by
    intro v a ha
    obtain ⟨x, y, hy, hxy⟩ :=
      IsFractionRing.div_surjective (A := NumberField.RingOfIntegers K) (K := K) a
    have hy0 : y ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hy
    have hiy : algebraMap (NumberField.RingOfIntegers K) K y ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hy
    have hstar : a * algebraMap (NumberField.RingOfIntegers K) K y
        = algebraMap (NumberField.RingOfIntegers K) K x := by
      rw [← hxy]
      exact div_mul_cancel₀ _ hiy
    obtain ⟨m, hym, hym1⟩ : ∃ m : ℕ, y ∈ v.asIdeal ^ m ∧ y ∉ v.asIdeal ^ (m + 1) := by
      have ht0 : v.intValuation y ≠ 0 :=
        IsDedekindDomain.HeightOneSpectrum.intValuation_ne_zero v y hy0
      have ht1 : v.intValuation y ≤ 1 :=
        IsDedekindDomain.HeightOneSpectrum.intValuation_le_one v y
      obtain ⟨k, hk⟩ : ∃ k : ℤ, WithZero.exp k = v.intValuation y := ⟨_, WithZero.exp_log ht0⟩
      have hkle : k ≤ 0 := by
        have hstep : WithZero.exp k ≤ WithZero.exp (0 : ℤ) := by
          rw [hk, WithZero.exp_zero]; exact ht1
        exact WithZero.exp_le_exp.mp hstep
      have hcast : (((-k).toNat : ℕ) : ℤ) = -k := Int.toNat_of_nonneg (by omega)
      have hexpm : WithZero.exp (-(((-k).toNat : ℕ) : ℤ)) = v.intValuation y := by
        rw [hcast, neg_neg, hk]
      refine ⟨(-k).toNat, ?_, ?_⟩
      · exact (IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_mem v y _).mp
          (le_of_eq hexpm.symm)
      · intro hcon
        have hle :=
          (IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_mem v y
            ((-k).toNat + 1)).mpr hcon
        have he : (-(((-k).toNat + 1 : ℕ) : ℤ)) = k - 1 := by
          rw [Nat.cast_add, Nat.cast_one, hcast]; ring
        rw [he, ← hk] at hle
        have := WithZero.exp_le_exp.mp hle
        omega
    have hivy : v.intValuation y ≤ WithZero.exp (-(m : ℤ)) :=
      (IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_mem v y m).mpr hym
    have hxm : x ∈ v.asIdeal ^ m := by
      refine (IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_mem v x m).mp ?_
      have e1 : v.intValuation x
          = IsDedekindDomain.HeightOneSpectrum.valuation K v
              (algebraMap (NumberField.RingOfIntegers K) K x) :=
        (IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap (K := K) v x).symm
      have e2 : v.intValuation y
          = IsDedekindDomain.HeightOneSpectrum.valuation K v
              (algebraMap (NumberField.RingOfIntegers K) K y) :=
        (IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap (K := K) v y).symm
      calc v.intValuation x
          = IsDedekindDomain.HeightOneSpectrum.valuation K v
              (a * algebraMap (NumberField.RingOfIntegers K) K y) := by
            rw [hstar]; exact e1
        _ = IsDedekindDomain.HeightOneSpectrum.valuation K v a *
              IsDedekindDomain.HeightOneSpectrum.valuation K v
                (algebraMap (NumberField.RingOfIntegers K) K y) := Valuation.map_mul _ _ _
        _ ≤ 1 * IsDedekindDomain.HeightOneSpectrum.valuation K v
                (algebraMap (NumberField.RingOfIntegers K) K y) := mul_le_mul_right' ha _
        _ = v.intValuation y := by rw [one_mul, ← e2]
        _ ≤ WithZero.exp (-(m : ℤ)) := hivy
    have hPprime : Prime v.asIdeal := Ideal.prime_of_isPrime v.ne_bot v.isPrime
    have hJdvd : (Ideal.span {y} ⊔ v.asIdeal ^ (m + 1)) ∣ v.asIdeal ^ (m + 1) :=
      Ideal.dvd_iff_le.mpr le_sup_right
    obtain ⟨i, hi, hassoc⟩ := (dvd_prime_pow hPprime (m + 1)).mp hJdvd
    have hJ : Ideal.span {y} ⊔ v.asIdeal ^ (m + 1) = v.asIdeal ^ i := associated_iff_eq.mp hassoc
    have hyJ : y ∈ v.asIdeal ^ i := by
      rw [← hJ]
      exact Ideal.dvd_span_singleton.mp (Ideal.dvd_iff_le.mpr le_sup_left)
    have him : i ≤ m := by
      by_contra hcon
      have hii : i = m + 1 := by omega
      rw [hii] at hyJ
      exact hym1 hyJ
    have hxJ : x ∈ Ideal.span {y} ⊔ v.asIdeal ^ (m + 1) := by
      rw [hJ]
      exact Ideal.pow_le_pow_right him hxm
    obtain ⟨p, hp, w, hw, hpw⟩ := Submodule.mem_sup.mp hxJ
    obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp hp
    refine ⟨r, ?_⟩
    have hxrw : x = r * y + w := by rw [← hpw, hr]
    have key : (a - algebraMap (NumberField.RingOfIntegers K) K r)
        * algebraMap (NumberField.RingOfIntegers K) K y
        = algebraMap (NumberField.RingOfIntegers K) K w := by
      have h1 : algebraMap (NumberField.RingOfIntegers K) K x
          = algebraMap (NumberField.RingOfIntegers K) K r
              * algebraMap (NumberField.RingOfIntegers K) K y
            + algebraMap (NumberField.RingOfIntegers K) K w := by
        rw [hxrw, map_add, map_mul]
      rw [sub_mul, hstar, h1]; ring
    have hV : IsDedekindDomain.HeightOneSpectrum.valuation K v
          (a - algebraMap (NumberField.RingOfIntegers K) K r) * v.intValuation y
        = v.intValuation w := by
      rw [← IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap (K := K) v y,
        ← IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap (K := K) v w,
        ← Valuation.map_mul, key]
    have hwb : v.intValuation w ≤ WithZero.exp (-((m + 1 : ℕ) : ℤ)) :=
      (IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_mem v w (m + 1)).mpr hw
    have hyb : WithZero.exp (-((m + 1 : ℕ) : ℤ)) < v.intValuation y := by
      by_contra hcon
      push_neg at hcon
      exact hym1
        ((IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_mem v y (m + 1)).mp hcon)
    by_contra hcon
    push_neg at hcon
    have hchain : v.intValuation y ≤ v.intValuation w := by
      calc v.intValuation y = 1 * v.intValuation y := (one_mul _).symm
        _ ≤ IsDedekindDomain.HeightOneSpectrum.valuation K v
              (a - algebraMap (NumberField.RingOfIntegers K) K r) * v.intValuation y :=
            mul_le_mul_right' hcon _
        _ = v.intValuation w := hV
    exact absurd (lt_of_le_of_lt (le_trans hchain hwb) hyb) (lt_irrefl _)
  
  have quad : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      (2 : NumberField.RingOfIntegers K) ∉ v.asIdeal →
      ∀ (r s : NumberField.RingOfIntegers K), r ∉ v.asIdeal → s ∉ v.asIdeal →
      ∃ x y : NumberField.RingOfIntegers K, r * x ^ 2 + s * y ^ 2 - 1 ∈ v.asIdeal := by
    intro v h2 r s hr hs
    letI : Field (NumberField.RingOfIntegers K ⧸ v.asIdeal) := Ideal.Quotient.field v.asIdeal
    letI : Fintype (NumberField.RingOfIntegers K ⧸ v.asIdeal) := Fintype.ofFinite _
    have hr' : Ideal.Quotient.mk v.asIdeal r ≠ 0 := fun h =>
      hr (Ideal.Quotient.eq_zero_iff_mem.mp h)
    have hs' : Ideal.Quotient.mk v.asIdeal s ≠ 0 := fun h =>
      hs (Ideal.Quotient.eq_zero_iff_mem.mp h)
    have h2' : (2 : NumberField.RingOfIntegers K ⧸ v.asIdeal) ≠ 0 := by
      intro h
