  have hF := F1 X Y L hXi hYi hLi hXc hYc hLc
  rw [hb] at hF
  obtain ⟨t, ht⟩ := (IsPGroup.iff_card (p := 2) (G := ↥(X ⊓ Y ⊓ L))).mp
    (fun g => ⟨1, Subtype.ext (by rw [pow_one]; exact hW2 g.1)⟩)
  rw [ht] at hF
  have hP0X : ∀ x ∈ ((X ⊓ Y) ⊔ (X ⊓ L) : Subgroup W), x ∈ X := by
    intro x hx
    obtain ⟨i, hi, j, hj, rfl⟩ := Subgroup.mem_sup.mp hx
    exact X.mul_mem (Subgroup.mem_inf.mp hi).1 (Subgroup.mem_inf.mp hj).1
  have hRadiff : ∀ p : W × W, (p ∈ S ∧ ∀ s' ∈ S, B p.1 s'.2 = 1) ↔
      (p.1 ∈ ((X ⊓ Y) ⊔ (X ⊓ L) : Subgroup W) ∧ p.2 ∈ Y ∧ p.1 * p.2 ∈ L) := by
    intro p
    constructor
    · rintro ⟨hp, hrad⟩
      obtain ⟨hx, hy, hxy⟩ := (hS p).mp hp
      refine ⟨s6 p.1 hx (fun y' hy' => ?_), hy, hxy⟩
      obtain ⟨hy'Y, hy'XL⟩ := Subgroup.mem_inf.mp hy'
      obtain ⟨x', hx', l', hl', hxl⟩ := Subgroup.mem_sup.mp hy'XL
      have hmem : (x', y') ∈ S := (hS _).mpr ⟨hx', hy'Y, by
        show x' * y' ∈ L
        rw [← hxl, ← mul_assoc, msq, one_mul]
        exact hl'⟩
      exact hrad _ hmem
    · rintro ⟨hx0, hy, hxy⟩
      refine ⟨(hS p).mpr ⟨hP0X _ hx0, hy, hxy⟩, fun s' hs' => ?_⟩
      obtain ⟨hs1, hs2, hs3⟩ := (hS s').mp hs'
      obtain ⟨i, hi, j, hj, hij⟩ := Subgroup.mem_sup.mp hx0
      rw [Subgroup.mem_inf] at hi hj
      have e : s'.2 = s'.1 * (s'.1 * s'.2) := by rw [← mul_assoc, msq, one_mul]
      rw [← hij, hBmul, hYi i hi.2 _ hs2, one_mul, e, Bmulr, hXi j hj.1 _ hs1, hLi j hj.2 _ hs3,
        one_mul]
  have hR : Nat.card {s : W × W // s ∈ S ∧ ∀ s' ∈ S, B s.1 s'.2 = 1} =
      Nat.card ((X ⊓ Y) ⊔ (X ⊓ L) : Subgroup W) * 2 ^ b := by
    have hle : ((X ⊓ Y) ⊔ (X ⊓ L) : Subgroup W) ≤ Y ⊔ L :=
      sup_le (le_trans inf_le_right le_sup_left) (le_trans inf_le_right le_sup_right)
    rw [Nat.card_congr (Equiv.subtypeEquivRight hRadiff), cnt, hb, inf_eq_left.mpr hle]
  have hP := prodf (X ⊓ Y) (X ⊓ L)
  have hinf : (X ⊓ Y) ⊓ (X ⊓ L) = X ⊓ Y ⊓ L := by
    ext z
    simp only [Subgroup.mem_inf]
    tauto
  have hc' : Nat.card (X ⊓ L : Subgroup W) = 2 ^ c := by rw [inf_comm]; exact hc
  rw [hinf, ht, ha, hc'] at hP
  rw [hR] at hr
  have key : 2 ^ (m + 2 * t) = 2 ^ (2 * r + a + b + c) := by
    have e4 : (4 : ℕ) ^ r = 2 ^ (2 * r) := by rw [pow_mul]; norm_num
    calc 2 ^ (m + 2 * t) = 2 ^ m * 2 ^ t * 2 ^ t := by ring
      _ = Nat.card (X ⊓ (Y ⊔ L) : Subgroup W) * 2 ^ b * 2 ^ t := by rw [hF]
      _ = Nat.card S * 2 ^ t := by rw [hSc]
      _ = 4 ^ r * (Nat.card ((X ⊓ Y) ⊔ (X ⊓ L) : Subgroup W) * 2 ^ t) * 2 ^ b := by rw [hr]; ring
      _ = 4 ^ r * (2 ^ a * 2 ^ c) * 2 ^ b := by rw [hP]
      _ = 2 ^ (2 * r + a + b + c) := by rw [e4]; ring
  have hexp : m + 2 * t = 2 * r + a + b + c := Nat.pow_right_injective le_rfl key
  have hsq : ((-1 : ℤˣ)) ^ 2 = 1 := Int.units_sq _
  calc (-1 : ℤˣ) ^ (a + b + c) = (-1) ^ (a + b + c) * ((-1) ^ 2) ^ r := by
        rw [hsq, one_pow, mul_one]
    _ = (-1) ^ (2 * r + a + b + c) := by
        rw [← pow_mul, ← pow_add]
        congr 1
        ring
    _ = (-1) ^ (m + 2 * t) := by rw [hexp]
    _ = (-1) ^ m := by rw [pow_add, pow_mul, hsq, one_pow, mul_one]

theorem local_descent_lagrangian_card {V : Type*} [CommGroup V] [Finite V] [DecidableEq V]
    (hV2 : ∀ x : V, x ^ 2 = 1) (P : V → V → ℤˣ)
    (hPmul : ∀ x x' y : V, P (x * x') y = P x y * P x' y)
    (hPsymm : ∀ x y : V, P x y = P y x)
    (Z : Set (V × V)) (hZmul : ∀ p ∈ Z, ∀ q ∈ Z, p * q ∈ Z) (a c h : V)
    (hR3 : ∀ d ∈ Z, P d.1 d.2 = P d.1 a * P d.2 c)
    (hch : (c, h) ∈ Z) :
    Nat.card {d : V × V // d ∈ Z ∧ (d.1 = 1 ∨ d.1 = c) ∧ P d.2 c = 1} =
      (if c ≠ 1 ∧ P c h = 1 then 2 else 1) * Nat.card {x : V // ((1 : V), x) ∈ Z} :=
by
  classical
  have F1 : ∀ y, P 1 y = 1 := fun y => by
    have h := hPmul 1 1 y
    rw [one_mul] at h
    exact left_eq_mul.mp h
  have F2 : ∀ x : V, x * x = 1 := fun x => by rw [← pow_two]; exact hV2 x
  have F3 : ∀ x, ((1 : V), x) ∈ Z → P x c = 1 := fun x hx => by
    have h := hR3 _ hx
    dsimp only at h
    rw [F1, F1, one_mul] at h
    exact h.symm
  have F4 : ∀ x, ((1 : V), x) ∈ Z → (c, x * h) ∈ Z := fun x hx => by
    have h' := hZmul _ hx _ hch
    rw [Prod.mk_mul_mk, one_mul] at h'
    exact h'
  have F5 : ∀ x, (c, x) ∈ Z → ((1 : V), x * h) ∈ Z := fun x hx => by
    have h' := hZmul _ hx _ hch
    rw [Prod.mk_mul_mk, F2] at h'
    exact h'
  have hmem : ∀ d : V × V, d ∈ Z → ∀ u : V, d.1 = u → (u, d.2) ∈ Z := by
    intro d hd u hu
    rw [← hu]
    exact hd
  have e := (Equiv.sumCompl (fun s : {d : V × V // d ∈ Z ∧ (d.1 = 1 ∨ d.1 = c) ∧
    P d.2 c = 1} => s.1.1 = 1)).symm
  rw [Nat.card_congr e, Nat.card_sum]
  have hA : Nat.card {s : {d : V × V // d ∈ Z ∧ (d.1 = 1 ∨ d.1 = c) ∧ P d.2 c = 1} //
      s.1.1 = 1} = Nat.card {x : V // ((1 : V), x) ∈ Z} := by
    apply Nat.card_congr
    exact
      { toFun := fun s => ⟨s.1.1.2, hmem s.1.1 s.1.2.1 1 s.2⟩
        invFun := fun x => ⟨⟨(1, x.1), x.2, Or.inl rfl, F3 x.1 x.2⟩, rfl⟩
        left_inv := fun s => Subtype.ext (Subtype.ext (Prod.ext s.2.symm rfl))
        right_inv := fun x => rfl }
  have hB : Nat.card {s : {d : V × V // d ∈ Z ∧ (d.1 = 1 ∨ d.1 = c) ∧ P d.2 c = 1} //
      ¬ s.1.1 = 1} = if c ≠ 1 ∧ P c h = 1 then Nat.card {x : V // ((1 : V), x) ∈ Z} else 0 := by
    have hc : ∀ s : {s : {d : V × V // d ∈ Z ∧ (d.1 = 1 ∨ d.1 = c) ∧ P d.2 c = 1} //
        ¬ s.1.1 = 1}, s.1.1.1 = c := fun s => s.1.2.2.1.resolve_left s.2
    by_cases hq : c ≠ 1 ∧ P c h = 1
    · rw [if_pos hq]
      apply Nat.card_congr
      exact
        { toFun := fun s => ⟨s.1.1.2 * h, F5 _ (hmem s.1.1 s.1.2.1 c (hc s))⟩
          invFun := fun x => ⟨⟨(c, x.1 * h), F4 x.1 x.2, Or.inr rfl,
            by rw [hPmul, F3 x.1 x.2, hPsymm, hq.2, one_mul]⟩, hq.1⟩
          left_inv := fun s => Subtype.ext (Subtype.ext (Prod.ext (hc s).symm
            (show s.1.1.2 * h * h = s.1.1.2 by rw [mul_assoc, F2, mul_one])))
          right_inv := fun x => Subtype.ext
            (show x.1 * h * h = x.1 by rw [mul_assoc, F2, mul_one]) }
    · rw [if_neg hq]
      haveI : IsEmpty {s : {d : V × V // d ∈ Z ∧ (d.1 = 1 ∨ d.1 = c) ∧ P d.2 c = 1} //
          ¬ s.1.1 = 1} := by
        refine ⟨fun s => hq ⟨?_, ?_⟩⟩
        · intro h1
          exact s.2 ((hc s).trans h1)
        · have h1 := F3 _ (F5 _ (hmem s.1.1 s.1.2.1 c (hc s)))
          rw [hPmul, s.1.2.2.2, one_mul] at h1
          rw [hPsymm]
          exact h1
      exact Nat.card_of_isEmpty
  rw [hA, hB]
  split_ifs <;> omega

theorem lagrangian_inter_orth_card {V : Type*} [CommGroup V] [Finite V]
    (hV2 : ∀ x : V, x ^ 2 = 1) (P : V → V → ℤˣ)
    (hPmul : ∀ x x' y : V, P (x * x') y = P x y * P x' y)
    (hPsymm : ∀ x y : V, P x y = P y x)
    (hPnd : ∀ x : V, (∀ y, P x y = 1) → x = 1)
    (G M : Subgroup V) (hiso : ∀ g ∈ G, ∀ h ∈ G, P g h = 1)
    (hGcard : Nat.card G * Nat.card G = Nat.card V) :
    Nat.card {x : V // x ∈ G ∧ ∀ m ∈ M, P x m = 1} * Nat.card M =
      Nat.card G * Nat.card (G ⊓ M : Subgroup V) :=
by
  classical
  
  have ha : 0 < Nat.card G := Nat.card_pos
  
  have hOG : Nat.card {x : V // ∀ h ∈ G, P x h = 1} = Nat.card G := by
    have h1 := pairing_card_mul_card_orth hV2 P hPmul hPsymm hPnd G
    rw [← hGcard] at h1
    exact Nat.eq_of_mul_eq_mul_left ha h1
  
  have s3 : ∀ x : V, (∀ h ∈ G, P x h = 1) → x ∈ G := by
    intro x hx
    let ι : G → {x : V // ∀ h ∈ G, P x h = 1} := fun g => ⟨(g : V), fun h hh => hiso g g.2 h hh⟩
    have hinj : Function.Injective ι := by
      intro g g' he
      have he' : (g : V) = (g' : V) :=
        congrArg (fun y : {x : V // ∀ h ∈ G, P x h = 1} => (y : V)) he
      exact Subtype.ext he'
    have hbij : Function.Bijective ι :=
      hinj.bijective_of_nat_card_le (le_of_eq hOG)
    obtain ⟨g, hg⟩ := hbij.2 ⟨x, hx⟩
    have : (g : V) = x := congrArg Subtype.val hg
    rw [← this]; exact g.2
  
  have s4 : ∀ x : V, (x ∈ G ∧ ∀ m ∈ M, P x m = 1) ↔ ∀ h ∈ G ⊔ M, P x h = 1 := by
    intro x
    constructor
    · rintro ⟨hxG, hxM⟩ h hh
      obtain ⟨y, hy, z, hz, rfl⟩ := Subgroup.mem_sup.mp hh
      rw [hPsymm, hPmul, hPsymm y, hPsymm z, hiso x hxG y hy, hxM z hz, one_mul]
    · intro hx
      exact ⟨s3 x (fun g hg => hx g (le_sup_left (a := G) (b := M) hg)),
        fun m hm => hx m (le_sup_right (a := G) (b := M) hm)⟩
  have hcard4 : Nat.card {x : V // x ∈ G ∧ ∀ m ∈ M, P x m = 1} =
      Nat.card {x : V // ∀ h ∈ G ⊔ M, P x h = 1} :=
    Nat.card_congr (Equiv.subtypeEquivRight s4)
  
  have genid : ∀ X Y : Subgroup V, Nat.card (X ⊓ Y : Subgroup V) * X.relIndex Y = Nat.card Y := by
    intro X Y
    have h := Subgroup.relIndex_mul_relIndex (⊥ : Subgroup V) (X ⊓ Y) Y bot_le inf_le_right
    rw [Subgroup.relIndex_bot_left, Subgroup.relIndex_bot_left,
      Subgroup.inf_relIndex_right] at h
    exact h
  have hb : Nat.card M * M.relIndex G = Nat.card (G ⊔ M : Subgroup V) := by
    have h := genid M (G ⊔ M)
    rw [inf_eq_left.mpr (le_sup_right : M ≤ G ⊔ M), Subgroup.relIndex_sup_right] at h
    exact h
  have hc : Nat.card (G ⊓ M : Subgroup V) * M.relIndex G = Nat.card G := by
    have h := genid M G
    rw [inf_comm] at h
    exact h
  have s2 : Nat.card (G ⊔ M : Subgroup V) * Nat.card (G ⊓ M : Subgroup V) =
      Nat.card G * Nat.card M := by
    rw [← hb, ← hc]; ring
  have s1 := pairing_card_mul_card_orth hV2 P hPmul hPsymm hPnd (G ⊔ M)
  rw [hcard4]
  apply Nat.eq_of_mul_eq_mul_left ha
  calc Nat.card G * (Nat.card {x : V // ∀ h ∈ G ⊔ M, P x h = 1} * Nat.card M)
      = Nat.card {x : V // ∀ h ∈ G ⊔ M, P x h = 1} * (Nat.card G * Nat.card M) := by ring
    _ = Nat.card {x : V // ∀ h ∈ G ⊔ M, P x h = 1} *
          (Nat.card (G ⊔ M : Subgroup V) * Nat.card (G ⊓ M : Subgroup V)) := by rw [s2]
    _ = (Nat.card (G ⊔ M : Subgroup V) * Nat.card {x : V // ∀ h ∈ G ⊔ M, P x h = 1}) *
          Nat.card (G ⊓ M : Subgroup V) := by ring
    _ = Nat.card G * (Nat.card G * Nat.card (G ⊓ M : Subgroup V)) := by
          rw [s1, ← hGcard]; ring

theorem selmer_parity_abstract {ι : Type*} [Fintype ι]
    {V : ι → Type*} [∀ i, CommGroup (V i)]
    (hV2 : ∀ i (x : V i), x ^ 2 = 1)
    (P : ∀ i, V i → V i → ℤˣ)
    (hPmul : ∀ i (x x' y : V i), P i (x * x') y = P i x y * P i x' y)
    (hPsymm : ∀ i (x y : V i), P i x y = P i y x)
    (hPnd : ∀ i (x : V i), (∀ y, P i x y = 1) → x = 1)
    (Z : ∀ i, Set (V i × V i))
    (hZone : ∀ i, (1 : V i × V i) ∈ Z i)
    (hZmul : ∀ i, ∀ p ∈ Z i, ∀ q ∈ Z i, p * q ∈ Z i)
    (hZcard : ∀ i, (Z i).ncard = Nat.card (V i))
    {A : Type*} [CommGroup A] (hA2 : ∀ g : A, g ^ 2 = 1)
    (G : Set A) (hG1 : (1 : A) ∈ G) (hGmul : ∀ g ∈ G, ∀ h ∈ G, g * h ∈ G)
    (ρ : ∀ i, A →* V i)
    (hρinj : ∀ g ∈ G, (∀ i, ρ i g = 1) → g = 1)
    (n : ℕ) (hGcard : G.ncard = 2 ^ n)
    (hVcard : ∏ i, Nat.card (V i) = 4 ^ n)
    (hiso : ∀ g ∈ G, ∀ h ∈ G, ∏ i, P i (ρ i g) (ρ i h) = 1)
    (a c : A) (ha : a ∈ G) (hcG : c ∈ G)
    (hR3 : ∀ i, ∀ d ∈ Z i, P i d.1 d.2 = P i d.1 (ρ i a) * P i d.2 (ρ i c))
    (hc : ∃ h ∈ G, ∀ i, (ρ i c, ρ i h) ∈ Z i) :
    ∃ (d : ℕ) (k : ι → ℕ),
      {p : A × A | p.1 ∈ G ∧ p.2 ∈ G ∧ ∀ i, (ρ i p.1, ρ i p.2) ∈ Z i}.encard = 2 ^ d ∧
      (∀ i, {x : V i | ((1 : V i), x) ∈ Z i}.encard = 2 ^ k i) ∧
      (-1 : ℤˣ) ^ d = (-1) ^ n * ∏ i, (-1 : ℤˣ) ^ k i :=
by
  classical
  have usq : ∀ u : ℤˣ, u * u = 1 := Int.units_mul_self
  have hne : (-1 : ℤˣ) ≠ 1 := fun h => absurd (congrArg Units.val h) (by norm_num)
  
  have hVne : ∀ i, Nat.card (V i) ≠ 0 := by
    intro i
    have h4 : ∏ i, Nat.card (V i) ≠ 0 := by rw [hVcard]; positivity
    exact (Finset.prod_ne_zero_iff.mp h4) i (Finset.mem_univ i)
  have hVfin : ∀ i, Finite (V i) := fun i => Nat.finite_of_card_ne_zero (hVne i)
  
  have P1l : ∀ i (y : V i), P i 1 y = 1 := by
    intro i y
    have h := hPmul i 1 1 y
    rw [one_mul] at h
    exact left_eq_mul.mp h
  have P1r : ∀ i (x : V i), P i x 1 = 1 := fun i x => by rw [hPsymm]; exact P1l i x
  have Pmulr : ∀ i (x y y' : V i), P i x (y * y') = P i x y * P i x y' := by
    intro i x y y'
    rw [hPsymm, hPmul, hPsymm i y, hPsymm i y']
  
  obtain ⟨h₀, hh₀G, hh₀⟩ := hc
  have hca : ∀ i, P i (ρ i c) (ρ i a) = 1 := by
    intro i
    have h : P i (ρ i c) (ρ i h₀) = P i (ρ i c) (ρ i a) * P i (ρ i h₀) (ρ i c) :=
      hR3 i _ (hh₀ i)
    rw [hPsymm i (ρ i h₀) (ρ i c), mul_comm] at h
    exact left_eq_mul.mp h
  have hch : ∏ i, P i (ρ i c) (ρ i h₀) = 1 := hiso c hcG h₀ hh₀G
  
  have hVV2 : ∀ x : (∀ i, V i), x ^ 2 = 1 := fun x => funext fun i => by
    rw [Pi.pow_apply]; exact hV2 i (x i)
  have hW2 : ∀ w : (∀ i, V i) × (∀ i, V i), w ^ 2 = 1 := fun w =>
    Prod.ext (by simpa using hVV2 w.1) (by simpa using hVV2 w.2)
  have invV : ∀ i (x : V i), x⁻¹ = x := fun i x =>
    inv_eq_of_mul_eq_one_right (by rw [← pow_two]; exact hV2 i x)
  have invVV : ∀ x : (∀ i, V i), x⁻¹ = x := fun x =>
    inv_eq_of_mul_eq_one_right (by rw [← pow_two]; exact hVV2 x)
  have invW : ∀ w : (∀ i, V i) × (∀ i, V i), w⁻¹ = w := fun w =>
    inv_eq_of_mul_eq_one_right (by rw [← pow_two]; exact hW2 w)
  have invA : ∀ g : A, g⁻¹ = g := fun g =>
    inv_eq_of_mul_eq_one_right (by rw [← pow_two]; exact hA2 g)
  
  obtain ⟨PV, hPV⟩ : ∃ PV : (∀ i, V i) → (∀ i, V i) → ℤˣ,
      ∀ x y, PV x y = ∏ i, P i (x i) (y i) :=
    ⟨fun x y => ∏ i, P i (x i) (y i), fun _ _ => rfl⟩
  have PVmul : ∀ x x' y, PV (x * x') y = PV x y * PV x' y := by
    intro x x' y; simp only [hPV, Pi.mul_apply, hPmul, Finset.prod_mul_distrib]
  have PVmulr : ∀ x y y', PV x (y * y') = PV x y * PV x y' := by
    intro x y y'; simp only [hPV, Pi.mul_apply, Pmulr, Finset.prod_mul_distrib]
  have PVsymm : ∀ x y, PV x y = PV y x := by
    intro x y; simp only [hPV]; exact Finset.prod_congr rfl (fun i _ => hPsymm i _ _)
  have PV1l : ∀ y, PV 1 y = 1 := by
    intro y; simp only [hPV, Pi.one_apply, P1l, Finset.prod_const_one]
  have PV1r : ∀ x, PV x 1 = 1 := by
    intro x; simp only [hPV, Pi.one_apply, P1r, Finset.prod_const_one]
  have PVsingle : ∀ x i (y₀ : V i), PV x (Pi.mulSingle i y₀) = P i (x i) y₀ := by
    intro x i y₀
    rw [hPV, Finset.prod_eq_single i]
    · rw [Pi.mulSingle_eq_same]
    · intro j _ hji; rw [Pi.mulSingle_eq_of_ne hji, P1r]
    · intro hi; exact absurd (Finset.mem_univ i) hi
  have PVnd : ∀ x, (∀ y, PV x y = 1) → x = 1 := by
    intro x hx; funext i
    exact hPnd i (x i) (fun y₀ => by rw [← PVsingle]; exact hx _)
  obtain ⟨ρh, hρh⟩ : ∃ ρh : A →* (∀ i, V i), ∀ g i, ρh g i = ρ i g :=
    ⟨Pi.monoidHom ρ, fun _ _ => rfl⟩
  
  obtain ⟨B, hB⟩ : ∃ B : (∀ i, V i) × (∀ i, V i) → (∀ i, V i) × (∀ i, V i) → ℤˣ,
      ∀ w w', B w w' = PV w.1 w'.2 * PV w'.1 w.2 :=
    ⟨fun w w' => PV w.1 w'.2 * PV w'.1 w.2, fun _ _ => rfl⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : (∀ i, V i) × (∀ i, V i) → ℤˣ,
      ∀ w, Q w = PV w.1 w.2 * PV w.1 (ρh a) * PV w.2 (ρh c) :=
    ⟨fun w => PV w.1 w.2 * PV w.1 (ρh a) * PV w.2 (ρh c), fun _ => rfl⟩
  have hBmul : ∀ x x' y, B (x * x') y = B x y * B x' y := by
    intro x x' y; simp only [hB, Prod.fst_mul, Prod.snd_mul, PVmul, PVmulr]; ac_rfl
  have hBsymm : ∀ x y, B x y = B y x := by
    intro x y; simp only [hB]; exact mul_comm _ _
  have hBnd : ∀ x, (∀ y, B x y = 1) → x = 1 := by
    intro x hx
    have h1 : x.1 = 1 := PVnd _ (fun y' => by
      have := hx (1, y'); simp only [hB, PV1l, mul_one] at this; exact this)
    have h2 : x.2 = 1 := PVnd _ (fun x' => by
      have := hx (x', 1); simp only [hB, PV1r, one_mul] at this; rw [PVsymm]; exact this)
    exact Prod.ext h1 h2
  have hQmul : ∀ x y, Q (x * y) = Q x * Q y * B x y := by
    intro x y; simp only [hQ, hB, Prod.fst_mul, Prod.snd_mul, PVmul, PVmulr]; ac_rfl
  have hVVcard : Nat.card (∀ i, V i) = 4 ^ n := by rw [Nat.card_pi]; exact hVcard
  have hWcard : Nat.card ((∀ i, V i) × (∀ i, V i)) = 4 ^ (2 * n) := by
    rw [Nat.card_prod, hVVcard, ← pow_add, two_mul]
  
  have hρhinj : ∀ g ∈ G, ∀ g' ∈ G, ρh g = ρh g' → g = g' := by
    intro g hg g' hg' he
    have h1 : g * g' = 1 := hρinj _ (hGmul g hg g' hg') (fun i => by
      rw [map_mul]
      have := congrFun he i
      rw [hρh, hρh] at this
      rw [this, ← pow_two, hV2])
    exact (invA g).symm.trans (inv_eq_of_mul_eq_one_right h1)
  obtain ⟨G', hG'⟩ : ∃ G' : Subgroup (∀ i, V i), ∀ y, y ∈ G' ↔ ∃ g ∈ G, ρh g = y :=
    ⟨{ carrier := {y | ∃ g ∈ G, ρh g = y}
       one_mem' := show ∃ g ∈ G, ρh g = 1 from ⟨1, hG1, map_one ρh⟩
       mul_mem' := by
         rintro _ _ ⟨g, hg, rfl⟩ ⟨g', hg', rfl⟩
         exact show ∃ g'' ∈ G, ρh g'' = ρh g * ρh g' from
           ⟨g * g', hGmul g hg g' hg', map_mul ρh g g'⟩
       inv_mem' := by
         intro x hx
         rw [invVV]; exact hx },
     fun _ => Iff.rfl⟩
  have hG'card : Nat.card G' = 2 ^ n := by
    have hset : (G' : Set (∀ i, V i)) = ρh '' G := by
      ext y; simp only [SetLike.mem_coe, hG', Set.mem_image]
    have hinj : Set.InjOn ρh G := by
      intro g hg g' hg' he; exact hρhinj g hg g' hg' he
    rw [← hGcard, ← Set.ncard_image_of_injOn hinj, ← hset]
    exact Nat.card_coe_set_eq _
  have hG'iso : ∀ g ∈ G', ∀ h ∈ G', PV g h = 1 := by
    intro g hg h hh
    obtain ⟨g₀, hg₀, rfl⟩ := (hG' g).mp hg
    obtain ⟨h₁, hh₁, rfl⟩ := (hG' h).mp hh
    rw [hPV]; simp only [hρh]; exact hiso g₀ hg₀ h₁ hh₁
  
  obtain ⟨Y, hY⟩ : ∃ Y : Subgroup ((∀ i, V i) × (∀ i, V i)),
      ∀ w, w ∈ Y ↔ ∀ i, (w.1 i, w.2 i) ∈ Z i :=
    ⟨{ carrier := {w | ∀ i, (w.1 i, w.2 i) ∈ Z i}
       one_mem' := show ∀ i, (((1 : (∀ i, V i) × (∀ i, V i))).1 i,
           ((1 : (∀ i, V i) × (∀ i, V i))).2 i) ∈ Z i from fun i => hZone i
       mul_mem' := by
         intro w w' hw hw'
         show ∀ i, _
         intro i
         exact hZmul i _ (hw i) _ (hw' i)
       inv_mem' := by
         intro w hw
         rw [invW]; exact hw },
     fun _ => Iff.rfl⟩
  
  obtain ⟨M, hM⟩ : ∃ M : Subgroup (∀ i, V i), ∀ x, x ∈ M ↔ ∀ i, x i = 1 ∨ x i = ρ i c :=
    ⟨{ carrier := {x | ∀ i, x i = 1 ∨ x i = ρ i c}
       one_mem' := show ∀ i, (1 : ∀ i, V i) i = 1 ∨ (1 : ∀ i, V i) i = ρ i c from
         fun i => Or.inl rfl
       mul_mem' := by
         intro x y hx hy
         show ∀ i, _
         intro i
         rw [Pi.mul_apply]
         rcases hx i with h | h <;> rcases hy i with h' | h' <;> rw [h, h']
         · exact Or.inl (one_mul 1)
         · exact Or.inr (one_mul _)
         · exact Or.inr (mul_one _)
         · exact Or.inl (by rw [← pow_two]; exact hV2 i _)
       inv_mem' := by
         intro x hx
         rw [invVV]; exact hx },
     fun _ => Iff.rfl⟩
  obtain ⟨Mp, hMp⟩ : ∃ Mp : Subgroup (∀ i, V i), ∀ y, y ∈ Mp ↔ ∀ m ∈ M, PV y m = 1 :=
    ⟨{ carrier := {y | ∀ m ∈ M, PV y m = 1}
       one_mem' := show ∀ m ∈ M, PV 1 m = 1 from fun m _ => PV1l m
       mul_mem' := by
         intro x y hx hy
         show ∀ m ∈ M, PV (x * y) m = 1
         intro m hm
         rw [PVmul, hx m hm, hy m hm, one_mul]
       inv_mem' := by
         intro x hx
         rw [invVV]; exact hx },
     fun _ => Iff.rfl⟩
  have hMpc : ∀ y, y ∈ Mp ↔ ∀ i, P i (y i) (ρ i c) = 1 := by
    intro y; rw [hMp]; constructor
    · intro hy i
      have hm : Pi.mulSingle i (ρ i c) ∈ M := by
        rw [hM]; intro j
        by_cases hji : j = i
        · subst hji; right; exact Pi.mulSingle_eq_same _ _
        · left; exact Pi.mulSingle_eq_of_ne hji _
      rw [← PVsingle]; exact hy _ hm
    · intro hy m hm
      rw [hPV]; apply Finset.prod_eq_one; intro i _
      rcases (hM m).mp hm i with h | h <;> rw [h]
      · exact P1r i _
      · exact hy i
  
  have cardProd : ∀ H K : Subgroup (∀ i, V i), Nat.card (H.prod K) = Nat.card H * Nat.card K := by
    intro H K; rw [Nat.card_congr (Subgroup.prodEquiv H K).toEquiv, Nat.card_prod]
  have cardPairs : ∀ S : ∀ i, Set (V i × V i),
      Nat.card {w : (∀ i, V i) × (∀ i, V i) // ∀ i, (w.1 i, w.2 i) ∈ S i} =
        ∏ i, Nat.card (S i) := by
    intro S
    rw [← Nat.card_pi]
    exact Nat.card_congr
      { toFun := fun w i => ⟨(w.1.1 i, w.1.2 i), w.2 i⟩
        invFun := fun f => ⟨(fun i => (f i).1.1, fun i => (f i).1.2), fun i => (f i).2⟩
        left_inv := fun w => rfl
        right_inv := fun f => rfl }
  have hMMp : Nat.card M * Nat.card Mp = 4 ^ n := by
    rw [← hVVcard]
    refine Eq.trans ?_ (pairing_card_mul_card_orth hVV2 PV PVmul PVsymm PVnd M)
    congr 1
    exact Nat.card_congr (Equiv.subtypeEquivRight hMp)
  have hXcard : Nat.card (G'.prod G') = 2 ^ (2 * n) := by
    rw [cardProd, hG'card, ← pow_add, two_mul]
  have hLcard : Nat.card (M.prod Mp) = 2 ^ (2 * n) := by
    rw [cardProd, hMMp, pow_mul]; norm_num
  have hYcard : Nat.card Y = 2 ^ (2 * n) := by
    rw [Nat.card_congr (Equiv.subtypeEquivRight hY), cardPairs,
      Finset.prod_congr rfl (fun i _ => (Nat.card_coe_set_eq (Z i)).trans (hZcard i)), hVcard,
      pow_mul]
    norm_num
  
  have hXQ : ∀ w ∈ G'.prod G', Q w = 1 := by
    intro w hw
    rw [Subgroup.mem_prod] at hw
    have ha' : ρh a ∈ G' := (hG' _).mpr ⟨a, ha, rfl⟩
    have hc' : ρh c ∈ G' := (hG' _).mpr ⟨c, hcG, rfl⟩
    rw [hQ, hG'iso _ hw.1 _ hw.2, hG'iso _ hw.1 _ ha', hG'iso _ hw.2 _ hc', one_mul, one_mul]
  have key2 : ∀ x y : ℤˣ, x * y * x * y = 1 := fun x y => by
    rw [mul_assoc (x * y) x y]; exact usq _
  have hYQ : ∀ w ∈ Y, Q w = 1 := by
    intro w hw
    rw [hY] at hw
    rw [hQ, hPV, hPV, hPV, ← Finset.prod_mul_distrib, ← Finset.prod_mul_distrib]
    apply Finset.prod_eq_one; intro i _
    simp only [hρh]
    have e : P i (w.1 i) (w.2 i) = P i (w.1 i) (ρ i a) * P i (w.2 i) (ρ i c) := hR3 i _ (hw i)
    rw [e]; exact key2 _ _
  have hLQ : ∀ w ∈ M.prod Mp, Q w = 1 := by
    intro w hw
    rw [Subgroup.mem_prod] at hw
    have hcM : ρh c ∈ M := (hM _).mpr (fun i => Or.inr (hρh c i))
    rw [hQ, PVsymm w.1 w.2, (hMp _).mp hw.2 _ hw.1, (hMp _).mp hw.2 _ hcM, one_mul, mul_one]
    rw [hPV]; apply Finset.prod_eq_one; intro i _
    rw [hρh]
    rcases (hM _).mp hw.1 i with h | h <;> rw [h]
    · exact P1l i _
    · exact hca i
  
  obtain ⟨dd, hdd⟩ := (IsPGroup.iff_card (p := 2) (G := ↥(G'.prod G' ⊓ Y))).mp
    (fun g => ⟨1, Subtype.ext (by rw [pow_one]; exact hW2 g.1)⟩)
  have hSel : {p : A × A | p.1 ∈ G ∧ p.2 ∈ G ∧ ∀ i, (ρ i p.1, ρ i p.2) ∈ Z i}.encard
      = 2 ^ dd := by
    have himg : (fun p : A × A => (ρh p.1, ρh p.2)) ''
        {p : A × A | p.1 ∈ G ∧ p.2 ∈ G ∧ ∀ i, (ρ i p.1, ρ i p.2) ∈ Z i} =
        ((G'.prod G' ⊓ Y : Subgroup ((∀ i, V i) × (∀ i, V i))) :
          Set ((∀ i, V i) × (∀ i, V i))) := by
      ext w
      simp only [Set.mem_image, Set.mem_setOf_eq, SetLike.mem_coe, Subgroup.mem_inf,
        Subgroup.mem_prod, hG', hY]
      constructor
      · rintro ⟨⟨g, h⟩, ⟨hg, hh, hZ⟩, rfl⟩
        exact ⟨⟨⟨g, hg, rfl⟩, ⟨h, hh, rfl⟩⟩, fun i => by simpa only [hρh] using hZ i⟩
      · rintro ⟨⟨⟨g, hg, hg1⟩, ⟨h, hh, hh1⟩⟩, hZ⟩
        refine ⟨⟨g, h⟩, ⟨hg, hh, fun i => ?_⟩, ?_⟩
        · have := hZ i
          rw [← hg1, ← hh1] at this
          simpa only [hρh] using this
        · exact Prod.ext hg1 hh1
    have hinj : Set.InjOn (fun p : A × A => (ρh p.1, ρh p.2))
        {p : A × A | p.1 ∈ G ∧ p.2 ∈ G ∧ ∀ i, (ρ i p.1, ρ i p.2) ∈ Z i} := by
      intro p hp q hq he
      simp only [Prod.mk.injEq] at he
      exact Prod.ext (hρhinj _ hp.1 _ hq.1 he.1) (hρhinj _ hp.2.1 _ hq.2.1 he.2)
    rw [← hinj.encard_image, himg,
      ← (Set.toFinite ((G'.prod G' ⊓ Y : Subgroup ((∀ i, V i) × (∀ i, V i))) :
          Set ((∀ i, V i) × (∀ i, V i)))).cast_ncard_eq,
      ← Nat.card_coe_set_eq]
    have : Nat.card ((G'.prod G' ⊓ Y : Subgroup ((∀ i, V i) × (∀ i, V i))) :
        Set ((∀ i, V i) × (∀ i, V i))) = 2 ^ dd := hdd
    rw [this]; norm_cast
  
  have hk : ∀ i, ∃ k : ℕ, Nat.card {x : V i // ((1 : V i), x) ∈ Z i} = 2 ^ k := by
    intro i
    obtain ⟨N, hN⟩ : ∃ N : Subgroup (V i), ∀ x, x ∈ N ↔ ((1 : V i), x) ∈ Z i :=
      ⟨{ carrier := {x | ((1 : V i), x) ∈ Z i}
         one_mem' := hZone i
         mul_mem' := by
           intro x y hx hy
           have := hZmul i ((1 : V i), x) hx ((1 : V i), y) hy
           rw [Prod.mk_mul_mk, one_mul] at this
           exact this
         inv_mem' := by
           intro x hx
           rw [invV]; exact hx },
       fun _ => Iff.rfl⟩
    obtain ⟨k, hk⟩ := (IsPGroup.iff_card (p := 2) (G := ↥N)).mp
      (fun g => ⟨1, Subtype.ext (by rw [pow_one]; exact hV2 i g.1)⟩)
    exact ⟨k, (Nat.card_congr (Equiv.subtypeEquivRight hN)).symm.trans hk⟩
  choose k hk using hk
  have hkenc : ∀ i, {x : V i | ((1 : V i), x) ∈ Z i}.encard = 2 ^ k i := by
    intro i
    rw [← (Set.toFinite {x : V i | ((1 : V i), x) ∈ Z i}).cast_ncard_eq, ← Nat.card_coe_set_eq]
    have : Nat.card ↥{x : V i | ((1 : V i), x) ∈ Z i} = 2 ^ k i := hk i
    rw [this]; norm_cast
  
  obtain ⟨e, he⟩ : ∃ e : ι → ℕ,
      ∀ i, e i = if ρ i c ≠ 1 ∧ P i (ρ i c) (ρ i h₀) = 1 then 1 else 0 :=
    ⟨fun i => if ρ i c ≠ 1 ∧ P i (ρ i c) (ρ i h₀) = 1 then 1 else 0, fun _ => rfl⟩
  have hYL : Nat.card (Y ⊓ M.prod Mp : Subgroup ((∀ i, V i) × (∀ i, V i))) =
      ∏ i, Nat.card {d : V i × V i // d ∈ Z i ∧ (d.1 = 1 ∨ d.1 = ρ i c) ∧
        P i d.2 (ρ i c) = 1} := by
    refine Eq.trans ?_ (cardPairs (fun i => {d : V i × V i | d ∈ Z i ∧
      (d.1 = 1 ∨ d.1 = ρ i c) ∧ P i d.2 (ρ i c) = 1}))
    refine Nat.card_congr (Equiv.subtypeEquivRight (fun w => ?_))
    simp only [Subgroup.mem_inf, Subgroup.mem_prod, hY, hM, hMpc, Set.mem_setOf_eq]
    exact ⟨fun ⟨h1, h2, h3⟩ i => ⟨h1 i, h2 i, h3 i⟩,
      fun h => ⟨fun i => (h i).1, fun i => (h i).2.1, fun i => (h i).2.2⟩⟩
  have hS : ∀ i, Nat.card {d : V i × V i // d ∈ Z i ∧ (d.1 = 1 ∨ d.1 = ρ i c) ∧
      P i d.2 (ρ i c) = 1} =
      (if ρ i c ≠ 1 ∧ P i (ρ i c) (ρ i h₀) = 1 then 2 else 1) *
        Nat.card {x : V i // ((1 : V i), x) ∈ Z i} :=
    fun i => local_descent_lagrangian_card (hV2 i) (P i) (hPmul i) (hPsymm i) (Z i) (hZmul i)
      (ρ i a) (ρ i c) (ρ i h₀) (hR3 i) (hh₀ i)
  have hb : Nat.card (Y ⊓ M.prod Mp : Subgroup ((∀ i, V i) × (∀ i, V i))) =
      2 ^ (∑ i, (e i + k i)) := by
    rw [hYL, ← Finset.prod_pow_eq_pow_sum]
    apply Finset.prod_congr rfl; intro i _
    rw [hS i, hk i, pow_add, he i]
    by_cases hq : ρ i c ≠ 1 ∧ P i (ρ i c) (ρ i h₀) = 1
    · rw [if_pos hq, if_pos hq, pow_one]
    · rw [if_neg hq, if_neg hq, pow_zero]
  
  obtain ⟨r, hr⟩ := (IsPGroup.iff_card (p := 2) (G := ↥(G' ⊓ M))).mp
    (fun g => ⟨1, Subtype.ext (by rw [pow_one]; exact hVV2 g.1)⟩)
  obtain ⟨s, hs⟩ := (IsPGroup.iff_card (p := 2) (G := ↥(G' ⊓ Mp))).mp
    (fun g => ⟨1, Subtype.ext (by rw [pow_one]; exact hVV2 g.1)⟩)
  have hLX : Nat.card (M.prod Mp ⊓ G'.prod G' : Subgroup ((∀ i, V i) × (∀ i, V i))) =
      2 ^ (r + s) := by
    have eq : (M.prod Mp ⊓ G'.prod G' : Subgroup ((∀ i, V i) × (∀ i, V i))) =
        (G' ⊓ M).prod (G' ⊓ Mp) := by
      ext w; simp only [Subgroup.mem_inf, Subgroup.mem_prod]; tauto
    rw [eq, cardProd, hr, hs, pow_add]
  obtain ⟨f, hf⟩ : ∃ f : ι → ℕ, ∀ i, f i = if ρ i c = 1 then 0 else 1 :=
    ⟨fun i => if ρ i c = 1 then 0 else 1, fun _ => rfl⟩
  obtain ⟨t, ht⟩ : ∃ t : ℕ, t = ∑ i, f i := ⟨_, rfl⟩
  have hMcard : Nat.card M = 2 ^ t := by
    rw [ht, ← Finset.prod_pow_eq_pow_sum,
      Nat.card_congr ((Equiv.subtypeEquivRight hM).trans
        (Equiv.subtypePiEquivPi (p := fun i u => u = 1 ∨ u = ρ i c))), Nat.card_pi]
    apply Finset.prod_congr rfl; intro i _
    rw [hf i]
    by_cases h : ρ i c = 1
    · rw [if_pos h, pow_zero]
      calc Nat.card {u : V i // u = 1 ∨ u = ρ i c} = Nat.card ↥({1} : Set (V i)) :=
            Nat.card_congr (Equiv.subtypeEquivRight (fun u => by
              rw [h, or_self, Set.mem_singleton_iff]))
        _ = 1 := by rw [Nat.card_coe_set_eq, Set.ncard_singleton]
    · rw [if_neg h, pow_one]
      calc Nat.card {u : V i // u = 1 ∨ u = ρ i c} = Nat.card ↥({1, ρ i c} : Set (V i)) :=
            Nat.card_congr (Equiv.subtypeEquivRight (fun u => by
              rw [Set.mem_insert_iff, Set.mem_singleton_iff]))
        _ = 2 := by rw [Nat.card_coe_set_eq, Set.ncard_pair (Ne.symm h)]
  have hs8 := lagrangian_inter_orth_card hVV2 PV PVmul PVsymm PVnd G' M hG'iso
    (by rw [hG'card, hVVcard, ← mul_pow]; norm_num)
  have hGMp : Nat.card {x : (∀ i, V i) // x ∈ G' ∧ ∀ m ∈ M, PV x m = 1} = 2 ^ s := by
    rw [← hs]
    exact Nat.card_congr (Equiv.subtypeEquivRight (fun x => by rw [Subgroup.mem_inf, hMp]))
  have hst : s + t = n + r := by
    rw [hGMp, hMcard, hG'card, hr, ← pow_add, ← pow_add] at hs8
    exact Nat.pow_right_injective le_rfl hs8
  
  have h5 := lagrangian_triple_parity hW2 B hBmul hBsymm hBnd Q hQmul (2 * n) hWcard
    (G'.prod G') Y (M.prod Mp) hXQ hYQ hLQ hXcard hYcard hLcard dd (∑ i, (e i + k i)) (r + s)
    hdd hb hLX
  
  have hef : ∀ i, (-1 : ℤˣ) ^ (e i) * (-1) ^ (f i) = P i (ρ i c) (ρ i h₀) := by
    intro i
    rw [he i, hf i]
    by_cases h1 : ρ i c = 1
    · have hq : ¬ (ρ i c ≠ 1 ∧ P i (ρ i c) (ρ i h₀) = 1) := fun hq => hq.1 h1
      rw [if_neg hq, if_pos h1, h1, P1l, pow_zero, one_mul]
    · rcases Int.units_eq_one_or (P i (ρ i c) (ρ i h₀)) with h2 | h2
      · rw [if_pos (show ρ i c ≠ 1 ∧ P i (ρ i c) (ρ i h₀) = 1 from ⟨h1, h2⟩), if_neg h1, h2,
          pow_one, usq]
      · have hq : ¬ (ρ i c ≠ 1 ∧ P i (ρ i c) (ρ i h₀) = 1) :=
          fun hq => hne (h2.symm.trans hq.2)
        rw [if_neg hq, if_neg h1, h2, pow_zero, pow_one, one_mul]
  obtain ⟨E, hE⟩ : ∃ E : ℤˣ, E = ∏ i, (-1 : ℤˣ) ^ (e i) := ⟨_, rfl⟩
  obtain ⟨K, hK⟩ : ∃ K : ℤˣ, K = ∏ i, (-1 : ℤˣ) ^ (k i) := ⟨_, rfl⟩
  have hA : (-1 : ℤˣ) ^ dd * (-1) ^ (∑ i, (e i + k i)) * (-1) ^ (r + s) = 1 := by
    rw [← pow_add, ← pow_add, h5, pow_mul, Int.units_sq, one_pow]
  have hB' : (-1 : ℤˣ) ^ (∑ i, (e i + k i)) = E * K := by
    rw [← Finset.prod_pow_eq_pow_sum, hE, hK, ← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl (fun i _ => pow_add _ _ _)
  have hC : E * (-1 : ℤˣ) ^ t = 1 := by
    rw [ht, ← Finset.prod_pow_eq_pow_sum, hE, ← Finset.prod_mul_distrib]
    exact Eq.trans (Finset.prod_congr rfl (fun i _ => hef i)) hch
  have hD : (-1 : ℤˣ) ^ (r + s) * (-1) ^ t = (-1) ^ n := by
    have : r + s + t = n + 2 * r := by omega
    rw [← pow_add, this, pow_add, pow_mul, Int.units_sq, one_pow, mul_one]
  refine ⟨dd, k, hSel, hkenc, ?_⟩
  rw [← hK]
  calc (-1 : ℤˣ) ^ dd
      = (-1) ^ dd * (E * (-1) ^ t) * (K * K) * ((-1) ^ (r + s) * (-1) ^ (r + s)) := by
        rw [hC, usq K, usq ((-1 : ℤˣ) ^ (r + s)), mul_one, mul_one, mul_one]
    _ = ((-1) ^ (r + s) * (-1) ^ t) * K *
          ((-1) ^ dd * (E * K) * (-1) ^ (r + s)) := by ac_rfl
    _ = (-1) ^ n * K := by rw [hD, ← hB', hA, mul_one]

theorem adicCompletion_isSquare_of_valued_sub_one_lt_one {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : IsDedekindDomain.HeightOneSpectrum.valuation K v 2 = 1) :
    ∀ u : v.adicCompletion K, Valued.v (u - 1) < 1 → IsSquare u :=
by
  intro u hu
  have hval : ∀ x : K, Valued.v (algebraMap K (v.adicCompletion K) x) =
      IsDedekindDomain.HeightOneSpectrum.valuation K v x :=
    fun x => IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v x
  have h2F : Valued.v (2 : v.adicCompletion K) = 1 := by
    rw [← map_ofNat (algebraMap K (v.adicCompletion K)) 2, hval, h2]
  have h20 : (2 : v.adicCompletion K) ≠ 0 := by
    intro h; rw [h, map_zero] at h2F; exact zero_ne_one h2F
  
  have G3 : ∀ y : WithZero (Multiplicative ℤ), y < 1 → y ≤ WithZero.exp (-1 : ℤ) := by
    intro y hy
    by_cases hy0 : y = 0
    · rw [hy0]; exact zero_le'
    · rw [← WithZero.exp_log hy0] at hy ⊢
      rw [← WithZero.exp_zero, WithZero.exp_lt_exp] at hy
      rw [WithZero.exp_le_exp]; omega
  have G1 : ∀ N k : ℕ, N ≤ k →
      WithZero.exp (-((k : ℤ) + 1)) ≤ WithZero.exp (-((N : ℤ) + 1)) := by
    intro N k h; rw [WithZero.exp_le_exp]; omega
  have G2 : ∀ γ : (WithZero (Multiplicative ℤ))ˣ, ∃ N : ℕ,
      WithZero.exp (-((N : ℤ) + 1)) < (γ : WithZero (Multiplicative ℤ)) := by
    intro γ
    have hγ0 : (γ : WithZero (Multiplicative ℤ)) ≠ 0 := Units.ne_zero γ
    refine ⟨(-WithZero.log (γ : WithZero (Multiplicative ℤ))).toNat, ?_⟩
    conv_rhs => rw [← WithZero.exp_log hγ0]
    rw [WithZero.exp_lt_exp]
    have := Int.self_le_toNat (-WithZero.log (γ : WithZero (Multiplicative ℤ)))
    omega
  
  obtain ⟨x, hx0, hxs⟩ : ∃ x : ℕ → v.adicCompletion K, x 0 = 1 ∧
      ∀ k, x (k + 1) = x k - (x k ^ 2 - u) / (2 * x k) :=
    ⟨fun n => Nat.rec (1 : v.adicCompletion K) (fun _ a => a - (a ^ 2 - u) / (2 * a)) n,
      rfl, fun _ => rfl⟩
  have P : ∀ k : ℕ, Valued.v (x k) = 1 ∧
      Valued.v (x k ^ 2 - u) ≤ WithZero.exp (-((k : ℤ) + 1)) := by
    intro k
    induction k with
    | zero =>
      refine ⟨by rw [hx0, map_one], ?_⟩
      rw [hx0, one_pow, Valuation.map_sub_swap]
      simpa using G3 _ hu
    | succ k ih =>
      obtain ⟨ha, he⟩ := ih
      have ha0 : x k ≠ 0 := by
        intro h; rw [h, map_zero] at ha; exact zero_ne_one ha
      have hwe1 : Valued.v (x k ^ 2 - u) ≤ WithZero.exp (-1 : ℤ) := by
        refine le_trans he ?_; rw [WithZero.exp_le_exp]; omega
      have hwelt : Valued.v (x k ^ 2 - u) < 1 :=
        lt_of_le_of_lt hwe1 (by rw [← WithZero.exp_zero, WithZero.exp_lt_exp]; norm_num)
      have hd : Valued.v ((x k ^ 2 - u) / (2 * x k)) = Valued.v (x k ^ 2 - u) := by
        rw [map_div₀, map_mul, h2F, ha, mul_one, div_one]
      have hd2 : (x k ^ 2 - u) / (2 * x k) * (2 * x k) = x k ^ 2 - u :=
        div_mul_cancel₀ _ (mul_ne_zero h20 ha0)
      have key : x (k + 1) ^ 2 - u = ((x k ^ 2 - u) / (2 * x k)) ^ 2 := by
        rw [hxs]; linear_combination -hd2
      constructor
      · rw [hxs, Valuation.map_sub_eq_of_lt_left _ (by rw [hd, ha]; exact hwelt), ha]
      · rw [key, map_pow, hd, sq]
        calc Valued.v (x k ^ 2 - u) * Valued.v (x k ^ 2 - u)
            ≤ WithZero.exp (-((k : ℤ) + 1)) * WithZero.exp (-1 : ℤ) := mul_le_mul' he hwe1
          _ = WithZero.exp (-(((k + 1 : ℕ) : ℤ) + 1)) := by
            rw [← WithZero.exp_add] <;> congr 1 <;> push_cast <;> ring
  have hinc : ∀ k : ℕ, Valued.v (x (k + 1) - x k) ≤ WithZero.exp (-((k : ℤ) + 1)) := by
    intro k
    have e : x (k + 1) - x k = -((x k ^ 2 - u) / (2 * x k)) := by rw [hxs]; ring
    rw [e, Valuation.map_neg, map_div₀, map_mul, h2F, (P k).1, mul_one, div_one]
    exact (P k).2
  have T1 : ∀ N n : ℕ, N ≤ n → Valued.v (x n - x N) ≤ WithZero.exp (-((N : ℤ) + 1)) := by
    intro N n hn
    induction n, hn using Nat.le_induction with
    | base => rw [sub_self, map_zero]; exact zero_le'
    | succ n hn ih =>
      have e : x (n + 1) - x N = (x (n + 1) - x n) + (x n - x N) := by ring
      rw [e]
      exact Valuation.map_add_le _ (le_trans (hinc n) (G1 N n hn)) ih
  have hcauchy : CauchySeq x := by
    refine (Valued.cauchy_iff).2 ⟨Filter.map_neBot, fun γ => ?_⟩
    obtain ⟨N, hN⟩ := G2 γ
    refine ⟨x '' Set.Ici N, Filter.image_mem_map (Filter.Ici_mem_atTop N), ?_⟩
    rintro _ ⟨m, hm, rfl⟩ _ ⟨n, hn, rfl⟩
    have e : x n - x m = (x n - x N) - (x m - x N) := by ring
    rw [e]
    exact lt_of_le_of_lt (Valuation.map_sub_le _ (T1 N n hn) (T1 N m hm)) hN
  obtain ⟨L, hL⟩ := cauchySeq_tendsto_of_complete hcauchy
  have h0 : Filter.Tendsto (fun k => x k ^ 2 - u) Filter.atTop (nhds 0) := by
    rw [Filter.tendsto_def]
    intro s hs
    obtain ⟨γ, hγ⟩ := Valued.mem_nhds_zero.mp hs
    obtain ⟨N, hN⟩ := G2 γ
    rw [Filter.mem_atTop_sets]
    refine ⟨N, fun k hk => hγ ?_⟩
    exact lt_of_le_of_lt (le_trans (P k).2 (G1 N k hk)) hN
  have hL' : Filter.Tendsto (fun k => x k ^ 2 - u) Filter.atTop (nhds (L ^ 2 - u)) :=
    (hL.pow 2).sub_const u
  have hLu : L ^ 2 - u = 0 := tendsto_nhds_unique hL' h0
  have hLu' : L ^ 2 = u := sub_eq_zero.mp hLu
  exact ⟨L, by rw [← hLu', sq]⟩

theorem adicCompletionIntegers_exists_finite_residue {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : IsDedekindDomain.HeightOneSpectrum.valuation K v 2 = 1) :
    ∃ (k : Type u) (_ : Field k) (_ : Finite k) (r : v.adicCompletionIntegers K →+* k),
      ringChar k ≠ 2 ∧ Function.Surjective r ∧
      ∀ x : v.adicCompletionIntegers K, r x = 0 ↔ Valued.v (x : v.adicCompletion K) < 1 :=
by
  
  have approx : ∀ k : K, IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 →
      ∃ a : NumberField.RingOfIntegers K,
        IsDedekindDomain.HeightOneSpectrum.valuation K v
          (k - algebraMap (NumberField.RingOfIntegers K) K a) < 1 := by
    intro k hk
    obtain ⟨n, d, hd, hnd⟩ := IsFractionRing.div_surjective (A := NumberField.RingOfIntegers K) k
    have hd0 : d ≠ 0 := nonZeroDivisors.ne_zero hd
    have hιd : algebraMap (NumberField.RingOfIntegers K) K d ≠ 0 := by
      rw [ne_eq, map_eq_zero_iff _ (IsFractionRing.injective (NumberField.RingOfIntegers K) K)]
      exact hd0
    have hn : algebraMap (NumberField.RingOfIntegers K) K n =
        k * algebraMap (NumberField.RingOfIntegers K) K d := by
      rw [← hnd, div_mul_cancel₀ _ hιd]
    have hv0 : v.intValuation d ≠ 0 := v.intValuation_ne_zero d hd0
    have hv1 : v.intValuation d ≤ 1 := v.intValuation_le_one d
    have hlog : WithZero.log (v.intValuation d) ≤ 0 := by
      have h1 : WithZero.exp (WithZero.log (v.intValuation d)) ≤ WithZero.exp (0 : ℤ) := by
        rw [WithZero.exp_log hv0, WithZero.exp_zero]; exact hv1
      exact WithZero.exp_le_exp.mp h1
    obtain ⟨m, hm⟩ : ∃ m : ℕ, v.intValuation d = WithZero.exp (-(m : ℤ)) := by
      refine ⟨(-WithZero.log (v.intValuation d)).toNat, ?_⟩
      rw [Int.toNat_of_nonneg (by omega), neg_neg, WithZero.exp_log hv0]
    obtain ⟨J, hJ⟩ : v.asIdeal ^ m ∣ Ideal.span {d} :=
      (v.intValuation_le_pow_iff_dvd d m).mp hm.le
    have hJP : ¬ J ≤ v.asIdeal := by
      intro hle
      have h3 : v.asIdeal ^ (m + 1) ∣ Ideal.span {d} := by
        rw [hJ, pow_succ]
        exact mul_dvd_mul_left _ (Ideal.dvd_iff_le.mpr hle)
      have h2 := (v.intValuation_le_pow_iff_dvd d (m + 1)).mpr h3
      rw [hm, WithZero.exp_le_exp] at h2
      push_cast at h2
      omega
    obtain ⟨t, htJ, htP⟩ := Set.not_subset.mp hJP
    have hnv : v.intValuation n ≤ WithZero.exp (-(m : ℤ)) := by
      have e1 : v.intValuation n = IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K n) :=
        (v.valuation_of_algebraMap (K := K) n).symm
      have e2 : v.intValuation d = IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K d) :=
        (v.valuation_of_algebraMap (K := K) d).symm
      rw [e1, hn, map_mul, ← e2, hm]
      calc _ ≤ 1 * WithZero.exp (-(m : ℤ)) := mul_le_mul_right' hk _
        _ = _ := one_mul _
    have hnP : n ∈ v.asIdeal ^ m :=
      Ideal.dvd_span_singleton.mp ((v.intValuation_le_pow_iff_dvd n m).mp hnv)
    have hnt : n * t ∈ Ideal.span {d} := by
      rw [hJ]; exact Ideal.mul_mem_mul hnP htJ
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hnt
    have hbk : algebraMap (NumberField.RingOfIntegers K) K b =
        algebraMap (NumberField.RingOfIntegers K) K t * k := by
      have h4 := congrArg (algebraMap (NumberField.RingOfIntegers K) K) hb
      rw [map_mul, map_mul, hn] at h4
      apply mul_right_cancel₀ hιd
      rw [h4]; ring
    obtain ⟨s, i, hi, hsi⟩ := v.isMaximal.exists_inv htP
    refine ⟨s * b, ?_⟩
    have h1 : algebraMap (NumberField.RingOfIntegers K) K s *
        algebraMap (NumberField.RingOfIntegers K) K t +
        algebraMap (NumberField.RingOfIntegers K) K i = 1 := by
      rw [← map_mul, ← map_add, hsi, map_one]
    have key : algebraMap (NumberField.RingOfIntegers K) K t *
        (k - algebraMap (NumberField.RingOfIntegers K) K (s * b)) =
        algebraMap (NumberField.RingOfIntegers K) K b *
          algebraMap (NumberField.RingOfIntegers K) K i := by
      rw [map_mul]
      linear_combination (-1 : K) * hbk - algebraMap (NumberField.RingOfIntegers K) K b * h1
    have hvt : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K t) = 1 := by
      rw [v.valuation_of_algebraMap]; exact (v.intValuation_eq_one_iff).mpr htP
    have hvb : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K b) ≤ 1 := v.valuation_le_one (K := K) b
    have hvi : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K i) < 1 :=
      (v.valuation_lt_one_iff_mem (K := K) i).mpr hi
    have h5 := congrArg (IsDedekindDomain.HeightOneSpectrum.valuation K v) key
    rw [map_mul (IsDedekindDomain.HeightOneSpectrum.valuation K v), hvt, one_mul,
      map_mul (IsDedekindDomain.HeightOneSpectrum.valuation K v)] at h5
    rw [h5]
    calc _ ≤ 1 * IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K i) := mul_le_mul_right' hvb _
      _ = _ := one_mul _
      _ < 1 := hvi
  have hval : ∀ x : K, Valued.v (algebraMap K (v.adicCompletion K) x) =
      IsDedekindDomain.HeightOneSpectrum.valuation K v x := fun x =>
    IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v x
  
  have hker : ∀ x : v.adicCompletionIntegers K,
      IsLocalRing.residue _ x = 0 ↔ Valued.v (x : v.adicCompletion K) < 1 := fun x =>
    (IsLocalRing.residue_eq_zero_iff x).trans
      (Valuation.mem_maximalIdeal_iff (v.adicCompletion K) Valued.v (a := x))
  
  have hfin : Finite (IsLocalRing.ResidueField (v.adicCompletionIntegers K)) := by
    have hRK : ∀ r : NumberField.RingOfIntegers K,
        algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r =
          algebraMap K (v.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K r) :=
      fun r => IsScalarTower.algebraMap_apply _ _ _ r
    have hint : ∀ r : NumberField.RingOfIntegers K,
        algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r ∈
          v.adicCompletionIntegers K := by
      intro r
      rw [IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers, hRK, hval]
      exact v.valuation_le_one r
    let φ := (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K)).codRestrict
      (v.adicCompletionIntegers K) hint
    let ψ := (IsLocalRing.residue (v.adicCompletionIntegers K)).comp φ
    have hψ : ∀ r ∈ v.asIdeal, ψ r = 0 := by
      intro r hr
      show IsLocalRing.residue _ (φ r) = 0
      rw [hker]
      show Valued.v (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r) < 1
      rw [hRK, hval]
      exact (v.valuation_lt_one_iff_mem r).mpr hr
    let ψbar := Ideal.Quotient.lift v.asIdeal ψ hψ
    have hdense : DenseRange (algebraMap K (v.adicCompletion K)) := by
      have h := @UniformSpace.Completion.denseRange_coe
        (WithVal (IsDedekindDomain.HeightOneSpectrum.valuation K v)) _
      exact h
    have hsurj : Function.Surjective ψbar := by
      intro y
      obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective y
      have hU : {z : v.adicCompletion K | Valued.v (z - (x : v.adicCompletion K)) < 1} ∈
          nhds (x : v.adicCompletion K) :=
        Valued.mem_nhds.mpr ⟨1, fun z hz => by simpa using hz⟩
      obtain ⟨k, hk⟩ := hdense.mem_nhds hU
      simp only [Set.mem_setOf_eq] at hk
      have hk1 : IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 := by
        rw [← hval]
        have e : algebraMap K (v.adicCompletion K) k =
            (algebraMap K (v.adicCompletion K) k - x) + x := by ring
        rw [e]
        exact le_trans (Valuation.map_add _ _ _) (max_le hk.le x.2)
      obtain ⟨a, ha⟩ := approx k hk1
      refine ⟨Ideal.Quotient.mk v.asIdeal a, ?_⟩
      show ψ a = IsLocalRing.residue _ x
      show IsLocalRing.residue _ (φ a) = IsLocalRing.residue _ x
      rw [← sub_eq_zero, ← map_sub, hker]
      show Valued.v (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) a -
        (x : v.adicCompletion K)) < 1
      have e : algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) a -
          (x : v.adicCompletion K) =
          -(algebraMap K (v.adicCompletion K)
              (k - algebraMap (NumberField.RingOfIntegers K) K a)) +
            (algebraMap K (v.adicCompletion K) k - x) := by
        rw [hRK, map_sub]; ring
      rw [e]
      refine Valuation.map_add_lt _ ?_ hk
      rw [Valuation.map_neg, hval]
      exact ha
    haveI : Finite (NumberField.RingOfIntegers K ⧸ v.asIdeal) :=
      Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
    exact Finite.of_surjective ψbar hsurj
  
  have hchar : ringChar (IsLocalRing.ResidueField (v.adicCompletionIntegers K)) ≠ 2 := by
    intro hc
    have h2O : Valued.v ((2 : v.adicCompletionIntegers K) : v.adicCompletion K) = 1 := by
      have e : ((2 : v.adicCompletionIntegers K) : v.adicCompletion K) =
          algebraMap K (v.adicCompletion K) 2 := by
        rw [map_ofNat]; rfl
      rw [e, hval, h2]
    have hr2 : IsLocalRing.residue (v.adicCompletionIntegers K) 2 ≠ 0 := by
      rw [ne_eq, hker, h2O]
      exact lt_irrefl _
    apply hr2
    rw [map_ofNat]
    have := ringChar.Nat.cast_ringChar (R := IsLocalRing.ResidueField (v.adicCompletionIntegers K))
    rw [hc] at this
    exact_mod_cast this
  exact ⟨IsLocalRing.ResidueField (v.adicCompletionIntegers K), inferInstance, hfin,
    IsLocalRing.residue _, hchar, IsLocalRing.residue_surjective, hker⟩

theorem adicCompletion_exists_nonsquare_unit_dichotomy {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : IsDedekindDomain.HeightOneSpectrum.valuation K v 2 = 1)
    (hsq : ∀ u : v.adicCompletion K, Valued.v (u - 1) < 1 → IsSquare u) :
    ∃ ε : v.adicCompletion K, Valued.v ε = 1 ∧ ¬ IsSquare ε ∧
      ∀ u : v.adicCompletion K, Valued.v u = 1 → IsSquare u ∨ IsSquare (ε * u) :=
by
  classical
  obtain ⟨k, _, _, r, hchar, hsurj, hker⟩ := adicCompletionIntegers_exists_finite_residue v h2
  
  have s2 : ∃ c : k, ¬ IsSquare c ∧ ∀ a : k, a ≠ 0 → IsSquare a ∨ IsSquare (c * a) := by
    haveI := Fintype.ofFinite k
    obtain ⟨c, hc⟩ := FiniteField.exists_nonsquare hchar
    refine ⟨c, hc, fun a ha => ?_⟩
    have hc0 : c ≠ 0 := by rintro rfl; exact hc ⟨0, by simp⟩
    have hχc : quadraticChar k c = -1 := quadraticChar_neg_one_iff_not_isSquare.mpr hc
    rcases quadraticChar_dichotomy ha with h | h
    · exact Or.inl ((quadraticChar_one_iff_isSquare ha).mp h)
    · right
      apply (quadraticChar_one_iff_isSquare (mul_ne_zero hc0 ha)).mp
      rw [map_mul, hχc, h]
      norm_num
  obtain ⟨c, hcns, hcd⟩ := s2
  
  have hmem : ∀ x : v.adicCompletionIntegers K, Valued.v (x : v.adicCompletion K) ≤ 1 :=
    fun x => (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers _ K v).mp x.2
  have hunit : ∀ x : v.adicCompletionIntegers K, r x ≠ 0 →
      Valued.v (x : v.adicCompletion K) = 1 := by
    intro x hx
    exact le_antisymm (hmem x) (not_lt.mp fun h => hx ((hker x).mpr h))
  have hsqval : ∀ g : WithZero (Multiplicative ℤ), g * g = 1 → g = 1 := by
    intro g hg
    rcases lt_trichotomy g 1 with h | h | h
    · exfalso
      have : g * g < 1 := by
        calc g * g ≤ g * 1 := mul_le_mul_left' h.le g
          _ = g := mul_one g
          _ < 1 := h
      rw [hg] at this; exact lt_irrefl _ this
    · exact h
    · exfalso
      have : 1 < g * g := by
        calc (1 : WithZero (Multiplicative ℤ)) < g := h
          _ = g * 1 := (mul_one g).symm
          _ ≤ g * g := mul_le_mul_left' h.le g
      rw [hg] at this; exact lt_irrefl _ this
  
  have s3 : ∀ a : v.adicCompletionIntegers K, Valued.v (a : v.adicCompletion K) = 1 →
      (IsSquare (a : v.adicCompletion K) ↔ IsSquare (r a)) := by
    intro a ha
    have hra : r a ≠ 0 := fun h => by
      have h' := (hker a).mp h
      rw [ha] at h'
      exact lt_irrefl _ h'
    constructor
    · rintro ⟨s, hs⟩
      have hws : Valued.v s = 1 := hsqval _ (by rw [← map_mul, ← hs, ha])
      let s₀ : v.adicCompletionIntegers K :=
        ⟨s, (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers _ K v).mpr hws.le⟩
      have hae : a = s₀ * s₀ := Subtype.ext hs
      exact ⟨r s₀, by rw [hae, map_mul]⟩
    · rintro ⟨t, ht⟩
      have ht0 : t ≠ 0 := by
        rintro rfl
        apply hra
        rw [ht, mul_zero]
      obtain ⟨s₀, hs₀⟩ := hsurj t
      have hws : Valued.v (s₀ : v.adicCompletion K) = 1 := hunit s₀ (by rw [hs₀]; exact ht0)
      have hs0 : (s₀ : v.adicCompletion K) ≠ 0 := by
        intro h
        rw [h, map_zero] at hws
        exact zero_ne_one hws
      have hss : (s₀ : v.adicCompletion K) * (s₀ : v.adicCompletion K) ≠ 0 := mul_ne_zero hs0 hs0
      have hwq : Valued.v ((a : v.adicCompletion K) /
          ((s₀ : v.adicCompletion K) * (s₀ : v.adicCompletion K))) = 1 := by
        rw [map_div₀, map_mul, ha, hws, mul_one, div_one]
      let q₀ : v.adicCompletionIntegers K :=
        ⟨(a : v.adicCompletion K) / ((s₀ : v.adicCompletion K) * (s₀ : v.adicCompletion K)),
          (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers _ K v).mpr hwq.le⟩
      have hqe : (a : v.adicCompletion K) =
          ((a : v.adicCompletion K) / ((s₀ : v.adicCompletion K) * (s₀ : v.adicCompletion K))) *
            ((s₀ : v.adicCompletion K) * (s₀ : v.adicCompletion K)) :=
        (div_mul_cancel₀ _ hss).symm
      have hq₀ : q₀ * (s₀ * s₀) = a := Subtype.ext hqe.symm
      have hrq : r q₀ = 1 := by
        have h1 := congrArg r hq₀
        rw [map_mul, map_mul, hs₀, ← ht] at h1
        exact mul_right_cancel₀ hra (h1.trans (one_mul _).symm)
      have hlt : Valued.v ((a : v.adicCompletion K) /
          ((s₀ : v.adicCompletion K) * (s₀ : v.adicCompletion K)) - 1) < 1 := by
        have h' := (hker (q₀ - 1)).mp (by rw [map_sub, map_one, hrq, sub_self])
        exact h'
      obtain ⟨m, hm⟩ := hsq _ hlt
      refine ⟨m * (s₀ : v.adicCompletion K), ?_⟩
      rw [hqe, hm]
      ring
  
  have hc0 : c ≠ 0 := by
    rintro rfl
    exact hcns ⟨0, by simp⟩
  obtain ⟨ε₀, hε₀⟩ := hsurj c
  have hεw : Valued.v (ε₀ : v.adicCompletion K) = 1 := hunit ε₀ (by rw [hε₀]; exact hc0)
  refine ⟨ε₀, hεw, ?_, ?_⟩
  · rw [s3 ε₀ hεw, hε₀]
    exact hcns
  · intro u hu
    let u₀ : v.adicCompletionIntegers K :=
      ⟨u, (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers _ K v).mpr hu.le⟩
    have hu0 : r u₀ ≠ 0 := fun h => by
      have h' := (hker u₀).mp h
      change Valued.v u < 1 at h'
      rw [hu] at h'
      exact lt_irrefl _ h'
    rcases hcd (r u₀) hu0 with h | h
    · left
      exact (s3 u₀ hu).mpr h
    · right
      have hw : Valued.v ((ε₀ * u₀ : v.adicCompletionIntegers K) : v.adicCompletion K) = 1 := by
        show Valued.v ((ε₀ : v.adicCompletion K) * u) = 1
        rw [map_mul, hεw, hu, one_mul]
      have hfin := (s3 (ε₀ * u₀) hw).mpr (by rw [map_mul, hε₀]; exact h)
      exact hfin

theorem finiteField_exists_isSquare_div_pair {k : Type*} [Field k] [Finite k]
    (hk : ringChar k ≠ 2) (A B c : k) (hA : A ≠ 0) (hB : B ≠ 0) (hAB : A ≠ B)
    (hc : ¬ IsSquare c) :
    ∃ z : k, IsSquare ((z ^ 2 + A) / c) ∧ IsSquare ((z ^ 2 + B) / c) :=
by
  classical
  have h2 : (2 : k) ≠ 0 := Ring.two_ne_zero hk
  have hc0 : c ≠ 0 := by
    rintro rfl
    exact hc ⟨0, by simp⟩
  
  have key : ∀ A : k, A ≠ 0 →
      2 * Nat.card {z : k // z ^ 2 + A ≠ 0 ∧ IsSquare (z ^ 2 + A)} + 1 ≤ Nat.card k := by
    intro A hA
    have rig : ∀ z y w u : k, z ^ 2 + A = y * y → w ^ 2 + A = u * u → y - z = u - w →
        z = w ∧ y = u := by
      intro z y w u h1 h1' h3
      have e1 : (y - z) * (y + z) = A := by linear_combination -h1
      have e2 : (u - w) * (u + w) = A := by linear_combination -h1'
      have hs : y - z ≠ 0 := by
        intro h
        rw [h, zero_mul] at e1
        exact hA e1.symm
      have e3 : y + z = u + w := by
        apply mul_left_cancel₀ hs
        rw [e1, h3, e2]
      refine ⟨mul_left_cancel₀ h2 ?_, mul_left_cancel₀ h2 ?_⟩
      · linear_combination e3 - h3
      · linear_combination e3 + h3
    have nz : ∀ z y : k, z ^ 2 + A = y * y → y - z ≠ 0 := by
      intro z y h hs
      have e1 : (y - z) * (y + z) = A := by linear_combination -h
      rw [hs, zero_mul] at e1
      exact hA e1.symm
    let P := {z : k // z ^ 2 + A ≠ 0 ∧ IsSquare (z ^ 2 + A)}
    let r : P → k := fun z => Classical.choose z.2.2
    have hr : ∀ z : P, (z : k) ^ 2 + A = r z * r z := fun z => Classical.choose_spec z.2.2
    have hr0 : ∀ z : P, r z ≠ 0 := fun z h => z.2.1 (by rw [hr z, h, mul_zero])
    have hrn : ∀ z : P, (z : k) ^ 2 + A = (-r z) * (-r z) := fun z => by rw [hr z]; ring
    let f : P ⊕ P → {s : k // s ≠ 0} :=
      Sum.elim (fun z => ⟨r z - z, nz _ _ (hr z)⟩) (fun z => ⟨-r z - z, nz _ _ (hrn z)⟩)
    have hf : Function.Injective f := by
      rintro (z | z) (w | w) h
      · have h' : r z - z = r w - w := congrArg Subtype.val h
        exact congrArg Sum.inl (Subtype.ext (rig _ _ _ _ (hr z) (hr w) h').1)
      · have h' : r z - z = -r w - w := congrArg Subtype.val h
        obtain ⟨h1, h1'⟩ := rig _ _ _ _ (hr z) (hrn w) h'
        have hzw : z = w := Subtype.ext h1
        subst hzw
        exfalso
        apply hr0 z
        have : (2 : k) * r z = 0 := by linear_combination h1'
        exact (mul_eq_zero.mp this).resolve_left h2
      · have h' : -r z - z = r w - w := congrArg Subtype.val h
        obtain ⟨h1, h1'⟩ := rig _ _ _ _ (hrn z) (hr w) h'
        have hzw : z = w := Subtype.ext h1
        subst hzw
        exfalso
        apply hr0 z
        have : (2 : k) * r z = 0 := by linear_combination -h1'
        exact (mul_eq_zero.mp this).resolve_left h2
      · have h' : -r z - z = -r w - w := congrArg Subtype.val h
        exact congrArg Sum.inr (Subtype.ext (rig _ _ _ _ (hrn z) (hrn w) h').1)
    have hcard := Nat.card_le_card_of_injective f hf
    rw [Nat.card_sum] at hcard
    have hU : Nat.card {s : k // s ≠ 0} + 1 = Nat.card k := by
      haveI := Fintype.ofFinite k
      have hpos := Fintype.card_pos (α := k)
      rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card, Fintype.card_subtype_compl,
        Fintype.card_subtype_eq]
      omega
    change Nat.card P + Nat.card P ≤ Nat.card {s : k // s ≠ 0} at hcard
    change 2 * Nat.card P + 1 ≤ Nat.card k
    omega
  
  have s3 : ∀ X : k, ¬ (X ≠ 0 ∧ IsSquare X) → IsSquare (X / c) := by
    intro X hX
    by_cases hX0 : X = 0
    · rw [hX0, zero_div]
      exact ⟨0, by simp⟩
    · have hXns : ¬ IsSquare X := fun h => hX ⟨hX0, h⟩
      haveI := Fintype.ofFinite k
      have h1 := (quadraticChar_neg_one_iff_not_isSquare (F := k)).mpr hXns
      have h1' := (quadraticChar_neg_one_iff_not_isSquare (F := k)).mpr hc
      have hprod : X * c ≠ 0 := mul_ne_zero hX0 hc0
      have hsq : IsSquare (X * c) := by
        rw [← quadraticChar_one_iff_isSquare hprod, map_mul, h1, h1']
        norm_num
      obtain ⟨t, ht⟩ := hsq
      refine ⟨t / c, ?_⟩
      rw [div_mul_div_comm, ← ht, mul_div_mul_right _ _ hc0]
  
  have hex : ∃ z : k, ¬ (z ^ 2 + A ≠ 0 ∧ IsSquare (z ^ 2 + A)) ∧
      ¬ (z ^ 2 + B ≠ 0 ∧ IsSquare (z ^ 2 + B)) := by
    by_contra hne
    have hall : ∀ z : k, (z ^ 2 + A ≠ 0 ∧ IsSquare (z ^ 2 + A)) ∨
        (z ^ 2 + B ≠ 0 ∧ IsSquare (z ^ 2 + B)) := by
      intro z
      by_contra h
      exact hne ⟨z, fun h' => h (Or.inl h'), fun h' => h (Or.inr h')⟩
    let g : k → {z : k // z ^ 2 + A ≠ 0 ∧ IsSquare (z ^ 2 + A)} ⊕
        {z : k // z ^ 2 + B ≠ 0 ∧ IsSquare (z ^ 2 + B)} := fun z =>
      if h : z ^ 2 + A ≠ 0 ∧ IsSquare (z ^ 2 + A) then Sum.inl ⟨z, h⟩
      else Sum.inr ⟨z, (hall z).resolve_left h⟩
    have hg : Function.LeftInverse (Sum.elim Subtype.val Subtype.val) g := by
      intro z
      simp only [g]
      split_ifs <;> rfl
    have hle := Nat.card_le_card_of_injective g hg.injective
    rw [Nat.card_sum] at hle
    have hkA := key A hA
    have hkB := key B hB
    omega
  obtain ⟨z, hzA, hzB⟩ := hex
  exact ⟨z, s3 _ hzA, s3 _ hzB⟩

theorem adicCompletion_exists_sq_add_nonsquare_unit {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : IsDedekindDomain.HeightOneSpectrum.valuation K v 2 = 1) :
    ∀ c : v.adicCompletion K, Valued.v c = 1 → ∃ x : v.adicCompletion K,
      Valued.v x ≤ 1 ∧ Valued.v (x ^ 2 + c) = 1 ∧ ¬ IsSquare (x ^ 2 + c) :=
by
  classical
  
  have ffact : ∀ {k : Type u} [Field k] [Finite k], ringChar k ≠ 2 → ∀ c : k, c ≠ 0 →
      ∃ z : k, z ^ 2 + c ≠ 0 ∧ ¬ IsSquare (z ^ 2 + c) := by
    intro k _ _ hk c hc
    by_cases H : ∃ w : k, w ≠ 0 ∧ w ^ 2 + c ≠ 0
    · obtain ⟨w, hw, hwc⟩ := H
      obtain ⟨ε, hε⟩ := FiniteField.exists_nonsquare hk
      have hε0 : ε ≠ 0 := by
        rintro rfl
        exact hε ⟨0, by ring⟩
      have hw2 : w ^ 2 ≠ 0 := pow_ne_zero 2 hw
      have hAB : c ≠ w ^ 2 + c := by
        intro h
        apply hw2
        linear_combination -h
      obtain ⟨z, ⟨s, hs⟩, ⟨t, ht⟩⟩ :=
        finiteField_exists_isSquare_div_pair hk c (w ^ 2 + c) ε hc hwc hAB hε
      rw [div_eq_iff hε0] at hs ht
      have h1 : z ^ 2 + c ≠ 0 := by
        intro h0
        have hw' : w ^ 2 = t * t * ε := by linear_combination ht - h0
        have ht0 : t ≠ 0 := by
          rintro rfl
          apply hw2
          rw [hw']
          ring
        apply hε
        refine ⟨w / t, ?_⟩
        rw [div_mul_div_comm, eq_div_iff (mul_ne_zero ht0 ht0)]
        linear_combination -hw'
      refine ⟨z, h1, ?_⟩
      rintro ⟨u, hu⟩
      have hs0 : s ≠ 0 := by
        rintro rfl
        apply h1
        rw [hs]
        ring
      apply hε
      refine ⟨u / s, ?_⟩
      rw [div_mul_div_comm, eq_div_iff (mul_ne_zero hs0 hs0)]
      linear_combination hu - hs
    · push_neg at H
      refine ⟨0, by simpa using hc, ?_⟩
      rintro ⟨u, hu⟩
      have hu' : c = u * u := by simpa using hu
      have hu0 : u ≠ 0 := by
        rintro rfl
        apply hc
        rw [hu']
        ring
      have h2c := H u hu0
      have h2k : (2 : k) ≠ 0 := Ring.two_ne_zero hk
      apply mul_ne_zero h2k hc
      linear_combination h2c + hu'
  intro c hc
  obtain ⟨k, _, _, r, hk, hsurj, hker⟩ := adicCompletionIntegers_exists_finite_residue v h2
  have memO : ∀ y : v.adicCompletion K, Valued.v y ≤ 1 → y ∈ v.adicCompletionIntegers K :=
    fun y hy => (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers _ K v).2 hy
  obtain ⟨c', hc'⟩ : ∃ c' : v.adicCompletionIntegers K, (c' : v.adicCompletion K) = c :=
    ⟨⟨c, memO c hc.le⟩, rfl⟩
  subst hc'
  have hrc : r c' ≠ 0 := by
    intro h
    have hlt := (hker c').1 h
    rw [hc] at hlt
    exact lt_irrefl _ hlt
  obtain ⟨z, hz0, hzns⟩ := ffact hk (r c') hrc
  obtain ⟨x', hx'⟩ := hsurj z
  have hS : ((x' ^ 2 + c' : v.adicCompletionIntegers K) : v.adicCompletion K) =
      (x' : v.adicCompletion K) ^ 2 + (c' : v.adicCompletion K) := by
    norm_cast
  have hrS : r (x' ^ 2 + c') = z ^ 2 + r c' := by rw [map_add, map_pow, hx']
  have hle : Valued.v ((x' : v.adicCompletion K) ^ 2 + (c' : v.adicCompletion K)) ≤ 1 := by
    rw [← hS]
    exact (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers _ K v).1 (x' ^ 2 + c').2
  have hv1 : Valued.v ((x' : v.adicCompletion K) ^ 2 + (c' : v.adicCompletion K)) = 1 := by
    refine le_antisymm hle (not_lt.mp fun hlt => hz0 ?_)
    rw [← hrS]
    exact (hker _).2 (by rw [hS]; exact hlt)
  refine ⟨(x' : v.adicCompletion K), ?_, hv1, ?_⟩
  · exact (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers _ K v).1 x'.2
  · rintro ⟨y, hy⟩
    have hyy : Valued.v y * Valued.v y = 1 := by rw [← map_mul, ← hy, hv1]
    have hy1 : Valued.v y ≤ 1 := by
      by_contra hlt
      push_neg at hlt
      have h1 := one_lt_mul'' hlt hlt
      rw [hyy] at h1
      exact lt_irrefl _ h1
    apply hzns
    refine ⟨r ⟨y, memO y hy1⟩, ?_⟩
    rw [← hrS, ← map_mul]
    congr 1
    apply Subtype.ext
    rw [hS, hy]
    rfl

theorem hilbSym_odd_unit_formula {F : Type*} [Field F]
    (w : Valuation F (WithZero (Multiplicative ℤ)))
    (hsq : ∀ u : F, w (u - 1) < 1 → IsSquare u)
    (ε : F) (hεw : w ε = 1) (hεns : ¬ IsSquare ε)
    (hεd : ∀ u : F, w u = 1 → IsSquare u ∨ IsSquare (ε * u))
    (hres : ∀ c : F, w c = 1 → ∃ x : F, w x ≤ 1 ∧ w (x ^ 2 + c) = 1 ∧ ¬ IsSquare (x ^ 2 + c))
    (π : F) (hπ : w π = WithZero.exp (-1 : ℤ))
    (a b : F) (n : ℤ) (ha : w a = 1) (hb : w b = WithZero.exp (-n)) :
    hilbSym F a b = 1 ↔ (Even n ∨ IsSquare a) :=
by
  classical
  have hne0 : ∀ z : F, w z = 1 → z ≠ 0 := by
    intro z hz h; rw [h, map_zero] at hz; exact zero_ne_one hz
  have ha0 := hne0 a ha
  have hε0 := hne0 ε hεw
  
  have hs1 : hilbSym F a b = 1 ↔ ∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1 := by
    unfold hilbSym
    split_ifs with h
    · exact ⟨fun _ => h, fun _ => rfl⟩
    · exact ⟨fun h' => absurd h' (by decide), fun h' => absurd h' h⟩
  
  have units : ∀ b' : F, w b' = 1 → ∃ x y : F, a * x ^ 2 + b' * y ^ 2 = 1 := by
    intro b' hb'
    have hb'0 := hne0 b' hb'
    by_cases hsa : IsSquare a
    · obtain ⟨s, hs⟩ := hsa
      have hs0 : s ≠ 0 := by rintro rfl; apply ha0; rw [hs]; ring
      exact ⟨s⁻¹, 0, by rw [hs]; field_simp; ring⟩
    by_cases hsb : IsSquare b'
    · obtain ⟨s, hs⟩ := hsb
      have hs0 : s ≠ 0 := by rintro rfl; apply hb'0; rw [hs]; ring
      exact ⟨0, s⁻¹, by rw [hs]; field_simp; ring⟩
    obtain ⟨p, hp⟩ := (hεd a ha).resolve_left hsa
    obtain ⟨q, hq⟩ := (hεd b' hb').resolve_left hsb
    have hp0 : p ≠ 0 := by
      rintro rfl; apply mul_ne_zero hε0 ha0; rw [hp]; ring
    have hq0 : q ≠ 0 := by
      rintro rfl; apply mul_ne_zero hε0 hb'0; rw [hq]; ring
    obtain ⟨y₀, -, hy1, hyns⟩ := hres 1 (map_one w)
    obtain ⟨σ, hσ⟩ := (hεd _ hy1).resolve_left hyns
    have hy0 := hne0 _ hy1
    have hσ0 : σ ≠ 0 := by
      rintro rfl; apply mul_ne_zero hε0 hy0; rw [hσ]; ring
    refine ⟨y₀ * ε / σ / p, ε / σ / q, ?_⟩
    have e1 : a * (y₀ * ε / σ / p) ^ 2 = y₀ ^ 2 / (y₀ ^ 2 + 1) := by
      rw [eq_div_iff hy0]
      have : a * (y₀ * ε / σ / p) ^ 2 * (y₀ ^ 2 + 1) =
          y₀ ^ 2 * (ε * a) * (ε * (y₀ ^ 2 + 1)) / ((σ * σ) * (p * p)) := by
        field_simp
      rw [this, hp, hσ]
      field_simp
    have e2 : b' * (ε / σ / q) ^ 2 = 1 / (y₀ ^ 2 + 1) := by
      rw [eq_div_iff hy0]
      have : b' * (ε / σ / q) ^ 2 * (y₀ ^ 2 + 1) =
          (ε * b') * (ε * (y₀ ^ 2 + 1)) / ((σ * σ) * (q * q)) := by
        field_simp
      rw [this, hq, hσ]
      field_simp
    rw [e1, e2, ← add_div, div_self hy0]
  
  have oddc : ∀ x y : F, a * x ^ 2 + b * y ^ 2 = 1 → Odd n → IsSquare a := by
    intro x y h hn
    obtain ⟨r, hr⟩ := hn
    have hlt : w (b * y ^ 2) < 1 := by
      by_cases hy : y = 0
      · rw [hy]; simp
      have hwy : w y ≠ 0 := (Valuation.ne_zero_iff w).mpr hy
      have hyk : w y = WithZero.exp (WithZero.log (w y)) := (WithZero.exp_log hwy).symm
      have hby : w (b * y ^ 2) = WithZero.exp (-n + (WithZero.log (w y) + WithZero.log (w y))) := by
        rw [map_mul, map_pow, hb, hyk, WithZero.log_exp, WithZero.exp_add, WithZero.exp_add, sq]
      rcases lt_trichotomy (w (b * y ^ 2)) 1 with h1 | h1 | h1
      · exact h1
      · exfalso
        rw [hby, ← WithZero.exp_zero, WithZero.exp_inj] at h1
        omega
      · exfalso
        have hax : a * x ^ 2 = 1 - b * y ^ 2 := by linear_combination h
        have hwax : w (a * x ^ 2) = w (b * y ^ 2) := by
          rw [hax]
          exact Valuation.map_sub_eq_of_lt_right w (by rw [map_one]; exact h1)
        have hx : x ≠ 0 := by
          rintro rfl
          rw [zero_pow two_ne_zero, mul_zero, map_zero] at hwax
          rw [← hwax] at h1
          exact not_lt_of_ge zero_le' h1
        have hwx : w x ≠ 0 := (Valuation.ne_zero_iff w).mpr hx
        have hxk : w x = WithZero.exp (WithZero.log (w x)) := (WithZero.exp_log hwx).symm
        have hax' : w (a * x ^ 2) = WithZero.exp (WithZero.log (w x) + WithZero.log (w x)) := by
          rw [map_mul, map_pow, ha, one_mul, hxk, WithZero.log_exp, WithZero.exp_add, sq]
        rw [hax', hby, WithZero.exp_inj] at hwax
        omega
    have hx : x ≠ 0 := by
      rintro rfl
      have h' : b * y ^ 2 = 1 := by linear_combination h
      rw [h', map_one] at hlt
      exact lt_irrefl _ hlt
    obtain ⟨s, hs⟩ := hsq (a * x ^ 2) (by
      rw [show a * x ^ 2 - 1 = -(b * y ^ 2) by linear_combination h, Valuation.map_neg]
      exact hlt)
    refine ⟨s / x, ?_⟩
    field_simp
    linear_combination hs
  
  have evenc : Even n → ∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1 := by
    rintro ⟨m, hm⟩
    have hρ : w (π ^ m) = WithZero.exp (-m) := by
      rw [map_zpow₀, hπ, ← WithZero.exp_zsmul, smul_eq_mul, mul_neg, mul_one]
    have hρ0 : π ^ m ≠ 0 := by
      intro h0; rw [h0, map_zero] at hρ; exact WithZero.exp_ne_zero hρ.symm
    have hb' : w (b / (π ^ m) ^ 2) = 1 := by
      rw [map_div₀, map_pow, hρ, hb, hm, neg_add, WithZero.exp_add, sq]
      exact div_self (mul_ne_zero WithZero.exp_ne_zero WithZero.exp_ne_zero)
    obtain ⟨x, Y, hxY⟩ := units _ hb'
    refine ⟨x, Y / π ^ m, ?_⟩
    rw [← hxY]
    field_simp
  
  rw [hs1]
  constructor
  · rintro ⟨x, y, h⟩
    rcases Int.even_or_odd n with he | ho
    · exact Or.inl he
    · exact Or.inr (oddc x y h ho)
  · rintro (he | ⟨s, hs⟩)
    · exact evenc he
    · have hs0 : s ≠ 0 := by rintro rfl; apply ha0; rw [hs]; ring
      exact ⟨s⁻¹, 0, by rw [hs]; field_simp; ring⟩

theorem hilbSym_mul_nondeg_of_odd_formula {F : Type*} [Field F] (h2 : (2 : F) ≠ 0)
    (w : Valuation F (WithZero (Multiplicative ℤ)))
    (π : F) (hπ : w π = WithZero.exp (-1 : ℤ))
    (ε : F) (hεw : w ε = 1) (hεns : ¬ IsSquare ε)
    (hεd : ∀ u : F, w u = 1 → IsSquare u ∨ IsSquare (ε * u))
    (hform : ∀ (a b : F) (n : ℤ), w a = 1 → w b = WithZero.exp (-n) →
      (hilbSym F a b = 1 ↔ (Even n ∨ IsSquare a))) :
    (∀ a a' b : F, a ≠ 0 → a' ≠ 0 → b ≠ 0 →
      hilbSym F (a * a') b = hilbSym F a b * hilbSym F a' b) ∧
    (∀ b : F, b ≠ 0 → ¬ IsSquare b → ∃ a : F, a ≠ 0 ∧ hilbSym F a b = -1) :=
by
  classical
  
  have hne1 : (-1 : ℤˣ) ≠ 1 := by decide
  have Uneg : ∀ s : ℤˣ, s ≠ 1 → s = -1 := by
    intro s hs
    rcases Int.units_eq_one_or s with h | h
    · exact absurd h hs
    · exact h
  have U4 : ∀ s t r : ℤˣ, (s = 1 ↔ (t = 1 ↔ r = 1)) → s = t * r := by
    intro s t r h
    rcases Int.units_eq_one_or t with rfl | rfl <;> rcases Int.units_eq_one_or r with rfl | rfl
    · rw [mul_one]; exact h.mpr Iff.rfl
    · rw [one_mul]; exact Uneg s (fun hs => hne1 ((h.mp hs).mp rfl))
    · rw [mul_one]; exact Uneg s (fun hs => hne1 ((h.mp hs).mpr rfl))
    · rw [Int.units_mul_self]; exact h.mpr Iff.rfl
  
  have hv0 : ∀ (c : F) (k : ℤ), w c = WithZero.exp k → c ≠ 0 := by
    intro c k hc h
    rw [h, map_zero] at hc
    exact WithZero.exp_ne_zero hc.symm
  have hv1 : ∀ c : F, w c = 1 → c ≠ 0 := by
    intro c hc h
    rw [h, map_zero] at hc
    exact zero_ne_one hc
  have hex : ∀ c : F, c ≠ 0 → ∃ k : ℤ, w c = WithZero.exp (-k) := by
    intro c hc
    have h0 : w c ≠ 0 := by rwa [ne_eq, Valuation.zero_iff]
    exact ⟨-WithZero.log (w c), by rw [neg_neg, WithZero.exp_log h0]⟩
  have hvmul : ∀ (c c' : F) (k k' : ℤ), w c = WithZero.exp (-k) → w c' = WithZero.exp (-k') →
      w (c * c') = WithZero.exp (-(k + k')) := by
    intro c c' k k' hc hc'
    rw [map_mul, hc, hc', ← WithZero.exp_add, neg_add]
  have hπ0 : π ≠ 0 := hv0 π _ hπ
  have hvz : ∀ j : ℤ, w (π ^ j) = WithZero.exp (-j) := by
    intro j
    rw [map_zpow₀, hπ, ← WithZero.exp_zsmul]
    congr 1
    simp
  
  have S1 : ∀ a b : F, hilbSym F a b = hilbSym F b a := by
    intro a b
    have hiff : (∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1) ↔
        (∃ x y : F, b * x ^ 2 + a * y ^ 2 = 1) :=
      ⟨fun ⟨x, y, h⟩ => ⟨y, x, by rw [← h]; ring⟩, fun ⟨x, y, h⟩ => ⟨y, x, by rw [← h]; ring⟩⟩
    unfold hilbSym
    by_cases h : ∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1
    · rw [if_pos h, if_pos (hiff.mp h)]
    · rw [if_neg h, if_neg (fun h' => h (hiff.mpr h'))]
  
  have S2 : ∀ a b s : F, s ≠ 0 → hilbSym F (a * s ^ 2) b = hilbSym F a b := by
    intro a b s hs
    have hinv : s * s⁻¹ = 1 := mul_inv_cancel₀ hs
    have hiff : (∃ x y : F, a * s ^ 2 * x ^ 2 + b * y ^ 2 = 1) ↔
        (∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1) := by
      constructor
      · rintro ⟨x, y, h⟩
        exact ⟨s * x, y, by rw [← h]; ring⟩
      · rintro ⟨x, y, h⟩
        refine ⟨x * s⁻¹, y, ?_⟩
        linear_combination h + a * x ^ 2 * (s * s⁻¹ + 1) * hinv
    unfold hilbSym
    by_cases h : ∃ x y : F, a * s ^ 2 * x ^ 2 + b * y ^ 2 = 1
    · rw [if_pos h, if_pos (hiff.mp h)]
    · rw [if_neg h, if_neg (fun h' => h (hiff.mpr h'))]
  
  have K3 : ∀ a b : F, a ≠ 0 → (∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1) →
      ∃ X Y : F, a * X ^ 2 + (-(a * b)) * Y ^ 2 = 1 := by
    rintro a b ha ⟨x, y, h⟩
    by_cases hx : x = 0
    · subst hx
      obtain ⟨t, ht⟩ : ∃ t : F, 2 * t = 1 := ⟨2⁻¹, mul_inv_cancel₀ h2⟩
      have hj : a * a⁻¹ = 1 := mul_inv_cancel₀ ha
      refine ⟨(1 + a⁻¹) * t, y * (1 - a⁻¹) * t, ?_⟩
      linear_combination (-(a * t ^ 2 * (1 - a⁻¹) ^ 2)) * h + (2 * t) ^ 2 * hj +
        (2 * t + 1) * ht
    · have hax : a * x ≠ 0 := mul_ne_zero ha hx
      have hinv : a * x * (a * x)⁻¹ = 1 := mul_inv_cancel₀ hax
      refine ⟨(a * x)⁻¹, y * (a * x)⁻¹, ?_⟩
      linear_combination (-(a * ((a * x)⁻¹) ^ 2)) * h + (a * x * (a * x)⁻¹ + 1) * hinv
  have S3 : ∀ a b : F, a ≠ 0 → hilbSym F a b = hilbSym F a (-(a * b)) := by
    intro a b ha
    have hiff : (∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1) ↔
        (∃ x y : F, a * x ^ 2 + (-(a * b)) * y ^ 2 = 1) := by
      refine ⟨K3 a b ha, fun h => ?_⟩
      obtain ⟨X, Y, hXY⟩ := K3 a (-(a * b)) ha h
      exact ⟨X, a * Y, by rw [← hXY]; ring⟩
    unfold hilbSym
    by_cases h : ∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1
    · rw [if_pos h, if_pos (hiff.mp h)]
    · rw [if_neg h, if_neg (fun h' => h (hiff.mpr h'))]
  
  have F6 : ∀ z s : F, s ≠ 0 → (IsSquare (z * s ^ 2) ↔ IsSquare z) := by
    intro z s hs
    have hinv : s * s⁻¹ = 1 := mul_inv_cancel₀ hs
    constructor
    · rintro ⟨q, hq⟩
      refine ⟨q * s⁻¹, ?_⟩
      linear_combination (s⁻¹ ^ 2) * hq - z * (s * s⁻¹ + 1) * hinv
    · rintro ⟨q, hq⟩
      exact ⟨q * s, by rw [hq]; ring⟩
  have sqdiv : ∀ u v : F, IsSquare u → u ≠ 0 → IsSquare (u * v) → IsSquare v := by
    rintro u v ⟨r, hr⟩ hu ⟨q, hq⟩
    have hr0 : r ≠ 0 := by
      rintro rfl
      exact hu (by rw [hr]; ring)
    have hinv : r * r⁻¹ = 1 := mul_inv_cancel₀ hr0
    refine ⟨q * r⁻¹, ?_⟩
    linear_combination (r⁻¹ ^ 2) * hq - (v * r⁻¹ ^ 2) * hr - v * (r * r⁻¹ + 1) * hinv
  have F5 : ∀ c r : F, r * r ≠ 0 → hilbSym F c (r * r) = 1 := by
    intro c r hb
    have hr : r ≠ 0 := by
      rintro rfl
      exact hb (by ring)
    have hinv : r * r⁻¹ = 1 := mul_inv_cancel₀ hr
    unfold hilbSym
    rw [if_pos ⟨0, r⁻¹, by linear_combination (r * r⁻¹ + 1) * hinv⟩]
  
  have decomp : ∀ (x : F) (m : ℤ), w x = WithZero.exp (-m) → Even m →
      ∃ u s : F, w u = 1 ∧ s ≠ 0 ∧ x = u * s ^ 2 := by
    rintro x m hx ⟨k, rfl⟩
    refine ⟨x * π ^ (-(k + k)), π ^ k, ?_, zpow_ne_zero k hπ0, ?_⟩
    · rw [map_mul, hx, hvz, ← WithZero.exp_add,
        show -(k + k) + -(-(k + k)) = (0 : ℤ) by ring, WithZero.exp_zero]
    · symm
      rw [mul_assoc, sq, ← zpow_add₀ hπ0, ← zpow_add₀ hπ0,
        show -(k + k) + (k + k) = (0 : ℤ) by ring, zpow_zero, mul_one]
  
  have S4 : ∀ (x y : F) (m n : ℤ), w x = WithZero.exp (-m) → Even m →
      w y = WithZero.exp (-n) → (hilbSym F x y = 1 ↔ (Even n ∨ IsSquare x)) := by
    intro x y m n hx hm hy
    obtain ⟨u, s, hu, hs, rfl⟩ := decomp x m hx hm
    rw [S2 u y s hs, F6 u s hs]
    exact hform u y n hu hy
  
  have S5u : ∀ u u' : F, w u = 1 → w u' = 1 →
      (IsSquare (u * u') ↔ (IsSquare u ↔ IsSquare u')) := by
    intro u u' hu hu'
    have hu0 := hv1 u hu
    have hu0' := hv1 u' hu'
    have hε0 := hv1 ε hεw
    by_cases h1 : IsSquare u <;> by_cases h2 : IsSquare u'
    · exact ⟨fun _ => ⟨fun _ => h2, fun _ => h1⟩, fun _ => h1.mul h2⟩
    · exact ⟨fun h => absurd (sqdiv u u' h1 hu0 h) h2, fun h => absurd (h.mp h1) h2⟩
    · exact ⟨fun h => absurd (sqdiv u' u h2 hu0' (by rwa [mul_comm])) h1,
        fun h => absurd (h.mpr h2) h1⟩
    · refine ⟨fun _ => ⟨fun h => absurd h h1, fun h => absurd h h2⟩, fun _ => ?_⟩
      have e1 := (hεd u hu).resolve_left h1
      have e2 := (hεd u' hu').resolve_left h2
      have h3 : IsSquare (ε * ε * (u * u')) := by
        have h4 := e1.mul e2
        rwa [show ε * u * (ε * u') = ε * ε * (u * u') by ring] at h4
      exact sqdiv (ε * ε) (u * u') ⟨ε, rfl⟩ (mul_ne_zero hε0 hε0) h3
  have S5 : ∀ (x x' : F) (m m' : ℤ), w x = WithZero.exp (-m) → Even m →
      w x' = WithZero.exp (-m') → Even m' →
      (IsSquare (x * x') ↔ (IsSquare x ↔ IsSquare x')) := by
    intro x x' m m' hx hm hx' hm'
    obtain ⟨u, s, hu, hs, rfl⟩ := decomp x m hx hm
    obtain ⟨u', s', hu', hs', rfl⟩ := decomp x' m' hx' hm'
    rw [show u * s ^ 2 * (u' * s' ^ 2) = (u * u') * (s * s') ^ 2 by ring,
      F6 _ _ (mul_ne_zero hs hs'), F6 _ _ hs, F6 _ _ hs']
    exact S5u u u' hu hu'
  refine ⟨?_, ?_⟩
  · intro a a' b ha ha' hb
    by_cases hsq : IsSquare b
    · obtain ⟨r, rfl⟩ := hsq
      rw [F5 _ r hb, F5 _ r hb, F5 _ r hb, mul_one]
    obtain ⟨m, hm⟩ := hex a ha
    obtain ⟨m', hm'⟩ := hex a' ha'
    obtain ⟨n, hn⟩ := hex b hb
    have hmm := hvmul a a' m m' hm hm'
    have hnegv : ∀ (c : F) (k : ℤ), w c = WithZero.exp (-k) →
        w (-(c * b)) = WithZero.exp (-(k + n)) :=
      fun c k hc => by rw [Valuation.map_neg]; exact hvmul c b k n hc hn
    have E1 : Even n → ∀ (c : F) (k : ℤ), w c = WithZero.exp (-k) →
        (hilbSym F c b = 1 ↔ Even k) := by
      intro hne c k hc
      rw [S1, S4 b c n k hn hne hc]
      exact or_iff_left hsq
    have E2 : Odd n → ∀ (c : F) (k : ℤ), w c = WithZero.exp (-k) → Even k →
        (hilbSym F c b = 1 ↔ IsSquare c) := by
      intro hno c k hc hk
      rw [S4 c b k n hc hk hn]
      exact or_iff_right (Int.not_even_iff_odd.mpr hno)
    have E3 : Odd n → ∀ (c : F) (k : ℤ), w c = WithZero.exp (-k) → Odd k →
        (hilbSym F c b = 1 ↔ IsSquare (-(c * b))) := by
      intro hno c k hc hk
      rw [S3 c b (hv0 c _ hc), S1, S4 (-(c * b)) c (k + n) k (hnegv c k hc) (hk.add_odd hno) hc]
      exact or_iff_right (Int.not_even_iff_odd.mpr hk)
    apply U4
    rcases Int.even_or_odd n with hne | hno
    · rw [E1 hne _ _ hmm, E1 hne _ _ hm, E1 hne _ _ hm']
      exact Int.even_add
    rcases Int.even_or_odd m with he | ho <;> rcases Int.even_or_odd m' with he' | ho'
    · rw [E2 hno _ _ hmm (he.add he'), E2 hno _ _ hm he, E2 hno _ _ hm' he']
      exact S5 a a' m m' hm he hm' he'
    · rw [E3 hno _ _ hmm (he.add_odd ho'), E2 hno _ _ hm he, E3 hno _ _ hm' ho',
        show -(a * a' * b) = a * (-(a' * b)) by ring]
      exact S5 a (-(a' * b)) m (m' + n) hm he (hnegv a' m' hm') (ho'.add_odd hno)
    · rw [E3 hno _ _ hmm (ho.add_even he'), E3 hno _ _ hm ho, E2 hno _ _ hm' he',
        show -(a * a' * b) = (-(a * b)) * a' by ring]
      exact S5 (-(a * b)) a' (m + n) m' (hnegv a m hm) (ho.add_odd hno) hm' he'
    · rw [E2 hno _ _ hmm (ho.add_odd ho'), E3 hno _ _ hm ho, E3 hno _ _ hm' ho',
        ← S5 (-(a * b)) (-(a' * b)) (m + n) (m' + n) (hnegv a m hm) (ho.add_odd hno)
          (hnegv a' m' hm') (ho'.add_odd hno),
        show -(a * b) * -(a' * b) = (a * a') * b ^ 2 by ring, F6 _ _ hb]
  · intro b hb hbns
    obtain ⟨n, hn⟩ := hex b hb
    rcases Int.even_or_odd n with hne | hno
    · refine ⟨π, hπ0, Uneg _ ?_⟩
      rw [ne_eq, S1, S4 b π n 1 hn hne hπ]
      rintro (h | h)
      · exact Int.not_even_one h
      · exact hbns h
    · refine ⟨ε, hv1 ε hεw, Uneg _ ?_⟩
      rw [ne_eq, hform ε b n hεw hn]
      rintro (h | h)
      · exact Int.not_even_iff_odd.mpr hno h
      · exact hεns h

theorem exists_artinSchreier_element_adicCompletion {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    ∃ ρ : v.adicCompletion K, ∀ y : v.adicCompletion K,
      Valued.v y ≤ 1 → Valued.v (y ^ 2 + y - ρ) = 1 :=
by
  
  have approx : ∀ k : K, IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 →
      ∃ a : NumberField.RingOfIntegers K,
        IsDedekindDomain.HeightOneSpectrum.valuation K v
          (k - algebraMap (NumberField.RingOfIntegers K) K a) < 1 := by
    intro k hk
    obtain ⟨n, d, hd, hnd⟩ := IsFractionRing.div_surjective (A := NumberField.RingOfIntegers K) k
    have hd0 : d ≠ 0 := nonZeroDivisors.ne_zero hd
    have hιd : algebraMap (NumberField.RingOfIntegers K) K d ≠ 0 := by
      rw [ne_eq, map_eq_zero_iff _ (IsFractionRing.injective (NumberField.RingOfIntegers K) K)]
      exact hd0
    have hn : algebraMap (NumberField.RingOfIntegers K) K n =
        k * algebraMap (NumberField.RingOfIntegers K) K d := by
      rw [← hnd, div_mul_cancel₀ _ hιd]
    have hv0 : v.intValuation d ≠ 0 := v.intValuation_ne_zero d hd0
    have hv1 : v.intValuation d ≤ 1 := v.intValuation_le_one d
    have hlog : WithZero.log (v.intValuation d) ≤ 0 := by
      have h1 : WithZero.exp (WithZero.log (v.intValuation d)) ≤ WithZero.exp (0 : ℤ) := by
        rw [WithZero.exp_log hv0, WithZero.exp_zero]; exact hv1
      exact WithZero.exp_le_exp.mp h1
    obtain ⟨m, hm⟩ : ∃ m : ℕ, v.intValuation d = WithZero.exp (-(m : ℤ)) := by
      refine ⟨(-WithZero.log (v.intValuation d)).toNat, ?_⟩
      rw [Int.toNat_of_nonneg (by omega), neg_neg, WithZero.exp_log hv0]
    obtain ⟨J, hJ⟩ : v.asIdeal ^ m ∣ Ideal.span {d} :=
      (v.intValuation_le_pow_iff_dvd d m).mp hm.le
    have hJP : ¬ J ≤ v.asIdeal := by
      intro hle
      have h3 : v.asIdeal ^ (m + 1) ∣ Ideal.span {d} := by
        rw [hJ, pow_succ]
        exact mul_dvd_mul_left _ (Ideal.dvd_iff_le.mpr hle)
      have h2 := (v.intValuation_le_pow_iff_dvd d (m + 1)).mpr h3
      rw [hm, WithZero.exp_le_exp] at h2
      push_cast at h2
      omega
    obtain ⟨t, htJ, htP⟩ := Set.not_subset.mp hJP
    have hnv : v.intValuation n ≤ WithZero.exp (-(m : ℤ)) := by
      have e1 : v.intValuation n = IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K n) :=
        (v.valuation_of_algebraMap (K := K) n).symm
      have e2 : v.intValuation d = IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K d) :=
        (v.valuation_of_algebraMap (K := K) d).symm
      rw [e1, hn, map_mul, ← e2, hm]
      calc _ ≤ 1 * WithZero.exp (-(m : ℤ)) := mul_le_mul_right' hk _
        _ = _ := one_mul _
    have hnP : n ∈ v.asIdeal ^ m :=
      Ideal.dvd_span_singleton.mp ((v.intValuation_le_pow_iff_dvd n m).mp hnv)
    have hnt : n * t ∈ Ideal.span {d} := by
      rw [hJ]; exact Ideal.mul_mem_mul hnP htJ
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hnt
    have hbk : algebraMap (NumberField.RingOfIntegers K) K b =
        algebraMap (NumberField.RingOfIntegers K) K t * k := by
      have h4 := congrArg (algebraMap (NumberField.RingOfIntegers K) K) hb
      rw [map_mul, map_mul, hn] at h4
      apply mul_right_cancel₀ hιd
      rw [h4]; ring
    obtain ⟨s, i, hi, hsi⟩ := v.isMaximal.exists_inv htP
    refine ⟨s * b, ?_⟩
    have h1 : algebraMap (NumberField.RingOfIntegers K) K s *
        algebraMap (NumberField.RingOfIntegers K) K t +
        algebraMap (NumberField.RingOfIntegers K) K i = 1 := by
      rw [← map_mul, ← map_add, hsi, map_one]
    have key : algebraMap (NumberField.RingOfIntegers K) K t *
        (k - algebraMap (NumberField.RingOfIntegers K) K (s * b)) =
        algebraMap (NumberField.RingOfIntegers K) K b *
          algebraMap (NumberField.RingOfIntegers K) K i := by
      rw [map_mul]
      linear_combination (-1 : K) * hbk - algebraMap (NumberField.RingOfIntegers K) K b * h1
    have hvt : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K t) = 1 := by
      rw [v.valuation_of_algebraMap]; exact (v.intValuation_eq_one_iff).mpr htP
    have hvb : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K b) ≤ 1 := v.valuation_le_one (K := K) b
    have hvi : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K i) < 1 :=
      (v.valuation_lt_one_iff_mem (K := K) i).mpr hi
    have h5 := congrArg (IsDedekindDomain.HeightOneSpectrum.valuation K v) key
    rw [map_mul (IsDedekindDomain.HeightOneSpectrum.valuation K v), hvt, one_mul,
      map_mul (IsDedekindDomain.HeightOneSpectrum.valuation K v)] at h5
    rw [h5]
    calc _ ≤ 1 * IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K i) := mul_le_mul_right' hvb _
      _ = _ := one_mul _
      _ < 1 := hvi
  have hval : ∀ x : K, Valued.v (algebraMap K (v.adicCompletion K) x) =
      IsDedekindDomain.HeightOneSpectrum.valuation K v x := fun x =>
    IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v x
  
  have hker : ∀ x : v.adicCompletionIntegers K,
      IsLocalRing.residue _ x = 0 ↔ Valued.v (x : v.adicCompletion K) < 1 := fun x =>
    (IsLocalRing.residue_eq_zero_iff x).trans
      (Valuation.mem_maximalIdeal_iff (v.adicCompletion K) Valued.v (a := x))
  
  have hfin : Finite (IsLocalRing.ResidueField (v.adicCompletionIntegers K)) := by
    have hRK : ∀ r : NumberField.RingOfIntegers K,
        algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r =
          algebraMap K (v.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K r) :=
      fun r => IsScalarTower.algebraMap_apply _ _ _ r
    have hint : ∀ r : NumberField.RingOfIntegers K,
        algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r ∈
          v.adicCompletionIntegers K := by
      intro r
      rw [IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers, hRK, hval]
      exact v.valuation_le_one r
    let φ := (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K)).codRestrict
      (v.adicCompletionIntegers K) hint
    let ψ := (IsLocalRing.residue (v.adicCompletionIntegers K)).comp φ
    have hψ : ∀ r ∈ v.asIdeal, ψ r = 0 := by
      intro r hr
      show IsLocalRing.residue _ (φ r) = 0
      rw [hker]
      show Valued.v (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r) < 1
      rw [hRK, hval]
      exact (v.valuation_lt_one_iff_mem r).mpr hr
    let ψbar := Ideal.Quotient.lift v.asIdeal ψ hψ
    have hdense : DenseRange (algebraMap K (v.adicCompletion K)) := by
      have h := @UniformSpace.Completion.denseRange_coe
        (WithVal (IsDedekindDomain.HeightOneSpectrum.valuation K v)) _
      exact h
    have hsurj : Function.Surjective ψbar := by
      intro y
      obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective y
      have hU : {z : v.adicCompletion K | Valued.v (z - (x : v.adicCompletion K)) < 1} ∈
          nhds (x : v.adicCompletion K) :=
        Valued.mem_nhds.mpr ⟨1, fun z hz => by simpa using hz⟩
      obtain ⟨k, hk⟩ := hdense.mem_nhds hU
      simp only [Set.mem_setOf_eq] at hk
      have hk1 : IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 := by
        rw [← hval]
        have e : algebraMap K (v.adicCompletion K) k =
            (algebraMap K (v.adicCompletion K) k - x) + x := by ring
        rw [e]
        exact le_trans (Valuation.map_add _ _ _) (max_le hk.le x.2)
      obtain ⟨a, ha⟩ := approx k hk1
      refine ⟨Ideal.Quotient.mk v.asIdeal a, ?_⟩
      show ψ a = IsLocalRing.residue _ x
      show IsLocalRing.residue _ (φ a) = IsLocalRing.residue _ x
      rw [← sub_eq_zero, ← map_sub, hker]
      show Valued.v (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) a -
        (x : v.adicCompletion K)) < 1
      have e : algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) a -
          (x : v.adicCompletion K) =
          -(algebraMap K (v.adicCompletion K)
              (k - algebraMap (NumberField.RingOfIntegers K) K a)) +
            (algebraMap K (v.adicCompletion K) k - x) := by
        rw [hRK, map_sub]; ring
      rw [e]
      refine Valuation.map_add_lt _ ?_ hk
      rw [Valuation.map_neg, hval]
      exact ha
    haveI : Finite (NumberField.RingOfIntegers K ⧸ v.asIdeal) :=
      Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
    exact Finite.of_surjective ψbar hsurj
  
  have hns : ∃ c : IsLocalRing.ResidueField (v.adicCompletionIntegers K),
      ∀ t, t ^ 2 + t ≠ c := by
    by_contra hcon
    push_neg at hcon
    have hsurjf : Function.Surjective
        (fun t : IsLocalRing.ResidueField (v.adicCompletionIntegers K) => t ^ 2 + t) :=
      fun c => hcon c
    have hinj := Finite.injective_iff_surjective.mpr hsurjf
    have h0 : (0 : IsLocalRing.ResidueField (v.adicCompletionIntegers K)) = -1 :=
      hinj (by simp)
    exact one_ne_zero (neg_eq_zero.mp h0.symm)
  obtain ⟨cbar, hcbar⟩ := hns
  obtain ⟨c, rfl⟩ := IsLocalRing.residue_surjective cbar
  refine ⟨(c : v.adicCompletion K), fun y hy => ?_⟩
  have hyO : y ∈ v.adicCompletionIntegers K :=
    (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers _ _ v).mpr hy
  set y' : v.adicCompletionIntegers K := ⟨y, hyO⟩ with hy'
  have hz : ((y' ^ 2 + y' - c : v.adicCompletionIntegers K) : v.adicCompletion K) =
      y ^ 2 + y - (c : v.adicCompletion K) := rfl
  rw [← hz]
  refine le_antisymm ((y' ^ 2 + y' - c).2) (not_lt.mp ?_)
  intro hlt
  apply hcbar (IsLocalRing.residue _ y')
  rw [← sub_eq_zero, ← map_pow, ← map_add, ← map_sub]
  exact (hker _).mpr hlt

theorem artinSchreier_unit_and_uniformizer_not_norm {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : Valued.v (2 : v.adicCompletion K) ≠ 1)
    (ρ : v.adicCompletion K)
    (hρ : ∀ y : v.adicCompletion K, Valued.v y ≤ 1 → Valued.v (y ^ 2 + y - ρ) = 1)
    (ϖ : v.adicCompletion K)
    (hϖ : Valued.v ϖ = ((Multiplicative.ofAdd (-1 : ℤ) : Multiplicative ℤ) :
        WithZero (Multiplicative ℤ))) :
    Valued.v (1 + 4 * ρ) = 1 ∧
      ¬ ∃ z t : v.adicCompletion K, z ^ 2 - (1 + 4 * ρ) * t ^ 2 = ϖ :=
by
  
  have hρ1 : Valued.v ρ = 1 := by
    have h := hρ 0 (by simp)
    simpa using h
  
  have h2le : Valued.v (2 : v.adicCompletion K) ≤ 1 := by
    rw [← one_add_one_eq_two]
    exact Valuation.map_add_le _ (Valuation.map_one _).le (Valuation.map_one _).le
  have h2lt : Valued.v (2 : v.adicCompletion K) < 1 := lt_of_le_of_ne h2le h2
  
  have h4 : Valued.v (4 * ρ) < 1 := by
    have e : (4 : v.adicCompletion K) * ρ = 2 * 2 * ρ := by norm_num
    rw [e, Valuation.map_mul, Valuation.map_mul, hρ1, mul_one]
    exact mul_lt_one' h2lt h2lt
  refine ⟨?_, ?_⟩
  · rw [Valuation.map_add_eq_of_lt_left _ (by rw [Valuation.map_one]; exact h4),
      Valuation.map_one]
  
  have hN : ∀ x y : v.adicCompletion K,
      Valued.v (x ^ 2 - x * y - ρ * y ^ 2) = max (Valued.v x) (Valued.v y) ^ 2 := by
    intro x y
    rcases lt_or_ge (Valued.v y) (Valued.v x) with h | h
    · have hx0 : 0 < Valued.v x := lt_of_le_of_lt zero_le' h
      have e : x ^ 2 - x * y - ρ * y ^ 2 = x ^ 2 - (x * y + ρ * y ^ 2) := by ring
      have hxx : Valued.v (x ^ 2) = Valued.v x * Valued.v x := by
        rw [Valuation.map_pow, sq]
      have h1 : Valued.v (x * y) < Valued.v (x ^ 2) := by
        rw [hxx, Valuation.map_mul]
        exact mul_lt_mul_of_pos_left h hx0
      have h3 : Valued.v (ρ * y ^ 2) < Valued.v (x ^ 2) := by
        rw [hxx, Valuation.map_mul, hρ1, one_mul, Valuation.map_pow, sq]
        calc Valued.v y * Valued.v y ≤ Valued.v x * Valued.v y :=
              mul_le_mul_of_nonneg_right h.le zero_le'
          _ < Valued.v x * Valued.v x := mul_lt_mul_of_pos_left h hx0
      rw [e, Valuation.map_sub_eq_of_lt_left _ (Valuation.map_add_lt _ h1 h3),
        max_eq_left h.le, Valuation.map_pow]
    · by_cases hy : y = 0
      · subst hy
        have hx : Valued.v x = 0 := le_antisymm (by simpa using h) zero_le'
        have hx' : x = 0 := (Valuation.zero_iff _).mp hx
        subst hx'
        simp
      · have hy0 : Valued.v y ≠ 0 := by rwa [ne_eq, Valuation.zero_iff]
        have hu : Valued.v (-x / y) ≤ 1 := by
          rw [Valuation.map_div, Valuation.map_neg]
          exact div_le_one_of_le₀ h zero_le'
        have e : x ^ 2 - x * y - ρ * y ^ 2 = y ^ 2 * ((-x / y) ^ 2 + (-x / y) - ρ) := by
          field_simp
          ring
        rw [e, Valuation.map_mul, hρ (-x / y) hu, mul_one, max_eq_right h, Valuation.map_pow]
  
  rintro ⟨z, t, hzt⟩
  have e : (z + t) ^ 2 - (z + t) * (2 * t) - ρ * (2 * t) ^ 2 = ϖ := by
    rw [← hzt]; ring
  have key := hN (z + t) (2 * t)
  rw [e, hϖ] at key
  set c := max (Valued.v (z + t)) (Valued.v (2 * t)) with hc
  have hexp : (WithZero.exp (-1 : ℤ) : WithZero (Multiplicative ℤ)) = c ^ 2 := key
  by_cases hc0 : c = 0
  · rw [hc0] at hexp
    simp at hexp
  · have hcl : c = WithZero.exp (WithZero.log c) := (WithZero.exp_log hc0).symm
    rw [hcl, sq, ← WithZero.exp_add, WithZero.exp_inj] at hexp
    omega

theorem exists_norm_of_unit_artinSchreier {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : Valued.v (2 : v.adicCompletion K) ≠ 1)
    (ρ : v.adicCompletion K)
    (hρ : ∀ y : v.adicCompletion K, Valued.v y ≤ 1 → Valued.v (y ^ 2 + y - ρ) = 1)
    (c : v.adicCompletion K) (hc : Valued.v c = 1) :
    ∃ z t : v.adicCompletion K, z ^ 2 - (1 + 4 * ρ) * t ^ 2 = c :=
by
  classical
  haveI : CharZero (v.adicCompletion K) :=
    charZero_of_injective_algebraMap (algebraMap K (v.adicCompletion K)).injective
  
  have hρ1 : Valued.v ρ ≤ 1 := by
    have h := hρ 0 (by rw [map_zero]; exact zero_le')
    have e : (0 : v.adicCompletion K) ^ 2 + 0 - ρ = -ρ := by ring
    rw [e, Valuation.map_neg] at h
    exact h.le
  
  have approx : ∀ k : K, IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 →
      ∃ a : NumberField.RingOfIntegers K,
        IsDedekindDomain.HeightOneSpectrum.valuation K v
          (k - algebraMap (NumberField.RingOfIntegers K) K a) < 1 := by
    intro k hk
    obtain ⟨n, d, hd, hnd⟩ := IsFractionRing.div_surjective (A := NumberField.RingOfIntegers K) k
    have hd0 : d ≠ 0 := nonZeroDivisors.ne_zero hd
    have hιd : algebraMap (NumberField.RingOfIntegers K) K d ≠ 0 := by
      rw [ne_eq, map_eq_zero_iff _ (IsFractionRing.injective (NumberField.RingOfIntegers K) K)]
      exact hd0
    have hn : algebraMap (NumberField.RingOfIntegers K) K n =
        k * algebraMap (NumberField.RingOfIntegers K) K d := by
      rw [← hnd, div_mul_cancel₀ _ hιd]
    have hv0 : v.intValuation d ≠ 0 := v.intValuation_ne_zero d hd0
    have hv1 : v.intValuation d ≤ 1 := v.intValuation_le_one d
    have hlog : WithZero.log (v.intValuation d) ≤ 0 := by
      have h1 : WithZero.exp (WithZero.log (v.intValuation d)) ≤ WithZero.exp (0 : ℤ) := by
        rw [WithZero.exp_log hv0, WithZero.exp_zero]; exact hv1
      exact WithZero.exp_le_exp.mp h1
    obtain ⟨m, hm⟩ : ∃ m : ℕ, v.intValuation d = WithZero.exp (-(m : ℤ)) := by
      refine ⟨(-WithZero.log (v.intValuation d)).toNat, ?_⟩
      rw [Int.toNat_of_nonneg (by omega), neg_neg, WithZero.exp_log hv0]
    obtain ⟨J, hJ⟩ : v.asIdeal ^ m ∣ Ideal.span {d} :=
      (v.intValuation_le_pow_iff_dvd d m).mp hm.le
    have hJP : ¬ J ≤ v.asIdeal := by
      intro hle
      have h3 : v.asIdeal ^ (m + 1) ∣ Ideal.span {d} := by
        rw [hJ, pow_succ]
        exact mul_dvd_mul_left _ (Ideal.dvd_iff_le.mpr hle)
      have h2 := (v.intValuation_le_pow_iff_dvd d (m + 1)).mpr h3
      rw [hm, WithZero.exp_le_exp] at h2
      push_cast at h2
      omega
    obtain ⟨t, htJ, htP⟩ := Set.not_subset.mp hJP
    have hnv : v.intValuation n ≤ WithZero.exp (-(m : ℤ)) := by
      have e1 : v.intValuation n = IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K n) :=
        (v.valuation_of_algebraMap (K := K) n).symm
      have e2 : v.intValuation d = IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K d) :=
        (v.valuation_of_algebraMap (K := K) d).symm
      rw [e1, hn, map_mul, ← e2, hm]
      calc _ ≤ 1 * WithZero.exp (-(m : ℤ)) := mul_le_mul_right' hk _
        _ = _ := one_mul _
    have hnP : n ∈ v.asIdeal ^ m :=
      Ideal.dvd_span_singleton.mp ((v.intValuation_le_pow_iff_dvd n m).mp hnv)
    have hnt : n * t ∈ Ideal.span {d} := by
      rw [hJ]; exact Ideal.mul_mem_mul hnP htJ
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hnt
    have hbk : algebraMap (NumberField.RingOfIntegers K) K b =
        algebraMap (NumberField.RingOfIntegers K) K t * k := by
      have h4 := congrArg (algebraMap (NumberField.RingOfIntegers K) K) hb
      rw [map_mul, map_mul, hn] at h4
      apply mul_right_cancel₀ hιd
      rw [h4]; ring
    obtain ⟨s, i, hi, hsi⟩ := v.isMaximal.exists_inv htP
    refine ⟨s * b, ?_⟩
    have h1 : algebraMap (NumberField.RingOfIntegers K) K s *
        algebraMap (NumberField.RingOfIntegers K) K t +
        algebraMap (NumberField.RingOfIntegers K) K i = 1 := by
      rw [← map_mul, ← map_add, hsi, map_one]
    have key : algebraMap (NumberField.RingOfIntegers K) K t *
        (k - algebraMap (NumberField.RingOfIntegers K) K (s * b)) =
        algebraMap (NumberField.RingOfIntegers K) K b *
          algebraMap (NumberField.RingOfIntegers K) K i := by
      rw [map_mul]
      linear_combination (-1 : K) * hbk - algebraMap (NumberField.RingOfIntegers K) K b * h1
    have hvt : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K t) = 1 := by
      rw [v.valuation_of_algebraMap]; exact (v.intValuation_eq_one_iff).mpr htP
    have hvb : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K b) ≤ 1 := v.valuation_le_one (K := K) b
    have hvi : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K i) < 1 :=
      (v.valuation_lt_one_iff_mem (K := K) i).mpr hi
    have h5 := congrArg (IsDedekindDomain.HeightOneSpectrum.valuation K v) key
    rw [map_mul (IsDedekindDomain.HeightOneSpectrum.valuation K v), hvt, one_mul,
      map_mul (IsDedekindDomain.HeightOneSpectrum.valuation K v)] at h5
    rw [h5]
    calc _ ≤ 1 * IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K i) := mul_le_mul_right' hvb _
      _ = _ := one_mul _
      _ < 1 := hvi
  have hval : ∀ x : K, Valued.v (algebraMap K (v.adicCompletion K) x) =
      IsDedekindDomain.HeightOneSpectrum.valuation K v x := fun x =>
    IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v x
  
  have hker : ∀ x : v.adicCompletionIntegers K,
      IsLocalRing.residue _ x = 0 ↔ Valued.v (x : v.adicCompletion K) < 1 := fun x =>
    (IsLocalRing.residue_eq_zero_iff x).trans
      (Valuation.mem_maximalIdeal_iff (v.adicCompletion K) Valued.v (a := x))
  
  have hfin : Finite (IsLocalRing.ResidueField (v.adicCompletionIntegers K)) := by
    have hRK : ∀ r : NumberField.RingOfIntegers K,
        algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r =
          algebraMap K (v.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K r) :=
      fun r => IsScalarTower.algebraMap_apply _ _ _ r
    have hint : ∀ r : NumberField.RingOfIntegers K,
        algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r ∈
          v.adicCompletionIntegers K := by
      intro r
      rw [IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers, hRK, hval]
      exact v.valuation_le_one r
    let φ := (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K)).codRestrict
      (v.adicCompletionIntegers K) hint
    let ψ := (IsLocalRing.residue (v.adicCompletionIntegers K)).comp φ
    have hψ : ∀ r ∈ v.asIdeal, ψ r = 0 := by
      intro r hr
      show IsLocalRing.residue _ (φ r) = 0
      rw [hker]
      show Valued.v (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r) < 1
      rw [hRK, hval]
      exact (v.valuation_lt_one_iff_mem r).mpr hr
    let ψbar := Ideal.Quotient.lift v.asIdeal ψ hψ
    have hdense : DenseRange (algebraMap K (v.adicCompletion K)) := by
      have h := @UniformSpace.Completion.denseRange_coe
        (WithVal (IsDedekindDomain.HeightOneSpectrum.valuation K v)) _
      exact h
    have hsurj : Function.Surjective ψbar := by
      intro y
      obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective y
      have hU : {z : v.adicCompletion K | Valued.v (z - (x : v.adicCompletion K)) < 1} ∈
          nhds (x : v.adicCompletion K) :=
        Valued.mem_nhds.mpr ⟨1, fun z hz => by simpa using hz⟩
      obtain ⟨k, hk⟩ := hdense.mem_nhds hU
      simp only [Set.mem_setOf_eq] at hk
      have hk1 : IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 := by
        rw [← hval]
        have e : algebraMap K (v.adicCompletion K) k =
            (algebraMap K (v.adicCompletion K) k - x) + x := by ring
        rw [e]
        exact le_trans (Valuation.map_add _ _ _) (max_le hk.le x.2)
      obtain ⟨a, ha⟩ := approx k hk1
      refine ⟨Ideal.Quotient.mk v.asIdeal a, ?_⟩
      show ψ a = IsLocalRing.residue _ x
      show IsLocalRing.residue _ (φ a) = IsLocalRing.residue _ x
      rw [← sub_eq_zero, ← map_sub, hker]
      show Valued.v (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) a -
        (x : v.adicCompletion K)) < 1
      have e : algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) a -
          (x : v.adicCompletion K) =
          -(algebraMap K (v.adicCompletion K)
              (k - algebraMap (NumberField.RingOfIntegers K) K a)) +
            (algebraMap K (v.adicCompletion K) k - x) := by
        rw [hRK, map_sub]; ring
      rw [e]
      refine Valuation.map_add_lt _ ?_ hk
      rw [Valuation.map_neg, hval]
      exact ha
    haveI : Finite (NumberField.RingOfIntegers K ⧸ v.asIdeal) :=
      Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
    exact Finite.of_surjective ψbar hsurj
  
  have h2lt : Valued.v (2 : v.adicCompletion K) < 1 := by
    refine lt_of_le_of_ne ?_ h2
    have e : (2 : v.adicCompletion K) = 1 + 1 := by norm_num
    rw [e]
    refine le_trans (Valuation.map_add _ _ _) ?_
    rw [map_one, max_self]
  have hres2 : (2 : IsLocalRing.ResidueField (v.adicCompletionIntegers K)) = 0 := by
    have e : ((2 : v.adicCompletionIntegers K) : v.adicCompletion K) = 2 := rfl
    have h := (hker 2).mpr (by rw [e]; exact h2lt)
    rwa [map_ofNat] at h
  have hchar : ringChar (IsLocalRing.ResidueField (v.adicCompletionIntegers K)) = 2 :=
    CharP.ringChar_of_prime_eq_zero Nat.prime_two (by exact_mod_cast hres2)
  haveI := hfin
  
  have hcO : c ∈ v.adicCompletionIntegers K := by
    rw [IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers]; exact hc.le
  obtain ⟨s, hs⟩ := FiniteField.isSquare_of_char_two hchar
    (IsLocalRing.residue (v.adicCompletionIntegers K) ⟨c, hcO⟩)
  obtain ⟨y, hy⟩ := IsLocalRing.residue_surjective s
  obtain ⟨x₀, hx₀def⟩ : ∃ x₀ : v.adicCompletion K, x₀ = (y : v.adicCompletion K) := ⟨_, rfl⟩
  have hx₀c : Valued.v (x₀ ^ 2 - c) < 1 := by
    have h0 : IsLocalRing.residue (v.adicCompletionIntegers K) (y * y - ⟨c, hcO⟩) = 0 := by
      rw [map_sub, map_mul, hy, hs, sub_self]
    have e : ((y * y - ⟨c, hcO⟩ : v.adicCompletionIntegers K) : v.adicCompletion K) =
        x₀ ^ 2 - c := by
      rw [hx₀def, sq]; rfl
    have h := (hker _).mp h0
    rwa [e] at h
  have hx₀le : Valued.v x₀ ≤ 1 := by
    rw [hx₀def]
    exact y.2
  have hx₀sq : Valued.v x₀ * Valued.v x₀ = 1 := by
    have e : x₀ ^ 2 = c + (x₀ ^ 2 - c) := by ring
    have h := congrArg Valued.v e
    rw [Valuation.map_add_eq_of_lt_left _ (by rw [hc]; exact hx₀c), hc, map_pow, sq] at h
    exact h
  have hx₀1 : Valued.v x₀ = 1 := by
    refine le_antisymm hx₀le (not_lt.mp fun hlt => ?_)
    have : Valued.v x₀ * Valued.v x₀ < 1 :=
      lt_of_le_of_lt (le_trans (mul_le_mul_left' hx₀le _) (le_of_eq (mul_one _))) hlt
    rw [hx₀sq] at this
    exact lt_irrefl _ this
  have hx₀0 : x₀ ≠ 0 := by
    intro h; rw [h, map_zero] at hx₀1; exact zero_ne_one hx₀1
  have hx₀inv : Valued.v x₀⁻¹ = 1 := by rw [map_inv₀, hx₀1, inv_one]
  
  have G3 : ∀ y : WithZero (Multiplicative ℤ), y < 1 → y ≤ WithZero.exp (-1 : ℤ) := by
    intro y hy
    by_cases hy0 : y = 0
    · rw [hy0]; exact zero_le'
    · rw [← WithZero.exp_log hy0] at hy ⊢
      rw [← WithZero.exp_zero, WithZero.exp_lt_exp] at hy
      rw [WithZero.exp_le_exp]; omega
  have G1 : ∀ N k : ℕ, N ≤ k →
      WithZero.exp (-((k : ℤ) + 1)) ≤ WithZero.exp (-((N : ℤ) + 1)) := by
    intro N k h; rw [WithZero.exp_le_exp]; omega
  have G2 : ∀ γ : (WithZero (Multiplicative ℤ))ˣ, ∃ N : ℕ,
      WithZero.exp (-((N : ℤ) + 1)) < (γ : WithZero (Multiplicative ℤ)) := by
    intro γ
    have hγ0 : (γ : WithZero (Multiplicative ℤ)) ≠ 0 := Units.ne_zero γ
    refine ⟨(-WithZero.log (γ : WithZero (Multiplicative ℤ))).toNat, ?_⟩
    conv_rhs => rw [← WithZero.exp_log hγ0]
    rw [WithZero.exp_lt_exp]
    have := Int.self_le_toNat (-WithZero.log (γ : WithZero (Multiplicative ℤ)))
    omega
  have hr1 : WithZero.exp (-1 : ℤ) ≤ (1 : WithZero (Multiplicative ℤ)) := by
    rw [← WithZero.exp_zero, WithZero.exp_le_exp]; norm_num
  
  obtain ⟨E, hEdef⟩ : ∃ E : v.adicCompletion K, E = c - x₀ ^ 2 := ⟨_, rfl⟩
  have hE : Valued.v E ≤ WithZero.exp (-1 : ℤ) := by
    apply G3
    rw [hEdef, Valuation.map_sub_swap]
    exact hx₀c
  obtain ⟨t, ht0, hts⟩ : ∃ t : ℕ → v.adicCompletion K, t 0 = 0 ∧
      ∀ k, t (k + 1) = x₀⁻¹ * (E + ρ * t k ^ 2) :=
    ⟨fun n => Nat.rec (0 : v.adicCompletion K) (fun _ a => x₀⁻¹ * (E + ρ * a ^ 2)) n,
      rfl, fun _ => rfl⟩
  have hbd : ∀ k, Valued.v (t k) ≤ WithZero.exp (-1 : ℤ) := by
    intro k
    induction k with
    | zero => rw [ht0, map_zero]; exact zero_le'
    | succ k ih =>
      rw [hts, map_mul, hx₀inv, one_mul]
      refine Valuation.map_add_le _ hE ?_
      rw [map_mul, map_pow, sq]
      calc Valued.v ρ * (Valued.v (t k) * Valued.v (t k))
          ≤ 1 * (WithZero.exp (-1 : ℤ) * 1) :=
            mul_le_mul' hρ1 (mul_le_mul' ih (le_trans ih hr1))
        _ = WithZero.exp (-1 : ℤ) := by rw [mul_one, one_mul]
  have hinc : ∀ k : ℕ, Valued.v (t (k + 1) - t k) ≤ WithZero.exp (-((k : ℤ) + 1)) := by
    intro k
    induction k with
    | zero =>
      rw [hts, ht0]
      have e : x₀⁻¹ * (E + ρ * (0 : v.adicCompletion K) ^ 2) - 0 = x₀⁻¹ * E := by ring
      rw [e, map_mul, hx₀inv, one_mul]
      simpa using hE
    | succ k ih =>
      have e : t (k + 1 + 1) - t (k + 1) =
          x₀⁻¹ * ρ * (t (k + 1) - t k) * (t (k + 1) + t k) := by
        have h1 := hts (k + 1)
        have h2 := hts k
        linear_combination h1 - h2
      rw [e, map_mul, map_mul, map_mul, hx₀inv, one_mul]
      have hsum : Valued.v (t (k + 1) + t k) ≤ WithZero.exp (-1 : ℤ) :=
        Valuation.map_add_le _ (hbd (k + 1)) (hbd k)
      calc Valued.v ρ * Valued.v (t (k + 1) - t k) * Valued.v (t (k + 1) + t k)
          ≤ 1 * WithZero.exp (-((k : ℤ) + 1)) * WithZero.exp (-1 : ℤ) :=
            mul_le_mul' (mul_le_mul' hρ1 ih) hsum
        _ = WithZero.exp (-(((k + 1 : ℕ) : ℤ) + 1)) := by
          rw [one_mul, ← WithZero.exp_add] <;> congr 1 <;> push_cast <;> ring
  have T1 : ∀ N n : ℕ, N ≤ n → Valued.v (t n - t N) ≤ WithZero.exp (-((N : ℤ) + 1)) := by
    intro N n hn
    induction n, hn using Nat.le_induction with
    | base => rw [sub_self, map_zero]; exact zero_le'
    | succ n hn ih =>
      have e : t (n + 1) - t N = (t (n + 1) - t n) + (t n - t N) := by ring
      rw [e]
      exact Valuation.map_add_le _ (le_trans (hinc n) (G1 N n hn)) ih
  have hcauchy : CauchySeq t := by
    refine (Valued.cauchy_iff).2 ⟨Filter.map_neBot, fun γ => ?_⟩
    obtain ⟨N, hN⟩ := G2 γ
    refine ⟨t '' Set.Ici N, Filter.image_mem_map (Filter.Ici_mem_atTop N), ?_⟩
    rintro _ ⟨m, hm, rfl⟩ _ ⟨n, hn, rfl⟩
    have e : t n - t m = (t n - t N) - (t m - t N) := by ring
    rw [e]
    exact lt_of_le_of_lt (Valuation.map_sub_le _ (T1 N n hn) (T1 N m hm)) hN
  obtain ⟨L, hL⟩ := cauchySeq_tendsto_of_complete hcauchy
  have hL1 : Filter.Tendsto (fun k => t (k + 1)) Filter.atTop (nhds L) :=
    hL.comp (Filter.tendsto_add_atTop_nat 1)
  have hL2 : Filter.Tendsto (fun k => t (k + 1)) Filter.atTop
      (nhds (x₀⁻¹ * (E + ρ * L ^ 2))) := by
    have h := (((hL.pow 2).const_mul ρ).const_add E).const_mul x₀⁻¹
    refine h.congr (fun k => ?_)
    exact (hts k).symm
  have hfix : L = x₀⁻¹ * (E + ρ * L ^ 2) := tendsto_nhds_unique hL1 hL2
  have hinv : x₀ * x₀⁻¹ = 1 := mul_inv_cancel₀ hx₀0
  refine ⟨x₀ + L / 2, L / 2, ?_⟩
  rw [hEdef] at hfix
  linear_combination x₀ * hfix + (c - x₀ ^ 2 + ρ * L ^ 2) * hinv

theorem exists_sq_approx_of_two_not_unit {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : Valued.v (2 : v.adicCompletion K) ≠ 1)
    (z : v.adicCompletion K) (hz : Valued.v z ≤ 1) :
    ∃ s : v.adicCompletion K, Valued.v s ≤ 1 ∧ Valued.v (s ^ 2 - z) < 1 :=
by
  
  have approx : ∀ k : K, IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 →
      ∃ a : NumberField.RingOfIntegers K,
        IsDedekindDomain.HeightOneSpectrum.valuation K v
          (k - algebraMap (NumberField.RingOfIntegers K) K a) < 1 := by
    intro k hk
    obtain ⟨n, d, hd, hnd⟩ := IsFractionRing.div_surjective (A := NumberField.RingOfIntegers K) k
    have hd0 : d ≠ 0 := nonZeroDivisors.ne_zero hd
    have hιd : algebraMap (NumberField.RingOfIntegers K) K d ≠ 0 := by
      rw [ne_eq, map_eq_zero_iff _ (IsFractionRing.injective (NumberField.RingOfIntegers K) K)]
      exact hd0
    have hn : algebraMap (NumberField.RingOfIntegers K) K n =
        k * algebraMap (NumberField.RingOfIntegers K) K d := by
      rw [← hnd, div_mul_cancel₀ _ hιd]
    have hv0 : v.intValuation d ≠ 0 := v.intValuation_ne_zero d hd0
    have hv1 : v.intValuation d ≤ 1 := v.intValuation_le_one d
    have hlog : WithZero.log (v.intValuation d) ≤ 0 := by
      have h1 : WithZero.exp (WithZero.log (v.intValuation d)) ≤ WithZero.exp (0 : ℤ) := by
        rw [WithZero.exp_log hv0, WithZero.exp_zero]; exact hv1
      exact WithZero.exp_le_exp.mp h1
    obtain ⟨m, hm⟩ : ∃ m : ℕ, v.intValuation d = WithZero.exp (-(m : ℤ)) := by
      refine ⟨(-WithZero.log (v.intValuation d)).toNat, ?_⟩
      rw [Int.toNat_of_nonneg (by omega), neg_neg, WithZero.exp_log hv0]
    obtain ⟨J, hJ⟩ : v.asIdeal ^ m ∣ Ideal.span {d} :=
      (v.intValuation_le_pow_iff_dvd d m).mp hm.le
    have hJP : ¬ J ≤ v.asIdeal := by
      intro hle
      have h3 : v.asIdeal ^ (m + 1) ∣ Ideal.span {d} := by
        rw [hJ, pow_succ]
        exact mul_dvd_mul_left _ (Ideal.dvd_iff_le.mpr hle)
      have h2 := (v.intValuation_le_pow_iff_dvd d (m + 1)).mpr h3
      rw [hm, WithZero.exp_le_exp] at h2
      push_cast at h2
      omega
    obtain ⟨t, htJ, htP⟩ := Set.not_subset.mp hJP
    have hnv : v.intValuation n ≤ WithZero.exp (-(m : ℤ)) := by
      have e1 : v.intValuation n = IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K n) :=
        (v.valuation_of_algebraMap (K := K) n).symm
      have e2 : v.intValuation d = IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K d) :=
        (v.valuation_of_algebraMap (K := K) d).symm
      rw [e1, hn, map_mul, ← e2, hm]
      calc _ ≤ 1 * WithZero.exp (-(m : ℤ)) := mul_le_mul_right' hk _
        _ = _ := one_mul _
    have hnP : n ∈ v.asIdeal ^ m :=
      Ideal.dvd_span_singleton.mp ((v.intValuation_le_pow_iff_dvd n m).mp hnv)
    have hnt : n * t ∈ Ideal.span {d} := by
      rw [hJ]; exact Ideal.mul_mem_mul hnP htJ
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hnt
    have hbk : algebraMap (NumberField.RingOfIntegers K) K b =
        algebraMap (NumberField.RingOfIntegers K) K t * k := by
      have h4 := congrArg (algebraMap (NumberField.RingOfIntegers K) K) hb
      rw [map_mul, map_mul, hn] at h4
      apply mul_right_cancel₀ hιd
      rw [h4]; ring
    obtain ⟨s, i, hi, hsi⟩ := v.isMaximal.exists_inv htP
    refine ⟨s * b, ?_⟩
    have h1 : algebraMap (NumberField.RingOfIntegers K) K s *
        algebraMap (NumberField.RingOfIntegers K) K t +
        algebraMap (NumberField.RingOfIntegers K) K i = 1 := by
      rw [← map_mul, ← map_add, hsi, map_one]
    have key : algebraMap (NumberField.RingOfIntegers K) K t *
        (k - algebraMap (NumberField.RingOfIntegers K) K (s * b)) =
        algebraMap (NumberField.RingOfIntegers K) K b *
          algebraMap (NumberField.RingOfIntegers K) K i := by
      rw [map_mul]
      linear_combination (-1 : K) * hbk - algebraMap (NumberField.RingOfIntegers K) K b * h1
    have hvt : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K t) = 1 := by
      rw [v.valuation_of_algebraMap]; exact (v.intValuation_eq_one_iff).mpr htP
    have hvb : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K b) ≤ 1 := v.valuation_le_one (K := K) b
    have hvi : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K i) < 1 :=
      (v.valuation_lt_one_iff_mem (K := K) i).mpr hi
    have h5 := congrArg (IsDedekindDomain.HeightOneSpectrum.valuation K v) key
    rw [map_mul (IsDedekindDomain.HeightOneSpectrum.valuation K v), hvt, one_mul,
      map_mul (IsDedekindDomain.HeightOneSpectrum.valuation K v)] at h5
    rw [h5]
    calc _ ≤ 1 * IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K i) := mul_le_mul_right' hvb _
      _ = _ := one_mul _
      _ < 1 := hvi
  have hval : ∀ x : K, Valued.v (algebraMap K (v.adicCompletion K) x) =
      IsDedekindDomain.HeightOneSpectrum.valuation K v x := fun x =>
    IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v x
  
  have hker : ∀ x : v.adicCompletionIntegers K,
      IsLocalRing.residue _ x = 0 ↔ Valued.v (x : v.adicCompletion K) < 1 := fun x =>
    (IsLocalRing.residue_eq_zero_iff x).trans
      (Valuation.mem_maximalIdeal_iff (v.adicCompletion K) Valued.v (a := x))
  
  have hfin : Finite (IsLocalRing.ResidueField (v.adicCompletionIntegers K)) := by
    have hRK : ∀ r : NumberField.RingOfIntegers K,
        algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r =
          algebraMap K (v.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K r) :=
      fun r => IsScalarTower.algebraMap_apply _ _ _ r
    have hint : ∀ r : NumberField.RingOfIntegers K,
        algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r ∈
          v.adicCompletionIntegers K := by
      intro r
      rw [IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers, hRK, hval]
      exact v.valuation_le_one r
    let φ := (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K)).codRestrict
      (v.adicCompletionIntegers K) hint
    let ψ := (IsLocalRing.residue (v.adicCompletionIntegers K)).comp φ
    have hψ : ∀ r ∈ v.asIdeal, ψ r = 0 := by
      intro r hr
      show IsLocalRing.residue _ (φ r) = 0
      rw [hker]
      show Valued.v (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r) < 1
      rw [hRK, hval]
      exact (v.valuation_lt_one_iff_mem r).mpr hr
    let ψbar := Ideal.Quotient.lift v.asIdeal ψ hψ
    have hdense : DenseRange (algebraMap K (v.adicCompletion K)) := by
      have h := @UniformSpace.Completion.denseRange_coe
        (WithVal (IsDedekindDomain.HeightOneSpectrum.valuation K v)) _
      exact h
    have hsurj : Function.Surjective ψbar := by
      intro y
      obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective y
      have hU : {z : v.adicCompletion K | Valued.v (z - (x : v.adicCompletion K)) < 1} ∈
          nhds (x : v.adicCompletion K) :=
        Valued.mem_nhds.mpr ⟨1, fun z hz => by simpa using hz⟩
      obtain ⟨k, hk⟩ := hdense.mem_nhds hU
      simp only [Set.mem_setOf_eq] at hk
      have hk1 : IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 := by
        rw [← hval]
        have e : algebraMap K (v.adicCompletion K) k =
            (algebraMap K (v.adicCompletion K) k - x) + x := by ring
        rw [e]
        exact le_trans (Valuation.map_add _ _ _) (max_le hk.le x.2)
      obtain ⟨a, ha⟩ := approx k hk1
      refine ⟨Ideal.Quotient.mk v.asIdeal a, ?_⟩
      show ψ a = IsLocalRing.residue _ x
      show IsLocalRing.residue _ (φ a) = IsLocalRing.residue _ x
      rw [← sub_eq_zero, ← map_sub, hker]
      show Valued.v (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) a -
        (x : v.adicCompletion K)) < 1
      have e : algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) a -
          (x : v.adicCompletion K) =
          -(algebraMap K (v.adicCompletion K)
              (k - algebraMap (NumberField.RingOfIntegers K) K a)) +
            (algebraMap K (v.adicCompletion K) k - x) := by
        rw [hRK, map_sub]; ring
      rw [e]
      refine Valuation.map_add_lt _ ?_ hk
      rw [Valuation.map_neg, hval]
      exact ha
    haveI : Finite (NumberField.RingOfIntegers K ⧸ v.asIdeal) :=
      Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
    exact Finite.of_surjective ψbar hsurj
  
  have h2lt : Valued.v (2 : v.adicCompletion K) < 1 := by
    refine lt_of_le_of_ne ?_ h2
    rw [← one_add_one_eq_two]
    exact le_trans (Valuation.map_add _ _ _) (by rw [map_one, max_self])
  
  have h2k : (2 : IsLocalRing.ResidueField (v.adicCompletionIntegers K)) = 0 := by
    rw [← map_ofNat (IsLocalRing.residue (v.adicCompletionIntegers K)) 2, hker]
    exact h2lt
  
  have hsqinj : Function.Injective
      (fun t : IsLocalRing.ResidueField (v.adicCompletionIntegers K) => t ^ 2) := by
    intro t u htu
    simp only at htu
    have h0 : (t - u) ^ 2 = 0 := by
      linear_combination htu + (u ^ 2 - t * u) * h2k
    exact sub_eq_zero.mp ((pow_eq_zero_iff two_ne_zero).mp h0)
  have hsqsurj := Finite.injective_iff_surjective.mp hsqinj
  have hzO : z ∈ v.adicCompletionIntegers K :=
    (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers _ _ v).mpr hz
  set z' : v.adicCompletionIntegers K := ⟨z, hzO⟩ with hz'
  obtain ⟨σ, hσ⟩ := hsqsurj (IsLocalRing.residue _ z')
  obtain ⟨s', rfl⟩ := IsLocalRing.residue_surjective σ
  refine ⟨(s' : v.adicCompletion K), s'.2, ?_⟩
  have he : ((s' ^ 2 - z' : v.adicCompletionIntegers K) : v.adicCompletion K) =
      (s' : v.adicCompletion K) ^ 2 - z := rfl
  rw [← he, ← hker, map_sub, map_pow]
  exact sub_eq_zero.mpr hσ

theorem adicCompletion_exists_sq_add_self_eq_of_valued_lt_one {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (ζ : v.adicCompletion K) (hζ : Valued.v ζ < 1) :
    ∃ W : v.adicCompletion K, W ^ 2 + W = ζ :=
by
  have G3 : ∀ y : WithZero (Multiplicative ℤ), y < 1 → y ≤ WithZero.exp (-1 : ℤ) := by
    intro y hy
    by_cases hy0 : y = 0
    · rw [hy0]; exact zero_le'
    · rw [← WithZero.exp_log hy0] at hy ⊢
      rw [← WithZero.exp_zero, WithZero.exp_lt_exp] at hy
      rw [WithZero.exp_le_exp]; omega
  have G1 : ∀ N k : ℕ, N ≤ k →
      WithZero.exp (-((k : ℤ) + 1)) ≤ WithZero.exp (-((N : ℤ) + 1)) := by
    intro N k h; rw [WithZero.exp_le_exp]; omega
  have G2 : ∀ γ : (WithZero (Multiplicative ℤ))ˣ, ∃ N : ℕ,
      WithZero.exp (-((N : ℤ) + 1)) < (γ : WithZero (Multiplicative ℤ)) := by
    intro γ
    have hγ0 : (γ : WithZero (Multiplicative ℤ)) ≠ 0 := Units.ne_zero γ
    refine ⟨(-WithZero.log (γ : WithZero (Multiplicative ℤ))).toNat, ?_⟩
    conv_rhs => rw [← WithZero.exp_log hγ0]
    rw [WithZero.exp_lt_exp]
    have := Int.self_le_toNat (-WithZero.log (γ : WithZero (Multiplicative ℤ)))
    omega
  have Ge1 : WithZero.exp (-1 : ℤ) ≤ 1 := by
    rw [← WithZero.exp_zero, WithZero.exp_le_exp]; norm_num
  have hζe : Valued.v ζ ≤ WithZero.exp (-1 : ℤ) := G3 _ hζ
  obtain ⟨W, hW0, hWs⟩ : ∃ W : ℕ → v.adicCompletion K, W 0 = 0 ∧
      ∀ k, W (k + 1) = ζ - W k ^ 2 :=
    ⟨fun n => Nat.rec (0 : v.adicCompletion K) (fun _ a => ζ - a ^ 2) n, rfl, fun _ => rfl⟩
  have P : ∀ k : ℕ, Valued.v (W k) ≤ WithZero.exp (-1 : ℤ) := by
    intro k
    induction k with
    | zero => rw [hW0, map_zero]; exact zero_le'
    | succ k ih =>
      rw [hWs]
      have hsq : Valued.v (W k ^ 2) ≤ WithZero.exp (-1 : ℤ) := by
        rw [map_pow, sq]
        calc Valued.v (W k) * Valued.v (W k) ≤ WithZero.exp (-1 : ℤ) * 1 := mul_le_mul' ih
              (le_trans ih Ge1)
          _ = WithZero.exp (-1 : ℤ) := mul_one _
      exact Valuation.map_sub_le _ hζe hsq
  have hinc : ∀ k : ℕ, Valued.v (W (k + 1) - W k) ≤ WithZero.exp (-((k : ℤ) + 1)) := by
    intro k
    induction k with
    | zero =>
      have e : W (0 + 1) - W 0 = ζ := by rw [hWs, hW0]; ring
      rw [e]
      have e2 : WithZero.exp (-(((0 : ℕ) : ℤ) + 1)) = WithZero.exp (-1 : ℤ) := by norm_num
      rw [e2]; exact hζe
    | succ k ih =>
      have e1 : W (k + 1 + 1) = ζ - W (k + 1) ^ 2 := hWs (k + 1)
      have e2 : W (k + 1) = ζ - W k ^ 2 := hWs k
      have e : W (k + 1 + 1) - W (k + 1) = -((W (k + 1) - W k) * (W (k + 1) + W k)) := by
        linear_combination e1 - e2
      rw [e, Valuation.map_neg, map_mul]
      calc Valued.v (W (k + 1) - W k) * Valued.v (W (k + 1) + W k)
          ≤ WithZero.exp (-((k : ℤ) + 1)) * WithZero.exp (-1 : ℤ) :=
            mul_le_mul' ih (Valuation.map_add_le _ (P (k + 1)) (P k))
        _ = WithZero.exp (-(((k + 1 : ℕ) : ℤ) + 1)) := by
            rw [← WithZero.exp_add] <;> congr 1 <;> push_cast <;> ring
  have T1 : ∀ N n : ℕ, N ≤ n → Valued.v (W n - W N) ≤ WithZero.exp (-((N : ℤ) + 1)) := by
    intro N n hn
    induction n, hn using Nat.le_induction with
    | base => rw [sub_self, map_zero]; exact zero_le'
    | succ n hn ih =>
      have e : W (n + 1) - W N = (W (n + 1) - W n) + (W n - W N) := by ring
      rw [e]
      exact Valuation.map_add_le _ (le_trans (hinc n) (G1 N n hn)) ih
  have hcauchy : CauchySeq W := by
    refine (Valued.cauchy_iff).2 ⟨Filter.map_neBot, fun γ => ?_⟩
    obtain ⟨N, hN⟩ := G2 γ
    refine ⟨W '' Set.Ici N, Filter.image_mem_map (Filter.Ici_mem_atTop N), ?_⟩
    rintro _ ⟨m, hm, rfl⟩ _ ⟨n, hn, rfl⟩
    have e : W n - W m = (W n - W N) - (W m - W N) := by ring
    rw [e]
    exact lt_of_le_of_lt (Valuation.map_sub_le _ (T1 N n hn) (T1 N m hm)) hN
  obtain ⟨L, hL⟩ := cauchySeq_tendsto_of_complete hcauchy
  have h0 : Filter.Tendsto (fun k => W k ^ 2 + W k - ζ) Filter.atTop (nhds 0) := by
    rw [Filter.tendsto_def]
    intro s hs
    obtain ⟨γ, hγ⟩ := Valued.mem_nhds_zero.mp hs
    obtain ⟨N, hN⟩ := G2 γ
    rw [Filter.mem_atTop_sets]
    refine ⟨N, fun k hk => hγ ?_⟩
    have e : W k ^ 2 + W k - ζ = -(W (k + 1) - W k) := by rw [hWs]; ring
    show Valued.v (W k ^ 2 + W k - ζ) < (γ : WithZero (Multiplicative ℤ))
    rw [e, Valuation.map_neg]
    exact lt_of_le_of_lt (le_trans (hinc k) (G1 N k hk)) hN
  have hL' : Filter.Tendsto (fun k => W k ^ 2 + W k - ζ) Filter.atTop
      (nhds (L ^ 2 + L - ζ)) :=
    ((hL.pow 2).add hL).sub_const ζ
  have hLz : L ^ 2 + L - ζ = 0 := tendsto_nhds_unique hL' h0
  exact ⟨L, by linear_combination hLz⟩

theorem exists_artinSchreier_sol_or_shift {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : Valued.v (2 : v.adicCompletion K) ≠ 1)
    (ρ : v.adicCompletion K)
    (hρ : ∀ y : v.adicCompletion K, Valued.v y ≤ 1 → Valued.v (y ^ 2 + y - ρ) = 1)
    (β : v.adicCompletion K) (hβ : Valued.v β ≤ 1) :
    ∃ τ : v.adicCompletion K, Valued.v τ ≤ 1 ∧
      (Valued.v (τ ^ 2 + τ - β) < 1 ∨ Valued.v (τ ^ 2 + τ - β + ρ) < 1) :=
by
  
  have approx : ∀ k : K, IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 →
      ∃ a : NumberField.RingOfIntegers K,
