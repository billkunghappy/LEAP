  obtain ⟨e, heL, he⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hLne
  have he' : (⟨e, heL⟩ : L) ≠ 0 := by
    intro h; apply he; exact congrArg Subtype.val h
  have hspan := (finrank_eq_one_iff_of_nonzero' (⟨e, heL⟩ : L) he').mp hL1
  have hsc : ∀ g, ∃ t : EllipticRootNumber.Ω F, ρ g e = t • e := by
    intro g
    obtain ⟨t, ht⟩ := hspan ⟨ρ g e, hLst g e heL⟩
    refine ⟨t, ?_⟩
    have := congrArg Subtype.val ht
    simpa using this.symm
  have hinj : ∀ s t : EllipticRootNumber.Ω F, s • e = t • e → s = t :=
    fun s t h => smul_left_injective _ he h
  have hinv : ∀ (g : EllipticRootNumber.relWeil F ⊥) (a a' : EllipticRootNumber.Ω F),
      ρ g e = a • e → ρ g⁻¹ e = a' • e → a * a' = 1 := by
    intro g a a' ha ha'
    apply hinj
    calc (a * a') • e = a' • (a • e) := by rw [smul_smul, mul_comm]
      _ = a' • ρ g e := by rw [ha]
      _ = ρ g (a' • e) := (map_smul _ _ _).symm
      _ = ρ g (ρ g⁻¹ e) := by rw [ha']
      _ = ρ (g * g⁻¹) e := by rw [map_mul, Module.End.mul_apply]
      _ = (1 : EllipticRootNumber.Ω F) • e := by
        rw [mul_inv_cancel, map_one, Module.End.one_apply, one_smul]
  obtain ⟨a1, ha1⟩ := hsc w
  obtain ⟨a2, ha2⟩ := hsc w'
  obtain ⟨a3, ha3⟩ := hsc w⁻¹
  obtain ⟨a4, ha4⟩ := hsc w'⁻¹
  have h13 := hinv w a1 a3 ha1 ha3
  have h24 := hinv w' a2 a4 ha2 ha4
  have hTe : ρ c e = e := by
    have : ρ c e = (a4 * a3 * a2 * a1) • e := by
      simp only [hc, map_mul, Module.End.mul_apply, ha4, map_smul, ha3, ha2, ha1, smul_smul]
      congr 1
      ring
    rw [this]
    have h1 : a4 * a3 * a2 * a1 = 1 := by linear_combination (a2 * a4) * h13 + h24
    rw [h1, one_smul]
  
  have hdet : LinearMap.det (ρ c) = 1 := by
    have h1 : LinearMap.det (ρ w) * LinearMap.det (ρ w⁻¹) = 1 := by
      rw [← map_mul, ← map_mul, mul_inv_cancel, map_one, map_one]
    have h2 : LinearMap.det (ρ w') * LinearMap.det (ρ w'⁻¹) = 1 := by
      rw [← map_mul, ← map_mul, mul_inv_cancel, map_one, map_one]
    have : LinearMap.det (ρ c) = LinearMap.det (ρ w) * LinearMap.det (ρ w') *
        LinearMap.det (ρ w⁻¹) * LinearMap.det (ρ w'⁻¹) := by
      simp only [hc, map_mul]
    rw [this]
    linear_combination (LinearMap.det (ρ w') * LinearMap.det (ρ w'⁻¹)) * h1 + h2
  
  have hc1 : ρ c = 1 := by
    set T := ρ c with hT
    obtain ⟨f, hli⟩ := exists_linearIndependent_pair_of_one_lt_finrank
      (by omega : 1 < Module.finrank (EllipticRootNumber.Ω F) V) he
    let b := basisOfLinearIndependentOfCardEqFinrank hli (by simp [hdim])
    have hb0 : b 0 = e := by simp [b]
    have hb1 : b 1 = f := by simp [b]
    set x := b.repr (T f) 0 with hx
    set y := b.repr (T f) 1 with hy
    have hTf : T f = x • e + y • f := by
      have := b.sum_repr (T f)
      rw [Fin.sum_univ_two, hb0, hb1] at this
      exact this.symm
    have hy1 : y = 1 := by
      rw [← hdet, ← LinearMap.det_toMatrix b, Matrix.det_fin_two]
      simp only [LinearMap.toMatrix_apply, hb0, hb1, hTe]
      rw [← hb0, b.repr_self]
      simp [hy]
    rw [hy1, one_smul] at hTf
    have hTe_pow : ∀ n : ℕ, (T ^ n) e = e := by
      intro n
      induction n with
      | zero => simp
      | succ n ih => rw [pow_succ, Module.End.mul_apply, hTe, ih]
    have hTf_pow : ∀ n : ℕ, (T ^ n) f = ((n : EllipticRootNumber.Ω F) * x) • e + f := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        rw [pow_succ, Module.End.mul_apply, hTf, map_add, map_smul, hTe_pow, ih]
        simp only [Nat.cast_succ, add_mul, one_mul, add_smul]
        abel
    have hx0 : x = 0 := by
      have h := hTf_pow m
      rw [hTm, Module.End.one_apply] at h
      have h' : ((m : EllipticRootNumber.Ω F) * x) • e = 0 := by
        have := congrArg (fun v => v - f) h
        simpa using this.symm
      rcases smul_eq_zero.mp h' with h'' | h''
      · rcases mul_eq_zero.mp h'' with h3 | h3
        · exact absurd h3 (Nat.cast_ne_zero.mpr hm.ne')
        · exact h3
      · exact absurd h'' he
    rw [hx0, zero_smul, zero_add] at hTf
    apply b.ext
    intro i
    fin_cases i
    · simp [hb0, hTe]
    · simp [hb1, hTf]
  
  calc ρ w * ρ w' = ρ (w * w') := (map_mul ρ w w').symm
    _ = ρ (c * (w' * w)) := by rw [hc]; congr 1; group
    _ = ρ c * (ρ w' * ρ w) := by rw [map_mul ρ c (w' * w), map_mul ρ w' w]
    _ = ρ w' * ρ w := by rw [hc1, one_mul]

theorem weilRep_abTriv_of_comm (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : EllipticRootNumber.LocalReciprocity F)
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    {V : Type u} [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
    (σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F L) V)
    (hσ : EllipticRootNumber.IsWeilRep F L σ)
    (hcomm : ∀ w w' : EllipticRootNumber.relWeil F L, σ w * σ w' = σ w' * σ w) :
    ∃ (N : IntermediateField F (AlgebraicClosure F)) (_ : FiniteDimensional F N) (hLN : L ≤ N),
      EllipticRootNumber.IsAbelianExt F hLN ∧
      ∀ g : EllipticRootNumber.relWeil F L, (g : EllipticRootNumber.AbsGal F) ∈ N.fixingSubgroup →
        (g : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → σ g = 1 :=
by
  
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : EllipticRootNumber.AbsGal F, EllipticRootNumber.ActsAsFrobPow F Φ 1 := by
    obtain ⟨-, hmul, x₀, hx1⟩ := relVal_bot_spec F
    have hx : x₀ ≠ 0 := by
      rintro rfl
      have h0 : EllipticRootNumber.relVal F ⊥
          (0 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
        unfold EllipticRootNumber.relVal
        rw [Algebra.norm_zero]
        unfold EllipticRootNumber.addVal
        simp
      rw [h0] at hx1
      exact zero_ne_one hx1
    have hinv : EllipticRootNumber.relVal F ⊥ x₀⁻¹ = -1 := by
      have h := hmul x₀ x₀⁻¹ hx (inv_ne_zero hx)
      rw [mul_inv_cancel₀ hx, hx1] at h
      have h1 := hmul 1 1 one_ne_zero one_ne_zero
      rw [mul_one] at h1
      omega
    have hd := rec.degree_rec ⊥ (Units.mk0 x₀ hx)⁻¹
    have hval : (((Units.mk0 x₀ hx)⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) = x₀⁻¹ := by
      rw [Units.val_inv_eq_inv_val, Units.val_mk0]
    rw [hval, hinv, neg_neg] at hd
    obtain ⟨hspec1, hspec2⟩ := weilDegreeHom_spec_of_localField F
    obtain ⟨n, hn⟩ := hspec1 _ (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥)
      (rec.recMap ⊥ (Units.mk0 x₀ hx)⁻¹)).2
    have hn' := hspec2 _ n hn
    rw [hd] at hn'
    have hn1 : (1 : ℤ) = n := Multiplicative.ofAdd.injective hn'
    subst hn1
    exact ⟨_, hn⟩
  
  have hdense : ∀ N : IntermediateField F (AlgebraicClosure F), FiniteDimensional F N →
      Normal F N → ∀ τ : EllipticRootNumber.AbsGal F,
        ∃ w ∈ EllipticRootNumber.weilGroup F, ∀ x ∈ N, w x = τ x := by
    intro N hN hNn τ
    haveI := hN
    haveI := hNn
    exact weilGroup_restrict_surj F Φ hΦ N τ
  
  obtain ⟨-, U, hU, hUσ⟩ := hσ
  
  have hHH : ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆ ≤
      EllipticRootNumber.relWeil F L := by
    rw [Subgroup.commutator_le]
    intro g₁ h₁ g₂ h₂
    rw [commutatorElement_def]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ h₁ h₂)
      (Subgroup.inv_mem _ h₁)) (Subgroup.inv_mem _ h₂)
  have hHI : ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆ ≤
      EllipticRootNumber.inertia F := by
    rw [Subgroup.commutator_le]
    intro g₁ h₁ g₂ h₂
    have hdeg : EllipticRootNumber.weilDegreeHom F
        ⁅(⟨g₁, EllipticRootNumber.relWeil_le_weilGroup F L h₁⟩ : EllipticRootNumber.weilGroup F),
          (⟨g₂, EllipticRootNumber.relWeil_le_weilGroup F L h₂⟩ :
            EllipticRootNumber.weilGroup F)⁆ = 1 := by
      rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
      exact mul_comm _ _
    exact weilDegreeHom_ker_le_inertia F _ hdeg
  
  have hσab : ∀ a b : EllipticRootNumber.relWeil F L, σ ⁅a, b⁆ = 1 := by
    intro a b
    rw [commutatorElement_def, map_mul, map_mul, map_mul, hcomm a b, mul_assoc (σ b) (σ a),
      ← map_mul σ a, mul_inv_cancel, map_one, mul_one, ← map_mul, mul_inv_cancel, map_one]
  have hσcomm : ∀ c ∈ ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆,
      ∀ hc : c ∈ EllipticRootNumber.relWeil F L, σ ⟨c, hc⟩ = 1 := by
    have hle : ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆ ≤
        σ.ker.map (EllipticRootNumber.relWeil F L).subtype := by
      rw [Subgroup.commutator_le]
      intro g₁ h₁ g₂ h₂
      refine Subgroup.mem_map.mpr ⟨⁅(⟨g₁, h₁⟩ : EllipticRootNumber.relWeil F L), ⟨g₂, h₂⟩⁆, ?_, rfl⟩
      rw [MonoidHom.mem_ker]
      exact hσab _ _
    intro c hc hcH
    obtain ⟨k, hk, hkc⟩ := Subgroup.mem_map.mp (hle hc)
    have hk' : k = ⟨c, hcH⟩ := Subtype.ext hkc
    rw [← hk']
    exact hk
  
  obtain ⟨M, h, hMfin, hab, hcov⟩ := exists_abelianExt_commutator_cover F hdense L U hU
  refine ⟨M, hMfin, h, hab, ?_⟩
  
  intro g hgM hgI
  obtain ⟨c, hc, hcU⟩ := hcov _ g.2 hgM
  have hcH : c ∈ EllipticRootNumber.relWeil F L := hHH hc
  have hcI : c ∈ EllipticRootNumber.inertia F := hHI hc
  have hσc : σ ⟨c, hcH⟩ = 1 := hσcomm c hc hcH
  have hn : σ ((⟨c, hcH⟩ : EllipticRootNumber.relWeil F L)⁻¹ * g) = 1 :=
    hUσ _ hcU ((EllipticRootNumber.inertia F).mul_mem
      ((EllipticRootNumber.inertia F).inv_mem hcI) hgI)
  calc σ g
      = σ ((⟨c, hcH⟩ : EllipticRootNumber.relWeil F L) *
          ((⟨c, hcH⟩ : EllipticRootNumber.relWeil F L)⁻¹ * g)) := by
        rw [mul_inv_cancel_left]
    _ = 1 := by rw [map_mul, hσc, hn, one_mul]

theorem finrank_intertwining_additive {k : Type} [Field k] [CharZero k]
    {G : Type u} [Group G] (K0 : Subgroup G) [K0.Normal] [K0.FiniteIndex] (ω : G →* kˣ)
    {T : Type u} [AddCommGroup T] [Module k T] [FiniteDimensional k T] (σT : Representation k G T)
    {X₁ X X₂ : Type u} [AddCommGroup X₁] [Module k X₁] [AddCommGroup X] [Module k X]
    [AddCommGroup X₂] [Module k X₂] [FiniteDimensional k X₁] [FiniteDimensional k X]
    [FiniteDimensional k X₂]
    (τ₁ : Representation k G X₁) (τ : Representation k G X) (τ₂ : Representation k G X₂)
    (h₁ : ∀ g ∈ K0, τ₁ g = (ω g : k) • LinearMap.id) (h : ∀ g ∈ K0, τ g = (ω g : k) • LinearMap.id)
    (h₂ : ∀ g ∈ K0, τ₂ g = (ω g : k) • LinearMap.id)
    (f : X₁ →ₗ[k] X) (q : X →ₗ[k] X₂) (hf : ∀ g, f ∘ₗ τ₁ g = τ g ∘ₗ f)
    (hq : ∀ g, q ∘ₗ τ g = τ₂ g ∘ₗ q) (hinj : Function.Injective f) (hsurj : Function.Surjective q)
    (hex : LinearMap.range f = LinearMap.ker q) :
    Module.finrank k (σT.IntertwiningMap τ) =
      Module.finrank k (σT.IntertwiningMap τ₁) + Module.finrank k (σT.IntertwiningMap τ₂) :=
by
  classical
  
  have hinv : ∀ {W : Type u} [AddCommGroup W] [Module k W] (ρ : Representation k G W) (g : G) (w : W),
      ρ g (ρ g⁻¹ w) = w := by
    intro W _ _ ρ g w
    rw [← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one, Module.End.one_apply]
  have hinv' : ∀ {W : Type u} [AddCommGroup W] [Module k W] (ρ : Representation k G W) (g : G) (w : W),
      ρ g⁻¹ (ρ g w) = w := by
    intro W _ _ ρ g w
    rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one, Module.End.one_apply]
  
  
  
  obtain ⟨s₀, hs₀⟩ :=
    LinearMap.exists_rightInverse_of_surjective q (LinearMap.range_eq_top.mpr hsurj)
  have hs₀x : ∀ y, q (s₀ y) = y := fun y => LinearMap.congr_fun hs₀ y
  have hqx : ∀ g x, q (τ g x) = τ₂ g (q x) := fun g x => LinearMap.congr_fun (hq g) x
  have hfx : ∀ g x₁, f (τ₁ g x₁) = τ g (f x₁) := fun g x₁ => LinearMap.congr_fun (hf g) x₁
  let B : G → (X₂ →ₗ[k] X) := fun g => τ g ∘ₗ s₀ ∘ₗ τ₂ g⁻¹
  have hBapp : ∀ g y, B g y = τ g (s₀ (τ₂ g⁻¹ y)) := fun g y => rfl
  
  have hB : ∀ g, ∀ κ ∈ K0, B (g * κ) = B g := by
    intro g κ hκ
    have hκ' : κ⁻¹ ∈ K0 := K0.inv_mem hκ
    have hω : (ω κ⁻¹ : k) * (ω κ : k) = 1 := by
      rw [← Units.val_mul, ← map_mul, inv_mul_cancel, map_one, Units.val_one]
    apply LinearMap.ext
    intro y
    rw [hBapp, hBapp, mul_inv_rev, map_mul, map_mul, Module.End.mul_apply, Module.End.mul_apply,
      h κ hκ, h₂ κ⁻¹ hκ']
    simp only [LinearMap.smul_apply, LinearMap.id_apply, map_smul, smul_smul, hω, one_smul]
  haveI : Fintype (G ⧸ K0) := Subgroup.fintypeQuotientOfFiniteIndex
  let A : G ⧸ K0 → (X₂ →ₗ[k] X) := fun c => B (Quotient.out c)
  have hA : ∀ g : G, A (g : G ⧸ K0) = B g := by
    intro g
    obtain ⟨κ, hκ⟩ := QuotientGroup.mk_out_eq_mul K0 g
    show B (Quotient.out (g : G ⧸ K0)) = B g
    rw [hκ]
    exact hB g κ κ.2
  set m : ℕ := Fintype.card (G ⧸ K0) with hm_def
  have hm : (m : k) ≠ 0 := by
    rw [Nat.cast_ne_zero]
    exact Fintype.card_ne_zero
  let s : X₂ →ₗ[k] X := (m : k)⁻¹ • ∑ c, A c
  have hsapp : ∀ y, s y = (m : k)⁻¹ • ∑ c, A c y := by
    intro y
    simp only [s, LinearMap.smul_apply, LinearMap.sum_apply]
  have hqB : ∀ g y, q (B g y) = y := by
    intro g y
    rw [hBapp, hqx, hs₀x, hinv]
  have hqs : ∀ y, q (s y) = y := by
    intro y
    rw [hsapp, map_smul, map_sum]
    simp only [A, hqB, Finset.sum_const, Finset.card_univ, ← hm_def]
    rw [← Nat.cast_smul_eq_nsmul k, smul_smul, inv_mul_cancel₀ hm, one_smul]
  have hτB : ∀ x g y, τ x (B g y) = B (x * g) (τ₂ x y) := by
    intro x g y
    rw [hBapp, hBapp]
    simp only [mul_inv_rev, map_mul, Module.End.mul_apply, hinv']
  
  have hsG : ∀ x y, s (τ₂ x y) = τ x (s y) := by
    intro x y
    rw [hsapp, hsapp, map_smul, map_sum]
    congr 1
    symm
    refine Fintype.sum_equiv (MulAction.toPerm x) _ _ (fun c => ?_)
    rw [MulAction.toPerm_apply]
    have e1 : x • c = ((x * Quotient.out c : G) : G ⧸ K0) := by
      show x • c = ((x • Quotient.out c : G) : G ⧸ K0)
      rw [← MulAction.Quotient.smul_mk, QuotientGroup.out_eq']
    rw [e1, hA]
    exact hτB x _ y
  
  
  
  have hqf : ∀ x₁, q (f x₁) = 0 := by
    intro x₁
    have hmem : f x₁ ∈ LinearMap.ker q := hex ▸ LinearMap.mem_range_self f x₁
    exact hmem
  obtain ⟨l, hl⟩ := LinearMap.exists_leftInverse_of_injective f (LinearMap.ker_eq_bot.mpr hinj)
  have hlx : ∀ x₁, l (f x₁) = x₁ := fun x₁ => LinearMap.congr_fun hl x₁
  let r : X →ₗ[k] X₁ := l ∘ₗ (LinearMap.id - s ∘ₗ q)
  have hrapp : ∀ x, r x = l (x - s (q x)) := fun x => rfl
  have hfr : ∀ x, f (r x) = x - s (q x) := by
    intro x
    have hmem : x - s (q x) ∈ LinearMap.range f := by
      rw [hex, LinearMap.mem_ker, map_sub, hqs, sub_self]
    obtain ⟨u, hu⟩ := hmem
    rw [hrapp, ← hu, hlx]
  have hrf : ∀ x₁, r (f x₁) = x₁ := by
    intro x₁
    rw [hrapp, hqf, map_zero, sub_zero, hlx]
  have hrs : ∀ y, r (s y) = 0 := by
    intro y
    rw [hrapp, hqs, sub_self, map_zero]
  have hrG : ∀ g x, r (τ g x) = τ₁ g (r x) := by
    intro g x
    apply hinj
    rw [hfr, hfx, hfr, map_sub, hqx, hsG]
  
  
  
  let E : σT.IntertwiningMap τ ≃ₗ[k] (σT.IntertwiningMap τ₁ × σT.IntertwiningMap τ₂) :=
  { toFun := fun φ =>
      (⟨r ∘ₗ φ.toLinearMap, fun g v => by
          show r (φ (σT g v)) = τ₁ g (r (φ v))
          rw [φ.isIntertwining, hrG]⟩,
       ⟨q ∘ₗ φ.toLinearMap, fun g v => by
          show q (φ (σT g v)) = τ₂ g (q (φ v))
          rw [φ.isIntertwining, hqx]⟩)
    invFun := fun p =>
      ⟨f ∘ₗ p.1.toLinearMap + s ∘ₗ p.2.toLinearMap, fun g v => by
          show f (p.1 (σT g v)) + s (p.2 (σT g v)) = τ g (f (p.1 v) + s (p.2 v))
          rw [p.1.isIntertwining, p.2.isIntertwining, hfx, hsG, map_add]⟩
    map_add' := fun φ ψ => by
      refine Prod.ext (Representation.IntertwiningMap.ext ?_)
        (Representation.IntertwiningMap.ext ?_)
      · funext v
        change r ((φ + ψ) v) = r (φ v) + r (ψ v)
        rw [Representation.IntertwiningMap.coe_add, Pi.add_apply, map_add]
      · funext v
        change q ((φ + ψ) v) = q (φ v) + q (ψ v)
        rw [Representation.IntertwiningMap.coe_add, Pi.add_apply, map_add]
    map_smul' := fun a φ => by
      refine Prod.ext (Representation.IntertwiningMap.ext ?_)
        (Representation.IntertwiningMap.ext ?_)
      · funext v
        change r ((a • φ) v) = a • r (φ v)
        rw [Representation.IntertwiningMap.coe_smul, Pi.smul_apply, map_smul]
      · funext v
        change q ((a • φ) v) = a • q (φ v)
        rw [Representation.IntertwiningMap.coe_smul, Pi.smul_apply, map_smul]
    left_inv := fun φ => by
      apply Representation.IntertwiningMap.ext
      funext v
      change f (r (φ v)) + s (q (φ v)) = φ v
      rw [hfr, sub_add_cancel]
    right_inv := fun p => by
      refine Prod.ext (Representation.IntertwiningMap.ext ?_)
        (Representation.IntertwiningMap.ext ?_)
      · funext v
        change r (f (p.1 v) + s (p.2 v)) = p.1 v
        rw [map_add, hrf, hrs, add_zero]
      · funext v
        change q (f (p.1 v) + s (p.2 v)) = p.2 v
        rw [map_add, hqf, hqs, zero_add] }
  
  
  
  have hFF : ∀ {W : Type u} [AddCommGroup W] [Module k W] [FiniteDimensional k W]
      (ρ : Representation k G W),
      Module.Free k (σT.IntertwiningMap ρ) ∧ Module.Finite k (σT.IntertwiningMap ρ) := by
    intro W _ _ _ ρ
    constructor
    · letI : AddCommGroup (σT.IntertwiningMap ρ) := Module.addCommMonoidToAddCommGroup k
      exact Module.Free.of_divisionRing k _
    · let i : σT.IntertwiningMap ρ →ₗ[k] (T →ₗ[k] W) :=
        { toFun := fun φ => φ.toLinearMap
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      refine Module.Finite.of_injective i (fun φ ψ hφψ => ?_)
      apply Representation.IntertwiningMap.ext
      exact congrArg (fun L : T →ₗ[k] W => L.toFun) hφψ
  obtain ⟨fr1, fn1⟩ := hFF τ₁
  obtain ⟨fr2, fn2⟩ := hFF τ₂
  rw [E.finrank_eq, Module.finrank_prod]

theorem finrank_intertwining_pi {k : Type} [Field k] {G : Type u} [Group G]
    {T : Type u} [AddCommGroup T] [Module k T] [FiniteDimensional k T] (σT : Representation k G T)
    {n : ℕ} {A : Fin n → Type u} [∀ i, AddCommGroup (A i)] [∀ i, Module k (A i)]
    [∀ i, FiniteDimensional k (A i)]
    (α : ∀ i, Representation k G (A i)) (τ : Representation k G (∀ i, A i))
    (hτ : ∀ g, τ g = LinearMap.pi fun i => α i g ∘ₗ LinearMap.proj i) :
    Module.finrank k (σT.IntertwiningMap τ) = ∑ i, Module.finrank k (σT.IntertwiningMap (α i)) :=
by
  classical
  have key : ∀ (g : G) (x : ∀ i, A i) (i : Fin n), τ g x i = α i g (x i) := by
    intro g x i
    rw [hτ g]
    rfl
  let S : ∀ i, Submodule k (T →ₗ[k] A i) := fun i =>
    { carrier := {f | ∀ g : G, f ∘ₗ σT g = α i g ∘ₗ f}
      zero_mem' := fun g => by simp
      add_mem' := fun {f f'} hf hf' g => by
        simp only [Set.mem_setOf_eq] at hf hf' ⊢
        rw [LinearMap.add_comp, LinearMap.comp_add, hf g, hf' g]
      smul_mem' := fun c f hf g => by
        simp only [Set.mem_setOf_eq] at hf ⊢
        rw [LinearMap.smul_comp, LinearMap.comp_smul, hf g] }
  have hS : ∀ i (f : T →ₗ[k] A i), f ∈ S i ↔ ∀ g, f ∘ₗ σT g = α i g ∘ₗ f := fun i f => Iff.rfl
  let e : ∀ i, σT.IntertwiningMap (α i) ≃ₗ[k] S i := fun i =>
    { toFun := fun φ => ⟨φ.toLinearMap, (hS i _).2 fun g => LinearMap.ext fun v =>
          Representation.IntertwiningMap.isIntertwining σT (α i) φ g v⟩
      map_add' := fun φ ψ => rfl
      map_smul' := fun c φ => rfl
      invFun := fun s => ⟨s.1, fun g v => LinearMap.congr_fun (((hS i _).1 s.2) g) v⟩
      left_inv := fun φ => rfl
      right_inv := fun s => rfl }
  let E : σT.IntertwiningMap τ ≃ₗ[k] (∀ i, S i) :=
    { toFun := fun F i => ⟨LinearMap.proj i ∘ₗ F.toLinearMap, (hS i _).2 fun g =>
          LinearMap.ext fun v => by
            show F.toLinearMap (σT g v) i = α i g (F.toLinearMap v i)
            rw [← key]
            exact congrFun (Representation.IntertwiningMap.isIntertwining σT τ F g v) i⟩
      map_add' := fun F F' => rfl
      map_smul' := fun c F => rfl
      invFun := fun s => ⟨LinearMap.pi fun i => (s i).1, fun g v => by
          funext i
          show (s i).1 (σT g v) = τ g (LinearMap.pi (fun i => (s i).1) v) i
          rw [key]
          exact LinearMap.congr_fun (((hS i _).1 (s i).2) g) v⟩
      left_inv := fun F => rfl
      right_inv := fun s => rfl }
  haveI : ∀ i, Module.Free k (S i) := fun i => inferInstance
  haveI : ∀ i, Module.Finite k (S i) := fun i => inferInstance
  rw [E.finrank_eq, Module.finrank_pi_fintype k]
  exact Finset.sum_congr rfl fun i _ => ((e i).finrank_eq).symm

theorem linearEquiv_of_finrank_intertwining_eq {k : Type} [Field k] [CharZero k]
    {G : Type u} [Group G] (K0 : Subgroup G) [K0.Normal] [K0.FiniteIndex] (ω : G →* kˣ)
    {X Y : Type u} [AddCommGroup X] [Module k X] [AddCommGroup Y] [Module k Y]
    [FiniteDimensional k X] [FiniteDimensional k Y]
    (τX : Representation k G X) (τY : Representation k G Y)
    (hX : ∀ g ∈ K0, τX g = (ω g : k) • LinearMap.id) (hY : ∀ g ∈ K0, τY g = (ω g : k) • LinearMap.id)
    (hdimEq : ∀ {T : Type u} [AddCommGroup T] [Module k T] [FiniteDimensional k T]
      (σT : Representation k G T), (∀ g ∈ K0, σT g = (ω g : k) • LinearMap.id) →
      Module.finrank k (σT.IntertwiningMap τX) = Module.finrank k (σT.IntertwiningMap τY)) :
    ∃ e : X ≃ₗ[k] Y, ∀ g : G, e.toLinearMap ∘ₗ τX g = τY g ∘ₗ e.toLinearMap :=
by
  classical
  
  have hext : ∀ {V W : Type u} [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]
      {ρ : Representation k G V} {σ : Representation k G W} (f f' : ρ.IntertwiningMap σ),
      (∀ v, f v = f' v) → f = f' := by
    intro V W _ _ _ _ ρ σ f f' h
    exact Representation.IntertwiningMap.ext (funext h)
  
  have homEquiv : ∀ {V W : Type u} [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]
      (ρ : Representation k G V) (σ : Representation k G W),
      ∃ M : Submodule k (V →ₗ[k] W), Nonempty (ρ.IntertwiningMap σ ≃ₗ[k] M) := by
    intro V W _ _ _ _ ρ σ
    let Φ : ρ.IntertwiningMap σ →ₗ[k] (V →ₗ[k] W) :=
      { toFun := fun f => f.toLinearMap
        map_add' := fun f f' => LinearMap.ext fun v => rfl
        map_smul' := fun c f => LinearMap.ext fun v => rfl }
    have hΦ : Function.Injective Φ := by
      intro a b hab
      exact Representation.IntertwiningMap.toLinearMap_injective ρ σ hab
    exact ⟨LinearMap.range Φ, ⟨LinearEquiv.ofInjective Φ hΦ⟩⟩
  have homFree : ∀ {V W : Type u} [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]
      [FiniteDimensional k V] [FiniteDimensional k W]
      (ρ : Representation k G V) (σ : Representation k G W),
      Module.Free k (ρ.IntertwiningMap σ) ∧ Module.Finite k (ρ.IntertwiningMap σ) := by
    intro V W _ _ _ _ _ _ ρ σ
    obtain ⟨M, ⟨e⟩⟩ := homEquiv ρ σ
    exact ⟨Module.Free.of_equiv e.symm, Module.Finite.equiv e.symm⟩
  have homPos : ∀ {V W : Type u} [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]
      [FiniteDimensional k V] [FiniteDimensional k W]
      (ρ : Representation k G V) (σ : Representation k G W) (f : ρ.IntertwiningMap σ),
      f ≠ 0 → 0 < Module.finrank k (ρ.IntertwiningMap σ) := by
    intro V W _ _ _ _ _ _ ρ σ f hf
    obtain ⟨M, ⟨e⟩⟩ := homEquiv ρ σ
    rw [e.finrank_eq]
    haveI : Nontrivial M := ⟨⟨e f, 0, (LinearEquiv.map_ne_zero_iff e).mpr hf⟩⟩
    exact Module.finrank_pos
  have homNz : ∀ {V W : Type u} [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]
      (ρ : Representation k G V) (σ : Representation k G W),
      0 < Module.finrank k (ρ.IntertwiningMap σ) → ∃ f : ρ.IntertwiningMap σ, f ≠ 0 := by
    intro V W _ _ _ _ ρ σ h
    haveI := Module.nontrivial_of_finrank_pos h
    exact exists_ne 0
  
  have restrict : ∀ {Z : Type u} [AddCommGroup Z] [Module k Z] (τ : Representation k G Z)
      (W : Submodule k Z), (∀ g, ∀ x ∈ W, τ g x ∈ W) →
      ∃ σ : Representation k G W, ∀ g (w : W), ((σ g w : W) : Z) = τ g w := by
    intro Z _ _ τ W hW
    refine ⟨{ toFun := fun g => (τ g).restrict (hW g), map_one' := ?_, map_mul' := ?_ },
      fun g w => rfl⟩
    · apply LinearMap.ext; intro w; apply Subtype.ext
      show τ 1 w = w
      rw [map_one]; rfl
    · intro g h; apply LinearMap.ext; intro w; apply Subtype.ext
      show τ (g * h) w = τ g (τ h w)
      rw [map_mul]; rfl
  have scalarRestrict : ∀ {Z : Type u} [AddCommGroup Z] [Module k Z] (τ : Representation k G Z)
      (W : Submodule k Z) (σ : Representation k G W), (∀ g (w : W), ((σ g w : W) : Z) = τ g w) →
      (∀ g ∈ K0, τ g = (ω g : k) • LinearMap.id) → ∀ g ∈ K0, σ g = (ω g : k) • LinearMap.id := by
    intro Z _ _ τ W σ hσ hτ g hg
    apply LinearMap.ext; intro w; apply Subtype.ext
    rw [hσ, hτ g hg]
    rfl
  
  have projComm : ∀ {Z : Type u} [AddCommGroup Z] [Module k Z] (τ : Representation k G Z)
      (A B : Submodule k Z) (h : IsCompl A B), (∀ g, ∀ x ∈ A, τ g x ∈ A) →
      (∀ g, ∀ x ∈ B, τ g x ∈ B) →
      ∀ g x, ((A.linearProjOfIsCompl B h (τ g x) : A) : Z) = τ g (A.linearProjOfIsCompl B h x) := by
    intro Z _ _ τ A B h hA hB g x
    have hx : x ∈ A ⊔ B := by rw [h.sup_eq_top]; exact Submodule.mem_top
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hx
    have e1 : A.linearProjOfIsCompl B h a = ⟨a, ha⟩ :=
      Submodule.linearProjOfIsCompl_apply_left h ⟨a, ha⟩
    have e2 : A.linearProjOfIsCompl B h b = 0 :=
      Submodule.linearProjOfIsCompl_apply_right h ⟨b, hb⟩
    have e3 : A.linearProjOfIsCompl B h (τ g a) = ⟨τ g a, hA g a ha⟩ :=
      Submodule.linearProjOfIsCompl_apply_left h ⟨τ g a, hA g a ha⟩
    have e4 : A.linearProjOfIsCompl B h (τ g b) = 0 :=
      Submodule.linearProjOfIsCompl_apply_right h ⟨τ g b, hB g b hb⟩
    rw [map_add, map_add, map_add, e1, e2, e3, e4]
    simp
  
  have maschke : ∀ {Z : Type u} [AddCommGroup Z] [Module k Z] (τ : Representation k G Z),
      (∀ g ∈ K0, τ g = (ω g : k) • LinearMap.id) → ∀ W : Submodule k Z,
      (∀ g, ∀ x ∈ W, τ g x ∈ W) →
      ∃ W' : Submodule k Z, IsCompl W W' ∧ ∀ g, ∀ x ∈ W', τ g x ∈ W' := by
    intro Z _ _ τ hτ W hW
    haveI : Finite (G ⧸ K0) := Subgroup.finite_quotient_of_finiteIndex
    letI : Fintype (G ⧸ K0) := Fintype.ofFinite _
    obtain ⟨C, hC⟩ := Submodule.exists_isCompl W
    let π₀ : Z →ₗ[k] Z := W.subtype ∘ₗ W.linearProjOfIsCompl C hC
    have hπW : ∀ x, π₀ x ∈ W := fun x => (W.linearProjOfIsCompl C hC x).2
    have hπid : ∀ w ∈ W, π₀ w = w := by
      intro w hw
      have e : W.linearProjOfIsCompl C hC w = ⟨w, hw⟩ :=
        Submodule.linearProjOfIsCompl_apply_left hC ⟨w, hw⟩
      show ((W.linearProjOfIsCompl C hC w : W) : Z) = w
      rw [e]
    let c : G → (Z →ₗ[k] Z) := fun g => τ g ∘ₗ π₀ ∘ₗ τ g⁻¹
    have hc_apply : ∀ g x, c g x = τ g (π₀ (τ g⁻¹ x)) := fun g x => rfl
    have hωinv : ∀ κ : G, (ω κ : k) * (ω κ⁻¹ : k) = 1 := by
      intro κ
      rw [← Units.val_mul, ← map_mul, mul_inv_cancel, map_one, Units.val_one]
    have hc_coset : ∀ g, ∀ κ ∈ K0, c (g * κ) = c g := by
      intro g κ hκ
      apply LinearMap.ext; intro x
      rw [hc_apply, hc_apply]
      have hωinv' : (ω κ⁻¹ : k) * (ω κ : k) = 1 := by rw [mul_comm]; exact hωinv κ
      simp only [mul_inv_rev, map_mul, Module.End.mul_apply, hτ κ hκ, hτ κ⁻¹ (K0.inv_mem hκ),
        LinearMap.smul_apply, LinearMap.id_apply, map_smul, smul_smul, hωinv', one_smul]
    have hc_out : ∀ g : G, c (Quotient.out (g : G ⧸ K0)) = c g := by
      intro g
      obtain ⟨κ, hκ⟩ := QuotientGroup.mk_out_eq_mul K0 g
      rw [hκ]
      exact hc_coset g κ κ.2
    have hc_trans : ∀ h g x, τ h (c g x) = c (h * g) (τ h x) := by
      intro h g x
      rw [hc_apply, hc_apply]
      simp only [mul_inv_rev, map_mul, Module.End.mul_apply, Representation.inv_self_apply]
    have hN : ((Fintype.card (G ⧸ K0) : ℕ) : k) ≠ 0 := Nat.cast_ne_zero.mpr Fintype.card_ne_zero
    let P : Z →ₗ[k] Z := ((Fintype.card (G ⧸ K0) : ℕ) : k)⁻¹ • ∑ q : G ⧸ K0, c q.out
    have hP_apply : ∀ x, P x = ((Fintype.card (G ⧸ K0) : ℕ) : k)⁻¹ • ∑ q : G ⧸ K0, c q.out x := by
      intro x
      show (((Fintype.card (G ⧸ K0) : ℕ) : k)⁻¹ • ∑ q : G ⧸ K0, c q.out) x = _
      rw [LinearMap.smul_apply, LinearMap.sum_apply]
    have hPW : ∀ x, P x ∈ W := by
      intro x
      rw [hP_apply]
      refine W.smul_mem _ (W.sum_mem fun q _ => ?_)
      rw [hc_apply]
      exact hW _ _ (hπW _)
    have hPid : ∀ w ∈ W, P w = w := by
      intro w hw
      rw [hP_apply]
      have hq : ∀ q : G ⧸ K0, c q.out w = w := by
        intro q
        rw [hc_apply, hπid _ (hW _ w hw), Representation.self_inv_apply]
      simp only [hq, Finset.sum_const, Finset.card_univ]
      rw [← Nat.cast_smul_eq_nsmul k, smul_smul, inv_mul_cancel₀ hN, one_smul]
    have hPeq : ∀ h x, P (τ h x) = τ h (P x) := by
      intro h x
      rw [hP_apply, hP_apply, map_smul, map_sum]
      congr 1
      have e1 : ∀ q : G ⧸ K0, τ h (c q.out x) = c (h • q).out (τ h x) := by
        intro q
        rw [hc_trans]
        have hq : (h • q : G ⧸ K0) = ((h * q.out : G) : G ⧸ K0) := by
          rw [← smul_eq_mul, ← MulAction.Quotient.smul_mk, QuotientGroup.out_eq']
        rw [hq, hc_out]
      simp only [e1]
      exact (Fintype.sum_equiv (MulAction.toPerm h) _ _ (fun q => rfl)).symm
    refine ⟨LinearMap.ker P, ?_, ?_⟩
    · have hproj : ∀ w : W, (LinearMap.codRestrict W P hPW) (w : Z) = w := fun w =>
        Subtype.ext (hPid w w.2)
      have := LinearMap.isCompl_of_proj hproj
      rwa [LinearMap.ker_codRestrict] at this
    · intro g x hx
      rw [LinearMap.mem_ker] at hx ⊢
      rw [hPeq, hx, map_zero]
  
  have glue : ∀ {Z A : Type u} [AddCommGroup Z] [Module k Z] [AddCommGroup A] [Module k A]
      (τ : Representation k G Z) (σA : Representation k G A) (j : A →ₗ[k] Z)
      (hj : Function.Injective j), (∀ g a, j (σA g a) = τ g (j a)) →
      ∀ (B : Submodule k Z) (h : IsCompl (LinearMap.range j) B), (∀ g, ∀ x ∈ B, τ g x ∈ B) →
      ∀ (σB : Representation k G B), (∀ g (b : B), ((σB g b : B) : Z) = τ g b) →
      ∃ e : Z ≃ₗ[k] (A × B), ∀ g z, e (τ g z) = (σA g (e z).1, σB g (e z).2) := by
    intro Z A _ _ _ _ τ σA j hj hjint B h hB σB hσB
    have hR : ∀ g, ∀ x ∈ LinearMap.range j, τ g x ∈ LinearMap.range j := by
      rintro g _ ⟨a, rfl⟩
      exact ⟨σA g a, hjint g a⟩
    have hJ : ∀ r : LinearMap.range j, j ((LinearEquiv.ofInjective j hj).symm r) = r := by
      intro r
      rw [← LinearEquiv.ofInjective_apply j (h := hj), LinearEquiv.apply_symm_apply]
    refine ⟨(Submodule.prodEquivOfIsCompl _ B h).symm.trans
      ((LinearEquiv.ofInjective j hj).symm.prodCongr (LinearEquiv.refl k B)), fun g z => ?_⟩
    simp only [LinearEquiv.trans_apply, Submodule.prodEquivOfIsCompl_symm_apply,
      LinearEquiv.prodCongr_apply, LinearEquiv.refl_apply]
    refine Prod.ext ?_ ?_
    · apply (LinearEquiv.ofInjective j hj).injective
      rw [LinearEquiv.apply_symm_apply]
      apply Subtype.ext
      rw [LinearEquiv.ofInjective_apply, hjint, hJ, projComm τ _ B h hR hB g z]
    · apply Subtype.ext
      rw [hσB]
      exact projComm τ B _ h.symm hB hR g z
  
  have split : ∀ {T Z A B : Type u} [AddCommGroup T] [Module k T] [AddCommGroup Z] [Module k Z]
      [AddCommGroup A] [Module k A] [AddCommGroup B] [Module k B]
      [FiniteDimensional k T] [FiniteDimensional k A] [FiniteDimensional k B]
      (σT : Representation k G T) (τ : Representation k G Z) (σA : Representation k G A)
      (σB : Representation k G B) (e : Z ≃ₗ[k] (A × B)),
      (∀ g z, e (τ g z) = (σA g (e z).1, σB g (e z).2)) →
      Module.finrank k (σT.IntertwiningMap τ) =
        Module.finrank k (σT.IntertwiningMap σA) + Module.finrank k (σT.IntertwiningMap σB) := by
    intro T Z A B _ _ _ _ _ _ _ _ _ _ _ σT τ σA σB e he
    have heinv : ∀ g a b, e.symm (σA g a, σB g b) = τ g (e.symm (a, b)) := by
      intro g a b
      apply e.injective
      simp only [he, LinearEquiv.apply_symm_apply]
    let E : σT.IntertwiningMap τ ≃ₗ[k] (σT.IntertwiningMap σA × σT.IntertwiningMap σB) :=
      { toFun := fun f => (⟨LinearMap.fst k A B ∘ₗ e.toLinearMap ∘ₗ f.toLinearMap, fun g v => by
            show (e (f (σT g v))).1 = σA g (e (f v)).1
            rw [Representation.IntertwiningMap.isIntertwining σT τ f g v, he]⟩,
          ⟨LinearMap.snd k A B ∘ₗ e.toLinearMap ∘ₗ f.toLinearMap, fun g v => by
            show (e (f (σT g v))).2 = σB g (e (f v)).2
            rw [Representation.IntertwiningMap.isIntertwining σT τ f g v, he]⟩)
        map_add' := fun f f' => by
          refine Prod.ext (hext _ _ fun v => ?_) (hext _ _ fun v => ?_)
          · show (e (f v + f' v)).1 = (e (f v)).1 + (e (f' v)).1
            rw [map_add, Prod.fst_add]
          · show (e (f v + f' v)).2 = (e (f v)).2 + (e (f' v)).2
            rw [map_add, Prod.snd_add]
        map_smul' := fun c f => by
          refine Prod.ext (hext _ _ fun v => ?_) (hext _ _ fun v => ?_)
          · show (e (c • f v)).1 = c • (e (f v)).1
            rw [map_smul, Prod.smul_fst]
          · show (e (c • f v)).2 = c • (e (f v)).2
            rw [map_smul, Prod.smul_snd]
        invFun := fun p => ⟨e.symm.toLinearMap ∘ₗ (p.1.toLinearMap.prod p.2.toLinearMap),
          fun g v => by
            show e.symm (p.1 (σT g v), p.2 (σT g v)) = τ g (e.symm (p.1 v, p.2 v))
            rw [Representation.IntertwiningMap.isIntertwining σT σA p.1 g v,
              Representation.IntertwiningMap.isIntertwining σT σB p.2 g v, heinv]⟩
        left_inv := fun f => hext _ _ fun v => by
          show e.symm ((e (f v)).1, (e (f v)).2) = f v
          rw [Prod.mk.eta, LinearEquiv.symm_apply_apply]
        right_inv := fun p => by
          refine Prod.ext (hext _ _ fun v => ?_) (hext _ _ fun v => ?_)
          · show (e (e.symm (p.1 v, p.2 v))).1 = p.1 v
            rw [LinearEquiv.apply_symm_apply]
          · show (e (e.symm (p.1 v, p.2 v))).2 = p.2 v
            rw [LinearEquiv.apply_symm_apply] }
    obtain ⟨h1, h2⟩ := homFree σT σA
    obtain ⟨h3, h4⟩ := homFree σT σB
    rw [E.finrank_eq, Module.finrank_prod]
  
  suffices key : ∀ n : ℕ, ∀ {X Y : Type u} [AddCommGroup X] [Module k X] [AddCommGroup Y]
      [Module k Y] [FiniteDimensional k X] [FiniteDimensional k Y]
      (τX : Representation k G X) (τY : Representation k G Y),
      (∀ g ∈ K0, τX g = (ω g : k) • LinearMap.id) → (∀ g ∈ K0, τY g = (ω g : k) • LinearMap.id) →
      (∀ {T : Type u} [AddCommGroup T] [Module k T] [FiniteDimensional k T]
        (σT : Representation k G T), (∀ g ∈ K0, σT g = (ω g : k) • LinearMap.id) →
        Module.finrank k (σT.IntertwiningMap τX) = Module.finrank k (σT.IntertwiningMap τY)) →
      Module.finrank k X = n →
      ∃ e : X ≃ₗ[k] Y, ∀ g : G, e.toLinearMap ∘ₗ τX g = τY g ∘ₗ e.toLinearMap by
    exact key _ τX τY hX hY hdimEq rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro X Y _ _ _ _ _ _ τX τY hX hY hdimEq hn
  rcases Nat.eq_zero_or_pos n with hn0 | hnpos
  · 
    subst hn0
    haveI : Subsingleton X := Module.finrank_zero_iff.mp hn
    have hY0 : Module.finrank k Y = 0 := by
      by_contra hne
      haveI : Nontrivial Y := Module.nontrivial_of_finrank_pos (Nat.pos_of_ne_zero hne)
      obtain ⟨y, hy⟩ := exists_ne (0 : Y)
      have h1 := hdimEq τY hY
      have h2 : Module.finrank k (τY.IntertwiningMap τX) = 0 := by
        haveI : Subsingleton (τY.IntertwiningMap τX) :=
          ⟨fun a b => hext a b fun v => Subsingleton.elim _ _⟩
        exact Module.finrank_zero_of_subsingleton
      have h3 : 0 < Module.finrank k (τY.IntertwiningMap τY) := by
        refine homPos τY τY (Representation.IntertwiningMap.id τY) fun h => hy ?_
        have := congrArg (fun f : τY.IntertwiningMap τY => f y) h
        exact this
      omega
    haveI : Subsingleton Y := Module.finrank_zero_iff.mp hY0
    exact ⟨LinearEquiv.ofFinrankEq X Y (hn.trans hY0.symm),
      fun g => LinearMap.ext fun x => Subsingleton.elim _ _⟩
  · 
    obtain ⟨S, hS0, hSst, hSd⟩ : ∃ S : Submodule k X, S ≠ ⊥ ∧ (∀ g, ∀ x ∈ S, τX g x ∈ S) ∧
        ∀ W : Submodule k X, W ≠ ⊥ → (∀ g, ∀ x ∈ W, τX g x ∈ W) →
          Module.finrank k S ≤ Module.finrank k W := by
      have hPn : ∃ d, ∃ W : Submodule k X, W ≠ ⊥ ∧ (∀ g, ∀ x ∈ W, τX g x ∈ W) ∧
          Module.finrank k W = d := by
        refine ⟨n, ⊤, fun h => ?_, fun g x _ => Submodule.mem_top, by rw [finrank_top, hn]⟩
        have := finrank_top k X
        rw [h, finrank_bot] at this
        omega
      obtain ⟨S, hS0, hSst, hSd⟩ := Nat.find_spec hPn
      refine ⟨S, hS0, hSst, fun W hW0 hWst => ?_⟩
      rw [hSd]
      exact Nat.find_min' hPn ⟨W, hW0, hWst, rfl⟩
    obtain ⟨σS, hσS⟩ := restrict τX S hSst
    have hσSs := scalarRestrict τX S σS hσS hX
    have hSpos : 0 < Module.finrank k S := by
      rcases Nat.eq_zero_or_pos (Module.finrank k S) with h | h
      · exact absurd (Submodule.finrank_eq_zero.mp h) hS0
      · exact h
    
    let ι : σS.IntertwiningMap τX := ⟨S.subtype, fun g s => hσS g s⟩
    have hι : ι ≠ 0 := by
      intro h
      obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hS0
      have := congrArg (fun f : σS.IntertwiningMap τX => f ⟨x, hx⟩) h
      exact hx0 this
    have hposX := homPos σS τX ι hι
    rw [hdimEq σS hσSs] at hposX
    obtain ⟨φ, hφ⟩ := homNz σS τY hposX
    let j : S →ₗ[k] Y := φ.toLinearMap
    have hjint : ∀ g s, j (σS g s) = τY g (j s) := fun g s =>
      Representation.IntertwiningMap.isIntertwining σS τY φ g s
    
    have hjinj : Function.Injective j := by
      let W : Submodule k X := (LinearMap.ker j).map S.subtype
      have hWst : ∀ g, ∀ x ∈ W, τX g x ∈ W := by
        intro g x hx
        obtain ⟨s, hs, rfl⟩ := Submodule.mem_map.mp hx
        refine Submodule.mem_map.mpr ⟨σS g s, ?_, hσS g s⟩
        rw [LinearMap.mem_ker] at hs ⊢
        rw [hjint, hs, map_zero]
      have hW : W = ⊥ := by
        by_contra hW0
        have h1 := hSd W hW0 hWst
        have h2 : Module.finrank k W = Module.finrank k (LinearMap.ker j) :=
          Submodule.finrank_map_subtype_eq S _
        have h3 : Module.finrank k (LinearMap.ker j) = Module.finrank k S :=
          le_antisymm (Submodule.finrank_le _) (le_trans h1 h2.le)
        have h4 : LinearMap.ker j = ⊤ := Submodule.eq_top_of_finrank_eq h3
        apply hφ
        apply hext
        intro s
        have hs : s ∈ LinearMap.ker j := by rw [h4]; exact Submodule.mem_top
        rw [LinearMap.mem_ker] at hs
        rw [Representation.IntertwiningMap.coe_zero, Pi.zero_apply]
        exact hs
      rw [← LinearMap.ker_eq_bot, eq_bot_iff]
      intro s hs
      have hsW : (s : X) ∈ W := Submodule.mem_map.mpr ⟨s, hs, rfl⟩
      rw [hW, Submodule.mem_bot] at hsW
      rw [Submodule.mem_bot]
      exact Subtype.ext hsW
    
    obtain ⟨X', hX'c, hX'st⟩ := maschke τX hX S hSst
    have hRst : ∀ g, ∀ y ∈ LinearMap.range j, τY g y ∈ LinearMap.range j := by
      rintro g _ ⟨s, rfl⟩
      exact ⟨σS g s, hjint g s⟩
    obtain ⟨Y', hY'c, hY'st⟩ := maschke τY hY _ hRst
    obtain ⟨σX', hσX'⟩ := restrict τX X' hX'st
    obtain ⟨σY', hσY'⟩ := restrict τY Y' hY'st
    have hσX's := scalarRestrict τX X' σX' hσX' hX
    have hσY's := scalarRestrict τY Y' σY' hσY' hY
    obtain ⟨eX, heX⟩ := glue τX σS S.subtype S.injective_subtype (fun g s => hσS g s) X'
      (by rw [Submodule.range_subtype]; exact hX'c) hX'st σX' hσX'
    obtain ⟨eY, heY⟩ := glue τY σS j hjinj hjint Y' hY'c hY'st σY' hσY'
    have hlt : Module.finrank k X' < n := by
      have := Submodule.finrank_add_eq_of_isCompl hX'c
      omega
    
    have hdimEq' : ∀ {T : Type u} [AddCommGroup T] [Module k T] [FiniteDimensional k T]
        (σT : Representation k G T), (∀ g ∈ K0, σT g = (ω g : k) • LinearMap.id) →
        Module.finrank k (σT.IntertwiningMap σX') = Module.finrank k (σT.IntertwiningMap σY') := by
      intro T _ _ _ σT hσT
      have a := split σT τX σS σX' eX heX
      have b := split σT τY σS σY' eY heY
      have c := hdimEq σT hσT
      omega
    obtain ⟨e', he'⟩ := ih _ hlt σX' σY' hσX's hσY's hdimEq' rfl
    refine ⟨eX.trans ((LinearEquiv.prodCongr (LinearEquiv.refl k S) e').trans eY.symm), fun g => ?_⟩
    apply LinearMap.ext; intro x
    have h1 := heX g x
    have h2 : ∀ b : X', e' (σX' g b) = σY' g (e' b) := fun b => LinearMap.congr_fun (he' g) b
    have h3 : ∀ a b, eY.symm (σS g a, σY' g b) = τY g (eY.symm (a, b)) := by
      intro a b
      apply eY.injective
      simp only [heY, LinearEquiv.apply_symm_apply]
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.trans_apply,
      LinearEquiv.prodCongr_apply, LinearEquiv.refl_apply, h1, h2, h3]

theorem hadd_tprod_of_hadd {k : Type} [Field k] {G : Type u} [Group G]
    (K0 : Subgroup G) (ω : G →* kˣ)
    (h : ∀ {X : Type u} [AddCommGroup X] [Module k X], Representation k G X → ℕ)
    (hadd : ∀ {X₁ X X₂ : Type u} [AddCommGroup X₁] [Module k X₁] [AddCommGroup X] [Module k X]
      [AddCommGroup X₂] [Module k X₂] [FiniteDimensional k X₁] [FiniteDimensional k X]
      [FiniteDimensional k X₂]
      (τ₁ : Representation k G X₁) (τ : Representation k G X) (τ₂ : Representation k G X₂),
      (∀ g ∈ K0, τ₁ g = (ω g : k) • LinearMap.id) → (∀ g ∈ K0, τ g = (ω g : k) • LinearMap.id) →
      (∀ g ∈ K0, τ₂ g = (ω g : k) • LinearMap.id) →
      ∀ (f : X₁ →ₗ[k] X) (q : X →ₗ[k] X₂), (∀ g, f ∘ₗ τ₁ g = τ g ∘ₗ f) →
        (∀ g, q ∘ₗ τ g = τ₂ g ∘ₗ q) → Function.Injective f → Function.Surjective q →
        LinearMap.range f = LinearMap.ker q → h τ = h τ₁ + h τ₂)
    {V : Type u} [AddCommGroup V] [Module k V] [FiniteDimensional k V]
    (σ : Representation k G V) (hσ : ∀ g ∈ K0, σ g = (ω g : k) • LinearMap.id) :
    (∀ {X₁ X X₂ : Type u} [AddCommGroup X₁] [Module k X₁] [AddCommGroup X] [Module k X]
      [AddCommGroup X₂] [Module k X₂] [FiniteDimensional k X₁] [FiniteDimensional k X]
      [FiniteDimensional k X₂]
      (τ₁ : Representation k G X₁) (τ : Representation k G X) (τ₂ : Representation k G X₂),
      (∀ g ∈ K0, τ₁ g = 1) → (∀ g ∈ K0, τ g = 1) → (∀ g ∈ K0, τ₂ g = 1) →
      ∀ (f : X₁ →ₗ[k] X) (q : X →ₗ[k] X₂), (∀ g, f ∘ₗ τ₁ g = τ g ∘ₗ f) →
        (∀ g, q ∘ₗ τ g = τ₂ g ∘ₗ q) → Function.Injective f → Function.Surjective q →
        LinearMap.range f = LinearMap.ker q →
        h (σ.tprod τ) = h (σ.tprod τ₁) + h (σ.tprod τ₂)) ∧
    h (σ.tprod (Representation.trivial k G (ULift.{u} k))) = h σ :=
by
  classical
  have hS : ∀ {X : Type u} [AddCommGroup X] [Module k X] (τ : Representation k G X),
      (∀ g ∈ K0, τ g = 1) → ∀ g ∈ K0, (σ.tprod τ) g = (ω g : k) • LinearMap.id := by
    intro X _ _ τ hτ g hg
    apply TensorProduct.ext'
    intro v x
    rw [Representation.tprod_apply, hσ g hg, hτ g hg, TensorProduct.map_tmul]
    simp only [LinearMap.smul_apply, LinearMap.id_apply, Module.End.one_apply,
      TensorProduct.smul_tmul']
  refine ⟨?_, ?_⟩
  · intro X₁ X X₂ _ _ _ _ _ _ _ _ _ τ₁ τ τ₂ h₁ h₀ h₂ f q hf hq hfi hqs hex
    have hi : Function.Injective (f.lTensor V) :=
      Module.Flat.lTensor_preserves_injective_linearMap f hfi
    have hs : Function.Surjective (q.lTensor V) := LinearMap.lTensor_surjective V hqs
    have hr : LinearMap.range (f.lTensor V) = LinearMap.ker (q.lTensor V) := by
      have e : Function.Exact f q := LinearMap.exact_iff.mpr hex.symm
      exact (LinearMap.exact_iff.mp (Module.Flat.lTensor_exact V e)).symm
    refine hadd (σ.tprod τ₁) (σ.tprod τ) (σ.tprod τ₂) (hS τ₁ h₁) (hS τ h₀) (hS τ₂ h₂)
      (f.lTensor V) (q.lTensor V) ?_ ?_ hi hs hr
    · intro g
      apply TensorProduct.ext'
      intro v x
      simp only [LinearMap.comp_apply, Representation.tprod_apply, TensorProduct.map_tmul,
        LinearMap.lTensor_tmul]
      rw [show f (τ₁ g x) = τ g (f x) from LinearMap.congr_fun (hf g) x]
    · intro g
      apply TensorProduct.ext'
      intro v x
      simp only [LinearMap.comp_apply, Representation.tprod_apply, TensorProduct.map_tmul,
        LinearMap.lTensor_tmul]
      rw [show q (τ g x) = τ₂ g (q x) from LinearMap.congr_fun (hq g) x]
  · haveI : FiniteDimensional k (ULift.{u} k) :=
      LinearEquiv.finiteDimensional ULift.moduleEquiv.symm
    have h1 := hS (Representation.trivial k G (ULift.{u} k))
      (fun g _ => LinearMap.ext fun v => rfl)
    have hZ : ∀ g ∈ K0, (Representation.trivial k G PUnit.{u+1}) g = (ω g : k) • LinearMap.id :=
      fun g _ => LinearMap.ext fun v => Subsingleton.elim _ _
    have h0 := hadd _ _ _ hZ hZ hZ (0 : PUnit.{u+1} →ₗ[k] PUnit.{u+1})
      (0 : PUnit.{u+1} →ₗ[k] PUnit.{u+1})
      (fun g => LinearMap.ext fun v => Subsingleton.elim _ _)
      (fun g => LinearMap.ext fun v => Subsingleton.elim _ _)
      (Function.injective_of_subsingleton _) (Function.surjective_to_subsingleton _)
      (Subsingleton.elim _ _)
    have hz : h (Representation.trivial k G PUnit.{u+1}) = 0 := by omega
    let eE : TensorProduct k V (ULift.{u} k) ≃ₗ[k] V :=
      (LinearEquiv.lTensor V ULift.moduleEquiv).trans (TensorProduct.rid k V)
    have hmain := hadd _ σ _ h1 hσ hZ eE.toLinearMap (0 : V →ₗ[k] PUnit.{u+1}) ?_
      (fun g => LinearMap.ext fun v => Subsingleton.elim _ _) eE.injective
      (Function.surjective_to_subsingleton _) ?_
    · rw [hz, add_zero] at hmain
      exact hmain.symm
    · intro g
      apply TensorProduct.ext'
      intro v c
      simp [eE, Representation.tprod_apply]
    · rw [LinearMap.ker_zero]
      exact LinearMap.range_eq_top.mpr eE.surjective

theorem indRep_char_finiteDimensional_scalar {k : Type} [Field k] {G : Type u} [Group G]
    (K0 : Subgroup G) [K0.Normal] [K0.FiniteIndex] (ω : G →* kˣ)
    (T : Subgroup G) (hK0T : K0 ≤ T) (θ : T →* kˣ)
    (hθ : ∀ t : T, (t : G) ∈ K0 → θ t = ω (t : G))
    (σ : Representation k T (ULift.{u} k)) (hσ : ∀ t, σ t = ((θ t : kˣ) : k) • LinearMap.id) :
    FiniteDimensional k (EllipticRootNumber.indSpace T σ) ∧
      ∀ g ∈ K0, EllipticRootNumber.indRep T σ g = ((ω g : kˣ) : k) • LinearMap.id :=
by
  classical
  haveI : T.FiniteIndex := Subgroup.finiteIndex_of_le hK0T
  haveI : Finite (G ⧸ T) := Subgroup.finite_quotient_of_finiteIndex
  haveI : Module.Finite k (ULift.{u} k) := Module.Finite.equiv ULift.moduleEquiv.symm
  refine ⟨?_, ?_⟩
  · let Φ : EllipticRootNumber.indSpace T σ →ₗ[k] (G ⧸ T → ULift.{u} k) :=
      (LinearMap.funLeft k (ULift.{u} k) (fun c : G ⧸ T => (Quotient.out c)⁻¹)) ∘ₗ
        (EllipticRootNumber.indSpace T σ).subtype
    have hΦ : Function.Injective Φ := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro f hf
      apply Subtype.ext
      funext g
      obtain ⟨h, hh⟩ := QuotientGroup.mk_out_eq_mul T g⁻¹
      have h0 : (f : G → ULift.{u} k) ((Quotient.out ((g⁻¹ : G) : G ⧸ T))⁻¹) = 0 :=
        congrFun hf ((g⁻¹ : G) : G ⧸ T)
      rw [hh, mul_inv_rev, inv_inv] at h0
      have hm := f.2 h (((h : T) : G)⁻¹ * g)
      rw [mul_inv_cancel_left, h0, map_zero] at hm
      exact hm
    exact Module.Finite.of_injective Φ hΦ
  · intro g hg
    apply LinearMap.ext
    intro f
    apply Subtype.ext
    funext x
    have hc : x * g * x⁻¹ ∈ K0 := Subgroup.Normal.conj_mem ‹K0.Normal› g hg x
    have hm := f.2 ⟨x * g * x⁻¹, hK0T hc⟩ x
    have e : x * g * x⁻¹ * x = x * g := by group
    have hω : ω (x * g * x⁻¹) = ω g := by
      rw [map_mul, map_mul, map_inv, mul_comm (ω x) (ω g), mul_inv_cancel_right]
    have hθ' := hθ ⟨x * g * x⁻¹, hK0T hc⟩ hc
    change (f : G → ULift.{u} k) (x * g) = ((ω g : kˣ) : k) • (f : G → ULift.{u} k) x
    calc (f : G → ULift.{u} k) (x * g) = (f : G → ULift.{u} k) (x * g * x⁻¹ * x) := by rw [e]
      _ = σ ⟨x * g * x⁻¹, hK0T hc⟩ ((f : G → ULift.{u} k) x) := hm
      _ = ((ω g : kˣ) : k) • (f : G → ULift.{u} k) x := by
        rw [hσ, LinearMap.smul_apply, LinearMap.id_apply, hθ', hω]

theorem hdim_local_identity_of_hyperelementary {k : Type} [Field k] [IsAlgClosed k] [CharZero k]
    {G : Type u} [Group G] {V : Type u} [AddCommGroup V] [Module k V]
    (ρ : Representation k G V) (hdim : Module.finrank k V = 2)
    (K0 : Subgroup G) [K0.Normal] [K0.FiniteIndex] (ω : G →* kˣ)
    (hscal : ∀ g ∈ K0, ρ g = (ω g : k) • LinearMap.id)
    (S C : Subgroup G) (c₀ : G) (p : ℕ) (hp : p.Prime) (hK0C : K0 ≤ C) (hCS : C ≤ S)
    (hCn : ∀ s ∈ S, ∀ c ∈ C, s * c * s⁻¹ ∈ C) (hc₀ : c₀ ∈ C)
    (hcyc : ∀ c ∈ C, ∃ n : ℤ, c * (c₀ ^ n)⁻¹ ∈ K0) (hpow : ∀ s ∈ S, ∃ n : ℕ, s ^ (p ^ n) ∈ C) :
    ∃ (T₁ T₂ : Subgroup G) (θ₁ θ₁' : T₁ →* kˣ) (θ₂ θ₂' : T₂ →* kˣ),
      K0 ≤ T₁ ∧ K0 ≤ T₂ ∧
      (∀ t : T₁, (t : G) ∈ K0 → θ₁ t = ω (t : G) ∧ θ₁' t = ω (t : G)) ∧
      (∀ t : T₂, (t : G) ∈ K0 → θ₂ t = ω (t : G) ∧ θ₂' t = ω (t : G)) ∧
      ∀ (h : ∀ {X : Type u} [AddCommGroup X] [Module k X], Representation k G X → ℕ),
        (∀ {X₁ X X₂ : Type u} [AddCommGroup X₁] [Module k X₁] [AddCommGroup X] [Module k X]
          [AddCommGroup X₂] [Module k X₂] [FiniteDimensional k X₁] [FiniteDimensional k X]
          [FiniteDimensional k X₂]
          (τ₁ : Representation k G X₁) (τ : Representation k G X) (τ₂ : Representation k G X₂),
          (∀ g ∈ K0, τ₁ g = (ω g : k) • LinearMap.id) → (∀ g ∈ K0, τ g = (ω g : k) • LinearMap.id) →
          (∀ g ∈ K0, τ₂ g = (ω g : k) • LinearMap.id) →
          ∀ (f : X₁ →ₗ[k] X) (q : X →ₗ[k] X₂), (∀ g, f ∘ₗ τ₁ g = τ g ∘ₗ f) →
            (∀ g, q ∘ₗ τ g = τ₂ g ∘ₗ q) → Function.Injective f → Function.Surjective q →
            LinearMap.range f = LinearMap.ker q → h τ = h τ₁ + h τ₂) →
        ∀ (ωr : Representation k G (ULift.{u} k)), (∀ g, ωr g = ((ω g : kˣ) : k) • LinearMap.id) →
        ∀ (σ₁ σ₁' : Representation k T₁ (ULift.{u} k)) (σ₂ σ₂' : Representation k T₂ (ULift.{u} k)),
          (∀ t, σ₁ t = ((θ₁ t : kˣ) : k) • LinearMap.id) → (∀ t, σ₁' t = ((θ₁' t : kˣ) : k) • LinearMap.id) →
          (∀ t, σ₂ t = ((θ₂ t : kˣ) : k) • LinearMap.id) → (∀ t, σ₂' t = ((θ₂' t : kˣ) : k) • LinearMap.id) →
          h (ρ.tprod (EllipticRootNumber.indRep S (Representation.trivial k S (ULift.{u} k)))) +
              h (EllipticRootNumber.indRep T₁ σ₁') + h (EllipticRootNumber.indRep T₂ σ₂') =
            2 * h (ωr.tprod (EllipticRootNumber.indRep S (Representation.trivial k S (ULift.{u} k)))) +
              h (EllipticRootNumber.indRep T₁ σ₁) + h (EllipticRootNumber.indRep T₂ σ₂) :=
by
  classical
  have hK0S : K0 ≤ S := hK0C.trans hCS
  haveI : S.FiniteIndex := Subgroup.finiteIndex_of_le hK0S
  haveI hVfin : FiniteDimensional k V :=
    FiniteDimensional.of_finrank_pos (by rw [hdim]; norm_num)
  haveI hUfin : FiniteDimensional k (ULift.{u} k) := Module.Finite.equiv ULift.moduleEquiv.symm
  
  have hsymm : ∀ {A B : Type u} [AddCommGroup A] [Module k A] [AddCommGroup B] [Module k B]
      (τA : Representation k G A) (τB : Representation k G B) (E : A ≃ₗ[k] B),
      (∀ g, E.toLinearMap ∘ₗ τA g = τB g ∘ₗ E.toLinearMap) →
      ∀ g, E.symm.toLinearMap ∘ₗ τB g = τA g ∘ₗ E.symm.toLinearMap := by
    intro A B _ _ _ _ τA τB E hE g
    apply LinearMap.ext; intro x
    apply E.injective
    have := LinearMap.congr_fun (hE g) (E.symm x)
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply] at this ⊢
    exact this.symm
  
  have htrans : ∀ {A B M : Type u} [AddCommGroup A] [Module k A] [AddCommGroup B] [Module k B]
      [AddCommGroup M] [Module k M]
      (τA : Representation k G A) (τB : Representation k G B) (τM : Representation k G M)
      (E₁ : A ≃ₗ[k] M) (E₂ : B ≃ₗ[k] M),
      (∀ g, E₁.toLinearMap ∘ₗ τA g = τM g ∘ₗ E₁.toLinearMap) →
      (∀ g, E₂.toLinearMap ∘ₗ τB g = τM g ∘ₗ E₂.toLinearMap) →
      ∀ g, (E₁.trans E₂.symm).toLinearMap ∘ₗ τA g = τB g ∘ₗ (E₁.trans E₂.symm).toLinearMap := by
    intro A B M _ _ _ _ _ _ τA τB τM E₁ E₂ h₁ h₂ g
    apply LinearMap.ext; intro x
    have a := LinearMap.congr_fun (h₁ g) x
    have b := LinearMap.congr_fun (hsymm τB τM E₂ h₂ g) (E₁ x)
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.trans_apply] at a b ⊢
    rw [a, b]
  
  have hscalT : ∀ {A B : Type u} [AddCommGroup A] [Module k A] [AddCommGroup B] [Module k B]
      (τA : Representation k G A) (τB : Representation k G B) (E : A ≃ₗ[k] B),
      (∀ g, E.toLinearMap ∘ₗ τA g = τB g ∘ₗ E.toLinearMap) →
      (∀ g ∈ K0, τB g = ((ω g : kˣ) : k) • LinearMap.id) →
      ∀ g ∈ K0, τA g = ((ω g : kˣ) : k) • LinearMap.id := by
    intro A B _ _ _ _ τA τB E hE hB g hg
    apply LinearMap.ext; intro x
    apply E.injective
    have := LinearMap.congr_fun (hE g) x
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe] at this
    rw [this, hB g hg]
    simp
  
  have hiso : ∀ (h : ∀ {X : Type u} [AddCommGroup X] [Module k X], Representation k G X → ℕ),
      (∀ {X₁ X X₂ : Type u} [AddCommGroup X₁] [Module k X₁] [AddCommGroup X] [Module k X]
          [AddCommGroup X₂] [Module k X₂] [FiniteDimensional k X₁] [FiniteDimensional k X]
          [FiniteDimensional k X₂]
          (τ₁ : Representation k G X₁) (τ : Representation k G X) (τ₂ : Representation k G X₂),
          (∀ g ∈ K0, τ₁ g = (ω g : k) • LinearMap.id) → (∀ g ∈ K0, τ g = (ω g : k) • LinearMap.id) →
          (∀ g ∈ K0, τ₂ g = (ω g : k) • LinearMap.id) →
          ∀ (f : X₁ →ₗ[k] X) (q : X →ₗ[k] X₂), (∀ g, f ∘ₗ τ₁ g = τ g ∘ₗ f) →
            (∀ g, q ∘ₗ τ g = τ₂ g ∘ₗ q) → Function.Injective f → Function.Surjective q →
            LinearMap.range f = LinearMap.ker q → h τ = h τ₁ + h τ₂) →
      ∀ {A B : Type u} [AddCommGroup A] [Module k A] [AddCommGroup B] [Module k B]
        [FiniteDimensional k A] [FiniteDimensional k B]
        (τA : Representation k G A) (τB : Representation k G B),
        (∀ g ∈ K0, τA g = ((ω g : kˣ) : k) • LinearMap.id) →
        (∀ g ∈ K0, τB g = ((ω g : kˣ) : k) • LinearMap.id) →
        ∀ (E : A ≃ₗ[k] B), (∀ g, E.toLinearMap ∘ₗ τA g = τB g ∘ₗ E.toLinearMap) →
          h τA = h τB := by
    intro h hadd A B _ _ _ _ _ _ τA τB hA hB E hE
    have hZs : ∀ g ∈ K0, (Representation.trivial k G PUnit.{u+1}) g =
        ((ω g : kˣ) : k) • LinearMap.id :=
      fun g _ => LinearMap.ext fun x => Subsingleton.elim _ _
    have hZ0 : h (Representation.trivial k G PUnit.{u+1}) = 0 := by
      have := hadd (Representation.trivial k G PUnit.{u+1}) (Representation.trivial k G PUnit.{u+1})
        (Representation.trivial k G PUnit.{u+1}) hZs hZs hZs 0 0
        (fun g => LinearMap.ext fun x => Subsingleton.elim _ _)
        (fun g => LinearMap.ext fun x => Subsingleton.elim _ _)
        (fun x y _ => Subsingleton.elim x y) (fun y => ⟨y, Subsingleton.elim _ _⟩)
        (by ext x; simp [Subsingleton.elim x 0])
      omega
    have := hadd τA τB (Representation.trivial k G PUnit.{u+1}) hA hB hZs E.toLinearMap 0 hE
      (fun g => LinearMap.ext fun x => Subsingleton.elim _ _) E.injective
      (fun y => ⟨0, Subsingleton.elim _ _⟩) (by rw [LinearEquiv.range, LinearMap.ker_zero])
    omega
  
  obtain ⟨hPfin, hPsc⟩ := indRep_char_finiteDimensional_scalar K0 (1 : G →* kˣ) S hK0S
    (1 : S →* kˣ) (fun _ _ => rfl) (Representation.trivial k S (ULift.{u} k))
    (fun t => LinearMap.ext fun x => by simp)
  haveI := hPfin
  have htpsc : ∀ {W : Type u} [AddCommGroup W] [Module k W] (σ : Representation k G W),
      (∀ g ∈ K0, σ g = ((ω g : kˣ) : k) • LinearMap.id) →
      ∀ g ∈ K0, (σ.tprod (EllipticRootNumber.indRep S
          (Representation.trivial k S (ULift.{u} k)))) g = ((ω g : kˣ) : k) • LinearMap.id := by
    intro W _ _ σ hσ g hg
    rw [Representation.tprod_apply, hσ g hg, hPsc g hg]
    simp [TensorProduct.map_smul_left, TensorProduct.map_id]
  have hne : ∃ x : TensorProduct k V
      (EllipticRootNumber.indSpace S (Representation.trivial k S (ULift.{u} k))), x ≠ 0 := by
    have hP : 0 < Module.finrank k
        (EllipticRootNumber.indSpace S (Representation.trivial k S (ULift.{u} k))) := by
      rw [Module.finrank_pos_iff_exists_ne_zero]
      refine ⟨⟨fun _ => ULift.up 1, fun s x => rfl⟩, ?_⟩
      intro h0
      have := congrArg (fun F : EllipticRootNumber.indSpace S
        (Representation.trivial k S (ULift.{u} k)) => ((F : G → ULift.{u} k) 1).down) h0
      simp at this
    have : 0 < Module.finrank k (TensorProduct k V
        (EllipticRootNumber.indSpace S (Representation.trivial k S (ULift.{u} k)))) := by
      rw [Module.finrank_tensorProduct, hdim]; omega
    exact Module.finrank_pos_iff_exists_ne_zero.mp this
  have hωproj : ∀ (ωr : Representation k G (ULift.{u} k)),
      (∀ g, ωr g = ((ω g : kˣ) : k) • LinearMap.id) →
      ∀ (σs : Representation k S (ULift.{u} k)),
      (∀ t, σs t = (((ω.comp S.subtype) t : kˣ) : k) • LinearMap.id) →
      ∃ e : TensorProduct k (ULift.{u} k)
          (EllipticRootNumber.indSpace S (Representation.trivial k S (ULift.{u} k))) ≃ₗ[k]
          EllipticRootNumber.indSpace S σs,
        ∀ g : G, e.toLinearMap ∘ₗ (ωr.tprod (EllipticRootNumber.indRep S
            (Representation.trivial k S (ULift.{u} k)))) g =
          EllipticRootNumber.indRep S σs g ∘ₗ e.toLinearMap := by
    intro ωr hωr σs hσs
    exact tprod_indSpace_trivial_equiv S ωr _ (fun _ => rfl) σs
      (fun s => by rw [hσs s, hωr s]; rfl)
  
  have hagInd : ∀ (T : Subgroup G) (χ : T →* kˣ) (σ : Representation k T (ULift.{u} k)),
      (∀ t, σ t = ((χ t : kˣ) : k) • LinearMap.id) →
      (∀ g ∈ K0, EllipticRootNumber.indRep T σ g = ((ω g : kˣ) : k) • LinearMap.id) →
      (∃ f : EllipticRootNumber.indSpace T σ, f ≠ 0) →
      ∀ t : T, (t : G) ∈ K0 → χ t = ω (t : G) := by
    intro T χ σ hσ hsc ⟨f, hf⟩ t ht
    have hf' : (f : G → ULift.{u} k) ≠ 0 := fun h0 => hf (Subtype.ext h0)
    obtain ⟨y, hy⟩ := Function.ne_iff.mp hf'
    have hy' : (f : G → ULift.{u} k) y ≠ 0 := hy
    have hκ : y⁻¹ * (t : G) * y ∈ K0 := by
      have := Subgroup.Normal.conj_mem (inferInstance : K0.Normal) (t : G) ht y⁻¹
      simpa using this
    have e1 := congrArg (fun F : EllipticRootNumber.indSpace T σ => (F : G → ULift.{u} k) y)
      (LinearMap.congr_fun (hsc _ hκ) f)
    change (f : G → ULift.{u} k) (y * (y⁻¹ * (t : G) * y)) =
      ((ω (y⁻¹ * (t : G) * y) : kˣ) : k) • (f : G → ULift.{u} k) y at e1
    have hmul : y * (y⁻¹ * (t : G) * y) = (t : G) * y := by group
    have hω : ω (y⁻¹ * (t : G) * y) = ω t := by
      rw [map_mul, map_mul, map_inv, mul_comm (ω y)⁻¹ (ω t), mul_assoc, inv_mul_cancel, mul_one]
    rw [hmul, hω, f.2 t y, hσ t] at e1
    apply Units.ext
    exact smul_left_injective k hy' e1
  rcases monomial_or_line_of_hyperelementary ρ hdim K0 ω hscal S C c₀ p hp hK0C hCS hCn hc₀ hcyc
    hpow with ⟨L, hL, hst⟩ | ⟨S', hK0S', hS'S, ⟨t, htS, htS', hidx⟩, L, hL, hst, hmove⟩
  · 
    obtain ⟨θ₁, θ₂, -, hlx⟩ := line_char_exact S ρ hdim L hL hst
    have hag : ∀ t : S, (t : G) ∈ K0 → θ₁ t = ω (t : G) ∧ θ₂ t = ω (t : G) := by
      obtain ⟨f₀, g₀, hf₀, hg₀, hfi₀, hgs₀, -⟩ := hlx (ρ.comp S.subtype) (brauerChr θ₁)
        (brauerChr θ₂) (fun _ => rfl) (fun _ => rfl) (fun _ => rfl)
      intro t ht
      have hu : (ULift.up (1 : k) : ULift.{u} k) ≠ 0 := fun h0 => one_ne_zero (congrArg ULift.down h0)
      constructor
      · have e := LinearMap.congr_fun (hf₀ t) (ULift.up 1)
        change f₀ (((θ₁ t : kˣ) : k) • ULift.up 1) = ρ t (f₀ (ULift.up 1)) at e
        rw [map_smul, hscal _ ht, LinearMap.smul_apply, LinearMap.id_apply] at e
        have hfu : f₀ (ULift.up 1) ≠ 0 := fun h0 => hu (hfi₀ (h0.trans (map_zero f₀).symm))
        apply Units.ext
        exact smul_left_injective k hfu e
      · obtain ⟨v, hv⟩ := hgs₀ (ULift.up 1)
        have e := LinearMap.congr_fun (hg₀ t) v
        change g₀ (ρ t v) = ((θ₂ t : kˣ) : k) • g₀ v at e
        rw [hscal _ ht, LinearMap.smul_apply, LinearMap.id_apply, map_smul, hv] at e
        apply Units.ext
        exact (smul_left_injective k hu e).symm
    refine ⟨S, S, θ₁, ω.comp S.subtype, θ₂, ω.comp S.subtype, hK0S, hK0S,
      fun t ht => ⟨(hag t ht).1, rfl⟩, fun t ht => ⟨(hag t ht).2, rfl⟩, ?_⟩
    intro h hadd ωr hωr σ₁ σ₁' σ₂ σ₂' hσ₁ hσ₁' hσ₂ hσ₂'
    obtain ⟨fd₁, sc₁⟩ := indRep_char_finiteDimensional_scalar K0 ω S hK0S θ₁
      (fun t ht => (hag t ht).1) σ₁ hσ₁
    obtain ⟨fd₂, sc₂⟩ := indRep_char_finiteDimensional_scalar K0 ω S hK0S θ₂
      (fun t ht => (hag t ht).2) σ₂ hσ₂
    obtain ⟨fd₁', sc₁'⟩ := indRep_char_finiteDimensional_scalar K0 ω S hK0S (ω.comp S.subtype)
      (fun t ht => rfl) σ₁' hσ₁'
    obtain ⟨fd₂', sc₂'⟩ := indRep_char_finiteDimensional_scalar K0 ω S hK0S (ω.comp S.subtype)
      (fun t ht => rfl) σ₂' hσ₂'
    haveI := fd₁; haveI := fd₂; haveI := fd₁'; haveI := fd₂'
    obtain ⟨e₀, he₀⟩ := tprod_indSpace_trivial_equiv S ρ (Representation.trivial k S (ULift.{u} k))
      (fun _ => rfl) (ρ.comp S.subtype) (fun _ => rfl)
    haveI : FiniteDimensional k (EllipticRootNumber.indSpace S (ρ.comp S.subtype)) :=
      Module.Finite.equiv e₀
    have scM : ∀ g ∈ K0, EllipticRootNumber.indRep S (ρ.comp S.subtype) g =
        ((ω g : kˣ) : k) • LinearMap.id :=
      hscalT _ _ e₀.symm (hsymm _ _ e₀ he₀) (htpsc ρ hscal)
    have Eρ := hiso h hadd _ _ (htpsc ρ hscal) scM e₀ he₀
    obtain ⟨f, g, hf, hg, hfi, hgs, hex⟩ := hlx (ρ.comp S.subtype) σ₁ σ₂ (fun _ => rfl) hσ₁ hσ₂
    obtain ⟨F₁, F₂, hF₁, hF₂, hF₁i, hF₂s, hFex⟩ :=
      indSpace_exact S σ₁ (ρ.comp S.subtype) σ₂ f g hf hg hfi hgs hex
    have E1 := hadd _ _ _ sc₁ scM sc₂ F₁ F₂ hF₁ hF₂ hF₁i hF₂s hFex
    obtain ⟨eω₁, heω₁⟩ := hωproj ωr hωr σ₁' hσ₁'
    obtain ⟨eω₂, heω₂⟩ := hωproj ωr hωr σ₂' hσ₂'
    have E21 := hiso h hadd _ _ sc₁' (htpsc ωr (fun g _ => hωr g)) eω₁.symm (hsymm _ _ eω₁ heω₁)
    have E22 := hiso h hadd _ _ sc₂' (htpsc ωr (fun g _ => hωr g)) eω₂.symm (hsymm _ _ eω₂ heω₂)
    beta_reduce at Eρ E21 E22
    omega
  · 
    obtain ⟨χ, -, hix⟩ := indSpace_index_two_line_equiv S S' hS'S t htS htS' hidx ρ hdim L hL hst
      hmove
    obtain ⟨e₀, he₀⟩ := tprod_indSpace_trivial_equiv S ρ (Representation.trivial k S (ULift.{u} k))
      (fun _ => rfl) (ρ.comp S.subtype) (fun _ => rfl)
    haveI : FiniteDimensional k (EllipticRootNumber.indSpace S (ρ.comp S.subtype)) :=
      Module.Finite.equiv e₀
    have scM : ∀ g ∈ K0, EllipticRootNumber.indRep S (ρ.comp S.subtype) g =
        ((ω g : kˣ) : k) • LinearMap.id :=
      hscalT _ _ e₀.symm (hsymm _ _ e₀ he₀) (htpsc ρ hscal)
    have hagχ : ∀ t : S', (t : G) ∈ K0 → χ t = ω (t : G) := by
      obtain ⟨e₁, he₁⟩ := hix (ρ.comp S.subtype) (brauerChr χ) (fun _ => rfl) (fun _ => rfl)
      have hE := htrans _ _ _ e₁ e₀ he₁ he₀
      refine hagInd S' χ (brauerChr χ) (fun _ => rfl) (hscalT _ _ (e₁.trans e₀.symm) hE
        (htpsc ρ hscal)) ?_
      obtain ⟨x, hx⟩ := hne
      exact ⟨(e₁.trans e₀.symm).symm x, fun h0 => hx (by
        have := congrArg (e₁.trans e₀.symm) h0
        simpa using this)⟩
    
    have hmk : ∀ (K : Subgroup G) (α β : Representation k K (ULift.{u} k)) (ν : G →* kˣ),
        (∀ x : K, β x = ((ν x : kˣ) : k) • α x) →
        ∃ M : EllipticRootNumber.indSpace K α →ₗ[k] EllipticRootNumber.indSpace K β,
          ∀ F x, (M F : G → ULift.{u} k) x = ((ν x : kˣ) : k) • (F : G → ULift.{u} k) x := by
      intro K α β ν hαβ
      refine ⟨{ toFun := fun F => ⟨fun x => ((ν x : kˣ) : k) • (F : G → ULift.{u} k) x, ?_⟩,
                map_add' := ?_, map_smul' := ?_ }, fun F x => rfl⟩
      · intro a x
        change ((ν ((a : G) * x) : kˣ) : k) • (F : G → ULift.{u} k) ((a : G) * x) =
          β a (((ν x : kˣ) : k) • (F : G → ULift.{u} k) x)
        rw [F.2 a x, hαβ a, LinearMap.smul_apply, map_smul, map_mul, Units.val_mul, mul_smul]
      · intro F₁ F₂
        exact Subtype.ext (funext fun x => smul_add _ _ _)
      · intro c F
        refine Subtype.ext (funext fun x => ?_)
        show ((ν x : kˣ) : k) • (c • (F : G → ULift.{u} k) x) =
          c • (((ν x : kˣ) : k) • (F : G → ULift.{u} k) x)
        exact smul_comm _ _ _
    have htw : ∀ (K : Subgroup G) (α β : Representation k K (ULift.{u} k)),
        (∀ x : K, β x = ((ω x : kˣ) : k) • α x) →
        ∃ M : EllipticRootNumber.indSpace K α ≃ₗ[k] EllipticRootNumber.indSpace K β,
          (∀ g F, EllipticRootNumber.indRep K β g (M F) =
            ((ω g : kˣ) : k) • M (EllipticRootNumber.indRep K α g F)) ∧
          (∀ g F, M.symm (EllipticRootNumber.indRep K β g F) =
            ((ω g : kˣ) : k) • EllipticRootNumber.indRep K α g (M.symm F)) := by
      intro K α β hαβ
      obtain ⟨M, hM⟩ := hmk K α β ω hαβ
      obtain ⟨N, hN⟩ := hmk K β α ω⁻¹ (fun x => by
        rw [hαβ x, smul_smul, ← Units.val_mul, MonoidHom.inv_apply, inv_mul_cancel, Units.val_one,
          one_smul])
      let E : EllipticRootNumber.indSpace K α ≃ₗ[k] EllipticRootNumber.indSpace K β :=
        LinearEquiv.ofLinear M N
          (LinearMap.ext fun F => Subtype.ext (funext fun x => by
            rw [LinearMap.comp_apply, LinearMap.id_apply, hM, hN, smul_smul, ← Units.val_mul,
              MonoidHom.inv_apply, mul_inv_cancel, Units.val_one, one_smul]))
          (LinearMap.ext fun F => Subtype.ext (funext fun x => by
            rw [LinearMap.comp_apply, LinearMap.id_apply, hN, hM, smul_smul, ← Units.val_mul,
              MonoidHom.inv_apply, inv_mul_cancel, Units.val_one, one_smul]))
      have hfw : ∀ g F, EllipticRootNumber.indRep K β g (E F) =
          ((ω g : kˣ) : k) • E (EllipticRootNumber.indRep K α g F) := by
        intro g F
        apply Subtype.ext; funext x
        change (M F : G → ULift.{u} k) (x * g) =
          ((ω g : kˣ) : k) • (M (EllipticRootNumber.indRep K α g F) : G → ULift.{u} k) x
        rw [hM, hM, map_mul, Units.val_mul, mul_comm ((ω x : kˣ) : k), mul_smul]
        rfl
      refine ⟨E, hfw, fun g F => ?_⟩
      apply E.injective
      rw [LinearEquiv.apply_symm_apply, map_smul, ← hfw, LinearEquiv.apply_symm_apply]
    obtain ⟨η, hη1, hη0⟩ := indSpace_index_two_trivial_exact (k := k) S S' hS'S t htS htS' hidx
    have hag2 : ∀ t : S, (t : G) ∈ K0 → (ω.comp S.subtype * η) t = ω (t : G) := by
      intro t ht
      rw [MonoidHom.mul_apply, hη1 t (hK0S' ht), mul_one]
      rfl
    refine ⟨S', S, χ, ω.comp S'.subtype, ω.comp S.subtype * η, ω.comp S.subtype, hK0S', hK0S,
      fun t ht => ⟨hagχ t ht, rfl⟩, fun t ht => ⟨hag2 t ht, rfl⟩, ?_⟩
    intro h hadd ωr hωr σ₁ σ₁' σ₂ σ₂' hσ₁ hσ₁' hσ₂ hσ₂'
    obtain ⟨fd₁, sc₁⟩ := indRep_char_finiteDimensional_scalar K0 ω S' hK0S' χ hagχ σ₁ hσ₁
    obtain ⟨fd₁', sc₁'⟩ := indRep_char_finiteDimensional_scalar K0 ω S' hK0S' (ω.comp S'.subtype)
      (fun t ht => rfl) σ₁' hσ₁'
    obtain ⟨fd₂, sc₂⟩ := indRep_char_finiteDimensional_scalar K0 ω S hK0S (ω.comp S.subtype * η)
      hag2 σ₂ hσ₂
    obtain ⟨fd₂', sc₂'⟩ := indRep_char_finiteDimensional_scalar K0 ω S hK0S (ω.comp S.subtype)
      (fun t ht => rfl) σ₂' hσ₂'
    haveI := fd₁; haveI := fd₂; haveI := fd₁'; haveI := fd₂'
    
    obtain ⟨e₁', he₁'⟩ := hix (ρ.comp S.subtype) σ₁ (fun _ => rfl) hσ₁
    have Ea := hiso h hadd _ _ sc₁ scM e₁' he₁'
    have Eρ := hiso h hadd _ _ (htpsc ρ hscal) scM e₀ he₀
    
    obtain ⟨eω, heω⟩ := hωproj ωr hωr σ₂' hσ₂'
    have Eb := hiso h hadd _ _ sc₂' (htpsc ωr (fun g _ => hωr g)) eω.symm (hsymm _ _ eω heω)
    
    obtain ⟨f₀, q₀, hf₀, hq₀, hfi₀, hqs₀, hex₀⟩ := hη0 (Representation.trivial k S (ULift.{u} k))
      (Representation.trivial k S' (ULift.{u} k)) (brauerChr η) (fun _ => rfl) (fun _ => rfl)
      (fun _ => rfl)
    obtain ⟨MH, hMH, hMHs⟩ := htw S (Representation.trivial k S (ULift.{u} k)) σ₂'
      (fun x => by rw [hσ₂' x]; rfl)
    obtain ⟨MH', hMH', hMH's⟩ := htw S' (Representation.trivial k S' (ULift.{u} k)) σ₁'
      (fun x => by rw [hσ₁' x]; rfl)
    obtain ⟨Mη, hMη, hMηs⟩ := htw S (brauerChr η) σ₂
      (fun x => by rw [hσ₂ x, MonoidHom.mul_apply, Units.val_mul, mul_smul]; rfl)
    have Ec := hadd (EllipticRootNumber.indRep S σ₂') (EllipticRootNumber.indRep S' σ₁')
      (EllipticRootNumber.indRep S σ₂) sc₂' sc₁' sc₂
      (MH'.toLinearMap ∘ₗ f₀ ∘ₗ MH.symm.toLinearMap) (Mη.toLinearMap ∘ₗ q₀ ∘ₗ MH'.symm.toLinearMap)
      (fun g => LinearMap.ext fun F => by
        have a := LinearMap.congr_fun (hf₀ g) (MH.symm F)
        simp only [LinearMap.comp_apply, LinearEquiv.coe_coe] at a ⊢
        rw [hMHs, map_smul, map_smul, a, hMH'])
      (fun g => LinearMap.ext fun F => by
        have a := LinearMap.congr_fun (hq₀ g) (MH'.symm F)
        simp only [LinearMap.comp_apply, LinearEquiv.coe_coe] at a ⊢
        rw [hMH's, map_smul, map_smul, a, hMη])
      (MH'.injective.comp (hfi₀.comp MH.symm.injective))
      (Mη.surjective.comp (hqs₀.comp MH'.symm.surjective))
      (by
        ext x
        simp only [LinearMap.mem_range, LinearMap.mem_ker, LinearMap.comp_apply,
          LinearEquiv.coe_coe]
        constructor
        · rintro ⟨y, rfl⟩
          rw [LinearEquiv.symm_apply_apply]
          have hm : f₀ (MH.symm y) ∈ LinearMap.ker q₀ := by rw [← hex₀]; exact ⟨_, rfl⟩
          rw [LinearMap.mem_ker.mp hm, map_zero]
        · intro hx
          have hm : MH'.symm x ∈ LinearMap.range f₀ := by
            rw [hex₀, LinearMap.mem_ker]
            exact Mη.injective (hx.trans (map_zero _).symm)
          obtain ⟨y, hy⟩ := hm
          exact ⟨MH y, by rw [LinearEquiv.symm_apply_apply, hy, LinearEquiv.apply_symm_apply]⟩)
    beta_reduce at Ea Eρ Eb
    omega

theorem brauer_relation_of_scalar_on_finiteIndex {k : Type} [Field k] [IsAlgClosed k] [CharZero k]
    {G : Type u} [Group G] {V : Type u} [AddCommGroup V] [Module k V]
    (ρ : Representation k G V) (hdim : Module.finrank k V = 2)
    (K0 : Subgroup G) [K0.Normal] [K0.FiniteIndex] (ω : G →* kˣ)
    (hscal : ∀ g ∈ K0, ρ g = (ω g : k) • LinearMap.id) :
    ∃ (n : ℕ) (T : Fin n → Subgroup G) (θ θ' : ∀ i, T i →* kˣ),
      (∀ i, K0 ≤ T i) ∧
      (∀ i (t : T i), (t : G) ∈ K0 → θ i t = ω (t : G) ∧ θ' i t = ω (t : G)) ∧
      ∀ (σ σ' : ∀ i, Representation k (T i) (ULift.{u} k)),
        (∀ i t, σ i t = ((θ i t : kˣ) : k) • LinearMap.id) →
        (∀ i t, σ' i t = ((θ' i t : kˣ) : k) • LinearMap.id) →
        ∃ e : (V × (∀ i, EllipticRootNumber.indSpace (T i) (σ' i))) ≃ₗ[k]
            ((∀ i, EllipticRootNumber.indSpace (T i) (σ i)) × (Fin 2 → ULift.{u} k)),
          ∀ g : G,
            e.toLinearMap ∘ₗ ((ρ g).prodMap
                (LinearMap.pi fun i => (EllipticRootNumber.indRep (T i) (σ' i) g) ∘ₗ LinearMap.proj i)) =
              ((LinearMap.pi fun i => (EllipticRootNumber.indRep (T i) (σ i) g) ∘ₗ LinearMap.proj i).prodMap
                (LinearMap.pi fun j : Fin 2 => ((ω g : kˣ) : k) • LinearMap.proj j)) ∘ₗ e.toLinearMap :=
by
  classical
  
  haveI hVfin : FiniteDimensional k V :=
    FiniteDimensional.of_finrank_pos (by rw [hdim]; norm_num)
  haveI hUfin : FiniteDimensional k (ULift.{u} k) := Module.Finite.equiv ULift.moduleEquiv.symm
  obtain ⟨Lp, Lm, hhyp, hrel⟩ := solomon_permutation_relation (k := k) K0
  
  have key : ∀ S : Subgroup G, ∃ (T₁ T₂ : Subgroup G) (θ₁ θ₁' : T₁ →* kˣ) (θ₂ θ₂' : T₂ →* kˣ),
      S ∈ Lp ++ Lm → (K0 ≤ T₁ ∧ K0 ≤ T₂ ∧
      (∀ t : T₁, (t : G) ∈ K0 → θ₁ t = ω (t : G) ∧ θ₁' t = ω (t : G)) ∧
      (∀ t : T₂, (t : G) ∈ K0 → θ₂ t = ω (t : G) ∧ θ₂' t = ω (t : G)) ∧
      ∀ (h : ∀ {X : Type u} [AddCommGroup X] [Module k X], Representation k G X → ℕ),
        (∀ {X₁ X X₂ : Type u} [AddCommGroup X₁] [Module k X₁] [AddCommGroup X] [Module k X]
          [AddCommGroup X₂] [Module k X₂] [FiniteDimensional k X₁] [FiniteDimensional k X]
          [FiniteDimensional k X₂]
          (τ₁ : Representation k G X₁) (τ : Representation k G X) (τ₂ : Representation k G X₂),
          (∀ g ∈ K0, τ₁ g = (ω g : k) • LinearMap.id) → (∀ g ∈ K0, τ g = (ω g : k) • LinearMap.id) →
          (∀ g ∈ K0, τ₂ g = (ω g : k) • LinearMap.id) →
          ∀ (f : X₁ →ₗ[k] X) (q : X →ₗ[k] X₂), (∀ g, f ∘ₗ τ₁ g = τ g ∘ₗ f) →
            (∀ g, q ∘ₗ τ g = τ₂ g ∘ₗ q) → Function.Injective f → Function.Surjective q →
            LinearMap.range f = LinearMap.ker q → h τ = h τ₁ + h τ₂) →
        ∀ (ωr : Representation k G (ULift.{u} k)), (∀ g, ωr g = ((ω g : kˣ) : k) • LinearMap.id) →
        ∀ (σ₁ σ₁' : Representation k T₁ (ULift.{u} k)) (σ₂ σ₂' : Representation k T₂ (ULift.{u} k)),
          (∀ t, σ₁ t = ((θ₁ t : kˣ) : k) • LinearMap.id) → (∀ t, σ₁' t = ((θ₁' t : kˣ) : k) • LinearMap.id) →
          (∀ t, σ₂ t = ((θ₂ t : kˣ) : k) • LinearMap.id) → (∀ t, σ₂' t = ((θ₂' t : kˣ) : k) • LinearMap.id) →
          h (ρ.tprod (EllipticRootNumber.indRep S (Representation.trivial k S (ULift.{u} k)))) +
              h (EllipticRootNumber.indRep T₁ σ₁') + h (EllipticRootNumber.indRep T₂ σ₂') =
            2 * h (ωr.tprod (EllipticRootNumber.indRep S (Representation.trivial k S (ULift.{u} k)))) +
              h (EllipticRootNumber.indRep T₁ σ₁) + h (EllipticRootNumber.indRep T₂ σ₂)) := by
    intro S
    by_cases hS : S ∈ Lp ++ Lm
    · obtain ⟨-, C, c₀, p, hp, hK0C, hCS, hCn, hc₀, hcyc, hpow⟩ := hhyp S hS
      obtain ⟨T₁, T₂, θ₁, θ₁', θ₂, θ₂', hloc⟩ := hdim_local_identity_of_hyperelementary ρ hdim K0 ω
        hscal S C c₀ p hp hK0C hCS hCn hc₀ hcyc hpow
      exact ⟨T₁, T₂, θ₁, θ₁', θ₂, θ₂', fun _ => hloc⟩
    · exact ⟨⊤, ⊤, 1, 1, 1, 1, fun h => absurd h hS⟩
  choose T₁ T₂ θ₁ θ₁' θ₂ θ₂' hD using key
  
  obtain ⟨L, hL⟩ : ∃ L : List (Σ T : Subgroup G, (T →* kˣ) × (T →* kˣ)),
      L = (Lp.map fun S => [⟨T₁ S, θ₁ S, θ₁' S⟩, ⟨T₂ S, θ₂ S, θ₂' S⟩]).flatten ++
        (Lm.map fun S => [⟨T₁ S, θ₁' S, θ₁ S⟩, ⟨T₂ S, θ₂' S, θ₂ S⟩]).flatten := ⟨_, rfl⟩
  have hmem : ∀ x ∈ L, K0 ≤ x.1 ∧
      ∀ t : x.1, (t : G) ∈ K0 → x.2.1 t = ω (t : G) ∧ x.2.2 t = ω (t : G) := by
    intro x hx
    rw [hL] at hx
    simp only [List.mem_append, List.mem_flatten, List.mem_map] at hx
    rcases hx with ⟨l, ⟨S, hS, rfl⟩, hx⟩ | ⟨l, ⟨S, hS, rfl⟩, hx⟩
    · obtain ⟨h1, h2, a1, a2, -⟩ := hD S (List.mem_append_left _ hS)
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
      rcases hx with rfl | rfl
      · exact ⟨h1, a1⟩
      · exact ⟨h2, a2⟩
    · obtain ⟨h1, h2, a1, a2, -⟩ := hD S (List.mem_append_right _ hS)
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
      rcases hx with rfl | rfl
      · exact ⟨h1, fun t ht => ⟨(a1 t ht).2, (a1 t ht).1⟩⟩
      · exact ⟨h2, fun t ht => ⟨(a2 t ht).2, (a2 t ht).1⟩⟩
  refine ⟨L.length, fun i => (L.get i).1, fun i => (L.get i).2.1, fun i => (L.get i).2.2,
    fun i => (hmem _ (List.get_mem L i)).1, fun i t ht => (hmem _ (List.get_mem L i)).2 t ht, ?_⟩
  
  intro σ σ' hσ hσ'
  obtain rfl : σ = fun i => brauerChr (L.get i).2.1 := funext fun i => MonoidHom.ext (hσ i)
  obtain rfl : σ' = fun i => brauerChr (L.get i).2.2 := funext fun i => MonoidHom.ext (hσ' i)
  have hI : ∀ x ∈ L,
      (FiniteDimensional k (EllipticRootNumber.indSpace x.1 (brauerChr (k := k) x.2.1)) ∧
        ∀ g ∈ K0, EllipticRootNumber.indRep x.1 (brauerChr (k := k) x.2.1) g =
          ((ω g : kˣ) : k) • LinearMap.id) ∧
      (FiniteDimensional k (EllipticRootNumber.indSpace x.1 (brauerChr (k := k) x.2.2)) ∧
        ∀ g ∈ K0, EllipticRootNumber.indRep x.1 (brauerChr (k := k) x.2.2) g =
          ((ω g : kˣ) : k) • LinearMap.id) := fun x hx =>
    ⟨indRep_char_finiteDimensional_scalar K0 ω x.1 (hmem x hx).1 x.2.1
        (fun t ht => ((hmem x hx).2 t ht).1) _ (fun _ => rfl),
      indRep_char_finiteDimensional_scalar K0 ω x.1 (hmem x hx).1 x.2.2
        (fun t ht => ((hmem x hx).2 t ht).2) _ (fun _ => rfl)⟩
  haveI hfin : ∀ i, FiniteDimensional k
      (EllipticRootNumber.indSpace (L.get i).1 (brauerChr (k := k) (L.get i).2.1)) :=
    fun i => (hI _ (List.get_mem L i)).1.1
  haveI hfin' : ∀ i, FiniteDimensional k
      (EllipticRootNumber.indSpace (L.get i).1 (brauerChr (k := k) (L.get i).2.2)) :=
    fun i => (hI _ (List.get_mem L i)).2.1
  
  have hpiRep : ∀ {n : ℕ} {A : Fin n → Type u} [∀ i, AddCommGroup (A i)] [∀ i, Module k (A i)]
      (α : ∀ i, Representation k G (A i)), ∃ τ : Representation k G (∀ i, A i),
        ∀ g, τ g = LinearMap.pi fun i => α i g ∘ₗ LinearMap.proj i := by
    intro n A _ _ α
    refine ⟨{ toFun := fun g => LinearMap.pi fun i => α i g ∘ₗ LinearMap.proj i,
              map_one' := ?_, map_mul' := ?_ }, fun g => rfl⟩
    · apply LinearMap.ext; intro x; funext i; simp
    · intro g g'; apply LinearMap.ext; intro x; funext i; simp
  have hprodRep : ∀ {A B : Type u} [AddCommGroup A] [Module k A] [AddCommGroup B] [Module k B]
      (α : Representation k G A) (β : Representation k G B), ∃ τ : Representation k G (A × B),
        ∀ g, τ g = (α g).prodMap (β g) := by
    intro A B _ _ _ _ α β
    refine ⟨{ toFun := fun g => (α g).prodMap (β g), map_one' := ?_, map_mul' := ?_ },
      fun g => rfl⟩
    · apply LinearMap.ext; intro x; simp
    · intro g g'; apply LinearMap.ext; intro x; simp
  obtain ⟨ωr, hωr⟩ : ∃ ωr : Representation k G (ULift.{u} k),
      ∀ g, ωr g = ((ω g : kˣ) : k) • LinearMap.id := ⟨brauerChr ω, fun _ => rfl⟩
  obtain ⟨τP, hτP⟩ := hpiRep fun i =>
    EllipticRootNumber.indRep (L.get i).1 (brauerChr (k := k) (L.get i).2.1)
  obtain ⟨τP', hτP'⟩ := hpiRep fun i =>
    EllipticRootNumber.indRep (L.get i).1 (brauerChr (k := k) (L.get i).2.2)
  obtain ⟨τ2, hτ2⟩ := hpiRep fun _ : Fin 2 => ωr
  obtain ⟨τX, hτX⟩ := hprodRep ρ τP'
  obtain ⟨τY, hτY⟩ := hprodRep τP τ2
  
  have hωrs : ∀ g ∈ K0, ωr g = ((ω g : kˣ) : k) • LinearMap.id := fun g _ => hωr g
  have hτPs : ∀ g ∈ K0, τP g = ((ω g : kˣ) : k) • LinearMap.id := by
    intro g hg
    rw [hτP g]
    apply LinearMap.ext; intro x; funext i
    change (EllipticRootNumber.indRep _ _ g) (x i) = ((ω g : kˣ) : k) • x i
    rw [(hI _ (List.get_mem L i)).1.2 g hg]
    rfl
  have hτP's : ∀ g ∈ K0, τP' g = ((ω g : kˣ) : k) • LinearMap.id := by
    intro g hg
    rw [hτP' g]
    apply LinearMap.ext; intro x; funext i
    change (EllipticRootNumber.indRep _ _ g) (x i) = ((ω g : kˣ) : k) • x i
    rw [(hI _ (List.get_mem L i)).2.2 g hg]
    rfl
  have hτ2s : ∀ g ∈ K0, τ2 g = ((ω g : kˣ) : k) • LinearMap.id := by
    intro g _
    rw [hτ2 g]
    apply LinearMap.ext; intro x; funext i
    simp [hωr g]
  have hprods : ∀ {A B : Type u} [AddCommGroup A] [Module k A] [AddCommGroup B] [Module k B]
      (α : Representation k G A) (β : Representation k G B) (γ : Representation k G (A × B)),
      (∀ g, γ g = (α g).prodMap (β g)) →
      (∀ g ∈ K0, α g = ((ω g : kˣ) : k) • LinearMap.id) →
      (∀ g ∈ K0, β g = ((ω g : kˣ) : k) • LinearMap.id) →
      ∀ g ∈ K0, γ g = ((ω g : kˣ) : k) • LinearMap.id := by
    intro A B _ _ _ _ α β γ hγ hα hβ g hg
    rw [hγ g, hα g hg, hβ g hg]
    apply LinearMap.ext; intro x; simp
  have hτXs := hprods ρ τP' τX hτX hscal hτP's
  have hτYs := hprods τP τ2 τY hτY hτPs hτ2s
  
  have hdimEq : ∀ {T₀ : Type u} [AddCommGroup T₀] [Module k T₀] [FiniteDimensional k T₀]
      (σT : Representation k G T₀), (∀ g ∈ K0, σT g = ((ω g : kˣ) : k) • LinearMap.id) →
      Module.finrank k (σT.IntertwiningMap τX) = Module.finrank k (σT.IntertwiningMap τY) := by
    intro T₀ _ _ _ σT _
    have hadd := @finrank_intertwining_additive k _ _ G _ K0 _ _ ω T₀ _ _ _ σT
    have hsplit : ∀ {A B : Type u} [AddCommGroup A] [Module k A] [AddCommGroup B] [Module k B]
        [FiniteDimensional k A] [FiniteDimensional k B]
        (α : Representation k G A) (β : Representation k G B) (γ : Representation k G (A × B)),
        (∀ g, γ g = (α g).prodMap (β g)) →
        (∀ g ∈ K0, α g = ((ω g : kˣ) : k) • LinearMap.id) →
        (∀ g ∈ K0, β g = ((ω g : kˣ) : k) • LinearMap.id) →
        Module.finrank k (σT.IntertwiningMap γ) =
          Module.finrank k (σT.IntertwiningMap α) + Module.finrank k (σT.IntertwiningMap β) := by
      intro A B _ _ _ _ _ _ α β γ hγ hα hβ
      refine hadd α γ β hα (hprods α β γ hγ hα hβ) hβ (LinearMap.inl k A B) (LinearMap.snd k A B)
        ?_ ?_ LinearMap.inl_injective LinearMap.snd_surjective (LinearMap.range_inl k A B)
      · intro g; rw [hγ g]; apply LinearMap.ext; intro x; simp
      · intro g; rw [hγ g]; apply LinearMap.ext; intro x; simp
    have hX := hsplit ρ τP' τX hτX hscal hτP's
    have hY := hsplit τP τ2 τY hτY hτPs hτ2s
    have hP := finrank_intertwining_pi σT _ τP hτP
    have hP' := finrank_intertwining_pi σT _ τP' hτP'
    have h2 := finrank_intertwining_pi σT _ τ2 hτ2
    simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul] at h2
    
    have u2 : (2 : k) ≠ 0 := two_ne_zero
    have hinj : ∀ m n : ℕ, (Units.mk0 (2 : k) u2) ^ m = (Units.mk0 (2 : k) u2) ^ n → m = n := by
      intro m n hmn
      have h' := congrArg Units.val hmn
      simp only [Units.val_pow_eq_pow_val, Units.val_mk0] at h'
      exact Nat.pow_right_injective le_rfl (by exact_mod_cast h')
    have hsol : ∀ {W : Type u} [AddCommGroup W] [Module k W] [FiniteDimensional k W]
        (σ : Representation k G W), (∀ g ∈ K0, σ g = ((ω g : kˣ) : k) • LinearMap.id) →
        Module.finrank k (σT.IntertwiningMap σ) +
          (Lm.map fun S => Module.finrank k (σT.IntertwiningMap (σ.tprod
            (EllipticRootNumber.indRep S (Representation.trivial k S (ULift.{u} k)))))).sum =
        (Lp.map fun S => Module.finrank k (σT.IntertwiningMap (σ.tprod
            (EllipticRootNumber.indRep S (Representation.trivial k S (ULift.{u} k)))))).sum := by
      intro W _ _ _ σ hσ
      obtain ⟨h1, h2⟩ := hadd_tprod_of_hadd K0 ω
        (fun τ => Module.finrank k (σT.IntertwiningMap τ)) hadd σ hσ
      have hR := hrel (fun τ => (Units.mk0 (2 : k) u2) ^
          Module.finrank k (σT.IntertwiningMap (σ.tprod τ))) (by
        intro X₁ X X₂ _ _ _ _ _ _ _ _ _ τ₁ τ τ₂ k1 k0 k2 f q hf hq hi hs he
        show (Units.mk0 (2 : k) u2) ^ _ = (Units.mk0 (2 : k) u2) ^ _ * (Units.mk0 (2 : k) u2) ^ _
        rw [h1 τ₁ τ τ₂ k1 k0 k2 f q hf hq hi hs he, pow_add])
      have hpl : ∀ l : List (Subgroup G),
          (l.map fun S => (Units.mk0 (2 : k) u2) ^ Module.finrank k (σT.IntertwiningMap (σ.tprod
            (EllipticRootNumber.indRep S (Representation.trivial k S (ULift.{u} k)))))).prod =
          (Units.mk0 (2 : k) u2) ^ (l.map fun S => Module.finrank k (σT.IntertwiningMap (σ.tprod
            (EllipticRootNumber.indRep S (Representation.trivial k S (ULift.{u} k)))))).sum := by
        intro l
        induction l with
        | nil => simp
        | cons a l ih => simp only [List.map_cons, List.prod_cons, List.sum_cons, pow_add, ih]
      rw [hpl, hpl, ← pow_add, h2] at hR
      exact hinj _ _ hR
    have hSρ := hsol ρ hscal
    have hSω := hsol ωr hωrs
    
    have hloc : ∀ S ∈ Lp ++ Lm,
        Module.finrank k (σT.IntertwiningMap (ρ.tprod
            (EllipticRootNumber.indRep S (Representation.trivial k S (ULift.{u} k))))) +
          (Module.finrank k (σT.IntertwiningMap
              (EllipticRootNumber.indRep (T₁ S) (brauerChr (k := k) (θ₁' S)))) +
            Module.finrank k (σT.IntertwiningMap
              (EllipticRootNumber.indRep (T₂ S) (brauerChr (k := k) (θ₂' S))))) =
        2 * Module.finrank k (σT.IntertwiningMap (ωr.tprod
            (EllipticRootNumber.indRep S (Representation.trivial k S (ULift.{u} k))))) +
          (Module.finrank k (σT.IntertwiningMap
              (EllipticRootNumber.indRep (T₁ S) (brauerChr (k := k) (θ₁ S)))) +
            Module.finrank k (σT.IntertwiningMap
              (EllipticRootNumber.indRep (T₂ S) (brauerChr (k := k) (θ₂ S))))) := by
      intro S hS
      have := (hD S hS).2.2.2.2 (fun τ => Module.finrank k (σT.IntertwiningMap τ)) hadd ωr hωr
        (brauerChr (θ₁ S)) (brauerChr (θ₁' S)) (brauerChr (θ₂ S)) (brauerChr (θ₂' S))
        (fun _ => rfl) (fun _ => rfl) (fun _ => rfl) (fun _ => rfl)
      beta_reduce at this
      omega
    obtain ⟨P, hPd⟩ : ∃ P : Subgroup G → ℕ, P = fun S =>
        Module.finrank k (σT.IntertwiningMap (ρ.tprod
          (EllipticRootNumber.indRep S (Representation.trivial k S (ULift.{u} k))))) := ⟨_, rfl⟩
    obtain ⟨Q, hQd⟩ : ∃ Q : Subgroup G → ℕ, Q = fun S =>
        Module.finrank k (σT.IntertwiningMap (ωr.tprod
          (EllipticRootNumber.indRep S (Representation.trivial k S (ULift.{u} k))))) := ⟨_, rfl⟩
    obtain ⟨X, hXd⟩ : ∃ X : Subgroup G → ℕ, X = fun S =>
        Module.finrank k (σT.IntertwiningMap
          (EllipticRootNumber.indRep (T₁ S) (brauerChr (k := k) (θ₁ S)))) +
        Module.finrank k (σT.IntertwiningMap
          (EllipticRootNumber.indRep (T₂ S) (brauerChr (k := k) (θ₂ S)))) := ⟨_, rfl⟩
    obtain ⟨X', hX'd⟩ : ∃ X' : Subgroup G → ℕ, X' = fun S =>
        Module.finrank k (σT.IntertwiningMap
          (EllipticRootNumber.indRep (T₁ S) (brauerChr (k := k) (θ₁' S)))) +
        Module.finrank k (σT.IntertwiningMap
          (EllipticRootNumber.indRep (T₂ S) (brauerChr (k := k) (θ₂' S)))) := ⟨_, rfl⟩
    obtain ⟨Ψa, hΨa⟩ : ∃ Ψ : (Σ T : Subgroup G, (T →* kˣ) × (T →* kˣ)) → ℕ, Ψ = fun x =>
        Module.finrank k (σT.IntertwiningMap
          (EllipticRootNumber.indRep x.1 (brauerChr (k := k) x.2.1))) := ⟨_, rfl⟩
    obtain ⟨Ψb, hΨb⟩ : ∃ Ψ : (Σ T : Subgroup G, (T →* kˣ) × (T →* kˣ)) → ℕ, Ψ = fun x =>
        Module.finrank k (σT.IntertwiningMap
          (EllipticRootNumber.indRep x.1 (brauerChr (k := k) x.2.2))) := ⟨_, rfl⟩
    have hloc' : ∀ S ∈ Lp ++ Lm, P S + X' S = 2 * Q S + X S := by
      intro S hS
      subst hPd hQd hXd hX'd
      exact hloc S hS
    have hsumgen : ∀ l : List (Subgroup G), (∀ S ∈ l, S ∈ Lp ++ Lm) →
        (l.map P).sum + (l.map X').sum = 2 * (l.map Q).sum + (l.map X).sum := by
      intro l hl
      induction l with
      | nil => simp
      | cons a l ih =>
        simp only [List.map_cons, List.sum_cons]
        have e1 := hloc' a (hl a (by simp))
        have e2 := ih (fun S hS => hl S (by simp [hS]))
        omega
    have hsp := hsumgen Lp (fun S hS => List.mem_append_left _ hS)
    have hsm := hsumgen Lm (fun S hS => List.mem_append_right _ hS)
    have hSρ' : Module.finrank k (σT.IntertwiningMap ρ) + (Lm.map P).sum = (Lp.map P).sum := by
      subst hPd; exact hSρ
    have hSω' : Module.finrank k (σT.IntertwiningMap ωr) + (Lm.map Q).sum = (Lp.map Q).sum := by
      subst hQd; exact hSω
    have hre : ∀ f : (Σ T : Subgroup G, (T →* kˣ) × (T →* kˣ)) → ℕ,
        ∑ i, f (L.get i) = (L.map f).sum := by
      intro f
      rw [← List.sum_ofFn]
      conv_rhs => rw [← List.ofFn_get L, List.map_ofFn]
      rfl
    have hflat : ∀ (Ψ : (Σ T : Subgroup G, (T →* kˣ) × (T →* kˣ)) → ℕ)
        (F F' : Subgroup G → (Σ T : Subgroup G, (T →* kˣ) × (T →* kˣ))) (l : List (Subgroup G)),
        ((l.map fun S => [F S, F' S]).flatten.map Ψ).sum = (l.map fun S => Ψ (F S) + Ψ (F' S)).sum := by
      intro Ψ F F' l
      induction l with
      | nil => simp
      | cons a l ih =>
        simp only [List.map_cons, List.flatten_cons, List.map_append, List.sum_append, ih,
          List.sum_cons, List.map_nil, List.sum_nil]
        omega
    have hA : ∑ i, Module.finrank k (σT.IntertwiningMap
        (EllipticRootNumber.indRep (L.get i).1 (brauerChr (k := k) (L.get i).2.1))) =
        (Lp.map X).sum + (Lm.map X').sum := by
      have e1 : ∑ i, Module.finrank k (σT.IntertwiningMap
          (EllipticRootNumber.indRep (L.get i).1 (brauerChr (k := k) (L.get i).2.1))) =
          ∑ i, Ψa (L.get i) := by subst hΨa; rfl
      rw [e1, hre, hL, List.map_append, List.sum_append,
        hflat Ψa (fun S => ⟨T₁ S, θ₁ S, θ₁' S⟩) (fun S => ⟨T₂ S, θ₂ S, θ₂' S⟩) Lp,
        hflat Ψa (fun S => ⟨T₁ S, θ₁' S, θ₁ S⟩) (fun S => ⟨T₂ S, θ₂' S, θ₂ S⟩) Lm]
      subst hΨa hXd hX'd
      rfl
    have hB : ∑ i, Module.finrank k (σT.IntertwiningMap
        (EllipticRootNumber.indRep (L.get i).1 (brauerChr (k := k) (L.get i).2.2))) =
        (Lp.map X').sum + (Lm.map X).sum := by
      have e1 : ∑ i, Module.finrank k (σT.IntertwiningMap
          (EllipticRootNumber.indRep (L.get i).1 (brauerChr (k := k) (L.get i).2.2))) =
          ∑ i, Ψb (L.get i) := by subst hΨb; rfl
      rw [e1, hre, hL, List.map_append, List.sum_append,
        hflat Ψb (fun S => ⟨T₁ S, θ₁ S, θ₁' S⟩) (fun S => ⟨T₂ S, θ₂ S, θ₂' S⟩) Lp,
        hflat Ψb (fun S => ⟨T₁ S, θ₁' S, θ₁ S⟩) (fun S => ⟨T₂ S, θ₂' S, θ₂ S⟩) Lm]
      subst hΨb hXd hX'd
      rfl
    rw [hX, hY, hP, hP', hA, hB, h2]
    omega
  
  obtain ⟨e, he⟩ := linearEquiv_of_finrank_intertwining_eq K0 ω τX τY hτXs hτYs hdimEq
  refine ⟨e, fun g => ?_⟩
  have h' := he g
  rw [hτX g, hτY g, hτP' g, hτP g, hτ2 g, hωr g] at h'
  simpa only [LinearMap.smul_comp, LinearMap.id_comp] using h'

theorem ellAdicRep_threeRootsCurve_structure_dyadic (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    (t₁ t₂ t₃ : F) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃)
    (hE : EllipticRootNumber.IsPotentiallyGood F (threeRootsCurve t₁ t₂ t₃))
    (hp : EllipticRootNumber.p F = 2) :
    ((∀ w w' : EllipticRootNumber.relWeil F ⊥,
      ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
          (EllipticRootNumber.relWeil F ⊥).subtype) w *
        ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
          (EllipticRootNumber.relWeil F ⊥).subtype) w' =
      ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
          (EllipticRootNumber.relWeil F ⊥).subtype) w' *
        ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
          (EllipticRootNumber.relWeil F ⊥).subtype) w) ∧
    ∃ M₀ : IntermediateField F (AlgebraicClosure F), FiniteDimensional F M₀ ∧
      EllipticRootNumber.IsAbelianExt F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M₀) ∧
      ∀ g : EllipticRootNumber.relWeil F ⊥, (g : EllipticRootNumber.AbsGal F) ∈ M₀.fixingSubgroup →
        (g : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
        ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
          (EllipticRootNumber.relWeil F ⊥).subtype) g = 1) ∨
    (∃ (n a b : ℕ) (M : Fin n → IntermediateField F (AlgebraicClosure F))
        (_ : ∀ i, FiniteDimensional F (M i))
        (χ χ' : ∀ i, EllipticRootNumber.relWeil F (M i) →* (EllipticRootNumber.Ω F)ˣ)
        (lam : Fin a → EllipticRootNumber.relWeil F ⊥ →* (EllipticRootNumber.Ω F)ˣ)
        (μ : Fin b → EllipticRootNumber.relWeil F ⊥ →* (EllipticRootNumber.Ω F)ˣ),
      (∀ i, EllipticRootNumber.IsWeilRep F (M i) (EllipticRootNumber.charRep F (M i) (χ i))) ∧
      (∀ i, EllipticRootNumber.IsWeilRep F (M i) (EllipticRootNumber.charRep F (M i) (χ' i))) ∧
      (∀ j, EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ (lam j))) ∧
      (∀ k, EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ (μ k))) ∧
      (∀ i, ∃ (N : IntermediateField F (AlgebraicClosure F)) (_ : FiniteDimensional F N) (hMN : M i ≤ N),
        EllipticRootNumber.IsAbelianExt F hMN ∧
        ∀ g : EllipticRootNumber.relWeil F (M i), (g : EllipticRootNumber.AbsGal F) ∈ N.fixingSubgroup →
          (g : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → χ i g = 1 ∧ χ' i g = 1) ∧
      (∃ (N : IntermediateField F (AlgebraicClosure F)) (_ : FiniteDimensional F N),
        EllipticRootNumber.IsAbelianExt F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ N) ∧
        ∀ g : EllipticRootNumber.relWeil F ⊥, (g : EllipticRootNumber.AbsGal F) ∈ N.fixingSubgroup →
          (g : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
          (∀ j, lam j g = 1) ∧ (∀ k, μ k g = 1)) ∧
      ∃ e : ((EllipticRootNumber.VBar F (threeRootsCurve t₁ t₂ t₃) ×
