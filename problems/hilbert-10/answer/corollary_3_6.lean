  refine ⟨T₀ ∪ Finset.univ.biUnion F, Finset.subset_union_left, ?_⟩
  have hP : ∀ c (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v.asIdeal ∣ (J c : Ideal (NumberField.RingOfIntegers K)) →
        v ∈ T₀ ∪ Finset.univ.biUnion F := by
    intro c v hv
    refine Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨c, Finset.mem_univ _, ?_⟩)
    exact (Set.Finite.mem_toFinset _).mpr hv
  intro q hq
  have hqne : q.asIdeal ≠ 0 := q.ne_bot
  have hQ : q.asIdeal ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
    mem_nonZeroDivisors_of_ne_zero hqne
  let Q : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) := ⟨q.asIdeal, hQ⟩
  obtain ⟨c, hc⟩ : ∃ c, c = (ClassGroup.mk0 Q)⁻¹ := ⟨_, rfl⟩
  have hprod : ClassGroup.mk0 (Q * J c) = 1 := by
    rw [map_mul, hJ, hc, mul_inv_cancel]
  have hprin : Submodule.IsPrincipal
      (q.asIdeal * (J c : Ideal (NumberField.RingOfIntegers K))) :=
    (ClassGroup.mk0_eq_one_iff (Q * J c).2).mp hprod
  obtain ⟨a, ha⟩ := hprin
  have haspan : q.asIdeal * (J c : Ideal (NumberField.RingOfIntegers K)) = Ideal.span {a} := ha
  have ha0 : a ≠ 0 := by
    rintro rfl
    rw [Ideal.span_singleton_eq_bot.mpr rfl] at haspan
    rcases mul_eq_zero.mp haspan with h | h
    · exact hqne h
    · exact hJne c h
  have hK : algebraMap (NumberField.RingOfIntegers K) K a ≠ 0 := by
    intro h
    apply ha0
    exact (IsFractionRing.injective _ K) (by rw [h, map_zero])
  have hV : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ((v.valuationOfNeZero (Units.mk0 _ hK) : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) =
        v.intValuation a := by
    intro v
    rw [IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq, Units.val_mk0,
      IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap]
  refine ⟨Units.mk0 _ hK, ?_, ?_⟩
  · have hm : q.intValuation a =
        WithZero.exp (Multiplicative.toAdd (q.valuationOfNeZero (Units.mk0 _ hK))) := by
      rw [← hV q]
      rfl
    have h1 : q.intValuation a ≤ WithZero.exp (-((1 : ℕ) : ℤ)) :=
      (q.intValuation_le_pow_iff_dvd a 1).mpr (by rw [pow_one, ← haspan]; exact dvd_mul_right _ _)
    have h2 : ¬ q.intValuation a ≤ WithZero.exp (-((2 : ℕ) : ℤ)) := by
      rw [q.intValuation_le_pow_iff_dvd a 2, ← haspan, sq]
      intro hd
      exact hq (hP c q ((mul_dvd_mul_iff_left hqne).mp hd))
    rw [hm, WithZero.exp_le_exp] at h1 h2
    push_cast at h1 h2
    omega
  · intro v hv hvq
    have hnd : ¬ v.asIdeal ∣ Ideal.span {a} := by
      rw [← haspan]
      intro hd
