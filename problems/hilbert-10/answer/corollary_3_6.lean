    intro L χ w w'
    apply LinearMap.ext
    intro v
    change (χ w : EllipticRootNumber.Ω F) • (χ w' : EllipticRootNumber.Ω F) • v =
      (χ w' : EllipticRootNumber.Ω F) • (χ w : EllipticRootNumber.Ω F) • v
    rw [smul_smul, smul_smul, mul_comm]
  by_cases hline : ∃ L : Submodule (EllipticRootNumber.Ω F)
      (EllipticRootNumber.VBar F (threeRootsCurve t₁ t₂ t₃)),
      Module.finrank (EllipticRootNumber.Ω F) L = 1 ∧
      ∀ w : EllipticRootNumber.relWeil F ⊥, ∀ v ∈ L,
        ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
          (EllipticRootNumber.relWeil F ⊥).subtype) w v ∈ L
  · 
    left
    have hcomm := weilRep_comm_of_stable_line F _ hW hdim hline
    obtain ⟨M₀, hM₀, hle, hab, hkill⟩ := weilRep_abTriv_of_comm F rec ⊥ _ hW hcomm
    exact ⟨hcomm, M₀, hM₀, hab, hkill⟩
  · 
    right
    obtain ⟨N, hNfin, hNnorm, hconj, ω, hωW, hscalW⟩ :=
      exists_scalar_twist_on_galois_subgroup F _ hW hdim hline
    haveI := hNfin
    haveI := hNnorm
    have hK0n : ((EllipticRootNumber.relWeil F N).subgroupOf
        (EllipticRootNumber.relWeil F ⊥)).Normal := by
      refine ⟨fun κ hκ g => ?_⟩
      rw [Subgroup.mem_subgroupOf] at hκ ⊢
      refine Subgroup.mem_inf.mpr ⟨EllipticRootNumber.relWeil_le_weilGroup F ⊥ (g * κ * g⁻¹).2, ?_⟩
