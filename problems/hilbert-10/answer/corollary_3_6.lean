by
  classical
  
  have hΔ : (threeRootsCurve t₁ t₂ t₃).Δ ≠ 0 := by
    have e : (threeRootsCurve t₁ t₂ t₃).Δ = 16 * ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) ^ 2 := by
      simp only [threeRootsCurve, WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
        WeierstrassCurve.b₆, WeierstrassCurve.b₈]
      ring
    rw [e]
    exact mul_ne_zero (by norm_num) (pow_ne_zero _ (mul_ne_zero (mul_ne_zero
      (sub_ne_zero.mpr h₁₂) (sub_ne_zero.mpr h₁₃)) (sub_ne_zero.mpr h₂₃)))
  have hW : EllipticRootNumber.IsWeilRep F ⊥
      ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
        (EllipticRootNumber.relWeil F ⊥).subtype) :=
    ⟨finiteDimensional_vBar_threeRootsCurve F t₁ t₂ t₃ h₁₂ h₁₃ h₂₃,
      ellAdicRep_threeRootsCurve_inertia F t₁ t₂ t₃ h₁₂ h₁₃ h₂₃ hE⟩
  have hdim := finrank_vBar_eq_two F (threeRootsCurve t₁ t₂ t₃) hΔ
  obtain ⟨rec⟩ := local_reciprocity F
  
  have hFDU : FiniteDimensional (EllipticRootNumber.Ω F) (ULift.{u} (EllipticRootNumber.Ω F)) :=
    Module.Finite.equiv ULift.moduleEquiv.symm
  have hval : ∀ (L : IntermediateField F (AlgebraicClosure F))
      (χ : EllipticRootNumber.relWeil F L →* (EllipticRootNumber.Ω F)ˣ)
      (g : EllipticRootNumber.relWeil F L),
      EllipticRootNumber.charRep F L χ g (ULift.up 1) = ULift.up 1 → χ g = 1 := by
    intro L χ g h
    have h2 := congrArg ULift.down h
    change (χ g : EllipticRootNumber.Ω F) * 1 = 1 at h2
    exact Units.ext (by simpa using h2)
  have hone : ∀ (L : IntermediateField F (AlgebraicClosure F))
      (χ : EllipticRootNumber.relWeil F L →* (EllipticRootNumber.Ω F)ˣ)
      (g : EllipticRootNumber.relWeil F L),
      χ g = 1 → EllipticRootNumber.charRep F L χ g = 1 := by
    intro L χ g h
    apply LinearMap.ext
    intro v
    change (χ g : EllipticRootNumber.Ω F) • v = v
    rw [h, Units.val_one, one_smul]
  have hcommChar : ∀ (L : IntermediateField F (AlgebraicClosure F))
      (χ : EllipticRootNumber.relWeil F L →* (EllipticRootNumber.Ω F)ˣ)
      (w w' : EllipticRootNumber.relWeil F L),
      EllipticRootNumber.charRep F L χ w * EllipticRootNumber.charRep F L χ w' =
