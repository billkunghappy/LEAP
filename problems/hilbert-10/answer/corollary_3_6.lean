        Nat.card (A ⊓ B' ⊓ C : Subgroup W) := by
      refine Nat.card_congr (Equiv.subtypeEquivRight (fun w => ?_))
      rw [Subgroup.mem_inf, Subgroup.mem_inf]
      constructor
      · intro hw
        refine ⟨⟨selfo A hA hAc w (fun t ht => hw t ?_), selfo B' hB hBc w (fun t ht => hw t ?_)⟩,
          selfo C hC hCc w (fun t ht => hw t ?_)⟩
        · exact Subgroup.mem_sup_left ht
        · exact Subgroup.mem_sup_right (Subgroup.mem_sup_left ht)
        · exact Subgroup.mem_sup_right (Subgroup.mem_sup_right ht)
      · rintro ⟨⟨hwA, hwB⟩, hwC⟩ h hh
        obtain ⟨a', ha', z, hz, rfl⟩ := Subgroup.mem_sup.mp hh
        obtain ⟨b', hb', c', hc', rfl⟩ := Subgroup.mem_sup.mp hz
        rw [Bmulr, Bmulr, hA w hwA a' ha', hB w hwB b' hb', hC w hwC c' hc', one_mul, one_mul]
    have e1 := orth (A ⊔ (B' ⊔ C))
    rw [hTo, hW] at e1
    have e2 := prodf A (B' ⊔ C)
    rw [hAc] at e2
    have e3 := prodf B' C
    rw [hBc, hCc] at e3
    have hTpos : 0 < Nat.card (A ⊔ (B' ⊔ C) : Subgroup W) := Nat.card_pos
    generalize Nat.card (A ⊔ (B' ⊔ C) : Subgroup W) = T at e1 e2 hTpos
    generalize Nat.card (A ⊓ (B' ⊔ C) : Subgroup W) = s at e2 ⊢
    generalize Nat.card (B' ⊔ C : Subgroup W) = u at e2 e3
    generalize Nat.card (B' ⊓ C : Subgroup W) = v at e3 ⊢
    generalize Nat.card (A ⊓ B' ⊓ C : Subgroup W) = I at e1 ⊢
    apply Nat.eq_of_mul_eq_mul_left hTpos
    calc T * (s * v) = (T * s) * v := by ring
      _ = 2 ^ m * (u * v) := by rw [e2]; ring
      _ = 2 ^ m * (T * I) := by rw [e3, e1]
      _ = T * (2 ^ m * I) := by ring
  
