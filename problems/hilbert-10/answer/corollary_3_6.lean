theorem weilRep_comm_of_stable_line (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {V : Type u} [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
    (ρ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V)
    (hW : EllipticRootNumber.IsWeilRep F ⊥ ρ)
    (hdim : Module.finrank (EllipticRootNumber.Ω F) V = 2)
    (hline : ∃ L : Submodule (EllipticRootNumber.Ω F) V, Module.finrank (EllipticRootNumber.Ω F) L = 1 ∧
      ∀ w : EllipticRootNumber.relWeil F ⊥, ∀ v ∈ L, ρ w v ∈ L) :
    ∀ w w' : EllipticRootNumber.relWeil F ⊥, ρ w * ρ w' = ρ w' * ρ w :=
by
  classical
  intro w w'
  obtain ⟨hfinV, U, hU, hUρ⟩ := hW
  obtain ⟨L, hL1, hLst⟩ := hline
  
  have hroot : ∀ (σ τ : EllipticRootNumber.AbsGal F) (ζ : AlgebraicClosure F) (n : ℕ),
      0 < n → ζ ^ n = 1 → σ (τ ζ) = τ (σ ζ) := by
    intro σ τ ζ n hn hζn
    have hpos : 0 < orderOf ζ := orderOf_pos_iff.mpr (isOfFinOrder_iff_pow_eq_one.mpr ⟨n, hn, hζn⟩)
    haveI : NeZero (orderOf ζ) := ⟨hpos.ne'⟩
    have hζu : IsPrimitiveRoot ζ (orderOf ζ) := IsPrimitiveRoot.orderOf ζ
    have hσ : (σ ζ) ^ orderOf ζ = 1 := by rw [← map_pow, pow_orderOf_eq_one, map_one]
    have hτ : (τ ζ) ^ orderOf ζ = 1 := by rw [← map_pow, pow_orderOf_eq_one, map_one]
    obtain ⟨i, -, hi⟩ := hζu.eq_pow_of_pow_eq_one hσ
    obtain ⟨j, -, hj⟩ := hζu.eq_pow_of_pow_eq_one hτ
    rw [← hi, ← hj, map_pow, map_pow, ← hi, ← hj, ← pow_mul, ← pow_mul, mul_comm]
  have hcI : ∀ σ τ : EllipticRootNumber.AbsGal F,
      σ * τ * σ⁻¹ * τ⁻¹ ∈ EllipticRootNumber.inertia F := by
    intro σ τ
    have key : ∀ ζ : AlgebraicClosure F, EllipticRootNumber.IsPrimeToPRootOfUnity F ζ →
        (σ * τ * σ⁻¹ * τ⁻¹) ζ = ζ := by
      rintro ζ ⟨n, hn, -, hζn⟩
      have hξ : (σ⁻¹ (τ⁻¹ ζ)) ^ n = 1 := by
        rw [← map_pow, ← map_pow, hζn, map_one, map_one]
      have h := hroot σ τ (σ⁻¹ (τ⁻¹ ζ)) n hn hξ
      simp only [AlgEquiv.mul_apply]
      rw [h]
      simp [AlgEquiv.aut_inv]
    have hle : EllipticRootNumber.unramifiedClosure F ≤
        IntermediateField.fixedField (Subgroup.zpowers (σ * τ * σ⁻¹ * τ⁻¹)) := by
      unfold EllipticRootNumber.unramifiedClosure
      rw [IntermediateField.adjoin_le_iff]
      intro ζ hζ
