        IsDedekindDomain.HeightOneSpectrum.valuation L v (a₂ - a₃) = 1
    · obtain ⟨hs, hh⟩ := phiSign_hilbTerm_good_odd a₁ a₂ a₃ v h2 hall.1 hall.2.1 hall.2.2
      rw [rootNumber_good_odd a₁ a₂ a₃ v h2 hall.1 hall.2.1 hall.2.2, hs, hh, mul_one]
    · rw [rootNumber_mult_odd a₁ a₂ a₃ h12 h13 h23 v h2 hα hβ hγ hall hnot,
