      (IntermediateField.extendScalars
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) := by
    have e : M ≃ₗ[F] (IntermediateField.extendScalars
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) :=
      { toFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars _).mpr y.2⟩
        invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars _).mp z.2⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }
    haveI : Module.Finite F (IntermediateField.extendScalars
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) := Module.Finite.equiv e
    exact Module.Finite.of_restrictScalars_finite F _ _
  
  have hTr : ∀ y : M, w (y : AlgebraicClosure F) ≤ 1 →
      w (((EllipticRootNumber.traceLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) y :
          (⊥ : IntermediateField F (AlgebraicClosure F))) : AlgebraicClosure F)) ≤ 1 := by
    intro y hy
    have hsum := trace_eq_sum_embeddings (K := (⊥ : IntermediateField F (AlgebraicClosure F)))
      (L := IntermediateField.extendScalars
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) (AlgebraicClosure F)
      (x := EllipticRootNumber.toExtendScalars F bot_le y)
    have hcoe : (((EllipticRootNumber.traceLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) y :
          (⊥ : IntermediateField F (AlgebraicClosure F))) : AlgebraicClosure F)) =
        algebraMap (⊥ : IntermediateField F (AlgebraicClosure F)) (AlgebraicClosure F)
          (Algebra.trace (⊥ : IntermediateField F (AlgebraicClosure F))
            (IntermediateField.extendScalars
              (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))
            (EllipticRootNumber.toExtendScalars F bot_le y)) := rfl
    rw [hcoe, hsum]
    apply Valuation.map_sum_le
    intro σ _
    let σM : M →ₐ[F] AlgebraicClosure F :=
      { toRingHom := (σ : (IntermediateField.extendScalars
            (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) →+*
              AlgebraicClosure F).comp (EllipticRootNumber.toExtendScalars F bot_le)
        commutes' := fun a => by
          have ha : EllipticRootNumber.toExtendScalars F
              (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) (algebraMap F M a) =
              algebraMap (⊥ : IntermediateField F (AlgebraicClosure F))
                (IntermediateField.extendScalars
                  (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))
                (algebraMap F (⊥ : IntermediateField F (AlgebraicClosure F)) a) := rfl
          show σ (EllipticRootNumber.toExtendScalars F bot_le (algebraMap F M a)) = _
          rw [ha, AlgHom.commutes]
          exact (IsScalarTower.algebraMap_apply F (⊥ : IntermediateField F (AlgebraicClosure F))
            (AlgebraicClosure F) a).symm }
    let τ₀ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F := σM.liftNormal (AlgebraicClosure F)
    have hτ₀ : τ₀ (y : AlgebraicClosure F) = σ (EllipticRootNumber.toExtendScalars F bot_le y) :=
