          EllipticRootNumber.valL F L y → φ (y * (ε : L)) = φ y := by
      intro ε hε
      unfold EllipticRootNumber.unitGroup at hε
      induction hε using Subgroup.closure_induction with
      | mem v hv =>
        intro y hy
        rw [Set.mem_setOf_eq, if_neg h0] at hv
        by_cases hv1 : (v : L) = 1
        · rw [hv1, mul_one]
        by_cases hy0 : y = 0
        · rw [hy0, zero_mul]
