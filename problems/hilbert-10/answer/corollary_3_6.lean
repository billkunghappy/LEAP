    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro m hm
    have hval := DFunLike.congr_fun hcc ⟨m, hm⟩
    have hval' : ((Quotient.out c : EllipticRootNumber.relWeil F L) :
