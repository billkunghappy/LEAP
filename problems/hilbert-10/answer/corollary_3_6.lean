        (∀ (N : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F N] (h : M ≤ N),
          IsAbelianExt F h → (r : AbsGal F)⁻¹ * (VW : AbsGal F) ∈ N.fixingSubgroup) →
        θM r = θM VW := by
      intro VW hdegV hN
      have hzI : ((r⁻¹ * VW : relWeil F M) : AbsGal F) ∈ inertia F := by
        apply weilDegreeHom_ker_le_inertia F
          (Subgroup.inclusion (relWeil_le_weilGroup F M) (r⁻¹ * VW))
        have hf : ∀ w : relWeil F M,
            weilDegreeHom F (Subgroup.inclusion (relWeil_le_weilGroup F M) w) =
              ((weilDegreeHom F).comp (Subgroup.inclusion (relWeil_le_weilGroup F M))) w :=
          fun _ => rfl
        rw [hf, map_mul, map_inv, ← hf, ← hf, hdeg_r, hdegV, inv_one, one_mul]
      have hθz := dens M θM WθM (r⁻¹ * VW) hzI (fun N _ h hab => hN N h hab)
      rw [map_mul, map_inv, inv_mul_eq_one] at hθz
      exact hθz
    by_cases hgm : (g : AbsGal F) ∈ M.fixingSubgroup
    · have hgH : g ∈ (relWeil F M).subgroupOf (relWeil F ⊥) := (memH g).mpr hgm
      have htg : ((t * g * t⁻¹ : relWeil F ⊥) : AbsGal F) ∈ M.fixingSubgroup := by
        have h1 : (t : AbsGal F) * g ∉ M.fixingSubgroup := by
          intro h
          apply htM
          have h2 := M.fixingSubgroup.mul_mem h (M.fixingSubgroup.inv_mem hgm)
          simpa using h2
        exact hG2 _ _ h1 htM
      have hh'H : t * g * t⁻¹ ∈ (relWeil F M).subgroupOf (relWeil F ⊥) := (memH _).mpr htg
      let gH : (relWeil F M).subgroupOf (relWeil F ⊥) := ⟨g, hgH⟩
      let h'H : (relWeil F M).subgroupOf (relWeil F ⊥) := ⟨t * g * t⁻¹, hh'H⟩
      have hdetgh := hdetH gH h'H rfl
      have hθV : θM (eH (gH * h'H)) = 1 := by
        rw [hθM, map_mul]
        apply Units.ext
        rw [Units.val_mul, Units.val_one, ← hdetgh]
        exact hdg
      have hdegV : weilDegreeHom F
          (Subgroup.inclusion (relWeil_le_weilGroup F M) (eH (gH * h'H))) = 1 := by
        have e0 : Subgroup.inclusion (relWeil_le_weilGroup F M) (eH (gH * h'H)) =
            Subgroup.inclusion (relWeil_le_weilGroup F ⊥) g *
              (Subgroup.inclusion (relWeil_le_weilGroup F ⊥) t *
                Subgroup.inclusion (relWeil_le_weilGroup F ⊥) g *
                (Subgroup.inclusion (relWeil_le_weilGroup F ⊥) t)⁻¹) := Subtype.ext rfl
        rw [e0]
        simp only [map_mul, map_inv, hdeg_g, one_mul, mul_one, mul_inv_cancel]
      have hrV := hzθ (eH (gH * h'H)) hdegV (fun N _ h hab =>
        (recMap_transfer_quadratic F rec M hM N h hab (t : AbsGal F)
          (relWeil_le_weilGroup F ⊥ t.2) htM b).1 hgm)
      show ((η g : (Ω F)ˣ) : Ω F) * ((θM r : (Ω F)ˣ) : Ω F) = 1
      rw [hηH g hgH, hrV, hθV, Units.val_one, one_mul]
    · have hgH : g ∉ (relWeil F M).subgroupOf (relWeil F ⊥) := fun h => hgm ((memH g).mp h)
      have hgg : ((g * g : relWeil F ⊥) : AbsGal F) ∈ M.fixingSubgroup := by
        have h1 : (g : AbsGal F)⁻¹ ∉ M.fixingSubgroup := fun h =>
          hgm (by simpa using M.fixingSubgroup.inv_mem h)
        have h2 := hG2 _ _ hgm h1
        simpa using h2
      have hggH : g * g ∈ (relWeil F M).subgroupOf (relWeil F ⊥) := (memH _).mpr hgg
      let ggH : (relWeil F M).subgroupOf (relWeil F ⊥) := ⟨g * g, hggH⟩
      have hdetgg := hdetN g ggH hgH rfl
      have hθV : θM (eH ggH) = -1 := by
        rw [hθM]
        apply Units.ext
        rw [Units.val_neg, Units.val_one]
        rw [hdg] at hdetgg
        linear_combination hdetgg
      have hdegV : weilDegreeHom F
          (Subgroup.inclusion (relWeil_le_weilGroup F M) (eH ggH)) = 1 := by
        have e0 : Subgroup.inclusion (relWeil_le_weilGroup F M) (eH ggH) =
            Subgroup.inclusion (relWeil_le_weilGroup F ⊥) g *
              Subgroup.inclusion (relWeil_le_weilGroup F ⊥) g := Subtype.ext rfl
        rw [e0]
        simp only [map_mul, hdeg_g, one_mul]
      have hrV := hzθ (eH ggH) hdegV (fun N _ h hab =>
        (recMap_transfer_quadratic F rec M hM N h hab (t : AbsGal F)
          (relWeil_le_weilGroup F ⊥ t.2) htM b).2 hgm)
      show ((η g : (Ω F)ˣ) : Ω F) * ((θM r : (Ω F)ˣ) : Ω F) = 1
      rw [hηN g hgH, hrV, hθV]
      simp
  
  have K1 := key ψ hψ
  have K2 := key ψ' hψ'
  rw [T1, T2, T3, T4] at K2
  have hX : tateEps F M 1 (traceChar F hbot ψ) ≠ 0 := by
    rw [← lc.eps_char M (traceChar F hbot ψ) hψMA 1 W1M 1 (fun _ => rfl)]
    exact Units.ne_zero _
  apply Units.ext
  apply mul_right_cancel₀ hX
  linear_combination K1 - K2 -
    (tateEps F ⊥ 1 ψ * tateEps F ⊥ η' ψ * tateEps F M θ' (traceChar F hbot ψ)) * hηθ

theorem exists_global_unit_addChar_twist (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (ψ ψ' : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F))
    (hψ : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1)
    (hψ' : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ' x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ' x ≠ 1) :
    ∃ b : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      EllipticRootNumber.valL F ⊥ (b : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 ∧
      ∀ y, ψ' y = ψ (b * y) :=
by
  classical
  
  have key : ∀ (z : WithZero (Multiplicative ℤ)) (hz : z ≠ 0),
      Multiplicative.toAdd (WithZero.unzero hz) = WithZero.log z := by
    intro z hz
    obtain ⟨u, rfl⟩ := WithZero.ne_zero_iff_exists.mp hz
    rw [WithZero.unzero_coe]
    show _ = WithZero.log (WithZero.exp (Multiplicative.toAdd u))
    rw [WithZero.log_exp]
  have hne : ∀ c : F, c ≠ 0 →
      IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (ValuativeRel.valuation F c) ≠ 0 :=
    fun c hc => (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hc)
  have s1 : ∀ c : F, c ≠ 0 → EllipticRootNumber.addVal F c =
      -WithZero.log (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
        (ValuativeRel.valuation F c)) := by
    intro c hc
    unfold EllipticRootNumber.addVal
    rw [dif_neg hc, key]
  have s0 : EllipticRootNumber.addVal F 0 = 0 := by
    unfold EllipticRootNumber.addVal
    rw [dif_pos rfl]
  have s4 : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.relVal F ⊥ x =
        EllipticRootNumber.addVal F (IntermediateField.botEquiv F (AlgebraicClosure F) x) := by
    intro x
    unfold EllipticRootNumber.relVal
    congr 1
    have hx : x = algebraMap F (⊥ : IntermediateField F (AlgebraicClosure F))
        (IntermediateField.botEquiv F (AlgebraicClosure F) x) := by
      rw [← IntermediateField.botEquiv_symm, AlgEquiv.symm_apply_apply]
    conv_lhs => rw [hx]
    rw [Algebra.norm_algebraMap, IntermediateField.finrank_bot, pow_one]
  have s2 : ∀ c d : F, c ≠ 0 → d ≠ 0 → EllipticRootNumber.addVal F (c * d) =
      EllipticRootNumber.addVal F c + EllipticRootNumber.addVal F d := by
    intro c d hc hd
    rw [s1 _ (mul_ne_zero hc hd), s1 _ hc, s1 _ hd, map_mul, map_mul,
      WithZero.log_mul (hne c hc) (hne d hd), neg_add]
  have s3 : ∃ c : F, c ≠ 0 ∧ EllipticRootNumber.addVal F c = 1 := by
    obtain ⟨γ, hγ⟩ := (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).surjective
      (WithZero.exp (-1 : ℤ))
    obtain ⟨c, hc⟩ := ValuativeRel.valuation_surjective γ
    have hc0 : c ≠ 0 := by
      intro h
      apply WithZero.exp_ne_zero (a := (-1 : ℤ))
      rw [← hγ, ← hc, h, map_zero, map_zero]
    refine ⟨c, hc0, ?_⟩
    have hγ' : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F γ =
        WithZero.exp (-1 : ℤ) := hγ
    rw [s1 c hc0, hc, hγ', WithZero.log_exp, neg_neg]
  have hres : EllipticRootNumber.resDeg F ⊥ = 1 := by
    obtain ⟨c, hc0, hc1⟩ := s3
    have h3 : EllipticRootNumber.relVal F ⊥
        ((IntermediateField.botEquiv F (AlgebraicClosure F)).symm c) = 1 := by
      rw [s4, AlgEquiv.apply_symm_apply, hc1]
    have hx0 : (IntermediateField.botEquiv F (AlgebraicClosure F)).symm c ≠ 0 :=
      (map_ne_zero_iff _ (IntermediateField.botEquiv F (AlgebraicClosure F)).symm.injective).mpr hc0
    unfold EllipticRootNumber.resDeg
    have hmem : 1 ∈ {k : ℕ | 0 < k ∧ ∃ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
        x ≠ 0 ∧ EllipticRootNumber.relVal F ⊥ x = k} :=
      ⟨one_pos, _, hx0, h3.trans Nat.cast_one.symm⟩
    apply le_antisymm (Nat.sInf_le hmem)
    exact (Nat.sInf_mem ⟨1, hmem⟩).1
  have hvr : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x = EllipticRootNumber.relVal F ⊥ x := by
    intro x
    unfold EllipticRootNumber.valL
    rw [hres, Nat.cast_one, Int.ediv_one]
  have hv : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ x =
        EllipticRootNumber.addVal F (IntermediateField.botEquiv F (AlgebraicClosure F) x) := by
    intro x
    rw [hvr, s4]
  have hβne : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)), x ≠ 0 →
      IntermediateField.botEquiv F (AlgebraicClosure F) x ≠ 0 := fun x hx =>
    (map_ne_zero_iff _ (IntermediateField.botEquiv F (AlgebraicClosure F)).injective).mpr hx
  have V0 : EllipticRootNumber.valL F ⊥ (0 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
    rw [hv, map_zero, s0]
  have V1 : EllipticRootNumber.valL F ⊥ (1 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
    rw [hv, map_one, s1 _ one_ne_zero, map_one, map_one, WithZero.log_one, neg_zero]
  have V2 : ∀ x y : (⊥ : IntermediateField F (AlgebraicClosure F)), x ≠ 0 → y ≠ 0 →
      EllipticRootNumber.valL F ⊥ (x * y) =
        EllipticRootNumber.valL F ⊥ x + EllipticRootNumber.valL F ⊥ y := by
    intro x y hx hy
    rw [hv, hv, hv, map_mul, s2 _ _ (hβne x hx) (hβne y hy)]
  have V4 : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)),
      EllipticRootNumber.valL F ⊥ (-x) = EllipticRootNumber.valL F ⊥ x := by
    intro x
    by_cases hx : x = 0
    · rw [hx, neg_zero]
    rw [hv, hv, map_neg, s1 _ (neg_ne_zero.mpr (hβne x hx)), s1 _ (hβne x hx),
      Valuation.map_neg]
  have V3 : ∀ x y : (⊥ : IntermediateField F (AlgebraicClosure F)), x ≠ 0 → y ≠ 0 → x + y ≠ 0 →
      min (EllipticRootNumber.valL F ⊥ x) (EllipticRootNumber.valL F ⊥ y) ≤
        EllipticRootNumber.valL F ⊥ (x + y) := by
    intro x y hx hy hxy
    have ha := hβne x hx
    have hb := hβne y hy
    have hab : IntermediateField.botEquiv F (AlgebraicClosure F) x +
        IntermediateField.botEquiv F (AlgebraicClosure F) y ≠ 0 := by
      rw [← map_add]; exact hβne _ hxy
    rw [hv, hv, hv, map_add, s1 _ ha, s1 _ hb, s1 _ hab]
    have hle := Valuation.map_add (ValuativeRel.valuation F)
      (IntermediateField.botEquiv F (AlgebraicClosure F) x)
      (IntermediateField.botEquiv F (AlgebraicClosure F) y)
    rcases le_total (ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) x))
        (ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) y)) with h | h
    · have h1 := hle.trans (max_le h le_rfl)
      have h2 := (map_le_map_iff (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F)).mpr h1
      have h3 := (WithZero.log_le_log (hne _ hab) (hne _ hb)).mpr h2
      exact (min_le_right _ _).trans (neg_le_neg h3)
    · have h1 := hle.trans (max_le le_rfl h)
      have h2 := (map_le_map_iff (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F)).mpr h1
      have h3 := (WithZero.log_le_log (hne _ hab) (hne _ ha)).mpr h2
      exact (min_le_left _ _).trans (neg_le_neg h3)
  have Vinv : ∀ x : (⊥ : IntermediateField F (AlgebraicClosure F)), x ≠ 0 →
      EllipticRootNumber.valL F ⊥ x⁻¹ = -EllipticRootNumber.valL F ⊥ x := by
    intro x hx
    have h := V2 x x⁻¹ hx (inv_ne_zero hx)
    rw [mul_inv_cancel₀ hx, V1] at h
    omega
  
  obtain ⟨π, hπ0, hπ⟩ : ∃ π : (⊥ : IntermediateField F (AlgebraicClosure F)),
      π ≠ 0 ∧ EllipticRootNumber.valL F ⊥ π = 1 := by
    obtain ⟨c, hc0, hc1⟩ := s3
    refine ⟨(IntermediateField.botEquiv F (AlgebraicClosure F)).symm c,
      (map_ne_zero_iff _ (IntermediateField.botEquiv F (AlgebraicClosure F)).symm.injective).mpr hc0,
      ?_⟩
    rw [hv, AlgEquiv.apply_symm_apply, hc1]
  have Vpow : ∀ n : ℕ, π ^ n ≠ 0 ∧ EllipticRootNumber.valL F ⊥ (π ^ n) = n := by
    intro n
    induction n with
    | zero => exact ⟨by rw [pow_zero]; exact one_ne_zero, by rw [pow_zero, V1]; rfl⟩
    | succ n ih =>
      refine ⟨by rw [pow_succ]; exact mul_ne_zero ih.1 hπ0, ?_⟩
      rw [pow_succ, V2 _ _ ih.1 hπ0, ih.2, hπ]
      push_cast
      ring
  
  suffices fin : ∀ a : ℕ, ∃ b : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      EllipticRootNumber.valL F ⊥ (b : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 ∧
      ∀ y : (⊥ : IntermediateField F (AlgebraicClosure F)),
        -(a : ℤ) ≤ EllipticRootNumber.valL F ⊥ y → ψ' y = ψ (b * y) by
    obtain ⟨x₀, hx₀v, hx₀ψ⟩ := hψ.2
    
    have hψne : ∀ t, ψ t ≠ 0 := by
      intro t h
      have h1 : ψ t * ψ (-t) = 1 := by
        rw [← AddChar.map_add_eq_mul, add_neg_cancel, AddChar.map_zero_eq_one]
      rw [h, zero_mul] at h1
      exact zero_ne_one h1
    
    have kb : ∀ (d : (⊥ : IntermediateField F (AlgebraicClosure F))) (n : ℕ),
        (∀ y, -(n : ℤ) ≤ EllipticRootNumber.valL F ⊥ y → ψ (d * y) = 1) →
        d = 0 ∨ (n : ℤ) ≤ EllipticRootNumber.valL F ⊥ d := by
      intro d n hd
      by_contra hcon
      push_neg at hcon
      obtain ⟨hd0, hlt⟩ := hcon
      have hx0 : x₀ ≠ 0 := by
        intro h
        rw [h, V0] at hx₀v
        omega
      have hvy : EllipticRootNumber.valL F ⊥ (d⁻¹ * x₀) =
          -EllipticRootNumber.valL F ⊥ d + -1 := by
        rw [V2 _ _ (inv_ne_zero hd0) hx0, Vinv _ hd0, hx₀v]
      apply hx₀ψ
      have := hd (d⁻¹ * x₀) (by rw [hvy]; omega)
      rwa [mul_inv_cancel_left₀ hd0] at this
    choose bu hbu0 hbu using fin
    obtain ⟨c, hcdef⟩ : ∃ c : ℕ → (⊥ : IntermediateField F (AlgebraicClosure F)),
        ∀ n, c n = ((bu n : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
          (⊥ : IntermediateField F (AlgebraicClosure F))) := ⟨fun n => bu n, fun n => rfl⟩
    have hc0 : ∀ n, c n ≠ 0 := fun n => by rw [hcdef]; exact Units.ne_zero _
    have hcv : ∀ n, EllipticRootNumber.valL F ⊥ (c n) = 0 := fun n => by rw [hcdef]; exact hbu0 n
    have hcψ : ∀ (n : ℕ) (y : (⊥ : IntermediateField F (AlgebraicClosure F))),
        -(n : ℤ) ≤ EllipticRootNumber.valL F ⊥ y → ψ' y = ψ (c n * y) :=
      fun n y hy => by rw [hcdef]; exact hbu n y hy
    
    have s6 : ∀ n : ℕ, c (n + 1) - c n = 0 ∨
        (n : ℤ) ≤ EllipticRootNumber.valL F ⊥ (c (n + 1) - c n) := by
      intro n
      apply kb
      intro y hy
      have h1 := hcψ (n + 1) y (by push_cast; omega)
      have h2 := hcψ n y hy
      have h3 : ψ ((c (n + 1) - c n) * y) * ψ (c n * y) = ψ (c n * y) := by
        rw [← AddChar.map_add_eq_mul, ← h2, h1]
        congr 1
        ring
      exact (mul_left_eq_self₀.mp h3).resolve_right (hψne _)
    
    choose γ hγ using fun n : ℕ =>
      (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).surjective (WithZero.exp (-(n : ℤ)))
    have hγ' : ∀ n : ℕ, IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F (γ n) =
        WithZero.exp (-(n : ℤ)) := hγ
    have tr : ∀ (n : ℕ) (x : (⊥ : IntermediateField F (AlgebraicClosure F))),
        (x = 0 ∨ (n : ℤ) ≤ EllipticRootNumber.valL F ⊥ x) ↔
          ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) x) ≤ γ n := by
      intro n x
      by_cases hx : x = 0
      · subst hx
        refine iff_of_true (Or.inl rfl) ?_
        simp only [map_zero]
        exact zero_le'
      · have hex := hβne x hx
        have key2 : ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) x)
            ≤ γ n ↔ WithZero.log (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
              (ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) x)))
              ≤ -(n : ℤ) := by
          rw [WithZero.log_le_iff_le_exp (hne _ hex), ← hγ' n, map_le_map_iff]
        rw [key2, hv x, s1 _ hex]
        constructor
        · rintro (h | h)
          · exact absurd h hx
          · omega
        · intro h
          right
          omega
    have hγmono : ∀ n : ℕ, γ (n + 1) ≤ γ n := by
      intro n
      rw [← map_le_map_iff (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F), hγ' (n + 1),
        hγ' n]
      exact WithZero.exp_le_exp.mpr (by push_cast; omega)
    obtain ⟨c', hc'⟩ : ∃ c' : ℕ → F,
        ∀ n, c' n = IntermediateField.botEquiv F (AlgebraicClosure F) (c n) :=
      ⟨fun n => IntermediateField.botEquiv F (AlgebraicClosure F) (c n), fun n => rfl⟩
    have hc : ∀ n : ℕ, ValuativeRel.valuation F (c' (n + 1) - c' n) ≤ γ n := by
      intro n
      rw [hc', hc', ← map_sub]
      exact (tr n _).mp (s6 n)
    
    obtain ⟨L, hL⟩ := IsCompact.nonempty_iInter_of_sequence_nonempty_isCompact_isClosed
      (fun n : ℕ => {z : F | ValuativeRel.valuation F (z - c' n) ≤ γ n})
      (fun n => by
        intro z hz
        have hz' : ValuativeRel.valuation F (z - c' (n + 1)) ≤ γ (n + 1) := hz
        show ValuativeRel.valuation F (z - c' n) ≤ γ n
        have e0 : z - c' n = (z - c' (n + 1)) + (c' (n + 1) - c' n) := by ring
        rw [e0]
        exact (ValuativeRel.valuation F).map_add_le (hz'.trans (hγmono n)) (hc n))
      (fun n => ⟨c' n, by
        show ValuativeRel.valuation F (c' n - c' n) ≤ γ n
        rw [sub_self, map_zero]
        exact zero_le'⟩)
      ((Homeomorph.isCompact_preimage (Homeomorph.subRight (c' 0))).mpr
        (IsNonarchimedeanLocalField.isCompact_closedBall F (γ 0)))
      (fun n => (IsValuativeTopology.isClosed_closedBall (γ n)).preimage
        (continuous_sub_right (c' n)))
    have hLn : ∀ n : ℕ, ValuativeRel.valuation F (L - c' n) ≤ γ n := fun n =>
      Set.mem_iInter.mp hL n
    obtain ⟨b₀, hb₀⟩ : ∃ b₀ : (⊥ : IntermediateField F (AlgebraicClosure F)),
        IntermediateField.botEquiv F (AlgebraicClosure F) b₀ = L :=
      ⟨(IntermediateField.botEquiv F (AlgebraicClosure F)).symm L, AlgEquiv.apply_symm_apply _ _⟩
    have hlim : ∀ n : ℕ, b₀ - c n = 0 ∨ (n : ℤ) ≤ EllipticRootNumber.valL F ⊥ (b₀ - c n) := by
      intro n
      refine (tr n _).mpr ?_
      rw [map_sub, hb₀, ← hc' n]
      exact hLn n
    
    have hb₀ne : b₀ ≠ 0 ∧ EllipticRootNumber.valL F ⊥ b₀ = 0 := by
      by_cases hr : b₀ - c 1 = 0
      · have hb : b₀ = c 1 := sub_eq_zero.mp hr
        rw [hb]
        exact ⟨hc0 1, hcv 1⟩
      have h : ((1 : ℕ) : ℤ) ≤ EllipticRootNumber.valL F ⊥ (b₀ - c 1) := (hlim 1).resolve_left hr
      have h' : 1 ≤ EllipticRootNumber.valL F ⊥ (b₀ - c 1) := by exact_mod_cast h
      have hb0 : b₀ ≠ 0 := by
        intro hb
        rw [hb, zero_sub, V4, hcv 1] at h'
        omega
      refine ⟨hb0, le_antisymm ?_ ?_⟩
      · have e1 : c 1 = b₀ + -(b₀ - c 1) := by ring
        have hm := V3 b₀ (-(b₀ - c 1)) hb0 (neg_ne_zero.mpr hr) (by rw [← e1]; exact hc0 1)
        rw [← e1, hcv 1, V4] at hm
        rcases min_le_iff.mp hm with h'' | h''
        · exact h''
        · omega
      · have e2 : b₀ = (b₀ - c 1) + c 1 := by ring
        have hm := V3 (b₀ - c 1) (c 1) hr (hc0 1) (by rw [← e2]; exact hb0)
        rw [← e2, hcv 1] at hm
        have hmin : min (EllipticRootNumber.valL F ⊥ (b₀ - c 1)) 0 = 0 := min_eq_right (by omega)
        rw [hmin] at hm
        exact hm
    
    refine ⟨Units.mk0 b₀ hb₀ne.1, by rw [Units.val_mk0]; exact hb₀ne.2, fun y => ?_⟩
    rw [Units.val_mk0]
    by_cases hy : y = 0
    · rw [hy, mul_zero, AddChar.map_zero_eq_one, AddChar.map_zero_eq_one]
    obtain ⟨k, hk⟩ : ∃ k : ℕ, -(k : ℤ) ≤ EllipticRootNumber.valL F ⊥ y :=
      ⟨(-(EllipticRootNumber.valL F ⊥ y)).toNat, by
        have := Int.self_le_toNat (-(EllipticRootNumber.valL F ⊥ y))
        omega⟩
    rw [hcψ k y hk]
    have e3 : b₀ * y = (b₀ - c k) * y + c k * y := by ring
    have htriv : ψ ((b₀ - c k) * y) = 1 := by
      by_cases hr : b₀ - c k = 0
      · rw [hr, zero_mul, AddChar.map_zero_eq_one]
      have h := (hlim k).resolve_left hr
      apply hψ.1
      rw [V2 _ _ hr hy]
      omega
    rw [e3, AddChar.map_add_eq_mul, htriv, one_mul]
  intro a
  
  
  rcases Nat.eq_zero_or_pos a with ha0 | ha1
  · subst ha0
    refine ⟨1, by rw [Units.val_one, V1], fun y hy => ?_⟩
    rw [Units.val_one, one_mul]
    have hy' : 0 ≤ EllipticRootNumber.valL F ⊥ y := by simpa using hy
    rw [hψ.1 y hy', hψ'.1 y hy']
  
  
  obtain ⟨Q, hQ⟩ : ∃ Q : ℕ → AddSubgroup (⊥ : IntermediateField F (AlgebraicClosure F)),
      ∀ n y, y ∈ Q n ↔ -(n : ℤ) ≤ EllipticRootNumber.valL F ⊥ y := by
    refine ⟨fun n =>
      { carrier := {y | -(n : ℤ) ≤ EllipticRootNumber.valL F ⊥ y}
        zero_mem' := by
          show -(n : ℤ) ≤ EllipticRootNumber.valL F ⊥ 0
          rw [V0]; omega
        add_mem' := by
          intro y z hy hz
          show -(n : ℤ) ≤ EllipticRootNumber.valL F ⊥ (y + z)
          have hy' : -(n : ℤ) ≤ EllipticRootNumber.valL F ⊥ y := hy
          have hz' : -(n : ℤ) ≤ EllipticRootNumber.valL F ⊥ z := hz
          by_cases h1 : y = 0
          · rw [h1, zero_add]; exact hz'
          by_cases h2 : z = 0
          · rw [h2, add_zero]; exact hy'
          by_cases h3 : y + z = 0
          · rw [h3, V0]; omega
          exact le_trans (le_min hy' hz') (V3 y z h1 h2 h3)
        neg_mem' := by
          intro y hy
          show -(n : ℤ) ≤ EllipticRootNumber.valL F ⊥ (-y)
          rw [V4]; exact hy }, fun _ _ => Iff.rfl⟩
  have hH : ∀ y, y ∈ Q 0 ↔ 0 ≤ EllipticRootNumber.valL F ⊥ y := by
    intro y
    rw [hQ, Nat.cast_zero, neg_zero]
  have hHP : Q 0 ≤ Q a := by
    intro y hy
    rw [hQ]
    have := (hH y).mp hy
    omega
  
  obtain ⟨c, hc0, hcv⟩ : ∃ c : (⊥ : IntermediateField F (AlgebraicClosure F)),
      c ≠ 0 ∧ EllipticRootNumber.valL F ⊥ c = a := ⟨π ^ a, Vpow a⟩
  have htriv : ∀ s y : (⊥ : IntermediateField F (AlgebraicClosure F)),
      0 ≤ (a : ℤ) + EllipticRootNumber.valL F ⊥ s + EllipticRootNumber.valL F ⊥ y →
      ψ (c * s * y) = 1 := by
    intro s y h
    by_cases hs : s = 0
    · rw [hs, mul_zero, zero_mul, AddChar.map_zero_eq_one]
    by_cases hy : y = 0
    · rw [hy, mul_zero, AddChar.map_zero_eq_one]
    apply hψ.1
    rw [V2 _ _ (mul_ne_zero hc0 hs) hy, V2 _ _ hc0 hs, hcv]
    exact h
  have hβr : ∀ s ∈ Q a, ∀ y ∈ Q 0, ψ (c * s * y) = 1 := by
    intro s hs y hy
    apply htriv
    have h1 := (hQ a s).mp hs
    have h2 := (hH y).mp hy
    omega
  have hnd : ∀ s ∈ Q a, (∀ y ∈ Q a, ψ (c * s * y) = 1) → s ∈ Q 0 := by
    intro s hsP hall
    have hsv := (hQ a s).mp hsP
    rw [hH]
    by_contra hneg
    obtain ⟨x, hx1, hx2⟩ := hψ.2
    have hx0 : x ≠ 0 := by
      intro h
      rw [h, V0] at hx1
      omega
    have hs0 : s ≠ 0 := by
      intro h
      rw [h, V0] at hneg
      exact hneg le_rfl
    have hd : c * s ≠ 0 := mul_ne_zero hc0 hs0
    have hvy : EllipticRootNumber.valL F ⊥ ((c * s)⁻¹ * x) =
        -((a : ℤ) + EllipticRootNumber.valL F ⊥ s) + -1 := by
      rw [V2 _ _ (inv_ne_zero hd) hx0, Vinv _ hd, V2 _ _ hc0 hs0, hcv, hx1]
    apply hx2
    have hyP : (c * s)⁻¹ * x ∈ Q a := by
      rw [hQ, hvy]
      omega
    have := hall ((c * s)⁻¹ * x) hyP
    rwa [mul_inv_cancel_left₀ hd] at this
  have hψ'H : ∀ y ∈ Q 0, ψ' y = 1 := fun y hy => hψ'.1 y ((hH y).mp hy)
  
  have hS : ∃ S : Finset (⊥ : IntermediateField F (AlgebraicClosure F)),
      ∀ y ∈ Q a, ∃ s ∈ S, y - s ∈ Q 0 := by
    have hK := IsNonarchimedeanLocalField.isCompact_closedBall F
      ((IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm (WithZero.exp (a : ℤ)))
    have hUo : ∀ t : F, IsOpen ((fun z : F => z - t) ⁻¹'
        {w : F | ValuativeRel.valuation F w ≤ 1}) := fun t =>
      (IsValuativeTopology.isOpen_closedBall (R := F)
        (r := (1 : ValuativeRel.ValueGroupWithZero F)) one_ne_zero).preimage (continuous_sub_right t)
    have hcov : {x : F | ValuativeRel.valuation F x ≤
        (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm (WithZero.exp (a : ℤ))} ⊆
        ⋃ t : F, (fun z : F => z - t) ⁻¹' {w : F | ValuativeRel.valuation F w ≤ 1} := by
      intro z _
      refine Set.mem_iUnion.mpr ⟨z, ?_⟩
      show ValuativeRel.valuation F (z - z) ≤ 1
      rw [sub_self, map_zero]
      exact zero_le'
    obtain ⟨T, hT⟩ := hK.elim_finite_subcover _ hUo hcov
    refine ⟨T.image (IntermediateField.botEquiv F (AlgebraicClosure F)).symm, fun y hy => ?_⟩
    have hy' := (hQ a y).mp hy
    rw [hv] at hy'
    have hz : IntermediateField.botEquiv F (AlgebraicClosure F) y ∈
        {x : F | ValuativeRel.valuation F x ≤
          (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm (WithZero.exp (a : ℤ))} := by
      show ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) y) ≤ _
      by_cases hy0 : IntermediateField.botEquiv F (AlgebraicClosure F) y = 0
      · rw [hy0, map_zero]
        exact zero_le'
      rw [s1 _ hy0] at hy'
      have h1 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
          (ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) y)) ≤
          WithZero.exp (a : ℤ) := by
        rw [← WithZero.exp_log (hne _ hy0)]
        exact WithZero.exp_le_exp.mpr (by omega)
      have h2 : IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
          (ValuativeRel.valuation F (IntermediateField.botEquiv F (AlgebraicClosure F) y)) ≤
          IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
            ((IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F).symm
              (WithZero.exp (a : ℤ))) := by
        simpa using h1
      exact (map_le_map_iff (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F)).mp h2
    obtain ⟨t, ht, hzt⟩ := Set.mem_iUnion₂.mp (hT hz)
    refine ⟨(IntermediateField.botEquiv F (AlgebraicClosure F)).symm t,
      Finset.mem_image_of_mem _ ht, ?_⟩
    have hzt' : ValuativeRel.valuation F
        (IntermediateField.botEquiv F (AlgebraicClosure F) y - t) ≤ 1 := hzt
    rw [hH, hv, map_sub, AlgEquiv.apply_symm_apply]
    by_cases h0 : IntermediateField.botEquiv F (AlgebraicClosure F) y - t = 0
    · rw [h0, s0]
    rw [s1 _ h0]
    have h2 := (map_le_map_iff (IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F)).mpr hzt'
    rw [map_one] at h2
    have h3 := (WithZero.log_le_log (hne _ h0) one_ne_zero).mpr h2
    rw [WithZero.log_one] at h3
    omega
  obtain ⟨S, hScov⟩ := hS
  
  have duality : ∀ (P H : AddSubgroup (⊥ : IntermediateField F (AlgebraicClosure F)))
      (S : Finset (⊥ : IntermediateField F (AlgebraicClosure F))),
      (∀ y ∈ P, ∃ s ∈ S, y - s ∈ H) → H ≤ P →
      (∀ s ∈ P, ∀ y ∈ H, ψ (c * s * y) = 1) →
      (∀ s ∈ P, (∀ y ∈ P, ψ (c * s * y) = 1) → s ∈ H) →
      (∀ y ∈ H, ψ' y = 1) →
      ∃ s ∈ P, ∀ y ∈ P, ψ' y = ψ (c * s * y) := by
    intro P H S hS hHP hβr hnd hχ
    
    haveI hGfin : Finite (↥P ⧸ H.addSubgroupOf P) := by
      refine Finite.of_surjective (fun s : {x // x ∈ S} =>
        if h : (s : (⊥ : IntermediateField F (AlgebraicClosure F))) ∈ P then
          (QuotientAddGroup.mk (⟨s, h⟩ : ↥P) : ↥P ⧸ H.addSubgroupOf P) else 0) ?_
      intro g
      obtain ⟨y, rfl⟩ := QuotientAddGroup.mk_surjective g
      obtain ⟨s, hsS, hys⟩ := hS y y.2
      have hsP : s ∈ P := by
        have e : s = (y : (⊥ : IntermediateField F (AlgebraicClosure F))) - (y - s) := by abel
        rw [e]
        exact P.sub_mem y.2 (hHP hys)
      refine ⟨⟨s, hsS⟩, ?_⟩
      show (if h : s ∈ P then
          (QuotientAddGroup.mk (⟨s, h⟩ : ↥P) : ↥P ⧸ H.addSubgroupOf P) else 0) = _
      rw [dif_pos hsP, QuotientAddGroup.eq, AddSubgroup.mem_addSubgroupOf]
      have e : ((-(⟨s, hsP⟩ : ↥P) + y : ↥P) : (⊥ : IntermediateField F (AlgebraicClosure F))) =
          (y : (⊥ : IntermediateField F (AlgebraicClosure F))) - s := by
        rw [AddSubgroup.coe_add, AddSubgroup.coe_neg]
        abel
      rw [e]
      exact hys
    
    have liftC : ∀ χ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F))
        (EllipticRootNumber.Ω F), (∀ y ∈ H, χ y = 1) →
        ∃ χ' : AddChar (↥P ⧸ H.addSubgroupOf P) (EllipticRootNumber.Ω F),
          ∀ y : ↥P, χ' (QuotientAddGroup.mk y) = χ y := by
      intro χ hχH
      refine ⟨AddChar.toAddMonoidHomEquiv.symm (QuotientAddGroup.lift (H.addSubgroupOf P)
        ((AddChar.toAddMonoidHomEquiv χ).comp P.subtype) ?_), fun y => rfl⟩
      intro h hh
      rw [AddMonoidHom.mem_ker]
      show Additive.ofMul (χ (h : (⊥ : IntermediateField F (AlgebraicClosure F)))) = 0
      rw [hχH _ (AddSubgroup.mem_addSubgroupOf.mp hh)]
      rfl
    
    obtain ⟨rep, hrep⟩ : ∃ rep : (↥P ⧸ H.addSubgroupOf P) → ↥P,
        ∀ g, (QuotientAddGroup.mk (rep g) : ↥P ⧸ H.addSubgroupOf P) = g :=
      ⟨fun g => (QuotientAddGroup.mk_surjective g).choose,
        fun g => (QuotientAddGroup.mk_surjective g).choose_spec⟩
    have hβc : ∀ s : (⊥ : IntermediateField F (AlgebraicClosure F)), s ∈ P →
        ∃ χ' : AddChar (↥P ⧸ H.addSubgroupOf P) (EllipticRootNumber.Ω F),
          ∀ y : ↥P, χ' (QuotientAddGroup.mk y) = ψ (c * s * y) := by
      intro s hs
      obtain ⟨χ', h⟩ := liftC (ψ.compAddMonoidHom (AddMonoidHom.mulLeft (c * s)))
        (fun y hy => hβr s hs y hy)
      exact ⟨χ', fun y => h y⟩
    choose Φ hΦ using fun g => hβc (rep g : (⊥ : IntermediateField F (AlgebraicClosure F)))
      (rep g).2
    have hinj : Function.Injective Φ := by
      intro g₁ g₂ h12
      have hall : ∀ y ∈ P, ψ (c * ((rep g₂ : (⊥ : IntermediateField F (AlgebraicClosure F))) -
          (rep g₁ : (⊥ : IntermediateField F (AlgebraicClosure F)))) * y) = 1 := by
        intro y hy
        have e1 := hΦ g₁ ⟨y, hy⟩
        have e2 := hΦ g₂ ⟨y, hy⟩
        rw [h12] at e1
        have e3 : ψ (c * (rep g₁ : (⊥ : IntermediateField F (AlgebraicClosure F))) * y) =
            ψ (c * (rep g₂ : (⊥ : IntermediateField F (AlgebraicClosure F))) * y) :=
          e1.symm.trans e2
        have hsplit : c * ((rep g₂ : (⊥ : IntermediateField F (AlgebraicClosure F))) -
            (rep g₁ : (⊥ : IntermediateField F (AlgebraicClosure F)))) * y =
            c * (rep g₂ : (⊥ : IntermediateField F (AlgebraicClosure F))) * y +
              -(c * (rep g₁ : (⊥ : IntermediateField F (AlgebraicClosure F))) * y) := by ring
        rw [hsplit, AddChar.map_add_eq_mul, ← e3, ← AddChar.map_add_eq_mul, add_neg_cancel,
          AddChar.map_zero_eq_one]
      have hmem := hnd _ (P.sub_mem (rep g₂).2 (rep g₁).2) hall
      calc g₁ = (QuotientAddGroup.mk (rep g₁) : ↥P ⧸ H.addSubgroupOf P) := (hrep g₁).symm
        _ = (QuotientAddGroup.mk (rep g₂) : ↥P ⧸ H.addSubgroupOf P) := by
          rw [QuotientAddGroup.eq, AddSubgroup.mem_addSubgroupOf]
          have e : ((-(rep g₁) + rep g₂ : ↥P) : (⊥ : IntermediateField F (AlgebraicClosure F))) =
              (rep g₂ : (⊥ : IntermediateField F (AlgebraicClosure F))) - rep g₁ := by
            rw [AddSubgroup.coe_add, AddSubgroup.coe_neg]
            abel
          rw [e]
          exact hmem
        _ = g₂ := hrep g₂
    
    have hli := (linearIndependent_monoidHom (Multiplicative (↥P ⧸ H.addSubgroupOf P))
      (EllipticRootNumber.Ω F)).comp AddChar.toMonoidHomEquiv AddChar.toMonoidHomEquiv.injective
    haveI hfinC : Finite (AddChar (↥P ⧸ H.addSubgroupOf P) (EllipticRootNumber.Ω F)) := hli.finite
    haveI := Fintype.ofFinite (AddChar (↥P ⧸ H.addSubgroupOf P) (EllipticRootNumber.Ω F))
    haveI := Fintype.ofFinite (Multiplicative (↥P ⧸ H.addSubgroupOf P))
    have hcard : Nat.card (AddChar (↥P ⧸ H.addSubgroupOf P) (EllipticRootNumber.Ω F)) ≤
        Nat.card (↥P ⧸ H.addSubgroupOf P) := by
      have h1 := hli.fintype_card_le_finrank
      rw [Fintype.card_eq_nat_card, Module.finrank_fintype_fun_eq_card,
        Fintype.card_eq_nat_card] at h1
      exact h1
    have hbij := hinj.bijective_of_nat_card_le hcard
    obtain ⟨χ', hχ'⟩ := liftC ψ' hχ
    obtain ⟨g, hg⟩ := hbij.2 χ'
    refine ⟨rep g, (rep g).2, fun y hy => ?_⟩
    have := hχ' ⟨y, hy⟩
    rw [← hg, hΦ g ⟨y, hy⟩] at this
    exact this.symm
  obtain ⟨s, hsP, hs⟩ := duality (Q a) (Q 0) S hScov hHP hβr hnd hψ'H
  
  obtain ⟨x', hx'1, hx'2⟩ := hψ'.2
  have hx'P : x' ∈ Q a := by
    rw [hQ, hx'1]
    omega
  have h1 : ψ (c * s * x') ≠ 1 := by
    rw [← hs x' hx'P]
    exact hx'2
  have hb0 : c * s ≠ 0 := by
    intro h
    apply h1
    rw [h, zero_mul, AddChar.map_zero_eq_one]
  have hs0 : s ≠ 0 := by
    intro h
    apply hb0
    rw [h, mul_zero]
  have hx'0 : x' ≠ 0 := by
    intro h
    rw [h, V0] at hx'1
    omega
  have hvb : EllipticRootNumber.valL F ⊥ (c * s) = a + EllipticRootNumber.valL F ⊥ s := by
    rw [V2 _ _ hc0 hs0, hcv]
  have hsv := (hQ a s).mp hsP
  have hvb0 : EllipticRootNumber.valL F ⊥ (c * s) = 0 := by
    by_contra hne0
    apply h1
    apply hψ.1
    rw [V2 _ _ hb0 hx'0, hvb, hx'1]
    omega
  refine ⟨Units.mk0 (c * s) hb0, by rw [Units.val_mk0]; exact hvb0, fun y hy => ?_⟩
  rw [Units.val_mk0]
  exact hs y ((hQ a y).mpr hy)

theorem tateEps_unit_twist (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (χ' : Lˣ →* (EllipticRootNumber.Ω F)ˣ)
    (hcont : ∃ a : ℕ, ∀ v ∈ EllipticRootNumber.unitGroup F L a, χ' v = 1)
    (φ : AddChar L (EllipticRootNumber.Ω F)) (hφ : EllipticRootNumber.IsAdmissibleChar F L φ)
    (u : Lˣ) (hu : EllipticRootNumber.valL F L (u : L) = 0) :
    EllipticRootNumber.tateEps F L χ' (φ.compAddMonoidHom (AddMonoidHom.mulLeft (u : L))) =
      (χ' u : EllipticRootNumber.Ω F) * EllipticRootNumber.tateEps F L χ' φ :=
by
  classical
  obtain ⟨-, -, hmul, -, ⟨π, hπ⟩, -⟩ := valL_spec F L
  
  have V2 : EllipticRootNumber.valL F L (1 : L) = 0 := by
    have h := hmul 1 1 one_ne_zero one_ne_zero
    rw [one_mul] at h
    omega
  have V3 : ∀ x y : Lˣ, EllipticRootNumber.valL F L ((x * y : Lˣ) : L) =
      EllipticRootNumber.valL F L (x : L) + EllipticRootNumber.valL F L (y : L) := by
    intro x y
    rw [Units.val_mul]
    exact hmul _ _ x.ne_zero y.ne_zero
  have V4 : ∀ x : Lˣ, EllipticRootNumber.valL F L ((x⁻¹ : Lˣ) : L) =
      -EllipticRootNumber.valL F L (x : L) := by
    intro x
    have h := V3 x x⁻¹
    rw [mul_inv_cancel, Units.val_one, V2] at h
    omega
  have V0z : EllipticRootNumber.valL F L (0 : L) = 0 := by
    unfold EllipticRootNumber.valL EllipticRootNumber.relVal
    rw [Algebra.norm_zero]
    unfold EllipticRootNumber.addVal
    rw [dif_pos rfl, Int.zero_ediv]
  have hπ0 : π ≠ 0 := by
    intro h0
    rw [h0, V0z] at hπ
    exact absurd hπ (by norm_num)
  have hpow : ∀ k : ℕ, EllipticRootNumber.valL F L (π ^ k) = k := by
    intro k
    induction k with
    | zero => rw [pow_zero, V2]; rfl
    | succ k ih =>
      rw [pow_succ, hmul _ _ (pow_ne_zero _ hπ0) hπ0, ih, hπ]
      push_cast
      ring
  have hexU : ∀ k : ℤ, ∃ c : Lˣ, EllipticRootNumber.valL F L (c : L) = k := by
    intro k
    rcases Int.eq_nat_or_neg k with ⟨m, rfl | rfl⟩
    · exact ⟨(Units.mk0 π hπ0) ^ m, by rw [Units.val_pow_eq_pow_val, Units.val_mk0, hpow]⟩
    · refine ⟨((Units.mk0 π hπ0) ^ m)⁻¹, ?_⟩
      rw [V4, Units.val_pow_eq_pow_val, Units.val_mk0, hpow]
  
  have hφu_apply : ∀ x : L, (φ.compAddMonoidHom (AddMonoidHom.mulLeft (u : L))) x = φ ((u : L) * x) :=
    fun x => rfl
  have hKu : ∀ x : L, EllipticRootNumber.valL F L ((u : L) * x) = EllipticRootNumber.valL F L x := by
    intro x
    by_cases hx : x = 0
    · rw [hx, mul_zero]
    · rw [hmul _ _ u.ne_zero hx, hu, zero_add]
  have hn : EllipticRootNumber.condExpChar F L (φ.compAddMonoidHom (AddMonoidHom.mulLeft (u : L))) =
      EllipticRootNumber.condExpChar F L φ := by
    unfold EllipticRootNumber.condExpChar
    congr 1
    ext d
    simp only [Set.mem_setOf_eq]
    constructor
    · intro H y hy
      have e : (u : L) * (((u⁻¹ : Lˣ) : L) * y) = y := Units.mul_inv_cancel_left u y
      have h1 := H (((u⁻¹ : Lˣ) : L) * y) (by rw [← hKu, e]; exact hy)
      rw [hφu_apply, e] at h1
      exact h1
    · intro H x hx
      rw [hφu_apply]
      exact H _ (by rw [hKu]; exact hx)
  have hT : EllipticRootNumber.tateElt F L χ' (φ.compAddMonoidHom (AddMonoidHom.mulLeft (u : L))) =
      EllipticRootNumber.tateElt F L χ' φ := by
    unfold EllipticRootNumber.tateElt
    rw [hn]
  
  have hKer : ∀ v ∈ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ'), χ' v = 1 := by
    obtain ⟨a₀, h₀⟩ := hcont
    unfold EllipticRootNumber.condExp
    exact Nat.sInf_mem (s := {a : ℕ | ∀ v ∈ EllipticRootNumber.unitGroup F L a, χ' v = 1}) ⟨a₀, h₀⟩
  
  have hvc : EllipticRootNumber.valL F L ((EllipticRootNumber.tateElt F L χ' φ : Lˣ) : L) =
      (EllipticRootNumber.condExp F L χ' : ℤ) + EllipticRootNumber.condExpChar F L φ := by
    obtain ⟨c₀, hc₀⟩ := hexU ((EllipticRootNumber.condExp F L χ' : ℤ) +
      EllipticRootNumber.condExpChar F L φ)
    unfold EllipticRootNumber.tateElt
    exact Classical.epsilon_spec (p := fun c : Lˣ => EllipticRootNumber.valL F L (c : L) =
      (EllipticRootNumber.condExp F L χ' : ℤ) + EllipticRootNumber.condExpChar F L φ) ⟨c₀, hc₀⟩
  
  have hφn : ∀ x : L, -EllipticRootNumber.condExpChar F L φ ≤ EllipticRootNumber.valL F L x →
      φ x = 1 := by
    obtain ⟨hne, d₀, h₀⟩ := hφ
    have hx₀ : ∃ x₀, φ x₀ ≠ 1 := by
      by_contra hcon
      push_neg at hcon
      exact hne (AddChar.ext _ _ fun x => by rw [hcon x, AddChar.one_apply])
    obtain ⟨x₀, hx₀⟩ := hx₀
    have hmem : EllipticRootNumber.condExpChar F L φ ∈
        {d : ℤ | ∀ x : L, -d ≤ EllipticRootNumber.valL F L x → φ x = 1} := by
      unfold EllipticRootNumber.condExpChar
      refine Int.csSup_mem ⟨-d₀, fun x hx => h₀ x (by rw [neg_neg] at hx; exact hx)⟩
        ⟨-EllipticRootNumber.valL F L x₀, ?_⟩
      intro d hd
      by_contra hlt
      push_neg at hlt
      exact hx₀ (hd x₀ (by omega))
    exact hmem
  
  unfold EllipticRootNumber.tateEps
  rw [hn, hT]
  by_cases h0 : EllipticRootNumber.condExp F L χ' = 0
  · 
    rw [if_pos h0, if_pos h0]
    have hu1 : χ' u = 1 := by
      apply hKer
      rw [h0]
      unfold EllipticRootNumber.unitGroup
      apply Subgroup.subset_closure
      rw [Set.mem_setOf_eq, if_pos rfl]
      exact hu
    rw [hu1, Units.val_one, one_mul]
  · 
    rw [if_neg h0, if_neg h0]
    have hU0 : ∀ ε ∈ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ'),
