    · subst heq
      have hyy : y₂ = -y₁ := by
        have h0 : (y₁ - y₂) * (y₁ + y₂) = 0 := by linear_combination he₁ - he₂
        rcases mul_eq_zero.mp h0 with h | h
        · exact absurd (sub_eq_zero.mp h) hne
        · linear_combination h
      have e2 : 2 * y₁ = y₁ - y₂ := by rw [hyy]; ring
      have h2y : V (2 * y₁) ≤ V a := by rw [e2]; exact hy
      have hy0 : 2 * y₁ ≠ 0 := by rw [e2]; exact sub_ne_zero.mpr hne
      have hy1 : V y₁ < δ ^ 3 := by
        by_contra hle
        push_neg at hle
        have h' : V 2 * δ ^ 3 ≤ V (2 * y₁) := by rw [map_mul]; exact mul_le_mul_left' hle _
        exact absurd (lt_of_lt_of_le ha (le_trans h' h2y)) (lt_irrefl _)
