      intro ε hε
      have h := relVal_eq_zero_of_mem_unitGroup F L _ (Nat.pos_of_ne_zero h0) ε hε
      unfold EllipticRootNumber.valL
      rw [h, Int.zero_ediv]
    have P2 : ∀ ε ∈ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ'), ∀ y : L,
