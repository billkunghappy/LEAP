    ext <;> simp [threeRootsCurve, WeierstrassCurve.baseChange, WeierstrassCurve.map]
  have hj : v ((threeRootsCurve (algebraMap F (AlgebraicClosure F) t₁)
      (algebraMap F (AlgebraicClosure F) t₂) (algebraMap F (AlgebraicClosure F) t₃)).c₄ ^ 3 /
      (threeRootsCurve (algebraMap F (AlgebraicClosure F) t₁)
      (algebraMap F (AlgebraicClosure F) t₂) (algebraMap F (AlgebraicClosure F) t₃)).Δ) ≤ 1 := by
