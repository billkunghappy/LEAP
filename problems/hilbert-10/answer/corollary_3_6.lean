      hilbFin v a b = hilbSym (v.adicCompletion K) (algebraMap K _ a) (algebraMap K _ b) := by
    intro v a b
    unfold hilbFin hilbLoc hilbSym
    by_cases h : ∃ X Y : v.adicCompletion K,
        algebraMap K _ a * X ^ 2 + algebraMap K _ b * Y ^ 2 = 1
    · simp only [if_pos h]
    · simp only [if_neg h]
  have hbi : ∀ (w : NumberField.InfinitePlace K) (a b : K),
      hilbInf w a b = hilbSym w.Completion (algebraMap K _ a) (algebraMap K _ b) := by
    intro w a b
    unfold hilbInf hilbInfLoc hilbSym
    by_cases h : ∃ X Y : w.Completion,
        algebraMap K _ a * X ^ 2 + algebraMap K _ b * Y ^ 2 = 1
    · simp only [if_pos h]
    · simp only [if_neg h]
  
  have hloc : ∀ v, v ∉ T → hilbFin v (x : K) (y : K) = 1 := by
    intro v hvT
    obtain ⟨s, hs0, hsv⟩ := evn v x (hx v hvT)
    obtain ⟨t, ht0, htv⟩ := evn v y (hy v hvT)
    obtain ⟨Z, W, hZW⟩ := units v ((x : K) * s ^ 2) ((y : K) * t ^ 2) hsv htv (hT2 v hvT)
    have hex : ∃ X Y : v.adicCompletion K,
        algebraMap K _ (x : K) * X ^ 2 + algebraMap K _ (y : K) * Y ^ 2 = 1 := by
      refine ⟨algebraMap K (v.adicCompletion K) s * Z,
        algebraMap K (v.adicCompletion K) t * W, ?_⟩
      rw [← hZW]; simp only [map_mul, map_pow]; ring
    rw [hbf]
    unfold hilbSym
    rw [if_pos hex]
  
  have key := (hilbert_reciprocity x y).2
  have hsupp : Function.mulSupport (fun v => hilbFin v (x : K) (y : K)) ⊆ ↑T := by
    intro v hv
    by_contra hvT
    exact (Function.mem_mulSupport.mp hv) (hloc v hvT)
  rw [finprod_eq_prod_of_mulSupport_subset _ hsupp] at key
  refine Eq.trans ?_ key
  simp only [hbf, hbi]

theorem exists_finset_sqGen {K : Type u} [Field K] [NumberField K]
    (T₀ : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))) :
    ∃ T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      T₀ ⊆ T ∧ ∀ q, q ∉ T → ∃ y : Kˣ, ¬ EvenVal q y ∧ ∀ v, v ∉ T → v ≠ q → EvenVal v y :=
by
  classical
  let J : ClassGroup (NumberField.RingOfIntegers K) →
      nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
    Function.surjInv ClassGroup.mk0_surjective
  have hJ : ∀ c, ClassGroup.mk0 (J c) = c := fun c => Function.surjInv_eq _ c
  have hJne : ∀ c, ((J c : Ideal (NumberField.RingOfIntegers K))) ≠ 0 :=
    fun c => nonZeroDivisors.coe_ne_zero _
  let F : ClassGroup (NumberField.RingOfIntegers K) →
      Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
    fun c => (Ideal.finite_factors (hJne c)).toFinset
  refine ⟨T₀ ∪ Finset.univ.biUnion F, Finset.subset_union_left, ?_⟩
  have hP : ∀ c (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      v.asIdeal ∣ (J c : Ideal (NumberField.RingOfIntegers K)) →
        v ∈ T₀ ∪ Finset.univ.biUnion F := by
    intro c v hv
    refine Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨c, Finset.mem_univ _, ?_⟩)
    exact (Set.Finite.mem_toFinset _).mpr hv
  intro q hq
  have hqne : q.asIdeal ≠ 0 := q.ne_bot
  have hQ : q.asIdeal ∈ nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) :=
    mem_nonZeroDivisors_of_ne_zero hqne
  let Q : nonZeroDivisors (Ideal (NumberField.RingOfIntegers K)) := ⟨q.asIdeal, hQ⟩
  obtain ⟨c, hc⟩ : ∃ c, c = (ClassGroup.mk0 Q)⁻¹ := ⟨_, rfl⟩
  have hprod : ClassGroup.mk0 (Q * J c) = 1 := by
    rw [map_mul, hJ, hc, mul_inv_cancel]
  have hprin : Submodule.IsPrincipal
      (q.asIdeal * (J c : Ideal (NumberField.RingOfIntegers K))) :=
    (ClassGroup.mk0_eq_one_iff (Q * J c).2).mp hprod
  obtain ⟨a, ha⟩ := hprin
  have haspan : q.asIdeal * (J c : Ideal (NumberField.RingOfIntegers K)) = Ideal.span {a} := ha
  have ha0 : a ≠ 0 := by
    rintro rfl
    rw [Ideal.span_singleton_eq_bot.mpr rfl] at haspan
    rcases mul_eq_zero.mp haspan with h | h
    · exact hqne h
    · exact hJne c h
  have hK : algebraMap (NumberField.RingOfIntegers K) K a ≠ 0 := by
    intro h
    apply ha0
    exact (IsFractionRing.injective _ K) (by rw [h, map_zero])
  have hV : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      ((v.valuationOfNeZero (Units.mk0 _ hK) : Multiplicative ℤ) : WithZero (Multiplicative ℤ)) =
        v.intValuation a := by
    intro v
    rw [IsDedekindDomain.HeightOneSpectrum.valuationOfNeZero_eq, Units.val_mk0,
      IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap]
  refine ⟨Units.mk0 _ hK, ?_, ?_⟩
  · unfold EvenVal
    have hm : q.intValuation a =
        WithZero.exp (Multiplicative.toAdd (q.valuationOfNeZero (Units.mk0 _ hK))) := by
      rw [← hV q]
      rfl
    have h1 : q.intValuation a ≤ WithZero.exp (-((1 : ℕ) : ℤ)) :=
      (q.intValuation_le_pow_iff_dvd a 1).mpr (by rw [pow_one, ← haspan]; exact dvd_mul_right _ _)
    have h2 : ¬ q.intValuation a ≤ WithZero.exp (-((2 : ℕ) : ℤ)) := by
      rw [q.intValuation_le_pow_iff_dvd a 2, ← haspan, sq]
      intro hd
      exact hq (hP c q ((mul_dvd_mul_iff_left hqne).mp hd))
    rw [hm, WithZero.exp_le_exp] at h1 h2
    rintro ⟨r, hr⟩
    push_cast at h1 h2
    omega
  · intro v hv hvq
    have hnd : ¬ v.asIdeal ∣ Ideal.span {a} := by
      rw [← haspan]
      intro hd
      rcases (Ideal.prime_of_isPrime v.ne_bot v.isPrime).dvd_or_dvd hd with h | h
      · apply hvq
        have hle : q.asIdeal ≤ v.asIdeal := Ideal.le_of_dvd h
        exact (IsDedekindDomain.HeightOneSpectrum.ext
          (q.isMaximal.eq_of_le v.isPrime.ne_top hle)).symm
      · exact hv (hP c v h)
    have h1 : v.intValuation a = 1 :=
      le_antisymm (v.intValuation_le_one a)
        (not_lt.mp (fun h => hnd ((v.intValuation_lt_one_iff_dvd a).mp h)))
    unfold EvenVal
    have h' : v.valuationOfNeZero (Units.mk0 _ hK) = 1 := by
      have := hV v
      rw [h1] at this
      exact_mod_cast this
    rw [h']
    simp

theorem unitClasses_insert_split {K : Type u} [Field K] [NumberField K]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (hp : p ∉ T)
    (hz : ∃ z : Kˣ, p.valuationOfNeZero z ≠ 1 ∧ ∀ v, v ≠ p → v.valuationOfNeZero z = 1) :
    ∃ g : SqCl K,
      (∀ c ∈ {c : SqCl K | ∃ x : Kˣ, c = sqCl x ∧ ∀ v, v ∉ T → v.valuationOfNeZero x = 1},
        g * c ∈ {c : SqCl K | ∃ x : Kˣ, c = sqCl x ∧
          ∀ v, v ∉ T → v ≠ p → v.valuationOfNeZero x = 1}) ∧
      (∀ c ∈ {c : SqCl K | ∃ x : Kˣ, c = sqCl x ∧
          ∀ v, v ∉ T → v ≠ p → v.valuationOfNeZero x = 1},
        c ∈ {c : SqCl K | ∃ x : Kˣ, c = sqCl x ∧ ∀ v, v ∉ T → v.valuationOfNeZero x = 1} ∨
        g * c ∈ {c : SqCl K | ∃ x : Kˣ, c = sqCl x ∧ ∀ v, v ∉ T → v.valuationOfNeZero x = 1}) ∧
      (∀ c ∈ {c : SqCl K | ∃ x : Kˣ, c = sqCl x ∧ ∀ v, v ∉ T → v.valuationOfNeZero x = 1},
        g * c ∉ {c : SqCl K | ∃ x : Kˣ, c = sqCl x ∧ ∀ v, v ∉ T → v.valuationOfNeZero x = 1}) :=
by
  classical
  have νmul : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x y : Kˣ), Multiplicative.toAdd (v.valuationOfNeZero (x * y)) =
        Multiplicative.toAdd (v.valuationOfNeZero x) +
          Multiplicative.toAdd (v.valuationOfNeZero y) := by
    intro v x y
    rw [map_mul, toAdd_mul]
  have νsq : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x : Kˣ), Multiplicative.toAdd (v.valuationOfNeZero (x ^ 2)) =
        2 * Multiplicative.toAdd (v.valuationOfNeZero x) := by
    intro v x
    rw [map_pow, toAdd_pow, nsmul_eq_mul]
    norm_num
  have νzpow : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x : Kˣ) (n : ℤ), Multiplicative.toAdd (v.valuationOfNeZero (x ^ n)) =
        n * Multiplicative.toAdd (v.valuationOfNeZero x) := by
    intro v x n
    rw [map_zpow, toAdd_zpow, smul_eq_mul]
  have νone : ∀ (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
      (x : Kˣ), v.valuationOfNeZero x = 1 ↔ Multiplicative.toAdd (v.valuationOfNeZero x) = 0 := by
    intro v x
    constructor
    · intro h
      rw [h]
      rfl
    · intro h
      exact Multiplicative.toAdd.injective (h.trans toAdd_one.symm)
  have Q1 : ∀ a b : Kˣ, sqCl a = sqCl b → ∃ w : Kˣ, b = a * w ^ 2 := by
    intro a b h
    unfold sqCl at h
    rw [QuotientGroup.eq] at h
    obtain ⟨w, hw⟩ := h
    refine ⟨w, ?_⟩
    rw [powMonoidHom_apply] at hw
    rw [hw, mul_inv_cancel_left]
  have Q2 : ∀ a w : Kˣ, sqCl (a * w ^ 2) = sqCl a := by
    intro a w
    unfold sqCl
    rw [QuotientGroup.eq]
    refine ⟨w⁻¹, ?_⟩
    rw [powMonoidHom_apply, mul_inv_rev, inv_mul_cancel_right, inv_pow]
  
  obtain ⟨z, hzp, hzv⟩ := hz
  have hex : ∃ n : ℕ, 0 < n ∧ ∃ x : Kˣ, (∀ v, v ∉ T → v ≠ p → v.valuationOfNeZero x = 1) ∧
      Multiplicative.toAdd (p.valuationOfNeZero x) = (n : ℤ) := by
    have hN : Multiplicative.toAdd (p.valuationOfNeZero z) ≠ 0 := fun h => hzp ((νone p z).mpr h)
    rcases lt_or_gt_of_ne hN with h | h
    · refine ⟨(-Multiplicative.toAdd (p.valuationOfNeZero z)).toNat, by omega, z⁻¹, ?_, ?_⟩
      · intro v _ hvp
        rw [map_inv, hzv v hvp, inv_one]
      · rw [map_inv, toAdd_inv]
        omega
    · exact ⟨(Multiplicative.toAdd (p.valuationOfNeZero z)).toNat, by omega, z,
        fun v _ hvp => hzv v hvp, by omega⟩
  obtain ⟨hn₀pos, z₀, hz₀U, hz₀v⟩ := Nat.find_spec hex
  have hn : (0 : ℤ) < (Nat.find hex : ℤ) := by exact_mod_cast hn₀pos
  have hdvd : ∀ x : Kˣ, (∀ v, v ∉ T → v ≠ p → v.valuationOfNeZero x = 1) →
      (Nat.find hex : ℤ) ∣ Multiplicative.toAdd (p.valuationOfNeZero x) := by
    intro x hx
    obtain ⟨k, ρ, hsum, hρ0, hρn⟩ : ∃ k ρ : ℤ,
        ρ + (Nat.find hex : ℤ) * k = Multiplicative.toAdd (p.valuationOfNeZero x) ∧
          0 ≤ ρ ∧ ρ < (Nat.find hex : ℤ) :=
      ⟨_, _, Int.emod_add_ediv _ _, Int.emod_nonneg _ hn.ne', Int.emod_lt_of_pos _ hn⟩
    have hρ : ρ = 0 := by
      by_contra hρne
      have hmin := Nat.find_min' hex (m := ρ.toNat)
        ⟨by omega, x * z₀ ^ (-k), ?_, ?_⟩
      · have := Int.toNat_of_nonneg hρ0
        omega
      · intro v hv hvp
        rw [νone, νmul, νzpow, (νone v x).mp (hx v hv hvp), (νone v z₀).mp (hz₀U v hv hvp)]
        ring
      · rw [νmul, νzpow, hz₀v, Int.toNat_of_nonneg hρ0]
        linarith
    exact ⟨k, by rw [← hsum, hρ, zero_add]⟩
  refine ⟨sqCl z₀, ?_, ?_, ?_⟩
  · rintro c ⟨x, rfl, hx⟩
    exact ⟨z₀ * x, rfl, fun v hv hvp => by rw [map_mul, hz₀U v hv hvp, hx v hv, one_mul]⟩
  · rintro c ⟨x, rfl, hx⟩
    obtain ⟨k, hk⟩ := hdvd x hx
    obtain ⟨j, rfl | rfl⟩ := Int.even_or_odd' k
    · left
      refine ⟨x * (z₀ ^ (-j)) ^ 2, (Q2 x _).symm, fun v hv => ?_⟩
      rw [νone, νmul, νsq, νzpow]
      by_cases hvp : v = p
      · rw [hvp, hk, hz₀v]
        ring
      · rw [(νone v x).mp (hx v hv hvp), (νone v z₀).mp (hz₀U v hv hvp)]
        ring
    · right
      refine ⟨(z₀ * x) * (z₀ ^ (-(j + 1))) ^ 2, (Q2 (z₀ * x) _).symm, fun v hv => ?_⟩
      rw [νone, νmul, νmul, νsq, νzpow]
      by_cases hvp : v = p
      · rw [hvp, hk, hz₀v]
        ring
      · rw [(νone v x).mp (hx v hv hvp), (νone v z₀).mp (hz₀U v hv hvp)]
        ring
  · rintro c ⟨u, rfl, hu⟩ ⟨u', hu'e, hu'⟩
    obtain ⟨w, hw⟩ := Q1 (z₀ * u) u' hu'e
    have hwU : ∀ v, v ∉ T → v ≠ p → v.valuationOfNeZero w = 1 := by
      intro v hv hvp
      have e := (νone v u').mp (hu' v hv)
      rw [hw, νmul, νmul, νsq, (νone v z₀).mp (hz₀U v hv hvp), (νone v u).mp (hu v hv)] at e
      rw [νone]
      omega
    obtain ⟨m, hm⟩ := hdvd w hwU
    have e := (νone p u').mp (hu' p hp)
    rw [hw, νmul, νmul, νsq, hz₀v, (νone p u).mp (hu p hp), hm] at e
    have h0 : (Nat.find hex : ℤ) * (1 + 2 * m) = 0 := by linarith
    rcases mul_eq_zero.mp h0 with h | h
    · omega
    · omega

theorem exists_finset_unitGen {K : Type u} [Field K] [NumberField K]
