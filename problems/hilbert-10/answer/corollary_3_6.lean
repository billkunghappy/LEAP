    have IJ1 : WeierstrassCurve.Affine.CoordinateRing.XYIdeal W.toAffine x (Polynomial.C y) ≤ J 1 := by
      show Ideal.span {WeierstrassCurve.Affine.CoordinateRing.XClass W.toAffine x,
        WeierstrassCurve.Affine.CoordinateRing.YClass W.toAffine (Polynomial.C y)} ≤ J 1
      rw [Ideal.span_le]
      rintro z (rfl | rfl)
      · right
        rw [Nat.cast_one, hXc h x, if_pos rfl]
        split_ifs <;> norm_num
      · right
        rw [Nat.cast_one]
        exact hYcge h
    have IkJk : ∀ k : ℕ,
        WeierstrassCurve.Affine.CoordinateRing.XYIdeal W.toAffine x (Polynomial.C y) ^ k ≤ J k := by
      intro k
      induction k with
      | zero =>
        rw [pow_zero, Ideal.one_eq_top]
        intro a _
        exact C0 a
      | succ k ih =>
        rw [pow_succ]
        refine le_trans (Ideal.mul_mono ih IJ1) ?_
        rw [Ideal.mul_le]
        intro r hr s hs
        exact mulC k 1 r s hr hs
    have hlow : (N : ℤ) ≤ ord (WeierstrassCurve.Affine.Point.some h) f := by
      have := (IkJk N ha₀)
      rw [← hfa]
      exact this.resolve_left ha₀ne
    
    have key : ∀ u ∈ WeierstrassCurve.Affine.CoordinateRing.XYIdeal W.toAffine x (Polynomial.C y),
        u ≠ 0 → ∃ r : W.toAffine.CoordinateRing, r ≠ 0 ∧ ∀ R : W.toAffine.Point,
          (N : ℤ) * ord R (algebraMap W.toAffine.CoordinateRing
            (FractionRing W.toAffine.CoordinateRing) u) =
          ord R (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) r) +
            ord R f := by
      intro u hu hu0
      obtain ⟨r, hr⟩ := hP (u ^ N) (Ideal.pow_mem_pow hu N)
      have hr0 : r ≠ 0 := by
        rintro rfl
        rw [map_zero, zero_mul] at hr
        exact ne0 _ (pow_ne_zero N hu0) hr
      refine ⟨r, hr0, fun R => ?_⟩
      rw [← ordpow R _ N (ne0 u hu0), ← map_pow, hr, hmul R _ _ (ne0 r hr0) hf0]
    have hXne := WeierstrassCurve.Affine.CoordinateRing.XClass_ne_zero (W' := W.toAffine) x
    have hYne' := WeierstrassCurve.Affine.CoordinateRing.YClass_ne_zero (W' := W.toAffine)
      (Polynomial.C y)
    have hup : ord (WeierstrassCurve.Affine.Point.some h) f ≤ N := by
      by_cases hβ : 2 * y + W.a₁ * x + W.a₃ = 0
      · obtain ⟨r, hr0, hr⟩ := key _ hYI hYne'
        have e := hr (WeierstrassCurve.Affine.Point.some h)
        rw [hYc2 h hβ] at e
        have := hnonneg h r hr0
        omega
      · obtain ⟨r, hr0, hr⟩ := key _ hXI hXne
        have e := hr (WeierstrassCurve.Affine.Point.some h)
        rw [hXc h x, if_pos rfl, if_neg hβ] at e
        have := hnonneg h r hr0
        omega
    have hother : ∀ {x' y' : K} (h' : W.toAffine.Nonsingular x' y'), (x' ≠ x ∨ y' ≠ y) →
        ord (WeierstrassCurve.Affine.Point.some h') f = 0 := by
      intro x' y' h' hxy
      have hf' : 0 ≤ ord (WeierstrassCurve.Affine.Point.some h') f := by
        rw [← hfa]; exact hnonneg h' a₀ ha₀ne
      by_cases hx : x' = x
      · have hy : y ≠ y' := fun e => (hxy.resolve_left (not_not.mpr hx)) e.symm
        obtain ⟨r, hr0, hr⟩ := key _ hYI hYne'
        have e := hr (WeierstrassCurve.Affine.Point.some h')
        rw [hYcne h' y hy] at e
        have := hnonneg h' r hr0
        omega
      · obtain ⟨r, hr0, hr⟩ := key _ hXI hXne
        have e := hr (WeierstrassCurve.Affine.Point.some h')
        rw [hXc h' x, if_neg (Ne.symm hx)] at e
        have := hnonneg h' r hr0
        omega
    have hT : ord (WeierstrassCurve.Affine.Point.some h) f = N := le_antisymm hup hlow
    
    have hO : ord 0 f = -(N : ℤ) := by
      classical
      obtain ⟨s, hs1, hs2⟩ := hdeg f hf0
      have hne : (0 : W.toAffine.Point) ≠ WeierstrassCurve.Affine.Point.some h := fun e => by
        cases e
      have e1 : ∑ R ∈ s, ord R f = ∑ R ∈ s ∪ {0, WeierstrassCurve.Affine.Point.some h}, ord R f :=
        Finset.sum_subset Finset.subset_union_left (fun R _ hR => hs1 R hR)
      have e2 : ∑ R ∈ ({0, WeierstrassCurve.Affine.Point.some h} : Finset W.toAffine.Point), ord R f =
          ∑ R ∈ s ∪ {0, WeierstrassCurve.Affine.Point.some h}, ord R f := by
        refine Finset.sum_subset Finset.subset_union_right (fun R _ hR => ?_)
        simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hR
        obtain ⟨hR0, hRT⟩ := hR
        cases R with
        | zero => exact absurd rfl hR0
        | @some x' y' h' =>
          apply hother h'
          by_contra hc
          push_neg at hc
          obtain ⟨rfl, rfl⟩ := hc
          exact hRT rfl
      rw [Finset.sum_pair hne, hT] at e2
      omega
    exact ⟨f, hf0, hT, hother, hO⟩
  
  intro N Q hNQ
  by_cases hN0 : N = 0
  · subst hN0
    refine ⟨1, one_ne_zero, fun R => ?_⟩
    rw [ord1 R]
    simp
  by_cases hQ : Q = 0
  · subst hQ
    refine ⟨1, one_ne_zero, fun R => ?_⟩
    rw [ord1 R]
    simp
  cases Q with
  | zero => exact absurd rfl hQ
  | @some xq yq hQ' =>
    have h := (WeierstrassCurve.Affine.nonsingular_neg xq yq).mpr hQ'
    have hT : -(WeierstrassCurve.Affine.Point.some hQ') = WeierstrassCurve.Affine.Point.some h :=
      WeierstrassCurve.Affine.Point.neg_some hQ'
    have hNT : N • WeierstrassCurve.Affine.Point.some h = 0 := by
      rw [← hT, neg_nsmul, hNQ, neg_zero]
    obtain ⟨f, hf0, hfT, hfS, hfO⟩ := main h N hNT
    refine ⟨f, hf0, fun R => ?_⟩
    rw [hT]
    cases R with
    | zero =>
      have e1 : ¬ (WeierstrassCurve.Affine.Point.zero = WeierstrassCurve.Affine.Point.some h) :=
        fun e => by cases e
      rw [if_neg e1, if_pos (show (WeierstrassCurve.Affine.Point.zero : W.toAffine.Point) = 0 from rfl),
        zero_sub]
      exact hfO
    | @some x' y' h' =>
      by_cases hR : x' = xq ∧ y' = W.toAffine.negY xq yq
      · obtain ⟨rfl, rfl⟩ := hR
        have e2 : ¬ (WeierstrassCurve.Affine.Point.some h' = 0) := fun e => by cases e
        rw [if_pos rfl, if_neg e2, sub_zero]
        exact hfT
      · have e1 : ¬ (WeierstrassCurve.Affine.Point.some h' = WeierstrassCurve.Affine.Point.some h) :=
          fun e => hR (WeierstrassCurve.Affine.Point.some.inj e)
        have e2 : ¬ (WeierstrassCurve.Affine.Point.some h' = 0) := fun e => by cases e
        rw [if_neg e1, if_neg e2, sub_zero]
        exact hfS h' (not_and_or.mp hR)

theorem divisorCalc_constants_and_RR {K L Pt : Type*} [Field K] [Field L] [Algebra K L] [Zero Pt] (ord : Pt → L → ℤ)
    (hmul : ∀ (R : Pt) (f g : L), f ≠ 0 → g ≠ 0 → ord R (f * g) = ord R f + ord R g)
    (hconst : ∀ (R : Pt) (c : K), c ≠ 0 → ord R (algebraMap K L c) = 0)
    (hultra : ∀ (R : Pt) (f g : L), f ≠ 0 → g ≠ 0 → f + g ≠ 0 →
      min (ord R f) (ord R g) ≤ ord R (f + g))
    (hres : ∀ f : L, f ≠ 0 → 0 ≤ ord 0 f → ∃ c : K,
      f = algebraMap K L c ∨ (f - algebraMap K L c ≠ 0 ∧ 1 ≤ ord 0 (f - algebraMap K L c)))
    (hunif : ∃ t : L, t ≠ 0 ∧ ord 0 t = 1)
    (hdeg : ∀ f : L, f ≠ 0 → ∃ s : Finset Pt, (∀ R : Pt, R ∉ s → ord R f = 0) ∧ ∑ R ∈ s, ord R f = 0) :
    (∀ f : L, f ≠ 0 → (∀ R : Pt, 0 ≤ ord R f) → ∃ c : K, algebraMap K L c = f) ∧
      (∀ N : ℕ, ∃ V : Submodule K L, FiniteDimensional K V ∧
        ∀ f : L, f ∈ V ↔ (f = 0 ∨ ((∀ R : Pt, R ≠ 0 → 0 ≤ ord R f) ∧ -(N : ℤ) ≤ ord 0 f))) :=
by
  classical
  
  have claimP : ∀ g : L, g ≠ 0 → (∀ R : Pt, 0 ≤ ord R g) → ord 0 g = 0 := by
    intro g hg hnn
    obtain ⟨s, hs, hsum⟩ := hdeg g hg
    by_cases h0 : (0 : Pt) ∈ s
    · have h1 := Finset.single_le_sum (f := fun R => ord R g) (fun R _ => hnn R) h0
      simp only at h1
      have h2 := hnn 0
      omega
    · exact hs 0 h0
  
  have hA : ∀ f : L, f ≠ 0 → (∀ R : Pt, 0 ≤ ord R f) → ∃ c : K, algebraMap K L c = f := by
    intro f hf hnn
    obtain ⟨c, hc | ⟨hg, hg1⟩⟩ := hres f hf (hnn 0)
    · exact ⟨c, hc.symm⟩
    · exfalso
      by_cases hc0 : c = 0
      · rw [hc0, map_zero, sub_zero] at hg1
        have := claimP f hf hnn
        omega
      · have hnc : (-c) ≠ 0 := neg_ne_zero.mpr hc0
        have hι : algebraMap K L (-c) ≠ 0 := (map_ne_zero _).mpr hnc
        have heq : f + algebraMap K L (-c) = f - algebraMap K L c := by
          rw [map_neg, sub_eq_add_neg]
        have hnn' : ∀ R : Pt, 0 ≤ ord R (f - algebraMap K L c) := by
          intro R
          have h1 := hultra R f (algebraMap K L (-c)) hf hι (by rw [heq]; exact hg)
          rw [heq, hconst R (-c) hnc] at h1
          exact le_trans (le_min (hnn R) le_rfl) h1
        have := claimP _ hg hnn'
        omega
  
  have hsub : ∀ N : ℕ, ∃ V : Submodule K L, ∀ f : L,
      f ∈ V ↔ (f = 0 ∨ ((∀ R : Pt, R ≠ 0 → 0 ≤ ord R f) ∧ -(N : ℤ) ≤ ord 0 f)) := by
    intro N
    refine ⟨{ carrier := {f | f = 0 ∨ ((∀ R : Pt, R ≠ 0 → 0 ≤ ord R f) ∧ -(N : ℤ) ≤ ord 0 f)}
              add_mem' := ?_
              zero_mem' := Or.inl rfl
              smul_mem' := ?_ }, fun f => Iff.rfl⟩
    · intro f g hfm hgm
      simp only [Set.mem_setOf_eq] at hfm hgm ⊢
      by_cases hf : f = 0
      · rw [hf, zero_add]; exact hgm
      by_cases hg : g = 0
      · rw [hg, add_zero]; exact hfm
      by_cases hfg : f + g = 0
      · exact Or.inl hfg
      rcases hfm with h | ⟨hfR, hf0⟩
      · exact absurd h hf
      rcases hgm with h | ⟨hgR, hg0⟩
      · exact absurd h hg
      right
      exact ⟨fun R hR => le_trans (le_min (hfR R hR) (hgR R hR)) (hultra R f g hf hg hfg),
        le_trans (le_min hf0 hg0) (hultra 0 f g hf hg hfg)⟩
    · intro c f hfm
      simp only [Set.mem_setOf_eq] at hfm ⊢
      by_cases hc : c = 0
      · left; rw [hc, zero_smul]
      by_cases hf : f = 0
      · left; rw [hf, smul_zero]
      rcases hfm with h | ⟨hfR, hf0⟩
      · exact absurd h hf
      right
      have hι : algebraMap K L c ≠ 0 := (map_ne_zero _).mpr hc
      have key : ∀ R, ord R (c • f) = ord R f := by
        intro R
        rw [Algebra.smul_def, hmul R _ _ hι hf, hconst R c hc, zero_add]
      refine ⟨fun R hR => ?_, ?_⟩
      · rw [key]; exact hfR R hR
      · rw [key]; exact hf0
  
  have hred : ∀ (m : ℤ) (f h : L), f ≠ 0 → h ≠ 0 → (∀ R : Pt, R ≠ 0 → 0 ≤ ord R f) →
      (∀ R : Pt, R ≠ 0 → 0 ≤ ord R h) → ord 0 f = m → ord 0 h = m →
      ∃ c : K, f - algebraMap K L c * h = 0 ∨
        (f - algebraMap K L c * h ≠ 0 ∧ (∀ R : Pt, R ≠ 0 → 0 ≤ ord R (f - algebraMap K L c * h)) ∧
          m + 1 ≤ ord 0 (f - algebraMap K L c * h)) := by
    intro m f h hf hh hfR hhR hf0 hh0
    have hq : f / h ≠ 0 := div_ne_zero hf hh
    have hfq : f = f / h * h := (div_mul_cancel₀ f hh).symm
    have hq0 : ord 0 (f / h) = 0 := by
      have h1 := hmul 0 (f / h) h hq hh
      rw [← hfq] at h1
      omega
    obtain ⟨c, hc | ⟨hg, hg1⟩⟩ := hres (f / h) hq (le_of_eq hq0.symm)
    · refine ⟨c, Or.inl ?_⟩
      rw [← hc, ← hfq, sub_self]
    · refine ⟨c, Or.inr ?_⟩
      have heq : f - algebraMap K L c * h = (f / h - algebraMap K L c) * h := by
        rw [sub_mul, ← hfq]
      have hne : f - algebraMap K L c * h ≠ 0 := by rw [heq]; exact mul_ne_zero hg hh
      refine ⟨hne, ?_, ?_⟩
      · intro R hR
        by_cases hc0 : c = 0
        · rw [hc0, map_zero, zero_mul, sub_zero]; exact hfR R hR
        · have hnc : (-c) ≠ 0 := neg_ne_zero.mpr hc0
          have hιc : algebraMap K L (-c) ≠ 0 := (map_ne_zero _).mpr hnc
          have hι : algebraMap K L (-c) * h ≠ 0 := mul_ne_zero hιc hh
          have heq2 : f + algebraMap K L (-c) * h = f - algebraMap K L c * h := by
            rw [map_neg, neg_mul, ← sub_eq_add_neg]
          have h1 := hultra R f (algebraMap K L (-c) * h) hf hι (by rw [heq2]; exact hne)
          rw [heq2, hmul R _ _ hιc hh, hconst R (-c) hnc, zero_add] at h1
          exact le_trans (le_min (hfR R hR) (hhR R hR)) h1
      · rw [heq, hmul 0 _ _ hg hh, hh0]; omega
  refine ⟨hA, ?_⟩
  intro N
  induction N with
  | zero =>
    obtain ⟨V, hV⟩ := hsub 0
    have hle : V ≤ Submodule.span K {(1 : L)} := by
      intro f hfV
      rcases (hV f).mp hfV with hf | ⟨hfR, hf0⟩
      · rw [hf]; exact Submodule.zero_mem _
      · by_cases hf : f = 0
        · rw [hf]; exact Submodule.zero_mem _
        have hnn : ∀ R : Pt, 0 ≤ ord R f := by
          intro R
          by_cases hR : R = 0
          · subst hR; simpa using hf0
          · exact hfR R hR
        obtain ⟨c, hc⟩ := hA f hf hnn
        rw [Submodule.mem_span_singleton]
        exact ⟨c, by rw [← hc, Algebra.algebraMap_eq_smul_one]⟩
    haveI := FiniteDimensional.span_singleton K (1 : L)
    exact ⟨V, Submodule.finiteDimensional_of_le hle, hV⟩
  | succ N ih =>
    obtain ⟨V, hVfd, hV⟩ := ih
    obtain ⟨W, hW⟩ := hsub (N + 1)
    have hO : ∀ f : L, f ∈ W → f ≠ 0 → ord 0 f ≠ -((N + 1 : ℕ) : ℤ) → f ∈ V := by
      intro f hfW hf hne
      rcases (hW f).mp hfW with h0 | ⟨hfR, hf0⟩
      · exact absurd h0 hf
      · rw [hV]
        right
        refine ⟨hfR, ?_⟩
        push_cast at hf0 hne ⊢
        omega
    by_cases hex : ∃ h : L, h ≠ 0 ∧ (∀ R : Pt, R ≠ 0 → 0 ≤ ord R h) ∧
        ord 0 h = -((N + 1 : ℕ) : ℤ)
    · obtain ⟨h, hh, hhR, hh0⟩ := hex
      have hle : W ≤ V ⊔ Submodule.span K {h} := by
        intro f hfW
        by_cases hf : f = 0
        · rw [hf]; exact Submodule.zero_mem _
        by_cases hfm : ord 0 f = -((N + 1 : ℕ) : ℤ)
        · rcases (hW f).mp hfW with h0 | ⟨hfR, -⟩
          · exact absurd h0 hf
          obtain ⟨c, hc⟩ := hred _ f h hf hh hfR hhR hfm hh0
          have hgV : f - algebraMap K L c * h ∈ V := by
            rw [hV]
            rcases hc with hc | ⟨_, hR, h0⟩
            · exact Or.inl hc
            · refine Or.inr ⟨hR, ?_⟩
              push_cast at h0 ⊢
              omega
          have hch : c • h ∈ Submodule.span K {h} :=
            Submodule.smul_mem _ c (Submodule.mem_span_singleton_self h)
          have hfe : f = (f - algebraMap K L c * h) + c • h := by
            rw [Algebra.smul_def, sub_add_cancel]
          rw [hfe]
          exact Submodule.add_mem_sup hgV hch
        · exact Submodule.mem_sup_left (hO f hfW hf hfm)
      haveI := FiniteDimensional.span_singleton K h
      exact ⟨W, Submodule.finiteDimensional_of_le hle, hW⟩
    · have hle : W ≤ V := by
        intro f hfW
        by_cases hf : f = 0
        · rw [hf]; exact Submodule.zero_mem _
        by_cases hfm : ord 0 f = -((N + 1 : ℕ) : ℤ)
        · rcases (hW f).mp hfW with h0 | ⟨hfR, -⟩
          · exact absurd h0 hf
          exact absurd ⟨f, hf, hfR, hfm⟩ hex
        · exact hO f hfW hf hfm
      exact ⟨W, Submodule.finiteDimensional_of_le hle, hW⟩

theorem exists_ellipticDivisorCalculus (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] [DecidableEq (AlgebraicClosure F)]
    (E : WeierstrassCurve F) (hΔ : E.Δ ≠ 0) :
    ∃ (ord : EllipticRootNumber.Pts F E →
        FractionRing (E.baseChange (AlgebraicClosure F)).toAffine.CoordinateRing → ℤ)
      (τ : EllipticRootNumber.Pts F E →
        (FractionRing (E.baseChange (AlgebraicClosure F)).toAffine.CoordinateRing ≃ₐ[AlgebraicClosure F]
          FractionRing (E.baseChange (AlgebraicClosure F)).toAffine.CoordinateRing))
      (γ : EllipticRootNumber.AbsGal F →
        (FractionRing (E.baseChange (AlgebraicClosure F)).toAffine.CoordinateRing ≃+*
          FractionRing (E.baseChange (AlgebraicClosure F)).toAffine.CoordinateRing)),
      (∀ R f g, f ≠ 0 → g ≠ 0 → ord R (f * g) = ord R f + ord R g) ∧
      (∀ R (c : AlgebraicClosure F), c ≠ 0 →
        ord R (algebraMap (AlgebraicClosure F) _ c) = 0) ∧
      (∀ f, f ≠ 0 → ∃ s : Finset (EllipticRootNumber.Pts F E),
        (∀ R, R ∉ s → ord R f = 0) ∧ ∑ R ∈ s, ord R f = 0) ∧
      (∀ f, f ≠ 0 → (∀ R, 0 ≤ ord R f) →
        ∃ c : AlgebraicClosure F, algebraMap (AlgebraicClosure F) _ c = f) ∧
      (∀ (N : ℕ) (Q : EllipticRootNumber.Pts F E), N • Q = 0 → ∃ f, f ≠ 0 ∧ ∀ R,
        ord R f = @ite ℤ (R = -Q) (Classical.propDecidable _) (N : ℤ) 0 -
          @ite ℤ (R = 0) (Classical.propDecidable _) (N : ℤ) 0) ∧
      (∀ N : ℕ, ∃ V : Submodule (AlgebraicClosure F)
          (FractionRing (E.baseChange (AlgebraicClosure F)).toAffine.CoordinateRing),
        FiniteDimensional (AlgebraicClosure F) V ∧
        ∀ f, f ∈ V ↔ (f = 0 ∨ ((∀ R, R ≠ 0 → 0 ≤ ord R f) ∧ -(N : ℤ) ≤ ord 0 f))) ∧
      (∀ Q R f, f ≠ 0 → ord R (τ Q f) = ord (R + Q) f) ∧
      (∀ P Q f, τ P (τ Q f) = τ (P + Q) f) ∧
      (∀ (σ : EllipticRootNumber.AbsGal F) (c : AlgebraicClosure F),
        γ σ (algebraMap (AlgebraicClosure F) _ c) = algebraMap (AlgebraicClosure F) _ (σ c)) ∧
      (∀ σ R f, f ≠ 0 → ord (EllipticRootNumber.galHom F E σ R) (γ σ f) = ord R f) ∧
      (∀ σ Q f, γ σ (τ Q f) = τ (EllipticRootNumber.galHom F E σ Q) (γ σ f)) :=
by
  have hW : (E.baseChange (AlgebraicClosure F)).Δ ≠ 0 := by
    show (E.map (algebraMap F (AlgebraicClosure F))).Δ ≠ 0
    rw [WeierstrassCurve.map_Δ]
    exact (map_ne_zero _).mpr hΔ
  set W := E.baseChange (AlgebraicClosure F) with hWdef
  
  obtain ⟨v, vmul, vultra, vconst, vdeg, vres⟩ := coordRing_exists_ordInfty W
  obtain ⟨τ, hτ, hform⟩ := coordRing_exists_translations W hW
  obtain ⟨κ, κX, κY, κA⟩ := coordRing_exists_conj W
  have hσW : ∀ σ : EllipticRootNumber.AbsGal F,
      W.map ((σ.toRingEquiv : AlgebraicClosure F ≃+* AlgebraicClosure F) :
        AlgebraicClosure F →+* AlgebraicClosure F) = W := fun σ =>
    WeierstrassCurve.map_baseChange E (σ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)
  choose γ hγc hγX hγY hγA using fun σ : EllipticRootNumber.AbsGal F =>
    coordRing_exists_coeffAction W σ.toRingEquiv (hσW σ)
  have hγc' : ∀ (σ : EllipticRootNumber.AbsGal F) (c : AlgebraicClosure F),
      γ σ (algebraMap (AlgebraicClosure F) (FractionRing W.toAffine.CoordinateRing) c) =
        algebraMap (AlgebraicClosure F) (FractionRing W.toAffine.CoordinateRing) (σ c) :=
    fun σ c => hγc σ c
  have hσa : ∀ σ : EllipticRootNumber.AbsGal F, σ W.a₁ = W.a₁ ∧ σ W.a₂ = W.a₂ ∧ σ W.a₃ = W.a₃ :=
    fun σ => ⟨congrArg WeierstrassCurve.a₁ (hσW σ), congrArg WeierstrassCurve.a₂ (hσW σ),
      congrArg WeierstrassCurve.a₃ (hσW σ)⟩
