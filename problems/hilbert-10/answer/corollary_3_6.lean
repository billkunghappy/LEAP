        ((Quotient.out c' : EllipticRootNumber.relWeil F L) : EllipticRootNumber.AbsGal F) m := hval
    rw [Subgroup.coe_mul, Subgroup.coe_inv, AlgEquiv.mul_apply, ← hval', ← AlgEquiv.mul_apply,
      inv_mul_cancel, AlgEquiv.one_apply]
  
  have s2 : ∀ σ τ : EllipticRootNumber.AbsGal F, τ ∈ EllipticRootNumber.inertia F →
      σ * τ * σ⁻¹ ∈ EllipticRootNumber.inertia F := by
    intro σ τ hτ
    have hstab : ∀ x ∈ EllipticRootNumber.unramifiedClosure F,
        σ⁻¹ x ∈ EllipticRootNumber.unramifiedClosure F := by
      intro x hx
      unfold EllipticRootNumber.unramifiedClosure at hx ⊢
      induction hx using IntermediateField.adjoin_induction with
      | mem x hx =>
        apply IntermediateField.subset_adjoin
        obtain ⟨n, hn, hp, hxn⟩ := hx
