    · exact ⟨j - i, by omega, key i j h hfij⟩
    · exact ⟨i - j, by omega, key j i h hfij.symm⟩
  
  set c : EllipticRootNumber.relWeil F ⊥ := w * w' * w⁻¹ * w'⁻¹ with hc
  have hcI' : (c : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F := by
