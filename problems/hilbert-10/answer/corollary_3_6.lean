        have hz : (-(2 * (m₀ : ℤ) + 1)) = -((n : ℤ) + 1) := by omega
        rw [← hz]
        exact hc'2
    · rcases Int.even_or_odd κ with hke | hko
      · have hm1 : Valued.v (-1 : v.adicCompletion K) = WithZero.exp (0 : ℤ) := by
          rw [Valuation.map_neg, Valuation.map_one, WithZero.exp_zero]
        have hpar : Even ((0 : ℤ) - κ) := by
          have h := hke.neg
          simpa using h
        obtain ⟨Q, hQ⟩ := hs3 (-1) b 0 κ hm1 hκ hpar
        have hβ : Valued.v (b * Q ^ 2 - 1) ≤ WithZero.exp (-1 : ℤ) := by
          have heq : b * Q ^ 2 - 1 = -1 + b * Q ^ 2 := by ring
          rw [heq, show (-1 : ℤ) = (0 : ℤ) - 1 by ring]
          exact hQ
        obtain ⟨p, q, r, hpqr⟩ := hsplit 1 Q Q
        have hid : y * 1 ^ 2 + b * Q ^ 2 - y * b * Q ^ 2 - 1
            = -((y - 1) * (b * Q ^ 2 - 1)) := by ring
        have hlevel : Valued.v (y * 1 ^ 2 + b * Q ^ 2 - y * b * Q ^ 2 - 1)
            ≤ WithZero.exp (-((n : ℤ) + 1)) := by
          rw [hid, Valuation.map_neg, map_mul]
          calc Valued.v (y - 1) * Valued.v (b * Q ^ 2 - 1)
              ≤ WithZero.exp (-(n : ℤ)) * WithZero.exp (-1 : ℤ) := mul_le_mul' hlev hβ
            _ = WithZero.exp (-((n : ℤ) + 1)) := by
                rw [← WithZero.exp_add]; congr 1; ring
        have hunit' : Valued.v (y * 1 ^ 2 + b * Q ^ 2 - y * b * Q ^ 2) = 1 := by
          have hlt : Valued.v (-((y - 1) * (b * Q ^ 2 - 1))) < 1 := by
            rw [← hid]
            exact lt_of_le_of_lt hlevel hlt1
          rw [show y * 1 ^ 2 + b * Q ^ 2 - y * b * Q ^ 2
              = 1 + -((y - 1) * (b * Q ^ 2 - 1)) by ring]
          exact Valuation.map_one_add_of_lt Valued.v hlt
        exact ⟨y * 1 ^ 2 + b * Q ^ 2 - y * b * Q ^ 2, hunit', hlevel, p, q, r, hpqr⟩
      · obtain ⟨k, hk⟩ := hno
        obtain ⟨l, hl⟩ := hko
        have hpar : Even (-(n : ℤ) - κ) :=
          ⟨-((k : ℤ) + l + 1), by rw [hk, hl]; push_cast; ring⟩
        obtain ⟨Q, hQ⟩ := hs3 (y - 1) b (-(n : ℤ)) κ hθex hκ hpar
        obtain ⟨p, q, r, hpqr⟩ := hsplit 1 Q 0
        have hid : y * 1 ^ 2 + b * Q ^ 2 - y * b * 0 ^ 2 - 1 = (y - 1) + b * Q ^ 2 := by ring
        have hlevel : Valued.v (y * 1 ^ 2 + b * Q ^ 2 - y * b * 0 ^ 2 - 1)
            ≤ WithZero.exp (-((n : ℤ) + 1)) := by
          rw [hid, show (-((n : ℤ) + 1)) = -(n : ℤ) - 1 by ring]
          exact hQ
        have hunit' : Valued.v (y * 1 ^ 2 + b * Q ^ 2 - y * b * 0 ^ 2) = 1 := by
          have hlt : Valued.v ((y - 1) + b * Q ^ 2) < 1 := by
            rw [← hid]
            exact lt_of_le_of_lt hlevel hlt1
          rw [show y * 1 ^ 2 + b * Q ^ 2 - y * b * 0 ^ 2
              = 1 + ((y - 1) + b * Q ^ 2) by ring]
          exact Valuation.map_one_add_of_lt Valued.v hlt
        exact ⟨y * 1 ^ 2 + b * Q ^ 2 - y * b * 0 ^ 2, hunit', hlevel, p, q, r, hpqr⟩
  
  have hsub1 : ∀ z : v.adicCompletion K, Valued.v z = 1 → Valued.v (z - 1) ≤ 1 := by
    intro z hz
    have h := Valuation.map_sub Valued.v z 1
    rw [hz] at h
    simpa using h
  have key : ∀ n : ℕ, n ≤ 2 * e → ∃ y : v.adicCompletion K,
      Valued.v y = 1 ∧ Valued.v (y - 1) ≤ WithZero.exp (-(n : ℤ)) ∧
      ∃ p q r : v.adicCompletion K, δ * p ^ 2 + x * q ^ 2 - δ * x * r ^ 2 = y := by
    intro n
    induction n with
    | zero =>
        intro _
        have hzero : WithZero.exp (-((0 : ℕ) : ℤ)) = (1 : WithZero (Multiplicative ℤ)) := by
          simp
        obtain ⟨m₁, hm₁⟩ := hvalE δ hδ
        obtain ⟨m₂, hm₂⟩ := hvalE x hx
        rcases Int.even_or_odd m₁ with ⟨k, hk⟩ | ho₁
        · have hy1 : Valued.v (δ * (ϖ ^ k) ^ 2) = 1 := hunit δ m₁ k hm₁ hk
          exact ⟨δ * (ϖ ^ k) ^ 2, hy1, by rw [hzero]; exact hsub1 _ hy1,
            ϖ ^ k, 0, 0, by ring⟩
        · rcases Int.even_or_odd m₂ with ⟨k, hk⟩ | ho₂
          · have hy1 : Valued.v (x * (ϖ ^ k) ^ 2) = 1 := hunit x m₂ k hm₂ hk
            exact ⟨x * (ϖ ^ k) ^ 2, hy1, by rw [hzero]; exact hsub1 _ hy1,
              0, ϖ ^ k, 0, by ring⟩
          · obtain ⟨k, hk⟩ : Even (m₁ + m₂) := ho₁.add_odd ho₂
            have hdx : Valued.v (δ * x) = WithZero.exp (m₁ + m₂) := by
              rw [map_mul, hm₁, hm₂, ← WithZero.exp_add]
            have hy1 : Valued.v (-(δ * x * (ϖ ^ k) ^ 2)) = 1 := by
              rw [Valuation.map_neg]
              exact hunit (δ * x) (m₁ + m₂) k hdx hk
            exact ⟨-(δ * x * (ϖ ^ k) ^ 2), hy1, by rw [hzero]; exact hsub1 _ hy1,
              0, 0, ϖ ^ k, by ring⟩
    | succ n ih =>
        intro hle
        have hn : n ≤ 2 * e := Nat.le_of_succ_le hle
        have hnlt : n < 2 * e := lt_of_lt_of_le (Nat.lt_succ_self n) hle
        obtain ⟨y, hy1, hylev, p, q, r, hpqr⟩ := ih hn
        have hy0 : y ≠ 0 := by
          intro h
          rw [h, map_zero] at hy1
          exact zero_ne_one hy1
        obtain ⟨b, hb0, hsplit⟩ := s2 y p q r hy0 hpqr
        obtain ⟨y', hy'1, hy'lev, hy'V⟩ := s5 n hnlt y hy1 hylev b hb0 hsplit
        refine ⟨y', hy'1, ?_, hy'V⟩
        have hcast : (((n + 1 : ℕ) : ℤ)) = (n : ℤ) + 1 := by push_cast; ring
        rw [hcast]
        exact hy'lev
  
  obtain ⟨y, hy1, hylev, p, q, r, hpqr⟩ := key (2 * e) le_rfl
  have hy0 : y ≠ 0 := by
    intro h
    rw [h, map_zero] at hy1
    exact zero_ne_one hy1
  have h40 : (4 : v.adicCompletion K) ≠ 0 := by
    intro hcon
    have hmm : (2 : v.adicCompletion K) * 2 = 0 := by linear_combination hcon
    rcases mul_eq_zero.mp hmm with h | h <;> exact h20 h
  have hylev' : Valued.v (y - 1) ≤ WithZero.exp (-(2 * (e : ℤ))) := by
    have hcast : (((2 * e : ℕ) : ℤ)) = 2 * (e : ℤ) := by push_cast; ring
    rwa [hcast] at hylev
  have hy4 : (1 : v.adicCompletion K) + 4 * ((y - 1) / 4) = y := by
    field_simp
    ring
  refine ⟨p, q, r, 1, (y - 1) / 4, one_ne_zero, ?_, ?_, ?_⟩
  · rw [map_div₀, h4e]
    exact (div_le_one₀ (zero_lt_iff.mpr WithZero.exp_ne_zero)).mpr hylev'
  · intro t ht
    rw [hy4] at ht
    obtain ⟨-, -, ht0, -⟩ := hani4 p q t r (by linear_combination hpqr - ht)
    exact hy0 (by rw [← ht, ht0]; norm_num)
  · rw [hy4]
    linear_combination hpqr

theorem unramified_unit_eq_sq_mul_one_add_four_mul {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : Valued.v (2 : v.adicCompletion K) ≠ 1)
    (c : v.adicCompletion K) (hc : Valued.v c = 1)
    (hcU : ∀ u : v.adicCompletion K, Valued.v u = 1 →
        ∃ z t : v.adicCompletion K, z ^ 2 - c * t ^ 2 = u) :
    ∃ s ρ : v.adicCompletion K, s ≠ 0 ∧ Valued.v ρ ≤ 1 ∧ c = s ^ 2 * (1 + 4 * ρ) :=
by
  classical
  
  have hsqa : ∀ z : v.adicCompletion K, Valued.v z ≤ 1 →
      ∃ s : v.adicCompletion K, Valued.v s ≤ 1 ∧ Valued.v (s ^ 2 - z) < 1 := by
    intro z hz
    
    have approx : ∀ k : K, IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 →
        ∃ a : NumberField.RingOfIntegers K,
          IsDedekindDomain.HeightOneSpectrum.valuation K v
            (k - algebraMap (NumberField.RingOfIntegers K) K a) < 1 := by
      intro k hk
      obtain ⟨n, d, hd, hnd⟩ := IsFractionRing.div_surjective (A := NumberField.RingOfIntegers K) k
      have hd0 : d ≠ 0 := nonZeroDivisors.ne_zero hd
      have hιd : algebraMap (NumberField.RingOfIntegers K) K d ≠ 0 := by
        rw [ne_eq, map_eq_zero_iff _ (IsFractionRing.injective (NumberField.RingOfIntegers K) K)]
        exact hd0
      have hn : algebraMap (NumberField.RingOfIntegers K) K n =
          k * algebraMap (NumberField.RingOfIntegers K) K d := by
        rw [← hnd, div_mul_cancel₀ _ hιd]
      have hv0 : v.intValuation d ≠ 0 := v.intValuation_ne_zero d hd0
      have hv1 : v.intValuation d ≤ 1 := v.intValuation_le_one d
      have hlog : WithZero.log (v.intValuation d) ≤ 0 := by
        have h1 : WithZero.exp (WithZero.log (v.intValuation d)) ≤ WithZero.exp (0 : ℤ) := by
          rw [WithZero.exp_log hv0, WithZero.exp_zero]; exact hv1
        exact WithZero.exp_le_exp.mp h1
      obtain ⟨m, hm⟩ : ∃ m : ℕ, v.intValuation d = WithZero.exp (-(m : ℤ)) := by
        refine ⟨(-WithZero.log (v.intValuation d)).toNat, ?_⟩
        rw [Int.toNat_of_nonneg (by omega), neg_neg, WithZero.exp_log hv0]
      obtain ⟨J, hJ⟩ : v.asIdeal ^ m ∣ Ideal.span {d} :=
        (v.intValuation_le_pow_iff_dvd d m).mp hm.le
      have hJP : ¬ J ≤ v.asIdeal := by
        intro hle
        have h3 : v.asIdeal ^ (m + 1) ∣ Ideal.span {d} := by
          rw [hJ, pow_succ]
          exact mul_dvd_mul_left _ (Ideal.dvd_iff_le.mpr hle)
        have h2 := (v.intValuation_le_pow_iff_dvd d (m + 1)).mpr h3
        rw [hm, WithZero.exp_le_exp] at h2
        push_cast at h2
        omega
      obtain ⟨t, htJ, htP⟩ := Set.not_subset.mp hJP
      have hnv : v.intValuation n ≤ WithZero.exp (-(m : ℤ)) := by
        have e1 : v.intValuation n = IsDedekindDomain.HeightOneSpectrum.valuation K v
            (algebraMap (NumberField.RingOfIntegers K) K n) :=
          (v.valuation_of_algebraMap (K := K) n).symm
        have e2 : v.intValuation d = IsDedekindDomain.HeightOneSpectrum.valuation K v
            (algebraMap (NumberField.RingOfIntegers K) K d) :=
          (v.valuation_of_algebraMap (K := K) d).symm
        rw [e1, hn, map_mul, ← e2, hm]
        calc _ ≤ 1 * WithZero.exp (-(m : ℤ)) := mul_le_mul_right' hk _
          _ = _ := one_mul _
      have hnP : n ∈ v.asIdeal ^ m :=
        Ideal.dvd_span_singleton.mp ((v.intValuation_le_pow_iff_dvd n m).mp hnv)
      have hnt : n * t ∈ Ideal.span {d} := by
        rw [hJ]; exact Ideal.mul_mem_mul hnP htJ
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hnt
      have hbk : algebraMap (NumberField.RingOfIntegers K) K b =
          algebraMap (NumberField.RingOfIntegers K) K t * k := by
        have h4 := congrArg (algebraMap (NumberField.RingOfIntegers K) K) hb
        rw [map_mul, map_mul, hn] at h4
        apply mul_right_cancel₀ hιd
        rw [h4]; ring
      obtain ⟨s, i, hi, hsi⟩ := v.isMaximal.exists_inv htP
      refine ⟨s * b, ?_⟩
      have h1 : algebraMap (NumberField.RingOfIntegers K) K s *
          algebraMap (NumberField.RingOfIntegers K) K t +
          algebraMap (NumberField.RingOfIntegers K) K i = 1 := by
        rw [← map_mul, ← map_add, hsi, map_one]
      have key : algebraMap (NumberField.RingOfIntegers K) K t *
          (k - algebraMap (NumberField.RingOfIntegers K) K (s * b)) =
          algebraMap (NumberField.RingOfIntegers K) K b *
            algebraMap (NumberField.RingOfIntegers K) K i := by
        rw [map_mul]
        linear_combination (-1 : K) * hbk - algebraMap (NumberField.RingOfIntegers K) K b * h1
      have hvt : IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K t) = 1 := by
        rw [v.valuation_of_algebraMap]; exact (v.intValuation_eq_one_iff).mpr htP
      have hvb : IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K b) ≤ 1 := v.valuation_le_one (K := K) b
      have hvi : IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K i) < 1 :=
        (v.valuation_lt_one_iff_mem (K := K) i).mpr hi
      have h5 := congrArg (IsDedekindDomain.HeightOneSpectrum.valuation K v) key
      rw [map_mul (IsDedekindDomain.HeightOneSpectrum.valuation K v), hvt, one_mul,
        map_mul (IsDedekindDomain.HeightOneSpectrum.valuation K v)] at h5
      rw [h5]
      calc _ ≤ 1 * IsDedekindDomain.HeightOneSpectrum.valuation K v
            (algebraMap (NumberField.RingOfIntegers K) K i) := mul_le_mul_right' hvb _
        _ = _ := one_mul _
        _ < 1 := hvi
    have hval : ∀ x : K, Valued.v (algebraMap K (v.adicCompletion K) x) =
        IsDedekindDomain.HeightOneSpectrum.valuation K v x := fun x =>
      IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v x
    
    have hker : ∀ x : v.adicCompletionIntegers K,
        IsLocalRing.residue _ x = 0 ↔ Valued.v (x : v.adicCompletion K) < 1 := fun x =>
      (IsLocalRing.residue_eq_zero_iff x).trans
        (Valuation.mem_maximalIdeal_iff (v.adicCompletion K) Valued.v (a := x))
    
    have hfin : Finite (IsLocalRing.ResidueField (v.adicCompletionIntegers K)) := by
      have hRK : ∀ r : NumberField.RingOfIntegers K,
          algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r =
            algebraMap K (v.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K r) :=
        fun r => IsScalarTower.algebraMap_apply _ _ _ r
      have hint : ∀ r : NumberField.RingOfIntegers K,
          algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r ∈
            v.adicCompletionIntegers K := by
        intro r
        rw [IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers, hRK, hval]
        exact v.valuation_le_one r
      let φ := (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K)).codRestrict
        (v.adicCompletionIntegers K) hint
      let ψ := (IsLocalRing.residue (v.adicCompletionIntegers K)).comp φ
      have hψ : ∀ r ∈ v.asIdeal, ψ r = 0 := by
        intro r hr
        show IsLocalRing.residue _ (φ r) = 0
        rw [hker]
        show Valued.v (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r) < 1
        rw [hRK, hval]
        exact (v.valuation_lt_one_iff_mem r).mpr hr
      let ψbar := Ideal.Quotient.lift v.asIdeal ψ hψ
      have hdense : DenseRange (algebraMap K (v.adicCompletion K)) := by
        have h := @UniformSpace.Completion.denseRange_coe
          (WithVal (IsDedekindDomain.HeightOneSpectrum.valuation K v)) _
        exact h
      have hsurj : Function.Surjective ψbar := by
        intro y
        obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective y
        have hU : {z : v.adicCompletion K | Valued.v (z - (x : v.adicCompletion K)) < 1} ∈
            nhds (x : v.adicCompletion K) :=
          Valued.mem_nhds.mpr ⟨1, fun z hz => by simpa using hz⟩
        obtain ⟨k, hk⟩ := hdense.mem_nhds hU
        simp only [Set.mem_setOf_eq] at hk
        have hk1 : IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 := by
          rw [← hval]
          have e : algebraMap K (v.adicCompletion K) k =
              (algebraMap K (v.adicCompletion K) k - x) + x := by ring
          rw [e]
          exact le_trans (Valuation.map_add _ _ _) (max_le hk.le x.2)
        obtain ⟨a, ha⟩ := approx k hk1
        refine ⟨Ideal.Quotient.mk v.asIdeal a, ?_⟩
        show ψ a = IsLocalRing.residue _ x
        show IsLocalRing.residue _ (φ a) = IsLocalRing.residue _ x
        rw [← sub_eq_zero, ← map_sub, hker]
        show Valued.v (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) a -
          (x : v.adicCompletion K)) < 1
        have e : algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) a -
            (x : v.adicCompletion K) =
            -(algebraMap K (v.adicCompletion K)
                (k - algebraMap (NumberField.RingOfIntegers K) K a)) +
              (algebraMap K (v.adicCompletion K) k - x) := by
          rw [hRK, map_sub]; ring
        rw [e]
        refine Valuation.map_add_lt _ ?_ hk
        rw [Valuation.map_neg, hval]
        exact ha
      haveI : Finite (NumberField.RingOfIntegers K ⧸ v.asIdeal) :=
        Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
      exact Finite.of_surjective ψbar hsurj
    
    have h2lt : Valued.v (2 : v.adicCompletion K) < 1 := by
      refine lt_of_le_of_ne ?_ h2
      rw [← one_add_one_eq_two]
      exact le_trans (Valuation.map_add _ _ _) (by rw [map_one, max_self])
    
    have h2k : (2 : IsLocalRing.ResidueField (v.adicCompletionIntegers K)) = 0 := by
      rw [← map_ofNat (IsLocalRing.residue (v.adicCompletionIntegers K)) 2, hker]
      exact h2lt
    
    have hsqinj : Function.Injective
        (fun t : IsLocalRing.ResidueField (v.adicCompletionIntegers K) => t ^ 2) := by
      intro t u htu
      simp only at htu
      have h0 : (t - u) ^ 2 = 0 := by
        linear_combination htu + (u ^ 2 - t * u) * h2k
      exact sub_eq_zero.mp ((pow_eq_zero_iff two_ne_zero).mp h0)
    have hsqsurj := Finite.injective_iff_surjective.mp hsqinj
    have hzO : z ∈ v.adicCompletionIntegers K :=
      (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers _ _ v).mpr hz
    set z' : v.adicCompletionIntegers K := ⟨z, hzO⟩ with hz'
    obtain ⟨σ, hσ⟩ := hsqsurj (IsLocalRing.residue _ z')
    obtain ⟨s', rfl⟩ := IsLocalRing.residue_surjective σ
    refine ⟨(s' : v.adicCompletion K), s'.2, ?_⟩
    have he : ((s' ^ 2 - z' : v.adicCompletionIntegers K) : v.adicCompletion K) =
        (s' : v.adicCompletion K) ^ 2 - z := rfl
    rw [← he, ← hker, map_sub, map_pow]
    exact sub_eq_zero.mpr hσ
  
  haveI : CharZero (v.adicCompletion K) :=
    charZero_of_injective_algebraMap (algebraMap K (v.adicCompletion K)).injective
  have hval : ∀ x : K, Valued.v (algebraMap K (v.adicCompletion K) x) =
      IsDedekindDomain.HeightOneSpectrum.valuation K v x :=
    fun x => IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v x
  obtain ⟨π₀, hπ₀⟩ := IsDedekindDomain.HeightOneSpectrum.valuation_exists_uniformizer K v
  obtain ⟨ϖ, hϖdef⟩ : ∃ ϖ : v.adicCompletion K, ϖ = algebraMap K (v.adicCompletion K) π₀ :=
    ⟨_, rfl⟩
  have hϖ : Valued.v ϖ = WithZero.exp (-1 : ℤ) := by rw [hϖdef, hval, hπ₀]
  have hϖ0 : ϖ ≠ 0 := by
    intro h
    rw [h, map_zero] at hϖ
    exact WithZero.exp_ne_zero hϖ.symm
  have hϖ' : Valued.v ϖ = ((Multiplicative.ofAdd (-1 : ℤ) : Multiplicative ℤ) :
      WithZero (Multiplicative ℤ)) := hϖ
  have hvp : ∀ j : ℕ, Valued.v (ϖ ^ j) = WithZero.exp (-(j : ℤ)) := by
    intro j
    induction j with
    | zero => rw [pow_zero, map_one, Nat.cast_zero, neg_zero, WithZero.exp_zero]
    | succ j ih =>
      rw [pow_succ, map_mul, ih, hϖ, ← WithZero.exp_add]
      congr 1
      push_cast
      ring
  
  have hstep : ∀ (x : WithZero (Multiplicative ℤ)) (n : ℤ), x < WithZero.exp n →
      x ≤ WithZero.exp (n - 1) := by
    intro x n hx
    by_cases hx0 : x = 0
    · rw [hx0]; exact zero_le'
    · rw [← WithZero.exp_log hx0] at hx ⊢
      rw [WithZero.exp_lt_exp] at hx
      rw [WithZero.exp_le_exp]
      omega
  have hcancel : ∀ (x : WithZero (Multiplicative ℤ)) (a b : ℤ),
      x * WithZero.exp a ≤ WithZero.exp b → x ≤ WithZero.exp (b - a) := by
    intro x a b h
    by_cases hx0 : x = 0
    · rw [hx0]; exact zero_le'
    · rw [← WithZero.exp_log hx0] at h ⊢
      rw [← WithZero.exp_add, WithZero.exp_le_exp] at h
      rw [WithZero.exp_le_exp]
      omega
  
  have h2le : Valued.v (2 : v.adicCompletion K) ≤ 1 := by
    rw [← one_add_one_eq_two]
    exact le_trans (Valuation.map_add _ _ _) (by rw [map_one, max_self])
  have h2ne0 : Valued.v (2 : v.adicCompletion K) ≠ 0 := by
    rw [ne_eq, Valuation.zero_iff]; exact two_ne_zero
  obtain ⟨e, he, he1⟩ : ∃ e : ℕ, Valued.v (2 : v.adicCompletion K) = WithZero.exp (-(e : ℤ)) ∧
      1 ≤ e := by
    have hlog : WithZero.log (Valued.v (2 : v.adicCompletion K)) ≤ 0 := by
      have h1 : WithZero.exp (WithZero.log (Valued.v (2 : v.adicCompletion K))) ≤
          WithZero.exp (0 : ℤ) := by
        rw [WithZero.exp_log h2ne0, WithZero.exp_zero]; exact h2le
      exact WithZero.exp_le_exp.mp h1
    have hlog0 : WithZero.log (Valued.v (2 : v.adicCompletion K)) ≠ 0 := by
      intro h0
      apply h2
      rw [← WithZero.exp_log h2ne0, h0, WithZero.exp_zero]
    refine ⟨(-WithZero.log (Valued.v (2 : v.adicCompletion K))).toNat, ?_, ?_⟩
    · rw [Int.toNat_of_nonneg (by omega), neg_neg, WithZero.exp_log h2ne0]
    · omega
  have h4 : Valued.v (4 : v.adicCompletion K) = WithZero.exp (-((2 * e : ℕ) : ℤ)) := by
    rw [show (4 : v.adicCompletion K) = 2 * 2 by norm_num, map_mul, he, ← WithZero.exp_add]
    congr 1
    push_cast
    ring
  
  have Nmul : ∀ (δ x y : v.adicCompletion K),
      (∃ z t : v.adicCompletion K, z ^ 2 - δ * t ^ 2 = x) →
      (∃ z t : v.adicCompletion K, z ^ 2 - δ * t ^ 2 = y) →
      ∃ z t : v.adicCompletion K, z ^ 2 - δ * t ^ 2 = x * y := by
    rintro δ x y ⟨z₁, t₁, rfl⟩ ⟨z₂, t₂, rfl⟩
    exact ⟨z₁ * z₂ + δ * t₁ * t₂, z₁ * t₂ + t₁ * z₂, by ring⟩
  have Ninv : ∀ (δ x : v.adicCompletion K), x ≠ 0 →
      (∃ z t : v.adicCompletion K, z ^ 2 - δ * t ^ 2 = x) →
      ∃ z t : v.adicCompletion K, z ^ 2 - δ * t ^ 2 = x⁻¹ := by
    rintro δ x hx ⟨z, t, rfl⟩
    have hinv : (z ^ 2 - δ * t ^ 2) * (z ^ 2 - δ * t ^ 2)⁻¹ = 1 := mul_inv_cancel₀ hx
    refine ⟨z * (z ^ 2 - δ * t ^ 2)⁻¹, t * (z ^ 2 - δ * t ^ 2)⁻¹, ?_⟩
    linear_combination (z ^ 2 - δ * t ^ 2)⁻¹ * hinv
  have Rec : ∀ (Y X z t : v.adicCompletion K), Y ≠ 0 → z ^ 2 - X * t ^ 2 = Y →
      ∃ z' t' : v.adicCompletion K, z' ^ 2 - Y * t' ^ 2 = X := by
    intro Y X z t hY h
    by_cases ht : t = 0
    · subst ht
      have hz : z ≠ 0 := by
        rintro rfl
        apply hY
        rw [← h]
        ring
      have hinv : z * z⁻¹ = 1 := mul_inv_cancel₀ hz
      refine ⟨(X + 1) / 2, (X - 1) * z⁻¹ / 2, ?_⟩
      linear_combination ((X - 1) ^ 2 / 4 * z⁻¹ ^ 2) * h -
        ((X - 1) ^ 2 / 4 * (z * z⁻¹ + 1)) * hinv
    · have hinv : t * t⁻¹ = 1 := mul_inv_cancel₀ ht
      refine ⟨z * t⁻¹, t⁻¹, ?_⟩
      linear_combination t⁻¹ ^ 2 * h + X * (t * t⁻¹ + 1) * hinv
  
  have stepB : ∀ m : ℕ, m < e → ∀ γ : v.adicCompletion K, Valued.v γ ≤ 1 →
      Valued.v (c - γ ^ 2) ≤ WithZero.exp (-((2 * m : ℕ) : ℤ)) →
      ∃ γ' : v.adicCompletion K, Valued.v γ' ≤ 1 ∧
        Valued.v (c - γ' ^ 2) ≤ WithZero.exp (-((2 * m + 1 : ℕ) : ℤ)) := by
    intro m hm γ hγ hlev
    have hP0 : ϖ ^ m ≠ 0 := pow_ne_zero _ hϖ0
    have hvP2 : Valued.v ((ϖ ^ m) ^ 2) = WithZero.exp (-((2 * m : ℕ) : ℤ)) := by
      rw [← pow_mul, mul_comm m 2, hvp]
    obtain ⟨u, hu_def⟩ : ∃ u : v.adicCompletion K, u = (c - γ ^ 2) / (ϖ ^ m) ^ 2 := ⟨_, rfl⟩
    have hu : u * (ϖ ^ m) ^ 2 = c - γ ^ 2 := by
      rw [hu_def]; exact div_mul_cancel₀ _ (pow_ne_zero 2 hP0)
    have hu1 : Valued.v u ≤ 1 := by
      have h := congrArg Valued.v hu
      rw [map_mul, hvP2] at h
      have h' := hcancel _ _ _ (h.le.trans hlev)
      rwa [sub_self, WithZero.exp_zero] at h'
    obtain ⟨d, hd, hdu⟩ := hsqa u hu1
    have hd2 : Valued.v (d ^ 2 - u) ≤ WithZero.exp (-1 : ℤ) := by
      have h := hstep _ 0 (by rw [WithZero.exp_zero]; exact hdu)
      rwa [zero_sub] at h
    have hid : c - (γ + ϖ ^ m * d) ^ 2 = -((ϖ ^ m) ^ 2 * (d ^ 2 - u)) - 2 * ϖ ^ m * γ * d := by
      linear_combination (-1 : v.adicCompletion K) * hu
    have bound1 : Valued.v ((ϖ ^ m) ^ 2 * (d ^ 2 - u)) ≤
        WithZero.exp (-((2 * m + 1 : ℕ) : ℤ)) := by
      rw [map_mul, hvP2]
      calc _ ≤ WithZero.exp (-((2 * m : ℕ) : ℤ)) * WithZero.exp (-1 : ℤ) :=
            mul_le_mul_left' hd2 _
        _ = _ := by
          rw [← WithZero.exp_add]
          congr 1
          push_cast
          ring
    have bound2 : Valued.v (2 * ϖ ^ m * γ * d) ≤ WithZero.exp (-((2 * m + 1 : ℕ) : ℤ)) := by
      rw [map_mul, map_mul, map_mul, he, hvp m]
      calc _ ≤ WithZero.exp (-(e : ℤ)) * WithZero.exp (-(m : ℤ)) * 1 * 1 :=
            mul_le_mul' (mul_le_mul' le_rfl hγ) hd
        _ = WithZero.exp (-(e : ℤ) + -(m : ℤ)) := by rw [mul_one, mul_one, ← WithZero.exp_add]
        _ ≤ _ := WithZero.exp_le_exp.mpr (by push_cast; omega)
    refine ⟨γ + ϖ ^ m * d, ?_, ?_⟩
    · have hm1 : Valued.v (ϖ ^ m * d) ≤ 1 := by
        rw [map_mul, hvp m]
        calc _ ≤ 1 * 1 := mul_le_mul' (by
              rw [← WithZero.exp_zero, WithZero.exp_le_exp]; omega) hd
          _ = 1 := one_mul 1
      exact le_trans (Valuation.map_add _ _ _) (max_le hγ hm1)
    · rw [hid]
      refine le_trans (Valuation.map_sub _ _ _) (max_le ?_ bound2)
      rw [Valuation.map_neg]
      exact bound1
  
  have stepC : ∀ m : ℕ, 2 * m + 1 < 2 * e → ∀ γ : v.adicCompletion K,
      Valued.v (c - γ ^ 2) = WithZero.exp (-((2 * m + 1 : ℕ) : ℤ)) → False := by
    intro m hm γ hlev
    obtain ⟨ρ₀, hρ⟩ := exists_artinSchreier_element_adicCompletion v
    obtain ⟨hb1, hϖN⟩ := artinSchreier_unit_and_uniformizer_not_norm v h2 ρ₀ hρ ϖ hϖ'
    have hbU : ∀ u : v.adicCompletion K, Valued.v u = 1 →
        ∃ z t : v.adicCompletion K, z ^ 2 - (1 + 4 * ρ₀) * t ^ 2 = u :=
      fun u hu => exists_norm_of_unit_artinSchreier v h2 ρ₀ hρ u hu
    have hρ1 : Valued.v ρ₀ = 1 := by
      have h := hρ 0 (by rw [map_zero]; exact zero_le')
      rwa [sq, mul_zero, add_zero, zero_sub, Valuation.map_neg] at h
    have hb0 : (1 + 4 * ρ₀ : v.adicCompletion K) ≠ 0 := by
      intro h
      rw [h, map_zero] at hb1
      exact zero_ne_one hb1
    have hc0 : c ≠ 0 := by
      intro h
      rw [h, map_zero] at hc
      exact zero_ne_one hc
    have hg : Valued.v (γ ^ 2 - c) = WithZero.exp (-((2 * m + 1 : ℕ) : ℤ)) := by
      rw [Valuation.map_sub_swap]; exact hlev
    have hg0 : γ ^ 2 - c ≠ 0 := by
      intro h
      rw [h, map_zero] at hg
      exact WithZero.exp_ne_zero hg.symm
    have h4ρ : Valued.v (c * (4 * ρ₀)) = WithZero.exp (-((2 * e : ℕ) : ℤ)) := by
      rw [map_mul, map_mul, hc, h4, hρ1, one_mul, mul_one]
    have hlt : Valued.v (c * (4 * ρ₀)) < Valued.v (γ ^ 2 - c) := by
      rw [h4ρ, hg]
      exact WithZero.exp_lt_exp.mpr (by push_cast; omega)
    obtain ⟨y, hy_def⟩ : ∃ y : v.adicCompletion K, y = γ ^ 2 - c * (1 + 4 * ρ₀) := ⟨_, rfl⟩
    have hy : Valued.v y = WithZero.exp (-((2 * m + 1 : ℕ) : ℤ)) := by
      have hyeq : y = (γ ^ 2 - c) - c * (4 * ρ₀) := by rw [hy_def]; ring
      rw [hyeq, Valuation.map_sub_eq_of_lt_left _ hlt]
      exact hg
    have hy0 : y ≠ 0 := by
      intro h
      rw [h, map_zero] at hy
      exact WithZero.exp_ne_zero hy.symm
    
    obtain ⟨z₁, t₁, h₁⟩ := hcU (y / (γ ^ 2 - c)) (by
      rw [map_div₀, hy, hg]
      exact div_self WithZero.exp_ne_zero)
    obtain ⟨z₀, t₀, h₀⟩ := Nmul c (y / (γ ^ 2 - c)) (γ ^ 2 - c) ⟨z₁, t₁, h₁⟩ ⟨γ, 1, by ring⟩
    rw [div_mul_cancel₀ _ hg0] at h₀
    
    obtain ⟨z₂, t₂, h₂⟩ := Rec y c z₀ t₀ hy0 h₀
    have hNyc' := Ninv y c hc0 ⟨z₂, t₂, h₂⟩
    have hNycb : ∃ z t : v.adicCompletion K, z ^ 2 - y * t ^ 2 = c * (1 + 4 * ρ₀) :=
      ⟨γ, 1, by rw [hy_def]; ring⟩
    obtain ⟨z₃, t₃, h₃⟩ := Nmul y _ _ hNycb hNyc'
    rw [mul_comm c, mul_inv_cancel_right₀ hc0] at h₃
    
    obtain ⟨z₄, t₄, h₄⟩ := Rec (1 + 4 * ρ₀) y z₃ t₃ hb0 h₃
    
    obtain ⟨u, hu_def⟩ : ∃ u : v.adicCompletion K, u = y / ϖ ^ (2 * m + 1) := ⟨_, rfl⟩
    have hu1 : Valued.v u = 1 := by
      rw [hu_def, map_div₀, hy, hvp]
      exact div_self WithZero.exp_ne_zero
    have hu0 : u ≠ 0 := by
      intro h
      rw [h, map_zero] at hu1
      exact zero_ne_one hu1
    obtain ⟨z₅, t₅, h₅⟩ := Ninv _ u hu0 (hbU u hu1)
    obtain ⟨z₆, t₆, h₆⟩ := Nmul (1 + 4 * ρ₀) y u⁻¹ ⟨z₄, t₄, h₄⟩ ⟨z₅, t₅, h₅⟩
    have e1 : y * u⁻¹ = ϖ ^ (2 * m + 1) := by
      rw [hu_def]
      field_simp
    apply hϖN
    refine ⟨z₆ * (ϖ ^ m)⁻¹, t₆ * (ϖ ^ m)⁻¹, ?_⟩
    have hP0 : ϖ ^ m ≠ 0 := pow_ne_zero _ hϖ0
    calc (z₆ * (ϖ ^ m)⁻¹) ^ 2 - (1 + 4 * ρ₀) * (t₆ * (ϖ ^ m)⁻¹) ^ 2
        = (z₆ ^ 2 - (1 + 4 * ρ₀) * t₆ ^ 2) * ((ϖ ^ m)⁻¹) ^ 2 := by ring
      _ = ϖ ^ (2 * m + 1) * ((ϖ ^ m)⁻¹) ^ 2 := by rw [h₆, e1]
      _ = ϖ := by
        field_simp
        ring
  
  have L : ∀ n : ℕ, n ≤ 2 * e → ∃ γ : v.adicCompletion K, Valued.v γ ≤ 1 ∧
      Valued.v (c - γ ^ 2) ≤ WithZero.exp (-(n : ℤ)) := by
    intro n
    induction n with
    | zero =>
      intro _
      refine ⟨1, by rw [map_one], ?_⟩
      rw [Nat.cast_zero, neg_zero, WithZero.exp_zero]
      exact le_trans (Valuation.map_sub _ _ _) (max_le hc.le (by rw [one_pow, map_one]))
    | succ n ih =>
      intro hn
      obtain ⟨γ, hγ, hlev⟩ := ih (by omega)
      by_cases hnext : Valued.v (c - γ ^ 2) ≤ WithZero.exp (-((n + 1 : ℕ) : ℤ))
      · exact ⟨γ, hγ, hnext⟩
      · have hexact : Valued.v (c - γ ^ 2) = WithZero.exp (-(n : ℤ)) := by
          refine le_antisymm hlev (not_lt.mp fun hlt => hnext ?_)
          have h := hstep _ _ hlt
          rwa [show -(n : ℤ) - 1 = -((n + 1 : ℕ) : ℤ) by push_cast; ring] at h
        rcases Nat.even_or_odd' n with ⟨m, rfl | rfl⟩
        · exact stepB m (by omega) γ hγ hexact.le
        · exact (stepC m (by omega) γ hexact).elim
  
  obtain ⟨γ, hγ, hlev⟩ := L (2 * e) le_rfl
  have hlt : Valued.v (c - γ ^ 2) < Valued.v c := by
    rw [hc]
    refine lt_of_le_of_lt hlev ?_
    rw [← WithZero.exp_zero, WithZero.exp_lt_exp]
    push_cast
    omega
  have hγ2 : Valued.v (γ ^ 2) = 1 := by
    have e0 : γ ^ 2 = c - (c - γ ^ 2) := by ring
    rw [e0, Valuation.map_sub_eq_of_lt_left _ hlt, hc]
  have hγ0 : γ ≠ 0 := by
    intro h
    rw [h, zero_pow two_ne_zero, map_zero] at hγ2
    exact zero_ne_one hγ2
  have hden : (4 : v.adicCompletion K) * γ ^ 2 ≠ 0 :=
    mul_ne_zero (by norm_num) (pow_ne_zero 2 hγ0)
  obtain ⟨ρ, hρ_def⟩ : ∃ ρ : v.adicCompletion K, ρ = (c - γ ^ 2) / (4 * γ ^ 2) := ⟨_, rfl⟩
  have hρmul : ρ * (4 * γ ^ 2) = c - γ ^ 2 := by
    rw [hρ_def]; exact div_mul_cancel₀ _ hden
  have hρ1 : Valued.v ρ ≤ 1 := by
    have h := congrArg Valued.v hρmul
    rw [map_mul, map_mul, h4, hγ2, mul_one] at h
    have h' := hcancel _ _ _ (h.le.trans hlev)
    rwa [sub_self, WithZero.exp_zero] at h'
  exact ⟨γ, ρ, hγ0, hρ1, by linear_combination (-1 : v.adicCompletion K) * hρmul⟩

theorem sq_mul_of_one_add_four_mul_not_isSquare_cor_3_6 {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : Valued.v (2 : v.adicCompletion K) ≠ 1)
    (ρ₁ ρ₂ : v.adicCompletion K)
    (hρ₁ : Valued.v ρ₁ ≤ 1) (hρ₂ : Valued.v ρ₂ ≤ 1)
    (hn₁ : ∀ t : v.adicCompletion K, t ^ 2 ≠ 1 + 4 * ρ₁)
    (hn₂ : ∀ t : v.adicCompletion K, t ^ 2 ≠ 1 + 4 * ρ₂) :
    ∃ t : v.adicCompletion K, t ^ 2 = (1 + 4 * ρ₁) * (1 + 4 * ρ₂) :=
by
  
  have hw2le : Valued.v (2 : v.adicCompletion K) ≤ 1 := by
    rw [← one_add_one_eq_two]
    refine le_trans (Valuation.map_add _ _ _) ?_
    simp
  have hw2 : Valued.v (2 : v.adicCompletion K) < 1 := lt_of_le_of_ne hw2le h2
  have h2x : ∀ x : v.adicCompletion K, Valued.v x ≤ 1 → Valued.v (2 * x) < 1 := by
    intro x hx
    rw [Valuation.map_mul]
    exact mul_lt_one_of_lt_of_le hw2 hx
  
  have C : ∀ y ρ : v.adicCompletion K, Valued.v y ≤ 1 → Valued.v (y ^ 2 + y - ρ) < 1 →
      ∃ t : v.adicCompletion K, t ^ 2 = 1 + 4 * ρ := by
    intro y ρ hy hyρ
    have hu : Valued.v (1 + 2 * y) = 1 := Valuation.map_one_add_of_lt _ (h2x y hy)
    have hu0 : (1 + 2 * y : v.adicCompletion K) ≠ 0 := by
      intro h
      rw [h, map_zero] at hu
      exact zero_ne_one hu
    have hu2 : Valued.v ((1 + 2 * y) ^ 2) = 1 := by rw [map_pow, hu, one_pow]
    have hε : Valued.v ((ρ - y ^ 2 - y) / (1 + 2 * y) ^ 2) < 1 := by
      rw [map_div₀, hu2, div_one, show ρ - y ^ 2 - y = -(y ^ 2 + y - ρ) by ring,
        Valuation.map_neg]
      exact hyρ
    obtain ⟨W, hW⟩ := adicCompletion_exists_sq_add_self_eq_of_valued_lt_one v _ hε
    refine ⟨(1 + 2 * y) * (1 + 2 * W), ?_⟩
    have hW' : (1 + 2 * y) ^ 2 * (W ^ 2 + W) = ρ - y ^ 2 - y := by
      rw [hW]
      field_simp
    linear_combination 4 * hW'
  
  have hle : ∀ y ρ : v.adicCompletion K, Valued.v y ≤ 1 → Valued.v ρ ≤ 1 →
      Valued.v (y ^ 2 + y - ρ) ≤ 1 := by
    intro y ρ hy hρ
    refine le_trans (Valuation.map_sub _ _ _)
      (max_le (le_trans (Valuation.map_add _ _ _) (max_le ?_ hy)) hρ)
    rw [map_pow]
    exact pow_le_one₀ zero_le' hy
  have hρ₁' : ∀ y : v.adicCompletion K, Valued.v y ≤ 1 → Valued.v (y ^ 2 + y - ρ₁) = 1 := by
    intro y hy
    refine le_antisymm (hle y ρ₁ hy hρ₁) (not_lt.mp ?_)
    intro hlt
    obtain ⟨t, ht⟩ := C y ρ₁ hy hlt
    exact hn₁ t ht
  
  obtain ⟨τ, hτ, hA | hB⟩ := exists_artinSchreier_sol_or_shift v h2 ρ₁ hρ₁' ρ₂ hρ₂
  · obtain ⟨t, ht⟩ := C τ ρ₂ hτ hA
    exact absurd ht (hn₂ t)
  · have h12 : Valued.v (1 + 2 * ρ₂) ≤ 1 :=
      le_trans (Valuation.map_add _ _ _) (max_le (by simp) (le_of_lt (h2x ρ₂ hρ₂)))
    have hprod : Valued.v (2 * ρ₁ * (1 + 2 * ρ₂)) < 1 := by
      rw [Valuation.map_mul]
      exact mul_lt_one_of_lt_of_le (h2x ρ₁ hρ₁) h12
    have hC : Valued.v (τ ^ 2 + τ - (ρ₁ + ρ₂ + 4 * ρ₁ * ρ₂)) < 1 := by
      rw [show τ ^ 2 + τ - (ρ₁ + ρ₂ + 4 * ρ₁ * ρ₂) =
          (τ ^ 2 + τ - ρ₂ + ρ₁) - 2 * ρ₁ * (1 + 2 * ρ₂) by ring]
      exact Valuation.map_sub_lt _ hB hprod
    obtain ⟨t, ht⟩ := C τ _ hτ hC
    exact ⟨t, by rw [ht]; ring⟩

theorem quaternion_pure_repr_unramified_unit {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h2 : Valued.v (2 : v.adicCompletion K) ≠ 1)
    (a : v.adicCompletion K) (ha : Valued.v a = 1)
    (hans : ∀ t : v.adicCompletion K, t ^ 2 ≠ a)
    (haU : ∀ u : v.adicCompletion K, Valued.v u = 1 →
        ∃ z t : v.adicCompletion K, z ^ 2 - a * t ^ 2 = u)
    (δ x : v.adicCompletion K) (hδ : δ ≠ 0) (hx : x ≠ 0)
    (hns : ∀ t : v.adicCompletion K, t ^ 2 ≠ δ)
    (hxn : ¬ ∃ z t : v.adicCompletion K, z ^ 2 - δ * t ^ 2 = x) :
    ∃ p q r : v.adicCompletion K, δ * p ^ 2 + x * q ^ 2 - δ * x * r ^ 2 = a :=
by
  
  obtain ⟨sa, ρa, hsa, hρa, haeq⟩ := unramified_unit_eq_sq_mul_one_add_four_mul v h2 a ha haU
  have hPns : ∀ t : v.adicCompletion K, t ^ 2 ≠ 1 + 4 * ρa := by
    intro t ht
    apply hans (sa * t)
    rw [haeq, ← ht]
    ring
  
  obtain ⟨p₀, q₀, r₀, sd, ρd, hsd, hρd, hQns, hDeq⟩ :=
    exists_pure_repr_one_add_four_mul_nonsquare_cor_3_6 v h2 δ x hδ hx hns hxn
  have hd0 : (1 + 4 * ρd : v.adicCompletion K) ≠ 0 := by
    intro h
    apply hQns 0
    simp [h]
  obtain ⟨σ, hσ⟩ := sq_mul_of_one_add_four_mul_not_isSquare_cor_3_6 v h2 ρa ρd hρa hρd hPns hQns
  have hden : sd * (1 + 4 * ρd) ≠ 0 := mul_ne_zero hsd hd0
  refine ⟨(sa * σ / (sd * (1 + 4 * ρd))) * p₀, (sa * σ / (sd * (1 + 4 * ρd))) * q₀,
    (sa * σ / (sd * (1 + 4 * ρd))) * r₀, ?_⟩
  have e1 : δ * ((sa * σ / (sd * (1 + 4 * ρd))) * p₀) ^ 2 +
      x * ((sa * σ / (sd * (1 + 4 * ρd))) * q₀) ^ 2 -
      δ * x * ((sa * σ / (sd * (1 + 4 * ρd))) * r₀) ^ 2 =
      (sa * σ / (sd * (1 + 4 * ρd))) ^ 2 * (sd ^ 2 * (1 + 4 * ρd)) := by
    rw [← hDeq]
    ring
  rw [e1, haeq, div_pow, div_mul_eq_mul_div, div_eq_iff (pow_ne_zero 2 hden)]
  linear_combination (sa ^ 2 * sd ^ 2 * (1 + 4 * ρd)) * hσ

theorem norm_mul_mem_of_common_pure_repr_cor_3_6 {F : Type*} [Field F]
    (hF2 : (2 : F) ≠ 0)
    (a δ x y : F) (ha0 : a ≠ 0) (hδ : δ ≠ 0) (hx : x ≠ 0) (hy : y ≠ 0)
    (hns : ∀ t : F, t ^ 2 ≠ δ)
    (hans : ∀ t : F, t ^ 2 ≠ a)
    (hxn : ¬ ∃ z t : F, z ^ 2 - δ * t ^ 2 = x)
    (hyn : ¬ ∃ z t : F, z ^ 2 - δ * t ^ 2 = y)
    (hax : ∃ p q r : F, δ * p ^ 2 + x * q ^ 2 - δ * x * r ^ 2 = a)
    (hay : ∃ p q r : F, δ * p ^ 2 + y * q ^ 2 - δ * y * r ^ 2 = a)
    (hmul : ∀ μ₁ μ₂ : F, μ₁ ≠ 0 → μ₂ ≠ 0 →
        (¬ ∃ z t : F, z ^ 2 - a * t ^ 2 = μ₁) →
        (¬ ∃ z t : F, z ^ 2 - a * t ^ 2 = μ₂) →
        ∃ z t : F, z ^ 2 - a * t ^ 2 = μ₁ * μ₂) :
    ∃ z t : F, z ^ 2 - δ * t ^ 2 = x * y :=
by
  
  have s1 : ∀ u n z t q r : F, z ^ 2 - δ * t ^ 2 = u → q ^ 2 - δ * r ^ 2 = n → n ≠ 0 →
      ∃ z' t' : F, z' ^ 2 - δ * t' ^ 2 = u / n := by
    intro u n z t q r hu hn hn0
    subst hu hn
    refine ⟨(z * q - δ * t * r) / (q ^ 2 - δ * r ^ 2), (t * q - z * r) / (q ^ 2 - δ * r ^ 2), ?_⟩
    rw [div_pow, div_pow, mul_div_assoc', div_sub_div_same,
      div_eq_div_iff (pow_ne_zero 2 hn0) hn0]
    ring
  
  have s2 : ∀ X p : F, δ * p ^ 2 + X = a → (¬ ∃ z t : F, z ^ 2 - δ * t ^ 2 = X) →
      ¬ ∃ s t : F, s ^ 2 - a * t ^ 2 = -δ * X := by
    rintro X p hX hXn ⟨s, t, hs⟩
    have hm : t ^ 2 - δ ≠ 0 := sub_ne_zero.mpr (hns t)
    have key : (s * t - δ * p * t) ^ 2 - δ * (p * t ^ 2 - s) ^ 2 = X * (t ^ 2 - δ) ^ 2 := by
      linear_combination (t ^ 2 - δ) * hs - (t ^ 2 - δ) * t ^ 2 * hX
    apply hXn
    refine ⟨(s * t - δ * p * t) / (t ^ 2 - δ), (p * t ^ 2 - s) / (t ^ 2 - δ), ?_⟩
    rw [div_pow, div_pow, mul_div_assoc', div_sub_div_same, key]
    exact mul_div_cancel_right₀ _ (pow_ne_zero 2 hm)
  
  have s3 : ∀ X Y p p' σ τ : F, δ * p ^ 2 + X = a → δ * p' ^ 2 + Y = a →
      X * (σ ^ 2 - a * τ ^ 2) = Y →
      ∃ I₁ I₂ I₃ J₁ J₂ J₃ : F,
        δ * I₁ ^ 2 + X * I₂ ^ 2 - δ * X * I₃ ^ 2 = δ ∧
        δ * I₁ * J₁ + X * I₂ * J₂ - δ * X * I₃ * J₃ = 0 ∧
        δ * J₁ ^ 2 + X * J₂ ^ 2 - δ * X * J₃ ^ 2 = -δ * Y := by
    intro X Y p p' σ τ hX hY hK
    obtain ⟨ai, hai⟩ : ∃ ai : F, a * ai = 1 := ⟨a⁻¹, mul_inv_cancel₀ ha0⟩
    refine ⟨(δ * p * p' - X * σ) * ai, δ * (p' + p * σ) * ai, τ, -τ * X, τ * p * δ, σ,
      ?_, ?_, ?_⟩
    · linear_combination (δ * ai * (δ * p' ^ 2 + X * σ ^ 2) + δ * (X * τ ^ 2 + 1)) * hai +
        δ * ai * hK + δ * ai * hY + δ * ai ^ 2 * (δ * p' ^ 2 + X * σ ^ 2) * hX
    · linear_combination δ * X * τ * σ * hai + δ * X * τ * σ * ai * hX
    · linear_combination (-δ) * hK + δ * X * τ ^ 2 * hX
  
  have s4 : ∀ X I₁ I₂ I₃ J₁ J₂ J₃ m : F,
      δ * I₁ ^ 2 + X * I₂ ^ 2 - δ * X * I₃ ^ 2 = δ →
      δ * I₁ * J₁ + X * I₂ * J₂ - δ * X * I₃ * J₃ = 0 →
      δ * J₁ ^ 2 + X * J₂ ^ 2 - δ * X * J₃ ^ 2 = m →
      ∃ e₂ e₃ : F, X * (e₂ ^ 2 - δ * e₃ ^ 2) = m := by
    intro X I₁ I₂ I₃ J₁ J₂ J₃ m hI hB hJ
    by_cases h1 : I₁ = 1
    · have h2 : (1 + I₁) ≠ 0 := by rw [h1, one_add_one_eq_two]; exact hF2
      obtain ⟨l, hl⟩ : ∃ l : F, l * (1 + I₁) = J₁ := ⟨J₁ / (1 + I₁), div_mul_cancel₀ _ h2⟩
      refine ⟨J₂ - l * I₂, J₃ - l * I₃, ?_⟩
      linear_combination hJ + 2 * l * (-1) * hB + l ^ 2 * hI +
        (2 * l * δ - δ * (l * (1 + I₁) - J₁)) * hl
    · have h2 : (1 - I₁) ≠ 0 := sub_ne_zero.mpr (Ne.symm h1)
      obtain ⟨l, hl⟩ : ∃ l : F, l * (1 - I₁) = J₁ := ⟨J₁ / (1 - I₁), div_mul_cancel₀ _ h2⟩
      refine ⟨J₂ + l * I₂, J₃ + l * I₃, ?_⟩
      linear_combination hJ + 2 * l * hB + l ^ 2 * hI +
        (2 * l * δ - δ * (l * (1 - I₁) - J₁)) * hl
  obtain ⟨p, q, r, hpqr⟩ := hax
  obtain ⟨p', q', r', hpqr'⟩ := hay
  
  have degen : ∀ P : F, a = δ * P ^ 2 → ∃ z t : F, z ^ 2 - δ * t ^ 2 = x * y := by
    intro P ha'
    have hxa : ¬ ∃ z t : F, z ^ 2 - a * t ^ 2 = x := by
      rintro ⟨z, t, h⟩
      exact hxn ⟨z, P * t, by linear_combination h + t ^ 2 * ha'⟩
    have hya : ¬ ∃ z t : F, z ^ 2 - a * t ^ 2 = y := by
      rintro ⟨z, t, h⟩
      exact hyn ⟨z, P * t, by linear_combination h + t ^ 2 * ha'⟩
    obtain ⟨z, t, h⟩ := hmul x y hx hy hxa hya
    exact ⟨z, P * t, by linear_combination h + t ^ 2 * ha'⟩
  by_cases hn0 : q ^ 2 - δ * r ^ 2 = 0
  · exact degen p (by linear_combination -hpqr + x * hn0)
  by_cases hn0' : q' ^ 2 - δ * r' ^ 2 = 0
  · exact degen p' (by linear_combination -hpqr' + y * hn0')
  
  obtain ⟨n, hn⟩ : ∃ n : F, q ^ 2 - δ * r ^ 2 = n := ⟨_, rfl⟩
  obtain ⟨n', hn'⟩ : ∃ n' : F, q' ^ 2 - δ * r' ^ 2 = n' := ⟨_, rfl⟩
  rw [hn] at hn0
  rw [hn'] at hn0'
  obtain ⟨X, hXdef⟩ : ∃ X : F, x * n = X := ⟨_, rfl⟩
  obtain ⟨Y, hYdef⟩ : ∃ Y : F, y * n' = Y := ⟨_, rfl⟩
  have hX : δ * p ^ 2 + X = a := by
    rw [← hXdef, ← hn]; linear_combination hpqr
  have hY : δ * p' ^ 2 + Y = a := by
    rw [← hYdef, ← hn']; linear_combination hpqr'
  have hX0 : X ≠ 0 := by rw [← hXdef]; exact mul_ne_zero hx hn0
  have hY0 : Y ≠ 0 := by rw [← hYdef]; exact mul_ne_zero hy hn0'
  have hXn : ¬ ∃ z t : F, z ^ 2 - δ * t ^ 2 = X := by
    rintro ⟨z, t, h⟩
    obtain ⟨z', t', h'⟩ := s1 X n z t q r h hn hn0
    rw [← hXdef, mul_div_cancel_right₀ _ hn0] at h'
    exact hxn ⟨z', t', h'⟩
  have hYn : ¬ ∃ z t : F, z ^ 2 - δ * t ^ 2 = Y := by
    rintro ⟨z, t, h⟩
    obtain ⟨z', t', h'⟩ := s1 Y n' z t q' r' h hn' hn0'
    rw [← hYdef, mul_div_cancel_right₀ _ hn0'] at h'
    exact hyn ⟨z', t', h'⟩
  have hδX : δ * X ≠ 0 := mul_ne_zero hδ hX0
  obtain ⟨s₀, t₀, h0⟩ := hmul (-δ * X) (-δ * Y) (mul_ne_zero (neg_ne_zero.mpr hδ) hX0)
    (mul_ne_zero (neg_ne_zero.mpr hδ) hY0) (s2 X p hX hXn) (s2 Y p' hY hYn)
  obtain ⟨σ, rfl⟩ : ∃ σ : F, σ * (δ * X) = s₀ := ⟨s₀ / (δ * X), div_mul_cancel₀ _ hδX⟩
  obtain ⟨τ, rfl⟩ : ∃ τ : F, τ * (δ * X) = t₀ := ⟨t₀ / (δ * X), div_mul_cancel₀ _ hδX⟩
  have hK : X * (σ ^ 2 - a * τ ^ 2) = Y := by
    have h' : (δ * X) ^ 2 * (X * (σ ^ 2 - a * τ ^ 2) - Y) = 0 := by
      linear_combination X * h0
    have := (mul_eq_zero.mp h').resolve_left (pow_ne_zero 2 hδX)
    exact sub_eq_zero.mp this
  obtain ⟨I₁, I₂, I₃, J₁, J₂, J₃, hI, hB, hJ⟩ := s3 X Y p p' σ τ hX hY hK
  obtain ⟨e₂, e₃, he⟩ := s4 X I₁ I₂ I₃ J₁ J₂ J₃ (-δ * Y) hI hB hJ
  obtain ⟨di, hdi⟩ : ∃ di : F, δ * di = 1 := ⟨δ⁻¹, mul_inv_cancel₀ hδ⟩
  have hXY : (X * e₃) ^ 2 - δ * (X * e₂ * di) ^ 2 = X * Y := by
    linear_combination (-di * X) * he - (X ^ 2 * e₃ ^ 2 + di * X ^ 2 * e₂ ^ 2 - X * Y) * hdi
  have hnn : (q * q' + δ * r * r') ^ 2 - δ * (q * r' + r * q') ^ 2 = n * n' := by
    rw [← hn, ← hn']; ring
  obtain ⟨z, t, hzt⟩ := s1 (X * Y) (n * n') _ _ _ _ hXY hnn (mul_ne_zero hn0 hn0')
  refine ⟨z, t, ?_⟩
  rw [hzt, ← hXdef, ← hYdef, div_eq_iff (mul_ne_zero hn0 hn0')]
  ring

theorem exists_not_norm_of_quaternion_pure_repr {F : Type*} [Field F] (hF2 : (2 : F) ≠ 0)
    (a π δ : F) (ha : a ≠ 0) (hπ : π ≠ 0) (hδ : δ ≠ 0)
    (hπN : ¬ ∃ z t : F, z ^ 2 - a * t ^ 2 = π)
    (hrep : ∃ X Y Z : F, a * X ^ 2 + π * Y ^ 2 - a * π * Z ^ 2 = δ) :
    ∃ x : F, x ≠ 0 ∧ ¬ ∃ z t : F, z ^ 2 - δ * t ^ 2 = x :=
by
  have hsq : ∀ z t : F, z ^ 2 - a * t ^ 2 = 0 → z = 0 ∧ t = 0 := by
    intro z t h
    by_cases ht : t = 0
    · subst ht
      refine ⟨?_, rfl⟩
      have h' : z ^ 2 = 0 := by linear_combination h
      exact (pow_eq_zero_iff two_ne_zero).mp h'
    · exfalso
      have hz : z ≠ 0 := by
        intro hz
        subst hz
        have h' : a * t ^ 2 = 0 := by linear_combination -h
        rcases mul_eq_zero.mp h' with h1 | h1
        · exact ha h1
        · exact ht ((pow_eq_zero_iff two_ne_zero).mp h1)
      have hk : a * (t / z) ^ 2 = 1 := by
        rw [div_pow, mul_div_assoc', div_eq_one_iff_eq (pow_ne_zero 2 hz)]
        linear_combination -h
      have h2 : (2 : F) * 2⁻¹ = 1 := mul_inv_cancel₀ hF2
      apply hπN
      refine ⟨(π + 1) / 2, (π - 1) / 2 * (t / z), ?_⟩
      linear_combination (-((π - 1) / 2) ^ 2) * hk + π * (2 * 2⁻¹ + 1) * h2
  have hiso : ∀ w A B C : F, w ^ 2 - a * A ^ 2 - π * B ^ 2 + a * π * C ^ 2 = 0 →
      w = 0 ∧ A = 0 ∧ B = 0 ∧ C = 0 := by
    intro w A B C hE
    by_cases hD : B ^ 2 - a * C ^ 2 = 0
    · obtain ⟨hB, hC⟩ := hsq B C hD
      subst hB
      subst hC
      obtain ⟨hw, hA⟩ := hsq w A (by linear_combination hE)
      exact ⟨hw, hA, rfl, rfl⟩
    · exfalso
      apply hπN
      refine ⟨(w * B + a * A * C) / (B ^ 2 - a * C ^ 2),
        (w * C + A * B) / (B ^ 2 - a * C ^ 2), ?_⟩
      rw [div_pow, div_pow, mul_div_assoc', div_sub_div_same, div_eq_iff (pow_ne_zero 2 hD)]
      linear_combination (B ^ 2 - a * C ^ 2) * hE
  obtain ⟨X, Y, Z, hXYZ⟩ := hrep
  have key : ∀ r1 r2 r3 : F, a * X * r1 + π * Y * r2 - a * π * Z * r3 = 0 →
      ¬ (r1 = 0 ∧ r2 = 0 ∧ r3 = 0) →
      ∃ x : F, x ≠ 0 ∧ ¬ ∃ z t : F, z ^ 2 - δ * t ^ 2 = x := by
    intro r1 r2 r3 hB hr
    refine ⟨a * r1 ^ 2 + π * r2 ^ 2 - a * π * r3 ^ 2, ?_, ?_⟩
    · intro hx
      obtain ⟨-, h1, h2, h3⟩ := hiso 0 r1 r2 r3 (by linear_combination -hx)
      exact hr ⟨h1, h2, h3⟩
    · rintro ⟨z, t, hzt⟩
      obtain ⟨hz, h1, h2, h3⟩ := hiso z (t * X + r1) (t * Y + r2) (t * Z + r3)
        (by linear_combination hzt - t ^ 2 * hXYZ - 2 * t * hB)
      have e1 : r1 = -(t * X) := by linear_combination h1
      have e2 : r2 = -(t * Y) := by linear_combination h2
      have e3 : r3 = -(t * Z) := by linear_combination h3
      subst e1 e2 e3 hz
      have h2t : (2 * δ) * t ^ 2 = 0 := by linear_combination (-1) * hzt - t ^ 2 * hXYZ
      have ht : t = 0 := by
        rcases mul_eq_zero.mp h2t with h | h
        · exact absurd h (mul_ne_zero hF2 hδ)
        · exact (pow_eq_zero_iff two_ne_zero).mp h
      subst ht
      exact hr ⟨by ring, by ring, by ring⟩
  by_cases hXY : X = 0 ∧ Y = 0
  · obtain ⟨hX, hY⟩ := hXY
    have hZ : Z ≠ 0 := by
      intro hZ
      apply hδ
      rw [← hXYZ, hX, hY, hZ]
      ring
    exact key (π * Z) 0 X (by ring) (fun h => hZ ((mul_eq_zero.mp h.1).resolve_left hπ))
  · refine key (π * Y) (-(a * X)) 0 (by ring) ?_
    rintro ⟨h1, h2, -⟩
    apply hXY
    exact ⟨(mul_eq_zero.mp (neg_eq_zero.mp h2)).resolve_left ha,
      (mul_eq_zero.mp h1).resolve_left hπ⟩

theorem hilbSym_adicCompletion_mul_nondeg {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    (∀ a a' b : v.adicCompletion K, a ≠ 0 → a' ≠ 0 → b ≠ 0 →
      hilbSym (v.adicCompletion K) (a * a') b =
        hilbSym (v.adicCompletion K) a b * hilbSym (v.adicCompletion K) a' b) ∧
    (∀ b : v.adicCompletion K, b ≠ 0 → ¬ IsSquare b →
      ∃ a : v.adicCompletion K, a ≠ 0 ∧ hilbSym (v.adicCompletion K) a b = -1) :=
by
  classical
  
  
  have Hnorm : ∀ {F : Type u} [Field F] [CharZero F] (a b : F), a ≠ 0 →
      ((∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1) ↔ (∃ z t : F, z ^ 2 - b * t ^ 2 = a)) := by
    intro F _ _ a b ha
    constructor
    · rintro ⟨x, y, h⟩
      by_cases hx : x = 0
      · subst hx
        refine ⟨(a + 1) / 2, (1 - a) * y / 2, ?_⟩
        linear_combination (-(1 - a) ^ 2 / 4) * h
      · have hinv : x * x⁻¹ = 1 := mul_inv_cancel₀ hx
        refine ⟨x⁻¹, y * x⁻¹, ?_⟩
        linear_combination (-x⁻¹ ^ 2) * h + a * (x * x⁻¹ + 1) * hinv
    · rintro ⟨z, t, h⟩
      by_cases hz : z = 0
      · subst hz
        have hinv : a * a⁻¹ = 1 := mul_inv_cancel₀ ha
        refine ⟨(1 + a) * a⁻¹ / 2, t * (a - 1) * a⁻¹ / 2, ?_⟩
        linear_combination (-(a - 1) ^ 2 * a⁻¹ ^ 2 / 4) * h + (a * a⁻¹ + 1) * hinv
      · have hinv : z * z⁻¹ = 1 := mul_inv_cancel₀ hz
        refine ⟨z⁻¹, t * z⁻¹, ?_⟩
        linear_combination (-z⁻¹ ^ 2) * h + (z * z⁻¹ + 1) * hinv
  
  have Nmul : ∀ {F : Type u} [Field F] (δ x y : F), (∃ z t : F, z ^ 2 - δ * t ^ 2 = x) →
      (∃ z t : F, z ^ 2 - δ * t ^ 2 = y) → ∃ z t : F, z ^ 2 - δ * t ^ 2 = x * y := by
    rintro F _ δ x y ⟨z₁, t₁, rfl⟩ ⟨z₂, t₂, rfl⟩
    exact ⟨z₁ * z₂ + δ * t₁ * t₂, z₁ * t₂ + t₁ * z₂, by ring⟩
  have Ninv : ∀ {F : Type u} [Field F] (δ x : F), x ≠ 0 →
      (∃ z t : F, z ^ 2 - δ * t ^ 2 = x) → ∃ z t : F, z ^ 2 - δ * t ^ 2 = x⁻¹ := by
    rintro F _ δ x hx ⟨z, t, rfl⟩
    have hinv : (z ^ 2 - δ * t ^ 2) * (z ^ 2 - δ * t ^ 2)⁻¹ = 1 := mul_inv_cancel₀ hx
    refine ⟨z * (z ^ 2 - δ * t ^ 2)⁻¹, t * (z ^ 2 - δ * t ^ 2)⁻¹, ?_⟩
    linear_combination (z ^ 2 - δ * t ^ 2)⁻¹ * hinv
  
  have S0b : ∀ {F : Type u} [Field F] [CharZero F],
      (∀ δ : F, δ ≠ 0 → (∀ t : F, t ^ 2 ≠ δ) →
        ∃ x : F, x ≠ 0 ∧ ¬ ∃ z t : F, z ^ 2 - δ * t ^ 2 = x) →
      (∀ δ : F, δ ≠ 0 → (∀ t : F, t ^ 2 ≠ δ) → ∀ x y : F, x ≠ 0 → y ≠ 0 →
        (¬ ∃ z t : F, z ^ 2 - δ * t ^ 2 = x) → (¬ ∃ z t : F, z ^ 2 - δ * t ^ 2 = y) →
        ∃ z t : F, z ^ 2 - δ * t ^ 2 = x * y) →
      (∀ a a' b : F, a ≠ 0 → a' ≠ 0 → b ≠ 0 →
        hilbSym F (a * a') b = hilbSym F a b * hilbSym F a' b) ∧
      (∀ b : F, b ≠ 0 → ¬ IsSquare b → ∃ a : F, a ≠ 0 ∧ hilbSym F a b = -1) := by
    intro F _ _ hi hii
    have hS : ∀ c b : F, c ≠ 0 →
        hilbSym F c b = if (∃ z t : F, z ^ 2 - b * t ^ 2 = c) then 1 else -1 := by
      intro c b hc
      unfold hilbSym
      by_cases h : ∃ z t : F, z ^ 2 - b * t ^ 2 = c
      · rw [if_pos h, if_pos ((Hnorm c b hc).mpr h)]
      · rw [if_neg h, if_neg (fun h' => h ((Hnorm c b hc).mp h'))]
    have hns_of : ∀ b : F, ¬ IsSquare b → ∀ t : F, t ^ 2 ≠ b := by
      intro b hb t ht
      exact hb ⟨t, by rw [← ht, sq]⟩
    refine ⟨?_, ?_⟩
    · intro a a' b ha ha' hb
      by_cases hsq : IsSquare b
      · obtain ⟨r, rfl⟩ := hsq
        have hr : r ≠ 0 := by
          rintro rfl
          exact hb (by ring)
        have hinv : r * r⁻¹ = 1 := mul_inv_cancel₀ hr
        have h1 : ∀ c : F, hilbSym F c (r * r) = 1 := by
          intro c
          unfold hilbSym
          rw [if_pos ⟨0, r⁻¹, by linear_combination (r * r⁻¹ + 1) * hinv⟩]
        rw [h1, h1, h1, mul_one]
      · have hns := hns_of b hsq
        rw [hS a b ha, hS a' b ha', hS (a * a') b (mul_ne_zero ha ha')]
        by_cases hA : ∃ z t : F, z ^ 2 - b * t ^ 2 = a <;>
          by_cases hA' : ∃ z t : F, z ^ 2 - b * t ^ 2 = a'
        · rw [if_pos hA, if_pos hA', if_pos (Nmul b a a' hA hA'), mul_one]
        · have hP : ¬ ∃ z t : F, z ^ 2 - b * t ^ 2 = a * a' := by
            intro h
            apply hA'
            have h' := Nmul b _ _ h (Ninv b a ha hA)
            rwa [mul_comm a a', mul_inv_cancel_right₀ ha] at h'
          rw [if_pos hA, if_neg hA', if_neg hP, one_mul]
        · have hP : ¬ ∃ z t : F, z ^ 2 - b * t ^ 2 = a * a' := by
            intro h
            apply hA
            have h' := Nmul b _ _ h (Ninv b a' ha' hA')
            rwa [mul_inv_cancel_right₀ ha'] at h'
          rw [if_neg hA, if_pos hA', if_neg hP, mul_one]
        · rw [if_neg hA, if_neg hA', if_pos (hii b hb hns a a' ha ha' hA hA')]
          simp
    · intro b hb hsq
      obtain ⟨x, hx, hxn⟩ := hi b hb (hns_of b hsq)
      exact ⟨x, hx, by rw [hS x b hx, if_neg hxn]⟩
  
  haveI : CharZero (v.adicCompletion K) :=
    charZero_of_injective_algebraMap (algebraMap K (v.adicCompletion K)).injective
  have hF2 : (2 : v.adicCompletion K) ≠ 0 := two_ne_zero
  have hval : ∀ x : K, Valued.v (algebraMap K (v.adicCompletion K) x) =
      IsDedekindDomain.HeightOneSpectrum.valuation K v x :=
    fun x => IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v x
  obtain ⟨π₀, hπ₀⟩ := IsDedekindDomain.HeightOneSpectrum.valuation_exists_uniformizer K v
  obtain ⟨ϖ, hϖdef⟩ : ∃ ϖ : v.adicCompletion K, ϖ = algebraMap K (v.adicCompletion K) π₀ :=
    ⟨_, rfl⟩
  have hϖ : Valued.v ϖ = WithZero.exp (-1 : ℤ) := by rw [hϖdef, hval, hπ₀]
  have hϖ0 : ϖ ≠ 0 := by
    intro h
    rw [h, map_zero] at hϖ
    exact WithZero.exp_ne_zero hϖ.symm
  
  by_cases h2 : Valued.v (2 : v.adicCompletion K) = 1
  · 
    have h2' : IsDedekindDomain.HeightOneSpectrum.valuation K v 2 = 1 := by
      rw [← hval, map_ofNat]
      exact h2
    have hsq := adicCompletion_isSquare_of_valued_sub_one_lt_one v h2'
    obtain ⟨ε, hεw, hεns, hεd⟩ := adicCompletion_exists_nonsquare_unit_dichotomy v h2' hsq
    have hres := adicCompletion_exists_sq_add_nonsquare_unit v h2'
    exact hilbSym_mul_nondeg_of_odd_formula hF2 Valued.v ϖ hϖ ε hεw hεns hεd
      (fun a b n ha hb =>
        hilbSym_odd_unit_formula Valued.v hsq ε hεw hεns hεd hres ϖ hϖ a b n ha hb)
  · 
    have hϖ' : Valued.v ϖ = ((Multiplicative.ofAdd (-1 : ℤ) : Multiplicative ℤ) :
        WithZero (Multiplicative ℤ)) := hϖ
    obtain ⟨ρ, hρ⟩ := exists_artinSchreier_element_adicCompletion v
    obtain ⟨ha1, hϖN⟩ := artinSchreier_unit_and_uniformizer_not_norm v h2 ρ hρ ϖ hϖ'
    have ha0 : (1 + 4 * ρ : v.adicCompletion K) ≠ 0 := by
      intro h
      rw [h, map_zero] at ha1
      exact zero_ne_one ha1
    have haU : ∀ u : v.adicCompletion K, Valued.v u = 1 →
        ∃ z t : v.adicCompletion K, z ^ 2 - (1 + 4 * ρ) * t ^ 2 = u :=
      fun u hu => exists_norm_of_unit_artinSchreier v h2 ρ hρ u hu
    have hans : ∀ t : v.adicCompletion K, t ^ 2 ≠ 1 + 4 * ρ := by
      intro t ht
      have ht0 : t ≠ 0 := by
        rintro rfl
        apply ha0
        rw [← ht]
        ring
      have hinv : t * t⁻¹ = 1 := mul_inv_cancel₀ ht0
      apply hϖN
      refine ⟨(ϖ + 1) / 2, (ϖ - 1) * t⁻¹ / 2, ?_⟩
      rw [← ht]
      linear_combination (-(ϖ - 1) ^ 2 / 4 * (t * t⁻¹ + 1)) * hinv
    
    have hvz : ∀ j : ℤ, Valued.v (ϖ ^ j) = WithZero.exp (-j) := by
      intro j
      rw [map_zpow₀, hϖ, ← WithZero.exp_zsmul]
      congr 1
      simp
    have Dec : ∀ μ : v.adicCompletion K, μ ≠ 0 →
        ∃ (j : ℤ) (u : v.adicCompletion K), Valued.v u = 1 ∧ μ = ϖ ^ j * u := by
      intro μ hμ
      have hv0 : Valued.v μ ≠ 0 := by rwa [ne_eq, Valuation.zero_iff]
      obtain ⟨m, hm⟩ : ∃ m : ℤ, Valued.v μ = WithZero.exp m :=
        ⟨WithZero.log (Valued.v μ), (WithZero.exp_log hv0).symm⟩
      refine ⟨-m, μ * ϖ ^ m, ?_, ?_⟩
      · rw [map_mul, hvz, hm, ← WithZero.exp_add, add_neg_cancel, WithZero.exp_zero]
      · rw [mul_left_comm, ← zpow_add₀ hϖ0, neg_add_cancel, zpow_zero, mul_one]
    have EvenN : ∀ (j : ℤ) (u : v.adicCompletion K), Valued.v u = 1 → Even j →
        ∃ z t : v.adicCompletion K, z ^ 2 - (1 + 4 * ρ) * t ^ 2 = ϖ ^ j * u := by
      rintro j u hu ⟨k, rfl⟩
      obtain ⟨z, t, hzt⟩ := haU u hu
      refine ⟨ϖ ^ k * z, ϖ ^ k * t, ?_⟩
      rw [zpow_add₀ hϖ0, ← hzt]
      ring
    have hmul_a : ∀ μ₁ μ₂ : v.adicCompletion K, μ₁ ≠ 0 → μ₂ ≠ 0 →
        (¬ ∃ z t : v.adicCompletion K, z ^ 2 - (1 + 4 * ρ) * t ^ 2 = μ₁) →
        (¬ ∃ z t : v.adicCompletion K, z ^ 2 - (1 + 4 * ρ) * t ^ 2 = μ₂) →
        ∃ z t : v.adicCompletion K, z ^ 2 - (1 + 4 * ρ) * t ^ 2 = μ₁ * μ₂ := by
      intro μ₁ μ₂ h₁ h₂ hn₁ hn₂
      obtain ⟨j₁, u₁, hu₁, rfl⟩ := Dec μ₁ h₁
      obtain ⟨j₂, u₂, hu₂, rfl⟩ := Dec μ₂ h₂
      have o₁ : Odd j₁ := Int.not_even_iff_odd.mp (fun he => hn₁ (EvenN j₁ u₁ hu₁ he))
      have o₂ : Odd j₂ := Int.not_even_iff_odd.mp (fun he => hn₂ (EvenN j₂ u₂ hu₂ he))
      have h' := EvenN (j₁ + j₂) (u₁ * u₂) (by rw [map_mul, hu₁, hu₂, one_mul]) (o₁.add_odd o₂)
      rwa [zpow_add₀ hϖ0, show ϖ ^ j₁ * ϖ ^ j₂ * (u₁ * u₂) = ϖ ^ j₁ * u₁ * (ϖ ^ j₂ * u₂) by ring]
        at h'
    
    have hrep : ∀ δ : v.adicCompletion K, δ ≠ 0 → (∀ t : v.adicCompletion K, t ^ 2 ≠ δ) →
        ∃ X Y Z : v.adicCompletion K,
          (1 + 4 * ρ) * X ^ 2 + ϖ * Y ^ 2 - (1 + 4 * ρ) * ϖ * Z ^ 2 = δ := by
      intro δ hδ hns
      obtain ⟨j, c, hc, rfl⟩ := Dec δ hδ
      rcases Int.even_or_odd' j with ⟨l, rfl | rfl⟩
      · by_cases hac : ∃ s : v.adicCompletion K, (1 + 4 * ρ) * s ^ 2 = c
        · obtain ⟨s, rfl⟩ := hac
          refine ⟨ϖ ^ l * s, 0, 0, ?_⟩
          simp only [two_mul, zpow_add₀ hϖ0]
          ring
        · have hna : ∀ s : v.adicCompletion K, (1 + 4 * ρ) * s ^ 2 ≠ c :=
            fun s hs => hac ⟨s, hs⟩
          have hnsq : ∀ s : v.adicCompletion K, s ^ 2 ≠ c := by
            intro s hs
            apply hns (ϖ ^ l * s)
            simp only [two_mul, zpow_add₀ hϖ0]
            rw [← hs]
            ring
          obtain ⟨x₀, k, ω, hω, hcx⟩ :=
            exists_odd_valuation_sub_artinSchreier_smul_sq v h2 ρ hρ ϖ hϖ' c hc hnsq hna
          obtain ⟨z₁, t₁, hzt⟩ := haU ω hω
          refine ⟨ϖ ^ l * x₀, ϖ ^ (l + k) * z₁, ϖ ^ (l + k) * t₁, ?_⟩
          have hc' : c = (1 + 4 * ρ) * x₀ ^ 2 + ϖ ^ (2 * k + 1) * (z₁ ^ 2 - (1 + 4 * ρ) * t₁ ^ 2) := by
            rw [hzt]
            linear_combination hcx
          rw [hc']
          simp only [two_mul, zpow_add₀ hϖ0, zpow_one]
          ring
      · obtain ⟨z₁, t₁, hzt⟩ := haU c hc
        refine ⟨0, ϖ ^ l * z₁, ϖ ^ l * t₁, ?_⟩
        rw [← hzt]
        simp only [two_mul, zpow_add₀ hϖ0, zpow_one]
        ring
    have hi : ∀ δ : v.adicCompletion K, δ ≠ 0 → (∀ t : v.adicCompletion K, t ^ 2 ≠ δ) →
        ∃ x : v.adicCompletion K, x ≠ 0 ∧ ¬ ∃ z t : v.adicCompletion K, z ^ 2 - δ * t ^ 2 = x :=
      fun δ hδ hns => exists_not_norm_of_quaternion_pure_repr hF2 (1 + 4 * ρ) ϖ δ ha0 hϖ0 hδ
        hϖN (hrep δ hδ hns)
    
    have hii : ∀ δ : v.adicCompletion K, δ ≠ 0 → (∀ t : v.adicCompletion K, t ^ 2 ≠ δ) →
        ∀ x y : v.adicCompletion K, x ≠ 0 → y ≠ 0 →
        (¬ ∃ z t : v.adicCompletion K, z ^ 2 - δ * t ^ 2 = x) →
        (¬ ∃ z t : v.adicCompletion K, z ^ 2 - δ * t ^ 2 = y) →
        ∃ z t : v.adicCompletion K, z ^ 2 - δ * t ^ 2 = x * y := by
      intro δ hδ hns x y hx hy hxn hyn
      have hax := quaternion_pure_repr_unramified_unit v h2 (1 + 4 * ρ) ha1 hans haU δ x hδ hx
        hns hxn
      have hay := quaternion_pure_repr_unramified_unit v h2 (1 + 4 * ρ) ha1 hans haU δ y hδ hy
        hns hyn
      exact norm_mul_mem_of_common_pure_repr_cor_3_6 hF2 (1 + 4 * ρ) δ x y ha0 hδ hx hy hns hans hxn hyn
        hax hay hmul_a
    exact S0b hi hii

theorem hilbSym_infinitePlace_mul_nondeg {K : Type u} [Field K] [NumberField K]
    (w : NumberField.InfinitePlace K) :
    (∀ a a' b : w.Completion, a ≠ 0 → a' ≠ 0 → b ≠ 0 →
      hilbSym w.Completion (a * a') b = hilbSym w.Completion a b * hilbSym w.Completion a' b) ∧
    (∀ b : w.Completion, b ≠ 0 → ¬ IsSquare b →
      ∃ a : w.Completion, a ≠ 0 ∧ hilbSym w.Completion a b = -1) :=
by
  have transport : ∀ {F₂ : Type} [Field F₂] (τ : w.Completion ≃+* F₂),
      ((∀ a a' b : F₂, a ≠ 0 → a' ≠ 0 → b ≠ 0 →
        hilbSym F₂ (a * a') b = hilbSym F₂ a b * hilbSym F₂ a' b) ∧
      (∀ b : F₂, b ≠ 0 → ¬ IsSquare b → ∃ a : F₂, a ≠ 0 ∧ hilbSym F₂ a b = -1)) →
      (∀ a a' b : w.Completion, a ≠ 0 → a' ≠ 0 → b ≠ 0 →
        hilbSym w.Completion (a * a') b = hilbSym w.Completion a b * hilbSym w.Completion a' b) ∧
      (∀ b : w.Completion, b ≠ 0 → ¬ IsSquare b →
        ∃ a : w.Completion, a ≠ 0 ∧ hilbSym w.Completion a b = -1) := by
    intro F₂ _ τ h
    have inv : ∀ a b : w.Completion, hilbSym F₂ (τ a) (τ b) = hilbSym w.Completion a b := by
      intro a b
      have hiff : (∃ x y : F₂, τ a * x ^ 2 + τ b * y ^ 2 = 1) ↔
          (∃ x y : w.Completion, a * x ^ 2 + b * y ^ 2 = 1) := by
        constructor
        · rintro ⟨x, y, hxy⟩
          refine ⟨τ.symm x, τ.symm y, τ.injective ?_⟩
          simp only [map_add, map_mul, map_pow, RingEquiv.apply_symm_apply, map_one]
          exact hxy
        · rintro ⟨x, y, hxy⟩
          refine ⟨τ x, τ y, ?_⟩
          rw [← map_pow, ← map_pow, ← map_mul, ← map_mul, ← map_add, hxy, map_one]
      unfold hilbSym
      by_cases hc : ∃ x y : w.Completion, a * x ^ 2 + b * y ^ 2 = 1
      · rw [if_pos hc, if_pos (hiff.mpr hc)]
      · rw [if_neg hc, if_neg (fun h' => hc (hiff.mp h'))]
    refine ⟨fun a a' b ha ha' hb => ?_, fun b hb hns => ?_⟩
    · rw [← inv, ← inv, ← inv, map_mul]
      exact h.1 _ _ _ ((map_ne_zero τ).mpr ha) ((map_ne_zero τ).mpr ha') ((map_ne_zero τ).mpr hb)
    · have hns' : ¬ IsSquare (τ b) := fun hsq => hns (by simpa using hsq.map τ.symm)
      obtain ⟨a₂, ha₂, he⟩ := h.2 (τ b) ((map_ne_zero τ).mpr hb) hns'
      refine ⟨τ.symm a₂, (map_ne_zero τ.symm).mpr ha₂, ?_⟩
      rw [← inv, RingEquiv.apply_symm_apply]
      exact he
  have R1 : ∀ a b : ℝ, a ≤ 0 → b ≤ 0 → hilbSym ℝ a b = -1 := by
    intro a b ha hb
    unfold hilbSym
    rw [if_neg]
    rintro ⟨x, y, hxy⟩
    nlinarith [mul_nonpos_of_nonpos_of_nonneg ha (sq_nonneg x),
      mul_nonpos_of_nonpos_of_nonneg hb (sq_nonneg y)]
  have R2 : ∀ a b : ℝ, (0 < a ∨ 0 < b) → hilbSym ℝ a b = 1 := by
    intro a b h
    unfold hilbSym
    rw [if_pos]
    rcases h with h | h
    · refine ⟨(Real.sqrt a)⁻¹, 0, ?_⟩
      rw [inv_pow, Real.sq_sqrt h.le]
      simp [h.ne']
    · refine ⟨0, (Real.sqrt b)⁻¹, ?_⟩
      rw [inv_pow, Real.sq_sqrt h.le]
      simp [h.ne']
  have PR : (∀ a a' b : ℝ, a ≠ 0 → a' ≠ 0 → b ≠ 0 →
        hilbSym ℝ (a * a') b = hilbSym ℝ a b * hilbSym ℝ a' b) ∧
      (∀ b : ℝ, b ≠ 0 → ¬ IsSquare b → ∃ a : ℝ, a ≠ 0 ∧ hilbSym ℝ a b = -1) := by
    refine ⟨fun a a' b ha ha' hb => ?_, fun b hb hns => ?_⟩
    · rcases lt_or_gt_of_ne hb with hb | hb
      · rcases lt_or_gt_of_ne ha with ha | ha <;> rcases lt_or_gt_of_ne ha' with ha' | ha'
        · rw [R2 _ _ (Or.inl (mul_pos_of_neg_of_neg ha ha')), R1 _ _ ha.le hb.le,
            R1 _ _ ha'.le hb.le]
          all_goals decide
        · rw [R1 _ _ (mul_neg_of_neg_of_pos ha ha').le hb.le, R1 _ _ ha.le hb.le,
            R2 _ _ (Or.inl ha')]
          all_goals decide
        · rw [R1 _ _ (mul_neg_of_pos_of_neg ha ha').le hb.le, R2 _ _ (Or.inl ha),
            R1 _ _ ha'.le hb.le]
          all_goals decide
        · rw [R2 _ _ (Or.inl (mul_pos ha ha')), R2 _ _ (Or.inl ha), R2 _ _ (Or.inl ha')]
          all_goals decide
      · rw [R2 _ _ (Or.inr hb), R2 _ _ (Or.inr hb), R2 _ _ (Or.inr hb)]
        all_goals decide
    · have hneg : b < 0 := by
        rcases lt_or_gt_of_ne hb with h | h
        · exact h
        · exact (hns ⟨Real.sqrt b, (Real.mul_self_sqrt h.le).symm⟩).elim
      exact ⟨-1, by norm_num, R1 _ _ (by norm_num) hneg.le⟩
  have C1 : ∀ a b : ℂ, a ≠ 0 → hilbSym ℂ a b = 1 := by
    intro a b ha
    unfold hilbSym
    rw [if_pos]
    obtain ⟨s, hs⟩ := IsAlgClosed.exists_pow_nat_eq a two_pos
    refine ⟨s⁻¹, 0, ?_⟩
    rw [inv_pow, hs]
    simp [ha]
  have PC : (∀ a a' b : ℂ, a ≠ 0 → a' ≠ 0 → b ≠ 0 →
        hilbSym ℂ (a * a') b = hilbSym ℂ a b * hilbSym ℂ a' b) ∧
      (∀ b : ℂ, b ≠ 0 → ¬ IsSquare b → ∃ a : ℂ, a ≠ 0 ∧ hilbSym ℂ a b = -1) := by
    refine ⟨fun a a' b ha ha' hb => ?_, fun b hb hns => ?_⟩
    · rw [C1 _ _ (mul_ne_zero ha ha'), C1 _ _ ha, C1 _ _ ha', mul_one]
    · obtain ⟨s, hs⟩ := IsAlgClosed.exists_pow_nat_eq b two_pos
      exact (hns ⟨s, by rw [← hs, sq]⟩).elim
  rcases w.isReal_or_isComplex with h | h
  · exact transport (NumberField.InfinitePlace.Completion.ringEquivRealOfIsReal h) PR
  · exact transport (NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex h) PC

theorem isDescentClass_mul {F : Type*} [Field F] (h2 : (2 : F) ≠ 0) (t₁ t₂ t₃ : F)
    (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃) (d₁ d₂ d₁' d₂' : F)
    (hd₁ : d₁ ≠ 0) (hd₂ : d₂ ≠ 0) (hd₁' : d₁' ≠ 0) (hd₂' : d₂' ≠ 0)
    (h : IsDescentClass t₁ t₂ t₃ d₁ d₂) (h' : IsDescentClass t₁ t₂ t₃ d₁' d₂') :
    IsDescentClass t₁ t₂ t₃ (d₁ * d₁') (d₂ * d₂') :=
by
  
  have affine_of : ∀ D₁ D₂ : F, D₁ ≠ 0 → D₂ ≠ 0 → IsDescentClass t₁ t₂ t₃ D₁ D₂ →
      (IsSquare D₁ ∧ IsSquare D₂) ∨
        ∃ x u v w : F, x - t₁ = D₁ * u ^ 2 ∧ x - t₂ = D₂ * v ^ 2 ∧
          x - t₃ = D₁ * D₂ * w ^ 2 := by
    rintro D₁ D₂ hD₁ hD₂ ⟨z₀, z₁, z₂, z₃, hnt, e1, e2⟩
    by_cases hz₀ : z₀ = 0
    · left
      subst hz₀
      have e1' : D₁ * z₁ ^ 2 = D₂ * z₂ ^ 2 := by linear_combination e1
      have e2' : z₁ ^ 2 = D₂ * z₃ ^ 2 := by
        apply mul_left_cancel₀ hD₁
        linear_combination e2
      have hz₃ : z₃ ≠ 0 := by
        intro hz₃
        subst hz₃
        have hz₁ : z₁ = 0 := by
          have : z₁ ^ 2 = 0 := by rw [e2']; ring
          exact (pow_eq_zero_iff two_ne_zero).mp this
        subst hz₁
        have hz₂ : z₂ = 0 := by
          have : D₂ * z₂ ^ 2 = 0 := by rw [← e1']; ring
          exact (pow_eq_zero_iff two_ne_zero).mp ((mul_eq_zero.mp this).resolve_left hD₂)
        exact hnt ⟨rfl, rfl, hz₂, rfl⟩
      have hz₁ : z₁ ≠ 0 := by
        intro hz₁
        subst hz₁
        have : D₂ * z₃ ^ 2 = 0 := by rw [← e2']; ring
        exact (mul_ne_zero hD₂ (pow_ne_zero 2 hz₃)) this
      have e3 : D₁ * z₃ ^ 2 = z₂ ^ 2 := by
        apply mul_left_cancel₀ (pow_ne_zero 2 hz₁)
        linear_combination z₃ ^ 2 * e1' - z₂ ^ 2 * e2'
      refine ⟨⟨z₂ / z₃, ?_⟩, ⟨z₁ / z₃, ?_⟩⟩
      · rw [div_mul_div_comm, eq_div_iff (mul_ne_zero hz₃ hz₃)]
        linear_combination e3
      · rw [div_mul_div_comm, eq_div_iff (mul_ne_zero hz₃ hz₃)]
        linear_combination -e2'
    · right
      have hz2 : z₀ ^ 2 ≠ 0 := pow_ne_zero 2 hz₀
      refine ⟨t₁ + D₁ * (z₁ / z₀) ^ 2, z₁ / z₀, z₂ / z₀, z₃ / z₀, by ring, ?_, ?_⟩
      · rw [div_pow, div_pow]
        field_simp
        linear_combination e1
      · rw [div_pow, div_pow]
        field_simp
        linear_combination e2
  
  have of_sq : ∀ D₁ D₂ : F, IsSquare D₁ → IsSquare D₂ → IsDescentClass t₁ t₂ t₃ D₁ D₂ := by
    rintro D₁ D₂ ⟨a, rfl⟩ ⟨b, rfl⟩
    exact ⟨0, b, a, 1, by simp, by ring, by ring⟩
  
  have of_affine : ∀ D₁ D₂ x u v w : F, x - t₁ = D₁ * u ^ 2 → x - t₂ = D₂ * v ^ 2 →
      x - t₃ = D₁ * D₂ * w ^ 2 → IsDescentClass t₁ t₂ t₃ D₁ D₂ := by
    intro D₁ D₂ x u v w h₁ h₂ h₃
    exact ⟨1, u, v, w, by simp, by linear_combination h₂ - h₁, by linear_combination h₃ - h₁⟩
  
  have scale : ∀ D₁ D₂ s r : F, s ≠ 0 → r ≠ 0 → IsDescentClass t₁ t₂ t₃ D₁ D₂ →
      IsDescentClass t₁ t₂ t₃ (s * s * D₁) (r * r * D₂) := by
    rintro D₁ D₂ s r hs hr ⟨z₀, z₁, z₂, z₃, hnt, e1, e2⟩
    have k1 : s * s * D₁ * (z₁ / s) ^ 2 = D₁ * z₁ ^ 2 := by
      rw [div_pow]; field_simp
    have k2 : r * r * D₂ * (z₂ / r) ^ 2 = D₂ * z₂ ^ 2 := by
      rw [div_pow]; field_simp
    have k3 : s * s * D₁ * (r * r * D₂) * (z₃ / (s * r)) ^ 2 = D₁ * D₂ * z₃ ^ 2 := by
      rw [div_pow]; field_simp
    refine ⟨z₀, z₁ / s, z₂ / r, z₃ / (s * r), ?_, ?_, ?_⟩
    · rintro ⟨h0, h1, h2, h3⟩
      exact hnt ⟨h0, (div_eq_zero_iff.mp h1).resolve_right hs,
        (div_eq_zero_iff.mp h2).resolve_right hr,
        (div_eq_zero_iff.mp h3).resolve_right (mul_ne_zero hs hr)⟩
    · rw [k1, k2]; exact e1
    · rw [k1, k3]; exact e2
  
  have chord : ∀ e p q x x' y y' L : F, x ≠ x' → L * (x - x') = y - y' →
      y ^ 2 = (x - e) * (x - p) * (x - q) → y' ^ 2 = (x' - e) * (x' - p) * (x' - q) →
      (x - e) * (x' - e) * (L ^ 2 + p + q - x - x') = (L * e + (y - L * x)) ^ 2 := by
    intro e p q x x' y y' L hxx hL hy hy'
    have hne : x - x' ≠ 0 := sub_ne_zero.mpr hxx
    apply mul_left_cancel₀ hne
    linear_combination (-(e - x')) * hy + (e - x) * hy' - (e - x) * (y + y' - L * (x - x')) * hL
  
  have transl : ∀ e p q t s M : F, t ≠ e → M * (t - e) = s →
      s ^ 2 = (t - e) * (t - p) * (t - q) →
      (M ^ 2 + p + q - t - e) * (t - e) = (e - p) * (e - q) := by
    intro e p q t s M ht hM hs
    have hne : t - e ≠ 0 := sub_ne_zero.mpr ht
    apply mul_left_cancel₀ hne
    linear_combination (M * (t - e) + s) * hM + hs
  
  have coord : ∀ e p q x x' y y' L A B a b : F, x ≠ x' → L * (x - x') = y - y' →
      y ^ 2 = (x - e) * (x - p) * (x - q) → y' ^ 2 = (x' - e) * (x' - p) * (x' - q) →
      A ≠ 0 → B ≠ 0 → x - e = A * a ^ 2 → x' - e = B * b ^ 2 →
      (x = e → ∃ g : F, (e - p) * (e - q) = A * g ^ 2) →
      (x' = e → ∃ g : F, (e - p) * (e - q) = B * g ^ 2) →
      ∃ c : F, L ^ 2 + p + q - x - x' = A * B * c ^ 2 := by
    intro e p q x x' y y' L A B a b hxx hL hy hy' hA hB ha hb hPt hQt
    by_cases hxe : x = e
    · obtain ⟨g, hg⟩ := hPt hxe
      subst hxe
      have hy0 : y = 0 := by
        have : y ^ 2 = 0 := by rw [hy]; ring
        exact (pow_eq_zero_iff two_ne_zero).mp this
      subst hy0
      have hx'e : x' ≠ x := fun h => hxx h.symm
      have hb0 : b ≠ 0 := by
        rintro rfl
        exact hx'e (by linear_combination hb)
      have hM : L * (x' - x) = y' := by linear_combination -hL
      have k := transl x p q x' y' L hx'e hM hy'
      rw [hb, hg] at k
      have hBb : B * b ^ 2 ≠ 0 := mul_ne_zero hB (pow_ne_zero 2 hb0)
      refine ⟨g / (B * b), ?_⟩
      have e' : A * B * (g / (B * b)) ^ 2 = A * g ^ 2 / (B * b ^ 2) := by
        rw [div_pow]; field_simp
      rw [e', eq_div_iff hBb]
      linear_combination k
    · by_cases hx'e : x' = e
      · obtain ⟨g, hg⟩ := hQt hx'e
        subst hx'e
        have hy0 : y' = 0 := by
          have : y' ^ 2 = 0 := by rw [hy']; ring
          exact (pow_eq_zero_iff two_ne_zero).mp this
        subst hy0
        have ha0 : a ≠ 0 := by
          rintro rfl
          exact hxe (by linear_combination ha)
        have hM : L * (x - x') = y := by linear_combination hL
        have k := transl x' p q x y L hxe hM hy
        rw [ha, hg] at k
        have hAa : A * a ^ 2 ≠ 0 := mul_ne_zero hA (pow_ne_zero 2 ha0)
        refine ⟨g / (A * a), ?_⟩
        have e' : A * B * (g / (A * a)) ^ 2 = B * g ^ 2 / (A * a ^ 2) := by
          rw [div_pow]; field_simp
        rw [e', eq_div_iff hAa]
        linear_combination k
      · have ha0 : a ≠ 0 := by
          rintro rfl
          exact hxe (by linear_combination ha)
        have hb0 : b ≠ 0 := by
          rintro rfl
          exact hx'e (by linear_combination hb)
        have k := chord e p q x x' y y' L hxx hL hy hy'
        rw [ha, hb] at k
        have hden : A * a ^ 2 * (B * b ^ 2) ≠ 0 :=
          mul_ne_zero (mul_ne_zero hA (pow_ne_zero 2 ha0)) (mul_ne_zero hB (pow_ne_zero 2 hb0))
        refine ⟨(L * e + (y - L * x)) / (A * B * a * b), ?_⟩
        have e' : A * B * ((L * e + (y - L * x)) / (A * B * a * b)) ^ 2 =
            (L * e + (y - L * x)) ^ 2 / (A * a ^ 2 * (B * b ^ 2)) := by
          rw [div_pow]; field_simp
        rw [e', eq_div_iff hden]
        linear_combination k
  
  have Kfact : ∀ D D' a a' : F, D * a ^ 2 = D' * a' ^ 2 → D * a ^ 2 ≠ 0 →
      IsSquare (D * D') := by
    intro D D' a a' he hne
    have ha' : a' ≠ 0 := by
      rintro rfl
      exact hne (by rw [he]; ring)
    refine ⟨D * a / a', ?_⟩
    rw [div_mul_div_comm, eq_div_iff (mul_ne_zero ha' ha')]
    linear_combination (-D) * he
  
  rcases affine_of d₁ d₂ hd₁ hd₂ h with ⟨⟨s, hs⟩, ⟨r, hr⟩⟩ | ⟨x, u, v, w, h₁, h₂, h₃⟩
  · have hs0 : s ≠ 0 := by rintro rfl; exact hd₁ (by rw [hs]; ring)
    have hr0 : r ≠ 0 := by rintro rfl; exact hd₂ (by rw [hr]; ring)
    rw [hs, hr]
    exact scale d₁' d₂' s r hs0 hr0 h'
  rcases affine_of d₁' d₂' hd₁' hd₂' h' with ⟨⟨s, hs⟩, ⟨r, hr⟩⟩ | ⟨x', u', v', w', h₁', h₂', h₃'⟩
  · have hs0 : s ≠ 0 := by rintro rfl; exact hd₁' (by rw [hs]; ring)
    have hr0 : r ≠ 0 := by rintro rfl; exact hd₂' (by rw [hr]; ring)
    rw [hs, hr, mul_comm d₁ (s * s), mul_comm d₂ (r * r)]
    exact scale d₁ d₂ s r hs0 hr0 h
  by_cases hxx : x = x'
  · 
    subst hxx
    have hsq : IsSquare (d₁ * d₁') ∧ IsSquare (d₂ * d₂') := by
      by_cases hx1 : x = t₁
      · have n2 : d₂ * v ^ 2 ≠ 0 := by rw [← h₂, hx1]; exact sub_ne_zero.mpr h₁₂
        have n3 : d₁ * d₂ * w ^ 2 ≠ 0 := by rw [← h₃, hx1]; exact sub_ne_zero.mpr h₁₃
        have s2 := Kfact d₂ d₂' v v' (h₂.symm.trans h₂') n2
        have s3 := Kfact (d₁ * d₂) (d₁' * d₂') w w' (h₃.symm.trans h₃') n3
        refine ⟨?_, s2⟩
        have e' : d₁ * d₁' = (d₁ * d₂ * (d₁' * d₂')) / (d₂ * d₂') := by
          rw [eq_div_iff (mul_ne_zero hd₂ hd₂')]; ring
        rw [e']
        exact s3.div s2
      · by_cases hx2 : x = t₂
        · have n1 : d₁ * u ^ 2 ≠ 0 := by rw [← h₁]; exact sub_ne_zero.mpr hx1
          have n3 : d₁ * d₂ * w ^ 2 ≠ 0 := by rw [← h₃, hx2]; exact sub_ne_zero.mpr h₂₃
          have s1 := Kfact d₁ d₁' u u' (h₁.symm.trans h₁') n1
          have s3 := Kfact (d₁ * d₂) (d₁' * d₂') w w' (h₃.symm.trans h₃') n3
          refine ⟨s1, ?_⟩
          have e' : d₂ * d₂' = (d₁ * d₂ * (d₁' * d₂')) / (d₁ * d₁') := by
            rw [eq_div_iff (mul_ne_zero hd₁ hd₁')]; ring
          rw [e']
          exact s3.div s1
        · have n1 : d₁ * u ^ 2 ≠ 0 := by rw [← h₁]; exact sub_ne_zero.mpr hx1
          have n2 : d₂ * v ^ 2 ≠ 0 := by rw [← h₂]; exact sub_ne_zero.mpr hx2
          exact ⟨Kfact d₁ d₁' u u' (h₁.symm.trans h₁') n1,
            Kfact d₂ d₂' v v' (h₂.symm.trans h₂') n2⟩
    exact of_sq _ _ hsq.1 hsq.2
  
  have hy1 : (d₁ * d₂ * u * v * w) ^ 2 = (x - t₁) * (x - t₂) * (x - t₃) := by
    rw [h₁, h₂, h₃]; ring
  have hy1' : (d₁' * d₂' * u' * v' * w') ^ 2 = (x' - t₁) * (x' - t₂) * (x' - t₃) := by
    rw [h₁', h₂', h₃']; ring
  obtain ⟨L, hL⟩ : ∃ L : F, L * (x - x') = d₁ * d₂ * u * v * w - d₁' * d₂' * u' * v' * w' :=
    ⟨_, div_mul_cancel₀ _ (sub_ne_zero.mpr hxx)⟩
  obtain ⟨c₁, hc₁⟩ := coord t₁ t₂ t₃ x x' _ _ L d₁ d₁' u u' hxx hL hy1 hy1' hd₁ hd₁' h₁ h₁'
    (fun hx => ⟨d₂ * v * w, by rw [← hx]; linear_combination (x - t₂) * h₃ + d₁ * d₂ * w ^ 2 * h₂⟩)
    (fun hx => ⟨d₂' * v' * w', by
      rw [← hx]; linear_combination (x' - t₂) * h₃' + d₁' * d₂' * w' ^ 2 * h₂'⟩)
  obtain ⟨c₂, hc₂⟩ := coord t₂ t₁ t₃ x x' _ _ L d₂ d₂' v v' hxx hL
    (by rw [hy1]; ring) (by rw [hy1']; ring) hd₂ hd₂' h₂ h₂'
    (fun hx => ⟨d₁ * u * w, by rw [← hx]; linear_combination (x - t₁) * h₃ + d₁ * d₂ * w ^ 2 * h₁⟩)
    (fun hx => ⟨d₁' * u' * w', by
      rw [← hx]; linear_combination (x' - t₁) * h₃' + d₁' * d₂' * w' ^ 2 * h₁'⟩)
  obtain ⟨c₃, hc₃⟩ := coord t₃ t₁ t₂ x x' _ _ L (d₁ * d₂) (d₁' * d₂') w w' hxx hL
    (by rw [hy1]; ring) (by rw [hy1']; ring) (mul_ne_zero hd₁ hd₂) (mul_ne_zero hd₁' hd₂') h₃ h₃'
    (fun hx => ⟨u * v, by rw [← hx]; linear_combination (x - t₁) * h₂ + d₂ * v ^ 2 * h₁⟩)
    (fun hx => ⟨u' * v', by rw [← hx]; linear_combination (x' - t₁) * h₂' + d₂' * v' ^ 2 * h₁'⟩)
  exact of_affine (d₁ * d₁') (d₂ * d₂') (L ^ 2 + t₁ + t₂ + t₃ - x - x') c₁ c₂ c₃
    (by linear_combination hc₁) (by linear_combination hc₂) (by linear_combination hc₃)

theorem isDescentClass_hilbSym_identity {F : Type*} [Field F] (h2 : (2 : F) ≠ 0)
    (hmul : ∀ a a' b : F, a ≠ 0 → a' ≠ 0 → b ≠ 0 →
      hilbSym F (a * a') b = hilbSym F a b * hilbSym F a' b)
    (t₁ t₂ t₃ : F) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃) (d₁ d₂ : F)
    (hd₁ : d₁ ≠ 0) (hd₂ : d₂ ≠ 0) (h : IsDescentClass t₁ t₂ t₃ d₁ d₂) :
    hilbSym F d₁ d₂ = hilbSym F d₁ (t₁ - t₂) * hilbSym F d₂ (-(t₁ - t₂)) :=
by
  
  have U : ∀ u v : ℤˣ, u * v = 1 → u = v := by
    intro u v huv
    have hv := Int.units_mul_self v
    calc u = u * (v * v) := by rw [hv, mul_one]
      _ = (u * v) * v := by rw [mul_assoc]
      _ = v := by rw [huv, one_mul]
  
  have Sym : ∀ a b : F, hilbSym F a b = hilbSym F b a := by
    intro a b
    have hiff : (∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1) ↔ (∃ x y : F, b * x ^ 2 + a * y ^ 2 = 1) :=
      ⟨fun ⟨x, y, h⟩ => ⟨y, x, by rw [← h]; ring⟩, fun ⟨x, y, h⟩ => ⟨y, x, by rw [← h]; ring⟩⟩
    unfold hilbSym
    by_cases hc : ∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1
    · rw [if_pos hc, if_pos (hiff.mp hc)]
    · rw [if_neg hc, if_neg (fun h' => hc (hiff.mpr h'))]
  have SqInv : ∀ a b s : F, s ≠ 0 → hilbSym F (a * s ^ 2) b = hilbSym F a b := by
    intro a b s hs
    have hiff : (∃ x y : F, a * s ^ 2 * x ^ 2 + b * y ^ 2 = 1) ↔
        (∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1) := by
      constructor
      · rintro ⟨x, y, hxy⟩
        exact ⟨s * x, y, by rw [← hxy]; ring⟩
      · rintro ⟨x, y, hxy⟩
        have hsi : s * s⁻¹ = 1 := mul_inv_cancel₀ hs
        exact ⟨x * s⁻¹, y, by linear_combination hxy + (a * x ^ 2 * (s * s⁻¹ + 1)) * hsi⟩
    unfold hilbSym
    by_cases hc : ∃ x y : F, a * s ^ 2 * x ^ 2 + b * y ^ 2 = 1
    · rw [if_pos hc, if_pos (hiff.mp hc)]
    · rw [if_neg hc, if_neg (fun h' => hc (hiff.mpr h'))]
  have SqOne : ∀ s b : F, s ≠ 0 → hilbSym F (s ^ 2) b = 1 := by
    intro s b hs
    unfold hilbSym
    rw [if_pos ⟨s⁻¹, 0, by rw [← mul_pow, mul_inv_cancel₀ hs]; ring⟩]
  have Neg : ∀ a : F, a ≠ 0 → hilbSym F a (-a) = 1 := by
    intro a ha
    have hai : a * a⁻¹ = 1 := mul_inv_cancel₀ ha
    have h2i : (2 : F) * 2⁻¹ = 1 := mul_inv_cancel₀ h2
    unfold hilbSym
    rw [if_pos ⟨(1 + a⁻¹) * 2⁻¹, (1 - a⁻¹) * 2⁻¹, by
      linear_combination (4 * (2 : F)⁻¹ ^ 2) * hai + (2 * (2 : F)⁻¹ + 1) * h2i⟩]
  have Stein : ∀ z : F, hilbSym F z (1 - z) = 1 := by
    intro z
    unfold hilbSym
    rw [if_pos ⟨1, 1, by ring⟩]
  have M2 : ∀ a b b' : F, a ≠ 0 → b ≠ 0 → b' ≠ 0 →
      hilbSym F a (b * b') = hilbSym F a b * hilbSym F a b' := by
    intro a b b' ha hb hb'
    rw [Sym a (b * b'), hmul b b' a hb hb' ha, Sym b a, Sym b' a]
  have Inv1 : ∀ a b : F, a ≠ 0 → hilbSym F a⁻¹ b = hilbSym F a b := by
    intro a b ha
    have e : a * a⁻¹ ^ 2 = a⁻¹ := by rw [sq, ← mul_assoc, mul_inv_cancel₀ ha, one_mul]
    rw [← e, SqInv a b a⁻¹ (inv_ne_zero ha)]
  have Inv2 : ∀ b a : F, a ≠ 0 → hilbSym F b a⁻¹ = hilbSym F b a := by
    intro b a ha
    rw [Sym b a⁻¹, Inv1 a b ha, Sym a b]
  
  have shift : ∀ X a : F, X ≠ 0 → a ≠ 0 → X + a ≠ 0 →
      hilbSym F X (X + a) = hilbSym F X a * hilbSym F (X + a) (-a) := by
    intro X a hX ha hXa
    have hXi : X * X⁻¹ = 1 := mul_inv_cancel₀ hX
    have hXi0 : X⁻¹ ≠ 0 := inv_ne_zero hX
    have hna : -a ≠ 0 := neg_ne_zero.mpr ha
    have hm1 : (-1 : F) ≠ 0 := neg_ne_zero.mpr one_ne_zero
    have hw0 : (X + a) * X⁻¹ ≠ 0 := mul_ne_zero hXa hXi0
    have e1 : X * ((X + a) * X⁻¹) = X + a := by
      rw [mul_comm (X + a), ← mul_assoc, hXi, one_mul]
    have e2 : 1 - (-a * X⁻¹) = (X + a) * X⁻¹ := by linear_combination (-1 : F) * hXi
    have S1 : hilbSym F X (X + a) = hilbSym F X X * hilbSym F X ((X + a) * X⁻¹) := by
      rw [← M2 X X ((X + a) * X⁻¹) hX hX hw0, e1]
    have S2 : hilbSym F X X = hilbSym F X (-1) := by
      apply U
      rw [← M2 X X (-1) hX hX hm1, mul_neg_one, Neg X hX]
    have S3 : hilbSym F (-a) ((X + a) * X⁻¹) = hilbSym F X ((X + a) * X⁻¹) := by
      apply U
      rw [← Inv1 X ((X + a) * X⁻¹) hX, ← hmul (-a) X⁻¹ ((X + a) * X⁻¹) hna hXi0 hw0, ← e2,
        Stein]
    have S4 : hilbSym F (-a) ((X + a) * X⁻¹) =
        hilbSym F (-a) (X + a) * hilbSym F (-a) X := by
      rw [M2 (-a) (X + a) X⁻¹ hna hXa hXi0, Inv2 (-a) X hX]
    have S5 : hilbSym F X a = hilbSym F X (-1) * hilbSym F X (-a) := by
      rw [← M2 X (-1) (-a) hX hm1 hna, neg_one_mul, neg_neg]
    rw [S1, S2, ← S3, S4, S5, Sym (X + a) (-a), Sym X (-a)]
    ac_rfl
  
  obtain ⟨z₀, z₁, z₂, z₃, hnt, E1, E2⟩ := h
  have E1' : d₁ * z₁ ^ 2 - d₂ * z₂ ^ 2 = -(t₁ - t₂) * z₀ ^ 2 := by linear_combination E1
  have hα : t₁ - t₂ ≠ 0 := sub_ne_zero.mpr h₁₂
  generalize t₁ - t₂ = α at E1' hα ⊢
  have sq0 : ∀ x : F, x ^ 2 = 0 → x = 0 := fun x hx => (pow_eq_zero_iff two_ne_zero).mp hx
  by_cases hz0 : z₀ = 0
  · 
    subst hz0
    have A : d₁ * z₁ ^ 2 = d₂ * z₂ ^ 2 := by linear_combination E1'
    have B' : d₁ * z₁ ^ 2 = d₁ * (d₂ * z₃ ^ 2) := by linear_combination E2
    have B : z₁ ^ 2 = d₂ * z₃ ^ 2 := mul_left_cancel₀ hd₁ B'
    have hz1 : z₁ ≠ 0 := by
      intro hz1
      subst hz1
      have h3 : d₂ * z₃ ^ 2 = 0 := by linear_combination -B
      have h2' : d₂ * z₂ ^ 2 = 0 := by linear_combination -A
      exact hnt ⟨rfl, rfl, sq0 _ ((mul_eq_zero.mp h2').resolve_left hd₂),
        sq0 _ ((mul_eq_zero.mp h3).resolve_left hd₂)⟩
    have hz3 : z₃ ≠ 0 := by
      intro hz3
      subst hz3
      exact hz1 (sq0 _ (by linear_combination B))
    have key : z₁ ^ 2 * (d₁ * z₃ ^ 2) = z₁ ^ 2 * z₂ ^ 2 := by
      linear_combination z₃ ^ 2 * A - z₂ ^ 2 * B
    have hd1z : d₁ * z₃ ^ 2 = z₂ ^ 2 := mul_left_cancel₀ (pow_ne_zero 2 hz1) key
    have hm : z₃ * z₃⁻¹ = 1 := mul_inv_cancel₀ hz3
    have hd1sq : d₁ = (z₂ * z₃⁻¹) ^ 2 := by
      linear_combination z₃⁻¹ ^ 2 * hd1z - d₁ * (1 + z₃ * z₃⁻¹) * hm
    have hd2sq : d₂ = (z₁ * z₃⁻¹) ^ 2 := by
      linear_combination -(z₃⁻¹ ^ 2) * B - d₂ * (1 + z₃ * z₃⁻¹) * hm
    have hs1 : z₂ * z₃⁻¹ ≠ 0 := fun hs => hd₁ (by rw [hd1sq, hs]; ring)
    have hs2 : z₁ * z₃⁻¹ ≠ 0 := fun hs => hd₂ (by rw [hd2sq, hs]; ring)
    rw [hd1sq, hd2sq, SqOne _ _ hs1, SqOne _ _ hs1, SqOne _ _ hs2, mul_one]
  by_cases hz1 : z₁ = 0
  · 
    subst hz1
    have hz2 : z₂ ≠ 0 := by
      intro hz2
      subst hz2
      have : α * z₀ ^ 2 = 0 := by linear_combination E1'
      rcases mul_eq_zero.mp this with h' | h'
      · exact hα h'
      · exact hz0 (sq0 _ h')
    have hj : z₂ * z₂⁻¹ = 1 := mul_inv_cancel₀ hz2
    have hd2eq : d₂ = α * (z₀ * z₂⁻¹) ^ 2 := by
      linear_combination (-(z₂⁻¹ ^ 2)) * E1' - d₂ * (1 + z₂ * z₂⁻¹) * hj
    have hs : z₀ * z₂⁻¹ ≠ 0 := fun hs => hd₂ (by rw [hd2eq, hs]; ring)
    rw [hd2eq, Sym d₁ (α * (z₀ * z₂⁻¹) ^ 2), SqInv α d₁ _ hs, SqInv α (-α) _ hs, Neg α hα,
      mul_one, Sym α d₁]
  by_cases hz2 : z₂ = 0
  · 
    subst hz2
    have hk : z₁ * z₁⁻¹ = 1 := mul_inv_cancel₀ hz1
    have hd1eq : d₁ = -α * (z₀ * z₁⁻¹) ^ 2 := by
      linear_combination (z₁⁻¹ ^ 2) * E1' - d₁ * (1 + z₁ * z₁⁻¹) * hk
    have hs : z₀ * z₁⁻¹ ≠ 0 := fun hs => hd₁ (by rw [hd1eq, hs]; ring)
    have hNN : hilbSym F (-α) α = 1 := by
      simpa using Neg (-α) (neg_ne_zero.mpr hα)
    rw [hd1eq, SqInv (-α) d₂ _ hs, SqInv (-α) α _ hs, hNN, one_mul, Sym]
  · 
    have hi : z₀ * z₀⁻¹ = 1 := mul_inv_cancel₀ hz0
    have hu : z₁ * z₀⁻¹ ≠ 0 := mul_ne_zero hz1 (inv_ne_zero hz0)
    have hv : z₂ * z₀⁻¹ ≠ 0 := mul_ne_zero hz2 (inv_ne_zero hz0)
    have hY : d₁ * (z₁ * z₀⁻¹) ^ 2 + α = d₂ * (z₂ * z₀⁻¹) ^ 2 := by
      linear_combination (z₀⁻¹ ^ 2) * E1' - α * (1 + z₀ * z₀⁻¹) * hi
    have hX0 : d₁ * (z₁ * z₀⁻¹) ^ 2 ≠ 0 := mul_ne_zero hd₁ (pow_ne_zero 2 hu)
    have hXa : d₁ * (z₁ * z₀⁻¹) ^ 2 + α ≠ 0 := by
      rw [hY]; exact mul_ne_zero hd₂ (pow_ne_zero 2 hv)
    have key := shift (d₁ * (z₁ * z₀⁻¹) ^ 2) α hX0 hα hXa
    rw [hY] at key
    calc hilbSym F d₁ d₂ = hilbSym F (d₁ * (z₁ * z₀⁻¹) ^ 2) d₂ := (SqInv _ _ _ hu).symm
      _ = hilbSym F d₂ (d₁ * (z₁ * z₀⁻¹) ^ 2) := Sym _ _
      _ = hilbSym F (d₂ * (z₂ * z₀⁻¹) ^ 2) (d₁ * (z₁ * z₀⁻¹) ^ 2) := (SqInv _ _ _ hv).symm
      _ = hilbSym F (d₁ * (z₁ * z₀⁻¹) ^ 2) (d₂ * (z₂ * z₀⁻¹) ^ 2) := Sym _ _
      _ = hilbSym F (d₁ * (z₁ * z₀⁻¹) ^ 2) α * hilbSym F (d₂ * (z₂ * z₀⁻¹) ^ 2) (-α) := key
      _ = hilbSym F d₁ α * hilbSym F d₂ (-α) := by rw [SqInv d₁ α _ hu, SqInv d₂ (-α) _ hv]

theorem adicCompletion_nonempty_localFieldStructure {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    Nonempty (EllipticRootNumber.LocalFieldStructure (v.adicCompletion K)) :=
by
  
  have approx : ∀ k : K, IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 →
      ∃ a : NumberField.RingOfIntegers K,
        IsDedekindDomain.HeightOneSpectrum.valuation K v
          (k - algebraMap (NumberField.RingOfIntegers K) K a) < 1 := by
    intro k hk
    obtain ⟨n, d, hd, hnd⟩ := IsFractionRing.div_surjective (A := NumberField.RingOfIntegers K) k
    have hd0 : d ≠ 0 := nonZeroDivisors.ne_zero hd
    have hιd : algebraMap (NumberField.RingOfIntegers K) K d ≠ 0 := by
      rw [ne_eq, map_eq_zero_iff _ (IsFractionRing.injective (NumberField.RingOfIntegers K) K)]
      exact hd0
    have hn : algebraMap (NumberField.RingOfIntegers K) K n =
        k * algebraMap (NumberField.RingOfIntegers K) K d := by
      rw [← hnd, div_mul_cancel₀ _ hιd]
    have hv0 : v.intValuation d ≠ 0 := v.intValuation_ne_zero d hd0
    have hv1 : v.intValuation d ≤ 1 := v.intValuation_le_one d
    have hlog : WithZero.log (v.intValuation d) ≤ 0 := by
      have h1 : WithZero.exp (WithZero.log (v.intValuation d)) ≤ WithZero.exp (0 : ℤ) := by
        rw [WithZero.exp_log hv0, WithZero.exp_zero]; exact hv1
      exact WithZero.exp_le_exp.mp h1
    obtain ⟨m, hm⟩ : ∃ m : ℕ, v.intValuation d = WithZero.exp (-(m : ℤ)) := by
      refine ⟨(-WithZero.log (v.intValuation d)).toNat, ?_⟩
      rw [Int.toNat_of_nonneg (by omega), neg_neg, WithZero.exp_log hv0]
    obtain ⟨J, hJ⟩ : v.asIdeal ^ m ∣ Ideal.span {d} :=
      (v.intValuation_le_pow_iff_dvd d m).mp hm.le
    have hJP : ¬ J ≤ v.asIdeal := by
      intro hle
      have h3 : v.asIdeal ^ (m + 1) ∣ Ideal.span {d} := by
        rw [hJ, pow_succ]
        exact mul_dvd_mul_left _ (Ideal.dvd_iff_le.mpr hle)
      have h2 := (v.intValuation_le_pow_iff_dvd d (m + 1)).mpr h3
      rw [hm, WithZero.exp_le_exp] at h2
      push_cast at h2
      omega
    obtain ⟨t, htJ, htP⟩ := Set.not_subset.mp hJP
    have hnv : v.intValuation n ≤ WithZero.exp (-(m : ℤ)) := by
      have e1 : v.intValuation n = IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K n) :=
        (v.valuation_of_algebraMap (K := K) n).symm
      have e2 : v.intValuation d = IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K d) :=
        (v.valuation_of_algebraMap (K := K) d).symm
      rw [e1, hn, map_mul, ← e2, hm]
      calc _ ≤ 1 * WithZero.exp (-(m : ℤ)) := mul_le_mul_right' hk _
        _ = _ := one_mul _
    have hnP : n ∈ v.asIdeal ^ m :=
      Ideal.dvd_span_singleton.mp ((v.intValuation_le_pow_iff_dvd n m).mp hnv)
    have hnt : n * t ∈ Ideal.span {d} := by
      rw [hJ]; exact Ideal.mul_mem_mul hnP htJ
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hnt
    have hbk : algebraMap (NumberField.RingOfIntegers K) K b =
        algebraMap (NumberField.RingOfIntegers K) K t * k := by
      have h4 := congrArg (algebraMap (NumberField.RingOfIntegers K) K) hb
      rw [map_mul, map_mul, hn] at h4
      apply mul_right_cancel₀ hιd
      rw [h4]; ring
    obtain ⟨s, i, hi, hsi⟩ := v.isMaximal.exists_inv htP
    refine ⟨s * b, ?_⟩
    have h1 : algebraMap (NumberField.RingOfIntegers K) K s *
        algebraMap (NumberField.RingOfIntegers K) K t +
        algebraMap (NumberField.RingOfIntegers K) K i = 1 := by
      rw [← map_mul, ← map_add, hsi, map_one]
    have key : algebraMap (NumberField.RingOfIntegers K) K t *
        (k - algebraMap (NumberField.RingOfIntegers K) K (s * b)) =
        algebraMap (NumberField.RingOfIntegers K) K b *
          algebraMap (NumberField.RingOfIntegers K) K i := by
      rw [map_mul]
      linear_combination (-1 : K) * hbk - algebraMap (NumberField.RingOfIntegers K) K b * h1
    have hvt : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K t) = 1 := by
      rw [v.valuation_of_algebraMap]; exact (v.intValuation_eq_one_iff).mpr htP
    have hvb : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K b) ≤ 1 := v.valuation_le_one (K := K) b
    have hvi : IsDedekindDomain.HeightOneSpectrum.valuation K v
        (algebraMap (NumberField.RingOfIntegers K) K i) < 1 :=
      (v.valuation_lt_one_iff_mem (K := K) i).mpr hi
    have h5 := congrArg (IsDedekindDomain.HeightOneSpectrum.valuation K v) key
    rw [map_mul (IsDedekindDomain.HeightOneSpectrum.valuation K v), hvt, one_mul,
      map_mul (IsDedekindDomain.HeightOneSpectrum.valuation K v)] at h5
    rw [h5]
    calc _ ≤ 1 * IsDedekindDomain.HeightOneSpectrum.valuation K v
          (algebraMap (NumberField.RingOfIntegers K) K i) := mul_le_mul_right' hvb _
      _ = _ := one_mul _
      _ < 1 := hvi
  
  have hfin : Finite (Valued.ResidueField (v.adicCompletion K)) := by
    have hval : ∀ x : K, Valued.v (algebraMap K (v.adicCompletion K) x) =
        IsDedekindDomain.HeightOneSpectrum.valuation K v x := fun x =>
      IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v x
    have hRK : ∀ r : NumberField.RingOfIntegers K,
        algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r =
          algebraMap K (v.adicCompletion K) (algebraMap (NumberField.RingOfIntegers K) K r) :=
      fun r => IsScalarTower.algebraMap_apply _ _ _ r
    have hmax : ∀ y : Valued.integer (v.adicCompletion K),
        y ∈ IsLocalRing.maximalIdeal (Valued.integer (v.adicCompletion K)) ↔
          Valued.v (y : v.adicCompletion K) < 1 := by
      intro y
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
        (Valuation.integer.integers
          (Valued.v : Valuation (v.adicCompletion K) _)).isUnit_iff_valuation_eq_one]
      exact ⟨fun h => lt_of_le_of_ne y.2 h, fun h => ne_of_lt h⟩
    have hint : ∀ r : NumberField.RingOfIntegers K,
        algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r ∈
          Valued.integer (v.adicCompletion K) := by
      intro r
      show Valued.v (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r) ≤ 1
      rw [hRK, hval]
      exact v.valuation_le_one r
    let φ := (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K)).codRestrict
      (Valued.integer (v.adicCompletion K)) hint
    let ψ := (IsLocalRing.residue (Valued.integer (v.adicCompletion K))).comp φ
    have hψ : ∀ r ∈ v.asIdeal, ψ r = 0 := by
      intro r hr
      show IsLocalRing.residue _ (φ r) = 0
      rw [IsLocalRing.residue_eq_zero_iff, hmax]
      show Valued.v (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) r) < 1
      rw [hRK, hval]
      exact (v.valuation_lt_one_iff_mem r).mpr hr
    let ψbar := Ideal.Quotient.lift v.asIdeal ψ hψ
    have hdense : DenseRange (algebraMap K (v.adicCompletion K)) := by
      have h := @UniformSpace.Completion.denseRange_coe
        (WithVal (IsDedekindDomain.HeightOneSpectrum.valuation K v)) _
      exact h
    have hsurj : Function.Surjective ψbar := by
      intro y
      obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective y
      have hU : {z : v.adicCompletion K | Valued.v (z - (x : v.adicCompletion K)) < 1} ∈
          nhds (x : v.adicCompletion K) :=
        Valued.mem_nhds.mpr ⟨1, fun z hz => by simpa using hz⟩
      obtain ⟨k, hk⟩ := hdense.mem_nhds hU
      simp only [Set.mem_setOf_eq] at hk
      have hk1 : IsDedekindDomain.HeightOneSpectrum.valuation K v k ≤ 1 := by
        rw [← hval]
        have e : algebraMap K (v.adicCompletion K) k =
            (algebraMap K (v.adicCompletion K) k - x) + x := by ring
        rw [e]
        exact le_trans (Valuation.map_add _ _ _) (max_le hk.le x.2)
      obtain ⟨a, ha⟩ := approx k hk1
      refine ⟨Ideal.Quotient.mk v.asIdeal a, ?_⟩
      show ψ a = IsLocalRing.residue _ x
      show IsLocalRing.residue _ (φ a) = IsLocalRing.residue _ x
      rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff, hmax]
      show Valued.v (algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) a -
        (x : v.adicCompletion K)) < 1
      have e : algebraMap (NumberField.RingOfIntegers K) (v.adicCompletion K) a -
          (x : v.adicCompletion K) =
          -(algebraMap K (v.adicCompletion K)
              (k - algebraMap (NumberField.RingOfIntegers K) K a)) +
            (algebraMap K (v.adicCompletion K) k - x) := by
        rw [hRK, map_sub]; ring
      rw [e]
      refine Valuation.map_add_lt _ ?_ hk
      rw [Valuation.map_neg, hval]
      exact ha
    haveI : Finite (NumberField.RingOfIntegers K ⧸ v.asIdeal) :=
      Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
    exact Finite.of_surjective ψbar hsurj
  
  have hlc : LocallyCompactSpace (v.adicCompletion K) := by
    haveI : CompleteSpace (Valued.integer (v.adicCompletion K)) :=
      (Valued.isClosed_integer (v.adicCompletion K)).completeSpace_coe
    haveI : IsDiscreteValuationRing (Valued.integer (v.adicCompletion K)) :=
      show IsDiscreteValuationRing (v.adicCompletionIntegers K) from inferInstance
    have hcomp : CompactSpace (Valued.integer (v.adicCompletion K)) :=
      Valued.integer.compactSpace_iff_completeSpace_and_isDiscreteValuationRing_and_finite_residueField.mpr
        ⟨inferInstance, inferInstance, hfin⟩
    have hK : IsCompact (Valued.integer (v.adicCompletion K) : Set (v.adicCompletion K)) :=
      isCompact_iff_compactSpace.mpr hcomp
    have hn : (Valued.integer (v.adicCompletion K) : Set (v.adicCompletion K)) ∈
        nhds (0 : v.adicCompletion K) :=
      (Valued.isOpen_integer (v.adicCompletion K)).mem_nhds (zero_mem _)
    exact hK.locallyCompactSpace_of_mem_nhds_of_addGroup hn
  
  obtain ⟨π, hπ⟩ := IsDedekindDomain.HeightOneSpectrum.valuation_exists_uniformizer K v
  letI rel : ValuativeRel (v.adicCompletion K) := ValuativeRel.ofValuation Valued.v
  haveI hcompat :
      (Valued.v : Valuation (v.adicCompletion K) (WithZero (Multiplicative ℤ))).Compatible :=
    ⟨fun _ _ => Iff.rfl⟩
  have e := ValuativeRel.isEquiv (ValuativeRel.valuation (v.adicCompletion K))
    (Valued.v : Valuation (v.adicCompletion K) (WithZero (Multiplicative ℤ)))
  set ϖ : v.adicCompletion K := algebraMap K (v.adicCompletion K) π with hϖdef
  have hϖ : Valued.v ϖ = WithZero.exp (-1 : ℤ) := by
    rw [hϖdef]
    exact (IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v π).trans hπ
  have hϖ0 : ϖ ≠ 0 := by
    intro h; rw [h, map_zero] at hϖ; exact WithZero.exp_ne_zero hϖ.symm
  haveI : IsValuativeTopology (v.adicCompletion K) := by
    apply IsValuativeTopology.of_zero
    intro s
    constructor
    · intro hs
      obtain ⟨γ₀, hγ₀⟩ := Valued.mem_nhds_zero.mp hs
      have hγne : (γ₀ : WithZero (Multiplicative ℤ)) ≠ 0 := Units.ne_zero γ₀
      set N : ℕ := (WithZero.log (γ₀ : WithZero (Multiplicative ℤ))).natAbs with hN
      have ha : Valued.v (ϖ ^ N) ≤ (γ₀ : WithZero (Multiplicative ℤ)) := by
        rw [map_pow, hϖ, ← WithZero.exp_nsmul, ← WithZero.exp_log hγne, WithZero.exp_le_exp]
        simp only [nsmul_eq_mul, mul_neg, mul_one]
        omega
      have ha0 : ϖ ^ N ≠ 0 := pow_ne_zero _ hϖ0
      refine ⟨Units.mk0 (ValuativeRel.valuation (v.adicCompletion K) (ϖ ^ N))
        ((Valuation.ne_zero_iff _).mpr ha0), fun z hz => hγ₀ ?_⟩
      simp only [Set.mem_setOf_eq, Units.val_mk0] at hz ⊢
      exact lt_of_lt_of_le (e.lt_iff_lt.mp hz) ha
    · rintro ⟨γ, hγ⟩
      obtain ⟨a, ha⟩ :=
        ValuativeRel.valuation_surjective
          (γ : ValuativeRel.ValueGroupWithZero (v.adicCompletion K))
      have ha0 : a ≠ 0 := by
        rintro rfl; rw [map_zero] at ha; exact Units.ne_zero γ ha.symm
      refine Valued.mem_nhds_zero.mpr ⟨Units.mk0 (Valued.v a) ((Valuation.ne_zero_iff _).mpr ha0),
        fun z hz => hγ ?_⟩
      simp only [Set.mem_setOf_eq, Units.val_mk0] at hz ⊢
      rw [← ha]
      exact e.lt_iff_lt.mpr hz
  haveI : ValuativeRel.IsNontrivial (v.adicCompletion K) := by
    refine ⟨⟨ValuativeRel.valuation (v.adicCompletion K) ϖ, (Valuation.ne_zero_iff _).mpr hϖ0, ?_⟩⟩
    intro h1
    have h2 : ValuativeRel.valuation (v.adicCompletion K) ϖ =
        ValuativeRel.valuation (v.adicCompletion K) 1 := by rw [h1, map_one]
    have h3 := e.val_eq.mp h2
    rw [hϖ, map_one] at h3
    have h4 : WithZero.exp (0 : ℤ) ≤ WithZero.exp (-1 : ℤ) := by rw [WithZero.exp_zero, h3]
    have h5 := WithZero.exp_le_exp.mp h4
    omega
  exact ⟨⟨rel, inferInstance, IsNonarchimedeanLocalField.mk⟩⟩

theorem descentSet_ncard_eq_index_two_nsmul {F : Type*} [Field F] [DecidableEq F]
    (h2 : (2 : F) ≠ 0) (t₁ t₂ t₃ : F) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃) :
    (spDesc F t₁ t₂ t₃).ncard =
      (nsmulAddMonoidHom 2 : (threeRootsCurve t₁ t₂ t₃).toAffine.Point →+
        (threeRootsCurve t₁ t₂ t₃).toAffine.Point).range.index :=
by
  
  
  
  have C9 : ∀ c : SqCl F, c * c = 1 := by
    intro c
    obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective c
    rw [← QuotientGroup.mk_mul, QuotientGroup.eq_one_iff]
    exact ⟨u, by simp [sq]⟩
  have C9p : ∀ c : SqCl F × SqCl F, c * c = 1 := fun c => Prod.ext (C9 _) (C9 _)
  have C1 : ∀ a : F, dsc2Cls a = 1 ↔ IsSquare a := by
    intro a
    unfold dsc2Cls
    split_ifs with h
    · exact ⟨fun _ => ⟨0, by rw [h, mul_zero]⟩, fun _ => rfl⟩
    · unfold sqCl
      rw [QuotientGroup.eq_one_iff]
      constructor
      · rintro ⟨y, hy⟩
        refine ⟨(y : F), ?_⟩
        have := congrArg Units.val hy
        simp only [powMonoidHom_apply, Units.val_pow_eq_pow_val, Units.val_mk0] at this
        rw [← this]; ring
      · rintro ⟨r, hr⟩
        have hr0 : r ≠ 0 := by
          rintro rfl
          exact h (by rw [hr, mul_zero])
        refine ⟨Units.mk0 r hr0, ?_⟩
        ext
        simp [hr, sq]
  have C2 : ∀ a b : F, a ≠ 0 → b ≠ 0 → dsc2Cls (a * b) = dsc2Cls a * dsc2Cls b := by
    intro a b ha hb
    unfold dsc2Cls
    rw [dif_neg (mul_ne_zero ha hb), dif_neg ha, dif_neg hb]
    unfold sqCl
    rw [← QuotientGroup.mk_mul]
    congr 1
    ext
    simp
  have C5 : ∀ a b c : F, a ≠ 0 → b ≠ 0 → c ≠ 0 → IsSquare (a * b * c) →
      dsc2Cls c = dsc2Cls a * dsc2Cls b := by
    intro a b c ha hb hc hs
    have h1 : dsc2Cls a * dsc2Cls b * dsc2Cls c = 1 := by
      rw [← C2 a b ha hb, ← C2 _ c (mul_ne_zero ha hb) hc, C1]
      exact hs
    have h2' : dsc2Cls c = (dsc2Cls a * dsc2Cls b)⁻¹ := eq_inv_of_mul_eq_one_right h1
    rw [h2']
    exact inv_eq_of_mul_eq_one_right (C9 _)
  have C4 : ∀ a b : F, a ≠ 0 → b ≠ 0 → IsSquare (a * b) → dsc2Cls a = dsc2Cls b := by
    intro a b ha hb hs
    have h1 : dsc2Cls a * dsc2Cls b = 1 := by
      rw [← C2 a b ha hb, C1]
      exact hs
    have h2' : dsc2Cls a = (dsc2Cls b)⁻¹ := eq_inv_of_mul_eq_one_left h1
    rw [h2']
    exact inv_eq_of_mul_eq_one_right (C9 _)
  have C6 : ∀ (a : F) (ha : a ≠ 0), sqCl (Units.mk0 a ha) = dsc2Cls a := by
    intro a ha
    unfold dsc2Cls
    rw [dif_neg ha]
  have C6u : ∀ u : Fˣ, dsc2Cls (u : F) = sqCl u := by
    intro u
    rw [← C6 (u : F) u.ne_zero, Units.mk0_val]
  have G0 : ∀ e p q x : F, e ≠ p → e ≠ q → dsc2G e p q x ≠ 0 := by
    intro e p q x hp hq
    unfold dsc2G
    split_ifs with h
    · exact mul_ne_zero (sub_ne_zero.mpr hp) (sub_ne_zero.mpr hq)
    · exact sub_ne_zero.mpr h
  
  
  
  have K : ∀ e p q x₁ x₂ x₃ ℓ ν : F,
      x₁ + x₂ + x₃ = e + p + q + ℓ ^ 2 →
      x₁ * x₂ + x₁ * x₃ + x₂ * x₃ = e * p + e * q + p * q - 2 * ℓ * ν →
      x₁ * x₂ * x₃ = e * p * q + ν ^ 2 → x₃ = e →
      (x₁ - e) * (x₂ - e) = (e - p) * (e - q) := by
    intro e p q x₁ x₂ x₃ ℓ ν h₁ h₂ h₃ he
    have star : (x₁ - e) * (x₂ - e) * (x₃ - e) = (ℓ * e + ν) ^ 2 := by
      linear_combination e ^ 2 * h₁ - e * h₂ + h₃
    rw [he, sub_self, mul_zero] at star
    have h0 : ℓ * e + ν = 0 := (pow_eq_zero_iff two_ne_zero).mp star.symm
    have hν : ν = -(ℓ * e) := by linear_combination h0
    subst hν
    subst he
    linear_combination h₂ - 2 * x₃ * h₁
  have S2 : ∀ e p q x₁ x₂ x₃ ℓ ν : F, e ≠ p → e ≠ q →
      x₁ + x₂ + x₃ = e + p + q + ℓ ^ 2 →
      x₁ * x₂ + x₁ * x₃ + x₂ * x₃ = e * p + e * q + p * q - 2 * ℓ * ν →
      x₁ * x₂ * x₃ = e * p * q + ν ^ 2 →
      IsSquare (dsc2G e p q x₁ * dsc2G e p q x₂ * dsc2G e p q x₃) := by
    intro e p q x₁ x₂ x₃ ℓ ν hp hq h₁ h₂ h₃
    have hc : (e - p) * (e - q) ≠ 0 := mul_ne_zero (sub_ne_zero.mpr hp) (sub_ne_zero.mpr hq)
    unfold dsc2G
    by_cases e3 : x₃ = e
    · have k := K e p q x₁ x₂ x₃ ℓ ν h₁ h₂ h₃ e3
      have n1 : x₁ ≠ e := by
        intro h; rw [h, sub_self, zero_mul] at k; exact hc k.symm
      have n2 : x₂ ≠ e := by
        intro h; rw [h, sub_self, mul_zero] at k; exact hc k.symm
      rw [if_neg n1, if_neg n2, if_pos e3]
      exact ⟨(e - p) * (e - q), by linear_combination (e - p) * (e - q) * k⟩
    · by_cases e2 : x₂ = e
      · have k := K e p q x₁ x₃ x₂ ℓ ν (by linear_combination h₁) (by linear_combination h₂)
          (by linear_combination h₃) e2
        have n1 : x₁ ≠ e := by
          intro h; rw [h, sub_self, zero_mul] at k; exact hc k.symm
        rw [if_neg n1, if_pos e2, if_neg e3]
        exact ⟨(e - p) * (e - q), by linear_combination (e - p) * (e - q) * k⟩
      · by_cases e1 : x₁ = e
        · have k := K e p q x₂ x₃ x₁ ℓ ν (by linear_combination h₁) (by linear_combination h₂)
            (by linear_combination h₃) e1
          rw [if_pos e1, if_neg e2, if_neg e3]
          exact ⟨(e - p) * (e - q), by linear_combination (e - p) * (e - q) * k⟩
        · rw [if_neg e1, if_neg e2, if_neg e3]
          exact ⟨ℓ * e + ν, by linear_combination e ^ 2 * h₁ - e * h₂ + h₃⟩
  
  
  
  set W := (threeRootsCurve t₁ t₂ t₃).toAffine with hW
  have ha1 : W.a₁ = 0 := rfl
  have ha2 : W.a₂ = -(t₁ + t₂ + t₃) := rfl
  have ha3 : W.a₃ = 0 := rfl
  have ha4 : W.a₄ = t₁ * t₂ + t₁ * t₃ + t₂ * t₃ := rfl
  have ha6 : W.a₆ = -(t₁ * t₂ * t₃) := rfl
  have Eq_iff : ∀ x y : F, W.Equation x y ↔ y ^ 2 = (x - t₁) * (x - t₂) * (x - t₃) := by
    intro x y
    rw [WeierstrassCurve.Affine.equation_iff, ha1, ha2, ha3, ha4, ha6]
    constructor <;> intro h <;> linear_combination h
  have hneg : ∀ x y : F, W.negY x y = -y := by
    intro x y
    unfold WeierstrassCurve.Affine.negY
    rw [ha1, ha3]; ring
  have haddX : ∀ x₁ x₂ ℓ : F, W.addX x₁ x₂ ℓ = ℓ ^ 2 + (t₁ + t₂ + t₃) - x₁ - x₂ := by
    intro x₁ x₂ ℓ
    unfold WeierstrassCurve.Affine.addX
    rw [ha1, ha2]; ring
  have Ns_iff : ∀ x y : F, W.Nonsingular x y ↔ y ^ 2 = (x - t₁) * (x - t₂) * (x - t₃) := by
    intro x y
    rw [WeierstrassCurve.Affine.nonsingular_iff, Eq_iff, ha1, ha2, ha3, ha4]
    constructor
    · exact fun h => h.1
    · intro h
      refine ⟨h, ?_⟩
      by_cases hy : y = 0
      · left
        rw [hy] at h ⊢
        have h0 : (x - t₁) * (x - t₂) * (x - t₃) = 0 := by rw [← h]; ring
        intro hc
        rcases mul_eq_zero.mp h0 with h' | h'
        · rcases mul_eq_zero.mp h' with h'' | h''
          · rw [sub_eq_zero.mp h''] at hc
            exact mul_ne_zero (sub_ne_zero.mpr h₁₂) (sub_ne_zero.mpr h₁₃)
              (by linear_combination -hc)
          · rw [sub_eq_zero.mp h''] at hc
            exact mul_ne_zero (sub_ne_zero.mpr h₁₂.symm) (sub_ne_zero.mpr h₂₃)
              (by linear_combination -hc)
        · rw [sub_eq_zero.mp h'] at hc
          exact mul_ne_zero (sub_ne_zero.mpr h₁₃.symm) (sub_ne_zero.mpr h₂₃.symm)
            (by linear_combination -hc)
      · right
        intro hc
        apply hy
        have h2y : 2 * y = 0 := by linear_combination hc
        exact (mul_eq_zero.mp h2y).resolve_left h2
  have some_congr : ∀ {x y x' y' : F} (h : W.Nonsingular x y) (h' : W.Nonsingular x' y'),
      x = x' → y = y' →
        WeierstrassCurve.Affine.Point.some h = WeierstrassCurve.Affine.Point.some h' := by
    rintro x y x' y' h h' rfl rfl
    rfl
  
  
  
  have S3 : ∀ x₁ y₁ x₂ y₂ ℓ : F, W.Equation x₁ y₁ → W.Equation x₂ y₂ →
      ¬(x₁ = x₂ ∧ y₁ = W.negY x₂ y₂) → ℓ = W.slope x₁ x₂ y₁ y₂ →
      x₁ + x₂ + W.addX x₁ x₂ ℓ = t₁ + t₂ + t₃ + ℓ ^ 2 ∧
      x₁ * x₂ + x₁ * W.addX x₁ x₂ ℓ + x₂ * W.addX x₁ x₂ ℓ =
        t₁ * t₂ + t₁ * t₃ + t₂ * t₃ - 2 * ℓ * (y₁ - ℓ * x₁) ∧
      x₁ * x₂ * W.addX x₁ x₂ ℓ = t₁ * t₂ * t₃ + (y₁ - ℓ * x₁) ^ 2 := by
    intro x₁ y₁ x₂ y₂ ℓ e₁ e₂ hxy hℓ
    have q1 := (Eq_iff x₁ y₁).mp e₁
    have q2 := (Eq_iff x₂ y₂).mp e₂
    have R : x₁ ^ 2 + x₁ * x₂ + x₂ ^ 2 - (t₁ + t₂ + t₃) * (x₁ + x₂) +
        (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) = ℓ ^ 2 * (x₁ + x₂) + 2 * ℓ * (y₁ - ℓ * x₁) := by
      by_cases hx : x₁ = x₂
      · have hy : y₁ ≠ -y₂ := by
          intro h
          exact hxy ⟨hx, by rw [hneg]; exact h⟩
        have hyy : y₁ = y₂ := by
          have hm : (y₁ - y₂) * (y₁ + y₂) = 0 := by
            rw [← hx] at q2
            linear_combination q1 - q2
          rcases mul_eq_zero.mp hm with h | h
          · exact sub_eq_zero.mp h
          · exact absurd (eq_neg_of_add_eq_zero_left h) hy
        have hden : y₁ - W.negY x₁ y₁ ≠ 0 := by
          rw [hneg]
          intro h
          apply hy
          rw [← hyy]
          linear_combination h
        rw [WeierstrassCurve.Affine.slope_of_Y_ne hx (by rw [hneg]; exact hy)] at hℓ
        have hl : ℓ * (y₁ - W.negY x₁ y₁) =
            3 * x₁ ^ 2 + 2 * W.a₂ * x₁ + W.a₄ - W.a₁ * y₁ := by
          rw [hℓ]
          exact div_mul_cancel₀ _ hden
        rw [hneg, ha1, ha2, ha4] at hl
        rw [← hx]
        linear_combination -hl
      · rw [WeierstrassCurve.Affine.slope_of_X_ne hx] at hℓ
        have hl : ℓ * (x₁ - x₂) = y₁ - y₂ := by
          rw [hℓ]
          exact div_mul_cancel₀ _ (sub_ne_zero.mpr hx)
        have hy2 : y₂ = y₁ - ℓ * (x₁ - x₂) := by linear_combination hl
        rw [hy2] at q2
        apply mul_left_cancel₀ (sub_ne_zero.mpr hx)
        linear_combination q2 - q1
    rw [haddX]
    refine ⟨by ring, by linear_combination -R, by linear_combination -q1 - x₁ * R⟩
  
  
  
  have S5 : ∀ (x₀ y₀ : F) (h : W.Nonsingular x₀ y₀) (r₁ r₂ r₃ : F),
      x₀ - t₁ = r₁ ^ 2 → x₀ - t₂ = r₂ ^ 2 → x₀ - t₃ = r₃ ^ 2 →
      ∃ Q : W.Point, 2 • Q = WeierstrassCurve.Affine.Point.some h := by
    intro x₀ y₀ h r₁ r₂ r₃ hr₁ hr₂ hr₃
    have hy := (Ns_iff x₀ y₀).mp h
    obtain ⟨s, hs3, hys⟩ : ∃ s : F, x₀ - t₃ = s ^ 2 ∧ y₀ = r₁ * r₂ * s := by
      have hm : (y₀ - r₁ * r₂ * r₃) * (y₀ + r₁ * r₂ * r₃) = 0 := by
        linear_combination hy + (x₀ - t₂) * (x₀ - t₃) * hr₁ + r₁ ^ 2 * (x₀ - t₃) * hr₂ +
          r₁ ^ 2 * r₂ ^ 2 * hr₃
      rcases mul_eq_zero.mp hm with h' | h'
      · exact ⟨r₃, hr₃, by linear_combination h'⟩
      · exact ⟨-r₃, by rw [hr₃]; ring, by linear_combination h'⟩
    have et1 : t₁ = x₀ - r₁ ^ 2 := by linear_combination -hr₁
    have et2 : t₂ = x₀ - r₂ ^ 2 := by linear_combination -hr₂
    have et3 : t₃ = x₀ - s ^ 2 := by linear_combination -hs3
    have hA : r₁ + r₂ ≠ 0 := by
      intro hA; apply h₁₂; linear_combination hr₂ - hr₁ + (r₂ - r₁) * hA
    have hB : r₁ + s ≠ 0 := by
      intro hB; apply h₁₃; linear_combination hs3 - hr₁ + (s - r₁) * hB
    have hC : r₂ + s ≠ 0 := by
      intro hC; apply h₂₃; linear_combination hs3 - hr₂ + (s - r₂) * hC
    have hyQ0 : (r₁ + r₂) * (r₁ + s) * (r₂ + s) ≠ 0 := mul_ne_zero (mul_ne_zero hA hB) hC
    have hQ : W.Nonsingular (x₀ + (r₁ * r₂ + r₁ * s + r₂ * s))
        ((r₁ + r₂) * (r₁ + s) * (r₂ + s)) := by
      rw [Ns_iff, et1, et2, et3]; ring
    have hyne : (r₁ + r₂) * (r₁ + s) * (r₂ + s) ≠
        W.negY (x₀ + (r₁ * r₂ + r₁ * s + r₂ * s)) ((r₁ + r₂) * (r₁ + s) * (r₂ + s)) := by
      rw [hneg]
      intro hc
      apply hyQ0
      have h2y : 2 * ((r₁ + r₂) * (r₁ + s) * (r₂ + s)) = 0 := by linear_combination hc
      exact (mul_eq_zero.mp h2y).resolve_left h2
    have hden : (r₁ + r₂) * (r₁ + s) * (r₂ + s) -
        W.negY (x₀ + (r₁ * r₂ + r₁ * s + r₂ * s)) ((r₁ + r₂) * (r₁ + s) * (r₂ + s)) ≠ 0 :=
      sub_ne_zero.mpr hyne
    have hslope : W.slope (x₀ + (r₁ * r₂ + r₁ * s + r₂ * s)) (x₀ + (r₁ * r₂ + r₁ * s + r₂ * s))
        ((r₁ + r₂) * (r₁ + s) * (r₂ + s)) ((r₁ + r₂) * (r₁ + s) * (r₂ + s)) = r₁ + r₂ + s := by
      rw [WeierstrassCurve.Affine.slope_of_Y_ne rfl hyne, div_eq_iff hden, hneg, ha1, ha2, ha4,
        et1, et2, et3]
      ring
    refine ⟨WeierstrassCurve.Affine.Point.some hQ, ?_⟩
    rw [two_nsmul, WeierstrassCurve.Affine.Point.add_self_of_Y_ne hyne]
    apply some_congr
    · rw [hslope, haddX, et1, et2, et3]; ring
    · rw [hslope]
      unfold WeierstrassCurve.Affine.addY WeierstrassCurve.Affine.negAddY
      rw [hneg, haddX, hys, et1, et2, et3]; ring
  
  
  
  have S6 : ∀ x y : F, y ^ 2 = (x - t₁) * (x - t₂) * (x - t₃) →
      IsSquare (dsc2G t₁ t₂ t₃ x) → IsSquare (dsc2G t₂ t₁ t₃ x) →
      ∃ r₁ r₂ r₃ : F, x - t₁ = r₁ ^ 2 ∧ x - t₂ = r₂ ^ 2 ∧ x - t₃ = r₃ ^ 2 := by
    intro x y hxy hs₁ hs₂
    unfold dsc2G at hs₁ hs₂
    by_cases e1 : x = t₁
    · have e2 : x ≠ t₂ := by rw [e1]; exact h₁₂
      rw [if_pos e1] at hs₁
      rw [if_neg e2] at hs₂
      obtain ⟨s, hs⟩ := hs₂
      obtain ⟨r, hr⟩ := hs₁
      have hs0 : s ≠ 0 := by
        rintro rfl; apply e2; linear_combination hs
      refine ⟨0, s, r / s, by rw [e1]; ring, by rw [hs]; ring, ?_⟩
      rw [div_pow, eq_div_iff (pow_ne_zero 2 hs0)]
      rw [e1] at hs ⊢
      linear_combination hr - (t₁ - t₃) * hs
    · by_cases e2 : x = t₂
      · rw [if_neg e1] at hs₁
        rw [if_pos e2] at hs₂
        obtain ⟨s, hs⟩ := hs₁
        obtain ⟨r, hr⟩ := hs₂
        have hs0 : s ≠ 0 := by
          rintro rfl; apply e1; linear_combination hs
        refine ⟨s, 0, r / s, by rw [hs]; ring, by rw [e2]; ring, ?_⟩
        rw [div_pow, eq_div_iff (pow_ne_zero 2 hs0)]
        rw [e2] at hs ⊢
        linear_combination hr - (t₂ - t₃) * hs
      · rw [if_neg e1] at hs₁
        rw [if_neg e2] at hs₂
        obtain ⟨a, ha⟩ := hs₁
        obtain ⟨b, hb⟩ := hs₂
        have ha0 : a ≠ 0 := by
          rintro rfl; apply e1; linear_combination ha
        have hb0 : b ≠ 0 := by
          rintro rfl; apply e2; linear_combination hb
        refine ⟨a, b, y / (a * b), by rw [ha]; ring, by rw [hb]; ring, ?_⟩
        rw [div_pow, eq_div_iff (pow_ne_zero 2 (mul_ne_zero ha0 hb0)), hxy, ha, hb]
        ring
  have S7 : ∀ x y : F, y ^ 2 = (x - t₁) * (x - t₂) * (x - t₃) →
      IsDescentClass t₁ t₂ t₃ (dsc2G t₁ t₂ t₃ x) (dsc2G t₂ t₁ t₃ x) := by
    intro x y hxy
    unfold dsc2G
    by_cases e1 : x = t₁
    · have e2 : x ≠ t₂ := by rw [e1]; exact h₁₂
      rw [if_pos e1, if_neg e2, e1]
      have hinv : (t₁ - t₂) * (t₁ - t₂)⁻¹ = 1 := mul_inv_cancel₀ (sub_ne_zero.mpr h₁₂)
      refine ⟨1, 0, 1, (t₁ - t₂)⁻¹, by simp, by ring, ?_⟩
      linear_combination -(t₁ - t₃) * ((t₁ - t₂) * (t₁ - t₂)⁻¹ + 1) * hinv
    · by_cases e2 : x = t₂
      · rw [if_neg e1, if_pos e2, e2]
        have hinv : (t₂ - t₁) * (t₂ - t₁)⁻¹ = 1 := mul_inv_cancel₀ (sub_ne_zero.mpr h₁₂.symm)
        refine ⟨1, 1, 0, (t₂ - t₁)⁻¹, by simp, by ring, ?_⟩
        linear_combination -(t₂ - t₃) * ((t₂ - t₁) * (t₂ - t₁)⁻¹ + 1) * hinv
      · rw [if_neg e1, if_neg e2]
        have hP : (x - t₁) * (x - t₂) ≠ 0 :=
          mul_ne_zero (sub_ne_zero.mpr e1) (sub_ne_zero.mpr e2)
        have hinv : (x - t₁) * (x - t₂) * ((x - t₁) * (x - t₂))⁻¹ = 1 := mul_inv_cancel₀ hP
        refine ⟨1, 1, 1, y * ((x - t₁) * (x - t₂))⁻¹, by simp, by ring, ?_⟩
        linear_combination -(x - t₃) * ((x - t₁) * (x - t₂) * ((x - t₁) * (x - t₂))⁻¹ + 1) * hinv -
          (x - t₁) * (x - t₂) * ((x - t₁) * (x - t₂))⁻¹ ^ 2 * hxy
  have S8 : ∀ d₁ d₂ : F, d₁ ≠ 0 → d₂ ≠ 0 → IsDescentClass t₁ t₂ t₃ d₁ d₂ →
      (IsSquare d₁ ∧ IsSquare d₂) ∨ ∃ x y : F, y ^ 2 = (x - t₁) * (x - t₂) * (x - t₃) ∧
        IsSquare (dsc2G t₁ t₂ t₃ x * d₁) ∧ IsSquare (dsc2G t₂ t₁ t₃ x * d₂) := by
    rintro d₁ d₂ hd₁ hd₂ ⟨z₀, z₁, z₂, z₃, hnt, E1, E2⟩
    by_cases hz0 : z₀ = 0
    · left
      rw [hz0] at E1 E2
      have F1 : d₁ * z₁ ^ 2 = d₂ * z₂ ^ 2 := by linear_combination E1
      have F2 : z₁ ^ 2 = d₂ * z₃ ^ 2 := by
        apply mul_left_cancel₀ hd₁
        linear_combination E2
      have hz3 : z₃ ≠ 0 := by
        intro h3
        rw [h3] at F2
        have hz1 : z₁ = 0 := by
          have : z₁ ^ 2 = 0 := by rw [F2]; ring
          exact (pow_eq_zero_iff two_ne_zero).mp this
        rw [hz1] at F1
        have hz2 : z₂ = 0 := by
          have : d₂ * z₂ ^ 2 = 0 := by rw [← F1]; ring
          exact (pow_eq_zero_iff two_ne_zero).mp ((mul_eq_zero.mp this).resolve_left hd₂)
        exact hnt ⟨hz0, hz1, hz2, h3⟩
      have hz1 : z₁ ≠ 0 := by
        intro h1
        rw [h1] at F2
        have : d₂ * z₃ ^ 2 = 0 := by rw [← F2]; ring
        exact (mul_ne_zero hd₂ (pow_ne_zero 2 hz3)) this
      refine ⟨⟨z₂ / z₃, ?_⟩, ⟨z₁ / z₃, ?_⟩⟩
      · rw [div_mul_div_comm, eq_div_iff (mul_ne_zero hz3 hz3)]
        apply mul_left_cancel₀ (pow_ne_zero 2 hz1)
        linear_combination z₃ ^ 2 * F1 - z₂ ^ 2 * F2
      · rw [div_mul_div_comm, eq_div_iff (mul_ne_zero hz3 hz3)]
        linear_combination -F2
    · right
      have hi : z₀ * z₀⁻¹ = 1 := mul_inv_cancel₀ hz0
      have E1' : d₁ * (z₁ * z₀⁻¹) ^ 2 - d₂ * (z₂ * z₀⁻¹) ^ 2 = t₂ - t₁ := by
        linear_combination z₀⁻¹ ^ 2 * E1 + (t₂ - t₁) * (z₀ * z₀⁻¹ + 1) * hi
      have E2' : d₁ * (z₁ * z₀⁻¹) ^ 2 - d₁ * d₂ * (z₃ * z₀⁻¹) ^ 2 = t₃ - t₁ := by
        linear_combination z₀⁻¹ ^ 2 * E2 + (t₃ - t₁) * (z₀ * z₀⁻¹ + 1) * hi
      generalize z₁ * z₀⁻¹ = u at E1' E2'
      generalize z₂ * z₀⁻¹ = v at E1' E2'
      generalize z₃ * z₀⁻¹ = w at E1' E2'
      obtain ⟨x, hx⟩ : ∃ x : F, x = t₁ + d₁ * u ^ 2 := ⟨_, rfl⟩
      have hx1 : x - t₁ = d₁ * u ^ 2 := by rw [hx]; ring
      have hx2 : x - t₂ = d₂ * v ^ 2 := by rw [hx]; linear_combination E1'
      have hx3 : x - t₃ = d₁ * d₂ * w ^ 2 := by rw [hx]; linear_combination E2'
      refine ⟨x, d₁ * d₂ * u * v * w, ?_, ?_, ?_⟩
      · linear_combination -(x - t₂) * (x - t₃) * hx1 - d₁ * u ^ 2 * (x - t₃) * hx2 -
          d₁ * u ^ 2 * (d₂ * v ^ 2) * hx3
      · unfold dsc2G
        by_cases e1 : x = t₁
        · rw [if_pos e1, ← e1, hx2, hx3]
          exact ⟨d₁ * d₂ * v * w, by ring⟩
        · rw [if_neg e1, hx1]
          exact ⟨d₁ * u, by ring⟩
      · unfold dsc2G
        by_cases e2 : x = t₂
        · rw [if_pos e2, ← e2, hx1, hx3]
          exact ⟨d₁ * d₂ * u * w, by ring⟩
        · rw [if_neg e2, hx2]
          exact ⟨d₂ * v, by ring⟩
  
  
  
  have hKz : dsc2Kummer t₁ t₂ t₃ WeierstrassCurve.Affine.Point.zero = 1 := by
    rw [dsc2Kummer]
  have hK0 : dsc2Kummer t₁ t₂ t₃ 0 = 1 := by
    rw [WeierstrassCurve.Affine.Point.zero_def, hKz]
  have hKs : ∀ {x y : F} (h : W.Nonsingular x y),
      dsc2Kummer t₁ t₂ t₃ (WeierstrassCurve.Affine.Point.some h) =
        (dsc2Cls (dsc2G t₁ t₂ t₃ x), dsc2Cls (dsc2G t₂ t₁ t₃ x)) := by
    intro x y h
    rw [dsc2Kummer]
  have M1 : ∀ c : SqCl F × SqCl F, c = 1 * c := fun c => (one_mul c).symm
  have M2 : ∀ c : SqCl F × SqCl F, c = c * 1 := fun c => (mul_one c).symm
  have Kadd : ∀ P Q : W.Point,
      dsc2Kummer t₁ t₂ t₃ (P + Q) = dsc2Kummer t₁ t₂ t₃ P * dsc2Kummer t₁ t₂ t₃ Q := by
    intro P Q
    cases P with
    | zero =>
      rw [← WeierstrassCurve.Affine.Point.zero_def, zero_add, hK0]
      exact M1 _
    | @some x₁ y₁ h₁ =>
      cases Q with
      | zero =>
        rw [← WeierstrassCurve.Affine.Point.zero_def, add_zero, hK0]
        exact M2 _
      | @some x₂ y₂ h₂ =>
        by_cases hxy : x₁ = x₂ ∧ y₁ = W.negY x₂ y₂
        · rw [WeierstrassCurve.Affine.Point.add_of_Y_eq hxy.1 hxy.2, hK0]
          obtain ⟨rfl, -⟩ := hxy
          rw [hKs, hKs]
          exact (C9p _).symm
        · rw [WeierstrassCurve.Affine.Point.add_some hxy, hKs, hKs, hKs, Prod.mk_mul_mk]
          obtain ⟨V1, V2, V3⟩ := S3 x₁ y₁ x₂ y₂ _ ((Eq_iff _ _).mpr ((Ns_iff _ _).mp h₁))
            ((Eq_iff _ _).mpr ((Ns_iff _ _).mp h₂)) hxy rfl
          congr 1
          · exact C5 _ _ _ (G0 _ _ _ _ h₁₂ h₁₃) (G0 _ _ _ _ h₁₂ h₁₃) (G0 _ _ _ _ h₁₂ h₁₃)
              (S2 t₁ t₂ t₃ x₁ x₂ _ _ _ h₁₂ h₁₃ V1 V2 V3)
          · exact C5 _ _ _ (G0 _ _ _ _ h₁₂.symm h₂₃) (G0 _ _ _ _ h₁₂.symm h₂₃)
              (G0 _ _ _ _ h₁₂.symm h₂₃)
              (S2 t₂ t₁ t₃ x₁ x₂ (W.addX x₁ x₂ (W.slope x₁ x₂ y₁ y₂)) (W.slope x₁ x₂ y₁ y₂)
                (y₁ - W.slope x₁ x₂ y₁ y₂ * x₁) h₁₂.symm h₂₃ (by linear_combination V1)
                (by linear_combination V2) (by linear_combination V3))
  
  
  
  have hone : (1 : SqCl F × SqCl F) = ((1 : SqCl F), (1 : SqCl F)) := rfl
  have Krange : Set.range (dsc2Kummer t₁ t₂ t₃) = spDesc F t₁ t₂ t₃ := by
    ext c
    constructor
    · rintro ⟨P, rfl⟩
      cases P with
      | zero =>
        refine ⟨1, 1, ?_, ⟨0, 1, 1, 1, by simp, by simp, by simp⟩⟩
        rw [hKz, ← C6u, Units.val_one, (C1 1).mpr ⟨1, (mul_one 1).symm⟩, hone]
      | @some x y h =>
        refine ⟨Units.mk0 _ (G0 t₁ t₂ t₃ x h₁₂ h₁₃), Units.mk0 _ (G0 t₂ t₁ t₃ x h₁₂.symm h₂₃),
          ?_, ?_⟩
        · rw [C6, C6, hKs]
        · simp only [Units.val_mk0]
          exact S7 x y ((Ns_iff x y).mp h)
    · rintro ⟨d₁, d₂, rfl, hd⟩
      rcases S8 d₁ d₂ d₁.ne_zero d₂.ne_zero hd with ⟨s1, s2⟩ | ⟨x, y, hxy, s1, s2⟩
      · refine ⟨0, ?_⟩
        rw [hK0, ← C6u, ← C6u, (C1 _).mpr s1, (C1 _).mpr s2, hone]
      · refine ⟨WeierstrassCurve.Affine.Point.some ((Ns_iff x y).mpr hxy), ?_⟩
        rw [hKs, ← C6u, ← C6u, C4 _ _ (G0 _ _ _ _ h₁₂ h₁₃) d₁.ne_zero s1,
          C4 _ _ (G0 _ _ _ _ h₁₂.symm h₂₃) d₂.ne_zero s2]
  
  
  
  let δ : W.Point →+ Additive (SqCl F × SqCl F) :=
    AddMonoidHom.mk' (fun P => Additive.ofMul (dsc2Kummer t₁ t₂ t₃ P))
      (fun P Q => by dsimp only; rw [Kadd, ofMul_mul])
  have hδ : ∀ P, δ P = Additive.ofMul (dsc2Kummer t₁ t₂ t₃ P) := fun P => rfl
  have hker : δ.ker = (nsmulAddMonoidHom 2 : W.Point →+ W.Point).range := by
    ext P
    rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range, hδ, ofMul_eq_zero]
    constructor
    · intro hK
      cases P with
      | zero => exact ⟨0, by rw [map_zero, WeierstrassCurve.Affine.Point.zero_def]⟩
      | @some x y h =>
        rw [hKs, Prod.mk_eq_one] at hK
        obtain ⟨r₁, r₂, r₃, e1, e2, e3⟩ :=
          S6 x y ((Ns_iff x y).mp h) ((C1 _).mp hK.1) ((C1 _).mp hK.2)
        obtain ⟨Q, hQ⟩ := S5 x y h r₁ r₂ r₃ e1 e2 e3
        exact ⟨Q, by rw [nsmulAddMonoidHom_apply]; exact hQ⟩
    · rintro ⟨Q, rfl⟩
      rw [nsmulAddMonoidHom_apply, ← ofMul_eq_zero, ← hδ, map_nsmul, two_nsmul, hδ, ← ofMul_mul,
        C9p, ofMul_one]
  
  
  
  have hrange : SetLike.coe (AddMonoidHom.range δ) =
      Additive.ofMul '' Set.range (dsc2Kummer t₁ t₂ t₃) := by
    rw [AddMonoidHom.coe_range, ← Set.range_comp]
    rfl
  rw [← hker, AddSubgroup.index_ker, ← SetLike.coe_sort_coe, hrange,
    Nat.card_image_of_injective Additive.ofMul.injective, Krange, Nat.card_coe_set_eq]

theorem threeRootsCurve_valuation_of_nonsingular {F : Type*} [Field F] [ValuativeRel F]
    (t₁ t₂ t₃ : F) (ht₁ : ValuativeRel.valuation F t₁ ≤ 1) (ht₂ : ValuativeRel.valuation F t₂ ≤ 1)
    (ht₃ : ValuativeRel.valuation F t₃ ≤ 1) {x y : F}
    (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y) :
    (1 < ValuativeRel.valuation F x →
      ValuativeRel.valuation F y ^ 2 = ValuativeRel.valuation F x ^ 3 ∧
      ValuativeRel.valuation F (x / y) ^ 2 * ValuativeRel.valuation F x = 1) ∧
    (ValuativeRel.valuation F x ≤ 1 → ValuativeRel.valuation F y ≤ 1) ∧
    (∀ c : F, ValuativeRel.valuation F c < 1 →
      (1 ≤ ValuativeRel.valuation F (c ^ 2 * x) ↔
        1 < ValuativeRel.valuation F x ∧ ValuativeRel.valuation F (x / y) ≤ ValuativeRel.valuation F c)) :=
by
  have hy2 : y ^ 2 = (x - t₁) * (x - t₂) * (x - t₃) := by
    have := h.1
    rw [WeierstrassCurve.Affine.equation_iff] at this
    simp only [threeRootsCurve] at this
    linear_combination this
  have hVy : ValuativeRel.valuation F y ^ 2 = ValuativeRel.valuation F (x - t₁) *
      ValuativeRel.valuation F (x - t₂) * ValuativeRel.valuation F (x - t₃) := by
    rw [← map_pow, hy2, map_mul, map_mul]
  have hne : ∀ a : ValuativeRel.ValueGroupWithZero F, 1 < a → a ≠ 0 := by
    intro a ha h0
    rw [h0] at ha
    exact absurd ha (not_lt.mpr zero_le')
  have partA : 1 < ValuativeRel.valuation F x →
      ValuativeRel.valuation F y ^ 2 = ValuativeRel.valuation F x ^ 3 ∧
      ValuativeRel.valuation F (x / y) ^ 2 * ValuativeRel.valuation F x = 1 := by
    intro hx
    have e : ∀ t : F, ValuativeRel.valuation F t ≤ 1 →
        ValuativeRel.valuation F (x - t) = ValuativeRel.valuation F x := fun t ht =>
      Valuation.map_sub_eq_of_lt_left _ (lt_of_le_of_lt ht hx)
    have h1 : ValuativeRel.valuation F y ^ 2 = ValuativeRel.valuation F x ^ 3 := by
      rw [hVy, e _ ht₁, e _ ht₂, e _ ht₃, pow_three, mul_assoc]
    refine ⟨h1, ?_⟩
    have hx3 : ValuativeRel.valuation F x ^ 3 ≠ 0 := pow_ne_zero 3 (hne _ hx)
    have e3 : ValuativeRel.valuation F x ^ 2 * ValuativeRel.valuation F x =
        ValuativeRel.valuation F x ^ 3 := (pow_succ _ 2).symm
    rw [map_div₀, div_pow, h1, div_mul_eq_mul_div, e3]
    exact div_self hx3
  have partB : ValuativeRel.valuation F x ≤ 1 → ValuativeRel.valuation F y ≤ 1 := by
    intro hx
    have e : ∀ t : F, ValuativeRel.valuation F t ≤ 1 → ValuativeRel.valuation F (x - t) ≤ 1 :=
      fun t ht => le_trans (Valuation.map_sub _ _ _) (max_le hx ht)
    have h2 : ValuativeRel.valuation F y ^ 2 ≤ 1 := by
      rw [hVy]
      exact mul_le_one' (mul_le_one' (e _ ht₁) (e _ ht₂)) (e _ ht₃)
    by_contra hlt
    push_neg at hlt
    exact absurd (one_lt_pow₀ hlt two_ne_zero) (not_lt.mpr h2)
  refine ⟨partA, partB, fun c hc => ?_⟩
  rw [map_mul, map_pow]
  constructor
  · intro h1
    have hx : 1 < ValuativeRel.valuation F x := by
      by_contra hle
      push_neg at hle
      exact absurd h1
        (not_le.mpr (mul_lt_one_of_lt_of_le (pow_lt_one₀ zero_le' hc two_ne_zero) hle))
    refine ⟨hx, ?_⟩
    have hx0 := hne _ hx
    have h2 : ValuativeRel.valuation F (x / y) ^ 2 * ValuativeRel.valuation F x ≤
        ValuativeRel.valuation F c ^ 2 * ValuativeRel.valuation F x := by
      rw [(partA hx).2]
      exact h1
    have h3 : ValuativeRel.valuation F (x / y) ^ 2 ≤ ValuativeRel.valuation F c ^ 2 := by
      have := mul_le_mul_right' h2 (ValuativeRel.valuation F x)⁻¹
      rwa [mul_inv_cancel_right₀ hx0, mul_inv_cancel_right₀ hx0] at this
    exact (pow_le_pow_iff_left₀ zero_le' zero_le' two_ne_zero).mp h3
  · rintro ⟨hx, hz⟩
    calc (1 : ValuativeRel.ValueGroupWithZero F)
        = ValuativeRel.valuation F (x / y) ^ 2 * ValuativeRel.valuation F x := (partA hx).2.symm
      _ ≤ ValuativeRel.valuation F c ^ 2 * ValuativeRel.valuation F x :=
          mul_le_mul_right' (pow_le_pow_left₀ zero_le' hz 2) _

theorem threeRootsCurve_add_z_estimate {F : Type*} [Field F] [ValuativeRel F] [DecidableEq F]
    (t₁ t₂ t₃ : F) (ht₁ : ValuativeRel.valuation F t₁ ≤ 1) (ht₂ : ValuativeRel.valuation F t₂ ≤ 1)
    (ht₃ : ValuativeRel.valuation F t₃ ≤ 1) {x₁ y₁ x₂ y₂ x₃ y₃ : F}
    (h₁ : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x₁ y₁)
    (h₂ : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x₂ y₂)
    (h₃ : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x₃ y₃)
    (hx₁ : 1 < ValuativeRel.valuation F x₁) (hx₂ : 1 < ValuativeRel.valuation F x₂)
    (hadd : WeierstrassCurve.Affine.Point.some h₁ + WeierstrassCurve.Affine.Point.some h₂ =
      WeierstrassCurve.Affine.Point.some h₃) :
    1 < ValuativeRel.valuation F x₃ ∧
      ValuativeRel.valuation F (x₃ / y₃ - x₁ / y₁ - x₂ / y₂) ≤
        max (ValuativeRel.valuation F (x₁ / y₁)) (ValuativeRel.valuation F (x₂ / y₂)) ^ 3 :=
by
  
  have s2 : ∃ ℓ μ : F, y₁ = ℓ * x₁ + μ ∧ y₂ = ℓ * x₂ + μ ∧ y₃ = -(ℓ * x₃ + μ) ∧
      x₁ + x₂ + x₃ = ℓ ^ 2 + (t₁ + t₂ + t₃) ∧
      x₁ * x₂ + x₁ * x₃ + x₂ * x₃ = t₁ * t₂ + t₁ * t₃ + t₂ * t₃ - 2 * ℓ * μ ∧
      x₁ * x₂ * x₃ = μ ^ 2 + t₁ * t₂ * t₃ := by
    have heq : ∀ {x y : F}, (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y →
        y ^ 2 = x ^ 3 - (t₁ + t₂ + t₃) * x ^ 2 + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) * x -
          t₁ * t₂ * t₃ := by
      intro x y h
      have := h.1
      rw [WeierstrassCurve.Affine.equation_iff] at this
      simp only [threeRootsCurve] at this
      linear_combination this
    have he₁ := heq h₁
    have he₂ := heq h₂
    have hnegY : ∀ x y : F, (threeRootsCurve t₁ t₂ t₃).toAffine.negY x y = -y := by
      intro x y
      simp [WeierstrassCurve.Affine.negY, threeRootsCurve]
    have hxy : ¬(x₁ = x₂ ∧ y₁ = (threeRootsCurve t₁ t₂ t₃).toAffine.negY x₂ y₂) := by
      rintro ⟨hx, hy⟩
      rw [WeierstrassCurve.Affine.Point.add_of_Y_eq hx hy] at hadd
      exact WeierstrassCurve.Affine.Point.some_ne_zero h₃ hadd.symm
    rw [WeierstrassCurve.Affine.Point.add_some hxy] at hadd
    simp only [WeierstrassCurve.Affine.Point.some.injEq] at hadd
    obtain ⟨hx3, hy3⟩ := hadd
    set ℓ := (threeRootsCurve t₁ t₂ t₃).toAffine.slope x₁ x₂ y₁ y₂ with hℓdef
    have hS1 : x₁ + x₂ + x₃ = ℓ ^ 2 + (t₁ + t₂ + t₃) := by
      rw [← hx3]
      simp only [WeierstrassCurve.Affine.addX, threeRootsCurve]
      ring
    have hY3 : y₃ = -(ℓ * (x₃ - x₁) + y₁) := by
      rw [← hy3, WeierstrassCurve.Affine.addY, WeierstrassCurve.Affine.negAddY, hx3, hnegY]
    have hl₂ : y₂ = ℓ * x₂ + (y₁ - ℓ * x₁) := by
      by_cases hx : x₁ = x₂
      · have hy : y₁ ≠ (threeRootsCurve t₁ t₂ t₃).toAffine.negY x₂ y₂ := fun h => hxy ⟨hx, h⟩
        have := WeierstrassCurve.Affine.Y_eq_of_Y_ne h₁.1 h₂.1 hx hy
        rw [← this, ← hx]
        ring
      · have hs := WeierstrassCurve.Affine.slope_of_X_ne
          (W := (threeRootsCurve t₁ t₂ t₃).toAffine) (y₁ := y₁) (y₂ := y₂) hx
        rw [← hℓdef] at hs
        have hx' : x₁ - x₂ ≠ 0 := sub_ne_zero.mpr hx
        have : ℓ * (x₁ - x₂) = y₁ - y₂ := by rw [hs]; field_simp
        linear_combination this
    obtain ⟨α, hα⟩ : ∃ α : F, α = (t₁ * t₂ + t₁ * t₃ + t₂ * t₃ - 2 * ℓ * (y₁ - ℓ * x₁)) -
        (x₁ * x₂ + x₁ * x₃ + x₂ * x₃) := ⟨_, rfl⟩
    obtain ⟨β, hβ⟩ : ∃ β : F, β = (-(t₁ * t₂ * t₃) - (y₁ - ℓ * x₁) ^ 2) + x₁ * x₂ * x₃ :=
      ⟨_, rfl⟩
    have hA₁ : α * x₁ + β = 0 := by
      rw [hα, hβ]
      linear_combination (-1 : F) * he₁ - x₁ ^ 2 * hS1
    have hA₂ : α * x₂ + β = 0 := by
      rw [hα, hβ]
      linear_combination (-1 : F) * he₂ + (y₂ + ℓ * x₂ + (y₁ - ℓ * x₁)) * hl₂ - x₂ ^ 2 * hS1
    have hα0 : α = 0 := by
      by_cases hx : x₁ = x₂
      · have hy : y₁ ≠ (threeRootsCurve t₁ t₂ t₃).toAffine.negY x₂ y₂ := fun h => hxy ⟨hx, h⟩
        have hyy := WeierstrassCurve.Affine.Y_eq_of_Y_ne h₁.1 h₂.1 hx hy
        have hs := WeierstrassCurve.Affine.slope_of_Y_ne
          (W := (threeRootsCurve t₁ t₂ t₃).toAffine) hx hy
        rw [← hℓdef] at hs
        rw [hnegY] at hy hs
        have hd : y₁ - -y₁ ≠ 0 := sub_ne_zero.mpr (by rw [← hyy] at hy; exact hy)
        have ht : ℓ * (y₁ - -y₁) = 3 * x₁ ^ 2 - 2 * (t₁ + t₂ + t₃) * x₁ +
            (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) := by
          rw [hs, div_mul_cancel₀ _ hd]
          simp only [threeRootsCurve]
          ring
        rw [hα]
        linear_combination (-1 : F) * ht - 2 * x₁ * hS1 + (x₃ - x₁) * hx
      · have : α * (x₁ - x₂) = 0 := by linear_combination hA₁ - hA₂
        exact (mul_eq_zero.mp this).resolve_right (sub_ne_zero.mpr hx)
    have hβ0 : β = 0 := by rw [hα0, zero_mul, zero_add] at hA₁; exact hA₁
    refine ⟨ℓ, y₁ - ℓ * x₁, by ring, hl₂, by rw [hY3]; ring, hS1, ?_, ?_⟩
    · rw [hα] at hα0; linear_combination -hα0
    · rw [hβ] at hβ0; linear_combination hβ0
  
  have s3 : ∀ (a₂ a₄ a₆ : F) (ha₂ : ValuativeRel.valuation F a₂ ≤ 1)
      (ha₄ : ValuativeRel.valuation F a₄ ≤ 1) (ha₆ : ValuativeRel.valuation F a₆ ≤ 1)
      {x₁ y₁ x₂ y₂ ℓ μ : F}
      (he₁ : y₁ ^ 2 = x₁ ^ 3 + a₂ * x₁ ^ 2 + a₄ * x₁ + a₆)
      (he₂ : y₂ ^ 2 = x₂ ^ 3 + a₂ * x₂ ^ 2 + a₄ * x₂ + a₆)
      (hx₁ : 1 < ValuativeRel.valuation F x₁) (hx₂ : 1 < ValuativeRel.valuation F x₂)
      (hv₁ : ValuativeRel.valuation F y₁ ^ 2 = ValuativeRel.valuation F x₁ ^ 3)
      (hv₂ : ValuativeRel.valuation F y₂ ^ 2 = ValuativeRel.valuation F x₂ ^ 3)
      (hl₁ : y₁ = ℓ * x₁ + μ) (hl₂ : y₂ = ℓ * x₂ + μ)
      (htan : x₁ = x₂ → 2 * ℓ * y₁ = 3 * x₁ ^ 2 + 2 * a₂ * x₁ + a₄),
      max (ValuativeRel.valuation F (x₁ / y₁)) (ValuativeRel.valuation F (x₂ / y₂)) < 1 ∧
      ValuativeRel.valuation F ℓ ≤
        max (ValuativeRel.valuation F (x₁ / y₁)) (ValuativeRel.valuation F (x₂ / y₂)) ^ 2 *
          ValuativeRel.valuation F μ ∧
      1 ≤ max (ValuativeRel.valuation F (x₁ / y₁)) (ValuativeRel.valuation F (x₂ / y₂)) ^ 3 *
          ValuativeRel.valuation F μ := by
    intro a₂ a₄ a₆ ha₂ ha₄ ha₆ x₁ y₁ x₂ y₂ ℓ μ he₁ he₂ hx₁ hx₂ hv₁ hv₂ hl₁ hl₂ htan
    set V := ValuativeRel.valuation F with hVdef
    have pt : ∀ x y : F, y ^ 2 = x ^ 3 + a₂ * x ^ 2 + a₄ * x + a₆ → 1 < V x →
        V y ^ 2 = V x ^ 3 → ∃ z w : F, z = x / y ∧ w * y = 1 ∧ x = z * y ∧ V z < 1 ∧
          V w = V z ^ 3 ∧ w ≠ 0 ∧
          w = z ^ 3 + a₂ * z ^ 2 * w + a₄ * z * w ^ 2 + a₆ * w ^ 3 := by
      intro x y he hx hv
      have hVx0 : V x ≠ 0 := ne_of_gt (lt_trans zero_lt_one hx)
      have hy0 : y ≠ 0 := by
        rintro rfl
        rw [map_zero, zero_pow two_ne_zero] at hv
        exact hVx0 (pow_eq_zero_iff (n := 3) (by norm_num) |>.mp hv.symm)
      have hVy0 : V y ≠ 0 := (Valuation.ne_zero_iff _).mpr hy0
      refine ⟨x / y, y⁻¹, rfl, inv_mul_cancel₀ hy0, by field_simp, ?_, ?_, inv_ne_zero hy0, ?_⟩
      · have h1 : V (x / y) ^ 2 * V x = 1 := by
          rw [map_div₀, div_pow, hv]
          field_simp
        by_contra hcon
        push_neg at hcon
        have h2 : 1 ≤ V (x / y) ^ 2 := one_le_pow₀ hcon
        have h3 : V x ≤ V (x / y) ^ 2 * V x := le_mul_of_one_le_left' h2
        rw [h1] at h3
        exact absurd (lt_of_le_of_lt h3 hx) (lt_irrefl _)
      · rw [map_inv₀, map_div₀, div_pow, pow_succ (V y) 2, ← hv]
        field_simp
      · field_simp
        linear_combination he
    obtain ⟨z₁, w₁, hz₁, hwy₁, hxz₁, hzlt₁, hw₁, hw₁0, E₁⟩ := pt x₁ y₁ he₁ hx₁ hv₁
    obtain ⟨z₂, w₂, hz₂, hwy₂, hxz₂, hzlt₂, hw₂, hw₂0, E₂⟩ := pt x₂ y₂ he₂ hx₂ hv₂
    rw [← hz₁, ← hz₂]
    set m := max (V z₁) (V z₂) with hm
    have hm1 : m < 1 := max_lt hzlt₁ hzlt₂
    have hmle : m ≤ 1 := le_of_lt hm1
    have hz₁m : V z₁ ≤ m := le_max_left _ _
    have hz₂m : V z₂ ≤ m := le_max_right _ _
    have hm3m : m ^ 3 ≤ m := by
      rw [pow_succ']
      exact mul_le_of_le_one_right' (pow_le_one' hmle 2)
    have hw₁m3 : V w₁ ≤ m ^ 3 := by rw [hw₁]; exact pow_le_pow_left' hz₁m 3
    have hw₂m3 : V w₂ ≤ m ^ 3 := by rw [hw₂]; exact pow_le_pow_left' hz₂m 3
    have hw₁m : V w₁ ≤ m := le_trans hw₁m3 hm3m
    have hw₂m : V w₂ ≤ m := le_trans hw₂m3 hm3m
    have L₁ : ℓ * z₁ + μ * w₁ = 1 := by
      have h := hl₁
      rw [hxz₁] at h
      linear_combination (-w₁) * h + (1 - ℓ * z₁) * hwy₁
    have L₂ : ℓ * z₂ + μ * w₂ = 1 := by
      have h := hl₂
      rw [hxz₂] at h
      linear_combination (-w₂) * h + (1 - ℓ * z₂) * hwy₂
    have hsm : ∀ a u : F, V a ≤ 1 → V u < 1 → V (a * u) < 1 := by
      intro a u ha hu
      rw [map_mul]
      exact Right.mul_lt_one_of_le_of_lt ha hu
    have hzs₁ : V z₁ < 1 := hzlt₁
    have hws₁ : V w₁ < 1 := lt_of_le_of_lt hw₁m hm1
    have hws₂ : V w₂ < 1 := lt_of_le_of_lt hw₂m hm1
    have hz₁le : V z₁ ≤ 1 := le_of_lt hzs₁
    have hw₁le : V w₁ ≤ 1 := le_of_lt hws₁
    have hw₂le : V w₂ ≤ 1 := le_of_lt hws₂
    obtain ⟨C, hC⟩ : ∃ C : F, C = 1 - a₂ * z₁ ^ 2 - a₄ * z₁ * (w₁ + w₂) -
        a₆ * (w₁ ^ 2 + w₁ * w₂ + w₂ ^ 2) := ⟨_, rfl⟩
    obtain ⟨D, hD⟩ : ∃ D : F, D = z₁ ^ 2 + z₁ * z₂ + z₂ ^ 2 + a₂ * (z₁ + z₂) * w₂ +
        a₄ * w₂ ^ 2 := ⟨_, rfl⟩
    have b5 : (w₂ - w₁) * C = (z₂ - z₁) * D := by
      rw [hC, hD]
      linear_combination E₂ - E₁
    have hC1 : V C = 1 := by
      have e : C = 1 + (-(a₂ * (z₁ * z₁) + a₄ * (z₁ * (w₁ + w₂)) +
          a₆ * (w₁ * w₁ + w₁ * w₂ + w₂ * w₂))) := by rw [hC]; ring
      rw [e]
      apply Valuation.map_one_add_of_lt
      rw [Valuation.map_neg]
      refine Valuation.map_add_lt _ (Valuation.map_add_lt _ ?_ ?_) ?_
      · exact hsm _ _ ha₂ (hsm _ _ hz₁le hzs₁)
      · exact hsm _ _ ha₄ (hsm _ _ hz₁le (Valuation.map_add_lt _ hws₁ hws₂))
      · refine hsm _ _ ha₆ (Valuation.map_add_lt _ (Valuation.map_add_lt _ ?_ ?_) ?_)
        · exact hsm _ _ hw₁le hws₁
        · exact hsm _ _ hw₁le hws₂
        · exact hsm _ _ hw₂le hws₂
    have hC0 : C ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hC1
      exact zero_ne_one hC1
    have hDm : V D ≤ m ^ 2 := by
      have hsum : V (z₁ + z₂) ≤ m := Valuation.map_add_le _ hz₁m hz₂m
      rw [hD]
      refine Valuation.map_add_le _ (Valuation.map_add_le _ (Valuation.map_add_le _
        (Valuation.map_add_le _ ?_ ?_) ?_) ?_) ?_
      · rw [map_pow]; exact pow_le_pow_left' hz₁m 2
      · rw [map_mul, sq]; exact mul_le_mul' hz₁m hz₂m
      · rw [map_pow]; exact pow_le_pow_left' hz₂m 2
      · rw [map_mul, map_mul, sq]
        calc V a₂ * V (z₁ + z₂) * V w₂ ≤ 1 * m * m := mul_le_mul' (mul_le_mul' ha₂ hsum) hw₂m
          _ = m * m := by rw [one_mul]
      · rw [map_mul, map_pow]
        calc V a₄ * V w₂ ^ 2 ≤ 1 * m ^ 2 := mul_le_mul' ha₄ (pow_le_pow_left' hw₂m 2)
          _ = m ^ 2 := one_mul _
    have hkey : ℓ * C + μ * D = 0 := by
      by_cases hzz : z₁ = z₂
      · have h0 : (w₂ - w₁) * C = 0 := by rw [b5, hzz, sub_self, zero_mul]
        have hww : w₁ = w₂ := (sub_eq_zero.mp ((mul_eq_zero.mp h0).resolve_right hC0)).symm
        have hyy : y₁ = y₂ := by
          apply mul_left_cancel₀ hw₁0
          rw [hwy₁, hww, hwy₂]
        have hxx : x₁ = x₂ := by rw [hxz₁, hxz₂, hzz, hyy]
        have ht := htan hxx
        rw [hxz₁] at ht
        subst hzz
        subst hww
        have t1 : D = 2 * ℓ * w₁ := by
          rw [hD]
          linear_combination (-w₁ ^ 2) * ht -
            (3 * z₁ ^ 2 * (1 + w₁ * y₁) + 2 * a₂ * z₁ * w₁ - 2 * ℓ * w₁) * hwy₁
        have t2 : C * w₁ = D * z₁ - 2 * w₁ := by
          rw [hC, hD]
          linear_combination 3 * E₁
        have t3 : w₁ * (ℓ * C + μ * D) = 0 := by
          linear_combination ℓ * t2 + (ℓ * z₁ + μ * w₁) * t1 + 2 * ℓ * w₁ * L₁
        exact (mul_eq_zero.mp t3).resolve_left hw₁0
      · have h1 : (z₂ - z₁) * (ℓ * C + μ * D) = 0 := by
          linear_combination C * L₂ - C * L₁ - μ * b5
        exact (mul_eq_zero.mp h1).resolve_left (sub_ne_zero.mpr (Ne.symm hzz))
    refine ⟨hm1, ?_, ?_⟩
    · have h := congrArg V (show ℓ * C = -(μ * D) by linear_combination hkey)
      rw [Valuation.map_neg, map_mul, map_mul, hC1, mul_one] at h
      rw [h, mul_comm (m ^ 2)]
      exact mul_le_mul' le_rfl hDm
    · have hC9 : C = μ * (C * w₁ - D * z₁) := by
        linear_combination (-C) * L₁ + z₁ * hkey
      have hb : V (C * w₁ - D * z₁) ≤ m ^ 3 := by
        refine Valuation.map_sub_le _ ?_ ?_
        · rw [map_mul, hC1, one_mul]; exact hw₁m3
        · rw [map_mul, pow_succ]; exact mul_le_mul' hDm hz₁m
      have h := congrArg V hC9
      rw [map_mul, hC1] at h
      rw [h, mul_comm (m ^ 3)]
      exact mul_le_mul' le_rfl hb
  
  have s4 : ∀ (a₂ a₄ a₆ : F) (ha₂ : ValuativeRel.valuation F a₂ ≤ 1)
      (ha₄ : ValuativeRel.valuation F a₄ ≤ 1) (ha₆ : ValuativeRel.valuation F a₆ ≤ 1)
      {x₁ y₁ x₂ y₂ x₃ y₃ ℓ μ : F} (m : ValuativeRel.ValueGroupWithZero F)
      (he₃ : y₃ ^ 2 = x₃ ^ 3 + a₂ * x₃ ^ 2 + a₄ * x₃ + a₆)
      (hy₁ : y₁ ≠ 0) (hy₂ : y₂ ≠ 0)
      (hl₁ : y₁ = ℓ * x₁ + μ) (hl₂ : y₂ = ℓ * x₂ + μ) (hl₃ : y₃ = -(ℓ * x₃ + μ))
      (hs₁ : x₁ + x₂ + x₃ = ℓ ^ 2 - a₂)
      (hs₂ : x₁ * x₂ + x₁ * x₃ + x₂ * x₃ = a₄ - 2 * ℓ * μ)
      (hs₃ : x₁ * x₂ * x₃ = μ ^ 2 - a₆)
      (hm : m < 1) (hℓ : ValuativeRel.valuation F ℓ ≤ m ^ 2 * ValuativeRel.valuation F μ)
      (hμ : 1 ≤ m ^ 3 * ValuativeRel.valuation F μ),
      1 < ValuativeRel.valuation F x₃ ∧
        ValuativeRel.valuation F (x₃ / y₃ - x₁ / y₁ - x₂ / y₂) ≤ m ^ 3 := by
    intro a₂ a₄ a₆ ha₂ ha₄ ha₆ x₁ y₁ x₂ y₂ x₃ y₃ ℓ μ m he₃ hy₁ hy₂ hl₁ hl₂ hl₃ hs₁ hs₂ hs₃
      hm hℓ hμ
    set V := ValuativeRel.valuation F with hVdef
    have hm3 : m ^ 3 < 1 := pow_lt_one₀ zero_le' hm (by norm_num)
    have hm2 : m ^ 2 < 1 := pow_lt_one₀ zero_le' hm (by norm_num)
    have hμ1 : 1 < V μ := by
      by_contra h
      push_neg at h
      have : m ^ 3 * V μ < 1 := lt_of_le_of_lt (mul_le_of_le_one_right' h) hm3
      exact absurd (lt_of_le_of_lt hμ this) (lt_irrefl _)
    have hμ0 : 0 < V μ := lt_trans zero_lt_one hμ1
    have hℓμ : V ℓ < V μ := lt_of_le_of_lt hℓ (mul_lt_of_lt_one_left hμ0 hm2)
    have hint : ∀ a t : F, V a ≤ 1 → V (a * t) ≤ V t := by
      intro a t ha
      rw [map_mul]
      exact mul_le_of_le_one_left' ha
    have hV2 : V 2 ≤ 1 := by
      rw [← one_add_one_eq_two]
      exact Valuation.map_add_le _ (map_one _).le (map_one _).le
    have hV3 : V 3 ≤ 1 := by
      rw [show (3 : F) = 2 + 1 by norm_num]
      exact Valuation.map_add_le _ hV2 (map_one _).le
    have hx₃ : 1 < V x₃ := by
      by_contra h
      push_neg at h
      have h1 : V (ℓ * x₃) < V μ := by
        rw [map_mul]
        exact lt_of_le_of_lt (mul_le_of_le_one_right' h) hℓμ
      have h2 : V y₃ = V μ := by
        rw [hl₃, Valuation.map_neg]
        exact Valuation.map_add_eq_of_lt_right _ h1
      have h3 : V (y₃ ^ 2) ≤ 1 := by
        rw [he₃]
        refine Valuation.map_add_le _ (Valuation.map_add_le _
          (Valuation.map_add_le _ ?_ ?_) ?_) ha₆
        · rw [map_pow]; exact pow_le_one' h 3
        · exact le_trans (hint _ _ ha₂) (by rw [map_pow]; exact pow_le_one' h 2)
        · exact le_trans (hint _ _ ha₄) h
      rw [map_pow, h2] at h3
      have h4 : 1 < V μ ^ 2 := one_lt_pow₀ hμ1 (by norm_num)
      exact absurd (lt_of_lt_of_le h4 h3) (lt_irrefl _)
    refine ⟨hx₃, ?_⟩
    obtain ⟨G, hG⟩ : ∃ G : F, G = μ ^ 3 - a₂ * ℓ * μ ^ 2 + a₄ * ℓ ^ 2 * μ - a₆ * ℓ ^ 3 :=
      ⟨_, rfl⟩
    obtain ⟨H, hH⟩ : ∃ H : F, H = a₂ * μ ^ 2 - 2 * a₄ * ℓ * μ + 3 * a₆ * ℓ ^ 2 := ⟨_, rfl⟩
    have hℓ2 : V ℓ ^ 2 < V μ ^ 2 := pow_lt_pow_left₀ hℓμ zero_le' (by norm_num)
    have hℓ3 : V ℓ ^ 3 < V μ ^ 3 := pow_lt_pow_left₀ hℓμ zero_le' (by norm_num)
    have hVG : V G = V μ ^ 3 := by
      have e : G = μ ^ 3 + (-(a₂ * (ℓ * μ ^ 2)) + a₄ * (ℓ ^ 2 * μ) - a₆ * ℓ ^ 3) := by
        rw [hG]; ring
      rw [e, ← map_pow]
      apply Valuation.map_add_eq_of_lt_left
      rw [map_pow]
      refine Valuation.map_sub_lt _ (Valuation.map_add_lt _ ?_ ?_) ?_
      · rw [Valuation.map_neg]
        refine lt_of_le_of_lt (hint _ _ ha₂) ?_
        rw [map_mul, map_pow, pow_succ' (V μ) 2]
        exact mul_lt_mul_of_pos_right hℓμ (pow_pos hμ0 2)
      · refine lt_of_le_of_lt (hint _ _ ha₄) ?_
        rw [map_mul, map_pow, pow_succ (V μ) 2]
        exact mul_lt_mul_of_pos_right hℓ2 hμ0
      · refine lt_of_le_of_lt (hint _ _ ha₆) ?_
        rw [map_pow]
        exact hℓ3
    have hG0 : G ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hVG
      exact (ne_of_gt (pow_pos hμ0 3)) hVG.symm
    have hVH : V H ≤ V μ ^ 2 := by
      rw [hH]
      refine Valuation.map_add_le _ (Valuation.map_sub_le _ ?_ ?_) ?_
      · exact le_trans (hint _ _ ha₂) (by rw [map_pow])
      · rw [show 2 * a₄ * ℓ * μ = 2 * (a₄ * (ℓ * μ)) by ring]
        refine le_trans (hint _ _ hV2) (le_trans (hint _ _ ha₄) ?_)
        rw [map_mul, sq]
        exact mul_le_mul' (le_of_lt hℓμ) le_rfl
      · rw [show 3 * a₆ * ℓ ^ 2 = 3 * (a₆ * ℓ ^ 2) by ring]
        refine le_trans (hint _ _ hV3) (le_trans (hint _ _ ha₆) ?_)
        rw [map_pow]
        exact le_of_lt hℓ2
    have I1 : y₁ * y₂ * (ℓ * x₃ + μ) = G := by
      rw [hl₁, hl₂, hG]
      linear_combination ℓ ^ 3 * hs₃ + ℓ ^ 2 * μ * hs₂ + ℓ * μ ^ 2 * hs₁
    have I2 : x₁ * y₂ * (ℓ * x₃ + μ) + x₂ * y₁ * (ℓ * x₃ + μ) + x₃ * y₁ * y₂ = -H := by
      rw [hl₁, hl₂, hH]
      linear_combination 3 * ℓ ^ 2 * hs₃ + 2 * ℓ * μ * hs₂ + μ ^ 2 * hs₁
    have hL₃ : ℓ * x₃ + μ ≠ 0 := by
      intro h0
      rw [h0, mul_zero] at I1
      exact hG0 I1.symm
    have hy₃ : y₃ ≠ 0 := by rw [hl₃]; exact neg_ne_zero.mpr hL₃
    have hformula : x₃ / y₃ - x₁ / y₁ - x₂ / y₂ = H / G := by
      rw [div_sub_div _ _ hy₃ hy₁, div_sub_div _ _ (mul_ne_zero hy₃ hy₁) hy₂,
        div_eq_div_iff (mul_ne_zero (mul_ne_zero hy₃ hy₁) hy₂) hG0]
      rw [hl₃]
      linear_combination G * I2 + H * I1
    rw [hformula, map_div₀, hVG, div_le_iff₀ (pow_pos hμ0 3)]
    calc V H ≤ V μ ^ 2 := hVH
      _ = V μ ^ 2 * 1 := (mul_one _).symm
      _ ≤ V μ ^ 2 * (m ^ 3 * V μ) := mul_le_mul' le_rfl hμ
      _ = m ^ 3 * V μ ^ 3 := by rw [mul_left_comm, ← pow_succ]
  
  have heq : ∀ {x y : F}, (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y →
      y ^ 2 = x ^ 3 + -(t₁ + t₂ + t₃) * x ^ 2 + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) * x +
        -(t₁ * t₂ * t₃) := by
    intro x y h
    have := h.1
    rw [WeierstrassCurve.Affine.equation_iff] at this
    simp only [threeRootsCurve] at this
    linear_combination this
  have ha₂ : ValuativeRel.valuation F (-(t₁ + t₂ + t₃)) ≤ 1 := by
    rw [Valuation.map_neg]
    exact Valuation.map_add_le _ (Valuation.map_add_le _ ht₁ ht₂) ht₃
  have hprod : ∀ a b : F, ValuativeRel.valuation F a ≤ 1 → ValuativeRel.valuation F b ≤ 1 →
      ValuativeRel.valuation F (a * b) ≤ 1 := by
    intro a b ha hb
    rw [map_mul]
    exact mul_le_one' ha hb
  have ha₄ : ValuativeRel.valuation F (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) ≤ 1 :=
    Valuation.map_add_le _ (Valuation.map_add_le _ (hprod _ _ ht₁ ht₂) (hprod _ _ ht₁ ht₃))
      (hprod _ _ ht₂ ht₃)
  have ha₆ : ValuativeRel.valuation F (-(t₁ * t₂ * t₃)) ≤ 1 := by
    rw [Valuation.map_neg]
    exact hprod _ _ (hprod _ _ ht₁ ht₂) ht₃
  have hv : ∀ {x y : F}, (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y →
      1 < ValuativeRel.valuation F x →
      ValuativeRel.valuation F y ^ 2 = ValuativeRel.valuation F x ^ 3 := by
    intro x y h hx
    have hy2 : y ^ 2 = (x - t₁) * (x - t₂) * (x - t₃) := by linear_combination heq h
    have hd : ∀ t : F, ValuativeRel.valuation F t ≤ 1 →
        ValuativeRel.valuation F (x - t) = ValuativeRel.valuation F x := fun t ht =>
      Valuation.map_sub_eq_of_lt_left _ (lt_of_le_of_lt ht hx)
    rw [← map_pow, hy2, map_mul, map_mul, hd _ ht₁, hd _ ht₂, hd _ ht₃, pow_succ, sq]
  have hy0 : ∀ {x y : F}, (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y →
      1 < ValuativeRel.valuation F x → y ≠ 0 := by
    intro x y h hx h0
    have h1 := hv h hx
    rw [h0, map_zero, zero_pow two_ne_zero] at h1
    have h2 : ValuativeRel.valuation F x = 0 :=
      (pow_eq_zero_iff (n := 3) (by norm_num)).mp h1.symm
    rw [h2] at hx
    exact absurd hx (not_lt.mpr zero_le')
  obtain ⟨ℓ, μ, hl₁, hl₂, hl₃, hs₁, hs₂, hs₃⟩ := s2
  have hs₁' : x₁ + x₂ + x₃ = ℓ ^ 2 - -(t₁ + t₂ + t₃) := by linear_combination hs₁
  have hs₃' : x₁ * x₂ * x₃ = μ ^ 2 - -(t₁ * t₂ * t₃) := by linear_combination hs₃
  have htan : x₁ = x₂ → 2 * ℓ * y₁ =
      3 * x₁ ^ 2 + 2 * -(t₁ + t₂ + t₃) * x₁ + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) := by
    intro hx
    linear_combination 2 * ℓ * hl₁ - 2 * x₁ * hs₁' + hs₂ + (x₃ - x₁) * hx
  obtain ⟨hm, hℓ, hμ⟩ := s3 _ _ _ ha₂ ha₄ ha₆ (heq h₁) (heq h₂) hx₁ hx₂ (hv h₁ hx₁)
    (hv h₂ hx₂) hl₁ hl₂ htan
  exact s4 _ _ _ ha₂ ha₄ ha₆ _ (heq h₃) (hy0 h₁ hx₁) (hy0 h₂ hx₂) hl₁ hl₂ hl₃ hs₁' hs₂ hs₃'
    hm hℓ hμ

theorem threeRootsCurve_filtration_relIndex_two (F : Type*) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F] [DecidableEq F]
    (t₁ t₂ t₃ : F) (ht₁ : ValuativeRel.valuation F t₁ ≤ 1) (ht₂ : ValuativeRel.valuation F t₂ ≤ 1)
    (ht₃ : ValuativeRel.valuation F t₃ ≤ 1)
    (hsq : ∀ u : F, ValuativeRel.valuation F (u - 1) < ValuativeRel.valuation F 4 → IsSquare u)
    (U : F → AddSubgroup (threeRootsCurve t₁ t₂ t₃).toAffine.Point)
    (hU : ∀ c : F, ValuativeRel.valuation F c < 1 → ∀ P, P ∈ U c ↔
      ∀ (x y : F) (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y),
        P = WeierstrassCurve.Affine.Point.some h → 1 ≤ ValuativeRel.valuation F (c ^ 2 * x))
    (c : F) (hc0 : c ≠ 0) (hc : ValuativeRel.valuation F c < ValuativeRel.valuation F 2) :
    (U (2 * c)).relIndex (U c) =
      Nat.card (↥(ValuativeRel.valuation F).integer ⧸
        Ideal.span {(2 : ↥(ValuativeRel.valuation F).integer)}) :=
by
  classical
  
  have h2 : (2 : F) ≠ 0 := two_ne_zero
  have hV2 : ValuativeRel.valuation F 2 ≤ 1 := by
    rw [← one_add_one_eq_two]
    exact Valuation.map_add_le _ (map_one _).le (map_one _).le
  have hV2pos : 0 < ValuativeRel.valuation F 2 := by
    rw [zero_lt_iff]; exact (Valuation.ne_zero_iff _).mpr h2
  have hc1 : ValuativeRel.valuation F c < 1 := lt_of_lt_of_le hc hV2
  have hVcpos : 0 < ValuativeRel.valuation F c := by
    rw [zero_lt_iff]; exact (Valuation.ne_zero_iff _).mpr hc0
  have hV2c : ValuativeRel.valuation F (2 * c) =
      ValuativeRel.valuation F 2 * ValuativeRel.valuation F c := map_mul _ _ _
  have h2c1 : ValuativeRel.valuation F (2 * c) < 1 := by
    rw [hV2c]; exact Right.mul_lt_one_of_le_of_lt hV2 hc1
  have hV4 : ValuativeRel.valuation F 4 ≤ 1 := by
    rw [show (4 : F) = 2 * 2 by norm_num, map_mul]; exact mul_le_one' hV2 hV2
  have memU : ∀ c₀ : F, ValuativeRel.valuation F c₀ < 1 → ∀ {x y : F}
      (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y),
      WeierstrassCurve.Affine.Point.some h ∈ U c₀ ↔
        1 ≤ ValuativeRel.valuation F (c₀ ^ 2 * x) := by
    intro c₀ hc₀ x y h
    rw [hU c₀ hc₀]
    constructor
    · intro H; exact H x y h rfl
    · intro H x' y' h' heq
      rw [WeierstrassCurve.Affine.Point.some.injEq] at heq
      obtain ⟨rfl, rfl⟩ := heq
      exact H
  
  have sC1 : ∀ {x y : F} (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y),
      1 ≤ ValuativeRel.valuation F (c ^ 2 * x) →
      ValuativeRel.valuation F (x / y / c) ≤ 1 ∧
      (1 ≤ ValuativeRel.valuation F ((2 * c) ^ 2 * x) ↔
        ValuativeRel.valuation F (x / y / c) ≤ ValuativeRel.valuation F 2) := by
    intro x y h hx
    have s1 := threeRootsCurve_valuation_of_nonsingular t₁ t₂ t₃ ht₁ ht₂ ht₃ h
    obtain ⟨hx1, hz⟩ := (s1.2.2 c hc1).mp hx
    rw [map_div₀ (ValuativeRel.valuation F) (x / y) c]
    refine ⟨?_, ?_⟩
    · rw [div_le_iff₀ hVcpos, one_mul]; exact hz
    · rw [s1.2.2 (2 * c) h2c1, div_le_iff₀ hVcpos, hV2c]
      exact ⟨fun H => H.2, fun H => ⟨hx1, H⟩⟩
  have sC2 : ∀ {x₁ y₁ x₂ y₂ x₃ y₃ : F}
      (h₁ : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x₁ y₁)
      (h₂ : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x₂ y₂)
      (h₃ : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x₃ y₃),
      1 ≤ ValuativeRel.valuation F (c ^ 2 * x₁) → 1 ≤ ValuativeRel.valuation F (c ^ 2 * x₂) →
      WeierstrassCurve.Affine.Point.some h₁ + WeierstrassCurve.Affine.Point.some h₂ =
        WeierstrassCurve.Affine.Point.some h₃ →
      ValuativeRel.valuation F (x₃ / y₃ / c - x₁ / y₁ / c - x₂ / y₂ / c) ≤
        ValuativeRel.valuation F 2 := by
    intro x₁ y₁ x₂ y₂ x₃ y₃ h₁ h₂ h₃ hx₁ hx₂ hadd
    obtain ⟨hx₁', hz₁⟩ := ((threeRootsCurve_valuation_of_nonsingular t₁ t₂ t₃ ht₁ ht₂ ht₃
      h₁).2.2 c hc1).mp hx₁
    obtain ⟨hx₂', hz₂⟩ := ((threeRootsCurve_valuation_of_nonsingular t₁ t₂ t₃ ht₁ ht₂ ht₃
      h₂).2.2 c hc1).mp hx₂
    obtain ⟨-, hest⟩ := threeRootsCurve_add_z_estimate t₁ t₂ t₃ ht₁ ht₂ ht₃ h₁ h₂ h₃ hx₁' hx₂'
      hadd
    have hm : max (ValuativeRel.valuation F (x₁ / y₁)) (ValuativeRel.valuation F (x₂ / y₂)) ≤
        ValuativeRel.valuation F c := max_le hz₁ hz₂
    have hcsq : ValuativeRel.valuation F c ^ 2 ≤ ValuativeRel.valuation F 2 := by
      rw [sq]; exact le_trans (mul_le_of_le_one_left' hc1.le) hc.le
    have e : x₃ / y₃ / c - x₁ / y₁ / c - x₂ / y₂ / c = (x₃ / y₃ - x₁ / y₁ - x₂ / y₂) / c := by
      ring
    rw [e, map_div₀, div_le_iff₀ hVcpos]
    calc ValuativeRel.valuation F (x₃ / y₃ - x₁ / y₁ - x₂ / y₂)
        ≤ max (ValuativeRel.valuation F (x₁ / y₁)) (ValuativeRel.valuation F (x₂ / y₂)) ^ 3 :=
          hest
      _ ≤ ValuativeRel.valuation F c ^ 3 := pow_le_pow_left' hm 3
      _ = ValuativeRel.valuation F c ^ 2 * ValuativeRel.valuation F c := pow_succ _ _
      _ ≤ ValuativeRel.valuation F 2 * ValuativeRel.valuation F c := mul_le_mul_right' hcsq _
  
  obtain ⟨g, hg0, hgs⟩ : ∃ g : (threeRootsCurve t₁ t₂ t₃).toAffine.Point → F,
      g WeierstrassCurve.Affine.Point.zero = 0 ∧
      ∀ {x y : F} (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y),
        g (WeierstrassCurve.Affine.Point.some h) = x / y / c :=
    ⟨fun P => match P with
      | .zero => 0
      | @WeierstrassCurve.Affine.Point.some _ _ _ x y _ => x / y / c, rfl, fun _ => rfl⟩
  have hint : ∀ P ∈ U c, ValuativeRel.valuation F (g P) ≤ 1 := by
    intro P hP
    cases P with
    | zero => rw [hg0, map_zero]; exact zero_le'
    | @some x y h => rw [hgs]; exact (sC1 h ((memU c hc1 h).mp hP)).1
  have hadd : ∀ P ∈ U c, ∀ Q ∈ U c,
      ValuativeRel.valuation F (g (P + Q) - g P - g Q) ≤ ValuativeRel.valuation F 2 := by
    intro P hP Q hQ
    cases P with
    | zero =>
      have e : (WeierstrassCurve.Affine.Point.zero :
          (threeRootsCurve t₁ t₂ t₃).toAffine.Point) + Q = Q := zero_add Q
      rw [e, hg0, sub_zero, sub_self, map_zero]; exact zero_le'
    | @some x₁ y₁ h₁ =>
      cases Q with
      | zero =>
        have e : WeierstrassCurve.Affine.Point.some h₁ + (WeierstrassCurve.Affine.Point.zero :
            (threeRootsCurve t₁ t₂ t₃).toAffine.Point) = WeierstrassCurve.Affine.Point.some h₁ :=
          add_zero _
        rw [e, hg0, sub_zero, sub_self, map_zero]; exact zero_le'
      | @some x₂ y₂ h₂ =>
        have hx₁ := (memU c hc1 h₁).mp hP
        have hx₂ := (memU c hc1 h₂).mp hQ
        generalize hR : WeierstrassCurve.Affine.Point.some h₁ +
          WeierstrassCurve.Affine.Point.some h₂ = R
        cases R with
        | zero =>
          have hneg := eq_neg_of_add_eq_zero_left hR
          rw [WeierstrassCurve.Affine.Point.neg_some,
            WeierstrassCurve.Affine.Point.some.injEq] at hneg
          obtain ⟨hx, hy⟩ := hneg
          have hy' : y₁ = -y₂ := by
            rw [hy]; simp [WeierstrassCurve.Affine.negY, threeRootsCurve]
          rw [hg0, hgs, hgs, hx, hy']
          have e : (0 : F) - x₂ / -y₂ / c - x₂ / y₂ / c = 0 := by
            rw [div_neg, neg_div]; ring
          rw [e, map_zero]; exact zero_le'
        | @some x₃ y₃ h₃ =>
          rw [hgs, hgs, hgs]
          exact sC2 h₁ h₂ h₃ hx₁ hx₂ hR
  have hker : ∀ P ∈ U c, (P ∈ U (2 * c) ↔
      ValuativeRel.valuation F (g P) ≤ ValuativeRel.valuation F 2) := by
    intro P hP
    cases P with
    | zero =>
      rw [hg0, map_zero]
      exact ⟨fun _ => zero_le', fun _ => (U (2 * c)).zero_mem⟩
    | @some x y h =>
      rw [memU (2 * c) h2c1 h, hgs]
      exact (sC1 h ((memU c hc1 h).mp hP)).2
  
  have hsurj : ∀ a : F, ValuativeRel.valuation F a ≤ 1 →
      ∃ P ∈ U c, ValuativeRel.valuation F (g P - a) ≤ ValuativeRel.valuation F 2 := by
    intro a ha
    by_cases ha0 : a = 0
    · refine ⟨0, (U c).zero_mem, ?_⟩
      have e0 : g 0 = 0 := hg0
      rw [e0, ha0, sub_zero, map_zero]; exact zero_le'
    obtain ⟨cc, hccdef⟩ : ∃ cc : F, cc = c * a := ⟨_, rfl⟩
    have hcc0 : cc ≠ 0 := by rw [hccdef]; exact mul_ne_zero hc0 ha0
    have hVcc : ValuativeRel.valuation F cc ≤ ValuativeRel.valuation F c := by
      rw [hccdef, map_mul]; exact mul_le_of_le_one_right' ha
    have hVcc1 : ValuativeRel.valuation F cc ≤ 1 := le_trans hVcc hc1.le
    have hmul1 : ∀ u w : F, ValuativeRel.valuation F u ≤ 1 → ValuativeRel.valuation F w ≤ 1 →
        ValuativeRel.valuation F (u * w) ≤ 1 := fun u w hu hw => by
      rw [map_mul]; exact mul_le_one' hu hw
    have hadd1 : ∀ u w : F, ValuativeRel.valuation F u ≤ 1 → ValuativeRel.valuation F w ≤ 1 →
        ValuativeRel.valuation F (u + w) ≤ 1 := fun u w hu hw => Valuation.map_add_le _ hu hw
    have hneg1 : ∀ u : F, ValuativeRel.valuation F u ≤ 1 → ValuativeRel.valuation F (-u) ≤ 1 :=
      fun u hu => by rwa [Valuation.map_neg]
    have hpow1 : ∀ u : F, ValuativeRel.valuation F u ≤ 1 → ∀ n : ℕ,
        ValuativeRel.valuation F (u ^ n) ≤ 1 := fun u hu n => by
      rw [map_pow]; exact pow_le_one' hu n
    have hB : ValuativeRel.valuation F (-(t₁ + t₂ + t₃) + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) * cc ^ 2 +
        -(t₁ * t₂ * t₃) * cc ^ 4) ≤ 1 :=
      hadd1 _ _ (hadd1 _ _ (hneg1 _ (hadd1 _ _ (hadd1 _ _ ht₁ ht₂) ht₃))
        (hmul1 _ _ (hadd1 _ _ (hadd1 _ _ (hmul1 _ _ ht₁ ht₂) (hmul1 _ _ ht₁ ht₃))
          (hmul1 _ _ ht₂ ht₃)) (hpow1 _ hVcc1 2)))
        (hmul1 _ _ (hneg1 _ (hmul1 _ _ (hmul1 _ _ ht₁ ht₂) ht₃)) (hpow1 _ hVcc1 4))
    obtain ⟨hh, hhdef⟩ : ∃ hh : F, hh = 1 + -(t₁ + t₂ + t₃) * cc ^ 2 +
        (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) * cc ^ 4 + -(t₁ * t₂ * t₃) * cc ^ 6 := ⟨_, rfl⟩
    have hh1 : ValuativeRel.valuation F (hh - 1) < ValuativeRel.valuation F 4 := by
      have e : hh - 1 = cc ^ 2 * (-(t₁ + t₂ + t₃) + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) * cc ^ 2 +
          -(t₁ * t₂ * t₃) * cc ^ 4) := by rw [hhdef]; ring
      rw [e, map_mul, map_pow]
      calc ValuativeRel.valuation F cc ^ 2 * ValuativeRel.valuation F
            (-(t₁ + t₂ + t₃) + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) * cc ^ 2 + -(t₁ * t₂ * t₃) * cc ^ 4)
          ≤ ValuativeRel.valuation F cc ^ 2 * 1 := mul_le_mul_left' hB _
        _ = ValuativeRel.valuation F cc ^ 2 := mul_one _
        _ ≤ ValuativeRel.valuation F c ^ 2 := pow_le_pow_left' hVcc 2
        _ < ValuativeRel.valuation F 2 ^ 2 := pow_lt_pow_left₀ hc zero_le' two_ne_zero
        _ = ValuativeRel.valuation F 4 := by rw [← map_pow]; norm_num
    obtain ⟨s, hs⟩ := hsq hh hh1
    have hVhh : ValuativeRel.valuation F hh = 1 := by
      have := Valuation.map_one_add_of_lt (ValuativeRel.valuation F) (lt_of_lt_of_le hh1 hV4)
      rwa [add_sub_cancel] at this
    have hVs : ValuativeRel.valuation F s = 1 := by
      have hss : ValuativeRel.valuation F s * ValuativeRel.valuation F s = 1 := by
        rw [← map_mul, ← hs, hVhh]
      rcases lt_trichotomy (ValuativeRel.valuation F s) 1 with hlt | heq | hgt
      · exfalso
        have hlt' : ValuativeRel.valuation F s * ValuativeRel.valuation F s < 1 :=
          mul_lt_one_of_lt_of_le hlt hlt.le
        rw [hss] at hlt'; exact lt_irrefl _ hlt'
      · exact heq
      · exfalso
        have hgt' : 1 < ValuativeRel.valuation F s * ValuativeRel.valuation F s :=
          one_lt_mul'' hgt hgt
        rw [hss] at hgt'; exact lt_irrefl _ hgt'
    have hs0 : s ≠ 0 := by
      intro h0; rw [h0, map_zero] at hVs; exact zero_ne_one hVs
    have hs1 : ValuativeRel.valuation F (1 - s) ≤ ValuativeRel.valuation F 2 := by
      by_contra hlt
      push_neg at hlt
      have hsm : ValuativeRel.valuation F (s - 1) = ValuativeRel.valuation F (1 - s) :=
        Valuation.map_sub_swap _ _ _
      have hsp : ValuativeRel.valuation F (s + 1) = ValuativeRel.valuation F (s - 1) := by
        have e : s + 1 = (s - 1) + 2 := by ring
        rw [e]; exact Valuation.map_add_eq_of_lt_left _ (by rw [hsm]; exact hlt)
      have e2 : hh - 1 = (s - 1) * (s + 1) := by rw [hs]; ring
      have hgt : ValuativeRel.valuation F 4 < ValuativeRel.valuation F (hh - 1) := by
        rw [e2, map_mul, hsp, hsm, ← sq]
        calc ValuativeRel.valuation F 4 = ValuativeRel.valuation F 2 ^ 2 := by
              rw [← map_pow]; norm_num
          _ < ValuativeRel.valuation F (1 - s) ^ 2 := pow_lt_pow_left₀ hlt zero_le' two_ne_zero
      exact absurd (lt_trans hgt hh1) (lt_irrefl _)
    obtain ⟨u, hu⟩ : ∃ u : F, cc * u = 1 := ⟨cc⁻¹, mul_inv_cancel₀ hcc0⟩
    have hu0 : u ≠ 0 := by rintro rfl; rw [mul_zero] at hu; exact zero_ne_one hu
    have hy0 : s * u ^ 3 ≠ 0 := mul_ne_zero hs0 (pow_ne_zero 3 hu0)
    rw [hhdef] at hs
    have heqn : (threeRootsCurve t₁ t₂ t₃).toAffine.Equation (u ^ 2) (s * u ^ 3) := by
      rw [WeierstrassCurve.Affine.equation_iff]
      simp only [threeRootsCurve]
      linear_combination (-u ^ 6) * hs + (-(t₁ + t₂ + t₃) * u ^ 4 * (cc * u + 1) +
        (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) * u ^ 2 * ((cc * u) ^ 3 + (cc * u) ^ 2 + cc * u + 1) +
        -(t₁ * t₂ * t₃) * ((cc * u) ^ 5 + (cc * u) ^ 4 + (cc * u) ^ 3 + (cc * u) ^ 2 +
          cc * u + 1)) * hu
    have hns : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular (u ^ 2) (s * u ^ 3) := by
      rw [WeierstrassCurve.Affine.nonsingular_iff]
      refine ⟨heqn, Or.inr ?_⟩
      simp only [threeRootsCurve, zero_mul, sub_zero]
      intro h'
      apply hy0
      have h2y : (2 : F) * (s * u ^ 3) = 0 := by linear_combination h'
      exact (mul_eq_zero.mp h2y).resolve_left h2
    rw [hccdef] at hu
    have hmem : 1 ≤ ValuativeRel.valuation F (c ^ 2 * u ^ 2) := by
      have e : (c ^ 2 * u ^ 2) * a ^ 2 = 1 := by linear_combination (c * a * u + 1) * hu
      have he := congrArg (ValuativeRel.valuation F) e
      rw [map_mul, map_one, map_pow (ValuativeRel.valuation F) a] at he
      calc (1 : ValuativeRel.ValueGroupWithZero F)
          = ValuativeRel.valuation F (c ^ 2 * u ^ 2) * ValuativeRel.valuation F a ^ 2 := he.symm
        _ ≤ ValuativeRel.valuation F (c ^ 2 * u ^ 2) := mul_le_of_le_one_right' (pow_le_one' ha 2)
    refine ⟨WeierstrassCurve.Affine.Point.some hns, (memU c hc1 hns).mpr hmem, ?_⟩
    rw [hgs]
    have e1 : u ^ 2 / (s * u ^ 3) / c = a / s := by
      rw [div_div, div_eq_div_iff (mul_ne_zero hy0 hc0) hs0]
      linear_combination (-(u ^ 2 * s)) * hu
    have hss : s * s⁻¹ = 1 := mul_inv_cancel₀ hs0
    have e2 : a / s - a = a * (1 - s) * s⁻¹ := by linear_combination a * hss
    rw [e1, e2, map_mul, map_mul, map_inv₀, hVs, inv_one, mul_one]
    exact le_trans (mul_le_of_le_one_left' ha) hs1
  
  have memI : ∀ r : ↥(ValuativeRel.valuation F).integer,
      r ∈ Ideal.span {(2 : ↥(ValuativeRel.valuation F).integer)} ↔
        ValuativeRel.valuation F (r : F) ≤ ValuativeRel.valuation F 2 := by
    intro r
    have h2coe : ((2 : ↥(ValuativeRel.valuation F).integer) : F) = 2 := by
      first
        | rfl
        | norm_num
        | exact map_ofNat ((ValuativeRel.valuation F).integer.subtype) 2
    rw [Ideal.mem_span_singleton']
    constructor
    · rintro ⟨b, hb⟩
      have e : (r : F) = (b : F) * 2 := by simp [← hb, h2coe]
      rw [e, map_mul]
      exact mul_le_of_le_one_left' ((Valuation.mem_integer_iff _ _).mp b.2)
    · intro hr
      have hmem : (r : F) / 2 ∈ (ValuativeRel.valuation F).integer := by
        rw [Valuation.mem_integer_iff, map_div₀, div_le_iff₀ hV2pos, one_mul]; exact hr
      refine ⟨⟨(r : F) / 2, hmem⟩, ?_⟩
      apply Subtype.ext
      simp [h2coe, div_mul_cancel₀, h2]
  let f : ↥(U c) → ↥(ValuativeRel.valuation F).integer ⧸
      Ideal.span {(2 : ↥(ValuativeRel.valuation F).integer)} :=
    fun P => Ideal.Quotient.mk _ ⟨g P, (Valuation.mem_integer_iff _ _).mpr (hint P P.2)⟩
  have hf : ∀ P Q, f (P + Q) = f P + f Q := by
    intro P Q
    show Ideal.Quotient.mk _ _ = Ideal.Quotient.mk _ _ + Ideal.Quotient.mk _ _
    rw [← map_add, Ideal.Quotient.eq, memI]
    have := hadd P P.2 Q Q.2
    simpa [sub_sub] using this
  let φ := AddMonoidHom.mk' f hf
  have hφker : φ.ker = (U (2 * c)).addSubgroupOf (U c) := by
    ext P
    rw [AddMonoidHom.mem_ker, AddSubgroup.mem_addSubgroupOf]
    show Ideal.Quotient.mk _ _ = 0 ↔ _
    rw [Ideal.Quotient.eq_zero_iff_mem, memI]
    exact (hker P P.2).symm
  have hφsurj : Function.Surjective φ := by
    intro q
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
    obtain ⟨P, hP, hPr⟩ := hsurj (r : F) ((Valuation.mem_integer_iff _ _).mp r.2)
    refine ⟨⟨P, hP⟩, ?_⟩
    show Ideal.Quotient.mk _ _ = _
    rw [Ideal.Quotient.eq, memI]
    simpa using hPr
  rw [AddSubgroup.relIndex, ← hφker, AddSubgroup.index]
  exact Nat.card_congr (QuotientAddGroup.quotientKerEquivOfSurjective φ hφsurj).toEquiv

theorem threeRootsCurve_filtration_index_ne_zero_of_uniformizer (F : Type*) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F] [DecidableEq F]
    (t₁ t₂ t₃ : F) (ht₁ : ValuativeRel.valuation F t₁ ≤ 1) (ht₂ : ValuativeRel.valuation F t₂ ≤ 1)
    (ht₃ : ValuativeRel.valuation F t₃ ≤ 1) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃)
    (U : F → AddSubgroup (threeRootsCurve t₁ t₂ t₃).toAffine.Point)
    (hU : ∀ c : F, ValuativeRel.valuation F c < 1 → ∀ P, P ∈ U c ↔
      ∀ (x y : F) (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y),
        P = WeierstrassCurve.Affine.Point.some h → 1 ≤ ValuativeRel.valuation F (c ^ 2 * x))
    (ϖ : F) (hϖ0 : ϖ ≠ 0) (hϖ1 : ValuativeRel.valuation F ϖ < 1)
    (hϖ : ∀ b : F, ValuativeRel.valuation F b < 1 →
      ValuativeRel.valuation F b ≤ ValuativeRel.valuation F ϖ) :
    (U ϖ).index ≠ 0 :=
by
  classical
  
  have s2 : ∀ (V : Valuation F (ValuativeRel.ValueGroupWithZero F)) (x : F),
      V t₁ ≤ 1 → V t₂ ≤ 1 → V t₃ ≤ 1 → V x ≤ 1 →
      V ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) ^ 6 ≤ V ((x - t₁) * (x - t₂) * (x - t₃)) ∨
      V ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) ^ 2 ≤
        V (3 * x ^ 2 - 2 * (t₁ + t₂ + t₃) * x + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃)) := by
    intro V x ht₁ ht₂ ht₃ hx
    have hsub : ∀ a b : F, V a ≤ 1 → V b ≤ 1 → V (a - b) ≤ 1 := fun a b ha hb =>
      le_trans (Valuation.map_sub _ _ _) (max_le ha hb)
    have h12 : V (t₁ - t₂) ≤ 1 := hsub _ _ ht₁ ht₂
    have h13 : V (t₁ - t₃) ≤ 1 := hsub _ _ ht₁ ht₃
    have h23 : V (t₂ - t₃) ≤ 1 := hsub _ _ ht₂ ht₃
    obtain ⟨δ, hδ⟩ : ∃ δ, δ = V ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) := ⟨_, rfl⟩
    rw [← hδ]
    have hδ12 : δ ≤ V (t₁ - t₂) := by
      rw [hδ, map_mul, map_mul, mul_assoc]; exact mul_le_of_le_one_right' (mul_le_one' h13 h23)
    have hδ13 : δ ≤ V (t₁ - t₃) := by
      rw [hδ, map_mul, map_mul, mul_comm (V (t₁ - t₂)), mul_assoc]
      exact mul_le_of_le_one_right' (mul_le_one' h12 h23)
    have hδ23 : δ ≤ V (t₂ - t₃) := by
      rw [hδ, map_mul, map_mul]; exact mul_le_of_le_one_left' (mul_le_one' h12 h13)
    have hδ1 : δ ≤ 1 := le_trans hδ12 h12
    have hδ2 : δ ^ 2 ≤ δ := by rw [sq]; exact mul_le_of_le_one_left' hδ1
    have u1 : V (x - t₁) ≤ 1 := hsub _ _ hx ht₁
    have u2 : V (x - t₂) ≤ 1 := hsub _ _ hx ht₂
    have u3 : V (x - t₃) ≤ 1 := hsub _ _ hx ht₃
    have m : ∀ i j : F, δ ≤ V (i - j) → δ ≤ max (V (x - i)) (V (x - j)) := by
      intro i j h
      have e : i - j = (x - j) - (x - i) := by ring
      rw [e] at h
      exact le_trans h (le_trans (Valuation.map_sub _ _ _) (le_of_eq (max_comm _ _)))
    have helper : ∀ p q r : F, V p ≤ 1 → V q ≤ 1 → V r ≤ 1 → V p < δ ^ 2 →
        δ ≤ max (V p) (V q) → δ ≤ max (V p) (V r) → δ ^ 2 ≤ V (q * r + p * (q + r)) := by
      intro p q r hp hq hr hpd hpq hpr
      have hpδ : V p < δ := lt_of_lt_of_le hpd hδ2
      have hq' : δ ≤ V q := by
        rcases le_total (V p) (V q) with h | h
        · rwa [max_eq_right h] at hpq
        · rw [max_eq_left h] at hpq; exact absurd hpq (not_le.mpr hpδ)
      have hr' : δ ≤ V r := by
        rcases le_total (V p) (V r) with h | h
        · rwa [max_eq_right h] at hpr
        · rw [max_eq_left h] at hpr; exact absurd hpr (not_le.mpr hpδ)
      have hqr : δ ^ 2 ≤ V (q * r) := by rw [map_mul, sq]; exact mul_le_mul' hq' hr'
      have hsmall : V (p * (q + r)) < V (q * r) := by
        rw [map_mul]
        calc V p * V (q + r) ≤ V p :=
              mul_le_of_le_one_right' (le_trans (Valuation.map_add _ _ _) (max_le hq hr))
          _ < δ ^ 2 := hpd
          _ ≤ V (q * r) := hqr
      rw [Valuation.map_add_eq_of_lt_left _ hsmall]; exact hqr
    by_cases c1 : V (x - t₁) < δ ^ 2
    · right
      have e : 3 * x ^ 2 - 2 * (t₁ + t₂ + t₃) * x + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) =
          (x - t₂) * (x - t₃) + (x - t₁) * ((x - t₂) + (x - t₃)) := by ring
      rw [e]
      exact helper (x - t₁) (x - t₂) (x - t₃) u1 u2 u3 c1 (m _ _ hδ12) (m _ _ hδ13)
    by_cases c2 : V (x - t₂) < δ ^ 2
    · right
      have e : 3 * x ^ 2 - 2 * (t₁ + t₂ + t₃) * x + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) =
          (x - t₁) * (x - t₃) + (x - t₂) * ((x - t₁) + (x - t₃)) := by ring
      rw [e]
      exact helper (x - t₂) (x - t₁) (x - t₃) u2 u1 u3 c2
        (by rw [max_comm]; exact m _ _ hδ12) (m _ _ hδ23)
    by_cases c3 : V (x - t₃) < δ ^ 2
    · right
      have e : 3 * x ^ 2 - 2 * (t₁ + t₂ + t₃) * x + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) =
          (x - t₁) * (x - t₂) + (x - t₃) * ((x - t₁) + (x - t₂)) := by ring
      rw [e]
      exact helper (x - t₃) (x - t₁) (x - t₂) u3 u1 u2 c3
        (by rw [max_comm]; exact m _ _ hδ13) (by rw [max_comm]; exact m _ _ hδ23)
    left
    push_neg at c1 c2 c3
    rw [map_mul, map_mul, show δ ^ 6 = δ ^ 2 * δ ^ 2 * δ ^ 2 by rw [← pow_add, ← pow_add]]
    exact mul_le_mul' (mul_le_mul' c1 c2) c3
  
  have s3 : ∀ (V : Valuation F (ValuativeRel.ValueGroupWithZero F)) (a x₁ y₁ x₂ y₂ : F),
      V t₁ ≤ 1 → V t₂ ≤ 1 → V t₃ ≤ 1 →
      V a < V 2 * V ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) ^ 3 →
      V x₁ ≤ 1 → V x₂ ≤ 1 →
      y₁ ^ 2 = (x₁ - t₁) * (x₁ - t₂) * (x₁ - t₃) →
      y₂ ^ 2 = (x₂ - t₁) * (x₂ - t₂) * (x₂ - t₃) →
      V (x₁ - x₂) ≤ V a → V (y₁ - y₂) ≤ V a →
      (x₁ ≠ x₂ → 1 < V ((y₁ + y₂) / (x₁ - x₂))) ∧
      (x₁ = x₂ → y₁ ≠ y₂ → 1 < V
        ((3 * x₁ ^ 2 - 2 * (t₁ + t₂ + t₃) * x₁ + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃)) / (2 * y₁))) := by
    intro V a x₁ y₁ x₂ y₂ ht₁ ht₂ ht₃ ha hx₁ hx₂ he₁ he₂ hx hy
    have dich := s2 V x₁ ht₁ ht₂ ht₃ hx₁
    have hsub : ∀ a b : F, V a ≤ 1 → V b ≤ 1 → V (a - b) ≤ 1 := fun a b ha hb =>
      le_trans (Valuation.map_sub _ _ _) (max_le ha hb)
    have hadd : ∀ a b : F, V a ≤ 1 → V b ≤ 1 → V (a + b) ≤ 1 := fun a b ha hb =>
      le_trans (Valuation.map_add _ _ _) (max_le ha hb)
    have h12 : V (t₁ - t₂) ≤ 1 := hsub _ _ ht₁ ht₂
    have h13 : V (t₁ - t₃) ≤ 1 := hsub _ _ ht₁ ht₃
    have h23 : V (t₂ - t₃) ≤ 1 := hsub _ _ ht₂ ht₃
    have hV2 : V 2 ≤ 1 := by
      rw [← one_add_one_eq_two]; exact hadd _ _ (by simp) (by simp)
    obtain ⟨δ, hδ⟩ : ∃ δ, δ = V ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) := ⟨_, rfl⟩
    rw [← hδ] at ha dich
    have hδ1 : δ ≤ 1 := by
      rw [hδ, map_mul, map_mul]; exact mul_le_one' (mul_le_one' h12 h13) h23
    have hA2 : V a < δ ^ 2 := lt_of_lt_of_le ha
      (le_trans (mul_le_of_le_one_left' hV2) (by rw [pow_succ]; exact mul_le_of_le_one_right' hδ1))
    have P2 : ∀ ℓ w u : F, u = ℓ * w → V w < V u → 1 < V ℓ := by
      intro ℓ w u h hlt
      by_contra hle
      push_neg at hle
      rw [h, map_mul] at hlt
      exact absurd hlt (not_lt.mpr (mul_le_of_le_one_left' hle))
    refine ⟨fun hne => ?_, fun heq hne => ?_⟩
    · have he : x₁ - x₂ ≠ 0 := sub_ne_zero.mpr hne
      rcases dich with h6 | h2
      · have hy1 : δ ^ 3 ≤ V y₁ := by
          by_contra hlt
          push_neg at hlt
          have h' : V y₁ ^ 2 < (δ ^ 3) ^ 2 := pow_lt_pow_left₀ hlt zero_le' two_ne_zero
          rw [← map_pow, he₁, ← pow_mul] at h'
          exact absurd h6 (not_le.mpr h')
        have h2y : V a < V (2 * y₁) := by
          rw [map_mul]; exact lt_of_lt_of_le ha (mul_le_mul_left' hy1 _)
        have hsum : V (y₁ + y₂) = V (2 * y₁) := by
          rw [show y₁ + y₂ = 2 * y₁ - (y₁ - y₂) by ring]
          exact Valuation.map_sub_eq_of_lt_left _ (lt_of_le_of_lt hy h2y)
        refine P2 ((y₁ + y₂) / (x₁ - x₂)) (x₁ - x₂) (y₁ + y₂) (div_mul_cancel₀ _ he).symm ?_
        rw [hsum]; exact lt_of_le_of_lt hx h2y
      · obtain ⟨g, hg⟩ : ∃ g : F, g = x₁ ^ 2 + x₁ * x₂ + x₂ ^ 2 - (t₁ + t₂ + t₃) * (x₁ + x₂) +
            (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) := ⟨_, rfl⟩
        have hfg : (y₁ + y₂) * (y₁ - y₂) = (x₁ - x₂) * g := by
          rw [hg]; linear_combination he₁ - he₂
        have hbd : V (x₂ + 2 * x₁ - (t₁ + t₂ + t₃)) ≤ 1 :=
          hsub _ _ (hadd _ _ hx₂ (by rw [map_mul]; exact mul_le_one' hV2 hx₁))
            (hadd _ _ (hadd _ _ ht₁ ht₂) ht₃)
        have hgf : V (g - (3 * x₁ ^ 2 - 2 * (t₁ + t₂ + t₃) * x₁ + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃)))
            ≤ V a := by
          rw [hg, show x₁ ^ 2 + x₁ * x₂ + x₂ ^ 2 - (t₁ + t₂ + t₃) * (x₁ + x₂) +
              (t₁ * t₂ + t₁ * t₃ + t₂ * t₃) -
              (3 * x₁ ^ 2 - 2 * (t₁ + t₂ + t₃) * x₁ + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃)) =
              (x₂ - x₁) * (x₂ + 2 * x₁ - (t₁ + t₂ + t₃)) by ring, map_mul, Valuation.map_sub_swap]
          exact le_trans (mul_le_of_le_one_right' hbd) hx
        have hVg : V g =
            V (3 * x₁ ^ 2 - 2 * (t₁ + t₂ + t₃) * x₁ + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃)) := by
          rw [show g = (3 * x₁ ^ 2 - 2 * (t₁ + t₂ + t₃) * x₁ + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃)) +
            (g - (3 * x₁ ^ 2 - 2 * (t₁ + t₂ + t₃) * x₁ + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃))) by ring]
