        rw [hsplit, AddChar.map_add_eq_mul, hφn (y * ((v : L) - 1)) ?_, mul_one]
        rw [hmul _ _ hy0 (sub_ne_zero.mpr hv1)]
        omega
      | one =>
        intro y _
        rw [Units.val_one, mul_one]
      | mul v₁ v₂ hv₁ hv₂ ih₁ ih₂ =>
        intro y hy
        rw [Units.val_mul, ← mul_assoc, ih₂ (y * (v₁ : L)) (by rw [P2 v₁ hv₁]; exact hy), ih₁ y hy]
      | inv v hv ih =>
        intro y hy
        have hinv := Subgroup.inv_mem _ hv
        have h1 := ih (y * ((v⁻¹ : Lˣ) : L)) (by rw [P2 _ hinv]; exact hy)
        rw [mul_assoc, Units.inv_mul, mul_one] at h1
        exact h1.symm
    
    haveI hN : (EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ')).Normal :=
      Subgroup.normal_of_comm _
    have key : ∀ (f f' : Lˣ → EllipticRootNumber.Ω F),
        (∀ x, ∀ ε ∈ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ'),
          f (x * ε) = f x) →
        (∀ x, f' x = (χ' u : EllipticRootNumber.Ω F) * f (u * x)) →
        ∑ᶠ w : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ'),
            f' (EllipticRootNumber.cosetRep w) =
          (χ' u : EllipticRootNumber.Ω F) *
            ∑ᶠ w : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ'),
              f (EllipticRootNumber.cosetRep w) := by
      intro f f' hf htw
      have R1 : ∀ w : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ'),
          f (EllipticRootNumber.cosetRep
              (((u : Lˣ) : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ')) *
                w)) =
            f (u * EllipticRootNumber.cosetRep w) := by
        intro w
        have h1 : ((u * EllipticRootNumber.cosetRep w : Lˣ) :
              Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ')) =
            ((EllipticRootNumber.cosetRep
              (((u : Lˣ) : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ')) *
                w) : Lˣ) :
              Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ')) := by
          rw [QuotientGroup.mk_mul]
          unfold EllipticRootNumber.cosetRep
          rw [QuotientGroup.out_eq', QuotientGroup.out_eq']
        rw [QuotientGroup.eq] at h1
        have h2 := hf (u * EllipticRootNumber.cosetRep w) _ h1
        rw [mul_inv_cancel_left] at h2
        exact h2
      calc ∑ᶠ w : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ'),
            f' (EllipticRootNumber.cosetRep w)
          = ∑ᶠ w : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ'),
            (χ' u : EllipticRootNumber.Ω F) * f (EllipticRootNumber.cosetRep
              (((u : Lˣ) : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ')) *
                w)) :=
            finsum_congr (fun w => by rw [htw, R1])
        _ = (χ' u : EllipticRootNumber.Ω F) *
            ∑ᶠ w : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ'),
            f (EllipticRootNumber.cosetRep
              (((u : Lˣ) : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ')) *
                w)) :=
            (mul_finsum _ _).symm
        _ = (χ' u : EllipticRootNumber.Ω F) *
            ∑ᶠ w : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ'),
            f (EllipticRootNumber.cosetRep w) := by
          congr 1
          exact finsum_comp_equiv (Equiv.mulLeft
            ((u : Lˣ) : Lˣ ⧸ EllipticRootNumber.unitGroup F L (EllipticRootNumber.condExp F L χ')))
            (f := fun w => f (EllipticRootNumber.cosetRep w))
    
    generalize hcdef : EllipticRootNumber.tateElt F L χ' φ = c at hvc ⊢
    simp only [finsum_eq_if]
    have e : ∀ (A S' S z : EllipticRootNumber.Ω F), S' = z * S → A * S' = z * (A * S) := by
      intro A S' S z h
      rw [h]
      ring
    refine e _ _ _ _ ?_
    refine key
      (fun x => if EllipticRootNumber.valL F L (x : L) = 0
        then (χ' (c⁻¹ * x) : EllipticRootNumber.Ω F)⁻¹ * φ ((c⁻¹ * x : Lˣ) : L)
        else 0)
      (fun x => if EllipticRootNumber.valL F L (x : L) = 0
        then (χ' (c⁻¹ * x) : EllipticRootNumber.Ω F)⁻¹ *
          (φ.compAddMonoidHom (AddMonoidHom.mulLeft (u : L))) ((c⁻¹ * x : Lˣ) : L)
        else 0) ?_ ?_
    · 
      intro x ε hε
      have hvxe : EllipticRootNumber.valL F L ((x * ε : Lˣ) : L) =
          EllipticRootNumber.valL F L (x : L) := by
        rw [V3, hU0 ε hε, add_zero]
      beta_reduce
      rw [hvxe]
      split_ifs with hx
      · have e1 : c⁻¹ * (x * ε) = (c⁻¹ * x) * ε := (mul_assoc _ _ _).symm
        rw [e1, map_mul χ' (c⁻¹ * x) ε, hKer ε hε, mul_one, Units.val_mul (c⁻¹ * x) ε]
        congr 1
        apply hs4 ε hε
        rw [V3, V4, hvc, hx]
        omega
      · rfl
    · 
      intro x
      have hvbx : EllipticRootNumber.valL F L ((u * x : Lˣ) : L) =
          EllipticRootNumber.valL F L (x : L) := by
        rw [V3, hu, zero_add]
      beta_reduce
      rw [hvbx]
      split_ifs with hx
      · have h2 : c⁻¹ * (u * x) = u * (c⁻¹ * x) := mul_left_comm _ _ _
        have e1 : ((c⁻¹ * (u * x) : Lˣ) : L) = (u : L) * ((c⁻¹ * x : Lˣ) : L) := by
          rw [h2, Units.val_mul]
        have e2 : (χ' (c⁻¹ * (u * x)) : EllipticRootNumber.Ω F) =
            (χ' u : EllipticRootNumber.Ω F) * (χ' (c⁻¹ * x) : EllipticRootNumber.Ω F) := by
          rw [h2, map_mul, Units.val_mul]
        have hne : (χ' u : EllipticRootNumber.Ω F) ≠ 0 := Units.ne_zero _
        rw [hφu_apply, e1, e2, mul_inv, ← mul_assoc, ← mul_assoc, mul_inv_cancel₀ hne, one_mul]
      · rw [mul_zero]

theorem eps_traceChar_unit_twist (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    {rec : EllipticRootNumber.LocalReciprocity F} (lc : EllipticRootNumber.LocalConstants F rec)
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (θ : EllipticRootNumber.relWeil F M →* (EllipticRootNumber.Ω F)ˣ)
    (hθ : EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M θ))
    (ψ ψ' : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F))
    (hψ : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1)
    (b : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ)
    (hb : EllipticRootNumber.valL F ⊥ (b : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0)
    (hbψ : ∀ y, ψ' y = ψ (b * y)) :
    (lc.eps M (EllipticRootNumber.charRep F M θ) (EllipticRootNumber.traceChar F bot_le ψ') :
        EllipticRootNumber.Ω F) =
      (θ (rec.recMap M (Units.map ((IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) :
          (⊥ : IntermediateField F (AlgebraicClosure F)) →* M) b)) : EllipticRootNumber.Ω F) *
        lc.eps M (EllipticRootNumber.charRep F M θ) (EllipticRootNumber.traceChar F bot_le ψ) :=
by
  classical
  obtain ⟨w, hw1, hw2⟩ := exists_galoisInvariant_valuation_algebraicClosure F
  
  have key : ∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (x : L),
      x ≠ 0 →
      ((w (x : AlgebraicClosure F) ≤ 1 ↔ 0 ≤ EllipticRootNumber.valL F L x) ∧
        (w (x : AlgebraicClosure F) = 1 ↔ EllipticRootNumber.valL F L x = 0)) := by
    intro L _ x hx
    obtain ⟨hres, hrel, -, -, -, hW⟩ := valL_spec F L
    obtain ⟨r, hr0, hr1, hr⟩ := hW w hw1 hw2
    have hn : Module.finrank F L ≠ 0 := Module.finrank_pos.ne'
    have h1 := hr x hx
    have h2 := hrel x hx
    have hres' : (0 : ℤ) < (EllipticRootNumber.resDeg F L : ℤ) := by exact_mod_cast hres
    constructor
    · rw [← pow_le_one_iff_of_nonneg (zero_le _) hn, h1,
        zpow_le_one_iff_right_of_lt_one₀ hr0 hr1, h2]
      exact mul_nonneg_iff_of_pos_left hres'
    · rw [← pow_eq_one_iff_of_nonneg (zero_le _) hn, h1, h2]
      constructor
      · intro h
        have h' : r ^ ((EllipticRootNumber.resDeg F L : ℤ) * EllipticRootNumber.valL F L x) =
            r ^ (0 : ℤ) := by rw [h, zpow_zero]
        have h'' := zpow_right_injective₀ hr0 hr1.ne h'
        rcases mul_eq_zero.mp h'' with h3 | h3
        · omega
        · exact h3
      · intro h
        rw [h, mul_zero, zpow_zero]
  
  have hbne : (b : (⊥ : IntermediateField F (AlgebraicClosure F))) ≠ 0 := b.ne_zero
  have hwb : w (((b : (⊥ : IntermediateField F (AlgebraicClosure F))) : AlgebraicClosure F)) = 1 :=
    ((key ⊥ _ hbne).2).mpr hb
  set bM : Mˣ := Units.map ((IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) :
          (⊥ : IntermediateField F (AlgebraicClosure F)) →* M) b with hbM_def
  have hbMinc : (bM : M) = IntermediateField.inclusion
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
      (b : (⊥ : IntermediateField F (AlgebraicClosure F))) := rfl
