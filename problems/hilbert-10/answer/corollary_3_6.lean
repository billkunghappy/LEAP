      rw [hm1] at h2
      exact absurd (lt_of_lt_of_le hx h2) (lt_irrefl 1)
    have hmϖ : m ≤ ValuativeRel.valuation F ϖ := by
      rw [hm]; exact hϖ _ (by rw [← hm]; exact hmlt)
    rw [map_mul, map_pow, ← hm1]
    exact mul_le_mul' (pow_le_pow_left₀ zero_le' hmϖ 2) le_rfl
  
  have h2 : (2 : F) ≠ 0 := two_ne_zero
  have hD0 : (t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃) ≠ 0 :=
    mul_ne_zero (mul_ne_zero (sub_ne_zero.mpr h₁₂) (sub_ne_zero.mpr h₁₃)) (sub_ne_zero.mpr h₂₃)
  have hV2 : ValuativeRel.valuation F 2 ≤ 1 := by
    rw [← one_add_one_eq_two]
    exact Valuation.map_add_le _ (map_one _).le (map_one _).le
  have hsubV : ∀ a b : F, ValuativeRel.valuation F a ≤ 1 → ValuativeRel.valuation F b ≤ 1 →
