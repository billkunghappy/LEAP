theorem corollary_3_6 {K : Type u} [Field K] [NumberField K]
    (e₁ e₂ e₃ : K) (h₁₂ : e₁ ≠ e₂) (h₁₃ : e₁ ≠ e₃) (h₂₃ : e₂ ≠ e₃) :
    ∃ d : ℕ, (twoSelmerSet K e₁ e₂ e₃).encard = 2 ^ d ∧
      (-1 : ℤˣ) ^ d = globalRootNumber (threeRootsCurve e₁ e₂ e₃) :=
by
  
  have bc : ∀ {A B : Type u} [Field A] [Field B] [Algebra A B] (a₁ a₂ a₃ : A),
      (threeRootsCurve a₁ a₂ a₃).baseChange B =
        threeRootsCurve (algebraMap A B a₁) (algebraMap A B a₂) (algebraMap A B a₃) := by
    intro A B _ _ _ a₁ a₂ a₃
    ext <;> simp [threeRootsCurve, WeierstrassCurve.baseChange, WeierstrassCurve.map]
  
  have val2_le : ∀ {L : Type u} [Field L] [NumberField L]
      (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L)),
      IsDedekindDomain.HeightOneSpectrum.valuation L v 2 ≤ 1 := by
    intro L _ _ v
    have h := v.valuation_le_one (K := L) (2 : NumberField.RingOfIntegers L)
    simpa using h
  
  have s3 : ∀ {L : Type u} [Field L] [NumberField L] (a₁ a₂ a₃ : L), a₁ ≠ a₂ → a₁ ≠ a₃ →
      (Function.mulSupport fun v : IsDedekindDomain.HeightOneSpectrum
          (NumberField.RingOfIntegers L) =>
          hilbTerm (v.adicCompletion L) (algebraMap L _ a₁) (algebraMap L _ a₂)
            (algebraMap L _ a₃)).Finite ∧
      (∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L),
          hilbTerm (v.adicCompletion L) (algebraMap L _ a₁) (algebraMap L _ a₂)
            (algebraMap L _ a₃)) *
        ∏ w : NumberField.InfinitePlace L,
          hilbTerm w.Completion (algebraMap L _ a₁) (algebraMap L _ a₂) (algebraMap L _ a₃) = 1 := by
    intro L _ _ a₁ a₂ a₃ h12 h13
    by_cases ha : 2 * a₁ - a₂ - a₃ = 0
    · have hv : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L),
          hilbTerm (v.adicCompletion L) (algebraMap L _ a₁) (algebraMap L _ a₂)
            (algebraMap L _ a₃) = 1 := by
        intro v
        have h0 : (2 : v.adicCompletion L) * algebraMap L _ a₁ - algebraMap L _ a₂ -
            algebraMap L _ a₃ = 0 := by
          rw [← map_ofNat (algebraMap L (v.adicCompletion L)) 2, ← map_mul, ← map_sub, ← map_sub,
            ha, map_zero]
        unfold hilbTerm
        rw [if_pos h0]
      have hw : ∀ w : NumberField.InfinitePlace L,
          hilbTerm w.Completion (algebraMap L _ a₁) (algebraMap L _ a₂) (algebraMap L _ a₃) = 1 := by
        intro w
        have h0 : (2 : w.Completion) * algebraMap L _ a₁ - algebraMap L _ a₂ -
            algebraMap L _ a₃ = 0 := by
          rw [← map_ofNat (algebraMap L w.Completion) 2, ← map_mul, ← map_sub, ← map_sub,
            ha, map_zero]
        unfold hilbTerm
        rw [if_pos h0]
      simp [hv, hw]
    · have hb : -((a₁ - a₂) * (a₁ - a₃)) ≠ 0 :=
        neg_ne_zero.mpr (mul_ne_zero (sub_ne_zero.mpr h12) (sub_ne_zero.mpr h13))
      have hv : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L),
          hilbTerm (v.adicCompletion L) (algebraMap L _ a₁) (algebraMap L _ a₂)
            (algebraMap L _ a₃) = hilbFin v (2 * a₁ - a₂ - a₃) (-((a₁ - a₂) * (a₁ - a₃))) := by
        intro v
        have e1 : (2 : v.adicCompletion L) * algebraMap L _ a₁ - algebraMap L _ a₂ -
            algebraMap L _ a₃ = algebraMap L (v.adicCompletion L) (2 * a₁ - a₂ - a₃) := by
          simp only [map_sub, map_mul, map_ofNat]
        have e2 : -((algebraMap L (v.adicCompletion L) a₁ - algebraMap L _ a₂) *
            (algebraMap L (v.adicCompletion L) a₁ - algebraMap L _ a₃)) =
            algebraMap L (v.adicCompletion L) (-((a₁ - a₂) * (a₁ - a₃))) := by
          simp only [map_neg, map_sub, map_mul]
        have hne : algebraMap L (v.adicCompletion L) (2 * a₁ - a₂ - a₃) ≠ 0 := by
          rw [ne_eq, map_eq_zero]; exact ha
        unfold hilbTerm hilbFin hilbLoc hilbSym
        rw [e1, e2, if_neg hne]
      have hw : ∀ w : NumberField.InfinitePlace L,
          hilbTerm w.Completion (algebraMap L _ a₁) (algebraMap L _ a₂) (algebraMap L _ a₃) =
            hilbInf w (2 * a₁ - a₂ - a₃) (-((a₁ - a₂) * (a₁ - a₃))) := by
        intro w
        have e1 : (2 : w.Completion) * algebraMap L _ a₁ - algebraMap L _ a₂ -
            algebraMap L _ a₃ = algebraMap L w.Completion (2 * a₁ - a₂ - a₃) := by
