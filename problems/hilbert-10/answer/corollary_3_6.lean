theorem rootNumber_threeRootsCurve_locallyConstant {K : Type u} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (t₁ t₂ t₃ : v.adicCompletion K) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃) :
    ∀ᶠ s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K in nhds (t₁, t₂, t₃),
      rootNumber (threeRootsCurve s.1 s.2.1 s.2.2) = rootNumber (threeRootsCurve t₁ t₂ t₃) :=
by
  classical
  
  have hraw : ∀ E : WeierstrassCurve (v.adicCompletion K),
      ∃ C : WeierstrassCurve.VariableChange (v.adicCompletion K),
        rootNumber E = rootNumberRaw (C • E) := by
    intro E
    have h1 := @Quotient.mk_out _ (MulAction.orbitRel
      (WeierstrassCurve.VariableChange (v.adicCompletion K)) (WeierstrassCurve (v.adicCompletion K))) E
    have h2 : Quotient.out (Quotient.mk (MulAction.orbitRel
        (WeierstrassCurve.VariableChange (v.adicCompletion K)) (WeierstrassCurve (v.adicCompletion K))) E) ∈
        MulAction.orbit (WeierstrassCurve.VariableChange (v.adicCompletion K)) E := h1
    obtain ⟨C, hC⟩ := MulAction.mem_orbit_iff.mp h2
    exact ⟨C, by rw [hC]; rfl⟩
  suffices H : ∀ᶠ s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K in
      nhds (t₁, t₂, t₃), ∀ C₁ C₂ : WeierstrassCurve.VariableChange (v.adicCompletion K),
        rootNumberRaw (C₁ • threeRootsCurve s.1 s.2.1 s.2.2) =
          rootNumberRaw (C₂ • threeRootsCurve t₁ t₂ t₃) by
    filter_upwards [H] with s hs
    obtain ⟨C₁, h1⟩ := hraw (threeRootsCurve s.1 s.2.1 s.2.2)
    obtain ⟨C₂, h2⟩ := hraw (threeRootsCurve t₁ t₂ t₃)
    rw [h1, h2]
    exact hs C₁ C₂
  
  by_cases hA : Nonempty (v.adicCompletion K ≃+* ℝ) ∨ Nonempty (v.adicCompletion K ≃+* ℂ)
  · exact Filter.Eventually.of_forall fun s C₁ C₂ => by
      rw [rootNumberRaw_of_archimedean _ hA, rootNumberRaw_of_archimedean _ hA]
  by_cases hB : Nonempty (EllipticRootNumber.LocalFieldStructure (v.adicCompletion K))
  swap
  · exact Filter.Eventually.of_forall fun s C₁ C₂ => by
      unfold rootNumberRaw
      rw [if_neg hA, if_neg hA, dif_neg hB, dif_neg hB]
  obtain ⟨S, hR⟩ : ∃ S : EllipticRootNumber.LocalFieldStructure (v.adicCompletion K),
      ∀ E : WeierstrassCurve (v.adicCompletion K),
        rootNumberRaw E =
          @EllipticRootNumber.rootNumberNonarch (v.adicCompletion K) _ S.rel S.top S.isLocalField E :=
    ⟨Classical.choice hB, fun E => by unfold rootNumberRaw; rw [if_neg hA, dif_pos hB]⟩
  have hS := localFieldStructure_adicCompletion_eq v S
  obtain ⟨rel, top, isLF⟩ := S
  obtain ⟨hval, htop⟩ := hS
  dsimp only at hval htop hR
  subst htop
  haveI : CharZero (v.adicCompletion K) :=
    charZero_of_injective_algebraMap (algebraMap K (v.adicCompletion K)).injective
  have hC : EllipticRootNumber.HasLocalConstants (v.adicCompletion K) :=
    ⟨EllipticRootNumber.localReciprocity (v.adicCompletion K),
      ⟨EllipticRootNumber.localConstants (v.adicCompletion K)⟩⟩
  suffices H2 : ∀ {rec : EllipticRootNumber.LocalReciprocity (v.adicCompletion K)}
      (lc : EllipticRootNumber.LocalConstants (v.adicCompletion K) rec),
      ∀ᶠ s : v.adicCompletion K × v.adicCompletion K × v.adicCompletion K in nhds (t₁, t₂, t₃),
        ∀ C₁ C₂ : WeierstrassCurve.VariableChange (v.adicCompletion K),
          EllipticRootNumber.localEps (v.adicCompletion K) (C₁ • threeRootsCurve s.1 s.2.1 s.2.2) lc =
            EllipticRootNumber.localEps (v.adicCompletion K) (C₂ • threeRootsCurve t₁ t₂ t₃) lc by
    filter_upwards [H2 (EllipticRootNumber.localConstants (v.adicCompletion K))] with s hs C₁ C₂
    rw [hR, hR, EllipticRootNumber.rootNumberNonarch_of_hasLocalConstants _ _ hC,
      EllipticRootNumber.rootNumberNonarch_of_hasLocalConstants _ _ hC, hs C₁ C₂]
  intro rec lc
  
  have hPGvc : ∀ (C : WeierstrassCurve.VariableChange (v.adicCompletion K))
      (E : WeierstrassCurve (v.adicCompletion K)),
