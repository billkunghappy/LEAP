    let τ : EllipticRootNumber.AbsGal F :=
      AlgEquiv.ofBijective τ₀ (Algebra.IsAlgebraic.algHom_bijective τ₀)
    have hτ : w (σ (EllipticRootNumber.toExtendScalars F bot_le y)) = w (y : AlgebraicClosure F) := by
      rw [← hτ₀]
      exact hw2 τ (y : AlgebraicClosure F)
    rw [hτ]
    exact hy
  
  have hsurj : Function.Surjective (EllipticRootNumber.traceLM F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) := by
    intro x
    have hn : ((Module.finrank (⊥ : IntermediateField F (AlgebraicClosure F))
        (IntermediateField.extendScalars
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) : ℕ) :
          (⊥ : IntermediateField F (AlgebraicClosure F))) ≠ 0 :=
      Nat.cast_ne_zero.mpr Module.finrank_pos.ne'
    refine ⟨IntermediateField.inclusion bot_le
      (((Module.finrank (⊥ : IntermediateField F (AlgebraicClosure F))
        (IntermediateField.extendScalars
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) : ℕ) :
          (⊥ : IntermediateField F (AlgebraicClosure F)))⁻¹ * x), ?_⟩
    show Algebra.trace (⊥ : IntermediateField F (AlgebraicClosure F))
      (IntermediateField.extendScalars
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))
      (EllipticRootNumber.toExtendScalars F bot_le (IntermediateField.inclusion bot_le _)) = x
    rw [show EllipticRootNumber.toExtendScalars F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
        (IntermediateField.inclusion bot_le
          (((Module.finrank (⊥ : IntermediateField F (AlgebraicClosure F))
            (IntermediateField.extendScalars
              (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) : ℕ) :
              (⊥ : IntermediateField F (AlgebraicClosure F)))⁻¹ * x)) =
        algebraMap (⊥ : IntermediateField F (AlgebraicClosure F))
          (IntermediateField.extendScalars
            (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))
          (((Module.finrank (⊥ : IntermediateField F (AlgebraicClosure F))
            (IntermediateField.extendScalars
              (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) : ℕ) :
              (⊥ : IntermediateField F (AlgebraicClosure F)))⁻¹ * x) from rfl,
      Algebra.trace_algebraMap, nsmul_eq_mul, ← mul_assoc, mul_inv_cancel₀ hn, one_mul]
  
  have hlin : ∀ (c : (⊥ : IntermediateField F (AlgebraicClosure F))) (y : M),
      EllipticRootNumber.traceLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
        (IntermediateField.inclusion bot_le c * y) =
      c * EllipticRootNumber.traceLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) y := by
    intro c y
    have h1 : EllipticRootNumber.toExtendScalars F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
        (IntermediateField.inclusion bot_le c * y) =
        c • EllipticRootNumber.toExtendScalars F bot_le y := rfl
    show Algebra.trace (⊥ : IntermediateField F (AlgebraicClosure F))
      (IntermediateField.extendScalars
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))
      (EllipticRootNumber.toExtendScalars F bot_le (IntermediateField.inclusion bot_le c * y)) =
      c * Algebra.trace (⊥ : IntermediateField F (AlgebraicClosure F))
      (IntermediateField.extendScalars
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))
      (EllipticRootNumber.toExtendScalars F bot_le y)
    rw [h1]
    exact LinearMap.map_smul (Algebra.trace (⊥ : IntermediateField F (AlgebraicClosure F))
      (IntermediateField.extendScalars
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))) c
      (EllipticRootNumber.toExtendScalars F bot_le y)
  
  have hφw : ∀ y : M, w (y : AlgebraicClosure F) ≤ 1 →
      EllipticRootNumber.traceChar F bot_le ψ y = 1 := fun y hy => hint _ (hTr y hy)
  have hφ : EllipticRootNumber.IsAdmissibleChar F M (EllipticRootNumber.traceChar F bot_le ψ) := by
    refine ⟨?_, 0, fun y hy => hφw y (hM y hy)⟩
    intro h1
    obtain ⟨x₁, -, hx₁⟩ := hψ.2
    obtain ⟨y, hy⟩ := hsurj x₁
    apply hx₁
    have h2 := congrArg (fun χ : AddChar M (EllipticRootNumber.Ω F) => χ y) h1
    simp only [AddChar.one_apply] at h2
    rw [← hy]
    exact h2
  
  have hφφ' : EllipticRootNumber.traceChar F bot_le ψ' =
      (EllipticRootNumber.traceChar F bot_le ψ).compAddMonoidHom
        (AddMonoidHom.mulLeft (bM : M)) := by
    ext y
    show ψ' (EllipticRootNumber.traceLM F bot_le y) =
      ψ (EllipticRootNumber.traceLM F bot_le ((bM : M) * y))
    rw [hbψ, hbMinc, hlin]
  have hφ' : EllipticRootNumber.IsAdmissibleChar F M
      (EllipticRootNumber.traceChar F bot_le ψ') := by
    rw [hφφ']
    refine ⟨?_, 0, fun y hy => ?_⟩
    · intro h1
      obtain ⟨y₀, hy₀⟩ : ∃ y₀, EllipticRootNumber.traceChar F bot_le ψ y₀ ≠ 1 := by
        by_contra hcon
        push_neg at hcon
        exact hφ.1 (by ext y; rw [hcon y, AddChar.one_apply])
      apply hy₀
      have h2 := congrArg (fun χ : AddChar M (EllipticRootNumber.Ω F) => χ ((bM : M)⁻¹ * y₀)) h1
      simp only [AddChar.one_apply, AddChar.compAddMonoidHom_apply,
        AddMonoidHom.coe_mulLeft] at h2
      rwa [mul_inv_cancel_left₀ hbMne] at h2
    · show EllipticRootNumber.traceChar F bot_le ψ ((bM : M) * y) = 1
      apply hφw
      have hc : (((bM : M) * y : M) : AlgebraicClosure F) =
          ((bM : M) : AlgebraicClosure F) * (y : AlgebraicClosure F) := rfl
      rw [hc, map_mul, hwbM, one_mul]
      exact hM y hy
  
  let θ' : Mˣ →* (EllipticRootNumber.Ω F)ˣ :=
    MonoidHom.mk' (fun x => θ (rec.recMap M x)) (weilChar_recMap_mul F rec M θ hθ)
  have hθ' : ∀ x : Mˣ, θ' x = θ (rec.recMap M x) := fun x => rfl
  have hcont := charRec_trivial_on_unitGroup F rec M θ hθ θ' hθ'
  have c1 := lc.eps_char M (EllipticRootNumber.traceChar F bot_le ψ) hφ θ hθ θ' hθ'
  have c2 := lc.eps_char M (EllipticRootNumber.traceChar F bot_le ψ') hφ' θ hθ θ' hθ'
  have t := tateEps_unit_twist F M θ' hcont (EllipticRootNumber.traceChar F bot_le ψ) hφ bM hvbM
  rw [c2, hφφ', t, c1, hθ']

theorem finiteIndex_relWeil_subgroupOf (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] :
    ((EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥)).FiniteIndex :=
by
  classical
  
  have s1 : ∀ α : AlgebraicClosure F,
      (MulAction.stabilizer (AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) α).FiniteIndex := by
    intro α
    have hint : IsIntegral F α := Algebra.IsIntegral.isIntegral α
    have hp : minpoly F α ≠ 0 := minpoly.ne_zero hint
    have hsub : MulAction.orbit (AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) α ⊆
        (minpoly F α).rootSet (AlgebraicClosure F) := by
      intro β hβ
      obtain ⟨σ, rfl⟩ := MulAction.mem_orbit_iff.mp hβ
      rw [Polynomial.mem_rootSet_of_ne hp, AlgEquiv.smul_def, Polynomial.aeval_algEquiv,
        AlgHom.comp_apply, minpoly.aeval, map_zero]
    have hfin : (MulAction.orbit (AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) α).Finite :=
      (Polynomial.rootSet_finite _ _).subset hsub
    refine ⟨?_⟩
    rw [MulAction.index_stabilizer]
    exact Set.ncard_ne_zero_of_mem (MulAction.mem_orbit_self α) hfin
  
  let b := Module.finBasis F M
  have s2 : (⨅ i, MulAction.stabilizer (AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F)
      ((b i : M) : AlgebraicClosure F)) ≤ M.fixingSubgroup := by
    intro σ hσ
    rw [Subgroup.mem_iInf] at hσ
    have hfix : ∀ i, σ ((b i : M) : AlgebraicClosure F) = ((b i : M) : AlgebraicClosure F) :=
      fun i => hσ i
    have hlin : σ.toLinearMap ∘ₗ M.val.toLinearMap = M.val.toLinearMap :=
      b.ext (fun i => by simpa using hfix i)
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    have := LinearMap.congr_fun hlin ⟨x, hx⟩
    simpa using this
  
  haveI : (⨅ i, MulAction.stabilizer (AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F)
      ((b i : M) : AlgebraicClosure F)).FiniteIndex :=
    Subgroup.finiteIndex_iInf (fun i => s1 _)
  haveI hGM : M.fixingSubgroup.FiniteIndex := Subgroup.finiteIndex_of_le s2
  
  haveI : (M.fixingSubgroup.subgroupOf (EllipticRootNumber.relWeil F ⊥)).FiniteIndex :=
    inferInstance
  refine Subgroup.finiteIndex_of_le (H := M.fixingSubgroup.subgroupOf
    (EllipticRootNumber.relWeil F ⊥)) ?_
  intro w hw
  rw [Subgroup.mem_subgroupOf] at hw ⊢
  exact Subgroup.mem_inf.mpr ⟨(Subgroup.mem_inf.mp w.2).1, hw⟩

theorem exists_prime_galois_substep (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (E X N : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F N]
    (hEX : E ≤ X) (hXN : X ≤ N)
    (hstab : ∀ (σ : EllipticRootNumber.AbsGal F) (y : AlgebraicClosure F), y ∈ N ↔ σ y ∈ N)
    (ℓ : ℕ) (hℓ : ℓ.Prime) (k : ℕ)
    (hk : (N.fixingSubgroup.subgroupOf E.fixingSubgroup).index = ℓ ^ k)
    (hne : X ≠ E) :
    ∃ (X₁ : IntermediateField F (AlgebraicClosure F)) (h₁ : E ≤ X₁) (h₂ : X₁ ≤ X),
      EllipticRootNumber.IsAbelianExt F h₂ ∧
      Module.finrank X₁ (IntermediateField.extendScalars h₂) = ℓ ∧
      Module.finrank F X₁ < Module.finrank F X :=
by
  classical
  
  have pg : ∀ {P : Type u} [Group P] (Q R : Subgroup P), Q ≤ R → Nat.card R = ℓ ^ k → Q ≠ R →
      ∃ K : Subgroup P, Q ≤ K ∧ K ≤ R ∧ Q.relIndex K = ℓ ∧
        (∀ x ∈ K, ∀ y ∈ Q, x * y * x⁻¹ ∈ Q) ∧ (∀ x ∈ K, ∀ y ∈ K, x * y * x⁻¹ * y⁻¹ ∈ Q) := by
    intro P _ Q R hQR hR hQne
    haveI : Fact ℓ.Prime := ⟨hℓ⟩
    haveI : Finite R := Nat.finite_of_card_ne_zero (by rw [hR]; exact pow_ne_zero _ hℓ.ne_zero)
    have hcardQ' : Nat.card (Q.subgroupOf R) = Nat.card Q :=
      Nat.card_congr (Subgroup.subgroupOfEquivOfLe hQR).toEquiv
    have hdvd : Nat.card Q ∣ ℓ ^ k := hR ▸ Subgroup.card_dvd_of_le hQR
    obtain ⟨n, hnk, hn⟩ := (Nat.dvd_prime_pow hℓ).mp hdvd
    have hnlt : n < k := by
      rcases lt_or_eq_of_le hnk with h | h
      · exact h
      · exfalso
        apply hQne
        have htop : Q.subgroupOf R = ⊤ := by
          apply (Subgroup.card_eq_iff_eq_top (Q.subgroupOf R)).mp
          rw [hcardQ', hn, h, hR]
        exact le_antisymm hQR (Subgroup.subgroupOf_eq_top.mp htop)
    obtain ⟨K', hK'card, hQK'⟩ := Sylow.exists_subgroup_card_pow_succ (G := R) (H := Q.subgroupOf R)
      (by rw [hR]; exact pow_dvd_pow ℓ hnlt) (by rw [hcardQ', hn])
    have hcardQ'' : Nat.card ((Q.subgroupOf R).subgroupOf K') = ℓ ^ n := by
      rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hQK').toEquiv, hcardQ', hn]
    have hidxQ'' : ((Q.subgroupOf R).subgroupOf K').index = ℓ := by
      have h := Subgroup.card_mul_index ((Q.subgroupOf R).subgroupOf K')
      rw [hcardQ'', hK'card, pow_succ] at h
      exact Nat.eq_of_mul_eq_mul_left (pow_pos hℓ.pos n) h
    have hnormal : ((Q.subgroupOf R).subgroupOf K').Normal := by
      apply Subgroup.normal_of_index_eq_minFac_card
      rw [hidxQ'', hK'card, Nat.Prime.pow_minFac hℓ (Nat.succ_ne_zero n)]
    have hcomm' : ∀ a b : K', a * b * a⁻¹ * b⁻¹ ∈ (Q.subgroupOf R).subgroupOf K' := by
      intro a b
      have hp : (Nat.card (K' ⧸ (Q.subgroupOf R).subgroupOf K')).Prime := by
        rw [← Subgroup.index, hidxQ'']; exact hℓ
      haveI : Fact (Nat.card (K' ⧸ (Q.subgroupOf R).subgroupOf K')).Prime := ⟨hp⟩
      haveI := isCyclic_of_prime_card (α := K' ⧸ (Q.subgroupOf R).subgroupOf K') rfl
      letI := IsCyclic.commGroup (α := K' ⧸ (Q.subgroupOf R).subgroupOf K')
      rw [← QuotientGroup.eq_one_iff]
      simp only [QuotientGroup.mk_mul, QuotientGroup.mk_inv]
      have hc : ((a : K' ⧸ (Q.subgroupOf R).subgroupOf K')) * (b : K' ⧸ _) =
          (b : K' ⧸ (Q.subgroupOf R).subgroupOf K') * (a : K' ⧸ _) := mul_comm _ _
      rw [hc]
      group
    refine ⟨K'.map R.subtype, ?_, Subgroup.map_subtype_le K', ?_, ?_, ?_⟩
    · intro y hy
      exact ⟨⟨y, hQR hy⟩, hQK' hy, rfl⟩
    · rw [← Subgroup.relIndex_comap]
      exact hidxQ''
    · rintro x ⟨a, ha, rfl⟩ y hy
      exact hnormal.conj_mem ⟨⟨y, hQR hy⟩, hQK' hy⟩ hy ⟨a, ha⟩
    · rintro x ⟨a, ha, rfl⟩ y ⟨b, hb, rfl⟩
      exact hcomm' ⟨a, ha⟩ ⟨b, hb⟩
  
  have grp : ∀ {G : Type u} [Group G] (A B C : Subgroup G) [C.Normal], C ≤ B → B ≤ A →
      (C.subgroupOf A).index = ℓ ^ k → B ≠ A →
      ∃ H : Subgroup G, B ≤ H ∧ H ≤ A ∧ B.relIndex H = ℓ ∧
        (∀ σ ∈ H, ∀ τ ∈ B, σ * τ * σ⁻¹ ∈ B) ∧ (∀ σ ∈ H, ∀ τ ∈ H, σ * τ * σ⁻¹ * τ⁻¹ ∈ B) := by
    intro G _ A B C _ hCB hBA hidx hBAne
    have hBeq : (B.map (QuotientGroup.mk' C)).comap (QuotientGroup.mk' C) = B := by
      rw [QuotientGroup.comap_map_mk', sup_eq_right.mpr hCB]
    have hAeq : (A.map (QuotientGroup.mk' C)).comap (QuotientGroup.mk' C) = A := by
      rw [QuotientGroup.comap_map_mk', sup_eq_right.mpr (hCB.trans hBA)]
    have hcard : Nat.card (A.map (QuotientGroup.mk' C)) = ℓ ^ k := by
      have h1 : (⊥ : Subgroup (G ⧸ C)).comap (QuotientGroup.mk' C) = C := by
        rw [MonoidHom.comap_bot, QuotientGroup.ker_mk']
      rw [← hidx, ← Subgroup.relIndex_bot_left, ← Subgroup.relIndex_comap, h1]
      rfl
    have hQR : B.map (QuotientGroup.mk' C) ≠ A.map (QuotientGroup.mk' C) := by
      intro h
      apply hBAne
      rw [← hBeq, ← hAeq, h]
    obtain ⟨K, hQK, hKR, hKidx, hKn, hKc⟩ :=
      pg (B.map (QuotientGroup.mk' C)) (A.map (QuotientGroup.mk' C)) (Subgroup.map_mono hBA) hcard hQR
    refine ⟨K.comap (QuotientGroup.mk' C), ?_, ?_, ?_, ?_, ?_⟩
    · rw [← hBeq]; exact Subgroup.comap_mono hQK
    · rw [← hAeq]; exact Subgroup.comap_mono hKR
    · calc B.relIndex (K.comap (QuotientGroup.mk' C))
          = ((B.map (QuotientGroup.mk' C)).comap (QuotientGroup.mk' C)).relIndex
              (K.comap (QuotientGroup.mk' C)) := by rw [hBeq]
        _ = (B.map (QuotientGroup.mk' C)).relIndex
              ((K.comap (QuotientGroup.mk' C)).map (QuotientGroup.mk' C)) :=
            Subgroup.relIndex_comap _ _ _
        _ = (B.map (QuotientGroup.mk' C)).relIndex K := by
            rw [Subgroup.map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective C)]
        _ = ℓ := hKidx
    · intro σ hσ τ hτ
      rw [← hBeq, Subgroup.mem_comap, map_mul, map_mul, map_inv]
      exact hKn _ hσ _ (Subgroup.mem_map_of_mem _ hτ)
    · intro σ hσ τ hτ
      rw [← hBeq, Subgroup.mem_comap, map_mul, map_mul, map_mul, map_inv, map_inv]
      exact hKc _ hσ _ hτ
  
  haveI hGal : IsGalois F (AlgebraicClosure F) := IsAlgClosure.isGalois F (AlgebraicClosure F)
  have hCB : N.fixingSubgroup ≤ X.fixingSubgroup := IntermediateField.fixingSubgroup_le hXN
  have hBA : X.fixingSubgroup ≤ E.fixingSubgroup := IntermediateField.fixingSubgroup_le hEX
  haveI hCn : N.fixingSubgroup.Normal := by
    refine ⟨fun n hn g => ?_⟩
    rw [IntermediateField.mem_fixingSubgroup_iff] at hn ⊢
    intro x hx
    have h1 : g⁻¹ x ∈ N := (hstab g⁻¹ x).mp hx
    have h2 := hn _ h1
    rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, h2]
    exact AlgEquiv.apply_symm_apply g x
  have hBAne : X.fixingSubgroup ≠ E.fixingSubgroup := by
    intro h
    apply hne
    rw [← InfiniteGalois.fixedField_fixingSubgroup X, ← InfiniteGalois.fixedField_fixingSubgroup E, h]
  obtain ⟨H, hBH, hHA, hHidx, hHn, hHc⟩ :=
    grp E.fixingSubgroup X.fixingSubgroup N.fixingSubgroup hCB hBA hk hBAne
  have hopen : IsOpen (H : Set (AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F)) :=
    Subgroup.isOpen_mono (hCB.trans hBH) (IntermediateField.fixingSubgroup_isOpen N)
  have hclosed : IsClosed (H : Set (AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F)) :=
    Subgroup.isClosed_of_isOpen H hopen
  have hfix : (IntermediateField.fixedField H).fixingSubgroup = H :=
    InfiniteGalois.fixingSubgroup_fixedField ⟨H, hclosed⟩
  haveI hX₁fd : FiniteDimensional F (IntermediateField.fixedField H) := by
    apply (InfiniteGalois.isOpen_iff_finite _).mp
    rw [hfix]; exact hopen
  have h₁ : E ≤ IntermediateField.fixedField H := by
    have h := IntermediateField.fixedField_antitone hHA
    rwa [InfiniteGalois.fixedField_fixingSubgroup E] at h
  have h₂ : IntermediateField.fixedField H ≤ X := by
    have h := IntermediateField.fixedField_antitone hBH
    rwa [InfiniteGalois.fixedField_fixingSubgroup X] at h
  refine ⟨IntermediateField.fixedField H, h₁, h₂, ?_, ?_⟩
  · refine ⟨?_, ?_, ?_⟩
    · intro σ hσ τ hτ
      rw [hfix] at hσ
      exact hHn σ hσ τ hτ
    · intro σ hσ τ hτ
      rw [hfix] at hσ hτ
      exact hHc σ hσ τ hτ
    · haveI : Algebra.IsSeparable F (AlgebraicClosure F) := IsGalois.to_isSeparable
      haveI : Algebra.IsSeparable (IntermediateField.fixedField H) (AlgebraicClosure F) :=
        Algebra.isSeparable_tower_top_of_isSeparable F _ _
      exact IntermediateField.isSeparable_tower_bot _ _
  · have hidx' : X.fixingSubgroup.relIndex (IntermediateField.fixedField H).fixingSubgroup = ℓ := by
      rw [hfix]; exact hHidx
    have hd := Subgroup.relIndex_mul_index (IntermediateField.fixingSubgroup_le h₂)
    rw [hidx', ← IntermediateField.finrank_eq_fixingSubgroup_index,
      ← IntermediateField.finrank_eq_fixingSubgroup_index] at hd
    have htow := IntermediateField.relfinrank_mul_relfinrank
      (bot_le : ⊥ ≤ IntermediateField.fixedField H) h₂
    rw [IntermediateField.relfinrank_bot_left, IntermediateField.relfinrank_bot_left,
      IntermediateField.relfinrank_eq_finrank_of_le h₂] at htow
    have hpos : 0 < Module.finrank F (IntermediateField.fixedField H) := Module.finrank_pos
    refine ⟨?_, ?_⟩
    · apply Nat.eq_of_mul_eq_mul_left hpos
      rw [htow, ← hd, mul_comm]
    · rw [← hd]
      nlinarith [hℓ.two_le]

theorem transfer_isWeilRep (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (h : L ≤ M)
    [((EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F L)).FiniteIndex]
    (θ : EllipticRootNumber.relWeil F M →* (EllipticRootNumber.Ω F)ˣ)
    (hθ : EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M θ)) :
    EllipticRootNumber.IsWeilRep F L (EllipticRootNumber.charRep F L
      ((θ.comp (Subgroup.subgroupOfEquivOfLe
        (EllipticRootNumber.relWeil_antitone F h)).toMonoidHom).transfer)) :=
by
  classical
  
  have inertia_conj : ∀ (σ g : EllipticRootNumber.AbsGal F),
      g ∈ EllipticRootNumber.inertia F → σ⁻¹ * g * σ ∈ EllipticRootNumber.inertia F := by
    intro σ g hg
    have hstab : ∀ x ∈ EllipticRootNumber.unramifiedClosure F,
        σ x ∈ EllipticRootNumber.unramifiedClosure F := by
      intro x hx
      unfold EllipticRootNumber.unramifiedClosure at hx ⊢
      induction hx using IntermediateField.adjoin_induction with
      | mem x hx =>
        apply IntermediateField.subset_adjoin
        obtain ⟨n, hn, hp, hxn⟩ := hx
        exact ⟨n, hn, hp, by rw [← map_pow, hxn, map_one]⟩
      | algebraMap a =>
        rw [AlgEquiv.commutes]
        exact IntermediateField.algebraMap_mem _ a
      | add x y _ _ hx hy =>
        rw [map_add]
        exact add_mem hx hy
      | inv x _ hx =>
        rw [map_inv₀]
        exact inv_mem hx
      | mul x y _ _ hx hy =>
        rw [map_mul]
        exact mul_mem hx hy
    unfold EllipticRootNumber.inertia at hg ⊢
    rw [IntermediateField.mem_fixingSubgroup_iff] at hg ⊢
    intro x hx
    rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, hg _ (hstab x hx), ← AlgEquiv.mul_apply,
      inv_mul_cancel, AlgEquiv.one_apply]
  obtain ⟨hfd, Uθ, hUθ, hθU⟩ := hθ
  
  have hθ1 : ∀ y : EllipticRootNumber.relWeil F M, (y : EllipticRootNumber.AbsGal F) ∈ Uθ →
      (y : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → θ y = 1 := by
    intro y h1 h2
    have h3 := congrArg ULift.down
      (LinearMap.congr_fun (hθU y h1 h2) (ULift.up (1 : EllipticRootNumber.Ω F)))
    have h4 : ((θ y : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) = 1 := by
      simpa [EllipticRootNumber.charRep] using h3
    exact Units.val_eq_one.mp h4
  
  set H := (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F L) with hH
  let S : Set (EllipticRootNumber.AbsGal F) :=
    Uθ ∩ (M.fixingSubgroup : Set (EllipticRootNumber.AbsGal F))
  have hS : S ∈ nhds (1 : EllipticRootNumber.AbsGal F) :=
    Filter.inter_mem hUθ (IsOpen.mem_nhds (IntermediateField.fixingSubgroup_isOpen M)
      M.fixingSubgroup.one_mem)
  let r : (EllipticRootNumber.relWeil F L ⧸ H) → EllipticRootNumber.AbsGal F :=
    fun c => ((Quotient.out c : EllipticRootNumber.relWeil F L) : EllipticRootNumber.AbsGal F)
  let U : Set (EllipticRootNumber.AbsGal F) := ⋂ c, (fun x => (r c)⁻¹ * x * r c) ⁻¹' S
  have hU : U ∈ nhds (1 : EllipticRootNumber.AbsGal F) := by
    apply Filter.iInter_mem.mpr
    intro c
    apply ContinuousAt.preimage_mem_nhds
    · exact ((continuous_const.mul continuous_id).mul continuous_const).continuousAt
    · simpa using hS
  refine ⟨hfd, U, hU, fun w hwU hwI => ?_⟩
  
  have hconj : ∀ c : EllipticRootNumber.relWeil F L ⧸ H,
      ∃ hx : (Quotient.out c)⁻¹ * w * Quotient.out c ∈ H,
        (θ.comp (Subgroup.subgroupOfEquivOfLe
          (EllipticRootNumber.relWeil_antitone F h)).toMonoidHom) ⟨_, hx⟩ = 1 := by
    intro c
    have hc := Set.mem_iInter.mp hwU c
    have hxM : (((Quotient.out c)⁻¹ * w * Quotient.out c : EllipticRootNumber.relWeil F L) :
        EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.relWeil F M := by
      unfold EllipticRootNumber.relWeil
      refine Subgroup.mem_inf.mpr ⟨?_, hc.2⟩
      exact EllipticRootNumber.relWeil_le_weilGroup F L
        ((Quotient.out c)⁻¹ * w * Quotient.out c).2
    refine ⟨Subgroup.mem_subgroupOf.mpr hxM, ?_⟩
    exact hθ1 ⟨_, hxM⟩ hc.1 (inertia_conj _ _ hwI)
  
  have hV : (θ.comp (Subgroup.subgroupOfEquivOfLe
      (EllipticRootNumber.relWeil_antitone F h)).toMonoidHom).transfer w = 1 := by
    haveI hfin : Finite (EllipticRootNumber.relWeil F L ⧸ H) :=
      Subgroup.finite_quotient_of_finiteIndex
    haveI : Finite (Quotient (MulAction.orbitRel (Subgroup.zpowers w)
      (EllipticRootNumber.relWeil F L ⧸ H))) := Quotient.finite _
    letI : Fintype (Quotient (MulAction.orbitRel (Subgroup.zpowers w)
      (EllipticRootNumber.relWeil F L ⧸ H))) := Fintype.ofFinite _
    rw [MonoidHom.transfer_eq_prod_quotient_orbitRel_zpowers_quot]
    apply Finset.prod_eq_one
    intro q _
    have gen : ∀ (r : EllipticRootNumber.relWeil F L) (hx : r⁻¹ * w * r ∈ H),
        (θ.comp (Subgroup.subgroupOfEquivOfLe
          (EllipticRootNumber.relWeil_antitone F h)).toMonoidHom) ⟨_, hx⟩ = 1 →
        ∀ (n : ℕ) (hn : r⁻¹ * w ^ n * r ∈ H),
          (θ.comp (Subgroup.subgroupOfEquivOfLe
            (EllipticRootNumber.relWeil_antitone F h)).toMonoidHom) ⟨_, hn⟩ = 1 := by
      intro r hx h1 n hn
      have eq : ∀ k : ℕ, (r⁻¹ * w * r) ^ k = r⁻¹ * w ^ k * r := by
        intro k
        induction k with
        | zero => simp
        | succ k ih =>
          rw [pow_succ, ih, pow_succ]
          group
      have e : (⟨r⁻¹ * w ^ n * r, hn⟩ : H) = (⟨_, hx⟩ : H) ^ n := by
        apply Subtype.ext
        simp only [SubgroupClass.coe_pow]
        exact (eq n).symm
      rw [e, map_pow, h1, one_pow]
    obtain ⟨hx, h1⟩ := hconj q.out
    exact gen _ hx h1 _ _
  
  apply LinearMap.ext
  intro v
  show (((θ.comp (Subgroup.subgroupOfEquivOfLe
      (EllipticRootNumber.relWeil_antitone F h)).toMonoidHom).transfer w :
      (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) • v = v
  rw [hV, Units.val_one, one_smul]

theorem relWeil_subgroupOf_index (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] (rec : EllipticRootNumber.LocalReciprocity F)
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (h : L ≤ M) :
    ((EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F L)).index =
      Module.finrank L (IntermediateField.extendScalars h) :=
by
  classical
  
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : EllipticRootNumber.AbsGal F, EllipticRootNumber.ActsAsFrobPow F Φ 1 := by
    obtain ⟨-, -, x, hx⟩ := relVal_bot_spec F
    have hx0 : x ≠ 0 := by
      rintro rfl
      have h0 : EllipticRootNumber.relVal F ⊥
          (0 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
        rw [EllipticRootNumber.relVal, Algebra.norm_zero]
        simp [EllipticRootNumber.addVal]
      rw [h0] at hx
      exact absurd hx (by norm_num)
    have hdeg := rec.degree_rec ⊥ (Units.mk0 x hx0)
    rw [Units.val_mk0, hx] at hdeg
    set σ : EllipticRootNumber.weilGroup F :=
      (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥)
        (rec.recMap ⊥ (Units.mk0 x hx0)))⁻¹ with hσdef
    have hσ : EllipticRootNumber.weilDegreeHom F σ = Multiplicative.ofAdd 1 := by
      rw [hσdef, map_inv, hdeg, ← ofAdd_neg, neg_neg]
    obtain ⟨spec1, spec2⟩ := weilDegreeHom_spec_of_localField F
    obtain ⟨n, hn⟩ := spec1 (σ : EllipticRootNumber.AbsGal F) σ.2
    have hn' := spec2 σ n hn
    rw [hσ] at hn'
    have hn1 : n = 1 := (Multiplicative.ofAdd.injective hn').symm
    exact ⟨σ, hn1 ▸ hn⟩
  
  have hdense : ∀ σ ∈ L.fixingSubgroup, ∃ w ∈ EllipticRootNumber.weilGroup F ⊓ L.fixingSubgroup,
      w⁻¹ * σ ∈ M.fixingSubgroup := by
    intro σ hσ
    obtain ⟨w, hwW, hw⟩ := weilGroup_restrict_surj F Φ hΦ
      (IntermediateField.normalClosure F M (AlgebraicClosure F)) σ
    have hMN : M ≤ IntermediateField.normalClosure F M (AlgebraicClosure F) :=
      IntermediateField.le_normalClosure M
    refine ⟨w, Subgroup.mem_inf.mpr ⟨hwW, ?_⟩, ?_⟩
    · rw [IntermediateField.mem_fixingSubgroup_iff] at hσ ⊢
      intro x hx
      rw [hw x (hMN (h hx))]
      exact hσ x hx
    · rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      rw [AlgEquiv.mul_apply, ← hw x (hMN hx), AlgEquiv.aut_inv, AlgEquiv.symm_apply_apply]
  
  have grp : ∀ (W A B : Subgroup (EllipticRootNumber.AbsGal F)),
      (∀ σ ∈ A, ∃ w ∈ W ⊓ A, w⁻¹ * σ ∈ B) →
      ((W ⊓ B).subgroupOf (W ⊓ A)).index = (B.subgroupOf A).index := by
    intro W A B hd
    let x₀ : EllipticRootNumber.AbsGal F ⧸ B :=
      QuotientGroup.mk (1 : EllipticRootNumber.AbsGal F)
    have hs1 : MulAction.stabilizer (↥(W ⊓ A)) x₀ = (W ⊓ B).subgroupOf (W ⊓ A) := by
      ext s
      rw [MulAction.mem_stabilizer_iff, Subgroup.mem_subgroupOf, Subgroup.mem_inf,
        Subgroup.smul_def]
      simp only [x₀, MulAction.Quotient.smul_mk, smul_eq_mul, mul_one]
      rw [QuotientGroup.eq, mul_one, inv_mem_iff]
      exact ⟨fun hb => ⟨(Subgroup.mem_inf.mp s.2).1, hb⟩, fun hb => hb.2⟩
    have hs2 : MulAction.stabilizer (↥A) x₀ = B.subgroupOf A := by
      ext s
      rw [MulAction.mem_stabilizer_iff, Subgroup.mem_subgroupOf, Subgroup.smul_def]
      simp only [x₀, MulAction.Quotient.smul_mk, smul_eq_mul, mul_one]
      rw [QuotientGroup.eq, mul_one, inv_mem_iff]
    rw [← hs1, ← hs2, MulAction.index_stabilizer, MulAction.index_stabilizer]
    refine congrArg Set.ncard ?_
    apply Set.Subset.antisymm
    · rintro _ ⟨s, rfl⟩
      exact ⟨⟨s, (Subgroup.mem_inf.mp s.2).2⟩, rfl⟩
    · rintro _ ⟨a, rfl⟩
      obtain ⟨w, hw, hwa⟩ := hd a a.2
      refine ⟨⟨w, hw⟩, ?_⟩
      change ((w : EllipticRootNumber.AbsGal F) • x₀) = ((a : EllipticRootNumber.AbsGal F) • x₀)
      simp only [x₀, MulAction.Quotient.smul_mk, smul_eq_mul, mul_one]
      exact QuotientGroup.eq.mpr hwa
  
  have gal : (M.fixingSubgroup.subgroupOf L.fixingSubgroup).index =
      Module.finrank L (IntermediateField.extendScalars h) := by
    haveI : IsGalois F (AlgebraicClosure F) := inferInstance
    have h1 := Subgroup.relIndex_mul_index (IntermediateField.fixingSubgroup_le h)
    have hL := IntermediateField.finrank_eq_fixingSubgroup_index L
    have hM := IntermediateField.finrank_eq_fixingSubgroup_index M
    have h2 := IntermediateField.finrank_bot_mul_relfinrank h
    rw [IntermediateField.relfinrank_eq_finrank_of_le h] at h2
    have hpos : 0 < Module.finrank F M := Module.finrank_pos
    have hLpos : 0 < Module.finrank F L := by
      rcases Nat.eq_zero_or_pos (Module.finrank F L) with h0 | h0
      · rw [h0, zero_mul] at h2
        omega
      · exact h0
    show M.fixingSubgroup.relIndex L.fixingSubgroup = _
    apply Nat.eq_of_mul_eq_mul_left hLpos
    rw [h2, hM, ← h1, hL, mul_comm]
  
  show ((EllipticRootNumber.weilGroup F ⊓ M.fixingSubgroup).subgroupOf
      (EllipticRootNumber.weilGroup F ⊓ L.fixingSubgroup)).index = _
  rw [grp _ _ _ hdense, gal]

theorem weilChar_trivial_mod_abelian_deg0 (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : EllipticRootNumber.LocalReciprocity F)
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (χ : EllipticRootNumber.relWeil F L →* (EllipticRootNumber.Ω F)ˣ)
    (hχ : EllipticRootNumber.IsWeilRep F L (EllipticRootNumber.charRep F L χ)) :
    ∃ (N : IntermediateField F (AlgebraicClosure F)) (h : L ≤ N),
      FiniteDimensional F N ∧ EllipticRootNumber.IsAbelianExt F h ∧
      ∀ w : EllipticRootNumber.relWeil F L, (w : EllipticRootNumber.AbsGal F) ∈ N.fixingSubgroup →
        EllipticRootNumber.weilDegreeHom F
          (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L) w) = 1 → χ w = 1 :=
by
  
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : EllipticRootNumber.AbsGal F, EllipticRootNumber.ActsAsFrobPow F Φ 1 := by
    obtain ⟨-, hmul, x₀, hx1⟩ := relVal_bot_spec F
    have hx : x₀ ≠ 0 := by
      rintro rfl
      have h0 : EllipticRootNumber.relVal F ⊥
          (0 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
        unfold EllipticRootNumber.relVal
        rw [Algebra.norm_zero]
        unfold EllipticRootNumber.addVal
        simp
      rw [h0] at hx1
      exact zero_ne_one hx1
    have hinv : EllipticRootNumber.relVal F ⊥ x₀⁻¹ = -1 := by
      have h := hmul x₀ x₀⁻¹ hx (inv_ne_zero hx)
      rw [mul_inv_cancel₀ hx, hx1] at h
      have h1 := hmul 1 1 one_ne_zero one_ne_zero
      rw [mul_one] at h1
      omega
    have hd := rec.degree_rec ⊥ (Units.mk0 x₀ hx)⁻¹
    have hval : (((Units.mk0 x₀ hx)⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) = x₀⁻¹ := by
      rw [Units.val_inv_eq_inv_val, Units.val_mk0]
    rw [hval, hinv, neg_neg] at hd
    obtain ⟨hspec1, hspec2⟩ := weilDegreeHom_spec_of_localField F
    obtain ⟨n, hn⟩ := hspec1 _ (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥)
      (rec.recMap ⊥ (Units.mk0 x₀ hx)⁻¹)).2
    have hn' := hspec2 _ n hn
    rw [hd] at hn'
    have hn1 : (1 : ℤ) = n := Multiplicative.ofAdd.injective hn'
    subst hn1
    exact ⟨_, hn⟩
  
  have hdense : ∀ N : IntermediateField F (AlgebraicClosure F), FiniteDimensional F N →
      Normal F N → ∀ σ : EllipticRootNumber.AbsGal F,
        ∃ w ∈ EllipticRootNumber.weilGroup F, ∀ x ∈ N, w x = σ x := by
    intro N hN hNn σ
    haveI := hN
    haveI := hNn
    exact weilGroup_restrict_surj F Φ hΦ N σ
  
  obtain ⟨-, U, hU, hUχ⟩ := hχ
  have key : ∀ w : EllipticRootNumber.relWeil F L, (w : EllipticRootNumber.AbsGal F) ∈ U →
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → χ w = 1 := by
    intro w hw1 hw2
    have h := hUχ w hw1 hw2
    have h' := LinearMap.congr_fun h (ULift.up (1 : EllipticRootNumber.Ω F))
    have h'' := congrArg ULift.down h'
    apply Units.ext
    simpa [EllipticRootNumber.charRep] using h''
  
  have hHH : ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆ ≤
      EllipticRootNumber.relWeil F L := by
    rw [Subgroup.commutator_le]
    intro g₁ h₁ g₂ h₂
    rw [commutatorElement_def]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ h₁ h₂)
      (Subgroup.inv_mem _ h₁)) (Subgroup.inv_mem _ h₂)
  have hHI : ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆ ≤
      EllipticRootNumber.inertia F := by
    rw [Subgroup.commutator_le]
    intro g₁ h₁ g₂ h₂
    have hdeg : EllipticRootNumber.weilDegreeHom F
        ⁅(⟨g₁, EllipticRootNumber.relWeil_le_weilGroup F L h₁⟩ : EllipticRootNumber.weilGroup F),
          (⟨g₂, EllipticRootNumber.relWeil_le_weilGroup F L h₂⟩ :
            EllipticRootNumber.weilGroup F)⁆ = 1 := by
      rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
      exact mul_comm _ _
    exact weilDegreeHom_ker_le_inertia F _ hdeg
  have hχcomm : ∀ c ∈ ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆,
      ∀ hc : c ∈ EllipticRootNumber.relWeil F L, χ ⟨c, hc⟩ = 1 := by
    have hle : ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆ ≤
        χ.ker.map (EllipticRootNumber.relWeil F L).subtype := by
      rw [Subgroup.commutator_le]
      intro g₁ h₁ g₂ h₂
      refine Subgroup.mem_map.mpr ⟨⁅(⟨g₁, h₁⟩ : EllipticRootNumber.relWeil F L), ⟨g₂, h₂⟩⁆, ?_, rfl⟩
      rw [MonoidHom.mem_ker, map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
      exact mul_comm _ _
    intro c hc hcH
    obtain ⟨k, hk, hkc⟩ := Subgroup.mem_map.mp (hle hc)
    have hk' : k = ⟨c, hcH⟩ := Subtype.ext hkc
    rw [← hk']
    exact hk
  
  obtain ⟨M, h, hMfin, hab, hcov⟩ := exists_abelianExt_commutator_cover F hdense L U hU
  refine ⟨M, h, hMfin, hab, ?_⟩
  
  intro w hwM hdeg0
  have hwI : (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F :=
    weilDegreeHom_ker_le_inertia F
      (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L) w) hdeg0
  
  obtain ⟨c, hc, hcU⟩ := hcov _ w.2 hwM
  have hcH : c ∈ EllipticRootNumber.relWeil F L := hHH hc
  have hcI : c ∈ EllipticRootNumber.inertia F := hHI hc
  have hχc : χ ⟨c, hcH⟩ = 1 := hχcomm c hc hcH
  have hn : χ ((⟨c, hcH⟩ : EllipticRootNumber.relWeil F L)⁻¹ * w) = 1 :=
    key _ hcU ((EllipticRootNumber.inertia F).mul_mem
      ((EllipticRootNumber.inertia F).inv_mem hcI) hwI)
  calc χ w
      = χ ((⟨c, hcH⟩ : EllipticRootNumber.relWeil F L) *
          ((⟨c, hcH⟩ : EllipticRootNumber.relWeil F L)⁻¹ * w)) := by
        rw [mul_inv_cancel_left]
    _ = 1 := by rw [map_mul, hχc, hn, one_mul]

theorem transfer_prime_index_normal {G A : Type*} [Group G] [CommGroup A] (H : Subgroup G) [H.Normal]
    [H.FiniteIndex] (ℓ : ℕ) (hℓ : ℓ.Prime) (hidx : H.index = ℓ) (ϕ : H →* A) (t : G) (ht : t ∉ H) :
    (∀ g : G, g ∈ H → ∀ c : ℕ → H, (∀ j : ℕ, (c j : G) = t⁻¹ ^ j * g * t ^ j) →
       ϕ.transfer g = ∏ j ∈ Finset.range ℓ, ϕ (c j)) ∧
    (∀ g : G, g ∉ H → ∀ d : H, (d : G) = g ^ ℓ → ϕ.transfer g = ϕ d) :=
by
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  
  have star : ∀ (w : G) (q : G ⧸ H), w • q = (QuotientGroup.mk w : G ⧸ H) * q := by
    intro w q
    induction q using QuotientGroup.induction_on with
    | H x => rw [MulAction.Quotient.smul_mk, smul_eq_mul, QuotientGroup.mk_mul]
  
  have conjF : ∀ (a b h : G) (hh : h ∈ H) (ha : a ∈ H) (hb : b ∈ H), b = h⁻¹ * a * h →
      ϕ ⟨b, hb⟩ = ϕ ⟨a, ha⟩ := by
    intro a b h hh ha hb e
    have : (⟨b, hb⟩ : H) = (⟨h, hh⟩ : H)⁻¹ * ⟨a, ha⟩ * ⟨h, hh⟩ := Subtype.ext (by simp [e])
    rw [this, map_mul, map_mul, map_inv, mul_comm, mul_inv_cancel_left]
  have hcard : Nat.card (G ⧸ H) = ℓ := by rw [← Subgroup.index_eq_card, hidx]
  letI : Fintype (G ⧸ H) := Fintype.ofFinite _
  refine ⟨?_, ?_⟩
  · intro g hg c hc
    set R := MulAction.orbitRel (Subgroup.zpowers g) (G ⧸ H) with hR
    have triv : ∀ (w : Subgroup.zpowers g) (q : G ⧸ H), w • q = q := by
      intro w q
      rw [Subgroup.smul_def, star]
      have hw : (w : G) ∈ H := Subgroup.zpowers_le.mpr hg w.2
      rw [(QuotientGroup.eq_one_iff _).mpr hw, one_mul]
    have Rtriv : ∀ a b : G ⧸ H, R a b → a = b := by
      intro a b hab
      rw [hR, MulAction.orbitRel_apply, MulAction.mem_orbit_iff] at hab
      obtain ⟨w, hw⟩ := hab
      rw [← hw, triv]
    
    have s1 : Function.Bijective (fun j : Fin ℓ => (QuotientGroup.mk (t ^ (j : ℕ)) : G ⧸ H)) := by
      have hτ1 : (QuotientGroup.mk t : G ⧸ H) ≠ 1 := fun h => ht ((QuotientGroup.eq_one_iff t).mp h)
      have hτℓ : (QuotientGroup.mk t : G ⧸ H) ^ ℓ = 1 := by
        rw [← hcard]; exact pow_card_eq_one'
      have hord : orderOf (QuotientGroup.mk t : G ⧸ H) = ℓ := orderOf_eq_prime hτℓ hτ1
      rw [Fintype.bijective_iff_injective_and_card]
      refine ⟨?_, ?_⟩
      · intro i j hij
        simp only [QuotientGroup.mk_pow] at hij
        apply Fin.ext
        exact pow_injOn_Iio_orderOf (by rw [hord]; exact i.2) (by rw [hord]; exact j.2) hij
      · rw [Fintype.card_fin, ← Nat.card_eq_fintype_card, hcard]
    let e : Fin ℓ → Quotient R := fun j => Quotient.mk R (QuotientGroup.mk (t ^ (j : ℕ)))
    have he : Function.Bijective e := by
      refine ⟨?_, ?_⟩
      · intro i j hij
        exact s1.1 (Rtriv _ _ (Quotient.exact hij))
      · intro q
        obtain ⟨j, hj⟩ := s1.2 q.out
        refine ⟨j, ?_⟩
        show Quotient.mk R _ = q
        rw [show (QuotientGroup.mk (t ^ (j : ℕ)) : G ⧸ H) = q.out from hj]
        exact Quotient.out_eq q
    rw [MonoidHom.transfer_eq_prod_quotient_orbitRel_zpowers_quot ϕ g,
      ← Fin.prod_univ_eq_prod_range (fun j => ϕ (c j)) ℓ]
    symm
    refine Fintype.prod_bijective e he _ _ ?_
    intro j
    symm
    have hq0 : (e j).out = (QuotientGroup.mk (t ^ (j : ℕ)) : G ⧸ H) :=
      Rtriv _ _ (Quotient.mk_out (s := R) _)
    have hy : (QuotientGroup.mk (e j).out.out : G ⧸ H) = QuotientGroup.mk (t ^ (j : ℕ)) := by
      rw [QuotientGroup.out_eq', hq0]
    have hh : (t ^ (j : ℕ))⁻¹ * (e j).out.out ∈ H := QuotientGroup.eq.mp hy.symm
    have hper : Function.minimalPeriod (fun x => g • x) (e j).out = 1 := by
      rw [Function.minimalPeriod_eq_one_iff_isFixedPt]
      show g • (e j).out = (e j).out
      exact triv ⟨g, Subgroup.mem_zpowers g⟩ _
    refine conjF _ _ _ hh (c (j : ℕ)).2 _ ?_
    rw [hper, pow_one, hc (j : ℕ), inv_pow]
    group
  · intro g hg d hd
    set R := MulAction.orbitRel (Subgroup.zpowers g) (G ⧸ H) with hR
    have hγ : (QuotientGroup.mk g : G ⧸ H) ≠ 1 := fun h => hg ((QuotientGroup.eq_one_iff g).mp h)
    have htop : Subgroup.zpowers (QuotientGroup.mk g : G ⧸ H) = ⊤ :=
      zpowers_eq_top_of_prime_card hcard hγ
    have hsub : Subsingleton (Quotient R) := by
      refine ⟨fun a b => ?_⟩
      induction a using Quotient.inductionOn with
      | h q₁ =>
      induction b using Quotient.inductionOn with
      | h q₂ =>
      apply Quotient.sound
      show R q₁ q₂
      rw [hR, MulAction.orbitRel_apply, MulAction.mem_orbit_iff]
      have hm : q₁ * q₂⁻¹ ∈ Subgroup.zpowers (QuotientGroup.mk g : G ⧸ H) := by
        rw [htop]; exact Subgroup.mem_top _
      obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hm
      refine ⟨⟨g ^ k, Subgroup.zpow_mem_zpowers g k⟩, ?_⟩
      rw [Subgroup.smul_def, star, QuotientGroup.mk_zpow, hk, inv_mul_cancel_right]
    rw [MonoidHom.transfer_eq_prod_quotient_orbitRel_zpowers_quot ϕ g]
    rw [Fintype.prod_subsingleton _ (Quotient.mk R (QuotientGroup.mk (1 : G)))]
    set q₀ := (Quotient.mk R (QuotientGroup.mk (1 : G))).out with hq₀
    have hper : Function.minimalPeriod (fun x => g • x) q₀ = ℓ := by
      have hpp : Function.IsPeriodicPt (fun x => g • x) ℓ q₀ := by
        show (fun x => g • x)^[ℓ] q₀ = q₀
        rw [smul_iterate_apply, star, ← hd, (QuotientGroup.eq_one_iff _).mpr d.2, one_mul]
      rcases hℓ.eq_one_or_self_of_dvd _ hpp.minimalPeriod_dvd with h1 | h1
      · exfalso
        rw [Function.minimalPeriod_eq_one_iff_isFixedPt] at h1
        have h2 : g • q₀ = q₀ := h1
        rw [star] at h2
        exact hγ (mul_eq_right.mp h2)
      · exact h1
    have hm : (QuotientGroup.mk q₀.out : G ⧸ H) ∈ Subgroup.zpowers (QuotientGroup.mk g : G ⧸ H) := by
      rw [htop]; exact Subgroup.mem_top _
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hm
    rw [← QuotientGroup.mk_zpow] at hk
    have hh : (g ^ k)⁻¹ * q₀.out ∈ H := QuotientGroup.eq.mp hk
    refine conjF _ _ _ hh d.2 _ ?_
    rw [hper, hd]
    have hc : g ^ ℓ * g ^ k = g ^ k * g ^ ℓ := by
      rw [← zpow_natCast, ← zpow_add, ← zpow_add, add_comm]
    have hc' : (g ^ k)⁻¹ * g ^ ℓ * g ^ k = g ^ ℓ := by
      rw [mul_assoc, hc, inv_mul_cancel_left]
    calc (q₀.out)⁻¹ * g ^ ℓ * q₀.out
        = ((g ^ k)⁻¹ * q₀.out)⁻¹ * ((g ^ k)⁻¹ * g ^ ℓ * g ^ k) * ((g ^ k)⁻¹ * q₀.out) := by
          simp only [mul_inv_rev, inv_inv, mul_assoc, mul_inv_cancel_left]
      _ = ((g ^ k)⁻¹ * q₀.out)⁻¹ * g ^ ℓ * ((g ^ k)⁻¹ * q₀.out) := by
          rw [hc']

theorem weilChar_norm_compat (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] (rec : EllipticRootNumber.LocalReciprocity F)
    (L L' : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    [FiniteDimensional F L'] (h : L ≤ L')
    (θ : EllipticRootNumber.relWeil F L →* (EllipticRootNumber.Ω F)ˣ)
    (hθ : EllipticRootNumber.IsWeilRep F L (EllipticRootNumber.charRep F L θ)) (x : L'ˣ) :
    θ (rec.recMap L (Units.map (EllipticRootNumber.normLM F h) x)) =
      θ (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) (rec.recMap L' x)) :=
by
  classical
  
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : EllipticRootNumber.AbsGal F, EllipticRootNumber.ActsAsFrobPow F Φ 1 := by
    obtain ⟨-, hmul, x₀, hx1⟩ := relVal_bot_spec F
    have hx : x₀ ≠ 0 := by
      rintro rfl
      have h0 : EllipticRootNumber.relVal F ⊥
          (0 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
        unfold EllipticRootNumber.relVal
        rw [Algebra.norm_zero]
        unfold EllipticRootNumber.addVal
        simp
      rw [h0] at hx1
      exact zero_ne_one hx1
    have hinv : EllipticRootNumber.relVal F ⊥ x₀⁻¹ = -1 := by
      have h := hmul x₀ x₀⁻¹ hx (inv_ne_zero hx)
      rw [mul_inv_cancel₀ hx, hx1] at h
      have h1 := hmul 1 1 one_ne_zero one_ne_zero
      rw [mul_one] at h1
      omega
    have hd := rec.degree_rec ⊥ (Units.mk0 x₀ hx)⁻¹
    have hval : (((Units.mk0 x₀ hx)⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) = x₀⁻¹ := by
      rw [Units.val_inv_eq_inv_val, Units.val_mk0]
    rw [hval, hinv, neg_neg] at hd
    obtain ⟨hspec1, hspec2⟩ := weilDegreeHom_spec_of_localField F
    obtain ⟨n, hn⟩ := hspec1 _ (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥)
      (rec.recMap ⊥ (Units.mk0 x₀ hx)⁻¹)).2
    have hn' := hspec2 _ n hn
    rw [hd] at hn'
    have hn1 : (1 : ℤ) = n := Multiplicative.ofAdd.injective hn'
    subst hn1
    exact ⟨_, hn⟩
  
  have hdense : ∀ N : IntermediateField F (AlgebraicClosure F), FiniteDimensional F N →
      Normal F N → ∀ σ : EllipticRootNumber.AbsGal F,
        ∃ w ∈ EllipticRootNumber.weilGroup F, ∀ x ∈ N, w x = σ x := by
    intro N hN hNn σ
    haveI := hN
    haveI := hNn
    exact weilGroup_restrict_surj F Φ hΦ N σ
  
  have hθ' := hθ
  obtain ⟨-, U, hU, hUθ⟩ := hθ'
  have keyU : ∀ w : EllipticRootNumber.relWeil F L, (w : EllipticRootNumber.AbsGal F) ∈ U →
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → θ w = 1 := by
    intro w hw1 hw2
    have h1 := hUθ w hw1 hw2
    have h' := LinearMap.congr_fun h1 (ULift.up (1 : EllipticRootNumber.Ω F))
    have h'' := congrArg ULift.down h'
    apply Units.ext
    simpa [EllipticRootNumber.charRep] using h''
  
  have hHH : ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆ ≤
      EllipticRootNumber.relWeil F L := by
    rw [Subgroup.commutator_le]
    intro g₁ h₁ g₂ h₂
    rw [commutatorElement_def]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ h₁ h₂)
      (Subgroup.inv_mem _ h₁)) (Subgroup.inv_mem _ h₂)
  have hHI : ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆ ≤
      EllipticRootNumber.inertia F := by
    rw [Subgroup.commutator_le]
    intro g₁ h₁ g₂ h₂
    have hdeg : EllipticRootNumber.weilDegreeHom F
        ⁅(⟨g₁, EllipticRootNumber.relWeil_le_weilGroup F L h₁⟩ : EllipticRootNumber.weilGroup F),
          (⟨g₂, EllipticRootNumber.relWeil_le_weilGroup F L h₂⟩ :
            EllipticRootNumber.weilGroup F)⁆ = 1 := by
      rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
      exact mul_comm _ _
    exact weilDegreeHom_ker_le_inertia F _ hdeg
  have hθcomm : ∀ c ∈ ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆,
      ∀ hc : c ∈ EllipticRootNumber.relWeil F L, θ ⟨c, hc⟩ = 1 := by
    have hle : ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆ ≤
        θ.ker.map (EllipticRootNumber.relWeil F L).subtype := by
      rw [Subgroup.commutator_le]
      intro g₁ h₁ g₂ h₂
      refine Subgroup.mem_map.mpr ⟨⁅(⟨g₁, h₁⟩ : EllipticRootNumber.relWeil F L), ⟨g₂, h₂⟩⁆, ?_, rfl⟩
      rw [MonoidHom.mem_ker, map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
      exact mul_comm _ _
    intro c hc hcH
    obtain ⟨k, hk, hkc⟩ := Subgroup.mem_map.mp (hle hc)
    have hk' : k = ⟨c, hcH⟩ := Subtype.ext hkc
    rw [← hk']
    exact hk
  
  obtain ⟨M₀, hLM₀, hM₀fin, hab, hcov⟩ := exists_abelianExt_commutator_cover F hdense L U hU
  haveI := hM₀fin
  have hker : ∀ g : EllipticRootNumber.relWeil F L,
      (g : EllipticRootNumber.AbsGal F) ∈ M₀.fixingSubgroup →
      (g : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → θ g = 1 := by
    intro g hgM hgI
    obtain ⟨c, hc, hcU⟩ := hcov _ g.2 hgM
    have hcH : c ∈ EllipticRootNumber.relWeil F L := hHH hc
    have hcI : c ∈ EllipticRootNumber.inertia F := hHI hc
    have hθc : θ ⟨c, hcH⟩ = 1 := hθcomm c hc hcH
    have hn : θ ((⟨c, hcH⟩ : EllipticRootNumber.relWeil F L)⁻¹ * g) = 1 :=
      keyU _ hcU ((EllipticRootNumber.inertia F).mul_mem
        ((EllipticRootNumber.inertia F).inv_mem hcI) hgI)
    calc θ g
        = θ ((⟨c, hcH⟩ : EllipticRootNumber.relWeil F L) *
            ((⟨c, hcH⟩ : EllipticRootNumber.relWeil F L)⁻¹ * g)) := by
          rw [mul_inv_cancel_left]
      _ = 1 := by rw [map_mul, hθc, hn, one_mul]
  
  have normF : ∀ y : L', Algebra.norm F ((EllipticRootNumber.normLM F h y : L)) =
      Algebra.norm F y := by
    intro y
    letI i1 : Algebra L L' := (IntermediateField.inclusion h).toRingHom.toAlgebra
    have e1 : Algebra.norm L y = EllipticRootNumber.normLM F h y := by
      let e : L' ≃ₐ[L] IntermediateField.extendScalars h :=
        { toFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars h).mpr y.2⟩
          invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars h).mp y.2⟩
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl
          map_mul' := fun _ _ => rfl
          map_add' := fun _ _ => rfl
          commutes' := fun _ => rfl }
      exact (Algebra.norm_eq_of_algEquiv e y)
    rw [← e1]
    haveI hT := @IsScalarTower.of_algebraMap_eq F L L' _ _ _ _ i1 _ (fun _ => rfl)
    exact Algebra.norm_norm (a := y)
  
  set A : EllipticRootNumber.relWeil F L :=
    rec.recMap L (Units.map (EllipticRootNumber.normLM F h) x) with hA
  set W : EllipticRootNumber.relWeil F L :=
    Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) (rec.recMap L' x) with hW
  
  have hDM : ((A⁻¹ * W : EllipticRootNumber.relWeil F L) : EllipticRootNumber.AbsGal F) ∈
      M₀.fixingSubgroup := by
    rw [Subgroup.coe_mul, Subgroup.coe_inv]
    exact recMap_norm_compat F rec L L' h M₀ hLM₀ hab x
  
  have hDI : ((A⁻¹ * W : EllipticRootNumber.relWeil F L) : EllipticRootNumber.AbsGal F) ∈
      EllipticRootNumber.inertia F := by
    have hv : EllipticRootNumber.relVal F L
        ((Units.map (EllipticRootNumber.normLM F h) x : Lˣ) : L) =
          EllipticRootNumber.relVal F L' (x : L') := by
      show EllipticRootNumber.addVal F
          (Algebra.norm F (EllipticRootNumber.normLM F h (x : L'))) =
        EllipticRootNumber.addVal F (Algebra.norm F (x : L'))
      rw [normF]
    have eW : Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L) W =
        Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L') (rec.recMap L' x) :=
      rfl
    have hd : ((EllipticRootNumber.weilDegreeHom F).comp
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L))) (A⁻¹ * W) = 1 := by
      rw [MonoidHom.map_mul, MonoidHom.map_inv, MonoidHom.comp_apply, MonoidHom.comp_apply, eW,
        rec.degree_rec L' x, hA, rec.degree_rec L, hv, inv_mul_cancel]
    exact weilDegreeHom_ker_le_inertia F
      (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L) (A⁻¹ * W)) hd
  
  have hθD := hker _ hDM hDI
  rw [map_mul, map_inv, inv_mul_eq_one] at hθD
  exact hθD

theorem conj_abelianExt_transport (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (X X' K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K]
    (hX'K : X' ≤ K) (hab : EllipticRootNumber.IsAbelianExt F hX'K) (σ : EllipticRootNumber.AbsGal F)
    (hXX' : ∀ y : AlgebraicClosure F, y ∈ X' ↔ σ y ∈ X) :
    ∃ (K'' : IntermediateField F (AlgebraicClosure F)) (h : X ≤ K''),
      FiniteDimensional F K'' ∧ EllipticRootNumber.IsAbelianExt F h ∧
      (∀ g : EllipticRootNumber.AbsGal F, g ∈ K.fixingSubgroup ↔ σ * g * σ⁻¹ ∈ K''.fixingSubgroup) ∧
      (∀ y : AlgebraicClosure F, y ∈ K ↔ σ y ∈ K'') :=
by
  classical
  have hσσ : ∀ y : AlgebraicClosure F, σ (σ⁻¹ y) = y := fun y => by
    rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
  have hσσ' : ∀ y : AlgebraicClosure F, σ⁻¹ (σ y) = y := fun y => by
    rw [← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]
  set K'' : IntermediateField F (AlgebraicClosure F) :=
    IntermediateField.map (σ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) K with hK''def
  have hKK'' : ∀ y : AlgebraicClosure F, y ∈ K ↔ σ y ∈ K'' := by
    intro y
    have e : ∀ z : AlgebraicClosure F, z ∈ K'' ↔ z ∈ (K'' : Set (AlgebraicClosure F)) :=
      fun z => Iff.rfl
    rw [e, hK''def, IntermediateField.coe_map]
    constructor
    · intro hy
      exact ⟨y, hy, rfl⟩
    · rintro ⟨x, hx, hxy⟩
      have : x = y := σ.injective hxy
      rw [← this]
      exact hx
  have hXK'' : X ≤ K'' := by
    intro z hz
    have h1 : σ⁻¹ z ∈ X' := (hXX' (σ⁻¹ z)).mpr (by rw [hσσ]; exact hz)
    have h2 : σ (σ⁻¹ z) ∈ K'' := (hKK'' _).mp (hX'K h1)
    rwa [hσσ] at h2
  have conjFix : ∀ A B : IntermediateField F (AlgebraicClosure F),
      (∀ y : AlgebraicClosure F, y ∈ A ↔ σ y ∈ B) →
      ∀ g : EllipticRootNumber.AbsGal F, g ∈ A.fixingSubgroup ↔ σ * g * σ⁻¹ ∈ B.fixingSubgroup := by
    intro A B hAB g
    rw [IntermediateField.mem_fixingSubgroup_iff, IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro h y hy
      have h1 : σ⁻¹ y ∈ A := (hAB _).mpr (by rw [hσσ]; exact hy)
      rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, h (σ⁻¹ y) h1, hσσ]
    · intro h x hx
      have h1 := h (σ x) ((hAB x).mp hx)
      rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, hσσ'] at h1
      exact σ.injective h1
  have conjK := conjFix K K'' hKK''
  have conjX := conjFix X' X hXX'
  have pull : ∀ (A B : IntermediateField F (AlgebraicClosure F)),
      (∀ g : EllipticRootNumber.AbsGal F, g ∈ A.fixingSubgroup ↔ σ * g * σ⁻¹ ∈ B.fixingSubgroup) →
      ∀ a : EllipticRootNumber.AbsGal F, a ∈ B.fixingSubgroup → σ⁻¹ * a * σ ∈ A.fixingSubgroup := by
    intro A B hc a ha
    refine (hc _).mpr ?_
    have e : σ * (σ⁻¹ * a * σ) * σ⁻¹ = a := by group
    rw [e]
    exact ha
  have hsep : Algebra.IsSeparable X (IntermediateField.extendScalars hXK'') := inferInstance
  refine ⟨K'', hXK'', inferInstance, ⟨?_, ?_, hsep⟩, conjK, hKK''⟩
  · intro a ha b hb
    have h1 := hab.1 _ (pull X' X conjX a ha) _ (pull K K'' conjK b hb)
    have h2 := (conjK _).mp h1
    have e : σ * (σ⁻¹ * a * σ * (σ⁻¹ * b * σ) * (σ⁻¹ * a * σ)⁻¹) * σ⁻¹ = a * b * a⁻¹ := by group
    rwa [e] at h2
  · intro a ha b hb
    have h1 := hab.2.1 _ (pull X' X conjX a ha) _ (pull X' X conjX b hb)
    have h2 := (conjK _).mp h1
    have e : σ * (σ⁻¹ * a * σ * (σ⁻¹ * b * σ) * (σ⁻¹ * a * σ)⁻¹ * (σ⁻¹ * b * σ)⁻¹) * σ⁻¹ =
        a * b * a⁻¹ * b⁻¹ := by group
    rwa [e] at h2

theorem weilChar_conj_compat (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] (rec : EllipticRootNumber.LocalReciprocity F)
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (θ : EllipticRootNumber.relWeil F M →* (EllipticRootNumber.Ω F)ˣ)
    (hθ : EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M θ))
    (τ : EllipticRootNumber.AbsGal F) (hτW : τ ∈ EllipticRootNumber.weilGroup F)
    (hτM : ∀ y : AlgebraicClosure F, y ∈ M ↔ τ y ∈ M)
    (x x' : Mˣ) (hx : ((x' : M) : AlgebraicClosure F) = τ ((x : M) : AlgebraicClosure F))
    (w : EllipticRootNumber.relWeil F M)
    (hw : (w : EllipticRootNumber.AbsGal F) =
      τ * (rec.recMap M x : EllipticRootNumber.AbsGal F) * τ⁻¹) :
    θ (rec.recMap M x') = θ w :=
by
  classical
  have memW : ∀ (L : IntermediateField F (AlgebraicClosure F)) (g : EllipticRootNumber.AbsGal F),
      g ∈ EllipticRootNumber.relWeil F L ↔
        g ∈ EllipticRootNumber.weilGroup F ∧ g ∈ L.fixingSubgroup := by
    intro L g
    unfold EllipticRootNumber.relWeil
    exact Subgroup.mem_inf
  have hττ : ∀ y : AlgebraicClosure F, τ (τ⁻¹ y) = y := fun y => by
    rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
  have hττ' : ∀ y : AlgebraicClosure F, τ⁻¹ (τ y) = y := fun y => by
    rw [← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]
  have key : ∀ a b : Multiplicative ℤ, a⁻¹ * b * a = b := fun a b => by
    rw [mul_comm a⁻¹ b, inv_mul_cancel_right]
  
  have hmem : ∀ y : AlgebraicClosure F, y ∈ M ↔ τ⁻¹ y ∈ M := by
    intro y
    have h := hτM (τ⁻¹ y)
    rw [hττ] at h
    exact h.symm
  
  have s2 : ∀ c c' : M, (c' : AlgebraicClosure F) = τ (c : AlgebraicClosure F) →
      EllipticRootNumber.relVal F M c' = EllipticRootNumber.relVal F M c := by
    intro c c' hcc'
    let e : M ≃ₐ[F] M :=
      { toFun := fun y => ⟨τ y, (hτM y).mp y.2⟩
        invFun := fun y => ⟨τ⁻¹ y, (hmem y).mp y.2⟩
        left_inv := fun y => Subtype.ext (hττ' y)
        right_inv := fun y => Subtype.ext (hττ y)
        map_mul' := fun a b => Subtype.ext
          (map_mul τ (a : AlgebraicClosure F) (b : AlgebraicClosure F))
        map_add' := fun a b => Subtype.ext
          (map_add τ (a : AlgebraicClosure F) (b : AlgebraicClosure F))
        commutes' := fun r => Subtype.ext (τ.commutes r) }
    have hc : c' = e c := Subtype.ext hcc'
    unfold EllipticRootNumber.relVal
    rw [hc, Algebra.norm_eq_of_algEquiv]
  
  have s1 : ∀ (K K'' : IntermediateField F (AlgebraicClosure F)) (hMK : M ≤ K) (hMK'' : M ≤ K''),
      (∀ y : AlgebraicClosure F, y ∈ K ↔ τ⁻¹ y ∈ K'') →
      ∀ (z : K) (z'' : K''), (z'' : AlgebraicClosure F) = τ⁻¹ (z : AlgebraicClosure F) →
      ((EllipticRootNumber.normLM F hMK'' z'' : M) : AlgebraicClosure F) =
        τ⁻¹ ((EllipticRootNumber.normLM F hMK z : M) : AlgebraicClosure F) := by
    intro K K'' hMK hMK'' hKK'' z z'' hz
    let e₁ : M ≃+* M :=
      { toFun := fun y => ⟨τ⁻¹ y, (hmem y).mp y.2⟩
        invFun := fun y => ⟨τ y, (hτM y).mp y.2⟩
        left_inv := fun y => Subtype.ext (hττ y)
        right_inv := fun y => Subtype.ext (hττ' y)
        map_mul' := fun a c => Subtype.ext
          (map_mul τ⁻¹ (a : AlgebraicClosure F) (c : AlgebraicClosure F))
        map_add' := fun a c => Subtype.ext
          (map_add τ⁻¹ (a : AlgebraicClosure F) (c : AlgebraicClosure F)) }
    let e₂ : IntermediateField.extendScalars hMK ≃+* IntermediateField.extendScalars hMK'' :=
      { toFun := fun y => ⟨τ⁻¹ y, (IntermediateField.mem_extendScalars hMK'').mpr
            ((hKK'' y).mp ((IntermediateField.mem_extendScalars hMK).mp y.2))⟩
        invFun := fun y => ⟨τ y, (IntermediateField.mem_extendScalars hMK).mpr
            ((hKK'' _).mpr (by
              rw [hττ']
              exact (IntermediateField.mem_extendScalars hMK'').mp y.2))⟩
        left_inv := fun y => Subtype.ext (hττ y)
        right_inv := fun y => Subtype.ext (hττ' y)
        map_mul' := fun a c => Subtype.ext
          (map_mul τ⁻¹ (a : AlgebraicClosure F) (c : AlgebraicClosure F))
        map_add' := fun a c => Subtype.ext
          (map_add τ⁻¹ (a : AlgebraicClosure F) (c : AlgebraicClosure F)) }
    have he : (algebraMap M (IntermediateField.extendScalars hMK'')).comp (e₁ : M →+* M) =
        (e₂ : IntermediateField.extendScalars hMK →+* IntermediateField.extendScalars hMK'').comp
          (algebraMap M (IntermediateField.extendScalars hMK)) :=
      RingHom.ext fun y => Subtype.ext rfl
    have hn := Algebra.norm_eq_of_equiv_equiv e₁ e₂ he (EllipticRootNumber.toExtendScalars F hMK z)
    have hx2 : e₂ (EllipticRootNumber.toExtendScalars F hMK z) =
        EllipticRootNumber.toExtendScalars F hMK'' z'' := Subtype.ext hz.symm
    rw [hx2] at hn
    have hN : EllipticRootNumber.normLM F hMK z =
        e₁.symm (EllipticRootNumber.normLM F hMK'' z'') := hn
    rw [hN]
    exact (hττ' ((EllipticRootNumber.normLM F hMK'' z'' : M) : AlgebraicClosure F)).symm
  
  have conjMem : ∀ u : EllipticRootNumber.relWeil F M,
      (τ⁻¹)⁻¹ * (u : EllipticRootNumber.AbsGal F) * τ⁻¹ ∈ EllipticRootNumber.relWeil F M := by
    intro u
    have hu := (memW M _).mp u.2
    rw [inv_inv]
    refine (memW M _).mpr ⟨?_, ?_⟩
    · exact (EllipticRootNumber.weilGroup F).mul_mem
        ((EllipticRootNumber.weilGroup F).mul_mem hτW hu.1)
        ((EllipticRootNumber.weilGroup F).inv_mem hτW)
    · have hu2 := hu.2
      rw [IntermediateField.mem_fixingSubgroup_iff] at hu2 ⊢
      intro y hy
      rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, hu2 _ ((hmem y).mp hy), hττ]
  
  have conjWeil : ∀ (σ : EllipticRootNumber.AbsGal F)
      (hYZ : ∀ v : EllipticRootNumber.relWeil F M,
        σ⁻¹ * (v : EllipticRootNumber.AbsGal F) * σ ∈ EllipticRootNumber.relWeil F M)
      (θ' : EllipticRootNumber.relWeil F M →* (EllipticRootNumber.Ω F)ˣ),
      (∀ v : EllipticRootNumber.relWeil F M,
        θ' v = θ ⟨σ⁻¹ * (v : EllipticRootNumber.AbsGal F) * σ, hYZ v⟩) →
      EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M θ') := by
    intro σ hYZ θ' hθ'
    have hstab : ∀ y ∈ EllipticRootNumber.unramifiedClosure F,
        σ y ∈ EllipticRootNumber.unramifiedClosure F := by
      intro y hy
      unfold EllipticRootNumber.unramifiedClosure at hy ⊢
      induction hy using IntermediateField.adjoin_induction with
      | mem y hy =>
        apply IntermediateField.subset_adjoin
        obtain ⟨n, hn, hp, hyn⟩ := hy
        exact ⟨n, hn, hp, by rw [← map_pow, hyn, map_one]⟩
      | algebraMap c =>
        rw [AlgEquiv.commutes]
        exact IntermediateField.algebraMap_mem _ c
      | add y z _ _ hy hz =>
        rw [map_add]
        exact add_mem hy hz
      | inv y _ hy =>
        rw [map_inv₀]
        exact inv_mem hy
      | mul y z _ _ hy hz =>
        rw [map_mul]
        exact mul_mem hy hz
    have hconjI : ∀ g ∈ EllipticRootNumber.inertia F,
        σ⁻¹ * g * σ ∈ EllipticRootNumber.inertia F := by
      intro g hg
      unfold EllipticRootNumber.inertia at hg ⊢
      rw [IntermediateField.mem_fixingSubgroup_iff] at hg ⊢
      intro y hy
      rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, hg _ (hstab y hy)]
      exact σ.symm_apply_apply y
    obtain ⟨hfd, U₀, hU₀, hU₀ρ⟩ := hθ
    have hc : Continuous (fun g : EllipticRootNumber.AbsGal F => σ⁻¹ * g * σ) :=
      (continuous_mul_right σ).comp (continuous_mul_left σ⁻¹)
    have hU : (fun g : EllipticRootNumber.AbsGal F => σ⁻¹ * g * σ) ⁻¹' U₀ ∈
        nhds (1 : EllipticRootNumber.AbsGal F) := by
      apply hc.continuousAt.preimage_mem_nhds
      simpa using hU₀
    refine ⟨hfd, _, hU, fun v hvU hvI => ?_⟩
    have h1 := hU₀ρ ⟨σ⁻¹ * (v : EllipticRootNumber.AbsGal F) * σ, hYZ v⟩ hvU (hconjI _ hvI)
    show (θ' v : EllipticRootNumber.Ω F) • LinearMap.id = 1
    rw [hθ' v]
    exact h1
  let θτ : EllipticRootNumber.relWeil F M →* (EllipticRootNumber.Ω F)ˣ :=
    MonoidHom.mk' (fun u => θ ⟨(τ⁻¹)⁻¹ * (u : EllipticRootNumber.AbsGal F) * τ⁻¹, conjMem u⟩) (by
      intro a c
      show θ ⟨_, conjMem (a * c)⟩ = θ ⟨_, conjMem a⟩ * θ ⟨_, conjMem c⟩
      rw [← map_mul]
      congr 1
      apply Subtype.ext
      simp only [Subgroup.coe_mul]
      group)
  have hθτ : EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M θτ) :=
    conjWeil τ⁻¹ conjMem θτ (fun _ => rfl)
  
  have core : ∀ c c' : Mˣ, ((c' : M) : AlgebraicClosure F) = τ ((c : M) : AlgebraicClosure F) →
      EllipticRootNumber.relVal F M (c : M) ≠ 0 →
      θ (rec.recMap M c') = θτ (rec.recMap M c) := by
    intro c c' hcc' hc
    obtain ⟨N, hMN, hNfd, hNab, hNtriv⟩ := weilChar_trivial_mod_abelian_deg0 F rec M θ hθ
    haveI := hNfd
    have hv := s2 (c : M) (c' : M) hcc'
    set n : ℤ := -EllipticRootNumber.relVal F M (c : M) with hn
    have hn0 : n ≠ 0 := neg_ne_zero.mpr hc
    let r := rec.recMap M c
    let g := rec.recMap M c'
    let w₀ : EllipticRootNumber.relWeil F M :=
      ⟨(τ⁻¹)⁻¹ * (r : EllipticRootNumber.AbsGal F) * τ⁻¹, conjMem r⟩
    have hdeg' : EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F M) g) =
          Multiplicative.ofAdd n := by
      rw [rec.degree_rec M c', hv]
    have hdeg : EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F M) w₀) =
          Multiplicative.ofAdd n := by
      have e : Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F M) w₀ =
          (⟨τ⁻¹, (EllipticRootNumber.weilGroup F).inv_mem hτW⟩ : EllipticRootNumber.weilGroup F)⁻¹ *
            Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F M) r *
              ⟨τ⁻¹, (EllipticRootNumber.weilGroup F).inv_mem hτW⟩ := Subtype.ext rfl
      rw [e, map_mul, map_mul, map_inv, key, rec.degree_rec M c]
    have hfix : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K]
        (hLK : M ≤ K), EllipticRootNumber.IsAbelianExt F hLK →
        (w₀ : EllipticRootNumber.AbsGal F) ∈ K.fixingSubgroup →
        (g : EllipticRootNumber.AbsGal F) ∈ K.fixingSubgroup := by
      intro K _ hMK habK hw₀K
      obtain ⟨K'', hMK'', hK''fd, hab'', hfixiff, hKK''⟩ :=
        conj_abelianExt_transport F M M K hMK habK τ⁻¹ hmem
      haveI := hK''fd
      have hrK : (r : EllipticRootNumber.AbsGal F) ∈ K''.fixingSubgroup := by
        have h1 := (hfixiff _).mp hw₀K
        have e : τ⁻¹ * (w₀ : EllipticRootNumber.AbsGal F) * (τ⁻¹)⁻¹ = r := by
          show τ⁻¹ * ((τ⁻¹)⁻¹ * (r : EllipticRootNumber.AbsGal F) * τ⁻¹) * (τ⁻¹)⁻¹ = r
          group
        rwa [e] at h1
      obtain ⟨z, hz⟩ := (rec.ker_rec M K'' hMK'' hab'' c).mp hrK
      have hz' : τ (z : AlgebraicClosure F) ∈ K := (hKK'' _).mpr (by rw [hττ']; exact z.2)
      have ht := s1 K K'' hMK hMK'' hKK'' ⟨τ (z : AlgebraicClosure F), hz'⟩ z (hττ' _).symm
      rw [hz] at ht
      have hN : EllipticRootNumber.normLM F hMK ⟨τ (z : AlgebraicClosure F), hz'⟩ = (c' : M) := by
        apply Subtype.ext
        have h2 := congrArg (fun y => τ y) ht
        simp only [hττ] at h2
        rw [hcc', h2]
      exact (rec.ker_rec M K hMK habK c').mpr ⟨_, hN⟩
    have hRD := relWeil_eq_mod_abelian_of_degree_fix F M N hMN hNab w₀ g n hn0 hdeg hdeg' hfix
    have hdeg0 : EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F M) (w₀⁻¹ * g)) = 1 := by
      have e1 : Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F M) (w₀⁻¹ * g) =
          (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F M) w₀)⁻¹ *
            Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F M) g := Subtype.ext rfl
      rw [e1, map_mul (EllipticRootNumber.weilDegreeHom F),
        map_inv (EllipticRootNumber.weilDegreeHom F), hdeg, hdeg', inv_mul_cancel]
    have h1 := hNtriv (w₀⁻¹ * g) hRD hdeg0
    have h2 : θ g = θ w₀ * θ (w₀⁻¹ * g) := by rw [← map_mul, mul_inv_cancel_left]
    have h3 : θτ r = θ w₀ := rfl
    show θ g = θτ r
    rw [h2, h1, mul_one, h3]
  
  have hRHS : θ w = θτ (rec.recMap M x) := by
    show θ w = θ ⟨_, conjMem (rec.recMap M x)⟩
    congr 1
    apply Subtype.ext
    have e : (τ⁻¹)⁻¹ * (rec.recMap M x : EllipticRootNumber.AbsGal F) * τ⁻¹ =
        τ * (rec.recMap M x : EllipticRootNumber.AbsGal F) * τ⁻¹ := by rw [inv_inv]
    exact hw.trans e.symm
  rw [hRHS]
  by_cases hx0 : EllipticRootNumber.relVal F M (x : M) = 0
  swap
  · exact core x x' hx hx0
  
  obtain ⟨hmul, y₀, hy₀, hy₀v⟩ := relVal_mul_and_exists_ne_zero F M
  have h1 : EllipticRootNumber.relVal F M (1 : M) = 0 := by
    have := hmul 1 1 one_ne_zero one_ne_zero
    rw [one_mul] at this
    omega
  have hy₀' : τ (y₀ : AlgebraicClosure F) ∈ M := (hτM _).mp y₀.2
  have hy₀'ne : (⟨τ (y₀ : AlgebraicClosure F), hy₀'⟩ : M) ≠ 0 := by
    intro h0
    have h0' : τ (y₀ : AlgebraicClosure F) = 0 := congrArg Subtype.val h0
    rw [map_eq_zero] at h0'
    exact hy₀ (Subtype.ext h0')
  obtain ⟨u, hu0⟩ : ∃ u : Mˣ, (u : M) = y₀ := ⟨Units.mk0 y₀ hy₀, Units.val_mk0 hy₀⟩
  obtain ⟨u', hu'0⟩ : ∃ u' : Mˣ, ((u' : M) : AlgebraicClosure F) = τ (y₀ : AlgebraicClosure F) :=
    ⟨Units.mk0 _ hy₀'ne, rfl⟩
  have hinv : EllipticRootNumber.relVal F M ((u⁻¹ : Mˣ) : M) = -EllipticRootNumber.relVal F M y₀ := by
    have := hmul (u : M) _ (Units.ne_zero u) (Units.ne_zero u⁻¹)
    rw [Units.mul_inv, h1, hu0] at this
    omega
  have hxu : EllipticRootNumber.relVal F M ((x * u : Mˣ) : M) = EllipticRootNumber.relVal F M y₀ := by
    rw [Units.val_mul, hmul _ _ (Units.ne_zero x) (Units.ne_zero u), hx0, zero_add, hu0]
  have hv1 : (((x' * u' : Mˣ) : M) : AlgebraicClosure F) =
      τ (((x * u : Mˣ) : M) : AlgebraicClosure F) := by
    simp only [Units.val_mul, MulMemClass.coe_mul, map_mul, hx, hu'0, hu0]
  have hv2 : (((u'⁻¹ : Mˣ) : M) : AlgebraicClosure F) =
      τ (((u⁻¹ : Mˣ) : M) : AlgebraicClosure F) := by
    simp only [Units.val_inv_eq_inv_val, IntermediateField.coe_inv, map_inv₀, hu'0, hu0]
  have hP1 := core (x * u) (x' * u') hv1 (by rw [hxu]; exact hy₀v)
  have hP2 := core u⁻¹ u'⁻¹ hv2 (by rw [hinv]; exact neg_ne_zero.mpr hy₀v)
  have hxdec : x = (x * u) * u⁻¹ := (mul_inv_cancel_right x u).symm
  have hx'dec : x' = (x' * u') * u'⁻¹ := (mul_inv_cancel_right x' u').symm
  rw [hx'dec, weilChar_recMap_mul F rec M θ hθ, hxdec, weilChar_recMap_mul F rec M θτ hθτ, hP1, hP2]

theorem prime_galois_step_spec (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] [FiniteDimensional F M]
    (h : L ≤ M) (hab : EllipticRootNumber.IsAbelianExt F h) (ℓ : ℕ) (hℓ : ℓ.Prime)
    (hdeg : Module.finrank L (IntermediateField.extendScalars h) = ℓ) :
    (∀ σ ∈ L.fixingSubgroup, ∀ y : AlgebraicClosure F, y ∈ M ↔ σ y ∈ M) ∧
    (∀ s ∈ L.fixingSubgroup, s ∉ M.fixingSubgroup → ∀ c : M,
      (((EllipticRootNumber.normLM F h c : L) : AlgebraicClosure F)) =
        ∏ j ∈ Finset.range ℓ, (s ^ j) (c : AlgebraicClosure F)) :=
by
  classical
  haveI : IsGalois F (AlgebraicClosure F) := inferInstance
  
  have fwd : ∀ σ ∈ L.fixingSubgroup, ∀ y : AlgebraicClosure F, y ∈ M → σ y ∈ M := by
    intro σ hσ y hy
    rw [← InfiniteGalois.fixedField_fixingSubgroup M, IntermediateField.mem_fixedField_iff]
    intro k hk
    have hk' : σ⁻¹ * k * σ ∈ M.fixingSubgroup := by
      have := hab.1 σ⁻¹ (inv_mem hσ) k hk
      rwa [inv_inv] at this
    have e1 : (σ⁻¹ * k * σ) y = y := (IntermediateField.mem_fixingSubgroup_iff M _).mp hk' y hy
    have e2 : k (σ y) = σ ((σ⁻¹ * k * σ) y) := by
      rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, AlgEquiv.aut_inv, AlgEquiv.apply_symm_apply]
    rw [e2, e1]
  refine ⟨fun σ hσ y => ⟨fwd σ hσ y, fun hy => ?_⟩, ?_⟩
  · have := fwd σ⁻¹ (inv_mem hσ) (σ y) hy
    rwa [AlgEquiv.aut_inv, AlgEquiv.symm_apply_apply] at this
  intro s hsL hsM c
  
  have gal : (M.fixingSubgroup.subgroupOf L.fixingSubgroup).index = ℓ := by
    have h1 := Subgroup.relIndex_mul_index (IntermediateField.fixingSubgroup_le h)
    have hL := IntermediateField.finrank_eq_fixingSubgroup_index L
    have hM := IntermediateField.finrank_eq_fixingSubgroup_index M
    have h2 := IntermediateField.finrank_bot_mul_relfinrank h
    rw [IntermediateField.relfinrank_eq_finrank_of_le h] at h2
    have hpos : 0 < Module.finrank F M := Module.finrank_pos
    have hLpos : 0 < Module.finrank F L := by
      rcases Nat.eq_zero_or_pos (Module.finrank F L) with h0 | h0
      · rw [h0, zero_mul] at h2
        omega
      · exact h0
    rw [← hdeg]
    show M.fixingSubgroup.relIndex L.fixingSubgroup = _
    apply Nat.eq_of_mul_eq_mul_left hLpos
    rw [h2, hM, ← h1, hL, mul_comm]
  haveI hN : (M.fixingSubgroup.subgroupOf L.fixingSubgroup).Normal := ⟨fun n hn g => by
    rw [Subgroup.mem_subgroupOf] at hn ⊢
    simp only [Subgroup.coe_mul, Subgroup.coe_inv]
    exact hab.1 g g.2 n hn⟩
  have hord : ∀ k : ℕ, s ^ k ∈ M.fixingSubgroup → ℓ ∣ k := by
    intro k hk
    let s' : L.fixingSubgroup := ⟨s, hsL⟩
    have hxl : (QuotientGroup.mk s' :
        L.fixingSubgroup ⧸ (M.fixingSubgroup.subgroupOf L.fixingSubgroup)) ^ ℓ = 1 := by
      rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, ← gal]
      exact Subgroup.pow_index_mem _ s'
    have hx1 : (QuotientGroup.mk s' :
        L.fixingSubgroup ⧸ (M.fixingSubgroup.subgroupOf L.fixingSubgroup)) ≠ 1 := by
      intro hx
      rw [QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf] at hx
      exact hsM hx
    have hox : orderOf (QuotientGroup.mk s' :
        L.fixingSubgroup ⧸ (M.fixingSubgroup.subgroupOf L.fixingSubgroup)) = ℓ := by
      rcases hℓ.eq_one_or_self_of_dvd _ (orderOf_dvd_of_pow_eq_one hxl) with h1 | h1
      · exact absurd (orderOf_eq_one_iff.mp h1) hx1
      · exact h1
    rw [← hox]
    apply orderOf_dvd_of_pow_eq_one
    rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
    simpa [s'] using hk
  
  set E := IntermediateField.extendScalars h with hE
  haveI : Module.Free L E := Module.Free.of_divisionRing L E
  haveI : FiniteDimensional L E := Module.finite_of_finrank_pos (by rw [hdeg]; exact hℓ.pos)
  haveI : Algebra.IsSeparable L E := hab.2.2
  let z : E := ⟨(c : AlgebraicClosure F), (IntermediateField.mem_extendScalars h).mpr c.2⟩
  let σj : ℕ → (AlgebraicClosure F →ₐ[L] AlgebraicClosure F) := fun j =>
    { toRingHom := ((s ^ j : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) :
        AlgebraicClosure F →+* AlgebraicClosure F)
      commutes' := by
        intro r
        rw [IntermediateField.algebraMap_apply]
        exact (IntermediateField.mem_fixingSubgroup_iff L (s ^ j)).mp (pow_mem hsL j) r r.2 }
  let τ : ℕ → (E →ₐ[L] AlgebraicClosure F) := fun j => (σj j).comp E.val
  have key : ∀ i j : ℕ, i ≤ j → j < ℓ → τ i = τ j → i = j := by
    intro i j hle hj hij
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hle
    have hk : s ^ k ∈ M.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro y hy
      have := AlgHom.congr_fun hij ⟨y, (IntermediateField.mem_extendScalars h).mpr hy⟩
      change (s ^ i) y = (s ^ (i + k)) y at this
      rw [pow_add, AlgEquiv.mul_apply] at this
      exact ((s ^ i).injective this).symm
    have hk0 : k = 0 := Nat.eq_zero_of_dvd_of_lt (hord k hk) (by omega)
    omega
  have hinj : Set.InjOn τ (Finset.range ℓ : Set ℕ) := by
    intro i hi j hj hij
    simp only [Finset.coe_range, Set.mem_Iio] at hi hj
    rcases le_total i j with hle | hle
    · exact key i j hle hj hij
    · exact (key j i hle hi hij.symm).symm
  have hcard : Fintype.card (E →ₐ[L] AlgebraicClosure F) = ℓ := by
    rw [AlgHom.card L E (AlgebraicClosure F), hdeg]
  have huniv : (Finset.range ℓ).image τ = Finset.univ :=
    Finset.eq_univ_of_card _ (by rw [Finset.card_image_of_injOn hinj, Finset.card_range, hcard])
  have hnorm := Algebra.norm_eq_prod_embeddings L (AlgebraicClosure F) z
  rw [← huniv, Finset.prod_image hinj] at hnorm
  have hlhs : EllipticRootNumber.normLM F h c = Algebra.norm L z := rfl
  rw [hlhs, ← IntermediateField.algebraMap_apply, hnorm]
  rfl

theorem finrank_sup_left_eq_of_prime_galois (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    (L M K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] [FiniteDimensional F K]
    (hLM : L ≤ M) (hLK : L ≤ K) (hab : EllipticRootNumber.IsAbelianExt F hLM) (ℓ : ℕ) (hℓ : ℓ.Prime)
    (hdeg : Module.finrank L (IntermediateField.extendScalars hLM) = ℓ) (hMK : ¬ M ≤ K) :
    Module.finrank K (IntermediateField.extendScalars (le_sup_left : K ≤ K ⊔ M)) = ℓ :=
by
  classical
  
  have hstab : ∀ σ ∈ L.fixingSubgroup, ∀ y : AlgebraicClosure F, y ∈ M → σ y ∈ M := by
    intro σ hσ y hy
    rw [← InfiniteGalois.fixedField_fixingSubgroup M, IntermediateField.mem_fixedField_iff]
    intro k hk
    have hk' : σ⁻¹ * k * σ⁻¹⁻¹ ∈ M.fixingSubgroup := hab.1 σ⁻¹ (inv_mem hσ) k hk
    rw [inv_inv] at hk'
    have h1 : (σ⁻¹ * k * σ) y = y := (IntermediateField.mem_fixingSubgroup_iff _ _).mp hk' y hy
    have h2 : k (σ y) = σ ((σ⁻¹ * k * σ) y) := by
      rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, ← AlgEquiv.mul_apply σ, mul_inv_cancel,
        AlgEquiv.one_apply]
    rw [h2, h1]
  set A := IntermediateField.extendScalars hLM with hA
  set B := IntermediateField.extendScalars hLK with hB
  
  haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
  have hnormA : Normal L A := by
    rw [IntermediateField.normal_iff_forall_map_le]
    intro σ x hx
    rw [← SetLike.mem_coe, IntermediateField.coe_map] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    let τ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F :=
      AlgEquiv.ofBijective (σ.restrictScalars F) (Algebra.IsAlgebraic.algHom_bijective _)
    have hτ : τ ∈ L.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro z hz
      exact σ.commutes ⟨z, hz⟩
    have hyM : y ∈ M := (IntermediateField.mem_extendScalars hLM).mp hy
    exact (IntermediateField.mem_extendScalars hLM).mpr (hstab τ hτ y hyM)
  haveI : IsGalois L A := isGalois_iff.mpr ⟨hab.2.2, hnormA⟩
  
  have hKpos : 0 < L.relfinrank K := by
    have T1 := IntermediateField.relfinrank_mul_relfinrank (bot_le : ⊥ ≤ L) hLK
    rw [IntermediateField.relfinrank_bot_left, IntermediateField.relfinrank_bot_left] at T1
    have : 0 < Module.finrank F K := Module.finrank_pos
    rcases Nat.eq_zero_or_pos (L.relfinrank K) with h0 | h0
    · rw [h0, mul_zero] at T1; omega
    · exact h0
  have hBr : Module.finrank L B = L.relfinrank K :=
    (IntermediateField.relfinrank_eq_finrank_of_le hLK).symm
  haveI : FiniteDimensional L B := Module.finite_of_finrank_pos (hBr ▸ hKpos)
  haveI : FiniteDimensional L A := Module.finite_of_finrank_pos (hdeg ▸ hℓ.pos)
  have hAB : ¬ A ≤ B := fun h =>
    hMK ((IntermediateField.extendScalars_le_extendScalars_iff hLM hLK).mp h)
  have hbot : A ⊓ B = ⊥ := by
    have hd : Module.finrank L ↥(A ⊓ B) ∣ ℓ :=
      hdeg ▸ IntermediateField.finrank_dvd_of_le_right inf_le_left
    rcases hℓ.eq_one_or_self_of_dvd _ hd with h1 | h1
    · exact IntermediateField.finrank_eq_one_iff.mp h1
    · exfalso
      have := IntermediateField.eq_of_le_of_finrank_eq (inf_le_left : A ⊓ B ≤ A) (h1.trans hdeg.symm)
      exact hAB (inf_eq_left.mp this)
  have hLD := IntermediateField.LinearDisjoint.of_inf_eq_bot hbot
  have key := hLD.finrank_sup
  rw [hdeg, hBr, sup_comm, hA, hB, IntermediateField.extendScalars_sup hLK hLM,
    ← IntermediateField.relfinrank_eq_finrank_of_le] at key
  
  have T2 := IntermediateField.relfinrank_mul_relfinrank hLK (le_sup_left : K ≤ K ⊔ M)
  rw [key, mul_comm ℓ] at T2
  rw [← IntermediateField.relfinrank_eq_finrank_of_le]
  exact Nat.eq_of_mul_eq_mul_left hKpos T2

theorem normLM_sup_inclusion_eq (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    (L K M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K]
    [FiniteDimensional F M] (hLK : L ≤ K) (hLM : L ≤ M)
    (hdeg : Module.finrank K (IntermediateField.extendScalars (le_sup_left : K ≤ K ⊔ M)) =
      Module.finrank L (IntermediateField.extendScalars hLM))
    (y : K) :
    ((EllipticRootNumber.normLM F (le_sup_right : M ≤ K ⊔ M)
        (IntermediateField.inclusion (le_sup_left : K ≤ K ⊔ M) y) : M) : AlgebraicClosure F) =
      ((EllipticRootNumber.normLM F hLK y : L) : AlgebraicClosure F) :=
by
  have hKP : K ≤ K ⊔ M := le_sup_left
  have hMP : M ≤ K ⊔ M := le_sup_right
  
  have hb : 0 < Module.finrank F M := Module.finrank_pos
  have hKpos : 0 < Module.finrank F K := Module.finrank_pos
  have e1 := IntermediateField.relfinrank_eq_finrank_of_le hKP
  have e2 := IntermediateField.finrank_bot_mul_relfinrank hKP
  have e3 := IntermediateField.finrank_bot_mul_relfinrank hMP
  have e4 := IntermediateField.relfinrank_eq_finrank_of_le hMP
  have f1 := IntermediateField.relfinrank_eq_finrank_of_le hLK
  have f2 := IntermediateField.finrank_bot_mul_relfinrank hLK
  have g1 := IntermediateField.relfinrank_eq_finrank_of_le hLM
  have g2 := IntermediateField.finrank_bot_mul_relfinrank hLM
  have hd : K.relfinrank (K ⊔ M) = L.relfinrank M := by rw [e1, hdeg, ← g1]
  have h1 : Module.finrank M (IntermediateField.extendScalars hMP) =
      Module.finrank L (IntermediateField.extendScalars hLK) := by
    rw [← e4, ← f1]
    apply Nat.eq_of_mul_eq_mul_left hb
    rw [e3, ← e2, hd, ← g2, ← f2]
    ring
  have h0 : 0 < Module.finrank L (IntermediateField.extendScalars hLK) := by
    rw [← f1]
    apply Nat.pos_of_ne_zero
    intro hk
    rw [hk, mul_zero] at f2
    omega
  
  haveI : FiniteDimensional M (IntermediateField.extendScalars hMP) :=
    Module.finite_of_finrank_pos (h1 ▸ h0)
  haveI : FiniteDimensional L (IntermediateField.extendScalars hLK) :=
    Module.finite_of_finrank_pos h0
  haveI : CharZero M := charZero_of_injective_algebraMap (algebraMap F M).injective
  haveI : CharZero L := charZero_of_injective_algebraMap (algebraMap F L).injective
  haveI : Algebra.IsSeparable M (IntermediateField.extendScalars hMP) :=
    Algebra.IsAlgebraic.isSeparable_of_perfectField
  haveI : Algebra.IsSeparable L (IntermediateField.extendScalars hLK) :=
    Algebra.IsAlgebraic.isSeparable_of_perfectField
  
  let ι : IntermediateField.extendScalars hLK →+* IntermediateField.extendScalars hMP :=
    { toFun := fun x => ⟨x.1, (IntermediateField.mem_extendScalars hMP).mpr
        (hKP ((IntermediateField.mem_extendScalars hLK).mp x.2))⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let r : (IntermediateField.extendScalars hMP →ₐ[M] AlgebraicClosure F) →
      (IntermediateField.extendScalars hLK →ₐ[L] AlgebraicClosure F) := fun σ =>
    { σ.toRingHom.comp ι with
      commutes' := fun c => by
        have hc : (c : AlgebraicClosure F) ∈ M := hLM c.2
        have hι : ι (algebraMap L (IntermediateField.extendScalars hLK) c) =
            algebraMap M (IntermediateField.extendScalars hMP) ⟨c, hc⟩ := Subtype.ext rfl
        show σ (ι (algebraMap L (IntermediateField.extendScalars hLK) c)) = _
        rw [hι, σ.commutes]
        rfl }
  
  have hS : IntermediateField.extendScalars hMP =
      IntermediateField.adjoin M (K : Set (AlgebraicClosure F)) := by
    apply le_antisymm
    · rw [IntermediateField.extendScalars_le_iff]
      apply sup_le
      · intro x hx
        exact IntermediateField.subset_adjoin M (K : Set (AlgebraicClosure F)) hx
      · intro x hx
        exact (IntermediateField.adjoin M (K : Set (AlgebraicClosure F))).algebraMap_mem ⟨x, hx⟩
    · rw [IntermediateField.adjoin_le_iff]
      intro x hx
      exact (IntermediateField.mem_extendScalars hMP).mpr (hKP hx)
  have hinj : Function.Injective r := by
    intro σ₁ σ₂ h
    apply IntermediateField.algHom_ext_of_eq_adjoin M hS
    intro x hx
    exact DFunLike.congr_fun h ⟨x, (IntermediateField.mem_extendScalars hLK).mpr hx⟩
  have hbij : Function.Bijective r := by
    rw [Fintype.bijective_iff_injective_and_card]
    refine ⟨hinj, ?_⟩
    rw [AlgHom.card, AlgHom.card, h1]
  show algebraMap M (AlgebraicClosure F)
      (Algebra.norm M (⟨(y : AlgebraicClosure F), (IntermediateField.mem_extendScalars hMP).mpr
        (hKP y.2)⟩ : IntermediateField.extendScalars hMP)) =
    algebraMap L (AlgebraicClosure F)
      (Algebra.norm L
        (⟨(y : AlgebraicClosure F), (IntermediateField.mem_extendScalars hLK).mpr y.2⟩ :
          IntermediateField.extendScalars hLK))
  rw [Algebra.norm_eq_prod_embeddings, Algebra.norm_eq_prod_embeddings]
  exact Fintype.prod_bijective r hbij _ _ (fun σ => rfl)

theorem recMap_inclusion_pow_compat (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] (rec : EllipticRootNumber.LocalReciprocity F)
    (L L' : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    [FiniteDimensional F L'] (h : L ≤ L')
    (N : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F N] (hLN : L ≤ N)
    (hab : EllipticRootNumber.IsAbelianExt F hLN) (y : Lˣ) :
    ((rec.recMap L y : EllipticRootNumber.AbsGal F) ^
        Module.finrank L (IntermediateField.extendScalars h))⁻¹ *
      (rec.recMap L' (Units.map ((IntermediateField.inclusion h) : L →* L') y) :
        EllipticRootNumber.AbsGal F) ∈ N.fixingSubgroup ∧
    EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L')
          (rec.recMap L' (Units.map ((IntermediateField.inclusion h) : L →* L') y))) =
      EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L) (rec.recMap L y)) ^
        Module.finrank L (IntermediateField.extendScalars h) :=
by
  classical
  set d := Module.finrank L (IntermediateField.extendScalars h) with hd
  set ιy : L'ˣ := Units.map ((IntermediateField.inclusion h) : L →* L') y with hιy
  
  have hxu : Units.map (EllipticRootNumber.normLM F h) ιy = y ^ d := by
    apply Units.ext
    rw [Units.coe_map, Units.val_pow_eq_pow_val]
    show Algebra.norm L (EllipticRootNumber.toExtendScalars F h (ιy : L')) = _
    have e2 : EllipticRootNumber.toExtendScalars F h (ιy : L') =
        algebraMap L (IntermediateField.extendScalars h) (y : L) := Subtype.ext rfl
    rw [e2, Algebra.norm_algebraMap]
  
  have normF : ∀ z : L', Algebra.norm F ((EllipticRootNumber.normLM F h z : L)) =
      Algebra.norm F z := by
    intro z
    letI i1 : Algebra L L' := (IntermediateField.inclusion h).toRingHom.toAlgebra
    have e1 : Algebra.norm L z = EllipticRootNumber.normLM F h z := by
      let e : L' ≃ₐ[L] IntermediateField.extendScalars h :=
        { toFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars h).mpr y.2⟩
          invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars h).mp y.2⟩
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl
          map_mul' := fun _ _ => rfl
          map_add' := fun _ _ => rfl
          commutes' := fun _ => rfl }
      exact (Algebra.norm_eq_of_algEquiv e z)
    rw [← e1]
    haveI hT := @IsScalarTower.of_algebraMap_eq F L L' _ _ _ _ i1 _ (fun _ => rfl)
    exact Algebra.norm_norm (a := z)
  
  have memL : ∀ x : Lˣ, (rec.recMap L x : EllipticRootNumber.AbsGal F) ∈ L.fixingSubgroup :=
    fun x => (Subgroup.mem_inf.mp (rec.recMap L x).2).2
  have mr := rec.mul_rec L N hLN hab
  have rec_pow : ∀ n : ℕ, ((rec.recMap L y : EllipticRootNumber.AbsGal F) ^ n)⁻¹ *
      (rec.recMap L (y ^ n) : EllipticRootNumber.AbsGal F) ∈ N.fixingSubgroup := by
    intro n
    induction n with
    | zero =>
      have h1 := mr 1 1
      have e11 : (1 : Lˣ) * 1 = 1 := mul_one 1
      rw [e11] at h1
      simp only [Subgroup.coe_mul, Subgroup.coe_inv, inv_mul_cancel_left] at h1
      simpa using h1
    | succ n ih =>
      have hX := mr (y ^ n) y
      rw [← pow_succ] at hX
      simp only [Subgroup.coe_mul, Subgroup.coe_inv] at hX
      have hY := hab.1 _ (inv_mem (memL y)) _ ih
      rw [inv_inv] at hY
      have e : ((rec.recMap L y : EllipticRootNumber.AbsGal F) ^ (n + 1))⁻¹ *
          (rec.recMap L (y ^ (n + 1)) : EllipticRootNumber.AbsGal F) =
          ((rec.recMap L y : EllipticRootNumber.AbsGal F)⁻¹ *
            (((rec.recMap L y : EllipticRootNumber.AbsGal F) ^ n)⁻¹ *
              (rec.recMap L (y ^ n) : EllipticRootNumber.AbsGal F)) *
            (rec.recMap L y : EllipticRootNumber.AbsGal F)) *
          ((rec.recMap L (y ^ (n + 1)) : EllipticRootNumber.AbsGal F)⁻¹ *
            ((rec.recMap L (y ^ n) : EllipticRootNumber.AbsGal F) *
              (rec.recMap L y : EllipticRootNumber.AbsGal F)))⁻¹ := by
        group
      rw [e]
      exact mul_mem hY (inv_mem hX)
  refine ⟨?_, ?_⟩
  · 
    have hnc := recMap_norm_compat F rec L L' h N hLN hab ιy
    rw [hxu] at hnc
    have hp := rec_pow d
    have hm := mul_mem hp hnc
    rwa [mul_assoc, mul_inv_cancel_left] at hm
  · 
    have hmul := (relVal_mul_and_exists_ne_zero F L).1
    have hval : ∀ n : ℕ, EllipticRootNumber.relVal F L ((y : L) ^ n) =
        (n : ℤ) * EllipticRootNumber.relVal F L (y : L) := by
      intro n
      induction n with
      | zero =>
        have h0 := hmul 1 1 one_ne_zero one_ne_zero
        rw [mul_one] at h0
        simp only [pow_zero, Nat.cast_zero, zero_mul]
        linarith
      | succ n ih =>
        rw [pow_succ, hmul _ _ (pow_ne_zero n y.ne_zero) y.ne_zero, ih]
        push_cast
        ring
    have hv : EllipticRootNumber.relVal F L' (ιy : L') =
        (d : ℤ) * EllipticRootNumber.relVal F L (y : L) := by
      have e3 : EllipticRootNumber.relVal F L' (ιy : L') =
          EllipticRootNumber.relVal F L
            ((Units.map (EllipticRootNumber.normLM F h) ιy : Lˣ) : L) := by
        show EllipticRootNumber.addVal F (Algebra.norm F (ιy : L')) =
          EllipticRootNumber.addVal F (Algebra.norm F (EllipticRootNumber.normLM F h (ιy : L')))
        rw [normF]
      rw [e3, hxu, Units.val_pow_eq_pow_val, hval]
    rw [rec.degree_rec L' ιy, rec.degree_rec L y, hv, ← ofAdd_nsmul, nsmul_eq_mul]
    congr 1
    ring

theorem exists_abelian_disjoint_field (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (L M N₀ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    [FiniteDimensional F M] [FiniteDimensional F N₀] (hLM : L ≤ M) (hMN₀ : M ≤ N₀)
    (s : EllipticRootNumber.AbsGal F) (hsL : s ∈ L.fixingSubgroup) (hsM : s ∉ M.fixingSubgroup) :
    ∃ (K' B : IntermediateField F (AlgebraicClosure F)) (hLK' : L ≤ K') (hK'B : K' ≤ B),
      FiniteDimensional F K' ∧ FiniteDimensional F B ∧ N₀ ≤ B ∧
      EllipticRootNumber.IsAbelianExt F hK'B ∧ s ∈ K'.fixingSubgroup ∧ ¬ M ≤ K' :=
by
  classical
  
  let N := IntermediateField.normalClosure F N₀ (AlgebraicClosure F)
  haveI : FiniteDimensional F N := normalClosure.is_finiteDimensional F N₀ (AlgebraicClosure F)
  haveI : Normal F N := normalClosure.normal F N₀ (AlgebraicClosure F)
  have hN₀N : N₀ ≤ N := IntermediateField.le_normalClosure N₀
  have hLN : L ≤ N := hLM.trans (hMN₀.trans hN₀N)
  
  let r : EllipticRootNumber.AbsGal F →* (N ≃ₐ[F] N) := AlgEquiv.restrictNormalHom N
  have hr : ∀ (σ : EllipticRootNumber.AbsGal F) (y : N),
      ((r σ y : N) : AlgebraicClosure F) = σ y :=
    fun σ y => AlgEquiv.restrictNormalHom_apply _ σ y
  let H : Subgroup (N ≃ₐ[F] N) := Subgroup.zpowers (r s)
  let K' : IntermediateField F (AlgebraicClosure F) :=
    IntermediateField.lift (IntermediateField.fixedField H)
  have hK'N : K' ≤ N := IntermediateField.lift_le _
  haveI hK'fd : FiniteDimensional F K' :=
    FiniteDimensional.of_injective (IntermediateField.inclusion hK'N).toLinearMap
      (IntermediateField.inclusion hK'N).injective
  
  have KF : ∀ σ : EllipticRootNumber.AbsGal F, σ ∈ K'.fixingSubgroup ↔ r σ ∈ H := by
    intro σ
    conv_rhs => rw [← IntermediateField.fixingSubgroup_fixedField H]
    simp only [IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro h y hy
      apply Subtype.ext
      rw [hr]
      exact h _ ((IntermediateField.mem_lift y).mpr hy)
    · intro h z hz
      have hzN : z ∈ N := IntermediateField.lift_le _ hz
      have hy : (⟨z, hzN⟩ : N) ∈ IntermediateField.fixedField H :=
        (IntermediateField.mem_lift (⟨z, hzN⟩ : N)).mp hz
      have := congrArg Subtype.val (h _ hy)
      rw [hr] at this
      exact this
  have KF0 : ∀ σ : EllipticRootNumber.AbsGal F, r σ = 1 → σ ∈ N.fixingSubgroup := by
    intro σ h
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    have := hr σ ⟨x, hx⟩
    rw [h, AlgEquiv.one_apply] at this
    exact this.symm
  have hsK' : s ∈ K'.fixingSubgroup := (KF s).mpr (Subgroup.mem_zpowers (r s))
  
  have hLK' : L ≤ K' := by
    intro x hx
    have hxN : x ∈ N := hLN hx
    have hsx : s x = x := (IntermediateField.mem_fixingSubgroup_iff L s).mp hsL x hx
    show ((⟨x, hxN⟩ : N) : AlgebraicClosure F) ∈ K'
    rw [IntermediateField.mem_lift]
    rw [IntermediateField.mem_fixedField_iff]
    have hst : r s ∈ MulAction.stabilizer (N ≃ₐ[F] N) (⟨x, hxN⟩ : N) := by
      rw [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def]
      apply Subtype.ext
      rw [hr]
      exact hsx
    have hHst : H ≤ MulAction.stabilizer (N ≃ₐ[F] N) (⟨x, hxN⟩ : N) :=
      Subgroup.zpowers_le.mpr hst
    intro f hf
    have := MulAction.mem_stabilizer_iff.mp (hHst hf)
    rw [AlgEquiv.smul_def] at this
    exact this
  
  have hMK' : ¬ M ≤ K' := fun h => hsM (IntermediateField.fixingSubgroup_le h hsK')
  
  have hcomm : ∀ σ ∈ K'.fixingSubgroup, ∀ τ ∈ K'.fixingSubgroup,
      σ * τ * σ⁻¹ * τ⁻¹ ∈ N.fixingSubgroup := by
    intro σ hσ τ hτ
    obtain ⟨a, ha⟩ := Subgroup.mem_zpowers_iff.mp ((KF σ).mp hσ)
    obtain ⟨b, hb⟩ := Subgroup.mem_zpowers_iff.mp ((KF τ).mp hτ)
    have hc : Commute (r σ) (r τ) := by
      rw [← ha, ← hb]
      exact Commute.zpow_zpow_self (r s) a b
    apply KF0
    rw [map_mul, map_mul, map_mul, map_inv, map_inv, hc.eq]
    group
  have hab : EllipticRootNumber.IsAbelianExt F hK'N := by
    refine ⟨?_, hcomm, inferInstance⟩
    intro σ hσ τ hτ
    have hτK' : τ ∈ K'.fixingSubgroup := IntermediateField.fixingSubgroup_le hK'N hτ
    have e : σ * τ * σ⁻¹ = (σ * τ * σ⁻¹ * τ⁻¹) * τ := by group
    rw [e]
    exact mul_mem (hcomm σ hσ τ hτK') hτ
  exact ⟨K', N, hLK', hK'N, hK'fd, inferInstance, hN₀N, hab, hsK', hMK'⟩

theorem transfer_law_prime_galois (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] (rec : EllipticRootNumber.LocalReciprocity F)
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] [FiniteDimensional F M]
    (h : L ≤ M) (hab : EllipticRootNumber.IsAbelianExt F h) (ℓ : ℕ) (hℓ : ℓ.Prime)
    (hdeg : Module.finrank L (IntermediateField.extendScalars h) = ℓ)
    [((EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F L)).FiniteIndex]
    (θ : EllipticRootNumber.relWeil F M →* (EllipticRootNumber.Ω F)ˣ)
    (hθ : EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M θ)) (b : Lˣ) :
    θ (rec.recMap M (Units.map ((IntermediateField.inclusion h) : L →* M) b)) =
      (θ.comp (Subgroup.subgroupOfEquivOfLe
        (EllipticRootNumber.relWeil_antitone F h)).toMonoidHom).transfer (rec.recMap L b) :=
by
  classical
  
  have memW : ∀ (X : IntermediateField F (AlgebraicClosure F)) (g : EllipticRootNumber.AbsGal F),
      g ∈ EllipticRootNumber.relWeil F X ↔
        g ∈ EllipticRootNumber.weilGroup F ∧ g ∈ X.fixingSubgroup := by
    intro X g
    unfold EllipticRootNumber.relWeil
    exact Subgroup.mem_inf
  have hV := transfer_isWeilRep F L M h θ hθ
  set H := (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F L) with hHdef
  set ϕ := θ.comp (Subgroup.subgroupOfEquivOfLe
    (EllipticRootNumber.relWeil_antitone F h)).toMonoidHom with hϕ
  set V := ϕ.transfer with hVdef
  have hdict : ∀ x : EllipticRootNumber.relWeil F L,
      x ∈ H ↔ (x : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup := by
    intro x
    rw [hHdef, Subgroup.mem_subgroupOf, memW]
    exact ⟨fun hx => hx.2, fun hx => ⟨((memW L _).mp x.2).1, hx⟩⟩
  have hidx : H.index = ℓ := (relWeil_subgroupOf_index F rec L M h).trans hdeg
  haveI hHn : H.Normal := ⟨fun n hn g => by
    rw [hdict] at hn ⊢
    simp only [Subgroup.coe_mul, Subgroup.coe_inv]
    exact hab.1 _ ((memW L _).mp g.2).2 _ hn⟩
  obtain ⟨tW, htW⟩ : ∃ tW : EllipticRootNumber.relWeil F L, tW ∉ H := by
    by_contra hcon
    push_neg at hcon
    have htop : H = ⊤ := (Subgroup.eq_top_iff' H).mpr hcon
    rw [htop, Subgroup.index_top] at hidx
    exact hℓ.one_lt.ne hidx
  have htWeil : (tW : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.weilGroup F :=
    ((memW L _).mp tW.2).1
  have htL : (tW : EllipticRootNumber.AbsGal F) ∈ L.fixingSubgroup := ((memW L _).mp tW.2).2
  have htM : (tW : EllipticRootNumber.AbsGal F) ∉ M.fixingSubgroup :=
    fun hh => htW ((hdict tW).mpr hh)
  obtain ⟨hstab, hnorm⟩ := prime_galois_step_spec F L M h hab ℓ hℓ hdeg
  haveI hfinLM : Module.Finite L (IntermediateField.extendScalars h) :=
    Module.finite_of_finrank_pos (by rw [hdeg]; exact hℓ.pos)
  have hnorm0 : EllipticRootNumber.normLM F h 0 = 0 := by
    show Algebra.norm L (EllipticRootNumber.toExtendScalars F h 0) = 0
    rw [map_zero, Algebra.norm_zero]
  
  let ψM : Mˣ →* (EllipticRootNumber.Ω F)ˣ :=
    MonoidHom.mk' (fun v : Mˣ => θ (rec.recMap M v)) (weilChar_recMap_mul F rec M θ hθ)
  let φM : Lˣ →* (EllipticRootNumber.Ω F)ˣ :=
    ψM.comp (Units.map ((IntermediateField.inclusion h) : L →* M))
  let φL : Lˣ →* (EllipticRootNumber.Ω F)ˣ :=
    MonoidHom.mk' (fun v : Lˣ => V (rec.recMap L v)) (weilChar_recMap_mul F rec L V hV)
  
  have Znorm : ∀ c : Mˣ, φM (Units.map (EllipticRootNumber.normLM F h) c) =
      φL (Units.map (EllipticRootNumber.normLM F h) c) := by
    intro c
    have htinvL : (tW : EllipticRootNumber.AbsGal F)⁻¹ ∈ L.fixingSubgroup := inv_mem htL
    have htinvM : (tW : EllipticRootNumber.AbsGal F)⁻¹ ∉ M.fixingSubgroup := fun hh =>
      htM (by simpa using inv_mem hh)
    have hτL : ∀ j : ℕ, (tW : EllipticRootNumber.AbsGal F)⁻¹ ^ j ∈ L.fixingSubgroup :=
      fun j => pow_mem htinvL j
    have hτW : ∀ j : ℕ, (tW : EllipticRootNumber.AbsGal F)⁻¹ ^ j ∈ EllipticRootNumber.weilGroup F :=
      fun j => pow_mem (inv_mem htWeil) j
    have hcj_mem : ∀ j : ℕ,
        ((tW : EllipticRootNumber.AbsGal F)⁻¹ ^ j) ((c : M) : AlgebraicClosure F) ∈ M :=
      fun j => (hstab _ (hτL j) _).mp (c : M).2
    have hcj_ne : ∀ j : ℕ, (⟨((tW : EllipticRootNumber.AbsGal F)⁻¹ ^ j)
        ((c : M) : AlgebraicClosure F), hcj_mem j⟩ : M) ≠ 0 := by
      intro j hj
      have h0 : ((tW : EllipticRootNumber.AbsGal F)⁻¹ ^ j) ((c : M) : AlgebraicClosure F) = 0 :=
        congrArg Subtype.val hj
      rw [map_eq_zero] at h0
      exact c.ne_zero (Subtype.ext h0)
    let cj : ℕ → Mˣ := fun j => Units.mk0 ⟨((tW : EllipticRootNumber.AbsGal F)⁻¹ ^ j)
      ((c : M) : AlgebraicClosure F), hcj_mem j⟩ (hcj_ne j)
    have hprodval : Units.map ((IntermediateField.inclusion h) : L →* M)
        (Units.map (EllipticRootNumber.normLM F h) c) = ∏ j ∈ Finset.range ℓ, cj j := by
      apply Units.ext
      apply Subtype.ext
      have e1 : (((Units.map ((IntermediateField.inclusion h) : L →* M)
          (Units.map (EllipticRootNumber.normLM F h) c) : Mˣ) : M) : AlgebraicClosure F) =
          ((EllipticRootNumber.normLM F h (c : M) : L) : AlgebraicClosure F) := rfl
      have e2 : ((((∏ j ∈ Finset.range ℓ, cj j : Mˣ)) : M) : AlgebraicClosure F) =
          ∏ j ∈ Finset.range ℓ,
            ((tW : EllipticRootNumber.AbsGal F)⁻¹ ^ j) ((c : M) : AlgebraicClosure F) := by
        rw [Units.coe_prod]
        push_cast
        rfl
      rw [e1, e2]
      exact hnorm _ htinvL htinvM (c : M)
    let r : EllipticRootNumber.relWeil F M := rec.recMap M c
    have hwj : ∀ j : ℕ, (tW : EllipticRootNumber.AbsGal F)⁻¹ ^ j * (r : EllipticRootNumber.AbsGal F) *
        ((tW : EllipticRootNumber.AbsGal F)⁻¹ ^ j)⁻¹ ∈ EllipticRootNumber.relWeil F M := by
      intro j
      rw [memW]
      have hr := (memW M _).mp r.2
      exact ⟨mul_mem (mul_mem (hτW j) hr.1) (inv_mem (hτW j)), hab.1 _ (hτL j) _ hr.2⟩
    let wj : ℕ → EllipticRootNumber.relWeil F M := fun j => ⟨_, hwj j⟩
    have hC4 : ∀ j, θ (rec.recMap M (cj j)) = θ (wj j) := fun j =>
      weilChar_conj_compat F rec M θ hθ _ (hτW j) (hstab _ (hτL j)) c (cj j) rfl (wj j) rfl
    let g : EllipticRootNumber.relWeil F L :=
      Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) r
    have hg : g ∈ H := (hdict g).mpr ((memW M _).mp r.2).2
    have hcc : ∀ j : ℕ, tW⁻¹ ^ j * g * tW ^ j ∈ H := by
      intro j
      have e : (tW⁻¹ ^ j)⁻¹ = tW ^ j := by rw [inv_pow, inv_inv]
      have := hHn.conj_mem g hg (tW⁻¹ ^ j)
      rw [e] at this
      exact this
    let cc : ℕ → H := fun j => ⟨_, hcc j⟩
    have hϕcc : ∀ j, ϕ (cc j) = θ (wj j) := by
      intro j
      show θ _ = θ _
      congr 1
      apply Subtype.ext
      rw [MulEquiv.coe_toMonoidHom, Subgroup.subgroupOfEquivOfLe_apply_coe]
      show ((tW⁻¹ ^ j * g * tW ^ j : EllipticRootNumber.relWeil F L) :
          EllipticRootNumber.AbsGal F) =
        (tW : EllipticRootNumber.AbsGal F)⁻¹ ^ j * (r : EllipticRootNumber.AbsGal F) *
          ((tW : EllipticRootNumber.AbsGal F)⁻¹ ^ j)⁻¹
      simp only [Subgroup.coe_mul, SubgroupClass.coe_pow, Subgroup.coe_inv, inv_pow, inv_inv]
      rfl
    have hC1a := (transfer_prime_index_normal H ℓ hℓ hidx ϕ tW htW).1 g hg cc (fun j => rfl)
    have hC3 := weilChar_norm_compat F rec L M h V hV c
    calc φM (Units.map (EllipticRootNumber.normLM F h) c)
        = ψM (∏ j ∈ Finset.range ℓ, cj j) := by rw [← hprodval]; rfl
      _ = ∏ j ∈ Finset.range ℓ, ψM (cj j) := map_prod ψM _ _
      _ = ∏ j ∈ Finset.range ℓ, ϕ (cc j) :=
          Finset.prod_congr rfl (fun j _ => (hC4 j).trans (hϕcc j).symm)
      _ = V g := hC1a.symm
      _ = φL (Units.map (EllipticRootNumber.normLM F h) c) := hC3.symm
  
  have Znon : ∀ a : Lˣ, (rec.recMap L a : EllipticRootNumber.AbsGal F) ∉ M.fixingSubgroup →
      φM a = φL a := by
    intro a hs
    obtain ⟨N₀, hMN₀, hN₀fd, hab₀, hker⟩ := weilChar_trivial_mod_abelian_deg0 F rec M θ hθ
    haveI := hN₀fd
    have hsL : (rec.recMap L a : EllipticRootNumber.AbsGal F) ∈ L.fixingSubgroup :=
      ((memW L _).mp (rec.recMap L a).2).2
    have hsW : (rec.recMap L a : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.weilGroup F :=
      ((memW L _).mp (rec.recMap L a).2).1
    obtain ⟨K', B, hLK', hK'B, hK'fd, hBfd, hN₀B, habK', hsK', hMK'⟩ :=
      exists_abelian_disjoint_field F L M N₀ h hMN₀ _ hsL hs
    haveI := hK'fd
    haveI := hBfd
    have hBM : ∀ g, g ∈ B.fixingSubgroup → g ∈ M.fixingSubgroup := fun g hg =>
      IntermediateField.fixingSubgroup_le (hMN₀.trans hN₀B) hg
    have hBN₀ : ∀ g, g ∈ B.fixingSubgroup → g ∈ N₀.fixingSubgroup := fun g hg =>
      IntermediateField.fixingSubgroup_le hN₀B hg
    obtain ⟨y, hy⟩ := rec.surj_rec K' B hK'B habK' ⟨_, (memW K' _).mpr ⟨hsW, hsK'⟩⟩
    have hy' : (rec.recMap K' y : EllipticRootNumber.AbsGal F)⁻¹ *
        (rec.recMap L a : EllipticRootNumber.AbsGal F) ∈ B.fixingSubgroup := hy
    have heM : (rec.recMap K' y : EllipticRootNumber.AbsGal F) ∉ M.fixingSubgroup := by
      intro hh
      apply hs
      have := mul_mem hh (hBM _ hy')
      rwa [mul_inv_cancel_left] at this
    let yP : (K' ⊔ M : IntermediateField F (AlgebraicClosure F))ˣ :=
      Units.map ((IntermediateField.inclusion (le_sup_left : K' ≤ K' ⊔ M)) :
        K' →* (K' ⊔ M : IntermediateField F (AlgebraicClosure F))) y
    let a' : Lˣ := Units.map (EllipticRootNumber.normLM F hLK') y
    have hdegP := finrank_sup_left_eq_of_prime_galois F L M K' h hLK' hab ℓ hℓ hdeg hMK'
    have hC8 := normLM_sup_inclusion_eq F L K' M hLK' h (hdegP.trans hdeg.symm) (y : K')
    have hNyP : Units.map (EllipticRootNumber.normLM F (le_sup_right : M ≤ K' ⊔ M)) yP =
        Units.map ((IntermediateField.inclusion h) : L →* M) a' := by
      apply Units.ext
      apply Subtype.ext
      exact hC8
    
    have hi := weilChar_norm_compat F rec M (K' ⊔ M) le_sup_right θ hθ yP
    rw [hNyP] at hi
    
    let gK : EllipticRootNumber.relWeil F L :=
      Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F hLK') (rec.recMap K' y)
    have hgK : gK ∉ H := fun hh => heM ((hdict gK).mp hh)
    have hdmem : gK ^ ℓ ∈ H := by
      have := Subgroup.pow_index_mem H gK
      rw [hidx] at this
      exact this
    let d : H := ⟨gK ^ ℓ, hdmem⟩
    let eW : EllipticRootNumber.relWeil F M :=
      Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F h) d
    have heWcoe : (eW : EllipticRootNumber.AbsGal F) =
        (rec.recMap K' y : EllipticRootNumber.AbsGal F) ^ ℓ := by
      rw [Subgroup.subgroupOfEquivOfLe_apply_coe]
      show ((gK ^ ℓ : EllipticRootNumber.relWeil F L) : EllipticRootNumber.AbsGal F) = _
      rw [SubgroupClass.coe_pow]
      rfl
    have hC9 := recMap_inclusion_pow_compat F rec K' (K' ⊔ M) le_sup_left B hK'B habK' y
    rw [hdegP] at hC9
    obtain ⟨hC9a, hC9b⟩ := hC9
    let u : EllipticRootNumber.relWeil F M := eW⁻¹ *
      Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F (le_sup_right : M ≤ K' ⊔ M))
        (rec.recMap (K' ⊔ M) yP)
    have hucoe : (u : EllipticRootNumber.AbsGal F) =
        ((rec.recMap K' y : EllipticRootNumber.AbsGal F) ^ ℓ)⁻¹ *
          (rec.recMap (K' ⊔ M) yP : EllipticRootNumber.AbsGal F) := by
      show ((eW⁻¹ * Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F
        (le_sup_right : M ≤ K' ⊔ M)) (rec.recMap (K' ⊔ M) yP) : EllipticRootNumber.relWeil F M) :
          EllipticRootNumber.AbsGal F) = _
      rw [Subgroup.coe_mul, Subgroup.coe_inv, heWcoe, Subgroup.coe_inclusion]
    have hdegu : EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F M) u) = 1 := by
      have e1 : Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F M) u =
          (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F K') (rec.recMap K' y) ^ ℓ)⁻¹ *
            Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F (K' ⊔ M))
              (rec.recMap (K' ⊔ M) yP) := by
        apply Subtype.ext
        rw [Subgroup.coe_mul, Subgroup.coe_inv, SubgroupClass.coe_pow, Subgroup.coe_inclusion,
          Subgroup.coe_inclusion, Subgroup.coe_inclusion]
        exact hucoe
      rw [e1, map_mul, map_inv, map_pow, hC9b, inv_mul_cancel]
    have hθu : θ u = 1 := hker u (hBN₀ _ (by rw [hucoe]; exact hC9a)) hdegu
    have hii : θ (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F
        (le_sup_right : M ≤ K' ⊔ M)) (rec.recMap (K' ⊔ M) yP)) = θ eW := by
      have hm : θ u = (θ eW)⁻¹ * θ (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F
          (le_sup_right : M ≤ K' ⊔ M)) (rec.recMap (K' ⊔ M) yP)) := by
        show θ (eW⁻¹ * _) = _
        rw [map_mul, map_inv]
      rw [hθu] at hm
      exact (inv_mul_eq_one.mp hm.symm).symm
    
    have hC1b := (transfer_prime_index_normal H ℓ hℓ hidx ϕ tW htW).2 gK hgK d rfl
    have hC3' := weilChar_norm_compat F rec L K' hLK' V hV y
    have hZa' : φM a' = φL a' := by
      calc φM a' = θ (rec.recMap M (Units.map ((IntermediateField.inclusion h) : L →* M) a')) := rfl
        _ = θ eW := hi.trans hii
        _ = ϕ d := rfl
        _ = V gK := hC1b.symm
        _ = φL a' := hC3'.symm
    
    have hnc := recMap_norm_compat F rec L K' hLK' M h hab y
    have hA'A : (rec.recMap L a' : EllipticRootNumber.AbsGal F)⁻¹ *
        (rec.recMap L a : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup := by
      have := mul_mem hnc (hBM _ hy')
      rwa [mul_assoc, mul_inv_cancel_left] at this
    have hxa : a * a'⁻¹ * a' = a := inv_mul_cancel_right a a'
    have hmr := rec.mul_rec L M h hab (a * a'⁻¹) a'
    rw [hxa] at hmr
    have hmr' : (rec.recMap L a : EllipticRootNumber.AbsGal F)⁻¹ *
        ((rec.recMap L (a * a'⁻¹) : EllipticRootNumber.AbsGal F) *
          (rec.recMap L a' : EllipticRootNumber.AbsGal F)) ∈ M.fixingSubgroup := hmr
    have hAL := ((memW L _).mp (rec.recMap L a).2).2
    have hA'L := ((memW L _).mp (rec.recMap L a').2).2
    have hXM : (rec.recMap L (a * a'⁻¹) : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup := by
      have e : (rec.recMap L (a * a'⁻¹) : EllipticRootNumber.AbsGal F) =
          ((rec.recMap L a : EllipticRootNumber.AbsGal F) *
            ((rec.recMap L a : EllipticRootNumber.AbsGal F)⁻¹ *
              ((rec.recMap L (a * a'⁻¹) : EllipticRootNumber.AbsGal F) *
                (rec.recMap L a' : EllipticRootNumber.AbsGal F))) *
            (rec.recMap L a : EllipticRootNumber.AbsGal F)⁻¹) *
          ((rec.recMap L a' : EllipticRootNumber.AbsGal F) *
            ((rec.recMap L a' : EllipticRootNumber.AbsGal F)⁻¹ *
              (rec.recMap L a : EllipticRootNumber.AbsGal F)) *
            (rec.recMap L a' : EllipticRootNumber.AbsGal F)⁻¹) := by group
      rw [e]
      exact mul_mem (hab.1 _ hAL _ hmr') (hab.1 _ hA'L _ hA'A)
    obtain ⟨c₀, hc₀⟩ := (rec.ker_rec L M h hab (a * a'⁻¹)).mp hXM
    have hc₀ne : c₀ ≠ 0 := by
      rintro rfl
      rw [hnorm0] at hc₀
      exact (a * a'⁻¹).ne_zero hc₀.symm
    have hcx : Units.map (EllipticRootNumber.normLM F h) (Units.mk0 c₀ hc₀ne) = a * a'⁻¹ :=
      Units.ext hc₀
    have hZx := Znorm (Units.mk0 c₀ hc₀ne)
    rw [hcx] at hZx
    calc φM a = φM (a * a'⁻¹ * a') := by rw [hxa]
      _ = φL (a * a'⁻¹ * a') := by rw [map_mul φM, map_mul φL, hZx, hZa']
      _ = φL a := by rw [hxa]
  
  by_cases hb : (rec.recMap L b : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup
  · obtain ⟨c₀, hc₀⟩ := (rec.ker_rec L M h hab b).mp hb
    have hc₀ne : c₀ ≠ 0 := by
      rintro rfl
      rw [hnorm0] at hc₀
      exact b.ne_zero hc₀.symm
    have hcx : Units.map (EllipticRootNumber.normLM F h) (Units.mk0 c₀ hc₀ne) = b := Units.ext hc₀
    have hZ := Znorm (Units.mk0 c₀ hc₀ne)
    rw [hcx] at hZ
    exact hZ
  · exact Znon b hb

theorem transfer_subgroupOf_trans {G A : Type*} [Group G] [CommGroup A]
    (P Q R : Subgroup G) (hPQ : P ≤ Q) (hQR : Q ≤ R)
    [(P.subgroupOf R).FiniteIndex] [(P.subgroupOf Q).FiniteIndex] [(Q.subgroupOf R).FiniteIndex]
    (ϕ : P →* A) (g : R) :
    (ϕ.comp (Subgroup.subgroupOfEquivOfLe (hPQ.trans hQR)).toMonoidHom).transfer g =
      (((ϕ.comp (Subgroup.subgroupOfEquivOfLe hPQ).toMonoidHom).transfer).comp
        (Subgroup.subgroupOfEquivOfLe hQR).toMonoidHom).transfer g :=
by
  classical
  
  have s1 : ∀ (K : Subgroup G) (L : Subgroup K) [L.FiniteIndex] [Fintype (K ⧸ L)] (ψ : L →* A)
      (s : K ⧸ L → K), (∀ q, ((s q : K) : K ⧸ L) = q) → ∀ x : K,
      ∃ hmem : ∀ q, (s (x • q))⁻¹ * x * s q ∈ L,
        ψ.transfer x = ∏ q, ψ ⟨(s (x • q))⁻¹ * x * s q, hmem q⟩ := by
    intro K L _ hF ψ s hs x
    have hm : ∀ q, (s (x • q))⁻¹ * x * s q ∈ L := by
      intro q
      rw [mul_assoc]
      apply QuotientGroup.eq.mp
      have e : ((x * s q : K) : K ⧸ L) = x • ((s q : K) : K ⧸ L) :=
        (MulAction.Quotient.smul_mk L x (s q)).symm
      rw [hs, e, hs]
    refine ⟨hm, ?_⟩
    let S : L.LeftTransversal := ⟨Set.range s, Subgroup.isComplement_range_left hs⟩
    have h1 : ∀ q, ((S.2.leftQuotientEquiv q : K)) = s q :=
      Subgroup.IsComplement.leftQuotientEquiv_apply hs
    rw [MonoidHom.transfer_def ψ S x, Subgroup.leftTransversals.diff.eq_1]
    rw [show (Subgroup.fintypeQuotientOfFiniteIndex : Fintype (K ⧸ L)) = hF from
      Subsingleton.elim _ _]
    refine Fintype.prod_equiv (MulAction.toPerm x⁻¹) _ _ (fun q => ?_)
    apply congrArg ψ
    apply Subtype.ext
    simp only [MulAction.toPerm_apply]
    rw [Subgroup.smul_apply_eq_smul_apply_inv_smul x S q, h1, h1, smul_inv_smul, smul_eq_mul,
      mul_assoc]
  haveI : Finite (R ⧸ P.subgroupOf R) := Subgroup.finite_quotient_of_finiteIndex
  haveI : Finite (R ⧸ Q.subgroupOf R) := Subgroup.finite_quotient_of_finiteIndex
  haveI : Finite (Q ⧸ P.subgroupOf Q) := Subgroup.finite_quotient_of_finiteIndex
  letI : Fintype (R ⧸ P.subgroupOf R) := Fintype.ofFinite _
  letI : Fintype (R ⧸ Q.subgroupOf R) := Fintype.ofFinite _
  letI : Fintype (Q ⧸ P.subgroupOf Q) := Fintype.ofFinite _
  
  obtain ⟨s₂, hs₂⟩ : ∃ s₂ : R ⧸ Q.subgroupOf R → R, ∀ a, ((s₂ a : R) : R ⧸ Q.subgroupOf R) = a :=
    ⟨fun a => Quotient.out a, fun a => QuotientGroup.out_eq' a⟩
  obtain ⟨t, ht⟩ : ∃ t : Q ⧸ P.subgroupOf Q → Q, ∀ b, ((t b : Q) : Q ⧸ P.subgroupOf Q) = b :=
    ⟨fun b => Quotient.out b, fun b => QuotientGroup.out_eq' b⟩
  
  let f : (R ⧸ Q.subgroupOf R) × (Q ⧸ P.subgroupOf Q) → R ⧸ P.subgroupOf R :=
    fun p => ((s₂ p.1 * Subgroup.inclusion hQR (t p.2) : R) : R ⧸ P.subgroupOf R)
  have hf : ∀ a b, f (a, b) =
      ((s₂ a * Subgroup.inclusion hQR (t b) : R) : R ⧸ P.subgroupOf R) := fun _ _ => rfl
  have hinj : Function.Injective f := by
    rintro ⟨a, b⟩ ⟨a', b'⟩ h
    rw [hf, hf] at h
    have hz := Subgroup.mem_subgroupOf.mp (QuotientGroup.eq.mp h)
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, Subgroup.coe_inclusion] at hz
    have haa : ((s₂ a : R) : R ⧸ Q.subgroupOf R) = ((s₂ a' : R) : R ⧸ Q.subgroupOf R) := by
      apply QuotientGroup.eq.mpr
      rw [Subgroup.mem_subgroupOf]
      simp only [Subgroup.coe_mul, Subgroup.coe_inv]
      have e : ((s₂ a : R) : G)⁻¹ * ((s₂ a' : R) : G) =
          ((t b : Q) : G) * ((((s₂ a : R) : G) * ((t b : Q) : G))⁻¹ *
            (((s₂ a' : R) : G) * ((t b' : Q) : G))) * ((t b' : Q) : G)⁻¹ := by group
      rw [e]
      exact Q.mul_mem (Q.mul_mem (t b).2 (hPQ hz)) (Q.inv_mem (t b').2)
    rw [hs₂, hs₂] at haa
    subst haa
    have hbb : ((t b : Q) : Q ⧸ P.subgroupOf Q) = ((t b' : Q) : Q ⧸ P.subgroupOf Q) := by
      apply QuotientGroup.eq.mpr
      rw [Subgroup.mem_subgroupOf]
      simp only [Subgroup.coe_mul, Subgroup.coe_inv]
      have e : ((t b : Q) : G)⁻¹ * ((t b' : Q) : G) =
          (((s₂ a : R) : G) * ((t b : Q) : G))⁻¹ * (((s₂ a : R) : G) * ((t b' : Q) : G)) := by
        group
      rw [e]
      exact hz
    rw [ht, ht] at hbb
    rw [hbb]
  have hsurj : Function.Surjective f := by
    intro c
    obtain ⟨r, rfl⟩ := QuotientGroup.mk_surjective c
    have hy := Subgroup.mem_subgroupOf.mp (QuotientGroup.eq.mp (hs₂ (r : R ⧸ Q.subgroupOf R)))
    obtain ⟨y, hyv⟩ : ∃ y : Q, (y : G) =
        (((s₂ (r : R ⧸ Q.subgroupOf R))⁻¹ * r : R) : G) := ⟨⟨_, hy⟩, rfl⟩
    have hp := Subgroup.mem_subgroupOf.mp (QuotientGroup.eq.mp (ht (y : Q ⧸ P.subgroupOf Q)))
    refine ⟨((r : R ⧸ Q.subgroupOf R), (y : Q ⧸ P.subgroupOf Q)), ?_⟩
    rw [hf]
    apply QuotientGroup.eq.mpr
    rw [Subgroup.mem_subgroupOf]
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, Subgroup.coe_inclusion] at hp hyv ⊢
    have e : (((s₂ (r : R ⧸ Q.subgroupOf R) : R) : G) *
        ((t (y : Q ⧸ P.subgroupOf Q) : Q) : G))⁻¹ * ((r : R) : G) =
        ((t (y : Q ⧸ P.subgroupOf Q) : Q) : G)⁻¹ *
          (((s₂ (r : R ⧸ Q.subgroupOf R) : R) : G)⁻¹ * ((r : R) : G)) := by group
    rw [e, ← hyv]
    exact hp
  let E := Equiv.ofBijective f ⟨hinj, hsurj⟩
  have hE : ∀ a b, E (a, b) =
      ((s₂ a * Subgroup.inclusion hQR (t b) : R) : R ⧸ P.subgroupOf R) := fun _ _ => rfl
  
  have hEq : ∀ (a : R ⧸ Q.subgroupOf R) (b : Q ⧸ P.subgroupOf Q) (q : Q),
      (q : G) = (((s₂ (g • a))⁻¹ * g * s₂ a : R) : G) → g • E (a, b) = E (g • a, q • b) := by
    intro a b q hq
    have hm : (t (q • b))⁻¹ * (q * t b) ∈ P.subgroupOf Q := by
      apply QuotientGroup.eq.mp
      have e : ((q * t b : Q) : Q ⧸ P.subgroupOf Q) = q • ((t b : Q) : Q ⧸ P.subgroupOf Q) :=
        (MulAction.Quotient.smul_mk (P.subgroupOf Q) q (t b)).symm
      rw [ht, e, ht]
    have hm' := Subgroup.mem_subgroupOf.mp hm
    rw [hE, hE, MulAction.Quotient.smul_mk, smul_eq_mul]
    symm
    apply QuotientGroup.eq.mpr
    rw [Subgroup.mem_subgroupOf]
    simp only [Subgroup.coe_mul, Subgroup.coe_inv, Subgroup.coe_inclusion] at hm' hq ⊢
    have e : (((s₂ (g • a) : R) : G) * ((t (q • b) : Q) : G))⁻¹ *
        ((g : G) * (((s₂ a : R) : G) * ((t b : Q) : G))) =
        ((t (q • b) : Q) : G)⁻¹ * (((s₂ (g • a) : R) : G)⁻¹ * (g : G) * ((s₂ a : R) : G)) *
          ((t b : Q) : G) := by group
    rw [e, ← hq, mul_assoc]
    exact hm'
  
  obtain ⟨sec, hsecE⟩ : ∃ sec : R ⧸ P.subgroupOf R → R, ∀ a b,
      sec (E (a, b)) = s₂ a * Subgroup.inclusion hQR (t b) :=
    ⟨fun c => s₂ (E.symm c).1 * Subgroup.inclusion hQR (t (E.symm c).2), fun a b => by
      dsimp only
      rw [Equiv.symm_apply_apply]⟩
  have hsec : ∀ c, ((sec c : R) : R ⧸ P.subgroupOf R) = c := by
    intro c
    obtain ⟨⟨a, b⟩, rfl⟩ := E.surjective c
    rw [hsecE, hE]
  
  obtain ⟨hm₁, h₁⟩ := s1 R (P.subgroupOf R)
    (ϕ.comp (Subgroup.subgroupOfEquivOfLe (hPQ.trans hQR)).toMonoidHom) sec hsec g
  obtain ⟨hm₂, h₂⟩ := s1 R (Q.subgroupOf R)
    (((ϕ.comp (Subgroup.subgroupOfEquivOfLe hPQ).toMonoidHom).transfer).comp
      (Subgroup.subgroupOfEquivOfLe hQR).toMonoidHom) s₂ hs₂ g
  rw [h₁, h₂]
  rw [← Fintype.prod_equiv E
    (fun p => (ϕ.comp (Subgroup.subgroupOfEquivOfLe (hPQ.trans hQR)).toMonoidHom)
      ⟨(sec (g • E p))⁻¹ * g * sec (E p), hm₁ (E p)⟩)
    (fun c => (ϕ.comp (Subgroup.subgroupOfEquivOfLe (hPQ.trans hQR)).toMonoidHom)
      ⟨(sec (g • c))⁻¹ * g * sec c, hm₁ c⟩) (fun _ => rfl), Fintype.prod_prod_type]
  refine Fintype.prod_congr _ _ (fun a => ?_)
  set qa : Q := Subgroup.subgroupOfEquivOfLe hQR ⟨(s₂ (g • a))⁻¹ * g * s₂ a, hm₂ a⟩ with hqa
  have hq : (qa : G) = (((s₂ (g • a))⁻¹ * g * s₂ a : R) : G) :=
    Subgroup.subgroupOfEquivOfLe_apply_coe _ _
  obtain ⟨hm₃, h₃⟩ := s1 Q (P.subgroupOf Q)
    (ϕ.comp (Subgroup.subgroupOfEquivOfLe hPQ).toMonoidHom) t ht qa
  rw [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, ← hqa, h₃]
  refine Fintype.prod_congr _ _ (fun b => ?_)
  simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom]
  apply congrArg ϕ
  apply Subtype.ext
  rw [Subgroup.subgroupOfEquivOfLe_apply_coe, Subgroup.subgroupOfEquivOfLe_apply_coe]
  show ((((sec (g • E (a, b)))⁻¹ * g * sec (E (a, b)) : R) : G)) =
    ((((t (qa • b))⁻¹ * qa * t b : Q) : G))
  rw [hEq a b qa hq, hsecE, hsecE]
  simp only [Subgroup.coe_mul, Subgroup.coe_inv, Subgroup.coe_inclusion]
  rw [hq]
  simp only [Subgroup.coe_mul, Subgroup.coe_inv]
  group

theorem transfer_law_pgroup (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] (rec : EllipticRootNumber.LocalReciprocity F)
    (E X N : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F N]
    (hEX : E ≤ X) (hXN : X ≤ N)
    (hstab : ∀ (σ : EllipticRootNumber.AbsGal F) (y : AlgebraicClosure F), y ∈ N ↔ σ y ∈ N)
    (ℓ : ℕ) (hℓ : ℓ.Prime) (k : ℕ)
    (hk : (N.fixingSubgroup.subgroupOf E.fixingSubgroup).index = ℓ ^ k)
    [((EllipticRootNumber.relWeil F X).subgroupOf (EllipticRootNumber.relWeil F E)).FiniteIndex]
    (θ : EllipticRootNumber.relWeil F X →* (EllipticRootNumber.Ω F)ˣ)
    (hθ : EllipticRootNumber.IsWeilRep F X (EllipticRootNumber.charRep F X θ))
    (b : Eˣ) :
    θ (rec.recMap X (Units.map ((IntermediateField.inclusion hEX) : E →* X) b)) =
      (θ.comp (Subgroup.subgroupOfEquivOfLe
        (EllipticRootNumber.relWeil_antitone F hEX)).toMonoidHom).transfer (rec.recMap E b) :=
by
  classical
  
  have fdN : ∀ Y : IntermediateField F (AlgebraicClosure F), Y ≤ N → FiniteDimensional F Y :=
    fun Y hY => FiniteDimensional.of_injective (IntermediateField.inclusion hY).toLinearMap
      (fun a c hac => Subtype.ext (congrArg (fun z : N => (z : AlgebraicClosure F)) hac))
  
  have htop : ∀ {G : Type u} [Group G] (K : Subgroup G) [K.FiniteIndex] (hK : K = ⊤)
      (ϕ : K →* (EllipticRootNumber.Ω F)ˣ) (g : G),
      ϕ.transfer g = ϕ ⟨g, hK ▸ Subgroup.mem_top g⟩ := by
    intro G _ K _ hK ϕ g
    subst hK
    haveI hs : Subsingleton (G ⧸ (⊤ : Subgroup G)) := QuotientGroup.subsingleton_quotient_top
    haveI : Subsingleton (Quotient (MulAction.orbitRel (Subgroup.zpowers g)
        (G ⧸ (⊤ : Subgroup G)))) :=
      ⟨fun a c => Quotient.inductionOn₂ a c (fun x y => congrArg _ (Subsingleton.elim x y))⟩
    have key : ∀ (x : G) (m : ℕ), m = 1 → ∀ (h : x⁻¹ * g ^ m * x ∈ (⊤ : Subgroup G)),
        ϕ ⟨x⁻¹ * g ^ m * x, h⟩ = ϕ ⟨g, Subgroup.mem_top g⟩ := by
      intro x m hm h
      subst hm
      have e : (⟨x⁻¹ * g ^ 1 * x, h⟩ : (⊤ : Subgroup G)) =
          (⟨x, Subgroup.mem_top x⟩ : (⊤ : Subgroup G))⁻¹ * ⟨g, Subgroup.mem_top g⟩ *
            ⟨x, Subgroup.mem_top x⟩ := Subtype.ext (by simp)
      rw [e, map_mul, map_mul, map_inv, mul_comm, mul_inv_cancel_left]
    haveI : Fintype (Quotient (MulAction.orbitRel (Subgroup.zpowers g)
        (G ⧸ (⊤ : Subgroup G)))) := Fintype.ofFinite _
    rw [MonoidHom.transfer_eq_prod_quotient_orbitRel_zpowers_quot,
      Fintype.prod_subsingleton _ (Quotient.mk _ (QuotientGroup.mk 1))]
    exact key _ _ (Function.minimalPeriod_eq_one_iff_isFixedPt.mpr (Subsingleton.elim _ _)) _
  
  suffices main : ∀ (n : ℕ) (Y : IntermediateField F (AlgebraicClosure F)) (hEY : E ≤ Y)
      (hYN : Y ≤ N), Module.finrank F Y = n →
      ∀ [((EllipticRootNumber.relWeil F Y).subgroupOf (EllipticRootNumber.relWeil F E)).FiniteIndex]
        (φ : EllipticRootNumber.relWeil F Y →* (EllipticRootNumber.Ω F)ˣ),
        EllipticRootNumber.IsWeilRep F Y (EllipticRootNumber.charRep F Y φ) → ∀ (c : Eˣ),
        φ (rec.recMap Y (Units.map ((IntermediateField.inclusion hEY) : E →* Y) c)) =
          (φ.comp (Subgroup.subgroupOfEquivOfLe
            (EllipticRootNumber.relWeil_antitone F hEY)).toMonoidHom).transfer (rec.recMap E c) by
    exact main _ X hEX hXN rfl θ hθ b
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro Y hEY hYN hn _ φ hφ c
    by_cases hYE : Y = E
    · subst hYE
      have hc : Units.map ((IntermediateField.inclusion hEY) : Y →* Y) c = c := Units.ext rfl
      rw [hc, htop _ (Subgroup.subgroupOf_self _)]
      rfl
    · obtain ⟨X₁, h₁, h₂, hab, hdeg, hlt⟩ :=
        exists_prime_galois_substep F E Y N hEY hYN hstab ℓ hℓ k hk hYE
      haveI := fdN Y hYN
      haveI := fdN X₁ (h₂.trans hYN)
      have hidx := Subgroup.relIndex_mul_relIndex (EllipticRootNumber.relWeil F Y)
        (EllipticRootNumber.relWeil F X₁) (EllipticRootNumber.relWeil F E)
        (EllipticRootNumber.relWeil_antitone F h₂) (EllipticRootNumber.relWeil_antitone F h₁)
      have hne : (EllipticRootNumber.relWeil F Y).relIndex (EllipticRootNumber.relWeil F E) ≠ 0 :=
        Subgroup.FiniteIndex.index_ne_zero
      haveI : ((EllipticRootNumber.relWeil F Y).subgroupOf
          (EllipticRootNumber.relWeil F X₁)).FiniteIndex :=
        ⟨fun h0 => hne (by rw [← hidx]; exact mul_eq_zero_of_left h0 _)⟩
      haveI : ((EllipticRootNumber.relWeil F X₁).subgroupOf
          (EllipticRootNumber.relWeil F E)).FiniteIndex :=
        ⟨fun h0 => hne (by rw [← hidx]; exact mul_eq_zero_of_right _ h0)⟩
      have hθ₁ := transfer_isWeilRep F X₁ Y h₂ φ hφ
      have hc : Units.map ((IntermediateField.inclusion hEY) : E →* Y) c =
          Units.map ((IntermediateField.inclusion h₂) : X₁ →* Y)
            (Units.map ((IntermediateField.inclusion h₁) : E →* X₁) c) := Units.ext rfl
      rw [hc, transfer_law_prime_galois F rec X₁ Y h₂ hab ℓ hℓ hdeg φ hφ,
        ih _ (lt_of_lt_of_eq hlt hn) X₁ h₁ (h₂.trans hYN) rfl _ hθ₁ c]
      exact (transfer_subgroupOf_trans (EllipticRootNumber.relWeil F Y)
        (EllipticRootNumber.relWeil F X₁) (EllipticRootNumber.relWeil F E)
        (EllipticRootNumber.relWeil_antitone F h₂) (EllipticRootNumber.relWeil_antitone F h₁)
        φ (rec.recMap E c)).symm

theorem exists_sylow_normal_field (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (ℓ : ℕ) (hℓ : ℓ.Prime) :
    ∃ N E : IntermediateField F (AlgebraicClosure F), FiniteDimensional F N ∧ M ≤ N ∧
      (∀ (σ : EllipticRootNumber.AbsGal F) (y : AlgebraicClosure F), y ∈ N ↔ σ y ∈ N) ∧
      FiniteDimensional F E ∧ E ≤ N ∧
      ¬ ℓ ∣ Module.finrank (⊥ : IntermediateField F (AlgebraicClosure F))
        (IntermediateField.extendScalars
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ E)) ∧
      ∃ k : ℕ, (N.fixingSubgroup.subgroupOf E.fixingSubgroup).index = ℓ ^ k :=
by
  classical
  haveI hGal : IsGalois F (AlgebraicClosure F) := IsAlgClosure.isGalois F (AlgebraicClosure F)
  
  have s1 : ∃ N : IntermediateField F (AlgebraicClosure F), FiniteDimensional F N ∧ M ≤ N ∧
      ∀ (σ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) (y : AlgebraicClosure F),
        y ∈ N ↔ σ y ∈ N := by
    obtain ⟨N, hNdef⟩ : ∃ N : IntermediateField F (AlgebraicClosure F),
        N = IntermediateField.normalClosure F M (AlgebraicClosure F) := ⟨_, rfl⟩
    haveI hNfd : FiniteDimensional F N := by
      rw [hNdef]; exact normalClosure.is_finiteDimensional F M (AlgebraicClosure F)
    have hMN : M ≤ N := by rw [hNdef]; exact IntermediateField.le_normalClosure M
    haveI hNn : Normal F N := by rw [hNdef]; exact normalClosure.normal F M (AlgebraicClosure F)
    have claimA : ∀ (τ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) (y : AlgebraicClosure F),
        y ∈ N → τ y ∈ N := by
      intro τ y hy
      have hf := AlgHom.fieldRange_of_normal
        ((τ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F).comp N.val)
      rw [← hf]
      exact ⟨⟨y, hy⟩, rfl⟩
    refine ⟨N, hNfd, hMN, fun σ y => ⟨claimA σ y, fun h => ?_⟩⟩
    have := claimA σ.symm _ h
    simpa using this
  obtain ⟨N, hNfd, hMN, hstab⟩ := s1
  
  have s3 : N.fixingSubgroup.Normal ∧ N.fixingSubgroup.FiniteIndex := by
    refine ⟨⟨fun n hn g => ?_⟩, ⟨?_⟩⟩
    · rw [IntermediateField.mem_fixingSubgroup_iff] at hn ⊢
      intro x hx
      have h1 : g⁻¹ x ∈ N := (hstab g⁻¹ x).mp hx
      have h2 := hn _ h1
      rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, h2]
      exact AlgEquiv.apply_symm_apply g x
    · rw [← IntermediateField.finrank_eq_fixingSubgroup_index N]; exact Module.finrank_pos.ne'
  obtain ⟨hKn, hKfi⟩ := s3
  
  have idx_lemma : ∀ {G Q : Type u} [Group G] [Group Q] (K S : Subgroup G) (P : Subgroup Q)
      (n : ℕ), K ≤ S → P.index ≠ 0 → S.index = P.index → Nat.card P = ℓ ^ n →
      K.index = Nat.card Q → (K.subgroupOf S).index = ℓ ^ n := by
    intro G Q _ _ K S P n hKS hne hSidx hn hQ
    have h1 : K.relIndex S * S.index = K.index := Subgroup.relIndex_mul_index hKS
    have h2 : Nat.card P * P.index = Nat.card Q := Subgroup.card_mul_index P
    rw [hSidx, hQ, ← h2, hn] at h1
    exact Nat.eq_of_mul_eq_mul_right (Nat.pos_of_ne_zero hne) h1
  have s2 : ∃ S : Subgroup (AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F), N.fixingSubgroup ≤ S ∧
      ¬ ℓ ∣ S.index ∧ ∃ k : ℕ, (N.fixingSubgroup.subgroupOf S).index = ℓ ^ k := by
    haveI : Fact ℓ.Prime := ⟨hℓ⟩
    haveI : Finite ((AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) ⧸ N.fixingSubgroup) :=
      Subgroup.finite_quotient_of_finiteIndex
    obtain P : Sylow ℓ ((AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) ⧸ N.fixingSubgroup) :=
      Classical.choice Sylow.nonempty
    have hKS : N.fixingSubgroup ≤ (P : Subgroup ((AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) ⧸
        N.fixingSubgroup)).comap (QuotientGroup.mk' N.fixingSubgroup) := by
      intro x hx
      show (QuotientGroup.mk' N.fixingSubgroup x) ∈ (P : Subgroup
        ((AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) ⧸ N.fixingSubgroup))
      rw [QuotientGroup.mk'_apply, (QuotientGroup.eq_one_iff x).mpr hx]
      exact one_mem _
    have hSidx : ((P : Subgroup ((AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) ⧸
        N.fixingSubgroup)).comap (QuotientGroup.mk' N.fixingSubgroup)).index =
        (P : Subgroup ((AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) ⧸ N.fixingSubgroup)).index :=
      Subgroup.index_comap_of_surjective _ (QuotientGroup.mk'_surjective _)
    have hnd : ¬ ℓ ∣ (P : Subgroup ((AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) ⧸
        N.fixingSubgroup)).index := P.not_dvd_index
    have hne : (P : Subgroup ((AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) ⧸
        N.fixingSubgroup)).index ≠ 0 := Subgroup.FiniteIndex.index_ne_zero
    obtain ⟨n, hn⟩ : ∃ n : ℕ, Nat.card (P : Subgroup ((AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) ⧸
        N.fixingSubgroup)) = ℓ ^ n := IsPGroup.exists_card_eq P.isPGroup'
    have hQ : N.fixingSubgroup.index =
        Nat.card ((AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) ⧸ N.fixingSubgroup) := rfl
    refine ⟨_, hKS, ?_, n, idx_lemma _ _ _ n hKS hne hSidx hn hQ⟩
    rw [hSidx]; exact hnd
  obtain ⟨S, hKS, hndvd, k, hk⟩ := s2
  
  have s4 : ∃ E : IntermediateField F (AlgebraicClosure F), FiniteDimensional F E ∧ E ≤ N ∧
      E.fixingSubgroup = S := by
    have hopen : IsOpen (S : Set (AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F)) :=
      Subgroup.isOpen_mono hKS (IntermediateField.fixingSubgroup_isOpen N)
    have hclosed : IsClosed (S : Set (AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F)) :=
      Subgroup.isClosed_of_isOpen S hopen
    have hES : (IntermediateField.fixedField S).fixingSubgroup = S :=
      InfiniteGalois.fixingSubgroup_fixedField ⟨S, hclosed⟩
    refine ⟨IntermediateField.fixedField S, ?_, ?_, hES⟩
    · apply (InfiniteGalois.isOpen_iff_finite _).mp
      rw [hES]; exact hopen
    · have h := IntermediateField.fixedField_antitone hKS
      rw [InfiniteGalois.fixedField_fixingSubgroup N] at h
      exact h
  obtain ⟨E, hEfd, hEN, hES⟩ := s4
  
  have s5 : Module.finrank (⊥ : IntermediateField F (AlgebraicClosure F))
      (IntermediateField.extendScalars
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ E)) = Module.finrank F E := by
    haveI := Module.Free.of_divisionRing (⊥ : IntermediateField F (AlgebraicClosure F))
      (IntermediateField.extendScalars
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ E))
    have h1 := Module.finrank_mul_finrank F (⊥ : IntermediateField F (AlgebraicClosure F))
      (IntermediateField.extendScalars
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ E))
    rw [IntermediateField.finrank_bot, one_mul] at h1
    rw [h1]
    exact LinearEquiv.finrank_eq
      { toFun := fun x => ⟨x.1, (IntermediateField.mem_extendScalars _).1 x.2⟩
        invFun := fun x => ⟨x.1, (IntermediateField.mem_extendScalars _).2 x.2⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }
  
  refine ⟨N, E, hNfd, hMN, hstab, hEfd, hEN, ?_, k, ?_⟩
  · rw [s5, IntermediateField.finrank_eq_fixingSubgroup_index E, hES]
    exact hndvd
  · rw [hES]
    exact hk

theorem exists_conj_sup_fields (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (A B N : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F N]
    (hA : A ≤ N) (hB : B ≤ N)
    (hstab : ∀ (σ : EllipticRootNumber.AbsGal F) (y : AlgebraicClosure F), y ∈ N ↔ σ y ∈ N)
    (σ : EllipticRootNumber.AbsGal F) :
    ∃ X Y : IntermediateField F (AlgebraicClosure F),
      FiniteDimensional F X ∧ FiniteDimensional F Y ∧ A ≤ X ∧ X ≤ N ∧ B ≤ Y ∧
      (∀ g : EllipticRootNumber.AbsGal F, g ∈ X.fixingSubgroup ↔
        g ∈ A.fixingSubgroup ∧ σ⁻¹ * g * σ ∈ B.fixingSubgroup) ∧
      (∀ g : EllipticRootNumber.AbsGal F, g ∈ Y.fixingSubgroup ↔
        g ∈ B.fixingSubgroup ∧ σ * g * σ⁻¹ ∈ A.fixingSubgroup) ∧
      (∀ g : EllipticRootNumber.AbsGal F, g ∈ Y.fixingSubgroup ↔
        σ * g * σ⁻¹ ∈ X.fixingSubgroup) :=
by
  classical
  
  have s1 : ∀ (K : IntermediateField F (AlgebraicClosure F)) (τ g : EllipticRootNumber.AbsGal F),
      g ∈ (IntermediateField.map τ.toAlgHom K).fixingSubgroup ↔
        τ⁻¹ * g * τ ∈ K.fixingSubgroup := by
    intro K τ g
    rw [IntermediateField.mem_fixingSubgroup_iff, IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro h x hx
      have hy : τ x ∈ IntermediateField.map τ.toAlgHom K := by
        rw [← SetLike.mem_coe, IntermediateField.coe_map]
        exact ⟨x, hx, rfl⟩
      have h1 : g (τ x) = τ x := h _ hy
      show τ⁻¹ (g (τ x)) = x
      rw [h1, AlgEquiv.aut_inv, AlgEquiv.symm_apply_apply]
    · intro h y hy
      rw [← SetLike.mem_coe, IntermediateField.coe_map] at hy
      obtain ⟨x, hx, rfl⟩ := hy
      have h1 : τ⁻¹ (g (τ x)) = x := h x hx
      rw [AlgEquiv.aut_inv] at h1
      have h2 := congrArg τ h1
      rw [AlgEquiv.apply_symm_apply] at h2
      exact h2
  
  have s2 : ∀ (K : IntermediateField F (AlgebraicClosure F)) (τ : EllipticRootNumber.AbsGal F),
      K ≤ N → IntermediateField.map τ.toAlgHom K ≤ N := by
    intro K τ hK y hy
    rw [← SetLike.mem_coe, IntermediateField.coe_map] at hy
    obtain ⟨x, hx, rfl⟩ := hy
    exact (hstab τ x).mp (hK hx)
  
  have fd : ∀ Z : IntermediateField F (AlgebraicClosure F), Z ≤ N → FiniteDimensional F Z :=
    fun Z h => FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (IntermediateField.inclusion_injective h)
  set X := A ⊔ IntermediateField.map σ.toAlgHom B with hXdef
  set Y := IntermediateField.map (σ⁻¹).toAlgHom A ⊔ B with hYdef
  have hXN : X ≤ N := sup_le hA (s2 B σ hB)
  have hYN : Y ≤ N := sup_le (s2 A σ⁻¹ hA) hB
  have c1 : ∀ g : EllipticRootNumber.AbsGal F, g ∈ X.fixingSubgroup ↔
      g ∈ A.fixingSubgroup ∧ σ⁻¹ * g * σ ∈ B.fixingSubgroup := by
    intro g
    rw [hXdef, IntermediateField.fixingSubgroup_sup, Subgroup.mem_inf, s1]
  have c2 : ∀ g : EllipticRootNumber.AbsGal F, g ∈ Y.fixingSubgroup ↔
      g ∈ B.fixingSubgroup ∧ σ * g * σ⁻¹ ∈ A.fixingSubgroup := by
    intro g
    rw [hYdef, IntermediateField.fixingSubgroup_sup, Subgroup.mem_inf, s1, inv_inv, and_comm]
  have c3 : ∀ g : EllipticRootNumber.AbsGal F, g ∈ Y.fixingSubgroup ↔
      σ * g * σ⁻¹ ∈ X.fixingSubgroup := by
    intro g
    rw [c2 g, c1 (σ * g * σ⁻¹), show σ⁻¹ * (σ * g * σ⁻¹) * σ = g by group, and_comm]
  exact ⟨X, Y, fd X hXN, fd Y hYN, le_sup_left, hXN, le_sup_right, c1, c2, c3⟩

theorem transfer_restrict_mackey {G K A : Type*} [Group G] [Group K] [CommGroup A]
    (H : Subgroup G) [H.FiniteIndex] (j : K →* G) (hj : j.range.FiniteIndex) (ϕ : H →* A) :
    ∃ T : Finset G,
      (∀ (Kx : G → Subgroup K) (hKx : ∀ (x : G) (k : K), k ∈ Kx x ↔ x⁻¹ * j k * x ∈ H)
         [∀ x, (Kx x).FiniteIndex] (ϕx : ∀ x, Kx x →* A)
         (_ : ∀ (x : G) (k : Kx x), ϕx x k = ϕ ⟨x⁻¹ * j k * x, (hKx x k).mp k.2⟩) (k : K),
         ϕ.transfer (j k) = ∏ x ∈ T, (ϕx x).transfer k) ∧
      (∀ (Hx : G → Subgroup H) (_ : ∀ (x : G) (h : H), h ∈ Hx x ↔ x * h * x⁻¹ ∈ j.range),
         ∑ x ∈ T, (Hx x).index = j.range.index) :=
by
  classical
  
  have s1G : ∀ (L : Subgroup G) [L.FiniteIndex] [Fintype (G ⧸ L)] (ψ : L →* A) (s : G ⧸ L → G),
      (∀ q, ((s q : G) : G ⧸ L) = q) → ∀ g : G,
      ∃ hmem : ∀ q, (s (g • q))⁻¹ * g * s q ∈ L,
        ψ.transfer g = ∏ q, ψ ⟨(s (g • q))⁻¹ * g * s q, hmem q⟩ := by
    intro L _ hF ψ s hs g
    have hm : ∀ q, (s (g • q))⁻¹ * g * s q ∈ L := by
      intro q
      rw [mul_assoc]
      apply QuotientGroup.eq.mp
      have e : ((g * s q : G) : G ⧸ L) = g • ((s q : G) : G ⧸ L) :=
        (MulAction.Quotient.smul_mk L g (s q)).symm
      rw [hs, e, hs]
    refine ⟨hm, ?_⟩
    let S : L.LeftTransversal := ⟨Set.range s, Subgroup.isComplement_range_left hs⟩
    have h1 : ∀ q, ((S.2.leftQuotientEquiv q : G)) = s q :=
      Subgroup.IsComplement.leftQuotientEquiv_apply hs
    rw [MonoidHom.transfer_def ψ S g, Subgroup.leftTransversals.diff.eq_1]
    rw [show (Subgroup.fintypeQuotientOfFiniteIndex : Fintype (G ⧸ L)) = hF from
      Subsingleton.elim _ _]
    refine Fintype.prod_equiv (MulAction.toPerm g⁻¹) _ _ (fun q => ?_)
    apply congrArg ψ
    apply Subtype.ext
    simp only [MulAction.toPerm_apply]
    rw [Subgroup.smul_apply_eq_smul_apply_inv_smul g S q, h1, h1, smul_inv_smul, smul_eq_mul,
      mul_assoc]
  
  have s1K : ∀ (L : Subgroup K) [L.FiniteIndex] [Fintype (K ⧸ L)] (ψ : L →* A) (s : K ⧸ L → K),
      (∀ q, ((s q : K) : K ⧸ L) = q) → ∀ g : K,
      ∃ hmem : ∀ q, (s (g • q))⁻¹ * g * s q ∈ L,
        ψ.transfer g = ∏ q, ψ ⟨(s (g • q))⁻¹ * g * s q, hmem q⟩ := by
    intro L _ hF ψ s hs g
    have hm : ∀ q, (s (g • q))⁻¹ * g * s q ∈ L := by
      intro q
      rw [mul_assoc]
      apply QuotientGroup.eq.mp
      have e : ((g * s q : K) : K ⧸ L) = g • ((s q : K) : K ⧸ L) :=
        (MulAction.Quotient.smul_mk L g (s q)).symm
      rw [hs, e, hs]
    refine ⟨hm, ?_⟩
    let S : L.LeftTransversal := ⟨Set.range s, Subgroup.isComplement_range_left hs⟩
    have h1 : ∀ q, ((S.2.leftQuotientEquiv q : K)) = s q :=
      Subgroup.IsComplement.leftQuotientEquiv_apply hs
    rw [MonoidHom.transfer_def ψ S g, Subgroup.leftTransversals.diff.eq_1]
    rw [show (Subgroup.fintypeQuotientOfFiniteIndex : Fintype (K ⧸ L)) = hF from
      Subsingleton.elim _ _]
    refine Fintype.prod_equiv (MulAction.toPerm g⁻¹) _ _ (fun q => ?_)
    apply congrArg ψ
    apply Subtype.ext
    simp only [MulAction.toPerm_apply]
    rw [Subgroup.smul_apply_eq_smul_apply_inv_smul g S q, h1, h1, smul_inv_smul, smul_eq_mul,
      mul_assoc]
  
  obtain ⟨T, hcov, huniq⟩ : ∃ T : Finset G,
      (∀ g : G, ∃ x ∈ T, ∃ k : K, ∃ h ∈ H, g = j k * x * h) ∧
      (∀ x ∈ T, ∀ x' ∈ T, ∀ k : K, ∀ h ∈ H, x' = j k * x * h → x' = x) := by
    haveI hfin : Finite (G ⧸ H) := Subgroup.finite_quotient_of_finiteIndex
    haveI : Finite (MulAction.orbitRel.Quotient j.range (G ⧸ H)) := Quotient.finite _
    letI : Fintype (MulAction.orbitRel.Quotient j.range (G ⧸ H)) := Fintype.ofFinite _
    let rep : MulAction.orbitRel.Quotient j.range (G ⧸ H) → G :=
      fun ω => Quotient.out (Quotient.out ω : G ⧸ H)
    have hrep : ∀ ω, ((rep ω : G) : G ⧸ H) = Quotient.out ω := fun ω => QuotientGroup.out_eq' _
    refine ⟨Finset.univ.image rep, ?_, ?_⟩
    · intro g
      have e0 := Quotient.out_eq (Quotient.mk (MulAction.orbitRel j.range (G ⧸ H)) (g : G ⧸ H))
      have hmem : Quotient.out (Quotient.mk (MulAction.orbitRel j.range (G ⧸ H)) (g : G ⧸ H)) ∈
          MulAction.orbit j.range (g : G ⧸ H) :=
        MulAction.orbitRel_apply.mp (Quotient.exact e0)
      obtain ⟨y, hy⟩ := MulAction.mem_orbit_iff.mp hmem
      obtain ⟨k, hk⟩ := MonoidHom.mem_range.mp y.2
      have h1 : ((rep (Quotient.mk (MulAction.orbitRel j.range (G ⧸ H)) (g : G ⧸ H)) : G) :
          G ⧸ H) = (((y : G) * g : G) : G ⧸ H) := by
        rw [hrep, ← hy, Subgroup.smul_def, MulAction.Quotient.smul_mk, smul_eq_mul]
      refine ⟨rep (Quotient.mk (MulAction.orbitRel j.range (G ⧸ H)) (g : G ⧸ H)),
        Finset.mem_image_of_mem _ (Finset.mem_univ _), k⁻¹, _, QuotientGroup.eq.mp h1, ?_⟩
      rw [map_inv, hk]
      group
    · intro x hx x' hx' k h hh hx'eq
      obtain ⟨ω, -, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨ω', -, rfl⟩ := Finset.mem_image.mp hx'
      have h1 : Quotient.out ω' = (⟨j k, k, rfl⟩ : j.range) • Quotient.out ω := by
        rw [← hrep ω', ← hrep ω, Subgroup.smul_def, MulAction.Quotient.smul_mk, smul_eq_mul]
        apply QuotientGroup.eq.mpr
        show (rep ω')⁻¹ * (j k * rep ω) ∈ H
        rw [hx'eq]
        have e : (j k * rep ω * h)⁻¹ * (j k * rep ω) = h⁻¹ := by group
        rw [e]
        exact H.inv_mem hh
      have hω : ω' = ω := by
        rw [← Quotient.out_eq ω', ← Quotient.out_eq ω]
        exact Quotient.sound (MulAction.orbitRel_apply.mpr ⟨⟨j k, k, rfl⟩, h1.symm⟩)
      rw [hω]
  refine ⟨T, ?_, ?_⟩
  
  · intro Kx hKx hfi ϕx hϕx k
    haveI : Finite (G ⧸ H) := Subgroup.finite_quotient_of_finiteIndex
    letI : Fintype (G ⧸ H) := Fintype.ofFinite _
    letI : ∀ x, Fintype (K ⧸ Kx x) := fun x => Fintype.ofFinite _
    have key : ∀ (x : G) (r r' : K), (j r * x)⁻¹ * (j r' * x) = x⁻¹ * j (r⁻¹ * r') * x := by
      intro x r r'
      simp only [map_mul, map_inv]
      group
    
    obtain ⟨E, hE⟩ : ∃ E : (Σ x : T, K ⧸ Kx (x : G)) ≃ G ⧸ H,
        ∀ (x : T) (r : K), E ⟨x, (r : K ⧸ Kx (x : G))⟩ = ((j r * (x : G) : G) : G ⧸ H) := by
      let f : (Σ x : T, K ⧸ Kx (x : G)) → G ⧸ H := fun p =>
        Quotient.liftOn' p.2 (fun r => ((j r * (p.1 : G) : G) : G ⧸ H)) (fun r r' hrr => by
          apply QuotientGroup.eq.mpr
          rw [key]
          exact (hKx _ _).mp (QuotientGroup.leftRel_apply.mp hrr))
      have hf : ∀ (x : T) (r : K), f ⟨x, (r : K ⧸ Kx (x : G))⟩ =
          ((j r * (x : G) : G) : G ⧸ H) := fun _ _ => rfl
      have hinj : Function.Injective f := by
        rintro ⟨⟨x, hx⟩, c⟩ ⟨⟨x', hx'⟩, c'⟩ hcc
        obtain ⟨r, rfl⟩ := QuotientGroup.mk_surjective c
        obtain ⟨r', rfl⟩ := QuotientGroup.mk_surjective c'
        change ((j r * x : G) : G ⧸ H) = ((j r' * x' : G) : G ⧸ H) at hcc
        have hh := QuotientGroup.eq.mp hcc
        have hxx : x' = x := huniq x hx x' hx' (r'⁻¹ * r) _ hh (by
          simp only [map_mul, map_inv]
          group)
        subst hxx
        refine Sigma.ext rfl (heq_of_eq ?_)
        apply QuotientGroup.eq.mpr
        apply (hKx _ _).mpr
        rw [← key]
        exact hh
      have hsurj : Function.Surjective f := by
        intro q
        obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective q
        obtain ⟨x, hx, k', h, hh, rfl⟩ := hcov g
        refine ⟨⟨⟨x, hx⟩, (k' : K ⧸ Kx x)⟩, ?_⟩
        change ((j k' * x : G) : G ⧸ H) = ((j k' * x * h : G) : G ⧸ H)
        apply QuotientGroup.eq.mpr
        have e : (j k' * x)⁻¹ * (j k' * x * h) = h := by group
        rw [e]
        exact hh
      exact ⟨Equiv.ofBijective f ⟨hinj, hsurj⟩, hf⟩
    
    obtain ⟨sec, hsecE⟩ : ∃ sec : G ⧸ H → G, ∀ (x : T) (c : K ⧸ Kx (x : G)),
        sec (E ⟨x, c⟩) = j (Quotient.out c) * (x : G) :=
      ⟨fun q => j (Quotient.out (E.symm q).2) * ((E.symm q).1 : G), fun x c => by
        dsimp only
        rw [Equiv.symm_apply_apply]⟩
    have hsec : ∀ q : G ⧸ H, ((sec q : G) : G ⧸ H) = q := by
      intro q
      obtain ⟨⟨x, c⟩, rfl⟩ := E.surjective q
      rw [hsecE, ← hE, QuotientGroup.out_eq']
    have hequiv : ∀ (x : T) (c : K ⧸ Kx (x : G)), j k • E ⟨x, c⟩ = E ⟨x, k • c⟩ := by
      intro x c
      obtain ⟨r, rfl⟩ := QuotientGroup.mk_surjective c
      simp only [MulAction.Quotient.smul_mk, smul_eq_mul, hE, map_mul, mul_assoc]
    
    obtain ⟨hmG, hG⟩ := s1G H ϕ sec hsec (j k)
    rw [hG, ← Finset.prod_coe_sort T]
    rw [← Fintype.prod_equiv E
      (fun σ => ϕ ⟨(sec (j k • E σ))⁻¹ * j k * sec (E σ), hmG (E σ)⟩)
      (fun q => ϕ ⟨(sec (j k • q))⁻¹ * j k * sec q, hmG q⟩) (fun _ => rfl), Fintype.prod_sigma]
    refine Fintype.prod_congr _ _ (fun x => ?_)
    obtain ⟨hmK, hK⟩ := s1K (Kx x) (ϕx x) (fun c => Quotient.out c) QuotientGroup.out_eq' k
    rw [hK]
    refine Fintype.prod_congr _ _ (fun c => ?_)
    rw [hϕx]
    apply congrArg ϕ
    apply Subtype.ext
    dsimp only
    rw [hequiv, hsecE, hsecE]
    simp only [map_mul, map_inv]
    group
  
  · intro Hx hHx
    haveI : Finite (G ⧸ j.range) := Subgroup.finite_quotient_of_finiteIndex
    have key2 : ∀ (x : G) (h h' : H), ((h : G) * x⁻¹)⁻¹ * ((h' : G) * x⁻¹) =
        x * ((h⁻¹ * h' : H) : G) * x⁻¹ := by
      intro x h h'
      simp only [Subgroup.coe_mul, Subgroup.coe_inv]
      group
    let f2 : (Σ x : T, H ⧸ Hx (x : G)) → G ⧸ j.range := fun p =>
      Quotient.liftOn' p.2 (fun h => (((h : G) * (p.1 : G)⁻¹ : G) : G ⧸ j.range))
        (fun a b hab => by
          apply QuotientGroup.eq.mpr
          rw [key2]
          exact (hHx _ _).mp (QuotientGroup.leftRel_apply.mp hab))
    have hinj : Function.Injective f2 := by
      rintro ⟨⟨x, hx⟩, c⟩ ⟨⟨x', hx'⟩, c'⟩ hcc
      obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective c
      obtain ⟨h', rfl⟩ := QuotientGroup.mk_surjective c'
      change (((h : G) * x⁻¹ : G) : G ⧸ j.range) = (((h' : G) * x'⁻¹ : G) : G ⧸ j.range) at hcc
      have hh := QuotientGroup.eq.mp hcc
      obtain ⟨k, hk⟩ := MonoidHom.mem_range.mp hh
      have hxx : x' = x := huniq x hx x' hx' k⁻¹ ((h : G)⁻¹ * h')
        (H.mul_mem (H.inv_mem h.2) h'.2) (by
          rw [map_inv, hk]
          group)
      subst hxx
      refine Sigma.ext rfl (heq_of_eq ?_)
      apply QuotientGroup.eq.mpr
      apply (hHx _ _).mpr
      rw [← key2]
      exact hh
    have hsurj : Function.Surjective f2 := by
      intro q
      obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective q
      obtain ⟨x, hx, k, h, hh, hg⟩ := hcov g⁻¹
      have hg' : g = (j k * x * h)⁻¹ := by rw [← hg, inv_inv]
      subst hg'
      refine ⟨⟨⟨x, hx⟩, ((⟨h, hh⟩ : H)⁻¹ : H)⟩, ?_⟩
      change (((((⟨h, hh⟩ : H)⁻¹ : H) : G) * x⁻¹ : G) : G ⧸ j.range) = _
      apply QuotientGroup.eq.mpr
      refine MonoidHom.mem_range.mpr ⟨k⁻¹, ?_⟩
      simp only [map_inv, Subgroup.coe_inv]
      group
    haveI : Finite (Σ x : T, H ⧸ Hx (x : G)) := Finite.of_injective f2 hinj
    haveI : ∀ x : T, Finite (H ⧸ Hx (x : G)) := fun x =>
      Finite.of_injective _ (@sigma_mk_injective T (fun y => H ⧸ Hx (y : G)) x)
    rw [← Finset.sum_coe_sort T]
    show ∑ x : T, Nat.card (H ⧸ Hx (x : G)) = Nat.card (G ⧸ j.range)
    rw [← Nat.card_congr (Equiv.ofBijective f2 ⟨hinj, hsurj⟩), Nat.card_sigma]

theorem weilChar_norm_compat_base (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] (rec : EllipticRootNumber.LocalReciprocity F)
    (L L' : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    [FiniteDimensional F L'] (h : L ≤ L')
    (θ : EllipticRootNumber.relWeil F L →* (EllipticRootNumber.Ω F)ˣ)
    (hθ : EllipticRootNumber.IsWeilRep F L (EllipticRootNumber.charRep F L θ))
    (b : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
    θ (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h)
        (rec.recMap L' (Units.map ((IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ L')) :
          (⊥ : IntermediateField F (AlgebraicClosure F)) →* L') b))) =
      θ (rec.recMap L (Units.map ((IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ L)) :
          (⊥ : IntermediateField F (AlgebraicClosure F)) →* L) b)) ^
        Module.finrank L (IntermediateField.extendScalars h) :=
by
  classical
  
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : EllipticRootNumber.AbsGal F, EllipticRootNumber.ActsAsFrobPow F Φ 1 := by
    obtain ⟨-, hmul, x₀, hx1⟩ := relVal_bot_spec F
    have hx : x₀ ≠ 0 := by
      rintro rfl
      have h0 : EllipticRootNumber.relVal F ⊥
          (0 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
        unfold EllipticRootNumber.relVal
        rw [Algebra.norm_zero]
        unfold EllipticRootNumber.addVal
        simp
      rw [h0] at hx1
      exact zero_ne_one hx1
    have hinv : EllipticRootNumber.relVal F ⊥ x₀⁻¹ = -1 := by
      have h := hmul x₀ x₀⁻¹ hx (inv_ne_zero hx)
      rw [mul_inv_cancel₀ hx, hx1] at h
      have h1 := hmul 1 1 one_ne_zero one_ne_zero
      rw [mul_one] at h1
      omega
    have hd := rec.degree_rec ⊥ (Units.mk0 x₀ hx)⁻¹
    have hval : (((Units.mk0 x₀ hx)⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) = x₀⁻¹ := by
      rw [Units.val_inv_eq_inv_val, Units.val_mk0]
    rw [hval, hinv, neg_neg] at hd
    obtain ⟨hspec1, hspec2⟩ := weilDegreeHom_spec_of_localField F
    obtain ⟨n, hn⟩ := hspec1 _ (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥)
      (rec.recMap ⊥ (Units.mk0 x₀ hx)⁻¹)).2
    have hn' := hspec2 _ n hn
    rw [hd] at hn'
    have hn1 : (1 : ℤ) = n := Multiplicative.ofAdd.injective hn'
    subst hn1
    exact ⟨_, hn⟩
  
  have hdense : ∀ N : IntermediateField F (AlgebraicClosure F), FiniteDimensional F N →
      Normal F N → ∀ σ : EllipticRootNumber.AbsGal F,
        ∃ w ∈ EllipticRootNumber.weilGroup F, ∀ x ∈ N, w x = σ x := by
    intro N hN hNn σ
    haveI := hN
    haveI := hNn
    exact weilGroup_restrict_surj F Φ hΦ N σ
  
  have hθ' := hθ
  obtain ⟨-, U, hU, hUθ⟩ := hθ'
  have keyU : ∀ w : EllipticRootNumber.relWeil F L, (w : EllipticRootNumber.AbsGal F) ∈ U →
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → θ w = 1 := by
    intro w hw1 hw2
    have h1 := hUθ w hw1 hw2
    have h' := LinearMap.congr_fun h1 (ULift.up (1 : EllipticRootNumber.Ω F))
    have h'' := congrArg ULift.down h'
    apply Units.ext
    simpa [EllipticRootNumber.charRep] using h''
  
  have hHH : ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆ ≤
      EllipticRootNumber.relWeil F L := by
    rw [Subgroup.commutator_le]
    intro g₁ h₁ g₂ h₂
    rw [commutatorElement_def]
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ h₁ h₂)
      (Subgroup.inv_mem _ h₁)) (Subgroup.inv_mem _ h₂)
  have hHI : ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆ ≤
      EllipticRootNumber.inertia F := by
    rw [Subgroup.commutator_le]
    intro g₁ h₁ g₂ h₂
    have hdeg : EllipticRootNumber.weilDegreeHom F
        ⁅(⟨g₁, EllipticRootNumber.relWeil_le_weilGroup F L h₁⟩ : EllipticRootNumber.weilGroup F),
          (⟨g₂, EllipticRootNumber.relWeil_le_weilGroup F L h₂⟩ :
            EllipticRootNumber.weilGroup F)⁆ = 1 := by
      rw [map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
      exact mul_comm _ _
    exact weilDegreeHom_ker_le_inertia F _ hdeg
  have hθcomm : ∀ c ∈ ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆,
      ∀ hc : c ∈ EllipticRootNumber.relWeil F L, θ ⟨c, hc⟩ = 1 := by
    have hle : ⁅EllipticRootNumber.relWeil F L, EllipticRootNumber.relWeil F L⁆ ≤
        θ.ker.map (EllipticRootNumber.relWeil F L).subtype := by
      rw [Subgroup.commutator_le]
      intro g₁ h₁ g₂ h₂
      refine Subgroup.mem_map.mpr ⟨⁅(⟨g₁, h₁⟩ : EllipticRootNumber.relWeil F L), ⟨g₂, h₂⟩⁆, ?_, rfl⟩
      rw [MonoidHom.mem_ker, map_commutatorElement, commutatorElement_eq_one_iff_mul_comm]
      exact mul_comm _ _
    intro c hc hcH
    obtain ⟨k, hk, hkc⟩ := Subgroup.mem_map.mp (hle hc)
    have hk' : k = ⟨c, hcH⟩ := Subtype.ext hkc
    rw [← hk']
    exact hk
  
  obtain ⟨M₀, hLM₀, hM₀fin, hab, hcov⟩ := exists_abelianExt_commutator_cover F hdense L U hU
  haveI := hM₀fin
  have hker : ∀ g : EllipticRootNumber.relWeil F L,
      (g : EllipticRootNumber.AbsGal F) ∈ M₀.fixingSubgroup →
      (g : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → θ g = 1 := by
    intro g hgM hgI
    obtain ⟨c, hc, hcU⟩ := hcov _ g.2 hgM
    have hcH : c ∈ EllipticRootNumber.relWeil F L := hHH hc
    have hcI : c ∈ EllipticRootNumber.inertia F := hHI hc
    have hθc : θ ⟨c, hcH⟩ = 1 := hθcomm c hc hcH
    have hn : θ ((⟨c, hcH⟩ : EllipticRootNumber.relWeil F L)⁻¹ * g) = 1 :=
      keyU _ hcU ((EllipticRootNumber.inertia F).mul_mem
        ((EllipticRootNumber.inertia F).inv_mem hcI) hgI)
    calc θ g
        = θ ((⟨c, hcH⟩ : EllipticRootNumber.relWeil F L) *
            ((⟨c, hcH⟩ : EllipticRootNumber.relWeil F L)⁻¹ * g)) := by
          rw [mul_inv_cancel_left]
      _ = 1 := by rw [map_mul, hθc, hn, one_mul]
  
  have normF : ∀ y : L', Algebra.norm F ((EllipticRootNumber.normLM F h y : L)) =
      Algebra.norm F y := by
    intro y
    letI i1 : Algebra L L' := (IntermediateField.inclusion h).toRingHom.toAlgebra
    have e1 : Algebra.norm L y = EllipticRootNumber.normLM F h y := by
      let e : L' ≃ₐ[L] IntermediateField.extendScalars h :=
        { toFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars h).mpr y.2⟩
          invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars h).mp y.2⟩
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl
          map_mul' := fun _ _ => rfl
          map_add' := fun _ _ => rfl
          commutes' := fun _ => rfl }
      exact (Algebra.norm_eq_of_algEquiv e y)
    rw [← e1]
    haveI hT := @IsScalarTower.of_algebraMap_eq F L L' _ _ _ _ i1 _ (fun _ => rfl)
    exact Algebra.norm_norm (a := y)
  
  set x : L'ˣ := Units.map ((IntermediateField.inclusion
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ L')) :
      (⊥ : IntermediateField F (AlgebraicClosure F)) →* L') b with hx
  set u : Lˣ := Units.map ((IntermediateField.inclusion
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ L)) :
      (⊥ : IntermediateField F (AlgebraicClosure F)) →* L) b with hu
  set A : EllipticRootNumber.relWeil F L :=
    rec.recMap L (Units.map (EllipticRootNumber.normLM F h) x) with hA
  set W : EllipticRootNumber.relWeil F L :=
    Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F h) (rec.recMap L' x) with hW
  
  have hDM : ((A⁻¹ * W : EllipticRootNumber.relWeil F L) : EllipticRootNumber.AbsGal F) ∈
      M₀.fixingSubgroup := by
    rw [Subgroup.coe_mul, Subgroup.coe_inv]
    exact recMap_norm_compat F rec L L' h M₀ hLM₀ hab x
  
  have hDI : ((A⁻¹ * W : EllipticRootNumber.relWeil F L) : EllipticRootNumber.AbsGal F) ∈
      EllipticRootNumber.inertia F := by
    have hv : EllipticRootNumber.relVal F L
        ((Units.map (EllipticRootNumber.normLM F h) x : Lˣ) : L) =
          EllipticRootNumber.relVal F L' (x : L') := by
      show EllipticRootNumber.addVal F
          (Algebra.norm F (EllipticRootNumber.normLM F h (x : L'))) =
        EllipticRootNumber.addVal F (Algebra.norm F (x : L'))
      rw [normF]
    have eW : Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L) W =
        Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L') (rec.recMap L' x) :=
      rfl
    have hd : ((EllipticRootNumber.weilDegreeHom F).comp
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L))) (A⁻¹ * W) = 1 := by
      rw [MonoidHom.map_mul, MonoidHom.map_inv, MonoidHom.comp_apply, MonoidHom.comp_apply, eW,
        rec.degree_rec L' x, hA, rec.degree_rec L, hv, inv_mul_cancel]
    exact weilDegreeHom_ker_le_inertia F
      (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L) (A⁻¹ * W)) hd
  
  have hθD := hker _ hDM hDI
  rw [map_mul, map_inv, inv_mul_eq_one] at hθD
  
  have hxu : Units.map (EllipticRootNumber.normLM F h) x =
      u ^ Module.finrank L (IntermediateField.extendScalars h) := by
    apply Units.ext
    rw [Units.coe_map, Units.val_pow_eq_pow_val]
    show Algebra.norm L (EllipticRootNumber.toExtendScalars F h (x : L')) = _
    have e2 : EllipticRootNumber.toExtendScalars F h (x : L') =
        algebraMap L (IntermediateField.extendScalars h) (u : L) := Subtype.ext rfl
    rw [e2, Algebra.norm_algebraMap]
  
  let φ : Lˣ →* (EllipticRootNumber.Ω F)ˣ :=
    MonoidHom.mk' (fun v => θ (rec.recMap L v)) (weilChar_recMap_mul F rec L θ hθ)
  have hφ := map_pow φ u (Module.finrank L (IntermediateField.extendScalars h))
  rw [← hθD, hA, hxu]
  exact hφ

theorem weilChar_conj_isWeilRep (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (Y Z : IntermediateField F (AlgebraicClosure F))
    (τ : EllipticRootNumber.AbsGal F)
    (hYZ : ∀ w : EllipticRootNumber.relWeil F Y,
      τ⁻¹ * (w : EllipticRootNumber.AbsGal F) * τ ∈ EllipticRootNumber.relWeil F Z)
    (θ : EllipticRootNumber.relWeil F Z →* (EllipticRootNumber.Ω F)ˣ)
    (hθ : EllipticRootNumber.IsWeilRep F Z (EllipticRootNumber.charRep F Z θ))
    (θ' : EllipticRootNumber.relWeil F Y →* (EllipticRootNumber.Ω F)ˣ)
    (hθ' : ∀ w : EllipticRootNumber.relWeil F Y,
      θ' w = θ ⟨τ⁻¹ * (w : EllipticRootNumber.AbsGal F) * τ, hYZ w⟩) :
    EllipticRootNumber.IsWeilRep F Y (EllipticRootNumber.charRep F Y θ') :=
by
  classical
  have hstab : ∀ x ∈ EllipticRootNumber.unramifiedClosure F,
      τ x ∈ EllipticRootNumber.unramifiedClosure F := by
    intro x hx
    unfold EllipticRootNumber.unramifiedClosure at hx ⊢
    induction hx using IntermediateField.adjoin_induction with
    | mem x hx =>
      apply IntermediateField.subset_adjoin
      obtain ⟨n, hn, hp, hxn⟩ := hx
      exact ⟨n, hn, hp, by rw [← map_pow, hxn, map_one]⟩
    | algebraMap c =>
      rw [AlgEquiv.commutes]
      exact IntermediateField.algebraMap_mem _ c
    | add x y _ _ hx hy =>
      rw [map_add]
      exact add_mem hx hy
    | inv x _ hx =>
      rw [map_inv₀]
      exact inv_mem hx
    | mul x y _ _ hx hy =>
      rw [map_mul]
      exact mul_mem hx hy
  have hconjI : ∀ g ∈ EllipticRootNumber.inertia F,
      τ⁻¹ * g * τ ∈ EllipticRootNumber.inertia F := by
    intro g hg
    unfold EllipticRootNumber.inertia at hg ⊢
    rw [IntermediateField.mem_fixingSubgroup_iff] at hg ⊢
    intro x hx
    rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, hg _ (hstab x hx)]
    exact τ.symm_apply_apply x
  obtain ⟨hfd, U₀, hU₀, hU₀ρ⟩ := hθ
  have hc : Continuous (fun g : EllipticRootNumber.AbsGal F => τ⁻¹ * g * τ) :=
    (continuous_mul_right τ).comp (continuous_mul_left τ⁻¹)
  have hU : (fun g : EllipticRootNumber.AbsGal F => τ⁻¹ * g * τ) ⁻¹' U₀ ∈
      nhds (1 : EllipticRootNumber.AbsGal F) := by
    apply hc.continuousAt.preimage_mem_nhds
    simpa using hU₀
  refine ⟨hfd, _, hU, fun w hwU hwI => ?_⟩
  have h1 := hU₀ρ ⟨τ⁻¹ * (w : EllipticRootNumber.AbsGal F) * τ, hYZ w⟩ hwU (hconjI _ hwI)
  show (θ' w : EllipticRootNumber.Ω F) • LinearMap.id = 1
  rw [hθ' w]
  exact h1

theorem weilChar_conj_compat_base (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] (rec : EllipticRootNumber.LocalReciprocity F)
    (X X' M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F X]
    [FiniteDimensional F X'] [FiniteDimensional F M] (hMX' : M ≤ X')
    (σ : EllipticRootNumber.AbsGal F) (hσ : σ ∈ EllipticRootNumber.weilGroup F)
    (hXX' : ∀ g : EllipticRootNumber.AbsGal F, g ∈ X'.fixingSubgroup ↔
      σ * g * σ⁻¹ ∈ X.fixingSubgroup)
    (θ : EllipticRootNumber.relWeil F M →* (EllipticRootNumber.Ω F)ˣ)
    (hθ : EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M θ))
    (b : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ)
    (w : EllipticRootNumber.relWeil F M)
    (hw : (w : EllipticRootNumber.AbsGal F) = σ⁻¹ * (rec.recMap X (Units.map
      ((IntermediateField.inclusion
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ X)) :
        (⊥ : IntermediateField F (AlgebraicClosure F)) →* X) b) : EllipticRootNumber.AbsGal F) * σ) :
    θ (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F hMX')
        (rec.recMap X' (Units.map ((IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ X')) :
          (⊥ : IntermediateField F (AlgebraicClosure F)) →* X') b))) = θ w :=
by
  classical
  have memW : ∀ (L : IntermediateField F (AlgebraicClosure F)) (g : EllipticRootNumber.AbsGal F),
      g ∈ EllipticRootNumber.relWeil F L ↔
        g ∈ EllipticRootNumber.weilGroup F ∧ g ∈ L.fixingSubgroup := by
    intro L g
    unfold EllipticRootNumber.relWeil
    exact Subgroup.mem_inf
  have hσσ : ∀ y : AlgebraicClosure F, σ (σ⁻¹ y) = y := fun y => by
    rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
  have hσσ' : ∀ y : AlgebraicClosure F, σ⁻¹ (σ y) = y := fun y => by
    rw [← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]
  have hbotfix : ∀ (τ : EllipticRootNumber.AbsGal F)
      (y : (⊥ : IntermediateField F (AlgebraicClosure F))), τ (y : AlgebraicClosure F) = y := by
    intro τ y
    obtain ⟨c₀, hc₀⟩ := IntermediateField.mem_bot.mp y.2
    rw [← hc₀, AlgEquiv.commutes]
  have key : ∀ a b : Multiplicative ℤ, a⁻¹ * b * a = b := fun a b => by
    rw [mul_comm a⁻¹ b, inv_mul_cancel_right]
  
  have s7 : ∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
      (c : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ),
      EllipticRootNumber.relVal F L ((Units.map ((IntermediateField.inclusion
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ L)) :
        (⊥ : IntermediateField F (AlgebraicClosure F)) →* L) c : Lˣ) : L) =
      (Module.finrank F L : ℤ) *
        EllipticRootNumber.relVal F ⊥ (c : (⊥ : IntermediateField F (AlgebraicClosure F))) := by
    obtain ⟨-, hmulb, -⟩ := relVal_bot_spec F
    have hbotval : ∀ a : F, EllipticRootNumber.relVal F ⊥
        (algebraMap F (⊥ : IntermediateField F (AlgebraicClosure F)) a) =
          EllipticRootNumber.addVal F a := by
      intro a
      unfold EllipticRootNumber.relVal
      rw [Algebra.norm_algebraMap, IntermediateField.finrank_bot, pow_one]
    have haddmul : ∀ a a' : F, a ≠ 0 → a' ≠ 0 →
        EllipticRootNumber.addVal F (a * a') =
          EllipticRootNumber.addVal F a + EllipticRootNumber.addVal F a' := by
      intro a a' ha ha'
      rw [← hbotval, ← hbotval, ← hbotval, map_mul]
      exact hmulb _ _ (by simpa using ha) (by simpa using ha')
    have hadd1 : EllipticRootNumber.addVal F 1 = 0 := by
      have := haddmul 1 1 one_ne_zero one_ne_zero
      rw [one_mul] at this
      omega
    have hpow : ∀ a : F, a ≠ 0 → ∀ d : ℕ,
        EllipticRootNumber.addVal F (a ^ d) = (d : ℤ) * EllipticRootNumber.addVal F a := by
      intro a ha d
      induction d with
      | zero => rw [pow_zero, hadd1]; simp
      | succ k ih =>
        rw [pow_succ, haddmul _ _ (pow_ne_zero _ ha) ha, ih]
        push_cast
        ring
    intro L _ c
    obtain ⟨c₀, hc₀⟩ := IntermediateField.mem_bot.mp
      (c : (⊥ : IntermediateField F (AlgebraicClosure F))).2
    have e2 : (c : (⊥ : IntermediateField F (AlgebraicClosure F))) =
        algebraMap F (⊥ : IntermediateField F (AlgebraicClosure F)) c₀ := Subtype.ext hc₀.symm
    have e1 : ((Units.map ((IntermediateField.inclusion
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ L)) :
        (⊥ : IntermediateField F (AlgebraicClosure F)) →* L) c : Lˣ) : L) =
          algebraMap F L c₀ := Subtype.ext hc₀.symm
    have hc0 : c₀ ≠ 0 := fun h => Units.ne_zero c (by rw [e2, h, map_zero])
    rw [e1, e2, hbotval]
    unfold EllipticRootNumber.relVal
    rw [Algebra.norm_algebraMap, hpow c₀ hc0]
  
  let θ' : EllipticRootNumber.relWeil F X' →* (EllipticRootNumber.Ω F)ˣ :=
    θ.comp (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F hMX'))
  have hθ' : EllipticRootNumber.IsWeilRep F X' (EllipticRootNumber.charRep F X' θ') := by
    obtain ⟨U, hU, hUθ⟩ := hθ.2
    exact ⟨hθ.1, U, hU, fun v h1 h2 =>
      hUθ (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F hMX') v) h1 h2⟩
  
  have hfixY : ∀ (Y : IntermediateField F (AlgebraicClosure F)) (y : AlgebraicClosure F),
      y ∈ Y ↔ ∀ g ∈ Y.fixingSubgroup, g y = y := by
    intro Y y
    constructor
    · intro hy g hg
      rw [IntermediateField.mem_fixingSubgroup_iff] at hg
      exact hg y hy
    · intro h
      rw [← InfiniteGalois.fixedField_fixingSubgroup Y, IntermediateField.mem_fixedField_iff]
      exact h
  have hmem : ∀ y : AlgebraicClosure F, y ∈ X' ↔ σ y ∈ X := by
    intro y
    rw [hfixY X', hfixY X]
    constructor
    · intro h hh hhX
      have e : σ * (σ⁻¹ * hh * σ) * σ⁻¹ = hh := by group
      have h1 := h (σ⁻¹ * hh * σ) ((hXX' _).mpr (by rw [e]; exact hhX))
      have h2 := congrArg σ h1
      simp only [AlgEquiv.mul_apply, hσσ] at h2
      exact h2
    · intro h g hg
      have h1 := h (σ * g * σ⁻¹) ((hXX' g).mp hg)
      simp only [AlgEquiv.mul_apply, hσσ'] at h1
      exact σ.injective h1
  have hmapeq : IntermediateField.map (σ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) X' = X := by
    apply SetLike.ext'
    rw [IntermediateField.coe_map]
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact (hmem x).mp hx
    · intro hy
      exact ⟨σ⁻¹ y, (hmem _).mpr (by rw [hσσ]; exact hy), hσσ y⟩
  have hfin : Module.finrank F X' = Module.finrank F X := by
    have h := (IntermediateField.equivMap X'
      (σ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)).toLinearEquiv.finrank_eq
    rw [hmapeq] at h
    exact h
  
  have s6 : ∀ (K K'' : IntermediateField F (AlgebraicClosure F)) (hX'K : X' ≤ K) (hXK'' : X ≤ K''),
      (∀ y : AlgebraicClosure F, y ∈ K ↔ σ y ∈ K'') →
      ∀ (z : K) (z'' : K''), (z'' : AlgebraicClosure F) = σ (z : AlgebraicClosure F) →
      ((EllipticRootNumber.normLM F hXK'' z'' : X) : AlgebraicClosure F) =
        σ ((EllipticRootNumber.normLM F hX'K z : X') : AlgebraicClosure F) := by
    intro K K'' hX'K hXK'' hKK'' z z'' hz
    let e₁ : X' ≃+* X :=
      { toFun := fun y => ⟨σ y, (hmem y).mp y.2⟩
        invFun := fun y => ⟨σ⁻¹ y, (hmem _).mpr (by rw [hσσ]; exact y.2)⟩
        left_inv := fun y => Subtype.ext (hσσ' y)
        right_inv := fun y => Subtype.ext (hσσ y)
        map_mul' := fun a c => Subtype.ext
          (map_mul σ (a : AlgebraicClosure F) (c : AlgebraicClosure F))
        map_add' := fun a c => Subtype.ext
          (map_add σ (a : AlgebraicClosure F) (c : AlgebraicClosure F)) }
    let e₂ : IntermediateField.extendScalars hX'K ≃+* IntermediateField.extendScalars hXK'' :=
      { toFun := fun y => ⟨σ y, (IntermediateField.mem_extendScalars hXK'').mpr
            ((hKK'' y).mp ((IntermediateField.mem_extendScalars hX'K).mp y.2))⟩
        invFun := fun y => ⟨σ⁻¹ y, (IntermediateField.mem_extendScalars hX'K).mpr
            ((hKK'' _).mpr (by
              rw [hσσ]
              exact (IntermediateField.mem_extendScalars hXK'').mp y.2))⟩
        left_inv := fun y => Subtype.ext (hσσ' y)
        right_inv := fun y => Subtype.ext (hσσ y)
        map_mul' := fun a c => Subtype.ext
          (map_mul σ (a : AlgebraicClosure F) (c : AlgebraicClosure F))
        map_add' := fun a c => Subtype.ext
          (map_add σ (a : AlgebraicClosure F) (c : AlgebraicClosure F)) }
    have he : (algebraMap X (IntermediateField.extendScalars hXK'')).comp (e₁ : X' →+* X) =
        (e₂ : IntermediateField.extendScalars hX'K →+* IntermediateField.extendScalars hXK'').comp
          (algebraMap X' (IntermediateField.extendScalars hX'K)) :=
      RingHom.ext fun y => Subtype.ext rfl
    have hn := Algebra.norm_eq_of_equiv_equiv e₁ e₂ he (EllipticRootNumber.toExtendScalars F hX'K z)
    have hx : e₂ (EllipticRootNumber.toExtendScalars F hX'K z) =
        EllipticRootNumber.toExtendScalars F hXK'' z'' := Subtype.ext hz.symm
    rw [hx] at hn
    have hN : EllipticRootNumber.normLM F hX'K z =
        e₁.symm (EllipticRootNumber.normLM F hXK'' z'') := hn
    rw [hN]
    exact (hσσ ((EllipticRootNumber.normLM F hXK'' z'' : X) : AlgebraicClosure F)).symm
  have conjMem : ∀ u : EllipticRootNumber.relWeil F X,
      σ⁻¹ * (u : EllipticRootNumber.AbsGal F) * σ ∈ EllipticRootNumber.relWeil F X' := by
    intro u
    have hu := (memW X _).mp u.2
    refine (memW X' _).mpr ⟨?_, ?_⟩
    · exact (EllipticRootNumber.weilGroup F).mul_mem
        ((EllipticRootNumber.weilGroup F).mul_mem
          ((EllipticRootNumber.weilGroup F).inv_mem hσ) hu.1) hσ
    · rw [hXX']
      have e : σ * (σ⁻¹ * (u : EllipticRootNumber.AbsGal F) * σ) * σ⁻¹ = u := by group
      rw [e]
      exact hu.2
  let θσ : EllipticRootNumber.relWeil F X →* (EllipticRootNumber.Ω F)ˣ :=
    MonoidHom.mk' (fun u => θ' ⟨σ⁻¹ * (u : EllipticRootNumber.AbsGal F) * σ, conjMem u⟩) (by
      intro a c
      show θ' ⟨_, conjMem (a * c)⟩ = θ' ⟨_, conjMem a⟩ * θ' ⟨_, conjMem c⟩
      rw [← map_mul]
      congr 1
      apply Subtype.ext
      simp only [Subgroup.coe_mul]
      group)
  have hθσ : EllipticRootNumber.IsWeilRep F X (EllipticRootNumber.charRep F X θσ) :=
    weilChar_conj_isWeilRep F X X' σ conjMem θ' hθ' θσ (fun _ => rfl)
  
  have core : ∀ c : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ,
      EllipticRootNumber.relVal F ⊥ (c : (⊥ : IntermediateField F (AlgebraicClosure F))) ≠ 0 →
      θ' (rec.recMap X' (Units.map ((IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ X')) :
          (⊥ : IntermediateField F (AlgebraicClosure F)) →* X') c)) =
        θσ (rec.recMap X (Units.map ((IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ X)) :
          (⊥ : IntermediateField F (AlgebraicClosure F)) →* X) c)) := by
    intro c hc
    obtain ⟨N, hX'N, hNfd, hNab, hNtriv⟩ := weilChar_trivial_mod_abelian_deg0 F rec X' θ' hθ'
    haveI := hNfd
    have hRX' := s7 X' c
    have hRX := s7 X c
    rw [hfin] at hRX'
    have hRne : (Module.finrank F X : ℤ) *
        EllipticRootNumber.relVal F ⊥ (c : (⊥ : IntermediateField F (AlgebraicClosure F))) ≠ 0 :=
      mul_ne_zero (Nat.cast_ne_zero.mpr Module.finrank_pos.ne') hc
    set cX' := (Units.map ((IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ X')) :
          (⊥ : IntermediateField F (AlgebraicClosure F)) →* X') c) with hcX'
    set cX := (Units.map ((IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ X)) :
          (⊥ : IntermediateField F (AlgebraicClosure F)) →* X) c) with hcX
    set n : ℤ := -((Module.finrank F X : ℤ) *
        EllipticRootNumber.relVal F ⊥ (c : (⊥ : IntermediateField F (AlgebraicClosure F))))
      with hn
    have hn0 : n ≠ 0 := neg_ne_zero.mpr hRne
    let r := rec.recMap X cX
    let g := rec.recMap X' cX'
    let w₀ : EllipticRootNumber.relWeil F X' :=
      ⟨σ⁻¹ * (r : EllipticRootNumber.AbsGal F) * σ, conjMem r⟩
    have hdeg' : EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F X') g) =
          Multiplicative.ofAdd n := by
      rw [rec.degree_rec X' cX', hRX']
    have hdeg : EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F X') w₀) =
          Multiplicative.ofAdd n := by
      have e : Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F X') w₀ =
          (⟨σ, hσ⟩ : EllipticRootNumber.weilGroup F)⁻¹ *
            Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F X) r *
              ⟨σ, hσ⟩ := Subtype.ext rfl
      rw [e, map_mul, map_mul, map_inv, key, rec.degree_rec X cX, hRX]
    have hfix : ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K]
        (hLK : X' ≤ K), EllipticRootNumber.IsAbelianExt F hLK →
        (w₀ : EllipticRootNumber.AbsGal F) ∈ K.fixingSubgroup →
        (g : EllipticRootNumber.AbsGal F) ∈ K.fixingSubgroup := by
      intro K _ hX'K habK hw₀K
      obtain ⟨K'', hXK'', hK''fd, hab'', hfixiff, hKK''⟩ :=
        conj_abelianExt_transport F X X' K hX'K habK σ hmem
      haveI := hK''fd
      have hrK : (r : EllipticRootNumber.AbsGal F) ∈ K''.fixingSubgroup := by
        have h1 := (hfixiff _).mp hw₀K
        have e : σ * (w₀ : EllipticRootNumber.AbsGal F) * σ⁻¹ = r := by
          show σ * (σ⁻¹ * (r : EllipticRootNumber.AbsGal F) * σ) * σ⁻¹ = r
          group
        rwa [e] at h1
      obtain ⟨z, hz⟩ := (rec.ker_rec X K'' hXK'' hab'' cX).mp hrK
      have hz' : σ⁻¹ (z : AlgebraicClosure F) ∈ K := (hKK'' _).mpr (by rw [hσσ]; exact z.2)
      have ht := s6 K K'' hX'K hXK'' hKK''
        ⟨σ⁻¹ (z : AlgebraicClosure F), hz'⟩ z (hσσ _).symm
      rw [hz] at ht
      have hN : EllipticRootNumber.normLM F hX'K ⟨σ⁻¹ (z : AlgebraicClosure F), hz'⟩ =
          (cX' : X') := by
        apply Subtype.ext
        have h2 := congrArg (fun y => σ⁻¹ y) ht
        simp only [hσσ'] at h2
        rw [← h2]
        exact hbotfix σ⁻¹ (c : (⊥ : IntermediateField F (AlgebraicClosure F)))
      exact (rec.ker_rec X' K hX'K habK cX').mpr ⟨_, hN⟩
    have hRD := relWeil_eq_mod_abelian_of_degree_fix F X' N hX'N hNab w₀ g n hn0 hdeg hdeg' hfix
    have hdeg0 : EllipticRootNumber.weilDegreeHom F
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F X') (w₀⁻¹ * g)) = 1 := by
      have e1 : Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F X') (w₀⁻¹ * g) =
          (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F X') w₀)⁻¹ *
            Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F X') g := Subtype.ext rfl
      rw [e1, map_mul (EllipticRootNumber.weilDegreeHom F), map_inv (EllipticRootNumber.weilDegreeHom F),
        hdeg, hdeg', inv_mul_cancel]
    have h1 := hNtriv (w₀⁻¹ * g) hRD hdeg0
    have h2 : θ' g = θ' w₀ * θ' (w₀⁻¹ * g) := by rw [← map_mul, mul_inv_cancel_left]
    have h3 : θσ r = θ' w₀ := rfl
    show θ' g = θσ r
    rw [h2, h1, mul_one, h3]
  
  have hRHS : θ w = θσ (rec.recMap X (Units.map ((IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ X)) :
          (⊥ : IntermediateField F (AlgebraicClosure F)) →* X) b)) := by
    show θ w = θ (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F hMX')
      ⟨_, conjMem (rec.recMap X (Units.map ((IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ X)) :
          (⊥ : IntermediateField F (AlgebraicClosure F)) →* X) b))⟩)
    congr 1
    apply Subtype.ext
    exact hw
  show θ' (rec.recMap X' (Units.map ((IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ X')) :
          (⊥ : IntermediateField F (AlgebraicClosure F)) →* X') b)) = θ w
  rw [hRHS]
  by_cases hb : EllipticRootNumber.relVal F ⊥ (b : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0
  swap
  · exact core b hb
  obtain ⟨-, hmul, x₀, hx₀⟩ := relVal_bot_spec F
  have hx0 : x₀ ≠ 0 := by
    rintro rfl
    simp [EllipticRootNumber.relVal, EllipticRootNumber.addVal] at hx₀
  have h1 : EllipticRootNumber.relVal F ⊥ (1 : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
    have := hmul 1 1 one_ne_zero one_ne_zero
    rw [one_mul] at this
    omega
  have hu : ((Units.mk0 x₀ hx0 : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
      (⊥ : IntermediateField F (AlgebraicClosure F))) = x₀ := Units.val_mk0 hx0
  have hinv : EllipticRootNumber.relVal F ⊥
      (((Units.mk0 x₀ hx0)⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) = -1 := by
    have := hmul x₀ _ hx0 (Units.ne_zero (Units.mk0 x₀ hx0)⁻¹)
    have e : x₀ * (((Units.mk0 x₀ hx0)⁻¹ : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 := by
      exact Units.mul_inv (Units.mk0 x₀ hx0)
    rw [e, h1, hx₀] at this
    omega
  have hbu : EllipticRootNumber.relVal F ⊥
      ((b * Units.mk0 x₀ hx0 : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
        (⊥ : IntermediateField F (AlgebraicClosure F))) = 1 := by
    rw [Units.val_mul, hmul _ _ (Units.ne_zero b) (Units.ne_zero _), hb, hu, hx₀, zero_add]
  have hbdec : b = (b * Units.mk0 x₀ hx0) * (Units.mk0 x₀ hx0)⁻¹ :=
    (mul_inv_cancel_right b _).symm
  have hP1 := core (b * Units.mk0 x₀ hx0) (by rw [hbu]; exact one_ne_zero)
  have hP2 := core (Units.mk0 x₀ hx0)⁻¹ (by rw [hinv]; norm_num)
  rw [hbdec, map_mul _ (b * Units.mk0 x₀ hx0) (Units.mk0 x₀ hx0)⁻¹,
    map_mul _ (b * Units.mk0 x₀ hx0) (Units.mk0 x₀ hx0)⁻¹, weilChar_recMap_mul F rec X' θ' hθ',
    weilChar_recMap_mul F rec X θσ hθσ, hP1, hP2]

theorem recMap_transfer_compat (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] (rec : EllipticRootNumber.LocalReciprocity F)
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    [((EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥)).FiniteIndex]
    (θ : EllipticRootNumber.relWeil F M →* (EllipticRootNumber.Ω F)ˣ)
    (hθ : EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M θ))
    (b : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ) :
    θ (rec.recMap M (Units.map ((IntermediateField.inclusion
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) :
        (⊥ : IntermediateField F (AlgebraicClosure F)) →* M) b)) =
      (θ.comp (Subgroup.subgroupOfEquivOfLe
        (EllipticRootNumber.relWeil_antitone F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).toMonoidHom).transfer
        (rec.recMap ⊥ b) :=
by
  classical
  
  have memW : ∀ (L : IntermediateField F (AlgebraicClosure F)) (g : EllipticRootNumber.AbsGal F),
      g ∈ EllipticRootNumber.relWeil F L ↔
        g ∈ EllipticRootNumber.weilGroup F ∧ g ∈ L.fixingSubgroup := by
    intro L g
    unfold EllipticRootNumber.relWeil
    exact Subgroup.mem_inf
  
  have hV := transfer_isWeilRep F ⊥ M bot_le θ hθ
  set ϕ := θ.comp (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
    (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).toMonoidHom with hϕ
  set V := ϕ.transfer with hVdef
  set ιb := (Units.map ((IntermediateField.inclusion
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) :
        (⊥ : IntermediateField F (AlgebraicClosure F)) →* M) b) with hιb
  
  have key : ∀ ℓ : ℕ, ℓ.Prime → ∃ e : ℕ, ¬ ℓ ∣ e ∧
      V (rec.recMap ⊥ b) ^ e = θ (rec.recMap M ιb) ^ e := by
    intro ℓ hℓ
    obtain ⟨N, E, hNfd, hMN, hstab, hEfd, hEN, hcop, k, hk⟩ :=
      exists_sylow_normal_field F M ℓ hℓ
    haveI := hNfd
    haveI := hEfd
    set e := Module.finrank (⊥ : IntermediateField F (AlgebraicClosure F))
      (IntermediateField.extendScalars
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ E)) with he
    refine ⟨e, hcop, ?_⟩
    have he0 : e ≠ 0 := fun h0 => hcop (h0 ▸ dvd_zero ℓ)
    set j : EllipticRootNumber.relWeil F E →* EllipticRootNumber.relWeil F ⊥ :=
      Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ E)) with hj
    have hjr : j.range =
        (EllipticRootNumber.relWeil F E).subgroupOf (EllipticRootNumber.relWeil F ⊥) :=
      Subgroup.inclusion_range _
    have hjidx : j.range.index = e := by
      rw [hjr]
      exact relWeil_subgroupOf_index F rec ⊥ E bot_le
    have hjfi : j.range.FiniteIndex := ⟨by rw [hjidx]; exact he0⟩
    set bE := (Units.map ((IntermediateField.inclusion
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ E)) :
        (⊥ : IntermediateField F (AlgebraicClosure F)) →* E) b) with hbE
    
    have hL : V (j (rec.recMap E bE)) = V (rec.recMap ⊥ b) ^ e := by
      have h0 := weilChar_norm_compat_base F rec ⊥ E bot_le V hV b
      have hb0 : (Units.map ((IntermediateField.inclusion
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ ⊥)) :
          (⊥ : IntermediateField F (AlgebraicClosure F)) →*
            (⊥ : IntermediateField F (AlgebraicClosure F))) b) = b := Units.ext rfl
      rw [hb0] at h0
      exact h0
    
    obtain ⟨T, hT1, hT2⟩ := transfer_restrict_mackey
      ((EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥)) j hjfi ϕ
    
    have hfields : ∀ x : EllipticRootNumber.relWeil F ⊥,
        ∃ X Y : IntermediateField F (AlgebraicClosure F),
          FiniteDimensional F X ∧ FiniteDimensional F Y ∧ E ≤ X ∧ X ≤ N ∧ M ≤ Y ∧
          (∀ g : EllipticRootNumber.AbsGal F, g ∈ X.fixingSubgroup ↔
            g ∈ E.fixingSubgroup ∧
              (x : EllipticRootNumber.AbsGal F)⁻¹ * g * x ∈ M.fixingSubgroup) ∧
          (∀ g : EllipticRootNumber.AbsGal F, g ∈ Y.fixingSubgroup ↔
            g ∈ M.fixingSubgroup ∧
              (x : EllipticRootNumber.AbsGal F) * g * (x : EllipticRootNumber.AbsGal F)⁻¹ ∈
                E.fixingSubgroup) ∧
          (∀ g : EllipticRootNumber.AbsGal F, g ∈ Y.fixingSubgroup ↔
            (x : EllipticRootNumber.AbsGal F) * g * (x : EllipticRootNumber.AbsGal F)⁻¹ ∈
              X.fixingSubgroup) :=
      fun x => exists_conj_sup_fields F E M N hEN hMN hstab (x : EllipticRootNumber.AbsGal F)
    choose X Y hXfd hYfd hEX hXN hMY hXfix hYfix hYX using hfields
    have hxW : ∀ x : EllipticRootNumber.relWeil F ⊥,
        (x : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.weilGroup F :=
      fun x => ((memW ⊥ _).mp x.2).1
    have hconjX : ∀ (x : EllipticRootNumber.relWeil F ⊥) (w : EllipticRootNumber.relWeil F (X x)),
        (x : EllipticRootNumber.AbsGal F)⁻¹ * (w : EllipticRootNumber.AbsGal F) * x ∈
          EllipticRootNumber.relWeil F M := by
      intro x w
      have hw := (memW (X x) _).mp w.2
      refine (memW M _).mpr ⟨?_, ((hXfix x _).mp hw.2).2⟩
      exact (EllipticRootNumber.weilGroup F).mul_mem
        ((EllipticRootNumber.weilGroup F).mul_mem
          ((EllipticRootNumber.weilGroup F).inv_mem (hxW x)) hw.1) (hxW x)
    
    let θx : ∀ x : EllipticRootNumber.relWeil F ⊥,
        EllipticRootNumber.relWeil F (X x) →* (EllipticRootNumber.Ω F)ˣ := fun x =>
      MonoidHom.mk' (fun w => θ ⟨_, hconjX x w⟩) (by
        intro a c
        show θ ⟨_, hconjX x (a * c)⟩ = θ ⟨_, hconjX x a⟩ * θ ⟨_, hconjX x c⟩
        rw [← map_mul]
        congr 1
        apply Subtype.ext
        simp only [Subgroup.coe_mul]
        group)
    have hθx : ∀ x, EllipticRootNumber.IsWeilRep F (X x)
        (EllipticRootNumber.charRep F (X x) (θx x)) := fun x =>
      weilChar_conj_isWeilRep F (X x) M (x : EllipticRootNumber.AbsGal F) (hconjX x) θ hθ
        (θx x) (fun w => rfl)
    
    let Kx : EllipticRootNumber.relWeil F ⊥ → Subgroup (EllipticRootNumber.relWeil F E) :=
      fun x => (EllipticRootNumber.relWeil F (X x)).subgroupOf (EllipticRootNumber.relWeil F E)
    have hKx : ∀ (x : EllipticRootNumber.relWeil F ⊥) (k : EllipticRootNumber.relWeil F E),
        k ∈ Kx x ↔ x⁻¹ * j k * x ∈
          (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥) := by
      intro x k
      simp only [Kx, Subgroup.mem_subgroupOf, Subgroup.coe_mul, Subgroup.coe_inv, hj,
        Subgroup.coe_inclusion]
      constructor
      · intro hk'
        exact hconjX x ⟨k, hk'⟩
      · intro hk'
        have hk1 := (memW E _).mp k.2
        exact (memW (X x) _).mpr
          ⟨hk1.1, (hXfix x _).mpr ⟨hk1.2, ((memW M _).mp hk').2⟩⟩
    have hKfi : ∀ x, (Kx x).FiniteIndex := by
      intro x
      haveI := hXfd x
      have hfi := finiteIndex_relWeil_subgroupOf F (X x)
      have h2 := Subgroup.relIndex_mul_relIndex (EllipticRootNumber.relWeil F (X x))
        (EllipticRootNumber.relWeil F E) (EllipticRootNumber.relWeil F ⊥)
        (EllipticRootNumber.relWeil_antitone F (hEX x))
        (EllipticRootNumber.relWeil_antitone F bot_le)
      refine ⟨fun h0 => hfi.1 ?_⟩
      show (EllipticRootNumber.relWeil F (X x)).relIndex (EllipticRootNumber.relWeil F ⊥) = 0
      rw [← h2]
      exact mul_eq_zero_of_left h0 _
    let ϕx : ∀ x, Kx x →* (EllipticRootNumber.Ω F)ˣ := fun x =>
      (θx x).comp (Subgroup.subgroupOfEquivOfLe
        (EllipticRootNumber.relWeil_antitone F (hEX x))).toMonoidHom
    have hϕx : ∀ (x : EllipticRootNumber.relWeil F ⊥) (k : Kx x),
        ϕx x k = ϕ ⟨x⁻¹ * j k * x, (hKx x k).mp k.2⟩ := by
      intro x k
      show θ ⟨_, _⟩ = θ ⟨_, _⟩
      congr 1
    have hM1 := @hT1 Kx hKx hKfi ϕx hϕx (rec.recMap E bE)
    
    have hfac : ∀ x ∈ T, (ϕx x).transfer (rec.recMap E bE) =
        θ (rec.recMap M ιb) ^
          Module.finrank M (IntermediateField.extendScalars (hMY x)) := by
      intro x _
      haveI := hXfd x
      haveI := hYfd x
      have h1 := @transfer_law_pgroup F _ _ _ _ _ rec E (X x) N hNfd (hEX x) (hXN x) hstab
        ℓ hℓ k hk (hKfi x) (θx x) (hθx x) bE
      have hbX : (Units.map ((IntermediateField.inclusion (hEX x)) : E →* X x) bE) =
          Units.map ((IntermediateField.inclusion
            (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ X x)) :
            (⊥ : IntermediateField F (AlgebraicClosure F)) →* X x) b := Units.ext rfl
      rw [hbX] at h1
      have h2 := weilChar_conj_compat_base F rec (X x) (Y x) M (hMY x)
        (x : EllipticRootNumber.AbsGal F) (hxW x) (hYX x) θ hθ b
        ⟨_, hconjX x (rec.recMap (X x) (Units.map ((IntermediateField.inclusion
            (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ X x)) :
            (⊥ : IntermediateField F (AlgebraicClosure F)) →* X x) b))⟩ rfl
      have h3 := weilChar_norm_compat_base F rec M (Y x) (hMY x) θ hθ b
      exact h1.symm.trans (h2.symm.trans h3)
    
    let Hx : EllipticRootNumber.relWeil F ⊥ →
        Subgroup ((EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥)) :=
      fun x => ((EllipticRootNumber.relWeil F (Y x)).subgroupOf
        (EllipticRootNumber.relWeil F M)).comap
          (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
            (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).toMonoidHom
    have hHx : ∀ (x : EllipticRootNumber.relWeil F ⊥)
        (h : (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥)),
        h ∈ Hx x ↔ x * h * x⁻¹ ∈ j.range := by
      intro x h
      rw [hjr]
      have hh := (memW M _).mp (Subgroup.mem_subgroupOf.mp h.2)
      simp only [Hx, Subgroup.mem_comap, MulEquiv.coe_toMonoidHom, Subgroup.mem_subgroupOf,
        Subgroup.subgroupOfEquivOfLe_apply_coe, Subgroup.coe_mul, Subgroup.coe_inv]
      rw [memW, memW]
      constructor
      · rintro ⟨_, hY⟩
        refine ⟨?_, ((hYfix x _).mp hY).2⟩
        exact (EllipticRootNumber.weilGroup F).mul_mem
          ((EllipticRootNumber.weilGroup F).mul_mem (hxW x) hh.1)
          ((EllipticRootNumber.weilGroup F).inv_mem (hxW x))
      · rintro ⟨_, hE⟩
        exact ⟨hh.1, (hYfix x _).mpr ⟨hh.2, hE⟩⟩
    have hsum : ∑ x ∈ T, Module.finrank M (IntermediateField.extendScalars (hMY x)) = e := by
      rw [← hjidx, ← hT2 Hx hHx]
      apply Finset.sum_congr rfl
      intro x _
      haveI := hYfd x
      rw [Subgroup.index_comap_of_surjective _ (MulEquiv.surjective _),
        relWeil_subgroupOf_index F rec M (Y x) (hMY x)]
    have hprod : V (j (rec.recMap E bE)) = θ (rec.recMap M ιb) ^ e := by
      rw [hVdef, hM1, Finset.prod_congr rfl hfac, Finset.prod_pow_eq_pow_sum, hsum]
    exact hL.symm.trans hprod
  
  set y := (V (rec.recMap ⊥ b))⁻¹ * θ (rec.recMap M ιb) with hy
  have hy1 : orderOf y = 1 := by
    by_contra hne
    obtain ⟨p, hp, hpd⟩ := Nat.exists_prime_and_dvd hne
    obtain ⟨e, he, hEq⟩ := key p hp
    have hye : y ^ e = 1 := by rw [hy, mul_pow, inv_pow, hEq, inv_mul_cancel]
    exact he (hpd.trans (orderOf_dvd_of_pow_eq_one hye))
  rw [orderOf_eq_one_iff, hy, inv_mul_eq_one] at hy1
  exact hy1.symm

theorem det_indLM_charRep_mul_transfer (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    [((EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥)).FiniteIndex]
    (θ θ' : EllipticRootNumber.relWeil F M →* (EllipticRootNumber.Ω F)ˣ)
    (w : EllipticRootNumber.relWeil F ⊥) :
    LinearMap.det (EllipticRootNumber.indLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
        (EllipticRootNumber.charRep F M θ) w) *
      (((θ'.comp (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).toMonoidHom).transfer w :
        (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) =
    LinearMap.det (EllipticRootNumber.indLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
        (EllipticRootNumber.charRep F M θ') w) *
      (((θ.comp (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).toMonoidHom).transfer w :
        (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) :=
by
  classical
  
  have s1 : ∀ {G : Type u} [Group G] (H : Subgroup G) [H.FiniteIndex] [Fintype (G ⧸ H)]
      (ϕ : H →* (EllipticRootNumber.Ω F)ˣ) (t : G ⧸ H → G),
      (∀ q : G ⧸ H, (QuotientGroup.mk (t q) : G ⧸ H) = q) → ∀ g : G,
      ∃ a : G ⧸ H → H, (∀ q : G ⧸ H, (a q : G) = (t q)⁻¹ * g * t (g⁻¹ • q)) ∧
        ϕ.transfer g = ∏ q : G ⧸ H, ϕ (a q) := by
    intro G _ H _ _ ϕ t ht g
    have hmem : ∀ q : G ⧸ H, (t q)⁻¹ * g * t (g⁻¹ • q) ∈ H := by
      intro q
      have h1 : (QuotientGroup.mk (g * t (g⁻¹ • q)) : G ⧸ H) = QuotientGroup.mk (t q) := by
        rw [ht q, ← smul_eq_mul, ← MulAction.Quotient.smul_mk, ht, smul_inv_smul]
      rw [mul_assoc]
      exact QuotientGroup.eq.mp h1.symm
    refine ⟨fun q => ⟨_, hmem q⟩, fun q => rfl, ?_⟩
    let T : H.LeftTransversal := ⟨Set.range t, Subgroup.isComplement_range_left ht⟩
    rw [MonoidHom.transfer_def ϕ T g]
    unfold Subgroup.leftTransversals.diff
    refine Finset.prod_congr (Finset.ext fun q => by simp) (fun q _ => ?_)
    congr 1
    apply Subtype.ext
    simp only [Equiv.refl_apply]
    rw [Subgroup.smul_apply_eq_smul_apply_inv_smul, Subgroup.IsComplement.leftQuotientEquiv_apply ht,
      Subgroup.IsComplement.leftQuotientEquiv_apply ht]
    simp [mul_assoc]
  
  have s3 : ∀ {ι : Type u} [Fintype ι] (c : ι → EllipticRootNumber.Ω F) (π : ι → ι)
      (L : (ι → EllipticRootNumber.Ω F) →ₗ[EllipticRootNumber.Ω F] (ι → EllipticRootNumber.Ω F)),
      (∀ (v : ι → EllipticRootNumber.Ω F) (i : ι), L v i = c i * v (π i)) →
      LinearMap.det L = (∏ i, c i) *
        LinearMap.det (LinearMap.funLeft (EllipticRootNumber.Ω F) (EllipticRootNumber.Ω F) π) := by
    intro ι _ c π L hL
    have hL' : L = Matrix.toLin' (Matrix.diagonal c) ∘ₗ
        LinearMap.funLeft (EllipticRootNumber.Ω F) (EllipticRootNumber.Ω F) π := by
      refine LinearMap.ext fun v => funext fun i => ?_
      rw [hL, LinearMap.comp_apply, Matrix.toLin'_apply, Matrix.mulVec_diagonal,
        LinearMap.funLeft_apply]
    rw [hL', LinearMap.det_comp, LinearMap.det_toLin', Matrix.det_diagonal]
  
  have s2 : ∀ {G : Type u} [Group G] (H : Subgroup G)
      (χ : H →* (EllipticRootNumber.Ω F)ˣ)
      (σ : Representation (EllipticRootNumber.Ω F) H (ULift.{u} (EllipticRootNumber.Ω F))),
      (∀ h : H, σ h = (χ h : EllipticRootNumber.Ω F) • LinearMap.id) →
      ∀ (t : G ⧸ H → G), (∀ q : G ⧸ H, (QuotientGroup.mk (t q) : G ⧸ H) = q) →
      ∃ e : EllipticRootNumber.indSpace H σ ≃ₗ[EllipticRootNumber.Ω F]
          (G ⧸ H → EllipticRootNumber.Ω F),
        ∀ (g : G) (f : EllipticRootNumber.indSpace H σ) (q : G ⧸ H) (a : H),
          (a : G) = (t q)⁻¹ * g * t (g⁻¹ • q) →
          e (EllipticRootNumber.indRep H σ g f) q =
            (χ a : EllipticRootNumber.Ω F) * e f (g⁻¹ • q) := by
    intro G _ H χ σ hσ t ht
    have hσv : ∀ (h : H) (v : ULift.{u} (EllipticRootNumber.Ω F)),
        (σ h v).down = (χ h : EllipticRootNumber.Ω F) * v.down := by
      intro h v; rw [hσ]; rfl
    have mem : ∀ x : G, x * t (QuotientGroup.mk x⁻¹) ∈ H := by
      intro x
      have h2 := QuotientGroup.eq.mp (ht (QuotientGroup.mk x⁻¹)).symm
      simpa using h2
    let e₀ : EllipticRootNumber.indSpace H σ →ₗ[EllipticRootNumber.Ω F]
        (G ⧸ H → EllipticRootNumber.Ω F) :=
      { toFun := fun f q => ((f : G → ULift.{u} (EllipticRootNumber.Ω F)) (t q)⁻¹).down
        map_add' := fun f₁ f₂ => rfl
        map_smul' := fun c f => rfl }
    have he₀ : ∀ f q, e₀ f q = ((f : G → ULift.{u} (EllipticRootNumber.Ω F)) (t q)⁻¹).down :=
      fun f q => rfl
    have hrec : ∀ (f : EllipticRootNumber.indSpace H σ) (x : G),
        ((f : G → ULift.{u} (EllipticRootNumber.Ω F)) x).down =
          (χ ⟨_, mem x⟩ : EllipticRootNumber.Ω F) * e₀ f (QuotientGroup.mk x⁻¹) := by
      intro f x
      have hx : x = ((⟨_, mem x⟩ : H) : G) * (t (QuotientGroup.mk x⁻¹))⁻¹ := by simp
      conv_lhs => rw [hx]
      rw [f.2 ⟨_, mem x⟩ _, hσv, he₀]
    have inj : Function.Injective e₀ := by
      rw [injective_iff_map_eq_zero]
      intro f hf
      apply Subtype.ext
      funext x
      apply ULift.ext
      rw [hrec, hf]
      simp
    have surj : Function.Surjective e₀ := by
      intro Fv
      let f₁ : G → ULift.{u} (EllipticRootNumber.Ω F) := fun x =>
        ULift.up ((χ ⟨_, mem x⟩ : EllipticRootNumber.Ω F) * Fv (QuotientGroup.mk x⁻¹))
      have hf₁ : f₁ ∈ EllipticRootNumber.indSpace H σ := by
        intro h y
        have hc : (QuotientGroup.mk ((h : G) * y)⁻¹ : G ⧸ H) = QuotientGroup.mk y⁻¹ := by
          apply QuotientGroup.eq.mpr
          simp
        have hH : (⟨_, mem ((h : G) * y)⟩ : H) = h * ⟨_, mem y⟩ := by
          apply Subtype.ext
          simp only [Subgroup.coe_mul]
          rw [hc, mul_assoc]
        apply ULift.ext
        rw [hσv]
        show (χ ⟨_, mem ((h : G) * y)⟩ : EllipticRootNumber.Ω F) *
            Fv (QuotientGroup.mk ((h : G) * y)⁻¹) =
          (χ h : EllipticRootNumber.Ω F) *
            ((χ ⟨_, mem y⟩ : EllipticRootNumber.Ω F) * Fv (QuotientGroup.mk y⁻¹))
        rw [hH, hc, map_mul, Units.val_mul, mul_assoc]
      refine ⟨⟨f₁, hf₁⟩, ?_⟩
      funext q
      show (χ ⟨_, mem (t q)⁻¹⟩ : EllipticRootNumber.Ω F) *
        Fv (QuotientGroup.mk ((t q)⁻¹)⁻¹) = Fv q
      have h1 : (⟨_, mem (t q)⁻¹⟩ : H) = 1 := by
        apply Subtype.ext
        simp [ht]
      rw [h1]
      simp [ht]
    refine ⟨LinearEquiv.ofBijective e₀ ⟨inj, surj⟩, ?_⟩
    intro g f q a ha
    rw [LinearEquiv.ofBijective_apply, LinearEquiv.ofBijective_apply, he₀, he₀]
    show ((f : G → ULift.{u} (EllipticRootNumber.Ω F)) ((t q)⁻¹ * g)).down =
      (χ a : EllipticRootNumber.Ω F) *
        ((f : G → ULift.{u} (EllipticRootNumber.Ω F)) (t (g⁻¹ • q))⁻¹).down
    have hx : (t q)⁻¹ * g = (a : G) * (t (g⁻¹ • q))⁻¹ := by rw [ha]; group
    rw [hx, f.2 a, hσv]
  
  haveI : Fintype (↥(EllipticRootNumber.relWeil F ⊥) ⧸
      ((EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥))) :=
    Fintype.ofFinite _
  have star : ∀ (χ : ((EllipticRootNumber.relWeil F M).subgroupOf
        (EllipticRootNumber.relWeil F ⊥)) →* (EllipticRootNumber.Ω F)ˣ)
      (σ : Representation (EllipticRootNumber.Ω F) ((EllipticRootNumber.relWeil F M).subgroupOf
        (EllipticRootNumber.relWeil F ⊥)) (ULift.{u} (EllipticRootNumber.Ω F))),
      (∀ h, σ h = (χ h : EllipticRootNumber.Ω F) • LinearMap.id) →
      LinearMap.det (EllipticRootNumber.indRep _ σ w) =
        ((χ.transfer w : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) *
          LinearMap.det (LinearMap.funLeft (EllipticRootNumber.Ω F) (EllipticRootNumber.Ω F)
            (fun q : ↥(EllipticRootNumber.relWeil F ⊥) ⧸
              ((EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥)) =>
              w⁻¹ • q)) := by
    intro χ σ hσ
    obtain ⟨a, ha, htr⟩ := s1 _ χ (fun q => Quotient.out q) (fun q => Quotient.out_eq q) w
    obtain ⟨e, he⟩ := s2 _ χ σ hσ (fun q => Quotient.out q) (fun q => Quotient.out_eq q)
    rw [← LinearMap.det_conj (EllipticRootNumber.indRep _ σ w) e]
    have hL : ∀ (v : ↥(EllipticRootNumber.relWeil F ⊥) ⧸
          ((EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥)) →
            EllipticRootNumber.Ω F) q,
        (e.toLinearMap ∘ₗ EllipticRootNumber.indRep _ σ w ∘ₗ e.symm.toLinearMap) v q =
          (χ (a q) : EllipticRootNumber.Ω F) * v (w⁻¹ • q) := by
      intro v q
      simp only [LinearMap.comp_apply, LinearEquiv.coe_coe]
      rw [he w (e.symm v) q (a q) (ha q), LinearEquiv.apply_symm_apply]
    refine (s3 _ _ _ hL).trans ?_
    rw [htr, Units.coe_prod]
  
  have k1 := star (θ.comp (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).toMonoidHom)
    ((EllipticRootNumber.charRep F M θ).comp (Subgroup.subgroupOfEquivOfLe
      (EllipticRootNumber.relWeil_antitone F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).toMonoidHom) (fun h => rfl)
  have k2 := star (θ'.comp (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).toMonoidHom)
    ((EllipticRootNumber.charRep F M θ').comp (Subgroup.subgroupOfEquivOfLe
      (EllipticRootNumber.relWeil_antitone F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).toMonoidHom) (fun h => rfl)
  unfold EllipticRootNumber.indLM
  rw [k1, k2]
  ring

theorem det_eq_mul_of_exact {k : Type*} [Field k] {V₁ V V₂ : Type*} [AddCommGroup V₁] [Module k V₁]
    [AddCommGroup V] [Module k V] [AddCommGroup V₂] [Module k V₂] [FiniteDimensional k V]
    (a₁ : V₁ →ₗ[k] V₁) (a : V →ₗ[k] V) (a₂ : V₂ →ₗ[k] V₂) (f : V₁ →ₗ[k] V) (g : V →ₗ[k] V₂)
    (hf : f ∘ₗ a₁ = a ∘ₗ f) (hg : g ∘ₗ a = a₂ ∘ₗ g) (hfi : Function.Injective f)
    (hgs : Function.Surjective g) (hex : LinearMap.range f = LinearMap.ker g) :
    LinearMap.det a = LinearMap.det a₁ * LinearMap.det a₂ :=
by
  have hga : ∀ x, g (a x) = a₂ (g x) := fun x => LinearMap.congr_fun hg x
  have hfa : ∀ x, f (a₁ x) = a (f x) := fun x => LinearMap.congr_fun hf x
  have he : LinearMap.ker g ≤ Submodule.comap a (LinearMap.ker g) := by
    intro x hx
    simp only [Submodule.mem_comap, LinearMap.mem_ker] at hx ⊢
    rw [hga, hx, map_zero]
  rw [LinearMap.det_eq_det_mul_det (LinearMap.ker g) a he]
  
  have h2 : LinearMap.det ((LinearMap.ker g).mapQ (LinearMap.ker g) a he) = LinearMap.det a₂ := by
    set e₂ := g.quotKerEquivOfSurjective hgs with he₂
    have hc : (e₂ : _ →ₗ[k] V₂) ∘ₗ (LinearMap.ker g).mapQ (LinearMap.ker g) a he ∘ₗ
        (e₂.symm : V₂ →ₗ[k] _) = a₂ := by
      ext y
      obtain ⟨x, hx⟩ := Submodule.Quotient.mk_surjective _ (e₂.symm y)
      have hy : g x = y := by
        have : e₂ (Submodule.Quotient.mk x) = e₂ (e₂.symm y) := by rw [hx]
        rw [LinearEquiv.apply_symm_apply] at this
        rw [← this, he₂, LinearMap.quotKerEquivOfSurjective_apply_mk]
      simp only [LinearMap.comp_apply, LinearEquiv.coe_coe]
      rw [← hx, Submodule.mapQ_apply, he₂, LinearMap.quotKerEquivOfSurjective_apply_mk, hga, hy]
    rw [← hc, LinearMap.det_conj]
  
  have hfW : ∀ c, f c ∈ LinearMap.ker g := fun c => hex ▸ LinearMap.mem_range_self f c
  set φ : V₁ →ₗ[k] LinearMap.ker g := LinearMap.codRestrict (LinearMap.ker g) f hfW with hφ
  have hφi : Function.Injective φ := by
    intro x y hxy
    apply hfi
    have := congrArg Subtype.val hxy
    simpa [hφ] using this
  have hφs : Function.Surjective φ := by
    rintro ⟨w, hw⟩
    have hw' : w ∈ LinearMap.range f := hex ▸ hw
    obtain ⟨x, hx⟩ := LinearMap.mem_range.mp hw'
    exact ⟨x, Subtype.ext (by simp [hφ, hx])⟩
  obtain ⟨e₁, he₁⟩ : ∃ e₁ : V₁ ≃ₗ[k] LinearMap.ker g, ∀ x, ((e₁ x : LinearMap.ker g) : V) = f x :=
    ⟨LinearEquiv.ofBijective φ ⟨hφi, hφs⟩, fun x => rfl⟩
  have h1 : LinearMap.det (a.restrict he) = LinearMap.det a₁ := by
    have hc : (e₁ : V₁ →ₗ[k] LinearMap.ker g) ∘ₗ a₁ ∘ₗ (e₁.symm : LinearMap.ker g →ₗ[k] V₁) =
        a.restrict he := by
      ext w
      have hx : ((e₁ (e₁.symm w) : LinearMap.ker g) : V) = w := by rw [LinearEquiv.apply_symm_apply]
      simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearMap.restrict_coe_apply]
      rw [he₁, hfa]
      rw [he₁] at hx
      rw [hx]
    rw [← hc, LinearMap.det_conj]
  rw [h1, h2]

theorem recMap_unit_mem_inertia (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (rec : EllipticRootNumber.LocalReciprocity F)
    (u : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ)
    (hu : EllipticRootNumber.valL F ⊥ (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0) :
    ((rec.recMap ⊥ u : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈
      EllipticRootNumber.inertia F :=
by
  have hres := (relVal_bot_spec F).1
  have hrel : EllipticRootNumber.relVal F ⊥
      (u : (⊥ : IntermediateField F (AlgebraicClosure F))) = 0 := by
    have h := hu
    simp only [EllipticRootNumber.valL, hres, Nat.cast_one, Int.ediv_one] at h
    exact h
  have hdeg := rec.degree_rec ⊥ u
  rw [hrel, neg_zero, ofAdd_zero] at hdeg
  exact weilDegreeHom_ker_le_inertia F _ hdeg

theorem exists_scalar_twist_on_galois_subgroup (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    {V : Type u} [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
    (ρ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V)
    (hW : EllipticRootNumber.IsWeilRep F ⊥ ρ)
    (hdim : Module.finrank (EllipticRootNumber.Ω F) V = 2)
    (hnl : ¬ ∃ L : Submodule (EllipticRootNumber.Ω F) V,
      Module.finrank (EllipticRootNumber.Ω F) L = 1 ∧
      ∀ w : EllipticRootNumber.relWeil F ⊥, ∀ v ∈ L, ρ w v ∈ L) :
    ∃ N : IntermediateField F (AlgebraicClosure F), FiniteDimensional F N ∧ Normal F N ∧
      (∀ g k : EllipticRootNumber.relWeil F ⊥,
        (k : EllipticRootNumber.AbsGal F) ∈ N.fixingSubgroup →
        ((g * k * g⁻¹ : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈
          N.fixingSubgroup) ∧
      ∃ ω : EllipticRootNumber.relWeil F ⊥ →* (EllipticRootNumber.Ω F)ˣ,
        EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ ω) ∧
        ∀ w : EllipticRootNumber.relWeil F ⊥,
          (w : EllipticRootNumber.AbsGal F) ∈ N.fixingSubgroup →
          ρ w = (ω w : EllipticRootNumber.Ω F) • LinearMap.id :=
by
  classical
  
  have s5 : ∀ w : EllipticRootNumber.weilGroup F, EllipticRootNumber.weilDegreeHom F w = 1 →
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F := by
    
    have s1 : (EllipticRootNumber.p F).Prime ∧
        ∃ f : ℕ, 0 < f ∧ EllipticRootNumber.q F = EllipticRootNumber.p F ^ f := by
      letI := Fintype.ofFinite (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
      haveI := ringChar.charP (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
      obtain ⟨n, hp, hn⟩ := FiniteField.card
        (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer)
        (ringChar (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer))
      refine ⟨hp, n, n.pos, ?_⟩
      unfold EllipticRootNumber.q EllipticRootNumber.p
      rw [Nat.card_eq_fintype_card, hn]
    
    have s2 : ∀ N : ℕ, ¬ EllipticRootNumber.p F ∣ N → (N : AlgebraicClosure F) ≠ 0 := by
      intro N hN h0
      apply hN
      have h1 : (N : F) = 0 := by
        apply (algebraMap F (AlgebraicClosure F)).injective
        rw [map_natCast, map_zero]
        exact h0
      have h2 : (N : ↥(ValuativeRel.valuation F).integer) = 0 := by
        apply Subtype.ext
        simp [h1]
      have h3 : (N : IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) = 0 := by
        rw [← map_natCast (IsLocalRing.residue ↥(ValuativeRel.valuation F).integer), h2, map_zero]
      exact ringChar.dvd h3
    obtain ⟨hp, f, hf, hq⟩ := s1
    have memσ : ∀ (σ : EllipticRootNumber.AbsGal F) (ζ : AlgebraicClosure F),
        EllipticRootNumber.IsPrimeToPRootOfUnity F ζ →
        EllipticRootNumber.IsPrimeToPRootOfUnity F (σ ζ) := by
      rintro σ ζ ⟨N, hN0, hpN, hζ⟩
      exact ⟨N, hN0, hpN, by rw [← map_pow, hζ, map_one]⟩
    have mempow : ∀ (ζ : AlgebraicClosure F) (k : ℕ),
        EllipticRootNumber.IsPrimeToPRootOfUnity F ζ →
        EllipticRootNumber.IsPrimeToPRootOfUnity F (ζ ^ k) := by
      rintro ζ k ⟨N, hN0, hpN, hζ⟩
      exact ⟨N, hN0, hpN, by rw [← pow_mul, mul_comm, pow_mul, hζ, one_pow]⟩
    
    have hcancel : ∀ x y : AlgebraicClosure F, EllipticRootNumber.IsPrimeToPRootOfUnity F x →
        EllipticRootNumber.IsPrimeToPRootOfUnity F y → ∀ c : ℕ,
        x ^ (EllipticRootNumber.q F ^ c) = y ^ (EllipticRootNumber.q F ^ c) → x = y := by
      rintro x y ⟨a, ha0, hpa, hxa⟩ ⟨b, hb0, hpb, hyb⟩ c h
      have hy0 : y ≠ 0 := by
        rintro rfl
        rw [zero_pow hb0.ne'] at hyb
        exact zero_ne_one hyb
      have hz1 : (x * y⁻¹) ^ (a * b) = 1 := by
        rw [mul_pow, inv_pow, pow_mul, hxa, one_pow, mul_comm a b, pow_mul, hyb, one_pow, inv_one,
          mul_one]
      have hz2 : (x * y⁻¹) ^ (EllipticRootNumber.q F ^ c) = 1 := by
        rw [mul_pow, inv_pow, h, mul_inv_cancel₀ (pow_ne_zero _ hy0)]
      have hcop : Nat.Coprime (EllipticRootNumber.q F ^ c) (a * b) := by
        rw [hq, ← pow_mul]
        apply Nat.Coprime.pow_left
        exact (Nat.Prime.coprime_iff_not_dvd hp).mpr (fun hd => (hp.dvd_mul.mp hd).elim hpa hpb)
      have h3 : (x * y⁻¹) ^ (Nat.gcd (EllipticRootNumber.q F ^ c) (a * b)) = 1 :=
        pow_gcd_eq_one.mpr ⟨hz2, hz1⟩
      rw [hcop.gcd_eq_one, pow_one] at h3
      exact (mul_inv_eq_one₀ hy0).mp h3
    
    have hsep : ∀ s t : ℕ, s < t → ∃ ζ : AlgebraicClosure F,
        EllipticRootNumber.IsPrimeToPRootOfUnity F ζ ∧
          ζ ^ (EllipticRootNumber.q F ^ s) ≠ ζ ^ (EllipticRootNumber.q F ^ t) := by
      intro s t hst
      have hq2 : 2 ≤ EllipticRootNumber.q F := by
        rw [hq]
        calc 2 ≤ EllipticRootNumber.p F := hp.two_le
          _ = EllipticRootNumber.p F ^ 1 := (pow_one _).symm
          _ ≤ EllipticRootNumber.p F ^ f := Nat.pow_le_pow_right hp.pos hf
      have hpq : EllipticRootNumber.p F ∣ EllipticRootNumber.q F ^ t := by
        rw [hq, ← pow_mul]
        exact dvd_pow_self _ (Nat.mul_ne_zero (by omega) (by omega))
      have hpM : ¬ EllipticRootNumber.p F ∣ EllipticRootNumber.q F ^ t + 1 := by
        intro h
        exact hp.not_dvd_one ((Nat.dvd_add_right hpq).mp h)
      haveI : NeZero ((EllipticRootNumber.q F ^ t + 1 : ℕ) : AlgebraicClosure F) := ⟨s2 _ hpM⟩
      obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (AlgebraicClosure F)
        (EllipticRootNumber.q F ^ t + 1)
      refine ⟨ζ, ⟨_, Nat.succ_pos _, hpM, hζ.pow_eq_one⟩, fun heq => ?_⟩
      have h1 : ζ ^ (EllipticRootNumber.q F ^ s + 1) = 1 := by
        rw [pow_succ, heq, ← pow_succ, hζ.pow_eq_one]
      have h2 := Nat.le_of_dvd (Nat.succ_pos _) ((hζ.pow_eq_one_iff_dvd _).mp h1)
      have h3 : EllipticRootNumber.q F ^ s < EllipticRootNumber.q F ^ t :=
        Nat.pow_lt_pow_right hq2 hst
      omega
    
    have hone : EllipticRootNumber.ActsAsFrobPow F 1 0 := by
      intro ζ _
      simp
    have hinv : ∀ (σ : EllipticRootNumber.AbsGal F) (n : ℤ),
        EllipticRootNumber.ActsAsFrobPow F σ n →
        EllipticRootNumber.ActsAsFrobPow F σ⁻¹ (-n) := by
      intro σ n h ζ hζ
      have h1 := h (σ⁻¹ ζ) (memσ _ _ hζ)
      have h2 : σ (σ⁻¹ ζ) = ζ := by
        rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]
      rw [h2] at h1
      rw [neg_neg]
      exact h1.symm
    have hmul : ∀ (σ τ : EllipticRootNumber.AbsGal F) (n m : ℤ),
        EllipticRootNumber.ActsAsFrobPow F σ n → EllipticRootNumber.ActsAsFrobPow F τ m →
        EllipticRootNumber.ActsAsFrobPow F (σ * τ) (n + m) := by
      intro σ τ n m hn hm ζ hζ
      have e1 := hm ζ hζ
      have e2 := hn (τ ζ) (memσ _ _ hζ)
      rw [AlgEquiv.mul_apply]
      have E : (σ (τ ζ)) ^ (EllipticRootNumber.q F ^ ((-n).toNat + (-m).toNat)) =
          ζ ^ (EllipticRootNumber.q F ^ (n.toNat + m.toNat)) := by
        calc (σ (τ ζ)) ^ (EllipticRootNumber.q F ^ ((-n).toNat + (-m).toNat))
            = ((σ (τ ζ)) ^ (EllipticRootNumber.q F ^ (-n).toNat)) ^
                (EllipticRootNumber.q F ^ (-m).toNat) := by rw [pow_add, pow_mul]
          _ = ((τ ζ) ^ (EllipticRootNumber.q F ^ (-m).toNat)) ^
                (EllipticRootNumber.q F ^ n.toNat) := by rw [e2, pow_right_comm]
          _ = ζ ^ (EllipticRootNumber.q F ^ (n.toNat + m.toNat)) := by
                rw [e1, ← pow_mul, ← pow_add, Nat.add_comm m.toNat]
      have t1 := Int.toNat_eq_max n
      have t2 := Int.toNat_eq_max m
      have t3 := Int.toNat_eq_max (-n)
      have t4 := Int.toNat_eq_max (-m)
      have t5 := Int.toNat_eq_max (n + m)
      have t6 := Int.toNat_eq_max (-(n + m))
      obtain ⟨c, hc1, hc2⟩ : ∃ c : ℕ, n.toNat + m.toNat = (n + m).toNat + c ∧
          (-n).toNat + (-m).toNat = (-(n + m)).toNat + c := by
        refine ⟨n.toNat + m.toNat - (n + m).toNat, ?_, ?_⟩ <;> omega
      have hx := mempow (σ (τ ζ)) (EllipticRootNumber.q F ^ (-(n + m)).toNat)
        (memσ _ _ (memσ _ _ hζ))
      have hy := mempow ζ (EllipticRootNumber.q F ^ (n + m).toNat) hζ
      apply hcancel _ _ hx hy c
      rw [← pow_mul, ← pow_mul, ← pow_add, ← pow_add, ← hc1, ← hc2]
      exact E
    
    have huniq : ∀ (σ : EllipticRootNumber.AbsGal F) (n m : ℤ),
        EllipticRootNumber.ActsAsFrobPow F σ n → EllipticRootNumber.ActsAsFrobPow F σ m →
        n = m := by
      intro σ n m hn hm
      have U : ∀ ζ : AlgebraicClosure F, EllipticRootNumber.IsPrimeToPRootOfUnity F ζ →
          ζ ^ (EllipticRootNumber.q F ^ (n.toNat + (-m).toNat)) =
            ζ ^ (EllipticRootNumber.q F ^ (m.toNat + (-n).toNat)) := by
        intro ζ hζ
        calc ζ ^ (EllipticRootNumber.q F ^ (n.toNat + (-m).toNat))
            = (ζ ^ (EllipticRootNumber.q F ^ n.toNat)) ^
                (EllipticRootNumber.q F ^ (-m).toNat) := by
              rw [pow_add, pow_mul]
          _ = ((σ ζ) ^ (EllipticRootNumber.q F ^ (-n).toNat)) ^
                (EllipticRootNumber.q F ^ (-m).toNat) := by rw [hn ζ hζ]
          _ = ((σ ζ) ^ (EllipticRootNumber.q F ^ (-m).toNat)) ^
                (EllipticRootNumber.q F ^ (-n).toNat) := pow_right_comm _ _ _
          _ = (ζ ^ (EllipticRootNumber.q F ^ m.toNat)) ^
                (EllipticRootNumber.q F ^ (-n).toNat) := by
              rw [hm ζ hζ]
          _ = ζ ^ (EllipticRootNumber.q F ^ (m.toNat + (-n).toNat)) := by
              rw [← pow_mul, ← pow_add]
      by_contra hne
      have t1 := Int.toNat_eq_max n
      have t2 := Int.toNat_eq_max m
      have t3 := Int.toNat_eq_max (-n)
      have t4 := Int.toNat_eq_max (-m)
      rcases lt_or_gt_of_ne (show n.toNat + (-m).toNat ≠ m.toNat + (-n).toNat by omega)
        with h | h
      · obtain ⟨ζ, hζ, hne'⟩ := hsep _ _ h
        exact hne' (U ζ hζ)
      · obtain ⟨ζ, hζ, hne'⟩ := hsep _ _ h
        exact hne' (U ζ hζ).symm
    
    have s7 : ∀ σ : EllipticRootNumber.AbsGal F,
        (∀ ζ : AlgebraicClosure F, EllipticRootNumber.IsPrimeToPRootOfUnity F ζ → σ ζ = ζ) →
        σ ∈ EllipticRootNumber.inertia F := by
      intro σ hσ
      unfold EllipticRootNumber.inertia EllipticRootNumber.unramifiedClosure
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      induction hx using IntermediateField.adjoin_induction with
      | mem x hx => exact hσ x hx
      | algebraMap r => exact σ.commutes r
      | add x y _ _ hx hy => rw [map_add, hx, hy]
      | inv x _ hx => rw [map_inv₀, hx]
      | mul x y _ _ hx hy => rw [map_mul, hx, hy]
    
    have hex : ∀ σ ∈ EllipticRootNumber.weilGroup F,
        ∃ n : ℤ, EllipticRootNumber.ActsAsFrobPow F σ n := by
      intro σ hσ
      unfold EllipticRootNumber.weilGroup at hσ
      induction hσ using Subgroup.closure_induction with
      | mem x hx => exact hx
      | one => exact ⟨0, hone⟩
      | mul x y _ _ hx hy =>
        obtain ⟨n, hn⟩ := hx
        obtain ⟨m, hm⟩ := hy
        exact ⟨n + m, hmul _ _ _ _ hn hm⟩
      | inv x _ hx =>
        obtain ⟨n, hn⟩ := hx
        exact ⟨-n, hinv _ _ hn⟩
    let dg : EllipticRootNumber.weilGroup F → ℤ := fun σ => Classical.choose (hex σ σ.2)
    have hdg : ∀ σ : EllipticRootNumber.weilGroup F,
        EllipticRootNumber.ActsAsFrobPow F σ (dg σ) := fun σ => Classical.choose_spec (hex σ σ.2)
    let φ : EllipticRootNumber.weilGroup F →* Multiplicative ℤ :=
      { toFun := fun σ => Multiplicative.ofAdd (dg σ)
        map_one' := by
          show Multiplicative.ofAdd (dg 1) = 1
          rw [huniq _ _ _ (hdg 1) hone]
          rfl
        map_mul' := by
          intro σ τ
          show Multiplicative.ofAdd (dg (σ * τ)) =
            Multiplicative.ofAdd (dg σ) * Multiplicative.ofAdd (dg τ)
          rw [huniq _ _ _ (hdg (σ * τ)) (hmul _ _ _ _ (hdg σ) (hdg τ))]
          rfl }
    have hP : ∀ (σ : EllipticRootNumber.weilGroup F) (n : ℤ),
        EllipticRootNumber.ActsAsFrobPow F σ n →
          EllipticRootNumber.weilDegreeHom F σ = Multiplicative.ofAdd n := by
      have key := Classical.epsilon_spec
        (p := fun g : EllipticRootNumber.weilGroup F →* Multiplicative ℤ =>
          ∀ (σ : EllipticRootNumber.weilGroup F) (n : ℤ),
            EllipticRootNumber.ActsAsFrobPow F σ n → g σ = Multiplicative.ofAdd n)
        ⟨φ, fun σ n hn => by
          show Multiplicative.ofAdd (dg σ) = Multiplicative.ofAdd n
          rw [huniq _ _ _ (hdg σ) hn]⟩
      intro σ n hn
      exact key σ n hn
    intro w hw
    obtain ⟨n, hn⟩ := hex w w.2
    have h1 := hP w n hn
    rw [hw] at h1
    have hn0 : n = 0 := ofAdd_eq_one.mp h1.symm
    subst hn0
    apply s7
    intro ζ hζ
    have := hn ζ hζ
    simpa using this
  
  obtain ⟨hfin, U, hU, hUρ⟩ := hW
  haveI := hfin
  obtain ⟨N, hNfin, hNnorm, hNU⟩ :=
    (krullTopology_mem_nhds_one_iff_of_normal F (AlgebraicClosure F) U).mp hU
  haveI := hNnorm
  have hNnhds : (N.fixingSubgroup : Set (EllipticRootNumber.AbsGal F)) ∈
      nhds (1 : EllipticRootNumber.AbsGal F) :=
    (krullTopology_mem_nhds_one_iff_of_normal F (AlgebraicClosure F) _).mpr
      ⟨N, hNfin, hNnorm, subset_rfl⟩
  
  have hmemN : ∀ (σ : EllipticRootNumber.AbsGal F) (y : AlgebraicClosure F), y ∈ N → σ y ∈ N := by
    intro σ y hy
    have h := AlgEquiv.restrictNormal_commutes σ N ⟨y, hy⟩
    have h' : σ y = ((σ.restrictNormal N ⟨y, hy⟩ : N) : AlgebraicClosure F) := h.symm
    rw [h']
    exact SetLike.coe_mem _
  have hconjG : ∀ g x : EllipticRootNumber.AbsGal F, x ∈ N.fixingSubgroup →
      g * x * g⁻¹ ∈ N.fixingSubgroup := by
    intro g x hx
    rw [IntermediateField.mem_fixingSubgroup_iff] at hx ⊢
    intro y hy
    rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, hx _ (hmemN g⁻¹ y hy), ← AlgEquiv.mul_apply,
      mul_inv_cancel, AlgEquiv.one_apply]
  have hconj : ∀ g k : EllipticRootNumber.relWeil F ⊥,
      (k : EllipticRootNumber.AbsGal F) ∈ N.fixingSubgroup →
      ((g * k * g⁻¹ : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈
        N.fixingSubgroup := fun g k hk => hconjG g k hk
  
  let deg : EllipticRootNumber.relWeil F ⊥ →* Multiplicative ℤ :=
    (EllipticRootNumber.weilDegreeHom F).comp
      (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥))
  let K : Subgroup (EllipticRootNumber.relWeil F ⊥) :=
    Subgroup.comap (EllipticRootNumber.relWeil F ⊥).subtype N.fixingSubgroup
  have hKmem : ∀ x, x ∈ K ↔ (x : EllipticRootNumber.AbsGal F) ∈ N.fixingSubgroup :=
    fun x => Iff.rfl
  have htriv : ∀ x ∈ K, deg x = 1 → ρ x = 1 := by
    intro x hx hd
    exact hUρ x (hNU ((hKmem x).mp hx))
      (s5 (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) x) hd)
  haveI : Nontrivial V :=
    Module.nontrivial_of_finrank_pos (R := EllipticRootNumber.Ω F) (by rw [hdim]; norm_num)
  
  have hschur : ∀ a : V →ₗ[EllipticRootNumber.Ω F] V,
      (∀ g : EllipticRootNumber.relWeil F ⊥, ρ g * a = a * ρ g) →
      ∃ c : EllipticRootNumber.Ω F, a = c • LinearMap.id := by
    intro a ha
    obtain ⟨c, hc⟩ := Module.End.exists_eigenvalue a
    refine ⟨c, ?_⟩
    have hE : Module.End.eigenspace a c ≠ ⊥ := Module.End.hasEigenvalue_iff.mp hc
    have hstab : ∀ g : EllipticRootNumber.relWeil F ⊥, ∀ v ∈ Module.End.eigenspace a c,
        ρ g v ∈ Module.End.eigenspace a c := by
      intro g v hv
      rw [Module.End.mem_eigenspace_iff] at hv ⊢
      have := congrArg (fun f : Module.End (EllipticRootNumber.Ω F) V => f v) (ha g)
      simp only [Module.End.mul_apply] at this
      rw [← this, hv, map_smul]
    have h0 : Module.finrank (EllipticRootNumber.Ω F) (Module.End.eigenspace a c) ≠ 0 := by
      intro h
      exact hE (Submodule.finrank_eq_zero.mp h)
    have h1 : Module.finrank (EllipticRootNumber.Ω F) (Module.End.eigenspace a c) ≠ 1 := by
      intro h
      exact hnl ⟨_, h, hstab⟩
    have h2 := Submodule.finrank_le (Module.End.eigenspace a c)
    rw [hdim] at h2
    have htop : Module.End.eigenspace a c = ⊤ :=
      Submodule.eq_top_of_finrank_eq (by rw [hdim]; omega)
    apply LinearMap.ext
    intro v
    have hv : v ∈ Module.End.eigenspace a c := by rw [htop]; exact Submodule.mem_top
    rw [Module.End.mem_eigenspace_iff] at hv
    rw [hv]
    rfl
  
  obtain ⟨⟨t, ht⟩, hgen⟩ := IsCyclic.exists_generator (α := ↥(K.map deg))
  have hdegK : ∀ x ∈ K, ∃ n : ℤ, deg x = t ^ n := by
    intro x hx
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (hgen ⟨deg x, Subgroup.mem_map_of_mem deg hx⟩)
    refine ⟨n, ?_⟩
    have := congrArg Subtype.val hn
    simpa using this.symm
  obtain ⟨Φ, hΦK, hΦt⟩ := Subgroup.mem_map.mp ht
  obtain ⟨ω, hωK⟩ : ∃ ω : EllipticRootNumber.relWeil F ⊥ →* (EllipticRootNumber.Ω F)ˣ,
      ∀ x ∈ K, ρ x = (ω x : EllipticRootNumber.Ω F) • LinearMap.id := by
    by_cases ht1 : t = 1
    · refine ⟨1, fun x hx => ?_⟩
      obtain ⟨n, hn⟩ := hdegK x hx
      rw [htriv x hx (by rw [hn, ht1, one_zpow]), MonoidHom.one_apply, Units.val_one, one_smul]
      rfl
    · 
      have hcomm : ∀ g : EllipticRootNumber.relWeil F ⊥, ρ g * ρ Φ = ρ Φ * ρ g := by
        intro g
        have hcK : g * Φ * g⁻¹ * Φ⁻¹ ∈ K :=
          K.mul_mem (hconj g Φ hΦK) (K.inv_mem hΦK)
        have hcd : deg (g * Φ * g⁻¹ * Φ⁻¹) = 1 := by
          rw [map_mul, map_mul, map_mul, map_inv, map_inv, mul_inv_cancel_comm, mul_inv_cancel]
        have hc1 := htriv _ hcK hcd
        have e : g * Φ = (g * Φ * g⁻¹ * Φ⁻¹) * Φ * g := by group
        rw [← map_mul, e, map_mul, map_mul, hc1, one_mul]
      obtain ⟨c, hc⟩ := hschur (ρ Φ) hcomm
      have hc0 : c ≠ 0 := by
        intro h0
        have h1 : ρ Φ * ρ Φ⁻¹ = 1 := by rw [← map_mul, mul_inv_cancel, map_one]
        rw [hc, h0, zero_smul, zero_mul] at h1
        exact zero_ne_one h1
      have he : Multiplicative.toAdd t ≠ 0 := fun h => ht1 (toAdd_eq_zero.mp h)
      have hroot : ∀ e : ℤ, e ≠ 0 →
          ∃ u : (EllipticRootNumber.Ω F)ˣ, u ^ e = Units.mk0 c hc0 := by
        intro e he
        obtain ⟨μ, hμ⟩ := IsAlgClosed.exists_pow_nat_eq c (Int.natAbs_pos.mpr he)
        have hμ0 : μ ≠ 0 := by
          rintro rfl
          rw [zero_pow (Int.natAbs_pos.mpr he).ne'] at hμ
          exact hc0 hμ.symm
        have hu0 : (Units.mk0 μ hμ0) ^ e.natAbs = Units.mk0 c hc0 :=
          Units.ext (by simp [hμ])
        rcases Int.natAbs_eq e with h | h
        · refine ⟨Units.mk0 μ hμ0, ?_⟩
          rw [h, zpow_natCast]
          exact hu0
        · refine ⟨(Units.mk0 μ hμ0)⁻¹, ?_⟩
          rw [h, zpow_neg, zpow_natCast, inv_pow, inv_inv]
          exact hu0
      obtain ⟨u, hu⟩ := hroot _ he
      refine ⟨(zpowersHom (EllipticRootNumber.Ω F)ˣ u).comp deg, ?_⟩
      let f2 : EllipticRootNumber.relWeil F ⊥ →* Module.End (EllipticRootNumber.Ω F) V :=
        (algebraMap (EllipticRootNumber.Ω F)
          (Module.End (EllipticRootNumber.Ω F) V)).toMonoidHom.comp
          ((Units.coeHom (EllipticRootNumber.Ω F)).comp
            ((zpowersHom (EllipticRootNumber.Ω F)ˣ u).comp deg))
      have hf2 : ∀ g, f2 g = (((zpowersHom (EllipticRootNumber.Ω F)ˣ u).comp deg) g :
          EllipticRootNumber.Ω F) • LinearMap.id := by
        intro g
        exact Module.algebraMap_end_eq_smul_id _ _ _ _
      have hΦE : Φ ∈ MonoidHom.eqLocus ρ f2 := by
        show ρ Φ = f2 Φ
        rw [hf2, hc, MonoidHom.comp_apply, hΦt, zpowersHom_apply, hu, Units.val_mk0]
      have hker : ∀ y ∈ K, deg y = 1 → y ∈ MonoidHom.eqLocus ρ f2 := by
        intro y hy hd
        show ρ y = f2 y
        rw [hf2, htriv y hy hd, MonoidHom.comp_apply, hd, map_one, Units.val_one, one_smul]
        rfl
      intro x hx
      obtain ⟨n, hn⟩ := hdegK x hx
      have hy : x * (Φ ^ n)⁻¹ ∈ K := K.mul_mem hx (K.inv_mem (K.zpow_mem hΦK n))
      have hyd : deg (x * (Φ ^ n)⁻¹) = 1 := by
        rw [map_mul, map_inv, map_zpow, hΦt, hn, mul_inv_cancel]
      have hxE : x ∈ MonoidHom.eqLocus ρ f2 := by
        have hx' : x = x * (Φ ^ n)⁻¹ * Φ ^ n := by group
        rw [hx']
        exact (MonoidHom.eqLocus ρ f2).mul_mem (hker _ hy hyd)
          ((MonoidHom.eqLocus ρ f2).zpow_mem hΦE n)
      have hxE' : ρ x = f2 x := hxE
      rw [hxE', hf2]
  
  refine ⟨N, hNfin, hNnorm, hconj, ω, ?_, fun w hw => hωK w hw⟩
  refine ⟨LinearEquiv.finiteDimensional ULift.moduleEquiv.symm,
    (N.fixingSubgroup : Set (EllipticRootNumber.AbsGal F)), hNnhds, fun w hwN hwI => ?_⟩
  have h1 : ρ w = 1 := hUρ w (hNU hwN) hwI
  have h2 := hωK w hwN
  rw [h1] at h2
  obtain ⟨v, hv⟩ := exists_ne (0 : V)
  have h3 : (ω w : EllipticRootNumber.Ω F) • v = (1 : EllipticRootNumber.Ω F) • v := by
    have := congrArg (fun f : Module.End (EllipticRootNumber.Ω F) V => f v) h2
    simp only [Module.End.one_apply, LinearMap.smul_apply, LinearMap.id_apply] at this
    rw [one_smul]
    exact this.symm
  have h4 : (ω w : EllipticRootNumber.Ω F) = 1 := smul_left_injective _ hv h3
  have h5 : ω w = 1 := Units.ext h4
  show (ω w : EllipticRootNumber.Ω F) • LinearMap.id = 1
  rw [h5, Units.val_one, one_smul]
  rfl

theorem relWeil_subgroupOf_eq_of_le (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (N : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F N] [Normal F N]
    (S : Subgroup (EllipticRootNumber.relWeil F ⊥))
    (hS : (EllipticRootNumber.relWeil F N).subgroupOf (EllipticRootNumber.relWeil F ⊥) ≤ S) :
    ∃ M : IntermediateField F (AlgebraicClosure F), M ≤ N ∧ FiniteDimensional F M ∧
      (∀ x ∈ N, x ∈ M ↔ ∀ s ∈ S, (s : EllipticRootNumber.AbsGal F) x = x) ∧
      S = (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥) :=
by
  classical
  set T : Subgroup (EllipticRootNumber.AbsGal F) :=
    S.map (EllipticRootNumber.relWeil F ⊥).subtype with hT
  set M : IntermediateField F (AlgebraicClosure F) := N ⊓ IntermediateField.fixedField T with hM
  have hTmem : ∀ x : AlgebraicClosure F, (∀ f ∈ T, f x = x) ↔
      ∀ s ∈ S, (s : EllipticRootNumber.AbsGal F) x = x := by
    intro x
    constructor
    · intro h s hs
      exact h _ (Subgroup.mem_map_of_mem _ hs)
    · intro h f hf
      obtain ⟨s, hs, rfl⟩ := Subgroup.mem_map.mp hf
      exact h s hs
  have hMem : ∀ x, x ∈ M ↔ x ∈ N ∧ ∀ s ∈ S, (s : EllipticRootNumber.AbsGal F) x = x := by
    intro x
    rw [hM, IntermediateField.mem_inf, IntermediateField.mem_fixedField_iff, hTmem]
  refine ⟨M, inf_le_left, inferInstance, fun x hx => (hMem x).trans (and_iff_right hx), ?_⟩
  apply le_antisymm
  · intro s hs
    rw [Subgroup.mem_subgroupOf]
    show (s : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.weilGroup F ⊓ M.fixingSubgroup
    refine Subgroup.mem_inf.mpr ⟨EllipticRootNumber.relWeil_le_weilGroup F ⊥ s.2, ?_⟩
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    exact ((hMem x).mp hx).2 s hs
  · intro w hw
    rw [Subgroup.mem_subgroupOf] at hw
    have hw' : (w : EllipticRootNumber.AbsGal F) ∈
        EllipticRootNumber.weilGroup F ⊓ M.fixingSubgroup := hw
    have hfix : ∀ x ∈ M, (w : EllipticRootNumber.AbsGal F) x = x :=
      (IntermediateField.mem_fixingSubgroup_iff _ _).mp (Subgroup.mem_inf.mp hw').2
    set r := AlgEquiv.restrictNormalHom (F := F) (K₁ := AlgebraicClosure F) N with hr
    set H : Subgroup (N ≃ₐ[F] N) := T.map r with hH
    have hrσ : r (w : EllipticRootNumber.AbsGal F) ∈
        (IntermediateField.fixedField H).fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro y hy
      rw [IntermediateField.mem_fixedField_iff] at hy
      apply Subtype.ext
      rw [hr, AlgEquiv.restrictNormalHom_apply]
      apply hfix
      rw [hMem]
      refine ⟨y.2, ?_⟩
      intro s hs
      have h1 := hy (r ((EllipticRootNumber.relWeil F ⊥).subtype s))
        (Subgroup.mem_map_of_mem _ (Subgroup.mem_map_of_mem _ hs))
      have h2 := congrArg Subtype.val h1
      rw [hr, AlgEquiv.restrictNormalHom_apply] at h2
      exact h2
    rw [IntermediateField.fixingSubgroup_fixedField] at hrσ
    obtain ⟨f, hf, hfr⟩ := Subgroup.mem_map.mp hrσ
    obtain ⟨s, hs, rfl⟩ := Subgroup.mem_map.mp hf
    have hagree : ∀ x ∈ N, (s : EllipticRootNumber.AbsGal F) x =
        (w : EllipticRootNumber.AbsGal F) x := by
      intro x hx
      have h1 := congrArg (fun e : N ≃ₐ[F] N => ((e ⟨x, hx⟩ : N) : AlgebraicClosure F)) hfr
      simp only [hr, AlgEquiv.restrictNormalHom_apply] at h1
      exact h1
    have hk : s⁻¹ * w ∈ (EllipticRootNumber.relWeil F N).subgroupOf
        (EllipticRootNumber.relWeil F ⊥) := by
      rw [Subgroup.mem_subgroupOf]
      show ((s⁻¹ * w : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈
        EllipticRootNumber.weilGroup F ⊓ N.fixingSubgroup
      refine Subgroup.mem_inf.mpr
        ⟨EllipticRootNumber.relWeil_le_weilGroup F ⊥ (s⁻¹ * w).2, ?_⟩
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      rw [Subgroup.coe_mul, Subgroup.coe_inv, AlgEquiv.mul_apply, ← hagree x hx,
        ← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]
    have h3 := S.mul_mem hs (hS hk)
    rwa [mul_inv_cancel_left] at h3

theorem fixedBy_card_mul_eq_sum {G : Type u} [Group G] (S T : Subgroup G) [S.FiniteIndex]
    [T.FiniteIndex] :
    ∃ Us : List (Subgroup G), (∀ U ∈ Us, ∃ y : G, ∀ z : G, z ∈ U ↔ z ∈ S ∧ y⁻¹ * z * y ∈ T) ∧
      ∀ g : G, Nat.card (MulAction.fixedBy (G ⧸ S) g) * Nat.card (MulAction.fixedBy (G ⧸ T) g) =
        (Us.map fun U => Nat.card (MulAction.fixedBy (G ⧸ U) g)).sum :=
by
  classical
  
  have s1 : ∀ g : G, Nat.card (MulAction.fixedBy ((G ⧸ S) × (G ⧸ T)) g) =
      Nat.card (MulAction.fixedBy (G ⧸ S) g) * Nat.card (MulAction.fixedBy (G ⧸ T) g) := by
    intro g
    have hset : MulAction.fixedBy ((G ⧸ S) × (G ⧸ T)) g =
        MulAction.fixedBy (G ⧸ S) g ×ˢ MulAction.fixedBy (G ⧸ T) g := by
      ext ⟨a, b⟩
      simp only [MulAction.mem_fixedBy, Prod.smul_mk, Prod.mk.injEq, Set.mem_prod]
    rw [hset, Nat.card_congr (Equiv.Set.prod _ _), Nat.card_prod]
  
  have s2 : ∀ (w : (G ⧸ S) × (G ⧸ T)) (g : G),
      Nat.card ↥(MulAction.orbit G w ∩ MulAction.fixedBy ((G ⧸ S) × (G ⧸ T)) g) =
        Nat.card (MulAction.fixedBy (G ⧸ MulAction.stabilizer G w) g) := by
    intro w g
    set φ := (MulAction.orbitEquivQuotientStabilizer G w).symm with hφ
    have hφa : ∀ a : G, (φ (a : G ⧸ MulAction.stabilizer G w) : (G ⧸ S) × (G ⧸ T)) = a • w :=
      fun a => MulAction.orbitEquivQuotientStabilizer_symm_apply G w a
    have E : ∀ q : G ⧸ MulAction.stabilizer G w,
        (φ (g • q) : (G ⧸ S) × (G ⧸ T)) = g • (φ q : (G ⧸ S) × (G ⧸ T)) := by
      intro q
      induction q using QuotientGroup.induction_on with
      | H a => rw [MulAction.Quotient.smul_mk, smul_eq_mul, hφa, hφa, mul_smul]
    refine (Nat.card_congr ?_).symm
    exact
      { toFun := fun q => ⟨(φ q.1 : (G ⧸ S) × (G ⧸ T)), (φ q.1).2, by
          show g • (φ q.1 : (G ⧸ S) × (G ⧸ T)) = _
          rw [← E]
          have hq : g • q.1 = q.1 := q.2
          rw [hq]⟩
        invFun := fun z => ⟨φ.symm ⟨z.1, z.2.1⟩, by
          show g • φ.symm ⟨z.1, z.2.1⟩ = φ.symm ⟨z.1, z.2.1⟩
          apply φ.injective
          apply Subtype.ext
          rw [E, Equiv.apply_symm_apply]
          exact z.2.2⟩
        left_inv := fun q => by
          apply Subtype.ext
          exact φ.symm_apply_apply q.1
        right_inv := fun z => by
          apply Subtype.ext
          show ((φ (φ.symm ⟨z.1, z.2.1⟩)) : (G ⧸ S) × (G ⧸ T)) = z.1
          rw [Equiv.apply_symm_apply] }
  
  have s4 : ∀ y z : G, z ∈ MulAction.stabilizer G (((1 : G) : G ⧸ S), ((y : G) : G ⧸ T)) ↔
      z ∈ S ∧ y⁻¹ * z * y ∈ T := by
    intro y z
    rw [MulAction.mem_stabilizer_iff, Prod.smul_mk, Prod.mk.injEq, MulAction.Quotient.smul_mk,
      MulAction.Quotient.smul_mk, smul_eq_mul, smul_eq_mul, QuotientGroup.eq, QuotientGroup.eq]
    have h2 : (z * y)⁻¹ * y = (y⁻¹ * z * y)⁻¹ := by group
    rw [h2, mul_one, mul_one, inv_mem_iff, inv_mem_iff]
  
  haveI : Fintype ((G ⧸ S) × (G ⧸ T)) := Fintype.ofFinite _
  haveI hΩfin : Finite (MulAction.orbitRel.Quotient G ((G ⧸ S) × (G ⧸ T))) := Quotient.finite _
  haveI : Fintype (MulAction.orbitRel.Quotient G ((G ⧸ S) × (G ⧸ T))) := Fintype.ofFinite _
  let r : MulAction.orbitRel.Quotient G ((G ⧸ S) × (G ⧸ T)) → (G ⧸ S) × (G ⧸ T) :=
    fun ω => (Quotient.out (Quotient.out ω).1)⁻¹ • Quotient.out ω
  have hr1 : ∀ ω, (r ω).1 = ((1 : G) : G ⧸ S) := by
    intro ω
    show (Quotient.out (Quotient.out ω).1)⁻¹ • (Quotient.out ω).1 = _
    have h : ∀ a : G ⧸ S, (Quotient.out a)⁻¹ • a = ((1 : G) : G ⧸ S) := by
      intro a
      calc (Quotient.out a)⁻¹ • a = (Quotient.out a)⁻¹ • ((Quotient.out a : G) : G ⧸ S) := by
            rw [QuotientGroup.out_eq']
        _ = _ := by rw [MulAction.Quotient.smul_mk, smul_eq_mul, inv_mul_cancel]
    exact h _
  have hK : ∀ ω (z : (G ⧸ S) × (G ⧸ T)),
      z ∈ MulAction.orbit G (r ω) ↔
        (Quotient.mk (MulAction.orbitRel G ((G ⧸ S) × (G ⧸ T))) z) = ω := by
    intro ω z
    have ho : MulAction.orbit G (r ω) = MulAction.orbit G (Quotient.out ω) :=
      MulAction.orbit_smul _ _
    rw [ho, ← MulAction.orbitRel_apply]
    constructor
    · intro h
      exact (Quotient.sound h).trans (Quotient.out_eq ω)
    · intro h
      apply Quotient.exact
      rw [h, Quotient.out_eq]
  
  refine ⟨(Finset.univ : Finset (MulAction.orbitRel.Quotient G ((G ⧸ S) × (G ⧸ T)))).toList.map
    (fun ω => MulAction.stabilizer G (r ω)), ?_, ?_⟩
  · intro U hU
    obtain ⟨ω, -, rfl⟩ := List.mem_map.mp hU
    obtain ⟨y, hy⟩ : ∃ y : G, y = Quotient.out (r ω).2 := ⟨_, rfl⟩
    refine ⟨y, fun z => ?_⟩
    have hw : r ω = (((1 : G) : G ⧸ S), ((y : G) : G ⧸ T)) := by
      rw [hy]
      exact Prod.ext (hr1 ω) (QuotientGroup.out_eq' (r ω).2).symm
    rw [hw]
    exact s4 y z
  · intro g
    rw [← s1 g, List.map_map, Finset.sum_map_toList]
    let F : Finset ((G ⧸ S) × (G ⧸ T)) := Finset.univ.filter (fun z => g • z = z)
    have hF : Nat.card (MulAction.fixedBy ((G ⧸ S) × (G ⧸ T)) g) = F.card :=
      Nat.subtype_card F (fun z => by simp [F, MulAction.mem_fixedBy])
    rw [hF, Finset.card_eq_sum_card_fiberwise
      (f := fun z => Quotient.mk (MulAction.orbitRel G ((G ⧸ S) × (G ⧸ T))) z)
      (t := Finset.univ) (fun z _ => Finset.mem_univ _)]
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    rw [Function.comp_apply, ← s2 (r ω) g]
    refine (Nat.subtype_card _ (fun z => ?_)).symm
    rw [Finset.mem_filter, Finset.mem_filter, Set.mem_inter_iff, hK, MulAction.mem_fixedBy]
    simp only [Finset.mem_univ, true_and]
    exact And.comm

theorem exists_hyp_fixedBy_not_dvd {G : Type u} [Group G] (K0 : Subgroup G) [K0.Normal]
    [K0.FiniteIndex] (g : G) (p : ℕ) (hp : p.Prime) :
    ∃ S : Subgroup G, (K0 ≤ S ∧ ∃ (C : Subgroup G) (c₀ : G) (q : ℕ), q.Prime ∧ K0 ≤ C ∧ C ≤ S ∧
        (∀ s ∈ S, ∀ c ∈ C, s * c * s⁻¹ ∈ C) ∧ c₀ ∈ C ∧
        (∀ c ∈ C, ∃ n : ℤ, c * (c₀ ^ n)⁻¹ ∈ K0) ∧ (∀ s ∈ S, ∃ n : ℕ, s ^ (q ^ n) ∈ C)) ∧
      ¬ p ∣ Nat.card (MulAction.fixedBy (G ⧸ S) g) :=
by
  classical
  haveI : Fact p.Prime := ⟨hp⟩
  
  have s6 : ∀ (X : Type u) [MulAction G X] [Finite X] (a : ℕ),
      Nat.card (MulAction.fixedBy X g) ≡ Nat.card (MulAction.fixedBy X (g ^ (p ^ a))) [MOD p] := by
    intro X _ _ a
    have hgY : ∀ y ∈ MulAction.fixedBy X (g ^ (p ^ a)), g • y ∈ MulAction.fixedBy X (g ^ (p ^ a)) := by
      intro y hy
      rw [MulAction.mem_fixedBy] at hy ⊢
      rw [smul_smul, ← (Commute.self_pow g (p ^ a)).eq, mul_smul, hy]
    have hgY' : ∀ y ∈ MulAction.fixedBy X (g ^ (p ^ a)),
        g⁻¹ • y ∈ MulAction.fixedBy X (g ^ (p ^ a)) := by
      intro y hy
      rw [MulAction.mem_fixedBy] at hy ⊢
      rw [smul_smul, ← (Commute.self_pow g (p ^ a)).inv_left.eq, mul_smul, hy]
    let σ : Equiv.Perm (MulAction.fixedBy X (g ^ (p ^ a))) :=
      { toFun := fun y => ⟨g • y.1, hgY y.1 y.2⟩
        invFun := fun y => ⟨g⁻¹ • y.1, hgY' y.1 y.2⟩
        left_inv := fun y => Subtype.ext (inv_smul_smul g y.1)
        right_inv := fun y => Subtype.ext (smul_inv_smul g y.1) }
    have hσpow : ∀ (k : ℕ) (y : MulAction.fixedBy X (g ^ (p ^ a))),
        ((σ ^ k) y : X) = g ^ k • (y : X) := by
      intro k
      induction k with
      | zero => intro y; simp
      | succ k ih =>
        intro y
        rw [pow_succ, Equiv.Perm.mul_apply, ih, pow_succ, mul_smul]
        rfl
    have hσp : σ ^ (p ^ a) = 1 := by
      refine Equiv.ext fun y => Subtype.ext ?_
      rw [hσpow, Equiv.Perm.one_apply]
      exact y.2
    have hΓ : IsPGroup p (Subgroup.zpowers σ) := by
      intro τ
      obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp τ.2
      refine ⟨a, Subtype.ext ?_⟩
      rw [Subgroup.coe_pow, Subgroup.coe_one, ← hn, ← zpow_natCast (σ ^ n) (p ^ a), ← zpow_mul,
        mul_comm, zpow_mul, zpow_natCast, hσp, one_zpow]
    have hcong := hΓ.card_modEq_card_fixedPoints (MulAction.fixedBy X (g ^ (p ^ a)))
    have hiff : ∀ y : MulAction.fixedBy X (g ^ (p ^ a)),
        y ∈ MulAction.fixedPoints (Subgroup.zpowers σ) (MulAction.fixedBy X (g ^ (p ^ a))) ↔
          (y : X) ∈ MulAction.fixedBy X g := by
      intro y
      rw [MulAction.mem_fixedPoints, MulAction.mem_fixedBy]
      constructor
      · intro hy
        have := hy ⟨σ, Subgroup.mem_zpowers σ⟩
        exact congrArg Subtype.val this
      · intro hy τ
        obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp τ.2
        have h1 : σ y = y := Subtype.ext hy
        show (τ : Equiv.Perm _) y = y
        rw [← hn]
        exact Equiv.Perm.zpow_apply_eq_self_of_apply_eq_self h1 n
    have hsub : ∀ {x : X}, x ∈ MulAction.fixedBy X g → x ∈ MulAction.fixedBy X (g ^ (p ^ a)) := by
      intro x hx
      have := MulAction.fixedBy_subset_fixedBy_zpow X g ((p ^ a : ℕ) : ℤ) hx
      rwa [zpow_natCast] at this
    have heq : Nat.card (MulAction.fixedPoints (Subgroup.zpowers σ)
        (MulAction.fixedBy X (g ^ (p ^ a)))) = Nat.card (MulAction.fixedBy X g) :=
      Nat.card_congr ((Equiv.subtypeEquivRight hiff).trans (Equiv.subtypeSubtypeEquivSubtype hsub))
    rw [heq] at hcong
    exact hcong.symm
  
  have s5 : ∀ (S N : Subgroup G) (h : G), (∀ x : G, x⁻¹ * h * x ∈ S ↔ x ∈ N) →
      Nat.card (MulAction.fixedBy (G ⧸ S) h) = S.relIndex N := by
    intro S N h hN
    have key : ∀ x : G, ((x : G ⧸ S) ∈ MulAction.fixedBy (G ⧸ S) h ↔ x⁻¹ * h * x ∈ S) := by
      intro x
      rw [MulAction.mem_fixedBy, MulAction.Quotient.smul_mk, smul_eq_mul, QuotientGroup.eq]
      have e : (h * x)⁻¹ * x = (x⁻¹ * h * x)⁻¹ := by group
      rw [e, inv_mem_iff]
    let F : N ⧸ S.subgroupOf N → MulAction.fixedBy (G ⧸ S) h :=
      Quotient.lift (fun n : N => (⟨((n : G) : G ⧸ S), (key n).2 ((hN n).2 n.2)⟩ :
        MulAction.fixedBy (G ⧸ S) h))
        (fun a b hab => by
          apply Subtype.ext
          show ((a : G) : G ⧸ S) = ((b : G) : G ⧸ S)
          rw [QuotientGroup.eq]
          have hab' : a⁻¹ * b ∈ S.subgroupOf N := QuotientGroup.leftRel_apply.mp hab
          rw [Subgroup.mem_subgroupOf] at hab'
          simpa using hab')
    have hinj : Function.Injective F := by
      intro q1 q2
      induction q1 using QuotientGroup.induction_on with
      | H a =>
      induction q2 using QuotientGroup.induction_on with
      | H b =>
      intro hF
      have h1 : ((a : G) : G ⧸ S) = ((b : G) : G ⧸ S) := congrArg Subtype.val hF
      rw [QuotientGroup.eq] at h1
      rw [QuotientGroup.eq, Subgroup.mem_subgroupOf]
      simpa using h1
    have hsurj : Function.Surjective F := by
      rintro ⟨y, hy⟩
      obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective y
      have hxN : x ∈ N := (hN x).1 ((key x).1 hy)
      exact ⟨((⟨x, hxN⟩ : N) : N ⧸ S.subgroupOf N), rfl⟩
    rw [← Nat.card_congr (Equiv.ofBijective F ⟨hinj, hsurj⟩)]
    rfl
  
  have s3 : ∀ (C : Subgroup G) [C.FiniteIndex],
      ∃ S : Subgroup G, C ≤ S ∧ S ≤ C.normalizer ∧ (∀ s ∈ S, ∃ n : ℕ, s ^ (p ^ n) ∈ C) ∧
        ¬ p ∣ S.relIndex C.normalizer := by
    intro C _
    haveI hCn : (C.subgroupOf C.normalizer).Normal := Subgroup.normal_in_normalizer
    haveI : Finite (C.normalizer ⧸ C.subgroupOf C.normalizer) :=
      Subgroup.finite_quotient_of_finiteIndex
    obtain ⟨P⟩ : Nonempty (Sylow p (C.normalizer ⧸ C.subgroupOf C.normalizer)) := inferInstance
    let S₀ : Subgroup C.normalizer :=
      (P : Subgroup (C.normalizer ⧸ C.subgroupOf C.normalizer)).comap
        (QuotientGroup.mk' (C.subgroupOf C.normalizer))
    refine ⟨S₀.map C.normalizer.subtype, ?_, ?_, ?_, ?_⟩
    · intro c hc
      refine Subgroup.mem_map.mpr ⟨⟨c, Subgroup.le_normalizer hc⟩, ?_, rfl⟩
      show QuotientGroup.mk' (C.subgroupOf C.normalizer) ⟨c, Subgroup.le_normalizer hc⟩ ∈ P
      rw [QuotientGroup.mk'_apply, (QuotientGroup.eq_one_iff
        (⟨c, Subgroup.le_normalizer hc⟩ : C.normalizer)).mpr (Subgroup.mem_subgroupOf.mpr hc)]
      exact one_mem _
    · intro s hs
      obtain ⟨y, -, rfl⟩ := Subgroup.mem_map.mp hs
      exact y.2
    · intro s hs
      obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hs
      obtain ⟨k, hk⟩ := P.isPGroup' ⟨QuotientGroup.mk' (C.subgroupOf C.normalizer) y, hy⟩
      have hk' : QuotientGroup.mk' (C.subgroupOf C.normalizer) (y ^ p ^ k) = 1 := by
        rw [map_pow]
        simpa using congrArg Subtype.val hk
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf] at hk'
      exact ⟨k, by simpa using hk'⟩
    · have e1 : (S₀.map C.normalizer.subtype).subgroupOf C.normalizer = S₀ :=
        Subgroup.comap_map_eq_self_of_injective C.normalizer.subtype_injective S₀
      rw [Subgroup.relIndex, e1,
        Subgroup.index_comap_of_surjective _ (QuotientGroup.mk'_surjective _)]
      exact P.not_dvd_index
  
  have s4 : ∀ (C S : Subgroup G) (h : G) (m : ℕ), ¬ p ∣ m → h ^ m ∈ K0 → h ∈ C → K0 ≤ C →
      C ≤ S → (∀ c ∈ C, ∃ n : ℤ, c * (h ^ n)⁻¹ ∈ K0) → (∀ s ∈ S, ∃ n : ℕ, s ^ (p ^ n) ∈ C) →
      ∀ x : G, x⁻¹ * h * x ∈ S ↔ x ∈ C.normalizer := by
    intro C S h m hm hhm hh hK0C hCS hcyc hpow x
    constructor
    · intro hs
      have hconjK : ∀ k ∈ K0, x⁻¹ * k * x ∈ C := by
        intro k hk
        have := Subgroup.Normal.conj_mem (inferInstance : K0.Normal) k hk x⁻¹
        rw [inv_inv] at this
        exact hK0C this
      have hsm : (x⁻¹ * h * x) ^ m ∈ C := by
        have e : (x⁻¹ * h * x) ^ m = x⁻¹ * h ^ m * x := by
          have := conj_pow (a := x⁻¹) (b := h) (i := m)
          rw [inv_inv] at this
          exact this
        rw [e]
        exact hconjK _ hhm
      obtain ⟨n, hn⟩ := hpow _ hs
      have hcop : Nat.Coprime m (p ^ n) :=
        (Nat.Coprime.pow_left n ((Nat.Prime.coprime_iff_not_dvd hp).2 hm)).symm
      have hsC : x⁻¹ * h * x ∈ C := by
        have hb := Nat.gcd_eq_gcd_ab m (p ^ n)
        rw [Nat.Coprime.gcd_eq_one hcop, Nat.cast_one] at hb
        have : x⁻¹ * h * x = ((x⁻¹ * h * x) ^ m) ^ (Nat.gcdA m (p ^ n)) *
            ((x⁻¹ * h * x) ^ (p ^ n)) ^ (Nat.gcdB m (p ^ n)) := by
          rw [← zpow_natCast (x⁻¹ * h * x) m, ← zpow_natCast (x⁻¹ * h * x) (p ^ n), ← zpow_mul,
            ← zpow_mul, ← zpow_add, ← hb, zpow_one]
        rw [this]
        exact C.mul_mem (C.zpow_mem hsm _) (C.zpow_mem hn _)
      have hconjC : ∀ c ∈ C, x⁻¹ * c * x ∈ C := by
        intro c hc
        obtain ⟨j, hj⟩ := hcyc c hc
        have e2 : (x⁻¹ * h * x) ^ j = x⁻¹ * h ^ j * x := by
          have := conj_zpow (a := x⁻¹) (b := h) (i := j)
          rw [inv_inv] at this
          exact this
        have e : x⁻¹ * c * x = (x⁻¹ * (c * (h ^ j)⁻¹) * x) * (x⁻¹ * h * x) ^ j := by
          rw [e2]
          group
        rw [e]
        exact C.mul_mem (hconjK _ hj) (C.zpow_mem hsC j)
      have hind : ∀ i : ℕ, ∀ c ∈ C, (x ^ i)⁻¹ * c * x ^ i ∈ C := by
        intro i
        induction i with
        | zero => intro c hc; simpa using hc
        | succ i ih =>
          intro c hc
          have e : (x ^ (i + 1))⁻¹ * c * x ^ (i + 1) = x⁻¹ * ((x ^ i)⁻¹ * c * x ^ i) * x := by
            rw [pow_succ]; group
          rw [e]
          exact hconjC _ (ih c hc)
      have hM : K0.index ≠ 0 := Subgroup.FiniteIndex.index_ne_zero
      have hxM : x ^ K0.index ∈ C := hK0C (Subgroup.pow_index_mem K0 x)
      rw [Subgroup.mem_normalizer_iff]
      intro c
      constructor
      · intro hc
        have e : x * c * x⁻¹ = x ^ K0.index * ((x ^ (K0.index - 1))⁻¹ * c * x ^ (K0.index - 1)) *
            (x ^ K0.index)⁻¹ := by
          obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hM
          rw [hk, Nat.succ_sub_one, pow_succ']
          group
        rw [e]
        exact C.mul_mem (C.mul_mem hxM (hind _ c hc)) (C.inv_mem hxM)
      · intro hc
        have e : c = x⁻¹ * (x * c * x⁻¹) * x := by group
        rw [e]
        exact hconjC _ hc
    · intro hx
      have := (Subgroup.mem_normalizer_iff.mp (C.normalizer.inv_mem hx) h).mp hh
      rw [inv_inv] at this
      exact hCS this
  
  have hM : K0.index ≠ 0 := Subgroup.FiniteIndex.index_ne_zero
  obtain ⟨a, m', hm', hMa⟩ := Nat.exists_eq_pow_mul_and_not_dvd hM p hp.ne_one
  obtain ⟨h, hhdef⟩ : ∃ h : G, h = g ^ (p ^ a) := ⟨_, rfl⟩
  have hhm : h ^ m' ∈ K0 := by
    rw [hhdef, ← pow_mul, ← hMa]
    exact Subgroup.pow_index_mem K0 g
  
  let C : Subgroup G := (Subgroup.zpowers ((h : G ⧸ K0))).comap (QuotientGroup.mk' K0)
  have hK0C : K0 ≤ C := by
    intro k hk
    show QuotientGroup.mk' K0 k ∈ Subgroup.zpowers ((h : G ⧸ K0))
    rw [QuotientGroup.mk'_apply, (QuotientGroup.eq_one_iff k).2 hk]
    exact one_mem _
  have hh : h ∈ C := by
    show QuotientGroup.mk' K0 h ∈ Subgroup.zpowers ((h : G ⧸ K0))
    rw [QuotientGroup.mk'_apply]
    exact Subgroup.mem_zpowers _
  have hcyc : ∀ c ∈ C, ∃ n : ℤ, c * (h ^ n)⁻¹ ∈ K0 := by
    intro c hc
    have hc' : QuotientGroup.mk' K0 c ∈ Subgroup.zpowers ((h : G ⧸ K0)) := hc
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hc'
    rw [QuotientGroup.mk'_apply] at hn
    refine ⟨n, ?_⟩
    rw [← QuotientGroup.eq_one_iff, QuotientGroup.mk_mul, QuotientGroup.mk_inv,
      QuotientGroup.mk_zpow, hn]
    exact mul_inv_cancel _
  haveI : C.FiniteIndex := Subgroup.finiteIndex_of_le hK0C
  
  obtain ⟨S, hCS, hSN, hpowS, hidx⟩ := s3 C
  have hiff := s4 C S h m' hm' hhm hh hK0C hCS hcyc hpowS
  have hfixh : Nat.card (MulAction.fixedBy (G ⧸ S) h) = S.relIndex C.normalizer :=
    s5 S C.normalizer h hiff
  haveI : S.FiniteIndex := Subgroup.finiteIndex_of_le (hK0C.trans hCS)
  haveI : Finite (G ⧸ S) := Subgroup.finite_quotient_of_finiteIndex
  have hmod := s6 (G ⧸ S) a
  rw [← hhdef] at hmod
  refine ⟨S, ⟨hK0C.trans hCS, C, h, p, hp, hK0C, hCS,
    fun s hs c hc => (Subgroup.mem_normalizer_iff.mp (hSN hs) c).mp hc, hh, hcyc, hpowS⟩, ?_⟩
  rw [Nat.ModEq.dvd_iff hmod (dvd_refl p), hfixh]
  exact hidx

theorem one_mem_span_of_local {ι X : Type u} [Finite X] (P : ι → Prop) (f : ι → X → ℤ)
    (hmul : ∀ i j, P i → P j → ∃ l : List ι, (∀ k ∈ l, P k) ∧
      ∀ x, f i x * f j x = (l.map fun k => f k x).sum)
    (hloc : ∀ (x : X) (p : ℕ), p.Prime → ∃ i, P i ∧ ¬ (p : ℤ) ∣ f i x) :
    ∃ lp lm : List ι, (∀ i ∈ lp ++ lm, P i) ∧
      ∀ x, 1 + (lm.map fun i => f i x).sum = (lp.map fun i => f i x).sum :=
by
  classical
  have app : ∀ A B : List ι, (∀ i ∈ A, P i) → (∀ i ∈ B, P i) → ∀ i ∈ A ++ B, P i := by
    intro A B hA hB i hi
    rcases List.mem_append.mp hi with h | h
    · exact hA i h
    · exact hB i h
  
  have inner : ∀ a, P a → ∀ C : List ι, (∀ k ∈ C, P k) → ∃ L : List ι, (∀ k ∈ L, P k) ∧
      ∀ x, f a x * (C.map fun k => f k x).sum = (L.map fun k => f k x).sum := by
    intro a ha C
    induction C with
    | nil => intro _; exact ⟨[], by simp, fun x => by simp⟩
    | cons c C ih =>
      intro hC
      obtain ⟨l, hl, hle⟩ := hmul a c ha (hC c (by simp))
      obtain ⟨L', hL', hL'e⟩ := ih (fun k hk => hC k (by simp [hk]))
      refine ⟨l ++ L', app _ _ hl hL', fun x => ?_⟩
      rw [List.map_cons, List.sum_cons, mul_add, hle x, hL'e x, List.map_append, List.sum_append]
  
  have s2 : ∀ A C : List ι, (∀ k ∈ A, P k) → (∀ k ∈ C, P k) → ∃ L : List ι, (∀ k ∈ L, P k) ∧
      ∀ x, (A.map fun k => f k x).sum * (C.map fun k => f k x).sum =
        (L.map fun k => f k x).sum := by
    intro A C hA hC
    induction A with
    | nil => exact ⟨[], by simp, fun x => by simp⟩
    | cons a A ih =>
      obtain ⟨La, hLa, hLae⟩ := inner a (hA a (by simp)) C hC
      obtain ⟨L', hL', hL'e⟩ := ih (fun k hk => hA k (by simp [hk]))
      refine ⟨La ++ L', app _ _ hLa hL', fun x => ?_⟩
      rw [List.map_cons, List.sum_cons, add_mul, hLae x, hL'e x, List.map_append,
        List.sum_append]
  
  have s4 : ∀ x : X, ∃ lp lm : List ι, (∀ i ∈ lp ++ lm, P i) ∧
      (lp.map fun i => f i x).sum - (lm.map fun i => f i x).sum = 1 := by
    intro x
    let A : AddSubgroup ℤ :=
      { carrier := {n | ∃ lp lm : List ι, (∀ i ∈ lp ++ lm, P i) ∧
          (lp.map fun i => f i x).sum - (lm.map fun i => f i x).sum = n}
        zero_mem' := by
          show ∃ lp lm : List ι, (∀ i ∈ lp ++ lm, P i) ∧
            (lp.map fun i => f i x).sum - (lm.map fun i => f i x).sum = 0
          exact ⟨[], [], by simp, by simp⟩
        add_mem' := fun {a b} ha hb => by
          obtain ⟨lp₁, lm₁, h₁, e₁⟩ := ha
          obtain ⟨lp₂, lm₂, h₂, e₂⟩ := hb
          show ∃ lp lm : List ι, (∀ i ∈ lp ++ lm, P i) ∧
            (lp.map fun i => f i x).sum - (lm.map fun i => f i x).sum = a + b
          refine ⟨lp₁ ++ lp₂, lm₁ ++ lm₂, ?_, ?_⟩
          · refine app _ _ (app _ _ ?_ ?_) (app _ _ ?_ ?_)
            · exact fun i hi => h₁ i (List.mem_append_left _ hi)
            · exact fun i hi => h₂ i (List.mem_append_left _ hi)
            · exact fun i hi => h₁ i (List.mem_append_right _ hi)
            · exact fun i hi => h₂ i (List.mem_append_right _ hi)
          · simp only [List.map_append, List.sum_append]
            rw [← e₁, ← e₂]
            ring
        neg_mem' := fun {a} ha => by
          obtain ⟨lp, lm, h, e⟩ := ha
          show ∃ lp lm : List ι, (∀ i ∈ lp ++ lm, P i) ∧
            (lp.map fun i => f i x).sum - (lm.map fun i => f i x).sum = -a
          refine ⟨lm, lp, ?_, ?_⟩
          · exact app _ _ (fun i hi => h i (List.mem_append_right _ hi))
              (fun i hi => h i (List.mem_append_left _ hi))
          · rw [← e]
            ring }
    obtain ⟨d, hd⟩ := Int.subgroup_cyclic A
    have hdvd : ∀ i, P i → d ∣ f i x := by
      intro i hi
      have hmem : f i x ∈ A := by
        show ∃ lp lm : List ι, (∀ i ∈ lp ++ lm, P i) ∧
          (lp.map fun i => f i x).sum - (lm.map fun i => f i x).sum = f i x
        exact ⟨[i], [], by simpa using hi, by simp⟩
      rw [hd, AddSubgroup.mem_closure_singleton] at hmem
      obtain ⟨n, hn⟩ := hmem
      exact ⟨n, by rw [← hn, smul_eq_mul, mul_comm]⟩
    have hd1 : d.natAbs = 1 := by
      by_contra hne
      obtain ⟨p, hp, hpd⟩ := Nat.exists_prime_and_dvd hne
      obtain ⟨i, hi, hndvd⟩ := hloc x p hp
      exact hndvd (dvd_trans (Int.natCast_dvd.mpr hpd) (hdvd i hi))
    have hdA : d ∈ A := by
      rw [hd]
      exact AddSubgroup.mem_closure_singleton_self d
    have h1A : (1 : ℤ) ∈ A := by
      rcases Int.natAbs_eq_iff.mp hd1 with h | h
      · rw [h] at hdA
        simpa using hdA
      · rw [h] at hdA
        simpa using A.neg_mem hdA
    exact h1A
  
  have key : ∀ s : Finset X, ∃ lp lm : List ι, (∀ i ∈ lp ++ lm, P i) ∧
      ∀ x ∈ s, (lp.map fun i => f i x).sum - (lm.map fun i => f i x).sum = 1 := by
    intro s
    refine Finset.induction_on s ⟨[], [], by simp, by simp⟩ ?_
    intro y s _ ih
    obtain ⟨A, B, hAB, hg⟩ := ih
    obtain ⟨C, D, hCD, hh⟩ := s4 y
    have hA : ∀ i ∈ A, P i := fun i hi => hAB i (List.mem_append_left _ hi)
    have hB : ∀ i ∈ B, P i := fun i hi => hAB i (List.mem_append_right _ hi)
    have hC : ∀ i ∈ C, P i := fun i hi => hCD i (List.mem_append_left _ hi)
    have hD : ∀ i ∈ D, P i := fun i hi => hCD i (List.mem_append_right _ hi)
    obtain ⟨L1, h1, e1⟩ := s2 A C hA hC
    obtain ⟨L2, h2, e2⟩ := s2 B D hB hD
    obtain ⟨L3, h3, e3⟩ := s2 A D hA hD
    obtain ⟨L4, h4, e4⟩ := s2 B C hB hC
    refine ⟨A ++ C ++ (L3 ++ L4), B ++ D ++ (L1 ++ L2),
      app _ _ (app _ _ (app _ _ hA hC) (app _ _ h3 h4)) (app _ _ (app _ _ hB hD) (app _ _ h1 h2)),
      ?_⟩
    intro x hx
    simp only [List.map_append, List.sum_append]
    rcases Finset.mem_insert.mp hx with hxy | hxs
    · rw [hxy]
      linear_combination
        (1 - ((A.map fun i => f i y).sum - (B.map fun i => f i y).sum)) * hh +
          e1 y + e2 y - e3 y - e4 y
    · linear_combination
        (1 - ((C.map fun i => f i x).sum - (D.map fun i => f i x).sum)) * hg x hxs +
          e1 x + e2 x - e3 x - e4 x
  haveI := Fintype.ofFinite X
  obtain ⟨lp, lm, hP, h⟩ := key Finset.univ
  exact ⟨lp, lm, hP, fun x => by have := h x (Finset.mem_univ x); linarith⟩

theorem solomon_fixed_point_identity {G : Type u} [Group G] (K0 : Subgroup G) [K0.Normal]
    [K0.FiniteIndex] :
    ∃ Lp Lm : List (Subgroup G),
      (∀ S ∈ Lp ++ Lm, K0 ≤ S ∧ ∃ (C : Subgroup G) (c₀ : G) (p : ℕ), p.Prime ∧ K0 ≤ C ∧ C ≤ S ∧
          (∀ s ∈ S, ∀ c ∈ C, s * c * s⁻¹ ∈ C) ∧ c₀ ∈ C ∧
          (∀ c ∈ C, ∃ n : ℤ, c * (c₀ ^ n)⁻¹ ∈ K0) ∧ (∀ s ∈ S, ∃ n : ℕ, s ^ (p ^ n) ∈ C)) ∧
      ∀ g : G, 1 + (Lm.map fun S => Nat.card (MulAction.fixedBy (G ⧸ S) g)).sum =
        (Lp.map fun S => Nat.card (MulAction.fixedBy (G ⧸ S) g)).sum :=
by
  classical
  
  have s1 : ∀ (S U : Subgroup G),
      (K0 ≤ S ∧ ∃ (C : Subgroup G) (c₀ : G) (p : ℕ), p.Prime ∧ K0 ≤ C ∧ C ≤ S ∧
        (∀ s ∈ S, ∀ c ∈ C, s * c * s⁻¹ ∈ C) ∧ c₀ ∈ C ∧
        (∀ c ∈ C, ∃ n : ℤ, c * (c₀ ^ n)⁻¹ ∈ K0) ∧ (∀ s ∈ S, ∃ n : ℕ, s ^ (p ^ n) ∈ C)) →
      K0 ≤ U → U ≤ S →
      (K0 ≤ U ∧ ∃ (C : Subgroup G) (c₀ : G) (p : ℕ), p.Prime ∧ K0 ≤ C ∧ C ≤ U ∧
        (∀ s ∈ U, ∀ c ∈ C, s * c * s⁻¹ ∈ C) ∧ c₀ ∈ C ∧
        (∀ c ∈ C, ∃ n : ℤ, c * (c₀ ^ n)⁻¹ ∈ K0) ∧ (∀ s ∈ U, ∃ n : ℕ, s ^ (p ^ n) ∈ C)) := by
    intro S U hS hKU hUS
    obtain ⟨-, C, c₀, p, hp, hK0C, hCS, hCn, hc₀, hcyc, hpow⟩ := hS
    let A : AddSubgroup ℤ :=
      { carrier := {n | c₀ ^ n ∈ U}
        zero_mem' := by
          show c₀ ^ (0 : ℤ) ∈ U
          rw [zpow_zero]; exact U.one_mem
        add_mem' := fun {a b} ha hb => by
          show c₀ ^ (a + b) ∈ U
          rw [zpow_add]; exact U.mul_mem ha hb
        neg_mem' := fun {a} ha => by
          show c₀ ^ (-a) ∈ U
          rw [zpow_neg]; exact U.inv_mem ha }
    obtain ⟨d, hd⟩ := Int.subgroup_cyclic A
    have hmemA : ∀ n : ℤ, c₀ ^ n ∈ U ↔ ∃ j : ℤ, j * d = n := by
      intro n
      have h1 : n ∈ A ↔ n ∈ AddSubgroup.closure {d} := by rw [hd]
      rw [← AddSubgroup.zmultiples_eq_closure, AddSubgroup.mem_zmultiples_iff] at h1
      simpa using h1
    have hdU : c₀ ^ d ∈ U := (hmemA d).2 ⟨1, one_mul d⟩
    refine ⟨hKU, C ⊓ U, c₀ ^ d, p, hp, le_inf hK0C hKU, inf_le_right, ?_, ?_, ?_, ?_⟩
    · intro s hs c hc
      rw [Subgroup.mem_inf] at hc ⊢
      exact ⟨hCn s (hUS hs) c hc.1, U.mul_mem (U.mul_mem hs hc.2) (U.inv_mem hs)⟩
    · exact Subgroup.mem_inf.mpr ⟨C.zpow_mem hc₀ d, hdU⟩
    · intro c hc
      rw [Subgroup.mem_inf] at hc
      obtain ⟨n, hn⟩ := hcyc c hc.1
      have hcn : c₀ ^ n ∈ U := by
        have h1 : c₀ ^ n = (c * (c₀ ^ n)⁻¹)⁻¹ * c := by group
        rw [h1]; exact U.mul_mem (U.inv_mem (hKU hn)) hc.2
      obtain ⟨j, hj⟩ := (hmemA n).1 hcn
      refine ⟨j, ?_⟩
      rw [← zpow_mul, mul_comm d j, hj]; exact hn
    · intro s hs
      obtain ⟨n, hn⟩ := hpow s (hUS hs)
      exact ⟨n, Subgroup.mem_inf.mpr ⟨hn, U.pow_mem hs _⟩⟩
  
  have s5 : ∀ (S : Subgroup G), K0 ≤ S → ∀ (g κ : G), κ ∈ K0 →
      Nat.card (MulAction.fixedBy (G ⧸ S) (g * κ)) = Nat.card (MulAction.fixedBy (G ⧸ S) g) := by
    intro S hKS g κ hκ
    have htriv : ∀ y : G ⧸ S, κ • y = y := by
      intro y
      refine QuotientGroup.induction_on y fun z => ?_
      rw [MulAction.Quotient.smul_mk, QuotientGroup.eq, smul_eq_mul]
      apply hKS
      have h1 : (κ * z)⁻¹ * z = z⁻¹ * κ⁻¹ * z⁻¹⁻¹ := by group
      rw [h1]
      exact Subgroup.Normal.conj_mem inferInstance _ (K0.inv_mem hκ) _
    have hset : MulAction.fixedBy (G ⧸ S) (g * κ) = MulAction.fixedBy (G ⧸ S) g := by
      ext y
      simp only [MulAction.mem_fixedBy, mul_smul, htriv]
    rw [hset]
  haveI : Finite (G ⧸ K0) := Subgroup.finite_quotient_of_finiteIndex
  
  have hmul : ∀ S T : Subgroup G,
      (K0 ≤ S ∧ ∃ (C : Subgroup G) (c₀ : G) (p : ℕ), p.Prime ∧ K0 ≤ C ∧ C ≤ S ∧
        (∀ s ∈ S, ∀ c ∈ C, s * c * s⁻¹ ∈ C) ∧ c₀ ∈ C ∧
        (∀ c ∈ C, ∃ n : ℤ, c * (c₀ ^ n)⁻¹ ∈ K0) ∧ (∀ s ∈ S, ∃ n : ℕ, s ^ (p ^ n) ∈ C)) →
      (K0 ≤ T ∧ ∃ (C : Subgroup G) (c₀ : G) (p : ℕ), p.Prime ∧ K0 ≤ C ∧ C ≤ T ∧
        (∀ s ∈ T, ∀ c ∈ C, s * c * s⁻¹ ∈ C) ∧ c₀ ∈ C ∧
        (∀ c ∈ C, ∃ n : ℤ, c * (c₀ ^ n)⁻¹ ∈ K0) ∧ (∀ s ∈ T, ∃ n : ℕ, s ^ (p ^ n) ∈ C)) →
      ∃ l : List (Subgroup G),
        (∀ U ∈ l, K0 ≤ U ∧ ∃ (C : Subgroup G) (c₀ : G) (p : ℕ), p.Prime ∧ K0 ≤ C ∧ C ≤ U ∧
          (∀ s ∈ U, ∀ c ∈ C, s * c * s⁻¹ ∈ C) ∧ c₀ ∈ C ∧
          (∀ c ∈ C, ∃ n : ℤ, c * (c₀ ^ n)⁻¹ ∈ K0) ∧ (∀ s ∈ U, ∃ n : ℕ, s ^ (p ^ n) ∈ C)) ∧
        ∀ x : G ⧸ K0,
          ((Nat.card (MulAction.fixedBy (G ⧸ S) (Quotient.out x)) : ℕ) : ℤ) *
              ((Nat.card (MulAction.fixedBy (G ⧸ T) (Quotient.out x)) : ℕ) : ℤ) =
            (l.map fun U => ((Nat.card (MulAction.fixedBy (G ⧸ U) (Quotient.out x)) : ℕ) : ℤ)).sum := by
    intro S T hS hT
    haveI : S.FiniteIndex := Subgroup.finiteIndex_of_le hS.1
    haveI : T.FiniteIndex := Subgroup.finiteIndex_of_le hT.1
    obtain ⟨Us, hUs, hfix⟩ := fixedBy_card_mul_eq_sum S T
    refine ⟨Us, ?_, ?_⟩
    · intro U hU
      obtain ⟨y, hy⟩ := hUs U hU
      have hKU : K0 ≤ U := by
        intro z hz
        rw [hy]
        refine ⟨hS.1 hz, hT.1 ?_⟩
        have h1 := Subgroup.Normal.conj_mem (inferInstance : K0.Normal) z hz y⁻¹
        simpa using h1
      have hUS : U ≤ S := fun z hz => ((hy z).1 hz).1
      exact s1 S U hS hKU hUS
    · intro x
      rw [← Nat.cast_mul, hfix (Quotient.out x), Nat.cast_list_sum, List.map_map]
      rfl
  
  have hloc : ∀ (x : G ⧸ K0) (p : ℕ), p.Prime → ∃ S : Subgroup G,
      (K0 ≤ S ∧ ∃ (C : Subgroup G) (c₀ : G) (p : ℕ), p.Prime ∧ K0 ≤ C ∧ C ≤ S ∧
        (∀ s ∈ S, ∀ c ∈ C, s * c * s⁻¹ ∈ C) ∧ c₀ ∈ C ∧
        (∀ c ∈ C, ∃ n : ℤ, c * (c₀ ^ n)⁻¹ ∈ K0) ∧ (∀ s ∈ S, ∃ n : ℕ, s ^ (p ^ n) ∈ C)) ∧
      ¬ (p : ℤ) ∣ ((Nat.card (MulAction.fixedBy (G ⧸ S) (Quotient.out x)) : ℕ) : ℤ) := by
    intro x p hp
    obtain ⟨S, hS, hndvd⟩ := exists_hyp_fixedBy_not_dvd K0 (Quotient.out x) p hp
    exact ⟨S, hS, by exact_mod_cast hndvd⟩
  
  obtain ⟨lp, lm, hP, hid⟩ := one_mem_span_of_local
    (fun S : Subgroup G => K0 ≤ S ∧ ∃ (C : Subgroup G) (c₀ : G) (p : ℕ), p.Prime ∧ K0 ≤ C ∧ C ≤ S ∧
        (∀ s ∈ S, ∀ c ∈ C, s * c * s⁻¹ ∈ C) ∧ c₀ ∈ C ∧
        (∀ c ∈ C, ∃ n : ℤ, c * (c₀ ^ n)⁻¹ ∈ K0) ∧ (∀ s ∈ S, ∃ n : ℕ, s ^ (p ^ n) ∈ C))
    (fun (S : Subgroup G) (x : G ⧸ K0) =>
      ((Nat.card (MulAction.fixedBy (G ⧸ S) (Quotient.out x)) : ℕ) : ℤ))
    hmul hloc
  refine ⟨lp, lm, hP, fun g => ?_⟩
  have hx := hid (g : G ⧸ K0)
  obtain ⟨κ, hκ⟩ := QuotientGroup.mk_out_eq_mul K0 g
  have hcongr : ∀ S ∈ lp ++ lm,
      ((Nat.card (MulAction.fixedBy (G ⧸ S) (Quotient.out (g : G ⧸ K0))) : ℕ) : ℤ) =
        ((Nat.card (MulAction.fixedBy (G ⧸ S) g) : ℕ) : ℤ) := by
    intro S hS
    have h1 : Quotient.out (g : G ⧸ K0) = g * (κ : G) := hκ
    rw [h1, s5 S (hP S hS).1 g κ κ.2]
  have hm : (lm.map fun S =>
        ((Nat.card (MulAction.fixedBy (G ⧸ S) (Quotient.out (g : G ⧸ K0))) : ℕ) : ℤ)) =
      lm.map fun S => ((Nat.card (MulAction.fixedBy (G ⧸ S) g) : ℕ) : ℤ) :=
    List.map_congr_left fun S hS => hcongr S (List.mem_append_right lp hS)
  have hp' : (lp.map fun S =>
        ((Nat.card (MulAction.fixedBy (G ⧸ S) (Quotient.out (g : G ⧸ K0))) : ℕ) : ℤ)) =
      lp.map fun S => ((Nat.card (MulAction.fixedBy (G ⧸ S) g) : ℕ) : ℤ) :=
    List.map_congr_left fun S hS => hcongr S (List.mem_append_left lm hS)
  rw [hm, hp'] at hx
  have key : ((1 + (lm.map fun S => Nat.card (MulAction.fixedBy (G ⧸ S) g)).sum : ℕ) : ℤ) =
      (((lp.map fun S => Nat.card (MulAction.fixedBy (G ⧸ S) g)).sum : ℕ) : ℤ) := by
    rw [Nat.cast_add, Nat.cast_one, Nat.cast_list_sum, Nat.cast_list_sum, List.map_map,
      List.map_map]
    exact hx
  exact Nat.cast_injective key

theorem indRep_trivial_list_sum {k : Type} [Field k] {G : Type u} [Group G] (K0 : Subgroup G)
    [K0.Normal] [K0.FiniteIndex]
    {X₀ : Type u} [AddCommGroup X₀] [Module k X₀] [FiniteDimensional k X₀]
    (τ₀ : Representation k G X₀) (h₀ : ∀ g ∈ K0, τ₀ g = 1)
    (L : List (Subgroup G)) (hL : ∀ S ∈ L, K0 ≤ S) :
    ∃ (Y : Type u) (_ : AddCommGroup Y) (_ : Module k Y) (_ : FiniteDimensional k Y)
      (τ : Representation k G Y),
      (∀ g ∈ K0, τ g = 1) ∧
      (∀ g : G, LinearMap.trace k Y (τ g) = LinearMap.trace k X₀ (τ₀ g) +
        ((L.map fun S => Nat.card (MulAction.fixedBy (G ⧸ S) g)).sum : k)) ∧
      ∀ Φ : (∀ {X : Type u} [AddCommGroup X] [Module k X], Representation k G X → kˣ),
        (∀ {X₁ X X₂ : Type u} [AddCommGroup X₁] [Module k X₁] [AddCommGroup X] [Module k X]
          [AddCommGroup X₂] [Module k X₂] [FiniteDimensional k X₁] [FiniteDimensional k X]
          [FiniteDimensional k X₂]
          (τ₁ : Representation k G X₁) (τ : Representation k G X) (τ₂ : Representation k G X₂),
          (∀ g ∈ K0, τ₁ g = 1) → (∀ g ∈ K0, τ g = 1) → (∀ g ∈ K0, τ₂ g = 1) →
          ∀ (f : X₁ →ₗ[k] X) (q : X →ₗ[k] X₂),
            (∀ g, f ∘ₗ τ₁ g = τ g ∘ₗ f) → (∀ g, q ∘ₗ τ g = τ₂ g ∘ₗ q) →
            Function.Injective f → Function.Surjective q → LinearMap.range f = LinearMap.ker q →
            Φ τ = Φ τ₁ * Φ τ₂) →
        Φ τ = Φ τ₀ * (L.map fun S => Φ (EllipticRootNumber.indRep S
          (Representation.trivial k S (ULift.{u} k)))).prod :=
by
  classical
  
  have trfun : ∀ (α : Type u) [Fintype α] (σ : α → α),
      LinearMap.trace k (α → k) (LinearMap.funLeft k k σ) =
        (Nat.card {a // σ a = a} : k) := by
    intro α _ σ
    rw [LinearMap.trace_eq_matrix_trace k (Pi.basisFun k α), LinearMap.toMatrix_eq_toMatrix']
    simp only [Matrix.trace, Matrix.diag, LinearMap.toMatrix'_apply, LinearMap.funLeft_apply,
      Pi.single_apply]
    rw [Finset.sum_boole, Nat.card_eq_fintype_card, Fintype.card_subtype]
  
  have key : ∀ S : Subgroup G, K0 ≤ S →
      FiniteDimensional k
        (EllipticRootNumber.indSpace S (Representation.trivial k S (ULift.{u} k))) ∧
      (∀ g ∈ K0, EllipticRootNumber.indRep S (Representation.trivial k S (ULift.{u} k)) g = 1) ∧
      (∀ g : G, LinearMap.trace k _
        (EllipticRootNumber.indRep S (Representation.trivial k S (ULift.{u} k)) g) =
          (Nat.card (MulAction.fixedBy (G ⧸ S) g) : k)) := by
    intro S hS
    have hmem : ∀ f ∈ EllipticRootNumber.indSpace S (Representation.trivial k S (ULift.{u} k)),
        ∀ (h : S) (y : G), f ((h : G) * y) = f y := fun f hf h y =>
      (hf h y).trans (Representation.trivial_apply k h (f y))
    haveI : S.FiniteIndex := Subgroup.finiteIndex_of_le hS
    haveI : Finite (G ⧸ S) := Subgroup.finite_quotient_of_finiteIndex
    haveI : Fintype (G ⧸ S) := Fintype.ofFinite _
    obtain ⟨e, he⟩ : ∃ e : EllipticRootNumber.indSpace S (Representation.trivial k S (ULift.{u} k))
        ≃ₗ[k] (G ⧸ S → k), ∀ (g : G)
        (f : EllipticRootNumber.indSpace S (Representation.trivial k S (ULift.{u} k)))
        (x : G ⧸ S),
        e (EllipticRootNumber.indRep S (Representation.trivial k S (ULift.{u} k)) g f) x =
          e f (g⁻¹ • x) := by
      refine ⟨{
        toFun := fun f x => Quotient.liftOn' x (fun y => (f.1 y⁻¹).down) (fun a b hab => by
          have hab' : a⁻¹ * b ∈ S := QuotientGroup.leftRel_apply.mp hab
          have h1 := hmem f.1 f.2 ⟨a⁻¹ * b, hab'⟩ b⁻¹
          simp only [mul_inv_cancel_right] at h1
          show (f.1 a⁻¹).down = (f.1 b⁻¹).down
          rw [h1])
        map_add' := fun f₁ f₂ => by
          funext x
          obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective x
          rfl
        map_smul' := fun c f => by
          funext x
          obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective x
          rfl
        invFun := fun φ => ⟨fun y => ULift.up (φ ((y⁻¹ : G) : G ⧸ S)), fun h y => by
          have h2 : ((((h : G) * y)⁻¹ : G) : G ⧸ S) = ((y⁻¹ : G) : G ⧸ S) :=
            QuotientGroup.eq.mpr (by simp)
          show ULift.up (φ ((((h : G) * y)⁻¹ : G) : G ⧸ S)) = _
          rw [h2, Representation.trivial_apply]⟩
        left_inv := fun f => by
          apply Subtype.ext
          funext y
          show ULift.up ((f.1 (y⁻¹)⁻¹).down) = f.1 y
          rw [inv_inv]
        right_inv := fun φ => by
          funext x
          obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective x
          show φ (((y⁻¹)⁻¹ : G) : G ⧸ S) = φ (y : G ⧸ S)
          rw [inv_inv] }, ?_⟩
      intro g f x
      obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective x
      rw [MulAction.Quotient.smul_mk]
      show (f.1 (y⁻¹ * g)).down = (f.1 (g⁻¹ • y)⁻¹).down
      rw [smul_eq_mul, mul_inv_rev, inv_inv]
    refine ⟨LinearEquiv.finiteDimensional e.symm, ?_, ?_⟩
    · intro g hg
      apply LinearMap.ext
      intro f
      apply Subtype.ext
      funext x
      show f.1 (x * g) = f.1 x
      have hn : x * g * x⁻¹ ∈ K0 := Subgroup.Normal.conj_mem inferInstance g hg x
      have h3 := hmem f.1 f.2 ⟨x * g * x⁻¹, hS hn⟩ x
      simp only [inv_mul_cancel_right] at h3
      exact h3
    · intro g
      have hconj :
          e.conj (EllipticRootNumber.indRep S (Representation.trivial k S (ULift.{u} k)) g) =
            LinearMap.funLeft k k (fun x : G ⧸ S => g⁻¹ • x) := by
        apply LinearMap.ext
        intro φ
        funext x
        rw [LinearEquiv.conj_apply]
        simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearMap.funLeft_apply]
        rw [he, LinearEquiv.apply_symm_apply]
      rw [← LinearMap.trace_conj' _ e, hconj, trfun, ← MulAction.fixedBy_inv (G ⧸ S) g]
      rfl
  induction L with
  | nil =>
    refine ⟨X₀, inferInstance, inferInstance, inferInstance, τ₀, h₀, ?_, ?_⟩
    · intro g
      simp
    · intro Φ _
      simp
  | cons S L ih =>
    obtain ⟨Y', _, _, _, τ', hτ'K, hτ'tr, hτ'Φ⟩ := ih (fun T hT => hL T (by simp [hT]))
    obtain ⟨hfd, hπK, hπtr⟩ := key S (hL S (by simp))
    have hK : ∀ g ∈ K0, (τ'.prod (EllipticRootNumber.indRep S
        (Representation.trivial k S (ULift.{u} k)))) g = 1 := by
      intro g hg
      show (τ' g).prodMap (EllipticRootNumber.indRep S
        (Representation.trivial k S (ULift.{u} k)) g) = 1
      rw [hτ'K g hg, hπK g hg]
      exact LinearMap.prodMap_one
    refine ⟨Y' × EllipticRootNumber.indSpace S (Representation.trivial k S (ULift.{u} k)),
      inferInstance, inferInstance, inferInstance,
      τ'.prod (EllipticRootNumber.indRep S (Representation.trivial k S (ULift.{u} k))),
      hK, ?_, ?_⟩
    · intro g
      show LinearMap.trace k _ ((τ' g).prodMap (EllipticRootNumber.indRep S
        (Representation.trivial k S (ULift.{u} k)) g)) = _
      rw [LinearMap.trace_prodMap', hτ'tr g, hπtr g]
      simp only [List.map_cons, List.sum_cons, Nat.cast_add]
      ring
    · intro Φ hΦ
      have h := hΦ τ' (τ'.prod (EllipticRootNumber.indRep S
          (Representation.trivial k S (ULift.{u} k))))
        (EllipticRootNumber.indRep S (Representation.trivial k S (ULift.{u} k)))
        hτ'K hK hπK (LinearMap.inl k _ _) (LinearMap.snd k _ _)
        (fun g => LinearMap.ext fun v => by
          show (τ' g v, 0) = (τ' g v, EllipticRootNumber.indRep S
            (Representation.trivial k S (ULift.{u} k)) g 0)
          rw [map_zero])
        (fun g => LinearMap.ext fun w => rfl)
        LinearMap.inl_injective LinearMap.snd_surjective (LinearMap.range_inl k _ _)
      rw [h, hτ'Φ Φ hΦ, List.map_cons, List.prod_cons]
      ac_rfl

theorem phi_eq_of_trace_eq {k : Type} [Field k] [IsAlgClosed k] [CharZero k]
    {G : Type u} [Group G] (K0 : Subgroup G) [K0.Normal] [K0.FiniteIndex]
    (Φ : ∀ {X : Type u} [AddCommGroup X] [Module k X], Representation k G X → kˣ)
    (hΦ : ∀ {X₁ X X₂ : Type u} [AddCommGroup X₁] [Module k X₁] [AddCommGroup X] [Module k X]
      [AddCommGroup X₂] [Module k X₂] [FiniteDimensional k X₁] [FiniteDimensional k X]
      [FiniteDimensional k X₂]
      (τ₁ : Representation k G X₁) (τ : Representation k G X) (τ₂ : Representation k G X₂),
      (∀ g ∈ K0, τ₁ g = 1) → (∀ g ∈ K0, τ g = 1) → (∀ g ∈ K0, τ₂ g = 1) →
      ∀ (f : X₁ →ₗ[k] X) (q : X →ₗ[k] X₂),
        (∀ g, f ∘ₗ τ₁ g = τ g ∘ₗ f) → (∀ g, q ∘ₗ τ g = τ₂ g ∘ₗ q) →
        Function.Injective f → Function.Surjective q → LinearMap.range f = LinearMap.ker q →
        Φ τ = Φ τ₁ * Φ τ₂)
    {Y Y' : Type u} [AddCommGroup Y] [Module k Y] [FiniteDimensional k Y]
    [AddCommGroup Y'] [Module k Y'] [FiniteDimensional k Y']
    (σ : Representation k G Y) (σ' : Representation k G Y')
    (hσ : ∀ g ∈ K0, σ g = 1) (hσ' : ∀ g ∈ K0, σ' g = 1)
    (htr : ∀ g : G, LinearMap.trace k Y (σ g) = LinearMap.trace k Y' (σ' g)) :
    Φ σ = Φ σ' :=
by
  classical
  
  have traceAdd : ∀ {V₁ V V₂ : Type u} [AddCommGroup V₁] [Module k V₁] [AddCommGroup V]
      [Module k V] [AddCommGroup V₂] [Module k V₂] [FiniteDimensional k V]
      (a₁ : V₁ →ₗ[k] V₁) (a : V →ₗ[k] V) (a₂ : V₂ →ₗ[k] V₂) (f : V₁ →ₗ[k] V) (g : V →ₗ[k] V₂),
      f ∘ₗ a₁ = a ∘ₗ f → g ∘ₗ a = a₂ ∘ₗ g → Function.Injective f → Function.Surjective g →
      LinearMap.range f = LinearMap.ker g →
      LinearMap.trace k V a = LinearMap.trace k V₁ a₁ + LinearMap.trace k V₂ a₂ := by
    intro V₁ V V₂ _ _ _ _ _ _ _ a₁ a a₂ f g hf hg hfi hgs hex
    haveI : FiniteDimensional k V₁ := Module.Finite.of_injective f hfi
    haveI : FiniteDimensional k V₂ := Module.Finite.of_surjective g hgs
    obtain ⟨r₀, hr₀⟩ := LinearMap.exists_leftInverse_of_injective f (LinearMap.ker_eq_bot.mpr hfi)
    obtain ⟨s, hs⟩ :=
      LinearMap.exists_rightInverse_of_surjective g (LinearMap.range_eq_top.mpr hgs)
    have hgf : ∀ x, g (f x) = 0 := by
      intro x
      have : f x ∈ LinearMap.ker g := hex ▸ LinearMap.mem_range_self f x
      simpa using this
    have hr₀x : ∀ x, r₀ (f x) = x := fun x => by
      simpa using congrArg (fun h => h x) hr₀
    have hsx : ∀ y, g (s y) = y := fun y => by
      simpa using congrArg (fun h => h y) hs
    set r : V →ₗ[k] V₁ := r₀ ∘ₗ (LinearMap.id - s ∘ₗ g) with hr
    have hrf : r ∘ₗ f = LinearMap.id := by
      ext x
      simp [hr, hgf, hr₀x]
    have hdec : f ∘ₗ r + s ∘ₗ g = LinearMap.id := by
      ext v
      have hmem : v - s (g v) ∈ LinearMap.ker g := by
        simp [hsx]
      rw [← hex] at hmem
      obtain ⟨u, hu⟩ := hmem
      have hrv : r v = u := by
        simp only [hr, LinearMap.comp_apply, LinearMap.sub_apply, LinearMap.id_apply]
        rw [← hu, hr₀x]
      simp only [LinearMap.add_apply, LinearMap.comp_apply, LinearMap.id_apply, hrv, hu]
      abel
    have e1 : r ∘ₗ (a ∘ₗ f) = a₁ := by
      rw [← hf, ← LinearMap.comp_assoc, hrf, LinearMap.id_comp]
    have e2 : g ∘ₗ (a ∘ₗ s) = a₂ := by
      rw [← LinearMap.comp_assoc, hg, LinearMap.comp_assoc, hs, LinearMap.comp_id]
    calc LinearMap.trace k V a = LinearMap.trace k V (a ∘ₗ (f ∘ₗ r + s ∘ₗ g)) := by
          rw [hdec, LinearMap.comp_id]
      _ = LinearMap.trace k V ((a ∘ₗ f) ∘ₗ r) + LinearMap.trace k V ((a ∘ₗ s) ∘ₗ g) := by
          rw [LinearMap.comp_add, map_add, LinearMap.comp_assoc, LinearMap.comp_assoc]
      _ = LinearMap.trace k V₁ (r ∘ₗ (a ∘ₗ f)) + LinearMap.trace k V₂ (g ∘ₗ (a ∘ₗ s)) := by
          rw [LinearMap.trace_comp_comm' r (a ∘ₗ f), LinearMap.trace_comp_comm' g (a ∘ₗ s)]
      _ = _ := by rw [e1, e2]
  
  have phiZero : ∀ {Z : Type u} [AddCommGroup Z] [Module k Z] [FiniteDimensional k Z]
      [Subsingleton Z] (ρ : Representation k G Z), (∀ g ∈ K0, ρ g = 1) → Φ ρ = 1 := by
    intro Z _ _ _ _ ρ hρ
    have h := hΦ ρ ρ ρ hρ hρ hρ 0 0
      (fun g => by rw [LinearMap.zero_comp, LinearMap.comp_zero])
      (fun g => by rw [LinearMap.zero_comp, LinearMap.comp_zero])
      (fun a b _ => Subsingleton.elim a b) (fun b => ⟨0, Subsingleton.elim _ _⟩)
      (Subsingleton.elim _ _)
    exact mul_left_cancel (h.symm.trans (mul_one _).symm)
  
  haveI : Fintype (G ⧸ K0) := Subgroup.fintypeQuotientOfFiniteIndex
  have hcard : (Fintype.card (G ⧸ K0) : k) ≠ 0 := Nat.cast_ne_zero.mpr Fintype.card_ne_zero
  letI : Invertible (Fintype.card (G ⧸ K0) : k) := invertibleOfNonzero hcard
  have avg : ∀ {V : Type u} [AddCommGroup V] [Module k V] [FiniteDimensional k V]
      (τ : Representation k G V), (∀ g ∈ K0, τ g = 1) →
      (Fintype.card (G ⧸ K0) : k) * (Module.finrank k τ.invariants : k) =
        ∑ q : G ⧸ K0, LinearMap.trace k V (τ q.out) := by
    intro V _ _ _ τ hτ
    haveI : Representation.IsTrivial (τ.comp K0.subtype) := ⟨fun g => hτ g.1 g.2⟩
    have hinv : (τ.ofQuotient K0).invariants = τ.invariants := by
      ext v
      simp only [Representation.mem_invariants]
      constructor
      · intro h g
        have := h (g : G ⧸ K0)
        rwa [Representation.ofQuotient_coe_apply] at this
      · intro h q
        obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective q
        rw [Representation.ofQuotient_coe_apply]
        exact h g
    have hq : ∀ q : G ⧸ K0, (τ.ofQuotient K0) q = τ q.out := by
      intro q
      apply LinearMap.ext
      intro v
      conv_lhs => rw [← QuotientGroup.out_eq' q]
      exact Representation.ofQuotient_coe_apply τ K0 q.out v
    have hA : (τ.ofQuotient K0).averageMap =
        ⅟(Fintype.card (G ⧸ K0) : k) • ∑ q : G ⧸ K0, (τ.ofQuotient K0) q := by
      unfold Representation.averageMap GroupAlgebra.average
      rw [map_smul, map_sum]
      simp only [Representation.asAlgebraHom_of]
    have hP := (τ.ofQuotient K0).isProj_averageMap
    have htrP := hP.trace
    rw [hinv, hA, map_smul, map_sum] at htrP
    simp only [hq, smul_eq_mul] at htrP
    rw [← htrP, ← mul_assoc, mul_invOf_self, one_mul]
  
  have trLin : ∀ {X Z : Type u} [AddCommGroup X] [Module k X] [AddCommGroup Z] [Module k Z]
      [FiniteDimensional k X] [FiniteDimensional k Z]
      (ρ : Representation k G X) (τ : Representation k G Z) (g : G),
      LinearMap.trace k (X →ₗ[k] Z) (ρ.linHom τ g) =
        LinearMap.trace k X (ρ g⁻¹) * LinearMap.trace k Z (τ g) := by
    intro X Z _ _ _ _ _ _ ρ τ g
    obtain ⟨e, he⟩ : ∃ e : TensorProduct k (Module.Dual k X) Z ≃ₗ[k] (X →ₗ[k] Z),
        (e : TensorProduct k (Module.Dual k X) Z →ₗ[k] (X →ₗ[k] Z)) = dualTensorHom k X Z :=
      ⟨dualTensorHomEquiv k X Z, dualTensorHomEquivOfBasis_toLinearMap _⟩
    have hc : ρ.linHom τ g = e.conj (TensorProduct.map (ρ.dual g) (τ g)) := by
      apply LinearMap.ext
      intro φ
      rw [LinearEquiv.conj_apply]
      have := congrArg (fun h => h (e.symm φ)) (Representation.dualTensorHom_comm ρ τ g)
      simp only [LinearMap.comp_apply] at this ⊢
      rw [← he] at this
      simp only [LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply] at this ⊢
      exact this.symm
    rw [hc]
    refine (LinearMap.trace_conj' (R := k) (M := TensorProduct k (Module.Dual k X) Z)
      (N := X →ₗ[k] Z) (TensorProduct.map (ρ.dual g) (τ g)) e).trans ?_
    rw [LinearMap.trace_tensorProduct', Representation.dual_apply, LinearMap.trace_transpose']
  
  have linTriv : ∀ {X Z : Type u} [AddCommGroup X] [Module k X] [AddCommGroup Z] [Module k Z]
      (ρ : Representation k G X) (τ : Representation k G Z),
      (∀ g ∈ K0, ρ g = 1) → (∀ g ∈ K0, τ g = 1) → ∀ g ∈ K0, ρ.linHom τ g = 1 := by
    intro X Z _ _ _ _ ρ τ hρ hτ g hg
    apply LinearMap.ext
    intro φ
    rw [Representation.linHom_apply, hτ g hg, hρ g⁻¹ (K0.inv_mem hg)]
    rfl
  
  have memInv : ∀ {X Z : Type u} [AddCommGroup X] [Module k X] [AddCommGroup Z] [Module k Z]
      (ρ : Representation k G X) (τ : Representation k G Z) (φ : X →ₗ[k] Z),
      φ ∈ (ρ.linHom τ).invariants ↔ ∀ g, φ ∘ₗ ρ g = τ g ∘ₗ φ := by
    intro X Z _ _ _ _ ρ τ φ
    rw [Representation.mem_invariants]
    have hinvl : ∀ g x, ρ g⁻¹ (ρ g x) = x := fun g x => by
      rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one, Module.End.one_apply]
    have hinvr : ∀ g x, ρ g (ρ g⁻¹ x) = x := fun g x => by
      rw [← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one, Module.End.one_apply]
    constructor
    · intro h g
      apply LinearMap.ext
      intro x
      have := congrArg (fun ψ => ψ (ρ g x)) (h g)
      simp only [Representation.linHom_apply, LinearMap.comp_apply, hinvl] at this
      simp only [LinearMap.comp_apply]
      exact this.symm
    · intro h g
      apply LinearMap.ext
      intro x
      simp only [Representation.linHom_apply, LinearMap.comp_apply]
      have := congrArg (fun ψ => ψ (ρ g⁻¹ x)) (h g)
      simp only [LinearMap.comp_apply, hinvr] at this
      exact this.symm
  
  have transfer : ∀ {X Z Z' : Type u} [AddCommGroup X] [Module k X] [FiniteDimensional k X]
      [AddCommGroup Z] [Module k Z] [FiniteDimensional k Z]
      [AddCommGroup Z'] [Module k Z'] [FiniteDimensional k Z']
      (ρ : Representation k G X) (τ : Representation k G Z) (τ' : Representation k G Z'),
      (∀ g ∈ K0, ρ g = 1) → (∀ g ∈ K0, τ g = 1) → (∀ g ∈ K0, τ' g = 1) →
      (∀ g, LinearMap.trace k Z (τ g) = LinearMap.trace k Z' (τ' g)) →
      ∀ f : X →ₗ[k] Z, f ≠ 0 → (∀ g, f ∘ₗ ρ g = τ g ∘ₗ f) →
      ∃ f' : X →ₗ[k] Z', f' ≠ 0 ∧ ∀ g, f' ∘ₗ ρ g = τ' g ∘ₗ f' := by
    intro X Z Z' _ _ _ _ _ _ _ _ _ ρ τ τ' hρ hτ hτ' htr' f hf0 hf
    have e1 := avg (ρ.linHom τ) (linTriv ρ τ hρ hτ)
    have e2 := avg (ρ.linHom τ') (linTriv ρ τ' hρ hτ')
    have hsum : ∑ q : G ⧸ K0, LinearMap.trace k (X →ₗ[k] Z) (ρ.linHom τ q.out) =
        ∑ q : G ⧸ K0, LinearMap.trace k (X →ₗ[k] Z') (ρ.linHom τ' q.out) :=
      Finset.sum_congr rfl fun q _ => by rw [trLin, trLin, htr']
    have hfr : Module.finrank k (ρ.linHom τ).invariants =
        Module.finrank k (ρ.linHom τ').invariants := by
      have := mul_left_cancel₀ hcard (e1.trans (hsum.trans e2.symm))
      exact_mod_cast this
    have hfmem : f ∈ (ρ.linHom τ).invariants := (memInv ρ τ f).mpr hf
    have hne : (ρ.linHom τ).invariants ≠ ⊥ := by
      intro h
      rw [h] at hfmem
      exact hf0 ((Submodule.mem_bot k).mp hfmem)
    have hne' : (ρ.linHom τ').invariants ≠ ⊥ := by
      rw [← Submodule.one_le_finrank_iff] at hne ⊢
      rw [← hfr]
      exact hne
    obtain ⟨f', hf'mem, hf'0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne'
    exact ⟨f', hf'0, (memInv ρ τ' f').mp hf'mem⟩
  
  have peel : ∀ {X₁ X : Type u} [AddCommGroup X₁] [Module k X₁] [AddCommGroup X] [Module k X]
      [FiniteDimensional k X₁] [FiniteDimensional k X]
      (τ₁ : Representation k G X₁) (τ : Representation k G X),
      (∀ g ∈ K0, τ₁ g = 1) → (∀ g ∈ K0, τ g = 1) →
      ∀ ι : X₁ →ₗ[k] X, (∀ g, ι ∘ₗ τ₁ g = τ g ∘ₗ ι) → Function.Injective ι →
      ∃ τ₂ : Representation k G (X ⧸ LinearMap.range ι), (∀ g ∈ K0, τ₂ g = 1) ∧
        Φ τ = Φ τ₁ * Φ τ₂ ∧
        (∀ g, LinearMap.trace k X (τ g) =
          LinearMap.trace k X₁ (τ₁ g) + LinearMap.trace k (X ⧸ LinearMap.range ι) (τ₂ g)) ∧
        Module.finrank k (X ⧸ LinearMap.range ι) + Module.finrank k X₁ =
          Module.finrank k X := by
    intro X₁ X _ _ _ _ _ _ τ₁ τ h₁ h ι hι hinj
    have hR : ∀ g, LinearMap.range ι ≤ (LinearMap.range ι).comap (τ g) := by
      rintro g _ ⟨v, rfl⟩
      have := congrArg (fun F => F v) (hι g)
      simp only [LinearMap.comp_apply] at this
      rw [Submodule.mem_comap]
      exact LinearMap.mem_range.mpr ⟨τ₁ g v, this⟩
    have h₂ : ∀ g ∈ K0, τ.quotient _ hR g = 1 := by
      intro g hg
      apply LinearMap.ext
      intro x
      obtain ⟨v, rfl⟩ := Submodule.mkQ_surjective _ x
      rw [Representation.quotient_apply, Submodule.mkQ_apply, Submodule.mapQ_apply, h g hg]
      rfl
    have hmk : ∀ g, (LinearMap.range ι).mkQ ∘ₗ τ g =
        τ.quotient _ hR g ∘ₗ (LinearMap.range ι).mkQ := by
      intro g
      rw [Representation.quotient_apply, Submodule.mapQ_mkQ]
    refine ⟨τ.quotient _ hR, h₂, ?_, ?_, ?_⟩
    · exact hΦ τ₁ τ _ h₁ h h₂ ι _ hι hmk hinj (Submodule.mkQ_surjective _)
        (Submodule.ker_mkQ _).symm
    · intro g
      exact traceAdd (τ₁ g) (τ g) _ ι _ (hι g) (hmk g) hinj (Submodule.mkQ_surjective _)
        (Submodule.ker_mkQ _).symm
    · rw [← LinearMap.finrank_range_of_inj hinj]
      exact Submodule.finrank_quotient_add_finrank _
  
  have main : ∀ n : ℕ, ∀ {Z Z' : Type u} [AddCommGroup Z] [Module k Z] [FiniteDimensional k Z]
      [AddCommGroup Z'] [Module k Z'] [FiniteDimensional k Z']
      (τ : Representation k G Z) (τ' : Representation k G Z'),
      (∀ g ∈ K0, τ g = 1) → (∀ g ∈ K0, τ' g = 1) →
      (∀ g, LinearMap.trace k Z (τ g) = LinearMap.trace k Z' (τ' g)) →
      Module.finrank k Z = n → Φ τ = Φ τ' := by
    intro n
    induction n using Nat.strong_induction_on
    rename_i n ih
    intro Z Z' _ _ _ _ _ _ τ τ' hτ hτ' htr' hn
    have hdim : Module.finrank k Z = Module.finrank k Z' := by
      have := htr' 1
      rw [map_one τ, map_one τ', LinearMap.trace_one, LinearMap.trace_one] at this
      exact_mod_cast this
    rcases Nat.eq_zero_or_pos n with h0 | hpos
    · haveI : Subsingleton Z := Module.finrank_zero_iff.mp (hn.trans h0)
      haveI : Subsingleton Z' := Module.finrank_zero_iff.mp (hdim.symm.trans (hn.trans h0))
      rw [phiZero τ hτ, phiZero τ' hτ']
    · have htop : (⊤ : Submodule k Z) ≠ ⊥ := by
        intro h
        have h1 := finrank_top k Z
        rw [h, finrank_bot] at h1
        omega
      have hex : ∃ m, ∃ W : Submodule k Z, W ≠ ⊥ ∧ (∀ g, W ≤ W.comap (τ g)) ∧
          Module.finrank k W = m :=
        ⟨_, ⊤, htop, fun g => le_top, rfl⟩
      obtain ⟨W, hW0, hWs, hWm⟩ := Nat.find_spec hex
      have hmin : ∀ U : Submodule k Z, U ≠ ⊥ → (∀ g, U ≤ U.comap (τ g)) →
          Module.finrank k W ≤ Module.finrank k U := by
        intro U hU hUs
        rw [hWm]
        exact Nat.find_min' hex ⟨U, hU, hUs, rfl⟩
      set τW := τ.subrepresentation W hWs with hτW
      have hτW1 : ∀ g ∈ K0, τW g = 1 := by
        intro g hg
        apply LinearMap.ext
        intro w
        apply Subtype.ext
        show τ g (w : Z) = (w : Z)
        rw [hτ g hg]
        rfl
      have hsub : ∀ g, W.subtype ∘ₗ τW g = τ g ∘ₗ W.subtype := fun g => rfl
      have hsub0 : W.subtype ≠ 0 := by
        intro h
        obtain ⟨w, hw, hw0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hW0
        apply hw0
        have := congrArg (fun F => F ⟨w, hw⟩) h
        simpa using this
      obtain ⟨ι, hι0, hι⟩ := transfer τW τ τ' hτW1 hτ hτ' htr' W.subtype hsub0 hsub
      
      have hinj : Function.Injective ι := by
        rw [← LinearMap.ker_eq_bot]
        by_contra hK
        have hUs : ∀ g, (LinearMap.ker ι).map W.subtype ≤
            ((LinearMap.ker ι).map W.subtype).comap (τ g) := by
          rintro g _ ⟨w, hw, rfl⟩
          rw [Submodule.mem_comap]
          refine ⟨τW g w, ?_, rfl⟩
          rw [SetLike.mem_coe, LinearMap.mem_ker] at hw ⊢
          have := congrArg (fun F => F w) (hι g)
          simp only [LinearMap.comp_apply] at this
          rw [this, hw, map_zero]
        have hU0 : (LinearMap.ker ι).map W.subtype ≠ ⊥ := by
          rw [← Submodule.one_le_finrank_iff, Submodule.finrank_map_subtype_eq,
            Submodule.one_le_finrank_iff]
          exact hK
        have h1 := hmin _ hU0 hUs
        rw [Submodule.finrank_map_subtype_eq] at h1
        have h2 : LinearMap.ker ι = ⊤ :=
          Submodule.eq_top_of_finrank_eq (le_antisymm (Submodule.finrank_le _) h1)
        exact hι0 (LinearMap.ker_eq_top.mp h2)
      obtain ⟨τ₂, hτ₂, hΦ₂, htr₂, hdim₂⟩ :=
        peel τW τ hτW1 hτ W.subtype hsub Subtype.val_injective
      obtain ⟨τ₂', hτ₂', hΦ₂', htr₂', hdim₂'⟩ := peel τW τ' hτW1 hτ' ι hι hinj
      have htrQ : ∀ g, LinearMap.trace k _ (τ₂ g) = LinearMap.trace k _ (τ₂' g) := by
        intro g
        have := (htr₂ g).symm.trans ((htr' g).trans (htr₂' g))
        exact add_left_cancel this
      have hW1 : 1 ≤ Module.finrank k W := Submodule.one_le_finrank_iff.mpr hW0
      have hlt : Module.finrank k (Z ⧸ LinearMap.range W.subtype) < n := by omega
      have := ih _ hlt τ₂ τ₂' hτ₂ hτ₂' htrQ rfl
      rw [hΦ₂, hΦ₂', this]
  exact main _ σ σ' hσ hσ' htr rfl

theorem solomon_permutation_relation {k : Type} [Field k] [IsAlgClosed k] [CharZero k]
    {G : Type u} [Group G] (K0 : Subgroup G) [K0.Normal] [K0.FiniteIndex] :
    ∃ Lp Lm : List (Subgroup G),
      (∀ S ∈ Lp ++ Lm, K0 ≤ S ∧ ∃ (C : Subgroup G) (c₀ : G) (p : ℕ), p.Prime ∧ K0 ≤ C ∧ C ≤ S ∧
          (∀ s ∈ S, ∀ c ∈ C, s * c * s⁻¹ ∈ C) ∧ c₀ ∈ C ∧
          (∀ c ∈ C, ∃ n : ℤ, c * (c₀ ^ n)⁻¹ ∈ K0) ∧ (∀ s ∈ S, ∃ n : ℕ, s ^ (p ^ n) ∈ C)) ∧
      ∀ Φ : (∀ {X : Type u} [AddCommGroup X] [Module k X], Representation k G X → kˣ),
        (∀ {X₁ X X₂ : Type u} [AddCommGroup X₁] [Module k X₁] [AddCommGroup X] [Module k X]
          [AddCommGroup X₂] [Module k X₂] [FiniteDimensional k X₁] [FiniteDimensional k X]
          [FiniteDimensional k X₂]
          (τ₁ : Representation k G X₁) (τ : Representation k G X) (τ₂ : Representation k G X₂),
          (∀ g ∈ K0, τ₁ g = 1) → (∀ g ∈ K0, τ g = 1) → (∀ g ∈ K0, τ₂ g = 1) →
          ∀ (f : X₁ →ₗ[k] X) (q : X →ₗ[k] X₂),
            (∀ g, f ∘ₗ τ₁ g = τ g ∘ₗ f) → (∀ g, q ∘ₗ τ g = τ₂ g ∘ₗ q) →
            Function.Injective f → Function.Surjective q → LinearMap.range f = LinearMap.ker q →
            Φ τ = Φ τ₁ * Φ τ₂) →
        Φ (Representation.trivial k G (ULift.{u} k)) *
            (Lm.map fun S => Φ (EllipticRootNumber.indRep S
              (Representation.trivial k S (ULift.{u} k)))).prod =
          (Lp.map fun S => Φ (EllipticRootNumber.indRep S
              (Representation.trivial k S (ULift.{u} k)))).prod :=
by
  obtain ⟨Lp, Lm, hhyp, hfix⟩ := solomon_fixed_point_identity K0
  refine ⟨Lp, Lm, hhyp, ?_⟩
  intro Φ hΦ
  have hLm : ∀ S ∈ Lm, K0 ≤ S := fun S h => (hhyp S (List.mem_append_right Lp h)).1
  have hLp : ∀ S ∈ Lp, K0 ≤ S := fun S h => (hhyp S (List.mem_append_left Lm h)).1
  have htrivid : ∀ (V : Type u) [AddCommGroup V] [Module k V] (g : G),
      (Representation.trivial k G V) g = LinearMap.id := fun V _ _ g =>
    LinearMap.ext fun v => by simp
  
  have h1K : ∀ g ∈ K0, (Representation.trivial k G (ULift.{u} k)) g = 1 := fun g _ =>
    htrivid _ g
  have htr1 : ∀ g : G, LinearMap.trace k (ULift.{u} k)
      ((Representation.trivial k G (ULift.{u} k)) g) = 1 := by
    intro g
    rw [htrivid, LinearMap.trace_id,
      (ULift.moduleEquiv.finrank_eq).trans (Module.finrank_self k), Nat.cast_one]
  
  have hzK : ∀ g ∈ K0, (Representation.trivial k G PUnit.{u+1}) g = 1 := fun g _ =>
    htrivid _ g
  have htrz : ∀ g : G, LinearMap.trace k PUnit.{u+1}
      ((Representation.trivial k G PUnit.{u+1}) g) = 0 := by
    intro g
    rw [htrivid, LinearMap.trace_id, Module.finrank_zero_of_subsingleton,
      Nat.cast_zero]
  have hz1 : Φ (Representation.trivial k G PUnit.{u+1}) = 1 := by
    have h := hΦ (Representation.trivial k G PUnit.{u+1}) (Representation.trivial k G PUnit.{u+1})
      (Representation.trivial k G PUnit.{u+1}) hzK hzK hzK 0 0
      (fun g => by rw [LinearMap.zero_comp, LinearMap.comp_zero])
      (fun g => by rw [LinearMap.zero_comp, LinearMap.comp_zero])
      (fun a b _ => Subsingleton.elim a b) (fun b => ⟨0, Subsingleton.elim _ _⟩)
      (Subsingleton.elim _ _)
    exact mul_left_cancel (h.symm.trans (mul_one _).symm)
  obtain ⟨Ym, _, _, _, τm, hτmK, hτmtr, hτmΦ⟩ :=
    indRep_trivial_list_sum K0 (Representation.trivial k G (ULift.{u} k)) h1K Lm hLm
  obtain ⟨Yp, _, _, _, τp, hτpK, hτptr, hτpΦ⟩ :=
    indRep_trivial_list_sum K0 (Representation.trivial k G PUnit.{u+1}) hzK Lp hLp
  have htr : ∀ g : G, LinearMap.trace k Ym (τm g) = LinearMap.trace k Yp (τp g) := by
    intro g
    rw [hτmtr g, hτptr g, htr1 g, htrz g, ← hfix g]
    push_cast
    ring
  calc Φ (Representation.trivial k G (ULift.{u} k)) *
        (Lm.map fun S => Φ (EllipticRootNumber.indRep S
          (Representation.trivial k S (ULift.{u} k)))).prod
      = Φ τm := (hτmΦ Φ hΦ).symm
    _ = Φ τp := phi_eq_of_trace_eq K0 Φ hΦ τm τp hτmK hτpK htr
    _ = _ := by rw [hτpΦ Φ hΦ, hz1, one_mul]

theorem monomial_or_line_of_hyperelementary {k : Type} [Field k] [IsAlgClosed k] [CharZero k]
    {G : Type u} [Group G] {V : Type u} [AddCommGroup V] [Module k V]
    (ρ : Representation k G V) (hdim : Module.finrank k V = 2)
    (K0 : Subgroup G) [K0.Normal] [K0.FiniteIndex] (ω : G →* kˣ)
    (hscal : ∀ g ∈ K0, ρ g = (ω g : k) • LinearMap.id)
    (S C : Subgroup G) (c₀ : G) (p : ℕ) (hp : p.Prime) (hK0C : K0 ≤ C) (hCS : C ≤ S)
    (hCn : ∀ s ∈ S, ∀ c ∈ C, s * c * s⁻¹ ∈ C) (hc₀ : c₀ ∈ C)
    (hcyc : ∀ c ∈ C, ∃ n : ℤ, c * (c₀ ^ n)⁻¹ ∈ K0) (hpow : ∀ s ∈ S, ∃ n : ℕ, s ^ (p ^ n) ∈ C) :
    (∃ L : Submodule k V, Module.finrank k L = 1 ∧ ∀ s ∈ S, ∀ v ∈ L, ρ s v ∈ L) ∨
    (∃ S' : Subgroup G, K0 ≤ S' ∧ S' ≤ S ∧
      (∃ t ∈ S, t ∉ S' ∧ ∀ g ∈ S, g ∉ S' → g * t⁻¹ ∈ S') ∧
      ∃ L : Submodule k V, Module.finrank k L = 1 ∧ (∀ s ∈ S', ∀ v ∈ L, ρ s v ∈ L) ∧
        ∃ s ∈ S, ∃ v ∈ L, ρ s v ∉ L) :=
by
  classical
  have hK0S : K0 ≤ S := hK0C.trans hCS
  
  have hinvl : ∀ (g : G) (x : V), ρ g⁻¹ (ρ g x) = x := by
    intro g x
    rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one, Module.End.one_apply]
  have hinvr : ∀ (g : G) (x : V), ρ g (ρ g⁻¹ x) = x := by
    intro g x
    rw [← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one, Module.End.one_apply]
  have hinj : ∀ (g : G) (x : V), ρ g x = 0 → x = 0 := by
    intro g x h
    rw [← hinvl g x, h, map_zero]
  
  have s1 : ∀ (g : G) (v : V) (μ : k), ρ g v = μ • v → ∀ n : ℤ, ρ (g ^ n) v = μ ^ n • v := by
    intro g v μ h n
    by_cases hv : v = 0
    · rw [hv, map_zero, smul_zero]
    have hμ : μ ≠ 0 := by
      rintro rfl
      apply hv
      rw [← hinvl g v, h, zero_smul, map_zero]
    have hgi : ρ g⁻¹ v = μ⁻¹ • v := by
      have h1 : μ • ρ g⁻¹ v = v := by rw [← map_smul, ← h, hinvl]
      calc ρ g⁻¹ v = μ⁻¹ • (μ • ρ g⁻¹ v) := by rw [smul_smul, inv_mul_cancel₀ hμ, one_smul]
        _ = μ⁻¹ • v := by rw [h1]
    refine Int.induction_on n ?_ ?_ ?_
    · rw [zpow_zero, zpow_zero, map_one, Module.End.one_apply, one_smul]
    · intro i ih
      rw [zpow_add_one, map_mul, Module.End.mul_apply, h, map_smul, ih, smul_smul,
        zpow_add_one₀ hμ, mul_comm]
    · intro i ih
      rw [zpow_sub_one, map_mul, Module.End.mul_apply, hgi, map_smul, ih, smul_smul,
        zpow_sub_one₀ hμ, mul_comm]
  
  have s2 : ∀ T : V →ₗ[k] V, (∀ a : k, T ≠ a • LinearMap.id) →
      (∀ s ∈ S, ∀ (v : V) (μ : k), T v = μ • v → ∃ μ' : k, T (ρ s v) = μ' • ρ s v) →
      ((∃ L : Submodule k V, Module.finrank k L = 1 ∧ ∀ s ∈ S, ∀ v ∈ L, ρ s v ∈ L) ∨
      (∃ S' : Subgroup G, K0 ≤ S' ∧ S' ≤ S ∧
        (∃ t ∈ S, t ∉ S' ∧ ∀ g ∈ S, g ∉ S' → g * t⁻¹ ∈ S') ∧
        ∃ L : Submodule k V, Module.finrank k L = 1 ∧ (∀ s ∈ S', ∀ v ∈ L, ρ s v ∈ L) ∧
          ∃ s ∈ S, ∃ v ∈ L, ρ s v ∉ L)) := by
    intro T hT hperm
    haveI : FiniteDimensional k V := Module.finite_of_finrank_pos (by omega)
    haveI : Nontrivial V := Module.nontrivial_of_finrank_pos (R := k) (by rw [hdim]; norm_num)
    obtain ⟨l1, hl1⟩ := Module.End.exists_eigenvalue T
    obtain ⟨v1, hv1⟩ := hl1.exists_hasEigenvector
    have hTv1 : T v1 = l1 • v1 := hv1.apply_eq_smul
    have hv1ne : v1 ≠ 0 := hv1.2
    let S' : Subgroup G :=
      { carrier := {g | g ∈ S ∧ ∃ a : k, ρ g v1 = a • v1}
        mul_mem' := by
          rintro x y ⟨hx, a, ha⟩ ⟨hy, b, hb⟩
          exact ⟨S.mul_mem hx hy, b * a, by
            rw [map_mul, Module.End.mul_apply, hb, map_smul, ha, smul_smul]⟩
        one_mem' := ⟨S.one_mem, 1, by rw [map_one, Module.End.one_apply, one_smul]⟩
        inv_mem' := by
          rintro x ⟨hx, a, ha⟩
          refine ⟨S.inv_mem hx, a⁻¹, ?_⟩
          have h1 : a • ρ x⁻¹ v1 = v1 := by rw [← map_smul, ← ha, hinvl]
          have ha0 : a ≠ 0 := by
            rintro rfl
            rw [zero_smul] at h1
            exact hv1ne h1.symm
          calc ρ x⁻¹ v1 = a⁻¹ • (a • ρ x⁻¹ v1) := by rw [smul_smul, inv_mul_cancel₀ ha0, one_smul]
            _ = a⁻¹ • v1 := by rw [h1] }
    have hS' : ∀ g : G, g ∈ S' ↔ g ∈ S ∧ ∃ a : k, ρ g v1 = a • v1 := fun g => Iff.rfl
    let L1 : Submodule k V := Submodule.span k {v1}
    have hL1 : Module.finrank k L1 = 1 := finrank_span_singleton hv1ne
    have hstab : ∀ g : G, (∃ a : k, ρ g v1 = a • v1) → ∀ v ∈ L1, ρ g v ∈ L1 := by
      rintro g ⟨a, ha⟩ v hv
      obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hv
      rw [map_smul, ha, smul_smul]
      exact Submodule.mem_span_singleton.mpr ⟨c * a, rfl⟩
    have hK0S' : K0 ≤ S' := by
      intro g hg
      refine (hS' g).mpr ⟨hK0S hg, (ω g : k), ?_⟩
      rw [hscal g hg, LinearMap.smul_apply, LinearMap.id_apply]
    by_cases hall : ∀ s ∈ S, ∃ a : k, ρ s v1 = a • v1
    · exact Or.inl ⟨L1, hL1, fun s hs => hstab s (hall s hs)⟩
    push_neg at hall
    obtain ⟨t, htS, ht⟩ := hall
    obtain ⟨l2, hTv2⟩ := hperm t htS v1 l1 hTv1
    set v2 := ρ t v1 with hv2def
    have hindep : ∀ a b : k, a • v1 + b • v2 = 0 → a = 0 ∧ b = 0 := by
      intro a b hab
      by_cases hb : b = 0
      · rw [hb, zero_smul, add_zero, smul_eq_zero] at hab
        exact ⟨hab.resolve_right hv1ne, hb⟩
      · exfalso
        apply ht (-(b⁻¹ * a))
        have hbv : b • v2 = -(a • v1) := eq_neg_of_add_eq_zero_right hab
        calc v2 = b⁻¹ • (b • v2) := by rw [smul_smul, inv_mul_cancel₀ hb, one_smul]
          _ = -(b⁻¹ * a) • v1 := by rw [hbv, smul_neg, smul_smul, neg_smul]
    have hli : LinearIndependent k ![v1, v2] := LinearIndependent.pair_iff.mpr hindep
    have hspan := hli.span_eq_top_of_card_eq_finrank (by simp [hdim])
    have hdecomp : ∀ w : V, ∃ a b : k, w = a • v1 + b • v2 := by
      intro w
      have hw : w ∈ Submodule.span k (Set.range ![v1, v2]) := by rw [hspan]; trivial
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun k).mp hw
      exact ⟨c 0, c 1, by rw [← hc, Fin.sum_univ_two]; simp⟩
    have hl12 : l1 ≠ l2 := by
      intro heq
      apply hT l1
      ext w
      obtain ⟨a, b, rfl⟩ := hdecomp w
      rw [LinearMap.smul_apply, LinearMap.id_apply, map_add, map_smul, map_smul, hTv1, hTv2,
        ← heq, smul_add, smul_comm l1 a, smul_comm l1 b]
    have hE : ∀ w : V, ∀ μ : k, T w = μ • w → (∃ a : k, w = a • v1) ∨ (∃ b : k, w = b • v2) := by
      intro w μ hw
      obtain ⟨a, b, rfl⟩ := hdecomp w
      rw [map_add, map_smul, map_smul, hTv1, hTv2, smul_add] at hw
      simp only [smul_smul] at hw
      have h0 : (a * l1 - μ * a) • v1 + (b * l2 - μ * b) • v2 = 0 := by
        rw [sub_smul, sub_smul, sub_add_sub_comm, hw, sub_self]
      obtain ⟨ha, hb⟩ := hindep _ _ h0
      by_cases ha0 : a = 0
      · exact Or.inr ⟨b, by rw [ha0, zero_smul, zero_add]⟩
      by_cases hb0 : b = 0
      · exact Or.inl ⟨a, by rw [hb0, zero_smul, add_zero]⟩
      exfalso
      apply hl12
      have e1 : l1 = μ := by
        have : a * (l1 - μ) = 0 := by rw [← ha]; ring
        exact sub_eq_zero.mp ((mul_eq_zero.mp this).resolve_left ha0)
      have e2 : l2 = μ := by
        have : b * (l2 - μ) = 0 := by rw [← hb]; ring
        exact sub_eq_zero.mp ((mul_eq_zero.mp this).resolve_left hb0)
      rw [e1, e2]
    
    have hx : ∃ b : k, ρ t⁻¹ v1 = b • v2 := by
      obtain ⟨μx, hμx⟩ := hperm t⁻¹ (S.inv_mem htS) v1 l1 hTv1
      rcases hE _ _ hμx with ⟨a, ha⟩ | hb
      · exfalso
        have h1 : t⁻¹ ∈ S' := (hS' _).mpr ⟨S.inv_mem htS, a, ha⟩
        have h2 : t ∈ S' := by simpa using S'.inv_mem h1
        obtain ⟨-, a', ha'⟩ := (hS' t).mp h2
        exact ht a' ha'
      · exact hb
    have hidx : ∀ g ∈ S, g ∉ S' → g * t⁻¹ ∈ S' := by
      intro g hg hgS'
      have hgv : ∀ a : k, ρ g v1 ≠ a • v1 := fun a ha => hgS' ((hS' g).mpr ⟨hg, a, ha⟩)
      obtain ⟨μg, hμg⟩ := hperm g hg v1 l1 hTv1
      obtain ⟨c, hc⟩ : ∃ c : k, ρ g v1 = c • v2 := by
        rcases hE _ _ hμg with ⟨a, ha⟩ | hb
        · exact absurd ha (hgv a)
        · exact hb
      have hc0 : c ≠ 0 := by
        rintro rfl
        rw [zero_smul] at hc
        exact hv1ne (hinj g v1 hc)
      obtain ⟨μu, hμu⟩ := hperm g hg v2 l2 hTv2
      obtain ⟨e, he⟩ : ∃ e : k, ρ g v2 = e • v1 := by
        rcases hE _ _ hμu with ha | ⟨d, hd⟩
        · exact ha
        · exfalso
          apply ht (d / c)
          apply sub_eq_zero.mp
          apply hinj g
          rw [map_sub, map_smul, hd, hc, smul_smul, div_mul_cancel₀ d hc0, sub_self]
      obtain ⟨b, hb⟩ := hx
      refine (hS' _).mpr ⟨S.mul_mem hg (S.inv_mem htS), b * e, ?_⟩
      rw [map_mul, Module.End.mul_apply, hb, map_smul, he, smul_smul]
    have hmove : ρ t v1 ∉ L1 := by
      intro h
      obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp h
      exact ht a ha.symm
    have htS' : t ∉ S' := by
      intro h
      obtain ⟨-, a, ha⟩ := (hS' t).mp h
      exact ht a ha
    exact Or.inr ⟨S', hK0S', fun g hg => ((hS' g).mp hg).1, ⟨t, htS, htS', hidx⟩, L1, hL1,
      fun s hs => hstab s ((hS' s).mp hs).2, t, htS, v1, Submodule.mem_span_singleton_self v1,
      hmove⟩
  
  by_cases hc0s : ∃ a : k, ρ c₀ = a • LinearMap.id
  swap
  · 
    push_neg at hc0s
    apply s2 (ρ c₀) hc0s
    intro s hs v μ hv
    have hc : s⁻¹ * c₀ * s ∈ C := by simpa using hCn s⁻¹ (S.inv_mem hs) c₀ hc₀
    obtain ⟨n, hn⟩ := hcyc _ hc
    have e1 : c₀ * s = s * (s⁻¹ * c₀ * s * (c₀ ^ n)⁻¹) * c₀ ^ n := by group
    refine ⟨(ω (s⁻¹ * c₀ * s * (c₀ ^ n)⁻¹) : k) * μ ^ n, ?_⟩
    have e2 : ρ c₀ (ρ s v) = ρ (c₀ * s) v := by rw [map_mul, Module.End.mul_apply]
    rw [e2, e1, map_mul, map_mul, Module.End.mul_apply, Module.End.mul_apply, s1 c₀ v μ hv n,
      hscal _ hn, LinearMap.smul_apply, LinearMap.id_apply, map_smul, map_smul, smul_smul]
  
  obtain ⟨μ0, hμ0⟩ := hc0s
  have hpowc : ∀ n : ℤ, ρ (c₀ ^ n) = μ0 ^ n • LinearMap.id := by
    intro n
    ext v
    rw [LinearMap.smul_apply, LinearMap.id_apply]
    exact s1 c₀ v μ0 (by rw [hμ0, LinearMap.smul_apply, LinearMap.id_apply]) n
  
  let Z : Subgroup G :=
    { carrier := {g | g ∈ S ∧ ∃ a : k, ρ g = a • LinearMap.id}
      mul_mem' := by
        rintro x y ⟨hx, a, ha⟩ ⟨hy, b, hb⟩
        refine ⟨S.mul_mem hx hy, a * b, ?_⟩
        ext v
        rw [map_mul, ha, hb, Module.End.mul_apply, LinearMap.smul_apply, LinearMap.id_apply,
          LinearMap.smul_apply, LinearMap.id_apply, LinearMap.smul_apply, LinearMap.id_apply,
          smul_smul]
      one_mem' := ⟨S.one_mem, 1, by rw [map_one, one_smul]; rfl⟩
      inv_mem' := by
        rintro x ⟨hx, a, ha⟩
        refine ⟨S.inv_mem hx, a⁻¹, ?_⟩
        ext v
        rw [LinearMap.smul_apply, LinearMap.id_apply]
        have h1 : a • ρ x⁻¹ v = v := by
          have := hinvr x v
          rwa [ha, LinearMap.smul_apply, LinearMap.id_apply] at this
        by_cases ha0 : a = 0
        · rw [ha0, zero_smul] at h1
          rw [← h1, map_zero, smul_zero]
        · calc ρ x⁻¹ v = a⁻¹ • (a • ρ x⁻¹ v) := by rw [smul_smul, inv_mul_cancel₀ ha0, one_smul]
            _ = a⁻¹ • v := by rw [h1] }
  have hZ : ∀ g : G, g ∈ Z ↔ g ∈ S ∧ ∃ a : k, ρ g = a • LinearMap.id := fun g => Iff.rfl
  have hCZ : C ≤ Z := by
    intro c hc
    obtain ⟨n, hn⟩ := hcyc c hc
    refine (hZ c).mpr ⟨hCS hc, (ω (c * (c₀ ^ n)⁻¹) : k) * μ0 ^ n, ?_⟩
    rw [show ρ c = ρ (c * (c₀ ^ n)⁻¹ * c₀ ^ n) by rw [inv_mul_cancel_right], map_mul, hscal _ hn,
      hpowc]
    ext v
    rw [Module.End.mul_apply, LinearMap.smul_apply, LinearMap.id_apply, LinearMap.smul_apply,
      LinearMap.id_apply, LinearMap.smul_apply, LinearMap.id_apply, smul_smul]
  have hZn : ∀ s ∈ S, ∀ z ∈ Z, s * z * s⁻¹ ∈ Z := by
    intro s hs z hz
    obtain ⟨hzS, a, ha⟩ := (hZ z).mp hz
    refine (hZ _).mpr ⟨S.mul_mem (S.mul_mem hs hzS) (S.inv_mem hs), a, ?_⟩
    ext v
    rw [map_mul, map_mul, Module.End.mul_apply, Module.End.mul_apply, ha, LinearMap.smul_apply,
      LinearMap.id_apply, map_smul, hinvr, LinearMap.smul_apply, LinearMap.id_apply]
  
  have s3 : (∃ s ∈ S, s ∉ Z) → ∃ s₁ ∈ S, s₁ ∉ Z ∧ ∀ s ∈ S, s⁻¹ * s₁ * s * s₁⁻¹ ∈ Z := by
    intro hne
    let N : Subgroup S := Z.subgroupOf S
    have hN : ∀ x : S, x ∈ N ↔ (x : G) ∈ Z := fun x => Subgroup.mem_subgroupOf
    haveI hNn : N.Normal := ⟨fun n hn g => by
      rw [hN] at hn ⊢
      simpa using hZn g g.2 n hn⟩
    haveI : N.FiniteIndex := by
      have hle : K0.subgroupOf S ≤ N := by
        intro x hx
        rw [hN]
        exact hK0C.trans hCZ (Subgroup.mem_subgroupOf.mp hx)
      exact Subgroup.finiteIndex_of_le hle
    haveI : Fact p.Prime := ⟨hp⟩
    have hP : IsPGroup p (S ⧸ N) := by
      intro q
      obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective q
      obtain ⟨n, hn⟩ := hpow x x.2
      refine ⟨n, ?_⟩
      rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, hN]
      simpa using hCZ hn
    obtain ⟨s₀, hs₀S, hs₀Z⟩ := hne
    haveI : Nontrivial (S ⧸ N) := by
      refine nontrivial_of_ne ((⟨s₀, hs₀S⟩ : S) : S ⧸ N) 1 ?_
      rw [Ne, QuotientGroup.eq_one_iff, hN]
      exact hs₀Z
    haveI := hP.center_nontrivial
    obtain ⟨q, hq⟩ := exists_ne (1 : Subgroup.center (S ⧸ N))
    obtain ⟨x, hx⟩ := QuotientGroup.mk_surjective (q : S ⧸ N)
    refine ⟨x, x.2, ?_, ?_⟩
    · intro hxZ
      apply hq
      ext
      rw [← hx, Subgroup.coe_one, QuotientGroup.eq_one_iff, hN]
      exact hxZ
    · intro s hs
      have hc := Subgroup.mem_center_iff.mp q.2 ((⟨s, hs⟩ : S) : S ⧸ N)
      rw [← hx, ← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq, hN] at hc
      have h2 := hZn x x.2 _ hc
      convert h2 using 1
      simp only [Subgroup.coe_mul, Subgroup.coe_inv]
      group
  by_cases hSZ : ∀ s ∈ S, s ∈ Z
  · left
    haveI : Nontrivial V := Module.nontrivial_of_finrank_pos (R := k) (by rw [hdim]; norm_num)
    obtain ⟨v₀, hv₀⟩ := exists_ne (0 : V)
    refine ⟨Submodule.span k {v₀}, finrank_span_singleton hv₀, ?_⟩
    intro s hs v hv
    obtain ⟨-, a, ha⟩ := (hZ s).mp (hSZ s hs)
    rw [ha, LinearMap.smul_apply, LinearMap.id_apply]
    exact Submodule.smul_mem _ a hv
  push_neg at hSZ
  obtain ⟨s₁, hs₁S, hs₁Z, hcomm⟩ := s3 hSZ
  apply s2 (ρ s₁)
  · intro a ha
    exact hs₁Z ((hZ s₁).mpr ⟨hs₁S, a, ha⟩)
  · intro s hs v μ hv
    obtain ⟨-, b, hb⟩ := (hZ _).mp (hcomm s hs)
    refine ⟨b * μ, ?_⟩
    have e : s₁ * s = s * (s⁻¹ * s₁ * s * s₁⁻¹) * s₁ := by group
    have e2 : ρ s₁ (ρ s v) = ρ (s₁ * s) v := by rw [map_mul, Module.End.mul_apply]
    rw [e2, e, map_mul, map_mul, Module.End.mul_apply, Module.End.mul_apply, hv, hb,
      LinearMap.smul_apply, LinearMap.id_apply, map_smul, map_smul, smul_smul]

theorem tprod_indSpace_trivial_equiv {k : Type} [Field k] {G : Type u} [Group G]
    (H : Subgroup G) [H.FiniteIndex] {V : Type u} [AddCommGroup V] [Module k V]
    (ρ : Representation k G V) (σ : Representation k H (ULift.{u} k)) (hσ : ∀ h : H, σ h = 1)
    (τ : Representation k H V) (hτ : ∀ h : H, τ h = ρ h) :
    ∃ e : TensorProduct k V (EllipticRootNumber.indSpace H σ) ≃ₗ[k] EllipticRootNumber.indSpace H τ,
      ∀ g : G, e.toLinearMap ∘ₗ (ρ.tprod (EllipticRootNumber.indRep H σ)) g =
        EllipticRootNumber.indRep H τ g ∘ₗ e.toLinearMap :=
by
  classical
  letI : Fintype (G ⧸ H) := Subgroup.fintypeQuotientOfFiniteIndex
  
  have hC : ∀ (h : H) (x : G),
      (QuotientGroup.mk ((h : G) * x)⁻¹ : G ⧸ H) = QuotientGroup.mk x⁻¹ := by
    intro h x
    rw [QuotientGroup.eq, inv_inv, mul_inv_cancel_right]
    exact h.2
  
  have gen : ∀ {W : Type u} [AddCommGroup W] [Module k W] (ρ' : Representation k G W)
      (τ' : Representation k H W), (∀ h : H, τ' h = ρ' h) →
      ∃ e : EllipticRootNumber.indSpace H τ' ≃ₗ[k] (G ⧸ H → W),
        ∀ (w : G ⧸ H → W) (x : G),
          (e.symm w : G → W) x = ρ' x (w (QuotientGroup.mk x⁻¹ : G ⧸ H)) := by
    intro W _ _ ρ' τ' hτ'
    have inv1 : ∀ (y : G) (v : W), ρ' y (ρ' y⁻¹ v) = v := by
      intro y v
      rw [← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one, Module.End.one_apply]
    have mem : ∀ (F : EllipticRootNumber.indSpace H τ') (h : G) (hh : h ∈ H) (x : G),
        (F : G → W) (h * x) = ρ' h ((F : G → W) x) := by
      intro F h hh x
      have := F.2 ⟨h, hh⟩ x
      rw [hτ'] at this
      exact this
    let fwd : EllipticRootNumber.indSpace H τ' → G ⧸ H → W := fun F =>
      Quotient.lift (s := QuotientGroup.leftRel H) (fun y => ρ' y ((F : G → W) y⁻¹))
        (fun a b hab => by
          replace hab : a⁻¹ * b ∈ H := QuotientGroup.leftRel_apply.mp hab
          show ρ' a ((F : G → W) a⁻¹) = ρ' b ((F : G → W) b⁻¹)
          have e1 : (F : G → W) b⁻¹ = ρ' (a⁻¹ * b)⁻¹ ((F : G → W) a⁻¹) := by
            have := mem F (a⁻¹ * b)⁻¹ (inv_mem hab) a⁻¹
            rw [show ((a⁻¹ * b)⁻¹ * a⁻¹ : G) = b⁻¹ by group] at this
            exact this
          rw [e1, ← Module.End.mul_apply, ← map_mul]
          congr 2
          group)
    let L : EllipticRootNumber.indSpace H τ' →ₗ[k] (G ⧸ H → W) :=
      { toFun := fwd
        map_add' := fun F F' => by
          funext u
          obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective u
          show ρ' y (((F + F' : EllipticRootNumber.indSpace H τ') : G → W) y⁻¹) =
            ρ' y ((F : G → W) y⁻¹) + ρ' y ((F' : G → W) y⁻¹)
          rw [Submodule.coe_add, Pi.add_apply, map_add]
        map_smul' := fun c F => by
          funext u
          obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective u
          show ρ' y (((c • F : EllipticRootNumber.indSpace H τ') : G → W) y⁻¹) =
            c • ρ' y ((F : G → W) y⁻¹)
          rw [Submodule.coe_smul, Pi.smul_apply, map_smul] }
    let L' : (G ⧸ H → W) →ₗ[k] EllipticRootNumber.indSpace H τ' :=
      { toFun := fun w => ⟨fun x => ρ' x (w (QuotientGroup.mk x⁻¹ : G ⧸ H)), by
            intro h x
            show ρ' ((h : G) * x) (w (QuotientGroup.mk ((h : G) * x)⁻¹ : G ⧸ H)) =
              τ' h (ρ' x (w (QuotientGroup.mk x⁻¹ : G ⧸ H)))
            rw [hC h x, hτ' h, map_mul, Module.End.mul_apply]⟩
        map_add' := fun w w' => Subtype.ext <| funext fun x => by
          show ρ' x ((w + w') (QuotientGroup.mk x⁻¹ : G ⧸ H)) =
            ρ' x (w (QuotientGroup.mk x⁻¹ : G ⧸ H)) + ρ' x (w' (QuotientGroup.mk x⁻¹ : G ⧸ H))
          rw [Pi.add_apply, map_add]
        map_smul' := fun c w => Subtype.ext <| funext fun x => by
          show ρ' x ((c • w) (QuotientGroup.mk x⁻¹ : G ⧸ H)) =
            c • ρ' x (w (QuotientGroup.mk x⁻¹ : G ⧸ H))
          rw [Pi.smul_apply, map_smul] }
    have h₁ : L ∘ₗ L' = LinearMap.id := LinearMap.ext fun w => funext fun u => by
      obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective u
      show ρ' y (ρ' y⁻¹ (w (QuotientGroup.mk y⁻¹⁻¹ : G ⧸ H))) = w (QuotientGroup.mk y)
      rw [inv_inv, inv1]
    have h₂ : L' ∘ₗ L = LinearMap.id := LinearMap.ext fun F => Subtype.ext <| funext fun x => by
      show ρ' x (ρ' x⁻¹ ((F : G → W) x⁻¹⁻¹)) = (F : G → W) x
      rw [inv_inv, inv1]
    exact ⟨LinearEquiv.ofLinear L L' h₁ h₂, fun w x => rfl⟩
  obtain ⟨e₂, he₂⟩ := gen ρ τ hτ
  have hσ' : ∀ h : H, σ h = Representation.trivial k G (ULift.{u} k) h := by
    intro h
    rw [hσ h]
    rfl
  obtain ⟨e₁, he₁⟩ := gen (Representation.trivial k G (ULift.{u} k)) σ hσ'
  have ke₁ : ∀ (f : EllipticRootNumber.indSpace H σ) (x : G),
      e₁ f (QuotientGroup.mk x⁻¹ : G ⧸ H) = (f : G → ULift.{u} k) x := by
    intro f x
    have := he₁ (e₁ f) x
    rw [LinearEquiv.symm_apply_apply] at this
    exact this.symm
  obtain ⟨e, he⟩ : ∃ e : TensorProduct k V (EllipticRootNumber.indSpace H σ) ≃ₗ[k]
      EllipticRootNumber.indSpace H τ,
      e = (LinearEquiv.lTensor V (e₁.trans (LinearEquiv.piCongrRight
        (fun _ : G ⧸ H => (ULift.moduleEquiv : ULift.{u} k ≃ₗ[k] k))))).trans
        ((TensorProduct.piScalarRight k k V (G ⧸ H)).trans e₂.symm) := ⟨_, rfl⟩
  have key : ∀ (v : V) (f : EllipticRootNumber.indSpace H σ) (x : G),
      (e (TensorProduct.tmul k v f) : G → V) x = ((f : G → ULift.{u} k) x).down • ρ x v := by
    intro v f x
    rw [he, LinearEquiv.trans_apply, LinearEquiv.trans_apply, LinearEquiv.lTensor_tmul, he₂,
      TensorProduct.piScalarRight_apply, TensorProduct.piScalarRightHom_tmul]
    simp only [LinearEquiv.trans_apply, LinearEquiv.piCongrRight_apply, ke₁, map_smul]
    rfl
  refine ⟨e, fun g => TensorProduct.ext' fun v f => ?_⟩
  apply Subtype.ext
  funext x
  rw [LinearMap.comp_apply, LinearMap.comp_apply, Representation.tprod_apply,
    TensorProduct.map_tmul]
  show (e (TensorProduct.tmul k (ρ g v) (EllipticRootNumber.indRep H σ g f)) : G → V) x =
    (e (TensorProduct.tmul k v f) : G → V) (x * g)
  rw [key, key]
  show ((f : G → ULift.{u} k) (x * g)).down • ρ x (ρ g v) =
    ((f : G → ULift.{u} k) (x * g)).down • ρ (x * g) v
  rw [map_mul, Module.End.mul_apply]

theorem indSpace_exact {k : Type} [Field k] {G : Type u} [Group G] (H : Subgroup G)
    {W₁ W W₂ : Type u} [AddCommGroup W₁] [Module k W₁] [AddCommGroup W] [Module k W]
    [AddCommGroup W₂] [Module k W₂]
    (σ₁ : Representation k H W₁) (σ : Representation k H W) (σ₂ : Representation k H W₂)
    (f : W₁ →ₗ[k] W) (g : W →ₗ[k] W₂)
    (hf : ∀ h, f ∘ₗ σ₁ h = σ h ∘ₗ f) (hg : ∀ h, g ∘ₗ σ h = σ₂ h ∘ₗ g)
    (hfi : Function.Injective f) (hgs : Function.Surjective g)
    (hex : LinearMap.range f = LinearMap.ker g) :
    ∃ (F₁ : EllipticRootNumber.indSpace H σ₁ →ₗ[k] EllipticRootNumber.indSpace H σ)
      (F₂ : EllipticRootNumber.indSpace H σ →ₗ[k] EllipticRootNumber.indSpace H σ₂),
      (∀ x : G, F₁ ∘ₗ EllipticRootNumber.indRep H σ₁ x = EllipticRootNumber.indRep H σ x ∘ₗ F₁) ∧
      (∀ x : G, F₂ ∘ₗ EllipticRootNumber.indRep H σ x = EllipticRootNumber.indRep H σ₂ x ∘ₗ F₂) ∧
      Function.Injective F₁ ∧ Function.Surjective F₂ ∧ LinearMap.range F₁ = LinearMap.ker F₂ :=
by
  classical
  
  have memF₁ : ∀ φ : G → W₁, φ ∈ EllipticRootNumber.indSpace H σ₁ →
      (fun y => f (φ y)) ∈ EllipticRootNumber.indSpace H σ := by
    intro φ hφ
    have hφ' : ∀ (h : H) (x : G), φ ((h : G) * x) = σ₁ h (φ x) := hφ
    intro h x
    show f (φ ((h : G) * x)) = σ h (f (φ x))
    rw [hφ' h x]
    exact LinearMap.congr_fun (hf h) (φ x)
  have memF₂ : ∀ φ : G → W, φ ∈ EllipticRootNumber.indSpace H σ →
      (fun y => g (φ y)) ∈ EllipticRootNumber.indSpace H σ₂ := by
    intro φ hφ
    have hφ' : ∀ (h : H) (x : G), φ ((h : G) * x) = σ h (φ x) := hφ
    intro h x
    show g (φ ((h : G) * x)) = σ₂ h (g (φ x))
    rw [hφ' h x]
    exact LinearMap.congr_fun (hg h) (φ x)
  let F₁ : EllipticRootNumber.indSpace H σ₁ →ₗ[k] EllipticRootNumber.indSpace H σ :=
    { toFun := fun Φ => ⟨fun y => f (Φ.1 y), memF₁ _ Φ.2⟩
      map_add' := fun a b => by
        apply Subtype.ext; funext y; exact f.map_add _ _
      map_smul' := fun c a => by
        apply Subtype.ext; funext y; exact f.map_smul _ _ }
  let F₂ : EllipticRootNumber.indSpace H σ →ₗ[k] EllipticRootNumber.indSpace H σ₂ :=
    { toFun := fun Φ => ⟨fun y => g (Φ.1 y), memF₂ _ Φ.2⟩
      map_add' := fun a b => by
        apply Subtype.ext; funext y; exact g.map_add _ _
      map_smul' := fun c a => by
        apply Subtype.ext; funext y; exact g.map_smul _ _ }
  refine ⟨F₁, F₂, ?_, ?_, ?_, ?_, ?_⟩
  · intro x
    exact LinearMap.ext fun Φ => Subtype.ext (funext fun y => rfl)
  · intro x
    exact LinearMap.ext fun Φ => Subtype.ext (funext fun y => rfl)
  · intro a b hab
    apply Subtype.ext
    funext y
    apply hfi
    exact congrFun (congrArg Subtype.val hab) y
  · 
    intro Φ
    have hΦ : ∀ (h : H) (x : G), Φ.1 ((h : G) * x) = σ₂ h (Φ.1 x) := Φ.2
    obtain ⟨s, hs⟩ := LinearMap.exists_rightInverse_of_surjective g
      (LinearMap.range_eq_top.mpr hgs)
    have hs' : ∀ y, g (s y) = y := fun y => LinearMap.congr_fun hs y
    obtain ⟨r, hr₁, hr₂⟩ : ∃ r : G → G, (∀ x : G, x * (r x)⁻¹ ∈ H) ∧
        (∀ (h : H) (x : G), r ((h : G) * x) = r x) := by
      refine ⟨fun x => (Quotient.mk (QuotientGroup.rightRel H) x).out, ?_, ?_⟩
      · intro x
        have := Quotient.mk_out (s := QuotientGroup.rightRel H) x
        exact QuotientGroup.rightRel_apply.mp this
      · intro h x
        show Quotient.out _ = Quotient.out _
        congr 1
        apply Quotient.sound
        apply QuotientGroup.rightRel_apply.mpr
        rw [mul_inv_rev, mul_inv_cancel_left]
        exact H.inv_mem h.2
    obtain ⟨c, hc₁, hc₂⟩ : ∃ c : G → H, (∀ x : G, (c x : G) * r x = x) ∧
        (∀ (h : H) (x : G), c ((h : G) * x) = h * c x) := by
      refine ⟨fun x => ⟨x * (r x)⁻¹, hr₁ x⟩, fun x => inv_mul_cancel_right x (r x), ?_⟩
      intro h x
      apply Subtype.ext
      show (h : G) * x * (r ((h : G) * x))⁻¹ = (h : G) * (x * (r x)⁻¹)
      rw [hr₂ h x, mul_assoc]
    refine ⟨⟨fun x => σ (c x) (s (Φ.1 (r x))), ?_⟩, ?_⟩
    · intro h x
      show σ (c ((h : G) * x)) (s (Φ.1 (r ((h : G) * x)))) = σ h (σ (c x) (s (Φ.1 (r x))))
      rw [hc₂ h x, hr₂ h x, map_mul, Module.End.mul_apply]
    · apply Subtype.ext
      funext x
      show g (σ (c x) (s (Φ.1 (r x)))) = Φ.1 x
      have e := LinearMap.congr_fun (hg (c x)) (s (Φ.1 (r x)))
      simp only [LinearMap.comp_apply] at e
      rw [e, hs', ← hΦ (c x) (r x), hc₁ x]
  · ext Φ
    rw [LinearMap.mem_range, LinearMap.mem_ker]
    constructor
    · rintro ⟨X, rfl⟩
      apply Subtype.ext
      funext y
      show g (f (X.1 y)) = 0
      have hk : f (X.1 y) ∈ LinearMap.ker g := hex ▸ LinearMap.mem_range_self f (X.1 y)
      exact LinearMap.mem_ker.mp hk
    · intro h0
      have hΦ : ∀ (h : H) (x : G), Φ.1 ((h : G) * x) = σ h (Φ.1 x) := Φ.2
      have hr : ∀ y, Φ.1 y ∈ LinearMap.range f := fun y => by
        rw [hex, LinearMap.mem_ker]
        exact congrFun (congrArg Subtype.val h0) y
      choose ψ hψ using fun y => LinearMap.mem_range.mp (hr y)
      refine ⟨⟨ψ, ?_⟩, ?_⟩
      · intro h x
        apply hfi
        show f (ψ ((h : G) * x)) = f (σ₁ h (ψ x))
        rw [hψ, hΦ, ← hψ x]
        exact (LinearMap.congr_fun (hf h) (ψ x)).symm
      · apply Subtype.ext
        funext y
        exact hψ y

theorem line_char_exact {k : Type} [Field k] {G : Type u} [Group G] (H : Subgroup G)
    {V : Type u} [AddCommGroup V] [Module k V] (ρ : Representation k G V)
    (hdim : Module.finrank k V = 2) (L : Submodule k V) (hL : Module.finrank k L = 1)
    (hst : ∀ s ∈ H, ∀ v ∈ L, ρ s v ∈ L) :
    ∃ θ₁ θ₂ : H →* kˣ,
      (∀ h : H, ρ h = 1 → θ₁ h = 1 ∧ θ₂ h = 1) ∧
      ∀ (τ : Representation k H V) (σ₁ σ₂ : Representation k H (ULift.{u} k)),
        (∀ h : H, τ h = ρ h) → (∀ h : H, σ₁ h = (θ₁ h : k) • LinearMap.id) →
        (∀ h : H, σ₂ h = (θ₂ h : k) • LinearMap.id) →
        ∃ (f : ULift.{u} k →ₗ[k] V) (g : V →ₗ[k] ULift.{u} k),
          (∀ h, f ∘ₗ σ₁ h = τ h ∘ₗ f) ∧ (∀ h, g ∘ₗ τ h = σ₂ h ∘ₗ g) ∧
          Function.Injective f ∧ Function.Surjective g ∧ LinearMap.range f = LinearMap.ker g :=
by
  classical
  obtain ⟨v, hv0, hvspan⟩ := finrank_eq_one_iff'.mp hL
  have hv₀ : (v : V) ≠ 0 := by
    intro h
    exact hv0 (Subtype.ext h)
  obtain ⟨y, hli⟩ := exists_linearIndependent_pair_of_one_lt_finrank
    (by rw [hdim]; norm_num) hv₀
  let b : Module.Basis (Fin 2) k V :=
    basisOfLinearIndependentOfCardEqFinrank hli (by simp [hdim])
  have hb0 : b 0 = (v : V) := by simp [b]
  have hE : ∀ x : V, x = b.repr x 0 • b 0 + b.repr x 1 • b 1 := by
    intro x
    have hs := b.sum_repr x
    rw [Fin.sum_univ_two] at hs
    exact hs.symm
  have hr00 : b.repr (b 0) 0 = 1 := by simp
  have hr01 : b.repr (b 0) 1 = 0 := by simp
  have hr11 : b.repr (b 1) 1 = 1 := by simp
  have hb : ∀ x : V, x ∈ L ↔ b.repr x 1 = 0 := by
    intro x
    constructor
    · intro hx
      obtain ⟨c, hc⟩ := hvspan ⟨x, hx⟩
      have hx' : x = c • b 0 := by
        rw [hb0]
        exact (congrArg Subtype.val hc).symm
      rw [hx', map_smul, Finsupp.smul_apply, hr01, smul_zero]
    · intro hx
      rw [hE x, hx, zero_smul, add_zero, hb0]
      exact L.smul_mem _ v.2
  have F1 : ∀ h : H, b.repr (ρ h (b 0)) 1 = 0 := fun h =>
    (hb _).mp (hst h h.2 (b 0) ((hb _).mpr hr01))
  obtain ⟨a₀, ha₀⟩ : ∃ a₀ : H → k, ∀ h, a₀ h = b.repr (ρ h (b 0)) 0 := ⟨_, fun _ => rfl⟩
  obtain ⟨d₀, hd₀⟩ : ∃ d₀ : H → k, ∀ h, d₀ h = b.repr (ρ h (b 1)) 1 := ⟨_, fun _ => rfl⟩
  have F1' : ∀ h : H, ρ h (b 0) = a₀ h • b 0 := by
    intro h
    conv_lhs => rw [hE (ρ h (b 0))]
    rw [F1 h, zero_smul, add_zero, ha₀]
  have F2 : ∀ (h : H) (x : V), b.repr (ρ h x) 1 = d₀ h * b.repr x 1 := by
    intro h x
    conv_lhs => rw [hE x]
    rw [map_add, map_smul, map_smul, map_add, map_smul, map_smul]
    simp only [Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul, F1 h, hd₀]
    ring
  have a_one : a₀ 1 = 1 := by
    rw [ha₀]; simp
  have d_one : d₀ 1 = 1 := by
    rw [hd₀]; simp
  have a_mul : ∀ h h' : H, a₀ (h * h') = a₀ h * a₀ h' := by
    intro h h'
    have e : ρ ((h * h' : H) : G) (b 0) = (a₀ h * a₀ h') • b 0 := by
      rw [Subgroup.coe_mul, map_mul, Module.End.mul_apply, F1' h', map_smul, F1' h, smul_smul,
        mul_comm]
    rw [ha₀, e, map_smul, Finsupp.smul_apply, hr00, smul_eq_mul, mul_one]
  have d_mul : ∀ h h' : H, d₀ (h * h') = d₀ h * d₀ h' := by
    intro h h'
    rw [hd₀, Subgroup.coe_mul, map_mul, Module.End.mul_apply, F2 h, ← hd₀]
  let a : H →* k := { toFun := a₀, map_one' := a_one, map_mul' := a_mul }
  let d : H →* k := { toFun := d₀, map_one' := d_one, map_mul' := d_mul }
  have hθ1 : ∀ h : H, ((a.toHomUnits h : kˣ) : k) = a₀ h := fun h => rfl
  have hθ2 : ∀ h : H, ((d.toHomUnits h : kˣ) : k) = d₀ h := fun h => rfl
  refine ⟨a.toHomUnits, d.toHomUnits, ?_, ?_⟩
  · intro h hρ
    constructor
    · apply Units.ext
      rw [hθ1, ha₀, hρ, Module.End.one_apply, hr00, Units.val_one]
    · apply Units.ext
      rw [hθ2, hd₀, hρ, Module.End.one_apply, hr11, Units.val_one]
  · intro τ σ₁ σ₂ hτ hσ₁ hσ₂
    obtain ⟨f, hf⟩ : ∃ f : ULift.{u} k →ₗ[k] V, ∀ c, f c = c.down • b 0 :=
      ⟨(LinearMap.toSpanSingleton k V (b 0)) ∘ₗ ULift.moduleEquiv.toLinearMap, fun c => rfl⟩
    obtain ⟨g, hg⟩ : ∃ g : V →ₗ[k] ULift.{u} k, ∀ x, (g x).down = b.repr x 1 :=
      ⟨ULift.moduleEquiv.symm.toLinearMap ∘ₗ b.coord 1, fun x => rfl⟩
    refine ⟨f, g, ?_, ?_, ?_, ?_, ?_⟩
    · intro h
      refine LinearMap.ext fun c => ?_
      show f (σ₁ h c) = τ h (f c)
      rw [hσ₁, hτ, LinearMap.smul_apply,
        LinearMap.id_apply, hf, hf, map_smul, F1' h, smul_smul, ULift.smul_down, smul_eq_mul,
        hθ1, mul_comm]
    · intro h
      refine LinearMap.ext fun x => ULift.ext _ _ ?_
      show (g (τ h x)).down = (σ₂ h (g x)).down
      rw [hσ₂, hτ, LinearMap.smul_apply,
        LinearMap.id_apply, ULift.smul_down, hg, hg, F2 h, hθ2, smul_eq_mul]
    · intro c c' hcc
      have e := congrArg (fun x => b.repr x 0) hcc
      simp only [hf, map_smul, Finsupp.smul_apply, hr00, smul_eq_mul, mul_one] at e
      exact ULift.ext _ _ e
    · intro c
      refine ⟨c.down • b 1, ULift.ext _ _ ?_⟩
      rw [hg, map_smul, Finsupp.smul_apply, hr11, smul_eq_mul, mul_one]
    · ext x
      simp only [LinearMap.mem_range, LinearMap.mem_ker]
      constructor
      · rintro ⟨c, rfl⟩
        apply ULift.ext
        rw [hg, hf, map_smul, Finsupp.smul_apply, hr01, smul_zero]
        rfl
      · intro hx
        have h1 : b.repr x 1 = 0 := by rw [← hg, hx]; rfl
        refine ⟨⟨b.repr x 0⟩, ?_⟩
        rw [hf]
        conv_rhs => rw [hE x]
        rw [h1, zero_smul, add_zero]

theorem indSpace_index_two_line_equiv {k : Type} [Field k] {G : Type u} [Group G]
    (H H' : Subgroup G) (hle : H' ≤ H) (t : G) (htH : t ∈ H) (htH' : t ∉ H')
    (hidx : ∀ g ∈ H, g ∉ H' → g * t⁻¹ ∈ H')
    {V : Type u} [AddCommGroup V] [Module k V] (ρ : Representation k G V)
    (hdim : Module.finrank k V = 2) (L : Submodule k V) (hL : Module.finrank k L = 1)
    (hst : ∀ s ∈ H', ∀ v ∈ L, ρ s v ∈ L) (hmove : ∃ s ∈ H, ∃ v ∈ L, ρ s v ∉ L) :
    ∃ χ : H' →* kˣ, (∀ h : H', ρ h = 1 → χ h = 1) ∧
      ∀ (τ : Representation k H V) (σ' : Representation k H' (ULift.{u} k)),
        (∀ h : H, τ h = ρ h) → (∀ h : H', σ' h = (χ h : k) • LinearMap.id) →
        ∃ e : EllipticRootNumber.indSpace H' σ' ≃ₗ[k] EllipticRootNumber.indSpace H τ,
          ∀ g : G, e.toLinearMap ∘ₗ EllipticRootNumber.indRep H' σ' g =
            EllipticRootNumber.indRep H τ g ∘ₗ e.toLinearMap :=
by
  classical
  
  have htinvH : t⁻¹ ∈ H := H.inv_mem htH
  have htinv : t⁻¹ ∉ H' := fun h => htH' (by simpa using H'.inv_mem h)
  have htt : t * t ∈ H' := by
    have h1 := H'.inv_mem (hidx t⁻¹ htinvH htinv)
    simpa [mul_inv_rev] using h1
  have hconj : ∀ g ∈ H', t * g * t⁻¹ ∈ H' := by
    intro g hg
    by_contra hc
    have h1 := hidx _ (H.mul_mem (H.mul_mem htH (hle hg)) htinvH) hc
    have h2 := H'.mul_mem (H'.mul_mem h1 htt) (H'.inv_mem hg)
    apply htH'
    have e : t * g * t⁻¹ * t⁻¹ * (t * t) * g⁻¹ = t := by group
    rwa [e] at h2
  have hth : ∀ g ∈ H, g ∉ H' → t * g ∈ H' := by
    intro g hg hg'
    have h1 := H'.mul_mem (hconj _ (hidx g hg hg')) htt
    have e : t * (g * t⁻¹) * t⁻¹ * (t * t) = t * g := by group
    rwa [e] at h1
  
  obtain ⟨s, hsH, v₁, hv₁, hsv⟩ := hmove
  have hv₁0 : v₁ ≠ 0 := by
    rintro rfl
    exact hsv (by rw [map_zero]; exact L.zero_mem)
  have hspan : ∀ x : L, ∃ c : k, c • (⟨v₁, hv₁⟩ : L) = x :=
    (finrank_eq_one_iff_of_nonzero' (⟨v₁, hv₁⟩ : L)
      (fun h => hv₁0 (congrArg Subtype.val h))).mp hL
  have hspanV : ∀ x ∈ L, ∃ c : k, c • v₁ = x := by
    intro x hx
    obtain ⟨c, hc⟩ := hspan ⟨x, hx⟩
    exact ⟨c, congrArg Subtype.val hc⟩
  have hsmul_inj : ∀ a b : k, a • v₁ = b • v₁ → a = b :=
    fun a b h => smul_left_injective k hv₁0 h
  choose c hc using fun h : H' => hspanV (ρ h v₁) (hst h h.2 v₁ hv₁)
  have c_one : c 1 = 1 := hsmul_inj _ _ (by
    rw [hc, OneMemClass.coe_one, map_one, Module.End.one_apply, one_smul])
  have c_mul : ∀ a b : H', c (a * b) = c a * c b := by
    intro a b
    apply hsmul_inj
    rw [hc, Subgroup.coe_mul, map_mul, Module.End.mul_apply, ← hc b, map_smul, ← hc a,
      smul_smul, mul_comm]
  let cM : H' →* k := { toFun := c, map_one' := c_one, map_mul' := c_mul }
  let χ : H' →* kˣ := cM.toHomUnits
  have hχ : ∀ h : H', (χ h : k) = c h := fun h => rfl
  have hχtriv : ∀ h : H', ρ h = 1 → χ h = 1 := by
    intro h h1
    apply Units.ext
    rw [hχ, Units.val_one]
    apply hsmul_inj
    rw [hc h, h1, Module.End.one_apply, one_smul]
  have A1 : ∀ (g : G) (hg : g ∈ H'), ρ g v₁ = (χ ⟨g, hg⟩ : k) • v₁ :=
    fun g hg => (hc ⟨g, hg⟩).symm
  have hsH' : s ∉ H' := fun h => hsv (hst s h v₁ hv₁)
  have hnot : ∀ g ∈ H, g ∉ H' → ρ g v₁ ∉ L := by
    intro g hg hg' hmem
    apply hsv
    have h0 : s * t⁻¹ * (g * t⁻¹)⁻¹ ∈ H' :=
      H'.mul_mem (hidx s hsH hsH') (H'.inv_mem (hidx g hg hg'))
    have h1 := hst _ h0 _ hmem
    rwa [← Module.End.mul_apply, ← map_mul, show s * t⁻¹ * (g * t⁻¹)⁻¹ * g = s by group] at h1
  
  obtain ⟨w, hw⟩ : ∃ w, w = ρ t⁻¹ v₁ := ⟨_, rfl⟩
  have hwL : w ∉ L := hw ▸ hnot t⁻¹ htinvH htinv
  have hvw : LinearIndependent k ![v₁, w] := by
    rw [LinearIndependent.pair_iff]
    intro a r hsr
    by_cases hr : r = 0
    · subst hr
      rw [zero_smul, add_zero] at hsr
      exact ⟨(smul_eq_zero.mp hsr).resolve_right hv₁0, rfl⟩
    · exfalso
      apply hwL
      have h1 : r • w = -(a • v₁) := eq_neg_of_add_eq_zero_right hsr
      have h2 : r • w ∈ L := by
        rw [h1]
        exact L.neg_mem (L.smul_mem a hv₁)
      exact (L.smul_mem_iff hr).mp h2
  obtain ⟨φ, μ, φv, φw, μv, μw, hdec⟩ : ∃ φ μ : V →ₗ[k] k, φ v₁ = 1 ∧ φ w = 0 ∧ μ v₁ = 0 ∧
      μ w = 1 ∧ ∀ x, x = φ x • v₁ + μ x • w := by
    let B := basisOfLinearIndependentOfCardEqFinrank hvw (by simp [hdim])
    have hB0 : B 0 = v₁ := by simp [B]
    have hB1 : B 1 = w := by simp [B]
    refine ⟨B.coord 0, B.coord 1, ?_, ?_, ?_, ?_, ?_⟩
    · rw [← hB0]; simp
    · rw [← hB1]; simp
    · rw [← hB0]; simp
    · rw [← hB1]; simp
    · intro x
      have h1 := (B.sum_repr x).symm
      rw [Fin.sum_univ_two, hB0, hB1] at h1
      rw [Module.Basis.coord_apply, Module.Basis.coord_apply]
      exact h1
  
  have A2 : ∀ (g : G) (hg : g ∈ H'), ρ g w = (χ ⟨t * g * t⁻¹, hconj g hg⟩ : k) • w := by
    intro g hg
    have e : g * t⁻¹ = t⁻¹ * (t * g * t⁻¹) := by group
    rw [hw, ← Module.End.mul_apply, ← map_mul, e, map_mul, Module.End.mul_apply,
      A1 _ (hconj g hg), map_smul]
  have A3 : ρ t v₁ = (χ ⟨t * t, htt⟩ : k) • w := by
    have e : t = t⁻¹ * (t * t) := by group
    conv_lhs => rw [e]
    rw [map_mul, Module.End.mul_apply, A1 (t * t) htt, map_smul, hw]
  have A4 : ρ t w = v₁ := by
    rw [hw, ← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one, Module.End.one_apply]
  have A5 : ∀ (g : G) (hg : g ∈ H) (hg' : g ∉ H'),
      ρ g v₁ = (χ ⟨t * g, hth g hg hg'⟩ : k) • w := by
    intro g hg hg'
    have e : g = t⁻¹ * (t * g) := by group
    conv_lhs => rw [e]
    rw [map_mul, Module.End.mul_apply, A1 _ (hth g hg hg'), map_smul, hw]
  have A6 : ∀ (g : G) (hg : g ∈ H) (hg' : g ∉ H'),
      ρ g w = (χ ⟨g * t⁻¹, hidx g hg hg'⟩ : k) • v₁ := by
    intro g hg hg'
    rw [hw, ← Module.End.mul_apply, ← map_mul, A1 _ (hidx g hg hg')]
  have hφ : ∀ (g : G) (hg : g ∈ H') (y : V), φ (ρ g y) = (χ ⟨g, hg⟩ : k) * φ y := by
    intro g hg y
    conv_lhs => rw [hdec y]
    simp only [map_add, map_smul, A1 g hg, A2 g hg, smul_eq_mul, φv, φw]
    ring
  have key : ∀ y, φ (ρ t y) = μ y := by
    intro y
    conv_lhs => rw [hdec y]
    simp only [map_add, map_smul, A3, A4, smul_eq_mul, φv, φw]
    ring
  
  refine ⟨χ, hχtriv, fun τ σ' hτ hσ' => ?_⟩
  have hτ' : ∀ (g : G) (hg : g ∈ H), τ ⟨g, hg⟩ = ρ g := fun g hg => hτ ⟨g, hg⟩
  let E : EllipticRootNumber.indSpace H τ →ₗ[k] EllipticRootNumber.indSpace H' σ' :=
    { toFun := fun Ψ => ⟨fun x => ULift.up (φ (Ψ.1 x)), by
        intro h x
        have m' : ∀ (g : G) (hg : g ∈ H) (y : G), Ψ.1 (g * y) = τ ⟨g, hg⟩ (Ψ.1 y) :=
          fun g hg y => Ψ.2 ⟨g, hg⟩ y
        show ULift.up (φ (Ψ.1 ((h : G) * x))) = σ' h (ULift.up (φ (Ψ.1 x)))
        rw [hσ' h, m' _ (hle h.2) x, hτ', hφ _ h.2]
        rfl⟩
      map_add' := fun Ψ₁ Ψ₂ => by
        apply Subtype.ext
        funext x
        show ULift.up (φ (Ψ₁.1 x + Ψ₂.1 x)) = ULift.up (φ (Ψ₁.1 x)) + ULift.up (φ (Ψ₂.1 x))
        rw [map_add]
        rfl
      map_smul' := fun a Ψ => by
        apply Subtype.ext
        funext x
        show ULift.up (φ (a • Ψ.1 x)) = a • ULift.up (φ (Ψ.1 x))
        rw [map_smul]
        rfl }
  have hEx : ∀ Ψ x, (((E Ψ : EllipticRootNumber.indSpace H' σ') : G → ULift.{u} k) x).down =
      φ (Ψ.1 x) := fun Ψ x => rfl
  have hinj : Function.Injective E := by
    refine (injective_iff_map_eq_zero E).mpr fun Ψ hΨ => ?_
    have m' : ∀ (g : G) (hg : g ∈ H) (y : G), Ψ.1 (g * y) = τ ⟨g, hg⟩ (Ψ.1 y) :=
      fun g hg y => Ψ.2 ⟨g, hg⟩ y
    have h0 : ∀ x, φ (Ψ.1 x) = 0 := by
      intro x
      rw [← hEx, hΨ]
      rfl
    apply Subtype.ext
    funext x
    show Ψ.1 x = 0
    have hμ : μ (Ψ.1 x) = 0 := by
      rw [← key, ← hτ' t htH, ← m' t htH x, h0]
    rw [hdec (Ψ.1 x), h0 x, hμ, zero_smul, zero_smul, add_zero]
  have hsurj : Function.Surjective E := by
    intro F
    have m : ∀ (h : H') (y : G), F.1 ((h : G) * y) = σ' h (F.1 y) := F.2
    have md : ∀ (g : G) (hg : g ∈ H') (y : G),
        (F.1 (g * y)).down = (χ ⟨g, hg⟩ : k) * (F.1 y).down := by
      intro g hg y
      show (F.1 (((⟨g, hg⟩ : H') : G) * y)).down = _
      rw [m, hσ']
      rfl
    refine ⟨⟨fun x => (F.1 x).down • v₁ + (F.1 (t * x)).down • w, ?_⟩, ?_⟩
    · intro h x
      show (F.1 ((h : G) * x)).down • v₁ + (F.1 (t * ((h : G) * x))).down • w =
        τ h ((F.1 x).down • v₁ + (F.1 (t * x)).down • w)
      rw [hτ h, map_add, map_smul, map_smul]
      by_cases hA : (h : G) ∈ H'
      · rw [A1 _ hA, A2 _ hA, show t * ((h : G) * x) = (t * h * t⁻¹) * (t * x) by group,
          md _ (hconj _ hA), md _ hA]
        module
      · rw [A5 _ h.2 hA, A6 _ h.2 hA, show t * ((h : G) * x) = (t * h) * x by group,
          show (h : G) * x = (h * t⁻¹) * (t * x) by group, md _ (hth _ h.2 hA),
          md _ (hidx _ h.2 hA)]
        module
    · apply Subtype.ext
      funext x
      show ULift.up (φ ((F.1 x).down • v₁ + (F.1 (t * x)).down • w)) = F.1 x
      rw [map_add, map_smul, map_smul, φv, φw]
      simp
  have hEq : ∀ (g : G) (Ψ : EllipticRootNumber.indSpace H τ),
      E (EllipticRootNumber.indRep H τ g Ψ) = EllipticRootNumber.indRep H' σ' g (E Ψ) := by
    intro g Ψ
    rfl
  let e0 := LinearEquiv.ofBijective E ⟨hinj, hsurj⟩
  have h1 : ∀ X, E (e0.symm X) = X := fun X => e0.apply_symm_apply X
  refine ⟨e0.symm, fun g => ?_⟩
  apply LinearMap.ext
  intro F
  apply hinj
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe]
  rw [h1, hEq, h1]

theorem indSpace_index_two_trivial_exact {k : Type} [Field k] [CharZero k] {G : Type u} [Group G]
    (H H' : Subgroup G) (hle : H' ≤ H) (t : G) (htH : t ∈ H) (htH' : t ∉ H')
    (hidx : ∀ g ∈ H, g ∉ H' → g * t⁻¹ ∈ H') :
    ∃ η : H →* kˣ, (∀ h : H, (h : G) ∈ H' → η h = 1) ∧
      ∀ (σ : Representation k H (ULift.{u} k)) (σ' : Representation k H' (ULift.{u} k))
        (ση : Representation k H (ULift.{u} k)),
        (∀ h : H, σ h = 1) → (∀ h : H', σ' h = 1) →
        (∀ h : H, ση h = (η h : k) • LinearMap.id) →
        ∃ (f : EllipticRootNumber.indSpace H σ →ₗ[k] EllipticRootNumber.indSpace H' σ')
          (q : EllipticRootNumber.indSpace H' σ' →ₗ[k] EllipticRootNumber.indSpace H ση),
          (∀ g : G, f ∘ₗ EllipticRootNumber.indRep H σ g = EllipticRootNumber.indRep H' σ' g ∘ₗ f) ∧
          (∀ g : G, q ∘ₗ EllipticRootNumber.indRep H' σ' g = EllipticRootNumber.indRep H ση g ∘ₗ q) ∧
          Function.Injective f ∧ Function.Surjective q ∧ LinearMap.range f = LinearMap.ker q :=
by
  classical
  
  have hm : ∀ a ∈ H, ∀ b ∈ H, (a * b ∈ H' ↔ (a ∈ H' ↔ b ∈ H')) := by
    intro a haH b hbH
    by_cases ha : a ∈ H'
    · rw [Subgroup.mul_mem_cancel_left H' ha]
      exact ⟨fun h => iff_of_true ha h, fun h => h.mp ha⟩
    · by_cases hb : b ∈ H'
      · rw [Subgroup.mul_mem_cancel_right H' hb]
        exact ⟨fun h => absurd h ha, fun h => absurd (h.mpr hb) ha⟩
      · have htb : t * b ∈ H' := by
          by_contra htb
          have h1 : t * b * t⁻¹ ∈ H' := hidx _ (H.mul_mem htH hbH) htb
          have h2 : b * t⁻¹ ∈ H' := hidx b hbH hb
          rw [mul_assoc, Subgroup.mul_mem_cancel_right H' h2] at h1
          exact htH' h1
        have e : a * b = (a * t⁻¹) * (t * b) := by group
        rw [e]
        exact iff_of_true (H'.mul_mem (hidx a haH ha) htb) (iff_of_false ha hb)
  
  have hconj : ∀ h ∈ H', t * h * t⁻¹ ∈ H' := by
    intro h hh
    have hhH := hle hh
    have hth : t * h ∉ H' := by
      rw [Subgroup.mul_mem_cancel_right H' hh]; exact htH'
    have hti : t⁻¹ ∉ H' := by
      rw [Subgroup.inv_mem_iff]; exact htH'
    exact (hm _ (H.mul_mem htH hhH) _ (H.inv_mem htH)).mpr (iff_of_false hth hti)
  have htg : ∀ g ∈ H, g ∉ H' → t * g ∈ H' := fun g hg hg' =>
    (hm t htH g hg).mpr (iff_of_false htH' hg')
  
  obtain ⟨η, hη1, hηm⟩ : ∃ η : H →* kˣ, (∀ h : H, (h : G) ∈ H' → η h = 1) ∧
      (∀ h : H, (h : G) ∉ H' → η h = -1) := by
    refine ⟨MonoidHom.mk' (fun h : H => if (h : G) ∈ H' then (1 : kˣ) else -1) ?_, ?_, ?_⟩
    · intro a b
      have hab := hm a a.2 b b.2
      show (if (a : G) * b ∈ H' then (1 : kˣ) else -1) =
        (if (a : G) ∈ H' then (1 : kˣ) else -1) * (if (b : G) ∈ H' then (1 : kˣ) else -1)
      by_cases ha : (a : G) ∈ H'
      · by_cases hb : (b : G) ∈ H'
        · rw [if_pos ha, if_pos hb, if_pos (hab.mpr (iff_of_true ha hb)), one_mul]
        · rw [if_pos ha, if_neg hb, if_neg (fun h => hb ((hab.mp h).mp ha)), one_mul]
      · by_cases hb : (b : G) ∈ H'
        · rw [if_neg ha, if_pos hb, if_neg (fun h => ha ((hab.mp h).mpr hb)), mul_one]
        · rw [if_neg ha, if_neg hb, if_pos (hab.mpr (iff_of_false ha hb)), neg_one_mul, neg_neg]
    · intro h hh
      show (if (h : G) ∈ H' then (1 : kˣ) else -1) = 1
      exact if_pos hh
    · intro h hh
      show (if (h : G) ∈ H' then (1 : kˣ) else -1) = -1
      exact if_neg hh
  refine ⟨η, hη1, ?_⟩
  intro σ σ' ση hσ hσ' hση
  
  have hsub : EllipticRootNumber.indSpace H σ ≤ EllipticRootNumber.indSpace H' σ' := by
    intro F hF
    have hF' : ∀ (h : H) (x : G), F ((h : G) * x) = σ h (F x) := hF
    intro h x
    show F ((h : G) * x) = σ' h (F x)
    rw [hσ' h]
    have e := hF' ⟨h, hle h.2⟩ x
    rw [hσ] at e
    exact e
  have hinvH' : ∀ ψ ∈ EllipticRootNumber.indSpace H' σ', ∀ h ∈ H', ∀ x : G,
      ψ (h * x) = ψ x := by
    intro ψ hψ h hh x
    have hψ' : ∀ (h : H') (x : G), ψ ((h : G) * x) = σ' h (ψ x) := hψ
    have e := hψ' ⟨h, hh⟩ x
    rw [hσ'] at e
    exact e
  
  have memQ : ∀ ψ ∈ EllipticRootNumber.indSpace H' σ',
      (fun x => ψ x - ψ (t * x)) ∈ EllipticRootNumber.indSpace H ση := by
    intro ψ hψ
    have I := hinvH' ψ hψ
    intro h x
    show ψ ((h : G) * x) - ψ (t * ((h : G) * x)) = ση h (ψ x - ψ (t * x))
    rw [hση h, LinearMap.smul_apply, LinearMap.id_apply]
    by_cases hh : (h : G) ∈ H'
    · rw [hη1 h hh, Units.val_one, one_smul, I _ hh x]
      have e : t * ((h : G) * x) = (t * h * t⁻¹) * (t * x) := by group
      rw [e, I _ (hconj _ hh)]
    · rw [hηm h hh, Units.val_neg, Units.val_one, neg_one_smul, neg_sub]
      have e1 : (h : G) * x = ((h : G) * t⁻¹) * (t * x) := by group
      have e2 : t * ((h : G) * x) = (t * h) * x := (mul_assoc _ _ _).symm
      rw [e2, I _ (htg _ h.2 hh), e1, I _ (hidx _ h.2 hh)]
  let q : EllipticRootNumber.indSpace H' σ' →ₗ[k] EllipticRootNumber.indSpace H ση :=
    { toFun := fun Ψ => ⟨fun x => Ψ.1 x - Ψ.1 (t * x), memQ _ Ψ.2⟩
      map_add' := fun a b => by
        apply Subtype.ext; funext x
        show (a.1 + b.1) x - (a.1 + b.1) (t * x) = (a.1 x - a.1 (t * x)) + (b.1 x - b.1 (t * x))
        simp only [Pi.add_apply]; abel
      map_smul' := fun c a => by
        apply Subtype.ext; funext x
        show (c • a.1) x - (c • a.1) (t * x) = c • (a.1 x - a.1 (t * x))
        simp only [Pi.smul_apply]; rw [smul_sub] }
  refine ⟨Submodule.inclusion hsub, q, ?_, ?_, Submodule.inclusion_injective hsub, ?_, ?_⟩
  · intro g
    exact LinearMap.ext fun Φ => Subtype.ext (funext fun y => rfl)
  · intro g
    refine LinearMap.ext fun Ψ => Subtype.ext (funext fun y => ?_)
    show Ψ.1 (y * g) - Ψ.1 (t * y * g) = Ψ.1 (y * g) - Ψ.1 (t * (y * g))
    rw [mul_assoc]
  · 
    intro Φ
    have hΦ : ∀ (h : H) (x : G), Φ.1 ((h : G) * x) = ση h (Φ.1 x) := Φ.2
    have hΦ' : ∀ (h : H) (x : G), Φ.1 ((h : G) * x) = (η h : k) • Φ.1 x := fun h x => by
      rw [hΦ, hση]; rfl
    have hΦt : ∀ x, Φ.1 (t * x) = -Φ.1 x := fun x => by
      have e := hΦ' ⟨t, htH⟩ x
      rw [hηm ⟨t, htH⟩ htH', Units.val_neg, Units.val_one, neg_one_smul] at e
      exact e
    have h2 : (2 : k) ≠ 0 := two_ne_zero
    have memψ : (fun x => (2 : k)⁻¹ • Φ.1 x) ∈ EllipticRootNumber.indSpace H' σ' := by
      intro h x
      show (2 : k)⁻¹ • Φ.1 ((h : G) * x) = σ' h ((2 : k)⁻¹ • Φ.1 x)
      rw [hσ' h]
      have e := hΦ' ⟨h, hle h.2⟩ x
      rw [hη1 ⟨h, hle h.2⟩ h.2, Units.val_one, one_smul] at e
      show (2 : k)⁻¹ • Φ.1 ((h : G) * x) = (2 : k)⁻¹ • Φ.1 x
      exact congrArg (fun v => (2 : k)⁻¹ • v) e
    refine ⟨⟨fun x => (2 : k)⁻¹ • Φ.1 x, memψ⟩, ?_⟩
    apply Subtype.ext; funext x
    show (2 : k)⁻¹ • Φ.1 x - (2 : k)⁻¹ • Φ.1 (t * x) = Φ.1 x
    rw [hΦt, smul_neg, sub_neg_eq_add, ← add_smul, ← two_mul, mul_inv_cancel₀ h2, one_smul]
  · 
    ext Ψ
    rw [LinearMap.mem_range, LinearMap.mem_ker]
    constructor
    · rintro ⟨Φ, rfl⟩
      apply Subtype.ext; funext x
      have hΦ : ∀ (h : H) (x : G), Φ.1 ((h : G) * x) = σ h (Φ.1 x) := Φ.2
      have e := hΦ ⟨t, htH⟩ x
      rw [hσ] at e
      show Φ.1 x - Φ.1 (t * x) = 0
      rw [show Φ.1 (t * x) = Φ.1 x from e, sub_self]
    · intro h0
      have hT : ∀ x, Ψ.1 (t * x) = Ψ.1 x := fun x => by
        have e : Ψ.1 x - Ψ.1 (t * x) = 0 := congrFun (congrArg Subtype.val h0) x
        exact (sub_eq_zero.mp e).symm
      have I := hinvH' Ψ.1 Ψ.2
      refine ⟨⟨Ψ.1, ?_⟩, ?_⟩
      · intro h x
        show Ψ.1 ((h : G) * x) = σ h (Ψ.1 x)
        rw [hσ h]
        show Ψ.1 ((h : G) * x) = Ψ.1 x
        by_cases hh : (h : G) ∈ H'
        · exact I _ hh x
        · have e1 : (h : G) * x = ((h : G) * t⁻¹) * (t * x) := by group
          rw [e1, I _ (hidx _ h.2 hh), hT]
      · apply Subtype.ext; rfl

theorem delta_tprod_indLM_of_good (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    {V : Type u} [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
    (ρ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V)
    (hW : EllipticRootNumber.IsWeilRep F ⊥ ρ)
    (hdim : Module.finrank (EllipticRootNumber.Ω F) V = 2)
    (δ : ∀ {V' : Type u} [AddCommGroup V'] [Module (EllipticRootNumber.Ω F) V'],
      Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V' →
        (EllipticRootNumber.Ω F)ˣ)
    (hexact : ∀ {V₁ V₀ V₂ : Type u} [AddCommGroup V₁] [Module (EllipticRootNumber.Ω F) V₁]
      [AddCommGroup V₀] [Module (EllipticRootNumber.Ω F) V₀]
      [AddCommGroup V₂] [Module (EllipticRootNumber.Ω F) V₂]
      (σ₁ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V₁)
      (σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V₀)
      (σ₂ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V₂),
      EllipticRootNumber.IsWeilRep F ⊥ σ₁ → EllipticRootNumber.IsWeilRep F ⊥ σ →
      EllipticRootNumber.IsWeilRep F ⊥ σ₂ →
      ∀ (f : V₁ →ₗ[EllipticRootNumber.Ω F] V₀) (g : V₀ →ₗ[EllipticRootNumber.Ω F] V₂),
        (∀ w, f ∘ₗ σ₁ w = σ w ∘ₗ f) → (∀ w, g ∘ₗ σ w = σ₂ w ∘ₗ g) →
        Function.Injective f → Function.Surjective g → LinearMap.range f = LinearMap.ker g →
        δ σ = δ σ₁ * δ σ₂)
    (hind : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (θ θ' : EllipticRootNumber.relWeil F M →* (EllipticRootNumber.Ω F)ˣ),
      EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M θ) →
      EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M θ') →
      δ (EllipticRootNumber.indLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
          (EllipticRootNumber.charRep F M θ)) =
        δ (EllipticRootNumber.indLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
          (EllipticRootNumber.charRep F M θ')))
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (hgood :
      (∃ L : Submodule (EllipticRootNumber.Ω F) V, Module.finrank (EllipticRootNumber.Ω F) L = 1 ∧
        ∀ s ∈ (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥),
          ∀ v ∈ L, ρ s v ∈ L) ∨
      (∃ M' : IntermediateField F (AlgebraicClosure F), M ≤ M' ∧ FiniteDimensional F M' ∧
        (∃ t ∈ (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥),
          t ∉ (EllipticRootNumber.relWeil F M').subgroupOf (EllipticRootNumber.relWeil F ⊥) ∧
          ∀ g ∈ (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥),
            g ∉ (EllipticRootNumber.relWeil F M').subgroupOf (EllipticRootNumber.relWeil F ⊥) →
            g * t⁻¹ ∈ (EllipticRootNumber.relWeil F M').subgroupOf (EllipticRootNumber.relWeil F ⊥)) ∧
        ∃ L : Submodule (EllipticRootNumber.Ω F) V, Module.finrank (EllipticRootNumber.Ω F) L = 1 ∧
          (∀ s ∈ (EllipticRootNumber.relWeil F M').subgroupOf (EllipticRootNumber.relWeil F ⊥),
            ∀ v ∈ L, ρ s v ∈ L) ∧
          ∃ s ∈ (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥),
            ∃ v ∈ L, ρ s v ∉ L)) :
    δ (ρ.tprod (EllipticRootNumber.indLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
        (EllipticRootNumber.charRep F M 1))) =
      δ ((EllipticRootNumber.charRep F ⊥ 1).tprod (EllipticRootNumber.indLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
        (EllipticRootNumber.charRep F M 1))) ^ 2 :=
by
  classical
  
  have hT : EllipticRootNumber.IsWeilRep F ⊥ (Representation.trivial (EllipticRootNumber.Ω F)
      (EllipticRootNumber.relWeil F ⊥) PUnit.{u+1}) :=
    ⟨inferInstance, Set.univ, Filter.univ_mem,
      fun _ _ _ => LinearMap.ext fun _ => Subsingleton.elim _ _⟩
  have hT1 : δ (Representation.trivial (EllipticRootNumber.Ω F)
      (EllipticRootNumber.relWeil F ⊥) PUnit.{u+1}) = 1 := by
    have h := hexact (Representation.trivial (EllipticRootNumber.Ω F)
        (EllipticRootNumber.relWeil F ⊥) PUnit.{u+1})
      (Representation.trivial (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) PUnit.{u+1})
      (Representation.trivial (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) PUnit.{u+1})
      hT hT hT LinearMap.id LinearMap.id
      (fun _ => LinearMap.ext fun _ => Subsingleton.elim _ _)
      (fun _ => LinearMap.ext fun _ => Subsingleton.elim _ _)
      Function.injective_id Function.surjective_id (Subsingleton.elim _ _)
    exact mul_eq_left.mp h.symm
  have hδiso : ∀ {V₁ V₂ : Type u} [AddCommGroup V₁] [Module (EllipticRootNumber.Ω F) V₁]
      [AddCommGroup V₂] [Module (EllipticRootNumber.Ω F) V₂]
      (σ₁ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V₁)
      (σ₂ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V₂),
      EllipticRootNumber.IsWeilRep F ⊥ σ₁ → EllipticRootNumber.IsWeilRep F ⊥ σ₂ →
      ∀ e : V₁ ≃ₗ[EllipticRootNumber.Ω F] V₂,
      (∀ w, e.toLinearMap ∘ₗ σ₁ w = σ₂ w ∘ₗ e.toLinearMap) → δ σ₁ = δ σ₂ := by
    intro V₁ V₂ _ _ _ _ σ₁ σ₂ h₁ h₂ e he
    have h := hexact σ₁ σ₂ (Representation.trivial (EllipticRootNumber.Ω F)
        (EllipticRootNumber.relWeil F ⊥) PUnit.{u+1})
      h₁ h₂ hT e.toLinearMap 0 he (fun _ => LinearMap.ext fun _ => Subsingleton.elim _ _)
      e.injective (fun _ => ⟨0, Subsingleton.elim _ _⟩)
      (by rw [LinearMap.range_eq_top.mpr e.surjective, LinearMap.ker_zero])
    rw [h, hT1, mul_one]
  
  have hWtprod : ∀ {V₁ V₂ : Type u} [AddCommGroup V₁] [Module (EllipticRootNumber.Ω F) V₁]
      [AddCommGroup V₂] [Module (EllipticRootNumber.Ω F) V₂]
      (σ₁ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V₁)
      (σ₂ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V₂),
      EllipticRootNumber.IsWeilRep F ⊥ σ₁ → EllipticRootNumber.IsWeilRep F ⊥ σ₂ →
      EllipticRootNumber.IsWeilRep F ⊥ (σ₁.tprod σ₂) := by
    intro V₁ V₂ _ _ _ _ σ₁ σ₂ h₁ h₂
    haveI := h₁.1
    haveI := h₂.1
    obtain ⟨U₁, hU₁, hρ₁⟩ := h₁.2
    obtain ⟨U₂, hU₂, hρ₂⟩ := h₂.2
    refine ⟨inferInstance, U₁ ∩ U₂, Filter.inter_mem hU₁ hU₂, fun w hw hI => ?_⟩
    rw [Representation.tprod_apply, hρ₁ w hw.1 hI, hρ₂ w hw.2 hI]
    exact TensorProduct.map_one
  
  have fdU : FiniteDimensional (EllipticRootNumber.Ω F) (ULift.{u} (EllipticRootNumber.Ω F)) :=
    LinearEquiv.finiteDimensional ULift.moduleEquiv.symm
  have hcharW : ∀ (M₀ : IntermediateField F (AlgebraicClosure F))
      (θ : EllipticRootNumber.relWeil F M₀ →* (EllipticRootNumber.Ω F)ˣ)
      (U' : Set (EllipticRootNumber.AbsGal F)), U' ∈ nhds (1 : EllipticRootNumber.AbsGal F) →
      (∀ w : EllipticRootNumber.relWeil F M₀, (w : EllipticRootNumber.AbsGal F) ∈ U' →
        (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → θ w = 1) →
      EllipticRootNumber.IsWeilRep F M₀ (EllipticRootNumber.charRep F M₀ θ) := by
    intro M₀ θ U' hU' hθ
    refine ⟨fdU, U', hU', fun w h1 h2 => ?_⟩
    refine LinearMap.ext fun v => ?_
    simp [EllipticRootNumber.charRep, hθ w h1 h2]
  have W1 : ∀ M₀ : IntermediateField F (AlgebraicClosure F),
      EllipticRootNumber.IsWeilRep F M₀ (EllipticRootNumber.charRep F M₀ 1) :=
    fun M₀ => hcharW M₀ 1 Set.univ Filter.univ_mem (fun _ _ _ => rfl)
  obtain ⟨U, hU, hρU⟩ := hW.2
  
  have hτ : ∀ (M₀ : IntermediateField F (AlgebraicClosure F))
      (h : (EllipticRootNumber.relWeil F M₀).subgroupOf (EllipticRootNumber.relWeil F ⊥)),
      ((ρ.comp (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M₀)))).comp
        (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M₀))).toMonoidHom) h =
        ρ h := fun _ _ => rfl
  have hResW : ∀ M₀ : IntermediateField F (AlgebraicClosure F),
      EllipticRootNumber.IsWeilRep F M₀ (ρ.comp (Subgroup.inclusion
        (EllipticRootNumber.relWeil_antitone F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M₀)))) :=
    fun M₀ => ⟨hW.1, U, hU, fun w h1 h2 => hρU (Subgroup.inclusion _ w) h1 h2⟩
  have hσ₀ : ∀ (M₀ : IntermediateField F (AlgebraicClosure F))
      (h : (EllipticRootNumber.relWeil F M₀).subgroupOf (EllipticRootNumber.relWeil F ⊥)),
      ((EllipticRootNumber.charRep F M₀ 1).comp
        (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M₀))).toMonoidHom) h = 1 := by
    intro M₀ h
    refine LinearMap.ext fun v => ?_
    simp [EllipticRootNumber.charRep]
  haveI hfiM : ((EllipticRootNumber.relWeil F M).subgroupOf
      (EllipticRootNumber.relWeil F ⊥)).FiniteIndex := finiteIndex_relWeil_subgroupOf F M
  have hπ : EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.indLM F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
      (EllipticRootNumber.charRep F M 1)) := isWeilRep_indLM F ⊥ M bot_le _ (W1 M)
  have hIndRes : EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.indLM F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
      (ρ.comp (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))))) :=
    isWeilRep_indLM F ⊥ M bot_le _ (hResW M)
  
  obtain ⟨e₁, he₁⟩ := tprod_indSpace_trivial_equiv
    ((EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥)) ρ _ (hσ₀ M) _
    (hτ M)
  have P1 : δ (ρ.tprod (EllipticRootNumber.indLM F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
      (EllipticRootNumber.charRep F M 1))) =
      δ (EllipticRootNumber.indLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
        (ρ.comp (Subgroup.inclusion (EllipticRootNumber.relWeil_antitone F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))))) :=
    hδiso _ _ (hWtprod _ _ hW hπ) hIndRes e₁ he₁
  have hτ1 : ∀ h : (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥),
      ((EllipticRootNumber.charRep F M 1).comp
        (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).toMonoidHom) h =
        EllipticRootNumber.charRep F ⊥ 1 h := by
    intro h
    rw [hσ₀ M h]
    refine LinearMap.ext fun v => ?_
    simp [EllipticRootNumber.charRep]
  obtain ⟨e₂, he₂⟩ := tprod_indSpace_trivial_equiv
    ((EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥))
    (EllipticRootNumber.charRep F ⊥ 1) _ (hσ₀ M) _ hτ1
  have P2 : δ ((EllipticRootNumber.charRep F ⊥ 1).tprod (EllipticRootNumber.indLM F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
      (EllipticRootNumber.charRep F M 1))) =
      δ (EllipticRootNumber.indLM F
        (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
        (EllipticRootNumber.charRep F M 1)) :=
    hδiso _ _ (hWtprod _ _ (W1 ⊥) hπ) hπ e₂ he₂
  rw [P1, P2]
  rcases hgood with ⟨L, hL, hst⟩ | ⟨M', hMM', hM'fin, ⟨t, htH, htH', hidx⟩, L, hL, hst', s, hs, v, hv, hsv⟩
  · 
    obtain ⟨θ₁, θ₂, htriv, hseq⟩ := line_char_exact
      ((EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥)) ρ hdim L hL hst
    have hσ1 : ∀ h : (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥),
        ((EllipticRootNumber.charRep F M (θ₁.comp (Subgroup.subgroupOfEquivOfLe
          (EllipticRootNumber.relWeil_antitone F
            (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).symm.toMonoidHom)).comp
          (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
            (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).toMonoidHom) h =
          (θ₁ h : EllipticRootNumber.Ω F) • LinearMap.id := by
      intro h
      refine LinearMap.ext fun v => ?_
      simp [EllipticRootNumber.charRep]
    have hσ2 : ∀ h : (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥),
        ((EllipticRootNumber.charRep F M (θ₂.comp (Subgroup.subgroupOfEquivOfLe
          (EllipticRootNumber.relWeil_antitone F
            (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).symm.toMonoidHom)).comp
          (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
            (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).toMonoidHom) h =
          (θ₂ h : EllipticRootNumber.Ω F) • LinearMap.id := by
      intro h
      refine LinearMap.ext fun v => ?_
      simp [EllipticRootNumber.charRep]
    obtain ⟨f, g, hf, hg, hfi, hgs, hex⟩ := hseq _ _ _ (hτ M) hσ1 hσ2
    obtain ⟨F₁, F₂, hF₁, hF₂, hF₁i, hF₂s, hFex⟩ := indSpace_exact
      ((EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥)) _ _ _ f g
      hf hg hfi hgs hex
    have hθ1W : EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M
        (θ₁.comp (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).symm.toMonoidHom)) :=
      hcharW M _ U hU (fun w h1 h2 => (htriv _ (hρU _ h1 h2)).1)
    have hθ2W : EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M
        (θ₂.comp (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).symm.toMonoidHom)) :=
      hcharW M _ U hU (fun w h1 h2 => (htriv _ (hρU _ h1 h2)).2)
    have hE := hexact _ _ _ (isWeilRep_indLM F ⊥ M bot_le _ hθ1W) hIndRes
      (isWeilRep_indLM F ⊥ M bot_le _ hθ2W) F₁ F₂ hF₁ hF₂ hF₁i hF₂s hFex
    rw [hE, hind M _ 1 hθ1W (W1 M), hind M _ 1 hθ2W (W1 M), sq]
  · 
    haveI : FiniteDimensional F M' := hM'fin
    have hle : (EllipticRootNumber.relWeil F M').subgroupOf (EllipticRootNumber.relWeil F ⊥) ≤
        (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥) := by
      intro x hx
      rw [Subgroup.mem_subgroupOf] at hx ⊢
      exact EllipticRootNumber.relWeil_antitone F hMM' hx
    
    obtain ⟨χ, hχtriv, hiso⟩ := indSpace_index_two_line_equiv
      ((EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥))
      ((EllipticRootNumber.relWeil F M').subgroupOf (EllipticRootNumber.relWeil F ⊥))
      hle t htH htH' hidx ρ hdim L hL hst' ⟨s, hs, v, hv, hsv⟩
    have hσ' : ∀ h : (EllipticRootNumber.relWeil F M').subgroupOf (EllipticRootNumber.relWeil F ⊥),
        ((EllipticRootNumber.charRep F M' (χ.comp (Subgroup.subgroupOfEquivOfLe
          (EllipticRootNumber.relWeil_antitone F
            (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M'))).symm.toMonoidHom)).comp
          (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
            (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M'))).toMonoidHom) h =
          (χ h : EllipticRootNumber.Ω F) • LinearMap.id := by
      intro h
      refine LinearMap.ext fun v => ?_
      simp [EllipticRootNumber.charRep]
    obtain ⟨e₃, he₃⟩ := hiso _ _ (hτ M) hσ'
    have hθ'W : EllipticRootNumber.IsWeilRep F M' (EllipticRootNumber.charRep F M'
        (χ.comp (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M'))).symm.toMonoidHom)) :=
      hcharW M' _ U hU (fun w h1 h2 => hχtriv _ (hρU _ h1 h2))
    have b1 := hδiso _ _ (isWeilRep_indLM F ⊥ M' bot_le _ hθ'W) hIndRes e₃ he₃
    
    obtain ⟨η, hη1, hseq'⟩ := indSpace_index_two_trivial_exact (k := EllipticRootNumber.Ω F)
      ((EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥))
      ((EllipticRootNumber.relWeil F M').subgroupOf (EllipticRootNumber.relWeil F ⊥))
      hle t htH htH' hidx
    have hση : ∀ h : (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F ⊥),
        ((EllipticRootNumber.charRep F M (η.comp (Subgroup.subgroupOfEquivOfLe
          (EllipticRootNumber.relWeil_antitone F
            (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).symm.toMonoidHom)).comp
          (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
            (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).toMonoidHom) h =
          (η h : EllipticRootNumber.Ω F) • LinearMap.id := by
      intro h
      refine LinearMap.ext fun v => ?_
      simp [EllipticRootNumber.charRep]
    obtain ⟨f, q, hf, hq, hfi, hqs, hex⟩ := hseq' _ _ _ (hσ₀ M) (hσ₀ M') hση
    have hopen : (M'.fixingSubgroup : Set (EllipticRootNumber.AbsGal F)) ∈
        nhds (1 : EllipticRootNumber.AbsGal F) :=
      (IntermediateField.fixingSubgroup_isOpen M').mem_nhds M'.fixingSubgroup.one_mem
    have hη'W : EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M
        (η.comp (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).symm.toMonoidHom)) := by
      refine hcharW M _ _ hopen (fun w hw _ => hη1 _ ?_)
      rw [Subgroup.mem_subgroupOf]
      show (w : EllipticRootNumber.AbsGal F) ∈
        EllipticRootNumber.weilGroup F ⊓ M'.fixingSubgroup
      exact Subgroup.mem_inf.mpr ⟨EllipticRootNumber.relWeil_le_weilGroup F M w.2, hw⟩
    have hE2 := hexact _ _ _ hπ (isWeilRep_indLM F ⊥ M' bot_le _ (W1 M'))
      (isWeilRep_indLM F ⊥ M bot_le _ hη'W) f q hf hq hfi hqs hex
    rw [← b1, hind M' _ 1 hθ'W (W1 M'), hE2, hind M _ 1 hη'W (W1 M), sq]

theorem delta_tprod_exact_and_unit (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (N : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F N]
    (δ : ∀ {V' : Type u} [AddCommGroup V'] [Module (EllipticRootNumber.Ω F) V'],
      Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V' →
        (EllipticRootNumber.Ω F)ˣ)
    (hexact : ∀ {V₁ V₀ V₂ : Type u} [AddCommGroup V₁] [Module (EllipticRootNumber.Ω F) V₁]
      [AddCommGroup V₀] [Module (EllipticRootNumber.Ω F) V₀]
      [AddCommGroup V₂] [Module (EllipticRootNumber.Ω F) V₂]
      (σ₁ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V₁)
      (σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V₀)
      (σ₂ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V₂),
      EllipticRootNumber.IsWeilRep F ⊥ σ₁ → EllipticRootNumber.IsWeilRep F ⊥ σ →
      EllipticRootNumber.IsWeilRep F ⊥ σ₂ →
      ∀ (f : V₁ →ₗ[EllipticRootNumber.Ω F] V₀) (g : V₀ →ₗ[EllipticRootNumber.Ω F] V₂),
        (∀ w, f ∘ₗ σ₁ w = σ w ∘ₗ f) → (∀ w, g ∘ₗ σ w = σ₂ w ∘ₗ g) →
        Function.Injective f → Function.Surjective g → LinearMap.range f = LinearMap.ker g →
        δ σ = δ σ₁ * δ σ₂)
    {V : Type u} [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
    (σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V)
    (hσ : EllipticRootNumber.IsWeilRep F ⊥ σ) :
    (∀ {X₁ X X₂ : Type u} [AddCommGroup X₁] [Module (EllipticRootNumber.Ω F) X₁]
        [AddCommGroup X] [Module (EllipticRootNumber.Ω F) X]
        [AddCommGroup X₂] [Module (EllipticRootNumber.Ω F) X₂]
        [FiniteDimensional (EllipticRootNumber.Ω F) X₁] [FiniteDimensional (EllipticRootNumber.Ω F) X]
        [FiniteDimensional (EllipticRootNumber.Ω F) X₂]
        (τ₁ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) X₁)
        (τ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) X)
        (τ₂ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) X₂),
        (∀ g ∈ (EllipticRootNumber.relWeil F N).subgroupOf (EllipticRootNumber.relWeil F ⊥), τ₁ g = 1) →
        (∀ g ∈ (EllipticRootNumber.relWeil F N).subgroupOf (EllipticRootNumber.relWeil F ⊥), τ g = 1) →
        (∀ g ∈ (EllipticRootNumber.relWeil F N).subgroupOf (EllipticRootNumber.relWeil F ⊥), τ₂ g = 1) →
        ∀ (f : X₁ →ₗ[EllipticRootNumber.Ω F] X) (q : X →ₗ[EllipticRootNumber.Ω F] X₂),
          (∀ g, f ∘ₗ τ₁ g = τ g ∘ₗ f) → (∀ g, q ∘ₗ τ g = τ₂ g ∘ₗ q) →
          Function.Injective f → Function.Surjective q → LinearMap.range f = LinearMap.ker q →
          δ (σ.tprod τ) = δ (σ.tprod τ₁) * δ (σ.tprod τ₂)) ∧
    δ (σ.tprod (Representation.trivial (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥)
        (ULift.{u} (EllipticRootNumber.Ω F)))) = δ σ :=
by
  classical
  have hW : ∀ {X : Type u} [AddCommGroup X] [Module (EllipticRootNumber.Ω F) X]
      [FiniteDimensional (EllipticRootNumber.Ω F) X]
      (τ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) X),
      (∀ g ∈ (EllipticRootNumber.relWeil F N).subgroupOf (EllipticRootNumber.relWeil F ⊥),
        τ g = 1) →
      EllipticRootNumber.IsWeilRep F ⊥ (σ.tprod τ) := by
    intro X _ _ _ τ hτ
    obtain ⟨hV, U, hU, hUσ⟩ := hσ
    haveI := hV
    refine ⟨inferInstance, U ∩ (N.fixingSubgroup : Set (EllipticRootNumber.AbsGal F)),
      Filter.inter_mem hU ((IntermediateField.fixingSubgroup_isOpen N).mem_nhds
        N.fixingSubgroup.one_mem), ?_⟩
    intro w hwU hwI
    have h1 : σ w = 1 := hUσ w hwU.1 hwI
    have hK : w ∈ (EllipticRootNumber.relWeil F N).subgroupOf (EllipticRootNumber.relWeil F ⊥) := by
      rw [Subgroup.mem_subgroupOf]
      show (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.weilGroup F ⊓ N.fixingSubgroup
      exact Subgroup.mem_inf.mpr ⟨EllipticRootNumber.relWeil_le_weilGroup F ⊥ w.2, hwU.2⟩
    rw [Representation.tprod_apply, h1, hτ w hK]
    exact TensorProduct.map_one
  refine ⟨?_, ?_⟩
  · intro X₁ X X₂ _ _ _ _ _ _ _ _ _ τ₁ τ τ₂ h₁ h h₂ f q hf hq hfi hqs hex
    have hi : Function.Injective (f.lTensor V) :=
      Module.Flat.lTensor_preserves_injective_linearMap f hfi
    have hs : Function.Surjective (q.lTensor V) := LinearMap.lTensor_surjective V hqs
    have hr : LinearMap.range (f.lTensor V) = LinearMap.ker (q.lTensor V) := by
      have e : Function.Exact f q := LinearMap.exact_iff.mpr hex.symm
      exact (LinearMap.exact_iff.mp (Module.Flat.lTensor_exact V e)).symm
    refine hexact (σ.tprod τ₁) (σ.tprod τ) (σ.tprod τ₂) (hW τ₁ h₁) (hW τ h) (hW τ₂ h₂)
      (f.lTensor V) (q.lTensor V) ?_ ?_ hi hs hr
    · intro w
      apply TensorProduct.ext'
      intro v x
      simp only [LinearMap.comp_apply, Representation.tprod_apply, TensorProduct.map_tmul,
        LinearMap.lTensor_tmul]
      rw [show f (τ₁ w x) = τ w (f x) from LinearMap.congr_fun (hf w) x]
    · intro w
      apply TensorProduct.ext'
      intro v x
      simp only [LinearMap.comp_apply, Representation.tprod_apply, TensorProduct.map_tmul,
        LinearMap.lTensor_tmul]
      rw [show q (τ w x) = τ₂ w (q x) from LinearMap.congr_fun (hq w) x]
  · haveI : FiniteDimensional (EllipticRootNumber.Ω F) (ULift.{u} (EllipticRootNumber.Ω F)) :=
      LinearEquiv.finiteDimensional ULift.moduleEquiv.symm
    have h1 := hW (Representation.trivial (EllipticRootNumber.Ω F)
      (EllipticRootNumber.relWeil F ⊥) (ULift.{u} (EllipticRootNumber.Ω F)))
      (fun g _ => LinearMap.ext fun v => rfl)
    have hZ : EllipticRootNumber.IsWeilRep F ⊥ (Representation.trivial (EllipticRootNumber.Ω F)
        (EllipticRootNumber.relWeil F ⊥) PUnit.{u+1}) :=
      ⟨inferInstance, Set.univ, Filter.univ_mem, fun w _ _ =>
        LinearMap.ext fun v => Subsingleton.elim _ _⟩
    have h0 := hexact _ _ _ hZ hZ hZ 0 0 (fun w => by simp) (fun w => by simp)
      (Function.injective_of_subsingleton _) (Function.surjective_to_subsingleton _)
      (Subsingleton.elim _ _)
    have hz := left_eq_mul.mp h0
    let eE : TensorProduct (EllipticRootNumber.Ω F) V (ULift.{u} (EllipticRootNumber.Ω F)) ≃ₗ[EllipticRootNumber.Ω F] V :=
      (LinearEquiv.lTensor V ULift.moduleEquiv).trans (TensorProduct.rid _ V)
    have hmain := hexact _ σ _ h1 hσ hZ eE.toLinearMap 0 ?_ (fun _ => by simp) eE.injective
      (Function.surjective_to_subsingleton _) ?_
    · rw [hz, mul_one] at hmain
      exact hmain.symm
    · intro w
      apply TensorProduct.ext'
      intro v c
      simp [eE, Representation.tprod_apply]
    · rw [LinearMap.ker_zero]
      exact LinearMap.range_eq_top.mpr eE.surjective

theorem brauer_relation_primitive (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    {V : Type u} [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
    (ρ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V)
    (hW : EllipticRootNumber.IsWeilRep F ⊥ ρ)
    (hdim : Module.finrank (EllipticRootNumber.Ω F) V = 2)
    (hnl : ¬ ∃ L : Submodule (EllipticRootNumber.Ω F) V, Module.finrank (EllipticRootNumber.Ω F) L = 1 ∧
      ∀ w : EllipticRootNumber.relWeil F ⊥, ∀ v ∈ L, ρ w v ∈ L)
    (hnq : ¬ ∃ M : IntermediateField F (AlgebraicClosure F), FiniteDimensional F M ∧
      Module.finrank F M = 2 ∧ ∃ L : Submodule (EllipticRootNumber.Ω F) V,
        Module.finrank (EllipticRootNumber.Ω F) L = 1 ∧
        ∀ w : EllipticRootNumber.relWeil F ⊥, (w : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup →
          ∀ v ∈ L, ρ w v ∈ L)
    (δ : ∀ {V' : Type u} [AddCommGroup V'] [Module (EllipticRootNumber.Ω F) V'],
      Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V' →
        (EllipticRootNumber.Ω F)ˣ)
    (hexact : ∀ {V₁ V₀ V₂ : Type u} [AddCommGroup V₁] [Module (EllipticRootNumber.Ω F) V₁]
      [AddCommGroup V₀] [Module (EllipticRootNumber.Ω F) V₀]
      [AddCommGroup V₂] [Module (EllipticRootNumber.Ω F) V₂]
      (σ₁ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V₁)
      (σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V₀)
      (σ₂ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V₂),
      EllipticRootNumber.IsWeilRep F ⊥ σ₁ → EllipticRootNumber.IsWeilRep F ⊥ σ →
      EllipticRootNumber.IsWeilRep F ⊥ σ₂ →
      ∀ (f : V₁ →ₗ[EllipticRootNumber.Ω F] V₀) (g : V₀ →ₗ[EllipticRootNumber.Ω F] V₂),
        (∀ w, f ∘ₗ σ₁ w = σ w ∘ₗ f) → (∀ w, g ∘ₗ σ w = σ₂ w ∘ₗ g) →
        Function.Injective f → Function.Surjective g → LinearMap.range f = LinearMap.ker g →
        δ σ = δ σ₁ * δ σ₂)
    (hchar : ∀ χ : EllipticRootNumber.relWeil F ⊥ →* (EllipticRootNumber.Ω F)ˣ,
      EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ χ) →
      δ (EllipticRootNumber.charRep F ⊥ χ) = 1)
    (hind : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (θ θ' : EllipticRootNumber.relWeil F M →* (EllipticRootNumber.Ω F)ˣ),
      EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M θ) →
      EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M θ') →
      δ (EllipticRootNumber.indLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
          (EllipticRootNumber.charRep F M θ)) =
        δ (EllipticRootNumber.indLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
          (EllipticRootNumber.charRep F M θ'))) :
    δ ρ = 1 :=
by
  classical
  
  obtain ⟨N, hNfin, hNnorm, hconj, ω, -, hscal⟩ :=
    exists_scalar_twist_on_galois_subgroup F ρ hW hdim hnl
  haveI := hNfin
  haveI := hNnorm
  haveI hK0n : ((EllipticRootNumber.relWeil F N).subgroupOf
      (EllipticRootNumber.relWeil F ⊥)).Normal := by
    constructor
    intro k hk g
    rw [Subgroup.mem_subgroupOf] at hk ⊢
    have hk' : ((k : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈
        EllipticRootNumber.weilGroup F ⊓ N.fixingSubgroup := hk
    show ((g * k * g⁻¹ : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈
        EllipticRootNumber.weilGroup F ⊓ N.fixingSubgroup
    exact Subgroup.mem_inf.mpr ⟨EllipticRootNumber.relWeil_le_weilGroup F ⊥ (g * k * g⁻¹).2,
      hconj g k (Subgroup.mem_inf.mp hk').2⟩
  haveI hK0f := finiteIndex_relWeil_subgroupOf F N
  have hscal' : ∀ g ∈ (EllipticRootNumber.relWeil F N).subgroupOf
      (EllipticRootNumber.relWeil F ⊥), ρ g = (ω g : EllipticRootNumber.Ω F) • LinearMap.id := by
    intro g hg
    rw [Subgroup.mem_subgroupOf] at hg
    have hg' : ((g : EllipticRootNumber.relWeil F ⊥) : EllipticRootNumber.AbsGal F) ∈
        EllipticRootNumber.weilGroup F ⊓ N.fixingSubgroup := hg
    exact hscal g (Subgroup.mem_inf.mp hg').2
  
  have W1 : EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ 1) := by
    refine ⟨LinearEquiv.finiteDimensional ULift.moduleEquiv.symm, Set.univ, Filter.univ_mem,
      fun w _ _ => ?_⟩
    refine LinearMap.ext fun v => ?_
    simp [EllipticRootNumber.charRep]
  have hδ1 : δ (EllipticRootNumber.charRep F ⊥ 1) = 1 := hchar 1 W1
  
  have htriv : ∀ M : IntermediateField F (AlgebraicClosure F),
      (EllipticRootNumber.charRep F M 1).comp (Subgroup.subgroupOfEquivOfLe
        (EllipticRootNumber.relWeil_antitone F
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).toMonoidHom =
        Representation.trivial (EllipticRootNumber.Ω F) _ (ULift.{u} (EllipticRootNumber.Ω F)) := by
    intro M
    refine MonoidHom.ext fun g => LinearMap.ext fun v => ?_
    simp [EllipticRootNumber.charRep]
  
  obtain ⟨Lp, Lm, hhyp, hrel⟩ := solomon_permutation_relation (k := EllipticRootNumber.Ω F)
    ((EllipticRootNumber.relWeil F N).subgroupOf (EllipticRootNumber.relWeil F ⊥))
  
  have hloc : ∀ S ∈ Lp ++ Lm,
      δ (ρ.tprod (EllipticRootNumber.indRep S
          (Representation.trivial (EllipticRootNumber.Ω F) S (ULift.{u} (EllipticRootNumber.Ω F))))) =
        δ ((EllipticRootNumber.charRep F ⊥ 1).tprod (EllipticRootNumber.indRep S
          (Representation.trivial (EllipticRootNumber.Ω F) S
            (ULift.{u} (EllipticRootNumber.Ω F))))) ^ 2 := by
    intro S hSmem
    obtain ⟨hK0S, C, c₀, p, hp, hK0C, hCS, hCn, hc₀, hcyc, hpow⟩ := hhyp S hSmem
    obtain ⟨M, hMN, hMfin, hMchar, hSM⟩ := relWeil_subgroupOf_eq_of_le F N S hK0S
    haveI := hMfin
    have h4 := monomial_or_line_of_hyperelementary ρ hdim
      ((EllipticRootNumber.relWeil F N).subgroupOf (EllipticRootNumber.relWeil F ⊥)) ω hscal'
      S C c₀ p hp hK0C hCS hCn hc₀ hcyc hpow
    subst hSM
    have key := delta_tprod_indLM_of_good F ρ hW hdim δ hexact hind M (by
      rcases h4 with hl | ⟨S', hK0S', hS'S, ht, hL⟩
      · exact Or.inl hl
      · obtain ⟨M', hM'N, hM'fin, hM'char, hS'M'⟩ := relWeil_subgroupOf_eq_of_le F N S' hK0S'
        subst hS'M'
        refine Or.inr ⟨M', ?_, hM'fin, ht, hL⟩
        intro x hx
        have hxN : x ∈ N := hMN hx
        exact (hM'char x hxN).2 (fun s hs => (hMchar x hxN).1 hx s (hS'S hs)))
    unfold EllipticRootNumber.indLM at key
    rw [htriv M] at key
    exact key
  
  obtain ⟨hmulρ, hunitρ⟩ := delta_tprod_exact_and_unit F N δ hexact ρ hW
  obtain ⟨hmul1, hunit1⟩ := delta_tprod_exact_and_unit F N δ hexact
    (EllipticRootNumber.charRep F ⊥ 1) W1
  have relρ := hrel (fun τ => δ (ρ.tprod τ)) hmulρ
  have rel1 := hrel (fun τ => δ ((EllipticRootNumber.charRep F ⊥ 1).tprod τ)) hmul1
  beta_reduce at relρ rel1
  rw [hunitρ] at relρ
  rw [hunit1, hδ1, one_mul] at rel1
  have hA : (Lp.map fun S => δ (ρ.tprod (EllipticRootNumber.indRep S
      (Representation.trivial (EllipticRootNumber.Ω F) S (ULift.{u} (EllipticRootNumber.Ω F)))))) =
      Lp.map fun S => δ ((EllipticRootNumber.charRep F ⊥ 1).tprod (EllipticRootNumber.indRep S
        (Representation.trivial (EllipticRootNumber.Ω F) S
          (ULift.{u} (EllipticRootNumber.Ω F))))) ^ 2 :=
    List.map_congr_left fun S hS => hloc S (List.mem_append_left Lm hS)
  have hB : (Lm.map fun S => δ (ρ.tprod (EllipticRootNumber.indRep S
      (Representation.trivial (EllipticRootNumber.Ω F) S (ULift.{u} (EllipticRootNumber.Ω F)))))) =
      Lm.map fun S => δ ((EllipticRootNumber.charRep F ⊥ 1).tprod (EllipticRootNumber.indRep S
        (Representation.trivial (EllipticRootNumber.Ω F) S
          (ULift.{u} (EllipticRootNumber.Ω F))))) ^ 2 :=
    List.map_congr_left fun S hS => hloc S (List.mem_append_right Lp hS)
  have hpow : ∀ (l : List (Subgroup (EllipticRootNumber.relWeil F ⊥)))
      (f : Subgroup (EllipticRootNumber.relWeil F ⊥) → (EllipticRootNumber.Ω F)ˣ),
      (l.map fun S => f S ^ 2).prod = (l.map f).prod ^ 2 := by
    intro l f
    induction l with
    | nil => simp
    | cons a l ih => rw [List.map_cons, List.map_cons, List.prod_cons, List.prod_cons, ih, mul_pow]
  rw [hA, hB, hpow, hpow, ← rel1] at relρ
  exact mul_right_cancel (relρ.trans (one_mul _).symm)

theorem eps_psi_indep_of_primitive (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    {rec : EllipticRootNumber.LocalReciprocity F} (lc : EllipticRootNumber.LocalConstants F rec)
    {V : Type u} [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
    (ρ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V)
    (hW : EllipticRootNumber.IsWeilRep F ⊥ ρ)
    (hdim : Module.finrank (EllipticRootNumber.Ω F) V = 2)
    (hdet : ∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → LinearMap.det (ρ w) = 1)
    (hnl : ¬ ∃ L : Submodule (EllipticRootNumber.Ω F) V, Module.finrank (EllipticRootNumber.Ω F) L = 1 ∧
      ∀ w : EllipticRootNumber.relWeil F ⊥, ∀ v ∈ L, ρ w v ∈ L)
    (hnq : ¬ ∃ M : IntermediateField F (AlgebraicClosure F), FiniteDimensional F M ∧
      Module.finrank F M = 2 ∧ ∃ L : Submodule (EllipticRootNumber.Ω F) V,
        Module.finrank (EllipticRootNumber.Ω F) L = 1 ∧
        ∀ w : EllipticRootNumber.relWeil F ⊥, (w : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup →
          ∀ v ∈ L, ρ w v ∈ L)
    (ψ ψ' : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F))
    (hψ : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1)
    (hψ' : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ' x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ' x ≠ 1) :
    lc.eps ⊥ ρ ψ = lc.eps ⊥ ρ ψ' :=
by
  classical
  have adm : ∀ φ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F),
      ((∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → φ x = 1) ∧
        ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ φ x ≠ 1) →
      EllipticRootNumber.IsAdmissibleChar F ⊥ φ := by
    rintro φ ⟨h0, x, -, hx⟩
    exact ⟨fun h => hx (by rw [h, AddChar.one_apply]), 0, h0⟩
  have hadm := adm ψ hψ
  have hadm' := adm ψ' hψ'
  obtain ⟨b, hb, hbψ⟩ := exists_global_unit_addChar_twist F ψ ψ' hψ hψ'
  have hgI := recMap_unit_mem_inertia F rec b hb
  
  obtain ⟨δ, hδ⟩ : ∃ δ : (∀ {V' : Type u} [AddCommGroup V'] [Module (EllipticRootNumber.Ω F) V'],
      Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V' →
        (EllipticRootNumber.Ω F)ˣ),
      ∀ {V' : Type u} [AddCommGroup V'] [Module (EllipticRootNumber.Ω F) V']
        (σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V'),
        δ σ * lc.eps ⊥ σ ψ * MonoidHom.toHomUnits (LinearMap.det.comp σ) (rec.recMap ⊥ b) =
          lc.eps ⊥ σ ψ' :=
    ⟨fun σ => lc.eps ⊥ σ ψ' *
        (lc.eps ⊥ σ ψ * MonoidHom.toHomUnits (LinearMap.det.comp σ) (rec.recMap ⊥ b))⁻¹,
      fun σ => by group⟩
  
  have hexact : ∀ {V₁ V₀ V₂ : Type u} [AddCommGroup V₁] [Module (EllipticRootNumber.Ω F) V₁]
      [AddCommGroup V₀] [Module (EllipticRootNumber.Ω F) V₀]
      [AddCommGroup V₂] [Module (EllipticRootNumber.Ω F) V₂]
      (σ₁ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V₁)
      (σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V₀)
      (σ₂ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V₂),
      EllipticRootNumber.IsWeilRep F ⊥ σ₁ → EllipticRootNumber.IsWeilRep F ⊥ σ →
      EllipticRootNumber.IsWeilRep F ⊥ σ₂ →
      ∀ (f : V₁ →ₗ[EllipticRootNumber.Ω F] V₀) (q : V₀ →ₗ[EllipticRootNumber.Ω F] V₂),
        (∀ w, f ∘ₗ σ₁ w = σ w ∘ₗ f) → (∀ w, q ∘ₗ σ w = σ₂ w ∘ₗ q) →
        Function.Injective f → Function.Surjective q → LinearMap.range f = LinearMap.ker q →
        δ σ = δ σ₁ * δ σ₂ := by
    intro V₁ V₀ V₂ _ _ _ _ _ _ σ₁ σ σ₂ h₁ h h₂ f q hf hq hfi hqs hex
    have e1 := lc.eps_exact ⊥ ψ hadm σ₁ σ σ₂ h₁ h h₂ f q hf hq hfi hqs hex
    have e2 := lc.eps_exact ⊥ ψ' hadm' σ₁ σ σ₂ h₁ h h₂ f q hf hq hfi hqs hex
    haveI : FiniteDimensional (EllipticRootNumber.Ω F) V₀ := h.1
    have hd : LinearMap.det (σ (rec.recMap ⊥ b)) =
        LinearMap.det (σ₁ (rec.recMap ⊥ b)) * LinearMap.det (σ₂ (rec.recMap ⊥ b)) :=
      det_eq_mul_of_exact (σ₁ (rec.recMap ⊥ b)) (σ (rec.recMap ⊥ b)) (σ₂ (rec.recMap ⊥ b)) f q
        (hf _) (hq _) hfi hqs hex
    have hD : MonoidHom.toHomUnits (LinearMap.det.comp σ) (rec.recMap ⊥ b) =
        MonoidHom.toHomUnits (LinearMap.det.comp σ₁) (rec.recMap ⊥ b) *
          MonoidHom.toHomUnits (LinearMap.det.comp σ₂) (rec.recMap ⊥ b) := by
      ext
      simp only [MonoidHom.coe_toHomUnits, MonoidHom.comp_apply, Units.val_mul]
      exact hd
    have k := hδ σ
    have k1 := hδ σ₁
    have k2 := hδ σ₂
    rw [e1, e2, hD, ← k1, ← k2] at k
    have kk := congrArg Units.val k
    simp only [Units.val_mul] at kk
    ext
    simp only [Units.val_mul]
    have hne : ((lc.eps ⊥ σ₁ ψ : EllipticRootNumber.Ω F) * (lc.eps ⊥ σ₂ ψ : EllipticRootNumber.Ω F) *
        ((MonoidHom.toHomUnits (LinearMap.det.comp σ₁) (rec.recMap ⊥ b) : EllipticRootNumber.Ω F) *
          (MonoidHom.toHomUnits (LinearMap.det.comp σ₂) (rec.recMap ⊥ b) : EllipticRootNumber.Ω F)))
        ≠ 0 :=
      mul_ne_zero (mul_ne_zero (Units.ne_zero _) (Units.ne_zero _))
        (mul_ne_zero (Units.ne_zero _) (Units.ne_zero _))
    apply mul_right_cancel₀ hne
    linear_combination kk
  
  have hchar : ∀ χ : EllipticRootNumber.relWeil F ⊥ →* (EllipticRootNumber.Ω F)ˣ,
      EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ χ) →
      δ (EllipticRootNumber.charRep F ⊥ χ) = 1 := by
    intro χ hχ
    let χ' : (⊥ : IntermediateField F (AlgebraicClosure F))ˣ →* (EllipticRootNumber.Ω F)ˣ :=
      MonoidHom.mk' (fun x => χ (rec.recMap ⊥ x)) (weilChar_recMap_mul F rec ⊥ χ hχ)
    have hχ' : ∀ x, χ' x = χ (rec.recMap ⊥ x) := fun x => rfl
    have c1 := lc.eps_char ⊥ ψ hadm χ hχ χ' hχ'
    have c2 := lc.eps_char ⊥ ψ' hadm' χ hχ χ' hχ'
    have hψψ' : ψ' = ψ.compAddMonoidHom
        (AddMonoidHom.mulLeft (b : (⊥ : IntermediateField F (AlgebraicClosure F)))) := by
      ext y
      rw [hbψ y]
      rfl
    have hcont := charRec_trivial_on_unitGroup F rec ⊥ χ hχ χ' hχ'
    have t := tateEps_unit_twist F ⊥ χ' hcont ψ hadm b hb
    rw [← hψψ'] at t
    haveI : FiniteDimensional (EllipticRootNumber.Ω F) (ULift.{u} (EllipticRootNumber.Ω F)) := hχ.1
    have hfr : Module.finrank (EllipticRootNumber.Ω F) (ULift.{u} (EllipticRootNumber.Ω F)) = 1 :=
      (ULift.moduleEquiv.finrank_eq).trans (Module.finrank_self _)
    have hdet1 : LinearMap.det (EllipticRootNumber.charRep F ⊥ χ (rec.recMap ⊥ b)) =
        (χ (rec.recMap ⊥ b) : EllipticRootNumber.Ω F) := by
      show LinearMap.det ((χ (rec.recMap ⊥ b) : EllipticRootNumber.Ω F) •
        (LinearMap.id : ULift.{u} (EllipticRootNumber.Ω F) →ₗ[EllipticRootNumber.Ω F]
          ULift.{u} (EllipticRootNumber.Ω F))) = _
      rw [LinearMap.det_smul, LinearMap.det_id, mul_one, hfr, pow_one]
    have k := hδ (EllipticRootNumber.charRep F ⊥ χ)
    have kk := congrArg Units.val k
    simp only [Units.val_mul, MonoidHom.coe_toHomUnits, MonoidHom.comp_apply] at kk
    rw [hdet1, c2, t, ← c1, hχ'] at kk
    ext
    simp only [Units.val_one]
    have hne : ((lc.eps ⊥ (EllipticRootNumber.charRep F ⊥ χ) ψ : EllipticRootNumber.Ω F) *
        (χ (rec.recMap ⊥ b) : EllipticRootNumber.Ω F)) ≠ 0 :=
      mul_ne_zero (Units.ne_zero _) (Units.ne_zero _)
    apply mul_right_cancel₀ hne
    linear_combination kk
  
  have hind : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (θ θ' : EllipticRootNumber.relWeil F M →* (EllipticRootNumber.Ω F)ˣ),
      EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M θ) →
      EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M θ') →
      δ (EllipticRootNumber.indLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
          (EllipticRootNumber.charRep F M θ)) =
        δ (EllipticRootNumber.indLM F (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
          (EllipticRootNumber.charRep F M θ')) := by
    intro M _ θ θ' hθ hθ'
    haveI := finiteIndex_relWeil_subgroupOf F M
    have hsep : Algebra.IsSeparable (⊥ : IntermediateField F (AlgebraicClosure F))
        (IntermediateField.extendScalars
          (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)) := inferInstance
    have A := lc.eps_ind ⊥ M bot_le hsep ψ hadm (EllipticRootNumber.charRep F M θ)
      (EllipticRootNumber.charRep F M θ') hθ hθ' rfl
    have B := lc.eps_ind ⊥ M bot_le hsep ψ' hadm' (EllipticRootNumber.charRep F M θ)
      (EllipticRootNumber.charRep F M θ') hθ hθ' rfl
    have s3a := eps_traceChar_unit_twist F lc M θ hθ ψ ψ' hψ b hb hbψ
    have s3b := eps_traceChar_unit_twist F lc M θ' hθ' ψ ψ' hψ b hb hbψ
    have s4a := recMap_transfer_compat F rec M θ hθ b
    have s4b := recMap_transfer_compat F rec M θ' hθ' b
    have C := det_indLM_charRep_mul_transfer F M θ θ' (rec.recMap ⊥ b)
    have AA := congrArg Units.val A
    have BB := congrArg Units.val B
    simp only [Units.val_mul] at AA BB
    rw [s3a, s3b, s4a, s4b] at BB
    have k := congrArg Units.val (hδ (EllipticRootNumber.indLM F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) (EllipticRootNumber.charRep F M θ)))
    have k' := congrArg Units.val (hδ (EllipticRootNumber.indLM F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M) (EllipticRootNumber.charRep F M θ')))
    simp only [Units.val_mul, MonoidHom.coe_toHomUnits, MonoidHom.comp_apply] at k k'
    ext
    have hD1 := (MonoidHom.toHomUnits (LinearMap.det.comp (EllipticRootNumber.indLM F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
      (EllipticRootNumber.charRep F M θ))) (rec.recMap ⊥ b)).ne_zero
    have hD2 := (MonoidHom.toHomUnits (LinearMap.det.comp (EllipticRootNumber.indLM F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
      (EllipticRootNumber.charRep F M θ'))) (rec.recMap ⊥ b)).ne_zero
    simp only [MonoidHom.coe_toHomUnits, MonoidHom.comp_apply] at hD1 hD2
    set X := (lc.eps ⊥ (EllipticRootNumber.indLM F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
      (EllipticRootNumber.charRep F M θ)) ψ : EllipticRootNumber.Ω F) with hX
    set Y := (lc.eps ⊥ (EllipticRootNumber.indLM F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
      (EllipticRootNumber.charRep F M θ')) ψ : EllipticRootNumber.Ω F) with hY
    set Y' := (lc.eps ⊥ (EllipticRootNumber.indLM F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
      (EllipticRootNumber.charRep F M θ')) ψ' : EllipticRootNumber.Ω F) with hY'
    set D := LinearMap.det (EllipticRootNumber.indLM F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
      (EllipticRootNumber.charRep F M θ) (rec.recMap ⊥ b)) with hDdef
    set D' := LinearMap.det (EllipticRootNumber.indLM F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M)
      (EllipticRootNumber.charRep F M θ') (rec.recMap ⊥ b)) with hD'def
    set e := (lc.eps M (EllipticRootNumber.charRep F M θ)
      (EllipticRootNumber.traceChar F bot_le ψ) : EllipticRootNumber.Ω F) with he
    set e' := (lc.eps M (EllipticRootNumber.charRep F M θ')
      (EllipticRootNumber.traceChar F bot_le ψ) : EllipticRootNumber.Ω F) with he'
    set T := (((θ.comp (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).toMonoidHom).transfer
        (rec.recMap ⊥ b) : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) with hT
    set T' := (((θ'.comp (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
      (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M))).toMonoidHom).transfer
        (rec.recMap ⊥ b) : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) with hT'
    have hne : X * Y * D * D' * e' * T' ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero
        (Units.ne_zero _) (Units.ne_zero _)) hD1) hD2) (Units.ne_zero _)) (Units.ne_zero _)
    apply mul_right_cancel₀ hne
    linear_combination (Y * D' * e' * T') * k - (X * D * e' * T') * k' + (Y * D') * BB -
      (Y' * Y * e) * C - (Y' * D * T') * AA
  
  have hfin : δ ρ = 1 := brauer_relation_primitive F ρ hW hdim hnl hnq δ hexact hchar hind
  have k := hδ ρ
  have hD : MonoidHom.toHomUnits (LinearMap.det.comp ρ) (rec.recMap ⊥ b) = 1 := by
    ext
    simp only [MonoidHom.coe_toHomUnits, MonoidHom.comp_apply, Units.val_one]
    exact hdet _ hgI
  rw [hfin, one_mul, hD, mul_one] at k
  exact k

theorem eps_ellAdicRep_threeRootsCurve_char_indep (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    (t₁ t₂ t₃ : F) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃)
    (hE : EllipticRootNumber.IsPotentiallyGood F (threeRootsCurve t₁ t₂ t₃))
    {rec : EllipticRootNumber.LocalReciprocity F} (lc : EllipticRootNumber.LocalConstants F rec)
    (ψ ψ' : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F))
    (hψ : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ x ≠ 1)
    (hψ' : (∀ x, 0 ≤ EllipticRootNumber.valL F ⊥ x → ψ' x = 1) ∧
      ∃ x, EllipticRootNumber.valL F ⊥ x = -1 ∧ ψ' x ≠ 1) :
    lc.eps ⊥ ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
        (EllipticRootNumber.relWeil F ⊥).subtype) ψ =
      lc.eps ⊥ ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
        (EllipticRootNumber.relWeil F ⊥).subtype) ψ' :=
by
  classical
  
  have hΔ : (threeRootsCurve t₁ t₂ t₃).Δ ≠ 0 := by
    have e : (threeRootsCurve t₁ t₂ t₃).Δ =
        16 * ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) ^ 2 := by
      simp only [threeRootsCurve, WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
        WeierstrassCurve.b₆, WeierstrassCurve.b₈]
      ring
    rw [e]
    refine mul_ne_zero (by norm_num) (pow_ne_zero _ (mul_ne_zero (mul_ne_zero ?_ ?_) ?_))
    · exact sub_ne_zero.mpr h₁₂
    · exact sub_ne_zero.mpr h₁₃
    · exact sub_ne_zero.mpr h₂₃
  
  have hW : EllipticRootNumber.IsWeilRep F ⊥
      ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
        (EllipticRootNumber.relWeil F ⊥).subtype) := by
    refine ⟨finiteDimensional_vBar_threeRootsCurve F t₁ t₂ t₃ h₁₂ h₁₃ h₂₃, ?_⟩
    obtain ⟨U, hU, hUρ⟩ := ellAdicRep_threeRootsCurve_inertia F t₁ t₂ t₃ h₁₂ h₁₃ h₂₃ hE
    exact ⟨U, hU, fun w h1 h2 => hUρ w h1 h2⟩
  
  have hdim := finrank_vBar_eq_two F (threeRootsCurve t₁ t₂ t₃) hΔ
  
  have hdet : ∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
        LinearMap.det (((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
          (EllipticRootNumber.relWeil F ⊥).subtype) w) = 1 :=
    fun w hw => det_ellAdicRep_eq_one_of_mem_inertia F (threeRootsCurve t₁ t₂ t₃) hΔ
      (w : EllipticRootNumber.AbsGal F) hw
  
  by_cases h1 : ∃ L : Submodule (EllipticRootNumber.Ω F)
      (EllipticRootNumber.VBar F (threeRootsCurve t₁ t₂ t₃)),
      Module.finrank (EllipticRootNumber.Ω F) L = 1 ∧
      ∀ w : EllipticRootNumber.relWeil F ⊥, ∀ v ∈ L,
        ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
          (EllipticRootNumber.relWeil F ⊥).subtype) w v ∈ L
  · exact eps_psi_indep_of_line F lc _ hW hdim hdet h1 ψ ψ' hψ hψ'
  · by_cases h2 : ∃ M : IntermediateField F (AlgebraicClosure F), FiniteDimensional F M ∧
        Module.finrank F M = 2 ∧ ∃ L : Submodule (EllipticRootNumber.Ω F)
          (EllipticRootNumber.VBar F (threeRootsCurve t₁ t₂ t₃)),
          Module.finrank (EllipticRootNumber.Ω F) L = 1 ∧
          ∀ w : EllipticRootNumber.relWeil F ⊥,
            (w : EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup → ∀ v ∈ L,
              ((EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
                (EllipticRootNumber.relWeil F ⊥).subtype) w v ∈ L
    · exact eps_psi_indep_of_quadratic_line F lc _ hW hdim hdet h1 h2 ψ ψ' hψ hψ'
    · exact eps_psi_indep_of_primitive F lc _ hW hdim hdet h1 h2 ψ ψ' hψ hψ'

theorem localReciprocity_eq_mod_abelian (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (rec rec' : EllipticRootNumber.LocalReciprocity F)
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] [FiniteDimensional F M]
    (h : L ≤ M) (hab : EllipticRootNumber.IsAbelianExt F h) (x : Lˣ) :
    (((rec.recMap L x)⁻¹ * rec'.recMap L x : EllipticRootNumber.relWeil F L) :
      EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup :=
by
  classical
  
  have key : ∀ z : Lˣ, EllipticRootNumber.relVal F L (z : L) ≠ 0 →
      (((rec.recMap L z)⁻¹ * rec'.recMap L z : EllipticRootNumber.relWeil F L) :
        EllipticRootNumber.AbsGal F) ∈ M.fixingSubgroup := by
    intro z hz
    refine relWeil_eq_mod_abelian_of_degree_fix F L M h hab (rec.recMap L z) (rec'.recMap L z)
      (-EllipticRootNumber.relVal F L (z : L)) (neg_ne_zero.mpr hz)
      (rec.degree_rec L z) (rec'.degree_rec L z) ?_
    intro K _ hLK habK hw
    exact (rec'.ker_rec L K hLK habK z).mpr ((rec.ker_rec L K hLK habK z).mp hw)
  by_cases hx : EllipticRootNumber.relVal F L (x : L) = 0
  swap
  · exact key x hx
  
  obtain ⟨hadd, y, hy0, hy⟩ := relVal_mul_and_exists_ne_zero F L
  have hu : EllipticRootNumber.relVal F L ((Units.mk0 y hy0 : Lˣ) : L) ≠ 0 := by
    rw [Units.val_mk0]; exact hy
  have hxu : EllipticRootNumber.relVal F L ((x * Units.mk0 y hy0 : Lˣ) : L) ≠ 0 := by
    rw [Units.val_mul, Units.val_mk0, hadd _ _ x.ne_zero hy0, hx, zero_add]; exact hy
  have k3 := key _ hu
  have k4 := key _ hxu
  have k1 := rec.mul_rec L M h hab x (Units.mk0 y hy0)
  have k2 := rec'.mul_rec L M h hab x (Units.mk0 y hy0)
  have hb : ((rec.recMap L (Units.mk0 y hy0) : EllipticRootNumber.relWeil F L) :
      EllipticRootNumber.AbsGal F) ∈ L.fixingSubgroup :=
    (Subgroup.mem_inf.mp (rec.recMap L (Units.mk0 y hy0)).2).2
  simp only [Subgroup.coe_mul, Subgroup.coe_inv] at k1 k2 k3 k4 ⊢
  generalize ((rec.recMap L x : EllipticRootNumber.relWeil F L) :
    EllipticRootNumber.AbsGal F) = a at *
  generalize ((rec'.recMap L x : EllipticRootNumber.relWeil F L) :
    EllipticRootNumber.AbsGal F) = a' at *
  generalize ((rec.recMap L (Units.mk0 y hy0) : EllipticRootNumber.relWeil F L) :
    EllipticRootNumber.AbsGal F) = b at *
  generalize ((rec'.recMap L (Units.mk0 y hy0) : EllipticRootNumber.relWeil F L) :
    EllipticRootNumber.AbsGal F) = b' at *
  generalize ((rec.recMap L (x * Units.mk0 y hy0) : EllipticRootNumber.relWeil F L) :
    EllipticRootNumber.AbsGal F) = c at *
  generalize ((rec'.recMap L (x * Units.mk0 y hy0) : EllipticRootNumber.relWeil F L) :
    EllipticRootNumber.AbsGal F) = c' at *
  have hκ : (c⁻¹ * (a * b))⁻¹ * (c⁻¹ * c') * (c'⁻¹ * (a' * b')) * (b⁻¹ * b')⁻¹ ∈
      M.fixingSubgroup :=
    M.fixingSubgroup.mul_mem (M.fixingSubgroup.mul_mem (M.fixingSubgroup.mul_mem
      (M.fixingSubgroup.inv_mem k1) k4) k2) (M.fixingSubgroup.inv_mem k3)
  have hconj := hab.1 b hb _ hκ
  have heq : a⁻¹ * a' =
      b * ((c⁻¹ * (a * b))⁻¹ * (c⁻¹ * c') * (c'⁻¹ * (a' * b')) * (b⁻¹ * b')⁻¹) * b⁻¹ := by
    group
  rw [heq]
  exact hconj

theorem eps_charRep_lc_indep (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    {rec rec' : EllipticRootNumber.LocalReciprocity F}
    (lc : EllipticRootNumber.LocalConstants F rec) (lc' : EllipticRootNumber.LocalConstants F rec')
    (L M₀ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] [FiniteDimensional F M₀]
    (hLM : L ≤ M₀) (hab : EllipticRootNumber.IsAbelianExt F hLM)
    (hrec : ∀ x : Lˣ, (((rec.recMap L x)⁻¹ * rec'.recMap L x : EllipticRootNumber.relWeil F L) :
      EllipticRootNumber.AbsGal F) ∈ M₀.fixingSubgroup)
    (φ : AddChar L (EllipticRootNumber.Ω F)) (hφ : EllipticRootNumber.IsAdmissibleChar F L φ)
    (χ : EllipticRootNumber.relWeil F L →* (EllipticRootNumber.Ω F)ˣ)
    (hχW : EllipticRootNumber.IsWeilRep F L (EllipticRootNumber.charRep F L χ))
    (hχ : ∀ g : EllipticRootNumber.relWeil F L, (g : EllipticRootNumber.AbsGal F) ∈ M₀.fixingSubgroup →
      (g : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → χ g = 1) :
    lc.eps L (EllipticRootNumber.charRep F L χ) φ = lc'.eps L (EllipticRootNumber.charRep F L χ) φ :=
by
  classical
  obtain ⟨D, hDdef⟩ : ∃ D : EllipticRootNumber.relWeil F L →* Multiplicative ℤ,
      D = (EllipticRootNumber.weilDegreeHom F).comp
        (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F L)) := ⟨_, rfl⟩
  have hDr : ∀ (R : EllipticRootNumber.LocalReciprocity F) (x : Lˣ),
      D (R.recMap L x) = Multiplicative.ofAdd (-EllipticRootNumber.relVal F L (x : L)) := by
    intro R x
    subst hDdef
    exact R.degree_rec L x
  have hD0 : ∀ g : EllipticRootNumber.relWeil F L, D g = 1 →
      (g : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F := by
    intro g hg
    subst hDdef
    exact weilDegreeHom_ker_le_inertia F _ hg
  obtain ⟨-, hrv, hva, -⟩ := valL_spec F L
  have hadd : ∀ x y : Lˣ, EllipticRootNumber.relVal F L ((x * y : Lˣ) : L) =
      EllipticRootNumber.relVal F L (x : L) + EllipticRootNumber.relVal F L (y : L) := by
    intro x y
    rw [Units.val_mul, hrv _ (mul_ne_zero x.ne_zero y.ne_zero), hva _ _ x.ne_zero y.ne_zero,
      hrv _ x.ne_zero, hrv _ y.ne_zero, mul_add]
  have hmul : ∀ x y : Lˣ, χ (rec.recMap L (x * y)) = χ (rec.recMap L x) * χ (rec.recMap L y) := by
    intro x y
    have hM := rec.mul_rec L M₀ hLM hab x y
    have hD : D ((rec.recMap L (x * y))⁻¹ * (rec.recMap L x * rec.recMap L y)) = 1 := by
      rw [map_mul, map_inv, map_mul, hDr, hDr, hDr, hadd]
      apply Multiplicative.toAdd.injective
      simp only [toAdd_mul, toAdd_inv, toAdd_ofAdd, toAdd_one]
      ring
    have h1 := hχ _ hM (hD0 _ hD)
    rw [map_mul, map_inv, map_mul] at h1
    exact inv_mul_eq_one.mp h1
  have hagree : ∀ x : Lˣ, χ (rec'.recMap L x) = χ (rec.recMap L x) := by
    intro x
    have hD : D ((rec.recMap L x)⁻¹ * rec'.recMap L x) = 1 := by
      rw [map_mul, map_inv, hDr, hDr, inv_mul_cancel]
    have h1 := hχ _ (hrec x) (hD0 _ hD)
    rw [map_mul, map_inv] at h1
    exact (inv_mul_eq_one.mp h1).symm
  let χ₀ : Lˣ →* (EllipticRootNumber.Ω F)ˣ := MonoidHom.mk' (fun x => χ (rec.recMap L x)) hmul
  have e1 := lc.eps_char L φ hφ χ hχW χ₀ (fun x => rfl)
  have e2 := lc'.eps_char L φ hφ χ hχW χ₀ (fun x => (hagree x).symm)
  exact Units.ext (e1.trans e2.symm)

theorem eps_lc_indep_of_commuting (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {rec rec' : EllipticRootNumber.LocalReciprocity F}
    (lc : EllipticRootNumber.LocalConstants F rec) (lc' : EllipticRootNumber.LocalConstants F rec')
    (L M₀ : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (φ : AddChar L (EllipticRootNumber.Ω F)) (hφ : EllipticRootNumber.IsAdmissibleChar F L φ)
    (hchar : ∀ χ : EllipticRootNumber.relWeil F L →* (EllipticRootNumber.Ω F)ˣ,
      EllipticRootNumber.IsWeilRep F L (EllipticRootNumber.charRep F L χ) →
      (∀ g : EllipticRootNumber.relWeil F L, (g : EllipticRootNumber.AbsGal F) ∈ M₀.fixingSubgroup →
        (g : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → χ g = 1) →
      lc.eps L (EllipticRootNumber.charRep F L χ) φ = lc'.eps L (EllipticRootNumber.charRep F L χ) φ)
    {V : Type u} [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
    (σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F L) V)
    (hσ : EllipticRootNumber.IsWeilRep F L σ)
    (hσM : ∀ g : EllipticRootNumber.relWeil F L, (g : EllipticRootNumber.AbsGal F) ∈ M₀.fixingSubgroup →
      (g : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → σ g = 1)
    (hcomm : ∀ w w' : EllipticRootNumber.relWeil F L, σ w * σ w' = σ w' * σ w) :
    lc.eps L σ φ = lc'.eps L σ φ :=
by
  classical
  
  have ceig : ∀ (V : Type u) [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
      [FiniteDimensional (EllipticRootNumber.Ω F) V] [Nontrivial V]
      (f : EllipticRootNumber.relWeil F L → Module.End (EllipticRootNumber.Ω F) V),
      (∀ i j, f i * f j = f j * f i) →
      ∃ v : V, v ≠ 0 ∧ ∀ i, ∃ c : EllipticRootNumber.Ω F, f i v = c • v := by
    intro V _ _ _ _ f hf
    let P : Submodule (EllipticRootNumber.Ω F) V → Prop :=
      fun W => W ≠ ⊥ ∧ ∀ i, ∀ x ∈ W, f i x ∈ W
    have hex : ∃ d, ∃ W, P W ∧ Module.finrank (EllipticRootNumber.Ω F) W = d :=
      ⟨_, ⊤, ⟨top_ne_bot, fun i x _ => Submodule.mem_top⟩, rfl⟩
    obtain ⟨W₀, hP, hd⟩ := Nat.find_spec hex
    have hmin : ∀ W, P W → Module.finrank (EllipticRootNumber.Ω F) W₀ ≤
        Module.finrank (EllipticRootNumber.Ω F) W := by
      intro W hW
      rw [hd]
      exact Nat.find_min' hex ⟨W, hW, rfl⟩
    have hconst : ∀ i, ∃ c : EllipticRootNumber.Ω F, ∀ x ∈ W₀, f i x = c • x := by
      intro i
      haveI : Nontrivial W₀ := Submodule.nontrivial_iff_ne_bot.mpr hP.1
      let g : Module.End (EllipticRootNumber.Ω F) W₀ := (f i).restrict (fun x hx => hP.2 i x hx)
      obtain ⟨c, hc⟩ := Module.End.exists_eigenvalue g
      obtain ⟨y, hy⟩ := hc.exists_hasEigenvector
      refine ⟨c, ?_⟩
      let E := W₀ ⊓ Module.End.eigenspace (f i) c
      have hyE : (y : V) ∈ E := by
        refine Submodule.mem_inf.mpr ⟨y.2, ?_⟩
        rw [Module.End.mem_eigenspace_iff]
        have h2 := congrArg Subtype.val hy.apply_eq_smul
        exact h2
      have hy0 : (y : V) ≠ 0 := fun h => hy.2 (Subtype.ext h)
      have hPE : P E := by
        refine ⟨fun h => hy0 ?_, ?_⟩
        · rw [h] at hyE; exact (Submodule.mem_bot _).mp hyE
        · intro j x hx
          have hx1 := (Submodule.mem_inf.mp hx).1
          have hx2 := Module.End.mem_eigenspace_iff.mp (Submodule.mem_inf.mp hx).2
          refine Submodule.mem_inf.mpr ⟨hP.2 j x hx1, ?_⟩
          rw [Module.End.mem_eigenspace_iff]
          calc f i (f j x) = (f i * f j) x := rfl
            _ = (f j * f i) x := by rw [hf i j]
            _ = f j (f i x) := rfl
            _ = c • f j x := by rw [hx2, map_smul]
      have hle : E ≤ W₀ := inf_le_left
      have hEq : E = W₀ := Submodule.eq_of_le_of_finrank_le hle (hmin E hPE)
      intro x hx
      rw [← hEq] at hx
      exact Module.End.mem_eigenspace_iff.mp (Submodule.mem_inf.mp hx).2
    obtain ⟨v, hvW, hv0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hP.1
    exact ⟨v, hv0, fun i => by
      obtain ⟨c, hc⟩ := hconst i
      exact ⟨c, hc v hvW⟩⟩
  
  have mkchar : ∀ (V : Type u) [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
      (ρ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F L) V) (v : V),
      v ≠ 0 → (∀ g, ∃ c : EllipticRootNumber.Ω F, ρ g v = c • v) →
      ∃ χ : EllipticRootNumber.relWeil F L →* (EllipticRootNumber.Ω F)ˣ,
        ∀ g, ρ g v = ((χ g : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) • v := by
    intro V _ _ ρ v hv h
    choose c hc using h
    have inj : ∀ a b : EllipticRootNumber.Ω F, a • v = b • v → a = b :=
      fun a b hab => smul_left_injective (EllipticRootNumber.Ω F) hv hab
    let c₀ : EllipticRootNumber.relWeil F L →* EllipticRootNumber.Ω F :=
      { toFun := c
        map_one' := inj _ _ (by rw [← hc, map_one, one_smul]; rfl)
        map_mul' := fun g h => inj _ _ (by
          rw [← hc, map_mul, Module.End.mul_apply, hc h, map_smul, hc g, smul_smul, mul_comm]) }
    exact ⟨c₀.toHomUnits, fun g => by rw [hc g]; rfl⟩
  
  have eps1 : ∀ {r : EllipticRootNumber.LocalReciprocity F} (l : EllipticRootNumber.LocalConstants F r)
      (V : Type u) [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V] [Subsingleton V]
      (σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F L) V),
      EllipticRootNumber.IsWeilRep F L σ → l.eps L σ φ = 1 := by
    intro r l V _ _ _ σ hσ
    have h := l.eps_exact L φ hφ σ σ σ hσ hσ hσ 0 0
      (fun w => by rw [LinearMap.zero_comp, LinearMap.comp_zero])
      (fun w => by rw [LinearMap.zero_comp, LinearMap.comp_zero])
      (fun a b _ => Subsingleton.elim a b) (fun y => ⟨y, Subsingleton.elim _ _⟩)
      (Submodule.ext fun x => by rw [Subsingleton.elim x 0]; simp)
    have h' : l.eps L σ φ * 1 = l.eps L σ φ * l.eps L σ φ := by rw [mul_one]; exact h
    exact (mul_left_cancel h').symm
  
  have key : ∀ (n : ℕ) (V : Type u) [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
      (σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F L) V),
      EllipticRootNumber.IsWeilRep F L σ →
      (∀ g : EllipticRootNumber.relWeil F L, (g : EllipticRootNumber.AbsGal F) ∈ M₀.fixingSubgroup →
        (g : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F → σ g = 1) →
      (∀ w w' : EllipticRootNumber.relWeil F L, σ w * σ w' = σ w' * σ w) →
      Module.finrank (EllipticRootNumber.Ω F) V = n → lc.eps L σ φ = lc'.eps L σ φ := by
    intro n
    refine Nat.strong_induction_on n ?_
    intro n IH V _ _ σ hσ hσM hcomm hn
    haveI : FiniteDimensional (EllipticRootNumber.Ω F) V := hσ.1
    by_cases hnt : Nontrivial V
    · haveI := hnt
      obtain ⟨v, hv0, hev⟩ := ceig V (fun w => σ w) hcomm
      obtain ⟨χ, hχ⟩ := mkchar V σ v hv0 hev
      
      have hχ1 : ∀ g, σ g = 1 → χ g = 1 := by
        intro g hg
        apply Units.ext
        apply smul_left_injective (EllipticRootNumber.Ω F) hv0
        show ((χ g : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) • v =
          ((1 : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) • v
        rw [← hχ g, hg, Units.val_one, one_smul]
        rfl
      obtain ⟨U, hU, hUσ⟩ := hσ.2
      have hχW : EllipticRootNumber.IsWeilRep F L (EllipticRootNumber.charRep F L χ) := by
        refine ⟨inferInstance, U, hU, fun w h1 h2 => ?_⟩
        have h3 := hχ1 w (hUσ w h1 h2)
        apply LinearMap.ext
        intro x
        show ((χ w : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) • x = x
        rw [h3, Units.val_one, one_smul]
      have hEpsχ := hchar χ hχW (fun g h1 h2 => hχ1 g (hσM g h1 h2))
      
      let W := Submodule.span (EllipticRootNumber.Ω F) {v}
      have hW : ∀ g, W ≤ W.comap (σ g) := by
        intro g x hx
        obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hx
        rw [Submodule.mem_comap, map_smul, hχ g, smul_smul]
        exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self v)
      let σ₂ := σ.quotient W hW
      have hσ₂ : ∀ g x, σ₂ g (Submodule.Quotient.mk x) = Submodule.Quotient.mk (σ g x) := by
        intro g x
        rfl
      have hσ₂1 : ∀ g, σ g = 1 → σ₂ g = 1 := by
        intro g hg
        apply LinearMap.ext
        intro y
        induction y using Submodule.Quotient.induction_on with
        | H x => rw [hσ₂, hg]; rfl
      have hσ₂c : ∀ w w', σ₂ w * σ₂ w' = σ₂ w' * σ₂ w := by
        intro w w'
        apply LinearMap.ext
        intro y
        induction y using Submodule.Quotient.induction_on with
        | H x =>
          simp only [Module.End.mul_apply, hσ₂]
          exact congrArg Submodule.Quotient.mk (LinearMap.congr_fun (hcomm w w') x)
      have hσ₂W : EllipticRootNumber.IsWeilRep F L σ₂ :=
        ⟨inferInstance, U, hU, fun w h1 h2 => hσ₂1 w (hUσ w h1 h2)⟩
      
      have hdimW : Module.finrank (EllipticRootNumber.Ω F) W = 1 := finrank_span_singleton hv0
      have hq := Submodule.finrank_quotient_add_finrank W
      have hpos : 0 < Module.finrank (EllipticRootNumber.Ω F) V := Module.finrank_pos
      have hlt : Module.finrank (EllipticRootNumber.Ω F) (V ⧸ W) < n := by omega
      have hEps₂ := IH _ hlt (V ⧸ W) σ₂ hσ₂W (fun g h1 h2 => hσ₂1 g (hσM g h1 h2)) hσ₂c rfl
      
      let f : ULift.{u} (EllipticRootNumber.Ω F) →ₗ[EllipticRootNumber.Ω F] V :=
        (LinearMap.toSpanSingleton _ V v).comp ULift.moduleEquiv.toLinearMap
      have hfapp : ∀ c, f c = c.down • v := fun c => rfl
      have hf : ∀ w, f ∘ₗ EllipticRootNumber.charRep F L χ w = σ w ∘ₗ f := by
        intro w
        apply LinearMap.ext
        intro c
        rw [LinearMap.comp_apply, LinearMap.comp_apply]
        show (((χ w : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) • c).down • v =
          σ w (c.down • v)
        rw [map_smul, hχ w, smul_smul, ULift.smul_down, smul_eq_mul, mul_comm]
      have hg : ∀ w, W.mkQ ∘ₗ σ w = σ₂ w ∘ₗ W.mkQ := by
        intro w
        apply LinearMap.ext
        intro x
        exact (hσ₂ w x).symm
      have hinj : Function.Injective f := by
        intro a b hab
        rw [hfapp, hfapp] at hab
        exact ULift.ext _ _ (smul_left_injective _ hv0 hab)
      have hrk : LinearMap.range f = LinearMap.ker W.mkQ := by
        rw [Submodule.ker_mkQ]
        apply le_antisymm
        · rintro _ ⟨c, rfl⟩
          rw [hfapp]
          exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self v)
        · intro x hx
          obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hx
          exact ⟨ULift.up a, rfl⟩
      have e1 := lc.eps_exact L φ hφ _ σ σ₂ hχW hσ hσ₂W f W.mkQ hf hg hinj
        (Submodule.mkQ_surjective W) hrk
      have e2 := lc'.eps_exact L φ hφ _ σ σ₂ hχW hσ hσ₂W f W.mkQ hf hg hinj
        (Submodule.mkQ_surjective W) hrk
      rw [e1, e2, hEpsχ, hEps₂]
    · haveI : Subsingleton V := not_nontrivial_iff_subsingleton.mp hnt
      rw [eps1 lc V σ hσ, eps1 lc' V σ hσ]
  exact key _ V σ hσ hσM hcomm rfl

theorem traceChar_isAdmissibleChar (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (h : L ≤ M)
    (ψ : AddChar L (EllipticRootNumber.Ω F)) (hψ : EllipticRootNumber.IsAdmissibleChar F L ψ) :
    EllipticRootNumber.IsAdmissibleChar F M (EllipticRootNumber.traceChar F h ψ) :=
by
  classical
  
  haveI hFL : FiniteDimensional F L :=
    FiniteDimensional.of_injective (IntermediateField.inclusion h).toLinearMap
      (fun a b hab => by
        have hv := congrArg Subtype.val hab
        exact Subtype.ext hv)
  haveI hFM' : FiniteDimensional F (IntermediateField.extendScalars h) := by
    let g : IntermediateField.extendScalars h →ₗ[F] M :=
      { toFun := fun z => ⟨(z : AlgebraicClosure F), (IntermediateField.mem_extendScalars h).mp z.2⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    exact FiniteDimensional.of_injective g (fun a b hab => by
      have hv := congrArg Subtype.val hab
      exact Subtype.ext hv)
  haveI hLM' : FiniteDimensional L (IntermediateField.extendScalars h) :=
    Module.Finite.of_restrictScalars_finite F L _
  
  obtain ⟨w, hw₁, hw₂⟩ := exists_galoisInvariant_valuation_algebraicClosure F
  
  have trace_le : ∀ y : M, w ((EllipticRootNumber.traceLM F h y : L) : AlgebraicClosure F) ≤
      w (y : AlgebraicClosure F) := by
    intro y
    set z : IntermediateField.extendScalars h := EllipticRootNumber.toExtendScalars F h y with hzdef
    have htr : ((EllipticRootNumber.traceLM F h y : L) : AlgebraicClosure F) =
        ∑ σ : (IntermediateField.extendScalars h) →ₐ[L] AlgebraicClosure F, σ z := by
      rw [← trace_eq_sum_embeddings (AlgebraicClosure F) (x := z)]
      rfl
    rw [htr]
    apply Valuation.map_sum_le
    intro σ _
    haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
    have hτ := AlgHom.liftNormal_commutes σ (AlgebraicClosure F) z
    have hbij : Function.Bijective ((σ.liftNormal (AlgebraicClosure F)).restrictScalars F) :=
      Algebra.IsAlgebraic.algHom_bijective _
    have hw := hw₂ (AlgEquiv.ofBijective _ hbij) (y : AlgebraicClosure F)
    calc w (σ z) = w ((σ.liftNormal (AlgebraicClosure F))
          (algebraMap (IntermediateField.extendScalars h) (AlgebraicClosure F) z)) := by
          rw [hτ]; rfl
      _ = w (y : AlgebraicClosure F) := hw
      _ ≤ w (y : AlgebraicClosure F) := le_rfl
  
  have surj : Function.Surjective (EllipticRootNumber.traceLM F h) := by
    intro x
    obtain ⟨z, hz⟩ := Algebra.trace_surjective L (IntermediateField.extendScalars h) x
    exact ⟨⟨(z : AlgebraicClosure F), (IntermediateField.mem_extendScalars h).mp z.2⟩, hz⟩
  obtain ⟨fL_pos, hrelL, -, -, -, hrL⟩ := valL_spec F L
  obtain ⟨fM_pos, hrelM, -, -, -, hrM⟩ := valL_spec F M
  obtain ⟨rL, rL0, rL1, hwL⟩ := hrL w hw₁ hw₂
  obtain ⟨rM, rM0, rM1, hwM⟩ := hrM w hw₁ hw₂
  obtain ⟨hψ1, d, hd⟩ := hψ
  refine ⟨?_, ?_⟩
  · intro hc
    apply hψ1
    ext x
    obtain ⟨y, hy⟩ := surj x
    have hcy := congrArg (fun χ : AddChar M (EllipticRootNumber.Ω F) => χ y) hc
    simp only [AddChar.one_apply] at hcy ⊢
    rw [← hy]
    exact hcy
  · have nL_pos : 0 < Module.finrank F L := Module.finrank_pos
    have nM_pos : 0 < Module.finrank F M := Module.finrank_pos
    have C_pos : (0 : NNReal) <
        (rL ^ ((EllipticRootNumber.resDeg F L : ℤ) * d)) ^ Module.finrank F M :=
      pow_pos (zpow_pos rL0 _) _
    obtain ⟨k, hk⟩ := exists_pow_lt_of_lt_one C_pos rM1
    refine ⟨(k : ℤ), fun y hy => ?_⟩
    show ψ (EllipticRootNumber.traceLM F h y) = 1
    by_cases ht : EllipticRootNumber.traceLM F h y = 0
    · rw [ht]; exact AddChar.map_zero_eq_one ψ
    have hy0 : y ≠ 0 := by
      rintro rfl
      exact ht (map_zero _)
    apply hd
    have h1 := hwM y hy0
    have h2 := hwL _ ht
    have h3 := hrelM y hy0
    have h4 := hrelL _ ht
    have hle := trace_le y
    have hfM : (1 : ℤ) ≤ (EllipticRootNumber.resDeg F M : ℤ) := by exact_mod_cast fM_pos
    have hnL : (1 : ℤ) ≤ (Module.finrank F L : ℤ) := by exact_mod_cast nL_pos
    have hk0 : (0 : ℤ) ≤ k := by positivity
    have hrv : (k : ℤ) ≤ EllipticRootNumber.relVal F M y := by
      rw [h3]; nlinarith
    have hrv' : (k : ℤ) ≤ EllipticRootNumber.relVal F M y * (Module.finrank F L : ℤ) := by
      nlinarith
    have hA : w (y : AlgebraicClosure F) ^ (Module.finrank F M * Module.finrank F L) ≤ rM ^ k := by
      rw [pow_mul, h1, ← zpow_natCast, ← zpow_mul, ← zpow_natCast rM k]
      exact zpow_le_zpow_right_of_le_one₀ rM0 rM1.le hrv'
    have hB : (w ((EllipticRootNumber.traceLM F h y : L) : AlgebraicClosure F) ^
        Module.finrank F L) ^ Module.finrank F M ≤
        (rL ^ ((EllipticRootNumber.resDeg F L : ℤ) * d)) ^ Module.finrank F M := by
      calc _ = w ((EllipticRootNumber.traceLM F h y : L) : AlgebraicClosure F) ^
            (Module.finrank F M * Module.finrank F L) := by rw [← pow_mul, mul_comm]
        _ ≤ w (y : AlgebraicClosure F) ^ (Module.finrank F M * Module.finrank F L) :=
            pow_le_pow_left₀ (zero_le _) hle _
        _ ≤ rM ^ k := hA
        _ ≤ _ := hk.le
    have hC := (pow_le_pow_iff_left₀ (zero_le _) (zero_le _) nM_pos.ne').mp hB
    rw [h2] at hC
    have hD := (zpow_le_zpow_iff_right_of_lt_one₀ rL0 rL1).mp hC
    rw [h4] at hD
    have hfL : (0 : ℤ) < (EllipticRootNumber.resDeg F L : ℤ) := by exact_mod_cast fL_pos
    exact le_of_mul_le_mul_left hD hfL

theorem eps_lc_indep_of_relation (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    {rec rec' : EllipticRootNumber.LocalReciprocity F}
    (lc : EllipticRootNumber.LocalConstants F rec) (lc' : EllipticRootNumber.LocalConstants F rec')
    (ψ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F))
    (hψ : EllipticRootNumber.IsAdmissibleChar F ⊥ ψ)
    {V : Type u} [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
    (ρ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V)
    (hρ : EllipticRootNumber.IsWeilRep F ⊥ ρ)
    (n a b : ℕ) {A B : Fin n → Type u} [∀ i, AddCommGroup (A i)] [∀ i, Module (EllipticRootNumber.Ω F) (A i)]
    [∀ i, AddCommGroup (B i)] [∀ i, Module (EllipticRootNumber.Ω F) (B i)]
    (α : ∀ i, Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) (A i))
    (β : ∀ i, Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) (B i))
    (hα : ∀ i, EllipticRootNumber.IsWeilRep F ⊥ (α i)) (hβ : ∀ i, EllipticRootNumber.IsWeilRep F ⊥ (β i))
    (hpair : ∀ i, lc.eps ⊥ (β i) ψ * lc'.eps ⊥ (α i) ψ = lc'.eps ⊥ (β i) ψ * lc.eps ⊥ (α i) ψ)
    (lam : Fin a → EllipticRootNumber.relWeil F ⊥ →* (EllipticRootNumber.Ω F)ˣ)
    (μ : Fin b → EllipticRootNumber.relWeil F ⊥ →* (EllipticRootNumber.Ω F)ˣ)
    (hlamW : ∀ j, EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ (lam j)))
    (hμW : ∀ k, EllipticRootNumber.IsWeilRep F ⊥ (EllipticRootNumber.charRep F ⊥ (μ k)))
    (hlam : ∀ j, lc.eps ⊥ (EllipticRootNumber.charRep F ⊥ (lam j)) ψ =
      lc'.eps ⊥ (EllipticRootNumber.charRep F ⊥ (lam j)) ψ)
    (hμ : ∀ k, lc.eps ⊥ (EllipticRootNumber.charRep F ⊥ (μ k)) ψ =
      lc'.eps ⊥ (EllipticRootNumber.charRep F ⊥ (μ k)) ψ)
    (e : ((V × (∀ i, A i)) × (Fin a → ULift.{u} (EllipticRootNumber.Ω F))) ≃ₗ[EllipticRootNumber.Ω F]
      ((∀ i, B i) × (Fin b → ULift.{u} (EllipticRootNumber.Ω F))))
    (he : ∀ w : EllipticRootNumber.relWeil F ⊥,
      e.toLinearMap ∘ₗ (((ρ w).prodMap (LinearMap.pi fun i => (α i w) ∘ₗ LinearMap.proj i)).prodMap
          (LinearMap.pi fun j => (((lam j w : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) •
            LinearMap.proj j))) =
        ((LinearMap.pi fun i => (β i w) ∘ₗ LinearMap.proj i).prodMap
          (LinearMap.pi fun k => (((μ k w : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) •
            LinearMap.proj k))) ∘ₗ e.toLinearMap) :
    lc.eps ⊥ ρ ψ = lc'.eps ⊥ ρ ψ :=
by
  classical
  
  have epsOne : ∀ {r : EllipticRootNumber.LocalReciprocity F} (c : EllipticRootNumber.LocalConstants F r)
      {X : Type u} [AddCommGroup X] [Module (EllipticRootNumber.Ω F) X] [Subsingleton X]
      (σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) X),
      EllipticRootNumber.IsWeilRep F ⊥ σ → c.eps ⊥ σ ψ = 1 := by
    intro r c X _ _ _ σ hσ
    have h := c.eps_exact ⊥ ψ hψ σ σ σ hσ hσ hσ LinearMap.id 0
      (fun w => by rw [LinearMap.id_comp, LinearMap.comp_id])
      (fun w => by rw [LinearMap.zero_comp, LinearMap.comp_zero])
      Function.injective_id (fun y => ⟨0, Subsingleton.elim _ _⟩)
      (by rw [LinearMap.range_id, LinearMap.ker_zero])
    exact left_eq_mul.mp h
  
  have isoEps : ∀ {r : EllipticRootNumber.LocalReciprocity F} (c : EllipticRootNumber.LocalConstants F r)
      {V₁ V₂ : Type u} [AddCommGroup V₁] [Module (EllipticRootNumber.Ω F) V₁]
      [AddCommGroup V₂] [Module (EllipticRootNumber.Ω F) V₂]
      (σ₁ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V₁)
      (σ₂ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) V₂),
      EllipticRootNumber.IsWeilRep F ⊥ σ₁ → EllipticRootNumber.IsWeilRep F ⊥ σ₂ →
      ∀ (e : V₁ ≃ₗ[EllipticRootNumber.Ω F] V₂),
        (∀ w, e.toLinearMap ∘ₗ σ₁ w = σ₂ w ∘ₗ e.toLinearMap) →
        c.eps ⊥ σ₁ ψ = c.eps ⊥ σ₂ ψ := by
    intro r c V₁ V₂ _ _ _ _ σ₁ σ₂ h₁ h₂ e he'
    let τ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) PUnit.{u+1} := 1
    have hτ : EllipticRootNumber.IsWeilRep F ⊥ τ :=
      ⟨inferInstance, Set.univ, Filter.univ_mem, fun w _ _ => rfl⟩
    have h := c.eps_exact ⊥ ψ hψ σ₁ σ₂ τ h₁ h₂ hτ e.toLinearMap 0 he'
      (fun w => by rw [LinearMap.zero_comp, LinearMap.comp_zero])
      e.injective (fun y => ⟨0, Subsingleton.elim _ _⟩)
      (by rw [LinearEquiv.range, LinearMap.ker_zero])
    rw [h, epsOne c τ hτ, mul_one]
  
  have prodW : ∀ {X Y : Type u} [AddCommGroup X] [Module (EllipticRootNumber.Ω F) X]
      [AddCommGroup Y] [Module (EllipticRootNumber.Ω F) Y]
      (σ₁ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) X)
      (σ₂ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) Y),
      EllipticRootNumber.IsWeilRep F ⊥ σ₁ → EllipticRootNumber.IsWeilRep F ⊥ σ₂ →
      EllipticRootNumber.IsWeilRep F ⊥ (σ₁.prod σ₂) := by
    intro X Y _ _ _ _ σ₁ σ₂ h₁ h₂
    obtain ⟨hf₁, U₁, hU₁, k₁⟩ := h₁
    obtain ⟨hf₂, U₂, hU₂, k₂⟩ := h₂
    haveI := hf₁
    haveI := hf₂
    refine ⟨inferInstance, U₁ ∩ U₂, Filter.inter_mem hU₁ hU₂, fun w hw hI => ?_⟩
    show (σ₁ w).prodMap (σ₂ w) = 1
    rw [k₁ w hw.1 hI, k₂ w hw.2 hI]
    exact LinearMap.prodMap_one
  
  have prodEps : ∀ {r : EllipticRootNumber.LocalReciprocity F} (c : EllipticRootNumber.LocalConstants F r)
      {X Y : Type u} [AddCommGroup X] [Module (EllipticRootNumber.Ω F) X]
      [AddCommGroup Y] [Module (EllipticRootNumber.Ω F) Y]
      (σ₁ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) X)
      (σ₂ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) Y),
      EllipticRootNumber.IsWeilRep F ⊥ σ₁ → EllipticRootNumber.IsWeilRep F ⊥ σ₂ →
      c.eps ⊥ (σ₁.prod σ₂) ψ = c.eps ⊥ σ₁ ψ * c.eps ⊥ σ₂ ψ := by
    intro r c X Y _ _ _ _ σ₁ σ₂ h₁ h₂
    exact c.eps_exact ⊥ ψ hψ σ₁ (σ₁.prod σ₂) σ₂ h₁ (prodW σ₁ σ₂ h₁ h₂) h₂
      (LinearMap.inl _ X Y) (LinearMap.snd _ X Y)
      (fun w => LinearMap.ext fun x => by simp [Representation.prod_apply_apply])
      (fun w => LinearMap.ext fun x => by simp [Representation.prod_apply_apply])
      LinearMap.inl_injective LinearMap.snd_surjective (LinearMap.range_inl _ X Y)
  
  have exPi : ∀ (m : ℕ) {C : Fin m → Type u} [∀ i, AddCommGroup (C i)]
      [∀ i, Module (EllipticRootNumber.Ω F) (C i)]
      (γ : ∀ i, Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) (C i)),
      ∃ σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) (∀ i, C i),
        ∀ w, σ w = LinearMap.pi fun i => (γ i w) ∘ₗ LinearMap.proj i := by
    intro m C _ _ γ
    refine ⟨{ toFun := fun w => LinearMap.pi fun i => (γ i w) ∘ₗ LinearMap.proj i,
              map_one' := ?_, map_mul' := ?_ }, fun w => rfl⟩
    · apply LinearMap.ext
      intro f
      funext i
      simp
    · intro g h
      apply LinearMap.ext
      intro f
      funext i
      simp [Module.End.mul_apply]
  
  have piW : ∀ (m : ℕ) {C : Fin m → Type u} [∀ i, AddCommGroup (C i)]
      [∀ i, Module (EllipticRootNumber.Ω F) (C i)]
      (γ : ∀ i, Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) (C i)),
      (∀ i, EllipticRootNumber.IsWeilRep F ⊥ (γ i)) →
      ∀ σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) (∀ i, C i),
        (∀ w, σ w = LinearMap.pi fun i => (γ i w) ∘ₗ LinearMap.proj i) →
        EllipticRootNumber.IsWeilRep F ⊥ σ := by
    intro m C _ _ γ hγ σ hσ
    haveI : ∀ i, FiniteDimensional (EllipticRootNumber.Ω F) (C i) := fun i => (hγ i).1
    choose U hU k using fun i => (hγ i).2
    refine ⟨inferInstance, ⋂ i, U i, Filter.iInter_mem.mpr hU, fun w hw hI => ?_⟩
    rw [hσ w]
    apply LinearMap.ext
    intro f
    funext i
    simp [k i w (Set.mem_iInter.mp hw i) hI]
  
  have piEps : ∀ {r : EllipticRootNumber.LocalReciprocity F} (c : EllipticRootNumber.LocalConstants F r)
      (m : ℕ) {C : Fin m → Type u} [∀ i, AddCommGroup (C i)]
      [∀ i, Module (EllipticRootNumber.Ω F) (C i)]
      (γ : ∀ i, Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) (C i)),
      (∀ i, EllipticRootNumber.IsWeilRep F ⊥ (γ i)) →
      ∀ σ : Representation (EllipticRootNumber.Ω F) (EllipticRootNumber.relWeil F ⊥) (∀ i, C i),
        (∀ w, σ w = LinearMap.pi fun i => (γ i w) ∘ₗ LinearMap.proj i) →
        c.eps ⊥ σ ψ = ∏ i, c.eps ⊥ (γ i) ψ := by
    intro r c m
    induction m with
    | zero =>
      intro C _ _ γ hγ σ hσ
      rw [Fin.prod_univ_zero]
      exact epsOne c σ (piW 0 γ hγ σ hσ)
    | succ m ih =>
      intro C _ _ γ hγ σ hσ
      obtain ⟨σ', hσ'⟩ := exPi m (fun i => γ i.succ)
      have hσ'W := piW m (fun i => γ i.succ) (fun i => hγ i.succ) σ' hσ'
      have h1 := ih (fun i => γ i.succ) (fun i => hγ i.succ) σ' hσ'
      have h2 := prodEps c (γ 0) σ' (hγ 0) hσ'W
      have h3 := isoEps c ((γ 0).prod σ') σ
        (prodW _ _ (hγ 0) hσ'W) (piW _ γ hγ σ hσ)
        (Fin.consLinearEquiv (EllipticRootNumber.Ω F) C) (fun w => by
          apply LinearMap.ext
          rintro ⟨x, f⟩
          funext i
          refine Fin.cases ?_ (fun j => ?_) i
          · simp [hσ, Representation.prod_apply_apply]
          · simp [hσ, hσ', Representation.prod_apply_apply])
      rw [Fin.prod_univ_succ, ← h3, h2, h1]
  
  obtain ⟨πA, hπA⟩ := exPi n α
  obtain ⟨πB, hπB⟩ := exPi n β
  obtain ⟨πl, hπl⟩ := exPi a (fun j => EllipticRootNumber.charRep F ⊥ (lam j))
  obtain ⟨πm, hπm⟩ := exPi b (fun k => EllipticRootNumber.charRep F ⊥ (μ k))
  have hAW := piW n α hα πA hπA
  have hBW := piW n β hβ πB hπB
  have hlW := piW a _ hlamW πl hπl
  have hmW := piW b _ hμW πm hπm
  have hsm : ∀ {d : ℕ} (χ : Fin d → EllipticRootNumber.relWeil F ⊥ →* (EllipticRootNumber.Ω F)ˣ)
      (w : EllipticRootNumber.relWeil F ⊥),
      (LinearMap.pi fun j => (EllipticRootNumber.charRep F ⊥ (χ j) w) ∘ₗ LinearMap.proj j :
          (Fin d → ULift.{u} (EllipticRootNumber.Ω F)) →ₗ[EllipticRootNumber.Ω F]
            (Fin d → ULift.{u} (EllipticRootNumber.Ω F))) =
        LinearMap.pi fun j => (((χ j w : (EllipticRootNumber.Ω F)ˣ) : EllipticRootNumber.Ω F) •
          LinearMap.proj j) := by
    intro d χ w
    apply LinearMap.ext
    intro f
    funext j
    rfl
  have hint : ∀ w, e.toLinearMap ∘ₗ ((ρ.prod πA).prod πl) w = (πB.prod πm) w ∘ₗ e.toLinearMap := by
    intro w
    have h := he w
    rw [← hsm lam w, ← hsm μ w, ← hπA w, ← hπl w, ← hπB w, ← hπm w] at h
    exact h
  have key : ∀ {r : EllipticRootNumber.LocalReciprocity F} (c : EllipticRootNumber.LocalConstants F r),
      c.eps ⊥ ρ ψ * (∏ i, c.eps ⊥ (α i) ψ) *
          (∏ j, c.eps ⊥ (EllipticRootNumber.charRep F ⊥ (lam j)) ψ) =
        (∏ i, c.eps ⊥ (β i) ψ) * (∏ k, c.eps ⊥ (EllipticRootNumber.charRep F ⊥ (μ k)) ψ) := by
    intro r c
    have hE := isoEps c _ _ (prodW _ _ (prodW _ _ hρ hAW) hlW)
      (prodW _ _ hBW hmW) e hint
    rw [prodEps c _ _ (prodW _ _ hρ hAW) hlW, prodEps c _ _ hρ hAW, prodEps c _ _ hBW hmW,
      piEps c n α hα πA hπA, piEps c a _ hlamW πl hπl, piEps c n β hβ πB hπB,
      piEps c b _ hμW πm hπm] at hE
    exact hE
  
  have k1 := key lc
  have k2 := key lc'
  have hΛ : (∏ j, lc'.eps ⊥ (EllipticRootNumber.charRep F ⊥ (lam j)) ψ) =
      ∏ j, lc.eps ⊥ (EllipticRootNumber.charRep F ⊥ (lam j)) ψ :=
    Finset.prod_congr rfl fun j _ => (hlam j).symm
  have hM : (∏ k, lc'.eps ⊥ (EllipticRootNumber.charRep F ⊥ (μ k)) ψ) =
      ∏ k, lc.eps ⊥ (EllipticRootNumber.charRep F ⊥ (μ k)) ψ :=
    Finset.prod_congr rfl fun k _ => (hμ k).symm
  have hQP : (∏ i, lc.eps ⊥ (β i) ψ) * (∏ i, lc'.eps ⊥ (α i) ψ) =
      (∏ i, lc'.eps ⊥ (β i) ψ) * (∏ i, lc.eps ⊥ (α i) ψ) := by
    rw [← Finset.prod_mul_distrib, ← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl fun i _ => hpair i
  rw [hΛ, hM] at k2
  generalize lc.eps ⊥ ρ ψ = x at k1 ⊢
  generalize lc'.eps ⊥ ρ ψ = x' at k2 ⊢
  generalize (∏ i, lc.eps ⊥ (α i) ψ) = P at k1 hQP
  generalize (∏ i, lc'.eps ⊥ (α i) ψ) = P' at k2 hQP
  generalize (∏ i, lc.eps ⊥ (β i) ψ) = Q at k1 hQP
  generalize (∏ i, lc'.eps ⊥ (β i) ψ) = Q' at k2 hQP
  generalize (∏ j, lc.eps ⊥ (EllipticRootNumber.charRep F ⊥ (lam j)) ψ) = Λ at k1 k2
  generalize (∏ k, lc.eps ⊥ (EllipticRootNumber.charRep F ⊥ (μ k)) ψ) = M at k1 k2
  apply mul_right_cancel (b := P * Λ * P')
  calc x * (P * Λ * P') = (x * P * Λ) * P' := by ac_rfl
    _ = Q * M * P' := by rw [k1]
    _ = (Q * P') * M := by ac_rfl
    _ = (Q' * P) * M := by rw [hQP]
    _ = (Q' * M) * P := by ac_rfl
    _ = (x' * P' * Λ) * P := by rw [k2]
    _ = x' * (P * Λ * P') := by ac_rfl

theorem indLM_charRep_isWeilRep (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] (h : L ≤ M)
    (χ : EllipticRootNumber.relWeil F M →* (EllipticRootNumber.Ω F)ˣ)
    (hχ : EllipticRootNumber.IsWeilRep F M (EllipticRootNumber.charRep F M χ)) :
    EllipticRootNumber.IsWeilRep F L (EllipticRootNumber.indLM F h (EllipticRootNumber.charRep F M χ)) :=
by
  classical
  
  have s3 : ∀ {G : Type u} [Group G] (H : Subgroup G) [Finite (G ⧸ H)] {V : Type u}
      [AddCommGroup V] [Module (EllipticRootNumber.Ω F) V]
      [FiniteDimensional (EllipticRootNumber.Ω F) V]
      (ρ : Representation (EllipticRootNumber.Ω F) H V),
      FiniteDimensional (EllipticRootNumber.Ω F) (EllipticRootNumber.indSpace H ρ) := by
    intro G _ H _ V _ _ _ ρ
    let Ψ : EllipticRootNumber.indSpace H ρ →ₗ[EllipticRootNumber.Ω F] (G ⧸ H → V) :=
      (LinearMap.funLeft (EllipticRootNumber.Ω F) V (fun c : G ⧸ H => (Quotient.out c)⁻¹)) ∘ₗ
        (EllipticRootNumber.indSpace H ρ).subtype
    have hdec : ∀ x : G, ∃ k₀ : H,
        x = (k₀ : G) * (Quotient.out (QuotientGroup.mk x⁻¹ : G ⧸ H))⁻¹ := by
