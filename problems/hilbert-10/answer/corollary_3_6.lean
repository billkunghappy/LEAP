theorem descentClass_odd_caseC {F : Type*} [Field F]
    (w : Valuation F (WithZero (Multiplicative ℤ)))
    (h2 : w 2 = 1)
    (hsq : ∀ u : F, w (u - 1) < 1 → IsSquare u)
    (ε : F) (hεw : w ε = 1) (hεns : ¬ IsSquare ε)
    (hεd : ∀ u : F, w u = 1 → IsSquare u ∨ IsSquare (ε * u))
    (hres : ∀ c : F, w c = 1 → ∃ x : F, w x ≤ 1 ∧ w (x ^ 2 + c) = 1 ∧ ¬ IsSquare (x ^ 2 + c))
    (t₁ t₂ t₃ : F) (hα : w (t₁ - t₂) = 1) (hβ : w (t₁ - t₃) = 1) (hγ : w (t₂ - t₃) < 1) :
    IsDescentClass t₁ t₂ t₃ 1 ε ∧
    ∀ u : F, w u = WithZero.exp (-1 : ℤ) →
      (IsDescentClass t₁ t₂ t₃ 1 u ↔ IsSquare (-(t₁ - t₂))) :=
by
  have hV2 : ∀ g : WithZero (Multiplicative ℤ), g < 1 → g ≤ WithZero.exp (-1 : ℤ) := by
    intro g hg
    by_cases h0 : g = 0
    · rw [h0]; exact zero_le'
    · obtain ⟨k, hk⟩ : ∃ k : ℤ, g = WithZero.exp k := ⟨_, (WithZero.exp_log h0).symm⟩
      rw [hk] at hg ⊢
      rw [← WithZero.exp_zero, WithZero.exp_lt_exp] at hg
      rw [WithZero.exp_le_exp]; omega
  have hwnα : w (-(t₁ - t₂)) = 1 := by rw [Valuation.map_neg, hα]
  refine ⟨?_, fun u hu => ⟨?_, ?_⟩⟩
  · 
    have hε0 : ε ≠ 0 := by
      intro h; rw [h, map_zero] at hεw; exact zero_ne_one hεw
    have hεinv : ε * ε⁻¹ = 1 := mul_inv_cancel₀ hε0
    obtain ⟨y, -, hA1, hAns⟩ := hres (t₁ - t₂) hα
    have hA0 : y ^ 2 + (t₁ - t₂) ≠ 0 := by
      intro h; rw [h, map_zero] at hA1; exact zero_ne_one hA1
