        exact mul_ne_zero WithZero.exp_ne_zero (pow_ne_zero 2 WithZero.exp_ne_zero) h
      · obtain ⟨j, hj⟩ : ∃ j : ℤ, w b = WithZero.exp j := ⟨_, (WithZero.exp_log hwb).symm⟩
        rw [hj, ← WithZero.exp_nsmul, ← WithZero.exp_nsmul, ← WithZero.exp_add,
