    have hχ'W : ∀ i, EllipticRootNumber.IsWeilRep F (M i) (EllipticRootNumber.charRep F (M i) (χ' i)) :=
      fun i => hWeil i (θ' i) (fun t ht => (hθK0 i t ht).2)
    
    have hAbM : ∀ i, ∃ (N' : IntermediateField F (AlgebraicClosure F)) (_ : FiniteDimensional F N')
