        rw [← he₁, map_pow, show δ ^ 6 = (δ ^ 3) ^ 2 by rw [← pow_mul]]
        exact pow_lt_pow_left₀ hy1 zero_le' two_ne_zero
      rcases dich with h6 | h2
      · exact absurd h6 (not_le.mpr hf)
      · refine P2 _ (2 * y₁) _ (div_mul_cancel₀ _ hy0).symm ?_
        exact lt_of_le_of_lt h2y (lt_of_lt_of_le hA2 h2)
  
  have s4 : ∀ (V : Valuation F (ValuativeRel.ValueGroupWithZero F)) (a : F),
      V t₁ ≤ 1 → V t₂ ≤ 1 → V t₃ ≤ 1 →
      V a < V 2 * V ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) ^ 3 →
      ∀ (x₁ y₁ x₂ y₂ : F)
        (h₁ : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x₁ y₁)
        (h₂ : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x₂ y₂),
        V x₁ ≤ 1 → V x₂ ≤ 1 → V (x₁ - x₂) ≤ V a → V (y₁ - y₂) ≤ V a →
        ∀ (x₃ y₃ : F) (h₃ : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x₃ y₃),
          WeierstrassCurve.Affine.Point.some h₁ - WeierstrassCurve.Affine.Point.some h₂ =
            WeierstrassCurve.Affine.Point.some h₃ → 1 < V x₃ := by
    intro V a ht₁ ht₂ ht₃ ha x₁ y₁ x₂ y₂ h₁ h₂ hx₁ hx₂ hx hy x₃ y₃ h₃ E
    have eqn : ∀ {x y : F}, (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y →
        y ^ 2 = (x - t₁) * (x - t₂) * (x - t₃) := by
      intro x y h
      have h' := h.1
      rw [WeierstrassCurve.Affine.equation_iff] at h'
      simp only [threeRootsCurve] at h'
      linear_combination h'
    have hc := s3 V a x₁ y₁ x₂ y₂ ht₁ ht₂ ht₃ ha hx₁ hx₂ (eqn h₁) (eqn h₂) hx hy
    have hadd : ∀ a b : F, V a ≤ 1 → V b ≤ 1 → V (a + b) ≤ 1 := fun a b ha hb =>
      le_trans (Valuation.map_add _ _ _) (max_le ha hb)
    have hsub : ∀ a b : F, V a ≤ 1 → V b ≤ 1 → V (a - b) ≤ 1 := fun a b ha hb =>
      le_trans (Valuation.map_sub _ _ _) (max_le ha hb)
    have hnegY : ∀ x y : F, (threeRootsCurve t₁ t₂ t₃).toAffine.negY x y = -y := by
      intro x y
      simp [WeierstrassCurve.Affine.negY, threeRootsCurve]
    rw [sub_eq_add_neg, WeierstrassCurve.Affine.Point.neg_some] at E
    by_cases hxy : x₁ = x₂ ∧ y₁ = (threeRootsCurve t₁ t₂ t₃).toAffine.negY x₂
        ((threeRootsCurve t₁ t₂ t₃).toAffine.negY x₂ y₂)
    · rw [WeierstrassCurve.Affine.Point.add_of_Y_eq hxy.1 hxy.2] at E
      cases E
    · rw [WeierstrassCurve.Affine.Point.add_some hxy] at E
      simp only [WeierstrassCurve.Affine.Point.some.injEq] at E
      obtain ⟨hx3, -⟩ := E
      rw [← hx3]
      obtain ⟨ℓ, hℓdef⟩ : ∃ ℓ, ℓ = (threeRootsCurve t₁ t₂ t₃).toAffine.slope x₁ x₂ y₁
          ((threeRootsCurve t₁ t₂ t₃).toAffine.negY x₂ y₂) := ⟨_, rfl⟩
      rw [← hℓdef]
      have hℓ : 1 < V ℓ := by
        by_cases hX : x₁ = x₂
        · have hY : y₁ ≠ (threeRootsCurve t₁ t₂ t₃).toAffine.negY x₂
              ((threeRootsCurve t₁ t₂ t₃).toAffine.negY x₂ y₂) := fun h => hxy ⟨hX, h⟩
          have hne : y₁ ≠ y₂ := by rw [hnegY, hnegY, neg_neg] at hY; exact hY
          rw [hℓdef, WeierstrassCurve.Affine.slope_of_Y_ne hX hY]
          have e : (3 * x₁ ^ 2 + 2 * (threeRootsCurve t₁ t₂ t₃).toAffine.a₂ * x₁ +
              (threeRootsCurve t₁ t₂ t₃).toAffine.a₄ -
                (threeRootsCurve t₁ t₂ t₃).toAffine.a₁ * y₁) /
              (y₁ - (threeRootsCurve t₁ t₂ t₃).toAffine.negY x₁ y₁) =
              (3 * x₁ ^ 2 - 2 * (t₁ + t₂ + t₃) * x₁ + (t₁ * t₂ + t₁ * t₃ + t₂ * t₃)) /
                (2 * y₁) := by
            rw [hnegY]
            simp only [threeRootsCurve]
            ring
          rw [e]
          exact hc.2 hX hne
        · rw [hℓdef, WeierstrassCurve.Affine.slope_of_X_ne hX, hnegY, sub_neg_eq_add]
          exact hc.1 hX
      have hx3e : (threeRootsCurve t₁ t₂ t₃).toAffine.addX x₁ x₂ ℓ =
          ℓ ^ 2 + ((t₁ + t₂ + t₃) - x₁ - x₂) := by
        simp only [WeierstrassCurve.Affine.addX, threeRootsCurve]
        ring
      rw [hx3e]
      have hc1 : V ((t₁ + t₂ + t₃) - x₁ - x₂) ≤ 1 :=
        hsub _ _ (hsub _ _ (hadd _ _ (hadd _ _ ht₁ ht₂) ht₃) hx₁) hx₂
      have hl2 : 1 < V (ℓ ^ 2) := by rw [map_pow]; exact one_lt_pow₀ hℓ two_ne_zero
      rw [Valuation.map_add_eq_of_lt_left _ (lt_of_le_of_lt hc1 hl2)]
      exact hl2
  
  have s5 : ∀ a₀ : ↥(ValuativeRel.valuation F).integer, a₀ ≠ 0 →
      Finite (↥(ValuativeRel.valuation F).integer ⧸ Ideal.span {a₀}) := by
    intro a₀ ha₀
    obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible (ValuativeRel.valuation F).integer
    have hne : Ideal.span {a₀} ≠ ⊥ := by
      rw [Ne, Ideal.span_singleton_eq_bot]; exact ha₀
    obtain ⟨n, hn⟩ := IsDiscreteValuationRing.ideal_eq_span_pow_irreducible hne hπ
    have hm : IsLocalRing.maximalIdeal (ValuativeRel.valuation F).integer = Ideal.span {π} :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mp hπ
    have hpow : Ideal.span {a₀} =
        (IsLocalRing.maximalIdeal (ValuativeRel.valuation F).integer) ^ n := by
      rw [hn, hm, Ideal.span_singleton_pow]
    haveI : Finite (↥(ValuativeRel.valuation F).integer ⧸
        IsLocalRing.maximalIdeal (ValuativeRel.valuation F).integer) :=
      (inferInstance : Finite (IsLocalRing.ResidueField (ValuativeRel.valuation F).integer))
    rw [hpow]
    exact Ideal.finite_quotient_pow (IsNoetherian.noetherian _) n
  
  have eqnV : ∀ {x y : F}, (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y →
      y ^ 2 = (x - t₁) * (x - t₂) * (x - t₃) := by
    intro x y h
    have h' := h.1
    rw [WeierstrassCurve.Affine.equation_iff] at h'
    simp only [threeRootsCurve] at h'
    linear_combination h'
  
  have hyint : ∀ (x y : F) (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y),
      ValuativeRel.valuation F x ≤ 1 → ValuativeRel.valuation F y ≤ 1 := by
    intro x y h hx
    have hs : ∀ t : F, ValuativeRel.valuation F t ≤ 1 → ValuativeRel.valuation F (x - t) ≤ 1 :=
      fun t ht => le_trans (Valuation.map_sub _ _ _) (max_le hx ht)
    have hf : ValuativeRel.valuation F y ^ 2 ≤ 1 := by
      rw [← map_pow, eqnV h, map_mul, map_mul]
      exact mul_le_one' (mul_le_one' (hs _ ht₁) (hs _ ht₂)) (hs _ ht₃)
    by_contra hlt
    push_neg at hlt
    exact absurd (one_lt_pow₀ hlt two_ne_zero) (not_lt.mpr hf)
  
  have E1 : ∀ (x y : F) (h : (threeRootsCurve t₁ t₂ t₃).toAffine.Nonsingular x y),
      1 < ValuativeRel.valuation F x → 1 ≤ ValuativeRel.valuation F (ϖ ^ 2 * x) := by
    intro x y h hx
    have hxi : ∀ t : F, ValuativeRel.valuation F t ≤ 1 →
        ValuativeRel.valuation F (x - t) = ValuativeRel.valuation F x := fun t ht =>
      Valuation.map_sub_eq_of_lt_left _ (lt_of_le_of_lt ht hx)
    have hVy : ValuativeRel.valuation F y ^ 2 = ValuativeRel.valuation F x ^ 3 := by
      rw [← map_pow, eqnV h, map_mul, map_mul, hxi _ ht₁, hxi _ ht₂, hxi _ ht₃, pow_three']
    have hVx0 : ValuativeRel.valuation F x ≠ 0 := (lt_trans zero_lt_one hx).ne'
    have hy0 : y ≠ 0 := by
      rintro rfl
      rw [map_zero, zero_pow two_ne_zero] at hVy
      exact pow_ne_zero 3 hVx0 hVy.symm
    obtain ⟨m, hm⟩ : ∃ m, m = ValuativeRel.valuation F (x / y) := ⟨_, rfl⟩
