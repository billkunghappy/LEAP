      (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F L)) := by
    let φ : (EllipticRootNumber.relWeil F L ⧸
        (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F L)) →
        (M →ₐ[F] AlgebraicClosure F) := fun c =>
      (((Quotient.out c : EllipticRootNumber.relWeil F L) : EllipticRootNumber.AbsGal F) :
