  have deform : ∀ (L : Type u) [Field L] [NumberField L] [NumberField.IsTotallyReal L]
      (v₀ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L)) (a₁ a₂ a₃ : L),
