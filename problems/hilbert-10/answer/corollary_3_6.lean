      obtain ⟨k₀, hk⟩ := QuotientGroup.mk_out_eq_mul H x⁻¹
      refine ⟨k₀, ?_⟩
      rw [hk]
      group
    have hΨ : Function.Injective Ψ := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro f hf
      apply Subtype.ext
      funext x
      obtain ⟨k₀, hx⟩ := hdec x
      have hfm : ∀ (k : H) (g : G), f.1 ((k : G) * g) = ρ k (f.1 g) := f.2
      have h1 : Ψ f (QuotientGroup.mk x⁻¹ : G ⧸ H) = 0 := by rw [hf]; rfl
      have h2 : Ψ f (QuotientGroup.mk x⁻¹ : G ⧸ H) =
          f.1 (Quotient.out (QuotientGroup.mk x⁻¹ : G ⧸ H))⁻¹ := rfl
      show f.1 x = 0
      rw [hx, hfm k₀, ← h2, h1, map_zero]
