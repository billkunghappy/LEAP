      refine ⟨?_, ?_⟩
      · rcases lt_or_eq_of_le hle with hl | he
        · have h' : w (ε * z₂ ^ 2) = WithZero.exp (-n) := by
            rw [← h₂, Valuation.map_add_eq_of_lt_right _ hl, hα]
          obtain ⟨k, hk⟩ := hpar ε z₂ 0 (-n) (by rw [hεw, WithZero.exp_zero]) h'
          exact ⟨-k, by omega⟩
        · have h' : w (1 * x ^ 2) = WithZero.exp (-n) := by rw [one_mul, he, hα]
          obtain ⟨k, hk⟩ := hpar 1 x 0 (-n) hw1 h'
          exact ⟨-k, by omega⟩
      · rintro ⟨q, hq⟩
        obtain ⟨r, hr0, hr⟩ := Q1 (t₁ - t₃) (x ^ 2) hβ0 (by rw [hβ]; exact hxs)
        have hq0 : q ≠ 0 := by rintro rfl; apply hβ0; rw [hq]; ring
        exact NS z₃ (q * r) (mul_ne_zero hq0 hr0) (by
          rw [← h₃, add_comm, hr, hq]; ring)
    · 
      rintro ⟨⟨m, hm⟩, hβns⟩
      have hm0 : 0 < m := by omega
      set k : ℕ := m.toNat with hkdef
      have hk : (k : ℤ) = m := Int.toNat_of_nonneg hm0.le
      have hk1 : 1 ≤ k := by omega
      have hπ0 : π ≠ 0 := nz _ _ hπ
      set P : F := π ^ k with hPdef
      have hP0 : P ≠ 0 := pow_ne_zero _ hπ0
      have hP : w P = WithZero.exp (-m) := by
        rw [hPdef, map_pow, hπ, ← WithZero.exp_nsmul, ← hk]
        congr 1
        simp
      set Q : F := P ^ 2 with hQdef
      have hQ0 : Q ≠ 0 := pow_ne_zero _ hP0
      have hQ : w Q = WithZero.exp (-n) := by
        rw [hQdef, map_pow, hP, sq, ← WithZero.exp_add, hm]
        congr 1
        ring
      set α' : F := (t₁ - t₂) / Q with hα'def
      have hα'w : w α' = 1 := by
