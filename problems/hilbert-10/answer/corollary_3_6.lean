set_option maxHeartbeats 4000000

/-! ### Statement (originally `corollary_3_6.lean`) -/

/--
**Corollary 3.6.** Let `K` be a number field and `E : y^2 = (x - e₁)(x - e₂)(x - e₃)`
with `e₁, e₂, e₃ ∈ K` distinct (so that `E(K)[2] ≅ 𝔽₂²`). Then
`(-1)^{dim_{𝔽₂} Sel²(E/K)} = w(E/K)`.
-/

def phiImg (F : Type*) [Field F] (t₁ t₂ t₃ : F) : Set (SqCl F) :=
  {c | ∃ u : Fˣ, c = sqCl u ∧ IsDescentClass t₁ t₂ t₃ 1 (u : F)}

open scoped Classical in

noncomputable def phiSign (F : Type*) [Field F] (t₁ t₂ t₃ : F) : ℤˣ :=
  if ∃ k : ℕ, (phiImg F t₁ t₂ t₃).encard = 2 ^ k ∧ Even k then -1 else 1

open scoped Classical in

noncomputable def hilbSym (F : Type*) [Field F] (a b : F) : ℤˣ :=
  if ∃ x y : F, a * x ^ 2 + b * y ^ 2 = 1 then 1 else -1

open scoped Classical in

noncomputable def hilbTerm (F : Type*) [Field F] (t₁ t₂ t₃ : F) : ℤˣ :=
  if 2 * t₁ - t₂ - t₃ = 0 then 1
  else hilbSym F (2 * t₁ - t₂ - t₃) (-((t₁ - t₂) * (t₁ - t₃)))

open scoped Classical in

noncomputable def multSplitSign {K : Type u} [Field K] [NumberField K] (e₁ e₂ e₃ : K)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) : ℤˣ :=
  if IsSquare (algebraMap K (v.adicCompletion K)
      (if IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₂) < 1 then e₁ - e₃
       else if IsDedekindDomain.HeightOneSpectrum.valuation K v (e₁ - e₃) < 1 then e₁ - e₂
       else -(e₁ - e₂))) then -1 else 1


def LocalIdentityAt {K : Type u} [Field K] [NumberField K] (e₁ e₂ e₃ : K)
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) : Prop :=
  rootNumber ((threeRootsCurve e₁ e₂ e₃).baseChange (v.adicCompletion K)) =
    phiSign (v.adicCompletion K) (algebraMap K _ e₁) (algebraMap K _ e₂) (algebraMap K _ e₃) *
      hilbTerm (v.adicCompletion K) (algebraMap K _ e₁) (algebraMap K _ e₂) (algebraMap K _ e₃)
def spSqClMap {F L : Type*} [Field F] [Field L] (f : F →+* L) : SqCl F →* SqCl L :=
  QuotientGroup.map _ _ (Units.map f.toMonoidHom) (by
    rintro x ⟨y, rfl⟩
    exact ⟨Units.map f.toMonoidHom y, by simp⟩)


noncomputable def spPair (F : Type*) [Field F] (x y : SqCl F) : ℤˣ :=
  hilbSym F ((Quotient.out x : Fˣ) : F) ((Quotient.out y : Fˣ) : F)


def spDesc (F : Type*) [Field F] (t₁ t₂ t₃ : F) : Set (SqCl F × SqCl F) :=
  {c | ∃ d₁ d₂ : Fˣ, c = (sqCl d₁, sqCl d₂) ∧ IsDescentClass t₁ t₂ t₃ (d₁ : F) (d₂ : F)}


def spV {K : Type u} [Field K] [NumberField K]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))) :
    (↥T ⊕ NumberField.InfinitePlace K) → Type u
  | Sum.inl v => SqCl (v.1.adicCompletion K)
  | Sum.inr w => SqCl w.Completion


noncomputable def spSqClCommGroup (F : Type*) [Field F] : CommGroup (SqCl F) := inferInstance

noncomputable instance spV.instCommGroup {K : Type u} [Field K] [NumberField K]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (i : ↥T ⊕ NumberField.InfinitePlace K) : CommGroup (spV T i) :=
  match i with
  | Sum.inl v => spSqClCommGroup (v.1.adicCompletion K)
  | Sum.inr w => spSqClCommGroup w.Completion


noncomputable def spP {K : Type u} [Field K] [NumberField K]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))) :
    ∀ i : ↥T ⊕ NumberField.InfinitePlace K, spV T i → spV T i → ℤˣ
  | Sum.inl v => spPair (v.1.adicCompletion K)
  | Sum.inr w => spPair w.Completion


def spZ {K : Type u} [Field K] [NumberField K]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (e₁ e₂ e₃ : K) : ∀ i : ↥T ⊕ NumberField.InfinitePlace K, Set (spV T i × spV T i)
  | Sum.inl v => spDesc (v.1.adicCompletion K) (algebraMap K (v.1.adicCompletion K) e₁)
      (algebraMap K (v.1.adicCompletion K) e₂) (algebraMap K (v.1.adicCompletion K) e₃)
  | Sum.inr w => spDesc w.Completion (algebraMap K w.Completion e₁)
      (algebraMap K w.Completion e₂) (algebraMap K w.Completion e₃)


noncomputable def spRho {K : Type u} [Field K] [NumberField K]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))) :
    ∀ i : ↥T ⊕ NumberField.InfinitePlace K, SqCl K →* spV T i
  | Sum.inl v => spSqClMap (algebraMap K (v.1.adicCompletion K))
  | Sum.inr w => spSqClMap (algebraMap K w.Completion)
noncomputable def dsc2Cls {F : Type*} [Field F] [DecidableEq F] (a : F) : SqCl F :=
  if h : a = 0 then 1 else sqCl (Units.mk0 a h)


def dsc2G {F : Type*} [Field F] [DecidableEq F] (e p q x : F) : F :=
  if x = e then (e - p) * (e - q) else x - e


noncomputable def dsc2Kummer {F : Type*} [Field F] [DecidableEq F] (t₁ t₂ t₃ : F) :
    (threeRootsCurve t₁ t₂ t₃).toAffine.Point → SqCl F × SqCl F
  | .zero => 1
  | @WeierstrassCurve.Affine.Point.some _ _ _ x _ _ =>
      (dsc2Cls (dsc2G t₁ t₂ t₃ x), dsc2Cls (dsc2G t₂ t₁ t₃ x))
def affinePointZCoord {R : Type*} [Field R] {W : WeierstrassCurve.Affine R} : W.Point → R
  | .zero => 0
  | @WeierstrassCurve.Affine.Point.some _ _ _ x y _ => x / y
def EllTwist {k₁ k₂ : Type*} [Semiring k₁] [Semiring k₂] (_ι : k₁ ≃+* k₂) (V : Type u) :
    Type u := V

instance EllTwist.instAddCommGroup {k₁ k₂ : Type*} [Semiring k₁] [Semiring k₂] (ι : k₁ ≃+* k₂)
    (V : Type u) [h : AddCommGroup V] : AddCommGroup (EllTwist ι V) := h

instance EllTwist.instModule {k₁ k₂ : Type*} [Semiring k₁] [Semiring k₂] (ι : k₁ ≃+* k₂)
    (V : Type u) [AddCommGroup V] [Module k₁ V] : Module k₂ (EllTwist ι V) :=
  Module.compHom V (ι.symm : k₂ →+* k₁)


def EllTwist.equiv {k₁ k₂ : Type*} [Semiring k₁] [Semiring k₂] (ι : k₁ ≃+* k₂)
    (V : Type u) [AddCommGroup V] : V ≃+ EllTwist ι V := AddEquiv.refl V


def ellTwistLin {k₁ k₂ : Type*} [Semiring k₁] [Semiring k₂] (ι : k₁ ≃+* k₂)
    {V W : Type u} [AddCommGroup V] [Module k₁ V] [AddCommGroup W] [Module k₁ W]
    (f : V →ₗ[k₁] W) : EllTwist ι V →ₗ[k₂] EllTwist ι W where
  toFun v := (f v : W)
  map_add' x y := f.map_add x y
  map_smul' c v := f.map_smul (ι.symm c) v


def ellTwistRep {k₁ k₂ : Type*} [CommSemiring k₁] [CommSemiring k₂] (ι : k₁ ≃+* k₂)
    {G₁ G₂ : Type*} [Monoid G₁] [Monoid G₂] (f : G₂ →* G₁)
    {V : Type u} [AddCommGroup V] [Module k₁ V] (ρ : Representation k₁ G₁ V) :
    Representation k₂ G₂ (EllTwist ι V) where
  toFun g := ellTwistLin ι (ρ (f g))
  map_one' := LinearMap.ext fun v => by
    change ρ (f 1) v = v
    rw [map_one, map_one]
    rfl
  map_mul' g h := LinearMap.ext fun v => by
    change ρ (f (g * h)) v = ρ (f g) (ρ (f h) v)
    rw [map_mul, map_mul]
    rfl
noncomputable def ladderDbl {K : Type*} [Field K] (W : WeierstrassCurve K)
    (p : Polynomial K × Polynomial K) : Polynomial K × Polynomial K :=
  (p.1 ^ 4 - Polynomial.C W.b₄ * p.1 ^ 2 * p.2 ^ 2 - 2 * Polynomial.C W.b₆ * p.1 * p.2 ^ 3
      - Polynomial.C W.b₈ * p.2 ^ 4,
   4 * p.1 ^ 3 * p.2 + Polynomial.C W.b₂ * p.1 ^ 2 * p.2 ^ 2 + 2 * Polynomial.C W.b₄ * p.1 * p.2 ^ 3
      + Polynomial.C W.b₆ * p.2 ^ 4)


noncomputable def ladderAdd {K : Type*} [Field K] (W : WeierstrassCurve K)
    (p q : Polynomial K × Polynomial K) : Polynomial K × Polynomial K :=
  (2 * p.1 * q.1 * (p.1 * q.2 + q.1 * p.2) + Polynomial.C W.b₂ * p.1 * q.1 * p.2 * q.2
      + Polynomial.C W.b₄ * (p.1 * q.2 + q.1 * p.2) * p.2 * q.2
      + Polynomial.C W.b₆ * p.2 ^ 2 * q.2 ^ 2
      - Polynomial.X * (p.1 * q.2 - q.1 * p.2) ^ 2,
   (p.1 * q.2 - q.1 * p.2) ^ 2)


noncomputable def ladderXZ {K : Type*} [Field K] (W : WeierstrassCurve K) :
    ℕ → Polynomial K × Polynomial K
  | 0 => (1, 0)
  | 1 => (Polynomial.X, 1)
  | n + 2 =>
    if h : (n + 2) % 2 = 0 then ladderDbl W (ladderXZ W ((n + 2) / 2))
    else ladderAdd W (ladderXZ W ((n + 2) / 2 + 1)) (ladderXZ W ((n + 2) / 2))
  decreasing_by all_goals omega
def cpfGood {A K ι : Type*} [AddCommGroup A] [Monoid K] (act : ι → A →+ A) (s : ι → K → K)
    (n : ℕ) (p : A → A → K) : Prop :=
  (∀ P Q : A, ¬ (n • P = 0 ∧ n • Q = 0) → p P Q = 1) ∧
  (∀ P₁ P₂ Q : A, n • P₁ = 0 → n • P₂ = 0 → n • Q = 0 → p (P₁ + P₂) Q = p P₁ Q * p P₂ Q) ∧
  (∀ P Q₁ Q₂ : A, n • P = 0 → n • Q₁ = 0 → n • Q₂ = 0 → p P (Q₁ + Q₂) = p P Q₁ * p P Q₂) ∧
  (∀ P : A, n • P = 0 → p P P = 1) ∧
  (∀ P : A, n • P = 0 → (∀ Q : A, n • Q = 0 → p P Q = 1) → P = 0) ∧
  (∀ (σ : ι) (P Q : A), n • P = 0 → n • Q = 0 → p (act σ P) (act σ Q) = s σ (p P Q))
def brauerChr {k : Type*} [Field k] {H : Type u} [Group H] (θ : H →* kˣ) :
    Representation k H (ULift.{u} k) where
  toFun t := ((θ t : kˣ) : k) • LinearMap.id
  map_one' := by
    rw [map_one, Units.val_one, one_smul]
    rfl
  map_mul' a b := LinearMap.ext fun v => by
    simp only [Module.End.mul_apply, LinearMap.smul_apply, LinearMap.id_apply, map_mul,
      Units.val_mul, smul_smul]

theorem pairing_card_mul_card_orth {V : Type*} [CommGroup V] [Finite V]
    (hV2 : ∀ x : V, x ^ 2 = 1) (P : V → V → ℤˣ)
    (hPmul : ∀ x x' y : V, P (x * x') y = P x y * P x' y)
    (hPsymm : ∀ x y : V, P x y = P y x)
    (hPnd : ∀ x : V, (∀ y, P x y = 1) → x = 1)
    (H : Subgroup V) :
    Nat.card H * Nat.card {x : V // ∀ h ∈ H, P x h = 1} = Nat.card V :=
by
  classical
  haveI : Fintype V := Fintype.ofFinite V
  have s1 : ∀ (G : Type _) [Group G] [Fintype G] (f : G → ℤˣ),
      (∀ a b : G, f (a * b) = f a * f b) → (∃ g₀ : G, f g₀ ≠ 1) →
      ∑ g : G, ((f g : ℤˣ) : ℤ) = 0 := by
    intro G _ _ f hf hne
    obtain ⟨g₀, hg₀⟩ := hne
    have hm1 : f g₀ = -1 := (Int.units_eq_one_or (f g₀)).resolve_left hg₀
    have hS : ∑ g : G, ((f (g₀ * g) : ℤˣ) : ℤ) = ∑ g : G, ((f g : ℤˣ) : ℤ) :=
      Fintype.sum_equiv (Equiv.mulLeft g₀) _ _ (fun g => rfl)
    simp only [hf, hm1, Units.val_mul, Units.val_neg, Units.val_one, neg_one_mul,
      Finset.sum_neg_distrib] at hS
    linarith
  have P1 : ∀ y, P 1 y = 1 := fun y => by
    have h := hPmul 1 1 y
    rw [one_mul] at h
    exact left_eq_mul.mp h
  have P2 : ∀ x, P x 1 = 1 := fun x => by rw [hPsymm]; exact P1 x
  have P3 : ∀ x y y', P x (y * y') = P x y * P x y' := fun x y y' => by
    rw [hPsymm, hPmul, hPsymm y, hPsymm y']
  have row : ∀ x : V, ∑ h : H, ((P x (h : V) : ℤˣ) : ℤ) =
      if (∀ h ∈ H, P x h = 1) then (Fintype.card H : ℤ) else 0 := by
    intro x
    split_ifs with hx
    · have e : ∀ h : H, ((P x (h : V) : ℤˣ) : ℤ) = 1 := fun h => by
        rw [hx h h.2, Units.val_one]
      rw [Finset.sum_congr rfl (fun h _ => e h), Finset.sum_const, Finset.card_univ,
        nsmul_eq_mul, mul_one]
    · push_neg at hx
      obtain ⟨h, hh, hne⟩ := hx
      exact s1 H (fun h : H => P x (h : V)) (fun a b => P3 x a b)
        ⟨⟨h, hh⟩, hne⟩
  have col : ∀ h : H, ∑ x : V, ((P x (h : V) : ℤˣ) : ℤ) =
      if h = 1 then (Fintype.card V : ℤ) else 0 := by
    intro h
    split_ifs with hh
    · subst hh
      have e : ∀ x : V, ((P x ((1 : H) : V) : ℤˣ) : ℤ) = 1 := fun x => by
        rw [OneMemClass.coe_one, P2, Units.val_one]
      rw [Finset.sum_congr rfl (fun x _ => e x), Finset.sum_const, Finset.card_univ,
        nsmul_eq_mul, mul_one]
    · have hne : (h : V) ≠ 1 := fun e => hh (Subtype.ext e)
      have hex : ∃ x₀, P x₀ h ≠ 1 := by
        by_contra hc
        push_neg at hc
        exact hne (hPnd _ (fun y => by rw [hPsymm]; exact hc y))
      exact s1 V (fun x => P x (h : V)) (fun a b => hPmul a b h) hex
  have hS1 : ∑ x : V, ∑ h : H, ((P x (h : V) : ℤˣ) : ℤ) =
      (Fintype.card {x : V // ∀ h ∈ H, P x h = 1} : ℤ) * (Fintype.card H : ℤ) := by
    rw [Finset.sum_congr rfl (fun x _ => row x), Finset.sum_ite, Finset.sum_const_zero, add_zero,
      Finset.sum_const, nsmul_eq_mul, Fintype.card_subtype (fun x : V => ∀ h ∈ H, P x h = 1)]
  have hS2 : ∑ x : V, ∑ h : H, ((P x (h : V) : ℤˣ) : ℤ) = (Fintype.card V : ℤ) := by
    rw [Finset.sum_comm, Finset.sum_congr rfl (fun h _ => col h)]
    simp
  have key : ((Fintype.card H * Fintype.card {x : V // ∀ h ∈ H, P x h = 1} : ℕ) : ℤ) =
      (Fintype.card V : ℤ) := by
    push_cast
    rw [mul_comm, ← hS1, hS2]
  rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
  exact_mod_cast key

theorem lagrangian_triple_parity {W : Type*} [CommGroup W] [Finite W]
    (hW2 : ∀ w : W, w ^ 2 = 1) (B : W → W → ℤˣ)
    (hBmul : ∀ x x' y : W, B (x * x') y = B x y * B x' y)
    (hBsymm : ∀ x y : W, B x y = B y x)
    (hBnd : ∀ x : W, (∀ y, B x y = 1) → x = 1)
    (Q : W → ℤˣ) (hQ : ∀ x y : W, Q (x * y) = Q x * Q y * B x y)
    (m : ℕ) (hWcard : Nat.card W = 4 ^ m)
    (X Y L : Subgroup W)
    (hXQ : ∀ x ∈ X, Q x = 1) (hYQ : ∀ y ∈ Y, Q y = 1) (hLQ : ∀ l ∈ L, Q l = 1)
    (hXc : Nat.card X = 2 ^ m) (hYc : Nat.card Y = 2 ^ m) (hLc : Nat.card L = 2 ^ m)
    (a b c : ℕ)
    (ha : Nat.card (X ⊓ Y : Subgroup W) = 2 ^ a)
    (hb : Nat.card (Y ⊓ L : Subgroup W) = 2 ^ b)
    (hc : Nat.card (L ⊓ X : Subgroup W) = 2 ^ c) :
    (-1 : ℤˣ) ^ (a + b + c) = (-1) ^ m :=
by
  classical
  
  have usq : ∀ u : ℤˣ, u * u = 1 := Int.units_mul_self
  have hne : (-1 : ℤˣ) ≠ 1 := fun h => absurd (congrArg Units.val h) (by norm_num)
  have msq : ∀ w : W, w * w = 1 := fun w => by rw [← pow_two]; exact hW2 w
  have winv : ∀ w : W, w⁻¹ = w := fun w => inv_eq_of_mul_eq_one_right (msq w)
  have winv2 : ∀ p : W × W, p⁻¹ = p := fun p => Prod.ext (winv p.1) (winv p.2)
  have B1l : ∀ y, B 1 y = 1 := fun y => by
    have h := hBmul 1 1 y
    rw [one_mul] at h
    exact left_eq_mul.mp h
  have Bmulr : ∀ x y y', B x (y * y') = B x y * B x y' := fun x y y' => by
    rw [hBsymm, hBmul, hBsymm y, hBsymm y']
  have iso : ∀ T : Subgroup W, (∀ t ∈ T, Q t = 1) → ∀ t ∈ T, ∀ t' ∈ T, B t t' = 1 := by
    intro T hT t ht t' ht'
    have h := hQ t t'
    rw [hT _ (T.mul_mem ht ht'), hT t ht, hT t' ht', one_mul, one_mul] at h
    exact h.symm
  have hXi := iso X hXQ
  have hYi := iso Y hYQ
  have hLi := iso L hLQ
  have hW : Nat.card W = 2 ^ m * 2 ^ m := by
    rw [hWcard, ← mul_pow]
    norm_num
  
  
  have orth : ∀ H : Subgroup W,
      Nat.card H * Nat.card {x : W // ∀ h ∈ H, B x h = 1} = Nat.card W := by
    intro H
    haveI : Fintype W := Fintype.ofFinite W
    have s1 : ∀ (G : Type _) [Group G] [Fintype G] (f : G → ℤˣ),
        (∀ a b : G, f (a * b) = f a * f b) → (∃ g₀ : G, f g₀ ≠ 1) →
        ∑ g : G, ((f g : ℤˣ) : ℤ) = 0 := by
      intro G _ _ f hf hne
      obtain ⟨g₀, hg₀⟩ := hne
      have hm1 : f g₀ = -1 := (Int.units_eq_one_or (f g₀)).resolve_left hg₀
      have hS : ∑ g : G, ((f (g₀ * g) : ℤˣ) : ℤ) = ∑ g : G, ((f g : ℤˣ) : ℤ) :=
        Fintype.sum_equiv (Equiv.mulLeft g₀) _ _ (fun g => rfl)
      simp only [hf, hm1, Units.val_mul, Units.val_neg, Units.val_one, neg_one_mul,
        Finset.sum_neg_distrib] at hS
      linarith
    have P2 : ∀ x, B x 1 = 1 := fun x => by rw [hBsymm]; exact B1l x
    have row : ∀ x : W, ∑ h : H, ((B x (h : W) : ℤˣ) : ℤ) =
        if (∀ h ∈ H, B x h = 1) then (Fintype.card H : ℤ) else 0 := by
      intro x
      split_ifs with hx
      · have e : ∀ h : H, ((B x (h : W) : ℤˣ) : ℤ) = 1 := fun h => by
          rw [hx h h.2, Units.val_one]
        rw [Finset.sum_congr rfl (fun h _ => e h), Finset.sum_const, Finset.card_univ,
          nsmul_eq_mul, mul_one]
      · push_neg at hx
        obtain ⟨h, hh, hne⟩ := hx
        exact s1 H (fun h : H => B x (h : W)) (fun a b => Bmulr x a b)
          ⟨⟨h, hh⟩, hne⟩
    have col : ∀ h : H, ∑ x : W, ((B x (h : W) : ℤˣ) : ℤ) =
        if h = 1 then (Fintype.card W : ℤ) else 0 := by
      intro h
      split_ifs with hh
      · subst hh
        have e : ∀ x : W, ((B x ((1 : H) : W) : ℤˣ) : ℤ) = 1 := fun x => by
          rw [OneMemClass.coe_one, P2, Units.val_one]
        rw [Finset.sum_congr rfl (fun x _ => e x), Finset.sum_const, Finset.card_univ,
          nsmul_eq_mul, mul_one]
      · have hne : (h : W) ≠ 1 := fun e => hh (Subtype.ext e)
        have hex : ∃ x₀, B x₀ h ≠ 1 := by
          by_contra hc
          push_neg at hc
          exact hne (hBnd _ (fun y => by rw [hBsymm]; exact hc y))
        exact s1 W (fun x => B x (h : W)) (fun a b => hBmul a b h) hex
    have hS1 : ∑ x : W, ∑ h : H, ((B x (h : W) : ℤˣ) : ℤ) =
        (Fintype.card {x : W // ∀ h ∈ H, B x h = 1} : ℤ) * (Fintype.card H : ℤ) := by
      rw [Finset.sum_congr rfl (fun x _ => row x), Finset.sum_ite, Finset.sum_const_zero, add_zero,
        Finset.sum_const, nsmul_eq_mul, Fintype.card_subtype (fun x : W => ∀ h ∈ H, B x h = 1)]
    have hS2 : ∑ x : W, ∑ h : H, ((B x (h : W) : ℤˣ) : ℤ) = (Fintype.card W : ℤ) := by
      rw [Finset.sum_comm, Finset.sum_congr rfl (fun h _ => col h)]
      simp
