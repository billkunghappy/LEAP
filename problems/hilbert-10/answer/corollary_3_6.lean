        (algebraMap L _ a₃)
      rw [← hs, ← hh]
      exact phiSign_hilbTerm_real_complex.1 _ _ _ (fun e => h12 (hinj (τ.injective e)))
        (fun e => h13 (hinj (τ.injective e))) (fun e => h23 (hinj (τ.injective e)))
    · obtain ⟨τ⟩ : Nonempty (w.Completion ≃+* ℂ) :=
        ⟨NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex h⟩
      obtain ⟨hs, hh⟩ := phiSign_hilbTerm_ringEquiv τ (algebraMap L _ a₁) (algebraMap L _ a₂)
        (algebraMap L _ a₃)
