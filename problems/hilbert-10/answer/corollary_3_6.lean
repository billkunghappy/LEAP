        rw [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def]
        exact key ζ hζ
      have hz := Subgroup.zpowers_le.mpr hcs
      change ζ ∈ IntermediateField.fixedField _
      rw [IntermediateField.mem_fixedField_iff]
      intro f hf
      have := hz hf
      rw [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def] at this
      exact this
    unfold EllipticRootNumber.inertia
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    exact (IntermediateField.mem_fixedField_iff _ _).mp (hle hx) _ (Subgroup.mem_zpowers _)
  
  have hpow : ∀ g : EllipticRootNumber.AbsGal F, ∃ m : ℕ, 0 < m ∧ g ^ m ∈ U := by
    intro g
    obtain ⟨E, hEfin, hEU⟩ := (krullTopology_mem_nhds_one_iff F (AlgebraicClosure F) U).mp hU
    haveI := hEfin
    let f : ℕ → (E →ₐ[F] AlgebraicClosure F) := fun n =>
      ((g ^ n : EllipticRootNumber.AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F).comp
