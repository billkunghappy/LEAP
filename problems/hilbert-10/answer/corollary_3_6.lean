      w (WeierstrassCurve.VariableChange.mk (Units.mk0 u hu0) t₁ 0 0 • threeRootsCurve t₁ t₂ t₃).a₃ ≤ 1 ∧
      w (WeierstrassCurve.VariableChange.mk (Units.mk0 u hu0) t₁ 0 0 • threeRootsCurve t₁ t₂ t₃).a₄ ≤ 1 ∧
      w (WeierstrassCurve.VariableChange.mk (Units.mk0 u hu0) t₁ 0 0 • threeRootsCurve t₁ t₂ t₃).a₆ ≤ 1 ∧
      w (WeierstrassCurve.VariableChange.mk (Units.mk0 u hu0) t₁ 0 0 • threeRootsCurve t₁ t₂ t₃).Δ = 1 := by
    intro w h2 t₁ t₂ t₃ h₁₂ h₁₃ h₂₃ hj u hu0 hu
    have ha : t₁ - t₂ ≠ 0 := sub_ne_zero.mpr h₁₂
    have hb : t₂ - t₃ ≠ 0 := sub_ne_zero.mpr h₂₃
    have hc : t₃ - t₁ ≠ 0 := sub_ne_zero.mpr h₁₃.symm
    have h16 : w (16 : AlgebraicClosure F) = 1 := by
      have e : (16 : AlgebraicClosure F) = 2 ^ 4 := by norm_num
      rw [e, map_pow, h2, one_pow]
    have hc4 : (threeRootsCurve t₁ t₂ t₃).c₄ =
