    set χ' : ∀ i, EllipticRootNumber.relWeil F (M i) →* (EllipticRootNumber.Ω F)ˣ := fun i =>
      (θ' i).comp (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
