    obtain ⟨f, hf0, ⟨a₀, ha₀, hfa⟩, hP⟩ : ∃ f : FractionRing W.toAffine.CoordinateRing, f ≠ 0 ∧
        (∃ a₀ ∈ WeierstrassCurve.Affine.CoordinateRing.XYIdeal W.toAffine x (Polynomial.C y) ^ N,
          algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) a₀ = f) ∧
        ∀ a ∈ WeierstrassCurve.Affine.CoordinateRing.XYIdeal W.toAffine x (Polynomial.C y) ^ N,
