      rw [e2, hw₂]; exact hY
    have hdx : w (((C.u⁻¹ : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) ^ 2 * (σ x - C.r) -
        ((C.u⁻¹ : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) ^ 2 * (x - C.r)) < 1 := by
      rw [e1]; exact valuation_sub_lt_one_of_mem_inertia F w hw₁ hw₂ σ hσ _ hX
    have hdy : w (((C.u⁻¹ : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) ^ 3 *
          (σ y - C.s * (σ x - C.r) - C.t) -
        ((C.u⁻¹ : (AlgebraicClosure F)ˣ) : AlgebraicClosure F) ^ 3 *
          (y - C.s * (x - C.r) - C.t)) < 1 := by
      rw [e2]; exact valuation_sub_lt_one_of_mem_inertia F w hw₁ hw₂ σ hσ _ hY
    have hdiff := weierstrass_sub_eq_zero_or_one_lt_of_close w _ h₁ h₂ h₃ h₄ h₆ hΔ h' h''
      hX hY hX' hY' hdx hdy
    have hgT : T (EllipticRootNumber.galHom F E σ (WeierstrassCurve.Affine.Point.some h)) =
        WeierstrassCurve.Affine.Point.some h'' := by
      rw [hg, hh'']
    have hmd : m • (WeierstrassCurve.Affine.Point.some h'' -
        WeierstrassCurve.Affine.Point.some h') = 0 := by
      rw [← hgT, ← hh', ← map_sub, ← map_nsmul, nsmul_sub, ← map_nsmul, hP0]
      simp only [map_zero, sub_zero]
    apply hTinj
    rw [hgT, hh']
    rcases hdiff with hz | ⟨x₃, y₃, h₃', heq, hx₃⟩
    · exact sub_eq_zero.mp hz
    · exfalso
      rw [heq] at hmd
      exact WeierstrassCurve.Affine.Point.some_ne_zero h₃'
        (tf _ ((hS _).mpr (Or.inr ⟨x₃, y₃, h₃', rfl, hx₃⟩)) hmd)

theorem threeRootsCurve_goodModel_of_val_two {K : Type*} [Field K] [IsAlgClosed K]
    {Γ₀ : Type*} [LinearOrderedCommGroupWithZero Γ₀] (w : Valuation K Γ₀) (h2 : w (2 : K) = 1)
    (t₁ t₂ t₃ : K) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃)
    (hj : w ((threeRootsCurve t₁ t₂ t₃).c₄ ^ 3 / (threeRootsCurve t₁ t₂ t₃).Δ) ≤ 1) :
    ∃ C : WeierstrassCurve.VariableChange K,
      w (C • threeRootsCurve t₁ t₂ t₃).a₁ ≤ 1 ∧ w (C • threeRootsCurve t₁ t₂ t₃).a₂ ≤ 1 ∧
      w (C • threeRootsCurve t₁ t₂ t₃).a₃ ≤ 1 ∧ w (C • threeRootsCurve t₁ t₂ t₃).a₄ ≤ 1 ∧
      w (C • threeRootsCurve t₁ t₂ t₃).a₆ ≤ 1 ∧ w (C • threeRootsCurve t₁ t₂ t₃).Δ = 1 :=
by
  classical
  
  have ha : t₁ - t₂ ≠ 0 := sub_ne_zero.mpr h₁₂
  have hb : t₂ - t₃ ≠ 0 := sub_ne_zero.mpr h₂₃
  have hc : t₃ - t₁ ≠ 0 := sub_ne_zero.mpr h₁₃.symm
  have h16 : w (16 : K) = 1 := by
    have e : (16 : K) = 2 ^ 4 := by norm_num
    rw [e, map_pow, h2, one_pow]
  
  have hc4 : (threeRootsCurve t₁ t₂ t₃).c₄ =
      16 * ((t₁ - t₂) ^ 2 - (t₂ - t₃) * (t₃ - t₁)) := by
    simp only [WeierstrassCurve.c₄, WeierstrassCurve.b₂, WeierstrassCurve.b₄, threeRootsCurve]
    ring
  have hΔ : (threeRootsCurve t₁ t₂ t₃).Δ = 16 * ((t₁ - t₂) * (t₂ - t₃) * (t₃ - t₁)) ^ 2 := by
    simp only [WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
      WeierstrassCurve.b₆, WeierstrassCurve.b₈, threeRootsCurve]
    ring
  
  have K1 : ∀ x y z : K, x + y + z = 0 → w (x ^ 2 - y * z) ^ 3 ≤ w (x * y * z) ^ 2 →
      ¬ (w z < w x) := by
    intro x y z hs h hzx
    have hx0 : 0 < w x := lt_of_le_of_lt zero_le' hzx
    have hy : w y = w x := by
      have e : y = -(x + z) := by linear_combination hs
      rw [e, Valuation.map_neg, Valuation.map_add_eq_of_lt_left w hzx]
    have hyz : w (y * z) < w (x ^ 2) := by
      rw [map_mul, map_pow, hy, sq]
      exact mul_lt_mul_of_pos_left hzx hx0
    have hQ : w (x ^ 2 - y * z) = w x ^ 2 := by
      rw [Valuation.map_sub_eq_of_lt_left w hyz, map_pow]
    rw [hQ, map_mul, map_mul, hy] at h
    have hlt : w z ^ 2 < w x ^ 2 := pow_lt_pow_left₀ hzx zero_le' two_ne_zero
    have hlt2 : (w x * w x * w z) ^ 2 < (w x ^ 2) ^ 3 := by
      calc (w x * w x * w z) ^ 2 = (w x ^ 2) ^ 2 * w z ^ 2 := by rw [mul_pow, ← sq]
        _ < (w x ^ 2) ^ 2 * w x ^ 2 := mul_lt_mul_of_pos_left hlt (pow_pos (pow_pos hx0 2) 2)
        _ = (w x ^ 2) ^ 3 := (pow_succ _ 2).symm
    exact absurd h (not_le.mpr hlt2)
  
  have habc : (t₁ - t₂) * (t₂ - t₃) * (t₃ - t₁) ≠ 0 := mul_ne_zero (mul_ne_zero ha hb) hc
  have hQ0 : w ((t₁ - t₂) ^ 2 - (t₂ - t₃) * (t₃ - t₁)) ^ 3 ≤
      w ((t₁ - t₂) * (t₂ - t₃) * (t₃ - t₁)) ^ 2 := by
    rw [hc4, hΔ] at hj
    simp only [map_div₀, map_pow, map_mul, h16, one_mul] at hj
    have hpos : 0 < w ((t₁ - t₂) * (t₂ - t₃) * (t₃ - t₁)) ^ 2 :=
      pow_pos (zero_lt_iff.mpr ((Valuation.ne_zero_iff w).mpr habc)) 2
    rw [map_mul, map_mul] at hpos
    rw [div_le_one₀ hpos] at hj
    simpa only [map_mul] using hj
  
  have n1 := K1 (t₁ - t₂) (t₂ - t₃) (t₃ - t₁) (by ring) hQ0
  have n2 := K1 (t₁ - t₂) (t₃ - t₁) (t₂ - t₃) (by ring) (by
    have e1 : (t₁ - t₂) ^ 2 - (t₃ - t₁) * (t₂ - t₃) =
        (t₁ - t₂) ^ 2 - (t₂ - t₃) * (t₃ - t₁) := by ring
    have e2 : (t₁ - t₂) * (t₃ - t₁) * (t₂ - t₃) = (t₁ - t₂) * (t₂ - t₃) * (t₃ - t₁) := by ring
    rw [e1, e2]; exact hQ0)
  have n3 := K1 (t₂ - t₃) (t₃ - t₁) (t₁ - t₂) (by ring) (by
    have e1 : (t₂ - t₃) ^ 2 - (t₃ - t₁) * (t₁ - t₂) =
        (t₁ - t₂) ^ 2 - (t₂ - t₃) * (t₃ - t₁) := by ring
    have e2 : (t₂ - t₃) * (t₃ - t₁) * (t₁ - t₂) = (t₁ - t₂) * (t₂ - t₃) * (t₃ - t₁) := by ring
    rw [e1, e2]; exact hQ0)
  have n4 := K1 (t₃ - t₁) (t₂ - t₃) (t₁ - t₂) (by ring) (by
    have e1 : (t₃ - t₁) ^ 2 - (t₂ - t₃) * (t₁ - t₂) =
        (t₁ - t₂) ^ 2 - (t₂ - t₃) * (t₃ - t₁) := by ring
    have e2 : (t₃ - t₁) * (t₂ - t₃) * (t₁ - t₂) = (t₁ - t₂) * (t₂ - t₃) * (t₃ - t₁) := by ring
    rw [e1, e2]; exact hQ0)
  have hab : w (t₁ - t₂) = w (t₂ - t₃) := le_antisymm (not_lt.mp n2) (not_lt.mp n3)
  have hac : w (t₁ - t₂) = w (t₃ - t₁) := le_antisymm (not_lt.mp n1) (not_lt.mp n4)
  have hM0 : w (t₁ - t₂) ≠ 0 := (Valuation.ne_zero_iff w).mpr ha
  have hba : w ((t₂ - t₃) / (t₁ - t₂)) = 1 := by rw [map_div₀, ← hab, div_self hM0]
  have hca : w ((t₃ - t₁) / (t₁ - t₂)) = 1 := by rw [map_div₀, ← hac, div_self hM0]
  
  obtain ⟨u, hu⟩ := IsAlgClosed.exists_eq_mul_self (t₁ - t₂)
  have hu0 : u ≠ 0 := by
    rintro rfl
    exact ha (by rw [hu, mul_zero])
  have ha1 : (WeierstrassCurve.VariableChange.mk (Units.mk0 u hu0) t₁ 0 0 •
      threeRootsCurve t₁ t₂ t₃).a₁ = 0 := by
    rw [WeierstrassCurve.variableChange_a₁]
    simp [threeRootsCurve]
  have ha2 : (WeierstrassCurve.VariableChange.mk (Units.mk0 u hu0) t₁ 0 0 •
      threeRootsCurve t₁ t₂ t₃).a₂ = (2 * t₁ - t₂ - t₃) / (u * u) := by
    rw [WeierstrassCurve.variableChange_a₂]
    simp [threeRootsCurve]
    field_simp
    ring
  have ha3 : (WeierstrassCurve.VariableChange.mk (Units.mk0 u hu0) t₁ 0 0 •
      threeRootsCurve t₁ t₂ t₃).a₃ = 0 := by
    rw [WeierstrassCurve.variableChange_a₃]
    simp [threeRootsCurve]
  have ha4 : (WeierstrassCurve.VariableChange.mk (Units.mk0 u hu0) t₁ 0 0 •
      threeRootsCurve t₁ t₂ t₃).a₄ = (t₁ - t₂) * (t₁ - t₃) / (u * u) ^ 2 := by
    rw [WeierstrassCurve.variableChange_a₄]
    simp [threeRootsCurve]
    field_simp
    ring
  have ha6 : (WeierstrassCurve.VariableChange.mk (Units.mk0 u hu0) t₁ 0 0 •
      threeRootsCurve t₁ t₂ t₃).a₆ = 0 := by
    rw [WeierstrassCurve.variableChange_a₆]
    simp [threeRootsCurve]
    try ring_nf
    try simp
  have hΔ' : (WeierstrassCurve.VariableChange.mk (Units.mk0 u hu0) t₁ 0 0 •
      threeRootsCurve t₁ t₂ t₃).Δ = (threeRootsCurve t₁ t₂ t₃).Δ / (u * u) ^ 6 := by
    rw [WeierstrassCurve.variableChange_Δ]
    simp
    field_simp
  refine ⟨WeierstrassCurve.VariableChange.mk (Units.mk0 u hu0) t₁ 0 0, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [ha1, map_zero]; exact zero_le'
  · rw [ha2, ← hu]
    have e : (2 * t₁ - t₂ - t₃) / (t₁ - t₂) = 1 - (t₃ - t₁) / (t₁ - t₂) := by
      field_simp
      ring
    rw [e]
    exact le_trans (Valuation.map_sub _ _ _) (max_le (le_of_eq (map_one w)) (le_of_eq hca))
  · rw [ha3, map_zero]; exact zero_le'
  · rw [ha4, ← hu]
    have e : (t₁ - t₂) * (t₁ - t₃) / (t₁ - t₂) ^ 2 = -((t₃ - t₁) / (t₁ - t₂)) := by
      field_simp
      ring
    rw [e, Valuation.map_neg, hca]
  · rw [ha6, map_zero]; exact zero_le'
  · rw [hΔ', ← hu, hΔ]
    have e : 16 * ((t₁ - t₂) * (t₂ - t₃) * (t₃ - t₁)) ^ 2 / (t₁ - t₂) ^ 6 =
        16 * ((t₂ - t₃) / (t₁ - t₂) * ((t₃ - t₁) / (t₁ - t₂))) ^ 2 := by
      field_simp
    rw [e, map_mul, map_pow, map_mul, h16, hba, hca]
    simp

theorem threeRootsCurve_goodModel_of_val_three {K : Type*} [Field K] [IsAlgClosed K] [CharZero K]
    {Γ₀ : Type*} [LinearOrderedCommGroupWithZero Γ₀] (w : Valuation K Γ₀) (h3 : w (3 : K) = 1)
    (t₁ t₂ t₃ : K) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃)
    (hj : w ((threeRootsCurve t₁ t₂ t₃).c₄ ^ 3 / (threeRootsCurve t₁ t₂ t₃).Δ) ≤ 1) :
    ∃ C : WeierstrassCurve.VariableChange K,
      w (C • threeRootsCurve t₁ t₂ t₃).a₁ ≤ 1 ∧ w (C • threeRootsCurve t₁ t₂ t₃).a₂ ≤ 1 ∧
      w (C • threeRootsCurve t₁ t₂ t₃).a₃ ≤ 1 ∧ w (C • threeRootsCurve t₁ t₂ t₃).a₄ ≤ 1 ∧
      w (C • threeRootsCurve t₁ t₂ t₃).a₆ ≤ 1 ∧ w (C • threeRootsCurve t₁ t₂ t₃).Δ = 1 :=
by
  classical
  set E := threeRootsCurve t₁ t₂ t₃ with hE
  set j₀ := E.c₄ ^ 3 / E.Δ with hj₀
  
  have natle : ∀ n : ℕ, w (n : K) ≤ 1 := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      push_cast
      exact le_trans (Valuation.map_add _ _ _) (max_le ih (by simp))
  
  obtain ⟨b, hQ⟩ : ∃ b : K,
      b ^ 4 - 72 * b ^ 3 + 1728 * b ^ 2 - (13824 + j₀) * b + 27 * j₀ = 0 := by
    have hdeg : (Polynomial.X ^ 4 - Polynomial.C 72 * Polynomial.X ^ 3 +
        Polynomial.C 1728 * Polynomial.X ^ 2 - Polynomial.C (13824 + j₀) * Polynomial.X +
        Polynomial.C (27 * j₀) : Polynomial K).degree = 4 := by
      compute_degree!
    obtain ⟨x, hx⟩ := IsAlgClosed.exists_root _ (by rw [hdeg]; decide)
    refine ⟨x, ?_⟩
    have hx' := hx
    simp only [Polynomial.IsRoot, Polynomial.eval_add, Polynomial.eval_sub, Polynomial.eval_mul,
      Polynomial.eval_pow, Polynomial.eval_C, Polynomial.eval_X] at hx'
    linear_combination hx'
  
  have hw72 : w (72 : K) ≤ 1 := by simpa using natle 72
  have hw1728 : w (1728 : K) ≤ 1 := by simpa using natle 1728
  have hw13824 : w (13824 : K) ≤ 1 := by simpa using natle 13824
  have hw27 : w (27 : K) ≤ 1 := by simpa using natle 27
  have hw756 : w (756 : K) ≤ 1 := by simpa using natle 756
  have hw270 : w (270 : K) ≤ 1 := by simpa using natle 270
  have hw36 : w (36 : K) ≤ 1 := by simpa using natle 36
  have hjc : w (13824 + j₀) ≤ 1 :=
    le_trans (Valuation.map_add _ _ _) (max_le hw13824 hj)
  have hb1 : w b ≤ 1 := by
    by_contra hlt
    push_neg at hlt
    have hx1 : 1 ≤ w b := hlt.le
    have h23 : w b ^ 2 ≤ w b ^ 3 := by
      rw [pow_succ (w b) 2]; exact le_mul_of_one_le_right' hx1
    have h12 : w b ≤ w b ^ 2 := by
      rw [pow_two]; exact le_mul_of_one_le_right' hx1
    have h03 : (1 : Γ₀) ≤ w b ^ 3 := le_trans hx1 (le_trans h12 h23)
    have e : b ^ 4 = 72 * b ^ 3 - 1728 * b ^ 2 + (13824 + j₀) * b - 27 * j₀ := by
      linear_combination hQ
    have hle : w (b ^ 4) ≤ w b ^ 3 := by
      rw [e]
      refine le_trans (Valuation.map_sub _ _ _) (max_le ?_ ?_)
      · refine le_trans (Valuation.map_add _ _ _) (max_le ?_ ?_)
        · refine le_trans (Valuation.map_sub _ _ _) (max_le ?_ ?_)
          · rw [map_mul, map_pow]; exact mul_le_of_le_one_left' hw72
          · rw [map_mul, map_pow]; exact le_trans (mul_le_of_le_one_left' hw1728) h23
        · rw [map_mul]
          exact le_trans (mul_le_of_le_one_left' hjc) (le_trans h12 h23)
      · rw [map_mul]
        exact le_trans (mul_le_of_le_one_left' hw27) (le_trans hj h03)
    rw [map_pow] at hle
    exact absurd hle (not_le.mpr (pow_lt_pow_right₀ hlt (by norm_num)))
  have hε1 : w (b - 27) ≤ 1 := le_trans (Valuation.map_sub _ _ _) (max_le hb1 hw27)
  have hb27 : w (b - 27) = 1 := by
    have e : (729 : K) = (b - 27) * (j₀ - (756 + 270 * (b - 27) + 36 * (b - 27) ^ 2 +
        (b - 27) ^ 3)) := by
      linear_combination hQ
    have h729 : w (729 : K) = 1 := by
      rw [show (729 : K) = 3 ^ 6 by norm_num, map_pow, h3, one_pow]
    have hR : w (j₀ - (756 + 270 * (b - 27) + 36 * (b - 27) ^ 2 + (b - 27) ^ 3)) ≤ 1 := by
      refine le_trans (Valuation.map_sub _ _ _) (max_le hj ?_)
      refine le_trans (Valuation.map_add _ _ _) (max_le ?_ ?_)
      · refine le_trans (Valuation.map_add _ _ _) (max_le ?_ ?_)
        · refine le_trans (Valuation.map_add _ _ _) (max_le hw756 ?_)
          rw [map_mul]; exact mul_le_one' hw270 hε1
        · rw [map_mul, map_pow]; exact mul_le_one' hw36 (pow_le_one' hε1 2)
      · rw [map_pow]; exact pow_le_one' hε1 3
    refine le_antisymm hε1 (not_lt.mp fun hlt => ?_)
    have h1 : w (729 : K) ≤ w (b - 27) := by
      rw [e, map_mul]; exact mul_le_of_le_one_right' hR
    rw [h729] at h1
    exact absurd (lt_of_le_of_lt h1 hlt) (lt_irrefl _)
  have hbne : b ≠ 27 := by
    intro h
    rw [h, sub_self, map_zero] at hb27
    exact zero_ne_one hb27
  
  obtain ⟨a, ha⟩ := IsAlgClosed.exists_pow_nat_eq b (by norm_num : 0 < 3)
  have hΔE : E.Δ ≠ 0 := by
    have e : E.Δ = 16 * ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) ^ 2 := by
      simp only [hE, WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
        WeierstrassCurve.b₆, WeierstrassCurve.b₈, threeRootsCurve]
      ring
    rw [e]
    exact mul_ne_zero (by norm_num) (pow_ne_zero _ (mul_ne_zero (mul_ne_zero
      (sub_ne_zero.mpr h₁₂) (sub_ne_zero.mpr h₁₃)) (sub_ne_zero.mpr h₂₃)))
  set D : WeierstrassCurve K := { a₁ := a, a₂ := 0, a₃ := 1, a₄ := 0, a₆ := 0 } with hD
  have hDΔ : D.Δ = b - 27 := by
    rw [← ha]
    simp only [hD, WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
      WeierstrassCurve.b₆, WeierstrassCurve.b₈]
    ring
  have hDc : D.c₄ ^ 3 = b * (b - 24) ^ 3 := by
    rw [← ha]
    simp only [hD, WeierstrassCurve.c₄, WeierstrassCurve.b₂, WeierstrassCurve.b₄]
    ring
  haveI : E.IsElliptic := (WeierstrassCurve.isElliptic_iff E).mpr (isUnit_iff_ne_zero.mpr hΔE)
  have hDΔ0 : D.Δ ≠ 0 := by rw [hDΔ]; exact sub_ne_zero.mpr hbne
  haveI : D.IsElliptic := (WeierstrassCurve.isElliptic_iff D).mpr (isUnit_iff_ne_zero.mpr hDΔ0)
  have hjdef : ∀ (W : WeierstrassCurve K) [W.IsElliptic], W.j = W.c₄ ^ 3 / W.Δ := by
    intro W _
    rw [WeierstrassCurve.j, Units.val_inv_eq_inv_val, WeierstrassCurve.coe_Δ', inv_mul_eq_div]
  have hjeq : E.j = D.j := by
    rw [hjdef E, hjdef D, hDc, hDΔ, ← hj₀]
    rw [eq_div_iff (sub_ne_zero.mpr hbne)]
    linear_combination -hQ
  obtain ⟨C, hC⟩ := WeierstrassCurve.exists_variableChange_of_j_eq E D hjeq
  refine ⟨C, ?_⟩
  rw [hC]
  have ha1 : w a ≤ 1 := by
    refine (pow_le_one_iff_of_nonneg zero_le' (by norm_num : (3 : ℕ) ≠ 0)).mp ?_
    rw [← map_pow, ha]; exact hb1
  refine ⟨ha1, ?_, ?_, ?_, ?_, ?_⟩
  · simp [hD]
  · simp [hD]
  · simp [hD]
  · simp [hD]
  · rw [hDΔ]; exact hb27

theorem ellAdicRep_threeRootsCurve_inertia (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    (t₁ t₂ t₃ : F) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃)
    (hE : EllipticRootNumber.IsPotentiallyGood F (threeRootsCurve t₁ t₂ t₃)) :
    ∃ U ∈ nhds (1 : EllipticRootNumber.AbsGal F), ∀ w : EllipticRootNumber.relWeil F ⊥,
      (w : EllipticRootNumber.AbsGal F) ∈ U → (w : EllipticRootNumber.AbsGal F) ∈ EllipticRootNumber.inertia F →
        EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃) (w : EllipticRootNumber.AbsGal F) = 1 :=
by
  classical
  
  haveI : CharZero (AlgebraicClosure F) :=
    charZero_of_injective_algebraMap (algebraMap F (AlgebraicClosure F)).injective
  obtain ⟨v, hv₁, hv₂⟩ := exists_galoisInvariant_valuation_algebraicClosure F
  have hinj := (algebraMap F (AlgebraicClosure F)).injective
  have d12 : algebraMap F (AlgebraicClosure F) t₁ ≠ algebraMap F (AlgebraicClosure F) t₂ :=
    fun e => h₁₂ (hinj e)
  have d13 : algebraMap F (AlgebraicClosure F) t₁ ≠ algebraMap F (AlgebraicClosure F) t₃ :=
    fun e => h₁₃ (hinj e)
  have d23 : algebraMap F (AlgebraicClosure F) t₂ ≠ algebraMap F (AlgebraicClosure F) t₃ :=
    fun e => h₂₃ (hinj e)
  have hbc : (threeRootsCurve t₁ t₂ t₃).baseChange (AlgebraicClosure F) =
      threeRootsCurve (algebraMap F (AlgebraicClosure F) t₁) (algebraMap F (AlgebraicClosure F) t₂)
        (algebraMap F (AlgebraicClosure F) t₃) := by
    ext <;> simp [threeRootsCurve, WeierstrassCurve.baseChange, WeierstrassCurve.map]
  have hj : v ((threeRootsCurve (algebraMap F (AlgebraicClosure F) t₁)
      (algebraMap F (AlgebraicClosure F) t₂) (algebraMap F (AlgebraicClosure F) t₃)).c₄ ^ 3 /
      (threeRootsCurve (algebraMap F (AlgebraicClosure F) t₁)
      (algebraMap F (AlgebraicClosure F) t₂) (algebraMap F (AlgebraicClosure F) t₃)).Δ) ≤ 1 := by
    rw [← hbc, WeierstrassCurve.baseChange, WeierstrassCurve.map_c₄, WeierstrassCurve.map_Δ,
      ← map_pow, ← map_div₀]
    exact (hv₁ _).mpr hE
  have natle : ∀ n : ℕ, v (n : AlgebraicClosure F) ≤ 1 := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      push_cast
      exact le_trans (Valuation.map_add _ _ _) (max_le ih (by simp))
  have h23 : v (2 : AlgebraicClosure F) = 1 ∨ v (3 : AlgebraicClosure F) = 1 := by
    by_contra hc
    push_neg at hc
    have h2 : v (2 : AlgebraicClosure F) < 1 :=
      lt_of_le_of_ne (by simpa using natle 2) hc.1
    have h3 : v (3 : AlgebraicClosure F) < 1 :=
      lt_of_le_of_ne (by simpa using natle 3) hc.2
    have e : (1 : AlgebraicClosure F) = 3 - 2 := by norm_num
    have hle := Valuation.map_sub v (3 : AlgebraicClosure F) 2
    rw [← e, map_one] at hle
    exact absurd (lt_of_le_of_lt hle (max_lt h3 h2)) (lt_irrefl _)
  obtain ⟨C, g₁, g₂, g₃, g₄, g₆, gΔ⟩ : ∃ C : WeierstrassCurve.VariableChange (AlgebraicClosure F),
      v (C • (threeRootsCurve t₁ t₂ t₃).baseChange (AlgebraicClosure F)).a₁ ≤ 1 ∧
      v (C • (threeRootsCurve t₁ t₂ t₃).baseChange (AlgebraicClosure F)).a₂ ≤ 1 ∧
      v (C • (threeRootsCurve t₁ t₂ t₃).baseChange (AlgebraicClosure F)).a₃ ≤ 1 ∧
      v (C • (threeRootsCurve t₁ t₂ t₃).baseChange (AlgebraicClosure F)).a₄ ≤ 1 ∧
      v (C • (threeRootsCurve t₁ t₂ t₃).baseChange (AlgebraicClosure F)).a₆ ≤ 1 ∧
      v (C • (threeRootsCurve t₁ t₂ t₃).baseChange (AlgebraicClosure F)).Δ = 1 := by
    rw [hbc]
    rcases h23 with h2 | h3
    · exact threeRootsCurve_goodModel_of_val_two v h2 _ _ _ d12 d13 d23 hj
    · exact threeRootsCurve_goodModel_of_val_three v h3 _ _ _ d12 d13 d23 hj
  
  set S₀ : Set (AlgebraicClosure F) :=
    {((C.u : (AlgebraicClosure F)ˣ) : AlgebraicClosure F), C.r, C.s, C.t} with hS₀
  set L : IntermediateField F (AlgebraicClosure F) := IntermediateField.adjoin F S₀ with hL
  haveI : FiniteDimensional F L :=
    IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)
  have hU : ((L.fixingSubgroup : Subgroup (EllipticRootNumber.AbsGal F)) :
      Set (EllipticRootNumber.AbsGal F)) ∈ nhds (1 : EllipticRootNumber.AbsGal F) :=
    (IntermediateField.fixingSubgroup_isOpen L).mem_nhds (one_mem _)
  have hfixS : ∀ σ : EllipticRootNumber.AbsGal F, σ ∈ L.fixingSubgroup →
      ∀ x ∈ S₀, σ x = x := by
    intro σ hσ x hx
    exact (IntermediateField.mem_fixingSubgroup_iff L σ).mp hσ x
      (IntermediateField.subset_adjoin F S₀ hx)
  refine ⟨_, hU, fun w₀ hwU hwI => ?_⟩
  
  have hp : (EllipticRootNumber.p F).Prime := by
    unfold EllipticRootNumber.p
    exact CharP.char_is_prime (IsLocalRing.ResidueField ↥(ValuativeRel.valuation F).integer) _
  have hℓ : (EllipticRootNumber.ell F).Prime := (EllipticRootNumber.ell_prime F).out
  have hcop : ∀ n : ℕ, Nat.Coprime (EllipticRootNumber.ell F ^ (n + 1)) (EllipticRootNumber.p F) :=
    fun n => Nat.Coprime.pow_left _
      ((Nat.coprime_primes hℓ hp).mpr (EllipticRootNumber.ell_ne_p F))
  have hfix : ∀ (n : ℕ) (P : EllipticRootNumber.Pts F (threeRootsCurve t₁ t₂ t₃)),
      P ∈ EllipticRootNumber.torsion F (threeRootsCurve t₁ t₂ t₃) (EllipticRootNumber.ell F ^ (n + 1)) →
      EllipticRootNumber.galHom F (threeRootsCurve t₁ t₂ t₃) (w₀ : EllipticRootNumber.AbsGal F) P = P :=
    fun n P hP => galHom_eq_self_of_mem_inertia_of_algClosure_goodModel F
      (threeRootsCurve t₁ t₂ t₃) v hv₁ hv₂ C g₁ g₂ g₃ g₄ g₆ gΔ (w₀ : EllipticRootNumber.AbsGal F) hwI
      (hfixS _ hwU _ (by simp [hS₀])) (hfixS _ hwU _ (by simp [hS₀]))
      (hfixS _ hwU _ (by simp [hS₀])) (hfixS _ hwU _ (by simp [hS₀]))
      _ (pow_pos hℓ.pos _) (hcop n) P hP
  have htate : EllipticRootNumber.tateRep F (threeRootsCurve t₁ t₂ t₃)
      (w₀ : EllipticRootNumber.AbsGal F) = 1 := by
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    funext n
    apply Subtype.ext
    exact hfix n _ (x.1 n).2
  show LinearMap.baseChange (EllipticRootNumber.Ω F) (LinearMap.baseChange ℚ_[EllipticRootNumber.ell F]
    (EllipticRootNumber.tateRep F (threeRootsCurve t₁ t₂ t₃) (w₀ : EllipticRootNumber.AbsGal F))) = 1
  rw [htate, Module.End.one_eq_id, LinearMap.baseChange_id, LinearMap.baseChange_id]
  rfl

theorem isWeilRep_wdRep_variableChange_threeRootsCurve (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    (t₁ t₂ t₃ : F) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃)
    (C : WeierstrassCurve.VariableChange F) :
    EllipticRootNumber.IsWeilRep F ⊥
      (EllipticRootNumber.wdRep F (C • threeRootsCurve t₁ t₂ t₃)).ρ :=
by
  classical
  have hu : ((C.u⁻¹ : Fˣ) : F) ≠ 0 := Units.ne_zero _
  by_cases hPG : EllipticRootNumber.IsPotentiallyGood F (C • threeRootsCurve t₁ t₂ t₃)
  · 
    have hwd : EllipticRootNumber.wdRep F (C • threeRootsCurve t₁ t₂ t₃) =
        { V := EllipticRootNumber.VBar F (C • threeRootsCurve t₁ t₂ t₃)
          ρ := (EllipticRootNumber.ellAdicRep F (C • threeRootsCurve t₁ t₂ t₃)).comp
            (EllipticRootNumber.relWeil F ⊥).subtype
          N := 0 } := by
      unfold EllipticRootNumber.wdRep
      rw [if_pos hPG]
    
    have hΔ0 : (threeRootsCurve t₁ t₂ t₃).Δ ≠ 0 := by
      have e : (threeRootsCurve t₁ t₂ t₃).Δ =
          2 ^ 4 * ((t₁ - t₂) ^ 2 * (t₁ - t₃) ^ 2 * (t₂ - t₃) ^ 2) := by
        simp only [WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
          WeierstrassCurve.b₆, WeierstrassCurve.b₈, threeRootsCurve]
        ring
      rw [e]
      exact mul_ne_zero (pow_ne_zero _ two_ne_zero)
        (mul_ne_zero (mul_ne_zero (pow_ne_zero _ (sub_ne_zero.mpr h₁₂))
          (pow_ne_zero _ (sub_ne_zero.mpr h₁₃))) (pow_ne_zero _ (sub_ne_zero.mpr h₂₃)))
    have hEΔ : (C • threeRootsCurve t₁ t₂ t₃).Δ ≠ 0 := by
      rw [WeierstrassCurve.variableChange_Δ]
      exact mul_ne_zero (pow_ne_zero _ hu) hΔ0
    
    have hPG₀ : EllipticRootNumber.IsPotentiallyGood F (threeRootsCurve t₁ t₂ t₃) := by
      unfold EllipticRootNumber.IsPotentiallyGood at hPG ⊢
      have e : (threeRootsCurve t₁ t₂ t₃).c₄ ^ 3 / (threeRootsCurve t₁ t₂ t₃).Δ =
          (C • threeRootsCurve t₁ t₂ t₃).c₄ ^ 3 / (C • threeRootsCurve t₁ t₂ t₃).Δ := by
        rw [WeierstrassCurve.variableChange_c₄, WeierstrassCurve.variableChange_Δ]
        field_simp
      rw [e]
      exact hPG
    obtain ⟨U, hU, hfix⟩ := ellAdicRep_threeRootsCurve_inertia F t₁ t₂ t₃ h₁₂ h₁₃ h₂₃ hPG₀
    obtain ⟨e, he⟩ := vBar_linearEquiv_variableChange F C (threeRootsCurve t₁ t₂ t₃)
    haveI := tateModule_finite F (C • threeRootsCurve t₁ t₂ t₃) hEΔ
    haveI : Module.Finite ℚ_[EllipticRootNumber.ell F]
        (EllipticRootNumber.VQ F (C • threeRootsCurve t₁ t₂ t₃)) :=
      Module.Finite.base_change _ _ _
    haveI : FiniteDimensional (EllipticRootNumber.Ω F)
        (EllipticRootNumber.VBar F (C • threeRootsCurve t₁ t₂ t₃)) :=
      Module.Finite.base_change _ _ _
    have gen : ∀ W : EllipticRootNumber.WDRep F ⊥,
        W = { V := EllipticRootNumber.VBar F (C • threeRootsCurve t₁ t₂ t₃)
              ρ := (EllipticRootNumber.ellAdicRep F (C • threeRootsCurve t₁ t₂ t₃)).comp
                (EllipticRootNumber.relWeil F ⊥).subtype
              N := 0 } →
        EllipticRootNumber.IsWeilRep F ⊥ W.ρ := by
      rintro W rfl
      dsimp only
      refine ⟨inferInstance, U, hU, fun w hwU hwI => ?_⟩
      have h1 := hfix w hwU hwI
      apply LinearMap.ext
      intro x
      apply e.injective
      have hx := LinearMap.congr_fun (he (w : EllipticRootNumber.AbsGal F)) x
      rw [LinearMap.comp_apply, LinearMap.comp_apply, h1] at hx
      exact hx
    exact gen _ hwd
  · 
    generalize C • threeRootsCurve t₁ t₂ t₃ = E at hPG ⊢
    have hwd : EllipticRootNumber.wdRep F E =
        { V := Fin 2 → ULift.{u} (EllipticRootNumber.Ω F)
          ρ := EllipticRootNumber.spTwistRep F ⊥ (EllipticRootNumber.quadCharΩ F E ⊥)
          N := EllipticRootNumber.spN F } := by
      unfold EllipticRootNumber.wdRep
      rw [if_neg hPG]
    have hint : IsIntegral F (EllipticRootNumber.sqrtNegC₆ F E) :=
      Algebra.IsIntegral.isIntegral _
    haveI : FiniteDimensional F
        (IntermediateField.adjoin F {EllipticRootNumber.sqrtNegC₆ F E}) :=
      IntermediateField.adjoin.finiteDimensional hint
    have hUo := IntermediateField.fixingSubgroup_isOpen
      (IntermediateField.adjoin F {EllipticRootNumber.sqrtNegC₆ F E})
    have hU : ((IntermediateField.adjoin F {EllipticRootNumber.sqrtNegC₆ F E}).fixingSubgroup :
        Set (EllipticRootNumber.AbsGal F)) ∈ nhds (1 : EllipticRootNumber.AbsGal F) :=
      hUo.mem_nhds (Subgroup.one_mem _)
    haveI : Module.Finite (EllipticRootNumber.Ω F) (ULift.{u} (EllipticRootNumber.Ω F)) :=
      Module.Finite.equiv ULift.moduleEquiv.symm
    have gen : ∀ W : EllipticRootNumber.WDRep F ⊥,
        W = { V := Fin 2 → ULift.{u} (EllipticRootNumber.Ω F)
              ρ := EllipticRootNumber.spTwistRep F ⊥ (EllipticRootNumber.quadCharΩ F E ⊥)
              N := EllipticRootNumber.spN F } →
        EllipticRootNumber.IsWeilRep F ⊥ W.ρ := by
      rintro W rfl
      dsimp only
      refine ⟨inferInstance, _, hU, fun w hwU hwI => ?_⟩
      
      have hws : (w : EllipticRootNumber.AbsGal F) (EllipticRootNumber.sqrtNegC₆ F E) =
          EllipticRootNumber.sqrtNegC₆ F E :=
        (IntermediateField.mem_fixingSubgroup_iff _ _).mp hwU _
          (IntermediateField.mem_adjoin_simple_self F _)
      have hq : EllipticRootNumber.quadChar F E (w : EllipticRootNumber.AbsGal F) = 1 := by
        show EllipticRootNumber.quadSign F E (w : EllipticRootNumber.AbsGal F) = 1
        unfold EllipticRootNumber.quadSign
        rw [if_pos hws]
      have hχ : EllipticRootNumber.quadCharΩ F E ⊥ w = 1 := by
        show (Units.map (Int.castRingHom (EllipticRootNumber.Ω F)).toMonoidHom)
          (EllipticRootNumber.quadChar F E (w : EllipticRootNumber.AbsGal F)) = 1
        rw [hq, map_one]
      
      have hAct : EllipticRootNumber.ActsAsFrobPow F
          ((Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) w :
            EllipticRootNumber.weilGroup F) : EllipticRootNumber.AbsGal F) 0 := by
        intro ζ hζ
        have hz : (w : EllipticRootNumber.AbsGal F) ζ = ζ :=
          (IntermediateField.mem_fixingSubgroup_iff _ _).mp hwI ζ
            (IntermediateField.subset_adjoin F _ hζ)
        show (w : EllipticRootNumber.AbsGal F) ζ ^ (EllipticRootNumber.q F ^ (-(0 : ℤ)).toNat) =
          ζ ^ (EllipticRootNumber.q F ^ (0 : ℤ).toNat)
        rw [hz, neg_zero]
      have hdeg := (weilDegreeHom_spec F).2 _ 0 hAct
      have hN : EllipticRootNumber.relNorm F ⊥ w = 1 := by
        show (zpowersHom (EllipticRootNumber.Ω F)ˣ (EllipticRootNumber.qUnit F))
          (EllipticRootNumber.weilDegreeHom F
            (Subgroup.inclusion (EllipticRootNumber.relWeil_le_weilGroup F ⊥) w)) = 1
        rw [hdeg, ofAdd_zero, map_one]
      apply LinearMap.ext
      intro x
      funext i
      simp [EllipticRootNumber.spTwistRep, hχ, hN]
    exact gen _ hwd

theorem wdRep_eq_of_not_isPotentiallyGood (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (E₁ E₂ : WeierstrassCurve F)
    (h₁ : ¬ EllipticRootNumber.IsPotentiallyGood F E₁) (h₂ : ¬ EllipticRootNumber.IsPotentiallyGood F E₂)
    (u : F) (hu : u ≠ 0) (hc : E₁.c₆ = u ^ 2 * E₂.c₆) :
    EllipticRootNumber.wdRep F E₁ = EllipticRootNumber.wdRep F E₂ :=
by
  classical
  set s₁ := EllipticRootNumber.sqrtNegC₆ F E₁ with hs₁
  set s₂ := EllipticRootNumber.sqrtNegC₆ F E₂ with hs₂
  have hsq : s₁ ^ 2 = (algebraMap F (AlgebraicClosure F) u * s₂) ^ 2 := by
    rw [mul_pow, hs₁, hs₂, EllipticRootNumber.sqrtNegC₆_sq, EllipticRootNumber.sqrtNegC₆_sq, hc]
    simp only [map_neg, map_mul, map_pow]
    ring
  have hι : algebraMap F (AlgebraicClosure F) u ≠ 0 :=
    (map_ne_zero (algebraMap F (AlgebraicClosure F))).mpr hu
  obtain ⟨c, hc0, hcfix, hsc⟩ : ∃ c : AlgebraicClosure F, c ≠ 0 ∧
      (∀ σ : EllipticRootNumber.AbsGal F, σ c = c) ∧ s₁ = c * s₂ := by
    rcases sq_eq_sq_iff_eq_or_eq_neg.mp hsq with h | h
    · exact ⟨_, hι, fun σ => AlgEquiv.commutes σ u, h⟩
    · refine ⟨-(algebraMap F (AlgebraicClosure F) u), neg_ne_zero.mpr hι, fun σ => ?_, ?_⟩
      · rw [map_neg, AlgEquiv.commutes]
      · rw [h, neg_mul]
  have hiff : ∀ σ : EllipticRootNumber.AbsGal F, σ s₁ = s₁ ↔ σ s₂ = s₂ := by
    intro σ
    rw [hsc, map_mul, hcfix σ]
    exact mul_right_inj' hc0
  have hq : EllipticRootNumber.quadChar F E₁ = EllipticRootNumber.quadChar F E₂ := by
    ext σ
    show (EllipticRootNumber.quadSign F E₁ σ : ℤ) = EllipticRootNumber.quadSign F E₂ σ
    unfold EllipticRootNumber.quadSign
    rw [← hs₁, ← hs₂]
    by_cases h : σ s₂ = s₂
    · rw [if_pos ((hiff σ).mpr h), if_pos h]
    · rw [if_neg (fun h' => h ((hiff σ).mp h')), if_neg h]
  have hqΩ : EllipticRootNumber.quadCharΩ F E₁ ⊥ = EllipticRootNumber.quadCharΩ F E₂ ⊥ := by
    unfold EllipticRootNumber.quadCharΩ
    rw [hq]
  unfold EllipticRootNumber.wdRep
  rw [if_neg h₁, if_neg h₂, hqΩ]

theorem localEps_variableChange_threeRootsCurve (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    (t₁ t₂ t₃ : F) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃)
    (C : WeierstrassCurve.VariableChange F) {rec : EllipticRootNumber.LocalReciprocity F}
    (lc : EllipticRootNumber.LocalConstants F rec)
    (ψ : AddChar (⊥ : IntermediateField F (AlgebraicClosure F)) (EllipticRootNumber.Ω F))
    (hψ : EllipticRootNumber.IsAdmissibleChar F ⊥ ψ) :
    (lc.eps ⊥ (EllipticRootNumber.wdRep F (C • threeRootsCurve t₁ t₂ t₃)).ρ ψ :
        EllipticRootNumber.Ω F) *
        EllipticRootNumber.frobDet F ⊥ (EllipticRootNumber.wdRep F (C • threeRootsCurve t₁ t₂ t₃)) =
      (lc.eps ⊥ (EllipticRootNumber.wdRep F (threeRootsCurve t₁ t₂ t₃)).ρ ψ : EllipticRootNumber.Ω F) *
        EllipticRootNumber.frobDet F ⊥ (EllipticRootNumber.wdRep F (threeRootsCurve t₁ t₂ t₃)) :=
by
  classical
  
  have hfd : ∀ σ' : EllipticRootNumber.WDRep F ⊥, σ'.N = 0 →
      EllipticRootNumber.frobDet F ⊥ σ' = 1 := by
    intro σ' hN
    unfold EllipticRootNumber.frobDet
    dsimp only
    split_ifs with hI hK
    · have hK' : (LinearMap.ker σ'.N).comap
          (EllipticRootNumber.inertiaInvariants F ⊥ σ').subtype = ⊤ := by
        rw [eq_top_iff]
        intro v _
        simp [Submodule.mem_comap, LinearMap.mem_ker, hN]
      haveI := Submodule.Quotient.subsingleton_iff.mpr hK'
      exact LinearMap.det_eq_one_of_subsingleton _
    · rfl
    · rfl
  
  have hw : ((C.u⁻¹ : Fˣ) : F) ≠ 0 := Units.ne_zero _
  have hj : (C • threeRootsCurve t₁ t₂ t₃).c₄ ^ 3 / (C • threeRootsCurve t₁ t₂ t₃).Δ =
      (threeRootsCurve t₁ t₂ t₃).c₄ ^ 3 / (threeRootsCurve t₁ t₂ t₃).Δ := by
    rw [WeierstrassCurve.variableChange_c₄, WeierstrassCurve.variableChange_Δ]
    have h12 : (((C.u⁻¹ : Fˣ) : F) ^ 4 * (threeRootsCurve t₁ t₂ t₃).c₄) ^ 3 =
        ((C.u⁻¹ : Fˣ) : F) ^ 12 * (threeRootsCurve t₁ t₂ t₃).c₄ ^ 3 := by ring
    rw [h12, mul_div_mul_left _ _ (pow_ne_zero _ hw)]
  have hPG : EllipticRootNumber.IsPotentiallyGood F (C • threeRootsCurve t₁ t₂ t₃) ↔
      EllipticRootNumber.IsPotentiallyGood F (threeRootsCurve t₁ t₂ t₃) := by
    unfold EllipticRootNumber.IsPotentiallyGood
    rw [hj]
  by_cases hE : EllipticRootNumber.IsPotentiallyGood F (threeRootsCurve t₁ t₂ t₃)
  · 
    have hX := hPG.mpr hE
    have hwX : EllipticRootNumber.wdRep F (C • threeRootsCurve t₁ t₂ t₃) =
        { V := EllipticRootNumber.VBar F (C • threeRootsCurve t₁ t₂ t₃)
          ρ := (EllipticRootNumber.ellAdicRep F (C • threeRootsCurve t₁ t₂ t₃)).comp
            (EllipticRootNumber.relWeil F ⊥).subtype
          N := 0 } := if_pos hX
    have hwE : EllipticRootNumber.wdRep F (threeRootsCurve t₁ t₂ t₃) =
        { V := EllipticRootNumber.VBar F (threeRootsCurve t₁ t₂ t₃)
          ρ := (EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
            (EllipticRootNumber.relWeil F ⊥).subtype
          N := 0 } := if_pos hE
    have f1 : EllipticRootNumber.frobDet F ⊥
        (EllipticRootNumber.wdRep F (C • threeRootsCurve t₁ t₂ t₃)) = 1 :=
      hfd _ (by rw [hwX])
    have f2 : EllipticRootNumber.frobDet F ⊥
        (EllipticRootNumber.wdRep F (threeRootsCurve t₁ t₂ t₃)) = 1 :=
      hfd _ (by rw [hwE])
    rw [f1, f2, mul_one, mul_one]
    have hWX := isWeilRep_wdRep_variableChange_threeRootsCurve F t₁ t₂ t₃ h₁₂ h₁₃ h₂₃ C
    have hWE := isWeilRep_wdRep_variableChange_threeRootsCurve F t₁ t₂ t₃ h₁₂ h₁₃ h₂₃ 1
    rw [one_smul] at hWE
    obtain ⟨e, he⟩ := vBar_linearEquiv_variableChange F C (threeRootsCurve t₁ t₂ t₃)
    have gen : ∀ W₁ W₂ : EllipticRootNumber.WDRep F ⊥,
        W₁ = { V := EllipticRootNumber.VBar F (C • threeRootsCurve t₁ t₂ t₃)
               ρ := (EllipticRootNumber.ellAdicRep F (C • threeRootsCurve t₁ t₂ t₃)).comp
                 (EllipticRootNumber.relWeil F ⊥).subtype
               N := 0 } →
        W₂ = { V := EllipticRootNumber.VBar F (threeRootsCurve t₁ t₂ t₃)
               ρ := (EllipticRootNumber.ellAdicRep F (threeRootsCurve t₁ t₂ t₃)).comp
                 (EllipticRootNumber.relWeil F ⊥).subtype
               N := 0 } →
        EllipticRootNumber.IsWeilRep F ⊥ W₁.ρ → EllipticRootNumber.IsWeilRep F ⊥ W₂.ρ →
        (lc.eps ⊥ W₁.ρ ψ : EllipticRootNumber.Ω F) = (lc.eps ⊥ W₂.ρ ψ : EllipticRootNumber.Ω F) := by
      rintro W₁ W₂ rfl rfl h₁ h₂
      exact congrArg Units.val
        (eps_eq_of_linearEquiv F lc ⊥ ψ hψ _ _ h₁ h₂ e (fun w => he w))
    exact gen _ _ hwX hwE hWX hWE
  · 
    have hX : ¬ EllipticRootNumber.IsPotentiallyGood F (C • threeRootsCurve t₁ t₂ t₃) :=
      fun h => hE (hPG.mp h)
    have hc : (C • threeRootsCurve t₁ t₂ t₃).c₆ =
        (((C.u⁻¹ : Fˣ) : F) ^ 3) ^ 2 * (threeRootsCurve t₁ t₂ t₃).c₆ := by
      rw [WeierstrassCurve.variableChange_c₆]
      ring
    rw [wdRep_eq_of_not_isPotentiallyGood F _ _ hX hE _ (pow_ne_zero 3 hw) hc]

theorem finiteDimensional_vBar_threeRootsCurve (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    (t₁ t₂ t₃ : F) (h₁₂ : t₁ ≠ t₂) (h₁₃ : t₁ ≠ t₃) (h₂₃ : t₂ ≠ t₃) :
    FiniteDimensional (EllipticRootNumber.Ω F) (EllipticRootNumber.VBar F (threeRootsCurve t₁ t₂ t₃)) :=
by
  have hΔ : (threeRootsCurve t₁ t₂ t₃).Δ ≠ 0 := by
    have e : (threeRootsCurve t₁ t₂ t₃).Δ = 16 * ((t₁ - t₂) * (t₁ - t₃) * (t₂ - t₃)) ^ 2 := by
      simp only [WeierstrassCurve.Δ, WeierstrassCurve.b₂, WeierstrassCurve.b₄,
        WeierstrassCurve.b₆, WeierstrassCurve.b₈, threeRootsCurve]
      ring
    rw [e]
    exact mul_ne_zero (by norm_num) (pow_ne_zero _ (mul_ne_zero (mul_ne_zero
      (sub_ne_zero.mpr h₁₂) (sub_ne_zero.mpr h₁₃)) (sub_ne_zero.mpr h₂₃)))
  haveI := tateModule_finite F (threeRootsCurve t₁ t₂ t₃) hΔ
  haveI : Module.Finite ℚ_[EllipticRootNumber.ell F]
      (EllipticRootNumber.VQ F (threeRootsCurve t₁ t₂ t₃)) :=
    Module.Finite.base_change _ _ _
  exact Module.Finite.base_change _ _ _

theorem finrank_vBar_of_card_torsion (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] (E : WeierstrassCurve F) (hΔ : E.Δ ≠ 0)
    (hcard : ∀ k : ℕ, Nat.card (EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1))) =
      EllipticRootNumber.ell F ^ (2 * (k + 1))) :
    Module.finrank (EllipticRootNumber.Ω F) (EllipticRootNumber.VBar F E) = 2 :=
by
  classical
  set ℓ := EllipticRootNumber.ell F with hℓ
  haveI hℓprime : Fact ℓ.Prime := EllipticRootNumber.ell_prime F
  have hℓpos : 0 < ℓ := hℓprime.out.pos
  have hE0 : ∀ P : EllipticRootNumber.Pts F E,
      P ∈ EllipticRootNumber.torsion F E (ℓ ^ (0 + 1)) → ℓ • P = 0 := by
    intro P hP
    rw [EllipticRootNumber.mem_torsion, zero_add, pow_one] at hP
    exact hP
  
  have s1 : ∀ (n : ℕ) (Q : EllipticRootNumber.Pts F E),
      Q ∈ EllipticRootNumber.torsion F E (ℓ ^ (n + 1)) →
      ∃ P ∈ EllipticRootNumber.torsion F E (ℓ ^ (n + 1 + 1)), ℓ • P = Q := by
    intro n Q hQ
    let φ : EllipticRootNumber.torsion F E (ℓ ^ (n + 1 + 1)) →+
        EllipticRootNumber.torsion F E (ℓ ^ (n + 1)) :=
      { toFun := fun P => ⟨ℓ • (P : EllipticRootNumber.Pts F E), by
          rw [EllipticRootNumber.mem_torsion, ← mul_nsmul, ← pow_succ']
          exact (EllipticRootNumber.mem_torsion F E).mp P.2⟩
        map_zero' := Subtype.ext (by simp)
        map_add' := fun P P' => Subtype.ext (by simp [nsmul_add]) }
    have hkercard : Nat.card φ.ker = ℓ ^ 2 := by
      have e : φ.ker ≃ EllipticRootNumber.torsion F E (ℓ ^ (0 + 1)) :=
        { toFun := fun P => ⟨((P : EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E), by
            have h := congrArg Subtype.val (AddMonoidHom.mem_ker.mp P.2)
            rw [EllipticRootNumber.mem_torsion, zero_add, pow_one]
            exact h⟩
          invFun := fun Q => ⟨⟨(Q : EllipticRootNumber.Pts F E), by
              have hQ0 := hE0 _ Q.2
              rw [EllipticRootNumber.mem_torsion, pow_succ', mul_nsmul, hQ0, nsmul_zero]⟩, by
              exact AddMonoidHom.mem_ker.mpr (Subtype.ext (hE0 _ Q.2))⟩
          left_inv := fun P => rfl
          right_inv := fun Q => rfl }
      rw [Nat.card_congr e, hcard 0]
    have h1 := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup φ.ker
    rw [Nat.card_congr (QuotientAddGroup.quotientKerEquivRange φ).toEquiv, hkercard,
      hcard (n + 1)] at h1
    have hrange : Nat.card φ.range = Nat.card (EllipticRootNumber.torsion F E (ℓ ^ (n + 1))) := by
      rw [hcard n]
      have hpos : 0 < ℓ ^ 2 := pow_pos hℓpos 2
      apply Nat.eq_of_mul_eq_mul_right hpos
      rw [← h1]
      ring
    haveI : Finite (EllipticRootNumber.torsion F E (ℓ ^ (n + 1))) := by
      apply Nat.finite_of_card_ne_zero
      rw [hcard n]
      exact (pow_pos hℓpos _).ne'
    have htop := AddSubgroup.eq_top_of_card_eq φ.range hrange
    obtain ⟨P, hP⟩ := (AddMonoidHom.range_eq_top.mp htop) ⟨Q, hQ⟩
    exact ⟨P, P.2, congrArg Subtype.val hP⟩
  
  have s2 : ∀ P : EllipticRootNumber.torsion F E (ℓ ^ (0 + 1)), ∃ x : EllipticRootNumber.tateModule F E,
      (x : ∀ k : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (k + 1))) 0 = P := by
    intro P
    choose lift hlift1 hlift2 using s1
    let s : (k : ℕ) → EllipticRootNumber.torsion F E (ℓ ^ (k + 1)) := fun k =>
      Nat.rec (motive := fun k => EllipticRootNumber.torsion F E (ℓ ^ (k + 1))) P
        (fun k sk => ⟨lift k sk sk.2, hlift1 k sk sk.2⟩) k
    have hs : s ∈ EllipticRootNumber.tateModule F E :=
      (EllipticRootNumber.mem_tateModule F E).mpr (fun k => hlift2 k (s k) (s k).2)
    exact ⟨⟨s, hs⟩, rfl⟩
  
  have hsmulℓ : ∀ (x : EllipticRootNumber.tateModule F E) (k : ℕ),
      (((((ℓ : ℤ_[ℓ]) • x : EllipticRootNumber.tateModule F E) :
          ∀ k : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (k + 1))) k :
          EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E) =
        ℓ • (((x : ∀ k : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (k + 1))) k :
          EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E) := by
    intro x k
    show ((((ℓ : ℤ_[ℓ]) • (x : ∀ k : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (k + 1))) k :
        EllipticRootNumber.torsion F E (ℓ ^ (k + 1)))) : EllipticRootNumber.Pts F E) = _
    rw [EllipticRootNumber.padic_smul_torsion, map_natCast, ZMod.val_natCast]
    exact EllipticRootNumber.nsmul_eq_of_modEq F E
      ((EllipticRootNumber.mem_torsion F E).mp
        ((x : ∀ k : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (k + 1))) k).2)
      (Nat.mod_modEq ℓ (ℓ ^ (k + 1)))
  
  have base : ∀ x : EllipticRootNumber.tateModule F E, (ℓ : ℤ_[ℓ]) • x = 0 → x = 0 := by
    intro x hx
    apply Subtype.ext
    funext k
    apply Subtype.ext
    rw [← (EllipticRootNumber.mem_tateModule F E).mp x.2 k, ← hsmulℓ x (k + 1), hx]
    rfl
  have iter : ∀ (v : ℕ) (x : EllipticRootNumber.tateModule F E),
      ((ℓ : ℤ_[ℓ]) ^ v) • x = 0 → x = 0 := by
    intro v
    induction v with
    | zero => intro x hx; rwa [pow_zero, one_smul] at hx
    | succ v ih =>
      intro x hx
      rw [pow_succ, mul_smul] at hx
      exact base x (ih _ hx)
  have tf : ∀ (a : ℤ_[ℓ]) (x : EllipticRootNumber.tateModule F E), a • x = 0 → a = 0 ∨ x = 0 := by
    intro a x h
    by_cases ha : a = 0
    · exact Or.inl ha
    · right
      apply iter a.valuation x
      have key : (ℓ : ℤ_[ℓ]) ^ a.valuation =
          (((PadicInt.unitCoeff ha)⁻¹ : ℤ_[ℓ]ˣ) : ℤ_[ℓ]) * a := by
        have hu := PadicInt.unitCoeff_spec ha
        calc (ℓ : ℤ_[ℓ]) ^ a.valuation
            = ((((PadicInt.unitCoeff ha)⁻¹ : ℤ_[ℓ]ˣ) : ℤ_[ℓ]) *
                ((PadicInt.unitCoeff ha : ℤ_[ℓ]ˣ) : ℤ_[ℓ])) * (ℓ : ℤ_[ℓ]) ^ a.valuation := by
              rw [Units.inv_mul, one_mul]
          _ = (((PadicInt.unitCoeff ha)⁻¹ : ℤ_[ℓ]ˣ) : ℤ_[ℓ]) *
                (((PadicInt.unitCoeff ha : ℤ_[ℓ]ˣ) : ℤ_[ℓ]) * (ℓ : ℤ_[ℓ]) ^ a.valuation) :=
              mul_assoc _ _ _
          _ = (((PadicInt.unitCoeff ha)⁻¹ : ℤ_[ℓ]ˣ) : ℤ_[ℓ]) * a := by rw [← hu]
      rw [key, mul_smul, h, smul_zero]
  haveI : Module.Finite ℤ_[ℓ] (EllipticRootNumber.tateModule F E) := tateModule_finite F E hΔ
  haveI : Module.IsTorsionFree ℤ_[ℓ] (EllipticRootNumber.tateModule F E) :=
    Module.IsTorsionFree.of_smul_eq_zero tf
  haveI : Module.Free ℤ_[ℓ] (EllipticRootNumber.tateModule F E) :=
    Module.free_of_finite_type_torsion_free'
  
  have s4 : ∀ x : EllipticRootNumber.tateModule F E,
      (((x : ∀ k : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (k + 1))) 0 :
        EllipticRootNumber.torsion F E _) : EllipticRootNumber.Pts F E) = 0 ↔
      ∃ y : EllipticRootNumber.tateModule F E, x = (ℓ : ℤ_[ℓ]) • y := by
    intro x
    constructor
    · intro hx0
      set xs : ∀ k : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (k + 1)) := x.1 with hxs
      have hmem : ∀ n, ℓ • ((xs (n + 1) : EllipticRootNumber.torsion F E _) :
          EllipticRootNumber.Pts F E) = (xs n : EllipticRootNumber.Pts F E) := x.2
      have hi : ∀ n : ℕ, ℓ ^ (n + 1) • ((xs (n + 1) : EllipticRootNumber.torsion F E _) :
          EllipticRootNumber.Pts F E) = 0 := by
        intro n
        induction n with
        | zero => rw [zero_add, pow_one, hmem 0, hx0]
        | succ k ih =>
          rw [pow_succ', mul_nsmul, hmem (k + 1), ih]
      let ys : ∀ k : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (k + 1)) := fun k =>
        ⟨(xs (k + 1) : EllipticRootNumber.Pts F E), (EllipticRootNumber.mem_torsion F E).mpr (hi k)⟩
      have hys : ys ∈ EllipticRootNumber.tateModule F E := by
        intro n
        exact hmem (n + 1)
      refine ⟨⟨ys, hys⟩, ?_⟩
      apply Subtype.ext
      funext n
      apply Subtype.ext
      show (xs n : EllipticRootNumber.Pts F E) =
        (((ℓ : ℤ_[ℓ]) • ys n : EllipticRootNumber.torsion F E (ℓ ^ (n + 1))) :
          EllipticRootNumber.Pts F E)
      rw [EllipticRootNumber.padic_smul_torsion, map_natCast, ZMod.val_natCast]
      rw [EllipticRootNumber.nsmul_eq_of_modEq F E (hi n) (Nat.mod_modEq ℓ (ℓ ^ (n + 1)))]
      exact (hmem n).symm
    · rintro ⟨y, rfl⟩
      rw [hsmulℓ y 0]
      exact hE0 _ ((y : ∀ k : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (k + 1))) 0).2
  
  let π₀ : EllipticRootNumber.tateModule F E →+ EllipticRootNumber.torsion F E (ℓ ^ (0 + 1)) :=
    { toFun := fun x => (x : ∀ k : ℕ, EllipticRootNumber.torsion F E (ℓ ^ (k + 1))) 0
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hπsurj : Function.Surjective π₀ := fun P => s2 P
  have hπker : ∀ x, π₀ x = 0 ↔ ∃ y, x = (ℓ : ℤ_[ℓ]) • y := by
    intro x
    rw [← s4 x]
    exact ⟨fun h => congrArg Subtype.val h, fun h => Subtype.ext h⟩
  
  have s5 : Nat.card (EllipticRootNumber.torsion F E (ℓ ^ (0 + 1))) =
      ℓ ^ Module.finrank ℤ_[ℓ] (EllipticRootNumber.tateModule F E) := by
    set r := Module.finrank ℤ_[ℓ] (EllipticRootNumber.tateModule F E)
    let b := Module.finBasis ℤ_[ℓ] (EllipticRootNumber.tateModule F E)
    let ρ : EllipticRootNumber.tateModule F E →+ (Fin r → ZMod ℓ) :=
      { toFun := fun x i => PadicInt.toZMod (b.repr x i)
        map_zero' := by funext i; simp
        map_add' := by intro x y; funext i; simp }
    have hdvd : ∀ c : ℤ_[ℓ], PadicInt.toZMod c = 0 ↔ (ℓ : ℤ_[ℓ]) ∣ c := by
      intro c
      rw [← RingHom.mem_ker, PadicInt.ker_toZMod, PadicInt.maximalIdeal_eq_span_p,
        Ideal.mem_span_singleton]
    have hρsurj : Function.Surjective ρ := by
      intro d
      refine ⟨∑ i, ((d i).val : ℤ_[ℓ]) • b i, ?_⟩
      funext i
      show PadicInt.toZMod (b.repr (∑ i, ((d i).val : ℤ_[ℓ]) • b i) i) = d i
      rw [b.repr_sum_self, map_natCast, ZMod.natCast_zmod_val]
    have hρker : ∀ x, ρ x = 0 ↔ ∃ y, x = (ℓ : ℤ_[ℓ]) • y := by
      intro x
      constructor
      · intro h
        have : ∀ i, (ℓ : ℤ_[ℓ]) ∣ b.repr x i := fun i => (hdvd _).1 (congrFun h i)
        choose c hc using this
        refine ⟨∑ i, c i • b i, ?_⟩
        rw [Finset.smul_sum]
        conv_lhs => rw [← b.sum_repr x]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [smul_smul, hc i]
      · rintro ⟨y, rfl⟩
        funext i
        show PadicInt.toZMod (b.repr ((ℓ : ℤ_[ℓ]) • y) i) = 0
        rw [map_smul, Finsupp.smul_apply, smul_eq_mul, hdvd]
        exact dvd_mul_right _ _
    have hkerEq : π₀.ker = ρ.ker := by
      ext x
      rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_ker, hπker, hρker]
    have e : EllipticRootNumber.torsion F E (ℓ ^ (0 + 1)) ≃+ (Fin r → ZMod ℓ) :=
      ((QuotientAddGroup.quotientKerEquivOfSurjective π₀ hπsurj).symm.trans
        (QuotientAddGroup.quotientAddEquivOfEq hkerEq)).trans
        (QuotientAddGroup.quotientKerEquivOfSurjective ρ hρsurj)
    rw [Nat.card_congr e.toEquiv, Nat.card_fun, Nat.card_zmod, Nat.card_eq_fintype_card,
      Fintype.card_fin]
  have hr : Module.finrank ℤ_[ℓ] (EllipticRootNumber.tateModule F E) = 2 := by
    have h := s5.symm.trans (hcard 0)
    have h' := Nat.pow_right_injective hℓprime.out.two_le h
    simpa using h'
  
  have hQ : Module.finrank ℚ_[ℓ] (EllipticRootNumber.VQ F E) =
      Module.finrank ℤ_[ℓ] (EllipticRootNumber.tateModule F E) :=
    Module.finrank_baseChange
  have hO : Module.finrank (EllipticRootNumber.Ω F) (EllipticRootNumber.VBar F E) =
      Module.finrank ℚ_[ℓ] (EllipticRootNumber.VQ F E) :=
    Module.finrank_baseChange
  rw [hO, hQ, hr]

theorem ladderXZ_degree {K : Type*} [Field K] [CharZero K] (W : WeierstrassCurve K) (n : ℕ)
    (hn : 0 < n) :
    (ladderXZ W n).1.natDegree = n ^ 2 ∧ (ladderXZ W n).1.leadingCoeff = 1 ∧
    (ladderXZ W n).2.natDegree = n ^ 2 - 1 ∧ (ladderXZ W n).2.leadingCoeff = (n : K) ^ 2 :=
by
  classical
  
  have Hmul : ∀ (p q : Polynomial K) (dp dq : ℕ), p.natDegree ≤ dp → q.natDegree ≤ dq →
      (p * q).natDegree ≤ dp + dq ∧ (p * q).coeff (dp + dq) = p.coeff dp * q.coeff dq :=
    fun p q dp dq h1 h2 => ⟨Polynomial.natDegree_mul_le_of_le h1 h2,
      Polynomial.coeff_mul_add_eq_of_natDegree_le h1 h2⟩
  have Hpow : ∀ (p : Polynomial K) (d k : ℕ), p.natDegree ≤ d →
      (p ^ k).natDegree ≤ k * d ∧ (p ^ k).coeff (k * d) = p.coeff d ^ k :=
    fun p d k h => ⟨Polynomial.natDegree_pow_le_of_le k h, Polynomial.coeff_pow_of_natDegree_le h⟩
  have HC : ∀ c : K, (Polynomial.C c).natDegree ≤ 0 := fun c => (Polynomial.natDegree_C c).le
  have H2 : (2 : Polynomial K).natDegree ≤ 0 := (Polynomial.natDegree_ofNat 2).le
  have H4 : (4 : Polynomial K).natDegree ≤ 0 := (Polynomial.natDegree_ofNat 4).le
  have H2c : (2 : Polynomial K).coeff 0 = 2 := Polynomial.coeff_ofNat_zero 2
  have H4c : (4 : Polynomial K).coeff 0 = 4 := Polynomial.coeff_ofNat_zero 4
  have Hz : ∀ (p : Polynomial K) (d D : ℕ), p.natDegree ≤ d → d < D → p.coeff D = 0 :=
    fun p d D h1 h2 => Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt h1 h2)
  have Hsub : ∀ (p q : Polynomial K) (D : ℕ), p.natDegree ≤ D → q.natDegree ≤ D →
      (p - q).natDegree ≤ D :=
    fun p q D h1 h2 => (Polynomial.natDegree_sub_le p q).trans (max_le h1 h2)
  have Hadd : ∀ (p q : Polynomial K) (D : ℕ), p.natDegree ≤ D → q.natDegree ≤ D →
      (p + q).natDegree ≤ D :=
    fun p q D h1 h2 => Polynomial.natDegree_add_le_of_degree_le h1 h2
  
  have dbl : ∀ (m : ℕ), 0 < m → ∀ P Q : Polynomial K,
      P.natDegree ≤ m ^ 2 → P.coeff (m ^ 2) = 1 → Q.natDegree ≤ m ^ 2 - 1 →
      Q.coeff (m ^ 2 - 1) = (m : K) ^ 2 →
      (ladderDbl W (P, Q)).1.natDegree ≤ (2 * m) ^ 2 ∧
      (ladderDbl W (P, Q)).1.coeff ((2 * m) ^ 2) = 1 ∧
      (ladderDbl W (P, Q)).2.natDegree ≤ (2 * m) ^ 2 - 1 ∧
      (ladderDbl W (P, Q)).2.coeff ((2 * m) ^ 2 - 1) = ((2 * m : ℕ) : K) ^ 2 := by
    intro m hm P Q h1 h2 h3 h4
    obtain ⟨N, hN⟩ : ∃ N, N = m ^ 2 := ⟨_, rfl⟩
    have hN1 : 1 ≤ N := by rw [hN]; exact Nat.one_le_pow _ _ hm
    have e4 : (2 * m) ^ 2 = 4 * N := by rw [hN]; ring
    rw [← hN] at h1 h2 h3 h4
    rw [e4]
    simp only [ladderDbl]
    have a1 := Hpow P N 4 h1
    have a2 := (Hmul _ _ _ _ (Hmul _ _ _ _ (HC W.b₄) (Hpow P N 2 h1).1).1 (Hpow Q _ 2 h3).1).1
    have a3 := (Hmul _ _ _ _ (Hmul _ _ _ _ (Hmul _ _ _ _ H2 (HC W.b₆)).1 h1).1
      (Hpow Q _ 3 h3).1).1
    have a4 := (Hmul _ _ _ _ (HC W.b₈) (Hpow Q _ 4 h3).1).1
    have b1 := Hmul _ _ _ _ (Hmul _ _ _ _ H4 (Hpow P N 3 h1).1).1 h3
    have b1' := (Hmul _ _ _ _ H4 (Hpow P N 3 h1).1).2
    have b2 := (Hmul _ _ _ _ (Hmul _ _ _ _ (HC W.b₂) (Hpow P N 2 h1).1).1 (Hpow Q _ 2 h3).1).1
    have b3 := (Hmul _ _ _ _ (Hmul _ _ _ _ (Hmul _ _ _ _ H2 (HC W.b₄)).1 h1).1
      (Hpow Q _ 3 h3).1).1
    have b4 := (Hmul _ _ _ _ (HC W.b₆) (Hpow Q _ 4 h3).1).1
    have eb : 0 + 3 * N + (N - 1) = 4 * N - 1 := by omega
    rw [eb] at b1
    refine ⟨?_, ?_, ?_, ?_⟩
    · exact Hsub _ _ _ (Hsub _ _ _ (Hsub _ _ _ a1.1 (a2.trans (by omega))) (a3.trans (by omega)))
        (a4.trans (by omega))
    · rw [Polynomial.coeff_sub, Polynomial.coeff_sub, Polynomial.coeff_sub, a1.2, h2,
        Hz _ _ _ a2 (by omega), Hz _ _ _ a3 (by omega), Hz _ _ _ a4 (by omega)]
      ring
    · exact Hadd _ _ _ (Hadd _ _ _ (Hadd _ _ _ b1.1 (b2.trans (by omega))) (b3.trans (by omega)))
        (b4.trans (by omega))
    · rw [Polynomial.coeff_add, Polynomial.coeff_add, Polynomial.coeff_add, b1.2, b1', H4c,
        (Hpow P N 3 h1).2, h2, h4,
        Hz _ _ _ b2 (by omega), Hz _ _ _ b3 (by omega), Hz _ _ _ b4 (by omega)]
      push_cast
      ring
  
  have add : ∀ (m : ℕ), 0 < m → ∀ P₁ Q₁ P₂ Q₂ : Polynomial K,
      P₁.natDegree ≤ (m + 1) ^ 2 → P₁.coeff ((m + 1) ^ 2) = 1 →
      Q₁.natDegree ≤ (m + 1) ^ 2 - 1 → Q₁.coeff ((m + 1) ^ 2 - 1) = ((m + 1 : ℕ) : K) ^ 2 →
      P₂.natDegree ≤ m ^ 2 → P₂.coeff (m ^ 2) = 1 → Q₂.natDegree ≤ m ^ 2 - 1 →
      Q₂.coeff (m ^ 2 - 1) = (m : K) ^ 2 →
      (ladderAdd W (P₁, Q₁) (P₂, Q₂)).1.natDegree ≤ (2 * m + 1) ^ 2 ∧
      (ladderAdd W (P₁, Q₁) (P₂, Q₂)).1.coeff ((2 * m + 1) ^ 2) = 1 ∧
      (ladderAdd W (P₁, Q₁) (P₂, Q₂)).2.natDegree ≤ (2 * m + 1) ^ 2 - 1 ∧
      (ladderAdd W (P₁, Q₁) (P₂, Q₂)).2.coeff ((2 * m + 1) ^ 2 - 1) =
        ((2 * m + 1 : ℕ) : K) ^ 2 := by
    intro m hm P₁ Q₁ P₂ Q₂ h1 h2 h3 h4 h5 h6 h7 h8
    obtain ⟨a, ha⟩ : ∃ a, a = (m + 1) ^ 2 := ⟨_, rfl⟩
    obtain ⟨b, hb⟩ : ∃ b, b = m ^ 2 := ⟨_, rfl⟩
    have hb1 : 1 ≤ b := by rw [hb]; exact Nat.one_le_pow _ _ hm
    have hab : a = b + 2 * m + 1 := by rw [ha, hb]; ring
    have eT : (2 * m + 1) ^ 2 = 4 * b + 4 * m + 1 := by rw [hb]; ring
    rw [← ha] at h1 h2 h3 h4
    rw [← hb] at h5 h6 h7 h8
    rw [eT]
    simp only [ladderAdd]
    obtain ⟨D, hD⟩ : ∃ D, D = 2 * b + 2 * m := ⟨_, rfl⟩
    have x1 := Hmul P₁ Q₂ _ _ h1 h7
    have x2 := Hmul P₂ Q₁ _ _ h5 h3
    have e1 : a + (b - 1) = D := by omega
    have e2 : b + (a - 1) = D := by omega
    rw [e1] at x1
    rw [e2] at x2
    have hs : (P₁ * Q₂ + P₂ * Q₁).natDegree ≤ D := Hadd _ _ _ x1.1 x2.1
    have hsc : (P₁ * Q₂ + P₂ * Q₁).coeff D = ((m : K) ^ 2 + ((m + 1 : ℕ) : K) ^ 2) := by
      rw [Polynomial.coeff_add, x1.2, x2.2, h2, h4, h6, h8]; ring
    have hw : (P₁ * Q₂ - P₂ * Q₁).natDegree ≤ D := Hsub _ _ _ x1.1 x2.1
    have hwc : (P₁ * Q₂ - P₂ * Q₁).coeff D = ((m : K) ^ 2 - ((m + 1 : ℕ) : K) ^ 2) := by
      rw [Polynomial.coeff_sub, x1.2, x2.2, h2, h4, h6, h8]; ring
    have w2 := Hpow _ D 2 hw
    have w2b := Hpow _ D 2 hw
    have t1 := Hmul _ _ _ _ (Hmul _ _ _ _ (Hmul _ _ _ _ H2 h1).1 h5).1 hs
    have t1' := Hmul _ _ _ _ (Hmul _ _ _ _ H2 h1).1 h5
    have t1'' := Hmul _ _ _ _ H2 h1
    have t2 := (Hmul _ _ _ _ (Hmul _ _ _ _ (Hmul _ _ _ _ (Hmul _ _ _ _ (HC W.b₂) h1).1 h5).1
      h3).1 h7).1
    have t3 := (Hmul _ _ _ _ (Hmul _ _ _ _ (Hmul _ _ _ _ (HC W.b₄) hs).1 h3).1 h7).1
    have t4 := (Hmul _ _ _ _ (Hmul _ _ _ _ (HC W.b₆) (Hpow Q₁ _ 2 h3).1).1
      (Hpow Q₂ _ 2 h7).1).1
    have t5 := Hmul _ _ _ _ Polynomial.natDegree_X_le w2.1
    have f1 : 0 + a + b + D = 4 * b + 4 * m + 1 := by omega
    have f5 : 1 + 2 * D = 4 * b + 4 * m + 1 := by omega
    have f6 : 2 * D = 4 * b + 4 * m + 1 - 1 := by omega
    rw [f1] at t1
    rw [f5] at t5
    rw [f6] at w2
    refine ⟨?_, ?_, ?_, ?_⟩
    · exact Hsub _ _ _ (Hadd _ _ _ (Hadd _ _ _ (Hadd _ _ _ t1.1 (t2.trans (by omega)))
        (t3.trans (by omega))) (t4.trans (by omega))) t5.1
    · rw [Polynomial.coeff_sub, Polynomial.coeff_add, Polynomial.coeff_add, Polynomial.coeff_add,
        t1.2, t1'.2, t1''.2, t5.2, w2b.2, hwc, hsc, H2c, h2, h6, Polynomial.coeff_X_one,
        Hz _ _ _ t2 (by omega), Hz _ _ _ t3 (by omega), Hz _ _ _ t4 (by omega)]
      push_cast
      ring
    · exact w2.1
    · rw [w2.2, hwc]
      push_cast
      ring
  
  have U2 : ∀ m : ℕ, 0 < m → ladderXZ W (2 * m) = ladderDbl W (ladderXZ W m) := by
    intro m hm
    obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
    rw [show 2 * (k + 1) = 2 * k + 2 by ring, ladderXZ.eq_3,
      dif_pos (show (2 * k + 2) % 2 = 0 by omega), show (2 * k + 2) / 2 = k + 1 by omega]
  have U3 : ∀ m : ℕ, 0 < m →
      ladderXZ W (2 * m + 1) = ladderAdd W (ladderXZ W (m + 1)) (ladderXZ W m) := by
    intro m hm
    obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
    rw [show 2 * (k + 1) + 1 = (2 * k + 1) + 2 by ring, ladderXZ.eq_3,
      dif_neg (show ¬ ((2 * k + 1) + 2) % 2 = 0 by omega),
      show ((2 * k + 1) + 2) / 2 = k + 1 by omega]
  
  have inv : ∀ n : ℕ, 0 < n →
      (ladderXZ W n).1.natDegree ≤ n ^ 2 ∧ (ladderXZ W n).1.coeff (n ^ 2) = 1 ∧
      (ladderXZ W n).2.natDegree ≤ n ^ 2 - 1 ∧
      (ladderXZ W n).2.coeff (n ^ 2 - 1) = (n : K) ^ 2 := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro hn
      obtain ⟨m, rfl | rfl⟩ := Nat.even_or_odd' n
      · have hm : 0 < m := by omega
        obtain ⟨h1, h2, h3, h4⟩ := ih m (by omega) hm
        rw [U2 m hm]
        exact dbl m hm _ _ h1 h2 h3 h4
      · rcases Nat.eq_zero_or_pos m with rfl | hm
        · rw [show 2 * 0 + 1 = 1 by rfl, ladderXZ.eq_2]
          refine ⟨Polynomial.natDegree_X_le, by simp, by simp, by simp⟩
        · obtain ⟨h1, h2, h3, h4⟩ := ih (m + 1) (by omega) (by omega)
          obtain ⟨h5, h6, h7, h8⟩ := ih m (by omega) hm
          rw [U3 m hm]
          exact add m hm _ _ _ _ h1 h2 h3 h4 h5 h6 h7 h8
  obtain ⟨h1, h2, h3, h4⟩ := inv n hn
  have hn0 : (n : K) ^ 2 ≠ 0 := pow_ne_zero 2 (Nat.cast_ne_zero.mpr hn.ne')
  have d1 : (ladderXZ W n).1.natDegree = n ^ 2 :=
    Polynomial.natDegree_eq_of_le_of_coeff_ne_zero h1 (by rw [h2]; exact one_ne_zero)
  have d2 : (ladderXZ W n).2.natDegree = n ^ 2 - 1 :=
    Polynomial.natDegree_eq_of_le_of_coeff_ne_zero h3 (by rw [h4]; exact hn0)
  refine ⟨d1, ?_, d2, ?_⟩
  · rw [Polynomial.leadingCoeff, d1, h2]
  · rw [Polynomial.leadingCoeff, d2, h4]

theorem ladderXZ_eval_nsmul {K : Type*} [Field K] [DecidableEq K] (W : WeierstrassCurve K)
    (n : ℕ) (hn : 0 < n) {x y : K} (h : W.toAffine.Nonsingular x y) :
    (n • WeierstrassCurve.Affine.Point.some h = 0 → (ladderXZ W n).2.eval x = 0) ∧
    (∀ {x' y' : K} (h' : W.toAffine.Nonsingular x' y'),
      n • WeierstrassCurve.Affine.Point.some h = WeierstrassCurve.Affine.Point.some h' →
        (ladderXZ W n).1.eval x = x' * (ladderXZ W n).2.eval x) :=
by
  
  have e1 : ladderXZ W 1 = (Polynomial.X, 1) := by
    rw [ladderXZ]
  have e2 : ∀ k : ℕ, ladderXZ W (2 * (k + 1)) = ladderDbl W (ladderXZ W (k + 1)) := by
    intro k
    rw [show 2 * (k + 1) = 2 * k + 2 by ring, ladderXZ, dif_pos (by omega),
      show (2 * k + 2) / 2 = k + 1 by omega]
  have e3 : ∀ k : ℕ, ladderXZ W (2 * (k + 1) + 1) =
      ladderAdd W (ladderXZ W (k + 1 + 1)) (ladderXZ W (k + 1)) := by
    intro k
    rw [show 2 * (k + 1) + 1 = 2 * k + 1 + 2 by ring, ladderXZ, dif_neg (by omega),
      show (2 * k + 1 + 2) / 2 = k + 1 by omega]
  
  have dbl : ∀ (R : W.toAffine.Point) (u v : K), (R = 0 → v = 0) →
      (∀ {x' y' : K} (h' : W.toAffine.Nonsingular x' y'),
        R = WeierstrassCurve.Affine.Point.some h' → u = x' * v) →
      (2 • R = 0 →
          4 * u ^ 3 * v + W.b₂ * u ^ 2 * v ^ 2 + 2 * W.b₄ * u * v ^ 3 + W.b₆ * v ^ 4 = 0) ∧
      (∀ {x' y' : K} (h' : W.toAffine.Nonsingular x' y'),
        2 • R = WeierstrassCurve.Affine.Point.some h' →
          u ^ 4 - W.b₄ * u ^ 2 * v ^ 2 - 2 * W.b₆ * u * v ^ 3 - W.b₈ * v ^ 4 =
            x' * (4 * u ^ 3 * v + W.b₂ * u ^ 2 * v ^ 2 + 2 * W.b₄ * u * v ^ 3 + W.b₆ * v ^ 4)) := by
    intro R u v h0 hs
    rw [two_nsmul]
    cases R with
    | zero =>
      have hv : v = 0 := h0 rfl
      subst hv
      refine ⟨fun _ => by ring, fun h' hT => ?_⟩
      exact absurd hT.symm (WeierstrassCurve.Affine.Point.some_ne_zero h')
    | @some xR yR hR =>
      obtain rfl := hs hR rfl
      have heq := (WeierstrassCurve.Affine.equation_iff _ _).mp hR.1
      have hneg : W.toAffine.negY xR yR = -yR - W.a₁ * xR - W.a₃ := rfl
      have hB : 4 * xR ^ 3 + W.b₂ * xR ^ 2 + 2 * W.b₄ * xR + W.b₆ =
          (2 * yR + W.a₁ * xR + W.a₃) ^ 2 := by
        simp only [WeierstrassCurve.b₂, WeierstrassCurve.b₄, WeierstrassCurve.b₆]
        linear_combination (-4) * heq
      by_cases hy : yR = W.toAffine.negY xR yR
      · have hadd := WeierstrassCurve.Affine.Point.add_of_Y_eq (h₁ := hR) (h₂ := hR) rfl hy
        have hd : 2 * yR + W.a₁ * xR + W.a₃ = 0 := by
          rw [hneg] at hy; linear_combination hy
        refine ⟨fun _ => ?_, fun h' hT => ?_⟩
        · linear_combination v ^ 4 * hB + v ^ 4 * (2 * yR + W.a₁ * xR + W.a₃) * hd
        · rw [hadd] at hT
          exact absurd hT.symm (WeierstrassCurve.Affine.Point.some_ne_zero h')
      · have hadd := WeierstrassCurve.Affine.Point.add_self_of_Y_ne (h₁ := hR) hy
        refine ⟨fun hT => ?_, fun h' hT => ?_⟩
        · rw [hadd] at hT
          exact absurd hT (WeierstrassCurve.Affine.Point.some_ne_zero _)
        · rw [hadd] at hT
          simp only [WeierstrassCurve.Affine.Point.some.injEq] at hT
          obtain ⟨hx', -⟩ := hT
          subst hx'
          have hd : 2 * yR + W.a₁ * xR + W.a₃ ≠ 0 := by
            intro h; apply hy; rw [hneg]; linear_combination h
          have hsl : W.toAffine.slope xR xR yR yR =
              (3 * xR ^ 2 + 2 * W.a₂ * xR + W.a₄ - W.a₁ * yR) / (2 * yR + W.a₁ * xR + W.a₃) := by
            rw [WeierstrassCurve.Affine.slope_of_Y_ne rfl hy, hneg]
            congr 1; ring
          have haddX : W.toAffine.addX xR xR (W.toAffine.slope xR xR yR yR) *
              (2 * yR + W.a₁ * xR + W.a₃) ^ 2 =
              (3 * xR ^ 2 + 2 * W.a₂ * xR + W.a₄ - W.a₁ * yR) ^ 2 +
                W.a₁ * (3 * xR ^ 2 + 2 * W.a₂ * xR + W.a₄ - W.a₁ * yR) *
                  (2 * yR + W.a₁ * xR + W.a₃) -
                (W.a₂ + 2 * xR) * (2 * yR + W.a₁ * xR + W.a₃) ^ 2 := by
            rw [hsl]
            simp only [WeierstrassCurve.Affine.addX]
            generalize 3 * xR ^ 2 + 2 * W.a₂ * xR + W.a₄ - W.a₁ * yR = m
            generalize 2 * yR + W.a₁ * xR + W.a₃ = d at hd ⊢
            field_simp
            ring
          have G1b : W.toAffine.addX xR xR (W.toAffine.slope xR xR yR yR) *
              (4 * xR ^ 3 + W.b₂ * xR ^ 2 + 2 * W.b₄ * xR + W.b₆) =
              xR ^ 4 - W.b₄ * xR ^ 2 - 2 * W.b₆ * xR - W.b₈ := by
            rw [hB, haddX]
            simp only [WeierstrassCurve.b₄, WeierstrassCurve.b₆, WeierstrassCurve.b₈]
            linear_combination (-(W.a₁ ^ 2 + 4 * W.a₂ + 8 * xR)) * heq
          linear_combination (-(v ^ 4)) * G1b
  
  have dadd : ∀ (R S : W.toAffine.Point) {x₀ y₀ : K} (h₀ : W.toAffine.Nonsingular x₀ y₀),
      R - S = WeierstrassCurve.Affine.Point.some h₀ → ∀ (u₁ v₁ u₂ v₂ : K),
      (R = 0 → v₁ = 0) →
      (∀ {x' y' : K} (h' : W.toAffine.Nonsingular x' y'),
        R = WeierstrassCurve.Affine.Point.some h' → u₁ = x' * v₁) →
      (S = 0 → v₂ = 0) →
      (∀ {x' y' : K} (h' : W.toAffine.Nonsingular x' y'),
        S = WeierstrassCurve.Affine.Point.some h' → u₂ = x' * v₂) →
      (R + S = 0 → (u₁ * v₂ - u₂ * v₁) ^ 2 = 0) ∧
      (∀ {x' y' : K} (h' : W.toAffine.Nonsingular x' y'),
        R + S = WeierstrassCurve.Affine.Point.some h' →
          2 * u₁ * u₂ * (u₁ * v₂ + u₂ * v₁) + W.b₂ * u₁ * u₂ * v₁ * v₂
            + W.b₄ * (u₁ * v₂ + u₂ * v₁) * v₁ * v₂ + W.b₆ * v₁ ^ 2 * v₂ ^ 2
            - x₀ * (u₁ * v₂ - u₂ * v₁) ^ 2 = x' * (u₁ * v₂ - u₂ * v₁) ^ 2) := by
    intro R S x₀ y₀ h₀ hRS u₁ v₁ u₂ v₂ hR0 hRs hS0 hSs
    cases R with
    | zero =>
      have hv₁ : v₁ = 0 := hR0 rfl
      subst hv₁
      cases S with
      | zero =>
        exfalso
        rw [← WeierstrassCurve.Affine.Point.zero_def, sub_self] at hRS
        exact WeierstrassCurve.Affine.Point.some_ne_zero h₀ hRS.symm
      | @some xS yS hS =>
        obtain rfl := hSs hS rfl
        rw [← WeierstrassCurve.Affine.Point.zero_def, zero_sub,
          WeierstrassCurve.Affine.Point.neg_some] at hRS
        simp only [WeierstrassCurve.Affine.Point.some.injEq] at hRS
        obtain ⟨hx0, -⟩ := hRS
        subst hx0
        rw [← WeierstrassCurve.Affine.Point.zero_def, zero_add]
        refine ⟨fun hT => absurd hT (WeierstrassCurve.Affine.Point.some_ne_zero _),
          fun h' hT => ?_⟩
        simp only [WeierstrassCurve.Affine.Point.some.injEq] at hT
        obtain ⟨hx', -⟩ := hT
        subst hx'
        ring
    | @some xR yR hR =>
      obtain rfl := hRs hR rfl
      have heqR := (WeierstrassCurve.Affine.equation_iff _ _).mp hR.1
      cases S with
      | zero =>
        have hv₂ : v₂ = 0 := hS0 rfl
        subst hv₂
        rw [← WeierstrassCurve.Affine.Point.zero_def, sub_zero] at hRS
        simp only [WeierstrassCurve.Affine.Point.some.injEq] at hRS
        obtain ⟨hx0, -⟩ := hRS
        subst hx0
        rw [← WeierstrassCurve.Affine.Point.zero_def, add_zero]
        refine ⟨fun hT => absurd hT (WeierstrassCurve.Affine.Point.some_ne_zero _),
          fun h' hT => ?_⟩
        simp only [WeierstrassCurve.Affine.Point.some.injEq] at hT
        obtain ⟨hx', -⟩ := hT
        subst hx'
        ring
      | @some xS yS hS =>
        obtain rfl := hSs hS rfl
        have heqS := (WeierstrassCurve.Affine.equation_iff _ _).mp hS.1
        refine ⟨fun hT => ?_, fun h' hT => ?_⟩
        · by_cases hx : xR = xS
          · subst hx; ring
          · rw [WeierstrassCurve.Affine.Point.add_of_X_ne hx] at hT
            exact absurd hT (WeierstrassCurve.Affine.Point.some_ne_zero _)
        · by_cases hx : xR = xS
          · exfalso
            rcases WeierstrassCurve.Affine.Y_eq_of_X_eq hR.1 hS.1 hx with hy | hy
            · subst hx; subst hy
              rw [sub_self] at hRS
              exact WeierstrassCurve.Affine.Point.some_ne_zero h₀ hRS.symm
            · rw [WeierstrassCurve.Affine.Point.add_of_Y_eq hx hy] at hT
              exact WeierstrassCurve.Affine.Point.some_ne_zero h' hT.symm
          · rw [WeierstrassCurve.Affine.Point.add_of_X_ne hx] at hT
            simp only [WeierstrassCurve.Affine.Point.some.injEq] at hT
            obtain ⟨hx', -⟩ := hT
            subst hx'
            rw [sub_eq_add_neg, WeierstrassCurve.Affine.Point.neg_some,
              WeierstrassCurve.Affine.Point.add_of_X_ne hx] at hRS
            simp only [WeierstrassCurve.Affine.Point.some.injEq] at hRS
            obtain ⟨hx0, -⟩ := hRS
            subst hx0
            have hD : xR - xS ≠ 0 := sub_ne_zero.mpr hx
            have h3 : W.toAffine.addX xR xS (W.toAffine.slope xR xS yR yS) * (xR - xS) ^ 2 =
                (yR - yS) ^ 2 + W.a₁ * (yR - yS) * (xR - xS) - (W.a₂ + xR + xS) * (xR - xS) ^ 2 := by
              rw [WeierstrassCurve.Affine.slope_of_X_ne hx]
              simp only [WeierstrassCurve.Affine.addX]
              field_simp
              ring
            have h4 : W.toAffine.addX xR xS (W.toAffine.slope xR xS yR (W.toAffine.negY xS yS)) *
                (xR - xS) ^ 2 =
                (yR - W.toAffine.negY xS yS) ^ 2 + W.a₁ * (yR - W.toAffine.negY xS yS) * (xR - xS)
                  - (W.a₂ + xR + xS) * (xR - xS) ^ 2 := by
              rw [WeierstrassCurve.Affine.slope_of_X_ne hx]
              simp only [WeierstrassCurve.Affine.addX]
              field_simp
              ring
            have hnegS : W.toAffine.negY xS yS = -yS - W.a₁ * xS - W.a₃ := rfl
            generalize W.toAffine.addX xR xS (W.toAffine.slope xR xS yR (W.toAffine.negY xS yS)) = x4
              at h4 ⊢
            generalize W.toAffine.addX xR xS (W.toAffine.slope xR xS yR yS) = x3 at h3 ⊢
            rw [hnegS] at h4
            simp only [WeierstrassCurve.b₂, WeierstrassCurve.b₄, WeierstrassCurve.b₆]
            linear_combination (-(v₁ ^ 2 * v₂ ^ 2)) * (h3 + h4 + 2 * heqR + 2 * heqS)
  
  set P := WeierstrassCurve.Affine.Point.some h with hP
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  rcases Nat.even_or_odd' n with ⟨k, rfl | rfl⟩
  · obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
    obtain ⟨ih0, ihs⟩ := ih (j + 1) (by omega) (by omega)
    have hD := dbl ((j + 1) • P) _ _ ih0 ihs
    rw [mul_smul, e2 j]
    simp only [ladderDbl, Polynomial.eval_add, Polynomial.eval_sub, Polynomial.eval_mul,
      Polynomial.eval_pow, Polynomial.eval_C, Polynomial.eval_ofNat]
    exact ⟨fun h0 => by linear_combination hD.1 h0,
      fun h' hT => by linear_combination hD.2 h' hT⟩
  · rcases Nat.eq_zero_or_pos k with hk | hk
    · subst hk
      simp only [mul_zero, zero_add, one_nsmul, e1, Polynomial.eval_X, Polynomial.eval_one,
        mul_one]
      refine ⟨fun hT => absurd hT (WeierstrassCurve.Affine.Point.some_ne_zero _),
        fun h' hT => ?_⟩
      rw [hP] at hT
      simp only [WeierstrassCurve.Affine.Point.some.injEq] at hT
      exact hT.1
    obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
    obtain ⟨ihA0, ihAs⟩ := ih (j + 1 + 1) (by omega) (by omega)
    obtain ⟨ihB0, ihBs⟩ := ih (j + 1) (by omega) (by omega)
    have hsplit : (2 * (j + 1) + 1) • P = (j + 1 + 1) • P + (j + 1) • P := by
      rw [← add_nsmul]; congr 1; ring
    have hdiff : (j + 1 + 1) • P - (j + 1) • P = WeierstrassCurve.Affine.Point.some h := by
      rw [succ_nsmul, add_sub_cancel_left]
    have hA := dadd ((j + 1 + 1) • P) ((j + 1) • P) h hdiff _ _ _ _ ihA0 ihAs ihB0 ihBs
    rw [hsplit, e3 j]
    simp only [ladderAdd, Polynomial.eval_add, Polynomial.eval_sub, Polynomial.eval_mul,
      Polynomial.eval_pow, Polynomial.eval_C, Polynomial.eval_ofNat, Polynomial.eval_X]
    exact ⟨fun h0 => by linear_combination hA.1 h0,
      fun h' hT => by linear_combination hA.2 h' hT⟩

theorem ladderXZ_no_common_root {K : Type*} [Field K] [IsAlgClosed K] (W : WeierstrassCurve K)
    (hΔ : W.Δ ≠ 0) (n : ℕ) (hn : 0 < n) (x : K) :
    ¬ ((ladderXZ W n).1.eval x = 0 ∧ (ladderXZ W n).2.eval x = 0) :=
by
  classical
  
  have unf1 : ladderXZ W 1 = (Polynomial.X, 1) := by rw [ladderXZ]
  have unf : ∀ m : ℕ, 0 < m →
      ladderXZ W (2 * m) = ladderDbl W (ladderXZ W m) ∧
      ladderXZ W (2 * m + 1) = ladderAdd W (ladderXZ W (m + 1)) (ladderXZ W m) := by
    intro m hm
    obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
    constructor
    · rw [show 2 * (k + 1) = 2 * k + 2 by ring, ladderXZ.eq_3,
        dif_pos (show (2 * k + 2) % 2 = 0 by omega), show (2 * k + 2) / 2 = k + 1 by omega]
    · rw [show 2 * (k + 1) + 1 = (2 * k + 1) + 2 by ring, ladderXZ.eq_3,
        dif_neg (show ¬ ((2 * k + 1 + 2) % 2 = 0) by omega),
        show (2 * k + 1 + 2) / 2 = k + 1 by omega]
  
  have exists_pt : ∀ t : K, ∃ y : K, W.toAffine.Nonsingular t y := by
    intro t
    obtain ⟨y, hy⟩ := IsAlgClosed.exists_root
      (Polynomial.C (1 : K) * Polynomial.X ^ 2 + Polynomial.C (W.a₁ * t + W.a₃) * Polynomial.X
        + Polynomial.C (-(t ^ 3 + W.a₂ * t ^ 2 + W.a₄ * t + W.a₆)))
      (by rw [Polynomial.degree_quadratic one_ne_zero]; decide)
    refine ⟨y, (WeierstrassCurve.Affine.equation_iff_nonsingular_of_Δ_ne_zero hΔ).mp ?_⟩
    rw [WeierstrassCurve.Affine.equation_iff]
    simp only [Polynomial.IsRoot, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
      Polynomial.eval_pow, Polynomial.eval_X] at hy
    linear_combination hy
  
  have dbl_ne : ∀ t y : K, W.toAffine.Equation t y →
      ¬ (t ^ 4 - W.b₄ * t ^ 2 - 2 * W.b₆ * t - W.b₈ = 0 ∧
         4 * t ^ 3 + W.b₂ * t ^ 2 + 2 * W.b₄ * t + W.b₆ = 0) := by
    rintro t y hE ⟨hA, hB⟩
    have hW := (WeierstrassCurve.Affine.equation_iff t y).mp hE
    have hns := (WeierstrassCurve.Affine.nonsingular_iff' t y).mp
      ((WeierstrassCurve.Affine.equation_iff_nonsingular_of_Δ_ne_zero hΔ).mp hE)
    simp only [WeierstrassCurve.b₂, WeierstrassCurve.b₄, WeierstrassCurve.b₆,
      WeierstrassCurve.b₈] at hA hB
    have hd2 : (2 * y + W.a₁ * t + W.a₃) ^ 2 = 0 := by linear_combination hB + 4 * hW
    have hd : 2 * y + W.a₁ * t + W.a₃ = 0 := (pow_eq_zero_iff two_ne_zero).mp hd2
    have hM2 : (W.a₁ * y - (3 * t ^ 2 + 2 * W.a₂ * t + W.a₄)) ^ 2 = 0 := by
      linear_combination hA + (W.a₁ * (W.a₁ * y - (3 * t ^ 2 + 2 * W.a₂ * t + W.a₄))
        + (W.a₂ + 2 * t) * (2 * y + W.a₁ * t + W.a₃)) * hd - (W.a₁ ^ 2 + 4 * W.a₂ + 8 * t) * hW
    have hM : W.a₁ * y - (3 * t ^ 2 + 2 * W.a₂ * t + W.a₄) = 0 :=
      (pow_eq_zero_iff two_ne_zero).mp hM2
    rcases hns.2 with h | h
    · exact h hM
    · exact h hd
  have pt : ∀ Q : W.toAffine.Point, Q = 0 ∨
      ∃ (a b : K) (h : W.toAffine.Nonsingular a b), Q = WeierstrassCurve.Affine.Point.some h := by
    intro Q
    cases Q with
    | zero => exact Or.inl rfl
    | some h => exact Or.inr ⟨_, _, h, rfl⟩
  
  have main : ∀ n : ℕ, ∀ x : K, 0 < n →
      ¬ ((ladderXZ W n).1.eval x = 0 ∧ (ladderXZ W n).2.eval x = 0) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n IH =>
    rintro x hn ⟨hX, hZ⟩
    rcases Nat.even_or_odd' n with ⟨m, rfl | rfl⟩
    · 
      have hm : 0 < m := by omega
      have ihm := IH m (by omega) x hm
      rw [(unf m hm).1] at hX hZ
      simp only [ladderDbl, Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_mul,
        Polynomial.eval_pow, Polynomial.eval_C, Polynomial.eval_ofNat] at hX hZ
      generalize (ladderXZ W m).1.eval x = u at hX hZ ihm
      generalize (ladderXZ W m).2.eval x = v at hX hZ ihm
      by_cases hv : v = 0
      · subst hv
        have hu4 : u ^ 4 = 0 := by linear_combination hX
        exact ihm ⟨(pow_eq_zero_iff (by norm_num)).mp hu4, rfl⟩
      · obtain ⟨t, rfl⟩ : ∃ t, u = t * v := ⟨u / v, (div_mul_cancel₀ u hv).symm⟩
        have hv4 : v ^ 4 ≠ 0 := pow_ne_zero 4 hv
        have hA : v ^ 4 * (t ^ 4 - W.b₄ * t ^ 2 - 2 * W.b₆ * t - W.b₈) = 0 := by
          linear_combination hX
        have hB : v ^ 4 * (4 * t ^ 3 + W.b₂ * t ^ 2 + 2 * W.b₄ * t + W.b₆) = 0 := by
          linear_combination hZ
        obtain ⟨y, hy⟩ := exists_pt t
        exact dbl_ne t y hy.1 ⟨(mul_eq_zero.mp hA).resolve_left hv4,
          (mul_eq_zero.mp hB).resolve_left hv4⟩
    · rcases Nat.eq_zero_or_pos m with rfl | hm
      · 
        rw [show 2 * 0 + 1 = 1 from rfl, unf1] at hZ
        simp at hZ
      · 
        have ih1 := IH (m + 1) (by omega) x (by omega)
        have ih2 := IH m (by omega) x hm
        obtain ⟨y₀, h₀⟩ := exists_pt x
        obtain ⟨hz₁, hs₁⟩ := ladderXZ_eval_nsmul W (m + 1) (by omega) h₀
        obtain ⟨hz₂, hs₂⟩ := ladderXZ_eval_nsmul W m hm h₀
        rw [(unf m hm).2] at hX hZ
        simp only [ladderAdd, Polynomial.eval_sub, Polynomial.eval_add, Polynomial.eval_mul,
          Polynomial.eval_pow, Polynomial.eval_C, Polynomial.eval_ofNat,
          Polynomial.eval_X] at hX hZ
        generalize (ladderXZ W (m + 1)).1.eval x = u₁ at hX hZ ih1 hs₁
        generalize (ladderXZ W (m + 1)).2.eval x = v₁ at hX hZ ih1 hz₁ hs₁
        generalize (ladderXZ W m).1.eval x = u₂ at hX hZ ih2 hs₂
        generalize (ladderXZ W m).2.eval x = v₂ at hX hZ ih2 hz₂ hs₂
        have hw : u₁ * v₂ - u₂ * v₁ = 0 := (pow_eq_zero_iff two_ne_zero).mp hZ
        have hS : 2 * u₁ * u₂ * (u₁ * v₂ + u₂ * v₁) + W.b₂ * u₁ * u₂ * v₁ * v₂
            + W.b₄ * (u₁ * v₂ + u₂ * v₁) * v₁ * v₂ + W.b₆ * v₁ ^ 2 * v₂ ^ 2 = 0 := by
          linear_combination hX + x * hZ
        have hK : (m + 1) • WeierstrassCurve.Affine.Point.some h₀ ≠
            m • WeierstrassCurve.Affine.Point.some h₀ := by
          intro h
          rw [succ_nsmul] at h
          exact WeierstrassCurve.Affine.Point.some_ne_zero h₀
            (add_left_cancel (h.trans (add_zero _).symm))
        rcases pt ((m + 1) • WeierstrassCurve.Affine.Point.some h₀) with hR | ⟨xR, yR, hRn, hR⟩ <;>
          rcases pt (m • WeierstrassCurve.Affine.Point.some h₀) with hS0 | ⟨xS, yS, hSn, hSe⟩
        · exact hK (hR.trans hS0.symm)
        · have e1 := hz₁ hR
          have e2 := hs₂ hSn hSe
          by_cases hv₂ : v₂ = 0
          · exact ih2 ⟨by rw [e2, hv₂, mul_zero], hv₂⟩
          · have h' : u₁ * v₂ = 0 := by rw [e1] at hw; linear_combination hw
            exact ih1 ⟨(mul_eq_zero.mp h').resolve_right hv₂, e1⟩
        · have e1 := hs₁ hRn hR
          have e2 := hz₂ hS0
          by_cases hv₁ : v₁ = 0
          · exact ih1 ⟨by rw [e1, hv₁, mul_zero], hv₁⟩
          · have h' : u₂ * v₁ = 0 := by rw [e2] at hw; linear_combination -hw
            exact ih2 ⟨(mul_eq_zero.mp h').resolve_right hv₁, e2⟩
        · have e1 := hs₁ hRn hR
          have e2 := hs₂ hSn hSe
          by_cases hv₁ : v₁ = 0
          · exact ih1 ⟨by rw [e1, hv₁, mul_zero], hv₁⟩
          by_cases hv₂ : v₂ = 0
          · exact ih2 ⟨by rw [e2, hv₂, mul_zero], hv₂⟩
          have hx : xR = xS := by
            have h' : v₁ * v₂ * (xR - xS) = 0 := by
              rw [e1, e2] at hw; linear_combination hw
            exact sub_eq_zero.mp ((mul_eq_zero.mp h').resolve_left (mul_ne_zero hv₁ hv₂))
          subst hx
          have hBx : v₁ ^ 2 * v₂ ^ 2 * (4 * xR ^ 3 + W.b₂ * xR ^ 2 + 2 * W.b₄ * xR + W.b₆) = 0 := by
            rw [e1, e2] at hS; linear_combination hS
          have hB : 4 * xR ^ 3 + W.b₂ * xR ^ 2 + 2 * W.b₄ * xR + W.b₆ = 0 :=
            (mul_eq_zero.mp hBx).resolve_left (mul_ne_zero (pow_ne_zero 2 hv₁) (pow_ne_zero 2 hv₂))
          have hER := (WeierstrassCurve.Affine.equation_iff xR yR).mp hRn.1
          have hES := (WeierstrassCurve.Affine.equation_iff xR yS).mp hSn.1
          simp only [WeierstrassCurve.b₂, WeierstrassCurve.b₄, WeierstrassCurve.b₆] at hB
          have hd2 : (2 * yR + W.a₁ * xR + W.a₃) ^ 2 = 0 := by linear_combination hB + 4 * hER
          have hd : 2 * yR + W.a₁ * xR + W.a₃ = 0 := (pow_eq_zero_iff two_ne_zero).mp hd2
          have hy2 : (yS - yR) ^ 2 = 0 := by linear_combination hES - hER - (yS - yR) * hd
          have hy : yS = yR := sub_eq_zero.mp ((pow_eq_zero_iff two_ne_zero).mp hy2)
          subst hy
          exact hK (hR.trans hSe.symm)
  exact main n x hn

theorem card_nsmul_eq_zero_of_xz_polys {K : Type*} [Field K] [IsAlgClosed K] [CharZero K]
    [DecidableEq K] (W : WeierstrassCurve K) (hΔ : W.Δ ≠ 0) (n : ℕ) (hn : 0 < n)
    (Xp Zp : Polynomial K) (hXd : Xp.natDegree = n ^ 2) (hXl : Xp.leadingCoeff = 1)
    (hZ0 : Zp ≠ 0) (hZd : Zp.natDegree < n ^ 2)
    (hzero : ∀ {x y : K} (h : W.toAffine.Nonsingular x y),
      n • WeierstrassCurve.Affine.Point.some h = 0 → Zp.eval x = 0)
    (hsome : ∀ {x y x' y' : K} (h : W.toAffine.Nonsingular x y) (h' : W.toAffine.Nonsingular x' y'),
      n • WeierstrassCurve.Affine.Point.some h = WeierstrassCurve.Affine.Point.some h' →
        Xp.eval x = x' * Zp.eval x)
    (hcop : ∀ x : K, ¬ (Xp.eval x = 0 ∧ Zp.eval x = 0)) :
    Nat.card {P : W.toAffine.Point // n • P = 0} = n ^ 2 :=
by
  
  have s1 : ∀ x : K, ∃ y : K, W.toAffine.Nonsingular x y := by
    intro x
    obtain ⟨s, hs⟩ := IsAlgClosed.exists_eq_mul_self
      (discrim (1:K) (W.a₁ * x + W.a₃) (-(x^3 + W.a₂*x^2 + W.a₄*x + W.a₆)))
    obtain ⟨y, hy⟩ := exists_quadratic_eq_zero (one_ne_zero) ⟨s, hs⟩
    refine ⟨y, (WeierstrassCurve.Affine.equation_iff_nonsingular_of_Δ_ne_zero hΔ).mp ?_⟩
    rw [WeierstrassCurve.Affine.equation_iff]
    linear_combination hy
  
  have s3 : ∀ {t y : K} (h : W.toAffine.Nonsingular t y),
      4 * t ^ 3 + W.b₂ * t ^ 2 + 2 * W.b₄ * t + W.b₆ ≠ 0 →
      WeierstrassCurve.Affine.Point.some h ≠ -WeierstrassCurve.Affine.Point.some h := by
    intro t y h h2 heq
    rw [WeierstrassCurve.Affine.Point.neg_some] at heq
    simp only [WeierstrassCurve.Affine.Point.some.injEq, true_and] at heq
    have hE := (WeierstrassCurve.Affine.equation_iff _ _).mp h.1
    rw [WeierstrassCurve.Affine.negY] at heq
    apply h2
    simp only [WeierstrassCurve.b₂, WeierstrassCurve.b₄, WeierstrassCurve.b₆]
    linear_combination (2 * y + W.a₁ * t + W.a₃) * heq - 4 * hE
  
  have s5 : ∀ (Q P₀ : W.toAffine.Point), n • P₀ = Q →
      Nat.card {P : W.toAffine.Point // n • P = 0} =
        Nat.card {P : W.toAffine.Point // n • P = Q} := by
    intro Q P₀ hP₀
    exact Nat.card_congr
      { toFun := fun P => ⟨P.1 + P₀, by rw [smul_add, P.2, hP₀, zero_add]⟩
        invFun := fun P => ⟨P.1 - P₀, by rw [smul_sub, P.2, hP₀, sub_self]⟩
        left_inv := fun P => Subtype.ext (add_sub_cancel_right _ _)
        right_inv := fun P => Subtype.ext (sub_add_cancel _ _) }
  
  have s2 : ∀ B : Finset K, ∃ t : K, t ∉ B ∧
      (Xp - Polynomial.C t * Zp).roots.toFinset.card = Xp.natDegree := by
    intro B
    have hXd' : 0 < Xp.natDegree := by rw [hXd]; exact pow_pos hn 2
    have hZd' : Zp.natDegree < Xp.natDegree := by rw [hXd]; exact hZd
    haveI := CharZero.infinite K
    have coprime_crit : ∀ p q : Polynomial K, (∀ a : K, ¬ (p.eval a = 0 ∧ q.eval a = 0)) →
        IsCoprime p q := by
      intro p q h
      rw [Polynomial.isCoprime_iff_aeval_ne_zero_of_isAlgClosed K K]
      intro a
      simp only [Polynomial.coe_aeval_eq_eval]
      exact not_and_or.mp (h a)
    have hcp : IsCoprime Xp Zp := coprime_crit _ _ hcop
    set Wr := Polynomial.derivative Xp * Zp - Xp * Polynomial.derivative Zp with hWr
    have hWr0 : Wr ≠ 0 := by
      intro h0
      have hdvd : Xp ∣ Polynomial.derivative Xp * Zp := by
        have : Polynomial.derivative Xp * Zp = Xp * Polynomial.derivative Zp :=
          sub_eq_zero.mp h0
        rw [this]; exact dvd_mul_right _ _
      have hdvd' : Xp ∣ Polynomial.derivative Xp := hcp.dvd_of_dvd_mul_right hdvd
      have hd0 : Polynomial.derivative Xp ≠ 0 := by
        intro hd
        have := Polynomial.natDegree_eq_zero_of_derivative_eq_zero hd
        omega
      have h1 := Polynomial.natDegree_le_of_dvd hdvd' hd0
      have h2 := Polynomial.natDegree_derivative_lt (p := Xp) (by omega)
      omega
    obtain ⟨t, ht⟩ := Infinite.exists_notMem_finset
      (B ∪ Wr.roots.toFinset.image (fun r => Xp.eval r / Zp.eval r))
    rw [Finset.mem_union, not_or] at ht
    refine ⟨t, ht.1, ?_⟩
    have hdeg : (Xp - Polynomial.C t * Zp).natDegree = Xp.natDegree := by
      apply Polynomial.natDegree_sub_eq_left_of_natDegree_lt
      exact lt_of_le_of_lt (Polynomial.natDegree_C_mul_le _ _) hZd'
    have hsep : (Xp - Polynomial.C t * Zp).Separable := by
      apply coprime_crit
      rintro a ⟨ha1, ha2⟩
      have hder : Polynomial.derivative (Xp - Polynomial.C t * Zp) =
          Polynomial.derivative Xp - Polynomial.C t * Polynomial.derivative Zp := by
        simp [Polynomial.derivative_mul]
      rw [hder] at ha2
      simp only [Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_C] at ha1 ha2
      have e1 : Xp.eval a = t * Zp.eval a := sub_eq_zero.mp ha1
      have e2 : (Polynomial.derivative Xp).eval a = t * (Polynomial.derivative Zp).eval a :=
        sub_eq_zero.mp ha2
      have hZa : Zp.eval a ≠ 0 := by
        intro hz
        apply hcop a
        refine ⟨?_, hz⟩
        rw [e1, hz, mul_zero]
      apply ht.2
      rw [Finset.mem_image]
      refine ⟨a, ?_, ?_⟩
      · rw [Multiset.mem_toFinset, Polynomial.mem_roots hWr0, Polynomial.IsRoot.def, hWr]
        simp only [Polynomial.eval_sub, Polynomial.eval_mul]
        rw [e1, e2]; ring
      · rw [div_eq_iff hZa]; exact e1
    rw [Multiset.toFinset_card_of_nodup (Polynomial.nodup_roots hsep),
      IsAlgClosed.card_roots_eq_natDegree, hdeg]
  
  have s4 : ∀ {t yQ : K} (hQ : W.toAffine.Nonsingular t yQ),
      WeierstrassCurve.Affine.Point.some hQ ≠ -WeierstrassCurve.Affine.Point.some hQ →
      Xp - Polynomial.C t * Zp ≠ 0 →
      Nat.card {P : W.toAffine.Point // n • P = WeierstrassCurve.Affine.Point.some hQ} =
        (Xp - Polynomial.C t * Zp).roots.toFinset.card := by
    intro t yQ hQ hQneg hg
    set R := (Xp - Polynomial.C t * Zp).roots.toFinset with hR
    have memR : ∀ r, r ∈ R ↔ Xp.eval r = t * Zp.eval r := by
      intro r
      rw [hR, Multiset.mem_toFinset, Polynomial.mem_roots hg, Polynomial.IsRoot.def,
        Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_C, sub_eq_zero]
    have hZr : ∀ r, r ∈ R → Zp.eval r ≠ 0 := by
      intro r hr hz
      rw [memR, hz, mul_zero] at hr
      exact hcop r ⟨hr, hz⟩
    have hQ0 : ∀ P : W.toAffine.Point, n • P = WeierstrassCurve.Affine.Point.some hQ →
        P ≠ 0 := by
      rintro P hP rfl
      rw [smul_zero] at hP
      cases hP
    let xc : W.toAffine.Point → K := fun P => match P with
      | .zero => 0
      | .some (x := x) _ => x
    have into : ∀ P : {P : W.toAffine.Point // n • P = WeierstrassCurve.Affine.Point.some hQ},
        xc P.1 ∈ R := by
      rintro ⟨P, hP⟩
      cases P with
      | zero => exact absurd rfl (hQ0 _ hP)
      | some h => exact (memR _).mpr (hsome h hQ hP)
    let φ : {P : W.toAffine.Point // n • P = WeierstrassCurve.Affine.Point.some hQ} → R :=
      fun P => ⟨xc P.1, into P⟩
    have inj : Function.Injective φ := by
      rintro ⟨P₁, h₁⟩ ⟨P₂, h₂⟩ heq
      have heq' : xc P₁ = xc P₂ := congrArg Subtype.val heq
      cases P₁ with
      | zero => exact absurd rfl (hQ0 _ h₁)
      | @some x₁ y₁ hP₁ =>
        cases P₂ with
        | zero => exact absurd rfl (hQ0 _ h₂)
        | @some x₂ y₂ hP₂ =>
          change x₁ = x₂ at heq'
          subst heq'
          rcases WeierstrassCurve.Affine.Y_eq_of_X_eq hP₁.1 hP₂.1 rfl with hy | hy
          · subst hy; rfl
          · exfalso
            subst hy
            have hneg : WeierstrassCurve.Affine.Point.some hP₁ =
                -WeierstrassCurve.Affine.Point.some hP₂ := by
              rw [WeierstrassCurve.Affine.Point.neg_some]
            rw [hneg, smul_neg, h₂] at h₁
            exact hQneg h₁.symm
    have surj : Function.Surjective φ := by
      rintro ⟨r, hr⟩
      obtain ⟨yr, hr'⟩ := s1 r
      have hne : n • WeierstrassCurve.Affine.Point.some hr' ≠ 0 :=
        fun h => hZr r hr (hzero hr' h)
      obtain ⟨x', y', h', hnP⟩ : ∃ (x' y' : K) (h' : W.toAffine.Nonsingular x' y'),
          n • WeierstrassCurve.Affine.Point.some hr' = WeierstrassCurve.Affine.Point.some h' := by
        revert hne
        generalize n • WeierstrassCurve.Affine.Point.some hr' = T
        intro hne
        cases T with
        | zero => exact absurd rfl hne
        | @some x' y' h' => exact ⟨x', y', h', rfl⟩
      have hx' : x' = t := by
        have e := hsome hr' h' hnP
        have e2 := (memR r).mp hr
        exact mul_right_cancel₀ (hZr r hr) (e.symm.trans e2)
      subst hx'
      rcases WeierstrassCurve.Affine.Y_eq_of_X_eq h'.1 hQ.1 rfl with hy' | hy'
      · subst hy'
        exact ⟨⟨WeierstrassCurve.Affine.Point.some hr', hnP⟩, rfl⟩
      · subst hy'
        have hneg : WeierstrassCurve.Affine.Point.some h' =
            -WeierstrassCurve.Affine.Point.some hQ := by
          rw [WeierstrassCurve.Affine.Point.neg_some]
        refine ⟨⟨-WeierstrassCurve.Affine.Point.some hr', ?_⟩, ?_⟩
        · rw [smul_neg, hnP, hneg, neg_neg]
        · apply Subtype.ext
          change xc (-WeierstrassCurve.Affine.Point.some hr') = r
          rw [WeierstrassCurve.Affine.Point.neg_some]
    rw [Nat.card_eq_of_bijective φ ⟨inj, surj⟩, Nat.card_eq_finsetCard]
  
  have hN : 0 < n ^ 2 := pow_pos hn 2
  set T₂ : Polynomial K := Polynomial.C 4 * Polynomial.X ^ 3 + Polynomial.C W.b₂ * Polynomial.X ^ 2
    + Polynomial.C (2 * W.b₄) * Polynomial.X + Polynomial.C W.b₆ with hT₂def
  have hT₂ : T₂ ≠ 0 := by
    intro h
    have h3 := congrArg (fun p => p.coeff 3) h
    simp [hT₂def, Polynomial.coeff_X, Polynomial.coeff_C, Polynomial.coeff_X_pow] at h3
  obtain ⟨t, htB, hcard⟩ := s2 T₂.roots.toFinset
  have hTt : 4 * t ^ 3 + W.b₂ * t ^ 2 + 2 * W.b₄ * t + W.b₆ ≠ 0 := by
    intro h
    apply htB
    rw [Multiset.mem_toFinset, Polynomial.mem_roots hT₂, Polynomial.IsRoot.def]
    simp only [hT₂def, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
      Polynomial.eval_pow, Polynomial.eval_X]
    linear_combination h
  have hg : Xp - Polynomial.C t * Zp ≠ 0 := by
    intro h
    rw [h, Polynomial.roots_zero, Multiset.toFinset_zero, Finset.card_empty] at hcard
    omega
  obtain ⟨yQ, hQ⟩ := s1 t
  have hfib := s4 hQ (s3 hQ hTt) hg
  rw [hcard, hXd] at hfib
  have hpos : 0 < Nat.card {P : W.toAffine.Point // n • P = WeierstrassCurve.Affine.Point.some hQ} := by
    rw [hfib]; exact hN
  obtain ⟨⟨P₀, hP₀⟩⟩ := (Nat.card_pos_iff.mp hpos).1
  rw [s5 _ P₀ hP₀, hfib]

theorem finrank_vBar_eq_two (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] (E : WeierstrassCurve F) (hΔ : E.Δ ≠ 0) :
    Module.finrank (EllipticRootNumber.Ω F) (EllipticRootNumber.VBar F E) = 2 :=
by
  classical
  
  haveI : CharZero (AlgebraicClosure F) :=
    charZero_of_injective_algebraMap (algebraMap F (AlgebraicClosure F)).injective
  have hΔK : (E.baseChange (AlgebraicClosure F)).Δ ≠ 0 := by
    show (E.map (algebraMap F (AlgebraicClosure F))).Δ ≠ 0
    rw [WeierstrassCurve.map_Δ]
    intro h
    exact hΔ ((algebraMap F (AlgebraicClosure F)).injective (h.trans (map_zero _).symm))
  
  have s2 : ∀ m : ℕ, 0 < m →
      Nat.card {P : (E.baseChange (AlgebraicClosure F)).toAffine.Point // m • P = 0} = m ^ 2 := by
    intro m hm
    obtain ⟨hXd, hXl, hZd, hZl⟩ := ladderXZ_degree (E.baseChange (AlgebraicClosure F)) m hm
    have hZ0 : (ladderXZ (E.baseChange (AlgebraicClosure F)) m).2 ≠ 0 := by
      intro h
      rw [h, Polynomial.leadingCoeff_zero] at hZl
      exact pow_ne_zero 2 (Nat.cast_ne_zero.mpr hm.ne') hZl.symm
    have hZlt : (ladderXZ (E.baseChange (AlgebraicClosure F)) m).2.natDegree < m ^ 2 := by
      have : 0 < m ^ 2 := pow_pos hm 2
      omega
    exact card_nsmul_eq_zero_of_xz_polys (E.baseChange (AlgebraicClosure F)) hΔK m hm _ _
      hXd hXl hZ0 hZlt
      (fun h hP => (ladderXZ_eval_nsmul (E.baseChange (AlgebraicClosure F)) m hm h).1 hP)
      (fun h h' hP => (ladderXZ_eval_nsmul (E.baseChange (AlgebraicClosure F)) m hm h).2 h' hP)
      (ladderXZ_no_common_root (E.baseChange (AlgebraicClosure F)) hΔK m hm)
  
  refine finrank_vBar_of_card_torsion F E hΔ (fun k => ?_)
  have hpos : 0 < EllipticRootNumber.ell F ^ (k + 1) :=
    pow_pos (EllipticRootNumber.ell_prime F).out.pos _
  have h := s2 _ hpos
  calc Nat.card (EllipticRootNumber.torsion F E (EllipticRootNumber.ell F ^ (k + 1)))
      = Nat.card {P : (E.baseChange (AlgebraicClosure F)).toAffine.Point //
          EllipticRootNumber.ell F ^ (k + 1) • P = 0} := rfl
    _ = (EllipticRootNumber.ell F ^ (k + 1)) ^ 2 := h
    _ = EllipticRootNumber.ell F ^ (2 * (k + 1)) := by ring

theorem coordRing_exists_ordInfty {K : Type*} [Field K] (W : WeierstrassCurve K) :
    ∃ v : FractionRing W.toAffine.CoordinateRing → ℤ,
      (∀ f g : FractionRing W.toAffine.CoordinateRing, f ≠ 0 → g ≠ 0 → v (f * g) = v f + v g) ∧
      (∀ f g : FractionRing W.toAffine.CoordinateRing, f ≠ 0 → g ≠ 0 → f + g ≠ 0 →
        min (v f) (v g) ≤ v (f + g)) ∧
      (∀ c : K, c ≠ 0 → v (algebraMap K (FractionRing W.toAffine.CoordinateRing) (c)) = 0) ∧
      (∀ a : W.toAffine.CoordinateRing, a ≠ 0 →
        v (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (a)) = -((Algebra.norm (Polynomial K) (a)).natDegree : ℤ)) ∧
      (∀ f : FractionRing W.toAffine.CoordinateRing, f ≠ 0 → 0 ≤ v f → ∃ c : K,
        f = algebraMap K (FractionRing W.toAffine.CoordinateRing) (c) ∨
        (f - algebraMap K (FractionRing W.toAffine.CoordinateRing) (c) ≠ 0 ∧ 1 ≤ v (f - algebraMap K (FractionRing W.toAffine.CoordinateRing) (c)))) :=
by
  classical
  obtain ⟨w, hw⟩ : ∃ w : W.toAffine.CoordinateRing → ℕ,
      ∀ a, w a = (Algebra.norm (Polynomial K) a).natDegree := ⟨_, fun _ => rfl⟩
  
  have s2 : ∀ p q : Polynomial K,
      (q = 0 → w (p • (1 : W.toAffine.CoordinateRing) +
        q • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X) =
          2 * p.natDegree) ∧
      (q ≠ 0 → w (p • (1 : W.toAffine.CoordinateRing) +
        q • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X) =
          max (2 * p.natDegree) (2 * q.natDegree + 3)) := by
    intro p q
    simp only [hw]
    have h := WeierstrassCurve.Affine.CoordinateRing.degree_norm_smul_basis (W' := W.toAffine) p q
    constructor
    · intro hq
      subst hq
      rw [Polynomial.degree_zero] at h
      have h2 : (2 • (⊥ : WithBot ℕ) + 3) = ⊥ := rfl
      rw [h2, max_bot_right, ← Polynomial.degree_pow] at h
      rw [Polynomial.natDegree_eq_of_degree_eq h, Polynomial.natDegree_pow]
    · intro hq
      rw [Polynomial.degree_eq_natDegree hq] at h
      apply Polynomial.natDegree_eq_of_degree_eq_some
      rw [h]
      by_cases hp : p = 0
      · subst hp
        rw [Polynomial.degree_zero]
        have h2 : (2 • (⊥ : WithBot ℕ)) = ⊥ := rfl
        rw [h2, max_bot_left, Polynomial.natDegree_zero]
        simp
      · rw [Polynomial.degree_eq_natDegree hp]
        norm_cast
  
  have s3 : ∀ a : W.toAffine.CoordinateRing, a ≠ 0 → Algebra.norm (Polynomial K) a ≠ 0 := by
    intro a ha
    obtain ⟨p, q, rfl⟩ := WeierstrassCurve.Affine.CoordinateRing.exists_smul_basis_eq a
    intro h0
    have h := WeierstrassCurve.Affine.CoordinateRing.degree_norm_smul_basis (W' := W.toAffine) p q
    rw [h0, Polynomial.degree_zero] at h
    have h1 := h.symm
    rw [max_eq_bot] at h1
    obtain ⟨h1, h2⟩ := h1
    rw [two_nsmul, WithBot.add_eq_bot, or_self, Polynomial.degree_eq_bot] at h1
    rw [WithBot.add_eq_bot, two_nsmul, WithBot.add_eq_bot, or_self, Polynomial.degree_eq_bot] at h2
    rcases h2 with h2 | h2
    · apply ha; rw [h1, h2, zero_smul, zero_smul, add_zero]
    · exact absurd h2 (by decide)
  
  have hmul : ∀ a b : W.toAffine.CoordinateRing, a ≠ 0 → b ≠ 0 → w (a * b) = w a + w b := by
    intro a b ha hb
    rw [hw, hw, hw, map_mul, Polynomial.natDegree_mul (s3 a ha) (s3 b hb)]
  
  have wlow : ∀ p q : Polynomial K,
      2 * p.natDegree ≤ w (p • (1 : W.toAffine.CoordinateRing) +
        q • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X) ∧
      (q ≠ 0 → 2 * q.natDegree + 3 ≤ w (p • (1 : W.toAffine.CoordinateRing) +
        q • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)) := by
    intro p q
    by_cases hq : q = 0
    · rw [(s2 p q).1 hq]; exact ⟨le_rfl, fun h => absurd hq h⟩
    · rw [(s2 p q).2 hq]; exact ⟨le_max_left _ _, fun _ => le_max_right _ _⟩
  
  have hadd : ∀ a b : W.toAffine.CoordinateRing, w (a + b) ≤ max (w a) (w b) := by
    intro a b
    obtain ⟨p, q, rfl⟩ := WeierstrassCurve.Affine.CoordinateRing.exists_smul_basis_eq a
    obtain ⟨p', q', rfl⟩ := WeierstrassCurve.Affine.CoordinateRing.exists_smul_basis_eq b
    have e : p • (1 : W.toAffine.CoordinateRing) +
        q • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X +
        (p' • (1 : W.toAffine.CoordinateRing) +
          q' • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X) =
        (p + p') • (1 : W.toAffine.CoordinateRing) +
          (q + q') • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X := by
      rw [add_smul, add_smul]; abel
    rw [e]
    obtain ⟨ha1, ha2⟩ := wlow p q
    obtain ⟨hb1, hb2⟩ := wlow p' q'
    have hpp := Polynomial.natDegree_add_le p p'
    have hqq := Polynomial.natDegree_add_le q q'
    by_cases hQ : q + q' = 0
    · rw [(s2 _ _).1 hQ]; omega
    · rw [(s2 _ _).2 hQ]
      by_cases hq : q = 0
      · have hq' : q' ≠ 0 := by intro h; exact hQ (by rw [hq, h, add_zero])
        have h3 := hb2 hq'
        have h4 : (q + q').natDegree = q'.natDegree := by rw [hq, zero_add]
        omega
      · by_cases hq' : q' = 0
        · have h3 := ha2 hq
          have h4 : (q + q').natDegree = q.natDegree := by rw [hq', add_zero]
          omega
        · have h3 := ha2 hq
          have h4 := hb2 hq'
          omega
  
  have cancel : ∀ f g : Polynomial K, f ≠ 0 → g ≠ 0 → f.natDegree = g.natDegree →
      f - Polynomial.C (f.leadingCoeff / g.leadingCoeff) * g = 0 ∨
      (f - Polynomial.C (f.leadingCoeff / g.leadingCoeff) * g).natDegree < f.natDegree := by
    intro f g hf hg hfg
    have hlf : f.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hf
    have hlg : g.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hg
    have hc : f.leadingCoeff / g.leadingCoeff ≠ 0 := div_ne_zero hlf hlg
    by_cases h0 : f - Polynomial.C (f.leadingCoeff / g.leadingCoeff) * g = 0
    · exact Or.inl h0
    · right
      rw [Polynomial.natDegree_lt_iff_degree_lt h0, ← Polynomial.degree_eq_natDegree hf]
      apply Polynomial.degree_sub_lt
      · rw [Polynomial.degree_C_mul hc, Polynomial.degree_eq_natDegree hf,
          Polynomial.degree_eq_natDegree hg, hfg]
      · exact hf
      · rw [Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C, div_mul_cancel₀ _ hlg]
  have bound : ∀ (f g : Polynomial K) (c : K),
      (f - Polynomial.C c * g).natDegree ≤ max f.natDegree g.natDegree := by
    intro f g c
    exact (Polynomial.natDegree_sub_le _ _).trans (max_le_max le_rfl (Polynomial.natDegree_C_mul_le c g))
  
  have hres : ∀ a b : W.toAffine.CoordinateRing, a ≠ 0 → b ≠ 0 → w a = w b → ∃ c : K,
      a - algebraMap K W.toAffine.CoordinateRing c * b = 0 ∨
        w (a - algebraMap K W.toAffine.CoordinateRing c * b) < w b := by
    intro a b ha hb hab
    obtain ⟨p, q, rfl⟩ := WeierstrassCurve.Affine.CoordinateRing.exists_smul_basis_eq a
    obtain ⟨p', q', rfl⟩ := WeierstrassCurve.Affine.CoordinateRing.exists_smul_basis_eq b
    have hsub : ∀ c : K, p • (1 : W.toAffine.CoordinateRing) +
        q • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X -
        algebraMap K W.toAffine.CoordinateRing c * (p' • (1 : W.toAffine.CoordinateRing) +
          q' • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X) =
        (p - Polynomial.C c * p') • (1 : W.toAffine.CoordinateRing) +
          (q - Polynomial.C c * q') • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine
            Polynomial.X := by
      intro c
      have hc : algebraMap K W.toAffine.CoordinateRing c =
          algebraMap (Polynomial K) W.toAffine.CoordinateRing (Polynomial.C c) := by
        rw [IsScalarTower.algebraMap_apply K (Polynomial K) W.toAffine.CoordinateRing]
        rfl
      rw [hc, ← Algebra.smul_def, smul_add, smul_smul, smul_smul, sub_smul, sub_smul]
      abel
    have hz : ∀ P Q : Polynomial K, P = 0 → Q = 0 → P • (1 : W.toAffine.CoordinateRing) +
        Q • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X = 0 := by
      rintro P Q rfl rfl; rw [zero_smul, zero_smul, add_zero]
    have hpq : ¬ (p = 0 ∧ q = 0) := fun h => ha (hz p q h.1 h.2)
    have hpq' : ¬ (p' = 0 ∧ q' = 0) := fun h => hb (hz _ _ h.1 h.2)
    suffices h : ∃ c : K, (p - Polynomial.C c * p') • (1 : W.toAffine.CoordinateRing) +
          (q - Polynomial.C c * q') • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine
            Polynomial.X = 0 ∨
        w ((p - Polynomial.C c * p') • (1 : W.toAffine.CoordinateRing) +
          (q - Polynomial.C c * q') • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine
            Polynomial.X) <
        w (p' • (1 : W.toAffine.CoordinateRing) +
          q' • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X) by
      obtain ⟨c, hc⟩ := h
      exact ⟨c, by rw [hsub]; exact hc⟩
    obtain ⟨D, hD⟩ : ∃ D, w (p' • (1 : W.toAffine.CoordinateRing) +
        q' • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X) = D := ⟨_, rfl⟩
    rw [hD] at hab ⊢
    rcases Nat.even_or_odd D with ⟨k, hk⟩ | ⟨k, hk⟩
    · 
      have hb' : D = 2 * p'.natDegree ∧ (q' = 0 ∨ 2 * q'.natDegree + 3 < D) := by
        by_cases hq' : q' = 0
        · have h1 := (s2 p' q').1 hq'
          rw [hD] at h1
          exact ⟨h1, Or.inl hq'⟩
        · have h1 := (s2 p' q').2 hq'
          rw [hD] at h1
          refine ⟨?_, Or.inr ?_⟩
          · rcases max_cases (2 * p'.natDegree) (2 * q'.natDegree + 3) with h | h <;> omega
          · rcases max_cases (2 * p'.natDegree) (2 * q'.natDegree + 3) with h | h <;> omega
      have ha' : D = 2 * p.natDegree ∧ (q = 0 ∨ 2 * q.natDegree + 3 < D) := by
        by_cases hq : q = 0
        · have h1 := (s2 p q).1 hq
          rw [hab] at h1
          exact ⟨h1, Or.inl hq⟩
        · have h1 := (s2 p q).2 hq
          rw [hab] at h1
          refine ⟨?_, Or.inr ?_⟩
          · rcases max_cases (2 * p.natDegree) (2 * q.natDegree + 3) with h | h <;> omega
          · rcases max_cases (2 * p.natDegree) (2 * q.natDegree + 3) with h | h <;> omega
      have hp' : p' ≠ 0 := by
        intro h0
        rcases hb'.2 with h | h
        · exact hpq' ⟨h0, h⟩
        · have h1 := hb'.1
          rw [h0, Polynomial.natDegree_zero] at h1
          omega
      have hp : p ≠ 0 := by
        intro h0
        rcases ha'.2 with h | h
        · exact hpq ⟨h0, h⟩
        · have h1 := ha'.1
          rw [h0, Polynomial.natDegree_zero] at h1
          omega
      have hP := cancel p p' hp hp' (by omega)
      have hQb := bound q q' (p.leadingCoeff / p'.leadingCoeff)
      refine ⟨p.leadingCoeff / p'.leadingCoeff, ?_⟩
      generalize p - Polynomial.C (p.leadingCoeff / p'.leadingCoeff) * p' = P at hP ⊢
      generalize hQdef : q - Polynomial.C (p.leadingCoeff / p'.leadingCoeff) * q' = Q at hQb ⊢
      by_cases hd0 : p.natDegree = 0
      · left
        have hq0 : q = 0 := by
          rcases ha'.2 with h | h
          · exact h
          · omega
        have hq0' : q' = 0 := by
          rcases hb'.2 with h | h
          · exact h
          · omega
        have hQ0 : Q = 0 := by rw [← hQdef, hq0, hq0', mul_zero, sub_zero]
        have hP0 : P = 0 := by
          rcases hP with h | h
          · exact h
          · omega
        rw [hP0, hQ0, zero_smul, zero_smul, add_zero]
      · right
        have hPd : 2 * P.natDegree < D := by
          rcases hP with h | h
          · rw [h, Polynomial.natDegree_zero]; omega
          · omega
        by_cases hQ : Q = 0
        · rw [(s2 P Q).1 hQ]; exact hPd
        · rw [(s2 P Q).2 hQ]
          have hQd : 2 * Q.natDegree + 3 < D := by
            by_cases hq0 : q = 0
            · by_cases hq0' : q' = 0
              · exact absurd (by rw [← hQdef, hq0, hq0', mul_zero, sub_zero]) hQ
              · have h1 : 2 * q'.natDegree + 3 < D := hb'.2.resolve_left hq0'
                rw [hq0, Polynomial.natDegree_zero] at hQb
                omega
            · have h1 := ha'.2.resolve_left hq0
              by_cases hq0' : q' = 0
              · rw [hq0', Polynomial.natDegree_zero] at hQb
                omega
              · have h2 := hb'.2.resolve_left hq0'
                omega
          exact max_lt hPd hQd
    · 
      have hq' : q' ≠ 0 := by
        intro h0
        have h1 := (s2 p' q').1 h0
        rw [hD] at h1
        omega
      have hq : q ≠ 0 := by
        intro h0
        have h1 := (s2 p q).1 h0
        rw [hab] at h1
        omega
      have hb2 := (s2 p' q').2 hq'
      rw [hD] at hb2
      have ha2 := (s2 p q).2 hq
      rw [hab] at ha2
      have e1 : D = 2 * q'.natDegree + 3 ∧ 2 * p'.natDegree < D := by
        rcases max_cases (2 * p'.natDegree) (2 * q'.natDegree + 3) with h | h <;> omega
      have e2 : D = 2 * q.natDegree + 3 ∧ 2 * p.natDegree < D := by
        rcases max_cases (2 * p.natDegree) (2 * q.natDegree + 3) with h | h <;> omega
      have hQ := cancel q q' hq hq' (by omega)
      have hPb := bound p p' (q.leadingCoeff / q'.leadingCoeff)
      refine ⟨q.leadingCoeff / q'.leadingCoeff, Or.inr ?_⟩
      generalize p - Polynomial.C (q.leadingCoeff / q'.leadingCoeff) * p' = P at hPb ⊢
      generalize q - Polynomial.C (q.leadingCoeff / q'.leadingCoeff) * q' = Q at hQ ⊢
      have hPd : 2 * P.natDegree < D := by
        rcases max_cases p.natDegree p'.natDegree with h | h <;> omega
      by_cases hQ0 : Q = 0
      · rw [(s2 P Q).1 hQ0]; exact hPd
      · rw [(s2 P Q).2 hQ0]
        have hQd : 2 * Q.natDegree + 3 < D := by
          rcases hQ with h | h
          · exact absurd h hQ0
          · omega
        exact max_lt hPd hQd
  
  have hinj := IsFractionRing.injective W.toAffine.CoordinateRing
    (FractionRing W.toAffine.CoordinateRing)
  have hι0 : ∀ a : W.toAffine.CoordinateRing, a ≠ 0 →
      algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) a ≠ 0 :=
    fun a ha h => ha (hinj (h.trans (map_zero _).symm))
  choose n d hd hnd using fun f : FractionRing W.toAffine.CoordinateRing =>
    IsFractionRing.div_surjective (A := W.toAffine.CoordinateRing) f
  have hd0 : ∀ f, d f ≠ 0 := fun f => nonZeroDivisors.ne_zero (hd f)
  have hn : ∀ f, f ≠ 0 → n f ≠ 0 := by
    intro f hf h
    apply hf
    rw [← hnd f, h, map_zero, zero_div]
  have w1 : w 1 = 0 := by rw [hw, map_one, Polynomial.natDegree_one]
  have K1 : ∀ (f : FractionRing W.toAffine.CoordinateRing) (a b : W.toAffine.CoordinateRing),
      a ≠ 0 → b ≠ 0 →
      f = algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) a /
        algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) b →
      ((w (d f) : ℤ) - w (n f)) = (w b : ℤ) - w a := by
    intro f a b ha hb hf
    have e := (hnd f).trans hf
    rw [div_eq_div_iff (hι0 _ (hd0 f)) (hι0 _ hb), ← map_mul, ← map_mul] at e
    have e2 := hinj e
    have hnf : n f ≠ 0 := by
      intro h
      rw [h, zero_mul] at e2
      exact mul_ne_zero ha (hd0 f) e2.symm
    have h3 := congrArg w e2
    rw [hmul _ _ hnf hb, hmul _ _ ha (hd0 f)] at h3
    omega
  refine ⟨fun f => (w (d f) : ℤ) - w (n f), ?_, ?_, ?_, ?_, ?_⟩
  · 
    intro f g hf hg
    dsimp only
    rw [K1 (f * g) (n f * n g) (d f * d g) (mul_ne_zero (hn f hf) (hn g hg))
      (mul_ne_zero (hd0 f) (hd0 g)) (by rw [map_mul, map_mul, ← div_mul_div_comm, hnd, hnd]),
      hmul _ _ (hn f hf) (hn g hg), hmul _ _ (hd0 f) (hd0 g)]
    push_cast
    ring
  · 
    intro f g hf hg hfg
    dsimp only
    have ef : f + g =
        algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
          (n f * d g + d f * n g) /
        algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
          (d f * d g) := by
      rw [map_add, map_mul, map_mul, map_mul, ← div_add_div _ _ (hι0 _ (hd0 f)) (hι0 _ (hd0 g)),
        hnd, hnd]
    have hnum : n f * d g + d f * n g ≠ 0 := by
      intro h
      apply hfg
      rw [ef, h, map_zero, zero_div]
    rw [K1 (f + g) _ (d f * d g) hnum (mul_ne_zero (hd0 f) (hd0 g)) ef]
    have h1 := hadd (n f * d g) (d f * n g)
    rw [hmul _ _ (hn f hf) (hd0 g), hmul _ _ (hd0 f) (hn g hg)] at h1
    rw [hmul _ _ (hd0 f) (hd0 g)]
    rcases max_cases (w (n f) + w (d g)) (w (d f) + w (n g)) with h | h <;>
      rcases min_cases ((w (d f) : ℤ) - w (n f)) ((w (d g) : ℤ) - w (n g)) with h' | h' <;>
      omega
  · 
    intro c hc
    dsimp only
    have hc' : algebraMap K W.toAffine.CoordinateRing c ≠ 0 :=
      (map_ne_zero (algebraMap K W.toAffine.CoordinateRing)).mpr hc
    have hc'' : algebraMap K W.toAffine.CoordinateRing c⁻¹ ≠ 0 :=
      (map_ne_zero (algebraMap K W.toAffine.CoordinateRing)).mpr (inv_ne_zero hc)
    have wc : w (algebraMap K W.toAffine.CoordinateRing c) = 0 := by
      have h1 := hmul _ _ hc' hc''
      rw [← map_mul, mul_inv_cancel₀ hc, map_one, w1] at h1
      omega
    rw [IsScalarTower.algebraMap_apply K W.toAffine.CoordinateRing
      (FractionRing W.toAffine.CoordinateRing) c,
      K1 _ _ 1 hc' one_ne_zero (by rw [map_one, div_one]), w1, wc]
    simp
  · 
    intro a ha
    dsimp only
    rw [K1 _ a 1 ha one_ne_zero (by rw [map_one, div_one]), w1, hw]
    simp
  · 
    intro f hf hv
    dsimp only at hv ⊢
    have hnf := hn f hf
    have hdf := hd0 f
    rcases lt_or_eq_of_le (show w (n f) ≤ w (d f) by omega) with hlt | heq
    · refine ⟨0, Or.inr ⟨by rw [map_zero, sub_zero]; exact hf, ?_⟩⟩
      rw [map_zero, sub_zero]
      omega
    · obtain ⟨c, hc⟩ := hres (n f) (d f) hnf hdf heq
      refine ⟨c, ?_⟩
      by_cases h0 : n f - algebraMap K W.toAffine.CoordinateRing c * d f = 0
      · left
        rw [← hnd f, sub_eq_zero.mp h0, map_mul, mul_div_cancel_right₀ _ (hι0 _ hdf)]
        exact (IsScalarTower.algebraMap_apply K W.toAffine.CoordinateRing
          (FractionRing W.toAffine.CoordinateRing) c).symm
      · right
        have hlt := hc.resolve_left h0
        have ef : f - algebraMap K (FractionRing W.toAffine.CoordinateRing) c =
            algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
              (n f - algebraMap K W.toAffine.CoordinateRing c * d f) /
            algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
              (d f) := by
          rw [map_sub, map_mul, sub_div, mul_div_cancel_right₀ _ (hι0 _ hdf), hnd,
            ← IsScalarTower.algebraMap_apply K W.toAffine.CoordinateRing
              (FractionRing W.toAffine.CoordinateRing) c]
        refine ⟨by rw [ef]; exact div_ne_zero (hι0 _ h0) (hι0 _ hdf), ?_⟩
        rw [K1 _ _ _ h0 hdf ef]
        omega

theorem coordRing_exists_translations {K : Type*} [Field K] [IsAlgClosed K] [DecidableEq K] (W : WeierstrassCurve K) (hΔ : W.Δ ≠ 0) :
    ∃ τ : W.toAffine.Point →
        (FractionRing W.toAffine.CoordinateRing ≃ₐ[K] FractionRing W.toAffine.CoordinateRing),
      (∀ (P Q : W.toAffine.Point) (f : FractionRing W.toAffine.CoordinateRing),
        τ P (τ Q f) = τ (P + Q) f) ∧
      (∀ {x y : K} (h : W.toAffine.Nonsingular x y), ∃ ℓ : FractionRing W.toAffine.CoordinateRing,
        ((algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) - algebraMap K (FractionRing W.toAffine.CoordinateRing) (x)) * ℓ = (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)) - algebraMap K (FractionRing W.toAffine.CoordinateRing) (y) ∧
        τ (WeierstrassCurve.Affine.Point.some h) (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) =
          ℓ ^ 2 + algebraMap K (FractionRing W.toAffine.CoordinateRing) (W.a₁) * ℓ - algebraMap K (FractionRing W.toAffine.CoordinateRing) (W.a₂) - (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) - algebraMap K (FractionRing W.toAffine.CoordinateRing) (x) ∧
        τ (WeierstrassCurve.Affine.Point.some h) (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)) =
          -(ℓ * (τ (WeierstrassCurve.Affine.Point.some h) (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) - (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X)))) + (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X))) -
            algebraMap K (FractionRing W.toAffine.CoordinateRing) (W.a₁) * τ (WeierstrassCurve.Affine.Point.some h) (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) - algebraMap K (FractionRing W.toAffine.CoordinateRing) (W.a₃)) :=
by
  letI : DecidableEq (FractionRing W.toAffine.CoordinateRing) := Classical.decEq _
  
  have hc : ∀ a : K, algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
      (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C (Polynomial.C a))) =
      algebraMap K (FractionRing W.toAffine.CoordinateRing) a := fun a =>
    (IsScalarTower.algebraMap_apply K W.toAffine.CoordinateRing
      (FractionRing W.toAffine.CoordinateRing) a).symm
  
  have s5 : ∀ c : K, algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
      (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X)) ≠
        algebraMap K (FractionRing W.toAffine.CoordinateRing) c := by
    intro c h
    have e : algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
          (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X)) -
        algebraMap K (FractionRing W.toAffine.CoordinateRing) c =
        algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
          (WeierstrassCurve.Affine.CoordinateRing.XClass W.toAffine c) := by
      rw [IsScalarTower.algebraMap_apply K W.toAffine.CoordinateRing
        (FractionRing W.toAffine.CoordinateRing), ← map_sub]
      congr 1
      show _ = WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine
        (Polynomial.C (Polynomial.X - Polynomial.C c))
      rw [map_sub, map_sub]
      rfl
    rw [h, sub_self] at e
    exact WeierstrassCurve.Affine.CoordinateRing.XClass_ne_zero c
      ((IsFractionRing.injective W.toAffine.CoordinateRing
        (FractionRing W.toAffine.CoordinateRing)) (e.symm.trans (map_zero _).symm))
  
  have hG : (W.baseChange (FractionRing W.toAffine.CoordinateRing)).toAffine.Nonsingular
      (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
        (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X)))
      (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
        (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)) := by
    have hΔL : (W.baseChange (FractionRing W.toAffine.CoordinateRing)).Δ ≠ 0 := by
      show (W.map (algebraMap K (FractionRing W.toAffine.CoordinateRing))).Δ ≠ 0
      rw [WeierstrassCurve.map_Δ]
      exact (map_ne_zero _).mpr hΔ
    rw [← WeierstrassCurve.Affine.equation_iff_nonsingular_of_Δ_ne_zero hΔL,
      WeierstrassCurve.Affine.equation_iff]
    have h0 : WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine W.toAffine.polynomial = 0 :=
      AdjoinRoot.mk_self
    simp only [WeierstrassCurve.Affine.polynomial, map_add, map_sub, map_mul, map_pow] at h0
    have h1 := congrArg (algebraMap W.toAffine.CoordinateRing
      (FractionRing W.toAffine.CoordinateRing)) h0
    simp only [map_add, map_sub, map_mul, map_pow, map_zero] at h1
    rw [hc, hc, hc, hc, hc] at h1
    show _ ^ 2 + algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₁ * _ * _ +
        algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₃ * _ =
      _ ^ 3 + algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₂ * _ ^ 2 +
        algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₄ * _ +
        algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₆
    linear_combination h1
  
  have s2 : ∀ x₃ y₃ : FractionRing W.toAffine.CoordinateRing,
      (W.baseChange (FractionRing W.toAffine.CoordinateRing)).toAffine.Equation x₃ y₃ →
      ∃ ψ : W.toAffine.CoordinateRing →ₐ[K] FractionRing W.toAffine.CoordinateRing,
        ψ (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X)) = x₃ ∧
        ψ (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X) = y₃ := by
    intro x₃ y₃ heq
    rw [WeierstrassCurve.Affine.equation_iff] at heq
    have heq' : y₃ ^ 2 + algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₁ * x₃ * y₃ +
        algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₃ * y₃ =
      x₃ ^ 3 + algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₂ * x₃ ^ 2 +
        algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₄ * x₃ +
        algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₆ := heq
    have hroot : Polynomial.eval₂ (↑(Polynomial.aeval (R := K) x₃)) y₃ W.toAffine.polynomial = 0 := by
      simp only [WeierstrassCurve.Affine.polynomial, Polynomial.eval₂_add, Polynomial.eval₂_sub,
        Polynomial.eval₂_mul, Polynomial.eval₂_pow, Polynomial.eval₂_X, Polynomial.eval₂_C]
      simp only [RingHom.coe_coe]
      simp only [map_add, map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
      linear_combination heq'
    refine ⟨AdjoinRoot.liftAlgHom W.toAffine.polynomial (Polynomial.aeval (R := K) x₃) y₃ hroot,
      ?_, ?_⟩
    · show AdjoinRoot.liftAlgHom W.toAffine.polynomial (Polynomial.aeval (R := K) x₃) y₃ hroot
        (AdjoinRoot.mk W.toAffine.polynomial (Polynomial.C Polynomial.X)) = x₃
      rw [AdjoinRoot.liftAlgHom_mk, Polynomial.eval₂_C]
      simp
    · show AdjoinRoot.liftAlgHom W.toAffine.polynomial (Polynomial.aeval (R := K) x₃) y₃ hroot
        (AdjoinRoot.mk W.toAffine.polynomial Polynomial.X) = y₃
      rw [AdjoinRoot.liftAlgHom_mk, Polynomial.eval₂_X]
  
  have s3 : ∀ ψ : W.toAffine.CoordinateRing →ₐ[K] FractionRing W.toAffine.CoordinateRing,
      (∀ c : K, ψ (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X)) ≠
        algebraMap K (FractionRing W.toAffine.CoordinateRing) c) → Function.Injective ψ := by
    intro ψ hx
    rw [injective_iff_map_eq_zero]
    intro a ha
    obtain ⟨p, q, rfl⟩ := WeierstrassCurve.Affine.CoordinateRing.exists_smul_basis_eq a
    have hNA := WeierstrassCurve.Affine.CoordinateRing.coe_norm_smul_basis (W' := W.toAffine) p q
    have hfst : WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine
        (Polynomial.C p + Polynomial.C q * Polynomial.X) =
        p • (1 : W.toAffine.CoordinateRing) +
          q • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X := by
      rw [WeierstrassCurve.Affine.CoordinateRing.smul, WeierstrassCurve.Affine.CoordinateRing.smul,
        mul_one, map_add, map_mul]
    have hψN : ψ (AdjoinRoot.of W.toAffine.polynomial (Algebra.norm (Polynomial K)
        (p • (1 : W.toAffine.CoordinateRing) +
          q • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X))) = 0 := by
      rw [hNA, map_mul, map_mul, hfst, ha, zero_mul]
    have haev : ∀ r : Polynomial K, ψ (AdjoinRoot.of W.toAffine.polynomial r) =
        Polynomial.aeval (ψ (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine
          (Polynomial.C Polynomial.X))) r := by
      intro r
      induction r using Polynomial.induction_on with
      | C c =>
        rw [Polynomial.aeval_C]
        exact ψ.commutes c
      | add f g hf hg => rw [map_add, map_add, hf, hg, map_add]
      | monomial n c _ =>
        simp only [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X]
        rw [show ψ (AdjoinRoot.of W.toAffine.polynomial (Polynomial.C c)) =
          algebraMap K (FractionRing W.toAffine.CoordinateRing) c from ψ.commutes c]
        rfl
    have hN0 : Algebra.norm (Polynomial K)
        (p • (1 : W.toAffine.CoordinateRing) +
          q • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X) = 0 := by
      by_contra hN
      have hint : IsIntegral K (ψ (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine
          (Polynomial.C Polynomial.X))) :=
        (isAlgebraic_iff_isIntegral).mp ⟨_, hN, by rw [← haev]; exact hψN⟩
      have hdeg := IsAlgClosed.degree_eq_one_of_irreducible K (minpoly.irreducible hint)
      obtain ⟨c, hc'⟩ := minpoly.mem_range_of_degree_eq_one K _ hdeg
      exact hx c hc'.symm
    have hd := WeierstrassCurve.Affine.CoordinateRing.degree_norm_smul_basis (W' := W.toAffine) p q
    rw [hN0, Polynomial.degree_zero] at hd
    obtain ⟨h1, h2⟩ := max_eq_bot.mp hd.symm
    have hbot : ∀ r : Polynomial K, 2 • r.degree = ⊥ → r = 0 := by
      intro r hr
      cases hrd : r.degree with
      | bot => exact Polynomial.degree_eq_bot.mp hrd
      | coe n =>
        rw [hrd, ← WithBot.coe_nsmul] at hr
        exact absurd hr WithBot.coe_ne_bot
    have hp : p = 0 := hbot p h1
    have hq : q = 0 := by
      apply hbot q
      rcases WithBot.add_eq_bot.mp h2 with h | h
      · exact h
      · simp at h
    rw [hp, hq, zero_smul, zero_smul, add_zero]
  
  have hext : ∀ f g : FractionRing W.toAffine.CoordinateRing →ₐ[K] FractionRing W.toAffine.CoordinateRing,
      f (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
        (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) =
        g (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
        (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) →
      f (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
        (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)) =
        g (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
        (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)) → f = g := by
    intro f g hX hY
    have hCp : ∀ p : Polynomial K,
        f (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
          (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C p))) =
        g (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
          (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C p))) := by
      intro p
      induction p using Polynomial.induction_on with
      | C c => rw [hc, f.commutes, g.commutes]
      | add p₁ p₂ h₁ h₂ =>
        simp only [map_add]
        rw [h₁, h₂]
      | monomial n c _ =>
        simp only [map_mul, map_pow]
        rw [hc, f.commutes, g.commutes, hX]
    apply AlgHom.coe_ringHom_injective
    apply IsLocalization.ringHom_ext (nonZeroDivisors W.toAffine.CoordinateRing)
    apply RingHom.ext
    intro a
    obtain ⟨r, rfl⟩ := AdjoinRoot.mk_surjective a
    show f (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
        (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine r)) =
      g (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
        (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine r))
    induction r using Polynomial.induction_on with
    | C p => exact hCp p
    | add p₁ p₂ h₁ h₂ =>
      simp only [map_add]
      rw [h₁, h₂]
    | monomial n p _ =>
      simp only [map_mul, map_pow]
      rw [hCp p, hY]
  
  have ιadd : ∀ P Q : W.toAffine.Point,
      WeierstrassCurve.Affine.Point.map (W' := W)
        (Algebra.ofId K (FractionRing W.toAffine.CoordinateRing)) (P + Q) =
      WeierstrassCurve.Affine.Point.map (W' := W)
        (Algebra.ofId K (FractionRing W.toAffine.CoordinateRing)) P +
      WeierstrassCurve.Affine.Point.map (W' := W)
        (Algebra.ofId K (FractionRing W.toAffine.CoordinateRing)) Q := fun P Q => map_add _ P Q
  have ιneg : ∀ P : W.toAffine.Point,
      WeierstrassCurve.Affine.Point.map (W' := W)
        (Algebra.ofId K (FractionRing W.toAffine.CoordinateRing)) (-P) =
      -WeierstrassCurve.Affine.Point.map (W' := W)
        (Algebra.ofId K (FractionRing W.toAffine.CoordinateRing)) P := fun P => map_neg _ P
  have ιsub : ∀ P Q : W.toAffine.Point,
      WeierstrassCurve.Affine.Point.map (W' := W)
        (Algebra.ofId K (FractionRing W.toAffine.CoordinateRing)) (P - Q) =
      WeierstrassCurve.Affine.Point.map (W' := W)
        (Algebra.ofId K (FractionRing W.toAffine.CoordinateRing)) P -
      WeierstrassCurve.Affine.Point.map (W' := W)
        (Algebra.ofId K (FractionRing W.toAffine.CoordinateRing)) Q := fun P Q => map_sub _ P Q
  have ιzero : WeierstrassCurve.Affine.Point.map (W' := W)
        (Algebra.ofId K (FractionRing W.toAffine.CoordinateRing)) (0 : W.toAffine.Point) = 0 :=
    map_zero _
  have ιsome : ∀ {x y : K} (h' : W.toAffine.Nonsingular x y),
      ∃ h'' : (W.baseChange (FractionRing W.toAffine.CoordinateRing)).toAffine.Nonsingular
          (algebraMap K (FractionRing W.toAffine.CoordinateRing) x)
          (algebraMap K (FractionRing W.toAffine.CoordinateRing) y),
        WeierstrassCurve.Affine.Point.map (W' := W)
          (Algebra.ofId K (FractionRing W.toAffine.CoordinateRing))
          (WeierstrassCurve.Affine.Point.some h' : W.toAffine.Point) =
          WeierstrassCurve.Affine.Point.some h'' :=
    fun {x y} h' => ⟨_, WeierstrassCurve.Affine.Point.map_some (W' := W)
      (Algebra.ofId K (FractionRing W.toAffine.CoordinateRing)) (x := x) (y := y) h'⟩
  have msome : ∀ (g : FractionRing W.toAffine.CoordinateRing →ₐ[K] FractionRing W.toAffine.CoordinateRing)
      {u v : FractionRing W.toAffine.CoordinateRing}
      (h' : (W.baseChange (FractionRing W.toAffine.CoordinateRing)).toAffine.Nonsingular u v),
      ∃ h'' : (W.baseChange (FractionRing W.toAffine.CoordinateRing)).toAffine.Nonsingular (g u) (g v),
        WeierstrassCurve.Affine.Point.map (W' := W) g (WeierstrassCurve.Affine.Point.some h') =
          WeierstrassCurve.Affine.Point.some h'' :=
    fun g _ _ h' => ⟨_, WeierstrassCurve.Affine.Point.map_some (W' := W) g h'⟩
  
  have s4 : ∀ (c : K) (y₃ : FractionRing W.toAffine.CoordinateRing)
      (h₃ : (W.baseChange (FractionRing W.toAffine.CoordinateRing)).toAffine.Nonsingular
        (algebraMap K (FractionRing W.toAffine.CoordinateRing) c) y₃),
      ∃ R : W.toAffine.Point, WeierstrassCurve.Affine.Point.map (W' := W)
        (Algebra.ofId K (FractionRing W.toAffine.CoordinateRing)) R =
        WeierstrassCurve.Affine.Point.some h₃ := by
    intro c y₃ h₃
    have heq := h₃.1
    rw [WeierstrassCurve.Affine.equation_iff] at heq
    have heq' : y₃ ^ 2 + algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₁ *
          algebraMap K (FractionRing W.toAffine.CoordinateRing) c * y₃ +
        algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₃ * y₃ =
      algebraMap K (FractionRing W.toAffine.CoordinateRing) c ^ 3 +
        algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₂ *
          algebraMap K (FractionRing W.toAffine.CoordinateRing) c ^ 2 +
        algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₄ *
          algebraMap K (FractionRing W.toAffine.CoordinateRing) c +
        algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₆ := heq
    obtain ⟨d, hd⟩ := IsAlgClosed.exists_root
      (Polynomial.C (1 : K) * Polynomial.X ^ 2 + Polynomial.C (W.a₁ * c + W.a₃) * Polynomial.X +
        Polynomial.C (-(c ^ 3 + W.a₂ * c ^ 2 + W.a₄ * c + W.a₆)))
      (by rw [Polynomial.degree_quadratic one_ne_zero]; norm_num)
    have hd' : d ^ 2 + (W.a₁ * c + W.a₃) * d - (c ^ 3 + W.a₂ * c ^ 2 + W.a₄ * c + W.a₆) = 0 := by
      rw [Polynomial.IsRoot.def] at hd
      simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow,
        Polynomial.eval_X] at hd
      linear_combination hd
    obtain ⟨d₀, hd₀, hy⟩ : ∃ d₀ : K,
        d₀ ^ 2 + (W.a₁ * c + W.a₃) * d₀ - (c ^ 3 + W.a₂ * c ^ 2 + W.a₄ * c + W.a₆) = 0 ∧
        y₃ = algebraMap K (FractionRing W.toAffine.CoordinateRing) d₀ := by
      have hdL := congrArg (algebraMap K (FractionRing W.toAffine.CoordinateRing)) hd'
      simp only [map_add, map_sub, map_mul, map_pow, map_zero] at hdL
      have hfac : (y₃ - algebraMap K (FractionRing W.toAffine.CoordinateRing) d) *
          (y₃ - algebraMap K (FractionRing W.toAffine.CoordinateRing) (-(W.a₁ * c + W.a₃) - d)) = 0 := by
        simp only [map_sub, map_neg, map_add, map_mul]
        linear_combination heq' - hdL
      rcases mul_eq_zero.mp hfac with h | h
      · exact ⟨d, hd', sub_eq_zero.mp h⟩
      · exact ⟨_, by linear_combination hd', sub_eq_zero.mp h⟩
    subst hy
    have hR : W.toAffine.Nonsingular c d₀ := by
      rw [← WeierstrassCurve.Affine.equation_iff_nonsingular_of_Δ_ne_zero hΔ,
        WeierstrassCurve.Affine.equation_iff]
      linear_combination hd₀
    obtain ⟨h'', e⟩ := ιsome hR
    exact ⟨_, e⟩
  
  have m1 : ∀ R : W.toAffine.Point, WeierstrassCurve.Affine.Point.map (W' := W)
      (Algebra.ofId K (FractionRing W.toAffine.CoordinateRing)) R ≠
      WeierstrassCurve.Affine.Point.some hG := by
    intro R
    rcases R with _ | @⟨x₀, y₀, h'⟩
    · intro h
      rw [show (WeierstrassCurve.Affine.Point.zero : W.toAffine.Point) = 0 from rfl, ιzero] at h
      cases h
    · intro h
      obtain ⟨h'', e⟩ := ιsome h'
      rw [e] at h
      simp only [WeierstrassCurve.Affine.Point.some.injEq] at h
      exact s5 x₀ h.1.symm
  
  have m2 : ∀ P : W.toAffine.Point, ∃ (x₃ y₃ : FractionRing W.toAffine.CoordinateRing)
      (h₃ : (W.baseChange (FractionRing W.toAffine.CoordinateRing)).toAffine.Nonsingular x₃ y₃),
      WeierstrassCurve.Affine.Point.some hG + WeierstrassCurve.Affine.Point.map (W' := W)
        (Algebra.ofId K (FractionRing W.toAffine.CoordinateRing)) P =
        WeierstrassCurve.Affine.Point.some h₃ ∧
      ∀ c : K, x₃ ≠ algebraMap K (FractionRing W.toAffine.CoordinateRing) c := by
    intro P
    rcases hT : WeierstrassCurve.Affine.Point.some hG + WeierstrassCurve.Affine.Point.map (W' := W)
        (Algebra.ofId K (FractionRing W.toAffine.CoordinateRing)) P with _ | @⟨x₃, y₃, h₃⟩
    · exfalso
      apply m1 (-P)
      rw [ιneg]
      exact (eq_neg_of_add_eq_zero_left hT).symm
    · refine ⟨x₃, y₃, h₃, rfl, ?_⟩
      intro c hcx
      subst hcx
      obtain ⟨R, hR⟩ := s4 c y₃ h₃
      apply m1 (R - P)
      rw [ιsub, hR, ← hT, add_sub_cancel_right]
  
  have m3 : ∀ P : W.toAffine.Point, ∃ φ : FractionRing W.toAffine.CoordinateRing →ₐ[K]
      FractionRing W.toAffine.CoordinateRing,
      ∃ h : (W.baseChange (FractionRing W.toAffine.CoordinateRing)).toAffine.Nonsingular
        (φ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
          (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))))
        (φ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
          (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X))),
      WeierstrassCurve.Affine.Point.some hG + WeierstrassCurve.Affine.Point.map (W' := W)
        (Algebra.ofId K (FractionRing W.toAffine.CoordinateRing)) P =
        WeierstrassCurve.Affine.Point.some h := by
    intro P
    obtain ⟨x₃, y₃, h₃, hT, hnc⟩ := m2 P
    obtain ⟨ψ, hψX, hψY⟩ := s2 x₃ y₃ h₃.1
    have hinj := s3 ψ (by rw [hψX]; exact hnc)
    refine ⟨IsFractionRing.liftAlgHom hinj, ?_⟩
    have e1 : IsFractionRing.liftAlgHom hinj
        (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
          (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) = x₃ := by
      rw [IsFractionRing.liftAlgHom_apply, IsFractionRing.lift_algebraMap]
      exact hψX
    have e2 : IsFractionRing.liftAlgHom hinj
        (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
          (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)) = y₃ := by
      rw [IsFractionRing.liftAlgHom_apply, IsFractionRing.lift_algebraMap]
      exact hψY
    rw [e1, e2]
    exact ⟨h₃, hT⟩
  choose φ hφ using m3
  
  have gens : ∀ P Q : W.toAffine.Point,
      φ P (φ Q (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
          (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X)))) =
        φ (P + Q) (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
          (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) ∧
      φ P (φ Q (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
          (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X))) =
        φ (P + Q) (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
          (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)) := by
    intro P Q
    obtain ⟨hP, eP⟩ := hφ P
    obtain ⟨hQ, eQ⟩ := hφ Q
    obtain ⟨hPQ, ePQ⟩ := hφ (P + Q)
    have hMι : ∀ R : W.toAffine.Point, WeierstrassCurve.Affine.Point.map (W' := W) (φ P)
        (WeierstrassCurve.Affine.Point.map (W' := W)
          (Algebra.ofId K (FractionRing W.toAffine.CoordinateRing)) R) =
        WeierstrassCurve.Affine.Point.map (W' := W)
          (Algebra.ofId K (FractionRing W.toAffine.CoordinateRing)) R := by
      intro R
      rcases R with _ | @⟨x₀, y₀, h'⟩
      · rw [show (WeierstrassCurve.Affine.Point.zero : W.toAffine.Point) = 0 from rfl, ιzero,
          map_zero]
      · obtain ⟨h1, e1⟩ := ιsome h'
        rw [e1]
        obtain ⟨h2, e2⟩ := msome (φ P) h1
        rw [e2]
        simp only [WeierstrassCurve.Affine.Point.some.injEq]
        exact ⟨(φ P).commutes x₀, (φ P).commutes y₀⟩
    have hMG : WeierstrassCurve.Affine.Point.map (W' := W) (φ P)
        (WeierstrassCurve.Affine.Point.some hG) = WeierstrassCurve.Affine.Point.some hP := by
      obtain ⟨h'', e⟩ := msome (φ P) hG
      rw [e]
    have key : WeierstrassCurve.Affine.Point.map (W' := W) (φ P)
        (WeierstrassCurve.Affine.Point.some hQ) = WeierstrassCurve.Affine.Point.some hPQ := by
      rw [← eQ, map_add, hMG, hMι, ← eP, ← ePQ, ιadd, add_assoc]
    obtain ⟨h'', e⟩ := msome (φ P) hQ
    rw [e] at key
    simp only [WeierstrassCurve.Affine.Point.some.injEq] at key
    exact key
  have hcomp : ∀ P Q : W.toAffine.Point, (φ P).comp (φ Q) = φ (P + Q) := fun P Q =>
    hext _ _ (gens P Q).1 (gens P Q).2
  have h0 : φ 0 = AlgHom.id K (FractionRing W.toAffine.CoordinateRing) := by
    apply AlgHom.ext
    intro f
    have h := congrArg (fun g => g f) (hcomp 0 0)
    simp only [AlgHom.comp_apply, add_zero] at h
    exact (φ 0).toRingHom.injective h
  refine ⟨fun P => AlgEquiv.ofAlgHom (φ P) (φ (-P)) (by rw [hcomp, add_neg_cancel, h0])
    (by rw [hcomp, neg_add_cancel, h0]), ?_, ?_⟩
  · intro P Q f
    simp only [AlgEquiv.ofAlgHom_apply]
    rw [← AlgHom.comp_apply, hcomp]
  · intro x y h
    simp only [AlgEquiv.ofAlgHom_apply]
    obtain ⟨hP, eP⟩ := hφ (WeierstrassCurve.Affine.Point.some h)
    obtain ⟨hι', eι⟩ := ιsome h
    rw [eι, WeierstrassCurve.Affine.Point.add_of_X_ne (s5 x)] at eP
    simp only [WeierstrassCurve.Affine.Point.some.injEq] at eP
    obtain ⟨eX, eY⟩ := eP
    rw [WeierstrassCurve.Affine.slope_of_X_ne (s5 x)] at eX eY
    have ha₁ : (W.baseChange (FractionRing W.toAffine.CoordinateRing)).toAffine.a₁ =
        algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₁ := rfl
    have ha₂ : (W.baseChange (FractionRing W.toAffine.CoordinateRing)).toAffine.a₂ =
        algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₂ := rfl
    have ha₃ : (W.baseChange (FractionRing W.toAffine.CoordinateRing)).toAffine.a₃ =
        algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₃ := rfl
    refine ⟨(algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
          (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X) -
        algebraMap K (FractionRing W.toAffine.CoordinateRing) y) /
      (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
          (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X)) -
        algebraMap K (FractionRing W.toAffine.CoordinateRing) x), ?_, ?_, ?_⟩
    · exact mul_div_cancel₀ _ (sub_ne_zero.mpr (s5 x))
    · rw [← eX]
      simp only [WeierstrassCurve.Affine.addX, ha₁, ha₂]
    · rw [← eY, ← eX]
      simp only [WeierstrassCurve.Affine.addY, WeierstrassCurve.Affine.negY,
        WeierstrassCurve.Affine.negAddY, WeierstrassCurve.Affine.addX, ha₁, ha₂, ha₃]

theorem coordRing_exists_coeffAction {K : Type*} [Field K] (W : WeierstrassCurve K) (σ : K ≃+* K) (hσ : W.map (σ : K →+* K) = W) :
    ∃ γ : FractionRing W.toAffine.CoordinateRing ≃+* FractionRing W.toAffine.CoordinateRing,
      (∀ c : K, γ (algebraMap K (FractionRing W.toAffine.CoordinateRing) (c)) = algebraMap K (FractionRing W.toAffine.CoordinateRing) (σ c)) ∧
      γ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) = (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) ∧ γ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)) = (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)) ∧
      (∀ a : W.toAffine.CoordinateRing, ∃ a' : W.toAffine.CoordinateRing,
        γ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (a)) = algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (a') ∧
        (Algebra.norm (Polynomial K) (a')).natDegree = (Algebra.norm (Polynomial K) (a)).natDegree) :=
by
  classical
  let I : Ideal (Polynomial (Polynomial K)) := Ideal.span {W.toAffine.polynomial}
  let Φ : Polynomial (Polynomial K) ≃+* Polynomial (Polynomial K) :=
    Polynomial.mapEquiv (Polynomial.mapEquiv σ)
  have hΦ : ∀ P, Φ P = Polynomial.map (Polynomial.mapRingHom (σ : K →+* K)) P := by
    intro P
    show Polynomial.map _ P = _
    congr 1
  have hpoly : Φ W.toAffine.polynomial = W.toAffine.polynomial := by
    rw [hΦ, ← WeierstrassCurve.Affine.map_polynomial]
    exact congrArg (fun V : WeierstrassCurve K => V.toAffine.polynomial) hσ
  have hI : I = Ideal.map (Φ : Polynomial (Polynomial K) →+* Polynomial (Polynomial K)) I := by
    simp only [I, Ideal.map_span, Set.image_singleton]
    rw [RingEquiv.coe_toRingHom, hpoly]
  let φ : W.toAffine.CoordinateRing ≃+* W.toAffine.CoordinateRing := Ideal.quotientEquiv I I Φ hI
  have hφ : ∀ P : Polynomial (Polynomial K),
      φ (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine P) =
        WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine
          (Polynomial.map (Polynomial.mapRingHom (σ : K →+* K)) P) := by
    intro P
    show Ideal.quotientEquiv I I Φ hI (Ideal.Quotient.mk I P) = Ideal.Quotient.mk I _
    rw [Ideal.quotientEquiv_mk, hΦ]
  let γ : FractionRing W.toAffine.CoordinateRing ≃+* FractionRing W.toAffine.CoordinateRing :=
    IsFractionRing.ringEquivOfRingEquiv φ
  have hγ : ∀ x, γ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) x) =
      algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (φ x) :=
    fun x => IsFractionRing.ringEquivOfRingEquiv_algebraMap φ x
  have e1 : ∀ r : Polynomial K, algebraMap (Polynomial K) W.toAffine.CoordinateRing r =
      WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C r) := fun r => rfl
  have e0 : ∀ c : K, algebraMap K W.toAffine.CoordinateRing c =
      WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C (Polynomial.C c)) :=
    fun c => rfl
  refine ⟨γ, ?_, ?_, ?_, ?_⟩
  · intro c
    rw [IsScalarTower.algebraMap_apply K W.toAffine.CoordinateRing
      (FractionRing W.toAffine.CoordinateRing), hγ,
      IsScalarTower.algebraMap_apply K W.toAffine.CoordinateRing
      (FractionRing W.toAffine.CoordinateRing) (σ c), e0, e0, hφ]
    simp
  · rw [hγ, hφ]; simp
  · rw [hγ, hφ]; simp
  · intro a
    refine ⟨φ a, hγ a, ?_⟩
    obtain ⟨p, q, rfl⟩ := WeierstrassCurve.Affine.CoordinateRing.exists_smul_basis_eq a
    have hφa : φ (p • (1 : W.toAffine.CoordinateRing) +
        q • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X) =
        (p.map (σ : K →+* K)) • (1 : W.toAffine.CoordinateRing) +
          (q.map (σ : K →+* K)) • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X := by
      simp only [Algebra.smul_def, map_add, map_mul, map_one, e1, hφ, Polynomial.map_C,
        Polynomial.map_X, Polynomial.coe_mapRingHom]
    rw [hφa]
    apply Polynomial.natDegree_eq_of_degree_eq
    rw [WeierstrassCurve.Affine.CoordinateRing.degree_norm_smul_basis,
      WeierstrassCurve.Affine.CoordinateRing.degree_norm_smul_basis,
      Polynomial.degree_map, Polynomial.degree_map]

theorem coordRing_exists_conj {K : Type*} [Field K] (W : WeierstrassCurve K) :
    ∃ κ : FractionRing W.toAffine.CoordinateRing ≃ₐ[K] FractionRing W.toAffine.CoordinateRing,
      κ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) = (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) ∧
      κ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)) = -(algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)) - algebraMap K (FractionRing W.toAffine.CoordinateRing) (W.a₁) * (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) - algebraMap K (FractionRing W.toAffine.CoordinateRing) (W.a₃) ∧
      (∀ a : W.toAffine.CoordinateRing, ∃ a' : W.toAffine.CoordinateRing,
        κ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (a)) = algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (a') ∧
        Algebra.norm (Polynomial K) (a') = Algebra.norm (Polynomial K) (a) ∧
        algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (a) * algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (a') =
          algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (algebraMap (Polynomial K) W.toAffine.CoordinateRing (Algebra.norm (Polynomial K) (a)))) :=
by
  classical
  let y : W.toAffine.CoordinateRing := AdjoinRoot.root W.toAffine.polynomial
  let B : W.toAffine.CoordinateRing := algebraMap (Polynomial K) W.toAffine.CoordinateRing
    (Polynomial.C W.a₁ * Polynomial.X + Polynomial.C W.a₃)
  let Cc : W.toAffine.CoordinateRing := algebraMap (Polynomial K) W.toAffine.CoordinateRing
    (Polynomial.X ^ 3 + Polynomial.C W.a₂ * Polynomial.X ^ 2 + Polynomial.C W.a₄ * Polynomial.X +
      Polynomial.C W.a₆)
  have hev : ∀ z : W.toAffine.CoordinateRing,
      Polynomial.aeval z W.toAffine.polynomial = z ^ 2 + B * z - Cc := by
    intro z
    simp only [WeierstrassCurve.Affine.polynomial, B, Cc, map_sub, map_add, map_mul, map_pow,
      Polynomial.aeval_X, Polynomial.aeval_C]
    all_goals rfl
  have h0 : y ^ 2 + B * y - Cc = 0 := by
    rw [← hev, AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
  have hr : Polynomial.eval₂ (↑(Algebra.ofId (Polynomial K) W.toAffine.CoordinateRing))
      (-y - B) W.toAffine.polynomial = 0 := by
    have e := hev (-y - B)
    rw [Polynomial.aeval_def] at e
    rw [show ((Algebra.ofId (Polynomial K) W.toAffine.CoordinateRing :
        Polynomial K →+* W.toAffine.CoordinateRing)) =
        algebraMap (Polynomial K) W.toAffine.CoordinateRing from rfl, e]
    linear_combination h0
  let σ₀ := AdjoinRoot.liftAlgHom W.toAffine.polynomial
    (Algebra.ofId (Polynomial K) W.toAffine.CoordinateRing) (-y - B) hr
  have hσy : σ₀ y = -y - B := AdjoinRoot.liftAlgHom_root _ _ _ _
  have hσB : σ₀ B = B := σ₀.commutes _
  have hinv : σ₀.comp σ₀ = AlgHom.id _ _ := by
    apply AdjoinRoot.algHom_ext
    show σ₀ (σ₀ y) = y
    rw [hσy, map_sub, map_neg, hσy, hσB]
    ring
  let σ : W.toAffine.CoordinateRing ≃ₐ[Polynomial K] W.toAffine.CoordinateRing :=
    AlgEquiv.ofAlgHom σ₀ σ₀ hinv hinv
  have hσapp : ∀ b, σ b = σ₀ b := fun _ => rfl
  let κ := IsFractionRing.fieldEquivOfAlgEquiv K (FractionRing W.toAffine.CoordinateRing)
    (FractionRing W.toAffine.CoordinateRing) (σ.restrictScalars K)
  have hκ : ∀ b, κ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) b)
      = algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (σ b) :=
    fun b => IsFractionRing.fieldEquivOfAlgEquiv_algebraMap _ _ _ _ b
  have hmkY : WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X = y :=
    AdjoinRoot.mk_X
  have hmkC : ∀ p : Polynomial K, WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine
      (Polynomial.C p) = algebraMap (Polynomial K) W.toAffine.CoordinateRing p := by
    intro p
    rw [AdjoinRoot.algebraMap_eq]
    exact AdjoinRoot.mk_C _
  have hc : ∀ c : K, algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
      (algebraMap (Polynomial K) W.toAffine.CoordinateRing (Polynomial.C c)) =
      algebraMap K (FractionRing W.toAffine.CoordinateRing) c := by
    intro c
    rw [← Polynomial.algebraMap_eq, ← IsScalarTower.algebraMap_apply,
      ← IsScalarTower.algebraMap_apply]
  refine ⟨κ, ?_, ?_, ?_⟩
  · rw [hκ, hσapp, hmkC, σ₀.commutes]
  · rw [hκ, hσapp, hmkY, hσy, hmkC]
    simp only [B, map_sub, map_neg, map_add, map_mul, hc]
    ring
  · intro a
    refine ⟨σ a, hκ a, Algebra.norm_eq_of_algEquiv σ a, ?_⟩
    rw [← map_mul]
    congr 1
    obtain ⟨p, q, rfl⟩ := WeierstrassCurve.Affine.CoordinateRing.exists_smul_basis_eq a
    have e := WeierstrassCurve.Affine.CoordinateRing.coe_norm_smul_basis (W' := W.toAffine) p q
    rw [← AdjoinRoot.algebraMap_eq] at e
    rw [e, hσapp, map_add, map_smul, map_smul, map_one, hmkY, hσy]
    rw [Algebra.smul_def, Algebra.smul_def, Algebra.smul_def, mul_one]
    have e2 : WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine
        ((Polynomial.C p + Polynomial.C q * Polynomial.X) *
          (Polynomial.C p + Polynomial.C q * (-Polynomial.X -
            Polynomial.C (Polynomial.C W.toAffine.a₁ * Polynomial.X + Polynomial.C W.toAffine.a₃))))
        = (algebraMap (Polynomial K) W.toAffine.CoordinateRing p +
            algebraMap (Polynomial K) W.toAffine.CoordinateRing q * y) *
          (algebraMap (Polynomial K) W.toAffine.CoordinateRing p +
            algebraMap (Polynomial K) W.toAffine.CoordinateRing q * (-y - B)) := by
      rw [map_mul, map_add, map_add, map_mul, map_mul, map_sub, map_neg, hmkC, hmkC, hmkC, hmkY]
    rw [e2]

theorem coordRing_localOrders {K : Type*} [Field K] [DecidableEq K] (W : WeierstrassCurve K)
    (v : FractionRing W.toAffine.CoordinateRing → ℤ)
    (hmul : ∀ f g : FractionRing W.toAffine.CoordinateRing, f ≠ 0 → g ≠ 0 → v (f * g) = v f + v g)
    (hdeg : ∀ a : W.toAffine.CoordinateRing, a ≠ 0 →
      v (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (a)) = -((Algebra.norm (Polynomial K) (a)).natDegree : ℤ))
    {x y : K} (h : W.toAffine.Nonsingular x y) (ℓ x' y' : FractionRing W.toAffine.CoordinateRing)
    (hℓ : ((algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) - algebraMap K (FractionRing W.toAffine.CoordinateRing) (x)) * ℓ = (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)) - algebraMap K (FractionRing W.toAffine.CoordinateRing) (y))
    (hx' : x' = ℓ ^ 2 + algebraMap K (FractionRing W.toAffine.CoordinateRing) (W.a₁) * ℓ - algebraMap K (FractionRing W.toAffine.CoordinateRing) (W.a₂) - (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) - algebraMap K (FractionRing W.toAffine.CoordinateRing) (x))
    (hy' : y' = -(ℓ * (x' - (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X)))) + (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X))) - algebraMap K (FractionRing W.toAffine.CoordinateRing) (W.a₁) * x' - algebraMap K (FractionRing W.toAffine.CoordinateRing) (W.a₃)) :
    x' - algebraMap K (FractionRing W.toAffine.CoordinateRing) (x) ≠ 0 ∧
      v (x' - algebraMap K (FractionRing W.toAffine.CoordinateRing) (x)) = (if 2 * y + W.a₁ * x + W.a₃ = 0 then (2 : ℤ) else 1) ∧
      y' - algebraMap K (FractionRing W.toAffine.CoordinateRing) (y) ≠ 0 ∧
      1 ≤ v (y' - algebraMap K (FractionRing W.toAffine.CoordinateRing) (y)) ∧
      (2 * y + W.a₁ * x + W.a₃ = 0 → v (y' - algebraMap K (FractionRing W.toAffine.CoordinateRing) (y)) = 1) :=
by
  classical
  
  obtain ⟨heq, hns⟩ := (WeierstrassCurve.Affine.nonsingular_iff' x y).mp h
  obtain ⟨α, hα⟩ : ∃ α : K, α = 3 * x ^ 2 + 2 * W.a₂ * x + W.a₄ - W.a₁ * y := ⟨_, rfl⟩
  obtain ⟨β, hβ⟩ : ∃ β : K, β = 2 * y + W.a₁ * x + W.a₃ := ⟨_, rfl⟩
  have hns' : α ≠ 0 ∨ β ≠ 0 := by
    rcases hns with h1 | h1
    · left; rw [hα]; intro h2; apply h1; linear_combination -h2
    · right; rw [hβ]; exact h1
  have hβα : β = 0 → α ≠ 0 := fun hb => by
    rcases hns' with h1 | h1
    · exact h1
    · exact absurd hb h1
  rw [← hβ]
  
  obtain ⟨Xb, hXb⟩ : ∃ Xb : FractionRing W.toAffine.CoordinateRing, Xb = algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X)) := ⟨_, rfl⟩
  obtain ⟨Yb, hYb⟩ : ∃ Yb : FractionRing W.toAffine.CoordinateRing, Yb = algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X) := ⟨_, rfl⟩
  rw [← hXb, ← hYb] at hℓ
  rw [← hXb] at hx'
  rw [← hXb, ← hYb] at hy'
  let ψ : Polynomial K →+* FractionRing W.toAffine.CoordinateRing :=
    (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)).comp
      (algebraMap (Polynomial K) W.toAffine.CoordinateRing)
  have hψX : ψ Polynomial.X = Xb := by rw [hXb]; rfl
  have hψC : ∀ c : K, ψ (Polynomial.C c) = algebraMap K (FractionRing W.toAffine.CoordinateRing) c := by
    intro c
    rw [IsScalarTower.algebraMap_apply K W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)]
    rfl
  have hbasis : ∀ p q : Polynomial K,
      algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
        (p • (1 : W.toAffine.CoordinateRing) + q • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X) = ψ p + ψ q * Yb := by
    intro p q
    rw [Algebra.smul_def, Algebra.smul_def, mul_one, map_add, map_mul, hYb]
    rfl
  have hmkC : ∀ p : Polynomial K, algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
      (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C p)) = ψ p := fun p => rfl
  
  have hG : Yb ^ 2 + algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₁ * Xb * Yb
      + algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₃ * Yb
      - (Xb ^ 3 + algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₂ * Xb ^ 2
        + algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₄ * Xb
        + algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₆) = 0 := by
    have h0 : (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine)
        (Polynomial.X ^ 2 + Polynomial.C (Polynomial.C W.a₁ * Polynomial.X + Polynomial.C W.a₃) * Polynomial.X -
          Polynomial.C (Polynomial.X ^ 3 + Polynomial.C W.a₂ * Polynomial.X ^ 2 + Polynomial.C W.a₄ * Polynomial.X
            + Polynomial.C W.a₆)) = 0 :=
      AdjoinRoot.mk_self
    have h1 := congrArg (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)) h0
    rw [map_zero] at h1
    simp only [map_add, map_sub, map_mul, map_pow, hmkC, ← hYb, hψX, hψC] at h1
    rw [← h1]
    ring
  
  have hg : algebraMap K (FractionRing W.toAffine.CoordinateRing) y ^ 2
      + algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₁ * algebraMap K (FractionRing W.toAffine.CoordinateRing) x * algebraMap K (FractionRing W.toAffine.CoordinateRing) y
      + algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₃ * algebraMap K (FractionRing W.toAffine.CoordinateRing) y
      = algebraMap K (FractionRing W.toAffine.CoordinateRing) x ^ 3
        + algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₂ * algebraMap K (FractionRing W.toAffine.CoordinateRing) x ^ 2
        + algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₄ * algebraMap K (FractionRing W.toAffine.CoordinateRing) x
        + algebraMap K (FractionRing W.toAffine.CoordinateRing) W.a₆ := by
    have h1 := congrArg (algebraMap K (FractionRing W.toAffine.CoordinateRing))
      ((WeierstrassCurve.Affine.equation_iff x y).mp heq)
    simpa only [map_add, map_mul, map_pow] using h1
  have hinj : Function.Injective
      (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)) :=
    IsFractionRing.injective _ _
  
  have s1 : ∀ p q : Polynomial K, q ≠ 0 →
      (Algebra.norm (Polynomial K) (p • (1 : W.toAffine.CoordinateRing) + q • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)).natDegree = max (2 * p.natDegree) (2 * q.natDegree + 3) := by
    intro p q hq
    apply Polynomial.natDegree_eq_of_degree_eq_some
    rw [WeierstrassCurve.Affine.CoordinateRing.degree_norm_smul_basis, Polynomial.degree_eq_natDegree hq]
    by_cases hp : p = 0
    · subst hp
      simp
    · rw [Polynomial.degree_eq_natDegree hp]
      norm_cast
  have s1b : ∀ p : Polynomial K,
      (Algebra.norm (Polynomial K) (p • (1 : W.toAffine.CoordinateRing) + (0 : Polynomial K) • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)).natDegree = 2 * p.natDegree := by
    intro p
    by_cases hp : p = 0
    · subst hp
      have hd := WeierstrassCurve.Affine.CoordinateRing.degree_norm_smul_basis (W' := W.toAffine)
        (0 : Polynomial K) (0 : Polynomial K)
      simp at hd
      simp [hd]
    · apply Polynomial.natDegree_eq_of_degree_eq_some
      rw [WeierstrassCurve.Affine.CoordinateRing.degree_norm_smul_basis, Polynomial.degree_eq_natDegree hp]
      simp
  
  set ι := algebraMap K (FractionRing W.toAffine.CoordinateRing) with hι
  set ιA := algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) with hιA
  obtain ⟨p1, hp1def⟩ : ∃ p1 : Polynomial K,
      p1 = Polynomial.C α * Polynomial.X + Polynomial.C (β * y - α * x) := ⟨_, rfl⟩
  obtain ⟨q1, hq1def⟩ : ∃ q1 : Polynomial K, q1 = Polynomial.C (-β) := ⟨_, rfl⟩
  obtain ⟨p2, hp2def⟩ : ∃ p2 : Polynomial K,
      p2 = Polynomial.C (β * (3 * x + W.a₂) - W.a₁ * α) * (Polynomial.X - Polynomial.C x) ^ 2
        + Polynomial.C (α * y + α * β) * (Polynomial.X - Polynomial.C x) + Polynomial.C (β ^ 2 * y) :=
    ⟨_, rfl⟩
  obtain ⟨q2, hq2def⟩ : ∃ q2 : Polynomial K,
      q2 = Polynomial.C (-α) * Polynomial.X + Polynomial.C (α * x - β ^ 2) := ⟨_, rfl⟩
  obtain ⟨N1, hN1def⟩ : ∃ N1 : W.toAffine.CoordinateRing,
      N1 = p1 • (1 : W.toAffine.CoordinateRing) + q1 • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X :=
    ⟨_, rfl⟩
  obtain ⟨M, hMdef⟩ : ∃ M : W.toAffine.CoordinateRing,
      M = p2 • (1 : W.toAffine.CoordinateRing) + q2 • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X :=
    ⟨_, rfl⟩
  
  have E0 : Xb - ι x = ιA ((Polynomial.X - Polynomial.C x) • (1 : W.toAffine.CoordinateRing)
      + (0 : Polynomial K) • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X) := by
    rw [hbasis]
    simp only [map_sub, map_zero, zero_mul, add_zero, hψX, hψC]
  have E1 : ιA N1 = (x' - ι x) * (Xb - ι x) ^ 2 := by
    rw [hN1def, hbasis, hp1def, hq1def]
    simp only [map_add, map_sub, map_mul, map_neg, hψX, hψC]
    linear_combination (norm := skip) (-(Xb - ι x) ^ 2) * hx'
      - ((Xb - ι x) * ℓ + (Yb - ι y) + ι W.a₁ * (Xb - ι x)) * hℓ - hG + hg
    simp only [hα, hβ, map_add, map_sub, map_mul, map_pow, map_ofNat]
    ring
  have E2' : y' - ι y = -ι β - (ℓ + ι W.a₁) * (x' - ι x) + ((Xb - ι x) * ℓ - (Yb - ι y)) := by
    rw [hy']
    simp only [hβ, map_add, map_mul, map_ofNat]
    ring
  have E2 : ιA M = (y' - ι y) * (Xb - ι x) ^ 3 := by
    have e1 := E1
    rw [hN1def, hbasis, hp1def, hq1def] at e1
    simp only [map_add, map_sub, map_mul, map_neg, hψX, hψC] at e1
    rw [hMdef, hbasis, hp2def, hq2def]
    simp only [map_add, map_sub, map_mul, map_neg, map_pow, hψX, hψC]
    linear_combination (norm := skip) (-(Xb - ι x) ^ 3) * E2' + (-(ℓ + ι W.a₁) * (Xb - ι x)) * e1
      - ((Xb - ι x) ^ 3 - (ι α * (Xb - ι x) - ι β * (Yb - ι y))) * hℓ - ι β * hG + ι β * hg
    simp only [hα, hβ, map_add, map_sub, map_mul, map_pow, map_ofNat]
    ring
  
  have hD0 : ((Polynomial.X - Polynomial.C x) • (1 : W.toAffine.CoordinateRing)
      + (0 : Polynomial K) • WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X) ≠ 0 := by
    intro h0
    exact Polynomial.X_sub_C_ne_zero x (WeierstrassCurve.Affine.CoordinateRing.smul_basis_eq_zero h0).1
  have hDne : Xb - ι x ≠ 0 := by
    rw [E0]; exact (map_ne_zero_iff _ hinj).mpr hD0
  have hvD : v (Xb - ι x) = -2 := by
    rw [E0, hdeg _ hD0, s1b, Polynomial.natDegree_X_sub_C]; norm_num
  have hvD2 : v ((Xb - ι x) ^ 2) = -4 := by
    rw [pow_two, hmul _ _ hDne hDne, hvD]; norm_num
  have hvD3 : v ((Xb - ι x) ^ 3) = -6 := by
    rw [pow_succ, hmul _ _ (pow_ne_zero 2 hDne) hDne, hvD2, hvD]; norm_num
  
  have hN1 : N1 ≠ 0 := by
    intro h0
    rw [hN1def] at h0
    obtain ⟨hp, hq⟩ := WeierstrassCurve.Affine.CoordinateRing.smul_basis_eq_zero h0
    have hb : β = 0 := by rw [hq1def] at hq; simpa using hq
    have h1 := Polynomial.natDegree_linear (b := β * y - α * x) (hβα hb)
    rw [← hp1def, hp, Polynomial.natDegree_zero] at h1
    exact absurd h1 (by norm_num)
  have hx'ne : x' - ι x ≠ 0 := by
    intro h0
    apply hN1
    apply hinj
    rw [E1, h0, zero_mul, map_zero]
  have hvx : v (x' - ι x) = 4 - ((Algebra.norm (Polynomial K) N1).natDegree : ℤ) := by
    have h1 := hdeg _ hN1
    rw [E1, hmul _ _ hx'ne (pow_ne_zero 2 hDne), hvD2] at h1
    linarith
  have hvx2 : v (x' - ι x) = if β = 0 then 2 else 1 := by
    rw [hvx]
    by_cases hb : β = 0
    · have hq0 : q1 = 0 := by rw [hq1def, hb, neg_zero, Polynomial.C_0]
      have hp1 : p1.natDegree = 1 := by rw [hp1def]; exact Polynomial.natDegree_linear (hβα hb)
      rw [if_pos hb, hN1def, hq0, s1b, hp1]; norm_num
    · have hq0 : q1 ≠ 0 := by rw [hq1def]; simpa using hb
      have hq1 : q1.natDegree = 0 := by rw [hq1def]; exact Polynomial.natDegree_C _
      have hp1 : p1.natDegree ≤ 1 := by rw [hp1def]; exact Polynomial.natDegree_linear_le
      have h3 : (Algebra.norm (Polynomial K) N1).natDegree = 3 := by
        rw [hN1def, s1 _ _ hq0, hq1]; omega
      rw [if_neg hb, h3]; norm_num
  
  have hq2 : q2 ≠ 0 := by
    intro h0
    obtain ⟨c0, hc0⟩ : ∃ c0 : K, c0 = α * x - β ^ 2 := ⟨_, rfl⟩
    rw [hq2def, ← hc0] at h0
    have h1 := congrArg (fun p => Polynomial.coeff p 1) h0
    have h2 := congrArg (fun p => Polynomial.coeff p 0) h0
    simp at h1 h2
    have hα0 : α = 0 := by simpa using h1
    have hc : c0 = 0 := by simpa using h2
    rcases hns' with ha | hb
    · exact ha hα0
    · apply hb
      rw [hc0, hα0, zero_mul, zero_sub, neg_eq_zero] at hc
      simpa using hc
  have hM : M ≠ 0 := by
    intro h0
    rw [hMdef] at h0
    exact hq2 (WeierstrassCurve.Affine.CoordinateRing.smul_basis_eq_zero h0).2
  have hy'ne : y' - ι y ≠ 0 := by
    intro h0
    apply hM
    apply hinj
    rw [E2, h0, zero_mul, map_zero]
  have hvy : v (y' - ι y) = 6 - ((Algebra.norm (Polynomial K) M).natDegree : ℤ) := by
    have h1 := hdeg _ hM
    rw [E2, hmul _ _ hy'ne (pow_ne_zero 3 hDne), hvD3] at h1
    linarith
  have hp2 : p2.natDegree ≤ 2 := by
    rw [hp2def]
    compute_degree
  have hq2le : q2.natDegree ≤ 1 := by rw [hq2def]; exact Polynomial.natDegree_linear_le
  have hMdeg : (Algebra.norm (Polynomial K) M).natDegree = max (2 * p2.natDegree) (2 * q2.natDegree + 3) := by
    rw [hMdef]; exact s1 _ _ hq2
  have hM5 : (Algebra.norm (Polynomial K) M).natDegree ≤ 5 := by rw [hMdeg]; omega
  refine ⟨hx'ne, hvx2, hy'ne, ?_, ?_⟩
  · rw [hvy]; omega
  · intro hb
    have hq21 : q2.natDegree = 1 := by
      rw [hq2def]; exact Polynomial.natDegree_linear (neg_ne_zero.mpr (hβα hb))
    have h5 : (Algebra.norm (Polynomial K) M).natDegree = 5 := by rw [hMdeg, hq21]; omega
    rw [hvy, h5]; norm_num

theorem coordRing_fractionRing_ringHom_ext {K : Type*} [Field K] (W : WeierstrassCurve K) {M : Type*} [Semiring M]
    (φ ψ : FractionRing W.toAffine.CoordinateRing →+* M)
    (hc : ∀ c : K, φ (algebraMap K (FractionRing W.toAffine.CoordinateRing) (c)) = ψ (algebraMap K (FractionRing W.toAffine.CoordinateRing) (c)))
    (hX : φ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) = ψ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X)))) (hY : φ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)) = ψ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X))) :
    φ = ψ :=
by
  refine IsLocalization.ringHom_ext (nonZeroDivisors W.toAffine.CoordinateRing) ?_
  have hFG : (φ.comp (algebraMap _ _)).comp (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine)
      = (ψ.comp (algebraMap _ _)).comp (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine) := by
    refine Polynomial.ringHom_ext (fun a => ?_) (by simpa using hY)
    have h' : ((φ.comp (algebraMap _ _)).comp
          (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine)).comp Polynomial.C
        = ((ψ.comp (algebraMap _ _)).comp
          (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine)).comp Polynomial.C := by
      refine Polynomial.ringHom_ext (fun c => ?_) (by simpa using hX)
      have e : (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing))
          (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C (Polynomial.C c)))
          = algebraMap K (FractionRing W.toAffine.CoordinateRing) c :=
        (IsScalarTower.algebraMap_apply K W.toAffine.CoordinateRing _ c).symm
      simp only [RingHom.comp_apply, e]
      exact hc c
    exact RingHom.congr_fun h' a
  refine RingHom.ext fun r => ?_
  obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective r
  exact RingHom.congr_fun hFG p

theorem ordInfty_invariant {K : Type*} [Field K] (W : WeierstrassCurve K)
    (v : FractionRing W.toAffine.CoordinateRing → ℤ)
    (hmul : ∀ f g : FractionRing W.toAffine.CoordinateRing, f ≠ 0 → g ≠ 0 → v (f * g) = v f + v g)
    (hdeg : ∀ a : W.toAffine.CoordinateRing, a ≠ 0 →
      v (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (a)) = -((Algebra.norm (Polynomial K) (a)).natDegree : ℤ))
    (φ : FractionRing W.toAffine.CoordinateRing ≃+* FractionRing W.toAffine.CoordinateRing)
    (hφ : ∀ a : W.toAffine.CoordinateRing, ∃ a' : W.toAffine.CoordinateRing,
      φ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (a)) = algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (a') ∧
      (Algebra.norm (Polynomial K) (a')).natDegree = (Algebra.norm (Polynomial K) (a)).natDegree) :
    ∀ f : FractionRing W.toAffine.CoordinateRing, f ≠ 0 → v (φ f) = v f :=
by
  intro f hf
  obtain ⟨⟨a, b⟩, hab⟩ :=
    IsLocalization.surj (nonZeroDivisors W.toAffine.CoordinateRing) f
  simp only at hab
  have hinj : Function.Injective (algebraMap W.toAffine.CoordinateRing
      (FractionRing W.toAffine.CoordinateRing)) :=
    IsFractionRing.injective _ _
  have hb0 : (b : W.toAffine.CoordinateRing) ≠ 0 := nonZeroDivisors.ne_zero b.2
  have hbF : algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
      (b : W.toAffine.CoordinateRing) ≠ 0 := by
    intro h; exact hb0 (hinj (by rw [h, map_zero]))
  have haF : algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
      a ≠ 0 := by
    rw [← hab]; exact mul_ne_zero hf hbF
  have ha0 : a ≠ 0 := by rintro rfl; exact haF (map_zero _)
  obtain ⟨a', ha', hna⟩ := hφ a
  obtain ⟨b', hb', hnb⟩ := hφ (b : W.toAffine.CoordinateRing)
  have ha'F : algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
      a' ≠ 0 := by
    rw [← ha']; intro h; exact haF (φ.injective (by rw [h, map_zero]))
  have hb'F : algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing)
      b' ≠ 0 := by
    rw [← hb']; intro h; exact hbF (φ.injective (by rw [h, map_zero]))
  have ha'0 : a' ≠ 0 := by rintro rfl; exact ha'F (map_zero _)
  have hb'0 : b' ≠ 0 := by rintro rfl; exact hb'F (map_zero _)
  have hφf : φ f ≠ 0 := by
    intro h; exact hf (φ.injective (by rw [h, map_zero]))
  have h1 := hmul f _ hf hbF
  rw [hab, hdeg a ha0, hdeg _ hb0] at h1
  have hab' : φ f * algebraMap W.toAffine.CoordinateRing
      (FractionRing W.toAffine.CoordinateRing) b' =
      algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) a' := by
    rw [← hb', ← ha', ← map_mul, hab]
  have h2 := hmul (φ f) _ hφf hb'F
  rw [hab', hdeg a' ha'0, hdeg b' hb'0, hna, hnb] at h2
  linarith

theorem ord_nonneg_on_coordRing {K : Type*} [Field K] (W : WeierstrassCurve K)
    (v : FractionRing W.toAffine.CoordinateRing → ℤ)
    (hmul : ∀ f g : FractionRing W.toAffine.CoordinateRing, f ≠ 0 → g ≠ 0 → v (f * g) = v f + v g)
    (hultra : ∀ f g : FractionRing W.toAffine.CoordinateRing, f ≠ 0 → g ≠ 0 → f + g ≠ 0 →
      min (v f) (v g) ≤ v (f + g))
    (hconst : ∀ c : K, c ≠ 0 → v (algebraMap K (FractionRing W.toAffine.CoordinateRing) (c)) = 0)
    (φ : FractionRing W.toAffine.CoordinateRing →ₐ[K] FractionRing W.toAffine.CoordinateRing)
    (hX : φ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) = 0 ∨ 0 ≤ v (φ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X)))))
    (hY : φ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)) = 0 ∨ 0 ≤ v (φ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)))) :
    ∀ a : W.toAffine.CoordinateRing, a ≠ 0 → 0 ≤ v (φ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (a))) :=
by
  intro a ha
  classical
  let P : FractionRing W.toAffine.CoordinateRing → Prop := fun f => f = 0 ∨ 0 ≤ v f
  have padd : ∀ f g, P f → P g → P (f + g) := by
    intro f g hf hg
    by_cases hf0 : f = 0
    · rw [hf0, zero_add]; exact hg
    by_cases hg0 : g = 0
    · rw [hg0, add_zero]; exact hf
    by_cases hfg : f + g = 0
    · exact Or.inl hfg
    right
    have h1 : 0 ≤ v f := hf.resolve_left hf0
    have h2 : 0 ≤ v g := hg.resolve_left hg0
    exact le_trans (le_min h1 h2) (hultra f g hf0 hg0 hfg)
  have pmul : ∀ f g, P f → P g → P (f * g) := by
    intro f g hf hg
    by_cases hf0 : f = 0
    · left; rw [hf0, zero_mul]
    by_cases hg0 : g = 0
    · left; rw [hg0, mul_zero]
    right
    have h1 : 0 ≤ v f := hf.resolve_left hf0
    have h2 : 0 ≤ v g := hg.resolve_left hg0
    show 0 ≤ v (f * g)
    rw [hmul f g hf0 hg0]
    omega
  have pconst : ∀ c : K, P (algebraMap K (FractionRing W.toAffine.CoordinateRing) c) := by
    intro c
    by_cases hc : c = 0
    · left; rw [hc, map_zero]
    · right; exact le_of_eq (hconst c hc).symm
  let ψ : W.toAffine.CoordinateRing →ₐ[K] FractionRing W.toAffine.CoordinateRing :=
    φ.comp (IsScalarTower.toAlgHom K W.toAffine.CoordinateRing
      (FractionRing W.toAffine.CoordinateRing))
  have hψX : P (ψ (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine
      (Polynomial.C Polynomial.X))) := hX
  have hψY : P (ψ (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine Polynomial.X)) := hY
  have hC : ∀ q : Polynomial K,
      P (ψ (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C q))) := by
    intro q
    induction q using Polynomial.induction_on with
    | C c =>
      have e : WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine
          (Polynomial.C (Polynomial.C c)) = algebraMap K W.toAffine.CoordinateRing c := rfl
      rw [e, ψ.commutes]
      exact pconst c
    | add p q hp hq =>
      rw [Polynomial.C_add, map_add, map_add]
      exact padd _ _ hp hq
    | monomial n c ih =>
      rw [pow_succ, ← mul_assoc, Polynomial.C_mul, map_mul, map_mul]
      exact pmul _ _ ih hψX
  have hall : ∀ p : Polynomial (Polynomial K),
      P (ψ (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine p)) := by
    intro p
    induction p using Polynomial.induction_on with
    | C q => exact hC q
    | add p q hp hq =>
      rw [map_add, map_add]
      exact padd _ _ hp hq
    | monomial n q ih =>
      rw [pow_succ, ← mul_assoc, map_mul, map_mul]
      exact pmul _ _ ih hψY
  have hall' : ∀ b : W.toAffine.CoordinateRing, P (ψ b) := by
    intro b
    obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective b
    exact hall p
  have h1 : algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) a ≠ 0 :=
    fun h => ha (IsFractionRing.injective W.toAffine.CoordinateRing
      (FractionRing W.toAffine.CoordinateRing) (h.trans (map_zero _).symm))
  have hne : φ (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) a)
      ≠ 0 := (map_ne_zero φ).mpr h1
  exact (hall' a).resolve_left hne

theorem divisorCalc_degree_zero {K : Type*} [Field K] [IsAlgClosed K] [DecidableEq K] (W : WeierstrassCurve K) (hΔ : W.Δ ≠ 0)
    (ord : W.toAffine.Point → FractionRing W.toAffine.CoordinateRing → ℤ)
    (hmul : ∀ (R : W.toAffine.Point) (f g : FractionRing W.toAffine.CoordinateRing), f ≠ 0 → g ≠ 0 →
      ord R (f * g) = ord R f + ord R g)
    (hconst : ∀ (R : W.toAffine.Point) (c : K), c ≠ 0 → ord R (algebraMap K (FractionRing W.toAffine.CoordinateRing) (c)) = 0)
    (hnonneg : ∀ {x y : K} (h : W.toAffine.Nonsingular x y) (a : W.toAffine.CoordinateRing), a ≠ 0 →
      0 ≤ ord (WeierstrassCurve.Affine.Point.some h) (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (a)))
    (hinf : ∀ a : W.toAffine.CoordinateRing, a ≠ 0 →
      ord 0 (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (a)) = -((Algebra.norm (Polynomial K) (a)).natDegree : ℤ))
    (hX : ∀ {x y : K} (h : W.toAffine.Nonsingular x y) (c : K),
      ord (WeierstrassCurve.Affine.Point.some h) ((algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (WeierstrassCurve.Affine.CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))) - algebraMap K (FractionRing W.toAffine.CoordinateRing) (c)) =
        if c = x then (if 2 * y + W.a₁ * x + W.a₃ = 0 then (2 : ℤ) else 1) else 0)
    (hconj : ∀ a : W.toAffine.CoordinateRing, ∃ a' : W.toAffine.CoordinateRing,
      algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (a) * algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (a') =
        algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (algebraMap (Polynomial K) W.toAffine.CoordinateRing (Algebra.norm (Polynomial K) (a))) ∧
      ∀ R : W.toAffine.Point, ord R (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (a')) = ord (-R) (algebraMap W.toAffine.CoordinateRing (FractionRing W.toAffine.CoordinateRing) (a))) :
    ∀ f : FractionRing W.toAffine.CoordinateRing, f ≠ 0 → ∃ s : Finset W.toAffine.Point,
      (∀ R : W.toAffine.Point, R ∉ s → ord R f = 0) ∧ ∑ R ∈ s, ord R f = 0 :=
by
  classical
  
  have t_conj : ∀ (f f' n : FractionRing W.toAffine.CoordinateRing), f ≠ 0 → n ≠ 0 → f * f' = n →
      (∀ R : W.toAffine.Point, ord R f' = ord (-R) f) →
      (∀ R : W.toAffine.Point, R ≠ 0 → 0 ≤ ord R f) →
      (∃ s : Finset W.toAffine.Point, (∀ R : W.toAffine.Point, R ∉ s → ord R n = 0) ∧
        ∑ R ∈ s, ord R n = 0) →
      ∃ s : Finset W.toAffine.Point, (∀ R : W.toAffine.Point, R ∉ s → ord R f = 0) ∧
        ∑ R ∈ s, ord R f = 0 := by
    intro f f' n hf hn hprod hcj hpos hgood
    obtain ⟨sn, hsn0, hsnsum⟩ := hgood
    have hf' : f' ≠ 0 := by
      rintro rfl; rw [mul_zero] at hprod; exact hn hprod.symm
    have hK : ∀ R, ord R n = ord R f + ord (-R) f := by
      intro R; rw [← hprod, hmul R f f' hf hf', hcj]
    have hTneg : ∀ R ∈ insert 0 (sn ∪ sn.image (fun R => -R)),
        -R ∈ insert 0 (sn ∪ sn.image (fun R => -R)) := by
      intro R hR
      rw [Finset.mem_insert, Finset.mem_union, Finset.mem_image] at hR ⊢
      rcases hR with h | h | ⟨Q, hQ, rfl⟩
      · left; rw [h, neg_zero]
      · right; right; exact ⟨R, h, rfl⟩
      · right; left; rw [neg_neg]; exact hQ
    have hsub : sn ⊆ insert 0 (sn ∪ sn.image (fun R => -R)) := fun R hR =>
      Finset.mem_insert_of_mem (Finset.mem_union_left _ hR)
    refine ⟨insert 0 (sn ∪ sn.image (fun R => -R)), ?_, ?_⟩
    · intro R hR
      have h0 : R ≠ 0 := fun h => hR (by rw [h]; exact Finset.mem_insert_self _ _)
      have hn0 : R ∉ sn := fun h => hR (hsub h)
      have hnR : -R ≠ 0 := neg_ne_zero.mpr h0
      have e := hK R
      rw [hsn0 R hn0] at e
      have := hpos R h0
      have := hpos (-R) hnR
      omega
    · have hsumn : ∑ R ∈ insert 0 (sn ∪ sn.image (fun R => -R)), ord R n = 0 := by
        rw [← hsnsum]
        symm
        apply Finset.sum_subset hsub
        intro R _ hR; exact hsn0 R hR
      have hswap : ∑ R ∈ insert 0 (sn ∪ sn.image (fun R => -R)), ord (-R) f =
          ∑ R ∈ insert 0 (sn ∪ sn.image (fun R => -R)), ord R f := by
        apply Finset.sum_nbij' (fun R => -R) (fun R => -R)
        · intro R hR; exact hTneg R hR
        · intro R hR; exact hTneg R hR
        · intro R _; exact neg_neg R
        · intro R _; exact neg_neg R
        · intro R _; rfl
      have h2 : ∑ R ∈ insert 0 (sn ∪ sn.image (fun R => -R)), ord R n =
          ∑ R ∈ insert 0 (sn ∪ sn.image (fun R => -R)), ord R f +
            ∑ R ∈ insert 0 (sn ∪ sn.image (fun R => -R)), ord (-R) f := by
        rw [← Finset.sum_add_distrib]; exact Finset.sum_congr rfl (fun R _ => hK R)
      rw [hswap] at h2
      omega
  
  have t_poly : ∀ (φ : Polynomial K →+* FractionRing W.toAffine.CoordinateRing),
      (∀ c : K, c ≠ 0 → φ (Polynomial.C c) ≠ 0 ∧ ∀ R : W.toAffine.Point, ord R (φ (Polynomial.C c)) = 0) →
      (∀ r : K, φ (Polynomial.X - Polynomial.C r) ≠ 0 ∧ ∃ s : Finset W.toAffine.Point,
        (∀ R : W.toAffine.Point, R ∉ s → ord R (φ (Polynomial.X - Polynomial.C r)) = 0) ∧
        ∑ R ∈ s, ord R (φ (Polynomial.X - Polynomial.C r)) = 0) →
      ∀ p : Polynomial K, p ≠ 0 → φ p ≠ 0 ∧ ∃ s : Finset W.toAffine.Point,
        (∀ R : W.toAffine.Point, R ∉ s → ord R (φ p) = 0) ∧ ∑ R ∈ s, ord R (φ p) = 0 := by
    intro φ hC hlin
    suffices H : ∀ d : ℕ, ∀ p : Polynomial K, p.natDegree = d → p ≠ 0 → φ p ≠ 0 ∧
        ∃ s : Finset W.toAffine.Point,
        (∀ R : W.toAffine.Point, R ∉ s → ord R (φ p) = 0) ∧ ∑ R ∈ s, ord R (φ p) = 0 from
      fun p hp => H _ p rfl hp
    intro d
    induction d using Nat.strong_induction_on with
    | _ d ih =>
    intro p h hp
    rcases Nat.eq_zero_or_pos d with hd | hd
    · subst hd
      have hpC := Polynomial.eq_C_of_natDegree_eq_zero h
      have hc : p.coeff 0 ≠ 0 := by
        intro hc; apply hp; rw [hpC, hc, map_zero]
      obtain ⟨h1, h2⟩ := hC _ hc
      rw [hpC]
      exact ⟨h1, ∅, fun R _ => h2 R, by simp⟩
    · have hdeg : p.degree ≠ 0 := by
        intro h0
        have := Polynomial.natDegree_eq_zero_iff_degree_le_zero.mpr h0.le
        omega
      obtain ⟨r, hr⟩ := IsAlgClosed.exists_root p hdeg
      have hpq : (Polynomial.X - Polynomial.C r) * (p /ₘ (Polynomial.X - Polynomial.C r)) = p :=
        Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hr
      have hq0 : p /ₘ (Polynomial.X - Polynomial.C r) ≠ 0 := by
        intro h0; apply hp; rw [← hpq, h0, mul_zero]
      have hqdeg : (p /ₘ (Polynomial.X - Polynomial.C r)).natDegree < d := by
        rw [Polynomial.natDegree_divByMonic _ (Polynomial.monic_X_sub_C r),
          Polynomial.natDegree_X_sub_C, h]
        omega
      obtain ⟨hq1, sq, hsq0, hsqsum⟩ := ih _ hqdeg _ rfl hq0
      obtain ⟨hl1, sl, hsl0, hslsum⟩ := hlin r
      have hφ : φ p = φ (Polynomial.X - Polynomial.C r) *
          φ (p /ₘ (Polynomial.X - Polynomial.C r)) := by
        rw [← map_mul, hpq]
      have hm : ∀ R, ord R (φ p) = ord R (φ (Polynomial.X - Polynomial.C r)) +
          ord R (φ (p /ₘ (Polynomial.X - Polynomial.C r))) := by
        intro R; rw [hφ]; exact hmul R _ _ hl1 hq1
      refine ⟨by rw [hφ]; exact mul_ne_zero hl1 hq1, sl ∪ sq, ?_, ?_⟩
      · intro R hR
        rw [Finset.mem_union, not_or] at hR
        rw [hm, hsl0 R hR.1, hsq0 R hR.2, add_zero]
      · rw [Finset.sum_congr rfl (fun R _ => hm R), Finset.sum_add_distrib]
        have e1 : ∑ R ∈ sl ∪ sq, ord R (φ (Polynomial.X - Polynomial.C r)) =
            ∑ R ∈ sl, ord R (φ (Polynomial.X - Polynomial.C r)) := by
          symm; apply Finset.sum_subset Finset.subset_union_left; intro R _ hR; exact hsl0 R hR
        have e2 : ∑ R ∈ sl ∪ sq, ord R (φ (p /ₘ (Polynomial.X - Polynomial.C r))) =
            ∑ R ∈ sq, ord R (φ (p /ₘ (Polynomial.X - Polynomial.C r))) := by
          symm; apply Finset.sum_subset Finset.subset_union_right; intro R _ hR; exact hsq0 R hR
        rw [e1, e2, hslsum, hsqsum, add_zero]
  
  have t_vert : ∀ (r : K) (g : W.toAffine.Point → ℤ), g 0 = -2 →
      (∀ {x y : K} (h : W.toAffine.Nonsingular x y),
        g (WeierstrassCurve.Affine.Point.some h) =
          if r = x then (if 2 * y + W.a₁ * x + W.a₃ = 0 then (2 : ℤ) else 1) else 0) →
      ∃ s : Finset W.toAffine.Point, (∀ R : W.toAffine.Point, R ∉ s → g R = 0) ∧
        ∑ R ∈ s, g R = 0 := by
    intro r g hg0 hgS
    haveI : W.IsElliptic := ⟨isUnit_iff_ne_zero.mpr hΔ⟩
    have hq : (Polynomial.C (1:K) * Polynomial.X ^ 2 + Polynomial.C (W.a₁ * r + W.a₃) * Polynomial.X +
        Polynomial.C (-(r ^ 3 + W.a₂ * r ^ 2 + W.a₄ * r + W.a₆))).degree ≠ 0 := by
      rw [Polynomial.degree_quadratic one_ne_zero]; decide
    obtain ⟨y₀, hy₀⟩ := IsAlgClosed.exists_root _ hq
    have R0 : y₀ ^ 2 + (W.a₁ * r + W.a₃) * y₀ - (r ^ 3 + W.a₂ * r ^ 2 + W.a₄ * r + W.a₆) = 0 := by
      have h := hy₀
      simp only [Polynomial.IsRoot.def, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
        Polynomial.eval_X, Polynomial.eval_pow] at h
      linear_combination h
    have heq : W.toAffine.Equation r y₀ := by
      rw [WeierstrassCurve.Affine.equation_iff]; linear_combination R0
    have h₀ : W.toAffine.Nonsingular r y₀ := WeierstrassCurve.Affine.equation_iff_nonsingular.mp heq
    have h₁ : W.toAffine.Nonsingular r (W.toAffine.negY r y₀) :=
      (WeierstrassCurve.Affine.nonsingular_neg r y₀).mpr h₀
    have hny : W.toAffine.negY r y₀ = -y₀ - W.a₁ * r - W.a₃ := rfl
    have hz0 : ∀ {x y : K} (h : W.toAffine.Nonsingular x y),
        (0 : W.toAffine.Point) ≠ WeierstrassCurve.Affine.Point.some h := by
      intro x y h e; cases e
    refine ⟨{0, WeierstrassCurve.Affine.Point.some h₀, WeierstrassCurve.Affine.Point.some h₁}, ?_, ?_⟩
    · intro R hR
      cases R with
      | zero => exact absurd (Finset.mem_insert_self _ _) hR
      | @some x y h =>
        rw [hgS h]
        by_cases hrx : r = x
        · exfalso
          subst hrx
          rcases WeierstrassCurve.Affine.Y_eq_of_X_eq h.1 h₀.1 rfl with hy | hy
          · subst hy
            exact hR (Finset.mem_insert_of_mem (Finset.mem_insert_self _ _))
          · subst hy
            exact hR (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem (Finset.mem_singleton_self _)))
        · rw [if_neg hrx]
    · have hg₀ : g (WeierstrassCurve.Affine.Point.some h₀) =
          if 2 * y₀ + W.a₁ * r + W.a₃ = 0 then 2 else 1 := by rw [hgS h₀, if_pos rfl]
      have hg₁ : g (WeierstrassCurve.Affine.Point.some h₁) =
          if 2 * (W.toAffine.negY r y₀) + W.a₁ * r + W.a₃ = 0 then 2 else 1 := by
        rw [hgS h₁, if_pos rfl]
      by_cases hβ : 2 * y₀ + W.a₁ * r + W.a₃ = 0
      · have hy : W.toAffine.negY r y₀ = y₀ := by rw [hny]; linear_combination -hβ
        have hP : WeierstrassCurve.Affine.Point.some h₁ = WeierstrassCurve.Affine.Point.some h₀ := by
          rw [WeierstrassCurve.Affine.Point.some.injEq]; exact ⟨rfl, hy⟩
        rw [hP, Finset.insert_eq_of_mem (Finset.mem_singleton_self _),
          Finset.sum_insert (by rw [Finset.mem_singleton]; exact hz0 h₀), Finset.sum_singleton, hg0,
          hg₀, if_pos hβ]
        norm_num
      · have hβ1 : ¬ (2 * (W.toAffine.negY r y₀) + W.a₁ * r + W.a₃ = 0) := by
          intro h; apply hβ; rw [hny] at h; linear_combination -h
        have hne : WeierstrassCurve.Affine.Point.some h₀ ≠ WeierstrassCurve.Affine.Point.some h₁ := by
          rw [Ne, WeierstrassCurve.Affine.Point.some.injEq]
          rintro ⟨-, h⟩
          apply hβ; rw [hny] at h; linear_combination h
        have m1 : WeierstrassCurve.Affine.Point.some h₀ ∉
            ({WeierstrassCurve.Affine.Point.some h₁} : Finset W.toAffine.Point) := by
          rw [Finset.mem_singleton]; exact hne
