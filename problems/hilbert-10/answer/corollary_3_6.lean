      (∀ v, v ≠ v₀ → LocalIdentityAt a₁ a₂ a₃ v) → LocalIdentityAt a₁ a₂ a₃ v₀ := by
    intro L _ _ _ v₀ a₁ a₂ a₃ h12 h13 h23 hj hoth
    classical
    obtain ⟨d₁, hd₁, hw₁⟩ := dokchitser_theorem_2_4 a₁ a₂ a₃ h12 h13 h23 hj
    obtain ⟨hfinσ, d₂, hd₂, hs₂⟩ := selmer_parity_phi a₁ a₂ a₃ h12 h13 h23
    obtain ⟨hfinh, hh⟩ := s3 a₁ a₂ a₃ h12 h13
