      | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
      | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
      | inv x _ hx => rw [map_inv₀]; exact inv_mem hx
    rw [EllipticRootNumber.inertia, IntermediateField.mem_fixingSubgroup_iff] at hτ ⊢
    intro x hx
    rw [AlgEquiv.mul_apply, AlgEquiv.mul_apply, hτ _ (hstab x hx), ← AlgEquiv.mul_apply,
      mul_inv_cancel, AlgEquiv.one_apply]
  have hle := EllipticRootNumber.relWeil_antitone F h
  haveI := s1
  refine ⟨?_, ?_⟩
  · haveI : FiniteDimensional (EllipticRootNumber.Ω F) (ULift.{u} (EllipticRootNumber.Ω F)) := hχ.1
    exact s3 _ _
  · obtain ⟨U, hU, hUχ⟩ := hχ.2
