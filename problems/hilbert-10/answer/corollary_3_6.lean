    (hmul : ∀ (R : W.toAffine.Point) (f g : FractionRing W.toAffine.CoordinateRing), f ≠ 0 → g ≠ 0 →
      ord R (f * g) = ord R f + ord R g)
    (hultra : ∀ (R : W.toAffine.Point) (f g : FractionRing W.toAffine.CoordinateRing), f ≠ 0 → g ≠ 0 →
      f + g ≠ 0 → min (ord R f) (ord R g) ≤ ord R (f + g))
