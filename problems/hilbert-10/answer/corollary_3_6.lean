    have hT : T = fun i => (EllipticRootNumber.relWeil F (M i)).subgroupOf
        (EllipticRootNumber.relWeil F ⊥) := funext hTM
    subst hT
    
    have hWeil : ∀ i (θ₀ : ((EllipticRootNumber.relWeil F (M i)).subgroupOf
          (EllipticRootNumber.relWeil F ⊥)) →* (EllipticRootNumber.Ω F)ˣ),
        (∀ t : ((EllipticRootNumber.relWeil F (M i)).subgroupOf (EllipticRootNumber.relWeil F ⊥)),
          (t : EllipticRootNumber.relWeil F ⊥) ∈
            (EllipticRootNumber.relWeil F N).subgroupOf (EllipticRootNumber.relWeil F ⊥) →
          θ₀ t = ω t) →
        EllipticRootNumber.IsWeilRep F (M i) (EllipticRootNumber.charRep F (M i)
          (θ₀.comp (Subgroup.subgroupOfEquivOfLe (EllipticRootNumber.relWeil_antitone F
            (bot_le : (⊥ : IntermediateField F (AlgebraicClosure F)) ≤ M i))).symm.toMonoidHom)) := by
      intro i θ₀ hθ₀
      obtain ⟨-, Uω, hUω, hω1⟩ := hωW
      refine ⟨hFDU, (N.fixingSubgroup : Set (EllipticRootNumber.AbsGal F)) ∩ Uω,
