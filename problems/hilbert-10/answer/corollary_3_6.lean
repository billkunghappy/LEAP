      exact phiSign_hilbTerm_real_complex.2 _ _ _ (fun e => h12 (hinj (τ.injective e)))
        (fun e => h13 (hinj (τ.injective e))) (fun e => h23 (hinj (τ.injective e)))
  
  have oddLI : ∀ {L : Type u} [Field L] [NumberField L] (a₁ a₂ a₃ : L),
      a₁ ≠ a₂ → a₁ ≠ a₃ → a₂ ≠ a₃ →
      ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L),
