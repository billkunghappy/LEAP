    · linear_combination (ε * ε⁻¹ ^ 2) * hs - (y ^ 2 + (t₁ - t₂)) * (ε * ε⁻¹ + 1) * hεinv
    · linear_combination (ε * ε⁻¹ ^ 2 * r ^ 2) * hs - hr' -
        r ^ 2 * (y ^ 2 + (t₁ - t₂)) * (ε * ε⁻¹ + 1) * hεinv
  · 
    rintro ⟨z₀, z₁, z₂, z₃, hnz, e1, e2⟩
