      apply LinearMap.ext
      intro f
      apply Subtype.ext
      funext x
      show f.1 (x * w) = f.1 x
      have hfm : ∀ (k : (EllipticRootNumber.relWeil F M).subgroupOf (EllipticRootNumber.relWeil F L))
