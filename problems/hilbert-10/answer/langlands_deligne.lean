      exact h_ineq.trans hx_ge
  have hnorm_val_L : ∀ (k : ℤ) (y : E'),
      (y = 0 ∨ k ≤ valL F E' y) → (normLM F hLE' y = 0 ∨ k ≤ valL F L (normLM F hLE' y)) := by
    intro k y hy
    rcases hy with rfl | hy_ge
    · left
      haveI : IsScalarTower F L (IntermediateField.extendScalars hLE') :=
        IsScalarTower.of_algebraMap_eq fun _ => rfl
      haveI : FiniteDimensional F (IntermediateField.extendScalars hLE') :=
        inferInstanceAs (FiniteDimensional F E')
      haveI : Module.Finite L (IntermediateField.extendScalars hLE') :=
        FiniteDimensional.right F L (IntermediateField.extendScalars hLE')
