        mul_mem' := by
          intro u v hu hv
          change ((u * v : Lˣ) : L) = 1 ∨ (a : ℤ) ≤ valL F L (((u * v : Lˣ) : L) - 1)
          have hu0 : valL F L (u : L) = 0 := hgen_val0 a ha u hu
          have hterm1 : (u : L) * ((v : L) - 1) = 0 ∨
              (a : ℤ) ≤ valL F L ((u : L) * ((v : L) - 1)) := by
            by_cases hsub : (v : L) - 1 = 0
            · left
              rw [hsub, mul_zero]
            · right
              have hv1 : (v : L) ≠ 1 := sub_ne_zero.mp hsub
              have hva : (a : ℤ) ≤ valL F L ((v : L) - 1) := hv.resolve_left hv1
              rw [hval_mul (u : L) ((v : L) - 1) (Units.ne_zero u) hsub, hu0, zero_add]
              exact hva
          have hterm2 : (u : L) - 1 = 0 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1) := by
            rcases hu with hu1 | hua
            · exact Or.inl (sub_eq_zero.mpr hu1)
            · exact Or.inr hua
          have hadd := hval_add (a : ℤ) ((u : L) * ((v : L) - 1)) ((u : L) - 1) hterm1 hterm2
          have hsplit : (u : L) * ((v : L) - 1) + ((u : L) - 1) = ((u * v : Lˣ) : L) - 1 := by
            rw [Units.val_mul]
            ring
          rw [hsplit] at hadd
          rcases hadd with h0 | hle
          · exact Or.inl (sub_eq_zero.mp h0)
          · exact Or.inr hle
        inv_mem' := by
          intro u hu
          change ((u⁻¹ : Lˣ) : L) = 1 ∨ (a : ℤ) ≤ valL F L (((u⁻¹ : Lˣ) : L) - 1)
          have hu0 : valL F L (u : L) = 0 := hgen_val0 a ha u hu
          have hu_inv0 : valL F L ((u⁻¹ : Lˣ) : L) = 0 := by
            rw [hval_inv u, hu0, neg_zero]
          have hinv_split : (((u⁻¹ : Lˣ) : L) - 1) = - (((u⁻¹ : Lˣ) : L) * ((u : L) - 1)) := by
            have hmul : ((u⁻¹ : Lˣ) : L) * (u : L) = 1 := Units.inv_mul u
            linear_combination hmul
          by_cases hsub : (u : L) - 1 = 0
          · left
            apply sub_eq_zero.mp
            rw [hinv_split, hsub, mul_zero, neg_zero]
          · right
            have hu1 : (u : L) ≠ 1 := sub_ne_zero.mp hsub
            have hua : (a : ℤ) ≤ valL F L ((u : L) - 1) := hu.resolve_left hu1
            rw [hinv_split, hval_neg,
              hval_mul ((u⁻¹ : Lˣ) : L) ((u : L) - 1) (Units.ne_zero u⁻¹) hsub,
              hu_inv0, zero_add]
            exact hua
      }
      have hcl_le : unitGroup F L a ≤ Ha := by
        unfold unitGroup
        rw [Subgroup.closure_le]
        intro u hu
        simpa [Ha, ha0] using hu
      have hle_cl : Ha ≤ unitGroup F L a := by
        intro u hu
        unfold unitGroup
        apply Subgroup.subset_closure
        simpa [Ha, ha0] using hu
      intro u
      exact ⟨fun hu => hcl_le hu, fun hu => hle_cl hu⟩
    have hunit_val0 : ∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0 := by
      intro a u hu
      by_cases ha : a = 0
      · rw [ha] at hu
        exact (hunit0 u).mp hu
      · have ha1 : 1 ≤ a := Nat.one_le_iff_ne_zero.mpr ha
        exact hgen_val0 a ha1 u ((hunit_ge1 a ha1 u).mp hu)
    exact ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj,
      hval_add, hunit0, hunit_ge1, hunit_val0⟩
  have hcond_props : ∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
      (ψ : AddChar L (Ω F)), IsAdmissibleChar F L ψ →
      ∀ (χ' : Lˣ →* (Ω F)ˣ),
        (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
        valL F L ((tateElt F L χ' ψ : Lˣ) : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ := by
    intro L _ ψ hψ χ'
    set Sψ : Set ℤ := {d : ℤ | ∀ x : L, -d ≤ valL F L x → ψ x = 1}
    have hne_ψ : Sψ.Nonempty := by
      obtain ⟨d₀, hd₀⟩ := hψ.2
      refine ⟨-d₀, fun x hx => hd₀ x ?_⟩
      simpa using hx
    have hbdd_ψ : BddAbove Sψ := by
      have hne1 : ∃ x₀ : L, ψ x₀ ≠ 1 := by
        rcases DFunLike.ne_iff.mp hψ.1 with ⟨x₀, hx₀⟩
        exact ⟨x₀, by simpa [AddChar.one_apply] using hx₀⟩
      obtain ⟨x₀, hx₀⟩ := hne1
      refine ⟨-valL F L x₀ - 1, fun d hd => ?_⟩
      by_contra hlt
      have hle : -d ≤ valL F L x₀ := by omega
      exact hx₀ (hd x₀ hle)
    have hmem_ψ : condExpChar F L ψ ∈ Sψ := Int.csSup_mem hne_ψ hbdd_ψ
    have hconj1 : ∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1 := by
      intro x hx
      rcases hx with rfl | hx
      · exact AddChar.map_zero_eq_one ψ
      · exact hmem_ψ x hx
    obtain ⟨_, _, _, _, _, _, hval_surj, _, _, _, _⟩ := hval_props L
    obtain ⟨c₀, hc₀⟩ := hval_surj ((condExp F L χ' : ℤ) + condExpChar F L ψ)
    have hconj4 : valL F L ((tateElt F L χ' ψ : Lˣ) : L) =
        (condExp F L χ' : ℤ) + condExpChar F L ψ :=
      Classical.epsilon_spec
        (p := fun c : Lˣ => valL F L (c : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
        ⟨c₀, hc₀⟩
    exact ⟨hconj1, hconj4⟩
  
  have hrelVal : ∀ x : M₁, relVal F M₂ (ϕ x) = relVal F M₁ x := by
    intro x
    unfold relVal
    rw [Algebra.norm_eq_of_algEquiv ϕ x]
  have hresDeg : resDeg F M₂ = resDeg F M₁ := by
    unfold resDeg
    congr 1
    ext k
    simp only [Set.mem_setOf_eq]
    refine and_congr_right fun _ => ⟨?_, ?_⟩
    · rintro ⟨y, hy0, hyval⟩
      refine ⟨ϕ.symm y, ?_, ?_⟩
      · intro h0
        apply hy0
        rw [← ϕ.apply_symm_apply y, h0, map_zero]
      · rw [← hrelVal (ϕ.symm y), ϕ.apply_symm_apply]
        exact hyval
    · rintro ⟨x, hx0, hxval⟩
      refine ⟨ϕ x, ?_, ?_⟩
      · intro h0
        apply hx0
        rw [← ϕ.symm_apply_apply x, h0, map_zero]
      · rw [hrelVal x]
        exact hxval
  have hqL : qL F M₂ = qL F M₁ := by
    unfold qL
    rw [hresDeg]
  have hvalL : ∀ x : M₁, valL F M₂ (ϕ x) = valL F M₁ x := by
    intro x
    unfold valL
    rw [hrelVal x, hresDeg]
  have hvalL_symm : ∀ y : M₂, valL F M₁ (ϕ.symm y) = valL F M₂ y := by
    intro y
    rw [← hvalL (ϕ.symm y), ϕ.apply_symm_apply]
  have hψ_symm : ∀ y : M₂, ψ₁ (ϕ.symm y) = ψ₂ y := by
    intro y
    rw [← hψ_eq (ϕ.symm y), ϕ.apply_symm_apply]
  have hψ₂ : IsAdmissibleChar F M₂ ψ₂ := by
    rcases hψ₁ with ⟨hψ₁_ne1, d, hd⟩
    refine ⟨?_, d, fun y hy => ?_⟩
    · intro hψ₂_1
      apply hψ₁_ne1
      ext x
      rw [← hψ_eq x, hψ₂_1, AddChar.one_apply, AddChar.one_apply]
    · rw [← hψ_symm y]
      exact hd (ϕ.symm y) (by rwa [hvalL_symm y])
  have hcondExpChar : condExpChar F M₂ ψ₂ = condExpChar F M₁ ψ₁ := by
    unfold condExpChar
    congr 1
    ext d
    simp only [Set.mem_setOf_eq]
    refine ⟨fun hd x hx => ?_, fun hd y hy => ?_⟩
    · rw [← hψ_eq x]
      exact hd (ϕ x) (by rwa [hvalL x])
    · rw [← hψ_symm y]
      exact hd (ϕ.symm y) (by rwa [hvalL_symm y])
  obtain ⟨hval0_1, hval1_1, _, hval_neg_1, hval_mul_1, hval_inv_1, _, hval_add_1,
    hunit0_1, hunit_ge1_1, hunit_val0_1⟩ := hval_props M₁
  obtain ⟨hval0_2, hval1_2, _, hval_neg_2, hval_mul_2, hval_inv_2, _, hval_add_2,
    hunit0_2, hunit_ge1_2, hunit_val0_2⟩ := hval_props M₂
  let e_u : M₁ˣ ≃* M₂ˣ := Units.mapEquiv ϕ.toRingEquiv.toMulEquiv
  have he_u_coe : ∀ z : M₁ˣ, ((e_u z : M₂ˣ) : M₂) = ϕ (z : M₁) := fun _ => rfl
  have he_u_symm_coe : ∀ w : M₂ˣ, ((e_u.symm w : M₁ˣ) : M₁) = ϕ.symm (w : M₂) := fun _ => rfl
  have hθ_eu : ∀ z : M₁ˣ, θ₂ (e_u z) = θ₁ z := hθ_eq
  have hθ_symm : ∀ w : M₂ˣ, θ₁ (e_u.symm w) = θ₂ w := by
    intro w
    rw [← hθ_eu (e_u.symm w), e_u.apply_symm_apply]
  have hUG_iff : ∀ (a : ℕ) (z : M₁ˣ),
      e_u z ∈ unitGroup F M₂ a ↔ z ∈ unitGroup F M₁ a := by
    intro a z
    by_cases ha0 : a = 0
    · subst ha0
      rw [hunit0_2, hunit0_1, he_u_coe, hvalL]
    · have ha_ge1 : 1 ≤ a := Nat.one_le_iff_ne_zero.mpr ha0
      rw [hunit_ge1_2 a ha_ge1, hunit_ge1_1 a ha_ge1, he_u_coe]
      have h1 : (ϕ (z : M₁) = 1 ↔ (z : M₁) = 1) := by
        rw [← map_one ϕ]
        exact ϕ.injective.eq_iff
      have hsub : valL F M₂ (ϕ (z : M₁) - 1) = valL F M₁ ((z : M₁) - 1) := by
        rw [← map_one ϕ, ← map_sub ϕ, hvalL]
      rw [h1, hsub]
  have hUG_symm_iff : ∀ (a : ℕ) (w : M₂ˣ),
      e_u.symm w ∈ unitGroup F M₁ a ↔ w ∈ unitGroup F M₂ a := by
    intro a w
    rw [← hUG_iff a (e_u.symm w), e_u.apply_symm_apply]
  have hcondExp : condExp F M₂ θ₂ = condExp F M₁ θ₁ := by
    unfold condExp
    congr 1
    ext a
    simp only [Set.mem_setOf_eq]
    refine ⟨fun ha z hz => ?_, fun ha w hw => ?_⟩
    · rw [← hθ_eu z]
      exact ha (e_u z) ((hUG_iff a z).mpr hz)
    · rw [← hθ_symm w]
      exact ha (e_u.symm w) ((hUG_symm_iff a w).mpr hw)
  have hθ₂_cond : ∀ w ∈ unitGroup F M₂ (condExp F M₂ θ₂), θ₂ w = 1 := by
    intro w hw
    rw [hcondExp] at hw
    rw [← hθ_symm w]
    exact hθ₁_cond (e_u.symm w) ((hUG_symm_iff _ w).mpr hw)
  
  set a := condExp F M₁ θ₁
  set n := condExpChar F M₁ ψ₁
  set c₁ := tateElt F M₁ θ₁ ψ₁
  set c₂ := tateElt F M₂ θ₂ ψ₂
  obtain ⟨hψ₁_triv, hc₁⟩ := hcond_props M₁ ψ₁ hψ₁ θ₁
  obtain ⟨hψ₂_triv, hc₂⟩ := hcond_props M₂ ψ₂ hψ₂ θ₂
  rw [hcondExp, hcondExpChar] at hc₂
  rw [hcondExpChar] at hψ₂_triv
  let u_c : M₂ˣ := (e_u c₁)⁻¹ * c₂
  have hc₂_eq : e_u c₁ * u_c = c₂ := mul_inv_cancel_left (e_u c₁) c₂
  have hu_c_val0 : valL F M₂ (u_c : M₂) = 0 := by
    change valL F M₂ ((((e_u c₁)⁻¹ * c₂ : M₂ˣ) : M₂)) = 0
    rw [Units.val_mul, hval_mul_2 _ _ (Units.ne_zero _) (Units.ne_zero _),
      hval_inv_2 (e_u c₁), he_u_coe, hvalL (c₁ : M₁), hc₁, hc₂, neg_add_cancel]
  have hu_c_UG0 : u_c ∈ unitGroup F M₂ 0 := (hunit0_2 u_c).mpr hu_c_val0
  have htateEps_eq : tateEps F M₂ θ₂ ψ₂ = tateEps F M₁ θ₁ ψ₁ := by
    unfold tateEps
    rw [hqL, hcondExpChar, hcondExp]
    congr 1
    by_cases ha0 : a = 0
    · rw [if_pos ha0, if_pos ha0]
      have hu_c_cond : u_c ∈ unitGroup F M₂ (condExp F M₂ θ₂) := by
        rw [hcondExp, ha0]
        exact hu_c_UG0
      have hθ₂_uc : θ₂ u_c = 1 := hθ₂_cond u_c hu_c_cond
      have hθ_c_eq : θ₂ c₂ = θ₁ c₁ := by
        rw [← hc₂_eq, map_mul, hθ_eu c₁, hθ₂_uc, mul_one]
      exact congrArg Units.val hθ_c_eq
    · rw [if_neg ha0, if_neg ha0]
      have ha_ge1 : 1 ≤ a := Nat.one_le_iff_ne_zero.mpr ha0
      have hout₁ : ∀ u₁ : M₁ˣ ⧸ unitGroup F M₁ a,
          QuotientGroup.mk (s := unitGroup F M₁ a) (cosetRep u₁) = u₁ :=
        fun u₁ => QuotientGroup.out_eq' u₁
      have hout₂ : ∀ u₂ : M₂ˣ ⧸ unitGroup F M₂ a,
          QuotientGroup.mk (s := unitGroup F M₂ a) (cosetRep u₂) = u₂ :=
        fun u₂ => QuotientGroup.out_eq' u₂
      have hcoset_mk₁ : ∀ z : M₁ˣ,
          (cosetRep (QuotientGroup.mk (s := unitGroup F M₁ a) z))⁻¹ * z ∈ unitGroup F M₁ a :=
        fun z => QuotientGroup.eq.mp (hout₁ _)
      have hcoset_mk₂ : ∀ x : M₂ˣ,
          (cosetRep (QuotientGroup.mk (s := unitGroup F M₂ a) x))⁻¹ * x ∈ unitGroup F M₂ a :=
        fun x => QuotientGroup.eq.mp (hout₂ _)
      have hval_mk₁ : ∀ z : M₁ˣ,
          valL F M₁ ((cosetRep (QuotientGroup.mk (s := unitGroup F M₁ a) z) : M₁ˣ) : M₁) =
            valL F M₁ (z : M₁) := by
        intro z
        set r := cosetRep (QuotientGroup.mk (s := unitGroup F M₁ a) z)
        set h := r⁻¹ * z
        have hh : valL F M₁ (h : M₁) = 0 := hunit_val0_1 a h (hcoset_mk₁ z)
        have hz_eq : (z : M₁) = (r : M₁) * (h : M₁) :=
          congrArg Units.val (by simp [h] : z = r * h)
        rw [hz_eq, hval_mul_1 _ _ (Units.ne_zero _) (Units.ne_zero _), hh, add_zero]
      have hval_mk₂ : ∀ x : M₂ˣ,
          valL F M₂ ((cosetRep (QuotientGroup.mk (s := unitGroup F M₂ a) x) : M₂ˣ) : M₂) =
            valL F M₂ (x : M₂) := by
        intro x
        set r := cosetRep (QuotientGroup.mk (s := unitGroup F M₂ a) x)
        set h := r⁻¹ * x
        have hh : valL F M₂ (h : M₂) = 0 := hunit_val0_2 a h (hcoset_mk₂ x)
        have hx_eq : (x : M₂) = (r : M₂) * (h : M₂) :=
          congrArg Units.val (by simp [h] : x = r * h)
        rw [hx_eq, hval_mul_2 _ _ (Units.ne_zero _) (Units.ne_zero _), hh, add_zero]
      have hterm_mk₂ : ∀ x : M₂ˣ, valL F M₂ (x : M₂) = 0 →
          let u₂ := QuotientGroup.mk (s := unitGroup F M₂ a) x
          (θ₂ (c₂⁻¹ * cosetRep u₂) : Ω F)⁻¹ * ψ₂ (((c₂⁻¹ * cosetRep u₂ : M₂ˣ) : M₂)) =
            (θ₂ (c₂⁻¹ * x) : Ω F)⁻¹ * ψ₂ (((c₂⁻¹ * x : M₂ˣ) : M₂)) := by
        intro x hx0
        dsimp only
        set r := cosetRep (QuotientGroup.mk (s := unitGroup F M₂ a) x)
        set h := r⁻¹ * x
        have hh_mem : h ∈ unitGroup F M₂ a := hcoset_mk₂ x
        have hh_cond : h ∈ unitGroup F M₂ (condExp F M₂ θ₂) := by
          rwa [hcondExp]
        have hθ_h : θ₂ h = 1 := hθ₂_cond h hh_cond
        have hx_mul : x = r * h := by simp [h]
        have hθ_eq_x : θ₂ (c₂⁻¹ * x) = θ₂ (c₂⁻¹ * r) := by
          calc θ₂ (c₂⁻¹ * x) = θ₂ ((c₂⁻¹ * r) * h) := by rw [mul_assoc, ← hx_mul]
            _ = θ₂ (c₂⁻¹ * r) * θ₂ h := map_mul θ₂ _ _
            _ = θ₂ (c₂⁻¹ * r) := by rw [hθ_h, mul_one]
        have hr_val0 : valL F M₂ (r : M₂) = 0 := by rw [hval_mk₂ x, hx0]
        have hh_alt : (h : M₂) = 1 ∨ (a : ℤ) ≤ valL F M₂ ((h : M₂) - 1) :=
          (hunit_ge1_2 a ha_ge1 h).mp hh_mem
        set δ : M₂ := - (((c₂⁻¹ * r : M₂ˣ) : M₂) * ((h : M₂) - 1))
        have hδ_triv : ψ₂ δ = 1 := by
          apply hψ₂_triv δ
          rcases hh_alt with hh1 | hha
          · left
            simp [δ, hh1]
          · by_cases hsub0 : (h : M₂) - 1 = 0
            · left
              simp [δ, hsub0]
            · right
              have hcr_ne : ((c₂⁻¹ * r : M₂ˣ) : M₂) ≠ 0 := Units.ne_zero _
              have hcr_val : valL F M₂ ((c₂⁻¹ * r : M₂ˣ) : M₂) = - ((a : ℤ) + n) := by
                rw [Units.val_mul, hval_mul_2 _ _ (Units.ne_zero _) (Units.ne_zero _),
                  hval_inv_2 c₂, hc₂, hr_val0, add_zero]
              rw [show δ = - (((c₂⁻¹ * r : M₂ˣ) : M₂) * ((h : M₂) - 1)) from rfl,
                hval_neg_2, hval_mul_2 _ _ hcr_ne hsub0, hcr_val]
              omega
        have hr_val_eq : (r : M₂) * (h : M₂) = (x : M₂) :=
          congrArg Units.val hx_mul.symm
        have hsplit : ((c₂⁻¹ * r : M₂ˣ) : M₂) = δ + ((c₂⁻¹ * x : M₂ˣ) : M₂) := by
          simp only [δ, Units.val_mul]
          linear_combination ((c₂⁻¹ : M₂ˣ) : M₂) * hr_val_eq
        have hψ_eq_x : ψ₂ (((c₂⁻¹ * r : M₂ˣ) : M₂)) = ψ₂ (((c₂⁻¹ * x : M₂ˣ) : M₂)) := by
          rw [hsplit, AddChar.map_add_eq_mul, hδ_triv, one_mul]
        rw [hθ_eq_x, hψ_eq_x]
      let e_quot : (M₁ˣ ⧸ unitGroup F M₁ a) ≃ (M₂ˣ ⧸ unitGroup F M₂ a) :=
        { toFun := fun u₁ => QuotientGroup.mk (s := unitGroup F M₂ a) (u_c * e_u (cosetRep u₁))
          invFun := fun u₂ => QuotientGroup.mk (s := unitGroup F M₁ a) (e_u.symm (u_c⁻¹ * cosetRep u₂))
          left_inv := fun u₁ => by
            dsimp only
            set x : M₂ˣ := u_c * e_u (cosetRep u₁)
            set r₂ : M₂ˣ := cosetRep (QuotientGroup.mk (s := unitGroup F M₂ a) x)
            have hr₂_x : r₂⁻¹ * x ∈ unitGroup F M₂ a := hcoset_mk₂ x
            have hx_r₂ : x⁻¹ * r₂ ∈ unitGroup F M₂ a := by
              simpa [mul_inv_rev] using (unitGroup F M₂ a).inv_mem hr₂_x
            have he_eq : e_u ((cosetRep u₁)⁻¹ * e_u.symm (u_c⁻¹ * r₂)) = x⁻¹ * r₂ := by
              rw [map_mul, map_inv, e_u.apply_symm_apply]
              dsimp [x]
              group
            have hmem₁ : (cosetRep u₁)⁻¹ * e_u.symm (u_c⁻¹ * r₂) ∈ unitGroup F M₁ a := by
              rw [← hUG_iff a]
              rwa [he_eq]
            exact (QuotientGroup.eq.mpr hmem₁).symm.trans (hout₁ u₁)
          right_inv := fun u₂ => by
            dsimp only
            set y : M₁ˣ := e_u.symm (u_c⁻¹ * cosetRep u₂)
            set r₁ : M₁ˣ := cosetRep (QuotientGroup.mk (s := unitGroup F M₁ a) y)
            have hr₁_y : r₁⁻¹ * y ∈ unitGroup F M₁ a := hcoset_mk₁ y
            have hy_r₁ : y⁻¹ * r₁ ∈ unitGroup F M₁ a := by
              simpa [mul_inv_rev] using (unitGroup F M₁ a).inv_mem hr₁_y
            have he_mem : e_u (y⁻¹ * r₁) ∈ unitGroup F M₂ a := (hUG_iff a _).mpr hy_r₁
            have he_eq : e_u (y⁻¹ * r₁) = (cosetRep u₂)⁻¹ * (u_c * e_u r₁) := by
              rw [map_mul, map_inv]
              have hey : e_u y = u_c⁻¹ * cosetRep u₂ := e_u.apply_symm_apply _
              rw [hey]
              group
            have hmem₂ : (cosetRep u₂)⁻¹ * (u_c * e_u r₁) ∈ unitGroup F M₂ a := by
              rwa [← he_eq]
            exact (QuotientGroup.eq.mpr hmem₂).symm.trans (hout₂ u₂) }
      have hval_equot : ∀ u₁ : M₁ˣ ⧸ unitGroup F M₁ a,
          valL F M₂ ((cosetRep (e_quot u₁) : M₂ˣ) : M₂) =
            valL F M₁ ((cosetRep u₁ : M₁ˣ) : M₁) := by
        intro u₁
        change valL F M₂
            ((cosetRep (QuotientGroup.mk (s := unitGroup F M₂ a) (u_c * e_u (cosetRep u₁))) : M₂ˣ) : M₂) = _
        rw [hval_mk₂, Units.val_mul, hval_mul_2 _ _ (Units.ne_zero _) (Units.ne_zero _),
          hu_c_val0, zero_add, he_u_coe, hvalL]
      have hc_rel : ∀ z : M₁ˣ, c₂⁻¹ * (u_c * e_u z) = e_u (c₁⁻¹ * z) := by
        intro z
        rw [← hc₂_eq, map_mul, map_inv]
        calc (e_u c₁ * u_c)⁻¹ * (u_c * e_u z)
            = (u_c⁻¹ * (e_u c₁)⁻¹) * (u_c * e_u z) := by rw [mul_inv_rev]
          _ = ((e_u c₁)⁻¹ * u_c⁻¹) * (u_c * e_u z) := by rw [mul_comm u_c⁻¹ (e_u c₁)⁻¹]
          _ = (e_u c₁)⁻¹ * (u_c⁻¹ * (u_c * e_u z)) := by rw [mul_assoc]
          _ = (e_u c₁)⁻¹ * e_u z := by rw [inv_mul_cancel_left]
      rw [← finsum_comp_equiv e_quot]
      apply finsum_congr
      intro u₁
      rw [finsum_eq_if, finsum_eq_if, hval_equot u₁]
      by_cases h0 : valL F M₁ ((cosetRep u₁ : M₁ˣ) : M₁) = 0
      · rw [if_pos h0, if_pos h0]
        have hx0 : valL F M₂ (((u_c * e_u (cosetRep u₁) : M₂ˣ) : M₂)) = 0 := by
          rw [Units.val_mul, hval_mul_2 _ _ (Units.ne_zero _) (Units.ne_zero _),
            hu_c_val0, zero_add, he_u_coe, hvalL, h0]
        have hterm :
            (θ₂ (c₂⁻¹ * cosetRep (QuotientGroup.mk (s := unitGroup F M₂ a)
              (u_c * e_u (cosetRep u₁)))) : Ω F)⁻¹ *
              ψ₂ (((c₂⁻¹ * cosetRep (QuotientGroup.mk (s := unitGroup F M₂ a)
                (u_c * e_u (cosetRep u₁))) : M₂ˣ) : M₂)) =
            (θ₂ (c₂⁻¹ * (u_c * e_u (cosetRep u₁))) : Ω F)⁻¹ *
              ψ₂ (((c₂⁻¹ * (u_c * e_u (cosetRep u₁)) : M₂ˣ) : M₂)) :=
          hterm_mk₂ (u_c * e_u (cosetRep u₁)) hx0
        change (θ₂ (c₂⁻¹ * cosetRep (QuotientGroup.mk (s := unitGroup F M₂ a)
            (u_c * e_u (cosetRep u₁)))) : Ω F)⁻¹ *
            ψ₂ (((c₂⁻¹ * cosetRep (QuotientGroup.mk (s := unitGroup F M₂ a)
              (u_c * e_u (cosetRep u₁))) : M₂ˣ) : M₂)) =
          (θ₁ (c₁⁻¹ * cosetRep u₁) : Ω F)⁻¹ * ψ₁ (((c₁⁻¹ * cosetRep u₁ : M₁ˣ) : M₁))
        rw [hterm, hc_rel (cosetRep u₁), hθ_eu (c₁⁻¹ * cosetRep u₁),
          he_u_coe (c₁⁻¹ * cosetRep u₁), hψ_eq]
      · rw [if_neg h0, if_neg h0]
  refine ⟨htateEps_eq, ?_⟩
  unfold tateEpsUnit
  simp only [htateEps_eq]

theorem ld_ch14_contained_orbit_single_conj_char_compat (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C F' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLF' : L ≤ F') (hF'MC : F' ≤ M_C)
    (hGal : IsGaloisExt F L K) (hGalMC : IsGaloisExt F L M_C) (hGalMCK : IsGaloisExt F M_C K)
    (hAbMCK : IsAbelianExt F hM_CK) (hGalF' : IsGaloisExt F L F')
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (χL_ext : relWeil F L →* (Ω F)ˣ) (hχL_ext : IsWeilRep F L (charRep F L χL_ext))
    (t : MonomialTerm F L) (htWf : t.Wf F L)
    (hF't : F' ≤ t.field) (htMC : t.field ≤ M_C)
    (hSepFtMC : Algebra.IsSeparable t.field (IntermediateField.extendScalars htMC))
    (htK : t.field ≤ K) (ht_restK : restrictWeilChar F htK t.χ = 1)
    (hμ_pow : (recChar F rec t.field t.χ) ^ (p F) = 1)
    (hμ_comp_ne1 : ((recChar F rec t.field t.χ).comp (Units.map (normLM F htMC))) ≠ 1)
    (g : relWeil F L) :
    let γ : AbsGal F := (g : AbsGal F)
    let M_g : IntermediateField F (AlgebraicClosure F) :=
      t.field.map (γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)
    let ϕ_g : t.field ≃ₐ[F] M_g :=
      t.field.equivMap (γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)
    ∃ (hF'Mg : F' ≤ M_g) (χ_g : relWeil F M_g →* (Ω F)ˣ),
      let t_g : MonomialTerm F F' := ⟨1, M_g, hF'Mg, χ_g⟩
      (∀ (u : relWeil F M_g)
        (hu : γ⁻¹ * (u : AbsGal F) * γ ∈ relWeil F t.field),
        χ_g u = t.χ ⟨γ⁻¹ * (u : AbsGal F) * γ, hu⟩) ∧
      FiniteDimensional F M_g ∧
      t_g.Wf F F' ∧
      M_g ≤ K ∧
      IsAdmissibleChar F t.field (traceChar F t.le ψ) ∧
      (∀ x : t.field,
        traceChar F hF'Mg (traceChar F hLF' ψ) (ϕ_g x) =
          traceChar F t.le ψ x) ∧
      (∀ u ∈ unitGroup F t.field (condExp F t.field (recChar F rec t.field t.χ)),
        (recChar F rec t.field t.χ) u = 1) ∧
      (∀ z : t.fieldˣ,
        (recChar F rec M_g χ_g) (Units.map ϕ_g.toRingEquiv.toMonoidHom z) =
          (recChar F rec t.field t.χ) z) ∧
      (∀ u ∈ unitGroup F t.field
          (condExp F t.field
            (recChar F rec t.field (t.χ * restrictWeilChar F t.le χL_ext))),
        (recChar F rec t.field (t.χ * restrictWeilChar F t.le χL_ext)) u = 1) ∧
      (∀ z : t.fieldˣ,
        (recChar F rec M_g
          (χ_g * restrictWeilChar F hF'Mg (restrictWeilChar F hLF' χL_ext)))
          (Units.map ϕ_g.toRingEquiv.toMonoidHom z) =
          (recChar F rec t.field (t.χ * restrictWeilChar F t.le χL_ext)) z) :=
by
  haveI : FiniteDimensional F t.field := htWf.1
  have hSepLFt : Algebra.IsSeparable L (IntermediateField.extendScalars t.le) := htWf.2.1
  have ht_weil : IsWeilRep F t.field (charRep F t.field t.χ) := htWf.2.2
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
  haveI : Fact (Nat.Prime (p F)) := ⟨hp⟩
  obtain ⟨htraceChar, htateEps⟩ := ld_tateEps_char_and_traceChar F rec
  obtain ⟨hWeil_unit_triv, hSepRec_all⟩ := ld_separable_weil_char_rec_and_norm F rec
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (K' : IntermediateField k Ω_bar) [hSepK' : Algebra.IsSeparable k K'],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x) →
      IsGalois k K' := by
    clear * -
    intro k Ω_bar _ _ _ _ K' hSepK' h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK'N : K' ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K' := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K' _ _ _ hSepK' x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K'.val K'.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k N := K'.comap N.val
    have hKN_map : K_N.map N.val = K' := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK'N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K', τ x = x := by
        intro x hx
        let z : N := ⟨x, hK'N hx⟩
        have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
        have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : K_N.fixingSubgroup.Normal := hKN_norm
    haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k] ↥K' := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN
  have h_sep_sub : ∀ (A B C : IntermediateField F (AlgebraicClosure F))
      (hAC : A ≤ C) (hAB : A ≤ B) (hBC : B ≤ C),
      Algebra.IsSeparable A (IntermediateField.extendScalars hAC) →
      Algebra.IsSeparable A (IntermediateField.extendScalars hAB) := by
    clear * -
    intro A B C hAC hAB hBC hSepAC
    let S_B := IntermediateField.extendScalars hAB
    let S_C := IntermediateField.extendScalars hAC
    haveI : Algebra.IsSeparable A S_C := hSepAC
    refine ⟨fun x => ?_⟩
    have hxB : (x : AlgebraicClosure F) ∈ B := (IntermediateField.mem_extendScalars hAB).mp x.2
    let x_C : S_C := ⟨x.1, (IntermediateField.mem_extendScalars hAC).mpr (hBC hxB)⟩
    have hmin1 : (minpoly A (S_B.val x)).Separable ↔ (minpoly A x).Separable := by
      rw [minpoly.algHom_eq S_B.val S_B.val.injective x]
    have hmin2 : (minpoly A (S_C.val x_C)).Separable ↔ (minpoly A x_C).Separable := by
      rw [minpoly.algHom_eq S_C.val S_C.val.injective x_C]
    exact hmin1.mp (hmin2.mpr (Algebra.IsSeparable.isSeparable A x_C))
  have helper_galois_map_mem : ∀ (B : IntermediateField F (AlgebraicClosure F))
      (hLB : L ≤ B), IsGaloisExt F L B →
      ∀ (δ : AbsGal F), δ ∈ L.fixingSubgroup → ∀ z ∈ B, δ z ∈ B := by
    intro B hLB hGalLB δ hδ z hz
    let B' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLB
    haveI : FiniteDimensional F B' := hGalLB.2.1
    haveI : IsScalarTower F L B' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional L B' := Module.Finite.of_restrictScalars_finite F L B'
    haveI : Algebra.IsSeparable L B' := hGalLB.2.2.2 hLB
    haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
    have hB'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F),
        (∀ x ∈ B', τ x = x) → ∀ x ∈ B', (σ * τ * σ⁻¹) x = x := by
      intro σ τ hτ
      let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
      let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
      have hτB : τ_F.1 ∈ B.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hLB).mpr hx)
      have hconjB : (σ_F * τ_F * σ_F⁻¹).1 ∈ B.fixingSubgroup :=
        hGalLB.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτB
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjB
      exact hconjB x ((IntermediateField.mem_extendScalars hLB).mp hx)
    haveI : IsGalois L ↥B' := helper_isGalois L (AlgebraicClosure F) B' hB'_norm_fix
    haveI : Normal L ↥B' := IsGalois.to_normal
    let σ_B : B' ≃ₐ[L] B' :=
      AlgEquiv.restrictNormalHom B' ((IntermediateField.fixingSubgroupEquiv L) ⟨δ, hδ⟩)
    let x : B' := ⟨z, (IntermediateField.mem_extendScalars hLB).mpr hz⟩
    have hx : ((σ_B x : B') : AlgebraicClosure F) = δ z := by
      change ((AlgEquiv.restrictNormalHom B'
        ((IntermediateField.fixingSubgroupEquiv L) ⟨δ, hδ⟩) x : B') : AlgebraicClosure F) = δ z
      rw [AlgEquiv.restrictNormalHom_apply]
      rfl
    rw [← hx]
    exact (IntermediateField.mem_extendScalars hLB).mp (σ_B x).2
  
  let γ : AbsGal F := (g : AbsGal F)
  let M_g : IntermediateField F (AlgebraicClosure F) :=
    t.field.map (γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)
  let ϕ_g : t.field ≃ₐ[F] M_g :=
    t.field.equivMap (γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)
  have hγL : γ ∈ L.fixingSubgroup := g.2.2
  have hγ_inv_L : γ⁻¹ ∈ L.fixingSubgroup := L.fixingSubgroup.inv_mem g.2.2
  have hF'Mg : F' ≤ M_g := by
    intro x hx
    have hx_inv : γ⁻¹ x ∈ F' := helper_galois_map_mem F' hLF' hGalF' γ⁻¹ hγ_inv_L x hx
    exact ⟨γ⁻¹ x, hF't hx_inv, γ.apply_symm_apply x⟩
  have hMgMC : M_g ≤ M_C := by
    rintro y ⟨x, hx, rfl⟩
    exact helper_galois_map_mem M_C hLM_C hGalMC γ hγL x (htMC hx)
  have hMgK : M_g ≤ K := hMgMC.trans hM_CK
  have hLMg : L ≤ M_g := hLF'.trans hF'Mg
  have hFinMg : FiniteDimensional F M_g := Module.Finite.equiv ϕ_g.toLinearEquiv
  haveI : FiniteDimensional F M_g := hFinMg
  let σ_g : M_C ≃ₐ[F] M_C :=
    { toFun := fun z => ⟨γ z.1, helper_galois_map_mem M_C hLM_C hGalMC γ hγL z.1 z.2⟩
      invFun := fun z => ⟨γ⁻¹ z.1, helper_galois_map_mem M_C hLM_C hGalMC γ⁻¹ hγ_inv_L z.1 z.2⟩
      left_inv := fun z => Subtype.ext (γ.symm_apply_apply z.1)
      right_inv := fun z => Subtype.ext (γ.apply_symm_apply z.1)
      map_mul' := fun x y => Subtype.ext (map_mul γ x.1 y.1)
      map_add' := fun x y => Subtype.ext (map_add γ x.1 y.1)
      commutes' := fun r => Subtype.ext (γ.commutes r) }
  have hσ_g_coe : ∀ z : M_C, (σ_g z : AlgebraicClosure F) = γ (z : AlgebraicClosure F) :=
    fun _ => rfl
  
  have hConj_relWeil : ∀ u : relWeil F M_g, γ⁻¹ * (u : AbsGal F) * γ ∈ relWeil F t.field := by
    intro u
    refine ⟨(weilGroup F).mul_mem ((weilGroup F).mul_mem ((weilGroup F).inv_mem g.2.1) u.2.1) g.2.1, ?_⟩
    change γ⁻¹ * (u : AbsGal F) * γ ∈ t.field.fixingSubgroup
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    have hγx : (γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) x ∈ M_g := ⟨x, hx, rfl⟩
    have hu_fix : (u : AbsGal F) (γ x) = γ x :=
      (IntermediateField.mem_fixingSubgroup_iff M_g (u : AbsGal F)).mp u.2.2 (γ x) hγx
    change γ⁻¹ ((u : AbsGal F) (γ x)) = x
    rw [hu_fix]
    exact γ.symm_apply_apply x
  let conjHom_g : relWeil F M_g →* relWeil F t.field :=
    { toFun := fun u => ⟨γ⁻¹ * (u : AbsGal F) * γ, hConj_relWeil u⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := fun u₁ u₂ => Subtype.ext (by
        change γ⁻¹ * ((u₁ : AbsGal F) * (u₂ : AbsGal F)) * γ =
          (γ⁻¹ * (u₁ : AbsGal F) * γ) * (γ⁻¹ * (u₂ : AbsGal F) * γ)
        group) }
  let χ_g : relWeil F M_g →* (Ω F)ˣ := t.χ.comp conjHom_g
  have hχ_g_apply : ∀ (u : relWeil F M_g)
      (hu : γ⁻¹ * (u : AbsGal F) * γ ∈ relWeil F t.field),
      χ_g u = t.χ ⟨γ⁻¹ * (u : AbsGal F) * γ, hu⟩ := fun _ _ => rfl
  have hχ_ker_K : ∀ w : relWeil F t.field, (w : AbsGal F) ∈ K.fixingSubgroup → t.χ w = 1 := by
    intro w hwK
    let w_K : relWeil F K := ⟨w.1, ⟨w.2.1, hwK⟩⟩
    have h1 : restrictWeilChar F htK t.χ w_K = 1 := by
      rw [ht_restK, MonoidHom.one_apply]
    exact h1
  have hχg_ker_K : ∀ u : relWeil F M_g, (u : AbsGal F) ∈ K.fixingSubgroup → χ_g u = 1 := by
    intro u huK
    have hconjK : γ⁻¹ * (u : AbsGal F) * (γ⁻¹)⁻¹ ∈ K.fixingSubgroup :=
      hGal.2.2.1 γ⁻¹ hγ_inv_L (u : AbsGal F) huK
    rw [inv_inv] at hconjK
    exact hχ_ker_K (conjHom_g u) hconjK
  have hχg_weil : IsWeilRep F M_g (charRep F M_g χ_g) := by
    let U_K : Set (AbsGal F) := (K.fixingSubgroup : Set (AbsGal F))
    have hUK_nhds : U_K ∈ nhds (1 : AbsGal F) :=
      (krullTopology_mem_nhds_one_iff F (AlgebraicClosure F) U_K).mpr ⟨K, inferInstance, Set.Subset.rfl⟩
    refine ⟨inferInstance, U_K, hUK_nhds, fun u huU _ => ?_⟩
    apply LinearMap.ext
    intro v
    change (χ_g u : Ω F) • v = v
    rw [hχg_ker_K u huU, Units.val_one, one_smul]
  have hGalF'K : IsGaloisExt F F' K :=
    ((ld_galois_closure_directed_system F).2.1 L F' K hLF' (hF'MC.trans hM_CK) hGal).1
  have hSepF'Mg : Algebra.IsSeparable F' (IntermediateField.extendScalars hF'Mg) :=
    h_sep_sub F' M_g K (hF'MC.trans hM_CK) hF'Mg hMgK (hGalF'K.2.2.2 (hF'MC.trans hM_CK))
  have htg_wf : (⟨1, M_g, hF'Mg, χ_g⟩ : MonomialTerm F F').Wf F F' :=
    ⟨hFinMg, hSepF'Mg, hχg_weil⟩
  
  have hψ_Ft : IsAdmissibleChar F t.field (traceChar F t.le ψ) :=
    ((htraceChar L t.field t.le hSepLFt).2 ψ hψ).1
  have hSepLMg : Algebra.IsSeparable L (IntermediateField.extendScalars hLMg) :=
    h_sep_sub L M_g K hLK hLMg hMgK (hGal.2.2.2 hLK)
  have hψ_Mg : IsAdmissibleChar F M_g (traceChar F hLMg ψ) :=
    ((htraceChar L M_g hLMg hSepLMg).2 ψ hψ).1
  let ϕ_gL : IntermediateField.extendScalars t.le ≃ₐ[L] IntermediateField.extendScalars hLMg :=
    { toFun := fun x =>
        ⟨(ϕ_g ⟨x.1, (IntermediateField.mem_extendScalars t.le).mp x.2⟩).1,
          (IntermediateField.mem_extendScalars hLMg).mpr
            (ϕ_g ⟨x.1, (IntermediateField.mem_extendScalars t.le).mp x.2⟩).2⟩
      invFun := fun y =>
        ⟨(ϕ_g.symm ⟨y.1, (IntermediateField.mem_extendScalars hLMg).mp y.2⟩).1,
          (IntermediateField.mem_extendScalars t.le).mpr
            (ϕ_g.symm ⟨y.1, (IntermediateField.mem_extendScalars hLMg).mp y.2⟩).2⟩
      left_inv := fun x => Subtype.ext (congrArg Subtype.val (ϕ_g.symm_apply_apply ⟨x.1, _⟩))
      right_inv := fun y => Subtype.ext (congrArg Subtype.val (ϕ_g.apply_symm_apply ⟨y.1, _⟩))
      map_mul' := fun x y => Subtype.ext (congrArg Subtype.val (map_mul ϕ_g ⟨x.1, _⟩ ⟨y.1, _⟩))
      map_add' := fun x y => Subtype.ext (congrArg Subtype.val (map_add ϕ_g ⟨x.1, _⟩ ⟨y.1, _⟩))
      commutes' := fun r => Subtype.ext (by
        change ((ϕ_g ⟨r.1, t.le r.2⟩ : M_g) : AlgebraicClosure F) = r.1
        rw [IntermediateField.coe_equivMap_apply]
        exact (IntermediateField.mem_fixingSubgroup_iff L γ).mp hγL r.1 r.2) }
