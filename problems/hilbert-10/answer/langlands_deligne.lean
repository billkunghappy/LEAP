    set w₂ := cosetRep u₂
    have hw₁ : w₁ ∈ unitGroup F M m := (hmem_H u₁).mp hu₁
    have hw₂ : w₂ ∈ unitGroup F M m := (hmem_H u₂).mp hu₂
    have hmul_eq : u₁ * u₂ = QuotientGroup.mk (s := unitGroup F M a) (w₁ * w₂) := by
