  rcases hvalL_surj (e : ℤ) with ⟨c_e, hc_e⟩
  have hc_e_ne : (c_e : L) ≠ 0 := c_e.ne_zero
  rcases htr_surj_E' (c_e : L) with ⟨y_e, hy_e_tr, _, hy_e_ne_val⟩
  rcases hy_e_ne_val hc_e_ne with ⟨hy_e_ne, hy_e_val_raw⟩
  have hy_e_val : valL F E' y_e = 0 := by omega
  rcases hBasis_E' y_e with ⟨c, hy_e_eq, hy_e_iff⟩
  let r_e : E' := IntermediateField.inclusion hLE' (c 1) * (ϖ_E' : E')
  have hy_e_decomp : y_e = IntermediateField.inclusion hLE' (c 0) + r_e := by
    rw [hy_e_eq, Fin.sum_univ_two]
    simp [r_e]
  have hy_e_0 := (hy_e_iff 0).mp (Or.inr (by omega))
  have hc0_raw := hy_e_0 0
  have hc1_raw := hy_e_0 1
  simp only [Fin.val_zero, Nat.cast_zero, add_zero] at hc0_raw
  simp only [Fin.val_one, Nat.cast_one] at hc1_raw
  have hc0_dom : c 0 = 0 ∨ 0 ≤ valL F L (c 0) := by
    rcases hc0_raw with h0 | hge
    · exact Or.inl h0
    · right; omega
  have hc1_dom : c 1 = 0 ∨ 0 ≤ valL F L (c 1) := by
    rcases hc1_raw with h0 | hge
    · exact Or.inl h0
    · right; omega
  have hr_e_dom : r_e = 0 ∨ 1 ≤ valL F E' r_e := by
    by_cases hc1_zero : c 1 = 0
