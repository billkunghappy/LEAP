      have h_rel' := (QuotientGroup.eq (s := N'₁)).mp h_mk_eq
      have h_rel : (a.1 * c.1 * a.1⁻¹)⁻¹ * c.1 ∈ N₁ := h_rel'
      have h_comm : a.1 * c.1 * a.1⁻¹ * c.1⁻¹ ∈ N₁ := (hN₁_comm_iff (a.1 * c.1 * a.1⁻¹) c.1).mpr h_rel
      have ha_N₁ : a.1 ∈ N₁ := hFree a.1 a.2 c.1 c.2 hc_not h_comm
      exact (QuotientGroup.eq_one_iff a).mpr ha_N₁
    let setoid : Setoid S₁ :=
      { r := fun x₁ x₂ => ∃ g : HF_bar, act g x₁ = x₂
        iseqv :=
          { refl := fun x => ⟨1, hact_one x⟩
            symm := by
              rintro x₁ x₂ ⟨g, rfl⟩
              refine ⟨g⁻¹, ?_⟩
              rw [← hact_mul, inv_mul_cancel, hact_one]
            trans := by
              rintro x₁ x₂ x₃ ⟨g₁, rfl⟩ ⟨g₂, rfl⟩
              exact ⟨g₂ * g₁, hact_mul g₂ g₁ x₁⟩ } }
    let F_orb : (Quotient setoid) × HF_bar → S₁ :=
      fun p => act p.2 (Quotient.out p.1)
    have hF_inj : Function.Injective F_orb := by
      rintro ⟨o₁, g₁⟩ ⟨o₂, g₂⟩ h_eq
      dsimp [F_orb] at h_eq
      have h_rel : setoid.r (Quotient.out o₁) (Quotient.out o₂) := by
        refine ⟨g₂⁻¹ * g₁, ?_⟩
        rw [hact_mul, h_eq, ← hact_mul, inv_mul_cancel, hact_one]
      have ho_eq : o₁ = o₂ := by
        rw [← Quotient.out_eq o₁, ← Quotient.out_eq o₂]
        exact Quotient.sound h_rel
      subst ho_eq
      have hg_eq : g₁ = g₂ := hact_free g₁ g₂ (Quotient.out o₁) h_eq
      rw [hg_eq]
    have hF_surj : Function.Surjective F_orb := by
      intro x
      let o : Quotient setoid := Quotient.mk setoid x
      have h_rel : setoid.r (Quotient.out o) x := Quotient.mk_out x
      rcases h_rel with ⟨g, hg⟩
      exact ⟨(o, g), hg⟩
    let e_orb : (Quotient setoid) × HF_bar ≃ S₁ := Equiv.ofBijective F_orb ⟨hF_inj, hF_surj⟩
    have hcard_prod : Nat.card (Quotient setoid) * H_L'.index = r * H_L'.index := by
      calc Nat.card (Quotient setoid) * H_L'.index
          = Nat.card (Quotient setoid) * Nat.card HF_bar := by rw [hcard_HF]
        _ = Nat.card ((Quotient setoid) × HF_bar) := (Nat.card_prod _ _).symm
        _ = Nat.card S₁ := Nat.card_congr e_orb
        _ = q₀ - 1 := hcard_S₁
        _ = r * H_L'.index := hr.symm
    have hcard_orb : Fintype.card (Quotient setoid) = r := by
      rw [← Nat.card_eq_fintype_card]
      exact Nat.mul_right_cancel (by omega : 0 < H_L'.index) hcard_prod
    let e_r : Fin r ≃ Quotient setoid :=
      (Fintype.equivFinOfCardEq hcard_orb).symm
    let r_rep (a : Fin r) : H_L' := Quotient.out (Quotient.out (e_r a)).1
    let c_rep (a : Fin r) : H := (r_rep a).1⁻¹
    have hr_rep_mk : ∀ a : Fin r, QuotientGroup.mk (s := N'₁) (r_rep a) = (Quotient.out (e_r a)).1 :=
      fun a => Quotient.out_eq _
    have hr_rep_not_N₁ : ∀ a : Fin r, (r_rep a).1 ∉ N₁ := by
      intro a h_in
      apply (Quotient.out (e_r a)).2
      rw [← hr_rep_mk a]
      exact (QuotientGroup.eq_one_iff (r_rep a)).mpr h_in
    refine ⟨c_rep, ?_, ?_⟩
    · intro a
      refine ⟨H_L'.inv_mem (r_rep a).2, ?_⟩
      intro h_in
      have hr_in : (r_rep a).1 ∈ N₁ := by
        have : ((r_rep a).1⁻¹)⁻¹ ∈ N₁ := N₁.inv_mem h_in
        simpa only [inv_inv] using this
      exact hr_rep_not_N₁ a hr_in
    · intro y hy hy_not
      have hy_ne1 : (QuotientGroup.mk (s := N'₁) ⟨y, hy⟩ : C1_bar) ≠ 1 := by
        intro h_eq
        exact hy_not ((QuotientGroup.eq_one_iff (⟨y, hy⟩ : H_L')).mp h_eq)
      let s_y : S₁ := ⟨QuotientGroup.mk (s := N'₁) ⟨y, hy⟩, hy_ne1⟩
      let p₀ := e_orb.symm s_y
      let a₀ : Fin r := e_r.symm p₀.1
      let g₀_sub : H_F' := Quotient.out p₀.2
      refine ⟨a₀, g₀_sub.1, g₀_sub.2, ?_⟩
      intro a g hg
      have h_lhs_iff : g * (c_rep a)⁻¹ * g⁻¹ * y⁻¹ ∈ N₁ ↔
          e_orb (e_r a, QuotientGroup.mk (s := N_F1) ⟨g, hg⟩) = s_y := by
        have hc_inv : (c_rep a)⁻¹ = (r_rep a).1 := inv_inv _
        rw [hc_inv, hN₁_comm_iff (g * (r_rep a).1 * g⁻¹) y]
        have h_act_val : (e_orb (e_r a, QuotientGroup.mk (s := N_F1) ⟨g, hg⟩)).1 =
            QuotientGroup.mk (s := N'₁) ⟨g * (r_rep a).1 * g⁻¹, hHL'_norm.conj_mem (r_rep a).1 (r_rep a).2 g⟩ := by
          change act₀ (QuotientGroup.mk (s := N_F1) ⟨g, hg⟩) (Quotient.out (e_r a)).1 = _
          rw [← hr_rep_mk a]
          rfl
        have hs_y_val : s_y.1 = QuotientGroup.mk (s := N'₁) ⟨y, hy⟩ := rfl
        rw [Subtype.ext_iff, h_act_val, hs_y_val, QuotientGroup.eq (s := N'₁)]
        rfl
      rw [h_lhs_iff, e_orb.apply_eq_iff_eq_symm_apply, Prod.ext_iff]
      have ha_iff : e_r a = p₀.1 ↔ a = a₀ := e_r.apply_eq_iff_eq_symm_apply
      have hg_iff : QuotientGroup.mk (s := N_F1) ⟨g, hg⟩ = p₀.2 ↔ g⁻¹ * g₀_sub.1 ∈ N₁ := by
        have h_out : QuotientGroup.mk (s := N_F1) g₀_sub = p₀.2 := Quotient.out_eq p₀.2
        rw [← h_out, QuotientGroup.eq (s := N_F1)]
        rfl
      rw [ha_iff, hg_iff]

theorem ld_ch14_metacyclic_schur_zassenhaus_conjugate_exists (H : Type u) [Group H] [Fintype H]
    (H₀ N₀ H_F' : Subgroup H) [H₀.Normal] [N₀.Normal] [IsCyclic (H ⧸ H₀)]
    (q₀ : ℕ) (hq₀_prime : Nat.Prime q₀)
    (hcop : Nat.Coprime q₀ H₀.index)
    (hN₀_le_H₀ : N₀ ≤ H₀) (hN₀_le_HF' : N₀ ≤ H_F')
    (hN₀_idx : (N₀.subgroupOf H₀).index = q₀)
    (hH₀_pow : ∀ c ∈ H₀, c ^ q₀ ∈ N₀)
    (hH₀_comm : ∀ a ∈ H₀, ∀ b ∈ H₀, a * b = b * a)
    (hHF'_H₀_inf : ∀ h : H, h ∈ H_F' → h ∈ H₀ → h ∈ N₀)
    (hHF'_H₀_mul : ∀ h : H, ∃ x ∈ H_F', ∃ c ∈ H₀, h = x * c)
    (H_t : Subgroup H)
    (hHt_disj : ∀ h ∈ H_t, h ∈ H₀ → h = 1) :
    ∃ (c_t : H) (K_t : Subgroup H),
      c_t ∈ H₀ ∧
      (∀ h : H, h ∈ K_t ↔ c_t⁻¹ * h * c_t ∈ H_t) ∧
      K_t ≤ H_F' :=
by
  let π_t : H_t →* H ⧸ H₀ := (QuotientGroup.mk' H₀).comp H_t.subtype
  have hπ_t_inj : Function.Injective π_t := by
    rw [← MonoidHom.ker_eq_bot_iff, Subgroup.eq_bot_iff_forall]
    intro x hx
    have hx_ker : x.1 ∈ (QuotientGroup.mk' H₀).ker := hx
    rw [QuotientGroup.ker_mk' H₀] at hx_ker
    exact Subtype.ext (hHt_disj x.1 x.2 hx_ker)
  haveI : IsCyclic H_t := isCyclic_of_injective π_t hπ_t_inj
  obtain ⟨g_t, hg_t⟩ := IsCyclic.exists_generator (α := H_t)
  let f₀ : ℕ := H₀.index
  have hgt_pow : (g_t.1) ^ f₀ = 1 :=
    hHt_disj ((g_t.1) ^ f₀) (H_t.pow_mem g_t.2 f₀) (Subgroup.pow_index_mem H₀ g_t.1)
  obtain ⟨x_t, hx_t, y_t, hy_t, hgt_eq⟩ := hHF'_H₀_mul g_t.1
  have hconj_gt : ∀ c ∈ H₀,
      c * g_t.1 * c⁻¹ = x_t * ((x_t⁻¹ * c * x_t * c⁻¹) * y_t) := by
    intro c hc
    have hcy : y_t * c⁻¹ = c⁻¹ * y_t := by
      calc y_t * c⁻¹ = c⁻¹ * (c * y_t) * c⁻¹ := by group
        _ = c⁻¹ * (y_t * c) * c⁻¹ := by rw [hH₀_comm c hc y_t hy_t]
        _ = c⁻¹ * y_t := by group
    calc c * g_t.1 * c⁻¹
        = c * x_t * (y_t * c⁻¹) := by rw [hgt_eq]; group
      _ = c * x_t * (c⁻¹ * y_t) := by rw [hcy]
      _ = x_t * ((x_t⁻¹ * c * x_t * c⁻¹) * y_t) := by group
  have hγ_mem : ∀ c ∈ H₀, x_t⁻¹ * c * x_t * c⁻¹ ∈ H₀ := by
    intro c hc
    have hconj : x_t⁻¹ * c * x_t ∈ H₀ := by
      simpa using ‹H₀.Normal›.conj_mem c hc x_t⁻¹
    exact H₀.mul_mem hconj (H₀.inv_mem hc)
  let γ : H₀ →* H₀ :=
    { toFun := fun c => ⟨x_t⁻¹ * c.1 * x_t * c.1⁻¹, hγ_mem c.1 c.2⟩
      map_one' := by ext; simp
      map_mul' := by
        intro a b
        ext
        dsimp
        have hcomm : (x_t⁻¹ * b.1 * x_t * b.1⁻¹) * a.1⁻¹ =
            a.1⁻¹ * (x_t⁻¹ * b.1 * x_t * b.1⁻¹) :=
          hH₀_comm _ (hγ_mem b.1 b.2) a.1⁻¹ (H₀.inv_mem a.2)
        calc x_t⁻¹ * (a.1 * b.1) * x_t * (a.1 * b.1)⁻¹
            = (x_t⁻¹ * a.1 * x_t) * ((x_t⁻¹ * b.1 * x_t * b.1⁻¹) * a.1⁻¹) := by group
          _ = (x_t⁻¹ * a.1 * x_t) * (a.1⁻¹ * (x_t⁻¹ * b.1 * x_t * b.1⁻¹)) := by rw [hcomm]
          _ = (x_t⁻¹ * a.1 * x_t * a.1⁻¹) * (x_t⁻¹ * b.1 * x_t * b.1⁻¹) := by group }
  have hex_ct : ∃ c_t ∈ H₀, c_t * g_t.1 * c_t⁻¹ ∈ H_F' := by
    by_cases hcent : ∀ c ∈ H₀, x_t⁻¹ * c * x_t * c⁻¹ ∈ N₀
    · refine ⟨1, H₀.one_mem, ?_⟩
      rw [one_mul, inv_one, mul_one, hgt_eq]
      let π_N₀ : H →* H ⧸ N₀ := QuotientGroup.mk' N₀
      have hπ_N₀_ker : ∀ z ∈ N₀, π_N₀ z = 1 := by
        intro z hz
        change z ∈ π_N₀.ker
        rwa [QuotientGroup.ker_mk' N₀]
      have hcomm_bar : Commute (π_N₀ x_t) (π_N₀ y_t) := by
        rw [commute_iff_eq]
        calc π_N₀ x_t * π_N₀ y_t
            = π_N₀ x_t * 1 * π_N₀ y_t := by group
          _ = π_N₀ x_t * π_N₀ (x_t⁻¹ * y_t * x_t * y_t⁻¹) * π_N₀ y_t := by
              rw [hπ_N₀_ker _ (hcent y_t hy_t)]
          _ = π_N₀ (x_t * (x_t⁻¹ * y_t * x_t * y_t⁻¹) * y_t) := by
              simp only [map_mul]
          _ = π_N₀ (y_t * x_t) := by
              congr 1; group
          _ = π_N₀ y_t * π_N₀ x_t := map_mul π_N₀ y_t x_t
      have hpow_bar : π_N₀ ((x_t ^ f₀) * (y_t ^ f₀)) = 1 := by
        rw [map_mul, map_pow, map_pow, ← hcomm_bar.mul_pow f₀, ← map_mul,
          ← hgt_eq, ← map_pow, hgt_pow, map_one]
      have hxy_N₀ : (x_t ^ f₀) * (y_t ^ f₀) ∈ N₀ :=
        (QuotientGroup.ker_mk' N₀) ▸ hpow_bar
      have hy_f₀_HF' : y_t ^ f₀ ∈ H_F' := by
        have hmul_HF' : (x_t ^ f₀)⁻¹ * ((x_t ^ f₀) * (y_t ^ f₀)) ∈ H_F' :=
          H_F'.mul_mem (H_F'.inv_mem (H_F'.pow_mem hx_t f₀)) (hN₀_le_HF' hxy_N₀)
        rwa [inv_mul_cancel_left] at hmul_HF'
      have hy_f₀_N₀ : y_t ^ f₀ ∈ N₀ :=
        hHF'_H₀_inf (y_t ^ f₀) hy_f₀_HF' (H₀.pow_mem hy_t f₀)
      have hybar_f₀ : (π_N₀ y_t) ^ f₀ = 1 := by
        rw [← map_pow]
        exact hπ_N₀_ker _ hy_f₀_N₀
      have hybar_q₀ : (π_N₀ y_t) ^ q₀ = 1 := by
        rw [← map_pow]
        exact hπ_N₀_ker _ (hH₀_pow y_t hy_t)
      let u : ℤ := q₀.gcdA f₀
      let v : ℤ := q₀.gcdB f₀
      have hbez : (q₀ : ℤ) * u + (f₀ : ℤ) * v = 1 := by
        have h := Nat.gcd_eq_gcd_ab q₀ f₀
        rw [hcop.gcd_eq_one] at h
        exact_mod_cast h.symm
      have hybar_one : π_N₀ y_t = 1 := by
        calc π_N₀ y_t = (π_N₀ y_t) ^ (1 : ℤ) := (zpow_one _).symm
          _ = (π_N₀ y_t) ^ ((q₀ : ℤ) * u + (f₀ : ℤ) * v) := by rw [hbez]
          _ = ((π_N₀ y_t) ^ q₀) ^ u * ((π_N₀ y_t) ^ f₀) ^ v := by
              rw [zpow_add, zpow_mul, zpow_mul, zpow_natCast, zpow_natCast]
          _ = 1 := by rw [hybar_q₀, hybar_f₀, one_zpow, one_zpow, mul_one]
      have hy_N₀ : y_t ∈ N₀ := (QuotientGroup.ker_mk' N₀) ▸ hybar_one
      exact H_F'.mul_mem hx_t (hN₀_le_HF' hy_N₀)
    · push_neg at hcent
      obtain ⟨c₀, hc₀, hc₀_not_N₀⟩ := hcent
      let N₀_sub : Subgroup H₀ := N₀.subgroupOf H₀
      let π_C₀ : H₀ →* H₀ ⧸ N₀_sub := QuotientGroup.mk' N₀_sub
      haveI : Fact (Nat.Prime (Nat.card (H₀ ⧸ N₀_sub))) :=
        ⟨by rw [← Subgroup.index_eq_card N₀_sub, hN₀_idx]; exact hq₀_prime⟩
      let d₀ : H₀ := γ ⟨c₀, hc₀⟩
      let dbar₀ : H₀ ⧸ N₀_sub := π_C₀ d₀
      have hdbar₀_ne : dbar₀ ≠ 1 := by
        intro h_eq
        have hd₀_ker : d₀ ∈ π_C₀.ker := h_eq
        rw [QuotientGroup.ker_mk' N₀_sub, Subgroup.mem_subgroupOf] at hd₀_ker
        exact hc₀_not_N₀ hd₀_ker
      have hzp_top : Subgroup.zpowers dbar₀ = ⊤ := by
        rcases Subgroup.eq_bot_or_eq_top_of_prime_card (Subgroup.zpowers dbar₀) with hbot | htop
        · exact False.elim (hdbar₀_ne (Subgroup.zpowers_eq_bot.mp hbot))
        · exact htop
      have hy_inv_mem : (π_C₀ ⟨y_t, hy_t⟩)⁻¹ ∈ Subgroup.zpowers dbar₀ := by
        rw [hzp_top]; exact Subgroup.mem_top _
      obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hy_inv_mem
      let c_t_sub : H₀ := ⟨c₀, hc₀⟩ ^ k
      refine ⟨c_t_sub.1, c_t_sub.2, ?_⟩
      rw [hconj_gt c_t_sub.1 c_t_sub.2]
      have hprod_ker : π_C₀ (γ c_t_sub * ⟨y_t, hy_t⟩) = 1 := by
        rw [map_mul, map_zpow, map_zpow]
        change dbar₀ ^ k * π_C₀ ⟨y_t, hy_t⟩ = 1
        rw [hk, inv_mul_cancel]
      have hprod_N₀ : (x_t⁻¹ * c_t_sub.1 * x_t * c_t_sub.1⁻¹) * y_t ∈ N₀ := by
        have hmem : γ c_t_sub * ⟨y_t, hy_t⟩ ∈ π_C₀.ker := hprod_ker
        rw [QuotientGroup.ker_mk' N₀_sub, Subgroup.mem_subgroupOf] at hmem
        exact hmem
      exact H_F'.mul_mem hx_t (hN₀_le_HF' hprod_N₀)
  obtain ⟨c_t, hc_t, hconj_mem⟩ := hex_ct
  let K_t : Subgroup H :=
    { carrier := {h : H | c_t⁻¹ * h * c_t ∈ H_t}
      one_mem' := by simp [H_t.one_mem]
      mul_mem' := by
        intro a b ha hb
        have hmul : c_t⁻¹ * (a * b) * c_t = (c_t⁻¹ * a * c_t) * (c_t⁻¹ * b * c_t) := by group
        change c_t⁻¹ * (a * b) * c_t ∈ H_t
        rw [hmul]
        exact H_t.mul_mem ha hb
      inv_mem' := by
        intro a ha
        have hinv : c_t⁻¹ * a⁻¹ * c_t = (c_t⁻¹ * a * c_t)⁻¹ := by group
        change c_t⁻¹ * a⁻¹ * c_t ∈ H_t
        rw [hinv]
        exact H_t.inv_mem ha }
  refine ⟨c_t, K_t, hc_t, fun _ => Iff.rfl, ?_⟩
  intro h hh
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hg_t ⟨c_t⁻¹ * h * c_t, hh⟩)
  have hm_val : (g_t.1) ^ m = c_t⁻¹ * h * c_t := by
    simpa [Subgroup.coe_zpow] using congrArg Subtype.val hm
  have hh_eq : h = (c_t * g_t.1 * c_t⁻¹) ^ m := by
    have h1 : c_t * (c_t⁻¹ * h * c_t) * c_t⁻¹ = h := by group
    have h2 : c_t * (g_t.1) ^ m * c_t⁻¹ = (c_t * g_t.1 * c_t⁻¹) ^ m := by
      simpa [MulAut.conj_apply] using map_zpow (MulAut.conj c_t) g_t.1 m
    rw [← h1, ← hm_val, h2]
  rw [hh_eq]
  exact H_F'.zpow_mem hconj_mem m

theorem ld_ch14_orbit_term_galois_conj_and_sub_eval (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (hGal : IsGaloisExt F L K) (hGalMC : IsGaloisExt F L M_C) (hGalMCK : IsGaloisExt F M_C K)
    (hAbMCK : IsAbelianExt F hM_CK)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (χL_ext : relWeil F L →* (Ω F)ˣ) (hχL_ext : IsWeilRep F L (charRep F L χL_ext))
    (hp_prime : Nat.Prime (p F))
    (F_s : IntermediateField F (AlgebraicClosure F))
    (hLFs : L ≤ F_s) (hFsMC : F_s ≤ M_C)
    (χ_s : relWeil F F_s →* (Ω F)ˣ)
    (hχ_s_weil : IsWeilRep F F_s (charRep F F_s χ_s))
    (hχ_s_pow : χ_s ^ (p F) = 1)
    (hχ_s_restK : restrictWeilChar F (hFsMC.trans hM_CK) χ_s = 1)
    (hχ_s_restE : ∃ hsE : F_s ≤ E ⊔ F_s, restrictWeilChar F hsE χ_s = 1)
    (hχ_s_neMC : restrictWeilChar F hFsMC χ_s ≠ 1)
    (g : relWeil F L) (hgE : (g : AbsGal F) ∈ E.fixingSubgroup) :
    let γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F := (g : AbsGal F)
    let F_g : IntermediateField F (AlgebraicClosure F) := F_s.map γ
    ∃ (hLFg : L ≤ F_g) (hFgMC : F_g ≤ M_C)
      (χ_g : relWeil F F_g →* (Ω F)ˣ),
      (∀ (w : relWeil F F_g)
        (hw : (g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F) ∈ relWeil F F_s),
        χ_g w = χ_s ⟨(g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F), hw⟩) ∧
      (∀ x : AlgebraicClosure F, x ∈ F_g ↔ (g : AbsGal F)⁻¹ x ∈ F_s) ∧
      IsWeilRep F F_g (charRep F F_g χ_g) ∧
      χ_g ^ (p F) = 1 ∧
      restrictWeilChar F (hFgMC.trans hM_CK) χ_g = 1 ∧
      (∃ hgE' : F_g ≤ E ⊔ F_g, restrictWeilChar F hgE' χ_g = 1) ∧
      restrictWeilChar F hFgMC χ_g ≠ 1 ∧
