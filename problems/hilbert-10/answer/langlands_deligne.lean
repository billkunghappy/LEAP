  have htr_smul : ∀ (c : L) (z : M₁'),
      traceLM F hLM₁' (IntermediateField.inclusion hLM₁' c * z) = c * traceLM F hLM₁' z := by
    intro c z
    by_cases hc : c = 0
    · subst hc; simp
    · have h1 := (hQuadM₁'.2 c (IntermediateField.inclusion hLM₁' c * z)).1
      have hfac : IntermediateField.inclusion hLM₁' c + IntermediateField.inclusion hLM₁' c * z =
          IntermediateField.inclusion hLM₁' c * (IntermediateField.inclusion hLM₁' 1 + z) := by
        rw [map_one]; ring
      rw [hfac, (normLM F hLM₁').map_mul, (normLM F hLM₁').map_mul, hnorm_incl c, (hQuadM₁'.2 1 z).1] at h1
      have h2 : c * (traceLM F hLM₁' (IntermediateField.inclusion hLM₁' c * z) - c * traceLM F hLM₁' z) = 0 := by
        linear_combination -h1
      exact sub_eq_zero.mp ((mul_eq_zero.mp h2).resolve_left hc)
  have hNormPhaseM₁'' : ∀ v : M₁', (v = 0 ∨ (a : ℤ) ≤ valL F M₁' v) →
      ψ (((α'⁻¹ : Lˣ) : L) * (-4 * f) * (traceLM F hLM₁' v + normLM F hLM₁' v)) = 1 := by
    intro v hv
    have h_old := hNormPhaseM₁' v hv
    obtain ⟨s₀, s₁, hv_eq, hv_iff⟩ := hM₁'_coords v
    obtain ⟨hs₀_raw, hs₁_raw⟩ := (hv_iff (a : ℤ)).mp hv
    have hs₀_ge : s₀ = 0 ∨ 0 ≤ valL F L s₀ := by
      rcases hs₀_raw with rfl | hle
      · exact Or.inl rfl
      · right; omega
    have hs₁_ge : s₁ = 0 ∨ (a : ℤ) ≤ valL F L s₁ := by
      rcases hs₁_raw with rfl | hle
      · exact Or.inl rfl
      · right; omega
    have htr_v_eq : traceLM F hLM₁' v = (2 : L) * s₀ - s₁ := by
      rw [hv_eq, map_add, hQuadM₁'.1 s₀, htr_smul s₁ x, hx_tr]
      ring
    have htr_v_ge : traceLM F hLM₁' v = 0 ∨ (a : ℤ) ≤ valL F L (traceLM F hLM₁' v) := by
      rw [htr_v_eq]
      exact hL_sub (hL_mono (by omega) (hL_mul h2_ge hs₀_ge)) hs₁_ge
    have hnorm_v_ge : normLM F hLM₁' v = 0 ∨ (a : ℤ) ≤ valL F L (normLM F hLM₁' v) := by
      rcases hv with rfl | hle
      · left; exact hnormM₁'_0
      · right; rw [hval_normM₁']; exact hle
    have hsum_ge :
        traceLM F hLM₁' v + normLM F hLM₁' v = 0 ∨
          (a : ℤ) ≤ valL F L (traceLM F hLM₁' v + normLM F hLM₁' v) :=
      hL_add htr_v_ge hnorm_v_ge
    have h_split :
        ((α'⁻¹ : Lˣ) : L) * (-4 * f) * (traceLM F hLM₁' v + normLM F hLM₁' v) =
          ((α⁻¹ : Lˣ) : L) * (-4 * f) * (traceLM F hLM₁' v + normLM F hLM₁' v) +
            (((α⁻¹ : Lˣ) : L) * δ_u) * (β₁ * (traceLM F hLM₁' v + normLM F hLM₁' v)) := by
      rw [hα'_inv_eq]; dsimp [β₁]; ring
    have h_triv :
        ψ ((((α⁻¹ : Lˣ) : L) * δ_u) * (β₁ * (traceLM F hLM₁' v + normLM F hLM₁' v))) = 1 :=
      hSpecL.1 _ (hL_mono (by omega) (hL_mul hα_δ_ge (hL_mul hβ₁_ge hsum_ge)))
    rw [h_split, ψ.map_add_eq_mul, h_old, h_triv, mul_one]
  have hx_ge : x = 0 ∨ 1 - 2 * (a : ℤ) ≤ valL F M₁' x := Or.inr (by rw [hx_val])
  have ha₁_ge : a₁ = 0 ∨ 1 - 2 * (a : ℤ) ≤ valL F M₁' a₁ := by
    dsimp [a₁]
    exact hM₁'_sub (hM₁'_mono (by omega) (hM₁'_incl hE_ge)) hx_ge
  have h1_2x_ge : (1 : M₁') + 2 * x = 0 ∨ 0 ≤ valL F M₁' ((1 : M₁') + 2 * x) := by
    have h2_M₁' : (2 : M₁') = IntermediateField.inclusion hLM₁' (2 : L) := (map_ofNat _ 2).symm
    have h2x_ge : (2 : M₁') * x = 0 ∨ 0 ≤ valL F M₁' ((2 : M₁') * x) := by
      rw [h2_M₁']
      exact hM₁'_mono (by omega) (hM₁'_mul (hM₁'_incl h2_ge) hx_ge)
    exact hM₁'_add (Or.inr (by rw [hvalM₁'_props.2.1])) h2x_ge
  have hCommM₁'' : ∀ s₀ : L, (s₀ = 0 ∨ (((e + 1 : ℕ) : ℤ)) ≤ valL F L s₀) →
      1 - IntermediateField.inclusion hLM₁' s₀ * x ≠ 0 ∧
      ∀ hu₁ : 1 - IntermediateField.inclusion hLM₁' s₀ * x ≠ 0,
        let u₁ : M₁'ˣ := Units.mk0 (1 - IntermediateField.inclusion hLM₁' s₀ * x) hu₁
        let v₁ : M₁'ˣ := (Units.map τ₁.toRingEquiv.toMonoidHom u₁) * u₁⁻¹
        (θM₁' v₁ : Ω F) =
          (traceChar F hLM₁' ψ)
            (IntermediateField.inclusion hLM₁' ((α'⁻¹ : Lˣ) : L) * a₁ * ((v₁ : M₁') - 1)) := by
    intro s₀ hs₀
    obtain ⟨hu₁_ne, hComm_old⟩ := hCommM₁' s₀ hs₀
    refine ⟨hu₁_ne, fun hu₁ => ?_⟩
    intro u₁ v₁
    have h_old : (θM₁' v₁ : Ω F) =
        (traceChar F hLM₁' ψ)
          (IntermediateField.inclusion hLM₁' ((α⁻¹ : Lˣ) : L) * a₁ * ((v₁ : M₁') - 1)) :=
      hComm_old hu₁
    have hs₀x_ge :
        -(IntermediateField.inclusion hLM₁' s₀ * x) = 0 ∨
          0 + 1 ≤ valL F M₁' (-(IntermediateField.inclusion hLM₁' s₀ * x)) :=
      hM₁'_neg (hM₁'_mono (by omega) (hM₁'_mul (hM₁'_incl hs₀) hx_ge))
    have hu₁_dom :
        (1 : M₁') - IntermediateField.inclusion hLM₁' s₀ * x ≠ 0 ∧
          valL F M₁' ((1 : M₁') - IntermediateField.inclusion hLM₁' s₀ * x) = 0 := by
      rw [sub_eq_add_neg]
      exact hM₁'_dom one_ne_zero hvalM₁'_props.2.1 hs₀x_ge
    have hu₁_inv_ge :
        ((u₁⁻¹ : M₁'ˣ) : M₁') = 0 ∨ 0 ≤ valL F M₁' ((u₁⁻¹ : M₁'ˣ) : M₁') := by
      right
      rw [hvalM₁'_props.2.2.2.2.2.1]
      change _ ≤ - valL F M₁' (1 - IntermediateField.inclusion hLM₁' s₀ * x)
      rw [hu₁_dom.2]
      omega
    have hv₁_sub_eq :
        (v₁ : M₁') - 1 =
          IntermediateField.inclusion hLM₁' s₀ * (1 + 2 * x) * ((u₁⁻¹ : M₁'ˣ) : M₁') := by
      have hmul : (1 - IntermediateField.inclusion hLM₁' s₀ * x) * ((u₁⁻¹ : M₁'ˣ) : M₁') = 1 :=
        Units.mul_inv u₁
      have hτ_u₁ :
          τ₁ (1 - IntermediateField.inclusion hLM₁' s₀ * x) =
            1 - IntermediateField.inclusion hLM₁' s₀ * (-1 - x) := by
        rw [map_sub, map_one, map_mul, hτ₁_L s₀, hx_conj]
      calc (v₁ : M₁') - 1
        _ = τ₁ (1 - IntermediateField.inclusion hLM₁' s₀ * x) * ((u₁⁻¹ : M₁'ˣ) : M₁') -
              (1 - IntermediateField.inclusion hLM₁' s₀ * x) * ((u₁⁻¹ : M₁'ˣ) : M₁') := by
            change τ₁ (1 - IntermediateField.inclusion hLM₁' s₀ * x) * ((u₁⁻¹ : M₁'ˣ) : M₁') - 1 = _
            rw [hmul]
        _ = (1 - IntermediateField.inclusion hLM₁' s₀ * (-1 - x)) * ((u₁⁻¹ : M₁'ˣ) : M₁') -
              (1 - IntermediateField.inclusion hLM₁' s₀ * x) * ((u₁⁻¹ : M₁'ˣ) : M₁') := by
            rw [hτ_u₁]
        _ = IntermediateField.inclusion hLM₁' s₀ * (1 + 2 * x) * ((u₁⁻¹ : M₁'ˣ) : M₁') := by ring
    have hv₁_sub_ge : (v₁ : M₁') - 1 = 0 ∨ 2 * (e : ℤ) + 2 ≤ valL F M₁' ((v₁ : M₁') - 1) := by
      rw [hv₁_sub_eq]
      exact hM₁'_mono (by omega)
        (hM₁'_mul (hM₁'_mul (hM₁'_incl hs₀) h1_2x_ge) hu₁_inv_ge)
    have h_split :
        IntermediateField.inclusion hLM₁' ((α'⁻¹ : Lˣ) : L) * a₁ * ((v₁ : M₁') - 1) =
          IntermediateField.inclusion hLM₁' ((α⁻¹ : Lˣ) : L) * a₁ * ((v₁ : M₁') - 1) +
            IntermediateField.inclusion hLM₁' (((α⁻¹ : Lˣ) : L) * δ_u) * a₁ * ((v₁ : M₁') - 1) := by
      rw [hα'_inv_eq, map_add]
      ring
    have h_triv :
        (traceChar F hLM₁' ψ)
          (IntermediateField.inclusion hLM₁' (((α⁻¹ : Lˣ) : L) * δ_u) * a₁ * ((v₁ : M₁') - 1)) = 1 := by
      apply hSpecM₁'
      have h_prod :=
        hM₁'_mul (hM₁'_mul (hM₁'_incl hα_δ_ge) ha₁_ge) hv₁_sub_ge
      exact hM₁'_mono (by rw [hnM₁']; omega) h_prod
    rw [h_old, h_split, (traceChar F hLM₁' ψ).map_add_eq_mul, h_triv, mul_one]
  refine ⟨α', c₀, c₁, c_θ₁, Δ₀, Δ₁,
    hα'_val, hc_ν₂'_stat, hc_ν₁'_stat, hNormPhaseM₁'', hCommM₁'',
    hc_θ₁_val, hc_θ₁_stat, hc₀_val, hc₁_val, hA_dom, ?_, hΔ₀_val⟩
  have hW₀_rescale :
      IntermediateField.inclusion hLM₁' (α' : L) * ((c_θ₁⁻¹ : M₁'ˣ) : M₁') =
        IntermediateField.inclusion hLM₁' (u_rescale : L) *
          (IntermediateField.inclusion hLM₁' P₀ + IntermediateField.inclusion hLM₁' P₁ * x) := by
    calc IntermediateField.inclusion hLM₁' (α' : L) * ((c_θ₁⁻¹ : M₁'ˣ) : M₁')
      _ = IntermediateField.inclusion hLM₁' (u_rescale : L) * W₀ := by
          dsimp [α', W₀]
          rw [map_mul]
          ring
      _ = IntermediateField.inclusion hLM₁' (u_rescale : L) *
            (IntermediateField.inclusion hLM₁' P₀ + IntermediateField.inclusion hLM₁' P₁ * x) := by
          rw [hW₀_eq]
  rw [hW₀_rescale, hΔ₀_eq, hΔ₁_eq]
  dsimp [a₁, G, A]
  simp only [map_add, map_sub, map_mul, map_neg, map_one, map_ofNat]
  ring

theorem ld_ch12_wild_dyadic_odd_max_break_higher_cond_cM1_stationarity (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M₁']
    (hLM₁' : L ≤ M₁')
    (hdeg2_M₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') = 2)
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hSpecL : (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1))
    (hSpecM₁' : ∀ z : M₁',
      (z = 0 ∨ -condExpChar F M₁' (traceChar F hLM₁' ψ) ≤ valL F M₁' z) →
        (traceChar F hLM₁' ψ) z = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hval_normM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = 2 * valL F L x)
    (hnM₁' : condExpChar F M₁' (traceChar F hLM₁' ψ) =
      2 * condExpChar F L ψ + (condExp F L νM₁' : ℤ))
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_odd : condExp F L νE' % 2 = 1)
    (hm1_ge : 2 * condExp F L νE' ≤ condExp F M₁' θM₁')
    (hm1_even : condExp F M₁' θM₁' % 2 = 0)
    (τ₁ : M₁' ≃ₐ[F] M₁')
    (hτ₁_L : ∀ x : L, τ₁ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hτ₁_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) = z + τ₁ z)
    (hτ₁_norm : ∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) = z * τ₁ z)
    (h2_ne : (2 : L) ≠ 0)
    (h2_val : valL F L (2 : L) = ((condExp F L νE' / 2 : ℕ) : ℤ))
    (x : M₁') (f ρ E : L)
    (hx_ne : x ≠ 0) (hf_ne : f ≠ 0) (hρ_ne : ρ ≠ 0)
    (h4f_ρ : 4 * f - ρ = 4 * E)
    (hx_val : valL F M₁' x = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hf_val : valL F L f = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hρ_val : valL F L ρ =
      (2 * ((condExp F L νE' / 2 : ℕ) : ℤ) + 1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hE_val : E = 0 ∨ (1 - ((condExp F L νM₁' / 2 : ℕ) : ℤ)) ≤ valL F L E)
    (hx_tr : traceLM F hLM₁' x = -1)
    (hx_norm : normLM F hLM₁' x = -f)
    (hx_sq : x ^ 2 + x = IntermediateField.inclusion hLM₁' f)
    (hx_conj : τ₁ x = -1 - x)
    (hβ₁ : -4 * f ≠ 0)
    (α' : Lˣ) (c₀ c₁ : L) (c_θ₁ : M₁'ˣ) (Δ₀ Δ₁ : L)
    (hα'_val : valL F L (α' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hNormPhaseM₁'' : ∀ v : M₁', (v = 0 ∨ ((condExp F L νM₁' / 2 : ℕ) : ℤ) ≤ valL F M₁' v) →
      ψ (((α'⁻¹ : Lˣ) : L) * (-4 * f) * (traceLM F hLM₁' v + normLM F hLM₁' v)) = 1)
    (hCommM₁'' : ∀ s₀ : L, (s₀ = 0 ∨ (((condExp F L νE' / 2 : ℕ) + 1 : ℕ) : ℤ) ≤ valL F L s₀) →
      1 - IntermediateField.inclusion hLM₁' s₀ * x ≠ 0 ∧
      ∀ hu₁ : 1 - IntermediateField.inclusion hLM₁' s₀ * x ≠ 0,
        let u₁ : M₁'ˣ := Units.mk0 (1 - IntermediateField.inclusion hLM₁' s₀ * x) hu₁
        let v₁ : M₁'ˣ := (Units.map τ₁.toRingEquiv.toMonoidHom u₁) * u₁⁻¹
        let a₁ : M₁' := IntermediateField.inclusion hLM₁' E - x
        (θM₁' v₁ : Ω F) =
          (traceChar F hLM₁' ψ)
            (IntermediateField.inclusion hLM₁' ((α'⁻¹ : Lˣ) : L) * a₁ * ((v₁ : M₁') - 1)))
    (hc_θ₁_stat : ∀ z : M₁',
      (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (((c_θ₁⁻¹ : M₁'ˣ) : M₁') * z))
    (hc₀_val : c₀ = 0 ∨ -((((condExp F M₁' θM₁' / 2 + condExp F L νM₁' / 2 - (2 * (condExp F L νE' / 2) + 1)) / 2 : ℕ) : ℤ)) ≤ valL F L c₀)
    (hc₁_val : c₁ = 0 ∨ ((condExp F L νM₁' / 2 : ℕ) : ℤ) - ((((condExp F M₁' θM₁' / 2 + condExp F L νM₁' / 2 - (2 * (condExp F L νE' / 2) + 1) + 1) / 2 : ℕ) : ℤ)) ≤ valL F L c₁)
    (hA_ne :
      let u₂ : Lˣ := Units.mk0 (2 : L) h2_ne
      let u₄ : Lˣ := u₂ ^ 2
      let h₀ : L := (1 + 4 * f) * ((u₄⁻¹ : Lˣ) : L) * ρ
      c₀ ^ 2 - c₁ ^ 2 * h₀ ≠ 0)
    (hA_val :
      let u₂ : Lˣ := Units.mk0 (2 : L) h2_ne
      let u₄ : Lˣ := u₂ ^ 2
      let h₀ : L := (1 + 4 * f) * ((u₄⁻¹ : Lˣ) : L) * ρ
      valL F L (c₀ ^ 2 - c₁ ^ 2 * h₀) =
        -((condExp F M₁' θM₁' / 2 + condExp F L νM₁' / 2 - (2 * (condExp F L νE' / 2) + 1) : ℕ) : ℤ))
    (hΔ_eq :
      let u₂ : Lˣ := Units.mk0 (2 : L) h2_ne
      let u₄ : Lˣ := u₂ ^ 2
      let h₀ : L := (1 + 4 * f) * ((u₄⁻¹ : Lˣ) : L) * ρ
      let a₁ : M₁' := IntermediateField.inclusion hLM₁' E - x
      let A := c₀ ^ 2 - c₁ ^ 2 * h₀
      let Q₁ : M₁' := IntermediateField.inclusion hLM₁' (c₁ * ((u₂⁻¹ : Lˣ) : L) * ρ) +
        IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * ρ) * x
      IntermediateField.inclusion hLM₁' (α' : L) * ((c_θ₁⁻¹ : M₁'ˣ) : M₁') -
