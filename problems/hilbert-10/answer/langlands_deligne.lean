    let toSub : ∀ (A : IntermediateField F (AlgebraicClosure F)), F' ≤ A → IntermediateField F' K' :=
      fun A hF'A => (IntermediateField.extendScalars hF'A).comap K'.val
    have h_mem_toSub : ∀ (A : IntermediateField F (AlgebraicClosure F)) (hF'A : F' ≤ A) (x : K'),
