    · exact hv_term_inj_le Y i j hij_le hij
    · exact (hv_term_inj_le Y j i hji_le hij.symm).symm
  have hval_sum_ge : ∀ (Y : Fin p → E') (S : Finset (Fin p)) (m : ℤ),
