        set η_ε : ℤ := quadraticChar k_L (Algebra.norm k_L (resFi i (ε : F_i)))
        set η_Θ : ℤ := quadraticChar k_L (Algebra.norm k_L (resFi i ((Θ_orb i : F_iˣ) : F_i)))
        set η_v₀ : ℤ := quadraticChar k_L (Algebra.norm k_L (resFi i (v₀ : F_i)))
        have h_qchar_vθ : quadraticChar k_L (Algebra.norm k_L ((k : k_Fi i) * resFi i (v_θ : F_i))) =
            s_k ^ (f i) * s_u ^ (f i) * η_ε ^ (a - 1) := by
          rw [h_norm_k, map_mul, map_mul, map_pow, map_pow, map_pow, h_su_inv]
        have hη_ε_sq : η_ε ^ 2 = 1 :=
          quadraticChar_sq_one (Algebra.norm_ne_zero_iff.mpr (hOrb_res i).1)
        have hη_v₀_sq : η_v₀ ^ 2 = 1 :=
          quadraticChar_sq_one (Algebra.norm_ne_zero_iff.mpr (hOrb_res i).2.1)
        have hη_Θ_sq : η_Θ ^ 2 = 1 :=
          quadraticChar_sq_one (Algebra.norm_ne_zero_iff.mpr (hMaster.2.1 i).2)
        have hη_rel : η_Θ * η_ε ^ t = η_v₀ ^ k := by
          have h1 := congrArg (fun x => quadraticChar k_L (Algebra.norm k_L x)) (hOrb_res i).2.2.1
          simpa only [map_mul, map_pow] using h1
        have hη_pow_eq : η_ε ^ (a - 1) = η_Θ ^ (a - 1) := by
          rcases Nat.mod_two_eq_zero_or_one (a - 1) with ha1_even | ha1_odd
          · rw [h_even_pow η_ε hη_ε_sq (a - 1) ha1_even, h_even_pow η_Θ hη_Θ_sq (a - 1) ha1_even]
          · have hk_mod0 : k % 2 = 0 := by
              have h1 : (k * (a - 1)) % 2 = 0 := by omega
              have h2 : (k * (a - 1)) % 2 = (k % 2 * ((a - 1) % 2)) % 2 := Nat.mul_mod k (a - 1) 2
              rw [ha1_odd, mul_one, Nat.mod_mod] at h2
              omega
            have hk_even : 2 ∣ k := Nat.dvd_of_mod_eq_zero hk_mod0
            have ht_not_even : ¬ (2 ∣ t) := fun ht2 => hMaster.1 ⟨ht2, hk_even⟩
            have ht_mod1 : t % 2 = 1 := by omega
            rw [h_odd_pow η_ε hη_ε_sq t ht_mod1, h_even_pow η_v₀ hη_v₀_sq k hk_mod0] at hη_rel
            have hη_eq : η_ε = η_Θ := by
              calc η_ε = η_Θ ^ 2 * η_ε := by rw [hη_Θ_sq, one_mul]
                _ = η_Θ * (η_Θ * η_ε) := by ring
                _ = η_Θ * 1 := by rw [hη_rel]
                _ = η_Θ := mul_one η_Θ
            rw [hη_eq]
        rw [h_qchar_vθ, hη_pow_eq]
      calc (∏ i : Fin D_orb.length,
              oddStatGaussFactor F (D_orb.get i).field
                (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
                (k_Fi i) (ψ_0θ i))
        _ = ∏ i : Fin D_orb.length,
              ((((-1 : ℤ) ^ (f i - 1) *
                (s_k ^ (f i) * s_u ^ (f i) *
                  (quadraticChar k_L (Algebra.norm k_L
                    (resFi i ((Θ_orb i : ((D_orb.get i).field)ˣ) : (D_orb.get i).field)))) ^ (a - 1)) : ℤ) : Ω F) *
                H_L ^ (f i)) := Finset.prod_congr rfl fun i _ => h_term i
        _ = (∏ i : Fin D_orb.length,
              ((((-1 : ℤ) ^ (f i - 1) *
                (s_k ^ (f i) * s_u ^ (f i) *
                  (quadraticChar k_L (Algebra.norm k_L
                    (resFi i ((Θ_orb i : ((D_orb.get i).field)ˣ) : (D_orb.get i).field)))) ^ (a - 1)) : ℤ) : Ω F))) *
            (∏ i : Fin D_orb.length, H_L ^ (f i)) := Finset.prod_mul_distrib
        _ = (((∏ i : Fin D_orb.length,
              ((-1 : ℤ) ^ (f i - 1) *
                (s_k ^ (f i) * s_u ^ (f i) *
                  (quadraticChar k_L (Algebra.norm k_L
                    (resFi i ((Θ_orb i : ((D_orb.get i).field)ˣ) : (D_orb.get i).field)))) ^ (a - 1)))) : ℤ) : Ω F) *
            H_L ^ (∑ i : Fin D_orb.length, f i) := by
          rw [← Int.cast_prod, Finset.prod_pow_eq_pow_sum]
        _ = ((((-1 : ℤ) ^ (u - D_orb.length) * (s_k ^ u * s_u ^ u * s_P ^ (a - 1)) : ℤ) : Ω F)) * H_L ^ u := by
          rw [Finset.prod_mul_distrib, Finset.prod_mul_distrib, Finset.prod_mul_distrib,
            Finset.prod_pow_eq_pow_sum, Finset.prod_pow_eq_pow_sum, Finset.prod_pow_eq_pow_sum,
            Finset.prod_pow, ← map_prod, hf_sub1_sum, hf_sum]
        _ = (((if (k * (a - 1) + 1) % 2 = 1 then
                s_m1 ^ (u * (u + 1) / 2) * s_u ^ u * s_P ^ (u - 1) * s_P ^ (a - 1)
              else 1 : ℤ) : Ω F) *
              H_L ^ (u * ((k * (a - 1) + 1) % 2))) := by
          rw [if_pos hc_odd, hc_odd, mul_one]
          congr 1
          congr 1
          calc (-1 : ℤ) ^ (u - D_orb.length) * (s_k ^ u * s_u ^ u * s_P ^ (a - 1))
            _ = (s_m1 ^ (u * (u + 1) / 2) * s_k ^ u * s_P ^ (u - 1)) *
                  (s_k ^ u * s_u ^ u * s_P ^ (a - 1)) := by rw [h_master_sign]
            _ = (s_m1 ^ (u * (u + 1) / 2) * s_u ^ u * s_P ^ (u - 1) * s_P ^ (a - 1)) *
                  (s_k ^ u) ^ 2 := by ring
            _ = s_m1 ^ (u * (u + 1) / 2) * s_u ^ u * s_P ^ (u - 1) * s_P ^ (a - 1) := by
              rw [h_sku_sq, mul_one]
    · have hc_even : (k * (a - 1) + 1) % 2 = 0 := by omega
      have h_one : ∀ i : Fin D_orb.length,
          oddStatGaussFactor F (D_orb.get i).field
            (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
            (k_Fi i) (ψ_0θ i) = 1 := by
        intro i
        unfold oddStatGaussFactor
        rw [hFi_c i, if_neg hc_odd]
      rw [Finset.prod_congr rfl fun i _ => h_one i, Finset.prod_const_one,
        if_neg hc_odd, hc_even, mul_zero, pow_zero, Int.cast_one, mul_one]
  exact ⟨hf_sum, hku_eq, hs_m1_sq, hs_u_sq, hs_P_sq, hΓ_E, hΓ_L, hΓ_μ, hΓ_θ⟩

theorem ld_ch14_odd_p_supercrit_sign_and_power_balance (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (hp_ne2 : p F ≠ 2)
    (q_MCK u t k a a_E : ℕ)
    (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k) (ha_ge2 : 2 ≤ a)
    (ht_lt : t < k * (a - 1))
    (hq_odd : q_MCK % 2 = 1) (hq_ge3 : 3 ≤ q_MCK)
    (hk_even_or1 : k = 1 ∨ 2 ∣ k)
    (hnot_even : ¬ (2 ∣ t ∧ 2 ∣ k))
    (hku_eq : k * u = q_MCK - 1)
    (ha_E_eq : a_E = q_MCK * (a - 1) - u * t + 1)
    (s_m1 s_u s_P : ℤ)
    (hs_m1_sq : s_m1 ^ 2 = 1) (hs_u_sq : s_u ^ 2 = 1) (hs_P_sq : s_P ^ 2 = 1)
    (q_0 G_L : Ω F)
    (hG_L_sq : G_L ^ 2 = (s_m1 : Ω F) * q_0) :
    let c := k * (a - 1) + 1
    let H_L : Ω F := q_0 ^ ((p F - 1) / 2) * G_L
    ((q_0 ^ (a_E / 2 + u * ((t + 1) / 2))) ^ (p F)) *
      (((if a_E % 2 = 1 then s_u * s_m1 ^ u * s_P else 1 : ℤ) : Ω F) * H_L ^ (a_E % 2)) *
      (((if (t + 1) % 2 = 1 then s_m1 ^ (u * (u + 1) / 2) else 1 : ℤ) : Ω F) *
        H_L ^ (u * ((t + 1) % 2))) =
    ((q_0 ^ (a / 2 + u * (c / 2))) ^ (p F)) *
      (((if a % 2 = 1 then s_u else 1 : ℤ) : Ω F) * H_L ^ (a % 2)) *
      (((if c % 2 = 1 then
          s_m1 ^ (u * (u + 1) / 2) * s_u ^ u * s_P ^ (u - 1) * s_P ^ (a - 1)
        else 1 : ℤ) : Ω F) *
        H_L ^ (u * (c % 2))) :=
by
  intro c H_L
  have hc_def : c = k * (a - 1) + 1 := rfl
  have hHL_def : H_L = q_0 ^ ((p F - 1) / 2) * G_L := rfl
  have hp : Nat.Prime (p F) := CharP.prime_ringChar 𝓀[F]
  have hp_odd : (p F) % 2 = 1 := Nat.odd_iff.mp (hp.odd_of_ne_two hp_ne2)
  have hp_eq : 2 * ((p F - 1) / 2) + 1 = p F := by omega
  have hHL_sq : H_L ^ 2 = (s_m1 : Ω F) * q_0 ^ (p F) := by
    calc H_L ^ 2 = (q_0 ^ ((p F - 1) / 2)) ^ 2 * G_L ^ 2 := by
          rw [hHL_def]
          ring
      _ = q_0 ^ (2 * ((p F - 1) / 2)) * ((s_m1 : Ω F) * q_0) := by
          rw [← pow_mul, mul_comm ((p F - 1) / 2) 2, hG_L_sq]
      _ = (s_m1 : Ω F) * (q_0 ^ (2 * ((p F - 1) / 2)) * q_0 ^ 1) := by ring
      _ = (s_m1 : Ω F) * q_0 ^ (2 * ((p F - 1) / 2) + 1) := by rw [← pow_add]
      _ = (s_m1 : Ω F) * q_0 ^ (p F) := by rw [hp_eq]
  have hs_m1_Ω_sq : (s_m1 : Ω F) ^ 2 = 1 := by exact_mod_cast hs_m1_sq
  have hq0_p : q_0 ^ (p F) = (s_m1 : Ω F) * H_L ^ 2 := by
    calc q_0 ^ (p F) = 1 * q_0 ^ (p F) := (one_mul _).symm
      _ = (s_m1 : Ω F) ^ 2 * q_0 ^ (p F) := by rw [hs_m1_Ω_sq]
      _ = (s_m1 : Ω F) * ((s_m1 : Ω F) * q_0 ^ (p F)) := by ring
      _ = (s_m1 : Ω F) * H_L ^ 2 := by rw [hHL_sq]
  have hq0_m : ∀ m : ℕ, (q_0 ^ m) ^ (p F) = ((s_m1 ^ m : ℤ) : Ω F) * H_L ^ (2 * m) := by
    intro m
    calc (q_0 ^ m) ^ (p F) = q_0 ^ (m * p F) := (pow_mul q_0 m (p F)).symm
      _ = q_0 ^ (p F * m) := by rw [mul_comm]
      _ = (q_0 ^ (p F)) ^ m := pow_mul q_0 (p F) m
      _ = ((s_m1 : Ω F) * H_L ^ 2) ^ m := by rw [hq0_p]
      _ = (s_m1 : Ω F) ^ m * (H_L ^ 2) ^ m := mul_pow _ _ m
      _ = ((s_m1 ^ m : ℤ) : Ω F) * H_L ^ (2 * m) := by
          rw [← pow_mul]
          push_cast
          rfl
  have h_combine : ∀ (m b : ℕ) (S1 S2 : ℤ),
      ((q_0 ^ (m / 2 + u * (b / 2))) ^ (p F)) *
        (((S1 : ℤ) : Ω F) * H_L ^ (m % 2)) *
        (((S2 : ℤ) : Ω F) * H_L ^ (u * (b % 2))) =
      (((s_m1 ^ (m / 2 + u * (b / 2)) * S1 * S2 : ℤ) : Ω F)) * H_L ^ (m + u * b) := by
    intro m b S1 S2
    have hexp : 2 * (m / 2 + u * (b / 2)) + m % 2 + u * (b % 2) = m + u * b := by
      have hm := Nat.div_add_mod m 2
      have hb := Nat.div_add_mod b 2
      calc 2 * (m / 2 + u * (b / 2)) + m % 2 + u * (b % 2)
          = (2 * (m / 2) + m % 2) + u * (2 * (b / 2) + b % 2) := by ring
        _ = m + u * b := by rw [hm, hb]
    rw [hq0_m (m / 2 + u * (b / 2))]
    calc (((s_m1 ^ (m / 2 + u * (b / 2)) : ℤ) : Ω F) * H_L ^ (2 * (m / 2 + u * (b / 2)))) *
          (((S1 : ℤ) : Ω F) * H_L ^ (m % 2)) *
          (((S2 : ℤ) : Ω F) * H_L ^ (u * (b % 2)))
        = (((s_m1 ^ (m / 2 + u * (b / 2)) : ℤ) : Ω F) * (S1 : Ω F) * (S2 : Ω F)) *
            (H_L ^ (2 * (m / 2 + u * (b / 2))) * H_L ^ (m % 2) * H_L ^ (u * (b % 2))) := by ring
      _ = (((s_m1 ^ (m / 2 + u * (b / 2)) * S1 * S2 : ℤ) : Ω F)) *
            H_L ^ (2 * (m / 2 + u * (b / 2)) + m % 2 + u * (b % 2)) := by
          rw [← pow_add, ← pow_add]
          push_cast
          rfl
      _ = (((s_m1 ^ (m / 2 + u * (b / 2)) * S1 * S2 : ℤ) : Ω F)) * H_L ^ (m + u * b) := by
          rw [hexp]
  have hu_ge1 : 1 ≤ u := by
    by_contra hu0
    have hu_eq0 : u = 0 := by omega
    rw [hu_eq0, mul_zero] at hku_eq
    omega
  have h_ut_le : u * t ≤ (k * u + 1) * (a - 1) := by
    calc u * t ≤ u * (k * (a - 1)) := Nat.mul_le_mul_left u (le_of_lt ht_lt)
      _ = (k * u) * (a - 1) := by ring
      _ ≤ (k * u + 1) * (a - 1) := Nat.mul_le_mul_right (a - 1) (by omega)
  have h_sum_eq : a_E + u * (t + 1) = a + u * c := by
    have hq_eq : q_MCK = k * u + 1 := by omega
    have ha_ge1 : 1 ≤ a := by omega
    rw [ha_E_eq, hq_eq, hc_def]
    zify [h_ut_le, ha_ge1]
    ring
  rw [h_combine a_E (t + 1), h_combine a c, h_sum_eq]
  congr 1
  congr 1
  have hpow_mod : ∀ (s : ℤ), s ^ 2 = 1 → ∀ (m n : ℕ), m % 2 = n % 2 → s ^ m = s ^ n := by
    intro s hs m n hmn
    have hmod : ∀ x : ℕ, s ^ x = s ^ (x % 2) := by
      intro x
      conv_lhs => rw [← Nat.div_add_mod x 2]
      rw [pow_add, pow_mul, hs, one_pow, one_mul]
    rw [hmod m, hmod n, hmn]
  have hu_tri_mod : (u * (u + 1) / 2) % 2 = ((u + 1) / 2) % 2 := by
    rcases Nat.mod_two_eq_zero_or_one u with hu0 | hu1
    · have hu_eq : u = 2 * (u / 2) := by omega
      have h1 : u * (u + 1) = 2 * (2 * ((u / 2) * (u / 2)) + u / 2) := by
        conv_lhs => rw [hu_eq]
        ring
      have h2 : (u + 1) / 2 = u / 2 := by omega
      rw [h1, Nat.mul_div_right _ (by omega : 0 < 2), h2]
      omega
    · have hu_eq : u = 2 * (u / 2) + 1 := by omega
      have h1 : u * (u + 1) = 2 * (2 * ((u / 2) * (u / 2 + 1)) + (u / 2 + 1)) := by
        conv_lhs => rw [hu_eq]
        ring
      have h2 : (u + 1) / 2 = u / 2 + 1 := by omega
      rw [h1, Nat.mul_div_right _ (by omega : 0 < 2), h2]
      omega
  have hs_m1_tri : s_m1 ^ (u * (u + 1) / 2) = s_m1 ^ ((u + 1) / 2) :=
    hpow_mod s_m1 hs_m1_sq _ _ hu_tri_mod
  have hs_m1_u : s_m1 ^ u = s_m1 ^ (u % 2) :=
    hpow_mod s_m1 hs_m1_sq u (u % 2) (Nat.mod_mod u 2).symm
  have h_if_aE : (if a_E % 2 = 1 then s_u * s_m1 ^ u * s_P else 1 : ℤ) =
      s_m1 ^ ((a_E % 2) * (u % 2)) * s_u ^ (a_E % 2) * s_P ^ (a_E % 2) := by
    rcases Nat.mod_two_eq_zero_or_one a_E with h0 | h1
    · rw [h0]
      simp
    · rw [h1, if_pos rfl, one_mul, pow_one, pow_one, hs_m1_u]
      ring
  have h_if_t1 : (if (t + 1) % 2 = 1 then s_m1 ^ (u * (u + 1) / 2) else 1 : ℤ) =
      s_m1 ^ (((t + 1) % 2) * ((u + 1) / 2)) := by
    rcases Nat.mod_two_eq_zero_or_one (t + 1) with h0 | h1
    · simp [h0]
    · simp [h1, hs_m1_tri]
  have h_if_a : (if a % 2 = 1 then s_u else 1 : ℤ) = s_u ^ (a % 2) := by
    rcases Nat.mod_two_eq_zero_or_one a with h0 | h1 <;> simp [‹_›]
  have h_if_c : (if c % 2 = 1 then
        s_m1 ^ (u * (u + 1) / 2) * s_u ^ u * s_P ^ (u - 1) * s_P ^ (a - 1)
      else 1 : ℤ) =
      s_m1 ^ ((c % 2) * ((u + 1) / 2)) * s_u ^ ((c % 2) * u) *
        s_P ^ ((c % 2) * ((u - 1) + (a - 1))) := by
    rcases Nat.mod_two_eq_zero_or_one c with h0 | h1
    · simp [h0]
    · simp [h1, hs_m1_tri, pow_add]
      ring
  rw [h_if_aE, h_if_t1, h_if_a, h_if_c]
  have h_lhs_group :
      s_m1 ^ (a_E / 2 + u * ((t + 1) / 2)) *
        (s_m1 ^ ((a_E % 2) * (u % 2)) * s_u ^ (a_E % 2) * s_P ^ (a_E % 2)) *
        s_m1 ^ (((t + 1) % 2) * ((u + 1) / 2)) =
      s_m1 ^ (a_E / 2 + u * ((t + 1) / 2) + (a_E % 2) * (u % 2) +
        ((t + 1) % 2) * ((u + 1) / 2)) * s_u ^ (a_E % 2) * s_P ^ (a_E % 2) := by
    rw [pow_add, pow_add]
    ring
  have h_rhs_group :
      s_m1 ^ (a / 2 + u * (c / 2)) * s_u ^ (a % 2) *
        (s_m1 ^ ((c % 2) * ((u + 1) / 2)) * s_u ^ ((c % 2) * u) *
          s_P ^ ((c % 2) * ((u - 1) + (a - 1)))) =
      s_m1 ^ (a / 2 + u * (c / 2) + (c % 2) * ((u + 1) / 2)) *
        s_u ^ (a % 2 + (c % 2) * u) * s_P ^ ((c % 2) * ((u - 1) + (a - 1))) := by
    rw [pow_add, pow_add]
    ring
  rw [h_lhs_group, h_rhs_group]
  have h_div2_id : ∀ m b : ℕ,
      2 * (m / 2 + u * (b / 2) + (b % 2) * ((u + 1) / 2)) + m % 2 =
        m + u * b + (b % 2) * (u % 2) := by
    intro m b
    have hm := Nat.div_add_mod m 2
    have hb := Nat.div_add_mod b 2
    have hu : 2 * ((u + 1) / 2) = u + u % 2 := by omega
    calc 2 * (m / 2 + u * (b / 2) + (b % 2) * ((u + 1) / 2)) + m % 2
        = (2 * (m / 2) + m % 2) + u * (2 * (b / 2)) + (b % 2) * (2 * ((u + 1) / 2)) := by ring
      _ = m + u * (2 * (b / 2)) + (b % 2) * (u + u % 2) := by rw [hm, hu]
      _ = m + u * (2 * (b / 2) + b % 2) + (b % 2) * (u % 2) := by ring
      _ = m + u * b + (b % 2) * (u % 2) := by rw [hb]
  have h_ku_even : (k * u) % 2 = 0 := by omega
  have h_t1_u : ((t + 1) % 2) * (u % 2) = 0 := by
    rcases Nat.mod_two_eq_zero_or_one (t + 1) with ht0 | ht1
    · rw [ht0, zero_mul]
    · have ht_even : 2 ∣ t := by omega
      rcases hk_even_or1 with rfl | hk_even
      · rw [one_mul] at h_ku_even
        rw [h_ku_even, mul_zero]
      · exact False.elim (hnot_even ⟨ht_even, hk_even⟩)
  have h_cu : (c % 2) * (u % 2) = u % 2 := by
    rcases Nat.mod_two_eq_zero_or_one u with hu0 | hu1
    · rw [hu0, mul_zero]
    · have hk_even : k % 2 = 0 := by
        have h1 : (k % 2) * (u % 2) % 2 = 0 := by rw [← Nat.mul_mod, h_ku_even]
        rw [hu1, mul_one, Nat.mod_mod] at h1
        exact h1
      have hc_odd : c % 2 = 1 := by
        have h2 : (k * (a - 1)) % 2 = 0 := by
          rw [Nat.mul_mod, hk_even, zero_mul, Nat.zero_mod]
        omega
      rw [hc_odd, one_mul]
  have h_c_even_imp : c % 2 = 0 → k = 1 ∧ a % 2 = 0 ∧ u % 2 = 0 := by
    intro hc0
    have hka_odd : (k * (a - 1)) % 2 = 1 := by omega
    have hk_odd : k % 2 = 1 := by
      rcases Nat.mod_two_eq_zero_or_one k with hk0 | hk1
      · have : (k * (a - 1)) % 2 = 0 := by rw [Nat.mul_mod, hk0, zero_mul, Nat.zero_mod]
        omega
      · exact hk1
    have hk1 : k = 1 := by
      rcases hk_even_or1 with rfl | hk_even
      · rfl
      · omega
    subst hk1
    rw [one_mul] at hka_odd h_ku_even
    exact ⟨rfl, by omega, h_ku_even⟩
  set L_exp := a_E / 2 + u * ((t + 1) / 2) + ((t + 1) % 2) * ((u + 1) / 2)
  set R_exp := a / 2 + u * (c / 2) + (c % 2) * ((u + 1) / 2)
  have h_lin : 2 * L_exp + a_E % 2 + u % 2 = 2 * R_exp + a % 2 := by
    calc 2 * L_exp + a_E % 2 + u % 2
        = (2 * L_exp + a_E % 2) + (c % 2) * (u % 2) := by rw [h_cu]
      _ = a_E + u * (t + 1) + ((t + 1) % 2) * (u % 2) + (c % 2) * (u % 2) := by
          rw [h_div2_id a_E (t + 1)]
      _ = (a + u * c + (c % 2) * (u % 2)) + ((t + 1) % 2) * (u % 2) := by
          rw [h_sum_eq]
          ring
      _ = 2 * R_exp + a % 2 := by
          rw [← h_div2_id a c, h_t1_u, add_zero]
  have h_m1_rearr : a_E / 2 + u * ((t + 1) / 2) + (a_E % 2) * (u % 2) +
      ((t + 1) % 2) * ((u + 1) / 2) = L_exp + (a_E % 2) * (u % 2) := by
    dsimp [L_exp]
    ring
  rw [h_m1_rearr]
  have h_exp_m1_aux : ∀ (L_e R_e : ℕ),
      2 * L_e + a_E % 2 + u % 2 = 2 * R_e + a % 2 →
      L_e + (a_E % 2) * (u % 2) = R_e := by
    intro L_e R_e h_lin_e
    rcases Nat.mod_two_eq_zero_or_one a_E with haE0 | haE1 <;>
      rcases Nat.mod_two_eq_zero_or_one u with hu0 | hu1
    · rw [haE0, hu0] at h_lin_e ⊢; omega
    · rw [haE0, hu1] at h_lin_e ⊢; omega
    · rw [haE1, hu0] at h_lin_e ⊢; omega
    · rw [haE1, hu1] at h_lin_e ⊢; omega
  have h_exp_m1 : L_exp + (a_E % 2) * (u % 2) = R_exp :=
    h_exp_m1_aux L_exp R_exp h_lin
  have h_exp_u : s_u ^ (a_E % 2) = s_u ^ (a % 2 + (c % 2) * u) := by
    apply hpow_mod s_u hs_u_sq
    rcases Nat.mod_two_eq_zero_or_one c with hc0 | hc1
    · obtain ⟨_, ha0, hu0⟩ := h_c_even_imp hc0
      rw [hc0, zero_mul, add_zero]
      omega
    · rw [hc1, one_mul]
      omega
  have h_exp_P : s_P ^ (a_E % 2) = s_P ^ ((c % 2) * ((u - 1) + (a - 1))) := by
    apply hpow_mod s_P hs_P_sq
    rcases Nat.mod_two_eq_zero_or_one c with hc0 | hc1
    · obtain ⟨_, ha0, hu0⟩ := h_c_even_imp hc0
      rw [hc0, zero_mul]
      omega
    · rw [hc1, one_mul]
      omega
  rw [h_exp_m1, h_exp_u, h_exp_P]

theorem ld_ch14_odd_p_regime_quad_gauss_balance_assembly (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] [FiniteDimensional F E]
    (hLE : L ≤ E)
    (hp_ne2 : p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hψFi : ∀ i : Fin D_orb.length,
      IsAdmissibleChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ))
    (q_MCK : ℕ)
    (hDegSum : (∑ i : Fin D_orb.length,
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) =
      q_MCK - 1)
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (hq_MCK_pow : ∃ r_exp : ℕ, 1 ≤ r_exp ∧ q_MCK = (p F) ^ r_exp)
    (hqE : qL F E = qL F L)
    (t k : ℕ) (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k) (hk_even_or1 : k = 1 ∨ 2 ∣ k)
    (hk_dvd : k ∣ (q_MCK - 1))
    (hnE : condExpChar F E (traceChar F hLE ψ) =
      (q_MCK : ℤ) * condExpChar F L ψ +
        (((q_MCK - 1) / k : ℕ) : ℤ) * ((t : ℤ) + (k : ℤ)))
    (hFi_cond : ∀ i : Fin D_orb.length,
      condExp F (D_orb.get i).field (μ'_orb i) = t + 1 ∧
      condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) =
        (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1))
    (ϖ_L : Lˣ) (hϖ_L : valL F L (ϖ_L : L) = 1)
    (c'_χ' : Lˣ)
    (c'_μ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (c'_θ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (hcond_E : 2 ≤ condExp F E (χ'.comp (Units.map (normLM F hLE))))
    (hc_L_val : valL F L (c'_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_orb_val : ∀ i : Fin D_orb.length,
      let F_i := (D_orb.get i).field
      let ψ_Fi := traceChar F (D_orb.get i).le ψ
      let θ_i := μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
      2 ≤ condExp F F_i (μ'_orb i) ∧
      2 ≤ condExp F F_i θ_i ∧
      valL F F_i (c'_μ i : F_i) =
        (condExp F F_i (μ'_orb i) : ℤ) + condExpChar F F_i ψ_Fi ∧
      valL F F_i (c'_θ i : F_i) =
        (condExp F F_i θ_i : ℤ) + condExpChar F F_i ψ_Fi)
    (k_L k_E : Type u) [Field k_L] [Fintype k_L] [Field k_E] [Fintype k_E]
    (resL : L → k_L) (ψ_0L : AddChar k_L (Ω F)) (ψ_0E : AddChar k_E (Ω F))
    (k_Fi : Fin D_orb.length → Type u)
    [∀ i, Field (k_Fi i)] [∀ i, Fintype (k_Fi i)] [∀ i, Algebra k_L (k_Fi i)]
    (resFi : ∀ i : Fin D_orb.length, (D_orb.get i).field → k_Fi i)
    (ϖ_Fi : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (ψ_0μ : ∀ i : Fin D_orb.length, AddChar (k_Fi i) (Ω F))
    (ψ_0θ : ∀ i : Fin D_orb.length, AddChar (k_Fi i) (Ω F))
    (hresL_map : IsResidueFieldMap F L k_L resL)
    (hresFi_props : ∀ i : Fin D_orb.length,
      valL F (D_orb.get i).field (ϖ_Fi i : (D_orb.get i).field) = 1 ∧
      IsResidueFieldMap F (D_orb.get i).field (k_Fi i) (resFi i))
    (hcard_kL : Fintype.card k_L = qL F L)
    (hp_char : ((p F : ℕ) : k_L) = 0)
    (G_L : Ω F)
    (hG_L_sq : G_L ^ 2 = ((quadraticChar k_L (-1) : ℤ) : Ω F) * (qL F L : Ω F))
    (hL_gauss :
      let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
      let u_χ' : Lˣ := (ϖ_L ^ (condExp F L χ' - 1) * c₀)⁻¹ * c'_χ'
      valL F L (u_χ' : L) = 0 ∧
      resL (u_χ' : L) ≠ 0 ∧
      (condExp F L χ' % 2 = 1 →
        oddStatGaussFactor F L χ' k_L ψ_0L =
          ((quadraticChar k_L (resL (u_χ' : L)) : ℤ) : Ω F) *
            ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L)))
    (hFi_gauss : ∀ i : Fin D_orb.length,
      let F_i := (D_orb.get i).field
      let θ_i := μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
      let f_i := Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k
      let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
      let v_μ : F_iˣ :=
        Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c₀ *
          (c'_μ i)⁻¹ * ((ϖ_Fi i) ^ (2 * (condExp F F_i (μ'_orb i) / 2)))
      let v_θ : F_iˣ :=
        Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c₀ *
          (c'_θ i)⁻¹ * ((ϖ_Fi i) ^ (2 * (condExp F F_i θ_i / 2)))
      1 ≤ f_i ∧
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_i ∧
      qL F F_i = (qL F L) ^ f_i ∧
      Module.finrank k_L (k_Fi i) = f_i ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        resFi i (IntermediateField.inclusion (D_orb.get i).le x) =
          algebraMap k_L (k_Fi i) (resL x)) ∧
      (condExp F F_i (μ'_orb i) % 2 = 1 →
        valL F F_i (v_μ : F_i) = 0 ∧
        resFi i (v_μ : F_i) ≠ 0 ∧
        oddStatGaussFactor F F_i (μ'_orb i) (k_Fi i) (ψ_0μ i) =
          (((-1 : ℤ) ^ (f_i - 1) *
            quadraticChar k_L (Algebra.norm k_L ((k : k_Fi i) * resFi i (v_μ : F_i))) : ℤ) : Ω F) *
            ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L) ^ f_i) ∧
      (condExp F F_i θ_i % 2 = 1 →
        valL F F_i (v_θ : F_i) = 0 ∧
        resFi i (v_θ : F_i) ≠ 0 ∧
        oddStatGaussFactor F F_i θ_i (k_Fi i) (ψ_0θ i) =
          (((-1 : ℤ) ^ (f_i - 1) *
            quadraticChar k_L (Algebra.norm k_L ((k : k_Fi i) * resFi i (v_θ : F_i))) : ℤ) : Ω F) *
            ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L) ^ f_i))
    (hE_and_regimes :
      let a := condExp F L χ'
      let χ'_E := χ'.comp (Units.map (normLM F hLE))
      let a_E := condExp F E χ'_E
      let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
      let u_χ' : Lˣ := (ϖ_L ^ (a - 1) * c₀)⁻¹ * c'_χ'
      let u_E_norm : Lˣ :=
        (ϖ_L ^ (a_E - 1))⁻¹ * c₀⁻¹ * c'_χ' *
          (∏ i : Fin D_orb.length,
            Units.map (normLM F (D_orb.get i).le) (c'_θ i * (c'_μ i)⁻¹))
      valL F L (u_E_norm : L) = 0 ∧
      resL (u_E_norm : L) ≠ 0 ∧
      (a_E % 2 = 1 →
        oddStatGaussFactor F E χ'_E k_E ψ_0E =
          ((quadraticChar k_L (resL (u_E_norm : L)) : ℤ) : Ω F) *
            ((qL F L : Ω F) ^ ((p F - 1) / 2) * G_L)) ∧
      (k * (a - 1) ≤ t →
        (∀ i : Fin D_orb.length,
          condExp F (D_orb.get i).field
            (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) = t + 1) ∧
        a_E = a ∧
        (k * (a - 1) < t →
          ∀ i : Fin D_orb.length,
            c'_θ i * (c'_μ i)⁻¹ ∈ unitGroup F (D_orb.get i).field 1)) ∧
      (t < k * (a - 1) →
        (∀ i : Fin D_orb.length,
          condExp F (D_orb.get i).field
            (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) =
            k * (a - 1) + 1) ∧
        a_E = q_MCK * (a - 1) - ((q_MCK - 1) / k) * t + 1 ∧
        (∀ i : Fin D_orb.length,
          c'_θ i *
            (Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c'_χ')⁻¹ ∈
            unitGroup F (D_orb.get i).field 1) ∧
        resL (u_E_norm : L) =
          (resL (u_χ' : L)) ^ q_MCK *
            resL (((c₀ ^ (q_MCK - 1) * (ϖ_L ^ (((q_MCK - 1) / k) * t)) *
              (∏ i : Fin D_orb.length,
                Units.map (normLM F (D_orb.get i).le) (c'_μ i))⁻¹ : Lˣ) : L))))
    (hMaster :
      let u := (q_MCK - 1) / k
      let c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
      let Θ_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ := fun i =>
        (Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c₀ * (c'_μ i)⁻¹) ^ k *
          (Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom ϖ_L) ^ t
      let P_ξ : k_L :=
        ∏ i : Fin D_orb.length,
          Algebra.norm k_L (resFi i ((Θ_orb i : ((D_orb.get i).field)ˣ) : (D_orb.get i).field))
      ¬ (2 ∣ t ∧ 2 ∣ k) ∧
      (∀ i : Fin D_orb.length,
        valL F (D_orb.get i).field ((Θ_orb i : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) = 0 ∧
        resFi i ((Θ_orb i : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) ≠ 0) ∧
      (∀ i : Fin D_orb.length, ∀ w : ((D_orb.get i).field)ˣ,
        valL F (D_orb.get i).field (w : (D_orb.get i).field) = 0 →
        resL ((Units.map (normLM F (D_orb.get i).le) w : Lˣ) : L) =
          (Algebra.norm k_L (resFi i (w : (D_orb.get i).field))) ^ k) ∧
      P_ξ ≠ 0 ∧
      P_ξ =
        (-1 : k_L) ^ u *
          resL (((c₀ ^ (q_MCK - 1) * (ϖ_L ^ (u * t)) *
            (∏ i : Fin D_orb.length,
              Units.map (normLM F (D_orb.get i).le) (c'_μ i))⁻¹ : Lˣ) : L)) ∧
      (-1 : ℤ) ^ (u - D_orb.length) =
        (quadraticChar k_L (-1)) ^ (u * (u + 1) / 2) *
          (quadraticChar k_L (k : k_L)) ^ u *
          (quadraticChar k_L P_ξ) ^ (u - 1)) :
    ((statHalfCondFactor F E (traceChar F hLE ψ) (χ'.comp (Units.map (normLM F hLE))) *
        (qL F L : Ω F) ^ condExpChar F L ψ *
        (∏ i : Fin D_orb.length,
          statHalfCondFactor F (D_orb.get i).field
            (traceChar F (D_orb.get i).le ψ) (μ'_orb i))) ^ (p F)) *
      oddStatGaussFactor F E (χ'.comp (Units.map (normLM F hLE))) k_E ψ_0E *
      (∏ i : Fin D_orb.length,
        oddStatGaussFactor F (D_orb.get i).field (μ'_orb i) (k_Fi i) (ψ_0μ i)) =
    (((qL F E : Ω F) ^ condExpChar F E (traceChar F hLE ψ) *
        statHalfCondFactor F L ψ χ' *
        (∏ i : Fin D_orb.length,
          statHalfCondFactor F (D_orb.get i).field
            (traceChar F (D_orb.get i).le ψ)
            (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))))) ^ (p F)) *
      oddStatGaussFactor F L χ' k_L ψ_0L *
      (∏ i : Fin D_orb.length,
        oddStatGaussFactor F (D_orb.get i).field
          (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
          (k_Fi i) (ψ_0θ i)) :=
by
  have h_s1 := fun i : Fin D_orb.length => by
    letI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    have hc_μ_i : valL F (D_orb.get i).field (c'_μ i : (D_orb.get i).field) =
        ((t + 1 : ℕ) : ℤ) + ((k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1)) := by
      rw [(hc_orb_val i).2.2.1, (hFi_cond i).1, (hFi_cond i).2]
    exact ld_ch14_odd_p_orbit_val_and_supercrit_unit_res F L (D_orb.get i).field
      (D_orb.get i).le ψ χ' h_ge2 (μ'_orb i)
      (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
      t k (Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k)
      hk_ge1 (hFi_gauss i).1 (hFi_gauss i).2.1 (hFi_gauss i).2.2.1
      ϖ_L hϖ_L (ϖ_Fi i) (hresFi_props i).1 c'_χ' (c'_μ i) (c'_θ i) hc_μ_i
      k_L (k_Fi i) resL (resFi i) hresL_map (hresFi_props i).2 hcard_kL
      (hFi_gauss i).2.2.2.2.1
  have hNormVal0 : ∀ i : Fin D_orb.length, ∀ w : ((D_orb.get i).field)ˣ,
      valL F (D_orb.get i).field (w : (D_orb.get i).field) = 0 →
      valL F L ((Units.map (normLM F (D_orb.get i).le) w : Lˣ) : L) = 0 := by
    intro i w hw
    rw [Units.coe_map, (h_s1 i).1 (w : (D_orb.get i).field), hw, mul_zero]
  by_cases hk_le_t : k * (condExp F L χ' - 1) ≤ t
  · obtain ⟨hFi_c, ha_E_eq, hsub_cong⟩ := hE_and_regimes.2.2.2.1 hk_le_t
    exact ld_ch14_odd_p_regime_one_quad_gauss_balance F L E hLE ψ D_orb hFinFi χ' h_ge2 μ'_orb
      hqE t k ht_ge1 hk_ge1 hk_even_or1 hMaster.1 hk_le_t (fun i => (hFi_cond i).1) hFi_c ha_E_eq
      ϖ_L c'_χ' c'_μ c'_θ (fun i => ⟨(hc_orb_val i).2.2.1, (hc_orb_val i).2.2.2⟩) hsub_cong
      k_L k_E resL ψ_0L ψ_0E k_Fi resFi ϖ_Fi ψ_0μ ψ_0θ hresL_map
      (fun i => (hresFi_props i).2) hcard_kL G_L hL_gauss hE_and_regimes.2.2.1
      (fun i => ⟨(hFi_gauss i).2.2.2.2.2.1, (hFi_gauss i).2.2.2.2.2.2⟩) hNormVal0 hMaster.2.2.1
  · have ht_lt : t < k * (condExp F L χ' - 1) := by omega
    obtain ⟨hFi_c, ha_E_eq, hδ_orb, hu_E_res⟩ := hE_and_regimes.2.2.2.2 ht_lt
    have hp : Nat.Prime (p F) := CharP.prime_ringChar 𝓀[F]
    obtain ⟨r_exp, hr_pos, hq_pow⟩ := hq_MCK_pow
    have hp_odd : Odd (p F) := hp.odd_of_ne_two hp_ne2
    have hq_odd : q_MCK % 2 = 1 := by
      rw [hq_pow]
      exact Nat.odd_iff.mp hp_odd.pow
    have hp_ge3 : 3 ≤ p F := by
      have := hp.two_le
      omega
    have hq_ge3 : 3 ≤ q_MCK := by
      rw [hq_pow]
      calc 3 ≤ (p F) ^ 1 := by rw [pow_one]; exact hp_ge3
        _ ≤ (p F) ^ r_exp := Nat.pow_le_pow_right (by omega) hr_pos
    obtain ⟨hf_sum, hku_eq, hs_m1_sq, hs_u_sq, hs_P_sq, hΓ_E, hΓ_L, hΓ_μ, hΓ_θ⟩ :=
      ld_ch14_odd_p_supercrit_orbit_gauss_prod_eval F L E hLE ψ D_orb hFinFi q_MCK hDegSum
        χ' h_ge2 μ'_orb hq_odd hq_ge3 t k ht_ge1 hk_ge1 hk_even_or1 hk_dvd
        (fun i => (hFi_cond i).1) hFi_c ϖ_L c'_χ' c'_μ c'_θ
        k_L k_E resL ψ_0L ψ_0E k_Fi resFi ϖ_Fi ψ_0μ ψ_0θ G_L hL_gauss hFi_gauss
        ⟨hE_and_regimes.2.2.1, hu_E_res⟩
        ⟨hMaster.1, hMaster.2.1, hMaster.2.2.2.1, hMaster.2.2.2.2⟩
        (fun i =>
          ⟨(h_s1 i).2.2.2.1, (h_s1 i).2.2.2.2.2.1, (h_s1 i).2.2.2.2.2.2.1,
            (h_s1 i).2.2.2.2.2.2.2.1 (hFi_cond i).1,
            fun hc_odd => (h_s1 i).2.2.2.2.2.2.2.2 hL_gauss.1 hL_gauss.2.1 (hFi_c i) hc_odd (hδ_orb i)⟩)
    set u := (q_MCK - 1) / k
    set a := condExp F L χ'
    set χ'_E := χ'.comp (Units.map (normLM F hLE))
    set a_E := condExp F E χ'_E
    set c := k * (a - 1) + 1
    set q_0 : Ω F := (qL F L : Ω F)
    have hqL_pos : 0 < qL F L := by
      rw [← hcard_kL]
      exact Fintype.card_pos
    have hq0_ne : q_0 ≠ 0 := by
      dsimp [q_0]
      exact_mod_cast hqL_pos.ne'
    have hqFi_ne : ∀ i : Fin D_orb.length, ((qL F (D_orb.get i).field : ℕ) : Ω F) ≠ 0 := by
      intro i
      rw [(hFi_gauss i).2.2.1, Nat.cast_pow]
      exact pow_ne_zero _ hq0_ne
    have h_stat_E : statHalfCondFactor F E (traceChar F hLE ψ) χ'_E =
        q_0 ^ condExpChar F E (traceChar F hLE ψ) * q_0 ^ (a_E / 2) := by
      unfold statHalfCondFactor
      rw [hqE, zpow_add₀ hq0_ne, zpow_natCast]
    have h_stat_L : statHalfCondFactor F L ψ χ' =
        q_0 ^ condExpChar F L ψ * q_0 ^ (a / 2) := by
      unfold statHalfCondFactor
      rw [zpow_add₀ hq0_ne, zpow_natCast]
    have h_stat_μ : ∀ i : Fin D_orb.length,
        statHalfCondFactor F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) (μ'_orb i) =
          ((qL F (D_orb.get i).field : ℕ) : Ω F) ^
            condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) *
            (q_0 ^ ((t + 1) / 2)) ^
              (Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k) := by
      intro i
      unfold statHalfCondFactor
      rw [zpow_add₀ (hqFi_ne i), zpow_natCast, (hFi_cond i).1]
      congr 1
      rw [(hFi_gauss i).2.2.1, Nat.cast_pow, ← pow_mul, ← pow_mul, mul_comm]
    have h_stat_θ : ∀ i : Fin D_orb.length,
        statHalfCondFactor F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ)
            (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) =
          ((qL F (D_orb.get i).field : ℕ) : Ω F) ^
            condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) *
            (q_0 ^ (c / 2)) ^
              (Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) / k) := by
      intro i
      unfold statHalfCondFactor
      rw [zpow_add₀ (hqFi_ne i), zpow_natCast, hFi_c i]
      congr 1
      rw [(hFi_gauss i).2.2.1, Nat.cast_pow, ← pow_mul, ← pow_mul, mul_comm]
    have h_prod_μ :
        (∏ i : Fin D_orb.length,
          statHalfCondFactor F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) (μ'_orb i)) =
        (∏ i : Fin D_orb.length,
          ((qL F (D_orb.get i).field : ℕ) : Ω F) ^
            condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ)) *
          q_0 ^ (u * ((t + 1) / 2)) := by
      simp_rw [h_stat_μ]
      rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hf_sum, ← pow_mul,
        mul_comm ((t + 1) / 2) u]
    have h_prod_θ :
        (∏ i : Fin D_orb.length,
          statHalfCondFactor F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ)
            (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))) =
        (∏ i : Fin D_orb.length,
          ((qL F (D_orb.get i).field : ℕ) : Ω F) ^
            condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ)) *
          q_0 ^ (u * (c / 2)) := by
      simp_rw [h_stat_θ]
      rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hf_sum, ← pow_mul,
        mul_comm (c / 2) u]
    set C_ψ : Ω F :=
      q_0 ^ condExpChar F E (traceChar F hLE ψ) *
        q_0 ^ condExpChar F L ψ *
        (∏ i : Fin D_orb.length,
          ((qL F (D_orb.get i).field : ℕ) : Ω F) ^
            condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ))
    have h_pref_lhs :
        (statHalfCondFactor F E (traceChar F hLE ψ) χ'_E *
          (qL F L : Ω F) ^ condExpChar F L ψ *
          (∏ i : Fin D_orb.length,
            statHalfCondFactor F (D_orb.get i).field
              (traceChar F (D_orb.get i).le ψ) (μ'_orb i))) ^ (p F) =
        C_ψ ^ (p F) * (q_0 ^ (a_E / 2 + u * ((t + 1) / 2))) ^ (p F) := by
      rw [h_stat_E, h_prod_μ]
      have h_rearranged :
          q_0 ^ condExpChar F E (traceChar F hLE ψ) * q_0 ^ (a_E / 2) *
            q_0 ^ condExpChar F L ψ *
            ((∏ i : Fin D_orb.length,
              ((qL F (D_orb.get i).field : ℕ) : Ω F) ^
                condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ)) *
              q_0 ^ (u * ((t + 1) / 2))) =
          C_ψ * (q_0 ^ (a_E / 2) * q_0 ^ (u * ((t + 1) / 2))) := by
        dsimp [C_ψ]; ring
      rw [h_rearranged, ← pow_add, mul_pow]
    have h_pref_rhs :
        ((qL F E : Ω F) ^ condExpChar F E (traceChar F hLE ψ) *
          statHalfCondFactor F L ψ χ' *
          (∏ i : Fin D_orb.length,
            statHalfCondFactor F (D_orb.get i).field
              (traceChar F (D_orb.get i).le ψ)
              (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))))) ^ (p F) =
        C_ψ ^ (p F) * (q_0 ^ (a / 2 + u * (c / 2))) ^ (p F) := by
      rw [hqE, h_stat_L, h_prod_θ]
      have h_rearranged :
          q_0 ^ condExpChar F E (traceChar F hLE ψ) *
            (q_0 ^ condExpChar F L ψ * q_0 ^ (a / 2)) *
            ((∏ i : Fin D_orb.length,
              ((qL F (D_orb.get i).field : ℕ) : Ω F) ^
                condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ)) *
              q_0 ^ (u * (c / 2))) =
          C_ψ * (q_0 ^ (a / 2) * q_0 ^ (u * (c / 2))) := by
        dsimp [C_ψ]; ring
      rw [h_rearranged, ← pow_add, mul_pow]
    rw [h_pref_lhs, h_pref_rhs, hΓ_E, hΓ_L, hΓ_μ, hΓ_θ]
    have h_bal :=
      ld_ch14_odd_p_supercrit_sign_and_power_balance F hp_ne2 q_MCK u t k a a_E
        ht_ge1 hk_ge1 h_ge2 ht_lt hq_odd hq_ge3 hk_even_or1 hMaster.1 hku_eq ha_E_eq
        _ _ _ hs_m1_sq hs_u_sq hs_P_sq q_0 G_L hG_L_sq
    dsimp only at h_bal
    linear_combination (C_ψ ^ (p F)) * h_bal

theorem ld_ch14_wild_odd_p_quadratic_gauss_product_balance (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K) (hLE : L ≤ E) (hEK : E ≤ K)
    (hGalMC : IsGaloisExt F L M_C) (hGalMCK : IsGaloisExt F M_C K)
    (hSepLE : Algebra.IsSeparable L (IntermediateField.extendScalars hLE))
    (hp_ne2 : p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (hSepLFi : ∀ i : Fin D_orb.length,
      Algebra.IsSeparable L (IntermediateField.extendScalars (D_orb.get i).le))
    (hSepFiMC : ∀ i : Fin D_orb.length,
      Algebra.IsSeparable (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)))
    (hψFi : ∀ i : Fin D_orb.length,
      IsAdmissibleChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ))
    (hLtFi : ∀ i : Fin D_orb.length, L < (D_orb.get i).field)
    (hDegSum : (∑ i : Fin D_orb.length,
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (hχ'_cond : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1)
    (hμ'_pow : ∀ i : Fin D_orb.length, (μ'_orb i) ^ (p F) = 1)
    (hOrbitEnum : ∃ (ν_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
        (M_Cˣ →* (Ω F)ˣ))
      (σ_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
        (M_C ≃ₐ[F] M_C))
      (idx_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
        Fin D_orb.length),
      Function.Injective ν_all ∧
      (∀ j,
        ν_all j ≠ 1 ∧
        (ν_all j) ^ (p F) = 1 ∧
        (∀ x : L, (σ_all j) (IntermediateField.inclusion hLM_C x) =
          IntermediateField.inclusion hLM_C x) ∧
        (∀ z : M_C, valL F M_C ((σ_all j) z) = valL F M_C z) ∧
        (∀ z : M_C, traceLM F hLM_C ((σ_all j) z) = traceLM F hLM_C z) ∧
        (∀ w : M_Cˣ, w ∈ Set.range (Units.map (normLM F hM_CK)) → (ν_all j) w = 1) ∧
        ∀ w : M_Cˣ,
          (ν_all j) w =
            ((μ'_orb (idx_all j)).comp (Units.map (normLM F (hFiMC (idx_all j)))))
              (Units.map (σ_all j).toRingEquiv.toMonoidHom w)) ∧
      (∀ (c_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ),
        ∏ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1),
          Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
            (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
              (c_orb (idx_all j))) =
          Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
            (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c_orb i))))
    (hqE : qL F E = qL F L)
    (hresE : resDeg F E = resDeg F L)
    (hValNormE : ∀ y : E, valL F L (normLM F hLE y) = valL F E y)
    (hValAlgE : ∀ x : L,
      valL F E (IntermediateField.inclusion hLE x) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F L x)
    (hResLiftE : ∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLE x = 0 ∨
          1 ≤ valL F E (y - IntermediateField.inclusion hLE x)))
    (hFrobSurjL : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 0 ∨
          1 ≤ valL F L (x - s ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))))
    (hFrobSurjLp : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (p F) = 0 ∨ 1 ≤ valL F L (x - s ^ (p F))))
    (hFrobSurjMC : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      ∃ s : M_C, (s = 0 ∨ 0 ≤ valL F M_C s) ∧
        (z - s ^ (p F) = 0 ∨ 1 ≤ valL F M_C (z - s ^ (p F))))
    (hDiamondTrNorm : ∀ y : E,
      IntermediateField.inclusion hLM_C (traceLM F hLE y) =
        traceLM F hM_CK (IntermediateField.inclusion hEK y) ∧
      IntermediateField.inclusion hLM_C (normLM F hLE y) =
        normLM F hM_CK (IntermediateField.inclusion hEK y))
    (t k : ℕ) (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k) (hk_even_or1 : k = 1 ∨ 2 ∣ k)
    (hk_dvd : k ∣ (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1))
    (hValAlgKE : ∀ y : E, valL F K (IntermediateField.inclusion hEK y) = (k : ℤ) * valL F E y)
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hTrBoundMCL : ∀ (m : ℤ) (z : M_C),
      (z = 0 ∨ (k : ℤ) * m - ((k : ℤ) - 1) ≤ valL F M_C z) →
      (traceLM F hLM_C z = 0 ∨ m ≤ valL F L (traceLM F hLM_C z)))
    (hTrFrobMCL : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      traceLM F hLM_C (z ^ (p F)) - (traceLM F hLM_C z) ^ (p F) = 0 ∨
        1 ≤ valL F L (traceLM F hLM_C (z ^ (p F)) - (traceLM F hLM_C z) ^ (p F)))
    (hnMC : condExpChar F M_C (traceChar F hLM_C ψ) =
      (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1))
    (hnE : condExpChar F E (traceChar F hLE ψ) =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * condExpChar F L ψ +
        (((Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) / k : ℕ) : ℤ) *
          ((t : ℤ) + (k : ℤ)))
    (htr_bound_K : ∀ (m : ℤ) (w : K),
      (w = 0 ∨
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * m -
          ((Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K w) →
      (traceLM F hM_CK w = 0 ∨ m ≤ valL F M_C (traceLM F hM_CK w)))
    (hFi_ram : ∀ i : Fin D_orb.length,
      condExp F (D_orb.get i).field (μ'_orb i) = t + 1 ∧
      condExp F M_C ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) = t + 1 ∧
      (∀ x : (D_orb.get i).field,
        valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
          valL F (D_orb.get i).field x) ∧
      (∀ z : M_C,
        valL F (D_orb.get i).field (normLM F (hFiMC i) z) =
          (Module.finrank (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)) : ℤ) *
            valL F M_C z) ∧
      (∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
        (traceLM F (hFiMC i) z = 0 ∨ m ≤ valL F (D_orb.get i).field (traceLM F (hFiMC i) z))) ∧
      (∀ z : M_C, (z = 0 ∨ 1 ≤ valL F M_C z) →
        normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z) = 0 ∨
          2 * valL F M_C z ≤
            valL F (D_orb.get i).field
              (normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z))) ∧
      condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) =
        (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1) ∧
      ∃ f_i : ℕ,
        1 ≤ f_i ∧
        Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_i ∧
        resDeg F (D_orb.get i).field = f_i * resDeg F L ∧
        (∀ x : (D_orb.get i).field,
          valL F L (normLM F (D_orb.get i).le x) =
            (f_i : ℤ) * valL F (D_orb.get i).field x))
    (P_poly : M_C → M_C) (ϖ_K : Kˣ) (ϖ_MC : M_Cˣ) (ϖ_E : Eˣ) (ϖ_L : Lˣ)
    (hϖ_K_norm : Units.map (normLM F hM_CK) ϖ_K = ϖ_MC)
    (hϖ_E_norm : Units.map (normLM F hLE) ϖ_E = ϖ_L)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_MC : valL F M_C (ϖ_MC : M_C) = 1)
    (hϖ_E : valL F E (ϖ_E : E) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hPoly_spec : ∃ (r_exp : ℕ) (hr_exp_pos : 1 ≤ r_exp) (a_coeff : Fin r_exp → M_C),
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) = (p F) ^ r_exp ∧
      (∀ j : Fin r_exp, a_coeff j = 0 ∨ 0 ≤ valL F M_C (a_coeff j)) ∧
      (a_coeff ⟨0, hr_exp_pos⟩ -
        (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K) = 0 ∨
        1 ≤ valL F M_C (a_coeff ⟨0, hr_exp_pos⟩ -
          (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K))) ∧
      valL F M_C ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K)) = 0 ∧
      (∀ z : M_C,
        P_poly z =
          z ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) +
            ∑ j : Fin r_exp, (a_coeff j) * (z ^ ((p F) ^ (j : ℕ)))) ∧
      (∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
        normLM F hM_CK (1 + IntermediateField.inclusion hM_CK z * ((ϖ_K ^ t : Kˣ) : K)) -
          (1 + P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C)) = 0 ∨
          (t + 1 : ℤ) ≤ valL F M_C
            (normLM F hM_CK (1 + IntermediateField.inclusion hM_CK z * ((ϖ_K ^ t : Kˣ) : K)) -
              (1 + P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C)))))
    (c'_χ' : Lˣ) (c'_χ'E : Eˣ)
    (c'_μ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (c'_θ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (hcond_E : 2 ≤ condExp F E (χ'.comp (Units.map (normLM F hLE))))
    (hc_L_val : valL F L (c'_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_L_top : ∀ x : L, (x = 0 ∨ ((condExp F L χ' - 1 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c'_χ'⁻¹ : Lˣ) : L) * x))
    (hc_E_val : valL F E (c'_χ'E : E) =
      (condExp F E (χ'.comp (Units.map (normLM F hLE))) : ℤ) +
        condExpChar F E (traceChar F hLE ψ))
    (hc_E_top : ∀ y : E,
      (y = 0 ∨ ((condExp F E (χ'.comp (Units.map (normLM F hLE))) - 1 : ℕ) : ℤ) ≤ valL F E y) →
      ∀ hy : 1 + y ≠ 0,
        ((χ'.comp (Units.map (normLM F hLE))) (Units.mk0 (1 + y) hy) : Ω F) =
          (traceChar F hLE ψ) (((c'_χ'E⁻¹ : Eˣ) : E) * y))
    (hc_orb : ∀ i : Fin D_orb.length,
      let F_i := (D_orb.get i).field
      let ψ_Fi := traceChar F (D_orb.get i).le ψ
      let θ_i := μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
      2 ≤ condExp F F_i (μ'_orb i) ∧
      2 ≤ condExp F F_i θ_i ∧
      valL F F_i (c'_μ i : F_i) =
        (condExp F F_i (μ'_orb i) : ℤ) + condExpChar F F_i ψ_Fi ∧
      (∀ x : F_i, (x = 0 ∨ ((condExp F F_i (μ'_orb i) - 1 : ℕ) : ℤ) ≤ valL F F_i x) →
        ∀ hx : 1 + x ≠ 0,
          (μ'_orb i (Units.mk0 (1 + x) hx) : Ω F) =
            ψ_Fi ((((c'_μ i)⁻¹ : F_iˣ) : F_i) * x)) ∧
      valL F F_i (c'_θ i : F_i) =
        (condExp F F_i θ_i : ℤ) + condExpChar F F_i ψ_Fi ∧
      (∀ x : F_i, (x = 0 ∨ ((condExp F F_i θ_i - 1 : ℕ) : ℤ) ≤ valL F F_i x) →
        ∀ hx : 1 + x ≠ 0,
          (θ_i (Units.mk0 (1 + x) hx) : Ω F) =
            ψ_Fi ((((c'_θ i)⁻¹ : F_iˣ) : F_i) * x)))
    (hExpBal :
      (2 * condExpChar F E (traceChar F hLE ψ) +
          (condExp F E (χ'.comp (Units.map (normLM F hLE))) : ℤ)) * (resDeg F E : ℤ) +
        2 * condExpChar F L ψ * (resDeg F L : ℤ) +
        ∑ i : Fin D_orb.length,
          (2 * condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) +
            (condExp F (D_orb.get i).field (μ'_orb i) : ℤ)) *
            (resDeg F (D_orb.get i).field : ℤ) =
      2 * condExpChar F E (traceChar F hLE ψ) * (resDeg F E : ℤ) +
        (2 * condExpChar F L ψ + (condExp F L χ' : ℤ)) * (resDeg F L : ℤ) +
        ∑ i : Fin D_orb.length,
          (2 * condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) +
            (condExp F (D_orb.get i).field
              (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) : ℤ)) *
            (resDeg F (D_orb.get i).field : ℤ))
    (hNormCong :
      Units.map (normLM F hLE) c'_χ'E *
        (c'_χ' *
          (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_θ i)))⁻¹ ∈
        unitGroup F L 1)
    (k_L k_E : Type u) [Field k_L] [Fintype k_L] [Field k_E] [Fintype k_E]
    (resL : L → k_L) (resE : E → k_E)
    (ψ_0L : AddChar k_L (Ω F)) (ψ_0E : AddChar k_E (Ω F))
    (k_Fi : Fin D_orb.length → Type u)
    [∀ i, Field (k_Fi i)] [∀ i, Fintype (k_Fi i)]
    (resFi : ∀ i : Fin D_orb.length, (D_orb.get i).field → k_Fi i)
    (ϖ_Fi : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (ψ_0μ : ∀ i : Fin D_orb.length, AddChar (k_Fi i) (Ω F))
    (ψ_0θ : ∀ i : Fin D_orb.length, AddChar (k_Fi i) (Ω F))
    (hresL_props :
      IsResidueFieldMap F L k_L resL ∧
      IsStatResChar F L ψ χ' ϖ_L c'_χ' k_L resL ψ_0L)
    (hresE_props :
      IsResidueFieldMap F E k_E resE ∧
      IsStatResChar F E (traceChar F hLE ψ)
