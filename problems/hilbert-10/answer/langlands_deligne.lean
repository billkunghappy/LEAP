      hξE_ne hcond_χE'_pos hχE'_cond_self hcond_χM₁'_pos hχM₁'_cond_self
      hχE_pow hχM₁_pow hCommonRest
  exact ⟨hν_triv1, hcond_νE_le1, hcond_νM₁_le1, hν_not_both0,
    fun y => (hDiamondNorm_E y).1, fun z => (hDiamondNorm_M₁ z).1,
    hχE_pow, hχM₁_pow,
    ⟨fun h => hUnramConj_M₁ h.2, fun h => hUnramConj_E h.2⟩,
    hχE'_cond_self, hχM₁'_cond_self,
    fun j hj => ⟨(hξE_pack j hj).1, (hξE_pack j hj).2.2.2.1, (hξE_pack j hj).2.2.2.2⟩,
    fun j hj => ⟨(hξM₁_pack j hj).1, (hξM₁_pack j hj).2.2.2.1, (hξM₁_pack j hj).2.2.2.2⟩,
    hCommonRest, hFML_E, hFML_M₁, hLHS_ne0, hRHS_ne0, hPow, hlam_L_exists⟩

theorem ld_ch12_tame_higher_cond_comparison (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E M₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E] [FiniteDimensional F M₁]
    (hLE : L ≤ E) (hLM₁ : L ≤ M₁)
    (hGalLE : IsGaloisExt F L E) (hGalLM₁ : IsGaloisExt F L M₁)
    (hAbLE : IsAbelianExt F hLE) (hAbLM₁ : IsAbelianExt F hLM₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE)))
    (hTame : Module.finrank L (IntermediateField.extendScalars hLE) ≠ p F)
    (hdegM₁ : Module.finrank L (IntermediateField.extendScalars hLM₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (hψM₁ : IsAdmissibleChar F M₁ (traceChar F hLM₁ ψ))
    (νE νM₁ lam_L : Lˣ →* (Ω F)ˣ)
    (χE' : Eˣ →* (Ω F)ˣ) (χM₁' : M₁ˣ →* (Ω F)ˣ)
    (hνE_pow : νE ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1)
    (hνE_ne : νE ≠ 1)
    (hνE_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE)) ↔ νE x = 1)
    (hνE_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
      ∀ u ∈ unitGroup F L (condExp F L (νE ^ j)), (νE ^ j) u = 1)
    (hνM₁_pow : νM₁ ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1)
    (hνM₁_ne : νM₁ ≠ 1)
    (hνM₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁)) ↔ νM₁ x = 1)
    (hνM₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁ ^ j)), (νM₁ ^ j) u = 1)
    (hν_triv1 : ∀ u ∈ unitGroup F L 1, νE u = 1 ∧ νM₁ u = 1)
    (hlam_E_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
      ∀ u ∈ unitGroup F L (condExp F L (νE ^ j * lam_L)), (νE ^ j * lam_L) u = 1)
    (hlam_M₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁ ^ j * lam_L)), (νM₁ ^ j * lam_L) u = 1)
    (hlam_normE_cond : ∀ u ∈ unitGroup F E (condExp F E (lam_L.comp (Units.map (normLM F hLE)))),
      (lam_L.comp (Units.map (normLM F hLE))) u = 1)
    (hlam_normM₁_cond : ∀ u ∈ unitGroup F M₁ (condExp F M₁ (lam_L.comp (Units.map (normLM F hLM₁)))),
      (lam_L.comp (Units.map (normLM F hLM₁))) u = 1)
    (hχE0_triv1 : ∀ u ∈ unitGroup F E 1,
      (χE' * (lam_L.comp (Units.map (normLM F hLE)))⁻¹) u = 1)
    (hχM₁0_triv1 : ∀ u ∈ unitGroup F M₁ 1,
      (χM₁' * (lam_L.comp (Units.map (normLM F hLM₁)))⁻¹) u = 1)
    (hRest0 : ∀ x : Lˣ,
      (χE' * (lam_L.comp (Units.map (normLM F hLE)))⁻¹)
          (Units.map (IntermediateField.inclusion hLE).toMonoidHom x) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE)), (νE ^ j) x) =
      (χM₁' * (lam_L.comp (Units.map (normLM F hLM₁)))⁻¹)
          (Units.map (IntermediateField.inclusion hLM₁).toMonoidHom x) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE)), (νM₁ ^ j) x))
    (hFML_E :
      tateEps F E (lam_L.comp (Units.map (normLM F hLE))) (traceChar F hLE ψ) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE)),
          tateEps F L (νE ^ j) ψ) =
      tateEps F E 1 (traceChar F hLE ψ) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE)),
          tateEps F L (νE ^ j * lam_L) ψ))
    (hFML_M₁ :
      tateEps F M₁ (lam_L.comp (Units.map (normLM F hLM₁))) (traceChar F hLM₁ ψ) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE)),
          tateEps F L (νM₁ ^ j) ψ) =
      tateEps F M₁ 1 (traceChar F hLM₁ ψ) *
        (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE)),
          tateEps F L (νM₁ ^ j * lam_L) ψ))
    (ha2 : 2 ≤ condExp F L lam_L) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
    let ψE := traceChar F hLE ψ
    let ψM₁ := traceChar F hLM₁ ψ
    tateEps F E χE' ψE * tateEps F M₁ 1 ψM₁ *
      (∏ j ∈ Finset.range ℓ, tateEps F L (νE ^ j) ψ) =
    tateEps F M₁ χM₁' ψM₁ * tateEps F E 1 ψE *
      (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ) :=
by
  intro ℓ ψE ψM₁
  have hvalL := ld_valL_and_unitGroup_props F L
  rcases hvalL with ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, hval_surj_L, hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩
  have hvalL_sub : ∀ (k : ℤ) (x₁ x₂ : L),
      (x₁ = 0 ∨ k ≤ valL F L x₁) → (x₂ = 0 ∨ k ≤ valL F L x₂) →
      (x₁ - x₂ = 0 ∨ k ≤ valL F L (x₁ - x₂)) := by
    intro k x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg]
    apply hval_add_L k x₁ (-x₂) hx₁
    rcases hx₂ with rfl | hx₂
    · exact Or.inl neg_zero
    · exact Or.inr (by rw [hval_neg_L]; exact hx₂)
  have hlam_cond0 : ∀ u ∈ unitGroup F L (condExp F L lam_L), lam_L u = 1 := by
    intro u hu
    have h0 := hlam_E_cond 0 hPrime.pos u
    have hpow0 : νE ^ 0 * lam_L = lam_L := by rw [pow_zero, one_mul]
    rw [hpow0] at h0
    exact h0 hu
  obtain ⟨⟨c_lam, hc_val, hc_stat⟩, hStatL_all⟩ :=
    ld_tame_stationary_phase_and_stable_twist F L ψ hψ lam_L ha2
  have hStatL := (hStatL_all c_lam hc_val hc_stat).1
  
  have ld_tame_base_stationary_and_twist_prod :
      ∀ (ν : Lˣ →* (Ω F)ˣ),
        (∀ u ∈ unitGroup F L 1, ν u = 1) →
        (∀ j : ℕ, condExp F L lam_L ≤ condExp F L (ν ^ j * lam_L)) ∧
        (∏ j ∈ Finset.range ℓ, tateEps F L (ν ^ j * lam_L) ψ) =
          (((∏ j ∈ Finset.range ℓ, (ν ^ j) c_lam : (Ω F)ˣ) : Ω F)) *
            (tateEps F L lam_L ψ) ^ ℓ := by
    intro ν hν1
    have hd1 : 1 ≤ condExp F L lam_L / 2 := by omega
    have hν_triv_d : ∀ j : ℕ, ∀ u ∈ unitGroup F L (condExp F L lam_L / 2), (ν ^ j) u = 1 := by
      intro j u hu
      have hu_d : (u : L) = 1 ∨ ((condExp F L lam_L / 2 : ℕ) : ℤ) ≤ valL F L ((u : L) - 1) :=
        (hunit_ge1_L (condExp F L lam_L / 2) hd1 u).mp hu
      have hu_1 : u ∈ unitGroup F L 1 := by
        apply (hunit_ge1_L 1 le_rfl u).mpr
        rcases hu_d with h1 | hval
        · exact Or.inl h1
        · exact Or.inr (by omega)
      rw [MonoidHom.pow_apply, hν1 u hu_1, one_pow]
    refine ⟨fun j => le_of_eq ((hStatL (ν ^ j) (hν_triv_d j)).1).symm, ?_⟩
    have hprod_eq : (∏ j ∈ Finset.range ℓ, tateEps F L (ν ^ j * lam_L) ψ) =
        ∏ j ∈ Finset.range ℓ, ((((ν ^ j) c_lam : (Ω F)ˣ) : Ω F) * tateEps F L lam_L ψ) := by
      refine Finset.prod_congr rfl fun j _ => ?_
      exact (hStatL (ν ^ j) (hν_triv_d j)).2
    rw [hprod_eq, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_range,
      ← Units.coe_prod]
  obtain ⟨hMinCond_E, hProd_E⟩ :=
    ld_tame_base_stationary_and_twist_prod νE (fun u hu => (hν_triv1 u hu).1)
  obtain ⟨hMinCond_M₁, hProd_M₁⟩ :=
    ld_tame_base_stationary_and_twist_prod νM₁ (fun u hu => (hν_triv1 u hu).2)
  
  have ld_unramified_higher_cond_norm_stationary_twist :
      ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K]
        (hLK : L ≤ K) (χ_K' : Kˣ →* (Ω F)ˣ),
        (∀ u ∈ unitGroup F K 1,
          (χ_K' * (lam_L.comp (Units.map (normLM F hLK)))⁻¹) u = 1) →
        (∀ x : L, valL F K (IntermediateField.inclusion hLK x) = valL F L x) →
        condExpChar F K (traceChar F hLK ψ) = condExpChar F L ψ →
        condExp F K (lam_L.comp (Units.map (normLM F hLK))) = condExp F L lam_L →
        (∀ (m : ℤ) (y : K), (y = 0 ∨ m ≤ valL F K y) →
          (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y))) →
        (∀ (d : ℕ), 1 ≤ d → ∀ y : K, (y = 0 ∨ (d : ℤ) ≤ valL F K y) →
          (normLM F hLK (1 + y) - (1 + traceLM F hLK y) = 0 ∨
            (2 * d : ℤ) ≤ valL F L (normLM F hLK (1 + y) - (1 + traceLM F hLK y)))) →
        let θ_K := lam_L.comp (Units.map (normLM F hLK))
        let A := condExp F K θ_K
        let R₀ := (A + 1) / 2
        let c_K := Units.map (IntermediateField.inclusion hLK).toMonoidHom c_lam
        2 ≤ A ∧
        valL F K (c_K : K) = (A : ℤ) + condExpChar F K (traceChar F hLK ψ) ∧
        (∀ y : K, (y = 0 ∨ (R₀ : ℤ) ≤ valL F K y) →
          ∀ hy : 1 + y ≠ 0,
            (θ_K (Units.mk0 (1 + y) hy) : Ω F) =
              (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * y)) ∧
        (∀ u ∈ unitGroup F K (A / 2), (χ_K' * θ_K⁻¹) u = 1) := by
    intro K _ hLK χ_K' hχK0_triv1 hval_alg hcondChar_eq hcond_K htr_bound hnorm_lin1
    intro θ_K A R₀ c_K
    have hunit_ge1_K := (ld_valL_and_unitGroup_props F K).2.2.2.2.2.2.2.2.2.1
    have hA_eq : A = condExp F L lam_L := hcond_K
    have hA2 : 2 ≤ A := by omega
    have hc_K_coe : (c_K : K) = IntermediateField.inclusion hLK (c_lam : L) := rfl
    have hc_K_inv : ((c_K⁻¹ : Kˣ) : K) = IntermediateField.inclusion hLK ((c_lam⁻¹ : Lˣ) : L) := rfl
    have hcK_val : valL F K (c_K : K) = (A : ℤ) + condExpChar F K (traceChar F hLK ψ) := by
      rw [hc_K_coe, hval_alg (c_lam : L), hc_val, hA_eq, hcondChar_eq]
    have htrace_smul : ∀ (x : L) (y : K),
        traceLM F hLK (IntermediateField.inclusion hLK x * y) = x * traceLM F hLK y := by
      letI : Module L L := Semiring.toModule
      intro x y
      have hmul : toExtendScalars F hLK (IntermediateField.inclusion hLK x * y) =
          x • toExtendScalars F hLK y := Subtype.ext rfl
      exact (congrArg (Algebra.trace L (IntermediateField.extendScalars hLK)) hmul).trans
        ((Algebra.trace L (IntermediateField.extendScalars hLK)).map_smul' x (toExtendScalars F hLK y))
    have hcK_stat : ∀ y : K, (y = 0 ∨ (R₀ : ℤ) ≤ valL F K y) →
        ∀ hy : 1 + y ≠ 0,
          (θ_K (Units.mk0 (1 + y) hy) : Ω F) =
            (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * y) := by
      intro y hy_cond hy
      rcases hy_cond with rfl | hy_val
      · have hmk1 : Units.mk0 (1 + (0 : K)) hy = 1 := by ext; simp
        rw [hmk1, map_one, Units.val_one, mul_zero, AddChar.map_zero_eq_one]
      · set a := condExp F L lam_L
        let r₀ : ℕ := (a + 1) / 2
        have hR₀_eq : R₀ = r₀ := by
          change (A + 1) / 2 = (a + 1) / 2
          rw [hA_eq]
        have hr₀_ge1 : 1 ≤ r₀ := by
          change 1 ≤ (condExp F L lam_L + 1) / 2
          omega
        have hy_r₀ : y = 0 ∨ (r₀ : ℤ) ≤ valL F K y := by
          right
          rw [← hR₀_eq]
          exact hy_val
        have ht_cond : traceLM F hLK y = 0 ∨ (r₀ : ℤ) ≤ valL F L (traceLM F hLK y) :=
          htr_bound (r₀ : ℤ) y hy_r₀
        set t : L := traceLM F hLK y
        have ht_ge1 : t = 0 ∨ 1 ≤ valL F L t := by
          rcases ht_cond with h0 | hval
          · exact Or.inl h0
          · exact Or.inr (by omega)
        have ht_ne : 1 + t ≠ 0 := by
          rcases ht_ge1 with h0 | hval
          · rw [h0, add_zero]
            exact one_ne_zero
          · intro h1t
            have ht_eq_neg1 : t = -1 := eq_neg_of_add_eq_zero_right h1t
            rw [ht_eq_neg1, hval_neg1_L] at hval
            omega
        have ht_val0 : valL F L (1 + t) = 0 := by
          rcases ht_ge1 with h0 | hval
          · rw [h0, add_zero, hval1_L]
          · have h1t_int : 1 + t = 0 ∨ 0 ≤ valL F L (1 + t) := by
              apply hval_add_L 0 1 t (Or.inr (by rw [hval1_L]))
              exact Or.inr (by omega)
            have hge0 : 0 ≤ valL F L (1 + t) := h1t_int.resolve_left ht_ne
            by_contra hne0
            have hge1 : 1 ≤ valL F L (1 + t) := by omega
            have h1_ge1 : (1 : L) = 0 ∨ 1 ≤ valL F L 1 := by
              have heq : (1 : L) = (1 + t) - t := by ring
              rw [heq]
              exact hvalL_sub 1 (1 + t) t (Or.inr hge1) (Or.inr hval)
            rcases h1_ge1 with h10 | h1v
            · exact one_ne_zero h10
            · rw [hval1_L] at h1v
              omega
        have hΔ_raw := hnorm_lin1 r₀ hr₀_ge1 y hy_r₀
        set Δ : L := normLM F hLK (1 + y) - (1 + t)
        have hΔ_cond : Δ = 0 ∨ (a : ℤ) ≤ valL F L Δ := by
          rcases hΔ_raw with h0 | hval
          · exact Or.inl h0
          · right
            have h2r₀_ge : (a : ℤ) ≤ (2 * r₀ : ℤ) := by
              have : a ≤ 2 * ((a + 1) / 2) := by omega
              exact_mod_cast this
            exact le_trans h2r₀_ge hval
        let u_t : Lˣ := Units.mk0 (1 + t) ht_ne
        let u_y : Lˣ := Units.map (normLM F hLK) (Units.mk0 (1 + y) hy)
        let u_Δ : Lˣ := u_t⁻¹ * u_y
        have hu_t_inv_val : valL F L ((u_t⁻¹ : Lˣ) : L) = 0 := by
          rw [hval_inv_L u_t]
          change - valL F L (1 + t) = 0
          rw [ht_val0, neg_zero]
        have hu_Δ_sub : (u_Δ : L) - 1 = ((u_t⁻¹ : Lˣ) : L) * Δ := by
          have hu_t_mul : ((u_t⁻¹ : Lˣ) : L) * (1 + t) = 1 := u_t.inv_mul
          have hu_y_coe : (u_y : L) = (1 + t) + Δ := by
            change normLM F hLK (1 + y) = (1 + t) + (normLM F hLK (1 + y) - (1 + t))
            ring
          calc (u_Δ : L) - 1 = ((u_t⁻¹ : Lˣ) : L) * (u_y : L) - ((u_t⁻¹ : Lˣ) : L) * (1 + t) := by
                rw [Units.val_mul, hu_t_mul]
            _ = ((u_t⁻¹ : Lˣ) : L) * ((1 + t) + Δ) - ((u_t⁻¹ : Lˣ) : L) * (1 + t) := by
                rw [hu_y_coe]
            _ = ((u_t⁻¹ : Lˣ) : L) * Δ := by ring
        have hu_Δ_mem : u_Δ ∈ unitGroup F L a := by
          apply (hunit_ge1_L a (by omega) u_Δ).mpr
          rcases hΔ_cond with h0 | hval
          · left
            apply sub_eq_zero.mp
            rw [hu_Δ_sub, h0, mul_zero]
          · by_cases hΔ0 : Δ = 0
            · left
              apply sub_eq_zero.mp
              rw [hu_Δ_sub, hΔ0, mul_zero]
            · right
              rw [hu_Δ_sub, hval_mul_L ((u_t⁻¹ : Lˣ) : L) Δ (Units.ne_zero _) hΔ0,
                hu_t_inv_val, zero_add]
              exact hval
        have hlam_uΔ : lam_L u_Δ = 1 := hlam_cond0 u_Δ hu_Δ_mem
        have hu_y_eq : u_y = u_t * u_Δ := (mul_inv_cancel_left u_t u_y).symm
        have hlam_uy : (θ_K (Units.mk0 (1 + y) hy) : Ω F) = (lam_L u_t : Ω F) := by
          change (lam_L u_y : Ω F) = (lam_L u_t : Ω F)
          rw [hu_y_eq, map_mul, hlam_uΔ, mul_one]
        have hstat_t : (lam_L u_t : Ω F) = ψ (((c_lam⁻¹ : Lˣ) : L) * t) :=
          hc_stat t ht_cond ht_ne
        have hψ_eq : ψ (((c_lam⁻¹ : Lˣ) : L) * t) =
            (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * y) := by
          unfold traceChar
          rw [AddChar.compAddMonoidHom_apply, hc_K_inv, htrace_smul ((c_lam⁻¹ : Lˣ) : L) y]
        exact hlam_uy.trans (hstat_t.trans hψ_eq)
    have hχK0_triv_d : ∀ u ∈ unitGroup F K (A / 2), (χ_K' * θ_K⁻¹) u = 1 := by
      intro u hu
      have hA_div : 1 ≤ A / 2 := by omega
      have hu_d : (u : K) = 1 ∨ ((A / 2 : ℕ) : ℤ) ≤ valL F K ((u : K) - 1) :=
        (hunit_ge1_K (A / 2) hA_div u).mp hu
      have hu_1 : u ∈ unitGroup F K 1 := by
        apply (hunit_ge1_K 1 le_rfl u).mpr
        rcases hu_d with h1 | hval
        · exact Or.inl h1
        · exact Or.inr (by omega)
      exact hχK0_triv1 u hu_1
    exact ⟨hA2, hcK_val, hcK_stat, hχK0_triv_d⟩
  
  have ld_tame_ramified_higher_cond_norm_stationary_twist :
      ∀ (K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F K]
        (hLK : L ≤ K)
        (hPrimeK : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
        (χ_K' : Kˣ →* (Ω F)ˣ),
        (∀ u ∈ unitGroup F K 1,
          (χ_K' * (lam_L.comp (Units.map (normLM F hLK)))⁻¹) u = 1) →
        (∀ x : L,
          valL F K (IntermediateField.inclusion hLK x) =
            (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x) →
        condExpChar F K (traceChar F hLK ψ) =
          (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * (condExpChar F L ψ + 1) - 1 →
        (∀ (m : ℤ) (y : K),
          (y = 0 ∨ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
            ((Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) - 1) ≤ valL F K y) →
          (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y))) →
        (∀ y : K, (y = 0 ∨ 1 ≤ valL F K y) →
          normLM F hLK (1 + y) - (1 + traceLM F hLK y) = 0 ∨
            2 * valL F K y ≤
              (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
                valL F L (normLM F hLK (1 + y) - (1 + traceLM F hLK y))) →
        condExp F K (lam_L.comp (Units.map (normLM F hLK))) =
          Module.finrank L (IntermediateField.extendScalars hLK) * (condExp F L lam_L - 1) + 1 →
        let θ_K := lam_L.comp (Units.map (normLM F hLK))
        let A := condExp F K θ_K
        let R₀ := (A + 1) / 2
        let c_K := Units.map (IntermediateField.inclusion hLK).toMonoidHom c_lam
        2 ≤ A ∧
