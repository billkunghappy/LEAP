      (IntermediateField.inclusion hM₁'K₁ z = 0 ∨
        (p : ℤ) * q ≤ valL F K₁ (IntermediateField.inclusion hM₁'K₁ z)) := by
    intro z q hz
    rcases hz with rfl | hge
    · left; exact map_zero (IntermediateField.inclusion hM₁'K₁)
    · right
      rw [hval_M₁'K₁ z]
      exact Int.mul_le_mul_of_nonneg_left hge (by positivity)
  have hs_val_M₁' : s = 0 ∨ ((p - 1 : ℕ) : ℤ) * (δ : ℤ) ≤ valL F M₁' s := by
    have he_p1 := he_Δ_val (p - 1) (Finset.mem_Icc.mpr ⟨by omega, le_rfl⟩)
    rcases he_p1 with he0 | he_ge
    · left; dsimp [s]; rw [he0, neg_zero]
    · right
      dsimp [s]
      rw [hvalM₁'_neg]
      have h1 : ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) =
          ((p - 1 : ℕ) : ℤ) * (δ : ℤ) := by
        rw [ht₂_eq]; push_cast; ring
      linarith
  have hδ₁_val : δ₁ = 0 ∨ Z_bound ≤ valL F K₁ δ₁ := by
    have hs_K₁ := hval_incl_M₁'K₁_ge s (((p - 1 : ℕ) : ℤ) * (δ : ℤ)) hs_val_M₁'
    have hmul := hvalK₁_mul_ge (-(t₁ : ℤ)) ((p : ℤ) * (((p - 1 : ℕ) : ℤ) * (δ : ℤ)))
      (Δ : K₁) (IntermediateField.inclusion hM₁'K₁ s)
      (Or.inr (le_of_eq hΔ_val.symm)) hs_K₁
    apply hvalK₁_mono Z_bound _ δ₁ _ hmul
    dsimp [Z_bound]
    push_cast; linarith
  
  have huW_L : u * W = 1 := by
    have hα_inv : (α : L) * ((α⁻¹ : Lˣ) : L) = 1 := Units.mul_inv α
    have hγ_inv : (γ : L) * ((γ⁻¹ : Lˣ) : L) = 1 := Units.mul_inv γ
    dsimp [u, W]
    linear_combination ((α : L) * ((α⁻¹ : Lˣ) : L)) * hγ_inv + hα_inv
  have huW_E' : IntermediateField.inclusion hLE' u * W_E' = 1 := by
    dsimp [W_E']
    rw [← map_mul, huW_L, map_one]
  have hWC_E' : W_E' * C = W_E' + a := by
    dsimp [C]
    linear_combination a * huW_E'
  have hWC_K₁ : W_K₁ * C_K₁ = W_K₁ + a_K₁ := by
    dsimp [W_K₁, C_K₁, a_K₁]
    rw [← map_mul, hWC_E', map_add]
  have hWC_sq : W_K₁ ^ 2 * C_K₁ ^ 2 = (W_K₁ + a_K₁) ^ 2 := by
    rw [← mul_pow, hWC_K₁]
  have hp_odd_nat : Odd p := Nat.Prime.odd_of_ne_two hPrime hp_ne2
  have hp2_odd : Odd (p - 2) := Nat.Odd.sub_even hp_ge2 hp_odd_nat even_two
  have hneg1_p2 : (-1 : K₁) ^ (p - 2) = -1 := Odd.neg_one_pow hp2_odd
  have hY₀_eq : Y₀ = (-1 : K₁) * (W_K₁ + a_K₁) := by
    dsimp [Y₀, W_K₁, a_K₁]
    rw [map_neg, map_add]
    ring
  have hY₀_pow : Y₀ ^ (p - 2) = - (W_K₁ + a_K₁) ^ (p - 2) := by
    rw [hY₀_eq, mul_pow, hneg1_p2]
    ring
  have hWa_pow_p :
      (W_K₁ + a_K₁) ^ (p - 2) * (W_K₁ + a_K₁) ^ 2 = (W_K₁ + a_K₁) ^ p := by
    rw [← pow_add, Nat.sub_add_cancel hp_ge2]
  have hD₀_K₁_eq : D₀_K₁ = W_K₁ ^ p - W_K₁ + a_K₁ ^ p := by
    dsimp [D₀_K₁, D₀_E', W_K₁, a_K₁]
    simp only [map_add, map_sub, map_pow]
  set F_bin : K₁ := (W_K₁ + a_K₁) ^ p - W_K₁ ^ p - a_K₁ ^ p
  have hnum_id :
      W_K₁ ^ 2 * Y₀ ^ (p - 2) * C_K₁ ^ 2 + D₀_K₁ = - (W_K₁ + F_bin) := by
    have h1 : W_K₁ ^ 2 * Y₀ ^ (p - 2) * C_K₁ ^ 2 =
        - ((W_K₁ + a_K₁) ^ (p - 2) * (W_K₁ ^ 2 * C_K₁ ^ 2)) := by
      rw [hY₀_pow]; ring
    rw [h1, hWC_sq, hWa_pow_p, hD₀_K₁_eq]
    dsimp [F_bin]
    ring
  have hD₀_inv_mul : D₀_K₁ * D₀_K₁⁻¹ = 1 := mul_inv_cancel₀ hD₀_K₁_ne0
  have hC_inv_mul : C_K₁ * C_K₁⁻¹ = 1 := mul_inv_cancel₀ hC_K₁_ne0
  have hfrac_id :
      W_K₁ ^ 2 * Y₀ ^ (p - 2) * D₀_K₁⁻¹ + C_K₁⁻¹ ^ 2 =
        (W_K₁ ^ 2 * Y₀ ^ (p - 2) * C_K₁ ^ 2 + D₀_K₁) * D₀_K₁⁻¹ * C_K₁⁻¹ ^ 2 := by
    linear_combination
      - (W_K₁ ^ 2 * Y₀ ^ (p - 2) * D₀_K₁⁻¹ * (C_K₁ * C_K₁⁻¹ + 1)) * hC_inv_mul
      - (C_K₁⁻¹ ^ 2) * hD₀_inv_mul
  have hC1_factor :
      W_K₁ ^ 2 * Y₀ ^ (p - 2) * D₀_K₁⁻¹ + IntermediateField.inclusion hE'K₁ (C⁻¹ ^ 2) =
        - (W_K₁ + F_bin) * (D₀_K₁⁻¹ * C_K₁⁻¹ ^ 2) := by
    rw [hC_inv_sq_map, hfrac_id, hnum_id]
    ring
  
  have hchoose_valK₁ : ∀ k : ℕ, 0 < k → k < p →
      ((p.choose k : ℕ) : K₁) = 0 ∨
        ((p * (p - 1) * t₂ : ℕ) : ℤ) ≤ valL F K₁ ((p.choose k : ℕ) : K₁) := by
    intro k hk_pos hk_lt
    obtain ⟨c_k, hc_k⟩ := Nat.Prime.dvd_choose_self hPrime (by omega : k ≠ 0) hk_lt
    rw [hc_k, Nat.cast_mul]
    have hmul := hvalK₁_mul_ge (((p * (p - 1) * t₂ : ℕ) : ℤ)) 0
      ((p : ℕ) : K₁) ((c_k : ℕ) : K₁) hp_valK₁ (hvalK₁_natCast c_k)
    rwa [add_zero] at hmul
  have frob_add_pow_sub : ∀ (x y : K₁) (qx qy : ℤ),
      qx ≤ qy →
      (x = 0 ∨ qx ≤ valL F K₁ x) →
      (y = 0 ∨ qy ≤ valL F K₁ y) →
      (x + y) ^ p - x ^ p - y ^ p = 0 ∨
        ((p * (p - 1) * t₂ : ℕ) : ℤ) + ((p - 1 : ℕ) : ℤ) * qx + qy ≤
          valL F K₁ ((x + y) ^ p - x ^ p - y ^ p) := by
    intro x y qx qy hq_le hx hy
    have h_peel :
        (x + y) ^ p - x ^ p - y ^ p =
          ∑ k ∈ Finset.range (p - 1),
            y ^ (k + 1) * x ^ (p - 1 - k) * ((p.choose (k + 1) : ℕ) : K₁) := by
      have hcomm : (x + y) ^ p = (y + x) ^ p := congrArg (· ^ p) (add_comm x y)
      rw [hcomm, add_pow y x p, Finset.sum_range_succ _ p]
      have hrange : Finset.range p = Finset.range ((p - 1) + 1) :=
        congrArg Finset.range (by omega)
      rw [hrange, Finset.sum_range_succ' _ (p - 1)]
      simp only [Nat.sub_self, pow_zero, mul_one, Nat.choose_self, Nat.cast_one,
        Nat.sub_zero, one_mul, Nat.choose_zero_right]
      have hsum_eq :
          (∑ k ∈ Finset.range (p - 1),
            y ^ (k + 1) * x ^ (p - (k + 1)) * ((p.choose (k + 1) : ℕ) : K₁)) =
          ∑ k ∈ Finset.range (p - 1),
            y ^ (k + 1) * x ^ (p - 1 - k) * ((p.choose (k + 1) : ℕ) : K₁) := by
        apply Finset.sum_congr rfl
        intro k _
        have hsub : p - (k + 1) = p - 1 - k := by omega
        rw [hsub]
      rw [hsum_eq]
      ring
    rw [h_peel]
    apply hvalK₁_sum_ge (Finset.range (p - 1)) _
      (((p * (p - 1) * t₂ : ℕ) : ℤ) + ((p - 1 : ℕ) : ℤ) * qx + qy)
    intro k hk_mem
    have hk_lt : k < p - 1 := Finset.mem_range.mp hk_mem
    have hy_pow := hvalK₁_pow_ge y (k + 1) qy hy
    have hx_pow := hvalK₁_pow_ge x (p - 1 - k) qx hx
    have hch := hchoose_valK₁ (k + 1) (by omega) (by omega)
    have hmul1 := hvalK₁_mul_ge (((k + 1 : ℕ) : ℤ) * qy) (((p - 1 - k : ℕ) : ℤ) * qx)
      (y ^ (k + 1)) (x ^ (p - 1 - k)) hy_pow hx_pow
    have hmul2 := hvalK₁_mul_ge
      (((k + 1 : ℕ) : ℤ) * qy + ((p - 1 - k : ℕ) : ℤ) * qx)
      (((p * (p - 1) * t₂ : ℕ) : ℤ))
      (y ^ (k + 1) * x ^ (p - 1 - k)) ((p.choose (k + 1) : ℕ) : K₁) hmul1 hch
    apply hvalK₁_mono _ _ _ _ hmul2
    have hsub_k : ((p - 1 - k : ℕ) : ℤ) = ((p - 1 : ℕ) : ℤ) - (k : ℤ) :=
      Nat.cast_sub (by omega : k ≤ p - 1)
    have hnonneg : 0 ≤ (k : ℤ) * (qy - qx) :=
      Int.mul_nonneg (Nat.cast_nonneg k) (by linarith)
    rw [hsub_k]
    push_cast
    linarith
  set B_denom : ℤ :=
    ((p * (p - 1) * t₂ : ℕ) : ℤ) -
      ((p - 1 : ℕ) : ℤ) * (((p * p * m : ℕ) : ℤ)) - (((p * t₁ : ℕ) : ℤ))
  have hpt₁_lt_ppm : p * t₁ < p * p * m := by
    have h1 : p * t₁ < p * (p * m) := Nat.mul_lt_mul_of_pos_left hpm_gt_t₁ hp_pos
    linarith [show p * (p * m) = p * p * m by ring]
  have hF_bin_val : F_bin = 0 ∨ B_denom ≤ valL F K₁ F_bin := by
    have hf := frob_add_pow_sub W_K₁ a_K₁ (-(((p * p * m : ℕ) : ℤ))) (-(((p * t₁ : ℕ) : ℤ)))
      (by omega) (Or.inr (le_of_eq hW_K₁_val.symm)) (Or.inr (le_of_eq ha_K₁_val.symm))
    apply hvalK₁_mono B_denom _ F_bin _ hf
    dsimp [B_denom]; linarith
  set B_inner : ℤ := -((p - 1 : ℕ) : ℤ) * (((p * p * m : ℕ) : ℤ)) - (t₁ : ℤ)
  have hB_inner_le_W : B_inner ≤ -(((p * p * m : ℕ) : ℤ)) := by
    have hid :
        (-(((p * p * m : ℕ) : ℤ))) - B_inner =
          ((p : ℤ) - 2) * (((p * p * m : ℕ) : ℤ)) + (t₁ : ℤ) := by
      dsimp [B_inner]
      rw [hp1_cast]
      ring
    have hnonneg : 0 ≤ ((p : ℤ) - 2) * (((p * p * m : ℕ) : ℤ)) + (t₁ : ℤ) :=
      add_nonneg (Int.mul_nonneg (by omega) (by positivity)) (by omega)
    linarith
  have hB_inner_le_B_denom : B_inner ≤ B_denom := by
    have hid :
        B_denom - B_inner =
          ((p * (p - 1) * δ : ℕ) : ℤ) + ((p : ℤ) - 1) ^ 2 * (t₁ : ℤ) := by
      dsimp [B_denom, B_inner]
      rw [ht₂_eq]
      push_cast
      rw [hp1_cast]
      ring
    have hnonneg : 0 ≤ ((p * (p - 1) * δ : ℕ) : ℤ) + ((p : ℤ) - 1) ^ 2 * (t₁ : ℤ) := by
      positivity
    linarith
  have hW_inner : W_K₁ = 0 ∨ B_inner ≤ valL F K₁ W_K₁ :=
    hvalK₁_mono B_inner (-(((p * p * m : ℕ) : ℤ))) W_K₁ hB_inner_le_W
