        ∃ C : Subgroup G₀,
          C ≠ ⊥ ∧
          C.Normal ∧
          (∀ x ∈ C, ∀ y ∈ C, x * y = y * x) ∧
          (∀ H₁ : Subgroup G₀, H₁.Normal → C ≤ H₁ ∨ H₁ ⊓ C = ⊥) ∧
          (∀ H : Subgroup G₀, C ≤ H ∨ H ⊔ C < ⊤ ∨ H ⊓ C = ⊥) := by
      intro G₀ _ _ _ hcard
      let IsAbNorm : Subgroup G₀ → Prop := fun N =>
        N ≠ ⊥ ∧ N.Normal ∧ (∀ x ∈ N, ∀ y ∈ N, x * y = y * x)
      have hex_solv : ∃ n : ℕ, derivedSeries G₀ n = ⊥ := IsSolvable.solvable
      let n₀ := Nat.find hex_solv
      have hn₀_spec : derivedSeries G₀ n₀ = ⊥ := Nat.find_spec hex_solv
      have hn₀_pos : 0 < n₀ := by
        by_contra h0
        have h0' : n₀ = 0 := Nat.eq_zero_of_not_pos h0
        have htop : (⊤ : Subgroup G₀) = ⊥ := by
          rw [← derivedSeries_zero G₀, ← h0', hn₀_spec]
        have h1 : Nat.card (⊤ : Subgroup G₀) = Nat.card (⊥ : Subgroup G₀) :=
          congrArg (fun H : Subgroup G₀ => Nat.card H) htop
        rw [Subgroup.card_top, Subgroup.card_bot] at h1
        omega
      let C₀ := derivedSeries G₀ (n₀ - 1)
      have hC₀_ne : C₀ ≠ ⊥ := Nat.find_min hex_solv (Nat.sub_one_lt hn₀_pos.ne')
      have hC₀_norm : C₀.Normal := derivedSeries_normal G₀ (n₀ - 1)
      have hC₀_comm : ⁅C₀, C₀⁆ = ⊥ := by
        change ⁅derivedSeries G₀ (n₀ - 1), derivedSeries G₀ (n₀ - 1)⁆ = ⊥
        rw [← derivedSeries_succ, Nat.sub_add_cancel hn₀_pos, hn₀_spec]
      have hC₀_ab : ∀ x ∈ C₀, ∀ y ∈ C₀, x * y = y * x := by
        intro x hx y hy
        have hmem : ⁅x, y⁆ ∈ ⁅C₀, C₀⁆ := Subgroup.commutator_mem_commutator hx hy
        rw [hC₀_comm, Subgroup.mem_bot, commutatorElement_def] at hmem
        exact mul_inv_eq_one.mp (by
          calc (x * y) * (y * x)⁻¹
            _ = x * y * x⁻¹ * y⁻¹ := by group
            _ = 1 := hmem)
      have hex_m : ∃ m : ℕ, ∃ C : Subgroup G₀, IsAbNorm C ∧ Nat.card C = m :=
        ⟨Nat.card C₀, C₀, ⟨hC₀_ne, hC₀_norm, hC₀_ab⟩, rfl⟩
      obtain ⟨C, ⟨hC_ne, hC_norm, hC_ab⟩, hC_card⟩ := Nat.find_spec hex_m
      have hC_min : ∀ N : Subgroup G₀, N.Normal → N ≤ C → N = ⊥ ∨ N = C := by
        intro N hN_norm hNC
        by_cases hN_bot : N = ⊥
        · exact Or.inl hN_bot
        · right
          have hN_ab : ∀ x ∈ N, ∀ y ∈ N, x * y = y * x :=
            fun x hx y hy => hC_ab x (hNC hx) y (hNC hy)
          have hcard_le : Nat.card C ≤ Nat.card N := by
            rw [hC_card]
            exact Nat.find_min' hex_m ⟨N, ⟨hN_bot, hN_norm, hN_ab⟩, rfl⟩
          exact Subgroup.eq_of_le_of_card_ge hNC hcard_le
      refine ⟨C, hC_ne, hC_norm, hC_ab, ?_, ?_⟩
      · intro H₁ hH₁_norm
        haveI : H₁.Normal := hH₁_norm
        haveI : C.Normal := hC_norm
        have hinf_norm : (H₁ ⊓ C).Normal := Subgroup.normal_inf_normal H₁ C
        rcases hC_min (H₁ ⊓ C) hinf_norm inf_le_right with hbot | heq
        · exact Or.inr hbot
        · exact Or.inl (inf_eq_right.mp heq)
      · intro H
        by_cases hsup : H ⊔ C < ⊤
        · exact Or.inr (Or.inl hsup)
        · have hsup_top : H ⊔ C = ⊤ := not_lt_top_iff.mp hsup
          have hH_le_norm : H ≤ (H ⊓ C).normalizer := by
            intro h hh x
            rw [Subgroup.mem_inf, Subgroup.mem_inf]
            refine ⟨fun hx => ?_, fun hx => ?_⟩
            · exact ⟨H.mul_mem (H.mul_mem hh hx.1) (H.inv_mem hh), hC_norm.conj_mem x hx.2 h⟩
            · have hx1 : h⁻¹ * (h * x * h⁻¹) * h ∈ H :=
                H.mul_mem (H.mul_mem (H.inv_mem hh) hx.1) hh
              have hx2 : h⁻¹ * (h * x * h⁻¹) * (h⁻¹)⁻¹ ∈ C :=
                hC_norm.conj_mem (h * x * h⁻¹) hx.2 h⁻¹
              have heq1 : h⁻¹ * (h * x * h⁻¹) * h = x := by group
              have heq2 : h⁻¹ * (h * x * h⁻¹) * (h⁻¹)⁻¹ = x := by group
              rw [heq1] at hx1
              rw [heq2] at hx2
              exact ⟨hx1, hx2⟩
          have hC_le_norm : C ≤ (H ⊓ C).normalizer := by
            intro c hc x
            rw [Subgroup.mem_inf, Subgroup.mem_inf]
            refine ⟨fun hx => ?_, fun hx => ?_⟩
            · have hcomm : c * x * c⁻¹ = x := by
                rw [hC_ab c hc x hx.2]
                group
              rwa [hcomm]
            · have hc_mem : c * x * c⁻¹ ∈ C := hx.2
              have hcomm : c * x * c⁻¹ = x := by
                rw [hC_ab c hc x (by
                  have h1 : c⁻¹ * (c * x * c⁻¹) * c ∈ C :=
                    C.mul_mem (C.mul_mem (C.inv_mem hc) hc_mem) hc
                  have h2 : c⁻¹ * (c * x * c⁻¹) * c = x := by group
                  rwa [h2] at h1)]
                group
              rwa [← hcomm]
          have hnorm_top : (H ⊓ C).normalizer = ⊤ := by
            rw [eq_top_iff, ← hsup_top]
            exact sup_le hH_le_norm hC_le_norm
          have hinf_norm : (H ⊓ C).Normal := Subgroup.normalizer_eq_top_iff.mp hnorm_top
          rcases hC_min (H ⊓ C) hinf_norm inf_le_right with hbot | heq
          · exact Or.inr (Or.inr hbot)
          · exact Or.inl (inf_eq_right.mp heq)
    
