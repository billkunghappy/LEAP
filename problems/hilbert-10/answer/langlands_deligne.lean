    have hψ_err₂ : ψ (((α⁻¹ : Lˣ) : L) * ((1 + 4 * f) * Δ₀ * s₀' ^ 2 * Nu₁⁻¹)) = 1 :=
      hψ_alpha_inv _ herr₂_or
    have hsplit_tr :
        ((α⁻¹ : Lˣ) : L) * traceLM F hLM₁' (Δ * z₁) =
          ((α⁻¹ : Lˣ) : L) * Δ₁ * ((1 + 4 * f) * s₀' * Nu₁⁻¹) +
            ((α⁻¹ : Lˣ) : L) * ((1 + 4 * f) * Δ₀ * s₀' ^ 2 * Nu₁⁻¹) := by
      rw [htr_Δz₁]; ring
    rw [hsplit_tr, ψ.map_add_eq_mul, hψ_err₂, mul_one] at hsub_one
    exact hsub_one
  
  have hΔ₁_down : ∀ k : ℕ, k ≤ r →
      ∀ w : L, (w = 0 ∨ 2 * (r : ℤ) - (k : ℤ) ≤ valL F L w) →
        ψ (((α⁻¹ : Lˣ) : L) * Δ₁ * w) = 1 := by
    intro k
    induction' k with k ih
    · intro _ w hw
      have hΔ₁w : Δ₁ * w = 0 ∨ 2 * (r : ℤ) ≤ valL F L (Δ₁ * w) :=
        hvalL_mul_or (2 * (r : ℤ)) 0 (2 * (r : ℤ) - ((0 : ℕ) : ℤ)) Δ₁ w hΔ₁_val hw (by omega)
      rw [mul_assoc]
      exact hψ_alpha_inv (Δ₁ * w) hΔ₁w
    · intro hk w hw
      set m : ℤ := 2 * (r : ℤ) - ((k + 1 : ℕ) : ℤ)
      have hm_ge_r : (r : ℤ) ≤ m := by dsimp [m]; omega
      have h14f_inv_val : valL F L ((1 + 4 * f)⁻¹) = 0 := by
        rw [hvalL_inv_eq (1 + 4 * f) h14f_props.1, h14f_props.2, neg_zero]
      set s₀' : L := (1 + 4 * f)⁻¹ * w
      have hs₀'_m : s₀' = 0 ∨ m ≤ valL F L s₀' :=
        hvalL_mul_or m 0 m ((1 + 4 * f)⁻¹) w (Or.inr (le_of_eq h14f_inv_val.symm)) hw (by omega)
      have hs₀'_r : s₀' = 0 ∨ (r : ℤ) ≤ valL F L s₀' :=
        hvalL_mono m (r : ℤ) s₀' hs₀'_m hm_ge_r
      obtain ⟨hNu₁_ne, hψ_s₀'⟩ := hRatPhase s₀' hs₀'_r
      set η : L := s₀' - f * s₀' ^ 2
      have h1η_ne : 1 + η ≠ 0 := by
        have heq : 1 + η = 1 + s₀' - f * s₀' ^ 2 := by dsimp [η]; ring
        rw [heq]; exact hNu₁_ne
      have hs₀'2_r : s₀' ^ 2 = 0 ∨ 2 * (r : ℤ) ≤ valL F L (s₀' ^ 2) :=
        hvalL_sq_or (2 * (r : ℤ)) (r : ℤ) s₀' hs₀'_r (by omega)
      have hfs₀'2_1 : f * s₀' ^ 2 = 0 ∨ 1 ≤ valL F L (f * s₀' ^ 2) :=
        hvalL_mul_or 1 (1 - 2 * (a : ℤ)) (2 * (r : ℤ)) f (s₀' ^ 2) hf_or hs₀'2_r (by omega)
      have hη_1 : η = 0 ∨ 1 ≤ valL F L η :=
        hvalL_sub 1 (r : ℤ) 1 s₀' (f * s₀' ^ 2) hs₀'_r hfs₀'2_1 (by omega) le_rfl
      have h1η_val : valL F L (1 + η) = 0 :=
        (hvalL_eq_of_lt 0 1 1 η one_ne_zero hvalL_1 hη_1 (by omega)).2
      have h1η_inv_val : valL F L ((1 + η)⁻¹) = 0 := by
        rw [hvalL_inv_eq (1 + η) h1η_ne, h1η_val, neg_zero]
      set w₁' : L := (1 + 4 * f) * s₀' * (1 + η)⁻¹
      set w₂' : L := w * η * (1 + η)⁻¹
      have hw₁'_eq : w₁' = (1 + 4 * f) * s₀' * (1 + s₀' - f * s₀' ^ 2)⁻¹ := by
        dsimp [w₁', η]
        congr 2
        ring
      have hψ_w₁' : ψ (((α⁻¹ : Lˣ) : L) * Δ₁ * w₁') = 1 := by
        rw [hw₁'_eq]; exact hψ_s₀'
      have hw₂'_val : w₂' = 0 ∨ 2 * (r : ℤ) - (k : ℤ) ≤ valL F L w₂' := by
        have hwη : w * η = 0 ∨ m + 1 ≤ valL F L (w * η) :=
          hvalL_mul_or (m + 1) m 1 w η hw hη_1 le_rfl
        exact hvalL_mul_or (2 * (r : ℤ) - (k : ℤ)) (m + 1) 0 (w * η) ((1 + η)⁻¹)
          hwη (Or.inr (le_of_eq h1η_inv_val.symm)) (by dsimp [m]; omega)
      have hψ_w₂' : ψ (((α⁻¹ : Lˣ) : L) * Δ₁ * w₂') = 1 :=
        ih (by omega) w₂' hw₂'_val
      have hw_decomp : w = w₁' + w₂' := by
        dsimp [w₁', w₂', s₀']
        have h14f_inv : (1 + 4 * f) * (1 + 4 * f)⁻¹ = 1 := mul_inv_cancel₀ h14f_props.1
        have h1η_inv : (1 + η) * (1 + η)⁻¹ = 1 := mul_inv_cancel₀ h1η_ne
        linear_combination -w * h1η_inv - (w * (1 + η)⁻¹) * h14f_inv
      have hmul_decomp : ((α⁻¹ : Lˣ) : L) * Δ₁ * w =
          ((α⁻¹ : Lˣ) : L) * Δ₁ * w₁' + ((α⁻¹ : Lˣ) : L) * Δ₁ * w₂' := by
        rw [hw_decomp, mul_add]
      rw [hmul_decomp, ψ.map_add_eq_mul, hψ_w₁', hψ_w₂', mul_one]
  have hΔ₁_vanish : ∀ w : L, (w = 0 ∨ (r : ℤ) ≤ valL F L w) →
      ψ (((α⁻¹ : Lˣ) : L) * Δ₁ * w) = 1 := by
    intro w hw
    apply hΔ₁_down r le_rfl w
    exact hvalL_mono (r : ℤ) (2 * (r : ℤ) - (r : ℤ)) w hw (by omega)
  refine ⟨hN₁_props.1, hN₁_props.2, ?_⟩
  intro z hz_val hz
  have hz_2r : z = 0 ∨ 2 * (r : ℤ) ≤ valL F M₁' z := by
    rw [hm1_half] at hz_val
    push_cast at hz_val
    exact hz_val
  obtain ⟨s₀, s₁, hz_eq, hz_coords⟩ := hM₁'_coords z
  obtain ⟨hs₀_raw, hs₁_raw⟩ := (hz_coords (2 * (r : ℤ))).mp hz_2r
  have hs₀_r : s₀ = 0 ∨ (r : ℤ) ≤ valL F L s₀ := by
    rcases hs₀_raw with rfl | h
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have hs₁_ra : s₁ = 0 ∨ (r : ℤ) + (a : ℤ) ≤ valL F L s₁ := by
    rcases hs₁_raw with rfl | h
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have hΔz_eq : Δ * z =
      ι (Δ₀ * s₀ + Δ₁ * s₁ * f) + ι (Δ₀ * s₁ + Δ₁ * (s₀ - s₁)) * x := by
    rw [hz_eq]
    dsimp [Δ]
    simp only [map_add, map_sub, map_mul]
    linear_combination ι Δ₁ * ι s₁ * hx_sq
  have htr_Δz : traceLM F hLM₁' (Δ * z) =
      Δ₀ * (2 * s₀ - s₁) + Δ₁ * (-s₀ + s₁ + 2 * f * s₁) := by
    rw [hΔz_eq, (hCoordTrNorm _ _).1]
    ring
  have hΔ₀_term : Δ₀ * (2 * s₀ - s₁) = 0 ∨ 2 * (r : ℤ) ≤ valL F L (Δ₀ * (2 * s₀ - s₁)) := by
    have h2s₀ : 2 * s₀ = 0 ∨ 2 * (r : ℤ) ≤ valL F L (2 * s₀) :=
      hvalL_2mul (2 * (r : ℤ)) (r : ℤ) s₀ hs₀_r (by omega)
    have h2s₀_s₁ : 2 * s₀ - s₁ = 0 ∨ (r : ℤ) + (a : ℤ) ≤ valL F L (2 * s₀ - s₁) :=
      hvalL_sub ((r : ℤ) + (a : ℤ)) (2 * (r : ℤ)) ((r : ℤ) + (a : ℤ)) (2 * s₀) s₁
        h2s₀ hs₁_ra (by omega) le_rfl
    exact hvalL_mul_or (2 * (r : ℤ)) ((r : ℤ) - (a : ℤ)) ((r : ℤ) + (a : ℤ))
      Δ₀ (2 * s₀ - s₁) hΔ₀_val h2s₀_s₁ (by omega)
  have hψ_Δ₀_term : ψ (((α⁻¹ : Lˣ) : L) * (Δ₀ * (2 * s₀ - s₁))) = 1 :=
    hψ_alpha_inv _ hΔ₀_term
  have hw_z_r : -s₀ + s₁ + 2 * f * s₁ = 0 ∨ (r : ℤ) ≤ valL F L (-s₀ + s₁ + 2 * f * s₁) := by
    have hns₀_s₁ : -s₀ + s₁ = 0 ∨ (r : ℤ) ≤ valL F L (-s₀ + s₁) :=
      hvalL_add (r : ℤ) (r : ℤ) ((r : ℤ) + (a : ℤ)) (-s₀) s₁
        (hvalL_neg_or (r : ℤ) s₀ hs₀_r) hs₁_ra le_rfl (by omega)
    have hfs₁ : f * s₁ = 0 ∨ 1 + (r : ℤ) - (a : ℤ) ≤ valL F L (f * s₁) :=
      hvalL_mul_or (1 + (r : ℤ) - (a : ℤ)) (1 - 2 * (a : ℤ)) ((r : ℤ) + (a : ℤ))
        f s₁ hf_or hs₁_ra (by omega)
    have h2fs₁ : 2 * f * s₁ = 0 ∨ (r : ℤ) ≤ valL F L (2 * f * s₁) := by
      have heq : 2 * f * s₁ = 2 * (f * s₁) := by ring
      rw [heq]
      exact hvalL_2mul (r : ℤ) (1 + (r : ℤ) - (a : ℤ)) (f * s₁) hfs₁ (by omega)
    exact hvalL_add (r : ℤ) (r : ℤ) (r : ℤ) (-s₀ + s₁) (2 * f * s₁) hns₀_s₁ h2fs₁ le_rfl le_rfl
  have hψ_Δ₁_term : ψ (((α⁻¹ : Lˣ) : L) * Δ₁ * (-s₀ + s₁ + 2 * f * s₁)) = 1 :=
    hΔ₁_vanish _ hw_z_r
  have hψM₁'_Δz : (traceChar F hLM₁' ψ) (ι ((α⁻¹ : Lˣ) : L) * (Δ * z)) = 1 := by
    rw [htraceChar_incl_mul, htr_Δz]
    have hsplit :
        ((α⁻¹ : Lˣ) : L) * (Δ₀ * (2 * s₀ - s₁) + Δ₁ * (-s₀ + s₁ + 2 * f * s₁)) =
          ((α⁻¹ : Lˣ) : L) * (Δ₀ * (2 * s₀ - s₁)) +
            ((α⁻¹ : Lˣ) : L) * Δ₁ * (-s₀ + s₁ + 2 * f * s₁) := by ring
    rw [hsplit, ψ.map_add_eq_mul, hψ_Δ₀_term, hψ_Δ₁_term, mul_one]
  have hα_mul_inv : ι ((α⁻¹ : Lˣ) : L) * ι (α : L) = 1 := by
    rw [← map_mul, Units.inv_mul, map_one]
  have hc_θ₁_z_decomp :
      ((c_θ₁⁻¹ : M₁'ˣ) : M₁') * z =
        ι ((α⁻¹ : Lˣ) : L) * N₁ * z + ι ((α⁻¹ : Lˣ) : L) * (Δ * z) := by
    linear_combination
      -(((c_θ₁⁻¹ : M₁'ˣ) : M₁') * z) * hα_mul_inv +
      (ι ((α⁻¹ : Lˣ) : L) * z) * hΔ_eq
  rw [hc_θ₁_stat z hz_val hz, hc_θ₁_z_decomp, AddChar.map_add_eq_mul, hψM₁'_Δz, mul_one]

theorem ld_ch12_wild_dyadic_even_breaks_min_cond_cE_and_pullback (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ)
    (χE' : relWeil F E' →* (Ω F)ˣ)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ)
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_even : condExp F L νE' % 2 = 0)
    (hm1_min : condExp F M₁' (recChar F rec M₁' χM₁') = 2 * condExp F L νE' - 1)
    (hm2_min : condExp F E' (recChar F rec E' χE') =
      condExp F L νM₁' + condExp F L νE' - 1)
    (hθE'_triv : ∀ u ∈ unitGroup F E' (condExp F E' (recChar F rec E' χE')),
      (recChar F rec E' χE') u = 1)
    (hnE' : condExpChar F E' (traceChar F hLE' ψ) =
      2 * condExpChar F L ψ + (condExp F L νE' : ℤ))
    (hnM₁' : condExpChar F M₁' (traceChar F hLM₁' ψ) =
      2 * condExpChar F L ψ + (condExp F L νM₁' : ℤ))
    (hCommonOrigin :
      ∀ (α : Lˣ) (C : K₁ˣ)
        (htE' : traceLM F hE'K₁ (C : K₁) ≠ 0)
        (htM₁' : traceLM F hM₁'K₁ (C : K₁) ≠ 0),
        let ψE' := traceChar F hLE' ψ
        let ψM₁' := traceChar F hLM₁' ψ
        let θE' := recChar F rec E' χE'
        let θM₁' := recChar F rec M₁' χM₁'
        let cE' : E'ˣ :=
          Units.map (IntermediateField.inclusion hLE').toMonoidHom α *
            (Units.map (normLM F hE'K₁) C)⁻¹
        let cνE' : Lˣ :=
          α * (Units.map (normLM F hLE') (Units.mk0 (traceLM F hE'K₁ (C : K₁)) htE'))⁻¹
        let cM₁' : M₁'ˣ :=
          Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α *
            (Units.map (normLM F hM₁'K₁) C)⁻¹
        let cνM₁' : Lˣ :=
          α * (Units.map (normLM F hLM₁') (Units.mk0 (traceLM F hM₁'K₁ (C : K₁)) htM₁'))⁻¹
        (θE' cE' : Ω F) * (νE' cνE' : Ω F) *
            ψE' (((cE'⁻¹ : E'ˣ) : E')) * ψ (((cνE'⁻¹ : Lˣ) : L)) =
          (θM₁' cM₁' : Ω F) * (νM₁' cνM₁' : Ω F) *
            ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁')) * ψ (((cνM₁'⁻¹ : Lˣ) : L)) ∧
        ∀ (C' : K₁ˣ)
          (htE'' : traceLM F hE'K₁ (C' : K₁) ≠ 0)
          (htM₁'' : traceLM F hM₁'K₁ (C' : K₁) ≠ 0),
          let uE' : E'ˣ := Units.map (normLM F hE'K₁) (C' * C⁻¹)
          let wE' : Lˣ :=
            Units.map (normLM F hLE')
              (Units.mk0 (traceLM F hE'K₁ (C' : K₁)) htE'' *
                (Units.mk0 (traceLM F hE'K₁ (C : K₁)) htE')⁻¹)
          let uM₁' : M₁'ˣ := Units.map (normLM F hM₁'K₁) (C' * C⁻¹)
          let wM₁' : Lˣ :=
            Units.map (normLM F hLM₁')
              (Units.mk0 (traceLM F hM₁'K₁ (C' : K₁)) htM₁'' *
                (Units.mk0 (traceLM F hM₁'K₁ (C : K₁)) htM₁')⁻¹)
          (θE' uE' : Ω F)⁻¹ * ψE' (((cE'⁻¹ : E'ˣ) : E') * ((uE' : E') - 1)) *
              (νE' wE' : Ω F)⁻¹ * ψ (((cνE'⁻¹ : Lˣ) : L) * ((wE' : L) - 1)) =
            (θM₁' uM₁' : Ω F)⁻¹ * ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * ((uM₁' : M₁') - 1)) *
              (νM₁' wM₁' : Ω F)⁻¹ * ψ (((cνM₁'⁻¹ : Lˣ) : L) * ((wM₁' : L) - 1)))
    (hSpecL : ∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1)
    (hSpecE' : ∀ y : E',
      (y = 0 ∨ -condExpChar F E' (traceChar F hLE' ψ) ≤ valL F E' y) →
        (traceChar F hLE' ψ) y = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
