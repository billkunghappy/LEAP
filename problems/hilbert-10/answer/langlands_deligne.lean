          rw [hV_def, hj₀_val, if_neg hnot_lt, if_neg hne]
    · have hV_l₁ : (∑ i ∈ Finset.Icc 1 (p - 1), ∑ j : Fin p, V i j l₁) = - s₀ := by
        rw [Finset.sum_eq_single (p - 1)]
        · rw [Finset.sum_eq_single j₀]
          · rw [hV_def, hs₀_def, hl₁_val, hj₀_val]
            have h0_lt : 0 < p - 1 := by omega
            have h1_eq : 1 = p - (p - 1) + 0 := by omega
            rw [if_pos h0_lt, if_pos h1_eq, hneg1_E, one_mul, neg_neg]
          · intro j _ hj_ne
            have hj_pos : 1 ≤ (j : ℕ) := by
              by_contra hlt; apply hj_ne; ext; change (j : ℕ) = 0; omega
            rw [hV_def, hl₁_val]
            split_ifs <;> first | rfl | contradiction | omega
          · intro h_abs; exact False.elim (h_abs (Finset.mem_univ j₀))
        · intro i hi hi_ne
          have hi_bounds : 1 ≤ i ∧ i ≤ p - 1 := Finset.mem_Icc.mp hi
          apply Finset.sum_eq_zero
          intro j _
          rw [hV_def, hl₁_val]
          split_ifs <;> first | rfl | contradiction | omega
        · intro h_abs; exact False.elim (h_abs hp1_mem)
      have hZ_l₁ : Z l₁ - (1 - s₀) = W_as l₁ + Y_R l₁ := by
        rw [hZ_def, if_pos rfl, hV_l₁]; ring
      rw [hZ_l₁]
      exact hvE_add _ _ _ (hW_as_val l₁) (hYR_pos l₁ (le_refl 1))
    · intro l hl_ge2
      rw [hZ_def]
      have hl_ne_l₁ : l ≠ l₁ := by
        intro h_eq; have : (l : ℕ) = 1 := congrArg Fin.val h_eq; omega
      rw [if_neg hl_ne_l₁, zero_add]
      have h_sub_nonneg : (0 : ℤ) ≤ ((p - (l : ℕ) : ℕ) : ℤ) * (t₁ : ℤ) :=
        mul_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)
      apply hvE_add
      · apply hvE_add
        · rcases hW_as_val l with h0 | hle
          · exact Or.inl h0
          · right; linarith only [hle, h_sub_nonneg]
        · rcases hYR_pos l (by omega) with h0 | hle
          · exact Or.inl h0
          · right; linarith only [hle, h_sub_nonneg]
      · apply hvE_sum
        intro i hi
        have hi_bounds : 1 ≤ i ∧ i ≤ p - 1 := Finset.mem_Icc.mp hi
        apply hvE_sum
        intro j _
        rw [hV_def]
        split_ifs with h1 h2 h3 h4
        · rcases hC_val i hi j with hC0 | hle
          · left; rw [hC0, mul_zero]
          · right
            rw [hvE_neg1_pow]
            have h_idx : (i : ℤ) - ((j : ℕ) : ℤ) = ((p - (l : ℕ) : ℕ) : ℤ) := by
              have := l.isLt
              omega
            nlinarith only [hle, h_idx]
        · left; rfl
        · omega
        · left; rfl
        · left; rfl
  exact h_abs (valL F E') (valL F M₁') (valL F K₁)
    (IntermediateField.inclusion hE'K₁) (IntermediateField.inclusion hM₁'K₁)
    (Module.finrank L (IntermediateField.extendScalars hLE')) bE' bM₁'
    hPrime hp_odd hbE'_ge2 hbM₁'_ge2 hb_le
    hvalE'_props.2.2.2.1 hvalE'_props.2.2.2.2.1 hvalE'_props.2.2.2.2.2.2.2.1
    hvalK₁_props.2.1 hvalK₁_props.2.2.2.1 hvalK₁_props.2.2.2.2.1 hvalK₁_props.2.2.2.2.2.2.2.1
    hval_E'K₁ (normLM F hE'K₁ (Δ : K₁)) (normLM F hM₁'K₁ (Δ : K₁)) (Δ : K₁) Δ.ne_zero
    hΔ_val ((hval_norm_E'K₁ (Δ : K₁)).trans hΔ_val)
    hΔ_basis hCoeffExtr e_Δ he_Δ_val he_Δ_cayley W_as hW_as_eq hW_as_val

theorem ld_wild_odd_top_edge_symm_poly_and_newton_val_bounds (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hE'K₁ : E' ≤ K₁) (hGalE'K₁ : IsGaloisExt F E' K₁)
    (hPrime : Nat.Prime (Module.finrank E' (IntermediateField.extendScalars hE'K₁)))
    (hp_odd : Module.finrank E' (IntermediateField.extendScalars hE'K₁) ≠ 2)
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁')
    (hp_valE' : ((Module.finrank E' (IntermediateField.extendScalars hE'K₁) : ℕ) : E') = 0 ∨
      1 ≤ valL F E' ((Module.finrank E' (IntermediateField.extendScalars hE'K₁) : ℕ) : E'))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank E' (IntermediateField.extendScalars hE'K₁) : ℤ) * valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (hSymm_E'K₁ :
      ∀ (G : Type u) [Group G] [Fintype G] (act : G → K₁ → K₁),
        Fintype.card G = Module.finrank E' (IntermediateField.extendScalars hE'K₁) →
        (∀ w : K₁, act 1 w = w) →
        (∀ (σ τ : G) (w : K₁), act (σ * τ) w = act σ (act τ w)) →
        (∀ σ : G,
          act σ 0 = 0 ∧ act σ 1 = 1 ∧
          (∀ w₁ w₂ : K₁,
            act σ (w₁ + w₂) = act σ w₁ + act σ w₂ ∧
            act σ (w₁ * w₂) = act σ w₁ * act σ w₂ ∧
            act σ (-w₁) = -act σ w₁)) →
        (∀ (σ : G) (y : E'),
          act σ (IntermediateField.inclusion hE'K₁ y) = IntermediateField.inclusion hE'K₁ y) →
        (∀ (σ : G) (w : K₁), valL F K₁ (act σ w) = valL F K₁ w) →
        (∀ w : K₁,
          IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ w) = ∑ σ : G, act σ w) →
        (∀ w : K₁,
          IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ w) = ∏ σ : G, act σ w) →
        let p := Module.finrank E' (IntermediateField.extendScalars hE'K₁)
        ∃ s : K₁ → ℕ → E',
          (∀ w : K₁, s w 1 = traceLM F hE'K₁ w) ∧
          (∀ w : K₁, 2 * s w 2 = (traceLM F hE'K₁ w) ^ 2 - traceLM F hE'K₁ (w ^ 2)) ∧
          (∀ w : K₁, w ≠ 0 → s w (p - 1) = normLM F hE'K₁ w * traceLM F hE'K₁ (w⁻¹)) ∧
          (∀ (w : K₁) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
            ∀ (q m : ℤ), (w = 0 ∨ q ≤ valL F K₁ w) →
              (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ) ≤ (r : ℤ) * q →
              (s w r = 0 ∨ m ≤ valL F E' (s w r))) ∧
          (∀ (w : K₁) (c : E'),
            normLM F hE'K₁ (1 + IntermediateField.inclusion hE'K₁ c * w) =
              1 + (∑ r ∈ Finset.Icc 1 (p - 1), c ^ r * s w r) +
                c ^ p * normLM F hE'K₁ w))
    (hCayley_E'K₁ :
      ∀ (G : Type u) [Group G] [Fintype G] (act : G → K₁ → K₁) (s : K₁ → ℕ → E'),
        Fintype.card G = Module.finrank E' (IntermediateField.extendScalars hE'K₁) →
        (∀ w : K₁, act 1 w = w) →
        (∀ σ : G,
          act σ 0 = 0 ∧ act σ 1 = 1 ∧
          (∀ w₁ w₂ : K₁,
            act σ (w₁ + w₂) = act σ w₁ + act σ w₂ ∧
            act σ (w₁ * w₂) = act σ w₁ * act σ w₂ ∧
            act σ (-w₁) = -act σ w₁)) →
        (∀ (σ : G) (y : E'),
          act σ (IntermediateField.inclusion hE'K₁ y) = IntermediateField.inclusion hE'K₁ y) →
        (∀ w : K₁,
          IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ w) = ∏ σ : G, act σ w) →
        (∀ (w : K₁) (c : E'),
          normLM F hE'K₁ (1 + IntermediateField.inclusion hE'K₁ c * w) =
            1 + (∑ r ∈ Finset.Icc 1 (Module.finrank E' (IntermediateField.extendScalars hE'K₁) - 1),
              c ^ r * s w r) +
              c ^ (Module.finrank E' (IntermediateField.extendScalars hE'K₁)) * normLM F hE'K₁ w) →
        let p := Module.finrank E' (IntermediateField.extendScalars hE'K₁)
        (∀ (w : K₁) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
          IntermediateField.inclusion hE'K₁ (s w r) =
            ∑ S ∈ ((Finset.univ : Finset G).powerset.filter (fun S => S.card = r)),
              ∏ σ ∈ S, act σ w) ∧
        (∀ w : K₁,
          w ^ p =
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ w) +
              ∑ i ∈ Finset.Icc 1 (p - 1),
                (-1 : K₁) ^ (i - 1) * IntermediateField.inclusion hE'K₁ (s w i) * w ^ (p - i)))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_tr_low_bE' : ∀ j ∈ Finset.Icc 1 (Module.finrank E' (IntermediateField.extendScalars hE'K₁) - 2),
      traceLM F hE'K₁ ((Δ : K₁) ^ j) = 0 ∨
        (bE' : ℤ) ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ j))) :
    let p := Module.finrank E' (IntermediateField.extendScalars hE'K₁)
    ∃ e'_Δ : ℕ → E',
      e'_Δ 1 = traceLM F hE'K₁ (Δ : K₁) ∧
      (∀ i ∈ Finset.Icc 1 (p - 2),
        e'_Δ i = 0 ∨ (bE' : ℤ) ≤ valL F E' (e'_Δ i)) ∧
      (e'_Δ (p - 1) = 0 ∨ 0 ≤ valL F E' (e'_Δ (p - 1))) ∧
      (∀ c : E',
        normLM F hE'K₁ (1 + IntermediateField.inclusion hE'K₁ c * (Δ : K₁)) =
          1 + (∑ i ∈ Finset.Icc 1 (p - 1), c ^ i * e'_Δ i) +
            c ^ p * normLM F hE'K₁ (Δ : K₁)) :=
by
  intro p
  have hp_pos : 1 ≤ p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  obtain ⟨hvalE'_0, hvalE'_1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv, _, hvalE'_add, _⟩ :=
    hvalE'_props

  
  have hmul_E' : ∀ (m₁ m₂ : ℤ) (x y : E'),
      (x = 0 ∨ m₁ ≤ valL F E' x) → (y = 0 ∨ m₂ ≤ valL F E' y) →
        (x * y = 0 ∨ m₁ + m₂ ≤ valL F E' (x * y)) := by
    intro m₁ m₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hvx : m₁ ≤ valL F E' x := hx.resolve_left hx0
        have hvy : m₂ ≤ valL F E' y := hy.resolve_left hy0
        rw [hvalE'_mul x y hx0 hy0]
        linarith
  have hsum_E' : ∀ {α : Type} (s : Finset α) (f : α → E') (k : ℤ),
      (∀ x ∈ s, f x = 0 ∨ k ≤ valL F E' (f x)) →
      ((∑ x ∈ s, f x) = 0 ∨ k ≤ valL F E' (∑ x ∈ s, f x)) := by
    intro α s f k hs
    induction s using Finset.induction_on with
    | empty => exact Or.inl Finset.sum_empty
    | @insert x s' hx ih =>
      rw [Finset.sum_insert hx]
      exact hvalE'_add k (f x) (∑ y ∈ s', f y)
        (hs x (Finset.mem_insert_self x s'))
        (ih (fun y hy => hs y (Finset.mem_insert_of_mem hy)))
  have hnat_E' : ∀ n : ℕ, (n : E') = 0 ∨ 0 ≤ valL F E' (n : E') := by
    intro n
    induction n with
    | zero => left; simp
    | succ m ih =>
      rw [Nat.cast_succ]
      exact hvalE'_add 0 (m : E') 1 ih (Or.inr (by rw [hvalE'_1]))
  have hint_E' : ∀ z : ℤ, (z : E') = 0 ∨ 0 ≤ valL F E' (z : E') := by
    intro z
    cases z with
    | ofNat n => simpa using hnat_E' n
    | negSucc n =>
      rw [Int.cast_negSucc]
      rcases hnat_E' (n + 1) with h0 | hge
      · left; exact neg_eq_zero.mpr h0
      · right; rw [hvalE'_neg]; exact hge

  
  let K₁' := IntermediateField.extendScalars hE'K₁
  have hFinE'K₁' : FiniteDimensional E' K₁' := by
    haveI : FiniteDimensional F K₁' := ‹FiniteDimensional F K₁›
    haveI : IsScalarTower F E' K₁' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact Module.Finite.of_restrictScalars_finite F E' K₁'
  haveI : FiniteDimensional E' K₁' := hFinE'K₁'
  have hGalE'K₁' : IsGalois E' ↥K₁' := by
    have hSepE'K₁' : Algebra.IsSeparable E' K₁' := hGalE'K₁.2.2.2 hE'K₁
    haveI : Algebra.IsSeparable E' K₁' := hSepE'K₁'
    have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
        [Normal k Ω_bar] (K₀ : IntermediateField k Ω_bar) [hSepK₀ : Algebra.IsSeparable k K₀],
        (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
        IsGalois k K₀ := by
      intro k Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
      let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
      haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
      haveI : Normal k N := IsGalois.to_normal
      have hK₀N : K₀ ≤ N := by
        intro z hz
        rw [mem_separableClosure_iff]
        let x : K₀ := ⟨z, hz⟩
        have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K₀ _ _ _ hSepK₀ x
        have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K₀.val K₀.val.injective x
        change (minpoly k z).Separable
        rw [hmin]
        exact hx
      let K_N : IntermediateField k N := K₀.comap N.val
      have hKN_map : K_N.map N.val = K₀ := by
        ext z
        refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
        rintro ⟨y, hy, rfl⟩
        exact hy
      have hKN_norm : K_N.fixingSubgroup.Normal := by
        refine ⟨fun h hh g => ?_⟩
        obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
        obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
        rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
        have hτ_fix : ∀ x ∈ K₀, τ x = x := by
          intro x hx
          let z : N := ⟨x, hK₀N hx⟩
          have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
          have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
          rwa [AlgEquiv.restrictNormalHom_apply] at h1
        intro y hy
        apply Subtype.ext
        rw [← map_inv, ← map_mul, ← map_mul]
        change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
        rw [AlgEquiv.restrictNormalHom_apply]
        exact h_norm_fix σ τ hτ_fix y.1 hy
      haveI : K_N.fixingSubgroup.Normal := hKN_norm
      haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
      let e_KN : ↥K_N ≃ₐ[k] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
      exact IsGalois.of_algEquiv e_KN
    haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
    haveI : Normal E' (AlgebraicClosure F) := Normal.tower_top_of_normal F E' (AlgebraicClosure F)
    have hK₁'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[E'] AlgebraicClosure F),
        (∀ x ∈ K₁', τ x = x) → ∀ x ∈ K₁', (σ * τ * σ⁻¹) x = x := by
      intro σ τ hτ
      let σ_F : E'.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv E').symm σ
      let τ_F : E'.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv E').symm τ
      have hτK₁ : τ_F.1 ∈ K₁.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hE'K₁).mpr hx)
      have hconjK₁ : (σ_F * τ_F * σ_F⁻¹).1 ∈ K₁.fixingSubgroup :=
        hGalE'K₁.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτK₁
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjK₁
      exact hconjK₁ x ((IntermediateField.mem_extendScalars hE'K₁).mp hx)
    exact helper_isGalois E' (AlgebraicClosure F) K₁' hK₁'_norm_fix
  haveI : IsGalois E' ↥K₁' := hGalE'K₁'
  let G : Type u := (K₁' ≃ₐ[E'] K₁')
  have hcard_G : Fintype.card G = p :=
    Fintype.card_eq_nat_card.trans (IsGalois.card_aut_eq_finrank E' K₁')
  let fromExtendScalars : K₁' →+* K₁ :=
    { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hE'K₁).mp z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let act : G → K₁ → K₁ := fun σ w => fromExtendScalars (σ (toExtendScalars F hE'K₁ w))
  have hact_one : ∀ w : K₁, act 1 w = w := fun _ => rfl
  have hact_mul : ∀ (σ τ : G) (w : K₁), act (σ * τ) w = act σ (act τ w) := fun _ _ _ => rfl
  have hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ w₁ w₂ : K₁,
        act σ (w₁ + w₂) = act σ w₁ + act σ w₂ ∧
        act σ (w₁ * w₂) = act σ w₁ * act σ w₂ ∧
        act σ (-w₁) = -act σ w₁) := by
    intro σ
    refine ⟨by simp [act], by simp [act], fun w₁ w₂ => ⟨by simp [act], by simp [act], by simp [act]⟩⟩
  have hact_incl : ∀ (σ : G) (y : E'),
      act σ (IntermediateField.inclusion hE'K₁ y) = IntermediateField.inclusion hE'K₁ y := by
    intro σ y
    change fromExtendScalars (σ (algebraMap E' K₁' y)) = IntermediateField.inclusion hE'K₁ y
    rw [σ.commutes y]
    rfl
  have hact_trace : ∀ w : K₁,
      IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ w) = ∑ σ : G, act σ w := by
    intro w
    have h1 := congrArg fromExtendScalars
      (trace_eq_sum_automorphisms (K := E') (L := K₁') (toExtendScalars F hE'K₁ w))
    exact h1.trans (map_sum fromExtendScalars (fun σ : G => σ (toExtendScalars F hE'K₁ w)) Finset.univ)
  have hact_norm : ∀ w : K₁,
      IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ w) = ∏ σ : G, act σ w := by
    intro w
    have h1 := congrArg fromExtendScalars
      (Algebra.norm_eq_prod_automorphisms E' (toExtendScalars F hE'K₁ w))
    exact h1.trans (map_prod fromExtendScalars (fun σ : G => σ (toExtendScalars F hE'K₁ w)) Finset.univ)
  let ι_E' := IntermediateField.inclusion hE'K₁
  have hι_E'_inj : Function.Injective ι_E' := (IntermediateField.inclusion hE'K₁).injective
  have hnorm_act : ∀ (σ : G) (w : K₁), normLM F hE'K₁ (act σ w) = normLM F hE'K₁ w := by
    intro σ w
    apply hι_E'_inj
    rw [hact_norm (act σ w), hact_norm w]
    have hmul : (∏ τ : G, act τ (act σ w)) = ∏ τ : G, act (τ * σ) w := by
      refine Finset.prod_congr rfl fun τ _ => ?_
      rw [hact_mul]
    rw [hmul]
    exact Equiv.prod_comp (Equiv.mulRight σ) (fun τ => act τ w)
  have hact_val : ∀ (σ : G) (w : K₁), valL F K₁ (act σ w) = valL F K₁ w := by
    intro σ w
    rw [← hval_norm_E'K₁ (act σ w), hnorm_act σ w, hval_norm_E'K₁ w]

  
  obtain ⟨s, hs_one, _, _, hs_val, hs_poly⟩ :=
    hSymm_E'K₁ G act hcard_G hact_one hact_mul hact_ring hact_incl hact_val hact_trace hact_norm
  obtain ⟨hs_incl, _⟩ :=
    hCayley_E'K₁ G act s hcard_G hact_one hact_ring hact_incl hact_norm hs_poly
  let e'_Δ : ℕ → E' := fun i => s (Δ : K₁) i
  have he'_Δ_1 : e'_Δ 1 = traceLM F hE'K₁ (Δ : K₁) := hs_one (Δ : K₁)
  have he'_Δ_poly : ∀ c : E',
      normLM F hE'K₁ (1 + IntermediateField.inclusion hE'K₁ c * (Δ : K₁)) =
        1 + (∑ i ∈ Finset.Icc 1 (p - 1), c ^ i * e'_Δ i) +
          c ^ p * normLM F hE'K₁ (Δ : K₁) := hs_poly (Δ : K₁)
  have he'_Δ_top : e'_Δ (p - 1) = 0 ∨ 0 ≤ valL F E' (e'_Δ (p - 1)) := by
    have hp1_mem : p - 1 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, le_rfl⟩
    apply hs_val (Δ : K₁) (p - 1) hp1_mem (-((bM₁' - 1 : ℕ) : ℤ)) 0
    · exact Or.inr (le_of_eq hΔ_val.symm)
    · have hbM₁'_sub : ((bM₁' - 1 : ℕ) : ℤ) = (bM₁' : ℤ) - 1 := Nat.cast_sub (by omega)
      have hp1_nonneg : (0 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) := by positivity
      have h_eq : ((p - 1 : ℕ) : ℤ) * -((bM₁' - 1 : ℕ) : ℤ) =
          -((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ) + ((p - 1 : ℕ) : ℤ) := by
        rw [hbM₁'_sub]
        ring
      rw [h_eq]
      linarith

  
  let φ_G : G → (K₁ →+* K₁) := fun σ =>
    { toFun := act σ
      map_one' := (hact_ring σ).2.1
      map_mul' := fun w₁ w₂ => ((hact_ring σ).2.2 w₁ w₂).2.1
      map_zero' := (hact_ring σ).1
      map_add' := fun w₁ w₂ => ((hact_ring σ).2.2 w₁ w₂).1 }
  have hact_pow : ∀ (σ : G) (m : ℕ), act σ ((Δ : K₁) ^ m) = (act σ (Δ : K₁)) ^ m :=
    fun σ m => map_pow (φ_G σ) (Δ : K₁) m
  let U_G : Finset G := Finset.univ
  let P_card : ℕ → Finset (Finset G) := fun r => U_G.powerset.filter (fun S => S.card = r)
  let P_Δ : Finset G → K₁ := fun S => ∏ σ ∈ S, act σ (Δ : K₁)
  let E_Δ : ℕ → K₁ := fun j => ∑ S ∈ P_card j, P_Δ S
  let T_pow : ℕ → K₁ := fun m => ∑ τ ∈ U_G, (act τ (Δ : K₁)) ^ m
  have hmem_P : ∀ (r : ℕ) (S : Finset G), S ∈ P_card r ↔ S.card = r := by
    intro r S; simp [P_card, U_G]
  have hT_pow_eq : ∀ m : ℕ, T_pow m = ι_E' (traceLM F hE'K₁ ((Δ : K₁) ^ m)) := by
    intro m
    dsimp only [T_pow, U_G, ι_E']
    rw [hact_trace ((Δ : K₁) ^ m)]
    refine Finset.sum_congr rfl fun τ _ => (hact_pow τ m).symm
  have hE_eq_e : ∀ {j : ℕ}, j ∈ Finset.Icc 1 (p - 1) → E_Δ j = ι_E' (e'_Δ j) := by
    intro j hj
    exact (hs_incl (Δ : K₁) j hj).symm
  let A_Δ : ℕ → ℕ → K₁ := fun j m =>
    ∑ τ ∈ U_G, ∑ S ∈ (P_card j).filter (fun S => τ ∈ S), P_Δ S * (act τ (Δ : K₁)) ^ m
  let B_Δ : ℕ → ℕ → K₁ := fun j m =>
    ∑ τ ∈ U_G, ∑ S ∈ (P_card j).filter (fun S => τ ∉ S), P_Δ S * (act τ (Δ : K₁)) ^ m
  have hET_split : ∀ j m : ℕ, E_Δ j * T_pow m = A_Δ j m + B_Δ j m := by
    intro j m
    dsimp only [E_Δ, T_pow, A_Δ, B_Δ]
    rw [Finset.sum_mul_sum, Finset.sum_comm, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun τ _ => ?_
    exact (Finset.sum_filter_add_sum_filter_not (P_card j) (fun S => τ ∈ S)
      (fun S => P_Δ S * (act τ (Δ : K₁)) ^ m)).symm
  have hBA : ∀ j m : ℕ, B_Δ j (m + 1) = A_Δ (j + 1) m := by
    intro j m
    dsimp only [B_Δ, A_Δ]
    refine Finset.sum_congr rfl fun τ _ => ?_
    refine Finset.sum_bij (fun S _ => insert τ S) ?_ ?_ ?_ ?_
    · intro S hS
      rw [Finset.mem_filter, hmem_P] at hS
      rw [Finset.mem_filter, hmem_P]
      exact ⟨by rw [Finset.card_insert_of_notMem hS.2, hS.1], Finset.mem_insert_self τ S⟩
    · intro S₁ hS₁ S₂ hS₂ heq
      dsimp only at heq
      rw [Finset.mem_filter] at hS₁ hS₂
      have h := congrArg (fun T : Finset G => T.erase τ) heq
      dsimp only at h
      rwa [Finset.erase_insert hS₁.2, Finset.erase_insert hS₂.2] at h
    · intro T hT
      rw [Finset.mem_filter, hmem_P] at hT
      refine ⟨T.erase τ, ?_, Finset.insert_erase hT.2⟩
      rw [Finset.mem_filter, hmem_P]
      refine ⟨?_, Finset.notMem_erase τ T⟩
      rw [Finset.card_erase_of_mem hT.2, hT.1]
      rfl
    · intro S hS
      rw [Finset.mem_filter] at hS
      have hP_ins : P_Δ (insert τ S) = act τ (Δ : K₁) * P_Δ S := Finset.prod_insert hS.2
      rw [hP_ins, pow_succ]
      ring
  have hP1_filter : ∀ τ : G, (P_card 1).filter (fun S => τ ∈ S) = {{τ}} := by
    intro τ
    ext S
    simp only [Finset.mem_filter, hmem_P, Finset.mem_singleton]
    constructor
    · rintro ⟨hcard1, hτ⟩
      obtain ⟨σ, rfl⟩ := Finset.card_eq_one.mp hcard1
      rw [Finset.mem_singleton.mp hτ]
    · rintro rfl
      exact ⟨Finset.card_singleton τ, Finset.mem_singleton_self τ⟩
  have hA_one : ∀ m : ℕ, A_Δ 1 m = T_pow (m + 1) := by
    intro m
    dsimp only [A_Δ, T_pow, P_Δ]
    refine Finset.sum_congr rfl fun τ _ => ?_
    rw [hP1_filter τ, Finset.sum_singleton, Finset.prod_singleton, pow_succ']
  have hA_zero : ∀ k : ℕ, A_Δ k 0 = (k : K₁) * E_Δ k := by
    intro k
    dsimp only [A_Δ, E_Δ]
    have h1 : (∑ τ ∈ U_G, ∑ S ∈ (P_card k).filter (fun S => τ ∈ S), P_Δ S * (act τ (Δ : K₁)) ^ 0) =
        ∑ τ ∈ U_G, ∑ S ∈ P_card k, if τ ∈ S then P_Δ S else 0 := by
      refine Finset.sum_congr rfl fun τ _ => ?_
      rw [Finset.sum_filter]
      refine Finset.sum_congr rfl fun S _ => ?_
      rw [pow_zero, mul_one]
    rw [h1, Finset.sum_comm, Finset.mul_sum]
    refine Finset.sum_congr rfl fun S hS => ?_
    rw [← Finset.sum_filter]
    have hU_S : U_G.filter (fun τ => τ ∈ S) = S := by ext τ; simp [U_G]
    rw [hU_S, Finset.sum_const, nsmul_eq_mul, (hmem_P k S).mp hS]
  have h_telescope : ∀ (f : ℕ → K₁) (n : ℕ),
      (∑ j ∈ Finset.Icc 1 n, (f j - f (j + 1))) = f 1 - f (n + 1) := by
    intro f n
    induction n with
    | zero => simp
    | succ m ih =>
      rw [Finset.sum_Icc_succ_top (Nat.le_add_left 1 m), ih]
      ring
  have hNewton_K₁ : ∀ {k : ℕ}, 1 ≤ k →
      (∑ j ∈ Finset.Icc 1 (k - 1), (-1 : K₁) ^ (j - 1) * E_Δ j * T_pow (k - j)) =
        T_pow k - (-1 : K₁) ^ (k - 1) * (k : K₁) * E_Δ k := by
    intro k hk
    let F_k : ℕ → K₁ := fun j => (-1 : K₁) ^ (j - 1) * A_Δ j (k - j)
    have hterm : ∀ j ∈ Finset.Icc 1 (k - 1),
        (-1 : K₁) ^ (j - 1) * E_Δ j * T_pow (k - j) = F_k j - F_k (j + 1) := by
      intro j hj
      obtain ⟨hj1, hjk⟩ := Finset.mem_Icc.mp hj
      have hk_sub : k - j = (k - (j + 1)) + 1 := by omega
      have hj_pow : (-1 : K₁) ^ ((j + 1) - 1) = (-1 : K₁) ^ (j - 1) * (-1 : K₁) := by
        have hj_eq : (j + 1) - 1 = (j - 1) + 1 := by omega
        rw [hj_eq, pow_succ]
      dsimp only [F_k]
      rw [mul_assoc, hET_split j (k - j), hk_sub, hBA j (k - (j + 1)), ← hk_sub, hj_pow]
      ring
    rw [Finset.sum_congr rfl hterm, h_telescope F_k (k - 1)]
    dsimp only [F_k]
    have hk1 : (k - 1) + 1 = k := Nat.sub_add_cancel hk
    rw [hk1, Nat.sub_self 1, pow_zero, one_mul, hA_one (k - 1), hk1, Nat.sub_self k, hA_zero k, mul_assoc]
  have hNewton_E' : ∀ {k : ℕ}, k ∈ Finset.Icc 1 (p - 1) →
      (-1 : E') ^ (k - 1) * ((k : ℕ) : E') * e'_Δ k =
        traceLM F hE'K₁ ((Δ : K₁) ^ k) -
          ∑ j ∈ Finset.Icc 1 (k - 1),
            (-1 : E') ^ (j - 1) * e'_Δ j * traceLM F hE'K₁ ((Δ : K₁) ^ (k - j)) := by
    intro k hk
    obtain ⟨hk1, _⟩ := Finset.mem_Icc.mp hk
    apply hι_E'_inj
    have hL : ι_E' ((-1 : E') ^ (k - 1) * ((k : ℕ) : E') * e'_Δ k) =
        (-1 : K₁) ^ (k - 1) * (k : K₁) * E_Δ k := by
      rw [map_mul, map_mul, map_pow, map_neg, map_one, map_natCast, ← hE_eq_e hk]
    have hR : ι_E' (traceLM F hE'K₁ ((Δ : K₁) ^ k) -
        ∑ j ∈ Finset.Icc 1 (k - 1),
          (-1 : E') ^ (j - 1) * e'_Δ j * traceLM F hE'K₁ ((Δ : K₁) ^ (k - j))) =
        T_pow k - ∑ j ∈ Finset.Icc 1 (k - 1), (-1 : K₁) ^ (j - 1) * E_Δ j * T_pow (k - j) := by
      rw [map_sub, ← hT_pow_eq k, map_sum]
      congr 1
      refine Finset.sum_congr rfl fun j hj => ?_
      obtain ⟨hj1, hjk1⟩ := Finset.mem_Icc.mp hj
      have hj_mem : j ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hj1, by omega⟩
      rw [map_mul, map_mul, map_pow, map_neg, map_one, ← hE_eq_e hj_mem, ← hT_pow_eq (k - j)]
    rw [hL, hR, hNewton_K₁ hk1]
    ring

  
  have hcoprime_val_E' : ∀ {k : ℕ}, k ∈ Finset.Icc 1 (p - 1) →
      ((k : ℕ) : E') ≠ 0 ∧ valL F E' ((k : ℕ) : E') = 0 := by
    intro k hk
    obtain ⟨hk1, hkp1⟩ := Finset.mem_Icc.mp hk
    have hnot_ge1 : ¬ (((k : ℕ) : E') = 0 ∨ 1 ≤ valL F E' ((k : ℕ) : E')) := by
      intro hk_bad
      have hndvd : ¬ (p ∣ k) := Nat.not_dvd_of_pos_of_lt hk1 (by omega)
      have hcop : Nat.Coprime p k := (Nat.Prime.coprime_iff_not_dvd hPrime).mpr hndvd
      have hgcd : Nat.gcd k p = 1 := Nat.Coprime.gcd_eq_one hcop.symm
      have hbez_int : (1 : ℤ) = (k : ℤ) * Nat.gcdA k p + (p : ℤ) * Nat.gcdB k p := by
        have h := Nat.gcd_eq_gcd_ab k p
        rw [hgcd] at h
        simpa using h
      have hbez_E' : (1 : E') =
          ((k : ℕ) : E') * (Nat.gcdA k p : E') + ((p : ℕ) : E') * (Nat.gcdB k p : E') := by
        have h := congrArg (Int.cast : ℤ → E') hbez_int
        push_cast at h
        exact h
      have hterm1 : ((k : ℕ) : E') * (Nat.gcdA k p : E') = 0 ∨
          1 ≤ valL F E' (((k : ℕ) : E') * (Nat.gcdA k p : E')) := by
        have h := hmul_E' 1 0 ((k : ℕ) : E') (Nat.gcdA k p : E') hk_bad (hint_E' (Nat.gcdA k p))
        rwa [add_zero] at h
      have hterm2 : ((p : ℕ) : E') * (Nat.gcdB k p : E') = 0 ∨
          1 ≤ valL F E' (((p : ℕ) : E') * (Nat.gcdB k p : E')) := by
        have h := hmul_E' 1 0 ((p : ℕ) : E') (Nat.gcdB k p : E') hp_valE' (hint_E' (Nat.gcdB k p))
        rwa [add_zero] at h
      have hsum := hvalE'_add 1 _ _ hterm1 hterm2
      rw [← hbez_E', hvalE'_1] at hsum
      rcases hsum with h10 | h1le0
      · exact one_ne_zero h10
      · omega
    rcases hnat_E' k with hk0 | hk_ge0
    · exact False.elim (hnot_ge1 (Or.inl hk0))
    · refine ⟨fun hk0 => hnot_ge1 (Or.inl hk0), ?_⟩
      have hk_lt1 : valL F E' ((k : ℕ) : E') < 1 := by
        by_contra hge1
        push_neg at hge1
        exact hnot_ge1 (Or.inr hge1)
      omega

  have hval_neg1_pow_E' : ∀ m : ℕ,
      (-1 : E') ^ m ≠ 0 ∧ valL F E' ((-1 : E') ^ m) = 0 := by
    intro m
    induction m with
    | zero =>
      rw [pow_zero]
      exact ⟨one_ne_zero, hvalE'_1⟩
    | succ m ih =>
      rw [pow_succ]
      have hneg1_ne0 : (-1 : E') ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hne : (-1 : E') ^ m * (-1 : E') ≠ 0 := mul_ne_zero ih.1 hneg1_ne0
      refine ⟨hne, ?_⟩
      rw [hvalE'_mul _ _ ih.1 hneg1_ne0, ih.2, hvalE'_neg1, add_zero]

  
  have he'_Δ_low : ∀ k ∈ Finset.Icc 1 (p - 2),
      e'_Δ k = 0 ∨ (bE' : ℤ) ≤ valL F E' (e'_Δ k) := by
    intro k hk
    induction' k using Nat.strong_induction_on with k ih
    obtain ⟨hk1, hkp2⟩ := Finset.mem_Icc.mp hk
    have hkp1_mem : k ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨hk1, by omega⟩
    have hsum_val :
        (∑ j ∈ Finset.Icc 1 (k - 1),
          (-1 : E') ^ (j - 1) * e'_Δ j * traceLM F hE'K₁ ((Δ : K₁) ^ (k - j))) = 0 ∨
        (bE' : ℤ) ≤ valL F E'
          (∑ j ∈ Finset.Icc 1 (k - 1),
            (-1 : E') ^ (j - 1) * e'_Δ j * traceLM F hE'K₁ ((Δ : K₁) ^ (k - j))) := by
      apply @hsum_E' ℕ (Finset.Icc 1 (k - 1))
        (fun j => (-1 : E') ^ (j - 1) * e'_Δ j * traceLM F hE'K₁ ((Δ : K₁) ^ (k - j))) (bE' : ℤ)
      intro j hj
      obtain ⟨hj1, hjk1⟩ := Finset.mem_Icc.mp hj
      have hj_lt : j < k := by omega
      have hj_mem : j ∈ Finset.Icc 1 (p - 2) := Finset.mem_Icc.mpr ⟨hj1, by omega⟩
      have hkj_mem : k - j ∈ Finset.Icc 1 (p - 2) := Finset.mem_Icc.mpr ⟨by omega, by omega⟩
      have hej := ih j hj_lt hj_mem
      have htr_kj := hΔ_tr_low_bE' (k - j) hkj_mem
      have hneg_j : (-1 : E') ^ (j - 1) = 0 ∨ 0 ≤ valL F E' ((-1 : E') ^ (j - 1)) :=
        Or.inr (by rw [(hval_neg1_pow_E' (j - 1)).2])
      have h1 := hmul_E' 0 (bE' : ℤ) ((-1 : E') ^ (j - 1)) (e'_Δ j) hneg_j hej
      have h2 := hmul_E' (0 + (bE' : ℤ)) (bE' : ℤ)
        ((-1 : E') ^ (j - 1) * e'_Δ j) (traceLM F hE'K₁ ((Δ : K₁) ^ (k - j)))
        h1 htr_kj
      rcases h2 with h0 | hge
      · exact Or.inl h0
      · right
        have hbE'_nonneg : (0 : ℤ) ≤ (bE' : ℤ) := by positivity
        linarith
    have hneg_sum_val :
        - (∑ j ∈ Finset.Icc 1 (k - 1),
            (-1 : E') ^ (j - 1) * e'_Δ j * traceLM F hE'K₁ ((Δ : K₁) ^ (k - j))) = 0 ∨
        (bE' : ℤ) ≤ valL F E'
          (- (∑ j ∈ Finset.Icc 1 (k - 1),
              (-1 : E') ^ (j - 1) * e'_Δ j * traceLM F hE'K₁ ((Δ : K₁) ^ (k - j)))) := by
      rcases hsum_val with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rw [hvalE'_neg]; exact hge
    have hrhs_val :
        (-1 : E') ^ (k - 1) * ((k : ℕ) : E') * e'_Δ k = 0 ∨
          (bE' : ℤ) ≤ valL F E' ((-1 : E') ^ (k - 1) * ((k : ℕ) : E') * e'_Δ k) := by
      rw [hNewton_E' hkp1_mem, sub_eq_add_neg]
      exact hvalE'_add (bE' : ℤ) _ _ (hΔ_tr_low_bE' k hk) hneg_sum_val
    obtain ⟨hneg_ne0, hneg_val0⟩ := hval_neg1_pow_E' (k - 1)
    obtain ⟨hk_ne0, hk_val0⟩ := hcoprime_val_E' hkp1_mem
    have hcoeff_ne0 : (-1 : E') ^ (k - 1) * ((k : ℕ) : E') ≠ 0 := mul_ne_zero hneg_ne0 hk_ne0
    have hcoeff_val0 : valL F E' ((-1 : E') ^ (k - 1) * ((k : ℕ) : E')) = 0 := by
      rw [hvalE'_mul _ _ hneg_ne0 hk_ne0, hneg_val0, hk_val0, add_zero]
    by_cases hek0 : e'_Δ k = 0
    · exact Or.inl hek0
    · right
      have hprod_ne0 : (-1 : E') ^ (k - 1) * ((k : ℕ) : E') * e'_Δ k ≠ 0 :=
        mul_ne_zero hcoeff_ne0 hek0
      have hge := hrhs_val.resolve_left hprod_ne0
      rw [hvalE'_mul _ _ hcoeff_ne0 hek0, hcoeff_val0, zero_add] at hge
      exact hge

  exact ⟨e'_Δ, he'_Δ_1, he'_Δ_low, he'_Δ_top, he'_Δ_poly⟩

theorem ld_wild_odd_weight_p_free_orbit_norm_poly_expansion (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M] (hLM : L ≤ M)
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (hvalM_props : valL F M 0 = 0 ∧ valL F M 1 = 0 ∧ valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
      (∀ u : Mˣ, u ∈ unitGroup F M 0 ↔ valL F M (u : M) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
