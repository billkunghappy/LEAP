      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun j _ => h_leg (γ j))
    have h_er :
        (p - 1) * (∑ j ∈ (Finset.range ℓ).erase 0, padicValNat p (j * h).factorial) +
          ∑ j ∈ (Finset.range ℓ).erase 0, (p.digits (j * h)).sum =
        ∑ j ∈ (Finset.range ℓ).erase 0, j * h := by
