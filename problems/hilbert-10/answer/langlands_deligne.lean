          (ξ_m ^ p - ξ_m = 0 ∨ ((4 * p * p * m₁ : ℕ) : ℤ) ≤ vK₁ (ξ_m ^ p - ξ_m)))
        (Δ_conj : ℕ → R_K)
        (hΔ_conj_tr : ∀ k : ℕ,
          let b := nmM₁'K₁ Δ_val
          iLM₁' (trLM₁' (b ^ k)) =
            b ^ k + ∑ m ∈ (Finset.range p).erase 0, (nmM₁'K₁ (Δ_conj m)) ^ k)
        (hΔ_conj_as : ∀ m < p, 0 < m →
          let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
          (Δ_conj m) ^ p - Δ_val ^ p - (Δ_conj m - Δ_val) = 0 ∨
            ((4 * p * p * m₁ : ℕ) : ℤ) ≤
              vK₁ ((Δ_conj m) ^ p - Δ_val ^ p - (Δ_conj m - Δ_val)))
        (hΔ_conj_approx : ∀ m < p, 0 < m →
          let ξ_m := iM₁'K₁ (iLM₁' (τ_val m))
          Δ_conj m - (Δ_val + ξ_m) = 0 ∨
            ((p * (p - 1) * (bE' - 1) - (p - 1) * (bM₁' - 1) : ℕ) : ℤ) ≤
              vK₁ (Δ_conj m - (Δ_val + ξ_m)))
        (u_fn : ℕ → R_K) (c_coeff : ℕ → ℤ)
        (hc_dvd : ∀ r < p - 2, (p : ℤ) ∣ c_coeff r)
        (hu_props : ∀ m < p, 0 < m →
          let ξ_m := iM₁'K₁ (iLM₁' (τ_val m))
          Δ_conj m = (Δ_val + ξ_m) * (1 + u_fn m) ∧
          (u_fn m = 0 ∨
            ((p * (p - 1) * (bE' - 1) - (p - 2) * (bM₁' - 1) : ℕ) : ℤ) ≤ vK₁ (u_fn m)) ∧
          (u_fn m - ∑ r ∈ Finset.range (p - 2),
              (c_coeff r : R_K) * ξ_m ^ (r + 1) * (Δ_val ^ (p - 2 - r)) = 0 ∨
            ((2 * p * (p - 1) * (bE' - 1) - (2 * p - 3) * (bM₁' - 1) : ℕ) : ℤ) ≤
              vK₁
                (u_fn m - ∑ r ∈ Finset.range (p - 2),
                  (c_coeff r : R_K) * ξ_m ^ (r + 1) * (Δ_val ^ (p - 2 - r)))))
        (hClaimA : ∀ D : ℕ,
          trM₁'K₁ (Δ_val ^ D) = 0 ∨
            ((p - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) - (D : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤
              vM₁' (trM₁'K₁ (Δ_val ^ D)))
        (hClaimB : ∀ D : ℕ, p ≤ D →
          trM₁'K₁ (Δ_val ^ D) = 0 ∨
            ((p - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) - (D : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) +
              ((p - 1 : ℕ) : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤
              vM₁' (trM₁'K₁ (Δ_val ^ D))),
        let t₁ := bM₁' - 1
        let t₂ := bE' - 1
        let b := nmM₁'K₁ Δ_val
        ∀ k ∈ Finset.Icc 2 (p - 1),
          let P_k := b ^ k +
            ∑ m ∈ (Finset.range p).erase 0,
              nmM₁'K₁ (Δ_val + iM₁'K₁ (iLM₁' (τ_val m))) ^ k
          iLM₁' (trLM₁' (b ^ k)) - P_k = 0 ∨
            2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 3 + k : ℕ) : ℤ) * (t₁ : ℤ) ≤
              vM₁' (iLM₁' (trLM₁' (b ^ k)) - P_k) := by
    clear * -
    intro R_L R_M R_K _ _ _
      iLM₁' iM₁'K₁ hiM₁'K₁
      vL vM₁' vK₁ trLM₁' trM₁'K₁ nmM₁'K₁
      p hPrime hp_odd bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le
      hp_valK₁
      hvalM₁'_1 hvalM₁'_neg hvalM₁'_mul hvalM₁'_add
      hvalK₁_1 hvalK₁_neg hvalK₁_mul hvalK₁_inv hvalK₁_add
      hval_LM₁' hval_M₁'K₁ hval_norm_M₁'K₁
      htr_M₁'K₁ htr_smul_M₁'K₁ hnorm_incl_M₁'K₁
      s₁ hs₁_1 hs₁_val hs₁_norm_one_add
      Δ_val hΔ_ne0 hΔ_val e_Δ he_Δ_val he_Δ_poly
      τ_val hτ_ne0 hτ_val0 hτ_pow_sum hξ_props
      Δ_conj hΔ_conj_tr hΔ_conj_as hΔ_conj_approx
      u_fn c_coeff hc_dvd hu_props
      hClaimA hClaimB
      t₁ t₂ b
    have ht₁_def : t₁ = bM₁' - 1 := rfl
    have ht₂_def : t₂ = bE' - 1 := rfl
    have hb_def : b = nmM₁'K₁ Δ_val := rfl

    have hp_pos : 0 < p := hPrime.pos
    have hp_pos_z : (0 : ℤ) < (p : ℤ) := Nat.cast_pos.mpr hp_pos
    have hp_ge2 : 2 ≤ p := hPrime.two_le
    have hp_ge3 : 3 ≤ p := by omega
    have ht₁_ge1 : 1 ≤ t₁ := by omega
    have ht₂_ge1 : 1 ≤ t₂ := by omega
    have ht_le : t₁ ≤ t₂ := by omega
    have ht_diff_nonneg : (0 : ℤ) ≤ (t₂ : ℤ) - (t₁ : ℤ) := by omega
    have hp_sub1_z : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
    have hp_sub2_z : ((p - 2 : ℕ) : ℤ) = (p : ℤ) - 2 := by omega
    have hp_sub3_z : ((p - 3 : ℕ) : ℤ) = (p : ℤ) - 3 := by omega

    
    have hvalM₁'_sub : ∀ (k : ℤ) (x y : R_M),
        (x = 0 ∨ k ≤ vM₁' x) → (y = 0 ∨ k ≤ vM₁' y) →
          (x - y = 0 ∨ k ≤ vM₁' (x - y)) := by
      intro k x y hx hy
      rw [sub_eq_add_neg]
      refine hvalM₁'_add k x (-y) hx ?_
      rcases hy with rfl | hy
      · exact Or.inl neg_zero
      · exact Or.inr (by rwa [hvalM₁'_neg])
    have hvalM₁'_mono : ∀ (k₁ k₂ : ℤ) (x : R_M),
        k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ vM₁' x) → (x = 0 ∨ k₁ ≤ vM₁' x) := by
      intro k₁ k₂ x hle hx
      rcases hx with rfl | hx
      · exact Or.inl rfl
      · exact Or.inr (le_trans hle hx)
    have hvalM₁'_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : R_M),
        (x = 0 ∨ k₁ ≤ vM₁' x) → (y = 0 ∨ k₂ ≤ vM₁' y) →
          (x * y = 0 ∨ k₁ + k₂ ≤ vM₁' (x * y)) := by
      intro k₁ k₂ x y hx hy
      by_cases hx0 : x = 0
      · left; rw [hx0, zero_mul]
      · by_cases hy0 : y = 0
        · left; rw [hy0, mul_zero]
        · right
          rw [hvalM₁'_mul x y hx0 hy0]
          exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
    have hvalM₁'_pow_ge : ∀ (x : R_M) (n : ℕ) (q : ℤ),
        (x = 0 ∨ q ≤ vM₁' x) → (x ^ n = 0 ∨ (n : ℤ) * q ≤ vM₁' (x ^ n)) := by
      intro x n q hx
      induction n with
      | zero =>
        right
        rw [pow_zero, hvalM₁'_1, Nat.cast_zero, zero_mul]
      | succ n ih =>
        rw [pow_succ]
        have hmul := hvalM₁'_mul_ge ((n : ℤ) * q) q (x ^ n) x ih hx
        have heq : ((n + 1 : ℕ) : ℤ) * q = (n : ℤ) * q + q := by push_cast; ring
        rwa [heq]
    have hvalM₁'_sum_ge : ∀ (S : Finset ℕ) (f : ℕ → R_M) (k : ℤ),
        (∀ i ∈ S, f i = 0 ∨ k ≤ vM₁' (f i)) →
          ((∑ i ∈ S, f i) = 0 ∨ k ≤ vM₁' (∑ i ∈ S, f i)) := by
      intro S f k hf
      induction' S using Finset.induction_on with i S hi ih
      · left; exact Finset.sum_empty
      · rw [Finset.sum_insert hi]
        exact hvalM₁'_add k (f i) (∑ j ∈ S, f j)
          (hf i (Finset.mem_insert_self i S))
          (ih (fun j hj => hf j (Finset.mem_insert_of_mem hj)))
    have hvalM₁'_natCast : ∀ n : ℕ, (n : R_M) = 0 ∨ (0 : ℤ) ≤ vM₁' (n : R_M) := by
      intro n
      induction n with
      | zero => left; exact Nat.cast_zero
      | succ n ih =>
        rw [Nat.cast_succ]
        exact hvalM₁'_add 0 (n : R_M) 1 ih (Or.inr (by rw [hvalM₁'_1]))
    have hvalM₁'_intCast : ∀ z : ℤ, (z : R_M) = 0 ∨ (0 : ℤ) ≤ vM₁' (z : R_M) := by
      intro z
      rcases Int.eq_nat_or_neg z with ⟨n, rfl | rfl⟩
      · rw [Int.cast_natCast]
        exact hvalM₁'_natCast n
      · rw [Int.cast_neg, Int.cast_natCast]
        rcases hvalM₁'_natCast n with hn0 | hn
        · left; rw [hn0, neg_zero]
        · right; rwa [hvalM₁'_neg]
    have hvalM₁'_strict : ∀ (x y : R_M),
        x ≠ 0 → (y = 0 ∨ vM₁' x + 1 ≤ vM₁' y) →
          x + y ≠ 0 ∧ vM₁' (x + y) = vM₁' x := by
      intro x y hx hy
      have hne : x + y ≠ 0 := by
        intro hsum
        have hy_eq : y = -x := eq_neg_of_add_eq_zero_right hsum
        rcases hy with hy0 | hy_val
        · exact hx (neg_eq_zero.mp (hy_eq.symm.trans hy0))
        · rw [hy_eq, hvalM₁'_neg] at hy_val
          omega
      refine ⟨hne, ?_⟩
      have hge : vM₁' x ≤ vM₁' (x + y) := by
        have hadd := hvalM₁'_add (vM₁' x) x y (Or.inr le_rfl)
          (hvalM₁'_mono (vM₁' x) (vM₁' x + 1) y (by omega) hy)
        exact hadd.resolve_left hne
      by_contra hlt
      have hgt : vM₁' x + 1 ≤ vM₁' (x + y) := by omega
      have hx_eq : x = (x + y) - y := by ring
      have hsub := hvalM₁'_sub (vM₁' x + 1) (x + y) y (Or.inr hgt) hy
      rw [← hx_eq] at hsub
      have hcontra : vM₁' x + 1 ≤ vM₁' x := hsub.resolve_left hx
      omega

    
    have hvalK₁_sub : ∀ (k : ℤ) (x y : R_K),
        (x = 0 ∨ k ≤ vK₁ x) → (y = 0 ∨ k ≤ vK₁ y) →
          (x - y = 0 ∨ k ≤ vK₁ (x - y)) := by
      intro k x y hx hy
      rw [sub_eq_add_neg]
      refine hvalK₁_add k x (-y) hx ?_
      rcases hy with rfl | hy
      · exact Or.inl neg_zero
      · exact Or.inr (by rwa [hvalK₁_neg])
    have hvalK₁_mono : ∀ (k₁ k₂ : ℤ) (x : R_K),
        k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ vK₁ x) → (x = 0 ∨ k₁ ≤ vK₁ x) := by
      intro k₁ k₂ x hle hx
      rcases hx with rfl | hx
      · exact Or.inl rfl
      · exact Or.inr (le_trans hle hx)
    have hvalK₁_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : R_K),
        (x = 0 ∨ k₁ ≤ vK₁ x) → (y = 0 ∨ k₂ ≤ vK₁ y) →
          (x * y = 0 ∨ k₁ + k₂ ≤ vK₁ (x * y)) := by
      intro k₁ k₂ x y hx hy
      by_cases hx0 : x = 0
      · left; rw [hx0, zero_mul]
      · by_cases hy0 : y = 0
        · left; rw [hy0, mul_zero]
        · right
          rw [hvalK₁_mul x y hx0 hy0]
          exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
    have hvalK₁_pow_ge : ∀ (x : R_K) (n : ℕ) (q : ℤ),
        (x = 0 ∨ q ≤ vK₁ x) → (x ^ n = 0 ∨ (n : ℤ) * q ≤ vK₁ (x ^ n)) := by
      intro x n q hx
      induction n with
      | zero =>
        right
        rw [pow_zero, hvalK₁_1, Nat.cast_zero, zero_mul]
      | succ n ih =>
        rw [pow_succ]
        have hmul := hvalK₁_mul_ge ((n : ℤ) * q) q (x ^ n) x ih hx
        have heq : ((n + 1 : ℕ) : ℤ) * q = (n : ℤ) * q + q := by push_cast; ring
        rwa [heq]
    have hvalK₁_strict : ∀ (x y : R_K),
        x ≠ 0 → (y = 0 ∨ vK₁ x + 1 ≤ vK₁ y) →
          x + y ≠ 0 ∧ vK₁ (x + y) = vK₁ x := by
      intro x y hx hy
      have hne : x + y ≠ 0 := by
        intro hsum
        have hy_eq : y = -x := eq_neg_of_add_eq_zero_right hsum
        rcases hy with hy0 | hy_val
        · exact hx (neg_eq_zero.mp (hy_eq.symm.trans hy0))
        · rw [hy_eq, hvalK₁_neg] at hy_val
          omega
      refine ⟨hne, ?_⟩
      have hge : vK₁ x ≤ vK₁ (x + y) := by
        have hadd := hvalK₁_add (vK₁ x) x y (Or.inr le_rfl)
          (hvalK₁_mono (vK₁ x) (vK₁ x + 1) y (by omega) hy)
        exact hadd.resolve_left hne
      by_contra hlt
      have hgt : vK₁ x + 1 ≤ vK₁ (x + y) := by omega
      have hx_eq : x = (x + y) - y := by ring
      have hsub := hvalK₁_sub (vK₁ x + 1) (x + y) y (Or.inr hgt) hy
      rw [← hx_eq] at hsub
      have hcontra : vK₁ x + 1 ≤ vK₁ x := hsub.resolve_left hx
      omega

    
    have hp_valM₁' : ((p : ℕ) : R_M) = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ vM₁' ((p : ℕ) : R_M) := by
      have hincl : iM₁'K₁ ((p : ℕ) : R_M) = ((p : ℕ) : R_K) := map_natCast iM₁'K₁ p
      rcases hp_valK₁ with hp0 | hp_ge
      · left
        exact (map_eq_zero_iff iM₁'K₁ hiM₁'K₁).mp (hincl.trans hp0)
      · right
        have hge' : (p : ℤ) * (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) ≤
            (p : ℤ) * vM₁' ((p : ℕ) : R_M) := by
          calc (p : ℤ) * (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ))
              = ((p * (p - 1) * t₂ : ℕ) : ℤ) := by push_cast; ring
            _ ≤ vK₁ ((p : ℕ) : R_K) := by rw [ht₂_def]; exact hp_ge
            _ = (p : ℤ) * vM₁' ((p : ℕ) : R_M) := by rw [← hincl, hval_M₁'K₁]
        exact le_of_mul_le_mul_left hge' hp_pos_z
    have hc_valM₁' : ∀ r < p - 2,
        (c_coeff r : R_M) = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ vM₁' (c_coeff r : R_M) := by
      intro r hr
      rcases hc_dvd r hr with ⟨q_r, hq_r⟩
      have hcast : (c_coeff r : R_M) = ((p : ℕ) : R_M) * (q_r : R_M) := by
        rw [hq_r, Int.cast_mul, Int.cast_natCast]
      rw [hcast]
      have hmul := hvalM₁'_mul_ge (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) 0
        ((p : ℕ) : R_M) (q_r : R_M) hp_valM₁' (hvalM₁'_intCast q_r)
      rwa [add_zero] at hmul

    have hnm_zero : nmM₁'K₁ 0 = 0 := by
      have h := hnorm_incl_M₁'K₁ 0
      rw [map_zero, zero_pow hPrime.ne_zero] at h
      exact h
    have hb_ne0 : b ≠ 0 := by
      rw [hb_def]
      intro hb0
      have h1 : nmM₁'K₁ (Δ_val * Δ_val⁻¹) = nmM₁'K₁ 1 := by
        rw [mul_inv_cancel₀ hΔ_ne0]
      rw [map_mul, map_one, hb0, zero_mul] at h1
      exact one_ne_zero h1.symm
    have hb_val : vM₁' b = -(t₁ : ℤ) := by
      rw [hb_def, hval_norm_M₁'K₁, hΔ_val, ← ht₁_def]

    
    let V_lin : ℤ := 2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ)
    have hV_lin_def : V_lin = 2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) := rfl
    let V₁ : ℤ := 2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 3 : ℕ) : ℤ) * (t₁ : ℤ)
    have hV₁_def : V₁ = 2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 3 : ℕ) : ℤ) * (t₁ : ℤ) := rfl
    clear_value V_lin V₁
    have hV₁_eq : V₁ = V_lin + (t₁ : ℤ) := by
      rw [hV₁_def, hV_lin_def, hp_sub2_z, hp_sub3_z]
      ring
    let T_lin : R_M :=
      if p = 3 then ((3 : ℕ) : R_M) * trM₁'K₁ Δ_val
      else (c_coeff 0 : R_M) * trM₁'K₁ (Δ_val ^ (p - 2))
    have hT_lin_def : T_lin =
        if p = 3 then ((3 : ℕ) : R_M) * trM₁'K₁ Δ_val
        else (c_coeff 0 : R_M) * trM₁'K₁ (Δ_val ^ (p - 2)) := rfl
    clear_value T_lin
    have hT_lin_val : T_lin = 0 ∨ V_lin ≤ vM₁' T_lin := by
      rw [hT_lin_def]
      by_cases hp3 : p = 3
      · rw [if_pos hp3]
        have hp3_val : ((3 : ℕ) : R_M) = 0 ∨
            ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ vM₁' ((3 : ℕ) : R_M) := by
          rw [← hp3]
          exact hp_valM₁'
        have htr1 := hClaimA 1
        rw [pow_one, ← ht₂_def, ← ht₁_def] at htr1
        have hmul := hvalM₁'_mul_ge (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ))
          (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (1 : ℤ) * (t₁ : ℤ))
          ((3 : ℕ) : R_M) (trM₁'K₁ Δ_val) hp3_val htr1
        refine hvalM₁'_mono V_lin _ _ ?_ hmul
        have hp2_3 : ((p - 2 : ℕ) : ℤ) = 1 := by omega
        rw [hV_lin_def, hp2_3]
        linarith only
      · rw [if_neg hp3]
        have hp_ge5 : 5 ≤ p := by
          by_contra hlt
          have hp4 : p ≠ 4 := by
            rintro rfl
            exact (by decide : ¬ Nat.Prime 4) hPrime
          omega
        have hc0 := hc_valM₁' 0 (by omega)
        have htr_p2 := hClaimA (p - 2)
        rw [← ht₂_def, ← ht₁_def] at htr_p2
        have hmul := hvalM₁'_mul_ge (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ))
          (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ))
          (c_coeff 0 : R_M) (trM₁'K₁ (Δ_val ^ (p - 2))) hc0 htr_p2
        refine hvalM₁'_mono V_lin _ _ ?_ hmul
        linarith only [hV_lin_def]

    
    let T₁ : ℕ := (bM₁' - 1) + p * (bE' - bM₁') + 1
    have hT₁_def : T₁ = (bM₁' - 1) + p * (bE' - bM₁') + 1 := rfl
    have hT₁_z : (T₁ : ℤ) = (t₁ : ℤ) + (p : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) + 1 := by
      have hsub : ((bE' - bM₁' : ℕ) : ℤ) = (t₂ : ℤ) - (t₁ : ℤ) := by
        rw [ht₁_def, ht₂_def]
        omega
      rw [hT₁_def, ← ht₁_def]
      push_cast
      rw [hsub]
    let m₁ : ℕ := 2 * bM₁' - 1 + p * (bE' - bM₁')
    have hm₁_def : m₁ = 2 * bM₁' - 1 + p * (bE' - bM₁') := rfl
    have hm₁_ge_t₂ : (t₂ : ℤ) ≤ (m₁ : ℤ) := by
      rw [ht₂_def, hm₁_def]
      have h : bE' - 1 ≤ 2 * bM₁' - 1 + p * (bE' - bM₁') := by
        have h1 : 1 * (bE' - bM₁') ≤ p * (bE' - bM₁') :=
          Nat.mul_le_mul_right (bE' - bM₁') (by omega : 1 ≤ p)
        omega
      exact_mod_cast h
    let B₀ : ℤ := ((p * (p - 1) * (bE' - 1) - (p - 1) * (bM₁' - 1) : ℕ) : ℤ)
    have hB₀_def : B₀ = ((p * (p - 1) * (bE' - 1) - (p - 1) * (bM₁' - 1) : ℕ) : ℤ) := rfl
    have hB₀_sub_le : (p - 1) * t₁ ≤ p * (p - 1) * t₂ := by
      calc (p - 1) * t₁ = 1 * ((p - 1) * t₁) := (one_mul _).symm
        _ ≤ p * ((p - 1) * t₁) := Nat.mul_le_mul_right _ (by omega : 1 ≤ p)
        _ = (p * (p - 1)) * t₁ := (mul_assoc _ _ _).symm
        _ ≤ (p * (p - 1)) * t₂ := Nat.mul_le_mul_left _ ht_le
    have hB₀_eq : B₀ = (p : ℤ) * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) := by
      rw [hB₀_def, ← ht₂_def, ← ht₁_def, Nat.cast_sub hB₀_sub_le]
      push_cast
      ring
    have hB₀_nonneg : 0 ≤ B₀ := Nat.cast_nonneg _
    let q_u : ℤ := ((p * (p - 1) * (bE' - 1) - (p - 2) * (bM₁' - 1) : ℕ) : ℤ)
    have hq_u_def : q_u = ((p * (p - 1) * (bE' - 1) - (p - 2) * (bM₁' - 1) : ℕ) : ℤ) := rfl
    have hq_u_sub_le : (p - 2) * t₁ ≤ p * (p - 1) * t₂ := by
      calc (p - 2) * t₁ ≤ (p - 1) * t₁ := Nat.mul_le_mul_right t₁ (by omega)
        _ ≤ p * (p - 1) * t₂ := hB₀_sub_le
    have hq_u_eq : q_u = B₀ + (t₁ : ℤ) := by
      rw [hq_u_def, ← ht₂_def, ← ht₁_def, Nat.cast_sub hq_u_sub_le, hB₀_eq]
      push_cast
      rw [hp_sub1_z, hp_sub2_z]
      ring
    have hq_u_nonneg : 0 ≤ q_u := Nat.cast_nonneg _
    clear_value t₁ t₂ b T₁ m₁ B₀ q_u

    
    let ξ_base : ℕ → R_M := fun m => iLM₁' (τ_val m)
    let ξ_fn : ℕ → R_K := fun m => iM₁'K₁ (ξ_base m)
    let ν_fn : ℕ → R_M := fun m => nmM₁'K₁ (1 + u_fn m) - 1

    have hξ_base_val0 : ∀ m < p, 0 < m → ξ_base m ≠ 0 ∧ vM₁' (ξ_base m) = 0 := by
      intro m hm_lt hm_pos
      refine ⟨?_, ?_⟩
      · intro h0
        have h1 : iM₁'K₁ (ξ_base m) = 0 := by rw [h0, map_zero]
        exact (map_ne_zero_iff (iM₁'K₁.comp iLM₁') (hiM₁'K₁.comp iLM₁'.injective)).mpr
          (hτ_ne0 m) h1
      · rw [hval_LM₁', hτ_val0 m hm_lt hm_pos, mul_zero]

    have herase_Icc_bot : (Finset.Icc 1 (p - 1)).erase 1 = Finset.Icc 2 (p - 1) := by
      ext r
      simp only [Finset.mem_erase, Finset.mem_Icc]
      omega

    have hν_sub_tr : ∀ m < p, 0 < m →
        ν_fn m - trM₁'K₁ (u_fn m) = 0 ∨ V₁ ≤ vM₁' (ν_fn m - trM₁'K₁ (u_fn m)) := by
      intro m hm_lt hm_pos
      have h1_mem : 1 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩
      have hsplit :
          ν_fn m - trM₁'K₁ (u_fn m) =
            (∑ r ∈ Finset.Icc 2 (p - 1), s₁ (u_fn m) r) + nmM₁'K₁ (u_fn m) := by
        dsimp only [ν_fn]
        rw [hs₁_norm_one_add (u_fn m),
          ← Finset.add_sum_erase (Finset.Icc 1 (p - 1)) (fun r => s₁ (u_fn m) r) h1_mem,
          herase_Icc_bot, hs₁_1 (u_fn m)]
        ring
      rw [hsplit]
      have hu_val : u_fn m = 0 ∨ q_u ≤ vK₁ (u_fn m) := by
        rw [hq_u_def]
        exact (hu_props m hm_lt hm_pos).2.1
      have hsum_s1 :
          (∑ r ∈ Finset.Icc 2 (p - 1), s₁ (u_fn m) r) = 0 ∨
            V₁ ≤ vM₁' (∑ r ∈ Finset.Icc 2 (p - 1), s₁ (u_fn m) r) := by
        apply hvalM₁'_sum_ge (Finset.Icc 2 (p - 1)) _ V₁
        intro r hr
        obtain ⟨hr2, hr_p1⟩ := Finset.mem_Icc.mp hr
        have hr_Icc : r ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, hr_p1⟩
        apply hs₁_val (u_fn m) r hr_Icc q_u V₁ hu_val
        rw [← hT₁_def]
        have hr_ge2 : (2 : ℤ) ≤ (r : ℤ) := by omega
        have h2qu_le : 2 * q_u ≤ (r : ℤ) * q_u := mul_le_mul_of_nonneg_right hr_ge2 hq_u_nonneg
        have hineq : (p : ℤ) * V₁ - ((p - 1 : ℕ) : ℤ) * (T₁ : ℤ) ≤ 2 * q_u := by
          have hdiff :
              2 * q_u - ((p : ℤ) * V₁ - ((p - 1 : ℕ) : ℤ) * (T₁ : ℤ)) =
                (p : ℤ) * ((p - 1 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) +
                  ((p - 1 : ℕ) : ℤ) * ((p - 3 : ℕ) : ℤ) * (t₁ : ℤ) + ((p - 1 : ℕ) : ℤ) := by
            rw [hV₁_def, hq_u_eq, hB₀_eq, hT₁_z, hp_sub1_z, hp_sub3_z]
            ring
          have hnonneg :
              0 ≤ (p : ℤ) * ((p - 1 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) +
                ((p - 1 : ℕ) : ℤ) * ((p - 3 : ℕ) : ℤ) * (t₁ : ℤ) + ((p - 1 : ℕ) : ℤ) := by
            positivity
          linarith only [hdiff, hnonneg]
        exact le_trans hineq h2qu_le
      have hnm_u : nmM₁'K₁ (u_fn m) = 0 ∨ V₁ ≤ vM₁' (nmM₁'K₁ (u_fn m)) := by
        rcases hu_val with hu0 | hu_ge
        · left; rw [hu0, hnm_zero]
        · right
          rw [hval_norm_M₁'K₁]
          have hqu_ge_V1 : V₁ ≤ q_u := by
            have hdiff :
                q_u - V₁ =
                  ((p - 1 : ℕ) : ℤ) * ((p - 2 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) +
                    ((p - 3 : ℕ) : ℤ) * ((p : ℤ) * (t₁ : ℤ)) + (t₁ : ℤ) := by
              rw [hV₁_def, hq_u_eq, hB₀_eq, hp_sub1_z, hp_sub2_z, hp_sub3_z]
              ring
            have hnonneg :
                0 ≤ ((p - 1 : ℕ) : ℤ) * ((p - 2 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) +
                  ((p - 3 : ℕ) : ℤ) * ((p : ℤ) * (t₁ : ℤ)) + (t₁ : ℤ) := by
              positivity
            linarith only [hdiff, hnonneg]
          exact le_trans hqu_ge_V1 hu_ge
      exact hvalM₁'_add V₁ _ _ hsum_s1 hnm_u

    have htr_u_approx : ∀ m < p, 0 < m →
        trM₁'K₁ (u_fn m) - T_lin * ξ_base m = 0 ∨
          V₁ ≤ vM₁' (trM₁'K₁ (u_fn m) - T_lin * ξ_base m) := by
      intro m hm_lt hm_pos
      have hξ_b0 := (hξ_base_val0 m hm_lt hm_pos).2
      have hξ_k0 : vK₁ (ξ_fn m) = 0 := (hξ_props m hm_lt hm_pos).1
      by_cases hp3 : p = 3
      · 
        let w_m : R_K := Δ_val + ξ_fn m
        let η_m : R_K := Δ_conj m - w_m
        let Q₃_m : R_K := ((3 : ℕ) : R_K) * ξ_fn m * Δ_val
        have hw_strict : w_m ≠ 0 ∧ vK₁ w_m = -(t₁ : ℤ) := by
          have h := hvalK₁_strict Δ_val (ξ_fn m) hΔ_ne0
            (Or.inr (by rw [hΔ_val, ← ht₁_def, hξ_k0]; omega))
          rwa [hΔ_val, ← ht₁_def] at h
        let w_inv : R_K := w_m⁻¹
        have hw_mul_inv : w_m * w_inv = 1 := mul_inv_cancel₀ hw_strict.1
        have hw_inv_val : vK₁ w_inv = (t₁ : ℤ) := by
          dsimp only [w_inv]
          rw [hvalK₁_inv w_m hw_strict.1, hw_strict.2, neg_neg]
        have hη_eq : η_m = w_m * u_fn m := by
          have h1 := (hu_props m hm_lt hm_pos).1
          change Δ_conj m - w_m = w_m * u_fn m
          linear_combination h1
        have hu_eq_η : u_fn m = η_m * w_inv := by
          rw [hη_eq, mul_right_comm, hw_mul_inv, one_mul]
        let E_ξ : R_K := (ξ_fn m) ^ 3 - ξ_fn m
        let E_Δ : R_K := (Δ_conj m) ^ 3 - Δ_val ^ 3 - (Δ_conj m - Δ_val)
        have hB₀_3 : B₀ = 6 * (t₂ : ℤ) - 2 * (t₁ : ℤ) := by
          rw [hB₀_eq, hp3]
          norm_num
        have h3B₀_le_as : 3 * B₀ ≤ ((4 * p * p * m₁ : ℕ) : ℤ) := by
          rw [hp3, hB₀_3]
          push_cast
          have ht₁_nn : (0 : ℤ) ≤ (t₁ : ℤ) := by positivity
          linarith only [hm₁_ge_t₂, ht₁_nn]
        have hE_ξ_val : E_ξ = 0 ∨ 3 * B₀ ≤ vK₁ E_ξ := by
          have h : (ξ_fn m) ^ p - ξ_fn m = 0 ∨
              ((4 * p * p * (2 * bM₁' - 1 + p * (bE' - bM₁')) : ℕ) : ℤ) ≤
                vK₁ ((ξ_fn m) ^ p - ξ_fn m) :=
            (hξ_props m hm_lt hm_pos).2
          rw [← hm₁_def] at h
          have h' : E_ξ = 0 ∨ ((4 * p * p * m₁ : ℕ) : ℤ) ≤ vK₁ E_ξ := by
            dsimp only [E_ξ]
            rwa [← hp3]
          exact hvalK₁_mono (3 * B₀) _ E_ξ h3B₀_le_as h'
        have hE_Δ_val : E_Δ = 0 ∨ 3 * B₀ ≤ vK₁ E_Δ := by
          have h : (Δ_conj m) ^ p - Δ_val ^ p - (Δ_conj m - Δ_val) = 0 ∨
              ((4 * p * p * (2 * bM₁' - 1 + p * (bE' - bM₁')) : ℕ) : ℤ) ≤
                vK₁ ((Δ_conj m) ^ p - Δ_val ^ p - (Δ_conj m - Δ_val)) :=
            hΔ_conj_as m hm_lt hm_pos
          rw [← hm₁_def] at h
          have h' : E_Δ = 0 ∨ ((4 * p * p * m₁ : ℕ) : ℤ) ≤ vK₁ E_Δ := by
            dsimp only [E_Δ]
            rwa [← hp3]
          exact hvalK₁_mono (3 * B₀) _ E_Δ h3B₀_le_as h'
        have hη_val : η_m = 0 ∨ B₀ ≤ vK₁ η_m := by
          rw [hB₀_def]
          exact hΔ_conj_approx m hm_lt hm_pos
        have h3K_val : ((3 : ℕ) : R_K) = 0 ∨ 6 * (t₂ : ℤ) ≤ vK₁ ((3 : ℕ) : R_K) := by
          have h := hp_valK₁
          rw [hp3, ← ht₂_def] at h
          refine hvalK₁_mono (6 * (t₂ : ℤ)) _ ((3 : ℕ) : R_K) ?_ h
          push_cast
          linarith only
        have hη3_val : η_m ^ 3 = 0 ∨ 3 * B₀ ≤ vK₁ (η_m ^ 3) := by
          have h := hvalK₁_pow_ge η_m 3 B₀ hη_val
          exact hvalK₁_mono (3 * B₀) (((3 : ℕ) : ℤ) * B₀) (η_m ^ 3) (by push_cast; linarith only) h
        have h3η2w_val :
            ((3 : ℕ) : R_K) * η_m ^ 2 * w_m = 0 ∨
              3 * B₀ ≤ vK₁ (((3 : ℕ) : R_K) * η_m ^ 2 * w_m) := by
          have hη2 := hvalK₁_pow_ge η_m 2 B₀ hη_val
          have hw_ge : w_m = 0 ∨ -(t₁ : ℤ) ≤ vK₁ w_m := Or.inr (le_of_eq hw_strict.2.symm)
          have hm1 := hvalK₁_mul_ge (6 * (t₂ : ℤ)) (((2 : ℕ) : ℤ) * B₀)
            ((3 : ℕ) : R_K) (η_m ^ 2) h3K_val hη2
          have hm2 := hvalK₁_mul_ge (6 * (t₂ : ℤ) + ((2 : ℕ) : ℤ) * B₀) (-(t₁ : ℤ))
            (((3 : ℕ) : R_K) * η_m ^ 2) w_m hm1 hw_ge
          refine hvalK₁_mono (3 * B₀) _ _ ?_ hm2
          push_cast
          have ht₁_nn : (0 : ℤ) ≤ (t₁ : ℤ) := by positivity
          linarith only [hB₀_3, ht₁_nn]
        have h_id1 :
            η_m - w_m * Q₃_m =
              E_ξ - E_Δ + η_m ^ 3 +
                ((3 : ℕ) : R_K) * η_m * w_m ^ 2 +
                ((3 : ℕ) : R_K) * η_m ^ 2 * w_m := by
          dsimp only [η_m, w_m, Q₃_m, E_ξ, E_Δ]
          ring
        have hrem1 : η_m - w_m * Q₃_m = 0 ∨ 2 * B₀ ≤ vK₁ (η_m - w_m * Q₃_m) := by
          rw [h_id1]
          have hw2 := hvalK₁_pow_ge w_m 2 (-(t₁ : ℤ)) (Or.inr (le_of_eq hw_strict.2.symm))
          have hm1 := hvalK₁_mul_ge (6 * (t₂ : ℤ)) B₀ ((3 : ℕ) : R_K) η_m h3K_val hη_val
          have hm2 := hvalK₁_mul_ge (6 * (t₂ : ℤ) + B₀) (((2 : ℕ) : ℤ) * (-(t₁ : ℤ)))
            (((3 : ℕ) : R_K) * η_m) (w_m ^ 2) hm1 hw2
          have hterm4 : ((3 : ℕ) : R_K) * η_m * w_m ^ 2 = 0 ∨
              2 * B₀ ≤ vK₁ (((3 : ℕ) : R_K) * η_m * w_m ^ 2) := by
            refine hvalK₁_mono (2 * B₀) _ _ ?_ hm2
            push_cast
            linarith only [hB₀_3]
          have h2le3 : 2 * B₀ ≤ 3 * B₀ := by linarith only [hB₀_nonneg]
          have hp12 := hvalK₁_sub (2 * B₀) E_ξ E_Δ
            (hvalK₁_mono (2 * B₀) (3 * B₀) E_ξ h2le3 hE_ξ_val)
            (hvalK₁_mono (2 * B₀) (3 * B₀) E_Δ h2le3 hE_Δ_val)
          have hp123 := hvalK₁_add (2 * B₀) _ _ hp12
            (hvalK₁_mono (2 * B₀) (3 * B₀) (η_m ^ 3) h2le3 hη3_val)
          have hp1234 := hvalK₁_add (2 * B₀) _ _ hp123 hterm4
          exact hvalK₁_add (2 * B₀) _ _ hp1234
            (hvalK₁_mono (2 * B₀) (3 * B₀) _ h2le3 h3η2w_val)
        have h_id2 :
            (η_m - w_m * Q₃_m) - ((3 : ℕ) : R_K) * w_m ^ 3 * Q₃_m =
              E_ξ - E_Δ + η_m ^ 3 +
                ((3 : ℕ) : R_K) * (η_m - w_m * Q₃_m) * w_m ^ 2 +
                ((3 : ℕ) : R_K) * η_m ^ 2 * w_m := by
          dsimp only [η_m, w_m, Q₃_m, E_ξ, E_Δ]
          ring
        have hrem2 :
            (η_m - w_m * Q₃_m) - ((3 : ℕ) : R_K) * w_m ^ 3 * Q₃_m = 0 ∨
              3 * B₀ ≤ vK₁ ((η_m - w_m * Q₃_m) - ((3 : ℕ) : R_K) * w_m ^ 3 * Q₃_m) := by
          rw [h_id2]
          have hw2 := hvalK₁_pow_ge w_m 2 (-(t₁ : ℤ)) (Or.inr (le_of_eq hw_strict.2.symm))
          have hm1 := hvalK₁_mul_ge (6 * (t₂ : ℤ)) (2 * B₀)
            ((3 : ℕ) : R_K) (η_m - w_m * Q₃_m) h3K_val hrem1
          have hm2 := hvalK₁_mul_ge (6 * (t₂ : ℤ) + 2 * B₀) (((2 : ℕ) : ℤ) * (-(t₁ : ℤ)))
            (((3 : ℕ) : R_K) * (η_m - w_m * Q₃_m)) (w_m ^ 2) hm1 hw2
          have hterm4 :
              ((3 : ℕ) : R_K) * (η_m - w_m * Q₃_m) * w_m ^ 2 = 0 ∨
                3 * B₀ ≤ vK₁ (((3 : ℕ) : R_K) * (η_m - w_m * Q₃_m) * w_m ^ 2) := by
            refine hvalK₁_mono (3 * B₀) _ _ ?_ hm2
            push_cast
            linarith only [hB₀_3]
          have hp12 := hvalK₁_sub (3 * B₀) E_ξ E_Δ hE_ξ_val hE_Δ_val
          have hp123 := hvalK₁_add (3 * B₀) _ _ hp12 hη3_val
          have hp1234 := hvalK₁_add (3 * B₀) _ _ hp123 hterm4
          exact hvalK₁_add (3 * B₀) _ _ hp1234 h3η2w_val
        have hu_rem2_eq :
            (u_fn m - Q₃_m) - ((3 : ℕ) : R_K) * w_m ^ 2 * Q₃_m =
              ((η_m - w_m * Q₃_m) - ((3 : ℕ) : R_K) * w_m ^ 3 * Q₃_m) * w_inv := by
          linear_combination hu_eq_η + (Q₃_m + ((3 : ℕ) : R_K) * w_m ^ 2 * Q₃_m) * hw_mul_inv
        have hu_rem2_val :
            (u_fn m - Q₃_m) - ((3 : ℕ) : R_K) * w_m ^ 2 * Q₃_m = 0 ∨
              3 * B₀ + (t₁ : ℤ) ≤ vK₁ ((u_fn m - Q₃_m) - ((3 : ℕ) : R_K) * w_m ^ 2 * Q₃_m) := by
          rw [hu_rem2_eq]
          exact hvalK₁_mul_ge (3 * B₀) (t₁ : ℤ) _ w_inv hrem2 (Or.inr (le_of_eq hw_inv_val.symm))
        have hV₁_3 : V₁ = 4 * (t₂ : ℤ) := by
          rw [hV₁_def, hp3]
          norm_num
        have htr_rem2 :
            trM₁'K₁ ((u_fn m - Q₃_m) - ((3 : ℕ) : R_K) * w_m ^ 2 * Q₃_m) = 0 ∨
              V₁ ≤ vM₁' (trM₁'K₁ ((u_fn m - Q₃_m) - ((3 : ℕ) : R_K) * w_m ^ 2 * Q₃_m)) := by
          apply htr_M₁'K₁ V₁
          rw [← hT₁_def]
          refine hvalK₁_mono _ (3 * B₀ + (t₁ : ℤ)) _ ?_ hu_rem2_val
          rw [hT₁_z, hp_sub1_z, hV₁_3, hB₀_3, hp3]
          norm_num
          have ht₁_ge1_z : (1 : ℤ) ≤ (t₁ : ℤ) := by omega
          linarith only [ht_diff_nonneg, ht₁_ge1_z]
        
        have hw2Q_tr_eq :
            trM₁'K₁ (((3 : ℕ) : R_K) * w_m ^ 2 * Q₃_m) =
              ((3 : ℕ) : R_M) ^ 2 * ξ_base m * trM₁'K₁ (Δ_val ^ 3) +
                ((2 : ℕ) : R_M) * ((3 : ℕ) : R_M) ^ 2 * (ξ_base m) ^ 2 * trM₁'K₁ (Δ_val ^ 2) +
                ((3 : ℕ) : R_M) ^ 2 * (ξ_base m) ^ 3 * trM₁'K₁ (Δ_val ^ 1) := by
          have hexp :
              ((3 : ℕ) : R_K) * w_m ^ 2 * Q₃_m =
                iM₁'K₁ (((3 : ℕ) : R_M) ^ 2 * ξ_base m) * (Δ_val ^ 3) +
                  iM₁'K₁ (((2 : ℕ) : R_M) * ((3 : ℕ) : R_M) ^ 2 * (ξ_base m) ^ 2) * (Δ_val ^ 2) +
                  iM₁'K₁ (((3 : ℕ) : R_M) ^ 2 * (ξ_base m) ^ 3) * (Δ_val ^ 1) := by
            dsimp only [w_m, Q₃_m, ξ_fn]
            simp only [map_mul, map_pow, map_natCast]
            ring
          rw [hexp, map_add, map_add, htr_smul_M₁'K₁, htr_smul_M₁'K₁, htr_smul_M₁'K₁]
        have h3M_sq : ((3 : ℕ) : R_M) ^ 2 = 0 ∨ 4 * (t₂ : ℤ) ≤ vM₁' (((3 : ℕ) : R_M) ^ 2) := by
          have h3M : ((3 : ℕ) : R_M) = 0 ∨ 2 * (t₂ : ℤ) ≤ vM₁' ((3 : ℕ) : R_M) := by
            have h := hp_valM₁'
            rw [hp3] at h
            norm_num at h
            exact h
          have hpow := hvalM₁'_pow_ge ((3 : ℕ) : R_M) 2 (2 * (t₂ : ℤ)) h3M
          exact hvalM₁'_mono (4 * (t₂ : ℤ)) _ _ (by push_cast; linarith only) hpow
        have hterm_D3 :
            ((3 : ℕ) : R_M) ^ 2 * ξ_base m * trM₁'K₁ (Δ_val ^ 3) = 0 ∨
              V₁ ≤ vM₁' (((3 : ℕ) : R_M) ^ 2 * ξ_base m * trM₁'K₁ (Δ_val ^ 3)) := by
          have hm1 := hvalM₁'_mul_ge (4 * (t₂ : ℤ)) 0 (((3 : ℕ) : R_M) ^ 2) (ξ_base m)
            h3M_sq (Or.inr (le_of_eq hξ_b0.symm))
          have htr3 := hClaimB 3 (by omega)
