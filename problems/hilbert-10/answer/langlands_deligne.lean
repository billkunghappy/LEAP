          Finset.sum_congr rfl h_div_ne
        omega
      · have h1 := (Finset.add_sum_erase (Finset.range ℓ)
          (fun j => padicValNat p (γ_fn (x + 1) j).factorial) hj₀_mem).symm
        have h2 := (Finset.add_sum_erase (Finset.range ℓ)
          (fun j => padicValNat p (γ_fn x j).factorial) hj₀_mem).symm
        have h_er :
            ∑ j ∈ (Finset.range ℓ).erase j₀, padicValNat p (γ_fn (x + 1) j).factorial =
              ∑ j ∈ (Finset.range ℓ).erase j₀, padicValNat p (γ_fn x j).factorial :=
