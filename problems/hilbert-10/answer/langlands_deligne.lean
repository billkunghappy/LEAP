      have hadd_eq :
          ((2 * u - u ^ 2) - (traceLM F hM₁'K₁ (2 * w - w ^ 2) + 2 * normLM F hM₁'K₁ q_w)) +
            2 * normLM F hM₁'K₁ q_w =
          (2 * u - u ^ 2) - traceLM F hM₁'K₁ (2 * w - w ^ 2) := by ring
