      ϖ_E' ϖ_L_E' hϖ_norm_E' hϖ_E' hϖ_L_E' hBasis_E'
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      t_E' w_star_E' htE'_ge1 hw_star_E'_t hw_star_E'_nt1 hw_star_E'_norm htr_bound_E'_raw htr_surj_E' hnorm_exp_E'

  let α₀ : Lˣ := c_νE'₀⁻¹
  let u₀_E' : Lˣ := (α₀⁻¹ * γ) * (ϖ_L_E' ^ m)
  have hu₀_E'_mem : u₀_E' ∈ unitGroup F L 0 := by
    rw [hUG0_L]
    dsimp only [u₀_E', α₀]
    rw [inv_inv, Units.val_mul,
      hval_mul_L _ _ (Units.ne_zero (c_νE'₀ * γ)) (Units.ne_zero (ϖ_L_E' ^ m)),
      Units.val_mul, hval_mul_L _ _ (Units.ne_zero c_νE'₀) (Units.ne_zero γ),
      hc_νE'₀_val, hγ_val, hval_unit_pow L ϖ_L_E' m, hϖ_L_E', mul_one]
    have hm_cast : (m : ℤ) = (a_lam : ℤ) - (bE' : ℤ) := by omega
    omega
  obtain ⟨v_t₂, hv_t₂_0, hh₂'⟩ := hHerbrandApprox E' hLE' t_E' hnorm_step_E' t_E' le_rfl u₀_E' hu₀_E'_mem
  let h₂' : Lˣ := (Units.map (normLM F hLE') v_t₂) * u₀_E'⁻¹
  let h₂ : Lˣ := (h₂')⁻¹
  have hh₂ : h₂ ∈ unitGroup F L t_E' := hUG_inv_L t_E' h₂' hh₂'
  let w₂ : E'ˣ := (ϖ_E' ^ m)⁻¹ * v_t₂
  let α : Lˣ := α₀ * h₂

  have hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ := by
    dsimp only [α, α₀]
    rw [Units.val_mul, hval_mul_L _ _ (Units.ne_zero (c_νE'₀⁻¹)) (Units.ne_zero h₂),
      hval_inv_L c_νE'₀, hc_νE'₀_val, hUG_val0_L t_E' h₂ hh₂]
    ring
  have hw₂_val : valL F E' (w₂ : E') = -(m : ℤ) := by
    dsimp only [w₂]
    rw [Units.val_mul, hvalE'_props.2.2.2.2.1 _ _ (Units.ne_zero ((ϖ_E' ^ m)⁻¹)) (Units.ne_zero v_t₂),
      hvalE'_props.2.2.2.2.2.1 (ϖ_E' ^ m), hval_unit_pow E' ϖ_E' m, hϖ_E', mul_one,
      (hvalE'_props.2.2.2.2.2.2.2.2.1 v_t₂).mp hv_t₂_0, add_zero]
  have hw₂_norm : Units.map (normLM F hLE') w₂ = γ * α⁻¹ := by
    dsimp only [w₂]
    rw [map_mul, map_inv, map_pow, hϖ_norm_E', mul_comm ((ϖ_L_E' ^ m)⁻¹) _, mul_comm γ α⁻¹]
    dsimp only [α, h₂, h₂', u₀_E']
    group

  have hPrime_M₁' : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLM₁')) := by
    rw [hdegM₁']; exact hPrime
  have hWild_M₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') = EllipticRootNumber.p F := by
    rw [hdegM₁']; exact hWild
  have hνM₁'_pow_M₁' : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLM₁')) = 1 := by
    rw [hdegM₁']; exact hνM₁'_pow
  have hνM₁'_cond_M₁' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLM₁'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1 := by
    rw [hdegM₁']; exact hνM₁'_cond
  have hbM₁'_ne0 : bM₁' ≠ 0 := by omega

  obtain ⟨_, _, _, hval_norm_LM₁'_s6, hval_LM₁'_s6, hfrob_surj_M₁', _, _,
    ϖ_M₁', ϖ_L_M₁', hϖ_norm_M₁', hϖ_M₁', hϖ_L_M₁', hBasis_M₁'⟩ :=
    ld_wild_total_ramification_and_power_basis F L M₁' hLM₁' hPrime_M₁' νM₁'
      hνM₁'_pow_M₁' hνM₁'_ne hνM₁'_ker hνM₁'_cond_M₁' hbM₁'_ne0 hWild_M₁'
      haddVal1 haddVal_mul halg1 hvalL_props hvalM₁'_props
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
  obtain ⟨G_M₁', hGroupGM₁', hFinGM₁', act_M₁', t_M₁', w_star_M₁', hcard_GM₁', hactM₁'_one, hactM₁'_mul, hactM₁'_ring,
    hactM₁'_incl, _, hactM₁'_val, hactM₁'_trace, hactM₁'_norm,
    htM₁'_ge1, hw_star_M₁'_t, hw_star_M₁'_nt1, hw_star_M₁'_norm, hjump_M₁'_raw⟩ :=
    ld_wild_galois_aut_and_ramification_jump F L M₁' hLM₁' hGalLM₁' hPrime_M₁' hWild_M₁'
      haddVal1 halg1 hvalL_props hvalM₁'_props hval_norm_LM₁'_s6 hval_LM₁'_s6 ϖ_M₁' hϖ_M₁' hBasis_M₁'
  letI : Group G_M₁' := hGroupGM₁'
  letI : Fintype G_M₁' := hFinGM₁'
  obtain ⟨htr_bound_M₁'_raw, htr_surj_M₁'⟩ :=
    ld_wild_euler_lagrange_trace_formula F L M₁' hLM₁' hPrime_M₁'
      hvalL_props hvalM₁'_props hval_LM₁'_s6 ϖ_M₁' hϖ_M₁' hBasis_M₁'
      G_M₁' act_M₁' hcard_GM₁' hactM₁'_one hactM₁'_mul hactM₁'_ring hactM₁'_incl hactM₁'_trace t_M₁' hjump_M₁'_raw
  have hnorm_exp_M₁' :=
    ld_wild_free_orbit_norm_expansion F L M₁' hLM₁' hPrime_M₁' hvalM₁'_props
      G_M₁' act_M₁' hcard_GM₁' hactM₁'_one hactM₁'_mul hactM₁'_ring hactM₁'_val hactM₁'_trace hactM₁'_norm
  obtain ⟨hbM₁'_eq, _, _, hnorm_step_M₁', _, _⟩ :=
    ld_wild_herbrand_unit_norm_filtration_and_jump_eq F L M₁' hLM₁' hPrime_M₁' νM₁'
      hνM₁'_ker hνM₁'_cond_M₁' hvalL_props hvalM₁'_props hval_norm_LM₁'_s6 hval_LM₁'_s6 hfrob_surj_M₁'
      ϖ_M₁' ϖ_L_M₁' hϖ_norm_M₁' hϖ_M₁' hϖ_L_M₁' hBasis_M₁'
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      t_M₁' w_star_M₁' htM₁'_ge1 hw_star_M₁'_t hw_star_M₁'_nt1 hw_star_M₁'_norm htr_bound_M₁'_raw htr_surj_M₁' hnorm_exp_M₁'

  let β₀ : Lˣ := c_νM₁'₀⁻¹
  let m_M₁' : ℕ := a_lam - bM₁'
  let u₀_M₁' : Lˣ := (β₀⁻¹ * γ) * (ϖ_L_M₁' ^ m_M₁')
  have hu₀_M₁'_mem : u₀_M₁' ∈ unitGroup F L 0 := by
    rw [hUG0_L]
    dsimp only [u₀_M₁', β₀]
    rw [inv_inv, Units.val_mul,
      hval_mul_L _ _ (Units.ne_zero (c_νM₁'₀ * γ)) (Units.ne_zero (ϖ_L_M₁' ^ m_M₁')),
      Units.val_mul, hval_mul_L _ _ (Units.ne_zero c_νM₁'₀) (Units.ne_zero γ),
      hc_νM₁'₀_val, hγ_val, hval_unit_pow L ϖ_L_M₁' m_M₁', hϖ_L_M₁', mul_one]
    have hm_cast : (m_M₁' : ℤ) = (a_lam : ℤ) - (bM₁' : ℤ) := by omega
    omega
  obtain ⟨v_t₁, hv_t₁_0, hh₁'⟩ := hHerbrandApprox M₁' hLM₁' t_M₁' hnorm_step_M₁' t_M₁' le_rfl u₀_M₁' hu₀_M₁'_mem
  let h₁' : Lˣ := (Units.map (normLM F hLM₁') v_t₁) * u₀_M₁'⁻¹
  let h₁ : Lˣ := (h₁')⁻¹
  have hh₁ : h₁ ∈ unitGroup F L t_M₁' := hUG_inv_L t_M₁' h₁' hh₁'
  let w₁ : M₁'ˣ := (ϖ_M₁' ^ m_M₁')⁻¹ * v_t₁
  let β : Lˣ := β₀ * h₁

  have hβ_val : valL F L (β : L) = -(bM₁' : ℤ) - condExpChar F L ψ := by
    dsimp only [β, β₀]
    rw [Units.val_mul, hval_mul_L _ _ (Units.ne_zero (c_νM₁'₀⁻¹)) (Units.ne_zero h₁),
      hval_inv_L c_νM₁'₀, hc_νM₁'₀_val, hUG_val0_L t_M₁' h₁ hh₁]
    ring
  have hw₁_val : valL F M₁' (w₁ : M₁') = -((a_lam - bM₁' : ℕ) : ℤ) := by
    dsimp only [w₁, m_M₁']
    rw [Units.val_mul, hvalM₁'_props.2.2.2.2.1 _ _ (Units.ne_zero ((ϖ_M₁' ^ m_M₁')⁻¹)) (Units.ne_zero v_t₁),
      hvalM₁'_props.2.2.2.2.2.1 (ϖ_M₁' ^ m_M₁'), hval_unit_pow M₁' ϖ_M₁' m_M₁', hϖ_M₁', mul_one,
      (hvalM₁'_props.2.2.2.2.2.2.2.2.1 v_t₁).mp hv_t₁_0, add_zero]
  have hw₁_norm : Units.map (normLM F hLM₁') w₁ = γ * β⁻¹ := by
    dsimp only [w₁]
    rw [map_mul, map_inv, map_pow, hϖ_norm_M₁', mul_comm ((ϖ_L_M₁' ^ m_M₁')⁻¹) _, mul_comm γ β⁻¹]
    dsimp only [β, h₁, h₁', u₀_M₁']
    group

  
  have hh₂_sub1 : (h₂ : L) - 1 = 0 ∨ (t_E' : ℤ) ≤ valL F L ((h₂ : L) - 1) := by
    rcases (hUGa_L t_E' htE'_ge1 h₂).mp hh₂ with h1 | hge
    · left; exact sub_eq_zero.mpr h1
    · right; exact hge
  have hα_sub_val : (α : L) - (α₀ : L) = 0 ∨
      -(1 : ℤ) - condExpChar F L ψ ≤ valL F L ((α : L) - (α₀ : L)) := by
    have heq : (α : L) - (α₀ : L) = (α₀ : L) * ((h₂ : L) - 1) := by
      dsimp only [α]
      rw [Units.val_mul]
      ring
    rw [heq]
    have hα₀_val : (α₀ : L) = 0 ∨ (-(bE' : ℤ) - condExpChar F L ψ) ≤ valL F L (α₀ : L) := by
      right
      dsimp only [α₀]
      rw [hval_inv_L c_νE'₀, hc_νE'₀_val]
      linarith
    rcases hval_mul_bound L (-(bE' : ℤ) - condExpChar F L ψ) (t_E' : ℤ)
        (α₀ : L) ((h₂ : L) - 1) hα₀_val hh₂_sub1 with h0 | hge
    · left; exact h0
    · right; omega

  have hh₁_sub1 : (h₁ : L) - 1 = 0 ∨ (t_M₁' : ℤ) ≤ valL F L ((h₁ : L) - 1) := by
    rcases (hUGa_L t_M₁' htM₁'_ge1 h₁).mp hh₁ with h1 | hge
    · left; exact sub_eq_zero.mpr h1
    · right; exact hge
  have hβ_sub_val : (β : L) - (β₀ : L) = 0 ∨
      -(1 : ℤ) - condExpChar F L ψ ≤ valL F L ((β : L) - (β₀ : L)) := by
    have heq : (β : L) - (β₀ : L) = (β₀ : L) * ((h₁ : L) - 1) := by
      dsimp only [β]
      rw [Units.val_mul]
      ring
    rw [heq]
    have hβ₀_val : (β₀ : L) = 0 ∨ (-(bM₁' : ℤ) - condExpChar F L ψ) ≤ valL F L (β₀ : L) := by
      right
      dsimp only [β₀]
      rw [hval_inv_L c_νM₁'₀, hc_νM₁'₀_val]
      linarith
    rcases hval_mul_bound L (-(bM₁' : ℤ) - condExpChar F L ψ) (t_M₁' : ℤ)
        (β₀ : L) ((h₁ : L) - 1) hβ₀_val hh₁_sub1 with h0 | hge
    · left; exact h0
    · right; omega

  have hc₂_ge1 : 1 ≤ c₂ := Nat.div_pos (by omega) hp_pos
  have hq₀_ge1 : 1 ≤ q₀ := Nat.div_pos (by omega) hp_pos
  have hq₂_ge1 : 1 ≤ q₂ := Nat.div_pos (by omega) hp_pos
  have hq₁_ge1 : 1 ≤ q₁ := Nat.div_pos (by omega) hp_pos
  have hct_ge1 : 1 ≤ ct := Nat.div_pos (by omega) hp_pos
  have hval_neg2_L : (-2 : L) = 0 ∨ (0 : ℤ) ≤ valL F L (-2 : L) := by
    rcases hval_natCast L 2 with h0 | hge
    · left; exact neg_eq_zero.mpr h0
    · right; rw [hval_neg_L]; exact hge

  have hα_inv_val : valL F L ((α⁻¹ : Lˣ) : L) = (bE' : ℤ) + condExpChar F L ψ := by
    rw [hval_inv_L α, hα_val]; ring
  have hα_νE'_log : ∀ u : L, (u = 0 ∨ (c₂ : ℤ) ≤ valL F L u) →
      ∀ hu : 1 - u ≠ 0,
        (νE' (Units.mk0 (1 - u) hu) : Ω F) ^ 2 =
          ψ (- 2 * (((α⁻¹)⁻¹ : Lˣ) : L) * P_L u) := by
    intro u hu_val hu
    rw [inv_inv, hc_νE'₀_log u hu_val hu]
    have hu_ge1 : u = 0 ∨ (1 : ℤ) ≤ valL F L u := by
      rcases hu_val with rfl | hge
      · left; rfl
      · right; omega
    have hPL_u := hPL_val 1 u (by omega) hu_ge1
    let diff : L := (-2 : L) * ((α : L) - (α₀ : L)) * P_L u
    have hdiff_val : diff = 0 ∨ -condExpChar F L ψ ≤ valL F L diff := by
      have hm1 := hval_mul_bound L 0 (-(1 : ℤ) - condExpChar F L ψ) (-2 : L) ((α : L) - (α₀ : L))
        hval_neg2_L hα_sub_val
      rcases hval_mul_bound L (0 + (-(1 : ℤ) - condExpChar F L ψ)) 1 _ (P_L u) hm1 hPL_u with h0 | hge
      · left; exact h0
      · right; linarith
    have hψ_diff : ψ diff = 1 := hψ_triv diff hdiff_val
    have hsplit : - 2 * (α : L) * P_L u = diff + (- 2 * (α₀ : L) * P_L u) := by
      dsimp only [diff]; ring
    change ψ (- 2 * (α₀ : L) * P_L u) = ψ (- 2 * (α : L) * P_L u)
    rw [hsplit, AddChar.map_add_eq_mul, hψ_diff, one_mul]

  have hConv_E' : ∀ y : E', (y = 0 ∨ (c₂ : ℤ) ≤ valL F E' y) →
      ψE' (2 * IntermediateField.inclusion hLE' (α : L) * y) =
        ψ (- 2 * (α : L) * normLM F hLE' y) := by
    intro y hy
    have h := (hConv_E'_fn (α⁻¹) hα_inv_val hα_νE'_log y hy).2
    rw [inv_inv] at h
    exact h

  have hβ_inv_val : valL F L ((β⁻¹ : Lˣ) : L) = (bM₁' : ℤ) + condExpChar F L ψ := by
    rw [hval_inv_L β, hβ_val]; ring
  have hβ_νM₁'_log : ∀ u : L, (u = 0 ∨ (q₀ : ℤ) ≤ valL F L u) →
      ∀ hu : 1 - u ≠ 0,
        (νM₁' (Units.mk0 (1 - u) hu) : Ω F) ^ 2 =
          ψ (- 2 * (((β⁻¹)⁻¹ : Lˣ) : L) * P_L u) := by
    intro u hu_val hu
    rw [inv_inv, hc_νM₁'₀_log u hu_val hu]
    have hu_ge1 : u = 0 ∨ (1 : ℤ) ≤ valL F L u := by
      rcases hu_val with rfl | hge
      · left; rfl
      · right; omega
    have hPL_u := hPL_val 1 u (by omega) hu_ge1
    let diff : L := (-2 : L) * ((β : L) - (β₀ : L)) * P_L u
    have hdiff_val : diff = 0 ∨ -condExpChar F L ψ ≤ valL F L diff := by
      have hm1 := hval_mul_bound L 0 (-(1 : ℤ) - condExpChar F L ψ) (-2 : L) ((β : L) - (β₀ : L))
        hval_neg2_L hβ_sub_val
      rcases hval_mul_bound L (0 + (-(1 : ℤ) - condExpChar F L ψ)) 1 _ (P_L u) hm1 hPL_u with h0 | hge
      · left; exact h0
      · right; linarith
    have hψ_diff : ψ diff = 1 := hψ_triv diff hdiff_val
    have hsplit : - 2 * (β : L) * P_L u = diff + (- 2 * (β₀ : L) * P_L u) := by
      dsimp only [diff]; ring
    change ψ (- 2 * (β₀ : L) * P_L u) = ψ (- 2 * (β : L) * P_L u)
    rw [hsplit, AddChar.map_add_eq_mul, hψ_diff, one_mul]

  have hConv_M₁'_q₀ : ∀ z : M₁', (z = 0 ∨ (q₀ : ℤ) ≤ valL F M₁' z) →
      ψM₁' (2 * IntermediateField.inclusion hLM₁' (β : L) * z) =
        ψ (- 2 * (β : L) * normLM F hLM₁' z) := by
    intro z hz
    have h := (hConv_M₁'_fn (β⁻¹) hβ_inv_val hβ_νM₁'_log z hz).2
    rw [inv_inv] at h
    exact h

  have hZ_bounds : (3 : ℤ) ≤ p ∧ (2 : ℤ) ≤ bM₁' ∧ (bM₁' : ℤ) ≤ bE' ∧
      (t₁ : ℤ) = (bM₁' : ℤ) - 1 ∧ (1 : ℤ) ≤ q₁ ∧ (1 : ℤ) ≤ q₂ := by omega

  have hχ₂_log' : ∀ x : E', (x = 0 ∨ (q₂ : ℤ) ≤ valL F E' x) →
      ∀ hx : 1 - x ≠ 0,
        (χ₂ (Units.mk0 (1 - x) hx) : Ω F) ^ 2 =
          ψE' (2 * IntermediateField.inclusion hLE' (α : L) * a * P_E' x) := by
    intro x hx_val hx
    rw [hχ₂_log x hx_val hx]
    have hPE'_x := hPE'_val (q₂ : ℤ) x (by positivity) hx_val
    have hincl_diff : IntermediateField.inclusion hLE' ((α : L) - (α₀ : L)) = 0 ∨
        (p : ℤ) * (-(1 : ℤ) - condExpChar F L ψ) ≤
          valL F E' (IntermediateField.inclusion hLE' ((α : L) - (α₀ : L))) := by
      rcases hα_sub_val with h0 | hge
      · left; rw [h0, map_zero]
      · right
        rw [hval_LE']
        exact mul_le_mul_of_nonneg_left hge (by positivity)
    let D₂ : E' := (2 : E') * IntermediateField.inclusion hLE' ((α : L) - (α₀ : L)) * a * P_E' x
    have hD₂_val : D₂ = 0 ∨ -condExpChar F E' ψE' ≤ valL F E' D₂ := by
      have hm1 := hval_mul_bound E' 0 ((p : ℤ) * (-(1 : ℤ) - condExpChar F L ψ))
        (2 : E') _ (hval_natCast E' 2) hincl_diff
      have hm2 := hval_mul_bound E' (0 + (p : ℤ) * (-(1 : ℤ) - condExpChar F L ψ)) (-(t₁ : ℤ))
        _ a hm1 (Or.inr (by rw [ha_val]))
      rcases hval_mul_bound E' (0 + (p : ℤ) * (-(1 : ℤ) - condExpChar F L ψ) + -(t₁ : ℤ)) (q₂ : ℤ)
          _ (P_E' x) hm2 hPE'_x with h0 | hge
      · left; exact h0
      · right
        have hineq : -condExpChar F E' ψE' ≤
            0 + (p : ℤ) * (-(1 : ℤ) - condExpChar F L ψ) + -(t₁ : ℤ) + (q₂ : ℤ) := by
          change -condExpChar F E' (traceChar F hLE' ψ) ≤ _
          rw [hnE'_eq]
          change -((p : ℤ) * condExpChar F L ψ + ((p - 1 : ℕ) : ℤ) * (bE' : ℤ)) ≤ _
          rw [hp_sub1_cast]
          nlinarith
        exact hineq.trans hge
    have hψE'_D₂ : ψE' D₂ = 1 := hψE'_triv D₂ hD₂_val
    have hsplit : 2 * IntermediateField.inclusion hLE' (α : L) * a * P_E' x =
        D₂ + 2 * IntermediateField.inclusion hLE' (α₀ : L) * a * P_E' x := by
      dsimp only [D₂]
      rw [map_sub]
      ring
    change ψE' (2 * IntermediateField.inclusion hLE' (α₀ : L) * a * P_E' x) =
      ψE' (2 * IntermediateField.inclusion hLE' (α : L) * a * P_E' x)
    rw [hsplit, AddChar.map_add_eq_mul, hψE'_D₂, one_mul]

  have hχ₁_log' : ∀ z : M₁', (z = 0 ∨ (q₁ : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 - z ≠ 0,
        (χ₁ (Units.mk0 (1 - z) hz) : Ω F) ^ 2 =
          ψM₁' (2 * IntermediateField.inclusion hLM₁' (α : L) * b * P_M₁' z) := by
    intro z hz_val hz
    rw [hχ₁_log z hz_val hz]
    have hPM₁'_z := hPM₁'_val (q₁ : ℤ) z (by positivity) hz_val
    have hincl_diff : IntermediateField.inclusion hLM₁' ((α : L) - (α₀ : L)) = 0 ∨
        (p : ℤ) * (-(1 : ℤ) - condExpChar F L ψ) ≤
          valL F M₁' (IntermediateField.inclusion hLM₁' ((α : L) - (α₀ : L))) := by
      rcases hα_sub_val with h0 | hge
      · left; rw [h0, map_zero]
      · right
        rw [hval_LM₁']
        exact mul_le_mul_of_nonneg_left hge (by positivity)
    let D₁ : M₁' := (2 : M₁') * IntermediateField.inclusion hLM₁' ((α : L) - (α₀ : L)) * b * P_M₁' z
    have hD₁_val : D₁ = 0 ∨ -condExpChar F M₁' ψM₁' ≤ valL F M₁' D₁ := by
      have hm1 := hval_mul_bound M₁' 0 ((p : ℤ) * (-(1 : ℤ) - condExpChar F L ψ))
        (2 : M₁') _ (hval_natCast M₁' 2) hincl_diff
      have hm2 := hval_mul_bound M₁' (0 + (p : ℤ) * (-(1 : ℤ) - condExpChar F L ψ)) (-(t₁ : ℤ))
        _ b hm1 (Or.inr (by rw [hb_val]))
      rcases hval_mul_bound M₁' (0 + (p : ℤ) * (-(1 : ℤ) - condExpChar F L ψ) + -(t₁ : ℤ)) (q₁ : ℤ)
          _ (P_M₁' z) hm2 hPM₁'_z with h0 | hge
      · left; exact h0
      · right
        have hineq : -condExpChar F M₁' ψM₁' ≤
            0 + (p : ℤ) * (-(1 : ℤ) - condExpChar F L ψ) + -(t₁ : ℤ) + (q₁ : ℤ) := by
          change -condExpChar F M₁' (traceChar F hLM₁' ψ) ≤ _
          rw [hnM₁'_eq]
          change -((p : ℤ) * condExpChar F L ψ + ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ)) ≤ _
          rw [hp_sub1_cast]
          nlinarith
        exact hineq.trans hge
    have hψM₁'_D₁ : ψM₁' D₁ = 1 := hψM₁'_triv D₁ hD₁_val
    have hsplit : 2 * IntermediateField.inclusion hLM₁' (α : L) * b * P_M₁' z =
        D₁ + 2 * IntermediateField.inclusion hLM₁' (α₀ : L) * b * P_M₁' z := by
      dsimp only [D₁]
      rw [map_sub]
      ring
    change ψM₁' (2 * IntermediateField.inclusion hLM₁' (α₀ : L) * b * P_M₁' z) =
      ψM₁' (2 * IntermediateField.inclusion hLM₁' (α : L) * b * P_M₁' z)
    rw [hsplit, AddChar.map_add_eq_mul, hψM₁'_D₁, one_mul]

  
  have hct_imp : q₀ ≤ ct →
      (∀ z : M₁', (z = 0 ∨ (ct : ℤ) ≤ valL F M₁' z) →
        ψM₁' (2 * IntermediateField.inclusion hLM₁' (β : L) * z) =
          ψ (- 2 * (β : L) * normLM F hLM₁' z)) ∧
      (normLM F hLM₁' (- e_Δ (p - 1)) - ((β : L) * ((α⁻¹ : Lˣ) : L)) ^ (p - 1) = 0 ∨
        ((t₁ + 1 - ct + (p - 1) * (bE' - bM₁') : ℕ) : ℤ) ≤
          valL F L (normLM F hLM₁' (- e_Δ (p - 1)) -
            ((β : L) * ((α⁻¹ : Lˣ) : L)) ^ (p - 1))) := by
    intro hq₀_le_ct
    refine ⟨?_, ?_⟩
    · intro z hz
      apply hConv_M₁'_q₀ z
      rcases hz with rfl | hge
      · left; rfl
      · right; omega
    · have hβ_ct_log : ∀ u : L, (u = 0 ∨ (ct : ℤ) ≤ valL F L u) →
          ∀ hu : 1 - u ≠ 0,
            (νM₁' (Units.mk0 (1 - u) hu) : Ω F) ^ 2 =
              ψ (- 2 * (((β⁻¹)⁻¹ : Lˣ) : L) * P_L u) := by
        intro u hu_val hu
        apply hβ_νM₁'_log u _ hu
        rcases hu_val with rfl | hge
        · left; rfl
        · right; omega
      have hThm := hThm8_16 (β⁻¹) hβ_inv_val hβ_ct_log
      let H : L := normLM F hLM₁' (- e_Δ (p - 1))
      let v₀ : L := (((β⁻¹)⁻¹ : Lˣ) : L) * (c_νE'₀ : L)
      let v : L := (β : L) * ((α⁻¹ : Lˣ) : L)
      change H - v₀ ^ (p - 1) = 0 ∨
        ((t₁ + 1 - ct + (p - 1) * (bE' - bM₁') : ℕ) : ℤ) ≤ valL F L (H - v₀ ^ (p - 1)) at hThm
      have hc_eq : c_νE'₀ = α⁻¹ * h₂ := by
        dsimp only [α, α₀]
        rw [mul_comm (c_νE'₀⁻¹) h₂]
        group
      have hv₀_eq : v₀ = v * (h₂ : L) := by
        dsimp only [v₀, v]
        rw [inv_inv, hc_eq, Units.val_mul α⁻¹ h₂]
        ring
      have hv_val : v = 0 ∨ ((bE' - bM₁' : ℕ) : ℤ) ≤ valL F L v := by
        right
        dsimp only [v]
        rw [hval_mul_L _ _ (Units.ne_zero β) (Units.ne_zero (α⁻¹)),
          hβ_val, hα_inv_val]
        omega
      have hv_pow := hval_pow L (p - 1) ((bE' - bM₁' : ℕ) : ℤ) v hv_val
      have hh₂_val0 : (h₂ : L) = 0 ∨ (0 : ℤ) ≤ valL F L (h₂ : L) :=
        Or.inr (by rw [hUG_val0_L t_E' h₂ hh₂])
      have hgeom_sum : (∑ i ∈ Finset.range (p - 1), (h₂ : L) ^ i) = 0 ∨
          (0 : ℤ) ≤ valL F L (∑ i ∈ Finset.range (p - 1), (h₂ : L) ^ i) := by
        apply hval_sum L (Finset.range (p - 1)) (fun i => (h₂ : L) ^ i) 0
        intro i _
        rcases hval_pow L i 0 (h₂ : L) hh₂_val0 with h0 | hge
        · left; exact h0
        · right; rw [mul_zero] at hge; exact hge
      have hh₂_pow_sub1 : (h₂ : L) ^ (p - 1) - 1 = 0 ∨
          (t_E' : ℤ) ≤ valL F L ((h₂ : L) ^ (p - 1) - 1) := by
        rw [← geom_sum_mul (h₂ : L) (p - 1)]
        rcases hval_mul_bound L 0 (t_E' : ℤ) _ _ hgeom_sum hh₂_sub1 with h0 | hge
        · left; exact h0
        · right; linarith
      have hv₀_sub_v : v₀ ^ (p - 1) - v ^ (p - 1) = 0 ∨
          ((t₁ + 1 - ct + (p - 1) * (bE' - bM₁') : ℕ) : ℤ) ≤
            valL F L (v₀ ^ (p - 1) - v ^ (p - 1)) := by
        have h_alg : v₀ ^ (p - 1) - v ^ (p - 1) = v ^ (p - 1) * ((h₂ : L) ^ (p - 1) - 1) := by
          rw [hv₀_eq, mul_pow]
          ring
        rw [h_alg]
        rcases hval_mul_bound L (((p - 1 : ℕ) : ℤ) * ((bE' - bM₁' : ℕ) : ℤ)) (t_E' : ℤ)
            (v ^ (p - 1)) ((h₂ : L) ^ (p - 1) - 1) hv_pow hh₂_pow_sub1 with h0 | hge
        · left; exact h0
        · right; omega
      have hH_split : H - v ^ (p - 1) = (H - v₀ ^ (p - 1)) + (v₀ ^ (p - 1) - v ^ (p - 1)) := by ring
      rw [hH_split]
      exact hval_add_L ((t₁ + 1 - ct + (p - 1) * (bE' - bM₁') : ℕ) : ℤ) _ _ hThm hv₀_sub_v

  
  exact ⟨α, β, γ, w₂, w₁, hα_val, hβ_val, hγ_val, hw₂_val, hw₁_val,
    hw₂_norm, hw₁_norm, hlam_log, hχ₂_log', hχ₁_log', hConv_E', hConv_M₁'_q₀, hct_imp⟩

theorem ld_ch12_wild_odd_trunc_log_poly_val_and_inversion_bounds (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (p : ℕ) (hPrime : Nat.Prime p) (hWild : p = EllipticRootNumber.p F)
    (hp_odd : EllipticRootNumber.p F ≠ 2) :
    let P_M := fun z : M => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M)⁻¹ * z ^ j
    (∀ (r : ℕ), 1 ≤ r → ∀ x : M, (x = 0 ∨ (r : ℤ) ≤ valL F M x) →
      P_M x = 0 ∨ (r : ℤ) ≤ valL F M (P_M x)) ∧
    (∀ (r : ℕ), 1 ≤ r → ∀ x : M, (x = 0 ∨ 1 ≤ valL F M x) →
      (P_M x = 0 ∨ (r : ℤ) ≤ valL F M (P_M x)) →
      (x = 0 ∨ (r : ℤ) ≤ valL F M x)) ∧
    (∀ (m_M : ℕ), 2 ≤ m_M →
      let d_M := m_M / 2
      ∀ x : M, (x = 0 ∨ (d_M : ℤ) ≤ valL F M x) →
        - 2 * P_M (-x) - (2 * x - x ^ 2) = 0 ∨
          (m_M : ℤ) ≤ valL F M (- 2 * P_M (-x) - (2 * x - x ^ 2))) :=
by
  intro P_M
  have hp_ne2 : p ≠ 2 := hWild ▸ hp_odd
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add,
      _, _, _⟩ := ld_valL_and_unitGroup_props F M
  have hvalM_8 : valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) :=
    ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add⟩
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F M
  have haddVal_6 : addVal F 1 = 0 ∧
      (∀ a : F, addVal F (-a) = addVal F a) ∧
      (∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b) ∧
      (∀ a : F, a ≠ 0 → addVal F a⁻¹ = - addVal F a) ∧
      (∀ a : F, (a = 0 ∨ 0 ≤ addVal F a) →
        (algebraMap F M a = 0 ∨ 0 ≤ valL F M (algebraMap F M a))) ∧
      (∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
        (algebraMap F M a = 0 ∨ 1 ≤ valL F M (algebraMap F M a))) :=
    ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1⟩
  obtain ⟨S₁, hS₁⟩ := ld_valL_mod_one_finset F M hval0 hval_neg hval_mul hval_add
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨k_M, hField_kM, hFin_kM, resM, hresM_0, hresM_1, hresM_ring, hresM_ker, hresM_surj⟩ :=
    ld_valL_residue_field_exists F M hval0 hval1 hval_neg1 hval_neg hval_mul hval_inv hval_add S₁ hS₁
  letI : Field k_M := hField_kM
  letI : Fintype k_M := hFin_kM
  obtain ⟨_, hp_char_F, _⟩ := ld_valL_residue_field_card_eq_qL F M hvalM_8 haddVal_6
    k_M resM hresM_0 hresM_1 hresM_ring hresM_ker hresM_surj
  have hp_char : ((p : ℕ) : k_M) = 0 := by
    rw [hWild]
    exact hp_char_F
  obtain ⟨_, _, _, _, hPM_lin, hPM_bounds⟩ :=
    ld_ch12_single_field_coprime_inv_val_and_trunc_log_bounds F M p hPrime hp_ne2
      hvalM_8 k_M resM hresM_0 hresM_1 hresM_ring hresM_ker hp_char
      (fun hj x y => ld_trunc_log_binomial_tail_ring_identity M p hPrime hp_ne2 hj x y)
  change ∀ (r : ℕ), 1 ≤ r → ∀ x : M, (x = 0 ∨ (r : ℤ) ≤ valL F M x) →
    P_M x - x = 0 ∨ (2 * (r : ℤ)) ≤ valL F M (P_M x - x) at hPM_lin
  refine ⟨?_, ?_, ?_⟩
  · intro r hr x hx
    have hdiff := hPM_lin r hr x hx
    have hdiff_r : P_M x - x = 0 ∨ (r : ℤ) ≤ valL F M (P_M x - x) := by
      rcases hdiff with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum := hval_add (r : ℤ) (P_M x - x) x hdiff_r hx
    rwa [sub_add_cancel] at hsum
  · intro r hr x hx1 hPx
    rcases hx1 with rfl | hx_ge1
    · exact Or.inl rfl
    · by_cases hx0 : x = 0
      · exact Or.inl hx0
      · right
        by_contra hnot
        set k : ℕ := (valL F M x).toNat
        have hk_eq : (k : ℤ) = valL F M x := Int.toNat_of_nonneg (by omega)
        have hk_ge1 : 1 ≤ k := by omega
        have hk_lt : k + 1 ≤ r := by omega
        have hdiff := hPM_lin k hk_ge1 x (Or.inr (by omega))
        have hdiff_k1 : P_M x - x = 0 ∨ ((k + 1 : ℕ) : ℤ) ≤ valL F M (P_M x - x) := by
          rcases hdiff with h0 | hle
          · exact Or.inl h0
          · exact Or.inr (by omega)
        have hPx_k1 : - P_M x = 0 ∨ ((k + 1 : ℕ) : ℤ) ≤ valL F M (- P_M x) := by
          rcases hPx with h0 | hle
          · exact Or.inl (by rw [h0, neg_zero])
          · rw [hval_neg]
            exact Or.inr (by omega)
        have hsum := hval_add ((k + 1 : ℕ) : ℤ) (P_M x - x) (- P_M x) hdiff_k1 hPx_k1
        have heq : P_M x - x + - P_M x = -x := by ring
        rw [heq] at hsum
        rcases hsum with hneg0 | hle
        · exact hx0 (neg_eq_zero.mp hneg0)
        · rw [hval_neg, ← hk_eq] at hle
          omega
  · intro m_M hm_ge2 d_M x hx
    have hnx : -x = 0 ∨ (d_M : ℤ) ≤ valL F M (-x) := by
      rcases hx with rfl | hle
      · exact Or.inl neg_zero
      · rw [hval_neg]
        exact Or.inr hle
    have hquad := (hPM_bounds m_M hm_ge2).2 (-x) hnx
    have heq : - 2 * P_M (-x) - (- 2 * (-x) - (-x) ^ 2) =
        - 2 * P_M (-x) - (2 * x - x ^ 2) := by ring
    rwa [heq] at hquad

theorem ld_ch12_wild_odd_totally_ramified_higher_cond_four_factor_algebraic_reduction (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (bE' : ℕ)
    (θ₁ χ₁ : M₁'ˣ →* (Ω F)ˣ) (θ₂ χ₂ : E'ˣ →* (Ω F)ˣ) (lam_L : Lˣ →* (Ω F)ˣ)
    (hθ₁_eq : θ₁ = χ₁ * lam_L.comp (Units.map (normLM F hLM₁')))
    (hθ₂_eq : θ₂ = χ₂ * lam_L.comp (Units.map (normLM F hLE')))
    (a : E') (b : M₁')
    (hTrNormCongr :
      traceLM F hLM₁' b - traceLM F hLE' a = 0 ∨
        (bE' : ℤ) ≤ valL F L (traceLM F hLM₁' b - traceLM F hLE' a))
    (α β γ : Lˣ) (w₂ : E'ˣ) (w₁ : M₁'ˣ)
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (A₁ C₁ cM₁' : M₁'ˣ) (C₂ cE' : E'ˣ)
    (hA₁_eq : (A₁ : M₁') = IntermediateField.inclusion hLM₁' (γ : L) +
      IntermediateField.inclusion hLM₁' (α : L) * b)
    (hC₁_eq : (C₁ : M₁') = (A₁ : M₁') -
      IntermediateField.inclusion hLM₁' (β : L) * (w₁ : M₁'))
    (hC₂_eq : (C₂ : E') = IntermediateField.inclusion hLE' (γ : L) -
      IntermediateField.inclusion hLE' (α : L) * (w₂ : E') +
      IntermediateField.inclusion hLE' (α : L) * a)
    (hcE'_eq : cE' = (-C₂)⁻¹)
    (hcM₁'_eq : cM₁' = (-C₁)⁻¹)
    (hFourFactor :
      ((χ₁ A₁ : Ω F) ^ 2 * ((χ₂ C₂ : Ω F) ^ 2)⁻¹ *
        (lam_L (Units.map (normLM F hLM₁') A₁ * (Units.map (normLM F hLE') C₂)⁻¹) : Ω F) ^ 2 *
        ((traceChar F hLM₁' ψ) (- 2 * IntermediateField.inclusion hLM₁' (β : L) * (w₁ : M₁')) *
          (θ₁ (C₁ * A₁⁻¹) : Ω F) ^ 2) *
        (traceChar F hLE' ψ) (2 * IntermediateField.inclusion hLE' (α : L) * (w₂ : E'))) ^ 2 = 1) :
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    (θ₂ cE' : Ω F) ^ 4 * (ψE' (((cE'⁻¹ : E'ˣ) : E') * 2)) ^ 2 =
      (θ₁ cM₁' : Ω F) ^ 4 * (ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * 2)) ^ 2 :=
by
  intro ψE' ψM₁'
  have hval_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y := by
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ a₀ b₀ : F, a₀ ≠ 0 → b₀ ≠ 0 →
        addVal F (a₀ * b₀) = addVal F a₀ + addVal F b₀ := by
      intro a₀ b₀ ha₀ hb₀
      have hab₀ : a₀ * b₀ ≠ 0 := mul_ne_zero ha₀ hb₀
      have hva : valuation F a₀ ≠ 0 := (Valuation.ne_zero_iff _).mpr ha₀
      have hφa : φ (valuation F a₀) ≠ 0 := (map_ne_zero _).mpr hva
      have hvb : valuation F b₀ ≠ 0 := (Valuation.ne_zero_iff _).mpr hb₀
      have hφb : φ (valuation F b₀) ≠ 0 := (map_ne_zero _).mpr hvb
      have hvab : valuation F (a₀ * b₀) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab₀
      have hφab : φ (valuation F (a₀ * b₀)) ≠ 0 := (map_ne_zero _).mpr hvab
      unfold addVal
      rw [dif_neg hab₀, dif_neg ha₀, dif_neg hb₀]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_pow : ∀ (a₀ : F) (n : ℕ), a₀ ≠ 0 →
        addVal F (a₀ ^ n) = (n : ℤ) * addVal F a₀ := by
      intro a₀ n ha₀
      have han : a₀ ^ n ≠ 0 := pow_ne_zero n ha₀
      have hva : valuation F a₀ ≠ 0 := (Valuation.ne_zero_iff _).mpr ha₀
      have hφa : φ (valuation F a₀) ≠ 0 := (map_ne_zero _).mpr hva
      have hvan : valuation F (a₀ ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
      have hφan : φ (valuation F (a₀ ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
      unfold addVal
      rw [dif_neg han, dif_neg ha₀]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    have hrel0 : relVal F L 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F L 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 →
        relVal F L (x * y) = relVal F L x + relVal F L y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
    have hrel_inv : ∀ u : Lˣ, relVal F L ((u⁻¹ : Lˣ) : L) = - relVal F L (u : L) := by
      intro u
      have hmul : relVal F L ((u : L) * ((u⁻¹ : Lˣ) : L)) =
          relVal F L (u : L) + relVal F L ((u⁻¹ : Lˣ) : L) :=
        hrel_mul (u : L) ((u⁻¹ : Lˣ) : L) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Lˣ) (n : ℕ),
        relVal F L (((u ^ n : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L) := by
      intro u n
      induction n with
      | zero => simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Lˣ) (m : ℤ),
        relVal F L (((u ^ m : Lˣ) : L)) = m * relVal F L (u : L) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F L (((u ^ (n : ℤ) : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := by
      intro h0
      apply hφπ_ne
      simp [h0]
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x₀ : L := algebraMap F L π
    have hx₀_ne : x₀ ≠ 0 := by simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F L x₀ = (Module.finrank F L : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F L) hπ_ne, hadd_π, mul_one]
    have hfin_pos : 0 < Module.finrank F L := Module.finrank_pos
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : L, x ≠ 0 ∧ relVal F L x = k}
    have hS_nonempty : S.Nonempty := ⟨Module.finrank F L, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfL_mem : resDeg F L ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfL_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfL_mem
    let ϖL : Lˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖL : relVal F L (ϖL : L) = (resDeg F L : ℤ) := hrel_ϖ₀
    have hfL_int_pos : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hfL_pos
    have hfL_int_ne : (resDeg F L : ℤ) ≠ 0 := ne_of_gt hfL_int_pos
    have hdiv : ∀ x : L, relVal F L x = (resDeg F L : ℤ) * valL F L x := by
      intro x
      by_cases hx : x = 0
      · unfold valL
        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F L : ℤ)
        set q : ℤ := valL F L x
        set r : ℤ := relVal F L x % f
        have hediv : f * q + r = relVal F L x := Int.mul_ediv_add_emod (relVal F L x) f
        have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F L x) hfL_int_ne
        have hr_lt : r < f := Int.emod_lt_of_pos (relVal F L x) hfL_int_pos
        have hr_zero : r = 0 := by
          by_contra hr_ne
          have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
          let y : L := x * (((ϖL ^ (-q) : Lˣ) : L))
          have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
          have hrel_y : relVal F L y = r := by
            dsimp [y]
            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖL (-q), hrel_ϖL]
            linarith
          let k : ℕ := r.toNat
          have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k := by omega
          have hk_lt : k < resDeg F L := by omega
          have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F L ≤ k := Nat.sInf_le hk_mem
          omega
        linarith
    intro x y hx hy
    apply mul_left_cancel₀ hfL_int_ne
    rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
  have hψ_triv : ∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1 := by
    set Sψ : Set ℤ := {d : ℤ | ∀ x : L, -d ≤ valL F L x → ψ x = 1}
    have hne_ψ : Sψ.Nonempty := by
      obtain ⟨d₀, hd₀⟩ := hψ.2
      refine ⟨-d₀, fun x hx => hd₀ x ?_⟩
      simpa using hx
    have hbdd_ψ : BddAbove Sψ := by
      have hne1 : ∃ x₀ : L, ψ x₀ ≠ 1 := by
        rcases DFunLike.ne_iff.mp hψ.1 with ⟨x₀, hx₀⟩
        exact ⟨x₀, by simpa [AddChar.one_apply] using hx₀⟩
      obtain ⟨x₀, hx₀⟩ := hne1
      refine ⟨-valL F L x₀ - 1, fun d hd => ?_⟩
      by_contra hlt
      have hle : -d ≤ valL F L x₀ := by omega
      exact hx₀ (hd x₀ hle)
    have hmem_ψ : condExpChar F L ψ ∈ Sψ := Int.csSup_mem hne_ψ hbdd_ψ
    intro x hx
    rcases hx with rfl | hx
    · exact AddChar.map_zero_eq_one ψ
    · exact hmem_ψ x hx
  have htr_incl : ∀ (A : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F A]
      (hLA : L ≤ A) (x : L),
      traceLM F hLA (IntermediateField.inclusion hLA x) =
        Module.finrank L (IntermediateField.extendScalars hLA) • x := by
    letI : SMul L L := instSMulOfMul
    letI : Module L L := Semiring.toModule
    intro A _ hLA x
    change (Algebra.trace L (IntermediateField.extendScalars hLA))
      ((algebraMap L (IntermediateField.extendScalars hLA)) x) =
      Module.finrank L (IntermediateField.extendScalars hLA) • x
    exact Algebra.trace_algebraMap x
  have htr_smul : ∀ (A : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F A]
      (hLA : L ≤ A) (x : L) (z : A),
      traceLM F hLA (IntermediateField.inclusion hLA x * z) = x * traceLM F hLA z := by
    letI : SMul L L := instSMulOfMul
    letI : Module L L := Semiring.toModule
    intro A _ hLA x z
    have hsmul : toExtendScalars F hLA (IntermediateField.inclusion hLA x * z) =
        x • toExtendScalars F hLA z := rfl
    have hmap := (Algebra.trace L (IntermediateField.extendScalars hLA)).map_smul' x
      (toExtendScalars F hLA z)
    change (Algebra.trace L (IntermediateField.extendScalars hLA))
      (toExtendScalars F hLA (IntermediateField.inclusion hLA x * z)) =
      x * (Algebra.trace L (IntermediateField.extendScalars hLA)) (toExtendScalars F hLA z)
    rw [hsmul]
    exact hmap
  have hψ_γ : ψM₁' (- 2 * IntermediateField.inclusion hLM₁' (γ : L)) =
      ψE' (- 2 * IntermediateField.inclusion hLE' (γ : L)) := by
    have h1 : (- 2 * IntermediateField.inclusion hLM₁' (γ : L) : M₁') =
        IntermediateField.inclusion hLM₁' (- 2 * (γ : L)) := by
      rw [map_mul, map_neg, map_ofNat]
    have h2 : (- 2 * IntermediateField.inclusion hLE' (γ : L) : E') =
        IntermediateField.inclusion hLE' (- 2 * (γ : L)) := by
      rw [map_mul, map_neg, map_ofNat]
    change ψ (traceLM F hLM₁' (- 2 * IntermediateField.inclusion hLM₁' (γ : L))) =
      ψ (traceLM F hLE' (- 2 * IntermediateField.inclusion hLE' (γ : L)))
    rw [h1, h2, htr_incl M₁' hLM₁' (- 2 * (γ : L)), htr_incl E' hLE' (- 2 * (γ : L)), hdegM₁']
  have hψ_αb_eq_αa : ψM₁' (- 2 * IntermediateField.inclusion hLM₁' (α : L) * b) =
      ψE' (- 2 * IntermediateField.inclusion hLE' (α : L) * a) := by
    set δ_tr : L := traceLM F hLM₁' b - traceLM F hLE' a
    have hα_δ_bound : (α : L) * δ_tr = 0 ∨ -condExpChar F L ψ ≤ valL F L ((α : L) * δ_tr) := by
      rcases hTrNormCongr with h0 | hle
      · left
        have hδ0 : δ_tr = 0 := h0
        rw [hδ0, mul_zero]
      · by_cases hδ0 : δ_tr = 0
        · left
          rw [hδ0, mul_zero]
        · right
          rw [hval_mul (α : L) δ_tr (Units.ne_zero α) hδ0, hα_val]
          have hle' : (bE' : ℤ) ≤ valL F L δ_tr := hle
          omega
    have hψ_α_δ : ψ ((α : L) * δ_tr) = 1 := hψ_triv ((α : L) * δ_tr) hα_δ_bound
    have hψ_neg2_α_δ : ψ (- 2 * (α : L) * δ_tr) = 1 := by
      have hring : (- 2 * (α : L) * δ_tr : L) = - ((α : L) * δ_tr + (α : L) * δ_tr) := by ring
      rw [hring, AddChar.map_neg_eq_inv, AddChar.map_add_eq_mul, hψ_α_δ, mul_one, inv_one]
    have h1 : (- 2 * IntermediateField.inclusion hLM₁' (α : L) * b : M₁') =
        IntermediateField.inclusion hLM₁' (- 2 * (α : L)) * b := by
      rw [map_mul, map_neg, map_ofNat]
    have h2 : (- 2 * IntermediateField.inclusion hLE' (α : L) * a : E') =
        IntermediateField.inclusion hLE' (- 2 * (α : L)) * a := by
      rw [map_mul, map_neg, map_ofNat]
    change ψ (traceLM F hLM₁' (- 2 * IntermediateField.inclusion hLM₁' (α : L) * b)) =
      ψ (traceLM F hLE' (- 2 * IntermediateField.inclusion hLE' (α : L) * a))
    rw [h1, h2, htr_smul M₁' hLM₁' (- 2 * (α : L)) b, htr_smul E' hLE' (- 2 * (α : L)) a]
    have hdecomp : - 2 * (α : L) * traceLM F hLM₁' b =
        - 2 * (α : L) * δ_tr + (- 2 * (α : L) * traceLM F hLE' a) := by
      dsimp [δ_tr]
      ring
    rw [hdecomp, AddChar.map_add_eq_mul, hψ_neg2_α_δ, one_mul]
  set P_γa' : Ω F := ψE' (- 2 * IntermediateField.inclusion hLE' (γ : L)) *
    ψE' (- 2 * IntermediateField.inclusion hLE' (α : L) * a)
  set P_w₂ : Ω F := ψE' (2 * IntermediateField.inclusion hLE' (α : L) * (w₂ : E'))
  set P_w₁ : Ω F := ψM₁' (- 2 * IntermediateField.inclusion hLM₁' (β : L) * (w₁ : M₁'))
  have hψE'_exp : ψE' (((cE'⁻¹ : E'ˣ) : E') * 2) = P_γa' * P_w₂ := by
    have hcE'_inv : ((cE'⁻¹ : E'ˣ) : E') = - (C₂ : E') := by
      rw [hcE'_eq, inv_inv, Units.val_neg]
    have hring : (- (C₂ : E')) * 2 =
        ((- 2 * IntermediateField.inclusion hLE' (γ : L)) +
          (- 2 * IntermediateField.inclusion hLE' (α : L) * a)) +
        (2 * IntermediateField.inclusion hLE' (α : L) * (w₂ : E')) := by
      rw [hC₂_eq]
      ring
    rw [hcE'_inv, hring, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul]
  have hψM₁'_exp : ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * 2) = P_γa' * P_w₁⁻¹ := by
    have hcM₁'_inv : ((cM₁'⁻¹ : M₁'ˣ) : M₁') = - (C₁ : M₁') := by
      rw [hcM₁'_eq, inv_inv, Units.val_neg]
    have hring : (- (C₁ : M₁')) * 2 =
        ((- 2 * IntermediateField.inclusion hLM₁' (γ : L)) +
          (- 2 * IntermediateField.inclusion hLM₁' (α : L) * b)) +
        (- (- 2 * IntermediateField.inclusion hLM₁' (β : L) * (w₁ : M₁'))) := by
      rw [hC₁_eq, hA₁_eq]
      ring
    rw [hcM₁'_inv, hring, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul,
      AddChar.map_neg_eq_inv, hψ_γ, hψ_αb_eq_αa]
  have hPw₁_inv : P_w₁ * P_w₁⁻¹ = 1 := by
    dsimp [P_w₁]
    rw [← AddChar.map_neg_eq_inv, ← AddChar.map_add_eq_mul, add_neg_cancel,
      AddChar.map_zero_eq_one]
  set X₁ : Ω F := (χ₁ A₁ : Ω F) ^ 2
  set X₂ : Ω F := (χ₂ C₂ : Ω F) ^ 2
  set L₁ : Ω F := (lam_L (Units.map (normLM F hLM₁') A₁) : Ω F) ^ 2
  set L₂ : Ω F := (lam_L (Units.map (normLM F hLE') C₂) : Ω F) ^ 2
  set Td : Ω F := (θ₁ (C₁ * A₁⁻¹) : Ω F) ^ 2
  have hu_sq_inv : ∀ u : (Ω F)ˣ, (u : Ω F) ^ 2 * ((u : Ω F) ^ 2)⁻¹ = 1 := by
    intro u
    have h := Units.mul_inv (u ^ 2)
    rw [Units.val_inv_eq_inv_val, Units.val_pow_eq_pow_val] at h
    exact h
  have hX₁_inv : X₁ * X₁⁻¹ = 1 := hu_sq_inv (χ₁ A₁)
  have hL₁_inv : L₁ * L₁⁻¹ = 1 := hu_sq_inv (lam_L (Units.map (normLM F hLM₁') A₁))
  have hTd_inv : Td * Td⁻¹ = 1 := hu_sq_inv (θ₁ (C₁ * A₁⁻¹))
  have hθ₂_cE'_sq : (θ₂ cE' : Ω F) ^ 2 = X₂⁻¹ * L₂⁻¹ := by
    have hcE'_sq : cE' ^ 2 = (C₂ ^ 2)⁻¹ := by
      rw [hcE'_eq, inv_pow, neg_sq]
    have hθ₂_C₂ : (θ₂ C₂ : Ω F) =
        (χ₂ C₂ : Ω F) * (lam_L (Units.map (normLM F hLE') C₂) : Ω F) := by
      rw [hθ₂_eq, MonoidHom.mul_apply, Units.val_mul, MonoidHom.comp_apply]
    calc (θ₂ cE' : Ω F) ^ 2
        = ((θ₂ (cE' ^ 2) : (Ω F)ˣ) : Ω F) := by rw [← Units.val_pow_eq_pow_val, map_pow]
      _ = ((θ₂ ((C₂ ^ 2)⁻¹) : (Ω F)ˣ) : Ω F) := by rw [hcE'_sq]
      _ = ((θ₂ C₂ : Ω F) ^ 2)⁻¹ := by
          rw [map_inv, map_pow, Units.val_inv_eq_inv_val, Units.val_pow_eq_pow_val]
      _ = (X₂ * L₂)⁻¹ := by
          dsimp [X₂, L₂]
          rw [hθ₂_C₂, mul_pow]
      _ = X₂⁻¹ * L₂⁻¹ := by rw [mul_inv_rev, mul_comm]
  have hθ₁_cM₁'_sq : (θ₁ cM₁' : Ω F) ^ 2 = X₁⁻¹ * L₁⁻¹ * Td⁻¹ := by
    have hcM₁'_sq : cM₁' ^ 2 = (C₁ ^ 2)⁻¹ := by
      rw [hcM₁'_eq, inv_pow, neg_sq]
    have hC₁_prod : C₁ = A₁ * (C₁ * A₁⁻¹) := by
      rw [mul_comm C₁ A₁⁻¹, mul_inv_cancel_left]
    have hθ₁_A₁ : (θ₁ A₁ : Ω F) =
        (χ₁ A₁ : Ω F) * (lam_L (Units.map (normLM F hLM₁') A₁) : Ω F) := by
      rw [hθ₁_eq, MonoidHom.mul_apply, Units.val_mul, MonoidHom.comp_apply]
    have hθ₁_C₁_sq : (θ₁ C₁ : Ω F) ^ 2 = X₁ * L₁ * Td := by
      conv_lhs => rw [hC₁_prod, map_mul, Units.val_mul, mul_pow, hθ₁_A₁, mul_pow]
    calc (θ₁ cM₁' : Ω F) ^ 2
        = ((θ₁ (cM₁' ^ 2) : (Ω F)ˣ) : Ω F) := by rw [← Units.val_pow_eq_pow_val, map_pow]
      _ = ((θ₁ ((C₁ ^ 2)⁻¹) : (Ω F)ˣ) : Ω F) := by rw [hcM₁'_sq]
      _ = ((θ₁ C₁ : Ω F) ^ 2)⁻¹ := by
          rw [map_inv, map_pow, Units.val_inv_eq_inv_val, Units.val_pow_eq_pow_val]
      _ = (X₁ * L₁ * Td)⁻¹ := by rw [hθ₁_C₁_sq]
      _ = X₁⁻¹ * L₁⁻¹ * Td⁻¹ := by
          rw [mul_inv_rev, mul_inv_rev]
          ring
  have hlam_quot_sq :
      (lam_L (Units.map (normLM F hLM₁') A₁ * (Units.map (normLM F hLE') C₂)⁻¹) : Ω F) ^ 2 =
        L₁ * L₂⁻¹ := by
    rw [map_mul, map_inv, Units.val_mul, Units.val_inv_eq_inv_val, mul_pow, inv_pow]
  set B : Ω F :=
    X₁ * X₂⁻¹ *
      (lam_L (Units.map (normLM F hLM₁') A₁ * (Units.map (normLM F hLE') C₂)⁻¹) : Ω F) ^ 2 *
      (P_w₁ * Td) * P_w₂
  have hB_sq : B ^ 2 = 1 := hFourFactor
  set S₂ : Ω F := (θ₂ cE' : Ω F) ^ 2 * ψE' (((cE'⁻¹ : E'ˣ) : E') * 2)
  set S₁ : Ω F := (θ₁ cM₁' : Ω F) ^ 2 * ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * 2)
  have hS_eq : S₁ * B = S₂ := by
    dsimp [S₁, S₂, B]
    rw [hθ₁_cM₁'_sq, hψM₁'_exp, hθ₂_cE'_sq, hψE'_exp, hlam_quot_sq]
    calc (X₁⁻¹ * L₁⁻¹ * Td⁻¹ * (P_γa' * P_w₁⁻¹)) *
          (X₁ * X₂⁻¹ * (L₁ * L₂⁻¹) * (P_w₁ * Td) * P_w₂)
        = (X₂⁻¹ * L₂⁻¹ * (P_γa' * P_w₂)) *
            (X₁ * X₁⁻¹) * (L₁ * L₁⁻¹) * (Td * Td⁻¹) * (P_w₁ * P_w₁⁻¹) := by ring
      _ = (X₂⁻¹ * L₂⁻¹ * (P_γa' * P_w₂)) * 1 * 1 * 1 * 1 := by
          rw [hX₁_inv, hL₁_inv, hTd_inv, hPw₁_inv]
      _ = X₂⁻¹ * L₂⁻¹ * (P_γa' * P_w₂) := by ring
  have hS_sq : S₂ ^ 2 = S₁ ^ 2 := by
    rw [← hS_eq, mul_pow, hB_sq, mul_one]
  have hS₂_pow : S₂ ^ 2 = (θ₂ cE' : Ω F) ^ 4 * (ψE' (((cE'⁻¹ : E'ˣ) : E') * 2)) ^ 2 := by
    dsimp [S₂]
    rw [mul_pow, ← pow_mul]
  have hS₁_pow : S₁ ^ 2 = (θ₁ cM₁' : Ω F) ^ 4 * (ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * 2)) ^ 2 := by
    dsimp [S₁]
    rw [mul_pow, ← pow_mul]
  rw [← hS₂_pow, ← hS₁_pow]
  exact hS_sq

theorem ld_ch12_wild_odd_totally_ramified_higher_cond_branch_pullback (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L A : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F A] (hLA : L ≤ A)
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (hdegLA : Module.finrank L (IntermediateField.extendScalars hLA) = p)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψA : IsAdmissibleChar F A (traceChar F hLA ψ))
    (bE' b_A t₁ a_lam q_χA : ℕ)
    (hbA_ge2 : 2 ≤ b_A) (hbA_le_bE' : b_A ≤ bE') (ht₁_lt_bA : t₁ < b_A)
    (hbE'_lt_lam : bE' < a_lam) (hpm_gt_t₁ : t₁ < p * (a_lam - bE'))
    (hq_χA_le : q_χA ≤ (b_A + p * (a_lam - b_A) + p - 1) / p)
    (θ_A χ_A : Aˣ →* (Ω F)ˣ) (lam_L : Lˣ →* (Ω F)ˣ)
    (hθA_eq : θ_A = χ_A * lam_L.comp (Units.map (normLM F hLA)))
    (hmA_eq : condExp F A θ_A = b_A + p * (a_lam - b_A))
    (hnA_eq : condExpChar F A (traceChar F hLA ψ) =
      (p : ℤ) * condExpChar F L ψ + ((p - 1 : ℕ) : ℤ) * (b_A : ℤ))
    (hval_LA : ∀ x : L,
      valL F A (IntermediateField.inclusion hLA x) = (p : ℤ) * valL F L x)
    (hval_norm_LA : ∀ z : A, valL F L (normLM F hLA z) = valL F A z)
    (htr_LA : ∀ (m : ℤ) (z : A),
      (z = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (b_A : ℤ) ≤ valL F A z) →
      (traceLM F hLA z = 0 ∨ m ≤ valL F L (traceLM F hLA z)))
    (d_A : A) (α β_A γ : Lˣ) (w_A : Aˣ)
    (hdA_val : valL F A d_A = -(t₁ : ℤ))
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (hβA_val : valL F L (β_A : L) = -(b_A : ℤ) - condExpChar F L ψ)
    (hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ)
    (hwA_val : valL F A (w_A : A) = -((a_lam - b_A : ℕ) : ℤ))
    (hwA_norm : Units.map (normLM F hLA) w_A = γ * β_A⁻¹)
    (P_L : L → L) (P_A : A → A)
    (hPA_val : ∀ (r : ℕ), 1 ≤ r → ∀ z : A, (z = 0 ∨ (r : ℤ) ≤ valL F A z) →
      P_A z = 0 ∨ (r : ℤ) ≤ valL F A (P_A z))
    (hPL_inv : ∀ (r : ℕ), 1 ≤ r → ∀ u : L, (u = 0 ∨ 1 ≤ valL F L u) →
      (P_L u = 0 ∨ (r : ℤ) ≤ valL F L (P_L u)) →
      (u = 0 ∨ (r : ℤ) ≤ valL F L u))
    (hPA_quad : ∀ (m_A : ℕ), 2 ≤ m_A →
      let d := m_A / 2
      ∀ z : A, (z = 0 ∨ (d : ℤ) ≤ valL F A z) →
        - 2 * P_A (-z) - (2 * z - z ^ 2) = 0 ∨
          (m_A : ℤ) ≤ valL F A (- 2 * P_A (-z) - (2 * z - z ^ 2)))
    (hlam_log :
      let q_lam := (a_lam + p - 1) / p
      ∀ u : L, (u = 0 ∨ (q_lam : ℤ) ≤ valL F L u) →
        ∀ hu : 1 - u ≠ 0,
          (lam_L (Units.mk0 (1 - u) hu) : Ω F) ^ 2 = ψ (2 * (γ : L) * P_L u))
    (hχA_log :
      ∀ z : A, (z = 0 ∨ (q_χA : ℤ) ≤ valL F A z) →
        ∀ hz : 1 - z ≠ 0,
          (χ_A (Units.mk0 (1 - z) hz) : Ω F) ^ 2 =
            (traceChar F hLA ψ) (2 * IntermediateField.inclusion hLA (α : L) * d_A * P_A z))
    (hConv_A :
      let q₀ := (b_A + p - 1) / p
      ∀ z : A, (z = 0 ∨ (q₀ : ℤ) ≤ valL F A z) →
        (traceChar F hLA ψ) (2 * IntermediateField.inclusion hLA (β_A : L) * z) =
          ψ (- 2 * (β_A : L) * normLM F hLA z))
    (hNormLog_A :
      let q₀ := (b_A + p - 1) / p
      ∀ (h : ℕ) (z : A), (z = 0 ∨ ((q₀ + h : ℕ) : ℤ) ≤ valL F A z) →
        let u_z := 1 - normLM F hLA (1 - z)
        (u_z = 0 ∨ (q₀ : ℤ) ≤ valL F L u_z) ∧
        (P_L u_z - (traceLM F hLA (P_A z) + normLM F hLA (P_A z)) = 0 ∨
          ((b_A + h : ℕ) : ℤ) ≤
            valL F L (P_L u_z - (traceLM F hLA (P_A z) + normLM F hLA (P_A z))))) :
    let m_A := b_A + p * (a_lam - b_A)
    let q_θA := (m_A + p - 1) / p
    let ψ_A := traceChar F hLA ψ
    ∃ (A_A C_A c_A : Aˣ),
      (A_A : A) = IntermediateField.inclusion hLA (γ : L) +
        IntermediateField.inclusion hLA (α : L) * d_A ∧
      (C_A : A) = (A_A : A) -
        IntermediateField.inclusion hLA (β_A : L) * (w_A : A) ∧
      c_A = (-C_A)⁻¹ ∧
      valL F A (c_A : A) = (condExp F A θ_A : ℤ) + condExpChar F A ψ_A ∧
      (∀ z : A, (z = 0 ∨ (q_θA : ℤ) ≤ valL F A z) →
        ∀ hz : 1 - z ≠ 0,
          (θ_A (Units.mk0 (1 - z) hz) : Ω F) ^ 2 =
            ψ_A (2 * (C_A : A) * P_A z)) ∧
      (∀ z : A, (z = 0 ∨ ((condExp F A θ_A / 2 : ℕ) : ℤ) ≤ valL F A z) →
        ∀ hz : 1 + z ≠ 0,
          (θ_A (Units.mk0 (1 + z) hz) : Ω F) ^ 2 =
            ψ_A (((c_A⁻¹ : Aˣ) : A) * (2 * z - z ^ 2))) :=
by
  intro m_A q_θA ψ_A
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have hp_sub1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have hbA_lt_lam : b_A < a_lam := lt_of_le_of_lt hbA_le_bE' hbE'_lt_lam
  have hhA_cast : ((a_lam - b_A : ℕ) : ℤ) = (a_lam : ℤ) - (b_A : ℤ) := by omega
  have hmA_def : m_A = b_A + p * (a_lam - b_A) := rfl
  have hmA_cast : (m_A : ℤ) = (b_A : ℤ) + (p : ℤ) * ((a_lam : ℤ) - (b_A : ℤ)) := by
    rw [hmA_def, Nat.cast_add, Nat.cast_mul, hhA_cast]

  
  have hvalL := ld_valL_and_unitGroup_props F L
  have hvalA := ld_valL_and_unitGroup_props F A
  have hψ_triv := (ld_condExp_and_condExpChar_spec F L ψ hψ lam_L).1
  have hψA_triv := (ld_condExp_and_condExpChar_spec F A ψ_A hψA θ_A).1

  have hval_mul_bound : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (k₁ k₂ : ℤ) (x y : M),
      (x = 0 ∨ k₁ ≤ valL F M x) → (y = 0 ∨ k₂ ≤ valL F M y) →
      (x * y = 0 ∨ k₁ + k₂ ≤ valL F M (x * y)) := by
    intro M _ k₁ k₂ x y hx hy
    have hM := ld_valL_and_unitGroup_props F M
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hM.2.2.2.2.1 x y hx0 hy0]
        exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
  have hval_natCast : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (n : ℕ), ((n : ℕ) : M) = 0 ∨ (0 : ℤ) ≤ valL F M ((n : ℕ) : M) := by
    intro M _ n
    have hM := ld_valL_and_unitGroup_props F M
    induction n with
    | zero => left; exact Nat.cast_zero
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hM.2.2.2.2.2.2.2.1 0 (n : M) 1 ih (Or.inr (by rw [hM.2.1]))
  have hvalA_add_lt : ∀ (x y : A), x ≠ 0 → (y = 0 ∨ valL F A x < valL F A y) →
      x + y ≠ 0 ∧ valL F A (x + y) = valL F A x := by
    intro x y hx hy
    rcases hy with rfl | hlt
    · rw [add_zero]; exact ⟨hx, rfl⟩
    · have hge := hvalA.2.2.2.2.2.2.2.1 (valL F A x) x y (Or.inr le_rfl) (Or.inr (le_of_lt hlt))
      have hxy_ne : x + y ≠ 0 := by
        intro h0
        have hy_eq : y = -x := eq_neg_of_add_eq_zero_right h0
        have hval_eq : valL F A y = valL F A x := by rw [hy_eq, hvalA.2.2.2.1]
        omega
      have hxy_ge : valL F A x ≤ valL F A (x + y) := hge.resolve_left hxy_ne
      let k := min (valL F A (x + y)) (valL F A y)
      have hk_x : x = 0 ∨ k ≤ valL F A x := by
        rw [← add_neg_cancel_right x y]
        exact hvalA.2.2.2.2.2.2.2.1 k (x + y) (-y)
          (Or.inr (min_le_left _ _))
          (Or.inr (by rw [hvalA.2.2.2.1]; exact min_le_right _ _))
      have hk_le : k ≤ valL F A x := hk_x.resolve_left hx
      refine ⟨hxy_ne, ?_⟩
      rcases min_cases (valL F A (x + y)) (valL F A y) with ⟨hmin, _⟩ | ⟨hmin, _⟩ <;> omega

  let T_γ : A := IntermediateField.inclusion hLA (γ : L)
  let T_d : A := IntermediateField.inclusion hLA (α : L) * d_A
  let T_w : A := -(IntermediateField.inclusion hLA (β_A : L) * (w_A : A))
  have hTγ_ne : T_γ ≠ 0 := (map_ne_zero (IntermediateField.inclusion hLA)).mpr (Units.ne_zero γ)
  have hTγ_val : valL F A T_γ = (p : ℤ) * (-(a_lam : ℤ) - condExpChar F L ψ) := by
    dsimp only [T_γ]
    rw [hval_LA (γ : L), hγ_val]
  have hTγ_val_mA : valL F A T_γ = -(m_A : ℤ) - condExpChar F A ψ_A := by
    rw [hTγ_val, hmA_cast]
    change (p : ℤ) * (-(a_lam : ℤ) - condExpChar F L ψ) =
      -((b_A : ℤ) + (p : ℤ) * ((a_lam : ℤ) - (b_A : ℤ))) -
        condExpChar F A (traceChar F hLA ψ)
    rw [hnA_eq, hp_sub1_cast]
    ring
  have hTd_lt : T_d = 0 ∨ valL F A T_γ < valL F A T_d := by
    by_cases hd0 : d_A = 0
    · left; dsimp only [T_d]; rw [hd0, mul_zero]
    · right
      dsimp only [T_d]
      have hα_ne : IntermediateField.inclusion hLA (α : L) ≠ 0 :=
        (map_ne_zero (IntermediateField.inclusion hLA)).mpr (Units.ne_zero α)
      rw [hvalA.2.2.2.2.1 _ _ hα_ne hd0, hval_LA (α : L), hα_val, hdA_val, hTγ_val]
      have hpm_Z : (t₁ : ℤ) < (p : ℤ) * ((a_lam : ℤ) - (bE' : ℤ)) := by
        have hsub : ((a_lam - bE' : ℕ) : ℤ) = (a_lam : ℤ) - (bE' : ℤ) := by omega
        have hlt_Z : (t₁ : ℤ) < ((p * (a_lam - bE') : ℕ) : ℤ) := by exact_mod_cast hpm_gt_t₁
        rw [Nat.cast_mul, hsub] at hlt_Z
        exact hlt_Z
      linarith
  obtain ⟨hA_ne, hA_val⟩ := hvalA_add_lt T_γ T_d hTγ_ne hTd_lt
  have hTw_lt : T_w = 0 ∨ valL F A (T_γ + T_d) < valL F A T_w := by
    right
    rw [hA_val, hTγ_val]
    dsimp only [T_w]
    have hβ_ne : IntermediateField.inclusion hLA (β_A : L) ≠ 0 :=
      (map_ne_zero (IntermediateField.inclusion hLA)).mpr (Units.ne_zero β_A)
    rw [hvalA.2.2.2.1, hvalA.2.2.2.2.1 _ _ hβ_ne (Units.ne_zero w_A),
      hval_LA (β_A : L), hβA_val, hwA_val, hhA_cast]
    have : (3 : ℤ) ≤ p ∧ (b_A : ℤ) < a_lam := by omega
    nlinarith
  obtain ⟨hC_ne', hC_val'⟩ := hvalA_add_lt (T_γ + T_d) T_w hA_ne hTw_lt
  have hC_eq_add : (T_γ + T_d) - IntermediateField.inclusion hLA (β_A : L) * (w_A : A) =
      (T_γ + T_d) + T_w := sub_eq_add_neg _ _
  have hC_ne : (T_γ + T_d) - IntermediateField.inclusion hLA (β_A : L) * (w_A : A) ≠ 0 := by
    rw [hC_eq_add]; exact hC_ne'
  let A_A : Aˣ := Units.mk0 (T_γ + T_d) hA_ne
  let C_A : Aˣ := Units.mk0 ((A_A : A) - IntermediateField.inclusion hLA (β_A : L) * (w_A : A)) hC_ne
  let c_A : Aˣ := (-C_A)⁻¹
  have hC_coe : (C_A : A) = (T_γ + T_d) - IntermediateField.inclusion hLA (β_A : L) * (w_A : A) := rfl
  have hC_val : valL F A (C_A : A) = -(m_A : ℤ) - condExpChar F A ψ_A := by
    rw [hC_coe, hC_eq_add, hC_val', hA_val, hTγ_val_mA]
  have hcA_val : valL F A (c_A : A) = (condExp F A θ_A : ℤ) + condExpChar F A ψ_A := by
    dsimp only [c_A]
    rw [hvalA.2.2.2.2.2.1 (-C_A), Units.val_neg, hvalA.2.2.2.1, hC_val, hmA_eq]
    change -(- (m_A : ℤ) - condExpChar F A ψ_A) = (m_A : ℤ) + condExpChar F A ψ_A
    ring

  
  have htrace_smul : ∀ (x : L) (y : A),
      traceLM F hLA (IntermediateField.inclusion hLA x * y) = x * traceLM F hLA y := by
    letI : Module L L := Semiring.toModule
    exact fun x y => (Algebra.trace L (IntermediateField.extendScalars hLA)).map_smul' x (toExtendScalars F hLA y)
  have hnorm_incl : ∀ x : L,
      normLM F hLA (IntermediateField.inclusion hLA x) = x ^ p := by
    intro x
    change Algebra.norm L (toExtendScalars F hLA (IntermediateField.inclusion hLA x)) = x ^ p
    rw [show toExtendScalars F hLA (IntermediateField.inclusion hLA x) =
      algebraMap L (IntermediateField.extendScalars hLA) x from rfl,
      Algebra.norm_algebraMap, hdegLA]
  have hnorm_zero : normLM F hLA (0 : A) = 0 := by
    have h0 : (0 : A) = IntermediateField.inclusion hLA (0 : L) := (map_zero _).symm
    rw [h0, hnorm_incl, zero_pow hp_pos.ne']
  have hnorm_neg_one : normLM F hLA (-1 : A) = -1 := by
    have h1 : (-1 : A) = IntermediateField.inclusion hLA (-1 : L) := by simp
    rw [h1, hnorm_incl, (hPrime.odd_of_ne_two hp_odd).neg_one_pow]
  have hnorm_neg : ∀ y : A, normLM F hLA (-y) = - normLM F hLA y := by
    intro y
    rw [neg_eq_neg_one_mul y, map_mul, hnorm_neg_one, neg_one_mul]
  have hwA_norm_mul : normLM F hLA (w_A : A) * (β_A : L) = (γ : L) := by
    have h : ((Units.map (normLM F hLA) w_A * β_A : Lˣ) : L) = (γ : L) := by
      rw [hwA_norm, inv_mul_cancel_right]
    exact h

  let q₀ : ℕ := (b_A + p - 1) / p
  let h_A : ℕ := a_lam - b_A
  let q_lam : ℕ := (a_lam + p - 1) / p
  have hq_θA_eq : q_θA = q₀ + h_A := by
    change (b_A + p * h_A + p - 1) / p = (b_A + p - 1) / p + h_A
    have heq : b_A + p * h_A + p - 1 = (b_A + p - 1) + p * h_A := by omega
    rw [heq, Nat.add_mul_div_left (b_A + p - 1) h_A hp_pos]
  have hq_θA_eq_Z : (q_θA : ℤ) = (q₀ : ℤ) + (h_A : ℤ) := by
    rw [hq_θA_eq, Nat.cast_add]
  have hq_χA_le_Z : (q_χA : ℤ) ≤ (q_θA : ℤ) := by exact_mod_cast hq_χA_le
  have hq₀_ge1 : 1 ≤ q₀ := Nat.div_pos (by omega) hp_pos
  have hq_lam_ge1 : 1 ≤ q_lam := Nat.div_pos (by omega) hp_pos
  have hq_θA_ge1 : 1 ≤ q_θA := by omega
  have hq_lam_le_θA : q_lam ≤ q_θA := by
    apply Nat.div_le_div_right
    have : 1 * (a_lam - b_A) ≤ p * (a_lam - b_A) :=
      Nat.mul_le_mul_right (a_lam - b_A) hp_pos
    omega
  have hq_lam_le_alam : q_lam ≤ a_lam := by
    have hlt : q_lam < a_lam + 1 := by
      rw [Nat.div_lt_iff_lt_mul hp_pos, add_mul, one_mul]
      have : a_lam * 1 ≤ a_lam * p := Nat.mul_le_mul_left a_lam hp_pos
      omega
    omega
  have htr_thresh_le :
      (p : ℤ) * (q_lam : ℤ) - ((p - 1 : ℕ) : ℤ) * (b_A : ℤ) ≤ (q_θA : ℤ) := by
    have hdiv_le : q_lam * p ≤ a_lam + p - 1 := Nat.div_mul_le_self (a_lam + p - 1) p
    have hdiv_Z : (q_lam : ℤ) * (p : ℤ) ≤ (a_lam : ℤ) + (p : ℤ) - 1 := by
      have hcast : ((q_lam * p : ℕ) : ℤ) ≤ ((a_lam + p - 1 : ℕ) : ℤ) := by exact_mod_cast hdiv_le
      omega
    rw [hp_sub1_cast]
    have : (3 : ℤ) ≤ p ∧ (2 : ℤ) ≤ b_A ∧ (h_A : ℤ) = (a_lam : ℤ) - (b_A : ℤ) ∧
      (h_A : ℤ) ≤ (q_θA : ℤ) := by omega
    nlinarith

  have hθA_log : ∀ z : A, (z = 0 ∨ (q_θA : ℤ) ≤ valL F A z) →
      ∀ hz : 1 - z ≠ 0,
        (θ_A (Units.mk0 (1 - z) hz) : Ω F) ^ 2 =
          ψ_A (2 * (C_A : A) * P_A z) := by
    intro z hz_val hz
    have hPAz : P_A z = 0 ∨ (q_θA : ℤ) ≤ valL F A (P_A z) :=
      hPA_val q_θA hq_θA_ge1 z hz_val
    have hnorm_PAz : normLM F hLA (P_A z) = 0 ∨
        (q_lam : ℤ) ≤ valL F L (normLM F hLA (P_A z)) := by
      rcases hPAz with h0 | hge
      · left; rw [h0, hnorm_zero]
      · right; rw [hval_norm_LA]; omega
    have htr_PAz : traceLM F hLA (P_A z) = 0 ∨
        (q_lam : ℤ) ≤ valL F L (traceLM F hLA (P_A z)) := by
      apply htr_LA (q_lam : ℤ) (P_A z)
      rcases hPAz with h0 | hge
      · left; exact h0
      · right; exact htr_thresh_le.trans hge
    have htr_plus_norm :
        traceLM F hLA (P_A z) + normLM F hLA (P_A z) = 0 ∨
          (q_lam : ℤ) ≤ valL F L (traceLM F hLA (P_A z) + normLM F hLA (P_A z)) :=
      hvalL.2.2.2.2.2.2.2.1 (q_lam : ℤ) _ _ htr_PAz hnorm_PAz
    have hz_q0h : z = 0 ∨ ((q₀ + h_A : ℕ) : ℤ) ≤ valL F A z := by
      rw [← hq_θA_eq]; exact hz_val
    obtain ⟨huz_q0, hrem_norm⟩ := hNormLog_A h_A z hz_q0h
    let u_z : L := 1 - normLM F hLA (1 - z)
    let rem_norm : L := P_L u_z - (traceLM F hLA (P_A z) + normLM F hLA (P_A z))
    have hbA_add_hA : b_A + h_A = a_lam := by omega
    have hrem_alam : rem_norm = 0 ∨ (a_lam : ℤ) ≤ valL F L rem_norm := by
      change P_L u_z - (traceLM F hLA (P_A z) + normLM F hLA (P_A z)) = 0 ∨ _
      rw [← hbA_add_hA]
      exact hrem_norm
    have hrem_qlam : rem_norm = 0 ∨ (q_lam : ℤ) ≤ valL F L rem_norm := by
      rcases hrem_alam with h0 | hge
      · left; exact h0
      · right; omega
    have hPL_uz : P_L u_z = 0 ∨ (q_lam : ℤ) ≤ valL F L (P_L u_z) := by
      have heq : P_L u_z = rem_norm + (traceLM F hLA (P_A z) + normLM F hLA (P_A z)) := by
        dsimp only [rem_norm]; ring
      rw [heq]
      exact hvalL.2.2.2.2.2.2.2.1 (q_lam : ℤ) _ _ hrem_qlam htr_plus_norm
    have huz_ge1 : u_z = 0 ∨ 1 ≤ valL F L u_z := by
      rcases huz_q0 with h0 | hge
      · left; exact h0
      · right
        have hq0_Z : (1 : ℤ) ≤ (q₀ : ℤ) := by exact_mod_cast hq₀_ge1
        exact hq0_Z.trans hge
    have huz_qlam : u_z = 0 ∨ (q_lam : ℤ) ≤ valL F L u_z :=
      hPL_inv q_lam hq_lam_ge1 u_z huz_ge1 hPL_uz
    let u_1mz : Aˣ := Units.mk0 (1 - z) hz
    have h1muz_eq : 1 - u_z = ((Units.map (normLM F hLA) u_1mz : Lˣ) : L) := by
      dsimp only [u_z, u_1mz]
      change 1 - (1 - normLM F hLA (1 - z)) = normLM F hLA (1 - z)
      ring
    have h1muz_ne : 1 - u_z ≠ 0 := by
      rw [h1muz_eq]
      exact Units.ne_zero _
    have hunit_eq : Units.mk0 (1 - u_z) h1muz_ne = Units.map (normLM F hLA) u_1mz :=
      Units.ext h1muz_eq
    have hlam_eval : (lam_L (Units.map (normLM F hLA) u_1mz) : Ω F) ^ 2 =
        ψ (2 * (γ : L) * P_L u_z) := by
      rw [← hunit_eq]
      exact hlam_log u_z huz_qlam h1muz_ne
    have h2γ_val : 2 * (γ : L) = 0 ∨
        (-(a_lam : ℤ) - condExpChar F L ψ) ≤ valL F L (2 * (γ : L)) := by
      rcases hval_mul_bound L 0 (-(a_lam : ℤ) - condExpChar F L ψ)
          (2 : L) (γ : L) (hval_natCast L 2) (Or.inr (by rw [hγ_val])) with h0 | hge
      · left; exact h0
      · right; linarith
    have h2γ_rem_val : 2 * (γ : L) * rem_norm = 0 ∨
        -condExpChar F L ψ ≤ valL F L (2 * (γ : L) * rem_norm) := by
      rcases hval_mul_bound L (-(a_lam : ℤ) - condExpChar F L ψ) (a_lam : ℤ)
          (2 * (γ : L)) rem_norm h2γ_val hrem_alam with h0 | hge
      · left; exact h0
      · right; linarith
    have hψ_rem : ψ (2 * (γ : L) * rem_norm) = 1 := hψ_triv _ h2γ_rem_val
    have hPL_split : 2 * (γ : L) * P_L u_z =
        2 * (γ : L) * rem_norm +
          (2 * (γ : L) * traceLM F hLA (P_A z) + 2 * (γ : L) * normLM F hLA (P_A z)) := by
      dsimp only [rem_norm]; ring
    have hψ_PL : ψ (2 * (γ : L) * P_L u_z) =
        ψ (2 * (γ : L) * traceLM F hLA (P_A z)) *
          ψ (2 * (γ : L) * normLM F hLA (P_A z)) := by
      rw [hPL_split, AddChar.map_add_eq_mul, hψ_rem, one_mul, AddChar.map_add_eq_mul]
    have hψ_tr_term : ψ (2 * (γ : L) * traceLM F hLA (P_A z)) =
        ψ_A (2 * IntermediateField.inclusion hLA (γ : L) * P_A z) := by
      have hincl2 : IntermediateField.inclusion hLA (2 * (γ : L)) =
          2 * IntermediateField.inclusion hLA (γ : L) := by
        rw [map_mul, map_ofNat]
      change ψ (2 * (γ : L) * traceLM F hLA (P_A z)) =
        ψ (traceLM F hLA (2 * IntermediateField.inclusion hLA (γ : L) * P_A z))
      rw [← hincl2, htrace_smul]
    let w_PAz : A := -(w_A : A) * P_A z
    have hw_PAz_val : w_PAz = 0 ∨ (q₀ : ℤ) ≤ valL F A w_PAz := by
      have hw_neg_val : -(w_A : A) = 0 ∨ -(h_A : ℤ) ≤ valL F A (-(w_A : A)) :=
        Or.inr (by rw [hvalA.2.2.2.1, hwA_val])
      rcases hval_mul_bound A (-(h_A : ℤ)) (q_θA : ℤ) (-(w_A : A)) (P_A z) hw_neg_val hPAz with h0 | hge
      · left; exact h0
      · right
        change (q₀ : ℤ) ≤ valL F A (-(w_A : A) * P_A z)
        linarith [hq_θA_eq_Z, hge]
    have hnorm_w_PAz : - 2 * (β_A : L) * normLM F hLA w_PAz =
        2 * (γ : L) * normLM F hLA (P_A z) := by
      dsimp only [w_PAz]
      rw [map_mul, hnorm_neg, ← hwA_norm_mul]
      ring
    have hψ_norm_term : ψ (2 * (γ : L) * normLM F hLA (P_A z)) =
        ψ_A (2 * IntermediateField.inclusion hLA (β_A : L) * w_PAz) := by
      rw [← hnorm_w_PAz, ← hConv_A w_PAz hw_PAz_val]
    have hz_qχA : z = 0 ∨ (q_χA : ℤ) ≤ valL F A z := by
      rcases hz_val with rfl | hge
      · left; rfl
      · right; exact hq_χA_le_Z.trans hge
    have hχA_eval : (χ_A u_1mz : Ω F) ^ 2 =
        ψ_A (2 * IntermediateField.inclusion hLA (α : L) * d_A * P_A z) :=
      hχA_log z hz_qχA hz
    have hθA_mul : (θ_A u_1mz : Ω F) ^ 2 =
        (χ_A u_1mz : Ω F) ^ 2 * (lam_L (Units.map (normLM F hLA) u_1mz) : Ω F) ^ 2 := by
      rw [hθA_eq]
      simp [mul_pow]
    change (θ_A u_1mz : Ω F) ^ 2 = ψ_A (2 * (C_A : A) * P_A z)
    rw [hθA_mul, hχA_eval, hlam_eval, hψ_PL, hψ_tr_term, hψ_norm_term,
      ← AddChar.map_add_eq_mul, ← AddChar.map_add_eq_mul]
    congr 1
    rw [hC_coe]
    dsimp only [T_γ, T_d, w_PAz]
    ring

  
  let d : ℕ := m_A / 2
  have hmA_ge5 : 5 ≤ m_A := by
    have : 3 * 1 ≤ p * (a_lam - b_A) := Nat.mul_le_mul hp_ge3 (by omega)
    dsimp only [m_A]
    omega
  have hq_θA_le_d : q_θA ≤ d := by
    have hlt : q_θA < d + 1 := by
      rw [Nat.div_lt_iff_lt_mul hp_pos, add_mul, one_mul]
      have hd_bounds : 2 ≤ d ∧ m_A ≤ 2 * d + 1 := by dsimp only [d]; omega
      have hdp : d * 3 ≤ d * p := Nat.mul_le_mul_left d hp_ge3
      omega
    omega
  have hcA_quad : ∀ z : A, (z = 0 ∨ ((condExp F A θ_A / 2 : ℕ) : ℤ) ≤ valL F A z) →
      ∀ hz : 1 + z ≠ 0,
        (θ_A (Units.mk0 (1 + z) hz) : Ω F) ^ 2 =
          ψ_A (((c_A⁻¹ : Aˣ) : A) * (2 * z - z ^ 2)) := by
    intro z hz_val hz
    have hz_d : z = 0 ∨ (d : ℤ) ≤ valL F A z := by
      rw [hmA_eq] at hz_val
      exact hz_val
    have hnegz_q : -z = 0 ∨ (q_θA : ℤ) ≤ valL F A (-z) := by
      rcases hz_d with rfl | hge
      · left; exact neg_zero
      · right
        rw [hvalA.2.2.2.1]
        have hqd_Z : (q_θA : ℤ) ≤ (d : ℤ) := by exact_mod_cast hq_θA_le_d
        exact hqd_Z.trans hge
    have h1m_negz : 1 - (-z) ≠ 0 := by
      rw [sub_neg_eq_add]; exact hz
    have hunit_negz : Units.mk0 (1 + z) hz = Units.mk0 (1 - (-z)) h1m_negz :=
      Units.ext (by simp)
    rw [hunit_negz, hθA_log (-z) hnegz_q h1m_negz]
    let rem_z : A := - 2 * P_A (-z) - (2 * z - z ^ 2)
    have hrem_z : rem_z = 0 ∨ (m_A : ℤ) ≤ valL F A rem_z :=
      hPA_quad m_A (by omega) z hz_d
    have hnegC_val : -(C_A : A) = 0 ∨
        (-(m_A : ℤ) - condExpChar F A ψ_A) ≤ valL F A (-(C_A : A)) :=
      Or.inr (by rw [hvalA.2.2.2.1, hC_val])
    have hnegC_rem_val : -(C_A : A) * rem_z = 0 ∨
        -condExpChar F A ψ_A ≤ valL F A (-(C_A : A) * rem_z) := by
      rcases hval_mul_bound A (-(m_A : ℤ) - condExpChar F A ψ_A) (m_A : ℤ)
          (-(C_A : A)) rem_z hnegC_val hrem_z with h0 | hge
      · left; exact h0
      · right; linarith
    have hψA_rem : ψ_A (-(C_A : A) * rem_z) = 1 := hψA_triv _ hnegC_rem_val
    have hcA_inv : ((c_A⁻¹ : Aˣ) : A) = -(C_A : A) := by
      dsimp only [c_A]
      rw [inv_inv, Units.val_neg]
    have hsplit : 2 * (C_A : A) * P_A (-z) =
        ((c_A⁻¹ : Aˣ) : A) * (2 * z - z ^ 2) + (-(C_A : A) * rem_z) := by
      rw [hcA_inv]
      dsimp only [rem_z]
      ring
    rw [hsplit, AddChar.map_add_eq_mul, hψA_rem, mul_one]

  exact ⟨A_A, C_A, c_A, rfl, rfl, rfl, hcA_val, hθA_log, hcA_quad⟩

theorem ld_ch12_wild_odd_totally_ramified_lower_jump_ceil_and_three_regimes (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let bE' := condExp F L νE'
    let bM₁' := condExp F L νM₁'
    let t₁ := bM₁' - 1
    let t₂ := bE' - 1
    (∀ (p₀ b₀ : ℕ), Nat.Prime p₀ → 2 ≤ b₀ → ¬ (p₀ ∣ (b₀ - 1)) →
      (b₀ + p₀ - 1) / p₀ = (b₀ - 1 + p₀ - 1) / p₀ ∧
      (b₀ + p₀ - 1) / p₀ ≤ (b₀ - 1 + p₀ - 1) / p₀) ∧
    (((p : ℕ) : M₁') = 0 ∨ (((p - 1) * t₂ : ℕ) : ℤ) ≤ valL F M₁' ((p : ℕ) : M₁')) ∧
    ((bM₁' < bE' ∨ ((p : ℕ) : M₁') = 0 ∨
      (((p - 1) * t₁ + 1 : ℕ) : ℤ) ≤ valL F M₁' ((p : ℕ) : M₁')) →
      ¬ (p ∣ t₁)) :=
by
  intro p bE' bM₁' t₁ t₂
  
  have hCeil : ∀ (p₀ b₀ : ℕ), Nat.Prime p₀ → 2 ≤ b₀ → ¬ (p₀ ∣ (b₀ - 1)) →
      (b₀ + p₀ - 1) / p₀ = (b₀ - 1 + p₀ - 1) / p₀ ∧
      (b₀ + p₀ - 1) / p₀ ≤ (b₀ - 1 + p₀ - 1) / p₀ := by
    intro p₀ b₀ hp₀ hb₀ hndvd
    set t₀ := b₀ - 1
    set k := t₀ / p₀
    set r := t₀ % p₀
    have hp₀_pos : 0 < p₀ := hp₀.pos
    have hr_lt : r < p₀ := Nat.mod_lt t₀ hp₀_pos
    have hr_ne0 : r ≠ 0 := fun hr0 => hndvd (Nat.dvd_iff_mod_eq_zero.mpr hr0)
    have hr_ge1 : 1 ≤ r := by omega
    have hdiv_mod : p₀ * k + r = t₀ := Nat.div_add_mod t₀ p₀
    have hb₀_eq : b₀ = t₀ + 1 := by omega
    have hpk1 : (k + 1) * p₀ = p₀ * k + p₀ := by ring
    have hpk2 : (k + 1 + 1) * p₀ = p₀ * k + p₀ + p₀ := by ring
    have h1_le : (k + 1) * p₀ ≤ b₀ + p₀ - 1 := by omega
    have h1_lt : b₀ + p₀ - 1 < (k + 1 + 1) * p₀ := by omega
    have hdiv1 : (b₀ + p₀ - 1) / p₀ = k + 1 := Nat.div_eq_of_lt_le h1_le h1_lt
    have h2_le : (k + 1) * p₀ ≤ t₀ + p₀ - 1 := by omega
    have h2_lt : t₀ + p₀ - 1 < (k + 1 + 1) * p₀ := by omega
    have hdiv2 : (t₀ + p₀ - 1) / p₀ = k + 1 := Nat.div_eq_of_lt_le h2_le h2_lt
    have heq : (b₀ + p₀ - 1) / p₀ = (b₀ - 1 + p₀ - 1) / p₀ := hdiv1.trans hdiv2.symm
    exact ⟨heq, le_of_eq heq⟩

  
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalE'_props := ld_valL_and_unitGroup_props F E'
  have hvalM₁'_props := ld_valL_and_unitGroup_props F M₁'
  have hval7 : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      valL F M 0 = 0 ∧ valL F M 1 = 0 ∧ valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) := by
    intro M _
    obtain ⟨h0, h1, hneg1, hneg, hmul, hinv, _, hadd, _, _, _⟩ :=
      ld_valL_and_unitGroup_props F M
    exact ⟨h0, h1, hneg1, hneg, hmul, hinv, hadd⟩
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨S₁, hS₁⟩ := ld_valL_mod_one_finset F L
    hvalL_props.1 hvalL_props.2.2.2.1 hvalL_props.2.2.2.2.1 hvalL_props.2.2.2.2.2.2.2.1
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨k_L, hField_kL, hFin_kL, resL, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ :=
    ld_valL_residue_field_exists F L
      hvalL_props.1 hvalL_props.2.1 hvalL_props.2.2.1 hvalL_props.2.2.2.1
      hvalL_props.2.2.2.2.1 hvalL_props.2.2.2.2.2.1 hvalL_props.2.2.2.2.2.2.2.1 S₁ hS₁
  letI : Field k_L := hField_kL
  letI : Fintype k_L := hFin_kL

  
  have hbE'_ne0 : condExp F L νE' ≠ 0 := by omega
  obtain ⟨_, _, _, _, _, hfrob_surj_E', _, _,
    ϖ_E', ϖ_L_E', hϖ_norm_E', hϖ_E', hϖ_L_E', hBasis_E'⟩ :=
    ld_wild_total_ramification_and_power_basis F L E' hLE' hPrime νE'
      hνE'_pow hνE'_ne hνE'_ker hνE'_cond hbE'_ne0 hWild
      haddVal1 haddVal_mul halg1 hvalL_props hvalE'_props
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
  obtain ⟨G_E', hGroupGE', hFinGE', act_E', t_E', w_star_E', hcard_GE', hactE'_one, hactE'_mul, hactE'_ring,
    hactE'_incl, _, hactE'_val, hactE'_trace, hactE'_norm,
    htE'_ge1, hw_star_E'_t, hw_star_E'_nt1, hw_star_E'_norm, hjump_E'_raw⟩ :=
    ld_wild_galois_aut_and_ramification_jump F L E' hLE' hGalLE' hPrime hWild
      haddVal1 halg1 hvalL_props hvalE'_props hval_norm_LE' hval_LE' ϖ_E' hϖ_E' hBasis_E'
  letI : Group G_E' := hGroupGE'
  letI : Fintype G_E' := hFinGE'
  obtain ⟨htr_bound_E'_raw, htr_surj_E'⟩ :=
    ld_wild_euler_lagrange_trace_formula F L E' hLE' hPrime
      hvalL_props hvalE'_props hval_LE' ϖ_E' hϖ_E' hBasis_E'
      G_E' act_E' hcard_GE' hactE'_one hactE'_mul hactE'_ring hactE'_incl hactE'_trace t_E' hjump_E'_raw
  have hnorm_exp_E' :=
    ld_wild_free_orbit_norm_expansion F L E' hLE' hPrime hvalE'_props
      G_E' act_E' hcard_GE' hactE'_one hactE'_mul hactE'_ring hactE'_val hactE'_trace hactE'_norm
  obtain ⟨hbE'_eq, _, _, _, _, _⟩ :=
    ld_wild_herbrand_unit_norm_filtration_and_jump_eq F L E' hLE' hPrime νE'
      hνE'_ker hνE'_cond hvalL_props hvalE'_props hval_norm_LE' hval_LE' hfrob_surj_E'
      ϖ_E' ϖ_L_E' hϖ_norm_E' hϖ_E' hϖ_L_E' hBasis_E'
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      t_E' w_star_E' htE'_ge1 hw_star_E'_t hw_star_E'_nt1 hw_star_E'_norm htr_bound_E'_raw htr_surj_E' hnorm_exp_E'
  have htE'_eq : t_E' = t₂ := by omega
  have ht₂_ge1 : 1 ≤ t₂ := by omega
  have hjump_E' : ∀ τ : G_E', τ ≠ 1 →
      (ϖ_E' : E') - act_E' τ (ϖ_E' : E') ≠ 0 ∧
      valL F E' ((ϖ_E' : E') - act_E' τ (ϖ_E' : E')) = (t₂ + 1 : ℤ) := by
    rw [← htE'_eq]
    exact hjump_E'_raw
  obtain ⟨y₁_E', hy₁E'_tr, _, hy₁E'_spec⟩ := htr_surj_E' (1 : L)
  obtain ⟨hy₁E'_ne0, hy₁E'_val_raw⟩ := hy₁E'_spec one_ne_zero
  have hy₁E'_val : valL F E' y₁_E' = -(((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) := by
    rw [hy₁E'_val_raw, hvalL_props.2.1, mul_zero, zero_add, htE'_eq]
    ring
  have hp_valE' : ((p : ℕ) : E') = 0 ∨ (((p - 1) * t₂ : ℕ) : ℤ) ≤ valL F E' ((p : ℕ) : E') :=
    (ld_wild_tot_ram_const_free_jump_shift_and_telescoping F L E' hLE' p hPrime t₂ ht₂_ge1
      (hval7 L) (hval7 E') hval_LE' ϖ_E' G_E' act_E' y₁_E'
      hϖ_E' hBasis_E' hcard_GE' hactE'_one hactE'_mul hactE'_ring
      hactE'_incl hactE'_val hactE'_trace hjump_E'
      hy₁E'_tr hy₁E'_ne0 hy₁E'_val).1
  have hincl_LE'_p : IntermediateField.inclusion hLE' ((p : ℕ) : L) = ((p : ℕ) : E') :=
    map_natCast (IntermediateField.inclusion hLE') p
  have hincl_LM₁'_p : IntermediateField.inclusion hLM₁' ((p : ℕ) : L) = ((p : ℕ) : M₁') :=
    map_natCast (IntermediateField.inclusion hLM₁') p
  have hp_valM₁' : ((p : ℕ) : M₁') = 0 ∨ (((p - 1) * t₂ : ℕ) : ℤ) ≤ valL F M₁' ((p : ℕ) : M₁') := by
    rcases hp_valE' with hp0 | hp_ge
    · left
      have hpL0 : ((p : ℕ) : L) = 0 := by
        apply (IntermediateField.inclusion hLE').injective
        change IntermediateField.inclusion hLE' ((p : ℕ) : L) = IntermediateField.inclusion hLE' 0
        rw [hincl_LE'_p, hp0, map_zero]
      rw [← hincl_LM₁'_p, hpL0, map_zero]
    · right
      have hval_eq : valL F E' ((p : ℕ) : E') = valL F M₁' ((p : ℕ) : M₁') := by
        rw [← hincl_LE'_p, ← hincl_LM₁'_p, hval_LE', hval_LM₁']
      rw [← hval_eq]
      exact hp_ge

  
  have hPrime_M₁' : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLM₁')) := by
    rw [hdegM₁']; exact hPrime
  have hWild_M₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') = EllipticRootNumber.p F := by
    rw [hdegM₁']; exact hWild
  have hνM₁'_pow_M₁' : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLM₁')) = 1 := by
    rw [hdegM₁']; exact hνM₁'_pow
  have hνM₁'_cond_M₁' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLM₁'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1 := by
    rw [hdegM₁']; exact hνM₁'_cond
  have hbM₁'_ne0 : condExp F L νM₁' ≠ 0 := by omega
  obtain ⟨_, _, _, _, hval_LM₁'_raw, hfrob_surj_M₁', _, _,
    ϖ_M₀, ϖ_L_M₁', hϖ_norm_M₁', hϖ_M₀, hϖ_L_M₁', hBasis_M₀_raw⟩ :=
    ld_wild_total_ramification_and_power_basis F L M₁' hLM₁' hPrime_M₁' νM₁'
      hνM₁'_pow_M₁' hνM₁'_ne hνM₁'_ker hνM₁'_cond_M₁' hbM₁'_ne0 hWild_M₁'
      haddVal1 haddVal_mul halg1 hvalL_props hvalM₁'_props
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
  obtain ⟨G_M₁', hGroupGM₁', hFinGM₁', act_M₁', t_M₁', w_star_M₁', hcard_GM₁'_raw, hactM₁'_one, hactM₁'_mul, hactM₁'_ring,
    hactM₁'_incl, _, hactM₁'_val, hactM₁'_trace, hactM₁'_norm,
    htM₁'_ge1, hw_star_M₁'_t, hw_star_M₁'_nt1, hw_star_M₁'_norm, hjump_M₀_raw⟩ :=
    ld_wild_galois_aut_and_ramification_jump F L M₁' hLM₁' hGalLM₁' hPrime_M₁' hWild_M₁'
      haddVal1 halg1 hvalL_props hvalM₁'_props hval_norm_LM₁' hval_LM₁'_raw ϖ_M₀ hϖ_M₀ hBasis_M₀_raw
  letI : Group G_M₁' := hGroupGM₁'
  letI : Fintype G_M₁' := hFinGM₁'
  obtain ⟨htr_bound_M₁'_raw, htr_surj_M₁'⟩ :=
    ld_wild_euler_lagrange_trace_formula F L M₁' hLM₁' hPrime_M₁'
      hvalL_props hvalM₁'_props hval_LM₁'_raw ϖ_M₀ hϖ_M₀ hBasis_M₀_raw
      G_M₁' act_M₁' hcard_GM₁'_raw hactM₁'_one hactM₁'_mul hactM₁'_ring hactM₁'_incl hactM₁'_trace t_M₁' hjump_M₀_raw
  have hnorm_exp_M₁' :=
    ld_wild_free_orbit_norm_expansion F L M₁' hLM₁' hPrime_M₁' hvalM₁'_props
