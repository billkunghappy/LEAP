    let u' : M₁'ˣ := Units.mk0 (1 - z') hz'_ne
    have h1_sub_u' : 1 - (u' : M₁') = z' := by
      change 1 - (1 - z') = z'
      ring
    have hu'_sub_1 : (u' : M₁') - 1 = -z' := by
      change (1 - z') - 1 = -z'
      ring
    have hu'_mem : u' ∈ unitGroup F M₁' q₁ := by
      rw [hunit_ge1_M₁' q₁ hq₁_ge1 u', hu'_sub_1]
      rcases hz'_val with h0 | hge
      · left
        change 1 - z' = 1
        rw [h0, sub_zero]
      · right
        rw [hval_neg_M₁' z']
        exact hge
    have hτ_u' : Units.map τ.toRingEquiv.toMonoidHom u' = Units.mk0 (1 - z) hz_ne := by
      apply Units.ext
      change τ (1 - z') = 1 - z
      rw [h1z'_eq, τ.apply_symm_apply]
    have hchar_u' := hτ_char u'
    rw [hτ_u'] at hchar_u'
    have hcoker_u' := hr_coker u' hu'_mem
    have hΦ_u' : ((ξM₁' ^ r * χ₁) u' : Ω F) ^ 2 =
        ψM₁' (2 * β' * P_M₁' z') := by
      have h1 : u_ψM₁' (2 * β' * P_M₁' (1 - (u' : M₁'))) =
          ((ξM₁' ^ r * χ₁) u') ^ 2 := by
        have h2 : (χ₁ u' ^ 2)⁻¹ * u_ψM₁' (2 * β' * P_M₁' (1 - (u' : M₁'))) =
            ((ξM₁' ^ 2) u') ^ r := hcoker_u'
        rw [inv_mul_eq_iff_eq_mul] at h2
        rw [h2, MonoidHom.mul_apply, mul_pow]
        change (χ₁ u') ^ 2 * ((ξM₁' u') ^ 2) ^ r = ((ξM₁' u') ^ r) ^ 2 * (χ₁ u') ^ 2
        rw [← pow_mul, mul_comm 2 r, pow_mul, mul_comm]
      have hval := congrArg Units.val h1
      rw [Units.val_pow_eq_pow_val] at hval
      simpa [u_ψM₁', h1_sub_u'] using hval.symm
    rw [← hchar_u', hΦ_u', ← hτ_ψM₁' (2 * β' * P_M₁' z')]
    congr 1
    have hmap_arg : τ (2 * β' * P_M₁' z') =
        2 * IntermediateField.inclusion hLM₁' α * normLM F hM₁'K₁ (Δ : K₁) * P_M₁' z := by
      dsimp only [β', α_M₁']
      rw [hΔ_normM₁', map_mul, map_mul, map_mul, map_ofNat, hτ_L α,
        hP_M₁'_map τ z', τ.apply_symm_apply]
      ring
    exact hmap_arg
  exact ⟨Δ, hΔ_val, hΔ_as, hΔ_log₂, hΔ_log₁⟩

theorem ld_ch12_wild_odd_totally_ramified_one_over_p_pair_realization_p3 (F : Type u) [Field F]
