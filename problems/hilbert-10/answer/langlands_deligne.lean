        val_mono_E' (by omega) (val_mul_E' (val_natCast_E' j) ha₀_ge)
      exact val_add_E' hB₂_ge hja₀_ge
    | succ n ih =>
      intro hn1
      obtain ⟨w_n, hw_n, hY_n⟩ := ih (by omega)
      set r := t₁ - n
      have hr_ge1 : 1 ≤ r := by omega
      have hr_le : r ≤ t₁ := by omega
      have hr_sub : -((t₁ - (n + 1) : ℕ) : ℤ) = -(r : ℤ) + 1 := by omega
      rw [hr_sub]
      by_cases hdvd : p ∣ r
      · set k := r / p
        have hp_k : p * k = r := Nat.mul_div_cancel' hdvd
        have hk_ge1 : 1 ≤ k := by
          rcases eq_or_ne k 0 with hk0 | hk_ne0
          · rw [hk0, mul_zero] at hp_k
            omega
          · exact Nat.pos_of_ne_zero hk_ne0
        have hk_le_h₀ : k ≤ h₀ := Nat.div_le_div_right hr_le
        have hY_n_pk : Y_of w_n = 0 ∨ -((p * k : ℕ) : ℤ) ≤ valL F E' (Y_of w_n) := by
          rw [hp_k]
          exact hY_n
        obtain ⟨w_k, hw_k, hY_wk⟩ :=
          hShift_E'.2.1 k j hk_ge1 hk_le_h₀ hj_pos hj_lt (Y_of w_n) hY_n_pk
        have hw_k_h₀ : w_k = 0 ∨ -(h₀ : ℤ) ≤ valL F E' w_k :=
          val_mono_E' (by omega) hw_k
        have hstep := hY_add_step w_n w_k (-((p * k : ℕ) : ℤ) + 1) (by omega) hw_n hw_k_h₀ hY_wk
        rw [hp_k] at hstep
        exact ⟨w_n + w_k, hstep⟩
      · refine ⟨w_n, hw_n, ?_⟩
        exact hσ_nondiv_upgrade r hr_ge1 hdvd (Y_of w_n) hY_n
          (fun u₁ _ => hY_coboundary w_n hw_n u₁)
  obtain ⟨w_neg, hw_neg, hY_neg_raw⟩ := h_descent t₁ le_rfl
  have hY_neg : Y_of w_neg = 0 ∨ (0 : ℤ) ≤ valL F E' (Y_of w_neg) := by
    simpa [Nat.sub_self] using hY_neg_raw
  have hψ_xstar :
      let x_star := (σ (ϖ_E' : E')) * ((ϖ_E'⁻¹ : E'ˣ) : E') - 1
      ψE' (IntermediateField.inclusion hLE' α₀ * Y_of w_neg * (2 * x_star - x_star ^ 2)) = 1 :=
    hY_coboundary w_neg hw_neg ϖ_E'
  obtain ⟨w_zero, hw_zero, hY_zero⟩ :=
    hShift_E'.2.2.1 j hj_pos hj_lt σ hσ_L hσ_ne ϖ_E' hϖ_E' (Y_of w_neg) hY_neg hψ_xstar
  have hh₀_le0 : -(h₀ : ℤ) ≤ 0 := neg_nonpos.mpr (Nat.cast_nonneg h₀)
  have hw_zero_h₀ : w_zero = 0 ∨ -(h₀ : ℤ) ≤ valL F E' w_zero :=
    val_mono_E' hh₀_le0 hw_zero
  obtain ⟨hw_le0, hY_le0⟩ :=
    hY_add_step w_neg w_zero 1 (by omega) hw_neg hw_zero_h₀ hY_zero
  set w_le0 := w_neg + w_zero
  obtain ⟨w_high, hw_high, hY_high⟩ :=
    hShift_E'.2.2.2 j hj_pos hj_lt (Y_of w_le0) hY_le0
  have hw_high_h₀ : w_high = 0 ∨ -(h₀ : ℤ) ≤ valL F E' w_high :=
    val_mono_E' (le_trans hh₀_le0 (by omega)) hw_high
  obtain ⟨hw₀, hY_w₀⟩ :=
    hY_add_step w_le0 w_high (bE' : ℤ) le_rfl hw_le0 hw_high_h₀ hY_high
  set w₀ := w_le0 + w_high
  obtain ⟨Δ', hΔ'_val, hΔ'_as, hΔ'_norm⟩ := hAS_shift w₀ hw₀
  have hbE'_le_3pm₁ : (bE' : ℤ) ≤ ((3 * p * m₁ : ℕ) : ℤ) := by
    have h_diff_le : bE' - bM₁' ≤ p * (bE' - bM₁') := by
      simpa using Nat.mul_le_mul_right (bE' - bM₁') hp_pos
    have hm₁_ge : bE' ≤ m₁ := by omega
    have h_3pm₁ : bE' ≤ 3 * p * m₁ := by
      calc bE' = 1 * bE' := (one_mul bE').symm
        _ ≤ (3 * p) * m₁ := Nat.mul_le_mul (by omega) hm₁_ge
    exact_mod_cast h_3pm₁
  set δ_norm := normLM F hE'K₁ (Δ' : K₁) - (a₀ + w₀ ^ p - w₀)
  have hδ_ge : δ_norm = 0 ∨ (bE' : ℤ) ≤ valL F E' δ_norm :=
    val_mono_E' hbE'_le_3pm₁ hΔ'_norm
  have hjδ_ge : (j : E') * δ_norm = 0 ∨ (bE' : ℤ) ≤ valL F E' ((j : E') * δ_norm) :=
    val_mono_E' (by omega) (val_mul_E' (val_natCast_E' j) hδ_ge)
  have hB₂_Δ'_id : B₂ + (j : E') * normLM F hE'K₁ (Δ' : K₁) = Y_of w₀ + (j : E') * δ_norm := by
    dsimp [Y_of, δ_norm]
    ring
  have hB₂_Δ' : B₂ + (j : E') * normLM F hE'K₁ (Δ' : K₁) = 0 ∨
      (bE' : ℤ) ≤ valL F E' (B₂ + (j : E') * normLM F hE'K₁ (Δ' : K₁)) := by
    rw [hB₂_Δ'_id]
    exact val_add_E' hY_w₀ hjδ_ge
  have hc₂₀_inv_eq : ((c₂₀⁻¹ : E'ˣ) : E') = IntermediateField.inclusion hLE' α₀ * B₂ := by
    dsimp only [B₂, α₀]
    rw [← mul_assoc, ← map_mul]
    have hinv_mul : ((c_νE'⁻¹ : Lˣ) : L) * (c_νE' : L) = 1 := by
      exact_mod_cast Units.inv_mul c_νE'
    rw [hinv_mul, map_one, one_mul]
  refine ⟨Δ', hΔ'_val, hΔ'_as, ?_⟩
  intro x hx_val hx
  have hx0 : x = 0 ∨ (0 : ℤ) ≤ valL F E' x := val_mono_E' (by omega) hx_val
  have hquad_x : 2 * x - x ^ 2 = 0 ∨ (0 : ℤ) ≤ valL F E' (2 * x - x ^ 2) := by
    have hid_x : 2 * x - x ^ 2 = (x + x) - x * x := by ring
    rw [hid_x]
    exact val_sub_E' (val_add_E' hx0 hx0) (val_mono_E' (by omega) (val_mul_E' hx0 hx0))
  have hrem_val : (B₂ + (j : E') * normLM F hE'K₁ (Δ' : K₁)) * (2 * x - x ^ 2) = 0 ∨
      (bE' : ℤ) ≤ valL F E' ((B₂ + (j : E') * normLM F hE'K₁ (Δ' : K₁)) * (2 * x - x ^ 2)) :=
    val_mono_E' (by omega) (val_mul_E' hB₂_Δ' hquad_x)
  have hψ_rem : ψE' (IntermediateField.inclusion hLE' α₀ *
      ((B₂ + (j : E') * normLM F hE'K₁ (Δ' : K₁)) * (2 * x - x ^ 2))) = 1 :=
    hψE'_α₀_triv _ hrem_val
  have hstat_split :
      ((c₂₀⁻¹ : E'ˣ) : E') * (2 * x - x ^ 2) =
        (- IntermediateField.inclusion hLE' α₀ * (j : E') *
          normLM F hE'K₁ (Δ' : K₁) * (2 * x - x ^ 2)) +
        IntermediateField.inclusion hLE' α₀ *
          ((B₂ + (j : E') * normLM F hE'K₁ (Δ' : K₁)) * (2 * x - x ^ 2)) := by
    rw [hc₂₀_inv_eq]
    ring
  rw [hc₂₀_stat x hx_val hx, hstat_split, AddChar.map_add_eq_mul, hψ_rem, mul_one]

theorem ld_ch12_wild_odd_totally_ramified_first_branch_as_realization_scaled (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalE'K₁ : IsGaloisExt F E' K₁)
    (hGalM₁'K₁ : IsGaloisExt F M₁' K₁) (hAbLE' : IsAbelianExt F hLE')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣
      (condExp F L νM₁' - 1)))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) *
          (condExp F L νE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          (condExp F L νE' : ℤ))
    (hξM₁'_cond : condExp F M₁' (νE'.comp (Units.map (normLM F hLM₁'))) =
      condExp F L νM₁' +
        Module.finrank L (IntermediateField.extendScalars hLE') *
          (condExp F L νE' - condExp F L νM₁'))
    (hξM₁'_triv : ∀ u ∈ unitGroup F M₁'
      (condExp F M₁' (νE'.comp (Units.map (normLM F hLM₁')))),
      (νE'.comp (Units.map (normLM F hLM₁'))) u = 1)
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (hTowerNormTr : ∀ w : K₁,
      normLM F hLE' (normLM F hE'K₁ w) = normLM F hLM₁' (normLM F hM₁'K₁ w) ∧
      traceLM F hLE' (traceLM F hE'K₁ w) = traceLM F hLM₁' (traceLM F hM₁'K₁ w))
    (hGalLift_E' : ∀ σ : E' ≃ₐ[F] E',
      (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) →
      ∃ σ_lift : K₁ ≃ₐ[F] K₁,
        (∀ z : M₁', σ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ z) ∧
        (∀ y : E', σ_lift (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hE'K₁ (σ y)) ∧
        (∀ w : K₁, valL F K₁ (σ_lift w) = valL F K₁ w) ∧
        (∀ w : K₁,
          normLM F hM₁'K₁ (σ_lift w) = normLM F hM₁'K₁ w ∧
          normLM F hE'K₁ (σ_lift w) = σ (normLM F hE'K₁ w)))
    (χ₂ : E'ˣ →* (Ω F)ˣ)
    (hχ₂_twists : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
      let m₂ := condExp F L νE' + condExp F L νM₁' - 1
      condExp F E' (ξE' ^ j * χ₂) = m₂ ∧
      (∀ u ∈ unitGroup F E' m₂, (ξE' ^ j * χ₂) u = 1) ∧
      ∃ σ : E' ≃ₐ[F] E',
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
        ∀ y : E'ˣ, (ξE' ^ j * χ₂) y = χ₂ (Units.map σ.toRingEquiv.toMonoidHom y))
    (c_νE' : Lˣ)
    (hc_νE'_val : valL F L (c_νE' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_νE'_stat : ∀ u : L, (u = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) ^ 2 =
          ψ (((c_νE'⁻¹ : Lˣ) : L) * (2 * u - u ^ 2)))
    (c₂₀ : E'ˣ)
    (hc₂₀_val : valL F E' (c₂₀ : E') =
      ((condExp F L νE' + condExp F L νM₁' - 1 : ℕ) : ℤ) +
        condExpChar F E' (traceChar F hLE' ψ))
    (hc₂₀_stat : ∀ x : E',
      (x = 0 ∨ (((condExp F L νE' + condExp F L νM₁' - 1) / 2 : ℕ) : ℤ) ≤ valL F E' x) →
      ∀ hx : 1 + x ≠ 0,
        (χ₂ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
          (traceChar F hLE' ψ) (((c₂₀⁻¹ : E'ˣ) : E') * (2 * x - x ^ 2)))
    (Δ₀ : K₁ˣ)
    (hΔ₀_val : valL F K₁ (Δ₀ : K₁) = -((condExp F L νM₁' - 1 : ℕ) : ℤ))
    (hΔ₀_as :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * condExp F L νM₁' - 1 + p * (condExp F L νE' - condExp F L νM₁')
      (Δ₀ : K₁) ^ p - (Δ₀ : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ₀ : K₁)) = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤
          valL F K₁ ((Δ₀ : K₁) ^ p - (Δ₀ : K₁) -
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ₀ : K₁))))
    (hAS_shift : ∀ w₀ : E',
      (w₀ = 0 ∨ -(((condExp F L νM₁' - 1) /
        Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : ℤ) ≤ valL F E' w₀) →
      ∃ Δ' : K₁ˣ,
        let p := Module.finrank L (IntermediateField.extendScalars hLE')
        let m₁ := 2 * condExp F L νM₁' - 1 + p * (condExp F L νE' - condExp F L νM₁')
        valL F K₁ (Δ' : K₁) = -((condExp F L νM₁' - 1 : ℕ) : ℤ) ∧
        ((Δ' : K₁) ^ p - (Δ' : K₁) -
          IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ' : K₁)) = 0 ∨
          ((4 * p * p * m₁ : ℕ) : ℤ) ≤
            valL F K₁ ((Δ' : K₁) ^ p - (Δ' : K₁) -
              IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ' : K₁)))) ∧
        (normLM F hE'K₁ (Δ' : K₁) - (normLM F hE'K₁ (Δ₀ : K₁) + w₀ ^ p - w₀) = 0 ∨
          ((3 * p * m₁ : ℕ) : ℤ) ≤
            valL F E' (normLM F hE'K₁ (Δ' : K₁) -
              (normLM F hE'K₁ (Δ₀ : K₁) + w₀ ^ p - w₀))))
    (hModelCompat_Δ₀ :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let bM₁' := condExp F L νM₁'
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      let m₂ := bE' + bM₁' - 1
      let d₁ := m₁ / 2
      let d₂ := m₂ / 2
      valL F E' (normLM F hE'K₁ (Δ₀ : K₁)) = -((bM₁' - 1 : ℕ) : ℤ) ∧
      ∀ w : K₁, (w = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ w) →
        let u₁ := normLM F hM₁'K₁ (1 + w) - 1
        let u₂ := normLM F hE'K₁ (1 + w) - 1
        (u₁ = 0 ∨ (d₁ : ℤ) ≤ valL F M₁' u₁) ∧
        (u₂ = 0 ∨ (d₂ : ℤ) ≤ valL F E' u₂) ∧
        (traceChar F hLM₁' ψ) (IntermediateField.inclusion hLM₁' (((c_νE'⁻¹ : Lˣ) : L)) *
          normLM F hM₁'K₁ (Δ₀ : K₁) * (2 * u₁ - u₁ ^ 2)) =
        (traceChar F hLE' ψ) (IntermediateField.inclusion hLE' (((c_νE'⁻¹ : Lˣ) : L)) *
          normLM F hE'K₁ (Δ₀ : K₁) * (2 * u₂ - u₂ ^ 2)))
    (hCoker_E' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := condExp F L νM₁' - 1
      let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
      ∀ (Φ₀ : E'ˣ →* (Ω F)ˣ),
        (∀ u ∈ unitGroup F E' (t₁ + 1), Φ₀ u = 1) →
        (∀ w : K₁ˣ, Φ₀ (Units.map (normLM F hE'K₁) w) = 1) →
        (∃ u₁ ∈ unitGroup F E' t₁, Φ₀ u₁ ≠ 1) →
        ∃ j < p, 0 < j ∧ ∀ y : E'ˣ, (ξE' y) ^ 2 = (Φ₀ y) ^ j)
    (hShift_E' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let t₁ := condExp F L νM₁' - 1
      let h₀ := t₁ / p
      let m₂ := bE' + condExp F L νM₁' - 1
      let d₂ := m₂ / 2
      let α₀ := ((c_νE'⁻¹ : Lˣ) : L)
      let ψE' := traceChar F hLE' ψ
      (∀ w₀ : E', (w₀ = 0 ∨ -(h₀ : ℤ) ≤ valL F E' w₀) →
