  obtain ⟨hCond_pullback, hCond_orbit⟩ :=
    ld_ch14_wild_semidirect_pullback_and_orbit_cond_ge_two F rec L K M_C E
      hLK hLM_C hM_CK hLE hEK h_inf h_sup hLM_C_lt hCore hGal hGalMCK hMin
      ψ hψ χL_ext hχL_ext hMC_decomp hMC_inter hu_star
  obtain ⟨htraceChar, _⟩ := ld_tateEps_char_and_traceChar F rec
  have hSep_iff : ∀ (L₀ E₁ : IntermediateField F (AlgebraicClosure F)) (h₀ : L₀ ≤ E₁),
      Algebra.IsSeparable L₀ (IntermediateField.extendScalars h₀) ↔
        E₁ ≤ IntermediateField.restrictScalars F (separableClosure L₀ (AlgebraicClosure F)) := by
    intro L₀ E₁ h₀
    let S := IntermediateField.extendScalars h₀
    have hmin : ∀ x : S, IsSeparable L₀ x.1 ↔ IsSeparable L₀ x := by
      intro x
      change (minpoly L₀ (S.val x)).Separable ↔ (minpoly L₀ x).Separable
      rw [minpoly.algHom_eq S.val S.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S := ⟨z, (IntermediateField.mem_extendScalars h₀).mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable L₀ S _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ E₁ := (IntermediateField.mem_extendScalars h₀).mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
  have hSep_sub : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (hLA : L ≤ A) (hAB : A ≤ B) (hBK : B ≤ K),
      FiniteDimensional F B ∧ Algebra.IsSeparable A (IntermediateField.extendScalars hAB) := by
    intro A B hLA hAB hBK
    refine ⟨Module.Finite.of_injective (IntermediateField.inclusion hBK).toLinearMap
      (IntermediateField.inclusion hBK).injective, ?_⟩
    rw [hSep_iff]
    intro z hz
    rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
    have hzL : IsSeparable L z := by
      have hK_sep := (hSep_iff L K hLK).mp (hGal.2.2.2 hLK) (hBK hz)
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp hK_sep)
    exact IsSeparable.tower_top (↥(IntermediateField.extendScalars hLA)) hzL
  have hWeil_rest : ∀ {A B : IntermediateField F (AlgebraicClosure F)} (hAB : A ≤ B)
      {χ : relWeil F A →* (Ω F)ˣ},
      IsWeilRep F A (charRep F A χ) →
      IsWeilRep F B (charRep F B (restrictWeilChar F hAB χ)) := by
    rintro A B hAB χ ⟨hfin, U, hU, htriv⟩
    exact ⟨hfin, U, hU, fun w hwU hwI =>
      htriv (Subgroup.inclusion (relWeil_antitone F hAB) w) hwU hwI⟩
  have hWeil_mul : ∀ {A : IntermediateField F (AlgebraicClosure F)}
      {χ₁ χ₂ : relWeil F A →* (Ω F)ˣ},
      IsWeilRep F A (charRep F A χ₁) → IsWeilRep F A (charRep F A χ₂) →
      IsWeilRep F A (charRep F A (χ₁ * χ₂)) := by
    rintro A χ₁ χ₂ ⟨hfin, U₁, hU₁, htriv₁⟩ ⟨_, U₂, hU₂, htriv₂⟩
    refine ⟨hfin, U₁ ∩ U₂, Filter.inter_mem hU₁ hU₂, fun w hw hwI => ?_⟩
    have hmul : charRep F A (χ₁ * χ₂) w = charRep F A χ₁ w * charRep F A χ₂ w := by
      apply LinearMap.ext
      intro v
      change ((χ₁ * χ₂) w : Ω F) • v = (χ₁ w : Ω F) • ((χ₂ w : Ω F) • v)
      rw [MonoidHom.mul_apply, Units.val_mul, mul_smul]
    rw [hmul, htriv₁ w hw.1 hwI, htriv₂ w hw.2 hwI, mul_one]
  have hrest_trans : ∀ {A B C : IntermediateField F (AlgebraicClosure F)}
      (hAB : A ≤ B) (hBC : B ≤ C) (χ : relWeil F A →* (Ω F)ˣ),
      restrictWeilChar F hBC (restrictWeilChar F hAB χ) =
        restrictWeilChar F (hAB.trans hBC) χ := by
    intro A B C hAB hBC χ
    ext w
    rfl
  have hrest_mul : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (hAB : A ≤ B) (χ₁ χ₂ : relWeil F A →* (Ω F)ˣ),
      restrictWeilChar F hAB (χ₁ * χ₂) =
        restrictWeilChar F hAB χ₁ * restrictWeilChar F hAB χ₂ := by
    intro A B hAB χ₁ χ₂
    ext w
    rfl
  have hrest_one : ∀ {A B : IntermediateField F (AlgebraicClosure F)} (hAB : A ≤ B),
      restrictWeilChar F hAB (1 : relWeil F A →* (Ω F)ˣ) = 1 := by
    intro A B hAB
    ext w
    rfl
  have hrest_pow : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (hAB : A ≤ B) (χ : relWeil F A →* (Ω F)ˣ) (n : ℕ),
      (restrictWeilChar F hAB χ) ^ n = restrictWeilChar F hAB (χ ^ n) := by
    intro A B hAB χ n
    ext w
    rfl
  refine ⟨?_, ?_⟩
  · intro ν hν_rest hν_pow
    obtain ⟨hν_weil, hν_cond, hν_inv_L⟩ :=
      ld_ch14_single_field_coprime_weil_twist_pow_invariance F rec L M_C hLM_C ψ hψ
        q₀ hq₀_prime hq₀_ne_p ν hν_rest hν_pow
    have hνE_rest : restrictWeilChar F hEK (restrictWeilChar F hLE ν) = 1 := by
      rw [hrest_trans hLE hEK, ← hrest_trans hLM_C hM_CK, hν_rest, hrest_one]
    have hνE_pow : (restrictWeilChar F hLE ν) ^ q₀ = 1 := by
      rw [hrest_pow, hν_pow, hrest_one]
    obtain ⟨_, _, hνE_inv⟩ :=
      ld_ch14_single_field_coprime_weil_twist_pow_invariance F rec E K hEK
        (traceChar F hLE ψ) hψE q₀ hq₀_prime hq₀_ne_p
        (restrictWeilChar F hLE ν) hνE_rest hνE_pow
    have hχE_weil : IsWeilRep F E (charRep F E (restrictWeilChar F hLE χL_ext)) :=
      hWeil_rest hLE hχL_ext
    have hCond_E : 2 ≤ condExp F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) :=
      hCond_pullback E hLE hEK (restrictWeilChar F hLE χL_ext) hχE_weil
        (hrest_trans hLE hEK χL_ext)
    have hE_pow := hνE_inv (restrictWeilChar F hLE χL_ext) hχE_weil hCond_E
    refine ⟨hν_weil, hν_cond, ?_, ?_⟩
    · rw [mul_pow, mul_pow, hrest_mul, hE_pow]
    · have heval_cons : ∀ {M : IntermediateField F (AlgebraicClosure F)}
          (ψ_M : AddChar M (Ω F)) (t : MonomialTerm F M) (tl : List (MonomialTerm F M)),
          evalMonomialList F rec (fun _ _ _ => 1) M ψ_M (t :: tl) =
            evalMonomialTerm F rec (fun _ _ _ => 1) M ψ_M t *
              evalMonomialList F rec (fun _ _ _ => 1) M ψ_M tl := by
        intro M ψ_M t tl
        rfl
      have htr_self : traceChar F (le_rfl : L ≤ L) ψ = ψ :=
        ((htraceChar L L le_rfl (hSep_sub le_rfl le_rfl hLK).2).2 ψ hψ).2.1
      have hhead_pow :
          (evalMonomialTerm F rec (fun _ _ _ => 1) L ψ
            (twistMonomialTerm F L (ν * χL_ext) ⟨1, L, le_rfl, 1⟩)) ^ q₀ =
          (evalMonomialTerm F rec (fun _ _ _ => 1) L ψ
            (twistMonomialTerm F L χL_ext ⟨1, L, le_rfl, 1⟩)) ^ q₀ := by
        have h1 : (1 : relWeil F L →* (Ω F)ˣ) * restrictWeilChar F (le_rfl : L ≤ L) (ν * χL_ext) =
            ν * χL_ext := by
          ext w
          simp [restrictWeilChar]
          rfl
        have h2 : (1 : relWeil F L →* (Ω F)ˣ) * restrictWeilChar F (le_rfl : L ≤ L) χL_ext =
            χL_ext := by
          ext w
          simp [restrictWeilChar]
          rfl
        change ((tateEpsUnit F L (recChar F rec L (1 * restrictWeilChar F (le_rfl : L ≤ L) (ν * χL_ext)))
            (traceChar F (le_rfl : L ≤ L) ψ) * 1) ^ (1 : ℤ)) ^ q₀ =
          ((tateEpsUnit F L (recChar F rec L (1 * restrictWeilChar F (le_rfl : L ≤ L) χL_ext))
            (traceChar F (le_rfl : L ≤ L) ψ) * 1) ^ (1 : ℤ)) ^ q₀
        rw [h1, h2, htr_self, mul_one, mul_one, zpow_one, zpow_one]
        exact hν_inv_L χL_ext hχL_ext h_ge2
      have htail_pow : ∀ (D : List (MonomialTerm F L)),
          (∀ t ∈ D, t ∈ D_orb) →
          (evalMonomialList F rec (fun _ _ _ => 1) L ψ
            (D.map (twistMonomialTerm F L (ν * χL_ext)))) ^ q₀ =
          (evalMonomialList F rec (fun _ _ _ => 1) L ψ
            (D.map (twistMonomialTerm F L χL_ext))) ^ q₀ := by
        intro D hD
        induction D with
        | nil => rfl
        | cons t tl ih =>
          have ht : t ∈ D_orb := hD t List.mem_cons_self
          have htl : ∀ t' ∈ tl, t' ∈ D_orb := fun t' ht' => hD t' (List.mem_cons_of_mem t ht')
          obtain ⟨ht_coeff, _, htMC, _, ⟨htK, ht_restK⟩, _, _⟩ := hD_orb_props t ht
          haveI : FiniteDimensional F t.field := (hOrb_rec t ht).1
          have hψ_t : IsAdmissibleChar F t.field (traceChar F t.le ψ) :=
            (hOrb_rec t ht).2.2.2.2.1
          have ht_weil : IsWeilRep F t.field (charRep F t.field t.χ) :=
            (hD₁_sub.1.1 t (List.mem_cons_of_mem _ ht)).2.2
          let ν_t := restrictWeilChar F t.le ν
          let β_t := t.χ * restrictWeilChar F t.le χL_ext
          have hν_t_rest : restrictWeilChar F htMC ν_t = 1 := by
            rw [hrest_trans t.le htMC, hν_rest]
          have hν_t_pow : ν_t ^ q₀ = 1 := by
            rw [hrest_pow, hν_pow, hrest_one]
          obtain ⟨_, _, hν_t_inv⟩ :=
            ld_ch14_single_field_coprime_weil_twist_pow_invariance F rec t.field M_C htMC
              (traceChar F t.le ψ) hψ_t q₀ hq₀_prime hq₀_ne_p ν_t hν_t_rest hν_t_pow
          have hβ_t_weil : IsWeilRep F t.field (charRep F t.field β_t) :=
            hWeil_mul ht_weil (hWeil_rest t.le hχL_ext)
          have hβ_t_restK : restrictWeilChar F htK β_t = restrictWeilChar F hLK χL_ext := by
            rw [hrest_mul, ht_restK, hrest_trans t.le htK]
            ext w
            simp
          have hCond_t : 2 ≤ condExp F t.field (recChar F rec t.field β_t) :=
            hCond_pullback t.field t.le htK β_t hβ_t_weil hβ_t_restK
          have hchar_eq : t.χ * restrictWeilChar F t.le (ν * χL_ext) = ν_t * β_t := by
            rw [hrest_mul]
            ext w
            simp [ν_t, β_t, mul_comm, mul_left_comm, mul_assoc]
          have hterm_t :
              (evalMonomialTerm F rec (fun _ _ _ => 1) L ψ
                (twistMonomialTerm F L (ν * χL_ext) t)) ^ q₀ =
              (evalMonomialTerm F rec (fun _ _ _ => 1) L ψ
                (twistMonomialTerm F L χL_ext t)) ^ q₀ := by
            change ((tateEpsUnit F t.field
                (recChar F rec t.field (t.χ * restrictWeilChar F t.le (ν * χL_ext)))
                (traceChar F t.le ψ) * 1) ^ t.coeff) ^ q₀ =
              ((tateEpsUnit F t.field
                (recChar F rec t.field β_t)
                (traceChar F t.le ψ) * 1) ^ t.coeff) ^ q₀
            rw [ht_coeff, mul_one, mul_one, zpow_one, zpow_one, hchar_eq]
            exact hν_t_inv β_t hβ_t_weil hCond_t
          rw [List.map_cons, List.map_cons, heval_cons, heval_cons,
            mul_pow, mul_pow, hterm_t, ih htl]
      rw [List.map_cons, List.map_cons, heval_cons, heval_cons,
        mul_pow, mul_pow, mul_pow, mul_pow, hhead_pow, htail_pow D_orb (fun _ ht => ht)]
  · intro L' E' hLL' hL'MC hEE' hL'E' hE'K _ ν' hν'_rest hν'_pow
    have hL'K : L' ≤ K := hL'MC.trans hM_CK
    have hLE' : L ≤ E' := hLL'.trans hL'E'
    obtain ⟨hFinL', hSepLL'⟩ := hSep_sub le_rfl hLL' hL'K
    obtain ⟨hFinE', hSepLE'⟩ := hSep_sub le_rfl hLE' hE'K
    haveI : FiniteDimensional F L' := hFinL'
    haveI : FiniteDimensional F E' := hFinE'
    have hψL' : IsAdmissibleChar F L' (traceChar F hLL' ψ) :=
      ((htraceChar L L' hLL' hSepLL').2 ψ hψ).1
    have hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ) :=
      ((htraceChar L E' hLE' hSepLE').2 ψ hψ).1
    obtain ⟨hν'_weil, _, hν'_inv_L'⟩ :=
      ld_ch14_single_field_coprime_weil_twist_pow_invariance F rec L' M_C hL'MC
        (traceChar F hLL' ψ) hψL' q₀ hq₀_prime hq₀_ne_p ν' hν'_rest hν'_pow
    let β_L' := restrictWeilChar F hLL' χL_ext
    have hβ_L'_weil : IsWeilRep F L' (charRep F L' β_L') := hWeil_rest hLL' hχL_ext
    have hCond_L' : 2 ≤ condExp F L' (recChar F rec L' β_L') :=
      hCond_pullback L' hLL' hL'K β_L' hβ_L'_weil (hrest_trans hLL' hL'K χL_ext)
    let ν'_E' := restrictWeilChar F hL'E' ν'
    let β_E' := restrictWeilChar F hL'E' β_L'
    have hν'_E'_rest : restrictWeilChar F hE'K ν'_E' = 1 := by
      rw [hrest_trans hL'E' hE'K, ← hrest_trans hL'MC hM_CK, hν'_rest, hrest_one]
    have hν'_E'_pow : ν'_E' ^ q₀ = 1 := by
      rw [hrest_pow, hν'_pow, hrest_one]
    obtain ⟨_, _, hν'_inv_E'⟩ :=
      ld_ch14_single_field_coprime_weil_twist_pow_invariance F rec E' K hE'K
        (traceChar F hLE' ψ) hψE' q₀ hq₀_prime hq₀_ne_p ν'_E' hν'_E'_rest hν'_E'_pow
    have hβ_E'_weil : IsWeilRep F E' (charRep F E' β_E') := hWeil_rest hL'E' hβ_L'_weil
    have hCond_E' : 2 ≤ condExp F E' (recChar F rec E' β_E') := by
      apply hCond_pullback E' hLE' hE'K β_E' hβ_E'_weil
      rw [hrest_trans hL'E' hE'K, hrest_trans hLL' hL'K]
    refine ⟨hν'_weil, hν'_inv_L' β_L' hβ_L'_weil hCond_L', ?_, ?_⟩
    · rw [hrest_mul]
      exact hν'_inv_E' β_E' hβ_E'_weil hCond_E'
    · have heval_cons : ∀ (t : MonomialTerm F L') (tl : List (MonomialTerm F L')),
          evalMonomialList F rec (fun _ _ _ => 1) L' (traceChar F hLL' ψ) (t :: tl) =
            evalMonomialTerm F rec (fun _ _ _ => 1) L' (traceChar F hLL' ψ) t *
              evalMonomialList F rec (fun _ _ _ => 1) L' (traceChar F hLL' ψ) tl := by
        intro t tl
        rfl
      intro D_L' hD_L'_props
      induction D_L' with
      | nil => rfl
      | cons s tl ih =>
        have hs_mem : s ∈ s :: tl := List.mem_cons_self
        have htl_props : ∀ s' ∈ tl,
            s'.coeff = 1 ∧
            s'.field ≤ M_C ∧
            s'.χ ^ (p F) = 1 ∧
            (∃ hsK : s'.field ≤ K, restrictWeilChar F hsK s'.χ = 1) ∧
            (∃ hsE : s'.field ≤ E ⊔ s'.field, restrictWeilChar F hsE s'.χ = 1) ∧
            (∀ hsM : s'.field ≤ M_C, restrictWeilChar F hsM s'.χ ≠ 1) :=
          fun s' hs' => hD_L'_props s' (List.mem_cons_of_mem s hs')
        obtain ⟨hs_coeff, hsMC, _, ⟨hsK, hs_restK⟩, _, hs_not1⟩ := hD_L'_props s hs_mem
        have hLs : L ≤ s.field := hLL'.trans s.le
        have hsK' : s.field ≤ K := hsMC.trans hM_CK
        obtain ⟨hFins, hSepL's⟩ := hSep_sub hLL' s.le hsK'
        haveI : FiniteDimensional F s.field := hFins
        have hψ_s : IsAdmissibleChar F s.field (traceChar F s.le (traceChar F hLL' ψ)) :=
          ((htraceChar L' s.field s.le hSepL's).2 (traceChar F hLL' ψ) hψL').1
        obtain ⟨hs_weil, hs_cond2⟩ :=
          hCond_orbit s.field hLs hsMC s.χ hs_restK (hs_not1 hsMC)
        let ν'_s := restrictWeilChar F s.le ν'
        have hν'_s_rest : restrictWeilChar F hsMC ν'_s = 1 := by
          rw [hrest_trans s.le hsMC, hν'_rest]
        have hν'_s_pow : ν'_s ^ q₀ = 1 := by
          rw [hrest_pow, hν'_pow, hrest_one]
        obtain ⟨_, _, hν'_s_inv⟩ :=
          ld_ch14_single_field_coprime_weil_twist_pow_invariance F rec s.field M_C hsMC
            (traceChar F s.le (traceChar F hLL' ψ)) hψ_s q₀ hq₀_prime hq₀_ne_p
            ν'_s hν'_s_rest hν'_s_pow
        have hterm_s :
            (evalMonomialTerm F rec (fun _ _ _ => 1) L' (traceChar F hLL' ψ)
              (twistMonomialTerm F L' ν' s)) ^ q₀ =
            (evalMonomialTerm F rec (fun _ _ _ => 1) L' (traceChar F hLL' ψ) s) ^ q₀ := by
          change ((tateEpsUnit F s.field
              (recChar F rec s.field (s.χ * ν'_s))
              (traceChar F s.le (traceChar F hLL' ψ)) * 1) ^ s.coeff) ^ q₀ =
            ((tateEpsUnit F s.field
              (recChar F rec s.field s.χ)
              (traceChar F s.le (traceChar F hLL' ψ)) * 1) ^ s.coeff) ^ q₀
          rw [hs_coeff, mul_one, mul_one, zpow_one, zpow_one, mul_comm s.χ ν'_s]
          exact hν'_s_inv s.χ hs_weil hs_cond2
        rw [List.map_cons, heval_cons, heval_cons, mul_pow, mul_pow, hterm_s, ih htl_props]

theorem ld_ch14_cyclic_q0_char_and_disjoint_sup_decomp (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C F' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLF' : L ≤ F') (hF'MC : F' ≤ M_C)
    (hGal : IsGaloisExt F L K) (hGalF' : IsGaloisExt F L F') (hAbF' : IsAbelianExt F hLF')
    (q₀ : ℕ) (hq₀_prime : Nat.Prime q₀)
    (hFinF' : Module.finrank L (IntermediateField.extendScalars hLF') = q₀) :
    ∃ ν₁ : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L ν₁) ∧
      restrictWeilChar F hLF' ν₁ = 1 ∧
      restrictWeilChar F hLM_C ν₁ = 1 ∧
      ν₁ ^ q₀ = 1 ∧
      ν₁ ≠ 1 ∧
      ∀ (M : IntermediateField F (AlgebraicClosure F)) (hLM : L ≤ M) (hMK : M ≤ K),
        Algebra.IsSeparable L (IntermediateField.extendScalars hLM) →
        ¬ (F' ≤ M) →
        let M' := M ⊔ F'
        let hMM' : M ≤ M' := le_sup_left
        let hF'M' : F' ≤ M' := le_sup_right
        IsGaloisExt F M M' ∧
        IsAbelianExt F hMM' ∧
        IsMinimalAbelianNormalSubfield F M M' hMM' M le_rfl hMM' ∧
        ∀ (χM : relWeil F M →* (Ω F)ˣ),
          IsWeilRep F M (charRep F M χM) →
          (⟨1, M', hF'M', restrictWeilChar F hMM' χM⟩ : MonomialTerm F F').Wf F F' ∧
          (∀ w : relWeil F F',
            (⟨1, M, hLM, χM⟩ : MonomialTerm F L).trace F L
              (Subgroup.inclusion (relWeil_antitone F hLF') w) =
            (⟨1, M', hF'M', restrictWeilChar F hMM' χM⟩ : MonomialTerm F F').trace F F' w) ∧
          ∃ D_M : List (MonomialTerm F M),
            IsSubMonomialDecomp F M M M' hMM' D_M ∧
            (∀ s ∈ D_M, ∃ hsM' : s.field ≤ M', restrictWeilChar F hsM' s.χ = 1) ∧
            ∀ (ψM : AddChar M (Ω F)),
              evalMonomialList F rec (fun _ _ _ => 1) M ψM D_M =
                (∏ j ∈ Finset.range q₀,
                  tateEpsUnit F M
                    (recChar F rec M (restrictWeilChar F hLM (ν₁ ^ j))) ψM) ∧
              evalMonomialList F rec (fun _ _ _ => 1) M ψM
                  (D_M.map (twistMonomialTerm F M χM)) =
                (∏ j ∈ Finset.range q₀,
                  tateEpsUnit F M
                    (recChar F rec M (restrictWeilChar F hLM (ν₁ ^ j) * χM)) ψM) :=
by
  obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
  haveI : FiniteDimensional F F' := hGalF'.2.1
  have hSepLF' : Algebra.IsSeparable L (IntermediateField.extendScalars hLF') :=
    hGalF'.2.2.2 hLF'
  let G_L := relWeil F L
  let H_F' : Subgroup G_L := (relWeil F F').subgroupOf G_L
  have hHF'_iff : ∀ w : G_L, w ∈ H_F' ↔ (w : AbsGal F) ∈ F'.fixingSubgroup := by
    intro w
    change ((w : AbsGal F) ∈ weilGroup F ∧ (w : AbsGal F) ∈ F'.fixingSubgroup) ↔ _
    exact and_iff_right w.2.1
  haveI hHF'_norm : H_F'.Normal := ⟨by
    intro h hh g
    rw [hHF'_iff] at hh ⊢
    exact hGalF'.2.2.1 (g : AbsGal F) g.2.2 (h : AbsGal F) hh⟩
  let Q_F' := G_L ⧸ H_F'
  let π_F' : G_L →* Q_F' := QuotientGroup.mk' H_F'
  have hπF'_surj : Function.Surjective π_F' := QuotientGroup.mk'_surjective H_F'
  have hπF'_eq_one : ∀ w : G_L, π_F' w = 1 ↔ w ∈ H_F' :=
    fun w => QuotientGroup.eq_one_iff w
  obtain ⟨hFin_QF', hCard_QF'_finrank⟩ :=
    ld_relWeil_quotient_card_eq_finrank F hp hFrob L F' hLF' hSepLF'
  haveI : Finite Q_F' := hFin_QF'
  letI : Fintype Q_F' := Fintype.ofFinite Q_F'
  have hCard_QF' : Nat.card Q_F' = q₀ := hCard_QF'_finrank.trans hFinF'
  haveI : Fact (Nat.Prime q₀) := ⟨hq₀_prime⟩
  have hdvd_QF' : q₀ ∣ Nat.card Q_F' := dvd_of_eq hCard_QF'.symm
  obtain ⟨σ₀, hσ₀_ord⟩ := exists_prime_orderOf_dvd_card' (G := Q_F') q₀ hdvd_QF'
  have h_pow_eq_iff : ∀ k₁ k₂ : ℕ, k₂ ≤ k₁ → σ₀ ^ k₁ = σ₀ ^ k₂ → q₀ ∣ (k₁ - k₂) := by
    intro k₁ k₂ hle heq
    have hd : σ₀ ^ (k₁ - k₂) = 1 := by
      apply mul_right_cancel (b := σ₀ ^ k₂)
