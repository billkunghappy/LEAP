        _ = IntermediateField.inclusion hLM₁' s₀ * (1 + 2 * x) * ((u₁⁻¹ : M₁'ˣ) : M₁') := by ring
    have hv₁_sub_ge : (v₁ : M₁') - 1 = 0 ∨ 2 * (r : ℤ) ≤ valL F M₁' ((v₁ : M₁') - 1) := by
      rw [hv₁_sub_eq]
      exact hM₁'_mono (by omega)
        (hM₁'_mul (hM₁'_mul (hM₁'_incl hs₀) h1_2x_ge) hu₁_inv_ge)
    have h_split :
        IntermediateField.inclusion hLM₁' ((α'⁻¹ : Lˣ) : L) * a₁ * ((v₁ : M₁') - 1) =
          IntermediateField.inclusion hLM₁' ((α⁻¹ : Lˣ) : L) * a₁ * ((v₁ : M₁') - 1) +
            IntermediateField.inclusion hLM₁' (((α⁻¹ : Lˣ) : L) * δ_u) * a₁ * ((v₁ : M₁') - 1) := by
      rw [hα'_inv_eq, map_add]
      ring
    have h_triv :
        (traceChar F hLM₁' ψ)
          (IntermediateField.inclusion hLM₁' (((α⁻¹ : Lˣ) : L) * δ_u) * a₁ * ((v₁ : M₁') - 1)) = 1 := by
      apply hSpecM₁'
      have h_prod :=
        hM₁'_mul (hM₁'_mul (hM₁'_incl hα_δ_ge) ha₁_ge) hv₁_sub_ge
      exact hM₁'_mono (by rw [hnM₁']; omega) h_prod
    rw [h_old, h_split, (traceChar F hLM₁' ψ).map_add_eq_mul, h_triv, mul_one]
  refine ⟨α', c₀, c₁, c_θ₁, Δ₀, Δ₁,
    hα'_val, hc_ν₂'_stat, hc_ν₁'_stat, hNormPhaseM₁'', hCommM₁'',
    hc_θ₁_val, hc_θ₁_stat, hc₀_val, hc₁_val, hA_dom, ?_, hΔ₀_val⟩
  have hW₀_rescale :
      IntermediateField.inclusion hLM₁' (α' : L) * ((c_θ₁⁻¹ : M₁'ˣ) : M₁') =
        IntermediateField.inclusion hLM₁' (u_rescale : L) *
          (IntermediateField.inclusion hLM₁' P₀ + IntermediateField.inclusion hLM₁' P₁ * x) := by
    calc IntermediateField.inclusion hLM₁' (α' : L) * ((c_θ₁⁻¹ : M₁'ˣ) : M₁')
      _ = IntermediateField.inclusion hLM₁' (u_rescale : L) * W₀ := by
          dsimp [α', W₀]
          rw [map_mul]
          ring
      _ = IntermediateField.inclusion hLM₁' (u_rescale : L) *
            (IntermediateField.inclusion hLM₁' P₀ + IntermediateField.inclusion hLM₁' P₁ * x) := by
          rw [hW₀_eq]
  rw [hW₀_rescale, hΔ₀_eq, hΔ₁_eq]
  dsimp [a₁, G, A]
  simp only [map_add, map_sub, map_mul, map_neg, map_one, map_ofNat]
  ring

theorem ld_ch12_wild_dyadic_even_breaks_higher_cond_cM1_stationarity (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M₁']
    (hLM₁' : L ≤ M₁')
    (hdeg2_M₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') = 2)
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hSpecL : (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1))
    (hSpecM₁' : ∀ z : M₁',
      (z = 0 ∨ -condExpChar F M₁' (traceChar F hLM₁' ψ) ≤ valL F M₁' z) →
        (traceChar F hLM₁' ψ) z = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hval_normM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = 2 * valL F L x)
    (hnM₁' : condExpChar F M₁' (traceChar F hLM₁' ψ) =
      2 * condExpChar F L ψ + (condExp F L νM₁' : ℤ))
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_even : condExp F L νE' % 2 = 0)
    (hm1_ge : 2 * condExp F L νE' ≤ condExp F M₁' θM₁')
    (hm1_even : condExp F M₁' θM₁' % 2 = 0)
    (τ₁ : M₁' ≃ₐ[F] M₁')
    (hτ₁_L : ∀ x : L, τ₁ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hτ₁_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) = z + τ₁ z)
    (hτ₁_norm : ∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) = z * τ₁ z)
    (h2_val : (2 : L) = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L (2 : L))
    (x : M₁') (f g d : L)
    (hx_ne : x ≠ 0) (hf_ne : f ≠ 0) (hg_ne : g ≠ 0) (hd_ne : d ≠ 0)
    (hx_val : valL F M₁' x = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hf_val : valL F L f = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hg_val : valL F L g = (1 - 2 * ((condExp F L νE' / 2 : ℕ) : ℤ)))
    (hd_val : valL F L d = (((condExp F L νE' / 2 : ℕ) : ℤ) - ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hk₀_val : valL F L (1 + d) = 0)
    (hE_val : f + d ^ 2 * g = 0 ∨ (1 - ((condExp F L νM₁' / 2 : ℕ) : ℤ)) ≤ valL F L (f + d ^ 2 * g))
    (hx_tr : traceLM F hLM₁' x = -1)
    (hx_norm : normLM F hLM₁' x = -f)
    (hx_sq : x ^ 2 + x = IntermediateField.inclusion hLM₁' f)
    (hx_conj : τ₁ x = -1 - x)
    (hβ₁ : d ^ 2 + 2 * d - 4 * f ≠ 0)
    (α' : Lˣ) (c₀ c₁ : L) (c_θ₁ : M₁'ˣ) (Δ₀ Δ₁ : L)
    (hα'_val : valL F L (α' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hNormPhaseM₁'' : ∀ v : M₁', (v = 0 ∨ ((condExp F L νM₁' / 2 : ℕ) : ℤ) ≤ valL F M₁' v) →
      ψ (((α'⁻¹ : Lˣ) : L) * (d ^ 2 + 2 * d - 4 * f) *
        (traceLM F hLM₁' v + normLM F hLM₁' v)) = 1)
    (hCommM₁'' : ∀ s₀ : L, (s₀ = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L s₀) →
      1 - IntermediateField.inclusion hLM₁' s₀ * x ≠ 0 ∧
      ∀ hu₁ : 1 - IntermediateField.inclusion hLM₁' s₀ * x ≠ 0,
        let u₁ : M₁'ˣ := Units.mk0 (1 - IntermediateField.inclusion hLM₁' s₀ * x) hu₁
        let v₁ : M₁'ˣ := (Units.map τ₁.toRingEquiv.toMonoidHom u₁) * u₁⁻¹
        let a₁ : M₁' := IntermediateField.inclusion hLM₁' (f - d ^ 2 * g) -
          IntermediateField.inclusion hLM₁' (1 + d) * x
        (θM₁' v₁ : Ω F) =
          (traceChar F hLM₁' ψ)
            (IntermediateField.inclusion hLM₁' ((α'⁻¹ : Lˣ) : L) * a₁ * ((v₁ : M₁') - 1)))
    (hc_θ₁_stat : ∀ z : M₁',
      (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (((c_θ₁⁻¹ : M₁'ˣ) : M₁') * z))
    (hc₀_val : c₀ = 0 ∨ -((((condExp F M₁' θM₁' / 2 + condExp F L νM₁' / 2 - 2 * (condExp F L νE' / 2)) / 2 : ℕ) : ℤ)) ≤ valL F L c₀)
    (hc₁_val : c₁ = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) - ((((condExp F M₁' θM₁' / 2 + condExp F L νM₁' / 2 - 2 * (condExp F L νE' / 2) + 1) / 2 : ℕ) : ℤ)) ≤ valL F L c₁)
    (hA_ne : c₀ ^ 2 - c₀ * c₁ - c₁ ^ 2 * (f + g + 4 * f * g) ≠ 0)
    (hA_val : valL F L (c₀ ^ 2 - c₀ * c₁ - c₁ ^ 2 * (f + g + 4 * f * g)) =
      -((condExp F M₁' θM₁' / 2 + condExp F L νM₁' / 2 - 2 * (condExp F L νE' / 2) : ℕ) : ℤ))
    (hΔ_eq :
      let k₀ := 1 + d
      let h₀ := f + g + 4 * f * g
      let a₁ : M₁' := IntermediateField.inclusion hLM₁' (f - d ^ 2 * g) -
        IntermediateField.inclusion hLM₁' k₀ * x
      let A := c₀ ^ 2 - c₀ * c₁ - c₁ ^ 2 * h₀
      let Q₁ : M₁' := IntermediateField.inclusion hLM₁' (c₀ * d + 2 * c₁ * d * g) +
        IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * (1 + d + 4 * d * g)) * x
      IntermediateField.inclusion hLM₁' (α' : L) * ((c_θ₁⁻¹ : M₁'ˣ) : M₁') -
          (a₁ + IntermediateField.inclusion hLM₁' A + Q₁) =
        IntermediateField.inclusion hLM₁' Δ₀ + IntermediateField.inclusion hLM₁' Δ₁ * x)
    (hΔ₀_val : Δ₀ = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) -
      ((((condExp F M₁' θM₁' / 2 + condExp F L νM₁' / 2 - 2 * (condExp F L νE' / 2) + condExp F L νM₁' / 2) / 2 : ℕ) : ℤ)) ≤ valL F L Δ₀)
    (hQ₁_norm :
      let h₀ := f + g + 4 * f * g
      let β₁ := d ^ 2 + 2 * d - 4 * f
      let A := c₀ ^ 2 - c₀ * c₁ - c₁ ^ 2 * h₀
      let Q₁ : M₁' := IntermediateField.inclusion hLM₁' (c₀ * d + 2 * c₁ * d * g) +
        IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * (1 + d + 4 * d * g)) * x
      normLM F hLM₁' Q₁ - β₁ * A =
        c₁ * (1 + 4 * f) * (1 + 4 * g) * (c₀ * d - c₁ * (f + d ^ 2 * g))) :
    let a := condExp F L νM₁' / 2
    let r := condExp F L νE' / 2
    let b₁ := condExp F M₁' θM₁' / 2
    let h := b₁ + a - 2 * r
    let k₀ := 1 + d
    let h₀ := f + g + 4 * f * g
    let a₁ : M₁' := IntermediateField.inclusion hLM₁' (f - d ^ 2 * g) -
      IntermediateField.inclusion hLM₁' k₀ * x
    let A := c₀ ^ 2 - c₀ * c₁ - c₁ ^ 2 * h₀
    let Q₁ : M₁' := IntermediateField.inclusion hLM₁' (c₀ * d + 2 * c₁ * d * g) +
      IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * (1 + d + 4 * d * g)) * x
    let N₁ : M₁' := a₁ + IntermediateField.inclusion hLM₁' A + Q₁
    (N₁ ≠ 0 ∧ valL F M₁' N₁ = -2 * (h : ℤ)) ∧
    (Δ₁ = 0 ∨ 2 * (r : ℤ) - (((b₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L Δ₁) ∧
    (∀ z : M₁', (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (IntermediateField.inclusion hLM₁' (((α'⁻¹ : Lˣ) : L)) * N₁ * z)) :=
by
  dsimp only
  set a := condExp F L νM₁' / 2
  set r := condExp F L νE' / 2
  set b₁ := condExp F M₁' θM₁' / 2
  set h := b₁ + a - 2 * r
  set h_half := h / 2
  set h_ceil := (h + 1) / 2
  set ha_half := (h + a) / 2
  set b₁_ceil := (b₁ + 1) / 2
  set k₀ := 1 + d
  set h₀ := f + g + 4 * f * g
  set β₁ := d ^ 2 + 2 * d - 4 * f
  set ι := IntermediateField.inclusion hLM₁'
  set a₁ : M₁' := ι (f - d ^ 2 * g) - ι k₀ * x
  set A := c₀ ^ 2 - c₀ * c₁ - c₁ ^ 2 * h₀
  set q₀ : L := c₀ * d + 2 * c₁ * d * g
  set q₁ : L := -2 * c₀ + c₁ * (1 + d + 4 * d * g)
  set Q₁ : M₁' := ι q₀ + ι q₁ * x
  set N₁ : M₁' := a₁ + ι A + Q₁
  set Δ : M₁' := ι Δ₀ + ι Δ₁ * x
  have ha_ge1 : 1 ≤ a := by dsimp [a]; omega
  have har : a ≤ r := by dsimp [a, r]; omega
  have h2r_b₁ : 2 * r ≤ b₁ := by dsimp [r, b₁]; omega
  have hah : a ≤ h := by dsimp [h, b₁, a, r]; omega
  have hb₁_eq : b₁ + a = h + 2 * r := by dsimp [h, b₁, a, r]; omega
  have hcond_M₁' : condExp F L νM₁' = 2 * a := by dsimp [a]; omega
  have hcond_E' : condExp F L νE' = 2 * r := by dsimp [r]; omega
  have hcond_θM₁' : condExp F M₁' θM₁' = 2 * b₁ := by dsimp [b₁]; omega
  have hm1_half : (condExp F M₁' θM₁' + 1) / 2 = b₁ := by dsimp [b₁]; omega
  have hh_parts :
      h_half + h_ceil = h ∧ 2 * h_half ≤ h ∧ h ≤ 2 * h_ceil ∧ 2 * h_ceil ≤ h + 1 := by
    dsimp [h_half, h_ceil]; omega
  have hha_parts : 2 * ha_half ≤ h + a ∧ h + a ≤ 2 * ha_half + 1 := by
    dsimp [ha_half]; omega
  have hb₁_parts : r ≤ b₁_ceil ∧ b₁ ≤ 2 * b₁_ceil ∧ 2 * b₁_ceil ≤ b₁ + 1 := by
    dsimp [b₁_ceil, b₁, r]; omega
  have hc₀_or : c₀ = 0 ∨ -(h_half : ℤ) ≤ valL F L c₀ := hc₀_val
  have hc₁_or : c₁ = 0 ∨ (r : ℤ) - (h_ceil : ℤ) ≤ valL F L c₁ := hc₁_val
  have hA_val' : valL F L A = -(h : ℤ) := hA_val
  have hΔ₀_or : Δ₀ = 0 ∨ (r : ℤ) - (ha_half : ℤ) ≤ valL F L Δ₀ := hΔ₀_val
  rcases hvalL_props with ⟨hvalL_0, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv,
    _, hvalL_ultra, _, _, _⟩
  rcases hvalM₁'_props with ⟨hvalM₁'_0, hvalM₁'_1, hvalM₁'_neg1, hvalM₁'_neg, hvalM₁'_mul,
    hvalM₁'_inv, _, hvalM₁'_ultra, _, _, _⟩
  have hvalL_mono : ∀ (m₁ m₂ : ℤ) (s : L),
      (s = 0 ∨ m₁ ≤ valL F L s) → m₂ ≤ m₁ → (s = 0 ∨ m₂ ≤ valL F L s) := by
    intro m₁ m₂ s hs hm
    rcases hs with rfl | hs
    · exact Or.inl rfl
    · exact Or.inr (le_trans hm hs)
  have hvalL_neg_or : ∀ (m : ℤ) (s : L),
      (s = 0 ∨ m ≤ valL F L s) → (-s = 0 ∨ m ≤ valL F L (-s)) := by
    intro m s hs
    rcases hs with rfl | hs
    · simp
    · right; rw [hvalL_neg]; exact hs
  have hvalL_add : ∀ (m m₁ m₂ : ℤ) (s₁ s₂ : L),
      (s₁ = 0 ∨ m₁ ≤ valL F L s₁) → (s₂ = 0 ∨ m₂ ≤ valL F L s₂) →
      m ≤ m₁ → m ≤ m₂ → (s₁ + s₂ = 0 ∨ m ≤ valL F L (s₁ + s₂)) := by
    intro m m₁ m₂ s₁ s₂ hs₁ hs₂ hm₁ hm₂
    exact hvalL_ultra m s₁ s₂ (hvalL_mono m₁ m s₁ hs₁ hm₁) (hvalL_mono m₂ m s₂ hs₂ hm₂)
  have hvalL_sub : ∀ (m m₁ m₂ : ℤ) (s₁ s₂ : L),
      (s₁ = 0 ∨ m₁ ≤ valL F L s₁) → (s₂ = 0 ∨ m₂ ≤ valL F L s₂) →
      m ≤ m₁ → m ≤ m₂ → (s₁ - s₂ = 0 ∨ m ≤ valL F L (s₁ - s₂)) := by
    intro m m₁ m₂ s₁ s₂ hs₁ hs₂ hm₁ hm₂
    rw [sub_eq_add_neg]
    exact hvalL_add m m₁ m₂ s₁ (-s₂) hs₁ (hvalL_neg_or m₂ s₂ hs₂) hm₁ hm₂
  have hvalL_mul_or : ∀ (m m₁ m₂ : ℤ) (s₁ s₂ : L),
      (s₁ = 0 ∨ m₁ ≤ valL F L s₁) → (s₂ = 0 ∨ m₂ ≤ valL F L s₂) →
      m ≤ m₁ + m₂ → (s₁ * s₂ = 0 ∨ m ≤ valL F L (s₁ * s₂)) := by
    intro m m₁ m₂ s₁ s₂ hs₁ hs₂ hm
    by_cases h₁ : s₁ = 0
    · simp [h₁]
    · by_cases h₂ : s₂ = 0
      · simp [h₂]
      · rcases hs₁ with rfl | hs₁
        · contradiction
        · rcases hs₂ with rfl | hs₂
          · contradiction
          · right
            rw [hvalL_mul s₁ s₂ h₁ h₂]
            omega
  have hvalL_sq_or : ∀ (m m₁ : ℤ) (s : L),
      (s = 0 ∨ m₁ ≤ valL F L s) → m ≤ 2 * m₁ → (s ^ 2 = 0 ∨ m ≤ valL F L (s ^ 2)) := by
    intro m m₁ s hs hm
    rw [sq]
