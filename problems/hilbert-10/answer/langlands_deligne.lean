    have hMC_ge1 : IntermediateField.inclusion hLM_C T_E = 0 ∨
        1 ≤ valL F M_C (IntermediateField.inclusion hLM_C T_E) := by
      rcases hTE_ge1 with hTE0 | hge1
      · left
        rw [hTE0, map_zero]
      · right
        rw [hValAlgMCL T_E]
        have hk_int : (1 : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk_ge1
