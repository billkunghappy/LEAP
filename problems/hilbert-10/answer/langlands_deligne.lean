    have hterm2 :
        IntermediateField.inclusion hLE' q₀ * (1 - η) * U₁ = 0 ∨
          B_7 ≤ valL F E' (IntermediateField.inclusion hLE' q₀ * (1 - η) * U₁) := by
      have h1 := hvalE'_mul_ge ((p * m - t₁ : ℕ) : ℤ) (((p - 1) * t₂ : ℕ) : ℤ)
        (IntermediateField.inclusion hLE' q₀) (1 - η) hq₀E'_bpm h1_sub_eta_val
      have h2 := hvalE'_mul_ge (((p * m - t₁ : ℕ) : ℤ) + (((p - 1) * t₂ : ℕ) : ℤ)) 0
        (IntermediateField.inclusion hLE' q₀ * (1 - η)) U₁ h1 hU₁_b0
      apply hvalE'_mono B_7 _ _ _ h2
