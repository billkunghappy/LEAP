            ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
              vM₁'
                ((∑ m ∈ (Finset.range p).erase 0, iLM₁' (τ_val m) ^ r) -
                  (if (p - 1) ∣ r then ((p - 1 : ℕ) : R_M) else 0))),
        let t₁ := bM₁' - 1
        let t₂ := bE' - 1
        let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
        let d₁ := m₁ / 2
        let b := nmM₁'K₁ Δ_val
        let e_fn : ℕ → R_M := fun i => if i = p then b else (-1 : R_M) ^ (i - 1) * e_Δ i
        (∀ D ∈ Finset.Icc 1 p,
          trM₁'K₁ (Δ_val ^ D) - ((D : ℕ) : R_M) * e_fn D = 0 ∨
            2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (D : ℤ) * (t₁ : ℤ) ≤
              vM₁' (trM₁'K₁ (Δ_val ^ D) - ((D : ℕ) : R_M) * e_fn D)) ∧
        (∀ D : ℕ,
          trM₁'K₁ (Δ_val ^ D) = 0 ∨
            ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (D : ℤ) * (t₁ : ℤ) ≤
              vM₁' (trM₁'K₁ (Δ_val ^ D))) ∧
        (∀ D : ℕ, p ≤ D →
          trM₁'K₁ (Δ_val ^ D) = 0 ∨
            ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (D : ℤ) * (t₁ : ℤ) +
              ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤
                vM₁' (trM₁'K₁ (Δ_val ^ D))) ∧
        (∀ x : R_E,
          (x = 0 ∨ (d₁ : ℤ) ≤ (p : ℤ) * vE' x - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ)) →
          let X := nmLE' x
          let P_p := b ^ p +
            ∑ m ∈ (Finset.range p).erase 0,
              nmM₁'K₁ (Δ_val + iM₁'K₁ (iLM₁' (τ_val m))) ^ p
          let Q_p := trM₁'K₁ ((Δ_val ^ p - Δ_val) ^ p)
          iLM₁' X * (P_p - Q_p) = 0 ∨
            ((p * t₂ + 1 : ℕ) : ℤ) ≤
              vM₁' (iLM₁' X * (P_p - Q_p))) := by
    clear * -
    intro R_L R_E R_M R_K _ _ _ _
      iLM₁' iE'K₁ iM₁'K₁ hiLM₁' hiM₁'K₁
      vL vE' vM₁' vK₁ trM₁'K₁ nmLE' nmM₁'K₁
      p hPrime hp_odd bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le
      hp_valK₁ hvalE'_1
      hvalM₁'_1 hvalM₁'_neg1 hvalM₁'_neg hvalM₁'_mul hvalM₁'_surj hvalM₁'_add
      hvalK₁_1 hvalK₁_neg hvalK₁_mul hvalK₁_add
      hval_norm_LE' hval_LM₁' hval_M₁'K₁ hval_norm_M₁'K₁
      htr_M₁'K₁ htr_smul_M₁'K₁ htr_incl_M₁'K₁ hnorm_incl_M₁'K₁ hnorm_zero_LE'
      s₁ hs₁_norm_one_add hs₁_cayley hs₁_newton1
      Δ_val hΔ_val hTwistedTr e_Δ he_Δ_val he_Δ_poly he_Δ_cayley
      τ_val hτ_ne0 hτ_val0 hτ_p1 hτ_pow_sum
    have hvalM₁'_sub : ∀ (k : ℤ) (x y : R_M),
        (x = 0 ∨ k ≤ vM₁' x) → (y = 0 ∨ k ≤ vM₁' y) →
          (x - y = 0 ∨ k ≤ vM₁' (x - y)) := by
      intro k x y hx hy
      rw [sub_eq_add_neg]
      refine hvalM₁'_add k x (-y) hx ?_
      rcases hy with rfl | hy
      · exact Or.inl neg_zero
      · exact Or.inr (by rwa [hvalM₁'_neg])
    have hvalM₁'_mono : ∀ (k₁ k₂ : ℤ) (x : R_M),
        k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ vM₁' x) → (x = 0 ∨ k₁ ≤ vM₁' x) := by
      intro k₁ k₂ x hle hx
      rcases hx with rfl | hx
      · exact Or.inl rfl
      · exact Or.inr (le_trans hle hx)
    have hvalM₁'_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : R_M),
        (x = 0 ∨ k₁ ≤ vM₁' x) → (y = 0 ∨ k₂ ≤ vM₁' y) →
          (x * y = 0 ∨ k₁ + k₂ ≤ vM₁' (x * y)) := by
      intro k₁ k₂ x y hx hy
      by_cases hx0 : x = 0
      · left; rw [hx0, zero_mul]
      · by_cases hy0 : y = 0
        · left; rw [hy0, mul_zero]
        · right
          rw [hvalM₁'_mul x y hx0 hy0]
          exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
    have hvalM₁'_pow_ge : ∀ (x : R_M) (n : ℕ) (q : ℤ),
        (x = 0 ∨ q ≤ vM₁' x) → (x ^ n = 0 ∨ (n : ℤ) * q ≤ vM₁' (x ^ n)) := by
      intro x n q hx
      induction n with
      | zero =>
        right
        rw [pow_zero, hvalM₁'_1, Nat.cast_zero, zero_mul]
      | succ n ih =>
        rw [pow_succ]
        have hmul := hvalM₁'_mul_ge ((n : ℤ) * q) q (x ^ n) x ih hx
        have heq : ((n + 1 : ℕ) : ℤ) * q = (n : ℤ) * q + q := by push_cast; ring
        rwa [heq]
    have hvalM₁'_pow_eq : ∀ (x : R_M) (hx : x ≠ 0) (n : ℕ),
        x ^ n ≠ 0 ∧ vM₁' (x ^ n) = (n : ℤ) * vM₁' x := by
      intro x hx n
      induction n with
      | zero =>
        rw [pow_zero]
        refine ⟨one_ne_zero, ?_⟩
        rw [hvalM₁'_1, Nat.cast_zero, zero_mul]
      | succ n ih =>
        refine ⟨pow_ne_zero (n + 1) hx, ?_⟩
        rw [pow_succ', hvalM₁'_mul x (x ^ n) hx ih.1, ih.2]
        push_cast
        ring
    have hvalM₁'_neg1_pow_mul : ∀ (n : ℕ) (x : R_M),
        vM₁' ((-1 : R_M) ^ n * x) = vM₁' x := by
      intro n x
      induction n with
      | zero => rw [pow_zero, one_mul]
      | succ n ih =>
        rw [pow_succ', mul_assoc, neg_one_mul, hvalM₁'_neg, ih]
    have hvalM₁'_sum_ge : ∀ (S : Finset ℕ) (f : ℕ → R_M) (k : ℤ),
        (∀ i ∈ S, f i = 0 ∨ k ≤ vM₁' (f i)) →
          ((∑ i ∈ S, f i) = 0 ∨ k ≤ vM₁' (∑ i ∈ S, f i)) := by
      intro S f k hf
      induction' S using Finset.induction_on with i S hi ih
      · left; exact Finset.sum_empty
      · rw [Finset.sum_insert hi]
        exact hvalM₁'_add k (f i) (∑ j ∈ S, f j)
          (hf i (Finset.mem_insert_self i S))
          (ih (fun j hj => hf j (Finset.mem_insert_of_mem hj)))
    have hvalM₁'_natCast : ∀ n : ℕ, (n : R_M) = 0 ∨ (0 : ℤ) ≤ vM₁' (n : R_M) := by
      intro n
      induction n with
      | zero => left; exact Nat.cast_zero
      | succ n ih =>
        rw [Nat.cast_succ]
        exact hvalM₁'_add 0 (n : R_M) 1 ih (Or.inr (by rw [hvalM₁'_1]))

    have hvalK₁_mono : ∀ (k₁ k₂ : ℤ) (x : R_K),
        k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ vK₁ x) → (x = 0 ∨ k₁ ≤ vK₁ x) := by
      intro k₁ k₂ x hle hx
      rcases hx with rfl | hx
      · exact Or.inl rfl
      · exact Or.inr (le_trans hle hx)
    have hvalK₁_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : R_K),
        (x = 0 ∨ k₁ ≤ vK₁ x) → (y = 0 ∨ k₂ ≤ vK₁ y) →
          (x * y = 0 ∨ k₁ + k₂ ≤ vK₁ (x * y)) := by
      intro k₁ k₂ x y hx hy
      by_cases hx0 : x = 0
      · left; rw [hx0, zero_mul]
      · by_cases hy0 : y = 0
        · left; rw [hy0, mul_zero]
        · right
          rw [hvalK₁_mul x y hx0 hy0]
          exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
    have hvalK₁_pow_ge : ∀ (x : R_K) (n : ℕ) (q : ℤ),
        (x = 0 ∨ q ≤ vK₁ x) → (x ^ n = 0 ∨ (n : ℤ) * q ≤ vK₁ (x ^ n)) := by
      intro x n q hx
      induction n with
      | zero =>
        right
        rw [pow_zero, hvalK₁_1, Nat.cast_zero, zero_mul]
      | succ n ih =>
        rw [pow_succ]
        have hmul := hvalK₁_mul_ge ((n : ℤ) * q) q (x ^ n) x ih hx
        have heq : ((n + 1 : ℕ) : ℤ) * q = (n : ℤ) * q + q := by push_cast; ring
        rwa [heq]
    have hvalK₁_neg1_pow_mul : ∀ (n : ℕ) (x : R_K),
        vK₁ ((-1 : R_K) ^ n * x) = vK₁ x := by
      intro n x
      induction n with
      | zero => rw [pow_zero, one_mul]
      | succ n ih =>
        rw [pow_succ', mul_assoc, neg_one_mul, hvalK₁_neg, ih]
    have hvalK₁_sum_ge : ∀ (S : Finset ℕ) (f : ℕ → R_K) (k : ℤ),
