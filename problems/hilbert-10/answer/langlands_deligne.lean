    have h_idx2 : r₁ + 1 = t + 1 + q₁ * (m - t) := by omega
    obtain ⟨w₁, hw₁, he₀⟩ := hnorm_gt_surj_M1MC m hm u hu
    obtain ⟨w, hw, he₁⟩ := hnorm_gt_surj_KM1 r₁ hr1_ge w₁ hw₁
    refine ⟨w, h_idx1 ▸ hw, ?_⟩
    rw [h_idx2] at he₁
    have he₂ : Units.map (normLM F hMC_M1) ((Units.map (normLM F hM1_K) w) * w₁⁻¹) ∈
        unitGroup F M_C (m + 1) :=
      hnorm_gt_le_M1MC m hm _ he₁
    have hmul_eq : (Units.map (normLM F hM_CK) w) * u⁻¹ =
        Units.map (normLM F hMC_M1) ((Units.map (normLM F hM1_K) w) * w₁⁻¹) *
          ((Units.map (normLM F hMC_M1) w₁) * u⁻¹) := by
      rw [hnorm_units_trans w, map_mul, map_inv, mul_assoc, inv_mul_cancel_left]
    rw [hmul_eq]
    exact (unitGroup F M_C (m + 1)).mul_mem he₂ he₀
  · 
    let b₀ : M_1 := (((ϖ_M1 ^ t)⁻¹ : M_1ˣ) : M_1) * traceLM F hM1_K ((ϖ_K ^ t : Kˣ) : K)
    have hb₀_int : P_M1 0 b₀ := Or.inr (by rw [hb₀_val])
    obtain ⟨b₀_MC, hb0_MC_int, hb0_diff⟩ := hResLiftM1 b₀ hb₀_int
    let f₁ : Fin (r + 1) → M_C := fun k =>
      if hk : k.1 < r then
        c_coeff ⟨k.1, hk⟩ * (b₀_MC ^ ((p F) ^ k.1))
      else
        b₀_MC ^ ((p F) ^ r)
    let f₂ : Fin (r + 1) → M_C := fun k =>
      if _ : k.1 = 0 then
