    · have hd_ge1 : d = 0 ∨ valL F L 1 + 1 ≤ valL F L d := by
        right
        rw [hval1, hd_val]
        omega
      have hdom := hL_dom (one_ne_zero : (1 : L) ≠ 0) hd_ge1
      rw [hval1] at hdom
      exact hdom
  have hk₀_ne : 1 + d ≠ 0 := hk₀.1
  have hk₀_val : valL F L (1 + d) = 0 := hk₀.2
  have hk₀2_ne : -((1 + d) ^ 2) ≠ 0 := neg_ne_zero.mpr (pow_ne_zero 2 hk₀_ne)
  have hk₀2_val : valL F L (-((1 + d) ^ 2)) = 0 := by
    rw [hval_neg, sq, hval_mul (1 + d) (1 + d) hk₀_ne hk₀_ne, hk₀_val, add_zero]
  have h2k₀_ge : 2 * (1 + d) = 0 ∨ valL F L (-((1 + d) ^ 2)) + 1 ≤ valL F L (2 * (1 + d)) := by
    have h1 := hL_mul h2_val (Or.inr (by rw [hk₀_val] : (0 : ℤ) ≤ valL F L (1 + d)))
