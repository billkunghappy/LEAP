    · exact Or.inr (le_trans hle hx)
  let G_sub : ℕ → Subgroup G := fun i =>
    { carrier := {σ : G | ∀ x : K, P 0 x → P (i + 1 : ℤ) (δ σ x)}
      one_mem' := by
        intro x _
        dsimp [δ]
        rw [map_one, AlgEquiv.one_apply, sub_self]
        exact hP_zero _
      mul_mem' := by
        intro σ τ hσ hτ x hx
        have hτx : P 0 (act τ x) := (hP_map 0 (act τ) x).mpr hx
        have h1 : P (i + 1 : ℤ) (δ σ (act τ x)) := hσ (act τ x) hτx
        have h2 : P (i + 1 : ℤ) (δ τ x) := hτ x hx
        have heq : δ (σ * τ) x = δ σ (act τ x) + δ τ x := by
          dsimp [δ]
          rw [map_mul, AlgEquiv.mul_apply]
          ring
        rw [heq]
        exact hP_add (i + 1 : ℤ) h1 h2
      inv_mem' := by
        intro σ hσ x hx
        set y : K := act σ⁻¹ x
        have hy : P 0 y := (hP_map 0 (act σ⁻¹) x).mpr hx
        have hσy : P (i + 1 : ℤ) (δ σ y) := hσ y hy
        have heq : δ σ⁻¹ x = - δ σ y := by
          dsimp [δ, y]
          rw [h_act_mul σ σ⁻¹, mul_inv_cancel, map_one, AlgEquiv.one_apply]
          ring
        rw [heq]
        exact hP_neg (i + 1 : ℤ) hσy }
  have hGi_norm : ∀ i : ℕ, (G_sub i).Normal := by
    intro i
    refine ⟨fun σ hσ γ x hx => ?_⟩
    set y : K := act γ⁻¹ x
    have hy : P 0 y := (hP_map 0 (act γ⁻¹) x).mpr hx
    have hσy : P (i + 1 : ℤ) (δ σ y) := hσ y hy
    have heq : δ (γ * σ * γ⁻¹) x = act γ (δ σ y) := by
      dsimp [δ, y]
      rw [map_sub, h_act_mul γ σ, h_act_mul (γ * σ) γ⁻¹, h_act_mul γ γ⁻¹,
        mul_inv_cancel, map_one, AlgEquiv.one_apply]
    rw [heq]
    exact (hP_map (i + 1 : ℤ) (act γ) (δ σ y)).mpr hσy
  have hG_anti : ∀ {i j : ℕ}, i ≤ j → G_sub j ≤ G_sub i := by
    intro i j hij σ hσ x hx
    exact hP_mono (by omega) (hσ x hx)
  have hG_sep : ∀ σ : G, (∀ i : ℕ, σ ∈ G_sub i) → σ = 1 := by
    intro σ hσ
    by_contra hne
    have hact_ne : act σ ≠ 1 := fun h => hne (hact_inj (h.trans (map_one act).symm))
    have hex0 : ∃ x₀ : K, act σ x₀ ≠ x₀ := by
      by_contra hall
      push_neg at hall
      exact hact_ne (AlgEquiv.ext hall)
    obtain ⟨x₀, hx₀⟩ := hex0
    have hx₀_ne : x₀ ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hx₀
      exact hx₀ rfl
    have hex_O : ∃ x : K, P 0 x ∧ act σ x ≠ x := by
      by_cases hval_ge : 0 ≤ valL F K x₀
      · exact ⟨x₀, Or.inr hval_ge, hx₀⟩
      · let u₀ : Kˣ := Units.mk0 x₀ hx₀_ne
        set x : K := ((u₀⁻¹ : Kˣ) : K)
        have hx_eq : x = x₀⁻¹ := by
          change ((u₀⁻¹ : Kˣ) : K) = x₀⁻¹
          rw [Units.val_inv_eq_inv_val, Units.val_mk0]
        have hx_val : 0 ≤ valL F K x := by
          dsimp [x]
          rw [hval_inv u₀, Units.val_mk0]
          omega
        have hx_ne : act σ x ≠ x := by
          rw [hx_eq, map_inv₀]
          exact fun h => hx₀ (inv_inj.mp h)
        exact ⟨x, Or.inr hx_val, hx_ne⟩
    obtain ⟨x, hxP, hσx_ne⟩ := hex_O
    set d : K := δ σ x
    have hd_ne : d ≠ 0 := sub_ne_zero.mpr hσx_ne
    set i₀ : ℕ := (valL F K d).toNat
    have hd_mem : P (i₀ + 1 : ℤ) d := hσ i₀ x hxP
    have hd_le : (i₀ + 1 : ℤ) ≤ valL F K d := hd_mem.resolve_left hd_ne
    omega
  let idx : G → ℕ := fun σ =>
    if h : ∃ i : ℕ, σ ∉ G_sub i then h.choose else 0
  let N : ℕ := (Finset.univ : Finset G).sup idx
  have hGN_bot : G_sub N = ⊥ := by
    rw [Subgroup.eq_bot_iff_forall]
    intro σ hσN
    by_contra hne
    have hex : ∃ i : ℕ, σ ∉ G_sub i := by
      by_contra hall
      push_neg at hall
      exact hne (hG_sep σ hall)
    have hidx : idx σ = hex.choose := dif_pos hex
    have hnot : σ ∉ G_sub (idx σ) := hidx ▸ hex.choose_spec
    have hle : idx σ ≤ N := Finset.le_sup (f := idx) (Finset.mem_univ σ)
    exact hnot (hG_anti hle hσN)
  obtain ⟨π_K, hπ_val⟩ := hval_surj 1
  set π : K := (π_K : K)
  set π_inv : K := ((π_K⁻¹ : Kˣ) : K)
  have hπ_mul : π * π_inv = 1 := by exact_mod_cast Units.mul_inv π_K
  have hπ_inv_mul : π_inv * π = 1 := by exact_mod_cast Units.inv_mul π_K
  have hP1_π : P 1 π := Or.inr (by omega)
  have hP0_π : P 0 π := Or.inr (by omega)
  have hπ_inv_val : valL F K π_inv = -1 := by
    dsimp [π_inv]
    rw [hval_inv π_K, hπ_val]
  have hP_div_pi : ∀ (k : ℤ) {z : K}, P (k + 1) z → P k (π_inv * z) := by
    intro k z hz
    have hπ_inv_P : P (-1) π_inv := Or.inr (by omega)
    have h1 := hP_mul hπ_inv_P hz
    have heq : (-1 : ℤ) + (k + 1) = k := by omega
    rwa [heq] at h1
  have h_comm_G : ∀ σ τ : G, σ * τ * σ⁻¹ * τ⁻¹ ∈ G_sub 0 := by
    intro σ τ x hx
    set w : K := act (σ⁻¹ * τ⁻¹) x
    have hw : P 0 w := (hP_map 0 (act (σ⁻¹ * τ⁻¹)) x).mpr hx
    have hres : P 1 (act σ (act τ w) - act τ (act σ w)) :=
      h_res_comm (act σ) (act τ) w hw
    have heq : δ (σ * τ * σ⁻¹ * τ⁻¹) x = act σ (act τ w) - act τ (act σ w) := by
      dsimp [δ, w]
      simp only [h_act_mul]
      have hgrp1 : σ * (τ * (σ⁻¹ * τ⁻¹)) = σ * τ * σ⁻¹ * τ⁻¹ := by group
      have hgrp2 : τ * (σ * (σ⁻¹ * τ⁻¹)) = 1 := by group
      rw [hgrp1, hgrp2, map_one, AlgEquiv.one_apply]
    simpa [heq] using hres
  have h_delta_step : ∀ {i : ℕ}, 1 ≤ i → ∀ {σ : G}, σ ∈ G_sub i →
      ∀ {z : K}, P (i + 1 : ℤ) z → P (i + 2 : ℤ) (δ σ z) := by
    intro i hi σ hσ z hz
    set y : K := π_inv * z
    have hy_i : P (i : ℤ) y := hP_div_pi (i : ℤ) hz
    have hy_1 : P 1 y := hP_mono (by omega) hy_i
    have hy_0 : P 0 y := hP_mono (by omega) hy_i
    have hzy : z = π * y := by
      dsimp [y]
      rw [← mul_assoc, hπ_mul, one_mul]
    have h_leib : δ σ z = δ σ π * act σ y + π * δ σ y := by
      rw [hzy]
      dsimp [δ]
      rw [map_mul]
      ring
    have hterm1 : P ((i + 1 : ℤ) + 1) (δ σ π * act σ y) :=
      hP_mul (hσ π hP0_π) ((hP_map 1 (act σ) y).mpr hy_1)
    have hterm2 : P (1 + (i + 1 : ℤ)) (π * δ σ y) :=
      hP_mul hP1_π (hσ y hy_0)
    have hterm1' : P (i + 2 : ℤ) (δ σ π * act σ y) := by
      simpa [show (i + 1 : ℤ) + 1 = (i + 2 : ℤ) by ring] using hterm1
    have hterm2' : P (i + 2 : ℤ) (π * δ σ y) := by
      simpa [show (1 : ℤ) + (i + 1 : ℤ) = (i + 2 : ℤ) by ring] using hterm2
    rw [h_leib]
    exact hP_add (i + 2 : ℤ) hterm1' hterm2'
  have h_comm_Gi : ∀ i : ℕ, 1 ≤ i → ∀ σ ∈ G_sub i, ∀ τ ∈ G_sub i,
      σ * τ * σ⁻¹ * τ⁻¹ ∈ G_sub (i + 1) := by
    intro i hi σ hσ τ hτ x hx
    set w : K := act (σ⁻¹ * τ⁻¹) x
    have hw : P 0 w := (hP_map 0 (act (σ⁻¹ * τ⁻¹)) x).mpr hx
    have h1 : P (i + 2 : ℤ) (δ σ (δ τ w)) := h_delta_step hi hσ (hτ w hw)
    have h2 : P (i + 2 : ℤ) (δ τ (δ σ w)) := h_delta_step hi hτ (hσ w hw)
    have hdiff : P (i + 2 : ℤ) (δ σ (δ τ w) - δ τ (δ σ w)) := hP_sub (i + 2 : ℤ) h1 h2
    have heq : δ (σ * τ * σ⁻¹ * τ⁻¹) x = δ σ (δ τ w) - δ τ (δ σ w) := by
      dsimp [δ, w]
      simp only [map_sub, h_act_mul]
      have hgrp1 : σ * (τ * (σ⁻¹ * τ⁻¹)) = σ * τ * σ⁻¹ * τ⁻¹ := by group
      have hgrp2 : τ * (σ * (σ⁻¹ * τ⁻¹)) = 1 := by group
      rw [hgrp1, hgrp2, map_one, AlgEquiv.one_apply]
      ring
    simpa [heq, show ((i + 1 : ℕ) : ℤ) + 1 = (i + 2 : ℤ) by push_cast; ring] using hdiff
  have h_G1_of_pi : ∀ {γ : G}, γ ∈ G_sub 0 → P 2 (δ γ π) → γ ∈ G_sub 1 := by
    intro γ hγ0 hγπ x hx
    obtain ⟨s, hs0, hxs⟩ := h_frob_surj x hx
    set z : K := π_inv * (x - s ^ (p F))
    have hz0 : P 0 z := hP_div_pi 0 hxs
    have hx_decomp : x = s ^ (p F) + π * z := by
      dsimp [z]
      rw [← mul_assoc, hπ_mul, one_mul]
      ring
    have hγs_eq : act γ s = s + δ γ s := by dsimp [δ]; ring
    have hδx_eq : δ γ x = ((s + δ γ s) ^ (p F) - s ^ (p F)) + δ γ π * act γ z + π * δ γ z := by
      conv_lhs => rw [hx_decomp]
      dsimp [δ]
      rw [map_add, map_pow, map_mul, ← hγs_eq]
      ring
    have hterm1 : P 2 ((s + δ γ s) ^ (p F) - s ^ (p F)) :=
      h_pow_diff s (δ γ s) hs0 (hγ0 s hs0)
    have hterm2 : P (2 + 0) (δ γ π * act γ z) :=
      hP_mul hγπ ((hP_map 0 (act γ) z).mpr hz0)
    have hterm3 : P (1 + 1) (π * δ γ z) :=
      hP_mul hP1_π (hγ0 z hz0)
    rw [hδx_eq]
    exact hP_add 2 (hP_add 2 hterm1 hterm2) hterm3
  have h_pi_comm_pair : ∀ {g h : G}, g ∈ G_sub 0 → h ∈ G_sub 0 →
      P 2 (act (g * h) π - act (h * g) π) := by
    intro g h hg hh
    let u : G → K := fun σ => act σ π * π_inv
    have hu_P0 : ∀ {σ : G}, σ ∈ G_sub 0 → P 0 (u σ) := by
      intro σ hσ
      have h1 : P (1 + (-1)) (δ σ π * π_inv) :=
        hP_mul (hσ π hP0_π) (Or.inr (by omega))
      have heq : u σ = (δ σ π * π_inv) + 1 := by
        dsimp [u, δ]
        rw [sub_mul, hπ_mul]
        ring
      rw [heq]
      exact hP_add 0 h1 (Or.inr (by omega))
    have hu_mul : ∀ σ : G, u σ * π = act σ π := by
      intro σ
      dsimp [u]
      rw [mul_assoc, hπ_inv_mul, mul_one]
    have hgh_eq : act (g * h) π - act (h * g) π =
        (δ g (u h) * u g - δ h (u g) * u h) * π := by
      have h1 : act (g * h) π = act g (u h) * (u g * π) := by
        rw [map_mul, AlgEquiv.mul_apply, ← hu_mul h, map_mul, hu_mul g]
      have h2 : act (h * g) π = act h (u g) * (u h * π) := by
        rw [map_mul, AlgEquiv.mul_apply, ← hu_mul g, map_mul, hu_mul h]
      rw [h1, h2]
      dsimp [δ]
      ring
    have hug0 : P 0 (u g) := hu_P0 hg
    have huh0 : P 0 (u h) := hu_P0 hh
    have hterm1 : P (1 + 0) (δ g (u h) * u g) := hP_mul (hg (u h) huh0) hug0
    have hterm2 : P (1 + 0) (δ h (u g) * u h) := hP_mul (hh (u g) hug0) huh0
    have hdiff : P 1 (δ g (u h) * u g - δ h (u g) * u h) := hP_sub 1 hterm1 hterm2
    rw [hgh_eq]
    exact hP_mul hdiff hP1_π
  have h_comm_G0 : ∀ σ ∈ G_sub 0, ∀ τ ∈ G_sub 0, σ * τ * σ⁻¹ * τ⁻¹ ∈ G_sub 1 := by
    intro σ hσ τ hτ
    set γ : G := σ * τ * σ⁻¹ * τ⁻¹
    have hγ0 : γ ∈ G_sub 0 := h_comm_G σ τ
    have hpair : P 2 (act (σ⁻¹ * τ⁻¹) π - act (τ⁻¹ * σ⁻¹) π) :=
      h_pi_comm_pair ((G_sub 0).inv_mem hσ) ((G_sub 0).inv_mem hτ)
    have hmap : P 2 (act (σ * τ) (act (σ⁻¹ * τ⁻¹) π - act (τ⁻¹ * σ⁻¹) π)) :=
      (hP_map 2 (act (σ * τ)) _).mpr hpair
    have heq : act (σ * τ) (act (σ⁻¹ * τ⁻¹) π - act (τ⁻¹ * σ⁻¹) π) = δ γ π := by
      dsimp [δ, γ]
      rw [map_sub, h_act_mul, h_act_mul]
      have hgrp1 : (σ * τ) * (σ⁻¹ * τ⁻¹) = σ * τ * σ⁻¹ * τ⁻¹ := by group
      have hgrp2 : (σ * τ) * (τ⁻¹ * σ⁻¹) = 1 := by group
      rw [hgrp1, hgrp2, map_one, AlgEquiv.one_apply]
    rw [heq] at hmap
    exact h_G1_of_pi hγ0 hmap
  have h_ab_of_comm_bot : ∀ {H : Subgroup G} {a b : G},
      H = ⊥ → a * b * a⁻¹ * b⁻¹ ∈ H → a * b = b * a := by
    intro H a b hH hmem
    rw [hH, Subgroup.mem_bot] at hmem
    have h1 : a * b * a⁻¹ = b := eq_of_mul_inv_eq_one hmem
    have h2 : a * b = b * a := by
      calc a * b = (a * b * a⁻¹) * a := by group
        _ = b * a := by rw [h1]
    exact h2
  by_cases hG0 : G_sub 0 = ⊥
  · refine ⟨⊤, inferInstance, ?_, ?_⟩
    · obtain ⟨g₀, hg₀⟩ := hG_ne
      exact ⟨g₀, Subgroup.mem_top g₀, hg₀⟩
    · intro a _ b _
      exact h_ab_of_comm_bot hG0 (h_comm_G a b)
  · by_cases hG1 : G_sub 1 = ⊥
    · refine ⟨G_sub 0, hGi_norm 0, ?_, ?_⟩
      · rw [Subgroup.eq_bot_iff_forall] at hG0
        push_neg at hG0
        exact hG0
      · intro a ha b hb
        exact h_ab_of_comm_bot hG1 (h_comm_G0 a ha b hb)
    · have hGN1_bot : G_sub (N + 1) = ⊥ :=
        eq_bot_mono (hG_anti (Nat.le_succ N)) hGN_bot
      have h_find : ∀ k : ℕ, G_sub (k + 1) = ⊥ → G_sub 1 ≠ ⊥ →
          ∃ i : ℕ, 1 ≤ i ∧ G_sub i ≠ ⊥ ∧ G_sub (i + 1) = ⊥ := by
        intro k
        induction k with
        | zero =>
          intro h1 hne
          exact False.elim (hne h1)
        | succ k ih =>
          intro hk2 hne
          by_cases hk1 : G_sub (k + 1) = ⊥
          · exact ih hk1 hne
          · exact ⟨k + 1, by omega, hk1, hk2⟩
      obtain ⟨i, hi_1, hGi_ne, hGi1_bot⟩ := h_find N hGN1_bot hG1
      refine ⟨G_sub i, hGi_norm i, ?_, ?_⟩
      · rw [ne_eq, Subgroup.eq_bot_iff_forall] at hGi_ne
        push_neg at hGi_ne
        exact hGi_ne
      · intro a ha b hb
        exact h_ab_of_comm_bot hGi1_bot (h_comm_Gi i hi_1 a ha b hb)

theorem ld_galois_normal_fixedField_and_weil_proj (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K)
    (C : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    [C.Normal] (hC_ne : ∃ c ∈ C, c ≠ 1) :
    FiniteDimensional F L ∧
    FiniteDimensional F K ∧
    IsGalois L (IntermediateField.extendScalars hLK) ∧
    (∃ (π : relWeil F L →* (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK)),
      (∀ (w : relWeil F L) (x : IntermediateField.extendScalars hLK),
        ((π w x : IntermediateField.extendScalars hLK) : AlgebraicClosure F) =
          (w : AbsGal F) (x : AlgebraicClosure F)) ∧
      Function.Surjective π) ∧
    ∃ (hLM_C : L ≤ (IntermediateField.lift (IntermediateField.fixedField C)).restrictScalars F),
      (IntermediateField.lift (IntermediateField.fixedField C)).restrictScalars F ≤ K ∧
      IsGaloisExt F L ((IntermediateField.lift (IntermediateField.fixedField C)).restrictScalars F) ∧
      Module.finrank L (IntermediateField.extendScalars hLM_C) <
        Module.finrank L (IntermediateField.extendScalars hLK) :=
by
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (K' : IntermediateField k Ω_bar) [hSepK' : Algebra.IsSeparable k K'],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x) →
      IsGalois k K' := by
    intro k Ω_bar _ _ _ _ K' hSepK' h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK'N : K' ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K' := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K' _ _ _ hSepK' x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K'.val K'.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k N := K'.comap N.val
    have hKN_map : K_N.map N.val = K' := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK'N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K', τ x = x := by
        intro x hx
        let z : N := ⟨x, hK'N hx⟩
        have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
        have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : K_N.fixingSubgroup.Normal := hKN_norm
    haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k] ↥K' := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN
  let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
  let G := (K' ≃ₐ[L] K')
  have hFinK : FiniteDimensional F K := hGal.2.1
  haveI : FiniteDimensional F K := hFinK
  have hFinL : FiniteDimensional F L :=
    Module.Finite.of_injective (IntermediateField.inclusion hLK).toLinearMap
      (IntermediateField.inclusion hLK).injective
  haveI : FiniteDimensional F L := hFinL
  haveI : FiniteDimensional F K' := hFinK
  haveI : IsScalarTower F L K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L K' := Module.Finite.of_restrictScalars_finite F L K'
  have hSepLK : Algebra.IsSeparable L K' := hGal.2.2.2 hLK
  haveI : Algebra.IsSeparable L K' := hSepLK
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
  have hK'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F),
      (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x := by
    intro σ τ hτ
    let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
    let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
    have hτK : τ_F.1 ∈ K.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      exact hτ x ((IntermediateField.mem_extendScalars hLK).mpr hx)
    have hconjK : (σ_F * τ_F * σ_F⁻¹).1 ∈ K.fixingSubgroup :=
      hGal.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτK
    intro x hx
    rw [IntermediateField.mem_fixingSubgroup_iff] at hconjK
    exact hconjK x ((IntermediateField.mem_extendScalars hLK).mp hx)
  have hGalLK : IsGalois L ↥K' := helper_isGalois L (AlgebraicClosure F) K' hK'_norm_fix
  haveI : IsGalois L ↥K' := hGalLK
  haveI : Normal L ↥K' := IsGalois.to_normal
  let π : relWeil F L →* G :=
    (AlgEquiv.restrictNormalHom K').comp
      ((IntermediateField.fixingSubgroupEquiv L).toMonoidHom.comp
        (Subgroup.inclusion (inf_le_right : relWeil F L ≤ L.fixingSubgroup)))
  have hπ : ∀ (w : relWeil F L) (x : K'),
      ((π w x : K') : AlgebraicClosure F) = (w : AbsGal F) (x : AlgebraicClosure F) := by
    intro w x
    change ((AlgEquiv.restrictNormalHom K'
      ((IntermediateField.fixingSubgroupEquiv L) ⟨w.1, w.2.2⟩) x : K') : AlgebraicClosure F) =
      (w : AbsGal F) (x : AlgebraicClosure F)
    rw [AlgEquiv.restrictNormalHom_apply]
    rfl
  let H_KL : Subgroup (relWeil F L) := (relWeil F K).subgroupOf (relWeil F L)
  let bar_π : (relWeil F L ⧸ H_KL) → G := fun u => π (cosetRep u)
  have h_ker_π : ∀ w : relWeil F L, π w = 1 → w ∈ H_KL := by
    intro w hw
    rw [Subgroup.mem_subgroupOf]
    refine Subgroup.mem_inf.mpr ⟨w.2.1, ?_⟩
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr hz⟩
    have h1 := hπ w x
    rw [hw] at h1
    exact h1.symm
  have hbar_π_inj : Function.Injective bar_π := by
    intro u₁ u₂ h_eq
    change π (cosetRep u₁) = π (cosetRep u₂) at h_eq
    have h1 : π ((cosetRep u₁)⁻¹ * cosetRep u₂) = 1 := by
      rw [map_mul, map_inv, h_eq, inv_mul_cancel]
    have h2 : (cosetRep u₁)⁻¹ * cosetRep u₂ ∈ H_KL := h_ker_π _ h1
    have h3 : (QuotientGroup.mk (cosetRep u₁) : relWeil F L ⧸ H_KL) =
        QuotientGroup.mk (cosetRep u₂) := QuotientGroup.eq.mpr h2
    have h_out1 : (QuotientGroup.mk (cosetRep u₁) : relWeil F L ⧸ H_KL) = u₁ :=
      Quotient.out_eq u₁
    have h_out2 : (QuotientGroup.mk (cosetRep u₂) : relWeil F L ⧸ H_KL) = u₂ :=
      Quotient.out_eq u₂
    rw [h_out1, h_out2] at h3
    exact h3
  obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
  obtain ⟨hFin_quot, hCard_quot⟩ :=
    ld_relWeil_quotient_card_eq_finrank F hp hFrob L K hLK hSepLK
  letI : Finite (relWeil F L ⧸ H_KL) := hFin_quot
  letI : Fintype (relWeil F L ⧸ H_KL) := Fintype.ofFinite (relWeil F L ⧸ H_KL)
  have h_card_eq : Fintype.card (relWeil F L ⧸ H_KL) = Fintype.card G := by
    rw [← Nat.card_eq_fintype_card, hCard_quot, ← IsGalois.card_aut_eq_finrank L K',
      Nat.card_eq_fintype_card]
  have hbar_π_bij : Function.Bijective bar_π :=
    (Fintype.bijective_iff_injective_and_card bar_π).mpr ⟨hbar_π_inj, h_card_eq⟩
  have hsurj : Function.Surjective π := by
    intro g
    obtain ⟨u, hu⟩ := hbar_π_bij.2 g
    exact ⟨cosetRep u, hu⟩
  let E₀ : IntermediateField L K' := IntermediateField.fixedField C
  let E_L : IntermediateField L (AlgebraicClosure F) := IntermediateField.lift E₀
  let M_C : IntermediateField F (AlgebraicClosure F) := E_L.restrictScalars F
  have hLM_C : L ≤ M_C := by
    intro z hz
    rw [IntermediateField.mem_restrictScalars]
    exact E_L.algebraMap_mem ⟨z, hz⟩
  have hM_CK : M_C ≤ K := by
    intro z hz
    rw [IntermediateField.mem_restrictScalars] at hz
    exact (IntermediateField.mem_extendScalars hLK).mp (IntermediateField.lift_le E₀ hz)
  have h_mem_MC : ∀ x : K', (x : AlgebraicClosure F) ∈ M_C ↔ x ∈ E₀ := by
    intro x
    exact (IntermediateField.mem_restrictScalars F).trans (IntermediateField.mem_lift x)
  haveI : FiniteDimensional F M_C :=
    Module.Finite.of_injective (IntermediateField.inclusion hM_CK).toLinearMap
      (IntermediateField.inclusion hM_CK).injective
  let res_L : L.fixingSubgroup →* G :=
    (AlgEquiv.restrictNormalHom K').comp (IntermediateField.fixingSubgroupEquiv L).toMonoidHom
  have h_res_L_apply : ∀ (γ : L.fixingSubgroup) (x : K'),
      ((res_L γ x : K') : AlgebraicClosure F) = (γ : AbsGal F) (x : AlgebraicClosure F) := by
    intro γ x
    change ((AlgEquiv.restrictNormalHom K'
      ((IntermediateField.fixingSubgroupEquiv L) γ) x : K') : AlgebraicClosure F) =
      (γ : AbsGal F) (x : AlgebraicClosure F)
    rw [AlgEquiv.restrictNormalHom_apply]
    rfl
  have h_fix_C : E₀.fixingSubgroup = C := IntermediateField.fixingSubgroup_fixedField C
  have hGalM_C : IsGaloisExt F L M_C := by
    refine ⟨hLM_C, inferInstance, ?_, ?_⟩
    · intro σ hσ τ hτ
      have hτ_L : τ ∈ L.fixingSubgroup := IntermediateField.fixingSubgroup_le hLM_C hτ
      let g_σ : G := res_L ⟨σ, hσ⟩
      let g_τ : G := res_L ⟨τ, hτ_L⟩
      have hg_τ : g_τ ∈ C := by
        rw [← h_fix_C, IntermediateField.mem_fixingSubgroup_iff]
        intro y hy
        apply Subtype.ext
        rw [h_res_L_apply ⟨τ, hτ_L⟩ y]
        have hyM : (y : AlgebraicClosure F) ∈ M_C := (h_mem_MC y).mpr hy
        exact (IntermediateField.mem_fixingSubgroup_iff _ _).mp hτ (y : AlgebraicClosure F) hyM
      have h_conj_C : g_σ * g_τ * g_σ⁻¹ ∈ C :=
        Subgroup.Normal.conj_mem ‹C.Normal› g_τ hg_τ g_σ
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro z hz
      let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr (hM_CK hz)⟩
      have hxE₀ : x ∈ E₀ := (h_mem_MC x).mp hz
      have h_fix_x : (g_σ * g_τ * g_σ⁻¹) x = x :=
        (IntermediateField.mem_fixedField_iff C x).mp hxE₀ (g_σ * g_τ * g_σ⁻¹) h_conj_C
      have h_res_conj : res_L (⟨σ, hσ⟩ * ⟨τ, hτ_L⟩ * ⟨σ, hσ⟩⁻¹) = g_σ * g_τ * g_σ⁻¹ := by
        rw [map_mul, map_mul, map_inv]
      have h1 := h_res_L_apply (⟨σ, hσ⟩ * ⟨τ, hτ_L⟩ * ⟨σ, hσ⟩⁻¹) x
      rw [h_res_conj, h_fix_x] at h1
      exact h1.symm
    · intro h
      let S_M := IntermediateField.extendScalars h
      refine ⟨fun x => ?_⟩
      have hxM : (x : AlgebraicClosure F) ∈ M_C := (IntermediateField.mem_extendScalars h).mp x.2
      let x_K : K' := ⟨x.1, (IntermediateField.mem_extendScalars hLK).mpr (hM_CK hxM)⟩
      have hmin1 : (minpoly L (S_M.val x)).Separable ↔ (minpoly L x).Separable := by
        rw [minpoly.algHom_eq S_M.val S_M.val.injective x]
      have hmin2 : (minpoly L (K'.val x_K)).Separable ↔ (minpoly L x_K).Separable := by
        rw [minpoly.algHom_eq K'.val K'.val.injective x_K]
      exact hmin1.mp (hmin2.mpr (Algebra.IsSeparable.isSeparable L x_K))
  have hlt : Module.finrank L (IntermediateField.extendScalars hLM_C) < Module.finrank L K' := by
    obtain ⟨c₀, hc₀C, hc₀_ne⟩ := hC_ne
    have h_ex : ∃ x₀ : K', c₀ x₀ ≠ x₀ := by
      by_contra h_all
      push_neg at h_all
      exact hc₀_ne (AlgEquiv.ext h_all)
    obtain ⟨x₀, hx₀⟩ := h_ex
    have hx₀_not_E₀ : x₀ ∉ E₀ := by
      intro hx₀E
      have h1 : c₀ x₀ = x₀ := (IntermediateField.mem_fixedField_iff C x₀).mp hx₀E c₀ hc₀C
      exact hx₀ h1
    have hx₀_K : (x₀ : AlgebraicClosure F) ∈ K := (IntermediateField.mem_extendScalars hLK).mp x₀.2
    have hx₀_not_MC : (x₀ : AlgebraicClosure F) ∉ M_C := by
      rw [h_mem_MC x₀]
      exact hx₀_not_E₀
    by_contra h_not_lt
    have h_le : Module.finrank L K' ≤ Module.finrank L (IntermediateField.extendScalars hLM_C) :=
      not_lt.mp h_not_lt
    haveI : IsScalarTower F L (IntermediateField.extendScalars hLM_C) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    have hmul1 : Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLM_C) =
        Module.finrank F M_C :=
      Module.finrank_mul_finrank F L (IntermediateField.extendScalars hLM_C)
    have hmul2 : Module.finrank F L * Module.finrank L K' = Module.finrank F K :=
      Module.finrank_mul_finrank F L K'
    have h_le_F : Module.finrank F K ≤ Module.finrank F M_C := by
      calc Module.finrank F K
        _ = Module.finrank F L * Module.finrank L K' := hmul2.symm
        _ ≤ Module.finrank F L * Module.finrank L (IntermediateField.extendScalars hLM_C) :=
          Nat.mul_le_mul_left _ h_le
        _ = Module.finrank F M_C := hmul1
    have h_eq_MC_K : M_C = K := IntermediateField.eq_of_le_of_finrank_le hM_CK h_le_F
    exact hx₀_not_MC (h_eq_MC_K.symm ▸ hx₀_K)
  exact ⟨hFinL, hFinK, hGalLK, ⟨π, hπ, hsurj⟩, ⟨hLM_C, hM_CK, hGalM_C, hlt⟩⟩

theorem ld_weil_galois_indCharTrace_bridge (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    [FiniteDimensional L (IntermediateField.extendScalars hLK)]
    [IsGalois L (IntermediateField.extendScalars hLK)]
    (π : relWeil F L →* (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (hπ : ∀ (w : relWeil F L) (x : IntermediateField.extendScalars hLK),
      ((π w x : IntermediateField.extendScalars hLK) : AlgebraicClosure F) =
        (w : AbsGal F) (x : AlgebraicClosure F))
    (hsurj : Function.Surjective π) :
    (∀ (C M : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK)),
      C ≤ M →
      ∀ (ψ : M →* (Ω F)ˣ),
        ∃ t : MonomialTerm F L,
          t.Wf F L ∧
          t.field ≤ (IntermediateField.lift (IntermediateField.fixedField C)).restrictScalars F ∧
          ∀ w : relWeil F L,
            t.trace F L w = indCharTrace F M ψ (π w)) ∧
    (∀ (E : IntermediateField F (AlgebraicClosure F)) (hLE : L ≤ E),
      E ≤ K →
      (⟨1, E, hLE, 1⟩ : MonomialTerm F L).Wf F L ∧
      ∃ (H : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK)),
        ∀ w : relWeil F L,
          (⟨1, E, hLE, 1⟩ : MonomialTerm F L).trace F L w = indCharTrace F H 1 (π w)) :=
by
  let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
  let G := (K' ≃ₐ[L] K')
  let G_L := relWeil F L
  have h_bridge : ∀ (E : IntermediateField F (AlgebraicClosure F))
      (hLE : L ≤ E) (hEK : E ≤ K) (M : Subgroup G)
      (h_mem : ∀ w : G_L, w ∈ (relWeil F E).subgroupOf G_L ↔ π w ∈ M)
      (ψ : M →* (Ω F)ˣ),
      let ι : relWeil F E →* G_L := Subgroup.inclusion (relWeil_antitone F hLE)
      let π_E : relWeil F E →* M :=
        { toFun := fun w => ⟨π (ι w), (h_mem (ι w)).mp w.2⟩
          map_one' := Subtype.ext (by simp)
          map_mul' := fun x y => Subtype.ext (by simp) }
      let χ_E : relWeil F E →* (Ω F)ˣ := ψ.comp π_E
      (⟨1, E, hLE, χ_E⟩ : MonomialTerm F L).Wf F L ∧
      ∀ w : G_L,
        (⟨1, E, hLE, χ_E⟩ : MonomialTerm F L).trace F L w = indCharTrace F M ψ (π w) := by
    intro E hLE hEK M h_mem ψ ι π_E χ_E
    haveI : FiniteDimensional F E :=
      Module.Finite.of_injective (IntermediateField.inclusion hEK).toLinearMap
        (IntermediateField.inclusion hEK).injective
    have hSep_E : Algebra.IsSeparable L (IntermediateField.extendScalars hLE) := by
      refine ⟨fun x => ?_⟩
      let E' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLE
      have hxE : (x : AlgebraicClosure F) ∈ E := (IntermediateField.mem_extendScalars hLE).mp x.2
      let x_K : K' := ⟨x.1, (IntermediateField.mem_extendScalars hLK).mpr (hEK hxE)⟩
      have hsep_K : IsSeparable L x_K := Algebra.IsSeparable.isSeparable L x_K
      have hmin_E : minpoly L (x : AlgebraicClosure F) = minpoly L x :=
        minpoly.algHom_eq E'.val E'.val.injective x
      have hmin_K : minpoly L (x_K : AlgebraicClosure F) = minpoly L x_K :=
        minpoly.algHom_eq K'.val K'.val.injective x_K
      change (minpoly L x).Separable
      rw [← hmin_E]
      change (minpoly L (x_K : AlgebraicClosure F)).Separable
      rw [hmin_K]
      exact hsep_K
    have hWeil_E : IsWeilRep F E (charRep F E χ_E) := by
      refine ⟨Module.Finite.equiv (ULift.moduleEquiv (R := Ω F) (M := Ω F)).symm, ?_⟩
      let U : Set (AbsGal F) := (K.fixingSubgroup : Set (AbsGal F))
      have hU_nhds : U ∈ nhds (1 : AbsGal F) :=
        (krullTopology_mem_nhds_one_iff F (AlgebraicClosure F) U).mpr
          ⟨K, inferInstance, Set.Subset.rfl⟩
      refine ⟨U, hU_nhds, fun w hwU _ => ?_⟩
      have hπ_w : π (ι w) = 1 := by
        apply AlgEquiv.ext
        intro x
        apply Subtype.ext
        have h1 := hπ (ι w) x
        change ((π (ι w) x : K') : AlgebraicClosure F) = (w : AbsGal F) (x : AlgebraicClosure F) at h1
        rw [h1]
        have hxK : (x : AlgebraicClosure F) ∈ K := (IntermediateField.mem_extendScalars hLK).mp x.2
        exact (IntermediateField.mem_fixingSubgroup_iff K (w : AbsGal F)).mp hwU x.1 hxK
      have hπE_w : π_E w = 1 := Subtype.ext hπ_w
      have hχ_w : χ_E w = 1 := by
        change ψ (π_E w) = 1
        rw [hπE_w, map_one]
      change (χ_E w : Ω F) • LinearMap.id = 1
      rw [hχ_w, Units.val_one, one_smul]
      rfl
    have hWf : (⟨1, E, hLE, χ_E⟩ : MonomialTerm F L).Wf F L := ⟨inferInstance, hSep_E, hWeil_E⟩
    refine ⟨hWf, fun w => ?_⟩
    let H_E : Subgroup G_L := (relWeil F E).subgroupOf G_L
    let W := ULift.{u} (Ω F)
    let e_sub : H_E ≃* relWeil F E := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hLE)
    let ρ_E : Representation (Ω F) H_E W := (charRep F E χ_E).comp e_sub.toMonoidHom
    let s : G ⧸ M → G_L := fun u₀ => (hsurj (cosetRep u₀)).choose
    have hs_spec : ∀ u₀ : G ⧸ M, π (s u₀) = cosetRep u₀ :=
      fun u₀ => (hsurj (cosetRep u₀)).choose_spec
    let u : G_L → G ⧸ M := fun x => QuotientGroup.mk (π x)⁻¹
    let r : G_L → G_L := fun x => s (u x)
    have h_xr_mem : ∀ x : G_L, x * r x ∈ H_E := by
      intro x
      rw [h_mem]
      change π (x * s (u x)) ∈ M
      rw [map_mul, hs_spec (u x)]
      have hout : QuotientGroup.mk (s := M) (cosetRep (u x)) = QuotientGroup.mk (s := M) (π x)⁻¹ :=
        Quotient.out_eq (u x)
      have hrel : (cosetRep (u x))⁻¹ * (π x)⁻¹ ∈ M := QuotientGroup.eq.mp hout
      have hinv : (π x * cosetRep (u x))⁻¹ ∈ M := by
        have heq : (π x * cosetRep (u x))⁻¹ = (cosetRep (u x))⁻¹ * (π x)⁻¹ := mul_inv_rev _ _
        rw [heq]
        exact hrel
      exact M.inv_mem_iff.mp hinv
    have hu_mul : ∀ (h₀ : H_E) (x : G_L), u ((h₀ : G_L) * x) = u x := by
      intro h₀ x
      change QuotientGroup.mk (s := M) (π ((h₀ : G_L) * x))⁻¹ = QuotientGroup.mk (s := M) (π x)⁻¹
      rw [QuotientGroup.eq]
      have heq : ((π ((h₀ : G_L) * x))⁻¹)⁻¹ * (π x)⁻¹ = π (h₀ : G_L) := by
        rw [inv_inv, map_mul, mul_inv_cancel_right]
      rw [heq]
      exact (h_mem (h₀ : G_L)).mp h₀.2
    have hr_mul : ∀ (h₀ : H_E) (x : G_L), r ((h₀ : G_L) * x) = r x := by
      intro h₀ x
      exact congrArg s (hu_mul h₀ x)
    have hu_rep_inv : ∀ u₀ : G ⧸ M, u (s u₀)⁻¹ = u₀ := by
      intro u₀
      change QuotientGroup.mk (s := M) (π (s u₀)⁻¹)⁻¹ = u₀
      rw [map_inv, inv_inv, hs_spec u₀]
      exact Quotient.out_eq u₀
    have hr_rep_inv : ∀ u₀ : G ⧸ M, r (s u₀)⁻¹ = s u₀ := by
      intro u₀
      exact congrArg s (hu_rep_inv u₀)
    have hu_iff : ∀ u₀ : G ⧸ M,
        u ((s u₀)⁻¹ * w) = u₀ ↔ (cosetRep u₀)⁻¹ * π w * cosetRep u₀ ∈ M := by
      intro u₀
      have h1 : u ((s u₀)⁻¹ * w) = QuotientGroup.mk (s := M) (π ((s u₀)⁻¹ * w))⁻¹ := rfl
      have h2 : u₀ = QuotientGroup.mk (s := M) (cosetRep u₀) := (Quotient.out_eq u₀).symm
      rw [h1]
      conv_lhs => rhs; rw [h2]
      rw [QuotientGroup.eq, inv_inv, map_mul, map_inv, hs_spec u₀]
    let Φ : indSpace H_E ρ_E ≃ₗ[Ω F] ((G ⧸ M) → Ω F) :=
      { toFun := fun f u₀ => (f.1 (s u₀)⁻¹).down
        map_add' := fun f₁ f₂ => funext fun u₀ => rfl
        map_smul' := fun c f => funext fun u₀ => rfl
        invFun := fun φ =>
          ⟨fun x => ρ_E ⟨x * r x, h_xr_mem x⟩ (ULift.up (φ (u x))), by
            intro h₀ x
            dsimp only
            rw [hu_mul h₀ x]
            have hsub : (⟨((h₀ : G_L) * x) * r ((h₀ : G_L) * x), h_xr_mem ((h₀ : G_L) * x)⟩ : H_E) =
                h₀ * ⟨x * r x, h_xr_mem x⟩ := by
              apply Subtype.ext
              change ((h₀ : G_L) * x) * r ((h₀ : G_L) * x) = (h₀ : G_L) * (x * r x)
              rw [hr_mul h₀ x, mul_assoc]
            rw [hsub, map_mul, Module.End.mul_apply]⟩
        left_inv := fun f => by
          apply Subtype.ext
          funext x
          dsimp only
          have h_eq : f.1 ((x * r x) * (r x)⁻¹) =
              ρ_E ⟨x * r x, h_xr_mem x⟩ (f.1 (r x)⁻¹) :=
            f.2 ⟨x * r x, h_xr_mem x⟩ (r x)⁻¹
          have h_cancel : (x * r x) * (r x)⁻¹ = x := mul_inv_cancel_right x (r x)
          rw [h_cancel] at h_eq
          exact h_eq.symm
        right_inv := fun φ => by
          funext u₀
          dsimp only
          rw [hu_rep_inv u₀]
          have h_one : (⟨(s u₀)⁻¹ * r (s u₀)⁻¹, h_xr_mem (s u₀)⁻¹⟩ : H_E) = 1 := by
            apply Subtype.ext
            change (s u₀)⁻¹ * r (s u₀)⁻¹ = 1
            rw [hr_rep_inv u₀, inv_mul_cancel]
          rw [h_one, map_one, Module.End.one_apply] }
    let T : ((G ⧸ M) → Ω F) →ₗ[Ω F] ((G ⧸ M) → Ω F) := Φ.conj (indRep H_E ρ_E w)
    have h_tr_ind : LinearMap.trace (Ω F) (indSpace H_E ρ_E) (indRep H_E ρ_E w) =
        ∑ u₀ : G ⧸ M,
          if hc : (cosetRep u₀)⁻¹ * π w * cosetRep u₀ ∈ M then
            (ψ ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ : Ω F)
          else 0 := by
      have h_conj : LinearMap.trace (Ω F) (indSpace H_E ρ_E) (indRep H_E ρ_E w) =
          LinearMap.trace (Ω F) ((G ⧸ M) → Ω F) T :=
        (LinearMap.trace_conj' (indRep H_E ρ_E w) Φ).symm
      rw [h_conj]
      have h_decomp : T = ∑ u₀ : G ⧸ M,
          (LinearMap.single (Ω F) (fun _ : G ⧸ M => Ω F) u₀).comp
            ((LinearMap.proj u₀).comp T) := by
        apply LinearMap.ext
        intro φ
        funext u₁
        simp [LinearMap.sum_apply, LinearMap.comp_apply]
      rw [h_decomp, map_sum]
      apply Finset.sum_congr rfl
      intro u₀ _
      have h_comm : LinearMap.trace (Ω F) ((G ⧸ M) → Ω F)
          ((LinearMap.single (Ω F) (fun _ : G ⧸ M => Ω F) u₀).comp
            ((LinearMap.proj u₀).comp T)) =
          LinearMap.trace (Ω F) (Ω F)
            (((LinearMap.proj u₀).comp T).comp
              (LinearMap.single (Ω F) (fun _ : G ⧸ M => Ω F) u₀)) :=
        (LinearMap.trace_comp_comm'
          (LinearMap.single (Ω F) (fun _ : G ⧸ M => Ω F) u₀)
          ((LinearMap.proj u₀).comp T)).symm
      rw [h_comm]
      let B : Ω F →ₗ[Ω F] Ω F :=
        ((LinearMap.proj u₀).comp T).comp (LinearMap.single (Ω F) (fun _ : G ⧸ M => Ω F) u₀)
      change LinearMap.trace (Ω F) (Ω F) B = _
      by_cases hc : (cosetRep u₀)⁻¹ * π w * cosetRep u₀ ∈ M
      · rw [dif_pos hc]
        have hu_eq : u ((s u₀)⁻¹ * w) = u₀ := (hu_iff u₀).mpr hc
        have hr_eq : r ((s u₀)⁻¹ * w) = s u₀ := congrArg s hu_eq
        have hB : B = (ψ ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ : Ω F) • LinearMap.id := by
          apply LinearMap.ext
          intro a
          change (ρ_E ⟨((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩
            (ULift.up (Pi.single (M := fun _ : G ⧸ M => Ω F) u₀ a (u ((s u₀)⁻¹ * w))))).down =
            (ψ ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ : Ω F) * a
          rw [hu_eq, Pi.single_eq_same]
          have h_πE : π_E (e_sub ⟨((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩) =
              ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ := by
            apply Subtype.ext
            change π (((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w)) = (cosetRep u₀)⁻¹ * π w * cosetRep u₀
            rw [hr_eq, map_mul, map_mul, map_inv, hs_spec u₀]
          change (χ_E (e_sub ⟨((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩) : Ω F) * a = _
          have h_χ : χ_E (e_sub ⟨((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩) =
              ψ ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ := by
            change ψ (π_E (e_sub ⟨((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩)) = _
            rw [h_πE]
          rw [h_χ]
        rw [hB, map_smul, LinearMap.trace_id, Module.finrank_self, Nat.cast_one, smul_eq_mul, mul_one]
      · rw [dif_neg hc]
        have hu_ne : u ((s u₀)⁻¹ * w) ≠ u₀ := fun h => hc ((hu_iff u₀).mp h)
        have hB : B = 0 := by
          apply LinearMap.ext
          intro a
          change (ρ_E ⟨((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩
            (ULift.up (Pi.single (M := fun _ : G ⧸ M => Ω F) u₀ a (u ((s u₀)⁻¹ * w))))).down = 0
          rw [Pi.single_eq_of_ne hu_ne]
          change (ρ_E ⟨((s u₀)⁻¹ * w) * r ((s u₀)⁻¹ * w), h_xr_mem ((s u₀)⁻¹ * w)⟩
            (0 : W)).down = 0
          rw [map_zero]
          rfl
        rw [hB, map_zero]
    let u_G : G → G ⧸ M := fun x => QuotientGroup.mk x⁻¹
    let r_G : G → G := fun x => cosetRep (u_G x)
    have h_xr_G : ∀ x : G, x * r_G x ∈ M := by
      intro x
      have hout : QuotientGroup.mk (s := M) (r_G x) = QuotientGroup.mk (s := M) x⁻¹ :=
        Quotient.out_eq (u_G x)
      have hrel : (r_G x)⁻¹ * x⁻¹ ∈ M := QuotientGroup.eq.mp hout
      have hinv : (x * r_G x)⁻¹ ∈ M := by
        have heq : (x * r_G x)⁻¹ = (r_G x)⁻¹ * x⁻¹ := mul_inv_rev _ _
        rw [heq]
        exact hrel
      exact M.inv_mem_iff.mp hinv
    have hu_mul_G : ∀ (y : M) (x : G), u_G ((y : G) * x) = u_G x := by
      intro y x
      change QuotientGroup.mk (s := M) ((y : G) * x)⁻¹ = QuotientGroup.mk (s := M) x⁻¹
      rw [QuotientGroup.eq]
      have heq : (((y : G) * x)⁻¹)⁻¹ * x⁻¹ = (y : G) := by
        rw [inv_inv, mul_inv_cancel_right]
      rw [heq]
      exact y.2
    have hr_mul_G : ∀ (y : M) (x : G), r_G ((y : G) * x) = r_G x := by
      intro y x
      exact congrArg cosetRep (hu_mul_G y x)
    have hu_rep_G : ∀ u₀ : G ⧸ M, u_G (cosetRep u₀)⁻¹ = u₀ := by
      intro u₀
      change QuotientGroup.mk (s := M) ((cosetRep u₀)⁻¹)⁻¹ = u₀
      rw [inv_inv]
      exact Quotient.out_eq u₀
    have hr_rep_G : ∀ u₀ : G ⧸ M, r_G (cosetRep u₀)⁻¹ = cosetRep u₀ := by
      intro u₀
      exact congrArg cosetRep (hu_rep_G u₀)
    let e_coset : (G ⧸ M) × M ≃ G :=
      { toFun := fun p => (p.2 : G) * (cosetRep p.1)⁻¹
        invFun := fun x => (u_G x, ⟨x * r_G x, h_xr_G x⟩)
        left_inv := fun ⟨u₀, y⟩ => by
          dsimp only
          have hu : u_G ((y : G) * (cosetRep u₀)⁻¹) = u₀ := by
            rw [hu_mul_G y (cosetRep u₀)⁻¹, hu_rep_G u₀]
          have hr : r_G ((y : G) * (cosetRep u₀)⁻¹) = cosetRep u₀ := by
            rw [hr_mul_G y (cosetRep u₀)⁻¹, hr_rep_G u₀]
          ext
          · exact hu
          · dsimp only
            rw [hr, inv_mul_cancel_right]
        right_inv := fun x => by
          dsimp only
          exact mul_inv_cancel_right x (r_G x) }
    have h_indChar : indCharTrace F M ψ (π w) =
        ∑ u₀ : G ⧸ M,
          if hc : (cosetRep u₀)⁻¹ * π w * cosetRep u₀ ∈ M then
            (ψ ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ : Ω F)
          else 0 := by
      unfold indCharTrace
      set g := π w
      have h_sum_eq : (∑ x : G, if h : x * g * x⁻¹ ∈ M then (ψ ⟨x * g * x⁻¹, h⟩ : Ω F) else 0) =
          ∑ p : (G ⧸ M) × M,
            if h : e_coset p * g * (e_coset p)⁻¹ ∈ M then
              (ψ ⟨e_coset p * g * (e_coset p)⁻¹, h⟩ : Ω F)
            else 0 :=
        (Fintype.sum_equiv e_coset _ _ (fun _ => rfl)).symm
      rw [h_sum_eq, Fintype.sum_prod_type]
      have h_inner : ∀ u₀ : G ⧸ M,
          (∑ y : M,
            if h : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∈ M then
              (ψ ⟨e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹, h⟩ : Ω F)
            else 0) =
          (Nat.card M : Ω F) *
            if hc : (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ M then
              (ψ ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, hc⟩ : Ω F)
            else 0 := by
        intro u₀
        set c := (cosetRep u₀)⁻¹ * g * cosetRep u₀
        have h_term : ∀ y : M,
            (if h : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∈ M then
              (ψ ⟨e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹, h⟩ : Ω F)
            else 0) =
            if hc : c ∈ M then (ψ ⟨c, hc⟩ : Ω F) else 0 := by
          intro y
          have h_conj_y : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ = (y : G) * c * (y : G)⁻¹ := by
            change ((y : G) * (cosetRep u₀)⁻¹) * g * ((y : G) * (cosetRep u₀)⁻¹)⁻¹ =
              (y : G) * ((cosetRep u₀)⁻¹ * g * cosetRep u₀) * (y : G)⁻¹
            group
          have h_mem_iff : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∈ M ↔ c ∈ M := by
            rw [h_conj_y]
            constructor
            · intro h
              have h1 : (y : G)⁻¹ * ((y : G) * c * (y : G)⁻¹) * (y : G) ∈ M :=
                M.mul_mem (M.mul_mem (M.inv_mem y.2) h) y.2
              have h2 : (y : G)⁻¹ * ((y : G) * c * (y : G)⁻¹) * (y : G) = c := by group
              rw [h2] at h1
              exact h1
            · intro hc
              exact M.mul_mem (M.mul_mem y.2 hc) (M.inv_mem y.2)
          by_cases hc : c ∈ M
          · have hyc : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∈ M := h_mem_iff.mpr hc
            rw [dif_pos hyc, dif_pos hc]
            have h_sub_eq : (⟨e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹, hyc⟩ : M) =
                y * ⟨c, hc⟩ * y⁻¹ := by
              apply Subtype.ext
              exact h_conj_y
            rw [h_sub_eq, map_mul, map_mul, map_inv, mul_comm (ψ y), mul_inv_cancel_right]
          · have hyc : e_coset (u₀, y) * g * (e_coset (u₀, y))⁻¹ ∉ M :=
              fun h => hc (h_mem_iff.mp h)
            rw [dif_neg hyc, dif_neg hc]
        simp_rw [h_term]
        rw [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, nsmul_eq_mul]
      simp_rw [h_inner, ← Finset.mul_sum]
      have hM_ne : (Nat.card M : Ω F) ≠ 0 := by
        exact_mod_cast (Nat.card_pos (α := M)).ne'
      exact inv_mul_cancel_left₀ hM_ne _
    change (1 : ℤ) • LinearMap.trace (Ω F) (indSpace H_E ρ_E) (indRep H_E ρ_E w) =
      indCharTrace F M ψ (π w)
    rw [one_smul, h_tr_ind, h_indChar]
  refine ⟨?_, ?_⟩
  · intro C M hCM ψ
    let E₀ : IntermediateField L K' := IntermediateField.fixedField M
    let E_L : IntermediateField L (AlgebraicClosure F) := IntermediateField.lift E₀
    let E_M : IntermediateField F (AlgebraicClosure F) := E_L.restrictScalars F
    have hLE_M : L ≤ E_M := by
      intro z hz
      exact (IntermediateField.mem_restrictScalars F).mpr (E_L.algebraMap_mem ⟨z, hz⟩)
    have hE_MK : E_M ≤ K := by
      intro z hz
      have hzL : z ∈ E_L := (IntermediateField.mem_restrictScalars F).mp hz
      have hzK' : z ∈ K' := IntermediateField.lift_le E₀ hzL
      exact (IntermediateField.mem_extendScalars hLK).mp hzK'
    have hE_MC : E_M ≤ (IntermediateField.lift (IntermediateField.fixedField C)).restrictScalars F := by
      intro z hz
      have hzL : z ∈ E_L := (IntermediateField.mem_restrictScalars F).mp hz
      have hzK' : z ∈ K' := IntermediateField.lift_le E₀ hzL
      let x : K' := ⟨z, hzK'⟩
      have hxE₀ : x ∈ E₀ := (IntermediateField.mem_lift x).mp hzL
      have hxM : ∀ g ∈ M, g x = x := (IntermediateField.mem_fixedField_iff M x).mp hxE₀
      have hxC : x ∈ IntermediateField.fixedField C :=
        (IntermediateField.mem_fixedField_iff C x).mpr (fun c hc => hxM c (hCM hc))
      have hzC_L : z ∈ IntermediateField.lift (IntermediateField.fixedField C) :=
        (IntermediateField.mem_lift x).mpr hxC
      exact (IntermediateField.mem_restrictScalars F).mpr hzC_L
    have h_fix : E₀.fixingSubgroup = M := IntermediateField.fixingSubgroup_fixedField M
    have h_mem_M : ∀ w : G_L, w ∈ (relWeil F E_M).subgroupOf G_L ↔ π w ∈ M := by
      intro w
      change ((w : AbsGal F) ∈ weilGroup F ∧ (w : AbsGal F) ∈ E_M.fixingSubgroup) ↔ π w ∈ M
      have hw_weil : (w : AbsGal F) ∈ weilGroup F := w.2.1
      rw [and_iff_right hw_weil, ← h_fix, IntermediateField.mem_fixingSubgroup_iff,
        IntermediateField.mem_fixingSubgroup_iff]
      constructor
      · intro hw x hx
        apply Subtype.ext
        have h1 := hπ w x
        change ((π w x : K') : AlgebraicClosure F) = (w : AbsGal F) (x : AlgebraicClosure F) at h1
        rw [h1]
        have hxL : (x : AlgebraicClosure F) ∈ E_L := (IntermediateField.mem_lift x).mpr hx
        have hxE : (x : AlgebraicClosure F) ∈ E_M :=
          (IntermediateField.mem_restrictScalars F).mpr hxL
        exact hw x.1 hxE
      · intro hπw z hzE
        have hzL : z ∈ E_L := (IntermediateField.mem_restrictScalars F).mp hzE
        have hzK' : z ∈ K' := IntermediateField.lift_le E₀ hzL
        let x : K' := ⟨z, hzK'⟩
        have hxE₀ : x ∈ E₀ := (IntermediateField.mem_lift x).mp hzL
        have h1 := hπ w x
        change ((π w x : K') : AlgebraicClosure F) = (w : AbsGal F) z at h1
        have h2 : π w x = x := hπw x hxE₀
        rw [h2] at h1
        exact h1.symm
    obtain ⟨hWf, htr⟩ := h_bridge E_M hLE_M hE_MK M h_mem_M ψ
    exact ⟨_, hWf, hE_MC, htr⟩
  · intro E hLE hEK
    let E₀ : IntermediateField L K' :=
      { carrier := {x : K' | (x : AlgebraicClosure F) ∈ E}
        add_mem' := fun {a b} ha hb => E.add_mem ha hb
        zero_mem' := E.zero_mem
        mul_mem' := fun {a b} ha hb => E.mul_mem ha hb
        one_mem' := E.one_mem
        inv_mem' := fun a ha => E.inv_mem ha
        algebraMap_mem' := fun r => hLE r.2 }
    let H : Subgroup G := E₀.fixingSubgroup
    have h_mem_H : ∀ w : G_L, w ∈ (relWeil F E).subgroupOf G_L ↔ π w ∈ H := by
      intro w
      change ((w : AbsGal F) ∈ weilGroup F ∧ (w : AbsGal F) ∈ E.fixingSubgroup) ↔ π w ∈ H
      have hw_weil : (w : AbsGal F) ∈ weilGroup F := w.2.1
      rw [and_iff_right hw_weil, IntermediateField.mem_fixingSubgroup_iff,
        IntermediateField.mem_fixingSubgroup_iff]
      constructor
      · intro hw x hx
        apply Subtype.ext
        have h1 := hπ w x
        change ((π w x : K') : AlgebraicClosure F) = (w : AbsGal F) (x : AlgebraicClosure F) at h1
        rw [h1]
        exact hw x.1 hx
      · intro hπw z hzE
        have hzK' : z ∈ K' := (IntermediateField.mem_extendScalars hLK).mpr (hEK hzE)
        let x : K' := ⟨z, hzK'⟩
        have hxE₀ : x ∈ E₀ := hzE
        have h1 := hπ w x
        change ((π w x : K') : AlgebraicClosure F) = (w : AbsGal F) z at h1
        have h2 : π w x = x := hπw x hxE₀
        rw [h2] at h1
        exact h1.symm
    obtain ⟨hWf, htr⟩ := h_bridge E hLE hEK H h_mem_H 1
    let ι : relWeil F E →* G_L := Subgroup.inclusion (relWeil_antitone F hLE)
    let π_E : relWeil F E →* H :=
      { toFun := fun w => ⟨π (ι w), (h_mem_H (ι w)).mp w.2⟩
        map_one' := Subtype.ext (by simp)
        map_mul' := fun x y => Subtype.ext (by simp) }
    have hχ_one : (1 : H →* (Ω F)ˣ).comp π_E = (1 : relWeil F E →* (Ω F)ˣ) :=
      MonoidHom.ext fun _ => rfl
    rw [hχ_one] at hWf htr
    exact ⟨hWf, H, htr⟩

theorem ld_indCharTrace_prod_subgroup_pushforward (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (G : Type u) [Group G] [Fintype G]
    (C : Subgroup G) [C.Normal] (hC_ab : ∀ a ∈ C, ∀ b ∈ C, a * b = b * a)
    (H : Subgroup G) :
    ∃ (M : Subgroup G) (_ : (C.subgroupOf M).Normal),
      (∀ a ∈ C.subgroupOf M, ∀ b ∈ C.subgroupOf M, a * b = b * a) ∧
      (∀ m : M, ∃ h ∈ H.subgroupOf M, ∃ c ∈ C.subgroupOf M, m = h * c) ∧
      ∀ (L_M : List (Σ (K : Subgroup M), (K →* (Ω F)ˣ))),
        (∀ p ∈ L_M, C.subgroupOf M ≤ p.1) →
        (∀ m : M,
          indCharTrace F (H.subgroupOf M) 1 m =
            (L_M.map fun p => indCharTrace F p.1 p.2 m).sum) →
        ∃ (L_G : List (Σ (K : Subgroup G), (K →* (Ω F)ˣ))),
          (∀ p ∈ L_G, C ≤ p.1) ∧
          ∀ g : G,
            indCharTrace F H 1 g =
              (L_G.map fun p => indCharTrace F p.1 p.2 g).sum :=
by
  let hC_norm : C.Normal := inferInstance
  let M : Subgroup G :=
    { carrier := {g : G | ∃ h ∈ H, ∃ c ∈ C, g = h * c}
      one_mem' := ⟨1, H.one_mem, 1, C.one_mem, (mul_one 1).symm⟩
      mul_mem' := by
        rintro g₁ g₂ ⟨h₁, hh₁, c₁, hc₁, rfl⟩ ⟨h₂, hh₂, c₂, hc₂, rfl⟩
        refine ⟨h₁ * h₂, H.mul_mem hh₁ hh₂, (h₂⁻¹ * c₁ * (h₂⁻¹)⁻¹) * c₂,
          C.mul_mem (hC_norm.conj_mem c₁ hc₁ h₂⁻¹) hc₂, ?_⟩
        group
      inv_mem' := by
        rintro g ⟨h, hh, c, hc, rfl⟩
        refine ⟨h⁻¹, H.inv_mem hh, h * c⁻¹ * h⁻¹,
          hC_norm.conj_mem c⁻¹ (C.inv_mem hc) h, ?_⟩
        group }
  have hHM : H ≤ M := fun h hh => ⟨h, hh, 1, C.one_mem, (mul_one h).symm⟩
  have hCM : C ≤ M := fun c hc => ⟨1, H.one_mem, c, hc, (one_mul c).symm⟩
  refine ⟨M, inferInstance, ?_, ?_, ?_⟩
  · intro a ha b hb
    exact Subtype.ext (hC_ab a.1 ha b.1 hb)
  · intro m
    rcases m.2 with ⟨h, hh, c, hc, hm_eq⟩
    refine ⟨⟨h, hHM hh⟩, hh, ⟨c, hCM hc⟩, hc, Subtype.ext hm_eq⟩
  · intro L_M hL_M_le hL_M_sum
    let liftSub (K : Subgroup M) : Subgroup G := Subgroup.map M.subtype K
    let liftChar (K : Subgroup M) (ψ : K →* (Ω F)ˣ) : liftSub K →* (Ω F)ˣ :=
      ψ.comp (Subgroup.equivMapOfInjective K M.subtype M.subtype_injective).symm.toMonoidHom
    have h_lift_le : ∀ (K : Subgroup M), C.subgroupOf M ≤ K → C ≤ liftSub K := by
      intro K hCK c hc
      have hc_sub : (⟨c, hCM hc⟩ : M) ∈ C.subgroupOf M := hc
      exact Subgroup.mem_map.mpr ⟨⟨c, hCM hc⟩, hCK hc_sub, rfl⟩
    have h_push_one : ∀ (K : Subgroup M) (ψ : K →* (Ω F)ˣ) (g : G),
        (Nat.card M : Ω F)⁻¹ *
          (∑ x : G,
            if hx : x * g * x⁻¹ ∈ M then
              indCharTrace F K ψ ⟨x * g * x⁻¹, hx⟩
            else 0) =
        indCharTrace F (liftSub K) (liftChar K ψ) g := by
      intro K ψ g
      let K' : Subgroup G := liftSub K
      let e₀ := Subgroup.equivMapOfInjective K M.subtype M.subtype_injective
      let e := e₀.symm
      let ψ' : K' →* (Ω F)ˣ := liftChar K ψ
      let B : G → Ω F := fun z =>
        if hz' : z * g * z⁻¹ ∈ K' then
          (ψ' ⟨z * g * z⁻¹, hz'⟩ : Ω F)
        else 0
      have h_conj_G : ∀ (x : G) (y : M),
          ((y : G) * x) * g * ((y : G) * x)⁻¹ = (y : G) * (x * g * x⁻¹) * (y : G)⁻¹ := by
        intro x y
        group
      have h_term : ∀ (x : G) (y : M),
          (if hx : x * g * x⁻¹ ∈ M then
            if hy : y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹ ∈ K then
              (ψ ⟨y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹, hy⟩ : Ω F)
            else 0
          else 0) = B ((y : G) * x) := by
        intro x y
        dsimp only [B]
        by_cases hz' : ((y : G) * x) * g * ((y : G) * x)⁻¹ ∈ K'
        · have hz_M : ((y : G) * x) * g * ((y : G) * x)⁻¹ ∈ M :=
            Subgroup.map_subtype_le K hz'
          have hx : x * g * x⁻¹ ∈ M := by
            have h_eq : x * g * x⁻¹ = (y : G)⁻¹ * (((y : G) * x) * g * ((y : G) * x)⁻¹) * (y : G) := by
              group
            rw [h_eq]
            exact M.mul_mem (M.mul_mem (M.inv_mem y.2) hz_M) y.2
          have hy : y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹ ∈ K := by
            rcases Subgroup.mem_map.mp hz' with ⟨u, hu, hu_eq⟩
            have hu_sub : y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹ = u := by
              ext
              change (y : G) * (x * g * x⁻¹) * (y : G)⁻¹ = (u : G)
              rw [← h_conj_G x y]
              exact hu_eq.symm
            exact hu_sub.symm ▸ hu
          have he_eq : e ⟨((y : G) * x) * g * ((y : G) * x)⁻¹, hz'⟩ =
              ⟨y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹, hy⟩ := by
            apply (MulEquiv.symm_apply_eq e₀).mpr
            ext
            change ((y : G) * x) * g * ((y : G) * x)⁻¹ = (y : G) * (x * g * x⁻¹) * (y : G)⁻¹
            exact h_conj_G x y
          rw [dif_pos hx, dif_pos hy, dif_pos hz']
          change (ψ ⟨y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹, hy⟩ : Ω F) =
            (ψ (e ⟨((y : G) * x) * g * ((y : G) * x)⁻¹, hz'⟩) : Ω F)
          rw [he_eq]
        · rw [dif_neg hz']
          split_ifs with hx hy
          · exfalso
            apply hz'
            rw [Subgroup.mem_map]
            refine ⟨y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹, hy, ?_⟩
            change (y : G) * (x * g * x⁻¹) * (y : G)⁻¹ = ((y : G) * x) * g * ((y : G) * x)⁻¹
            exact (h_conj_G x y).symm
          · rfl
          · rfl
      have h_summand : ∀ x : G,
          (if hx : x * g * x⁻¹ ∈ M then
            indCharTrace F K ψ ⟨x * g * x⁻¹, hx⟩
          else 0) =
          (Nat.card K : Ω F)⁻¹ * ∑ y : M, B ((y : G) * x) := by
        intro x
        have h_sum_y : (∑ y : M, B ((y : G) * x)) =
            ∑ y : M,
              (if hx : x * g * x⁻¹ ∈ M then
                if hy : y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹ ∈ K then
                  (ψ ⟨y * ⟨x * g * x⁻¹, hx⟩ * y⁻¹, hy⟩ : Ω F)
                else 0
              else 0) :=
          Finset.sum_congr rfl fun y _ => (h_term x y).symm
        rw [h_sum_y]
        by_cases hx : x * g * x⁻¹ ∈ M
        · rw [dif_pos hx]
          unfold indCharTrace
          congr 1
          refine Finset.sum_congr rfl fun y _ => ?_
          rw [dif_pos hx]
        · rw [dif_neg hx]
          have h0 : (∑ y : M,
              if hx' : x * g * x⁻¹ ∈ M then
                if hy : y * ⟨x * g * x⁻¹, hx'⟩ * y⁻¹ ∈ K then
                  (ψ ⟨y * ⟨x * g * x⁻¹, hx'⟩ * y⁻¹, hy⟩ : Ω F)
                else 0
              else 0) = 0 := by
            refine Finset.sum_eq_zero fun y _ => ?_
            rw [dif_neg hx]
          rw [h0, mul_zero]
      have h_shift : ∀ y : M, (∑ x : G, B ((y : G) * x)) = ∑ z : G, B z := by
        intro y
        exact Fintype.sum_equiv (Equiv.mulLeft (y : G)) (fun x => B ((y : G) * x)) B (fun x => rfl)
      have h_card_K' : Nat.card K' = Nat.card K := Subgroup.card_subtype M K
      have h_card_M_pos : 0 < Nat.card M := Nat.card_pos
      have h_card_M_ne : (Nat.card M : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr h_card_M_pos.ne'
      have h_lhs : (∑ x : G,
          if hx : x * g * x⁻¹ ∈ M then
            indCharTrace F K ψ ⟨x * g * x⁻¹, hx⟩
          else 0) =
        (Nat.card K : Ω F)⁻¹ * ((Nat.card M : Ω F) * ∑ z : G, B z) := by
        calc (∑ x : G,
            if hx : x * g * x⁻¹ ∈ M then
              indCharTrace F K ψ ⟨x * g * x⁻¹, hx⟩
            else 0)
          _ = ∑ x : G, ((Nat.card K : Ω F)⁻¹ * ∑ y : M, B ((y : G) * x)) :=
            Finset.sum_congr rfl fun x _ => h_summand x
          _ = (Nat.card K : Ω F)⁻¹ * ∑ x : G, ∑ y : M, B ((y : G) * x) := by
            rw [← Finset.mul_sum]
          _ = (Nat.card K : Ω F)⁻¹ * ∑ y : M, ∑ x : G, B ((y : G) * x) := by
            rw [Finset.sum_comm]
          _ = (Nat.card K : Ω F)⁻¹ * ∑ _y : M, ∑ z : G, B z := by
            congr 1
            refine Finset.sum_congr rfl fun y _ => h_shift y
          _ = (Nat.card K : Ω F)⁻¹ * ((Nat.card M : Ω F) * ∑ z : G, B z) := by
            rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, ← Nat.card_eq_fintype_card]
      rw [h_lhs, ← h_card_K']
      change (Nat.card M : Ω F)⁻¹ * ((Nat.card K' : Ω F)⁻¹ * ((Nat.card M : Ω F) * ∑ z : G, B z)) =
        (Nat.card K' : Ω F)⁻¹ * ∑ z : G, B z
      calc (Nat.card M : Ω F)⁻¹ * ((Nat.card K' : Ω F)⁻¹ * ((Nat.card M : Ω F) * ∑ z : G, B z))
        _ = ((Nat.card M : Ω F)⁻¹ * (Nat.card M : Ω F)) * ((Nat.card K' : Ω F)⁻¹ * ∑ z : G, B z) := by
          ring
        _ = 1 * ((Nat.card K' : Ω F)⁻¹ * ∑ z : G, B z) := by
          rw [inv_mul_cancel₀ h_card_M_ne]
        _ = (Nat.card K' : Ω F)⁻¹ * ∑ z : G, B z := one_mul _
    have h_push_H : ∀ g : G,
        indCharTrace F H 1 g =
          (Nat.card M : Ω F)⁻¹ *
            ∑ x : G,
              if hx : x * g * x⁻¹ ∈ M then
                indCharTrace F (H.subgroupOf M) 1 ⟨x * g * x⁻¹, hx⟩
              else 0 := by
      intro g
      rw [h_push_one (H.subgroupOf M) 1 g]
      have h_map_H : liftSub (H.subgroupOf M) = H := Subgroup.map_subgroupOf_eq_of_le hHM
      unfold indCharTrace
      have h_card : Nat.card (liftSub (H.subgroupOf M)) = Nat.card H := by
        rw [h_map_H]
      rw [h_card]
      congr 1
      refine Finset.sum_congr rfl fun z _ => ?_
      have h_iff : z * g * z⁻¹ ∈ H ↔ z * g * z⁻¹ ∈ liftSub (H.subgroupOf M) := by
        rw [h_map_H]
      by_cases hzH : z * g * z⁻¹ ∈ H
      · have hzL : z * g * z⁻¹ ∈ liftSub (H.subgroupOf M) := h_iff.mp hzH
        rw [dif_pos hzH, dif_pos hzL]
        rfl
      · have hzL : z * g * z⁻¹ ∉ liftSub (H.subgroupOf M) := fun h => hzH (h_iff.mpr h)
        rw [dif_neg hzH, dif_neg hzL]
    let liftPair : (Σ (K : Subgroup M), (K →* (Ω F)ˣ)) → (Σ (K : Subgroup G), (K →* (Ω F)ˣ)) :=
      fun p => ⟨liftSub p.1, liftChar p.1 p.2⟩
    have h_list_push : ∀ (L : List (Σ (K : Subgroup M), (K →* (Ω F)ˣ))) (g : G),
        (Nat.card M : Ω F)⁻¹ *
          (∑ x : G,
            if hx : x * g * x⁻¹ ∈ M then
              (L.map fun p => indCharTrace F p.1 p.2 ⟨x * g * x⁻¹, hx⟩).sum
            else 0) =
        ((L.map liftPair).map fun q => indCharTrace F q.1 q.2 g).sum := by
      intro L
      induction L with
      | nil =>
        intro g
        simp
      | cons p tl ih =>
        intro g
        simp only [List.map_cons, List.sum_cons]
        have h_sum_add : (∑ x : G,
            if hx : x * g * x⁻¹ ∈ M then
              indCharTrace F p.1 p.2 ⟨x * g * x⁻¹, hx⟩ +
                (tl.map fun q => indCharTrace F q.1 q.2 ⟨x * g * x⁻¹, hx⟩).sum
            else 0) =
          (∑ x : G,
            if hx : x * g * x⁻¹ ∈ M then
              indCharTrace F p.1 p.2 ⟨x * g * x⁻¹, hx⟩
            else 0) +
          (∑ x : G,
            if hx : x * g * x⁻¹ ∈ M then
              (tl.map fun q => indCharTrace F q.1 q.2 ⟨x * g * x⁻¹, hx⟩).sum
            else 0) := by
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun x _ => ?_
          split_ifs <;> simp
        rw [h_sum_add, mul_add, h_push_one p.1 p.2 g, ih g]
    refine ⟨L_M.map liftPair, ?_, ?_⟩
    · intro q hq
      rcases List.mem_map.mp hq with ⟨p, hp, rfl⟩
      exact h_lift_le p.1 (hL_M_le p hp)
    · intro g
      rw [h_push_H g]
      have h_sum_eq : (∑ x : G,
          if hx : x * g * x⁻¹ ∈ M then
            indCharTrace F (H.subgroupOf M) 1 ⟨x * g * x⁻¹, hx⟩
          else 0) =
        ∑ x : G,
          if hx : x * g * x⁻¹ ∈ M then
            (L_M.map fun p => indCharTrace F p.1 p.2 ⟨x * g * x⁻¹, hx⟩).sum
          else 0 := by
        refine Finset.sum_congr rfl fun x _ => ?_
        split_ifs with hx
        · exact hL_M_sum ⟨x * g * x⁻¹, hx⟩
        · rfl
      rw [h_sum_eq, h_list_push L_M g]

theorem ld_rightTransRep_trace_and_quot_add (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (G : Type u) [Group G] [Fintype G] :
    (∀ (H : Subgroup G) (g : G),
      LinearMap.trace (Ω F) (leftInvSpace F H) (rightTransRep F H g) =
        indCharTrace F H 1 g) ∧
    (∀ {Q : Type u} [AddCommGroup Q] [Module (Ω F) Q] [FiniteDimensional (Ω F) Q]
      (σ : Representation (Ω F) G Q) (W : Submodule (Ω F) Q)
      (hW : ∀ g : G, W ≤ Submodule.comap (σ g) W) (g : G),
      LinearMap.trace (Ω F) Q (σ g) =
        LinearMap.trace (Ω F) W (subRep σ W hW g) +
          LinearMap.trace (Ω F) (Q ⧸ W) (quotRep σ W hW g)) :=
by
  refine ⟨?_, ?_⟩
  · intro H g
    let u_of : G → G ⧸ H := fun x => QuotientGroup.mk x⁻¹
    let r_of : G → G := fun x => cosetRep (u_of x)
    have h_xr_mem : ∀ x : G, x * r_of x ∈ H := by
      intro x
      have hout : (QuotientGroup.mk (r_of x) : G ⧸ H) = u_of x := Quotient.out_eq (u_of x)
      have hrel : (r_of x)⁻¹ * x⁻¹ ∈ H := QuotientGroup.eq.mp hout
      have hinv : (x * r_of x)⁻¹ ∈ H := by
        rw [mul_inv_rev]
        exact hrel
      exact (Subgroup.inv_mem_iff H).mp hinv
    have hu_mul : ∀ (h : H) (x : G), u_of ((h : G) * x) = u_of x := by
      intro h x
      apply QuotientGroup.eq.mpr
      rw [inv_inv, mul_inv_cancel_right]
      exact h.2
    have hu_rep_inv : ∀ u : G ⧸ H, u_of (cosetRep u)⁻¹ = u := by
      intro u
      dsimp only [u_of]
      rw [inv_inv]
      exact Quotient.out_eq u
    have hr_rep_inv : ∀ u : G ⧸ H, r_of (cosetRep u)⁻¹ = cosetRep u := by
      intro u
      dsimp only [r_of]
      rw [hu_rep_inv u]
    let Φ : leftInvSpace F H ≃ₗ[Ω F] ((G ⧸ H) → Ω F) :=
      { toFun := fun φ u => φ.1 (cosetRep u)⁻¹
        invFun := fun α => ⟨fun x => α (u_of x), fun h x => congr_arg α (hu_mul h x)⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl
        left_inv := fun φ => by
          apply Subtype.ext
          funext x
          change φ.1 (r_of x)⁻¹ = φ.1 x
          have h_inv_H := φ.2 ⟨x * r_of x, h_xr_mem x⟩ (r_of x)⁻¹
          change φ.1 ((x * r_of x) * (r_of x)⁻¹) = φ.1 (r_of x)⁻¹ at h_inv_H
          rw [mul_inv_cancel_right] at h_inv_H
          exact h_inv_H.symm
        right_inv := fun α => by
          funext u
          exact congr_arg α (hu_rep_inv u) }
    have h_coset_trace :
        LinearMap.trace (Ω F) (leftInvSpace F H) (rightTransRep F H g) =
          ∑ u : G ⧸ H,
            if (cosetRep u)⁻¹ * g * cosetRep u ∈ H then (1 : Ω F) else 0 := by
      let T : ((G ⧸ H) → Ω F) →ₗ[Ω F] ((G ⧸ H) → Ω F) := Φ.conj (rightTransRep F H g)
      have htr_conj :
          LinearMap.trace (Ω F) (leftInvSpace F H) (rightTransRep F H g) =
            LinearMap.trace (Ω F) ((G ⧸ H) → Ω F) T :=
        (LinearMap.trace_conj' (rightTransRep F H g) Φ).symm
      have hT_sum : T = ∑ u : G ⧸ H,
          (T ∘ₗ LinearMap.single (Ω F) (fun _ => Ω F) u) ∘ₗ
            LinearMap.proj (R := Ω F) (φ := fun _ => Ω F) u := by
        apply LinearMap.ext
        intro α
        have hα : (∑ u : G ⧸ H, LinearMap.single (Ω F) (fun _ => Ω F) u (α u)) = α := by
          ext u₁
          simpa [LinearMap.single_apply] using
            congr_fun (Finset.univ_sum_single α) u₁
        calc T α = T (∑ u : G ⧸ H, LinearMap.single (Ω F) (fun _ => Ω F) u (α u)) := by rw [hα]
          _ = ∑ u : G ⧸ H, T (LinearMap.single (Ω F) (fun _ => Ω F) u (α u)) := map_sum T _ _
          _ = (∑ u : G ⧸ H,
                (T ∘ₗ LinearMap.single (Ω F) (fun _ => Ω F) u) ∘ₗ
                  LinearMap.proj (R := Ω F) (φ := fun _ => Ω F) u) α := by
            rw [LinearMap.sum_apply]
            rfl
      rw [htr_conj, hT_sum, map_sum]
      apply Finset.sum_congr rfl
      intro u _
      rw [LinearMap.trace_comp_comm']
      have hu_iff : u_of ((cosetRep u)⁻¹ * g) = u ↔ (cosetRep u)⁻¹ * g * cosetRep u ∈ H := by
        have hout : (QuotientGroup.mk (cosetRep u) : G ⧸ H) = u := Quotient.out_eq u
        calc u_of ((cosetRep u)⁻¹ * g) = u
            ↔ QuotientGroup.mk (((cosetRep u)⁻¹ * g)⁻¹) = QuotientGroup.mk (cosetRep u) := by
              dsimp only [u_of]
              rw [hout]
          _ ↔ (cosetRep u)⁻¹ * g * cosetRep u ∈ H := by
              rw [QuotientGroup.eq, inv_inv]
      by_cases hm : (cosetRep u)⁻¹ * g * cosetRep u ∈ H
      · rw [if_pos hm]
        have hu_eq : u_of ((cosetRep u)⁻¹ * g) = u := hu_iff.mpr hm
        have h_comp :
            LinearMap.proj (R := Ω F) (φ := fun _ => Ω F) u ∘ₗ
              (T ∘ₗ LinearMap.single (Ω F) (fun _ => Ω F) u) = LinearMap.id := by
          apply LinearMap.ext
          intro c
          change (LinearMap.single (Ω F) (fun _ => Ω F) u c) (u_of ((cosetRep u)⁻¹ * g)) = c
          rw [LinearMap.single_apply, hu_eq, Pi.single_eq_same]
        rw [h_comp, LinearMap.trace_id, Module.finrank_self, Nat.cast_one]
      · rw [if_neg hm]
        have hu_ne : u_of ((cosetRep u)⁻¹ * g) ≠ u := fun h_eq => hm (hu_iff.mp h_eq)
        have h_comp :
            LinearMap.proj (R := Ω F) (φ := fun _ => Ω F) u ∘ₗ
              (T ∘ₗ LinearMap.single (Ω F) (fun _ => Ω F) u) = 0 := by
          apply LinearMap.ext
          intro c
          change (LinearMap.single (Ω F) (fun _ => Ω F) u c) (u_of ((cosetRep u)⁻¹ * g)) = 0
          rw [LinearMap.single_apply, Pi.single_eq_of_ne hu_ne]
        rw [h_comp, map_zero]
    rw [h_coset_trace]
    let e_prod : (G ⧸ H) × H ≃ G :=
      { toFun := fun p => (p.2 : G) * (cosetRep p.1)⁻¹
        invFun := fun x => (u_of x, ⟨x * r_of x, h_xr_mem x⟩)
        left_inv := fun ⟨u₀, z⟩ => by
          dsimp only
          have hu1 : u_of ((z : G) * (cosetRep u₀)⁻¹) = u₀ := by
            rw [hu_mul z (cosetRep u₀)⁻¹, hu_rep_inv u₀]
          have hr1 : r_of ((z : G) * (cosetRep u₀)⁻¹) = cosetRep u₀ := by
            dsimp only [r_of]
            rw [hu1]
          ext
          · exact hu1
          · change ((z : G) * (cosetRep u₀)⁻¹) * r_of ((z : G) * (cosetRep u₀)⁻¹) = z.1
            rw [hr1, inv_mul_cancel_right]
        right_inv := fun x => by
          dsimp only [r_of]
          exact mul_inv_cancel_right x (r_of x) }
    have h_term_inv : ∀ (u₀ : G ⧸ H) (z : H),
        (if hx : e_prod (u₀, z) * g * (e_prod (u₀, z))⁻¹ ∈ H then
          (((1 : H →* (Ω F)ˣ) ⟨e_prod (u₀, z) * g * (e_prod (u₀, z))⁻¹, hx⟩ : (Ω F)ˣ) : Ω F)
        else 0) =
        (if (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ H then (1 : Ω F) else 0) := by
      intro u₀ z
      let x : G := e_prod (u₀, z)
      let x₀ : G := (cosetRep u₀)⁻¹ * g * cosetRep u₀
      have hx_eq : x * g * x⁻¹ = (z : G) * x₀ * (z : G)⁻¹ := by
        change (z : G) * (cosetRep u₀)⁻¹ * g * ((z : G) * (cosetRep u₀)⁻¹)⁻¹ =
          (z : G) * ((cosetRep u₀)⁻¹ * g * cosetRep u₀) * (z : G)⁻¹
        group
      have h_mem_iff : x * g * x⁻¹ ∈ H ↔ x₀ ∈ H := by
        rw [hx_eq, mul_assoc]
        rw [Subgroup.mul_mem_cancel_left H z.2]
        exact Subgroup.mul_mem_cancel_right H (Subgroup.inv_mem H z.2)
      by_cases hm : x₀ ∈ H
      · have hx : x * g * x⁻¹ ∈ H := h_mem_iff.mpr hm
        rw [dif_pos hx, if_pos hm]
        simp
      · have hx : x * g * x⁻¹ ∉ H := fun hx' => hm (h_mem_iff.mp hx')
        rw [dif_neg hx, if_neg hm]
    have h_sum_G :
        (∑ x : G,
          if hx : x * g * x⁻¹ ∈ H then
            (((1 : H →* (Ω F)ˣ) ⟨x * g * x⁻¹, hx⟩ : (Ω F)ˣ) : Ω F)
          else 0) =
        (Nat.card H : Ω F) *
          ∑ u₀ : G ⧸ H,
            if (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ H then (1 : Ω F) else 0 := by
      rw [← Fintype.sum_equiv e_prod
        (fun p =>
          if hx : e_prod p * g * (e_prod p)⁻¹ ∈ H then
            (((1 : H →* (Ω F)ˣ) ⟨e_prod p * g * (e_prod p)⁻¹, hx⟩ : (Ω F)ˣ) : Ω F)
          else 0)
        _ (fun _ => rfl)]
      rw [Fintype.sum_prod_type]
      have h_inner : ∀ u₀ : G ⧸ H,
          (∑ z : H,
            if hx : e_prod (u₀, z) * g * (e_prod (u₀, z))⁻¹ ∈ H then
              (((1 : H →* (Ω F)ˣ) ⟨e_prod (u₀, z) * g * (e_prod (u₀, z))⁻¹, hx⟩ : (Ω F)ˣ) : Ω F)
            else 0) =
          (Nat.card H : Ω F) *
            (if (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ H then (1 : Ω F) else 0) := by
        intro u₀
        rw [Finset.sum_congr rfl (fun z _ => h_term_inv u₀ z)]
        rw [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, nsmul_eq_mul]
      rw [Finset.sum_congr rfl (fun u₀ _ => h_inner u₀), ← Finset.mul_sum]
    unfold indCharTrace
    rw [h_sum_G]
    have h_card_pos : 0 < Nat.card H := Nat.card_pos
    have h_card_ne : (Nat.card H : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr h_card_pos.ne'
    exact (inv_mul_cancel_left₀ h_card_ne _).symm
  · intro Q _ _ _ σ W hW g
    obtain ⟨s, hs⟩ := LinearMap.exists_rightInverse_of_surjective W.mkQ (Submodule.range_mkQ W)
    have hmem : ∀ v : Q, ((LinearMap.id : Q →ₗ[Ω F] Q) - s ∘ₗ W.mkQ) v ∈ W := by
      intro v
      have hker : ((LinearMap.id : Q →ₗ[Ω F] Q) - s ∘ₗ W.mkQ) v ∈ LinearMap.ker W.mkQ := by
        rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.id_apply,
          LinearMap.comp_apply, map_sub]
        change W.mkQ v - (W.mkQ ∘ₗ s) (W.mkQ v) = 0
        rw [hs, LinearMap.id_apply, sub_self]
      rwa [Submodule.ker_mkQ W] at hker
    let p : Q →ₗ[Ω F] W :=
      LinearMap.codRestrict W ((LinearMap.id : Q →ₗ[Ω F] Q) - s ∘ₗ W.mkQ) hmem
    have hfp : W.subtype ∘ₗ p = (LinearMap.id : Q →ₗ[Ω F] Q) - s ∘ₗ W.mkQ := by
      ext v
      rfl
    have hpf : p ∘ₗ W.subtype = LinearMap.id := by
      ext w
      change ((p (W.subtype w) : W) : Q) = w.1
      rw [LinearMap.codRestrict_apply, LinearMap.sub_apply, LinearMap.id_apply,
        LinearMap.comp_apply, Submodule.coe_subtype, Submodule.mkQ_apply,
        (Submodule.Quotient.mk_eq_zero W).mpr w.2, map_zero, sub_zero]
    have hfp_id : W.subtype ∘ₗ p + s ∘ₗ W.mkQ = LinearMap.id := by
      rw [hfp, sub_add_cancel]
    have hf_comm : W.subtype ∘ₗ subRep σ W hW g = σ g ∘ₗ W.subtype := by
      ext x
      rfl
    have hq_comm : W.mkQ ∘ₗ σ g = quotRep σ W hW g ∘ₗ W.mkQ := by
      ext x
      rfl
    have h_decomp : σ g =
        (W.subtype ∘ₗ subRep σ W hW g) ∘ₗ p + (σ g ∘ₗ s) ∘ₗ W.mkQ := by
      calc σ g = σ g ∘ₗ LinearMap.id := (LinearMap.comp_id (σ g)).symm
        _ = σ g ∘ₗ (W.subtype ∘ₗ p + s ∘ₗ W.mkQ) := by rw [hfp_id]
        _ = (σ g ∘ₗ W.subtype) ∘ₗ p + (σ g ∘ₗ s) ∘ₗ W.mkQ := by
          rw [LinearMap.comp_add, LinearMap.comp_assoc, LinearMap.comp_assoc]
        _ = (W.subtype ∘ₗ subRep σ W hW g) ∘ₗ p + (σ g ∘ₗ s) ∘ₗ W.mkQ := by
          rw [hf_comm]
    have htr1 : LinearMap.trace (Ω F) Q ((W.subtype ∘ₗ subRep σ W hW g) ∘ₗ p) =
        LinearMap.trace (Ω F) W (subRep σ W hW g) := by
      rw [LinearMap.trace_comp_comm' p (W.subtype ∘ₗ subRep σ W hW g),
        ← LinearMap.comp_assoc, hpf, LinearMap.id_comp]
    have htr2 : LinearMap.trace (Ω F) Q ((σ g ∘ₗ s) ∘ₗ W.mkQ) =
        LinearMap.trace (Ω F) (Q ⧸ W) (quotRep σ W hW g) := by
      rw [LinearMap.trace_comp_comm' W.mkQ (σ g ∘ₗ s),
        ← LinearMap.comp_assoc, hq_comm, LinearMap.comp_assoc, hs, LinearMap.comp_id]
    rw [h_decomp, map_add, htr1, htr2]

theorem ld_fourier_weight_lift_and_stabilizer_char (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (G : Type u) [Group G] [Fintype G]
    (C : Subgroup G) [C.Normal] (hC_ab : ∀ a ∈ C, ∀ b ∈ C, a * b = b * a)
    (H : Subgroup G) (hG_mul : ∀ g : G, ∃ h ∈ H, ∃ c ∈ C, g = h * c)
    {Q : Type u} [AddCommGroup Q] [Module (Ω F) Q] [FiniteDimensional (Ω F) Q] [Nontrivial Q]
    (σ : Representation (Ω F) G Q)
    (π : leftInvSpace F H →ₗ[Ω F] Q) (hπ_surj : Function.Surjective π)
    (hπ_inter : ∀ g : G, π ∘ₗ rightTransRep F H g = σ g ∘ₗ π) :
    ∃ (lam : C → Ω F) (M_lam : Subgroup G) (ψ_lam : M_lam →* (Ω F)ˣ) (w_bar : Q),
      C ≤ M_lam ∧
      (∀ g : G, g ∈ M_lam ↔ ∀ (c : C) (hc : g⁻¹ * c.1 * g ∈ C), lam ⟨g⁻¹ * c.1 * g, hc⟩ = lam c) ∧
      w_bar ≠ 0 ∧
      (∀ c : C, σ c.1 w_bar = lam c • w_bar) ∧
      (∀ k : M_lam, σ k.1 w_bar = (ψ_lam k : Ω F) • w_bar) :=
by
  have hC_comm : ∀ a b : C, σ a.1 ∘ₗ σ b.1 = σ b.1 ∘ₗ σ a.1 := by
    intro a b
    rw [← Module.End.mul_eq_comp, ← map_mul, hC_ab a.1 a.2 b.1 b.2, map_mul, Module.End.mul_eq_comp]
  let E : Finset C → (C → Ω F) → Submodule (Ω F) Q := fun S μ =>
    { carrier := {q : Q | ∀ c ∈ S, σ c.1 q = μ c • q}
      zero_mem' := fun c _ => by simp
      add_mem' := fun {x y} hx hy c hc => by
        change σ c.1 (x + y) = μ c • (x + y)
        rw [map_add, hx c hc, hy c hc, smul_add]
      smul_mem' := fun r {x} hx c hc => by
        change σ c.1 (r • x) = μ c • (r • x)
        rw [map_smul, hx c hc, smul_comm r (μ c)] }
  have h_fin : ∀ S : Finset C, ∃ μ : C → Ω F, E S μ ≠ ⊥ := by
    intro S
    induction' S using Finset.induction_on with b S₀ hb ih
    · obtain ⟨q₀, hq₀⟩ := exists_ne (0 : Q)
      refine ⟨0, (Submodule.ne_bot_iff _).mpr ⟨q₀, ?_, hq₀⟩⟩
      intro c hc
      simp at hc
    · rcases ih with ⟨μ₀, hW₀_ne⟩
      let W₀ := E S₀ μ₀
      have hW₀_inv : ∀ x ∈ W₀, σ b.1 x ∈ W₀ := by
        intro x hx a ha
        have h_comm : (σ a.1 ∘ₗ σ b.1) x = (σ b.1 ∘ₗ σ a.1) x := by
          rw [hC_comm a b]
        change σ a.1 (σ b.1 x) = σ b.1 (σ a.1 x) at h_comm
        have hxa : σ a.1 x = μ₀ a • x := hx a ha
        change σ a.1 (σ b.1 x) = μ₀ a • σ b.1 x
        rw [h_comm, hxa, map_smul]
      haveI : Nontrivial W₀ := Submodule.nontrivial_iff_ne_bot.mpr hW₀_ne
      let f_b : W₀ →ₗ[Ω F] W₀ := (σ b.1).restrict hW₀_inv
      obtain ⟨r, hr⟩ := Module.End.exists_eigenvalue f_b
      obtain ⟨w, hw_mem, hw_ne⟩ := hr.exists_hasEigenvector
      have hw_eq : f_b w = r • w := Module.End.mem_eigenspace_iff.mp hw_mem
      have h_bw : σ b.1 w.1 = r • w.1 := congr_arg Subtype.val hw_eq
      have hw_val_ne : w.1 ≠ 0 := fun h0 => hw_ne (Subtype.ext h0)
      let μ : C → Ω F := Function.update μ₀ b r
      refine ⟨μ, (Submodule.ne_bot_iff _).mpr ⟨w.1, ?_, hw_val_ne⟩⟩
      intro a ha
      change σ a.1 w.1 = μ a • w.1
      rcases Finset.mem_insert.mp ha with rfl | ha_S₀
      · dsimp only [μ]
        rw [Function.update_self]
        exact h_bw
      · have hab : a ≠ b := fun h => hb (h ▸ ha_S₀)
        dsimp only [μ]
        rw [Function.update_of_ne hab]
        exact w.2 a ha_S₀
  obtain ⟨lam, h_ne_bot⟩ := h_fin Finset.univ
  obtain ⟨q₀, hq₀_mem, hq₀_ne⟩ := (Submodule.ne_bot_iff _).mp h_ne_bot
  have hq₀_eig : ∀ c : C, σ c.1 q₀ = lam c • q₀ := fun c => hq₀_mem c (Finset.mem_univ c)
  have h_smul_inj : ∀ r₁ r₂ : Ω F, r₁ • q₀ = r₂ • q₀ → r₁ = r₂ := by
    intro r₁ r₂ h_eq
    have h_sub : (r₁ - r₂) • q₀ = 0 := by rw [sub_smul, h_eq, sub_self]
    exact sub_eq_zero.mp ((smul_eq_zero.mp h_sub).resolve_right hq₀_ne)
  have hlam_one : lam 1 = 1 := by
    apply h_smul_inj
    rw [← hq₀_eig 1, Subgroup.coe_one, map_one, Module.End.one_apply, one_smul]
  have hlam_mul : ∀ a b : C, lam (a * b) = lam a * lam b := by
    intro a b
    apply h_smul_inj
    rw [← hq₀_eig (a * b), Subgroup.coe_mul, map_mul, Module.End.mul_apply,
      hq₀_eig b, map_smul, hq₀_eig a, smul_smul, mul_comm]
  have hlam_inv_mul : ∀ c : C, lam c⁻¹ * lam c = 1 := by
    intro c
    rw [← hlam_mul c⁻¹ c, inv_mul_cancel, hlam_one]
  obtain ⟨v₀, hv₀⟩ := hπ_surj q₀
  let w : leftInvSpace F H :=
    (Nat.card C : Ω F)⁻¹ • ∑ c : C, lam c⁻¹ • rightTransRep F H c.1 v₀
  have h_pi_term : ∀ c : C, π (lam c⁻¹ • rightTransRep F H c.1 v₀) = q₀ := by
    intro c
    have h_inter : π (rightTransRep F H c.1 v₀) = σ c.1 (π v₀) :=
      LinearMap.congr_fun (hπ_inter c.1) v₀
    rw [map_smul, h_inter, hv₀, hq₀_eig c, smul_smul, hlam_inv_mul c, one_smul]
  have hC_ne : (Nat.card C : Ω F) ≠ 0 :=
    Nat.cast_ne_zero.mpr (Nat.card_pos (α := C)).ne'
  have hw_pi : π w = q₀ := by
    dsimp only [w]
    rw [map_smul, map_sum]
    have h_sum : (∑ c : C, π (lam c⁻¹ • rightTransRep F H c.1 v₀)) = ∑ _c : C, q₀ :=
      Finset.sum_congr rfl fun c _ => h_pi_term c
    rw [h_sum, Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card,
      ← Nat.cast_smul_eq_nsmul (Ω F), inv_smul_smul₀ hC_ne]
  have hw_eig : ∀ a : C, rightTransRep F H a.1 w = lam a • w := by
    intro a
    have h_sum_eq :
        (∑ c : C, (rightTransRep F H a.1) (lam c⁻¹ • (rightTransRep F H c.1) v₀)) =
          ∑ c : C, lam a • (lam c⁻¹ • (rightTransRep F H c.1) v₀) := by
      refine (Fintype.sum_equiv (Equiv.mulLeft a⁻¹)
        (fun c => lam a • (lam c⁻¹ • (rightTransRep F H c.1) v₀))
        (fun c => (rightTransRep F H a.1) (lam c⁻¹ • (rightTransRep F H c.1) v₀))
        (fun c => ?_)).symm
      change lam a • (lam c⁻¹ • (rightTransRep F H c.1) v₀) =
        (rightTransRep F H a.1) (lam (a⁻¹ * c)⁻¹ • (rightTransRep F H (a⁻¹ * c).1) v₀)
      rw [map_smul]
      have h_rep : rightTransRep F H a.1 (rightTransRep F H (a⁻¹ * c).1 v₀) =
          rightTransRep F H c.1 v₀ := by
        rw [← Module.End.mul_apply, ← map_mul, ← Subgroup.coe_mul, mul_inv_cancel_left]
      have h_lam : lam (a⁻¹ * c)⁻¹ = lam a * lam c⁻¹ := by
        rw [mul_inv_rev, inv_inv, hlam_mul, mul_comm]
      rw [h_rep, h_lam, mul_smul]
    dsimp only [w]
    rw [map_smul, map_sum, h_sum_eq, ← Finset.smul_sum, smul_comm]
  have h_w_eval : ∀ (h : G) (hh : h ∈ H) (c : C), w.1 (h * c.1) = lam c * w.1 1 := by
    intro h hh c
    have h1 : w.1 (h * c.1) = w.1 c.1 := w.2 ⟨h, hh⟩ c.1
    have h2 : (rightTransRep F H c.1 w).1 1 = w.1 c.1 := by
      change w.1 (1 * c.1) = w.1 c.1
      rw [one_mul]
    have h3 : (rightTransRep F H c.1 w).1 1 = lam c * w.1 1 := by
      rw [hw_eig c]
      rfl
    rw [h1, ← h2, h3]
  have hw_one_ne : w.1 1 ≠ 0 := by
    intro h0
    have hw_zero : w = 0 := by
      apply Subtype.ext
      funext g
      obtain ⟨h, hh, c, hc, rfl⟩ := hG_mul g
      change w.1 (h * (⟨c, hc⟩ : C).1) = 0
      rw [h_w_eval h hh ⟨c, hc⟩, h0, mul_zero]
    have hq₀_zero : q₀ = 0 := by
      rw [← hw_pi, hw_zero, map_zero]
    exact hq₀_ne hq₀_zero
  let w₀ : leftInvSpace F H := (w.1 1)⁻¹ • w
  let w_bar : Q := π w₀
  have hw_bar_eq : w_bar = (w.1 1)⁻¹ • q₀ := by
    dsimp only [w_bar, w₀]
    rw [map_smul, hw_pi]
  have hw_bar_ne : w_bar ≠ 0 := by
    rw [hw_bar_eq]
    exact smul_ne_zero (inv_ne_zero hw_one_ne) hq₀_ne
  have hw_bar_C : ∀ c : C, σ c.1 w_bar = lam c • w_bar := by
    intro c
    rw [hw_bar_eq, map_smul, hq₀_eig c, smul_comm]
  have hw₀_eval : ∀ (h : G), h ∈ H → ∀ (c : C), w₀.1 (h * c.1) = lam c := by
    intro h hh c
    change (w.1 1)⁻¹ * w.1 (h * c.1) = lam c
    rw [h_w_eval h hh c]
    calc (w.1 1)⁻¹ * (lam c * w.1 1)
        = lam c * ((w.1 1)⁻¹ * w.1 1) := by ring
      _ = lam c * 1 := by rw [inv_mul_cancel₀ hw_one_ne]
      _ = lam c := mul_one _
  have hC_norm : C.Normal := inferInstance
  have h_conj : ∀ (g : G) (c : C), g⁻¹ * c.1 * g ∈ C := by
    intro g c
    simpa [mul_assoc] using hC_norm.conj_mem c.1 c.2 g⁻¹
  let shift : G → (C → Ω F) → (C → Ω F) := fun g μ c =>
    μ ⟨g⁻¹ * c.1 * g, h_conj g c⟩
  have h_shift_one : ∀ μ : C → Ω F, shift 1 μ = μ := by
    intro μ
    funext c
    dsimp only [shift]
    congr 1
    apply Subtype.ext
    group
  have h_shift_mul : ∀ (x y : G) (μ : C → Ω F), shift (x * y) μ = shift x (shift y μ) := by
    intro x y μ
    funext c
    dsimp only [shift]
    congr 1
    apply Subtype.ext
    group
  let M_lam : Subgroup G :=
    { carrier := {g : G | shift g lam = lam}
      one_mem' := h_shift_one lam
      mul_mem' := fun {x y} hx hy => by
        change shift (x * y) lam = lam
        rw [h_shift_mul, hy, hx]
      inv_mem' := fun {x} hx => by
        change shift x⁻¹ lam = lam
        have h1 : shift x⁻¹ (shift x lam) = shift x⁻¹ lam := by rw [hx]
        rw [← h_shift_mul, inv_mul_cancel, h_shift_one] at h1
        exact h1.symm }
  have hM_lam : ∀ g : G, g ∈ M_lam ↔ ∀ (c : C) (hc : g⁻¹ * c.1 * g ∈ C), lam ⟨g⁻¹ * c.1 * g, hc⟩ = lam c := by
    intro g
    change shift g lam = lam ↔ _
    rw [funext_iff]
    constructor
    · intro hg c hc
      have h_sub : (⟨g⁻¹ * c.1 * g, hc⟩ : C) = ⟨g⁻¹ * c.1 * g, h_conj g c⟩ := rfl
      rw [h_sub]
      exact hg c
    · intro hg c
      exact hg c (h_conj g c)
  have hC_le : C ≤ M_lam := by
    intro a ha
    rw [hM_lam]
    intro c hc
    congr 1
    apply Subtype.ext
    change a⁻¹ * c.1 * a = c.1
    rw [mul_assoc, hC_ab c.1 c.2 a ha, inv_mul_cancel_left]
  have h_tau_M : ∀ k : M_lam, rightTransRep F H k.1 w₀ = w₀.1 k.1 • w₀ := by
    intro k
    obtain ⟨h_k, hh_k, c_k, hc_k, hk_eq⟩ := hG_mul k.1
    have hw₀_k : w₀.1 k.1 = lam ⟨c_k, hc_k⟩ := by
      rw [hk_eq]
      exact hw₀_eval h_k hh_k ⟨c_k, hc_k⟩
    have h_conj_hk : ∀ c : C, lam ⟨h_k⁻¹ * c.1 * h_k, h_conj h_k c⟩ = lam c := by
      intro c
      have h_eq_c : h_k⁻¹ * c.1 * h_k = k.1⁻¹ * c.1 * k.1 := by
        have h_in_C : h_k⁻¹ * c.1 * h_k ∈ C := h_conj h_k c
        have h_comm_ck : (h_k⁻¹ * c.1 * h_k) * c_k = c_k * (h_k⁻¹ * c.1 * h_k) :=
          hC_ab _ h_in_C c_k hc_k
        calc h_k⁻¹ * c.1 * h_k
            = c_k⁻¹ * (c_k * (h_k⁻¹ * c.1 * h_k)) := by group
          _ = c_k⁻¹ * ((h_k⁻¹ * c.1 * h_k) * c_k) := by rw [← h_comm_ck]
          _ = (h_k * c_k)⁻¹ * c.1 * (h_k * c_k) := by group
          _ = k.1⁻¹ * c.1 * k.1 := by rw [← hk_eq]
      have h_sub : (⟨h_k⁻¹ * c.1 * h_k, h_conj h_k c⟩ : C) = ⟨k.1⁻¹ * c.1 * k.1, h_conj k.1 c⟩ := by
        apply Subtype.ext
        exact h_eq_c
      rw [h_sub]
      exact (hM_lam k.1).mp k.2 c (h_conj k.1 c)
    apply Subtype.ext
    funext x
    obtain ⟨h_x, hh_x, c_x, hc_x, rfl⟩ := hG_mul x
    change w₀.1 ((h_x * c_x) * k.1) = w₀.1 k.1 * w₀.1 (h_x * c_x)
    have h_prod : (h_x * c_x) * k.1 = (h_x * h_k) * ((h_k⁻¹ * c_x * h_k) * c_k) := by
      rw [hk_eq]
      group
    let c_conj : C := ⟨h_k⁻¹ * c_x * h_k, h_conj h_k ⟨c_x, hc_x⟩⟩
    let c_prod : C := c_conj * ⟨c_k, hc_k⟩
    have h_prod_coe : (h_x * c_x) * k.1 = (h_x * h_k) * c_prod.1 := h_prod
    rw [h_prod_coe, hw₀_eval (h_x * h_k) (H.mul_mem hh_x hh_k) c_prod,
      hw₀_eval h_x hh_x ⟨c_x, hc_x⟩, hw₀_k]
    dsimp only [c_prod]
    rw [hlam_mul, h_conj_hk ⟨c_x, hc_x⟩, mul_comm]
  have hw₀_one : w₀.1 1 = 1 := by
    have h1 : (1 : G) = 1 * (1 : C).1 := by simp
    rw [h1, hw₀_eval 1 H.one_mem 1, hlam_one]
  have hw₀_mul : ∀ k₁ k₂ : M_lam, w₀.1 (k₁ * k₂).1 = w₀.1 k₁.1 * w₀.1 k₂.1 := by
    intro k₁ k₂
    have h_ev := congr_fun (congr_arg Subtype.val (h_tau_M k₂)) k₁.1
    change w₀.1 (k₁.1 * k₂.1) = w₀.1 k₂.1 * w₀.1 k₁.1 at h_ev
    rw [Subgroup.coe_mul, h_ev, mul_comm]
  let ψ_lam : M_lam →* (Ω F)ˣ :=
    { toFun := fun k =>
        { val := w₀.1 k.1
          inv := w₀.1 (k⁻¹).1
          val_inv := by rw [← hw₀_mul, mul_inv_cancel, Subgroup.coe_one, hw₀_one]
          inv_val := by rw [← hw₀_mul, inv_mul_cancel, Subgroup.coe_one, hw₀_one] }
      map_one' := Units.ext hw₀_one
      map_mul' := fun k₁ k₂ => Units.ext (hw₀_mul k₁ k₂) }
  have hw_bar_M : ∀ k : M_lam, σ k.1 w_bar = (ψ_lam k : Ω F) • w_bar := by
    intro k
    dsimp only [w_bar]
    have h_inter : π (rightTransRep F H k.1 w₀) = σ k.1 (π w₀) :=
      LinearMap.congr_fun (hπ_inter k.1) w₀
    rw [← h_inter, h_tau_M k, map_smul]
    rfl
  exact ⟨lam, M_lam, ψ_lam, w_bar, hC_le, hM_lam, hw_bar_ne, hw_bar_C, hw_bar_M⟩

theorem ld_weight_orbit_submodule_trace (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (G : Type u) [Group G] [Fintype G]
    (C : Subgroup G) [C.Normal]
    {Q : Type u} [AddCommGroup Q] [Module (Ω F) Q] [FiniteDimensional (Ω F) Q]
    (σ : Representation (Ω F) G Q)
    (lam : C → Ω F) (M_lam : Subgroup G)
    (hM_lam : ∀ g : G, g ∈ M_lam ↔ ∀ (c : C) (hc : g⁻¹ * c.1 * g ∈ C), lam ⟨g⁻¹ * c.1 * g, hc⟩ = lam c)
    (ψ_lam : M_lam →* (Ω F)ˣ) (w_bar : Q) (hw_ne : w_bar ≠ 0)
    (hw_C : ∀ c : C, σ c.1 w_bar = lam c • w_bar)
    (hw_M : ∀ k : M_lam, σ k.1 w_bar = (ψ_lam k : Ω F) • w_bar) :
    ∃ (W : Submodule (Ω F) Q) (hW : ∀ g : G, W ≤ Submodule.comap (σ g) W),
      W ≠ ⊥ ∧
      ∀ g : G,
        LinearMap.trace (Ω F) W (subRep σ W hW g) =
          indCharTrace F M_lam ψ_lam g :=
by
  
  have h_indep : ∀ {ι : Type u} [DecidableEq ι] (μ : ι → (C → Ω F)),
      Function.Injective μ →
      ∀ (S : Finset ι) (f : ι → Q),
        (∀ i ∈ S, ∀ c : C, σ c.1 (f i) = μ i c • f i) →
        ∑ i ∈ S, f i = 0 →
        ∀ i ∈ S, f i = 0 := by
    intro ι _ μ hμ_inj S
    induction' S using Finset.induction_on with i₀ S₀ hi₀ ih
    · intro f _ _ i hi
      simp at hi
    · intro f hf hsum
      rw [Finset.sum_insert hi₀] at hsum
      have h_ann : ∀ (c : C) (i : ι), i ∈ S₀ → (μ i c - μ i₀ c) • f i = 0 := by
        intro c
        apply ih (fun i => (μ i c - μ i₀ c) • f i)
        · intro i hi b
          have hfi : σ b.1 (f i) = μ i b • f i := hf i (Finset.mem_insert_of_mem hi) b
          rw [map_smul, hfi, smul_comm]
        · have h_term : ∀ i ∈ S₀, (μ i c - μ i₀ c) • f i = σ c.1 (f i) - μ i₀ c • f i := by
            intro i hi
