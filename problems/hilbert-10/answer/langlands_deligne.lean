                  πK₁ ^ n * (σ_lift πK₁ - πK₁) := by
              rw [pow_succ (σ_lift πK₁) n, pow_succ πK₁ n]
              ring
            have hσπ_val : σ_lift πK₁ = 0 ∨ (1 : ℤ) ≤ valL F K₁ (σ_lift πK₁) :=
              Or.inr (by rw [hσ_val πK₁, hϖ_K₁])
            have hπn_val : πK₁ ^ n = 0 ∨ (n : ℤ) ≤ valL F K₁ (πK₁ ^ n) :=
              Or.inr (by rw [(hval_piK₁_pow n).2])
            have ht1 := hval_mul_ge_K₁ ((n : ℤ) + (d₁ : ℤ)) 1
              ((σ_lift πK₁) ^ n - πK₁ ^ n) (σ_lift πK₁) (ih hn1) hσπ_val
            have ht2 := hval_mul_ge_K₁ (n : ℤ) ((d₁ : ℤ) + 1)
              (πK₁ ^ n) (σ_lift πK₁ - πK₁) hπn_val hπ_diff
            have ht1' : ((σ_lift πK₁) ^ n - πK₁ ^ n) * σ_lift πK₁ = 0 ∨
                ((n + 1 : ℕ) : ℤ) + (d₁ : ℤ) ≤
                  valL F K₁ (((σ_lift πK₁) ^ n - πK₁ ^ n) * σ_lift πK₁) := by
              rcases ht1 with h0 | hge
              · exact Or.inl h0
              · right; push_cast; omega
            have ht2' : πK₁ ^ n * (σ_lift πK₁ - πK₁) = 0 ∨
                ((n + 1 : ℕ) : ℤ) + (d₁ : ℤ) ≤
                  valL F K₁ (πK₁ ^ n * (σ_lift πK₁ - πK₁)) := by
              rcases ht2 with h0 | hge
              · exact Or.inl h0
              · right; push_cast; omega
            rw [h_id]
            exact hval_add_K₁ (((n + 1 : ℕ) : ℤ) + (d₁ : ℤ)) _ _ ht1' ht2'
      set m : ℤ := valL F K₁ (v : K₁)
      obtain ⟨c, hv_eq, hval_iff⟩ := hBasis_K₁ (v : K₁)
      have hc_bound := (hval_iff m).mp (Or.inr le_rfl)
      have hσv_sub : σ_lift (v : K₁) - (v : K₁) =
          ∑ i : Fin p, IntermediateField.inclusion hM₁'K₁ (c i) *
            ((σ_lift πK₁) ^ (i : ℕ) - πK₁ ^ (i : ℕ)) := by
        conv_lhs => rw [hv_eq]
        rw [map_sum σ_lift, ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [map_mul σ_lift, map_pow σ_lift, hσ_M₁' (c i), ← mul_sub]
      have hσv_shift : σ_lift (v : K₁) - (v : K₁) = 0 ∨
