            rw [← mul_assoc, h1, h2, h3]
          have hdeg_eq : Module.finrank L (IntermediateField.extendScalars hLF'₀) *
              Module.finrank F'₀ (IntermediateField.extendScalars hF'₀K) =
              Module.finrank L (IntermediateField.extendScalars hLK) :=
            Nat.eq_of_mul_eq_mul_left hposL hmul_eq
