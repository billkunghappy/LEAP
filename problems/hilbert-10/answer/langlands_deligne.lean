theorem ld_ch12_wild_dyadic_odd_max_break_generator_perturbation_and_valuations (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (a e : ℕ) (ha_ge1 : 1 ≤ a) (he_ge_a : a ≤ e)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hval_normE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_normM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (τ₁ : M₁' ≃ₐ[F] M₁') (σ₂ : E' ≃ₐ[F] E')
    (hτ₁_L : ∀ x : L, τ₁ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hτ₁_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) = z + τ₁ z)
    (hτ₁_norm : ∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) = z * τ₁ z)
    (hσ₂_L : ∀ x : L, σ₂ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x)
    (hσ₂_tr : ∀ y : E', IntermediateField.inclusion hLE' (traceLM F hLE' y) = y + σ₂ y)
    (hσ₂_norm : ∀ y : E', IntermediateField.inclusion hLE' (normLM F hLE' y) = y * σ₂ y)
    (h2_ne : (2 : L) ≠ 0)
    (h2_val : valL F L (2 : L) = (e : ℤ))
    (x₀ : M₁') (R₀ : E') (f₀ ρ₀ : L)
    (hf₀_ne : f₀ ≠ 0) (hρ₀_ne : ρ₀ ≠ 0)
    (hf₀_val : valL F L f₀ = (1 - 2 * (a : ℤ)))
    (hρ₀_val : valL F L ρ₀ = 1)
    (hx₀_sq : x₀ ^ 2 + x₀ = IntermediateField.inclusion hLM₁' f₀)
    (hx₀_conj : τ₁ x₀ = -1 - x₀)
    (hR₀_sq : R₀ ^ 2 = IntermediateField.inclusion hLE' ρ₀)
    (hR₀_conj : σ₂ R₀ = -R₀)
    (c_a : Lˣ) (hc_a : valL F L (c_a : L) = -(a : ℤ))
    (w d : L)
    (hw_val : w = 0 ∨ (1 - (a : ℤ)) ≤ valL F L w)
    (hd_ne : d ≠ 0) (hd_val : valL F L d = 0) :
    let u₂ : Lˣ := Units.mk0 (2 : L) h2_ne
    let u₄ : Lˣ := u₂ ^ 2
    let x : M₁' := x₀ + IntermediateField.inclusion hLM₁' w * (1 + 2 * x₀)
    let d' : L := d * (c_a : L)
    let R : E' := IntermediateField.inclusion hLE' ((2 : L) * d') * R₀
    let f : L := f₀ + (w + w ^ 2) * (1 + 4 * f₀)
    let ρ : L := 4 * d' ^ 2 * ρ₀
    let E : L := f + d ^ 2 * (-ρ₀ * (c_a : L) ^ 2)
    let h₀ : L := (1 + 4 * f) * ((u₄⁻¹ : Lˣ) : L) * ρ
    let β₁ : L := -4 * f
    let β₂ : L := 1 - ρ
    x ≠ 0 ∧ R ≠ 0 ∧ f ≠ 0 ∧ ρ ≠ 0 ∧ h₀ ≠ 0 ∧ β₁ ≠ 0 ∧ β₂ ≠ 0 ∧
    4 * f - ρ = 4 * E ∧
    valL F M₁' x = (1 - 2 * (a : ℤ)) ∧
    valL F L f = (1 - 2 * (a : ℤ)) ∧
    valL F E' R = (2 * (e : ℤ) + 1 - 2 * (a : ℤ)) ∧
    valL F L ρ = (2 * (e : ℤ) + 1 - 2 * (a : ℤ)) ∧
    valL F L h₀ = (1 - 2 * (a : ℤ)) ∧
    valL F L β₁ = (2 * (e : ℤ) + 1 - 2 * (a : ℤ)) ∧
    valL F L β₂ = 0 ∧
    traceLM F hLM₁' x = -1 ∧
    normLM F hLM₁' x = -f ∧
    x ^ 2 + x = IntermediateField.inclusion hLM₁' f ∧
    τ₁ x = -1 - x ∧
    traceLM F hLE' R = 0 ∧
    normLM F hLE' R = -ρ ∧
    R ^ 2 = IntermediateField.inclusion hLE' ρ ∧
    σ₂ R = -R :=
by
  rcases hvalL_props with
    ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj,
     hval_add, hunit0, hunita, hunit_val0⟩
  dsimp only
  set u₂ : Lˣ := Units.mk0 (2 : L) h2_ne
  set u₄ : Lˣ := u₂ ^ 2
  set x : M₁' := x₀ + IntermediateField.inclusion hLM₁' w * (1 + 2 * x₀)
  set d' : L := d * (c_a : L)
  set R : E' := IntermediateField.inclusion hLE' ((2 : L) * d') * R₀
  set f : L := f₀ + (w + w ^ 2) * (1 + 4 * f₀)
  set ρ : L := 4 * d' ^ 2 * ρ₀
  set E : L := f + d ^ 2 * (-ρ₀ * (c_a : L) ^ 2)
  set h₀ : L := (1 + 4 * f) * ((u₄⁻¹ : Lˣ) : L) * ρ
  set β₁ : L := -4 * f
  set β₂ : L := 1 - ρ
  have hL_mono : ∀ {m₁ m₂ : ℤ} {z : L},
      m₁ ≤ m₂ → (z = 0 ∨ m₂ ≤ valL F L z) → (z = 0 ∨ m₁ ≤ valL F L z) := by
    intro m₁ m₂ z hm hz
    rcases hz with rfl | hz
    · exact Or.inl rfl
    · exact Or.inr (le_trans hm hz)
  have hL_neg : ∀ {m : ℤ} {z : L},
      (z = 0 ∨ m ≤ valL F L z) → (-z = 0 ∨ m ≤ valL F L (-z)) := by
    intro m z hz
    rcases hz with rfl | hz
    · simp
    · exact Or.inr (by rw [hval_neg]; exact hz)
  have hL_add : ∀ {m : ℤ} {z₁ z₂ : L},
      (z₁ = 0 ∨ m ≤ valL F L z₁) → (z₂ = 0 ∨ m ≤ valL F L z₂) →
      (z₁ + z₂ = 0 ∨ m ≤ valL F L (z₁ + z₂)) := by
    intro m z₁ z₂ h₁ h₂
    exact hval_add m z₁ z₂ h₁ h₂
  have hL_sub : ∀ {m : ℤ} {z₁ z₂ : L},
      (z₁ = 0 ∨ m ≤ valL F L z₁) → (z₂ = 0 ∨ m ≤ valL F L z₂) →
      (z₁ - z₂ = 0 ∨ m ≤ valL F L (z₁ - z₂)) := by
    intro m z₁ z₂ h₁ h₂
    rw [sub_eq_add_neg]
    exact hL_add h₁ (hL_neg h₂)
  have hL_mul : ∀ {m₁ m₂ : ℤ} {z₁ z₂ : L},
      (z₁ = 0 ∨ m₁ ≤ valL F L z₁) → (z₂ = 0 ∨ m₂ ≤ valL F L z₂) →
      (z₁ * z₂ = 0 ∨ m₁ + m₂ ≤ valL F L (z₁ * z₂)) := by
    intro m₁ m₂ z₁ z₂ h₁ h₂
    by_cases hz₁ : z₁ = 0
    · exact Or.inl (by simp [hz₁])
    · by_cases hz₂ : z₂ = 0
      · exact Or.inl (by simp [hz₂])
      · rcases h₁ with rfl | h₁
        · contradiction
        · rcases h₂ with rfl | h₂
          · contradiction
          · right
            rw [hval_mul z₁ z₂ hz₁ hz₂]
            exact add_le_add h₁ h₂
  have hL_sq : ∀ {m : ℤ} {z : L},
      (z = 0 ∨ m ≤ valL F L z) → (z ^ 2 = 0 ∨ 2 * m ≤ valL F L (z ^ 2)) := by
    intro m z hz
    have h := hL_mul hz hz
    rwa [← sq, ← two_mul] at h
  have hL_dom : ∀ {x y : L},
      x ≠ 0 → (y = 0 ∨ valL F L x + 1 ≤ valL F L y) →
      x + y ≠ 0 ∧ valL F L (x + y) = valL F L x := by
    intro x y hx hy
    have hx_ge : x = 0 ∨ valL F L x ≤ valL F L x := Or.inr le_rfl
    have hy_ge : y = 0 ∨ valL F L x ≤ valL F L y := hL_mono (by omega) hy
    have hxy_ge : x + y = 0 ∨ valL F L x ≤ valL F L (x + y) := hL_add hx_ge hy_ge
    have hxy_not_gt : ¬ (x + y = 0 ∨ valL F L x + 1 ≤ valL F L (x + y)) := by
      intro hgt
      have hx_sub : x = (x + y) - y := by ring
      have hx_gt : x = 0 ∨ valL F L x + 1 ≤ valL F L x := by
        have hsub := hL_sub hgt hy
        rwa [← hx_sub] at hsub
      rcases hx_gt with rfl | hx_gt
      · exact hx rfl
      · omega
    rcases hxy_ge with h0 | hge
    · exfalso; exact hxy_not_gt (Or.inl h0)
    · have hne : x + y ≠ 0 := fun h0 => hxy_not_gt (Or.inl h0)
      have hlt : ¬ (valL F L x + 1 ≤ valL F L (x + y)) := fun h1 => hxy_not_gt (Or.inr h1)
      exact ⟨hne, by omega⟩
  have h4_eq : (4 : L) = (2 : L) * (2 : L) := by norm_num
  have h4_ne : (4 : L) ≠ 0 := by
    rw [h4_eq]
    exact mul_ne_zero h2_ne h2_ne
  have h4_val : valL F L (4 : L) = 2 * (e : ℤ) := by
    rw [h4_eq, hval_mul (2 : L) (2 : L) h2_ne h2_ne, h2_val]
    ring
  have hu₄_coe : (u₄ : L) = (4 : L) := by
    simp [u₄, u₂, sq]
    norm_num
  have hu₄_inv_ne : ((u₄⁻¹ : Lˣ) : L) ≠ 0 := (u₄⁻¹ : Lˣ).ne_zero
  have hu₄_inv_val : valL F L ((u₄⁻¹ : Lˣ) : L) = -(2 * (e : ℤ)) := by
    rw [hval_inv u₄, hu₄_coe, h4_val]
  have h4f_ρ : 4 * f - ρ = 4 * E := by
    dsimp only [f, ρ, E, d']
    ring
  have hx_conj : τ₁ x = -1 - x := by
    have hτ₁_x : τ₁ x = τ₁ x₀ + τ₁ (IntermediateField.inclusion hLM₁' w) * (1 + 2 * τ₁ x₀) := by
      dsimp only [x]
      simp [map_add, map_mul, map_one, map_ofNat]
    rw [hτ₁_x, hτ₁_L w, hx₀_conj]
    dsimp only [x]
    ring
  have hx_tr : traceLM F hLM₁' x = -1 := by
    apply (IntermediateField.inclusion hLM₁').injective
    change IntermediateField.inclusion hLM₁' (traceLM F hLM₁' x) =
      IntermediateField.inclusion hLM₁' (-1)
    rw [hτ₁_tr x, hx_conj, map_neg, map_one]
    ring
  have hx_sq : x ^ 2 + x = IntermediateField.inclusion hLM₁' f := by
    have hf_map : IntermediateField.inclusion hLM₁' f =
        IntermediateField.inclusion hLM₁' f₀ +
          (IntermediateField.inclusion hLM₁' w + (IntermediateField.inclusion hLM₁' w) ^ 2) *
            (1 + 4 * IntermediateField.inclusion hLM₁' f₀) := by
      dsimp only [f]
      simp [map_add, map_mul, map_pow, map_one, map_ofNat]
    rw [hf_map]
    dsimp only [x]
    linear_combination (1 + 2 * IntermediateField.inclusion hLM₁' w) ^ 2 * hx₀_sq
  have hx_norm : normLM F hLM₁' x = -f := by
    apply (IntermediateField.inclusion hLM₁').injective
    change IntermediateField.inclusion hLM₁' (normLM F hLM₁' x) =
      IntermediateField.inclusion hLM₁' (-f)
    rw [hτ₁_norm x, hx_conj, map_neg, ← hx_sq]
    ring
  have hR_conj : σ₂ R = -R := by
    have hσ₂_R : σ₂ R = σ₂ (IntermediateField.inclusion hLE' ((2 : L) * d')) * σ₂ R₀ := by
      dsimp only [R]
      simp [map_mul]
    rw [hσ₂_R, hσ₂_L ((2 : L) * d'), hR₀_conj]
    dsimp only [R]
    ring
  have hR_tr : traceLM F hLE' R = 0 := by
    apply (IntermediateField.inclusion hLE').injective
    change IntermediateField.inclusion hLE' (traceLM F hLE' R) =
      IntermediateField.inclusion hLE' 0
    rw [hσ₂_tr R, hR_conj, map_zero]
    ring
  have hR_sq : R ^ 2 = IntermediateField.inclusion hLE' ρ := by
    have hρ_map : IntermediateField.inclusion hLE' ρ =
        4 * (IntermediateField.inclusion hLE' d') ^ 2 * IntermediateField.inclusion hLE' ρ₀ := by
      dsimp only [ρ]
      simp [map_mul, map_pow, map_ofNat]
    have h2d'_map : IntermediateField.inclusion hLE' ((2 : L) * d') =
        2 * IntermediateField.inclusion hLE' d' := by
      simp [map_mul, map_ofNat]
    rw [hρ_map]
    dsimp only [R]
    rw [h2d'_map]
    linear_combination (2 * IntermediateField.inclusion hLE' d') ^ 2 * hR₀_sq
  have hR_norm : normLM F hLE' R = -ρ := by
    apply (IntermediateField.inclusion hLE').injective
    change IntermediateField.inclusion hLE' (normLM F hLE' R) =
      IntermediateField.inclusion hLE' (-ρ)
    rw [hσ₂_norm R, hR_conj, map_neg, ← hR_sq]
    ring
  have h4f₀_val : valL F L ((4 : L) * f₀) = 2 * (e : ℤ) + (1 - 2 * (a : ℤ)) := by
    rw [hval_mul (4 : L) f₀ h4_ne hf₀_ne, h4_val, hf₀_val]
  have h4f₀_ge0 : (4 : L) * f₀ = 0 ∨ (0 : ℤ) ≤ valL F L ((4 : L) * f₀) := by
    right
    rw [h4f₀_val]
    omega
  have h1_ge0 : (1 : L) = 0 ∨ (0 : ℤ) ≤ valL F L 1 := by
    right
    rw [hval1]
  have h14f₀_ge0 : 1 + 4 * f₀ = 0 ∨ (0 : ℤ) ≤ valL F L (1 + 4 * f₀) :=
    hL_add h1_ge0 h4f₀_ge0
  have hw_ge : w = 0 ∨ (2 - 2 * (a : ℤ)) ≤ valL F L w :=
    hL_mono (by omega) hw_val
  have hw2_ge : w ^ 2 = 0 ∨ (2 - 2 * (a : ℤ)) ≤ valL F L (w ^ 2) :=
    hL_mono (by omega) (hL_sq hw_val)
  have hww2_ge : w + w ^ 2 = 0 ∨ (2 - 2 * (a : ℤ)) ≤ valL F L (w + w ^ 2) :=
    hL_add hw_ge hw2_ge
  have hδ_f : (w + w ^ 2) * (1 + 4 * f₀) = 0 ∨
      valL F L f₀ + 1 ≤ valL F L ((w + w ^ 2) * (1 + 4 * f₀)) := by
    have h := hL_mul hww2_ge h14f₀_ge0
    exact hL_mono (by rw [hf₀_val]; omega) h
  have hf_dom := hL_dom hf₀_ne hδ_f
  have hf_ne : f ≠ 0 := hf_dom.1
  have hf_val : valL F L f = (1 - 2 * (a : ℤ)) := by
    change valL F L (f₀ + (w + w ^ 2) * (1 + 4 * f₀)) = 1 - 2 * (a : ℤ)
    rw [hf_dom.2, hf₀_val]
  have hx_val : valL F M₁' x = (1 - 2 * (a : ℤ)) := by
    rw [← hval_normM₁' x, hx_norm, hval_neg, hf_val]
  have hx_ne : x ≠ 0 := by
    intro hx0
    have h0 : IntermediateField.inclusion hLM₁' f = IntermediateField.inclusion hLM₁' 0 := by
      rw [← hx_sq, hx0]
      simp
    exact hf_ne ((IntermediateField.inclusion hLM₁').injective h0)
  have hc_a_ne : (c_a : L) ≠ 0 := c_a.ne_zero
  have hd'_ne : d' ≠ 0 := mul_ne_zero hd_ne hc_a_ne
  have hd'_val : valL F L d' = -(a : ℤ) := by
    change valL F L (d * (c_a : L)) = -(a : ℤ)
    rw [hval_mul d (c_a : L) hd_ne hc_a_ne, hd_val, hc_a]
    omega
  have hd'2_ne : d' ^ 2 ≠ 0 := pow_ne_zero 2 hd'_ne
  have hd'2_val : valL F L (d' ^ 2) = -2 * (a : ℤ) := by
    rw [sq, hval_mul d' d' hd'_ne hd'_ne, hd'_val]
    omega
  have h4d'2_ne : (4 : L) * d' ^ 2 ≠ 0 := mul_ne_zero h4_ne hd'2_ne
  have h4d'2_val : valL F L ((4 : L) * d' ^ 2) = 2 * (e : ℤ) - 2 * (a : ℤ) := by
    rw [hval_mul (4 : L) (d' ^ 2) h4_ne hd'2_ne, h4_val, hd'2_val]
    omega
  have hρ_ne : ρ ≠ 0 := mul_ne_zero h4d'2_ne hρ₀_ne
  have hρ_val : valL F L ρ = (2 * (e : ℤ) + 1 - 2 * (a : ℤ)) := by
    change valL F L (4 * d' ^ 2 * ρ₀) = 2 * (e : ℤ) + 1 - 2 * (a : ℤ)
    rw [hval_mul (4 * d' ^ 2) ρ₀ h4d'2_ne hρ₀_ne, h4d'2_val, hρ₀_val]
    omega
  have hR_val : valL F E' R = (2 * (e : ℤ) + 1 - 2 * (a : ℤ)) := by
    rw [← hval_normE' R, hR_norm, hval_neg, hρ_val]
  have hR_ne : R ≠ 0 := by
    intro hR0
    have h0 : IntermediateField.inclusion hLE' ρ = IntermediateField.inclusion hLE' 0 := by
      rw [← hR_sq, hR0]
      simp
    exact hρ_ne ((IntermediateField.inclusion hLE').injective h0)
  have h4f_ne : (4 : L) * f ≠ 0 := mul_ne_zero h4_ne hf_ne
  have h4f_val : valL F L ((4 : L) * f) = 2 * (e : ℤ) + 1 - 2 * (a : ℤ) := by
    rw [hval_mul (4 : L) f h4_ne hf_ne, h4_val, hf_val]
    omega
  have hβ₁_eq : β₁ = -((4 : L) * f) := by
    dsimp only [β₁]
    ring
  have hβ₁_ne : β₁ ≠ 0 := by
    rw [hβ₁_eq]
    exact neg_ne_zero.mpr h4f_ne
  have hβ₁_val : valL F L β₁ = (2 * (e : ℤ) + 1 - 2 * (a : ℤ)) := by
    rw [hβ₁_eq, hval_neg, h4f_val]
  have hnρ_ge1 : -ρ = 0 ∨ valL F L (1 : L) + 1 ≤ valL F L (-ρ) := by
    right
    rw [hval1, hval_neg, hρ_val]
    omega
  have hβ₂_dom := hL_dom (one_ne_zero : (1 : L) ≠ 0) hnρ_ge1
  have hβ₂_eq : (1 : L) + (-ρ) = β₂ := by
    dsimp only [β₂]
    ring
  have hβ₂_ne : β₂ ≠ 0 := by
    rw [← hβ₂_eq]
    exact hβ₂_dom.1
  have hβ₂_val : valL F L β₂ = 0 := by
    rw [← hβ₂_eq, hβ₂_dom.2, hval1]
  have h4f_ge1 : (4 : L) * f = 0 ∨ valL F L (1 : L) + 1 ≤ valL F L ((4 : L) * f) := by
    right
    rw [hval1, h4f_val]
    omega
  have h14f_dom := hL_dom (one_ne_zero : (1 : L) ≠ 0) h4f_ge1
  have h14f_ne : 1 + 4 * f ≠ 0 := h14f_dom.1
  have h14f_val : valL F L (1 + 4 * f) = 0 := by
    rw [h14f_dom.2, hval1]
  have h14f_u₄_ne : (1 + 4 * f) * ((u₄⁻¹ : Lˣ) : L) ≠ 0 :=
    mul_ne_zero h14f_ne hu₄_inv_ne
  have h14f_u₄_val : valL F L ((1 + 4 * f) * ((u₄⁻¹ : Lˣ) : L)) = -(2 * (e : ℤ)) := by
    rw [hval_mul (1 + 4 * f) ((u₄⁻¹ : Lˣ) : L) h14f_ne hu₄_inv_ne, h14f_val, hu₄_inv_val]
    omega
  have hh₀_ne : h₀ ≠ 0 := mul_ne_zero h14f_u₄_ne hρ_ne
  have hh₀_val : valL F L h₀ = (1 - 2 * (a : ℤ)) := by
    change valL F L ((1 + 4 * f) * ((u₄⁻¹ : Lˣ) : L) * ρ) = 1 - 2 * (a : ℤ)
    rw [hval_mul ((1 + 4 * f) * ((u₄⁻¹ : Lˣ) : L)) ρ h14f_u₄_ne hρ_ne, h14f_u₄_val, hρ_val]
    omega
  exact ⟨hx_ne, hR_ne, hf_ne, hρ_ne, hh₀_ne, hβ₁_ne, hβ₂_ne,
    h4f_ρ, hx_val, hf_val, hR_val, hρ_val, hh₀_val, hβ₁_val, hβ₂_val,
    hx_tr, hx_norm, hx_sq, hx_conj, hR_tr, hR_norm, hR_sq, hR_conj⟩

theorem ld_ch12_wild_dyadic_odd_max_break_biquad_shift_table (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y))
    (hDiamond_M₁' : ∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z))
    (τ₁ : M₁' ≃ₐ[F] M₁') (σ₂ : E' ≃ₐ[F] E')
    (hτ₁_L : ∀ x : L, τ₁ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hτ₁_norm : ∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) = z * τ₁ z)
    (hσ₂_L : ∀ x : L, σ₂ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x)
    (hσ₂_norm : ∀ y : E', IntermediateField.inclusion hLE' (normLM F hLE' y) = y * σ₂ y)
    (h2_ne : (2 : L) ≠ 0)
    (x : M₁') (R : E') (f ρ E : L)
    (h4f_ρ : 4 * f - ρ = 4 * E)
    (hx_tr : traceLM F hLM₁' x = -1)
    (hx_norm : normLM F hLM₁' x = -f)
    (hx_sq : x ^ 2 + x = IntermediateField.inclusion hLM₁' f)
    (hx_conj : τ₁ x = -1 - x)
    (hR_tr : traceLM F hLE' R = 0)
    (hR_norm : normLM F hLE' R = -ρ)
    (hR_sq : R ^ 2 = IntermediateField.inclusion hLE' ρ)
    (hR_conj : σ₂ R = -R) :
    let u₂ : Lˣ := Units.mk0 (2 : L) h2_ne
    let u₄ : Lˣ := u₂ ^ 2
    let h₀ : L := (1 + 4 * f) * ((u₄⁻¹ : Lˣ) : L) * ρ
    let Y : K₁ := IntermediateField.inclusion hM₁'K₁ x +
      IntermediateField.inclusion hE'K₁
        (IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L) * R)
    let z₃ : K₁ := (2 * IntermediateField.inclusion hM₁'K₁ x + 1) *
      IntermediateField.inclusion hE'K₁
        (IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L) * R)
    let h₁ : M₁' := 2 * x
    let h₂ : E' := R - 1
    let β₁ : L := -4 * f
    let β₂ : L := 1 - ρ
    let a₁ : M₁' := IntermediateField.inclusion hLM₁' E - x
    let a₂ : E' := -IntermediateField.inclusion hLE' E -
      IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L) * R
    ∀ (c₀ c₁ : L),
      let p_X := 2 * c₀
      let A := c₀ ^ 2 - c₁ ^ 2 * h₀
      let X : K₁ := IntermediateField.inclusion (hLE'.trans hE'K₁) c₀ +
        IntermediateField.inclusion (hLE'.trans hE'K₁) c₁ * z₃
      let C : K₁ := Y - X
      let Q₁ : M₁' := IntermediateField.inclusion hLM₁' (c₁ * ((u₂⁻¹ : Lˣ) : L) * ρ) +
        IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * ρ) * x
      let Q₂ : E' := IntermediateField.inclusion hLE' c₀ +
        IntermediateField.inclusion hLE'
          ((-2 * c₀ + c₁ * (1 + 4 * f)) * ((u₂⁻¹ : Lˣ) : L)) * R
      traceLM F hM₁'K₁ C = h₁ - IntermediateField.inclusion hLM₁' p_X ∧
      traceLM F hE'K₁ C = h₂ - IntermediateField.inclusion hLE' p_X ∧
      normLM F hM₁'K₁ C = a₁ + IntermediateField.inclusion hLM₁' A + Q₁ ∧
      normLM F hE'K₁ C = a₂ + IntermediateField.inclusion hLE' A + Q₂ ∧
      normLM F hLM₁' h₁ = β₁ ∧
      normLM F hLE' h₂ = β₂ ∧
      normLM F hLM₁' Q₁ - β₁ * A =
        c₁ * ((u₄⁻¹ : Lˣ) : L) * ρ * (1 + 4 * f) * (4 * c₀ - c₁ * (4 * f + ρ)) ∧
      traceLM F hE'K₁ (Y * (IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ C) - C)) =
        IntermediateField.inclusion hLE' (c₀ - 2 * E) +
          IntermediateField.inclusion hLE'
            ((-2 * c₀ + c₁ * (1 + 4 * f) - 2) * ((u₂⁻¹ : Lˣ) : L)) * R :=
by
  intro u₂ u₄ h₀ Y z₃ h₁ h₂ β₁ β₂ a₁ a₂
  have hdeg2_M₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') = 2 :=
    hdegM₁'.trans hdeg2
  have hdeg2_E'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) = 2 :=
    hdegE'K₁.trans hdeg2
  have hdeg2_M₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) = 2 :=
    hdegM₁'K₁.trans hdeg2
  have hinc_E'K₁ : ∀ c : L,
      IntermediateField.inclusion (hLE'.trans hE'K₁) c =
        IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' c) :=
    fun _ => rfl
  have hinc_M₁'K₁ : ∀ c : L,
      IntermediateField.inclusion (hLE'.trans hE'K₁) c =
        IntermediateField.inclusion hM₁'K₁ (IntermediateField.inclusion hLM₁' c) :=
    fun _ => rfl
  have hinc_swap : ∀ c : L,
      IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' c) =
        IntermediateField.inclusion hM₁'K₁ (IntermediateField.inclusion hLM₁' c) :=
    fun _ => rfl
  have hu₂ : (2 : L) * ((u₂⁻¹ : Lˣ) : L) = 1 := u₂.mul_inv
  have hu₄ : ((u₄⁻¹ : Lˣ) : L) = ((u₂⁻¹ : Lˣ) : L) ^ 2 := by
    dsimp only [u₄]
    rw [← inv_pow, Units.val_pow_eq_pow_val]
  have hE_eq : E = f - ((u₂⁻¹ : Lˣ) : L) ^ 2 * ρ := by
    linear_combination - ((u₂⁻¹ : Lˣ) : L) ^ 2 * h4f_ρ +
      (2 * ((u₂⁻¹ : Lˣ) : L) + 1) * (f - E) * hu₂
  have hu₂_M₁' : (2 : M₁') * IntermediateField.inclusion hLM₁' ((u₂⁻¹ : Lˣ) : L) = 1 := by
    have h := congrArg (IntermediateField.inclusion hLM₁') hu₂
    simpa only [map_mul, map_ofNat, map_one] using h
  have hu₂_E' : (2 : E') * IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L) = 1 := by
    have h := congrArg (IntermediateField.inclusion hLE') hu₂
    simpa only [map_mul, map_ofNat, map_one] using h
  have hnorm_M₁' : ∀ s₀ s₁ : L,
      normLM F hLM₁' (IntermediateField.inclusion hLM₁' s₀ +
        IntermediateField.inclusion hLM₁' s₁ * x) =
      s₀ ^ 2 - s₀ * s₁ - s₁ ^ 2 * f := by
    intro s₀ s₁
    apply (IntermediateField.inclusion hLM₁').injective
    change IntermediateField.inclusion hLM₁'
        (normLM F hLM₁' (IntermediateField.inclusion hLM₁' s₀ +
          IntermediateField.inclusion hLM₁' s₁ * x)) =
      IntermediateField.inclusion hLM₁' (s₀ ^ 2 - s₀ * s₁ - s₁ ^ 2 * f)
    rw [hτ₁_norm, map_add, map_mul, hτ₁_L s₀, hτ₁_L s₁, hx_conj,
      map_sub, map_sub, map_pow, map_mul, map_mul, map_pow]
    linear_combination - (IntermediateField.inclusion hLM₁' s₁) ^ 2 * hx_sq
  have hnorm_E' : ∀ t₀ t₁ : L,
      normLM F hLE' (IntermediateField.inclusion hLE' t₀ +
        IntermediateField.inclusion hLE' t₁ * R) =
      t₀ ^ 2 - t₁ ^ 2 * ρ := by
    intro t₀ t₁
    apply (IntermediateField.inclusion hLE').injective
    change IntermediateField.inclusion hLE'
        (normLM F hLE' (IntermediateField.inclusion hLE' t₀ +
          IntermediateField.inclusion hLE' t₁ * R)) =
      IntermediateField.inclusion hLE' (t₀ ^ 2 - t₁ ^ 2 * ρ)
    rw [hσ₂_norm, map_add, map_mul, hσ₂_L t₀, hσ₂_L t₁, hR_conj,
      map_sub, map_pow, map_mul, map_pow]
    linear_combination - (IntermediateField.inclusion hLE' t₁) ^ 2 * hR_sq
  have hQuadAff : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂] (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      ∀ (u v : M₀) (w : M₂),
        traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ u +
          IntermediateField.inclusion hM₀M₂ v * w) =
          (2 : M₀) * u + v * traceLM F hM₀M₂ w ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ u +
          IntermediateField.inclusion hM₀M₂ v * w) =
          u ^ 2 + u * (v * traceLM F hM₀M₂ w) + v ^ 2 * normLM F hM₀M₂ w := by
    intro M₀ M₂ _ _ hM₀M₂ hdeg u v w
    letI : Module M₀ M₀ := Semiring.toModule
    have htr_smul : traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ v * w) =
        v * traceLM F hM₀M₂ w :=
      (Algebra.trace M₀ (IntermediateField.extendScalars hM₀M₂)).map_smul' v
        (toExtendScalars F hM₀M₂ w)
    have hnorm_inc : normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ v) = v ^ 2 := by
      have halg : toExtendScalars F hM₀M₂ (IntermediateField.inclusion hM₀M₂ v) =
          algebraMap M₀ (IntermediateField.extendScalars hM₀M₂) v := rfl
      change Algebra.norm M₀ (toExtendScalars F hM₀M₂ (IntermediateField.inclusion hM₀M₂ v)) =
        v ^ 2
      rw [halg, Algebra.norm_algebraMap, hdeg]
    obtain ⟨htr_base, hnorm_add⟩ := hQuadNorm M₀ M₂ hM₀M₂ hdeg
    refine ⟨?_, ?_⟩
    · rw [map_add, htr_base u, htr_smul]
    · rw [(hnorm_add u (IntermediateField.inclusion hM₀M₂ v * w)).1,
        htr_smul, map_mul (normLM F hM₀M₂), hnorm_inc]
  intro c₀ c₁ p_X A X C Q₁ Q₂
  have hRK₁_tr : traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ R) = 0 := by
    rw [(hDiamond_E' R).2, hR_tr, map_zero]
  have hRK₁_norm : normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ R) =
      -IntermediateField.inclusion hLM₁' ρ := by
    rw [(hDiamond_E' R).1, hR_norm, map_neg]
  have hxK₁_tr : traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ x) = -1 := by
    rw [(hDiamond_M₁' x).2, hx_tr, map_neg, map_one]
  have hxK₁_norm : normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ x) =
      -IntermediateField.inclusion hLE' f := by
    rw [(hDiamond_M₁' x).1, hx_norm, map_neg]
  let U₁ : M₁' := x - IntermediateField.inclusion hLM₁' c₀
  let V₁ : M₁' := (1 - IntermediateField.inclusion hLM₁' c₁ * (2 * x + 1)) *
    IntermediateField.inclusion hLM₁' ((u₂⁻¹ : Lˣ) : L)
  have hC_M₁' : C = IntermediateField.inclusion hM₁'K₁ U₁ +
      IntermediateField.inclusion hM₁'K₁ V₁ * IntermediateField.inclusion hE'K₁ R := by
    change (IntermediateField.inclusion hM₁'K₁ x +
      IntermediateField.inclusion hE'K₁
        (IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L) * R)) -
      (IntermediateField.inclusion (hLE'.trans hE'K₁) c₀ +
        IntermediateField.inclusion (hLE'.trans hE'K₁) c₁ *
          ((2 * IntermediateField.inclusion hM₁'K₁ x + 1) *
            IntermediateField.inclusion hE'K₁
              (IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L) * R))) =
      IntermediateField.inclusion hM₁'K₁ U₁ +
        IntermediateField.inclusion hM₁'K₁ V₁ * IntermediateField.inclusion hE'K₁ R
    rw [map_mul (IntermediateField.inclusion hE'K₁),
      hinc_swap ((u₂⁻¹ : Lˣ) : L), hinc_M₁'K₁ c₀, hinc_M₁'K₁ c₁]
    dsimp only [U₁, V₁]
    simp only [map_sub, map_add, map_mul, map_one, map_ofNat]
    ring
  have hConj1 : traceLM F hM₁'K₁ C = h₁ - IntermediateField.inclusion hLM₁' p_X := by
    rw [hC_M₁', (hQuadAff M₁' K₁ hM₁'K₁ hdeg2_M₁'K₁ U₁ V₁
      (IntermediateField.inclusion hE'K₁ R)).1, hRK₁_tr]
    dsimp only [U₁, V₁, h₁, p_X]
    simp only [map_mul, map_ofNat]
    ring
  let U₂ : E' := IntermediateField.inclusion hLE' ((1 - c₁) * ((u₂⁻¹ : Lˣ) : L)) * R -
    IntermediateField.inclusion hLE' c₀
  let V₂ : E' := 1 - IntermediateField.inclusion hLE' (2 * c₁ * ((u₂⁻¹ : Lˣ) : L)) * R
  have hC_E' : C = IntermediateField.inclusion hE'K₁ U₂ +
      IntermediateField.inclusion hE'K₁ V₂ * IntermediateField.inclusion hM₁'K₁ x := by
    change (IntermediateField.inclusion hM₁'K₁ x +
      IntermediateField.inclusion hE'K₁
        (IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L) * R)) -
      (IntermediateField.inclusion (hLE'.trans hE'K₁) c₀ +
        IntermediateField.inclusion (hLE'.trans hE'K₁) c₁ *
          ((2 * IntermediateField.inclusion hM₁'K₁ x + 1) *
            IntermediateField.inclusion hE'K₁
              (IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L) * R))) =
      IntermediateField.inclusion hE'K₁ U₂ +
        IntermediateField.inclusion hE'K₁ V₂ * IntermediateField.inclusion hM₁'K₁ x
    rw [hinc_E'K₁ c₀, hinc_E'K₁ c₁]
    dsimp only [U₂, V₂]
    simp only [map_sub, map_add, map_mul, map_one, map_ofNat]
    ring
  have htrC_E' : traceLM F hE'K₁ C = (2 : E') * U₂ - V₂ := by
    rw [hC_E', (hQuadAff E' K₁ hE'K₁ hdeg2_E'K₁ U₂ V₂
      (IntermediateField.inclusion hM₁'K₁ x)).1, hxK₁_tr]
    ring
  have hConj2 : traceLM F hE'K₁ C = h₂ - IntermediateField.inclusion hLE' p_X := by
    rw [htrC_E']
    dsimp only [U₂, V₂, h₂, p_X]
    simp only [map_sub, map_mul, map_one, map_ofNat]
    linear_combination R * hu₂_E'
  have hConj3 : normLM F hM₁'K₁ C = a₁ + IntermediateField.inclusion hLM₁' A + Q₁ := by
    rw [hC_M₁', (hQuadAff M₁' K₁ hM₁'K₁ hdeg2_M₁'K₁ U₁ V₁
      (IntermediateField.inclusion hE'K₁ R)).2, hRK₁_tr, hRK₁_norm]
    dsimp only [U₁, V₁, a₁, A, Q₁, h₀]
    rw [hu₄, hE_eq]
    simp only [map_sub, map_add, map_mul, map_pow, map_neg, map_one, map_ofNat]
    linear_combination (1 - 4 * (IntermediateField.inclusion hLM₁' c₁) ^ 2 *
      (IntermediateField.inclusion hLM₁' ((u₂⁻¹ : Lˣ) : L)) ^ 2 *
        IntermediateField.inclusion hLM₁' ρ) * hx_sq +
      IntermediateField.inclusion hLM₁' c₁ * IntermediateField.inclusion hLM₁' ρ *
        ((2 * IntermediateField.inclusion hLM₁' ((u₂⁻¹ : Lˣ) : L) + 1) * x +
          IntermediateField.inclusion hLM₁' ((u₂⁻¹ : Lˣ) : L)) * hu₂_M₁'
  have hConj4 : normLM F hE'K₁ C = a₂ + IntermediateField.inclusion hLE' A + Q₂ := by
    rw [hC_E', (hQuadAff E' K₁ hE'K₁ hdeg2_E'K₁ U₂ V₂
      (IntermediateField.inclusion hM₁'K₁ x)).2, hxK₁_tr, hxK₁_norm]
    dsimp only [U₂, V₂, a₂, A, Q₂, h₀]
    rw [hu₄, hE_eq]
    simp only [map_sub, map_add, map_mul, map_pow, map_neg, map_one, map_ofNat]
    linear_combination (IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L)) ^ 2 *
      (1 - (IntermediateField.inclusion hLE' c₁) ^ 2 *
        (1 + 4 * IntermediateField.inclusion hLE' f)) * hR_sq
  have hConj5 : normLM F hLM₁' h₁ = β₁ := by
    have hh₁_eq : h₁ = IntermediateField.inclusion hLM₁' 0 +
        IntermediateField.inclusion hLM₁' 2 * x := by
      dsimp only [h₁]
      simp only [map_zero, map_ofNat, zero_add]
    rw [hh₁_eq, hnorm_M₁' 0 2]
    dsimp only [β₁]
    ring
  have hConj6 : normLM F hLE' h₂ = β₂ := by
    have hh₂_eq : h₂ = IntermediateField.inclusion hLE' (-1) +
        IntermediateField.inclusion hLE' 1 * R := by
      dsimp only [h₂]
      simp only [map_neg, map_one]
      ring
    rw [hh₂_eq, hnorm_E' (-1) 1]
    dsimp only [β₂]
    ring
  have hConj7 : normLM F hLM₁' Q₁ - β₁ * A =
      c₁ * ((u₄⁻¹ : Lˣ) : L) * ρ * (1 + 4 * f) * (4 * c₀ - c₁ * (4 * f + ρ)) := by
    change normLM F hLM₁' (IntermediateField.inclusion hLM₁' (c₁ * ((u₂⁻¹ : Lˣ) : L) * ρ) +
      IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * ρ) * x) - β₁ * A =
      c₁ * ((u₄⁻¹ : Lˣ) : L) * ρ * (1 + 4 * f) * (4 * c₀ - c₁ * (4 * f + ρ))
    rw [hnorm_M₁' (c₁ * ((u₂⁻¹ : Lˣ) : L) * ρ) (-2 * c₀ + c₁ * ρ)]
    dsimp only [β₁, A, h₀]
    rw [hu₄]
    linear_combination - c₁ * ρ *
      (2 * c₀ * ((u₂⁻¹ : Lˣ) : L) * (1 + 4 * f) + 4 * c₀ * f -
        c₁ * ρ * ((u₂⁻¹ : Lˣ) : L) * (1 + 2 * f) - c₁ * f * ρ) * hu₂
  let U_C : E' := U₂ - V₂
  let V_C : E' := -V₂
  let U₃ : E' := IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L) * R * U_C +
    V_C * IntermediateField.inclusion hLE' f
  let V₃ : E' := IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L) * R * V_C + U_C - V_C
  have hx_sq_K₁ : (IntermediateField.inclusion hM₁'K₁ x) ^ 2 +
      IntermediateField.inclusion hM₁'K₁ x =
      IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' f) := by
    have h := congrArg (IntermediateField.inclusion hM₁'K₁) hx_sq
    rw [map_add, map_pow, ← hinc_swap f] at h
    exact h
  have hYC_E' : Y * (IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ C) - C) =
      IntermediateField.inclusion hE'K₁ U₃ +
        IntermediateField.inclusion hE'K₁ V₃ * IntermediateField.inclusion hM₁'K₁ x := by
    rw [htrC_E', hC_E']
    change (IntermediateField.inclusion hM₁'K₁ x +
      IntermediateField.inclusion hE'K₁
        (IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L) * R)) *
      (IntermediateField.inclusion hE'K₁ ((2 : E') * U₂ - V₂) -
        (IntermediateField.inclusion hE'K₁ U₂ +
          IntermediateField.inclusion hE'K₁ V₂ * IntermediateField.inclusion hM₁'K₁ x)) =
      IntermediateField.inclusion hE'K₁ U₃ +
        IntermediateField.inclusion hE'K₁ V₃ * IntermediateField.inclusion hM₁'K₁ x
    dsimp only [U₃, V₃, U_C, V_C]
    simp only [map_sub, map_add, map_mul, map_neg, map_ofNat]
    linear_combination - IntermediateField.inclusion hE'K₁ V₂ * hx_sq_K₁
  have hConj8 :
      traceLM F hE'K₁ (Y * (IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ C) - C)) =
        IntermediateField.inclusion hLE' (c₀ - 2 * E) +
          IntermediateField.inclusion hLE'
            ((-2 * c₀ + c₁ * (1 + 4 * f) - 2) * ((u₂⁻¹ : Lˣ) : L)) * R := by
    rw [hYC_E', (hQuadAff E' K₁ hE'K₁ hdeg2_E'K₁ U₃ V₃
      (IntermediateField.inclusion hM₁'K₁ x)).1, hxK₁_tr]
    dsimp only [U₃, V₃, U_C, V_C, U₂, V₂]
    rw [hE_eq]
    simp only [map_sub, map_add, map_mul, map_pow, map_neg, map_one, map_ofNat]
    linear_combination 2 * (IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L)) ^ 2 * hR_sq
  exact ⟨hConj1, hConj2, hConj3, hConj4, hConj5, hConj6, hConj7, hConj8⟩

theorem ld_ch12_wild_dyadic_odd_max_break_aligned_generators_and_biquad_table (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_odd : condExp F L νE' % 2 = 1)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hval_normE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_normM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = 2 * valL F L x)
    (hfrob_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧ (x - s ^ 2 = 0 ∨ 1 ≤ valL F L (x - s ^ 2)))
    (ϖ_E' : E'ˣ) (ϖ_L : Lˣ)
    (hϖ_E' : valL F E' (ϖ_E' : E') = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hBasis_E' : ∀ y : E', ∃ c : Fin 2 → L,
      y = ∑ i : Fin 2, IntermediateField.inclusion hLE' (c i) * ((ϖ_E' : E') ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F E' y) ↔
