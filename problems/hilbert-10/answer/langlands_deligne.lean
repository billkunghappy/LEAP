          _ = (x + 1) + j₀ * p ^ f := by rw [hq_eq]
      obtain ⟨h_vp_u, h_ordC_u⟩ := h_step3a (x + 1) j₀ u (Nat.succ_pos x) hm_lt_pf h_lu
      have h_vp_fact_u :
          padicValNat p (γ_fn (x + 1) j₀).factorial =
            padicValNat p (x + 1) + padicValNat p (γ_fn x j₀).factorial := by
        rw [h_γ_j₀, Nat.factorial_succ,
          padicValNat.mul (ne_of_gt (Nat.succ_pos _)) (Nat.factorial_ne_zero _),
          Nat.succ_eq_add_one, ← hu_eq, h_vp_u]
      have h_vp_fact_x :
          padicValNat p (x + 1).factorial =
            padicValNat p (x + 1) + padicValNat p x.factorial := by
        rw [Nat.factorial_succ,
          padicValNat.mul (ne_of_gt (Nat.succ_pos _)) (Nat.factorial_ne_zero _)]
      have h_ordC_fact_u :
          ((ordC (γ_fn (x + 1) j₀).factorial : ℕ) : k_M) =
            (ordC u : k_M) * ((ordC (γ_fn x j₀).factorial : ℕ) : k_M) := by
        rw [h_γ_j₀, Nat.factorial_succ, h_ordC_mul, Nat.cast_mul, ← hu_eq]
      have h_ordC_fact_x :
          ((ordC (x + 1).factorial : ℕ) : k_M) =
