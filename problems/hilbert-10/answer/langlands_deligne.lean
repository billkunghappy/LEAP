    (α : Lˣ) (C : K₁ˣ)
    (htE' : traceLM F hE'K₁ (C : K₁) ≠ 0)
    (htM₁' : traceLM F hM₁'K₁ (C : K₁) ≠ 0)
    (hC_val : valL F K₁ (C : K₁) = 1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ))
    (htM₁'_val : valL F M₁' (traceLM F hM₁'K₁ (C : K₁)) =
