      calc T φ = T (∑ u₀ : G ⧸ H, LinearMap.single (Ω F) (fun _ => W) u₀ (φ u₀)) := by rw [hφ]
        _ = ∑ u₀ : G ⧸ H, T (LinearMap.single (Ω F) (fun _ => W) u₀ (φ u₀)) := map_sum T _ _
        _ = (∑ u₀ : G ⧸ H,
