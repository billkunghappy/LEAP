  have hPL_sub : ∀ {k : ℤ} {u v : L}, P_L k u → P_L k v → P_L k (u - v) := by
    intro k u v hu hv
    rw [sub_eq_add_neg]
    exact hPL_add hu (hPL_neg hv)
  have hPL_mul : ∀ {k₁ k₂ : ℤ} {u v : L}, P_L k₁ u → P_L k₂ v → P_L (k₁ + k₂) (u * v) := by
