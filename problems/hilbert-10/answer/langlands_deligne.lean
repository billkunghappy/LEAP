    have hj_S' : j ∈ S' := (Finset.mem_erase.mp hj).2
    have hj_ne0 : j ≠ 0 := (Finset.mem_erase.mp hj_S').1
    have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj_S').2
    have hj_pos : 0 < j := Nat.pos_of_ne_zero hj_ne0
    obtain ⟨hdiff_ne, hdiff_val⟩ :=
      hτ_u_diff m₀ hm₀_lt j hj_lt hm₀_pos hj_pos (Ne.symm hj_ne_m₀)
    have h_split : -x₀ + (τ_u j : K₁) =
