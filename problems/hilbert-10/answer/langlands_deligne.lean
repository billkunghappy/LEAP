      have h2 : ∀ u ∈ unitGroup F E' (condExp F E' ((νM₁' ^ j).comp (Units.map (normLM F hLE')))),
          ((νM₁' ^ j).comp (Units.map (normLM F hLE'))) u = 1 := by
        rw [hcomp_ξE' j]
        exact (hξE'_pack j hj_lt).2.1
      have h := hFML_E' (νM₁' ^ j) h1 h2
      rw [hcomp_ξE' j] at h
      exact h
    have hEq3 : (∏ j ∈ Finset.range ℓ, tateEps F E' (ξE' ^ j) ψE') *
          (∏ k ∈ Finset.range ℓ, tateEps F L (νE' ^ k) ψ) ^ ℓ =
        (tateEps F E' 1 ψE') ^ ℓ *
          (∏ j ∈ Finset.range ℓ, ∏ k ∈ Finset.range ℓ, tateEps F L (νE' ^ k * νM₁' ^ j) ψ) := by
      calc (∏ j ∈ Finset.range ℓ, tateEps F E' (ξE' ^ j) ψE') *
            (∏ k ∈ Finset.range ℓ, tateEps F L (νE' ^ k) ψ) ^ ℓ
        _ = (∏ j ∈ Finset.range ℓ, tateEps F E' (ξE' ^ j) ψE') *
              (∏ _j ∈ Finset.range ℓ, ∏ k ∈ Finset.range ℓ, tateEps F L (νE' ^ k) ψ) := by
            rw [Finset.prod_const, Finset.card_range]
        _ = ∏ j ∈ Finset.range ℓ,
              (tateEps F E' (ξE' ^ j) ψE' * (∏ k ∈ Finset.range ℓ, tateEps F L (νE' ^ k) ψ)) :=
            (Finset.prod_mul_distrib).symm
        _ = ∏ j ∈ Finset.range ℓ,
              (tateEps F E' 1 ψE' * (∏ k ∈ Finset.range ℓ, tateEps F L (νE' ^ k * νM₁' ^ j) ψ)) :=
            Finset.prod_congr rfl hEq3_term
        _ = (∏ _j ∈ Finset.range ℓ, tateEps F E' 1 ψE') *
              (∏ j ∈ Finset.range ℓ, ∏ k ∈ Finset.range ℓ, tateEps F L (νE' ^ k * νM₁' ^ j) ψ) :=
            Finset.prod_mul_distrib
        _ = (tateEps F E' 1 ψE') ^ ℓ *
              (∏ j ∈ Finset.range ℓ, ∏ k ∈ Finset.range ℓ, tateEps F L (νE' ^ k * νM₁' ^ j) ψ) := by
            rw [Finset.prod_const, Finset.card_range]
    have hEq4_term : ∀ k ∈ Finset.range ℓ,
        tateEps F M₁' (ξM₁' ^ k) ψM₁' * (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁' ^ j) ψ) =
          tateEps F M₁' 1 ψM₁' * (∏ j ∈ Finset.range ℓ, tateEps F L (νE' ^ k * νM₁' ^ j) ψ) := by
      intro k hk
      have hk_lt : k < ℓ := Finset.mem_range.mp hk
      have h1 : ∀ j < ℓ,
          ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * νE' ^ k)), (νM₁' ^ j * νE' ^ k) u = 1 :=
        fun j hj => hνM₁'_νE'_cond j hj k hk_lt
      have h2 : ∀ u ∈ unitGroup F M₁' (condExp F M₁' ((νE' ^ k).comp (Units.map (normLM F hLM₁')))),
          ((νE' ^ k).comp (Units.map (normLM F hLM₁'))) u = 1 := by
        rw [hcomp_ξM₁' k]
        exact (hξM₁'_pack k hk_lt).2.1
      have h := hFML_M₁' (νE' ^ k) h1 h2
      rw [hcomp_ξM₁' k] at h
      have hcomm : (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁' ^ j * νE' ^ k) ψ) =
          ∏ j ∈ Finset.range ℓ, tateEps F L (νE' ^ k * νM₁' ^ j) ψ :=
        Finset.prod_congr rfl fun j _ => by rw [mul_comm (νM₁' ^ j) (νE' ^ k)]
      rw [hcomm] at h
      exact h
    have hEq4 : (∏ k ∈ Finset.range ℓ, tateEps F M₁' (ξM₁' ^ k) ψM₁') *
          (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁' ^ j) ψ) ^ ℓ =
        (tateEps F M₁' 1 ψM₁') ^ ℓ *
          (∏ j ∈ Finset.range ℓ, ∏ k ∈ Finset.range ℓ, tateEps F L (νE' ^ k * νM₁' ^ j) ψ) := by
      calc (∏ k ∈ Finset.range ℓ, tateEps F M₁' (ξM₁' ^ k) ψM₁') *
            (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁' ^ j) ψ) ^ ℓ
        _ = (∏ k ∈ Finset.range ℓ, tateEps F M₁' (ξM₁' ^ k) ψM₁') *
              (∏ _k ∈ Finset.range ℓ, ∏ j ∈ Finset.range ℓ, tateEps F L (νM₁' ^ j) ψ) := by
            rw [Finset.prod_const, Finset.card_range]
        _ = ∏ k ∈ Finset.range ℓ,
              (tateEps F M₁' (ξM₁' ^ k) ψM₁' * (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁' ^ j) ψ)) :=
            (Finset.prod_mul_distrib).symm
        _ = ∏ k ∈ Finset.range ℓ,
              (tateEps F M₁' 1 ψM₁' * (∏ j ∈ Finset.range ℓ, tateEps F L (νE' ^ k * νM₁' ^ j) ψ)) :=
            Finset.prod_congr rfl hEq4_term
        _ = (∏ _k ∈ Finset.range ℓ, tateEps F M₁' 1 ψM₁') *
              (∏ k ∈ Finset.range ℓ, ∏ j ∈ Finset.range ℓ, tateEps F L (νE' ^ k * νM₁' ^ j) ψ) :=
            Finset.prod_mul_distrib
        _ = (tateEps F M₁' 1 ψM₁') ^ ℓ *
              (∏ j ∈ Finset.range ℓ, ∏ k ∈ Finset.range ℓ, tateEps F L (νE' ^ k * νM₁' ^ j) ψ) := by
            rw [Finset.prod_const, Finset.card_range, Finset.prod_comm]
    set P₂ := ∏ j ∈ Finset.range ℓ, ∏ k ∈ Finset.range ℓ, tateEps F L (νE' ^ k * νM₁' ^ j) ψ
    have hCancelK₁ : tateEps F K₁ 1 ψK₁ ≠ 0 := ld_tateEps_ne_zero F K₁ ψK₁ hψK₁ 1
    apply mul_left_cancel₀ hCancelK₁
    calc tateEps F K₁ 1 ψK₁ *
          (tateEps F E' χE'' ψE' * tateEps F M₁' 1 ψM₁' *
            (∏ k ∈ Finset.range ℓ, tateEps F L (νE' ^ k) ψ)) ^ ℓ
      _ = (tateEps F K₁ 1 ψK₁ * (tateEps F E' χE'' ψE') ^ ℓ) *
            (tateEps F M₁' 1 ψM₁') ^ ℓ *
            (∏ k ∈ Finset.range ℓ, tateEps F L (νE' ^ k) ψ) ^ ℓ := by ring
      _ = (tateEps F K₁ χK₁' ψK₁ * (∏ j ∈ Finset.range ℓ, tateEps F E' (ξE' ^ j) ψE')) *
            (tateEps F M₁' 1 ψM₁') ^ ℓ *
            (∏ k ∈ Finset.range ℓ, tateEps F L (νE' ^ k) ψ) ^ ℓ := by rw [← hEq1]
      _ = tateEps F K₁ χK₁' ψK₁ *
            ((∏ j ∈ Finset.range ℓ, tateEps F E' (ξE' ^ j) ψE') *
              (∏ k ∈ Finset.range ℓ, tateEps F L (νE' ^ k) ψ) ^ ℓ) *
            (tateEps F M₁' 1 ψM₁') ^ ℓ := by ring
      _ = tateEps F K₁ χK₁' ψK₁ * ((tateEps F E' 1 ψE') ^ ℓ * P₂) *
            (tateEps F M₁' 1 ψM₁') ^ ℓ := by rw [hEq3]
      _ = tateEps F K₁ χK₁' ψK₁ * (tateEps F E' 1 ψE') ^ ℓ *
            ((tateEps F M₁' 1 ψM₁') ^ ℓ * P₂) := by ring
      _ = tateEps F K₁ χK₁' ψK₁ * (tateEps F E' 1 ψE') ^ ℓ *
            ((∏ k ∈ Finset.range ℓ, tateEps F M₁' (ξM₁' ^ k) ψM₁') *
              (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁' ^ j) ψ) ^ ℓ) := by rw [← hEq4]
      _ = (tateEps F K₁ χK₁' ψK₁ * (∏ k ∈ Finset.range ℓ, tateEps F M₁' (ξM₁' ^ k) ψM₁')) *
            (tateEps F E' 1 ψE') ^ ℓ *
            (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁' ^ j) ψ) ^ ℓ := by ring
      _ = (tateEps F K₁ 1 ψK₁ * (tateEps F M₁' χM₁'' ψM₁') ^ ℓ) *
            (tateEps F E' 1 ψE') ^ ℓ *
            (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁' ^ j) ψ) ^ ℓ := by rw [hEq2]
      _ = tateEps F K₁ 1 ψK₁ *
          (tateEps F M₁' χM₁'' ψM₁' * tateEps F E' 1 ψE' *
            (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁' ^ j) ψ)) ^ ℓ := by ring
  have hEpsProd2 : ∀ (ν : Lˣ →* (Ω F)ˣ),
      (∏ j ∈ Finset.range ℓ, tateEps F L (ν ^ j) ψ) =
        tateEps F L 1 ψ * tateEps F L ν ψ := by
    intro ν
    rw [hℓ2, Finset.prod_range_succ, Finset.prod_range_one, pow_zero, pow_one]
  have hPow' :
      (tateEps F E' χE'' ψE' * tateEps F M₁' 1 ψM₁' * tateEps F L νE' ψ) ^ 2 =
        (tateEps F M₁' χM₁'' ψM₁' * tateEps F E' 1 ψE' * tateEps F L νM₁' ψ) ^ 2 := by
    have h1 := hPow
    rw [hEpsProd2 νE', hEpsProd2 νM₁', hℓ2] at h1
    have hCancel : (tateEps F L 1 ψ) ^ 2 ≠ 0 :=
      pow_ne_zero 2 (ld_tateEps_ne_zero F L ψ hψ 1)
    apply mul_right_cancel₀ hCancel
    calc (tateEps F E' χE'' ψE' * tateEps F M₁' 1 ψM₁' * tateEps F L νE' ψ) ^ 2 *
          (tateEps F L 1 ψ) ^ 2
      _ = (tateEps F E' χE'' ψE' * tateEps F M₁' 1 ψM₁' *
            (tateEps F L 1 ψ * tateEps F L νE' ψ)) ^ 2 := by ring
      _ = (tateEps F M₁' χM₁'' ψM₁' * tateEps F E' 1 ψE' *
            (tateEps F L 1 ψ * tateEps F L νM₁' ψ)) ^ 2 := h1
      _ = (tateEps F M₁' χM₁'' ψM₁' * tateEps F E' 1 ψE' * tateEps F L νM₁' ψ) ^ 2 *
          (tateEps F L 1 ψ) ^ 2 := by ring
  exact ⟨hνM₁'E'_cond, hνE'M₁'_cond, hbE'_ge2, hMinM₁', hMinE',
    hNormFact, hχE'_comp, hχM₁'_comp, hχK₁'_cond, hm_bounds.1, hξE'_pack,
    hm_bounds.2, hξM₁'_pack, hCommonRest, hPow'⟩

theorem ld_ch12_wild_dyadic_min_cond_subfield_and_bicyclic_reduction (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E M₁ K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E]
    [FiniteDimensional F M₁] [FiniteDimensional F K₁]
    (hLE : L ≤ E) (hLM₁ : L ≤ M₁) (hEK₁ : E ≤ K₁) (hM₁K₁ : M₁ ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE : IsGaloisExt F L E) (hGalLM₁ : IsGaloisExt F L M₁)
    (hGalEK₁ : IsGaloisExt F E K₁) (hGalM₁K₁ : IsGaloisExt F M₁ K₁)
    (hAbLE : IsAbelianExt F hLE) (hAbLM₁ : IsAbelianExt F hLM₁)
    (hAbEK₁ : IsAbelianExt F hEK₁) (hAbM₁K₁ : IsAbelianExt F hM₁K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE)))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE) = p F)
    (hp2 : p F = 2)
    (hdegM₁ : Module.finrank L (IntermediateField.extendScalars hLM₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (hdegEK₁ : Module.finrank E (IntermediateField.extendScalars hEK₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (hdegM₁K₁ : Module.finrank M₁ (IntermediateField.extendScalars hM₁K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (h_inf : E ⊓ M₁ = L) (h_sup : E ⊔ M₁ = K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁)
    (hneK₁ : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE.trans hEK₁) χL = χK₁)
    (χE : relWeil F E →* (Ω F)ˣ) (hχE_weil : IsWeilRep F E (charRep F E χE))
    (hχE_rest : restrictWeilChar F hEK₁ χE = χK₁)
    (χM₁ : relWeil F M₁ →* (Ω F)ˣ) (hχM₁_weil : IsWeilRep F M₁ (charRep F M₁ χM₁))
    (hχM₁_rest : restrictWeilChar F hM₁K₁ χM₁ = χK₁)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (hψM₁ : IsAdmissibleChar F M₁ (traceChar F hLM₁ ψ))
    (hψK₁ : IsAdmissibleChar F K₁ (traceChar F (hLE.trans hEK₁) ψ))
    (νE νM₁ : Lˣ →* (Ω F)ˣ)
    (hνE_pow : νE ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1)
    (hνE_ne : νE ≠ 1)
    (hνE_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE)) ↔ νE x = 1)
    (hνE_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
      ∀ u ∈ unitGroup F L (condExp F L (νE ^ j)), (νE ^ j) u = 1)
    (hνM₁_pow : νM₁ ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1)
    (hνM₁_ne : νM₁ ≠ 1)
    (hνM₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁)) ↔ νM₁ x = 1)
    (hνM₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁ ^ j)), (νM₁ ^ j) u = 1)
    (hPow :
      let ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
      let ψE := traceChar F hLE ψ
      let ψM₁ := traceChar F hLM₁ ψ
      let χE' := recChar F rec E χE
      let χM₁' := recChar F rec M₁ χM₁
      (tateEps F E χE' ψE * tateEps F M₁ 1 ψM₁ *
          (∏ j ∈ Finset.range ℓ, tateEps F L (νE ^ j) ψ)) ^ ℓ =
        (tateEps F M₁ χM₁' ψM₁ * tateEps F E 1 ψE *
          (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ)) ^ ℓ)
    (hReduced :
      ∀ (E' M₁' : IntermediateField F (AlgebraicClosure F))
        [FiniteDimensional F E'] [FiniteDimensional F M₁']
        (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁),
        IsGaloisExt F L E' → IsGaloisExt F L M₁' →
        IsGaloisExt F E' K₁ → IsGaloisExt F M₁' K₁ →
        IsAbelianExt F hLE' → IsAbelianExt F hLM₁' →
        IsAbelianExt F hE'K₁ → IsAbelianExt F hM₁'K₁ →
        Module.finrank L (IntermediateField.extendScalars hLE') =
          Module.finrank L (IntermediateField.extendScalars hLE) →
        Module.finrank L (IntermediateField.extendScalars hLM₁') =
          Module.finrank L (IntermediateField.extendScalars hLE) →
        Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
          Module.finrank L (IntermediateField.extendScalars hLE) →
        Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
          Module.finrank L (IntermediateField.extendScalars hLE) →
        E' ⊓ M₁' = L → E' ⊔ M₁' = K₁ →
        ∀ (χE' : relWeil F E' →* (Ω F)ˣ), IsWeilRep F E' (charRep F E' χE') →
          restrictWeilChar F hE'K₁ χE' = χK₁ →
        ∀ (χM₁' : relWeil F M₁' →* (Ω F)ˣ), IsWeilRep F M₁' (charRep F M₁' χM₁') →
          restrictWeilChar F hM₁'K₁ χM₁' = χK₁ →
        IsAdmissibleChar F E' (traceChar F hLE' ψ) →
        IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ) →
        ∀ (νE' νM₁' : Lˣ →* (Ω F)ˣ),
          νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1 →
          νE' ≠ 1 →
          (∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1) →
          (∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
            ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1) →
          νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1 →
          νM₁' ≠ 1 →
          (∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1) →
          (∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
            ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1) →
          (∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
            ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * νE')), (νM₁' ^ j * νE') u = 1) →
          (∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
            ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j * νM₁')), (νE' ^ j * νM₁') u = 1) →
          2 ≤ condExp F L νE' →
          (condExp F L νM₁' = 0 ∨ 2 ≤ condExp F L νM₁') →
          (∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
            condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE') ∧
            condExp F L (νM₁' ^ j * νE') = condExp F L νE') →
          (∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
            condExp F L νM₁' ≤ condExp F L (νE' ^ j * νM₁') ∧
            (0 < j → condExp F L (νE' ^ j * νM₁') = condExp F L νE')) →
          (∀ x : Lˣ, ∃ (y : E'ˣ) (z : M₁'ˣ),
            x = Units.map (normLM F hLE') y * Units.map (normLM F hLM₁') z) →
          (recChar F rec E' χE').comp (Units.map (normLM F hE'K₁)) = recChar F rec K₁ χK₁ →
          (recChar F rec M₁' χM₁').comp (Units.map (normLM F hM₁'K₁)) = recChar F rec K₁ χK₁ →
          (∀ u ∈ unitGroup F K₁ (condExp F K₁ (recChar F rec K₁ χK₁)),
            (recChar F rec K₁ χK₁) u = 1) →
          2 ≤ condExp F E' (recChar F rec E' χE') →
          (∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
            let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
            (∀ y : E'ˣ, y ∈ Set.range (Units.map (normLM F hE'K₁)) ↔ ξE' y = 1) ∧
            (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j)), (ξE' ^ j) u = 1) ∧
            (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j * recChar F rec E' χE')),
              (ξE' ^ j * recChar F rec E' χE') u = 1) ∧
            condExp F E' (ξE' ^ j * recChar F rec E' χE') =
              condExp F E' (recChar F rec E' χE') ∧
            tateEps F E' (ξE' ^ j * recChar F rec E' χE') (traceChar F hLE' ψ) =
              tateEps F E' (recChar F rec E' χE') (traceChar F hLE' ψ)) →
          2 ≤ condExp F M₁' (recChar F rec M₁' χM₁') →
          (∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
            let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
            (∀ z : M₁'ˣ, z ∈ Set.range (Units.map (normLM F hM₁'K₁)) ↔ ξM₁' z = 1) ∧
            (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j)), (ξM₁' ^ j) u = 1) ∧
            (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j * recChar F rec M₁' χM₁')),
              (ξM₁' ^ j * recChar F rec M₁' χM₁') u = 1) ∧
            condExp F M₁' (ξM₁' ^ j * recChar F rec M₁' χM₁') =
              condExp F M₁' (recChar F rec M₁' χM₁') ∧
            tateEps F M₁' (ξM₁' ^ j * recChar F rec M₁' χM₁') (traceChar F hLM₁' ψ) =
              tateEps F M₁' (recChar F rec M₁' χM₁') (traceChar F hLM₁' ψ)) →
          (∀ x : Lˣ,
