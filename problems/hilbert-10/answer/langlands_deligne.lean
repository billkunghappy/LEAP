theorem ld_ch12_wild_odd_unramified_stable_range_stat_match (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (hψK₁ : IsAdmissibleChar F K₁ (traceChar F (hLE'.trans hE'K₁) ψ))
    (T : ℕ) (hT_ge2 : 2 ≤ T)
    (θE' : E'ˣ →* (Ω F)ˣ) (θM₁' : M₁'ˣ →* (Ω F)ˣ) (θK₁ : K₁ˣ →* (Ω F)ˣ)
    (ξM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hχE'_comp : θE'.comp (Units.map (normLM F hE'K₁)) = θK₁)
    (hχM₁'_comp : θM₁'.comp (Units.map (normLM F hM₁'K₁)) = θK₁)
    (hCommonRest : ∀ x : Lˣ,
      θE' (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) =
      θM₁' (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x))
    (hξM₁'_cond_eq : condExp F M₁' ξM₁' = T)
    (hξM₁'_triv : ∀ u ∈ unitGroup F M₁' (condExp F M₁' ξM₁'), ξM₁' u = 1)
    (hθE'_triv : ∀ u ∈ unitGroup F E' (condExp F E' θE'), θE' u = 1)
    (hθM₁'_triv : ∀ u ∈ unitGroup F M₁' (condExp F M₁' θM₁'), θM₁' u = 1)
    (hStable : 2 * T ≤ condExp F M₁' θM₁')
    (hmE'_eq : condExp F E' θE' =
      T + Module.finrank L (IntermediateField.extendScalars hLE') * (condExp F M₁' θM₁' - T))
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) = condExpChar F L ψ)
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) * (T : ℤ))
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁,
      valL F E' (normLM F hE'K₁ w) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F K₁ w)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_bound_LM₁' : ∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (htr_bound_E'K₁ : ∀ (m : ℤ) (w : K₁), (w = 0 ∨ m ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (hnorm_lin_E'K₁ : ∀ (d : ℕ), 1 ≤ d → ∀ w : K₁, (w = 0 ∨ (d : ℤ) ≤ valL F K₁ w) →
      (normLM F hE'K₁ (1 + w) - (1 + traceLM F hE'K₁ w) = 0 ∨
        (2 * d : ℤ) ≤ valL F E' (normLM F hE'K₁ (1 + w) - (1 + traceLM F hE'K₁ w))))
    (hDiamond_E' : ∀ y : E',
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y))
    (hDiamond_M₁' : ∀ z : M₁',
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z))
    (y₁ : M₁') (hy₁_int : y₁ = 0 ∨ 0 ≤ valL F M₁' y₁) (hy₁_tr : traceLM F hLM₁' y₁ = 1)
    (w₁ : K₁) (hw₁_int : w₁ = 0 ∨ 0 ≤ valL F K₁ w₁) (hw₁_tr : traceLM F hE'K₁ w₁ = 1)
    (σ₀ : M₁' ≃ₐ[F] M₁') (j₀ : ℕ)
    (hσ₀_val : ∀ z : M₁', valL F M₁' (σ₀ z) = valL F M₁' z)
    (hσ₀_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) =
      ∑ k ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLE')), (σ₀ ^ k) z)
    (hFrobTwist : ∀ (r : ℕ) (z : M₁'ˣ),
      θM₁' (Units.map (σ₀ ^ r).toRingEquiv.toMonoidHom z) = (ξM₁' z) ^ (r * j₀) * θM₁' z)
    (hq_norm_tr_K₁ : ∀ (h : ℕ) (w : K₁),
      (w = 0 ∨
        (((T + Module.finrank L (IntermediateField.extendScalars hLE') * h) / 2 : ℕ) : ℤ) ≤
          valL F K₁ w) →
      let u := normLM F hM₁'K₁ (1 + w) - 1
      let q_w := (2 : K₁)⁻¹ * (2 * w - w ^ 2)
      (2 * u - u ^ 2) - (traceLM F hM₁'K₁ (2 * w - w ^ 2) + 2 * normLM F hM₁'K₁ q_w) = 0 ∨
        ((T + h : ℕ) : ℤ) ≤
          valL F M₁' ((2 * u - u ^ 2) -
            (traceLM F hM₁'K₁ (2 * w - w ^ 2) + 2 * normLM F hM₁'K₁ q_w)))
    (c_U : M₁'ˣ)
    (hc_U_val : valL F M₁' (c_U : M₁') =
      (condExp F M₁' θM₁' : ℤ) + condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hc_U_stat : ∀ z : M₁',
      (z = 0 ∨ ((condExp F M₁' θM₁' / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) ^ 2 =
          (traceChar F hLM₁' ψ) (((c_U⁻¹ : M₁'ˣ) : M₁') * (2 * z - z ^ 2)))
    (c_E : E'ˣ)
    (hc_E_val : valL F E' (c_E : E') =
      (condExp F E' θE' : ℤ) + condExpChar F E' (traceChar F hLE' ψ))
    (hc_E_stat : ∀ x : E',
      (x = 0 ∨ ((condExp F E' θE' / 2 : ℕ) : ℤ) ≤ valL F E' x) →
      ∀ hx : 1 + x ≠ 0,
        (θE' (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
          (traceChar F hLE' ψ) (((c_E⁻¹ : E'ˣ) : E') * (2 * x - x ^ 2))) :
    let mM₁' := condExp F M₁' θM₁'
    let mE' := condExp F E' θE'
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    ∃ (cE' : E'ˣ) (cM₁' : M₁'ˣ),
      valL F E' (cE' : E') = (mE' : ℤ) + condExpChar F E' ψE' ∧
      (∀ x : E', (x = 0 ∨ ((mE' / 2 : ℕ) : ℤ) ≤ valL F E' x) →
        ∀ hx : 1 + x ≠ 0,
          (θE' (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
            ψE' (((cE'⁻¹ : E'ˣ) : E') * (1 + (0 : E')) * (2 * x - x ^ 2))) ∧
      valL F M₁' (cM₁' : M₁') = (mM₁' : ℤ) + condExpChar F M₁' ψM₁' ∧
      (∀ z : M₁', (z = 0 ∨ ((mM₁' / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
        ∀ hz : 1 + z ≠ 0,
          (θM₁' (Units.mk0 (1 + z) hz) : Ω F) ^ 2 =
            ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (1 + (0 : M₁')) * (2 * z - z ^ 2))) ∧
      (θE' cE' : Ω F) ^ 4 * (ψE' (((cE'⁻¹ : E'ˣ) : E') * (2 - (0 : E') ^ 2))) ^ 2 =
        (θM₁' cM₁' : Ω F) ^ 4 * (ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (2 - (0 : M₁') ^ 2))) ^ 2 :=
by
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  set mM₁' := condExp F M₁' θM₁'
  set mE' := condExp F E' θE'
  set ψE' := traceChar F hLE' ψ
  set ψM₁' := traceChar F hLM₁' ψ
  obtain ⟨htr_LM₁'_incl, c_L, hc_L_val, hcM₁'_val, hcM₁'_stat⟩ :=
    ld_stable_range_unramified_frob_descent_to_base F L M₁' hLM₁'
      p hPrime hWild hp_odd ψ hψ hψM₁' T hT_ge2 θM₁' ξM₁'
      hξM₁'_cond_eq hξM₁'_triv hStable hnM₁'_eq hval_LM₁' htr_bound_LM₁'
      y₁ hy₁_int hy₁_tr σ₀ j₀ hσ₀_val hσ₀_tr hFrobTwist c_U hc_U_val hc_U_stat
  obtain ⟨htower_tr, hψE'_cong, hψM₁'_cong, hwild_pullback⟩ :=
    ld_wild_norm_quad_pullback_and_tower_trace F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ p rfl hPrime hp_odd ψ hψE' hψM₁'
      T mM₁' mE' hT_ge2 hStable hmE'_eq hnM₁'_eq hnE'_eq
      hval_M₁'K₁ hval_norm_M₁'K₁ htr_bound_E'K₁ hq_norm_tr_K₁
  let cE' : E'ˣ := Units.map (IntermediateField.inclusion hLE').toMonoidHom c_L
  let cM₁' : M₁'ˣ := Units.map (IntermediateField.inclusion hLM₁').toMonoidHom c_L
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge1 : 1 ≤ p := hPrime.one_le
  have hT_le : T ≤ mM₁' := by omega
  have hcE'_val : valL F E' (cE' : E') = (mE' : ℤ) + condExpChar F E' ψE' := by
    have h1 : valL F E' (cE' : E') = (p : ℤ) * valL F L (c_L : L) := hval_LE' (c_L : L)
    rw [h1, hc_L_val]
    have hmE'_eq' : (mE' : ℤ) = (T : ℤ) + (p : ℤ) * ((mM₁' : ℤ) - (T : ℤ)) := by
      have h2 : mE' = T + p * (mM₁' - T) := hmE'_eq
      rw [h2, Nat.cast_add, Nat.cast_mul, Nat.cast_sub hT_le]
    have hnE'_eq' : condExpChar F E' ψE' =
        (p : ℤ) * condExpChar F L ψ + ((p : ℤ) - 1) * (T : ℤ) := by
      have h3 : condExpChar F E' ψE' =
          (p : ℤ) * condExpChar F L ψ + ((p - 1 : ℕ) : ℤ) * (T : ℤ) := hnE'_eq
      rw [h3, Nat.cast_sub hp_ge1, Nat.cast_one]
    rw [hmE'_eq', hnE'_eq']
    ring
  have hpm_ge : 2 * (mM₁' - T) ≤ p * (mM₁' - T) := Nat.mul_le_mul_right (mM₁' - T) hp_ge2
  have hmE'_ge6 : 6 ≤ mE' := by
    have hmE'_eq' : mE' = T + p * (mM₁' - T) := hmE'_eq
    omega
  have hdE_ge1 : 1 ≤ mE' / 2 := by omega
  have hmE'_le_3dE : (mE' : ℤ) ≤ (3 * (mE' / 2) : ℤ) := by omega
  refine ⟨cE', cM₁', hcE'_val, ?_, hcM₁'_val, ?_, ?_⟩
  · intro x hx_val hx
    rw [add_zero, mul_one]
    obtain ⟨y, hy_val, hy, hu_E_val, hu_E, hu_E_quad, hy_tr_quad⟩ :=
      ld_unramified_norm_quad_log_congruence F E' K₁ hE'K₁ p hPrime hWild hp_odd
        hval_E'K₁ hval_norm_E'K₁ htr_bound_E'K₁ hnorm_lin_E'K₁ w₁ hw₁_int hw₁_tr
        (mE' / 2) hdE_ge1 x hx_val
    set u_E := normLM F hE'K₁ (1 + y) - 1
    obtain ⟨hu_M_val, hu_M, hu_M_quad⟩ := hwild_pullback y hy_val
    set u_M := normLM F hM₁'K₁ (1 + y) - 1
    have hu_E_quad' : (2 * u_E - u_E ^ 2) - (2 * x - x ^ 2) = 0 ∨
        (mE' : ℤ) ≤ valL F E' ((2 * u_E - u_E ^ 2) - (2 * x - x ^ 2)) :=
      hu_E_quad.imp id (fun h => le_trans hmE'_le_3dE h)
    have hy_tr_quad' : traceLM F hE'K₁ (2 * y - y ^ 2) - (2 * x - x ^ 2) = 0 ∨
        (mE' : ℤ) ≤ valL F E' (traceLM F hE'K₁ (2 * y - y ^ 2) - (2 * x - x ^ 2)) :=
      hy_tr_quad.imp id (fun h => le_trans hmE'_le_3dE h)
    have hstep1 : (θE' (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
        ψE' (((c_E⁻¹ : E'ˣ) : E') * (2 * x - x ^ 2)) :=
      hc_E_stat x hx_val hx
    have hstep2 : ψE' (((c_E⁻¹ : E'ˣ) : E') * (2 * x - x ^ 2)) =
        ψE' (((c_E⁻¹ : E'ˣ) : E') * (2 * u_E - u_E ^ 2)) :=
      (hψE'_cong c_E (2 * u_E - u_E ^ 2) (2 * x - x ^ 2) hc_E_val hu_E_quad').symm
    have hstep3 : ψE' (((c_E⁻¹ : E'ˣ) : E') * (2 * u_E - u_E ^ 2)) =
        (θE' (Units.mk0 (1 + u_E) hu_E) : Ω F) ^ 2 :=
      (hc_E_stat u_E hu_E_val hu_E).symm
    have hunit_E : Units.mk0 (1 + u_E) hu_E =
        Units.map (normLM F hE'K₁) (Units.mk0 (1 + y) hy) := by
      apply Units.ext
      change 1 + (normLM F hE'K₁ (1 + y) - 1) = normLM F hE'K₁ (1 + y)
      ring
    have hunit_M : Units.mk0 (1 + u_M) hu_M =
        Units.map (normLM F hM₁'K₁) (Units.mk0 (1 + y) hy) := by
      apply Units.ext
      change 1 + (normLM F hM₁'K₁ (1 + y) - 1) = normLM F hM₁'K₁ (1 + y)
      ring
    have hθ_norm_E : θE' (Units.mk0 (1 + u_E) hu_E) = θK₁ (Units.mk0 (1 + y) hy) := by
      rw [hunit_E]
      exact DFunLike.congr_fun hχE'_comp (Units.mk0 (1 + y) hy)
    have hθ_norm_M : θM₁' (Units.mk0 (1 + u_M) hu_M) = θK₁ (Units.mk0 (1 + y) hy) := by
      rw [hunit_M]
      exact DFunLike.congr_fun hχM₁'_comp (Units.mk0 (1 + y) hy)
    have hstep4 : (θE' (Units.mk0 (1 + u_E) hu_E) : Ω F) ^ 2 =
        (θM₁' (Units.mk0 (1 + u_M) hu_M) : Ω F) ^ 2 := by
      rw [hθ_norm_E, hθ_norm_M]
    have hstep5 : (θM₁' (Units.mk0 (1 + u_M) hu_M) : Ω F) ^ 2 =
        ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (2 * u_M - u_M ^ 2)) :=
      hcM₁'_stat u_M hu_M_val hu_M
    have hstep6 : ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (2 * u_M - u_M ^ 2)) =
        ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * traceLM F hM₁'K₁ (2 * y - y ^ 2)) :=
      hψM₁'_cong cM₁' (2 * u_M - u_M ^ 2) (traceLM F hM₁'K₁ (2 * y - y ^ 2)) hcM₁'_val hu_M_quad
    have hstep7 : ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * traceLM F hM₁'K₁ (2 * y - y ^ 2)) =
        ψE' (((cE'⁻¹ : E'ˣ) : E') * traceLM F hE'K₁ (2 * y - y ^ 2)) := by
      have hcM_inv : ((cM₁'⁻¹ : M₁'ˣ) : M₁') =
          IntermediateField.inclusion hLM₁' ((c_L⁻¹ : Lˣ) : L) := by
        rw [← map_inv (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom) c_L]
        rfl
      have hcE_inv : ((cE'⁻¹ : E'ˣ) : E') =
          IntermediateField.inclusion hLE' ((c_L⁻¹ : Lˣ) : L) := by
        rw [← map_inv (Units.map (IntermediateField.inclusion hLE').toMonoidHom) c_L]
        rfl
      rw [hcM_inv, hcE_inv]
      exact htower_tr ((c_L⁻¹ : Lˣ) : L) (2 * y - y ^ 2)
    have hstep8 : ψE' (((cE'⁻¹ : E'ˣ) : E') * traceLM F hE'K₁ (2 * y - y ^ 2)) =
        ψE' (((cE'⁻¹ : E'ˣ) : E') * (2 * x - x ^ 2)) :=
      hψE'_cong cE' (traceLM F hE'K₁ (2 * y - y ^ 2)) (2 * x - x ^ 2) hcE'_val hy_tr_quad'
    rw [hstep1, hstep2, hstep3, hstep4, hstep5, hstep6, hstep7, hstep8]
  · intro z hz_val hz
    rw [add_zero, mul_one]
    exact hcM₁'_stat z hz_val hz
  · have hθ_eq : θE' cE' = θM₁' cM₁' := hCommonRest c_L
    have hψ_eq : ψE' (((cE'⁻¹ : E'ˣ) : E') * (2 - (0 : E') ^ 2)) =
        ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (2 - (0 : M₁') ^ 2)) := by
      set a : L := ((c_L⁻¹ : Lˣ) : L) * 2
      have hargE' : ((cE'⁻¹ : E'ˣ) : E') * (2 - (0 : E') ^ 2) =
          IntermediateField.inclusion hLE' a := by
        have hcE_inv : ((cE'⁻¹ : E'ˣ) : E') =
            IntermediateField.inclusion hLE' ((c_L⁻¹ : Lˣ) : L) := by
          rw [← map_inv (Units.map (IntermediateField.inclusion hLE').toMonoidHom) c_L]
          rfl
        rw [hcE_inv]
        change IntermediateField.inclusion hLE' ((c_L⁻¹ : Lˣ) : L) * (2 - (0 : E') ^ 2) =
          IntermediateField.inclusion hLE' (((c_L⁻¹ : Lˣ) : L) * 2)
        rw [map_mul, map_ofNat]
        ring
      have hargM₁' : ((cM₁'⁻¹ : M₁'ˣ) : M₁') * (2 - (0 : M₁') ^ 2) =
          IntermediateField.inclusion hLM₁' a := by
        have hcM_inv : ((cM₁'⁻¹ : M₁'ˣ) : M₁') =
            IntermediateField.inclusion hLM₁' ((c_L⁻¹ : Lˣ) : L) := by
          rw [← map_inv (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom) c_L]
          rfl
        rw [hcM_inv]
        change IntermediateField.inclusion hLM₁' ((c_L⁻¹ : Lˣ) : L) * (2 - (0 : M₁') ^ 2) =
          IntermediateField.inclusion hLM₁' (((c_L⁻¹ : Lˣ) : L) * 2)
        rw [map_mul, map_ofNat]
        ring
      rw [hargE', hargM₁']
      change ψ (traceLM F hLE' (IntermediateField.inclusion hLE' a)) =
        ψ (traceLM F hLM₁' (IntermediateField.inclusion hLM₁' a))
      have htr_LE' : traceLM F hLE' (IntermediateField.inclusion hLE' a) = (p : L) * a := by
        have h1 : toExtendScalars F hLE' (IntermediateField.inclusion hLE' a) =
            algebraMap L (IntermediateField.extendScalars hLE') a := rfl
        change Algebra.trace L (IntermediateField.extendScalars hLE')
          (toExtendScalars F hLE' (IntermediateField.inclusion hLE' a)) = (p : L) * a
        rw [h1, Algebra.trace_algebraMap, nsmul_eq_mul]
      rw [htr_LE', htr_LM₁'_incl a]
    rw [hθ_eq, hψ_eq]

theorem ld_wild_odd_unramified_as_iterate_and_frob_shift (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M₁']
    (hLM₁' : L ≤ M₁')
    (p : ℕ) (hPrime : Nat.Prime p)
    (T : ℕ) (hT_ge2 : 2 ≤ T)
    (hp_val : (p : L) = 0 ∨ ((T - T / 2 : ℕ) : ℤ) ≤ valL F L (p : L))
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (htr_bound_LM₁' : ∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (y₁ : M₁') (hy₁_int : y₁ = 0 ∨ 0 ≤ valL F M₁' y₁) (hy₁_tr : traceLM F hLM₁' y₁ = 1)
    (σ₀ : M₁' ≃ₐ[F] M₁')
    (hσ₀_L : ∀ x : L,
      σ₀ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hσ₀_val : ∀ z : M₁', valL F M₁' (σ₀ z) = valL F M₁' z)
    (hσ₀_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) =
      ∑ k ∈ Finset.range p, (σ₀ ^ k) z) :
    (∀ z : M₁', (σ₀ ^ p) z = z) ∧
    ∃ (c : L) (d : M₁'),
      (c = 0 ∨ 0 ≤ valL F L c) ∧
      valL F M₁' d = 0 ∧
      (d ^ p - d - IntermediateField.inclusion hLM₁' c = 0 ∨
        (2 * (T : ℤ) + 1) ≤ valL F M₁' (d ^ p - d - IntermediateField.inclusion hLM₁' c)) ∧
      (σ₀ d - d - 1 = 0 ∨
        ((T - T / 2 : ℕ) : ℤ) ≤ valL F M₁' (σ₀ d - d - 1)) ∧
      (σ₀ (d ^ p) - d ^ p - 1 = 0 ∨
        ((T - T / 2 : ℕ) : ℤ) ≤ valL F M₁' (σ₀ (d ^ p) - d ^ p - 1)) ∧
      (∀ j k : ℕ, j < k → k < p →
        (σ₀ ^ k) d - (σ₀ ^ j) d ≠ 0 ∧
        valL F M₁' ((σ₀ ^ k) d - (σ₀ ^ j) d) = 0) :=
by
  have hval_props : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
      (∀ z : M, valL F M (-z) = valL F M z) ∧
      (∀ y z : M, y ≠ 0 → z ≠ 0 → valL F M (y * z) = valL F M y + valL F M z) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ (k : ℤ) (y z : M),
        (y = 0 ∨ k ≤ valL F M y) → (z = 0 ∨ k ≤ valL F M z) →
          (y + z = 0 ∨ k ≤ valL F M (y + z))) := by
    intro M _
    have halg_gen : ∀ (F₀ : Type u) [Field F₀]
        (M₀ : IntermediateField F₀ (AlgebraicClosure F₀)) [FiniteDimensional F₀ M₀] (z : M₀),
        minpoly F₀ (z : AlgebraicClosure F₀) = minpoly F₀ z ∧
        ∃ m : ℕ,
          Algebra.norm F₀ z = ((-1) ^ (minpoly F₀ z).natDegree * (minpoly F₀ z).coeff 0) ^ m ∧
          Module.finrank F₀ M₀ = (minpoly F₀ z).natDegree * m := by
      intro F₀ _ M₀ _ z
      have hmin_coe : minpoly F₀ (z : AlgebraicClosure F₀) = minpoly F₀ z :=
        minpoly.algHom_eq M₀.val M₀.val.injective z
      have hz : IsIntegral F₀ z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F₀ z :=
        IntermediateField.adjoin.powerBasis_gen hz
      have hmin_gen : minpoly F₀ pb.gen = minpoly F₀ z := by
        have hval : (IntermediateField.adjoin F₀ {z}).val pb.gen = z := by
          rw [hpb_gen]
          rfl
        rw [← minpoly.algHom_eq (IntermediateField.adjoin F₀ {z}).val
          (IntermediateField.adjoin F₀ {z}).val.injective pb.gen, hval]
      have hpb_dim : pb.dim = (minpoly F₀ z).natDegree := by
        rw [IntermediateField.adjoin.powerBasis_dim hz]
      have hnorm_adj := Algebra.norm_eq_norm_adjoin F₀ z
      rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
      refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
      rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
    have halg : ∀ z : M,
        minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
        ∃ m : ℕ,
          Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
          Module.finrank F M = (minpoly F z).natDegree * m :=
      halg_gen F M
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
        b ≠ 0 ∧ addVal F b ≤ addVal F a := by
      intro a b ha hab
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
      have hφb : φ (valuation F b) ≠ 0 := by
        intro h0
        rw [h0] at hφ_le
        exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
      have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
      have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
      refine ⟨hb, ?_⟩
      rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
      unfold addVal
      rw [dif_neg ha, dif_neg hb]
      exact neg_le_neg hφ_le
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
