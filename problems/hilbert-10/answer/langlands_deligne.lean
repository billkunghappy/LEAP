      rw [ha0_eq]
      exact hPMC_sub 1 (hPMC_mul0 1 hc0_tr hb0_MC_int) htr_wrem_scaled
    · 
      intro z
      rfl
    · 
      have hPMC_binom : ∀ {a b : M_C}, P_MC 0 a → P_MC 0 b →
          P_MC 1 ((a + b) ^ (p F) - (a ^ (p F) + b ^ (p F))) := by
        intro a b ha hb
        have hp_ge2 : 2 ≤ p F := hp_prime.two_le
        have hp_eq : p F + 1 = (p F - 1) + 1 + 1 := by omega
        have hp1 : (p F - 1) + 1 = p F := by omega
        have h_expand : (a + b) ^ (p F) - (a ^ (p F) + b ^ (p F)) =
            ∑ j ∈ Finset.range (p F - 1),
              a ^ (j + 1) * b ^ (p F - (j + 1)) * ((p F).choose (j + 1) : M_C) := by
          rw [add_pow a b (p F), hp_eq, Finset.sum_range_succ, Finset.sum_range_succ']
