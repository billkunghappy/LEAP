  have hleM₁' : condExp F M₁' ξM₁' ≤ condExp F M₁' θM₁' := hM₁'K₁_pair.1
  have hK₁_M₁' : condExp F K₁ θK₁ =
      condExp F M₁' ξM₁' + ℓ * (condExp F M₁' θM₁' - condExp F M₁' ξM₁') := hM₁'K₁_pair.2
  have hCondRel : condExp F E' θE' + (ℓ - 1) * bE' = condExp F M₁' θM₁' + (ℓ - 1) * bM₁' := by
