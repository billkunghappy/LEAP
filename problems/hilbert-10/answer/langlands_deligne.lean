  have hψ_vanish : ∀ y : L, (y = 0 ∨ - condExpChar F L ψ ≤ valL F L y) → ψ y = 1 := by
    let S_ψ : Set ℤ := {d : ℤ | ∀ x : L, -d ≤ valL F L x → ψ x = 1}
