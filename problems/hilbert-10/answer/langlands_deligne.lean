    let q := Module.finrank M (IntermediateField.extendScalars hMK)
    (∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M, (z = 0 ∨ 0 ≤ valL F M z) ∧
        (w - IntermediateField.inclusion hMK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hMK z))) ∧
    (∀ (m : ℤ) (w : K),
