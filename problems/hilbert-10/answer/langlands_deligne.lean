      u_fn c_coeff hc_dvd hu_props hClaimA hClaimB
  have hTr_b_Q_comp :
      ∀ k ∈ Finset.Icc 2 (p - 1),
        let Q_k := traceLM F hM₁'K₁ (((Δ : K₁) ^ p - (Δ : K₁)) ^ k)
        IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k)) - Q_k -
          (if k = p - 1 then ((p - 1 : ℕ) : M₁') * (1 - (- e_Δ (p - 1)) ^ p) else 0) = 0 ∨
          2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 3 + k : ℕ) : ℤ) * (t₁ : ℤ) ≤
            valL F M₁'
              (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k)) - Q_k -
                (if k = p - 1 then ((p - 1 : ℕ) : M₁') * (1 - (- e_Δ (p - 1)) ^ p) else 0)) := by
    intro k hk Q_k
    let P_k := b ^ k +
      ∑ m ∈ (Finset.range p).erase 0,
        normLM F hM₁'K₁
          ((Δ : K₁) + IntermediateField.inclusion hM₁'K₁
            (IntermediateField.inclusion hLM₁' (τ_unit m : L))) ^ k
    let B_v1 : ℤ := 2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 3 + k : ℕ) : ℤ) * (t₁ : ℤ)
    have h1 : IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k)) - P_k = 0 ∨
        B_v1 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k)) - P_k) :=
      hConj12 k hk
    have h2_raw := hPQ_comp k hk
    have h2 : P_k - Q_k -
        (if k = p - 1 then ((p - 1 : ℕ) : M₁') * (1 - (- e_Δ (p - 1)) ^ p) else 0) = 0 ∨
        B_v1 ≤ valL F M₁'
          (P_k - Q_k -
            (if k = p - 1 then ((p - 1 : ℕ) : M₁') * (1 - (- e_Δ (p - 1)) ^ p) else 0)) := by
      rcases h2_raw with h0 | hle
      · exact Or.inl h0
      · right
        have hk_le : (k : ℤ) * (t₁ : ℤ) ≤ ((p - 3 + k : ℕ) : ℤ) * (t₁ : ℤ) := by
          apply mul_le_mul_of_nonneg_right
          · exact_mod_cast (show k ≤ p - 3 + k by omega)
          · positivity
        have hB_le : B_v1 ≤ 2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (k : ℤ) * (t₁ : ℤ) :=
          sub_le_sub_left hk_le (2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ))
        exact le_trans hB_le hle
    have hsum := hvalM₁'_add B_v1
      (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k)) - P_k)
      (P_k - Q_k - (if k = p - 1 then ((p - 1 : ℕ) : M₁') * (1 - (- e_Δ (p - 1)) ^ p) else 0))
      h1 h2
    have hring :
        (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k)) - P_k) +
          (P_k - Q_k - (if k = p - 1 then ((p - 1 : ℕ) : M₁') * (1 - (- e_Δ (p - 1)) ^ p) else 0)) =
        IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k)) - Q_k -
          (if k = p - 1 then ((p - 1 : ℕ) : M₁') * (1 - (- e_Δ (p - 1)) ^ p) else 0) := by ring
    rwa [hring] at hsum
  have hLem9_15 :=
    ld_ch12_wild_odd_tot_ram_power_trace_diff_from_qk_comp F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd_LE' ψ bE' bM₁' a_lam
      hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁
      hvalL hvalE' hvalM₁' hvalK₁
      hval_LM₁' hval_E'K₁ hval_norm_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁
      htr_M₁'K₁ hDiamond_E' Δ hΔ_val hΔ_as e_Δ he_Δ_val hTrNormCongr
      α γ hα_val hγ_val s_LM₁' hs_LM₁'_val hs_LM₁'_cayley hTr_b_Q_comp
  obtain ⟨hC_ne0, hC_val0, hD_ne0, hD_val0, hP_ne0, hP_val0, hPq0_ne0, hPq0_val0,
      hN1_ne0, hN1_val0, hU1_eval⟩ :=
    ld_ch12_wild_odd_tot_ram_u1_norm_ratio_and_lam_eval F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd_LE' ψ bE' bM₁' a_lam
      hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁ hp_valL
      hvalL hvalE' hvalM₁'
      hval_LE' hval_norm_LE' hval_LM₁' hval_norm_LM₁' hval_norm_E'K₁ hval_norm_M₁'K₁
      htr_LE' htr_LM₁' hTowerNormTr lam_L Δ hΔ_val e_Δ he_Δ_val α γ hα_val hγ_val
      hlam_log hψ_triv
      s_LE' hs_LE'_val hs_LE'_norm_one_add hs_LE'_newton
      s_LM₁' hs_LM₁'_val hs_LM₁'_norm_one_add hs_LM₁'_newton hLem9_15
  have hU2_fact :=
    ld_ch12_wild_odd_tot_ram_u2_k_rat_newton_and_unit_factorization F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd_LE' hdegM₁' ψ bE' a_lam
      hbE'_ge2 hbE'_lt_lam hp_valL hvalL hvalE' hval_LE' hval_norm_LE' htr_LE'
      lam_L Δ α γ w₂ A₁ C₂ hα_val hγ_val hw₂_val hw₂_norm hA₁_eq hC₂_eq
      hlam_log hψ_triv s_LE' hs_LE'_val hs_LE'_norm_one_add hs_LE'_newton
      hC_ne0 hC_val0 hP_ne0 hP_val0 hPq0_ne0 hPq0_val0 hN1_ne0
  refine ⟨hPq0_ne0, hPq0_val0, ?_⟩
  rw [hU2_fact, hU1_eval (mul_ne_zero hPq0_ne0 (inv_ne_zero hN1_ne0))]

theorem ld_ch12_wild_odd_tot_ram_rat_cancel_units_and_norm_pow_bounds (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hE'K₁ : E' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F))
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (α γ : Lˣ) (w₂ : E'ˣ)
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ)
    (hw₂_val : valL F E' (w₂ : E') = -((a_lam - bE' : ℕ) : ℤ))
    (hw₂_norm : Units.map (normLM F hLE') w₂ = γ * α⁻¹)
    (s_LE' : E' → ℕ → L)
    (hs_LE'_val : ∀ (w : E') (r : ℕ),
      r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1) →
      ∀ (q m : ℤ), (w = 0 ∨ q ≤ valL F E' w) →
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) * (bE' : ℤ) ≤
            (r : ℤ) * q →
        (s_LE' w r = 0 ∨ m ≤ valL F L (s_LE' w r)))
    (hs_LE'_norm_one_add : ∀ w : E',
      normLM F hLE' (1 + w) - 1 =
        (∑ r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
          s_LE' w r) + normLM F hLE' w)
    (hs_LE'_cayley : ∀ w : E',
      w ^ (Module.finrank L (IntermediateField.extendScalars hLE')) =
        IntermediateField.inclusion hLE' (normLM F hLE' w) +
          ∑ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
            (-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' w i) *
              w ^ (Module.finrank L (IntermediateField.extendScalars hLE') - i)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    let t₂ := bE' - 1
    let m := a_lam - bE'
    let a := normLM F hE'K₁ (Δ : K₁)
    let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
    let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
    let C := 1 + IntermediateField.inclusion hLE' u * a
    let P_star := normLM F hLE' C
    let q₀ := u ^ (p - 1)
    let D := 1 + u ^ p * normLM F hLE' a
    let W_E' := IntermediateField.inclusion hLE' W
    let Q_E' := 1 + IntermediateField.inclusion hLE' (u ^ p) * a ^ p
    let D₀_E' := W_E' ^ p - W_E' + a ^ p
    let m_x1 : ℤ := (((p * m - t₁ : ℕ) : ℤ) + ((p - 1 : ℕ) : ℤ) * (bE' : ℤ)) / (p : ℤ)
    (2 : E') ≠ 0 ∧
    (∀ j ∈ Finset.Icc 1 (p - 1),
      ((j : ℕ) : E') ≠ 0 ∧ valL F E' ((j : ℕ) : E') = 0 ∧ valL F E' (((j : ℕ) : E')⁻¹) = 0) ∧
    (((p : ℕ) : E') = 0 ∨ (((p - 1) * t₂ : ℕ) : ℤ) ≤ valL F E' ((p : ℕ) : E')) ∧
    (C ≠ 0 ∧ valL F E' C = 0 ∧
      P_star ≠ 0 ∧ valL F L P_star = 0 ∧
      D ≠ 0 ∧ valL F L D = 0 ∧
      P_star - q₀ ≠ 0 ∧ valL F L (P_star - q₀) = 0 ∧
      Q_E' - IntermediateField.inclusion hLE' q₀ ≠ 0 ∧
      valL F E' (Q_E' - IntermediateField.inclusion hLE' q₀) = 0 ∧
      D₀_E' ≠ 0) ∧
    (1 - IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) = 0 ∨
      (((p - 1) * t₂ : ℕ) : ℤ) ≤
        valL F E' (1 - IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p))) ∧
    (P_star - D = 0 ∨ m_x1 ≤ valL F L (P_star - D)) ∧
    (Q_E' - IntermediateField.inclusion hLE' P_star = 0 ∨
      (((p - 1) * t₂ + (p * m - t₁) : ℕ) : ℤ) ≤
        valL F E' (Q_E' - IntermediateField.inclusion hLE' P_star)) ∧
    (C ^ p - Q_E' = 0 ∨
      (((p - 1) * t₂ + (p * m - t₁) : ℕ) : ℤ) ≤ valL F E' (C ^ p - Q_E')) :=
by
  intro p t₁ t₂ m a u W C P_star q₀ D W_E' Q_E' D₀_E' m_x1
  obtain ⟨_, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, _, hvalL_add, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨_, hvalE'_1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv, _, hvalE'_add, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F E'
  have hval_helpers :
      ∀ (M : IntermediateField F (AlgebraicClosure F)),
        valL F M 1 = 0 →
        valL F M (-1) = 0 →
        (∀ x : M, valL F M (-x) = valL F M x) →
        (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) →
        (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) →
        (∀ (k : ℤ) (x y : M),
          (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
            (x + y = 0 ∨ k ≤ valL F M (x + y))) →
        (∀ (x : M) (k : ℕ), x ≠ 0 → valL F M (x ^ k) = (k : ℤ) * valL F M x) ∧
        (∀ (x : M), x ≠ 0 → valL F M x⁻¹ = - valL F M x) ∧
        (∀ (x y : M), x ≠ 0 → (y = 0 ∨ valL F M x < valL F M y) →
          x + y ≠ 0 ∧ valL F M (x + y) = valL F M x) ∧
        (∀ (k : ℤ) (x y : M),
          (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
            (x - y = 0 ∨ k ≤ valL F M (x - y))) ∧
        (∀ (k₁ k₂ : ℤ) (x : M),
          k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F M x) → (x = 0 ∨ k₁ ≤ valL F M x)) ∧
        (∀ (k₁ k₂ : ℤ) (x y : M),
          (x = 0 ∨ k₁ ≤ valL F M x) → (y = 0 ∨ k₂ ≤ valL F M y) →
            (x * y = 0 ∨ k₁ + k₂ ≤ valL F M (x * y))) ∧
        (∀ (x : M) (n : ℕ) (q : ℤ),
          (x = 0 ∨ q ≤ valL F M x) → (x ^ n = 0 ∨ (n : ℤ) * q ≤ valL F M (x ^ n))) ∧
        (∀ (S : Finset ℕ) (f : ℕ → M) (k : ℤ),
          (∀ i ∈ S, f i = 0 ∨ k ≤ valL F M (f i)) →
            ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F M (∑ i ∈ S, f i))) ∧
        (∀ n : ℕ, (n : M) = 0 ∨ (0 : ℤ) ≤ valL F M (n : M)) ∧
        (∀ z : ℤ, (z : M) = 0 ∨ (0 : ℤ) ≤ valL F M (z : M)) ∧
        (∀ r : ℕ, (-1 : M) ^ r ≠ 0 ∧ valL F M ((-1 : M) ^ r) = 0) := by
    intro M hv1 hvneg1 hvneg hvmul hvinv hvadd
    have hvpow : ∀ (x : M) (k : ℕ), x ≠ 0 → valL F M (x ^ k) = (k : ℤ) * valL F M x := by
      intro x k hx
      induction k with
      | zero => simp [hv1]
      | succ k ih =>
        rw [pow_succ, hvmul (x ^ k) x (pow_ne_zero k hx) hx, ih]
        push_cast
        ring
    have hvinv_elt : ∀ (x : M), x ≠ 0 → valL F M x⁻¹ = - valL F M x := by
      intro x hx
      exact hvinv (Units.mk0 x hx)
    have hvstrict : ∀ (x y : M), x ≠ 0 → (y = 0 ∨ valL F M x < valL F M y) →
        x + y ≠ 0 ∧ valL F M (x + y) = valL F M x := by
      intro x y hx hxy
      rcases hxy with rfl | hlt
      · simp [hx]
      · by_cases hy0 : y = 0
        · simp [hy0, hx]
        · have hxy_ne0 : x + y ≠ 0 := by
            intro h0
            have hx_eq : x = -y := eq_neg_of_add_eq_zero_left h0
            have hveq : valL F M x = valL F M y := by rw [hx_eq, hvneg]
            omega
          have hge : valL F M x ≤ valL F M (x + y) :=
            (hvadd (valL F M x) x y (Or.inr le_rfl) (Or.inr (le_of_lt hlt))).resolve_left hxy_ne0
          have hle : valL F M (x + y) ≤ valL F M x := by
            by_contra hgt
            push_neg at hgt
            set k : ℤ := min (valL F M (x + y)) (valL F M y)
            have hk_xy : x + y = 0 ∨ k ≤ valL F M (x + y) := Or.inr (min_le_left _ _)
            have hk_ny : -y = 0 ∨ k ≤ valL F M (-y) := by
              right; rw [hvneg]; exact min_le_right _ _
            have hsum := hvadd k (x + y) (-y) hk_xy hk_ny
            rw [add_neg_cancel_right] at hsum
            have hk_le : k ≤ valL F M x := hsum.resolve_left hx
            have hlt_k : valL F M x < k := lt_min hgt hlt
            omega
          exact ⟨hxy_ne0, le_antisymm hle hge⟩
    have hvsub : ∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x - y = 0 ∨ k ≤ valL F M (x - y)) := by
      intro k x y hx hy
      rw [sub_eq_add_neg]
      refine hvadd k x (-y) hx ?_
      rcases hy with rfl | hy
      · exact Or.inl neg_zero
      · exact Or.inr (by rwa [hvneg])
    have hvmono : ∀ (k₁ k₂ : ℤ) (x : M),
        k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F M x) → (x = 0 ∨ k₁ ≤ valL F M x) := by
      intro k₁ k₂ x hle hx
      rcases hx with rfl | hx
      · exact Or.inl rfl
      · exact Or.inr (le_trans hle hx)
    have hvmul_ge : ∀ (k₁ k₂ : ℤ) (x y : M),
        (x = 0 ∨ k₁ ≤ valL F M x) → (y = 0 ∨ k₂ ≤ valL F M y) →
          (x * y = 0 ∨ k₁ + k₂ ≤ valL F M (x * y)) := by
      intro k₁ k₂ x y hx hy
      by_cases hx0 : x = 0
      · left; rw [hx0, zero_mul]
      · by_cases hy0 : y = 0
        · left; rw [hy0, mul_zero]
        · right
          rw [hvmul x y hx0 hy0]
          exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
    have hvpow_ge : ∀ (x : M) (n : ℕ) (q : ℤ),
        (x = 0 ∨ q ≤ valL F M x) → (x ^ n = 0 ∨ (n : ℤ) * q ≤ valL F M (x ^ n)) := by
      intro x n q hx
      induction n with
      | zero =>
        right
        simp [hv1]
      | succ n ih =>
        rw [pow_succ]
        have hmul := hvmul_ge ((n : ℤ) * q) q (x ^ n) x ih hx
        have heq : ((n + 1 : ℕ) : ℤ) * q = (n : ℤ) * q + q := by push_cast; ring
        rwa [heq]
    have hvsum_ge : ∀ (S : Finset ℕ) (f : ℕ → M) (k : ℤ),
        (∀ i ∈ S, f i = 0 ∨ k ≤ valL F M (f i)) →
          ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F M (∑ i ∈ S, f i)) := by
      intro S f k hf
      induction' S using Finset.induction_on with i S hi ih
      · left; exact Finset.sum_empty
      · rw [Finset.sum_insert hi]
        exact hvadd k (f i) (∑ j ∈ S, f j)
          (hf i (Finset.mem_insert_self i S))
          (ih (fun j hj => hf j (Finset.mem_insert_of_mem hj)))
    have hvnat : ∀ n : ℕ, (n : M) = 0 ∨ (0 : ℤ) ≤ valL F M (n : M) := by
      intro n
      induction n with
      | zero => left; exact Nat.cast_zero
      | succ n ih =>
        rw [Nat.cast_succ]
        exact hvadd 0 (n : M) 1 ih (Or.inr (by rw [hv1]))
    have hvint : ∀ z : ℤ, (z : M) = 0 ∨ (0 : ℤ) ≤ valL F M (z : M) := by
      intro z
      cases z with
      | ofNat n => simpa using hvnat n
      | negSucc n =>
        rw [Int.cast_negSucc]
        rcases hvnat (n + 1) with h0 | hge
        · left; exact neg_eq_zero.mpr h0
        · right; rw [hvneg]; exact hge
    have hvneg1_pow : ∀ r : ℕ, (-1 : M) ^ r ≠ 0 ∧ valL F M ((-1 : M) ^ r) = 0 := by
      intro r
      have hne : (-1 : M) ^ r ≠ 0 := pow_ne_zero r (neg_ne_zero.mpr one_ne_zero)
      refine ⟨hne, ?_⟩
      rw [hvpow (-1 : M) r (neg_ne_zero.mpr one_ne_zero), hvneg1, mul_zero]
    exact ⟨hvpow, hvinv_elt, hvstrict, hvsub, hvmono, hvmul_ge, hvpow_ge, hvsum_ge, hvnat, hvint,
      hvneg1_pow⟩
  obtain ⟨hvalL_pow, _, hvalL_strict, hvalL_sub, _, _, _, hvalL_sum_ge, _, _, _⟩ :=
    hval_helpers L hvalL_1 hvalL_neg1 hvalL_neg hvalL_mul hvalL_inv hvalL_add
  obtain ⟨hvalE'_pow, hvalE'_inv_elt, hvalE'_strict, hvalE'_sub, hvalE'_mono,
      hvalE'_mul_ge, hvalE'_pow_ge, hvalE'_sum_ge, hvalE'_natCast, hvalE'_intCast,
      hneg1_pow_E'⟩ :=
    hval_helpers E' hvalE'_1 hvalE'_neg1 hvalE'_neg hvalE'_mul hvalE'_inv hvalE'_add
  clear hval_helpers

  
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ne2 : p ≠ 2 := by dsimp [p]; omega
  have hp_ge3 : 3 ≤ p := by omega
  have hp_pos_int : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hp_pos
  have hp_ne0_int : (p : ℤ) ≠ 0 := ne_of_gt hp_pos_int
  have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
  have ht₂_ge1 : 1 ≤ t₂ := by dsimp [t₂]; omega
  have ht_le : t₁ ≤ t₂ := by dsimp [t₁, t₂]; omega
  have hm_ge1 : 1 ≤ m := by dsimp [m]; omega
  have hpm_gt : t₁ < p * m := hpm_gt_t₁
  have hpm_ge1 : 1 ≤ p * m - t₁ := by omega
  have hp1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have hbE'1_cast : (t₂ : ℤ) = (bE' : ℤ) - 1 := by dsimp [t₂]; omega
  have hpt₁_lt_ppm : p * t₁ < p * p * m := by
    have h1 : p * t₁ < p * (p * m) := Nat.mul_lt_mul_of_pos_left hpm_gt_t₁ hp_pos
    linarith [show p * (p * m) = p * p * m by ring]
  have hpm_lt_ppm : p * m < p * p * m := by
    have hpos : 0 < p * m := by positivity
    nlinarith

  
  have hp_valE' : ((p : ℕ) : E') = 0 ∨ (((p - 1) * t₂ : ℕ) : ℤ) ≤ valL F E' ((p : ℕ) : E') := by
    have hmap : IntermediateField.inclusion hE'K₁ ((p : ℕ) : E') = ((p : ℕ) : K₁) :=
      map_natCast (IntermediateField.inclusion hE'K₁) p
    rcases hp_valK₁ with hp0 | hp_ge
    · left
      exact (map_eq_zero (IntermediateField.inclusion hE'K₁)).mp (hmap.trans hp0)
    · right
      rw [← hmap, hval_E'K₁] at hp_ge
      have h1 : (p : ℤ) * (((p - 1) * t₂ : ℕ) : ℤ) ≤ (p : ℤ) * valL F E' ((p : ℕ) : E') := by
        have hcast : ((p * (p - 1) * t₂ : ℕ) : ℤ) = (p : ℤ) * (((p - 1) * t₂ : ℕ) : ℤ) := by
          push_cast; ring
        linarith
      exact le_of_mul_le_mul_left h1 hp_pos_int
  have hp_valE'_ge1 : ((p : ℕ) : E') = 0 ∨ 1 ≤ valL F E' ((p : ℕ) : E') := by
    apply hvalE'_mono 1 (((p - 1) * t₂ : ℕ) : ℤ) ((p : ℕ) : E') _ hp_valE'
    have h1 : 1 ≤ (p - 1) * t₂ := Nat.mul_pos (by omega) ht₂_ge1
    exact_mod_cast h1
  have hj_unit :
      ∀ j ∈ Finset.Icc 1 (p - 1),
        ((j : ℕ) : E') ≠ 0 ∧ valL F E' ((j : ℕ) : E') = 0 ∧ valL F E' (((j : ℕ) : E')⁻¹) = 0 := by
    intro j hj
    obtain ⟨hj1, hjp1⟩ := Finset.mem_Icc.mp hj
    have hnot_ge1 : ¬ (((j : ℕ) : E') = 0 ∨ 1 ≤ valL F E' ((j : ℕ) : E')) := by
      intro hj_bad
      have hndvd : ¬ (p ∣ j) := Nat.not_dvd_of_pos_of_lt hj1 (by omega)
      have hcop : Nat.Coprime p j := (Nat.Prime.coprime_iff_not_dvd hPrime).mpr hndvd
      have hgcd : Nat.gcd j p = 1 := Nat.Coprime.gcd_eq_one hcop.symm
      have hbez_int : (1 : ℤ) = (j : ℤ) * Nat.gcdA j p + (p : ℤ) * Nat.gcdB j p := by
        have h := Nat.gcd_eq_gcd_ab j p
        rw [hgcd] at h
        simpa using h
      have hbez_E' : (1 : E') =
          ((j : ℕ) : E') * (Nat.gcdA j p : E') + ((p : ℕ) : E') * (Nat.gcdB j p : E') := by
        have h := congrArg (Int.cast : ℤ → E') hbez_int
        push_cast at h
        exact h
      have hterm1 : ((j : ℕ) : E') * (Nat.gcdA j p : E') = 0 ∨
          1 ≤ valL F E' (((j : ℕ) : E') * (Nat.gcdA j p : E')) := by
        have h := hvalE'_mul_ge 1 0 ((j : ℕ) : E') (Nat.gcdA j p : E') hj_bad
          (hvalE'_intCast (Nat.gcdA j p))
        rwa [add_zero] at h
      have hterm2 : ((p : ℕ) : E') * (Nat.gcdB j p : E') = 0 ∨
          1 ≤ valL F E' (((p : ℕ) : E') * (Nat.gcdB j p : E')) := by
        have h := hvalE'_mul_ge 1 0 ((p : ℕ) : E') (Nat.gcdB j p : E') hp_valE'_ge1
          (hvalE'_intCast (Nat.gcdB j p))
        rwa [add_zero] at h
      have hsum := hvalE'_add 1 _ _ hterm1 hterm2
      rw [← hbez_E', hvalE'_1] at hsum
      rcases hsum with h10 | h1le0
      · exact one_ne_zero h10
      · omega
    rcases hvalE'_natCast j with hj0 | hj_ge0
    · exact False.elim (hnot_ge1 (Or.inl hj0))
    · have hj_ne0 : ((j : ℕ) : E') ≠ 0 := fun hj0 => hnot_ge1 (Or.inl hj0)
      have hj_lt1 : valL F E' ((j : ℕ) : E') < 1 := by
        by_contra hge1
        push_neg at hge1
        exact hnot_ge1 (Or.inr hge1)
      have hj_val0 : valL F E' ((j : ℕ) : E') = 0 := by omega
      have hj_inv_val0 : valL F E' (((j : ℕ) : E')⁻¹) = 0 := by
        rw [hvalE'_inv_elt ((j : ℕ) : E') hj_ne0, hj_val0, neg_zero]
      exact ⟨hj_ne0, hj_val0, hj_inv_val0⟩
  have h2_ne0 : (2 : E') ≠ 0 := by
    have h2_mem : 2 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨by omega, by omega⟩
    have h2_cast := (hj_unit 2 h2_mem).1
    rwa [Nat.cast_ofNat] at h2_cast

  
  have hu_ne0 : u ≠ 0 := mul_ne_zero (Units.ne_zero α) (Units.ne_zero γ⁻¹)
  have hu_val : valL F L u = (m : ℤ) := by
    dsimp [u, m]
    rw [hvalL_mul (α : L) ((γ⁻¹ : Lˣ) : L) (Units.ne_zero α) (Units.ne_zero γ⁻¹),
      hvalL_inv γ, hα_val, hγ_val]
    omega
  have hW_L_ne0 : W ≠ 0 := mul_ne_zero (Units.ne_zero γ) (Units.ne_zero α⁻¹)
  have hW_L_val : valL F L W = -(m : ℤ) := by
    dsimp [W, m]
    rw [hvalL_mul (γ : L) ((α⁻¹ : Lˣ) : L) (Units.ne_zero γ) (Units.ne_zero α⁻¹),
      hvalL_inv α, hγ_val, hα_val]
    omega
  have ha_ne0 : a ≠ 0 := Units.ne_zero (Units.map (normLM F hE'K₁) Δ)
  have ha_val : valL F E' a = -(t₁ : ℤ) := by
    dsimp [a, t₁]
    rw [hval_norm_E'K₁, hΔ_val]
  have hnorm_incl_L : ∀ c : L, normLM F hLE' (IntermediateField.inclusion hLE' c) = c ^ p := by
    intro c
    have heq : toExtendScalars F hLE' (IntermediateField.inclusion hLE' c) =
        algebraMap L (IntermediateField.extendScalars hLE') c := Subtype.ext rfl
    change Algebra.norm L (toExtendScalars F hLE' (IntermediateField.inclusion hLE' c)) = c ^ p
    rw [heq, Algebra.norm_algebraMap]
  let x : E' := IntermediateField.inclusion hLE' u * a
  let q_x : ℤ := ((p * m - t₁ : ℕ) : ℤ)
  have hq_x_ge1 : 1 ≤ q_x := by dsimp [q_x]; omega
  have hu_E'_ne0 : IntermediateField.inclusion hLE' u ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hLE')).mpr hu_ne0
  have hu_E'_val : valL F E' (IntermediateField.inclusion hLE' u) = (p : ℤ) * (m : ℤ) := by
    rw [hval_LE' u, hu_val]
  have hx_ne0 : x ≠ 0 := mul_ne_zero hu_E'_ne0 ha_ne0
  have hx_val : valL F E' x = q_x := by
    dsimp [x, q_x]
    rw [hvalE'_mul _ _ hu_E'_ne0 ha_ne0, hu_E'_val, ha_val]
    omega
  obtain ⟨hC_ne0, hC_val0⟩ : C ≠ 0 ∧ valL F E' C = 0 := by
    change 1 + x ≠ 0 ∧ valL F E' (1 + x) = 0
    have h := hvalE'_strict 1 x one_ne_zero (Or.inr (by rw [hvalE'_1, hx_val]; linarith))
    rwa [hvalE'_1] at h
  let u_C : E'ˣ := Units.mk0 C hC_ne0
  have hPstar_ne0 : P_star ≠ 0 := Units.ne_zero (Units.map (normLM F hLE') u_C)
  have hPstar_val0 : valL F L P_star = 0 := by
    dsimp [P_star]
    rw [hval_norm_LE' C, hC_val0]
  have hnorm_x : normLM F hLE' x = u ^ p * normLM F hLE' a := by
    dsimp [x]
    rw [map_mul, hnorm_incl_L u]
  let u_x : E'ˣ := Units.mk0 x hx_ne0
  have hnorm_x_ne0 : normLM F hLE' x ≠ 0 := Units.ne_zero (Units.map (normLM F hLE') u_x)
  have hnorm_x_val : valL F L (normLM F hLE' x) = q_x := by
    rw [hval_norm_LE' x, hx_val]
  obtain ⟨hD_ne0, hD_val0⟩ : D ≠ 0 ∧ valL F L D = 0 := by
    have hD_eq : D = 1 + normLM F hLE' x := by dsimp [D]; rw [hnorm_x]
    rw [hD_eq]
    have h := hvalL_strict 1 (normLM F hLE' x) one_ne_zero
      (Or.inr (by rw [hvalL_1, hnorm_x_val]; linarith))
    rwa [hvalL_1] at h
  have hq₀_ne0 : q₀ ≠ 0 := pow_ne_zero (p - 1) hu_ne0
  have hq₀_val : valL F L q₀ = ((p - 1 : ℕ) : ℤ) * (m : ℤ) := by
    dsimp [q₀]
    rw [hvalL_pow u (p - 1) hu_ne0, hu_val]
  have hq₀_ge1 : 1 ≤ ((p - 1 : ℕ) : ℤ) * (m : ℤ) := by
    have h1 : 1 ≤ (p - 1) * m := Nat.mul_pos (by omega) hm_ge1
    exact_mod_cast h1
  obtain ⟨hPq₀_ne0, hPq₀_val0⟩ : P_star - q₀ ≠ 0 ∧ valL F L (P_star - q₀) = 0 := by
    rw [sub_eq_add_neg]
    have h := hvalL_strict P_star (-q₀) hPstar_ne0
      (Or.inr (by rw [hPstar_val0, hvalL_neg, hq₀_val]; linarith))
    rwa [hPstar_val0] at h
  have hQE'_eq : Q_E' = 1 + x ^ p := by
    dsimp [Q_E', x]
    rw [map_pow, mul_pow]
  have hxp_ne0 : x ^ p ≠ 0 := pow_ne_zero p hx_ne0
  have hxp_val : valL F E' (x ^ p) = (p : ℤ) * q_x := by
    rw [hvalE'_pow x p hx_ne0, hx_val]
  have hxp_ge1 : x ^ p = 0 ∨ 1 ≤ valL F E' (x ^ p) := by
    right
    rw [hxp_val]
    have : 1 ≤ (p : ℤ) * q_x := by nlinarith
    exact this
  have hq₀E'_ne0 : IntermediateField.inclusion hLE' q₀ ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hLE')).mpr hq₀_ne0
  have hq₀E'_val : valL F E' (IntermediateField.inclusion hLE' q₀) =
      (p : ℤ) * (((p - 1 : ℕ) : ℤ) * (m : ℤ)) := by
    rw [hval_LE' q₀, hq₀_val]
  have hq₀E'_ge1 :
      IntermediateField.inclusion hLE' q₀ = 0 ∨
        1 ≤ valL F E' (IntermediateField.inclusion hLE' q₀) := by
    right
    rw [hq₀E'_val]
    have : 1 ≤ (p : ℤ) * (((p - 1 : ℕ) : ℤ) * (m : ℤ)) := by nlinarith
    exact this
  obtain ⟨hQq₀_ne0, hQq₀_val0⟩ :
