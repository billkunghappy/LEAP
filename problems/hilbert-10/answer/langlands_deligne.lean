        intro m hm
        rw [Finset.mem_range] at hm
        rw [← pow_add, Nat.add_sub_of_le (by omega)]
      rw [Finset.sum_congr rfl hterm, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    rw [hsum_eq] at hev
    calc β j₀ * (∏ j ∈ (F_fib p).erase j₀, (β j₀ - β j))
        = β j₀ * ((k : k_M) * (β j₀) ^ (k - 1)) := by rw [hev]
      _ = (k : k_M) * (β j₀ * (β j₀) ^ (k - 1)) := by ring
      _ = (k : k_M) * (β j₀) ^ k := by rw [← pow_succ', Nat.sub_add_cancel hk_ge1]
      _ = (k : k_M) * c p := by rw [hj₀_pow]
  have hβ_prod : (∏ j : Fin (q - 1), β j) =
      (-1 : k_M) ^ u * (U₀_bar ^ (u * t)) * ι_res P_ξ := by
    have hprod_0 : (∏ j : Fin (q - 1), (0 - β j)) =
        ∏ p : Σ i : Fin r_orb, Fin (f_i i), (0 ^ k - c p) := by
      conv_lhs => rw [← hU_all, Finset.prod_biUnion (fun p₁ _ p₂ _ hne => hF_disj p₁ p₂ hne)]
      refine Finset.prod_congr rfl fun p _ => hF_eval p 0
    simp only [zero_sub, zero_pow (by omega : k ≠ 0)] at hprod_0
    rw [Finset.prod_neg, Finset.prod_neg, Finset.card_univ, Fintype.card_fin,
      Finset.card_univ, hcard_I] at hprod_0
    obtain ⟨m, hm⟩ := hq_odd
    have hq1_even : q - 1 = 2 * m := by omega
    have hneg1_q1 : (-1 : k_M) ^ (q - 1) = 1 := by
      rw [hq1_even, pow_mul, neg_one_sq, one_pow]
    rw [hneg1_q1, one_mul] at hprod_0
    rw [hprod_0]
    dsimp only [c]
    rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, hcard_I,
      ← pow_mul, mul_comm t u, Fintype.prod_sigma, ← mul_assoc, hw_prod]
  have hw_cof : ∀ (i₀ : Fin r_orb) (s₀ : Fin (f_i i₀)),
      ∃ j₀ : Fin (q - 1),
        β j₀ * (∏ j ∈ Finset.univ.erase j₀, (β j₀ - β j)) =
          (k : k_M) * (U₀_bar ^ (u * t)) * (w i₀ s₀) *
            (∏ s ∈ Finset.univ.erase s₀, (w i₀ s₀ - w i₀ s)) *
            (∏ i ∈ Finset.univ.erase i₀, ∏ s : Fin (f_i i), (w i₀ s₀ - w i s)) := by
    intro i₀ s₀
    let p₀ : Σ i : Fin r_orb, Fin (f_i i) := ⟨i₀, s₀⟩
    have hu_ge1 : 1 ≤ u := by
      rw [← hcard_I]
      exact Fintype.card_pos_iff.mpr ⟨p₀⟩
    have hF_ne : (F_fib p₀).Nonempty := by
      rw [← Finset.card_pos, hF_card p₀]
      exact hk_ge1
    rcases hF_ne with ⟨j₀, hj₀⟩
    have hj₀_pow : (β j₀) ^ k = c p₀ := (Finset.mem_filter.mp hj₀).2
    refine ⟨j₀, ?_⟩
    have h_disj_erase : Disjoint ((F_fib p₀).erase j₀)
        (((Finset.univ : Finset (Σ i : Fin r_orb, Fin (f_i i))).erase p₀).biUnion F_fib) := by
      rw [Finset.disjoint_biUnion_right]
      intro p hp
      have hp_ne : p₀ ≠ p := (Finset.ne_of_mem_erase hp).symm
      exact Disjoint.mono_left (Finset.erase_subset j₀ (F_fib p₀)) (hF_disj p₀ p hp_ne)
    have h_union_erase : (Finset.univ : Finset (Fin (q - 1))).erase j₀ =
        (F_fib p₀).erase j₀ ∪ ((Finset.univ : Finset (Σ i : Fin r_orb, Fin (f_i i))).erase p₀).biUnion F_fib := by
      ext j
      simp only [Finset.mem_erase, Finset.mem_univ, and_true, Finset.mem_union, Finset.mem_biUnion]
      constructor
      · intro hj_ne
        have hj_all : j ∈ (Finset.univ : Finset (Σ i : Fin r_orb, Fin (f_i i))).biUnion F_fib := by
          rw [hU_all]
          exact Finset.mem_univ j
        rw [Finset.mem_biUnion] at hj_all
        rcases hj_all with ⟨p, _, hjp⟩
        by_cases hp : p = p₀
        · subst hp
          exact Or.inl ⟨hj_ne, hjp⟩
        · exact Or.inr ⟨p, hp, hjp⟩
      · rintro (⟨hj_ne, _⟩ | ⟨p, hp_ne, hjp⟩)
        · exact hj_ne
        · intro rfl
          exact Finset.disjoint_left.mp (hF_disj p p₀ hp_ne) hjp hj₀
    rw [h_union_erase, Finset.prod_union h_disj_erase,
      Finset.prod_biUnion (fun p₁ _ p₂ _ hne => hF_disj p₁ p₂ hne),
      ← mul_assoc, hF_cof p₀ j₀ hj₀]
    have h_other_eval :
        (∏ p ∈ (Finset.univ : Finset (Σ i : Fin r_orb, Fin (f_i i))).erase p₀, ∏ j ∈ F_fib p, (β j₀ - β j)) =
        ∏ p ∈ (Finset.univ : Finset (Σ i : Fin r_orb, Fin (f_i i))).erase p₀,
          ((U₀_bar ^ t) * (w i₀ s₀ - w p.1 p.2)) := by
      refine Finset.prod_congr rfl fun p _ => ?_
      rw [hF_eval p (β j₀), hj₀_pow]
      dsimp only [c, p₀]
      ring
    rw [h_other_eval, Finset.prod_mul_distrib, Finset.prod_const,
      Finset.card_erase_of_mem (Finset.mem_univ p₀), Finset.card_univ, hcard_I]
    let S_same : Finset (Σ i : Fin r_orb, Fin (f_i i)) :=
      (Finset.univ.erase s₀).map (Function.Embedding.sigmaMk i₀)
    let S_diff : Finset (Σ i : Fin r_orb, Fin (f_i i)) :=
      (Finset.univ.erase i₀).sigma (fun i => (Finset.univ : Finset (Fin (f_i i))))
    have hS_disj : Disjoint S_same S_diff := by
      rw [Finset.disjoint_left]
      intro p hp₁ hp₂
      rcases Finset.mem_map.mp hp₁ with ⟨s, _, rfl⟩
      have hi_mem := (Finset.mem_sigma.mp hp₂).1
      exact (Finset.mem_erase.mp hi_mem).1 rfl
    have hS_union : (Finset.univ : Finset (Σ i : Fin r_orb, Fin (f_i i))).erase p₀ =
        S_same ∪ S_diff := by
      ext ⟨i, s⟩
      simp only [Finset.mem_erase, Finset.mem_univ, and_true, Finset.mem_union,
        S_same, Finset.mem_map, S_diff, Finset.mem_sigma, p₀]
      by_cases hi : i = i₀
      · subst hi
        constructor
        · intro hne
          have hs : s ≠ s₀ := fun h => hne (congrArg (Sigma.mk i) h)
          exact Or.inl ⟨s, hs, rfl⟩
        · rintro (⟨a, ha_ne, ha_eq⟩ | hi_ne)
          · have ha_s : a = s := (Sigma.mk.inj_iff.mp ha_eq).2.eq
            rw [← ha_s]
            intro h_eq
            exact ha_ne (Sigma.mk.inj_iff.mp h_eq).2.eq
          · exact (hi_ne rfl).elim
      · constructor
        · intro _
          exact Or.inr hi
        · intro _ h_eq
          exact hi (Sigma.ext_iff.mp h_eq).1
    rw [hS_union, Finset.prod_union hS_disj, Finset.prod_map, Finset.prod_sigma]
    dsimp only [Function.Embedding.sigmaMk_apply, c, p₀]
    have hU_pow_combine : (U₀_bar ^ t) * (U₀_bar ^ t) ^ (u - 1) = U₀_bar ^ (u * t) := by
      rw [← pow_succ', Nat.sub_add_cancel hu_ge1, ← pow_mul, mul_comm t u]
    calc (k : k_M) * ((U₀_bar ^ t) * w i₀ s₀) *
          ((U₀_bar ^ t) ^ (u - 1) *
            ((∏ x ∈ Finset.univ.erase s₀, (w i₀ s₀ - w i₀ x)) *
              (∏ i ∈ Finset.univ.erase i₀, ∏ s : Fin (f_i i), (w i₀ s₀ - w i s))))
        = (k : k_M) * ((U₀_bar ^ t) * (U₀_bar ^ t) ^ (u - 1)) * (w i₀ s₀) *
            (∏ s ∈ Finset.univ.erase s₀, (w i₀ s₀ - w i₀ s)) *
            (∏ i ∈ Finset.univ.erase i₀, ∏ s : Fin (f_i i), (w i₀ s₀ - w i s)) := by ring
      _ = (k : k_M) * (U₀_bar ^ (u * t)) * (w i₀ s₀) *
            (∏ s ∈ Finset.univ.erase s₀, (w i₀ s₀ - w i₀ s)) *
            (∏ i ∈ Finset.univ.erase i₀, ∏ s : Fin (f_i i), (w i₀ s₀ - w i s)) := by
          rw [hU_pow_combine]
  exact ⟨h_not_both_even, h_norm_pow, hβ_prod, ⟨w, hw_inj, hw_frob, hw_prod, hw_cof⟩⟩

theorem ld_ch14_odd_p_vandermonde_orbit_master_sign (k_L : Type u) [Field k_L] [Fintype k_L]
    (k_M : Type u) [Field k_M] [Fintype k_M]
    (ι_res : k_L →+* k_M)
    (p_char : ℕ) (hp : Nat.Prime p_char) (hp_ne2 : p_char ≠ 2)
    (hp_char : (p_char : k_L) = 0)
    (r_orb u k : ℕ) (hu_pos : 1 ≤ u) (f_i : Fin r_orb → ℕ)
    (hf_pos : ∀ i : Fin r_orb, 1 ≤ f_i i)
    (hu_sum : (∑ i : Fin r_orb, f_i i) = u)
    (P_ξ : k_L) (hP_ξ_ne : P_ξ ≠ 0)
    (w : ∀ i : Fin r_orb, Fin (f_i i) → k_M)
    (hw_inj : Function.Injective (fun p : Σ i : Fin r_orb, Fin (f_i i) => w p.1 p.2))
    (hw_frob : ∀ (i : Fin r_orb) (s : Fin (f_i i)),
      (w i s) ^ (Fintype.card k_L) = w i (finRotate (f_i i) s))
    (hw_prod : (∏ i : Fin r_orb, ∏ s : Fin (f_i i), w i s) = ι_res P_ξ)
    (hw_cofactor : ∀ (i₀ : Fin r_orb) (s₀ : Fin (f_i i₀)),
      (k : k_M) * (w i₀ s₀) *
        (∏ s ∈ Finset.univ.erase s₀, (w i₀ s₀ - w i₀ s)) *
        (∏ i ∈ Finset.univ.erase i₀, ∏ s : Fin (f_i i), (w i₀ s₀ - w i s)) =
        (-1 : k_M) ^ u * ι_res P_ξ) :
    (-1 : ℤ) ^ (u - r_orb) =
      (quadraticChar k_L (-1)) ^ (u * (u + 1) / 2) *
        (quadraticChar k_L (k : k_L)) ^ u *
        (quadraticChar k_L P_ξ) ^ (u - 1) :=
by
  
  have h_erase_union : ∀ {n : ℕ} (i : Fin n),
      (Finset.univ : Finset (Fin n)).erase i = Finset.Iio i ∪ Finset.Ioi i := by
    intro n i
    ext j
    simp only [Finset.mem_erase, Finset.mem_univ, and_true, Finset.mem_union,
      Finset.mem_Iio, Finset.mem_Ioi]
    exact ne_iff_lt_or_gt
  have h_Iio_Ioi_disj : ∀ {n : ℕ} (i : Fin n),
      Disjoint (Finset.Iio i) (Finset.Ioi i) := by
    intro n i
    rw [Finset.disjoint_left]
    intro j hj1 hj2
    rw [Finset.mem_Iio] at hj1
    rw [Finset.mem_Ioi] at hj2
    exact lt_asymm hj1 hj2
  have h_Iio_filter : ∀ {n : ℕ} (i : Fin n),
      Finset.Iio i = Finset.univ.filter (fun j : Fin n => j < i) := by
    intro n i; ext j; simp [Finset.mem_Iio]
  have h_Ioi_filter : ∀ {n : ℕ} (i : Fin n),
      Finset.Ioi i = Finset.univ.filter (fun j : Fin n => i < j) := by
    intro n i; ext j; simp [Finset.mem_Ioi]
  have h_offdiag_prod : ∀ {n : ℕ} (A : Fin n → Fin n → k_M),
      (∏ i : Fin n, ∏ j ∈ Finset.univ.erase i, A i j) =
        (∏ i : Fin n, ∏ j ∈ Finset.Ioi i, A j i) *
          (∏ i : Fin n, ∏ j ∈ Finset.Ioi i, A i j) := by
    intro n A
    have h_swap :
        (∏ i : Fin n, ∏ j ∈ Finset.Iio i, A i j) =
          ∏ i : Fin n, ∏ j ∈ Finset.Ioi i, A j i := by
      calc (∏ i : Fin n, ∏ j ∈ Finset.Iio i, A i j)
          = ∏ i : Fin n, ∏ j ∈ Finset.univ.filter (fun j : Fin n => j < i), A i j := by
            refine Finset.prod_congr rfl fun i _ => ?_
            rw [h_Iio_filter i]
        _ = ∏ i : Fin n, ∏ j : Fin n, if j < i then A i j else 1 := by
            refine Finset.prod_congr rfl fun i _ => ?_
            exact Finset.prod_filter (fun j : Fin n => j < i) (fun j => A i j)
        _ = ∏ j : Fin n, ∏ i : Fin n, if j < i then A i j else 1 := Finset.prod_comm
        _ = ∏ j : Fin n, ∏ i ∈ Finset.univ.filter (fun i : Fin n => j < i), A i j := by
            refine Finset.prod_congr rfl fun j _ => ?_
            exact (Finset.prod_filter (fun i : Fin n => j < i) (fun i => A i j)).symm
        _ = ∏ i : Fin n, ∏ j ∈ Finset.Ioi i, A j i := by
            refine Finset.prod_congr rfl fun i _ => ?_
            rw [h_Ioi_filter i]
    calc (∏ i : Fin n, ∏ j ∈ Finset.univ.erase i, A i j)
        = ∏ i : Fin n, ((∏ j ∈ Finset.Iio i, A i j) * (∏ j ∈ Finset.Ioi i, A i j)) := by
          refine Finset.prod_congr rfl fun i _ => ?_
          rw [h_erase_union i, Finset.prod_union (h_Iio_Ioi_disj i)]
      _ = (∏ i : Fin n, ∏ j ∈ Finset.Iio i, A i j) *
            (∏ i : Fin n, ∏ j ∈ Finset.Ioi i, A i j) := Finset.prod_mul_distrib
      _ = (∏ i : Fin n, ∏ j ∈ Finset.Ioi i, A j i) *
            (∏ i : Fin n, ∏ j ∈ Finset.Ioi i, A i j) := by rw [h_swap]
  have h_sq_sum : ∀ {n : ℕ} (g : Fin n → ℕ),
      (∑ i : Fin n, g i) * (∑ j : Fin n, g j) =
        (∑ i : Fin n, g i * g i) +
          2 * (∑ i : Fin n, ∑ j ∈ Finset.Ioi i, g i * g j) := by
    intro n g
    have h_swap :
        (∑ i : Fin n, ∑ j ∈ Finset.Iio i, g i * g j) =
          ∑ i : Fin n, ∑ j ∈ Finset.Ioi i, g i * g j := by
      calc (∑ i : Fin n, ∑ j ∈ Finset.Iio i, g i * g j)
          = ∑ i : Fin n, ∑ j ∈ Finset.univ.filter (fun j : Fin n => j < i), g i * g j := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [h_Iio_filter i]
        _ = ∑ i : Fin n, ∑ j : Fin n, if j < i then g i * g j else 0 := by
            refine Finset.sum_congr rfl fun i _ => ?_
            exact Finset.sum_filter (fun j : Fin n => j < i) (fun j => g i * g j)
        _ = ∑ j : Fin n, ∑ i : Fin n, if j < i then g i * g j else 0 := Finset.sum_comm
        _ = ∑ j : Fin n, ∑ i ∈ Finset.univ.filter (fun i : Fin n => j < i), g i * g j := by
            refine Finset.sum_congr rfl fun j _ => ?_
            exact (Finset.sum_filter (fun i : Fin n => j < i) (fun i => g i * g j)).symm
        _ = ∑ i : Fin n, ∑ j ∈ Finset.Ioi i, g j * g i := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [h_Ioi_filter i]
        _ = ∑ i : Fin n, ∑ j ∈ Finset.Ioi i, g i * g j := by
            refine Finset.sum_congr rfl fun i _ =>
              Finset.sum_congr rfl fun j _ => mul_comm (g j) (g i)
    have h_off :
        (∑ i : Fin n, ∑ j ∈ Finset.univ.erase i, g i * g j) =
          2 * (∑ i : Fin n, ∑ j ∈ Finset.Ioi i, g i * g j) := by
      calc (∑ i : Fin n, ∑ j ∈ Finset.univ.erase i, g i * g j)
          = ∑ i : Fin n, ((∑ j ∈ Finset.Iio i, g i * g j) + (∑ j ∈ Finset.Ioi i, g i * g j)) := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [h_erase_union i, Finset.sum_union (h_Iio_Ioi_disj i)]
        _ = (∑ i : Fin n, ∑ j ∈ Finset.Iio i, g i * g j) +
              (∑ i : Fin n, ∑ j ∈ Finset.Ioi i, g i * g j) := Finset.sum_add_distrib
        _ = 2 * (∑ i : Fin n, ∑ j ∈ Finset.Ioi i, g i * g j) := by
            rw [h_swap, two_mul]
    calc (∑ i : Fin n, g i) * (∑ j : Fin n, g j)
        = ∑ i : Fin n, ∑ j : Fin n, g i * g j := by
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun i _ => Finset.mul_sum _ _ _
      _ = ∑ i : Fin n, (g i * g i + ∑ j ∈ Finset.univ.erase i, g i * g j) := by
          refine Finset.sum_congr rfl fun i _ => ?_
          exact (Finset.add_sum_erase Finset.univ (fun j => g i * g j) (Finset.mem_univ i)).symm
      _ = (∑ i : Fin n, g i * g i) + (∑ i : Fin n, ∑ j ∈ Finset.univ.erase i, g i * g j) :=
          Finset.sum_add_distrib
      _ = (∑ i : Fin n, g i * g i) + 2 * (∑ i : Fin n, ∑ j ∈ Finset.Ioi i, g i * g j) := by
          rw [h_off]
  let e_orb : Fin r_orb → ℕ := fun i => ∑ s₁ : Fin (f_i i), (Finset.Ioi s₁).card
  let E_within : ℕ := ∑ i : Fin r_orb, e_orb i
  let E_cross : ℕ := ∑ i₁ : Fin r_orb, ∑ i₂ ∈ Finset.Ioi i₁, (f_i i₁) * (f_i i₂)
  let E_total : ℕ := E_within + E_cross
  have h_fi_sq : ∀ i : Fin r_orb, f_i i * f_i i = f_i i + 2 * e_orb i := by
    intro i
    have h1 := h_sq_sum (fun _ : Fin (f_i i) => 1)
    simp only [mul_one, Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul] at h1
    exact h1
  have h_u_sq : u * u = u + 2 * E_total := by
    have h1 := h_sq_sum f_i
    rw [hu_sum] at h1
    have h2 : (∑ i : Fin r_orb, f_i i * f_i i) = u + 2 * E_within := by
      calc (∑ i : Fin r_orb, f_i i * f_i i)
          = ∑ i : Fin r_orb, (f_i i + 2 * e_orb i) :=
            Finset.sum_congr rfl fun i _ => h_fi_sq i
        _ = (∑ i : Fin r_orb, f_i i) + ∑ i : Fin r_orb, 2 * e_orb i :=
            Finset.sum_add_distrib
        _ = u + 2 * E_within := by
            rw [hu_sum, ← Finset.mul_sum]
    change u * u = (∑ i : Fin r_orb, f_i i * f_i i) + 2 * E_cross at h1
    rw [h2] at h1
    dsimp only [E_total]
    omega
  have h_E_tri : E_total + u = u * (u + 1) / 2 := by
    have h_u_u1 : u * (u + 1) = 2 * (E_total + u) := by
      calc u * (u + 1) = u * u + u := by ring
        _ = (u + 2 * E_total) + u := by rw [h_u_sq]
        _ = 2 * (E_total + u) := by ring
    rw [h_u_u1]
    omega
  have h_sum_sub1 : (∑ i : Fin r_orb, (f_i i - 1)) = u - r_orb := by
    rw [Finset.sum_tsub_distrib Finset.univ (fun i _ => hf_pos i), hu_sum,
      Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul, mul_one]

  
  let q_L := Fintype.card k_L
  have hring : ringChar k_L = p_char := CharP.ringChar_of_prime_eq_zero hp hp_char
  have hring_ne2 : ringChar k_L ≠ 2 := hring ▸ hp_ne2
  have h2_kL : (2 : k_L) ≠ 0 := Ring.two_ne_zero hring_ne2
  have h2_kM : (2 : k_M) ≠ 0 := by
    have h := ι_res.injective.ne h2_kL
    rwa [map_ofNat, map_zero] at h
  have hqL_gt1 : 1 < q_L := Fintype.one_lt_card
  obtain ⟨n_char, _, m_exp, _, hcard_kL⟩ := FiniteField.card' k_L
  have hn_eq : n_char = p_char := (ringChar.eq k_L n_char).symm.trans hring
  have hqL_pow : q_L = p_char ^ (m_exp : ℕ) := by
    change Fintype.card k_L = _
    rw [← hn_eq]
    exact hcard_kL
  have hqL_odd : Odd q_L := by
    rw [hqL_pow]
    exact (hp.odd_of_ne_two hp_ne2).pow
  have hqL_div2 : 2 * (q_L / 2) = q_L - 1 := by
    rcases hqL_odd with ⟨m, hm⟩
    omega
  have hp_char_M : (p_char : k_M) = 0 := by
    rw [← map_natCast ι_res, hp_char, map_zero]
  have hring_M : ringChar k_M = p_char := CharP.ringChar_of_prime_eq_zero hp hp_char_M
  haveI : Fact (Nat.Prime p_char) := ⟨hp⟩
  haveI : CharP k_M p_char := by
    rw [← hring_M]
    infer_instance
  let Φ_M : k_M →+* k_M :=
    { toFun := fun z => z ^ q_L
      map_one' := one_pow q_L
      map_mul' := fun x y => mul_pow x y q_L
      map_zero' := zero_pow (by omega)
      map_add' := fun x y => by
        rw [hqL_pow]
        exact add_pow_char_pow x y p_char (m_exp : ℕ) }
  have hΦ_M_apply : ∀ z : k_M, Φ_M z = z ^ q_L := fun _ => rfl
  let Δ_orb : Fin r_orb → k_M := fun i => (Matrix.vandermonde (w i)).det
  have hw_i_inj : ∀ i : Fin r_orb, Function.Injective (w i) := by
    intro i s₁ s₂ hs
    have h_eq : (⟨i, s₁⟩ : Σ i' : Fin r_orb, Fin (f_i i')) = ⟨i, s₂⟩ := hw_inj hs
    exact Sigma.mk.inj_iff.mp h_eq |>.2 |> eq_of_heq
  have hΔ_ne : ∀ i : Fin r_orb, Δ_orb i ≠ 0 := by
    intro i
    dsimp only [Δ_orb]
    rw [Matrix.det_vandermonde_ne_zero_iff]
    exact hw_i_inj i
  have hΔ_sq_within : ∀ i : Fin r_orb,
      (∏ s₁ : Fin (f_i i), ∏ s₂ ∈ Finset.univ.erase s₁, (w i s₁ - w i s₂)) =
        (-1 : k_M) ^ (e_orb i) * (Δ_orb i) ^ 2 := by
    intro i
    rw [h_offdiag_prod (fun s₁ s₂ : Fin (f_i i) => w i s₁ - w i s₂)]
    have h_det : (∏ s₁ : Fin (f_i i), ∏ s₂ ∈ Finset.Ioi s₁, (w i s₂ - w i s₁)) = Δ_orb i := by
      dsimp only [Δ_orb]
      exact (Matrix.det_vandermonde (w i)).symm
    have h_flip :
        (∏ s₁ : Fin (f_i i), ∏ s₂ ∈ Finset.Ioi s₁, (w i s₁ - w i s₂)) =
          (-1 : k_M) ^ (e_orb i) * Δ_orb i := by
      have h_inner : ∀ s₁ : Fin (f_i i),
          (∏ s₂ ∈ Finset.Ioi s₁, (w i s₁ - w i s₂)) =
            (-1 : k_M) ^ ((Finset.Ioi s₁).card) * (∏ s₂ ∈ Finset.Ioi s₁, (w i s₂ - w i s₁)) := by
        intro s₁
        calc (∏ s₂ ∈ Finset.Ioi s₁, (w i s₁ - w i s₂))
            = ∏ s₂ ∈ Finset.Ioi s₁, ((-1 : k_M) * (w i s₂ - w i s₁)) := by
              refine Finset.prod_congr rfl fun s₂ _ => by ring
          _ = (∏ _s₂ ∈ Finset.Ioi s₁, (-1 : k_M)) * (∏ s₂ ∈ Finset.Ioi s₁, (w i s₂ - w i s₁)) :=
              Finset.prod_mul_distrib
          _ = (-1 : k_M) ^ ((Finset.Ioi s₁).card) * (∏ s₂ ∈ Finset.Ioi s₁, (w i s₂ - w i s₁)) := by
              rw [Finset.prod_const]
      calc (∏ s₁ : Fin (f_i i), ∏ s₂ ∈ Finset.Ioi s₁, (w i s₁ - w i s₂))
          = ∏ s₁ : Fin (f_i i),
              ((-1 : k_M) ^ ((Finset.Ioi s₁).card) * (∏ s₂ ∈ Finset.Ioi s₁, (w i s₂ - w i s₁))) :=
            Finset.prod_congr rfl fun s₁ _ => h_inner s₁
        _ = (∏ s₁ : Fin (f_i i), (-1 : k_M) ^ ((Finset.Ioi s₁).card)) *
              (∏ s₁ : Fin (f_i i), ∏ s₂ ∈ Finset.Ioi s₁, (w i s₂ - w i s₁)) :=
            Finset.prod_mul_distrib
        _ = (-1 : k_M) ^ (e_orb i) * Δ_orb i := by
            rw [Finset.prod_pow_eq_pow_sum, h_det]
    rw [h_det, h_flip]
    ring
  have hsign_rot : ∀ (n : ℕ), 1 ≤ n →
      ((Equiv.Perm.sign (finRotate n) : ℤˣ) : k_M) = (-1 : k_M) ^ (n - 1) := by
    intro n hn
    rcases n with _ | m
    · omega
    · rw [sign_finRotate m, Nat.add_sub_cancel]
      simp
  have hΦ_vand : ∀ i : Fin r_orb,
      Φ_M.mapMatrix (Matrix.vandermonde (w i)) =
        (Matrix.vandermonde (w i)).submatrix (finRotate (f_i i)) id := by
    intro i
    ext s j
    rw [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.submatrix_apply, id_eq,
      Matrix.vandermonde_apply, Matrix.vandermonde_apply, hΦ_M_apply,
      ← pow_mul, mul_comm (j : ℕ) q_L, pow_mul, hw_frob i s]
  have hΔ_frob : ∀ i : Fin r_orb, (Δ_orb i) ^ (q_L - 1) = (-1 : k_M) ^ (f_i i - 1) := by
    intro i
    have hq : (Δ_orb i) ^ q_L = (-1 : k_M) ^ (f_i i - 1) * Δ_orb i := by
      calc (Δ_orb i) ^ q_L
          = Φ_M (Δ_orb i) := (hΦ_M_apply (Δ_orb i)).symm
        _ = (Φ_M.mapMatrix (Matrix.vandermonde (w i))).det :=
            RingHom.map_det Φ_M (Matrix.vandermonde (w i))
        _ = ((Matrix.vandermonde (w i)).submatrix (finRotate (f_i i)) id).det :=
            congrArg Matrix.det (hΦ_vand i)
        _ = ((Equiv.Perm.sign (finRotate (f_i i)) : ℤˣ) : k_M) * Δ_orb i :=
            Matrix.det_permute (finRotate (f_i i)) (Matrix.vandermonde (w i))
        _ = (-1 : k_M) ^ (f_i i - 1) * Δ_orb i := by
            rw [hsign_rot (f_i i) (hf_pos i)]
    apply mul_right_cancel₀ (hΔ_ne i)
    rw [← pow_succ, Nat.sub_add_cancel (by omega : 1 ≤ q_L)]
    exact hq

  
  let R_orb : Fin r_orb → Fin r_orb → k_M := fun i₁ i₂ =>
    ∏ s₁ : Fin (f_i i₁), ∏ s₂ : Fin (f_i i₂), (w i₁ s₁ - w i₂ s₂)
  have hR_ne : ∀ i₁ i₂ : Fin r_orb, i₁ ≠ i₂ → R_orb i₁ i₂ ≠ 0 := by
    intro i₁ i₂ hne
    dsimp only [R_orb]
    rw [Finset.prod_ne_zero_iff]
    intro s₁ _
    rw [Finset.prod_ne_zero_iff]
    intro s₂ _
    rw [sub_ne_zero]
    intro h_eq
    have h_sig : (⟨i₁, s₁⟩ : Σ i : Fin r_orb, Fin (f_i i)) = ⟨i₂, s₂⟩ := hw_inj h_eq
    exact hne (congrArg Sigma.fst h_sig)
  have hR_symm : ∀ i₁ i₂ : Fin r_orb,
      R_orb i₂ i₁ = (-1 : k_M) ^ ((f_i i₁) * (f_i i₂)) * R_orb i₁ i₂ := by
    intro i₁ i₂
    dsimp only [R_orb]
    rw [Finset.prod_comm]
    have h_inner : ∀ s₁ : Fin (f_i i₁),
        (∏ s₂ : Fin (f_i i₂), (w i₂ s₂ - w i₁ s₁)) =
          (-1 : k_M) ^ (f_i i₂) * (∏ s₂ : Fin (f_i i₂), (w i₁ s₁ - w i₂ s₂)) := by
      intro s₁
      calc (∏ s₂ : Fin (f_i i₂), (w i₂ s₂ - w i₁ s₁))
          = ∏ s₂ : Fin (f_i i₂), ((-1 : k_M) * (w i₁ s₁ - w i₂ s₂)) := by
            refine Finset.prod_congr rfl fun s₂ _ => by ring
        _ = (∏ _s₂ : Fin (f_i i₂), (-1 : k_M)) * (∏ s₂ : Fin (f_i i₂), (w i₁ s₁ - w i₂ s₂)) :=
            Finset.prod_mul_distrib
        _ = (-1 : k_M) ^ (f_i i₂) * (∏ s₂ : Fin (f_i i₂), (w i₁ s₁ - w i₂ s₂)) := by
            rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    calc (∏ s₁ : Fin (f_i i₁), ∏ s₂ : Fin (f_i i₂), (w i₂ s₂ - w i₁ s₁))
        = ∏ s₁ : Fin (f_i i₁),
            ((-1 : k_M) ^ (f_i i₂) * (∏ s₂ : Fin (f_i i₂), (w i₁ s₁ - w i₂ s₂))) :=
          Finset.prod_congr rfl fun s₁ _ => h_inner s₁
      _ = (∏ _s₁ : Fin (f_i i₁), (-1 : k_M) ^ (f_i i₂)) *
            (∏ s₁ : Fin (f_i i₁), ∏ s₂ : Fin (f_i i₂), (w i₁ s₁ - w i₂ s₂)) :=
          Finset.prod_mul_distrib
      _ = (-1 : k_M) ^ ((f_i i₁) * (f_i i₂)) *
            (∏ s₁ : Fin (f_i i₁), ∏ s₂ : Fin (f_i i₂), (w i₁ s₁ - w i₂ s₂)) := by
          rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin, ← pow_mul,
            mul_comm (f_i i₂) (f_i i₁)]
  let R_prod : k_M := ∏ i₁ : Fin r_orb, ∏ i₂ ∈ Finset.Ioi i₁, R_orb i₁ i₂
  have hR_prod_ne : R_prod ≠ 0 := by
    dsimp only [R_prod]
    rw [Finset.prod_ne_zero_iff]
    intro i₁ _
    rw [Finset.prod_ne_zero_iff]
    intro i₂ hi₂
    rw [Finset.mem_Ioi] at hi₂
    exact hR_ne i₁ i₂ (ne_of_lt hi₂)
  have hR_sq_cross :
      (∏ i₁ : Fin r_orb, ∏ i₂ ∈ Finset.univ.erase i₁, R_orb i₁ i₂) =
        (-1 : k_M) ^ E_cross * R_prod ^ 2 := by
    rw [h_offdiag_prod R_orb]
    have h_flip :
        (∏ i₁ : Fin r_orb, ∏ i₂ ∈ Finset.Ioi i₁, R_orb i₂ i₁) =
          (-1 : k_M) ^ E_cross * R_prod := by
      have h_inner : ∀ i₁ : Fin r_orb,
          (∏ i₂ ∈ Finset.Ioi i₁, R_orb i₂ i₁) =
            (-1 : k_M) ^ (∑ i₂ ∈ Finset.Ioi i₁, (f_i i₁) * (f_i i₂)) *
              (∏ i₂ ∈ Finset.Ioi i₁, R_orb i₁ i₂) := by
        intro i₁
        calc (∏ i₂ ∈ Finset.Ioi i₁, R_orb i₂ i₁)
            = ∏ i₂ ∈ Finset.Ioi i₁, ((-1 : k_M) ^ ((f_i i₁) * (f_i i₂)) * R_orb i₁ i₂) :=
              Finset.prod_congr rfl fun i₂ _ => hR_symm i₁ i₂
          _ = (∏ i₂ ∈ Finset.Ioi i₁, (-1 : k_M) ^ ((f_i i₁) * (f_i i₂))) *
                (∏ i₂ ∈ Finset.Ioi i₁, R_orb i₁ i₂) := Finset.prod_mul_distrib
          _ = (-1 : k_M) ^ (∑ i₂ ∈ Finset.Ioi i₁, (f_i i₁) * (f_i i₂)) *
                (∏ i₂ ∈ Finset.Ioi i₁, R_orb i₁ i₂) := by
              rw [Finset.prod_pow_eq_pow_sum]
      calc (∏ i₁ : Fin r_orb, ∏ i₂ ∈ Finset.Ioi i₁, R_orb i₂ i₁)
          = ∏ i₁ : Fin r_orb,
              ((-1 : k_M) ^ (∑ i₂ ∈ Finset.Ioi i₁, (f_i i₁) * (f_i i₂)) *
                (∏ i₂ ∈ Finset.Ioi i₁, R_orb i₁ i₂)) :=
            Finset.prod_congr rfl fun i₁ _ => h_inner i₁
        _ = (∏ i₁ : Fin r_orb, (-1 : k_M) ^ (∑ i₂ ∈ Finset.Ioi i₁, (f_i i₁) * (f_i i₂))) *
              R_prod := Finset.prod_mul_distrib
        _ = (-1 : k_M) ^ E_cross * R_prod := by
            rw [Finset.prod_pow_eq_pow_sum]
    change ((∏ i₁ : Fin r_orb, ∏ i₂ ∈ Finset.Ioi i₁, R_orb i₂ i₁) * R_prod) = _
    rw [h_flip]
    ring
  have hR_frob : ∀ i₁ i₂ : Fin r_orb, i₁ ≠ i₂ → (R_orb i₁ i₂) ^ (q_L - 1) = 1 := by
    intro i₁ i₂ hne
    have hq : (R_orb i₁ i₂) ^ q_L = R_orb i₁ i₂ := by
      calc (R_orb i₁ i₂) ^ q_L
          = Φ_M (R_orb i₁ i₂) := (hΦ_M_apply (R_orb i₁ i₂)).symm
        _ = ∏ s₁ : Fin (f_i i₁), ∏ s₂ : Fin (f_i i₂), (Φ_M (w i₁ s₁) - Φ_M (w i₂ s₂)) := by
            dsimp only [R_orb]
            rw [map_prod]
            refine Finset.prod_congr rfl fun s₁ _ => ?_
            rw [map_prod]
            refine Finset.prod_congr rfl fun s₂ _ => map_sub Φ_M _ _
        _ = ∏ s₁ : Fin (f_i i₁), ∏ s₂ : Fin (f_i i₂),
              (w i₁ (finRotate (f_i i₁) s₁) - w i₂ (finRotate (f_i i₂) s₂)) := by
            refine Finset.prod_congr rfl fun s₁ _ =>
              Finset.prod_congr rfl fun s₂ _ => by
                rw [hΦ_M_apply, hΦ_M_apply, hw_frob i₁ s₁, hw_frob i₂ s₂]
        _ = ∏ s₁ : Fin (f_i i₁), ∏ s₂ : Fin (f_i i₂), (w i₁ (finRotate (f_i i₁) s₁) - w i₂ s₂) := by
            refine Finset.prod_congr rfl fun s₁ _ => ?_
            exact Equiv.prod_comp (finRotate (f_i i₂)) (fun s₂ => w i₁ (finRotate (f_i i₁) s₁) - w i₂ s₂)
        _ = R_orb i₁ i₂ :=
            Equiv.prod_comp (finRotate (f_i i₁))
              (fun s₁ => ∏ s₂ : Fin (f_i i₂), (w i₁ s₁ - w i₂ s₂))
    apply mul_right_cancel₀ (hR_ne i₁ i₂ hne)
    rw [← pow_succ, Nat.sub_add_cancel (by omega : 1 ≤ q_L), one_mul]
    exact hq
  have hR_prod_frob : R_prod ^ (q_L - 1) = 1 := by
    dsimp only [R_prod]
    rw [← Finset.prod_pow]
    refine Finset.prod_eq_one fun i₁ _ => ?_
    rw [← Finset.prod_pow]
    refine Finset.prod_eq_one fun i₂ hi₂ => ?_
    rw [Finset.mem_Ioi] at hi₂
    exact hR_frob i₁ i₂ (ne_of_lt hi₂)

  
  let Δ_prod : k_M := ∏ i : Fin r_orb, Δ_orb i
  have hΔ_prod_ne : Δ_prod ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr fun i _ => hΔ_ne i
  let D_all : k_M := Δ_prod * R_prod
  have hD_all_ne : D_all ≠ 0 := mul_ne_zero hΔ_prod_ne hR_prod_ne
  have h_const_prod : ∀ (c : k_M),
      (∏ i₀ : Fin r_orb, ∏ _s₀ : Fin (f_i i₀), c) = c ^ u := by
    intro c
    calc (∏ i₀ : Fin r_orb, ∏ _s₀ : Fin (f_i i₀), c)
        = ∏ i₀ : Fin r_orb, c ^ (f_i i₀) := by
          refine Finset.prod_congr rfl fun i₀ _ => ?_
          rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      _ = c ^ (∑ i₀ : Fin r_orb, f_i i₀) := Finset.prod_pow_eq_pow_sum Finset.univ f_i c
      _ = c ^ u := by rw [hu_sum]
  have h_within_all :
      (∏ i₀ : Fin r_orb, ∏ s₀ : Fin (f_i i₀), ∏ s ∈ Finset.univ.erase s₀, (w i₀ s₀ - w i₀ s)) =
        (-1 : k_M) ^ E_within * Δ_prod ^ 2 := by
    calc (∏ i₀ : Fin r_orb, ∏ s₀ : Fin (f_i i₀), ∏ s ∈ Finset.univ.erase s₀, (w i₀ s₀ - w i₀ s))
        = ∏ i₀ : Fin r_orb, ((-1 : k_M) ^ (e_orb i₀) * (Δ_orb i₀) ^ 2) :=
          Finset.prod_congr rfl fun i₀ _ => hΔ_sq_within i₀
      _ = (∏ i₀ : Fin r_orb, (-1 : k_M) ^ (e_orb i₀)) * (∏ i₀ : Fin r_orb, (Δ_orb i₀) ^ 2) :=
          Finset.prod_mul_distrib
      _ = (-1 : k_M) ^ E_within * Δ_prod ^ 2 := by
          rw [Finset.prod_pow_eq_pow_sum, ← Finset.prod_pow]
  have h_cross_all :
      (∏ i₀ : Fin r_orb, ∏ s₀ : Fin (f_i i₀),
        ∏ i ∈ Finset.univ.erase i₀, ∏ s : Fin (f_i i), (w i₀ s₀ - w i s)) =
        (-1 : k_M) ^ E_cross * R_prod ^ 2 := by
    have h_inner : ∀ i₀ : Fin r_orb,
        (∏ s₀ : Fin (f_i i₀), ∏ i ∈ Finset.univ.erase i₀, ∏ s : Fin (f_i i), (w i₀ s₀ - w i s)) =
          ∏ i ∈ Finset.univ.erase i₀, R_orb i₀ i := by
      intro i₀
      exact Finset.prod_comm
    calc (∏ i₀ : Fin r_orb, ∏ s₀ : Fin (f_i i₀),
          ∏ i ∈ Finset.univ.erase i₀, ∏ s : Fin (f_i i), (w i₀ s₀ - w i s))
        = ∏ i₀ : Fin r_orb, ∏ i ∈ Finset.univ.erase i₀, R_orb i₀ i :=
          Finset.prod_congr rfl fun i₀ _ => h_inner i₀
      _ = (-1 : k_M) ^ E_cross * R_prod ^ 2 := hR_sq_cross
  have h_cof_prod :
      (k : k_M) ^ u * (ι_res P_ξ) * (-1 : k_M) ^ E_total * D_all ^ 2 =
        (-1 : k_M) ^ (u * u) * (ι_res P_ξ) ^ u := by
    have h_lhs :
        (∏ i₀ : Fin r_orb, ∏ s₀ : Fin (f_i i₀),
          ((k : k_M) * (w i₀ s₀) *
            (∏ s ∈ Finset.univ.erase s₀, (w i₀ s₀ - w i₀ s)) *
            (∏ i ∈ Finset.univ.erase i₀, ∏ s : Fin (f_i i), (w i₀ s₀ - w i s)))) =
          (k : k_M) ^ u * (ι_res P_ξ) * (-1 : k_M) ^ E_total * D_all ^ 2 := by
      simp only [Finset.prod_mul_distrib]
      rw [h_const_prod (k : k_M), hw_prod, h_within_all, h_cross_all]
      dsimp only [E_total, D_all]
      rw [pow_add]
      ring
    have h_rhs :
        (∏ i₀ : Fin r_orb, ∏ _s₀ : Fin (f_i i₀), ((-1 : k_M) ^ u * ι_res P_ξ)) =
          (-1 : k_M) ^ (u * u) * (ι_res P_ξ) ^ u := by
      rw [h_const_prod ((-1 : k_M) ^ u * ι_res P_ξ), mul_pow, ← pow_mul]
    have h_eq :
        (∏ i₀ : Fin r_orb, ∏ s₀ : Fin (f_i i₀),
          ((k : k_M) * (w i₀ s₀) *
            (∏ s ∈ Finset.univ.erase s₀, (w i₀ s₀ - w i₀ s)) *
            (∏ i ∈ Finset.univ.erase i₀, ∏ s : Fin (f_i i), (w i₀ s₀ - w i s)))) =
        (∏ i₀ : Fin r_orb, ∏ _s₀ : Fin (f_i i₀), ((-1 : k_M) ^ u * ι_res P_ξ)) :=
      Finset.prod_congr rfl fun i₀ _ => Finset.prod_congr rfl fun s₀ _ => hw_cofactor i₀ s₀
    rw [← h_lhs, h_eq, h_rhs]
  have hP_ξ_M_ne : ι_res P_ξ ≠ 0 := by
    have h := ι_res.injective.ne hP_ξ_ne
    rwa [map_zero] at h
  have h_cof_cancel :
      (k : k_M) ^ u * (-1 : k_M) ^ E_total * D_all ^ 2 =
        (-1 : k_M) ^ (u * u) * (ι_res P_ξ) ^ (u - 1) := by
    apply mul_left_cancel₀ hP_ξ_M_ne
    have h_pow_u : (ι_res P_ξ) * (ι_res P_ξ) ^ (u - 1) = (ι_res P_ξ) ^ u := by
      rw [← pow_succ', Nat.sub_add_cancel hu_pos]
    calc (ι_res P_ξ) * ((k : k_M) ^ u * (-1 : k_M) ^ E_total * D_all ^ 2)
        = (k : k_M) ^ u * (ι_res P_ξ) * (-1 : k_M) ^ E_total * D_all ^ 2 := by ring
      _ = (-1 : k_M) ^ (u * u) * (ι_res P_ξ) ^ u := h_cof_prod
      _ = (-1 : k_M) ^ (u * u) * ((ι_res P_ξ) * (ι_res P_ξ) ^ (u - 1)) := by rw [← h_pow_u]
      _ = (ι_res P_ξ) * ((-1 : k_M) ^ (u * u) * (ι_res P_ξ) ^ (u - 1)) := by ring
  have h_neg1_2E : (-1 : k_M) ^ E_total * (-1 : k_M) ^ E_total = 1 := by
    rw [← pow_add, ← two_mul, pow_mul, neg_one_sq, one_pow]
  have h_neg1_u_sq :
      (-1 : k_M) ^ (u * u) * (-1 : k_M) ^ E_total = (-1 : k_M) ^ (u * (u + 1) / 2) := by
    rw [h_u_sq, pow_add, pow_mul (-1 : k_M) 2 E_total, neg_one_sq, one_pow, mul_one,
      ← pow_add, add_comm u E_total, h_E_tri]
  have h_D_sq_eq :
      D_all ^ 2 * (ι_res (k : k_L)) ^ u =
        (ι_res (-1 : k_L)) ^ (u * (u + 1) / 2) * (ι_res P_ξ) ^ (u - 1) := by
    rw [map_natCast, map_neg, map_one]
    calc D_all ^ 2 * (k : k_M) ^ u
        = D_all ^ 2 * (k : k_M) ^ u * ((-1 : k_M) ^ E_total * (-1 : k_M) ^ E_total) := by
          rw [h_neg1_2E, mul_one]
      _ = ((k : k_M) ^ u * (-1 : k_M) ^ E_total * D_all ^ 2) * (-1 : k_M) ^ E_total := by ring
      _ = ((-1 : k_M) ^ (u * u) * (ι_res P_ξ) ^ (u - 1)) * (-1 : k_M) ^ E_total := by
          rw [h_cof_cancel]
      _ = ((-1 : k_M) ^ (u * u) * (-1 : k_M) ^ E_total) * (ι_res P_ξ) ^ (u - 1) := by ring
      _ = (-1 : k_M) ^ (u * (u + 1) / 2) * (ι_res P_ξ) ^ (u - 1) := by rw [h_neg1_u_sq]
  have hk_L_ne : (k : k_L) ≠ 0 := by
    intro hk0
    have h_rhs_ne :
        (ι_res (-1 : k_L)) ^ (u * (u + 1) / 2) * (ι_res P_ξ) ^ (u - 1) ≠ 0 := by
      refine mul_ne_zero (pow_ne_zero _ ?_) (pow_ne_zero _ hP_ξ_M_ne)
      rw [map_neg, map_one]
      exact neg_ne_zero.mpr one_ne_zero
    apply h_rhs_ne
    rw [← h_D_sq_eq, hk0, map_zero, zero_pow (by omega : u ≠ 0), mul_zero]
  have hD_frob : D_all ^ (q_L - 1) = (-1 : k_M) ^ (u - r_orb) := by
    dsimp only [D_all, Δ_prod]
    rw [mul_pow, hR_prod_frob, mul_one, ← Finset.prod_pow]
    calc (∏ i : Fin r_orb, (Δ_orb i) ^ (q_L - 1))
        = ∏ i : Fin r_orb, (-1 : k_M) ^ (f_i i - 1) :=
          Finset.prod_congr rfl fun i _ => hΔ_frob i
      _ = (-1 : k_M) ^ (∑ i : Fin r_orb, (f_i i - 1)) :=
          Finset.prod_pow_eq_pow_sum Finset.univ (fun i => f_i i - 1) (-1 : k_M)
      _ = (-1 : k_M) ^ (u - r_orb) := by rw [h_sum_sub1]
  have h_euler : ∀ a : k_L, (ι_res a) ^ (q_L / 2) = ((quadraticChar k_L a : ℤ) : k_M) := by
    intro a
    change (ι_res a) ^ (Fintype.card k_L / 2) = _
    rw [← map_pow, ← quadraticChar_eq_pow_of_char_ne_two' hring_ne2 a, map_intCast]
  have h_pow_half :
      (-1 : k_M) ^ (u - r_orb) * (((quadraticChar k_L (k : k_L) : ℤ) : k_M)) ^ u =
        (((quadraticChar k_L (-1) : ℤ) : k_M)) ^ (u * (u + 1) / 2) *
          (((quadraticChar k_L P_ξ : ℤ) : k_M)) ^ (u - 1) := by
    calc (-1 : k_M) ^ (u - r_orb) * (((quadraticChar k_L (k : k_L) : ℤ) : k_M)) ^ u
        = (D_all ^ 2 * (ι_res (k : k_L)) ^ u) ^ (q_L / 2) := by
          rw [mul_pow, ← pow_mul, hqL_div2, hD_frob, ← pow_mul, mul_comm u (q_L / 2),
            pow_mul, h_euler (k : k_L)]
      _ = ((ι_res (-1 : k_L)) ^ (u * (u + 1) / 2) * (ι_res P_ξ) ^ (u - 1)) ^ (q_L / 2) := by
          rw [h_D_sq_eq]
      _ = (((quadraticChar k_L (-1) : ℤ) : k_M)) ^ (u * (u + 1) / 2) *
            (((quadraticChar k_L P_ξ : ℤ) : k_M)) ^ (u - 1) := by
          rw [mul_pow, ← pow_mul, mul_comm (u * (u + 1) / 2) (q_L / 2), pow_mul, h_euler (-1),
            ← pow_mul, mul_comm (u - 1) (q_L / 2), pow_mul, h_euler P_ξ]
  let s₁ : ℤ := (-1 : ℤ) ^ (u - r_orb) * (quadraticChar k_L (k : k_L)) ^ u
  let s₂ : ℤ := (quadraticChar k_L (-1)) ^ (u * (u + 1) / 2) * (quadraticChar k_L P_ξ) ^ (u - 1)
  have hcast_s : (s₁ : k_M) = (s₂ : k_M) := by
    dsimp only [s₁, s₂]
    push_cast
    exact h_pow_half
  have h_quad_k_sq : ((quadraticChar k_L (k : k_L)) ^ u) ^ 2 = 1 := by
    rw [← pow_mul, mul_comm u 2, pow_mul, ← map_pow, quadraticChar_sq_one' hk_L_ne, one_pow]
  have hs₁_sq : s₁ ^ 2 = 1 := by
    dsimp only [s₁]
    rw [mul_pow, ← pow_mul, mul_comm (u - r_orb) 2, pow_mul, neg_one_sq, one_pow, one_mul,
      h_quad_k_sq]
  have hs₂_sq : s₂ ^ 2 = 1 := by
    dsimp only [s₂]
    have h_neg1_ne : (-1 : k_L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
    rw [mul_pow, ← pow_mul, mul_comm (u * (u + 1) / 2) 2, pow_mul, ← map_pow,
      quadraticChar_sq_one' h_neg1_ne, one_pow, one_mul,
      ← pow_mul, mul_comm (u - 1) 2, pow_mul, ← map_pow,
      quadraticChar_sq_one' hP_ξ_ne, one_pow]
  have hs_eq : s₁ = s₂ := by
    rcases sq_eq_one_iff.mp hs₁_sq with h1 | h1 <;>
      rcases sq_eq_one_iff.mp hs₂_sq with h2 | h2
    · rw [h1, h2]
    · exfalso
      rw [h1, h2, Int.cast_one, Int.cast_neg, Int.cast_one] at hcast_s
      have h20 : (2 : k_M) = 0 := by linear_combination hcast_s
      exact h2_kM h20
    · exfalso
      rw [h1, h2, Int.cast_neg, Int.cast_one] at hcast_s
      have h20 : (2 : k_M) = 0 := by linear_combination -hcast_s
      exact h2_kM h20
    · rw [h1, h2]
  calc (-1 : ℤ) ^ (u - r_orb)
      = s₁ * (quadraticChar k_L (k : k_L)) ^ u := by
        dsimp only [s₁]
        rw [mul_assoc, ← sq, h_quad_k_sq, mul_one]
    _ = s₂ * (quadraticChar k_L (k : k_L)) ^ u := by rw [hs_eq]
    _ = (quadraticChar k_L (-1)) ^ (u * (u + 1) / 2) *
          (quadraticChar k_L (k : k_L)) ^ u *
          (quadraticChar k_L P_ξ) ^ (u - 1) := by
        dsimp only [s₂]
        ring

theorem ld_ch14_odd_p_pigeonhole_vandermonde_master_sign (F : Type u) [Field F]
