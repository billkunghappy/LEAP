          rcases hpd with h0 | hge
          · exact Or.inl h0
          · right
            have hj2 : (2 : ℤ) ≤ (j : ℤ) := by exact_mod_cast hj_bounds.1
            have hq1 : (1 : ℤ) ≤ (q₀ : ℤ) := by exact_mod_cast hq₀_ge1
