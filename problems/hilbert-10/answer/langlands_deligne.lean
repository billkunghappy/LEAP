      (fun w => (⟨1, E, hF'E, χE⟩ : MonomialTerm F F').trace F F' w) D_F' := by
    refine ⟨?_, ?_⟩
    · intro s hs
      rw [List.mem_map] at hs
      rcases hs with ⟨j, _, rfl⟩
