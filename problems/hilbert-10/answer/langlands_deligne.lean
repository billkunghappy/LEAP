    obtain ⟨hresDeg_MC_pos, hdiv_MC⟩ := hrelVal_div M_C hval_surj_MC
    obtain ⟨hresDeg_K_pos, hdiv_K⟩ := hrelVal_div K hval_surj_K
    have hfMC_int_ne : (resDeg F M_C : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hresDeg_MC_pos)
    set K_MC' := IntermediateField.extendScalars hM_CK
    set ℓ := Module.finrank M_C K_MC'
    have hrelVal_norm : ∀ y : K, relVal F M_C (normLM F hM_CK y) = relVal F K y := by
