      apply hval_sum_ge
      intro r hr
      simp only [Finset.mem_Icc] at hr
      apply hval_sum_ge
      intro j hj
      simp only [Finset.mem_Icc] at hj
      have h3 := h3fac_val r j (p - r - j)
        (by simp only [Finset.mem_Icc]; omega)
        (by simp only [Finset.mem_Icc]; omega)
        (by omega)
      have hmul := hval_mul_ge 0 (T : ℤ) ((-1 : L) ^ (r + j))
        (s x r * s x j * traceLM F hLE' (x ^ (p - r - j)))
        (hval_neg1_pow (r + j)) h3
      rw [zero_add] at hmul
      have hassoc :
          (-1 : L) ^ (r + j) * s x r * s x j * traceLM F hLE' (x ^ (p - r - j)) =
            (-1 : L) ^ (r + j) * (s x r * s x j * traceLM F hLE' (x ^ (p - r - j))) := by ring
      rwa [hassoc]
    have hnewton_val :
        traceLM F hLE' (x ^ p) - (p : L) * A = 0 ∨
          (T : ℤ) ≤ valL F L (traceLM F hLE' (x ^ p) - (p : L) * A) := by
      have hn2 : traceLM F hLE' (x ^ p) - (p : L) * A =
          - (p : L) * (∑ r ∈ Finset.Icc 1 ((p - 1) / 2), s x r * s x (p - r)) +
            ∑ r ∈ Finset.Icc 1 (p - 1),
