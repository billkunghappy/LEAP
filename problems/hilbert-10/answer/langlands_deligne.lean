          rw [h_id2]
          exact N₁.mul_mem (N₁.inv_mem hxyc_N₁) hmc_N₁
        have hy_M : y ∈ M := by
          have h_id : y = x⁻¹ * (x * y) := by group
          rw [h_id]
          exact M.mul_mem (M.inv_mem (hN₁_le_M hx_N₁)) hm
        have hy_N₁ : y ∈ N₁ := hML_le_N₁ y hy_M hy
        exact N₁.mul_mem hx_N₁ hy_N₁
    have hFree : ∀ g ∈ H_F', ∀ c ∈ H_L', c ∉ N₁ → g * c * g⁻¹ * c⁻¹ ∈ N₁ → g ∈ N₁ := by
      intro g hg c hc hc_not hgc
