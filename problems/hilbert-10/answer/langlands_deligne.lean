theorem ld_ch13_14_semidirect_nontrivial_mackey_indCharTrace (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (G : Type u) [Group G] [Fintype G]
    (C : Subgroup G) [C.Normal] (hC_ab : ∀ a ∈ C, ∀ b ∈ C, a * b = b * a)
    (H : Subgroup G) (hG_mul : ∀ g : G, ∃ h ∈ H, ∃ c ∈ C, g = h * c) :
    ∃ (L_orb : List (Σ (M : Subgroup G), (M →* (Ω F)ˣ))),
      (∀ g : G,
        indCharTrace F H 1 g =
          indCharTrace F (⊤ : Subgroup G) 1 g +
            (L_orb.map fun p => indCharTrace F p.1 p.2 g).sum) ∧
      ∀ p ∈ L_orb,
        ∃ hC_le : C ≤ p.1,
          (∃ c : C, p.2 ⟨c.1, hC_le c.2⟩ ≠ 1) ∧
          (∀ m : p.1, ∃ c : C, p.2 m = p.2 ⟨c.1, hC_le c.2⟩) ∧
          (∀ h ∈ H, ∀ hh : h ∈ p.1, p.2 ⟨h, hh⟩ = 1) ∧
          (∀ g : G, g ∈ p.1 ↔
            ∀ (c : C) (hc : g⁻¹ * c.1 * g ∈ C),
              p.2 ⟨g⁻¹ * c.1 * g, hC_le hc⟩ = p.2 ⟨c.1, hC_le c.2⟩) :=
by
  
  letI : AddCommGroup (leftInvSpace F H) := Submodule.addCommGroup (leftInvSpace F H)
  have h_triv_sub :
      ∃ (w_triv : leftInvSpace F H) (W₀ : Submodule (Ω F) (leftInvSpace F H))
        (hW₀ : ∀ g : G, W₀ ≤ Submodule.comap (rightTransRep F H g) W₀),
        (∀ x : G, w_triv.1 x = 1) ∧
        w_triv ∈ W₀ ∧
        ∀ g : G,
          LinearMap.trace (Ω F) W₀ (subRep (rightTransRep F H) W₀ hW₀ g) =
            indCharTrace F (⊤ : Subgroup G) 1 g := by
    let w_triv : leftInvSpace F H := ⟨fun _ => 1, fun _ _ => rfl⟩
    have hw_triv_eval : ∀ x : G, w_triv.1 x = 1 := fun _ => rfl
    have hw_triv_fix : ∀ g : G, rightTransRep F H g w_triv = w_triv :=
      fun _ => Subtype.ext (funext fun _ => rfl)
    have hw_triv_ne : w_triv ≠ 0 := by
      intro h0
      have h1 : (1 : Ω F) = 0 := congr_fun (congr_arg Subtype.val h0) 1
      exact one_ne_zero h1
    let Ψ₀ : Ω F →ₗ[Ω F] leftInvSpace F H :=
      LinearMap.toSpanSingleton (Ω F) (leftInvSpace F H) w_triv
    let W₀ : Submodule (Ω F) (leftInvSpace F H) := LinearMap.range Ψ₀
    letI : AddCommGroup W₀ := Submodule.addCommGroup W₀
    have hw_triv_mem : w_triv ∈ W₀ :=
      LinearMap.mem_range.mpr ⟨1, by simp [Ψ₀]⟩
    have hΨ₀_inj : Function.Injective Ψ₀ := by
      intro a b hab
      have h1 : (Ψ₀ a).1 1 = (Ψ₀ b).1 1 := congr_fun (congr_arg Subtype.val hab) 1
      change a * w_triv.1 1 = b * w_triv.1 1 at h1
      rw [hw_triv_eval 1, mul_one, mul_one] at h1
      exact h1
    have hW₀ : ∀ g : G, W₀ ≤ Submodule.comap (rightTransRep F H g) W₀ := by
      intro g v hv
      rcases LinearMap.mem_range.mp hv with ⟨a, rfl⟩
      rw [Submodule.mem_comap]
      have h_eq : rightTransRep F H g (Ψ₀ a) = Ψ₀ a := by
        change rightTransRep F H g (a • w_triv) = a • w_triv
        rw [map_smul, hw_triv_fix g]
      rw [h_eq]
      exact LinearMap.mem_range_self Ψ₀ a
    let e₀ : Ω F ≃ₗ[Ω F] W₀ := LinearEquiv.ofInjective Ψ₀ hΨ₀_inj
    refine ⟨w_triv, W₀, hW₀, hw_triv_eval, hw_triv_mem, fun g => ?_⟩
    have h_sub_id : subRep (rightTransRep F H) W₀ hW₀ g = LinearMap.id := by
      apply LinearMap.ext
      intro v
      rcases LinearMap.mem_range.mp v.2 with ⟨a, ha⟩
      apply Subtype.ext
      change rightTransRep F H g v.1 = v.1
      rw [← ha]
      change rightTransRep F H g (a • w_triv) = a • w_triv
      rw [map_smul, hw_triv_fix g]
    have h_tr_W₀ : LinearMap.trace (Ω F) W₀ (subRep (rightTransRep F H) W₀ hW₀ g) = 1 := by
      let T₀ : Ω F →ₗ[Ω F] Ω F := e₀.symm.conj (subRep (rightTransRep F H) W₀ hW₀ g)
      have h_conj : LinearMap.trace (Ω F) W₀ (subRep (rightTransRep F H) W₀ hW₀ g) =
          LinearMap.trace (Ω F) (Ω F) T₀ :=
        (LinearMap.trace_conj' (subRep (rightTransRep F H) W₀ hW₀ g) e₀.symm).symm
      have h_conj_id : T₀ = LinearMap.id := by
        dsimp only [T₀]
        rw [h_sub_id]
        ext x
        simp
      rw [h_conj, h_conj_id, LinearMap.trace_id, Module.finrank_self, Nat.cast_one]
    have h_ind_top : indCharTrace F (⊤ : Subgroup G) 1 g = 1 := by
      unfold indCharTrace
      have h_term : ∀ x : G,
          (if h : x * g * x⁻¹ ∈ (⊤ : Subgroup G) then
            (((1 : (⊤ : Subgroup G) →* (Ω F)ˣ) ⟨x * g * x⁻¹, h⟩ : (Ω F)ˣ) : Ω F)
          else 0) = 1 := by
        intro x
        have hx : x * g * x⁻¹ ∈ (⊤ : Subgroup G) := Subgroup.mem_top _
        rw [dif_pos hx]
        simp
      have h_sum :
          (∑ x : G,
            if h : x * g * x⁻¹ ∈ (⊤ : Subgroup G) then
              (((1 : (⊤ : Subgroup G) →* (Ω F)ˣ) ⟨x * g * x⁻¹, h⟩ : (Ω F)ˣ) : Ω F)
            else 0) = (Nat.card (⊤ : Subgroup G) : Ω F) := by
        rw [Finset.sum_congr rfl fun x _ => h_term x, Finset.sum_const, Finset.card_univ,
          ← Nat.card_eq_fintype_card, Subgroup.card_top, nsmul_eq_mul, mul_one]
      rw [h_sum]
      have h_pos : 0 < Nat.card (⊤ : Subgroup G) := Nat.card_pos
      have h_ne : (Nat.card (⊤ : Subgroup G) : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr h_pos.ne'
      exact inv_mul_cancel₀ h_ne
    rw [h_tr_W₀, h_ind_top]
  
  have h_fourier_lift :
      ∀ (w_triv : leftInvSpace F H) (hw_triv : ∀ x : G, w_triv.1 x = 1)
        {Q : Type u} [AddCommGroup Q] [Module (Ω F) Q] [FiniteDimensional (Ω F) Q] [Nontrivial Q]
        (σ : Representation (Ω F) G Q)
        (π : leftInvSpace F H →ₗ[Ω F] Q) (hπ_surj : Function.Surjective π)
        (hπ_inter : ∀ g : G, π ∘ₗ rightTransRep F H g = σ g ∘ₗ π)
        (hπ_triv : π w_triv = 0),
        ∃ (lam : C → Ω F) (M_lam : Subgroup G) (hC_le : C ≤ M_lam)
          (ψ_lam : M_lam →* (Ω F)ˣ) (w_bar : Q),
          (∃ c : C, ψ_lam ⟨c.1, hC_le c.2⟩ ≠ 1) ∧
          (∀ m : M_lam, ∃ c : C, ψ_lam m = ψ_lam ⟨c.1, hC_le c.2⟩) ∧
          (∀ h ∈ H, ∀ hh : h ∈ M_lam, ψ_lam ⟨h, hh⟩ = 1) ∧
          (∀ g : G, g ∈ M_lam ↔
            ∀ (c : C) (hc : g⁻¹ * c.1 * g ∈ C),
              ψ_lam ⟨g⁻¹ * c.1 * g, hC_le hc⟩ = ψ_lam ⟨c.1, hC_le c.2⟩) ∧
          (∀ g : G, g ∈ M_lam ↔
            ∀ (c : C) (hc : g⁻¹ * c.1 * g ∈ C),
              lam ⟨g⁻¹ * c.1 * g, hc⟩ = lam c) ∧
          w_bar ≠ 0 ∧
          (∀ c : C, σ c.1 w_bar = lam c • w_bar) ∧
          (∀ k : M_lam, σ k.1 w_bar = (ψ_lam k : Ω F) • w_bar) := by
    intro w_triv hw_triv Q _ _ _ _ σ π hπ_surj hπ_inter hπ_triv
    have hC_comm : ∀ a b : C, σ a.1 ∘ₗ σ b.1 = σ b.1 ∘ₗ σ a.1 := by
      intro a b
      rw [← Module.End.mul_eq_comp, ← map_mul, hC_ab a.1 a.2 b.1 b.2, map_mul, Module.End.mul_eq_comp]
    let E : Finset C → (C → Ω F) → Submodule (Ω F) Q := fun S μ =>
      { carrier := {q : Q | ∀ c ∈ S, σ c.1 q = μ c • q}
        zero_mem' := fun c _ => by simp
        add_mem' := fun {x y} hx hy c hc => by
          change σ c.1 (x + y) = μ c • (x + y)
          rw [map_add, hx c hc, hy c hc, smul_add]
        smul_mem' := fun r {x} hx c hc => by
          change σ c.1 (r • x) = μ c • (r • x)
          rw [map_smul, hx c hc, smul_comm r (μ c)] }
    have h_fin : ∀ S : Finset C, ∃ μ : C → Ω F, E S μ ≠ ⊥ := by
      intro S
      induction' S using Finset.induction_on with b S₀ hb ih
      · obtain ⟨q₀, hq₀⟩ := exists_ne (0 : Q)
        refine ⟨0, (Submodule.ne_bot_iff _).mpr ⟨q₀, ?_, hq₀⟩⟩
        intro c hc
        simp at hc
      · rcases ih with ⟨μ₀, hW₀_ne⟩
        let W₀ := E S₀ μ₀
        have hW₀_inv : ∀ x ∈ W₀, σ b.1 x ∈ W₀ := by
          intro x hx a ha
          have h_comm : (σ a.1 ∘ₗ σ b.1) x = (σ b.1 ∘ₗ σ a.1) x := by
            rw [hC_comm a b]
          change σ a.1 (σ b.1 x) = σ b.1 (σ a.1 x) at h_comm
          have hxa : σ a.1 x = μ₀ a • x := hx a ha
          change σ a.1 (σ b.1 x) = μ₀ a • σ b.1 x
          rw [h_comm, hxa, map_smul]
        haveI : Nontrivial W₀ := Submodule.nontrivial_iff_ne_bot.mpr hW₀_ne
        let f_b : W₀ →ₗ[Ω F] W₀ := (σ b.1).restrict hW₀_inv
        obtain ⟨r, hr⟩ := Module.End.exists_eigenvalue f_b
        obtain ⟨w, hw_mem, hw_ne⟩ := hr.exists_hasEigenvector
        have hw_eq : f_b w = r • w := Module.End.mem_eigenspace_iff.mp hw_mem
        have h_bw : σ b.1 w.1 = r • w.1 := congr_arg Subtype.val hw_eq
        have hw_val_ne : w.1 ≠ 0 := fun h0 => hw_ne (Subtype.ext h0)
        let μ : C → Ω F := Function.update μ₀ b r
        refine ⟨μ, (Submodule.ne_bot_iff _).mpr ⟨w.1, ?_, hw_val_ne⟩⟩
        intro a ha
        change σ a.1 w.1 = μ a • w.1
        rcases Finset.mem_insert.mp ha with rfl | ha_S₀
        · dsimp only [μ]
          rw [Function.update_self]
          exact h_bw
        · have hab : a ≠ b := fun h => hb (h ▸ ha_S₀)
          dsimp only [μ]
          rw [Function.update_of_ne hab]
          exact w.2 a ha_S₀
    obtain ⟨lam, h_ne_bot⟩ := h_fin Finset.univ
    obtain ⟨q₀, hq₀_mem, hq₀_ne⟩ := (Submodule.ne_bot_iff _).mp h_ne_bot
    have hq₀_eig : ∀ c : C, σ c.1 q₀ = lam c • q₀ := fun c => hq₀_mem c (Finset.mem_univ c)
    have h_smul_inj : ∀ r₁ r₂ : Ω F, r₁ • q₀ = r₂ • q₀ → r₁ = r₂ := by
      intro r₁ r₂ h_eq
      have h_sub : (r₁ - r₂) • q₀ = 0 := by rw [sub_smul, h_eq, sub_self]
      exact sub_eq_zero.mp ((smul_eq_zero.mp h_sub).resolve_right hq₀_ne)
    have hlam_one : lam 1 = 1 := by
      apply h_smul_inj
      rw [← hq₀_eig 1, Subgroup.coe_one, map_one, Module.End.one_apply, one_smul]
    have hlam_mul : ∀ a b : C, lam (a * b) = lam a * lam b := by
      intro a b
      apply h_smul_inj
      rw [← hq₀_eig (a * b), Subgroup.coe_mul, map_mul, Module.End.mul_apply,
        hq₀_eig b, map_smul, hq₀_eig a, smul_smul, mul_comm]
    have hlam_inv_mul : ∀ c : C, lam c⁻¹ * lam c = 1 := by
      intro c
      rw [← hlam_mul c⁻¹ c, inv_mul_cancel, hlam_one]
    obtain ⟨v₀, hv₀⟩ := hπ_surj q₀
    let w : leftInvSpace F H :=
      (Nat.card C : Ω F)⁻¹ • ∑ c : C, lam c⁻¹ • rightTransRep F H c.1 v₀
    have h_pi_term : ∀ c : C, π (lam c⁻¹ • rightTransRep F H c.1 v₀) = q₀ := by
      intro c
      have h_inter : π (rightTransRep F H c.1 v₀) = σ c.1 (π v₀) :=
