  rcases hvalM₁'_props with
    ⟨hval0_M₁', hval1_M₁', hval_neg1_M₁', hval_neg_M₁', hval_mul_M₁', hval_inv_M₁',
      _, hval_add_M₁', _, hunit_ge1_M₁', hunit_val0_M₁'⟩
  let P_L : ℤ → L → Prop := fun k u => u = 0 ∨ k ≤ valL F L u
  have hPL_mono : ∀ {k₁ k₂ : ℤ}, k₁ ≤ k₂ → ∀ {u : L}, P_L k₂ u → P_L k₁ u := by
    intro k₁ k₂ hk u hu
    rcases hu with rfl | hu
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have hPL_neg : ∀ {k : ℤ} {u : L}, P_L k u → P_L k (-u) := by
    intro k u hu
    rcases hu with rfl | hu
    · rw [neg_zero]; exact Or.inl rfl
    · right; rwa [hval_neg_L]
  have hPL_add : ∀ {k : ℤ} {u v : L}, P_L k u → P_L k v → P_L k (u + v) :=
