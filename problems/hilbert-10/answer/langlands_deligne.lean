    have ha_ge0 : 0 ≤ valL F A (Nat.gcdA j p : A) :=
      (hval_int_A (Nat.gcdA j p)).resolve_left ha_ne0
    have hj_val0 : valL F A ((j : ℕ) : A) = 0 := by omega
    let uj : Aˣ := Units.mk0 ((j : ℕ) : A) hj_ne0
    have huj_inv : valL F A (((j : ℕ) : A)⁻¹) = 0 := by
      have h := hval_inv_A uj
      simpa [uj, hj_val0] using h
