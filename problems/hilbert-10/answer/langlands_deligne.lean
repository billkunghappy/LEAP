  haveI : FiniteDimensional F K_χg := Module.Finite.equiv ϕ_Kχ.toLinearEquiv
  have hMgKχg : M_g ≤ K_χg := by
    rintro y ⟨x, hx, rfl⟩
    exact ⟨x, hFtKχ hx, rfl⟩
  have hKχgK : K_χg ≤ K := by
    rintro y ⟨x, hx, rfl⟩
    exact helper_galois_map_mem K hLK hGal γ hγL x (hKχK hx)
  have h_fix_map : ∀ (E : IntermediateField F (AlgebraicClosure F)) (τ : AbsGal F),
      τ ∈ (E.map (γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)).fixingSubgroup ↔
        γ⁻¹ * τ * γ ∈ E.fixingSubgroup := by
    intro E τ
    rw [IntermediateField.mem_fixingSubgroup_iff, IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro hτ x hx
      have hγx : (γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) x ∈
          E.map (γ : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) := ⟨x, hx, rfl⟩
      have h1 : τ (γ x) = γ x := hτ (γ x) hγx
      change γ⁻¹ (τ (γ x)) = x
      rw [h1]
      exact γ.symm_apply_apply x
    · rintro hτ y ⟨x, hx, rfl⟩
      have h1 : γ⁻¹ (τ (γ x)) = x := hτ x hx
      change τ (γ x) = γ x
      calc τ (γ x) = γ (γ⁻¹ (τ (γ x))) := (γ.apply_symm_apply (τ (γ x))).symm
        _ = γ x := congrArg (⇑γ) h1
  have hGalMgK : IsGaloisExt F M_g K :=
    ((ld_galois_closure_directed_system F).2.1 L M_g K hLMg hMgK hGal).1
  have hSepMgKχg : Algebra.IsSeparable M_g (IntermediateField.extendScalars hMgKχg) :=
    h_sep_sub M_g K_χg K hMgK hMgKχg hKχgK (hGalMgK.2.2.2 hMgK)
  have hAbMgKχg : IsAbelianExt F hMgKχg := by
    refine ⟨?_, ?_, hSepMgKχg⟩
    · intro α hα β hβ
      rw [h_fix_map t.field α] at hα
      rw [h_fix_map K_χ β] at hβ
      rw [h_fix_map K_χ (α * β * α⁻¹)]
      have h_grp : γ⁻¹ * (α * β * α⁻¹) * γ =
          (γ⁻¹ * α * γ) * (γ⁻¹ * β * γ) * (γ⁻¹ * α * γ)⁻¹ := by group
      rw [h_grp]
      exact hAbFtKχ.1 (γ⁻¹ * α * γ) hα (γ⁻¹ * β * γ) hβ
    · intro α hα β hβ
      rw [h_fix_map t.field α] at hα
      rw [h_fix_map t.field β] at hβ
      rw [h_fix_map K_χ (α * β * α⁻¹ * β⁻¹)]
      have h_grp : γ⁻¹ * (α * β * α⁻¹ * β⁻¹) * γ =
          (γ⁻¹ * α * γ) * (γ⁻¹ * β * γ) * (γ⁻¹ * α * γ)⁻¹ * (γ⁻¹ * β * γ)⁻¹ := by group
      rw [h_grp]
      exact hAbFtKχ.2.1 (γ⁻¹ * α * γ) hα (γ⁻¹ * β * γ) hβ
  have hχg_ker_Kχg : ∀ u : relWeil F M_g,
      (u : AbsGal F) ∈ K_χg.fixingSubgroup ↔ χ_g u = 1 := by
    intro u
    rw [h_fix_map K_χ (u : AbsGal F)]
    exact hχ_ker_Kχ (conjHom_g u)
  let S_χt := IntermediateField.extendScalars hFtKχ
  let S_χg := IntermediateField.extendScalars hMgKχg
  let e₂_χ : S_χt ≃+* S_χg :=
    { toFun := fun x =>
        ⟨(ϕ_Kχ ⟨x.1, (IntermediateField.mem_extendScalars hFtKχ).mp x.2⟩).1,
          (IntermediateField.mem_extendScalars hMgKχg).mpr
            (ϕ_Kχ ⟨x.1, (IntermediateField.mem_extendScalars hFtKχ).mp x.2⟩).2⟩
      invFun := fun y =>
        ⟨(ϕ_Kχ.symm ⟨y.1, (IntermediateField.mem_extendScalars hMgKχg).mp y.2⟩).1,
          (IntermediateField.mem_extendScalars hFtKχ).mpr
            (ϕ_Kχ.symm ⟨y.1, (IntermediateField.mem_extendScalars hMgKχg).mp y.2⟩).2⟩
      left_inv := fun x => Subtype.ext (congrArg Subtype.val (ϕ_Kχ.symm_apply_apply ⟨x.1, _⟩))
      right_inv := fun y => Subtype.ext (congrArg Subtype.val (ϕ_Kχ.apply_symm_apply ⟨y.1, _⟩))
      map_mul' := fun x y => Subtype.ext (congrArg Subtype.val (map_mul ϕ_Kχ ⟨x.1, _⟩ ⟨y.1, _⟩))
      map_add' := fun x y => Subtype.ext (congrArg Subtype.val (map_add ϕ_Kχ ⟨x.1, _⟩ ⟨y.1, _⟩)) }
  have h_comm_Kχ : (algebraMap M_g S_χg).comp (e₁ : t.field →+* M_g) =
      (e₂_χ : S_χt →+* S_χg).comp (algebraMap t.field S_χt) := by
    apply RingHom.ext
    intro m
    apply Subtype.ext
    change ((ϕ_g m : M_g) : AlgebraicClosure F) =
      ((ϕ_Kχ ⟨m.1, hFtKχ m.2⟩ : K_χg) : AlgebraicClosure F)
    rw [IntermediateField.coe_equivMap_apply, IntermediateField.coe_equivMap_apply]
  have hμ_ker_imp : ∀ z₀ : t.fieldˣ,
      μ' z₀ = 1 → μ'_g (Units.map ϕ_g.toRingEquiv.toMonoidHom z₀) = 1 := by
    intro z₀ hz₀
    rw [hμ'_rec z₀, ← hχ_ker_Kχ (rec.recMap t.field z₀),
      rec.ker_rec t.field K_χ hFtKχ hAbFtKχ z₀] at hz₀
    rcases hz₀ with ⟨y, hy⟩
    have hy_norm : normLM F hMgKχg (ϕ_Kχ y) = ϕ_g (z₀ : t.field) := by
      have h_norm_eq : Algebra.norm t.field (toExtendScalars F hFtKχ y) =
          e₁.symm (Algebra.norm M_g (e₂_χ (toExtendScalars F hFtKχ y))) :=
        Algebra.norm_eq_of_equiv_equiv e₁ e₂_χ h_comm_Kχ (toExtendScalars F hFtKχ y)
      have he₂_y : e₂_χ (toExtendScalars F hFtKχ y) = toExtendScalars F hMgKχg (ϕ_Kχ y) := rfl
      have h1 : normLM F hFtKχ y = e₁.symm (normLM F hMgKχg (ϕ_Kχ y)) := by
        change Algebra.norm t.field (toExtendScalars F hFtKχ y) = _
        rw [h_norm_eq, he₂_y]
        rfl
      rw [hy] at h1
      calc normLM F hMgKχg (ϕ_Kχ y) = e₁ (e₁.symm (normLM F hMgKχg (ϕ_Kχ y))) :=
            (e₁.apply_symm_apply _).symm
        _ = ϕ_g (z₀ : t.field) := congrArg (⇑e₁) h1.symm
    let z₀_g : M_gˣ := Units.map ϕ_g.toRingEquiv.toMonoidHom z₀
    have hz₀_g_mem : (z₀_g : M_g) ∈ Set.range (normLM F hMgKχg) := ⟨ϕ_Kχ y, hy_norm⟩
    have hz₀_g_fix : (rec.recMap M_g z₀_g : AbsGal F) ∈ K_χg.fixingSubgroup :=
      (rec.ker_rec M_g K_χg hMgKχg hAbMgKχg z₀_g).mpr hz₀_g_mem
    rw [hμ'_g_rec z₀_g]
    exact (hχg_ker_Kχg (rec.recMap M_g z₀_g)).mp hz₀_g_fix
  have hex_w₀ : ∃ w₀ : M_Cˣ, μ' (Units.map (normLM F htMC) w₀) ≠ 1 := by
    by_contra h_all
    push_neg at h_all
    apply hμ_comp_ne1
    exact MonoidHom.ext h_all
  obtain ⟨w₀, hw₀⟩ := hex_w₀
  let x₀ : t.fieldˣ := Units.map (normLM F htMC) w₀
  let ζ : Ω F := (μ' x₀ : Ω F)
  have hζ_ne1 : ζ ≠ 1 := fun h => hw₀ (Units.ext h)
  have hμ'_pow_apply : ∀ z : t.fieldˣ, (μ' z) ^ (p F) = 1 := by
    intro z
    change ((μ' ^ (p F)) z) = 1
    rw [hμ_pow, MonoidHom.one_apply]
  have hζ_pow : ζ ^ (p F) = 1 := by
    change ((μ' x₀ : Ω F) ^ (p F)) = 1
    rw [← Units.val_pow_eq_pow_val, hμ'_pow_apply x₀, Units.val_one]
  have hζ_prim : IsPrimitiveRoot ζ (p F) :=
    IsPrimitiveRoot.iff_orderOf.mpr (orderOf_eq_prime hζ_pow hζ_ne1)
  haveI : NeZero (p F) := ⟨hp.ne_zero⟩
  have hμ_eq_all : ∀ z : t.fieldˣ,
      μ'_g (Units.map ϕ_g.toRingEquiv.toMonoidHom z) = μ' z := by
    intro z
    have hz_pow : (μ' z : Ω F) ^ (p F) = 1 := by
      rw [← Units.val_pow_eq_pow_val, hμ'_pow_apply z, Units.val_one]
    obtain ⟨k, _, hk⟩ := hζ_prim.eq_pow_of_pow_eq_one hz_pow
    have hx₀_k : μ' (x₀ ^ k) = μ' z := by
      apply Units.ext
      rw [map_pow, Units.val_pow_eq_pow_val]
      exact hk
    let z₀ : t.fieldˣ := z * (x₀ ^ k)⁻¹
    have hz₀_ker : μ' z₀ = 1 := by
      dsimp [z₀]
      rw [map_mul, map_inv, hx₀_k, mul_inv_cancel]
    have hz₀_g : μ'_g (Units.map ϕ_g.toRingEquiv.toMonoidHom z₀) = 1 := hμ_ker_imp z₀ hz₀_ker
    have hz_decomp : z = z₀ * x₀ ^ k := by
      dsimp [z₀]
      exact (inv_mul_cancel_right z (x₀ ^ k)).symm
    have hx₀_g : μ'_g (Units.map ϕ_g.toRingEquiv.toMonoidHom x₀) = μ' x₀ := hμ_MC_eq w₀
    calc μ'_g (Units.map ϕ_g.toRingEquiv.toMonoidHom z)
        = μ'_g (Units.map ϕ_g.toRingEquiv.toMonoidHom (z₀ * x₀ ^ k)) := by rw [← hz_decomp]
      _ = μ'_g (Units.map ϕ_g.toRingEquiv.toMonoidHom z₀) *
            (μ'_g (Units.map ϕ_g.toRingEquiv.toMonoidHom x₀)) ^ k := by
          rw [map_mul, map_pow, map_mul, map_pow]
      _ = 1 * (μ' x₀) ^ k := by rw [hz₀_g, hx₀_g]
      _ = μ' (x₀ ^ k) := by rw [one_mul, map_pow]
      _ = μ' z := hx₀_k
  
  have hWeil_mul : ∀ (M : IntermediateField F (AlgebraicClosure F))
      {χ₁ χ₂ : relWeil F M →* (Ω F)ˣ},
      IsWeilRep F M (charRep F M χ₁) → IsWeilRep F M (charRep F M χ₂) →
      IsWeilRep F M (charRep F M (χ₁ * χ₂)) := by
    rintro M χ₁ χ₂ ⟨hfin, U₁, hU₁, htriv₁⟩ ⟨_, U₂, hU₂, htriv₂⟩
    refine ⟨hfin, U₁ ∩ U₂, Filter.inter_mem hU₁ hU₂, fun w hw hwI => ?_⟩
    have hmul : charRep F M (χ₁ * χ₂) w = charRep F M χ₁ w * charRep F M χ₂ w := by
      apply LinearMap.ext
      intro v
      change ((χ₁ * χ₂) w : Ω F) • v = (χ₁ w : Ω F) • ((χ₂ w : Ω F) • v)
      rw [MonoidHom.mul_apply, Units.val_mul, mul_smul]
    rw [hmul, htriv₁ w hw.1 hwI, htriv₂ w hw.2 hwI, mul_one]
  have hWeil_rest : ∀ {M₁ M₂ : IntermediateField F (AlgebraicClosure F)} (hM : M₁ ≤ M₂)
      {χ : relWeil F M₁ →* (Ω F)ˣ},
      IsWeilRep F M₁ (charRep F M₁ χ) →
      IsWeilRep F M₂ (charRep F M₂ (restrictWeilChar F hM χ)) := by
    rintro M₁ M₂ hM χ ⟨hfin, U, hU, htriv⟩
    refine ⟨hfin, U, hU, fun w hwU hwI => ?_⟩
    exact htriv (Subgroup.inclusion (relWeil_antitone F hM) w) hwU hwI
  set χ' := recChar F rec L χL_ext
  obtain ⟨χ₀', hχ₀'_rec, _, hχ₀'_sep⟩ := hSepRec_all L χL_ext hχL_ext
  have hχ'_eq : χ' = χ₀' := (htateEps L ψ hψ χL_ext hχL_ext χ₀' hχ₀'_rec).1
  have hχ'_Ft_rec : ∀ z : t.fieldˣ,
      (χ'.comp (Units.map (normLM F t.le))) z =
        (restrictWeilChar F t.le χL_ext) (rec.recMap t.field z) := by
    rw [hχ'_eq]; exact (hχ₀'_sep t.field t.le hSepLFt).1
  have hχ'_Mg_rec : ∀ y : M_gˣ,
      (χ'.comp (Units.map (normLM F hLMg))) y =
        (restrictWeilChar F hLMg χL_ext) (rec.recMap M_g y) := by
    rw [hχ'_eq]; exact (hχ₀'_sep M_g hLMg hSepLMg).1
  have ht_tw_weil :
      IsWeilRep F t.field (charRep F t.field (t.χ * restrictWeilChar F t.le χL_ext)) :=
    hWeil_mul t.field ht_weil (hWeil_rest t.le hχL_ext)
  have hμ'_tw_rec : ∀ z : t.fieldˣ,
      (μ' * χ'.comp (Units.map (normLM F t.le))) z =
        (t.χ * restrictWeilChar F t.le χL_ext) (rec.recMap t.field z) := by
    intro z
    rw [MonoidHom.mul_apply, MonoidHom.mul_apply, hμ'_rec z, hχ'_Ft_rec z]
  have hμ'_tw_eq :
      recChar F rec t.field (t.χ * restrictWeilChar F t.le χL_ext) =
        μ' * χ'.comp (Units.map (normLM F t.le)) :=
    (htateEps t.field (traceChar F t.le ψ) hψ_Ft (t.χ * restrictWeilChar F t.le χL_ext)
      ht_tw_weil (μ' * χ'.comp (Units.map (normLM F t.le))) hμ'_tw_rec).1
  have hμ'_tw_cond : ∀ u ∈ unitGroup F t.field
      (condExp F t.field (recChar F rec t.field (t.χ * restrictWeilChar F t.le χL_ext))),
      (recChar F rec t.field (t.χ * restrictWeilChar F t.le χL_ext)) u = 1 := by
    rw [hμ'_tw_eq]
    exact hWeil_unit_triv t.field (t.χ * restrictWeilChar F t.le χL_ext) ht_tw_weil
      (μ' * χ'.comp (Units.map (normLM F t.le))) hμ'_tw_rec
  have hrest_LMg_eq :
      restrictWeilChar F hF'Mg (restrictWeilChar F hLF' χL_ext) =
        restrictWeilChar F hLMg χL_ext := rfl
  have hχg_tw_weil :
      IsWeilRep F M_g
        (charRep F M_g (χ_g * restrictWeilChar F hF'Mg (restrictWeilChar F hLF' χL_ext))) := by
    rw [hrest_LMg_eq]
    exact hWeil_mul M_g hχg_weil (hWeil_rest hLMg hχL_ext)
  have hμ'_g_tw_rec : ∀ y : M_gˣ,
      (μ'_g * χ'.comp (Units.map (normLM F hLMg))) y =
        (χ_g * restrictWeilChar F hF'Mg (restrictWeilChar F hLF' χL_ext)) (rec.recMap M_g y) := by
    intro y
    rw [hrest_LMg_eq, MonoidHom.mul_apply, MonoidHom.mul_apply, hμ'_g_rec y, hχ'_Mg_rec y]
  have hμ'_g_tw_eq :
      recChar F rec M_g (χ_g * restrictWeilChar F hF'Mg (restrictWeilChar F hLF' χL_ext)) =
        μ'_g * χ'.comp (Units.map (normLM F hLMg)) :=
    (htateEps M_g (traceChar F hLMg ψ) hψ_Mg
      (χ_g * restrictWeilChar F hF'Mg (restrictWeilChar F hLF' χL_ext))
      hχg_tw_weil (μ'_g * χ'.comp (Units.map (normLM F hLMg))) hμ'_g_tw_rec).1
  have hμ_tw_eq_all : ∀ z : t.fieldˣ,
      (recChar F rec M_g (χ_g * restrictWeilChar F hF'Mg (restrictWeilChar F hLF' χL_ext)))
        (Units.map ϕ_g.toRingEquiv.toMonoidHom z) =
        (recChar F rec t.field (t.χ * restrictWeilChar F t.le χL_ext)) z := by
    intro z
    rw [hμ'_g_tw_eq, hμ'_tw_eq, MonoidHom.mul_apply, MonoidHom.mul_apply,
      MonoidHom.comp_apply, MonoidHom.comp_apply, hμ_eq_all z, hnormLM_L_ϕg z]
  exact ⟨hF'Mg, χ_g, hχ_g_apply, hFinMg, htg_wf, hMgK, hψ_Ft, htraceChar_ϕg,
    hμ'_cond, hμ_eq_all, hμ'_tw_cond, hμ_tw_eq_all⟩

theorem ld_ch14_normal_subfield_indLM_trace_coset_decomp (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L F' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L]
    (hLF' : L ≤ F') (hGalF' : IsGaloisExt F L F')
    (q₀ : ℕ) (hFinF' : Module.finrank L (IntermediateField.extendScalars hLF') = q₀)
    (t : MonomialTerm F L) (htWf : t.Wf F L) (ht_coeff : t.coeff = 1)
    (hF't : F' ≤ t.field)
    (hF'Mg : ∀ g : relWeil F L,
      F' ≤ t.field.map ((g : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F))
    (χ_conj : ∀ g : relWeil F L,
      relWeil F (t.field.map ((g : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)) →* (Ω F)ˣ)
    (hχ_conj : ∀ (g : relWeil F L)
      (u : relWeil F (t.field.map ((g : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)))
      (hu : (g : AbsGal F)⁻¹ * (u : AbsGal F) * (g : AbsGal F) ∈ relWeil F t.field),
      χ_conj g u = t.χ ⟨(g : AbsGal F)⁻¹ * (u : AbsGal F) * (g : AbsGal F), hu⟩) :
    ∃ g_rep : Fin q₀ → relWeil F L,
      ∀ w : relWeil F F',
        t.trace F L (Subgroup.inclusion (relWeil_antitone F hLF') w) =
          monomialListTrace F F'
            (List.ofFn (fun j : Fin q₀ =>
              (⟨1, t.field.map ((g_rep j : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F),
                hF'Mg (g_rep j), χ_conj (g_rep j)⟩ : MonomialTerm F F'))) w :=
by
  have hFinQuot : ∀ (L' M' : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M']
      (h' : L' ≤ M'), Finite (relWeil F L' ⧸ (relWeil F M').subgroupOf (relWeil F L')) := by
    intro L' M' _ h'
    let E' := IntermediateField.extendScalars h'
    let e_F : M' ≃ₐ[F] E' :=
      { toFun := toExtendScalars F h'
        invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars h').mp y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl }
    haveI : FiniteDimensional F E' := Module.Finite.equiv e_F.toLinearEquiv
    haveI : IsScalarTower F L' E' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional L' E' := Module.Finite.of_restrictScalars_finite F L' E'
    letI : Fintype (E' →ₐ[L'] AlgebraicClosure F) :=
      minpoly.AlgHom.fintype L' E' (AlgebraicClosure F)
    let G_L' := relWeil F L'
    let H_ML' := (relWeil F M').subgroupOf G_L'
    let res : G_L' ⧸ H_ML' → (E' →ₐ[L'] AlgebraicClosure F) := fun u =>
      { toFun := fun x => ((cosetRep u : G_L') : AbsGal F) x.1
        map_one' := map_one ((cosetRep u : G_L') : AbsGal F)
        map_mul' := fun x y => map_mul ((cosetRep u : G_L') : AbsGal F) x.1 y.1
        map_zero' := map_zero ((cosetRep u : G_L') : AbsGal F)
        map_add' := fun x y => map_add ((cosetRep u : G_L') : AbsGal F) x.1 y.1
        commutes' := fun r => (cosetRep u).2.2 r }
    have hinj : Function.Injective res := by
      intro u₁ u₂ h_eq
      let g₁ : G_L' := cosetRep u₁
      let g₂ : G_L' := cosetRep u₂
      have h_mem : g₁⁻¹ * g₂ ∈ H_ML' := by
        rw [Subgroup.mem_subgroupOf]
        refine ⟨(g₁⁻¹ * g₂).2.1, ?_⟩
        intro y
        let y_E : E' := ⟨y.1, (IntermediateField.mem_extendScalars h').mpr y.2⟩
        have hy : (g₁ : AbsGal F) y.1 = (g₂ : AbsGal F) y.1 := AlgHom.congr_fun h_eq y_E
        change ((g₁ : AbsGal F)⁻¹ * (g₂ : AbsGal F)) y.1 = y.1
        rw [AlgEquiv.mul_apply, ← hy, ← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]
      have hq : (g₁ : G_L' ⧸ H_ML') = (g₂ : G_L' ⧸ H_ML') := QuotientGroup.eq.mpr h_mem
      have h1 : (g₁ : G_L' ⧸ H_ML') = u₁ := Quotient.out_eq u₁
      have h2 : (g₂ : G_L' ⧸ H_ML') = u₂ := Quotient.out_eq u₂
      rw [← h1, ← h2, hq]
    exact Finite.of_injective res hinj
  have hFrob : ∀ {G : Type u} [Group G] (H : Subgroup G) [Fintype (G ⧸ H)]
      {W : Type u} [AddCommGroup W] [Module (Ω F) W] [FiniteDimensional (Ω F) W]
      (ρ : Representation (Ω F) H W),
      FiniteDimensional (Ω F) (indSpace H ρ) ∧
      ∀ g : G,
        LinearMap.trace (Ω F) (indSpace H ρ) (indRep H ρ g) =
          ∑ u₀ : G ⧸ H,
            if h_mem : (cosetRep u₀)⁻¹ * g * cosetRep u₀ ∈ H then
              LinearMap.trace (Ω F) W (ρ ⟨(cosetRep u₀)⁻¹ * g * cosetRep u₀, h_mem⟩)
            else 0 := by
    intro G _ H _ W _ _ _ ρ
    let u : G → G ⧸ H := fun x => QuotientGroup.mk x⁻¹
    let r : G → G := fun x => cosetRep (u x)
    have h_xr_mem : ∀ x : G, x * r x ∈ H := by
      intro x
