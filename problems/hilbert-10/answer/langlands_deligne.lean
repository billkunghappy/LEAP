          γ⁻¹ * h * γ ∈ K_t ⊓ N₁) ∧
        ∀ (w_B : relWeil F S_tγ)
          (hm : γ.1⁻¹ * π (Subgroup.inclusion (relWeil_antitone F hLS_tγ) w_B) * γ.1 ∈ M_Kt),
          χ_tγ w_B =
            ψ'_t ⟨γ.1⁻¹ * π (Subgroup.inclusion (relWeil_antitone F hLS_tγ) w_B) * γ.1, hm⟩ := by
    intro γ
    obtain ⟨g_γ, hπ_γ⟩ := hsurj γ.1
    have hg_γ_E : (g_γ : AbsGal F) ∈ E.fixingSubgroup :=
      ((h_mem_H g_γ).mpr (by rw [hπ_γ]; exact γ.2)).2
    have hπ_γ_inv : ∀ x : K',
        (g_γ : AbsGal F)⁻¹ (x : AlgebraicClosure F) = ((γ.1⁻¹ x : K') : AlgebraicClosure F) := by
      intro x
      have h1 := hπ g_γ (γ.1⁻¹ x)
      have h2 : π g_γ (γ.1⁻¹ x) = x := by
        rw [hπ_γ]
        exact AlgEquiv.apply_symm_apply γ.1 x
      rw [h2] at h1
      exact (congrArg (fun z : AlgebraicClosure F => (g_γ : AbsGal F)⁻¹ z) h1).trans
        ((g_γ : AbsGal F).symm_apply_apply ((γ.1⁻¹ x : K') : AlgebraicClosure F))
    let S_tγ : IntermediateField F (AlgebraicClosure F) :=
      S_t.map ((g_γ : AbsGal F) : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)
    obtain ⟨hLS_tγ, hS_tγMC, χ_tγ,
        hχ_tγ_apply, hS_tγ_mem, _, hχ_tγ_pow, hχ_tγ_restK, hχ_tγ_restE, hχ_tγ_neMC,
        heps_tγ_un, heps_tγ_tw⟩ :=
      hConjEval S_t hLS_t hS_tMC χ_St hχ_St_weil hχ_St_pow hχ_St_restK hχ_St_restE hχ_St_neMC
        g_γ hg_γ_E
    have hM₁_Stγ : M₁ ≤ S_tγ := by
      intro z hz
      have hz_K : z ∈ K := hM_CK (hS_tMC (hM₁S_t hz))
      let x : K' := ⟨z, (IntermediateField.mem_extendScalars hLK).mpr hz_K⟩
      rw [hS_tγ_mem z]
      change (g_γ : AbsGal F)⁻¹ (x : AlgebraicClosure F) ∈ S_t
      rw [hπ_γ_inv x]
      apply hM₁S_t
      rw [h_fix_M₁ (γ.1⁻¹ x)]
      intro h hh c hc
      let h' : H := γ * h * γ⁻¹
      let c' : G := γ.1 * c * γ.1⁻¹
      have hc' : c' ∈ C := ‹C.Normal›.conj_mem c hc γ.1
      have hfix_x : (h'.1 * c') x = x :=
        (h_fix_M₁ x).mp hz h' (hN₁_norm.conj_mem h hh γ) c' hc'
      have hmul_eq : h'.1 * c' = γ.1 * (h.1 * c) * γ.1⁻¹ := by
        change (γ.1 * h.1 * γ.1⁻¹) * (γ.1 * c * γ.1⁻¹) = γ.1 * (h.1 * c) * γ.1⁻¹
        group
      rw [hmul_eq] at hfix_x
      change γ.1 ((h.1 * c) (γ.1⁻¹ x)) = x at hfix_x
      exact (AlgEquiv.symm_apply_apply γ.1 ((h.1 * c) (γ.1⁻¹ x))).symm.trans
        (congrArg (fun y : K' => γ.1⁻¹ y) hfix_x)
    have hStγ_fix_iff : ∀ h : H,
        (∀ x : K', (x : AlgebraicClosure F) ∈ S_tγ → h.1 x = x) ↔ γ⁻¹ * h * γ ∈ K_t ⊓ N₁ := by
      intro h
      rw [← hSt_fix_iff (γ⁻¹ * h * γ)]
      constructor
      · intro hh y hy
        let x : K' := γ.1 y
        have hx_inv : γ.1⁻¹ x = y := AlgEquiv.symm_apply_apply γ.1 y
        have hx : (x : AlgebraicClosure F) ∈ S_tγ := by
          rw [hS_tγ_mem (x : AlgebraicClosure F), hπ_γ_inv x, hx_inv]
          exact hy
        have hhx : h.1 x = x := hh x hx
        change (γ.1⁻¹ * h.1 * γ.1) y = y
        change γ.1⁻¹ (h.1 x) = y
        rw [hhx, hx_inv]
      · intro hh x hx
        let y : K' := γ.1⁻¹ x
        have hy_inv : γ.1 y = x := AlgEquiv.apply_symm_apply γ.1 x
        have hy : (y : AlgebraicClosure F) ∈ S_t := by
          rw [← hπ_γ_inv x]
          exact (hS_tγ_mem (x : AlgebraicClosure F)).mp hx
        have hhy : (γ⁻¹ * h * γ).1 y = y := hh y hy
        change γ.1⁻¹ (h.1 (γ.1 y)) = y at hhy
        rw [hy_inv] at hhy
        exact (AlgEquiv.apply_symm_apply γ.1 (h.1 x)).symm.trans
          ((congrArg (fun z : K' => γ.1 z) hhy).trans hy_inv)
    have hχ_tγ_eq : ∀ (w_B : relWeil F S_tγ)
        (hm : γ.1⁻¹ * π (Subgroup.inclusion (relWeil_antitone F hLS_tγ) w_B) * γ.1 ∈ M_Kt),
        χ_tγ w_B =
          ψ'_t ⟨γ.1⁻¹ * π (Subgroup.inclusion (relWeil_antitone F hLS_tγ) w_B) * γ.1, hm⟩ := by
      intro w_B hm
      have hw_S : (g_γ : AbsGal F)⁻¹ * (w_B : AbsGal F) * (g_γ : AbsGal F) ∈ relWeil F S_t :=
        ⟨(weilGroup F).mul_mem ((weilGroup F).mul_mem ((weilGroup F).inv_mem g_γ.2.1) w_B.2.1) g_γ.2.1,
          (IntermediateField.mem_fixingSubgroup_iff S_t _).mpr fun y hy => by
            let z : AlgebraicClosure F := (g_γ : AbsGal F) y
            have hinv_y : (g_γ : AbsGal F)⁻¹ z = y :=
              (g_γ : AbsGal F).symm_apply_apply y
            have hz : z ∈ S_tγ := (hS_tγ_mem z).mpr (hinv_y.symm ▸ hy)
            have hwz : (w_B : AbsGal F) z = z :=
              (IntermediateField.mem_fixingSubgroup_iff S_tγ (w_B : AbsGal F)).mp w_B.2.2 z hz
            change (g_γ : AbsGal F)⁻¹ ((w_B : AbsGal F) z) = y
            rw [hwz]
            exact hinv_y⟩
      let w_S : relWeil F S_t := ⟨(g_γ : AbsGal F)⁻¹ * (w_B : AbsGal F) * (g_γ : AbsGal F), hw_S⟩
      have hinc_eq : Subgroup.inclusion (relWeil_antitone F hLS_t) w_S =
          g_γ⁻¹ * Subgroup.inclusion (relWeil_antitone F hLS_tγ) w_B * g_γ := by
        apply Subtype.ext
        rfl
      have hπ_wS : π (Subgroup.inclusion (relWeil_antitone F hLS_t) w_S) =
          γ.1⁻¹ * π (Subgroup.inclusion (relWeil_antitone F hLS_tγ) w_B) * γ.1 := by
        rw [hinc_eq, map_mul, map_mul, map_inv, hπ_γ]
      have hm_S : π (Subgroup.inclusion (relWeil_antitone F hLS_t) w_S) ∈ M_Kt := by
        rw [hπ_wS]
        exact hm
      rw [hχ_tγ_apply w_B hw_S, hχ_St_eq w_S hm_S]
      exact congrArg ψ'_t (Subtype.ext hπ_wS)
    exact ⟨S_tγ, hLS_tγ, hM₁_Stγ, hS_tγMC, χ_tγ,
      hχ_tγ_pow, hχ_tγ_restK, hχ_tγ_restE, hχ_tγ_neMC,
      heps_tγ_un, heps_tγ_tw, hStγ_fix_iff, hχ_tγ_eq⟩
  have hSubTrace : ∀ (A B : IntermediateField F (AlgebraicClosure F))
      (hLA : L ≤ A) (hAB : A ≤ B) (hBMC : B ≤ M_C)
      (H_A : Subgroup H),
      (∀ w : relWeil F L,
        w ∈ (relWeil F A).subgroupOf (relWeil F L) ↔ ∃ h ∈ H_A, ∃ c ∈ C, π w = h.1 * c) →
      ∀ (γ : H) (χ_B : relWeil F B →* (Ω F)ˣ),
        restrictWeilChar F (hBMC.trans hM_CK) χ_B = 1 →
        (∀ h : H,
          (∀ x : K', (x : AlgebraicClosure F) ∈ B → h.1 x = x) ↔
          γ⁻¹ * h * γ ∈ K_t ⊓ N₁) →
        (∀ (w_B : relWeil F B)
          (hm : γ.1⁻¹ * π (Subgroup.inclusion (relWeil_antitone F (hLA.trans hAB)) w_B) * γ.1 ∈ M_Kt),
          χ_B w_B =
            ψ'_t ⟨γ.1⁻¹ * π (Subgroup.inclusion (relWeil_antitone F (hLA.trans hAB)) w_B) * γ.1, hm⟩) →
        (⟨1, B, hAB, χ_B⟩ : MonomialTerm F A).Wf F A ∧
        ∀ w : relWeil F A,
          let g := π (Subgroup.inclusion (relWeil_antitone F hLA) w)
          (∀ y : H_A,
            (γ⁻¹ * y.1).1 * g * (γ⁻¹ * y.1).1⁻¹ ∈ M_Kt ↔
              γ⁻¹ * y.1 * (projH g) * y.1⁻¹ * γ ∈ K_t ⊓ N₁) →
          (⟨1, B, hAB, χ_B⟩ : MonomialTerm F A).trace F A w =
            (Nat.card ↥(K_t ⊓ N₁) : Ω F)⁻¹ *
              ∑ y : H_A,
                if hm : (γ⁻¹ * y.1).1 * g * (γ⁻¹ * y.1).1⁻¹ ∈ M_Kt then
                  (ψ'_t ⟨(γ⁻¹ * y.1).1 * g * (γ⁻¹ * y.1).1⁻¹, hm⟩ : Ω F)
                else 0 := by
    intro A B hLA hAB hBMC H_A h_mem_A γ χ_B hχ_B_restK hB_fix_iff hχ_B_eq
    have hprojH_conj : ∀ (u : H) (m : G), projH (u.1⁻¹ * m * u.1) = u⁻¹ * projH m * u := by
      intro u m
      rw [map_mul, map_mul, ← Subgroup.coe_inv, hprojH_id, hprojH_id]
    have h_proj_A : ∀ w : relWeil F L,
        w ∈ (relWeil F A).subgroupOf (relWeil F L) ↔ projH (π w) ∈ H_A :=
      fun w => (h_mem_A w).trans (hprojH_sub H_A (π w)).symm
    obtain ⟨H_B, M_B, ψ_B, hs_wf, _, hHB_mem, _, hMB_mem, hWB_mem, hχB_eq, hs_tr⟩ :=
      hTraceH A B hLA hAB hBMC H_A h_proj_A χ_B hχ_B_restK
    have hHB_iff : ∀ h : H, h ∈ H_B ↔ γ⁻¹ * h * γ ∈ K_t ⊓ N₁ :=
      fun h => (hHB_mem h).trans (hB_fix_iff h)
    let e_HB : H_B ≃ ↥(K_t ⊓ N₁) :=
      { toFun := fun h => ⟨γ⁻¹ * h.1 * γ, (hHB_iff h.1).mp h.2⟩
        invFun := fun k => ⟨γ * k.1 * γ⁻¹, (hHB_iff (γ * k.1 * γ⁻¹)).mpr (by
          have h1 : γ⁻¹ * (γ * k.1 * γ⁻¹) * γ = k.1 := by group
          rw [h1]
          exact k.2)⟩
        left_inv := fun h => by apply Subtype.ext; group
        right_inv := fun k => by apply Subtype.ext; group }
    have hCard_HB : Nat.card H_B = Nat.card ↥(K_t ⊓ N₁) := Nat.card_congr e_HB
    have hMB_iff : ∀ m : G, m ∈ M_B ↔ γ⁻¹ * projH m * γ ∈ K_t ⊓ N₁ :=
      fun m => (hMB_mem m).trans (hHB_iff (projH m))
    have hψB_eq : ∀ (m : G) (hm_B : m ∈ M_B) (hm_K : γ.1⁻¹ * m * γ.1 ∈ M_Kt),
        ψ_B ⟨m, hm_B⟩ = ψ'_t ⟨γ.1⁻¹ * m * γ.1, hm_K⟩ := by
      intro m hm_B hm_K
      obtain ⟨w₀, hπ₀⟩ := hsurj m
      have hw₀_B : w₀ ∈ (relWeil F B).subgroupOf (relWeil F L) :=
        (hWB_mem w₀).mpr (by rw [hπ₀]; exact hm_B)
      let w_B : relWeil F B := ⟨w₀.1, hw₀_B⟩
      have hm_B' : π (Subgroup.inclusion (relWeil_antitone F (hLA.trans hAB)) w_B) ∈ M_B := by
        change π w₀ ∈ M_B
        rw [hπ₀]
        exact hm_B
      have hm_K' : γ.1⁻¹ * π (Subgroup.inclusion (relWeil_antitone F (hLA.trans hAB)) w_B) * γ.1 ∈ M_Kt := by
        change γ.1⁻¹ * π w₀ * γ.1 ∈ M_Kt
        rw [hπ₀]
        exact hm_K
      have h1 : ψ_B ⟨m, hm_B⟩ = ψ_B ⟨π (Subgroup.inclusion (relWeil_antitone F (hLA.trans hAB)) w_B), hm_B'⟩ :=
        congrArg ψ_B (Subtype.ext hπ₀.symm)
      have h2 : ψ'_t ⟨γ.1⁻¹ * π (Subgroup.inclusion (relWeil_antitone F (hLA.trans hAB)) w_B) * γ.1, hm_K'⟩ =
          ψ'_t ⟨γ.1⁻¹ * m * γ.1, hm_K⟩ :=
        congrArg ψ'_t (Subtype.ext (by change γ.1⁻¹ * π w₀ * γ.1 = γ.1⁻¹ * m * γ.1; rw [hπ₀]))
      rw [h1, ← hχB_eq w_B hm_B', hχ_B_eq w_B hm_K', h2]
    refine ⟨hs_wf, ?_⟩
    intro w g hcond
    rw [hs_tr w, hCard_HB]
    congr 1
    apply Finset.sum_congr rfl
    intro y _
    let m : G := y.1.1 * g * y.1.1⁻¹
    have hconj_m : γ.1⁻¹ * m * γ.1 = (γ⁻¹ * y.1).1 * g * (γ⁻¹ * y.1).1⁻¹ := by
      change γ.1⁻¹ * (y.1.1 * g * y.1.1⁻¹) * γ.1 = (γ.1⁻¹ * y.1.1) * g * (γ.1⁻¹ * y.1.1)⁻¹
      group
    have hm_iff : m ∈ M_B ↔ (γ⁻¹ * y.1).1 * g * (γ⁻¹ * y.1).1⁻¹ ∈ M_Kt := by
      rw [hMB_iff m, hcond y]
      have hproj_m : projH m = y.1 * projH g * y.1⁻¹ := by
        have h := hprojH_conj y.1⁻¹ g
        rw [inv_inv, Subgroup.coe_inv, inv_inv] at h
        exact h
      rw [hproj_m]
      have hgrp : γ⁻¹ * (y.1 * projH g * y.1⁻¹) * γ = γ⁻¹ * y.1 * projH g * y.1⁻¹ * γ := by group
      rw [hgrp]
    change (if hm : m ∈ M_B then (ψ_B ⟨m, hm⟩ : Ω F) else 0) = _
    by_cases hm_B : m ∈ M_B
    · have hm_K : (γ⁻¹ * y.1).1 * g * (γ⁻¹ * y.1).1⁻¹ ∈ M_Kt := hm_iff.mp hm_B
      have hm_K0 : γ.1⁻¹ * m * γ.1 ∈ M_Kt := by rw [hconj_m]; exact hm_K
      rw [dif_pos hm_B, dif_pos hm_K]
      congr 1
      rw [hψB_eq m hm_B hm_K0]
      exact congrArg ψ'_t (Subtype.ext hconj_m)
    · have hm_K : ¬ ((γ⁻¹ * y.1).1 * g * (γ⁻¹ * y.1).1⁻¹ ∈ M_Kt) :=
        fun h => hm_B (hm_iff.mpr h)
      rw [dif_neg hm_B, dif_neg hm_K]
  choose S_tγ hLS_tγ hM₁_Stγ hS_tγMC χ_tγ
    hχ_tγ_pow hχ_tγ_restK hχ_tγ_restE hχ_tγ_neMC
    heps_tγ_un heps_tγ_tw hStγ_fix_iff hχ_tγ_eq using hConjBridge
  have hL'_Stγ : ∀ γ : H, L' ≤ S_tγ γ := fun γ => hL'M₁.trans (hM₁_Stγ γ)
  have hF'_Stγ : ∀ γ : H, F' ≤ S_tγ γ := fun γ => hF'M₁.trans (hM₁_Stγ γ)
  let s_L' : H → MonomialTerm F L' := fun γ => ⟨1, S_tγ γ, hL'_Stγ γ, χ_tγ γ⟩
  let s_F' : H → MonomialTerm F F' := fun γ => ⟨1, S_tγ γ, hF'_Stγ γ, χ_tγ γ⟩
  have hSub_L' : ∀ γ : H,
      (s_L' γ).Wf F L' ∧
      ∀ w : relWeil F L',
        let g := π (Subgroup.inclusion (relWeil_antitone F hLL') w)
        (∀ y : H_L',
          (γ⁻¹ * y.1).1 * g * (γ⁻¹ * y.1).1⁻¹ ∈ M_Kt ↔
            γ⁻¹ * y.1 * (projH g) * y.1⁻¹ * γ ∈ K_t ⊓ N₁) →
        (s_L' γ).trace F L' w =
          (Nat.card ↥(K_t ⊓ N₁) : Ω F)⁻¹ *
            ∑ y : H_L',
              if hm : (γ⁻¹ * y.1).1 * g * (γ⁻¹ * y.1).1⁻¹ ∈ M_Kt then
                (ψ'_t ⟨(γ⁻¹ * y.1).1 * g * (γ⁻¹ * y.1).1⁻¹, hm⟩ : Ω F)
              else 0 :=
    fun γ =>
      hSubTrace L' (S_tγ γ) hLL' (hL'_Stγ γ) (hS_tγMC γ) H_L' h_mem_L' γ (χ_tγ γ)
        (hχ_tγ_restK γ) (hStγ_fix_iff γ) (hχ_tγ_eq γ)
  have hSub_F' : ∀ γ : H,
      (s_F' γ).Wf F F' ∧
      ∀ w : relWeil F F',
        let g := π (Subgroup.inclusion (relWeil_antitone F hLF') w)
        (∀ y : H_F',
          (γ⁻¹ * y.1).1 * g * (γ⁻¹ * y.1).1⁻¹ ∈ M_Kt ↔
            γ⁻¹ * y.1 * (projH g) * y.1⁻¹ * γ ∈ K_t ⊓ N₁) →
        (s_F' γ).trace F F' w =
          (Nat.card ↥(K_t ⊓ N₁) : Ω F)⁻¹ *
            ∑ y : H_F',
              if hm : (γ⁻¹ * y.1).1 * g * (γ⁻¹ * y.1).1⁻¹ ∈ M_Kt then
                (ψ'_t ⟨(γ⁻¹ * y.1).1 * g * (γ⁻¹ * y.1).1⁻¹, hm⟩ : Ω F)
              else 0 :=
    fun γ =>
      hSubTrace F' (S_tγ γ) hLF' (hF'_Stγ γ) (hS_tγMC γ) H_F' h_mem_F' γ (χ_tγ γ)
        (hχ_tγ_restK γ) (hStγ_fix_iff γ) (hχ_tγ_eq γ)
  refine ⟨s_L', s_F', ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro γ
    refine ⟨(hSub_L' γ).1, rfl, hS_tγMC γ, hχ_tγ_pow γ,
      ⟨(hS_tγMC γ).trans hM_CK, hχ_tγ_restK γ⟩, hχ_tγ_restE γ, ?_⟩
    intro hsM
    exact hχ_tγ_neMC γ
  · intro γ
    exact ⟨(hSub_F' γ).1, (hS_tγMC γ).trans hM_CK⟩
  · intro γ₁ γ₂
    change (tateEpsUnit F (S_tγ γ₁) (recChar F rec (S_tγ γ₁) (χ_tγ γ₁))
          (traceChar F (hF'_Stγ γ₁) (traceChar F hLF' ψ)) * 1) ^ (1 : ℤ) =
      (tateEpsUnit F (S_tγ γ₂) (recChar F rec (S_tγ γ₂) (χ_tγ γ₂))
          (traceChar F (hL'_Stγ γ₂) (traceChar F hLL' ψ)) * 1) ^ (1 : ℤ)
    rw [mul_one, mul_one, zpow_one, zpow_one,
      ← htr_F' (S_tγ γ₁) (hF'_Stγ γ₁), ← htr_L' (S_tγ γ₂) (hL'_Stγ γ₂)]
    exact (heps_tγ_un γ₁).trans (heps_tγ_un γ₂).symm
  · intro γ₁ γ₂
    change (tateEpsUnit F (S_tγ γ₁)
          (recChar F rec (S_tγ γ₁) (χ_tγ γ₁ * restrictWeilChar F (hLS_tγ γ₁) χL_ext))
          (traceChar F (hF'_Stγ γ₁) (traceChar F hLF' ψ)) * 1) ^ (1 : ℤ) =
      (tateEpsUnit F (S_tγ γ₂)
          (recChar F rec (S_tγ γ₂) (χ_tγ γ₂ * restrictWeilChar F (hLS_tγ γ₂) χL_ext))
          (traceChar F (hL'_Stγ γ₂) (traceChar F hLL' ψ)) * 1) ^ (1 : ℤ)
    rw [mul_one, mul_one, zpow_one, zpow_one,
      ← htr_F' (S_tγ γ₁) (hF'_Stγ γ₁), ← htr_L' (S_tγ γ₂) (hL'_Stγ γ₂)]
    exact (heps_tγ_tw γ₁).trans (heps_tγ_tw γ₂).symm
  · intro γ
    exact (hSub_L' γ).2
  · intro γ
    exact (hSub_F' γ).2

theorem ld_ch14_sup_M1_conjugate_terms_trace_and_eval_iff (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E L' F' M₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    [FiniteDimensional L (IntermediateField.extendScalars hLK)]
    [IsGalois L (IntermediateField.extendScalars hLK)]
    (hLL' : L ≤ L') (hL'M₁ : L' ≤ M₁) (hM₁MC : M₁ ≤ M_C)
    (hLF' : L ≤ F') (hF'M₁ : F' ≤ M₁)
    (ψ : AddChar L (Ω F)) (χL_ext : relWeil F L →* (Ω F)ˣ)
    (htr_L' : ∀ (B : IntermediateField F (AlgebraicClosure F)) (hL'B : L' ≤ B),
      traceChar F (hLL'.trans hL'B) ψ = traceChar F hL'B (traceChar F hLL' ψ))
    (htr_F' : ∀ (B : IntermediateField F (AlgebraicClosure F)) (hF'B : F' ≤ B),
      traceChar F (hLF'.trans hF'B) ψ = traceChar F hF'B (traceChar F hLF' ψ))
    (π : relWeil F L →* (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (C H : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (hπ : ∀ (w : relWeil F L) (x : IntermediateField.extendScalars hLK),
      ((π w x : IntermediateField.extendScalars hLK) : AlgebraicClosure F) =
        (w : AbsGal F) (x : AlgebraicClosure F))
    (hsurj : Function.Surjective π)
    [C.Normal]
    (h_mem_H : ∀ w : relWeil F L, w ∈ (relWeil F E).subgroupOf (relWeil F L) ↔ π w ∈ H)
    (projH : (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK) →* H)
    (hprojH_id : ∀ h : H, projH h.1 = h)
    (hprojH_sub : ∀ (S : Subgroup H)
      (g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK),
      projH g ∈ S ↔ ∃ h ∈ S, ∃ c ∈ C, g = h.1 * c)
    (N₁ H_L' H_F' : Subgroup H)
    (hN₁_norm : N₁.Normal)
    (h_mem_L' : ∀ w : relWeil F L,
      w ∈ (relWeil F L').subgroupOf (relWeil F L) ↔ ∃ h ∈ H_L', ∃ c ∈ C, π w = h.1 * c)
    (h_mem_F' : ∀ w : relWeil F L,
      w ∈ (relWeil F F').subgroupOf (relWeil F L) ↔ ∃ h ∈ H_F', ∃ c ∈ C, π w = h.1 * c)
    (h_mem_M₁ : ∀ w : relWeil F L,
