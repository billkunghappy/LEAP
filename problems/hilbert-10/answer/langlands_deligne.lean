    have hdecomp : h₂ + T₂ = h₂ * (IntermediateField.inclusion hLE' 1 + w₂) := by
      rw [hw₂_def, map_one, mul_add, mul_one, mul_inv_cancel_left₀ hh₂_ne]
    have hnorm_w₂ : normLM F hLE' (h₂ + T₂) - β₂ =
        β₂ * (traceLM F hLE' w₂ + normLM F hLE' w₂) := by
      rw [hdecomp, map_mul, hnorm_h₂, ((hQuadNorm L E' hLE' hdeg2).2 1 w₂).1]
      ring
    obtain ⟨t, ht_def⟩ : ∃ t : L, t = traceLM F hLE' w₂ := ⟨_, rfl⟩
    obtain ⟨u₂, hu₂_def⟩ : ∃ u₂ : L, u₂ = t + normLM F hLE' w₂ := ⟨_, rfl⟩
    have ht_val : t = 0 ∨ (r : ℤ) ≤ valL F L t := by
      by_contra h_contra
      push_neg at h_contra
      rcases h_contra with ⟨ht_ne, ht_lt⟩
      obtain ⟨x₁, hx₁_ne, hx₁_val, hx₁_ψ⟩ := hSpecL.2
      obtain ⟨c, hc_def⟩ : ∃ c : L, c = x₁ * t⁻¹ := ⟨_, rfl⟩
      have hc_ne : c ≠ 0 := by rw [hc_def]; exact mul_ne_zero hx₁_ne (inv_ne_zero ht_ne)
      have hc_val : -condExpChar F L ψ - (r : ℤ) ≤ valL F L c := by
        have ht_inv : t⁻¹ = (((Units.mk0 t ht_ne)⁻¹ : Lˣ) : L) := rfl
        rw [hc_def, hvalL_mul x₁ (t⁻¹) hx₁_ne (inv_ne_zero ht_ne), ht_inv, hvalL_inv, Units.val_mk0]
        omega
      obtain ⟨y_c, hy_c_def⟩ : ∃ y_c : E', y_c = IntermediateField.inclusion hLE' c * w₂ := ⟨_, rfl⟩
      have hy_c_val : y_c = 0 ∨ -condExpChar F E' (traceChar F hLE' ψ) ≤ valL F E' y_c := by
        rcases hw₂_val with hw0 | hw_ge
        · left; rw [hy_c_def, hw0, mul_zero]
        · by_cases hw0 : w₂ = 0
          · left; rw [hy_c_def, hw0, mul_zero]
          · right
            have hinc_ne : IntermediateField.inclusion hLE' c ≠ 0 :=
              Units.ne_zero (Units.map (IntermediateField.inclusion hLE').toMonoidHom (Units.mk0 c hc_ne))
            rw [hy_c_def, hvalE'_mul _ w₂ hinc_ne hw0, hval_LE' c, hnE', hT2_eq]
            omega
      have hψ_yc : (traceChar F hLE' ψ) y_c = 1 := hSpecE' y_c hy_c_val
      have htr_yc : traceLM F hLE' y_c = x₁ := by
        rw [hy_c_def, htr_smul hLE' c w₂, ← ht_def, hc_def]
        exact inv_mul_cancel_right₀ ht_ne x₁
      have hψ_x₁ : (traceChar F hLE' ψ) y_c = ψ x₁ := by
        change ψ (traceLM F hLE' y_c) = ψ x₁
        rw [htr_yc]
      exact hx₁_ψ (hψ_x₁.symm.trans hψ_yc)
    have hnw₂_val : normLM F hLE' w₂ = 0 ∨ (r : ℤ) ≤ valL F L (normLM F hLE' w₂) := by
      rcases hw₂_val with hw0 | hw_ge
      · left; rw [hw0, hnorm_zero hLE' hdeg2]
      · right; rw [hval_normE' w₂]; exact hw_ge
    have hu₂_val : u₂ = 0 ∨ (r : ℤ) ≤ valL F L u₂ := by
      rw [hu₂_def]
      exact hvalL_ultra (r : ℤ) t (normLM F hLE' w₂) ht_val hnw₂_val
    have h1w₂_ne : (1 : E') + w₂ ≠ 0 := by
      intro h0
      have h1 : w₂ = -1 := eq_neg_of_add_eq_zero_right h0
      rcases hw₂_val with hw0 | hw_ge
      · rw [hw0] at h1; exact one_ne_zero (neg_eq_zero.mp h1.symm)
      · rw [h1, hvalE'_neg1] at hw_ge; omega
    have hnorm_1w₂ : normLM F hLE' (1 + w₂) = 1 + u₂ := by
      have heq : (1 : E') + w₂ = IntermediateField.inclusion hLE' 1 + w₂ := by rw [map_one]
      rw [heq, ((hQuadNorm L E' hLE' hdeg2).2 1 w₂).1, ← ht_def, hu₂_def]
      ring
    have hu₂_ne : 1 + u₂ ≠ 0 := by
      rw [← hnorm_1w₂]
      exact Units.ne_zero (Units.map (normLM F hLE') (Units.mk0 (1 + w₂) h1w₂_ne))
    have hν_u₂ : νE' (Units.mk0 (1 + u₂) hu₂_ne) = 1 := by
      apply (hνE'_ker (Units.mk0 (1 + u₂) hu₂_ne)).mp
      refine ⟨Units.mk0 (1 + w₂) h1w₂_ne, Units.ext ?_⟩
      exact hnorm_1w₂
    have hstat := hc_ν₂'_stat u₂ hu₂_val hu₂_ne
    rw [hν_u₂, Units.val_one] at hstat
    have harg : (((α' * (Units.mk0 (1 + 2 * d - 4 * d ^ 2 * g) hβ₂)⁻¹)⁻¹ : Lˣ) : L) * u₂ =
        ((α'⁻¹ : Lˣ) : L) * (normLM F hLE' (h₂ + T₂) - β₂) := by
      rw [hnorm_w₂, ← ht_def, ← hu₂_def, mul_inv_rev, inv_inv, Units.val_mul, Units.val_mk0, ← hβ₂_def]
      ring
    rw [← harg, ← hstat]
  rw [hh₁_def, hh₂_def, hβ₁_def, hβ₂_def] at hQuadDiff0
  rw [hh₂_def, hβ₂_def] at hQuadDiffE' hPhaseE'
  rw [hh₁_def, hβ₁_def] at hQuadDiffM₁' hPhaseM₁'
  exact ⟨hcνE'_val, hcνE'_stat, hcνM₁'_val, hcνM₁'_stat, hν_eq,
    hQuadDiff0, hQuadDiffE', hQuadDiffM₁', hPhaseE', hPhaseM₁'⟩

theorem ld_ch12_wild_dyadic_even_breaks_higher_cond_biquad_E2_transfer_and_prefactor (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
