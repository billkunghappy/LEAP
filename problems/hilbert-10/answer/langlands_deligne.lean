    have hfL_int_pos : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hfL_pos
    have hfL_int_ne : (resDeg F L : ℤ) ≠ 0 := ne_of_gt hfL_int_pos
    have hdiv : ∀ x : L, relVal F L x = (resDeg F L : ℤ) * valL F L x := by
      intro x
      by_cases hx : x = 0
      · unfold valL
        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F L : ℤ)
        set q_x : ℤ := valL F L x
        set r_x : ℤ := relVal F L x % f
        have hediv : f * q_x + r_x = relVal F L x := Int.mul_ediv_add_emod (relVal F L x) f
        have hr_nonneg : 0 ≤ r_x := Int.emod_nonneg (relVal F L x) hfL_int_ne
        have hr_lt : r_x < f := Int.emod_lt_of_pos (relVal F L x) hfL_int_pos
        have hr_zero : r_x = 0 := by
          by_contra hr_ne
