        (∑ r ∈ Finset.Icc 1 (p - 2), s₂ z r) = 0 ∨
          (m₂ : ℤ) ≤ valL F E' (∑ r ∈ Finset.Icc 1 (p - 2), s₂ z r) := by
      apply @hsum_E' ℕ (Finset.Icc 1 (p - 2)) (fun r => s₂ z r) (m₂ : ℤ)
      intro r hr
      rcases hs₂_val_low r hr with h0 | hge
      · exact Or.inl h0
      · right
        have hrm_nonneg : 0 ≤ (r : ℤ) * (m : ℤ) := by positivity
        linarith
    have htop_m₂ :
        s₂ z (p - 1) + (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) = 0 ∨
          (m₂ : ℤ) ≤ valL F E' (s₂ z (p - 1) + (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1))) := by
      rcases hs₂_val_top with h0 | hge
      · exact Or.inl h0
      · right
        have hp1m_nonneg : 0 ≤ ((p - 1 : ℕ) : ℤ) * (m : ℤ) := by positivity
        linarith
    exact hvalE'_add (m₂ : ℤ) _ _ hsum_low htop_m₂

  
  have hC₂_div_γ :
      (C₂ : E') * IntermediateField.inclusion hLE' (((γ⁻¹ : Lˣ) : L)) =
        1 - IntermediateField.inclusion hLE' u * (w₂ : E') +
          IntermediateField.inclusion hLE' u * a := by
    have hγ_inv :
        IntermediateField.inclusion hLE' (γ : L) *
          IntermediateField.inclusion hLE' (((γ⁻¹ : Lˣ) : L)) = 1 := by
      rw [← map_mul, Units.mul_inv γ, map_one]
    have hα_γ_inv :
        IntermediateField.inclusion hLE' (α : L) *
          IntermediateField.inclusion hLE' (((γ⁻¹ : Lˣ) : L)) =
        IntermediateField.inclusion hLE' u := by
      dsimp [u]
      rw [map_mul]
    rw [hC₂_eq]
    dsimp [a]
    linear_combination hγ_inv - (w₂ : E') * hα_γ_inv + normLM F hE'K₁ (Δ : K₁) * hα_γ_inv
  have hw2_inv_mul : (w₂ : E') * ((w₂⁻¹ : E'ˣ) : E') = 1 := Units.mul_inv w₂
  have hw2_pow_inv : (w₂ : E') ^ p * (((w₂⁻¹ : E'ˣ) : E') ^ p) - 1 = 0 := by
    rw [← mul_pow, hw2_inv_mul, one_pow, sub_self]
  have hw2_inv_p1 :
      (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) - (w₂ : E') * (((w₂⁻¹ : E'ˣ) : E') ^ p) = 0 := by
    have hp_eq : (p - 1) + 1 = p := Nat.sub_add_cancel hp_pos
    have hpow : (((w₂⁻¹ : E'ˣ) : E') ^ p) =
        ((w₂⁻¹ : E'ˣ) : E') * (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) := by
      conv_lhs => rw [← hp_eq, pow_succ']
    rw [hpow]
    linear_combination - (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) * hw2_inv_mul
  have hDiff2_eq :
      (C₂ : E') * IntermediateField.inclusion hLE' (((γ⁻¹ : Lˣ) : L)) - M_approx =
        (IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) - 1) *
          (a - (w₂ : E')) * (((w₂⁻¹ : E'ˣ) : E') ^ p) := by
    rw [hC₂_div_γ]
    dsimp [M_approx]
    linear_combination
      - (IntermediateField.inclusion hLE' u * (a - (w₂ : E'))) * hw2_pow_inv + hw2_inv_p1

  have hDiff2 :
      (C₂ : E') * IntermediateField.inclusion hLE' (((γ⁻¹ : Lˣ) : L)) - M_approx = 0 ∨
        (m₂ : ℤ) ≤
          valL F E' ((C₂ : E') * IntermediateField.inclusion hLE' (((γ⁻¹ : Lˣ) : L)) - M_approx) := by
    rw [hDiff2_eq]
    have hw2_inv_p_val :
        (((w₂⁻¹ : E'ˣ) : E') ^ p) = 0 ∨
          (p : ℤ) * (m : ℤ) ≤ valL F E' ((((w₂⁻¹ : E'ˣ) : E') ^ p)) := by
      right
      rw [(hpow_E' ((w₂⁻¹ : E'ˣ) : E') p hw₂_inv_ne0).2, hw₂_inv_val]
    have hm₂_eq : (m₂ : ℤ) = (t₂ : ℤ) + (t₁ : ℤ) + 1 := by
      dsimp [m₂, t₁, t₂]
      omega
    have hp1_ge2 : (2 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) := by
      exact_mod_cast (by omega : 2 ≤ p - 1)
    have ht₂_mul_ge : 2 * (t₂ : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) :=
      mul_le_mul_of_nonneg_right hp1_ge2 (by positivity)
    have ht₁_le_t₂ : (t₁ : ℤ) ≤ (t₂ : ℤ) := by exact_mod_cast ht_le
    have ht₂_ge1_int : (1 : ℤ) ≤ (t₂ : ℤ) := by exact_mod_cast ht₂_ge1
    have hm_ge1_int : (1 : ℤ) ≤ (m : ℤ) := by exact_mod_cast hm_ge1
    by_cases htm : t₁ ≤ m
    · have htm_int : (t₁ : ℤ) ≤ (m : ℤ) := by exact_mod_cast htm
      have ha_sub_w₂ : a - (w₂ : E') = 0 ∨ -(m : ℤ) ≤ valL F E' (a - (w₂ : E')) :=
        hsub_E' (-(m : ℤ)) a (w₂ : E')
          (Or.inr (by rw [ha_val]; linarith))
          (Or.inr (by rw [hw₂_val]))
      have h1 := hmul_E' (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) (-(m : ℤ))
        (IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) - 1) (a - (w₂ : E'))
        huw₂_pow ha_sub_w₂
      have h2 := hmul_E' ((((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) + (-(m : ℤ))) ((p : ℤ) * (m : ℤ))
        ((IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) - 1) * (a - (w₂ : E')))
        ((((w₂⁻¹ : E'ˣ) : E') ^ p)) h1 hw2_inv_p_val
      rcases h2 with h0 | hge
      · exact Or.inl h0
      · right
        have hp_ge3_int : (3 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp_ge3
        have hpm_ge : 3 * (m : ℤ) ≤ (p : ℤ) * (m : ℤ) :=
          mul_le_mul_of_nonneg_right hp_ge3_int (by positivity)
        linarith
    · have hmt_int : (m : ℤ) ≤ (t₁ : ℤ) := by exact_mod_cast (by omega : m ≤ t₁)
      have ha_sub_w₂ : a - (w₂ : E') = 0 ∨ -(t₁ : ℤ) ≤ valL F E' (a - (w₂ : E')) :=
        hsub_E' (-(t₁ : ℤ)) a (w₂ : E')
          (Or.inr (by rw [ha_val]))
          (Or.inr (by rw [hw₂_val]; linarith))
      have h1 := hmul_E' (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) (-(t₁ : ℤ))
        (IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) - 1) (a - (w₂ : E'))
        huw₂_pow ha_sub_w₂
      have h2 := hmul_E' ((((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) + (-(t₁ : ℤ))) ((p : ℤ) * (m : ℤ))
        ((IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) - 1) * (a - (w₂ : E')))
        ((((w₂⁻¹ : E'ˣ) : E') ^ p)) h1 hw2_inv_p_val
      rcases h2 with h0 | hge
      · exact Or.inl h0
      · right
        linarith

  
  have hDiff_total :
      (C₂ : E') * IntermediateField.inclusion hLE' (((γ⁻¹ : Lˣ) : L)) -
          normLM F hE'K₁ (1 + z) = 0 ∨
        (m₂ : ℤ) ≤
          valL F E'
            ((C₂ : E') * IntermediateField.inclusion hLE' (((γ⁻¹ : Lˣ) : L)) -
              normLM F hE'K₁ (1 + z)) := by
    have hsub := hsub_E' (m₂ : ℤ)
      ((C₂ : E') * IntermediateField.inclusion hLE' (((γ⁻¹ : Lˣ) : L)) - M_approx)
      (normLM F hE'K₁ (1 + z) - M_approx)
      hDiff2 hDiff1
    have heq :
        ((C₂ : E') * IntermediateField.inclusion hLE' (((γ⁻¹ : Lˣ) : L)) - M_approx) -
          (normLM F hE'K₁ (1 + z) - M_approx) =
        (C₂ : E') * IntermediateField.inclusion hLE' (((γ⁻¹ : Lˣ) : L)) -
          normLM F hE'K₁ (1 + z) := by
      ring
    rwa [heq] at hsub

  let u_base : E'ˣ :=
    Units.map (IntermediateField.inclusion hLE').toMonoidHom γ *
      Units.map (normLM F hE'K₁) u_1z
  let u_err : E'ˣ := u_base⁻¹ * C₂
  have hu_err_sub1 :
      (u_err : E') - 1 =
        ((C₂ : E') * IntermediateField.inclusion hLE' (((γ⁻¹ : Lˣ) : L)) -
          normLM F hE'K₁ (1 + z)) * (normLM F hE'K₁ (1 + z))⁻¹ := by
    have hub_mul :
        (IntermediateField.inclusion hLE' (γ : L) * normLM F hE'K₁ (1 + z)) *
          ((u_base⁻¹ : E'ˣ) : E') = 1 :=
      Units.mul_inv u_base
    have hγ_inv :
        IntermediateField.inclusion hLE' (γ : L) *
          IntermediateField.inclusion hLE' (((γ⁻¹ : Lˣ) : L)) = 1 := by
      rw [← map_mul, Units.mul_inv γ, map_one]
    have hnorm_inv : normLM F hE'K₁ (1 + z) * (normLM F hE'K₁ (1 + z))⁻¹ = 1 :=
      mul_inv_cancel₀ hnorm1z_E'_ne0
    change ((u_base⁻¹ : E'ˣ) : E') * (C₂ : E') - 1 = _
    linear_combination
      (C₂ : E') * IntermediateField.inclusion hLE' (((γ⁻¹ : Lˣ) : L)) *
          (normLM F hE'K₁ (1 + z))⁻¹ * hub_mul -
        (C₂ : E') * ((u_base⁻¹ : E'ˣ) : E') * normLM F hE'K₁ (1 + z) *
          (normLM F hE'K₁ (1 + z))⁻¹ * hγ_inv -
        (C₂ : E') * ((u_base⁻¹ : E'ˣ) : E') * hnorm_inv +
        hnorm_inv
  have hu_err_mem : u_err ∈ unitGroup F E' m₂ := by
    rw [hunitE'_mem m₂ hm₂_ge1 u_err]
    have hinv_val0 :
        (normLM F hE'K₁ (1 + z))⁻¹ = 0 ∨ 0 ≤ valL F E' ((normLM F hE'K₁ (1 + z))⁻¹) := by
      right
      have h := hvalE'_inv (Units.map (normLM F hE'K₁) u_1z)
      rw [Units.val_inv_eq_inv_val] at h
      change valL F E' ((normLM F hE'K₁ (1 + z))⁻¹) = - valL F E' (normLM F hE'K₁ (1 + z)) at h
      rw [h, hnorm1z_E'_val0, neg_zero]
    have hprod := hmul_E' (m₂ : ℤ) 0
      ((C₂ : E') * IntermediateField.inclusion hLE' (((γ⁻¹ : Lˣ) : L)) - normLM F hE'K₁ (1 + z))
      ((normLM F hE'K₁ (1 + z))⁻¹)
      hDiff_total hinv_val0
    rw [add_zero, ← hu_err_sub1] at hprod
    rcases hprod with h0 | hge
    · exact Or.inl (sub_eq_zero.mp h0)
    · exact Or.inr hge
  have hχ₂_u_err : χ₂ u_err = 1 := hχ₂_triv u_err hu_err_mem

  have hQ1_red : ∀ hE : 1 - (-E_norm) ≠ 0,
      (((χ₁ A₁ : Ω F) ^ 2 * ((χ₂ C₂ : Ω F) ^ 2)⁻¹)⁻¹ =
        (χ₁ (Units.mk0 (1 - (-E_norm)) hE) : Ω F) ^ 2) := by
    intro hE
    have hC₂_eq_base : C₂ = u_base * u_err := by
      dsimp [u_err]
      group
    have hχ_norm_u1z :
        χ₂ (Units.map (normLM F hE'K₁) u_1z) = χ₁ (Units.map (normLM F hM₁'K₁) u_1z) :=
      DFunLike.congr_fun hχ_comp u_1z
    have hχ_γ :
        χ₂ (Units.map (IntermediateField.inclusion hLE').toMonoidHom γ) =
          χ₁ (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom γ) :=
      hχ_rest γ
    have hχ₂_C₂ : χ₂ C₂ = χ₁ A₁ * χ₁ (Units.mk0 (1 - (-E_norm)) hE) := by
      rw [hC₂_eq_base, map_mul, hχ₂_u_err, mul_one]
      dsimp [u_base]
      rw [map_mul]
      erw [hχ_γ]
      rw [hχ_norm_u1z, ← map_mul, ← hA₁_unit_eq hE]
      exact map_mul χ₁ A₁ (Units.mk0 (1 - (-E_norm)) hE)
    have hunit_id :
        ((χ₁ A₁) ^ 2 * ((χ₂ C₂) ^ 2)⁻¹)⁻¹ = (χ₁ (Units.mk0 (1 - (-E_norm)) hE)) ^ 2 := by
      rw [hχ₂_C₂, mul_pow, mul_comm ((χ₁ A₁) ^ 2)]
      group
    have hval := congrArg Units.val hunit_id
    simpa only [Units.val_inv_eq_inv_val, Units.val_mul, Units.val_pow_eq_pow_val] using hval

  exact ⟨huw₂_pow, h1n_ne0, h1n_val0, hnorm1z_ne0, hnorm1z_val0, hE_ne0, hQ1_red⟩

theorem ld_ch12_wild_odd_tot_ram_q1_trunc_log_newton_expansion (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F))
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣ (bM₁' - 1)))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) * (bM₁' : ℤ))
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (hTowerNormTr : ∀ w : K₁,
      normLM F hLE' (normLM F hE'K₁ w) = normLM F hLM₁' (normLM F hM₁'K₁ w) ∧
      traceLM F hLE' (traceLM F hE'K₁ w) = traceLM F hLM₁' (traceLM F hM₁'K₁ w))
    (χ₁ : M₁'ˣ →* (Ω F)ˣ)
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hTwistedTr : ∀ (Y : E') (i : ℕ),
      i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1) →
      Y = 0 ∨
        traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i)) = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) + valL F E' Y ≤
          valL F M₁' (traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i))))
    (α γ : Lˣ) (w₂ : E'ˣ)
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ)
    (hw₂_val : valL F E' (w₂ : E') = -((a_lam - bE' : ℕ) : ℤ))
    (hχ₁_log' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      let q₁ := (m₁ + p - 1) / p
      ∀ z : M₁', (z = 0 ∨ (q₁ : ℤ) ≤ valL F M₁' z) →
        ∀ hz : 1 - z ≠ 0,
          (χ₁ (Units.mk0 (1 - z) hz) : Ω F) ^ 2 =
            (traceChar F hLM₁' ψ) (2 * IntermediateField.inclusion hLM₁' (α : L) *
              normLM F hM₁'K₁ (Δ : K₁) *
              (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j)))
    (hψM₁'_triv : ∀ z : M₁',
      (z = 0 ∨ -condExpChar F M₁' (traceChar F hLM₁' ψ) ≤ valL F M₁' z) →
      (traceChar F hLM₁' ψ) z = 1)
    (s₁ : K₁ → ℕ → M₁')
    (hs₁_newton : ∀ (w : K₁) (r : ℕ),
      r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1) →
      (-1 : M₁') ^ (r - 1) * ((r : ℕ) : M₁') * s₁ w r - traceLM F hM₁'K₁ (w ^ r) =
        - ∑ j ∈ Finset.Icc 1 (r - 1),
            (-1 : M₁') ^ (j - 1) * s₁ w j * traceLM F hM₁'K₁ (w ^ (r - j)))
    (h1n_ne0 :
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      let n := IntermediateField.inclusion hLM₁' u * b
      1 + n ≠ 0)
    (h1n_val0 :
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      let n := IntermediateField.inclusion hLM₁' u * b
      valL F M₁' (1 + n) = 0) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    let δ := bE' - bM₁'
    let m := a_lam - bE'
    let ψE' := traceChar F hLE' ψ
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
    let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
    let n := IntermediateField.inclusion hLM₁' u * b
    let T := traceLM F hM₁'K₁ (z ^ (p - 1))
    let E_norm := (∑ i ∈ Finset.Icc 1 (p - 1), s₁ z i) * (1 + n)⁻¹
    let W_fn : ℕ → E' := fun i =>
      traceLM F hE'K₁
        (IntermediateField.inclusion hM₁'K₁ b * z ^ i *
          (IntermediateField.inclusion hM₁'K₁ (1 + n))⁻¹)
    let Q_quad : E' :=
      traceLM F hE'K₁
        (IntermediateField.inclusion hM₁'K₁ (b * T) * z ^ (p - 1) *
          (IntermediateField.inclusion hM₁'K₁ ((1 + n) ^ 2))⁻¹)
    (∀ i ∈ Finset.Icc 1 (p - 1),
      s₁ z i = 0 ∨
        ((p - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) +
          (i : ℤ) * ((m : ℤ) - (t₁ : ℤ)) ≤ valL F M₁' (s₁ z i)) ∧
    (T + ((p - 1 : ℕ) : M₁') * s₁ z (p - 1) = 0 ∨
      ((p - 1 : ℕ) : ℤ) * (m : ℤ) +
        ((p - 1 : ℕ) : ℤ) * ((t₁ + 2 * δ : ℕ) : ℤ) ≤
          valL F M₁' (T + ((p - 1 : ℕ) : M₁') * s₁ z (p - 1))) ∧
    (∀ hE : 1 - (-E_norm) ≠ 0,
      (χ₁ (Units.mk0 (1 - (-E_norm)) hE) : Ω F) ^ 2 =
        ψE' (2 * IntermediateField.inclusion hLE' (α : L) *
          ((∑ i ∈ Finset.Icc 1 (p - 1), (-1 : E') ^ i * ((i : ℕ) : E')⁻¹ * W_fn i) +
            (2 : E')⁻¹ * ((p - 1 : ℕ) : E')⁻¹ ^ 2 * Q_quad))) :=
by
  have hval_core : ∀ (B : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B],
      valL F B 1 = 0 ∧
      valL F B (-1) = 0 ∧
      (∀ x : B, valL F B (-x) = valL F B x) ∧
      (∀ x y : B, x ≠ 0 → y ≠ 0 → valL F B (x * y) = valL F B x + valL F B y) ∧
      (∀ u : Bˣ, valL F B ((u⁻¹ : Bˣ) : B) = - valL F B (u : B)) ∧
      (∀ (k : ℤ) (x y : B),
