    have htransfer_P : P (2 * (r : ℤ)) (β₁ * (1 + 4 * f) * s₀ ^ 2 - β₂ * (1 - 4 * g) * t₀ ^ 2) := by
      rw [htransfer_eq]
      exact hP_mono (hP_mul hP_Δ_even (hP_sq hs₀)) (by omega)
    have hM_sq_van : ψ (((α⁻¹ : Lˣ) : L) * (β₁ * (1 + 4 * f) * s₀ ^ 2)) = 1 := by
      rw [hψ_eq2r _ _ htransfer_P]
      exact hE_sq_van
    have hsplit_eq : ((α⁻¹ : Lˣ) : L) * (β₁ * (1 + 4 * f) * s₀ ^ 2) =
        ((α⁻¹ : Lˣ) : L) * β₁ * (2 * s₀ + s₀ ^ 2) +
          ((α⁻¹ : Lˣ) : L) * β₁ * ((-2 * s₀) + f * (-2 * s₀) ^ 2) := by ring
    rw [hsplit_eq, AddChar.map_add_eq_mul] at hM_sq_van
    exact ⟨hs₁_val, hs₀'_step, hM_sq_van⟩
  
  have hEvenInd : ∀ (k : ℕ) (s₀ : L),
      (s₀ = 0 ∨ (a : ℤ) ≤ 2 * valL F L s₀) →
      (a : ℤ) - valL F L s₀ ≤ (k : ℤ) →
      ψ (((α⁻¹ : Lˣ) : L) * β₁ * (2 * s₀ + s₀ ^ 2)) = 1 := by
    intro k
    induction' k using Nat.strong_induction_on with k ih
    intro s₀ hs₀ hk
    by_cases hbase : P (a : ℤ) s₀
    · exact hEvenBase s₀ hbase
    · have hs₀_ne : s₀ ≠ 0 := fun h => hbase (Or.inl h)
      have hs₀_lt : valL F L s₀ < (a : ℤ) := by
        by_contra! hge
        exact hbase (Or.inr hge)
      have hk_pos : 1 ≤ k := by omega
      obtain ⟨hs₁_val, hs₀'_step, hProd⟩ := hEvenStep s₀ hs₀
      obtain ⟨hs₀'_val, hOddEq⟩ := hOddToEven (-2 * s₀) hs₁_val
      set s₀' : L := -2 * f * (-2 * s₀)
      have hψ_s₀' : ψ (((α⁻¹ : Lˣ) : L) * β₁ * (2 * s₀' + (s₀') ^ 2)) = 1 := by
        by_cases hs₀'0 : s₀' = 0
        · exact hEvenBase s₀' (Or.inl hs₀'0)
        · have hstep : valL F L s₀ + 1 ≤ valL F L s₀' := hs₀'_step.resolve_left hs₀'0
          exact ih (k - 1) (by omega) s₀' hs₀'_val (by omega)
      rw [hOddEq, hψ_s₀', mul_one] at hProd
      exact hProd
  have hEvenAll : ∀ s₀ : L, (s₀ = 0 ∨ (a : ℤ) ≤ 2 * valL F L s₀) →
      ψ (((α⁻¹ : Lˣ) : L) * β₁ * (2 * s₀ + s₀ ^ 2)) = 1 := by
    intro s₀ hs₀
    exact hEvenInd ((a : ℤ) - valL F L s₀).toNat s₀ hs₀ (by omega)
  have hOddAll : ∀ s₁ : L, (s₁ = 0 ∨ 3 * (a : ℤ) - 1 ≤ 2 * valL F L s₁) →
      ψ (((α⁻¹ : Lˣ) : L) * β₁ * (s₁ + f * s₁ ^ 2)) = 1 := by
    intro s₁ hs₁
    obtain ⟨hs₀'_val, hOddEq⟩ := hOddToEven s₁ hs₁
    rw [hOddEq]
    exact hEvenAll _ hs₀'_val
  
  intro v hv
  obtain ⟨s₀, s₁, hs₀, hs₁, hsum_v, hP_cross⟩ := hCoordDecomp v hv
  have harg_eq : ((α⁻¹ : Lˣ) : L) * β₁ * (traceLM F hLM₁' v + normLM F hLM₁' v) =
      (((α⁻¹ : Lˣ) : L) * β₁ * (2 * s₀ + s₀ ^ 2) -
        ((α⁻¹ : Lˣ) : L) * β₁ * (s₁ + f * s₁ ^ 2)) -
        ((α⁻¹ : Lˣ) : L) * (β₁ * (s₀ * s₁)) := by
    rw [hsum_v]; ring
  rw [harg_eq, AddChar.map_sub_eq_div, AddChar.map_sub_eq_div,
      hEvenAll s₀ hs₀, hOddAll s₁ hs₁, hψ_triv2r (β₁ * (s₀ * s₁)) hP_cross,
      div_one, div_one]

theorem ld_ch12_wild_dyadic_even_breaks_quad_norm_vanishing_to_stat (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hSpecL : (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hnorm_iff_le_M₁' : ∀ m ≤ condExp F L νM₁' - 1, ∀ w : M₁'ˣ,
      Units.map (normLM F hLM₁') w ∈ unitGroup F L m ↔ w ∈ unitGroup F M₁' m)
    (h2_val : (2 : L) = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L (2 : L))
    (c_ν₁ : Lˣ)
    (hc_ν₁_val : valL F L (c_ν₁ : L) = (condExp F L νM₁' : ℤ) + condExpChar F L ψ)
    (hNormVanish : ∀ v : M₁', (v = 0 ∨ ((condExp F L νM₁' / 2 : ℕ) : ℤ) ≤ valL F M₁' v) →
      ψ (((c_ν₁⁻¹ : Lˣ) : L) * (traceLM F hLM₁' v + normLM F hLM₁' v)) = 1) :
    let a := condExp F L νM₁' / 2
    ∀ u : L, (u = 0 ∨ (a : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νM₁' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((c_ν₁⁻¹ : Lˣ) : L) * u) :=
by
  intro a
  let r : ℕ := condExp F L νE' / 2
  have ha_ge1 : 1 ≤ a := by omega
  have ha_le : a ≤ condExp F L νM₁' - 1 := by omega
  have hT1_eq : (condExp F L νM₁' : ℤ) = 2 * (a : ℤ) := by omega
  have hr_ge1 : 1 ≤ r := by omega
  have hdeg2_M₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') = 2 :=
    hdegM₁'.trans hdeg2
  rcases hvalL_props with
    ⟨hvalL_0, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv,
     _, hvalL_add, _, hunitL_mem, _⟩
  rcases hvalM₁'_props with
    ⟨_, _, _, _, _, _, _, _, _, hunitM₁'_mem, _⟩
  rcases hSpecL with ⟨hSpecL_triv, ⟨x₁, hx₁_ne, hx₁_val, hx₁_ψ⟩⟩
  have hc_ν₁_inv_val : valL F L ((c_ν₁⁻¹ : Lˣ) : L) = -(2 * (a : ℤ) + condExpChar F L ψ) := by
    rw [hvalL_inv c_ν₁, hc_ν₁_val, hT1_eq]
  have hKerCase : ∀ u : L, (u = 0 ∨ (a : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0, νM₁' (Units.mk0 (1 + u) hu) = 1 →
        ψ (((c_ν₁⁻¹ : Lˣ) : L) * u) = 1 := by
    intro u hu_val hu hν
    let u_unit : Lˣ := Units.mk0 (1 + u) hu
    obtain ⟨w, hw_norm⟩ := (hνM₁'_ker u_unit).mpr hν
    have hu_mem : u_unit ∈ unitGroup F L a := by
      rw [hunitL_mem a ha_ge1 u_unit]
      have hsub : (u_unit : L) - 1 = u := by
        change (1 + u) - 1 = u
        ring
      rcases hu_val with rfl | hu_ge
      · left
        change (1 : L) + 0 = 1
        ring
      · right
        rw [hsub]
        exact hu_ge
    have hw_mem : w ∈ unitGroup F M₁' a := by
      apply (hnorm_iff_le_M₁' a ha_le w).mp
      rw [hw_norm]
      exact hu_mem
    let v : M₁' := (w : M₁') - 1
    have hv_val : v = 0 ∨ (a : ℤ) ≤ valL F M₁' v := by
      rcases (hunitM₁'_mem a ha_ge1 w).mp hw_mem with hw1 | hw_ge
      · left
        dsimp [v]
        rw [hw1, sub_self]
      · right
        exact hw_ge
    have hquad := ((hQuadNorm L M₁' hLM₁' hdeg2_M₁').2 1 v).1
    have h1v : IntermediateField.inclusion hLM₁' 1 + v = (w : M₁') := by
      dsimp [v]
      rw [map_one]
      ring
    have hnorm_w : normLM F hLM₁' (w : M₁') = 1 + u := by
      have hmap : ((Units.map (normLM F hLM₁') w : Lˣ) : L) = (u_unit : L) :=
        congrArg Units.val hw_norm
      exact hmap
    rw [h1v, hnorm_w] at hquad
    have hu_eq : u = traceLM F hLM₁' v + normLM F hLM₁' v := by
      linear_combination hquad
    rw [hu_eq]
    exact hNormVanish v hv_val
  have hνM₁'_sq : νM₁' ^ 2 = 1 := by rwa [hdeg2] at hνM₁'_pow
  have hν_eq_neg_one : ∀ z : Lˣ, νM₁' z ≠ 1 → (νM₁' z : Ω F) = -1 := by
    intro z hz_ne
    have hz_sq_unit : (νM₁' z) ^ 2 = 1 := by
      rw [← MonoidHom.pow_apply, hνM₁'_sq, MonoidHom.one_apply]
    have hz_sq : (νM₁' z : Ω F) ^ 2 = 1 := by
      have h := congrArg Units.val hz_sq_unit
      rwa [Units.val_pow_eq_pow_val, Units.val_one] at h
    rcases sq_eq_one_iff.mp hz_sq with hz1 | hz_neg1
    · exfalso
      apply hz_ne
      exact Units.ext hz1
    · exact hz_neg1
  let u_star : L := (c_ν₁ : L) * x₁
  have hu_star_ne : u_star ≠ 0 := mul_ne_zero c_ν₁.ne_zero hx₁_ne
  have hu_star_val : 2 * (a : ℤ) - 1 ≤ valL F L u_star := by
    have hmul := hvalL_mul (c_ν₁ : L) x₁ c_ν₁.ne_zero hx₁_ne
    dsimp [u_star]
    rw [hmul, hc_ν₁_val, hT1_eq]
    omega
  have hu_star_1 : 1 + u_star ≠ 0 := by
    intro h0
    have h_eq : u_star = -1 := by linear_combination h0
    have h_val0 : valL F L u_star = 0 := by rw [h_eq, hvalL_neg1]
    omega
  let u_star_unit : Lˣ := Units.mk0 (1 + u_star) hu_star_1
  have hc_ustar : ((c_ν₁⁻¹ : Lˣ) : L) * u_star = x₁ := by
    dsimp [u_star]
    rw [← mul_assoc]
    have hinv : ((c_ν₁⁻¹ : Lˣ) : L) * (c_ν₁ : L) = 1 := by
      exact_mod_cast Units.inv_mul c_ν₁
    rw [hinv, one_mul]
  have hν_ustar_ne : νM₁' u_star_unit ≠ 1 := by
    intro hν1
    have hψ1 := hKerCase u_star (Or.inr (by omega)) hu_star_1 hν1
    rw [hc_ustar] at hψ1
    exact hx₁_ψ hψ1
  have hν_ustar_val : (νM₁' u_star_unit : Ω F) = -1 :=
    hν_eq_neg_one u_star_unit hν_ustar_ne
  have h2x1_val : x₁ + x₁ = 0 ∨ -condExpChar F L ψ ≤ valL F L (x₁ + x₁) := by
    rw [← two_mul x₁]
    by_cases h2_ne : (2 : L) = 0
    · left
      rw [h2_ne, zero_mul]
    · rcases h2_val with h2_zero | h2_ge
      · exact absurd h2_zero h2_ne
      · right
        have hmul := hvalL_mul (2 : L) x₁ h2_ne hx₁_ne
        rw [hmul]
        change (r : ℤ) ≤ valL F L (2 : L) at h2_ge
        omega
  have hψ_2x1 : ψ (x₁ + x₁) = 1 := hSpecL_triv (x₁ + x₁) h2x1_val
  have hψ_x1_sq : (ψ x₁) ^ 2 = 1 := by
    rw [sq, ← AddChar.map_add_eq_mul, hψ_2x1]
  have hψ_x1 : ψ x₁ = -1 := by
    rcases sq_eq_one_iff.mp hψ_x1_sq with h1 | h_neg1
    · exact absurd h1 hx₁_ψ
    · exact h_neg1
  intro u hu_val hu
  let u_unit : Lˣ := Units.mk0 (1 + u) hu
  by_cases hν : νM₁' u_unit = 1
  · have hψ_u := hKerCase u hu_val hu hν
    change (νM₁' u_unit : Ω F) = ψ (((c_ν₁⁻¹ : Lˣ) : L) * u)
    rw [hν, Units.val_one, hψ_u]
  · have hν_u_val : (νM₁' u_unit : Ω F) = -1 := hν_eq_neg_one u_unit hν
    have hu_ustar_2a : u * u_star = 0 ∨ 2 * (a : ℤ) ≤ valL F L (u * u_star) := by
      by_cases hu_zero : u = 0
      · left
        rw [hu_zero, zero_mul]
      · right
        have hu_ge : (a : ℤ) ≤ valL F L u := hu_val.resolve_left hu_zero
        have hmul := hvalL_mul u u_star hu_zero hu_star_ne
        rw [hmul]
        omega
    have hψ_quad : ψ (((c_ν₁⁻¹ : Lˣ) : L) * (u * u_star)) = 1 := by
      apply hSpecL_triv
      by_cases hprod_zero : u * u_star = 0
      · left
        rw [hprod_zero, mul_zero]
      · right
        have hprod_ge : 2 * (a : ℤ) ≤ valL F L (u * u_star) :=
          hu_ustar_2a.resolve_left hprod_zero
        have hmul := hvalL_mul ((c_ν₁⁻¹ : Lˣ) : L) (u * u_star) (c_ν₁⁻¹).ne_zero hprod_zero
        rw [hmul, hc_ν₁_inv_val]
        omega
    let u' : L := u + u_star + u * u_star
    have hu'_val : u' = 0 ∨ (a : ℤ) ≤ valL F L u' := by
      have h1 : u + u_star = 0 ∨ (a : ℤ) ≤ valL F L (u + u_star) :=
        hvalL_add (a : ℤ) u u_star hu_val (Or.inr (by omega))
      have h2 : u * u_star = 0 ∨ (a : ℤ) ≤ valL F L (u * u_star) := by
        rcases hu_ustar_2a with h0 | hge
        · exact Or.inl h0
        · exact Or.inr (by omega)
      exact hvalL_add (a : ℤ) (u + u_star) (u * u_star) h1 h2
    have hu'_eq_mul : 1 + u' = (1 + u) * (1 + u_star) := by
      dsimp [u']
      ring
    have hu' : 1 + u' ≠ 0 := by
      rw [hu'_eq_mul]
      exact mul_ne_zero hu hu_star_1
    have hu'_unit_eq : Units.mk0 (1 + u') hu' = u_unit * u_star_unit := by
      apply Units.ext
      change 1 + u' = (1 + u) * (1 + u_star)
      exact hu'_eq_mul
    have hν_u' : νM₁' (Units.mk0 (1 + u') hu') = 1 := by
      apply Units.ext
      rw [hu'_unit_eq, map_mul, Units.val_mul, Units.val_one, hν_u_val, hν_ustar_val]
      ring
    have hψ_u' : ψ (((c_ν₁⁻¹ : Lˣ) : L) * u') = 1 :=
      hKerCase u' hu'_val hu' hν_u'
    have hexp : ((c_ν₁⁻¹ : Lˣ) : L) * u' =
        ((c_ν₁⁻¹ : Lˣ) : L) * u +
          (((c_ν₁⁻¹ : Lˣ) : L) * u_star + ((c_ν₁⁻¹ : Lˣ) : L) * (u * u_star)) := by
      dsimp [u']
      ring
    rw [hexp, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul, hc_ustar, hψ_x1, hψ_quad] at hψ_u'
    have hψ_u : ψ (((c_ν₁⁻¹ : Lˣ) : L) * u) = -1 := by
      linear_combination -hψ_u'
    change (νM₁' u_unit : Ω F) = ψ (((c_ν₁⁻¹ : Lˣ) : L) * u)
    rw [hν_u_val, hψ_u]

theorem ld_ch12_wild_dyadic_even_breaks_galois_commutator_stat (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_even : condExp F L νE' % 2 = 0)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
