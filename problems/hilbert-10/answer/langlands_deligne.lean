          change wt (v + 1) d = 0 at h0
          omega
        obtain ⟨s₁, _, hs₁⟩ := hex1
        have hsum_erase1 :
            (d s₁ : ℕ) + ∑ s ∈ (Finset.univ : Finset (Fin (v + 1))).erase s₁, (d s : ℕ) =
              wt (v + 1) d :=
          Finset.add_sum_erase Finset.univ (fun s : Fin (v + 1) => (d s : ℕ)) (Finset.mem_univ s₁)
        have hds₁_lt : (d s₁ : ℕ) < p := (d s₁).2
        have hex2 : ∃ s₂ ∈ (Finset.univ : Finset (Fin (v + 1))).erase s₁, (d s₂ : ℕ) ≠ 0 := by
          by_contra hnone2
          push_neg at hnone2
          have h0 := Finset.sum_eq_zero hnone2
          omega
        obtain ⟨s₂, hs₂_mem, hs₂⟩ := hex2
        let R₁ : Finset (Fin (v + 1)) := (Finset.univ : Finset (Fin (v + 1))).erase s₁
        let R₂ : Finset (Fin (v + 1)) := R₁.erase s₂
        let g_base : Fin (v + 1) → ℤ := fun s => ((d s : ℕ) : ℤ) * (t₁ : ℤ) - (t₁ : ℤ)
        let Δ_up : ℤ := ((p - 1 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ))
        have hprod_split :
            prod_e (v + 1) d =
              e_def (d s₁) * (e_def (d s₂) * ∏ s ∈ R₂, e_def (d s)) := by
          dsimp only [prod_e, R₂, R₁]
          rw [← Finset.mul_prod_erase Finset.univ (fun s => e_def (d s)) (Finset.mem_univ s₁),
            ← Finset.mul_prod_erase ((Finset.univ : Finset (Fin (v + 1))).erase s₁)
              (fun s => e_def (d s)) hs₂_mem]
        have hR₂_val :
            (∏ s ∈ R₂, e_def (d s)) = 0 ∨
              (∑ s ∈ R₂, g_base s) ≤ valL F M₁' (∏ s ∈ R₂, e_def (d s)) :=
          hvalM₁'_prod R₂ (fun s => e_def (d s)) g_base (fun s _ => he_def_val0 (d s))
        have hmul2 := hvalM₁'_mul_ge (g_base s₂ + Δ_up) (∑ s ∈ R₂, g_base s)
          (e_def (d s₂)) (∏ s ∈ R₂, e_def (d s))
          (he_def_val_pos' (d s₂) hs₂) hR₂_val
        have hmul12 := hvalM₁'_mul_ge (g_base s₁ + Δ_up)
          ((g_base s₂ + Δ_up) + ∑ s ∈ R₂, g_base s)
          (e_def (d s₁)) (e_def (d s₂) * ∏ s ∈ R₂, e_def (d s))
          (he_def_val_pos' (d s₁) hs₁) hmul2
        rw [← hprod_split] at hmul12
        have hsum_g_split :
            g_base s₁ + (g_base s₂ + ∑ s ∈ R₂, g_base s) =
              ((wt (v + 1) d : ℤ) - ((v + 1 : ℕ) : ℤ)) * (t₁ : ℤ) := by
          have h1 : g_base s₂ + ∑ s ∈ R₂, g_base s = ∑ s ∈ R₁, g_base s :=
            Finset.add_sum_erase R₁ g_base hs₂_mem
          have h2 : g_base s₁ + ∑ s ∈ R₁, g_base s = ∑ s : Fin (v + 1), g_base s :=
            Finset.add_sum_erase Finset.univ g_base (Finset.mem_univ s₁)
          rw [h1, h2]
          dsimp only [g_base]
          have hwt_z : (∑ s : Fin (v + 1), ((d s : ℕ) : ℤ)) = (wt (v + 1) d : ℤ) := by
            dsimp [wt]
            exact_mod_cast rfl
          rw [Finset.sum_sub_distrib, ← Finset.sum_mul, hwt_z, Finset.sum_const,
            Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
          ring
        have hprod_Bk : prod_e (v + 1) d = 0 ∨ B_k ≤ valL F M₁' (prod_e (v + 1) d) := by
          apply hvalM₁'_mono B_k _ _ _ hmul12
          have hlin : g_base s₁ + (g_base s₂ + ∑ s ∈ R₂, g_base s) + 2 * Δ_up =
              (g_base s₁ + Δ_up) + ((g_base s₂ + Δ_up) + ∑ s ∈ R₂, g_base s) := by ring
          rw [← hlin, hsum_g_split]
          have hwt_sub_ge : 2 * ((p - 1 : ℕ) : ℤ) - (k : ℤ) ≤
              (wt (v + 1) d : ℤ) - ((v + 1 : ℕ) : ℤ) := by omega
          have hmul_t1 := Int.mul_le_mul_of_nonneg_right hwt_sub_ge (by omega : (0 : ℤ) ≤ (t₁ : ℤ))
          dsimp [B_k, Δ_up]
          push_cast at hmul_t1 ⊢
          linarith
        have hsign_Bk := hvalM₁'_neg1_pow_bound (wt (v + 1) d) (prod_e (v + 1) d) B_k hprod_Bk
        have hmul_ind := hvalM₁'_mul_ge B_k 0
          ((-1 : M₁') ^ (wt (v + 1) d) * prod_e (v + 1) d) ((p - 1 : ℕ) : M₁')
          hsign_Bk (hvalM₁'_natCast (p - 1))
        rwa [add_zero] at hmul_ind
      · left
        dsimp only [term_d, ind_τ]
        rw [if_neg hdvd, mul_zero]
    have hmul_c := hvalM₁'_mul_ge 0 B_k ((k.choose (v + 1) : ℕ) : M₁') _
      (hvalM₁'_natCast (k.choose (v + 1))) hd_high_sum
    rwa [zero_add] at hmul_c
  have hcomb := hvalM₁'_add B_k (P_k - P_approx) (P_approx - P_main) hPk_approx hP_approx_main_val
  have hring : (P_k - P_approx) + (P_approx - P_main) = P_k - P_main := by ring
  rwa [hring] at hcomb

theorem ld_ch12_wild_odd_tot_ram_qk_deficit_tuple_expansion (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hM₁'K₁ : M₁' ≤ K₁)
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) = p)
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (e_Δ : ℕ → M₁')
    (he_Δ_val : ∀ i ∈ Finset.Icc 1 (p - 1),
      e_Δ i = 0 ∨
        ((p - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤
          valL F M₁' (e_Δ i))
    (he_Δ_cayley :
      IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ : K₁)) -
        ((Δ : K₁) ^ p +
          ∑ i ∈ Finset.Icc 1 (p - 1),
            (-1 : K₁) ^ i * IntermediateField.inclusion hM₁'K₁ (e_Δ i) * ((Δ : K₁) ^ (p - i))) = 0)
    (hNewton :
      let t₁ := bM₁' - 1
      let t₂ := bE' - 1
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let e_fn : ℕ → M₁' := fun i => if i = p then b else (-1 : M₁') ^ (i - 1) * e_Δ i
      ∀ D ∈ Finset.Icc 1 p,
        traceLM F hM₁'K₁ ((Δ : K₁) ^ D) - ((D : ℕ) : M₁') * e_fn D = 0 ∨
          2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (D : ℤ) * (t₁ : ℤ) ≤
            valL F M₁' (traceLM F hM₁'K₁ ((Δ : K₁) ^ D) - ((D : ℕ) : M₁') * e_fn D))
    (hClaimB :
      let t₁ := bM₁' - 1
      let t₂ := bE' - 1
      ∀ D : ℕ, p ≤ D →
        traceLM F hM₁'K₁ ((Δ : K₁) ^ D) = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (D : ℤ) * (t₁ : ℤ) +
            ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤
              valL F M₁' (traceLM F hM₁'K₁ ((Δ : K₁) ^ D))) :
    let t₁ := bM₁' - 1
    let t₂ := bE' - 1
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let e_fn : ℕ → M₁' := fun i => if i = p then b else (-1 : M₁') ^ (i - 1) * e_Δ i
    let e_def : Fin p → M₁' := fun a => e_fn (p - (a : ℕ))
    let S_last : ℕ → ℕ → M₁' := fun v w =>
      ∑ d ∈ (Finset.univ : Finset (Fin (v + 1) → Fin p)).filter
          (fun d => (∑ s : Fin (v + 1), (d s : ℕ)) = w),
        ((p - (d (Fin.last v) : ℕ) : ℕ) : M₁') * ∏ s : Fin (v + 1), e_def (d s)
    ∀ k ∈ Finset.Icc 2 (p - 1),
      let Q_k := traceLM F hM₁'K₁ (((Δ : K₁) ^ p - (Δ : K₁)) ^ k)
      let Q_main := ((p : ℕ) : M₁') * b ^ k +
        ∑ v ∈ Finset.range (k + 1),
          (-1 : M₁') ^ (k - v) * ((k.choose v : ℕ) : M₁') * S_last v (p - k + v)
      Q_k - Q_main = 0 ∨
        2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (k : ℤ) * (t₁ : ℤ) ≤
          valL F M₁' (Q_k - Q_main) :=
by
  classical
  intro t₁ t₂ b e_fn e_def S_last
  have ht₁_def : t₁ = bM₁' - 1 := rfl
  have ht₂_def : t₂ = bE' - 1 := rfl
  have hb_def : b = normLM F hM₁'K₁ (Δ : K₁) := rfl
  have he_fn_def : ∀ i : ℕ, e_fn i = if i = p then b else (-1 : M₁') ^ (i - 1) * e_Δ i :=
    fun _ => rfl
  have he_def_def : ∀ a : Fin p, e_def a = e_fn (p - (a : ℕ)) := fun _ => rfl
  have hS_last_def : ∀ v w : ℕ, S_last v w =
      ∑ d ∈ (Finset.univ : Finset (Fin (v + 1) → Fin p)).filter
          (fun d => (∑ s : Fin (v + 1), (d s : ℕ)) = w),
        ((p - (d (Fin.last v) : ℕ) : ℕ) : M₁') * ∏ s : Fin (v + 1), e_def (d s) := fun _ _ => rfl
  obtain ⟨hvalM₁'_0, hvalM₁'_1, hvalM₁'_neg1, hvalM₁'_neg, hvalM₁'_mul, _, _, hvalM₁'_add, _, _, _⟩ :=
    hvalM₁'_props
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have ht₁_ge1 : 1 ≤ t₁ := by omega
  have ht₂_ge1 : 1 ≤ t₂ := by omega
  have ht_le : t₁ ≤ t₂ := by omega

  
  have hvalM₁'_sub : ∀ (q : ℤ) (x y : M₁'),
      (x = 0 ∨ q ≤ valL F M₁' x) → (y = 0 ∨ q ≤ valL F M₁' y) →
        (x - y = 0 ∨ q ≤ valL F M₁' (x - y)) := by
    intro q x y hx hy
    rw [sub_eq_add_neg]
    refine hvalM₁'_add q x (-y) hx ?_
    rcases hy with rfl | hy
    · exact Or.inl neg_zero
    · exact Or.inr (by rwa [hvalM₁'_neg])
  have hvalM₁'_mono : ∀ (q₁ q₂ : ℤ) (x : M₁'),
      q₁ ≤ q₂ → (x = 0 ∨ q₂ ≤ valL F M₁' x) → (x = 0 ∨ q₁ ≤ valL F M₁' x) := by
    intro q₁ q₂ x hle hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hle hx)
  have hvalM₁'_mul_ge : ∀ (q₁ q₂ : ℤ) (x y : M₁'),
      (x = 0 ∨ q₁ ≤ valL F M₁' x) → (y = 0 ∨ q₂ ≤ valL F M₁' y) →
        (x * y = 0 ∨ q₁ + q₂ ≤ valL F M₁' (x * y)) := by
    intro q₁ q₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hvalM₁'_mul x y hx0 hy0]
        exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
  have hvalM₁'_neg1_pow_mul : ∀ (n : ℕ) (x : M₁'),
      valL F M₁' ((-1 : M₁') ^ n * x) = valL F M₁' x := by
    intro n x
    induction n with
    | zero => rw [pow_zero, one_mul]
    | succ n ih => rw [pow_succ', mul_assoc, neg_one_mul, hvalM₁'_neg, ih]
  have hvalM₁'_neg1_pow_bound : ∀ (n : ℕ) (x : M₁') (q : ℤ),
      (x = 0 ∨ q ≤ valL F M₁' x) →
        ((-1 : M₁') ^ n * x = 0 ∨ q ≤ valL F M₁' ((-1 : M₁') ^ n * x)) := by
    intro n x q hx
    rcases hx with rfl | hx
    · left; rw [mul_zero]
    · right; rwa [hvalM₁'_neg1_pow_mul]
  have hvalM₁'_sum : ∀ {α : Type} (S : Finset α) (f : α → M₁') (q : ℤ),
      (∀ a ∈ S, f a = 0 ∨ q ≤ valL F M₁' (f a)) →
        ((∑ a ∈ S, f a) = 0 ∨ q ≤ valL F M₁' (∑ a ∈ S, f a)) := by
    intro α S f q hf
    induction' S using Finset.induction_on with a S ha ih
    · left; exact Finset.sum_empty
    · rw [Finset.sum_insert ha]
      exact hvalM₁'_add q (f a) (∑ x ∈ S, f x)
        (hf a (Finset.mem_insert_self a S))
        (ih (fun x hx => hf x (Finset.mem_insert_of_mem hx)))
  have hvalM₁'_prod : ∀ {α : Type} (S : Finset α) (f : α → M₁') (g : α → ℤ),
      (∀ a ∈ S, f a = 0 ∨ g a ≤ valL F M₁' (f a)) →
        ((∏ a ∈ S, f a) = 0 ∨ (∑ a ∈ S, g a) ≤ valL F M₁' (∏ a ∈ S, f a)) := by
    intro α S f g hf
    induction' S using Finset.induction_on with a S ha ih
    · right; simp [hvalM₁'_1]
    · rw [Finset.prod_insert ha, Finset.sum_insert ha]
      exact hvalM₁'_mul_ge (g a) (∑ x ∈ S, g x) (f a) (∏ x ∈ S, f x)
        (hf a (Finset.mem_insert_self a S))
        (ih (fun x hx => hf x (Finset.mem_insert_of_mem hx)))
  have hvalM₁'_natCast : ∀ n : ℕ, ((n : ℕ) : M₁') = 0 ∨ (0 : ℤ) ≤ valL F M₁' ((n : ℕ) : M₁') := by
    intro n
    induction n with
    | zero => left; exact Nat.cast_zero
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hvalM₁'_add 0 (n : M₁') 1 ih (Or.inr (by rw [hvalM₁'_1]))

  
  have htr_smul : ∀ (c : M₁') (w : K₁),
      traceLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ c * w) =
        c * traceLM F hM₁'K₁ w := by
    letI : Module M₁' M₁' := Semiring.toModule
    exact fun c w => (Algebra.trace M₁' (IntermediateField.extendScalars hM₁'K₁)).map_smul' c
      (toExtendScalars F hM₁'K₁ w)
  have htr_incl : ∀ c : M₁',
      traceLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ c) = ((p : ℕ) : M₁') * c := by
    intro c
    have h1 : traceLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ c) =
        (Algebra.trace M₁' (IntermediateField.extendScalars hM₁'K₁))
          ((algebraMap M₁' (IntermediateField.extendScalars hM₁'K₁)) c) := rfl
    rw [h1, Algebra.trace_algebraMap, hdegM₁'K₁, nsmul_eq_mul]
  have htr_one : traceLM F hM₁'K₁ 1 = ((p : ℕ) : M₁') := by
    have h := htr_incl 1
    rwa [map_one, mul_one] at h

  
  have hb_val : valL F M₁' b = -(t₁ : ℤ) := by
    rw [hb_def, hval_norm_M₁'K₁, hΔ_val, ← ht₁_def]
  have he_def_val_pos : ∀ a : Fin p, (a : ℕ) ≠ 0 →
      e_def a = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - (a : ℕ) : ℕ) : ℤ) * (t₁ : ℤ) ≤
          valL F M₁' (e_def a) := by
    intro a ha
    have ha_lt : (a : ℕ) < p := a.2
    have hpa_ne : p - (a : ℕ) ≠ p := by omega
    have hpa_mem : p - (a : ℕ) ∈ Finset.Icc 1 (p - 1) :=
      Finset.mem_Icc.mpr ⟨by omega, by omega⟩
    rw [he_def_def, he_fn_def, if_neg hpa_ne]
    have h := he_Δ_val (p - (a : ℕ)) hpa_mem
    rw [← ht₂_def, ← ht₁_def] at h
    exact hvalM₁'_neg1_pow_bound (p - (a : ℕ) - 1) (e_Δ (p - (a : ℕ))) _ h
  have he_def_val_pos' : ∀ a : Fin p, (a : ℕ) ≠ 0 →
      e_def a = 0 ∨
        (((a : ℕ) : ℤ) * (t₁ : ℤ) - (t₁ : ℤ)) +
          ((p - 1 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) ≤ valL F M₁' (e_def a) := by
    intro a ha
    apply hvalM₁'_mono _ _ _ _ (he_def_val_pos a ha)
    have ha_lt : (a : ℕ) < p := a.2
    have hpa : ((p - (a : ℕ) : ℕ) : ℤ) = (p : ℤ) - ((a : ℕ) : ℤ) :=
      Nat.cast_sub (by omega : (a : ℕ) ≤ p)
    have hp1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := Nat.cast_sub (by omega : 1 ≤ p)
    rw [hpa, hp1]
    linarith
  have he_def_val0 : ∀ a : Fin p,
      e_def a = 0 ∨ ((a : ℕ) : ℤ) * (t₁ : ℤ) - (t₁ : ℤ) ≤ valL F M₁' (e_def a) := by
    intro a
    by_cases ha : (a : ℕ) = 0
    · right
      have hpa : p - (a : ℕ) = p := by omega
      rw [he_def_def, hpa, he_fn_def, if_pos rfl, hb_val, ha]
      simp
    · apply hvalM₁'_mono _ _ _ _ (he_def_val_pos' a ha)
      have ht_z : (t₁ : ℤ) ≤ (t₂ : ℤ) := by exact_mod_cast ht_le
      have hdiff : (0 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) :=
        mul_nonneg (by positivity) (by linarith)
      linarith

  
  have hcayley_deficit :
      (Δ : K₁) ^ p =
        ∑ a : Fin p,
          IntermediateField.inclusion hM₁'K₁ (e_def a) * ((Δ : K₁) ^ (a : ℕ)) := by
    have hcayley_eq :
        (Δ : K₁) ^ p =
          IntermediateField.inclusion hM₁'K₁ b -
            ∑ i ∈ Finset.Icc 1 (p - 1),
              (-1 : K₁) ^ i * IntermediateField.inclusion hM₁'K₁ (e_Δ i) * ((Δ : K₁) ^ (p - i)) := by
      rw [hb_def]
      linear_combination -he_Δ_cayley
    change _ = ∑ a : Fin p,
      IntermediateField.inclusion hM₁'K₁ (e_fn (p - (a : ℕ))) * ((Δ : K₁) ^ (a : ℕ))
    rw [Fin.sum_univ_eq_sum_range
      (fun a : ℕ => IntermediateField.inclusion hM₁'K₁ (e_fn (p - a)) * ((Δ : K₁) ^ a)) p]
    have h0_mem : 0 ∈ Finset.range p := Finset.mem_range.mpr hp_pos
    rw [← Finset.add_sum_erase (Finset.range p)
      (fun a : ℕ => IntermediateField.inclusion hM₁'K₁ (e_fn (p - a)) * ((Δ : K₁) ^ a)) h0_mem]
