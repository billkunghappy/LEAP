      have hd_eq : d = (b : L) - (a : L) := by
        dsimp [d]
        exact Nat.cast_sub (le_of_lt hab)
      calc
        (τ_unit b : L) - (τ_unit a : L) = ((b : L) - (a : L)) + ε := by dsimp [ε]; ring
