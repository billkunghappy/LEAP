          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hSpecL_ψ : ∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1)
    (hSpecL_ν : ∀ u ∈ unitGroup F L (condExp F L νE'), νE' u = 1)
    (h2_val : (2 : L) = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L (2 : L))
    (x_0 : L) (hx0_int : x_0 = 0 ∨ 0 ≤ valL F L x_0)
    (hx_x0 : x - IntermediateField.inclusion hLE' x_0 = 0 ∨
      1 ≤ valL F E' (x - IntermediateField.inclusion hLE' x_0))
    (δ_T : Lˣ) (δ_E : E'ˣ)
    (hδ_T_val : valL F L (δ_T : L) = ((condExp F L νE' / 2 : ℕ) : ℤ))
    (hδ_E_val : valL F E' (δ_E : E') = ((condExp F L νE' / 2 : ℕ) : ℤ))
    (hδ_norm : Units.map (normLM F hLE') δ_E = δ_T)
    (r₁ r₂ : L)
    (hr₁_int : r₁ = 0 ∨ 0 ≤ valL F L r₁)
    (hr₂_int : r₂ = 0 ∨ 0 ≤ valL F L r₂) :
    let z := IntermediateField.inclusion hLM₁' r₁ + IntermediateField.inclusion hLM₁' r₂ * d
