      (hΔ_xi_pow_bound m' hm' (p - 1) (by omega)) hterm2
    exact hval_mono _ _ _ (by linarith) hprod
  obtain ⟨hB_trunc_id, hB_deriv_id⟩ := binom_identities
  have hnegL_pow_bound : ∀ r : ℕ, r ≤ p - 2 →
      (-L_val) ^ r = 0 ∨ -(((p - 2 : ℕ) : ℤ) * ((p * p * m : ℕ) : ℤ)) ≤ valL F K₁ ((-L_val) ^ r) := by
    intro r hr
    right
    have hnegL_ne0 : -L_val ≠ 0 := neg_ne_zero.mpr hL_ne0
    rw [hval_pow (-L_val) hnegL_ne0 r, hval_neg, hL_val]
    have hr_le : (r : ℤ) ≤ ((p - 2 : ℕ) : ℤ) := by omega
    have hppm_nonneg : (0 : ℤ) ≤ ((p * p * m : ℕ) : ℤ) := by positivity
    have hmul := mul_le_mul_of_nonneg_right hr_le hppm_nonneg
    linarith
  have hS_trunc : ∀ i ∈ Finset.Icc 1 (p - 1),
      let S_trunc := ∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ i * P_trunc_sub (ξ m')
      let S_trunc_main :=
        ((p - 1 : ℕ) : K₁) *
          (A_star ^ i - (Δ : K₁) ^ i - L_val ^ (p - 1) * (if i = p - 1 then 1 else 0))
      S_trunc - S_trunc_main = 0 ∨
        ((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) -
          ((p - 2 : ℕ) : ℤ) * ((p * p * m : ℕ) : ℤ) - (i : ℤ) * (t₁ : ℤ) ≤
            valL F K₁ (S_trunc - S_trunc_main) := by
    intro i hi S_trunc S_trunc_main
    have hcomm : S_trunc =
        ∑ j ∈ Finset.range (p - 2),
          (-L_val) ^ (j + 1) * (∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ i * (ξ m') ^ (p - 2 - j)) := by
      change (∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ i *
          (∑ j ∈ Finset.range (p - 2), (-L_val) ^ (j + 1) * (ξ m') ^ (p - 2 - j))) = _
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun m' _ => by ring
    have hdiff_eq : S_trunc - S_trunc_main =
        ∑ j ∈ Finset.range (p - 2),
          (-L_val) ^ (j + 1) *
            ((∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ i * (ξ m') ^ (p - 2 - j)) -
              B_main i (p - 2 - j)) := by
      have hid := hB_trunc_id i hi
      change (∑ j ∈ Finset.range (p - 2), (-L_val) ^ (j + 1) * B_main i (p - 2 - j)) = S_trunc_main at hid
      rw [hcomm, ← hid, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun j _ => by ring
    rw [hdiff_eq]
    apply hval_sum (Finset.range (p - 2))
    intro j hj
    rw [Finset.mem_range] at hj
    have hk_mem : p - 2 - j ∈ Finset.range (p - 1) := by
      rw [Finset.mem_range]; omega
    have hB := hB_master i hi (p - 2 - j) hk_mem
    have hprod := hval_mul_bound
      (-(((p - 2 : ℕ) : ℤ) * ((p * p * m : ℕ) : ℤ)))
      (((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) - (i : ℤ) * (t₁ : ℤ))
      ((-L_val) ^ (j + 1))
      ((∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ i * (ξ m') ^ (p - 2 - j)) - B_main i (p - 2 - j))
      (hnegL_pow_bound (j + 1) (by omega)) hB
    exact hval_mono _ _ _ (by linarith) hprod
  have hS_deriv :
      let S_deriv := ∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ (p - 1) * P'_geom (ξ m')
      let S_deriv_main :=
        ((p : ℕ) : K₁) * ((p - 1 : ℕ) : K₁) * (Δ : K₁) ^ (p - 1) * L_val ^ (p - 2) -
          ((p - 1 : ℕ) : K₁) ^ 2 * A_star ^ (p - 2)
      S_deriv - S_deriv_main = 0 ∨
        ((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) -
          ((p - 2 : ℕ) : ℤ) * ((p * p * m : ℕ) : ℤ) -
          ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤ valL F K₁ (S_deriv - S_deriv_main) := by
    intro S_deriv S_deriv_main
    have hcomm : S_deriv =
        - ∑ j ∈ Finset.range (p - 1),
          ((j + 1 : ℕ) : K₁) * (-L_val) ^ j *
            (∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ (p - 1) * (ξ m') ^ (p - 2 - j)) := by
      change (∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ (p - 1) *
          (- ∑ j ∈ Finset.range (p - 1), ((j + 1 : ℕ) : K₁) * (-L_val) ^ j * (ξ m') ^ (p - 2 - j))) = _
      simp_rw [mul_neg, Finset.sum_neg_distrib, Finset.mul_sum]
      rw [Finset.sum_comm]
      congr 1
      refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun m' _ => by ring
    have hdiff_eq : S_deriv - S_deriv_main =
        ∑ j ∈ Finset.range (p - 1),
          - (((j + 1 : ℕ) : K₁) * (-L_val) ^ j *
            ((∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ (p - 1) * (ξ m') ^ (p - 2 - j)) -
              B_main (p - 1) (p - 2 - j))) := by
      change - (∑ j ∈ Finset.range (p - 1), ((j + 1 : ℕ) : K₁) * (-L_val) ^ j * B_main (p - 1) (p - 2 - j)) =
        S_deriv_main at hB_deriv_id
      rw [hcomm, ← hB_deriv_id, sub_neg_eq_add, ← Finset.sum_neg_distrib, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun j _ => by ring
    rw [hdiff_eq]
    apply hval_sum (Finset.range (p - 1))
    intro j hj
    rw [Finset.mem_range] at hj
    have hp1_mem : p - 1 ∈ Finset.Icc 1 (p - 1) := by rw [Finset.mem_Icc]; omega
    have hk_mem : p - 2 - j ∈ Finset.range (p - 1) := by rw [Finset.mem_range]; omega
    have hB := hB_master (p - 1) hp1_mem (p - 2 - j) hk_mem
    have hprod1 := hval_mul_bound 0 (-(((p - 2 : ℕ) : ℤ) * ((p * p * m : ℕ) : ℤ)))
      ((j + 1 : ℕ) : K₁) ((-L_val) ^ j) (hval_natCast (j + 1)) (hnegL_pow_bound j (by omega))
    have hprod2 := hval_mul_bound
      (0 + -(((p - 2 : ℕ) : ℤ) * ((p * p * m : ℕ) : ℤ)))
      (((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ))
      (((j + 1 : ℕ) : K₁) * (-L_val) ^ j)
      ((∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ (p - 1) * (ξ m') ^ (p - 2 - j)) -
        B_main (p - 1) (p - 2 - j))
      hprod1 hB
    exact hval_neg_bound _ _ (hval_mono _ _ _ (by linarith) hprod2)
  have hE_inv1_all : ∀ i ∈ Finset.Icc 1 (p - 1),
      let S1 := ∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ i
      let S1_main :=
        ((p : ℕ) : K₁) * ((Δ : K₁) ^ i) +
          ((p - 1 : ℕ) : K₁) * (if i = p - 1 then 1 else 0)
      let S_inv1 := ∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ i * (L_val + ξ m')⁻¹
      let S_inv1_main :=
        ((p : ℕ) : K₁) * ((Δ : K₁) ^ i) * L_val⁻¹ +
          ((p - 1 : ℕ) : K₁) * A_star ^ i * D_norm⁻¹
      let E_inv1 := (S_inv1 - S_inv1_main) - L_val⁻¹ * (S1 - S1_main)
      E_inv1 = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) + ((2 * p * p * m : ℕ) : ℤ) - (i : ℤ) * (t₁ : ℤ) ≤
          valL F K₁ E_inv1 := by
    intro i hi S1 S1_main S_inv1 S_inv1_main E_inv1
    set S_trunc := ∑ m' ∈ Finset.range p, ((Δ : K₁) + ξ m') ^ i * P_trunc_sub (ξ m')
    set S_trunc_main :=
      ((p - 1 : ℕ) : K₁) *
        (A_star ^ i - (Δ : K₁) ^ i - L_val ^ (p - 1) * (if i = p - 1 then 1 else 0))
    set R_inv1 := (S_inv1 - L_val⁻¹ * S1) - (S_trunc + S1 - (Δ : K₁) ^ i) * D_norm⁻¹
    have hmain1 := (rat_main_term_identities i).1
    change (S_trunc_main + S1_main - (Δ : K₁) ^ i) * D_norm⁻¹ =
