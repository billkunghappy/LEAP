      exact if_neg hj_ne
    rw [h_head, h_tail]
  exact h_lhs.trans h_prod_eq_prod

theorem ld_ch14_odd_p_finite_field_orbit_pigeonhole_and_norm_pow (k_L : Type u) [Field k_L] [Fintype k_L]
    (k_M : Type u) [Field k_M] [Fintype k_M]
    (ι_res : k_L →+* k_M)
    (r_orb : ℕ) (f_i : Fin r_orb → ℕ) (hf_pos : ∀ i : Fin r_orb, 1 ≤ f_i i)
    (k_Fi : Fin r_orb → Type u)
    [∀ i, Field (k_Fi i)] [∀ i, Fintype (k_Fi i)] [∀ i, Algebra k_L (k_Fi i)]
    (hFi_card : ∀ i : Fin r_orb,
      Fintype.card (k_Fi i) = (Fintype.card k_L) ^ (f_i i) ∧
      Module.finrank k_L (k_Fi i) = f_i i)
    (q t k u : ℕ) (hq_ge3 : 3 ≤ q) (hq_odd : Odd q)
    (hk_ge1 : 1 ≤ k) (hqu : q - 1 = k * u)
    (hu_sum : (∑ i : Fin r_orb, f_i i) = u)
    (idx_all : Fin (q - 1) → Fin r_orb)
    (φ_bar : ∀ j : Fin (q - 1), k_Fi (idx_all j) →+* k_M)
    (hφ_alg : ∀ (j : Fin (q - 1)) (a : k_L),
      φ_bar j (algebraMap k_L (k_Fi (idx_all j)) a) = ι_res a)
    (U₀_bar : k_M) (hU₀_ne : U₀_bar ≠ 0)
    (β : Fin (q - 1) → k_M) (hβ_inj : Function.Injective β) (hβ_ne : ∀ j : Fin (q - 1), β j ≠ 0)
    (θ_orb : ∀ i : Fin r_orb, k_Fi i) (hθ_ne : ∀ i : Fin r_orb, θ_orb i ≠ 0)
    (hθ_pow : ∀ j : Fin (q - 1),
      φ_bar j (θ_orb (idx_all j)) * (U₀_bar ^ t) = (β j) ^ k)
    (h_half : ∀ (t' k' : ℕ), t = 2 * t' → k = 2 * k' →
      ∃ θ'_orb : ∀ i : Fin r_orb, k_Fi i,
        ∀ j : Fin (q - 1),
          φ_bar j (θ'_orb (idx_all j)) * (U₀_bar ^ t') = (β j) ^ k') :
    let P_ξ : k_L := ∏ i : Fin r_orb, Algebra.norm k_L (θ_orb i)
    ¬ (2 ∣ t ∧ 2 ∣ k) ∧
    (∀ (i : Fin r_orb) (a : k_Fi i),
      (∏ j : Fin (q - 1),
        if h : idx_all j = i then φ_bar j (h ▸ a) else 1) =
        ι_res ((Algebra.norm k_L a) ^ k)) ∧
    (∏ j : Fin (q - 1), β j) =
      (-1 : k_M) ^ u * (U₀_bar ^ (u * t)) * ι_res P_ξ ∧
    ∃ w : ∀ i : Fin r_orb, Fin (f_i i) → k_M,
      Function.Injective (fun p : Σ i : Fin r_orb, Fin (f_i i) => w p.1 p.2) ∧
      (∀ (i : Fin r_orb) (s : Fin (f_i i)),
        (w i s) ^ (Fintype.card k_L) = w i (finRotate (f_i i) s)) ∧
      (∏ i : Fin r_orb, ∏ s : Fin (f_i i), w i s) = ι_res P_ξ ∧
      (∀ (i₀ : Fin r_orb) (s₀ : Fin (f_i i₀)),
        ∃ j₀ : Fin (q - 1),
          β j₀ * (∏ j ∈ Finset.univ.erase j₀, (β j₀ - β j)) =
            (k : k_M) * (U₀_bar ^ (u * t)) * (w i₀ s₀) *
              (∏ s ∈ Finset.univ.erase s₀, (w i₀ s₀ - w i₀ s)) *
              (∏ i ∈ Finset.univ.erase i₀, ∏ s : Fin (f_i i), (w i₀ s₀ - w i s))) :=
by
  intro P_ξ
  let q_L := Fintype.card k_L
  have hFrobLagrange : ∀ (i : Fin r_orb) (ψ₁ : k_Fi i →+* k_M),
      (∀ c : k_L, ψ₁ (algebraMap k_L (k_Fi i) c) = ι_res c) →
      (∀ (a : k_Fi i) (s : Fin (f_i i)),
        ((ψ₁ a) ^ (q_L ^ (s : ℕ))) ^ q_L =
          (ψ₁ a) ^ (q_L ^ ((finRotate (f_i i) s : Fin (f_i i)) : ℕ))) ∧
      (∀ a : k_Fi i,
        (∏ s : Fin (f_i i), (ψ₁ a) ^ (q_L ^ (s : ℕ))) =
          ι_res (Algebra.norm k_L a)) ∧
      (∀ (ψ₂ : k_Fi i →+* k_M),
        (∀ c : k_L, ψ₂ (algebraMap k_L (k_Fi i) c) = ι_res c) →
        ∀ a : k_Fi i,
          ψ₂ a ∈ Finset.univ.image (fun s : Fin (f_i i) => (ψ₁ a) ^ (q_L ^ (s : ℕ)))) ∧
      (∀ (θ : k_Fi i),
        Function.Injective (fun s : Fin (f_i i) => (ψ₁ θ) ^ (q_L ^ (s : ℕ))) →
        ∀ (ψ₂ : k_Fi i →+* k_M),
          (∀ c : k_L, ψ₂ (algebraMap k_L (k_Fi i) c) = ι_res c) →
          ∀ (s : Fin (f_i i)) (a : k_Fi i),
            ψ₂ θ = (ψ₁ θ) ^ (q_L ^ (s : ℕ)) →
            ψ₂ a = (ψ₁ a) ^ (q_L ^ (s : ℕ))) := by
    intro i ψ₁ hψ₁
    let K := k_Fi i
    let f := f_i i
    have hf_pos_i : 1 ≤ f := hf_pos i
    have hK_card : Fintype.card K = q_L ^ f := (hFi_card i).1
    have hK_finrank : Module.finrank k_L K = f := (hFi_card i).2
    have hfrob_K : ∀ (a : K) (s : Fin f),
        (a ^ (q_L ^ (s : ℕ))) ^ q_L = a ^ (q_L ^ ((finRotate f s : Fin f) : ℕ)) := by
      intro a s
      obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : f ≠ 0)
      revert s hK_card
      change ∀ (hK_card : Fintype.card K = q_L ^ f) (s : Fin f),
        (a ^ (q_L ^ (s : ℕ))) ^ q_L = a ^ (q_L ^ ((finRotate f s : Fin f) : ℕ))
      rw [hn]
      intro hK_card' s
      rw [← pow_mul, ← pow_succ, coe_finRotate]
      split_ifs with h
      · have hs : (s : ℕ) + 1 = n + 1 := by rw [h, Fin.val_last]
        rw [hs, ← hK_card', FiniteField.pow_card, pow_zero, pow_one]
      · rfl
    have hconj1 : ∀ (a : K) (s : Fin f),
        ((ψ₁ a) ^ (q_L ^ (s : ℕ))) ^ q_L =
          (ψ₁ a) ^ (q_L ^ ((finRotate f s : Fin f) : ℕ)) := by
      intro a s
      rw [← map_pow, ← map_pow, hfrob_K a s, map_pow]
    have hconj2 : ∀ a : K,
        (∏ s : Fin f, (ψ₁ a) ^ (q_L ^ (s : ℕ))) =
          ι_res (Algebra.norm k_L a) := by
      intro a
      have hnorm := FiniteField.algebraMap_norm_eq_prod_pow k_L K a
      rw [hK_finrank, Nat.card_eq_fintype_card, ← Fin.prod_univ_eq_prod_range] at hnorm
      have hψ : ι_res (Algebra.norm k_L a) = ∏ s : Fin f, ψ₁ (a ^ (q_L ^ (s : ℕ))) := by
        have h0 := congrArg ψ₁ hnorm
        rw [hψ₁, map_prod] at h0
        exact h0
      rw [hψ]
      refine Finset.prod_congr rfl fun s _ => ?_
      exact (map_pow ψ₁ a (q_L ^ (s : ℕ))).symm
    let Φ : K →+* K := (FiniteField.frobeniusAlgHom k_L K).toRingHom
    have hΦ_apply : ∀ z : K, Φ z = z ^ q_L := by
      intro z
      change FiniteField.frobeniusAlgHom k_L K z = z ^ q_L
      rw [FiniteField.frobeniusAlgHom_apply]
    have hfix_range : ∀ z : K, z ^ q_L = z → ∃ c : k_L, algebraMap k_L K c = z := by
      let I_L : Finset K := Finset.univ.image (algebraMap k_L K)
      let R_fix : Finset K := Finset.univ.filter (fun z : K => z ^ q_L = z)
      have hsub : I_L ⊆ R_fix := by
        intro z hz
        rw [Finset.mem_image] at hz
        rcases hz with ⟨c, _, rfl⟩
        rw [Finset.mem_filter]
        refine ⟨Finset.mem_univ _, ?_⟩
        rw [← map_pow, FiniteField.pow_card]
      have hcard_IL : I_L.card = q_L := by
        rw [Finset.card_image_of_injective _ (algebraMap k_L K).injective, Finset.card_univ]
      have hcard_R : R_fix.card ≤ q_L := by
        let P_fix : Polynomial K := Polynomial.X ^ q_L - Polynomial.X
        have hqL_gt1 : 1 < q_L := Fintype.one_lt_card
        have hP_ne : P_fix ≠ 0 := by
          intro h0
          have hc1 : P_fix.coeff 1 = 0 := by rw [h0, Polynomial.coeff_zero]
          simp only [P_fix, Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_X_one] at hc1
          rw [if_neg (by omega : 1 ≠ q_L), zero_sub, neg_eq_zero] at hc1
          exact one_ne_zero hc1
        have hR_sub : R_fix ⊆ P_fix.roots.toFinset := by
          intro z hz
          rw [Finset.mem_filter] at hz
          rw [Multiset.mem_toFinset, Polynomial.mem_roots hP_ne, Polynomial.IsRoot.def]
          simp [P_fix, hz.2]
        calc R_fix.card ≤ P_fix.roots.toFinset.card := Finset.card_le_card hR_sub
          _ ≤ P_fix.roots.card := Multiset.toFinset_card_le _
          _ ≤ P_fix.natDegree := Polynomial.card_roots' P_fix
          _ ≤ max (Polynomial.X ^ q_L : Polynomial K).natDegree (Polynomial.X : Polynomial K).natDegree :=
              Polynomial.natDegree_sub_le _ _
          _ ≤ q_L := by
              rw [Polynomial.natDegree_X_pow, Polynomial.natDegree_X]
              omega
      have hIL_eq : I_L = R_fix := Finset.eq_of_subset_of_card_le hsub (by omega)
      intro z hz
      have hz_mem : z ∈ I_L := by
        rw [hIL_eq, Finset.mem_filter]
        exact ⟨Finset.mem_univ z, hz⟩
      rw [Finset.mem_image] at hz_mem
      rcases hz_mem with ⟨c, _, hc⟩
      exact ⟨c, hc⟩
    have hpoly_map_eq : ∀ (ψ₂ : K →+* k_M),
        (∀ c : k_L, ψ₂ (algebraMap k_L K c) = ι_res c) →
        ∀ (P : Polynomial K), P.map Φ = P → P.map ψ₂ = P.map ψ₁ := by
      intro ψ₂ hψ₂ P hP
      ext n
      rw [Polynomial.coeff_map, Polynomial.coeff_map]
      have hn : (P.coeff n) ^ q_L = P.coeff n := by
        have hc := congrArg (fun Q : Polynomial K => Q.coeff n) hP
        dsimp only at hc
        rw [Polynomial.coeff_map, hΦ_apply] at hc
        exact hc
      obtain ⟨c, hc⟩ := hfix_range (P.coeff n) hn
      rw [← hc, hψ₂ c, hψ₁ c]
    have hconj3 : ∀ (ψ₂ : K →+* k_M),
        (∀ c : k_L, ψ₂ (algebraMap k_L K c) = ι_res c) →
        ∀ a : K,
          ψ₂ a ∈ Finset.univ.image (fun s : Fin f => (ψ₁ a) ^ (q_L ^ (s : ℕ))) := by
      intro ψ₂ hψ₂ a
      let F_a : Polynomial K := ∏ s : Fin f, (Polynomial.X - Polynomial.C (a ^ (q_L ^ (s : ℕ))))
      have hFa_map : F_a.map Φ = F_a := by
        dsimp only [F_a]
        rw [Polynomial.map_prod]
        have h_step : (∏ s : Fin f, (Polynomial.X - Polynomial.C (a ^ (q_L ^ (s : ℕ)))).map Φ) =
            ∏ s : Fin f, (Polynomial.X - Polynomial.C (a ^ (q_L ^ ((finRotate f s : Fin f) : ℕ)))) := by
          refine Finset.prod_congr rfl fun s _ => ?_
          rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, hΦ_apply, hfrob_K a s]
        rw [h_step]
        exact Equiv.prod_comp (finRotate f)
          (fun s : Fin f => Polynomial.X - Polynomial.C (a ^ (q_L ^ (s : ℕ))))
      have hFa_eval_a : F_a.eval a = 0 := by
        dsimp only [F_a]
        rw [Polynomial.eval_prod]
        apply Finset.prod_eq_zero (Finset.mem_univ (⟨0, hf_pos_i⟩ : Fin f))
        simp
      have h0 : (F_a.map ψ₂).eval (ψ₂ a) = 0 := by
        rw [Polynomial.eval_map, Polynomial.eval₂_hom, hFa_eval_a, map_zero]
      rw [hpoly_map_eq ψ₂ hψ₂ F_a hFa_map] at h0
      have h0' : (∏ s : Fin f, (ψ₂ a - (ψ₁ a) ^ (q_L ^ (s : ℕ)))) = 0 := by
        rw [← h0]
        dsimp only [F_a]
        rw [Polynomial.map_prod, Polynomial.eval_prod]
        refine Finset.prod_congr rfl fun s _ => ?_
        rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C,
          Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, map_pow]
      rw [Finset.prod_eq_zero_iff] at h0'
      rcases h0' with ⟨s, _, hs⟩
      rw [sub_eq_zero] at hs
      rw [Finset.mem_image]
      exact ⟨s, Finset.mem_univ s, hs.symm⟩
    have hconj4 : ∀ (θ : K),
        Function.Injective (fun s : Fin f => (ψ₁ θ) ^ (q_L ^ (s : ℕ))) →
        ∀ (ψ₂ : K →+* k_M),
          (∀ c : k_L, ψ₂ (algebraMap k_L K c) = ι_res c) →
          ∀ (s : Fin f) (a : K),
            ψ₂ θ = (ψ₁ θ) ^ (q_L ^ (s : ℕ)) →
            ψ₂ a = (ψ₁ a) ^ (q_L ^ (s : ℕ)) := by
      intro θ hθ_inj ψ₂ hψ₂ s a hθ_eq
      let x : Fin f → K := fun r => θ ^ (q_L ^ (r : ℕ))
      let y : Fin f → K := fun r => a ^ (q_L ^ (r : ℕ))
      have hx_inj : Function.Injective x := by
        intro r₁ r₂ hr
        apply hθ_inj
        dsimp only
        rw [← map_pow, ← map_pow]
        exact congrArg ψ₁ hr
      have hx_injOn : Set.InjOn x ↑(Finset.univ : Finset (Fin f)) := hx_inj.injOn
      let L_a : Polynomial K := Lagrange.interpolate Finset.univ x y
      have hLa_eval : ∀ r : Fin f, L_a.eval (x r) = y r :=
        fun r => Lagrange.eval_interpolate_at_node y hx_injOn (Finset.mem_univ r)
      have hLa_map : L_a.map Φ = L_a := by
        let D : Polynomial K := L_a.map Φ - L_a
        have hD_eval : ∀ r : Fin f, D.eval (x r) = 0 := by
          intro r
          let r' : Fin f := (finRotate f).symm r
          have hr' : finRotate f r' = r := Equiv.apply_symm_apply (finRotate f) r
          have hxr : x r = Φ (x r') := by
            dsimp only [x]
            rw [hΦ_apply, hfrob_K θ r', hr']
          have hyr : y r = Φ (y r') := by
            dsimp only [y]
            rw [hΦ_apply, hfrob_K a r', hr']
          dsimp only [D]
          rw [Polynomial.eval_sub, hxr, Polynomial.eval_map, Polynomial.eval₂_hom,
            hLa_eval r', ← hyr, ← hxr, hLa_eval r, sub_self]
        have hD_zero : D = 0 := by
          by_contra hD_ne
          have hdeg_La : L_a.degree < ↑(Finset.univ : Finset (Fin f)).card :=
            Lagrange.degree_interpolate_lt y hx_injOn
          rw [Finset.card_univ] at hdeg_La
          have hdeg_D : D.degree < ↑(Fintype.card (Fin f)) :=
            calc D.degree ≤ max (L_a.map Φ).degree L_a.degree := Polynomial.degree_sub_le _ _
              _ ≤ max L_a.degree L_a.degree := max_le_max Polynomial.degree_map_le le_rfl
              _ = L_a.degree := max_self _
              _ < ↑(Fintype.card (Fin f)) := hdeg_La
          have hnatDeg_D : D.natDegree < Fintype.card (Fin f) :=
            (Polynomial.natDegree_lt_iff_degree_lt hD_ne).mpr hdeg_D
          exact hD_ne (Polynomial.eq_zero_of_natDegree_lt_card_of_eval_eq_zero D hx_inj hD_eval hnatDeg_D)
        exact sub_eq_zero.mp hD_zero
      have hLa_ψ : L_a.map ψ₂ = L_a.map ψ₁ := hpoly_map_eq ψ₂ hψ₂ L_a hLa_map
      let r₀ : Fin f := ⟨0, hf_pos_i⟩
      have hLa_θ : L_a.eval θ = a := by
        have h0 := hLa_eval r₀
        dsimp only [x, y, r₀] at h0
        rw [pow_zero, pow_one, pow_one] at h0
        exact h0
      calc ψ₂ a = ψ₂ (L_a.eval θ) := by rw [hLa_θ]
        _ = (L_a.map ψ₂).eval (ψ₂ θ) := by rw [Polynomial.eval_map, Polynomial.eval₂_hom]
        _ = (L_a.map ψ₁).eval ((ψ₁ θ) ^ (q_L ^ (s : ℕ))) := by rw [hLa_ψ, hθ_eq]
        _ = (L_a.map ψ₁).eval (ψ₁ (x s)) := by rw [← map_pow]
        _ = ψ₁ (L_a.eval (x s)) := by rw [Polynomial.eval_map, Polynomial.eval₂_hom]
        _ = ψ₁ (y s) := by rw [hLa_eval s]
        _ = (ψ₁ a) ^ (q_L ^ (s : ℕ)) := map_pow ψ₁ a (q_L ^ (s : ℕ))
    exact ⟨hconj1, hconj2, hconj3, hconj4⟩
  let φ_fiber : ∀ (i : Fin r_orb) (j : Fin (q - 1)), idx_all j = i → (k_Fi i →+* k_M) :=
    fun i j h => h ▸ φ_bar j
  have hφ_fiber_apply : ∀ (i : Fin r_orb) (j : Fin (q - 1)) (h : idx_all j = i) (a : k_Fi i),
      φ_fiber i j h a = φ_bar j (h ▸ a) := by
    intro i j h a
    cases h
    rfl
  have hφ_fiber_alg : ∀ (i : Fin r_orb) (j : Fin (q - 1)) (h : idx_all j = i) (c : k_L),
      φ_fiber i j h (algebraMap k_L (k_Fi i) c) = ι_res c := by
    intro i j h c
    cases h
    exact hφ_alg j c
  let Fiber : Fin r_orb → Finset (Fin (q - 1)) :=
    fun i => Finset.univ.filter (fun j => idx_all j = i)
  have hFiber_sum : (∑ i : Fin r_orb, (Fiber i).card) = q - 1 := by
    have h := Finset.card_eq_sum_card_fiberwise
      (s := (Finset.univ : Finset (Fin (q - 1))))
      (t := (Finset.univ : Finset (Fin r_orb)))
      (f := idx_all)
      (fun j _ => Finset.mem_coe.mpr (Finset.mem_univ (idx_all j)))
    rw [Finset.card_univ, Fintype.card_fin] at h
    exact h.symm
  have h_gen_bound : ∀ (t' k' : ℕ), 1 ≤ k' →
      ∀ (θ'_orb : ∀ i : Fin r_orb, k_Fi i),
      (∀ j : Fin (q - 1), φ_bar j (θ'_orb (idx_all j)) * (U₀_bar ^ t') = (β j) ^ k') →
      let ξ' : Fin (q - 1) → k_M := fun j => (U₀_bar ^ t')⁻¹ * (β j) ^ k'
      (∀ (i : Fin r_orb) (j : Fin (q - 1)) (h : idx_all j = i),
        ξ' j = φ_fiber i j h (θ'_orb i)) ∧
      (∀ i : Fin r_orb, ((Fiber i).image ξ').card ≤ f_i i) ∧
      (∀ b : k_M, (Finset.univ.filter (fun j : Fin (q - 1) => ξ' j = b)).card ≤ k') ∧
      (∀ (i : Fin r_orb) (b : k_M), ((Fiber i).filter (fun j : Fin (q - 1) => ξ' j = b)).card ≤ k') ∧
      (∀ i : Fin r_orb, (Fiber i).card ≤ ((Fiber i).image ξ').card * k') ∧
      q - 1 ≤ k' * u := by
    intro t' k' hk' θ'_orb hθ'_pow ξ'
    have hU' : U₀_bar ^ t' ≠ 0 := pow_ne_zero t' hU₀_ne
    have hξ'_eq : ∀ (i : Fin r_orb) (j : Fin (q - 1)) (h : idx_all j = i),
        ξ' j = φ_fiber i j h (θ'_orb i) := by
      intro i j h
      cases h
      dsimp only [ξ', φ_fiber]
      rw [← hθ'_pow j, mul_comm, mul_inv_cancel_right₀ hU']
    have hS'_le : ∀ i : Fin r_orb, ((Fiber i).image ξ').card ≤ f_i i := by
      intro i
      by_cases hne : (Fiber i).Nonempty
      · let j₀ := hne.choose
        have hj₀_mem : j₀ ∈ Fiber i := hne.choose_spec
        have hj₀ : idx_all j₀ = i := (Finset.mem_filter.mp hj₀_mem).2
        have hsub : (Fiber i).image ξ' ⊆
            Finset.univ.image (fun s : Fin (f_i i) => (φ_fiber i j₀ hj₀ (θ'_orb i)) ^ (q_L ^ (s : ℕ))) := by
          intro b hb
          rcases Finset.mem_image.mp hb with ⟨j, hj_mem, rfl⟩
          have hj : idx_all j = i := (Finset.mem_filter.mp hj_mem).2
          rw [hξ'_eq i j hj]
          exact (hFrobLagrange i (φ_fiber i j₀ hj₀) (hφ_fiber_alg i j₀ hj₀)).2.2.1
            (φ_fiber i j hj) (hφ_fiber_alg i j hj) (θ'_orb i)
        calc ((Fiber i).image ξ').card
            ≤ (Finset.univ.image (fun s : Fin (f_i i) => (φ_fiber i j₀ hj₀ (θ'_orb i)) ^ (q_L ^ (s : ℕ)))).card :=
              Finset.card_le_card hsub
          _ ≤ (Finset.univ : Finset (Fin (f_i i))).card := Finset.card_image_le
          _ = f_i i := by rw [Finset.card_univ, Fintype.card_fin]
      · rw [Finset.not_nonempty_iff_eq_empty] at hne
        rw [hne, Finset.image_empty, Finset.card_empty]
        omega
    have hFall'_le : ∀ b : k_M, (Finset.univ.filter (fun j : Fin (q - 1) => ξ' j = b)).card ≤ k' := by
      intro b
      let F'_all := Finset.univ.filter (fun j : Fin (q - 1) => ξ' j = b)
      let P_b : Polynomial k_M := Polynomial.X ^ k' - Polynomial.C ((U₀_bar ^ t') * b)
