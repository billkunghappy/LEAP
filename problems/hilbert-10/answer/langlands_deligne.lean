    have hv_norm : valuation F (Algebra.norm F (j : L)) = 1 := by
      rw [hj_L_eq, Algebra.norm_algebraMap, map_pow, hv_j, one_pow]
    have hrel_j : relVal F L (j : L) = 0 := haddVal_of_val_eq_one _ hv_norm
    unfold valL
    rw [hrel_j, Int.zero_ediv]
