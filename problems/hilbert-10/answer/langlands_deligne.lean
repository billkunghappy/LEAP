        right
        rw [hk_j_val]
        have hj2_int : (2 : ℤ) ≤ (j : ℤ) := by exact_mod_cast hj2
        have hpm_nonneg : 0 ≤ ((p - 1 : ℕ) : ℤ) * (m : ℤ) := by positivity
