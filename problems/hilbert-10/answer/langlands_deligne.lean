      exact hψ_2α_triv (g_fn z_k + h_fn z_k) (hvalL_add (bE' : ℤ) _ _ hg_val hh_val)
    · 
      intro hk_ne hU1
      rw [← ht₂_def] at hU1
      have hg_val := hg_ne hk_ne
      have hsum := hvalM₁'_add ((p * t₂ + 1 : ℕ) : ℤ) _ _ hU1 hUQ
      have hring :
          iLM₁' X * (iLM₁' (trLM₁' (b ^ k_pow)) - Q k_pow) +
