        Equiv.sum_comp (Equiv.addLeft (Fin.last (p - 1)))
          (fun s : G => ((p - (d₀ s : ℕ) : ℕ) : M₁'))
      rw [hshift, ← Nat.cast_sum, ← Nat.cast_mul]
      congr 1
      have hadd : (∑ s : G, (p - (d₀ s : ℕ))) + (∑ s : G, (d₀ s : ℕ)) = p * p := by
        rw [← Finset.sum_add_distrib]
        have hterm : ∀ s ∈ (Finset.univ : Finset G), (p - (d₀ s : ℕ)) + (d₀ s : ℕ) = p := by
          intro s _
          have hlt : (d₀ s : ℕ) < p := (d₀ s).2
          omega
        rw [Finset.sum_congr rfl hterm, Finset.sum_const, hcard_univ, smul_eq_mul]
      have hpp1 : p * (p - 1) + p = p * p := by
        have hp1 : (p - 1) + 1 = p := Nat.sub_add_cancel hp_pos
        calc p * (p - 1) + p = p * ((p - 1) + 1) := by ring
          _ = p * p := by rw [hp1]
      change (∑ s : G, (p - (d₀ s : ℕ))) + wt d₀ = p * p at hadd
      rw [hd₀_wt, ← hpp1] at hadd
      exact Nat.add_right_cancel hadd
    have hdiff_top_R :
        diff_top = ∑ d₀ ∈ R_mixed, ((p : ℕ) : M₁') * ((p - 1 : ℕ) : M₁') * P_def d₀ := by
      rw [hdiff_top_eq,
        ← Finset.sum_fiberwise_of_maps_to (fun d hd => Finset.mem_image_of_mem rep hd) w_last]
      exact Finset.sum_congr rfl horb_sum
    rw [hdiff_top_R]
    apply hsum_M₁' R_mixed _
      (2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ))
    intro d₀ hd₀
    have hd₀_wt : wt d₀ = p := ((hmem_mixed d₀).mp (R_sub_mixed d₀ hd₀).1).1
    have hP_val := hprod_val_pos (p - 1) p hp_pos d₀ hd₀_wt
    have hp_val' : ((p : ℕ) : M₁') = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤ valL F M₁' ((p : ℕ) : M₁') := by
      rcases hp_valM₁' with hp0 | hge
      · exact Or.inl hp0
      · right
        push_cast at hge
        exact hge
    have h1 := hmul_M₁' (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) 0
      ((p : ℕ) : M₁') ((p - 1 : ℕ) : M₁') hp_val' (hnat_M₁' (p - 1))
    have h2 := hmul_M₁'
      (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) + 0)
      (((p : ℤ) - (((p - 1) + 1 : ℕ) : ℤ)) * (t₁ : ℤ) +
        ((p - 1 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)))
      (((p : ℕ) : M₁') * ((p - 1 : ℕ) : M₁'))
      (P_def d₀) h1 hP_val
    rcases h2 with h0 | hge
    · exact Or.inl h0
    · right
      have hp1_int : (((p - 1) + 1 : ℕ) : ℤ) = (p : ℤ) := by omega
      rw [hp1_int] at hge
      linarith

theorem ld_ch12_wild_odd_tot_ram_pk_qk_tuple_comparison (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (e_Δ : ℕ → M₁')
    (he_Δ_val : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      e_Δ i = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (e_Δ i))
    (he_Δ_poly : ∀ c : M₁',
      normLM F hM₁'K₁ (1 + IntermediateField.inclusion hM₁'K₁ c * (Δ : K₁)) =
        1 + (∑ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
          c ^ i * e_Δ i) +
          c ^ (Module.finrank L (IntermediateField.extendScalars hLE')) *
            normLM F hM₁'K₁ (Δ : K₁))
    (he_Δ_cayley :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ : K₁)) -
        ((Δ : K₁) ^ p +
          ∑ i ∈ Finset.Icc 1 (p - 1),
            (-1 : K₁) ^ i * IntermediateField.inclusion hM₁'K₁ (e_Δ i) * ((Δ : K₁) ^ (p - i))) = 0)
    (τ_unit : ℕ → Lˣ)
    (hτ_val0 : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'), 0 < m →
      valL F L (τ_unit m : L) = 0)
    (hτ_p1 : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'), 0 < m →
      (τ_unit m : L) ^ (Module.finrank L (IntermediateField.extendScalars hLE') - 1) - 1 = 0 ∨
        ((3 * Module.finrank L (IntermediateField.extendScalars hLE') *
          (2 * bM₁' - 1 + Module.finrank L (IntermediateField.extendScalars hLE') *
            (bE' - bM₁')) + 1 : ℕ) : ℤ) ≤
          valL F L ((τ_unit m : L) ^
            (Module.finrank L (IntermediateField.extendScalars hLE') - 1) - 1))
    (hτ_pow_sum : ∀ r ∈ Finset.Icc 1 (2 * (Module.finrank L (IntermediateField.extendScalars hLE') - 1)),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      (∑ m ∈ (Finset.range p).erase 0,
          IntermediateField.inclusion hLM₁' (τ_unit m : L) ^ r) -
        (if (p - 1) ∣ r then ((p - 1 : ℕ) : M₁') else 0) = 0 ∨
        ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
          valL F M₁'
            ((∑ m ∈ (Finset.range p).erase 0,
                IntermediateField.inclusion hLM₁' (τ_unit m : L) ^ r) -
              (if (p - 1) ∣ r then ((p - 1 : ℕ) : M₁') else 0)))
    (hNewton :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      let t₂ := bE' - 1
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let e_fn : ℕ → M₁' := fun i => if i = p then b else (-1 : M₁') ^ (i - 1) * e_Δ i
      ∀ D ∈ Finset.Icc 1 p,
        traceLM F hM₁'K₁ ((Δ : K₁) ^ D) - ((D : ℕ) : M₁') * e_fn D = 0 ∨
          2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (D : ℤ) * (t₁ : ℤ) ≤
            valL F M₁' (traceLM F hM₁'K₁ ((Δ : K₁) ^ D) - ((D : ℕ) : M₁') * e_fn D))
    (hClaimA :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      let t₂ := bE' - 1
      ∀ D : ℕ,
        traceLM F hM₁'K₁ ((Δ : K₁) ^ D) = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (D : ℤ) * (t₁ : ℤ) ≤
            valL F M₁' (traceLM F hM₁'K₁ ((Δ : K₁) ^ D)))
    (hClaimB :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      let t₂ := bE' - 1
      ∀ D : ℕ, p ≤ D →
        traceLM F hM₁'K₁ ((Δ : K₁) ^ D) = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (D : ℤ) * (t₁ : ℤ) +
            ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ) ≤
              valL F M₁' (traceLM F hM₁'K₁ ((Δ : K₁) ^ D))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    let t₂ := bE' - 1
    let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
    let d₁ := m₁ / 2
    let b := normLM F hM₁'K₁ (Δ : K₁)
    ∀ (j : Fin p) (x : E'),
      1 ≤ (j : ℕ) → (j : ℕ) ≤ p - 2 →
      (x = 0 ∨ (d₁ : ℤ) ≤ (p : ℤ) * valL F E' x - (j : ℤ) * (t₁ : ℤ)) →
      let k := (j : ℕ) + 1
      let X := normLM F hLE' x
      let P_k := b ^ k +
        ∑ m ∈ (Finset.range p).erase 0,
          normLM F hM₁'K₁
            ((Δ : K₁) + IntermediateField.inclusion hM₁'K₁
              (IntermediateField.inclusion hLM₁' (τ_unit m : L))) ^ k
      let Q_k := traceLM F hM₁'K₁ (((Δ : K₁) ^ p - (Δ : K₁)) ^ k)
      ((j : ℕ) ≠ p - 2 →
        IntermediateField.inclusion hLM₁' X * (P_k - Q_k) = 0 ∨
          ((p * t₂ + 1 : ℕ) : ℤ) ≤
            valL F M₁' (IntermediateField.inclusion hLM₁' X * (P_k - Q_k))) ∧
      ((j : ℕ) = p - 2 →
        IntermediateField.inclusion hLM₁' X *
          (P_k - Q_k - ((p - 1 : ℕ) : M₁') * (1 - (- e_Δ (p - 1)) ^ p)) = 0 ∨
          ((p * t₂ + 1 : ℕ) : ℤ) ≤
            valL F M₁'
              (IntermediateField.inclusion hLM₁' X *
                (P_k - Q_k - ((p - 1 : ℕ) : M₁') * (1 - (- e_Δ (p - 1)) ^ p)))) :=
by
  intro p t₁ t₂ m₁ d₁ b
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
  have ht₂_ge1 : 1 ≤ t₂ := by dsimp [t₂]; omega
  have ht_le : t₁ ≤ t₂ := by dsimp [t₁, t₂]; omega
  have hvalM₁'_1 := hvalM₁'_props.2.1
  have hvalM₁'_neg := hvalM₁'_props.2.2.2.1
  have hvalM₁'_mul := hvalM₁'_props.2.2.2.2.1
  have hvalM₁'_surj := hvalM₁'_props.2.2.2.2.2.2.1
  have hvalM₁'_add := hvalM₁'_props.2.2.2.2.2.2.2.1
  have hvalM₁'_sub : ∀ (B : ℤ) (x y : M₁'),
      (x = 0 ∨ B ≤ valL F M₁' x) → (y = 0 ∨ B ≤ valL F M₁' y) →
      (x - y = 0 ∨ B ≤ valL F M₁' (x - y)) := by
    intro B x y hx hy
    have hy' : -y = 0 ∨ B ≤ valL F M₁' (-y) := by
      rcases hy with rfl | hy
      · exact Or.inl neg_zero
      · exact Or.inr (by rwa [hvalM₁'_neg])
    have h := hvalM₁'_add B x (-y) hx hy'
    rwa [← sub_eq_add_neg] at h
  have hvalM₁'_pow : ∀ (z : M₁') (n : ℕ), z ≠ 0 →
      valL F M₁' (z ^ n) = (n : ℤ) * valL F M₁' z := by
    intro z n hz
    induction n with
    | zero => simp [hvalM₁'_1]
    | succ n ih =>
      rw [pow_succ, hvalM₁'_mul (z ^ n) z (pow_ne_zero n hz) hz, ih]
      push_cast
      ring
  have hvalM₁'_sum : ∀ (S : Finset ℕ) (f : ℕ → M₁') (B : ℤ),
      (∀ i ∈ S, f i = 0 ∨ B ≤ valL F M₁' (f i)) →
      ((∑ i ∈ S, f i) = 0 ∨ B ≤ valL F M₁' (∑ i ∈ S, f i)) := by
    intro S f B hf
    induction S using Finset.induction_on with
    | empty => exact Or.inl Finset.sum_empty
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact hvalM₁'_add B (f a) (∑ i ∈ s, f i)
        (hf a (Finset.mem_insert_self a s))
        (ih fun i hi => hf i (Finset.mem_insert_of_mem hi))
  have hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) = p := by
    obtain ⟨c, hc⟩ := hvalM₁'_surj 1
    have hc_ne : (c : M₁') ≠ 0 := Units.ne_zero c
    let d := Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁)
    have hnorm_c : normLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ (c : M₁')) = (c : M₁') ^ d := by
      change Algebra.norm M₁' (algebraMap M₁' (IntermediateField.extendScalars hM₁'K₁) (c : M₁')) = (c : M₁') ^ d
      exact Algebra.norm_algebraMap (c : M₁')
    have hval1 : valL F M₁' (normLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ (c : M₁'))) = (p : ℤ) := by
      rw [hval_norm_M₁'K₁, hval_M₁'K₁ (c : M₁'), hc, mul_one]
    have hval2 : valL F M₁' ((c : M₁') ^ d) = (d : ℤ) := by
      rw [hvalM₁'_pow (c : M₁') d hc_ne, hc, mul_one]
    have heq : (p : ℤ) = (d : ℤ) := by rw [← hval1, hnorm_c, hval2]
    exact_mod_cast heq.symm
  have hp_valM₁' : ((p : ℕ) : M₁') = 0 ∨
      (((p - 1) * t₂ : ℕ) : ℤ) ≤ valL F M₁' ((p : ℕ) : M₁') := by
    have hincl_p : IntermediateField.inclusion hM₁'K₁ ((p : ℕ) : M₁') = ((p : ℕ) : K₁) :=
      map_natCast (IntermediateField.inclusion hM₁'K₁) p
    rcases hp_valK₁ with hp0 | hple
    · left
      have h0 : IntermediateField.inclusion hM₁'K₁ ((p : ℕ) : M₁') =
          IntermediateField.inclusion hM₁'K₁ 0 := by
        rw [hincl_p, map_zero]
        exact hp0
      exact (IntermediateField.inclusion hM₁'K₁).injective h0
    · right
      have hval_p : valL F K₁ ((p : ℕ) : K₁) = (p : ℤ) * valL F M₁' ((p : ℕ) : M₁') := by
        rw [← hincl_p, hval_M₁'K₁]
      rw [hval_p] at hple
      have hple' : (p : ℤ) * (((p - 1) * t₂ : ℕ) : ℤ) ≤ (p : ℤ) * valL F M₁' ((p : ℕ) : M₁') := by
        calc (p : ℤ) * (((p - 1) * t₂ : ℕ) : ℤ)
            = ((p * (p - 1) * (bE' - 1) : ℕ) : ℤ) := by dsimp [t₂]; push_cast; ring
          _ ≤ (p : ℤ) * valL F M₁' ((p : ℕ) : M₁') := hple
      exact le_of_mul_le_mul_left hple' (by positivity)
  let e_fn : ℕ → M₁' := fun i => if i = p then b else (-1 : M₁') ^ (i - 1) * e_Δ i
  let e_def : Fin p → M₁' := fun a => e_fn (p - (a : ℕ))
  let S_prod : ℕ → ℕ → M₁' := fun v w =>
    ∑ d ∈ (Finset.univ : Finset (Fin (v + 1) → Fin p)).filter
        (fun d => (∑ s : Fin (v + 1), (d s : ℕ)) = w),
      ∏ s : Fin (v + 1), e_def (d s)
  let S_last : ℕ → ℕ → M₁' := fun v w =>
    ∑ d ∈ (Finset.univ : Finset (Fin (v + 1) → Fin p)).filter
        (fun d => (∑ s : Fin (v + 1), (d s : ℕ)) = w),
      ((p - (d (Fin.last v) : ℕ) : ℕ) : M₁') * ∏ s : Fin (v + 1), e_def (d s)
  have hval_neg_one_pow : ∀ (n : ℕ) (z : M₁'),
      ((-1 : M₁') ^ n * z = 0 ↔ z = 0) ∧ valL F M₁' ((-1 : M₁') ^ n * z) = valL F M₁' z := by
    intro n z
    rcases neg_one_pow_eq_or M₁' n with h1 | hneg1
    · rw [h1, one_mul]
      exact ⟨Iff.rfl, rfl⟩
    · rw [hneg1, neg_one_mul, neg_eq_zero, hvalM₁'_neg]
      exact ⟨Iff.rfl, rfl⟩
  have he_def_val_pos : ∀ a : Fin p, (a : ℕ) ≠ 0 →
      e_def a = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - (a : ℕ) : ℕ) : ℤ) * (t₁ : ℤ) ≤
          valL F M₁' (e_def a) := by
    intro a ha
    have ha_lt : (a : ℕ) < p := a.isLt
    have hi_mem : p - (a : ℕ) ∈ Finset.Icc 1 (p - 1) := by
      rw [Finset.mem_Icc]
      omega
    have hi_ne_p : p - (a : ℕ) ≠ p := by omega
    have hdef : e_def a = (-1 : M₁') ^ (p - (a : ℕ) - 1) * e_Δ (p - (a : ℕ)) := by
      dsimp [e_def, e_fn]
      rw [if_neg hi_ne_p]
    rw [hdef, (hval_neg_one_pow _ _).1, (hval_neg_one_pow _ _).2]
    exact he_Δ_val (p - (a : ℕ)) hi_mem
  have he_def_val0 : ∀ a : Fin p,
      e_def a = 0 ∨ ((a : ℕ) : ℤ) * (t₁ : ℤ) - (t₁ : ℤ) ≤ valL F M₁' (e_def a) := by
    intro a
    by_cases ha : (a : ℕ) = 0
    · right
      have hdef : e_def a = b := by
        dsimp [e_def, e_fn]
        rw [ha, Nat.sub_zero, if_pos rfl]
      have hb_val : valL F M₁' b = -(t₁ : ℤ) := by
        dsimp [b, t₁]
        rw [hval_norm_M₁'K₁, hΔ_val]
      rw [hdef, hb_val, ha]
      ring_nf
      exact le_refl _
    · rcases he_def_val_pos a ha with h0 | hle
      · exact Or.inl h0
      · right
        have ha_lt : (a : ℕ) < p := a.isLt
        have hsub : ((p - (a : ℕ) : ℕ) : ℤ) = (p : ℤ) - ((a : ℕ) : ℤ) := by omega
        have hp1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
        have h1 : ((a : ℕ) : ℤ) * (t₁ : ℤ) - (t₁ : ℤ) ≤
            ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - (a : ℕ) : ℕ) : ℤ) * (t₁ : ℤ) := by
          rw [hsub, hp1]
          have h2 : ((p : ℤ) - 1) * (t₁ : ℤ) ≤ ((p : ℤ) - 1) * (t₂ : ℤ) :=
            mul_le_mul_of_nonneg_left (by exact_mod_cast ht_le) (by omega)
          linarith
        exact le_trans h1 hle
  let d_one : Fin p := ⟨1, hPrime.one_lt⟩
  have he_def_one : e_def d_one = - e_Δ (p - 1) := by
    have hp1_ne_p : p - 1 ≠ p := by omega
    have hdef : e_def d_one = (-1 : M₁') ^ (p - 1 - 1) * e_Δ (p - 1) := by
      dsimp [e_def, e_fn, d_one]
      rw [if_neg hp1_ne_p]
    have hp_odd_prop : Odd p := hPrime.odd_of_ne_two hp_odd
    have hp2_odd : Odd (p - 1 - 1) := by
      rcases hp_odd_prop with ⟨m, hm⟩
      refine ⟨m - 1, ?_⟩
      omega
    rw [hdef, hp2_odd.neg_one_pow, neg_one_mul]
  have hP_exp := ld_ch12_wild_odd_tot_ram_pk_deficit_tuple_expansion F L M₁' K₁
    hLM₁' hM₁'K₁ p hPrime hp_odd hdegM₁'K₁ bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le
    hvalM₁'_props hval_LM₁' hval_norm_M₁'K₁ Δ hΔ_val e_Δ he_Δ_val he_Δ_poly
    τ_unit hτ_val0 hτ_p1 hτ_pow_sum
  have hQ_exp := ld_ch12_wild_odd_tot_ram_qk_deficit_tuple_expansion F M₁' K₁
    hM₁'K₁ p hPrime hp_odd hdegM₁'K₁ bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le
    hvalM₁'_props hval_norm_M₁'K₁ Δ hΔ_val e_Δ he_Δ_val he_Δ_cayley hNewton hClaimB
  obtain ⟨hSwap, hOrbit⟩ := ld_ch12_wild_odd_tot_ram_deficit_tuple_swap_and_cyclic_orbit F M₁'
    p hPrime hp_odd t₁ t₂ ht₁_ge1 ht_le hp_valM₁' hvalM₁'_props e_def he_def_val0 he_def_val_pos
  intro j x hj1 hj2 hx k X P_k Q_k
  rcases eq_or_ne x 0 with rfl | hx_ne
  · have hX0 : X = 0 := by
      change Algebra.norm L (algebraMap L (IntermediateField.extendScalars hLE') 0) = 0
      rw [Algebra.norm_algebraMap, zero_pow hPrime.ne_zero]
    refine ⟨fun _ => Or.inl ?_, fun _ => Or.inl ?_⟩ <;> simp [hX0]
  have hx_val : (d₁ : ℤ) ≤ (p : ℤ) * valL F E' x - (j : ℤ) * (t₁ : ℤ) := hx.resolve_left hx_ne
  let B_k : ℤ := 2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (k : ℤ) * (t₁ : ℤ)
  have hmul_X : ∀ (Y : M₁'),
      (Y = 0 ∨ B_k ≤ valL F M₁' Y) →
      (IntermediateField.inclusion hLM₁' X * Y = 0 ∨
        ((p * t₂ + 1 : ℕ) : ℤ) ≤ valL F M₁' (IntermediateField.inclusion hLM₁' X * Y)) := by
    intro Y hY
    by_cases hX_zero : IntermediateField.inclusion hLM₁' X = 0
    · exact Or.inl (by rw [hX_zero, zero_mul])
    · rcases hY with rfl | hY_val
      · exact Or.inl (mul_zero _)
      · by_cases hY_zero : Y = 0
        · exact Or.inl (by rw [hY_zero, mul_zero])
        · right
          have hval_X : valL F M₁' (IntermediateField.inclusion hLM₁' X) = (p : ℤ) * valL F E' x := by
            rw [hval_LM₁' X, hval_norm_LE' x]
          rw [hvalM₁'_mul _ _ hX_zero hY_zero, hval_X]
          have hd₁_ge : (t₁ : ℤ) ≤ (d₁ : ℤ) := by
            exact_mod_cast (show t₁ ≤ d₁ by dsimp [d₁, m₁, t₁]; omega)
          have hk_def : (k : ℤ) = (j : ℤ) + 1 := by dsimp [k]
          have hpt₂ : ((p * t₂ + 1 : ℕ) : ℤ) ≤ 2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) := by
            have hp1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
            have htarget_cast : ((p * t₂ + 1 : ℕ) : ℤ) = (p : ℤ) * (t₂ : ℤ) + 1 := by push_cast; ring
            rw [hp1_cast, htarget_cast]
            nlinarith [show (3 : ℤ) ≤ (p : ℤ) by exact_mod_cast hp_ge3,
                       show (1 : ℤ) ≤ (t₂ : ℤ) by exact_mod_cast ht₂_ge1]
          dsimp [B_k] at hY_val
          rw [hk_def] at hY_val
          linarith
  have hk_mem : k ∈ Finset.Icc 2 (p - 1) := by
    rw [Finset.mem_Icc]
    dsimp [k]
    omega
  let P_main : M₁' := ((p : ℕ) : M₁') * b ^ k +
    (if k = p - 1 then ((p - 1 : ℕ) : M₁') else 0) +
    ∑ v ∈ Finset.range (k + 1),
      (-1 : M₁') ^ (p - k + v) * ((p - 1 : ℕ) : M₁') *
        ((k.choose (v + 1) : ℕ) : M₁') * S_prod v (p - k + v)
  let Q_main : M₁' := ((p : ℕ) : M₁') * b ^ k +
    ∑ v ∈ Finset.range (k + 1),
      (-1 : M₁') ^ (k - v) * ((k.choose v : ℕ) : M₁') * S_last v (p - k + v)
  let diff_fn : ℕ → M₁' := fun v =>
    (-1 : M₁') ^ (p - k + v) * ((p - 1 : ℕ) : M₁') *
        ((k.choose (v + 1) : ℕ) : M₁') * S_prod v (p - k + v) -
      (-1 : M₁') ^ (k - v) * ((k.choose v : ℕ) : M₁') * S_last v (p - k + v)
  have hPQ_err : (P_k - P_main) - (Q_k - Q_main) = 0 ∨
      B_k ≤ valL F M₁' ((P_k - P_main) - (Q_k - Q_main)) :=
    hvalM₁'_sub B_k (P_k - P_main) (Q_k - Q_main) (hP_exp k hk_mem) (hQ_exp k hk_mem)
  refine ⟨fun hj_ne => hmul_X (P_k - Q_k) ?_, fun hj_eq => hmul_X _ ?_⟩
  · have hk_ne : k ≠ p - 1 := by dsimp [k]; omega
    have hsum_diff : (∑ v ∈ Finset.range (k + 1), diff_fn v) = 0 ∨
        B_k ≤ valL F M₁' (∑ v ∈ Finset.range (k + 1), diff_fn v) := by
      apply hvalM₁'_sum (Finset.range (k + 1)) diff_fn B_k
      intro v hv
      rw [Finset.mem_range] at hv
      exact hSwap k hk_mem v (by omega) (by dsimp [k] at hv; omega)
    have hcomb := hvalM₁'_add B_k ((P_k - P_main) - (Q_k - Q_main))
      (∑ v ∈ Finset.range (k + 1), diff_fn v) hPQ_err hsum_diff
    have hring : ((P_k - P_main) - (Q_k - Q_main)) +
        (∑ v ∈ Finset.range (k + 1), diff_fn v) = P_k - Q_k := by
      dsimp only [P_main, Q_main, diff_fn]
      rw [if_neg hk_ne, Finset.sum_sub_distrib]
      ring
    rwa [hring] at hcomb
  · have hk_eq : k = p - 1 := by dsimp [k]; omega
    have hsum_low : (∑ v ∈ Finset.range (p - 1), diff_fn v) = 0 ∨
        B_k ≤ valL F M₁' (∑ v ∈ Finset.range (p - 1), diff_fn v) := by
      apply hvalM₁'_sum (Finset.range (p - 1)) diff_fn B_k
      intro v hv
      rw [Finset.mem_range] at hv
      exact hSwap k hk_mem v (by omega) (by omega)
    have hOrbit' : S_last (p - 1) p - ((p - 1 : ℕ) : M₁') * (e_def d_one) ^ p = 0 ∨
        B_k ≤ valL F M₁' (S_last (p - 1) p - ((p - 1 : ℕ) : M₁') * (e_def d_one) ^ p) := by
      dsimp [B_k]
      rw [hk_eq]
      exact hOrbit
    have hmain_diff := hvalM₁'_sub B_k (∑ v ∈ Finset.range (p - 1), diff_fn v)
      (S_last (p - 1) p - ((p - 1 : ℕ) : M₁') * (e_def d_one) ^ p) hsum_low hOrbit'
    have hcomb := hvalM₁'_add B_k ((P_k - P_main) - (Q_k - Q_main)) _ hPQ_err hmain_diff
    have htop_term : diff_fn (p - 1) = - S_last (p - 1) p := by
      dsimp only [diff_fn]
      have hchoose0 : k.choose (p - 1 + 1) = 0 :=
        Nat.choose_eq_zero_of_lt (by omega)
      have hchoose1 : k.choose (p - 1) = 1 := by
        rw [hk_eq]
        exact Nat.choose_self (p - 1)
      have hsub0 : k - (p - 1) = 0 := by omega
      have hweight_p : p - k + (p - 1) = p := by omega
      rw [hchoose0, hchoose1, hsub0, hweight_p]
      simp
    have hsum_split : ∑ v ∈ Finset.range (k + 1), diff_fn v =
        (∑ v ∈ Finset.range (p - 1), diff_fn v) - S_last (p - 1) p := by
      rw [hk_eq, Finset.sum_range_succ, htop_term, sub_eq_add_neg]
    have hring : ((P_k - P_main) - (Q_k - Q_main)) +
        ((∑ v ∈ Finset.range (p - 1), diff_fn v) -
          (S_last (p - 1) p - ((p - 1 : ℕ) : M₁') * (e_def d_one) ^ p)) =
        P_k - Q_k - ((p - 1 : ℕ) : M₁') * (1 - (- e_Δ (p - 1)) ^ p) := by
      have hPM_QM : P_main - Q_main =
          ((p - 1 : ℕ) : M₁') + ∑ v ∈ Finset.range (k + 1), diff_fn v := by
        dsimp only [P_main, Q_main, diff_fn]
        rw [if_pos hk_eq, Finset.sum_sub_distrib]
        ring
      have h1 : (P_k - P_main) - (Q_k - Q_main) = (P_k - Q_k) - (P_main - Q_main) := by ring
      rw [h1, hPM_QM, hsum_split, he_def_one]
      ring
    rwa [hring] at hcomb

theorem ld_ch12_wild_odd_totally_ramified_weighted_norm_trace_congr_scaled (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (bE' bM₁' : ℕ) (hbE'_eq : condExp F L νE' = bE') (hbM₁'_eq : condExp F L νM₁' = bM₁')
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣ (bM₁' - 1)))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (htr_LM₁' : ∀ (m : ℤ) (z : M₁'),
      (z = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bM₁' : ℤ) ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (htr_E'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bM₁' : ℤ) ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (htr_M₁'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (((bM₁' - 1) + Module.finrank L (IntermediateField.extendScalars hLE') *
              (bE' - bM₁') + 1 : ℕ) : ℤ) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)))
    (hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y))
    (hDiamond_M₁' : ∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z))
    (hTowerNormTr : ∀ w : K₁,
      normLM F hLE' (normLM F hE'K₁ w) = normLM F hLM₁' (normLM F hM₁'K₁ w) ∧
      traceLM F hLE' (traceLM F hE'K₁ w) = traceLM F hLM₁' (traceLM F hM₁'K₁ w))
    (hGalLift : ∀ τ : M₁' ≃ₐ[F] M₁',
      (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) →
      ∃ τ_lift : K₁ ≃ₐ[F] K₁,
        (∀ y : E', τ_lift (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hE'K₁ y) ∧
        (∀ z : M₁', τ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ (τ z)) ∧
        (∀ w : K₁, valL F K₁ (τ_lift w) = valL F K₁ w) ∧
        (∀ w : K₁,
          normLM F hE'K₁ (τ_lift w) = normLM F hE'K₁ w ∧
