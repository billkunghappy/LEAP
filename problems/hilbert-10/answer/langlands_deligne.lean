      dsimp only [M_cap₀] at hvR
      have hnonneg :
          (0 : ℤ) ≤ ((p₀ - 1 : ℕ) : ℤ) *
            (((bM₁' - 1) + p₀ * (bE' - bM₁') + 1 : ℕ) : ℤ) := by positivity
      have hpt₁ : (0 : ℤ) ≤ (p₀ : ℤ) * (t₁ : ℤ) := by positivity
      have hexp :
          (p₀ : ℤ) * (((p₀ - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (t₁ : ℤ) + vY) =
          (p₀ : ℤ) * (((p₀ - 1 : ℕ) : ℤ) * (t₂ : ℤ) + 1) - (p₀ : ℤ) -
            (p₀ : ℤ) * (t₁ : ℤ) + (p₀ : ℤ) * vY := by ring
      rw [hexp]
      linarith
    · intro vu vw vtr huv hB
      rw [hcast_req, hcast_pm]
      have hpB :
          (p₀ : ℤ) * (((p₀ - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (t₁ : ℤ) +
            (((p₀ - 1 : ℕ) : ℤ) * (m_exp : ℤ) - vu)) ≤
            (p₀ : ℤ) * ((p₀ : ℤ) * vtr + vw) :=
        mul_le_mul_of_nonneg_left hB (by omega)
      have hexp :
          (p₀ : ℤ) * ((p₀ : ℤ) * vtr + vw) =
            (p₀ : ℤ) * ((p₀ : ℤ) * vtr) + (p₀ : ℤ) * vw := by ring
      have hexp2 :
          (p₀ : ℤ) * (((p₀ - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (t₁ : ℤ) +
            (((p₀ - 1 : ℕ) : ℤ) * (m_exp : ℤ) - vu)) =
          (p₀ : ℤ) * ((p₀ - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (p₀ : ℤ) * (t₁ : ℤ) +
            ((p₀ - 1 : ℕ) : ℤ) * ((p₀ : ℤ) * (m_exp : ℤ)) -
            (p₀ : ℤ) * vu := by ring
      rw [hexp, hexp2] at hpB
      linarith
  obtain ⟨h_case1_ineq, h_rk_ineq, h_R_ge_ineq, h_tr2_ineq, h_case2_ineq⟩ :=
    h_arith_gen p hp_ge3 hpm_gt_t₁
  have hval_LM₁'' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) = (p : ℤ) * valL F L x := hval_LM₁'
  have hval_E'K₁' : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) = (p : ℤ) * valL F E' y := hval_E'K₁
  have hval_M₁'K₁' : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) = (p : ℤ) * valL F M₁' z := hval_M₁'K₁
  obtain ⟨hvalE'_one, _, hvalE'_mul, hvalE'_inv, _⟩ := hval_props E'
  obtain ⟨_, hvalM₁'_neg, _, _, hvalM₁'_add⟩ := hval_props M₁'
  obtain ⟨_, _, hvalK₁_mul, _, hvalK₁_add⟩ := hval_props K₁
  have hvalE'_pow : ∀ (y : E'), y ≠ 0 → ∀ (n : ℕ),
      valL F E' (y ^ n) = (n : ℤ) * valL F E' y := by
    intro y hy n
    induction n with
    | zero =>
      rw [pow_zero, hvalE'_one, Nat.cast_zero, zero_mul]
    | succ n ih =>
      rw [pow_succ, hvalE'_mul (y ^ n) y (pow_ne_zero n hy) hy, ih]
      push_cast
      ring
  have hvalK₁_sum : ∀ (s : Finset (Fin p)) (f : Fin p → K₁) (B : ℤ),
      (∀ i ∈ s, f i = 0 ∨ B ≤ valL F K₁ (f i)) →
      (∑ i ∈ s, f i) = 0 ∨ B ≤ valL F K₁ (∑ i ∈ s, f i) := by
    intro s f B hs
    induction s using Finset.induction_on with
    | empty =>
      exact Or.inl Finset.sum_empty
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_val : f a = 0 ∨ B ≤ valL F K₁ (f a) :=
        hs a (Finset.mem_insert_self a s)
      have hs_val : (∑ i ∈ s, f i) = 0 ∨ B ≤ valL F K₁ (∑ i ∈ s, f i) :=
        ih (fun i hi => hs i (Finset.mem_insert_of_mem hi))
      exact hvalK₁_add B (f a) (∑ i ∈ s, f i) ha_val hs_val
  set Y₀ : E' := ((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)
  set w_pow : K₁ := IntermediateField.inclusion hE'K₁ Y₀
  have hw₂_inv_ne0 : ((w₂⁻¹ : E'ˣ) : E') ≠ 0 := Units.ne_zero w₂⁻¹
  have hY₀_ne0 : Y₀ ≠ 0 := pow_ne_zero (p - 1) hw₂_inv_ne0
  have hY₀_val : valL F E' Y₀ = ((p - 1 : ℕ) : ℤ) * (m_exp : ℤ) := by
    change valL F E' (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) = ((p - 1 : ℕ) : ℤ) * (m_exp : ℤ)
    rw [hvalE'_pow ((w₂⁻¹ : E'ˣ) : E') hw₂_inv_ne0 (p - 1), hvalE'_inv w₂, hw₂_val]
    ring
  have hw_pow_ne0 : w_pow ≠ 0 :=
    (map_ne_zero_iff (IntermediateField.inclusion hE'K₁)
      (IntermediateField.inclusion hE'K₁).injective).mpr hY₀_ne0
  have hw_pow_val : valL F K₁ w_pow =
      (p : ℤ) * (((p - 1 : ℕ) : ℤ) * (m_exp : ℤ)) := by
    change valL F K₁ (IntermediateField.inclusion hE'K₁ Y₀) = _
    rw [hval_E'K₁' Y₀, hY₀_val]
  by_cases hEM₁' : E' ≤ M₁'
  · have hT₀_eq : IntermediateField.inclusion hM₁'K₁ T₀ =
        ((p : ℕ) : K₁) * w_pow := hLeCase hEM₁' Y₀
    by_cases hp0 : ((p : ℕ) : K₁) = 0
    · left
      rw [hT₀_eq, hp0, zero_mul]
    · right
      have hp_val' : ((p * (p - 1) * t₂ : ℕ) : ℤ) ≤ valL F K₁ ((p : ℕ) : K₁) :=
        hp_valK₁.resolve_left hp0
      rw [hT₀_eq, hvalK₁_mul ((p : ℕ) : K₁) w_pow hp0 hw_pow_ne0, hw_pow_val]
      exact le_trans h_case1_ineq (add_le_add hp_val' le_rfl)
  · obtain ⟨hTrCompat, hSpan⟩ := hNotLeCase hEM₁'
    obtain ⟨z, hz_Δ⟩ := hSpan (Δ : K₁)
    obtain ⟨w, c, r, hz_orth, hr_val, horth⟩ := hOrth z M_cap
    let u : Fin p → E' := fun j =>
      ∑ k : Fin p, IntermediateField.inclusion hLE' (c k j) * ((ϖ_E' : E') ^ (k : ℕ))
    let R_Δ : K₁ :=
      ∑ k : Fin p,
        IntermediateField.inclusion hE'K₁ (((ϖ_E' : E') ^ (k : ℕ))) *
          IntermediateField.inclusion hM₁'K₁ (r k)
    have hι_comm : ∀ x : L,
        IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' x) =
          IntermediateField.inclusion hM₁'K₁ (IntermediateField.inclusion hLM₁' x) :=
      fun _ => rfl
    have hΔ_decomp : (Δ : K₁) =
        (∑ j : Fin p,
          IntermediateField.inclusion hE'K₁ (u j) *
            IntermediateField.inclusion hM₁'K₁ (w j)) + R_Δ := by
      have h1_eq : (Δ : K₁) =
          (∑ k : Fin p, ∑ j : Fin p,
            IntermediateField.inclusion hE'K₁ (((ϖ_E' : E') ^ (k : ℕ))) *
              (IntermediateField.inclusion hM₁'K₁ (IntermediateField.inclusion hLM₁' (c k j)) *
                IntermediateField.inclusion hM₁'K₁ (w j))) + R_Δ := by
        rw [hz_Δ, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [hz_orth k, map_add, mul_add, map_sum, Finset.mul_sum]
        congr 1
      rw [h1_eq]
      congr 1
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun j _ => ?_
      dsimp only [u]
      rw [map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [map_mul, hι_comm (c k j)]
      ring
    have hR_Δ_val : R_Δ = 0 ∨ (p : ℤ) * M_cap ≤ valL F K₁ R_Δ := by
      dsimp only [R_Δ]
      apply hvalK₁_sum Finset.univ
      intro k _
      by_cases hterm0 :
          IntermediateField.inclusion hE'K₁ (((ϖ_E' : E') ^ (k : ℕ))) *
            IntermediateField.inclusion hM₁'K₁ (r k) = 0
      · exact Or.inl hterm0
      · right
        have h1_ne0 : IntermediateField.inclusion hE'K₁ (((ϖ_E' : E') ^ (k : ℕ))) ≠ 0 :=
          left_ne_zero_of_mul hterm0
        have h2_ne0 : IntermediateField.inclusion hM₁'K₁ (r k) ≠ 0 :=
          right_ne_zero_of_mul hterm0
        have hrk_ne0 : r k ≠ 0 := fun h0 => h2_ne0 (by simp [h0])
        have hrk_ge : M_cap ≤ valL F M₁' (r k) := (hr_val k).resolve_left hrk_ne0
        rw [hvalK₁_mul _ _ h1_ne0 h2_ne0, hval_E'K₁',
          hvalE'_pow (ϖ_E' : E') (Units.ne_zero ϖ_E') (k : ℕ), hϖ_E',
          hval_M₁'K₁' (r k)]
        exact h_rk_ineq (k : ℕ) (valL F M₁' (r k)) hrk_ge
    have hex_j₀ : ∃ j₀ : Fin p,
        u j₀ ≠ 0 ∧ w j₀ ≠ 0 ∧
        (p : ℤ) * valL F E' (u j₀) + (p : ℤ) * valL F M₁' (w j₀) ≤ -(t₁ : ℤ) := by
      by_contra h_all
      push_neg at h_all
      have hsum_ge :
          (∑ j : Fin p,
            IntermediateField.inclusion hE'K₁ (u j) *
              IntermediateField.inclusion hM₁'K₁ (w j)) = 0 ∨
          -(t₁ : ℤ) + 1 ≤
            valL F K₁
              (∑ j : Fin p,
                IntermediateField.inclusion hE'K₁ (u j) *
                  IntermediateField.inclusion hM₁'K₁ (w j)) := by
        apply hvalK₁_sum Finset.univ
        intro j _
        by_cases hterm0 :
            IntermediateField.inclusion hE'K₁ (u j) *
              IntermediateField.inclusion hM₁'K₁ (w j) = 0
        · exact Or.inl hterm0
        · right
          have h1_ne0 : IntermediateField.inclusion hE'K₁ (u j) ≠ 0 :=
            left_ne_zero_of_mul hterm0
          have h2_ne0 : IntermediateField.inclusion hM₁'K₁ (w j) ≠ 0 :=
            right_ne_zero_of_mul hterm0
          have huj_ne0 : u j ≠ 0 := fun h0 => h1_ne0 (by simp [h0])
          have hwj_ne0 : w j ≠ 0 := fun h0 => h2_ne0 (by simp [h0])
          have hj_gt := h_all j huj_ne0 hwj_ne0
          rw [hvalK₁_mul _ _ h1_ne0 h2_ne0, hval_E'K₁' (u j), hval_M₁'K₁' (w j)]
          exact hj_gt
      have hR_ge : R_Δ = 0 ∨ -(t₁ : ℤ) + 1 ≤ valL F K₁ R_Δ :=
        hR_Δ_val.imp id (h_R_ge_ineq (valL F K₁ R_Δ))
      have hΔ_ge := hvalK₁_add (-(t₁ : ℤ) + 1) _ R_Δ hsum_ge hR_ge
      rw [← hΔ_decomp] at hΔ_ge
      have hΔ_val' : valL F K₁ (Δ : K₁) = -(t₁ : ℤ) := hΔ_val
      rcases hΔ_ge with hΔ0 | hΔ_le
      · exact Units.ne_zero Δ hΔ0
      · rw [hΔ_val'] at hΔ_le
        omega
    obtain ⟨j₀, huj₀_ne0, hwj₀_ne0, hj₀_val⟩ := hex_j₀
    set Y : E' := Y₀ * (u j₀)⁻¹
    have hY_ne0 : Y ≠ 0 := mul_ne_zero hY₀_ne0 (inv_ne_zero huj₀_ne0)
    have hYu_j₀ : Y * u j₀ = Y₀ := inv_mul_cancel_right₀ huj₀_ne0 Y₀
    have hY_val : valL F E' Y = ((p - 1 : ℕ) : ℤ) * (m_exp : ℤ) - valL F E' (u j₀) := by
      have hmul := hvalE'_mul Y (u j₀) hY_ne0 huj₀_ne0
      rw [hYu_j₀, hY₀_val] at hmul
      exact eq_sub_of_add_eq hmul.symm
    have htr_smul : ∀ (a : K₁) (b : M₁'),
        traceLM F hM₁'K₁ (a * IntermediateField.inclusion hM₁'K₁ b) =
          traceLM F hM₁'K₁ a * b := by
      letI : Module M₁' M₁' := Semiring.toModule
      intro a b
      have hsmul : toExtendScalars F hM₁'K₁ (a * IntermediateField.inclusion hM₁'K₁ b) =
          b • toExtendScalars F hM₁'K₁ a :=
        Subtype.ext (mul_comm a.1 b.1)
      change (Algebra.trace M₁' (IntermediateField.extendScalars hM₁'K₁))
        (toExtendScalars F hM₁'K₁ (a * IntermediateField.inclusion hM₁'K₁ b)) =
        (Algebra.trace M₁' (IntermediateField.extendScalars hM₁'K₁))
          (toExtendScalars F hM₁'K₁ a) * b
      rw [hsmul, LinearMap.map_smul, smul_eq_mul, mul_comm]
    have hTr_diff :
        traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * (Δ : K₁)) -
          traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * R_Δ) =
        ∑ j : Fin p,
          IntermediateField.inclusion hLM₁' (traceLM F hLE' (Y * u j)) * w j := by
      have hsub :
          IntermediateField.inclusion hE'K₁ Y * (Δ : K₁) -
            IntermediateField.inclusion hE'K₁ Y * R_Δ =
          ∑ j : Fin p,
            IntermediateField.inclusion hE'K₁ (Y * u j) *
              IntermediateField.inclusion hM₁'K₁ (w j) := by
        rw [hΔ_decomp, mul_add, add_sub_cancel_right, Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_mul (IntermediateField.inclusion hE'K₁) Y (u j), mul_assoc]
      rw [← map_sub, hsub, map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [htr_smul, hTrCompat (Y * u j)]
    set B : ℤ := ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (t₁ : ℤ) + valL F E' Y
    have hTr1_val :
        traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * (Δ : K₁)) = 0 ∨
          B ≤ valL F M₁' (traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * (Δ : K₁))) := by
      have hmem1 : 1 ∈ Finset.Icc 1 (p - 1) := Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩
      have htw := (hTwistedTr Y 1 hmem1).resolve_left hY_ne0
      rw [pow_one, Nat.cast_one, one_mul] at htw
      exact htw
    have hTr2_val :
        traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * R_Δ) = 0 ∨
          B ≤ valL F M₁' (traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * R_Δ)) := by
      apply htr_M₁'K₁ B
      rcases hR_Δ_val with hR0 | hR_ge
      · left
        rw [hR0, mul_zero]
      · by_cases hR0' : R_Δ = 0
        · left
          rw [hR0', mul_zero]
        · right
          have hY_K₁_ne0 : IntermediateField.inclusion hE'K₁ Y ≠ 0 :=
            (map_ne_zero_iff (IntermediateField.inclusion hE'K₁)
              (IntermediateField.inclusion hE'K₁).injective).mpr hY_ne0
          rw [hvalK₁_mul _ R_Δ hY_K₁_ne0 hR0', hval_E'K₁' Y]
          exact h_tr2_ineq (valL F E' Y) (valL F K₁ R_Δ) hR_ge
    have hTr_sum_val :
        (∑ j : Fin p,
          IntermediateField.inclusion hLM₁' (traceLM F hLE' (Y * u j)) * w j) = 0 ∨
        B ≤ valL F M₁'
          (∑ j : Fin p,
            IntermediateField.inclusion hLM₁' (traceLM F hLE' (Y * u j)) * w j) := by
      rw [← hTr_diff, sub_eq_add_neg]
      have hTr2_neg :
          - traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * R_Δ) = 0 ∨
          B ≤ valL F M₁' (- traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * R_Δ)) := by
        rw [neg_eq_zero, hvalM₁'_neg]
        exact hTr2_val
      exact hvalM₁'_add B _ _ hTr1_val hTr2_neg
    have horth_j₀ := horth (fun j => traceLM F hLE' (Y * u j)) B hTr_sum_val j₀
    rw [hYu_j₀] at horth_j₀
    have hT₀_compat : T₀ = IntermediateField.inclusion hLM₁' (traceLM F hLE' Y₀) :=
      hTrCompat Y₀
    rcases horth_j₀ with htr0 | hw0 | hB_le
    · left
      rw [hT₀_compat, htr0, map_zero, map_zero]
    · exact absurd hw0 hwj₀_ne0
    · right
      rw [hval_M₁'K₁' T₀, hT₀_compat, hval_LM₁'' (traceLM F hLE' Y₀)]
      have hB_le' :
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (t₁ : ℤ) +
            (((p - 1 : ℕ) : ℤ) * (m_exp : ℤ) - valL F E' (u j₀)) ≤
          (p : ℤ) * valL F L (traceLM F hLE' Y₀) + valL F M₁' (w j₀) := by
        dsimp only [B] at hB_le
        rw [hY_val] at hB_le
        exact hB_le
      exact h_case2_ineq (valL F E' (u j₀)) (valL F M₁' (w j₀))
        (valL F L (traceLM F hLE' Y₀)) hj₀_val hB_le'

theorem ld_ch12_wild_odd_tot_ram_quad_zero_degree_trace_bound (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (ψ : AddChar L (Ω F))
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (htr_M₁'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (((bM₁' - 1) + Module.finrank L (IntermediateField.extendScalars hLE') *
              (bE' - bM₁') + 1 : ℕ) : ℤ) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hTwistedTr : ∀ (Y : E') (i : ℕ),
      i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1) →
      Y = 0 ∨
        traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i)) = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) + valL F E' Y ≤
          valL F M₁' (traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i))))
    (e_Δ : ℕ → M₁')
    (he_Δ_val : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      e_Δ i = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (e_Δ i))
    (α γ : Lˣ) (w₂ : E'ˣ)
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ)
    (hw₂_val : valL F E' (w₂ : E') = -((a_lam - bE' : ℕ) : ℤ))
    (hT_val :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let δ := bE' - bM₁'
      let m := a_lam - bE'
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      let T := traceLM F hM₁'K₁ (z ^ (p - 1))
      T = 0 ∨ ((p - 1 : ℕ) : ℤ) * ((m + δ : ℕ) : ℤ) ≤ valL F M₁' T)
    (ξ Δ_conj : ℕ → K₁)
    (hξ0 : ξ 0 = 0)
    (hΔ_conj0 : Δ_conj 0 = (Δ : K₁))
    (hξ_props : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'), 0 < m →
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      ξ m ≠ 0 ∧
      valL F K₁ (ξ m) = 0 ∧
      ((ξ m) ^ p - ξ m = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤ valL F K₁ ((ξ m) ^ p - ξ m)))
    (hξ_pow_sum : ∀ r ∈ Finset.Icc 1 (2 * (Module.finrank L (IntermediateField.extendScalars hLE') - 1)),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      (∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
        (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0) = 0 ∨
        ((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
          valL F K₁
            ((∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
              (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0)))
    (hΔ_conj_val : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'),
      Δ_conj m ≠ 0 ∧ valL F K₁ (Δ_conj m) = -((bM₁' - 1 : ℕ) : ℤ))
    (hQ_conj_sum :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      let u_M₁' := IntermediateField.inclusion hLM₁' u
      let n := u_M₁' * b
      let T := traceLM F hM₁'K₁ (z ^ (p - 1))
      let Q_quad : E' :=
        traceLM F hE'K₁
          (IntermediateField.inclusion hM₁'K₁ (b * T) * z ^ (p - 1) *
            (IntermediateField.inclusion hM₁'K₁ ((1 + n) ^ 2))⁻¹)
      IntermediateField.inclusion hE'K₁ Q_quad =
        ∑ m ∈ Finset.range p,
          IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
            (Δ_conj m) ^ (p - 1) *
            IntermediateField.inclusion hM₁'K₁
              (normLM F hM₁'K₁ (Δ_conj m) *
                traceLM F hM₁'K₁
                  ((IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) *
                    Δ_conj m) ^ (p - 1))) *
            (IntermediateField.inclusion hM₁'K₁
              ((1 + u_M₁' * normLM F hM₁'K₁ (Δ_conj m)) ^ 2))⁻¹)
    (hΔ_conj_approx : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      let t₂ := bE' - 1
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let s := - e_Δ (p - 1)
      (Δ_conj m - ((Δ : K₁) + ξ m) = 0 ∨
        ((p * (p - 1) * t₂ - (p - 1) * t₁ : ℕ) : ℤ) ≤
          valL F K₁ (Δ_conj m - ((Δ : K₁) + ξ m))) ∧
      ((Δ_conj m - ((Δ : K₁) + ξ m)) -
          ((p : ℕ) : K₁) * ((Δ : K₁) ^ (p - 1)) * ξ m = 0 ∨
        ((p * (p - 1) * t₂ - (p - 2) * t₁ : ℕ) : ℤ) ≤
          valL F K₁
            ((Δ_conj m - ((Δ : K₁) + ξ m)) -
              ((p : ℕ) : K₁) * ((Δ : K₁) ^ (p - 1)) * ξ m)) ∧
      (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ_conj m)) -
          IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)) = 0 ∨
        ((p * (t₂ + 1) : ℕ) : ℤ) ≤
          valL F K₁
            (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ_conj m)) -
              IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)))) ∧
      (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)) -
          (IntermediateField.inclusion hM₁'K₁ b + ξ m -
            ξ m * IntermediateField.inclusion hM₁'K₁ s) = 0 ∨
        ((p * ((p - 1) * t₂ - (p - 2) * t₁) : ℕ) : ℤ) ≤
          valL F K₁
            (IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ ((Δ : K₁) + ξ m)) -
              (IntermediateField.inclusion hM₁'K₁ b + ξ m -
                ξ m * IntermediateField.inclusion hM₁'K₁ s)))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    let t₂ := bE' - 1
    let m_exp := a_lam - bE'
    let T₀ := traceLM F hM₁'K₁
      (IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)))
    IntermediateField.inclusion hM₁'K₁ T₀ = 0 ∨
      ((1 + p * t₂ + (2 * p - 1) * t₁ : ℕ) : ℤ) -
        ((p - 1 : ℕ) : ℤ) * ((p * m_exp : ℕ) : ℤ) ≤
          valL F K₁ (IntermediateField.inclusion hM₁'K₁ T₀) :=
by
  obtain ⟨ϖ_E', hϖ_E'⟩ := (ld_valL_and_unitGroup_props F E').2.2.2.2.2.2.1 1
  obtain ⟨_, hLeCase, hNotLeCase⟩ :=
    ld_ch12_wild_odd_tot_ram_diamond_power_basis_and_trace_compat F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hval_LE' hval_M₁'K₁ hval_norm_M₁'K₁ ϖ_E' hϖ_E'
  have hOrth := fun (z : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → M₁')
      (M_cap : ℤ) =>
    ld_ch12_wild_odd_tot_ram_ultrametric_gram_schmidt_orthogonalization F L M₁' hLM₁'
      (Module.finrank L (IntermediateField.extendScalars hLE')) hPrime.pos hval_LM₁'
      (Module.finrank L (IntermediateField.extendScalars hLE')) z M_cap
  exact ld_ch12_wild_odd_tot_ram_quad_zero_degree_trace_from_orthogonal_basis F L E' M₁' K₁
    hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hp_odd bE' bM₁' a_lam hbE'_ge2 hbM₁'_ge2 hb_le
    hbE'_lt_lam hpm_gt_t₁ hp_valK₁ hval_LE' hval_LM₁' hval_E'K₁ hval_M₁'K₁ htr_M₁'K₁
    Δ hΔ_val hTwistedTr w₂ hw₂_val ϖ_E' hϖ_E' hLeCase hNotLeCase hOrth

theorem ld_ch12_wild_odd_tot_ram_quad_inner_trace_binomial_linearization (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (htr_M₁'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (((bM₁' - 1) + Module.finrank L (IntermediateField.extendScalars hLE') *
              (bE' - bM₁') + 1 : ℕ) : ℤ) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hTwistedTr : ∀ (Y : E') (i : ℕ),
      i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1) →
      Y = 0 ∨
        traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i)) = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) + valL F E' Y ≤
          valL F M₁' (traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ Y * ((Δ : K₁) ^ i))))
    (w₂ : E'ˣ)
    (hw₂_val : valL F E' (w₂ : E') = -((a_lam - bE' : ℕ) : ℤ))
    (ξ Δ_conj : ℕ → K₁)
    (hξ0 : ξ 0 = 0)
    (hΔ_conj0 : Δ_conj 0 = (Δ : K₁))
    (hξ_props : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'), 0 < m →
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      ξ m ≠ 0 ∧
      valL F K₁ (ξ m) = 0 ∧
      ((ξ m) ^ p - ξ m = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤ valL F K₁ ((ξ m) ^ p - ξ m)))
    (hΔ_conj_val : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'),
      Δ_conj m ≠ 0 ∧ valL F K₁ (Δ_conj m) = -((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_conj_approx1 : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      let t₂ := bE' - 1
      Δ_conj m - ((Δ : K₁) + ξ m) = 0 ∨
        ((p * (p - 1) * t₂ - (p - 1) * t₁ : ℕ) : ℤ) ≤
          valL F K₁ (Δ_conj m - ((Δ : K₁) + ξ m)))
    (hTr0 :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      let t₂ := bE' - 1
      let m_exp := a_lam - bE'
      let T₀ := traceLM F hM₁'K₁
        (IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)))
      IntermediateField.inclusion hM₁'K₁ T₀ = 0 ∨
        ((1 + p * t₂ + (2 * p - 1) * t₁ : ℕ) : ℤ) -
          ((p - 1 : ℕ) : ℤ) * ((p * m_exp : ℕ) : ℤ) ≤
            valL F K₁ (IntermediateField.inclusion hM₁'K₁ T₀)) :
    ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      let t₂ := bE' - 1
      let m_exp := a_lam - bE'
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      let T := traceLM F hM₁'K₁ (z ^ (p - 1))
      let T_p2 := traceLM F hM₁'K₁
        (IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) * (Δ : K₁) ^ (p - 2))
      let T_m := traceLM F hM₁'K₁
        ((IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * Δ_conj m) ^ (p - 1))
      IntermediateField.inclusion hM₁'K₁ T_m -
          (IntermediateField.inclusion hM₁'K₁ T +
            ((p - 1 : ℕ) : K₁) * ξ m * IntermediateField.inclusion hM₁'K₁ T_p2) = 0 ∨
        ((1 + p * t₂ + (2 * p - 1) * t₁ : ℕ) : ℤ) -
          ((p - 1 : ℕ) : ℤ) * ((p * m_exp : ℕ) : ℤ) ≤
            valL F K₁
              (IntermediateField.inclusion hM₁'K₁ T_m -
                (IntermediateField.inclusion hM₁'K₁ T +
                  ((p - 1 : ℕ) : K₁) * ξ m * IntermediateField.inclusion hM₁'K₁ T_p2)) :=
by
  intro m hm p t₁ t₂ m_exp z T T_p2 T_m
  by_cases hm0 : m = 0
  · left
    have hTm_eq : T_m = T := by
      dsimp [T_m, T, z]
      rw [hm0, hΔ_conj0]
    rw [hTm_eq, hm0, hξ0]
    ring
  · have hm_pos : 0 < m := Nat.pos_of_ne_zero hm0
    have hvalL_props := ld_valL_and_unitGroup_props F L
    have hvalE'_props := ld_valL_and_unitGroup_props F E'
    have hvalM₁'_props := ld_valL_and_unitGroup_props F M₁'
    have hvalK₁_props := ld_valL_and_unitGroup_props F K₁
    obtain ⟨_, hval1_E', _, _, hval_mul_E', hval_inv_E', _, _, _, _, _⟩ := hvalE'_props
    obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj,
      hval_add, hunit0, hunit_a, hunit_val0⟩ := hvalK₁_props
    obtain ⟨τ_unit, hτ_val0, _, _, _, hξ_diff, hξ_prod⟩ :=
      ld_ch12_wild_odd_tot_ram_teichmuller_unit_lifts_and_distinctness F L E' M₁' K₁
        hLE' hLM₁' hM₁'K₁ hPrime hp_odd bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le hp_valK₁
        hvalL_props hvalM₁'_props (ld_valL_and_unitGroup_props F K₁) hval_LM₁' hval_M₁'K₁
        (fun M _ b hb hM_props hpM N hN τ_u τ_t hτ =>
          ld_wild_odd_prime_teichmuller_power_congruences F M p b hPrime hp_odd hb
            hM_props hpM N hN τ_u τ_t hτ)
    set δ := bE' - bM₁'
    set m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
    set B₀ : ℤ := ((p * (p - 1) * t₂ - (p - 1) * t₁ : ℕ) : ℤ)
    set B_req : ℤ :=
      ((1 + p * t₂ + (2 * p - 1) * t₁ : ℕ) : ℤ) -
        ((p - 1 : ℕ) : ℤ) * ((p * m_exp : ℕ) : ℤ)
    set S' : Finset ℕ := (Finset.range p).erase 0
    set ξ_pos : ℕ → K₁ := fun c =>
      IntermediateField.inclusion hM₁'K₁ (IntermediateField.inclusion hLM₁' (τ_unit c : L))
    have hp_ge2 : 2 ≤ p := hPrime.two_le
    have hp_ge3 : 3 ≤ p := by omega
    have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
    have ht₂_ge_t₁ : t₁ ≤ t₂ := by dsimp [t₁, t₂]; omega
    have hB₀_ge1 : (1 : ℤ) ≤ B₀ := by
      dsimp only [B₀, t₁, t₂]
      have h1 : 2 * 1 ≤ (p - 1) * (bE' - 1) :=
        Nat.mul_le_mul (by omega) (by omega)
      have h2 : (p - 1) * (bM₁' - 1) ≤ (p - 1) * (bE' - 1) :=
        Nat.mul_le_mul_left (p - 1) (by omega)
      have h3 : 3 * ((p - 1) * (bE' - 1)) ≤ p * ((p - 1) * (bE' - 1)) :=
        Nat.mul_le_mul_right ((p - 1) * (bE' - 1)) hp_ge3
      have h4 : p * ((p - 1) * (bE' - 1)) = p * (p - 1) * (bE' - 1) := by ring
      omega
    have hB₀_le_4p2m₁ : B₀ ≤ ((4 * p * p * m₁ : ℕ) : ℤ) := by
      dsimp only [B₀, t₁, t₂, m₁]
      have ht₂_le_m₁ : bE' - 1 ≤ 2 * bM₁' - 1 + p * (bE' - bM₁') := by
        have h_le : bE' - bM₁' ≤ p * (bE' - bM₁') := by
          calc bE' - bM₁' = 1 * (bE' - bM₁') := (one_mul _).symm
            _ ≤ p * (bE' - bM₁') := Nat.mul_le_mul_right _ (by omega)
        omega
      have hp_le : p * (p - 1) ≤ 4 * p * p := by
        have h_sub : p - 1 ≤ p := Nat.sub_le p 1
        calc p * (p - 1) ≤ p * p := Nat.mul_le_mul_left p h_sub
          _ = 1 * (p * p) := (one_mul _).symm
          _ ≤ 4 * (p * p) := Nat.mul_le_mul_right _ (by omega)
          _ = 4 * p * p := by ring
      have hmul : (p * (p - 1)) * (bE' - 1) ≤ (4 * p * p) * (2 * bM₁' - 1 + p * (bE' - bM₁')) :=
        Nat.mul_le_mul hp_le ht₂_le_m₁
      omega
    have hp1_even : Even (p - 1) := by
      rcases hPrime.odd_of_ne_two hp_odd with ⟨k, hk⟩
      exact ⟨k, by omega⟩
    have hneg_pow_p1 : ∀ x : K₁, (-x) ^ (p - 1) = x ^ (p - 1) := fun x =>
      hp1_even.neg_pow x
    have hval_sub : ∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x - y = 0 ∨ k ≤ valL F K₁ (x - y)) := by
      intro k x y hx hy
      have hy_neg : -y = 0 ∨ k ≤ valL F K₁ (-y) := by
        rw [neg_eq_zero, hval_neg]
        exact hy
      rw [sub_eq_add_neg]
      exact hval_add k x (-y) hx hy_neg
    have hval_mul_bound : ∀ (k₁ k₂ : ℤ) (x y : K₁),
        (x = 0 ∨ k₁ ≤ valL F K₁ x) → (y = 0 ∨ k₂ ≤ valL F K₁ y) →
          (x * y = 0 ∨ k₁ + k₂ ≤ valL F K₁ (x * y)) := by
      intro k₁ k₂ x y hx hy
      by_cases hx0 : x = 0
      · left; simp [hx0]
      · by_cases hy0 : y = 0
        · left; simp [hy0]
        · right
          rw [hval_mul x y hx0 hy0]
          have hx' : k₁ ≤ valL F K₁ x := hx.resolve_left hx0
          have hy' : k₂ ≤ valL F K₁ y := hy.resolve_left hy0
          omega
    have hval_sum : ∀ (S : Finset ℕ) (f : ℕ → K₁) (k : ℤ),
        (∀ i ∈ S, f i = 0 ∨ k ≤ valL F K₁ (f i)) →
          ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F K₁ (∑ i ∈ S, f i)) := by
      intro S f k hS
      induction S using Finset.induction_on with
      | empty => left; simp
      | @insert a s_set ha ih =>
        rw [Finset.sum_insert ha]
        exact hval_add k (f a) (∑ i ∈ s_set, f i)
