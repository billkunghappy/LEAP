  have hδ_U_eq : δ_U = Units.map (IntermediateField.inclusion hLM₁').toMonoidHom δ_T := rfl
  let liftL : k_L → L := fun a_res => (hresL_surj a_res).choose
  have hliftL : ∀ a_res : k_L,
