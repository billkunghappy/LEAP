        (∑ r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
          s₁ w r) + normLM F hM₁'K₁ w) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
    let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
    let n := IntermediateField.inclusion hLM₁' u * b
    let E_norm := (∑ i ∈ Finset.Icc 1 (p - 1), s₁ z i) * (1 + n)⁻¹
    (IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) - 1 = 0 ∨
      ((p - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) ≤
        valL F E' (IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) - 1)) ∧
    1 + n ≠ 0 ∧ valL F M₁' (1 + n) = 0 ∧
    normLM F hM₁'K₁ (1 + z) ≠ 0 ∧ valL F M₁' (normLM F hM₁'K₁ (1 + z)) = 0 ∧
    1 - (-E_norm) ≠ 0 ∧
    (∀ hE : 1 - (-E_norm) ≠ 0,
      (((χ₁ A₁ : Ω F) ^ 2 * ((χ₂ C₂ : Ω F) ^ 2)⁻¹)⁻¹ =
        (χ₁ (Units.mk0 (1 - (-E_norm)) hE) : Ω F) ^ 2)) :=
by
  intro p b u z n E_norm
  let t₁ : ℕ := bM₁' - 1
  let t₂ : ℕ := bE' - 1
  let m : ℕ := a_lam - bE'
  let m₁ : ℕ := 2 * bM₁' - 1 + p * (bE' - bM₁')
  let m₂ : ℕ := bE' + bM₁' - 1
  let a : E' := normLM F hE'K₁ (Δ : K₁)
  have hp_ne2 : p ≠ 2 := by
    change Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2
    omega
  have hp_pos : 1 ≤ p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by
    change 3 ≤ Module.finrank L (IntermediateField.extendScalars hLE')
    omega
  have hp_odd_nat : Odd p := Nat.Prime.odd_of_ne_two hPrime hp_ne2
  have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
  have ht₂_ge1 : 1 ≤ t₂ := by dsimp [t₂]; omega
  have ht_le : t₁ ≤ t₂ := by dsimp [t₁, t₂]; omega
  have hm_ge1 : 1 ≤ m := by dsimp [m]; omega
  have hm₂_ge1 : 1 ≤ m₂ := by dsimp [m₂]; omega
  have hp_pos_int : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hp_pos
  have hp_ne0_int : (p : ℤ) ≠ 0 := ne_of_gt hp_pos_int

  
  obtain ⟨hvalL_0, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, _, hvalL_add, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨hvalE'_0, hvalE'_1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv, _, hvalE'_add,
    _, hunitE'_mem, _⟩ := ld_valL_and_unitGroup_props F E'
  obtain ⟨hvalM₁'_0, hvalM₁'_1, hvalM₁'_neg1, hvalM₁'_neg, hvalM₁'_mul, hvalM₁'_inv, _,
    hvalM₁'_add, _⟩ := ld_valL_and_unitGroup_props F M₁'
  obtain ⟨hvalK₁_0, hvalK₁_1, hvalK₁_neg1, hvalK₁_neg, hvalK₁_mul, hvalK₁_inv, _,
    hvalK₁_add, _⟩ := ld_valL_and_unitGroup_props F K₁

  have hval_helpers : ∀ {M : Type u} [Field M] (v : M → ℤ),
      v 1 = 0 →
      v (-1) = 0 →
      (∀ x : M, v (-x) = v x) →
      (∀ x y : M, x ≠ 0 → y ≠ 0 → v (x * y) = v x + v y) →
      (∀ (k : ℤ) (x y : M), (x = 0 ∨ k ≤ v x) → (y = 0 ∨ k ≤ v y) → (x + y = 0 ∨ k ≤ v (x + y))) →
      (∀ (m₁ m₂ : ℤ) (x y : M), (x = 0 ∨ m₁ ≤ v x) → (y = 0 ∨ m₂ ≤ v y) →
        (x * y = 0 ∨ m₁ + m₂ ≤ v (x * y))) ∧
      (∀ (k : ℤ) (x y : M), (x = 0 ∨ k ≤ v x) → (y = 0 ∨ k ≤ v y) →
        (x - y = 0 ∨ k ≤ v (x - y))) ∧
      (∀ {α : Type} (s : Finset α) (f : α → M) (k : ℤ),
        (∀ x ∈ s, f x = 0 ∨ k ≤ v (f x)) →
        ((∑ x ∈ s, f x) = 0 ∨ k ≤ v (∑ x ∈ s, f x))) ∧
      (∀ n : ℕ, (n : M) = 0 ∨ 0 ≤ v (n : M)) ∧
      (∀ z : ℤ, (z : M) = 0 ∨ 0 ≤ v (z : M)) ∧
      (∀ (x : M) (r : ℕ), x ≠ 0 → x ^ r ≠ 0 ∧ v (x ^ r) = (r : ℤ) * v x) ∧
      (∀ r : ℕ, (-1 : M) ^ r ≠ 0 ∧ v ((-1 : M) ^ r) = 0) ∧
      (∀ x : M, (x = 0 ∨ 1 ≤ v x) → 1 + x ≠ 0 ∧ v (1 + x) = 0) := by
    intro M _ v hv1 hvneg1 h_neg h_mul h_add
    have hmul_b : ∀ (m₁ m₂ : ℤ) (x y : M), (x = 0 ∨ m₁ ≤ v x) → (y = 0 ∨ m₂ ≤ v y) →
        (x * y = 0 ∨ m₁ + m₂ ≤ v (x * y)) := by
      intro m₁ m₂ x y hx hy
      by_cases hx0 : x = 0
      · left; rw [hx0, zero_mul]
      · by_cases hy0 : y = 0
        · left; rw [hy0, mul_zero]
        · right
          have hvx : m₁ ≤ v x := hx.resolve_left hx0
          have hvy : m₂ ≤ v y := hy.resolve_left hy0
          rw [h_mul x y hx0 hy0]
          linarith
    have hsub_b : ∀ (k : ℤ) (x y : M), (x = 0 ∨ k ≤ v x) → (y = 0 ∨ k ≤ v y) →
        (x - y = 0 ∨ k ≤ v (x - y)) := by
      intro k x y hx hy
      rw [sub_eq_add_neg]
      apply h_add k x (-y) hx
      rcases hy with rfl | hvy
      · left; exact neg_zero
      · right; rwa [h_neg]
    have hsum_b : ∀ {α : Type} (s : Finset α) (f : α → M) (k : ℤ),
        (∀ x ∈ s, f x = 0 ∨ k ≤ v (f x)) →
        ((∑ x ∈ s, f x) = 0 ∨ k ≤ v (∑ x ∈ s, f x)) := by
      intro α s f k hs
      induction s using Finset.induction_on with
      | empty => exact Or.inl Finset.sum_empty
      | @insert x s' hx ih =>
        rw [Finset.sum_insert hx]
        exact h_add k (f x) (∑ y ∈ s', f y)
          (hs x (Finset.mem_insert_self x s'))
          (ih (fun y hy => hs y (Finset.mem_insert_of_mem hy)))
    have hnat_b : ∀ n : ℕ, (n : M) = 0 ∨ 0 ≤ v (n : M) := by
      intro n
      induction n with
      | zero => left; simp
      | succ m ih =>
        rw [Nat.cast_succ]
        exact h_add 0 (m : M) 1 ih (Or.inr (by rw [hv1]))
    have hint_b : ∀ z : ℤ, (z : M) = 0 ∨ 0 ≤ v (z : M) := by
      intro z
      cases z with
      | ofNat n => simpa using hnat_b n
      | negSucc n =>
        rw [Int.cast_negSucc]
        rcases hnat_b (n + 1) with h0 | hge
        · left; exact neg_eq_zero.mpr h0
        · right; rw [h_neg]; exact hge
    have hpow_b : ∀ (x : M) (r : ℕ), x ≠ 0 → x ^ r ≠ 0 ∧ v (x ^ r) = (r : ℤ) * v x := by
      intro x r hx
      induction r with
      | zero =>
        rw [pow_zero, Nat.cast_zero, zero_mul]
        exact ⟨one_ne_zero, hv1⟩
      | succ r ih =>
        rw [pow_succ]
        have hne : x ^ r * x ≠ 0 := mul_ne_zero ih.1 hx
        refine ⟨hne, ?_⟩
        rw [h_mul (x ^ r) x ih.1 hx, ih.2]
        push_cast
        ring
    have hneg1_pow_b : ∀ r : ℕ, (-1 : M) ^ r ≠ 0 ∧ v ((-1 : M) ^ r) = 0 := by
      intro r
      have h := hpow_b (-1 : M) r (neg_ne_zero.mpr one_ne_zero)
      rw [hvneg1, mul_zero] at h
      exact h
    have hone_add_b : ∀ x : M, (x = 0 ∨ 1 ≤ v x) → 1 + x ≠ 0 ∧ v (1 + x) = 0 := by
      intro x hx
      have hx0 : x = 0 ∨ 0 ≤ v x := by
        rcases hx with rfl | hge
        · exact Or.inl rfl
        · exact Or.inr (by omega)
      have hge0 : 1 + x = 0 ∨ 0 ≤ v (1 + x) :=
        h_add 0 1 x (Or.inr (by rw [hv1])) hx0
      have hnot1 : ¬ (1 + x = 0 ∨ 1 ≤ v (1 + x)) := by
        intro hbad
        have h1 : (1 + x) - x = 0 ∨ 1 ≤ v ((1 + x) - x) := hsub_b 1 (1 + x) x hbad hx
        rw [add_sub_cancel_right, hv1] at h1
        rcases h1 with h10 | h1le0
        · exact one_ne_zero h10
        · omega
      have hne0 : 1 + x ≠ 0 := fun h0 => hnot1 (Or.inl h0)
      have hv_ge0 : 0 ≤ v (1 + x) := hge0.resolve_left hne0
      have hv_lt1 : v (1 + x) < 1 := by
        by_contra hge1
        push_neg at hge1
        exact hnot1 (Or.inr hge1)
      exact ⟨hne0, by omega⟩
    exact ⟨hmul_b, hsub_b, hsum_b, hnat_b, hint_b, hpow_b, hneg1_pow_b, hone_add_b⟩

  obtain ⟨hmul_E', hsub_E', hsum_E', hnat_E', hint_E', hpow_E', hneg1_pow_E', _⟩ :=
    hval_helpers (valL F E') hvalE'_1 hvalE'_neg1 hvalE'_neg hvalE'_mul hvalE'_add
  obtain ⟨_, _, _, _, _, _, _, hone_add_M₁'⟩ :=
    hval_helpers (valL F M₁') hvalM₁'_1 hvalM₁'_neg1 hvalM₁'_neg hvalM₁'_mul hvalM₁'_add
  obtain ⟨_, _, _, _, _, _, _, hone_add_K₁⟩ :=
    hval_helpers (valL F K₁) hvalK₁_1 hvalK₁_neg1 hvalK₁_neg hvalK₁_mul hvalK₁_add

  
  have hα_ne0 : (α : L) ≠ 0 := Units.ne_zero α
  have hγ_inv_ne0 : ((γ⁻¹ : Lˣ) : L) ≠ 0 := Units.ne_zero (γ⁻¹)
  have hu_ne0 : u ≠ 0 := mul_ne_zero hα_ne0 hγ_inv_ne0
  have hu_val : valL F L u = (m : ℤ) := by
    dsimp [u, m]
    rw [hvalL_mul (α : L) ((γ⁻¹ : Lˣ) : L) hα_ne0 hγ_inv_ne0, hvalL_inv γ, hα_val, hγ_val]
    omega
  have huE'_ne0 : IntermediateField.inclusion hLE' u ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hLE')).mpr hu_ne0
  have huE'_val : valL F E' (IntermediateField.inclusion hLE' u) = (p : ℤ) * (m : ℤ) := by
    rw [hval_LE' u, hu_val]
  have huM₁'_ne0 : IntermediateField.inclusion hLM₁' u ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hLM₁')).mpr hu_ne0
  have huM₁'_val : valL F M₁' (IntermediateField.inclusion hLM₁' u) = (p : ℤ) * (m : ℤ) := by
    rw [hval_LM₁' u, hu_val]

  have hw₂_ne0 : (w₂ : E') ≠ 0 := Units.ne_zero w₂
  have hw₂_inv_ne0 : ((w₂⁻¹ : E'ˣ) : E') ≠ 0 := Units.ne_zero (w₂⁻¹)
  have hw₂_inv_val : valL F E' ((w₂⁻¹ : E'ˣ) : E') = (m : ℤ) := by
    rw [hvalE'_inv w₂, hw₂_val, neg_neg]
  have hw₂K₁_ne0 : IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hE'K₁)).mpr hw₂_inv_ne0
  have hw₂K₁_val : valL F K₁ (IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E'))) =
      (p : ℤ) * (m : ℤ) := by
    rw [hval_E'K₁ (((w₂⁻¹ : E'ˣ) : E')), hw₂_inv_val]

  have hΔ_ne0 : (Δ : K₁) ≠ 0 := Units.ne_zero Δ
  have ha_ne0 : a ≠ 0 := Units.ne_zero (Units.map (normLM F hE'K₁) Δ)
  have ha_val : valL F E' a = -(t₁ : ℤ) := by
    dsimp [a, t₁]
    rw [hval_norm_E'K₁ (Δ : K₁), hΔ_val]
  have hb_ne0 : b ≠ 0 := Units.ne_zero (Units.map (normLM F hM₁'K₁) Δ)
  have hb_val : valL F M₁' b = -(t₁ : ℤ) := by
    dsimp [b, t₁]
    rw [hval_norm_M₁'K₁ (Δ : K₁), hΔ_val]

  have hz_ne0 : z ≠ 0 := mul_ne_zero hw₂K₁_ne0 hΔ_ne0
  have hz_val : valL F K₁ z = (p : ℤ) * (m : ℤ) - (t₁ : ℤ) := by
    dsimp [z, t₁]
    rw [hvalK₁_mul _ (Δ : K₁) hw₂K₁_ne0 hΔ_ne0, hw₂K₁_val, hΔ_val]
    ring
  have hn_ne0 : n ≠ 0 := mul_ne_zero huM₁'_ne0 hb_ne0
  have hn_val : valL F M₁' n = (p : ℤ) * (m : ℤ) - (t₁ : ℤ) := by
    dsimp [n]
    rw [hvalM₁'_mul _ b huM₁'_ne0 hb_ne0, huM₁'_val, hb_val]
    ring
  have hpm_ge1 : 1 ≤ (p : ℤ) * (m : ℤ) - (t₁ : ℤ) := by
    have h_lt : (t₁ : ℤ) < (p : ℤ) * (m : ℤ) := by exact_mod_cast hpm_gt_t₁
    omega

  
  have hnorm_w₂_L : normLM F hLE' (w₂ : E') = (γ : L) * ((α⁻¹ : Lˣ) : L) :=
    congrArg Units.val hw₂_norm
  have hu_norm_w₂_L : u * normLM F hLE' (w₂ : E') = 1 := by
    have hα_inv : (α : L) * ((α⁻¹ : Lˣ) : L) = 1 := Units.mul_inv α
    have hγ_inv : (γ : L) * ((γ⁻¹ : Lˣ) : L) = 1 := Units.mul_inv γ
    dsimp [u]
    rw [hnorm_w₂_L]
    linear_combination ((γ : L) * ((γ⁻¹ : Lˣ) : L)) * hα_inv + hγ_inv
  have hu_norm_w₂ :
      IntermediateField.inclusion hLE' u *
        IntermediateField.inclusion hLE' (normLM F hLE' (w₂ : E')) = 1 := by
    rw [← map_mul, hu_norm_w₂_L, map_one]
  have huw₂_cayley :
      IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) - 1 =
        ∑ i ∈ Finset.Icc 1 (p - 1),
          IntermediateField.inclusion hLE' u *
            ((-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i) *
              (w₂ : E') ^ (p - i)) := by
    have hcay := hs_LE'_cayley (w₂ : E')
    change (w₂ : E') ^ p =
      IntermediateField.inclusion hLE' (normLM F hLE' (w₂ : E')) +
        ∑ i ∈ Finset.Icc 1 (p - 1),
          (-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i) *
            (w₂ : E') ^ (p - i) at hcay
    rw [hcay, mul_add, hu_norm_w₂, Finset.mul_sum]
    ring

  have huw₂_pow :
      IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) - 1 = 0 ∨
        ((p - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) ≤
          valL F E' (IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) - 1) := by
    rw [huw₂_cayley]
    apply @hsum_E' ℕ (Finset.Icc 1 (p - 1))
      (fun i =>
        IntermediateField.inclusion hLE' u *
          ((-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i) *
            (w₂ : E') ^ (p - i)))
      (((p - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ))
    intro i hi
    obtain ⟨hi1, hip1⟩ := Finset.mem_Icc.mp hi
    let X_i : ℤ := ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) - (i : ℤ) * (m : ℤ)
    let m_i : ℤ := X_i / (p : ℤ)
    let r_i : ℤ := X_i % (p : ℤ)
    have hdiv_eq : (p : ℤ) * m_i + r_i = X_i := Int.mul_ediv_add_emod X_i (p : ℤ)
    have hr_nonneg : 0 ≤ r_i := Int.emod_nonneg X_i hp_ne0_int
    have hr_lt : r_i < (p : ℤ) := Int.emod_lt_of_pos X_i hp_pos_int
    have hs_cond :
        (p : ℤ) * m_i - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) ≤ (i : ℤ) * (-(m : ℤ)) := by
      dsimp [X_i] at hdiv_eq
      linarith
    have hs_val_L : s_LE' (w₂ : E') i = 0 ∨ m_i ≤ valL F L (s_LE' (w₂ : E') i) :=
      hs_LE'_val (w₂ : E') i hi (-(m : ℤ)) m_i (Or.inr (le_of_eq hw₂_val.symm)) hs_cond
    have hs_val_E' :
        IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i) = 0 ∨
          (p : ℤ) * m_i ≤ valL F E' (IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i)) := by
      rcases hs_val_L with h0 | hge
      · left; rw [h0, map_zero]
      · right
        rw [hval_LE' (s_LE' (w₂ : E') i)]
        exact mul_le_mul_of_nonneg_left hge (by positivity)
    have hneg_i : (-1 : E') ^ (i - 1) = 0 ∨ 0 ≤ valL F E' ((-1 : E') ^ (i - 1)) :=
      Or.inr (by rw [(hneg1_pow_E' (i - 1)).2])
    have hw₂_pi :
        (w₂ : E') ^ (p - i) = 0 ∨
          ((p - i : ℕ) : ℤ) * (-(m : ℤ)) ≤ valL F E' ((w₂ : E') ^ (p - i)) := by
      right
      rw [(hpow_E' (w₂ : E') (p - i) hw₂_ne0).2, hw₂_val]
    have hu_b :
        IntermediateField.inclusion hLE' u = 0 ∨
          (p : ℤ) * (m : ℤ) ≤ valL F E' (IntermediateField.inclusion hLE' u) :=
      Or.inr (by rw [huE'_val])
    have h1 := hmul_E' 0 ((p : ℤ) * m_i)
      ((-1 : E') ^ (i - 1)) (IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i))
      hneg_i hs_val_E'
    have h2 := hmul_E' (0 + (p : ℤ) * m_i) (((p - i : ℕ) : ℤ) * (-(m : ℤ)))
      ((-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i))
      ((w₂ : E') ^ (p - i)) h1 hw₂_pi
    have h3 := hmul_E' ((p : ℤ) * (m : ℤ))
      ((0 + (p : ℤ) * m_i) + ((p - i : ℕ) : ℤ) * (-(m : ℤ)))
      (IntermediateField.inclusion hLE' u)
      ((-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i) *
        (w₂ : E') ^ (p - i))
      hu_b h2
    rcases h3 with h0 | hge
    · exact Or.inl h0
    · right
      have hpi_cast : ((p - i : ℕ) : ℤ) = (p : ℤ) - (i : ℤ) := Nat.cast_sub (by omega)
      have hp1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := Nat.cast_sub hp_pos
      have hbE'1_cast : ((bE' - 1 : ℕ) : ℤ) = (bE' : ℤ) - 1 := Nat.cast_sub (by omega)
      dsimp [X_i] at hdiv_eq
      rw [hpi_cast] at hge
      rw [hp1_cast] at hdiv_eq
      rw [hp1_cast, hbE'1_cast]
      linarith

  
  obtain ⟨h1n_ne0, h1n_val0⟩ := hone_add_M₁' n (Or.inr (by rw [hn_val]; exact hpm_ge1))
  obtain ⟨h1z_ne0, h1z_val0⟩ := hone_add_K₁ z (Or.inr (by rw [hz_val]; exact hpm_ge1))
  let u_1z : K₁ˣ := Units.mk0 (1 + z) h1z_ne0
  have hnorm1z_ne0 : normLM F hM₁'K₁ (1 + z) ≠ 0 :=
    Units.ne_zero (Units.map (normLM F hM₁'K₁) u_1z)
  have hnorm1z_val0 : valL F M₁' (normLM F hM₁'K₁ (1 + z)) = 0 := by
    rw [hval_norm_M₁'K₁ (1 + z), h1z_val0]
  have hnorm1z_E'_ne0 : normLM F hE'K₁ (1 + z) ≠ 0 :=
    Units.ne_zero (Units.map (normLM F hE'K₁) u_1z)
  have hnorm1z_E'_val0 : valL F E' (normLM F hE'K₁ (1 + z)) = 0 := by
    rw [hval_norm_E'K₁ (1 + z), h1z_val0]

  have hnorm_w₂_inv_unit : Units.map (normLM F hLE') (w₂⁻¹) = α * γ⁻¹ := by
    have h := congrArg Inv.inv hw₂_norm
    rw [← map_inv] at h
    exact h.trans (by group)
  have hnorm_w₂_inv : normLM F hLE' (((w₂⁻¹ : E'ˣ) : E')) = u :=
    congrArg Units.val hnorm_w₂_inv_unit
  have hnorm_z_M₁' : normLM F hM₁'K₁ z = n := by
    dsimp [z, n, b]
    rw [map_mul, (hDiamond_E' (((w₂⁻¹ : E'ˣ) : E'))).1, hnorm_w₂_inv]
  have hnorm1z_eq :
