        dsimp [Φ_v]
        rw [Fin.snoc_last, halast_val]
      rw [hinit_sum, hlast_val]
      dsimp [D_deg] at hD_pos hD_le_p ⊢
      omega
    · intro d hd
      simp only [U_v_mid, U_v_nz, U_v, P0_v, Pmid_v, Finset.mem_coe, Finset.mem_filter,
