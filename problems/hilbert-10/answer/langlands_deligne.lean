      refine ⟨fun hj_ne => ?_, fun hj_eq => ?_⟩
      · have h2 := h9_ne hj_ne
        have hsum := hvalM₁'_add ((p * (bE' - 1) + 1 : ℕ) : ℤ) _ _ h1 h2
        have hring : IntermediateField.inclusion hLM₁' X *
              (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k)) - P_k) +
            IntermediateField.inclusion hLM₁' X * (P_k - Q_k) =
            IntermediateField.inclusion hLM₁' X *
              (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k)) - Q_k) := by ring
        rw [hring] at hsum
        exact (hRed j x hx).1 hj_ne hsum
      · have h2 := h9_eq hj_eq
        have hsum := hvalM₁'_add ((p * (bE' - 1) + 1 : ℕ) : ℤ) _ _ h1 h2
        have hring : IntermediateField.inclusion hLM₁' X *
              (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k)) - P_k) +
            IntermediateField.inclusion hLM₁' X *
              (P_k - Q_k - ((p - 1 : ℕ) : M₁') * (1 - (- e_Δ (p - 1)) ^ p)) =
            IntermediateField.inclusion hLM₁' X *
              (IntermediateField.inclusion hLM₁' (traceLM F hLM₁' (b ^ k)) - Q_k -
                ((p - 1 : ℕ) : M₁') * (1 - (- e_Δ (p - 1)) ^ p)) := by ring
        rw [hring] at hsum
        exact (hRed j x hx).2 hj_eq hsum

theorem ld_ch12_wild_odd_totally_ramified_norm_ker_quad_phase_cancel (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hGalLE' : IsGaloisExt F L E')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (νE' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (bE' : ℕ) (hbE'_eq : condExp F L νE' = bE') (hbE'_ge2 : 2 ≤ bE')
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (bE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (c_νE' : Lˣ)
    (hc_νE'_val : valL F L (c_νE' : L) = (bE' : ℤ) + condExpChar F L ψ)
    (hc_νE'_stat : ∀ u : L, (u = 0 ∨ ((bE' / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) ^ 2 =
          ψ (((c_νE'⁻¹ : Lˣ) : L) * (2 * u - u ^ 2))) :
    let α₀ := ((c_νE'⁻¹ : Lˣ) : L)
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    (∀ x : L, (x = 0 ∨ (bE' : ℤ) ≤ valL F L x) → ψ (α₀ * x) = 1) ∧
    (∀ (y₁ : M₁') (y₂ : E'),
      ψM₁' (IntermediateField.inclusion hLM₁' α₀ * y₁) =
        ψE' (IntermediateField.inclusion hLE' α₀ * y₂) ↔
        ψ (α₀ * (traceLM F hLM₁' y₁ - traceLM F hLE' y₂)) = 1) ∧
    (∀ v : E', (v = 0 ∨ (((bE' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' v) →
      ψ (α₀ * (2 * (traceLM F hLE' v + normLM F hLE' v))) = 1) :=
by
  intro α₀ ψE' ψM₁'
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hval_neg_L := hvalL_props.2.2.2.1
  have hval_mul_L := hvalL_props.2.2.2.2.1
  have hval_inv_L := hvalL_props.2.2.2.2.2.1
  have hval_add_L := hvalL_props.2.2.2.2.2.2.2.1
  have hψ_cond := (ld_condExp_and_condExpChar_spec F L ψ hψ νE').1
  have hψ_triv : ∀ x : L, (x = 0 ∨ (bE' : ℤ) ≤ valL F L x) → ψ (α₀ * x) = 1 := by
    intro x hx
    by_cases hx0 : x = 0
    · rw [hx0, mul_zero]
      exact AddChar.map_zero_eq_one ψ
    · have hx_ge : (bE' : ℤ) ≤ valL F L x := hx.resolve_left hx0
      have hα₀_ne : α₀ ≠ 0 := Units.ne_zero c_νE'⁻¹
      have hα₀_val : valL F L α₀ = -((bE' : ℤ) + condExpChar F L ψ) := by
        dsimp [α₀]
        rw [hval_inv_L c_νE', hc_νE'_val]
      apply hψ_cond (α₀ * x)
      right
      rw [hval_mul_L α₀ x hα₀_ne hx0, hα₀_val]
      omega
  have hψ_congr : ∀ A B : L,
      (A - B = 0 ∨ (bE' : ℤ) ≤ valL F L (A - B)) → ψ (α₀ * A) = ψ (α₀ * B) := by
    intro A B hAB
    have hsplit : α₀ * A = α₀ * (A - B) + α₀ * B := by ring
    rw [hsplit, AddChar.map_add_eq_mul, hψ_triv (A - B) hAB, one_mul]
  have htr_smul : ∀ {M : IntermediateField F (AlgebraicClosure F)} (h : L ≤ M)
      (a : L) (y : M),
      traceLM F h (IntermediateField.inclusion h a * y) = a * traceLM F h y := by
    intro M h a y
    letI : Module L L := Semiring.toModule
    exact (Algebra.trace L (IntermediateField.extendScalars h)).map_smul' a
      (toExtendScalars F h y)
  have hψ_bridge : ∀ (y₁ : M₁') (y₂ : E'),
      ψM₁' (IntermediateField.inclusion hLM₁' α₀ * y₁) =
        ψE' (IntermediateField.inclusion hLE' α₀ * y₂) ↔
        ψ (α₀ * (traceLM F hLM₁' y₁ - traceLM F hLE' y₂)) = 1 := by
    intro y₁ y₂
    have h1 : ψM₁' (IntermediateField.inclusion hLM₁' α₀ * y₁) =
        ψ (α₀ * traceLM F hLM₁' y₁) := by
      change ψ (traceLM F hLM₁' (IntermediateField.inclusion hLM₁' α₀ * y₁)) = _
      rw [htr_smul hLM₁' α₀ y₁]
    have h2 : ψE' (IntermediateField.inclusion hLE' α₀ * y₂) =
        ψ (α₀ * traceLM F hLE' y₂) := by
      change ψ (traceLM F hLE' (IntermediateField.inclusion hLE' α₀ * y₂)) = _
      rw [htr_smul hLE' α₀ y₂]
    rw [h1, h2]
    set A := α₀ * traceLM F hLM₁' y₁
    set B := α₀ * traceLM F hLE' y₂
    have hsub : α₀ * (traceLM F hLM₁' y₁ - traceLM F hLE' y₂) = A - B := by
      dsimp [A, B]; ring
    rw [hsub]
    constructor
    · intro hAB
      rw [sub_eq_add_neg, AddChar.map_add_eq_mul, hAB, ← AddChar.map_add_eq_mul,
        add_neg_cancel, AddChar.map_zero_eq_one]
    · intro hsub1
      have hA : A = (A - B) + B := by ring
      conv_lhs => rw [hA, AddChar.map_add_eq_mul, hsub1, one_mul]
  have hψ_Q : ∀ v : E', (v = 0 ∨ (((bE' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' v) →
      ψ (α₀ * (2 * (traceLM F hLE' v + normLM F hLE' v))) = 1 := by
    have hvalE'_props := ld_valL_and_unitGroup_props F E'
    have hRam : condExp F L νE' ≠ 0 := by omega
    obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
      ld_addVal_finset_and_algebraMap_valL F L
    obtain ⟨S₁, hS₁⟩ := ld_valL_mod_one_finset F L
      hvalL_props.1 hvalL_props.2.2.2.1 hvalL_props.2.2.2.2.1 hvalL_props.2.2.2.2.2.2.2.1
      haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
    obtain ⟨k_L, hField_kL, hFin_kL, resL, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ :=
      ld_valL_residue_field_exists F L
        hvalL_props.1 hvalL_props.2.1 hvalL_props.2.2.1 hvalL_props.2.2.2.1
        hvalL_props.2.2.2.2.1 hvalL_props.2.2.2.2.2.1 hvalL_props.2.2.2.2.2.2.2.1 S₁ hS₁
    letI : Field k_L := hField_kL
    letI : Fintype k_L := hFin_kL
    obtain ⟨_, _, _, _, _, _, _, _, ϖ_E', ϖ_L, _, hϖ_E', _, hBasis⟩ :=
      ld_wild_total_ramification_and_power_basis F L E' hLE' hPrime νE'
        hνE'_pow hνE'_ne hνE'_ker hνE'_cond hRam hWild
        haddVal1 haddVal_mul halg1 hvalL_props hvalE'_props
        k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
    obtain ⟨_, _, _, _, _, _, _, _, hnorm_exp⟩ :=
      ld_wild_galois_jump_and_euler_trace_formula F L E' hLE' hGalLE' hPrime hWild
        haddVal1 halg1 hvalL_props hvalE'_props hval_norm_LE' hval_LE' ϖ_E' hϖ_E' hBasis
    intro v hv
    set p := Module.finrank L (IntermediateField.extendScalars hLE')
    set d₀ : ℕ := (bE' + 1) / 2
    have hp_ge2 : 2 ≤ p := hPrime.two_le
    have hp_ge1 : 1 ≤ p := hPrime.one_le
    have hd₀_ge1 : 1 ≤ d₀ := by omega
    have hd₀_ge_half : ((bE' / 2 : ℕ) : ℤ) ≤ (d₀ : ℤ) := by omega
    have hd₀_le_bE' : (d₀ : ℤ) ≤ (bE' : ℤ) := by omega
    have h2d₀_ge_bE' : (bE' : ℤ) ≤ 2 * (d₀ : ℤ) := by omega
    have hp_sub : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
    obtain ⟨z, hz, hnorm_v_eq⟩ := hnorm_exp d₀ hd₀_ge1 v hv
    set u_L : L := normLM F hLE' (1 + v) - 1
    have hu_L_eq : u_L = (traceLM F hLE' v + normLM F hLE' v) + traceLM F hLE' z := by
      dsimp [u_L]
      rw [hnorm_v_eq, map_add]
      ring
    have htr_z_bE' : traceLM F hLE' z = 0 ∨ (bE' : ℤ) ≤ valL F L (traceLM F hLE' z) := by
      apply htr_LE' (bE' : ℤ) z
      rcases hz with rfl | hz_ge
      · exact Or.inl rfl
      · right
        have hlin : (p : ℤ) * (bE' : ℤ) - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) = (bE' : ℤ) := by
          rw [hp_sub]; ring
        rw [hlin]
        exact le_trans h2d₀_ge_bE' hz_ge
    have htr_z_d0 : traceLM F hLE' z = 0 ∨ (d₀ : ℤ) ≤ valL F L (traceLM F hLE' z) :=
      htr_z_bE'.imp id (le_trans hd₀_le_bE')
    have htr_v_d0 : traceLM F hLE' v = 0 ∨ (d₀ : ℤ) ≤ valL F L (traceLM F hLE' v) := by
      apply htr_LE' (d₀ : ℤ) v
      rcases hv with rfl | hv_ge
      · exact Or.inl rfl
      · right
        have hmul_le : ((p - 1 : ℕ) : ℤ) * (d₀ : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) :=
          mul_le_mul_of_nonneg_left hd₀_le_bE' (by positivity)
        have hlin : (p : ℤ) * (d₀ : ℤ) - ((p - 1 : ℕ) : ℤ) * (d₀ : ℤ) = (d₀ : ℤ) := by
          rw [hp_sub]; ring
        have hle : (p : ℤ) * (d₀ : ℤ) - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) ≤ (d₀ : ℤ) := by
          linarith
        exact le_trans hle hv_ge
    have hnorm_v_d0 : normLM F hLE' v = 0 ∨ (d₀ : ℤ) ≤ valL F L (normLM F hLE' v) := by
      rcases hv with rfl | hv_ge
      · left
        haveI : IsScalarTower F L (IntermediateField.extendScalars hLE') :=
          IsScalarTower.of_algebraMap_eq fun _ => rfl
        haveI : FiniteDimensional F (IntermediateField.extendScalars hLE') :=
          inferInstanceAs (FiniteDimensional F E')
        haveI : Module.Finite L (IntermediateField.extendScalars hLE') :=
          FiniteDimensional.right F L (IntermediateField.extendScalars hLE')
        change Algebra.norm L (0 : IntermediateField.extendScalars hLE') = 0
        exact Algebra.norm_zero
      · right; rw [hval_norm_LE' v]; exact hv_ge
    have hu_L_d0 : u_L = 0 ∨ (d₀ : ℤ) ≤ valL F L u_L := by
      rw [hu_L_eq]
      exact hval_add_L (d₀ : ℤ) _ _
        (hval_add_L (d₀ : ℤ) _ _ htr_v_d0 hnorm_v_d0) htr_z_d0
    have hu_L_half : u_L = 0 ∨ ((bE' / 2 : ℕ) : ℤ) ≤ valL F L u_L :=
      hu_L_d0.imp id (le_trans hd₀_ge_half)
    have hu_L_sq : u_L ^ 2 = 0 ∨ (bE' : ℤ) ≤ valL F L (u_L ^ 2) := by
      by_cases hu0 : u_L = 0
      · left; rw [hu0]; ring
      · right
        have hu_ge : (d₀ : ℤ) ≤ valL F L u_L := hu_L_d0.resolve_left hu0
        rw [sq, hval_mul_L u_L u_L hu0 hu0]
        omega
    have hneg_sq : -(u_L ^ 2) = 0 ∨ (bE' : ℤ) ≤ valL F L (-(u_L ^ 2)) := by
      rcases hu_L_sq with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rw [hval_neg_L]; exact hge
    have hdiff_bE' :
        (2 * u_L - u_L ^ 2) - 2 * (traceLM F hLE' v + normLM F hLE' v) = 0 ∨
          (bE' : ℤ) ≤
            valL F L ((2 * u_L - u_L ^ 2) - 2 * (traceLM F hLE' v + normLM F hLE' v)) := by
      have hid : (2 * u_L - u_L ^ 2) - 2 * (traceLM F hLE' v + normLM F hLE' v) =
          (traceLM F hLE' z + traceLM F hLE' z) + (-(u_L ^ 2)) := by
        rw [hu_L_eq]; ring
      rw [hid]
      exact hval_add_L (bE' : ℤ) _ _
        (hval_add_L (bE' : ℤ) _ _ htr_z_bE' htr_z_bE') hneg_sq
    have hv_ne : 1 + v ≠ 0 := by
      intro h0
      have hv_eq : v = -1 := by linear_combination h0
      rcases hv with h0_v | hv_ge
      · rw [h0_v, add_zero] at h0
        exact one_ne_zero h0
      · rw [hv_eq, hvalE'_props.2.2.1] at hv_ge
        omega
    let y_u : E'ˣ := Units.mk0 (1 + v) hv_ne
    let x_u : Lˣ := Units.map (normLM F hLE') y_u
    have hx_u_coe : (x_u : L) = 1 + u_L := by
      change normLM F hLE' (1 + v) = 1 + u_L
      dsimp [u_L]; ring
    have hu_L_ne : 1 + u_L ≠ 0 := by
      rw [← hx_u_coe]
      exact Units.ne_zero x_u
    have hx_u_eq : Units.mk0 (1 + u_L) hu_L_ne = x_u := Units.ext hx_u_coe.symm
    have hν_eq1 : νE' (Units.mk0 (1 + u_L) hu_L_ne) = 1 := by
      rw [hx_u_eq]
      exact (hνE'_ker x_u).mp ⟨y_u, rfl⟩
    have hstat := hc_νE'_stat u_L hu_L_half hu_L_ne
    rw [hν_eq1, Units.val_one, one_pow] at hstat
    rw [← hψ_congr (2 * u_L - u_L ^ 2) (2 * (traceLM F hLE' v + normLM F hLE' v)) hdiff_bE']
    exact hstat.symm
  exact ⟨hψ_triv, hψ_bridge, hψ_Q⟩

theorem ld_ch12_wild_odd_totally_ramified_half_cond_unit_model_compatibility_scaled (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (bE' bM₁' : ℕ) (hbE'_eq : condExp F L νE' = bE') (hbM₁'_eq : condExp F L νM₁' = bM₁')
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣ (bM₁' - 1)))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) * (bE' : ℤ))
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) * (bM₁' : ℤ))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
