    · have hfilt := hσ_lift_filt σ_lift hσ_M₁' hne
      let u_π : K₁ˣ := (Units.map σ_lift.toRingEquiv.toMonoidHom ϖ_K₁) * ϖ_K₁⁻¹
      have hu_π_val : (u_π : K₁) - 1 = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ ((u_π : K₁) - 1) := by
        rcases (hunit_ge1_K₁ d₁ hd₁_ge1 u_π).mp hfilt with h1 | hge
        · left; rw [h1, sub_self]
        · exact Or.inr hge
