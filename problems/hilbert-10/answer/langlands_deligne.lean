        intro y hy
        exact ⟨hN₁_le_M hy, y.2⟩
      have h_mul : (N'₁.relIndex M') * M'.index = q₀ := by
        rw [Subgroup.relIndex_mul_index hN'₁_le_M', hN₁_HL'_idx]
      have hdvd : M'.index ∣ q₀ := ⟨N'₁.relIndex M', by rw [mul_comm, h_mul]⟩
      rcases hq₀_prime.eq_one_or_self_of_dvd M'.index hdvd with hM'_1 | hM'_q₀
      · right
        have hM'_top : M' = ⊤ := Subgroup.index_eq_one.mp hM'_1
