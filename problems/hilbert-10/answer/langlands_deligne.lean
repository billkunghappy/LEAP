    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hχE'_comp : (recChar F rec E' χE').comp (Units.map (normLM F hE'K₁)) = recChar F rec K₁ χK₁)
    (hχM₁'_comp : (recChar F rec M₁' χM₁').comp (Units.map (normLM F hM₁'K₁)) = recChar F rec K₁ χK₁)
    (hCommonRest : ∀ x : Lˣ,
      (recChar F rec E' χE') (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) *
        νE' x =
      (recChar F rec M₁' χM₁') (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x) *
        νM₁' x)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hBiquadE2 : ∀ C : K₁,
      traceLM F hLE' (normLM F hE'K₁ C) + normLM F hLE' (traceLM F hE'K₁ C) =
        traceLM F hLM₁' (normLM F hM₁'K₁ C) + normLM F hLM₁' (traceLM F hM₁'K₁ C))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_normK₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w ∧
      valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = 2 * valL F L x)
    (hnE' : condExpChar F E' (traceChar F hLE' ψ) =
      2 * condExpChar F L ψ + (condExp F L νE' : ℤ))
    (hnM₁' : condExpChar F M₁' (traceChar F hLM₁' ψ) =
      2 * condExpChar F L ψ + (condExp F L νM₁' : ℤ))
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_even : condExp F L νE' % 2 = 0)
    (hm1_ge : 2 * condExp F L νE' ≤ condExp F M₁' (recChar F rec M₁' χM₁'))
    (hm1_even : condExp F M₁' (recChar F rec M₁' χM₁') % 2 = 0)
    (hm2_eq : condExp F E' (recChar F rec E' χE') =
      condExp F M₁' (recChar F rec M₁' χM₁') + condExp F L νM₁' - condExp F L νE')
    (htr_E'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨ 2 * m - (condExp F L νM₁' : ℤ) ≤ valL F K₁ w) →
      (traceLM F hE'K₁ w = 0 ∨ m ≤ valL F E' (traceLM F hE'K₁ w)))
    (htr_M₁'K₁ : ∀ (m : ℤ) (w : K₁),
      (w = 0 ∨ 2 * m - (2 * (condExp F L νE' : ℤ) - (condExp F L νM₁' : ℤ)) ≤ valL F K₁ w) →
      (traceLM F hM₁'K₁ w = 0 ∨ m ≤ valL F M₁' (traceLM F hM₁'K₁ w)))
    (hTowerNormTr : ∀ w : K₁,
      normLM F hLE' (normLM F hE'K₁ w) = normLM F hLM₁' (normLM F hM₁'K₁ w) ∧
      traceLM F hLE' (traceLM F hE'K₁ w) = traceLM F hLM₁' (traceLM F hM₁'K₁ w))
    (C : K₁) (h₁ : M₁') (h₂ : E') (β₁ β₂ p_X : L) (N₁ : M₁')
    (hβ₁ : β₁ ≠ 0) (hβ₂ : β₂ ≠ 0)
    (htr_M₁'K₁_C : traceLM F hM₁'K₁ C = h₁ - IntermediateField.inclusion hLM₁' p_X)
    (htr_E'K₁_C : traceLM F hE'K₁ C = h₂ - IntermediateField.inclusion hLE' p_X)
    (hnorm_M₁'K₁_C : normLM F hM₁'K₁ C = N₁)
    (hN₁_ne : N₁ ≠ 0)
    (hN₁_val : valL F M₁' N₁ =
      -2 * ((condExp F M₁' (recChar F rec M₁' χM₁') / 2 +
        condExp F L νM₁' / 2 - 2 * (condExp F L νE' / 2) : ℕ) : ℤ))
    (α' : Lˣ)
    (hα'_val : valL F L (α' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hcM₁'_stat_N₁ : ∀ z : M₁',
      (z = 0 ∨ (((condExp F M₁' (recChar F rec M₁' χM₁') + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        ((recChar F rec M₁' χM₁') (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (IntermediateField.inclusion hLM₁' (((α'⁻¹ : Lˣ) : L)) * N₁ * z))
    (hν_eq : νE' (α' * (Units.mk0 β₂ hβ₂)⁻¹) = νE' α' ∧
      νM₁' (α' * (Units.mk0 β₁ hβ₁)⁻¹) = νM₁' α')
    (hQuadDiff0 : normLM F hLE' (h₂ - IntermediateField.inclusion hLE' p_X) - β₂ =
      normLM F hLM₁' (h₁ - IntermediateField.inclusion hLM₁' p_X) - β₁)
    (hQuadDiffE' : ∀ T₂ : E',
      normLM F hLE' ((h₂ - IntermediateField.inclusion hLE' p_X) + T₂) -
        normLM F hLE' (h₂ - IntermediateField.inclusion hLE' p_X) =
      -p_X * traceLM F hLE' T₂ + (normLM F hLE' (h₂ + T₂) - β₂))
    (hQuadDiffM₁' : ∀ T₁ : M₁',
      normLM F hLM₁' ((h₁ - IntermediateField.inclusion hLM₁' p_X) + T₁) -
        normLM F hLM₁' (h₁ - IntermediateField.inclusion hLM₁' p_X) =
      -p_X * traceLM F hLM₁' T₁ + (normLM F hLM₁' (h₁ + T₁) - β₁))
    (hPhaseE' : ∀ T₂ : E', (T₂ = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F E' T₂) →
      ψ (((α'⁻¹ : Lˣ) : L) * (normLM F hLE' (h₂ + T₂) - β₂)) = 1)
    (hPhaseM₁' : ∀ T₁ : M₁',
      (T₁ = 0 ∨ 3 * ((condExp F L νE' / 2 : ℕ) : ℤ) - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ) ≤ valL F M₁' T₁) →
      ψ (((α'⁻¹ : Lˣ) : L) * (normLM F hLM₁' (h₁ + T₁) - β₁)) = 1) :
    let θE' := recChar F rec E' χE'
    let θM₁' := recChar F rec M₁' χM₁'
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    let cνE' : Lˣ := α' * (Units.mk0 β₂ hβ₂)⁻¹
    let cνM₁' : Lˣ := α' * (Units.mk0 β₁ hβ₁)⁻¹
    ∃ (cE' : E'ˣ) (cM₁' : M₁'ˣ),
      valL F E' (cE' : E') = (condExp F E' θE' : ℤ) + condExpChar F E' ψE' ∧
      valL F M₁' (cM₁' : M₁') = (condExp F M₁' θM₁' : ℤ) + condExpChar F M₁' ψM₁' ∧
      (∀ z : M₁', (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
        ∀ hz : 1 + z ≠ 0,
          (θM₁' (Units.mk0 (1 + z) hz) : Ω F) = ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * z)) ∧
      (θE' cE' : Ω F) * (νE' cνE' : Ω F) *
          ψE' (((cE'⁻¹ : E'ˣ) : E')) * ψ (((cνE'⁻¹ : Lˣ) : L)) =
        (θM₁' cM₁' : Ω F) * (νM₁' cνM₁' : Ω F) *
          ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁')) * ψ (((cνM₁'⁻¹ : Lˣ) : L)) ∧
      (∀ W ∈ unitGroup F K₁ (condExp F E' θE' - condExp F L νM₁'),
        let uE' : E'ˣ := Units.map (normLM F hE'K₁) W
        (θE' uE' : Ω F) = ψE' (((cE'⁻¹ : E'ˣ) : E') * ((uE' : E') - 1))) :=
by
  dsimp only
  obtain ⟨a, r, b₁, h, ha_def, hr_def, hb₁_def, hh_def, ha_ge1, har, hb₁_ge, hh_ge1,
      hT1_eq, hT2_eq, hm1_eq, hm2_eq2, h_half_m1, hm2_sub_T1⟩ :
      ∃ a r b₁ h : ℕ,
        condExp F L νM₁' / 2 = a ∧
        condExp F L νE' / 2 = r ∧
        condExp F M₁' (recChar F rec M₁' χM₁') / 2 = b₁ ∧
        b₁ + a - 2 * r = h ∧
        1 ≤ a ∧ a ≤ r ∧ 2 * r ≤ b₁ ∧ 1 ≤ h ∧
        condExp F L νM₁' = 2 * a ∧
        condExp F L νE' = 2 * r ∧
        condExp F M₁' (recChar F rec M₁' χM₁') = 2 * b₁ ∧
        condExp F E' (recChar F rec E' χE') = 2 * b₁ + 2 * a - 2 * r ∧
        (condExp F M₁' (recChar F rec M₁' χM₁') + 1) / 2 = b₁ ∧
        condExp F E' (recChar F rec E' χE') - condExp F L νM₁' = 2 * b₁ - 2 * r := by
    refine ⟨condExp F L νM₁' / 2, condExp F L νE' / 2,
      condExp F M₁' (recChar F rec M₁' χM₁') / 2,
      condExp F M₁' (recChar F rec M₁' χM₁') / 2 + condExp F L νM₁' / 2 - 2 * (condExp F L νE' / 2),
      rfl, rfl, rfl, rfl,
      by omega, by omega, by omega, by omega,
      by omega, by omega, by omega, by omega, by omega, by omega⟩
  rw [hb₁_def, ha_def, hr_def, hh_def] at hN₁_val
  rw [hr_def] at hPhaseE'
  rw [hr_def, ha_def] at hPhaseM₁'
  rcases hvalE'_props with ⟨_, _, _, _, hvalE'_mul, hvalE'_inv, _, _, _, _, _⟩
  rcases hvalM₁'_props with ⟨_, _, _, _, hvalM₁'_mul, hvalM₁'_inv, _, hvalM₁'_ultra, _, _, _⟩
  rcases hvalK₁_props with ⟨hvalK₁_0, _, _, _, hvalK₁_mul, _, _, _, _, hvalK₁_ug, _⟩
  have hval_C : valL F K₁ C = -2 * (h : ℤ) := by
    rw [← (hval_normK₁ C).2, hnorm_M₁'K₁_C, hN₁_val]
  have hC_ne : C ≠ 0 := by
    intro h0
    rw [h0, hvalK₁_0] at hval_C
    omega
  have hval_normE'_C : valL F E' (normLM F hE'K₁ C) = -2 * (h : ℤ) := by
    rw [(hval_normK₁ C).1, hval_C]
  obtain ⟨C_unit, hC_unit_def⟩ : ∃ C_unit : K₁ˣ, C_unit = Units.mk0 C hC_ne := ⟨_, rfl⟩
  obtain ⟨cE', hcE'_def⟩ : ∃ cE' : E'ˣ,
      cE' = Units.map (IntermediateField.inclusion hLE').toMonoidHom α' *
        (Units.map (normLM F hE'K₁) C_unit)⁻¹ := ⟨_, rfl⟩
  obtain ⟨cM₁', hcM₁'_def⟩ : ∃ cM₁' : M₁'ˣ,
      cM₁' = Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α' *
        (Units.map (normLM F hM₁'K₁) C_unit)⁻¹ := ⟨_, rfl⟩
  have hinc_LE' : ∀ x : L, ((IntermediateField.inclusion hLE').toMonoidHom x : E') =
      IntermediateField.inclusion hLE' x := fun _ => rfl
  have hinc_LM₁' : ∀ x : L, ((IntermediateField.inclusion hLM₁').toMonoidHom x : M₁') =
      IntermediateField.inclusion hLM₁' x := fun _ => rfl
  have hcE'_val : valL F E' (cE' : E') =
      (condExp F E' (recChar F rec E' χE') : ℤ) + condExpChar F E' (traceChar F hLE' ψ) := by
    rw [hcE'_def, Units.val_mul, hvalE'_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
      hvalE'_inv, Units.coe_map, hinc_LE', hval_LE' (α' : L), hα'_val,
      Units.coe_map, hC_unit_def, Units.val_mk0, hval_normE'_C, hnE']
    omega
  have hcM₁'_val : valL F M₁' (cM₁' : M₁') =
      (condExp F M₁' (recChar F rec M₁' χM₁') : ℤ) + condExpChar F M₁' (traceChar F hLM₁' ψ) := by
    rw [hcM₁'_def, Units.val_mul, hvalM₁'_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
      hvalM₁'_inv, Units.coe_map, hinc_LM₁', hval_LM₁' (α' : L), hα'_val,
      Units.coe_map, hC_unit_def, Units.val_mk0, hnorm_M₁'K₁_C, hN₁_val, hnM₁']
    omega
  have hcE'_inv : ((cE'⁻¹ : E'ˣ) : E') =
      IntermediateField.inclusion hLE' (((α'⁻¹ : Lˣ) : L)) * normLM F hE'K₁ C := by
    rw [hcE'_def, mul_inv_rev, inv_inv, Units.val_mul, Units.coe_map, hC_unit_def, Units.val_mk0,
      ← map_inv, Units.coe_map, hinc_LE', mul_comm]
  have hcM₁'_inv : ((cM₁'⁻¹ : M₁'ˣ) : M₁') =
      IntermediateField.inclusion hLM₁' (((α'⁻¹ : Lˣ) : L)) * N₁ := by
    rw [hcM₁'_def, mul_inv_rev, inv_inv, Units.val_mul, Units.coe_map, hC_unit_def, Units.val_mk0,
      hnorm_M₁'K₁_C, ← map_inv, Units.coe_map, hinc_LM₁', mul_comm]
  have hcM₁'_stat : ∀ z : M₁',
      (z = 0 ∨ (((condExp F M₁' (recChar F rec M₁' χM₁') + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        ((recChar F rec M₁' χM₁') (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁') * z) := by
    intro z hz_val hz
    rw [hcM₁'_inv]
    exact hcM₁'_stat_N₁ z hz_val hz
  have htr_smul : ∀ {M₀ M₂ : IntermediateField F (AlgebraicClosure F)}
      (hM₀M₂ : M₀ ≤ M₂) (c : M₀) (z : M₂),
      traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ c * z) =
        c * traceLM F hM₀M₂ z := by
    intro M₀ M₂ hM₀M₂ c z
    letI : Module M₀ M₀ := Semiring.toModule
    exact (Algebra.trace M₀ (IntermediateField.extendScalars hM₀M₂)).map_smul' c
      (toExtendScalars F hM₀M₂ z)
  have hθ_C : (recChar F rec E' χE') (Units.map (normLM F hE'K₁) C_unit) =
      (recChar F rec M₁' χM₁') (Units.map (normLM F hM₁'K₁) C_unit) := by
    have h1 := DFunLike.congr_fun hχE'_comp C_unit
    have h2 := DFunLike.congr_fun hχM₁'_comp C_unit
    exact h1.trans h2.symm
  have hθ_c : ((recChar F rec E' χE') cE' : Ω F) * (νE' (α' * (Units.mk0 β₂ hβ₂)⁻¹) : Ω F) =
      ((recChar F rec M₁' χM₁') cM₁' : Ω F) * (νM₁' (α' * (Units.mk0 β₁ hβ₁)⁻¹) : Ω F) := by
    have h_units : (recChar F rec E' χE') cE' * νE' (α' * (Units.mk0 β₂ hβ₂)⁻¹) =
        (recChar F rec M₁' χM₁') cM₁' * νM₁' (α' * (Units.mk0 β₁ hβ₁)⁻¹) := by
      rw [hν_eq.1, hν_eq.2, hcE'_def, hcM₁'_def,
        map_mul (recChar F rec E' χE'), map_mul (recChar F rec M₁' χM₁'),
        map_inv, map_inv, hθ_C,
        mul_right_comm _ _ (νE' α'), hCommonRest α', mul_right_comm _ _ (νM₁' α')]
    exact_mod_cast congrArg Units.val h_units
  have htr_N_eq : traceLM F hLE' (normLM F hE'K₁ C) + β₂ =
      traceLM F hLM₁' N₁ + β₁ := by
    have he2 := hBiquadE2 C
    rw [htr_E'K₁_C, htr_M₁'K₁_C, hnorm_M₁'K₁_C] at he2
    linear_combination he2 - hQuadDiff0
  have hψ_c : (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E')) *
        ψ ((((α' * (Units.mk0 β₂ hβ₂)⁻¹)⁻¹ : Lˣ) : L)) =
      (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁')) *
        ψ ((((α' * (Units.mk0 β₁ hβ₁)⁻¹)⁻¹ : Lˣ) : L)) := by
    change ψ (traceLM F hLE' (((cE'⁻¹ : E'ˣ) : E'))) *
        ψ ((((α' * (Units.mk0 β₂ hβ₂)⁻¹)⁻¹ : Lˣ) : L)) =
      ψ (traceLM F hLM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁'))) *
        ψ ((((α' * (Units.mk0 β₁ hβ₁)⁻¹)⁻¹ : Lˣ) : L))
    rw [hcE'_inv, hcM₁'_inv, htr_smul hLE', htr_smul hLM₁',
      ← AddChar.map_add_eq_mul, ← AddChar.map_add_eq_mul]
    congr 1
    rw [mul_inv_rev, inv_inv, Units.val_mul, Units.val_mk0,
      mul_inv_rev, inv_inv, Units.val_mul, Units.val_mk0]
    linear_combination ((α'⁻¹ : Lˣ) : L) * htr_N_eq
  have hPrefactor : ((recChar F rec E' χE') cE' : Ω F) * (νE' (α' * (Units.mk0 β₂ hβ₂)⁻¹) : Ω F) *
        (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E')) *
        ψ ((((α' * (Units.mk0 β₂ hβ₂)⁻¹)⁻¹ : Lˣ) : L)) =
      ((recChar F rec M₁' χM₁') cM₁' : Ω F) * (νM₁' (α' * (Units.mk0 β₁ hβ₁)⁻¹) : Ω F) *
        (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁')) *
        ψ ((((α' * (Units.mk0 β₁ hβ₁)⁻¹)⁻¹ : Lˣ) : L)) := by
    calc ((recChar F rec E' χE') cE' : Ω F) * (νE' (α' * (Units.mk0 β₂ hβ₂)⁻¹) : Ω F) *
          (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E')) *
          ψ ((((α' * (Units.mk0 β₂ hβ₂)⁻¹)⁻¹ : Lˣ) : L))
      _ = (((recChar F rec E' χE') cE' : Ω F) * (νE' (α' * (Units.mk0 β₂ hβ₂)⁻¹) : Ω F)) *
          ((traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E')) *
            ψ ((((α' * (Units.mk0 β₂ hβ₂)⁻¹)⁻¹ : Lˣ) : L))) := by ring
      _ = (((recChar F rec M₁' χM₁') cM₁' : Ω F) * (νM₁' (α' * (Units.mk0 β₁ hβ₁)⁻¹) : Ω F)) *
          ((traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁')) *
            ψ ((((α' * (Units.mk0 β₁ hβ₁)⁻¹)⁻¹ : Lˣ) : L))) := by rw [hθ_c, hψ_c]
      _ = ((recChar F rec M₁' χM₁') cM₁' : Ω F) * (νM₁' (α' * (Units.mk0 β₁ hβ₁)⁻¹) : Ω F) *
          (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁')) *
          ψ ((((α' * (Units.mk0 β₁ hβ₁)⁻¹)⁻¹ : Lˣ) : L)) := by ring
  have hnorm_M₁'K₁_zero : normLM F hM₁'K₁ 0 = 0 := by
    have hq := ((hQuadNorm M₁' K₁ hM₁'K₁ hdeg2_M₁'K₁).2 1 1).2
    have htr1 := (hQuadNorm M₁' K₁ hM₁'K₁ hdeg2_M₁'K₁).1 1
    rw [map_one] at htr1
    rw [map_one, sub_self, htr1, map_one] at hq
    linear_combination hq
  have hNormPullbackE' : ∀ W ∈ unitGroup F K₁ (condExp F E' (recChar F rec E' χE') - condExp F L νM₁'),
      let uE' : E'ˣ := Units.map (normLM F hE'K₁) W
      ((recChar F rec E' χE') uE' : Ω F) =
        (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E') * ((uE' : E') - 1)) := by
    intro W hW
    dsimp only
    obtain ⟨uE', huE'_def⟩ : ∃ uE' : E'ˣ, uE' = Units.map (normLM F hE'K₁) W := ⟨_, rfl⟩
    obtain ⟨uM₁', huM₁'_def⟩ : ∃ uM₁' : M₁'ˣ, uM₁' = Units.map (normLM F hM₁'K₁) W := ⟨_, rfl⟩
    obtain ⟨v, hv_def⟩ : ∃ v : K₁, v = (W : K₁) - 1 := ⟨_, rfl⟩
    have hv_val : v = 0 ∨ ((2 * b₁ - 2 * r : ℕ) : ℤ) ≤ valL F K₁ v := by
      rw [hm2_sub_T1] at hW
      have h1 := (hvalK₁_ug (2 * b₁ - 2 * r) (by omega) W).mp hW
      rcases h1 with h1 | h1
      · left; rw [hv_def, h1, sub_self]
      · right; rw [hv_def]; exact h1
    obtain ⟨z_v, hz_v_def⟩ : ∃ z_v : M₁', z_v = (uM₁' : M₁') - 1 := ⟨_, rfl⟩
    have hz_v_eq : z_v = traceLM F hM₁'K₁ v + normLM F hM₁'K₁ v := by
      have hW_eq : (W : K₁) = IntermediateField.inclusion hM₁'K₁ 1 + v := by
        rw [map_one, hv_def, add_sub_cancel]
      have hq := ((hQuadNorm M₁' K₁ hM₁'K₁ hdeg2_M₁'K₁).2 1 v).1
      rw [← hW_eq] at hq
      have huM₁'_coe : (uM₁' : M₁') = normLM F hM₁'K₁ (W : K₁) := by
        rw [huM₁'_def, Units.coe_map]
      rw [hz_v_def, huM₁'_coe, hq]
      ring
    have htr_v_val : traceLM F hM₁'K₁ v = 0 ∨ (b₁ : ℤ) ≤ valL F M₁' (traceLM F hM₁'K₁ v) := by
      apply htr_M₁'K₁ (b₁ : ℤ) v
      rcases hv_val with hv0 | hv_ge
      · exact Or.inl hv0
      · right; omega
    have hnorm_v_val : normLM F hM₁'K₁ v = 0 ∨ (b₁ : ℤ) ≤ valL F M₁' (normLM F hM₁'K₁ v) := by
      rcases hv_val with hv0 | hv_ge
      · left; rw [hv0, hnorm_M₁'K₁_zero]
      · right; rw [(hval_normK₁ v).2]; omega
    have hz_v_val : z_v = 0 ∨
        (((condExp F M₁' (recChar F rec M₁' χM₁') + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z_v := by
      rw [h_half_m1, hz_v_eq]
      exact hvalM₁'_ultra (b₁ : ℤ) (traceLM F hM₁'K₁ v) (normLM F hM₁'K₁ v) htr_v_val hnorm_v_val
    have h1zv_eq : 1 + z_v = (uM₁' : M₁') := by
      rw [hz_v_def, add_sub_cancel]
    have hz_v_ne : 1 + z_v ≠ 0 := by
      rw [h1zv_eq]
      exact Units.ne_zero uM₁'
    have hmk0_zv : Units.mk0 (1 + z_v) hz_v_ne = uM₁' := Units.ext h1zv_eq
    have hθ_W : (recChar F rec E' χE') uE' = (recChar F rec M₁' χM₁') uM₁' := by
      have h1 := DFunLike.congr_fun hχE'_comp W
      have h2 := DFunLike.congr_fun hχM₁'_comp W
      rw [MonoidHom.comp_apply, ← huE'_def] at h1
      rw [MonoidHom.comp_apply, ← huM₁'_def] at h2
      exact h1.trans h2.symm
    have hθ_uE'_eq : ((recChar F rec E' χE') uE' : Ω F) =
        (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁') * z_v) := by
      have hstat := hcM₁'_stat z_v hz_v_val hz_v_ne
      rw [hmk0_zv, ← hθ_W] at hstat
      exact hstat
    obtain ⟨V, hV_def⟩ : ∃ V : K₁, V = C * v := ⟨_, rfl⟩
    have hV_val : V = 0 ∨ 2 * ((r : ℤ) - (a : ℤ)) ≤ valL F K₁ V := by
      rcases hv_val with hv0 | hv_ge
      · left; rw [hV_def, hv0, mul_zero]
      · by_cases hv0 : v = 0
        · left; rw [hV_def, hv0, mul_zero]
        · right
          rw [hV_def, hvalK₁_mul C v hC_ne hv0, hval_C]
          omega
    obtain ⟨T₂, hT₂_def⟩ : ∃ T₂ : E', T₂ = traceLM F hE'K₁ V := ⟨_, rfl⟩
    obtain ⟨T₁, hT₁_def⟩ : ∃ T₁ : M₁', T₁ = traceLM F hM₁'K₁ V := ⟨_, rfl⟩
    have hT₂_val : T₂ = 0 ∨ (r : ℤ) ≤ valL F E' T₂ := by
      rw [hT₂_def]
      apply htr_E'K₁ (r : ℤ) V
      rcases hV_val with hV0 | hV_ge
      · exact Or.inl hV0
      · right; omega
    have hT₁_val : T₁ = 0 ∨ 3 * (r : ℤ) - 2 * (a : ℤ) ≤ valL F M₁' T₁ := by
      rw [hT₁_def]
      apply htr_M₁'K₁ (3 * (r : ℤ) - 2 * (a : ℤ)) V
      rcases hV_val with hV0 | hV_ge
      · exact Or.inl hV0
      · right; omega
    have hCV_eq : C + V = C * (W : K₁) := by
      rw [hV_def, hv_def]
      ring
    have hnormE'_diff : normLM F hE'K₁ (C + V) - normLM F hE'K₁ C =
        normLM F hE'K₁ C * ((uE' : E') - 1) := by
      have huE'_coe : (uE' : E') = normLM F hE'K₁ (W : K₁) := by
        rw [huE'_def, Units.coe_map]
      rw [hCV_eq, map_mul, huE'_coe]
      ring
    have hnormM₁'_diff : normLM F hM₁'K₁ (C + V) - normLM F hM₁'K₁ C =
        N₁ * z_v := by
      have huM₁'_coe : (uM₁' : M₁') = normLM F hM₁'K₁ (W : K₁) := by
        rw [huM₁'_def, Units.coe_map]
      rw [hCV_eq, map_mul, hnorm_M₁'K₁_C, hz_v_def, huM₁'_coe]
      ring
    have he2_diff : traceLM F hLE' (normLM F hE'K₁ C * ((uE' : E') - 1)) +
          (normLM F hLE' (h₂ + T₂) - β₂) =
        traceLM F hLM₁' (N₁ * z_v) +
          (normLM F hLM₁' (h₁ + T₁) - β₁) := by
      have he2_CV := hBiquadE2 (C + V)
      have he2_C := hBiquadE2 C
      have hsub : (traceLM F hLE' (normLM F hE'K₁ (C + V)) - traceLM F hLE' (normLM F hE'K₁ C)) +
            (normLM F hLE' (traceLM F hE'K₁ (C + V)) - normLM F hLE' (traceLM F hE'K₁ C)) =
          (traceLM F hLM₁' (normLM F hM₁'K₁ (C + V)) - traceLM F hLM₁' (normLM F hM₁'K₁ C)) +
            (normLM F hLM₁' (traceLM F hM₁'K₁ (C + V)) - normLM F hLM₁' (traceLM F hM₁'K₁ C)) := by
        linear_combination he2_CV - he2_C
      rw [← map_sub (traceLM F hLE'), hnormE'_diff,
        ← map_sub (traceLM F hLM₁'), hnormM₁'_diff,
        map_add (traceLM F hE'K₁) C V, htr_E'K₁_C, ← hT₂_def, hQuadDiffE' T₂,
        map_add (traceLM F hM₁'K₁) C V, htr_M₁'K₁_C, ← hT₁_def, hQuadDiffM₁' T₁] at hsub
      have htr_T : traceLM F hLE' T₂ = traceLM F hLM₁' T₁ := by
        rw [hT₂_def, hT₁_def]
        exact (hTowerNormTr V).2
      rw [htr_T] at hsub
      linear_combination hsub
    have hψ_eq : (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E') * ((uE' : E') - 1)) *
          ψ (((α'⁻¹ : Lˣ) : L) * (normLM F hLE' (h₂ + T₂) - β₂)) =
        (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁') * z_v) *
          ψ (((α'⁻¹ : Lˣ) : L) * (normLM F hLM₁' (h₁ + T₁) - β₁)) := by
      change ψ (traceLM F hLE' (((cE'⁻¹ : E'ˣ) : E') * ((uE' : E') - 1))) *
          ψ (((α'⁻¹ : Lˣ) : L) * (normLM F hLE' (h₂ + T₂) - β₂)) =
        ψ (traceLM F hLM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * z_v)) *
          ψ (((α'⁻¹ : Lˣ) : L) * (normLM F hLM₁' (h₁ + T₁) - β₁))
      rw [hcE'_inv, mul_assoc, htr_smul hLE',
        hcM₁'_inv, mul_assoc, htr_smul hLM₁',
        ← AddChar.map_add_eq_mul, ← AddChar.map_add_eq_mul]
      congr 1
      linear_combination ((α'⁻¹ : Lˣ) : L) * he2_diff
    rw [hPhaseE' T₂ hT₂_val, mul_one, hPhaseM₁' T₁ hT₁_val, mul_one] at hψ_eq
    rw [← huE'_def, hθ_uE'_eq, hψ_eq]
  exact ⟨cE', cM₁', hcE'_val, hcM₁'_val, hcM₁'_stat, hPrefactor, hNormPullbackE'⟩

theorem ld_ch12_wild_dyadic_even_breaks_higher_cond_herbrand_norm_descent_E (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hE'K₁ : E' ≤ K₁)
    (θE' : E'ˣ →* (Ω F)ˣ)
    (ψE' : AddChar E' (Ω F))
    (t₁ : ℕ)
    (ht₁_ge2 : 2 ≤ t₁)
    (hm2_even : condExp F E' θE' % 2 = 0)
    (hm2_ge : 2 * t₁ ≤ condExp F E' θE')
    (hθE'_triv : ∀ u ∈ unitGroup F E' (condExp F E' θE'), θE' u = 1)
    (hSpecE' : ∀ y : E', (y = 0 ∨ -condExpChar F E' ψE' ≤ valL F E' y) → ψE' y = 1)
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hnorm_surj_gt_E'K₁ : ∀ r₀ ≥ t₁, ∀ u ∈ unitGroup F E' r₀,
      ∃ w ∈ unitGroup F K₁ ((t₁ - 1) + 2 * (r₀ - (t₁ - 1))),
        (Units.map (normLM F hE'K₁) w) * u⁻¹ ∈ unitGroup F E' (r₀ + 1))
    (cE' : E'ˣ)
    (hcE'_val : valL F E' (cE' : E') = (condExp F E' θE' : ℤ) + condExpChar F E' ψE')
    (hNormPullbackE' : ∀ W ∈ unitGroup F K₁ (condExp F E' θE' - t₁),
      let uE' : E'ˣ := Units.map (normLM F hE'K₁) W
      (θE' uE' : Ω F) = ψE' (((cE'⁻¹ : E'ˣ) : E') * ((uE' : E') - 1))) :
    ∀ w : E', (w = 0 ∨ (((condExp F E' θE' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' w) →
      ∀ hw : 1 + w ≠ 0,
        (θE' (Units.mk0 (1 + w) hw) : Ω F) = ψE' (((cE'⁻¹ : E'ˣ) : E') * w) :=
by
  obtain ⟨m₂, b₂, hm₂_def, hb₂_def, hm₂_eq, hb₂_ge_t₁, hb₂_ge2, hm₂_ge4⟩ :
      ∃ m₂ b₂ : ℕ,
        condExp F E' θE' = m₂ ∧
        (condExp F E' θE' + 1) / 2 = b₂ ∧
        m₂ = 2 * b₂ ∧
        t₁ ≤ b₂ ∧
        2 ≤ b₂ ∧
        4 ≤ m₂ := by
    refine ⟨condExp F E' θE', (condExp F E' θE' + 1) / 2, rfl, rfl,
      by omega, by omega, by omega, by omega⟩
  rw [hm₂_def] at hθE'_triv hcE'_val hNormPullbackE'
  rw [hb₂_def]
  rcases hvalE'_props with ⟨_, _, _, _, hvalE'_mul, hvalE'_inv, _, _, _, hunitE'_mem, _⟩
  rcases hvalK₁_props with ⟨_, _, _, _, _, _, _, _, _, hunitK₁_mem, _⟩
  have hU_E'_mono : ∀ {a₁ a₂ : ℕ}, 1 ≤ a₁ → a₁ ≤ a₂ →
      ∀ {u : E'ˣ}, u ∈ unitGroup F E' a₂ → u ∈ unitGroup F E' a₁ := by
    intro a₁ a₂ ha₁ ha₁₂ u hu
    rw [hunitE'_mem a₂ (by omega) u] at hu
    rw [hunitE'_mem a₁ ha₁ u]
    rcases hu with hu | hu
    · exact Or.inl hu
    · exact Or.inr (by omega)
  have hU_K₁_mono : ∀ {a₁ a₂ : ℕ}, 1 ≤ a₁ → a₁ ≤ a₂ →
      ∀ {w : K₁ˣ}, w ∈ unitGroup F K₁ a₂ → w ∈ unitGroup F K₁ a₁ := by
    intro a₁ a₂ ha₁ ha₁₂ w hw
    rw [hunitK₁_mem a₂ (by omega) w] at hw
    rw [hunitK₁_mem a₁ ha₁ w]
    rcases hw with hw | hw
    · exact Or.inl hw
    · exact Or.inr (by omega)
  have hψE'_triv_m₂ : ∀ y : E', (y = 0 ∨ (m₂ : ℤ) ≤ valL F E' y) →
      ψE' (((cE'⁻¹ : E'ˣ) : E') * y) = 1 := by
    intro y hy
    apply hSpecE' (((cE'⁻¹ : E'ˣ) : E') * y)
    by_cases hy0 : y = 0
    · left; rw [hy0, mul_zero]
    · rcases hy with rfl | hy
      · contradiction
      · right
        rw [hvalE'_mul ((cE'⁻¹ : E'ˣ) : E') y (Units.ne_zero _) hy0,
          hvalE'_inv cE', hcE'_val]
        omega
  have hψE'_mul_b₂ : ∀ u₁ u₂ : E'ˣ,
      u₁ ∈ unitGroup F E' b₂ → u₂ ∈ unitGroup F E' b₂ →
      ψE' (((cE'⁻¹ : E'ˣ) : E') * (((u₁ * u₂ : E'ˣ) : E') - 1)) =
        ψE' (((cE'⁻¹ : E'ˣ) : E') * ((u₁ : E') - 1)) *
          ψE' (((cE'⁻¹ : E'ˣ) : E') * ((u₂ : E') - 1)) := by
    intro u₁ u₂ hu₁ hu₂
    obtain ⟨w₁, hw₁_def⟩ : ∃ w₁ : E', w₁ = (u₁ : E') - 1 := ⟨_, rfl⟩
    obtain ⟨w₂, hw₂_def⟩ : ∃ w₂ : E', w₂ = (u₂ : E') - 1 := ⟨_, rfl⟩
    have hw₁_val : w₁ = 0 ∨ (b₂ : ℤ) ≤ valL F E' w₁ := by
      rcases (hunitE'_mem b₂ (by omega) u₁).mp hu₁ with h1 | hge
      · left; rw [hw₁_def, h1, sub_self]
      · right; rw [hw₁_def]; exact hge
    have hw₂_val : w₂ = 0 ∨ (b₂ : ℤ) ≤ valL F E' w₂ := by
      rcases (hunitE'_mem b₂ (by omega) u₂).mp hu₂ with h1 | hge
      · left; rw [hw₂_def, h1, sub_self]
      · right; rw [hw₂_def]; exact hge
    have hw₁₂_val : w₁ * w₂ = 0 ∨ (m₂ : ℤ) ≤ valL F E' (w₁ * w₂) := by
      by_cases hw₁0 : w₁ = 0
      · left; rw [hw₁0, zero_mul]
      · by_cases hw₂0 : w₂ = 0
        · left; rw [hw₂0, mul_zero]
        · rcases hw₁_val with rfl | hw₁_ge
          · contradiction
          · rcases hw₂_val with rfl | hw₂_ge
            · contradiction
            · right
              rw [hvalE'_mul w₁ w₂ hw₁0 hw₂0]
              omega
    have hprod_eq : ((cE'⁻¹ : E'ˣ) : E') * (((u₁ * u₂ : E'ˣ) : E') - 1) =
        (((cE'⁻¹ : E'ˣ) : E') * w₁ + ((cE'⁻¹ : E'ˣ) : E') * w₂) +
          ((cE'⁻¹ : E'ˣ) : E') * (w₁ * w₂) := by
      rw [Units.val_mul, hw₁_def, hw₂_def]
      ring
    rw [hprod_eq, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul,
      hψE'_triv_m₂ (w₁ * w₂) hw₁₂_val, mul_one, ← hw₁_def, ← hw₂_def]
  have hDesc : ∀ k : ℕ, k ≤ m₂ - b₂ →
      ∀ u ∈ unitGroup F E' (m₂ - k),
        (θE' u : Ω F) = ψE' (((cE'⁻¹ : E'ˣ) : E') * ((u : E') - 1)) := by
    intro k
    induction k with
    | zero =>
      intro _ u hu
      rw [Nat.sub_zero] at hu
      have hθ_1 : (θE' u : Ω F) = 1 := by
        rw [hθE'_triv u hu, Units.val_one]
      have hw_val : (u : E') - 1 = 0 ∨ (m₂ : ℤ) ≤ valL F E' ((u : E') - 1) := by
        rcases (hunitE'_mem m₂ (by omega) u).mp hu with h1 | hge
        · left; rw [h1, sub_self]
        · right; exact hge
      rw [hθ_1, hψE'_triv_m₂ ((u : E') - 1) hw_val]
    | succ k ih =>
      intro hk u hu
      obtain ⟨r₀, hr₀_def⟩ : ∃ r₀ : ℕ, r₀ = m₂ - (k + 1) := ⟨_, rfl⟩
      rw [← hr₀_def] at hu
      have hr₀_ge_b₂ : b₂ ≤ r₀ := by omega
      have hr₀_ge_t₁ : t₁ ≤ r₀ := by omega
      have hr₀_succ : m₂ - k = r₀ + 1 := by omega
      obtain ⟨W, hW_mem, hv_mem⟩ := hnorm_surj_gt_E'K₁ r₀ hr₀_ge_t₁ u hu
      obtain ⟨uW, huW_def⟩ : ∃ uW : E'ˣ, uW = Units.map (normLM F hE'K₁) W := ⟨_, rfl⟩
      obtain ⟨v, hv_def⟩ : ∃ v : E'ˣ, v = uW * u⁻¹ := ⟨_, rfl⟩
      rw [← huW_def, ← hv_def] at hv_mem
      have hW_pull : W ∈ unitGroup F K₁ (m₂ - t₁) :=
        hU_K₁_mono (by omega) (by omega) hW_mem
      have hpull := hNormPullbackE' W hW_pull
      dsimp only at hpull
      rw [← huW_def] at hpull
      have hv_mem_mk : v ∈ unitGroup F E' (m₂ - k) := by
        rw [hr₀_succ]; exact hv_mem
      have hv_ih : (θE' v : Ω F) = ψE' (((cE'⁻¹ : E'ˣ) : E') * ((v : E') - 1)) :=
        ih (by omega) v hv_mem_mk
      have hv_b₂ : v ∈ unitGroup F E' b₂ :=
        hU_E'_mono (by omega) (by omega) hv_mem
      have hu_b₂ : u ∈ unitGroup F E' b₂ :=
        hU_E'_mono (by omega) hr₀_ge_b₂ hu
      have huW_eq : uW = v * u := by
        rw [hv_def, inv_mul_cancel_right]
      have hθ_mul : (θE' uW : Ω F) = (θE' v : Ω F) * (θE' u : Ω F) := by
        rw [huW_eq, map_mul, Units.val_mul]
      have hψ_mul : ψE' (((cE'⁻¹ : E'ˣ) : E') * ((uW : E') - 1)) =
          ψE' (((cE'⁻¹ : E'ˣ) : E') * ((v : E') - 1)) *
            ψE' (((cE'⁻¹ : E'ˣ) : E') * ((u : E') - 1)) := by
        rw [huW_eq]
        exact hψE'_mul_b₂ v u hv_b₂ hu_b₂
      rw [hθ_mul, hψ_mul, ← hv_ih] at hpull
      exact mul_left_cancel₀ (Units.ne_zero (θE' v)) hpull
  intro w hw_val hw
  obtain ⟨u, hu_def⟩ : ∃ u : E'ˣ, u = Units.mk0 (1 + w) hw := ⟨_, rfl⟩
  have hu_sub : (u : E') - 1 = w := by
    rw [hu_def, Units.val_mk0, add_sub_cancel_left]
  have hu_mem : u ∈ unitGroup F E' (m₂ - (m₂ - b₂)) := by
    have hsub_eq : m₂ - (m₂ - b₂) = b₂ := by omega
    rw [hsub_eq, hunitE'_mem b₂ (by omega) u]
    rcases hw_val with rfl | hw_ge
    · left; rw [hu_def, Units.val_mk0, add_zero]
    · right; rw [hu_sub]; exact hw_ge
  have hstat := hDesc (m₂ - b₂) le_rfl u hu_mem
  rw [hu_sub, hu_def] at hstat
  exact hstat

theorem ld_ch12_wild_dyadic_even_breaks_higher_cond_cE_stationarity_and_prefactor (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
