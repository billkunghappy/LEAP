    ring
  have hConj5 : normLM F hLE' h₂ = β₂ := by
    have hh₂_eq : h₂ = IntermediateField.inclusion hLE' (-1) +
        IntermediateField.inclusion hLE' (2 * d) * y := by
      dsimp only [h₂]
