        right
        rw [(hvalE'_pow_eq (w₂ : E') (Units.ne_zero w₂) (p - i)).2, hw₂_val]
        linarith
      have hterm := hvalE'_mul_ge
        (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (i : ℤ) * (m : ℤ))
        (-((p - i : ℕ) : ℤ) * (m : ℤ))
        ((-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i))
        ((w₂ : E') ^ (p - i)) hsi hw₂_pi
      apply hvalE'_mono _ _ _ _ hterm
      have hpi_cast : ((p - i : ℕ) : ℤ) = (p : ℤ) - (i : ℤ) := Nat.cast_sub hi_le
      rw [hpi_cast]
      linarith
    have hprod := hvalE'_mul_ge ((p : ℤ) * (m : ℤ))
      (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (p : ℤ) * (m : ℤ))
      (IntermediateField.inclusion hLE' u)
      (∑ i ∈ Finset.Icc 1 (p - 1),
        (-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i) *
          (w₂ : E') ^ (p - i))
      (Or.inr (by rw [hu_E'_val])) hsum_val
    rcases hprod with h0 | hge
    · left; rw [h0, neg_zero]
    · right
      rw [hvalE'_neg]
      linarith

  
  have hw₂_ne0 : (w₂ : E') ≠ 0 := Units.ne_zero w₂
  have h2p1_eq : 2 * (p - 1) = (p - 2) + p := by omega
  have hw₂_2p1 : (w₂ : E') ^ (2 * (p - 1)) = (w₂ : E') ^ (p - 2) * (w₂ : E') ^ p := by
    rw [h2p1_eq, pow_add]
  have hysT_id :
      (y_s - y_T) - y_sT =
        s₀ * a * (1 - IntermediateField.inclusion hLE' u * (w₂ : E') ^ p) *
          ((w₂ : E') ^ (2 * (p - 1)) * C ^ 2)⁻¹ := by
    rw [hys_def, hyT_def, hysT_def, hw₂_2p1]
    have hw₂_p2_ne : (w₂ : E') ^ (p - 2) ≠ 0 := pow_ne_zero (p - 2) hw₂_ne0
    have hw₂_p_ne : (w₂ : E') ^ p ≠ 0 := pow_ne_zero p hw₂_ne0
    field_simp [hw₂_p2_ne, hw₂_p_ne, hC_ne0]
    rw [hC_def]
    ring

  have hdenom_inv_val :
      ((w₂ : E') ^ (2 * (p - 1)) * C ^ 2)⁻¹ = 0 ∨
        ((2 * (p - 1) : ℕ) : ℤ) * (m : ℤ) ≤
          valL F E' (((w₂ : E') ^ (2 * (p - 1)) * C ^ 2)⁻¹) := by
    right
    have hw₂_2p1_pow := hvalE'_pow_eq (w₂ : E') hw₂_ne0 (2 * (p - 1))
    have hC_sq_pow := hvalE'_pow_eq C hC_ne0 2
    have hprod_ne : (w₂ : E') ^ (2 * (p - 1)) * C ^ 2 ≠ 0 :=
      mul_ne_zero hw₂_2p1_pow.1 hC_sq_pow.1
    rw [hvalE'_inv _ hprod_ne, hvalE'_mul _ _ hw₂_2p1_pow.1 hC_sq_pow.1,
      hw₂_2p1_pow.2, hC_sq_pow.2, hw₂_val, hC_val0']
    linarith

  have hConj2 : (y_s - y_T) - y_sT = 0 ∨
      (bE' : ℤ) ≤ valL F E' ((y_s - y_T) - y_sT) := by
    rw [hysT_id]
    have hs₀_val' : s₀ = 0 ∨ ((p - 1 : ℕ) : ℤ) * (δ : ℤ) ≤ valL F E' s₀ := hs₀_val
    apply hvalE'_mul4 _ _ _ _ (bE' : ℤ)
      s₀ a (1 - IntermediateField.inclusion hLE' u * (w₂ : E') ^ p)
      (((w₂ : E') ^ (2 * (p - 1)) * C ^ 2)⁻¹)
      hs₀_val' (Or.inr (by rw [ha_val])) h_uw₂p hdenom_inv_val
    have h_t₂_mul : (t₂ : ℤ) ≤ ((p - 2 : ℕ) : ℤ) * (t₂ : ℤ) := by
      have hp2_ge1 : (1 : ℤ) ≤ ((p - 2 : ℕ) : ℤ) := by omega
      calc (t₂ : ℤ) = 1 * (t₂ : ℤ) := by ring
        _ ≤ ((p - 2 : ℕ) : ℤ) * (t₂ : ℤ) := mul_le_mul_of_nonneg_right hp2_ge1 (by omega)
    have h_m_mul : (4 : ℤ) ≤ 2 * ((p : ℤ) - 1) * (m : ℤ) := by
      calc (4 : ℤ) = 2 * 2 * 1 := by ring
        _ ≤ 2 * ((p : ℤ) - 1) * (m : ℤ) :=
          mul_le_mul (mul_le_mul_of_nonneg_left (by omega) (by omega))
            (by omega) (by omega) (by omega)
    have h_δ_mul : (0 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (δ : ℤ) := mul_nonneg (by omega) (by omega)
    have hp2_cast : ((p - 2 : ℕ) : ℤ) = (p : ℤ) - 2 := Nat.cast_sub (by omega : 2 ≤ p)
    have h2p1_cast : ((2 * (p - 1) : ℕ) : ℤ) = 2 * ((p : ℤ) - 1) := by
      push_cast
      rw [hp1_cast]
    rw [hbE'_eq, h2p1_cast, hp1_cast, ht₂_eq] at *
    rw [hp2_cast] at h_t₂_mul
    linarith

  exact ⟨hConj1, hConj2⟩

theorem ld_ch12_wild_odd_tot_ram_weighted_sum_comb_in_E' (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    (hLE' : L ≤ E')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F))
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hp_valE' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      ((p : ℕ) : E') = 0 ∨ (((p - 1) * (bE' - 1) : ℕ) : ℤ) ≤ valL F E' ((p : ℕ) : E'))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (a s₀ : E')
    (ha_val : valL F E' a = -((bM₁' - 1 : ℕ) : ℤ))
    (hs₀_val : s₀ = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
        ((bE' - bM₁' : ℕ) : ℤ) ≤ valL F E' s₀)
    (α γ : Lˣ) (w₂ : E'ˣ)
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ)
    (hw₂_val : valL F E' (w₂ : E') = -((a_lam - bE' : ℕ) : ℤ))
    (hC_ne0 :
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      1 + IntermediateField.inclusion hLE' u * a ≠ 0)
    (hC_val0 :
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      valL F E' (1 + IntermediateField.inclusion hLE' u * a) = 0)
    (hD₀_ne0 :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
      let W_E' := IntermediateField.inclusion hLE' W
      W_E' ^ p - W_E' + a ^ p ≠ 0)
    (hD₀_val :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m := a_lam - bE'
      let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
      let W_E' := IntermediateField.inclusion hLE' W
      valL F E' (W_E' ^ p - W_E' + a ^ p) = -(((p * p * m : ℕ) : ℤ)))
    (W_fn : ℕ → E') (Q_quad : E')
    (hW_thm97 :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
      let C := 1 + IntermediateField.inclusion hLE' u * a
      let W_E' := IntermediateField.inclusion hLE' W
      let D₀_E' := W_E' ^ p - W_E' + a ^ p
      let F_fn : ℕ → E' := fun i =>
        W_E' * D₀_E'⁻¹ * ((W_E' + a) * (((w₂⁻¹ : E'ˣ) : E'))) ^ i
      let y_s := s₀ * ((w₂ : E') ^ (p - 2) * C ^ 2)⁻¹
      ∀ i ∈ Finset.Icc 1 (p - 1),
        let W_model :=
          ((p - 1 : ℕ) : E') * W_E' * (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) *
              (if i = p - 1 then 1 else 0) -
            ((p - 1 : ℕ) : E') * (-1 : E') ^ i * W_E' * F_fn i -
            ((p - 1 : ℕ) : E') * y_s * (if i = p - 2 then 1 else 0)
        W_fn i - W_model = 0 ∨ (bE' : ℤ) ≤ valL F E' (W_fn i - W_model))
    (hQ_thm911 :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      let C := 1 + IntermediateField.inclusion hLE' u * a
      let y_T := - a * s₀ * ((w₂ : E') ^ (2 * (p - 1)) * C ^ 2)⁻¹
      Q_quad - ((p - 1 : ℕ) : E') * y_T = 0 ∨
        (bE' : ℤ) ≤ valL F E' (Q_quad - ((p - 1 : ℕ) : E') * y_T))
    (hysT_unif :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      let C := 1 + IntermediateField.inclusion hLE' u * a
      let y_s := s₀ * ((w₂ : E') ^ (p - 2) * C ^ 2)⁻¹
      let y_T := - a * s₀ * ((w₂ : E') ^ (2 * (p - 1)) * C ^ 2)⁻¹
      let y_sT := s₀ * ((w₂ : E') ^ (p - 2) * C)⁻¹
      (y_s - y_T) - y_sT = 0 ∨ (bE' : ℤ) ≤ valL F E' ((y_s - y_T) - y_sT)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
    let W := (γ : L) * ((α⁻¹ : Lˣ) : L)
    let C := 1 + IntermediateField.inclusion hLE' u * a
    let W_E' := IntermediateField.inclusion hLE' W
    let D₀_E' := W_E' ^ p - W_E' + a ^ p
    let F_fn : ℕ → E' := fun i =>
      W_E' * D₀_E'⁻¹ * ((W_E' + a) * (((w₂⁻¹ : E'ˣ) : E'))) ^ i
    let y_sT := s₀ * ((w₂ : E') ^ (p - 2) * C)⁻¹
    (((∑ i ∈ Finset.Icc 1 (p - 1), (-1 : E') ^ i * ((i : ℕ) : E')⁻¹ * W_fn i) +
        (2 : E')⁻¹ * ((p - 1 : ℕ) : E')⁻¹ ^ 2 * Q_quad) -
      (- W_E' * F_fn (p - 1) +
        W_E' * (∑ i ∈ Finset.Icc 1 (p - 2), ((i : ℕ) : E')⁻¹ * F_fn i) +
        W_E' * (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) +
        (2 : E')⁻¹ * y_sT) = 0 ∨
      (bE' : ℤ) ≤
        valL F E'
          (((∑ i ∈ Finset.Icc 1 (p - 1), (-1 : E') ^ i * ((i : ℕ) : E')⁻¹ * W_fn i) +
              (2 : E')⁻¹ * ((p - 1 : ℕ) : E')⁻¹ ^ 2 * Q_quad) -
            (- W_E' * F_fn (p - 1) +
              W_E' * (∑ i ∈ Finset.Icc 1 (p - 2), ((i : ℕ) : E')⁻¹ * F_fn i) +
              W_E' * (((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) +
              (2 : E')⁻¹ * y_sT))) :=
by
  intro p u W C W_E' D₀_E' F_fn y_sT
  obtain ⟨_, _, _, _, hvalL_mul, hvalL_inv, _, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨hvalE'_0, hvalE'_1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv, _, hvalE'_add, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F E'
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ne2 : p ≠ 2 := by dsimp [p]; rw [hWild]; exact hp_odd
  have hp_ge3 : 3 ≤ p := by omega
  have hp_odd_nat : Odd p := Nat.Prime.odd_of_ne_two hPrime hp_ne2
  let t₁ : ℕ := bM₁' - 1
  let t₂ : ℕ := bE' - 1
  let δ : ℕ := bE' - bM₁'
  let m : ℕ := a_lam - bE'
  have ht₁_ge1 : 1 ≤ t₁ := by dsimp [t₁]; omega
  have ht₂_ge1 : 1 ≤ t₂ := by dsimp [t₂]; omega
  have hm_ge1 : 1 ≤ m := by dsimp [m]; omega
  have hvalE'_sub : ∀ (k : ℤ) (x y : E'),
      (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
      (x - y = 0 ∨ k ≤ valL F E' (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    refine hvalE'_add k x (-y) hx ?_
    rcases hy with rfl | hky
    · left; simp
    · right; rwa [hvalE'_neg]
  have hvalE'_sum : ∀ (s : Finset ℕ) (f : ℕ → E') (k : ℤ),
      (∀ i ∈ s, f i = 0 ∨ k ≤ valL F E' (f i)) →
      ((∑ i ∈ s, f i) = 0 ∨ k ≤ valL F E' (∑ i ∈ s, f i)) := by
    intro s f k hf
    induction' s using Finset.cons_induction with i s hi ih
    · left; simp
    · rw [Finset.sum_cons]
      exact hvalE'_add k (f i) (∑ x ∈ s, f x)
        (hf i (Finset.mem_cons_self i s))
        (ih (fun x hx => hf x (Finset.mem_cons_of_mem hx)))
  have hmul_E' : ∀ (kx ky : ℤ) (x y : E'),
      (x = 0 ∨ kx ≤ valL F E' x) → (y = 0 ∨ ky ≤ valL F E' y) →
      (x * y = 0 ∨ kx + ky ≤ valL F E' (x * y)) := by
    intro kx ky x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hvalE'_mul x y hx0 hy0]
        linarith [hx.resolve_left hx0, hy.resolve_left hy0]
  have hvalE'_pow : ∀ (x : E') (k : ℕ), x ≠ 0 →
      x ^ k ≠ 0 ∧ valL F E' (x ^ k) = (k : ℤ) * valL F E' x := by
    intro x k hx
    induction k with
    | zero =>
      rw [pow_zero]
      exact ⟨one_ne_zero, by simp [hvalE'_1]⟩
    | succ k ih =>
      rw [pow_succ]
      refine ⟨mul_ne_zero ih.1 hx, ?_⟩
      rw [hvalE'_mul (x ^ k) x ih.1 hx, ih.2]
      push_cast
      ring
  have hvalE'_inv₀ : ∀ (x : E'), x ≠ 0 → valL F E' x⁻¹ = - valL F E' x := by
    intro x hx
    exact hvalE'_inv (Units.mk0 x hx)
  have hval_add_strict : ∀ (x y : E'),
      x ≠ 0 → (y = 0 ∨ valL F E' x < valL F E' y) →
        x + y ≠ 0 ∧ valL F E' (x + y) = valL F E' x := by
    intro x y hx hxy
    rcases hxy with rfl | hlt
    · simp [hx]
    · by_cases hy0 : y = 0
      · simp [hy0, hx]
      · have hxy_ne0 : x + y ≠ 0 := by
          intro h0
          have hx_eq : x = -y := eq_neg_of_add_eq_zero_left h0
          have hveq : valL F E' x = valL F E' y := by rw [hx_eq, hvalE'_neg]
          omega
        have hge : valL F E' x ≤ valL F E' (x + y) :=
          (hvalE'_add (valL F E' x) x y (Or.inr le_rfl) (Or.inr (le_of_lt hlt))).resolve_left hxy_ne0
        have hle : valL F E' (x + y) ≤ valL F E' x := by
          by_contra hgt
          push_neg at hgt
          set k : ℤ := min (valL F E' (x + y)) (valL F E' y)
          have hk_xy : x + y = 0 ∨ k ≤ valL F E' (x + y) := Or.inr (min_le_left _ _)
          have hk_ny : -y = 0 ∨ k ≤ valL F E' (-y) := by
            right; rw [hvalE'_neg]; exact min_le_right _ _
          have hsum := hvalE'_add k (x + y) (-y) hk_xy hk_ny
          rw [add_neg_cancel_right] at hsum
          have hk_le : k ≤ valL F E' x := hsum.resolve_left hx
          have hlt_k : valL F E' x < k := lt_min hgt hlt
          omega
        exact ⟨hxy_ne0, le_antisymm hle hge⟩
  have hnat_E' : ∀ k : ℕ, ((k : ℕ) : E') = 0 ∨ (0 : ℤ) ≤ valL F E' ((k : ℕ) : E') := by
    intro k
    induction k with
    | zero => left; simp
    | succ k₀ ih =>
      rw [Nat.cast_succ]
      exact hvalE'_add 0 (k₀ : E') 1 ih (Or.inr (by rw [hvalE'_1]))
  have hint_E' : ∀ z₀ : ℤ, (z₀ : E') = 0 ∨ (0 : ℤ) ≤ valL F E' (z₀ : E') := by
    intro z₀
    cases z₀ with
    | ofNat k => simpa using hnat_E' k
    | negSucc k =>
      rw [Int.cast_negSucc]
      rcases hnat_E' (k + 1) with h0 | hge
      · left; exact neg_eq_zero.mpr h0
      · right; rw [hvalE'_neg]; exact hge
  have hval_neg1_pow_E' : ∀ r : ℕ,
      (-1 : E') ^ r ≠ 0 ∧ valL F E' ((-1 : E') ^ r) = 0 := by
    intro r
    induction r with
    | zero =>
      rw [pow_zero]
      exact ⟨one_ne_zero, hvalE'_1⟩
    | succ r ih =>
      rw [pow_succ]
      have hneg1_ne0 : (-1 : E') ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hne : (-1 : E') ^ r * (-1 : E') ≠ 0 := mul_ne_zero ih.1 hneg1_ne0
      refine ⟨hne, ?_⟩
      rw [hvalE'_mul _ _ ih.1 hneg1_ne0, ih.2, hvalE'_neg1, add_zero]
  have hneg1_p1 : (-1 : E') ^ (p - 1) = 1 := by
    obtain ⟨k, hk⟩ := hp_odd_nat
    have hp1_even : 2 * k = p - 1 := by omega
    rw [← hp1_even, pow_mul, neg_one_sq, one_pow]
  have hneg1_p2 : (-1 : E') ^ (p - 2) = -1 := by
    obtain ⟨k, hk⟩ := hp_odd_nat
    have hp2_odd : 2 * (k - 1) + 1 = p - 2 := by omega
    rw [← hp2_odd, pow_succ, pow_mul, neg_one_sq, one_pow, one_mul]
  have hneg1_sq_i : ∀ i : ℕ, (-1 : E') ^ i * (-1 : E') ^ i = 1 := by
    intro i
    rw [← pow_add, ← two_mul, pow_mul, neg_one_sq, one_pow]
  have hp_valE'_ge1 : ((p : ℕ) : E') = 0 ∨ 1 ≤ valL F E' ((p : ℕ) : E') := by
    rcases hp_valE' with h0 | hge
    · exact Or.inl h0
    · right
      have h1 : 1 ≤ (p - 1) * (bE' - 1) := Nat.mul_pos (by omega) (by omega)
      have h1_int : (1 : ℤ) ≤ (((p - 1) * (bE' - 1) : ℕ) : ℤ) := by exact_mod_cast h1
      exact le_trans h1_int hge
  have hcoprime_val_E' : ∀ {k : ℕ}, k ∈ Finset.Icc 1 (p - 1) →
      ((k : ℕ) : E') ≠ 0 ∧ valL F E' ((k : ℕ) : E') = 0 ∧
        valL F E' (((k : ℕ) : E')⁻¹) = 0 := by
    intro k hk
    obtain ⟨hk1, hkp1⟩ := Finset.mem_Icc.mp hk
    have hnot_ge1 : ¬ (((k : ℕ) : E') = 0 ∨ 1 ≤ valL F E' ((k : ℕ) : E')) := by
      intro hk_bad
      have hndvd : ¬ (p ∣ k) := Nat.not_dvd_of_pos_of_lt hk1 (by omega)
      have hcop : Nat.Coprime p k := (Nat.Prime.coprime_iff_not_dvd hPrime).mpr hndvd
      have hgcd : Nat.gcd k p = 1 := Nat.Coprime.gcd_eq_one hcop.symm
      have hbez_int : (1 : ℤ) = (k : ℤ) * Nat.gcdA k p + (p : ℤ) * Nat.gcdB k p := by
        have h := Nat.gcd_eq_gcd_ab k p
        rw [hgcd] at h
        simpa using h
      have hbez_E' : (1 : E') =
          ((k : ℕ) : E') * (Nat.gcdA k p : E') + ((p : ℕ) : E') * (Nat.gcdB k p : E') := by
        have h := congrArg (Int.cast : ℤ → E') hbez_int
        push_cast at h
        exact h
      have hterm1 : ((k : ℕ) : E') * (Nat.gcdA k p : E') = 0 ∨
          1 ≤ valL F E' (((k : ℕ) : E') * (Nat.gcdA k p : E')) := by
        have h := hmul_E' 1 0 ((k : ℕ) : E') (Nat.gcdA k p : E') hk_bad (hint_E' (Nat.gcdA k p))
        rwa [add_zero] at h
      have hterm2 : ((p : ℕ) : E') * (Nat.gcdB k p : E') = 0 ∨
          1 ≤ valL F E' (((p : ℕ) : E') * (Nat.gcdB k p : E')) := by
        have h := hmul_E' 1 0 ((p : ℕ) : E') (Nat.gcdB k p : E') hp_valE'_ge1 (hint_E' (Nat.gcdB k p))
        rwa [add_zero] at h
      have hsum := hvalE'_add 1 _ _ hterm1 hterm2
      rw [← hbez_E', hvalE'_1] at hsum
      rcases hsum with h10 | h1le0
      · exact one_ne_zero h10
      · omega
    rcases hnat_E' k with hk0 | hk_ge0
