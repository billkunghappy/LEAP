          intro x
          have hx_not_H : x * c.1 * x⁻¹ ∉ H := by
            intro hxH
            have hxC : x * c.1 * x⁻¹ ∈ C := hC_norm.conj_mem c.1 c.2 x
            have hx1 : x * c.1 * x⁻¹ = 1 := h_disj_HC _ hxH hxC
            have hc_val : c.1 = 1 := by
              calc c.1 = x⁻¹ * (x * c.1 * x⁻¹) * x := by group
                _ = x⁻¹ * 1 * x := by rw [hx1]
                _ = 1 := by group
            exact hc1 (Subtype.ext hc_val)
          exact dif_neg hx_not_H
        simp_rw [h_term]
        rw [Finset.sum_const_zero, mul_zero]
    have h_eval_C : ∀ i : Fin r,
        indCharTrace F C (μ_bar i) c.1 =
          ∑ h : H, (μ_bar i ⟨h.1 * c.1 * h.1⁻¹, hC_norm.conj_mem c.1 c.2 h.1⟩ : Ω F) := by
      intro i
      unfold indCharTrace
      have h_sum_eq :
          (∑ x : G, if h : x * c.1 * x⁻¹ ∈ C then (μ_bar i ⟨x * c.1 * x⁻¹, h⟩ : Ω F) else 0) =
          ∑ p : H × C,
            if h : e_HC p * c.1 * (e_HC p)⁻¹ ∈ C then
              (μ_bar i ⟨e_HC p * c.1 * (e_HC p)⁻¹, h⟩ : Ω F)
            else 0 :=
        (Fintype.sum_equiv e_HC _ _ (fun _ => rfl)).symm
      rw [h_sum_eq, Fintype.sum_prod_type]
      have h_inner : ∀ h : H,
          (∑ c₀ : C,
            if hc : e_HC (h, c₀) * c.1 * (e_HC (h, c₀))⁻¹ ∈ C then
              (μ_bar i ⟨e_HC (h, c₀) * c.1 * (e_HC (h, c₀))⁻¹, hc⟩ : Ω F)
            else 0) =
          (Nat.card C : Ω F) *
            (μ_bar i ⟨h.1 * c.1 * h.1⁻¹, hC_norm.conj_mem c.1 c.2 h.1⟩ : Ω F) := by
        intro h
        have h_term : ∀ c₀ : C,
            (if hc : e_HC (h, c₀) * c.1 * (e_HC (h, c₀))⁻¹ ∈ C then
              (μ_bar i ⟨e_HC (h, c₀) * c.1 * (e_HC (h, c₀))⁻¹, hc⟩ : Ω F)
            else 0) =
            (μ_bar i ⟨h.1 * c.1 * h.1⁻¹, hC_norm.conj_mem c.1 c.2 h.1⟩ : Ω F) := by
          intro c₀
          have h_conj : e_HC (h, c₀) * c.1 * (e_HC (h, c₀))⁻¹ = h.1 * c.1 * h.1⁻¹ := by
            change (h.1 * c₀.1) * c.1 * (h.1 * c₀.1)⁻¹ = h.1 * c.1 * h.1⁻¹
            calc (h.1 * c₀.1) * c.1 * (h.1 * c₀.1)⁻¹
                = h.1 * ((c₀.1 * c.1) * c₀.1⁻¹) * h.1⁻¹ := by group
              _ = h.1 * ((c.1 * c₀.1) * c₀.1⁻¹) * h.1⁻¹ := by rw [hC_ab c₀.1 c₀.2 c.1 c.2]
              _ = h.1 * c.1 * h.1⁻¹ := by group
          have hc_mem : e_HC (h, c₀) * c.1 * (e_HC (h, c₀))⁻¹ ∈ C := by
            rw [h_conj]
            exact hC_norm.conj_mem c.1 c.2 h.1
          rw [dif_pos hc_mem]
          congr 2
          exact Subtype.ext h_conj
        simp_rw [h_term]
        rw [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, nsmul_eq_mul]
      simp_rw [h_inner, ← Finset.mul_sum]
      exact inv_mul_cancel_left₀ (by exact_mod_cast (Nat.card_pos (α := C)).ne') _
    obtain ⟨w, hw⟩ := hsurj c.1
    have h_tr_w := (htrace_eq w).symm
    rw [htr_L w, htr_E w, Finset.sum_congr rfl (fun i _ => htr_MC i w), hw,
      h_eval_top, h_eval_H, Finset.sum_congr rfl (fun i _ => h_eval_C i)] at h_tr_w
    exact h_tr_w
  exact ⟨C, H, hC_norm, inferInstance, inferInstance, inferInstance, π_MC, μ_bar,
    hC_ab, hCard_C, hCard_H, h_ker_π_MC, hμ_bar_props, h_sum_C, hAb_imp, hCent_imp⟩

theorem ld_ch13_tame_finite_group_conj_exponent_inj (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (G : Type u) [Group G] (C H : Subgroup G) [hC_norm : C.Normal]
    [Fintype H] [Fintype C]
    (ℓ f_H r : ℕ) (hPrime_ℓ : Nat.Prime ℓ) (hr_pos : 1 ≤ r)
    (hCard_C : Nat.card C = ℓ) (hCard_H : Nat.card H = f_H)
    (μ_bar : Fin r → (C →* (Ω F)ˣ))
    (hμ_bar_props : ∀ i : Fin r, (μ_bar i) ^ ℓ = 1 ∧ μ_bar i ≠ 1)
    (h_sum_C : ∀ c : C,
      1 + (∑ i : Fin r,
        ∑ h : H,
          (μ_bar i ⟨h.1 * c.1 * h.1⁻¹, hC_norm.conj_mem c.1 c.2 h.1⟩ : Ω F)) =
        if c = 1 then (ℓ : Ω F) else 0) :
    (∀ i : Fin r, ∀ c : C, c = 1 ↔ μ_bar i c = 1) ∧
    (∀ h₁ h₂ : H, h₁ * h₂ = h₂ * h₁) ∧
    (∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h = 1) ∧
    ∃ α : H → ℕ,
      Function.Injective α ∧
      (∀ h : H, α h < ℓ ∧ α h ≠ 0 ∧ (α h) ^ f_H % ℓ = 1) ∧
      (∀ i : Fin r, ∀ (h : H) (c : C),
        μ_bar i ⟨h.1 * c.1 * h.1⁻¹, hC_norm.conj_mem c.1 c.2 h.1⟩ =
          ((μ_bar i) ^ (α h)) c) :=
by
  haveI : Fact (Nat.Prime ℓ) := ⟨hPrime_ℓ⟩
  have hFintype_C : Fintype.card C = ℓ := by
    rw [← Nat.card_eq_fintype_card, hCard_C]
  have hFintype_H : Fintype.card H = f_H := by
    rw [← Nat.card_eq_fintype_card, hCard_H]
  have h_ker_μ : ∀ i : Fin r, ∀ c : C, c = 1 ↔ μ_bar i c = 1 := by
    intro i c
    refine ⟨fun hc => hc ▸ map_one (μ_bar i), fun hμc => ?_⟩
    by_contra hc_ne1
    have h_all : ∀ c' : C, μ_bar i c' = 1 := by
      intro c'
      have hmem : c' ∈ Submonoid.powers c := mem_powers_of_prime_card hCard_C hc_ne1
      obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff c' c).mp hmem
      rw [← hn, map_pow, hμc, one_pow]
    exact (hμ_bar_props i).2 (MonoidHom.ext h_all)
  let i₀ : Fin r := ⟨0, hr_pos⟩
  have hex_c_gen : ∃ c : C, μ_bar i₀ c ≠ 1 := by
    by_contra hall
    push_neg at hall
    exact (hμ_bar_props i₀).2 (MonoidHom.ext hall)
  obtain ⟨c_gen, hc_gen_μ⟩ := hex_c_gen
  have hc_gen_ne1 : c_gen ≠ 1 := fun h => hc_gen_μ ((h_ker_μ i₀ c_gen).mp h)
  have hc_gen_pow : c_gen ^ ℓ = 1 := by
    rw [← hFintype_C]
    exact pow_card_eq_one
  have hord_c_gen : orderOf c_gen = ℓ := orderOf_eq_prime hc_gen_pow hc_gen_ne1
  let f_pow : Fin ℓ → C := fun m => c_gen ^ m.1
  have h_inj_le : ∀ {a b : ℕ}, a ≤ b → b < ℓ → c_gen ^ a = c_gen ^ b → a = b := by
    intro a b hab hb heq
    have h_sub : c_gen ^ (b - a) * c_gen ^ a = 1 * c_gen ^ a := by
      rw [← pow_add, Nat.sub_add_cancel hab, ← heq, one_mul]
    have h_pow_sub : c_gen ^ (b - a) = 1 := mul_right_cancel h_sub
    have hdvd : ℓ ∣ (b - a) := by
      rw [← hord_c_gen, orderOf_dvd_iff_pow_eq_one]
      exact h_pow_sub
    have hba0 : b - a = 0 := Nat.eq_zero_of_dvd_of_lt hdvd (by omega)
    omega
  have hf_pow_inj : Function.Injective f_pow := by
    intro m₁ m₂ hm
    rcases le_total m₁.1 m₂.1 with hle | hle
    · exact Fin.ext (h_inj_le hle m₂.2 hm)
    · exact Fin.ext (h_inj_le hle m₁.2 hm.symm).symm
  have hf_pow_bij : Function.Bijective f_pow :=
    (Fintype.bijective_iff_injective_and_card f_pow).mpr
      ⟨hf_pow_inj, by rw [Fintype.card_fin, hFintype_C]⟩
  let e_pow : C ≃ Fin ℓ := (Equiv.ofBijective f_pow hf_pow_bij).symm
  have he_pow_apply : ∀ m : Fin ℓ, e_pow (c_gen ^ m.1) = m :=
    fun m => (Equiv.ofBijective f_pow hf_pow_bij).symm_apply_apply m
  have he_pow_symm : ∀ c : C, c_gen ^ (e_pow c).1 = c :=
    fun c => (Equiv.ofBijective f_pow hf_pow_bij).apply_symm_apply c
  have he_pow_val_pow : ∀ n : ℕ, (e_pow (c_gen ^ n)).1 = n % ℓ := by
    intro n
    let m : Fin ℓ := ⟨n % ℓ, Nat.mod_lt n hPrime_ℓ.pos⟩
    have h_mod : c_gen ^ n = c_gen ^ m.1 := by
      dsimp [m]
      rw [← hord_c_gen, pow_mod_orderOf]
    rw [h_mod, he_pow_apply m]
  let conj_C : H → (C →* C) := fun h =>
    { toFun := fun c => ⟨h.1 * c.1 * h.1⁻¹, hC_norm.conj_mem c.1 c.2 h.1⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := fun c₁ c₂ => Subtype.ext (by simp only [Subgroup.coe_mul]; group) }
  have hconj_one : ∀ c : C, conj_C 1 c = c :=
    fun c => Subtype.ext (by simp [conj_C])
  have hconj_mul : ∀ (h₁ h₂ : H) (c : C), conj_C (h₁ * h₂) c = conj_C h₁ (conj_C h₂ c) :=
    fun h₁ h₂ c => Subtype.ext (by dsimp [conj_C]; group)
  have hconj_ne1 : ∀ (h : H) {c : C}, c ≠ 1 → conj_C h c ≠ 1 := by
    intro h c hc h0
    have hval : h.1 * c.1 * h.1⁻¹ = 1 := congrArg Subtype.val h0
    have hc1 : c.1 = 1 := by
      calc c.1 = h.1⁻¹ * (h.1 * c.1 * h.1⁻¹) * h.1 := by group
        _ = h.1⁻¹ * 1 * h.1 := by rw [hval]
        _ = 1 := by group
    exact hc (Subtype.ext hc1)
  let α : H → ℕ := fun h => (e_pow (conj_C h c_gen)).1
  have hα_lt : ∀ h : H, α h < ℓ := fun h => (e_pow (conj_C h c_gen)).2
  have hconj_c_gen : ∀ h : H, conj_C h c_gen = c_gen ^ (α h) :=
    fun h => (he_pow_symm (conj_C h c_gen)).symm
  have hα_ne0 : ∀ h : H, α h ≠ 0 := by
    intro h h0
    have h1 : conj_C h c_gen = 1 := by
      rw [hconj_c_gen h, h0, pow_zero]
    exact hconj_ne1 h hc_gen_ne1 h1
  have hconj_eq_pow : ∀ (h : H) (c : C), conj_C h c = c ^ (α h) := by
    intro h c
    set m : ℕ := (e_pow c).1
    have hm : c_gen ^ m = c := he_pow_symm c
    calc conj_C h c = conj_C h (c_gen ^ m) := by rw [hm]
      _ = (conj_C h c_gen) ^ m := map_pow (conj_C h) c_gen m
      _ = (c_gen ^ (α h)) ^ m := by rw [hconj_c_gen h]
      _ = c_gen ^ (α h * m) := (pow_mul c_gen (α h) m).symm
      _ = c_gen ^ (m * α h) := by rw [mul_comm]
      _ = (c_gen ^ m) ^ (α h) := pow_mul c_gen m (α h)
      _ = c ^ (α h) := by rw [hm]
  have h_conj_pow : ∀ i : Fin r, ∀ (h : H) (c : C),
      μ_bar i ⟨h.1 * c.1 * h.1⁻¹, hC_norm.conj_mem c.1 c.2 h.1⟩ =
        ((μ_bar i) ^ (α h)) c := by
    intro i h c
    change μ_bar i (conj_C h c) = ((μ_bar i) ^ (α h)) c
    rw [hconj_eq_pow h c, map_pow, MonoidHom.pow_apply]
  have hα_one : α 1 = 1 := by
    dsimp [α]
    rw [hconj_one, ← pow_one c_gen, he_pow_val_pow 1, Nat.mod_eq_of_lt hPrime_ℓ.one_lt]
  have hα_mul : ∀ h₁ h₂ : H, α (h₁ * h₂) = (α h₁ * α h₂) % ℓ := by
    intro h₁ h₂
    have h_eq : conj_C (h₁ * h₂) c_gen = c_gen ^ (α h₁ * α h₂) := by
      calc conj_C (h₁ * h₂) c_gen = conj_C h₁ (conj_C h₂ c_gen) := hconj_mul h₁ h₂ c_gen
        _ = (conj_C h₂ c_gen) ^ (α h₁) := hconj_eq_pow h₁ (conj_C h₂ c_gen)
        _ = (c_gen ^ (α h₂)) ^ (α h₁) := by rw [hconj_c_gen h₂]
        _ = c_gen ^ (α h₂ * α h₁) := (pow_mul c_gen (α h₂) (α h₁)).symm
        _ = c_gen ^ (α h₁ * α h₂) := by rw [mul_comm]
    dsimp [α]
    rw [h_eq, he_pow_val_pow]
  have hα_pow : ∀ (h : H) (k : ℕ), α (h ^ k) = (α h) ^ k % ℓ := by
    intro h k
    induction k with
    | zero =>
      rw [pow_zero, pow_zero, hα_one, Nat.mod_eq_of_lt hPrime_ℓ.one_lt]
    | succ k ih =>
      rw [pow_succ, pow_succ, hα_mul, ih, Nat.mul_mod, Nat.mod_mod, ← Nat.mul_mod]
  have hα_fH : ∀ h : H, (α h) ^ f_H % ℓ = 1 := by
    intro h
    have h_pow_fH : h ^ f_H = 1 := by
      rw [← hFintype_H]
      exact pow_card_eq_one
    rw [← hα_pow h f_H, h_pow_fH, hα_one]
  have h_ortho : ∀ χ : C →* (Ω F)ˣ,
      (∑ c : C, (χ c : Ω F)) = if χ = 1 then (ℓ : Ω F) else 0 := by
    intro χ
    by_cases hχ : χ = 1
    · simp [hχ, Finset.sum_const, Finset.card_univ, hFintype_C]
    · rw [if_neg hχ]
      have hex_c₀ : ∃ c₀ : C, χ c₀ ≠ 1 := by
        by_contra hall
        push_neg at hall
        exact hχ (MonoidHom.ext hall)
      obtain ⟨c₀, hc₀⟩ := hex_c₀
      set S_sum : Ω F := ∑ c : C, (χ c : Ω F)
      have h_reidx : S_sum = (χ c₀ : Ω F) * S_sum := by
        dsimp [S_sum]
        conv_lhs =>
          rw [← Fintype.sum_equiv (Equiv.mulLeft c₀) (fun c => (χ (c₀ * c) : Ω F))
            (fun c => (χ c : Ω F)) (fun _ => rfl)]
        simp only [map_mul, Units.val_mul, ← Finset.mul_sum]
      have h_mul_zero : ((χ c₀ : Ω F) - 1) * S_sum = 0 := by
        linear_combination h_reidx.symm
      have hc₀_val : (χ c₀ : Ω F) ≠ 1 := fun h => hc₀ (Units.ext h)
      have h_sub_ne : (χ c₀ : Ω F) - 1 ≠ 0 := sub_ne_zero.mpr hc₀_val
      exact (mul_eq_zero.mp h_mul_zero).resolve_left h_sub_ne
  have hα_inj : Function.Injective α := by
    intro h₁ h₂ hα_eq
    let ψ : C →* (Ω F)ˣ := (μ_bar i₀) ^ (α h₁)
    have hψ_cgen : ψ c_gen = μ_bar i₀ (conj_C h₁ c_gen) := (h_conj_pow i₀ h₁ c_gen).symm
    have hψ_cgen_ne1 : ψ c_gen ≠ 1 := by
      rw [hψ_cgen]
      exact fun h => hconj_ne1 h₁ hc_gen_ne1 ((h_ker_μ i₀ (conj_C h₁ c_gen)).mpr h)
    have hψ_inv_ne1 : ψ⁻¹ ≠ 1 := by
      intro h
      have h1 : (ψ c_gen)⁻¹ = 1 := by
        change ψ⁻¹ c_gen = 1
        rw [h, MonoidHom.one_apply]
      exact hψ_cgen_ne1 (inv_eq_one.mp h1)
    have h_inner :
        (∑ c : C, (ψ⁻¹ c : Ω F) *
          (1 + ∑ i : Fin r, ∑ h : H,
            (μ_bar i ⟨h.1 * c.1 * h.1⁻¹, hC_norm.conj_mem c.1 c.2 h.1⟩ : Ω F))) =
        ∑ c : C, (ψ⁻¹ c : Ω F) * (if c = 1 then (ℓ : Ω F) else 0) :=
      Finset.sum_congr rfl (fun c _ => congrArg ((ψ⁻¹ c : Ω F) * ·) (h_sum_C c))
    have h_rhs :
        (∑ c : C, (ψ⁻¹ c : Ω F) * (if c = 1 then (ℓ : Ω F) else 0)) = (ℓ : Ω F) := by
      have h1 : ∀ c : C, (ψ⁻¹ c : Ω F) * (if c = 1 then (ℓ : Ω F) else 0) =
          if c = 1 then (ψ⁻¹ c : Ω F) * (ℓ : Ω F) else 0 :=
        fun c => by split_ifs <;> ring
      simp_rw [h1, Fintype.sum_ite_eq', map_one, Units.val_one, one_mul]
    have h_term_c : ∀ c : C,
        (ψ⁻¹ c : Ω F) *
          (1 + ∑ i : Fin r, ∑ h : H,
            (μ_bar i ⟨h.1 * c.1 * h.1⁻¹, hC_norm.conj_mem c.1 c.2 h.1⟩ : Ω F)) =
        (ψ⁻¹ c : Ω F) +
          ∑ i : Fin r, ∑ h : H, ((ψ⁻¹ * (μ_bar i) ^ (α h)) c : Ω F) := by
      intro c
      rw [mul_add, mul_one]
      congr 1
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro h _
      rw [h_conj_pow i h c, ← Units.val_mul, ← MonoidHom.mul_apply]
    have h_lhs_step1 :
        (∑ c : C, (ψ⁻¹ c : Ω F) *
          (1 + ∑ i : Fin r, ∑ h : H,
            (μ_bar i ⟨h.1 * c.1 * h.1⁻¹, hC_norm.conj_mem c.1 c.2 h.1⟩ : Ω F))) =
        ∑ i : Fin r, ∑ h : H, ∑ c : C, ((ψ⁻¹ * (μ_bar i) ^ (α h)) c : Ω F) := by
      simp_rw [h_term_c]
      rw [Finset.sum_add_distrib, h_ortho ψ⁻¹, if_neg hψ_inv_ne1, zero_add]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro i _
      rw [Finset.sum_comm]
    have h_inv_mul_eq : ∀ χ : C →* (Ω F)ˣ, ψ⁻¹ * χ = 1 ↔ χ = ψ := by
      intro χ
      refine ⟨fun h => MonoidHom.ext fun c => ?_, fun h => MonoidHom.ext fun c => ?_⟩
      · have hc : (ψ c)⁻¹ * χ c = 1 := congrArg (fun f : C →* (Ω F)ˣ => f c) h
        exact (inv_mul_eq_one.mp hc).symm
      · subst h
        exact inv_mul_cancel (ψ c)
    have h_inner_p : ∀ p : Fin r × H,
        (∑ c : C, ((ψ⁻¹ * (μ_bar p.1) ^ (α p.2)) c : Ω F)) =
        (if (μ_bar p.1) ^ (α p.2) = ψ then (1 : Ω F) else 0) * (ℓ : Ω F) := by
      intro p
      rw [h_ortho (ψ⁻¹ * (μ_bar p.1) ^ (α p.2)),
        if_congr (h_inv_mul_eq ((μ_bar p.1) ^ (α p.2))) rfl rfl]
      split_ifs <;> ring
    have h_lhs :
        (∑ c : C, (ψ⁻¹ c : Ω F) *
          (1 + ∑ i : Fin r, ∑ h : H,
            (μ_bar i ⟨h.1 * c.1 * h.1⁻¹, hC_norm.conj_mem c.1 c.2 h.1⟩ : Ω F))) =
        ((Finset.univ.filter (fun p : Fin r × H => (μ_bar p.1) ^ (α p.2) = ψ)).card : Ω F) *
          (ℓ : Ω F) := by
      rw [h_lhs_step1,
        ← Fintype.sum_prod_type
          (fun p : Fin r × H => ∑ c : C, ((ψ⁻¹ * (μ_bar p.1) ^ (α p.2)) c : Ω F))]
      simp_rw [h_inner_p, ← Finset.sum_mul, Finset.sum_boole]
    have h_eq_card_ℓ :
        ((Finset.univ.filter (fun p : Fin r × H => (μ_bar p.1) ^ (α p.2) = ψ)).card : Ω F) *
          (ℓ : Ω F) = ((1 : ℕ) : Ω F) * (ℓ : Ω F) := by
      rw [← h_lhs, h_inner, h_rhs, Nat.cast_one, one_mul]
    have hℓ_ne0 : (ℓ : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr hPrime_ℓ.ne_zero
    have h_card_one :
        (Finset.univ.filter (fun p : Fin r × H => (μ_bar p.1) ^ (α p.2) = ψ)).card = 1 :=
      Nat.cast_injective (mul_right_cancel₀ hℓ_ne0 h_eq_card_ℓ)
    obtain ⟨p₀, hp₀⟩ := Finset.card_eq_one.mp h_card_one
    have hmem₁ : (i₀, h₁) ∈
        Finset.univ.filter (fun p : Fin r × H => (μ_bar p.1) ^ (α p.2) = ψ) := by
      simp [ψ]
    have hmem₂ : (i₀, h₂) ∈
        Finset.univ.filter (fun p : Fin r × H => (μ_bar p.1) ^ (α p.2) = ψ) := by
      simp [ψ, ← hα_eq]
    rw [hp₀, Finset.mem_singleton] at hmem₁ hmem₂
    exact congrArg Prod.snd (hmem₁.trans hmem₂.symm)
  have hH_ab : ∀ h₁ h₂ : H, h₁ * h₂ = h₂ * h₁ := by
    intro h₁ h₂
    apply hα_inj
    rw [hα_mul, hα_mul, mul_comm (α h₁) (α h₂)]
  have hZ_H : ∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h = 1 := by
    intro h hh hcomm
    let h' : H := ⟨h, hh⟩
    have hconj_eq : conj_C h' c_gen = conj_C 1 c_gen := by
      apply Subtype.ext
      rw [hconj_one]
      change h * c_gen.1 * h⁻¹ = c_gen.1
      rw [hcomm c_gen.1 c_gen.2, mul_inv_cancel_right]
    have hα_h' : α h' = α 1 := congrArg (fun c => (e_pow c).1) hconj_eq
    have hh'_eq1 : h' = 1 := hα_inj hα_h'
    exact congrArg Subtype.val hh'_eq1
  exact ⟨h_ker_μ, hH_ab, hZ_H, α, hα_inj,
    fun h => ⟨hα_lt h, hα_ne0 h, hα_fH h⟩, h_conj_pow⟩

theorem ld_ch13_tame_zmod_roots_card_and_orbit_sum (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (H : Type u) [Fintype H]
    (ℓ f_H : ℕ) (hPrime_ℓ : Nat.Prime ℓ) (hf_H_gt1 : 1 < f_H)
    (hCard_H : Nat.card H = f_H)
    (α : H → ℕ) (hα_inj : Function.Injective α)
    (hα_props : ∀ h : H, α h < ℓ ∧ α h ≠ 0 ∧ (α h) ^ f_H % ℓ = 1) :
    let S := (Finset.range ℓ).filter (fun c : ℕ => c ≠ 0 ∧ c ^ f_H % ℓ = 1)
    S.card = f_H ∧
    ∀ g : ℕ → Ω F, ∑ h : H, g (α h) = ∑ c ∈ S, g c :=
by
  intro S
  have h_sub : Finset.image α Finset.univ ⊆ S := by
    intro c hc
    rw [Finset.mem_image] at hc
    rcases hc with ⟨h, _, rfl⟩
    rw [Finset.mem_filter, Finset.mem_range]
    obtain ⟨h1, h2, h3⟩ := hα_props h
    exact ⟨h1, h2, h3⟩
  have h_img_card : (Finset.image α Finset.univ).card = f_H := by
    rw [Finset.card_image_of_injective Finset.univ hα_inj, Finset.card_univ,
      ← Nat.card_eq_fintype_card, hCard_H]
  have h_le_card : f_H ≤ S.card := by
    rw [← h_img_card]
    exact Finset.card_le_card h_sub
  haveI : Fact (Nat.Prime ℓ) := ⟨hPrime_ℓ⟩
  let P : Polynomial (ZMod ℓ) := Polynomial.X ^ f_H - Polynomial.C 1
  have hf_H_pos : 0 < f_H := by omega
  have hP_ne : P ≠ 0 := Polynomial.X_pow_sub_C_ne_zero hf_H_pos 1
  have hP_deg : P.natDegree = f_H := Polynomial.natDegree_X_pow_sub_C
  let toZ : ℕ → ZMod ℓ := Nat.cast
  have h_maps : Set.MapsTo toZ ↑S ↑P.roots.toFinset := by
    intro c hc
    rw [Finset.mem_coe, Finset.mem_filter, Finset.mem_range] at hc
    rcases hc with ⟨hc_lt, hc_ne0, hc_pow⟩
    rw [Finset.mem_coe, Multiset.mem_toFinset, Polynomial.mem_roots hP_ne,
      Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_pow,
      Polynomial.eval_X, Polynomial.eval_C]
    have h_mod : c ^ f_H % ℓ = 1 % ℓ := by
      rw [hc_pow, Nat.mod_eq_of_lt hPrime_ℓ.one_lt]
    have h_cast : ((c ^ f_H : ℕ) : ZMod ℓ) = ((1 : ℕ) : ZMod ℓ) :=
      (ZMod.natCast_eq_natCast_iff' (c ^ f_H) 1 ℓ).mpr h_mod
    rw [Nat.cast_pow, Nat.cast_one] at h_cast
    exact sub_eq_zero.mpr h_cast
  have h_injOn : Set.InjOn toZ ↑S := by
    intro c₁ hc₁ c₂ hc₂ h_eq
    rw [Finset.mem_coe, Finset.mem_filter, Finset.mem_range] at hc₁ hc₂
    have h1 : (toZ c₁).val = c₁ := by
      rw [ZMod.val_natCast, Nat.mod_eq_of_lt hc₁.1]
    have h2 : (toZ c₂).val = c₂ := by
      rw [ZMod.val_natCast, Nat.mod_eq_of_lt hc₂.1]
    rw [← h1, ← h2, h_eq]
  have h_card_le : S.card ≤ f_H := by
    calc S.card ≤ P.roots.toFinset.card := Finset.card_le_card_of_injOn toZ h_maps h_injOn
      _ ≤ P.roots.card := Multiset.toFinset_card_le P.roots
      _ ≤ P.natDegree := Polynomial.card_roots' P
      _ = f_H := hP_deg
  have hS_card : S.card = f_H := le_antisymm h_card_le h_le_card
  have h_img_eq : Finset.image α Finset.univ = S := by
    apply Finset.eq_of_subset_of_card_le h_sub
    rw [hS_card, h_img_card]
  refine ⟨hS_card, ?_⟩
  intro g
  rw [← h_img_eq, Finset.sum_image (fun x _ y _ h => hα_inj h)]

theorem ld_ch13_tame_galois_orbit_sum_and_centralizer (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K)
    (hGal : IsGaloisExt F L K)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (hPrime_MCK : Nat.Prime (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))
    (hf_H_gt1 : 1 < Module.finrank L (IntermediateField.extendScalars hLM_C))
    (r : ℕ) (hr_pos : 1 ≤ r)
    (hr_mul : r * Module.finrank L (IntermediateField.extendScalars hLM_C) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)
    (μ_orb : Fin r → (relWeil F M_C →* (Ω F)ˣ))
    (hμ_props : ∀ i : Fin r,
      IsWeilRep F M_C (charRep F M_C (μ_orb i)) ∧
      restrictWeilChar F hM_CK (μ_orb i) = 1 ∧
      (μ_orb i) ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 1 ∧
      μ_orb i ≠ 1)
    (htrace_eq : ∀ w : relWeil F L,
      (⟨1, E, hLE, 1⟩ : MonomialTerm F L).trace F L w =
        (⟨1, L, le_rfl, 1⟩ : MonomialTerm F L).trace F L w +
          ∑ i : Fin r, (⟨1, M_C, hLM_C, μ_orb i⟩ : MonomialTerm F L).trace F L w) :
    let ℓ := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let f_H := Module.finrank L (IntermediateField.extendScalars hLM_C)
    IsAbelianExt F hLM_C ∧
    (∀ σ ∈ L.fixingSubgroup,
      (∀ τ ∈ M_C.fixingSubgroup, σ * τ * σ⁻¹ * τ⁻¹ ∈ K.fixingSubgroup) →
      σ ∈ M_C.fixingSubgroup) ∧
    ((Finset.range ℓ).filter (fun c : ℕ => c ≠ 0 ∧ c ^ f_H % ℓ = 1)).card = f_H ∧
    (∀ i : Fin r, ∀ w : relWeil F M_C,
      (w : AbsGal F) ∈ K.fixingSubgroup ↔ (μ_orb i) w = 1) ∧
    (∀ w : relWeil F M_C,
      1 + (∑ i : Fin r,
        ∑ c ∈ (Finset.range ℓ).filter (fun c : ℕ => c ≠ 0 ∧ c ^ f_H % ℓ = 1),
          (((μ_orb i) ^ c) w : Ω F)) =
        if (w : AbsGal F) ∈ K.fixingSubgroup then (ℓ : Ω F) else 0) :=
by
  obtain ⟨C, H, hC_norm, hFinG, hFinH, hFinC, π_MC, μ_bar,
      hC_ab, hCard_C, hCard_H, h_ker_π_MC, hμ_bar_props, h_sum_C, hAb_imp, hCent_imp⟩ :=
    ld_ch13_tame_galois_semidirect_proj_and_char_descent F L K M_C E
      hLK hLM_C hM_CK hLE hEK h_inf h_sup hGal hMin r μ_orb hμ_props htrace_eq
  haveI : C.Normal := hC_norm
  letI : Fintype H := hFinH
  letI : Fintype C := hFinC
  obtain ⟨h_ker_μ_bar, hH_ab, hZ_H, α, hα_inj, hα_props, h_conj_pow⟩ :=
    ld_ch13_tame_finite_group_conj_exponent_inj F
      (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK)
      C H
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK))
      (Module.finrank L (IntermediateField.extendScalars hLM_C))
      r hPrime_MCK hr_pos hCard_C hCard_H μ_bar
      (fun i => ⟨(hμ_bar_props i).2.1, (hμ_bar_props i).2.2⟩) h_sum_C
  obtain ⟨hcard_S, hsum_S⟩ :=
    ld_ch13_tame_zmod_roots_card_and_orbit_sum F H
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK))
      (Module.finrank L (IntermediateField.extendScalars hLM_C))
      hPrime_MCK hf_H_gt1 hCard_H α hα_inj hα_props
  refine ⟨hAb_imp hH_ab, hCent_imp hZ_H, hcard_S, ?_, ?_⟩
  · intro i w
    rw [h_ker_π_MC w, (hμ_bar_props i).1 w, ← h_ker_μ_bar i (π_MC w)]
  · intro w
    have h_w := h_sum_C (π_MC w)
    rw [if_congr (h_ker_π_MC w) rfl rfl, ← h_w]
    congr 1
    apply Finset.sum_congr rfl
    intro i _
    have h_term : ∀ h : H,
        (μ_bar i ⟨h.1 * (π_MC w).1 * h.1⁻¹, hC_norm.conj_mem (π_MC w).1 (π_MC w).2 h.1⟩ : Ω F) =
          (((μ_orb i) ^ (α h)) w : Ω F) := by
      intro h
      congr 1
      rw [h_conj_pow i h (π_MC w), MonoidHom.pow_apply, MonoidHom.pow_apply, (hμ_bar_props i).1 w]
    rw [Finset.sum_congr rfl (fun h _ => h_term h)]
    exact (hsum_S (fun c => (((μ_orb i) ^ c) w : Ω F))).symm

theorem ld_separable_weil_char_rec_and_norm (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F) :
    (∀ (L' : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L']
      (χ : relWeil F L' →* (Ω F)ˣ), IsWeilRep F L' (charRep F L' χ) →
      ∀ (θ : L'ˣ →* (Ω F)ˣ), (∀ x : L'ˣ, θ x = χ (rec.recMap L' x)) →
        ∀ u ∈ unitGroup F L' (condExp F L' θ), θ u = 1) ∧
    (∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
      (χL : relWeil F L →* (Ω F)ˣ), IsWeilRep F L (charRep F L χL) →
      ∃ χ' : Lˣ →* (Ω F)ˣ,
        (∀ x : Lˣ, χ' x = χL (rec.recMap L x)) ∧
        (∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1) ∧
        ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
          (hLE : L ≤ E), Algebra.IsSeparable L (IntermediateField.extendScalars hLE) →
          (∀ y : Eˣ, (χ'.comp (Units.map (normLM F hLE))) y =
            (restrictWeilChar F hLE χL) (rec.recMap E y)) ∧
          (∀ u ∈ unitGroup F E (condExp F E (χ'.comp (Units.map (normLM F hLE)))),
            (χ'.comp (Units.map (normLM F hLE))) u = 1)) :=
by
  
  have hWeil_unit_triv : ∀ (L' : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L']
      (χ : relWeil F L' →* (Ω F)ˣ), IsWeilRep F L' (charRep F L' χ) →
      ∀ (θ : L'ˣ →* (Ω F)ˣ), (∀ x : L'ˣ, θ x = χ (rec.recMap L' x)) →
        ∀ u ∈ unitGroup F L' (condExp F L' θ), θ u = 1 := by
    intro L' _ χ hχ θ hθ
    obtain ⟨M, hLM, ω, χ_ab, hGalM, hAbM, hχ_eq, hω_I, hχ_ab_rest⟩ :=
      ld_weil_char_untwist_abelian_decomp F L' χ hχ
    haveI : FiniteDimensional F M := hGalM.2.1
    obtain ⟨ω', hω'_rec, hω'_unit0, _⟩ :=
      ld_unramified_weil_char_rec_and_norm F rec L' M hLM hAbM.2.2 ω hω_I
    obtain ⟨a_M, _, ha_M⟩ :=
      ld_separable_unitGroup_sub_norm_range F L' M hLM hAbM.2.2
    obtain ⟨χ_ab', hχ_ab'_rec, hχ_ab'_unit, _⟩ :=
      ld_abelian_weil_char_rec_and_norm F rec L' M M hLM hLM hGalM hAbM hGalM hAbM
        χ_ab hχ_ab_rest a_M ha_M
    obtain ⟨_, _, _, _, _, _, _, _, hunit0, _, hunit_val0⟩ := ld_valL_and_unitGroup_props F L'
    have ha_M_mem : a_M ∈ {a : ℕ | ∀ u ∈ unitGroup F L' a, θ u = 1} := by
      intro u hu
      have hu0 : u ∈ unitGroup F L' 0 := (hunit0 u).mpr (hunit_val0 a_M u hu)
      rw [hθ u, hχ_eq, MonoidHom.mul_apply, ← hω'_rec u, ← hχ_ab'_rec u,
        hω'_unit0 u hu0, hχ_ab'_unit u hu, mul_one]
    exact Nat.sInf_mem ⟨a_M, ha_M_mem⟩
  
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (K' : IntermediateField k Ω_bar) [hSepK' : Algebra.IsSeparable k K'],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x) →
      IsGalois k K' := by
    clear hWeil_unit_triv rec
    intro k Ω_bar _ _ _ _ K' hSepK' h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK'N : K' ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K' := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K' _ _ _ hSepK' x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K'.val K'.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k N := K'.comap N.val
    have hKN_map : K_N.map N.val = K' := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK'N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K', τ x = x := by
        intro x hx
        let z : N := ⟨x, hK'N hx⟩
        have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
        have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : K_N.fixingSubgroup.Normal := hKN_norm
    haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k] ↥K' := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN
  have hSep_iff : ∀ (L₀ E₁ : IntermediateField F (AlgebraicClosure F)) (h₀ : L₀ ≤ E₁),
      Algebra.IsSeparable L₀ (IntermediateField.extendScalars h₀) ↔
        E₁ ≤ IntermediateField.restrictScalars F (separableClosure L₀ (AlgebraicClosure F)) := by
    clear hWeil_unit_triv helper_isGalois rec
    intro L₀ E₁ h₀
    let S := IntermediateField.extendScalars h₀
    have hmin : ∀ x : S, IsSeparable L₀ x.1 ↔ IsSeparable L₀ x := by
      intro x
      change (minpoly L₀ (S.val x)).Separable ↔ (minpoly L₀ x).Separable
      rw [minpoly.algHom_eq S.val S.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S := ⟨z, (IntermediateField.mem_extendScalars h₀).mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable L₀ S _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ E₁ := (IntermediateField.mem_extendScalars h₀).mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))
  have hAb_sup_right : ∀ (L₀ E₁ F₀ : IntermediateField F (AlgebraicClosure F))
      (hLE₁ : L₀ ≤ E₁) (hLF₀ : L₀ ≤ F₀),
      Algebra.IsSeparable L₀ (IntermediateField.extendScalars hLE₁) →
      IsAbelianExt F hLF₀ →
      IsAbelianExt F (le_sup_left : E₁ ≤ E₁ ⊔ F₀) := by
    clear hWeil_unit_triv helper_isGalois rec
    intro L₀ E₁ F₀ hLE₁ hLF₀ hSepE₁ hAbF₀
    refine ⟨?_, ?_, ?_⟩
    · intro σ hσ τ hτ
      rw [IntermediateField.fixingSubgroup_sup, Subgroup.mem_inf] at hτ ⊢
      refine ⟨Subgroup.mul_mem _ (Subgroup.mul_mem _ hσ hτ.1) (Subgroup.inv_mem _ hσ),
        hAbF₀.1 σ (IntermediateField.fixingSubgroup_le hLE₁ hσ) τ hτ.2⟩
    · intro σ hσ τ hτ
      rw [IntermediateField.fixingSubgroup_sup, Subgroup.mem_inf]
      refine ⟨Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ hσ hτ)
          (Subgroup.inv_mem _ hσ)) (Subgroup.inv_mem _ hτ),
        hAbF₀.2.1 σ (IntermediateField.fixingSubgroup_le hLE₁ hσ)
          τ (IntermediateField.fixingSubgroup_le hLE₁ hτ)⟩
    · rw [hSep_iff]
      intro a ha
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      have h_sup_le : E₁ ⊔ F₀ ≤
          IntermediateField.restrictScalars F (separableClosure L₀ (AlgebraicClosure F)) :=
        sup_le ((hSep_iff L₀ E₁ hLE₁).mp hSepE₁) ((hSep_iff L₀ F₀ hLF₀).mp hAbF₀.2.2)
      have haL : IsSeparable L₀ a :=
        mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (h_sup_le ha))
      exact IsSeparable.tower_top (↥(IntermediateField.extendScalars hLE₁)) haL
  
  have h_norm_trans_gen : ∀ (A B C : IntermediateField F (AlgebraicClosure F))
      (hAB : A ≤ B) (hBC : B ≤ C) (u : C),
      normLM F hAB (normLM F hBC u) = normLM F (hAB.trans hBC) u := by
    clear hAb_sup_right hSep_iff helper_isGalois hWeil_unit_triv rec
    intro A B C hAB hBC u
    have hAC : A ≤ C := hAB.trans hBC
    let S_AB := IntermediateField.extendScalars hAB
    let S_BC := IntermediateField.extendScalars hBC
    let S_AC := IntermediateField.extendScalars hAC
    let f_BC : B →+* S_AC :=
      { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hAC).mpr (hBC z.2)⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let f_SAB : S_AB →+* S_AC :=
      { toFun := fun z =>
          ⟨z.1, (IntermediateField.mem_extendScalars hAC).mpr
            (hBC ((IntermediateField.mem_extendScalars hAB).mp z.2))⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    letI algB : Algebra ↥B ↥S_AC := RingHom.toAlgebra f_BC
    letI : SMul ↥B ↥S_AC := @Algebra.toSMul ↥B ↥S_AC _ _ algB
    letI algSAB : Algebra ↥S_AB ↥S_AC := RingHom.toAlgebra f_SAB
    letI : SMul ↥S_AB ↥S_AC := @Algebra.toSMul ↥S_AB ↥S_AC _ _ algSAB
    haveI : IsScalarTower ↥A ↥S_AB ↥S_AC := IsScalarTower.of_algebraMap_eq fun _ => rfl
    let e_BC : S_BC ≃ₐ[B] S_AC :=
      { toFun := fun x =>
          ⟨x.1, (IntermediateField.mem_extendScalars hAC).mpr
            ((IntermediateField.mem_extendScalars hBC).mp x.2)⟩
        invFun := fun x =>
          ⟨x.1, (IntermediateField.mem_extendScalars hBC).mpr
            ((IntermediateField.mem_extendScalars hAC).mp x.2)⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl }
    let e_B : B ≃+* S_AB :=
      { toExtendScalars F hAB with
        invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hAB).mp z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }
    let u_BC : S_BC := toExtendScalars F hBC u
    let u_AC : S_AC := toExtendScalars F hAC u
    have h1 : Algebra.norm B u_AC = normLM F hBC u :=
      Algebra.norm_eq_of_algEquiv e_BC u_BC
