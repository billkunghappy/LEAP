    rw [htate_Nχ, htate_M1, hprod_νN, htate_Mχ, htate_N1, hprod_νM] at hPow_NM ⊢
    exact (ld_ch12_tame_finite_field_cyclic_order_ell_prod_and_gauss_assembly F k_L ℓ hPrime hNeChar ψ_k).2
