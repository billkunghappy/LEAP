      haveI : IsScalarTower F A₀ ↥K_A := IsScalarTower.of_algebraMap_eq fun _ => rfl
      haveI : FiniteDimensional L₀ ↥A_ext := Module.Finite.of_restrictScalars_finite F L₀ ↥A_ext
      haveI : FiniteDimensional L₀ ↥K_0 := Module.Finite.of_restrictScalars_finite F L₀ ↥K_0
      haveI : FiniteDimensional A₀ ↥K_A := Module.Finite.of_restrictScalars_finite F A₀ ↥K_A
