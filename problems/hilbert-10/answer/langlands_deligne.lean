      (w = 0 ∨
        (p F : ℤ) * m - ((p F - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K w) →
      (traceLM F hMK w = 0 ∨ m ≤ valL F M (traceLM F hMK w)))
    (hnorm_exp : ∀ (m : ℕ), 1 ≤ m → ∀ y : K, (y = 0 ∨ (m : ℤ) ≤ valL F K y) →
      ∃ z : K, (z = 0 ∨ (2 * m : ℤ) ≤ valL F K z) ∧
        normLM F hMK (1 + y) = 1 + traceLM F hMK (y + z) + normLM F hMK y) :
    let p := p F
