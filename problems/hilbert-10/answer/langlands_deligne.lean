        val_pow_M₁' (Or.inr (by rw [hc_val])) i
      have hdi : d i = 0 ∨ (0 : ℤ) ≤ valL F M₁' (d i) := hd_nonneg i hi_icc
      refine val_mono_M₁' ?_ (val_mul_M₁' hc_pow hdi)
      nlinarith [hi_z, hK_ge1]
    obtain ⟨hcp_ne, hcp_val⟩ := hval_pow_eq_M₁' hc_ne0 (p - 1)
    have h_lhs_ne : c ^ (p - 1) * d (p - 1) ≠ 0 := mul_ne_zero hcp_ne hd_ne
    have h_lhs_val : valL F M₁' (c ^ (p - 1) * d (p - 1)) = -((p - 2 : ℕ) : ℤ) * K - 1 := by
      rw [hvalM₁'_mul (c ^ (p - 1)) (d (p - 1)) hcp_ne hd_ne, hcp_val, hc_val]
      have hp1_z : ((p - 1 : ℕ) : ℤ) = ((p - 2 : ℕ) : ℤ) + 1 := by omega
      have hd_val_eq : valL F M₁' (d (p - 1)) = K - 1 := by omega
      rw [hp1_z, hd_val_eq]
      ring
    rw [← h_top_eq] at h_rhs_val
    have h_ge : -((p - 2 : ℕ) : ℤ) * K ≤ valL F M₁' (c ^ (p - 1) * d (p - 1)) :=
      h_rhs_val.resolve_left h_lhs_ne
    rw [h_lhs_val] at h_ge
    omega

  
  let t_term : (Fin p → E') → Fin p → K₁ :=
    fun C i => IntermediateField.inclusion hE'K₁ (C i) * ((Δ : K₁) ^ (i : ℕ))
  let v_term : (Fin p → E') → Fin p → ℤ :=
    fun C i => (p : ℤ) * valL F E' (C i) - (i : ℤ) * (t₁ : ℤ)
  have ht_term_zero : ∀ (C : Fin p → E') (i : Fin p), C i = 0 → t_term C i = 0 := by
    intro C i hCi
    dsimp [t_term]
    rw [hCi, map_zero, zero_mul]
  have ht_term_nz : ∀ (C : Fin p → E') (i : Fin p), C i ≠ 0 →
      t_term C i ≠ 0 ∧ valL F K₁ (t_term C i) = v_term C i := by
    intro C i hCi
    dsimp [t_term, v_term]
    have hincl_ne : IntermediateField.inclusion hE'K₁ (C i) ≠ 0 := by
      intro h0
      exact hCi ((IntermediateField.inclusion hE'K₁).injective (h0.trans (map_zero _).symm))
    have hΔ_ne : (Δ : K₁) ≠ 0 := Units.ne_zero Δ
    obtain ⟨hpow_ne, hpow_val⟩ := hval_pow_eq_K₁ hΔ_ne (i : ℕ)
    refine ⟨mul_ne_zero hincl_ne hpow_ne, ?_⟩
    rw [hvalK₁_mul _ _ hincl_ne hpow_ne, hval_E'K₁ (C i), hpow_val, hΔ_val]
    ring
  have hv_term_inj_le : ∀ (C : Fin p → E') (i j : Fin p),
      (i : ℕ) ≤ (j : ℕ) → v_term C i = v_term C j → i = j := by
    intro C i j hij_le hij
    dsimp [v_term] at hij
    set d_ij : ℕ := (j : ℕ) - (i : ℕ)
    set v_diff : ℤ := valL F E' (C j) - valL F E' (C i)
    have hd_cast : (d_ij : ℤ) = (j : ℤ) - (i : ℤ) := by
      dsimp [d_ij]
      omega
    have hrel : (d_ij : ℤ) * (t₁ : ℤ) = (p : ℤ) * v_diff := by
      dsimp [v_diff]
      rw [hd_cast]
      linarith
    have hv_diff_nonneg : 0 ≤ v_diff := by
      have hdt_nonneg : 0 ≤ (d_ij : ℤ) * (t₁ : ℤ) :=
        mul_nonneg (Nat.cast_nonneg d_ij) (Nat.cast_nonneg t₁)
      rw [hrel] at hdt_nonneg
      by_contra hlt
      have hneg : v_diff < 0 := not_le.mp hlt
      have hp_pos_z : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hp_pos
      have hmul_neg : (p : ℤ) * v_diff < 0 := mul_neg_of_pos_of_neg hp_pos_z hneg
      omega
    set q : ℕ := v_diff.toNat
    have hq_cast : (q : ℤ) = v_diff := Int.toNat_of_nonneg hv_diff_nonneg
    have hrel_nat_z : ((d_ij * t₁ : ℕ) : ℤ) = ((p * q : ℕ) : ℤ) := by
      push_cast
      rw [hq_cast, hrel]
    have hrel_nat : d_ij * t₁ = p * q := by exact_mod_cast hrel_nat_z
    have hdvd_mul : p ∣ d_ij * t₁ := ⟨q, hrel_nat⟩
    have hdvd_d : p ∣ d_ij := (hPrime.dvd_mul.mp hdvd_mul).resolve_right ht₁_ndvd
    have hd_lt : d_ij < p := by
      dsimp [d_ij]
      have hj_lt : (j : ℕ) < p := j.isLt
      omega
    have hd_eq0 : d_ij = 0 := Nat.eq_zero_of_dvd_of_lt hdvd_d hd_lt
    apply Fin.ext
    dsimp [d_ij] at hd_eq0
    omega
  have hv_term_inj : ∀ (C : Fin p → E') (i j : Fin p), v_term C i = v_term C j → i = j := by
    intro C i j hij
    rcases le_total (i : ℕ) (j : ℕ) with hij_le | hji_le
    · exact hv_term_inj_le C i j hij_le hij
    · exact (hv_term_inj_le C j i hji_le hij.symm).symm
  have hval_sum_ge : ∀ (C : Fin p → E') (S : Finset (Fin p)) (m : ℤ),
      (∀ i ∈ S, C i = 0 ∨ m ≤ v_term C i) →
      (∑ i ∈ S, t_term C i) = 0 ∨ m ≤ valL F K₁ (∑ i ∈ S, t_term C i) := by
    intro C S m hS
    apply val_sum_fin_K₁ S (t_term C) m
    intro i hi
    by_cases hCi : C i = 0
    · exact Or.inl (ht_term_zero C i hCi)
    · right
      rw [(ht_term_nz C i hCi).2]
      exact (hS i hi).resolve_left hCi
  have hsum_min_nz : ∀ (C : Fin p → E') (i : Fin p), C i ≠ 0 →
      ∃ i₀ : Fin p, C i₀ ≠ 0 ∧ v_term C i₀ ≤ v_term C i ∧
        (∑ j : Fin p, t_term C j) ≠ 0 ∧
        valL F K₁ (∑ j : Fin p, t_term C j) = v_term C i₀ := by
    intro C i hCi
    let S_nz : Finset (Fin p) := Finset.univ.filter (fun j : Fin p => C j ≠ 0)
    have hi_mem : i ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hCi⟩
    obtain ⟨i₀, hi₀_mem, hi₀_min⟩ := Finset.exists_min_image S_nz (v_term C) ⟨i, hi_mem⟩
    have hi₀_nz : C i₀ ≠ 0 := (Finset.mem_filter.mp hi₀_mem).2
    have hi₀_le_i : v_term C i₀ ≤ v_term C i := hi₀_min i hi_mem
    have herase_bound : ∀ j ∈ (Finset.univ : Finset (Fin p)).erase i₀,
        C j = 0 ∨ v_term C i₀ + 1 ≤ v_term C j := by
      intro j hj
      have hj_ne : j ≠ i₀ := (Finset.mem_erase.mp hj).1
      by_cases hCj : C j = 0
      · exact Or.inl hCj
      · right
        have hj_mem : j ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hCj⟩
        have hle : v_term C i₀ ≤ v_term C j := hi₀_min j hj_mem
        have hne : v_term C i₀ ≠ v_term C j := fun heq => hj_ne (hv_term_inj C i₀ j heq).symm
        omega
    have herase_sum :=
      hval_sum_ge C ((Finset.univ : Finset (Fin p)).erase i₀) (v_term C i₀ + 1) herase_bound
    obtain ⟨ht_i₀_nz, ht_i₀_val⟩ := ht_term_nz C i₀ hi₀_nz
    have herase_sum' :
        (∑ j ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term C j) = 0 ∨
          valL F K₁ (t_term C i₀) + 1 ≤
            valL F K₁ (∑ j ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term C j) := by
      rw [ht_i₀_val]
      exact herase_sum
    obtain ⟨hadd_nz, hadd_val⟩ := hval_strict_K₁ ht_i₀_nz herase_sum'
    have hsum_split : t_term C i₀ + ∑ j ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term C j =
        ∑ j : Fin p, t_term C j :=
      Finset.add_sum_erase Finset.univ (t_term C) (Finset.mem_univ i₀)
    rw [hsum_split] at hadd_nz hadd_val
    rw [ht_i₀_val] at hadd_val
    exact ⟨i₀, hi₀_nz, hi₀_le_i, hadd_nz, hadd_val⟩
  have hval_sum_iff : ∀ (C : Fin p → E') (m : ℤ),
      ((∑ i : Fin p, t_term C i) = 0 ∨ m ≤ valL F K₁ (∑ i : Fin p, t_term C i)) ↔
        ∀ i : Fin p, C i = 0 ∨ m ≤ v_term C i := by
    intro C m
    refine ⟨?_, ?_⟩
    · intro hsum i
      by_cases hCi : C i = 0
      · exact Or.inl hCi
      · right
        obtain ⟨i₀, _, hi₀_le, hsum_nz, hsum_val⟩ := hsum_min_nz C i hCi
        rcases hsum with h0 | hm_le
        · exact False.elim (hsum_nz h0)
        · rw [hsum_val] at hm_le
          exact le_trans hm_le hi₀_le
    · intro h_all
      exact hval_sum_ge C Finset.univ m (fun i _ => h_all i)
  have hpow_diff_succ : ∀ (m : ℕ) (x y : K₁) (v d_v : ℤ),
      (x = 0 ∨ v ≤ valL F K₁ x) →
      (y = 0 ∨ v ≤ valL F K₁ y) →
      (x - y = 0 ∨ d_v ≤ valL F K₁ (x - y)) →
      x ^ (m + 1) - y ^ (m + 1) = 0 ∨
        (m : ℤ) * v + d_v ≤ valL F K₁ (x ^ (m + 1) - y ^ (m + 1)) := by
    intro m x y v d_v hx hy hxy
    induction m with
    | zero =>
      simp [hxy]
    | succ m ih =>
      have hid : x ^ (m + 1 + 1) - y ^ (m + 1 + 1) =
          (x ^ (m + 1) - y ^ (m + 1)) * x + y ^ (m + 1) * (x - y) := by
        rw [pow_succ x (m + 1), pow_succ y (m + 1)]
        ring
      have ht1 : (x ^ (m + 1) - y ^ (m + 1)) * x = 0 ∨
          ((m + 1 : ℕ) : ℤ) * v + d_v ≤ valL F K₁ ((x ^ (m + 1) - y ^ (m + 1)) * x) := by
        refine val_mono_K₁ ?_ (val_mul_K₁ ih hx)
        push_cast
        linarith
      have ht2 : y ^ (m + 1) * (x - y) = 0 ∨
          ((m + 1 : ℕ) : ℤ) * v + d_v ≤ valL F K₁ (y ^ (m + 1) * (x - y)) :=
        val_mul_K₁ (val_pow_K₁ hy (m + 1)) hxy
      rw [hid]
      exact val_add_K₁ ht1 ht2

  
  have hShift_M₁' :
      ∀ (τ : M₁' ≃ₐ[F] M₁') (ψ_lift : K₁ ≃ₐ[F] K₁),
        (∀ y : E', ψ_lift (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hE'K₁ y) →
        (∀ z : M₁', ψ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ (τ z)) →
        (∀ w : K₁, valL F K₁ (ψ_lift w) = valL F K₁ w) →
        ∀ (M m : ℤ), 0 ≤ M →
          (ψ_lift (Δ : K₁) - (Δ : K₁) = 0 ∨
            (p : ℤ) * M ≤ valL F K₁ (ψ_lift (Δ : K₁) - (Δ : K₁))) →
          ∀ θ : M₁', (θ = 0 ∨ m ≤ valL F M₁' θ) →
            (τ θ - θ = 0 ∨ m + (t₁ : ℤ) + M ≤ valL F M₁' (τ θ - θ)) := by
    intro τ ψ_lift hψ_E' hψ_M₁' hψ_val M m hM_nonneg hΔ_shift_M θ hθ
    by_cases hθ0 : θ = 0
    · exact Or.inl (by rw [hθ0, map_zero, sub_self])
    · have hm : m ≤ valL F M₁' θ := hθ.resolve_left hθ0
      obtain ⟨Y, hθ_eq, _⟩ := hΔ_basis (IntermediateField.inclusion hM₁'K₁ θ)
      have hY_extr := hCoeffExtr θ Y hθ_eq
      have hY_K₁ : ∀ i : Fin p,
          IntermediateField.inclusion hE'K₁ (Y i) = 0 ∨
            (p : ℤ) * (m + (i : ℤ) * (t₁ : ℤ)) ≤
              valL F K₁ (IntermediateField.inclusion hE'K₁ (Y i)) := by
        intro i
        have hYi : Y i = 0 ∨ m + (i : ℤ) * (t₁ : ℤ) ≤ valL F E' (Y i) := by
          rcases hY_extr i with h0 | hle
          · exact Or.inl h0
          · right
            linarith [hm, hle]
        exact val_incl_E'K₁ hYi
      have h_diff_sum : IntermediateField.inclusion hM₁'K₁ (τ θ - θ) =
          ∑ i : Fin p,
            IntermediateField.inclusion hE'K₁ (Y i) *
              ((ψ_lift (Δ : K₁)) ^ (i : ℕ) - ((Δ : K₁) ^ (i : ℕ))) := by
        have hψ_θ : ψ_lift (IntermediateField.inclusion hM₁'K₁ θ) =
            ∑ i : Fin p,
              IntermediateField.inclusion hE'K₁ (Y i) * ((ψ_lift (Δ : K₁)) ^ (i : ℕ)) := by
          conv_lhs => rw [hθ_eq]
          rw [map_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [map_mul, hψ_E' (Y i), map_pow]
        rw [map_sub, ← hψ_M₁' θ, hψ_θ]
        conv_lhs => rhs; rw [hθ_eq]
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_
        ring
      have hψ_Δ_val : valL F K₁ (ψ_lift (Δ : K₁)) = -(t₁ : ℤ) := by
        rw [hψ_val (Δ : K₁), hΔ_val]
      have hK₁_bound : IntermediateField.inclusion hM₁'K₁ (τ θ - θ) = 0 ∨
          (p : ℤ) * (m + (t₁ : ℤ) + M) ≤
            valL F K₁ (IntermediateField.inclusion hM₁'K₁ (τ θ - θ)) := by
        rw [h_diff_sum]
        apply val_sum_fin_K₁ Finset.univ _ ((p : ℤ) * (m + (t₁ : ℤ) + M))
        intro i _
        by_cases hi0 : (i : ℕ) = 0
        · left
          rw [hi0, pow_zero, pow_zero, sub_self, mul_zero]
        · set r : ℕ := (i : ℕ) - 1
          have hr_eq : (i : ℕ) = r + 1 := by omega
          have hr_z : ((i : ℕ) : ℤ) = (r : ℤ) + 1 := by omega
          have hΔ_pow_i : (ψ_lift (Δ : K₁)) ^ (i : ℕ) - ((Δ : K₁) ^ (i : ℕ)) = 0 ∨
              (r : ℤ) * (-(t₁ : ℤ)) + (p : ℤ) * M ≤
                valL F K₁ ((ψ_lift (Δ : K₁)) ^ (i : ℕ) - ((Δ : K₁) ^ (i : ℕ))) := by
            rw [hr_eq]
            exact hpow_diff_succ r (ψ_lift (Δ : K₁)) (Δ : K₁) (-(t₁ : ℤ)) ((p : ℤ) * M)
              (Or.inr (by omega)) (Or.inr (by omega)) hΔ_shift_M
          refine val_mono_K₁ ?_ (val_mul_K₁ (hY_K₁ i) hΔ_pow_i)
          rw [hr_z]
          have h_rt_nonneg : (0 : ℤ) ≤ (r : ℤ) * (t₁ : ℤ) :=
            mul_nonneg (Nat.cast_nonneg r) (Nat.cast_nonneg t₁)
          have hp_ge3_z : (3 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp_ge3
          nlinarith [hp_ge3_z, h_rt_nonneg]
      by_cases hdiff0 : τ θ - θ = 0
      · exact Or.inl hdiff0
      · right
        have hincl_ne0 : IntermediateField.inclusion hM₁'K₁ (τ θ - θ) ≠ 0 := by
          intro h0
          exact hdiff0 ((IntermediateField.inclusion hM₁'K₁).injective
            (h0.trans (map_zero _).symm))
        have hge := hK₁_bound.resolve_left hincl_ne0
        rw [hval_M₁'K₁ (τ θ - θ)] at hge
        have hp_ge3_z : (3 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp_ge3
        nlinarith [hp_ge3_z, hge]

  
  have hchoose_val : ∀ (j : ℕ), 0 < j → j < p →
      ((Nat.choose p j : ℕ) : K₁) = 0 ∨ P₂ ≤ valL F K₁ ((Nat.choose p j : ℕ) : K₁) := by
    intro j hj_pos hj_lt
    obtain ⟨q, hq⟩ := Nat.Prime.dvd_choose_self hPrime (by omega) hj_lt
    rw [hq, Nat.cast_mul]
    exact val_mono_K₁ (by omega) (val_mul_K₁ hp_valK₁ (val_natCast_K₁ q))
  have hbinom_decomp : ∀ (x y : K₁),
      (x + y) ^ p - (x ^ p + y ^ p) =
        ∑ k ∈ Finset.range (p - 1),
          x ^ (k + 1) * y ^ (p - (k + 1)) * ((Nat.choose p (k + 1) : ℕ) : K₁) := by
    intro x y
    let g : ℕ → K₁ := fun j => x ^ j * y ^ (p - j) * ((Nat.choose p j : ℕ) : K₁)
    have h1 : (x + y) ^ p = ∑ j ∈ Finset.range (p + 1), g j := add_pow x y p
    have h2 : ∑ j ∈ Finset.range (p + 1), g j = (∑ j ∈ Finset.range p, g j) + g p :=
      Finset.sum_range_succ g p
    have hgp : g p = x ^ p := by
      dsimp [g]
      rw [Nat.sub_self, pow_zero, Nat.choose_self, Nat.cast_one, mul_one, mul_one]
    have hp_eq : p = (p - 1) + 1 := (Nat.sub_add_cancel hp_pos).symm
    have h3 : ∑ j ∈ Finset.range p, g j =
        (∑ k ∈ Finset.range (p - 1), g (k + 1)) + g 0 := by
      conv_lhs => rw [hp_eq]
      exact Finset.sum_range_succ' g (p - 1)
    have hg0 : g 0 = y ^ p := by
      dsimp [g]
      rw [pow_zero, Nat.choose_zero_right, Nat.cast_one, one_mul, mul_one]
    rw [h1, h2, hgp, h3, hg0]
    ring
  have hbinom_cross : ∀ (x y : K₁) (vx vy M : ℤ),
      (x = 0 ∨ vx ≤ valL F K₁ x) →
      (y = 0 ∨ vy ≤ valL F K₁ y) →
      (∀ k < p - 1, M ≤ ((k + 1 : ℕ) : ℤ) * vx + ((p - (k + 1) : ℕ) : ℤ) * vy + P₂) →
      (x + y) ^ p - (x ^ p + y ^ p) = 0 ∨ M ≤ valL F K₁ ((x + y) ^ p - (x ^ p + y ^ p)) := by
    intro x y vx vy M hx hy hM
    rw [hbinom_decomp x y]
    apply val_sum_K₁ (Finset.range (p - 1)) _ M
    intro k hk
    have hk_lt : k < p - 1 := Finset.mem_range.mp hk
    have hx_pow := val_pow_K₁ hx (k + 1)
    have hy_pow := val_pow_K₁ hy (p - (k + 1))
    have hch := hchoose_val (k + 1) (by omega) (by omega)
    exact val_mono_K₁ (hM k hk_lt) (val_mul_K₁ (val_mul_K₁ hx_pow hy_pow) hch)
  obtain ⟨τ₁, hτ₁_L, hτ₁_twist_raw⟩ := (hχ₁_twists 1 hPrime.one_lt).2.2
  have hτ₁_twist : ∀ z : M₁'ˣ, ξM₁' z * χ₁ z = χ₁ (Units.map τ₁.toRingEquiv.toMonoidHom z) := by
    intro z
    have h := hτ₁_twist_raw z
    simpa [pow_one] using h
  obtain ⟨τ₁_lift, hτ₁_lift_E', hτ₁_lift_M₁', hτ₁_lift_val, hτ₁_lift_norm⟩ :=
    hGalLift τ₁ hτ₁_L
  set m₁ : ℕ := 2 * bM₁' - 1 + p * (bE' - bM₁')
  have hP₂_le_4p3m₁ : P₂ ≤ ((4 * p * p * p * m₁ : ℕ) : ℤ) := by
    have h1 : p * (p - 1) * t₂ ≤ 4 * p * p * p * m₁ := by
      have hp1 : p - 1 ≤ 4 * p * p := by
        calc p - 1 ≤ p := Nat.sub_le p 1
          _ = 1 * p * 1 := by ring
          _ ≤ (4 * p) * p := Nat.mul_le_mul (by omega) (by omega)
          _ = 4 * p * p := by ring
      have h_diff_le : bE' - bM₁' ≤ p * (bE' - bM₁') :=
        Nat.le_mul_of_pos_left (bE' - bM₁') hp_pos
      have ht2_m1 : t₂ ≤ m₁ := by omega
      calc p * (p - 1) * t₂ = p * ((p - 1) * t₂) := by ring
        _ ≤ p * ((4 * p * p) * m₁) := Nat.mul_le_mul_left p (Nat.mul_le_mul hp1 ht2_m1)
        _ = 4 * p * p * p * m₁ := by ring
    dsimp [P₂]
    exact_mod_cast h1
  have hΔ_as_t₂ :
      (Δ : K₁) ^ p - (Δ : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)) = 0 ∨
        P₂ ≤ valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) -
          IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁))) :=
    val_mono_K₁ hP₂_le_4p3m₁ hΔ_as
  set δ : K₁ := τ₁_lift (Δ : K₁) - (Δ : K₁)
  have hτ_Δ_eq : τ₁_lift (Δ : K₁) = (Δ : K₁) + δ := by
    dsimp [δ]
    ring
  set δ_AS : K₁ :=
    (Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁))
