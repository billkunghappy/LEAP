    (hμ'_props : ∀ i : Fin D_orb.length,
      Algebra.IsSeparable (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)) ∧
      IsGaloisExt F (D_orb.get i).field M_C ∧
      (μ'_orb i) ^ (p F) = 1 ∧
      μ'_orb i ≠ 1 ∧
      (∀ u ∈ unitGroup F (D_orb.get i).field (condExp F (D_orb.get i).field (μ'_orb i)),
        (μ'_orb i) u = 1) ∧
      (∀ u ∈ unitGroup F (D_orb.get i).field
          (condExp F (D_orb.get i).field
            (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))),
        (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) u = 1) ∧
      ∃ (K_i : IntermediateField F (AlgebraicClosure F))
