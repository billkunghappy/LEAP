  have htr_zx_d₂ : traceLM F hLE' z_x = 0 ∨ (d₂ : ℤ) ≤ valL F L (traceLM F hLE' z_x) := by
    rcases htr_zx_bE'_h₀ with h0 | hge
    · left; exact h0
    · right; omega
  have htr_x_d₂ : traceLM F hLE' x = 0 ∨ (d₂ : ℤ) ≤ valL F L (traceLM F hLE' x) := by
    apply htr_LE' (d₂ : ℤ) x
    rcases hx with rfl | hx_ge
    · left; rfl
    · right
      have h_mul : ((p - 1 : ℕ) : ℤ) * (d₂ : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) :=
        mul_le_mul_of_nonneg_left hd₂_le_bE' (by positivity)
      have h_ineq : (p : ℤ) * (d₂ : ℤ) - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) ≤ (d₂ : ℤ) := by
