  refine ⟨hconj1, hconj2, hconj3, ?_⟩
  intro y hy
  dsimp only
  set u_M := normLM F hM₁'K₁ (1 + y) - 1
  have hy_1_ne_and_val0 : 1 + y ≠ 0 ∧ valL F K₁ (1 + y) = 0 := by
    rcases hy with rfl | hy_ge
    · rw [add_zero]
      exact ⟨one_ne_zero, hval1_K₁⟩
    · have hy_ne : 1 + y ≠ 0 := by
        intro h0
