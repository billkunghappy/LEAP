  have hConj3 : normLM F hM₁'K₁ C = a₁ + IntermediateField.inclusion hLM₁' A + Q₁ := by
    rw [hC_M₁', (hQuadAff M₁' K₁ hM₁'K₁ hdeg2_M₁'K₁ U₁ V₁
