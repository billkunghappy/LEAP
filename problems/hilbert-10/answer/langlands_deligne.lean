        dsimp only [w_bar]
        rw [hw₀_eq_triv, hπ_triv]
      exact hw_bar_ne hw_bar_zero
    have h_m_eq_c : ∀ m : M_lam, ∃ c : C, ψ_lam m = ψ_lam ⟨c.1, hC_le c.2⟩ := by
      intro m
      obtain ⟨h, hh, c, hc, hm_eq⟩ := hG_mul m.1
      refine ⟨⟨c, hc⟩, Units.ext ?_⟩
      rw [hψ_on_C ⟨c, hc⟩]
      change w₀.1 m.1 = lam ⟨c, hc⟩
      rw [hm_eq]
      exact hw₀_eval h hh ⟨c, hc⟩
    have h_H_triv : ∀ h ∈ H, ∀ hh : h ∈ M_lam, ψ_lam ⟨h, hh⟩ = 1 := by
      intro h hh_H hh_M
      apply Units.ext
      change w₀.1 h = 1
      have h1 : h = h * (1 : C).1 := by simp
      rw [h1, hw₀_eval h hh_H 1, hlam_one]
    have h_stab_psi : ∀ g : G, g ∈ M_lam ↔
        ∀ (c : C) (hc : g⁻¹ * c.1 * g ∈ C),
