    exact ⟨hξ_nonneg, h.1, h.2⟩
  have houter_pow_diff : ∀ m < p,
      (Δ_conj m) ^ (p - 1) - ((Δ : K₁) + ξ m) ^ (p - 1) = 0 ∨
        ((B₀ : ℕ) : ℤ) - ((p - 2 : ℕ) : ℤ) * ((t₁ : ℕ) : ℤ) ≤
