  have hΔ₁_val : Δ₁ = 0 ∨ 2 * (e : ℤ) + 1 - (b₁_ceil : ℤ) ≤ valL F L Δ₁ := by
    by_cases hΔ₁ : Δ₁ = 0
    · exact Or.inl hΔ₁
    · right
      by_contra hlt
      obtain ⟨x₁, hx₁_ne, hx₁_val, hx₁_ψ⟩ := hSpecL.2
      have hα'_ne : (α' : L) ≠ 0 := Units.ne_zero α'
      have h14f_inv_ne : (1 + 4 * f)⁻¹ ≠ 0 := inv_ne_zero h14f_props.1
      have h14f_inv_val : valL F L ((1 + 4 * f)⁻¹) = 0 := by
        rw [hvalL_inv_eq (1 + 4 * f) h14f_props.1, h14f_props.2, neg_zero]
      have hΔ₁_inv_ne : Δ₁⁻¹ ≠ 0 := inv_ne_zero hΔ₁
      have hΔ₁_inv_val : valL F L (Δ₁⁻¹) = - valL F L Δ₁ := hvalL_inv_eq Δ₁ hΔ₁
