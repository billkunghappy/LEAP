              (((p.digits n).map Nat.factorial).prod : k_M) := by
            rw [h_vp_eq, pow_add, h_dig_eq, List.map_cons, List.prod_cons, Nat.cast_mul]
            ring
  dsimp only
  set q := p ^ f
  set h := (q - 1) / ℓ
  set S := (q ^ ℓ - 1) / (q - 1)
  set a_star := (a * S) / ℓ
  set γ := fun j : ℕ => (a + j) / ℓ + j * h
  set δ := fun r : ℕ => γ (((ℓ - 1 - r) * a) % ℓ)
