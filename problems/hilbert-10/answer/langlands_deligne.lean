      Delta_F * U₁ * U₂ = 0 ∨ B_7 ≤ valL F E' (Delta_F * U₁ * U₂) := by
    rw [hDelta_F_num]
    have hterm1 :
        IntermediateField.inclusion hLE' q₀ * (Q_E' - IntermediateField.inclusion hLE' P_star) = 0 ∨
          B_7 ≤ valL F E'
            (IntermediateField.inclusion hLE' q₀ *
