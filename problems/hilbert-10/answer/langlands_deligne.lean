  have hcν₂_eq : c_ν₂ = c_ν₂_0 := mul_inv_cancel_right c_ν₂_0 (Units.mk0 β₂ hβ₂)
  have hα_val : valL F L (α : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ := by
    change valL F L ((c_ν₂_0 : L) * β₂) = _
    rw [hval_mul (c_ν₂_0 : L) β₂ (Units.ne_zero _) hβ₂, hcν₂_0_val, hβ₂_val, add_zero]
  have hcν₂_val : valL F L (c_ν₂ : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ := by
