        have h2 : ((θ u_x : Ω F) * (θ u_y : Ω F))⁻¹ = ((θ u_xy : Ω F) * (θ w_xy : Ω F))⁻¹ :=
          congrArg Inv.inv h1.symm
        rw [mul_inv, mul_inv] at h2
        calc (θ u_xy : Ω F)⁻¹
            = (θ u_xy : Ω F)⁻¹ * ((θ w_xy : Ω F)⁻¹ * (θ w_xy : Ω F)) := by
              rw [inv_mul_cancel₀ (Units.ne_zero (θ w_xy)), mul_one]
          _ = ((θ u_xy : Ω F)⁻¹ * (θ w_xy : Ω F)⁻¹) * (θ w_xy : Ω F) := by
              ring
          _ = (θ u_x : Ω F)⁻¹ * (θ u_y : Ω F)⁻¹ * (θ w_xy : Ω F) := by
              rw [← h2]
      have hθ_wxy : (θ w_xy : Ω F) = ψ_0 (b₁ * b₂) := by
        have hstat := hc_stat' w_xy hw_xy_mem
        have hw_sub : (w_xy : M) - 1 = ((ϖ_M ^ (2 * d) : Mˣ) : M) * (x * y) := by
          change (1 + ((ϖ_M ^ (2 * d) : Mˣ) : M) * (x * y)) - 1 = _
          exact add_sub_cancel_left 1 _
        rw [hw_sub, ← mul_assoc] at hstat
        rw [hstat, ← hψ_0_int_cM (x * y) hxy_mul_int, hxy_mul_res]
      have hQ_add := hQ_M_int (x + y) hxy_add_int (hx_d_ne (x + y) hxy_add_int)
      rw [hxy_add_res] at hQ_add
      have hψ_add_xy : ψ_M (((c_M⁻¹ : Mˣ) : M) * ((ϖ_M ^ d : Mˣ) : M) * (x + y)) =
          ψ_M (((c_M⁻¹ : Mˣ) : M) * ((ϖ_M ^ d : Mˣ) : M) * x) *
            ψ_M (((c_M⁻¹ : Mˣ) : M) * ((ϖ_M ^ d : Mˣ) : M) * y) := by
        rw [mul_add, ψ_M.map_add_eq_mul]
      rw [hQ_add]
      change (θ u_xy : Ω F)⁻¹ * ψ_M (((c_M⁻¹ : Mˣ) : M) * ((ϖ_M ^ d : Mˣ) : M) * (x + y)) =
        ((θ u_x : Ω F)⁻¹ * ψ_M (((c_M⁻¹ : Mˣ) : M) * ((ϖ_M ^ d : Mˣ) : M) * x)) *
        ((θ u_y : Ω F)⁻¹ * ψ_M (((c_M⁻¹ : Mˣ) : M) * ((ϖ_M ^ d : Mˣ) : M) * y)) *
        ψ_0 (b₁ * b₂)
      rw [hθ_inv_eq, hθ_wxy, hψ_add_xy]
      ring
    have hψ_0_int_c' : ∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
        ψ_0 (resM x) =
          ψ_M (((c'_θ⁻¹ : Mˣ) : M) * (((ϖ_M ^ (2 * d) : Mˣ) : M) * x)) := by
      intro x hx_int
      set w_x : M := ((ϖ_M ^ (2 * d) : Mˣ) : M) * x
      have hw_x_val : w_x = 0 ∨ ((2 * d : ℕ) : ℤ) ≤ valL F M w_x := by
        have h := hval_ϖm_mul (2 * d) 0 x hx_int
        rwa [add_zero] at h
      have hΔw_val : Δ_c * w_x = 0 ∨ -n_M ≤ valL F M (Δ_c * w_x) := by
        have h := hval_mul_bound (1 - (m : ℤ) - n_M) ((2 * d : ℕ) : ℤ) Δ_c w_x hΔ_val hw_x_val
        rcases h with h0 | hge
        · left; exact h0
        · right; omega
      have hψ_Δw : ψ_M (Δ_c * w_x) = 1 := hψ_triv (Δ_c * w_x) hΔw_val
      have hsplit : ((c_M⁻¹ : Mˣ) : M) * ((ϖ_M ^ (2 * d) : Mˣ) : M) * x =
          Δ_c * w_x + ((c'_θ⁻¹ : Mˣ) : M) * w_x := by
        dsimp only [Δ_c, w_x]
        ring
      rw [hψ_0_int_cM x hx_int, hsplit, ψ_M.map_add_eq_mul, hψ_Δw, one_mul]
    set u_2d_inv : Mˣ := (ϖ_M ^ (2 * d))⁻¹
    set z₁ : M := (c_M : M) * ((u_2d_inv : M) * x₁)
    have hz₁_val : 0 ≤ valL F M z₁ := by
      have h1 : (u_2d_inv : M) * x₁ ≠ 0 := mul_ne_zero (Units.ne_zero u_2d_inv) hx₁_ne
      dsimp only [z₁, u_2d_inv]
      rw [hval_mul (c_M : M) (((ϖ_M ^ (2 * d))⁻¹ : Mˣ) * x₁) (Units.ne_zero c_M) h1,
        hval_mul (((ϖ_M ^ (2 * d))⁻¹ : Mˣ) : M) x₁ (Units.ne_zero (ϖ_M ^ (2 * d))⁻¹) hx₁_ne,
        hc_M_val, hval_inv (ϖ_M ^ (2 * d)), hϖ_pow (2 * d)]
      omega
    set a₁ : k_M := resM z₁
    have hψ_a₁_ne1 : ψ_0 a₁ ≠ 1 := by
      have hinv_c : ((c_M⁻¹ : Mˣ) : M) * (c_M : M) = 1 := by exact_mod_cast Units.inv_mul c_M
      have hinv_2d : ((ϖ_M ^ (2 * d) : Mˣ) : M) * (u_2d_inv : M) = 1 := by
        exact_mod_cast Units.mul_inv (ϖ_M ^ (2 * d))
      have hmul_z₁ : ((c_M⁻¹ : Mˣ) : M) * ((ϖ_M ^ (2 * d) : Mˣ) : M) * z₁ = x₁ := by
        dsimp only [z₁]
        calc ((c_M⁻¹ : Mˣ) : M) * ((ϖ_M ^ (2 * d) : Mˣ) : M) * ((c_M : M) * ((u_2d_inv : M) * x₁))
            = (((c_M⁻¹ : Mˣ) : M) * (c_M : M)) *
                (((ϖ_M ^ (2 * d) : Mˣ) : M) * (u_2d_inv : M)) * x₁ := by ring
          _ = x₁ := by rw [hinv_c, hinv_2d, one_mul, one_mul]
      have hψ_a₁ : ψ_0 a₁ = ψ_M x₁ := by
        dsimp only [a₁]
        rw [hψ_0_int_cM z₁ (Or.inr hz₁_val), hmul_z₁]
      rw [hψ_a₁]
      exact hx₁_ψ
    let ψ_0M : AddChar k_M (Ω F) :=
      { toFun := ψ_0
        map_zero_eq_one' := hψ_0_zero
        map_add_eq_mul' := hψ_0_add }
    have hψ_0M_ne1 : ψ_0M ≠ 1 := by
      intro h1
      have ha₁ : ψ_0M a₁ = (1 : AddChar k_M (Ω F)) a₁ := congrArg (fun f => f a₁) h1
      rw [AddChar.one_apply] at ha₁
      exact hψ_a₁_ne1 ha₁
    exact ⟨Q_M, ψ_0M, hQ_M_int, hψ_0_int_c', hψ_0M_ne1, hQ_M_zero, hQ_M_bichar⟩

theorem ld_ch14_finite_field_hasse_2p_and_p_pow_eval (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_M : Type u) [Field k_M] [Fintype k_M]
    (hp : Nat.Prime (p F))
    (hp_char : ((p F : ℕ) : k_M) = 0)
    (ψ_0M : AddChar k_M (Ω F)) (hψ_0M : ψ_0M ≠ 1)
    (Q_M : k_M → Ω F) (hQ0 : Q_M 0 = 1)
    (hQbichar : ∀ x y : k_M, Q_M (x + y) = Q_M x * Q_M y * ψ_0M (x * y))
    (hHassePow :
      ((2 : k_M) = 0 →
        ∀ (Q : k_M → Ω F),
          Q 0 = 1 →
          (∀ x y : k_M, Q (x + y) = Q x * Q y * ψ_0M (x * y)) →
          ((∀ x : k_M, Q x ≠ 0) →
            (∑ x : k_M, Q x) * (∑ y : k_M, (Q y)⁻¹) = (Fintype.card k_M : Ω F)) ∧
          (∀ x₀ : k_M, (∀ y : k_M, (Q y) ^ 2 = ψ_0M (x₀ * y)) →
            (∑ x : k_M, Q x) ^ 2 = (Fintype.card k_M : Ω F) * Q x₀)) ∧
      (∀ (p : ℕ), Nat.Prime p → p ≠ 2 → (p : k_M) = 0 →
        ∀ (c : k_M), c ≠ 0 →
        ∀ (Q : k_M → Ω F),
          Q 0 = 1 →
          (∀ x y : k_M, Q (x + y) = Q x * Q y * ψ_0M (c * x * y)) →
          (∀ x : k_M, (Q x) ^ p = 1) →
          (∑ x : k_M, Q x) ^ p =
            (Fintype.card k_M : Ω F) ^ ((p - 1) / 2) *
              (∑ x : k_M, ψ_0M ((-1 : k_M) ^ ((p - 1) / 2) * (2 : k_M)⁻¹ * c * x ^ 2))))
    (hQuadGauss :
      (2 : k_M) ≠ 0 →
      ∀ (ν_tilde ψ_1 : k_M → Ω F),
        ν_tilde 0 = 0 →
        ν_tilde 1 = 1 →
        (∀ a b : k_M, ν_tilde (a * b) = ν_tilde a * ν_tilde b) →
        (∀ a : k_M, a ≠ 0 → (ν_tilde a) ^ 2 = 1) →
        (∃ a₀ : k_M, a₀ ≠ 0 ∧ ν_tilde a₀ ≠ 1) →
        ψ_1 0 = 1 →
        (∀ x y : k_M, ψ_1 (x + y) = ψ_1 x * ψ_1 y) →
        (∃ x₀ : k_M, ψ_1 x₀ ≠ 1) →
        (∑ a : k_M, ν_tilde a * ψ_1 a) = (∑ x : k_M, ψ_1 (x ^ 2)) ∧
        (∑ x : k_M, ψ_1 (x ^ 2)) * (∑ a : k_M, ν_tilde a * ψ_1 a) =
          ν_tilde (-1) * (Fintype.card k_M : Ω F) ∧
        (∀ (φ_L : k_M → Ω F),
          φ_L 0 = 1 →
          (∀ x y : k_M, φ_L (x + y) = φ_L x * φ_L y * ψ_1 (x * y)) →
          (∑ x : k_M, φ_L x) ^ 2 =
            (∑ u : k_M, (φ_L u) ^ 2) * (∑ a : k_M, ν_tilde a * ψ_1 a))) :
    (∀ k : ℕ, 2 ≤ k →
      (∑ x : k_M, Q_M x) ^ ((2 * p F) ^ k) =
        (Fintype.card k_M : Ω F) ^ (2 ^ (k - 1) * (p F) ^ k)) ∧
    (p F ≠ 2 →
      ∀ k : ℕ, 1 ≤ k →
        (∑ x : k_M, Q_M x) ^ ((p F) ^ k) =
          ((Fintype.card k_M : Ω F) ^ ((p F - 1) / 2) *
            (∑ x : k_M,
              ψ_0M ((-1 : k_M) ^ ((p F - 1) / 2) * (2 : k_M)⁻¹ * (x ^ 2)))) ^
            ((p F) ^ (k - 1))) :=
by
  classical
  have hz₀_ex : ∃ z₀ : k_M, ψ_0M z₀ ≠ 1 := by
    by_contra h
    push_neg at h
    apply hψ_0M
    ext z
    exact h z
  obtain ⟨z₀, hz₀⟩ := hz₀_ex
  have hψ0 : ψ_0M 0 = 1 := AddChar.map_zero_eq_one ψ_0M
  have hψadd : ∀ x y : k_M, ψ_0M (x + y) = ψ_0M x * ψ_0M y := AddChar.map_add_eq_mul ψ_0M
  have hψ_neg : ∀ u : k_M, ψ_0M (-u) * ψ_0M u = 1 := by
    intro u
    rw [← hψadd, neg_add_cancel, hψ0]
  have hnat_mul : ∀ (f : k_M → Ω F),
      f 0 = 1 → (∀ x y : k_M, f (x + y) = f x * f y) →
      ∀ (n : ℕ) (x : k_M), f ((n : k_M) * x) = (f x) ^ n := by
    intro f hf0 hfadd n x
    induction n with
    | zero => rw [Nat.cast_zero, zero_mul, pow_zero, hf0]
    | succ n ih => rw [Nat.cast_succ, add_mul, one_mul, hfadd, ih, pow_succ]
  have horth : ∀ u : k_M,
      (∑ y : k_M, ψ_0M (u * y)) = if u = 0 then (Fintype.card k_M : Ω F) else 0 := by
    intro u
    by_cases hu : u = 0
    · simp [hu, hψ0]
    · rw [if_neg hu]
      have hshift :
          (∑ y : k_M, ψ_0M (u * y)) * ψ_0M z₀ = ∑ y : k_M, ψ_0M (u * y) := by
        rw [Finset.sum_mul]
        calc
          (∑ y : k_M, ψ_0M (u * y) * ψ_0M z₀) =
              ∑ y : k_M, ψ_0M (u * (y + u⁻¹ * z₀)) := by
            refine Finset.sum_congr rfl fun y _ => ?_
            have h1 : u * (y + u⁻¹ * z₀) = u * y + z₀ := by
              rw [mul_add, ← mul_assoc, mul_inv_cancel₀ hu, one_mul]
            rw [h1, hψadd]
          _ = ∑ y : k_M, ψ_0M (u * y) :=
            Fintype.sum_equiv (Equiv.addRight (u⁻¹ * z₀)) _ _ fun _ => rfl
      have hsub : (∑ y : k_M, ψ_0M (u * y)) * (ψ_0M z₀ - 1) = 0 := by
        calc
          (∑ y : k_M, ψ_0M (u * y)) * (ψ_0M z₀ - 1) =
              (∑ y : k_M, ψ_0M (u * y)) * ψ_0M z₀ - ∑ y : k_M, ψ_0M (u * y) := by ring
          _ = 0 := by rw [hshift, sub_self]
      rcases mul_eq_zero.mp hsub with h0 | h0
      · exact h0
      · exact False.elim (hz₀ (sub_eq_zero.mp h0))
  have hring : ringChar k_M = p F := by
    have hdvd : ringChar k_M ∣ p F := (ringChar.spec k_M (p F)).mp hp_char
    rcases (Nat.dvd_prime hp).mp hdvd with h1 | hp_eq
    · exfalso
      have h10 : ((1 : ℕ) : k_M) = 0 := (ringChar.spec k_M 1).mpr (by rw [h1])
      rw [Nat.cast_one] at h10
      exact one_ne_zero h10
    · exact hp_eq
  have hOddHasse : p F ≠ 2 →
      (∑ x : k_M, Q_M x) ^ (p F) =
        (Fintype.card k_M : Ω F) ^ ((p F - 1) / 2) *
          (∑ x : k_M, ψ_0M ((-1 : k_M) ^ ((p F - 1) / 2) * (2 : k_M)⁻¹ * (x ^ 2))) := by
    intro hp_ne2
    have h2_ne : (2 : k_M) ≠ 0 := Ring.two_ne_zero (hring ▸ hp_ne2)
    set a₀ : k_M := (2 : k_M)⁻¹
    have h2a₀ : (2 : k_M) * a₀ = 1 := mul_inv_cancel₀ h2_ne
    let g : k_M → Ω F := fun x => Q_M x * ψ_0M (-(a₀ * x ^ 2))
    have hg0 : g 0 = 1 := by
      dsimp [g]
      rw [hQ0, sq, mul_zero, mul_zero, neg_zero, hψ0, mul_one]
    have hgadd : ∀ x y : k_M, g (x + y) = g x * g y := by
      intro x y
      dsimp [g]
      have hquad : x * y + -(a₀ * (x + y) ^ 2) = -(a₀ * x ^ 2) + -(a₀ * y ^ 2) := by
        have hxy : x * y = ((2 : k_M) * a₀) * x * y := by rw [h2a₀, one_mul]
        calc
          x * y + -(a₀ * (x + y) ^ 2) = ((2 : k_M) * a₀) * x * y + -(a₀ * (x + y) ^ 2) := by
            rw [← hxy]
          _ = -(a₀ * x ^ 2) + -(a₀ * y ^ 2) := by ring
      calc
        Q_M (x + y) * ψ_0M (-(a₀ * (x + y) ^ 2)) =
            (Q_M x * Q_M y * ψ_0M (x * y)) * ψ_0M (-(a₀ * (x + y) ^ 2)) := by
          rw [hQbichar x y]
        _ = Q_M x * Q_M y * (ψ_0M (x * y) * ψ_0M (-(a₀ * (x + y) ^ 2))) := by ring
        _ = Q_M x * Q_M y * ψ_0M (x * y + -(a₀ * (x + y) ^ 2)) := by rw [← hψadd]
        _ = Q_M x * Q_M y * ψ_0M (-(a₀ * x ^ 2) + -(a₀ * y ^ 2)) := by rw [hquad]
        _ = Q_M x * Q_M y * (ψ_0M (-(a₀ * x ^ 2)) * ψ_0M (-(a₀ * y ^ 2))) := by rw [hψadd]
        _ = (Q_M x * ψ_0M (-(a₀ * x ^ 2))) * (Q_M y * ψ_0M (-(a₀ * y ^ 2))) := by ring
    have hQpow : ∀ x : k_M, (Q_M x) ^ (p F) = 1 := by
      intro x
      have hgpow : (g x) ^ (p F) = 1 := by
        rw [← hnat_mul g hg0 hgadd (p F) x, hp_char, zero_mul, hg0]
      have hψpow : (ψ_0M (a₀ * x ^ 2)) ^ (p F) = 1 := by
        rw [← hnat_mul ψ_0M hψ0 hψadd (p F) (a₀ * x ^ 2), hp_char, zero_mul, hψ0]
      have hQ_eq : Q_M x = g x * ψ_0M (a₀ * x ^ 2) := by
        dsimp [g]
        calc
          Q_M x = Q_M x * 1 := (mul_one _).symm
          _ = Q_M x * (ψ_0M (-(a₀ * x ^ 2)) * ψ_0M (a₀ * x ^ 2)) := by
            rw [hψ_neg (a₀ * x ^ 2)]
          _ = Q_M x * ψ_0M (-(a₀ * x ^ 2)) * ψ_0M (a₀ * x ^ 2) := by ring
      rw [hQ_eq, mul_pow, hgpow, hψpow, mul_one]
    have h1 :=
      hHassePow.2 (p F) hp hp_ne2 hp_char 1 one_ne_zero Q_M hQ0
        (fun x y => by rw [one_mul]; exact hQbichar x y) hQpow
    simpa only [mul_one] using h1
  have h4p :
      (∑ x : k_M, Q_M x) ^ (4 * p F) =
        (Fintype.card k_M : Ω F) ^ (2 * p F) := by
    by_cases hp2 : p F = 2
    · have h2_zero : (2 : k_M) = 0 := by simpa [hp2] using hp_char
      have hchar2 : ∀ a : k_M, a + a = 0 := by
        intro a
        rw [← two_mul, h2_zero, zero_mul]
      have hψ_sq : ∀ a : k_M, (ψ_0M a) ^ 2 = 1 := by
        intro a
        rw [sq, ← hψadd, hchar2, hψ0]
      let f : k_M → Ω F := fun y => (Q_M y) ^ 2
      have hf0 : f 0 = 1 := by
        dsimp [f]
        rw [hQ0, one_pow]
      have hfadd : ∀ x y : k_M, f (x + y) = f x * f y := by
        intro x y
        dsimp [f]
        calc
          (Q_M (x + y)) ^ 2 = (Q_M x * Q_M y * ψ_0M (x * y)) ^ 2 := by rw [hQbichar]
          _ = (Q_M x) ^ 2 * (Q_M y) ^ 2 * (ψ_0M (x * y)) ^ 2 := by ring
          _ = (Q_M x) ^ 2 * (Q_M y) ^ 2 * 1 := by rw [hψ_sq]
          _ = (Q_M x) ^ 2 * (Q_M y) ^ 2 := mul_one _
      have hf_sq : ∀ y : k_M, (f y) ^ 2 = 1 := by
        intro y
        rw [sq, ← hfadd, hchar2, hf0]
      have hQ_pow4 : ∀ y : k_M, (Q_M y) ^ 4 = 1 := by
        intro y
        calc
          (Q_M y) ^ 4 = (f y) ^ 2 := by dsimp [f]; ring
          _ = 1 := hf_sq y
      let T : k_M → Ω F := fun b => ∑ y : k_M, f y * ψ_0M (b * y)
      have hsumT : (∑ b : k_M, T b) = (Fintype.card k_M : Ω F) := by
        dsimp [T]
        rw [Finset.sum_comm]
        calc
          (∑ y : k_M, ∑ b : k_M, f y * ψ_0M (b * y)) =
              ∑ y : k_M, f y * (∑ b : k_M, ψ_0M (y * b)) := by
            refine Finset.sum_congr rfl fun y _ => ?_
            rw [← Finset.mul_sum]
            refine congrArg (f y * ·) (Finset.sum_congr rfl fun b _ => ?_)
            rw [mul_comm b y]
          _ = ∑ y : k_M, f y * (if y = 0 then (Fintype.card k_M : Ω F) else 0) := by
            refine Finset.sum_congr rfl fun y _ => ?_
            rw [horth y]
          _ = f 0 * (if (0 : k_M) = 0 then (Fintype.card k_M : Ω F) else 0) := by
            refine Finset.sum_eq_single 0 ?_ ?_
            · intro y _ hy
              rw [if_neg hy, mul_zero]
            · intro h0
              exact False.elim (h0 (Finset.mem_univ 0))
          _ = (Fintype.card k_M : Ω F) := by
            rw [if_pos rfl, hf0, one_mul]
      have hcard_ne : (Fintype.card k_M : Ω F) ≠ 0 :=
        Nat.cast_ne_zero.mpr Fintype.card_pos.ne'
      have hsumT_ne : (∑ b : k_M, T b) ≠ 0 := by
        rw [hsumT]
        exact hcard_ne
      obtain ⟨x₀, _, hTx₀⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsumT_ne
      have hQ_sq : ∀ z : k_M, (Q_M z) ^ 2 = ψ_0M (x₀ * z) := by
        intro z
        have hT_shift : T x₀ = T x₀ * (f z * ψ_0M (x₀ * z)) := by
          calc
            T x₀ = ∑ y : k_M, f (y + z) * ψ_0M (x₀ * (y + z)) := by
              symm
              exact Fintype.sum_equiv (Equiv.addRight z) _ _ fun _ => rfl
            _ = ∑ y : k_M, (f y * ψ_0M (x₀ * y)) * (f z * ψ_0M (x₀ * z)) := by
              refine Finset.sum_congr rfl fun y _ => ?_
              rw [hfadd y z, mul_add, hψadd]
              ring
            _ = T x₀ * (f z * ψ_0M (x₀ * z)) := by
              rw [← Finset.sum_mul]
        have hsub : T x₀ * (f z * ψ_0M (x₀ * z) - 1) = 0 := by
          calc
            T x₀ * (f z * ψ_0M (x₀ * z) - 1) =
                T x₀ * (f z * ψ_0M (x₀ * z)) - T x₀ := by ring
            _ = 0 := by rw [← hT_shift, sub_self]
        have hprod1 : f z * ψ_0M (x₀ * z) = 1 := by
          rcases mul_eq_zero.mp hsub with h0 | h0
          · exact False.elim (hTx₀ h0)
          · exact sub_eq_zero.mp h0
        calc
          (Q_M z) ^ 2 = f z * 1 := (mul_one (f z)).symm
          _ = f z * (ψ_0M (x₀ * z)) ^ 2 := by rw [hψ_sq (x₀ * z)]
          _ = (f z * ψ_0M (x₀ * z)) * ψ_0M (x₀ * z) := by ring
          _ = 1 * ψ_0M (x₀ * z) := by rw [hprod1]
          _ = ψ_0M (x₀ * z) := one_mul _
      have hHasse2 := (hHassePow.1 h2_zero Q_M hQ0 hQbichar).2 x₀ hQ_sq
      calc
        (∑ x : k_M, Q_M x) ^ (4 * p F) = ((∑ x : k_M, Q_M x) ^ 2) ^ 4 := by
          rw [hp2]
          ring
        _ = ((Fintype.card k_M : Ω F) * Q_M x₀) ^ 4 := by rw [hHasse2]
        _ = (Fintype.card k_M : Ω F) ^ 4 * (Q_M x₀) ^ 4 := by rw [mul_pow]
        _ = (Fintype.card k_M : Ω F) ^ 4 * 1 := by rw [hQ_pow4 x₀]
        _ = (Fintype.card k_M : Ω F) ^ (2 * p F) := by rw [hp2, mul_one]
    · have h2_ne : (2 : k_M) ≠ 0 := Ring.two_ne_zero (hring ▸ hp2)
      have hHasse_p := hOddHasse hp2
      set M := (p F - 1) / 2
      set c₀ : k_M := (-1 : k_M) ^ M * (2 : k_M)⁻¹
      have hc₀ : c₀ ≠ 0 :=
        mul_ne_zero (pow_ne_zero M (neg_ne_zero.mpr one_ne_zero)) (inv_ne_zero h2_ne)
      let ν_tilde : k_M → Ω F := fun a => ((quadraticChar k_M a : ℤ) : Ω F)
      let ψ_1 : k_M → Ω F := fun z => ψ_0M (c₀ * z)
      have hν0 : ν_tilde 0 = 0 := by
        dsimp only [ν_tilde]
        rw [quadraticChar_zero, Int.cast_zero]
      have hν1 : ν_tilde 1 = 1 := by
        dsimp only [ν_tilde]
        rw [MulChar.map_one, Int.cast_one]
      have hνmul : ∀ a b : k_M, ν_tilde (a * b) = ν_tilde a * ν_tilde b := by
        intro a b
        dsimp only [ν_tilde]
        rw [map_mul, Int.cast_mul]
      have hνsq : ∀ a : k_M, a ≠ 0 → (ν_tilde a) ^ 2 = 1 := by
        intro a ha
        dsimp only [ν_tilde]
        rw [← Int.cast_pow, ← map_pow, quadraticChar_sq_one' ha, Int.cast_one]
      have hν_ex : ∃ a₀ : k_M, a₀ ≠ 0 ∧ ν_tilde a₀ ≠ 1 := by
        obtain ⟨a₁, ha₁_nsq⟩ := FiniteField.exists_nonsquare (hring ▸ hp2)
        have ha₁_ne : a₁ ≠ 0 := by
          rintro rfl
          exact ha₁_nsq ⟨0, by ring⟩
        have hq_a₁ : quadraticChar k_M a₁ = -1 :=
          quadraticChar_neg_one_iff_not_isSquare.mpr ha₁_nsq
        refine ⟨a₁, ha₁_ne, ?_⟩
        dsimp only [ν_tilde]
        rw [hq_a₁, Int.cast_neg, Int.cast_one]
        norm_num
      have hψ1_0 : ψ_1 0 = 1 := by
        dsimp only [ψ_1]
        rw [mul_zero, hψ0]
      have hψ1_add : ∀ x y : k_M, ψ_1 (x + y) = ψ_1 x * ψ_1 y := by
        intro x y
        dsimp only [ψ_1]
        rw [mul_add, hψadd]
      have hψ1_ex : ∃ x₀ : k_M, ψ_1 x₀ ≠ 1 := by
        refine ⟨c₀⁻¹ * z₀, ?_⟩
        dsimp only [ψ_1]
        rw [mul_inv_cancel_left₀ hc₀ z₀]
        exact hz₀
      obtain ⟨hG1, hG2, _⟩ :=
        hQuadGauss h2_ne ν_tilde ψ_1 hν0 hν1 hνmul hνsq hν_ex hψ1_0 hψ1_add hψ1_ex
      have hG_sq :
          (∑ x : k_M, ψ_1 (x ^ 2)) ^ 2 = ν_tilde (-1) * (Fintype.card k_M : Ω F) := by
        calc
          (∑ x : k_M, ψ_1 (x ^ 2)) ^ 2 =
              (∑ x : k_M, ψ_1 (x ^ 2)) * (∑ x : k_M, ψ_1 (x ^ 2)) := sq _
          _ = (∑ x : k_M, ψ_1 (x ^ 2)) * (∑ a : k_M, ν_tilde a * ψ_1 a) := by rw [hG1]
          _ = ν_tilde (-1) * (Fintype.card k_M : Ω F) := hG2
      have hν_neg1_sq : (ν_tilde (-1)) ^ 2 = 1 :=
        hνsq (-1) (neg_ne_zero.mpr one_ne_zero)
      have hG_pow4 :
          (∑ x : k_M, ψ_1 (x ^ 2)) ^ 4 = (Fintype.card k_M : Ω F) ^ 2 := by
        calc
          (∑ x : k_M, ψ_1 (x ^ 2)) ^ 4 = ((∑ x : k_M, ψ_1 (x ^ 2)) ^ 2) ^ 2 := by ring
          _ = (ν_tilde (-1) * (Fintype.card k_M : Ω F)) ^ 2 := by rw [hG_sq]
          _ = (ν_tilde (-1)) ^ 2 * (Fintype.card k_M : Ω F) ^ 2 := by rw [mul_pow]
          _ = 1 * (Fintype.card k_M : Ω F) ^ 2 := by rw [hν_neg1_sq]
          _ = (Fintype.card k_M : Ω F) ^ 2 := one_mul _
      have hp_odd : p F % 2 = 1 := hp.eq_two_or_odd.resolve_left hp2
      have hM_eq : 4 * M + 2 = 2 * p F := by omega
      calc
        (∑ x : k_M, Q_M x) ^ (4 * p F) = ((∑ x : k_M, Q_M x) ^ (p F)) ^ 4 := by
          rw [mul_comm 4 (p F), pow_mul]
        _ = ((Fintype.card k_M : Ω F) ^ M * (∑ x : k_M, ψ_1 (x ^ 2))) ^ 4 := by
          rw [hHasse_p]
        _ = (Fintype.card k_M : Ω F) ^ (4 * M) * (∑ x : k_M, ψ_1 (x ^ 2)) ^ 4 := by
          rw [mul_pow, ← pow_mul, mul_comm M 4]
        _ = (Fintype.card k_M : Ω F) ^ (4 * M) * (Fintype.card k_M : Ω F) ^ 2 := by
          rw [hG_pow4]
        _ = (Fintype.card k_M : Ω F) ^ (4 * M + 2) := by rw [← pow_add]
        _ = (Fintype.card k_M : Ω F) ^ (2 * p F) := by rw [hM_eq]
  refine ⟨?_, ?_⟩
  · intro k hk
    have hk2 : k = (k - 2) + 2 := by omega
    have hk1 : k = (k - 1) + 1 := by omega
    have hk12 : k - 1 = (k - 2) + 1 := by omega
    have hexp1 : (2 * p F) ^ k = (4 * p F) * (2 ^ (k - 2) * (p F) ^ (k - 1)) := by
      rw [mul_pow]
      conv_lhs =>
        congr
        · rw [hk2, pow_add]
        · rw [hk1, pow_add, pow_one]
      ring
    have hexp2 : 2 ^ (k - 1) * (p F) ^ k = (2 * p F) * (2 ^ (k - 2) * (p F) ^ (k - 1)) := by
      conv_lhs =>
        congr
        · rw [hk12, pow_add, pow_one]
        · rw [hk1, pow_add, pow_one]
      ring
    rw [hexp1, pow_mul, h4p, ← pow_mul, ← hexp2]
  · intro hp_ne2 k hk
    have hk1 : k = 1 + (k - 1) := by omega
    have hexp : (p F) ^ k = (p F) * (p F) ^ (k - 1) := by
      conv_lhs => rw [hk1, pow_add, pow_one]
    rw [hexp, pow_mul, hOddHasse hp_ne2]

theorem ld_ch14_single_field_stationary_phase_pow (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (ψ_M : AddChar M (Ω F)) (hψM : IsAdmissibleChar F M ψ_M)
    (θ : Mˣ →* (Ω F)ˣ) (hm : 2 ≤ condExp F M θ)
    (c'_θ : Mˣ)
    (hc_val : valL F M (c'_θ : M) = (condExp F M θ : ℤ) + condExpChar F M ψ_M)
    (hc_top : ∀ x : M, (x = 0 ∨ ((condExp F M θ - 1 : ℕ) : ℤ) ≤ valL F M x) →
      ∀ hx : 1 + x ≠ 0,
        (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_M (((c'_θ⁻¹ : Mˣ) : M) * x)) :
    (∃ k₀ : ℕ, 1 ≤ k₀ ∧ ∀ k : ℕ, k₀ ≤ k →
      (tateEps F M θ ψ_M) ^ ((2 * p F) ^ k) =
        ((qL F M : Ω F) ^ (2 * condExpChar F M ψ_M + (condExp F M θ : ℤ))) ^
          (2 ^ (k - 1) * (p F) ^ k) *
          (θ c'_θ : Ω F) ^ ((2 * p F) ^ k)) ∧
    (condExp F M θ % 2 = 0 →
      ∃ k₀ : ℕ, 1 ≤ k₀ ∧ ∀ k : ℕ, k₀ ≤ k →
        (tateEps F M θ ψ_M) ^ ((p F) ^ k) =
          ((qL F M : Ω F) ^ (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ))) ^
            ((p F) ^ k) *
            (θ c'_θ : Ω F) ^ ((p F) ^ k)) ∧
    (p F ≠ 2 → condExp F M θ % 2 = 1 →
      ∀ (k_M : Type u) [Field k_M] [Fintype k_M] (resM : M → k_M),
        resM 0 = 0 → resM 1 = 1 →
        (∀ x₁ x₂ : M, (x₁ = 0 ∨ 0 ≤ valL F M x₁) → (x₂ = 0 ∨ 0 ≤ valL F M x₂) →
          resM (x₁ + x₂) = resM x₁ + resM x₂ ∧
          resM (x₁ * x₂) = resM x₁ * resM x₂ ∧
          resM (-x₁) = -resM x₁) →
        (∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
          (resM x = 0 ↔ (x = 0 ∨ 1 ≤ valL F M x))) →
        (∀ a : k_M, ∃ x : M, (x = 0 ∨ 0 ≤ valL F M x) ∧ resM x = a) →
        ∀ (ϖ_M : Mˣ), valL F M (ϖ_M : M) = 1 →
        ∀ (ψ_0M : AddChar k_M (Ω F)),
          (∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
            ψ_0M (resM x) =
              ψ_M (((c'_θ⁻¹ : Mˣ) : M) *
                (((ϖ_M ^ (2 * (condExp F M θ / 2)) : Mˣ) : M) * x))) →
          ∃ k₀ : ℕ, 1 ≤ k₀ ∧ ∀ k : ℕ, k₀ ≤ k →
            (tateEps F M θ ψ_M) ^ ((p F) ^ k) =
              ((qL F M : Ω F) ^ (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ))) ^
                ((p F) ^ k) *
                (θ c'_θ : Ω F) ^ ((p F) ^ k) *
                ((qL F M : Ω F) ^ ((p F - 1) / 2) *
                  (∑ x : k_M,
                    ψ_0M ((-1 : k_M) ^ ((p F - 1) / 2) * (2 : k_M)⁻¹ * (x ^ 2)))) ^
                  ((p F) ^ (k - 1))) :=
by
  have hp : Nat.Prime (p F) := (ld_frob_pow_on_primeToP_roots F).1
  have hvalM := ld_valL_and_unitGroup_props F M
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add,
    hunit0, hunit_ge1, hunit_val0⟩ := ld_valL_and_unitGroup_props F M
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F M
  obtain ⟨S₁, hS₁⟩ :=
    ld_valL_mod_one_finset F M hval0 hval_neg hval_mul hval_add
      haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨k_M₀, hField_kM₀, hFintype_kM₀, resM₀, hres0_0, hres0_1, hres0_ring, hres0_ker, hres0_surj⟩ :=
    ld_valL_residue_field_exists F M hval0 hval1 hval_neg1 hval_neg hval_mul hval_inv hval_add S₁ hS₁
  letI : Field k_M₀ := hField_kM₀
  letI : Fintype k_M₀ := hFintype_kM₀
  obtain ⟨hcard_0, hp_char_0, hp_valM⟩ :=
    ld_valL_residue_field_card_eq_qL F M
      ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add⟩
      ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1⟩
      k_M₀ resM₀ hres0_0 hres0_1 hres0_ring hres0_ker hres0_surj
  have hSpecM := ld_condExp_and_condExpChar_spec F M ψ_M hψM θ
  have hFinM := ld_unitCoset_finite F M (condExp F M θ) (by omega)
  have hne_θ := ld_tateEps_ne_zero F M ψ_M hψM θ
  have hstat := ld_cond_ge_two_stationary_phase_sum_reduction F M ψ_M θ hm hSpecM hFinM hvalM
  obtain ⟨c_M, hc_M_val, hc_M_stat⟩ := hstat.1 hne_θ
  have heps_M := hstat.2 c_M hc_M_val hc_M_stat
  obtain ⟨hpow_congr, hodd_phase⟩ :=
    ld_ch14_top_stat_congruence_and_odd_quadratic_phase F M ψ_M θ hm hp hp_valM
      hSpecM hvalM c_M c'_θ hc_M_val hc_M_stat hc_val hc_top
  obtain ⟨ϖ_M₀, hϖ_M₀⟩ := hval_surj 1
  have hq_pos : 0 < qL F M := pow_pos (q_pos F) (resDeg F M)
  have hq_ne : (qL F M : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr hq_pos.ne'
  have hSpecM_χ : ∀ u ∈ unitGroup F M (condExp F M θ), θ u = 1 := (hSpecM.2.2.1 (by omega)).1
  have heven_pow : condExp F M θ % 2 = 0 →
      ∀ k : ℕ, condExp F M θ ≤ k →
        (tateEps F M θ ψ_M) ^ ((p F) ^ k) =
          ((qL F M : Ω F) ^ (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ))) ^
            ((p F) ^ k) *
            (θ c'_θ : Ω F) ^ ((p F) ^ k) := by
    intro heven k hk
    have hfilt0 :=
      (ld_cond_ge_two_filtration_card_and_eval F M ψ_M θ hm hSpecM.1 hSpecM_χ hFinM hvalM
        k_M₀ resM₀ hres0_0 hres0_1 hres0_ring hres0_ker hres0_surj ϖ_M₀ c_M hϖ_M₀ hc_M_val hc_M_stat).1
        (by omega)
    rw [hcard_0] at hfilt0
    have heps_even :
        tateEps F M θ ψ_M =
          (qL F M : Ω F) ^ (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ)) *
            (θ c_M : Ω F) * ψ_M (((c_M⁻¹ : Mˣ) : M)) := by
      rw [heps_M, hfilt0, zpow_add₀ hq_ne, zpow_natCast]
      ring
    obtain ⟨hθ_pow, hψ_pow⟩ := hpow_congr k hk
    rw [heps_even, mul_pow, mul_pow, hθ_pow, hψ_pow, mul_one]
  refine ⟨?_, ?_, ?_⟩
  · refine ⟨condExp F M θ, by omega, fun k hk => ?_⟩
    rcases Nat.mod_two_eq_zero_or_one (condExp F M θ) with heven | hodd
    · have hp_pow := heven_pow heven k hk
      have hexp_2p : (2 * p F) ^ k = (p F) ^ k * 2 ^ k := by rw [mul_comm 2 (p F), mul_pow]
      have hq_exp :
          ((qL F M : Ω F) ^ (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ))) ^
            ((p F) ^ k * 2 ^ k) =
            ((qL F M : Ω F) ^ (2 * condExpChar F M ψ_M + (condExp F M θ : ℤ))) ^
              (2 ^ (k - 1) * (p F) ^ k) := by
        rw [← zpow_natCast, ← zpow_natCast, ← zpow_mul, ← zpow_mul]
        congr 1
        have hk1 : (p F) ^ k * 2 ^ k = 2 * (2 ^ (k - 1) * (p F) ^ k) := by
          rw [mul_comm ((p F) ^ k) (2 ^ k), ← mul_assoc]
          congr 1
          conv_lhs => rw [← Nat.sub_add_cancel (by omega : 1 ≤ k), pow_succ']
        have hm_even :
            (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ)) * 2 =
              2 * condExpChar F M ψ_M + (condExp F M θ : ℤ) := by omega
        rw [hk1, Nat.cast_mul, Nat.cast_ofNat, ← hm_even]
        ring
      rw [hexp_2p, pow_mul, hp_pow, mul_pow, ← pow_mul, ← pow_mul, hq_exp]
    · obtain ⟨Q_M₀, ψ_0M₀, hQ_M₀_int, _, hψ_0M₀_ne, hQ0₀, hQbichar₀⟩ :=
        hodd_phase (by omega) k_M₀ resM₀ hres0_0 hres0_1 hres0_ring hres0_ker hres0_surj ϖ_M₀ hϖ_M₀
      have hfilt0 :=
        (ld_cond_ge_two_filtration_card_and_eval F M ψ_M θ hm hSpecM.1 hSpecM_χ hFinM hvalM
          k_M₀ resM₀ hres0_0 hres0_1 hres0_ring hres0_ker hres0_surj ϖ_M₀ c_M hϖ_M₀ hc_M_val hc_M_stat).2
          (by omega) Q_M₀ hQ_M₀_int
      rw [hcard_0] at hfilt0
      have heps_odd0 :
          tateEps F M θ ψ_M =
            (qL F M : Ω F) ^ (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ)) *
              (θ c_M : Ω F) * ψ_M (((c_M⁻¹ : Mˣ) : M)) * (∑ b : k_M₀, Q_M₀ b) := by
        rw [heps_M, hfilt0, zpow_add₀ hq_ne, zpow_natCast]
        ring
      have hhasse2p :=
        (ld_ch14_finite_field_hasse_2p_and_p_pow_eval F k_M₀ hp hp_char_0 ψ_0M₀ hψ_0M₀_ne
          Q_M₀ hQ0₀ hQbichar₀
          (ld_wild_finite_field_hasse_power_identities F k_M₀ ψ_0M₀ hψ_0M₀_ne)
          (fun hNe2 ν_tilde ψ_1 h1 h2 h3 h4 h5 h6 h7 h8 =>
            ld_finite_field_deg_two_quadratic_gauss_and_hasse F k_M₀ hNe2 ν_tilde ψ_1
              h1 h2 h3 h4 h5 h6 h7 h8)).1
          k (by omega)
      rw [hcard_0] at hhasse2p
      obtain ⟨hθ_pow, hψ_pow⟩ := hpow_congr k hk
      have hθ_2p : (θ c_M : Ω F) ^ ((2 * p F) ^ k) = (θ c'_θ : Ω F) ^ ((2 * p F) ^ k) := by
        rw [mul_comm 2 (p F), mul_pow, pow_mul, pow_mul, hθ_pow]
      have hψ_2p : (ψ_M (((c_M⁻¹ : Mˣ) : M))) ^ ((2 * p F) ^ k) = 1 := by
        rw [mul_comm 2 (p F), mul_pow, pow_mul, hψ_pow, one_pow]
      have hq_exp_odd :
          ((qL F M : Ω F) ^ (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ))) ^
            ((2 * p F) ^ k) *
            (qL F M : Ω F) ^ (2 ^ (k - 1) * (p F) ^ k) =
            ((qL F M : Ω F) ^ (2 * condExpChar F M ψ_M + (condExp F M θ : ℤ))) ^
              (2 ^ (k - 1) * (p F) ^ k) := by
        rw [← zpow_natCast, ← zpow_natCast, ← zpow_natCast, ← zpow_mul, ← zpow_mul, ← zpow_add₀ hq_ne]
        congr 1
        have hk1 : (2 * p F) ^ k = 2 * (2 ^ (k - 1) * (p F) ^ k) := by
          rw [mul_pow, ← mul_assoc]
          congr 1
          conv_lhs => rw [← Nat.sub_add_cancel (by omega : 1 ≤ k), pow_succ']
        have hm_odd :
            (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ)) * 2 + 1 =
              2 * condExpChar F M ψ_M + (condExp F M θ : ℤ) := by omega
        rw [hk1, Nat.cast_mul, Nat.cast_ofNat, ← hm_odd]
        ring
      rw [heps_odd0, mul_pow, mul_pow, mul_pow, hθ_2p, hψ_2p, mul_one, hhasse2p]
      calc
        ((qL F M : Ω F) ^ (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ))) ^
            ((2 * p F) ^ k) *
          (θ c'_θ : Ω F) ^ ((2 * p F) ^ k) *
          (qL F M : Ω F) ^ (2 ^ (k - 1) * (p F) ^ k) =
          (((qL F M : Ω F) ^ (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ))) ^
              ((2 * p F) ^ k) *
            (qL F M : Ω F) ^ (2 ^ (k - 1) * (p F) ^ k)) *
            (θ c'_θ : Ω F) ^ ((2 * p F) ^ k) := by ring
        _ = ((qL F M : Ω F) ^ (2 * condExpChar F M ψ_M + (condExp F M θ : ℤ))) ^
              (2 ^ (k - 1) * (p F) ^ k) *
              (θ c'_θ : Ω F) ^ ((2 * p F) ^ k) := by rw [hq_exp_odd]
  · intro heven
    exact ⟨condExp F M θ, by omega, heven_pow heven⟩
  · intro hp_ne2 hodd k_M _ _ resM hres_0 hres_1 hres_ring hres_ker hres_surj ϖ_M hϖ_M ψ_0M hψ_0M_int
    obtain ⟨hcard, hp_char, _⟩ :=
      ld_valL_residue_field_card_eq_qL F M
        ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add⟩
        ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1⟩
        k_M resM hres_0 hres_1 hres_ring hres_ker hres_surj
    obtain ⟨Q_M, ψ_0M', hQ_M_int, hψ_0M'_int, hψ_0M'_ne, hQ0, hQbichar⟩ :=
      hodd_phase (by omega) k_M resM hres_0 hres_1 hres_ring hres_ker hres_surj ϖ_M hϖ_M
    have hψ_eq : ψ_0M' = ψ_0M := by
      apply AddChar.ext
      intro a
      obtain ⟨x, hx_int, rfl⟩ := hres_surj a
      rw [hψ_0M'_int x hx_int, hψ_0M_int x hx_int]
    subst hψ_eq
    have hfilt :=
      (ld_cond_ge_two_filtration_card_and_eval F M ψ_M θ hm hSpecM.1 hSpecM_χ hFinM hvalM
        k_M resM hres_0 hres_1 hres_ring hres_ker hres_surj ϖ_M c_M hϖ_M hc_M_val hc_M_stat).2
        (by omega) Q_M hQ_M_int
    rw [hcard] at hfilt
    have heps_odd :
        tateEps F M θ ψ_M =
          (qL F M : Ω F) ^ (condExpChar F M ψ_M + ((condExp F M θ / 2 : ℕ) : ℤ)) *
            (θ c_M : Ω F) * ψ_M (((c_M⁻¹ : Mˣ) : M)) * (∑ b : k_M, Q_M b) := by
      rw [heps_M, hfilt, zpow_add₀ hq_ne, zpow_natCast]
      ring
    have hhasse :=
      (ld_ch14_finite_field_hasse_2p_and_p_pow_eval F k_M hp hp_char ψ_0M' hψ_0M'_ne
        Q_M hQ0 hQbichar
        (ld_wild_finite_field_hasse_power_identities F k_M ψ_0M' hψ_0M'_ne)
        (fun hNe2 ν_tilde ψ_1 h1 h2 h3 h4 h5 h6 h7 h8 =>
          ld_finite_field_deg_two_quadratic_gauss_and_hasse F k_M hNe2 ν_tilde ψ_1
            h1 h2 h3 h4 h5 h6 h7 h8)).2
        hp_ne2
    refine ⟨condExp F M θ, by omega, fun k hk => ?_⟩
    obtain ⟨hθ_pow, hψ_pow⟩ := hpow_congr k hk
    have hhasse_k := hhasse k (by omega)
    rw [hcard] at hhasse_k
    rw [heps_odd, mul_pow, mul_pow, mul_pow, hθ_pow, hψ_pow, mul_one, hhasse_k]

theorem ld_ch14_wild_semidirect_orbit_enum_and_norm_prod (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hLM_C_lt : L < M_C)
    (hCore : ¬ ∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
      K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
      Module.finrank L (IntermediateField.extendScalars hLK₁) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (hGal : IsGaloisExt F L K) (hGalMCK : IsGaloisExt F M_C K)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (D_orb : List (MonomialTerm F L))
    (hD₁_sub : IsSubMonomialDecomp F L M_C E hLE (⟨1, L, le_rfl, 1⟩ :: D_orb))
    (hD_orb_props : ∀ t ∈ D_orb,
      t.coeff = 1 ∧
      L < t.field ∧
      t.field ≤ M_C ∧
      t.χ ^ (p F) = 1 ∧
      (∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) ∧
      (∃ htE : t.field ≤ E ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
      (∀ htM : t.field ≤ M_C, restrictWeilChar F htM t.χ ≠ 1))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hSepLFi : ∀ i : Fin D_orb.length,
      Algebra.IsSeparable L (IntermediateField.extendScalars (D_orb.get i).le))
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (hSepFiMC : ∀ i : Fin D_orb.length,
      Algebra.IsSeparable (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)))
    (hDegSum : (∑ i : Fin D_orb.length,
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let r_orb := D_orb.length
    let μ'_orb : ∀ i : Fin r_orb, ((D_orb.get i).field)ˣ →* (Ω F)ˣ :=
      fun i => recChar F rec (D_orb.get i).field (D_orb.get i).χ
    ∃ (ν_all : Fin (q - 1) → (M_Cˣ →* (Ω F)ˣ))
      (σ_all : Fin (q - 1) → (M_C ≃ₐ[F] M_C))
      (idx_all : Fin (q - 1) → Fin r_orb),
      Function.Injective ν_all ∧
      (∀ j : Fin (q - 1),
        ν_all j ≠ 1 ∧
        (ν_all j) ^ (p F) = 1 ∧
        (∀ x : L, (σ_all j) (IntermediateField.inclusion hLM_C x) =
          IntermediateField.inclusion hLM_C x) ∧
        (∀ z : M_C, valL F M_C ((σ_all j) z) = valL F M_C z) ∧
        (∀ z : M_C, traceLM F hLM_C ((σ_all j) z) = traceLM F hLM_C z) ∧
        (∀ w : M_Cˣ, w ∈ Set.range (Units.map (normLM F hM_CK)) → (ν_all j) w = 1) ∧
        ∀ w : M_Cˣ,
          (ν_all j) w =
            ((μ'_orb (idx_all j)).comp (Units.map (normLM F (hFiMC (idx_all j)))))
              (Units.map (σ_all j).toRingEquiv.toMonoidHom w)) ∧
      (∀ (c_orb : ∀ i : Fin r_orb, ((D_orb.get i).field)ˣ),
        ∏ j : Fin (q - 1),
          Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
            (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
              (c_orb (idx_all j))) =
          Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
            (∏ i : Fin r_orb, Units.map (normLM F (D_orb.get i).le) (c_orb i))) :=
by
  let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  let r_orb := D_orb.length
  let μ'_orb : ∀ i : Fin r_orb, ((D_orb.get i).field)ˣ →* (Ω F)ˣ :=
    fun i => recChar F rec (D_orb.get i).field (D_orb.get i).χ
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (K' : IntermediateField k Ω_bar) [hSepK' : Algebra.IsSeparable k K'],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K', τ x = x) → ∀ x ∈ K', (σ * τ * σ⁻¹) x = x) →
      IsGalois k K' := by
    clear * -
    intro k Ω_bar _ _ _ _ K' hSepK' h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK'N : K' ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K' := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K' _ _ _ hSepK' x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K'.val K'.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k N := K'.comap N.val
    have hKN_map : K_N.map N.val = K' := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK'N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K', τ x = x := by
        intro x hx
        let z : N := ⟨x, hK'N hx⟩
        have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
        have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : K_N.fixingSubgroup.Normal := hKN_norm
    haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k] ↥K' := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN
  obtain ⟨_, hSepRec_all⟩ := ld_separable_weil_char_rec_and_norm F rec
  have hμ'_MC : ∀ i : Fin r_orb,
      (∀ w : M_Cˣ,
        ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) w =
          (restrictWeilChar F (hFiMC i) (D_orb.get i).χ) (rec.recMap M_C w)) ∧
      (μ'_orb i) ^ (p F) = 1 ∧
      (∀ w : M_Cˣ,
        w ∈ Set.range (Units.map (normLM F hM_CK)) →
        ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) w = 1) ∧
      ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) ≠ 1 := by
    intro i
    let t := D_orb.get i
    have ht : t ∈ D_orb := List.get_mem D_orb i
    have ht_wf : t.Wf F L := hD₁_sub.1.1 t (List.mem_cons_of_mem _ ht)
    have ht_weil : IsWeilRep F t.field (charRep F t.field t.χ) := ht_wf.2.2
    haveI : FiniteDimensional F t.field := hFinFi i
    obtain ⟨μ₀_t, hμ₀_t_rec, _, hμ₀_t_sep⟩ := hSepRec_all t.field t.χ ht_weil
    have hμ_t_rec : ∀ z : t.fieldˣ, (μ'_orb i) z = t.χ (rec.recMap t.field z) :=
      Classical.epsilon_spec (p := fun χ' : t.fieldˣ →* (Ω F)ˣ =>
        ∀ x : t.fieldˣ, χ' x = t.χ (rec.recMap t.field x)) ⟨μ₀_t, hμ₀_t_rec⟩
    have hμ_t_eq : μ'_orb i = μ₀_t :=
      MonoidHom.ext fun z => (hμ_t_rec z).trans (hμ₀_t_rec z).symm
    have hμ_t_MC_rec : ∀ w : M_Cˣ,
        ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) w =
          (restrictWeilChar F (hFiMC i) t.χ) (rec.recMap M_C w) := by
      rw [hμ_t_eq]
      exact (hμ₀_t_sep M_C (hFiMC i) (hSepFiMC i)).1
    obtain ⟨_, _, _, hpow, ⟨htK, hrestK⟩, _, hnot1⟩ := hD_orb_props t ht
    have hχ_ker_K : ∀ w : relWeil F t.field, (w : AbsGal F) ∈ K.fixingSubgroup → t.χ w = 1 := by
      intro w hwK
      let w_K : relWeil F K := ⟨w.1, ⟨w.2.1, hwK⟩⟩
      have h1 : restrictWeilChar F htK t.χ w_K = 1 := by
        rw [hrestK, MonoidHom.one_apply]
      exact h1
    have hμ_t_pow : (μ'_orb i) ^ (p F) = 1 := by
      apply MonoidHom.ext
      intro z
      rw [MonoidHom.pow_apply, hμ_t_rec z, ← MonoidHom.pow_apply, hpow,
        MonoidHom.one_apply, MonoidHom.one_apply]
    have hμ_t_MC_triv : ∀ w : M_Cˣ,
        w ∈ Set.range (Units.map (normLM F hM_CK)) →
        ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) w = 1 := by
      rintro w ⟨y, rfl⟩
      rw [hμ_t_MC_rec]
      have hwK : (rec.recMap M_C (Units.map (normLM F hM_CK) y) : AbsGal F) ∈ K.fixingSubgroup :=
        (rec.ker_rec M_C K hM_CK hMin.2.1 (Units.map (normLM F hM_CK) y)).mpr ⟨(y : K), rfl⟩
      exact hχ_ker_K (Subgroup.inclusion (relWeil_antitone F (hFiMC i)) (rec.recMap M_C _)) hwK
    have hμ_t_MC_ne1 : (μ'_orb i).comp (Units.map (normLM F (hFiMC i))) ≠ 1 := by
      intro h_comp1
      apply hnot1 (hFiMC i)
      apply MonoidHom.ext
      intro w_M
      obtain ⟨w, hw⟩ := rec.surj_rec M_C K hM_CK hMin.2.1 w_M
      let u : relWeil F M_C := (rec.recMap M_C w)⁻¹ * w_M
      have hu_triv : (restrictWeilChar F (hFiMC i) t.χ) u = 1 :=
        hχ_ker_K (Subgroup.inclusion (relWeil_antitone F (hFiMC i)) u) hw
      rw [map_mul, map_inv, inv_mul_eq_one] at hu_triv
      rw [← hu_triv, ← hμ_t_MC_rec w, h_comp1, MonoidHom.one_apply, MonoidHom.one_apply]
    exact ⟨hμ_t_MC_rec, hμ_t_pow, hμ_t_MC_triv, hμ_t_MC_ne1⟩
  obtain ⟨M_sub, idx_all, u_all, γ_all, hBij, hM_sub_props, hγ_all_props, hCosetInj⟩ :=
    ld_ch14_wild_mackey_trace_and_coset_orthogonality F L K M_C E
      hLK hLM_C hM_CK hLE hEK h_inf h_sup hLM_C_lt hCore hGal hMin hFinE_eq
      D_orb hD₁_sub hD_orb_props hFiMC hDegSum
  obtain ⟨σ_all, hσ_all_coe, hσ_all_symm_coe, hσ_all_incl, hσ_all_val, hσ_all_trace⟩ :
      ∃ σ_all : Fin (q - 1) → (M_C ≃ₐ[F] M_C),
        (∀ (j : Fin (q - 1)) (z : M_C),
          ((σ_all j) z : AlgebraicClosure F) = (γ_all j : AbsGal F) (z : AlgebraicClosure F)) ∧
        (∀ (j : Fin (q - 1)) (z : M_C),
          ((σ_all j).symm z : AlgebraicClosure F) =
            (γ_all j : AbsGal F)⁻¹ (z : AlgebraicClosure F)) ∧
        (∀ (j : Fin (q - 1)) (x : L),
          (σ_all j) (IntermediateField.inclusion hLM_C x) =
            IntermediateField.inclusion hLM_C x) ∧
        (∀ (j : Fin (q - 1)) (z : M_C), valL F M_C ((σ_all j) z) = valL F M_C z) ∧
        (∀ (j : Fin (q - 1)) (z : M_C),
          traceLM F hLM_C ((σ_all j) z) = traceLM F hLM_C z) := by
    let M_C' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLM_C
    haveI : FiniteDimensional F M_C' := inferInstanceAs (FiniteDimensional F M_C)
    haveI : IsScalarTower F L M_C' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional L M_C' := Module.Finite.of_restrictScalars_finite F L M_C'
    haveI : Algebra.IsSeparable L M_C' := hMin.1.2.2.2 hLM_C
    haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
    have hM_C'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F),
        (∀ x ∈ M_C', τ x = x) → ∀ x ∈ M_C', (σ * τ * σ⁻¹) x = x := by
      intro σ τ hτ
      let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
      let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
      have hτM_C : τ_F.1 ∈ M_C.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hLM_C).mpr hx)
      have hconjM_C : (σ_F * τ_F * σ_F⁻¹).1 ∈ M_C.fixingSubgroup :=
        hMin.1.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτM_C
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjM_C
      exact hconjM_C x ((IntermediateField.mem_extendScalars hLM_C).mp hx)
    haveI : IsGalois L ↥M_C' := helper_isGalois L (AlgebraicClosure F) M_C' hM_C'_norm_fix
    haveI : Normal L ↥M_C' := IsGalois.to_normal
    let σ_L : Fin (q - 1) → (M_C' ≃ₐ[L] M_C') := fun j =>
      AlgEquiv.restrictNormalHom M_C'
        ((IntermediateField.fixingSubgroupEquiv L) ⟨(γ_all j : AbsGal F), (γ_all j).2.2⟩)
    have hσ_L_apply : ∀ (j : Fin (q - 1)) (y : M_C'),
        ((σ_L j y : M_C') : AlgebraicClosure F) = (γ_all j : AbsGal F) y.1 := by
      intro j y
      change ((AlgEquiv.restrictNormalHom M_C'
        ((IntermediateField.fixingSubgroupEquiv L) ⟨(γ_all j : AbsGal F), (γ_all j).2.2⟩) y : M_C') :
        AlgebraicClosure F) = (γ_all j : AbsGal F) y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      rfl
    have hσ_L_symm_apply : ∀ (j : Fin (q - 1)) (y : M_C'),
        (((σ_L j).symm y : M_C') : AlgebraicClosure F) = (γ_all j : AbsGal F)⁻¹ y.1 := by
      intro j y
      have h1 := hσ_L_apply j ((σ_L j).symm y)
      rw [(σ_L j).apply_symm_apply] at h1
      calc (((σ_L j).symm y : M_C') : AlgebraicClosure F)
          = (γ_all j : AbsGal F)⁻¹ ((γ_all j : AbsGal F) (((σ_L j).symm y : M_C') : AlgebraicClosure F)) :=
            ((γ_all j : AbsGal F).symm_apply_apply _).symm
        _ = (γ_all j : AbsGal F)⁻¹ y.1 := by rw [← h1]
    let e_MC : M_C ≃ₐ[F] M_C' :=
      { toExtendScalars F hLM_C with
        invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLM_C).mp y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        commutes' := fun _ => rfl }
    let σ_all : Fin (q - 1) → (M_C ≃ₐ[F] M_C) := fun j =>
      (e_MC.trans ((σ_L j).restrictScalars F)).trans e_MC.symm
    have hσ_all_coe : ∀ (j : Fin (q - 1)) (z : M_C),
        ((σ_all j) z : AlgebraicClosure F) = (γ_all j : AbsGal F) (z : AlgebraicClosure F) :=
      fun j z => hσ_L_apply j (toExtendScalars F hLM_C z)
    have hσ_all_symm_coe : ∀ (j : Fin (q - 1)) (z : M_C),
        ((σ_all j).symm z : AlgebraicClosure F) =
          (γ_all j : AbsGal F)⁻¹ (z : AlgebraicClosure F) :=
      fun j z => hσ_L_symm_apply j (toExtendScalars F hLM_C z)
    refine ⟨σ_all, hσ_all_coe, hσ_all_symm_coe, ?_, ?_, ?_⟩
    · intro j x
      apply Subtype.ext
      rw [hσ_all_coe j]
      exact (IntermediateField.mem_fixingSubgroup_iff L (γ_all j : AbsGal F)).mp
        (γ_all j).2.2 x.1 x.2
    · intro j z
      unfold valL relVal
      rw [Algebra.norm_eq_of_algEquiv (σ_all j) z]
    · intro j z
      change Algebra.trace L M_C' (σ_L j (toExtendScalars F hLM_C z)) =
        Algebra.trace L M_C' (toExtendScalars F hLM_C z)
      exact Algebra.trace_eq_of_algEquiv (σ_L j) (toExtendScalars F hLM_C z)
  let ν_all : Fin (q - 1) → (M_Cˣ →* (Ω F)ˣ) := fun j =>
    ((μ'_orb (idx_all j)).comp (Units.map (normLM F (hFiMC (idx_all j))))).comp
      (Units.map (σ_all j).toRingEquiv.toMonoidHom)
  have hγ_conj_MC : ∀ (j : Fin (q - 1)) (w : relWeil F M_C),
      (γ_all j : AbsGal F) * (w : AbsGal F) * (γ_all j : AbsGal F)⁻¹ ∈ relWeil F M_C := by
    intro j w
    refine ⟨(weilGroup F).mul_mem ((weilGroup F).mul_mem (γ_all j).2.1 w.2.1)
      ((weilGroup F).inv_mem (γ_all j).2.1), ?_⟩
    exact hMin.1.2.2.1 (γ_all j : AbsGal F) (γ_all j).2.2 w.1 w.2.2
  have hχ_ker_K_all : ∀ (i : Fin r_orb) (w : relWeil F M_C),
      (w : AbsGal F) ∈ K.fixingSubgroup →
      (restrictWeilChar F (hFiMC i) (D_orb.get i).χ) w = 1 := by
    intro i w hwK
    obtain ⟨htK, hrestK⟩ := (hD_orb_props (D_orb.get i) (List.get_mem D_orb i)).2.2.2.2.1
    let w_K : relWeil F K := ⟨w.1, ⟨w.2.1, hwK⟩⟩
    have h1 : restrictWeilChar F htK (D_orb.get i).χ w_K = 1 := by
      rw [hrestK, MonoidHom.one_apply]
    exact h1
  have hν_all_weil : ∀ (j : Fin (q - 1)) (w : M_Cˣ),
      (ν_all j) w =
        (restrictWeilChar F (hFiMC (idx_all j)) (D_orb.get (idx_all j)).χ)
          ⟨(γ_all j : AbsGal F) * (rec.recMap M_C w : AbsGal F) * (γ_all j : AbsGal F)⁻¹,
            hγ_conj_MC j (rec.recMap M_C w)⟩ := by
    intro j w
    change ((μ'_orb (idx_all j)).comp (Units.map (normLM F (hFiMC (idx_all j)))))
      (Units.map (σ_all j).toRingEquiv.toMonoidHom w) = _
    rw [(hμ'_MC (idx_all j)).1 (Units.map (σ_all j).toRingEquiv.toMonoidHom w)]
    have hconj := ld_ch14_galois_aut_recMap_conj_compat F rec L M_C K
      hLK hLM_C hM_CK hGal hMin.1 hGalMCK hMin.2.1
