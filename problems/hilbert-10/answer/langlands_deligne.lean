  intro k hk Q_k Q_main
  obtain ⟨hk_ge2, hk_le_p1⟩ := Finset.mem_Icc.mp hk
  let B_k : ℤ := 2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (k : ℤ) * (t₁ : ℤ)
  let wt : ∀ v : ℕ, (Fin v → Fin p) → ℕ := fun v g => ∑ s : Fin v, (g s : ℕ)
  let D_deg : ∀ v : ℕ, (Fin v → Fin p) → ℕ := fun v g => wt v g + (k - v)
  let prod_e : ∀ v : ℕ, (Fin v → Fin p) → M₁' := fun v g => ∏ s : Fin v, e_def (g s)
