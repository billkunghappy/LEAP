        have hp_ge2 : 2 ≤ p := hp.two_le
        have h_step : p * (q + 1) = (p * q + (p - 1)) + 1 := by
          calc p * (q + 1) = p * q + p := by ring
            _ = (p * q + (p - 1)) + 1 := by omega
        have h_ordC_pq : ordC (p * (q + 1)) = ordC (q + 1) := by
