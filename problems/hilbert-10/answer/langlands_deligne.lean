    rw [hrhs0, AddChar.map_zero_eq_one] at hbox
    have hw₀_as : w₀ ^ p - w₀ = IntermediateField.inclusion hLE' (s ^ p - s) := by
      dsimp only [w₀]
      rw [map_sub, map_pow]
    have hs_as_val : s ^ p - s = 0 ∨ 0 ≤ valL F L (s ^ p - s) :=
      hval_sub_L 0 (s ^ p) s (hpow_val_L s hs p) hs
    rw [hw₀_as, hψE'_incl_L (s ^ p - s) hs_as_val] at hbox
    exact hbox

  
  obtain ⟨a₁, ha₁⟩ := ld_ch14_finite_field_artin_schreier_coker_gen k_L p hPrime hp_kL (-1 : k_L)
  obtain ⟨s₁, hs₁_val, hs₁_res⟩ := hresL_surj a₁
  have hcoker_L : ∀ s : L, (s = 0 ∨ 0 ≤ valL F L s) →
      ∃ (e₀ : Fin p) (t_s : L),
        (t_s = 0 ∨ 0 ≤ valL F L t_s) ∧
        (s - (((e₀ : ℕ) : L) * s₁ + (t_s ^ p - t_s)) = 0 ∨
          1 ≤ valL F L (s - (((e₀ : ℕ) : L) * s₁ + (t_s ^ p - t_s)))) := by
    intro s hs
    obtain ⟨e₀, a, hc_eq⟩ := ha₁ (resL s)
    obtain ⟨t_s, hts_val, hts_res⟩ := hresL_surj a
    refine ⟨e₀, t_s, hts_val, ?_⟩
    have he₀s₁_val : ((e₀ : ℕ) : L) * s₁ = 0 ∨ 0 ≤ valL F L (((e₀ : ℕ) : L) * s₁) := by
      rcases hval_mul_ge_L (hnat_val_L (e₀ : ℕ)) hs₁_val with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hts_as_val : t_s ^ p - t_s = 0 ∨ 0 ≤ valL F L (t_s ^ p - t_s) :=
      hval_sub_L 0 (t_s ^ p) t_s (hpow_val_L t_s hts_val p) hts_val
    have hsum_val : ((e₀ : ℕ) : L) * s₁ + (t_s ^ p - t_s) = 0 ∨
        0 ≤ valL F L (((e₀ : ℕ) : L) * s₁ + (t_s ^ p - t_s)) :=
      hval_add_L 0 _ _ he₀s₁_val hts_as_val
    set δ_s : L := s - (((e₀ : ℕ) : L) * s₁ + (t_s ^ p - t_s))
    have hδ_int : δ_s = 0 ∨ 0 ≤ valL F L δ_s := hval_sub_L 0 s _ hs hsum_val
    have hδ_res : resL δ_s = 0 := by
      dsimp only [δ_s]
      rw [hresL_sub s _ hs hsum_val,
        (hresL_ring (((e₀ : ℕ) : L) * s₁) (t_s ^ p - t_s) he₀s₁_val hts_as_val).1,
        (hresL_ring ((e₀ : ℕ) : L) s₁ (hnat_val_L (e₀ : ℕ)) hs₁_val).2.1,
        hresL_sub (t_s ^ p) t_s (hpow_val_L t_s hts_val p) hts_val,
        hresL_nat (e₀ : ℕ), hs₁_res, hresL_pow t_s hts_val p, hts_res, hc_eq]
      ring
    exact (hresL_ker δ_s hδ_int).mp hδ_res

  have hψ_nat_mul : ∀ (n : ℕ) (z : L), ψ (β * ((n : L) * z)) = (ψ (β * z)) ^ n := by
    intro n z
    induction n with
    | zero =>
      rw [Nat.cast_zero, zero_mul, mul_zero, pow_zero, AddChar.map_zero_eq_one]
    | succ n ih =>
      have hid : β * (((n + 1 : ℕ) : L) * z) = β * ((n : L) * z) + β * z := by
        push_cast; ring
      rw [hid, AddChar.map_add_eq_mul, ih, pow_succ]

  set ζ : Ω F := ψ (β * s₁)
  have hψ_eval_decomp : ∀ (s t_s : L) (e₀ : Fin p),
      (t_s = 0 ∨ 0 ≤ valL F L t_s) →
      (s - (((e₀ : ℕ) : L) * s₁ + (t_s ^ p - t_s)) = 0 ∨
        1 ≤ valL F L (s - (((e₀ : ℕ) : L) * s₁ + (t_s ^ p - t_s)))) →
