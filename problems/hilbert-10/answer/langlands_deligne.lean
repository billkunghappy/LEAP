        omega
      dsimp only [f]
      rw [Polynomial.natDegree_add_eq_left_of_natDegree_lt hlt, hXk_deg]
    set i₁ : Fin k := ⟨k - 1, by omega⟩
    set i₂ : Fin k := ⟨k - 2, by omega⟩
    have hlam₂_fc : ∀ c : Fin k → k_L,
        lam₂ (f c) = Q_L (- c i₁) * ψ_0 (- c i₂) := by
      intro c
      have hdeg_pos : 0 < (f c).natDegree := by
        rw [hf_deg c]; omega
      have hnext : (f c).nextCoeff = c i₁ := by
        rw [Polynomial.nextCoeff_of_natDegree_pos hdeg_pos, hf_deg c]
        exact hf_coeff c i₁
      have hnot_lt2 : ¬ (f c).natDegree < 2 := by
        rw [hf_deg c]; omega
      have hc₂_fc : c₂ (f c) = c i₂ := by
        dsimp only [c₂]
        rw [if_neg hnot_lt2, hf_deg c]
        exact hf_coeff c i₂
      dsimp only [lam₂]
      rw [hnext, hc₂_fc]
    set u_2d_inv : Lˣ := (ϖ ^ (2 * d))⁻¹
    set z₁ : L := (c_L : L) * ((u_2d_inv : L) * x₁)
    have hz₁_val : 0 ≤ valL F L z₁ := by
      have h1 : (u_2d_inv : L) * x₁ ≠ 0 := mul_ne_zero (Units.ne_zero u_2d_inv) hx₁_ne
      dsimp only [z₁, u_2d_inv]
      rw [hval_mul (c_L : L) (((ϖ ^ (2 * d))⁻¹ : Lˣ) * x₁) (Units.ne_zero c_L) h1,
        hval_mul (((ϖ ^ (2 * d))⁻¹ : Lˣ) : L) x₁ (Units.ne_zero (ϖ ^ (2 * d))⁻¹) hx₁_ne,
        hc_L_val, hval_inv (ϖ ^ (2 * d)), hϖ_pow (2 * d)]
      omega
    set a₁ : k_L := resL z₁
    have hψ_a₁_ne1 : ψ_0 a₁ ≠ 1 := by
      have hinv_c : ((c_L⁻¹ : Lˣ) : L) * (c_L : L) = 1 := by exact_mod_cast Units.inv_mul c_L
      have hinv_2d : ((ϖ ^ (2 * d) : Lˣ) : L) * (u_2d_inv : L) = 1 := by
        exact_mod_cast Units.mul_inv (ϖ ^ (2 * d))
      have hmul_z₁ : ((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ (2 * d) : Lˣ) : L) * z₁ = x₁ := by
        dsimp only [z₁]
        calc ((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ (2 * d) : Lˣ) : L) * ((c_L : L) * ((u_2d_inv : L) * x₁))
            = (((c_L⁻¹ : Lˣ) : L) * (c_L : L)) *
                (((ϖ ^ (2 * d) : Lˣ) : L) * (u_2d_inv : L)) * x₁ := by ring
          _ = x₁ := by rw [hinv_c, hinv_2d, one_mul, one_mul]
      have hψ_a₁ : ψ_0 a₁ = ψ x₁ := by
        dsimp only [a₁]
        rw [hψ_0_int z₁ (Or.inr hz₁_val), hmul_z₁]
      rw [hψ_a₁]
      exact hx₁_ψ
    have hi_ne : i₁ ≠ i₂ := by
      intro h
      have hval := congrArg Fin.val h
      dsimp only [i₁, i₂] at hval
      omega
    set e : (Fin k → k_L) ≃ (Fin k → k_L) :=
      { toFun := fun c => Function.update c i₂ (c i₂ - a₁)
        invFun := fun c => Function.update c i₂ (c i₂ + a₁)
        left_inv := fun c => by
          simp only [Function.update_self, sub_add_cancel, Function.update_idem,
            Function.update_eq_self]
        right_inv := fun c => by
          simp only [Function.update_self, add_sub_cancel_right, Function.update_idem,
            Function.update_eq_self] }
    have hshift : ∀ c : Fin k → k_L, lam₂ (f (e c)) = ψ_0 a₁ * lam₂ (f c) := by
      intro c
      have he1 : e c i₁ = c i₁ := Function.update_of_ne hi_ne (c i₂ - a₁) c
      have he2 : e c i₂ = c i₂ - a₁ := Function.update_self i₂ (c i₂ - a₁) c
      have hneg_sub : -(c i₂ - a₁) = a₁ + -c i₂ := by ring
      rw [hlam₂_fc (e c), hlam₂_fc c, he1, he2, hneg_sub, hψ_0_add]
      ring
    set S : Ω F := ∑ c : Fin k → k_L, lam₂ (f c)
    have hS_eq : ψ_0 a₁ * S = S := by
      calc ψ_0 a₁ * S = ∑ c : Fin k → k_L, ψ_0 a₁ * lam₂ (f c) := by
            dsimp only [S]
            rw [Finset.mul_sum]
        _ = ∑ c : Fin k → k_L, lam₂ (f (e c)) := by
            refine Finset.sum_congr rfl fun c _ => ?_
            exact (hshift c).symm
        _ = S := Fintype.sum_equiv e (fun c => lam₂ (f (e c))) (fun c => lam₂ (f c)) (fun _ => rfl)
    have hsub0 : (ψ_0 a₁ - 1) * S = 0 := by
      calc (ψ_0 a₁ - 1) * S = ψ_0 a₁ * S - S := by ring
        _ = 0 := sub_eq_zero.mpr hS_eq
    exact (mul_eq_zero.mp hsub0).resolve_left (sub_ne_zero.mpr hψ_a₁_ne1)
  exact ⟨Q_L, ψ_0, lam₂, hQ_L_int, hψ_0_int, hlam₂_def, hlam₂_lin, hlam₂_1, hlam₂_mul, hlam₂_van⟩

theorem ld_cond_ge_two_extension_norm_trace_bridge (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (χ' : Lˣ →* (Ω F)ˣ)
    (hcond_ge2 : 2 ≤ condExp F L χ')
    (hcond_K : condExp F K (χ'.comp (Units.map (normLM F hLK))) = condExp F L χ')
    (hcondChar_eq : condExpChar F K (traceChar F hLK ψ) = condExpChar F L ψ)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F K y)
    (hval_alg : ∀ x : L, valL F K (IntermediateField.inclusion hLK x) = valL F L x)
    (htr_bound : ∀ (m : ℤ) (y : K), (y = 0 ∨ m ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (hnorm_lin1 : ∀ (d : ℕ), 1 ≤ d → ∀ y : K, (y = 0 ∨ (d : ℤ) ≤ valL F K y) →
      (normLM F hLK (1 + y) - (1 + traceLM F hLK y) = 0 ∨
        (2 * d : ℤ) ≤ valL F L (normLM F hLK (1 + y) - (1 + traceLM F hLK y))))
    (hSpecL : (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L χ' ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L χ' - 1), χ' u₀ ≠ 1)) ∧
      valL F L ((tateElt F L χ' ψ : Lˣ) : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hvalL_props : valL F L 0 = 0 ∧
      valL F L 1 = 0 ∧
      valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧
      valL F K 1 = 0 ∧
      valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (k_L k_K : Type u) [Field k_L] [Fintype k_L] [Field k_K] [Fintype k_K]
    [Algebra k_L k_K] (resL : L → k_L) (resK : K → k_K)
    (hfinrank_res : Module.finrank k_L k_K =
      Module.finrank L (IntermediateField.extendScalars hLK))
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hres_Fy2 : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      let F_y : Polynomial k_L :=
        (minpoly k_L (resK y)) ^
          (Module.finrank k_L k_K / (minpoly k_L (resK y)).natDegree)
      resL (traceLM F hLK y) = -F_y.nextCoeff ∧
      ∀ (ϖ : Lˣ) (d : ℕ), valL F L (ϖ : L) = 1 → 1 ≤ d →
        ∃ s₂ : L, (s₂ = 0 ∨ 0 ≤ valL F L s₂) ∧
          resL s₂ = F_y.coeff (Module.finrank k_L k_K - 2) ∧
          (normLM F hLK (1 + IntermediateField.inclusion hLK (((ϖ ^ d : Lˣ) : L)) * y) -
            (1 + (((ϖ ^ d : Lˣ) : L)) * traceLM F hLK y +
              (((ϖ ^ (2 * d) : Lˣ) : L)) * s₂) = 0 ∨
            (2 * d + 1 : ℤ) ≤ valL F L
              (normLM F hLK (1 + IntermediateField.inclusion hLK (((ϖ ^ d : Lˣ) : L)) * y) -
                (1 + (((ϖ ^ d : Lˣ) : L)) * traceLM F hLK y +
                  (((ϖ ^ (2 * d) : Lˣ) : L)) * s₂))))
    (ϖ c_L : Lˣ) (hϖ : valL F L (ϖ : L) = 1)
    (hc_L_val : valL F L (c_L : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_L_stat : ∀ w ∈ unitGroup F L (condExp F L χ' - condExp F L χ' / 2),
      (χ' w : Ω F) = ψ (((c_L⁻¹ : Lˣ) : L) * ((w : L) - 1))) :
    ∃ (ϖ_K c_K : Kˣ),
      valL F K (ϖ_K : K) = 1 ∧
      valL F K (c_K : K) =
        (condExp F K (χ'.comp (Units.map (normLM F hLK))) : ℤ) +
          condExpChar F K (traceChar F hLK ψ) ∧
      (∀ w ∈ unitGroup F K
          (condExp F K (χ'.comp (Units.map (normLM F hLK))) -
            condExp F K (χ'.comp (Units.map (normLM F hLK))) / 2),
        ((χ'.comp (Units.map (normLM F hLK))) w : Ω F) =
          (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * ((w : K) - 1))) ∧
      (((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) =
        (χ' c_L : Ω F) ^ (Module.finrank L (IntermediateField.extendScalars hLK)) ∧
        (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K)) =
          (ψ (((c_L⁻¹ : Lˣ) : L))) ^
            (Module.finrank L (IntermediateField.extendScalars hLK))) ∧
      (∀ (d : ℕ), 1 ≤ d → condExp F L χ' = 2 * d + 1 →
        ∀ (Q_L ψ_0 : k_L → Ω F) (lam₂ : Polynomial k_L → Ω F),
          (∀ (x : L) (hx_int : x = 0 ∨ 0 ≤ valL F L x)
            (hx_ne : 1 + ((ϖ ^ d : Lˣ) : L) * x ≠ 0),
            Q_L (resL x) =
              (χ' (Units.mk0 (1 + ((ϖ ^ d : Lˣ) : L) * x) hx_ne) : Ω F)⁻¹ *
                ψ (((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ d : Lˣ) : L) * x)) →
          (∀ (x : L), (x = 0 ∨ 0 ≤ valL F L x) →
            ψ_0 (resL x) = ψ (((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ (2 * d) : Lˣ) : L) * x)) →
          (∀ f : Polynomial k_L,
            lam₂ f = Q_L (-f.nextCoeff) *
              ψ_0 (-(if f.natDegree < 2 then 0 else f.coeff (f.natDegree - 2)))) →
          ∀ (y : K) (hy_int : y = 0 ∨ 0 ≤ valL F K y)
            (hy_ne : 1 + ((ϖ_K ^ d : Kˣ) : K) * y ≠ 0),
            lam₂ ((minpoly k_L (resK y)) ^
                (Module.finrank k_L k_K / (minpoly k_L (resK y)).natDegree)) =
              ((χ'.comp (Units.map (normLM F hLK)))
                (Units.mk0 (1 + ((ϖ_K ^ d : Kˣ) : K) * y) hy_ne) : Ω F)⁻¹ *
                (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * ((ϖ_K ^ d : Kˣ) : K) * y)) :=
by
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, hval_surj_L,
    hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩ := hvalL_props
  obtain ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K, hval_inv_K, hval_surj_K,
    hval_add_K, hunit0_K, hunit_ge1_K, hunit_val0_K⟩ := hvalK_props
  set a : ℕ := condExp F L χ'
  have ha_ne0 : a ≠ 0 := by omega
  have ha_ge1 : 1 ≤ a := by omega
  have hχ'_triv : ∀ u ∈ unitGroup F L a, χ' u = 1 := (hSpecL.2.2.1 ha_ne0).1
  have hval_pow_L : ∀ (x : L) (n : ℕ), x ≠ 0 → valL F L (x ^ n) = (n : ℤ) * valL F L x := by
    intro x n hx
    induction n with
    | zero => simp [hval1_L]
    | succ n ih =>
      rw [pow_succ, hval_mul_L (x ^ n) x (pow_ne_zero n hx) hx, ih]
      push_cast
      ring
  have hone_add_ne_zero_L : ∀ (m : ℕ), 1 ≤ m → ∀ (x : L),
      (x = 0 ∨ (m : ℤ) ≤ valL F L x) → 1 + x ≠ 0 := by
    intro m hm x hx h0
    have hx_neg1 : x = -1 := eq_neg_of_add_eq_zero_right h0
    rcases hx with rfl | hge
    · rw [add_zero] at h0
      exact one_ne_zero h0
    · rw [hx_neg1, hval_neg1_L] at hge
      omega
  have hone_add_mem_unitGroup_L : ∀ (m : ℕ), 1 ≤ m → ∀ (x : L)
      (hx : x = 0 ∨ (m : ℤ) ≤ valL F L x) (hne : 1 + x ≠ 0),
      Units.mk0 (1 + x) hne ∈ unitGroup F L m := by
    intro m hm x hx hne
    rw [hunit_ge1_L m hm (Units.mk0 (1 + x) hne)]
    have hsub : ((Units.mk0 (1 + x) hne : Lˣ) : L) - 1 = x := by
      rw [Units.val_mk0, add_sub_cancel_left]
    rcases hx with rfl | hge
    · left
      rw [Units.val_mk0, add_zero]
    · right
      rw [hsub]
      exact hge
  have hχ'_eq_of_sub : ∀ (u₁ u₂ : Lˣ),
      valL F L (u₁ : L) = 0 →
      ((u₂ : L) - (u₁ : L) = 0 ∨ (a : ℤ) ≤ valL F L ((u₂ : L) - (u₁ : L))) →
      χ' u₂ = χ' u₁ := by
    intro u₁ u₂ hu₁ hsub
    have hmem : u₁⁻¹ * u₂ ∈ unitGroup F L a := by
      rw [hunit_ge1_L a ha_ge1 (u₁⁻¹ * u₂)]
      have hdiff : ((u₁⁻¹ * u₂ : Lˣ) : L) - 1 =
          ((u₁⁻¹ : Lˣ) : L) * ((u₂ : L) - (u₁ : L)) := by
        calc ((u₁⁻¹ * u₂ : Lˣ) : L) - 1
          _ = ((u₁⁻¹ : Lˣ) : L) * (u₂ : L) - ((u₁⁻¹ : Lˣ) : L) * (u₁ : L) := by
            rw [Units.val_mul, Units.inv_mul]
          _ = ((u₁⁻¹ : Lˣ) : L) * ((u₂ : L) - (u₁ : L)) := by ring
      rcases hsub with h0 | hge
      · left
        have h1 : ((u₁⁻¹ * u₂ : Lˣ) : L) - 1 = 0 := by rw [hdiff, h0, mul_zero]
        exact sub_eq_zero.mp h1
      · by_cases h0 : (u₂ : L) - (u₁ : L) = 0
        · left
          have h1 : ((u₁⁻¹ * u₂ : Lˣ) : L) - 1 = 0 := by rw [hdiff, h0, mul_zero]
          exact sub_eq_zero.mp h1
        · right
          rw [hdiff, hval_mul_L _ _ (Units.ne_zero u₁⁻¹) h0, hval_inv_L u₁, hu₁]
          omega
    have htriv : χ' (u₁⁻¹ * u₂) = 1 := hχ'_triv (u₁⁻¹ * u₂) hmem
    rw [map_mul, map_inv, inv_mul_eq_one] at htriv
    exact htriv.symm
  set K' := IntermediateField.extendScalars hLK
  set ℓ : ℕ := Module.finrank L K'
  have hnorm_inc : ∀ x : L,
      normLM F hLK (IntermediateField.inclusion hLK x) = x ^ ℓ := by
    intro x
    change Algebra.norm L (algebraMap L K' x) = x ^ ℓ
    exact Algebra.norm_algebraMap x
  have htrace_inc : ∀ x : L,
      traceLM F hLK (IntermediateField.inclusion hLK x) = ℓ • x := by
    intro x
    change (Algebra.trace L K') (algebraMap L K' x) = ℓ • x
    exact Algebra.trace_algebraMap x
  have htrace_inc_mul : ∀ (x : L) (y : K),
      traceLM F hLK (IntermediateField.inclusion hLK x * y) = x * traceLM F hLK y := by
    letI : Module L L := Semiring.toModule
    intro x y
    exact (Algebra.trace L K').map_smul' x (toExtendScalars F hLK y)
  let ι : L →* K := (IntermediateField.inclusion hLK).toMonoidHom
  let ϖ_K : Kˣ := Units.map ι ϖ
  let c_K : Kˣ := Units.map ι c_L
  have hϖ_K_coe : (ϖ_K : K) = IntermediateField.inclusion hLK (ϖ : L) := rfl
  have hc_K_coe : (c_K : K) = IntermediateField.inclusion hLK (c_L : L) := rfl
  have hc_K_inv_coe : ((c_K⁻¹ : Kˣ) : K) =
      IntermediateField.inclusion hLK ((c_L⁻¹ : Lˣ) : L) := by
    change ((Units.map ι c_L)⁻¹ : Kˣ).val = (Units.map ι (c_L⁻¹)).val
    rw [← map_inv]
  have hϖ_K_pow_coe : ∀ m : ℕ,
      ((ϖ_K ^ m : Kˣ) : K) = IntermediateField.inclusion hLK ((ϖ ^ m : Lˣ) : L) := by
    intro m
    change ((Units.map ι ϖ) ^ m : Kˣ).val = (Units.map ι (ϖ ^ m)).val
    rw [← map_pow]
  have hϖ_K_val : valL F K (ϖ_K : K) = 1 := by
    rw [hϖ_K_coe, hval_alg (ϖ : L), hϖ]
  have hc_K_val : valL F K (c_K : K) =
      (condExp F K (χ'.comp (Units.map (normLM F hLK))) : ℤ) +
        condExpChar F K (traceChar F hLK ψ) := by
    rw [hc_K_coe, hval_alg (c_L : L), hc_L_val, hcond_K, hcondChar_eq]
  have hc_K_norm : Units.map (normLM F hLK) c_K = c_L ^ ℓ := by
    apply Units.ext
    change normLM F hLK (IntermediateField.inclusion hLK (c_L : L)) = ((c_L ^ ℓ : Lˣ) : L)
    rw [hnorm_inc (c_L : L), Units.val_pow_eq_pow_val]
  have hc_K_χ : ((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) = (χ' c_L : Ω F) ^ ℓ := by
    change (χ' (Units.map (normLM F hLK) c_K) : Ω F) = (χ' c_L : Ω F) ^ ℓ
    rw [hc_K_norm, map_pow, Units.val_pow_eq_pow_val]
  have hc_K_ψ : (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K)) =
      (ψ (((c_L⁻¹ : Lˣ) : L))) ^ ℓ := by
    change ψ (traceLM F hLK (((c_K⁻¹ : Kˣ) : K))) = (ψ (((c_L⁻¹ : Lˣ) : L))) ^ ℓ
    rw [hc_K_inv_coe, htrace_inc ((c_L⁻¹ : Lˣ) : L), AddChar.map_nsmul_eq_pow]
  have hc_K_stat : ∀ w ∈ unitGroup F K
      (condExp F K (χ'.comp (Units.map (normLM F hLK))) -
        condExp F K (χ'.comp (Units.map (normLM F hLK))) / 2),
      ((χ'.comp (Units.map (normLM F hLK))) w : Ω F) =
        (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * ((w : K) - 1)) := by
    set e : ℕ := a - a / 2
    have he_ge1 : 1 ≤ e := by omega
    have ha_le_2e : (a : ℤ) ≤ (2 * e : ℤ) := by omega
    intro w hw
    have hw_e : w ∈ unitGroup F K e := by
      simpa [hcond_K, a, e] using hw
    set z : K := (w : K) - 1
    have hz : z = 0 ∨ (e : ℤ) ≤ valL F K z := by
      have hw_iff := (hunit_ge1_K e he_ge1 w).mp hw_e
      rcases hw_iff with hw1 | hge
      · left
        dsimp [z]
        rw [hw1, sub_self]
      · right
        exact hge
    set t : L := traceLM F hLK z
    have ht : t = 0 ∨ (e : ℤ) ≤ valL F L t := htr_bound (e : ℤ) z hz
    have ht_ne : 1 + t ≠ 0 := hone_add_ne_zero_L e he_ge1 t ht
    set u_t : Lˣ := Units.mk0 (1 + t) ht_ne
    have hu_t : u_t ∈ unitGroup F L e := hone_add_mem_unitGroup_L e he_ge1 t ht ht_ne
    have hu_t_val : valL F L (u_t : L) = 0 := hunit_val0_L e u_t hu_t
    set u_w : Lˣ := Units.map (normLM F hLK) w
    have h1z : 1 + z = (w : K) := add_sub_cancel 1 (w : K)
    have hsub_wt : (u_w : L) - (u_t : L) = 0 ∨
        (a : ℤ) ≤ valL F L ((u_w : L) - (u_t : L)) := by
      have hdiff_eq : (u_w : L) - (u_t : L) = normLM F hLK (1 + z) - (1 + t) := by
        change normLM F hLK (w : K) - (1 + t) = normLM F hLK (1 + z) - (1 + t)
        rw [h1z]
      rw [hdiff_eq]
      rcases hnorm_lin1 e he_ge1 z hz with h0 | hge
      · left; exact h0
      · right; exact le_trans ha_le_2e hge
    have hχ_wt : χ' u_w = χ' u_t := hχ'_eq_of_sub u_t u_w hu_t_val hsub_wt
    calc ((χ'.comp (Units.map (normLM F hLK))) w : Ω F)
      _ = (χ' u_w : Ω F) := rfl
      _ = (χ' u_t : Ω F) := by rw [hχ_wt]
      _ = ψ (((c_L⁻¹ : Lˣ) : L) * ((u_t : L) - 1)) := hc_L_stat u_t hu_t
      _ = ψ (((c_L⁻¹ : Lˣ) : L) * t) := by rw [Units.val_mk0, add_sub_cancel_left]
      _ = ψ (traceLM F hLK (IntermediateField.inclusion hLK ((c_L⁻¹ : Lˣ) : L) * z)) := by
        rw [htrace_inc_mul]
      _ = (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * ((w : K) - 1)) := by
        rw [← hc_K_inv_coe]; rfl
  have hodd_bridge : ∀ (d : ℕ), 1 ≤ d → condExp F L χ' = 2 * d + 1 →
      ∀ (Q_L ψ_0 : k_L → Ω F) (lam₂ : Polynomial k_L → Ω F),
        (∀ (x : L) (hx_int : x = 0 ∨ 0 ≤ valL F L x)
          (hx_ne : 1 + ((ϖ ^ d : Lˣ) : L) * x ≠ 0),
          Q_L (resL x) =
            (χ' (Units.mk0 (1 + ((ϖ ^ d : Lˣ) : L) * x) hx_ne) : Ω F)⁻¹ *
              ψ (((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ d : Lˣ) : L) * x)) →
        (∀ (x : L), (x = 0 ∨ 0 ≤ valL F L x) →
          ψ_0 (resL x) = ψ (((c_L⁻¹ : Lˣ) : L) * ((ϖ ^ (2 * d) : Lˣ) : L) * x)) →
        (∀ f : Polynomial k_L,
          lam₂ f = Q_L (-f.nextCoeff) *
            ψ_0 (-(if f.natDegree < 2 then 0 else f.coeff (f.natDegree - 2)))) →
        ∀ (y : K) (hy_int : y = 0 ∨ 0 ≤ valL F K y)
          (hy_ne : 1 + ((ϖ_K ^ d : Kˣ) : K) * y ≠ 0),
          lam₂ ((minpoly k_L (resK y)) ^
              (Module.finrank k_L k_K / (minpoly k_L (resK y)).natDegree)) =
            ((χ'.comp (Units.map (normLM F hLK)))
              (Units.mk0 (1 + ((ϖ_K ^ d : Kˣ) : K) * y) hy_ne) : Ω F)⁻¹ *
              (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * ((ϖ_K ^ d : Kˣ) : K) * y) := by
    intro d hd ha_odd Q_L ψ_0 lam₂ hQ_L hψ_0 hlam₂ y hy_int hy_ne
    have ha_eq : a = 2 * d + 1 := ha_odd
    set b : k_K := resK y
    set ℓ_k : ℕ := Module.finrank k_L k_K
    set F_y : Polynomial k_L := (minpoly k_L b) ^ (ℓ_k / (minpoly k_L b).natDegree)
    have hb_int : IsIntegral k_L b := Algebra.IsIntegral.isIntegral b
    have hp_monic : (minpoly k_L b).Monic := minpoly.monic hb_int
    have hdvd_deg : (minpoly k_L b).natDegree ∣ ℓ_k := by
      refine ⟨Module.finrank (IntermediateField.adjoin k_L ({b} : Set k_K)) k_K, ?_⟩
      rw [← IntermediateField.adjoin.finrank hb_int,
        Module.finrank_mul_finrank k_L (IntermediateField.adjoin k_L ({b} : Set k_K)) k_K]
    have hdeg_Fy : F_y.natDegree = ℓ_k := by
      dsimp [F_y]
      rw [Polynomial.Monic.natDegree_pow hp_monic, Nat.div_mul_cancel hdvd_deg]
    have hℓ_ge2 : 2 ≤ ℓ := hPrime.two_le
    have hℓk_ge2 : 2 ≤ ℓ_k := by omega
    have hnot_lt2 : ¬ (F_y.natDegree < 2) := by omega
    have hlam₂_Fy : lam₂ F_y = Q_L (-F_y.nextCoeff) * ψ_0 (-F_y.coeff (ℓ_k - 2)) := by
      rw [hlam₂ F_y, if_neg hnot_lt2, hdeg_Fy]
    obtain ⟨htr_res, hFy2_all⟩ := hres_Fy2 y hy_int
    obtain ⟨s₂, hs₂_int, hs₂_res, hnorm_s₂⟩ := hFy2_all ϖ d hϖ hd
    set t : L := traceLM F hLK y
    have ht_int : t = 0 ∨ 0 ≤ valL F L t := htr_bound 0 y hy_int
    set π_d : L := ((ϖ ^ d : Lˣ) : L)
    set π_2d : L := ((ϖ ^ (2 * d) : Lˣ) : L)
    have hπ_d_ne : π_d ≠ 0 := Units.ne_zero (ϖ ^ d)
    have hπ_2d_ne : π_2d ≠ 0 := Units.ne_zero (ϖ ^ (2 * d))
    have hval_π_d : valL F L π_d = (d : ℤ) := by
      dsimp [π_d]
      rw [hval_pow_L (ϖ : L) d (Units.ne_zero ϖ), hϖ, mul_one]
    have hval_π_2d : valL F L π_2d = (2 * d : ℤ) := by
      dsimp [π_2d]
      rw [hval_pow_L (ϖ : L) (2 * d) (Units.ne_zero ϖ), hϖ, mul_one]
      push_cast; ring
    have hπt_val : π_d * t = 0 ∨ (d : ℤ) ≤ valL F L (π_d * t) := by
      by_cases ht0 : t = 0
      · left; rw [ht0, mul_zero]
      · right
        have ht_ge0 : 0 ≤ valL F L t := ht_int.resolve_left ht0
        rw [hval_mul_L π_d t hπ_d_ne ht0, hval_π_d]
        omega
    have h2d_ge1 : 1 ≤ 2 * d := by omega
    have hπs₂_val : π_2d * s₂ = 0 ∨ ((2 * d : ℕ) : ℤ) ≤ valL F L (π_2d * s₂) := by
      by_cases hs0 : s₂ = 0
      · left; rw [hs0, mul_zero]
      · right
        have hs_ge0 : 0 ≤ valL F L s₂ := hs₂_int.resolve_left hs0
        rw [hval_mul_L π_2d s₂ hπ_2d_ne hs0, hval_π_2d]
        omega
    have ht_ne : 1 + π_d * t ≠ 0 := hone_add_ne_zero_L d hd (π_d * t) hπt_val
    set u_t : Lˣ := Units.mk0 (1 + π_d * t) ht_ne
    have hu_t : u_t ∈ unitGroup F L d := hone_add_mem_unitGroup_L d hd (π_d * t) hπt_val ht_ne
    have hu_t_val : valL F L (u_t : L) = 0 := hunit_val0_L d u_t hu_t
    have hs₂_ne : 1 + π_2d * s₂ ≠ 0 := hone_add_ne_zero_L (2 * d) h2d_ge1 (π_2d * s₂) hπs₂_val
    set u_s₂ : Lˣ := Units.mk0 (1 + π_2d * s₂) hs₂_ne
    have hu_s₂_2d : u_s₂ ∈ unitGroup F L (2 * d) :=
      hone_add_mem_unitGroup_L (2 * d) h2d_ge1 (π_2d * s₂) hπs₂_val hs₂_ne
    have hu_s₂_val : valL F L (u_s₂ : L) = 0 := hunit_val0_L (2 * d) u_s₂ hu_s₂_2d
    have hu_s₂_stat : u_s₂ ∈ unitGroup F L (a - a / 2) := by
      have he_ge1 : 1 ≤ a - a / 2 := by omega
      have he_le_2d : ((a - a / 2 : ℕ) : ℤ) ≤ ((2 * d : ℕ) : ℤ) := by omega
      rw [hunit_ge1_L (a - a / 2) he_ge1 u_s₂]
      rcases (hunit_ge1_L (2 * d) h2d_ge1 u_s₂).mp hu_s₂_2d with h1 | hge
      · left; exact h1
      · right; omega
    have hQL_eval : Q_L (-F_y.nextCoeff) =
        (χ' u_t : Ω F)⁻¹ * ψ (((c_L⁻¹ : Lˣ) : L) * π_d * t) := by
      have htr_res' : resL t = -F_y.nextCoeff := htr_res
      rw [← htr_res']
      exact hQ_L t ht_int ht_ne
    have hns₂_int : -s₂ = 0 ∨ 0 ≤ valL F L (-s₂) := by
      rcases hs₂_int with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rw [hval_neg_L]; exact hge
    have hres_ns₂ : resL (-s₂) = -F_y.coeff (ℓ_k - 2) := by
      rw [(hresL_ring s₂ s₂ hs₂_int hs₂_int).2.2, hs₂_res]
    have hψ0_eval : ψ_0 (-F_y.coeff (ℓ_k - 2)) = (χ' u_s₂ : Ω F)⁻¹ := by
      rw [← hres_ns₂, hψ_0 (-s₂) hns₂_int]
      have harg_eq : ((c_L⁻¹ : Lˣ) : L) * π_2d * (-s₂) =
          - (((c_L⁻¹ : Lˣ) : L) * ((u_s₂ : L) - 1)) := by
        change ((c_L⁻¹ : Lˣ) : L) * π_2d * (-s₂) =
          - (((c_L⁻¹ : Lˣ) : L) * ((1 + π_2d * s₂) - 1))
        ring
      rw [harg_eq, AddChar.map_neg_eq_inv, ← hc_L_stat u_s₂ hu_s₂_stat]
    set u_y : Lˣ := Units.map (normLM F hLK) (Units.mk0 (1 + ((ϖ_K ^ d : Kˣ) : K) * y) hy_ne)
    have hu_ts_val : valL F L ((u_t * u_s₂ : Lˣ) : L) = 0 := by
      rw [Units.val_mul, hval_mul_L _ _ (Units.ne_zero u_t) (Units.ne_zero u_s₂),
        hu_t_val, hu_s₂_val, add_zero]
    set S : L := 1 + π_d * t + π_2d * s₂
    have hsub1 : (u_y : L) - S = 0 ∨ (a : ℤ) ≤ valL F L ((u_y : L) - S) := by
      have huy_coe : (u_y : L) =
          normLM F hLK (1 + IntermediateField.inclusion hLK π_d * y) := by
        change normLM F hLK (1 + ((ϖ_K ^ d : Kˣ) : K) * y) =
          normLM F hLK (1 + IntermediateField.inclusion hLK π_d * y)
        rw [hϖ_K_pow_coe d]
      rw [huy_coe]
      rcases hnorm_s₂ with h0 | hge
      · left; exact h0
      · right
        have ha_cast : (a : ℤ) = (2 * d + 1 : ℤ) := by exact_mod_cast ha_eq
        rw [ha_cast]
        exact hge
    have hsub2 : S - ((u_t * u_s₂ : Lˣ) : L) = 0 ∨
        (a : ℤ) ≤ valL F L (S - ((u_t * u_s₂ : Lˣ) : L)) := by
      have hdiff2 : S - ((u_t * u_s₂ : Lˣ) : L) = - ((π_d * t) * (π_2d * s₂)) := by
        change (1 + π_d * t + π_2d * s₂) - (1 + π_d * t) * (1 + π_2d * s₂) =
          - ((π_d * t) * (π_2d * s₂))
        ring
      rw [hdiff2]
      by_cases hprod0 : (π_d * t) * (π_2d * s₂) = 0
      · left; rw [hprod0, neg_zero]
      · right
        have h1_ne : π_d * t ≠ 0 := left_ne_zero_of_mul hprod0
        have h2_ne : π_2d * s₂ ≠ 0 := right_ne_zero_of_mul hprod0
        have h1_ge : (d : ℤ) ≤ valL F L (π_d * t) := hπt_val.resolve_left h1_ne
        have h2_ge : ((2 * d : ℕ) : ℤ) ≤ valL F L (π_2d * s₂) := hπs₂_val.resolve_left h2_ne
        rw [hval_neg_L, hval_mul_L _ _ h1_ne h2_ne]
        omega
    have hsub_tot : (u_y : L) - ((u_t * u_s₂ : Lˣ) : L) = 0 ∨
        (a : ℤ) ≤ valL F L ((u_y : L) - ((u_t * u_s₂ : Lˣ) : L)) := by
      have hadd := hval_add_L (a : ℤ) ((u_y : L) - S) (S - ((u_t * u_s₂ : Lˣ) : L)) hsub1 hsub2
      have hsum_eq : ((u_y : L) - S) + (S - ((u_t * u_s₂ : Lˣ) : L)) =
          (u_y : L) - ((u_t * u_s₂ : Lˣ) : L) := sub_add_sub_cancel _ _ _
      rw [hsum_eq] at hadd
      exact hadd
    have hχ_uy : χ' u_y = χ' (u_t * u_s₂) :=
      hχ'_eq_of_sub (u_t * u_s₂) u_y hu_ts_val hsub_tot
    have hχ_uy_inv : (χ' u_y : Ω F)⁻¹ = (χ' u_t : Ω F)⁻¹ * (χ' u_s₂ : Ω F)⁻¹ := by
      rw [hχ_uy, map_mul, Units.val_mul, mul_inv_rev, mul_comm]
    have hψ_tr_eq : (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * ((ϖ_K ^ d : Kˣ) : K) * y) =
        ψ (((c_L⁻¹ : Lˣ) : L) * π_d * t) := by
      change ψ (traceLM F hLK (((c_K⁻¹ : Kˣ) : K) * ((ϖ_K ^ d : Kˣ) : K) * y)) =
        ψ (((c_L⁻¹ : Lˣ) : L) * π_d * t)
      rw [hc_K_inv_coe, hϖ_K_pow_coe d, ← map_mul (IntermediateField.inclusion hLK),
        htrace_inc_mul]
    change lam₂ F_y = (χ' u_y : Ω F)⁻¹ *
      (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * ((ϖ_K ^ d : Kˣ) : K) * y)
    rw [hlam₂_Fy, hQL_eval, hψ0_eval, hχ_uy_inv, hψ_tr_eq]
    ring
  exact ⟨ϖ_K, c_K, hϖ_K_val, hc_K_val, hc_K_stat, ⟨hc_K_χ, hc_K_ψ⟩, hodd_bridge⟩

theorem ld_ch10_unramified_hd_loc_cond_ge_two (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (χ' : Lˣ →* (Ω F)ˣ)
    (hcond_ge2 : 2 ≤ condExp F L χ')
    (hcond_K : condExp F K (χ'.comp (Units.map (normLM F hLK))) = condExp F L χ')
    (hcondChar_eq : condExpChar F K (traceChar F hLK ψ) = condExpChar F L ψ)
    (hqL_eq : qL F K = (qL F L) ^ (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F K y)
    (hval_alg : ∀ x : L, valL F K (IntermediateField.inclusion hLK x) = valL F L x)
    (htr_bound : ∀ (m : ℤ) (y : K), (y = 0 ∨ m ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (hy₁ : ∃ y₁ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) ∧ traceLM F hLK y₁ = 1)
    (hnorm_lin1 : ∀ (d : ℕ), 1 ≤ d → ∀ y : K, (y = 0 ∨ (d : ℤ) ≤ valL F K y) →
      (normLM F hLK (1 + y) - (1 + traceLM F hLK y) = 0 ∨
        (2 * d : ℤ) ≤ valL F L (normLM F hLK (1 + y) - (1 + traceLM F hLK y))))
    (hSpecL : (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L χ' ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L χ' - 1), χ' u₀ ≠ 1)) ∧
      valL F L ((tateElt F L χ' ψ : Lˣ) : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hSpecK : (∀ y : K, (y = 0 ∨ -condExpChar F K (traceChar F hLK ψ) ≤ valL F K y) →
        traceChar F hLK ψ y = 1) ∧
      (∃ y₁ : K, y₁ ≠ 0 ∧ -(condExpChar F K (traceChar F hLK ψ) + 1) ≤ valL F K y₁ ∧
        traceChar F hLK ψ y₁ ≠ 1) ∧
      (condExp F K (χ'.comp (Units.map (normLM F hLK))) ≠ 0 →
        (∀ w ∈ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))),
          (χ'.comp (Units.map (normLM F hLK))) w = 1) ∧
        (∃ w₀ ∈ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK))) - 1),
          (χ'.comp (Units.map (normLM F hLK))) w₀ ≠ 1)) ∧
      valL F K ((tateElt F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) : Kˣ) : K) =
        (condExp F K (χ'.comp (Units.map (normLM F hLK))) : ℤ) +
          condExpChar F K (traceChar F hLK ψ))
    (hFinL : Set.Finite {u : Lˣ ⧸ unitGroup F L (condExp F L χ') |
      valL F L ((cosetRep u : Lˣ) : L) = 0})
    (hFinK : Set.Finite {w : Kˣ ⧸ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))) |
      valL F K ((cosetRep w : Kˣ) : K) = 0})
    (k_L k_K : Type u) [Field k_L] [Fintype k_L] [Field k_K] [Fintype k_K]
    [Algebra k_L k_K] (resL : L → k_L) (resK : K → k_K)
    (hfinrank_res : Module.finrank k_L k_K =
      Module.finrank L (IntermediateField.extendScalars hLK))
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (hresK_0 : resK 0 = 0) (hresK_1 : resK 1 = 1)
    (hresK_ring : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      resK (y₁ + y₂) = resK y₁ + resK y₂ ∧
      resK (y₁ * y₂) = resK y₁ * resK y₂ ∧
      resK (-y₁) = -resK y₁)
    (hresK_ker : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      (resK y = 0 ↔ (y = 0 ∨ 1 ≤ valL F K y)))
    (hresK_surj : ∀ b : k_K, ∃ y : K, (y = 0 ∨ 0 ≤ valL F K y) ∧ resK y = b)
    (hres_Fy2 : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      let F_y : Polynomial k_L :=
        (minpoly k_L (resK y)) ^
          (Module.finrank k_L k_K / (minpoly k_L (resK y)).natDegree)
      resL (traceLM F hLK y) = -F_y.nextCoeff ∧
      ∀ (ϖ : Lˣ) (d : ℕ), valL F L (ϖ : L) = 1 → 1 ≤ d →
        ∃ s₂ : L, (s₂ = 0 ∨ 0 ≤ valL F L s₂) ∧
          resL s₂ = F_y.coeff (Module.finrank k_L k_K - 2) ∧
          (normLM F hLK (1 + IntermediateField.inclusion hLK (((ϖ ^ d : Lˣ) : L)) * y) -
            (1 + (((ϖ ^ d : Lˣ) : L)) * traceLM F hLK y +
              (((ϖ ^ (2 * d) : Lˣ) : L)) * s₂) = 0 ∨
            (2 * d + 1 : ℤ) ≤ valL F L
              (normLM F hLK (1 + IntermediateField.inclusion hLK (((ϖ ^ d : Lˣ) : L)) * y) -
                (1 + (((ϖ ^ d : Lˣ) : L)) * traceLM F hLK y +
                  (((ϖ ^ (2 * d) : Lˣ) : L)) * s₂))))
    (hPolyLift : ∀ (lam : Polynomial k_L → Ω F),
      lam 1 = 1 →
      (∀ f g : Polynomial k_L, f.Monic → g.Monic → lam (f * g) = lam f * lam g) →
      (∀ (d : ℕ), 2 ≤ d → d ≤ Module.finrank k_L k_K →
        (∑ c : Fin d → k_L,
          lam (Polynomial.X ^ d + ∑ i : Fin d, Polynomial.C (c i) * Polynomial.X ^ (i : ℕ))) = 0) →
      (∑ y : k_K,
        lam ((minpoly k_L y) ^ (Module.finrank k_L k_K / (minpoly k_L y).natDegree))) =
        (-1 : Ω F) ^ (Module.finrank k_L k_K - 1) *
          (∑ x : k_L, lam (Polynomial.X - Polynomial.C x)) ^ (Module.finrank k_L k_K)) :
    tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) =
      (-1 : Ω F) ^ (condExp F L χ' *
        (Module.finrank L (IntermediateField.extendScalars hLK) - 1)) *
        (tateEps F L χ' ψ) ^ (Module.finrank L (IntermediateField.extendScalars hLK)) :=
by
  have hvalL := ld_valL_and_unitGroup_props F L
  have hvalK := ld_valL_and_unitGroup_props F K
  have hne_L := ld_tateEps_ne_zero F L ψ hψ χ'
  obtain ⟨ϖ, hϖ⟩ := hvalL.2.2.2.2.2.2.1 1
  have hStatL :=
    ld_cond_ge_two_stationary_phase_sum_reduction F L ψ χ' hcond_ge2 hSpecL hFinL hvalL
  obtain ⟨c_L, hc_L_val, hc_L_stat⟩ := hStatL.1 hne_L
  have heps_L := hStatL.2 c_L hc_L_val hc_L_stat
  obtain ⟨ϖ_K, c_K, hϖ_K, hc_K_val, hc_K_stat, ⟨hc_K_χ, hc_K_ψ⟩, hodd_bridge⟩ :=
    ld_cond_ge_two_extension_norm_trace_bridge F L K hLK hPrime ψ χ' hcond_ge2 hcond_K
      hcondChar_eq hval_norm hval_alg htr_bound hnorm_lin1 hSpecL hvalL hvalK
      k_L k_K resL resK hfinrank_res hresL_ring hres_Fy2 ϖ c_L hϖ hc_L_val hc_L_stat
  have hcond_K_ge2 : 2 ≤ condExp F K (χ'.comp (Units.map (normLM F hLK))) :=
    hcond_K.symm ▸ hcond_ge2
  have hStatK :=
    ld_cond_ge_two_stationary_phase_sum_reduction F K (traceChar F hLK ψ)
      (χ'.comp (Units.map (normLM F hLK))) hcond_K_ge2 hSpecK hFinK hvalK
  have heps_K := hStatK.2 c_K hc_K_val hc_K_stat
  have hSpecL_χ : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1 :=
    (hSpecL.2.2.1 (by omega)).1
  have hSpecK_χ :
      ∀ w ∈ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))),
        (χ'.comp (Units.map (normLM F hLK))) w = 1 :=
    (hSpecK.2.2.1 (by omega)).1
  have hevalL :=
    ld_cond_ge_two_filtration_card_and_eval F L ψ χ' hcond_ge2 hSpecL.1 hSpecL_χ hFinL hvalL
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj ϖ c_L hϖ hc_L_val hc_L_stat
  have hevalK :=
    ld_cond_ge_two_filtration_card_and_eval F K (traceChar F hLK ψ)
      (χ'.comp (Units.map (normLM F hLK))) hcond_K_ge2 hSpecK.1 hSpecK_χ hFinK hvalK
      k_K resK hresK_0 hresK_1 hresK_ring hresK_ker hresK_surj ϖ_K c_K hϖ_K hc_K_val hc_K_stat
  dsimp only at hevalL hevalK
  set ℓ := Module.finrank L (IntermediateField.extendScalars hLK)
  have hcard_kK : Fintype.card k_K = (Fintype.card k_L) ^ ℓ := by
    rw [← hfinrank_res]
    exact Module.card_eq_pow_finrank
  have hcard_Ω : ∀ d : ℕ,
      (Fintype.card k_K : Ω F) ^ d = ((Fintype.card k_L : Ω F) ^ d) ^ ℓ := by
    intro d
    rw [hcard_kK, Nat.cast_pow, ← pow_mul, mul_comm, pow_mul]
  have hq_Ω :
      (qL F K : Ω F) ^ condExpChar F K (traceChar F hLK ψ) =
        ((qL F L : Ω F) ^ condExpChar F L ψ) ^ ℓ := by
    rw [hqL_eq, hcondChar_eq, Nat.cast_pow, ← zpow_natCast, ← zpow_mul, ← zpow_natCast,
      ← zpow_mul, mul_comm]
  rcases Nat.mod_two_eq_zero_or_one (condExp F L χ') with ha_mod | ha_mod
  · have ha_even : condExp F L χ' = 2 * (condExp F L χ' / 2) := by omega
    have ha_even_K :
        condExp F K (χ'.comp (Units.map (normLM F hLK))) =
          2 * (condExp F K (χ'.comp (Units.map (normLM F hLK))) / 2) := by
      rw [hcond_K]
      exact ha_even
    have hsumL := hevalL.1 ha_even
    have hsumK := hevalK.1 ha_even_K
    have hsign : (-1 : Ω F) ^ (condExp F L χ' * (ℓ - 1)) = 1 := by
      rw [ha_even, mul_assoc, pow_mul]
      norm_num
    rw [heps_K, hsumK, hcond_K, heps_L, hsumL, hc_K_χ, hc_K_ψ, hq_Ω, hcard_Ω, hsign, one_mul]
    ring
  · set d := condExp F L χ' / 2
    have hd : 1 ≤ d := by omega
    have ha_odd : condExp F L χ' = 2 * d + 1 := by omega
    have ha_odd_K :
        condExp F K (χ'.comp (Units.map (normLM F hLK))) =
          2 * (condExp F K (χ'.comp (Units.map (normLM F hLK))) / 2) + 1 := by
      rw [hcond_K]
      exact ha_odd
    obtain ⟨Q_L, ψ_0, lam₂, hQ_L, hψ_0, hlam₂_def, hlam₂_lin, hlam₂_1, hlam₂_mul, hlam₂_van⟩ :=
      ld_cond_ge_two_odd_quadratic_poly_lam F L ψ χ' d hd ha_odd hSpecL hvalL
        k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj ϖ c_L hϖ hc_L_val hc_L_stat
    have hsumL := hevalL.2 ha_odd Q_L hQ_L
    have hQ_K := hodd_bridge d hd ha_odd Q_L ψ_0 lam₂ hQ_L hψ_0 hlam₂_def
    have hsumK :=
      hevalK.2 ha_odd_K
        (fun b => lam₂ ((minpoly k_L b) ^ (Module.finrank k_L k_K / (minpoly k_L b).natDegree)))
        (by rw [hcond_K]; exact hQ_K)
    dsimp only at hsumK
    have hpoly := hPolyLift lam₂ hlam₂_1 hlam₂_mul (fun k hk2 _ => hlam₂_van k hk2)
    have hsum_lin : (∑ x : k_L, lam₂ (Polynomial.X - Polynomial.C x)) = ∑ x : k_L, Q_L x :=
      Finset.sum_congr rfl fun x _ => hlam₂_lin x
    rw [hsum_lin] at hpoly
    have hsign : (-1 : Ω F) ^ (condExp F L χ' * (ℓ - 1)) = (-1 : Ω F) ^ (ℓ - 1) := by
      rw [ha_odd, add_mul, one_mul, pow_add, mul_assoc, pow_mul]
      norm_num
    rw [heps_K, hsumK, hcond_K, hpoly, hfinrank_res, heps_L, hsumL, hc_K_χ, hc_K_ψ, hq_Ω,
      hcard_Ω, hsign]
    dsimp only [d]
    ring

theorem ld_ch10_finite_field_poly_char_lifting (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_L k_K : Type u) [Field k_L] [Fintype k_L] [Field k_K] [Fintype k_K]
    [Algebra k_L k_K]
    (hPrime : Nat.Prime (Module.finrank k_L k_K))
    (lam : Polynomial k_L → Ω F)
    (hlam_one : lam 1 = 1)
    (hlam_mul : ∀ f g : Polynomial k_L, f.Monic → g.Monic → lam (f * g) = lam f * lam g)
    (hlam_vanish : ∀ (d : ℕ), 2 ≤ d → d ≤ Module.finrank k_L k_K →
      (∑ c : Fin d → k_L,
        lam (Polynomial.X ^ d + ∑ i : Fin d, Polynomial.C (c i) * Polynomial.X ^ (i : ℕ))) = 0) :
    (∑ y : k_K,
      lam ((minpoly k_L y) ^ (Module.finrank k_L k_K / (minpoly k_L y).natDegree))) =
      (-1 : Ω F) ^ (Module.finrank k_L k_K - 1) *
        (∑ x : k_L, lam (Polynomial.X - Polynomial.C x)) ^ (Module.finrank k_L k_K) :=
by
  suffices h_gen : ∀ (R : Type) [CommRing R] (lam : Polynomial k_L → R),
      lam 1 = 1 →
      (∀ f g : Polynomial k_L, f.Monic → g.Monic → lam (f * g) = lam f * lam g) →
      (∀ (d : ℕ), 2 ≤ d → d ≤ Module.finrank k_L k_K →
        (∑ c : Fin d → k_L,
          lam (Polynomial.X ^ d + ∑ i : Fin d, Polynomial.C (c i) * Polynomial.X ^ (i : ℕ))) = 0) →
      (∑ y : k_K,
        lam ((minpoly k_L y) ^ (Module.finrank k_L k_K / (minpoly k_L y).natDegree))) =
        (-1 : R) ^ (Module.finrank k_L k_K - 1) *
          (∑ x : k_L, lam (Polynomial.X - Polynomial.C x)) ^ (Module.finrank k_L k_K) by
    exact h_gen (Ω F) lam hlam_one hlam_mul hlam_vanish
  clear hlam_one hlam_mul hlam_vanish lam
  intro R _ lam hlam_one hlam_mul hlam_vanish
  obtain ⟨M, hM_mem, hM_card, hM_zero, hM_one_sum, hM_deg_sum⟩ :
      ∃ (M : ℕ → Finset (Polynomial k_L)),
        (∀ (d : ℕ) (f : Polynomial k_L), f ∈ M d ↔ f.Monic ∧ f.natDegree = d) ∧
        (∀ d : ℕ, (M d).card = (Fintype.card k_L) ^ d) ∧
        M 0 = {1} ∧
        (∀ (μ : Polynomial k_L → R),
          (∑ f ∈ M 1, μ f) = ∑ x : k_L, μ (Polynomial.X - Polynomial.C x)) ∧
        (∀ (d : ℕ) (μ : Polynomial k_L → R),
          (∑ f ∈ M d, μ f) =
            ∑ c : Fin d → k_L,
              μ (Polynomial.X ^ d + ∑ i : Fin d, Polynomial.C (c i) * Polynomial.X ^ (i : ℕ))) := by
    let polyPhi : ∀ d : ℕ, (Fin d → k_L) → Polynomial k_L := fun d c =>
      Polynomial.X ^ d + ∑ i : Fin d, Polynomial.C (c i) * Polynomial.X ^ (i : ℕ)
    have coeff_polyPhi_lt : ∀ {d : ℕ} (c : Fin d → k_L) {k : ℕ} (hk : k < d),
        (polyPhi d c).coeff k = c ⟨k, hk⟩ := by
      intro d c k hk
      dsimp [polyPhi]
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, if_neg (by omega), zero_add,
        Polynomial.finset_sum_coeff]
      rw [Finset.sum_eq_single ⟨k, hk⟩]
      · rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_pos rfl, mul_one]
      · intro b _ hb
        have hbk : k ≠ (b : ℕ) := by
          intro h
          apply hb
          ext
          exact h.symm
        rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg hbk, mul_zero]
      · intro h
        exact False.elim (h (Finset.mem_univ _))
    have coeff_polyPhi_eq : ∀ {d : ℕ} (c : Fin d → k_L),
        (polyPhi d c).coeff d = 1 := by
      intro d c
      dsimp [polyPhi]
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, if_pos rfl,
        Polynomial.finset_sum_coeff]
      suffices h : (∑ i : Fin d, (Polynomial.C (c i) * Polynomial.X ^ (i : ℕ)).coeff d) = 0 by
        rw [h, add_zero]
      apply Finset.sum_eq_zero
      intro i _
      have hid : d ≠ (i : ℕ) := by omega
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg hid, mul_zero]
    have coeff_polyPhi_gt : ∀ {d : ℕ} (c : Fin d → k_L) {k : ℕ} (hk : d < k),
        (polyPhi d c).coeff k = 0 := by
      intro d c k hk
      dsimp [polyPhi]
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, if_neg (by omega), zero_add,
        Polynomial.finset_sum_coeff]
      apply Finset.sum_eq_zero
      intro i _
      have hik : k ≠ (i : ℕ) := by omega
      rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg hik, mul_zero]
    have polyPhi_injective : ∀ d : ℕ, Function.Injective (polyPhi d) := by
      intro d c₁ c₂ h
      funext i
      have h1 := coeff_polyPhi_lt c₁ i.isLt
      have h2 := coeff_polyPhi_lt c₂ i.isLt
      have hi : (⟨(i : ℕ), i.isLt⟩ : Fin d) = i := Fin.ext rfl
      rw [hi] at h1 h2
      rw [← h1, ← h2, h]
    have polyPhi_monic_and_natDegree : ∀ {d : ℕ} (c : Fin d → k_L),
        (polyPhi d c).Monic ∧ (polyPhi d c).natDegree = d := by
      intro d c
      have hle : (polyPhi d c).natDegree ≤ d := by
        rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
        intro N hN
        exact coeff_polyPhi_gt c hN
      have hge : d ≤ (polyPhi d c).natDegree := by
        apply Polynomial.le_natDegree_of_ne_zero
        rw [coeff_polyPhi_eq]
        exact one_ne_zero
      have hdeg : (polyPhi d c).natDegree = d := le_antisymm hle hge
      refine ⟨?_, hdeg⟩
      rw [Polynomial.Monic, Polynomial.leadingCoeff, hdeg, coeff_polyPhi_eq]
    have eq_polyPhi_of_monic_natDegree : ∀ {d : ℕ} {f : Polynomial k_L},
        f.Monic → f.natDegree = d → polyPhi d (fun i : Fin d => f.coeff (i : ℕ)) = f := by
      intro d f hf_mon hf_deg
      ext k
      rcases lt_trichotomy k d with hlt | rfl | hgt
      · exact coeff_polyPhi_lt _ hlt
      · rw [coeff_polyPhi_eq]
        have hlead : f.coeff k = f.leadingCoeff := by rw [Polynomial.leadingCoeff, hf_deg]
        rw [hlead, hf_mon.leadingCoeff]
      · rw [coeff_polyPhi_gt _ hgt, Polynomial.coeff_eq_zero_of_natDegree_lt (hf_deg ▸ hgt)]
    let M : ℕ → Finset (Polynomial k_L) := fun d => Finset.univ.image (polyPhi d)
    have hM_mem : ∀ (d : ℕ) (f : Polynomial k_L), f ∈ M d ↔ f.Monic ∧ f.natDegree = d := by
      intro d f
      simp only [M, Finset.mem_image, Finset.mem_univ, true_and]
      constructor
      · rintro ⟨c, rfl⟩
        exact polyPhi_monic_and_natDegree c
      · rintro ⟨hf_mon, hf_deg⟩
        exact ⟨fun i => f.coeff (i : ℕ), eq_polyPhi_of_monic_natDegree hf_mon hf_deg⟩
    refine ⟨M, hM_mem, ?_, ?_, ?_, ?_⟩
    · intro d
      simp only [M]
      rw [Finset.card_image_of_injective _ (polyPhi_injective d), Finset.card_univ,
        Fintype.card_fun, Fintype.card_fin]
    · ext f
      rw [hM_mem, Finset.mem_singleton]
      constructor
      · rintro ⟨hf_mon, hf_deg⟩
        rw [(eq_polyPhi_of_monic_natDegree hf_mon hf_deg).symm]
        dsimp [polyPhi]
        rw [pow_zero, Finset.univ_eq_empty, Finset.sum_empty, add_zero]
      · rintro rfl
        exact ⟨Polynomial.monic_one, Polynomial.natDegree_one⟩
    · intro μ
      let ψ₁ : k_L → Polynomial k_L := fun x => Polynomial.X - Polynomial.C x
      have hψ₁_inj : Function.Injective ψ₁ := by
        intro x₁ x₂ h
        have hc := congr_arg (fun p : Polynomial k_L => p.coeff 0) h
        simp only [ψ₁, Polynomial.coeff_sub, Polynomial.coeff_X_zero, Polynomial.coeff_C_zero,
          zero_sub, neg_inj] at hc
        exact hc
      have hM1 : M 1 = Finset.univ.image ψ₁ := by
        ext f
        rw [hM_mem, Finset.mem_image]
        constructor
        · rintro ⟨hf_mon, hf_deg⟩
          refine ⟨-f.coeff 0, Finset.mem_univ _, ?_⟩
          have hphi := eq_polyPhi_of_monic_natDegree hf_mon hf_deg
          dsimp [polyPhi] at hphi
          simp only [Fin.sum_univ_one, Fin.val_zero, pow_zero, mul_one, pow_one] at hphi
          simp only [ψ₁, map_neg, sub_neg_eq_add]
          exact hphi
        · rintro ⟨x, _, rfl⟩
          exact ⟨Polynomial.monic_X_sub_C x, Polynomial.natDegree_X_sub_C x⟩
      rw [hM1, Finset.sum_image (fun x _ y _ h => hψ₁_inj h)]
    · intro d μ
      simp only [M]
      rw [Finset.sum_image (fun x _ y _ h => polyPhi_injective d h)]
  obtain ⟨Λ, hΛ_prime_pow, hΛ_div_sum, prime_pow_base_unique⟩ :
      ∃ (Λ : Polynomial k_L → ℕ),
        (∀ (P : Polynomial k_L) (k : ℕ), P.Monic → Irreducible P → 1 ≤ k →
          Λ (P ^ k) = P.natDegree) ∧
        (∀ (n : ℕ) (P_poly : Polynomial k_L), P_poly ∈ M n →
          (∑ d ∈ Finset.Icc 1 n, ∑ Q ∈ (M d).filter (fun Q => Q ∣ P_poly), Λ Q) = n) ∧
        (∀ (P₁ P₂ : Polynomial k_L) (k₁ k₂ : ℕ),
          P₁.Monic → Irreducible P₁ → 1 ≤ k₁ →
          P₂.Monic → Irreducible P₂ → 1 ≤ k₂ →
          P₁ ^ k₁ = P₂ ^ k₂ → P₁ = P₂) := by
    have prime_pow_base_unique : ∀ (P₁ P₂ : Polynomial k_L) (k₁ k₂ : ℕ),
        P₁.Monic → Irreducible P₁ → 1 ≤ k₁ →
        P₂.Monic → Irreducible P₂ → 1 ≤ k₂ →
        P₁ ^ k₁ = P₂ ^ k₂ → P₁ = P₂ := by
      intro P₁ P₂ k₁ k₂ hP₁_mon hP₁_irr hk₁ hP₂_mon hP₂_irr _hk₂ heq
      have hdvd_pow : P₁ ∣ P₂ ^ k₂ := heq ▸ dvd_pow_self P₁ (by omega)
      have hP₁_prime : Prime P₁ := UniqueFactorizationMonoid.irreducible_iff_prime.mp hP₁_irr
      have hdvd : P₁ ∣ P₂ := hP₁_prime.dvd_of_dvd_pow hdvd_pow
      have hassoc : Associated P₁ P₂ :=
        (Irreducible.dvd_irreducible_iff_associated hP₁_irr hP₂_irr).mp hdvd
      exact Polynomial.eq_of_monic_of_associated hP₁_mon hP₂_mon hassoc
    let isPolyPrimePow : Polynomial k_L → Prop := fun Q =>
      ∃ P : Polynomial k_L, P.Monic ∧ Irreducible P ∧ ∃ k : ℕ, 1 ≤ k ∧ Q = P ^ k
    let Λ : Polynomial k_L → ℕ := fun Q =>
      if h : isPolyPrimePow Q then h.choose.natDegree else 0
    have hΛ_prime_pow : ∀ (P : Polynomial k_L) (k : ℕ), P.Monic → Irreducible P → 1 ≤ k →
        Λ (P ^ k) = P.natDegree := by
      intro P k hP_mon hP_irr hk
      have h : isPolyPrimePow (P ^ k) := ⟨P, hP_mon, hP_irr, k, hk, rfl⟩
      dsimp [Λ]
      rw [dif_pos h]
      rcases h.choose_spec with ⟨hP'_mon, hP'_irr, k', hk', heq⟩
      have hP_eq : h.choose = P :=
        prime_pow_base_unique h.choose P k' k hP'_mon hP'_irr hk' hP_mon hP_irr hk heq.symm
      rw [hP_eq]
    have monic_irreducible_natDegree_pos : ∀ {P : Polynomial k_L},
        P.Monic → Irreducible P → 0 < P.natDegree := by
      intro P hP_mon hP_irr
      by_contra h
      have h0 : P.natDegree = 0 := by omega
      have h1 : P = 1 := by
        rw [Polynomial.eq_C_of_natDegree_eq_zero h0]
        have hc : P.coeff 0 = P.leadingCoeff := by rw [Polynomial.leadingCoeff, h0]
        rw [hc, hP_mon.leadingCoeff, map_one]
      exact hP_irr.ne_one h1
    obtain ⟨polyPrimePowDivs, mem_polyPrimePowDivs, sum_polyPrimePowDivs_eq, polyPrimePowDivs_deg0⟩ :
        ∃ (polyPrimePowDivs : Polynomial k_L → Finset (Polynomial k_L)),
          (∀ {F : Polynomial k_L}, F.Monic → ∀ (Q : Polynomial k_L),
            Q ∈ polyPrimePowDivs F ↔ isPolyPrimePow Q ∧ Q ∣ F) ∧
          (∀ {n : ℕ} {F : Polynomial k_L}, F ∈ M n →
            (∑ d ∈ Finset.Icc 1 n, ∑ Q ∈ (M d).filter (fun Q => Q ∣ F), Λ Q) =
              ∑ Q ∈ polyPrimePowDivs F, Λ Q) ∧
          (∀ {F : Polynomial k_L}, F.natDegree = 0 → polyPrimePowDivs F = ∅) := by
      let ppDivs : Polynomial k_L → Finset (Polynomial k_L) := fun F =>
        ((Finset.Icc 1 F.natDegree).biUnion (fun d => (M d).filter (fun Q => Q ∣ F))).filter
          isPolyPrimePow
      refine ⟨ppDivs, ?_, ?_, ?_⟩
      · intro F hF_mon Q
        dsimp [ppDivs]
        rw [Finset.mem_filter, Finset.mem_biUnion]
        constructor
        · rintro ⟨⟨d, _, hd⟩, hpp⟩
          rw [Finset.mem_filter] at hd
          exact ⟨hpp, hd.2⟩
        · rintro ⟨hpp, hdvd⟩
          refine ⟨?_, hpp⟩
          rcases hpp with ⟨R, hR_mon, hR_irr, k, hk, rfl⟩
          have hRk_mon : (R ^ k).Monic := hR_mon.pow k
