          intro m _
          rw [hσ_mul m Polynomial.X H Polynomial.monic_X hH_mon, (hσ_deg_ell m H c₀ hH).2]
        rw [Finset.prod_congr rfl h_f, Finset.prod_mul_distrib, Finset.prod_const,
          Finset.card_range, hNH_exp]
      have h_idx : (ℓ - 1) * ℓ = (ℓ - 2) * ℓ + ℓ := by
        calc (ℓ - 1) * ℓ = ((ℓ - 2) + 1) * ℓ := by congr 1; omega
          _ = (ℓ - 2) * ℓ + ℓ := by ring
      rw [h_prod_XH, h_idx, Polynomial.coeff_X_pow_mul, hNH_next]
    have h_range_split : ℓ + 1 = (ℓ - 1) + 1 + 1 := by omega
    have h_sub_add : (ℓ - 1) + 1 = ℓ := by omega
    rw [h_range_split, Finset.sum_range_succ, Finset.sum_range_succ, h_sub_add,
      Finset.sum_eq_zero hS_lt, zero_add, hS_sub1, hS_ell, add_comm]
  exact ⟨σ, 𝒩_ℓ, hσ_coeff, hσ_mem, hσ_mul, hσ_zero, hσ_add, hσ_expand, hσ_irr,
    h𝒩_prop, h𝒩_one, h𝒩_mul, h_nextCoeff⟩

theorem ld_ch13_frob_norm_poly_and_galois_norm (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M]
    (ℓ f_H : ℕ) (hPrime : Nat.Prime ℓ) (hf_H_gt1 : 1 < f_H)
    (hfinrank : Module.finrank k_L k_M = f_H)
    (hNeChar : (ℓ : k_L) ≠ 0)
    (ζ : k_M) (hζ_ne : ζ ≠ 0) (hζ_pow : ζ ^ ℓ = 1)
    (hζ_prim : ∀ r : ℕ, 1 ≤ r → r < ℓ → ζ ^ r ≠ 1)
    (M_L : ℕ → Finset (Polynomial k_L))
    (hM_L_mem : ∀ (d : ℕ) (f : Polynomial k_L), f ∈ M_L d ↔ f.Monic ∧ f.natDegree = d)
    (M_M : ℕ → Finset (Polynomial k_M))
    (hM_M_mem : ∀ (d : ℕ) (f : Polynomial k_M), f ∈ M_M d ↔ f.Monic ∧ f.natDegree = d)
    (σ_M : ℕ → Polynomial k_M → Polynomial k_M) (𝒩_ℓ_M : Polynomial k_M → Polynomial k_M)
    (hσ_coeff : ∀ (m : ℕ) (P : Polynomial k_M) (n : ℕ),
      (σ_M m P).coeff n = (ζ⁻¹) ^ (m * P.natDegree) * (P.coeff n * (ζ ^ m) ^ n))
    (hσ_mem : ∀ (m d : ℕ) (P : Polynomial k_M), P ∈ M_M d → σ_M m P ∈ M_M d)
    (h𝒩_M_prop : ∀ (d : ℕ) (P : Polynomial k_M), P ∈ M_M d →
      𝒩_ℓ_M P ∈ M_M d ∧
      Polynomial.expand k_M ℓ (𝒩_ℓ_M P) = ∏ m ∈ Finset.range ℓ, σ_M m P ∧
      (-1 : k_M) ^ d * (𝒩_ℓ_M P).coeff 0 = ((-1 : k_M) ^ d * P.coeff 0) ^ ℓ)
    (h𝒩_M_one : 𝒩_ℓ_M 1 = 1)
    (h𝒩_M_mul : ∀ f g : Polynomial k_M, f.Monic → g.Monic → 𝒩_ℓ_M (f * g) = 𝒩_ℓ_M f * 𝒩_ℓ_M g)
    (h𝒩_M_nextCoeff : ∀ (c₀ : k_M) (H : Polynomial k_M), H ∈ M_M (ℓ - 1) →
      (𝒩_ℓ_M (Polynomial.X * H + Polynomial.C c₀)).nextCoeff =
        (𝒩_ℓ_M H).nextCoeff + (ℓ : k_M) * c₀) :
    ∃ (τ_L : k_M ≃ₐ[k_L] k_M) (𝒩_ℓ_L : Polynomial k_L → Polynomial k_L)
      (N_Γ : Polynomial k_M → Polynomial k_L),
      (∀ (s : ℕ) (y : k_M), (τ_L ^ s) y = y ^ ((Fintype.card k_L) ^ s)) ∧
      τ_L ^ f_H = 1 ∧
      (∀ Q : Polynomial k_M,
        Polynomial.map τ_L.toRingHom Q = Q ↔
          Q ∈ Set.range (Polynomial.map (algebraMap k_L k_M))) ∧
      (∀ (d m : ℕ) (Q : Polynomial k_M),
        Polynomial.map (τ_L ^ d).toRingHom (σ_M m Q) =
          σ_M (((Fintype.card k_L) ^ d * m) % ℓ) (Polynomial.map (τ_L ^ d).toRingHom Q)) ∧
      (∀ (d : ℕ) (Q : Polynomial k_M), Q.Monic →
        Polynomial.map (τ_L ^ d).toRingHom (𝒩_ℓ_M Q) =
          𝒩_ℓ_M (Polynomial.map (τ_L ^ d).toRingHom Q)) ∧
      (∀ P : Polynomial k_L, P.Monic →
        Polynomial.map (algebraMap k_L k_M) (𝒩_ℓ_L P) =
          𝒩_ℓ_M (Polynomial.map (algebraMap k_L k_M) P)) ∧
      (∀ (d : ℕ) (P : Polynomial k_L), P ∈ M_L d →
        𝒩_ℓ_L P ∈ M_L d ∧
        (-1 : k_L) ^ d * (𝒩_ℓ_L P).coeff 0 = ((-1 : k_L) ^ d * P.coeff 0) ^ ℓ) ∧
      𝒩_ℓ_L 1 = 1 ∧
      (∀ f g : Polynomial k_L, f.Monic → g.Monic → 𝒩_ℓ_L (f * g) = 𝒩_ℓ_L f * 𝒩_ℓ_L g) ∧
      (∀ (α : k_Lˣ →* (Ω F)ˣ) (ψ_k : AddChar k_L (Ω F)),
        (∑ P ∈ M_L ℓ,
          ((if h : (-1 : k_L) ^ (𝒩_ℓ_L P).natDegree * (𝒩_ℓ_L P).coeff 0 ≠ 0 then
              (α (Units.mk0 ((-1 : k_L) ^ (𝒩_ℓ_L P).natDegree * (𝒩_ℓ_L P).coeff 0) h) : Ω F)
            else 0) *
            ψ_k (-(𝒩_ℓ_L P).nextCoeff))) =
          (((α (Units.mk0 (ℓ : k_L) hNeChar))⁻¹) ^ ℓ : Ω F) *
            (∑ x : k_Lˣ, ((α ^ ℓ) x : Ω F) * ψ_k (x : k_L)) *
            (∑ H ∈ M_L (ℓ - 1), ψ_k (-(𝒩_ℓ_L H).nextCoeff))) ∧
      (∀ Q : Polynomial k_M, Q.Monic →
        Polynomial.map (algebraMap k_L k_M) (N_Γ Q) =
          ∏ s ∈ Finset.range f_H, Polynomial.map (τ_L ^ s).toRingHom Q) ∧
      (∀ (m : ℕ) (Q : Polynomial k_M), Q ∈ M_M m →
        N_Γ Q ∈ M_L (f_H * m) ∧
        (-1 : k_L) ^ (f_H * m) * (N_Γ Q).coeff 0 =
          Algebra.norm k_L ((-1 : k_M) ^ m * Q.coeff 0) ∧
        -(N_Γ Q).nextCoeff = Algebra.trace k_L k_M (-Q.nextCoeff) ∧
        N_Γ (𝒩_ℓ_M Q) = 𝒩_ℓ_L (N_Γ Q)) :=
by
  have h_s1 : ∃ (τ_L : k_M ≃ₐ[k_L] k_M),
      (∀ (s : ℕ) (y : k_M), (τ_L ^ s) y = y ^ ((Fintype.card k_L) ^ s)) ∧
      τ_L ^ f_H = 1 ∧
      (∀ Q : Polynomial k_M,
        Polynomial.map τ_L.toRingHom Q = Q ↔
          Q ∈ Set.range (Polynomial.map (algebraMap k_L k_M))) ∧
      (∀ (d m : ℕ) (Q : Polynomial k_M),
        Polynomial.map (τ_L ^ d).toRingHom (σ_M m Q) =
          σ_M (((Fintype.card k_L) ^ d * m) % ℓ) (Polynomial.map (τ_L ^ d).toRingHom Q)) ∧
      (∀ (d : ℕ) (Q : Polynomial k_M), Q.Monic →
        Polynomial.map (τ_L ^ d).toRingHom (𝒩_ℓ_M Q) =
          𝒩_ℓ_M (Polynomial.map (τ_L ^ d).toRingHom Q)) := by
    haveI : Module.Finite k_L k_M := Module.Finite.of_finite
    haveI : Algebra.IsAlgebraic k_L k_M := Algebra.IsAlgebraic.of_finite k_L k_M
    let τ_L : k_M ≃ₐ[k_L] k_M := FiniteField.frobeniusAlgEquivOfAlgebraic k_L k_M
    set ι := algebraMap k_L k_M
    set q_L := Fintype.card k_L
    have hqL_gt1 : 1 < q_L := Fintype.one_lt_card
    have hτ_pow : ∀ (s : ℕ) (y : k_M), (τ_L ^ s) y = y ^ (q_L ^ s) := by
      intro s
      induction' s with s ih
      · intro y
        rw [pow_zero, pow_zero, pow_one, AlgEquiv.one_apply]
      · intro y
        rw [pow_succ', AlgEquiv.mul_apply, ih y]
        change FiniteField.frobeniusAlgEquivOfAlgebraic k_L k_M (y ^ (q_L ^ s)) = _
        rw [FiniteField.frobeniusAlgEquivOfAlgebraic_apply, ← pow_mul, ← pow_succ]
    have hτ_pow_fH : τ_L ^ f_H = 1 := by
      ext y
      rw [hτ_pow f_H y, ← hfinrank, ← Module.card_eq_pow_finrank (K := k_L) (V := k_M),
        FiniteField.pow_card y, AlgEquiv.one_apply]
    have hτ_scalar_fix : ∀ y : k_M, τ_L y = y ↔ y ∈ Set.range ι := by
      let S_L : Finset k_M := Finset.univ.image ι
      let S_fix : Finset k_M := Finset.univ.filter (fun y : k_M => τ_L y = y)
      have hSL_sub : S_L ⊆ S_fix := by
        intro y hy
        rcases Finset.mem_image.mp hy with ⟨x, _, rfl⟩
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, τ_L.commutes x⟩
      have hSL_card : S_L.card = q_L := by
        rw [Finset.card_image_of_injective _ ι.injective, Finset.card_univ]
      let F_frob : Polynomial k_M := Polynomial.X ^ q_L - Polynomial.X
      have hF_deg : F_frob.natDegree = q_L := by
        dsimp [F_frob]
        rw [Polynomial.natDegree_sub_eq_left_of_natDegree_lt]
        · exact Polynomial.natDegree_X_pow q_L
        · rw [Polynomial.natDegree_X_pow, Polynomial.natDegree_X]
          exact hqL_gt1
      have hF_ne0 : F_frob ≠ 0 := by
        intro h0
        have h1 : F_frob.natDegree = 0 := by rw [h0, Polynomial.natDegree_zero]
        omega
      have hSfix_sub_roots : S_fix.val ≤ F_frob.roots := by
        rw [Multiset.le_iff_subset S_fix.nodup]
        intro y hy
        have hy_fix : τ_L y = y := (Finset.mem_filter.mp hy).2
        have hy_pow : y ^ q_L = y := by
          have h1 := hτ_pow 1 y
          rw [pow_one, pow_one] at h1
          exact h1.symm.trans hy_fix
        rw [Polynomial.mem_roots hF_ne0, Polynomial.IsRoot.def]
        dsimp [F_frob]
        rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, hy_pow, sub_self]
      have hSfix_card_le : S_fix.card ≤ S_L.card := by
        rw [hSL_card]
        calc S_fix.card = S_fix.val.card := rfl
          _ ≤ F_frob.roots.card := Multiset.card_le_card hSfix_sub_roots
          _ ≤ F_frob.natDegree := Polynomial.card_roots' F_frob
          _ = q_L := hF_deg
      have hS_eq : S_L = S_fix := Finset.eq_of_subset_of_card_le hSL_sub hSfix_card_le
      intro y
      have h1 : (τ_L y = y) ↔ y ∈ S_fix := by
        simp [S_fix]
      have h2 : y ∈ S_L ↔ y ∈ Set.range ι := by
        simp [S_L]
      rw [h1, ← hS_eq, h2]
    have hτ_poly_fix : ∀ Q : Polynomial k_M,
        Polynomial.map τ_L.toRingHom Q = Q ↔
          Q ∈ Set.range (Polynomial.map ι) := by
      intro Q
      constructor
      · intro hQ
        have h_coeff : ∀ n : ℕ, ∃ a : k_L, ι a = Q.coeff n := by
          intro n
          apply (hτ_scalar_fix (Q.coeff n)).mp
          have hc : (Polynomial.map τ_L.toRingHom Q).coeff n = Q.coeff n := by rw [hQ]
          rwa [Polynomial.coeff_map] at hc
        let P : Polynomial k_L :=
          ∑ n ∈ Q.support, Polynomial.monomial n (h_coeff n).choose
        refine ⟨P, ?_⟩
        ext n
        rw [Polynomial.coeff_map, Polynomial.finset_sum_coeff]
        have h_sum : (∑ i ∈ Q.support, (Polynomial.monomial i (h_coeff i).choose).coeff n) =
            if n ∈ Q.support then (h_coeff n).choose else 0 := by
          simp_rw [Polynomial.coeff_monomial]
          simp
        rw [h_sum]
        by_cases hn : n ∈ Q.support
        · rw [if_pos hn, (h_coeff n).choose_spec]
        · have h0 : Q.coeff n = 0 := by
            simpa [Polynomial.mem_support_iff] using hn
          rw [if_neg hn, map_zero, h0]
      · rintro ⟨P, rfl⟩
        rw [Polynomial.map_map]
        have h_comp : τ_L.toRingHom.comp ι = ι := by
          ext x
          exact τ_L.commutes x
        rw [h_comp]
    have h_pow_mod : ∀ (x : k_M), x ^ ℓ = 1 → ∀ (N : ℕ), x ^ N = x ^ (N % ℓ) := by
      intro x hx N
      conv_lhs => rw [← Nat.div_add_mod N ℓ]
      rw [pow_add, pow_mul, hx, one_pow, one_mul]
    have hζ_inv_pow : (ζ⁻¹) ^ ℓ = 1 := by
      rw [inv_pow, hζ_pow, inv_one]
    have hτ_σ_comm : ∀ (d m : ℕ) (Q : Polynomial k_M),
        Polynomial.map (τ_L ^ d).toRingHom (σ_M m Q) =
          σ_M ((q_L ^ d * m) % ℓ) (Polynomial.map (τ_L ^ d).toRingHom Q) := by
      intro d m Q
      set Q_d := Polynomial.map (τ_L ^ d).toRingHom Q
      have hQd_deg : Q_d.natDegree = Q.natDegree :=
        Polynomial.natDegree_map_eq_of_injective (τ_L ^ d).injective Q
      ext n
      rw [Polynomial.coeff_map, hσ_coeff m Q n, hσ_coeff ((q_L ^ d * m) % ℓ) Q_d n,
        hQd_deg, Polynomial.coeff_map]
      change (τ_L ^ d) ((ζ⁻¹) ^ (m * Q.natDegree) * (Q.coeff n * (ζ ^ m) ^ n)) =
        (ζ⁻¹) ^ (((q_L ^ d * m) % ℓ) * Q.natDegree) *
          ((τ_L ^ d) (Q.coeff n) * (ζ ^ ((q_L ^ d * m) % ℓ)) ^ n)
      rw [map_mul, map_mul, map_pow, map_pow, map_pow, hτ_pow d (ζ⁻¹), hτ_pow d ζ,
        ← pow_mul, ← mul_assoc (q_L ^ d) m Q.natDegree, ← pow_mul ζ (q_L ^ d) m]
      congr 1
      · rw [h_pow_mod (ζ⁻¹) hζ_inv_pow (q_L ^ d * m * Q.natDegree),
          h_pow_mod (ζ⁻¹) hζ_inv_pow (((q_L ^ d * m) % ℓ) * Q.natDegree)]
        congr 1
        rw [Nat.mul_mod ((q_L ^ d * m) % ℓ), Nat.mod_mod, ← Nat.mul_mod]
      · congr 1
        rw [h_pow_mod ζ hζ_pow (q_L ^ d * m)]
    have hτ_N_comm : ∀ (d : ℕ) (Q : Polynomial k_M), Q.Monic →
        Polynomial.map (τ_L ^ d).toRingHom (𝒩_ℓ_M Q) =
          𝒩_ℓ_M (Polynomial.map (τ_L ^ d).toRingHom Q) := by
      have h_not_dvd : ∀ d : ℕ, ¬ (ℓ ∣ q_L ^ d) := by
        intro d ⟨k, hk⟩
        have h1 : (τ_L ^ d) ζ = (τ_L ^ d) 1 := by
          rw [hτ_pow d ζ, hk, pow_mul, hζ_pow, one_pow, map_one]
        have hζ1 : ζ ^ 1 = 1 := by
          rw [pow_one]
          exact (τ_L ^ d).injective h1
        exact hζ_prim 1 le_rfl hPrime.one_lt hζ1
      intro d Q hQ
      set D := Q.natDegree
      set Q_d := Polynomial.map (τ_L ^ d).toRingHom Q
      have hQ_mem : Q ∈ M_M D := (hM_M_mem D Q).mpr ⟨hQ, rfl⟩
      have hQd_mon : Q_d.Monic := hQ.map (τ_L ^ d).toRingHom
      have hQd_deg : Q_d.natDegree = D :=
        Polynomial.natDegree_map_eq_of_injective (τ_L ^ d).injective Q
      have hQd_mem : Q_d ∈ M_M D := (hM_M_mem D Q_d).mpr ⟨hQd_mon, hQd_deg⟩
      have h_cop : ℓ.gcd (q_L ^ d) = 1 :=
        hPrime.coprime_iff_not_dvd.mpr (h_not_dvd d)
      let g : ℕ → ℕ := fun m => (q_L ^ d * m) % ℓ
      have hg_inj : Set.InjOn g (Finset.range ℓ) := by
        intro m₁ hm₁ m₂ hm₂ h_eq
        dsimp [g] at h_eq
        rw [Finset.mem_coe, Finset.mem_range] at hm₁ hm₂
        have h_mod : q_L ^ d * m₁ ≡ q_L ^ d * m₂ [MOD ℓ] := h_eq
        have h_mod' : m₁ ≡ m₂ [MOD ℓ] := Nat.ModEq.cancel_left_of_coprime h_cop h_mod
        exact Nat.ModEq.eq_of_lt_of_lt h_mod' hm₁ hm₂
      have hg_sub : (Finset.range ℓ).image g ⊆ Finset.range ℓ := by
        intro y hy
        rcases Finset.mem_image.mp hy with ⟨m, _, rfl⟩
        exact Finset.mem_range.mpr (Nat.mod_lt _ hPrime.pos)
      have hg_card : (Finset.range ℓ).card ≤ ((Finset.range ℓ).image g).card := by
        rw [Finset.card_image_of_injOn hg_inj]
      have hg_im : (Finset.range ℓ).image g = Finset.range ℓ :=
        Finset.eq_of_subset_of_card_le hg_sub hg_card
      apply Polynomial.expand_injective hPrime.pos (R := k_M)
      rw [← Polynomial.map_expand, (h𝒩_M_prop D Q hQ_mem).2.1, Polynomial.map_prod]
      have h_prod_step : (∏ m ∈ Finset.range ℓ, Polynomial.map (τ_L ^ d).toRingHom (σ_M m Q)) =
          ∏ m ∈ Finset.range ℓ, σ_M (g m) Q_d := by
        apply Finset.prod_congr rfl
        intro m _
        exact hτ_σ_comm d m Q
      have h_img_prod : (∏ m ∈ (Finset.range ℓ).image g, σ_M m Q_d) =
          ∏ m ∈ Finset.range ℓ, σ_M (g m) Q_d :=
        Finset.prod_image hg_inj
      rw [h_prod_step, ← h_img_prod, hg_im, ← (h𝒩_M_prop D Q_d hQd_mem).2.1]
    exact ⟨τ_L, hτ_pow, hτ_pow_fH, hτ_poly_fix, hτ_σ_comm, hτ_N_comm⟩
  obtain ⟨τ_L, hτ_pow, hτ_pow_fH, hτ_poly_fix, hτ_σ_comm, hτ_N_comm⟩ := h_s1
  
  have h_s2 : ∃ (𝒩_ℓ_L : Polynomial k_L → Polynomial k_L),
      (∀ P : Polynomial k_L, P.Monic →
        Polynomial.map (algebraMap k_L k_M) (𝒩_ℓ_L P) =
          𝒩_ℓ_M (Polynomial.map (algebraMap k_L k_M) P)) ∧
      (∀ (d : ℕ) (P : Polynomial k_L), P ∈ M_L d →
        𝒩_ℓ_L P ∈ M_L d ∧
        (-1 : k_L) ^ d * (𝒩_ℓ_L P).coeff 0 = ((-1 : k_L) ^ d * P.coeff 0) ^ ℓ) ∧
      𝒩_ℓ_L 1 = 1 ∧
      (∀ f g : Polynomial k_L, f.Monic → g.Monic → 𝒩_ℓ_L (f * g) = 𝒩_ℓ_L f * 𝒩_ℓ_L g) ∧
      (∀ (α : k_Lˣ →* (Ω F)ˣ) (ψ_k : AddChar k_L (Ω F)),
        (∑ P ∈ M_L ℓ,
          ((if h : (-1 : k_L) ^ (𝒩_ℓ_L P).natDegree * (𝒩_ℓ_L P).coeff 0 ≠ 0 then
              (α (Units.mk0 ((-1 : k_L) ^ (𝒩_ℓ_L P).natDegree * (𝒩_ℓ_L P).coeff 0) h) : Ω F)
            else 0) *
            ψ_k (-(𝒩_ℓ_L P).nextCoeff))) =
          (((α (Units.mk0 (ℓ : k_L) hNeChar))⁻¹) ^ ℓ : Ω F) *
            (∑ x : k_Lˣ, ((α ^ ℓ) x : Ω F) * ψ_k (x : k_L)) *
            (∑ H ∈ M_L (ℓ - 1), ψ_k (-(𝒩_ℓ_L H).nextCoeff))) := by
    set ι := algebraMap k_L k_M
    have hι_inj : Function.Injective ι := ι.injective
    have hmap_inj : Function.Injective (Polynomial.map ι) := Polynomial.map_injective ι hι_inj
    let 𝒩_ℓ_L : Polynomial k_L → Polynomial k_L := fun P =>
      if h : 𝒩_ℓ_M (Polynomial.map ι P) ∈ Set.range (Polynomial.map ι) then h.choose else 1
    have h𝒩_L_map : ∀ P : Polynomial k_L, P.Monic →
        Polynomial.map ι (𝒩_ℓ_L P) = 𝒩_ℓ_M (Polynomial.map ι P) := by
      intro P hP
      have hP_map_mon : (Polynomial.map ι P).Monic := hP.map ι
      have hP_fix : Polynomial.map τ_L.toRingHom (Polynomial.map ι P) = Polynomial.map ι P :=
        (hτ_poly_fix (Polynomial.map ι P)).mpr ⟨P, rfl⟩
      have hN_fix : Polynomial.map τ_L.toRingHom (𝒩_ℓ_M (Polynomial.map ι P)) =
          𝒩_ℓ_M (Polynomial.map ι P) := by
        have h1 := hτ_N_comm 1 (Polynomial.map ι P) hP_map_mon
        rwa [pow_one, hP_fix] at h1
      have h_mem : 𝒩_ℓ_M (Polynomial.map ι P) ∈ Set.range (Polynomial.map ι) :=
        (hτ_poly_fix (𝒩_ℓ_M (Polynomial.map ι P))).mp hN_fix
      dsimp [𝒩_ℓ_L]
      rw [dif_pos h_mem]
      exact h_mem.choose_spec
    have h𝒩_L_prop : ∀ (d : ℕ) (P : Polynomial k_L), P ∈ M_L d →
        𝒩_ℓ_L P ∈ M_L d ∧
        (-1 : k_L) ^ d * (𝒩_ℓ_L P).coeff 0 = ((-1 : k_L) ^ d * P.coeff 0) ^ ℓ := by
      intro d P hP
      obtain ⟨hP_mon, hP_deg⟩ := (hM_L_mem d P).mp hP
      have hP_M : Polynomial.map ι P ∈ M_M d := by
        rw [hM_M_mem]
        exact ⟨hP_mon.map ι, (Polynomial.natDegree_map_eq_of_injective hι_inj P).trans hP_deg⟩
      obtain ⟨hNP_M, _, hNP_c0_M⟩ := h𝒩_M_prop d (Polynomial.map ι P) hP_M
      rw [← h𝒩_L_map P hP_mon] at hNP_M hNP_c0_M
      obtain ⟨hNP_map_mon, hNP_map_deg⟩ := (hM_M_mem d (Polynomial.map ι (𝒩_ℓ_L P))).mp hNP_M
      have hNP_deg : (𝒩_ℓ_L P).natDegree = d := by
        rw [← Polynomial.natDegree_map_eq_of_injective hι_inj (𝒩_ℓ_L P), hNP_map_deg]
      have hNP_mon : (𝒩_ℓ_L P).Monic := by
        rw [Polynomial.Monic.def]
        apply hι_inj
        rw [← Polynomial.leadingCoeff_map_of_injective hι_inj (𝒩_ℓ_L P),
          hNP_map_mon.leadingCoeff, map_one]
      have hNP_c0 : (-1 : k_L) ^ d * (𝒩_ℓ_L P).coeff 0 = ((-1 : k_L) ^ d * P.coeff 0) ^ ℓ := by
        apply hι_inj
        rw [map_mul, map_pow, map_neg, map_one, ← Polynomial.coeff_map, hNP_c0_M,
          Polynomial.coeff_map, map_pow, map_mul, map_pow, map_neg, map_one]
      exact ⟨(hM_L_mem d (𝒩_ℓ_L P)).mpr ⟨hNP_mon, hNP_deg⟩, hNP_c0⟩
    have h𝒩_L_one : 𝒩_ℓ_L 1 = 1 := by
      apply hmap_inj
      rw [h𝒩_L_map 1 Polynomial.monic_one, Polynomial.map_one, h𝒩_M_one]
    have h𝒩_L_mul : ∀ f g : Polynomial k_L, f.Monic → g.Monic → 𝒩_ℓ_L (f * g) = 𝒩_ℓ_L f * 𝒩_ℓ_L g := by
      intro f g hf hg
      apply hmap_inj
      rw [h𝒩_L_map (f * g) (hf.mul hg), Polynomial.map_mul, Polynomial.map_mul,
        h𝒩_M_mul (Polynomial.map ι f) (Polynomial.map ι g) (hf.map ι) (hg.map ι),
        ← h𝒩_L_map f hf, ← h𝒩_L_map g hg]
    have h𝒩_L_deg_ell : ∀ (α : k_Lˣ →* (Ω F)ˣ) (ψ_k : AddChar k_L (Ω F)),
        (∑ P ∈ M_L ℓ,
          ((if h : (-1 : k_L) ^ (𝒩_ℓ_L P).natDegree * (𝒩_ℓ_L P).coeff 0 ≠ 0 then
              (α (Units.mk0 ((-1 : k_L) ^ (𝒩_ℓ_L P).natDegree * (𝒩_ℓ_L P).coeff 0) h) : Ω F)
            else 0) *
            ψ_k (-(𝒩_ℓ_L P).nextCoeff))) =
          (((α (Units.mk0 (ℓ : k_L) hNeChar))⁻¹) ^ ℓ : Ω F) *
            (∑ x : k_Lˣ, ((α ^ ℓ) x : Ω F) * ψ_k (x : k_L)) *
            (∑ H ∈ M_L (ℓ - 1), ψ_k (-(𝒩_ℓ_L H).nextCoeff)) := by
      have hℓ1 : 1 ≤ ℓ := hPrime.pos
      have hΨ_mem : ∀ (c₀ : k_L) (H : Polynomial k_L), H ∈ M_L (ℓ - 1) →
          Polynomial.X * H + Polynomial.C c₀ ∈ M_L ℓ ∧
          (Polynomial.X * H + Polynomial.C c₀).coeff 0 = c₀ ∧
          (Polynomial.X * H + Polynomial.C c₀).divX = H := by
        intro c₀ H hH
        obtain ⟨hH_mon, hH_deg⟩ := (hM_L_mem (ℓ - 1) H).mp hH
        have hXH_mon : (Polynomial.X * H).Monic := Polynomial.monic_X.mul hH_mon
        have hXH_deg : (Polynomial.X * H).natDegree = ℓ := by
          rw [Polynomial.monic_X.natDegree_mul hH_mon, Polynomial.natDegree_X, hH_deg,
            Nat.add_sub_of_le hℓ1]
        have hP_deg : (Polynomial.X * H + Polynomial.C c₀).natDegree = ℓ := by
          rw [Polynomial.natDegree_add_eq_left_of_natDegree_lt]
          · exact hXH_deg
          · rw [hXH_deg, Polynomial.natDegree_C]
            exact hℓ1
        have hP_mon : (Polynomial.X * H + Polynomial.C c₀).Monic := by
          rw [Polynomial.Monic.def, Polynomial.leadingCoeff, hP_deg, Polynomial.coeff_add,
            ← hXH_deg, ← Polynomial.leadingCoeff, hXH_mon.leadingCoeff, hXH_deg,
            Polynomial.coeff_C, if_neg hPrime.ne_zero, add_zero]
        have hc0 : (Polynomial.X * H + Polynomial.C c₀).coeff 0 = c₀ := by
          rw [Polynomial.coeff_add, Polynomial.coeff_X_mul_zero, Polynomial.coeff_C_zero, zero_add]
        have hdivX : (Polynomial.X * H + Polynomial.C c₀).divX = H := by
          ext n
          rw [Polynomial.coeff_divX, Polynomial.coeff_add, Polynomial.coeff_X_mul,
            Polynomial.coeff_C, if_neg (Nat.succ_ne_zero n), add_zero]
        exact ⟨(hM_L_mem ℓ _).mpr ⟨hP_mon, hP_deg⟩, hc0, hdivX⟩
      have h_divX_mem : ∀ P ∈ M_L ℓ, P.divX ∈ M_L (ℓ - 1) := by
        intro P hP
        obtain ⟨hP_mon, hP_deg⟩ := (hM_L_mem ℓ P).mp hP
        have h_deg : P.divX.natDegree = ℓ - 1 := by
          rw [Polynomial.natDegree_divX_eq_natDegree_tsub_one, hP_deg]
        have h_mon : P.divX.Monic := by
          rw [Polynomial.Monic.def, Polynomial.leadingCoeff, h_deg, Polynomial.coeff_divX,
            Nat.sub_add_cancel hℓ1, ← hP_deg, ← Polynomial.leadingCoeff, hP_mon.leadingCoeff]
        exact (hM_L_mem (ℓ - 1) P.divX).mpr ⟨h_mon, h_deg⟩
      have h_nextCoeff_L : ∀ (c₀ : k_L) (H : Polynomial k_L), H ∈ M_L (ℓ - 1) →
          (𝒩_ℓ_L (Polynomial.X * H + Polynomial.C c₀)).nextCoeff =
            (𝒩_ℓ_L H).nextCoeff + (ℓ : k_L) * c₀ := by
        intro c₀ H hH
        obtain ⟨hH_mon, hH_deg⟩ := (hM_L_mem (ℓ - 1) H).mp hH
        have hP_mon : (Polynomial.X * H + Polynomial.C c₀).Monic :=
          ((hM_L_mem ℓ _).mp (hΨ_mem c₀ H hH).1).1
        have hH_M : Polynomial.map ι H ∈ M_M (ℓ - 1) := by
          rw [hM_M_mem]
          exact ⟨hH_mon.map ι, (Polynomial.natDegree_map_eq_of_injective hι_inj H).trans hH_deg⟩
        apply hι_inj
        rw [← Polynomial.nextCoeff_map hι_inj, h𝒩_L_map _ hP_mon,
          Polynomial.map_add, Polynomial.map_mul, Polynomial.map_X, Polynomial.map_C,
          h𝒩_M_nextCoeff (ι c₀) (Polynomial.map ι H) hH_M,
          ← h𝒩_L_map H hH_mon, Polynomial.nextCoeff_map hι_inj,
          map_add, map_mul, map_natCast]
      intro α ψ_k
      let term : Polynomial k_L → Ω F := fun P =>
        (if h : (-1 : k_L) ^ (𝒩_ℓ_L P).natDegree * (𝒩_ℓ_L P).coeff 0 ≠ 0 then
          (α (Units.mk0 ((-1 : k_L) ^ (𝒩_ℓ_L P).natDegree * (𝒩_ℓ_L P).coeff 0) h) : Ω F)
        else 0) * ψ_k (-(𝒩_ℓ_L P).nextCoeff)
      change (∑ P ∈ M_L ℓ, term P) = _
      have h_bij_M : (∑ P ∈ M_L ℓ, term P) =
          ∑ p ∈ (Finset.univ : Finset k_L) ×ˢ M_L (ℓ - 1),
            term (Polynomial.X * p.2 + Polynomial.C p.1) := by
        symm
        refine Finset.sum_bij (fun p _ => Polynomial.X * p.2 + Polynomial.C p.1) ?_ ?_ ?_ ?_
        · intro p hp
          rw [Finset.mem_product] at hp
          exact (hΨ_mem p.1 p.2 hp.2).1
        · intro p₁ hp₁ p₂ hp₂ h_eq
          dsimp only at h_eq
          rw [Finset.mem_product] at hp₁ hp₂
          have hc1 := (hΨ_mem p₁.1 p₁.2 hp₁.2).2.1
          have hd1 := (hΨ_mem p₁.1 p₁.2 hp₁.2).2.2
          have hc2 := (hΨ_mem p₂.1 p₂.2 hp₂.2).2.1
          have hd2 := (hΨ_mem p₂.1 p₂.2 hp₂.2).2.2
          refine Prod.ext ?_ ?_
          · rw [← hc1, ← hc2, h_eq]
          · rw [← hd1, ← hd2, h_eq]
        · intro P hP
          refine ⟨(P.coeff 0, P.divX), Finset.mem_product.mpr ⟨Finset.mem_univ _, h_divX_mem P hP⟩, ?_⟩
          exact Polynomial.X_mul_divX_add P
        · intro p _
          rfl
      rw [h_bij_M, Finset.sum_product]
      let c0_term : k_L → Ω F := fun c₀ =>
        (if h : (-c₀) ^ ℓ ≠ 0 then
          (α (Units.mk0 ((-c₀) ^ ℓ) h) : Ω F)
        else 0) * ψ_k (-((ℓ : k_L) * c₀))
      have h_term_split : ∀ (c₀ : k_L) (H : Polynomial k_L), H ∈ M_L (ℓ - 1) →
          term (Polynomial.X * H + Polynomial.C c₀) =
            c0_term c₀ * ψ_k (-(𝒩_ℓ_L H).nextCoeff) := by
        intro c₀ H hH
        dsimp [term, c0_term]
        set P := Polynomial.X * H + Polynomial.C c₀
        obtain ⟨hP_mem, hP_c0, _⟩ := hΨ_mem c₀ H hH
        obtain ⟨hNP_mem, hNP_c0⟩ := h𝒩_L_prop ℓ P hP_mem
        obtain ⟨_, hNP_deg⟩ := (hM_L_mem ℓ (𝒩_ℓ_L P)).mp hNP_mem
        have h_sign : (-1 : k_L) ^ (𝒩_ℓ_L P).natDegree * (𝒩_ℓ_L P).coeff 0 = (-c₀) ^ ℓ := by
          rw [hNP_deg, hNP_c0, hP_c0]
          have h_neg : (-1 : k_L) ^ ℓ * c₀ = (-1 : k_L) ^ (ℓ + 1) * (-c₀) := by
            rw [pow_succ, mul_assoc, neg_one_mul, neg_neg]
          rw [h_neg, mul_pow, ← pow_mul, mul_comm (ℓ + 1) ℓ,
            (Nat.even_mul_succ_self ℓ).neg_one_pow, one_mul]
        have h_if : (if h : (-1 : k_L) ^ (𝒩_ℓ_L P).natDegree * (𝒩_ℓ_L P).coeff 0 ≠ 0 then
            (α (Units.mk0 ((-1 : k_L) ^ (𝒩_ℓ_L P).natDegree * (𝒩_ℓ_L P).coeff 0) h) : Ω F)
          else 0) =
          (if h : (-c₀) ^ ℓ ≠ 0 then (α (Units.mk0 ((-c₀) ^ ℓ) h) : Ω F) else 0) := by
          by_cases hc : (-c₀) ^ ℓ = 0
          · have hc' : (-1 : k_L) ^ (𝒩_ℓ_L P).natDegree * (𝒩_ℓ_L P).coeff 0 = 0 := h_sign.trans hc
            rw [dif_neg (not_not.mpr hc'), dif_neg (not_not.mpr hc)]
          · have hc' : (-1 : k_L) ^ (𝒩_ℓ_L P).natDegree * (𝒩_ℓ_L P).coeff 0 ≠ 0 := by rwa [h_sign]
            rw [dif_pos hc', dif_pos hc]
            congr 2
            ext
            exact h_sign
        rw [h_if, h_nextCoeff_L c₀ H hH, neg_add, AddChar.map_add_eq_mul]
        ring
      have h_sum_factor : (∑ c₀ : k_L, ∑ H ∈ M_L (ℓ - 1), term (Polynomial.X * H + Polynomial.C c₀)) =
          (∑ c₀ : k_L, c0_term c₀) * (∑ H ∈ M_L (ℓ - 1), ψ_k (-(𝒩_ℓ_L H).nextCoeff)) := by
        rw [Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro c₀ _
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro H hH
        exact h_term_split c₀ H hH
      rw [h_sum_factor]
      congr 1
      have h_c0_zero : c0_term 0 = 0 := by
        dsimp [c0_term]
        have h0 : (-(0 : k_L)) ^ ℓ = 0 := by rw [neg_zero, zero_pow hPrime.ne_zero]
        rw [dif_neg (not_not.mpr h0), zero_mul]
      rw [← Finset.sum_erase_add Finset.univ c0_term (Finset.mem_univ (0 : k_L)), h_c0_zero, add_zero]
      set u_ℓ : k_Lˣ := Units.mk0 (ℓ : k_L) hNeChar
      have h_c0_bij : (∑ c₀ ∈ Finset.univ.erase (0 : k_L), c0_term c₀) =
          ∑ x : k_Lˣ, (((α u_ℓ)⁻¹) ^ ℓ : Ω F) * (((α ^ ℓ) x : Ω F) * ψ_k (x : k_L)) := by
        symm
        refine Finset.sum_bij (fun (x : k_Lˣ) _ => -(((u_ℓ⁻¹ * x : k_Lˣ) : k_L))) ?_ ?_ ?_ ?_
        · intro x _
          exact Finset.mem_erase.mpr ⟨neg_ne_zero.mpr (Units.ne_zero _), Finset.mem_univ _⟩
        · intro x₁ _ x₂ _ h_eq
          dsimp only at h_eq
          have h1 : ((u_ℓ⁻¹ * x₁ : k_Lˣ) : k_L) = ((u_ℓ⁻¹ * x₂ : k_Lˣ) : k_L) := neg_injective h_eq
          exact mul_left_cancel (Units.ext h1)
        · intro c₀ hc₀
          have hc₀_ne : c₀ ≠ 0 := (Finset.mem_erase.mp hc₀).1
          refine ⟨u_ℓ * Units.mk0 (-c₀) (neg_ne_zero.mpr hc₀_ne), Finset.mem_univ _, ?_⟩
          dsimp only
          rw [inv_mul_cancel_left, Units.val_mk0, neg_neg]
        · intro x _
          dsimp only [c0_term]
          rw [neg_neg]
          have h_nz : (((u_ℓ⁻¹ * x : k_Lˣ) : k_L)) ^ ℓ ≠ 0 :=
            pow_ne_zero ℓ (Units.ne_zero _)
          rw [dif_pos h_nz]
          have h_unit_eq : Units.mk0 ((((u_ℓ⁻¹ * x : k_Lˣ) : k_L)) ^ ℓ) h_nz = (u_ℓ⁻¹ * x) ^ ℓ := by
            ext
            simp
          have h_val_eq : -((ℓ : k_L) * -(((u_ℓ⁻¹ * x : k_Lˣ) : k_L))) = (x : k_L) := by
            have h_u : (ℓ : k_L) * ((u_ℓ⁻¹ : k_Lˣ) : k_L) = 1 := u_ℓ.mul_inv
            calc -((ℓ : k_L) * -(((u_ℓ⁻¹ * x : k_Lˣ) : k_L)))
                = (ℓ : k_L) * (((u_ℓ⁻¹ : k_Lˣ) : k_L) * (x : k_L)) := by simp [Units.val_mul]
              _ = ((ℓ : k_L) * ((u_ℓ⁻¹ : k_Lˣ) : k_L)) * (x : k_L) := by ring
              _ = (x : k_L) := by rw [h_u, one_mul]
          have h_α_eq : (α ((u_ℓ⁻¹ * x) ^ ℓ) : Ω F) =
              (((α u_ℓ)⁻¹) ^ ℓ : Ω F) * ((α ^ ℓ) x : Ω F) := by
            rw [map_pow, map_mul, map_inv, mul_pow, Units.val_mul, MonoidHom.pow_apply,
              Units.val_pow_eq_pow_val]
          rw [h_unit_eq, h_val_eq, h_α_eq, mul_assoc]
      rw [h_c0_bij, ← Finset.mul_sum]
    exact ⟨𝒩_ℓ_L, h𝒩_L_map, h𝒩_L_prop, h𝒩_L_one, h𝒩_L_mul, h𝒩_L_deg_ell⟩
  obtain ⟨𝒩_ℓ_L, h𝒩_L_map, h𝒩_L_prop, h𝒩_L_one, h𝒩_L_mul, h𝒩_L_deg_ell⟩ := h_s2
  
  have h_s3 : ∃ (N_Γ : Polynomial k_M → Polynomial k_L),
      (∀ Q : Polynomial k_M, Q.Monic →
        Polynomial.map (algebraMap k_L k_M) (N_Γ Q) =
          ∏ s ∈ Finset.range f_H, Polynomial.map (τ_L ^ s).toRingHom Q) ∧
      (∀ (m : ℕ) (Q : Polynomial k_M), Q ∈ M_M m →
        N_Γ Q ∈ M_L (f_H * m) ∧
        (-1 : k_L) ^ (f_H * m) * (N_Γ Q).coeff 0 =
          Algebra.norm k_L ((-1 : k_M) ^ m * Q.coeff 0) ∧
        -(N_Γ Q).nextCoeff = Algebra.trace k_L k_M (-Q.nextCoeff) ∧
        N_Γ (𝒩_ℓ_M Q) = 𝒩_ℓ_L (N_Γ Q)) := by
    set ι := algebraMap k_L k_M
    have hι_inj : Function.Injective ι := ι.injective
    have hmap_inj : Function.Injective (Polynomial.map ι) := Polynomial.map_injective ι hι_inj
    let Φ : Polynomial k_M → Polynomial k_M := fun Q =>
      ∏ s ∈ Finset.range f_H, Polynomial.map (τ_L ^ s).toRingHom Q
    have hΦ_fix : ∀ Q : Polynomial k_M, Polynomial.map τ_L.toRingHom (Φ Q) = Φ Q := by
      intro Q
      dsimp only [Φ]
      rw [Polynomial.map_prod]
      have h_step : ∀ s ∈ Finset.range f_H,
          Polynomial.map τ_L.toRingHom (Polynomial.map (τ_L ^ s).toRingHom Q) =
            Polynomial.map (τ_L ^ (s + 1)).toRingHom Q := by
        intro s _
        rw [Polynomial.map_map]
        congr 1
        ext y
        rw [pow_succ']
        rfl
      rw [Finset.prod_congr rfl h_step]
      rcases f_H with _ | k
      · simp
      · rw [Finset.prod_range_succ, hτ_pow_fH, ← pow_zero τ_L,
          ← Finset.prod_range_succ' (fun s => Polynomial.map (τ_L ^ s).toRingHom Q) k]
    have hΦ_mem : ∀ Q : Polynomial k_M, Φ Q ∈ Set.range (Polynomial.map ι) :=
      fun Q => (hτ_poly_fix (Φ Q)).mp (hΦ_fix Q)
    let N_Γ : Polynomial k_M → Polynomial k_L := fun Q => (hΦ_mem Q).choose
    have hN_Gamma_all : ∀ Q : Polynomial k_M, Polynomial.map ι (N_Γ Q) = Φ Q :=
      fun Q => (hΦ_mem Q).choose_spec
    have hN_Gamma_map : ∀ Q : Polynomial k_M, Q.Monic →
        Polynomial.map ι (N_Γ Q) = ∏ s ∈ Finset.range f_H, Polynomial.map (τ_L ^ s).toRingHom Q :=
      fun Q _ => hN_Gamma_all Q
    have h𝒩_M_prod_frob : ∀ (S : Finset ℕ) (Q : Polynomial k_M), Q.Monic →
        𝒩_ℓ_M (∏ s ∈ S, Polynomial.map (τ_L ^ s).toRingHom Q) =
          ∏ s ∈ S, 𝒩_ℓ_M (Polynomial.map (τ_L ^ s).toRingHom Q) := by
      intro S Q hQ
      induction' S using Finset.induction_on with a T ha ih
      · rw [Finset.prod_empty, Finset.prod_empty, h𝒩_M_one]
      · rw [Finset.prod_insert ha, Finset.prod_insert ha]
        have h_mon_a : (Polynomial.map (τ_L ^ a).toRingHom Q).Monic := hQ.map _
        have h_mon_T : (∏ s ∈ T, Polynomial.map (τ_L ^ s).toRingHom Q).Monic :=
          Polynomial.monic_prod_of_monic T _ (fun s _ => hQ.map _)
        rw [h𝒩_M_mul _ _ h_mon_a h_mon_T, ih]
    have hN_Gamma_prop : ∀ (m : ℕ) (Q : Polynomial k_M), Q ∈ M_M m →
        N_Γ Q ∈ M_L (f_H * m) ∧
        (-1 : k_L) ^ (f_H * m) * (N_Γ Q).coeff 0 =
          Algebra.norm k_L ((-1 : k_M) ^ m * Q.coeff 0) ∧
        -(N_Γ Q).nextCoeff = Algebra.trace k_L k_M (-Q.nextCoeff) ∧
        N_Γ (𝒩_ℓ_M Q) = 𝒩_ℓ_L (N_Γ Q) := by
      intro m Q hQ
      obtain ⟨hQ_mon, hQ_deg⟩ := (hM_M_mem m Q).mp hQ
      have h_fac_mon : ∀ s ∈ Finset.range f_H, (Polynomial.map (τ_L ^ s).toRingHom Q).Monic :=
        fun s _ => hQ_mon.map _
      have h_fac_deg : ∀ s ∈ Finset.range f_H,
          (Polynomial.map (τ_L ^ s).toRingHom Q).natDegree = m := by
        intro s _
        rw [Polynomial.natDegree_map_eq_of_injective (τ_L ^ s).injective Q, hQ_deg]
      have hΦ_mon : (Φ Q).Monic := Polynomial.monic_prod_of_monic _ _ h_fac_mon
      have hΦ_deg : (Φ Q).natDegree = f_H * m := by
        dsimp only [Φ]
        rw [Polynomial.natDegree_prod_of_monic _ _ h_fac_mon,
          Finset.sum_congr rfl h_fac_deg, Finset.sum_const, Finset.card_range, smul_eq_mul]
      have hNG_deg : (N_Γ Q).natDegree = f_H * m := by
        rw [← Polynomial.natDegree_map_eq_of_injective hι_inj (N_Γ Q), hN_Gamma_all Q, hΦ_deg]
      have hNG_mon : (N_Γ Q).Monic := by
        rw [Polynomial.Monic.def]
        apply hι_inj
        rw [← Polynomial.leadingCoeff_map_of_injective hι_inj (N_Γ Q), hN_Gamma_all Q,
          hΦ_mon.leadingCoeff, map_one]
      have hNG_mem : N_Γ Q ∈ M_L (f_H * m) := (hM_L_mem (f_H * m) (N_Γ Q)).mpr ⟨hNG_mon, hNG_deg⟩
      have hNG_c0 : (-1 : k_L) ^ (f_H * m) * (N_Γ Q).coeff 0 =
          Algebra.norm k_L ((-1 : k_M) ^ m * Q.coeff 0) := by
        apply hι_inj
        rw [map_mul, map_pow, map_neg, map_one, ← Polynomial.coeff_map, hN_Gamma_all Q]
        dsimp only [Φ]
        rw [Polynomial.coeff_zero_prod]
        have h_sign_prod : (-1 : k_M) ^ (f_H * m) =
            ∏ s ∈ Finset.range f_H, (τ_L ^ s) ((-1 : k_M) ^ m) := by
          have h_term : ∀ s ∈ Finset.range f_H, (τ_L ^ s) ((-1 : k_M) ^ m) = (-1 : k_M) ^ m := by
            intro s _
            rw [map_pow, map_neg, map_one]
          rw [Finset.prod_congr rfl h_term, Finset.prod_const, Finset.card_range, ← pow_mul']
        have h_c0_map : ∀ s ∈ Finset.range f_H,
            (Polynomial.map (τ_L ^ s).toRingHom Q).coeff 0 = (τ_L ^ s) (Q.coeff 0) := by
          intro s _
          exact Polynomial.coeff_map (τ_L ^ s).toRingHom 0
        rw [h_sign_prod, Finset.prod_congr rfl h_c0_map, ← Finset.prod_mul_distrib]
        have h_prod_pow : (∏ s ∈ Finset.range f_H,
              (τ_L ^ s) ((-1 : k_M) ^ m) * (τ_L ^ s) (Q.coeff 0)) =
            ∏ s ∈ Finset.range (Module.finrank k_L k_M),
              ((-1 : k_M) ^ m * Q.coeff 0) ^ (Nat.card k_L ^ s) := by
          rw [hfinrank]
          apply Finset.prod_congr rfl
          intro s _
          rw [← map_mul, hτ_pow s, Nat.card_eq_fintype_card]
        rw [h_prod_pow, ← FiniteField.algebraMap_norm_eq_prod_pow k_L k_M]
      have hNG_next : -(N_Γ Q).nextCoeff = Algebra.trace k_L k_M (-Q.nextCoeff) := by
        apply hι_inj
        rw [map_neg, ← Polynomial.nextCoeff_map hι_inj (N_Γ Q), hN_Gamma_all Q]
        dsimp only [Φ]
        rw [Polynomial.Monic.nextCoeff_prod _ _ h_fac_mon, ← Finset.sum_neg_distrib]
        have h_sum_pow : (∑ s ∈ Finset.range f_H, -(Polynomial.map (τ_L ^ s).toRingHom Q).nextCoeff) =
            ∑ s ∈ Finset.range (Module.finrank k_L k_M),
              (-Q.nextCoeff) ^ (Nat.card k_L ^ s) := by
          rw [hfinrank]
          apply Finset.sum_congr rfl
          intro s _
          rw [Polynomial.nextCoeff_map (τ_L ^ s).injective Q]
          change -((τ_L ^ s) Q.nextCoeff) = (-Q.nextCoeff) ^ (Nat.card k_L ^ s)
          rw [← map_neg, hτ_pow s, Nat.card_eq_fintype_card]
        rw [h_sum_pow, ← FiniteField.algebraMap_trace_eq_sum_pow k_L k_M]
      have hNG_comm : N_Γ (𝒩_ℓ_M Q) = 𝒩_ℓ_L (N_Γ Q) := by
        apply hmap_inj
        rw [hN_Gamma_all (𝒩_ℓ_M Q), h𝒩_L_map (N_Γ Q) hNG_mon, hN_Gamma_all Q]
        dsimp only [Φ]
        rw [h𝒩_M_prod_frob (Finset.range f_H) Q hQ_mon]
        apply Finset.prod_congr rfl
        intro s _
        exact hτ_N_comm s Q hQ_mon
      exact ⟨hNG_mem, hNG_c0, hNG_next, hNG_comm⟩
    exact ⟨N_Γ, hN_Gamma_map, hN_Gamma_prop⟩
  obtain ⟨N_Γ, hN_Gamma_map, hN_Gamma_prop⟩ := h_s3
  exact ⟨τ_L, 𝒩_ℓ_L, N_Γ, hτ_pow, hτ_pow_fH, hτ_poly_fix, hτ_σ_comm, hτ_N_comm,
    h𝒩_L_map, h𝒩_L_prop, h𝒩_L_one, h𝒩_L_mul, h𝒩_L_deg_ell, hN_Gamma_map, hN_Gamma_prop⟩

theorem ld_ch13_galois_norm_irreducible_orbit_and_fiber_sum (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M]
    (f_H : ℕ) (hf_H_gt1 : 1 < f_H) (hfinrank : Module.finrank k_L k_M = f_H)
    (M_L : ℕ → Finset (Polynomial k_L)) (Λ_L : Polynomial k_L → ℕ)
    (hM_L_mem : ∀ (d : ℕ) (f : Polynomial k_L), f ∈ M_L d ↔ f.Monic ∧ f.natDegree = d)
    (hΛ_L_prime_pow : ∀ (P : Polynomial k_L) (m : ℕ), P.Monic → Irreducible P → 1 ≤ m →
      Λ_L (P ^ m) = P.natDegree)
    (hΛ_L_sum_nz : ∀ (d : ℕ), 1 ≤ d →
      (∑ G ∈ (M_L d).filter (fun G => G.coeff 0 ≠ 0), Λ_L G) =
        (Fintype.card k_L) ^ d - 1)
    (M_M : ℕ → Finset (Polynomial k_M)) (Λ_M : Polynomial k_M → ℕ)
    (hM_M_mem : ∀ (d : ℕ) (f : Polynomial k_M), f ∈ M_M d ↔ f.Monic ∧ f.natDegree = d)
    (hΛ_M_prime_pow : ∀ (P : Polynomial k_M) (m : ℕ), P.Monic → Irreducible P → 1 ≤ m →
      Λ_M (P ^ m) = P.natDegree)
    (hΛ_M_ne_zero : ∀ (Q : Polynomial k_M), Λ_M Q ≠ 0 →
      ∃ (P : Polynomial k_M) (m : ℕ), P.Monic ∧ Irreducible P ∧ 1 ≤ m ∧ Q = P ^ m)
    (hΛ_M_sum_nz : ∀ (d : ℕ), 1 ≤ d →
      (∑ G ∈ (M_M d).filter (fun G => G.coeff 0 ≠ 0), Λ_M G) =
        (Fintype.card k_M) ^ d - 1)
    (τ_L : k_M ≃ₐ[k_L] k_M) (N_Γ : Polynomial k_M → Polynomial k_L)
    (hτ_pow_fH : τ_L ^ f_H = 1)
    (hτ_poly_fix : ∀ Q : Polynomial k_M,
      Polynomial.map τ_L.toRingHom Q = Q ↔
        Q ∈ Set.range (Polynomial.map (algebraMap k_L k_M)))
    (hN_Gamma_map : ∀ Q : Polynomial k_M, Q.Monic →
      Polynomial.map (algebraMap k_L k_M) (N_Γ Q) =
        ∏ s ∈ Finset.range f_H, Polynomial.map (τ_L ^ s).toRingHom Q)
    (hN_Gamma_mem_c0 : ∀ (m : ℕ) (Q : Polynomial k_M), Q ∈ M_M m →
      N_Γ Q ∈ M_L (f_H * m) ∧
      (-1 : k_L) ^ (f_H * m) * (N_Γ Q).coeff 0 =
        Algebra.norm k_L ((-1 : k_M) ^ m * Q.coeff 0)) :
    (∀ (P₀ : Polynomial k_L), P₀.Monic → Irreducible P₀ →
      ∀ (R : Polynomial k_M), R.Monic → Irreducible R →
        R ∣ Polynomial.map (algebraMap k_L k_M) P₀ →
        Polynomial.map (τ_L ^ P₀.natDegree).toRingHom R = R) ∧
    (∀ (m : ℕ), 1 ≤ m →
      ∀ P ∈ (M_L (f_H * m)).filter (fun P => P.coeff 0 ≠ 0),
        (∑ Q ∈ (M_M m).filter (fun Q => N_Γ Q = P), Λ_M Q) = Λ_L P) :=
by
  have exists_monic_irr_dvd : ∀ {k : Type u} [Field k] (B : Polynomial k),
      B.Monic → 0 < B.natDegree →
      ∃ Q : Polynomial k, Q.Monic ∧ Irreducible Q ∧ Q ∣ B := by
    intro k _ B _hB_mon hB_deg
    obtain ⟨g, hg_irr, hg_dvd⟩ := Polynomial.exists_irreducible_of_natDegree_pos hB_deg
    have hg_nz : g ≠ 0 := hg_irr.ne_zero
    have hc_nz : g.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hg_nz
    let Q := Polynomial.C (g.leadingCoeff)⁻¹ * g
    have hQ_mon : Q.Monic := by
      change (Polynomial.C (g.leadingCoeff)⁻¹ * g).leadingCoeff = 1
      rw [Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C, inv_mul_cancel₀ hc_nz]
    let u : (Polynomial k)ˣ :=
      { val := Polynomial.C (g.leadingCoeff)⁻¹
        inv := Polynomial.C g.leadingCoeff
        val_inv := by rw [← Polynomial.C_mul, inv_mul_cancel₀ hc_nz, Polynomial.C_1]
        inv_val := by rw [← Polynomial.C_mul, mul_inv_cancel₀ hc_nz, Polynomial.C_1] }
    have h_assoc : Associated g Q := ⟨u, by change g * Polynomial.C (g.leadingCoeff)⁻¹ = Q; rw [mul_comm]⟩
    exact ⟨Q, hQ_mon, h_assoc.irreducible hg_irr, h_assoc.symm.dvd.trans hg_dvd⟩
  have hτ_map_zero : ∀ (Q : Polynomial k_M),
      Polynomial.map (τ_L ^ 0).toRingHom Q = Q := by
    intro Q
    have h1 : (1 : k_M ≃ₐ[k_L] k_M).toRingHom = RingHom.id k_M := by ext x; rfl
    rw [pow_zero, h1, Polynomial.map_id]
  have hτ_map_add : ∀ (a b : ℕ) (Q : Polynomial k_M),
      Polynomial.map (τ_L ^ (a + b)).toRingHom Q =
        Polynomial.map (τ_L ^ a).toRingHom (Polynomial.map (τ_L ^ b).toRingHom Q) := by
    intro a b Q
    have hab : (τ_L ^ (a + b)).toRingHom = (τ_L ^ a).toRingHom.comp (τ_L ^ b).toRingHom := by
      rw [pow_add]
      ext x
      rfl
    rw [hab, ← Polynomial.map_map]
  have h_aut_map_iota : ∀ (σ : k_M ≃ₐ[k_L] k_M) (P : Polynomial k_L),
      Polynomial.map σ.toRingHom (Polynomial.map (algebraMap k_L k_M) P) =
        Polynomial.map (algebraMap k_L k_M) P := by
    intro σ P
    rw [Polynomial.map_map]
    have hcomm : σ.toRingHom.comp (algebraMap k_L k_M) = algebraMap k_L k_M := by
      ext x
      exact σ.commutes x
    rw [hcomm]
  have h_aut_symm_map : ∀ (σ : k_M ≃ₐ[k_L] k_M) (Q : Polynomial k_M),
      Polynomial.map σ.symm.toRingHom (Polynomial.map σ.toRingHom Q) = Q := by
    intro σ Q
    rw [Polynomial.map_map]
    have hcomp : σ.symm.toRingHom.comp σ.toRingHom = RingHom.id k_M := by
      ext x
      exact σ.symm_apply_apply x
    rw [hcomp, Polynomial.map_id]
  have h_aut_irr : ∀ (σ : k_M ≃ₐ[k_L] k_M) (Q : Polynomial k_M),
      Irreducible Q → Irreducible (Polynomial.map σ.toRingHom Q) := by
    intro σ Q hQ_irr
    have heq : Polynomial.map σ.toRingHom Q = Polynomial.mapEquiv σ.toRingEquiv Q :=
      (Polynomial.mapEquiv_apply σ.toRingEquiv Q).symm
    rw [heq]
    exact (MulEquiv.irreducible_iff (Polynomial.mapEquiv σ.toRingEquiv).toMulEquiv).mpr hQ_irr
  have hτ_fix_mul : ∀ (u : ℕ) (Q : Polynomial k_M),
      Polynomial.map (τ_L ^ u).toRingHom Q = Q →
      ∀ (k : ℕ), Polynomial.map (τ_L ^ (u * k)).toRingHom Q = Q := by
    intro u Q hu k
    induction' k with k ih
    · rw [Nat.mul_zero, hτ_map_zero]
    · rw [Nat.mul_succ, Nat.add_comm, hτ_map_add u (u * k) Q, ih, hu]
  have h_coprime_of_monic_irr_ne : ∀ {k : Type u} [Field k] {A B : Polynomial k},
      A.Monic → Irreducible A → B.Monic → Irreducible B → A ≠ B → IsCoprime A B := by
    intro k _ A B hA_mon hA_irr hB_mon hB_irr hne
    rw [Irreducible.coprime_iff_not_dvd hA_irr]
    intro hdvd
    have hassoc := (Irreducible.dvd_irreducible_iff_associated hA_irr hB_irr).mp hdvd
    exact hne (Polynomial.eq_of_monic_of_associated hA_mon hB_mon hassoc)
  refine ⟨?_, ?_⟩
  · intro P₀ hP₀_mon hP₀_irr R hR_mon hR_irr hR_dvd
    have hex : ∃ u : ℕ, 1 ≤ u ∧ Polynomial.map (τ_L ^ u).toRingHom R = R := by
      refine ⟨f_H, by omega, ?_⟩
      rw [hτ_pow_fH, ← pow_zero τ_L, hτ_map_zero]
    let u₀ := Nat.find hex
    have hu₀_spec := Nat.find_spec hex
    have hu₀_pos : 1 ≤ u₀ := hu₀_spec.1
    have hu₀_fix : Polynomial.map (τ_L ^ u₀).toRingHom R = R := hu₀_spec.2
    have hu₀_min : ∀ u < u₀, 1 ≤ u → Polynomial.map (τ_L ^ u).toRingHom R ≠ R :=
      fun u hlt hge hfix => Nat.find_min hex hlt ⟨hge, hfix⟩
    let H₀ : Polynomial k_M := ∏ s ∈ Finset.range u₀, Polynomial.map (τ_L ^ s).toRingHom R
    have hH₀_fix : Polynomial.map τ_L.toRingHom H₀ = H₀ := by
      have h_map_prod : Polynomial.map τ_L.toRingHom H₀ =
          ∏ s ∈ Finset.range u₀, Polynomial.map (τ_L ^ (s + 1)).toRingHom R := by
        change (Polynomial.mapRingHom τ_L.toRingHom) H₀ = _
        rw [map_prod]
        apply Finset.prod_congr rfl
        intro s _
        change Polynomial.map τ_L.toRingHom (Polynomial.map (τ_L ^ s).toRingHom R) = _
        have h1 : τ_L.toRingHom = (τ_L ^ 1).toRingHom := by rw [pow_one]
        rw [h1, ← hτ_map_add 1 s R, Nat.add_comm 1 s]
      rw [h_map_prod]
      have hu₀_eq : u₀ = (u₀ - 1) + 1 := by omega
      conv_lhs => rw [hu₀_eq, Finset.prod_range_succ, ← hu₀_eq, hu₀_fix]
      conv_rhs =>
        change ∏ s ∈ Finset.range u₀, Polynomial.map (τ_L ^ s).toRingHom R
        rw [hu₀_eq, Finset.prod_range_succ', hτ_map_zero]
    obtain ⟨B₀, hB₀_eq⟩ := (hτ_poly_fix H₀).mp hH₀_fix
    have hH₀_mon : H₀.Monic :=
      Polynomial.monic_prod_of_monic _ _ (fun s _ => hR_mon.map (τ_L ^ s).toRingHom)
    have hH₀_deg : H₀.natDegree = u₀ * R.natDegree := by
      change (∏ s ∈ Finset.range u₀, Polynomial.map (τ_L ^ s).toRingHom R).natDegree = u₀ * R.natDegree
      rw [Polynomial.natDegree_prod_of_monic _ _ (fun s _ => hR_mon.map (τ_L ^ s).toRingHom)]
      have h_deg_s : ∀ s ∈ Finset.range u₀,
          (Polynomial.map (τ_L ^ s).toRingHom R).natDegree = R.natDegree :=
        fun s _ => Polynomial.natDegree_map_eq_of_injective (τ_L ^ s).injective R
      rw [Finset.sum_congr rfl h_deg_s, Finset.sum_const, Finset.card_range, smul_eq_mul]
    have hB₀_deg : B₀.natDegree = u₀ * R.natDegree := by
      rw [← Polynomial.natDegree_map_eq_of_injective (algebraMap k_L k_M).injective B₀, hB₀_eq, hH₀_deg]
    have hB₀_ne0 : B₀ ≠ 0 := by
      intro h0
      apply hH₀_mon.ne_zero
      rw [← hB₀_eq, h0, Polynomial.map_zero]
    have hR_dvd_H₀ : R ∣ H₀ := by
      have h0_mem : 0 ∈ Finset.range u₀ := Finset.mem_range.mpr (by omega)
      have hdvd := Finset.dvd_prod_of_mem (fun s => Polynomial.map (τ_L ^ s).toRingHom R) h0_mem
      dsimp only at hdvd
      rwa [hτ_map_zero] at hdvd
    have hP₀_dvd_B₀ : P₀ ∣ B₀ := by
      by_contra h_not_dvd
      have hcop : IsCoprime P₀ B₀ := (Irreducible.coprime_iff_not_dvd hP₀_irr).mpr h_not_dvd
      have hcop_map : IsCoprime (Polynomial.map (algebraMap k_L k_M) P₀) (Polynomial.map (algebraMap k_L k_M) B₀) :=
        hcop.map (Polynomial.mapRingHom (algebraMap k_L k_M))
      rw [hB₀_eq] at hcop_map
      exact hR_irr.not_isUnit (hcop_map.isUnit_of_dvd' hR_dvd hR_dvd_H₀)
    have h_deg_le1 : P₀.natDegree ≤ u₀ * R.natDegree := by
      rw [← hB₀_deg]
      exact Polynomial.natDegree_le_of_dvd hP₀_dvd_B₀ hB₀_ne0
    have h_orb_ne : ∀ {s₁ s₂ : ℕ}, s₁ < s₂ → s₂ < u₀ →
        Polynomial.map (τ_L ^ s₁).toRingHom R ≠ Polynomial.map (τ_L ^ s₂).toRingHom R := by
      intro s₁ s₂ hlt hlt_u₀ heq
      have hs₂_eq : s₂ = s₁ + (s₂ - s₁) := (Nat.add_sub_of_le (le_of_lt hlt)).symm
      rw [hs₂_eq, hτ_map_add s₁ (s₂ - s₁) R] at heq
      have h_inj := Polynomial.map_injective (τ_L ^ s₁).toRingHom (τ_L ^ s₁).injective heq.symm
      exact hu₀_min (s₂ - s₁) (by omega) (by omega) h_inj
    have hH₀_dvd_P₀ : H₀ ∣ Polynomial.map (algebraMap k_L k_M) P₀ := by
      apply Finset.prod_dvd_of_coprime
      · intro s₁ hs₁ s₂ hs₂ hne
        have hs₁_lt : s₁ < u₀ := Finset.mem_range.mp hs₁
        have hs₂_lt : s₂ < u₀ := Finset.mem_range.mp hs₂
        have h_ne_poly : Polynomial.map (τ_L ^ s₁).toRingHom R ≠ Polynomial.map (τ_L ^ s₂).toRingHom R := by
          rcases lt_or_gt_of_ne hne with hlt | hgt
          · exact h_orb_ne hlt hs₂_lt
          · exact (h_orb_ne hgt hs₁_lt).symm
        exact h_coprime_of_monic_irr_ne
          (hR_mon.map (τ_L ^ s₁).toRingHom) (h_aut_irr (τ_L ^ s₁) R hR_irr)
          (hR_mon.map (τ_L ^ s₂).toRingHom) (h_aut_irr (τ_L ^ s₂) R hR_irr)
          h_ne_poly
      · intro s _
        have hdvd : (Polynomial.mapRingHom (τ_L ^ s).toRingHom) R ∣
            (Polynomial.mapRingHom (τ_L ^ s).toRingHom) (Polynomial.map (algebraMap k_L k_M) P₀) :=
          map_dvd (Polynomial.mapRingHom (τ_L ^ s).toRingHom) hR_dvd
        change Polynomial.map (τ_L ^ s).toRingHom R ∣
          Polynomial.map (τ_L ^ s).toRingHom (Polynomial.map (algebraMap k_L k_M) P₀) at hdvd
        rwa [h_aut_map_iota (τ_L ^ s) P₀] at hdvd
    have h_deg_le2 : u₀ * R.natDegree ≤ P₀.natDegree := by
      rw [← hH₀_deg, ← Polynomial.natDegree_map_eq_of_injective (algebraMap k_L k_M).injective P₀]
      exact Polynomial.natDegree_le_of_dvd hH₀_dvd_P₀ (hP₀_mon.map (algebraMap k_L k_M)).ne_zero
    have h_deg_eq : P₀.natDegree = u₀ * R.natDegree := le_antisymm h_deg_le1 h_deg_le2
    rw [h_deg_eq]
    exact hτ_fix_mul u₀ R hu₀_fix R.natDegree
  · have hFiberLe : ∀ (m : ℕ), 1 ≤ m →
        ∀ P ∈ M_L (f_H * m),
          (∑ Q ∈ (M_M m).filter (fun Q => N_Γ Q = P), Λ_M Q) ≤ Λ_L P := by
      intro m hm P hP_mem
      have hP_mon : P.Monic := ((hM_L_mem (f_H * m) P).mp hP_mem).1
      have hP_deg : P.natDegree = f_H * m := ((hM_L_mem (f_H * m) P).mp hP_mem).2
      have hP_deg_pos : 0 < P.natDegree := by
        rw [hP_deg]
        exact Nat.mul_pos (by omega) hm
      set fib := (M_M m).filter (fun Q => N_Γ Q = P)
      set S_P := fib.filter (fun Q => Λ_M Q ≠ 0)
      have h_sum_eq : (∑ Q ∈ fib, Λ_M Q) = ∑ Q ∈ S_P, Λ_M Q :=
        (Finset.sum_filter_of_ne (fun Q _ hΛ => hΛ)).symm
      rw [h_sum_eq]
      by_cases hS_nonempty : S_P.Nonempty
      · obtain ⟨Q₀, hQ₀_mem⟩ := hS_nonempty
        have hQ₀_fib : Q₀ ∈ fib := (Finset.mem_filter.mp hQ₀_mem).1
        have hQ₀_Λ : Λ_M Q₀ ≠ 0 := (Finset.mem_filter.mp hQ₀_mem).2
        have hQ₀_N : N_Γ Q₀ = P := (Finset.mem_filter.mp hQ₀_fib).2
        obtain ⟨R₀, k₀, hR₀_mon, hR₀_irr, hk₀_pos, hQ₀_eq⟩ := hΛ_M_ne_zero Q₀ hQ₀_Λ
        have hQ₀_mon : Q₀.Monic := hQ₀_eq ▸ hR₀_mon.pow k₀
        have hP_map_eq : Polynomial.map (algebraMap k_L k_M) P =
            (∏ s ∈ Finset.range f_H, Polynomial.map (τ_L ^ s).toRingHom R₀) ^ k₀ := by
          rw [← hQ₀_N, hN_Gamma_map Q₀ hQ₀_mon, hQ₀_eq, ← Finset.prod_pow]
          apply Finset.prod_congr rfl
          intro s _
          rw [Polynomial.map_pow]
        have hR₀_dvd_all : ∀ (P' : Polynomial k_L), P'.Monic → Irreducible P' → P' ∣ P →
            R₀ ∣ Polynomial.map (algebraMap k_L k_M) P' := by
          intro P' hP'_mon hP'_irr hP'_dvd
          have hP'_map_mon : (Polynomial.map (algebraMap k_L k_M) P').Monic :=
            hP'_mon.map (algebraMap k_L k_M)
          have hP'_map_deg : 0 < (Polynomial.map (algebraMap k_L k_M) P').natDegree := by
            rw [Polynomial.natDegree_map_eq_of_injective (algebraMap k_L k_M).injective P']
            exact hP'_irr.natDegree_pos
          obtain ⟨R', hR'_mon, hR'_irr, hR'_dvd_P'⟩ :=
            exists_monic_irr_dvd (Polynomial.map (algebraMap k_L k_M) P') hP'_map_mon hP'_map_deg
          have hP'_map_dvd : Polynomial.map (algebraMap k_L k_M) P' ∣ Polynomial.map (algebraMap k_L k_M) P :=
            map_dvd (Polynomial.mapRingHom (algebraMap k_L k_M)) hP'_dvd
          have hR'_dvd_pow : R' ∣ (∏ s ∈ Finset.range f_H, Polynomial.map (τ_L ^ s).toRingHom R₀) ^ k₀ := by
            rw [← hP_map_eq]
            exact hR'_dvd_P'.trans hP'_map_dvd
          have hR'_prime : Prime R' := UniqueFactorizationMonoid.irreducible_iff_prime.mp hR'_irr
          have hR'_dvd_prod : R' ∣ ∏ s ∈ Finset.range f_H, Polynomial.map (τ_L ^ s).toRingHom R₀ :=
            hR'_prime.dvd_of_dvd_pow hR'_dvd_pow
          obtain ⟨s, _, hR'_dvd_s⟩ := (Prime.dvd_finset_prod_iff hR'_prime _).mp hR'_dvd_prod
          have hR₀s_mon : (Polynomial.map (τ_L ^ s).toRingHom R₀).Monic := hR₀_mon.map (τ_L ^ s).toRingHom
          have hR₀s_irr : Irreducible (Polynomial.map (τ_L ^ s).toRingHom R₀) := h_aut_irr (τ_L ^ s) R₀ hR₀_irr
          have hassoc := (Irreducible.dvd_irreducible_iff_associated hR'_irr hR₀s_irr).mp hR'_dvd_s
          have hR'_eq : R' = Polynomial.map (τ_L ^ s).toRingHom R₀ :=
            Polynomial.eq_of_monic_of_associated hR'_mon hR₀s_mon hassoc
          rw [hR'_eq] at hR'_dvd_P'
          have hdvd_symm : (Polynomial.mapRingHom (τ_L ^ s).symm.toRingHom) (Polynomial.map (τ_L ^ s).toRingHom R₀) ∣
              (Polynomial.mapRingHom (τ_L ^ s).symm.toRingHom) (Polynomial.map (algebraMap k_L k_M) P') :=
            map_dvd (Polynomial.mapRingHom (τ_L ^ s).symm.toRingHom) hR'_dvd_P'
          change Polynomial.map (τ_L ^ s).symm.toRingHom (Polynomial.map (τ_L ^ s).toRingHom R₀) ∣
            Polynomial.map (τ_L ^ s).symm.toRingHom (Polynomial.map (algebraMap k_L k_M) P') at hdvd_symm
          rwa [h_aut_symm_map (τ_L ^ s) R₀, h_aut_map_iota (τ_L ^ s).symm P'] at hdvd_symm
        obtain ⟨P₀, hP₀_mon, hP₀_irr, hP₀_dvd_P⟩ := exists_monic_irr_dvd P hP_mon hP_deg_pos
        have hR₀_dvd_P₀ : R₀ ∣ Polynomial.map (algebraMap k_L k_M) P₀ :=
          hR₀_dvd_all P₀ hP₀_mon hP₀_irr hP₀_dvd_P
        have hP₀_unique : ∀ (P' : Polynomial k_L), P'.Monic → Irreducible P' → P' ∣ P → P' = P₀ := by
          intro P' hP'_mon hP'_irr hP'_dvd
          by_contra hne
          have hcop : IsCoprime P₀ P' := h_coprime_of_monic_irr_ne hP₀_mon hP₀_irr hP'_mon hP'_irr (Ne.symm hne)
          have hcop_map : IsCoprime (Polynomial.map (algebraMap k_L k_M) P₀) (Polynomial.map (algebraMap k_L k_M) P') :=
            hcop.map (Polynomial.mapRingHom (algebraMap k_L k_M))
          have hR₀_dvd_P' : R₀ ∣ Polynomial.map (algebraMap k_L k_M) P' :=
            hR₀_dvd_all P' hP'_mon hP'_irr hP'_dvd
          exact hR₀_irr.not_isUnit (hcop_map.isUnit_of_dvd' hR₀_dvd_P₀ hR₀_dvd_P')
        have h_pow_of_dvd : ∀ (n : ℕ) (B : Polynomial k_L),
            B.natDegree = n → B.Monic → B ∣ P → ∃ a : ℕ, B = P₀ ^ a := by
          intro n
          induction' n using Nat.strong_induction_on with n ih
          intro B hB_deg hB_mon hB_dvd
          by_cases hn0 : n = 0
          · refine ⟨0, ?_⟩
            rw [pow_zero]
            exact Polynomial.eq_one_of_monic_natDegree_zero hB_mon (hB_deg.trans hn0)
          · have hn_pos : 0 < B.natDegree := by rw [hB_deg]; exact Nat.pos_of_ne_zero hn0
            obtain ⟨P', hP'_mon, hP'_irr, hP'_dvd_B⟩ := exists_monic_irr_dvd B hB_mon hn_pos
            have hP'_eq : P' = P₀ := hP₀_unique P' hP'_mon hP'_irr (hP'_dvd_B.trans hB_dvd)
            rw [hP'_eq] at hP'_dvd_B
            obtain ⟨B', hB'_eq⟩ := hP'_dvd_B
            have hB'_mon : B'.Monic := by
              apply Polynomial.Monic.of_mul_monic_left hP₀_mon
              rw [← hB'_eq]
              exact hB_mon
            have hB'_dvd : B' ∣ P := (dvd_mul_left B' P₀).trans (hB'_eq ▸ hB_dvd)
            have h_deg_sum : B.natDegree = P₀.natDegree + B'.natDegree := by
              rw [hB'_eq, hP₀_mon.natDegree_mul hB'_mon]
            have hP₀_deg_pos : 0 < P₀.natDegree := hP₀_irr.natDegree_pos
            have hB'_lt : B'.natDegree < n := by omega
            obtain ⟨a', ha'⟩ := ih B'.natDegree hB'_lt B' rfl hB'_mon hB'_dvd
            refine ⟨a' + 1, ?_⟩
            rw [hB'_eq, ha', pow_succ']
        obtain ⟨a, hP_eq⟩ := h_pow_of_dvd P.natDegree P rfl hP_mon (dvd_refl P)
        have ha_pos : 1 ≤ a := by
          by_contra h_not
          have ha0 : a = 0 := by omega
          rw [ha0, pow_zero] at hP_eq
          rw [hP_eq, Polynomial.natDegree_one] at hP_deg_pos
          exact lt_irrefl 0 hP_deg_pos
        have hΛ_P : Λ_L P = P₀.natDegree := by
          rw [hP_eq, hΛ_L_prime_pow P₀ a hP₀_mon hP₀_irr ha_pos]
        let base : Polynomial k_M → Polynomial k_M := fun Q =>
          if h : ∃ (R : Polynomial k_M) (k : ℕ), R.Monic ∧ Irreducible R ∧ 1 ≤ k ∧ Q = R ^ k then
            h.choose
          else 1
        have h_base_spec : ∀ Q ∈ S_P,
            (base Q).Monic ∧
            Irreducible (base Q) ∧
            (∃ k : ℕ, 1 ≤ k ∧ Q = (base Q) ^ k) ∧
            Λ_M Q = (base Q).natDegree ∧
            base Q ∣ Polynomial.map (algebraMap k_L k_M) P₀ := by
          intro Q hQ
          have hQ_fib : Q ∈ fib := (Finset.mem_filter.mp hQ).1
          have hQ_Λ : Λ_M Q ≠ 0 := (Finset.mem_filter.mp hQ).2
          have hQ_Mm : Q ∈ M_M m := (Finset.mem_filter.mp hQ_fib).1
          have hQ_N : N_Γ Q = P := (Finset.mem_filter.mp hQ_fib).2
          have hQ_mon : Q.Monic := ((hM_M_mem m Q).mp hQ_Mm).1
          have hex : ∃ (R : Polynomial k_M) (k : ℕ), R.Monic ∧ Irreducible R ∧ 1 ≤ k ∧ Q = R ^ k :=
            hΛ_M_ne_zero Q hQ_Λ
          have hbase_eq : base Q = hex.choose := dif_pos hex
          obtain ⟨k, hR_mon, hR_irr, hk_pos, hQ_pow⟩ := hex.choose_spec
          rw [← hbase_eq] at hR_mon hR_irr hQ_pow
          have hΛ_Q : Λ_M Q = (base Q).natDegree := by
            conv_lhs => rw [hQ_pow]
            exact hΛ_M_prime_pow (base Q) k hR_mon hR_irr hk_pos
          have hR_dvd_Q : base Q ∣ Q := by
            conv_rhs => rw [hQ_pow]
            exact dvd_pow_self (base Q) (by omega)
          have hQ_dvd_NP : Q ∣ Polynomial.map (algebraMap k_L k_M) P := by
            rw [← hQ_N, hN_Gamma_map Q hQ_mon]
            have h0_mem : 0 ∈ Finset.range f_H := Finset.mem_range.mpr (by omega)
            have hdvd := Finset.dvd_prod_of_mem (fun s => Polynomial.map (τ_L ^ s).toRingHom Q) h0_mem
            dsimp only at hdvd
            rwa [hτ_map_zero] at hdvd
          have hR_dvd_pow : base Q ∣ (Polynomial.map (algebraMap k_L k_M) P₀) ^ a := by
            rw [← Polynomial.map_pow, ← hP_eq]
            exact hR_dvd_Q.trans hQ_dvd_NP
          have hR_prime : Prime (base Q) := UniqueFactorizationMonoid.irreducible_iff_prime.mp hR_irr
          exact ⟨hR_mon, hR_irr, ⟨k, hk_pos, hQ_pow⟩, hΛ_Q, hR_prime.dvd_of_dvd_pow hR_dvd_pow⟩
        have h_base_inj : Set.InjOn base (S_P : Set (Polynomial k_M)) := by
          intro Q₁ hQ₁ Q₂ hQ₂ heq
          rw [Finset.mem_coe] at hQ₁ hQ₂
          obtain ⟨hR₁_mon, hR₁_irr, ⟨k₁, _, hQ₁_pow⟩, _, _⟩ := h_base_spec Q₁ hQ₁
          obtain ⟨_, _, ⟨k₂, _, hQ₂_pow⟩, _, _⟩ := h_base_spec Q₂ hQ₂
          have hQ₁_deg : Q₁.natDegree = m := ((hM_M_mem m Q₁).mp (Finset.mem_filter.mp (Finset.mem_filter.mp hQ₁).1).1).2
          have hQ₂_deg : Q₂.natDegree = m := ((hM_M_mem m Q₂).mp (Finset.mem_filter.mp (Finset.mem_filter.mp hQ₂).1).1).2
          have hdeg₁ : Q₁.natDegree = k₁ * (base Q₁).natDegree := by
            conv_lhs => rw [hQ₁_pow]
            exact Polynomial.natDegree_pow' (by rw [hR₁_mon.leadingCoeff, one_pow]; exact one_ne_zero)
          have hdeg₂ : Q₂.natDegree = k₂ * (base Q₁).natDegree := by
            conv_lhs => rw [hQ₂_pow, ← heq]
            exact Polynomial.natDegree_pow' (by rw [hR₁_mon.leadingCoeff, one_pow]; exact one_ne_zero)
          have hk_eq : k₁ = k₂ := by
            apply Nat.mul_right_cancel hR₁_irr.natDegree_pos
            omega
          rw [hQ₁_pow, hQ₂_pow, ← heq, hk_eq]
        have h_img_spec : ∀ R ∈ S_P.image base,
            R.Monic ∧ Irreducible R ∧ R ∣ Polynomial.map (algebraMap k_L k_M) P₀ := by
          intro R hR
          obtain ⟨Q, hQ, rfl⟩ := Finset.mem_image.mp hR
          obtain ⟨h1, h2, _, _, h5⟩ := h_base_spec Q hQ
          exact ⟨h1, h2, h5⟩
        have h_sum_deg : (∑ Q ∈ S_P, Λ_M Q) = (∏ R ∈ S_P.image base, R).natDegree := by
          rw [Finset.sum_congr rfl (fun Q hQ => (h_base_spec Q hQ).2.2.2.1),
            ← Finset.sum_image h_base_inj,
            Polynomial.natDegree_prod_of_monic _ _ (fun R hR => (h_img_spec R hR).1)]
        have h_prod_dvd : (∏ R ∈ S_P.image base, R) ∣ Polynomial.map (algebraMap k_L k_M) P₀ := by
          apply Finset.prod_dvd_of_coprime
          · intro R₁ hR₁ R₂ hR₂ hne
            exact h_coprime_of_monic_irr_ne
              (h_img_spec R₁ hR₁).1 (h_img_spec R₁ hR₁).2.1
              (h_img_spec R₂ hR₂).1 (h_img_spec R₂ hR₂).2.1
              hne
          · intro R hR
            exact (h_img_spec R hR).2.2
        rw [h_sum_deg, hΛ_P, ← Polynomial.natDegree_map_eq_of_injective (algebraMap k_L k_M).injective P₀]
        exact Polynomial.natDegree_le_of_dvd h_prod_dvd (hP₀_mon.map (algebraMap k_L k_M)).ne_zero
      · rw [Finset.not_nonempty_iff_eq_empty.mp hS_nonempty, Finset.sum_empty]
        exact Nat.zero_le _
    have hGlobalSumEq : ∀ (m : ℕ), 1 ≤ m →
        (∑ P ∈ (M_L (f_H * m)).filter (fun P => P.coeff 0 ≠ 0),
          (∑ Q ∈ (M_M m).filter (fun Q => N_Γ Q = P), Λ_M Q)) =
        ∑ P ∈ (M_L (f_H * m)).filter (fun P => P.coeff 0 ≠ 0), Λ_L P := by
      intro m hm
      set M_L_nz := (M_L (f_H * m)).filter (fun P => P.coeff 0 ≠ 0)
      set M_M_nz := (M_M m).filter (fun Q => Q.coeff 0 ≠ 0)
      have h_c0_iff : ∀ Q ∈ M_M m, (N_Γ Q).coeff 0 ≠ 0 ↔ Q.coeff 0 ≠ 0 := by
        intro Q hQ
        have hc0 := (hN_Gamma_mem_c0 m Q hQ).2
        have h_neg1_L : (-1 : k_L) ^ (f_H * m) ≠ 0 := pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)
        have h_neg1_M : (-1 : k_M) ^ m ≠ 0 := pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)
        rw [← mul_ne_zero_iff_left h_neg1_L, hc0, ne_eq, Algebra.norm_eq_zero_iff,
          mul_eq_zero, or_iff_right h_neg1_M]
      have h_maps : ∀ Q ∈ M_M_nz, N_Γ Q ∈ M_L_nz := by
        intro Q hQ
        rw [Finset.mem_filter] at hQ ⊢
        exact ⟨(hN_Gamma_mem_c0 m Q hQ.1).1, (h_c0_iff Q hQ.1).mpr hQ.2⟩
      have h_filt_eq : ∀ P ∈ M_L_nz,
          (M_M m).filter (fun Q => N_Γ Q = P) = M_M_nz.filter (fun Q => N_Γ Q = P) := by
        intro P hP
        have hP_nz : P.coeff 0 ≠ 0 := (Finset.mem_filter.mp hP).2
        ext Q
        simp only [M_M_nz, Finset.mem_filter]
        constructor
        · rintro ⟨hQ1, hQ2⟩
          refine ⟨⟨hQ1, ?_⟩, hQ2⟩
          rw [← h_c0_iff Q hQ1, hQ2]
          exact hP_nz
        · rintro ⟨⟨hQ1, _⟩, hQ2⟩
          exact ⟨hQ1, hQ2⟩
      have h_lhs : (∑ P ∈ M_L_nz, ∑ Q ∈ (M_M m).filter (fun Q => N_Γ Q = P), Λ_M Q) =
          ∑ P ∈ M_L_nz, ∑ Q ∈ M_M_nz.filter (fun Q => N_Γ Q = P), Λ_M Q := by
        apply Finset.sum_congr rfl
        intro P hP
        rw [h_filt_eq P hP]
      have hfHm_pos : 1 ≤ f_H * m := Nat.mul_pos (by omega) hm
      have h_card : (Fintype.card k_M) ^ m = (Fintype.card k_L) ^ (f_H * m) := by
        rw [Module.card_eq_pow_finrank (K := k_L) (V := k_M), hfinrank, ← pow_mul]
      rw [h_lhs, Finset.sum_fiberwise_of_maps_to h_maps, hΛ_M_sum_nz m hm,
        hΛ_L_sum_nz (f_H * m) hfHm_pos, h_card]
    intro m hm P hP
    have hLe_nz : ∀ H ∈ (M_L (f_H * m)).filter (fun P => P.coeff 0 ≠ 0),
        (∑ Q ∈ (M_M m).filter (fun Q => N_Γ Q = H), Λ_M Q) ≤ Λ_L H :=
      fun H hH => hFiberLe m hm H (Finset.mem_filter.mp hH).1
    exact (Finset.sum_eq_sum_iff_of_le hLe_nz).mp (hGlobalSumEq m hm) P hP

theorem ld_ch13_norm_poly_nondiv_deg_fiber_sum (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M]
    (ℓ f_H : ℕ) (hPrime : Nat.Prime ℓ) (hf_H_gt1 : 1 < f_H)
    (hNotDvd : ∀ d : ℕ, 1 ≤ d → d < f_H → ¬ (ℓ ∣ ((Fintype.card k_L) ^ d - 1)))
    (ζ : k_M) (hζ_ne : ζ ≠ 0) (hζ_pow : ζ ^ ℓ = 1)
    (hζ_prim : ∀ r : ℕ, 1 ≤ r → r < ℓ → ζ ^ r ≠ 1)
    (M_L : ℕ → Finset (Polynomial k_L)) (Λ_L : Polynomial k_L → ℕ)
    (hM_L_mem : ∀ (d : ℕ) (f : Polynomial k_L), f ∈ M_L d ↔ f.Monic ∧ f.natDegree = d)
    (hΛ_L_prime_pow : ∀ (P : Polynomial k_L) (m : ℕ), P.Monic → Irreducible P → 1 ≤ m →
      Λ_L (P ^ m) = P.natDegree)
    (hΛ_L_ne_zero : ∀ (Q : Polynomial k_L), Λ_L Q ≠ 0 →
      ∃ (P : Polynomial k_L) (m : ℕ), P.Monic ∧ Irreducible P ∧ 1 ≤ m ∧ Q = P ^ m)
    (M_M : ℕ → Finset (Polynomial k_M))
    (hM_M_mem : ∀ (d : ℕ) (f : Polynomial k_M), f ∈ M_M d ↔ f.Monic ∧ f.natDegree = d)
    (σ_M : ℕ → Polynomial k_M → Polynomial k_M) (𝒩_ℓ_M : Polynomial k_M → Polynomial k_M)
    (hσ_coeff : ∀ (m : ℕ) (P : Polynomial k_M) (n : ℕ),
      (σ_M m P).coeff n = (ζ⁻¹) ^ (m * P.natDegree) * (P.coeff n * (ζ ^ m) ^ n))
    (hσ_mem : ∀ (m d : ℕ) (P : Polynomial k_M), P ∈ M_M d → σ_M m P ∈ M_M d)
    (hσ_mul : ∀ (m : ℕ) (f g : Polynomial k_M), f.Monic → g.Monic → σ_M m (f * g) = σ_M m f * σ_M m g)
    (hσ_zero : ∀ (P : Polynomial k_M), P.Monic → σ_M 0 P = P)
    (hσ_add : ∀ (m₁ m₂ : ℕ) (P : Polynomial k_M), P.Monic →
      σ_M m₁ (σ_M m₂ P) = σ_M ((m₁ + m₂) % ℓ) P)
    (hσ_expand : ∀ (m : ℕ) (Q : Polynomial k_M), Q.Monic →
      σ_M m (Polynomial.expand k_M ℓ Q) = Polynomial.expand k_M ℓ Q)
    (hσ_irr : ∀ (m : ℕ) (P : Polynomial k_M), P.Monic → Irreducible P → Irreducible (σ_M m P))
    (h𝒩_M_prop : ∀ (d : ℕ) (P : Polynomial k_M), P ∈ M_M d →
      𝒩_ℓ_M P ∈ M_M d ∧
      Polynomial.expand k_M ℓ (𝒩_ℓ_M P) = ∏ m ∈ Finset.range ℓ, σ_M m P ∧
      (-1 : k_M) ^ d * (𝒩_ℓ_M P).coeff 0 = ((-1 : k_M) ^ d * P.coeff 0) ^ ℓ)
    (τ_L : k_M ≃ₐ[k_L] k_M) (𝒩_ℓ_L : Polynomial k_L → Polynomial k_L)
    (hτ_pow_fH : τ_L ^ f_H = 1)
    (hτ_σ_comm : ∀ (d m : ℕ) (Q : Polynomial k_M),
      Polynomial.map (τ_L ^ d).toRingHom (σ_M m Q) =
        σ_M (((Fintype.card k_L) ^ d * m) % ℓ) (Polynomial.map (τ_L ^ d).toRingHom Q))
    (h𝒩_L_map : ∀ P : Polynomial k_L, P.Monic →
      Polynomial.map (algebraMap k_L k_M) (𝒩_ℓ_L P) =
        𝒩_ℓ_M (Polynomial.map (algebraMap k_L k_M) P))
    (h𝒩_L_prop : ∀ (d : ℕ) (P : Polynomial k_L), P ∈ M_L d →
      𝒩_ℓ_L P ∈ M_L d ∧
      (-1 : k_L) ^ d * (𝒩_ℓ_L P).coeff 0 = ((-1 : k_L) ^ d * P.coeff 0) ^ ℓ)
    (h𝒩_L_one : 𝒩_ℓ_L 1 = 1)
    (h𝒩_L_mul : ∀ f g : Polynomial k_L, f.Monic → g.Monic → 𝒩_ℓ_L (f * g) = 𝒩_ℓ_L f * 𝒩_ℓ_L g)
    (hIrrFrobFix : ∀ (P₀ : Polynomial k_L), P₀.Monic → Irreducible P₀ →
      ∀ (R : Polynomial k_M), R.Monic → Irreducible R →
        R ∣ Polynomial.map (algebraMap k_L k_M) P₀ →
        Polynomial.map (τ_L ^ P₀.natDegree).toRingHom R = R) :
    ∀ (d : ℕ), 1 ≤ d → d ≤ ℓ → ¬ (f_H ∣ d) →
      ∀ G ∈ (M_L d).filter (fun G => G.coeff 0 ≠ 0),
        (∑ P ∈ (M_L d).filter (fun P => 𝒩_ℓ_L P = G), Λ_L P) = Λ_L G :=
by
  have exists_monic_irr_dvd : ∀ {k : Type u} [Field k] (B : Polynomial k),
      B.Monic → 0 < B.natDegree →
      ∃ Q : Polynomial k, Q.Monic ∧ Irreducible Q ∧ Q ∣ B := by
    intro k _ B _hB_mon hB_deg
    obtain ⟨g, hg_irr, hg_dvd⟩ := Polynomial.exists_irreducible_of_natDegree_pos hB_deg
    have hg_nz : g ≠ 0 := hg_irr.ne_zero
    have hc_nz : g.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hg_nz
    let Q := Polynomial.C (g.leadingCoeff)⁻¹ * g
    have hQ_mon : Q.Monic := by
      change (Polynomial.C (g.leadingCoeff)⁻¹ * g).leadingCoeff = 1
      rw [Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C, inv_mul_cancel₀ hc_nz]
    let u : (Polynomial k)ˣ :=
      { val := Polynomial.C (g.leadingCoeff)⁻¹
        inv := Polynomial.C g.leadingCoeff
        val_inv := by rw [← Polynomial.C_mul, inv_mul_cancel₀ hc_nz, Polynomial.C_1]
        inv_val := by rw [← Polynomial.C_mul, mul_inv_cancel₀ hc_nz, Polynomial.C_1] }
    have h_assoc : Associated g Q := ⟨u, by change g * Polynomial.C (g.leadingCoeff)⁻¹ = Q; rw [mul_comm]⟩
    exact ⟨Q, hQ_mon, h_assoc.irreducible hg_irr, h_assoc.symm.dvd.trans hg_dvd⟩
  have h_coprime_of_monic_irr_ne : ∀ {k : Type u} [Field k] {A B : Polynomial k},
      A.Monic → Irreducible A → B.Monic → Irreducible B → A ≠ B → IsCoprime A B := by
    intro k _ A B hA_mon hA_irr hB_mon hB_irr hne
    rw [Irreducible.coprime_iff_not_dvd hA_irr]
    intro hdvd
    have hassoc := (Irreducible.dvd_irreducible_iff_associated hA_irr hB_irr).mp hdvd
    exact hne (Polynomial.eq_of_monic_of_associated hA_mon hB_mon hassoc)
  have hσ_mon_deg : ∀ (m : ℕ) (f : Polynomial k_M), f.Monic →
      (σ_M m f).Monic ∧ (σ_M m f).natDegree = f.natDegree := by
    intro m f hf
    exact (hM_M_mem f.natDegree (σ_M m f)).mp
      (hσ_mem m f.natDegree f ((hM_M_mem f.natDegree f).mpr ⟨hf, rfl⟩))
  have hσ_km : ∀ (m : ℕ) (Q : Polynomial k_M), Q.Monic → σ_M m Q = Q →
      ∀ (k_idx : ℕ), σ_M ((k_idx * m) % ℓ) Q = Q := by
    intro m Q hQ_mon hm k_idx
    induction' k_idx with k_idx ih
    · simp [hσ_zero Q hQ_mon]
    · have h_mod : ((k_idx + 1) * m) % ℓ = (m + (k_idx * m) % ℓ) % ℓ := by
        rw [Nat.succ_mul, Nat.add_comm]
        conv_lhs => rw [Nat.add_mod]
        conv_rhs => rw [Nat.add_mod, Nat.mod_mod]
      rw [h_mod, ← hσ_add m ((k_idx * m) % ℓ) Q hQ_mon, ih, hm]
  have hτ_map_zero : ∀ (Q : Polynomial k_M),
      Polynomial.map (τ_L ^ 0).toRingHom Q = Q := by
    intro Q
    have h1 : (1 : k_M ≃ₐ[k_L] k_M).toRingHom = RingHom.id k_M := by ext x; rfl
    rw [pow_zero, h1, Polynomial.map_id]
  have hτ_map_add : ∀ (a b : ℕ) (Q : Polynomial k_M),
      Polynomial.map (τ_L ^ (a + b)).toRingHom Q =
        Polynomial.map (τ_L ^ a).toRingHom (Polynomial.map (τ_L ^ b).toRingHom Q) := by
    intro a b Q
    have hab : (τ_L ^ (a + b)).toRingHom = (τ_L ^ a).toRingHom.comp (τ_L ^ b).toRingHom := by
      rw [pow_add]
      ext x
      rfl
    rw [hab, ← Polynomial.map_map]
  have hτ_fix_mul : ∀ (u : ℕ) (Q : Polynomial k_M),
      Polynomial.map (τ_L ^ u).toRingHom Q = Q →
      ∀ (k : ℕ), Polynomial.map (τ_L ^ (u * k)).toRingHom Q = Q := by
    intro u Q hu k
    induction' k with k ih
    · rw [Nat.mul_zero, hτ_map_zero]
    · rw [Nat.mul_succ, Nat.add_comm, hτ_map_add u (u * k) Q, ih, hu]
  have h𝒩_L_pow : ∀ (A : Polynomial k_L), A.Monic → ∀ (n : ℕ),
      𝒩_ℓ_L (A ^ n) = (𝒩_ℓ_L A) ^ n := by
    intro A hA n
    induction' n with n ih
    · simp [h𝒩_L_one]
    · rw [pow_succ, h𝒩_L_mul (A ^ n) A (hA.pow n) hA, ih, pow_succ]
  have h𝒩_L_exp_map : ∀ (A : Polynomial k_L), A.Monic →
      Polynomial.expand k_M ℓ (Polynomial.map (algebraMap k_L k_M) (𝒩_ℓ_L A)) =
        ∏ m ∈ Finset.range ℓ, σ_M m (Polynomial.map (algebraMap k_L k_M) A) := by
    intro A hA
    have hmap_mon : (Polynomial.map (algebraMap k_L k_M) A).Monic :=
      hA.map (algebraMap k_L k_M)
    have hmap_deg : (Polynomial.map (algebraMap k_L k_M) A).natDegree = A.natDegree :=
      Polynomial.natDegree_map_eq_of_injective (algebraMap k_L k_M).injective A
    have hmem : Polynomial.map (algebraMap k_L k_M) A ∈ M_M A.natDegree :=
      (hM_M_mem A.natDegree _).mpr ⟨hmap_mon, hmap_deg⟩
    rw [h𝒩_L_map A hA, (h𝒩_M_prop A.natDegree _ hmem).2.1]
  have hNoShiftOne : ∀ (P : Polynomial k_L), P.Monic → Irreducible P →
      P.natDegree ≤ ℓ → P.coeff 0 ≠ 0 →
      ∀ (R : Polynomial k_M), R.Monic → Irreducible R →
        R ∣ Polynomial.map (algebraMap k_L k_M) P →
        σ_M 1 R ≠ R := by
    intro P hP_mon hP_irr hP_deg_le hP_c0 R hR_mon hR_irr hR_dvd h_fix
    have hmapP_mon : (Polynomial.map (algebraMap k_L k_M) P).Monic :=
      hP_mon.map (algebraMap k_L k_M)
    have hmapP_deg : (Polynomial.map (algebraMap k_L k_M) P).natDegree = P.natDegree :=
      Polynomial.natDegree_map_eq_of_injective (algebraMap k_L k_M).injective P
    have hR_deg_ge1 : 1 ≤ R.natDegree := hR_irr.natDegree_pos
    have hR_deg_le_P : R.natDegree ≤ P.natDegree := by
      rw [← hmapP_deg]
      exact Polynomial.natDegree_le_of_dvd hR_dvd hmapP_mon.ne_zero
    have hR_deg_le_ell : R.natDegree ≤ ℓ := hR_deg_le_P.trans hP_deg_le
    obtain ⟨C, hC_eq⟩ := hR_dvd
    have hR_c0 : R.coeff 0 ≠ 0 := by
      have hc0 : (Polynomial.map (algebraMap k_L k_M) P).coeff 0 = R.coeff 0 * C.coeff 0 := by
        rw [hC_eq, Polynomial.mul_coeff_zero]
      rw [Polynomial.coeff_map] at hc0
      have h_lhs_nz : algebraMap k_L k_M (P.coeff 0) ≠ 0 :=
        (map_ne_zero_iff (algebraMap k_L k_M) (algebraMap k_L k_M).injective).mpr hP_c0
      rw [hc0] at h_lhs_nz
      exact left_ne_zero_of_mul h_lhs_nz
    rcases lt_or_eq_of_le hR_deg_le_ell with hR_lt | hR_eq_ell
    · have hc0_fix := congr_arg (fun Q => Q.coeff 0) h_fix
      dsimp only at hc0_fix
      rw [hσ_coeff 1 R 0, Nat.one_mul, pow_zero, mul_one] at hc0_fix
      have h_inv_pow : (ζ⁻¹) ^ R.natDegree = 1 :=
        (mul_left_eq_self₀.mp hc0_fix).resolve_right hR_c0
      rw [inv_pow] at h_inv_pow
      have hζ_deg : ζ ^ R.natDegree = 1 := inv_eq_one.mp h_inv_pow
      exact hζ_prim R.natDegree hR_deg_ge1 hR_lt hζ_deg
    · have hP_deg_ell : P.natDegree = ℓ := le_antisymm hP_deg_le (hR_eq_ell ▸ hR_deg_le_P)
      have hC_mon : C.Monic := by
        apply Polynomial.Monic.of_mul_monic_left hR_mon
        rw [← hC_eq]
        exact hmapP_mon
      have hC_deg0 : C.natDegree = 0 := by
        have hdeg := hR_mon.natDegree_mul hC_mon
        rw [← hC_eq, hmapP_deg, hP_deg_ell, hR_eq_ell] at hdeg
        omega
      have hC_eq1 : C = 1 := Polynomial.eq_one_of_monic_natDegree_zero hC_mon hC_deg0
      have hmapP_eq_R : Polynomial.map (algebraMap k_L k_M) P = R := by
        rw [hC_eq, hC_eq1, mul_one]
      have hP_coeff_mid : ∀ k : ℕ, 1 ≤ k → k < ℓ → P.coeff k = 0 := by
        intro k hk1 hk_lt
        have hk_fix := congr_arg (fun Q => Q.coeff k) h_fix
        dsimp only at hk_fix
        rw [hσ_coeff 1 R k, hR_eq_ell, Nat.one_mul, pow_one, inv_pow, hζ_pow, inv_one,
          one_mul] at hk_fix
        have h_sub : R.coeff k * (ζ ^ k - 1) = 0 := by
          calc R.coeff k * (ζ ^ k - 1) = R.coeff k * ζ ^ k - R.coeff k := by ring
            _ = R.coeff k - R.coeff k := by rw [hk_fix]
            _ = 0 := sub_self _
        have hζk_ne : ζ ^ k - 1 ≠ 0 := sub_ne_zero.mpr (hζ_prim k hk1 hk_lt)
        have hR_k0 : R.coeff k = 0 := (mul_eq_zero.mp h_sub).resolve_right hζk_ne
        have hmap_k0 : algebraMap k_L k_M (P.coeff k) = 0 := by
          rw [← Polynomial.coeff_map, hmapP_eq_R, hR_k0]
        exact (map_eq_zero_iff (algebraMap k_L k_M) (algebraMap k_L k_M).injective).mp hmap_k0
      have hP_binom : P = Polynomial.X ^ ℓ + Polynomial.C (P.coeff 0) := by
        ext n
        rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, Polynomial.coeff_C]
        by_cases hn0 : n = 0
        · subst hn0
          rw [if_neg hPrime.ne_zero.symm, if_pos rfl, zero_add]
        · rw [if_neg hn0]
          by_cases hn_ell : n = ℓ
          · subst hn_ell
            rw [if_pos rfl, add_zero, ← hP_deg_ell, hP_mon.coeff_natDegree]
          · rw [if_neg hn_ell, add_zero]
            rcases lt_or_gt_of_ne hn_ell with hlt | hgt
            · exact hP_coeff_mid n (Nat.one_le_iff_ne_zero.mpr hn0) hlt
            · exact Polynomial.coeff_eq_zero_of_natDegree_lt (hP_deg_ell.symm ▸ hgt)
      have hNotDvd_one : ¬ (ℓ ∣ (Fintype.card k_L - 1)) := by
        have h1 := hNotDvd 1 le_rfl hf_H_gt1
        rwa [pow_one] at h1
      have h_cop : Nat.Coprime ℓ (Fintype.card k_L - 1) :=
        hPrime.coprime_iff_not_dvd.mpr hNotDvd_one
      let f_pow : k_L → k_L := fun x => x ^ ℓ
      have hf_inj : Function.Injective f_pow := by
        intro x y hxy
        dsimp [f_pow] at hxy
        by_cases hx0 : x = 0
        · subst hx0
          rw [zero_pow hPrime.ne_zero] at hxy
          exact (eq_zero_of_pow_eq_zero hxy.symm).symm
        · by_cases hy0 : y = 0
          · subst hy0
            rw [zero_pow hPrime.ne_zero] at hxy
            exact eq_zero_of_pow_eq_zero hxy
          · let u : k_Lˣ := Units.mk0 x hx0 * (Units.mk0 y hy0)⁻¹
            have hu_ell : u ^ ℓ = 1 := by
              ext
              push_cast [u]
              rw [Units.val_mk0 hx0, Units.val_mk0 hy0, mul_pow, inv_pow, hxy,
                mul_inv_cancel₀ (pow_ne_zero ℓ hy0)]
            have hu_card : u ^ (Fintype.card k_L - 1) = 1 := by
              rw [← Fintype.card_units, pow_card_eq_one]
            have h_dvd1 : orderOf u ∣ ℓ := orderOf_dvd_of_pow_eq_one hu_ell
            have h_dvd2 : orderOf u ∣ Fintype.card k_L - 1 := orderOf_dvd_of_pow_eq_one hu_card
            have h_dvd_gcd : orderOf u ∣ Nat.gcd ℓ (Fintype.card k_L - 1) :=
              Nat.dvd_gcd h_dvd1 h_dvd2
            rw [h_cop.gcd_eq_one] at h_dvd_gcd
            have hu_eq1 : u = 1 := orderOf_eq_one_iff.mp (Nat.dvd_one.mp h_dvd_gcd)
            have h_mk_eq : Units.mk0 x hx0 = Units.mk0 y hy0 := mul_inv_eq_one.mp hu_eq1
            exact congr_arg Units.val h_mk_eq
