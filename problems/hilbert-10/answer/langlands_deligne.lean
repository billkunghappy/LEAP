        ψ (((c_ν⁻¹ : Lˣ) : L) * (δ_T : L) * s_sq)
    else 0) :=
by
  intro ψE' ψM₁' z y_tr s_sq
  let C_z : K₁ := (C : K₁) *
    (1 + IntermediateField.inclusion hE'K₁ (δ_E : E') * IntermediateField.inclusion hM₁'K₁ z)
  obtain ⟨κ, hM₁'_term, hE'_term⟩ :=
    ld_ch12_wild_dyadic_unramified_min_cond_odd_biquad_norm_terms F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hdeg2 hdegE'K₁ hdegM₁'K₁
      ψ νE' hbE'_ge2 hT_odd θE' θM₁' θK₁ hχE'_comp hχM₁'_comp hMinEq hmE'_eq
      hval_LM₁' hval_norm_LM₁' hval_LE' htr_bound_LM₁' htr_bound_LE'
