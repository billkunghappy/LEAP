        β₂ + 4 * c₀ + 4 * c₀ ^ 2 := by
    intro c₀
    dsimp only
    have hh₁_eq : h₁ = IntermediateField.inclusion hLM₁' 0 + IntermediateField.inclusion hLM₁' 2 * x := by
      dsimp [h₁]
      simp only [map_zero, map_ofNat]
