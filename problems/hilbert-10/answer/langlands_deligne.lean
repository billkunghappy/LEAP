          calc (resDeg F K : ℤ)
            _ = (resDeg F K : ℤ) * valL F K (ϖK : K) := by rw [hϖK, mul_one]
            _ = relVal F K (ϖK : K) := (hdiv_K (ϖK : K)).symm
            _ = relVal F M_C (normLM F hM_CK (ϖK : K)) := (hrelVal_norm (ϖK : K)).symm
            _ = (resDeg F M_C : ℤ) * valL F M_C (zK : M_C) := hdiv_MC (zK : M_C)
            _ = (resDeg F M_C : ℤ) * ((ℓ : ℤ) * k) := by rw [hk]
            _ = ((ℓ * resDeg F M_C : ℕ) : ℤ) * k := by push_cast; ring
        have hdvd_int : ((ℓ * resDeg F M_C : ℕ) : ℤ) ∣ (resDeg F K : ℤ) := ⟨k, hrel_ϖK⟩
        have hdvd_nat : ℓ * resDeg F M_C ∣ resDeg F K := Int.ofNat_dvd.mp hdvd_int
