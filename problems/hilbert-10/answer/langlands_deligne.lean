  obtain ⟨w₂, hw₂_π⟩ := hsurj g₂
  have hμE_w₂ : μE w₂ = 1 := (hπ_HE w₂).mp (hw₂_π.symm ▸ hg₂_mem)
  have hμM₁_w₂_ne : μM₁ w₂ ≠ 1 := by
    intro h1
    exact hg₂_ne (hw₂_π ▸ (hπ_eq_one w₂).mpr ⟨hμE_w₂, h1⟩)
  have hAb_of_prime : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (hAB : A ≤ B), IsGaloisExt F A B →
      Nat.Prime (Module.finrank A (IntermediateField.extendScalars hAB)) →
      IsAbelianExt F hAB := by
    intro A B hAB hGalAB hp₀
    refine ⟨hGalAB.2.2.1, ?_, hGalAB.2.2.2 hAB⟩
    let B' := IntermediateField.extendScalars hAB
    let G_AB := B' ≃ₐ[A] B'
    haveI : FiniteDimensional F B := hGalAB.2.1
    haveI : FiniteDimensional F B' := hGalAB.2.1
    haveI : FiniteDimensional A B' := Module.Finite.of_restrictScalars_finite F A B'
    haveI : IsGalois A B' := hIsGalois_of_ext hAB hGalAB
    haveI : Normal A B' := IsGalois.to_normal
    haveI : Fact (Nat.Prime (Module.finrank A B')) := ⟨hp₀⟩
    have hcard_AB : Nat.card G_AB = Module.finrank A B' := IsGalois.card_aut_eq_finrank A B'
    haveI : IsCyclic G_AB := isCyclic_of_prime_card hcard_AB
    letI : CommGroup G_AB := IsCyclic.commGroup
    let res_A : A.fixingSubgroup →* G_AB :=
      (AlgEquiv.restrictNormalHom B').comp (IntermediateField.fixingSubgroupEquiv A).toMonoidHom
    have h_res_apply : ∀ (γ : A.fixingSubgroup) (x : B'),
        ((res_A γ x : B') : AlgebraicClosure F) = γ.1 x.1 := by
      intro γ x
      change ((AlgEquiv.restrictNormalHom B'
        ((IntermediateField.fixingSubgroupEquiv A) γ) x : B') : AlgebraicClosure F) = γ.1 x.1
      rw [AlgEquiv.restrictNormalHom_apply]
      rfl
    intro σ hσ τ hτ
    let s : A.fixingSubgroup := ⟨σ, hσ⟩
    let t : A.fixingSubgroup := ⟨τ, hτ⟩
    have hcomm1 : res_A (s * t * s⁻¹ * t⁻¹) = 1 := by
      rw [map_mul, map_mul, map_mul, map_inv, map_inv,
        mul_right_comm (res_A s) (res_A t) (res_A s)⁻¹,
        mul_inv_cancel, one_mul, mul_inv_cancel]
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    let x : B' := ⟨z, (IntermediateField.mem_extendScalars hAB).mpr hz⟩
    have hx : res_A (s * t * s⁻¹ * t⁻¹) x = x := by rw [hcomm1]; rfl
    have hx_val := congrArg Subtype.val hx
    rwa [h_res_apply (s * t * s⁻¹ * t⁻¹) x] at hx_val
  have hCommLK₁ : ∀ σ ∈ L.fixingSubgroup, ∀ τ ∈ L.fixingSubgroup,
      σ * τ * σ⁻¹ * τ⁻¹ ∈ K₁.fixingSubgroup := by
    intro σ hσ τ hτ
    rw [← hfix_sup_K₁]
    exact ⟨hAbLE.2.1 σ hσ τ hτ, hAbLM₁.2.1 σ hσ τ hτ⟩
  have h_cyc_ext : ∀ (W : Type u) [Group W] (N : Subgroup W) [hNorm : N.Normal]
      [Finite (W ⧸ N)] [IsCyclic (W ⧸ N)]
      (Ω₀ : Type) [Field Ω₀] [IsAlgClosed Ω₀] (χ_N : N →* Ω₀ˣ),
      (∀ (g : W) (n : N),
        χ_N ⟨g⁻¹ * (n : W) * g, hNorm.conj_mem' (n : W) n.2 g⟩ = χ_N n) →
      ∃ χ_W : W →* Ω₀ˣ, ∀ n : N, χ_W (n : W) = χ_N n := by
    intro W _ N hNorm _ _ Ω₀ _ _ χ_N h_inv
    obtain ⟨q₀, hq₀⟩ := IsCyclic.exists_monoid_generator (α := W ⧸ N)
    let g₀ : W := Quotient.out q₀
    have hg₀_mk : (QuotientGroup.mk g₀ : W ⧸ N) = q₀ := Quotient.out_eq q₀
    let m₀ : ℕ := orderOf q₀
    have hm₀_pos : 0 < m₀ := orderOf_pos q₀
    have hg₀_mem : g₀ ^ m₀ ∈ N := by
      rw [← QuotientGroup.eq_one_iff, QuotientGroup.mk_pow, hg₀_mk]
      exact pow_orderOf_eq_one q₀
