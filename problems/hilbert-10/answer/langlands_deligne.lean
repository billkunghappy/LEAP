      exact hvalL_mul_or (2 * (r : ℤ)) (2 * (r : ℤ)) 0
        ((1 + 4 * f) * Δ₀ * s₀' ^ 2) (Nu₁⁻¹) hp2 (Or.inr (le_of_eq hNu₁_inv_val.symm)) (by omega)
    have hψ_err₂ : ψ (((α'⁻¹ : Lˣ) : L) * ((1 + 4 * f) * Δ₀ * s₀' ^ 2 * Nu₁⁻¹)) = 1 :=
      hψ_alpha_inv _ herr₂_or
    have hsplit_tr :
        ((α'⁻¹ : Lˣ) : L) * traceLM F hLM₁' (Δ * z₁) =
          ((α'⁻¹ : Lˣ) : L) * Δ₁ * ((1 + 4 * f) * s₀' * Nu₁⁻¹) +
            ((α'⁻¹ : Lˣ) : L) * ((1 + 4 * f) * Δ₀ * s₀' ^ 2 * Nu₁⁻¹) := by
      rw [htr_Δz₁]; ring
    rw [hsplit_tr, ψ.map_add_eq_mul, hψ_err₂, mul_one] at hsub_one
    exact hsub_one
  
  have hΔ₁_val : Δ₁ = 0 ∨ 2 * (r : ℤ) - (b₁_ceil : ℤ) ≤ valL F L Δ₁ := by
    by_cases hΔ₁ : Δ₁ = 0
    · exact Or.inl hΔ₁
    · right
      by_contra hlt
      obtain ⟨x₁, hx₁_ne, hx₁_val, hx₁_ψ⟩ := hSpecL.2
      have hα'_ne : (α' : L) ≠ 0 := Units.ne_zero α'
      have h14f_inv_ne : (1 + 4 * f)⁻¹ ≠ 0 := inv_ne_zero h14f_props.1
      have h14f_inv_val : valL F L ((1 + 4 * f)⁻¹) = 0 := by
        rw [hvalL_inv_eq (1 + 4 * f) h14f_props.1, h14f_props.2, neg_zero]
      have hΔ₁_inv_ne : Δ₁⁻¹ ≠ 0 := inv_ne_zero hΔ₁
      have hΔ₁_inv_val : valL F L (Δ₁⁻¹) = - valL F L Δ₁ := hvalL_inv_eq Δ₁ hΔ₁
      set s₀' : L := (α' : L) * (1 + 4 * f)⁻¹ * Δ₁⁻¹ * x₁
      have hs₀'_b₁ : s₀' = 0 ∨ (b₁_ceil : ℤ) ≤ valL F L s₀' := by
        have hp1 : (α' : L) * (1 + 4 * f)⁻¹ = 0 ∨
            2 * (r : ℤ) + condExpChar F L ψ ≤ valL F L ((α' : L) * (1 + 4 * f)⁻¹) := by
          have hα'_or : (α' : L) = 0 ∨ 2 * (r : ℤ) + condExpChar F L ψ ≤ valL F L (α' : L) := by
            right; rw [hα'_val, hcond_E']; push_cast; omega
          exact hvalL_mul_or (2 * (r : ℤ) + condExpChar F L ψ)
            (2 * (r : ℤ) + condExpChar F L ψ) 0 (α' : L) ((1 + 4 * f)⁻¹)
            hα'_or (Or.inr (le_of_eq h14f_inv_val.symm)) (by omega)
        have hp2 : (α' : L) * (1 + 4 * f)⁻¹ * Δ₁⁻¹ = 0 ∨
            2 * (r : ℤ) + condExpChar F L ψ - valL F L Δ₁ ≤
              valL F L ((α' : L) * (1 + 4 * f)⁻¹ * Δ₁⁻¹) :=
          hvalL_mul_or (2 * (r : ℤ) + condExpChar F L ψ - valL F L Δ₁)
            (2 * (r : ℤ) + condExpChar F L ψ) (- valL F L Δ₁)
            ((α' : L) * (1 + 4 * f)⁻¹) (Δ₁⁻¹)
            hp1 (Or.inr (le_of_eq hΔ₁_inv_val.symm)) (by omega)
        exact hvalL_mul_or (b₁_ceil : ℤ)
          (2 * (r : ℤ) + condExpChar F L ψ - valL F L Δ₁) (-(condExpChar F L ψ + 1))
          ((α' : L) * (1 + 4 * f)⁻¹ * Δ₁⁻¹) x₁
          hp2 (Or.inr hx₁_val) (by omega)
      have hs₀'_r : s₀' = 0 ∨ (r : ℤ) ≤ valL F L s₀' :=
        hvalL_mono (b₁_ceil : ℤ) (r : ℤ) s₀' hs₀'_b₁ (by omega)
      obtain ⟨hNu₁_ne, hψ_s₀'⟩ := hRatPhase s₀' hs₀'_b₁
      set η : L := s₀' - f * s₀' ^ 2
      have h1η_ne : 1 + η ≠ 0 := by
        have heq : 1 + η = 1 + s₀' - f * s₀' ^ 2 := by dsimp [η]; ring
        rw [heq]; exact hNu₁_ne
      have hs₀'2_r : s₀' ^ 2 = 0 ∨ 2 * (r : ℤ) ≤ valL F L (s₀' ^ 2) :=
        hvalL_sq_or (2 * (r : ℤ)) (r : ℤ) s₀' hs₀'_r (by omega)
      have hfs₀'2_1 : f * s₀' ^ 2 = 0 ∨ 1 ≤ valL F L (f * s₀' ^ 2) :=
        hvalL_mul_or 1 (1 - 2 * (a : ℤ)) (2 * (r : ℤ)) f (s₀' ^ 2) hf_or hs₀'2_r (by omega)
      have hη_1 : η = 0 ∨ 1 ≤ valL F L η :=
        hvalL_sub 1 (r : ℤ) 1 s₀' (f * s₀' ^ 2) hs₀'_r hfs₀'2_1 (by omega) le_rfl
      have h1η_val : valL F L (1 + η) = 0 :=
        (hvalL_eq_of_lt 0 1 1 η one_ne_zero hvalL_1 hη_1 (by omega)).2
      have h1η_inv_val : valL F L ((1 + η)⁻¹) = 0 := by
        rw [hvalL_inv_eq (1 + η) h1η_ne, h1η_val, neg_zero]
      have harg_eq :
          ((α'⁻¹ : Lˣ) : L) * Δ₁ * ((1 + 4 * f) * s₀' * (1 + s₀' - f * s₀' ^ 2)⁻¹) =
            x₁ * (1 + η)⁻¹ := by
        have heq_η : 1 + s₀' - f * s₀' ^ 2 = 1 + η := by dsimp [η]; ring
        rw [heq_η]
        dsimp [s₀']
        have hα'_inv : ((α'⁻¹ : Lˣ) : L) * (α' : L) = 1 := Units.inv_mul α'
        have h14f_inv : (1 + 4 * f) * (1 + 4 * f)⁻¹ = 1 := mul_inv_cancel₀ h14f_props.1
        have hΔ₁_inv : Δ₁ * Δ₁⁻¹ = 1 := mul_inv_cancel₀ hΔ₁
        linear_combination
          ((1 + 4 * f) * (1 + 4 * f)⁻¹ * Δ₁ * Δ₁⁻¹ * x₁ * (1 + η)⁻¹) * hα'_inv +
          (Δ₁ * Δ₁⁻¹ * x₁ * (1 + η)⁻¹) * h14f_inv +
          (x₁ * (1 + η)⁻¹) * hΔ₁_inv
      rw [harg_eq] at hψ_s₀'
      have hx₁_η_or : x₁ * η * (1 + η)⁻¹ = 0 ∨
          -condExpChar F L ψ ≤ valL F L (x₁ * η * (1 + η)⁻¹) := by
        have hp1 : x₁ * η = 0 ∨ -condExpChar F L ψ ≤ valL F L (x₁ * η) :=
          hvalL_mul_or (-condExpChar F L ψ) (-(condExpChar F L ψ + 1)) 1
            x₁ η (Or.inr hx₁_val) hη_1 (by omega)
        exact hvalL_mul_or (-condExpChar F L ψ) (-condExpChar F L ψ) 0
          (x₁ * η) ((1 + η)⁻¹) hp1 (Or.inr (le_of_eq h1η_inv_val.symm)) (by omega)
      have hψ_x₁_η : ψ (x₁ * η * (1 + η)⁻¹) = 1 := hSpecL.1 _ hx₁_η_or
      have hx₁_decomp : x₁ = x₁ * (1 + η)⁻¹ + x₁ * η * (1 + η)⁻¹ := by
        have h1η_inv : (1 + η) * (1 + η)⁻¹ = 1 := mul_inv_cancel₀ h1η_ne
        linear_combination -x₁ * h1η_inv
      have hψ_x₁ : ψ x₁ = 1 := by
        rw [hx₁_decomp, ψ.map_add_eq_mul, hψ_s₀', hψ_x₁_η, mul_one]
      exact hx₁_ψ hψ_x₁
  refine ⟨hN₁_props, hΔ₁_val, ?_⟩
  intro z hz_val hz
  have hz_b₁ : z = 0 ∨ (b₁ : ℤ) ≤ valL F M₁' z := by
    rw [hm1_half] at hz_val
    exact hz_val
  have hΔ_or : Δ = 0 ∨ 4 * (r : ℤ) - (b₁ : ℤ) - 2 * (a : ℤ) ≤ valL F M₁' Δ := by
    have hιΔ₀ : ι Δ₀ = 0 ∨ 4 * (r : ℤ) - (b₁ : ℤ) - 2 * (a : ℤ) ≤ valL F M₁' (ι Δ₀) :=
      hvalM₁'_incl (4 * (r : ℤ) - (b₁ : ℤ) - 2 * (a : ℤ)) ((r : ℤ) - (ha_half : ℤ))
        Δ₀ hΔ₀_or (by omega)
    have hιΔ₁x : ι Δ₁ * x = 0 ∨ 4 * (r : ℤ) - (b₁ : ℤ) - 2 * (a : ℤ) ≤ valL F M₁' (ι Δ₁ * x) :=
      hvalM₁'_incl_x (4 * (r : ℤ) - (b₁ : ℤ) - 2 * (a : ℤ)) (2 * (r : ℤ) - (b₁_ceil : ℤ))
        Δ₁ hΔ₁_val (by omega)
    exact hvalM₁'_add (4 * (r : ℤ) - (b₁ : ℤ) - 2 * (a : ℤ))
      (4 * (r : ℤ) - (b₁ : ℤ) - 2 * (a : ℤ)) (4 * (r : ℤ) - (b₁ : ℤ) - 2 * (a : ℤ))
      (ι Δ₀) (ι Δ₁ * x) hιΔ₀ hιΔ₁x le_rfl le_rfl
  have hΔz_or :
      ι ((α'⁻¹ : Lˣ) : L) * (Δ * z) = 0 ∨
        -condExpChar F M₁' (traceChar F hLM₁' ψ) ≤ valL F M₁' (ι ((α'⁻¹ : Lˣ) : L) * (Δ * z)) := by
    have hια'_inv :
        ι ((α'⁻¹ : Lˣ) : L) = 0 ∨
          -2 * (2 * (r : ℤ) + condExpChar F L ψ) ≤ valL F M₁' (ι ((α'⁻¹ : Lˣ) : L)) :=
      hvalM₁'_incl (-2 * (2 * (r : ℤ) + condExpChar F L ψ))
        (-(2 * (r : ℤ) + condExpChar F L ψ)) ((α'⁻¹ : Lˣ) : L)
        (Or.inr (le_of_eq hα'_inv_val.symm)) (by omega)
    have hΔz : Δ * z = 0 ∨ 4 * (r : ℤ) - 2 * (a : ℤ) ≤ valL F M₁' (Δ * z) :=
      hvalM₁'_mul_or (4 * (r : ℤ) - 2 * (a : ℤ))
        (4 * (r : ℤ) - (b₁ : ℤ) - 2 * (a : ℤ)) (b₁ : ℤ)
        Δ z hΔ_or hz_b₁ (by omega)
    rw [hnM₁', hcond_M₁']
    exact hvalM₁'_mul_or (-(2 * condExpChar F L ψ + ((2 * a : ℕ) : ℤ)))
      (-2 * (2 * (r : ℤ) + condExpChar F L ψ)) (4 * (r : ℤ) - 2 * (a : ℤ))
      (ι ((α'⁻¹ : Lˣ) : L)) (Δ * z) hια'_inv hΔz (by omega)
  have hψM₁'_Δz : (traceChar F hLM₁' ψ) (ι ((α'⁻¹ : Lˣ) : L) * (Δ * z)) = 1 :=
    hSpecM₁' _ hΔz_or
  have hα_mul_inv : ι ((α'⁻¹ : Lˣ) : L) * ι (α' : L) = 1 := by
    rw [← map_mul, Units.inv_mul, map_one]
  have hc_θ₁_z_decomp :
      ((c_θ₁⁻¹ : M₁'ˣ) : M₁') * z =
        ι ((α'⁻¹ : Lˣ) : L) * N₁ * z + ι ((α'⁻¹ : Lˣ) : L) * (Δ * z) := by
    linear_combination
      -(((c_θ₁⁻¹ : M₁'ˣ) : M₁') * z) * hα_mul_inv +
      (ι ((α'⁻¹ : Lˣ) : L) * z) * hΔ_eq
  rw [hc_θ₁_stat z hz_val hz, hc_θ₁_z_decomp, AddChar.map_add_eq_mul, hψM₁'_Δz, mul_one]

theorem ld_ch12_wild_dyadic_even_breaks_higher_cond_lower_covectors_and_quad_phase (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hSpecL : (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1))
    (hSpecE' : ∀ y : E',
      (y = 0 ∨ -condExpChar F E' (traceChar F hLE' ψ) ≤ valL F E' y) →
        (traceChar F hLE' ψ) y = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hval_normE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_normM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hnE' : condExpChar F E' (traceChar F hLE' ψ) =
      2 * condExpChar F L ψ + (condExp F L νE' : ℤ))
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_even : condExp F L νE' % 2 = 0)
    (h2_val : (2 : L) = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L (2 : L))
    (x : M₁') (y : E') (f g d : L)
    (hf_ne : f ≠ 0) (hg_ne : g ≠ 0) (hd_ne : d ≠ 0)
    (hf_val : valL F L f = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hg_val : valL F L g = (1 - 2 * ((condExp F L νE' / 2 : ℕ) : ℤ)))
    (hd_val : valL F L d = (((condExp F L νE' / 2 : ℕ) : ℤ) - ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hx_tr : traceLM F hLM₁' x = -1)
    (hy_tr : traceLM F hLE' y = -1)
    (hnorm_h₁ : normLM F hLM₁' (2 * x - IntermediateField.inclusion hLM₁' d) = d ^ 2 + 2 * d - 4 * f)
    (hnorm_h₂ : normLM F hLE' (2 * IntermediateField.inclusion hLE' d * y - 1) = 1 + 2 * d - 4 * d ^ 2 * g)
    (hβ₁ : d ^ 2 + 2 * d - 4 * f ≠ 0) (hβ₂ : 1 + 2 * d - 4 * d ^ 2 * g ≠ 0)
    (α' : Lˣ)
    (hα'_val : valL F L (α' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_ν₂'_stat : ∀ u : L, (u = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) =
          ψ (((((α' * (Units.mk0 (1 + 2 * d - 4 * d ^ 2 * g) hβ₂)⁻¹)⁻¹ : Lˣ) : L) * u)))
    (hc_ν₁'_stat : ∀ u : L, (u = 0 ∨ ((condExp F L νM₁' / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νM₁' (Units.mk0 (1 + u) hu) : Ω F) =
          ψ (((((α' * (Units.mk0 (d ^ 2 + 2 * d - 4 * f) hβ₁)⁻¹)⁻¹ : Lˣ) : L) * u)))
    (hNormPhaseM₁'' : ∀ v : M₁', (v = 0 ∨ ((condExp F L νM₁' / 2 : ℕ) : ℤ) ≤ valL F M₁' v) →
      ψ (((α'⁻¹ : Lˣ) : L) * (d ^ 2 + 2 * d - 4 * f) *
        (traceLM F hLM₁' v + normLM F hLM₁' v)) = 1) :
    let a := condExp F L νM₁' / 2
    let r := condExp F L νE' / 2
    let h₁ : M₁' := 2 * x - IntermediateField.inclusion hLM₁' d
    let h₂ : E' := 2 * IntermediateField.inclusion hLE' d * y - 1
    let β₁ : L := d ^ 2 + 2 * d - 4 * f
    let β₂ : L := 1 + 2 * d - 4 * d ^ 2 * g
    let cνE' : Lˣ := α' * (Units.mk0 β₂ hβ₂)⁻¹
    let cνM₁' : Lˣ := α' * (Units.mk0 β₁ hβ₁)⁻¹
    valL F L (cνE' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ ∧
    (∀ u : L, (u = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
