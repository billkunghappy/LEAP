    let n_K₁ : N_U := ⟨⟨w_K₁.1, relWeil_antitone F hUK₁ w_K₁.2⟩, w_K₁.2⟩
    exact hχU_ext n_K₁
  have hχU_weil : IsWeilRep F U (charRep F U χU) := by
    refine ⟨Module.Finite.equiv (ULift.moduleEquiv (R := Ω F) (M := Ω F)).symm, ?_⟩
    rcases hInvK₁.1.2 with ⟨U₀, hU₀_nhds, hU₀_triv⟩
    have hK₁_nhds : (K₁.fixingSubgroup : Set (AbsGal F)) ∈ nhds (1 : AbsGal F) :=
      (krullTopology_mem_nhds_one_iff F (AlgebraicClosure F)
        (K₁.fixingSubgroup : Set (AbsGal F))).mpr ⟨K₁, inferInstance, Set.Subset.rfl⟩
    refine ⟨U₀ ∩ (K₁.fixingSubgroup : Set (AbsGal F)), Filter.inter_mem hU₀_nhds hK₁_nhds, ?_⟩
    intro w hwU hwI
    let w_K₁ : relWeil F K₁ := ⟨w.1, w.2.1, hwU.2⟩
    have hw_triv : charRep F K₁ χK₁ w_K₁ = 1 := hU₀_triv w_K₁ hwU.1 hwI
    have hχ_eq : χU w = χK₁ w_K₁ := by
      rw [← hχU_rest]
      rfl
    change (χU w : Ω F) • LinearMap.id = 1
    rw [hχ_eq]
    exact hw_triv
  have hψU : IsAdmissibleChar F U (traceChar F hLU ψ) :=
    ld_traceChar_admissible F L U hLU hAbLU.2.2 ψ hψ
  
  have hU_nhds : (U.fixingSubgroup : Set (AbsGal F)) ∈ nhds (1 : AbsGal F) :=
    (krullTopology_mem_nhds_one_iff F (AlgebraicClosure F)
      (U.fixingSubgroup : Set (AbsGal F))).mpr ⟨U, inferInstance, Set.Subset.rfl⟩
  have hμU_weil : IsWeilRep F L (charRep F L μU) := by
    refine ⟨inferInstance, (U.fixingSubgroup : Set (AbsGal F)), hU_nhds, fun w hwU _ => ?_⟩
    have h1 : μU w = 1 := (hμU_ker w).mp hwU
    apply LinearMap.ext
    intro v
    change (μU w : Ω F) • v = v
    rw [h1, Units.val_one, one_smul]
  have hμU_pow : μU ^ ℓ = 1 := by
    apply MonoidHom.ext
    intro w
    change ((μE w) ^ a * μM₁ w) ^ ℓ = 1
    rw [mul_pow, ← pow_mul, mul_comm a ℓ, pow_mul, hμE_pow_val w, hμM₁_pow_val w,
      one_pow, mul_one]
  have hνU_rec : ∀ x : Lˣ, νU x = μU (rec.recMap L x) := by
    intro x
    change (νE x) ^ a * νM₁ x = (μE (rec.recMap L x)) ^ a * μM₁ (rec.recMap L x)
    rw [hνE_rec x, hνM₁_rec x]
  have hνU_pow : νU ^ ℓ = 1 := by
    apply MonoidHom.ext
    intro x
    rw [MonoidHom.pow_apply, MonoidHom.one_apply, hνU_rec x, ← MonoidHom.pow_apply,
      hμU_pow, MonoidHom.one_apply]
  have hνU_ne : νU ≠ 1 := by
    intro h1
    have hμU_w₁_ne : μU w₁ ≠ 1 := by
      change (μE w₁) ^ a * μM₁ w₁ ≠ 1
      rw [hμM₁_w₁, mul_one]
      exact fun hza => hμE_w₁_ne ((h_pow_a_eq_one a ha_lt ha_pos (μE w₁) (hμE_pow_val w₁)).mp hza)
    obtain ⟨x, hx⟩ := rec.surj_rec L U hLU hAbLU w₁
    have htriv : μU ((rec.recMap L x)⁻¹ * w₁) = 1 := (hμU_ker _).mp hx
    rw [map_mul, map_inv, inv_mul_eq_one] at htriv
    have hx1 : νU x = 1 := by rw [h1, MonoidHom.one_apply]
    rw [hνU_rec x, htriv] at hx1
    exact hμU_w₁_ne hx1
  have hνU_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLU)) ↔ νU x = 1 := by
    intro x
    rw [hνU_rec x, ← hμU_ker (rec.recMap L x), rec.ker_rec L U hLU hAbLU x]
    refine ⟨?_, ?_⟩
    · rintro ⟨y, rfl⟩
      exact ⟨(y : U), rfl⟩
    · rintro ⟨z, hz⟩
      haveI : Module.Finite L (IntermediateField.extendScalars hLU) :=
        Module.finite_of_finrank_pos (hdegLU.symm ▸ hPrime.pos)
      have hz_ne : z ≠ 0 := by
        intro h0
        have hnorm0 : normLM F hLU z = 0 := by
          rw [h0]
          exact Algebra.norm_zero (R := L) (S := IntermediateField.extendScalars hLU)
        rw [hnorm0] at hz
        exact Units.ne_zero x hz.symm
      exact ⟨Units.mk0 z hz_ne, Units.ext hz⟩
  have hνU_cond : ∀ j < ℓ, ∀ u ∈ unitGroup F L (condExp F L (νU ^ j)), (νU ^ j) u = 1 := by
    intro j _
    have hμUj_weil : IsWeilRep F L (charRep F L (μU ^ j)) := by
      refine ⟨inferInstance, (U.fixingSubgroup : Set (AbsGal F)), hU_nhds, fun w hwU _ => ?_⟩
      have h1 : (μU ^ j) w = 1 := by
        rw [MonoidHom.pow_apply, (hμU_ker w).mp hwU, one_pow]
      apply LinearMap.ext
      intro v
      change ((μU ^ j) w : Ω F) • v = v
      rw [h1, Units.val_one, one_smul]
    have hνUj_rec : ∀ x : Lˣ, (νU ^ j) x = (μU ^ j) (rec.recMap L x) := by
      intro x
      rw [MonoidHom.pow_apply, MonoidHom.pow_apply, hνU_rec x]
    exact (ld_separable_weil_char_rec_and_norm F rec).1 L (μU ^ j) hμUj_weil (νU ^ j) hνUj_rec
  exact ⟨U, inferInstance, hLU, hUK₁, χU,
    hGalLU, hGalUK₁, hAbLU, hAbUK₁, hdegLU, hdegUK₁,
    h_inf_EU, h_sup_EU, h_inf_M₁U, h_sup_M₁U,
    hχU_weil, hχU_rest, hψU,
    hμU_weil, hμU_ker, hμU_pow, hνU_rec,
    hνU_pow, hνU_ne, hνU_ker, hνU_cond⟩

theorem ld_ch12_wild_odd_base_min_cond_and_pow_prod (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hCondE' : condExp F L νE' = 0 ∨ 2 ≤ condExp F L νE')
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hνM₁'E'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * νE')), (νM₁' ^ j * νE') u = 1)
    (hMinLe : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE'))
    (hNormFactor : ∀ x : Lˣ, ∃ (y : E'ˣ) (z : M₁'ˣ),
      x = Units.map (normLM F hLE') y * Units.map (normLM F hLM₁') z) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLE')
    2 ≤ condExp F L νE' ∧
    (∀ j < ℓ,
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE') ∧
      condExp F L (νM₁' ^ j * νE') = condExp F L νE') ∧
    (∀ j < ℓ,
      condExp F L νM₁' ≤ condExp F L (νE' ^ j * νM₁') ∧
      (0 < j → condExp F L (νE' ^ j * νM₁') = condExp F L νE')) ∧
    (∀ (ν : Lˣ →* (Ω F)ˣ), ν ^ ℓ = 1 →
      ∀ x : Lˣ, (∏ j ∈ Finset.range ℓ, (ν ^ j) x) = 1) :=
by
  intro ℓ
  letI : CommGroup (Ω F)ˣ := inferInstance
  letI : CommGroup (Lˣ →* (Ω F)ˣ) := inferInstance
  have halg : ∀ z : L,
      minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
      ∃ m : ℕ,
        Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
        Module.finrank F L = (minpoly F z).natDegree * m := by
    intro z
    have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
      minpoly.algHom_eq L.val L.val.injective z
    have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
    let pb := IntermediateField.adjoin.powerBasis hz
    have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
      IntermediateField.adjoin.powerBasis_gen hz
    have hmin_gen : minpoly F pb.gen = minpoly F z := by
      have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
        rw [hpb_gen]
        rfl
      rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
        (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
    have hpb_dim : pb.dim = (minpoly F z).natDegree := by
      rw [IntermediateField.adjoin.powerBasis_dim hz]
    have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
    rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
    refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
    rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
  let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
      b ≠ 0 ∧ addVal F b ≤ addVal F a := by
    intro a b ha hab
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
    have hφb : φ (valuation F b) ≠ 0 := by
      intro h0
      rw [h0] at hφ_le
      exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
    have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
    have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
    refine ⟨hb, ?_⟩
    rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
    unfold addVal
    rw [dif_neg ha, dif_neg hb]
    exact neg_le_neg hφ_le
  have haddVal0 : addVal F 0 = 0 := by
    unfold addVal
    exact dif_pos rfl
  have haddVal1 : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
    have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
    unfold addVal
    rw [dif_neg h1]
    have hunz : WithZero.unzero hφ1 = 1 := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
    rw [hunz, toAdd_one, neg_zero]
  have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
    have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
    have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
    have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
    unfold addVal
    rw [dif_neg hab, dif_neg ha, dif_neg hb]
    have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
        WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
    rw [hunz, toAdd_mul, neg_add]
  have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
    intro a n ha
    have han : a ^ n ≠ 0 := pow_ne_zero n ha
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
    have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
    unfold addVal
    rw [dif_neg han, dif_neg ha]
    have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
        WithZero.coe_pow, WithZero.coe_unzero]
    rw [hunz, toAdd_pow]
    simp
  have hrel0 : relVal F L 0 = 0 := by
    unfold relVal
    rw [Algebra.norm_zero, haddVal0]
  have hrel1 : relVal F L 1 = 0 := by
    unfold relVal
    rw [map_one, haddVal1]
  have hrel_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → relVal F L (x * y) = relVal F L x + relVal F L y := by
    intro x y hx hy
    have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
    have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
    unfold relVal
    rw [map_mul, haddVal_mul _ _ hnx hny]
  have hrel_neg1 : relVal F L (-1) = 0 := by
    have hne : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
    have hsq : relVal F L ((-1 : L) * (-1 : L)) = relVal F L (-1) + relVal F L (-1) :=
      hrel_mul (-1) (-1) hne hne
    have h1 : (-1 : L) * (-1 : L) = 1 := by ring
    rw [h1, hrel1] at hsq
    omega
  have hrel_neg : ∀ x : L, relVal F L (-x) = relVal F L x := by
    intro x
    by_cases hx : x = 0
    · simp [hx]
    · have hne1 : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hneg_eq : (-x : L) = (-1 : L) * x := by ring
      rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
  have hrel_inv : ∀ u : Lˣ, relVal F L ((u⁻¹ : Lˣ) : L) = - relVal F L (u : L) := by
    intro u
    have hmul : relVal F L ((u : L) * ((u⁻¹ : Lˣ) : L)) =
        relVal F L (u : L) + relVal F L ((u⁻¹ : Lˣ) : L) :=
      hrel_mul (u : L) ((u⁻¹ : Lˣ) : L) (Units.ne_zero u) (Units.ne_zero u⁻¹)
    rw [Units.mul_inv, hrel1] at hmul
    omega
  have hrel_pow : ∀ (u : Lˣ) (n : ℕ),
      relVal F L (((u ^ n : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L) := by
    intro u n
    induction n with
    | zero =>
      simp [hrel1]
    | succ n ih =>
      rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
      push_cast
      ring
  have hrel_zpow : ∀ (u : Lˣ) (m : ℤ),
      relVal F L (((u ^ m : Lˣ) : L)) = m * relVal F L (u : L) := by
    intro u m
    cases m with
    | ofNat n =>
      change relVal F L (((u ^ (n : ℤ) : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L)
      rw [zpow_natCast, hrel_pow]
    | negSucc n =>
      rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
      push_cast
      ring
  obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
    (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
  have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
    rw [hπ]
    exact φ.apply_symm_apply _
  have hφπ_ne : φ (valuation F π) ≠ 0 := by
    rw [hφπ]
    exact WithZero.coe_ne_zero
  have hπ_ne : π ≠ 0 := by
    intro h0
    apply hφπ_ne
    simp [h0]
  have hadd_π : addVal F π = 1 := by
    unfold addVal
    rw [dif_neg hπ_ne]
    have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
    rw [hunz, toAdd_ofAdd, neg_neg]
  let x₀ : L := algebraMap F L π
  have hx₀_ne : x₀ ≠ 0 := by
    simp [x₀, hπ_ne]
  have hrel_x₀ : relVal F L x₀ = (Module.finrank F L : ℤ) := by
    unfold relVal
    rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F L) hπ_ne, hadd_π, mul_one]
  have hfin_pos : 0 < Module.finrank F L := Module.finrank_pos
  let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : L, x ≠ 0 ∧ relVal F L x = k}
  have hS_nonempty : S.Nonempty := ⟨Module.finrank F L, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
  have hfL_mem : resDeg F L ∈ S := Nat.sInf_mem hS_nonempty
  obtain ⟨hfL_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfL_mem
  let ϖ_L : Lˣ := Units.mk0 ϖ₀ hϖ₀_ne
  have hrel_ϖL : relVal F L (ϖ_L : L) = (resDeg F L : ℤ) := hrel_ϖ₀
  have hfL_int_pos : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hfL_pos
  have hfL_int_ne : (resDeg F L : ℤ) ≠ 0 := ne_of_gt hfL_int_pos
  have hdiv : ∀ x : L, relVal F L x = (resDeg F L : ℤ) * valL F L x := by
    intro x
    by_cases hx : x = 0
    · unfold valL
      rw [hx, hrel0, Int.zero_ediv, mul_zero]
    · set f : ℤ := (resDeg F L : ℤ)
      set q : ℤ := valL F L x
      set r : ℤ := relVal F L x % f
      have hediv : f * q + r = relVal F L x := Int.mul_ediv_add_emod (relVal F L x) f
      have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F L x) hfL_int_ne
      have hr_lt : r < f := Int.emod_lt_of_pos (relVal F L x) hfL_int_pos
      have hr_zero : r = 0 := by
        by_contra hr_ne
        have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
        let y : L := x * (((ϖ_L ^ (-q) : Lˣ) : L))
        have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
        have hrel_y : relVal F L y = r := by
          dsimp [y]
          rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖ_L (-q), hrel_ϖL]
          linarith
        let k : ℕ := r.toNat
        have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
        have hk_pos : 0 < k := by omega
        have hk_lt : k < resDeg F L := by omega
        have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
        have hle : resDeg F L ≤ k := Nat.sInf_le hk_mem
        omega
      linarith
  have hval1 : valL F L 1 = 0 := by
    have h := hdiv 1
    rw [hrel1] at h
    exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
  have hval_neg1 : valL F L (-1) = 0 := by
    have h := hdiv (-1)
    rw [hrel_neg1] at h
    exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
  have hval_neg : ∀ x : L, valL F L (-x) = valL F L x := by
    intro x
    apply mul_left_cancel₀ hfL_int_ne
    rw [← hdiv (-x), ← hdiv x, hrel_neg]
  have hval_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y := by
    intro x y hx hy
    apply mul_left_cancel₀ hfL_int_ne
    rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
  have hval_inv : ∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L) := by
    intro u
    apply mul_left_cancel₀ hfL_int_ne
    rw [mul_neg, ← hdiv, ← hdiv, hrel_inv]
  have hϖ : valL F L (ϖ_L : L) = 1 := by
    apply mul_left_cancel₀ hfL_int_ne
    rw [← hdiv, hrel_ϖL, mul_one]
  have hval_add : ∀ (k : ℤ) (x y : L),
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x + y = 0 ∨ k ≤ valL F L (x + y)) := by
    letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
    haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
    haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
      Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
    letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
    haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
    have hspec_pow : ∀ z : L,
        (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F L) =
          ‖Algebra.norm F z‖ := by
      intro z
      obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg z
      have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
          ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
        rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
      have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
        rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
        exact_mod_cast minpoly.natDegree_pos hz
      rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
         ← Real.rpow_natCast]
      congr 1
      push_cast
      rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
    have hspec_le : ∀ w z : L, w ≠ 0 →
        spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
          spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
        z ≠ 0 ∧ valL F L z ≤ valL F L w := by
      intro w z hw hle
      have hpow_le :
          (spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F)) ^ (Module.finrank F L) ≤
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F L) :=
        pow_le_pow_left₀ (spectralNorm_nonneg _) hle _
      rw [hspec_pow w, hspec_pow z] at hpow_le
      have hv_eq : ∀ a : F, ‖a‖ =
          ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
            (valuation F a) : ℝ) := fun a => rfl
      rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hpow_le
      have hv_le : valuation F (Algebra.norm F w) ≤ valuation F (Algebra.norm F z) :=
        (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp
          hpow_le
      have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
      obtain ⟨hnz, hrel_le⟩ := hval_le (Algebra.norm F w) (Algebra.norm F z) hnw hv_le
      have hz : z ≠ 0 := Algebra.norm_ne_zero_iff.mp hnz
      refine ⟨hz, ?_⟩
      exact Int.ediv_le_ediv hfL_int_pos hrel_le
    intro k x y hx hy
    by_cases hxy : x + y = 0
    · exact Or.inl hxy
    · right
      have hcoe : ((x + y : L) : AlgebraicClosure F) =
          (x : AlgebraicClosure F) + (y : AlgebraicClosure F) := rfl
      have hna := isNonarchimedean_spectralNorm (K := F)
        (x : AlgebraicClosure F) (y : AlgebraicClosure F)
      rw [← hcoe, le_max_iff] at hna
      rcases hna with hle_x | hle_y
      · obtain ⟨hx_ne, hval_x⟩ := hspec_le (x + y) x hxy hle_x
        have hkx : k ≤ valL F L x := hx.resolve_left hx_ne
        exact le_trans hkx hval_x
      · obtain ⟨hy_ne, hval_y⟩ := hspec_le (x + y) y hxy hle_y
        have hky : k ≤ valL F L y := hy.resolve_left hy_ne
        exact le_trans hky hval_y
  have hgen_val0 : ∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
      ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1)) → valL F L (u : L) = 0 := by
    intro a ha u hu
    rcases hu with hu1 | hua
    · rw [hu1, hval1]
    · have h_ge0 : (0 : ℤ) ≤ valL F L (u : L) := by
        have hadd := hval_add 0 ((u : L) - 1) 1 (Or.inr (by omega)) (Or.inr (by rw [hval1]))
        have heq : ((u : L) - 1) + 1 = (u : L) := sub_add_cancel (u : L) 1
        rw [heq] at hadd
        exact hadd.resolve_left (Units.ne_zero u)
      have h_le0 : valL F L (u : L) ≤ 0 := by
        by_contra hlt
        have hge1 : (1 : ℤ) ≤ valL F L (-(u : L)) := by
          rw [hval_neg]
          omega
        have hadd := hval_add 1 ((u : L) - 1) (-(u : L)) (Or.inr (by omega)) (Or.inr hge1)
        have heq : ((u : L) - 1) + (-(u : L)) = -1 := by ring
        rw [heq, hval_neg1] at hadd
        have hne : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have h10 : (1 : ℤ) ≤ 0 := hadd.resolve_left hne
        omega
      omega
  have hUG_anti : ∀ ⦃a b : ℕ⦄, a ≤ b → unitGroup F L b ≤ unitGroup F L a := by
    intro a b hab
    unfold unitGroup
    apply Subgroup.closure_mono
    intro u hu
    simp only [Set.mem_setOf_eq] at hu ⊢
    split_ifs at hu with hb0 <;> split_ifs with ha0
    · exact hu
    · omega
    · exact hgen_val0 b (by omega) u hu
    · rcases hu with h1 | hge
      · exact Or.inl h1
      · exact Or.inr (le_trans (by exact_mod_cast hab) hge)
  have hpow_mod : ∀ (θ : Lˣ →* (Ω F)ˣ), θ ^ ℓ = 1 → ∀ n : ℕ, θ ^ n = θ ^ (n % ℓ) := by
    intro θ hθ n
    conv_lhs => rw [← Nat.div_add_mod n ℓ]
    rw [pow_add, pow_mul, hθ, one_pow, one_mul]
  have hpow_recov : ∀ (θ : Lˣ →* (Ω F)ˣ), θ ^ ℓ = 1 → ∀ k : ℕ, ¬ (ℓ ∣ k) →
      ∃ m < ℓ, (θ ^ k) ^ m = θ := by
    intro θ hθ k hk
    have hk_cop : k.Coprime ℓ := (hPrime.coprime_iff_not_dvd.mpr hk).symm
    obtain ⟨m, hm_lt, hm⟩ := Nat.exists_mul_mod_eq_one_of_coprime hk_cop hPrime.one_lt
    refine ⟨m, hm_lt, ?_⟩
    rw [← pow_mul, hpow_mod θ hθ (k * m), hm, pow_one]
  have hcond_pow : ∀ (θ : Lˣ →* (Ω F)ˣ), θ ^ ℓ = 1 → ∀ k : ℕ, ¬ (ℓ ∣ k) →
      condExp F L (θ ^ k) = condExp F L θ := by
    intro θ hθ k hk
    obtain ⟨m, _, h_recov⟩ := hpow_recov θ hθ k hk
    have h_iff : ∀ u : Lˣ, (θ ^ k) u = 1 ↔ θ u = 1 := by
      intro u
      constructor
      · intro hu
        calc θ u = ((θ ^ k) ^ m) u := by rw [h_recov]
          _ = ((θ ^ k) u) ^ m := MonoidHom.pow_apply (θ ^ k) m u
          _ = 1 ^ m := by rw [hu]
          _ = 1 := one_pow m
      · intro hu
        rw [MonoidHom.pow_apply, hu, one_pow]
    unfold condExp
    congr 1
    ext a
    simp only [Set.mem_setOf_eq, h_iff]
  have hbM₁'_le_bE' : condExp F L νM₁' ≤ condExp F L νE' := by
    have h0 := hMinLe 0 hPrime.pos
    rwa [pow_zero, one_mul] at h0
  have hMinM₁' : ∀ j < ℓ,
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE') ∧
      condExp F L (νM₁' ^ j * νE') = condExp F L νE' := by
    intro j hj
    refine ⟨hMinLe j hj, ?_⟩
    rcases Nat.eq_zero_or_pos j with rfl | hj_pos
    · rw [pow_zero, one_mul]
    · have hndvd : ¬ (ℓ ∣ j) := Nat.not_dvd_of_pos_of_lt hj_pos hj
      have hcj : condExp F L (νM₁' ^ j) = condExp F L νM₁' :=
        hcond_pow νM₁' hνM₁'_pow j hndvd
      apply le_antisymm
      · apply Nat.sInf_le
        intro u hu
        have huM : u ∈ unitGroup F L (condExp F L (νM₁' ^ j)) := by
          apply hUG_anti _ hu
          rw [hcj]
          exact hbM₁'_le_bE'
        have h1 : (νM₁' ^ j) u = 1 := hνM₁'_cond j hj u huM
        have h2 : νE' u = 1 := by
          have h := hνE'_cond 1 hPrime.one_lt u
          rw [pow_one] at h
          exact h hu
        rw [MonoidHom.mul_apply, h1, h2, mul_one]
      · apply Nat.sInf_le
        intro u hu
        have huM : u ∈ unitGroup F L (condExp F L (νM₁' ^ j)) := by
          apply hUG_anti _ hu
          rw [hcj]
          exact hMinLe j hj
        have h1 : (νM₁' ^ j) u = 1 := hνM₁'_cond j hj u huM
        have h12 : (νM₁' ^ j * νE') u = 1 := hνM₁'E'_cond j hj u hu
        rw [MonoidHom.mul_apply, h1, one_mul] at h12
        exact h12
  have hMinE' : ∀ j < ℓ,
      condExp F L νM₁' ≤ condExp F L (νE' ^ j * νM₁') ∧
      (0 < j → condExp F L (νE' ^ j * νM₁') = condExp F L νE') := by
    intro j hj
    rcases Nat.eq_zero_or_pos j with rfl | hj_pos
    · rw [pow_zero, one_mul]
      exact ⟨le_rfl, fun h => False.elim (lt_irrefl 0 h)⟩
    · have hndvd_j : ¬ (ℓ ∣ j) := Nat.not_dvd_of_pos_of_lt hj_pos hj
      have hj_cop : j.Coprime ℓ := (hPrime.coprime_iff_not_dvd.mpr hndvd_j).symm
      obtain ⟨k, hk_lt, hjk_mod⟩ := Nat.exists_mul_mod_eq_one_of_coprime hj_cop hPrime.one_lt
      have hndvd_k : ¬ (ℓ ∣ k) := by
        intro hdvd
        have h0 : (j * k) % ℓ = 0 := Nat.mod_eq_zero_of_dvd (dvd_mul_of_dvd_right hdvd j)
        omega
      have h_pow_ell : (νE' ^ j * νM₁') ^ ℓ = 1 := by
        rw [mul_pow, pow_right_comm νE' j ℓ, hνE'_pow, hνM₁'_pow, one_pow, mul_one]
      have h_pow_k : (νE' ^ j * νM₁') ^ k = νM₁' ^ k * νE' := by
        rw [mul_pow, ← pow_mul, hpow_mod νE' hνE'_pow (j * k), hjk_mod, pow_one, mul_comm]
      have heq : condExp F L (νE' ^ j * νM₁') = condExp F L νE' := by
        calc condExp F L (νE' ^ j * νM₁')
          _ = condExp F L ((νE' ^ j * νM₁') ^ k) :=
              (hcond_pow (νE' ^ j * νM₁') h_pow_ell k hndvd_k).symm
          _ = condExp F L (νM₁' ^ k * νE') := by rw [h_pow_k]
          _ = condExp F L νE' := (hMinM₁' k hk_lt).2
      exact ⟨heq ▸ hbM₁'_le_bE', fun _ => heq⟩
  have hbE'_ge2 : 2 ≤ condExp F L νE' := by
    rcases hCondE' with h0E | hge2
    · exfalso
      have h0M : condExp F L νM₁' = 0 := Nat.eq_zero_of_le_zero (h0E ▸ hbM₁'_le_bE')
      have hνE'_ug0 : ∀ u ∈ unitGroup F L 0, νE' u = 1 := by
        intro u hu
        have h := hνE'_cond 1 hPrime.one_lt u
        rw [pow_one, h0E] at h
        exact h hu
      have hνM₁'_ug0 : ∀ u ∈ unitGroup F L 0, νM₁' u = 1 := by
        intro u hu
        have h := hνM₁'_cond 1 hPrime.one_lt u
        rw [pow_one, h0M] at h
        exact h hu
      have hval_units_mul : ∀ u v : Lˣ,
          valL F L ((u * v : Lˣ) : L) = valL F L (u : L) + valL F L (v : L) :=
        fun u v => hval_mul (u : L) (v : L) u.ne_zero v.ne_zero
      have hval_npow : ∀ n : ℕ, valL F L ((ϖ_L ^ n : Lˣ) : L) = (n : ℤ) := by
        intro n
        induction n with
        | zero => simp [hval1]
        | succ n ih =>
          rw [pow_succ, hval_units_mul, ih, hϖ, Nat.cast_add, Nat.cast_one]
      have hval_zpow : ∀ m : ℤ, valL F L ((ϖ_L ^ m : Lˣ) : L) = m := by
        intro m
        cases m with
        | ofNat n => exact hval_npow n
        | negSucc n =>
          rw [zpow_negSucc, hval_inv, hval_npow (n + 1)]
          rfl
      have hchar_eval : ∀ (θ : Lˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F L 0, θ u = 1) →
          ∀ x : Lˣ, θ x = (θ ϖ_L) ^ (valL F L (x : L)) := by
        intro θ hθ_ug0 x
        set m := valL F L (x : L)
        let u : Lˣ := x * (ϖ_L ^ m)⁻¹
        have hu_val : valL F L (u : L) = 0 := by
          change valL F L (((x * (ϖ_L ^ m)⁻¹ : Lˣ) : L)) = 0
          rw [hval_units_mul, hval_inv, hval_zpow, add_neg_cancel]
        have hu_mem : u ∈ unitGroup F L 0 := by
          unfold unitGroup
          apply Subgroup.subset_closure
          simpa using hu_val
        have hx_eq : x = u * ϖ_L ^ m := by
          dsimp [u]
          exact (inv_mul_cancel_right x (ϖ_L ^ m)).symm
        calc θ x = θ (u * ϖ_L ^ m) := congrArg θ hx_eq
          _ = θ u * θ (ϖ_L ^ m) := map_mul θ u (ϖ_L ^ m)
          _ = 1 * (θ ϖ_L) ^ m := by rw [hθ_ug0 u hu_mem, map_zpow]
          _ = (θ ϖ_L) ^ m := one_mul _
      have hval_dvd : ∀ (θ : Lˣ →* (Ω F)ˣ),
          θ ^ ℓ = 1 → θ ≠ 1 → (∀ u ∈ unitGroup F L 0, θ u = 1) →
          ∀ x : Lˣ, θ x = 1 → (ℓ : ℤ) ∣ valL F L (x : L) := by
        intro θ hθ_pow hθ_ne hθ_ug0 x hx1
        set m := valL F L (x : L)
        have hℓ_pos_Z : (0 : ℤ) < (ℓ : ℤ) := by exact_mod_cast hPrime.pos
        have hmod_nonneg : 0 ≤ m % (ℓ : ℤ) := Int.emod_nonneg m (ne_of_gt hℓ_pos_Z)
        have hmod_lt : m % (ℓ : ℤ) < (ℓ : ℤ) := Int.emod_lt_of_pos m hℓ_pos_Z
        set r : ℕ := (m % (ℓ : ℤ)).toNat
        have hr_Z : (r : ℤ) = m % (ℓ : ℤ) := Int.toNat_of_nonneg hmod_nonneg
        have hr_lt : r < ℓ := by exact_mod_cast (hr_Z.trans_lt hmod_lt)
        have hm_decomp : (ℓ : ℤ) * (m / (ℓ : ℤ)) + (r : ℤ) = m := by
          rw [hr_Z]
          exact Int.mul_ediv_add_emod m (ℓ : ℤ)
        have hθ_varpi_ell : (θ ϖ_L) ^ (ℓ : ℤ) = 1 := by
          rw [zpow_natCast, ← MonoidHom.pow_apply, hθ_pow, MonoidHom.one_apply]
        have hθ_varpi_m : (θ ϖ_L) ^ m = 1 := by
          rw [← hchar_eval θ hθ_ug0 x, hx1]
        have hθr_varpi : (θ ^ r) ϖ_L = 1 := by
          rw [MonoidHom.pow_apply, ← zpow_natCast]
          have h1 : (θ ϖ_L) ^ ((ℓ : ℤ) * (m / (ℓ : ℤ)) + (r : ℤ)) = 1 := by
            rw [hm_decomp, hθ_varpi_m]
          rw [zpow_add, zpow_mul, hθ_varpi_ell, one_zpow, one_mul] at h1
          exact h1
        have hθr_ug0 : ∀ u ∈ unitGroup F L 0, (θ ^ r) u = 1 := by
          intro u hu
          rw [MonoidHom.pow_apply, hθ_ug0 u hu, one_pow]
        have hθr_eq1 : θ ^ r = 1 := by
          ext w
          rw [hchar_eval (θ ^ r) hθr_ug0 w, hθr_varpi, one_zpow, MonoidHom.one_apply]
        have hr_zero : r = 0 := by
          by_contra hr_ne0
          have hr_pos : 0 < r := Nat.pos_of_ne_zero hr_ne0
          have hndvd_r : ¬ (ℓ ∣ r) := Nat.not_dvd_of_pos_of_lt hr_pos hr_lt
          obtain ⟨k, _, hrec⟩ := hpow_recov θ hθ_pow r hndvd_r
          rw [hθr_eq1, one_pow] at hrec
          exact hθ_ne hrec.symm
        refine ⟨m / (ℓ : ℤ), ?_⟩
        rw [hr_zero, Nat.cast_zero, add_zero] at hm_decomp
        exact hm_decomp.symm
      obtain ⟨y, z, hϖ_fact⟩ := hNormFactor ϖ_L
      set x₁ := Units.map (normLM F hLE') y
      set x₂ := Units.map (normLM F hLM₁') z
      have hx₁_ker : νE' x₁ = 1 := (hνE'_ker x₁).mp ⟨y, rfl⟩
      have hx₂_ker : νM₁' x₂ = 1 := (hνM₁'_ker x₂).mp ⟨z, rfl⟩
      have hdvd₁ : (ℓ : ℤ) ∣ valL F L (x₁ : L) :=
        hval_dvd νE' hνE'_pow hνE'_ne hνE'_ug0 x₁ hx₁_ker
      have hdvd₂ : (ℓ : ℤ) ∣ valL F L (x₂ : L) :=
        hval_dvd νM₁' hνM₁'_pow hνM₁'_ne hνM₁'_ug0 x₂ hx₂_ker
      have hval_sum : valL F L (x₁ : L) + valL F L (x₂ : L) = 1 := by
        rw [← hval_units_mul x₁ x₂, ← hϖ_fact, hϖ]
      have hdvd_one : (ℓ : ℤ) ∣ 1 := hval_sum ▸ dvd_add hdvd₁ hdvd₂
      have hℓ_le1 : (ℓ : ℤ) ≤ 1 := Int.le_of_dvd zero_lt_one hdvd_one
      have hℓ_ge2 : 2 ≤ ℓ := hPrime.two_le
      omega
    · exact hge2
  have hPowProd : ∀ (ν : Lˣ →* (Ω F)ˣ), ν ^ ℓ = 1 →
      ∀ x : Lˣ, (∏ j ∈ Finset.range ℓ, (ν ^ j) x) = 1 := by
    intro ν hν_pow x
    have hℓ_ne2 : ℓ ≠ 2 := hWild.trans_ne hp_odd
    have hℓ_odd : ℓ % 2 = 1 := (Nat.Prime.eq_two_or_odd hPrime).resolve_left hℓ_ne2
    set d : ℕ := (ℓ - 1) / 2
    have hd : ℓ - 1 = 2 * d := by omega
    have hdiv2 : ℓ * (ℓ - 1) / 2 = ℓ * d := by
      rw [hd, show ℓ * (2 * d) = 2 * (ℓ * d) by ring, Nat.mul_div_right _ (by omega)]
    have hcongr : (∏ j ∈ Finset.range ℓ, (ν ^ j) x) = ∏ j ∈ Finset.range ℓ, (ν x) ^ j := by
      apply Finset.prod_congr rfl
      intro j _
      exact MonoidHom.pow_apply ν j x
    have hνx_ell : (ν x) ^ ℓ = 1 := by
      rw [← MonoidHom.pow_apply, hν_pow, MonoidHom.one_apply]
    rw [hcongr, Finset.prod_pow_eq_pow_sum, Finset.sum_range_id, hdiv2, pow_mul, hνx_ell, one_pow]
  exact ⟨hbE'_ge2, hMinM₁', hMinE', hPowProd⟩

theorem ld_ch12_wild_step_norm_comp_cond_bounds (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L₀ K₀ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L₀] [FiniteDimensional F K₀]
    (hL₀K₀ : L₀ ≤ K₀) (hGal : IsGaloisExt F L₀ K₀) (hAb : IsAbelianExt F hL₀K₀)
    (hPrime : Nat.Prime (Module.finrank L₀ (IntermediateField.extendScalars hL₀K₀)))
    (hWild : Module.finrank L₀ (IntermediateField.extendScalars hL₀K₀) = p F)
    (ψ₀ : AddChar L₀ (Ω F)) (hψ₀ : IsAdmissibleChar F L₀ ψ₀)
    (ν₁ θ : L₀ˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L₀ (IntermediateField.extendScalars hL₀K₀)) = 1)
    (hν₁_ne : ν₁ ≠ 1)
    (hν₁_ker : ∀ x : L₀ˣ, x ∈ Set.range (Units.map (normLM F hL₀K₀)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L₀ (IntermediateField.extendScalars hL₀K₀),
      ∀ u ∈ unitGroup F L₀ (condExp F L₀ (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hθ_cond : ∀ j < Module.finrank L₀ (IntermediateField.extendScalars hL₀K₀),
      ∀ u ∈ unitGroup F L₀ (condExp F L₀ (ν₁ ^ j * θ)), (ν₁ ^ j * θ) u = 1)
    (hθK₀_cond : ∀ u ∈ unitGroup F K₀ (condExp F K₀ (θ.comp (Units.map (normLM F hL₀K₀)))),
      (θ.comp (Units.map (normLM F hL₀K₀))) u = 1)
    (hMinCond : ∀ j < Module.finrank L₀ (IntermediateField.extendScalars hL₀K₀),
      condExp F L₀ θ ≤ condExp F L₀ (ν₁ ^ j * θ)) :
    IsAdmissibleChar F K₀ (traceChar F hL₀K₀ ψ₀) ∧
    (condExp F L₀ (ν₁ * θ) = condExp F L₀ θ →
      condExp F L₀ ν₁ ≤ condExp F L₀ θ) ∧
    (condExp F L₀ θ ≤ condExp F L₀ ν₁ →
      condExp F K₀ (θ.comp (Units.map (normLM F hL₀K₀))) = condExp F L₀ θ) ∧
    (condExp F L₀ ν₁ = 0 →
      condExp F K₀ (θ.comp (Units.map (normLM F hL₀K₀))) = condExp F L₀ θ) ∧
    (condExp F L₀ ν₁ ≤ condExp F L₀ θ →
      condExp F L₀ ν₁ ≤ condExp F K₀ (θ.comp (Units.map (normLM F hL₀K₀)))) :=
by
  letI : CommGroup (Ω F)ˣ := inferInstance
  letI : CommGroup (L₀ˣ →* (Ω F)ˣ) := inferInstance
  have hψK₀ : IsAdmissibleChar F K₀ (traceChar F hL₀K₀ ψ₀) :=
    ld_traceChar_admissible F L₀ K₀ hL₀K₀ hAb.2.2 ψ₀ hψ₀
  have hLb : condExp F L₀ (ν₁ * θ) = condExp F L₀ θ →
      condExp F L₀ ν₁ ≤ condExp F L₀ θ := by
    intro hEq
    have hmem : condExp F L₀ θ ∈ {a : ℕ | ∀ u ∈ unitGroup F L₀ a, ν₁ u = 1} := by
      intro u hu
      have h0 := hθ_cond 0 hPrime.pos u
      rw [pow_zero, one_mul] at h0
      have hθ_u : θ u = 1 := h0 hu
      have h1 := hθ_cond 1 hPrime.one_lt u
      rw [pow_one, hEq] at h1
      have hνθ_u : (ν₁ * θ) u = 1 := h1 hu
      rw [MonoidHom.mul_apply, hθ_u, mul_one] at hνθ_u
      exact hνθ_u
    exact Nat.sInf_le hmem
  by_cases hUnram : condExp F L₀ ν₁ = 0
  · obtain ⟨_, hval_norm, hval_alg, _, _, _, hUnramRest⟩ :=
      ld_ch10_unramified_arith_and_twist_reduction F L₀ K₀ hL₀K₀ hGal hAb hPrime ψ₀ hψ₀ ν₁ θ
        hν₁_pow hν₁_ne hν₁_ker hν₁_cond hθ_cond hθK₀_cond hMinCond hUnram
        (fun {_} ψ' hψ' χ' => ld_condExp_and_condExpChar_spec F L₀ ψ' hψ' χ')
        (fun {_} ψK hψK θK => ld_condExp_and_condExpChar_spec F K₀ ψK hψK θK)
        (fun {_} a ha => ld_unitCoset_finite F L₀ a ha)
    obtain ⟨htr_bound, hy₁, hnorm_lin1, _⟩ :=
      ld_ch10_unramified_residue_galois_bridge F L₀ K₀ hL₀K₀ hGal hPrime hval_norm hval_alg
    obtain ⟨_, _, hcond_eq, _⟩ := hUnramRest htr_bound hy₁ hnorm_lin1
    refine ⟨hψK₀, hLb, fun _ => hcond_eq, fun _ => hcond_eq, fun hle => ?_⟩
    rw [hcond_eq]
    exact hle
  · obtain ⟨_, _, _, _, _, hCond_le, hCond_gt, _⟩ :=
      ld_ch10_wild_ramification_and_cond_formulas F L₀ K₀ hL₀K₀ hGal hAb hPrime ψ₀ hψ₀ ν₁ θ
        hν₁_pow hν₁_ne hν₁_ker hν₁_cond hθ_cond hθK₀_cond hMinCond hUnram hWild
    refine ⟨hψK₀, hLb, fun hle => (hCond_le hle).1, fun h0 => absurd h0 hUnram, fun hle => ?_⟩
    rcases lt_or_eq_of_le hle with hlt | heq
    · rw [(hCond_gt hlt).1]
      exact Nat.le_add_right (condExp F L₀ ν₁) _
    · rw [(hCond_le (le_of_eq heq.symm)).1, heq]

theorem ld_ch12_wild_odd_bicyclic_diamond_rec_and_cond_package (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hAbLE' : IsAbelianExt F hLE') (hAbLM₁' : IsAbelianExt F hLM₁')
    (hAbE'K₁ : IsAbelianExt F hE'K₁) (hAbM₁'K₁ : IsAbelianExt F hM₁'K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (h_inf : E' ⊓ M₁' = L) (h_sup : E' ⊔ M₁' = K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁)
    (hneK₁ : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE'.trans hE'K₁) χL = χK₁)
    (χE' : relWeil F E' →* (Ω F)ˣ) (hχE'_weil : IsWeilRep F E' (charRep F E' χE'))
    (hχE'_rest : restrictWeilChar F hE'K₁ χE' = χK₁)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ) (hχM₁'_weil : IsWeilRep F M₁' (charRep F M₁' χM₁'))
    (hχM₁'_rest : restrictWeilChar F hM₁'K₁ χM₁' = χK₁)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (μE' μM₁' : relWeil F L →* (Ω F)ˣ) (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hμE'_weil : IsWeilRep F L (charRep F L μE'))
    (hμE'_ker : ∀ w : relWeil F L, (w : AbsGal F) ∈ E'.fixingSubgroup ↔ μE' w = 1)
    (hμE'_pow : μE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_rec : ∀ x : Lˣ, νE' x = μE' (rec.recMap L x))
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hCondE' : condExp F L νE' = 0 ∨ 2 ≤ condExp F L νE')
    (hμM₁'_weil : IsWeilRep F L (charRep F L μM₁'))
    (hμM₁'_ker : ∀ w : relWeil F L, (w : AbsGal F) ∈ M₁'.fixingSubgroup ↔ μM₁' w = 1)
    (hμM₁'_pow : μM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_rec : ∀ x : Lˣ, νM₁' x = μM₁' (rec.recMap L x))
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hCondM₁' : condExp F L νM₁' = 0 ∨ 2 ≤ condExp F L νM₁')
    (hMinLe : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE')) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLE')
    (∀ j < ℓ, ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * νE')), (νM₁' ^ j * νE') u = 1) ∧
    (∀ j < ℓ, ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j * νM₁')), (νE' ^ j * νM₁') u = 1) ∧
    2 ≤ condExp F L νE' ∧
    (∀ j < ℓ,
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE') ∧
      condExp F L (νM₁' ^ j * νE') = condExp F L νE') ∧
    (∀ j < ℓ,
      condExp F L νM₁' ≤ condExp F L (νE' ^ j * νM₁') ∧
      (0 < j → condExp F L (νE' ^ j * νM₁') = condExp F L νE')) ∧
    (∀ x : Lˣ, ∃ (y : E'ˣ) (z : M₁'ˣ),
      x = Units.map (normLM F hLE') y * Units.map (normLM F hLM₁') z) ∧
    (recChar F rec E' χE').comp (Units.map (normLM F hE'K₁)) = recChar F rec K₁ χK₁ ∧
    (recChar F rec M₁' χM₁').comp (Units.map (normLM F hM₁'K₁)) = recChar F rec K₁ χK₁ ∧
    (∀ u ∈ unitGroup F K₁ (condExp F K₁ (recChar F rec K₁ χK₁)),
      (recChar F rec K₁ χK₁) u = 1) ∧
    2 ≤ condExp F E' (recChar F rec E' χE') ∧
    (∀ j < ℓ,
      let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
      (∀ y : E'ˣ, y ∈ Set.range (Units.map (normLM F hE'K₁)) ↔ ξE' y = 1) ∧
      (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j)), (ξE' ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j * recChar F rec E' χE')),
        (ξE' ^ j * recChar F rec E' χE') u = 1) ∧
      condExp F E' (ξE' ^ j * recChar F rec E' χE') =
        condExp F E' (recChar F rec E' χE')) ∧
    2 ≤ condExp F M₁' (recChar F rec M₁' χM₁') ∧
    (∀ j < ℓ,
      let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
      (∀ z : M₁'ˣ, z ∈ Set.range (Units.map (normLM F hM₁'K₁)) ↔ ξM₁' z = 1) ∧
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j)), (ξM₁' ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j * recChar F rec M₁' χM₁')),
        (ξM₁' ^ j * recChar F rec M₁' χM₁') u = 1) ∧
      condExp F M₁' (ξM₁' ^ j * recChar F rec M₁' χM₁') =
        condExp F M₁' (recChar F rec M₁' χM₁')) ∧
    (∀ x : Lˣ,
      (recChar F rec E' χE') (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) =
      (recChar F rec M₁' χM₁') (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x)) :=
by
  intro ℓ
  obtain ⟨_, _, _, _, _, _, _, _, _, hDiamondNorm_all⟩ :=
    ld_ch12_bicyclic_galois_abelian_and_third_subfield F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLK₁ hGalLE' hGalLM₁' hGalE'K₁ hGalM₁'K₁
      hPrime hdegM₁' hdegE'K₁ hdegM₁'K₁ h_inf h_sup χK₁ hInvK₁
  have hDiamondNorm_E' :=
    hDiamondNorm_all E' M₁' hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLE' hGalM₁'K₁ rfl hdegM₁'K₁ h_sup
  have hAutInv_E' :=
    ld_ch12_galois_aut_weil_recChar_invariance F rec L E' hLE' hGalLE' ψ hψ χE' hχE'_weil
  obtain ⟨hNormFact, hχE'_comp, hχK₁'_cond, _, hξE'_pow, hξE'_ne,
      hξE'_pack, hνE'_νM₁'_cond, hCommonRest_E'⟩ :=
    ld_ch12_bicyclic_branch_conjugate_twists_and_norm_eval F rec L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLE' hGalE'K₁ hAbLE' hAbLM₁' hAbE'K₁ hAbM₁'K₁
      hPrime hdegM₁' hdegE'K₁ h_sup hDiamondNorm_E'
      χK₁ hInvK₁ hneK₁ χE' hχE'_weil hχE'_rest χM₁' hχM₁'_weil hχM₁'_rest
      ψ hψ hAutInv_E' μE' μM₁' νE' νM₁'
      hμE'_weil hμE'_ker hνE'_rec hνE'_pow hνE'_ne hνE'_ker
      hμM₁'_weil hμM₁'_ker hμM₁'_pow hνM₁'_rec hνM₁'_pow hνM₁'_ne hνM₁'_ker
  have h_sup_symm : M₁' ⊔ E' = K₁ := by rw [sup_comm, h_sup]
  have hDiamondNorm_M₁' :=
    hDiamondNorm_all M₁' E' hLM₁' hLE' hM₁'K₁ hE'K₁ hGalLM₁' hGalE'K₁ hdegM₁' hdegE'K₁
      h_sup_symm
  have hAutInv_M₁' :=
    ld_ch12_galois_aut_weil_recChar_invariance F rec L M₁' hLM₁' hGalLM₁' ψ hψ χM₁' hχM₁'_weil
  have hPrime_M₁' : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLM₁')) := by
    rw [hdegM₁']
    exact hPrime
  have hdegM₁'_symm :
      Module.finrank L (IntermediateField.extendScalars hLE') =
        Module.finrank L (IntermediateField.extendScalars hLM₁') := hdegM₁'.symm
  have hdegM₁'K₁_M₁' :
      Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
        Module.finrank L (IntermediateField.extendScalars hLM₁') :=
    hdegM₁'K₁.trans hdegM₁'.symm
  have hνM₁'_pow₀ : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLM₁')) = 1 :=
    hdegM₁'.symm ▸ hνM₁'_pow
  obtain ⟨_, hχM₁'_comp, _, _, hξM₁'_pow₀, hξM₁'_ne,
      hξM₁'_pack₀, hνM₁'_νE'_cond₀, hCommonRest_M₁'₀⟩ :=
    ld_ch12_bicyclic_branch_conjugate_twists_and_norm_eval F rec L M₁' E' K₁
      hLM₁' hLE' hM₁'K₁ hE'K₁ hGalLM₁' hGalM₁'K₁ hAbLM₁' hAbLE' hAbM₁'K₁ hAbE'K₁
      hPrime_M₁' hdegM₁'_symm hdegM₁'K₁_M₁' h_sup_symm hDiamondNorm_M₁'
      χK₁ hInvK₁ hneK₁ χM₁' hχM₁'_weil hχM₁'_rest χE' hχE'_weil hχE'_rest
      ψ hψ hAutInv_M₁' μM₁' μE' νM₁' νE'
      hμM₁'_weil hμM₁'_ker hνM₁'_rec hνM₁'_pow₀ hνM₁'_ne hνM₁'_ker
      hμE'_weil hμE'_ker (hdegM₁'.symm ▸ hμE'_pow) hνE'_rec (hdegM₁'.symm ▸ hνE'_pow) hνE'_ne hνE'_ker
  set ψE' := traceChar F hLE' ψ
  set ψM₁' := traceChar F hLM₁' ψ
  set χE'' := recChar F rec E' χE'
  set χM₁'' := recChar F rec M₁' χM₁'
  set χK₁' := recChar F rec K₁ χK₁
  set ξE' := νM₁'.comp (Units.map (normLM F hLE'))
  set ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
  have hξM₁'_pow : ξM₁' ^ ℓ = 1 := by simpa only [hdegM₁'] using hξM₁'_pow₀
  have hξM₁'_pack : ∀ j < ℓ,
      (∀ z : M₁'ˣ, z ∈ Set.range (Units.map (normLM F hM₁'K₁)) ↔ ξM₁' z = 1) ∧
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j)), (ξM₁' ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j * χM₁'')), (ξM₁' ^ j * χM₁'') u = 1) ∧
      condExp F M₁' (ξM₁' ^ j * χM₁'') = condExp F M₁' χM₁'' ∧
      tateEps F M₁' (ξM₁' ^ j * χM₁'') ψM₁' = tateEps F M₁' χM₁'' ψM₁' := by
    simpa only [hdegM₁'] using hξM₁'_pack₀
  have hνM₁'_νE'_cond : ∀ j < ℓ, ∀ k < ℓ,
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * νE' ^ k)), (νM₁' ^ j * νE' ^ k) u = 1 := by
    simpa only [hdegM₁'] using hνM₁'_νE'_cond₀
  have hCommonRest_M₁' : ∀ z : M₁'ˣ,
      let x := Units.map (normLM F hLM₁') z
      χM₁'' (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x) *
        (∏ j ∈ Finset.range ℓ, (νM₁' ^ j) x) =
      χE'' (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) *
        (∏ j ∈ Finset.range ℓ, (νE' ^ j) x) := by
    simpa only [hdegM₁'] using hCommonRest_M₁'₀
  have hpow_one : ∀ {A : Type u} [Monoid A] (θ : A →* (Ω F)ˣ), θ ^ (1 : ℕ) = θ :=
    fun θ => MonoidHom.ext fun u => by rw [MonoidHom.pow_apply, pow_one]
  have hνM₁'E'_cond : ∀ j < ℓ, ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * νE')),
      (νM₁' ^ j * νE') u = 1 := by
    intro j hj
    have h1 := hνM₁'_νE'_cond j hj 1 hPrime.one_lt
    rw [hpow_one] at h1
    exact h1
  have hνE'M₁'_cond : ∀ j < ℓ, ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j * νM₁')),
      (νE' ^ j * νM₁') u = 1 := by
    intro j hj
    have h1 := hνE'_νM₁'_cond j hj 1 hPrime.one_lt
    rw [hpow_one] at h1
    exact h1
  obtain ⟨hbE'_ge2, hMinM₁', hMinE', hPowProd⟩ :=
    ld_ch12_wild_odd_base_min_cond_and_pow_prod F L E' M₁' hLE' hLM₁'
      hPrime hWild hp_odd νE' νM₁'
      hνE'_pow hνE'_ne hνE'_ker hνE'_cond hCondE'
      hνM₁'_pow hνM₁'_ne hνM₁'_ker hνM₁'_cond hνM₁'E'_cond hMinLe hNormFact
  have hCommonRest : ∀ x : Lˣ,
      χE'' (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) =
      χM₁'' (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x) := by
    intro x
    obtain ⟨y, z, rfl⟩ := hNormFact x
    set x₁ := Units.map (normLM F hLE') y
    set x₂ := Units.map (normLM F hLM₁') z
    have h1 : χE'' (Units.map (IntermediateField.inclusion hLE').toMonoidHom x₁) *
        (∏ j ∈ Finset.range ℓ, (νE' ^ j) x₁) =
      χM₁'' (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x₁) *
        (∏ j ∈ Finset.range ℓ, (νM₁' ^ j) x₁) := hCommonRest_E' y
    have h2 : χE'' (Units.map (IntermediateField.inclusion hLE').toMonoidHom x₂) *
        (∏ j ∈ Finset.range ℓ, (νE' ^ j) x₂) =
      χM₁'' (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x₂) *
        (∏ j ∈ Finset.range ℓ, (νM₁' ^ j) x₂) := (hCommonRest_M₁' z).symm
    rw [hPowProd νE' hνE'_pow x₁, hPowProd νM₁' hνM₁'_pow x₁, mul_one, mul_one] at h1
    rw [hPowProd νE' hνE'_pow x₂, hPowProd νM₁' hνM₁'_pow x₂, mul_one, mul_one] at h2
    rw [map_mul, map_mul, map_mul, map_mul, h1, h2]
  have hbM₁'_le_bE' : condExp F L νM₁' ≤ condExp F L νE' := by
    rw [← (hMinM₁' 0 hPrime.pos).2]
    exact (hMinM₁' 0 hPrime.pos).1
  have hξE'_cond1 : ∀ u ∈ unitGroup F E' (condExp F E' ξE'), ξE' u = 1 := by
    have h1 := (hξE'_pack 1 hPrime.one_lt).2.1
    rw [hpow_one] at h1
    exact h1
  obtain ⟨hψE', _, hEdge1_low, _, _⟩ :=
    ld_ch12_wild_step_norm_comp_cond_bounds F L E' hLE' hGalLE' hAbLE'
      hPrime hWild ψ hψ νE' νM₁'
      hνE'_pow hνE'_ne hνE'_ker hνE'_cond hνE'M₁'_cond hξE'_cond1
      (fun j hj => (hMinE' j hj).1)
  have hξE'_cond_eq : condExp F E' ξE' = condExp F L νM₁' := hEdge1_low hbM₁'_le_bE'
  have hWild_M₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') = p F :=
    hdegM₁'.trans hWild
  have hνM₁'_cond₀ : ∀ j < Module.finrank L (IntermediateField.extendScalars hLM₁'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1 := by
    simpa only [hdegM₁'] using hνM₁'_cond
  have hνM₁'E'_cond₀ : ∀ j < Module.finrank L (IntermediateField.extendScalars hLM₁'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * νE')), (νM₁' ^ j * νE') u = 1 := by
    simpa only [hdegM₁'] using hνM₁'E'_cond
  have hξM₁'_cond1 : ∀ u ∈ unitGroup F M₁' (condExp F M₁' ξM₁'), ξM₁' u = 1 := by
    have h1 := (hξM₁'_pack 1 hPrime.one_lt).2.1
    rw [hpow_one] at h1
    exact h1
  have hMinCond_M₁' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLM₁'),
      condExp F L νE' ≤ condExp F L (νM₁' ^ j * νE') := by
    intro j hj
    rw [hdegM₁'] at hj
    exact le_of_eq ((hMinM₁' j hj).2).symm
  obtain ⟨hψM₁', _, _, hξM₁'_unram, hEdge2_le⟩ :=
    ld_ch12_wild_step_norm_comp_cond_bounds F L M₁' hLM₁' hGalLM₁' hAbLM₁'
      hPrime_M₁' hWild_M₁' ψ hψ νM₁' νE'
      hνM₁'_pow₀ hνM₁'_ne hνM₁'_ker hνM₁'_cond₀ hνM₁'E'_cond₀ hξM₁'_cond1
      hMinCond_M₁'
  have hξM₁'_ram : condExp F L νM₁' ≤ condExp F M₁' ξM₁' := hEdge2_le hbM₁'_le_bE'
  have hPrime_E'K₁ : Nat.Prime (Module.finrank E' (IntermediateField.extendScalars hE'K₁)) :=
    hdegE'K₁.symm ▸ hPrime
  have hWild_E'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) = p F :=
    hdegE'K₁.trans hWild
  have hξE'_pow_E'K₁ : ξE' ^ (Module.finrank E' (IntermediateField.extendScalars hE'K₁)) = 1 :=
    hdegE'K₁.symm ▸ hξE'_pow
  have hξE'_ker_E'K₁ : ∀ y : E'ˣ, y ∈ Set.range (Units.map (normLM F hE'K₁)) ↔ ξE' y = 1 :=
    (hξE'_pack 0 hPrime.pos).1
  have hξE'_cond_E'K₁ : ∀ j < Module.finrank E' (IntermediateField.extendScalars hE'K₁),
      ∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j)), (ξE' ^ j) u = 1 := by
    intro j hj
    rw [hdegE'K₁] at hj
    exact (hξE'_pack j hj).2.1
  have hχE''_cond_E'K₁ : ∀ j < Module.finrank E' (IntermediateField.extendScalars hE'K₁),
      ∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j * χE'')), (ξE' ^ j * χE'') u = 1 := by
    intro j hj
    rw [hdegE'K₁] at hj
    exact (hξE'_pack j hj).2.2.1
  have hχE''K₁_cond : ∀ u ∈ unitGroup F K₁ (condExp F K₁ (χE''.comp (Units.map (normLM F hE'K₁)))),
      (χE''.comp (Units.map (normLM F hE'K₁))) u = 1 := by
    rw [hχE'_comp]
    exact hχK₁'_cond
  have hMinCond_E'K₁ : ∀ j < Module.finrank E' (IntermediateField.extendScalars hE'K₁),
      condExp F E' χE'' ≤ condExp F E' (ξE' ^ j * χE'') := by
    intro j hj
    rw [hdegE'K₁] at hj
    exact le_of_eq ((hξE'_pack j hj).2.2.2.1).symm
  obtain ⟨_, hEdge3_lb, _, hEdge3_unram, _⟩ :=
    ld_ch12_wild_step_norm_comp_cond_bounds F E' K₁ hE'K₁ hGalE'K₁ hAbE'K₁
      hPrime_E'K₁ hWild_E'K₁ ψE' hψE' ξE' χE''
      hξE'_pow_E'K₁ hξE'_ne hξE'_ker_E'K₁ hξE'_cond_E'K₁ hχE''_cond_E'K₁
      hχE''K₁_cond hMinCond_E'K₁
  have hξE'_le_χE'' : condExp F E' ξE' ≤ condExp F E' χE'' := by
    apply hEdge3_lb
    have h1 := (hξE'_pack 1 hPrime.one_lt).2.2.2.1
    rw [hpow_one] at h1
    exact h1
  have hK₁_eq_E' : condExp F E' ξE' = 0 → condExp F K₁ χK₁' = condExp F E' χE'' := by
    intro h0
    have h1 := hEdge3_unram h0
    rwa [hχE'_comp] at h1
  have hPrime_M₁'K₁ : Nat.Prime (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁)) :=
    hdegM₁'K₁.symm ▸ hPrime
  have hWild_M₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) = p F :=
    hdegM₁'K₁.trans hWild
  have hξM₁'_pow_M₁'K₁ : ξM₁' ^ (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁)) = 1 :=
    hdegM₁'K₁.symm ▸ hξM₁'_pow
  have hξM₁'_ker_M₁'K₁ : ∀ z : M₁'ˣ, z ∈ Set.range (Units.map (normLM F hM₁'K₁)) ↔ ξM₁' z = 1 :=
    (hξM₁'_pack 0 hPrime.pos).1
  have hξM₁'_cond_M₁'K₁ : ∀ j < Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁),
      ∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j)), (ξM₁' ^ j) u = 1 := by
    intro j hj
    rw [hdegM₁'K₁] at hj
    exact (hξM₁'_pack j hj).2.1
  have hχM₁''_cond_M₁'K₁ : ∀ j < Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁),
      ∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j * χM₁'')), (ξM₁' ^ j * χM₁'') u = 1 := by
    intro j hj
    rw [hdegM₁'K₁] at hj
    exact (hξM₁'_pack j hj).2.2.1
  have hχM₁''K₁_cond : ∀ u ∈ unitGroup F K₁ (condExp F K₁ (χM₁''.comp (Units.map (normLM F hM₁'K₁)))),
      (χM₁''.comp (Units.map (normLM F hM₁'K₁))) u = 1 := by
    rw [hχM₁'_comp]
    exact hχK₁'_cond
  have hMinCond_M₁'K₁ : ∀ j < Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁),
      condExp F M₁' χM₁'' ≤ condExp F M₁' (ξM₁' ^ j * χM₁'') := by
    intro j hj
    rw [hdegM₁'K₁] at hj
    exact le_of_eq ((hξM₁'_pack j hj).2.2.2.1).symm
  obtain ⟨_, hEdge4_lb, _, _, hEdge4_le⟩ :=
    ld_ch12_wild_step_norm_comp_cond_bounds F M₁' K₁ hM₁'K₁ hGalM₁'K₁ hAbM₁'K₁
      hPrime_M₁'K₁ hWild_M₁'K₁ ψM₁' hψM₁' ξM₁' χM₁''
      hξM₁'_pow_M₁'K₁ hξM₁'_ne hξM₁'_ker_M₁'K₁ hξM₁'_cond_M₁'K₁ hχM₁''_cond_M₁'K₁
      hχM₁''K₁_cond hMinCond_M₁'K₁
  have hξM₁'_le_χM₁'' : condExp F M₁' ξM₁' ≤ condExp F M₁' χM₁'' := by
    apply hEdge4_lb
    have h1 := (hξM₁'_pack 1 hPrime.one_lt).2.2.2.1
    rw [hpow_one] at h1
    exact h1
  have hξM₁'_le_K₁ : condExp F M₁' ξM₁' ≤ condExp F K₁ χK₁' := by
    have h1 := hEdge4_le hξM₁'_le_χM₁''
    rwa [hχM₁'_comp] at h1
  have hm_bounds : 2 ≤ condExp F E' χE'' ∧ 2 ≤ condExp F M₁' χM₁'' := by
    rcases hCondM₁' with h0 | hbM₁'_ge2
    · have hξM₁'_ge2 : 2 ≤ condExp F M₁' ξM₁' := by
        rw [hξM₁'_unram h0]
        exact hbE'_ge2
      refine ⟨?_, hξM₁'_ge2.trans hξM₁'_le_χM₁''⟩
      have hξE'_zero : condExp F E' ξE' = 0 := hξE'_cond_eq.trans h0
      rw [← hK₁_eq_E' hξE'_zero]
      exact hξM₁'_ge2.trans hξM₁'_le_K₁
    · refine ⟨?_, hbM₁'_ge2.trans (hξM₁'_ram.trans hξM₁'_le_χM₁'')⟩
      have hξE'_ge2 : 2 ≤ condExp F E' ξE' := by
        rw [hξE'_cond_eq]
        exact hbM₁'_ge2
      exact hξE'_ge2.trans hξE'_le_χE''
  refine ⟨hνM₁'E'_cond, hνE'M₁'_cond, hbE'_ge2, hMinM₁', hMinE',
    hNormFact, hχE'_comp, hχM₁'_comp, hχK₁'_cond, hm_bounds.1, ?_, hm_bounds.2, ?_, hCommonRest⟩
  · intro j hj
    exact ⟨(hξE'_pack j hj).1, (hξE'_pack j hj).2.1, (hξE'_pack j hj).2.2.1,
      (hξE'_pack j hj).2.2.2.1⟩
  · intro j hj
    exact ⟨(hξM₁'_pack j hj).1, (hξM₁'_pack j hj).2.1, (hξM₁'_pack j hj).2.2.1,
      (hξM₁'_pack j hj).2.2.2.1⟩

theorem ld_ch12_bicyclic_pencil_min_cond_trichotomy (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F))
    (ℓ : ℕ) (hPrime : Nat.Prime ℓ)
    (νE νM₁ : Lˣ →* (Ω F)ˣ)
    (hνE_pow : νE ^ ℓ = 1) (hνM₁_pow : νM₁ ^ ℓ = 1) :
    (∀ j < ℓ, condExp F L νM₁ ≤ condExp F L (νM₁ ^ j * νE)) ∨
    (∀ j < ℓ, condExp F L νE ≤ condExp F L (νE ^ j * νM₁)) ∨
    (∃ a < ℓ, 0 < a ∧
      (∀ j < ℓ, condExp F L (νE ^ a * νM₁) ≤ condExp F L ((νE ^ a * νM₁) ^ j * νE)) ∧
      (∀ j < ℓ, condExp F L (νE ^ a * νM₁) ≤ condExp F L ((νE ^ a * νM₁) ^ j * νM₁))) :=
by
  letI : CommGroup (Ω F)ˣ := inferInstance
  letI : CommGroup (Lˣ →* (Ω F)ˣ) := inferInstance
  have hpow_mod : ∀ (θ : Lˣ →* (Ω F)ˣ), θ ^ ℓ = 1 → ∀ n : ℕ, θ ^ n = θ ^ (n % ℓ) := by
    intro θ hθ n
    conv_lhs => rw [← Nat.div_add_mod n ℓ]
    rw [pow_add, pow_mul, hθ, one_pow, one_mul]
  have hpow_dvd : ∀ (θ : Lˣ →* (Ω F)ˣ), θ ^ ℓ = 1 → ∀ k : ℕ, ℓ ∣ k → θ ^ k = 1 := by
    intro θ hθ k hk
    rw [hpow_mod θ hθ k, Nat.mod_eq_zero_of_dvd hk, pow_zero]
  have hcond_pow : ∀ (θ : Lˣ →* (Ω F)ˣ), θ ^ ℓ = 1 → ∀ k : ℕ, ¬ (ℓ ∣ k) →
      condExp F L (θ ^ k) = condExp F L θ := by
    intro θ hθ k hk
    have hk_cop : k.Coprime ℓ := (hPrime.coprime_iff_not_dvd.mpr hk).symm
    obtain ⟨m, _, hm⟩ := Nat.exists_mul_mod_eq_one_of_coprime hk_cop hPrime.one_lt
    have h_recov : (θ ^ k) ^ m = θ := by
      rw [← pow_mul, hpow_mod θ hθ (k * m), hm, pow_one]
    have h_iff : ∀ u : Lˣ, (θ ^ k) u = 1 ↔ θ u = 1 := by
      intro u
      constructor
      · intro hu
        calc θ u = ((θ ^ k) ^ m) u := by rw [h_recov]
          _ = ((θ ^ k) u) ^ m := MonoidHom.pow_apply (θ ^ k) m u
          _ = 1 ^ m := by rw [hu]
          _ = 1 := one_pow m
      · intro hu
        rw [MonoidHom.pow_apply, hu, one_pow]
    unfold condExp
    congr 1
    ext a
    simp only [Set.mem_setOf_eq, h_iff]
  let g : ℕ → (Lˣ →* (Ω F)ˣ) := fun idx => if idx < ℓ then νE ^ idx * νM₁ else νE
  have hg_pow : ∀ idx : ℕ, (g idx) ^ ℓ = 1 := by
    intro idx
    dsimp only [g]
    by_cases hlt : idx < ℓ
    · rw [if_pos hlt, mul_pow, pow_right_comm νE idx ℓ, hνE_pow, hνM₁_pow, one_pow, mul_one]
    · rw [if_neg hlt, hνE_pow]
  have hne : (Finset.range (ℓ + 1)).Nonempty := ⟨0, Finset.mem_range.mpr (Nat.succ_pos ℓ)⟩
  obtain ⟨idx₀, hidx₀_mem, hmin_fin⟩ :=
    Finset.exists_min_image (Finset.range (ℓ + 1)) (fun idx => condExp F L (g idx)) hne
  have hidx₀ : idx₀ < ℓ + 1 := Finset.mem_range.mp hidx₀_mem
  have hmin : ∀ idx < ℓ + 1, condExp F L (g idx₀) ≤ condExp F L (g idx) := by
    intro idx hidx
    exact hmin_fin idx (Finset.mem_range.mpr hidx)
  have hmin_biv : ∀ i k : ℕ, (¬ (ℓ ∣ i) ∨ ¬ (ℓ ∣ k)) →
      condExp F L (g idx₀) ≤ condExp F L (νE ^ i * νM₁ ^ k) := by
    intro i k hik
    by_cases hk : ℓ ∣ k
    · have hi : ¬ (ℓ ∣ i) := hik.resolve_right (not_not.mpr hk)
      have hM₁_k : νM₁ ^ k = 1 := hpow_dvd νM₁ hνM₁_pow k hk
      have hg_ℓ : g ℓ = νE := by
        dsimp only [g]
        rw [if_neg (lt_irrefl ℓ)]
      have heq_char : νE ^ i * νM₁ ^ k = (g ℓ) ^ i := by
        rw [hM₁_k, mul_one, hg_ℓ]
      rw [heq_char, hcond_pow (g ℓ) (hg_pow ℓ) i hi]
      exact hmin ℓ (Nat.lt_succ_self ℓ)
    · have hk_cop : k.Coprime ℓ := (hPrime.coprime_iff_not_dvd.mpr hk).symm
      obtain ⟨a, ha_lt, ha_mod⟩ := Nat.exists_mul_mod_eq_of_coprime i hk_cop hPrime.ne_zero
      have hg_a : g a = νE ^ a * νM₁ := by
        dsimp only [g]
        rw [if_pos ha_lt]
      have heq_char : νE ^ i * νM₁ ^ k = (g a) ^ k := by
        rw [hg_a, mul_pow, ← pow_mul, mul_comm a k, hpow_mod νE hνE_pow (k * a), ha_mod,
          ← hpow_mod νE hνE_pow i]
      rw [heq_char, hcond_pow (g a) (hg_pow a) k hk]
      exact hmin a (Nat.lt_succ_of_lt ha_lt)
  by_cases h0 : idx₀ = 0
  · left
    have hg0 : g idx₀ = νM₁ := by
      rw [h0]
      dsimp only [g]
      rw [if_pos hPrime.pos, pow_zero, one_mul]
    intro j _
    have h1 := hmin_biv 1 j (Or.inl hPrime.not_dvd_one)
    rw [hg0, pow_one, mul_comm] at h1
    exact h1
  · by_cases hℓ : idx₀ = ℓ
    · right
      left
      have hgℓ : g idx₀ = νE := by
        rw [hℓ]
        dsimp only [g]
        rw [if_neg (lt_irrefl ℓ)]
      intro j _
      have h1 := hmin_biv j 1 (Or.inr hPrime.not_dvd_one)
      rw [hgℓ, pow_one] at h1
      exact h1
    · right
      right
      have ha_lt : idx₀ < ℓ := by omega
      have ha_pos : 0 < idx₀ := by omega
      have hga : g idx₀ = νE ^ idx₀ * νM₁ := by
        dsimp only [g]
        rw [if_pos ha_lt]
      refine ⟨idx₀, ha_lt, ha_pos, ?_, ?_⟩
      · intro j hj
        have h_twist1 : (νE ^ idx₀ * νM₁) ^ j * νE = νE ^ (idx₀ * j + 1) * νM₁ ^ j := by
          rw [mul_pow, ← pow_mul, mul_right_comm, ← pow_succ]
        rw [h_twist1, ← hga]
        have h_nd1 : ¬ (ℓ ∣ idx₀ * j + 1) ∨ ¬ (ℓ ∣ j) := by
          rcases Nat.eq_zero_or_pos j with rfl | hj_pos
          · left
            simpa using hPrime.not_dvd_one
          · right
            exact Nat.not_dvd_of_pos_of_lt hj_pos hj
        exact hmin_biv (idx₀ * j + 1) j h_nd1
      · intro j hj
        have h_twist2 : (νE ^ idx₀ * νM₁) ^ j * νM₁ = νE ^ (idx₀ * j) * νM₁ ^ (j + 1) := by
          rw [mul_pow, ← pow_mul, mul_assoc, ← pow_succ]
        rw [h_twist2, ← hga]
        have h_nd2 : ¬ (ℓ ∣ idx₀ * j) ∨ ¬ (ℓ ∣ j + 1) := by
          rcases Nat.eq_zero_or_pos j with rfl | hj_pos
          · right
            simpa using hPrime.not_dvd_one
          · left
            have hnd_a : ¬ (ℓ ∣ idx₀) := Nat.not_dvd_of_pos_of_lt ha_pos ha_lt
            have hnd_j : ¬ (ℓ ∣ j) := Nat.not_dvd_of_pos_of_lt hj_pos hj
            exact mt hPrime.dvd_mul.mp (not_or.mpr ⟨hnd_a, hnd_j⟩)
        exact hmin_biv (idx₀ * j) (j + 1) h_nd2

theorem ld_ch12_wild_odd_min_cond_subfield_and_norm_pow_reduction (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E M₁ K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E]
    [FiniteDimensional F M₁] [FiniteDimensional F K₁]
    (hLE : L ≤ E) (hLM₁ : L ≤ M₁) (hEK₁ : E ≤ K₁) (hM₁K₁ : M₁ ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE : IsGaloisExt F L E) (hGalLM₁ : IsGaloisExt F L M₁)
    (hGalEK₁ : IsGaloisExt F E K₁) (hGalM₁K₁ : IsGaloisExt F M₁ K₁)
    (hAbLE : IsAbelianExt F hLE) (hAbLM₁ : IsAbelianExt F hLM₁)
    (hAbEK₁ : IsAbelianExt F hEK₁) (hAbM₁K₁ : IsAbelianExt F hM₁K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE)))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE) = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁ : Module.finrank L (IntermediateField.extendScalars hLM₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (hdegEK₁ : Module.finrank E (IntermediateField.extendScalars hEK₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (hdegM₁K₁ : Module.finrank M₁ (IntermediateField.extendScalars hM₁K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (h_inf : E ⊓ M₁ = L) (h_sup : E ⊔ M₁ = K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁)
    (hneK₁ : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE.trans hEK₁) χL = χK₁)
    (χE : relWeil F E →* (Ω F)ˣ) (hχE_weil : IsWeilRep F E (charRep F E χE))
    (hχE_rest : restrictWeilChar F hEK₁ χE = χK₁)
    (χM₁ : relWeil F M₁ →* (Ω F)ˣ) (hχM₁_weil : IsWeilRep F M₁ (charRep F M₁ χM₁))
    (hχM₁_rest : restrictWeilChar F hM₁K₁ χM₁ = χK₁)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (hψM₁ : IsAdmissibleChar F M₁ (traceChar F hLM₁ ψ))
    (hψK₁ : IsAdmissibleChar F K₁ (traceChar F (hLE.trans hEK₁) ψ))
    (νE νM₁ : Lˣ →* (Ω F)ˣ)
    (hνE_pow : νE ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1)
    (hνE_ne : νE ≠ 1)
    (hνE_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE)) ↔ νE x = 1)
    (hνE_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
      ∀ u ∈ unitGroup F L (condExp F L (νE ^ j)), (νE ^ j) u = 1)
    (hνM₁_pow : νM₁ ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1)
    (hνM₁_ne : νM₁ ≠ 1)
    (hνM₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁)) ↔ νM₁ x = 1)
    (hνM₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁ ^ j)), (νM₁ ^ j) u = 1)
    (hReduced :
      ∀ (E' M₁' : IntermediateField F (AlgebraicClosure F))
        [FiniteDimensional F E'] [FiniteDimensional F M₁']
        (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁),
        IsGaloisExt F L E' → IsGaloisExt F L M₁' →
        IsGaloisExt F E' K₁ → IsGaloisExt F M₁' K₁ →
        IsAbelianExt F hLE' → IsAbelianExt F hLM₁' →
        IsAbelianExt F hE'K₁ → IsAbelianExt F hM₁'K₁ →
        Module.finrank L (IntermediateField.extendScalars hLE') =
          Module.finrank L (IntermediateField.extendScalars hLE) →
        Module.finrank L (IntermediateField.extendScalars hLM₁') =
          Module.finrank L (IntermediateField.extendScalars hLE) →
        Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
          Module.finrank L (IntermediateField.extendScalars hLE) →
        Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
          Module.finrank L (IntermediateField.extendScalars hLE) →
        E' ⊓ M₁' = L → E' ⊔ M₁' = K₁ →
        ∀ (χE' : relWeil F E' →* (Ω F)ˣ), IsWeilRep F E' (charRep F E' χE') →
