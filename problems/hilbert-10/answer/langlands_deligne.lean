        (∑ c₀ : k, c0_term c₀) * (∑ H ∈ M (ℓ - 1), ψ_k (-(𝒩_ℓ H).nextCoeff)) := by
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro c₀ _
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro H hH
      exact h_term_split c₀ H hH
    rw [h_sum_factor]
    congr 1
    have h_c0_zero : c0_term 0 = 0 := by
      dsimp [c0_term]
      have h0 : (-(0 : k)) ^ ℓ = 0 := by rw [neg_zero, zero_pow hPrime.ne_zero]
      rw [dif_neg (not_not.mpr h0), zero_mul]
    rw [← Finset.sum_erase_add Finset.univ c0_term (Finset.mem_univ (0 : k)), h_c0_zero, add_zero]
    set u_ℓ : kˣ := Units.mk0 (ℓ : k) hNeChar
    have h_c0_bij : (∑ c₀ ∈ Finset.univ.erase (0 : k), c0_term c₀) =
        ∑ x : kˣ, (((α u_ℓ)⁻¹) ^ ℓ : Ω F) * (((α ^ ℓ) x : Ω F) * ψ_k (x : k)) := by
      symm
      refine Finset.sum_bij (fun (x : kˣ) _ => -(((u_ℓ⁻¹ * x : kˣ) : k))) ?_ ?_ ?_ ?_
      · intro x _
        exact Finset.mem_erase.mpr ⟨neg_ne_zero.mpr (Units.ne_zero _), Finset.mem_univ _⟩
      · intro x₁ _ x₂ _ h_eq
        dsimp only at h_eq
        have h1 : ((u_ℓ⁻¹ * x₁ : kˣ) : k) = ((u_ℓ⁻¹ * x₂ : kˣ) : k) := neg_injective h_eq
        exact mul_left_cancel (Units.ext h1)
      · intro c₀ hc₀
        have hc₀_ne : c₀ ≠ 0 := (Finset.mem_erase.mp hc₀).1
        refine ⟨u_ℓ * Units.mk0 (-c₀) (neg_ne_zero.mpr hc₀_ne), Finset.mem_univ _, ?_⟩
        dsimp only
        rw [inv_mul_cancel_left, Units.val_mk0, neg_neg]
      · intro x _
        dsimp only [c0_term]
        rw [neg_neg]
        have h_nz : (((u_ℓ⁻¹ * x : kˣ) : k)) ^ ℓ ≠ 0 :=
          pow_ne_zero ℓ (Units.ne_zero _)
        rw [dif_pos h_nz]
        have h_unit_eq : Units.mk0 ((((u_ℓ⁻¹ * x : kˣ) : k)) ^ ℓ) h_nz = (u_ℓ⁻¹ * x) ^ ℓ := by
          ext
          simp
        have h_val_eq : -((ℓ : k) * -(((u_ℓ⁻¹ * x : kˣ) : k))) = (x : k) := by
          have h_u : (ℓ : k) * ((u_ℓ⁻¹ : kˣ) : k) = 1 := u_ℓ.mul_inv
          calc -((ℓ : k) * -(((u_ℓ⁻¹ * x : kˣ) : k)))
              = (ℓ : k) * (((u_ℓ⁻¹ : kˣ) : k) * (x : k)) := by simp [Units.val_mul]
            _ = ((ℓ : k) * ((u_ℓ⁻¹ : kˣ) : k)) * (x : k) := by ring
            _ = (x : k) := by rw [h_u, one_mul]
        have h_α_eq : (α ((u_ℓ⁻¹ * x) ^ ℓ) : Ω F) =
            (((α u_ℓ)⁻¹) ^ ℓ : Ω F) * ((α ^ ℓ) x : Ω F) := by
          rw [map_pow, map_mul, map_inv, mul_pow, Units.val_mul, MonoidHom.pow_apply,
            Units.val_pow_eq_pow_val]
        rw [h_unit_eq, h_val_eq, h_α_eq, mul_assoc]
    rw [h_c0_bij, ← Finset.mul_sum]
  exact ⟨σ, 𝒩_ℓ, hσ_mem, hσ_mul, hσ_zero, hσ_add, hσ_expand, hσ_irr,
    h𝒩_prop, h𝒩_one, h𝒩_mul, h𝒩_deg1, h_s3⟩

theorem ld_norm_poly_von_mangoldt_fiber_sum (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k : Type u) [Field k] [Fintype k]
    (ℓ : ℕ) (hPrime : Nat.Prime ℓ)
    (ν_k : kˣ →* (Ω F)ˣ)
    (hν_ne_pow : ∀ j ∈ (Finset.range ℓ).erase 0, ν_k ^ j ≠ 1)
    (hν_orth : ∀ u : kˣ,
      (∑ j ∈ Finset.range ℓ, ((ν_k ^ j) u : Ω F)) =
        ((Finset.univ.filter (fun y : k => y ^ ℓ = (u : k))).card : Ω F) ∧
      ((∃ y : k, y ^ ℓ = (u : k)) →
        (Finset.univ.filter (fun y : k => y ^ ℓ = (u : k))).card = ℓ))
    (M : ℕ → Finset (Polynomial k)) (Λ : Polynomial k → ℕ)
    (hM_mem : ∀ (d : ℕ) (f : Polynomial k), f ∈ M d ↔ f.Monic ∧ f.natDegree = d)
    (hΛ_prime_pow : ∀ (P : Polynomial k) (m : ℕ), P.Monic → Irreducible P → 1 ≤ m →
      Λ (P ^ m) = P.natDegree)
    (hΛ_ne_zero : ∀ (Q : Polynomial k), Λ Q ≠ 0 →
      ∃ (P : Polynomial k) (m : ℕ), P.Monic ∧ Irreducible P ∧ 1 ≤ m ∧ Q = P ^ m)
    (hΛ_sum_nz : ∀ (d : ℕ), 1 ≤ d →
      (∑ G ∈ (M d).filter (fun G => G.coeff 0 ≠ 0), Λ G) =
        (Fintype.card k) ^ d - 1)
    (hΛ_char_orth : ∀ (β : kˣ →* (Ω F)ˣ), β ≠ 1 → ∀ (d : ℕ), 1 ≤ d →
      (∑ G ∈ (M d).filter (fun G => G.coeff 0 ≠ 0),
        (Λ G : Ω F) *
          (if h : (-1 : k) ^ d * G.coeff 0 ≠ 0 then
            (β (Units.mk0 ((-1 : k) ^ d * G.coeff 0) h) : Ω F)
          else 0)) = 0)
    (σ : ℕ → Polynomial k → Polynomial k) (𝒩_ℓ : Polynomial k → Polynomial k)
    (hσ_mem : ∀ (m d : ℕ) (P : Polynomial k), P ∈ M d → σ m P ∈ M d)
    (hσ_mul : ∀ (m : ℕ) (f g : Polynomial k), f.Monic → g.Monic → σ m (f * g) = σ m f * σ m g)
    (hσ_zero : ∀ (P : Polynomial k), P.Monic → σ 0 P = P)
    (hσ_add : ∀ (m₁ m₂ : ℕ) (P : Polynomial k), P.Monic →
      σ m₁ (σ m₂ P) = σ ((m₁ + m₂) % ℓ) P)
    (hσ_expand : ∀ (m : ℕ) (Q : Polynomial k), Q.Monic →
      σ m (Polynomial.expand k ℓ Q) = Polynomial.expand k ℓ Q)
    (hσ_irr : ∀ (m : ℕ) (P : Polynomial k), P.Monic → Irreducible P → Irreducible (σ m P))
    (h𝒩_prop : ∀ (d : ℕ) (P : Polynomial k), P ∈ M d →
      𝒩_ℓ P ∈ M d ∧
      Polynomial.expand k ℓ (𝒩_ℓ P) = ∏ m ∈ Finset.range ℓ, σ m P ∧
      (-1 : k) ^ d * (𝒩_ℓ P).coeff 0 = ((-1 : k) ^ d * P.coeff 0) ^ ℓ)
    (h𝒩_mul : ∀ f g : Polynomial k, f.Monic → g.Monic → 𝒩_ℓ (f * g) = 𝒩_ℓ f * 𝒩_ℓ g) :
    ∀ (d : ℕ), 1 ≤ d → ∀ G ∈ (M d).filter (fun G => G.coeff 0 ≠ 0),
      (∑ P ∈ (M d).filter (fun P => 𝒩_ℓ P = G), Λ P) =
        Λ G * (Finset.univ.filter (fun y : k => y ^ ℓ = (-1 : k) ^ d * G.coeff 0)).card :=
by
  have hσ_mon_deg : ∀ (m : ℕ) (f : Polynomial k), f.Monic →
      (σ m f).Monic ∧ (σ m f).natDegree = f.natDegree := by
    intro m f hf
    exact (hM_mem f.natDegree (σ m f)).mp (hσ_mem m f.natDegree f ((hM_mem f.natDegree f).mpr ⟨hf, rfl⟩))
  have h𝒩_mon_deg : ∀ (f : Polynomial k), f.Monic →
      (𝒩_ℓ f).Monic ∧ (𝒩_ℓ f).natDegree = f.natDegree ∧
      Polynomial.expand k ℓ (𝒩_ℓ f) = ∏ m ∈ Finset.range ℓ, σ m f := by
    intro f hf
    have h := h𝒩_prop f.natDegree f ((hM_mem f.natDegree f).mpr ⟨hf, rfl⟩)
    have hm := (hM_mem f.natDegree (𝒩_ℓ f)).mp h.1
    exact ⟨hm.1, hm.2, h.2.1⟩
  have hσ_mod : ∀ (m : ℕ) (f : Polynomial k), f.Monic → σ m f = σ (m % ℓ) f := by
    intro m f hf
    conv_lhs => rw [← hσ_zero f hf]
    rw [hσ_add m 0 f hf, Nat.add_zero]
  have exists_monic_irr_dvd : ∀ (B : Polynomial k), B.Monic → 0 < B.natDegree →
      ∃ Q : Polynomial k, Q.Monic ∧ Irreducible Q ∧ Q ∣ B := by
    intro B _hB_mon hB_deg
    obtain ⟨g, hg_irr, hg_dvd⟩ := Polynomial.exists_irreducible_of_natDegree_pos hB_deg
    have hg_nz : g ≠ 0 := hg_irr.ne_zero
    have hc_nz : g.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hg_nz
    let Q := Polynomial.C (g.leadingCoeff)⁻¹ * g
    have hQ_mon : Q.Monic := by
      change (Polynomial.C (g.leadingCoeff)⁻¹ * g).leadingCoeff = 1
      rw [Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C, inv_mul_cancel₀ hc_nz]
    let u : (Polynomial k)ˣ :=
      { val := Polynomial.C (g.leadingCoeff)⁻¹
        inv := Polynomial.C g.leadingCoeff
        val_inv := by rw [← Polynomial.C_mul, inv_mul_cancel₀ hc_nz, Polynomial.C_1]
        inv_val := by rw [← Polynomial.C_mul, mul_inv_cancel₀ hc_nz, Polynomial.C_1] }
    have h_assoc : Associated g Q := ⟨u, by change g * Polynomial.C (g.leadingCoeff)⁻¹ = Q; rw [mul_comm]⟩
    refine ⟨Q, hQ_mon, h_assoc.irreducible hg_irr, h_assoc.symm.dvd.trans hg_dvd⟩
  have hIrrNorm : ∀ (P₀ : Polynomial k), P₀.Monic → Irreducible P₀ →
      ∃ (Q : Polynomial k) (e : ℕ),
        Q.Monic ∧ Irreducible Q ∧ 1 ≤ e ∧ 𝒩_ℓ P₀ = Q ^ e ∧
        ((σ 1 P₀ = P₀ ∧ (∀ m : ℕ, σ m P₀ = P₀) ∧ P₀.natDegree ≤ Q.natDegree * ℓ) ∨
         (σ 1 P₀ ≠ P₀ ∧ P₀.natDegree = Q.natDegree)) := by
    intro P₀ hP₀_mon hP₀_irr
    set N₀ := 𝒩_ℓ P₀
    obtain ⟨hN₀_mon, hN₀_deg, hN₀_exp⟩ := h𝒩_mon_deg P₀ hP₀_mon
    have hP₀_deg_pos : 0 < P₀.natDegree := hP₀_irr.natDegree_pos
    have hN₀_deg_pos : 0 < N₀.natDegree := by rw [hN₀_deg]; exact hP₀_deg_pos
    have hP₀_dvd_exp : ∀ Q' : Polynomial k, Q'.Monic → Irreducible Q' → Q' ∣ N₀ →
        P₀ ∣ Polynomial.expand k ℓ Q' := by
      intro Q' hQ'_mon hQ'_irr hQ'_dvd
      have hexp_dvd : Polynomial.expand k ℓ Q' ∣ ∏ m ∈ Finset.range ℓ, σ m P₀ := by
        rw [← hN₀_exp]
        exact map_dvd (Polynomial.expand k ℓ) hQ'_dvd
      have hexp_mon : (Polynomial.expand k ℓ Q').Monic := hQ'_mon.expand hPrime.pos
      have hexp_deg : 0 < (Polynomial.expand k ℓ Q').natDegree := by
        rw [Polynomial.natDegree_expand]
        exact Nat.mul_pos hQ'_irr.natDegree_pos hPrime.pos
      obtain ⟨R, hR_mon, hR_irr, hR_dvd_exp⟩ := exists_monic_irr_dvd _ hexp_mon hexp_deg
      have hR_dvd_prod : R ∣ ∏ m ∈ Finset.range ℓ, σ m P₀ := hR_dvd_exp.trans hexp_dvd
      have hR_prime : Prime R := UniqueFactorizationMonoid.irreducible_iff_prime.mp hR_irr
      obtain ⟨m, hm_mem, hR_dvd_σ⟩ := (Prime.dvd_finset_prod_iff hR_prime _).mp hR_dvd_prod
      have hm_lt : m < ℓ := Finset.mem_range.mp hm_mem
      have hσm_mon : (σ m P₀).Monic := (hσ_mon_deg m P₀ hP₀_mon).1
      have hσm_irr : Irreducible (σ m P₀) := hσ_irr m P₀ hP₀_mon hP₀_irr
      have hR_assoc : Associated R (σ m P₀) :=
        (Irreducible.dvd_irreducible_iff_associated hR_irr hσm_irr).mp hR_dvd_σ
      have hR_eq : R = σ m P₀ := Polynomial.eq_of_monic_of_associated hR_mon hσm_mon hR_assoc
      rw [hR_eq] at hR_dvd_exp
      obtain ⟨B, hB_eq⟩ := hR_dvd_exp
      have hB_mon : B.Monic := by
        apply Polynomial.Monic.of_mul_monic_left hσm_mon
        rw [← hB_eq]
        exact hexp_mon
      have h_apply := congr_arg (σ (ℓ - m)) hB_eq
      rw [hσ_expand (ℓ - m) Q' hQ'_mon, hσ_mul (ℓ - m) (σ m P₀) B hσm_mon hB_mon,
        hσ_add (ℓ - m) m P₀ hP₀_mon, Nat.sub_add_cancel (le_of_lt hm_lt), Nat.mod_self,
        hσ_zero P₀ hP₀_mon] at h_apply
      exact ⟨σ (ℓ - m) B, h_apply⟩
    obtain ⟨Q, hQ_mon, hQ_irr, hQ_dvd_N₀⟩ := exists_monic_irr_dvd N₀ hN₀_mon hN₀_deg_pos
    have hP₀_dvd_expQ : P₀ ∣ Polynomial.expand k ℓ Q := hP₀_dvd_exp Q hQ_mon hQ_irr hQ_dvd_N₀
    have hQ_unique : ∀ Q' : Polynomial k, Q'.Monic → Irreducible Q' → Q' ∣ N₀ → Q' = Q := by
      intro Q' hQ'_mon hQ'_irr hQ'_dvd
      by_contra h_ne
      have h_not_dvd : ¬ (Q ∣ Q') := by
        intro h_dvd
        have h_assoc := (Irreducible.dvd_irreducible_iff_associated hQ_irr hQ'_irr).mp h_dvd
        exact h_ne (Polynomial.eq_of_monic_of_associated hQ_mon hQ'_mon h_assoc).symm
      have h_cop : IsCoprime Q Q' := (Irreducible.coprime_iff_not_dvd hQ_irr).mpr h_not_dvd
      have h_cop_exp : IsCoprime (Polynomial.expand k ℓ Q) (Polynomial.expand k ℓ Q') :=
        h_cop.map (Polynomial.expand k ℓ).toRingHom
      have hP₀_dvd_expQ' : P₀ ∣ Polynomial.expand k ℓ Q' := hP₀_dvd_exp Q' hQ'_mon hQ'_irr hQ'_dvd
      exact hP₀_irr.not_isUnit (h_cop_exp.isUnit_of_dvd' hP₀_dvd_expQ hP₀_dvd_expQ')
    have h_pow_of_dvd : ∀ (n : ℕ) (B : Polynomial k),
        B.natDegree = n → B.Monic → B ∣ N₀ → ∃ e : ℕ, B = Q ^ e := by
      intro n
      induction' n using Nat.strong_induction_on with n ih
      intro B hB_deg hB_mon hB_dvd
      by_cases hn0 : n = 0
      · refine ⟨0, ?_⟩
        rw [pow_zero]
        exact Polynomial.eq_one_of_monic_natDegree_zero hB_mon (hB_deg.trans hn0)
      · have hn_pos : 0 < B.natDegree := by rw [hB_deg]; exact Nat.pos_of_ne_zero hn0
        obtain ⟨Q', hQ'_mon, hQ'_irr, hQ'_dvd_B⟩ := exists_monic_irr_dvd B hB_mon hn_pos
        have hQ'_eq : Q' = Q := hQ_unique Q' hQ'_mon hQ'_irr (hQ'_dvd_B.trans hB_dvd)
        rw [hQ'_eq] at hQ'_dvd_B
        obtain ⟨B', hB'_eq⟩ := hQ'_dvd_B
        have hB'_mon : B'.Monic := by
          apply Polynomial.Monic.of_mul_monic_left hQ_mon
          rw [← hB'_eq]
          exact hB_mon
        have hB'_dvd : B' ∣ N₀ := (dvd_mul_left B' Q).trans (hB'_eq ▸ hB_dvd)
        have h_deg_sum : B.natDegree = Q.natDegree + B'.natDegree := by
          rw [hB'_eq, hQ_mon.natDegree_mul hB'_mon]
        have hQ_deg_pos : 0 < Q.natDegree := hQ_irr.natDegree_pos
        have hB'_lt : B'.natDegree < n := by omega
        obtain ⟨e', he'⟩ := ih B'.natDegree hB'_lt B' rfl hB'_mon hB'_dvd
        refine ⟨e' + 1, ?_⟩
        rw [hB'_eq, he', pow_succ']
    obtain ⟨e, hN₀_eq⟩ := h_pow_of_dvd N₀.natDegree N₀ rfl hN₀_mon (dvd_refl N₀)
    have he_pos : 1 ≤ e := by
      by_contra h_not
      have he0 : e = 0 := by omega
      rw [he0, pow_zero] at hN₀_eq
      rw [hN₀_eq, Polynomial.natDegree_one] at hN₀_deg_pos
      exact lt_irrefl 0 hN₀_deg_pos
    have hσ_km : ∀ (m : ℕ), σ m P₀ = P₀ → ∀ (k_idx : ℕ), σ ((k_idx * m) % ℓ) P₀ = P₀ := by
      intro m hm k_idx
      induction' k_idx with k_idx ih
      · simp [hσ_zero P₀ hP₀_mon]
      · have h_mod : ((k_idx + 1) * m) % ℓ = (m + (k_idx * m) % ℓ) % ℓ := by
          rw [Nat.succ_mul, Nat.add_comm]
          conv_lhs => rw [Nat.add_mod]
          conv_rhs => rw [Nat.add_mod, Nat.mod_mod]
        rw [h_mod, ← hσ_add m ((k_idx * m) % ℓ) P₀ hP₀_mon, ih, hm]
    refine ⟨Q, e, hQ_mon, hQ_irr, he_pos, hN₀_eq, ?_⟩
    by_cases h1 : σ 1 P₀ = P₀
    · left
      refine ⟨h1, ?_, ?_⟩
      · intro m
        rw [hσ_mod m P₀ hP₀_mon, ← Nat.mul_one m]
        exact hσ_km 1 h1 m
      · have hexpQ_mon : (Polynomial.expand k ℓ Q).Monic := hQ_mon.expand hPrime.pos
        have h_le := Polynomial.natDegree_le_of_dvd hP₀_dvd_expQ hexpQ_mon.ne_zero
        rwa [Polynomial.natDegree_expand] at h_le
    · right
      refine ⟨h1, ?_⟩
      have h_ne_all : ∀ m ∈ (Finset.range ℓ).erase 0, σ m P₀ ≠ P₀ := by
        intro m hm_mem hm_eq
        have hm_ne0 : m ≠ 0 := (Finset.mem_erase.mp hm_mem).1
        have hm_lt : m < ℓ := Finset.mem_range.mp (Finset.mem_erase.mp hm_mem).2
        haveI : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
        haveI : Fact (1 < ℓ) := ⟨hPrime.one_lt⟩
        have hm_zmod_ne : (m : ZMod ℓ) ≠ 0 := by
          intro h0
          have hval := congr_arg ZMod.val h0
          rw [ZMod.val_natCast, Nat.mod_eq_of_lt hm_lt, ZMod.val_zero] at hval
          exact hm_ne0 hval
        let k_idx := ((m : ZMod ℓ)⁻¹).val
        have h_prod_zmod : ((k_idx * m : ℕ) : ZMod ℓ) = 1 := by
          rw [Nat.cast_mul, ZMod.natCast_zmod_val, inv_mul_cancel₀ hm_zmod_ne]
        have h_mod_eq : (k_idx * m) % ℓ = 1 := by
          have hval := congr_arg ZMod.val h_prod_zmod
          rwa [ZMod.val_natCast, ZMod.val_one] at hval
        have h1_eq := hσ_km m hm_eq k_idx
        rw [h_mod_eq] at h1_eq
        exact h1 h1_eq
      have h_not_dvd_prod : ¬ (P₀ ∣ ∏ m ∈ (Finset.range ℓ).erase 0, σ m P₀) := by
        intro h_dvd
        have hP₀_prime : Prime P₀ := UniqueFactorizationMonoid.irreducible_iff_prime.mp hP₀_irr
        obtain ⟨m, hm_mem, hP₀_dvd_σm⟩ := (Prime.dvd_finset_prod_iff hP₀_prime _).mp h_dvd
        have hσm_mon : (σ m P₀).Monic := (hσ_mon_deg m P₀ hP₀_mon).1
        have hσm_irr : Irreducible (σ m P₀) := hσ_irr m P₀ hP₀_mon hP₀_irr
        have h_assoc := (Irreducible.dvd_irreducible_iff_associated hP₀_irr hσm_irr).mp hP₀_dvd_σm
        have h_eq := (Polynomial.eq_of_monic_of_associated hP₀_mon hσm_mon h_assoc).symm
        exact h_ne_all m hm_mem h_eq
      have he_eq_one : e = 1 := by
        by_contra he_ne1
        have he2 : 2 ≤ e := by omega
        obtain ⟨C, hC⟩ := hP₀_dvd_expQ
        have hexp_pow : (Polynomial.expand k ℓ Q) ^ e =
            P₀ * ∏ m ∈ (Finset.range ℓ).erase 0, σ m P₀ := by
          rw [← map_pow, ← hN₀_eq, hN₀_exp,
            ← Finset.mul_prod_erase _ _ (Finset.mem_range.mpr hPrime.pos), hσ_zero P₀ hP₀_mon]
        have he_split : e = (e - 2) + 2 := (Nat.sub_add_cancel he2).symm
        have hexp2 : (Polynomial.expand k ℓ Q) ^ 2 = (P₀ * C) ^ 2 := by rw [hC]
        have h_rhs_dvd : P₀ * (P₀ * (C ^ 2 * (Polynomial.expand k ℓ Q) ^ (e - 2))) =
            P₀ * ∏ m ∈ (Finset.range ℓ).erase 0, σ m P₀ := by
          rw [← hexp_pow]
          conv_rhs => rw [he_split, pow_add, hexp2]
          ring
        have h_cancel := mul_left_cancel₀ hP₀_mon.ne_zero h_rhs_dvd
        exact h_not_dvd_prod ⟨C ^ 2 * (Polynomial.expand k ℓ Q) ^ (e - 2), h_cancel.symm⟩
      rw [he_eq_one, pow_one] at hN₀_eq
      rw [← hN₀_deg]
      exact congr_arg Polynomial.natDegree hN₀_eq
  have h1_mem : (1 : Polynomial k) ∈ M 0 :=
    (hM_mem 0 1).mpr ⟨Polynomial.monic_one, Polynomial.natDegree_one⟩
  have h𝒩_one : 𝒩_ℓ 1 = 1 := by
    have h := (hM_mem 0 (𝒩_ℓ 1)).mp (h𝒩_prop 0 1 h1_mem).1
    exact Polynomial.eq_one_of_monic_natDegree_zero h.1 h.2
  have h𝒩_pow : ∀ (A : Polynomial k), A.Monic → ∀ (n : ℕ), 𝒩_ℓ (A ^ n) = (𝒩_ℓ A) ^ n := by
    intro A hA n
    induction' n with n ih
    · simp [h𝒩_one]
    · rw [pow_succ, h𝒩_mul (A ^ n) A (hA.pow n) hA, ih, pow_succ]
  have hFiberLe : ∀ (d : ℕ), 1 ≤ d → ∀ G ∈ (M d).filter (fun G => G.coeff 0 ≠ 0),
      (∑ P ∈ (M d).filter (fun P => 𝒩_ℓ P = G), Λ P) ≤
        Λ G * (Finset.univ.filter (fun y : k => y ^ ℓ = (-1 : k) ^ d * G.coeff 0)).card := by
    intro d _hd G hG
    have hG_nz : G.coeff 0 ≠ 0 := (Finset.mem_filter.mp hG).2
    by_cases hEx : ∃ y : k, y ^ ℓ = (-1 : k) ^ d * G.coeff 0
    · have hG_c : (-1 : k) ^ d * G.coeff 0 ≠ 0 :=
        mul_ne_zero (pow_ne_zero d (neg_ne_zero.mpr one_ne_zero)) hG_nz
      let u_G : kˣ := Units.mk0 ((-1 : k) ^ d * G.coeff 0) hG_c
      have h_card_eq : (Finset.univ.filter (fun y : k => y ^ ℓ = (-1 : k) ^ d * G.coeff 0)).card = ℓ :=
        (hν_orth u_G).2 hEx
      rw [h_card_eq]
      set fib := (M d).filter (fun P => 𝒩_ℓ P = G)
      set S_G := fib.filter (fun P => Λ P ≠ 0)
      have h_sum_eq : (∑ P ∈ fib, Λ P) = ∑ P ∈ S_G, Λ P :=
        (Finset.sum_filter_of_ne (fun P _ hΛ => hΛ)).symm
      rw [h_sum_eq]
      by_cases hS_nonempty : S_G.Nonempty
      · obtain ⟨F₀, hF₀_mem⟩ := hS_nonempty
        have hF₀_fib : F₀ ∈ fib := (Finset.mem_filter.mp hF₀_mem).1
        have hF₀_Λ : Λ F₀ ≠ 0 := (Finset.mem_filter.mp hF₀_mem).2
        have hF₀_Md : F₀ ∈ M d := (Finset.mem_filter.mp hF₀_fib).1
        have hF₀_N : 𝒩_ℓ F₀ = G := (Finset.mem_filter.mp hF₀_fib).2
        have hF₀_deg : F₀.natDegree = d := ((hM_mem d F₀).mp hF₀_Md).2
        obtain ⟨P₀, k₀, hP₀_mon, hP₀_irr, hk₀_pos, hF₀_eq⟩ := hΛ_ne_zero F₀ hF₀_Λ
        obtain ⟨Q, e, hQ_mon, hQ_irr, he_pos, hN_P₀, hDich⟩ := hIrrNorm P₀ hP₀_mon hP₀_irr
        have hG_eq : G = Q ^ (e * k₀) := by
          rw [← hF₀_N, hF₀_eq, h𝒩_pow P₀ hP₀_mon k₀, hN_P₀, ← pow_mul]
        have hek₀_pos : 1 ≤ e * k₀ := Nat.mul_pos he_pos hk₀_pos
        have hΛ_G : Λ G = Q.natDegree := by
          rw [hG_eq, hΛ_prime_pow Q (e * k₀) hQ_mon hQ_irr hek₀_pos]
        have hS_char : ∀ F ∈ S_G,
            Λ F = P₀.natDegree ∧ ∃ m ∈ Finset.range ℓ, F = (σ m P₀) ^ k₀ := by
          intro F hF
          have hF_fib : F ∈ fib := (Finset.mem_filter.mp hF).1
          have hF_Λ : Λ F ≠ 0 := (Finset.mem_filter.mp hF).2
          have hF_Md : F ∈ M d := (Finset.mem_filter.mp hF_fib).1
          have hF_N : 𝒩_ℓ F = G := (Finset.mem_filter.mp hF_fib).2
          have hF_mon : F.Monic := ((hM_mem d F).mp hF_Md).1
          have hF_deg : F.natDegree = d := ((hM_mem d F).mp hF_Md).2
          obtain ⟨P, k_exp, hP_mon, hP_irr, hk_exp_pos, hF_eq⟩ := hΛ_ne_zero F hF_Λ
          have hP_dvd_F : P ∣ F := by
            rw [hF_eq]
            exact dvd_pow_self P (by omega)
          have hF_dvd_expG : F ∣ Polynomial.expand k ℓ G := by
            rw [← hF_N, (h𝒩_prop d F hF_Md).2.1]
            conv_lhs => rw [← hσ_zero F hF_mon]
            exact Finset.dvd_prod_of_mem _ (Finset.mem_range.mpr hPrime.pos)
          have hexpG_eq : Polynomial.expand k ℓ G = (∏ m ∈ Finset.range ℓ, σ m P₀) ^ k₀ := by
            rw [← hF₀_N, hF₀_eq, h𝒩_pow P₀ hP₀_mon k₀, map_pow, (h𝒩_mon_deg P₀ hP₀_mon).2.2]
          have hP_dvd_pow : P ∣ (∏ m ∈ Finset.range ℓ, σ m P₀) ^ k₀ := by
            rw [← hexpG_eq]
            exact hP_dvd_F.trans hF_dvd_expG
          have hP_prime : Prime P := UniqueFactorizationMonoid.irreducible_iff_prime.mp hP_irr
          have hP_dvd_prod : P ∣ ∏ m ∈ Finset.range ℓ, σ m P₀ := hP_prime.dvd_of_dvd_pow hP_dvd_pow
          obtain ⟨m, hm_mem, hP_dvd_σm⟩ := (Prime.dvd_finset_prod_iff hP_prime _).mp hP_dvd_prod
          have hσm_mon : (σ m P₀).Monic := (hσ_mon_deg m P₀ hP₀_mon).1
          have hσm_irr : Irreducible (σ m P₀) := hσ_irr m P₀ hP₀_mon hP₀_irr
          have h_assoc := (Irreducible.dvd_irreducible_iff_associated hP_irr hσm_irr).mp hP_dvd_σm
          have hP_eq : P = σ m P₀ := Polynomial.eq_of_monic_of_associated hP_mon hσm_mon h_assoc
          have hP_deg : P.natDegree = P₀.natDegree := by
            rw [hP_eq, (hσ_mon_deg m P₀ hP₀_mon).2]
          have hF_deg_mul : F.natDegree = k_exp * P.natDegree := by
            rw [hF_eq, Polynomial.natDegree_pow' (by rw [hP_mon.leadingCoeff, one_pow]; exact one_ne_zero)]
          have hF₀_deg_mul : F₀.natDegree = k₀ * P₀.natDegree := by
            rw [hF₀_eq, Polynomial.natDegree_pow' (by rw [hP₀_mon.leadingCoeff, one_pow]; exact one_ne_zero)]
          have hk_eq : k_exp = k₀ := by
            apply Nat.mul_right_cancel hP₀_irr.natDegree_pos
            calc k_exp * P₀.natDegree = k_exp * P.natDegree := by rw [hP_deg]
              _ = F.natDegree := hF_deg_mul.symm
              _ = d := hF_deg
              _ = F₀.natDegree := hF₀_deg.symm
              _ = k₀ * P₀.natDegree := hF₀_deg_mul
          refine ⟨?_, m, hm_mem, ?_⟩
          · rw [hF_eq, hΛ_prime_pow P k_exp hP_mon hP_irr hk_exp_pos, hP_deg]
          · rw [hF_eq, hP_eq, hk_eq]
        have h_sum_const : (∑ F ∈ S_G, Λ F) = S_G.card * P₀.natDegree := by
          rw [Finset.sum_congr rfl (fun F hF => (hS_char F hF).1), Finset.sum_const, smul_eq_mul]
        rw [h_sum_const, hΛ_G]
        rcases hDich with ⟨_, hσ_all, hdeg_le⟩ | ⟨_, hdeg_eq⟩
        · have hS_sub : S_G ⊆ {F₀} := by
            intro F hF
            rw [Finset.mem_singleton]
            obtain ⟨m, _, hF_eq_m⟩ := (hS_char F hF).2
            rw [hF_eq_m, hσ_all m, ← hF₀_eq]
          have hcard_le : S_G.card ≤ 1 := by
            have h := Finset.card_le_card hS_sub
            rwa [Finset.card_singleton] at h
          calc S_G.card * P₀.natDegree ≤ 1 * P₀.natDegree := Nat.mul_le_mul_right _ hcard_le
            _ = P₀.natDegree := Nat.one_mul _
            _ ≤ Q.natDegree * ℓ := hdeg_le
        · have hS_sub : S_G ⊆ (Finset.range ℓ).image (fun m => (σ m P₀) ^ k₀) := by
            intro F hF
            rw [Finset.mem_image]
            obtain ⟨m, hm_mem, hF_eq_m⟩ := (hS_char F hF).2
            exact ⟨m, hm_mem, hF_eq_m.symm⟩
          have hcard_le : S_G.card ≤ ℓ := by
            calc S_G.card ≤ ((Finset.range ℓ).image (fun m => (σ m P₀) ^ k₀)).card :=
                  Finset.card_le_card hS_sub
              _ ≤ (Finset.range ℓ).card := Finset.card_image_le
              _ = ℓ := Finset.card_range ℓ
          rw [hdeg_eq, mul_comm Q.natDegree ℓ]
          exact Nat.mul_le_mul_right Q.natDegree hcard_le
      · rw [Finset.not_nonempty_iff_eq_empty.mp hS_nonempty, Finset.sum_empty]
        exact Nat.zero_le _
    · have h_empty : (∑ P ∈ (M d).filter (fun P => 𝒩_ℓ P = G), Λ P) = 0 := by
        apply Finset.sum_eq_zero
        intro P hP
        have hP_Md : P ∈ M d := (Finset.mem_filter.mp hP).1
        have hP_N : 𝒩_ℓ P = G := (Finset.mem_filter.mp hP).2
        have hc0 := (h𝒩_prop d P hP_Md).2.2
        rw [hP_N] at hc0
        exact False.elim (hEx ⟨(-1 : k) ^ d * P.coeff 0, hc0.symm⟩)
      rw [h_empty]
      exact Nat.zero_le _
  have h𝒩_c0_iff : ∀ (d : ℕ) (P : Polynomial k), P ∈ M d →
      ((𝒩_ℓ P).coeff 0 ≠ 0 ↔ P.coeff 0 ≠ 0) := by
    intro d P hP
    have hrel := (h𝒩_prop d P hP).2.2
    have h_neg1 : (-1 : k) ^ d ≠ 0 := pow_ne_zero d (neg_ne_zero.mpr one_ne_zero)
    constructor
    · intro hN0 hP0
      apply hN0
      have h1 : (-1 : k) ^ d * (𝒩_ℓ P).coeff 0 = 0 := by
        rw [hrel, hP0, mul_zero, zero_pow hPrime.ne_zero]
      exact (mul_eq_zero.mp h1).resolve_left h_neg1
    · intro hP0 hN0
      have h1 : ((-1 : k) ^ d * P.coeff 0) ^ ℓ = 0 := by
        rw [← hrel, hN0, mul_zero]
      exact mul_ne_zero h_neg1 hP0 (eq_zero_of_pow_eq_zero h1)
  have hGlobalSumEq : ∀ (d : ℕ), 1 ≤ d →
      (∑ G ∈ (M d).filter (fun G => G.coeff 0 ≠ 0),
        (∑ P ∈ (M d).filter (fun P => 𝒩_ℓ P = G), Λ P)) =
      ∑ G ∈ (M d).filter (fun G => G.coeff 0 ≠ 0),
        Λ G * (Finset.univ.filter (fun y : k => y ^ ℓ = (-1 : k) ^ d * G.coeff 0)).card := by
    intro d hd
    set M_nz := (M d).filter (fun G => G.coeff 0 ≠ 0)
    have h_maps : ∀ P ∈ M_nz, 𝒩_ℓ P ∈ M_nz := by
      intro P hP
      rw [Finset.mem_filter] at hP ⊢
      exact ⟨(h𝒩_prop d P hP.1).1, (h𝒩_c0_iff d P hP.1).mpr hP.2⟩
    have h_filt_eq : ∀ G ∈ M_nz,
        (M d).filter (fun P => 𝒩_ℓ P = G) = M_nz.filter (fun P => 𝒩_ℓ P = G) := by
      intro G hG
      have hG_nz : G.coeff 0 ≠ 0 := (Finset.mem_filter.mp hG).2
      ext P
      simp only [M_nz, Finset.mem_filter]
      constructor
      · rintro ⟨hP1, hP2⟩
        refine ⟨⟨hP1, ?_⟩, hP2⟩
        rw [← h𝒩_c0_iff d P hP1, hP2]
        exact hG_nz
      · rintro ⟨⟨hP1, _⟩, hP2⟩
        exact ⟨hP1, hP2⟩
    have h_lhs : (∑ G ∈ M_nz, ∑ P ∈ (M d).filter (fun P => 𝒩_ℓ P = G), Λ P) =
        (Fintype.card k) ^ d - 1 := by
      have h1 : (∑ G ∈ M_nz, ∑ P ∈ (M d).filter (fun P => 𝒩_ℓ P = G), Λ P) =
          ∑ G ∈ M_nz, ∑ P ∈ M_nz.filter (fun P => 𝒩_ℓ P = G), Λ P := by
        apply Finset.sum_congr rfl
        intro G hG
        rw [h_filt_eq G hG]
      rw [h1, Finset.sum_fiberwise_of_maps_to h_maps, hΛ_sum_nz d hd]
    have h_rhs : (∑ G ∈ M_nz,
        Λ G * (Finset.univ.filter (fun y : k => y ^ ℓ = (-1 : k) ^ d * G.coeff 0)).card) =
        (Fintype.card k) ^ d - 1 := by
      apply Nat.cast_injective (R := Ω F)
      rw [Nat.cast_sum]
      have h_term : ∀ G ∈ M_nz,
          ((Λ G * (Finset.univ.filter (fun y : k => y ^ ℓ = (-1 : k) ^ d * G.coeff 0)).card : ℕ) : Ω F) =
            ∑ j ∈ Finset.range ℓ, (Λ G : Ω F) *
              (if h : (-1 : k) ^ d * G.coeff 0 ≠ 0 then
                ((ν_k ^ j) (Units.mk0 ((-1 : k) ^ d * G.coeff 0) h) : Ω F)
              else 0) := by
        intro G hG
        have hG_nz : G.coeff 0 ≠ 0 := (Finset.mem_filter.mp hG).2
        have hG_c : (-1 : k) ^ d * G.coeff 0 ≠ 0 :=
          mul_ne_zero (pow_ne_zero d (neg_ne_zero.mpr one_ne_zero)) hG_nz
        let u_G : kˣ := Units.mk0 ((-1 : k) ^ d * G.coeff 0) hG_c
        have h_card : ((Finset.univ.filter (fun y : k => y ^ ℓ = (-1 : k) ^ d * G.coeff 0)).card : Ω F) =
            ∑ j ∈ Finset.range ℓ, ((ν_k ^ j) u_G : Ω F) := ((hν_orth u_G).1).symm
        rw [Nat.cast_mul, h_card, Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro j _hj
        rw [dif_pos hG_c]
      rw [Finset.sum_congr rfl h_term, Finset.sum_comm]
      have h0_mem : (0 : ℕ) ∈ Finset.range ℓ := Finset.mem_range.mpr hPrime.pos
      rw [← Finset.add_sum_erase _ _ h0_mem]
      have hj0 : (∑ G ∈ M_nz, (Λ G : Ω F) *
          (if h : (-1 : k) ^ d * G.coeff 0 ≠ 0 then
            ((ν_k ^ 0) (Units.mk0 ((-1 : k) ^ d * G.coeff 0) h) : Ω F)
          else 0)) = (((Fintype.card k) ^ d - 1 : ℕ) : Ω F) := by
        rw [← hΛ_sum_nz d hd, Nat.cast_sum]
        apply Finset.sum_congr rfl
        intro G hG
        have hG_nz : G.coeff 0 ≠ 0 := (Finset.mem_filter.mp hG).2
        have hG_c : (-1 : k) ^ d * G.coeff 0 ≠ 0 :=
          mul_ne_zero (pow_ne_zero d (neg_ne_zero.mpr one_ne_zero)) hG_nz
        rw [dif_pos hG_c, pow_zero, MonoidHom.one_apply, Units.val_one, mul_one]
      have hj_pos : (∑ j ∈ (Finset.range ℓ).erase 0,
          ∑ G ∈ M_nz, (Λ G : Ω F) *
            (if h : (-1 : k) ^ d * G.coeff 0 ≠ 0 then
              ((ν_k ^ j) (Units.mk0 ((-1 : k) ^ d * G.coeff 0) h) : Ω F)
            else 0)) = 0 := by
        apply Finset.sum_eq_zero
        intro j hj
        exact hΛ_char_orth (ν_k ^ j) (hν_ne_pow j hj) d hd
      rw [hj0, hj_pos, add_zero]
    rw [h_lhs, h_rhs]
  intro d hd G hG
  exact (Finset.sum_eq_sum_iff_of_le (hFiberLe d hd)).mp (hGlobalSumEq d hd) G hG

theorem ld_elem_symm_newton_uniqueness (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (ℓ : ℕ) (g : ℕ → Ω F) (A : ℕ → Ω F)
    (hA0 : A 0 = 1)
    (hA_rec : ∀ n : ℕ, 1 ≤ n → n ≤ ℓ →
      (∑ d ∈ Finset.Icc 1 n,
        (∑ j ∈ Finset.range ℓ, (-1 : Ω F) ^ (d - 1) * (g j) ^ d) * A (n - d)) =
        (n : Ω F) * A n) :
    A ℓ = ∏ j ∈ Finset.range ℓ, g j :=
by
  let E : ℕ → ℕ → Ω F := elemSymmRange g
  have hE_zero : ∀ m : ℕ, E m 0 = 1 := by
    intro m
    cases m <;> rfl
  have hE_succ_zero : ∀ k : ℕ, E 0 (k + 1) = 0 := by
    intro k
    rfl
  have hE_succ_succ : ∀ m k : ℕ, E (m + 1) (k + 1) = E m (k + 1) + g m * E m k := by
    intro m k
    rfl
  have hE_gt : ∀ m n : ℕ, m < n → E m n = 0 := by
    intro m
    induction m with
    | zero =>
      intro n hn
      cases n with
      | zero => omega
      | succ k => exact hE_succ_zero k
    | succ m ih =>
      intro n hn
      cases n with
      | zero => omega
      | succ k =>
        rw [hE_succ_succ, ih (k + 1) (by omega), ih k (by omega), mul_zero, add_zero]
  have hE_diag : ∀ m : ℕ, E m m = ∏ j ∈ Finset.range m, g j := by
    intro m
    induction m with
    | zero =>
      rw [hE_zero 0, Finset.prod_range_zero]
    | succ m ih =>
      rw [hE_succ_succ, hE_gt m (m + 1) (by omega), zero_add, ih, Finset.prod_range_succ, mul_comm]
  have hIcc_eq_range : ∀ (n : ℕ) (f : ℕ → Ω F),
      (∑ d ∈ Finset.Icc 1 n, f d) = ∑ i ∈ Finset.range n, f (i + 1) := by
    intro n f
    induction n with
    | zero => simp
    | succ k ih =>
      rw [Finset.sum_Icc_succ_top (Nat.le_add_left 1 k), Finset.sum_range_succ, ih]
  let C : ℕ → (ℕ → Ω F) → ℕ → Ω F := fun m c n =>
    ∑ i ∈ Finset.range n, c i * E m (n - (i + 1))
  have hC_add : ∀ (m : ℕ) (c₁ c₂ : ℕ → Ω F) (n : ℕ),
      C m (fun i => c₁ i + c₂ i) n = C m c₁ n + C m c₂ n := by
    intro m c₁ c₂ n
    dsimp [C]
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro i _
    ring
  have hC_succ : ∀ (m : ℕ) (c : ℕ → Ω F) (k : ℕ),
      C (m + 1) c (k + 1) = C m c (k + 1) + g m * C m c k := by
    intro m c k
    dsimp [C]
    rw [Finset.sum_range_succ, Finset.sum_range_succ, Nat.sub_self, hE_zero (m + 1), hE_zero m]
    have h_sum : (∑ i ∈ Finset.range k, c i * E (m + 1) (k + 1 - (i + 1))) =
        (∑ i ∈ Finset.range k, c i * E m (k + 1 - (i + 1))) +
          g m * (∑ i ∈ Finset.range k, c i * E m (k - (i + 1))) := by
      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro i hi
      have hik : i < k := Finset.mem_range.mp hi
      have h_sub : k + 1 - (i + 1) = (k - (i + 1)) + 1 := by omega
      rw [h_sub, hE_succ_succ]
      ring
    rw [h_sum]
    ring
  let q_x : Ω F → ℕ → Ω F := fun x i => (-1 : Ω F) ^ i * x ^ (i + 1)
  have hC_single : ∀ (m : ℕ) (x : Ω F) (k : ℕ),
      C m (q_x x) (k + 1) + x * C m (q_x x) k = x * E m k := by
    intro m x k
    dsimp [C, q_x]
    rw [Finset.sum_range_succ', Finset.mul_sum, add_right_comm, ← Finset.sum_add_distrib]
    have h_zero : (∑ i ∈ Finset.range k,
        ((-1 : Ω F) ^ (i + 1) * x ^ (i + 1 + 1) * E m (k + 1 - (i + 1 + 1)) +
          x * ((-1 : Ω F) ^ i * x ^ (i + 1) * E m (k - (i + 1))))) = 0 := by
      apply Finset.sum_eq_zero
      intro i _
      have h_sub : k + 1 - (i + 1 + 1) = k - (i + 1) := by omega
      rw [h_sub, pow_succ (-1 : Ω F) i, pow_succ x (i + 1)]
      ring
    rw [h_zero, zero_add, Nat.add_sub_cancel, pow_zero, pow_one, one_mul]
  let Q : ℕ → ℕ → Ω F := fun m i => ∑ j ∈ Finset.range m, (-1 : Ω F) ^ i * (g j) ^ (i + 1)
  have hNewton_E : ∀ m n : ℕ, C m (Q m) n = (n : Ω F) * E m n := by
    intro m
    induction m with
    | zero =>
      intro n
      have h_lhs : C 0 (Q 0) n = 0 := by
        dsimp [C, Q]
        apply Finset.sum_eq_zero
        intro i _
        exact zero_mul _
      rw [h_lhs]
      cases n with
      | zero => simp
      | succ k => rw [hE_succ_zero k, mul_zero]
    | succ m ih =>
      intro n
      cases n with
      | zero =>
        dsimp [C]
        simp
      | succ k =>
        have hQ_succ : Q (m + 1) = fun i => Q m i + q_x (g m) i := by
          ext i
          dsimp [Q, q_x]
          rw [Finset.sum_range_succ]
        have h1 := hC_single m (g m) k
        rw [hQ_succ, hC_add, hC_succ, hC_succ, ih (k + 1), ih k, hE_succ_succ]
        push_cast
        linear_combination h1
  have hA_eq_E : ∀ n : ℕ, n ≤ ℓ → A n = E ℓ n := by
    intro n
    induction' n using Nat.strong_induction_on with n ih
    intro hn_le
    rcases Nat.eq_zero_or_pos n with rfl | hn_pos
    · rw [hA0, hE_zero ℓ]
    · have hn1 : 1 ≤ n := hn_pos
      have hrec := (hA_rec n hn1 hn_le).symm
      rw [hIcc_eq_range] at hrec
      have h_sum_eq : (∑ i ∈ Finset.range n,
          (∑ j ∈ Finset.range ℓ, (-1 : Ω F) ^ (i + 1 - 1) * g j ^ (i + 1)) * A (n - (i + 1))) =
          C ℓ (Q ℓ) n := by
        dsimp [C, Q]
        apply Finset.sum_congr rfl
        intro i hi
        have hin : i < n := Finset.mem_range.mp hi
        have h_ih : A (n - (i + 1)) = E ℓ (n - (i + 1)) :=
          ih (n - (i + 1)) (by omega) (by omega)
        rw [h_ih]
      rw [h_sum_eq, hNewton_E ℓ n] at hrec
      have hn_ne : (n : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
      exact mul_left_cancel₀ hn_ne hrec
  rw [hA_eq_E ℓ le_rfl, hE_diag ℓ]

theorem ld_finite_field_davenport_hasse_inv_product (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k : Type u) [Field k] [Fintype k]
    (ℓ : ℕ) (hPrime : Nat.Prime ℓ) (hNeChar : (ℓ : k) ≠ 0)
    (ψ_k : AddChar k (Ω F)) (hψ_k : ψ_k ≠ 1)
    (ν_k χ_k : kˣ →* (Ω F)ˣ)
    (hν_pow : ν_k ^ ℓ = 1) (hν_ne : ν_k ≠ 1) :
    (((χ_k (Units.mk0 (ℓ : k) hNeChar))⁻¹) ^ ℓ : Ω F) *
      (∑ x : kˣ, ((χ_k ^ ℓ) x : Ω F) * ψ_k (x : k)) *
      (∏ j ∈ (Finset.range ℓ).erase 0,
        (∑ x : kˣ, ((ν_k ^ j) x : Ω F) * ψ_k (x : k))) =
    ∏ j ∈ Finset.range ℓ,
      (∑ x : kˣ, ((ν_k ^ j * χ_k) x : Ω F) * ψ_k (x : k)) :=
by
  obtain ⟨hν_ne_pow, ⟨ζ, hζ_ne, hζ_pow, hζ_prim, hζ_prod⟩, hν_orth⟩ :=
    ld_finite_field_cyclic_char_and_zeta F k ℓ hPrime ν_k hν_pow hν_ne
  obtain ⟨M, Λ, hM_mem, hM_zero, _hM_one, hΛ_prime_pow, hΛ_ne_zero,
      hNewton, hΛ_sum_nz, hΛ_char_orth, hΛ_dh⟩ :=
    ld_monic_deg_and_von_mangoldt_newton F k
  obtain ⟨σ, 𝒩_ℓ, hσ_mem, hσ_mul, hσ_zero, hσ_add, hσ_expand, hσ_irr,
      h𝒩_prop, h𝒩_one, h𝒩_mul, _h𝒩_deg1, h𝒩_deg_ell⟩ :=
    ld_norm_poly_operator_and_deg_ell_split F k ℓ hPrime hNeChar
      ζ hζ_ne hζ_pow hζ_prim hζ_prod M hM_mem
  have hFiber :=
    ld_norm_poly_von_mangoldt_fiber_sum F k ℓ hPrime ν_k hν_ne_pow hν_orth
      M Λ hM_mem hΛ_prime_pow hΛ_ne_zero hΛ_sum_nz hΛ_char_orth
      σ 𝒩_ℓ hσ_mem hσ_mul hσ_zero hσ_add hσ_expand hσ_irr h𝒩_prop h𝒩_mul
  let lam_α : (kˣ →* (Ω F)ˣ) → Polynomial k → Ω F := fun α G =>
    (if h : (-1 : k) ^ G.natDegree * G.coeff 0 ≠ 0 then
      (α (Units.mk0 ((-1 : k) ^ G.natDegree * G.coeff 0) h) : Ω F)
    else 0) * ψ_k (-G.nextCoeff)
  let μ_α : (kˣ →* (Ω F)ˣ) → Polynomial k → Ω F := fun α P => lam_α α (𝒩_ℓ P)
  have hlam_one : ∀ α : kˣ →* (Ω F)ˣ, lam_α α 1 = 1 := by
    intro α
    dsimp [lam_α]
    have h1_deg : (1 : Polynomial k).natDegree = 0 := Polynomial.natDegree_one
    have h1_c0 : (1 : Polynomial k).coeff 0 = 1 := Polynomial.coeff_one_zero
    have h1_next : (1 : Polynomial k).nextCoeff = 0 := by
      rw [← Polynomial.C_1, Polynomial.nextCoeff_C_eq_zero]
    rw [h1_deg, h1_c0, h1_next, pow_zero, mul_one, dif_pos one_ne_zero, neg_zero,
      AddChar.map_zero_eq_one, mul_one]
    have h_u1 : Units.mk0 (1 : k) one_ne_zero = 1 := by ext; rfl
    rw [h_u1, map_one, Units.val_one]
  have hlam_mul : ∀ (α : kˣ →* (Ω F)ˣ) (f g : Polynomial k),
      f.Monic → g.Monic → lam_α α (f * g) = lam_α α f * lam_α α g := by
    intro α f g hf hg
    dsimp [lam_α]
    have hdeg : (f * g).natDegree = f.natDegree + g.natDegree := hf.natDegree_mul hg
    have hc0 : (f * g).coeff 0 = f.coeff 0 * g.coeff 0 := Polynomial.mul_coeff_zero f g
    have hnext : (f * g).nextCoeff = f.nextCoeff + g.nextCoeff := hf.nextCoeff_mul hg
    have hprod_c : (-1 : k) ^ (f * g).natDegree * (f * g).coeff 0 =
        ((-1 : k) ^ f.natDegree * f.coeff 0) * ((-1 : k) ^ g.natDegree * g.coeff 0) := by
      rw [hdeg, hc0, pow_add]
      ring
    have hψ_mul : ψ_k (-(f * g).nextCoeff) = ψ_k (-f.nextCoeff) * ψ_k (-g.nextCoeff) := by
      rw [hnext, neg_add, AddChar.map_add_eq_mul]
    rw [hψ_mul]
    set cf := (-1 : k) ^ f.natDegree * f.coeff 0
    set cg := (-1 : k) ^ g.natDegree * g.coeff 0
    have h_if : (if h : (-1 : k) ^ (f * g).natDegree * (f * g).coeff 0 ≠ 0 then
        (α (Units.mk0 ((-1 : k) ^ (f * g).natDegree * (f * g).coeff 0) h) : Ω F) else 0) =
      (if h : cf ≠ 0 then (α (Units.mk0 cf h) : Ω F) else 0) *
      (if h : cg ≠ 0 then (α (Units.mk0 cg h) : Ω F) else 0) := by
      by_cases hcf : cf = 0
      · have hcfg : (-1 : k) ^ (f * g).natDegree * (f * g).coeff 0 = 0 := by
          rw [hprod_c, hcf, zero_mul]
        rw [dif_neg (not_not.mpr hcfg), dif_neg (not_not.mpr hcf), zero_mul]
      · by_cases hcg : cg = 0
        · have hcfg : (-1 : k) ^ (f * g).natDegree * (f * g).coeff 0 = 0 := by
            rw [hprod_c, hcg, mul_zero]
          rw [dif_neg (not_not.mpr hcfg), dif_neg (not_not.mpr hcg), mul_zero]
        · have hcfg : (-1 : k) ^ (f * g).natDegree * (f * g).coeff 0 ≠ 0 := by
            rw [hprod_c]
            exact mul_ne_zero hcf hcg
          rw [dif_pos hcfg, dif_pos hcf, dif_pos hcg]
          have hu : Units.mk0 ((-1 : k) ^ (f * g).natDegree * (f * g).coeff 0) hcfg =
              Units.mk0 cf hcf * Units.mk0 cg hcg := by
            ext
            exact hprod_c
          rw [hu, map_mul, Units.val_mul]
    rw [h_if]
    ring
  have hμ_mul : ∀ (α : kˣ →* (Ω F)ˣ) (f g : Polynomial k),
      f.Monic → g.Monic → μ_α α (f * g) = μ_α α f * μ_α α g := by
    intro α f g hf hg
    dsimp [μ_α]
    have hfM : f ∈ M f.natDegree := (hM_mem f.natDegree f).mpr ⟨hf, rfl⟩
    have hgM : g ∈ M g.natDegree := (hM_mem g.natDegree g).mpr ⟨hg, rfl⟩
    have hNf : (𝒩_ℓ f).Monic := ((hM_mem f.natDegree (𝒩_ℓ f)).mp (h𝒩_prop f.natDegree f hfM).1).1
    have hNg : (𝒩_ℓ g).Monic := ((hM_mem g.natDegree (𝒩_ℓ g)).mp (h𝒩_prop g.natDegree g hgM).1).1
    rw [h𝒩_mul f g hf hg, hlam_mul α (𝒩_ℓ f) (𝒩_ℓ g) hNf hNg]
  have hlam_c0_zero : ∀ (β : kˣ →* (Ω F)ˣ) (G : Polynomial k),
      G.coeff 0 = 0 → lam_α β G = 0 := by
    intro β G hG0
    dsimp [lam_α]
    have h0 : (-1 : k) ^ G.natDegree * G.coeff 0 = 0 := by rw [hG0, mul_zero]
    rw [dif_neg (not_not.mpr h0), zero_mul]
  have h𝒩_c0_iff : ∀ (d : ℕ) (P : Polynomial k), P ∈ M d →
      ((𝒩_ℓ P).coeff 0 ≠ 0 ↔ P.coeff 0 ≠ 0) := by
    intro d P hP
    have hrel := (h𝒩_prop d P hP).2.2
    have h_neg1 : (-1 : k) ^ d ≠ 0 := pow_ne_zero d (neg_ne_zero.mpr one_ne_zero)
    constructor
    · intro hN0 hP0
      apply hN0
      have h1 : (-1 : k) ^ d * (𝒩_ℓ P).coeff 0 = 0 := by
        rw [hrel, hP0, mul_zero, zero_pow hPrime.ne_zero]
      exact (mul_eq_zero.mp h1).resolve_left h_neg1
    · intro hP0 hN0
      have h1 : ((-1 : k) ^ d * P.coeff 0) ^ ℓ = 0 := by
        rw [← hrel, hN0, mul_zero]
      exact mul_ne_zero h_neg1 hP0 (pow_eq_zero h1)
  have hPowerSum : ∀ (α : kˣ →* (Ω F)ˣ) (d : ℕ), 1 ≤ d →
      (∑ P ∈ M d, (Λ P : Ω F) * μ_α α P) =
        ∑ j ∈ Finset.range ℓ,
          (-1 : Ω F) ^ (d - 1) * (∑ x : kˣ, ((ν_k ^ j * α) x : Ω F) * ψ_k (x : k)) ^ d := by
    intro α d hd
    set M_nz := (M d).filter (fun G => G.coeff 0 ≠ 0)
    have h_restrict_P : (∑ P ∈ M d, (Λ P : Ω F) * μ_α α P) =
        ∑ P ∈ M_nz, (Λ P : Ω F) * lam_α α (𝒩_ℓ P) := by
      rw [← Finset.sum_filter_add_sum_filter_not (M d) (fun P => P.coeff 0 ≠ 0)]
      have h_zero : ∑ P ∈ (M d).filter (fun P => ¬ P.coeff 0 ≠ 0), (Λ P : Ω F) * μ_α α P = 0 := by
        apply Finset.sum_eq_zero
        intro P hP
        rw [Finset.mem_filter] at hP
        have hP0 : P.coeff 0 = 0 := not_not.mp hP.2
        have hN0 : (𝒩_ℓ P).coeff 0 = 0 := by
          by_contra hN0
          exact hP.2 ((h𝒩_c0_iff d P hP.1).mp hN0)
        dsimp [μ_α]
        rw [hlam_c0_zero α (𝒩_ℓ P) hN0, mul_zero]
      rw [h_zero, add_zero]
    rw [h_restrict_P]
    have h_maps : ∀ P ∈ M_nz, 𝒩_ℓ P ∈ M_nz := by
      intro P hP
      rw [Finset.mem_filter] at hP ⊢
      exact ⟨(h𝒩_prop d P hP.1).1, (h𝒩_c0_iff d P hP.1).mpr hP.2⟩
    rw [← Finset.sum_fiberwise_of_maps_to h_maps]
    have h_fiber_eval : ∀ G ∈ M_nz,
        (∑ P ∈ M_nz.filter (fun P => 𝒩_ℓ P = G), (Λ P : Ω F) * lam_α α (𝒩_ℓ P)) =
          ∑ j ∈ Finset.range ℓ, (Λ G : Ω F) * lam_α (ν_k ^ j * α) G := by
      intro G hG
      have hG_mem : G ∈ M d := (Finset.mem_filter.mp hG).1
      have hG_nz : G.coeff 0 ≠ 0 := (Finset.mem_filter.mp hG).2
      have hG_deg : G.natDegree = d := ((hM_mem d G).mp hG_mem).2
      have h_filt_eq : M_nz.filter (fun P => 𝒩_ℓ P = G) = (M d).filter (fun P => 𝒩_ℓ P = G) := by
        ext P
        simp only [M_nz, Finset.mem_filter]
        constructor
        · rintro ⟨⟨hP1, _⟩, hP2⟩
          exact ⟨hP1, hP2⟩
        · rintro ⟨hP1, hP2⟩
          refine ⟨⟨hP1, ?_⟩, hP2⟩
          rw [← h𝒩_c0_iff d P hP1, hP2]
          exact hG_nz
      rw [h_filt_eq]
      have h_const_G : (∑ P ∈ (M d).filter (fun P => 𝒩_ℓ P = G), (Λ P : Ω F) * lam_α α (𝒩_ℓ P)) =
          (∑ P ∈ (M d).filter (fun P => 𝒩_ℓ P = G), (Λ P : Ω F)) * lam_α α G := by
        rw [Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro P hP
        rw [(Finset.mem_filter.mp hP).2]
      rw [h_const_G, ← Nat.cast_sum, hFiber d hd G hG, Nat.cast_mul]
      have hG_c : (-1 : k) ^ d * G.coeff 0 ≠ 0 :=
        mul_ne_zero (pow_ne_zero d (neg_ne_zero.mpr one_ne_zero)) hG_nz
      set u_G := Units.mk0 ((-1 : k) ^ d * G.coeff 0) hG_c
      have h_card : ((Finset.univ.filter (fun y : k => y ^ ℓ = (-1 : k) ^ d * G.coeff 0)).card : Ω F) =
          ∑ j ∈ Finset.range ℓ, ((ν_k ^ j) u_G : Ω F) := ((hν_orth u_G).1).symm
      rw [h_card, mul_assoc, Finset.sum_mul, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j _hj
      congr 1
      dsimp only [lam_α]
      have hG_c' : (-1 : k) ^ G.natDegree * G.coeff 0 ≠ 0 := by
        rw [hG_deg]
        exact hG_c
      rw [dif_pos hG_c', dif_pos hG_c', ← mul_assoc]
      congr 1
      have hu_eq : Units.mk0 ((-1 : k) ^ G.natDegree * G.coeff 0) hG_c' = u_G := by
        ext
        rw [Units.val_mk0, Units.val_mk0, hG_deg]
      rw [hu_eq, MonoidHom.mul_apply, Units.val_mul]
    rw [Finset.sum_congr rfl h_fiber_eval, Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j _hj
    have h_restore_G : (∑ G ∈ M_nz, (Λ G : Ω F) * lam_α (ν_k ^ j * α) G) =
        ∑ G ∈ M d, (Λ G : Ω F) * lam_α (ν_k ^ j * α) G := by
      symm
      rw [← Finset.sum_filter_add_sum_filter_not (M d) (fun G => G.coeff 0 ≠ 0)]
      have h_zero : ∑ G ∈ (M d).filter (fun G => ¬ G.coeff 0 ≠ 0),
          (Λ G : Ω F) * lam_α (ν_k ^ j * α) G = 0 := by
        apply Finset.sum_eq_zero
        intro G hG
        rw [Finset.mem_filter] at hG
        rw [hlam_c0_zero (ν_k ^ j * α) G (not_not.mp hG.2), mul_zero]
      rw [h_zero, add_zero]
    rw [h_restore_G]
    exact hΛ_dh (ν_k ^ j * α) ψ_k hψ_k d hd
  have hMaster : ∀ α : kˣ →* (Ω F)ˣ,
      (((α (Units.mk0 (ℓ : k) hNeChar))⁻¹) ^ ℓ : Ω F) *
        (∑ x : kˣ, ((α ^ ℓ) x : Ω F) * ψ_k (x : k)) *
        (∑ H ∈ M (ℓ - 1), ψ_k (-(𝒩_ℓ H).nextCoeff)) =
      ∏ j ∈ Finset.range ℓ,
        (∑ x : kˣ, ((ν_k ^ j * α) x : Ω F) * ψ_k (x : k)) := by
    intro α
    rw [← h𝒩_deg_ell α ψ_k]
    let A : ℕ → Ω F := fun n => ∑ P ∈ M n, μ_α α P
    let g : ℕ → Ω F := fun j => ∑ x : kˣ, ((ν_k ^ j * α) x : Ω F) * ψ_k (x : k)
    change A ℓ = ∏ j ∈ Finset.range ℓ, g j
    apply ld_elem_symm_newton_uniqueness F ℓ g A
    · dsimp [A, μ_α]
      rw [hM_zero, Finset.sum_singleton, h𝒩_one, hlam_one α]
    · intro n hn1 _hn_le
      have hN := hNewton (μ_α α) (hμ_mul α) n
      rw [← hN]
      apply Finset.sum_congr rfl
      intro d hd
      rw [Finset.mem_Icc] at hd
      rw [hPowerSum α d hd.1]
  have hψ_sum_units : (∑ x : kˣ, ψ_k (x : k)) = -1 := by
    have hψ_ne0 : ψ_k ≠ 0 := by rwa [← AddChar.one_eq_zero]
    have h_univ : (∑ y : k, ψ_k y) = 0 := by
      rw [AddChar.sum_eq_ite ψ_k, if_neg hψ_ne0]
    have h_split : (∑ y : k, ψ_k y) = ψ_k 0 + ∑ y ∈ Finset.univ.erase (0 : k), ψ_k y := by
      rw [add_comm, Finset.sum_erase_add _ _ (Finset.mem_univ (0 : k))]
    have h_bij : (∑ x : kˣ, ψ_k (x : k)) = ∑ y ∈ Finset.univ.erase (0 : k), ψ_k y := by
      refine Finset.sum_bij (fun (x : kˣ) _ => (x : k)) ?_ ?_ ?_ ?_
      · intro x _
        exact Finset.mem_erase.mpr ⟨Units.ne_zero x, Finset.mem_univ _⟩
      · intro x₁ _ x₂ _ h
        exact Units.ext h
      · intro y hy
        have hy0 : y ≠ 0 := (Finset.mem_erase.mp hy).1
        exact ⟨Units.mk0 y hy0, Finset.mem_univ _, Units.val_mk0 hy0⟩
      · intro x _
        rfl
    rw [h_bij]
    rw [h_split, AddChar.map_zero_eq_one] at h_univ
    exact eq_neg_of_add_eq_zero_right h_univ
  have h1 := hMaster 1
  have h1_lhs : (((((1 : kˣ →* (Ω F)ˣ) (Units.mk0 (ℓ : k) hNeChar))⁻¹) ^ ℓ : Ω F) *
      (∑ x : kˣ, (((1 : kˣ →* (Ω F)ˣ) ^ ℓ) x : Ω F) * ψ_k (x : k)) *
      (∑ H ∈ M (ℓ - 1), ψ_k (-(𝒩_ℓ H).nextCoeff))) =
      (-1 : Ω F) * (∑ H ∈ M (ℓ - 1), ψ_k (-(𝒩_ℓ H).nextCoeff)) := by
    have h_sum1 : (∑ x : kˣ, (((1 : kˣ →* (Ω F)ˣ) ^ ℓ) x : Ω F) * ψ_k (x : k)) = -1 := by
      rw [← hψ_sum_units]
      apply Finset.sum_congr rfl
      intro x _
      rw [MonoidHom.pow_apply, MonoidHom.one_apply, one_pow, Units.val_one, one_mul]
    rw [MonoidHom.one_apply, inv_one, Units.val_one, one_pow, one_mul, h_sum1]
  have h1_rhs : (∏ j ∈ Finset.range ℓ,
      (∑ x : kˣ, ((ν_k ^ j * (1 : kˣ →* (Ω F)ˣ)) x : Ω F) * ψ_k (x : k))) =
      (-1 : Ω F) * (∏ j ∈ (Finset.range ℓ).erase 0,
        (∑ x : kˣ, ((ν_k ^ j) x : Ω F) * ψ_k (x : k))) := by
    have h_prod_eq : (∏ j ∈ Finset.range ℓ,
        (∑ x : kˣ, ((ν_k ^ j * (1 : kˣ →* (Ω F)ˣ)) x : Ω F) * ψ_k (x : k))) =
        ∏ j ∈ Finset.range ℓ, (∑ x : kˣ, ((ν_k ^ j) x : Ω F) * ψ_k (x : k)) := by
      apply Finset.prod_congr rfl
      intro j _
      rw [mul_one (ν_k ^ j)]
    rw [h_prod_eq]
    have h0_mem : (0 : ℕ) ∈ Finset.range ℓ := Finset.mem_range.mpr hPrime.pos
    rw [← Finset.mul_prod_erase (Finset.range ℓ)
      (fun j => ∑ x : kˣ, ((ν_k ^ j) x : Ω F) * ψ_k (x : k)) h0_mem]
    have h_j0 : (∑ x : kˣ, ((ν_k ^ 0) x : Ω F) * ψ_k (x : k)) = -1 := by
      rw [pow_zero, ← hψ_sum_units]
      apply Finset.sum_congr rfl
      intro x _
      rw [MonoidHom.one_apply, Units.val_one, one_mul]
    rw [h_j0]
  rw [h1_lhs, h1_rhs] at h1
  have hC_eq : (∑ H ∈ M (ℓ - 1), ψ_k (-(𝒩_ℓ H).nextCoeff)) =
      ∏ j ∈ (Finset.range ℓ).erase 0,
        (∑ x : kˣ, ((ν_k ^ j) x : Ω F) * ψ_k (x : k)) :=
    mul_left_cancel₀ (neg_ne_zero.mpr one_ne_zero) h1
  rw [← hC_eq]
  exact hMaster χ_k

theorem ld_tame_fml_cond_one (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    [FiniteDimensional F L] [FiniteDimensional F K]
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ne : ν₁ ≠ 1)
    (hν₁_triv1 : ∀ u ∈ unitGroup F L 1, ν₁ u = 1)
    (hν₁_cond_eq : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      j ≠ 0 → condExp F L (ν₁ ^ j) = 1)
    (hχ'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1)
    (hχ'K_cond : ∀ u ∈ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))),
      (χ'.comp (Units.map (normLM F hLK))) u = 1)
    (hNeP : Module.finrank L (IntermediateField.extendScalars hLK) ≠ p F)
    (hResDeg : resDeg F K = resDeg F L)
    (hValNorm : ∀ y : K, valL F K y = valL F L (normLM F hLK y))
    (hValAlg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hCondψK : condExpChar F K (traceChar F hLK ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * (condExpChar F L ψ + 1) - 1)
    (ϖ_K : Kˣ) (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L ((Units.map (normLM F hLK) ϖ_K : Lˣ) : L) = 1)
    (hν₁_ϖ : ν₁ (Units.map (normLM F hLK) ϖ_K) = 1)
    (hResSurj : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLK x = 0 ∨
          1 ≤ valL F K (y - IntermediateField.inclusion hLK x)))
    (ha1 : condExp F L χ' = 1)
    (hCondTwist : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      condExp F L (ν₁ ^ j * χ') = 1)
    (hCondχ'K : condExp F K (χ'.comp (Units.map (normLM F hLK))) = 1)
    (hDH : ∀ (k : Type u) [Field k] [Fintype k],
      ((Module.finrank L (IntermediateField.extendScalars hLK) : k) ≠ 0) →
      ∀ (ψ_k : AddChar k (Ω F)), ψ_k ≠ 1 →
      ∀ (ν_k χ_k : kˣ →* (Ω F)ˣ),
        ν_k ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1 →
        ν_k ≠ 1 →
        ∀ (hNeChar : (Module.finrank L (IntermediateField.extendScalars hLK) : k) ≠ 0),
        (((χ_k (Units.mk0 (Module.finrank L (IntermediateField.extendScalars hLK) : k) hNeChar))⁻¹) ^
            (Module.finrank L (IntermediateField.extendScalars hLK)) : Ω F) *
          (∑ x : kˣ, ((χ_k ^ (Module.finrank L (IntermediateField.extendScalars hLK))) x : Ω F) * ψ_k (x : k)) *
          (∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
            (∑ x : kˣ, ((ν_k ^ j) x : Ω F) * ψ_k (x : k))) =
        ∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
          (∑ x : kˣ, ((ν_k ^ j * χ_k) x : Ω F) * ψ_k (x : k))) :
    tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j) ψ) =
    tateEps F K 1 (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j * χ') ψ) :=
by
  classical
  
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, _, hval_add_L,
    hunit0_L, hunit_ge1_L, hunit_val0_L⟩ := ld_valL_and_unitGroup_props F L
  obtain ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K, hval_inv_K, _, hval_add_K,
    hunit0_K, hunit_ge1_K, hunit_val0_K⟩ := ld_valL_and_unitGroup_props F K
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨S₁, hS₁⟩ := ld_valL_mod_one_finset F L hval0_L hval_neg_L hval_mul_L hval_add_L
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨k_L, hField_kL, hFin_kL, resL, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ :=
    ld_valL_residue_field_exists F L hval0_L hval1_L hval_neg1_L hval_neg_L hval_mul_L
      hval_inv_L hval_add_L S₁ hS₁
  letI : Field k_L := hField_kL
  letI : Fintype k_L := hFin_kL
  set ℓ := Module.finrank L (IntermediateField.extendScalars hLK)
  have hℓ_ge2 : 2 ≤ ℓ := hPrime.two_le
  have hℓ_pos : 0 < ℓ := hPrime.pos

  
  
  set ϖ_L : Lˣ := Units.map (normLM F hLK) ϖ_K
  set n : ℤ := condExpChar F L ψ
  set c₁ : Lˣ := ϖ_L ^ ((1 : ℤ) + n)
  let valHomL : Lˣ →* Multiplicative ℤ :=
    { toFun := fun u => Multiplicative.ofAdd (valL F L (u : L))
      map_one' := by rw [Units.val_one, hval1_L]; rfl
      map_mul' := fun u v => by
        rw [Units.val_mul, hval_mul_L (u : L) (v : L) (Units.ne_zero u) (Units.ne_zero v),
          ofAdd_add] }
  have hc₁_val : valL F L (c₁ : L) = 1 + n := by
    have hz := congrArg Multiplicative.toAdd (map_zpow valHomL ϖ_L (1 + n))
    rw [toAdd_zpow] at hz
    change valL F L (c₁ : L) = (1 + n) • valL F L (ϖ_L : L) at hz
    rw [hz, hϖ_L, smul_eq_mul, mul_one]
  have hν₁_c₁ : ν₁ c₁ = 1 := by
    dsimp only [c₁]
    rw [map_zpow, hν₁_ϖ, one_zpow]
  obtain ⟨hψ_triv, ⟨x₁, hx₁_ne, hx₁_val, hx₁_ψ⟩, _, _⟩ :=
    ld_condExp_and_condExpChar_spec F L ψ hψ 1
  set s_L : k_L → L := fun a => (hresL_surj a).choose
  have hs_L_int : ∀ a : k_L, s_L a = 0 ∨ 0 ≤ valL F L (s_L a) :=
    fun a => (hresL_surj a).choose_spec.1
  have hs_L_res : ∀ a : k_L, resL (s_L a) = a :=
    fun a => (hresL_surj a).choose_spec.2
  have hs_L_ne : ∀ a : k_L, a ≠ 0 → s_L a ≠ 0 := by
    intro a ha h0
    apply ha
    rw [← hs_L_res a, h0, hresL_0]
  have hs_L_val0 : ∀ a : k_L, a ≠ 0 → valL F L (s_L a) = 0 := by
    intro a ha
    have hge0 : 0 ≤ valL F L (s_L a) := (hs_L_int a).resolve_left (hs_L_ne a ha)
    by_contra hne
    have hge1 : 1 ≤ valL F L (s_L a) := by omega
    have hres0 : resL (s_L a) = 0 := (hresL_ker (s_L a) (hs_L_int a)).mpr (Or.inr hge1)
    rw [hs_L_res a] at hres0
    exact ha hres0
  set ψ_tilde : k_L → Ω F := fun a => ψ (((c₁⁻¹ : Lˣ) : L) * s_L a)
  have hψ_int : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ψ_tilde (resL x) = ψ (((c₁⁻¹ : Lˣ) : L) * x) := by
    intro x hx_int
    set a : k_L := resL x
    have hneg_s_int : -(s_L a) = 0 ∨ 0 ≤ valL F L (-(s_L a)) := by
      rcases hs_L_int a with hs0 | hsge
      · left; rw [hs0, neg_zero]
      · right; rw [hval_neg_L]; exact hsge
    set d : L := x - s_L a
    have hd_int : d = 0 ∨ 0 ≤ valL F L d := by
      dsimp only [d]
      rw [sub_eq_add_neg]
      exact hval_add_L 0 x (-(s_L a)) hx_int hneg_s_int
    have hd_res : resL d = 0 := by
      dsimp only [d]
      rw [sub_eq_add_neg, (hresL_ring x (-(s_L a)) hx_int hneg_s_int).1,
        (hresL_ring (s_L a) (s_L a) (hs_L_int a) (hs_L_int a)).2.2, hs_L_res a]
      exact add_neg_cancel a
    have hd1 : d = 0 ∨ 1 ≤ valL F L d := (hresL_ker d hd_int).mp hd_res
    set w : L := ((c₁⁻¹ : Lˣ) : L) * d
    have hw_cond : w = 0 ∨ -n ≤ valL F L w := by
      by_cases hd0 : d = 0
      · left; dsimp only [w]; rw [hd0, mul_zero]
      · right
        have hd_ge1 : 1 ≤ valL F L d := hd1.resolve_left hd0
        dsimp only [w]
        rw [hval_mul_L ((c₁⁻¹ : Lˣ) : L) d (Units.ne_zero c₁⁻¹) hd0,
          hval_inv_L c₁, hc₁_val]
        omega
    have hψ_w : ψ w = 1 := hψ_triv w hw_cond
    have hx_decomp : ((c₁⁻¹ : Lˣ) : L) * x = ((c₁⁻¹ : Lˣ) : L) * s_L a + w := by
      dsimp only [w, d]; ring
    rw [hx_decomp, ψ.map_add_eq_mul, hψ_w, mul_one]
  have hψ_zero : ψ_tilde 0 = 1 := by
    rw [← hresL_0, hψ_int 0 (Or.inl rfl), mul_zero, ψ.map_zero_eq_one]
  have hψ_add : ∀ a b : k_L, ψ_tilde (a + b) = ψ_tilde a * ψ_tilde b := by
    intro a b
    have hab_int : s_L a + s_L b = 0 ∨ 0 ≤ valL F L (s_L a + s_L b) :=
      hval_add_L 0 (s_L a) (s_L b) (hs_L_int a) (hs_L_int b)
    have hab_res : resL (s_L a + s_L b) = a + b := by
      rw [(hresL_ring (s_L a) (s_L b) (hs_L_int a) (hs_L_int b)).1, hs_L_res a, hs_L_res b]
    rw [← hab_res, hψ_int (s_L a + s_L b) hab_int, mul_add, ψ.map_add_eq_mul]
  let ψ_k : AddChar k_L (Ω F) :=
    { toFun := ψ_tilde
      map_zero_eq_one' := hψ_zero
      map_add_eq_mul' := hψ_add }
  have hψ_k_apply : ∀ a : k_L, ψ_k a = ψ_tilde a := fun _ => rfl
  have hψ_k_ne : ψ_k ≠ 1 := by
    intro hψ1
    set z₁ : L := (c₁ : L) * x₁
    have hz₁_val : 0 ≤ valL F L z₁ := by
      dsimp only [z₁]
      rw [hval_mul_L (c₁ : L) x₁ (Units.ne_zero c₁) hx₁_ne, hc₁_val]
      omega
    have hinv_c₁ : ((c₁⁻¹ : Lˣ) : L) * (c₁ : L) = 1 := by exact_mod_cast Units.inv_mul c₁
    have heval : ψ_k (resL z₁) = ψ x₁ := by
      rw [hψ_k_apply, hψ_int z₁ (Or.inr hz₁_val)]
      dsimp only [z₁]
      rw [← mul_assoc, hinv_c₁, one_mul]
    have h1 : ψ_k (resL z₁) = 1 := by rw [hψ1]; rfl
    exact hx₁_ψ (heval.symm.trans h1)

  
  set v_unit : k_Lˣ → Lˣ := fun a => Units.mk0 (s_L (a : k_L)) (hs_L_ne (a : k_L) (Units.ne_zero a))
  have hv_unit_val0 : ∀ a : k_Lˣ, valL F L ((v_unit a : Lˣ) : L) = 0 :=
    fun a => hs_L_val0 (a : k_L) (Units.ne_zero a)
  have hv_unit_int : ∀ a : k_Lˣ, ((v_unit a : Lˣ) : L) = 0 ∨ 0 ≤ valL F L ((v_unit a : Lˣ) : L) :=
    fun a => hs_L_int (a : k_L)
  have hv_unit_res : ∀ a : k_Lˣ, resL ((v_unit a : Lˣ) : L) = (a : k_L) :=
    fun a => hs_L_res (a : k_L)
  have hdesc_unit : ∀ (θ : Lˣ →* (Ω F)ˣ), (∀ u ∈ unitGroup F L 1, θ u = 1) →
      ∀ (u : Lˣ) (a : k_Lˣ), valL F L (u : L) = 0 → resL (u : L) = (a : k_L) →
        (θ (v_unit a))⁻¹ = (θ u)⁻¹ := by
    intro θ hθ1 u a hu_val hu_res
    have hu_int : (u : L) = 0 ∨ 0 ≤ valL F L (u : L) := Or.inr (by omega)
    have hneg_v_int : -((v_unit a : Lˣ) : L) = 0 ∨ 0 ≤ valL F L (-((v_unit a : Lˣ) : L)) := by
      right; rw [hval_neg_L, hv_unit_val0 a]
    set d : L := (u : L) - ((v_unit a : Lˣ) : L)
    have hd_int : d = 0 ∨ 0 ≤ valL F L d := by
      dsimp only [d]
      rw [sub_eq_add_neg]
      exact hval_add_L 0 (u : L) (-((v_unit a : Lˣ) : L)) hu_int hneg_v_int
    have hd_res : resL d = 0 := by
      dsimp only [d]
      rw [sub_eq_add_neg,
        (hresL_ring (u : L) (-((v_unit a : Lˣ) : L)) hu_int hneg_v_int).1,
        (hresL_ring ((v_unit a : Lˣ) : L) ((v_unit a : Lˣ) : L) (hv_unit_int a) (hv_unit_int a)).2.2,
        hu_res, hv_unit_res a, add_neg_cancel]
    have hd1 : d = 0 ∨ 1 ≤ valL F L d := (hresL_ker d hd_int).mp hd_res
    set h : Lˣ := (v_unit a)⁻¹ * u
    have hh_sub : (h : L) - 1 = (((v_unit a)⁻¹ : Lˣ) : L) * d := by
      have hinv : (((v_unit a)⁻¹ : Lˣ) : L) * ((v_unit a : Lˣ) : L) = 1 := by
        exact_mod_cast Units.inv_mul (v_unit a)
      calc (h : L) - 1 =
            (((v_unit a)⁻¹ : Lˣ) : L) * (u : L) - (((v_unit a)⁻¹ : Lˣ) : L) * ((v_unit a : Lˣ) : L) := by
            rw [Units.val_mul, hinv]
        _ = (((v_unit a)⁻¹ : Lˣ) : L) * d := by dsimp only [d]; ring
    have hh_mem : h ∈ unitGroup F L 1 := by
      rw [hunit_ge1_L 1 le_rfl h]
      by_cases hd0 : d = 0
      · left
        have hsub0 : (h : L) - 1 = 0 := by rw [hh_sub, hd0, mul_zero]
        exact sub_eq_zero.mp hsub0
      · right
        have hd_ge1 : 1 ≤ valL F L d := hd1.resolve_left hd0
        rw [hh_sub, hval_mul_L (((v_unit a)⁻¹ : Lˣ) : L) d (Units.ne_zero (v_unit a)⁻¹) hd0,
          hval_inv_L (v_unit a), hv_unit_val0 a]
        omega
    have hθ_h : θ h = 1 := hθ1 h hh_mem
    have hθ_u : θ u = θ (v_unit a) := by
      have huv : v_unit a * h = u := mul_inv_cancel_left (v_unit a) u
      rw [← huv, map_mul, hθ_h, mul_one]
    rw [hθ_u]
  let mkDescChar : ∀ (θ : Lˣ →* (Ω F)ˣ), (∀ u ∈ unitGroup F L 1, θ u = 1) → (k_Lˣ →* (Ω F)ˣ) :=
    fun θ hθ1 =>
      { toFun := fun a => (θ (v_unit a))⁻¹
        map_one' := by
          have h1 : (θ (v_unit 1))⁻¹ = (θ 1)⁻¹ :=
            hdesc_unit θ hθ1 1 1 (by rw [Units.val_one, hval1_L]) (by rw [Units.val_one, hresL_1, Units.val_one])
          rw [h1, map_one, inv_one]
        map_mul' := fun a b => by
          have hab_val : valL F L ((v_unit a * v_unit b : Lˣ) : L) = 0 := by
            rw [Units.val_mul,
              hval_mul_L ((v_unit a : Lˣ) : L) ((v_unit b : Lˣ) : L)
                (Units.ne_zero (v_unit a)) (Units.ne_zero (v_unit b)),
              hv_unit_val0 a, hv_unit_val0 b, add_zero]
          have hab_res : resL ((v_unit a * v_unit b : Lˣ) : L) = ((a * b : k_Lˣ) : k_L) := by
            rw [Units.val_mul,
              (hresL_ring ((v_unit a : Lˣ) : L) ((v_unit b : Lˣ) : L)
                (hv_unit_int a) (hv_unit_int b)).2.1,
              hv_unit_res a, hv_unit_res b, Units.val_mul]
          have hm := hdesc_unit θ hθ1 (v_unit a * v_unit b) (a * b) hab_val hab_res
          rw [hm, map_mul, mul_inv] }
  have hχ'_triv1 : ∀ u ∈ unitGroup F L 1, χ' u = 1 := by
    have hspec := (ld_condExp_and_condExpChar_spec F L ψ hψ χ').2.2.1 (by omega)
    simpa [ha1] using hspec.1
  let ν_k : k_Lˣ →* (Ω F)ˣ := mkDescChar ν₁ hν₁_triv1
  let χ_k : k_Lˣ →* (Ω F)ˣ := mkDescChar χ' hχ'_triv1
  have hν_k_unit : ∀ (u : Lˣ) (a : k_Lˣ), valL F L (u : L) = 0 → resL (u : L) = (a : k_L) →
      ν_k a = (ν₁ u)⁻¹ := fun u a hu ha => hdesc_unit ν₁ hν₁_triv1 u a hu ha
  have hχ_k_unit : ∀ (u : Lˣ) (a : k_Lˣ), valL F L (u : L) = 0 → resL (u : L) = (a : k_L) →
      χ_k a = (χ' u)⁻¹ := fun u a hu ha => hdesc_unit χ' hχ'_triv1 u a hu ha
  have hν_pow : ν_k ^ ℓ = 1 := by
    apply MonoidHom.ext
    intro a
    rw [MonoidHom.pow_apply, MonoidHom.one_apply]
    change (ν₁ (v_unit a))⁻¹ ^ ℓ = 1
    rw [inv_pow, ← MonoidHom.pow_apply, hν₁_pow, MonoidHom.one_apply, inv_one]
  have hν_ne : ν_k ≠ 1 := by
    intro hν1
    have hν₁_pow1 : ν₁ ^ 1 = ν₁ := by
      apply MonoidHom.ext
      intro x
      rw [MonoidHom.pow_apply, pow_one]
    have hcond_ν₁ : condExp F L ν₁ = 1 := by
      have h1 := hν₁_cond_eq 1 hPrime.one_lt one_ne_zero
      rwa [hν₁_pow1] at h1
    have hspec_ν₁ := (ld_condExp_and_condExpChar_spec F L ψ hψ ν₁).2.2.1 (by omega)
    obtain ⟨u₀, hu₀_mem, hu₀_ne⟩ := hspec_ν₁.2
    rw [hcond_ν₁] at hu₀_mem
    have hu₀_val : valL F L (u₀ : L) = 0 := (hunit0_L u₀).mp hu₀_mem
    have hu₀_res_ne : resL (u₀ : L) ≠ 0 := by
      intro h0
      rcases (hresL_ker (u₀ : L) (Or.inr (by omega))).mp h0 with h1 | h2
      · exact Units.ne_zero u₀ h1
      · omega
    set a₀ : k_Lˣ := Units.mk0 (resL (u₀ : L)) hu₀_res_ne
    have hνk_a₀ : ν_k a₀ = (ν₁ u₀)⁻¹ := hν_k_unit u₀ a₀ hu₀_val rfl
    have hνk_1 : ν_k a₀ = 1 := by rw [hν1]; rfl
    exact hu₀_ne (inv_eq_one.mp (hνk_a₀.symm.trans hνk_1))

  
  have hsum_units_kL : ∀ (θ_k : k_Lˣ →* (Ω F)ˣ),
      (∑ a : k_L, (if ha : a = 0 then (0 : Ω F) else (θ_k (Units.mk0 a ha) : Ω F)) * ψ_tilde a) =
        ∑ x : k_Lˣ, (θ_k x : Ω F) * ψ_k (x : k_L) := by
    intro θ_k
    have herase :
        (∑ a : k_L, (if ha : a = 0 then (0 : Ω F) else (θ_k (Units.mk0 a ha) : Ω F)) * ψ_tilde a) =
          ∑ a ∈ (Finset.univ : Finset k_L).erase 0,
            (if ha : a = 0 then (0 : Ω F) else (θ_k (Units.mk0 a ha) : Ω F)) * ψ_tilde a := by
      exact (Finset.sum_erase Finset.univ (by simp)).symm
    rw [herase]
    refine (Finset.sum_bij (fun (x : k_Lˣ) _ => (x : k_L)) ?_ ?_ ?_ ?_).symm
    · intro x _
      exact Finset.mem_erase.mpr ⟨Units.ne_zero x, Finset.mem_univ _⟩
    · intro x₁ _ x₂ _ h
      exact Units.ext h
    · intro a ha
      have ha_ne : a ≠ 0 := (Finset.mem_erase.mp ha).1
      exact ⟨Units.mk0 a ha_ne, Finset.mem_univ _, rfl⟩
    · intro x _
      rw [dif_neg (Units.ne_zero x), Units.mk0_val, hψ_k_apply]

  have hGaussL_eval : ∀ (θ : Lˣ →* (Ω F)ˣ) (θ_k : k_Lˣ →* (Ω F)ˣ),
      condExp F L θ = 1 →
      (∀ (u : Lˣ) (a : k_Lˣ), valL F L (u : L) = 0 → resL (u : L) = (a : k_L) → θ_k a = (θ u)⁻¹) →
      tateEps F L θ ψ =
        (qL F L : Ω F) ^ n * (θ c₁ : Ω F) *
          (∑ x : k_Lˣ, (θ_k x : Ω F) * ψ_k (x : k_L)) := by
    intro θ θ_k hcond hθ_unit
    set χ_tilde_θ : k_L → Ω F := fun a =>
      if ha : a = 0 then 0 else (θ_k (Units.mk0 a ha) : Ω F)
    have hχ_zero : χ_tilde_θ 0 = 0 := dif_pos rfl
    have hχ_unit : ∀ u : Lˣ, valL F L (u : L) = 0 → χ_tilde_θ (resL (u : L)) = (θ u : Ω F)⁻¹ := by
      intro u hu
      have hres_ne : resL (u : L) ≠ 0 := by
        intro h0
        rcases (hresL_ker (u : L) (Or.inr (by omega))).mp h0 with h1 | h2
        · exact Units.ne_zero u h1
        · omega
      dsimp only [χ_tilde_θ]
      rw [dif_neg hres_ne, hθ_unit u (Units.mk0 (resL (u : L)) hres_ne) hu rfl,
        Units.val_inv_eq_inv_val]
    have htate_val := (ld_condExp_and_condExpChar_spec F L ψ hψ θ).2.2.2
    have hFinL : Set.Finite {u : Lˣ ⧸ unitGroup F L (condExp F L θ) |
        valL F L ((cosetRep u : Lˣ) : L) = 0} :=
      ld_unitCoset_finite F L (condExp F L θ) (by omega)
    have hG := ld_cond_one_tateEps_eq_residue_gauss_sum F L ψ θ hcond htate_val hFinL
      ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, hval_add_L,
        hunit_ge1_L, hunit_val0_L⟩
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      c₁ hc₁_val χ_tilde_θ ψ_tilde hχ_zero hχ_unit hψ_int
    rw [hG, hsum_units_kL θ_k]

  have htate_ν : ∀ j ∈ (Finset.range ℓ).erase 0,
      tateEps F L (ν₁ ^ j) ψ =
        (qL F L : Ω F) ^ n * (∑ x : k_Lˣ, ((ν_k ^ j) x : Ω F) * ψ_k (x : k_L)) := by
    intro j hj
    have hj_ne0 : j ≠ 0 := (Finset.mem_erase.mp hj).1
    have hj_lt : j < ℓ := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    have hcond_j : condExp F L (ν₁ ^ j) = 1 := hν₁_cond_eq j hj_lt hj_ne0
    have hunit_j : ∀ (u : Lˣ) (a : k_Lˣ), valL F L (u : L) = 0 → resL (u : L) = (a : k_L) →
        (ν_k ^ j) a = ((ν₁ ^ j) u)⁻¹ := by
      intro u a hu ha
      rw [MonoidHom.pow_apply, MonoidHom.pow_apply, hν_k_unit u a hu ha, inv_pow]
    have hG := hGaussL_eval (ν₁ ^ j) (ν_k ^ j) hcond_j hunit_j
    have hc₁_j : ((ν₁ ^ j) c₁ : Ω F) = 1 := by
      rw [MonoidHom.pow_apply, hν₁_c₁, one_pow, Units.val_one]
    rw [hG, hc₁_j, mul_one]

  have htate_twist : ∀ j ∈ Finset.range ℓ,
      tateEps F L (ν₁ ^ j * χ') ψ =
        (qL F L : Ω F) ^ n * (χ' c₁ : Ω F) *
          (∑ x : k_Lˣ, ((ν_k ^ j * χ_k) x : Ω F) * ψ_k (x : k_L)) := by
    intro j hj
    have hj_lt : j < ℓ := Finset.mem_range.mp hj
    have hcond_j : condExp F L (ν₁ ^ j * χ') = 1 := hCondTwist j hj_lt
    have hunit_j : ∀ (u : Lˣ) (a : k_Lˣ), valL F L (u : L) = 0 → resL (u : L) = (a : k_L) →
        (ν_k ^ j * χ_k) a = ((ν₁ ^ j * χ') u)⁻¹ := by
      intro u a hu ha
      rw [MonoidHom.mul_apply, MonoidHom.mul_apply, MonoidHom.pow_apply, MonoidHom.pow_apply,
        hν_k_unit u a hu ha, hχ_k_unit u a hu ha, inv_pow, mul_inv]
    have hG := hGaussL_eval (ν₁ ^ j * χ') (ν_k ^ j * χ_k) hcond_j hunit_j
    have hc₁_j : ((ν₁ ^ j * χ') c₁ : Ω F) = (χ' c₁ : Ω F) := by
      rw [MonoidHom.mul_apply, MonoidHom.pow_apply, hν₁_c₁, one_pow, one_mul]
    rw [hG, hc₁_j]

  
  
  let resK : K → k_L := fun y =>
    if hy : y = 0 ∨ 0 ≤ valL F K y then resL (hResSurj y hy).choose else 0
  have hinc_int : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      (IntermediateField.inclusion hLK x = 0 ∨ 0 ≤ valL F K (IntermediateField.inclusion hLK x)) := by
    intro x hx
    rcases hx with rfl | hx_ge0
    · left; exact map_zero _
    · right; rw [hValAlg x]; exact mul_nonneg (by omega) hx_ge0
  have hinc_p1 : ∀ x : L,
      (IntermediateField.inclusion hLK x = 0 ∨ 1 ≤ valL F K (IntermediateField.inclusion hLK x)) ↔
        (x = 0 ∨ 1 ≤ valL F L x) := by
    intro x
    constructor
    · intro h
      rcases h with h0 | hge1
      · left
        exact (IntermediateField.inclusion hLK).injective (h0.trans (map_zero _).symm)
      · right
        rw [hValAlg x] at hge1
        by_contra hlt
        have hle0 : valL F L x ≤ 0 := by omega
        have hmul_le0 : (ℓ : ℤ) * valL F L x ≤ 0 :=
          mul_nonpos_of_nonneg_of_nonpos (by omega) hle0
        omega
    · intro h
      rcases h with rfl | hge1
      · left; exact map_zero _
      · right
        rw [hValAlg x]
        calc (1 : ℤ) ≤ (ℓ : ℤ) * 1 := by omega
          _ ≤ (ℓ : ℤ) * valL F L x := mul_le_mul_of_nonneg_left hge1 (by omega)
  have hvalK_sub : ∀ (k : ℤ) (y₁ y₂ : K),
      (y₁ = 0 ∨ k ≤ valL F K y₁) → (y₂ = 0 ∨ k ≤ valL F K y₂) →
        (y₁ - y₂ = 0 ∨ k ≤ valL F K (y₁ - y₂)) := by
    intro k y₁ y₂ hy₁ hy₂
    have hneg₂ : -y₂ = 0 ∨ k ≤ valL F K (-y₂) := by
      rcases hy₂ with rfl | hge
      · left; exact neg_zero
      · right; rw [hval_neg_K]; exact hge
    rw [sub_eq_add_neg]
    exact hval_add_K k y₁ (-y₂) hy₁ hneg₂
  have hvalL_sub : ∀ (k : ℤ) (x₁ x₂ : L),
      (x₁ = 0 ∨ k ≤ valL F L x₁) → (x₂ = 0 ∨ k ≤ valL F L x₂) →
        (x₁ - x₂ = 0 ∨ k ≤ valL F L (x₁ - x₂)) := by
    intro k x₁ x₂ hx₁ hx₂
    have hneg₂ : -x₂ = 0 ∨ k ≤ valL F L (-x₂) := by
      rcases hx₂ with rfl | hge
      · left; exact neg_zero
      · right; rw [hval_neg_L]; exact hge
    rw [sub_eq_add_neg]
    exact hval_add_L k x₁ (-x₂) hx₁ hneg₂
  have hresK_char : ∀ (y : K) (hy : y = 0 ∨ 0 ≤ valL F K y) (x : L)
      (hx : x = 0 ∨ 0 ≤ valL F L x),
      (y - IntermediateField.inclusion hLK x = 0 ∨
        1 ≤ valL F K (y - IntermediateField.inclusion hLK x)) →
      resK y = resL x := by
    intro y hy x hx hyx
    dsimp only [resK]
    rw [dif_pos hy]
    set x₀ : L := (hResSurj y hy).choose
    have hx₀_int : x₀ = 0 ∨ 0 ≤ valL F L x₀ := (hResSurj y hy).choose_spec.1
    have hyx₀ : y - IntermediateField.inclusion hLK x₀ = 0 ∨
        1 ≤ valL F K (y - IntermediateField.inclusion hLK x₀) := (hResSurj y hy).choose_spec.2
    have hinc_diff_eq :
        IntermediateField.inclusion hLK (x₀ - x) =
          (y - IntermediateField.inclusion hLK x) - (y - IntermediateField.inclusion hLK x₀) := by
      rw [map_sub]; ring
    have hinc_diff_p1 :
        IntermediateField.inclusion hLK (x₀ - x) = 0 ∨
          1 ≤ valL F K (IntermediateField.inclusion hLK (x₀ - x)) := by
      rw [hinc_diff_eq]
      exact hvalK_sub 1 _ _ hyx hyx₀
    have hdiff_p1 : x₀ - x = 0 ∨ 1 ≤ valL F L (x₀ - x) := (hinc_p1 (x₀ - x)).mp hinc_diff_p1
    have hdiff_int : x₀ - x = 0 ∨ 0 ≤ valL F L (x₀ - x) := hvalL_sub 0 x₀ x hx₀_int hx
    have hres_diff : resL (x₀ - x) = 0 := (hresL_ker (x₀ - x) hdiff_int).mpr hdiff_p1
    have hneg_x_int : -x = 0 ∨ 0 ≤ valL F L (-x) := by
      rcases hx with rfl | hge
      · left; exact neg_zero
      · right; rw [hval_neg_L]; exact hge
    have hres_sub : resL (x₀ - x) = resL x₀ - resL x := by
      rw [sub_eq_add_neg, (hresL_ring x₀ (-x) hx₀_int hneg_x_int).1,
        (hresL_ring x x hx hx).2.2, sub_eq_add_neg]
    exact sub_eq_zero.mp (hres_sub ▸ hres_diff)
  have hresK_inc : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      resK (IntermediateField.inclusion hLK x) = resL x := by
    intro x hx
    exact hresK_char (IntermediateField.inclusion hLK x) (hinc_int x hx) x hx
      (Or.inl (sub_self _))
  have hresK_0 : resK 0 = 0 := by
    have h := hresK_inc 0 (Or.inl rfl)
    rwa [map_zero, hresL_0] at h
  have hresK_1 : resK 1 = 1 := by
    have h := hresK_inc 1 (Or.inr (by rw [hval1_L]))
    rwa [map_one, hresL_1] at h
  have hresK_surj : ∀ a : k_L, ∃ y : K, (y = 0 ∨ 0 ≤ valL F K y) ∧ resK y = a := by
    intro a
    exact ⟨IntermediateField.inclusion hLK (s_L a), hinc_int (s_L a) (hs_L_int a),
      (hresK_inc (s_L a) (hs_L_int a)).trans (hs_L_res a)⟩
  have hvalK_mul_int : ∀ (y₁ y₂ : K) (k₁ k₂ : ℤ),
      (y₁ = 0 ∨ k₁ ≤ valL F K y₁) → (y₂ = 0 ∨ k₂ ≤ valL F K y₂) →
        (y₁ * y₂ = 0 ∨ k₁ + k₂ ≤ valL F K (y₁ * y₂)) := by
    intro y₁ y₂ k₁ k₂ hy₁ hy₂
    by_cases hy₁0 : y₁ = 0
    · left; rw [hy₁0, zero_mul]
    · by_cases hy₂0 : y₂ = 0
      · left; rw [hy₂0, mul_zero]
      · right
        have h1 := hy₁.resolve_left hy₁0
        have h2 := hy₂.resolve_left hy₂0
        rw [hval_mul_K y₁ y₂ hy₁0 hy₂0]
        omega
  have hvalL_mul_int : ∀ (x₁ x₂ : L) (k₁ k₂ : ℤ),
      (x₁ = 0 ∨ k₁ ≤ valL F L x₁) → (x₂ = 0 ∨ k₂ ≤ valL F L x₂) →
        (x₁ * x₂ = 0 ∨ k₁ + k₂ ≤ valL F L (x₁ * x₂)) := by
    intro x₁ x₂ k₁ k₂ hx₁ hx₂
    by_cases hx₁0 : x₁ = 0
    · left; rw [hx₁0, zero_mul]
    · by_cases hx₂0 : x₂ = 0
      · left; rw [hx₂0, mul_zero]
      · right
        have h1 := hx₁.resolve_left hx₁0
        have h2 := hx₂.resolve_left hx₂0
        rw [hval_mul_L x₁ x₂ hx₁0 hx₂0]
        omega
  have hresK_ring : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      resK (y₁ + y₂) = resK y₁ + resK y₂ ∧
      resK (y₁ * y₂) = resK y₁ * resK y₂ ∧
      resK (-y₁) = -resK y₁ := by
    intro y₁ y₂ hy₁ hy₂
    obtain ⟨x₁, hx₁_int, hy₁_x₁⟩ := hResSurj y₁ hy₁
    obtain ⟨x₂, hx₂_int, hy₂_x₂⟩ := hResSurj y₂ hy₂
    have hr₁ : resK y₁ = resL x₁ := hresK_char y₁ hy₁ x₁ hx₁_int hy₁_x₁
    have hr₂ : resK y₂ = resL x₂ := hresK_char y₂ hy₂ x₂ hx₂_int hy₂_x₂
    have hringL := hresL_ring x₁ x₂ hx₁_int hx₂_int
    refine ⟨?_, ?_, ?_⟩
    · have hy_add : y₁ + y₂ = 0 ∨ 0 ≤ valL F K (y₁ + y₂) := hval_add_K 0 y₁ y₂ hy₁ hy₂
      have hx_add : x₁ + x₂ = 0 ∨ 0 ≤ valL F L (x₁ + x₂) := hval_add_L 0 x₁ x₂ hx₁_int hx₂_int
      have hdiff_eq : (y₁ + y₂) - IntermediateField.inclusion hLK (x₁ + x₂) =
          (y₁ - IntermediateField.inclusion hLK x₁) + (y₂ - IntermediateField.inclusion hLK x₂) := by
        rw [map_add]; ring
      have hdiff_p1 : (y₁ + y₂) - IntermediateField.inclusion hLK (x₁ + x₂) = 0 ∨
          1 ≤ valL F K ((y₁ + y₂) - IntermediateField.inclusion hLK (x₁ + x₂)) := by
        rw [hdiff_eq]
        exact hval_add_K 1 _ _ hy₁_x₁ hy₂_x₂
      rw [hresK_char (y₁ + y₂) hy_add (x₁ + x₂) hx_add hdiff_p1, hringL.1, hr₁, hr₂]
    · have hy_mul : y₁ * y₂ = 0 ∨ 0 ≤ valL F K (y₁ * y₂) := by
        simpa using hvalK_mul_int y₁ y₂ 0 0 hy₁ hy₂
      have hx_mul : x₁ * x₂ = 0 ∨ 0 ≤ valL F L (x₁ * x₂) := by
        simpa using hvalL_mul_int x₁ x₂ 0 0 hx₁_int hx₂_int
      have hdiff_eq : y₁ * y₂ - IntermediateField.inclusion hLK (x₁ * x₂) =
          (y₁ - IntermediateField.inclusion hLK x₁) * y₂ +
            IntermediateField.inclusion hLK x₁ * (y₂ - IntermediateField.inclusion hLK x₂) := by
        rw [map_mul]; ring
      have ht1 : (y₁ - IntermediateField.inclusion hLK x₁) * y₂ = 0 ∨
          1 ≤ valL F K ((y₁ - IntermediateField.inclusion hLK x₁) * y₂) := by
        simpa using hvalK_mul_int _ y₂ 1 0 hy₁_x₁ hy₂
      have ht2 : IntermediateField.inclusion hLK x₁ * (y₂ - IntermediateField.inclusion hLK x₂) = 0 ∨
          1 ≤ valL F K (IntermediateField.inclusion hLK x₁ * (y₂ - IntermediateField.inclusion hLK x₂)) := by
        simpa using hvalK_mul_int _ _ 0 1 (hinc_int x₁ hx₁_int) hy₂_x₂
      have hdiff_p1 : y₁ * y₂ - IntermediateField.inclusion hLK (x₁ * x₂) = 0 ∨
          1 ≤ valL F K (y₁ * y₂ - IntermediateField.inclusion hLK (x₁ * x₂)) := by
        rw [hdiff_eq]
        exact hval_add_K 1 _ _ ht1 ht2
      rw [hresK_char (y₁ * y₂) hy_mul (x₁ * x₂) hx_mul hdiff_p1, hringL.2.1, hr₁, hr₂]
    · have hy_neg : -y₁ = 0 ∨ 0 ≤ valL F K (-y₁) := by
        rcases hy₁ with rfl | hge
        · left; exact neg_zero
        · right; rw [hval_neg_K]; exact hge
      have hx_neg : -x₁ = 0 ∨ 0 ≤ valL F L (-x₁) := by
        rcases hx₁_int with rfl | hge
        · left; exact neg_zero
        · right; rw [hval_neg_L]; exact hge
      have hdiff_eq : -y₁ - IntermediateField.inclusion hLK (-x₁) =
          -(y₁ - IntermediateField.inclusion hLK x₁) := by
        rw [map_neg]; ring
      have hdiff_p1 : -y₁ - IntermediateField.inclusion hLK (-x₁) = 0 ∨
          1 ≤ valL F K (-y₁ - IntermediateField.inclusion hLK (-x₁)) := by
        rw [hdiff_eq]
        rcases hy₁_x₁ with h0 | hge1
        · left; rw [h0, neg_zero]
        · right; rw [hval_neg_K]; exact hge1
      rw [hresK_char (-y₁) hy_neg (-x₁) hx_neg hdiff_p1, hringL.2.2, hr₁]
  have hresK_ker : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      (resK y = 0 ↔ (y = 0 ∨ 1 ≤ valL F K y)) := by
    intro y hy
    obtain ⟨x, hx_int, hyx⟩ := hResSurj y hy
    rw [hresK_char y hy x hx_int hyx, hresL_ker x hx_int, ← hinc_p1 x]
    constructor
    · intro hinc
      have hy_eq : y = (y - IntermediateField.inclusion hLK x) + IntermediateField.inclusion hLK x := by
        ring
      rw [hy_eq]
      exact hval_add_K 1 _ _ hyx hinc
    · intro hy_p1
      have hinc_eq : IntermediateField.inclusion hLK x = y - (y - IntermediateField.inclusion hLK x) := by
        ring
      rw [hinc_eq]
      exact hvalK_sub 1 _ _ hy_p1 hyx

  
  set c₁_K : Kˣ := Units.map (IntermediateField.inclusion hLK).toMonoidHom c₁
  have hc₁_K_coe : (c₁_K : K) = IntermediateField.inclusion hLK (c₁ : L) := rfl
  have hc₁_K_inv_coe : ((c₁_K⁻¹ : Kˣ) : K) =
      IntermediateField.inclusion hLK ((c₁⁻¹ : Lˣ) : L) := by
    rw [← map_inv]; rfl
  have hc₁_K_val : valL F K (c₁_K : K) = 1 + condExpChar F K (traceChar F hLK ψ) := by
    rw [hc₁_K_coe, hValAlg (c₁ : L), hc₁_val, hCondψK]
    ring
  let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
  have hto_inc : ∀ x : L,
      toExtendScalars F hLK (IntermediateField.inclusion hLK x) = algebraMap L K' x :=
    fun _ => rfl
  have hnorm_inc : ∀ x : L,
      normLM F hLK (IntermediateField.inclusion hLK x) = x ^ ℓ := by
    intro x
    change Algebra.norm L (toExtendScalars F hLK (IntermediateField.inclusion hLK x)) = x ^ ℓ
    rw [hto_inc x]
    exact Algebra.norm_algebraMap x
  have htrace_inc : ∀ x : L,
      traceLM F hLK (IntermediateField.inclusion hLK x) = (ℓ : L) * x := by
    letI : Module L L := Semiring.toModule
    intro x
    change Algebra.trace L K' (toExtendScalars F hLK (IntermediateField.inclusion hLK x)) = (ℓ : L) * x
    rw [hto_inc x, Algebra.trace_algebraMap x, nsmul_eq_mul]
  set χ'_K : Kˣ →* (Ω F)ˣ := χ'.comp (Units.map (normLM F hLK))
  have hnorm_c₁K : Units.map (normLM F hLK) c₁_K = c₁ ^ ℓ := by
    apply Units.ext
    change normLM F hLK (IntermediateField.inclusion hLK (c₁ : L)) = ((c₁ ^ ℓ : Lˣ) : L)
    rw [hnorm_inc, Units.val_pow_eq_pow_val]
  have hχ'_K_c₁K : (χ'_K c₁_K : Ω F) = (χ' c₁ : Ω F) ^ ℓ := by
    dsimp only [χ'_K]
    rw [MonoidHom.comp_apply, hnorm_c₁K, map_pow, Units.val_pow_eq_pow_val]

  set χ_tilde_K : k_L → Ω F := fun a =>
    if ha : a = 0 then 0 else ((χ_k ^ ℓ) (Units.mk0 a ha) : Ω F)
  set ψ_tilde_K : k_L → Ω F := fun a => ψ_k ((ℓ : k_L) * a)
  have hχK_zero : χ_tilde_K 0 = 0 := dif_pos rfl
  have hχK_unit : ∀ w : Kˣ, valL F K (w : K) = 0 →
      χ_tilde_K (resK (w : K)) = (χ'_K w : Ω F)⁻¹ := by
    intro w hw_val
    have hw_int : (w : K) = 0 ∨ 0 ≤ valL F K (w : K) := Or.inr (by omega)
    obtain ⟨x, hx_int, hwx⟩ := hResSurj (w : K) hw_int
    have hres_w : resK (w : K) = resL x := hresK_char (w : K) hw_int x hx_int hwx
    have hres_w_ne : resK (w : K) ≠ 0 := by
      intro h0
      rcases (hresK_ker (w : K) hw_int).mp h0 with h1 | h2
      · exact Units.ne_zero w h1
      · omega
    have hres_x_ne : resL x ≠ 0 := hres_w ▸ hres_w_ne
    have hx_ne : x ≠ 0 := by
      intro h0; apply hres_x_ne; rw [h0, hresL_0]
    have hx_val0 : valL F L x = 0 := by
      have hge0 : 0 ≤ valL F L x := hx_int.resolve_left hx_ne
      by_contra hne0
      have hge1 : 1 ≤ valL F L x := by omega
      exact hres_x_ne ((hresL_ker x hx_int).mpr (Or.inr hge1))
    set u_x : Lˣ := Units.mk0 x hx_ne
    set w_x : Kˣ := Units.map (IntermediateField.inclusion hLK).toMonoidHom u_x
    have hw_x_coe : (w_x : K) = IntermediateField.inclusion hLK x := rfl
    have hw_x_val0 : valL F K (w_x : K) = 0 := by
      rw [hw_x_coe, hValAlg x, hx_val0, mul_zero]
    set h : Kˣ := w_x⁻¹ * w
    have hh_sub : (h : K) - 1 = ((w_x⁻¹ : Kˣ) : K) * ((w : K) - IntermediateField.inclusion hLK x) := by
      have hinv : ((w_x⁻¹ : Kˣ) : K) * IntermediateField.inclusion hLK x = 1 := by
        exact_mod_cast Units.inv_mul w_x
      calc (h : K) - 1 = ((w_x⁻¹ : Kˣ) : K) * (w : K) - ((w_x⁻¹ : Kˣ) : K) * IntermediateField.inclusion hLK x := by
            rw [Units.val_mul, hinv]
        _ = ((w_x⁻¹ : Kˣ) : K) * ((w : K) - IntermediateField.inclusion hLK x) := by ring
    have hh_mem : h ∈ unitGroup F K (condExp F K χ'_K) := by
      rw [hCondχ'K, hunit_ge1_K 1 le_rfl h]
      rcases hwx with hd0 | hd1
      · left
        have hsub0 : (h : K) - 1 = 0 := by rw [hh_sub, hd0, mul_zero]
        exact sub_eq_zero.mp hsub0
      · right
        have hd_ne : (w : K) - IntermediateField.inclusion hLK x ≠ 0 := by
          intro h0; rw [h0, hval0_K] at hd1; omega
        rw [hh_sub, hval_mul_K ((w_x⁻¹ : Kˣ) : K) _ (Units.ne_zero w_x⁻¹) hd_ne,
          hval_inv_K w_x, hw_x_val0]
        omega
    have hχK_h : χ'_K h = 1 := hχ'K_cond h hh_mem
    have hχK_w : χ'_K w = (χ' u_x) ^ ℓ := by
      have hww : w_x * h = w := mul_inv_cancel_left w_x w
      have hnorm_wx : Units.map (normLM F hLK) w_x = u_x ^ ℓ := by
        apply Units.ext
        change normLM F hLK (IntermediateField.inclusion hLK x) = ((u_x ^ ℓ : Lˣ) : L)
        rw [hnorm_inc x, Units.val_pow_eq_pow_val]; rfl
      rw [← hww, map_mul, hχK_h, mul_one]
      change χ' (Units.map (normLM F hLK) w_x) = (χ' u_x) ^ ℓ
      rw [hnorm_wx, map_pow]
    set a_w : k_Lˣ := Units.mk0 (resK (w : K)) hres_w_ne
    have hχk_aw : χ_k a_w = (χ' u_x)⁻¹ := hχ_k_unit u_x a_w hx_val0 hres_w.symm
    dsimp only [χ_tilde_K]
    rw [dif_neg hres_w_ne]
    change (((χ_k a_w) ^ ℓ : (Ω F)ˣ) : Ω F) = (χ'_K w : Ω F)⁻¹
    rw [hχk_aw, hχK_w, inv_pow, Units.val_inv_eq_inv_val]

  have hnat_int_resL : ∀ m : ℕ,
      ((m : L) = 0 ∨ 0 ≤ valL F L (m : L)) ∧ resL (m : L) = (m : k_L) := by
    intro m
    induction m with
    | zero =>
      refine ⟨Or.inl (Nat.cast_zero), ?_⟩
      rw [Nat.cast_zero, Nat.cast_zero, hresL_0]
    | succ m ih =>
      have h1_int : (1 : L) = 0 ∨ 0 ≤ valL F L (1 : L) := Or.inr (by rw [hval1_L])
      have hm1_int : ((m : L) + 1) = 0 ∨ 0 ≤ valL F L ((m : L) + 1) :=
        hval_add_L 0 (m : L) 1 ih.1 h1_int
      refine ⟨by simpa [Nat.cast_succ] using hm1_int, ?_⟩
      rw [Nat.cast_succ, (hresL_ring (m : L) 1 ih.1 h1_int).1, ih.2, hresL_1, Nat.cast_succ]

  obtain ⟨hψK_triv, ⟨y₁, hy₁_ne, hy₁_val, hy₁_ψK⟩, _, _⟩ :=
    ld_condExp_and_condExpChar_spec F K (traceChar F hLK ψ) hψK χ'_K
  have hψK_int : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      ψ_tilde_K (resK y) = (traceChar F hLK ψ) (((c₁_K⁻¹ : Kˣ) : K) * y) := by
    intro y hy
    obtain ⟨x, hx_int, hyx⟩ := hResSurj y hy
    have hres_y : resK y = resL x := hresK_char y hy x hx_int hyx
    set z : K := y - IntermediateField.inclusion hLK x
    set w_z : K := ((c₁_K⁻¹ : Kˣ) : K) * z
    have hw_z_cond : w_z = 0 ∨ -condExpChar F K (traceChar F hLK ψ) ≤ valL F K w_z := by
      by_cases hz0 : z = 0
      · left; dsimp only [w_z]; rw [hz0, mul_zero]
      · right
        have hz_ge1 : 1 ≤ valL F K z := hyx.resolve_left hz0
        dsimp only [w_z]
        rw [hval_mul_K ((c₁_K⁻¹ : Kˣ) : K) z (Units.ne_zero c₁_K⁻¹) hz0,
          hval_inv_K c₁_K, hc₁_K_val]
        omega
    have hψK_wz : (traceChar F hLK ψ) w_z = 1 := hψK_triv w_z hw_z_cond
    have hy_decomp : ((c₁_K⁻¹ : Kˣ) : K) * y =
        IntermediateField.inclusion hLK (((c₁⁻¹ : Lˣ) : L) * x) + w_z := by
      dsimp only [w_z, z]
      rw [hc₁_K_inv_coe, map_mul]
      ring
    have htr_inc_cx :
        (traceChar F hLK ψ) (IntermediateField.inclusion hLK (((c₁⁻¹ : Lˣ) : L) * x)) =
          ψ (((c₁⁻¹ : Lˣ) : L) * ((ℓ : L) * x)) := by
      change ψ (traceLM F hLK (IntermediateField.inclusion hLK (((c₁⁻¹ : Lˣ) : L) * x))) = _
      rw [htrace_inc]
      congr 1
      ring
    have hℓ_int : (ℓ : L) = 0 ∨ 0 ≤ valL F L (ℓ : L) := (hnat_int_resL ℓ).1
    have hℓ_res : resL (ℓ : L) = (ℓ : k_L) := (hnat_int_resL ℓ).2
    have hℓx_int : (ℓ : L) * x = 0 ∨ 0 ≤ valL F L ((ℓ : L) * x) := by
      simpa using hvalL_mul_int (ℓ : L) x 0 0 hℓ_int hx_int
    have hℓx_res : resL ((ℓ : L) * x) = (ℓ : k_L) * resK y := by
      rw [(hresL_ring (ℓ : L) x hℓ_int hx_int).2.1, hℓ_res, hres_y]
    rw [hy_decomp, (traceChar F hLK ψ).map_add_eq_mul, hψK_wz, mul_one, htr_inc_cx,
      ← hψ_int ((ℓ : L) * x) hℓx_int, ← hψ_k_apply, hℓx_res]

  have hNeChar : (ℓ : k_L) ≠ 0 := by
    intro hℓ0
    set y₀ : K := (c₁_K : K) * y₁
    have hy₀_val : 0 ≤ valL F K y₀ := by
      dsimp only [y₀]
      rw [hval_mul_K (c₁_K : K) y₁ (Units.ne_zero c₁_K) hy₁_ne, hc₁_K_val]
      omega
    have hinv_c₁K : ((c₁_K⁻¹ : Kˣ) : K) * (c₁_K : K) = 1 := by exact_mod_cast Units.inv_mul c₁_K
    have heval : ψ_tilde_K (resK y₀) = (traceChar F hLK ψ) y₁ := by
      rw [hψK_int y₀ (Or.inr hy₀_val)]
      dsimp only [y₀]
      rw [← mul_assoc, hinv_c₁K, one_mul]
    have h1 : ψ_tilde_K (resK y₀) = 1 := by
      dsimp only [ψ_tilde_K]
      rw [hℓ0, zero_mul, ψ_k.map_zero_eq_one]
    exact hy₁_ψK (heval.symm.trans h1)

  
  have htate_val_K :=
    (ld_condExp_and_condExpChar_spec F K (traceChar F hLK ψ) hψK χ'_K).2.2.2
  have hFinK : Set.Finite {w : Kˣ ⧸ unitGroup F K (condExp F K χ'_K) |
      valL F K ((cosetRep w : Kˣ) : K) = 0} :=
    ld_unitCoset_finite F K (condExp F K χ'_K) (by omega)
  have hGaussK_raw := ld_cond_one_tateEps_eq_residue_gauss_sum F K (traceChar F hLK ψ) χ'_K
    hCondχ'K htate_val_K hFinK
    ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K, hval_inv_K, hval_add_K,
      hunit_ge1_K, hunit_val0_K⟩
    k_L resK hresK_0 hresK_1 hresK_ring hresK_ker hresK_surj
    c₁_K hc₁_K_val χ_tilde_K ψ_tilde_K hχK_zero hχK_unit hψK_int
  set ℓ_u : k_Lˣ := Units.mk0 (ℓ : k_L) hNeChar
  have hsum_K_units :
      (∑ a : k_L, χ_tilde_K a * ψ_tilde_K a) =
        ∑ u : k_Lˣ, ((χ_k ^ ℓ) u : Ω F) * ψ_k ((ℓ : k_L) * (u : k_L)) := by
    have herase :
        (∑ a : k_L, χ_tilde_K a * ψ_tilde_K a) =
          ∑ a ∈ (Finset.univ : Finset k_L).erase 0, χ_tilde_K a * ψ_tilde_K a := by
      exact (Finset.sum_erase Finset.univ (by rw [hχK_zero, zero_mul])).symm
    rw [herase]
    refine (Finset.sum_bij (fun (u : k_Lˣ) _ => (u : k_L)) ?_ ?_ ?_ ?_).symm
    · intro u _
      exact Finset.mem_erase.mpr ⟨Units.ne_zero u, Finset.mem_univ _⟩
    · intro u₁ _ u₂ _ h
      exact Units.ext h
    · intro a ha
      have ha_ne : a ≠ 0 := (Finset.mem_erase.mp ha).1
      exact ⟨Units.mk0 a ha_ne, Finset.mem_univ _, rfl⟩
    · intro u _
      dsimp only [χ_tilde_K, ψ_tilde_K]
      rw [dif_neg (Units.ne_zero u), Units.mk0_val]
  have hsum_K_reindex :
      (∑ u : k_Lˣ, ((χ_k ^ ℓ) u : Ω F) * ψ_k ((ℓ : k_L) * (u : k_L))) =
        (((χ_k ℓ_u)⁻¹) ^ ℓ : Ω F) *
          (∑ x : k_Lˣ, ((χ_k ^ ℓ) x : Ω F) * ψ_k (x : k_L)) := by
    rw [Finset.mul_sum]
    refine Finset.sum_bij (fun (u : k_Lˣ) _ => ℓ_u * u) ?_ ?_ ?_ ?_
    · intro u _; exact Finset.mem_univ _
    · intro u₁ _ u₂ _ h; exact mul_left_cancel h
    · intro x _
      exact ⟨ℓ_u⁻¹ * x, Finset.mem_univ _, mul_inv_cancel_left ℓ_u x⟩
    · intro u _
      have hval_mul : ((ℓ : k_L) * (u : k_L)) = ((ℓ_u * u : k_Lˣ) : k_L) := rfl
      have hχ_mul_u : ((χ_k ^ ℓ) (ℓ_u * u) : Ω F) =
          (((χ_k ℓ_u : (Ω F)ˣ) : Ω F) ^ ℓ) * ((χ_k ^ ℓ) u : Ω F) := by
        rw [map_mul, Units.val_mul, MonoidHom.pow_apply, Units.val_pow_eq_pow_val]
      have hinv_cancel :
          (((χ_k ℓ_u)⁻¹) ^ ℓ : Ω F) * (((χ_k ℓ_u : (Ω F)ˣ) : Ω F) ^ ℓ) = 1 := by
        rw [← Units.val_pow_eq_pow_val, ← Units.val_pow_eq_pow_val, ← Units.val_mul,
          ← mul_pow, inv_mul_cancel, one_pow, Units.val_one]
      rw [hval_mul, hχ_mul_u, ← mul_assoc, ← mul_assoc, hinv_cancel, one_mul]
  have htate_K :
      tateEps F K χ'_K (traceChar F hLK ψ) =
        (qL F K : Ω F) ^ condExpChar F K (traceChar F hLK ψ) *
          (χ' c₁ : Ω F) ^ ℓ *
          (((χ_k ℓ_u)⁻¹) ^ ℓ : Ω F) *
          (∑ x : k_Lˣ, ((χ_k ^ ℓ) x : Ω F) * ψ_k (x : k_L)) := by
    rw [hGaussK_raw, hχ'_K_c₁K, hsum_K_units, hsum_K_reindex]
    ring

  
  have hcond_one_char : ∀ (M : IntermediateField F (AlgebraicClosure F)),
      condExp F M 1 = 0 := by
    intro M
    exact Nat.eq_zero_of_le_zero (Nat.sInf_le (fun _ _ => rfl))
  have htate_triv : ∀ (M : IntermediateField F (AlgebraicClosure F)) (ψ_M : AddChar M (Ω F)),
      tateEps F M 1 ψ_M = (qL F M : Ω F) ^ condExpChar F M ψ_M := by
    intro M ψ_M
    dsimp only [tateEps]
    rw [if_pos (hcond_one_char M), MonoidHom.one_apply, Units.val_one, mul_one]
  have htate_ν0 : tateEps F L (ν₁ ^ 0) ψ = (qL F L : Ω F) ^ n := by
    rw [pow_zero]
    exact htate_triv L ψ
  have htate_1K : tateEps F K 1 (traceChar F hLK ψ) =
      (qL F K : Ω F) ^ condExpChar F K (traceChar F hLK ψ) :=
    htate_triv K (traceChar F hLK ψ)

  set Q_L : Ω F := (qL F L : Ω F) ^ n
  set Q_K : Ω F := (qL F K : Ω F) ^ condExpChar F K (traceChar F hLK ψ)
  set C : Ω F := (χ' c₁ : Ω F)

  have hprod_ν :
      (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j) ψ) =
        Q_L ^ ℓ *
          ∏ j ∈ (Finset.range ℓ).erase 0,
            (∑ x : k_Lˣ, ((ν_k ^ j) x : Ω F) * ψ_k (x : k_L)) := by
    have h0_mem : 0 ∈ Finset.range ℓ := Finset.mem_range.mpr hℓ_pos
    rw [← Finset.mul_prod_erase (Finset.range ℓ) (fun j => tateEps F L (ν₁ ^ j) ψ) h0_mem,
      htate_ν0, Finset.prod_congr rfl htate_ν, Finset.prod_mul_distrib, Finset.prod_const,
      Finset.card_erase_of_mem h0_mem, Finset.card_range, ← mul_assoc, ← pow_succ',
      Nat.sub_add_cancel hℓ_pos]

  have hprod_twist :
      (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j * χ') ψ) =
        Q_L ^ ℓ * C ^ ℓ *
          ∏ j ∈ Finset.range ℓ,
            (∑ x : k_Lˣ, ((ν_k ^ j * χ_k) x : Ω F) * ψ_k (x : k_L)) := by
    rw [Finset.prod_congr rfl htate_twist, Finset.prod_mul_distrib, Finset.prod_mul_distrib,
      Finset.prod_const, Finset.prod_const, Finset.card_range]

  have hDH_inst := hDH k_L hNeChar ψ_k hψ_k_ne ν_k χ_k hν_pow hν_ne hNeChar
  change tateEps F K χ'_K (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j) ψ) =
    tateEps F K 1 (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range ℓ, tateEps F L (ν₁ ^ j * χ') ψ)
  rw [htate_K, htate_1K, hprod_ν, hprod_twist, ← hDH_inst]
  dsimp only [Q_L, Q_K, C, ℓ_u]
  ring

theorem ld_cond_ge_two_hd_sum_eval_over_res_finset (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
    (ψ_E : AddChar E (Ω F)) (θ : Eˣ →* (Ω F)ˣ)
    (hm : 2 ≤ condExp F E θ)
    (hSpecE_triv : ∀ x : E, (x = 0 ∨ -condExpChar F E ψ_E ≤ valL F E x) → ψ_E x = 1)
    (hSpecE_θ : ∀ u ∈ unitGroup F E (condExp F E θ), θ u = 1)
    (hFinE : Set.Finite {u : Eˣ ⧸ unitGroup F E (condExp F E θ) |
      valL F E ((cosetRep u : Eˣ) : E) = 0})
    (hvalE_props : valL F E 0 = 0 ∧
      valL F E 1 = 0 ∧
      valL F E (-1) = 0 ∧
      (∀ x : E, valL F E (-x) = valL F E x) ∧
      (∀ x y : E, x ≠ 0 → y ≠ 0 → valL F E (x * y) = valL F E x + valL F E y) ∧
      (∀ u : Eˣ, valL F E ((u⁻¹ : Eˣ) : E) = - valL F E (u : E)) ∧
      (∀ m : ℤ, ∃ c : Eˣ, valL F E (c : E) = m) ∧
      (∀ (k : ℤ) (x y : E),
        (x = 0 ∨ k ≤ valL F E x) → (y = 0 ∨ k ≤ valL F E y) →
          (x + y = 0 ∨ k ≤ valL F E (x + y))) ∧
      (∀ u : Eˣ, u ∈ unitGroup F E 0 ↔ valL F E (u : E) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Eˣ,
        u ∈ unitGroup F E a ↔ ((u : E) = 1 ∨ (a : ℤ) ≤ valL F E ((u : E) - 1))) ∧
      (∀ (a : ℕ) (u : Eˣ), u ∈ unitGroup F E a → valL F E (u : E) = 0))
    (c : Eˣ)
    (hc_val : valL F E (c : E) = (condExp F E θ : ℤ) + condExpChar F E ψ_E)
    (hc_stat : ∀ w ∈ unitGroup F E (condExp F E θ - condExp F E θ / 2),
      (θ w : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * ((w : E) - 1)))
    (R_E : Finset E) (δ : Eˣ)
    (hRE_int : ∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r)
    (hRE_sep : ∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0)
    (hRE_surj : ∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
      ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r))
    (hδ : valL F E (δ : E) = ((condExp F E θ / 2 : ℕ) : ℤ)) :
    let m := condExp F E θ
    let d := m / 2
    (m % 2 = 0 →
      (∑ u ∈ hFinE.toFinset.filter (fun u => cosetRep u ∈ unitGroup F E d),
        ((θ (cosetRep u) : Ω F)⁻¹ *
          ψ_E (((c⁻¹ : Eˣ) : E) * (((cosetRep u : Eˣ) : E) - 1)))) =
        (R_E.card : Ω F) ^ d) ∧
    (m % 2 = 1 →
      (∑ u ∈ hFinE.toFinset.filter (fun u => cosetRep u ∈ unitGroup F E d),
        ((θ (cosetRep u) : Ω F)⁻¹ *
          ψ_E (((c⁻¹ : Eˣ) : E) * (((cosetRep u : Eˣ) : E) - 1)))) =
        (R_E.card : Ω F) ^ d *
          ∑ r ∈ R_E,
            if hr : 1 + (δ : E) * r ≠ 0 then
              (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
            else 0) :=
by
  classical
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add,
    hunit0, hunit_ge1, hunit_val0⟩ := hvalE_props
  set m : ℕ := condExp F E θ
  set d : ℕ := m / 2
  set e : ℕ := m - d
  set n : ℤ := condExpChar F E ψ_E
  have hm_ne0 : m ≠ 0 := by omega
  have hm_ge1 : 1 ≤ m := by omega
  have hd_ge1 : 1 ≤ d := by omega
  have hd_le_m : d ≤ m := by omega
  have he_ge1 : 1 ≤ e := by omega
  have he_le_m : e ≤ m := by omega
  have hde_add : d + e = m := by omega
  set U : Finset (Eˣ ⧸ unitGroup F E m) := hFinE.toFinset
  let H : ℕ → Finset (Eˣ ⧸ unitGroup F E m) := fun k =>
    U.filter (fun u => cosetRep u ∈ unitGroup F E k)
  have hmem_U : ∀ u : Eˣ ⧸ unitGroup F E m,
      u ∈ U ↔ valL F E ((cosetRep u : Eˣ) : E) = 0 := by
    intro u
    simp [U, Set.Finite.mem_toFinset]
  have hout : ∀ u : Eˣ ⧸ unitGroup F E m,
      QuotientGroup.mk (s := unitGroup F E m) (cosetRep u) = u :=
    fun u => QuotientGroup.out_eq' u
  have hcoset_mk : ∀ x : Eˣ,
      x⁻¹ * cosetRep (QuotientGroup.mk (s := unitGroup F E m) x) ∈ unitGroup F E m := by
    intro x
    exact QuotientGroup.eq.mp (hout _).symm
  have hsub_unit : ∀ {k₁ k₂ : ℕ}, 1 ≤ k₁ → k₁ ≤ k₂ →
      unitGroup F E k₂ ≤ unitGroup F E k₁ := by
    intro k₁ k₂ hk₁ hk₁₂ u hu
    have hk₂ : 1 ≤ k₂ := by omega
    rw [hunit_ge1 k₁ hk₁]
    rcases (hunit_ge1 k₂ hk₂ u).mp hu with hu1 | huk₂
    · exact Or.inl hu1
    · right; omega
  have hmem_unit_mk : ∀ {k : ℕ}, 1 ≤ k → k ≤ m → ∀ x : Eˣ,
      cosetRep (QuotientGroup.mk (s := unitGroup F E m) x) ∈ unitGroup F E k ↔
        x ∈ unitGroup F E k := by
    intro k hk hkm x
    set r := cosetRep (QuotientGroup.mk (s := unitGroup F E m) x)
    set h := x⁻¹ * r
    have hh : h ∈ unitGroup F E k := hsub_unit hk hkm (hcoset_mk x)
    have hr_eq : r = x * h := by simp [h]
    rw [hr_eq]
    exact Subgroup.mul_mem_cancel_right (unitGroup F E k) hh
  have hmem_H : ∀ (k : ℕ) (u : Eˣ ⧸ unitGroup F E m),
      u ∈ H k ↔ cosetRep u ∈ unitGroup F E k := by
    intro k u
    dsimp only [H]
    rw [Finset.mem_filter, hmem_U]
    exact ⟨fun h => h.2, fun h => ⟨hunit_val0 k (cosetRep u) h, h⟩⟩
  have hH_mk : ∀ {k : ℕ}, 1 ≤ k → k ≤ m → ∀ w : Eˣ,
      QuotientGroup.mk (s := unitGroup F E m) w ∈ H k ↔ w ∈ unitGroup F E k := by
    intro k hk hkm w
    rw [hmem_H, hmem_unit_mk hk hkm]
  have hH_one : ∀ {k : ℕ}, 1 ≤ k → k ≤ m → (1 : Eˣ ⧸ unitGroup F E m) ∈ H k := by
    intro k hk hkm
    exact (hH_mk hk hkm 1).mpr (one_mem _)
  have hH_mul : ∀ {k : ℕ}, 1 ≤ k → k ≤ m →
      ∀ {u₁ u₂ : Eˣ ⧸ unitGroup F E m}, u₁ ∈ H k → u₂ ∈ H k → u₁ * u₂ ∈ H k := by
    intro k hk hkm u₁ u₂ hu₁ hu₂
    rw [hmem_H] at hu₁ hu₂ ⊢
    have hmul : u₁ * u₂ = QuotientGroup.mk (s := unitGroup F E m) (cosetRep u₁ * cosetRep u₂) := by
      rw [QuotientGroup.mk_mul, hout, hout]
    rw [hmul, hmem_unit_mk hk hkm]
    exact mul_mem hu₁ hu₂
  have hH_inv : ∀ {k : ℕ}, 1 ≤ k → k ≤ m →
      ∀ {u : Eˣ ⧸ unitGroup F E m}, u ∈ H k → u⁻¹ ∈ H k := by
    intro k hk hkm u hu
    rw [hmem_H] at hu ⊢
    have hinv : u⁻¹ = QuotientGroup.mk (s := unitGroup F E m) (cosetRep u)⁻¹ := by
      rw [QuotientGroup.mk_inv, hout]
    rw [hinv, hmem_unit_mk hk hkm]
    exact inv_mem hu
  have hH_anti : ∀ {k₁ k₂ : ℕ}, 1 ≤ k₁ → k₁ ≤ k₂ →
      ∀ {u : Eˣ ⧸ unitGroup F E m}, u ∈ H k₂ → u ∈ H k₁ := by
    intro k₁ k₂ hk₁ hk₁₂ u hu
    rw [hmem_H] at hu ⊢
    exact hsub_unit hk₁ hk₁₂ hu
  have hHm_eq : H m = {1} := by
    ext u
    rw [hmem_H, Finset.mem_singleton]
    constructor
    · intro hu
      have hmk : QuotientGroup.mk (s := unitGroup F E m) (cosetRep u) = 1 :=
        (QuotientGroup.eq_one_iff (cosetRep u)).mpr hu
      rwa [hout u] at hmk
    · rintro rfl
      exact (hmem_H m 1).mp (hH_one hm_ge1 le_rfl)
  have hHm_card : (H m).card = 1 := by
    rw [hHm_eq, Finset.card_singleton]
  have hπr_val : ∀ {k : ℕ} (π_k : Eˣ), valL F E (π_k : E) = (k : ℤ) →
      ∀ {r : E}, r ∈ R_E →
      (π_k : E) * r = 0 ∨ (k : ℤ) ≤ valL F E ((π_k : E) * r) := by
    intro k π_k hπ_k r hr
    rcases hRE_int r hr with rfl | hr_ge
    · left; exact mul_zero _
    · by_cases hr0 : r = 0
      · left; rw [hr0, mul_zero]
      · right
        rw [hval_mul (π_k : E) r (Units.ne_zero π_k) hr0, hπ_k]
        omega
  have h1_ne : ∀ {k : ℕ} (π_k : Eˣ), 1 ≤ k → valL F E (π_k : E) = (k : ℤ) →
      ∀ {r : E}, r ∈ R_E → 1 + (π_k : E) * r ≠ 0 := by
    intro k π_k hk hπ_k r hr h0
    have h_eq : (π_k : E) * r = -1 := eq_neg_of_add_eq_zero_right h0
    rcases hπr_val π_k hπ_k hr with h_zero | h_ge
    · rw [h_zero] at h_eq
      exact one_ne_zero (neg_eq_zero.mp h_eq.symm)
    · rw [h_eq, hval_neg1] at h_ge
      omega
  have hw_mem : ∀ {k : ℕ} (π_k : Eˣ), 1 ≤ k → valL F E (π_k : E) = (k : ℤ) →
      ∀ {r : E} (hr : r ∈ R_E) (hne : 1 + (π_k : E) * r ≠ 0),
      Units.mk0 (1 + (π_k : E) * r) hne ∈ unitGroup F E k := by
    intro k π_k hk hπ_k r hr hne
    rw [hunit_ge1 k hk]
    change (1 + (π_k : E) * r : E) = 1 ∨
      (k : ℤ) ≤ valL F E ((1 + (π_k : E) * r : E) - 1)
    rw [add_sub_cancel_left]
    rcases hπr_val π_k hπ_k hr with h_zero | h_ge
    · left; rw [h_zero, add_zero]
    · right; exact h_ge
  have hval_inv_1πr : ∀ {k : ℕ} (π_k : Eˣ), 1 ≤ k → valL F E (π_k : E) = (k : ℤ) →
      ∀ {r : E}, r ∈ R_E → valL F E ((1 + (π_k : E) * r)⁻¹) = 0 := by
    intro k π_k hk hπ_k r hr
    have hne := h1_ne π_k hk hπ_k hr
    set w := Units.mk0 (1 + (π_k : E) * r) hne
    have hw_val : valL F E (w : E) = 0 := hunit_val0 k w (hw_mem π_k hk hπ_k hr hne)
    have hinv_eq : (1 + (π_k : E) * r)⁻¹ = ((w⁻¹ : Eˣ) : E) := by
      rw [Units.val_inv_eq_inv_val, Units.val_mk0]
    rw [hinv_eq, hval_inv w, hw_val, neg_zero]
  let γ : Eˣ → E → Eˣ ⧸ unitGroup F E m := fun π_k r =>
    if hr : 1 + (π_k : E) * r ≠ 0 then
      QuotientGroup.mk (s := unitGroup F E m) (Units.mk0 (1 + (π_k : E) * r) hr)
    else 1
  have hγ_eq : ∀ {k : ℕ} (π_k : Eˣ) (hk : 1 ≤ k) (hπ_k : valL F E (π_k : E) = (k : ℤ))
      {r : E} (hr : r ∈ R_E),
      γ π_k r = QuotientGroup.mk (s := unitGroup F E m)
        (Units.mk0 (1 + (π_k : E) * r) (h1_ne π_k hk hπ_k hr)) := by
    intro k π_k hk hπ_k r hr
    dsimp only [γ]
    rw [dif_pos (h1_ne π_k hk hπ_k hr)]
  have hγ_mem : ∀ {k : ℕ} (π_k : Eˣ), 1 ≤ k → k ≤ m → valL F E (π_k : E) = (k : ℤ) →
      ∀ {r : E}, r ∈ R_E → γ π_k r ∈ H k := by
    intro k π_k hk hkm hπ_k r hr
    rw [hγ_eq π_k hk hπ_k hr, hH_mk hk hkm]
    exact hw_mem π_k hk hπ_k hr (h1_ne π_k hk hπ_k hr)
  have hbij_mem : ∀ {k : ℕ} (π_k : Eˣ), 1 ≤ k → k < m → valL F E (π_k : E) = (k : ℤ) →
      ∀ p ∈ R_E ×ˢ H (k + 1), γ π_k p.1 * p.2 ∈ H k := by
    intro k π_k hk hkm hπ_k p hp
    rcases Finset.mem_product.mp hp with ⟨hr, hh⟩
    have hk_le : k ≤ m := by omega
    exact hH_mul hk hk_le (hγ_mem π_k hk hk_le hπ_k hr) (hH_anti hk (by omega) hh)
  have hbij_inj : ∀ {k : ℕ} (π_k : Eˣ), 1 ≤ k → k < m → valL F E (π_k : E) = (k : ℤ) →
      ∀ p₁ ∈ R_E ×ˢ H (k + 1), ∀ p₂ ∈ R_E ×ˢ H (k + 1),
      γ π_k p₁.1 * p₁.2 = γ π_k p₂.1 * p₂.2 → p₁ = p₂ := by
    intro k π_k hk hkm hπ_k p₁ hp₁ p₂ hp₂ heq
    rcases Finset.mem_product.mp hp₁ with ⟨hr₁, hh₁⟩
    rcases Finset.mem_product.mp hp₂ with ⟨hr₂, hh₂⟩
    set r₁ := p₁.1
    set h₁ := p₁.2
    set r₂ := p₂.1
    set h₂ := p₂.2
    have hk1_ge1 : 1 ≤ k + 1 := by omega
    have hk1_le : k + 1 ≤ m := by omega
    set w₁ := Units.mk0 (1 + (π_k : E) * r₁) (h1_ne π_k hk hπ_k hr₁)
    set w₂ := Units.mk0 (1 + (π_k : E) * r₂) (h1_ne π_k hk hπ_k hr₂)
    have hquot_eq : (γ π_k r₂)⁻¹ * γ π_k r₁ = h₂ * h₁⁻¹ := by
      calc (γ π_k r₂)⁻¹ * γ π_k r₁
        _ = (γ π_k r₂)⁻¹ * (γ π_k r₁ * h₁) * h₁⁻¹ := by group
        _ = (γ π_k r₂)⁻¹ * (γ π_k r₂ * h₂) * h₁⁻¹ := by rw [heq]
        _ = h₂ * h₁⁻¹ := by group
    have hh21_mem : h₂ * h₁⁻¹ ∈ H (k + 1) :=
      hH_mul hk1_ge1 hk1_le hh₂ (hH_inv hk1_ge1 hk1_le hh₁)
    have hw21_mk : QuotientGroup.mk (s := unitGroup F E m) (w₂⁻¹ * w₁) =
        (γ π_k r₂)⁻¹ * γ π_k r₁ := by
      rw [hγ_eq π_k hk hπ_k hr₁, hγ_eq π_k hk hπ_k hr₂,
        ← QuotientGroup.mk_inv, ← QuotientGroup.mk_mul]
    have hw21_mem : w₂⁻¹ * w₁ ∈ unitGroup F E (k + 1) := by
      rw [← hH_mk hk1_ge1 hk1_le, hw21_mk, hquot_eq]
      exact hh21_mem
    have hr_eq : r₁ = r₂ := by
      by_contra hr_ne
      set A : E := 1 + (π_k : E) * r₂
      have hA_ne : A ≠ 0 := h1_ne π_k hk hπ_k hr₂
      have hdiff_eq : ((w₂⁻¹ * w₁ : Eˣ) : E) - 1 = A⁻¹ * (π_k : E) * (r₁ - r₂) := by
        rw [Units.val_mul, Units.val_inv_eq_inv_val, Units.val_mk0, Units.val_mk0]
        change A⁻¹ * (1 + (π_k : E) * r₁) - 1 = A⁻¹ * (π_k : E) * (r₁ - r₂)
        have hA_inv : A⁻¹ * A = 1 := inv_mul_cancel₀ hA_ne
        calc A⁻¹ * (1 + (π_k : E) * r₁) - 1
          _ = A⁻¹ * (1 + (π_k : E) * r₁) - A⁻¹ * A := by rw [hA_inv]
          _ = A⁻¹ * (1 + (π_k : E) * r₁) - A⁻¹ * (1 + (π_k : E) * r₂) := rfl
          _ = A⁻¹ * (π_k : E) * (r₁ - r₂) := by ring
      have hdiff_ne0 : ((w₂⁻¹ * w₁ : Eˣ) : E) - 1 ≠ 0 := by
        rw [hdiff_eq]
        exact mul_ne_zero (mul_ne_zero (inv_ne_zero hA_ne) (Units.ne_zero π_k))
          (sub_ne_zero.mpr hr_ne)
      have hval_diff : valL F E (((w₂⁻¹ * w₁ : Eˣ) : E) - 1) = (k : ℤ) := by
        rw [hdiff_eq,
          hval_mul (A⁻¹ * (π_k : E)) (r₁ - r₂)
            (mul_ne_zero (inv_ne_zero hA_ne) (Units.ne_zero π_k)) (sub_ne_zero.mpr hr_ne),
          hval_mul A⁻¹ (π_k : E) (inv_ne_zero hA_ne) (Units.ne_zero π_k),
          hval_inv_1πr π_k hk hπ_k hr₂, hπ_k, hRE_sep r₁ hr₁ r₂ hr₂ hr_ne]
        ring
      rcases (hunit_ge1 (k + 1) hk1_ge1 (w₂⁻¹ * w₁)).mp hw21_mem with hw1 | hw_ge
      · exact hdiff_ne0 (sub_eq_zero.mpr hw1)
      · rw [hval_diff] at hw_ge
        omega
    have hh_eq : h₁ = h₂ := by
      calc h₁ = (γ π_k r₁)⁻¹ * (γ π_k r₁ * h₁) := by group
        _ = (γ π_k r₁)⁻¹ * (γ π_k r₂ * h₂) := by rw [heq]
        _ = (γ π_k r₂)⁻¹ * (γ π_k r₂ * h₂) := by rw [hr_eq]
        _ = h₂ := by group
    exact Prod.ext hr_eq hh_eq
  have hbij_surj : ∀ {k : ℕ} (π_k : Eˣ), 1 ≤ k → k < m → valL F E (π_k : E) = (k : ℤ) →
      ∀ u ∈ H k, ∃ p ∈ R_E ×ˢ H (k + 1), γ π_k p.1 * p.2 = u := by
    intro k π_k hk hkm hπ_k u hu
    set w := cosetRep u
    have hw : w ∈ unitGroup F E k := (hmem_H k u).mp hu
    set z : E := ((π_k⁻¹ : Eˣ) : E) * ((w : E) - 1)
    have hz_int : z = 0 ∨ 0 ≤ valL F E z := by
      rcases (hunit_ge1 k hk w).mp hw with hw1 | hw_ge
      · left; dsimp [z]; rw [hw1, sub_self, mul_zero]
      · by_cases hw0 : (w : E) - 1 = 0
        · left; dsimp [z]; rw [hw0, mul_zero]
        · right
          dsimp [z]
          rw [hval_mul ((π_k⁻¹ : Eˣ) : E) ((w : E) - 1) (Units.ne_zero _) hw0,
            hval_inv π_k, hπ_k]
          omega
    obtain ⟨r, hr, hzr⟩ := hRE_surj z hz_int
    set h : Eˣ ⧸ unitGroup F E m := (γ π_k r)⁻¹ * u
    refine ⟨(r, h), ?_, mul_inv_cancel_left (γ π_k r) u⟩
    rw [Finset.mem_product]
    refine ⟨hr, ?_⟩
    have hk1_ge1 : 1 ≤ k + 1 := by omega
    have hk1_le : k + 1 ≤ m := by omega
    set w_r := Units.mk0 (1 + (π_k : E) * r) (h1_ne π_k hk hπ_k hr)
    have hh_mk : h = QuotientGroup.mk (s := unitGroup F E m) (w_r⁻¹ * w) := by
      dsimp only [h]
      rw [hγ_eq π_k hk hπ_k hr, ← hout u, ← QuotientGroup.mk_inv, ← QuotientGroup.mk_mul]
    rw [hh_mk, hH_mk hk1_ge1 hk1_le, hunit_ge1 (k + 1) hk1_ge1]
    set A : E := 1 + (π_k : E) * r
    have hA_ne : A ≠ 0 := h1_ne π_k hk hπ_k hr
    have hπz_eq : 1 + (π_k : E) * z = (w : E) := by
      dsimp only [z]
      rw [← mul_assoc, Units.mul_inv, one_mul, add_sub_cancel]
    have hdiff_eq : ((w_r⁻¹ * w : Eˣ) : E) - 1 = A⁻¹ * (π_k : E) * (z - r) := by
      rw [Units.val_mul, Units.val_inv_eq_inv_val, Units.val_mk0, ← hπz_eq]
      change A⁻¹ * (1 + (π_k : E) * z) - 1 = A⁻¹ * (π_k : E) * (z - r)
      have hA_inv : A⁻¹ * A = 1 := inv_mul_cancel₀ hA_ne
      calc A⁻¹ * (1 + (π_k : E) * z) - 1
        _ = A⁻¹ * (1 + (π_k : E) * z) - A⁻¹ * A := by rw [hA_inv]
        _ = A⁻¹ * (1 + (π_k : E) * z) - A⁻¹ * (1 + (π_k : E) * r) := rfl
        _ = A⁻¹ * (π_k : E) * (z - r) := by ring
    rcases hzr with hzr0 | hzr_ge
    · left
      apply sub_eq_zero.mp
      rw [hdiff_eq, hzr0, mul_zero]
    · by_cases hzr0 : z - r = 0
      · left
        apply sub_eq_zero.mp
        rw [hdiff_eq, hzr0, mul_zero]
      · right
        rw [hdiff_eq,
          hval_mul (A⁻¹ * (π_k : E)) (z - r)
            (mul_ne_zero (inv_ne_zero hA_ne) (Units.ne_zero π_k)) hzr0,
          hval_mul A⁻¹ (π_k : E) (inv_ne_zero hA_ne) (Units.ne_zero π_k),
          hval_inv_1πr π_k hk hπ_k hr, hπ_k]
        omega
  have hH_card_step : ∀ {k : ℕ}, 1 ≤ k → k < m →
      (H k).card = R_E.card * (H (k + 1)).card := by
    intro k hk hkm
    obtain ⟨π_k, hπ_k⟩ := hval_surj (k : ℤ)
    have hbij : (R_E ×ˢ H (k + 1)).card = (H k).card :=
      Finset.card_bij (fun p _ => γ π_k p.1 * p.2)
        (fun p hp => hbij_mem π_k hk hkm hπ_k p hp)
        (fun p₁ hp₁ p₂ hp₂ heq => hbij_inj π_k hk hkm hπ_k p₁ hp₁ p₂ hp₂ heq)
        (fun u hu => by
          obtain ⟨p, hp, hp_eq⟩ := hbij_surj π_k hk hkm hπ_k u hu
          exact ⟨p, hp, hp_eq⟩)
    rw [← hbij, Finset.card_product]
  have hH_card_pow : ∀ j : ℕ, j ≤ m - 1 →
      (H (m - j)).card = (R_E.card) ^ j := by
    intro j
    induction j with
    | zero =>
      intro _
      simp [hHm_card]
    | succ j ih =>
      intro hj
      have hk1 : 1 ≤ m - (j + 1) := by omega
      have hkm : m - (j + 1) < m := by omega
      have hsucc : m - (j + 1) + 1 = m - j := by omega
      rw [hH_card_step hk1 hkm, hsucc, ih (by omega), pow_succ']
  have hHe_card : (H e).card = (R_E.card) ^ d :=
    hH_card_pow d (by omega)
  let f : (Eˣ ⧸ unitGroup F E m) → Ω F := fun u =>
    (θ (cosetRep u) : Ω F)⁻¹ *
      ψ_E (((c⁻¹ : Eˣ) : E) * (((cosetRep u : Eˣ) : E) - 1))
  have hc_inv_val : valL F E ((c⁻¹ : Eˣ) : E) = -((m : ℤ) + n) := by
    rw [hval_inv c, hc_val]
  have hψ_c_triv : ∀ y : E, (y = 0 ∨ (m : ℤ) ≤ valL F E y) →
      ψ_E (((c⁻¹ : Eˣ) : E) * y) = 1 := by
    intro y hy
    apply hSpecE_triv (((c⁻¹ : Eˣ) : E) * y)
    rcases hy with rfl | hy_ge
    · left; exact mul_zero _
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hval_mul ((c⁻¹ : Eˣ) : E) y (Units.ne_zero _) hy0, hc_inv_val]
        omega
  have hf_mk : ∀ w : Eˣ, valL F E (w : E) = 0 →
      f (QuotientGroup.mk (s := unitGroup F E m) w) =
        (θ w : Ω F)⁻¹ * ψ_E (((c⁻¹ : Eˣ) : E) * ((w : E) - 1)) := by
    intro w hw_val
    dsimp only [f]
    set r := cosetRep (QuotientGroup.mk (s := unitGroup F E m) w)
    set k := w⁻¹ * r
    have hk : k ∈ unitGroup F E m := hcoset_mk w
    have hr_eq : r = w * k := by simp [k]
    have hθ_eq : θ r = θ w := by
      rw [hr_eq, map_mul, hSpecE_θ k hk, mul_one]
    set y : E := (w : E) * ((k : E) - 1)
    have hy_val : y = 0 ∨ (m : ℤ) ≤ valL F E y := by
      rcases (hunit_ge1 m hm_ge1 k).mp hk with hk1 | hk_ge
      · left; dsimp [y]; rw [hk1, sub_self, mul_zero]
      · by_cases hk0 : (k : E) - 1 = 0
        · left; dsimp [y]; rw [hk0, mul_zero]
        · right
          dsimp [y]
          rw [hval_mul (w : E) ((k : E) - 1) (Units.ne_zero w) hk0, hw_val]
          omega
    have hr_val_eq : (r : E) = (w : E) * (k : E) := congrArg Units.val hr_eq
    have hsplit : ((c⁻¹ : Eˣ) : E) * ((r : E) - 1) =
        ((c⁻¹ : Eˣ) : E) * ((w : E) - 1) + ((c⁻¹ : Eˣ) : E) * y := by
      dsimp only [y]
      rw [hr_val_eq]
      ring
    rw [hθ_eq, hsplit, AddChar.map_add_eq_mul, hψ_c_triv y hy_val, mul_one]
  have hf_mk_He : ∀ w ∈ unitGroup F E e,
      (θ w : Ω F)⁻¹ * ψ_E (((c⁻¹ : Eˣ) : E) * ((w : E) - 1)) = 1 := by
    intro w hw
    rw [← hc_stat w hw, inv_mul_cancel₀ (Units.ne_zero (θ w))]
  have hf_He : ∀ {h : Eˣ ⧸ unitGroup F E m}, h ∈ H e → f h = 1 := by
    intro h hh
    exact hf_mk_He (cosetRep h) ((hmem_H e h).mp hh)
  have hf_mul_He : ∀ {u h : Eˣ ⧸ unitGroup F E m}, u ∈ H d → h ∈ H e →
      f (u * h) = f u := by
    intro u h hu hh
    set w_u := cosetRep u
    set w_h := cosetRep h
    have hwu : w_u ∈ unitGroup F E d := (hmem_H d u).mp hu
    have hwh : w_h ∈ unitGroup F E e := (hmem_H e h).mp hh
    have hwu_val : valL F E (w_u : E) = 0 := hunit_val0 d w_u hwu
    have hwh_val : valL F E (w_h : E) = 0 := hunit_val0 e w_h hwh
    have hwuh_val : valL F E ((w_u * w_h : Eˣ) : E) = 0 := by
      rw [Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
        hwu_val, hwh_val, add_zero]
    have huh_mk : u * h = QuotientGroup.mk (s := unitGroup F E m) (w_u * w_h) := by
      rw [QuotientGroup.mk_mul, hout, hout]
    rw [huh_mk, hf_mk (w_u * w_h) hwuh_val]
    set d_u : E := (w_u : E) - 1
    set d_h : E := (w_h : E) - 1
    set y : E := d_u * d_h
    have hy_val : y = 0 ∨ (m : ℤ) ≤ valL F E y := by
      rcases (hunit_ge1 d hd_ge1 w_u).mp hwu with hwu1 | hwu_ge
      · left; dsimp [y, d_u]; rw [hwu1, sub_self, zero_mul]
      · rcases (hunit_ge1 e he_ge1 w_h).mp hwh with hwh1 | hwh_ge
        · left; dsimp [y, d_h]; rw [hwh1, sub_self, mul_zero]
        · by_cases hdu0 : d_u = 0
          · left; dsimp [y]; rw [hdu0, zero_mul]
          · by_cases hdh0 : d_h = 0
            · left; dsimp [y]; rw [hdh0, mul_zero]
            · right
              rw [hval_mul d_u d_h hdu0 hdh0]
              dsimp only [d_u, d_h]
              omega
    have hsplit : ((c⁻¹ : Eˣ) : E) * (((w_u * w_h : Eˣ) : E) - 1) =
        (((c⁻¹ : Eˣ) : E) * d_u + ((c⁻¹ : Eˣ) : E) * d_h) + ((c⁻¹ : Eˣ) : E) * y := by
      rw [Units.val_mul]
      dsimp only [y, d_u, d_h]
      ring
    rw [hsplit, AddChar.map_add_eq_mul, hψ_c_triv y hy_val, mul_one,
      AddChar.map_add_eq_mul, map_mul, Units.val_mul, mul_inv]
    calc ((θ w_u : Ω F)⁻¹ * (θ w_h : Ω F)⁻¹) *
          (ψ_E (((c⁻¹ : Eˣ) : E) * d_u) * ψ_E (((c⁻¹ : Eˣ) : E) * d_h))
      _ = ((θ w_u : Ω F)⁻¹ * ψ_E (((c⁻¹ : Eˣ) : E) * d_u)) *
          ((θ w_h : Ω F)⁻¹ * ψ_E (((c⁻¹ : Eˣ) : E) * d_h)) := by ring
      _ = f u * 1 := by
          rw [hf_mk_He w_h hwh]
      _ = f u := mul_one _
  refine ⟨?_, ?_⟩
  · intro hm_even
    have he_eq_d : e = d := by omega
    have hd_eq_e : H d = H e := by rw [he_eq_d]
    change (∑ u ∈ H d, f u) = (R_E.card : Ω F) ^ d
    rw [hd_eq_e, Finset.sum_congr rfl (fun h hh => hf_He hh),
      Finset.sum_const, nsmul_one, hHe_card, Nat.cast_pow]
  · intro hm_odd
    have hd_lt_m : d < m := by omega
    have he_eq_d1 : e = d + 1 := by omega
    change (∑ u ∈ H d, f u) = _
    have hsum_bij : (∑ u ∈ H d, f u) =
        ∑ p ∈ R_E ×ˢ H (d + 1), f (γ δ p.1 * p.2) := by
      exact (Finset.sum_bij (fun p _ => γ δ p.1 * p.2)
        (fun p hp => hbij_mem δ hd_ge1 hd_lt_m hδ p hp)
        (fun p₁ hp₁ p₂ hp₂ heq => hbij_inj δ hd_ge1 hd_lt_m hδ p₁ hp₁ p₂ hp₂ heq)
        (fun u hu => by
          obtain ⟨p, hp, hp_eq⟩ := hbij_surj δ hd_ge1 hd_lt_m hδ u hu
          exact ⟨p, hp, hp_eq⟩)
        (fun p _ => rfl)).symm
    rw [hsum_bij, Finset.sum_product, ← he_eq_d1]
    have hinner : ∀ r ∈ R_E,
        (∑ h ∈ H e, f (γ δ r * h)) = (R_E.card : Ω F) ^ d * f (γ δ r) := by
      intro r hr
      have hγ_d : γ δ r ∈ H d := hγ_mem δ hd_ge1 hd_le_m hδ hr
      rw [Finset.sum_congr rfl (fun h hh => hf_mul_He hγ_d hh),
        Finset.sum_const, nsmul_eq_mul, hHe_card, Nat.cast_pow]
    rw [Finset.sum_congr rfl hinner, ← Finset.mul_sum]
    congr 1
    apply Finset.sum_congr rfl
    intro r hr
    have hr_ne : 1 + (δ : E) * r ≠ 0 := h1_ne δ hd_ge1 hδ hr
    rw [dif_pos hr_ne, hγ_eq δ hd_ge1 hδ hr]
    set w_r := Units.mk0 (1 + (δ : E) * r) hr_ne
    have hwr_val : valL F E (w_r : E) = 0 :=
      hunit_val0 d w_r (hw_mem δ hd_ge1 hδ hr hr_ne)
    rw [hf_mk w_r hwr_val]
    congr 1
    congr 1
    change ((c⁻¹ : Eˣ) : E) * ((1 + (δ : E) * r) - 1) = ((c⁻¹ : Eˣ) : E) * (δ : E) * r
    ring

theorem ld_cond_ge_two_stable_twist (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
    (ψ_E : AddChar E (Ω F)) (θ ν : Eˣ →* (Ω F)ˣ)
    (hm : 2 ≤ condExp F E θ)
    (hν : ∀ u ∈ unitGroup F E (condExp F E θ / 2), ν u = 1)
    (hSpecE_θ : (condExp F E θ ≠ 0 →
      (∀ u ∈ unitGroup F E (condExp F E θ), θ u = 1) ∧
      (∃ u₀ ∈ unitGroup F E (condExp F E θ - 1), θ u₀ ≠ 1)))
    (hFinE : Set.Finite {u : Eˣ ⧸ unitGroup F E (condExp F E θ) |
      valL F E ((cosetRep u : Eˣ) : E) = 0})
    (hvalE_props : valL F E 0 = 0 ∧
      valL F E 1 = 0 ∧
      valL F E (-1) = 0 ∧
      (∀ x : E, valL F E (-x) = valL F E x) ∧
      (∀ x y : E, x ≠ 0 → y ≠ 0 → valL F E (x * y) = valL F E x + valL F E y) ∧
      (∀ u : Eˣ, valL F E ((u⁻¹ : Eˣ) : E) = - valL F E (u : E)) ∧
      (∀ m : ℤ, ∃ c : Eˣ, valL F E (c : E) = m) ∧
      (∀ (k : ℤ) (x y : E),
        (x = 0 ∨ k ≤ valL F E x) → (y = 0 ∨ k ≤ valL F E y) →
          (x + y = 0 ∨ k ≤ valL F E (x + y))) ∧
      (∀ u : Eˣ, u ∈ unitGroup F E 0 ↔ valL F E (u : E) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Eˣ,
        u ∈ unitGroup F E a ↔ ((u : E) = 1 ∨ (a : ℤ) ≤ valL F E ((u : E) - 1))) ∧
      (∀ (a : ℕ) (u : Eˣ), u ∈ unitGroup F E a → valL F E (u : E) = 0))
    (c : Eˣ)
    (hc_val : valL F E (c : E) = (condExp F E θ : ℤ) + condExpChar F E ψ_E)
    (hc_stat : ∀ w ∈ unitGroup F E (condExp F E θ - condExp F E θ / 2),
      (θ w : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * ((w : E) - 1)))
    (heps_θ : tateEps F E θ ψ_E =
      (qL F E : Ω F) ^ condExpChar F E ψ_E * (θ c : Ω F) *
        ψ_E (((c⁻¹ : Eˣ) : E)) *
        (∑ u ∈ hFinE.toFinset.filter
            (fun u => cosetRep u ∈ unitGroup F E (condExp F E θ / 2)),
          ((θ (cosetRep u) : Ω F)⁻¹ *
            ψ_E (((c⁻¹ : Eˣ) : E) * (((cosetRep u : Eˣ) : E) - 1)))))
    (hRed_νθ : ∀ (hge2 : 2 ≤ condExp F E (ν * θ))
      (hFin_νθ : Set.Finite {u : Eˣ ⧸ unitGroup F E (condExp F E (ν * θ)) |
        valL F E ((cosetRep u : Eˣ) : E) = 0}),
      valL F E (c : E) = (condExp F E (ν * θ) : ℤ) + condExpChar F E ψ_E →
      (∀ w ∈ unitGroup F E (condExp F E (ν * θ) - condExp F E (ν * θ) / 2),
        ((ν * θ) w : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * ((w : E) - 1))) →
      tateEps F E (ν * θ) ψ_E =
        (qL F E : Ω F) ^ condExpChar F E ψ_E * ((ν * θ) c : Ω F) *
          ψ_E (((c⁻¹ : Eˣ) : E)) *
          (∑ u ∈ hFin_νθ.toFinset.filter
              (fun u => cosetRep u ∈ unitGroup F E (condExp F E (ν * θ) / 2)),
            (((ν * θ) (cosetRep u) : Ω F)⁻¹ *
              ψ_E (((c⁻¹ : Eˣ) : E) * (((cosetRep u : Eˣ) : E) - 1))))) :
    condExp F E (ν * θ) = condExp F E θ ∧
    tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E :=
by
  have hunit0 : ∀ u : Eˣ, u ∈ unitGroup F E 0 ↔ valL F E (u : E) = 0 :=
    hvalE_props.2.2.2.2.2.2.2.2.1
  have hunit_ge1 : ∀ (a : ℕ), 1 ≤ a → ∀ u : Eˣ,
      u ∈ unitGroup F E a ↔ ((u : E) = 1 ∨ (a : ℤ) ≤ valL F E ((u : E) - 1)) :=
    hvalE_props.2.2.2.2.2.2.2.2.2.1
  have hunit_val0 : ∀ (a : ℕ) (u : Eˣ), u ∈ unitGroup F E a → valL F E (u : E) = 0 :=
    hvalE_props.2.2.2.2.2.2.2.2.2.2
  have hunit_anti : ∀ {a₁ a₂ : ℕ}, a₁ ≤ a₂ → unitGroup F E a₂ ≤ unitGroup F E a₁ := by
    intro a₁ a₂ hle u hu
    by_cases ha₁ : a₁ = 0
    · subst ha₁
      exact (hunit0 u).mpr (hunit_val0 a₂ u hu)
    · rw [hunit_ge1 a₁ (by omega) u]
      rcases (hunit_ge1 a₂ (by omega) u).mp hu with h1 | hge
      · exact Or.inl h1
      · exact Or.inr (le_trans (by exact_mod_cast hle) hge)
  set m := condExp F E θ
  set d := m / 2
  have hm_ne0 : m ≠ 0 := by omega
  have hd_le_m : d ≤ m := by omega
  have hd_le_sub1 : d ≤ m - 1 := by omega
  obtain ⟨hθ_triv, u₀, hu₀_mem, hu₀_ne1⟩ := hSpecE_θ hm_ne0
  set S_νθ : Set ℕ := {a : ℕ | ∀ u ∈ unitGroup F E a, (ν * θ) u = 1}
  have hm_mem : m ∈ S_νθ := by
    intro u hu
    have hu_d : u ∈ unitGroup F E d := hunit_anti hd_le_m hu
    rw [MonoidHom.mul_apply, hν u hu_d, hθ_triv u hu, mul_one]
  have hcond_le : condExp F E (ν * θ) ≤ m := Nat.sInf_le hm_mem
  have hcond_ge : m ≤ condExp F E (ν * θ) := by
    by_contra hlt
    have hle_sub1 : condExp F E (ν * θ) ≤ m - 1 := by omega
    have hmem_inf : condExp F E (ν * θ) ∈ S_νθ := Nat.sInf_mem ⟨m, hm_mem⟩
    have hu₀_inf : u₀ ∈ unitGroup F E (condExp F E (ν * θ)) := hunit_anti hle_sub1 hu₀_mem
    have hu₀_d : u₀ ∈ unitGroup F E d := hunit_anti hd_le_sub1 hu₀_mem
    have h1 : (ν * θ) u₀ = 1 := hmem_inf u₀ hu₀_inf
    rw [MonoidHom.mul_apply, hν u₀ hu₀_d, one_mul] at h1
    exact hu₀_ne1 h1
  have hcond_eq : condExp F E (ν * θ) = m := le_antisymm hcond_le hcond_ge
  have hge2_νθ : 2 ≤ condExp F E (ν * θ) := by rw [hcond_eq]; exact hm
  have hFin_νθ : Set.Finite {u : Eˣ ⧸ unitGroup F E (condExp F E (ν * θ)) |
      valL F E ((cosetRep u : Eˣ) : E) = 0} := by
    rw [hcond_eq]; exact hFinE
  have hc_val_νθ : valL F E (c : E) = (condExp F E (ν * θ) : ℤ) + condExpChar F E ψ_E := by
    rw [hcond_eq]; exact hc_val
  have hc_stat_νθ : ∀ w ∈ unitGroup F E (condExp F E (ν * θ) - condExp F E (ν * θ) / 2),
      ((ν * θ) w : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * ((w : E) - 1)) := by
    intro w hw
    have hw_e : w ∈ unitGroup F E (m - d) := by rwa [hcond_eq] at hw
    have hw_d : w ∈ unitGroup F E d := hunit_anti (by omega) hw_e
    have hmul_w : (ν * θ) w = θ w := by
      rw [MonoidHom.mul_apply, hν w hw_d, one_mul]
    rw [hmul_w]
    exact hc_stat w hw_e
  have heps_νθ := hRed_νθ hge2_νθ hFin_νθ hc_val_νθ hc_stat_νθ
  have hsum_congr :
      (∑ u ∈ hFin_νθ.toFinset.filter
          (fun u => cosetRep u ∈ unitGroup F E (condExp F E (ν * θ) / 2)),
        (((ν * θ) (cosetRep u) : Ω F)⁻¹ *
          ψ_E (((c⁻¹ : Eˣ) : E) * (((cosetRep u : Eˣ) : E) - 1)))) =
      (∑ u ∈ hFin_νθ.toFinset.filter
          (fun u => cosetRep u ∈ unitGroup F E (condExp F E (ν * θ) / 2)),
        ((θ (cosetRep u) : Ω F)⁻¹ *
          ψ_E (((c⁻¹ : Eˣ) : E) * (((cosetRep u : Eˣ) : E) - 1)))) := by
    refine Finset.sum_congr rfl (fun u hu => ?_)
    have hu_d : cosetRep u ∈ unitGroup F E d :=
      hunit_anti (by omega) (Finset.mem_filter.mp hu).2
    have hmul_u : (ν * θ) (cosetRep u) = θ (cosetRep u) := by
      rw [MonoidHom.mul_apply, hν (cosetRep u) hu_d, one_mul]
    rw [hmul_u]
  have hsum_dep : ∀ (a₁ a₂ : ℕ)
      (h₁ : Set.Finite {u : Eˣ ⧸ unitGroup F E a₁ | valL F E ((cosetRep u : Eˣ) : E) = 0})
      (h₂ : Set.Finite {u : Eˣ ⧸ unitGroup F E a₂ | valL F E ((cosetRep u : Eˣ) : E) = 0}),
      a₁ = a₂ →
      (∑ u ∈ h₁.toFinset.filter (fun u => cosetRep u ∈ unitGroup F E (a₁ / 2)),
        ((θ (cosetRep u) : Ω F)⁻¹ *
          ψ_E (((c⁻¹ : Eˣ) : E) * (((cosetRep u : Eˣ) : E) - 1)))) =
      (∑ u ∈ h₂.toFinset.filter (fun u => cosetRep u ∈ unitGroup F E (a₂ / 2)),
        ((θ (cosetRep u) : Ω F)⁻¹ *
          ψ_E (((c⁻¹ : Eˣ) : E) * (((cosetRep u : Eˣ) : E) - 1)))) := by
    intro a₁ a₂ h₁ h₂ ha
    subst ha
    rfl
  have hsum_eq :
      (∑ u ∈ hFin_νθ.toFinset.filter
          (fun u => cosetRep u ∈ unitGroup F E (condExp F E (ν * θ) / 2)),
        (((ν * θ) (cosetRep u) : Ω F)⁻¹ *
          ψ_E (((c⁻¹ : Eˣ) : E) * (((cosetRep u : Eˣ) : E) - 1)))) =
      (∑ u ∈ hFinE.toFinset.filter
          (fun u => cosetRep u ∈ unitGroup F E (condExp F E θ / 2)),
        ((θ (cosetRep u) : Ω F)⁻¹ *
          ψ_E (((c⁻¹ : Eˣ) : E) * (((cosetRep u : Eˣ) : E) - 1)))) :=
    hsum_congr.trans (hsum_dep (condExp F E (ν * θ)) m hFin_νθ hFinE hcond_eq)
  have hmul_c : (((ν * θ) c : (Ω F)ˣ) : Ω F) = (ν c : Ω F) * (θ c : Ω F) := by
    rw [MonoidHom.mul_apply, Units.val_mul]
  refine ⟨hcond_eq, ?_⟩
  rw [heps_νθ, hsum_eq, hmul_c, heps_θ]
  ring

theorem ld_tame_stationary_phase_and_stable_twist (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
    (ψ_E : AddChar E (Ω F)) (hψE : IsAdmissibleChar F E ψ_E)
    (θ : Eˣ →* (Ω F)ˣ) (hm : 2 ≤ condExp F E θ) :
    let m := condExp F E θ
    let d := m / 2
    let r₀ := (m + 1) / 2
    (∃ c_θ : Eˣ,
      valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
      ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
        ∀ hx : 1 + x ≠ 0,
          (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
    (∀ (c : Eˣ),
      valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
      (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
        ∀ hx : 1 + x ≠ 0,
          (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
      (∀ (ν : Eˣ →* (Ω F)ˣ),
        (∀ u ∈ unitGroup F E d, ν u = 1) →
        condExp F E (ν * θ) = m ∧
        tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
      (∀ (R_E : Finset E) (δ : Eˣ),
        (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
        (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
        (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
          ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
        valL F E (δ : E) = (d : ℤ) →
        (m % 2 = 0 →
          tateEps F E θ ψ_E =
            (qL F E : Ω F) ^ condExpChar F E ψ_E *
              (R_E.card : Ω F) ^ d *
              (θ c : Ω F) *
              ψ_E (((c⁻¹ : Eˣ) : E))) ∧
        (m % 2 = 1 →
          tateEps F E θ ψ_E =
            (qL F E : Ω F) ^ condExpChar F E ψ_E *
              (R_E.card : Ω F) ^ d *
              (θ c : Ω F) *
              ψ_E (((c⁻¹ : Eˣ) : E)) *
              ∑ r ∈ R_E,
                if hr : 1 + (δ : E) * r ≠ 0 then
                  (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                    ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                else 0))) :=
by
  have hvalE := ld_valL_and_unitGroup_props F E
  have hSpecE := ld_condExp_and_condExpChar_spec F E ψ_E hψE θ
  have hm1 : 1 ≤ condExp F E θ := by omega
  have hFinE := ld_unitCoset_finite F E (condExp F E θ) hm1
  have hne_θ := ld_tateEps_ne_zero F E ψ_E hψE θ
  have hstat_θ :=
    ld_cond_ge_two_stationary_phase_sum_reduction F E ψ_E θ hm hSpecE hFinE hvalE
  have hr₀_eq : (condExp F E θ + 1) / 2 = condExp F E θ - condExp F E θ / 2 := by omega
  have hr₀_ge1 : 1 ≤ condExp F E θ - condExp F E θ / 2 := by omega
  have hunit_ge1 := hvalE.2.2.2.2.2.2.2.2.2.1
  refine ⟨?_, ?_⟩
  · obtain ⟨c_θ, hc_val, hc_stat⟩ := hstat_θ.1 hne_θ
    refine ⟨c_θ, hc_val, ?_⟩
    intro x hx_val hx
    have hw_mem : Units.mk0 (1 + x) hx ∈ unitGroup F E (condExp F E θ - condExp F E θ / 2) := by
      rw [hunit_ge1 _ hr₀_ge1]
      change (1 + x : E) = 1 ∨
        ((condExp F E θ - condExp F E θ / 2 : ℕ) : ℤ) ≤ valL F E ((1 + x : E) - 1)
      rw [add_sub_cancel_left, ← hr₀_eq]
      rcases hx_val with rfl | hx_val
      · left; ring
      · right; exact hx_val
    have h := hc_stat (Units.mk0 (1 + x) hx) hw_mem
    change (θ (Units.mk0 (1 + x) hx) : Ω F) =
      ψ_E (((c_θ⁻¹ : Eˣ) : E) * ((1 + x : E) - 1)) at h
    rw [add_sub_cancel_left] at h
    exact h
  · intro c hc_val hc_x
    have hc_stat : ∀ w ∈ unitGroup F E (condExp F E θ - condExp F E θ / 2),
        (θ w : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * ((w : E) - 1)) := by
      intro w hw
      have hw_val : (w : E) - 1 = 0 ∨
          (((condExp F E θ + 1) / 2 : ℕ) : ℤ) ≤ valL F E ((w : E) - 1) := by
        rw [hr₀_eq]
        rcases (hunit_ge1 _ hr₀_ge1 w).mp hw with hw1 | hw_ge
        · left; rw [hw1, sub_self]
        · right; exact hw_ge
      have hx : 1 + ((w : E) - 1) ≠ 0 := by
        rw [add_sub_cancel]
        exact Units.ne_zero w
      have h := hc_x ((w : E) - 1) hw_val hx
      have hmk : Units.mk0 (1 + ((w : E) - 1)) hx = w :=
        Units.ext (add_sub_cancel 1 (w : E))
      rw [hmk] at h
      exact h
    have heps_θ := hstat_θ.2 c hc_val hc_stat
    refine ⟨?_, ?_⟩
    · intro ν hν
      exact ld_cond_ge_two_stable_twist F E ψ_E θ ν hm hν hSpecE.2.2.1 hFinE hvalE
        c hc_val hc_stat heps_θ
        (fun hge2 hFin_νθ hc_val' hc_stat' =>
          (ld_cond_ge_two_stationary_phase_sum_reduction F E ψ_E (ν * θ) hge2
            (ld_condExp_and_condExpChar_spec F E ψ_E hψE (ν * θ)) hFin_νθ hvalE).2
            c hc_val' hc_stat')
    · intro R_E δ hRE_int hRE_sep hRE_surj hδ
      have heval :=
        ld_cond_ge_two_hd_sum_eval_over_res_finset F E ψ_E θ hm hSpecE.1
          (hSpecE.2.2.1 (by omega)).1 hFinE hvalE c hc_val hc_stat
          R_E δ hRE_int hRE_sep hRE_surj hδ
      dsimp only at heval
      refine ⟨?_, ?_⟩
      · intro hm_even
        rw [heps_θ, heval.1 hm_even]
        ring
      · intro hm_odd
        rw [heps_θ, heval.2 hm_odd]
        ring

theorem ld_tame_higher_cond_stationary_transfer_and_rep_finset (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) (hLK : L ≤ K)
    [FiniteDimensional F L] [FiniteDimensional F K]
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_triv1 : ∀ u ∈ unitGroup F L 1, ν₁ u = 1)
    (hχ'_cond0 : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1)
    (hValAlg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hCondψK : condExpChar F K (traceChar F hLK ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * (condExpChar F L ψ + 1) - 1)
    (hResSurj : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLK x = 0 ∨
          1 ≤ valL F K (y - IntermediateField.inclusion hLK x)))
    (hTraceBound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
        ((Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) - 1) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (hNormRem : ∀ y : K, (y = 0 ∨ 1 ≤ valL F K y) →
      normLM F hLK (1 + y) - (1 + traceLM F hLK y) = 0 ∨
        2 * valL F K y ≤
          (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
            valL F L (normLM F hLK (1 + y) - (1 + traceLM F hLK y)))
    (ha2 : 2 ≤ condExp F L χ')
    (hCondχ'K : condExp F K (χ'.comp (Units.map (normLM F hLK))) =
      Module.finrank L (IntermediateField.extendScalars hLK) * (condExp F L χ' - 1) + 1)
    (hvalL : valL F L 0 = 0 ∧
      valL F L 1 = 0 ∧
      valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
