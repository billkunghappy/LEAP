        apply LinearMap.ext
        intro v
        change ρ ⟨x₀ * r x₀, h_xr_mem x₀⟩ (LinearMap.single (Ω F) (fun _ => W) u₀ v (u x₀)) = 0
        rw [LinearMap.single_apply, Pi.single_eq_of_ne hu_ne, map_zero]
      rw [hB, map_zero]
  have hTrans : ∀ {W : Type u} [AddCommGroup W] [Module (Ω F) W]
