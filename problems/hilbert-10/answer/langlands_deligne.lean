      have h_poly_congr1 : P_MC 1 (P_1 w_z - P_poly z) := by
        rw [h_poly_id]
        refine hPMC_add 1 (hPMC_frob_pow r hzp hb0z) ?_
        refine hPMC_sum 1 Finset.univ _ (fun j _ => ?_)
        exact hPMC_0mul 1 (hc_int j) (hPMC_frob_pow (j : ℕ) hzp hb0z)
      have h_poly_diff :
          P_MC (t + 1 : ℤ) ((P_1 w_z - P_poly z) * ((ϖ_MC ^ t : M_Cˣ) : M_C)) :=
        hPMC_mul_ϖt h_poly_congr1
      let z₁ : M_1 := IntermediateField.inclusion hMC_M1 z
