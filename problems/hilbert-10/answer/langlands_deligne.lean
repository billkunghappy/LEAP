    have h1 : (1 + δ₀ : L) = 0 ∨ 0 ≤ valL F L (1 + δ₀) :=
      Or.inr (le_of_eq hz₀_unit.2.symm)
    have hmul := hval_mul_ge (a + 1 : ℤ) 0 (-Δ_P) (1 + δ₀) hneg_ΔP_a1 h1
    rwa [add_zero] at hmul
  let U_j : ℕ → L := fun j => 1 + τ j * (δ : L)
  let sum_tilde : ℕ → L := fun j =>
    ∑ r ∈ Finset.Icc 1 (p - 1), (τ_tilde j : L) ^ r * s_u r
  let δ_err : ℕ → L := fun j => if j ∈ S' then (U_j j)⁻¹ * sum_tilde j else 0
  have hsum_tilde_val : ∀ j ∈ S', sum_tilde j = 0 ∨ (m_1 : ℤ) ≤ valL F L (sum_tilde j) := by
    intro j hj
    apply hval_finset_sum (Finset.Icc 1 (p - 1)) _ (m_1 : ℤ)
    intro r hr
    have hpow := hval_pow_int (τ_tilde j : L) r (hτ_props j hj).1
    have hmul := hval_mul_ge 0 (m_1 : ℤ)
      ((τ_tilde j : L) ^ r) (s_u r) hpow (hs_u_val r hr)
    rwa [zero_add] at hmul
  have hδ_err_all : ∀ j : ℕ, δ_err j = 0 ∨ (m_1 : ℤ) ≤ valL F L (δ_err j) := by
    intro j
    dsimp [δ_err]
    split_ifs with hj
    · have hUj_ne0 : U_j j ≠ 0 := (hτ_props j hj).2.2.2.1
      have hUj_val0 : valL F L (U_j j) = 0 := (hτ_props j hj).2.2.2.2
      have hUj_inv : (U_j j)⁻¹ = 0 ∨ 0 ≤ valL F L (U_j j)⁻¹ :=
        Or.inr (le_of_eq (hval_inv_zero (U_j j) hUj_ne0 hUj_val0).symm)
      have hmul := hval_mul_ge 0 (m_1 : ℤ) (U_j j)⁻¹ (sum_tilde j) hUj_inv (hsum_tilde_val j hj)
      rwa [zero_add] at hmul
    · exact Or.inl rfl
  have hδ_err_val : ∀ j ∈ S', δ_err j = 0 ∨ (m_1 : ℤ) ≤ valL F L (δ_err j) :=
    fun j _ => hδ_err_all j
  have hδ_err_b_half : ∀ j ∈ S',
      δ_err j = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F L (δ_err j) :=
    fun j _ => hval_mono (by exact_mod_cast hb_half_le_m1) (hδ_err_all j)
  have hzj_unit : ∀ j : ℕ, 1 + δ_err j ≠ 0 ∧ valL F L (1 + δ_err j) = 0 := by
    intro j
    exact hunit_of_gt0 (δ_err j) (hval_mono (by exact_mod_cast hm1_ge1) (hδ_err_all j))
  let z : ℕ → Lˣ := fun j => Units.mk0 (1 + δ_err j) (hzj_unit j).1
  have hz_props : ∀ j ∈ S',
      (z j : L) = 1 + δ_err j ∧
      ∃ w_j : Kˣ, normLM F hLK (w_j : K) = (1 + τ j * (δ : L)) * (z j : L) := by
    intro j hj
    refine ⟨rfl, ?_⟩
    let y_j : K := 1 + IntermediateField.inclusion hLK (τ_tilde j : L) * (u_K : K)
    have hUj_δj : U_j j * δ_err j = sum_tilde j := by
      dsimp [δ_err]
      rw [if_pos hj, mul_inv_cancel_left₀ (hτ_props j hj).2.2.2.1]
    have hnorm_yj : normLM F hLK y_j = (1 + τ j * (δ : L)) * (z j : L) := by
      dsimp [y_j]
      rw [hs_poly (u_K : K) (τ_tilde j : L), (hτ_props j hj).2.1, hu_K_norm_val]
      change 1 + sum_tilde j + τ j * (δ : L) = U_j j * (1 + δ_err j)
      dsimp [U_j]
      linear_combination -hUj_δj
    have hy_j_ne0 : y_j ≠ 0 := by
      intro h0
      have hn0 : normLM F hLK y_j = 0 := by rw [h0, hnorm0]
      rw [hnorm_yj] at hn0
      exact mul_ne_zero (hτ_props j hj).2.2.2.1 (hzj_unit j).1 hn0
    exact ⟨Units.mk0 y_j hy_j_ne0, hnorm_yj⟩
  have hδ_err_cong : ∀ j ∈ S',
      (1 + τ j * (δ : L)) * δ_err j -
        (∑ r ∈ Finset.Icc 1 (p - 1), (τ j) ^ r * s_u r) = 0 ∨
        (a + 1 : ℤ) ≤
          valL F L
            ((1 + τ j * (δ : L)) * δ_err j -
              (∑ r ∈ Finset.Icc 1 (p - 1), (τ j) ^ r * s_u r)) := by
    intro j hj
    have hpow_diff : ∀ k : ℕ,
        (τ_tilde j : L) ^ k - (τ j) ^ k = 0 ∨
          (a + 1 : ℤ) ≤ valL F L ((τ_tilde j : L) ^ k - (τ j) ^ k) := by
      intro k
      induction k with
      | zero => exact Or.inl (by simp)
      | succ k ih =>
        have hid : (τ_tilde j : L) ^ (k + 1) - (τ j) ^ (k + 1) =
            (τ_tilde j : L) ^ k * ((τ_tilde j : L) - τ j) +
              ((τ_tilde j : L) ^ k - (τ j) ^ k) * τ j := by
          rw [pow_succ, pow_succ]; ring
        rw [hid]
        have h1 := hval_mul_ge 0 (a + 1 : ℤ)
          ((τ_tilde j : L) ^ k) ((τ_tilde j : L) - τ j)
          (hval_pow_int (τ_tilde j : L) k (hτ_props j hj).1)
          (hTeich_1 j hj)
        rw [zero_add] at h1
        have h2 := hval_mul_ge (a + 1 : ℤ) 0
          ((τ_tilde j : L) ^ k - (τ j) ^ k) (τ j)
          ih (hτ_props j hj).2.2.1
        rw [add_zero] at h2
        exact hval_add (a + 1 : ℤ) _ _ h1 h2
    have hUj_δj : (1 + τ j * (δ : L)) * δ_err j = sum_tilde j := by
      dsimp [δ_err, U_j]
      rw [if_pos hj, mul_inv_cancel_left₀ (hτ_props j hj).2.2.2.1]
    rw [hUj_δj]
    have hdiff_eq : sum_tilde j -
        (∑ r ∈ Finset.Icc 1 (p - 1), (τ j) ^ r * s_u r) =
        ∑ r ∈ Finset.Icc 1 (p - 1),
          ((τ_tilde j : L) ^ r - (τ j) ^ r) * s_u r := by
      dsimp [sum_tilde]
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun r _ => by rw [sub_mul])
    rw [hdiff_eq]
    apply hval_finset_sum (Finset.Icc 1 (p - 1)) _ (a + 1 : ℤ)
    intro r hr
    have hs_int : s_u r = 0 ∨ 0 ≤ valL F L (s_u r) :=
      hval_mono (Nat.cast_nonneg m_1) (hs_u_val r hr)
    have hmul := hval_mul_ge (a + 1 : ℤ) 0
      ((τ_tilde j : L) ^ r - (τ j) ^ r) (s_u r)
      (hpow_diff r) hs_int
    rwa [add_zero] at hmul
  exact ⟨δ₀, δ_err, s_u, z₀, z, hs_u_val, hs_u_p1, hδ_err_val, hδ_err_b_half,
    hδ₀_a_half, hz₀_coe, hz₀_norm, hz_props, hδ₀_cong, hδ_err_cong⟩

theorem ld_wild_mid_cond_odd_prime_twist_prod_reduction (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hba : condExp F L ν₁ < condExp F L χ')
    (ha2b : condExp F L χ' < 2 * condExp F L ν₁)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (c_χ' c_ν₁ δ : Lˣ) (u_K u_corr c_K : Kˣ)
    (hc_χ'_val : valL F L (c_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_χ'_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ'⁻¹ : Lˣ) : L) * x))
    (hc_ν₁_val : valL F L (c_ν₁ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hc_ν₁_stat : ∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_ν₁⁻¹ : Lˣ) : L) * x))
    (hδ_eq : δ = c_χ' * c_ν₁⁻¹)
    (hδ_val : valL F L (δ : L) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hu_corr_eq : (u_corr : K) = 1 - IntermediateField.inclusion hLK (δ : L) * ((u_K⁻¹ : Kˣ) : K))
    (hc_K_eq : c_K = (Units.map (IntermediateField.inclusion hLK) c_χ') * u_corr⁻¹)
    (hrhs_twist : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ τ : L, (τ = 0 ∨ 0 ≤ valL F L τ) →
        (τ - (j : L) = 0 ∨
          ((((Module.finrank L (IntermediateField.extendScalars hLK) - 1) *
            condExp F L ν₁ /
            Module.finrank L (IntermediateField.extendScalars hLK) : ℕ) : ℤ) ≤
            valL F L (τ - (j : L)))) →
        ∃ u_τ : Lˣ,
          (u_τ : L) = 1 + τ * (δ : L) ∧
          tateEps F L (ν₁ ^ j * χ') ψ =
            (((ν₁ ^ j * χ') u_τ : Ω F)⁻¹) *
              ψ (((c_χ'⁻¹ : Lˣ) : L) * τ * (δ : L)) *
              tateEps F L χ' ψ)
    (δ₀ : L) (τ δ_err s_u : ℕ → L) (z₀ : Lˣ) (z : ℕ → Lˣ)
    (hτ_int : ∀ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
      (τ j = 0 ∨ 0 ≤ valL F L (τ j)) ∧
      1 + τ j * (δ : L) ≠ 0 ∧
      valL F L (1 + τ j * (δ : L)) = 0)
    (hτ_diff : ∀ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
      τ j - (j : L) = 0 ∨
        ((((Module.finrank L (IntermediateField.extendScalars hLK) - 1) *
          condExp F L ν₁ /
          Module.finrank L (IntermediateField.extendScalars hLK) : ℕ) : ℤ) ≤
          valL F L (τ j - (j : L))))
    (hTeich_4 : ∀ r ∈ Finset.Icc 1 (2 * (Module.finrank L (IntermediateField.extendScalars hLK) - 1)),
      (∑ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
        (τ j) ^ r) -
        (if (Module.finrank L (IntermediateField.extendScalars hLK) - 1) ∣ r then
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : L)
        else 0) = 0 ∨
        (condExp F L χ' + 1 : ℤ) ≤
          valL F L
            ((∑ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
                (τ j) ^ r) -
              (if (Module.finrank L (IntermediateField.extendScalars hLK) - 1) ∣ r then
                ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : L)
              else 0)))
    (hs_u_p1 : s_u (Module.finrank L (IntermediateField.extendScalars hLK) - 1) =
      (δ : L) * traceLM F hLK ((u_K⁻¹ : Kˣ) : K))
    (hδ_err_val : ∀ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
      δ_err j = 0 ∨
        ((((Module.finrank L (IntermediateField.extendScalars hLK) - 1) * condExp F L ν₁ +
          (condExp F L χ' - condExp F L ν₁)) /
          Module.finrank L (IntermediateField.extendScalars hLK) : ℕ) : ℤ) ≤ valL F L (δ_err j))
    (hδ_err_b_half : ∀ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
      δ_err j = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L (δ_err j))
    (hδ₀_a_half : δ₀ = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L δ₀)
    (hz₀_coe : (z₀ : L) = 1 + δ₀)
    (hz₀_norm : normLM F hLK (u_corr : K) =
      (∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
        (1 + τ j * (δ : L))) * (z₀ : L))
    (hz_props : ∀ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
      (z j : L) = 1 + δ_err j ∧
      ∃ w_j : Kˣ, normLM F hLK (w_j : K) = (1 + τ j * (δ : L)) * (z j : L)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    let a := condExp F L χ'
    let S' := (Finset.range p).erase 0
    (s_u (p - 1) + δ₀ + ∑ j ∈ S', τ j * (δ : L) * δ_err j = 0 ∨
      (a : ℤ) ≤ valL F L (s_u (p - 1) + δ₀ + ∑ j ∈ S', τ j * (δ : L) * δ_err j)) →
      ∀ (P_sq : Ω F),
        (tateEps F L χ' ψ) ^ p =
          P_sq *
            ((χ' c_χ' : Ω F) ^ p *
              (ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ p) →
        (∏ j ∈ Finset.range p, tateEps F L (ν₁ ^ j * χ') ψ) =
          P_sq *
            (((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) *
              (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K))) :=
by
  intro p a S' hX_val P_sq hEps_pow
  rcases hvalL_props with ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, _, hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩
  let K' := IntermediateField.extendScalars hLK
  set b : ℕ := condExp F L ν₁
  set n : ℤ := condExpChar F L ψ
  set m_p : ℕ := (p - 1) * b / p
  set m_1 : ℕ := ((p - 1) * b + (a - b)) / p
  set A : L := ((c_χ'⁻¹ : Lˣ) : L)
  set B : L := ((c_ν₁⁻¹ : Lˣ) : L)
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have h0_mem : 0 ∈ Finset.range p := Finset.mem_range.mpr hp_pos
  have hS'_card : S'.card = p - 1 := by
    dsimp [S']
    rw [Finset.card_erase_of_mem h0_mem, Finset.card_range]
  have hS'_mem : ∀ j ∈ S', j < p ∧ 0 < j := by
    intro j hj
    have hj_ne0 : j ≠ 0 := (Finset.mem_erase.mp hj).1
    have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    exact ⟨hj_lt, Nat.pos_of_ne_zero hj_ne0⟩
  have hb_le_mp_m1 : b ≤ m_p + m_1 := by
    have hdiv_p := Nat.div_add_mod ((p - 1) * b) p
    have hmod_p := Nat.mod_lt ((p - 1) * b) hp_pos
    have hdiv_1 := Nat.div_add_mod ((p - 1) * b + (a - b)) p
    have hmod_1 := Nat.mod_lt ((p - 1) * b + (a - b)) hp_pos
    have hmul_b : (p - 2) * 2 ≤ (p - 2) * b := Nat.mul_le_mul_left (p - 2) hb_ge2
    have hmul_lt : p * b < p * (m_p + m_1 + 1) := by
      dsimp [m_p, m_1]
      have h_expand : 2 * ((p - 1) * b) = p * b + (p - 2) * b := by
        have hp2 : 2 * (p - 1) = p + (p - 2) := by omega
        calc 2 * ((p - 1) * b) = (2 * (p - 1)) * b := (mul_assoc 2 (p - 1) b).symm
          _ = (p + (p - 2)) * b := by rw [hp2]
          _ = p * b + (p - 2) * b := add_mul p (p - 2) b
      have h_rhs : p * (((p - 1) * b) / p + ((p - 1) * b + (a - b)) / p + 1) =
          p * (((p - 1) * b) / p) + p * (((p - 1) * b + (a - b)) / p) + p := by ring
      omega
    have hlt : b < m_p + m_1 + 1 := Nat.lt_of_mul_lt_mul_left hmul_lt
    omega
  let P_L (k : ℤ) (x : L) : Prop := x = 0 ∨ k ≤ valL F L x
  have hPL_mono : ∀ {k₁ k₂ : ℤ} {x : L}, k₁ ≤ k₂ → P_L k₂ x → P_L k₁ x := by
    intro k₁ k₂ x hk hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hk hx)
  have hPL_neg : ∀ {k : ℤ} {x : L}, P_L k x → P_L k (-x) := by
    intro k x hx
    rcases hx with rfl | hx
    · exact Or.inl neg_zero
    · right; rw [hval_neg_L]; exact hx
  have hPL_add : ∀ {k : ℤ} {x₁ x₂ : L}, P_L k x₁ → P_L k x₂ → P_L k (x₁ + x₂) :=
    fun hx₁ hx₂ => hval_add_L _ _ _ hx₁ hx₂
  have hPL_mul : ∀ {k₁ k₂ : ℤ} {x₁ x₂ : L}, P_L k₁ x₁ → P_L k₂ x₂ → P_L (k₁ + k₂) (x₁ * x₂) := by
    intro k₁ k₂ x₁ x₂ hx₁ hx₂
    by_cases hx10 : x₁ = 0
    · exact Or.inl (by rw [hx10, zero_mul])
    · by_cases hx20 : x₂ = 0
      · exact Or.inl (by rw [hx20, mul_zero])
      · right
        rw [hval_mul_L x₁ x₂ hx10 hx20]
        have h1 := hx₁.resolve_left hx10
        have h2 := hx₂.resolve_left hx20
        omega
  have hψ_triv : ∀ {x : L}, P_L (-n) x → ψ x = 1 :=
    fun hx => (hSpecL 1).1 _ hx
  have hψ_congr : ∀ {x₁ x₂ : L}, P_L (-n) (x₁ - x₂) → ψ x₁ = ψ x₂ := by
    intro x₁ x₂ hdiff
    have h1 : ψ (x₁ - x₂) = 1 := hψ_triv hdiff
    calc ψ x₁ = ψ ((x₁ - x₂) + x₂) := by rw [sub_add_cancel]
      _ = ψ (x₁ - x₂) * ψ x₂ := ψ.map_add_eq_mul _ _
      _ = ψ x₂ := by rw [h1, one_mul]
  have hA_val : valL F L A = -((a : ℤ) + n) := by
    dsimp [A, a, n]
    rw [hval_inv_L c_χ', hc_χ'_val]
  have hA_PL : P_L (-((a : ℤ) + n)) A := Or.inr (le_of_eq hA_val.symm)
  have hB_val : valL F L B = -((b : ℤ) + n) := by
    dsimp [B, b, n]
    rw [hval_inv_L c_ν₁, hc_ν₁_val]
  have hB_PL : P_L (-((b : ℤ) + n)) B := Or.inr (le_of_eq hB_val.symm)
  have hδ_PL : P_L ((a - b : ℕ) : ℤ) (δ : L) := Or.inr (le_of_eq hδ_val.symm)
  have hB_eq_Aδ : B = A * (δ : L) := by
    have h : c_ν₁⁻¹ = c_χ'⁻¹ * δ := by rw [hδ_eq, inv_mul_cancel_left]
    exact congrArg Units.val h
  have hto_inc : ∀ x : L,
      toExtendScalars F hLK (IntermediateField.inclusion hLK x) = algebraMap L K' x :=
    fun _ => rfl
  have htrace_incl : ∀ x : L,
      traceLM F hLK (IntermediateField.inclusion hLK x) = (p : L) * x := by
    intro x
    change Algebra.trace L K' (toExtendScalars F hLK (IntermediateField.inclusion hLK x)) =
      (Module.finrank L K' : L) * x
    rw [hto_inc x, Algebra.trace_algebraMap, nsmul_eq_mul]
  have htrace_smul : ∀ (x : L) (y : K),
      traceLM F hLK (IntermediateField.inclusion hLK x * y) = x * traceLM F hLK y := by
    intro x y
    letI : Module L L := Semiring.toModule
    change Algebra.trace L K' (toExtendScalars F hLK (IntermediateField.inclusion hLK x * y)) =
      x * Algebra.trace L K' (toExtendScalars F hLK y)
    rw [map_mul, hto_inc x, ← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]
  have hnorm_incl : ∀ x : L,
      normLM F hLK (IntermediateField.inclusion hLK x) = x ^ p := by
    intro x
    change Algebra.norm L (toExtendScalars F hLK (IntermediateField.inclusion hLK x)) =
      x ^ Module.finrank L K'
    rw [hto_inc x, Algebra.norm_algebraMap]
  have hψ_sum : ∀ (T : Finset ℕ) (f : ℕ → L),
      ψ (∑ j ∈ T, f j) = ∏ j ∈ T, ψ (f j) := by
    intro T f
    induction T using Finset.induction_on with
    | empty => simp [AddChar.map_zero_eq_one]
    | @insert j T hj ih =>
      rw [Finset.sum_insert hj, AddChar.map_add_eq_mul, ih, Finset.prod_insert hj]
  have hψ_nat_mul : ∀ (m : ℕ) (x : L), ψ ((m : L) * x) = (ψ x) ^ m := by
    intro m x
    induction m with
    | zero => simp [AddChar.map_zero_eq_one]
    | succ m ih =>
      rw [Nat.cast_add, Nat.cast_one, add_mul, one_mul, AddChar.map_add_eq_mul,
        ih, pow_succ]
  let u_τ : ℕ → Lˣ := fun j =>
    if hj : j ∈ S' then Units.mk0 (1 + τ j * (δ : L)) (hτ_int j hj).2.1 else 1
  have hu_τ_coe : ∀ j ∈ S', (u_τ j : L) = 1 + τ j * (δ : L) := by
    intro j hj
    dsimp [u_τ]
    rw [dif_pos hj, Units.val_mk0]
  have hEps_S' : ∀ j ∈ S',
      tateEps F L (ν₁ ^ j * χ') ψ =
        (χ' (u_τ j) : Ω F)⁻¹ *
          ((ν₁ ^ j) (u_τ j) : Ω F)⁻¹ *
          ψ (A * τ j * (δ : L)) *
          tateEps F L χ' ψ := by
    intro j hj
    obtain ⟨hj_lt, _⟩ := hS'_mem j hj
    obtain ⟨u_τ', hu_τ'_coe, hu_τ'_eps⟩ :=
      hrhs_twist j hj_lt (τ j) (hτ_int j hj).1 (hτ_diff j hj)
    have hu_eq : u_τ' = u_τ j := by
      apply Units.ext
      rw [hu_τ'_coe, hu_τ_coe j hj]
    rw [hu_eq] at hu_τ'_eps
    have hmul : (((ν₁ ^ j * χ') (u_τ j) : Ω F)⁻¹) =
        (χ' (u_τ j) : Ω F)⁻¹ * ((ν₁ ^ j) (u_τ j) : Ω F)⁻¹ := by
      rw [MonoidHom.mul_apply, Units.val_mul, mul_inv, mul_comm]
    rw [hu_τ'_eps, hmul]
  have hEps_prod_split :
      (∏ j ∈ Finset.range p, tateEps F L (ν₁ ^ j * χ') ψ) =
        (tateEps F L χ' ψ) ^ p *
          (∏ j ∈ S', (χ' (u_τ j) : Ω F)⁻¹) *
          (∏ j ∈ S', ((ν₁ ^ j) (u_τ j) : Ω F)⁻¹) *
          (∏ j ∈ S', ψ (A * τ j * (δ : L))) := by
    have h0 : tateEps F L (ν₁ ^ 0 * χ') ψ = tateEps F L χ' ψ := by
      rw [pow_zero, one_mul]
    rw [← Finset.mul_prod_erase (Finset.range p) (fun j => tateEps F L (ν₁ ^ j * χ') ψ) h0_mem]
    change tateEps F L (ν₁ ^ 0 * χ') ψ * (∏ j ∈ S', tateEps F L (ν₁ ^ j * χ') ψ) = _
    rw [h0, Finset.prod_congr rfl hEps_S', Finset.prod_mul_distrib,
      Finset.prod_mul_distrib, Finset.prod_mul_distrib, Finset.prod_const, hS'_card]
    have hp_pow : tateEps F L χ' ψ * (tateEps F L χ' ψ) ^ (p - 1) = (tateEps F L χ' ψ) ^ p := by
      conv_rhs => rw [← Nat.sub_add_cancel hp_pos, pow_add, pow_one, mul_comm]
    calc tateEps F L χ' ψ *
          ((((∏ x ∈ S', (χ' (u_τ x) : Ω F)⁻¹) * ∏ x ∈ S', ((ν₁ ^ x) (u_τ x) : Ω F)⁻¹) *
            ∏ x ∈ S', ψ (A * τ x * (δ : L))) *
            (tateEps F L χ' ψ) ^ (p - 1))
      _ = (tateEps F L χ' ψ * (tateEps F L χ' ψ) ^ (p - 1)) *
            (∏ j ∈ S', (χ' (u_τ j) : Ω F)⁻¹) *
            (∏ j ∈ S', ((ν₁ ^ j) (u_τ j) : Ω F)⁻¹) *
            (∏ j ∈ S', ψ (A * τ j * (δ : L))) := by ring
      _ = (tateEps F L χ' ψ) ^ p *
            (∏ j ∈ S', (χ' (u_τ j) : Ω F)⁻¹) *
            (∏ j ∈ S', ((ν₁ ^ j) (u_τ j) : Ω F)⁻¹) *
            (∏ j ∈ S', ψ (A * τ j * (δ : L))) := by rw [hp_pow]
  have hsum_τ_PL : P_L (a + 1 : ℤ) (∑ j ∈ S', τ j) := by
    have h1_mem : 1 ∈ Finset.Icc 1 (2 * (p - 1)) :=
      Finset.mem_Icc.mpr ⟨le_rfl, by omega⟩
    have hnot_dvd : ¬ ((p - 1) ∣ 1) :=
      Nat.not_dvd_of_pos_of_lt Nat.zero_lt_one (by omega)
    have hT1 := hTeich_4 1 h1_mem
    change P_L (a + 1 : ℤ)
      ((∑ j ∈ S', (τ j) ^ 1) - (if (p - 1) ∣ 1 then ((p - 1 : ℕ) : L) else 0)) at hT1
    have hpow1 : (∑ j ∈ S', (τ j) ^ 1) = ∑ j ∈ S', τ j :=
      Finset.sum_congr rfl (fun _ _ => pow_one _)
    rw [hpow1, if_neg hnot_dvd, sub_zero] at hT1
    exact hT1
  have hψ_τ_prod : (∏ j ∈ S', ψ (A * τ j * (δ : L))) = 1 := by
    rw [← hψ_sum]
    have hsum_eq : (∑ j ∈ S', A * τ j * (δ : L)) =
        A * (δ : L) * (∑ j ∈ S', τ j) := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun _ _ => by ring)
    rw [hsum_eq]
    apply hψ_triv
    have hprod := hPL_mul (hPL_mul hA_PL hδ_PL) hsum_τ_PL
    exact hPL_mono (by omega) hprod
  have hν_uτ_j : ∀ j ∈ S',
      ((ν₁ ^ j) (u_τ j) : Ω F)⁻¹ = ψ (A * (τ j * (δ : L) * δ_err j)) := by
    intro j hj
    obtain ⟨hz_coe, w_j, hw_j⟩ := hz_props j hj
    have hnorm_wj : Units.map (normLM F hLK) w_j = u_τ j * z j := by
      apply Units.ext
      rw [Units.coe_map, hw_j, Units.val_mul, hu_τ_coe j hj]
    have hν₁_uz : ν₁ (u_τ j * z j) = 1 :=
      (hν₁_ker (u_τ j * z j)).mp ⟨w_j, hnorm_wj⟩
    have hνj_mul : (ν₁ ^ j) (u_τ j) * (ν₁ ^ j) (z j) = 1 := by
      rw [← map_mul, MonoidHom.pow_apply, hν₁_uz, one_pow]
    have hνj_inv : ((ν₁ ^ j) (u_τ j))⁻¹ = (ν₁ ^ j) (z j) :=
      (eq_inv_of_mul_eq_one_right hνj_mul).symm
    have hνj_inv_coe : ((ν₁ ^ j) (u_τ j) : Ω F)⁻¹ = ((ν₁ ^ j) (z j) : Ω F) := by
      rw [← Units.val_inv_eq_inv_val, hνj_inv]
    have hxj : 1 + δ_err j ≠ 0 := by
      rw [← hz_coe]; exact Units.ne_zero (z j)
    have hmk0 : Units.mk0 (1 + δ_err j) hxj = z j := by
      apply Units.ext; exact hz_coe.symm
    have hstat := hc_ν₁_stat (δ_err j) (hδ_err_b_half j hj) hxj
    rw [hmk0] at hstat
    have hνj_zj : ((ν₁ ^ j) (z j) : Ω F) = ψ ((j : L) * (B * δ_err j)) := by
      rw [MonoidHom.pow_apply, Units.val_pow_eq_pow_val, hstat, ← hψ_nat_mul j (B * δ_err j)]
    rw [hνj_inv_coe, hνj_zj]
    apply hψ_congr
    have hdiff_eq : (j : L) * (B * δ_err j) - A * (τ j * (δ : L) * δ_err j) =
        -(B * (τ j - (j : L)) * δ_err j) := by
      rw [hB_eq_Aδ]; ring
    rw [hdiff_eq]
    apply hPL_neg
    have hprod := hPL_mul (hPL_mul hB_PL (hτ_diff j hj)) (hδ_err_val j hj)
    exact hPL_mono (by omega) hprod
  have hν_uτ_prod :
      (∏ j ∈ S', ((ν₁ ^ j) (u_τ j) : Ω F)⁻¹) =
        ψ (A * ∑ j ∈ S', τ j * (δ : L) * δ_err j) := by
    rw [Finset.prod_congr rfl hν_uτ_j, ← hψ_sum, ← Finset.mul_sum]
  have hχ'_z₀ : (χ' z₀ : Ω F) = ψ (A * δ₀) := by
    have hx₀ : 1 + δ₀ ≠ 0 := by
      rw [← hz₀_coe]; exact Units.ne_zero z₀
    have hmk0 : Units.mk0 (1 + δ₀) hx₀ = z₀ := by
      apply Units.ext; exact hz₀_coe.symm
    have hstat := hc_χ'_stat δ₀ hδ₀_a_half hx₀
    rw [hmk0] at hstat
    exact hstat
  have hu_corr_norm :
      Units.map (normLM F hLK) u_corr = (∏ j ∈ S', u_τ j) * z₀ := by
    apply Units.ext
    rw [Units.coe_map, hz₀_norm, Units.val_mul, Units.coe_prod,
      Finset.prod_congr rfl hu_τ_coe]
  have hc_χ'_incl_norm :
      Units.map (normLM F hLK) (Units.map (IntermediateField.inclusion hLK) c_χ') =
        c_χ' ^ p := by
    apply Units.ext
    change normLM F hLK (IntermediateField.inclusion hLK (c_χ' : L)) = ((c_χ' ^ p : Lˣ) : L)
    rw [hnorm_incl (c_χ' : L), Units.val_pow_eq_pow_val]
  have hc_K_norm_z₀ :
      Units.map (normLM F hLK) c_K * z₀ = c_χ' ^ p * (∏ j ∈ S', (u_τ j)⁻¹) := by
    rw [hc_K_eq, map_mul, hc_χ'_incl_norm, map_inv, hu_corr_norm,
      mul_inv, ← Finset.prod_inv_distrib, ← mul_assoc (c_χ' ^ p), inv_mul_cancel_right]
  have hχ'_cK :
      (χ' c_χ' : Ω F) ^ p * (∏ j ∈ S', (χ' (u_τ j) : Ω F)⁻¹) =
        ((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) * ψ (A * δ₀) := by
    have h1 := congrArg (fun u : Lˣ => (χ' u : Ω F)) hc_K_norm_z₀.symm
    dsimp only at h1
    have hprod_inv :
        (∏ j ∈ S', (χ' ((u_τ j)⁻¹) : Ω F)) = ∏ j ∈ S', (χ' (u_τ j) : Ω F)⁻¹ := by
      refine Finset.prod_congr rfl (fun j _ => ?_)
      rw [map_inv, Units.val_inv_eq_inv_val]
    rw [map_mul, Units.val_mul, map_pow, Units.val_pow_eq_pow_val, map_prod,
      Units.coe_prod, hprod_inv, map_mul, Units.val_mul, hχ'_z₀] at h1
    exact h1
  have hc_K_inv_coe :
      ((c_K⁻¹ : Kˣ) : K) = IntermediateField.inclusion hLK A * (u_corr : K) := by
    have h : c_K⁻¹ = (Units.map (IntermediateField.inclusion hLK) c_χ'⁻¹) * u_corr := by
      rw [hc_K_eq, mul_inv_rev, inv_inv, ← map_inv, mul_comm]
    exact congrArg Units.val h
  have htr_cK_inv :
      traceLM F hLK ((c_K⁻¹ : Kˣ) : K) + A * s_u (p - 1) = (p : L) * A := by
    have h1_eq : (1 : K) = IntermediateField.inclusion hLK 1 := (map_one _).symm
    have htr_ucorr : traceLM F hLK (u_corr : K) = (p : L) - s_u (p - 1) := by
      rw [hu_corr_eq, map_sub, htrace_smul (δ : L) ((u_K⁻¹ : Kˣ) : K), ← hs_u_p1]
      conv_lhs => enter [1]; rw [h1_eq, htrace_incl 1, mul_one]
    rw [hc_K_inv_coe, htrace_smul A (u_corr : K), htr_ucorr]
    ring
  have htrChar_cK :
      (ψ A) ^ p =
        (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K)) * ψ (A * s_u (p - 1)) := by
    rw [← hψ_nat_mul p A, ← htr_cK_inv, AddChar.map_add_eq_mul]
    rfl
  set X : L := s_u (p - 1) + δ₀ + ∑ j ∈ S', τ j * (δ : L) * δ_err j
  have hAX_PL : P_L (-n) (A * X) := by
    have hprod := hPL_mul hA_PL hX_val
    exact hPL_mono (by omega) hprod
  have hψ_AX :
      ψ (A * s_u (p - 1)) * ψ (A * δ₀) * ψ (A * ∑ j ∈ S', τ j * (δ : L) * δ_err j) = 1 := by
    have h1 : ψ (A * X) = 1 := hψ_triv hAX_PL
    have h_exp : A * X =
        A * s_u (p - 1) + A * δ₀ + A * ∑ j ∈ S', τ j * (δ : L) * δ_err j := by
      dsimp [X]; ring
    rw [h_exp, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul] at h1
    exact h1
  rw [hEps_prod_split, hEps_pow, hψ_τ_prod, mul_one, hν_uτ_prod]
  calc P_sq * ((χ' c_χ' : Ω F) ^ p * (ψ A) ^ p) *
        (∏ j ∈ S', (χ' (u_τ j) : Ω F)⁻¹) *
        ψ (A * ∑ j ∈ S', τ j * (δ : L) * δ_err j)
    _ = P_sq *
          (((χ' c_χ' : Ω F) ^ p * (∏ j ∈ S', (χ' (u_τ j) : Ω F)⁻¹)) *
            (ψ A) ^ p *
            ψ (A * ∑ j ∈ S', τ j * (δ : L) * δ_err j)) := by ring
    _ = P_sq *
          ((((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) * ψ (A * δ₀)) *
            ((traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K)) * ψ (A * s_u (p - 1))) *
            ψ (A * ∑ j ∈ S', τ j * (δ : L) * δ_err j)) := by
      rw [hχ'_cK, htrChar_cK]
    _ = P_sq *
          (((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) *
            (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K))) *
          (ψ (A * s_u (p - 1)) * ψ (A * δ₀) *
            ψ (A * ∑ j ∈ S', τ j * (δ : L) * δ_err j)) := by ring
    _ = P_sq *
          (((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) *
            (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K))) * 1 := by rw [hψ_AX]
    _ = P_sq *
          (((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) *
            (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K))) := mul_one _

theorem ld_wild_mid_cond_odd_prime_teichmuller_and_units (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hunit_pow_p : ∀ (m : ℕ), 1 ≤ m → ∀ u ∈ unitGroup F L m,
      u ^ (Module.finrank L (IntermediateField.extendScalars hLK)) ∈ unitGroup F L (m + 1))
    (hba : condExp F L ν₁ < condExp F L χ')
    (ha2b : condExp F L χ' < 2 * condExp F L ν₁)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (t : ℕ) (hb_eq : condExp F L ν₁ = t + 1)
    (hp_val : ((Module.finrank L (IntermediateField.extendScalars hLK) : L) = 0 ∨
      ((((Module.finrank L (IntermediateField.extendScalars hLK) - 1) * condExp F L ν₁ /
        Module.finrank L (IntermediateField.extendScalars hLK) : ℕ) : ℤ) ≤
        valL F L (Module.finrank L (IntermediateField.extendScalars hLK) : L))))
    (hp_val1 : (Module.finrank L (IntermediateField.extendScalars hLK) : L) = 0 ∨
      (1 : ℤ) ≤ valL F L (Module.finrank L (IntermediateField.extendScalars hLK) : L))
    (c_χ' c_ν₁ δ : Lˣ) (u_K u_corr c_K : Kˣ)
    (hc_χ'_val : valL F L (c_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_χ'_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ'⁻¹ : Lˣ) : L) * x))
    (hc_ν₁_val : valL F L (c_ν₁ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hc_ν₁_stat : ∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_ν₁⁻¹ : Lˣ) : L) * x))
    (hδ_eq : δ = c_χ' * c_ν₁⁻¹)
    (hu_K_norm : Units.map (normLM F hLK) u_K = δ)
    (hu_K_val : valL F K (u_K : K) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hδ_val : valL F L (δ : L) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hu_corr_eq : (u_corr : K) = 1 - IntermediateField.inclusion hLK (δ : L) * ((u_K⁻¹ : Kˣ) : K))
    (hc_K_eq : c_K = (Units.map (IntermediateField.inclusion hLK) c_χ') * u_corr⁻¹)
    (hrhs_twist : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ τ : L, (τ = 0 ∨ 0 ≤ valL F L τ) →
        (τ - (j : L) = 0 ∨
          ((((Module.finrank L (IntermediateField.extendScalars hLK) - 1) *
            condExp F L ν₁ /
            Module.finrank L (IntermediateField.extendScalars hLK) : ℕ) : ℤ) ≤
            valL F L (τ - (j : L)))) →
        ∃ u_τ : Lˣ,
          (u_τ : L) = 1 + τ * (δ : L) ∧
          tateEps F L (ν₁ ^ j * χ') ψ =
            (((ν₁ ^ j * χ') u_τ : Ω F)⁻¹) *
              ψ (((c_χ'⁻¹ : Lˣ) : L) * τ * (δ : L)) *
              tateEps F L χ' ψ)
    (s : K → ℕ → L)
    (hsp1 : ∀ y : K, y ≠ 0 →
      s y (Module.finrank L (IntermediateField.extendScalars hLK) - 1) =
        normLM F hLK y * traceLM F hLK (y⁻¹))
    (hs_val : ∀ (y : K) (r : ℕ),
      r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1) →
      ∀ (q m : ℤ), (y = 0 ∨ q ≤ valL F K y) →
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ (r : ℤ) * q →
        (s y r = 0 ∨ m ≤ valL F L (s y r)))
    (hs_poly : ∀ (y : K) (c : L),
      normLM F hLK (1 + IntermediateField.inclusion hLK c * y) =
        1 +
          (∑ r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1),
            c ^ r * s y r) +
          c ^ (Module.finrank L (IntermediateField.extendScalars hLK)) * normLM F hLK y)
    (hTeich : ∀ (N : L), (N = 0 ∨ 0 ≤ valL F L N) →
      ∀ (τ_unit τ_tilde : ℕ → Lˣ),
        (∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
          (τ_tilde j : L) =
            (j : L) ^ ((Module.finrank L (IntermediateField.extendScalars hLK)) ^ (condExp F L χ')) ∧
          τ_unit j = (τ_tilde j) ^ (Module.finrank L (IntermediateField.extendScalars hLK))) →
        (∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
          (τ_tilde j : L) - (τ_unit j : L) = 0 ∨
            (condExp F L χ' + 1 : ℤ) ≤ valL F L ((τ_tilde j : L) - (τ_unit j : L))) ∧
        (∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
          (τ_unit j : L) ^ (Module.finrank L (IntermediateField.extendScalars hLK) - 1) - 1 = 0 ∨
            (condExp F L χ' + 1 : ℤ) ≤
              valL F L
                ((τ_unit j : L) ^ (Module.finrank L (IntermediateField.extendScalars hLK) - 1) - 1)) ∧
        ((∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
            (N + (τ_unit j : L))) -
          (N ^ (Module.finrank L (IntermediateField.extendScalars hLK) - 1) - 1) = 0 ∨
          (condExp F L χ' + 1 : ℤ) ≤
            valL F L
              ((∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
                  (N + (τ_unit j : L))) -
                (N ^ (Module.finrank L (IntermediateField.extendScalars hLK) - 1) - 1))) ∧
        (∀ r ∈ Finset.Icc 1 (2 * (Module.finrank L (IntermediateField.extendScalars hLK) - 1)),
          (∑ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
            (τ_unit j : L) ^ r) -
            (if (Module.finrank L (IntermediateField.extendScalars hLK) - 1) ∣ r then
              ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : L)
            else 0) = 0 ∨
            (condExp F L χ' + 1 : ℤ) ≤
              valL F L
                ((∑ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
                    (τ_unit j : L) ^ r) -
                  (if (Module.finrank L (IntermediateField.extendScalars hLK) - 1) ∣ r then
                    ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : L)
                  else 0)))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    let b := condExp F L ν₁
    let a := condExp F L χ'
    let S' := (Finset.range p).erase 0
    let m_1 := ((p - 1) * b + (a - b)) / p
    ∃ (δ₀ : L) (τ δ_err s_u : ℕ → L),
      (∀ j ∈ S',
        (τ j = 0 ∨ 0 ≤ valL F L (τ j)) ∧
        1 + τ j * (δ : L) ≠ 0 ∧
        valL F L (1 + τ j * (δ : L)) = 0) ∧
      (∀ r ∈ Finset.Icc 1 (p - 1),
        s_u r = 0 ∨ (m_1 : ℤ) ≤ valL F L (s_u r)) ∧
      (∀ j ∈ S',
        δ_err j = 0 ∨ (m_1 : ℤ) ≤ valL F L (δ_err j)) ∧
      ((1 - (δ : L) ^ (p - 1)) * δ₀ +
        (∑ r ∈ Finset.Icc 1 (p - 1), (-1 : L) ^ r * (δ : L) ^ (p - 1 - r) * s_u r) = 0 ∨
        (a + 1 : ℤ) ≤
          valL F L
            ((1 - (δ : L) ^ (p - 1)) * δ₀ +
              (∑ r ∈ Finset.Icc 1 (p - 1), (-1 : L) ^ r * (δ : L) ^ (p - 1 - r) * s_u r))) ∧
      (∀ j ∈ S',
        (1 + τ j * (δ : L)) * δ_err j -
          (∑ r ∈ Finset.Icc 1 (p - 1), (τ j) ^ r * s_u r) = 0 ∨
          (a + 1 : ℤ) ≤
            valL F L
              ((1 + τ j * (δ : L)) * δ_err j -
                (∑ r ∈ Finset.Icc 1 (p - 1), (τ j) ^ r * s_u r))) ∧
      (∀ j ∈ S',
        (τ j) ^ (p - 1) - 1 = 0 ∨ (a + 1 : ℤ) ≤ valL F L ((τ j) ^ (p - 1) - 1)) ∧
      ((∏ j ∈ S', (1 + τ j * (δ : L))) - (1 - (δ : L) ^ (p - 1)) = 0 ∨
        (a + 1 : ℤ) ≤
          valL F L ((∏ j ∈ S', (1 + τ j * (δ : L))) - (1 - (δ : L) ^ (p - 1)))) ∧
      (∀ r ∈ Finset.Icc 1 (2 * (p - 1)),
        (∑ j ∈ S', (τ j) ^ r) -
          (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0) = 0 ∨
          (a + 1 : ℤ) ≤
            valL F L
              ((∑ j ∈ S', (τ j) ^ r) -
                (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0))) ∧
      ((s_u (p - 1) + δ₀ + ∑ j ∈ S', τ j * (δ : L) * δ_err j = 0 ∨
        (a : ℤ) ≤ valL F L (s_u (p - 1) + δ₀ + ∑ j ∈ S', τ j * (δ : L) * δ_err j)) →
        ∀ (P_sq : Ω F),
          (tateEps F L χ' ψ) ^ p =
            P_sq *
              ((χ' c_χ' : Ω F) ^ p *
                (ψ (((c_χ'⁻¹ : Lˣ) : L))) ^ p) →
          (∏ j ∈ Finset.range p, tateEps F L (ν₁ ^ j * χ') ψ) =
            P_sq *
              (((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) *
                (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K)))) :=
by
  intro p b a S' m_1
  obtain ⟨τ_tilde, τ, hτ_props, hτ_diff, hTeich_1, hTeich_2, hTeich_3_inv, hTeich_4⟩ :=
    ld_wild_mid_cond_odd_prime_teichmuller_inv_prod F L p b a hPrime hp_odd hb_ge2 hba
      hunit_pow_p hvalL_props k_L resL hresL_0 hresL_1 hresL_ring hresL_ker
      hp_val hp_val1 (δ : L) hδ_val hTeich
  have hτ_int : ∀ j ∈ S',
      (τ j = 0 ∨ 0 ≤ valL F L (τ j)) ∧
      1 + τ j * (δ : L) ≠ 0 ∧
      valL F L (1 + τ j * (δ : L)) = 0 :=
    fun j hj => (hτ_props j hj).2.2
  obtain ⟨δ₀, δ_err, s_u, z₀, z, hs_u_val, hs_u_p1, hδ_err_val, hδ_err_b_half,
    hδ₀_a_half, hz₀_coe, hz₀_norm, hz_props, hδ₀_cong, hδ_err_cong⟩ :=
    ld_wild_mid_cond_odd_prime_correction_units F L K hLK hPrime hp_odd b a t
      hb_ge2 hba ha2b hb_eq hvalL_props δ u_K u_corr hu_K_norm hu_K_val hδ_val
      hu_corr_eq s hsp1 hs_val hs_poly τ_tilde τ hτ_props hTeich_1 hTeich_3_inv
  have hRed :=
    ld_wild_mid_cond_odd_prime_twist_prod_reduction F L K hLK hPrime hp_odd ψ ν₁ χ'
      hν₁_ker hb_ge2 hba ha2b hvalL_props hSpecL c_χ' c_ν₁ δ u_K u_corr c_K
      hc_χ'_val hc_χ'_stat hc_ν₁_val hc_ν₁_stat hδ_eq hδ_val hu_corr_eq hc_K_eq
      hrhs_twist δ₀ τ δ_err s_u z₀ z hτ_int hτ_diff hTeich_4 hs_u_p1
      hδ_err_val hδ_err_b_half hδ₀_a_half hz₀_coe hz₀_norm hz_props
  exact ⟨δ₀, τ, δ_err, s_u, hτ_int, hs_u_val, hδ_err_val, hδ₀_cong, hδ_err_cong,
    hTeich_2, hTeich_3_inv, hTeich_4, hRed⟩

theorem ld_wild_mid_cond_odd_prime_error_cancellation (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (p b a : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (hb_ge2 : 2 ≤ b) (hba : b < a) (ha2b : a < 2 * b)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hp_val : (p : L) = 0 ∨ (((p - 1) * b / p : ℕ) : ℤ) ≤ valL F L (p : L))
    (δ_L δ₀ : L) (τ δ_err s_u : ℕ → L)
    (hδL_val : valL F L δ_L = ((a - b : ℕ) : ℤ))
    (hτ_int : ∀ j ∈ (Finset.range p).erase 0,
      (τ j = 0 ∨ 0 ≤ valL F L (τ j)) ∧
      1 + τ j * δ_L ≠ 0 ∧
      valL F L (1 + τ j * δ_L) = 0)
    (hs_u_val : ∀ r ∈ Finset.Icc 1 (p - 1),
      s_u r = 0 ∨ ((((p - 1) * b + (a - b)) / p : ℕ) : ℤ) ≤ valL F L (s_u r))
    (hδ_err_val : ∀ j ∈ (Finset.range p).erase 0,
      δ_err j = 0 ∨ ((((p - 1) * b + (a - b)) / p : ℕ) : ℤ) ≤ valL F L (δ_err j))
    (hδ₀_cong : (1 - δ_L ^ (p - 1)) * δ₀ +
      (∑ r ∈ Finset.Icc 1 (p - 1), (-1 : L) ^ r * δ_L ^ (p - 1 - r) * s_u r) = 0 ∨
      (a + 1 : ℤ) ≤
        valL F L
          ((1 - δ_L ^ (p - 1)) * δ₀ +
            (∑ r ∈ Finset.Icc 1 (p - 1), (-1 : L) ^ r * δ_L ^ (p - 1 - r) * s_u r)))
    (hδ_err_cong : ∀ j ∈ (Finset.range p).erase 0,
      (1 + τ j * δ_L) * δ_err j -
        (∑ r ∈ Finset.Icc 1 (p - 1), (τ j) ^ r * s_u r) = 0 ∨
        (a + 1 : ℤ) ≤
          valL F L
            ((1 + τ j * δ_L) * δ_err j -
              (∑ r ∈ Finset.Icc 1 (p - 1), (τ j) ^ r * s_u r)))
    (hTeich_2 : ∀ j ∈ (Finset.range p).erase 0,
      (τ j) ^ (p - 1) - 1 = 0 ∨ (a + 1 : ℤ) ≤ valL F L ((τ j) ^ (p - 1) - 1))
    (hTeich_3_inv : (∏ j ∈ (Finset.range p).erase 0, (1 + τ j * δ_L)) -
      (1 - δ_L ^ (p - 1)) = 0 ∨
      (a + 1 : ℤ) ≤
        valL F L
          ((∏ j ∈ (Finset.range p).erase 0, (1 + τ j * δ_L)) - (1 - δ_L ^ (p - 1))))
    (hTeich_4 : ∀ r ∈ Finset.Icc 1 (2 * (p - 1)),
      (∑ j ∈ (Finset.range p).erase 0, (τ j) ^ r) -
        (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0) = 0 ∨
        (a + 1 : ℤ) ≤
          valL F L
            ((∑ j ∈ (Finset.range p).erase 0, (τ j) ^ r) -
              (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0))) :
    let S' := (Finset.range p).erase 0
    let X := s_u (p - 1) + δ₀ + ∑ j ∈ S', τ j * δ_L * δ_err j
    X = 0 ∨ (a : ℤ) ≤ valL F L X :=
by
  intro S' X
  let m_p : ℕ := (p - 1) * b / p
  let m_1 : ℕ := ((p - 1) * b + (a - b)) / p
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_odd_prop : Odd p := hPrime.odd_of_ne_two hp_odd
  have hp_ge3 : 3 ≤ p := by
    rcases hp_odd_prop with ⟨k, hk⟩
    omega
  have hp1_even : Even (p - 1) := Odd.tsub_odd hp_odd_prop odd_one
  have hp2_odd : Odd (p - 2) := by
    rcases hp_odd_prop with ⟨k, hk⟩
    exact ⟨k - 1, by omega⟩
  have hb_half_pos : 1 ≤ (b + 1) / 2 := by omega
  have hb_half_le_mp : (b + 1) / 2 ≤ m_p := by
    dsimp [m_p]
    rw [Nat.le_div_iff_mul_le hp_pos]
    have hdiv2 : 2 * ((b + 1) / 2) ≤ b + 1 := Nat.mul_div_le (b + 1) 2
    have hp_sub : p - 1 + 1 = p := Nat.sub_add_cancel hp_pos
    nlinarith
  have hb_half_le_m1 : (b + 1) / 2 ≤ m_1 := by
    dsimp [m_1]
    rw [Nat.le_div_iff_mul_le hp_pos]
    have hdiv2 : 2 * ((b + 1) / 2) ≤ b + 1 := Nat.mul_div_le (b + 1) 2
    have hp_sub : p - 1 + 1 = p := Nat.sub_add_cancel hp_pos
    nlinarith
  have hm1_ge1 : 1 ≤ m_1 := le_trans hb_half_pos hb_half_le_m1
  have ha_le_sum : (a : ℤ) ≤ (m_p : ℤ) + (((a - b : ℕ) : ℤ) + (m_1 : ℤ)) := by
    have h1 : b ≤ 2 * ((b + 1) / 2) := by omega
    have h2 : a ≤ m_p + ((a - b) + m_1) := by omega
    exact_mod_cast h2
  rcases hvalL_props with ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul,
    hval_inv, _, hval_add, hunit0, hunit_ge1, hunit_val0⟩
  have hval_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        rw [hval_mul x y hx0 hy0]
        have h1 := hx.resolve_left hx0
        have h2 := hy.resolve_left hy0
        omega
  have hval_neg_iff : ∀ (k : ℤ) (x : L),
      (x = 0 ∨ k ≤ valL F L x) → (-x = 0 ∨ k ≤ valL F L (-x)) := by
    intro k x hx
    rcases hx with rfl | hge
    · exact Or.inl neg_zero
    · exact Or.inr (by rw [hval_neg]; exact hge)
  have hval_sub : ∀ (k : ℤ) (x₁ x₂ : L),
      (x₁ = 0 ∨ k ≤ valL F L x₁) → (x₂ = 0 ∨ k ≤ valL F L x₂) →
        (x₁ - x₂ = 0 ∨ k ≤ valL F L (x₁ - x₂)) := by
    intro k x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg]
    exact hval_add k x₁ (-x₂) hx₁ (hval_neg_iff k x₂ hx₂)
  have hval_mono : ∀ {k₁ k₂ : ℤ} {x : L}, k₁ ≤ k₂ →
      (x = 0 ∨ k₂ ≤ valL F L x) → (x = 0 ∨ k₁ ≤ valL F L x) := by
    intro k₁ k₂ x hle hx
    rcases hx with rfl | hge
    · exact Or.inl rfl
    · exact Or.inr (le_trans hle hge)
  have hval_finset_sum : ∀ (T : Finset ℕ) (f : ℕ → L) (k : ℤ),
      (∀ i ∈ T, f i = 0 ∨ k ≤ valL F L (f i)) →
        ((∑ i ∈ T, f i) = 0 ∨ k ≤ valL F L (∑ i ∈ T, f i)) := by
    intro T f k hT
    induction T using Finset.induction_on with
    | empty => exact Or.inl (by simp)
    | @insert c s hc ih =>
      rw [Finset.sum_insert hc]
      exact hval_add k (f c) (∑ i ∈ s, f i)
        (hT c (Finset.mem_insert_self c s))
        (ih (fun i hi => hT i (Finset.mem_insert_of_mem hi)))
  have hval_pow_int : ∀ (x : L) (n : ℕ),
      (x = 0 ∨ 0 ≤ valL F L x) → (x ^ n = 0 ∨ 0 ≤ valL F L (x ^ n)) := by
    intro x n hx
    induction n with
    | zero => right; simp [hval1]
    | succ n ih =>
      rw [pow_succ]
      have hmul := hval_mul_ge 0 0 (x ^ n) x ih hx
      rwa [add_zero] at hmul
  have hδL_ge : δ_L = 0 ∨ ((a - b : ℕ) : ℤ) ≤ valL F L δ_L :=
    Or.inr (le_of_eq hδL_val.symm)
  have hδL_int : δ_L = 0 ∨ 0 ≤ valL F L δ_L :=
    hval_mono (by omega : (0 : ℤ) ≤ ((a - b : ℕ) : ℤ)) hδL_ge
  have hδL_pow_ge1 : ∀ (n : ℕ), 1 ≤ n →
      (δ_L ^ n = 0 ∨ ((a - b : ℕ) : ℤ) ≤ valL F L (δ_L ^ n)) := by
    intro n hn
    have hn_eq : n = (n - 1) + 1 := by omega
    rw [hn_eq, pow_succ]
    have hpow0 : δ_L ^ (n - 1) = 0 ∨ 0 ≤ valL F L (δ_L ^ (n - 1)) :=
      hval_pow_int δ_L (n - 1) hδL_int
    have hmul := hval_mul_ge 0 ((a - b : ℕ) : ℤ) (δ_L ^ (n - 1)) δ_L hpow0 hδL_ge
    rwa [zero_add] at hmul
  have hval_inv_zero : ∀ x : L, x ≠ 0 → valL F L x = 0 → valL F L x⁻¹ = 0 := by
    intro x hx0 hx_val
    let u_x : Lˣ := Units.mk0 x hx0
    have h1 : valL F L ((u_x⁻¹ : Lˣ) : L) = - valL F L (u_x : L) := hval_inv u_x
    simpa [u_x, hx_val] using h1
  have hunit_of_gt0 : ∀ x : L, (x = 0 ∨ (1 : ℤ) ≤ valL F L x) →
      1 + x ≠ 0 ∧ valL F L (1 + x) = 0 := by
    intro x hx
    have h1x_ne0 : 1 + x ≠ 0 := by
      intro h0
      have hx_neg1 : x = -1 := by linear_combination h0
      rcases hx with hx0 | hx_ge1
      · have h10 : (1 : L) = 0 := by linear_combination h0 - hx0
        exact one_ne_zero h10
      · rw [hx_neg1, hval_neg1] at hx_ge1
        omega
    let u_x : Lˣ := Units.mk0 (1 + x) h1x_ne0
    have hu_mem : u_x ∈ unitGroup F L 1 := by
      rw [hunit_ge1 1 le_rfl u_x]
      have hsub : (u_x : L) - 1 = x := by dsimp [u_x]; ring
      rcases hx with rfl | hx_ge1
      · exact Or.inl (by dsimp [u_x]; ring)
      · exact Or.inr (by rw [hsub]; exact hx_ge1)
    exact ⟨h1x_ne0, hunit_val0 1 u_x hu_mem⟩
  let I_r : Finset ℕ := Finset.Icc 1 (p - 1)
  let I_q : Finset ℕ := Finset.range (p - 1)
  let G : ℕ → L := fun j => ∑ q ∈ I_q, (-(τ j * δ_L)) ^ q
  let sum0 : L := ∑ r ∈ I_r, (-1 : L) ^ r * δ_L ^ (p - 1 - r) * s_u r
  let sum_j : ℕ → L := fun j => ∑ r ∈ I_r, (τ j) ^ r * s_u r
  let M_main : L := (1 - δ_L ^ (p - 1)) * s_u (p - 1) - sum0 + ∑ j ∈ S', τ j * δ_L * G j * sum_j j
  have hG_mul : ∀ j : ℕ, G j * (1 + τ j * δ_L) =
      (1 - δ_L ^ (p - 1)) - ((τ j) ^ (p - 1) - 1) * δ_L ^ (p - 1) := by
    intro j
    have hgeom := geom_sum_mul (-(τ j * δ_L)) (p - 1)
    have hneg_pow : (-(τ j * δ_L)) ^ (p - 1) = (τ j) ^ (p - 1) * δ_L ^ (p - 1) := by
      rw [hp1_even.neg_pow (τ j * δ_L), mul_pow]
    dsimp [G, I_q]
    rw [hneg_pow] at hgeom
    linear_combination -hgeom
  have hG_int : ∀ j ∈ S', G j = 0 ∨ 0 ≤ valL F L (G j) := by
    intro j hj
    dsimp [G]
    apply hval_finset_sum I_q _ 0
    intro q _
    have hτδ_int : τ j * δ_L = 0 ∨ 0 ≤ valL F L (τ j * δ_L) := by
      have h := hval_mul_ge 0 0 (τ j) δ_L (hτ_int j hj).1 hδL_int
      rwa [add_zero] at h
    exact hval_pow_int (-(τ j * δ_L)) q (hval_neg_iff 0 (τ j * δ_L) hτδ_int)
  have hX_sub_Mmain : (1 - δ_L ^ (p - 1)) * X - M_main = 0 ∨
      (a + 1 : ℤ) ≤ valL F L ((1 - δ_L ^ (p - 1)) * X - M_main) := by
    have hdecomp : (1 - δ_L ^ (p - 1)) * X - M_main =
        ((1 - δ_L ^ (p - 1)) * δ₀ + sum0) +
          ((∑ j ∈ S', (1 - δ_L ^ (p - 1)) * (τ j * δ_L * δ_err j)) -
            (∑ j ∈ S', τ j * δ_L * G j * sum_j j)) := by
      dsimp [X, M_main]
      rw [← Finset.mul_sum]
      ring
    rw [hdecomp, ← Finset.sum_sub_distrib]
    have hterm_sum : (∑ j ∈ S', ((1 - δ_L ^ (p - 1)) * (τ j * δ_L * δ_err j) -
        τ j * δ_L * G j * sum_j j)) = 0 ∨
        (a + 1 : ℤ) ≤ valL F L
          (∑ j ∈ S', ((1 - δ_L ^ (p - 1)) * (τ j * δ_L * δ_err j) -
            τ j * δ_L * G j * sum_j j)) := by
      apply hval_finset_sum S' _ (a + 1 : ℤ)
      intro j hj
      have hid_j : (1 - δ_L ^ (p - 1)) * (τ j * δ_L * δ_err j) - τ j * δ_L * G j * sum_j j =
          (τ j * δ_L * G j) * ((1 + τ j * δ_L) * δ_err j - sum_j j) +
            (τ j * δ_L * δ_L ^ (p - 1) * δ_err j) * ((τ j) ^ (p - 1) - 1) := by
        linear_combination - (τ j * δ_L * δ_err j) * hG_mul j
      rw [hid_j]
      have hτδ_int : τ j * δ_L = 0 ∨ 0 ≤ valL F L (τ j * δ_L) := by
        have h := hval_mul_ge 0 0 (τ j) δ_L (hτ_int j hj).1 hδL_int
        rwa [add_zero] at h
      have hτδG_int : τ j * δ_L * G j = 0 ∨ 0 ≤ valL F L (τ j * δ_L * G j) := by
        have h := hval_mul_ge 0 0 (τ j * δ_L) (G j) hτδ_int (hG_int j hj)
        rwa [add_zero] at h
      have hp1 : (τ j * δ_L * G j) * ((1 + τ j * δ_L) * δ_err j - sum_j j) = 0 ∨
          (a + 1 : ℤ) ≤ valL F L ((τ j * δ_L * G j) * ((1 + τ j * δ_L) * δ_err j - sum_j j)) := by
        have h := hval_mul_ge 0 (a + 1 : ℤ) (τ j * δ_L * G j)
          ((1 + τ j * δ_L) * δ_err j - sum_j j) hτδG_int (hδ_err_cong j hj)
        rwa [zero_add] at h
      have hδp1_int : δ_L ^ (p - 1) = 0 ∨ 0 ≤ valL F L (δ_L ^ (p - 1)) :=
        hval_pow_int δ_L (p - 1) hδL_int
      have hτδp_int : τ j * δ_L * δ_L ^ (p - 1) = 0 ∨ 0 ≤ valL F L (τ j * δ_L * δ_L ^ (p - 1)) := by
        have h := hval_mul_ge 0 0 (τ j * δ_L) (δ_L ^ (p - 1)) hτδ_int hδp1_int
        rwa [add_zero] at h
      have hδ_err_int : δ_err j = 0 ∨ 0 ≤ valL F L (δ_err j) :=
        hval_mono (by omega : (0 : ℤ) ≤ (m_1 : ℤ)) (hδ_err_val j hj)
      have hcoeff2_int : τ j * δ_L * δ_L ^ (p - 1) * δ_err j = 0 ∨
          0 ≤ valL F L (τ j * δ_L * δ_L ^ (p - 1) * δ_err j) := by
        have h := hval_mul_ge 0 0 (τ j * δ_L * δ_L ^ (p - 1)) (δ_err j) hτδp_int hδ_err_int
        rwa [add_zero] at h
      have hp2 : (τ j * δ_L * δ_L ^ (p - 1) * δ_err j) * ((τ j) ^ (p - 1) - 1) = 0 ∨
          (a + 1 : ℤ) ≤ valL F L ((τ j * δ_L * δ_L ^ (p - 1) * δ_err j) * ((τ j) ^ (p - 1) - 1)) := by
        have h := hval_mul_ge 0 (a + 1 : ℤ) (τ j * δ_L * δ_L ^ (p - 1) * δ_err j)
          ((τ j) ^ (p - 1) - 1) hcoeff2_int (hTeich_2 j hj)
        rwa [zero_add] at h
      exact hval_add (a + 1 : ℤ) _ _ hp1 hp2
    exact hval_add (a + 1 : ℤ) _ _ hδ₀_cong hterm_sum
  let I_T4 : ℕ → L := fun E => if (p - 1) ∣ E then ((p - 1 : ℕ) : L) else 0
  let M_eval : L := (1 - δ_L ^ (p - 1)) * s_u (p - 1) - sum0 +
    ∑ r ∈ I_r, s_u r * (∑ q ∈ I_q, ((-1 : L) ^ q * δ_L ^ (q + 1)) * I_T4 (q + 1 + r))
  have hpow_q : ∀ (j q r : ℕ),
      τ j * δ_L * (-(τ j * δ_L)) ^ q * ((τ j) ^ r * s_u r) =
        s_u r * (((-1 : L) ^ q * δ_L ^ (q + 1)) * (τ j) ^ (q + 1 + r)) := by
    intro j q r
    have hneg : -(τ j * δ_L) = (-1 : L) * τ j * δ_L := by ring
    rw [hneg, mul_pow, mul_pow, pow_add, pow_add, pow_add, pow_one, pow_one]
    ring
  have hsum_exch : (∑ j ∈ S', τ j * δ_L * G j * sum_j j) =
      ∑ r ∈ I_r, s_u r *
        (∑ q ∈ I_q, ((-1 : L) ^ q * δ_L ^ (q + 1)) * (∑ j ∈ S', (τ j) ^ (q + 1 + r))) := by
    have h1 : ∀ j ∈ S', τ j * δ_L * G j * sum_j j =
        ∑ r ∈ I_r, ∑ q ∈ I_q,
          s_u r * (((-1 : L) ^ q * δ_L ^ (q + 1)) * (τ j) ^ (q + 1 + r)) := by
      intro j _
      dsimp [G, sum_j]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun r _ => ?_)
      rw [Finset.mul_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun q _ => ?_)
      exact hpow_q j q r
    rw [Finset.sum_congr rfl h1, Finset.sum_comm]
    refine Finset.sum_congr rfl (fun r _ => ?_)
    rw [Finset.sum_comm, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    rw [Finset.mul_sum, Finset.mul_sum]
  have hMmain_sub_Meval : M_main - M_eval = 0 ∨
      (a + 1 : ℤ) ≤ valL F L (M_main - M_eval) := by
    have hdiff : M_main - M_eval =
        ∑ r ∈ I_r, s_u r * (∑ q ∈ I_q, ((-1 : L) ^ q * δ_L ^ (q + 1)) *
          ((∑ j ∈ S', (τ j) ^ (q + 1 + r)) - I_T4 (q + 1 + r))) := by
      dsimp [M_main, M_eval]
      rw [hsum_exch]
      have hsub1 : ((1 - δ_L ^ (p - 1)) * s_u (p - 1) - sum0 +
          ∑ r ∈ I_r, s_u r * ∑ q ∈ I_q, ((-1 : L) ^ q * δ_L ^ (q + 1)) *
            ∑ j ∈ S', (τ j) ^ (q + 1 + r)) -
        ((1 - δ_L ^ (p - 1)) * s_u (p - 1) - sum0 +
          ∑ r ∈ I_r, s_u r * ∑ q ∈ I_q, ((-1 : L) ^ q * δ_L ^ (q + 1)) *
            I_T4 (q + 1 + r)) =
        (∑ r ∈ I_r, s_u r * ∑ q ∈ I_q, ((-1 : L) ^ q * δ_L ^ (q + 1)) *
            ∑ j ∈ S', (τ j) ^ (q + 1 + r)) -
          (∑ r ∈ I_r, s_u r * ∑ q ∈ I_q, ((-1 : L) ^ q * δ_L ^ (q + 1)) *
            I_T4 (q + 1 + r)) := by ring
      rw [hsub1, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun r _ => ?_)
      rw [← mul_sub, ← Finset.sum_sub_distrib]
      congr 1
      refine Finset.sum_congr rfl (fun q _ => ?_)
      ring
    rw [hdiff]
    apply hval_finset_sum I_r _ (a + 1 : ℤ)
    intro r hr
    have hr_bounds := Finset.mem_Icc.mp hr
    have hs_int : s_u r = 0 ∨ 0 ≤ valL F L (s_u r) :=
      hval_mono (by omega : (0 : ℤ) ≤ (m_1 : ℤ)) (hs_u_val r hr)
    have hq_sum : (∑ q ∈ I_q, ((-1 : L) ^ q * δ_L ^ (q + 1)) *
        ((∑ j ∈ S', (τ j) ^ (q + 1 + r)) - I_T4 (q + 1 + r))) = 0 ∨
        (a + 1 : ℤ) ≤ valL F L (∑ q ∈ I_q, ((-1 : L) ^ q * δ_L ^ (q + 1)) *
          ((∑ j ∈ S', (τ j) ^ (q + 1 + r)) - I_T4 (q + 1 + r))) := by
      apply hval_finset_sum I_q _ (a + 1 : ℤ)
      intro q hq
      have hq_lt : q < p - 1 := Finset.mem_range.mp hq
      have hE_mem : q + 1 + r ∈ Finset.Icc 1 (2 * (p - 1)) := by
        rw [Finset.mem_Icc]; omega
      have hneg_q : (-1 : L) ^ q = 0 ∨ 0 ≤ valL F L ((-1 : L) ^ q) :=
        hval_pow_int (-1 : L) q (Or.inr (by omega))
      have hδ_q1 : δ_L ^ (q + 1) = 0 ∨ 0 ≤ valL F L (δ_L ^ (q + 1)) :=
        hval_pow_int δ_L (q + 1) hδL_int
      have hcoeff_q : (-1 : L) ^ q * δ_L ^ (q + 1) = 0 ∨
          0 ≤ valL F L ((-1 : L) ^ q * δ_L ^ (q + 1)) := by
        have h := hval_mul_ge 0 0 ((-1 : L) ^ q) (δ_L ^ (q + 1)) hneg_q hδ_q1
        rwa [add_zero] at h
      have hT4_E := hTeich_4 (q + 1 + r) hE_mem
      have hmul := hval_mul_ge 0 (a + 1 : ℤ) ((-1 : L) ^ q * δ_L ^ (q + 1)) _ hcoeff_q hT4_E
      rwa [zero_add] at hmul
    have hmul := hval_mul_ge 0 (a + 1 : ℤ) (s_u r) _ hs_int hq_sum
    rwa [zero_add] at hmul
  let I_r_lt : Finset ℕ := Finset.Icc 1 (p - 2)
  let B_p : L := - (p : L) *
    ((∑ r ∈ I_r_lt, (-1 : L) ^ r * δ_L ^ (p - 1 - r) * s_u r) +
      δ_L ^ (p - 1) * s_u (p - 1))
  have hq_r_lt : ∀ r ∈ I_r_lt,
      (∑ q ∈ I_q, ((-1 : L) ^ q * δ_L ^ (q + 1)) * I_T4 (q + 1 + r)) =
        - ((p - 1 : ℕ) : L) * (-1 : L) ^ r * δ_L ^ (p - 1 - r) := by
    intro r hr
    have hr_bounds := Finset.mem_Icc.mp hr
    have hcongr : ∀ q ∈ I_q,
        ((-1 : L) ^ q * δ_L ^ (q + 1)) * I_T4 (q + 1 + r) =
          if q = p - 2 - r then ((-1 : L) ^ q * δ_L ^ (q + 1)) * ((p - 1 : ℕ) : L) else 0 := by
      intro q hq
      have hq_lt : q < p - 1 := Finset.mem_range.mp hq
      have hdvd_iff : (p - 1) ∣ (q + 1 + r) ↔ q = p - 2 - r := by
        constructor
        · rintro ⟨k, hk⟩
          by_cases hk0 : k = 0
          · subst hk0; omega
          · by_cases hk2 : 2 ≤ k
            · have := Nat.mul_le_mul_left (p - 1) hk2
              omega
            · have hk1 : k = 1 := by omega
              subst hk1; omega
        · rintro rfl
          exact ⟨1, by omega⟩
      dsimp [I_T4]
      rw [if_congr hdvd_iff rfl rfl]
      split_ifs <;> ring
    rw [Finset.sum_congr rfl hcongr,
      Finset.sum_ite_eq' I_q (p - 2 - r)
        (fun q => ((-1 : L) ^ q * δ_L ^ (q + 1)) * ((p - 1 : ℕ) : L)),
      if_pos (Finset.mem_range.mpr (by omega))]
    have hexp_δ : (p - 2 - r) + 1 = p - 1 - r := by omega
    have hsign : (-1 : L) ^ (p - 2 - r) = - ((-1 : L) ^ r) := by
      have hprod : (-1 : L) ^ (p - 2 - r) * (-1 : L) ^ r = -1 := by
        rw [← pow_add, Nat.sub_add_cancel (by omega : r ≤ p - 2), hp2_odd.neg_one_pow]
      have hsq : (-1 : L) ^ r * (-1 : L) ^ r = 1 := by
        rw [← mul_pow, neg_one_mul, neg_neg, one_pow]
      linear_combination (-1 : L) ^ r * hprod - (-1 : L) ^ (p - 2 - r) * hsq
    rw [hexp_δ, hsign]
    ring
  have hq_rp1 : (∑ q ∈ I_q, ((-1 : L) ^ q * δ_L ^ (q + 1)) * I_T4 (q + 1 + (p - 1))) =
      - ((p - 1 : ℕ) : L) * δ_L ^ (p - 1) := by
    have hcongr : ∀ q ∈ I_q,
        ((-1 : L) ^ q * δ_L ^ (q + 1)) * I_T4 (q + 1 + (p - 1)) =
          if q = p - 2 then ((-1 : L) ^ q * δ_L ^ (q + 1)) * ((p - 1 : ℕ) : L) else 0 := by
      intro q hq
      have hq_lt : q < p - 1 := Finset.mem_range.mp hq
      have hdvd_iff : (p - 1) ∣ (q + 1 + (p - 1)) ↔ q = p - 2 := by
        constructor
        · rintro ⟨k, hk⟩
          by_cases hk1 : k ≤ 1
          · have := Nat.mul_le_mul_left (p - 1) hk1
            omega
          · by_cases hk3 : 3 ≤ k
            · have := Nat.mul_le_mul_left (p - 1) hk3
              omega
            · have hk2 : k = 2 := by omega
              subst hk2; omega
        · rintro rfl
          exact ⟨2, by omega⟩
      dsimp [I_T4]
      rw [if_congr hdvd_iff rfl rfl]
      split_ifs <;> ring
    rw [Finset.sum_congr rfl hcongr,
      Finset.sum_ite_eq' I_q (p - 2)
        (fun q => ((-1 : L) ^ q * δ_L ^ (q + 1)) * ((p - 1 : ℕ) : L)),
      if_pos (Finset.mem_range.mpr (by omega))]
    have hexp_δ : (p - 2) + 1 = p - 1 := by omega
    rw [hexp_δ, hp2_odd.neg_one_pow]
    ring
  have hMeval_eq_Bp : M_eval = B_p := by
    have hIr_split : I_r = insert (p - 1) I_r_lt := by
      ext x
      simp only [I_r, I_r_lt, Finset.mem_Icc, Finset.mem_insert]
      omega
    have hp1_not_mem : (p - 1 : ℕ) ∉ I_r_lt := by
      dsimp [I_r_lt]; rw [Finset.mem_Icc]; omega
    have hsum0_split : sum0 = s_u (p - 1) +
        ∑ r ∈ I_r_lt, (-1 : L) ^ r * δ_L ^ (p - 1 - r) * s_u r := by
      dsimp [sum0]
      rw [hIr_split, Finset.sum_insert hp1_not_mem, Nat.sub_self, pow_zero,
        hp1_even.neg_one_pow, one_mul, one_mul]
    have hsum3 : (∑ r ∈ I_r, s_u r *
        (∑ q ∈ I_q, ((-1 : L) ^ q * δ_L ^ (q + 1)) * I_T4 (q + 1 + r))) =
        - ((p - 1 : ℕ) : L) * (δ_L ^ (p - 1) * s_u (p - 1)) -
          ((p - 1 : ℕ) : L) * (∑ r ∈ I_r_lt, (-1 : L) ^ r * δ_L ^ (p - 1 - r) * s_u r) := by
      rw [hIr_split, Finset.sum_insert hp1_not_mem, hq_rp1]
      have hr_lt_congr : ∀ r ∈ I_r_lt,
          s_u r * (∑ q ∈ I_q, ((-1 : L) ^ q * δ_L ^ (q + 1)) * I_T4 (q + 1 + r)) =
            - ((p - 1 : ℕ) : L) * ((-1 : L) ^ r * δ_L ^ (p - 1 - r) * s_u r) := by
        intro r hr
        rw [hq_r_lt r hr]
        ring
      rw [Finset.sum_congr rfl hr_lt_congr, ← Finset.mul_sum]
      ring
    have hp_cast : (1 : L) + ((p - 1 : ℕ) : L) = (p : L) := by
      rw [← Nat.cast_one, ← Nat.cast_add, Nat.add_sub_of_le hp_pos]
    dsimp [M_eval, B_p]
    rw [hsum0_split, hsum3]
    linear_combination
      - ((∑ r ∈ I_r_lt, (-1 : L) ^ r * δ_L ^ (p - 1 - r) * s_u r) +
        δ_L ^ (p - 1) * s_u (p - 1)) * hp_cast
  have hBp_val : B_p = 0 ∨ (a : ℤ) ≤ valL F L B_p := by
    have hp1_Ir : (p - 1) ∈ I_r := by dsimp [I_r]; rw [Finset.mem_Icc]; omega
    have hsum_r_lt : (∑ r ∈ I_r_lt, (-1 : L) ^ r * δ_L ^ (p - 1 - r) * s_u r) = 0 ∨
        (((a - b : ℕ) : ℤ) + (m_1 : ℤ)) ≤
          valL F L (∑ r ∈ I_r_lt, (-1 : L) ^ r * δ_L ^ (p - 1 - r) * s_u r) := by
      apply hval_finset_sum I_r_lt _ (((a - b : ℕ) : ℤ) + (m_1 : ℤ))
      intro r hr
      have hr_bounds := Finset.mem_Icc.mp hr
      have hr_Ir : r ∈ I_r := by dsimp [I_r]; rw [Finset.mem_Icc]; omega
      have hneg_r : (-1 : L) ^ r = 0 ∨ 0 ≤ valL F L ((-1 : L) ^ r) :=
        hval_pow_int (-1 : L) r (Or.inr (by omega))
      have hδ_pr : δ_L ^ (p - 1 - r) = 0 ∨
          ((a - b : ℕ) : ℤ) ≤ valL F L (δ_L ^ (p - 1 - r)) :=
        hδL_pow_ge1 (p - 1 - r) (by omega)
      have h1 := hval_mul_ge 0 ((a - b : ℕ) : ℤ) ((-1 : L) ^ r) (δ_L ^ (p - 1 - r)) hneg_r hδ_pr
      rw [zero_add] at h1
      exact hval_mul_ge ((a - b : ℕ) : ℤ) (m_1 : ℤ)
        ((-1 : L) ^ r * δ_L ^ (p - 1 - r)) (s_u r) h1 (hs_u_val r hr_Ir)
    have hterm_p1 : δ_L ^ (p - 1) * s_u (p - 1) = 0 ∨
        (((a - b : ℕ) : ℤ) + (m_1 : ℤ)) ≤ valL F L (δ_L ^ (p - 1) * s_u (p - 1)) :=
      hval_mul_ge ((a - b : ℕ) : ℤ) (m_1 : ℤ)
        (δ_L ^ (p - 1)) (s_u (p - 1))
        (hδL_pow_ge1 (p - 1) (by omega)) (hs_u_val (p - 1) hp1_Ir)
    have hinner := hval_add (((a - b : ℕ) : ℤ) + (m_1 : ℤ)) _ _ hsum_r_lt hterm_p1
    have hmul := hval_mul_ge (m_p : ℤ) (((a - b : ℕ) : ℤ) + (m_1 : ℤ)) (p : L) _ hp_val hinner
    have hmul_a := hval_mono ha_le_sum hmul
    have hneg_mul := hval_neg_iff (a : ℤ) _ hmul_a
    have hBp_eq : B_p = - ((p : L) *
        ((∑ r ∈ I_r_lt, (-1 : L) ^ r * δ_L ^ (p - 1 - r) * s_u r) +
          δ_L ^ (p - 1) * s_u (p - 1))) := by dsimp [B_p]; ring
    rwa [← hBp_eq] at hneg_mul
  have h1δ_X_val : (1 - δ_L ^ (p - 1)) * X = 0 ∨
      (a : ℤ) ≤ valL F L ((1 - δ_L ^ (p - 1)) * X) := by
    have h1 : (1 - δ_L ^ (p - 1)) * X - M_main = 0 ∨
        (a : ℤ) ≤ valL F L ((1 - δ_L ^ (p - 1)) * X - M_main) :=
      hval_mono (by omega : (a : ℤ) ≤ (a + 1 : ℤ)) hX_sub_Mmain
    have h2 : M_main - B_p = 0 ∨ (a : ℤ) ≤ valL F L (M_main - B_p) := by
      rw [← hMeval_eq_Bp]
      exact hval_mono (by omega : (a : ℤ) ≤ (a + 1 : ℤ)) hMmain_sub_Meval
    have h3 := hval_add (a : ℤ) _ _ h1 h2
    have h4 := hval_add (a : ℤ) _ _ h3 hBp_val
    have hid : ((1 - δ_L ^ (p - 1)) * X - M_main) + (M_main - B_p) + B_p =
        (1 - δ_L ^ (p - 1)) * X := by ring
    rwa [hid] at h4
  have h1δ_prop : 1 - δ_L ^ (p - 1) ≠ 0 ∧ valL F L (1 - δ_L ^ (p - 1)) = 0 := by
    have hδp1_ge1 : -(δ_L ^ (p - 1)) = 0 ∨ (1 : ℤ) ≤ valL F L (-(δ_L ^ (p - 1))) :=
      hval_neg_iff 1 (δ_L ^ (p - 1))
        (hval_mono (by omega : (1 : ℤ) ≤ ((a - b : ℕ) : ℤ))
          (hδL_pow_ge1 (p - 1) (by omega)))
    have hu := hunit_of_gt0 (-(δ_L ^ (p - 1))) hδp1_ge1
    rwa [← sub_eq_add_neg] at hu
  have h1δ_inv : (1 - δ_L ^ (p - 1))⁻¹ = 0 ∨ 0 ≤ valL F L (1 - δ_L ^ (p - 1))⁻¹ :=
    Or.inr (le_of_eq (hval_inv_zero (1 - δ_L ^ (p - 1)) h1δ_prop.1 h1δ_prop.2).symm)
  have hX_eq : X = (1 - δ_L ^ (p - 1))⁻¹ * ((1 - δ_L ^ (p - 1)) * X) :=
    (inv_mul_cancel_left₀ h1δ_prop.1 X).symm
  rw [hX_eq]
  have hfinal := hval_mul_ge 0 (a : ℤ) (1 - δ_L ^ (p - 1))⁻¹
    ((1 - δ_L ^ (p - 1)) * X) h1δ_inv h1δ_X_val
  rwa [zero_add] at hfinal

theorem ld_wild_mid_cond_odd_prime_RK_and_stat_reduction (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hqK : qL F K = qL F L)
    (hval_alg : ∀ x : L,
