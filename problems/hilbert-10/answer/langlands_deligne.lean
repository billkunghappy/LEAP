    have hu1u2_val : valL F L ((u₁ * u₂ : Lˣ) : L) = 0 := by
      rw [Units.val_mul, hval_mul (u₁ : L) (u₂ : L) (Units.ne_zero _) (Units.ne_zero _)]
      dsimp only [u₁, u₂]
      rw [Units.val_mk0, Units.val_mk0,
        h1_add_val (hδx_P1 hx₁), h1_add_val (hδx_P1 hx₂), add_zero]
    have hpoly_q : ((u₁₂ * w_q : Lˣ) : L) - ((u₁ * u₂ : Lˣ) : L) =
        (δ_b : L) ^ 2 * ((δ_b : L) * (x₁ * x₂ * (x₁ + x₂))) := by
      dsimp only [u₁, u₂, u₁₂, w_q]
      rw [Units.val_mul, Units.val_mul, Units.val_mk0, Units.val_mk0,
        Units.val_mk0, Units.val_mk0]
      ring
    have hpoly_q_Pb : P (b : ℤ) (((u₁₂ * w_q : Lˣ) : L) - ((u₁ * u₂ : Lˣ) : L)) := by
      rw [hpoly_q]
      exact hP_mono (by omega)
        (hP_mul (hP_sq hP_δb) (hP_mul hP_δb (hP_mul hmul12 hx12)))
    have hν_q_eq : ν₁ (u₁₂ * w_q) = ν₁ (u₁ * u₂) :=
      hν₁_congr hu1u2_val hpoly_q_Pb
    have hν_inv_eq : (ν₁ u₁₂ : Ω F)⁻¹ =
        (ν₁ u₁ : Ω F)⁻¹ * (ν₁ u₂ : Ω F)⁻¹ * (ν₁ w_q : Ω F) := by
      have h1 : (ν₁ u₁₂ : Ω F) * (ν₁ w_q : Ω F) = (ν₁ u₁ : Ω F) * (ν₁ u₂ : Ω F) := by
        exact_mod_cast (map_mul ν₁ u₁₂ w_q).symm.trans (hν_q_eq.trans (map_mul ν₁ u₁ u₂))
      rw [← mul_inv, ← h1, mul_inv, mul_assoc, inv_mul_cancel₀ (Units.ne_zero (ν₁ w_q)), mul_one]
    have hν_wq : (ν₁ w_q : Ω F) = ψ₀ (y₁ * y₂) := by
      rw [hc_ν₁_stat ((δ_b : L) ^ 2 * (x₁ * x₂)) hδ2_stat hwq_ne, ← mul_assoc,
        hψ₀_apply, ← hψ₀_spec (x₁ * x₂) hmul12, (hresL_ring x₁ x₂ hx₁ hx₂).2.1,
        hliftL_res y₁, hliftL_res y₂]
    have hres_add : y₁ + y₂ = resL (x₁ + x₂) := by
      rw [(hresL_ring x₁ x₂ hx₁ hx₂).1, hliftL_res y₁, hliftL_res y₂]
    have hψ_add : ψ (A * (δ_b : L) * (x₁ + x₂)) =
        ψ (A * (δ_b : L) * x₁) * ψ (A * (δ_b : L) * x₂) := by
      rw [← ψ.map_add_eq_mul]
      congr 1
      ring
    rw [hres_add, hQ_spec (x₁ + x₂) hx12 hu12_ne,
      ← hliftL_res y₁, ← hliftL_res y₂,
      hQ_spec x₁ hx₁ hu₁_ne, hQ_spec x₂ hx₂ hu₂_ne,
      hliftL_res y₁, hliftL_res y₂, hν_inv_eq, hν_wq, hψ_add]
    ring
  have hchar2_add : ∀ u : k_L, u + u = 0 := by
    intro u
    rw [← two_mul, hchar2, zero_mul]
  have hQ_ne0 : ∀ x : k_L, Q_ν x ≠ 0 := by
    intro x hx0
    have h1 : (1 : Ω F) = Q_ν x * Q_ν x * ψ₀ (x * x) := by
      rw [← hQ_0, ← hchar2_add x, hQ_add x x]
    rw [hx0, zero_mul, zero_mul] at h1
    exact one_ne_zero h1
  have hRL_inj : Set.InjOn resL R_L := by
    intro r₁ hr₁ r₂ hr₂ hres_eq
    by_contra hr_ne
    have hval0_sub : valL F L (r₁ - r₂) = 0 := hRL_sep r₁ hr₁ r₂ hr₂ hr_ne
    have hsub_P1 : P 1 (r₁ - r₂) :=
      hresL_sub_mem1 (hRL_int r₁ hr₁) (hRL_int r₂ hr₂) hres_eq
    rcases hsub_P1 with hsub0 | hval1_sub
    · exact hr_ne (sub_eq_zero.mp hsub0)
    · omega
  have hRL_image : R_L.image resL = Finset.univ := by
    apply Finset.eq_of_subset_of_card_le (Finset.subset_univ _)
    rw [Finset.card_univ, Finset.card_image_of_injOn hRL_inj, hRL_card]
  have hRL_sum_bij : ∀ g : k_L → Ω F, (∑ r ∈ R_L, g (resL r)) = ∑ x : k_L, g x := by
    intro g
    refine Finset.sum_bij (fun r _ => resL r) ?_ ?_ ?_ ?_
    · intro r _; exact Finset.mem_univ _
    · intro r₁ hr₁ r₂ hr₂ heq; exact hRL_inj hr₁ hr₂ heq
    · intro b_res hb_res
      rw [← hRL_image] at hb_res
      obtain ⟨r, hr, hres⟩ := Finset.mem_image.mp hb_res
      exact ⟨r, hr, hres⟩
    · intro _ _; rfl
  have hS_2 : (∑ r ∈ R_L,
      if hr_L : 1 + (δ_b : L) * r ≠ 0 then
        (ν₁ (Units.mk0 (1 + (δ_b : L) * r) hr_L) : Ω F)⁻¹ *
          ψ (A * (δ_b : L) * r)
      else 0) = ∑ x : k_L, Q_ν x := by
    rw [← hRL_sum_bij Q_ν]
    refine Finset.sum_congr rfl (fun r hr => ?_)
    have hr_ne : 1 + (δ_b : L) * r ≠ 0 := h1_add_ne (hδx_P1 (hRL_int r hr))
    rw [dif_pos hr_ne, hQ_spec r (hRL_int r hr) hr_ne]
  have hS_1 : (∑ r ∈ R_L,
      if hr_2 : 1 + (δ_b : L) * r ^ 2 ≠ 0 then
        (ν₁ (Units.mk0 (1 + (δ_b : L) * r ^ 2) hr_2) : Ω F) *
          (ψ (A * (δ_b : L) * r ^ 2))⁻¹
      else 0) = ∑ x : k_L, (Q_ν (x ^ 2))⁻¹ := by
    rw [← hRL_sum_bij (fun x : k_L => (Q_ν (x ^ 2))⁻¹)]
    refine Finset.sum_congr rfl (fun r hr => ?_)
    have hr_int : P 0 r := hRL_int r hr
    have hr2_int : P 0 (r ^ 2) := hP_mono (by omega) (hP_sq hr_int)
    have hr2_ne : 1 + (δ_b : L) * r ^ 2 ≠ 0 := h1_add_ne (hδx_P1 hr2_int)
    have hres_r2 : resL (r ^ 2) = (resL r) ^ 2 := by
      rw [sq, (hresL_ring r r hr_int hr_int).2.1, ← sq]
    rw [dif_pos hr2_ne, ← hres_r2, hQ_spec (r ^ 2) hr2_int hr2_ne, mul_inv, inv_inv]
  have hfrob_inj : Function.Injective (fun x : k_L => x ^ 2) := by
    intro x y hxy
    have hsub_sq : (x - y) ^ 2 = 0 := by
      calc (x - y) ^ 2
        _ = (x ^ 2 - y ^ 2) - (2 : k_L) * (x * y - y ^ 2) := by ring
        _ = 0 - 0 * (x * y - y ^ 2) := by rw [sub_eq_zero.mpr hxy, hchar2]
        _ = 0 := by ring
    exact sub_eq_zero.mp (sq_eq_zero_iff.mp hsub_sq)
  have hfrob_bij : Function.Bijective (fun x : k_L => x ^ 2) :=
    (Fintype.bijective_iff_injective_and_card (fun x : k_L => x ^ 2)).mpr ⟨hfrob_inj, rfl⟩
  have hS_1_reindexed : (∑ x : k_L, (Q_ν (x ^ 2))⁻¹) = ∑ y : k_L, (Q_ν y)⁻¹ :=
    Fintype.sum_bijective (fun x : k_L => x ^ 2) hfrob_bij
      (fun x : k_L => (Q_ν (x ^ 2))⁻¹) (fun y : k_L => (Q_ν y)⁻¹) (fun _ => rfl)
  have hFF2_inv : (∑ x : k_L, Q_ν x) * (∑ y : k_L, (Q_ν y)⁻¹) = (Fintype.card k_L : Ω F) :=
    (hFF2 ψ₀ hψ₀_ne1 hchar2 Q_ν hQ_0 hQ_add).1 hQ_ne0
  rw [hS_1, hS_1_reindexed, hS_2, mul_comm, hFF2_inv]

theorem ld_wild_mid_cond_dyadic_K_summand_eval (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hp2 : Module.finrank L (IntermediateField.extendScalars hLK) = 2)
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hb_odd : condExp F L ν₁ % 2 = 1)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hba : condExp F L ν₁ < condExp F L χ')
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (ϖ_K : Kˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLK) ϖ_K = ϖ_L)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (t : ℕ) (hb_eq : condExp F L ν₁ = t + 1)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (c_χ' c_ν₁ δ : Lˣ) (u_K u_corr c_K : Kˣ)
    (hc_χ'_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ'⁻¹ : Lˣ) : L) * x))
    (hc_ν₁_stat : ∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_ν₁⁻¹ : Lˣ) : L) * x))
    (hδ_eq : δ = c_χ' * c_ν₁⁻¹)
    (hu_K_norm : Units.map (normLM F hLK) u_K = δ)
    (hu_K_val : valL F K (u_K : K) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hδ_val : valL F L (δ : L) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hu_corr_eq : (u_corr : K) = 1 - IntermediateField.inclusion hLK (δ : L) * ((u_K⁻¹ : Kˣ) : K))
    (hc_K_eq : c_K = (Units.map (IntermediateField.inclusion hLK) c_χ') * u_corr⁻¹)
    (htr_smul : ∀ (x : L) (y : K),
      traceLM F hLK (IntermediateField.inclusion hLK x * y) = x * traceLM F hLK y)
    (hnorm_incl : ∀ x : L, normLM F hLK (IntermediateField.inclusion hLK x) = x ^ 2)
    (hnorm_add : ∀ (x : L) (y : K),
      normLM F hLK (IntermediateField.inclusion hLK x + y) =
        x ^ 2 + x * traceLM F hLK y + normLM F hLK y)
    (r : L) (hr_int : r = 0 ∨ 0 ≤ valL F L r) :
    (if hr_K : 1 + ((u_K * ϖ_K ^ (condExp F L ν₁ / 2) : Kˣ) : K) *
        IntermediateField.inclusion hLK r ≠ 0 then
      ((χ'.comp (Units.map (normLM F hLK)))
        (Units.mk0 (1 + ((u_K * ϖ_K ^ (condExp F L ν₁ / 2) : Kˣ) : K) *
          IntermediateField.inclusion hLK r) hr_K) : Ω F)⁻¹ *
        (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) *
          ((u_K * ϖ_K ^ (condExp F L ν₁ / 2) : Kˣ) : K) *
          IntermediateField.inclusion hLK r)
    else 0) =
    (if hr_2 : 1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r ^ 2 ≠ 0 then
      (ν₁ (Units.mk0 (1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r ^ 2) hr_2) : Ω F) *
        (ψ (((c_ν₁⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r ^ 2))⁻¹
    else 0) :=
by
  rcases hvalL_props with ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, _, hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩
  rcases hvalK_props with ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K,
    hval_inv_K, _, hval_add_K, hunit0_K, hunit_ge1_K, hunit_val0_K⟩
  let b : ℕ := condExp F L ν₁
  let a : ℕ := condExp F L χ'
  let d_b : ℕ := b / 2
  let r0_b : ℕ := (b + 1) / 2
  let r0_a : ℕ := (a + 1) / 2
  have hb_def : b = condExp F L ν₁ := rfl
  have ha_def : a = condExp F L χ' := rfl
  have hdb_def : d_b = b / 2 := rfl
  have hr0b_def : r0_b = (b + 1) / 2 := rfl
  have hr0a_def : r0_a = (a + 1) / 2 := rfl
  let A_χ : L := ((c_χ'⁻¹ : Lˣ) : L)
  let A_ν : L := ((c_ν₁⁻¹ : Lˣ) : L)
  have hb_ne0 : b ≠ 0 := by omega
  have hb_ge1 : 1 ≤ b := by omega
  have ha_ne0 : a ≠ 0 := by omega
  have ha_ge1 : 1 ≤ a := by omega
  have hdb_ge1 : 1 ≤ d_b := by omega
  have hχ'_triv : ∀ u ∈ unitGroup F L a, χ' u = 1 := ((hSpecL χ').2.2.1 ha_ne0).1
  have hν₁_triv : ∀ u ∈ unitGroup F L b, ν₁ u = 1 := ((hSpecL ν₁).2.2.1 hb_ne0).1
  let P_L (k : ℤ) (x : L) : Prop := x = 0 ∨ k ≤ valL F L x
  let P_K (k : ℤ) (y : K) : Prop := y = 0 ∨ k ≤ valL F K y
  have hPL_mono : ∀ {k₁ k₂ : ℤ} {x : L}, k₁ ≤ k₂ → P_L k₂ x → P_L k₁ x := by
    intro k₁ k₂ x hk hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hk hx)
  have hPL_neg : ∀ {k : ℤ} {x : L}, P_L k x → P_L k (-x) := by
    intro k x hx
    rcases hx with rfl | hx
    · exact Or.inl neg_zero
    · right; rw [hval_neg_L]; exact hx
  have hPL_add : ∀ {k : ℤ} {x₁ x₂ : L}, P_L k x₁ → P_L k x₂ → P_L k (x₁ + x₂) :=
    fun hx₁ hx₂ => hval_add_L _ _ _ hx₁ hx₂
  have hPL_sub : ∀ {k : ℤ} {x₁ x₂ : L}, P_L k x₁ → P_L k x₂ → P_L k (x₁ - x₂) := by
    intro k x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg]
    exact hPL_add hx₁ (hPL_neg hx₂)
  have hPL_mul : ∀ {k₁ k₂ : ℤ} {x₁ x₂ : L}, P_L k₁ x₁ → P_L k₂ x₂ → P_L (k₁ + k₂) (x₁ * x₂) := by
    intro k₁ k₂ x₁ x₂ hx₁ hx₂
    by_cases hx10 : x₁ = 0
    · exact Or.inl (by rw [hx10, zero_mul])
    · by_cases hx20 : x₂ = 0
      · exact Or.inl (by rw [hx20, mul_zero])
      · right
        rw [hval_mul_L x₁ x₂ hx10 hx20]
        have h1 := hx₁.resolve_left hx10
        have h2 := hx₂.resolve_left hx20
        omega
  have hPL_sq : ∀ {k : ℤ} {x : L}, P_L k x → P_L (k + k) (x ^ 2) := by
    intro k x hx; rw [sq]; exact hPL_mul hx hx
  have hPL_of_val : ∀ {k : ℤ} {x : L}, valL F L x = k → P_L k x :=
    fun h => Or.inr (le_of_eq h.symm)
  have hPK_mono : ∀ {k₁ k₂ : ℤ} {y : K}, k₁ ≤ k₂ → P_K k₂ y → P_K k₁ y := by
    intro k₁ k₂ y hk hy
    rcases hy with rfl | hy
    · exact Or.inl rfl
    · exact Or.inr (le_trans hk hy)
  have hPK_mul : ∀ {k₁ k₂ : ℤ} {y₁ y₂ : K}, P_K k₁ y₁ → P_K k₂ y₂ → P_K (k₁ + k₂) (y₁ * y₂) := by
    intro k₁ k₂ y₁ y₂ hy₁ hy₂
    by_cases hy10 : y₁ = 0
    · exact Or.inl (by rw [hy10, zero_mul])
    · by_cases hy20 : y₂ = 0
      · exact Or.inl (by rw [hy20, mul_zero])
      · right
        rw [hval_mul_K y₁ y₂ hy10 hy20]
        have h1 := hy₁.resolve_left hy10
        have h2 := hy₂.resolve_left hy20
        omega
  have hPK_of_val : ∀ {k : ℤ} {y : K}, valL F K y = k → P_K k y :=
    fun h => Or.inr (le_of_eq h.symm)
  have hP_incl : ∀ {k : ℤ} {x : L}, P_L k x → P_K (2 * k) (IntermediateField.inclusion hLK x) := by
    intro k x hx
    rcases hx with rfl | hx
    · exact Or.inl (map_zero (IntermediateField.inclusion hLK))
    · right; rw [hval_alg x, hp2]; push_cast; omega
  have h1_add_ne_L : ∀ {x : L}, P_L 1 x → 1 + x ≠ 0 := by
    intro x hx h0
    have hx_eq : x = -1 := by linear_combination h0
    rw [hx_eq] at hx
    rcases hx with hneg1 | hle
    · exact one_ne_zero (by linear_combination -hneg1)
    · rw [hval_neg1_L] at hle; omega
  have h1_add_val_L : ∀ {x : L} (hx : P_L 1 x), valL F L (1 + x) = 0 := by
    intro x hx
    set u := Units.mk0 (1 + x) (h1_add_ne_L hx)
    have hu_mem : u ∈ unitGroup F L 1 := by
      rw [hunit_ge1_L 1 le_rfl u]
      change (1 + x : L) = 1 ∨ (1 : ℤ) ≤ valL F L ((1 + x : L) - 1)
      rw [add_sub_cancel_left]
      rcases hx with rfl | hx'
      · left; rw [add_zero]
      · right; exact hx'
    exact hunit_val0_L 1 u hu_mem
  have h1_add_ne_K : ∀ {y : K}, P_K 1 y → 1 + y ≠ 0 := by
    intro y hy h0
    have hy_eq : y = -1 := by linear_combination h0
    rw [hy_eq] at hy
    rcases hy with hneg1 | hle
    · exact one_ne_zero (by linear_combination -hneg1)
    · rw [hval_neg1_K] at hle; omega
  have hχ'_congr : ∀ {u v : Lˣ}, valL F L (u : L) = 0 → P_L (a : ℤ) ((v : L) - (u : L)) → χ' v = χ' u := by
    intro u v hu_val hvu
    set q : Lˣ := u⁻¹ * v
    have hq_sub : ((q : Lˣ) : L) - 1 = ((u⁻¹ : Lˣ) : L) * ((v : L) - (u : L)) := by
      have h_inv : ((u⁻¹ : Lˣ) : L) * (u : L) = 1 := Units.inv_mul u
      dsimp only [q]
      rw [Units.val_mul, ← h_inv]
      ring
    have hu_inv_P : P_L 0 ((u⁻¹ : Lˣ) : L) := by
      apply hPL_of_val
      rw [hval_inv_L u, hu_val, neg_zero]
    have hq_P : P_L (a : ℤ) (((q : Lˣ) : L) - 1) := by
      rw [hq_sub, ← zero_add (a : ℤ)]
      exact hPL_mul hu_inv_P hvu
    have hq_mem : q ∈ unitGroup F L a := by
      rw [hunit_ge1_L a ha_ge1 q]
      rcases hq_P with h0 | hge
      · left; exact sub_eq_zero.mp h0
      · right; exact hge
    have hv_eq : v = u * q := by simp [q]
    rw [hv_eq, map_mul, hχ'_triv q hq_mem, mul_one]
  have hν₁_congr : ∀ {u v : Lˣ}, valL F L (u : L) = 0 → P_L (b : ℤ) ((v : L) - (u : L)) → ν₁ v = ν₁ u := by
    intro u v hu_val hvu
    set q : Lˣ := u⁻¹ * v
    have hq_sub : ((q : Lˣ) : L) - 1 = ((u⁻¹ : Lˣ) : L) * ((v : L) - (u : L)) := by
      have h_inv : ((u⁻¹ : Lˣ) : L) * (u : L) = 1 := Units.inv_mul u
      dsimp only [q]
      rw [Units.val_mul, ← h_inv]
      ring
    have hu_inv_P : P_L 0 ((u⁻¹ : Lˣ) : L) := by
      apply hPL_of_val
      rw [hval_inv_L u, hu_val, neg_zero]
    have hq_P : P_L (b : ℤ) (((q : Lˣ) : L) - 1) := by
      rw [hq_sub, ← zero_add (b : ℤ)]
      exact hPL_mul hu_inv_P hvu
    have hq_mem : q ∈ unitGroup F L b := by
      rw [hunit_ge1_L b hb_ge1 q]
      rcases hq_P with h0 | hge
      · left; exact sub_eq_zero.mp h0
      · right; exact hge
    have hv_eq : v = u * q := by simp [q]
    rw [hv_eq, map_mul, hν₁_triv q hq_mem, mul_one]
  have hA_ν_eq : A_ν = A_χ * (δ : L) := by
    have h : c_ν₁⁻¹ = c_χ'⁻¹ * δ := by rw [hδ_eq, inv_mul_cancel_left]
    exact congrArg Units.val h
  have hϖL_pow_val : ∀ k : ℕ, valL F L (((ϖ_L ^ k : Lˣ) : L)) = (k : ℤ) := by
    intro k
    induction k with
    | zero => simp [hval1_L]
    | succ k ih =>
      rw [pow_succ, Units.val_mul, hval_mul_L _ _ (Units.ne_zero _) (Units.ne_zero _), ih, hϖ_L]
      push_cast; ring
  have hϖK_pow_val : ∀ k : ℕ, valL F K (((ϖ_K ^ k : Kˣ) : K)) = (k : ℤ) := by
    intro k
    induction k with
    | zero => simp [hval1_K]
    | succ k ih =>
      rw [pow_succ, Units.val_mul, hval_mul_K _ _ (Units.ne_zero _) (Units.ne_zero _), ih, hϖ_K]
      push_cast; ring
  let δ_b : Lˣ := ϖ_L ^ d_b
  let δ_K : Kˣ := u_K * ϖ_K ^ d_b
  have hδb_val : valL F L (δ_b : L) = (d_b : ℤ) := hϖL_pow_val d_b
  have hδK_val : valL F K (δ_K : K) = ((a - b : ℕ) : ℤ) + (d_b : ℤ) := by
    dsimp only [δ_K]
    rw [Units.val_mul, hval_mul_K _ _ (Units.ne_zero _) (Units.ne_zero _), hu_K_val, hϖK_pow_val d_b]
  have hϖK_db_norm : normLM F hLK (((ϖ_K ^ d_b : Kˣ) : K)) = (δ_b : L) := by
    have h : Units.map (normLM F hLK) (ϖ_K ^ d_b) = δ_b := by
      rw [map_pow, hϖ_norm]
    exact congrArg Units.val h
  have hu_K_norm_coe : normLM F hLK (u_K : K) = (δ : L) :=
    congrArg Units.val hu_K_norm
  let x_r : L := (δ_b : L) * r ^ 2
  let z_r : K := ((ϖ_K ^ d_b : Kˣ) : K) * IntermediateField.inclusion hLK r
  let y_r : K := (δ_K : K) * IntermediateField.inclusion hLK r
  have hy_r_eq_uK_zr : y_r = (u_K : K) * z_r := by
    dsimp only [y_r, z_r, δ_K]
    rw [Units.val_mul, mul_assoc]
  have huK_inv_yr : ((u_K⁻¹ : Kˣ) : K) * y_r = z_r := by
    have h_inv : ((u_K⁻¹ : Kˣ) : K) * (u_K : K) = 1 := Units.inv_mul u_K
    rw [hy_r_eq_uK_zr, ← mul_assoc, h_inv, one_mul]
  have hzr_norm : normLM F hLK z_r = x_r := by
    dsimp only [z_r, x_r]
    rw [map_mul, hϖK_db_norm, hnorm_incl r]
  have hyr_norm : normLM F hLK y_r = (δ : L) * x_r := by
    rw [hy_r_eq_uK_zr, map_mul, hu_K_norm_coe, hzr_norm]
  have hx_r_Pd : P_L (d_b : ℤ) x_r :=
    hPL_mono (by omega) (hPL_mul (hPL_of_val hδb_val) (hPL_sq hr_int))
  have hx_r_P1 : P_L 1 x_r := hPL_mono (by omega) hx_r_Pd
  have hz_r_Pd : P_K (d_b : ℤ) z_r :=
    hPK_mono (by omega) (hPK_mul (hPK_of_val (hϖK_pow_val d_b)) (hP_incl hr_int))
  have hz_r_P1 : P_K 1 z_r := hPK_mono (by omega) hz_r_Pd
  have hy_r_PdK : P_K (((a - b : ℕ) : ℤ) + (d_b : ℤ)) y_r :=
    hPK_mono (by omega) (hPK_mul (hPK_of_val hδK_val) (hP_incl hr_int))
  have hy_r_P1 : P_K 1 y_r := hPK_mono (by omega) hy_r_PdK
  have hny_r_PdK : P_L (((a - b : ℕ) : ℤ) + (d_b : ℤ)) ((δ : L) * x_r) :=
    hPL_mul (hPL_of_val hδ_val) hx_r_Pd
  have hny_r_Pr0a : P_L (r0_a : ℤ) ((δ : L) * x_r) := hPL_mono (by omega) hny_r_PdK
  have hny_r_P1 : P_L 1 ((δ : L) * x_r) := hPL_mono (by omega) hny_r_PdK
  have hr_K : 1 + y_r ≠ 0 := h1_add_ne_K hy_r_P1
  have hr_2 : 1 + x_r ≠ 0 := h1_add_ne_L hx_r_P1
  have hz_r_ne : 1 + z_r ≠ 0 := h1_add_ne_K hz_r_P1
  let T_z : L := traceLM F hLK z_r
  let T_y : L := traceLM F hLK y_r
  have hTz_Pr0b : P_L (r0_b : ℤ) T_z := by
    apply htr_bound (r0_b : ℤ) z_r
    rw [hp2]
    exact hPK_mono (by omega) hz_r_Pd
  have hTz_P1 : P_L 1 T_z := hPL_mono (by omega) hTz_Pr0b
  have hTy_Pr0a : P_L (r0_a : ℤ) T_y := by
    apply htr_bound (r0_a : ℤ) y_r
    rw [hp2]
    exact hPK_mono (by omega) hy_r_PdK
  have hTy_P1 : P_L 1 T_y := hPL_mono (by omega) hTy_Pr0a
  let w_y : Kˣ := Units.mk0 (1 + y_r) hr_K
  let N_y : Lˣ := Units.map (normLM F hLK) w_y
  have hNy_coe : (N_y : L) = 1 + T_y + (δ : L) * x_r := by
    change normLM F hLK (1 + y_r) = 1 + T_y + (δ : L) * x_r
    have h1 := hnorm_add 1 y_r
    rw [map_one (IntermediateField.inclusion hLK), one_pow, one_mul, hyr_norm] at h1
    exact h1
  have hTy_ne : 1 + T_y ≠ 0 := h1_add_ne_L hTy_P1
  have hny_ne : 1 + (δ : L) * x_r ≠ 0 := h1_add_ne_L hny_r_P1
  let u1_y : Lˣ := Units.mk0 (1 + T_y) hTy_ne
  let u2_y : Lˣ := Units.mk0 (1 + (δ : L) * x_r) hny_ne
  have hu12_y_val : valL F L ((u1_y * u2_y : Lˣ) : L) = 0 := by
    rw [Units.val_mul, hval_mul_L _ _ (Units.ne_zero _) (Units.ne_zero _)]
    dsimp only [u1_y, u2_y]
    rw [Units.val_mk0, Units.val_mk0, h1_add_val_L hTy_P1, h1_add_val_L hny_r_P1, add_zero]
  have hpoly_y : (N_y : L) - ((u1_y * u2_y : Lˣ) : L) = -(T_y * ((δ : L) * x_r)) := by
    rw [hNy_coe]
    dsimp only [u1_y, u2_y]
    rw [Units.val_mul, Units.val_mk0, Units.val_mk0]
    ring
  have hpoly_y_Pa : P_L (a : ℤ) ((N_y : L) - ((u1_y * u2_y : Lˣ) : L)) := by
    rw [hpoly_y]
    exact hPL_neg (hPL_mono (by omega) (hPL_mul hTy_Pr0a hny_r_PdK))
  have hχ'_Ny_eq : χ' N_y = χ' (u1_y * u2_y) := hχ'_congr hu12_y_val hpoly_y_Pa
  have hχ'_u1y : (χ' u1_y : Ω F) = ψ (A_χ * T_y) :=
    hc_χ'_stat T_y hTy_Pr0a hTy_ne
  have hχ'_u2y : (χ' u2_y : Ω F) = ψ (A_ν * x_r) := by
    have hstat := hc_χ'_stat ((δ : L) * x_r) hny_r_Pr0a hny_ne
    change (χ' u2_y : Ω F) = ψ (A_χ * ((δ : L) * x_r)) at hstat
    rw [hstat, ← mul_assoc, ← hA_ν_eq]
  have hχ'K_wy : ((χ'.comp (Units.map (normLM F hLK))) w_y : Ω F) =
      ψ (A_χ * T_y) * ψ (A_ν * x_r) := by
    change (χ' N_y : Ω F) = _
    rw [hχ'_Ny_eq, map_mul, Units.val_mul, hχ'_u1y, hχ'_u2y]
  have hc_K_inv_coe : ((c_K⁻¹ : Kˣ) : K) =
      IntermediateField.inclusion hLK A_χ * (u_corr : K) := by
    have h : c_K⁻¹ = (Units.map (IntermediateField.inclusion hLK) c_χ'⁻¹) * u_corr := by
      rw [hc_K_eq, mul_inv_rev, inv_inv, ← map_inv, mul_comm]
    exact congrArg Units.val h
  have hcK_inv_yr : ((c_K⁻¹ : Kˣ) : K) * y_r =
      IntermediateField.inclusion hLK A_χ * y_r -
        IntermediateField.inclusion hLK A_ν * z_r := by
    have h_incl_Aν : IntermediateField.inclusion hLK A_ν =
        IntermediateField.inclusion hLK A_χ * IntermediateField.inclusion hLK (δ : L) := by
      rw [hA_ν_eq, map_mul]
    calc ((c_K⁻¹ : Kˣ) : K) * y_r
      _ = IntermediateField.inclusion hLK A_χ * ((u_corr : K) * y_r) := by
        rw [hc_K_inv_coe, mul_assoc]
      _ = IntermediateField.inclusion hLK A_χ *
            (y_r - IntermediateField.inclusion hLK (δ : L) * (((u_K⁻¹ : Kˣ) : K) * y_r)) := by
        rw [hu_corr_eq, sub_mul, one_mul, mul_assoc]
      _ = IntermediateField.inclusion hLK A_χ *
            (y_r - IntermediateField.inclusion hLK (δ : L) * z_r) := by
        rw [huK_inv_yr]
      _ = IntermediateField.inclusion hLK A_χ * y_r -
            (IntermediateField.inclusion hLK A_χ * IntermediateField.inclusion hLK (δ : L)) * z_r := by
        ring
      _ = IntermediateField.inclusion hLK A_χ * y_r -
            IntermediateField.inclusion hLK A_ν * z_r := by
        rw [← h_incl_Aν]
  have htr_cK_yr : traceLM F hLK (((c_K⁻¹ : Kˣ) : K) * y_r) =
      A_χ * T_y + (-(A_ν * T_z)) := by
    rw [hcK_inv_yr, map_sub, htr_smul A_χ y_r, htr_smul A_ν z_r, sub_eq_add_neg]
  have htrChar_yr : (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * y_r) =
      ψ (A_χ * T_y) * ψ (-(A_ν * T_z)) := by
    change ψ (traceLM F hLK (((c_K⁻¹ : Kˣ) : K) * y_r)) = _
    rw [htr_cK_yr, ψ.map_add_eq_mul]
  let w_z : Kˣ := Units.mk0 (1 + z_r) hz_r_ne
  let N_z : Lˣ := Units.map (normLM F hLK) w_z
  have hν₁_Nz : ν₁ N_z = 1 := (hν₁_ker N_z).mp ⟨w_z, rfl⟩
  have hNz_coe : (N_z : L) = 1 + T_z + x_r := by
    change normLM F hLK (1 + z_r) = 1 + T_z + x_r
    have h1 := hnorm_add 1 z_r
    rw [map_one (IntermediateField.inclusion hLK), one_pow, one_mul, hzr_norm] at h1
    exact h1
  have hTz_ne : 1 + T_z ≠ 0 := h1_add_ne_L hTz_P1
  let v1_z : Lˣ := Units.mk0 (1 + x_r) hr_2
  let v2_z : Lˣ := Units.mk0 (1 + T_z) hTz_ne
  have hv12_z_val : valL F L ((v1_z * v2_z : Lˣ) : L) = 0 := by
    rw [Units.val_mul, hval_mul_L _ _ (Units.ne_zero _) (Units.ne_zero _)]
    dsimp only [v1_z, v2_z]
    rw [Units.val_mk0, Units.val_mk0, h1_add_val_L hx_r_P1, h1_add_val_L hTz_P1, add_zero]
  have hpoly_z : (N_z : L) - ((v1_z * v2_z : Lˣ) : L) = -(x_r * T_z) := by
    rw [hNz_coe]
    dsimp only [v1_z, v2_z]
    rw [Units.val_mul, Units.val_mk0, Units.val_mk0]
    ring
  have hpoly_z_Pb : P_L (b : ℤ) ((N_z : L) - ((v1_z * v2_z : Lˣ) : L)) := by
    rw [hpoly_z]
    exact hPL_neg (hPL_mono (by omega) (hPL_mul hx_r_Pd hTz_Pr0b))
  have hν₁_Nz_eq : ν₁ N_z = ν₁ (v1_z * v2_z) := hν₁_congr hv12_z_val hpoly_z_Pb
  have hν₁_v2z : (ν₁ v2_z : Ω F) = ψ (A_ν * T_z) :=
    hc_ν₁_stat T_z hTz_Pr0b hTz_ne
  have hν₁_prod_one : (ν₁ v1_z : Ω F) * ψ (A_ν * T_z) = 1 := by
    rw [← hν₁_v2z, ← Units.val_mul, ← map_mul, ← hν₁_Nz_eq, hν₁_Nz, Units.val_one]
  have hψ_cancel_Tz : ψ (A_ν * T_z) * ψ (-(A_ν * T_z)) = 1 := by
    rw [← ψ.map_add_eq_mul, add_neg_cancel, ψ.map_zero_eq_one]
  have hψ_neg_Tz : ψ (-(A_ν * T_z)) = (ν₁ v1_z : Ω F) := by
    calc ψ (-(A_ν * T_z))
      _ = 1 * ψ (-(A_ν * T_z)) := (one_mul _).symm
      _ = ((ν₁ v1_z : Ω F) * ψ (A_ν * T_z)) * ψ (-(A_ν * T_z)) := by rw [hν₁_prod_one]
      _ = (ν₁ v1_z : Ω F) * (ψ (A_ν * T_z) * ψ (-(A_ν * T_z))) := by ring
      _ = (ν₁ v1_z : Ω F) * 1 := by rw [hψ_cancel_Tz]
      _ = (ν₁ v1_z : Ω F) := mul_one _
  have hψ_Ty_ne0 : ψ (A_χ * T_y) ≠ 0 := by
    intro h0
    have h1 : ψ (A_χ * T_y) * ψ (-(A_χ * T_y)) = 1 := by
      rw [← ψ.map_add_eq_mul, add_neg_cancel, ψ.map_zero_eq_one]
    rw [h0, zero_mul] at h1
    exact zero_ne_one h1
  have hψ_Ty_inv_cancel : (ψ (A_χ * T_y))⁻¹ * ψ (A_χ * T_y) = 1 :=
    inv_mul_cancel₀ hψ_Ty_ne0
  have h_lhs_assoc : ((c_K⁻¹ : Kˣ) : K) * ((u_K * ϖ_K ^ (condExp F L ν₁ / 2) : Kˣ) : K) *
      IntermediateField.inclusion hLK r = ((c_K⁻¹ : Kˣ) : K) * y_r := by
    dsimp only [y_r, δ_K, d_b, b]
    rw [mul_assoc]
  have h_rhs_assoc : ((c_ν₁⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r ^ 2 =
      A_ν * x_r := by
    dsimp only [A_ν, x_r, δ_b, d_b, b]
    rw [mul_assoc]
  rw [h_lhs_assoc, h_rhs_assoc]
  change (if hr_K' : 1 + y_r ≠ 0 then
      ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + y_r) hr_K') : Ω F)⁻¹ *
        (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * y_r)
    else 0) =
    (if hr_2' : 1 + x_r ≠ 0 then
      (ν₁ (Units.mk0 (1 + x_r) hr_2') : Ω F) * (ψ (A_ν * x_r))⁻¹
    else 0)
  rw [dif_pos hr_K, dif_pos hr_2]
  change ((χ'.comp (Units.map (normLM F hLK))) w_y : Ω F)⁻¹ *
      (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * y_r) =
    (ν₁ v1_z : Ω F) * (ψ (A_ν * x_r))⁻¹
  rw [hχ'K_wy, htrChar_yr, hψ_neg_Tz, mul_inv]
  calc (ψ (A_χ * T_y))⁻¹ * (ψ (A_ν * x_r))⁻¹ * (ψ (A_χ * T_y) * (ν₁ v1_z : Ω F))
    _ = ((ψ (A_χ * T_y))⁻¹ * ψ (A_χ * T_y)) * ((ν₁ v1_z : Ω F) * (ψ (A_ν * x_r))⁻¹) := by ring
    _ = 1 * ((ν₁ v1_z : Ω F) * (ψ (A_ν * x_r))⁻¹) := by rw [hψ_Ty_inv_cancel]
    _ = (ν₁ v1_z : Ω F) * (ψ (A_ν * x_r))⁻¹ := one_mul _

theorem ld_wild_mid_cond_dyadic_K_and_nu_prod_eval (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hp2 : Module.finrank L (IntermediateField.extendScalars hLK) = 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hba : condExp F L ν₁ < condExp F L χ')
    (haK : condExp F K (χ'.comp (Units.map (normLM F hLK))) =
      condExp F L ν₁ +
        Module.finrank L (IntermediateField.extendScalars hLK) *
          (condExp F L χ' - condExp F L ν₁))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
