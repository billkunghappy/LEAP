        have hηr : η ^ (p - (r + 1)) = 0 ∨
            ((p - (r + 1) : ℕ) : ℤ) * ((p : ℤ) * q₀) ≤ vK₁ (η ^ (p - (r + 1))) :=
          hvalK₁_pow_ge η (p - (r + 1)) ((p : ℤ) * q₀) hη_q₀
        have hprod1 := hvalK₁_mul_ge
          (((r + 1 : ℕ) : ℤ) * ((p : ℤ) * q₀))
          (((p - (r + 1) : ℕ) : ℤ) * ((p : ℤ) * q₀))
          (v ^ (r + 1)) (η ^ (p - (r + 1))) hvr hηr
        have hprod2 := hvalK₁_mul_ge
          ((((r + 1 : ℕ) : ℤ) * ((p : ℤ) * q₀)) + (((p - (r + 1) : ℕ) : ℤ) * ((p : ℤ) * q₀)))
          ((p : ℤ) * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ))
          (v ^ (r + 1) * η ^ (p - (r + 1))) ((p.choose (r + 1) : ℕ) : R_K)
          hprod1 hchoose_val
        apply hvalK₁_mono ((p : ℤ) * M_η) _ _ _ hprod2
        have hsum_r : (((r + 1 : ℕ) : ℤ) * ((p : ℤ) * q₀)) + (((p - (r + 1) : ℕ) : ℤ) * ((p : ℤ) * q₀)) =
            (p : ℤ) * ((p : ℤ) * q₀) := by
          rw [Nat.cast_sub (by omega : r + 1 ≤ p), ← add_mul, add_sub_cancel]
        rw [hsum_r]
        have hMη_le : M_η ≤ (p : ℤ) * q₀ + ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) := by
          have hnat : p * (p - 1) * δ + (p - 1) * t₁ ≤ p * ((p - 1) * δ) + (p - 1) * t₂ := by
            have ht_mul : (p - 1) * t₁ ≤ (p - 1) * t₂ := Nat.mul_le_mul_left (p - 1) ht_le
            rw [← Nat.mul_assoc]
            omega
          have hz : ((p * (p - 1) * δ + (p - 1) * t₁ : ℕ) : ℤ) ≤
              ((p * ((p - 1) * δ) + (p - 1) * t₂ : ℕ) : ℤ) := by
            exact_mod_cast hnat
          rw [← hM_η_def, Nat.cast_add, Nat.cast_mul, Nat.cast_mul, ← hq₀_def, Nat.cast_mul] at hz
          exact hz
        have hmul_p := Int.mul_le_mul_of_nonneg_left hMη_le (Nat.cast_nonneg p)
        rw [mul_add, ← mul_assoc (p : ℤ) ((p - 1 : ℕ) : ℤ) (t₂ : ℤ)] at hmul_p
        exact hmul_p
      have hup_vp : u ^ p - v ^ p = 0 ∨ (p : ℤ) * M_η ≤ vK₁ (u ^ p - v ^ p) := by
        rw [hbinom]
        exact hvalK₁_add ((p : ℤ) * M_η) _ _ hη_pow hmid_sum
      have hvp_norm :
          v ^ p - iM₁'K₁ (iLM₁' (nmLE' s₀)) = 0 ∨
            (p : ℤ) * M_η ≤ vK₁ (v ^ p - iM₁'K₁ (iLM₁' (nmLE' s₀))) := by
        have hc_s₀ := hcayley_rem_val s₀ q₀ hs₀_val'
        have hcoerc :
            v ^ p - iM₁'K₁ (iLM₁' (nmLE' s₀)) =
              iE'K₁ (s₀ ^ p - iLE' (nmLE' s₀)) := by
          rw [hv_def, map_sub, map_pow, hincl_comm]
        rw [hcoerc]
        rcases hc_s₀ with hc0 | hc_ge
        · left; rw [hc0, map_zero]
        · right
          rw [hval_E'K₁]
          have hMη_le : M_η ≤ (p : ℤ) * q₀ + ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) := by
            have hnat : p * (p - 1) * δ + (p - 1) * t₁ ≤ p * ((p - 1) * δ) + (p - 1) * t₂ := by
              have ht_mul : (p - 1) * t₁ ≤ (p - 1) * t₂ := Nat.mul_le_mul_left (p - 1) ht_le
              rw [← Nat.mul_assoc]
              omega
            have hz : ((p * (p - 1) * δ + (p - 1) * t₁ : ℕ) : ℤ) ≤
                ((p * ((p - 1) * δ) + (p - 1) * t₂ : ℕ) : ℤ) := by
              exact_mod_cast hnat
            rw [← hM_η_def, Nat.cast_add, Nat.cast_mul, Nat.cast_mul, ← hq₀_def, Nat.cast_mul] at hz
            exact hz
          exact Int.mul_le_mul_of_nonneg_left (le_trans hMη_le hc_ge) (Nat.cast_nonneg p)
      have hsum_K₁ := hvalK₁_add ((p : ℤ) * M_η) _ _ hup_vp hvp_norm
      have hsum_eq :
          (u ^ p - v ^ p) + (v ^ p - iM₁'K₁ (iLM₁' (nmLE' s₀))) =
            iM₁'K₁ (s₁ ^ p - iLM₁' (nmLE' s₀)) := by
        rw [sub_add_sub_cancel, hu_def, map_sub, map_pow]
      rw [hsum_eq] at hsum_K₁
      rcases hsum_K₁ with h0 | hge
      · left
        exact (map_eq_zero_iff iM₁'K₁ hiM₁'K₁).mp h0
      · right
        rw [hval_M₁'K₁] at hge
        exact le_of_mul_le_mul_left hge (by omega : (0 : ℤ) < (p : ℤ))
    have hvalL_of_valM₁' : ∀ y_L : R_L,
        (iLM₁' y_L = 0 ∨ ((p * t₂ + 1 : ℕ) : ℤ) ≤ vM₁' (iLM₁' y_L)) →
        (y_L = 0 ∨ (bE' : ℤ) ≤ vL y_L) := by
      intro y_L hy
      rcases hy with h0 | hge
      · left
        exact (map_eq_zero_iff iLM₁' hiLM₁').mp h0
      · right
        rw [hval_LM₁'] at hge
        by_contra! hlt
        have hle : vL y_L ≤ (t₂ : ℤ) := by omega
        have hmul : (p : ℤ) * vL y_L ≤ (p : ℤ) * (t₂ : ℤ) :=
          Int.mul_le_mul_of_nonneg_left hle (Nat.cast_nonneg p)
        push_cast at hge
        omega
    refine ⟨hConj1, ?_⟩
    intro j x hx k X z_j
    have hx' : x = 0 ∨ (d₁ : ℤ) ≤ (p : ℤ) * vE' x - ((j : ℕ) : ℤ) * (t₁ : ℤ) := by
      rw [ht₁_def]; exact hx
    obtain ⟨hx_ge1, htr_rem⟩ := hcayley_tr_x (j : ℕ) x hx'
    obtain ⟨D_k, hDk_def⟩ : ∃ D_k : R_L, D_k = X * (trLM₁' (b ^ k) - trLE' (a ^ k)) := ⟨_, rfl⟩
    have hh_sub_Dk : h_fn z_j - D_k = 0 ∨ (bE' : ℤ) ≤ vL (h_fn z_j - D_k) := by
      have hmono := hh_fn_mono (j : ℕ) x
      dsimp only at hmono
      have heq : h_fn z_j - D_k = - trLE' ((x ^ p - iLE' X) * a ^ k) := by
        rw [hDk_def]
        dsimp only [z_j, X, k]
        rw [hmono]
        ring
      rw [heq]
      rcases htr_rem with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rwa [hvalL_neg]
    have hX_M₁'_nonneg :
        iLM₁' X = 0 ∨ (0 : ℤ) ≤ vM₁' (iLM₁' X) := by
      rcases hx_ge1 with rfl | hvx
      · left; dsimp [X]; rw [hnorm_zero_LE', map_zero]
      · right
        dsimp [X]
        rw [hval_LM₁', hval_norm_LE']
        exact mul_nonneg (Nat.cast_nonneg p) (le_trans (by decide : (0 : ℤ) ≤ 1) hvx)
    have hUQ :
        iLM₁' X * (Q k - iLM₁' (trLE' (a ^ k))) = 0 ∨
        ((p * t₂ + 1 : ℕ) : ℤ) ≤ vM₁' (iLM₁' X * (Q k - iLM₁' (trLE' (a ^ k)))) := by
      have hmul := hvalM₁'_mul_ge 0 ((p * t₂ + 1 : ℕ) : ℤ)
        (iLM₁' X) (Q k - iLM₁' (trLE' (a ^ k)))
        hX_M₁'_nonneg (hQk_approx j)
      rwa [zero_add] at hmul
    refine ⟨?_, ?_⟩
    · intro _ hU1
      rw [← ht₂_def] at hU1
      have hsum := hvalM₁'_add ((p * t₂ + 1 : ℕ) : ℤ) _ _ hU1 hUQ
      have hring :
          iLM₁' X * (iLM₁' (trLM₁' (b ^ k)) - Q k) +
          iLM₁' X * (Q k - iLM₁' (trLE' (a ^ k))) =
          iLM₁' D_k := by
        rw [hDk_def, map_mul, map_sub]
        ring
      rw [hring] at hsum
      have hDk_L := hvalL_of_valM₁' D_k hsum
      have hfinal := hvalL_add (bE' : ℤ) (h_fn z_j - D_k) D_k hh_sub_Dk hDk_L
      rwa [sub_add_cancel] at hfinal
    · intro hj_eq hU2
      rw [← ht₂_def, ← hs₁_def] at hU2
      obtain ⟨C_0, hC0_def⟩ : ∃ C_0 : R_L,
          C_0 = ((p - 1 : ℕ) : R_L) * (nmLE' x - nmLE' (x * s₀)) := ⟨_, rfl⟩
      rw [← hC0_def]
      have hX_M₁'_val :
          iLM₁' X = 0 ∨
            (d₁ : ℤ) + ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ) ≤ vM₁' (iLM₁' X) := by
        rcases hx' with rfl | hvx_ge
        · left; dsimp [X]; rw [hnorm_zero_LE', map_zero]
        · right
          rw [hj_eq] at hvx_ge
          dsimp [X]
          rw [hval_LM₁', hval_norm_LE']
          omega
      have hUs₀_1 := hvalM₁'_mul_ge
        ((d₁ : ℤ) + ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ)) M_η
        (iLM₁' X) (s₁ ^ p - iLM₁' (nmLE' s₀))
        hX_M₁'_val hs1_pow_approx
      have hUs₀_2 := hvalM₁'_mul_ge 0
        (((d₁ : ℤ) + ((p - 2 : ℕ) : ℤ) * (t₁ : ℤ)) + M_η)
        ((p - 1 : ℕ) : R_M)
        (iLM₁' X * (s₁ ^ p - iLM₁' (nmLE' s₀)))
        (hvalM₁'_natCast (p - 1)) hUs₀_1
      have hUs₀ :
          ((p - 1 : ℕ) : R_M) * (iLM₁' X * (s₁ ^ p - iLM₁' (nmLE' s₀))) = 0 ∨
          ((p * t₂ + 1 : ℕ) : ℤ) ≤
            vM₁' (((p - 1 : ℕ) : R_M) * (iLM₁' X * (s₁ ^ p - iLM₁' (nmLE' s₀)))) := by
        apply hvalM₁'_mono ((p * t₂ + 1 : ℕ) : ℤ) _ _ _ hUs₀_2
        have ht₁_sum : p * t₁ ≤ (p - 2) * t₁ + (p - 1) * t₁ := by
          have hp_le : p ≤ (p - 2) + (p - 1) := by omega
          calc p * t₁ ≤ ((p - 2) + (p - 1)) * t₁ := Nat.mul_le_mul_right t₁ hp_le
            _ = (p - 2) * t₁ + (p - 1) * t₁ := Nat.add_mul (p - 2) (p - 1) t₁
        have hδ_mul : p * δ ≤ p * (p - 1) * δ := by
          have h1 : 1 ≤ p - 1 := by omega
          have h2 : p * 1 ≤ p * (p - 1) := Nat.mul_le_mul_left p h1
          rw [Nat.mul_one] at h2
          exact Nat.mul_le_mul_right δ h2
        have hnat_ineq : p * t₂ + 1 ≤ d₁ + ((p - 2) * t₁ + (p * (p - 1) * δ + (p - 1) * t₁)) := by
          rw [ht₂_eq, Nat.mul_add]
          omega
        have hz_ineq : ((p * t₂ + 1 : ℕ) : ℤ) ≤
            ((d₁ + ((p - 2) * t₁ + (p * (p - 1) * δ + (p - 1) * t₁)) : ℕ) : ℤ) :=
          Int.ofNat_le.mpr hnat_ineq
        rw [Nat.cast_add d₁, Nat.cast_add ((p - 2) * t₁), Nat.cast_mul (p - 2) t₁, ← hM_η_def] at hz_ineq
        omega
      have hsum1 := hvalM₁'_add ((p * t₂ + 1 : ℕ) : ℤ) _ _ hU2 hUQ
      have hdiff1 := hvalM₁'_sub ((p * t₂ + 1 : ℕ) : ℤ) _ _ hsum1 hUs₀
      have hC0_eq : C_0 = X * (((p - 1 : ℕ) : R_L) * (1 - nmLE' s₀)) := by
        rw [hC0_def]
        dsimp only [X]
        rw [map_mul nmLE' x s₀]
        ring
      have hring2 :
          (iLM₁' X *
            (iLM₁' (trLM₁' (b ^ k)) - Q k -
              ((p - 1 : ℕ) : R_M) * (1 - s₁ ^ p)) +
          iLM₁' X *
            (Q k - iLM₁' (trLE' (a ^ k)))) -
          ((p - 1 : ℕ) : R_M) *
            (iLM₁' X * (s₁ ^ p - iLM₁' (nmLE' s₀))) =
          iLM₁' (D_k - C_0) := by
        rw [hC0_eq, hDk_def, map_sub, map_mul, map_sub, map_mul, map_mul, map_natCast,
          map_sub, map_one]
        ring
      rw [hring2] at hdiff1
      have hDk_C0 := hvalL_of_valM₁' (D_k - C_0) hdiff1
      have hfinal := hvalL_add (bE' : ℤ) (h_fn z_j - D_k) (D_k - C_0) hh_sub_Dk hDk_C0
      rwa [sub_add_sub_cancel] at hfinal
  obtain ⟨_, _, _, hvalL_neg, hvalL_mul, _, _, hvalL_add, _, _, _⟩ := hvalL_props
  obtain ⟨_, hvalE'_1, hvalE'_neg1, _, hvalE'_mul, _, _, hvalE'_add, _, _, _⟩ := hvalE'_props
  obtain ⟨_, hvalM₁'_1, _, hvalM₁'_neg, hvalM₁'_mul, _, _, hvalM₁'_add, _, _, _⟩ := hvalM₁'_props
  obtain ⟨_, hvalK₁_1, _, _, hvalK₁_mul, _, _, hvalK₁_add, _, _, _⟩ := hvalK₁_props
  have htr_smul_LE' : ∀ (c : L) (y : E'),
      traceLM F hLE' (IntermediateField.inclusion hLE' c * y) = c * traceLM F hLE' y := by
    letI : Module L L := Semiring.toModule
    exact fun c y => (Algebra.trace L (IntermediateField.extendScalars hLE')).map_smul' c
      (toExtendScalars F hLE' y)
  have htr_smul_LM₁' : ∀ (c : L) (z : M₁'),
      traceLM F hLM₁' (IntermediateField.inclusion hLM₁' c * z) = c * traceLM F hLM₁' z := by
    letI : Module L L := Semiring.toModule
    exact fun c z => (Algebra.trace L (IntermediateField.extendScalars hLM₁')).map_smul' c
      (toExtendScalars F hLM₁' z)
  have hnorm_incl_E'K₁ : ∀ x : E',
      normLM F hE'K₁ (IntermediateField.inclusion hE'K₁ x) =
        x ^ (Module.finrank L (IntermediateField.extendScalars hLE')) := by
    intro x
    have h1 : normLM F hE'K₁ (IntermediateField.inclusion hE'K₁ x) =
        (Algebra.norm E' (S := IntermediateField.extendScalars hE'K₁))
          ((algebraMap E' (IntermediateField.extendScalars hE'K₁)) x) := rfl
    rw [h1, Algebra.norm_algebraMap, hdegE'K₁]
  have htr1_LE' : traceLM F hLE' (1 : E') =
      ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : L) := by
    have h1 : traceLM F hLE' (1 : E') =
        (Algebra.trace L (IntermediateField.extendScalars hLE'))
          ((algebraMap L (IntermediateField.extendScalars hLE')) 1) := rfl
    rw [h1, Algebra.trace_algebraMap, nsmul_one]
  have hincl_comm : ∀ x : L,
      IntermediateField.inclusion hM₁'K₁ (IntermediateField.inclusion hLM₁' x) =
        IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' x) := fun _ => rfl
  exact hAbstract
    (IntermediateField.inclusion hLE').toRingHom
    (IntermediateField.inclusion hLM₁').toRingHom
    (IntermediateField.inclusion hE'K₁).toRingHom
    (IntermediateField.inclusion hM₁'K₁).toRingHom
    (IntermediateField.inclusion hLE').injective
    (IntermediateField.inclusion hLM₁').injective
    (IntermediateField.inclusion hM₁'K₁).injective
    (valL F L) (valL F E') (valL F M₁') (valL F K₁)
    (traceLM F hLE') (traceLM F hLM₁') (traceLM F hM₁'K₁)
    (normLM F hLE') (normLM F hE'K₁) (normLM F hM₁'K₁)
    (Module.finrank L (IntermediateField.extendScalars hLE'))
    hPrime hp_odd bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le
    hvalL_neg hvalL_mul hvalL_add
    hvalE'_1 hvalE'_neg1 hvalE'_mul hvalE'_add
    hvalM₁'_1 hvalM₁'_neg hvalM₁'_mul hvalM₁'_add
    hvalK₁_1 hvalK₁_mul hvalK₁_add
    hval_LE' hval_norm_LE' hval_LM₁' hval_E'K₁ hval_norm_E'K₁ hval_M₁'K₁
    htr_LE' htr_M₁'K₁ hDiamond_E'
    s_LE' hsLE'_val hsLE'_cayley
    (Δ : K₁) hΔ_val hΔ_as e_Δ s₀ hs₀_val hs₀_approx hTrNormCongr
    htr_smul_LE' htr_smul_LM₁' hnorm_incl_E'K₁ htr1_LE' hincl_comm

theorem ld_ch12_wild_odd_tot_ram_galois_lift_and_unit_diff_ne_zero (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLM₁' : IsGaloisExt F L M₁') (hGalE'K₁ : IsGaloisExt F E' K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
