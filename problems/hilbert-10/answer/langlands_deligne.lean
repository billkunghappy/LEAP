theorem ld_ch12_wild_odd_totally_ramified_higher_cond_twist_eval (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hAbLE' : IsAbelianExt F hLE') (hAbLM₁' : IsAbelianExt F hLM₁')
    (hAbE'K₁ : IsAbelianExt F hE'K₁) (hAbM₁'K₁ : IsAbelianExt F hM₁'K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (h_inf : E' ⊓ M₁' = L) (h_sup : E' ⊔ M₁' = K₁)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (hψK₁ : IsAdmissibleChar F K₁ (traceChar F (hLE'.trans hE'K₁) ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
    (hMinM₁' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE') ∧
      condExp F L (νM₁' ^ j * νE') = condExp F L νE')
    (hMinE' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νE' ^ j * νM₁') ∧
      (0 < j → condExp F L (νE' ^ j * νM₁') = condExp F L νE'))
    (hLamp4 : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ (θ : Mˣ →* (Ω F)ˣ), 2 ≤ condExp F M θ →
      (∀ u ∈ unitGroup F M (condExp F M θ), θ u = 1) →
      let m := condExp F M θ
      let d := m / 2
      (∃ c_θ : Mˣ,
        valL F M (c_θ : M) = (m : ℤ) + condExpChar F M ψ_M ∧
        ∀ x : M, (x = 0 ∨ (d : ℤ) ≤ valL F M x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
              ψ_M (((c_θ⁻¹ : Mˣ) : M) * (2 * x - x ^ 2))) ∧
      (∀ (c : Mˣ) (η : M),
        valL F M (c : M) = (m : ℤ) + condExpChar F M ψ_M →
        (η = 0 ∨ (d : ℤ) ≤ valL F M η) →
        (∀ x : M, (x = 0 ∨ (d : ℤ) ≤ valL F M x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
              ψ_M (((c⁻¹ : Mˣ) : M) * (1 + η) * (2 * x - x ^ 2))) →
        (tateEps F M θ ψ_M) ^ 4 =
          ((qL F M : Ω F) ^ (4 * condExpChar F M ψ_M + 2 * (m : ℤ))) *
            (θ c : Ω F) ^ 4 *
            (ψ_M (((c⁻¹ : Mˣ) : M) * (2 - η ^ 2))) ^ 2))
    (θ₁ χ₁ : M₁'ˣ →* (Ω F)ˣ) (θ₂ χ₂ : E'ˣ →* (Ω F)ˣ) (lam_L : Lˣ →* (Ω F)ˣ)
    (hθ₁_eq : θ₁ = χ₁ * lam_L.comp (Units.map (normLM F hLM₁')))
    (hθ₂_eq : θ₂ = χ₂ * lam_L.comp (Units.map (normLM F hLE')))
    (hχ_comp : χ₂.comp (Units.map (normLM F hE'K₁)) = χ₁.comp (Units.map (normLM F hM₁'K₁)))
    (hχ_rest : ∀ x : Lˣ,
      χ₂ (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) =
        χ₁ (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x))
    (hm₁_χ₁ : condExp F M₁' χ₁ =
      2 * condExp F L νM₁' - 1 +
        Module.finrank L (IntermediateField.extendScalars hLE') *
          (condExp F L νE' - condExp F L νM₁'))
    (hm₂_χ₂ : condExp F E' χ₂ = condExp F L νE' + condExp F L νM₁' - 1)
    (hχK₁_cond0 : ∀ u ∈ unitGroup F K₁ (condExp F K₁ (χ₂.comp (Units.map (normLM F hE'K₁)))),
      (χ₂.comp (Units.map (normLM F hE'K₁))) u = 1)
    (hχ₂_twists : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
      let m₂ := condExp F L νE' + condExp F L νM₁' - 1
      condExp F E' (ξE' ^ j * χ₂) = m₂ ∧
      (∀ u ∈ unitGroup F E' m₂, (ξE' ^ j * χ₂) u = 1) ∧
      ∃ σ : E' ≃ₐ[F] E',
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
        ∀ y : E'ˣ, (ξE' ^ j * χ₂) y = χ₂ (Units.map σ.toRingEquiv.toMonoidHom y))
    (hχ₁_twists : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
      let m₁ := 2 * condExp F L νM₁' - 1 +
        Module.finrank L (IntermediateField.extendScalars hLE') *
          (condExp F L νE' - condExp F L νM₁')
      condExp F M₁' (ξM₁' ^ j * χ₁) = m₁ ∧
      (∀ u ∈ unitGroup F M₁' m₁, (ξM₁' ^ j * χ₁) u = 1) ∧
      ∃ τ : M₁' ≃ₐ[F] M₁',
        (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) ∧
        ∀ z : M₁'ˣ, (ξM₁' ^ j * χ₁) z = χ₁ (Units.map τ.toRingEquiv.toMonoidHom z))
    (hbE'_lt_lam : condExp F L νE' < condExp F L lam_L)
    (hpm_gt_t₁ : condExp F L νM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') *
        (condExp F L lam_L - condExp F L νE'))
    (hνE'_lam_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j * lam_L)), (νE' ^ j * lam_L) u = 1)
    (hνM₁'_lam_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * lam_L)), (νM₁' ^ j * lam_L) u = 1)
    (hmE'_eq : condExp F E' θ₂ =
      condExp F L νE' +
        Module.finrank L (IntermediateField.extendScalars hLE') *
          (condExp F L lam_L - condExp F L νE'))
    (hmM₁'_eq : condExp F M₁' θ₁ =
      condExp F L νM₁' +
        Module.finrank L (IntermediateField.extendScalars hLE') *
          (condExp F L lam_L - condExp F L νM₁')) :
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    ∃ (cE' : E'ˣ) (cM₁' : M₁'ˣ),
      valL F E' (cE' : E') = (condExp F E' θ₂ : ℤ) + condExpChar F E' ψE' ∧
      (∀ x : E', (x = 0 ∨ ((condExp F E' θ₂ / 2 : ℕ) : ℤ) ≤ valL F E' x) →
        ∀ hx : 1 + x ≠ 0,
          (θ₂ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
            ψE' (((cE'⁻¹ : E'ˣ) : E') * (2 * x - x ^ 2))) ∧
      valL F M₁' (cM₁' : M₁') = (condExp F M₁' θ₁ : ℤ) + condExpChar F M₁' ψM₁' ∧
      (∀ z : M₁', (z = 0 ∨ ((condExp F M₁' θ₁ / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
        ∀ hz : 1 + z ≠ 0,
