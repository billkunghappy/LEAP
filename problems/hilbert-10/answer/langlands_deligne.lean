          nlinarith
  · obtain ⟨_, _, hval_neg1_E, _, hval_mul_E, hval_inv_E,
      hunit0_E, hunit_ge1_E, hunit_val0_E, _⟩ := h_valL_props E
    intro ψ_E hψE χ'_E hχ'E_cond m hm_ge2 c' hc'_val hc'_top
    set Sψ : Set ℤ := {d : ℤ | ∀ x : E, -d ≤ valL F E x → ψ_E x = 1}
    have hne_ψ : Sψ.Nonempty := by
      obtain ⟨d₀, hd₀⟩ := hψE.2
      refine ⟨-d₀, fun x hx => hd₀ x ?_⟩
      simpa using hx
    have hbdd_ψ : BddAbove Sψ := by
      have hne1 : ∃ x₀ : E, ψ_E x₀ ≠ 1 := by
        rcases DFunLike.ne_iff.mp hψE.1 with ⟨x₀, hx₀⟩
        exact ⟨x₀, by simpa [AddChar.one_apply] using hx₀⟩
      obtain ⟨x₀, hx₀⟩ := hne1
      refine ⟨-valL F E x₀ - 1, fun d hd => ?_⟩
      by_contra hlt
      have hle : -d ≤ valL F E x₀ := by omega
      exact hx₀ (hd x₀ hle)
    have hmem_ψ : condExpChar F E ψ_E ∈ Sψ := Int.csSup_mem hne_ψ hbdd_ψ
    have hψE_triv : ∀ x : E, (x = 0 ∨ -condExpChar F E ψ_E ≤ valL F E x) → ψ_E x = 1 := by
      intro x hx
      rcases hx with rfl | hx
      · exact AddChar.map_zero_eq_one ψ_E
      · exact hmem_ψ x hx
    have hnot_ψ : condExpChar F E ψ_E + 1 ∉ Sψ :=
      notMem_of_csSup_lt (lt_add_one (condExpChar F E ψ_E)) hbdd_ψ
    change ¬ (∀ x : E, -(condExpChar F E ψ_E + 1) ≤ valL F E x → ψ_E x = 1) at hnot_ψ
    push_neg at hnot_ψ
    obtain ⟨y₁_E, hy₁_E_val, hy₁_E_ψ⟩ := hnot_ψ
    have hy₁_E_ne : y₁_E ≠ 0 := by
      rintro rfl
      exact hy₁_E_ψ (AddChar.map_zero_eq_one ψ_E)
    have h_triv_m : ∀ u ∈ unitGroup F E m, χ'_E u = 1 := by
      intro u hu
      rcases (hunit_ge1_E m (by omega) u).mp hu with hu1 | hy_ge
      · have hu_eq1 : u = 1 := Units.ext hu1
        rw [hu_eq1, map_one]
      · let y : E := (u : E) - 1
        by_cases hy0 : y = 0
        · have hu_eq1 : u = 1 := Units.ext (sub_eq_zero.mp hy0)
          rw [hu_eq1, map_one]
        · have hy1 : 1 + y ≠ 0 := by
            have heq : 1 + y = (u : E) := by dsimp [y]; ring
            rw [heq]
            exact Units.ne_zero u
          have hu_mk : Units.mk0 (1 + y) hy1 = u := by
            apply Units.ext
            dsimp [y]
            ring
          have hy_m1 : y = 0 ∨ ((m - 1 : ℕ) : ℤ) ≤ valL F E y := by
            right
            change (m : ℤ) ≤ valL F E y at hy_ge
            omega
          have htop := hc'_top y hy_m1 hy1
          rw [hu_mk] at htop
          have hprod_val : (((c'⁻¹ : Eˣ) : E) * y = 0 ∨
              -condExpChar F E ψ_E ≤ valL F E (((c'⁻¹ : Eˣ) : E) * y)) := by
            right
            rw [hval_mul_E _ _ (Units.ne_zero _) hy0, hval_inv_E c', hc'_val]
            change (m : ℤ) ≤ valL F E y at hy_ge
            omega
          rw [hψE_triv _ hprod_val] at htop
          exact Units.ext htop
    have hle_m : condExp F E χ'_E ≤ m := Nat.sInf_le h_triv_m
    have hm_le : m ≤ condExp F E χ'_E := by
      by_contra h_lt
      let y₀ : E := (c' : E) * y₁_E
      have hy₀_ne : y₀ ≠ 0 := mul_ne_zero (Units.ne_zero c') hy₁_E_ne
      have hy₀_val : ((m - 1 : ℕ) : ℤ) ≤ valL F E y₀ := by
        dsimp [y₀]
        rw [hval_mul_E _ _ (Units.ne_zero c') hy₁_E_ne, hc'_val]
        omega
      have hy₀_1 : 1 + y₀ ≠ 0 := by
        intro h0
        have hy₀_neg1 : y₀ = -1 := by linear_combination h0
        rw [hy₀_neg1, hval_neg1_E] at hy₀_val
        omega
      let u₀ : Eˣ := Units.mk0 (1 + y₀) hy₀_1
      have hu₀_sub : (u₀ : E) - 1 = y₀ := by
        dsimp [u₀]
        ring
      have hu₀_mem_m1 : u₀ ∈ unitGroup F E (m - 1) := by
        rw [hunit_ge1_E (m - 1) (by omega)]
        right
        rw [hu₀_sub]
        exact hy₀_val
      have hu₀_mem_cond : u₀ ∈ unitGroup F E (condExp F E χ'_E) := by
        by_cases h0 : condExp F E χ'_E = 0
        · rw [h0, hunit0_E]
          exact hunit_val0_E (m - 1) u₀ hu₀_mem_m1
        · rw [hunit_ge1_E (condExp F E χ'_E) (by omega)]
          right
          rw [hu₀_sub]
          omega
      have hχ'E_u0_1 : (χ'_E u₀ : Ω F) = 1 :=
        congrArg (fun u : (Ω F)ˣ => (u : Ω F)) (hχ'E_cond u₀ hu₀_mem_cond)
      have hχ'E_u0_ψ : (χ'_E u₀ : Ω F) = ψ_E y₁_E := by
        have htop := hc'_top y₀ (Or.inr hy₀_val) hy₀_1
        have hcancel : ((c'⁻¹ : Eˣ) : E) * y₀ = y₁_E := by
          dsimp [y₀]
          rw [← mul_assoc]
          have hinv : ((c'⁻¹ : Eˣ) : E) * (c' : E) = 1 := Units.inv_mul c'
          rw [hinv, one_mul]
        rwa [hcancel] at htop
      rw [hχ'E_u0_1] at hχ'E_u0_ψ
      exact hy₁_E_ψ hχ'E_u0_ψ.symm
    omega

theorem ld_ch14_higher_cond_baseline_c_E_from_diamond (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (D_orb : List (MonomialTerm F L))
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (hValAlgE : ∀ x : L,
      valL F E (IntermediateField.inclusion hLE x) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F L x)
    (hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (hResLiftK : ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (w - IntermediateField.inclusion hM_CK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hM_CK z)))
    (hDiamondTrNorm : ∀ y : E,
      IntermediateField.inclusion hLM_C (traceLM F hLE y) =
        traceLM F hM_CK (IntermediateField.inclusion hEK y) ∧
      IntermediateField.inclusion hLM_C (normLM F hLE y) =
        normLM F hM_CK (IntermediateField.inclusion hEK y))
    (t k : ℕ) (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k)
    (hk_dvd : k ∣ (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1))
    (hValAlgKE : ∀ y : E, valL F K (IntermediateField.inclusion hEK y) = (k : ℤ) * valL F E y)
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hnE : condExpChar F E (traceChar F hLE ψ) =
      (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * condExpChar F L ψ +
        (((Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) / k : ℕ) : ℤ) *
          ((t : ℤ) + (k : ℤ)))
    (htr_bound_K : ∀ (m : ℤ) (w : K),
      (w = 0 ∨
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * m -
          ((Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K w) →
      (traceLM F hM_CK w = 0 ∨ m ≤ valL F M_C (traceLM F hM_CK w)))
    (ϖ_K : Kˣ) (ϖ_MC : M_Cˣ) (ϖ_E : Eˣ) (ϖ_L : Lˣ)
    (hϖ_normK : Units.map (normLM F hM_CK) ϖ_K = ϖ_MC)
    (hϖ_normE : Units.map (normLM F hLE) ϖ_E = ϖ_L)
    (hϖ_valK : valL F K (ϖ_K : K) = 1)
    (hϖ_valMC : valL F M_C (ϖ_MC : M_C) = 1)
    (hϖ_valE : valL F E (ϖ_E : E) = 1)
    (hϖ_valL : valL F L (ϖ_L : L) = 1)
    (c'_χ' : Lˣ)
    (c'_μ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (hc_L_val : valL F L (c'_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (u_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) → M_Cˣ)
    (hu_all_prod : ∏ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1), u_all j =
      Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
        (((ϖ_L ^ (condExp F L χ' - 1))⁻¹ * c'_χ') ^
          (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)) *
        (ϖ_MC ^ (t * (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1))) *
        (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
          (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_μ i)))⁻¹)
    (u_α : Lˣ) (u_ω : M_Cˣ)
    (hu_α_val : valL F L (u_α : L) = 0)
    (hu_ω_val : valL F M_C (u_ω : M_C) = 0)
    (hu_ω_def : (u_ω : M_C) = (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K))
    (hu_α_frob : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ψ ((((((ϖ_L ^ (condExp F L χ' - 1))⁻¹ * c'_χ')⁻¹ : Lˣ) : L)) * ((u_α : L) * x)) =
        ψ ((((((ϖ_L ^ (condExp F L χ' - 1))⁻¹ * c'_χ')⁻¹ : Lˣ) : L)) *
          (x ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))))
    (hVieta : (∏ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1), u_all j) *
      (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
        (u_α ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK))))⁻¹ *
      (u_ω ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK))) ∈ unitGroup F M_C 1)
    (hNorm_unit1 : ∀ w₁ ∈ unitGroup F K 1,
      Units.map (normLM F hM_CK) w₁ ∈ unitGroup F M_C 1) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let c₁ : Lˣ := (ϖ_L ^ (condExp F L χ' - 1))⁻¹ * c'_χ'
    ∃ (c_E : Eˣ),
      valL F E (c_E : E) = 1 + condExpChar F E (traceChar F hLE ψ) ∧
      Units.map (normLM F hLE) c_E *
        (c₁ *
          (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_μ i)))⁻¹ ∈
        unitGroup F L 1 ∧
      (∀ y₀ : E, (y₀ = 0 ∨ 0 ≤ valL F E y₀) →
        ∀ x₀ : L, (x₀ = 0 ∨ 0 ≤ valL F L x₀) →
          (y₀ - IntermediateField.inclusion hLE x₀ = 0 ∨
            1 ≤ valL F E (y₀ - IntermediateField.inclusion hLE x₀)) →
          (traceChar F hLE ψ) (((c_E⁻¹ : Eˣ) : E) * y₀) =
            ψ (((c₁⁻¹ : Lˣ) : L) * (x₀ ^ q))) :=
by
  
  obtain ⟨_, _, _, _, hval_mul_L, _, _, _, _, hunit_ge1_L, _⟩ := ld_valL_and_unitGroup_props F L
  obtain ⟨_, _, _, hval_neg_MC, hval_mul_MC, hval_inv_MC, _, hval_add_MC, _, hunit_ge1_MC, _⟩ :=
    ld_valL_and_unitGroup_props F M_C
  obtain ⟨_, _, _, _, hval_mul_K, _, _, hval_add_K, _, hunit_ge1_K, _⟩ :=
    ld_valL_and_unitGroup_props F K
  obtain ⟨hψ_triv, _, _, _⟩ := ld_condExp_and_condExpChar_spec F L ψ hψ χ'

  
  have hval_unit_mul : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (u v : Mˣ), valL F M ((u * v : Mˣ) : M) = valL F M (u : M) + valL F M (v : M) := by
    intro M _ u v
    have hM := ld_valL_and_unitGroup_props F M
    rw [Units.val_mul]
    exact hM.2.2.2.2.1 (u : M) (v : M) (Units.ne_zero u) (Units.ne_zero v)
  have hval_unit_inv : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (u : Mˣ), valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M) := by
    intro M _ u
    exact (ld_valL_and_unitGroup_props F M).2.2.2.2.2.1 u
  have hval_unit_pow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (u : Mˣ) (n : ℕ), valL F M ((u ^ n : Mˣ) : M) = (n : ℤ) * valL F M (u : M) := by
    intro M _ u n
    have hM := ld_valL_and_unitGroup_props F M
    induction n with
    | zero =>
      simp [hM.2.1]
    | succ n ih =>
      rw [pow_succ, hval_unit_mul M (u ^ n) u, ih]
      push_cast
      ring
  have hval_unit_zpow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (u : Mˣ) (m : ℤ), valL F M ((u ^ m : Mˣ) : M) = m * valL F M (u : M) := by
    intro M _ u m
    cases m with
    | ofNat n =>
      rw [Int.ofNat_eq_coe, zpow_natCast, hval_unit_pow M u n]
    | negSucc n =>
      rw [zpow_negSucc, hval_unit_inv M (u ^ (n + 1)), hval_unit_pow M u (n + 1), Int.negSucc_eq]
      push_cast
      ring

  
  have hcoe_inc_unit : ∀ (M₁ M₂ : IntermediateField F (AlgebraicClosure F))
      (h : M₁ ≤ M₂) (u : M₁ˣ),
      ((Units.map (IntermediateField.inclusion h).toMonoidHom u : M₂ˣ) : M₂) =
        IntermediateField.inclusion h (u : M₁) := fun _ _ _ _ => rfl
  have hnorm_inc_unit : ∀ (M₁ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₁] [FiniteDimensional F M₂] (h : M₁ ≤ M₂) (u : M₁ˣ),
      Units.map (normLM F h) (Units.map (IntermediateField.inclusion h).toMonoidHom u) =
        u ^ (Module.finrank M₁ (IntermediateField.extendScalars h)) := by
    intro M₁ M₂ _ _ h u
    haveI : FiniteDimensional F (IntermediateField.extendScalars h) := ‹FiniteDimensional F M₂›
    haveI : IsScalarTower F M₁ (IntermediateField.extendScalars h) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional M₁ (IntermediateField.extendScalars h) :=
      Module.Finite.of_restrictScalars_finite F M₁ (IntermediateField.extendScalars h)
    haveI : Module.Free M₁ (IntermediateField.extendScalars h) :=
      Module.Free.of_divisionRing M₁ (IntermediateField.extendScalars h)
    apply Units.ext
    change Algebra.norm M₁ (toExtendScalars F h (IntermediateField.inclusion h (u : M₁))) =
      ((u ^ (Module.finrank M₁ (IntermediateField.extendScalars h)) : M₁ˣ) : M₁)
    have hto : toExtendScalars F h (IntermediateField.inclusion h (u : M₁)) =
        algebraMap M₁ (IntermediateField.extendScalars h) (u : M₁) := rfl
    rw [hto, Algebra.norm_algebraMap, Units.val_pow_eq_pow_val]
  have htrace_smul : ∀ (M₁ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₁] [FiniteDimensional F M₂] (h : M₁ ≤ M₂) (x : M₁) (y : M₂),
      traceLM F h (IntermediateField.inclusion h x * y) = x * traceLM F h y := by
    intro M₁ M₂ _ _ h x y
    letI : Module M₁ M₁ := Semiring.toModule
    change Algebra.trace M₁ (IntermediateField.extendScalars h)
        (toExtendScalars F h (IntermediateField.inclusion h x * y)) =
      x * Algebra.trace M₁ (IntermediateField.extendScalars h) (toExtendScalars F h y)
    have hto : toExtendScalars F h (IntermediateField.inclusion h x) =
        algebraMap M₁ (IntermediateField.extendScalars h) x := rfl
    rw [map_mul, hto, ← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]

  
  let K' := IntermediateField.extendScalars hM_CK
  let q := Module.finrank M_C K'
  let a := condExp F L χ'
  let ψ_E := traceChar F hLE ψ
  have hFinMCK' : FiniteDimensional M_C K' := by
    haveI : FiniteDimensional F K' := ‹FiniteDimensional F K›
    haveI : IsScalarTower F M_C K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact Module.Finite.of_restrictScalars_finite F M_C K'
  haveI : FiniteDimensional M_C K' := hFinMCK'
  have hq_pos : 0 < q := Module.finrank_pos
  have hq_ge1 : 1 ≤ q := hq_pos
  have hq1_cast : ((q - 1 : ℕ) : ℤ) = (q : ℤ) - 1 := by omega
  let c₁ : Lˣ := (ϖ_L ^ (a - 1))⁻¹ * c'_χ'
  have hc₁_val : valL F L (c₁ : L) = 1 + condExpChar F L ψ := by
    dsimp only [c₁]
    rw [hval_unit_mul L, hval_unit_inv L, hval_unit_pow L ϖ_L (a - 1), hϖ_valL, hc_L_val]
    have ha_ge2 : 2 ≤ a := h_ge2
    omega

  
  let m_E : ℤ := 1 + condExpChar F E ψ_E
  let w_E : Eˣ := ϖ_E ^ m_E
  let κ_E : Eˣ := Units.map (IntermediateField.inclusion hLE).toMonoidHom c₁ * w_E⁻¹
  have hκ_E_val : valL F E (κ_E : E) = (q : ℤ) * (1 + condExpChar F L ψ) - m_E := by
    dsimp only [κ_E, w_E]
    rw [hval_unit_mul E, hval_unit_inv E, hcoe_inc_unit L E hLE c₁,
      hValAlgE (c₁ : L), hc₁_val, hval_unit_zpow E ϖ_E m_E, hϖ_valE]
    ring
  let δ : Kˣ :=
    Units.map (IntermediateField.inclusion hEK).toMonoidHom κ_E *
      Units.map (IntermediateField.inclusion hM_CK).toMonoidHom (ϖ_MC ^ t) *
      (ϖ_K ^ t)⁻¹
  have hdiv_nat : k * ((q - 1) / k) = q - 1 := Nat.mul_div_cancel' hk_dvd
  have hdiv_int : (k : ℤ) * (((q - 1) / k : ℕ) : ℤ) = (q : ℤ) - 1 := by
    calc (k : ℤ) * (((q - 1) / k : ℕ) : ℤ)
        = ((k * ((q - 1) / k) : ℕ) : ℤ) := (Nat.cast_mul k ((q - 1) / k)).symm
      _ = ((q - 1 : ℕ) : ℤ) := by rw [hdiv_nat]
      _ = (q : ℤ) - 1 := hq1_cast
  have hm_E_mul :
      (k : ℤ) * m_E =
        (k : ℤ) * (q : ℤ) * (1 + condExpChar F L ψ) + ((q : ℤ) - 1) * (t : ℤ) := by
    dsimp only [m_E, ψ_E]
    rw [hnE]
    calc (k : ℤ) * (1 + ((q : ℤ) * condExpChar F L ψ +
          (((q - 1) / k : ℕ) : ℤ) * ((t : ℤ) + (k : ℤ))))
        = (k : ℤ) + (k : ℤ) * (q : ℤ) * condExpChar F L ψ +
          ((k : ℤ) * (((q - 1) / k : ℕ) : ℤ)) * ((t : ℤ) + (k : ℤ)) := by ring
      _ = (k : ℤ) + (k : ℤ) * (q : ℤ) * condExpChar F L ψ +
          ((q : ℤ) - 1) * ((t : ℤ) + (k : ℤ)) := by rw [hdiv_int]
      _ = (k : ℤ) * (q : ℤ) * (1 + condExpChar F L ψ) + ((q : ℤ) - 1) * (t : ℤ) := by ring
  have hδ_val : valL F K (δ : K) = 0 := by
    dsimp only [δ]
    rw [hval_unit_mul K, hval_unit_mul K, hval_unit_inv K,
      hcoe_inc_unit E K hEK κ_E, hValAlgKE (κ_E : E), hκ_E_val,
      hcoe_inc_unit M_C K hM_CK (ϖ_MC ^ t), hValAlgK ((ϖ_MC ^ t : M_Cˣ) : M_C),
      hval_unit_pow M_C ϖ_MC t, hϖ_valMC,
      hval_unit_pow K ϖ_K t, hϖ_valK]
    linear_combination - hm_E_mul

  have hnorm_κ_E : Units.map (normLM F hLE) κ_E = c₁ ^ q * (ϖ_L ^ m_E)⁻¹ := by
    dsimp only [κ_E, w_E]
    rw [map_mul, hnorm_inc_unit L E hLE c₁, hFinE_eq, map_inv, map_zpow, hϖ_normE]
  have hnorm_EK_κ :
      Units.map (normLM F hM_CK) (Units.map (IntermediateField.inclusion hEK).toMonoidHom κ_E) =
