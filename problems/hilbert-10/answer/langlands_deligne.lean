  have hFML_M₁ : ∀ (lam_L : Lˣ →* (Ω F)ˣ),
      (∀ j < ℓ, ∀ u ∈ unitGroup F L (condExp F L (νM₁ ^ j * lam_L)), (νM₁ ^ j * lam_L) u = 1) →
      (∀ u ∈ unitGroup F M₁ (condExp F M₁ (lam_L.comp (Units.map (normLM F hLM₁)))),
        (lam_L.comp (Units.map (normLM F hLM₁))) u = 1) →
      tateEps F M₁ (lam_L.comp (Units.map (normLM F hLM₁))) ψM₁ *
        (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ) =
      tateEps F M₁ 1 ψM₁ *
        (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j * lam_L) ψ) := by
    intro lam_L h1 h2
    have h1' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLM₁),
