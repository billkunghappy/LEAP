        ψ (((c_ν⁻¹ : Lˣ) : L) * Δ₃) * ψ (((c_ν⁻¹ : Lˣ) : L) * Δ₄) := by
    rw [← ψ.map_add_eq_mul, ← ψ.map_add_eq_mul, hBiquad_diff]
