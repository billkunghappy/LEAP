        congr 1
        ring
      have hθw_ne : (θ w : Ω F) ≠ 0 := Units.ne_zero (θ w)
      change (θ u₂ : Ω F)⁻¹ * ψ (((c⁻¹ : Lˣ) : L) * δ_L * x₂) =
        (θ u₁ : Ω F)⁻¹ * ψ (((c⁻¹ : Lˣ) : L) * δ_L * x₁)
      calc (θ u₂ : Ω F)⁻¹ * ψ (((c⁻¹ : Lˣ) : L) * δ_L * x₂)
        _ = (θ u₂ : Ω F)⁻¹ * ψ (((c⁻¹ : Lˣ) : L) * δ_L * x₂) * ((θ w : Ω F)⁻¹ * (θ w : Ω F)) := by
          rw [inv_mul_cancel₀ hθw_ne, mul_one]
        _ = ((θ u₂ : Ω F)⁻¹ * (θ w : Ω F)⁻¹) *
              (ψ (((c⁻¹ : Lˣ) : L) * δ_L * x₂) * (θ w : Ω F)) := by ring
        _ = (θ u₁ : Ω F)⁻¹ * ψ (((c⁻¹ : Lˣ) : L) * δ_L * x₁) := by
          rw [← mul_inv, ← hθ_mul, ← hψ_split]
    have hH_0 : H 0 = 1 := by
      have h1_0_ne : 1 + δ_L * (0 : L) ≠ 0 := by simp
      rw [← hresL_0, hH_spec 0 (hP_zero 0) h1_0_ne]
      have hmk_one : Units.mk0 (1 + δ_L * (0 : L)) h1_0_ne = 1 := by
        apply Units.ext; simp
      rw [hmk_one, map_one, Units.val_one, inv_one, one_mul, mul_zero, ψ.map_zero_eq_one]
    have hH_add : ∀ a₁ a₂ : k_L, H (a₁ + a₂) = H a₁ * H a₂ * ψ₀ (c_res * (a₁ * a₂)) := by
      intro a₁ a₂
      set x₁ := liftL a₁
      set x₂ := liftL a₂
      have hx₁ : P 0 x₁ := hliftL_int a₁
      have hx₂ : P 0 x₂ := hliftL_int a₂
      have hx12 : P 0 (x₁ + x₂) := hP_add hx₁ hx₂
      have hmul12 : P 0 (x₁ * x₂) := hP_mono (by omega) (hP_mul hx₁ hx₂)
      have hu₁_ne : 1 + δ_L * x₁ ≠ 0 := h1_add_ne (hδx_P1 hx₁)
      have hu₂_ne : 1 + δ_L * x₂ ≠ 0 := h1_add_ne (hδx_P1 hx₂)
      have hu12_ne : 1 + δ_L * (x₁ + x₂) ≠ 0 := h1_add_ne (hδx_P1 hx12)
      have hδ2_stat : P (((b + 1) / 2 : ℕ) : ℤ) (((ϖ_L ^ t : Lˣ) : L) * (x₁ * x₂)) :=
        hP_mono (by omega) (hP_mul hP_ϖt hmul12)
      have hwq_ne : 1 + ((ϖ_L ^ t : Lˣ) : L) * (x₁ * x₂) ≠ 0 :=
        h1_add_ne (hP_mono (by omega) hδ2_stat)
      set u₁ := Units.mk0 (1 + δ_L * x₁) hu₁_ne
      set u₂ := Units.mk0 (1 + δ_L * x₂) hu₂_ne
      set u₁₂ := Units.mk0 (1 + δ_L * (x₁ + x₂)) hu12_ne
      set w_q := Units.mk0 (1 + ((ϖ_L ^ t : Lˣ) : L) * (x₁ * x₂)) hwq_ne
      have hu1u2_val : valL F L ((u₁ * u₂ : Lˣ) : L) = 0 := by
        rw [Units.val_mul, hval_mul (u₁ : L) (u₂ : L) (Units.ne_zero _) (Units.ne_zero _)]
        dsimp only [u₁, u₂]
        rw [Units.val_mk0, Units.val_mk0,
          h1_add_val (hδx_P1 hx₁), h1_add_val (hδx_P1 hx₂), add_zero]
      have hpoly_q : ((u₁₂ * w_q : Lˣ) : L) - ((u₁ * u₂ : Lˣ) : L) =
          ((ϖ_L ^ t : Lˣ) : L) * (δ_L * (x₁ * x₂ * (x₁ + x₂))) := by
        dsimp only [u₁, u₂, u₁₂, w_q]
        rw [Units.val_mul, Units.val_mul, Units.val_mk0, Units.val_mk0,
          Units.val_mk0, Units.val_mk0, hϖLt_eq_sq]
        ring
      have hpoly_q_Pb : P (b : ℤ) (((u₁₂ * w_q : Lˣ) : L) - ((u₁ * u₂ : Lˣ) : L)) := by
        rw [hpoly_q]
        exact hP_mono (by omega)
          (hP_mul hP_ϖt (hP_mul hP_δ (hP_mul hmul12 hx12)))
      have hθ_q_eq : θ (u₁₂ * w_q) = θ (u₁ * u₂) :=
        hθ_congr θ hθ_triv hu1u2_val hpoly_q_Pb
      have hθ_inv_eq : (θ u₁₂ : Ω F)⁻¹ =
          (θ u₁ : Ω F)⁻¹ * (θ u₂ : Ω F)⁻¹ * (θ w_q : Ω F) := by
        have h1 : (θ u₁₂ : Ω F) * (θ w_q : Ω F) = (θ u₁ : Ω F) * (θ u₂ : Ω F) := by
          exact_mod_cast (map_mul θ u₁₂ w_q).symm.trans (hθ_q_eq.trans (map_mul θ u₁ u₂))
        rw [← mul_inv, ← h1, mul_inv, mul_assoc, inv_mul_cancel₀ (Units.ne_zero (θ w_q)), mul_one]
      have hθ_wq : (θ w_q : Ω F) = ψ₀ (c_res * (a₁ * a₂)) := by
        rw [hc_stat (((ϖ_L ^ t : Lˣ) : L) * (x₁ * x₂)) hδ2_stat hwq_ne, ← mul_assoc,
          hquad (x₁ * x₂) hmul12, (hresL_ring x₁ x₂ hx₁ hx₂).2.1,
          hliftL_res a₁, hliftL_res a₂]
      have hres_add : a₁ + a₂ = resL (x₁ + x₂) := by
        rw [(hresL_ring x₁ x₂ hx₁ hx₂).1, hliftL_res a₁, hliftL_res a₂]
      have hψ_add : ψ (((c⁻¹ : Lˣ) : L) * δ_L * (x₁ + x₂)) =
          ψ (((c⁻¹ : Lˣ) : L) * δ_L * x₁) *
            ψ (((c⁻¹ : Lˣ) : L) * δ_L * x₂) := by
        rw [← ψ.map_add_eq_mul]
        congr 1
        ring
      rw [hres_add, hH_spec (x₁ + x₂) hx12 hu12_ne,
        ← hliftL_res a₁, ← hliftL_res a₂,
        hH_spec x₁ hx₁ hu₁_ne, hH_spec x₂ hx₂ hu₂_ne,
        hliftL_res a₁, hliftL_res a₂, hθ_inv_eq, hθ_wq, hψ_add]
      ring
    exact ⟨hH_spec, hH_0, hH_add⟩
  let H_τ : k_L → Ω F := fun a =>
    if hx : 1 + δ_L * liftL a ≠ 0 then
      (ν₁ (Units.mk0 (1 + δ_L * liftL a) hx) : Ω F)⁻¹ *
        ψ (A * δ_L * liftL a)
    else 0
  let H_χ : k_L → Ω F := fun a =>
    if hx : 1 + δ_L * liftL a ≠ 0 then
      (χ' (Units.mk0 (1 + δ_L * liftL a) hx) : Ω F)⁻¹ *
        ψ (((c_χ⁻¹ : Lˣ) : L) * δ_L * liftL a)
    else 0
  have hPolar_τ :
      (∀ x : L, P 0 x → ∀ hx : 1 + δ_L * x ≠ 0,
        H_τ (resL x) =
          (ν₁ (Units.mk0 (1 + δ_L * x) hx) : Ω F)⁻¹ *
            ψ (A * δ_L * x)) ∧
      H_τ 0 = 1 ∧
      (∀ a₁ a₂ : k_L, H_τ (a₁ + a₂) = H_τ a₁ * H_τ a₂ * ψ₀ (1 * (a₁ * a₂))) :=
    hPolar_gen ν₁ c_τ 1 hν₁_triv hc_τ_stat hquad_τ
  obtain ⟨hHτ_spec, hHτ_0, hHτ_add_raw⟩ := hPolar_τ
  have hHτ_add : ∀ x y : k_L, H_τ (x + y) = H_τ x * H_τ y * ψ₀ (x * y) := by
    intro x y
    rw [hHτ_add_raw x y, one_mul]
  have hc_χ_stat' : ∀ x : L, P (((b + 1) / 2 : ℕ) : ℤ) x → ∀ hx : 1 + x ≠ 0,
      (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ⁻¹ : Lˣ) : L) * x) := by
    intro x hx hx_ne
    apply hc_χ_stat x
    rwa [hab_eq]
  have hPolar_χ :
      (∀ x : L, P 0 x → ∀ hx : 1 + δ_L * x ≠ 0,
        H_χ (resL x) =
          (χ' (Units.mk0 (1 + δ_L * x) hx) : Ω F)⁻¹ *
            ψ (((c_χ⁻¹ : Lˣ) : L) * δ_L * x)) ∧
      H_χ 0 = 1 ∧
      (∀ a₁ a₂ : k_L, H_χ (a₁ + a₂) = H_χ a₁ * H_χ a₂ * ψ₀ (d₀ * (a₁ * a₂))) :=
    hPolar_gen χ' c_χ d₀ hχ'_triv hc_χ_stat' hquad_χ
  obtain ⟨hHχ_spec, hHχ_0, hHχ_add_raw⟩ := hPolar_χ
  have hHχ_add : ∀ x y : k_L, H_χ (x + y) = H_χ x * H_χ y * ψ₀ (d₀ * x * y) := by
    intro x y
    rw [hHχ_add_raw x y, ← mul_assoc d₀ x y]
  have hRL_inj : Set.InjOn resL R_L := by
    intro r₁ hr₁ r₂ hr₂ hres_eq
    by_contra hr_ne
    have hval0_sub : valL F L (r₁ - r₂) = 0 := hRL_sep r₁ hr₁ r₂ hr₂ hr_ne
    have hsub_P1 : P 1 (r₁ - r₂) :=
      hresL_sub_mem1 (hRL_int r₁ hr₁) (hRL_int r₂ hr₂) hres_eq
    rcases hsub_P1 with hsub0 | hval1_sub
    · exact hr_ne (sub_eq_zero.mp hsub0)
    · omega
  have hRL_image : R_L.image resL = Finset.univ := by
    apply Finset.eq_of_subset_of_card_le (Finset.subset_univ _)
    rw [Finset.card_univ, Finset.card_image_of_injOn hRL_inj, hRL_card]
  have hRL_surj_univ : ∀ b_res ∈ (Finset.univ : Finset k_L), ∃ r ∈ R_L, resL r = b_res := by
    intro b_res hb_res
    rw [← hRL_image] at hb_res
    exact Finset.mem_image.mp hb_res
  have hRL_sum_bij : ∀ g : k_L → Ω F, (∑ r ∈ R_L, g (resL r)) = ∑ x : k_L, g x := by
    intro g
    refine Finset.sum_bij (fun r _ => resL r) ?_ ?_ ?_ ?_
    · intro r _; exact Finset.mem_univ _
    · intro r₁ hr₁ r₂ hr₂ heq; exact hRL_inj hr₁ hr₂ heq
    · intro b_res hb_res
      obtain ⟨r, hr, hres⟩ := hRL_surj_univ b_res hb_res
      exact ⟨r, hr, hres⟩
    · intro _ _; rfl
  have hS_χ : (∑ r ∈ R_L,
      if hr : 1 + δ_L * r ≠ 0 then
        (χ' (Units.mk0 (1 + δ_L * r) hr) : Ω F)⁻¹ *
          ψ (((c_χ⁻¹ : Lˣ) : L) * δ_L * r)
      else 0) = (∑ x : k_L, H_χ x) := by
    rw [← hRL_sum_bij H_χ]
    refine Finset.sum_congr rfl (fun r hr => ?_)
    have hr_ne : 1 + δ_L * r ≠ 0 :=
      h1_add_ne (hP_mono (by omega) (hP_mul hP_δ (hRL_int r hr)))
    rw [dif_pos hr_ne, ← hHχ_spec r (hRL_int r hr) hr_ne]
  have hS_ν_twist : ∀ j ∈ (Finset.range p).erase 0,
      (∑ r ∈ R_L,
        if hr : 1 + δ_L * r ≠ 0 then
          ((ν₁ ^ j) (Units.mk0 (1 + δ_L * r) hr) : Ω F)⁻¹ *
            ψ ((((c_ν j)⁻¹ : Lˣ) : L) * δ_L * r)
        else 0) = (∑ x : k_L, (H_τ x) ^ j) ∧
      (∑ r ∈ R_L,
        if hr : 1 + δ_L * r ≠ 0 then
          ((ν₁ ^ j * χ') (Units.mk0 (1 + δ_L * r) hr) : Ω F)⁻¹ *
            ψ ((((c_twist j)⁻¹ : Lˣ) : L) * δ_L * r)
        else 0) = (∑ x : k_L, (H_τ x) ^ j * H_χ x) := by
    intro j hj
    have hj_ne0 : j ≠ 0 := (Finset.mem_erase.mp hj).1
    have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    have hj_pos : 0 < j := Nat.pos_of_ne_zero hj_ne0
    obtain ⟨_, _, _, _, hc_ν_eq, _, _, hc_twist_inv⟩ := hτ_props j hj_lt hj_pos
    have hc_ν_inv : (((c_ν j)⁻¹ : Lˣ) : L) = A * (τ_unit j : L) := by
      have h1 : (c_ν j)⁻¹ = (τ_unit j) * c_τ⁻¹ := by
        rw [hc_ν_eq, mul_inv_rev, inv_inv]
      rw [h1, Units.val_mul, mul_comm]
    have hc_twist_add : (((c_twist j)⁻¹ : Lˣ) : L) =
        (((c_ν j)⁻¹ : Lˣ) : L) + ((c_χ⁻¹ : Lˣ) : L) := by
      rw [hc_twist_inv, hc_ν_inv, hcχ_inv_eq]
      ring
    have hτ_diff : P ((d + 1 : ℕ) : ℤ) ((τ_unit j : L) - (j : L)) :=
      (hτ_mod j hj_lt hj_pos).1
    have hψ_cν : ∀ r : L, P 0 r →
        ψ ((((c_ν j)⁻¹ : Lˣ) : L) * δ_L * r) = (ψ (A * δ_L * r)) ^ j := by
      intro r hr_int
      have hcongr : ψ ((((c_ν j)⁻¹ : Lˣ) : L) * δ_L * r) = ψ ((j : L) * (A * δ_L * r)) := by
        apply hψ_congr
        have h_eq : (((c_ν j)⁻¹ : Lˣ) : L) * δ_L * r - (j : L) * (A * δ_L * r) =
            A * (((τ_unit j : L) - (j : L)) * (δ_L * r)) := by
          rw [hc_ν_inv]; ring
        rw [h_eq]
        exact hP_mono (by omega)
          (hP_mul hP_A (hP_mul hτ_diff (hP_mul hP_δ hr_int)))
      rw [hcongr, ← nsmul_eq_mul, ψ.map_nsmul_eq_pow]
    have hterm_ν : ∀ r : L, (hr_int : P 0 r) → (hr_ne : 1 + δ_L * r ≠ 0) →
        ((ν₁ ^ j) (Units.mk0 (1 + δ_L * r) hr_ne) : Ω F)⁻¹ *
          ψ ((((c_ν j)⁻¹ : Lˣ) : L) * δ_L * r) = (H_τ (resL r)) ^ j := by
      intro r hr_int hr_ne
      rw [MonoidHom.pow_apply, Units.val_pow_eq_pow_val, ← inv_pow,
        hψ_cν r hr_int, ← mul_pow, ← hHτ_spec r hr_int hr_ne]
    refine ⟨?_, ?_⟩
    · rw [← hRL_sum_bij (fun x => (H_τ x) ^ j)]
      refine Finset.sum_congr rfl (fun r hr => ?_)
      have hr_int : P 0 r := hRL_int r hr
      have hr_ne : 1 + δ_L * r ≠ 0 :=
        h1_add_ne (hP_mono (by omega) (hP_mul hP_δ hr_int))
      rw [dif_pos hr_ne, hterm_ν r hr_int hr_ne]
    · rw [← hRL_sum_bij (fun x => (H_τ x) ^ j * H_χ x)]
      refine Finset.sum_congr rfl (fun r hr => ?_)
      have hr_int : P 0 r := hRL_int r hr
      have hr_ne : 1 + δ_L * r ≠ 0 :=
        h1_add_ne (hP_mono (by omega) (hP_mul hP_δ hr_int))
      have hψ_split : ψ ((((c_twist j)⁻¹ : Lˣ) : L) * δ_L * r) =
          ψ ((((c_ν j)⁻¹ : Lˣ) : L) * δ_L * r) * ψ (((c_χ⁻¹ : Lˣ) : L) * δ_L * r) := by
        rw [hc_twist_add, ← ψ.map_add_eq_mul]
        congr 1
        ring
      rw [dif_pos hr_ne, MonoidHom.mul_apply, Units.val_mul, mul_inv, hψ_split]
      calc ((ν₁ ^ j) (Units.mk0 (1 + δ_L * r) hr_ne) : Ω F)⁻¹ *
            (χ' (Units.mk0 (1 + δ_L * r) hr_ne) : Ω F)⁻¹ *
            (ψ ((((c_ν j)⁻¹ : Lˣ) : L) * δ_L * r) * ψ (((c_χ⁻¹ : Lˣ) : L) * δ_L * r))
        _ = (((ν₁ ^ j) (Units.mk0 (1 + δ_L * r) hr_ne) : Ω F)⁻¹ *
              ψ ((((c_ν j)⁻¹ : Lˣ) : L) * δ_L * r)) *
            ((χ' (Units.mk0 (1 + δ_L * r) hr_ne) : Ω F)⁻¹ *
              ψ (((c_χ⁻¹ : Lˣ) : L) * δ_L * r)) := by ring
        _ = (H_τ (resL r)) ^ j * H_χ (resL r) := by
          rw [hterm_ν r hr_int hr_ne, ← hHχ_spec r hr_int hr_ne]
  exact ⟨ψ₀, H_τ, H_χ, hψ₀_spec, hHτ_spec, hHχ_spec,
    hψ₀_0, hψ₀_add, hψ₀_ne1, hψ₀_frob,
    hHτ_0, hHτ_add, hHχ_0, hHχ_add, hS_χ, hS_ν_twist⟩

theorem ld_wild_odd_prime_finite_field_polar_to_quad (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_L : Type u) [Field k_L] [Fintype k_L]
    (p : ℕ) (hPrime : Nat.Prime p) (hchar : (p : k_L) = 0) (h2_ne : (2 : k_L) ≠ 0)
    (ψ₀ H_τ H_χ : k_L → Ω F)
    (hψ₀_0 : ψ₀ 0 = 1)
    (hψ₀_add : ∀ x y : k_L, ψ₀ (x + y) = ψ₀ x * ψ₀ y)
    (hψ₀_ne : ∃ x₀ : k_L, ψ₀ x₀ ≠ 1)
    (μ ζ d₀ : k_L)
    (hψ₀_frob : ∀ y : k_L, ψ₀ (y ^ p) = ψ₀ (- μ * y))
    (hd₀_eq : d₀ = ζ ^ p)
    (hHτ_0 : H_τ 0 = 1)
    (hHτ_add : ∀ x y : k_L, H_τ (x + y) = H_τ x * H_τ y * ψ₀ (x * y))
    (hHχ_0 : H_χ 0 = 1)
    (hHχ_add : ∀ x y : k_L, H_χ (x + y) = H_χ x * H_χ y * ψ₀ (d₀ * x * y)) :
    ∃ (B_χ B_τ : k_L),
      (∀ x : k_L, H_τ x = ψ₀ ((2 : k_L)⁻¹ * x ^ 2 + B_τ * x)) ∧
      (∀ x : k_L, H_χ x = ψ₀ ((2 : k_L)⁻¹ * d₀ * x ^ 2 + B_χ * x)) ∧
      (∀ (j : ℕ) (x : k_L),
        (H_τ x) ^ j = ψ₀ ((2 : k_L)⁻¹ * (j : k_L) * x ^ 2 + (j : k_L) * B_τ * x)) ∧
      (∀ (j : ℕ) (x : k_L),
        (H_τ x) ^ j * H_χ x =
          ψ₀ ((2 : k_L)⁻¹ * (d₀ + (j : k_L)) * x ^ 2 + (B_χ + (j : k_L) * B_τ) * x)) ∧
      (∀ (C₀ : k_L), C₀ ^ p = B_χ - d₀ * B_τ →
        ∀ Z : k_L,
          H_χ (Z ^ p) * (H_τ (d₀ * Z ^ p))⁻¹ *
            ψ₀ ((2 : k_L)⁻¹ * μ * (d₀ - ζ ^ 2) * Z ^ 2) =
          ψ₀ ((2 : k_L)⁻¹ * (μ * (d₀ - ζ)) * Z ^ 2 + (- μ * C₀) * Z)) :=
by
  suffices h_gen : ∀ (R : Type) [Field R] [CharZero R] (ψ₀ H_τ H_χ : k_L → R),
      ψ₀ 0 = 1 →
      (∀ x y : k_L, ψ₀ (x + y) = ψ₀ x * ψ₀ y) →
      (∃ x₀ : k_L, ψ₀ x₀ ≠ 1) →
      (∀ y : k_L, ψ₀ (y ^ p) = ψ₀ (- μ * y)) →
      H_τ 0 = 1 →
      (∀ x y : k_L, H_τ (x + y) = H_τ x * H_τ y * ψ₀ (x * y)) →
      H_χ 0 = 1 →
      (∀ x y : k_L, H_χ (x + y) = H_χ x * H_χ y * ψ₀ (d₀ * x * y)) →
      ∃ (B_χ B_τ : k_L),
        (∀ x : k_L, H_τ x = ψ₀ ((2 : k_L)⁻¹ * x ^ 2 + B_τ * x)) ∧
        (∀ x : k_L, H_χ x = ψ₀ ((2 : k_L)⁻¹ * d₀ * x ^ 2 + B_χ * x)) ∧
        (∀ (j : ℕ) (x : k_L),
          (H_τ x) ^ j = ψ₀ ((2 : k_L)⁻¹ * (j : k_L) * x ^ 2 + (j : k_L) * B_τ * x)) ∧
        (∀ (j : ℕ) (x : k_L),
          (H_τ x) ^ j * H_χ x =
            ψ₀ ((2 : k_L)⁻¹ * (d₀ + (j : k_L)) * x ^ 2 + (B_χ + (j : k_L) * B_τ) * x)) ∧
        (∀ (C₀ : k_L), C₀ ^ p = B_χ - d₀ * B_τ →
          ∀ Z : k_L,
            H_χ (Z ^ p) * (H_τ (d₀ * Z ^ p))⁻¹ *
              ψ₀ ((2 : k_L)⁻¹ * μ * (d₀ - ζ ^ 2) * Z ^ 2) =
            ψ₀ ((2 : k_L)⁻¹ * (μ * (d₀ - ζ)) * Z ^ 2 + (- μ * C₀) * Z)) by
    exact h_gen (Ω F) ψ₀ H_τ H_χ hψ₀_0 hψ₀_add hψ₀_ne hψ₀_frob hHτ_0 hHτ_add hHχ_0 hHχ_add
  clear * - hPrime hchar h2_ne hd₀_eq
  intro R _ _ ψ₀ H_τ H_χ hψ₀_0 hψ₀_add hψ₀_ne hψ₀_frob hHτ_0 hHτ_add hHχ_0 hHχ_add
  have hψ₀_mul_neg : ∀ a : k_L, ψ₀ a * ψ₀ (-a) = 1 := by
    intro a
    rw [← hψ₀_add, add_neg_cancel, hψ₀_0]
  have hψ₀_inv : ∀ a : k_L, (ψ₀ a)⁻¹ = ψ₀ (-a) := by
    intro a
    exact inv_eq_of_mul_eq_one_right (hψ₀_mul_neg a)
  have hψ₀_pow : ∀ (j : ℕ) (a : k_L), (ψ₀ a) ^ j = ψ₀ ((j : k_L) * a) := by
    intro j a
    induction j with
    | zero => simp [hψ₀_0]
    | succ j ih =>
      rw [pow_succ, ih, Nat.cast_succ, add_mul, one_mul, hψ₀_add]
  obtain ⟨x₀, hx₀⟩ := hψ₀_ne
  have h_orth : ∀ x : k_L, x ≠ 0 → (∑ B : k_L, ψ₀ (- B * x)) = 0 := by
    intro x hx
    have hshift : (∑ B : k_L, ψ₀ (- B * x)) = (∑ B : k_L, ψ₀ (- B * x)) * ψ₀ x₀ := by
      conv_lhs =>
        rw [← Fintype.sum_equiv (Equiv.addRight (- x⁻¹ * x₀)) _ _ (fun _ => rfl)]
      have hterm : ∀ B : k_L, ψ₀ (- (B + (- x⁻¹ * x₀)) * x) = ψ₀ (- B * x) * ψ₀ x₀ := by
        intro B
        have hBx : - (B + (- x⁻¹ * x₀)) * x = - B * x + x₀ := by
          calc - (B + (- x⁻¹ * x₀)) * x
              = - B * x + (x * x⁻¹) * x₀ := by ring
            _ = - B * x + x₀ := by rw [mul_inv_cancel₀ hx, one_mul]
        rw [hBx, hψ₀_add]
      simp_rw [Equiv.coe_addRight, hterm, ← Finset.sum_mul]
    have hzero : (∑ B : k_L, ψ₀ (- B * x)) * (ψ₀ x₀ - 1) = 0 := by
      linear_combination -hshift
    exact (mul_eq_zero.mp hzero).resolve_right (sub_ne_zero.mpr hx₀)
  have h_polar_to_quad : ∀ (c : k_L) (H : k_L → R),
      H 0 = 1 →
      (∀ x y : k_L, H (x + y) = H x * H y * ψ₀ (c * x * y)) →
      ∃ B : k_L, ∀ x : k_L, H x = ψ₀ ((2 : k_L)⁻¹ * c * x ^ 2 + B * x) := by
    intro c H hH_0 hH_add
    let φ : k_L → R := fun x => H x * ψ₀ (- (2 : k_L)⁻¹ * c * x ^ 2)
    have hφ_0 : φ 0 = 1 := by
      dsimp only [φ]
      simp [hH_0, hψ₀_0]
    have h2_inv : (2 : k_L) * (2 : k_L)⁻¹ = 1 := mul_inv_cancel₀ h2_ne
    have hφ_add : ∀ x y : k_L, φ (x + y) = φ x * φ y := by
      intro x y
      dsimp only [φ]
      have h_quad_id :
          c * x * y + (- (2 : k_L)⁻¹ * c * (x + y) ^ 2) =
            (- (2 : k_L)⁻¹ * c * x ^ 2) + (- (2 : k_L)⁻¹ * c * y ^ 2) := by
        calc c * x * y + (- (2 : k_L)⁻¹ * c * (x + y) ^ 2)
            = (1 - (2 : k_L) * (2 : k_L)⁻¹) * c * x * y +
                ((- (2 : k_L)⁻¹ * c * x ^ 2) + (- (2 : k_L)⁻¹ * c * y ^ 2)) := by ring
          _ = (- (2 : k_L)⁻¹ * c * x ^ 2) + (- (2 : k_L)⁻¹ * c * y ^ 2) := by
              rw [h2_inv, sub_self, zero_mul, zero_mul, zero_mul, zero_add]
      calc H (x + y) * ψ₀ (- (2 : k_L)⁻¹ * c * (x + y) ^ 2)
          = H x * H y * (ψ₀ (c * x * y) * ψ₀ (- (2 : k_L)⁻¹ * c * (x + y) ^ 2)) := by
            rw [hH_add x y, mul_assoc]
        _ = H x * H y * (ψ₀ (- (2 : k_L)⁻¹ * c * x ^ 2) * ψ₀ (- (2 : k_L)⁻¹ * c * y ^ 2)) := by
            rw [← hψ₀_add, h_quad_id, hψ₀_add]
        _ = (H x * ψ₀ (- (2 : k_L)⁻¹ * c * x ^ 2)) *
              (H y * ψ₀ (- (2 : k_L)⁻¹ * c * y ^ 2)) := by ring
    let S : k_L → R := fun B => ∑ x : k_L, φ x * ψ₀ (- B * x)
    have h_sum_S : (∑ B : k_L, S B) = (Fintype.card k_L : R) := by
      dsimp only [S]
      rw [Finset.sum_comm]
      have h_inner : ∀ x : k_L,
          (∑ B : k_L, φ x * ψ₀ (- B * x)) = φ x * ∑ B : k_L, ψ₀ (- B * x) := by
        intro x
        rw [← Finset.mul_sum]
      simp_rw [h_inner]
      rw [Finset.sum_eq_single (0 : k_L)]
      · simp [hφ_0, hψ₀_0]
      · intro x _ hx
        rw [h_orth x hx, mul_zero]
      · intro h0
        exact False.elim (h0 (Finset.mem_univ 0))
    have h_sum_ne : (∑ B : k_L, S B) ≠ 0 := by
      rw [h_sum_S]
      exact Nat.cast_ne_zero.mpr Fintype.card_ne_zero
    obtain ⟨B, _, hSB⟩ := Finset.exists_ne_zero_of_sum_ne_zero h_sum_ne
    refine ⟨B, fun y => ?_⟩
    have hS_shift : S B = S B * (φ y * ψ₀ (- B * y)) := by
      dsimp only [S]
      conv_lhs =>
        rw [← Fintype.sum_equiv (Equiv.addRight y) _ _ (fun _ => rfl)]
      have hterm : ∀ x : k_L,
          φ (x + y) * ψ₀ (- B * (x + y)) =
            (φ x * ψ₀ (- B * x)) * (φ y * ψ₀ (- B * y)) := by
        intro x
        have hBy : - B * (x + y) = - B * x + (- B * y) := by ring
        rw [hφ_add x y, hBy, hψ₀_add]
        ring
      simp_rw [Equiv.coe_addRight, hterm, ← Finset.sum_mul]
    have h_factor_zero : S B * (φ y * ψ₀ (- B * y) - 1) = 0 := by
      linear_combination -hS_shift
    have h_prod_one : φ y * ψ₀ (- B * y) = 1 :=
      sub_eq_zero.mp ((mul_eq_zero.mp h_factor_zero).resolve_left hSB)
    dsimp only [φ] at h_prod_one
    have h_comb :
        H y * ψ₀ (- ((2 : k_L)⁻¹ * c * y ^ 2 + B * y)) = 1 := by
      have h_neg_arg :
          (- (2 : k_L)⁻¹ * c * y ^ 2) + (- B * y) =
            - ((2 : k_L)⁻¹ * c * y ^ 2 + B * y) := by ring
      rw [← h_neg_arg, hψ₀_add, ← mul_assoc]
      exact h_prod_one
    calc H y
        = H y * (ψ₀ ((2 : k_L)⁻¹ * c * y ^ 2 + B * y) *
            ψ₀ (- ((2 : k_L)⁻¹ * c * y ^ 2 + B * y))) := by
          rw [hψ₀_mul_neg, mul_one]
      _ = (H y * ψ₀ (- ((2 : k_L)⁻¹ * c * y ^ 2 + B * y))) *
            ψ₀ ((2 : k_L)⁻¹ * c * y ^ 2 + B * y) := by ring
      _ = ψ₀ ((2 : k_L)⁻¹ * c * y ^ 2 + B * y) := by rw [h_comb, one_mul]
  obtain ⟨B_τ, hHτ_quad'⟩ :=
    h_polar_to_quad 1 H_τ hHτ_0 (by intro x y; simpa [one_mul] using hHτ_add x y)
  have hHτ_quad : ∀ x : k_L, H_τ x = ψ₀ ((2 : k_L)⁻¹ * x ^ 2 + B_τ * x) := by
    intro x
    simpa [mul_one] using hHτ_quad' x
  obtain ⟨B_χ, hHχ_quad⟩ := h_polar_to_quad d₀ H_χ hHχ_0 hHχ_add
  have hHτ_pow : ∀ (j : ℕ) (x : k_L),
      (H_τ x) ^ j = ψ₀ ((2 : k_L)⁻¹ * (j : k_L) * x ^ 2 + (j : k_L) * B_τ * x) := by
    intro j x
    rw [hHτ_quad x, hψ₀_pow]
    congr 1
    ring
  have hHτ_Hχ : ∀ (j : ℕ) (x : k_L),
      (H_τ x) ^ j * H_χ x =
        ψ₀ ((2 : k_L)⁻¹ * (d₀ + (j : k_L)) * x ^ 2 + (B_χ + (j : k_L) * B_τ) * x) := by
    intro j x
    rw [hHτ_pow j x, hHχ_quad x, ← hψ₀_add]
    congr 1
    ring
  haveI : Fact (Nat.Prime p) := ⟨hPrime⟩
  have hring : ringChar k_L = p := by
    have hdvd : ringChar k_L ∣ p := (ringChar.spec k_L p).mp hchar
    rcases (Nat.dvd_prime hPrime).mp hdvd with h1 | hp
    · exfalso
      have h0 : ((1 : ℕ) : k_L) = 0 := (ringChar.spec k_L 1).mpr (h1 ▸ dvd_refl _)
      rw [Nat.cast_one] at h0
      exact one_ne_zero h0
    · exact hp
  haveI : CharP k_L p := CharP.mk (fun x => by rw [← hring]; exact ringChar.spec k_L x)
  have h2_frob : ((2 : k_L)⁻¹) ^ p = (2 : k_L)⁻¹ := by
    have h2 : (2 : k_L) ^ p = (2 : k_L) := by
      have h11 : ((1 : k_L) + 1) ^ p = (1 : k_L) ^ p + (1 : k_L) ^ p :=
        add_pow_char (1 : k_L) 1 p
      norm_num at h11 ⊢
      exact h11
    rw [inv_pow, h2]
  have hK_quad : ∀ (C₀ : k_L), C₀ ^ p = B_χ - d₀ * B_τ →
      ∀ Z : k_L,
        H_χ (Z ^ p) * (H_τ (d₀ * Z ^ p))⁻¹ *
          ψ₀ ((2 : k_L)⁻¹ * μ * (d₀ - ζ ^ 2) * Z ^ 2) =
        ψ₀ ((2 : k_L)⁻¹ * (μ * (d₀ - ζ)) * Z ^ 2 + (- μ * C₀) * Z) := by
    intro C₀ hC₀ Z
    have h_split :
        H_χ (Z ^ p) * (H_τ (d₀ * Z ^ p))⁻¹ =
          ψ₀ ((2 : k_L)⁻¹ * d₀ * (Z ^ p) ^ 2) *
            ψ₀ (- ((2 : k_L)⁻¹ * (d₀ * Z ^ p) ^ 2)) *
            ψ₀ ((B_χ - d₀ * B_τ) * Z ^ p) := by
      rw [hHχ_quad (Z ^ p), hHτ_quad (d₀ * Z ^ p), hψ₀_inv,
        ← hψ₀_add, ← hψ₀_add, ← hψ₀_add]
      congr 1
      ring
    have h_p1 : (2 : k_L)⁻¹ * d₀ * (Z ^ p) ^ 2 = ((2 : k_L)⁻¹ * ζ * Z ^ 2) ^ p := by
      rw [hd₀_eq, mul_pow, mul_pow, h2_frob, pow_right_comm Z 2 p]
    have h_p2 : (2 : k_L)⁻¹ * (d₀ * Z ^ p) ^ 2 = ((2 : k_L)⁻¹ * ζ ^ 2 * Z ^ 2) ^ p := by
      calc (2 : k_L)⁻¹ * (d₀ * Z ^ p) ^ 2
          = ((2 : k_L)⁻¹) ^ p * (ζ ^ p) ^ 2 * (Z ^ p) ^ 2 := by
            rw [h2_frob, hd₀_eq]
            ring
        _ = ((2 : k_L)⁻¹ * ζ ^ 2 * Z ^ 2) ^ p := by
            rw [mul_pow, mul_pow, pow_right_comm ζ 2 p, pow_right_comm Z 2 p]
    have h_p3 : (B_χ - d₀ * B_τ) * Z ^ p = (C₀ * Z) ^ p := by
      rw [← hC₀, mul_pow]
    have h_f2 :
        ψ₀ (- ((2 : k_L)⁻¹ * (d₀ * Z ^ p) ^ 2)) =
          ψ₀ (- (- μ * ((2 : k_L)⁻¹ * ζ ^ 2 * Z ^ 2))) := by
      rw [← hψ₀_inv, h_p2, hψ₀_frob, hψ₀_inv]
    rw [h_split, h_p1, hψ₀_frob, h_f2, h_p3, hψ₀_frob,
      ← hψ₀_add, ← hψ₀_add, ← hψ₀_add]
    congr 1
    ring
  exact ⟨B_χ, B_τ, hHτ_quad, hHχ_quad, hHτ_pow, hHτ_Hχ, hK_quad⟩

theorem ld_wild_odd_prime_K_hasse_sum_polar_decomp (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hfrob_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 0 ∨
          1 ≤ valL F L (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)))))
    (hab_eq : condExp F L χ' = condExp F L ν₁)
    (hb_odd : condExp F L ν₁ % 2 = 1)
    (haK : condExp F K (χ'.comp (Units.map (normLM F hLK))) = condExp F L χ')
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (hSpecK : ∀ (θK : Kˣ →* (Ω F)ˣ),
      (∀ y : K, (y = 0 ∨ -condExpChar F K (traceChar F hLK ψ) ≤ valL F K y) →
        traceChar F hLK ψ y = 1) ∧
      (∃ y₁ : K, y₁ ≠ 0 ∧ -(condExpChar F K (traceChar F hLK ψ) + 1) ≤ valL F K y₁ ∧
        traceChar F hLK ψ y₁ ≠ 1) ∧
      (condExp F K θK ≠ 0 →
        (∀ w ∈ unitGroup F K (condExp F K θK), θK w = 1) ∧
        (∃ w₀ ∈ unitGroup F K (condExp F K θK - 1), θK w₀ ≠ 1)) ∧
      valL F K ((tateElt F K θK (traceChar F hLK ψ) : Kˣ) : K) =
        (condExp F K θK : ℤ) + condExpChar F K (traceChar F hLK ψ))
    (ϖ_K : Kˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLK) ϖ_K = ϖ_L)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hBasis : ∀ y : K, ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLK)) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
        IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F K y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
            c i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
                valL F L (c i) + (i : ℤ))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (t : ℕ) (ht_ge1 : 1 ≤ t) (hb_eq : condExp F L ν₁ = t + 1)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (hnorm_le : ∀ m ≤ t + 1, ∀ w ∈ unitGroup F K m,
      Units.map (normLM F hLK) w ∈ unitGroup F L m)
    (R_K : Finset K) (c_τ : Lˣ) (u : Kˣ) (N : Lˣ)
    (τ_unit τ_tilde : ℕ → Lˣ) (c_ν c_twist : ℕ → Lˣ) (c_χ : Lˣ) (c_χK : Kˣ)
    (hRK_card : R_K.card = Fintype.card k_L)
    (hRK_int : ∀ r ∈ R_K, r = 0 ∨ 0 ≤ valL F K r)
    (hRK_sep : ∀ r₁ ∈ R_K, ∀ r₂ ∈ R_K, r₁ ≠ r₂ → valL F K (r₁ - r₂) = 0)
    (hc_τ_val : valL F L (c_τ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hc_τ_stat : ∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_τ⁻¹ : Lˣ) : L) * x))
    (hu_norm : Units.map (normLM F hLK) u = N)
    (hu_val : valL F K (u : K) = 0)
    (hN_val : valL F L (N : L) = 0)
    (hc_χ_eq : c_χ = c_τ * N⁻¹)
    (hc_χK_inv : ((c_χK⁻¹ : Kˣ) : K) =
      IntermediateField.inclusion hLK (((c_τ⁻¹ : Lˣ) : L)) *
        (IntermediateField.inclusion hLK (N : L) - (u : K)))
    (hτ_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
      (τ_tilde j : L) = (j : L) ^ ((Module.finrank L (IntermediateField.extendScalars hLK)) ^ (condExp F L ν₁)) ∧
      τ_unit j = (τ_tilde j) ^ (Module.finrank L (IntermediateField.extendScalars hLK)) ∧
      Units.map (normLM F hLK) (Units.map (IntermediateField.inclusion hLK).toMonoidHom (τ_tilde j)) = τ_unit j ∧
      ν₁ (τ_unit j) = 1 ∧
      c_ν j = c_τ * (τ_unit j)⁻¹ ∧
      (N : L) + (τ_unit j : L) ≠ 0 ∧
      valL F L ((N : L) + (τ_unit j : L)) = 0 ∧
      (((c_twist j)⁻¹ : Lˣ) : L) = ((c_τ⁻¹ : Lˣ) : L) * ((N : L) + (τ_unit j : L)))
    (hc_χ_val : valL F L (c_χ : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_χ_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ⁻¹ : Lˣ) : L) * x))
    (hc_χK_val : valL F K (c_χK : K) = (condExp F L χ' : ℤ) + condExpChar F K (traceChar F hLK ψ))
    (hc_χK_stat : ∀ y : K, (y = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F K y) →
