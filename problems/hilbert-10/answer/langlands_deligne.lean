  have hvalM₁'_1 := hvalM₁'_props.2.1
  have hvalM₁'_neg := hvalM₁'_props.2.2.2.1
  have hvalM₁'_mul := hvalM₁'_props.2.2.2.2.1
  have hvalM₁'_add := hvalM₁'_props.2.2.2.2.2.2.2.1
  have hvalK₁_0 := hvalK₁_props.1
  have hvalK₁_1 := hvalK₁_props.2.1
  have hvalK₁_neg := hvalK₁_props.2.2.2.1
  have hvalK₁_mul := hvalK₁_props.2.2.2.2.1
  have hvalK₁_add := hvalK₁_props.2.2.2.2.2.2.2.1
  have hvalL_mul_ge : ∀ (A B : ℤ) (x y : L),
      (x = 0 ∨ A ≤ valL F L x) → (y = 0 ∨ B ≤ valL F L y) →
      (x * y = 0 ∨ A + B ≤ valL F L (x * y)) := by
    intro A B x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hx' : A ≤ valL F L x := hx.resolve_left hx0
        have hy' : B ≤ valL F L y := hy.resolve_left hy0
        rw [hvalL_mul x y hx0 hy0]
        linarith
  have hvalL_pow_eq : ∀ (x : L), x ≠ 0 → ∀ (n : ℕ),
