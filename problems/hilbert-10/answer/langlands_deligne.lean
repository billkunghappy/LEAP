              valL F M₁' (U a' + ι a_last * w_last) =
                (p : ℤ) * valL F L a_last + valL F M₁' (w_last - U b_scale) := by
            rw [hcomb_eq, hval_mul_M₁' (ι a_last) (w_last - U b_scale) hι_ne0 hdiff_ne0,
