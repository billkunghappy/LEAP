    ld_ch12_wild_dyadic_unramified_min_cond_odd_biquad_trace_E_term F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hdeg2 hdegE'K₁
      ψ νE' hνE'_ker hbE'_ge2 hT_odd
      hval_LM₁' hval_LE' hval_norm_LE' htr_bound_LM₁' htr_bound_LE'
      hDiamond_M₁' d hd_val hd_tr c_ν x C hC_eq hx_int hc_ν_val hc_ν_stat
