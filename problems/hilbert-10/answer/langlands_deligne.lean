      exact hP_mono (2 * (r : ℤ))
        (hP_neg (hP_mul hP_8 (hP_mul hP_β₁ (hP_mul hP_f (hP_mul hP_f hs₁_sq))))) (by omega)
    rw [hψ_eq_2r _ _ hrem, mul_add, AddChar.map_add_eq_mul, hM₁'_scaled_odd s₁ hs₁, one_mul]
  have hM₁'_step : ∀ s₀ : L, (s₀ = 0 ∨ (a : ℤ) ≤ 2 * valL F L s₀) →
      let s₀' := 4 * (f * s₀)
      ψ (((α⁻¹ : Lˣ) : L) * (β₁ * (2 * s₀ + s₀ ^ 2))) *
        ψ (((α⁻¹ : Lˣ) : L) * (β₁ * (2 * s₀' + s₀' ^ 2))) = 1 := by
    intro s₀ hs₀
    dsimp only
    have hs₀_sq : s₀ ^ 2 = 0 ∨ (a : ℤ) ≤ valL F L (s₀ ^ 2) := hP_sq_iff.mp hs₀
    set s₁ := -(2 * s₀)
    have hs₁ : s₁ = 0 ∨ 3 * (a : ℤ) - 1 ≤ 2 * valL F L s₁ := by
      rw [hP_sq_iff, show s₁ ^ 2 = 4 * s₀ ^ 2 by dsimp [s₁]; ring]
      exact hP_mono (3 * (a : ℤ) - 1) (hP_mul hP_4 hs₀_sq) (by omega)
    have hs₀'_eq : -(2 * (f * s₁)) = 4 * (f * s₀) := by
      dsimp [s₁]
      calc -(2 * (f * -(2 * s₀))) = (2 * 2) * (f * s₀) := by ring
        _ = 4 * (f * s₀) := by norm_num
    have hod := hM₁'_odd_to_even s₁ hs₁
    dsimp only at hod
    rw [hs₀'_eq] at hod
    rw [← hod, ← AddChar.map_add_eq_mul]
    rw [show ((α⁻¹ : Lˣ) : L) * (β₁ * (2 * s₀ + s₀ ^ 2)) +
        ((α⁻¹ : Lˣ) : L) * (β₁ * (s₁ + f * s₁ ^ 2)) =
      ((α⁻¹ : Lˣ) : L) * (β₁ * (1 + 4 * f) * s₀ ^ 2) by
      dsimp [s₁]
      calc ((α⁻¹ : Lˣ) : L) * (β₁ * (2 * s₀ + s₀ ^ 2)) +
          ((α⁻¹ : Lˣ) : L) * (β₁ * (-(2 * s₀) + f * (-(2 * s₀)) ^ 2))
        _ = ((α⁻¹ : Lˣ) : L) * (β₁ * (1 + (2 * 2) * f) * s₀ ^ 2) := by ring
