theorem ld_ch14_wild_prime_sub_and_super_norm_step (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M] [FiniteDimensional F K]
    (hMK : M ≤ K)
    (hp_prime : Nat.Prime (p F))
    (hValNorm : ∀ w : K, valL F M (normLM F hMK w) = valL F K w)
    (ϖ_K : Kˣ) (ϖ_M : Mˣ)
    (hϖ_norm : Units.map (normLM F hMK) ϖ_K = ϖ_M)
