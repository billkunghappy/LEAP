        obtain ⟨_, _, hps_z⟩ := hIcc_1_p1_idx s hs
        have hA2_s := hvalK₁_pow_ge A_ge2 s m₀ hA_ge2_val
        have hA1_ps := hvalK₁_pow_ge A₁ (p - s) (-(t₁ : ℤ)) hA₁_val
        have hprod := hvalK₁_mul_ge ((s : ℤ) * m₀) (((p - s : ℕ) : ℤ) * (-(t₁ : ℤ)))
          (A_ge2 ^ s) (A₁ ^ (p - s)) hA2_s hA1_ps
        have htr_s : trM₁'K₁ (A_ge2 ^ s * A₁ ^ (p - s)) = 0 ∨
            (0 : ℤ) ≤ vM₁' (trM₁'K₁ (A_ge2 ^ s * A₁ ^ (p - s))) := by
          apply htr_M₁'K₁_0 (A_ge2 ^ s * A₁ ^ (p - s))
          refine hvalK₁_mono _ _ _ ?_ hprod
          have hsm₀ : (0 : ℤ) ≤ (s : ℤ) * m₀ := mul_nonneg (Nat.cast_nonneg s) hm₀_nonneg
          linarith only [hsm₀, hps_z]
        have hmul := hvalM₁'_mul_ge (((p - 1 : ℕ) : ℤ) * (t₂ : ℤ)) 0
          ((p.choose s : ℕ) : R_M) (trM₁'K₁ (A_ge2 ^ s * A₁ ^ (p - s)))
          (hchoose_valM₁' s hs) htr_s
        rw [add_zero] at hmul
        exact hvalM₁'_mono m₀ _ _ hm₀_le_p1t₂ hmul
      have hterm_sp : trM₁'K₁ (A_ge2 ^ p) = 0 ∨
          m₀ ≤ vM₁' (trM₁'K₁ (A_ge2 ^ p)) :=
        htr_M₁'K₁_m m₀ (A_ge2 ^ p) (hvalK₁_pow_ge A_ge2 p m₀ hA_ge2_val)
      rw [hWp_decomp]
      exact hvalM₁'_add m₀ _ _ (hvalM₁'_add m₀ _ _ hterm_s0 hterm_mid) hterm_sp

    have hQp_bound : Q_p - ((p : ℕ) : R_M) * b ^ p = 0 ∨
        m₀ ≤ vM₁' (Q_p - ((p : ℕ) : R_M) * b ^ p) := by
      have hQp_decomp :
          Q_p - ((p : ℕ) : R_M) * b ^ p =
            (- (((p : ℕ) : R_M) * b ^ (p - 1) * trM₁'K₁ W_Δ)) +
              (∑ r ∈ Finset.Icc 2 (p - 1),
                ((p.choose r : ℕ) : R_M) * b ^ (p - r) * trM₁'K₁ ((-W_Δ) ^ r)) +
