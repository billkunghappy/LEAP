          ← Multiplicative.toAdd_lt, toAdd_one] at hlt
        unfold addVal
        rw [dif_neg hp0]
        omega
    simpa using halgMC1 (p F : F) hpF
  obtain ⟨S₁_K, hS₁_K⟩ := ld_valL_mod_one_finset F K hvalK0 hvalK_neg hvalK_mul hvalK_add
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halgK0 halgK1 R_F hRF_0 hRF_mod1
  obtain ⟨k_K, hField_kK, hFin_kK, resK, hresK_0, hresK_1, hresK_ring, hresK_ker, hresK_surj⟩ :=
    ld_valL_residue_field_exists F K hvalK0 hvalK1 hvalK_neg1 hvalK_neg hvalK_mul hvalK_inv
      hvalK_add S₁_K hS₁_K
  letI : Field k_K := hField_kK
  letI : Fintype k_K := hFin_kK
  have hRam_all : ∀ i : Fin r, condExp F M_C (ν_orb i) ≠ 0 := by
    intro i
    have hνi := hν_props i
    have hcond_i : ∀ u ∈ unitGroup F M_C (condExp F M_C (ν_orb i)), (ν_orb i) u = 1 := by
      intro u hu
      simpa using hνi.2.2.2.1 1 hPrime_MCK.one_lt u (by simpa using hu)
    exact ld_ch13_tame_mc_cond_ne_zero F L K M_C hLK hLM_C hM_CK hGal hGalMCK hMin hCentralizer
      hPrime_MCK hf_H_gt1 (ν_orb i) hνi.1 hνi.2.1 hνi.2.2.1 hcond_i
      haddVal1 haddVal_mul hvalL_props hvalMC_props hvalK_props
      k_K resK hresK_0 hresK_1 hresK_ring hresK_ker hresK_surj
      (fun hval_alg_MCK G _ act hact_ring hact_incl hact_faithful hact_val σ hσ_res =>
        ld_unramified_inertia_trivial_of_resK_fix F M_C K hM_CK hval_alg_MCK hvalMC_surj
          ⟨hvalK0, hvalK1, hvalK_neg1, hvalK_neg, hvalK_mul, hvalK_inv, hvalK_surj, hvalK_add⟩
          G act hact_ring hact_incl hact_faithful hact_val
          k_K resK hresK_0 hresK_1 hresK_ring hresK_ker σ hσ_res)
  have hν_cond1 : ∀ i : Fin r,
      condExp F M_C (ν_orb i) = 1 ∧ (∀ u ∈ unitGroup F M_C 1, (ν_orb i) u = 1) := by
    intro i
    have hνi := hν_props i
    obtain ⟨_, htriv1, hcond_eq, _⟩ :=
      ld_tame_unit_triv_val_and_residue_surj F M_C K hM_CK hPrime_MCK (ν_orb i)
        hνi.1 hνi.2.1 hνi.2.2.1 hνi.2.2.2.1 (hRam_all i) hNeP hp hp_valMC
        haddVal1 haddVal_mul hvalMC_props hvalK_props
    have h1 : condExp F M_C (ν_orb i) = 1 := by
      simpa using hcond_eq 1 hPrime_MCK.one_lt one_ne_zero
    exact ⟨h1, htriv1⟩
  let i₀ : Fin r := ⟨0, hr_pos⟩
  have hν₀ := hν_props i₀
  obtain ⟨⟨hℓ_ne0_MC, hℓ_val0_MC⟩, _, _, _,
      hResDeg_MCK, hValNorm_MCK, hValAlg_MCK, ⟨ϖ_K₀, hϖ_K₀⟩, hResSurj_MCK⟩ :=
    ld_tame_unit_triv_val_and_residue_surj F M_C K hM_CK hPrime_MCK (ν_orb i₀)
      hν₀.1 hν₀.2.1 hν₀.2.2.1 hν₀.2.2.2.1 (hRam_all i₀) hNeP hp hp_valMC
      haddVal1 haddVal_mul hvalMC_props hvalK_props
  obtain ⟨hTraceBound_MCK, hNormRem_MCK, _⟩ :=
    ld_tame_galois_trace_norm_bounds_and_uniformizer F M_C K hM_CK hGalMCK hPrime_MCK (ν_orb i₀)
      hν₀.2.2.1 hℓ_ne0_MC hℓ_val0_MC hValNorm_MCK hValAlg_MCK ϖ_K₀ hϖ_K₀
      hvalMC_props hvalK_props
  obtain ⟨hz₀_ex, hResDeg_LMC, hqMC, hValNorm_LMC, hValAlg_LMC, hTraceBound_LMC, hNormLin_LMC,
      ⟨y₁, hy₁_int, hy₁_tr⟩, hFinLMC',
      G, hGroupG, hFinG, act, hcard_G, hact_one, hact_mul, hact_ring, hact_incl,
      hact_faithful, hact_val, hact_trace, hact_norm, hact_lift⟩ :=
    ld_ch13_tame_z0_lift_and_unramified_mc F L K M_C hLK hLM_C hM_CK hGal hGalMCK hMin hCentralizer
      hPrime_MCK hf_H_gt1 hℓ_ne0_MC hℓ_val0_MC hValNorm_MCK hValAlg_MCK ϖ_K₀ hϖ_K₀ hResSurj_MCK
      haddVal1 haddVal_mul hvalL_props hvalMC_props hvalK_props
  haveI : FiniteDimensional L (IntermediateField.extendScalars hLM_C) := hFinLMC'
  letI : Group G := hGroupG
  letI : Fintype G := hFinG
  obtain ⟨z₀, hz₀_val, hz₀_pow, hz₀_not1, hz₀_move⟩ := hz₀_ex
  have hz₀_act_move : ∀ σ : G, σ ≠ 1 →
      act σ (z₀ : M_C) - (z₀ : M_C) ≠ 0 ∧ valL F M_C (act σ (z₀ : M_C) - (z₀ : M_C)) = 0 := by
    intro σ hσ
    obtain ⟨τ, hτL, hτMC, hτ_act⟩ := hact_lift σ hσ
    obtain ⟨hτz, hact_eq⟩ := hτ_act (z₀ : M_C)
    rw [hact_eq]
    exact hz₀_move τ hτL hτMC hτz
  obtain ⟨S₁_L, hS₁_L⟩ := ld_valL_mod_one_finset F L hvalL0 hvalL_neg hvalL_mul hvalL_add
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halgL0 halgL1 R_F hRF_0 hRF_mod1
  obtain ⟨S₁_MC, hS₁_MC⟩ := ld_valL_mod_one_finset F M_C hvalMC0 hvalMC_neg hvalMC_mul hvalMC_add
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halgMC0 halgMC1 R_F hRF_0 hRF_mod1
  obtain ⟨k_L, hField_kL, hFin_kL, resL, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ :=
    ld_valL_residue_field_exists F L hvalL0 hvalL1 hvalL_neg1 hvalL_neg hvalL_mul hvalL_inv
      hvalL_add S₁_L hS₁_L
  obtain ⟨k_M, hField_kM, hFin_kM, resM, hresM_0, hresM_1, hresM_ring, hresM_ker, hresM_surj⟩ :=
    ld_valL_residue_field_exists F M_C hvalMC0 hvalMC1 hvalMC_neg1 hvalMC_neg hvalMC_mul hvalMC_inv
      hvalMC_add S₁_MC hS₁_MC
  letI : Field k_L := hField_kL
  letI : Fintype k_L := hFin_kL
  letI : Field k_M := hField_kM
  letI : Fintype k_M := hFin_kM
  obtain ⟨hAlg_k, π_res, hres_alg, hπ_res⟩ :=
    ld_unramified_residue_algebra_and_galois_hom F L M_C hLM_C hValAlg_LMC
      ⟨hvalL0, hvalL1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_surj, hvalL_add⟩
      ⟨hvalMC0, hvalMC1, hvalMC_neg1, hvalMC_neg, hvalMC_mul, hvalMC_inv, hvalMC_surj, hvalMC_add⟩
      G act hact_one hact_mul hact_ring hact_incl hact_val
      k_L k_M resL resM hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      hresM_0 hresM_1 hresM_ring hresM_ker hresM_surj
  letI : Algebra k_L k_M := hAlg_k
  have hπ_inj : Function.Injective π_res := by
    rw [injective_iff_map_eq_one]
    intro σ hσ1
    apply ld_unramified_inertia_trivial_of_resK_fix F L M_C hLM_C hValAlg_LMC
      hvalL_surj
      ⟨hvalMC0, hvalMC1, hvalMC_neg1, hvalMC_neg, hvalMC_mul, hvalMC_inv, hvalMC_surj, hvalMC_add⟩
      G act hact_ring hact_incl hact_faithful hact_val
      k_M resM hresM_0 hresM_1 hresM_ring hresM_ker σ
    intro z hz
    rw [← hπ_res σ z hz, hσ1]
    rfl
  have hfinrank_res :=
    ld_unramified_residue_finrank_eq_of_galois_inj F L M_C hLM_C hValAlg_LMC
      ⟨hvalL0, hvalL1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_surj, hvalL_add⟩
      ⟨hvalMC0, hvalMC1, hvalMC_neg1, hvalMC_neg, hvalMC_mul, hvalMC_inv, hvalMC_surj, hvalMC_add⟩
      G hcard_G k_L k_M resL resM hresL_1 hresM_0 hresM_ring hresM_surj
      hres_alg π_res hπ_inj
  have hℓ_ne0_L : (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : L) ≠ 0 := by
    intro h0
    apply hℓ_ne0_MC
    have hmap := congrArg (IntermediateField.inclusion hLM_C) h0
    simpa using hmap
  have hℓ_val0_L : valL F L (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : L) = 0 := by
    rw [← hValAlg_LMC (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : L)]
    simpa using hℓ_val0_MC
  obtain ⟨hϖ_L, hResDeg_LE, hqE, hValNorm_LE, hValAlg_LE, hResSurj_LE, hTraceBound_LE, hNormRem_LE⟩ :=
    ld_ch13_tame_branch_E_invariants_and_uniformizer F L K M_C E hLK hLM_C hM_CK hLE hEK
      hPrime_MCK hFinE_eq r hr_mul ν_orb (fun i => (hν_props i).2.2.1)
      hResDeg_MCK hValNorm_MCK hValAlg_MCK hTraceBound_MCK hNormRem_MCK
      hResDeg_LMC hValAlg_LMC haddVal1 haddVal_mul
      ⟨hvalL0, hvalL1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_surj, hvalL_add⟩
      ⟨hvalE0, hvalE1, hvalE_neg1, hvalE_neg, hvalE_mul, hvalE_inv, hvalE_surj, hvalE_add⟩
      ⟨hvalK0, hvalK1, hvalK_neg1, hvalK_neg, hvalK_mul, hvalK_inv, hvalK_surj, hvalK_add⟩
  obtain ⟨hcondChar_MC, hcond_MC, hcond_νχ_MC, hcondChar_E, hcond_E, hT0⟩ :=
    ld_ch13_tame_diamond_conductors_and_unramified_twist F L K M_C E hLK hLM_C hM_CK hLE
      hPrime_MCK hFinE_eq ψ hψ hψMC hψE r hr_pos hf_H_gt1 hr_mul χ' ν_orb
      hχ'_cond hχ'E_cond hχ'MC_cond hν_props hν_cond1
      z₀ hz₀_val hz₀_pow hValNorm_LMC hValAlg_LMC hTraceBound_LMC hNormLin_LMC
      y₁ hy₁_int hy₁_tr G act hcard_G hact_val hact_norm hz₀_act_move
      k_L k_M resL resM hfinrank_res
      hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      hresM_0 hresM_1 hresM_ring hresM_ker hresM_surj
      hres_alg π_res hπ_inj hπ_res
      hℓ_ne0_L hℓ_val0_L hValNorm_LE hValAlg_LE hTraceBound_LE hNormRem_LE
      hvalL_props hvalMC_props hvalE_props
      (ld_condExp_and_condExpChar_spec F L ψ hψ)
      (ld_condExp_and_condExpChar_spec F M_C (traceChar F hLM_C ψ) hψMC)
      (ld_condExp_and_condExpChar_spec F E (traceChar F hLE ψ) hψE)
      (ld_unitCoset_finite F M_C)
  exact ⟨hν_cond1, hϖ_L, ⟨z₀, hz₀_val, hz₀_pow, hz₀_not1, hz₀_move⟩,
    hResDeg_LMC, hqMC, hValNorm_LMC, hValAlg_LMC, hTraceBound_LMC, hNormLin_LMC,
    hcondChar_MC, hcond_MC, hcond_νχ_MC,
    hResDeg_LE, hqE, hValNorm_LE, hValAlg_LE, hResSurj_LE, hTraceBound_LE, hNormRem_LE,
    hcondChar_E, hcond_E, hT0⟩

theorem ld_ch13_unramified_mc_galois_aut (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] (hLM_C : L ≤ M_C)
    (hGalMC : IsGaloisExt F L M_C)
    (hf_H_gt1 : 1 < Module.finrank L (IntermediateField.extendScalars hLM_C))
    (hval_norm_MC : ∀ z : M_C, valL F L (normLM F hLM_C z) =
      (Module.finrank L (IntermediateField.extendScalars hLM_C) : ℤ) * valL F M_C z) :
    FiniteDimensional L (IntermediateField.extendScalars hLM_C) ∧
    ∃ (G : Type u) (_ : Group G) (_ : Fintype G) (act : G → M_C → M_C),
      Fintype.card G = Module.finrank L (IntermediateField.extendScalars hLM_C) ∧
      (∀ z : M_C, act 1 z = z) ∧
      (∀ (σ τ : G) (z : M_C), act (σ * τ) z = act σ (act τ z)) ∧
      (∀ σ : G,
        act σ 0 = 0 ∧ act σ 1 = 1 ∧
        (∀ z₁ z₂ : M_C,
          act σ (z₁ + z₂) = act σ z₁ + act σ z₂ ∧
          act σ (z₁ * z₂) = act σ z₁ * act σ z₂ ∧
          act σ (-z₁) = -act σ z₁)) ∧
      (∀ (σ : G) (x : L), act σ (IntermediateField.inclusion hLM_C x) =
        IntermediateField.inclusion hLM_C x) ∧
      (∀ σ : G, (∀ z : M_C, act σ z = z) → σ = 1) ∧
      (∀ (σ : G) (z : M_C), valL F M_C (act σ z) = valL F M_C z) ∧
      (∀ z : M_C, IntermediateField.inclusion hLM_C (traceLM F hLM_C z) = ∑ σ : G, act σ z) ∧
      (∀ z : M_C, IntermediateField.inclusion hLM_C (normLM F hLM_C z) = ∏ σ : G, act σ z) ∧
      (∀ (z₀ : M_C),
        (∀ σ ∈ L.fixingSubgroup, σ ∉ M_C.fixingSubgroup →
          ∀ hσz : (σ : AbsGal F) (z₀ : AlgebraicClosure F) ∈ M_C,
            (⟨(σ : AbsGal F) (z₀ : AlgebraicClosure F), hσz⟩ : M_C) - z₀ ≠ 0 ∧
            valL F M_C ((⟨(σ : AbsGal F) (z₀ : AlgebraicClosure F), hσz⟩ : M_C) - z₀) = 0) →
        ∀ σ : G, σ ≠ 1 → act σ z₀ - z₀ ≠ 0 ∧ valL F M_C (act σ z₀ - z₀) = 0) :=
by
  let M_C' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLM_C
  have hFinLM_C' : FiniteDimensional L M_C' := by
    haveI : FiniteDimensional F M_C' := ‹FiniteDimensional F M_C›
    haveI : IsScalarTower F L M_C' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact Module.Finite.of_restrictScalars_finite F L M_C'
  haveI : FiniteDimensional L M_C' := hFinLM_C'
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
  have hGalLM_C' : IsGalois L ↥M_C' := by
    have hSepLM_C' : Algebra.IsSeparable L M_C' := hGalMC.2.2.2 hLM_C
    haveI : Algebra.IsSeparable L M_C' := hSepLM_C'
    have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
        [Normal k Ω_bar] (K₀ : IntermediateField k Ω_bar) [hSepK₀ : Algebra.IsSeparable k K₀],
        (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
        IsGalois k K₀ := by
      intro k Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
      let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
      haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
      haveI : Normal k N := IsGalois.to_normal
      have hK₀N : K₀ ≤ N := by
        intro z hz
        rw [mem_separableClosure_iff]
        let x : K₀ := ⟨z, hz⟩
        have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K₀ _ _ _ hSepK₀ x
        have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K₀.val K₀.val.injective x
        change (minpoly k z).Separable
        rw [hmin]
        exact hx
      let K_N : IntermediateField k N := K₀.comap N.val
      have hKN_map : K_N.map N.val = K₀ := by
        ext z
        refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
        rintro ⟨y, hy, rfl⟩
        exact hy
      have hKN_norm : K_N.fixingSubgroup.Normal := by
        refine ⟨fun h hh g => ?_⟩
        obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
        obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
        rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
        have hτ_fix : ∀ x ∈ K₀, τ x = x := by
          intro x hx
          let z : N := ⟨x, hK₀N hx⟩
          have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
          have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
          rwa [AlgEquiv.restrictNormalHom_apply] at h1
        intro y hy
        apply Subtype.ext
        rw [← map_inv, ← map_mul, ← map_mul]
        change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
        rw [AlgEquiv.restrictNormalHom_apply]
        exact h_norm_fix σ τ hτ_fix y.1 hy
      haveI : K_N.fixingSubgroup.Normal := hKN_norm
      haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
      let e_KN : ↥K_N ≃ₐ[k] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
      exact IsGalois.of_algEquiv e_KN
    have hM_C'_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F),
        (∀ x ∈ M_C', τ x = x) → ∀ x ∈ M_C', (σ * τ * σ⁻¹) x = x := by
      intro σ τ hτ
      let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
      let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
      have hτM_C : τ_F.1 ∈ M_C.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hLM_C).mpr hx)
      have hconjM_C : (σ_F * τ_F * σ_F⁻¹).1 ∈ M_C.fixingSubgroup :=
        hGalMC.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτM_C
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjM_C
      exact hconjM_C x ((IntermediateField.mem_extendScalars hLM_C).mp hx)
    exact helper_isGalois L (AlgebraicClosure F) M_C' hM_C'_norm_fix
  haveI : IsGalois L ↥M_C' := hGalLM_C'
  haveI : Normal L ↥M_C' := IsGalois.to_normal
  let G : Type u := (M_C' ≃ₐ[L] M_C')
  have hcard_G : Fintype.card G = Module.finrank L M_C' :=
    Fintype.card_eq_nat_card.trans (IsGalois.card_aut_eq_finrank L M_C')
  let fromExtendScalars : M_C' →+* M_C :=
    { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hLM_C).mp z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let act : G → M_C → M_C := fun σ z => fromExtendScalars (σ (toExtendScalars F hLM_C z))
  have hact_one : ∀ z : M_C, act 1 z = z := fun _ => rfl
  have hact_mul : ∀ (σ τ : G) (z : M_C), act (σ * τ) z = act σ (act τ z) := fun _ _ _ => rfl
  have hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ z₁ z₂ : M_C,
        act σ (z₁ + z₂) = act σ z₁ + act σ z₂ ∧
        act σ (z₁ * z₂) = act σ z₁ * act σ z₂ ∧
        act σ (-z₁) = -act σ z₁) := by
    intro σ
    refine ⟨by simp [act], by simp [act], fun z₁ z₂ => ⟨by simp [act], by simp [act], by simp [act]⟩⟩
  have hact_incl : ∀ (σ : G) (x : L),
      act σ (IntermediateField.inclusion hLM_C x) = IntermediateField.inclusion hLM_C x := by
    intro σ x
    change fromExtendScalars (σ (algebraMap L M_C' x)) = IntermediateField.inclusion hLM_C x
    rw [σ.commutes x]
    rfl
  have hact_faithful : ∀ σ : G, (∀ z : M_C, act σ z = z) → σ = 1 := by
    intro σ h
    apply AlgEquiv.ext
    intro z
    exact congrArg (toExtendScalars F hLM_C) (h (fromExtendScalars z))
  have hact_trace : ∀ z : M_C,
      IntermediateField.inclusion hLM_C (traceLM F hLM_C z) = ∑ σ : G, act σ z := by
    intro z
    have h1 := congrArg fromExtendScalars
      (trace_eq_sum_automorphisms (K := L) (L := M_C') (toExtendScalars F hLM_C z))
    exact h1.trans (map_sum fromExtendScalars (fun σ : G => σ (toExtendScalars F hLM_C z)) Finset.univ)
  have hact_norm : ∀ z : M_C,
      IntermediateField.inclusion hLM_C (normLM F hLM_C z) = ∏ σ : G, act σ z := by
    intro z
    have h1 := congrArg fromExtendScalars
      (Algebra.norm_eq_prod_automorphisms L (toExtendScalars F hLM_C z))
    exact h1.trans (map_prod fromExtendScalars (fun σ : G => σ (toExtendScalars F hLM_C z)) Finset.univ)
  have hinj : Function.Injective (IntermediateField.inclusion hLM_C) :=
    (IntermediateField.inclusion hLM_C).injective
  have hact_val : ∀ (σ : G) (z : M_C), valL F M_C (act σ z) = valL F M_C z := by
    intro σ z
    have hnorm_eq : normLM F hLM_C (act σ z) = normLM F hLM_C z := by
      apply hinj
      rw [hact_norm (act σ z), hact_norm z]
      have hmul : (∏ τ : G, act τ (act σ z)) = ∏ τ : G, act (τ * σ) z := by
        refine Finset.prod_congr rfl fun τ _ => ?_
        rw [hact_mul]
      rw [hmul]
      exact Equiv.prod_comp (Equiv.mulRight σ) (fun τ => act τ z)
    have hval_eq := congrArg (valL F L) hnorm_eq
    rw [hval_norm_MC (act σ z), hval_norm_MC z] at hval_eq
    have h_ne_zero : (Module.finrank L M_C' : ℤ) ≠ 0 := by
      change (Module.finrank L (IntermediateField.extendScalars hLM_C) : ℤ) ≠ 0
      omega
    exact mul_left_cancel₀ h_ne_zero hval_eq
  have hact_z₀ : ∀ (z₀ : M_C),
      (∀ σ ∈ L.fixingSubgroup, σ ∉ M_C.fixingSubgroup →
        ∀ hσz : (σ : AbsGal F) (z₀ : AlgebraicClosure F) ∈ M_C,
          (⟨(σ : AbsGal F) (z₀ : AlgebraicClosure F), hσz⟩ : M_C) - z₀ ≠ 0 ∧
          valL F M_C ((⟨(σ : AbsGal F) (z₀ : AlgebraicClosure F), hσz⟩ : M_C) - z₀) = 0) →
      ∀ σ : G, σ ≠ 1 → act σ z₀ - z₀ ≠ 0 ∧ valL F M_C (act σ z₀ - z₀) = 0 := by
    intro z₀ hz₀ σ hσ
    obtain ⟨σ_L, hσ_L⟩ := AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F) σ
    let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ_L
    have hσ_F_apply : ∀ z : M_C,
        (σ_F.1 : AbsGal F) (z : AlgebraicClosure F) = (act σ z : AlgebraicClosure F) := by
      intro z
      let z' : ↥M_C' := toExtendScalars F hLM_C z
      have h1 : (((AlgEquiv.restrictNormalHom ↥M_C' σ_L) z' : ↥M_C') : AlgebraicClosure F) = σ_L z'.1 :=
        AlgEquiv.restrictNormalHom_apply M_C' σ_L z'
      rw [hσ_L] at h1
      exact h1.symm
    have hnot_mem : σ_F.1 ∉ M_C.fixingSubgroup := by
      intro hmem
      rw [IntermediateField.mem_fixingSubgroup_iff] at hmem
      apply hσ
      apply hact_faithful σ
      intro z
      apply Subtype.ext
      rw [← hσ_F_apply z]
      exact hmem z.1 z.2
    have hσz₀ : (σ_F.1 : AbsGal F) (z₀ : AlgebraicClosure F) ∈ M_C := by
      rw [hσ_F_apply z₀]
      exact (act σ z₀).2
    have heq_z₀ : (⟨(σ_F.1 : AbsGal F) (z₀ : AlgebraicClosure F), hσz₀⟩ : M_C) = act σ z₀ :=
      Subtype.ext (hσ_F_apply z₀)
    have hres := hz₀ σ_F.1 σ_F.2 hnot_mem hσz₀
    rwa [heq_z₀] at hres
  exact ⟨hFinLM_C', G, inferInstance, inferInstance, act,
    hcard_G, hact_one, hact_mul, hact_ring, hact_incl, hact_faithful, hact_val,
    hact_trace, hact_norm, hact_z₀⟩

theorem ld_ch13_unramified_mc_frob_and_charpoly_bridge (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] (hLM_C : L ≤ M_C)
    (ℓ r : ℕ) (hPrime_ℓ : Nat.Prime ℓ)
    (hf_H_gt1 : 1 < Module.finrank L (IntermediateField.extendScalars hLM_C))
    (ν_orb : Fin r → (M_Cˣ →* (Ω F)ˣ))
    (hν_pow : ∀ i : Fin r, (ν_orb i) ^ ℓ = 1)
    (hν_triv1 : ∀ i : Fin r, ∀ u ∈ unitGroup F M_C 1, (ν_orb i) u = 1)
    (ϖ_L : Lˣ) (hϖ_L_val : valL F L (ϖ_L : L) = 1)
    (hϖ_L_ν : ∀ i : Fin r,
      (ν_orb i) (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom ϖ_L) = 1)
    (z₀ : M_Cˣ) (hz₀_val : valL F M_C (z₀ : M_C) = 0)
    (hz₀_pow : z₀ ^ ℓ ∈ unitGroup F M_C 1)
    (hz₀_not1 : z₀ ∉ unitGroup F M_C 1)
    (hval_norm_MC : ∀ z : M_C, valL F L (normLM F hLM_C z) =
      (Module.finrank L (IntermediateField.extendScalars hLM_C) : ℤ) * valL F M_C z)
    (hval_alg_MC : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = valL F L x)
    (htr_bound_MC : ∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
      (traceLM F hLM_C z = 0 ∨ m ≤ valL F L (traceLM F hLM_C z)))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))))
    (hvalMC_props : valL F M_C 0 = 0 ∧ valL F M_C 1 = 0 ∧ valL F M_C (-1) = 0 ∧
      (∀ x : M_C, valL F M_C (-x) = valL F M_C x) ∧
      (∀ x y : M_C, x ≠ 0 → y ≠ 0 → valL F M_C (x * y) = valL F M_C x + valL F M_C y) ∧
      (∀ u : M_Cˣ, valL F M_C ((u⁻¹ : M_Cˣ) : M_C) = - valL F M_C (u : M_C)) ∧
      (∀ (k : ℤ) (x y : M_C),
        (x = 0 ∨ k ≤ valL F M_C x) → (y = 0 ∨ k ≤ valL F M_C y) →
          (x + y = 0 ∨ k ≤ valL F M_C (x + y))) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M_Cˣ,
        u ∈ unitGroup F M_C a ↔ ((u : M_C) = 1 ∨ (a : ℤ) ≤ valL F M_C ((u : M_C) - 1))))
    (G : Type u) [Group G] [Fintype G] (act : G → M_C → M_C)
    (hcard_G : Fintype.card G = Module.finrank L (IntermediateField.extendScalars hLM_C))
    (hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ z₁ z₂ : M_C,
        act σ (z₁ + z₂) = act σ z₁ + act σ z₂ ∧
        act σ (z₁ * z₂) = act σ z₁ * act σ z₂ ∧
        act σ (-z₁) = -act σ z₁))
    (hact_incl : ∀ (σ : G) (x : L),
      act σ (IntermediateField.inclusion hLM_C x) = IntermediateField.inclusion hLM_C x)
    (hact_val : ∀ (σ : G) (z : M_C), valL F M_C (act σ z) = valL F M_C z)
    (hact_trace : ∀ z : M_C, IntermediateField.inclusion hLM_C (traceLM F hLM_C z) = ∑ σ : G, act σ z)
    (hact_norm : ∀ z : M_C, IntermediateField.inclusion hLM_C (normLM F hLM_C z) = ∏ σ : G, act σ z)
    (hz₀_move : ∀ σ : G, σ ≠ 1 →
      act σ (z₀ : M_C) - (z₀ : M_C) ≠ 0 ∧ valL F M_C (act σ (z₀ : M_C) - (z₀ : M_C)) = 0)
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M] (resL : L → k_L) (resM : M_C → k_M)
    (hfinrank_res : Module.finrank k_L k_M =
      Module.finrank L (IntermediateField.extendScalars hLM_C))
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (hresM_0 : resM 0 = 0) (hresM_1 : resM 1 = 1)
    (hresM_ring : ∀ z₁ z₂ : M_C, (z₁ = 0 ∨ 0 ≤ valL F M_C z₁) → (z₂ = 0 ∨ 0 ≤ valL F M_C z₂) →
      resM (z₁ + z₂) = resM z₁ + resM z₂ ∧
      resM (z₁ * z₂) = resM z₁ * resM z₂ ∧
      resM (-z₁) = -resM z₁)
    (hresM_ker : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) → (resM z = 0 ↔ (z = 0 ∨ 1 ≤ valL F M_C z)))
    (hres_alg : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      resM (IntermediateField.inclusion hLM_C x) = algebraMap k_L k_M (resL x))
    (π_res : G →* (k_M ≃ₐ[k_L] k_M))
    (hπ_inj : Function.Injective π_res)
    (hπ_res : ∀ (σ : G) (z : M_C), (z = 0 ∨ 0 ≤ valL F M_C z) →
      π_res σ (resM z) = resM (act σ z)) :
    (∀ d : ℕ, 1 ≤ d → d < Module.finrank L (IntermediateField.extendScalars hLM_C) →
      ¬ (ℓ ∣ ((Fintype.card k_L) ^ d - 1))) ∧
    (∀ (i : Fin r) (x : Lˣ),
      (ν_orb i) (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom x) = 1) ∧
    (∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      resL (traceLM F hLM_C z) = Algebra.trace k_L k_M (resM z) ∧
      resL (normLM F hLM_C z) = Algebra.norm k_L (resM z)) ∧
    (∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      let F_z : Polynomial k_L :=
        (minpoly k_L (resM z)) ^
          (Module.finrank k_L k_M / (minpoly k_L (resM z)).natDegree)
      resL (traceLM F hLM_C z) = -F_z.nextCoeff ∧
      resL (normLM F hLM_C z) = (-1 : k_L) ^ (Module.finrank k_L k_M) * F_z.coeff 0 ∧
      ∀ (ϖ : Lˣ) (d : ℕ), valL F L (ϖ : L) = 1 → 1 ≤ d →
        ∃ s₂ : L, (s₂ = 0 ∨ 0 ≤ valL F L s₂) ∧
          resL s₂ = F_z.coeff (Module.finrank k_L k_M - 2) ∧
          (normLM F hLM_C (1 + IntermediateField.inclusion hLM_C (((ϖ ^ d : Lˣ) : L)) * z) -
            (1 + (((ϖ ^ d : Lˣ) : L)) * traceLM F hLM_C z +
              (((ϖ ^ (2 * d) : Lˣ) : L)) * s₂) = 0 ∨
            (2 * d + 1 : ℤ) ≤ valL F L
              (normLM F hLM_C (1 + IntermediateField.inclusion hLM_C (((ϖ ^ d : Lˣ) : L)) * z) -
                (1 + (((ϖ ^ d : Lˣ) : L)) * traceLM F hLM_C z +
                  (((ϖ ^ (2 * d) : Lˣ) : L)) * s₂)))) :=
by
  rcases hvalL_props with ⟨hvalL0, hvalL1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_add, hunitL⟩
  rcases hvalMC_props with ⟨hvalM0, hvalM1, hvalM_neg1, hvalM_neg, hvalM_mul, hvalM_inv, hvalM_add, hunitM⟩
  haveI : FiniteDimensional k_L k_M := Module.Finite.of_finite
  set f_H := Module.finrank k_L k_M
  have hcard_G_res : Fintype.card G = f_H := hcard_G.trans hfinrank_res.symm
  have hf_H_gt1_res : 1 < f_H := hfinrank_res.symm ▸ hf_H_gt1
  
  have hNotDvd : ∀ d : ℕ, 1 ≤ d → d < Module.finrank L (IntermediateField.extendScalars hLM_C) →
      ¬ (ℓ ∣ ((Fintype.card k_L) ^ d - 1)) := by
    set ζ₀ : k_M := resM (z₀ : M_C)
    have hz₀_pow_val : ∀ m : ℕ,
        valL F M_C (((z₀ ^ m : M_Cˣ) : M_C)) = 0 ∧
        resM (((z₀ ^ m : M_Cˣ) : M_C)) = ζ₀ ^ m := by
      intro m
      induction' m with m ih
      · simp [hvalM1, hresM_1]
      · have hm_int : ((z₀ ^ m : M_Cˣ) : M_C) = 0 ∨ 0 ≤ valL F M_C (((z₀ ^ m : M_Cˣ) : M_C)) :=
          Or.inr (by rw [ih.1])
        have hz₀_int : (z₀ : M_C) = 0 ∨ 0 ≤ valL F M_C (z₀ : M_C) :=
          Or.inr (by rw [hz₀_val])
        rw [pow_succ, Units.val_mul]
        refine ⟨?_, ?_⟩
        · rw [hvalM_mul _ _ (Units.ne_zero (z₀ ^ m)) (Units.ne_zero z₀), ih.1, hz₀_val, add_zero]
        · rw [(hresM_ring _ _ hm_int hz₀_int).2.1, ih.2, pow_succ]
    have hmem1 := (hunitM 1 le_rfl (z₀ ^ ℓ)).mp hz₀_pow
    have hdiff_z₀ℓ_int : (((z₀ ^ ℓ : M_Cˣ) : M_C) - 1) = 0 ∨
        0 ≤ valL F M_C (((z₀ ^ ℓ : M_Cˣ) : M_C) - 1) := by
      rw [sub_eq_add_neg]
      exact hvalM_add 0 _ _ (Or.inr (by rw [(hz₀_pow_val ℓ).1])) (Or.inr (by rw [hvalM_neg1]))
    have hres_diff0 : resM (((z₀ ^ ℓ : M_Cˣ) : M_C) - 1) = 0 := by
      rw [hresM_ker _ hdiff_z₀ℓ_int]
      rcases hmem1 with h1 | hge1
      · left; exact sub_eq_zero.mpr h1
      · right; exact hge1
    have hζ₀_pow : ζ₀ ^ ℓ = 1 := by
      rw [sub_eq_add_neg,
        (hresM_ring _ _ (Or.inr (by rw [(hz₀_pow_val ℓ).1])) (Or.inr (by rw [hvalM_neg1]))).1,
        (hresM_ring 1 0 (Or.inr (by rw [hvalM1])) (Or.inl rfl)).2.2,
        hresM_1, (hz₀_pow_val ℓ).2, ← sub_eq_add_neg] at hres_diff0
      exact sub_eq_zero.mp hres_diff0
    let φ₀ : G → k_M := fun σ => π_res σ ζ₀
    have hφ₀_inj : Function.Injective φ₀ := by
      intro σ₁ σ₂ h12
      change π_res σ₁ ζ₀ = π_res σ₂ ζ₀ at h12
      let τ : G := σ₁⁻¹ * σ₂
      have hτ_ζ₀ : π_res τ ζ₀ = ζ₀ := by
        change (π_res (σ₁⁻¹ * σ₂)) ζ₀ = ζ₀
        rw [map_mul, map_inv, AlgEquiv.mul_apply, ← h12]
        exact (π_res σ₁).symm_apply_apply ζ₀
      have hτ_eq_1 : τ = 1 := by
        by_contra hτ_ne
        obtain ⟨hδ_ne, hδ_val⟩ := hz₀_move τ hτ_ne
        set δ := act τ (z₀ : M_C) - (z₀ : M_C)
        have hz₀_int : (z₀ : M_C) = 0 ∨ 0 ≤ valL F M_C (z₀ : M_C) := Or.inr (by rw [hz₀_val])
        have hact_z₀_int : act τ (z₀ : M_C) = 0 ∨ 0 ≤ valL F M_C (act τ (z₀ : M_C)) :=
          Or.inr (by rw [hact_val, hz₀_val])
        have hneg_z₀_int : -(z₀ : M_C) = 0 ∨ 0 ≤ valL F M_C (-(z₀ : M_C)) :=
          Or.inr (by rw [hvalM_neg, hz₀_val])
        have hδ_int : δ = 0 ∨ 0 ≤ valL F M_C δ := Or.inr (by rw [hδ_val])
        have hres_δ : resM δ = 0 := by
          change resM (act τ (z₀ : M_C) - (z₀ : M_C)) = 0
          rw [sub_eq_add_neg, (hresM_ring _ _ hact_z₀_int hneg_z₀_int).1,
            (hresM_ring (z₀ : M_C) 0 hz₀_int (Or.inl rfl)).2.2,
            ← hπ_res τ (z₀ : M_C) hz₀_int, hτ_ζ₀, add_neg_cancel]
        rcases (hresM_ker δ hδ_int).mp hres_δ with h0 | hge1
        · exact hδ_ne h0
        · omega
      exact inv_mul_eq_one.mp hτ_eq_1
    set P₀ := minpoly k_L ζ₀
    have hζ₀_int : IsIntegral k_L ζ₀ := Algebra.IsIntegral.isIntegral ζ₀
    have hP₀_monic : P₀.Monic := minpoly.monic hζ₀_int
    have hP₀_aeval : Polynomial.aeval ζ₀ P₀ = 0 := minpoly.aeval k_L ζ₀
    let P₀_M : Polynomial k_M := Polynomial.map (algebraMap k_L k_M) P₀
    have hP₀M_monic : P₀_M.Monic := hP₀_monic.map (algebraMap k_L k_M)
    have hP₀M_deg : P₀_M.natDegree = P₀.natDegree :=
      Polynomial.natDegree_map_eq_of_injective (algebraMap k_L k_M).injective P₀
    let S₀ : Finset k_M := Finset.univ.image φ₀
    have hS₀_card : S₀.card = f_H := by
      rw [Finset.card_image_of_injective _ hφ₀_inj, Finset.card_univ, hcard_G_res]
    have hS₀_eval : ∀ r₀ ∈ S₀, Polynomial.eval r₀ P₀_M = 0 := by
      intro r₀ hr₀
      rcases Finset.mem_image.mp hr₀ with ⟨σ, _, rfl⟩
      change Polynomial.eval (π_res σ ζ₀) (Polynomial.map (algebraMap k_L k_M) P₀) = 0
      rw [Polynomial.eval_map, ← Polynomial.aeval_def]
      change Polynomial.aeval ((π_res σ).toAlgHom ζ₀) P₀ = 0
      rw [Polynomial.aeval_algHom_apply (π_res σ).toAlgHom ζ₀ P₀, hP₀_aeval, map_zero]
    have hS₀_sub_roots : S₀.val ≤ P₀_M.roots := by
      rw [Multiset.le_iff_subset S₀.nodup]
      intro r₀ hr₀
      rw [Polynomial.mem_roots hP₀M_monic.ne_zero]
      exact hS₀_eval r₀ hr₀
    have hfH_le_deg : f_H ≤ P₀.natDegree := by
      calc f_H = S₀.card := hS₀_card.symm
        _ = S₀.val.card := rfl
        _ ≤ P₀_M.roots.card := Multiset.card_le_card hS₀_sub_roots
        _ ≤ P₀_M.natDegree := Polynomial.card_roots' P₀_M
        _ = P₀.natDegree := hP₀M_deg
    have hfin_adj₀ : Module.finrank k_L ↥(IntermediateField.adjoin k_L ({ζ₀} : Set k_M)) = P₀.natDegree :=
      IntermediateField.adjoin.finrank hζ₀_int
    have hfin_top₀ : Module.finrank k_L ↥(⊤ : IntermediateField k_L k_M) = f_H :=
      IntermediateField.topEquiv.toLinearEquiv.finrank_eq
    have hadj_top₀ : IntermediateField.adjoin k_L ({ζ₀} : Set k_M) = ⊤ := by
      apply IntermediateField.eq_of_le_of_finrank_le le_top
      rw [hfin_top₀, hfin_adj₀]
      exact hfH_le_deg
    intro d hd1 hd_lt_MC hdvd
    have hd_lt : d < f_H := hfinrank_res.symm ▸ hd_lt_MC
    set q_L := Fintype.card k_L
    have hqL_gt1 : 1 < q_L := Fintype.one_lt_card
    have hqLd_gt1 : 1 < q_L ^ d := by
      calc 1 = q_L ^ 0 := (pow_zero q_L).symm
