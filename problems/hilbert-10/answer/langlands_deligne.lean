theorem ld_ch12_sml_wild_dyadic_case (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E M₁ K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E]
    [FiniteDimensional F M₁] [FiniteDimensional F K₁]
    (hLE : L ≤ E) (hLM₁ : L ≤ M₁) (hEK₁ : E ≤ K₁) (hM₁K₁ : M₁ ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE : IsGaloisExt F L E) (hGalLM₁ : IsGaloisExt F L M₁)
    (hGalEK₁ : IsGaloisExt F E K₁) (hGalM₁K₁ : IsGaloisExt F M₁ K₁)
    (hAbLE : IsAbelianExt F hLE) (hAbLM₁ : IsAbelianExt F hLM₁)
    (hAbEK₁ : IsAbelianExt F hEK₁) (hAbM₁K₁ : IsAbelianExt F hM₁K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE)))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE) = p F)
    (hp2 : p F = 2)
    (hdegM₁ : Module.finrank L (IntermediateField.extendScalars hLM₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (hdegEK₁ : Module.finrank E (IntermediateField.extendScalars hEK₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (hdegM₁K₁ : Module.finrank M₁ (IntermediateField.extendScalars hM₁K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (h_inf : E ⊓ M₁ = L) (h_sup : E ⊔ M₁ = K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁)
    (hneK₁ : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE.trans hEK₁) χL = χK₁)
    (χE : relWeil F E →* (Ω F)ˣ) (hχE_weil : IsWeilRep F E (charRep F E χE))
    (hχE_rest : restrictWeilChar F hEK₁ χE = χK₁)
    (χM₁ : relWeil F M₁ →* (Ω F)ˣ) (hχM₁_weil : IsWeilRep F M₁ (charRep F M₁ χM₁))
    (hχM₁_rest : restrictWeilChar F hM₁K₁ χM₁ = χK₁)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (hψM₁ : IsAdmissibleChar F M₁ (traceChar F hLM₁ ψ))
    (hψK₁ : IsAdmissibleChar F K₁ (traceChar F (hLE.trans hEK₁) ψ))
    (νE νM₁ : Lˣ →* (Ω F)ˣ)
    (hνE_pow : νE ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1)
    (hνE_ne : νE ≠ 1)
    (hνE_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE)) ↔ νE x = 1)
    (hνE_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
      ∀ u ∈ unitGroup F L (condExp F L (νE ^ j)), (νE ^ j) u = 1)
    (hνM₁_pow : νM₁ ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1)
    (hνM₁_ne : νM₁ ≠ 1)
    (hνM₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁)) ↔ νM₁ x = 1)
    (hνM₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁ ^ j)), (νM₁ ^ j) u = 1)
    (hPow :
      let ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
      let ψE := traceChar F hLE ψ
      let ψM₁ := traceChar F hLM₁ ψ
      let χE' := recChar F rec E χE
      let χM₁' := recChar F rec M₁ χM₁
      (tateEps F E χE' ψE * tateEps F M₁ 1 ψM₁ *
          (∏ j ∈ Finset.range ℓ, tateEps F L (νE ^ j) ψ)) ^ ℓ =
        (tateEps F M₁ χM₁' ψM₁ * tateEps F E 1 ψE *
          (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ)) ^ ℓ) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
    let ψE := traceChar F hLE ψ
    let ψM₁ := traceChar F hLM₁ ψ
    let χE' := recChar F rec E χE
    let χM₁' := recChar F rec M₁ χM₁
    tateEps F E χE' ψE * tateEps F M₁ 1 ψM₁ *
      (∏ j ∈ Finset.range ℓ, tateEps F L (νE ^ j) ψ) =
    tateEps F M₁ χM₁' ψM₁ * tateEps F E 1 ψE *
      (∏ j ∈ Finset.range ℓ, tateEps F L (νM₁ ^ j) ψ) :=
by
  obtain ⟨hQuadNorm, hBiquadPkg, hMissingCoset⟩ :=
    ld_ch12_wild_dyadic_biquadratic_trace_norm_and_missing_coset F
  apply ld_ch12_wild_dyadic_min_cond_subfield_and_bicyclic_reduction F rec L E M₁ K₁
    hLE hLM₁ hEK₁ hM₁K₁ hGalLK₁ hGalLE hGalLM₁ hGalEK₁ hGalM₁K₁
    hAbLE hAbLM₁ hAbEK₁ hAbM₁K₁ hPrime hWild hp2
    hdegM₁ hdegEK₁ hdegM₁K₁ h_inf h_sup
    χK₁ hInvK₁ hneK₁ χE hχE_weil hχE_rest χM₁ hχM₁_weil hχM₁_rest
    ψ hψ hψE hψM₁ hψK₁ νE νM₁
    hνE_pow hνE_ne hνE_ker hνE_cond hνM₁_pow hνM₁_ne hνM₁_ker hνM₁_cond hPow
  intro E' M₁' _ _ hLE' hLM₁' hE'K₁ hM₁'K₁
    hGalLE' hGalLM₁' hGalE'K₁ hGalM₁'K₁
    hAbLE' hAbLM₁' hAbE'K₁ hAbM₁'K₁
    hdegE' hdegM₁' hdegE'K₁ hdegM₁'K₁ h_inf' h_sup'
    χE' hχE'_weil hχE'_rest χM₁' hχM₁'_weil hχM₁'_rest
    hψE' hψM₁' νE' νM₁'
    hνE'_pow hνE'_ne hνE'_ker hνE'_cond
    hνM₁'_pow hνM₁'_ne hνM₁'_ker hνM₁'_cond
    hνM₁'E'_cond hνE'M₁'_cond
    hbE'_ge2 hCondM₁' hMinM₁' hMinE'
    hNormFactor hχE'_comp hχM₁'_comp hχK₁_cond
    hmE'_ge2 hξE'_props hmM₁'_ge2 hξM₁'_props
    hCommonRest hFML_E' hFML_M₁' hPow'
  have hPrime' : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')) :=
    hdegE'.symm ▸ hPrime
  have hWild' : Module.finrank L (IntermediateField.extendScalars hLE') = p F :=
    hdegE'.trans hWild
  have hdeg2_E' : Module.finrank L (IntermediateField.extendScalars hLE') = 2 :=
    hWild'.trans hp2
  have hdeg2_M₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') = 2 :=
    (hdegM₁'.trans hdegE'.symm).trans hdeg2_E'
  have hdeg2_E'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) = 2 :=
    (hdegE'K₁.trans hdegE'.symm).trans hdeg2_E'
  have hdeg2_M₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) = 2 :=
    (hdegM₁'K₁.trans hdegE'.symm).trans hdeg2_E'
  have hdegM₁'' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE') :=
    hdegM₁'.trans hdegE'.symm
  have hdegE'K₁' : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE') :=
    hdegE'K₁.trans hdegE'.symm
  have hdegM₁'K₁' : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE') :=
    hdegM₁'K₁.trans hdegE'.symm
  have hneK₁' : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE'.trans hE'K₁) χL = χK₁ :=
    hneK₁
  have hψK₁' : IsAdmissibleChar F K₁ (traceChar F (hLE'.trans hE'K₁) ψ) := hψK₁
  obtain ⟨hBiquadE2, hCommonOrigin_gen⟩ :=
    hBiquadPkg L E' M₁' K₁ hLE' hLM₁' hE'K₁ hM₁'K₁
      hGalLK₁ hGalLE' hGalLM₁' hGalE'K₁ hGalM₁'K₁
      hdeg2_E' hdeg2_M₁' hdeg2_E'K₁ hdeg2_M₁'K₁ h_inf' h_sup'
  have hCommonOrigin :=
    hCommonOrigin_gen ψ (recChar F rec E' χE') (recChar F rec M₁' χM₁') νE' νM₁'
      (fun y hy => (hνE'_ker y).mp hy)
      (fun z hz => (hνM₁'_ker z).mp hz)
      (hχE'_comp.trans hχM₁'_comp.symm)
      hCommonRest
  rw [← hdegE'] at hνE'_pow hνE'_cond hνM₁'_pow hνM₁'_cond hνM₁'E'_cond hνE'M₁'_cond
  rw [← hdegE'] at hMinM₁' hMinE' hξE'_props hξM₁'_props hFML_E' hFML_M₁'
  rcases hCondM₁' with hUnramM₁' | hbM₁'_ge2
  · exact ld_ch12_wild_dyadic_unramified_subfield_branch F rec L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLK₁ hGalLE' hGalLM₁' hGalE'K₁ hGalM₁'K₁
      hAbLE' hAbLM₁' hAbE'K₁ hAbM₁'K₁ hPrime' hWild' hp2
      hdegM₁'' hdegE'K₁' hdegM₁'K₁' h_inf' h_sup'
      χK₁ hInvK₁ hneK₁' χE' hχE'_weil hχE'_rest χM₁' hχM₁'_weil hχM₁'_rest
      ψ hψ hψE' hψM₁' hψK₁' νE' νM₁'
      hνE'_pow hνE'_ne hνE'_ker hνE'_cond hνM₁'_pow hνM₁'_ne hνM₁'_ker hνM₁'_cond
      hνM₁'E'_cond hνE'M₁'_cond hbE'_ge2 hUnramM₁' hMinM₁' hMinE'
      hNormFactor hχE'_comp hχM₁'_comp hχK₁_cond
      hmE'_ge2 hξE'_props hmM₁'_ge2 hξM₁'_props
      hCommonRest hFML_E' hFML_M₁' hPow' hQuadNorm hBiquadE2
  · exact ld_ch12_wild_dyadic_totally_ramified_subfields_branch F rec L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLK₁ hGalLE' hGalLM₁' hGalE'K₁ hGalM₁'K₁
      hAbLE' hAbLM₁' hAbE'K₁ hAbM₁'K₁ hPrime' hWild' hp2
      hdegM₁'' hdegE'K₁' hdegM₁'K₁' h_inf' h_sup'
      χK₁ hInvK₁ hneK₁' χE' hχE'_weil hχE'_rest χM₁' hχM₁'_weil hχM₁'_rest
      ψ hψ hψE' hψM₁' hψK₁' νE' νM₁'
      hνE'_pow hνE'_ne hνE'_ker hνE'_cond hνM₁'_pow hνM₁'_ne hνM₁'_ker hνM₁'_cond
      hνM₁'E'_cond hνE'M₁'_cond hbE'_ge2 hbM₁'_ge2 hMinM₁' hMinE'
      hNormFactor hχE'_comp hχM₁'_comp hχK₁_cond
      hmE'_ge2 hξE'_props hmM₁'_ge2 hξM₁'_props
      hCommonRest hFML_E' hFML_M₁' hPow'
