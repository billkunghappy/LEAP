    ld_ch12_wild_dyadic_odd_max_break_min_cond_cE_stationarity F rec L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ χK₁ χE' χM₁' ψ νE' νM₁' hνE'_ker hνM₁'_ker
      hbE'_ge2 hbM₁'_ge2 hMinM₁' hT1_even hT2_odd hm1_min hm2_min hθE'_triv
      hCommonOrigin hSpecE' hvalE'_props hvalM₁'_props hvalK₁_props htr_E'K₁
      htr_M₁'K₁ hnorm_surj_gt_E'K₁ hnorm_le_M₁'K₁ hNormLE' hNormLM₁' α C htE'
      htM₁' hC_val htE'_val htM₁'_val hcE'_val hcM₁'_stat hcνE'_stat hcνM₁'_stat
