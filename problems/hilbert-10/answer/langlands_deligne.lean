          (P_out * G₁ * (F₂ - G₂) * F₃) +
          (P_out * G₁ * G₂ * (F₃ - G₃)) := by
    dsimp [Q_interp, P_out, F₁, F₂, F₃]
    ring

  set K_target : ℤ := ((1 + p * t₂ : ℕ) : ℤ) with hK_target_def
  have h_pm : 2 * ((p : ℤ) - 1) * ((t₁ : ℤ) + 1) ≤ 2 * ((p : ℤ) - 1) * ((p : ℤ) * (m : ℤ)) :=
    mul_le_mul_of_nonneg_left hpm_z (by omega)
  have h_pm2 : (3 * (p : ℤ) - 2) * ((t₁ : ℤ) + 1) ≤ (3 * (p : ℤ) - 2) * ((p : ℤ) * (m : ℤ)) :=
    mul_le_mul_of_nonneg_left hpm_z (by omega)
  have h_t₁ : (0 : ℤ) ≤ ((p : ℤ) - 3) * (t₁ : ℤ) := mul_nonneg (by omega) (by omega)
  have h_δ : (0 : ℤ) ≤ (p : ℤ) * ((p : ℤ) - 2) * (δ : ℤ) :=
