    rw [hval_norm_E'K₁, hΔ_val]
  have hb_val : valL F M₁' (b : M₁') = -(t₁ : ℤ) := by
    change valL F M₁' (normLM F hM₁'K₁ (Δ : K₁)) = -(t₁ : ℤ)
    rw [hval_norm_M₁'K₁, hΔ_val]
  have hΔ_basis := hΔ_basis_all Δ hΔ_val
  have hΔ_as' :
      (Δ : K₁) ^ p - (Δ : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)) = 0 ∨
        ((4 * p * (p * p * m₁) : ℕ) : ℤ) ≤
          valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) -
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁))) := by
    rw [h4p3]; exact hΔ_as
  obtain ⟨hΔ_tr_low', hΔ_tr_top', hΔ_tr_pow'⟩ :=
    (ld_wild_odd_tot_ram_as_charpoly_and_power_traces F E' K₁
      hE'K₁ p hPrime hp_odd' t₁ (p * p * m₁) ht₁_ge1 hm₁_p2_gt
      hval_E'K₁ htr_E'K₁_cast G_K₁ act_K₁ y₁_K₁
      hcard_GK₁ hactK₁_one hactK₁_mul hactK₁_ring
      hactK₁_incl hactK₁_val hactK₁_trace hactK₁_norm hy₁K₁_tr
      Δ hΔ_val hΔ_basis).2 hΔ_as'
  have hΔ_tr_low : ∀ j ∈ Finset.Icc 1 (p - 2),
      traceLM F hE'K₁ ((Δ : K₁) ^ j) = 0 ∨
        ((3 * p * p * m₁ : ℕ) : ℤ) ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ j)) := by
    intro j hj; rw [← h3p2]; exact hΔ_tr_low' j hj
  have hΔ_tr_top :
      traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E') = 0 ∨
        ((3 * p * p * m₁ : ℕ) : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E')) := by
    rw [← h3p2]; exact hΔ_tr_top'
  have hΔ_tr_pow :
      traceLM F hE'K₁ ((Δ : K₁) ^ p) - ((p : ℕ) : E') * (a : E') = 0 ∨
        ((3 * p * p * m₁ : ℕ) : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ p) - ((p : ℕ) : E') * (a : E')) := by
    rw [← h3p2]; exact hΔ_tr_pow'
  refine ⟨ha_val, hb_val, hΔ_tr_low, hΔ_tr_top, hΔ_tr_pow, hΔ_basis, ?_⟩
  intro w₀ hw₀_val
  have hΔ_as_1 :
      (Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ (a : E') = 0 ∨
        (1 : ℤ) ≤ valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) - IntermediateField.inclusion hE'K₁ (a : E')) := by
    rcases hΔ_as with h0 | hge
    · exact Or.inl h0
    · right
      have h4p_pos : 0 < 4 * p := by omega
      have hpos : 1 ≤ 4 * p * p * p * m₁ := by
        rw [← h4p3]
        exact le_trans ht₁_ge1 (le_of_lt (lt_of_lt_of_le hm₁_p2_gt
          (Nat.le_mul_of_pos_left (p * p * m₁) h4p_pos)))
      exact le_trans (by exact_mod_cast hpos) hge
  obtain ⟨Δ', hΔ'_val, hΔ'_as_shift⟩ :=
    hAS_shift_raw (4 * p * p * p * m₁) Δ (a : E') hΔ_val ha_val hΔ_as_1 w₀ hw₀_val
  have hΔ'_as_shift' :
      (Δ' : K₁) ^ p - (Δ' : K₁) -
        IntermediateField.inclusion hE'K₁ ((a : E') + w₀ ^ p - w₀) = 0 ∨
        ((4 * p * (p * p * m₁) : ℕ) : ℤ) ≤
          valL F K₁ ((Δ' : K₁) ^ p - (Δ' : K₁) -
            IntermediateField.inclusion hE'K₁ ((a : E') + w₀ ^ p - w₀)) := by
    rw [h4p3]; exact hΔ'_as_shift
  obtain ⟨hΔ'_norm_congr, hΔ'_as⟩ :=
    (ld_wild_odd_tot_ram_as_charpoly_and_power_traces F E' K₁
      hE'K₁ p hPrime hp_odd' t₁ (p * p * m₁) ht₁_ge1 hm₁_p2_gt
      hval_E'K₁ htr_E'K₁_cast G_K₁ act_K₁ y₁_K₁
      hcard_GK₁ hactK₁_one hactK₁_mul hactK₁_ring
      hactK₁_incl hactK₁_val hactK₁_trace hactK₁_norm hy₁K₁_tr
      Δ' hΔ'_val (hΔ_basis_all Δ' hΔ'_val)).1 ((a : E') + w₀ ^ p - w₀) hΔ'_as_shift'
  rw [h3p2] at hΔ'_norm_congr
  rw [h4p3] at hΔ'_as
  exact ⟨Δ', hΔ'_val, hΔ'_as, hΔ'_norm_congr⟩

theorem ld_ch12_wild_odd_tot_ram_galois_lift_and_m1_shift (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁')
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣ (bM₁' - 1)))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hGalLift : ∀ τ : M₁' ≃ₐ[F] M₁',
      (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) →
      ∃ τ_lift : K₁ ≃ₐ[F] K₁,
        (∀ y : E', τ_lift (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hE'K₁ y) ∧
        (∀ z : M₁', τ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ (τ z)) ∧
        (∀ w : K₁, valL F K₁ (τ_lift w) = valL F K₁ w) ∧
        (∀ w : K₁,
          normLM F hE'K₁ (τ_lift w) = normLM F hE'K₁ w ∧
          normLM F hM₁'K₁ (τ_lift w) = τ (normLM F hM₁'K₁ w)))
    (ϖ_M₁' : M₁'ˣ) (hϖ_M₁' : valL F M₁' (ϖ_M₁' : M₁') = 1)
    (hBasis_M₁' : ∀ z : M₁',
      ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → L,
        z = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
          IntermediateField.inclusion hLM₁' (c i) * ((ϖ_M₁' : M₁') ^ (i : ℕ)) ∧
        ∀ m : ℤ,
          (z = 0 ∨ m ≤ valL F M₁' z) ↔
            ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
              c i = 0 ∨
                m ≤ (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) *
                  valL F L (c i) + (i : ℤ))
    (G_M₁' : Type u) [Group G_M₁'] [Fintype G_M₁'] (act_M₁' : G_M₁' → M₁' → M₁')
    (hcard_GM₁' : Fintype.card G_M₁' = Module.finrank L (IntermediateField.extendScalars hLE'))
    (hactM₁'_one : ∀ z : M₁', act_M₁' 1 z = z)
    (hactM₁'_mul : ∀ (σ τ : G_M₁') (z : M₁'), act_M₁' (σ * τ) z = act_M₁' σ (act_M₁' τ z))
    (hactM₁'_ring : ∀ σ : G_M₁',
      act_M₁' σ 0 = 0 ∧ act_M₁' σ 1 = 1 ∧
      (∀ z₁ z₂ : M₁',
        act_M₁' σ (z₁ + z₂) = act_M₁' σ z₁ + act_M₁' σ z₂ ∧
        act_M₁' σ (z₁ * z₂) = act_M₁' σ z₁ * act_M₁' σ z₂ ∧
        act_M₁' σ (-z₁) = -act_M₁' σ z₁))
    (hactM₁'_incl : ∀ (σ : G_M₁') (x : L),
      act_M₁' σ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hactM₁'_val : ∀ (σ : G_M₁') (z : M₁'), valL F M₁' (act_M₁' σ z) = valL F M₁' z)
    (hjump_M₁' : ∀ τ : G_M₁', τ ≠ 1 →
      (ϖ_M₁' : M₁') - act_M₁' τ (ϖ_M₁' : M₁') ≠ 0 ∧
      valL F M₁' ((ϖ_M₁' : M₁') - act_M₁' τ (ϖ_M₁' : M₁')) = (bM₁' : ℤ))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    (∀ (Y : Fin p → E') (m : ℤ),
      ((∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ))) = 0 ∨
        m ≤ valL F K₁ (∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)))) ↔
      ∀ i : Fin p, Y i = 0 ∨ m ≤ (p : ℤ) * valL F E' (Y i) - (i : ℤ) * (t₁ : ℤ)) ∧
    (∀ k : ℕ, 1 ≤ k → k < p →
      ((k : ℕ) : E') ≠ 0 ∧ valL F E' ((k : ℕ) : E') = 0) ∧
    ∃ (τ : M₁' ≃ₐ[F] M₁') (τ_lift : K₁ ≃ₐ[F] K₁) (w₀ : K₁),
      (∀ y : E', τ_lift (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hE'K₁ y) ∧
      (∀ z : M₁', τ_lift (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hM₁'K₁ (τ z)) ∧
      (∀ w : K₁, valL F K₁ (τ_lift w) = valL F K₁ w) ∧
      (∀ (θ : M₁') (m : ℤ),
        (θ = 0 ∨ m ≤ valL F M₁' θ) →
        (τ θ - θ = 0 ∨ m + (t₁ : ℤ) ≤ valL F M₁' (τ θ - θ))) ∧
      w₀ ≠ 0 ∧
      valL F K₁ w₀ = (p : ℤ) ∧
      τ_lift w₀ - w₀ ≠ 0 ∧
      valL F K₁ (τ_lift w₀ - w₀) = (p : ℤ) * (bM₁' : ℤ) :=
by
  intro p t₁
  have hPrime_p : Nat.Prime p := hPrime
  have ht₁_ndvd_p : ¬ (p ∣ t₁) := ht₁_ndvd
  have hΔ_val_t₁ : valL F K₁ (Δ : K₁) = -(t₁ : ℤ) := hΔ_val
  rcases hvalE'_props with ⟨hval0_E', hval1_E', hval_neg1_E', hval_neg_E', hval_mul_E',
    hval_inv_E', hval_surj_E', hval_add_E', hunit0_E', hunit_a_E', hunit_val0_E'⟩
  rcases hvalM₁'_props with ⟨hval0_M₁', hval1_M₁', hval_neg1_M₁', hval_neg_M₁', hval_mul_M₁',
    hval_inv_M₁', hval_surj_M₁', hval_add_M₁', hunit0_M₁', hunit_a_M₁', hunit_val0_M₁'⟩
  rcases hvalK₁_props with ⟨hval0_K₁, hval1_K₁, hval_neg1_K₁, hval_neg_K₁, hval_mul_K₁,
    hval_inv_K₁, hval_surj_K₁, hval_add_K₁, hunit0_K₁, hunit_a_K₁, hunit_val0_K₁⟩

  have hval_pow_K₁ : ∀ (x : K₁) (n : ℕ), x ≠ 0 → valL F K₁ (x ^ n) = (n : ℤ) * valL F K₁ x := by
    intro x n hx
    induction n with
    | zero =>
      rw [pow_zero, hval1_K₁]
      ring
    | succ n ih =>
      have hxn : x ^ n ≠ 0 := pow_ne_zero n hx
      rw [pow_succ, hval_mul_K₁ (x ^ n) x hxn hx, ih]
      push_cast
      ring

  have hval_strict_K₁ : ∀ (w₁ w₂ : K₁), w₁ ≠ 0 →
      (w₂ = 0 ∨ valL F K₁ w₁ + 1 ≤ valL F K₁ w₂) →
      w₁ + w₂ ≠ 0 ∧ valL F K₁ (w₁ + w₂) = valL F K₁ w₁ := by
    intro w₁ w₂ hw₁ hw₂
    have hw₂_ge : w₂ = 0 ∨ valL F K₁ w₁ ≤ valL F K₁ w₂ := by
      rcases hw₂ with rfl | hge
      · exact Or.inl rfl
      · exact Or.inr (by omega)
    have hsum_ge : w₁ + w₂ = 0 ∨ valL F K₁ w₁ ≤ valL F K₁ (w₁ + w₂) :=
      hval_add_K₁ (valL F K₁ w₁) w₁ w₂ (Or.inr le_rfl) hw₂_ge
    have hnot_gt : ¬ (w₁ + w₂ = 0 ∨ valL F K₁ w₁ + 1 ≤ valL F K₁ (w₁ + w₂)) := by
      intro hgt
      have hneg_w₂ : -w₂ = 0 ∨ valL F K₁ w₁ + 1 ≤ valL F K₁ (-w₂) := by
        rcases hw₂ with rfl | hge
        · simp
        · right
          rw [hval_neg_K₁]
          exact hge
      have hw₁_gt := hval_add_K₁ (valL F K₁ w₁ + 1) (w₁ + w₂) (-w₂) hgt hneg_w₂
      have heq : (w₁ + w₂) + (-w₂) = w₁ := by ring
      rw [heq] at hw₁_gt
      rcases hw₁_gt with hw₁0 | hle
      · exact hw₁ hw₁0
      · omega
    rcases hsum_ge with hsum0 | hle
    · exfalso
      exact hnot_gt (Or.inl hsum0)
    · refine ⟨fun hsum0 => hnot_gt (Or.inl hsum0), ?_⟩
      have hlt : ¬ (valL F K₁ w₁ + 1 ≤ valL F K₁ (w₁ + w₂)) :=
        fun h => hnot_gt (Or.inr h)
      omega

  let t_term : (Fin p → E') → Fin p → K₁ :=
    fun Y i => IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ))
  let v_term : (Fin p → E') → Fin p → ℤ :=
    fun Y i => (p : ℤ) * valL F E' (Y i) - (i : ℤ) * (t₁ : ℤ)
  have ht_term_zero : ∀ (Y : Fin p → E') (i : Fin p), Y i = 0 → t_term Y i = 0 := by
    intro Y i hYi
    dsimp [t_term]
    rw [hYi, map_zero, zero_mul]
  have ht_term_nz : ∀ (Y : Fin p → E') (i : Fin p), Y i ≠ 0 →
      t_term Y i ≠ 0 ∧ valL F K₁ (t_term Y i) = v_term Y i := by
    intro Y i hYi
    dsimp [t_term, v_term]
    have hincl_ne : IntermediateField.inclusion hE'K₁ (Y i) ≠ 0 := by
      intro h0
      exact hYi ((IntermediateField.inclusion hE'K₁).injective (h0.trans (map_zero _).symm))
    have hΔ_ne : (Δ : K₁) ≠ 0 := Units.ne_zero Δ
    have hpow_ne : (Δ : K₁) ^ (i : ℕ) ≠ 0 := pow_ne_zero (i : ℕ) hΔ_ne
    refine ⟨mul_ne_zero hincl_ne hpow_ne, ?_⟩
    rw [hval_mul_K₁ _ _ hincl_ne hpow_ne, hval_E'K₁ (Y i), hval_pow_K₁ (Δ : K₁) (i : ℕ) hΔ_ne,
      hΔ_val_t₁]
    change (p : ℤ) * valL F E' (Y i) + (i : ℤ) * -(t₁ : ℤ) =
      (p : ℤ) * valL F E' (Y i) - (i : ℤ) * (t₁ : ℤ)
    ring
  have hv_term_inj_le : ∀ (Y : Fin p → E') (i j : Fin p),
      (i : ℕ) ≤ (j : ℕ) → v_term Y i = v_term Y j → i = j := by
    intro Y i j hij_le hij
    dsimp [v_term] at hij
    set d : ℕ := (j : ℕ) - (i : ℕ)
    set v_diff : ℤ := valL F E' (Y j) - valL F E' (Y i)
    have hd_cast : (d : ℤ) = (j : ℤ) - (i : ℤ) := by
      dsimp [d]
      omega
    have hrel : (d : ℤ) * (t₁ : ℤ) = (p : ℤ) * v_diff := by
      dsimp [v_diff]
      rw [hd_cast]
      linarith
    have hp_pos : 0 < p := hPrime_p.pos
    have hv_diff_nonneg : 0 ≤ v_diff := by
      have hdt_nonneg : 0 ≤ (d : ℤ) * (t₁ : ℤ) :=
        mul_nonneg (Nat.cast_nonneg d) (Nat.cast_nonneg t₁)
      rw [hrel] at hdt_nonneg
      by_contra hlt
