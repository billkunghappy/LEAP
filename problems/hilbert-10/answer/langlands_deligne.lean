      have hS_mul_χ : (c'_χ'_Fi i : F_i) * S_i = 1 + (α_orb i : F_i) := by
        have h2 : (c'_χ'_Fi i : F_i) * (((c'_χ'_Fi i)⁻¹ : F_iˣ) : F_i) = 1 :=
          Units.mul_inv (c'_χ'_Fi i)
        change (c'_χ'_Fi i : F_i) * S_i = 1 + (c'_χ'_Fi i : F_i) * (((c'_μ i)⁻¹ : F_iˣ) : F_i)
        dsimp [S_i]
        linear_combination h2
      have hS_val : S_i ≠ 0 ∧ valL F F_i S_i = -(((m₀ + 1 : ℕ) : ℤ) + n_Fi) := by
        rcases lt_trichotomy (k * (a - 1)) t with hsub | hcrit | hsuper
        · have hm₀_eq : m₀ = t := max_eq_left (by omega)
          have hα_inv_ge1 : 1 ≤ valL F F_i (((α_orb i)⁻¹ : F_iˣ) : F_i) := by
            rw [hval_inv_Fi (α_orb i), hα_val i]
            have hlt_cast : (k : ℤ) * ((a - 1 : ℕ) : ℤ) < (t : ℤ) := by exact_mod_cast hsub
            omega
          obtain ⟨h1_ne0, h1_val0⟩ := hunit_1_plus (((α_orb i)⁻¹ : F_iˣ) : F_i) hα_inv_ge1
          have hS_ne0 : S_i ≠ 0 := by
            intro h0
            rw [h0, mul_zero] at hS_mul_μ
            exact h1_ne0 hS_mul_μ.symm
          have hmul_val := hval_mul_Fi (c'_μ i : F_i) S_i (Units.ne_zero (c'_μ i)) hS_ne0
          have hval_μ := (hc_orb i).2.2.1
          change valL F F_i (c'_μ i : F_i) = (condExp F F_i (μ'_orb i) : ℤ) + n_Fi at hval_μ
          rw [hS_mul_μ, h1_val0, hval_μ, (hFi_ram i).1] at hmul_val
          refine ⟨hS_ne0, ?_⟩
          rw [hm₀_eq]
          omega
        · have hm₀_eq : m₀ = t := max_eq_left (by omega)
          obtain ⟨h1_ne0, h1_val0⟩ := hcrit_unit hcrit i
          have hS_ne0 : S_i ≠ 0 := by
            intro h0
            rw [h0, mul_zero] at hS_mul_μ
            exact h1_ne0 hS_mul_μ.symm
          have hmul_val := hval_mul_Fi (c'_μ i : F_i) S_i (Units.ne_zero (c'_μ i)) hS_ne0
          have hval_μ := (hc_orb i).2.2.1
          change valL F F_i (c'_μ i : F_i) = (condExp F F_i (μ'_orb i) : ℤ) + n_Fi at hval_μ
          rw [hS_mul_μ, h1_val0, hval_μ, (hFi_ram i).1] at hmul_val
