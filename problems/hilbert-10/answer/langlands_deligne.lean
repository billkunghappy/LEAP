    have hnorm_qw_val :
        normLM F hM₁'K₁ q_w = 0 ∨ (d_E : ℤ) ≤ valL F M₁' (normLM F hM₁'K₁ q_w) := by
      rcases hqw_val with h0 | hge
      · left
        rw [h0]
        change Algebra.norm M₁' (toExtendScalars F hM₁'K₁ 0) = 0
        rw [map_zero, Algebra.norm_zero]
      · right; rw [hval_norm_M₁'K₁]; exact hge
    have h2norm_qw_mM₁' :
        2 * normLM F hM₁'K₁ q_w = 0 ∨ (mM₁' : ℤ) ≤ valL F M₁' (2 * normLM F hM₁'K₁ q_w) := by
      have h1 := hval_mul_bound_M₁' 0 (d_E : ℤ) 2 (normLM F hM₁'K₁ q_w)
