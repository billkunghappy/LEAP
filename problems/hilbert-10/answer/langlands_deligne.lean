    have hNB_lin : ∀ m < p, 0 < m →
        ((N_fn m - B_fn m) - b * T_lin * ξ_base m = 0 ∨
          V_lin ≤ vM₁' ((N_fn m - B_fn m) - b * T_lin * ξ_base m)) ∧
