            (pow_ne_zero (n + 1) hc_ne0) hne_top,
            (hpow_valL c hc_ne0 (n + 1)).2, hu_val]
          dsimp only [V_top]
          ring
        have hlow_term : ∀ r ∈ Finset.Icc 1 n,
            c ^ r * d r = 0 ∨ V_top + 1 ≤ valL F L (c ^ r * d r) := by
          intro r hr
          by_cases hdr : d r = 0
          · left; rw [hdr, mul_zero]
          · right
            have hr_le : r ≤ n := (Finset.mem_Icc.mp hr).2
