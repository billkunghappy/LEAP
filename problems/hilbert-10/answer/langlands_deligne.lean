    have hEdiff_2d : Enw - Ew = 0 ∨ (2 * d : ℤ) ≤ valL F L (Enw - Ew) :=
      hvalL_sub (2 * d : ℤ) Enw Ew hEnw hEw
    have hTN_Ediff : (T₁ + N₁) * (Enw - Ew) = 0 ∨
        (b : ℤ) ≤ valL F L ((T₁ + N₁) * (Enw - Ew)) := by
      rcases hvalL_mul_bound (d : ℤ) (2 * d : ℤ) (T₁ + N₁) (Enw - Ew) hTN_val hEdiff_2d with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hEwEnw : Ew * Enw = 0 ∨ (b : ℤ) ≤ valL F L (Ew * Enw) := by
      rcases hvalL_mul_bound (2 * d : ℤ) (2 * d : ℤ) Ew Enw hEw hEnw with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have heven_val : Ew + Enw + traceLM F hLK (w ^ 2) = 0 ∨
        (b : ℤ) ≤ valL F L (Ew + Enw + traceLM F hLK (w ^ 2)) := by
      rw [heven_id]
      have hs1 := hvalL_add (b : ℤ) (traceLM F hLK z₂) (T₁ * T₁) htr_z₂ hT₁_sq
      have hs2 := hvalL_add (b : ℤ) _ ((2 : L) * T₁ * N₁) hs1 h2T₁N₁
      have hs3 := hvalL_sub (b : ℤ) _ ((T₁ + N₁) * (Enw - Ew)) hs2 hTN_Ediff
      exact hvalL_sub (b : ℤ) _ (Ew * Enw) hs3 hEwEnw
    have hodd_val : Ew - Enw = 0 ∨ (b : ℤ) ≤ valL F L (Ew - Enw) :=
      ld_wild_odd_prime_norm_quad_error F L K hLK hPrime hp_ne2
        hvalL_props hvalK_props t b ht_ge1 hb_eq hb_odd htr_bound
        G act hcard_G hact_one hact_mul hact_ring hact_val hact_trace hact_norm w hw
    have hsum_eq : 2 * Ew + traceLM F hLK (w ^ 2) =
        (Ew + Enw + traceLM F hLK (w ^ 2)) + (Ew - Enw) := by ring
    refine ⟨htr_w, hEw, ?_⟩
    rw [hsum_eq]
    exact hvalL_add (b : ℤ) _ _ heven_val hodd_val
  exact ⟨⟨hp_kL, h2_kL⟩, hp_val, hτ_congr, h4, h5⟩

theorem ld_wild_odd_prime_L_polar_functions_and_R_L_sums (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hab_eq : condExp F L χ' = condExp F L ν₁)
    (hb_odd : condExp F L ν₁ % 2 = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (ϖ_K : Kˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLK) ϖ_K = ϖ_L)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (t : ℕ) (ht_ge1 : 1 ≤ t) (hb_eq : condExp F L ν₁ = t + 1)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (hnorm_exp : ∀ (m : ℕ), 1 ≤ m → ∀ y : K, (y = 0 ∨ (m : ℤ) ≤ valL F K y) →
      ∃ z : K, (z = 0 ∨ (2 * m : ℤ) ≤ valL F K z) ∧
        normLM F hLK (1 + y) = 1 + traceLM F hLK (y + z) + normLM F hLK y)
    (R_L : Finset L) (c_τ : Lˣ) (N : Lˣ)
    (τ_unit τ_tilde : ℕ → Lˣ) (c_ν c_twist : ℕ → Lˣ) (c_χ : Lˣ)
    (hRL_card : R_L.card = Fintype.card k_L)
    (hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r)
    (hRL_sep : ∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0)
    (hc_τ_val : valL F L (c_τ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hc_τ_stat : ∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_τ⁻¹ : Lˣ) : L) * x))
    (hN_val : valL F L (N : L) = 0)
    (hc_χ_eq : c_χ = c_τ * N⁻¹)
    (hτ_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
      (τ_tilde j : L) = (j : L) ^ ((Module.finrank L (IntermediateField.extendScalars hLK)) ^ (condExp F L ν₁)) ∧
      τ_unit j = (τ_tilde j) ^ (Module.finrank L (IntermediateField.extendScalars hLK)) ∧
      Units.map (normLM F hLK) (Units.map (IntermediateField.inclusion hLK).toMonoidHom (τ_tilde j)) = τ_unit j ∧
      ν₁ (τ_unit j) = 1 ∧
      c_ν j = c_τ * (τ_unit j)⁻¹ ∧
      (N : L) + (τ_unit j : L) ≠ 0 ∧
      valL F L ((N : L) + (τ_unit j : L)) = 0 ∧
      (((c_twist j)⁻¹ : Lˣ) : L) = ((c_τ⁻¹ : Lˣ) : L) * ((N : L) + (τ_unit j : L)))
    (hc_χ_val : valL F L (c_χ : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_χ_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ⁻¹ : Lˣ) : L) * x))
    (hτ_mod : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
      ((τ_unit j : L) - (j : L) = 0 ∨
        ((condExp F L ν₁ / 2 + 1 : ℕ) : ℤ) ≤ valL F L ((τ_unit j : L) - (j : L))) ∧
      resL (τ_unit j : L) = (j : k_L))
    (μ : k_L)
    (hμ_res : resL (traceLM F hLK (((ϖ_K ^ t : Kˣ) : K)) * (((ϖ_L ^ t : Lˣ)⁻¹ : Lˣ) : L)) = μ) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    let d := condExp F L ν₁ / 2
    let d₀ := resL (N : L)
    ∃ (ψ₀ H_τ H_χ : k_L → Ω F),
      (∀ z : L, (z = 0 ∨ 0 ≤ valL F L z) →
        ψ₀ (resL z) = ψ (((c_τ⁻¹ : Lˣ) : L) * ((ϖ_L ^ t : Lˣ) : L) * z)) ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        ∀ hx : 1 + ((ϖ_L ^ d : Lˣ) : L) * x ≠ 0,
          H_τ (resL x) =
            (ν₁ (Units.mk0 (1 + ((ϖ_L ^ d : Lˣ) : L) * x) hx) : Ω F)⁻¹ *
              ψ (((c_τ⁻¹ : Lˣ) : L) * ((ϖ_L ^ d : Lˣ) : L) * x)) ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        ∀ hx : 1 + ((ϖ_L ^ d : Lˣ) : L) * x ≠ 0,
          H_χ (resL x) =
            (χ' (Units.mk0 (1 + ((ϖ_L ^ d : Lˣ) : L) * x) hx) : Ω F)⁻¹ *
              ψ (((c_χ⁻¹ : Lˣ) : L) * ((ϖ_L ^ d : Lˣ) : L) * x)) ∧
      ψ₀ 0 = 1 ∧
      (∀ x y : k_L, ψ₀ (x + y) = ψ₀ x * ψ₀ y) ∧
      (∃ x₀ : k_L, ψ₀ x₀ ≠ 1) ∧
      (∀ y : k_L, ψ₀ (y ^ p) = ψ₀ (- μ * y)) ∧
      H_τ 0 = 1 ∧
      (∀ x y : k_L, H_τ (x + y) = H_τ x * H_τ y * ψ₀ (x * y)) ∧
      H_χ 0 = 1 ∧
      (∀ x y : k_L, H_χ (x + y) = H_χ x * H_χ y * ψ₀ (d₀ * x * y)) ∧
      (∑ r ∈ R_L,
        if hr : 1 + ((ϖ_L ^ d : Lˣ) : L) * r ≠ 0 then
          (χ' (Units.mk0 (1 + ((ϖ_L ^ d : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
            ψ (((c_χ⁻¹ : Lˣ) : L) * ((ϖ_L ^ d : Lˣ) : L) * r)
        else 0) = (∑ x : k_L, H_χ x) ∧
      (∀ j ∈ (Finset.range p).erase 0,
        (∑ r ∈ R_L,
          if hr : 1 + ((ϖ_L ^ d : Lˣ) : L) * r ≠ 0 then
            ((ν₁ ^ j) (Units.mk0 (1 + ((ϖ_L ^ d : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
              ψ ((((c_ν j)⁻¹ : Lˣ) : L) * ((ϖ_L ^ d : Lˣ) : L) * r)
          else 0) = (∑ x : k_L, (H_τ x) ^ j) ∧
        (∑ r ∈ R_L,
          if hr : 1 + ((ϖ_L ^ d : Lˣ) : L) * r ≠ 0 then
            ((ν₁ ^ j * χ') (Units.mk0 (1 + ((ϖ_L ^ d : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
              ψ ((((c_twist j)⁻¹ : Lˣ) : L) * ((ϖ_L ^ d : Lˣ) : L) * r)
          else 0) = (∑ x : k_L, (H_τ x) ^ j * H_χ x)) :=
by
  intro p d d₀
  classical
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add,
    hunit0, hunit_ge1, hunit_val0⟩ := hvalL_props
  obtain ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K, hval_inv_K, hval_surj_K,
    hval_add_K, hunit0_K, hunit_ge1_K, hunit_val0_K⟩ := hvalK_props
  set b : ℕ := condExp F L ν₁
  set n : ℤ := condExpChar F L ψ
  set A : L := ((c_τ⁻¹ : Lˣ) : L)
  set δ_L : L := ((ϖ_L ^ d : Lˣ) : L)
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hb_ne0 : b ≠ 0 := by omega
  have hb_ge1 : 1 ≤ b := by omega
  have hd_ge1 : 1 ≤ d := by omega
  have hb_eq_2d1 : b = 2 * d + 1 := by omega
  have ht_eq_2d : t = 2 * d := by omega
  have hr0_eq : (b + 1) / 2 = d + 1 := by omega
  have hψ_triv : ∀ x : L, (x = 0 ∨ -n ≤ valL F L x) → ψ x = 1 := (hSpecL 1).1
  have hν₁_triv : ∀ u ∈ unitGroup F L b, ν₁ u = 1 := ((hSpecL ν₁).2.2.1 hb_ne0).1
  have hχ'_triv : ∀ u ∈ unitGroup F L b, χ' u = 1 := by
    rw [← hab_eq]
    exact ((hSpecL χ').2.2.1 (by omega)).1
  let P : ℤ → L → Prop := fun k x => x = 0 ∨ k ≤ valL F L x
  let PK : ℤ → K → Prop := fun k y => y = 0 ∨ k ≤ valL F K y
  have hP_zero : ∀ k : ℤ, P k 0 := fun _ => Or.inl rfl
  have hP_one : P 0 1 := Or.inr (by rw [hval1])
  have hP_mono : ∀ {k₁ k₂ : ℤ}, k₁ ≤ k₂ → ∀ {x : L}, P k₂ x → P k₁ x := by
    intro k₁ k₂ hk x hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have hP_neg : ∀ {k : ℤ} {x : L}, P k x → P k (-x) := by
    intro k x hx
    rcases hx with rfl | hx
    · simp [P]
    · right; rw [hval_neg]; exact hx
  have hP_add : ∀ {k : ℤ} {x y : L}, P k x → P k y → P k (x + y) :=
    fun hx hy => hval_add _ _ _ hx hy
  have hP_sub : ∀ {k : ℤ} {x y : L}, P k x → P k y → P k (x - y) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hP_add hx (hP_neg hy)
  have hP_mul : ∀ {k₁ k₂ : ℤ} {x y : L}, P k₁ x → P k₂ y → P (k₁ + k₂) (x * y) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hx' := hx.resolve_left hx0
        have hy' := hy.resolve_left hy0
        rw [hval_mul x y hx0 hy0]
        omega
  have hP_sq : ∀ {k : ℤ} {x : L}, P k x → P (k + k) (x ^ 2) := by
    intro k x hx
    rw [sq]
    exact hP_mul hx hx
  have hP_of_val : ∀ {k : ℤ} {x : L}, valL F L x = k → P k x := by
    intro k x h
    exact Or.inr (by omega)
  have hPK_mono : ∀ {k₁ k₂ : ℤ}, k₁ ≤ k₂ → ∀ {y : K}, PK k₂ y → PK k₁ y := by
    intro k₁ k₂ hk y hy
    rcases hy with rfl | hy
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have hPK_mul : ∀ {k₁ k₂ : ℤ} {x y : K}, PK k₁ x → PK k₂ y → PK (k₁ + k₂) (x * y) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hx' := hx.resolve_left hx0
        have hy' := hy.resolve_left hy0
        rw [hval_mul_K x y hx0 hy0]
        omega
  have hPK_of_val : ∀ {k : ℤ} {y : K}, valL F K y = k → PK k y := by
    intro k y h
    exact Or.inr (by omega)
  have hϖL_pow_val : ∀ k : ℕ, valL F L ((ϖ_L ^ k : Lˣ) : L) = (k : ℤ) := by
    intro k
    induction k with
    | zero => simp [hval1]
    | succ k ih =>
      rw [pow_succ, Units.val_mul,
        hval_mul ((ϖ_L ^ k : Lˣ) : L) (ϖ_L : L) (Units.ne_zero _) (Units.ne_zero _),
        ih, hϖ_L]
      push_cast
      ring
  have hϖL_pow_inv_val : ∀ k : ℕ, valL F L ((((ϖ_L ^ k : Lˣ)⁻¹ : Lˣ) : L)) = -(k : ℤ) := by
    intro k
    rw [hval_inv (ϖ_L ^ k), hϖL_pow_val k]
  have hϖK_pow_val : ∀ k : ℕ, valL F K ((ϖ_K ^ k : Kˣ) : K) = (k : ℤ) := by
    intro k
    induction k with
    | zero => simp [hval1_K]
    | succ k ih =>
      rw [pow_succ, Units.val_mul,
        hval_mul_K ((ϖ_K ^ k : Kˣ) : K) (ϖ_K : K) (Units.ne_zero _) (Units.ne_zero _),
        ih, hϖ_K]
      push_cast
      ring
  have hϖLt_eq_sq : ((ϖ_L ^ t : Lˣ) : L) = δ_L ^ 2 := by
    dsimp only [δ_L]
    rw [← Units.val_pow_eq_pow_val, ← pow_mul, mul_comm d 2, ← ht_eq_2d]
  have hA_val : valL F L A = -((b : ℤ) + n) := by
    dsimp only [A]
    rw [hval_inv c_τ, hc_τ_val]
  have hP_A : P (-((b : ℤ) + n)) A := hP_of_val hA_val
  have hP_δ : P (d : ℤ) δ_L := hP_of_val (hϖL_pow_val d)
  have hP_ϖt : P (t : ℤ) ((ϖ_L ^ t : Lˣ) : L) := hP_of_val (hϖL_pow_val t)
  have hP_N : P 0 (N : L) := hP_of_val hN_val
  have h1_add_ne : ∀ {y : L}, P 1 y → 1 + y ≠ 0 := by
    intro y hy h0
    have hy_eq : y = -1 := eq_neg_of_add_eq_zero_right h0
    rw [hy_eq] at hy
    rcases hy with h_neg1_0 | h_val
    · exact one_ne_zero (neg_eq_zero.mp h_neg1_0)
    · rw [hval_neg1] at h_val
      omega
  have h1_add_val : ∀ {y : L} (hy : P 1 y), valL F L (1 + y) = 0 := by
    intro y hy
    set u := Units.mk0 (1 + y) (h1_add_ne hy)
    have hu_mem : u ∈ unitGroup F L 1 := by
      rw [hunit_ge1 1 le_rfl u]
      change (1 + y : L) = 1 ∨ (1 : ℤ) ≤ valL F L ((1 + y : L) - 1)
      rw [add_sub_cancel_left]
      rcases hy with rfl | hy'
      · left; rw [add_zero]
      · right; exact hy'
    exact hunit_val0 1 u hu_mem
  have h1_add_ne_K : ∀ {y : K}, PK 1 y → 1 + y ≠ 0 := by
    intro y hy h0
    have hy_eq : y = -1 := eq_neg_of_add_eq_zero_right h0
    rw [hy_eq] at hy
    rcases hy with h_neg1_0 | h_val
    · exact one_ne_zero (neg_eq_zero.mp h_neg1_0)
    · rw [hval_neg1_K] at h_val
      omega
  have hψ_congr : ∀ {x y : L}, P (-n) (x - y) → ψ x = ψ y := by
    intro x y hxy
