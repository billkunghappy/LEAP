        change (σ_lift πK₁ * ((ϖ_K₁⁻¹ : K₁ˣ) : K₁) - 1) * πK₁ = _
        have h1 : ((ϖ_K₁⁻¹ : K₁ˣ) : K₁) * πK₁ = 1 := Units.inv_mul ϖ_K₁
        calc (σ_lift πK₁ * ((ϖ_K₁⁻¹ : K₁ˣ) : K₁) - 1) * πK₁
            = σ_lift πK₁ * (((ϖ_K₁⁻¹ : K₁ˣ) : K₁) * πK₁) - πK₁ := by ring
          _ = σ_lift πK₁ - πK₁ := by rw [h1, mul_one]
      have hπ_diff : σ_lift πK₁ - πK₁ = 0 ∨
          (d₁ : ℤ) + 1 ≤ valL F K₁ (σ_lift πK₁ - πK₁) := by
        rw [← hπ_diff_eq]
        exact hval_mul_ge_K₁ (d₁ : ℤ) 1 ((u_π : K₁) - 1) πK₁
          hu_π_val (Or.inr (by rw [hϖ_K₁]))
      have hπ_pow_diff : ∀ n : ℕ, 1 ≤ n →
          (σ_lift πK₁) ^ n - πK₁ ^ n = 0 ∨
            (n : ℤ) + (d₁ : ℤ) ≤ valL F K₁ ((σ_lift πK₁) ^ n - πK₁ ^ n) := by
        intro n
        induction n with
        | zero =>
          intro h
          omega
        | succ n ih =>
          intro _
          by_cases hn0 : n = 0
          · subst hn0
            simpa [pow_one, add_comm] using hπ_diff
          · have hn1 : 1 ≤ n := Nat.one_le_iff_ne_zero.mpr hn0
            have h_id : (σ_lift πK₁) ^ (n + 1) - πK₁ ^ (n + 1) =
