        have h2 := (Finset.mul_prod_erase (Finset.range ℓ)
          (fun j => ((ordC (γ_fn x j).factorial : ℕ) : k_M)) hj₀_mem).symm
        have h_er :
            ∏ j ∈ (Finset.range ℓ).erase j₀, ((ordC (γ_fn (x + 1) j).factorial : ℕ) : k_M) =
              ∏ j ∈ (Finset.range ℓ).erase j₀, ((ordC (γ_fn x j).factorial : ℕ) : k_M) :=
          Finset.prod_congr rfl (fun j hj => by rw [h_div_ne j hj])
        rw [h1, h_er, h_ordC_fact_u, pow_succ]
        calc (ℓ : k_M) ^ x * (ℓ : k_M) *
              ((ordC u : k_M) * ((ordC (γ_fn x j₀).factorial : ℕ) : k_M) *
                ∏ x_1 ∈ (Finset.range ℓ).erase j₀, ((ordC (γ_fn x x_1).factorial : ℕ) : k_M))
            = ((ℓ : k_M) * (ordC u : k_M)) *
                ((ℓ : k_M) ^ x *
                  (((ordC (γ_fn x j₀).factorial : ℕ) : k_M) *
                    ∏ x_1 ∈ (Finset.range ℓ).erase j₀, ((ordC (γ_fn x x_1).factorial : ℕ) : k_M))) := by
              ring
          _ = (ordC (x + 1) : k_M) *
                (((ordC x.factorial : ℕ) : k_M) *
                  ∏ j ∈ (Finset.range ℓ).erase 0, ((ordC (j * h).factorial : ℕ) : k_M)) := by
              rw [h_ordC_u, ← h2, ih_prod]
          _ = ((ordC (x + 1).factorial : ℕ) : k_M) *
                ∏ j ∈ (Finset.range ℓ).erase 0, ((ordC (j * h).factorial : ℕ) : k_M) := by
              rw [h_ordC_fact_x, mul_assoc]
  have h_s4 : ∀ (n : ℕ),
      ((n.factorial / p ^ padicValNat p n.factorial : ℕ) : k_M) =
        (-1 : k_M) ^ (padicValNat p n.factorial) *
          (((p.digits n).map Nat.factorial).prod : k_M) := by
    intro n
    let ordC := fun m : ℕ => m / p ^ padicValNat p m
    let ordF := fun m : ℕ => ((ordC m.factorial : ℕ) : k_M)
    have h_ordC_mul : ∀ x y : ℕ, ordC (x * y) = ordC x * ordC y := by
      intro x y
      dsimp only [ordC]
