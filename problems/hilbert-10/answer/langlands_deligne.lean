      have h_sum_eq :
          (∑ c : C, (rightTransRep F H a.1) (lam c⁻¹ • (rightTransRep F H c.1) v₀)) =
            ∑ c : C, lam a • (lam c⁻¹ • (rightTransRep F H c.1) v₀) := by
        refine (Fintype.sum_equiv (Equiv.mulLeft a⁻¹)
          (fun c => lam a • (lam c⁻¹ • (rightTransRep F H c.1) v₀))
          (fun c => (rightTransRep F H a.1) (lam c⁻¹ • (rightTransRep F H c.1) v₀))
          (fun c => ?_)).symm
        change lam a • (lam c⁻¹ • (rightTransRep F H c.1) v₀) =
          (rightTransRep F H a.1) (lam (a⁻¹ * c)⁻¹ • (rightTransRep F H (a⁻¹ * c).1) v₀)
        rw [map_smul]
        have h_rep : rightTransRep F H a.1 (rightTransRep F H (a⁻¹ * c).1 v₀) =
