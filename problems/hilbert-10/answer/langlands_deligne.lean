          ((θE' cE' : Ω F) ^ 4 * (ψE' (((cE'⁻¹ : E'ˣ) : E') * 2)) ^ 2) := by ring
    _ = (qL F L : Ω F) ^
          ((4 * condExpChar F E' ψE' + 2 * (condExp F E' θE' : ℤ)) +
