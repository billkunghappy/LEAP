            else 0) =
          (∑ r ∈ R_L,
            if hr : 1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r ≠ 0 then
              ((ν₁ ^ j) (Units.mk0 (1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
                ψ ((((c_ν j)⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r)
            else 0)))
    (hHasse_eq_odd : condExp F L χ' = condExp F L ν₁ → condExp F L ν₁ % 2 = 1 →
      Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2 →
      (∑ r ∈ R_K,
        if hr : 1 + ((ϖ_K ^ (condExp F L ν₁ / 2) : Kˣ) : K) * r ≠ 0 then
          ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + ((ϖ_K ^ (condExp F L ν₁ / 2) : Kˣ) : K) * r) hr) : Ω F)⁻¹ *
            (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K) * ((ϖ_K ^ (condExp F L ν₁ / 2) : Kˣ) : K) * r)
        else 0) *
        (∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
