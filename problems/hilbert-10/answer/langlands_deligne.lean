          _ = (z * c₀) * c₀⁻¹ := by rw [← hz.2 c₀ hc₀]
          _ = z := by group
      have h_conj_eq : (h₀ * c₀) * z * (h₀ * c₀)⁻¹ = h₀ * z * h₀⁻¹ := by
        calc (h₀ * c₀) * z * (h₀ * c₀)⁻¹ = h₀ * (c₀ * z * c₀⁻¹) * h₀⁻¹ := by group
          _ = h₀ * z * h₀⁻¹ := by rw [h_c₀_comm]
