      have h1 : f r₀ = 0 ∨ V ≤ valL F L (f r₀) := hS r₀ (Finset.mem_insert_self r₀ S')
      have h2 : (∑ r ∈ S', f r) = 0 ∨ V ≤ valL F L (∑ r ∈ S', f r) :=
        ih (fun r hr => hS r (Finset.mem_insert_of_mem hr))
      exact hvalL_add V (f r₀) (∑ r ∈ S', f r) h1 h2
  have hpoly_zero_L : ∀ (n : ℕ) (d : ℕ → L),
