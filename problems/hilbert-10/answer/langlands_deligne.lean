          have hp1_nonneg : (0 : ℤ) ≤ ((p F - 1 : ℕ) : ℤ) := Nat.cast_nonneg _
          nlinarith
      obtain ⟨hSub_KM1, hStab_KM1, hSuperStab_KM1, hSuper_KM1⟩ :=
        ld_ch14_wild_prime_sub_and_super_norm_step F M_1 K₀ hM1_K₀ hp_prime
          hValNorm_M1K₀ ϖ_K₀ ϖ_M1 hϖ_norm1 hϖ_M1 t ht_ge1 htr_bound_KM1_t hnorm_exp_KM1
      have hValAlg_MCM1' : ∀ z : M_C,
          valL F M_1 (IntermediateField.inclusion hMC_M1 z) =
            (Module.finrank M_C (IntermediateField.extendScalars hMC_M1) : ℤ) * valL F M_C z := by
        intro z; rw [hfin_MCM1]; exact hValAlg_MCM1 z
      obtain ⟨hSub_M1MC, hStab_M1MC, hSuperStab_M1MC, hSuper_M1MC⟩ :=
        ih M_1 hMC_M1 hGalMCM1 hAbMCM1 hfin_MCM1 hExpMCM1 hValNorm_MCM1 hValAlg_MCM1'
          ϖ_M1 ϖ_MC₀ hϖ_norm2 hϖ_M1 hϖ_MC₀ hJump_MCM1
      exact ld_ch14_wild_tower_sub_and_super_norm_comp F M_C M_1 K₀ hM_CK₀ hMC_M1 hM1_K₀
        hp_prime r hr_pos ϖ_K₀ ϖ_M1 ϖ_MC₀ hϖ_norm1 hϖ_norm2 hϖ_M1 hϖ_MC₀ t ht_ge1
        hValNorm_M1K₀ hSub_KM1 hStab_KM1 hSuperStab_KM1 hSuper_KM1
        hValNorm_MCM1 hSub_M1MC hStab_M1MC hSuperStab_M1MC hSuper_M1MC
  have hr_eq : (r_exp - 1) + 1 = r_exp := Nat.sub_add_cancel hr_exp_pos
  have hq_eq_sub : Module.finrank M_C (IntermediateField.extendScalars hM_CK) =
      (p F) ^ ((r_exp - 1) + 1) := by
    rw [hr_eq, hq_pow]
  obtain ⟨hSub_KMC, hStab_KMC, _, hSuper_KMC_sub⟩ :=
    hInd (r_exp - 1) K hM_CK hGalMCK hMin.2.1 hq_eq_sub hExpMCK hValNormK hValAlgK
      ϖ_K ϖ_MC hϖ_normK hϖ_valK hϖ_valMC hJumpK_t0
  have hSuper_KMC : ∀ (u : ℕ), t + 1 ≤ u →
      ∀ w : K, (w = 0 ∨ ((t + q * (u - t) : ℕ) : ℤ) ≤ valL F K w) →
        (traceLM F hM_CK w = 0 ∨ (u : ℤ) ≤ valL F M_C (traceLM F hM_CK w)) ∧
        (normLM F hM_CK (1 + w) - (1 + traceLM F hM_CK w) = 0 ∨
          (u + 1 : ℤ) ≤ valL F M_C (normLM F hM_CK (1 + w) - (1 + traceLM F hM_CK w))) := by
    intro u hu w hw
    apply hSuper_KMC_sub u hu w
    rwa [← hq_eq_sub]
  obtain ⟨hNormE_res, hNormE_sub, hNormE_crit, hNormE_super⟩ :=
    ld_ch14_diamond_pullback_norm_expansions_on_E F L K M_C E hLM_C hM_CK hLE hEK
      hFinE_eq hValNormE hValAlgE hValNormK hValAlgK hResLiftK hDiamondTrNorm
      t k a ht_ge1 hk_ge1 ha_ge2 hk_dvd hValAlgKE hValAlgMCL
      P_poly ϖ_K ϖ_MC ϖ_E ϖ_L hϖ_normK hϖ_normE hϖ_valK hϖ_valMC hϖ_valE hϖ_valL
      hp_prime r_exp hr_exp_pos a_coeff hq_pow ha_int hP_def hP_norm
      hSub_KMC hStab_KMC hSuper_KMC
  exact ⟨hSub_KMC, hNormE_res, hNormE_sub, hNormE_crit, hNormE_super⟩

theorem ld_ch14_higher_cond_base_and_pullback_units_on_MC (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hGal : IsGaloisExt F L K) (hGalMCK : IsGaloisExt F M_C K)
    (hAbMCK : IsAbelianExt F hM_CK)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hSepLFi : ∀ i : Fin D_orb.length,
      Algebra.IsSeparable L (IntermediateField.extendScalars (D_orb.get i).le))
    (hψFi : ∀ i : Fin D_orb.length,
      IsAdmissibleChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ))
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (hχ'_cond : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1)
    (hμ'_cond : ∀ i : Fin D_orb.length,
      ∀ u ∈ unitGroup F (D_orb.get i).field (condExp F (D_orb.get i).field (μ'_orb i)),
        (μ'_orb i) u = 1)
    (ν_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      (M_Cˣ →* (Ω F)ˣ))
    (σ_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      (M_C ≃ₐ[F] M_C))
    (idx_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      Fin D_orb.length)
    (hν_inj : Function.Injective ν_all)
    (hν_props : ∀ j,
      ν_all j ≠ 1 ∧
      (ν_all j) ^ (p F) = 1 ∧
      (∀ x : L, (σ_all j) (IntermediateField.inclusion hLM_C x) =
        IntermediateField.inclusion hLM_C x) ∧
      (∀ z : M_C, valL F M_C ((σ_all j) z) = valL F M_C z) ∧
      (∀ z : M_C, traceLM F hLM_C ((σ_all j) z) = traceLM F hLM_C z) ∧
      (∀ w : M_Cˣ, w ∈ Set.range (Units.map (normLM F hM_CK)) → (ν_all j) w = 1) ∧
      ∀ w : M_Cˣ,
        (ν_all j) w =
          ((μ'_orb (idx_all j)).comp (Units.map (normLM F (hFiMC (idx_all j)))))
            (Units.map (σ_all j).toRingEquiv.toMonoidHom w))
    (hν_prod : ∀ (c_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ),
      ∏ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1),
        Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
          (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
            (c_orb (idx_all j))) =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
          (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c_orb i)))
    (hFrobSurjMC : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      ∃ s : M_C, (s = 0 ∨ 0 ≤ valL F M_C s) ∧
        (z - s ^ (p F) = 0 ∨ 1 ≤ valL F M_C (z - s ^ (p F))))
    (hValNormK : ∀ w : K, valL F M_C (normLM F hM_CK w) = valL F K w)
    (hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (hResLiftK : ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (w - IntermediateField.inclusion hM_CK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hM_CK z)))
    (t k : ℕ) (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k)
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hnMC : condExpChar F M_C (traceChar F hLM_C ψ) =
      (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1))
    (htr_bound_K : ∀ (m : ℤ) (w : K),
      (w = 0 ∨
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * m -
          ((Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K w) →
      (traceLM F hM_CK w = 0 ∨ m ≤ valL F M_C (traceLM F hM_CK w)))
    (hFi_ram : ∀ i : Fin D_orb.length,
      condExp F (D_orb.get i).field (μ'_orb i) = t + 1 ∧
      condExp F M_C ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) = t + 1 ∧
      (∀ x : (D_orb.get i).field,
        valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
          valL F (D_orb.get i).field x) ∧
      (∀ z : M_C,
        valL F (D_orb.get i).field (normLM F (hFiMC i) z) =
          (Module.finrank (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)) : ℤ) *
            valL F M_C z) ∧
      (∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
        (traceLM F (hFiMC i) z = 0 ∨ m ≤ valL F (D_orb.get i).field (traceLM F (hFiMC i) z))) ∧
      (∀ z : M_C, (z = 0 ∨ 1 ≤ valL F M_C z) →
        normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z) = 0 ∨
          2 * valL F M_C z ≤
            valL F (D_orb.get i).field
              (normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z))) ∧
      condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) =
        (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1) ∧
      ∃ f_i : ℕ,
        1 ≤ f_i ∧
        Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_i ∧
        resDeg F (D_orb.get i).field = f_i * resDeg F L ∧
        (∀ x : (D_orb.get i).field,
          valL F L (normLM F (D_orb.get i).le x) =
            (f_i : ℤ) * valL F (D_orb.get i).field x))
    (P_poly : M_C → M_C) (ϖ_K : Kˣ) (ϖ_MC : M_Cˣ) (ϖ_L : Lˣ)
    (hϖ_normK : Units.map (normLM F hM_CK) ϖ_K = ϖ_MC)
    (hϖ_valK : valL F K (ϖ_K : K) = 1)
    (hϖ_valMC : valL F M_C (ϖ_MC : M_C) = 1)
    (hϖ_valL : valL F L (ϖ_L : L) = 1)
    (r_exp : ℕ) (hr_exp_pos : 1 ≤ r_exp) (a_coeff : Fin r_exp → M_C)
    (hq_pow : Module.finrank M_C (IntermediateField.extendScalars hM_CK) = (p F) ^ r_exp)
    (ha_int : ∀ j : Fin r_exp, a_coeff j = 0 ∨ 0 ≤ valL F M_C (a_coeff j))
    (hTr_val0 : valL F M_C ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K)) = 0)
    (hP_def : ∀ z : M_C,
      P_poly z =
        z ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) +
          ∑ j : Fin r_exp, (a_coeff j) * (z ^ ((p F) ^ (j : ℕ))))
    (hP_norm : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      normLM F hM_CK (1 + IntermediateField.inclusion hM_CK z * ((ϖ_K ^ t : Kˣ) : K)) -
        (1 + P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C)) = 0 ∨
        (t + 1 : ℤ) ≤ valL F M_C
          (normLM F hM_CK (1 + IntermediateField.inclusion hM_CK z * ((ϖ_K ^ t : Kˣ) : K)) -
            (1 + P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C))))
    (hNormK_sub : ∀ (v : ℕ), 1 ≤ v → v < t → ∀ w : K, (w = 0 ∨ (v : ℤ) ≤ valL F K w) →
      normLM F hM_CK (1 + w) - (1 + normLM F hM_CK w) = 0 ∨
        (v + 1 : ℤ) ≤ valL F M_C (normLM F hM_CK (1 + w) - (1 + normLM F hM_CK w))) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let a := condExp F L χ'
    ∃ (c'_χ' : Lˣ)
      (c'_μ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
      (u_all : Fin (q - 1) → M_Cˣ),
      let c₁ : Lˣ := (ϖ_L ^ (a - 1))⁻¹ * c'_χ'
      valL F L (c'_χ' : L) = (a : ℤ) + condExpChar F L ψ ∧
      valL F L (c₁ : L) = 1 + condExpChar F L ψ ∧
      (∀ x : L, (x = 0 ∨ (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c'_χ'⁻¹ : Lˣ) : L) * x)) ∧
      (∀ x : L, (x = 0 ∨ ((a - 1 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c'_χ'⁻¹ : Lˣ) : L) * x)) ∧
      (∀ i : Fin D_orb.length,
        let F_i := (D_orb.get i).field
        let ψ_Fi := traceChar F (D_orb.get i).le ψ
        2 ≤ condExp F F_i (μ'_orb i) ∧
        valL F F_i (c'_μ i : F_i) =
          (condExp F F_i (μ'_orb i) : ℤ) + condExpChar F F_i ψ_Fi ∧
        valL F F_i (c'_μ i : F_i) = (k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ) ∧
        (∀ x : F_i, (x = 0 ∨ ((condExp F F_i (μ'_orb i) - 1 : ℕ) : ℤ) ≤ valL F F_i x) →
          ∀ hx : 1 + x ≠ 0,
            (μ'_orb i (Units.mk0 (1 + x) hx) : Ω F) =
              ψ_Fi ((((c'_μ i)⁻¹ : F_iˣ) : F_i) * x))) ∧
      (∀ j : Fin (q - 1),
        u_all j =
          Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₁ *
            (ϖ_MC ^ t) *
            (Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
              (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
                (c'_μ (idx_all j))))⁻¹) ∧
      (∏ j : Fin (q - 1), u_all j =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (c₁ ^ (q - 1)) *
          (ϖ_MC ^ (t * (q - 1))) *
          (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
            (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_μ i)))⁻¹) ∧
      (∀ j : Fin (q - 1), valL F M_C ((u_all j : M_Cˣ) : M_C) = 0) ∧
      (∀ j : Fin (q - 1), ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
        (traceChar F hLM_C ψ)
          ((((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₁)⁻¹ : M_Cˣ) : M_C) *
            ((u_all j : M_C) * P_poly z)) = 1) ∧
      (∀ j₁ j₂ : Fin (q - 1),
        ((u_all j₁ : M_C) - (u_all j₂ : M_C) = 0 ∨
          1 ≤ valL F M_C ((u_all j₁ : M_C) - (u_all j₂ : M_C))) →
        j₁ = j₂) :=
by
  let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  let a := condExp F L χ'
  have hvalL := ld_valL_and_unitGroup_props F L
  have hvalMC := ld_valL_and_unitGroup_props F M_C
  have hvalK := ld_valL_and_unitGroup_props F K
  have hSpecMC := ld_condExp_and_condExpChar_spec F M_C (traceChar F hLM_C ψ) hψMC 1

  have hval_mul_ge : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (m₁ m₂ : ℤ) (x y : M),
      (x = 0 ∨ m₁ ≤ valL F M x) → (y = 0 ∨ m₂ ≤ valL F M y) →
        (x * y = 0 ∨ m₁ + m₂ ≤ valL F M (x * y)) := by
    intro M _ m₁ m₂ x y hx hy
    by_cases hx0 : x = 0
    · left; simp [hx0]
    · by_cases hy0 : y = 0
      · left; simp [hy0]
      · right
        have hx' : m₁ ≤ valL F M x := hx.resolve_left hx0
        have hy' : m₂ ≤ valL F M y := hy.resolve_left hy0
        rw [(ld_valL_and_unitGroup_props F M).2.2.2.2.1 x y hx0 hy0]
        omega

  have hval_unit_pow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (u : Mˣ) (n : ℕ),
      valL F M ((u ^ n : Mˣ) : M) = (n : ℤ) * valL F M (u : M) := by
    intro M _ u n
    induction' n with n ih
    · simp [(ld_valL_and_unitGroup_props F M).2.1]
    · rw [pow_succ, Units.val_mul,
        (ld_valL_and_unitGroup_props F M).2.2.2.2.1 _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
      push_cast
      ring

  
  have hStatL := (ld_tame_stationary_phase_and_stable_twist F L ψ hψ χ' h_ge2).1
  let c'_χ' : Lˣ := Classical.choose hStatL
  obtain ⟨hc_L_val, hc_L_half⟩ := Classical.choose_spec hStatL
  let c₁ : Lˣ := (ϖ_L ^ (a - 1))⁻¹ * c'_χ'
  have hc₁_val : valL F L (c₁ : L) = 1 + condExpChar F L ψ := by
    dsimp only [c₁]
    rw [Units.val_mul,
      hvalL.2.2.2.2.1 _ _ (Units.ne_zero _) (Units.ne_zero _),
      hvalL.2.2.2.2.2.1 (ϖ_L ^ (a - 1)),
      hval_unit_pow L ϖ_L (a - 1), hϖ_valL, mul_one, hc_L_val]
    have ha_ge2 : 2 ≤ a := h_ge2
    omega
  have hc_L_top : ∀ x : L, (x = 0 ∨ ((a - 1 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c'_χ'⁻¹ : Lˣ) : L) * x) := by
    intro x hx_val hx
    apply hc_L_half x _ hx
    rcases hx_val with rfl | hx_ge
    · exact Or.inl rfl
    · right
      have ha_ge2 : 2 ≤ a := h_ge2
      omega

  have hm_orb : ∀ i : Fin D_orb.length, 2 ≤ condExp F (D_orb.get i).field (μ'_orb i) := by
    intro i
    have hcond := (hFi_ram i).1
    omega
  have hStat_orb : ∀ i : Fin D_orb.length,
      letI := hFinFi i
      let E := (D_orb.get i).field
      let ψ_E := traceChar F (D_orb.get i).le ψ
      let θ := μ'_orb i
      let m := condExp F E θ
      let r₀ := (m + 1) / 2
      ∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x) := by
    intro i
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    exact (ld_tame_stationary_phase_and_stable_twist F (D_orb.get i).field
      (traceChar F (D_orb.get i).le ψ) (hψFi i) (μ'_orb i) (hm_orb i)).1
  let c'_μ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ :=
    fun i => Classical.choose (hStat_orb i)
  have hc_μ_props : ∀ i : Fin D_orb.length,
      let F_i := (D_orb.get i).field
      let ψ_Fi := traceChar F (D_orb.get i).le ψ
      2 ≤ condExp F F_i (μ'_orb i) ∧
      valL F F_i (c'_μ i : F_i) =
        (condExp F F_i (μ'_orb i) : ℤ) + condExpChar F F_i ψ_Fi ∧
      valL F F_i (c'_μ i : F_i) = (k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ) ∧
      (∀ x : F_i, (x = 0 ∨ ((condExp F F_i (μ'_orb i) - 1 : ℕ) : ℤ) ≤ valL F F_i x) →
        ∀ hx : 1 + x ≠ 0,
          (μ'_orb i (Units.mk0 (1 + x) hx) : Ω F) =
            ψ_Fi ((((c'_μ i)⁻¹ : F_iˣ) : F_i) * x)) := by
    intro i
    obtain ⟨hc_val, hc_stat⟩ := Classical.choose_spec (hStat_orb i)
    have hcond_i := (hFi_ram i).1
    have hnFi := (hFi_ram i).2.2.2.2.2.2.1
    refine ⟨hm_orb i, hc_val, ?_, ?_⟩
    · rw [hc_val, hcond_i, hnFi]
      push_cast
      ring
    · intro x hx_val hx
      apply hc_stat x _ hx
      rcases hx_val with rfl | hx_ge
      · exact Or.inl rfl
      · right
        have hr₀_le :
            (((condExp F (D_orb.get i).field (μ'_orb i) + 1) / 2 : ℕ) : ℤ) ≤
              ((condExp F (D_orb.get i).field (μ'_orb i) - 1 : ℕ) : ℤ) := by
          rw [hcond_i]
          omega
        exact le_trans hr₀_le hx_ge

  have hc_orb_stat : ∀ i : Fin D_orb.length,
      valL F (D_orb.get i).field ((c'_μ i : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) =
        (k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ) ∧
      ∀ x : (D_orb.get i).field,
        (x = 0 ∨ (t : ℤ) ≤ valL F (D_orb.get i).field x) →
        ∀ hx : 1 + x ≠ 0,
          ((μ'_orb i) (Units.mk0 (1 + x) hx) : Ω F) =
            (traceChar F (D_orb.get i).le ψ)
              ((((c'_μ i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * x) := by
    intro i
    refine ⟨(hc_μ_props i).2.2.1, ?_⟩
    intro x hx_val hx
    apply (hc_μ_props i).2.2.2 x _ hx
    rcases hx_val with rfl | hx_ge
    · exact Or.inl rfl
    · right
      have hcond_i := (hFi_ram i).1
      omega

  
  have hσ_val : ∀ j : Fin (q - 1), ∀ z : M_C, valL F M_C ((σ_all j) z) = valL F M_C z :=
    fun j => (hν_props j).2.2.2.1
  have hValAlgFiMC : ∀ i : Fin D_orb.length, ∀ x : (D_orb.get i).field,
      valL F M_C (IntermediateField.inclusion (hFiMC i) x) = valL F (D_orb.get i).field x :=
    fun i => (hFi_ram i).2.2.1
  have hFi_unram : ∀ i : Fin D_orb.length,
      (∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
        (traceLM F (hFiMC i) z = 0 ∨ m ≤ valL F (D_orb.get i).field (traceLM F (hFiMC i) z))) ∧
      (∀ z : M_C, (z = 0 ∨ 1 ≤ valL F M_C z) →
        normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z) = 0 ∨
          2 * valL F M_C z ≤
            valL F (D_orb.get i).field
              (normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z))) ∧
      condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) =
        (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1) :=
    fun i => ⟨(hFi_ram i).2.2.2.2.1, (hFi_ram i).2.2.2.2.2.1, (hFi_ram i).2.2.2.2.2.2.1⟩

  let c_all : Fin (q - 1) → M_Cˣ := fun j =>
    Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
      (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
        (c'_μ (idx_all j)))
  let u_all : Fin (q - 1) → M_Cˣ := fun j =>
    Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₁ *
      (ϖ_MC ^ t) * (c_all j)⁻¹
  have hc_all_def : ∀ j : Fin (q - 1),
      c_all j =
        Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
          (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
            (c'_μ (idx_all j))) := fun _ => rfl
  have hu_all_def : ∀ j : Fin (q - 1),
      u_all j =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₁ *
          (ϖ_MC ^ t) * (c_all j)⁻¹ := fun _ => rfl
  have hc_all_val : ∀ j : Fin (q - 1),
      valL F M_C ((c_all j : M_Cˣ) : M_C) =
        (k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ) := by
    intro j
    have h1 := hσ_val j ((c_all j : M_Cˣ) : M_C)
    have h2 : (σ_all j) ((c_all j : M_Cˣ) : M_C) =
        IntermediateField.inclusion (hFiMC (idx_all j))
          ((c'_μ (idx_all j) : ((D_orb.get (idx_all j)).field)ˣ) : (D_orb.get (idx_all j)).field) := by
      change (σ_all j) ((σ_all j).symm
        (IntermediateField.inclusion (hFiMC (idx_all j))
          ((c'_μ (idx_all j) : ((D_orb.get (idx_all j)).field)ˣ) : (D_orb.get (idx_all j)).field))) = _
      exact (σ_all j).apply_symm_apply _
    rw [← h1, h2, hValAlgFiMC (idx_all j), (hc_orb_stat (idx_all j)).1]
  have hu_all_mul : ∀ j : Fin (q - 1), ∀ z : M_C,
      ((((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₁)⁻¹ : M_Cˣ) : M_C) *
        ((u_all j : M_C) * z)) =
        ((((c_all j)⁻¹ : M_Cˣ) : M_C) * (z * ((ϖ_MC ^ t : M_Cˣ) : M_C))) := by
    intro j z
    have hu_cancel :
        (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₁)⁻¹ * u_all j =
          (ϖ_MC ^ t) * (c_all j)⁻¹ := by
      dsimp only [u_all]
      rw [mul_assoc (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₁),
        inv_mul_cancel_left]
    rw [← mul_assoc, ← Units.val_mul, hu_cancel, Units.val_mul]
    ring
  have hu_all_prod :
      ∏ j : Fin (q - 1), u_all j =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (c₁ ^ (q - 1)) *
          (ϖ_MC ^ (t * (q - 1))) *
          (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
            (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_μ i)))⁻¹ := by
    dsimp only [u_all]
    rw [Finset.prod_mul_distrib, Finset.prod_mul_distrib,
      Finset.prod_const, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
      ← map_pow, ← pow_mul, Finset.prod_inv_distrib, hν_prod c'_μ]

  have htrace_smul_aux : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (a_s : R) (x : S),
      Algebra.trace R S (algebraMap R S a_s * x) = a_s * Algebra.trace R S x := by
    intro R S _ _ _ a_s x
    rw [← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]

  have htrace_mul_inclusion : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (hAB : A ≤ B) (a_s : A) (w : B),
      traceLM F hAB (IntermediateField.inclusion hAB a_s * w) = a_s * traceLM F hAB w := by
    intro A B hAB a_s w
    exact htrace_smul_aux A (IntermediateField.extendScalars hAB) a_s (toExtendScalars F hAB w)

  have htrace_trans_aux : ∀ (K₀ L₀ M₀ E₀ : Type u) [Field K₀] [Field L₀] [Field M₀] [Field E₀]
      [Algebra K₀ L₀] [Algebra K₀ M₀] [Algebra K₀ E₀]
      (algLM : Algebra L₀ M₀) (algME : Algebra M₀ E₀) (algLE : Algebra L₀ E₀)
      (h1 : ∀ x : K₀, @algebraMap L₀ M₀ _ _ algLM (algebraMap K₀ L₀ x) = algebraMap K₀ M₀ x)
      (h2 : ∀ x : L₀, @algebraMap M₀ E₀ _ _ algME (@algebraMap L₀ M₀ _ _ algLM x) =
        @algebraMap L₀ E₀ _ _ algLE x)
      [FiniteDimensional K₀ M₀] (z : E₀),
      @Algebra.trace L₀ E₀ _ _ algLE z =
        @Algebra.trace L₀ M₀ _ _ algLM (@Algebra.trace M₀ E₀ _ _ algME z) := by
    intro K₀ L₀ M₀ E₀ _ _ _ _ _ _ _ algLM algME algLE h1 h2 _ z
    letI : Algebra L₀ M₀ := algLM
    letI : Algebra M₀ E₀ := algME
    letI : Algebra L₀ E₀ := algLE
    haveI : IsScalarTower K₀ L₀ M₀ := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h1 x).symm)
    haveI : IsScalarTower L₀ M₀ E₀ := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h2 x).symm)
    haveI : FiniteDimensional L₀ M₀ := Module.Finite.of_restrictScalars_finite K₀ L₀ M₀
    by_cases hFin : FiniteDimensional M₀ E₀
    · exact (Algebra.trace_trace z).symm
    · have htr1 : Algebra.trace M₀ E₀ = 0 := by
        apply Algebra.trace_eq_zero_of_not_exists_basis
        rintro ⟨s, ⟨b⟩⟩
        exact hFin (Module.Finite.of_basis b)
      have htr2 : Algebra.trace L₀ E₀ = 0 := by
        apply Algebra.trace_eq_zero_of_not_exists_basis
        rintro ⟨s, ⟨b⟩⟩
        haveI : Module.Finite L₀ E₀ := Module.Finite.of_basis b
        exact hFin (Module.Finite.of_restrictScalars_finite L₀ M₀ E₀)
      simp [htr1, htr2]

  have htrace_eq_inclusion : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (hAB : A ≤ B) (y : B),
      @Algebra.trace A B _ _ (IntermediateField.inclusion hAB).toAlgebra y = traceLM F hAB y := by
    intro A B hAB y
    letI : Algebra A B := (IntermediateField.inclusion hAB).toAlgebra
    let e : B ≃ₐ[A] IntermediateField.extendScalars hAB := {
      toFun := toExtendScalars F hAB
      invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hAB).mp z.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl
    }
    exact (Algebra.trace_eq_of_algEquiv e y).symm

  have htrace_trans : ∀ (A B C : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B]
      (hAB : A ≤ B) (hBC : B ≤ C) (z : C),
      traceLM F (hAB.trans hBC) z = traceLM F hAB (traceLM F hBC z) := by
    intro A B C _ hAB hBC z
    rw [← htrace_eq_inclusion (hAB.trans hBC) z,
        ← htrace_eq_inclusion hBC z,
        ← htrace_eq_inclusion hAB]
    exact htrace_trans_aux F A B C
      (IntermediateField.inclusion hAB).toAlgebra
      (IntermediateField.inclusion hBC).toAlgebra
      (IntermediateField.inclusion (hAB.trans hBC)).toAlgebra
      (fun _ => rfl)
      (fun _ => rfl)
      z

  let c₁_MC : M_Cˣ := Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₁
  have hc₁_MC_val : valL F M_C (c₁_MC : M_C) = (k : ℤ) * (1 + condExpChar F L ψ) := by
    change valL F M_C (IntermediateField.inclusion hLM_C (c₁ : L)) = _
    rw [hValAlgMCL (c₁ : L), hc₁_val]
  have hϖ_MC_pow_val : valL F M_C ((ϖ_MC ^ t : M_Cˣ) : M_C) = (t : ℤ) := by
    rw [hval_unit_pow M_C ϖ_MC t, hϖ_valMC, mul_one]
  have hϖ_K_pow_val : valL F K ((ϖ_K ^ t : Kˣ) : K) = (t : ℤ) := by
    rw [hval_unit_pow K ϖ_K t, hϖ_valK, mul_one]

  have hu_all_val : ∀ j : Fin (q - 1), valL F M_C ((u_all j : M_Cˣ) : M_C) = 0 := by
    intro j
    rw [hu_all_def j]
    change valL F M_C (((c₁_MC * (ϖ_MC ^ t) * (c_all j)⁻¹ : M_Cˣ) : M_C)) = 0
    rw [Units.val_mul,
      hvalMC.2.2.2.2.1 _ _ (Units.ne_zero _) (Units.ne_zero _),
      Units.val_mul,
      hvalMC.2.2.2.2.1 _ _ (Units.ne_zero _) (Units.ne_zero _),
      hc₁_MC_val, hϖ_MC_pow_val,
      hvalMC.2.2.2.2.2.1 (c_all j), hc_all_val j]
    omega

  have hν_stat : ∀ j : Fin (q - 1), ∀ z : M_C, (z = 0 ∨ (t : ℤ) ≤ valL F M_C z) →
      ∀ hz : 1 + z ≠ 0,
        ((ν_all j) (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM_C ψ) ((((c_all j)⁻¹ : M_Cˣ) : M_C) * z) := by
    intro j z hz_val hz
    let i := idx_all j
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    have hvalFi := ld_valL_and_unitGroup_props F (D_orb.get i).field
    have hSpecFi := (ld_condExp_and_condExpChar_spec F (D_orb.get i).field
      (traceChar F (D_orb.get i).le ψ) (hψFi i) 1).1
    let z' : M_C := (σ_all j) z
    have hz'_val : z' = 0 ∨ (t : ℤ) ≤ valL F M_C z' := by
      rcases hz_val with rfl | hz_ge
      · left; exact map_zero (σ_all j)
      · right
        change (t : ℤ) ≤ valL F M_C ((σ_all j) z)
        rw [(hν_props j).2.2.2.1 z]
        exact hz_ge
    have hz'_ge1 : z' = 0 ∨ 1 ≤ valL F M_C z' := by
      rcases hz'_val with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    let w_σ : M_Cˣ := Units.map (σ_all j).toRingEquiv.toMonoidHom (Units.mk0 (1 + z) hz)
    have hw_σ_coe : (w_σ : M_C) = 1 + z' := by
      change (σ_all j) (1 + z) = 1 + (σ_all j) z
      rw [map_add, map_one]
    let u' : ((D_orb.get i).field)ˣ := Units.map (normLM F (hFiMC i)) w_σ
    have hu'_coe : (u' : (D_orb.get i).field) = normLM F (hFiMC i) (1 + z') := by
      change normLM F (hFiMC i) (w_σ : M_C) = _
      rw [hw_σ_coe]
    let x' : (D_orb.get i).field := (u' : (D_orb.get i).field) - 1
    let r' : (D_orb.get i).field :=
      normLM F (hFiMC i) (1 + z') - (1 + traceLM F (hFiMC i) z')
    have hx'_1 : 1 + x' = (u' : (D_orb.get i).field) := by
      dsimp only [x']; ring
    have hx' : 1 + x' ≠ 0 := by
      rw [hx'_1]; exact Units.ne_zero u'
    have hu'_mk0 : Units.mk0 (1 + x') hx' = u' := Units.ext hx'_1
    have hx'_decomp : x' = traceLM F (hFiMC i) z' + r' := by
      dsimp only [x', r']
      rw [hu'_coe]
      ring
    have htr_z' : traceLM F (hFiMC i) z' = 0 ∨
        (t : ℤ) ≤ valL F (D_orb.get i).field (traceLM F (hFiMC i) z') :=
      (hFi_unram i).1 (t : ℤ) z' hz'_val
    have hr'_t1 : r' = 0 ∨ (t + 1 : ℤ) ≤ valL F (D_orb.get i).field r' := by
      by_cases hz'0 : z' = 0
      · left
        dsimp only [r']
        rw [hz'0, add_zero, map_one, map_zero, add_zero, sub_self]
      · have hz'_ge_t : (t : ℤ) ≤ valL F M_C z' := hz'_val.resolve_left hz'0
        have hrem : r' = 0 ∨ 2 * valL F M_C z' ≤ valL F (D_orb.get i).field r' :=
          (hFi_unram i).2.1 z' hz'_ge1
        rcases hrem with hr0 | hr_ge
        · exact Or.inl hr0
        · right; omega
    have hr'_t : r' = 0 ∨ (t : ℤ) ≤ valL F (D_orb.get i).field r' := by
      rcases hr'_t1 with hr0 | hr_ge
      · exact Or.inl hr0
      · exact Or.inr (by omega)
    have hx'_val : x' = 0 ∨ (t : ℤ) ≤ valL F (D_orb.get i).field x' := by
      rw [hx'_decomp]
      exact hvalFi.2.2.2.2.2.2.2.1 (t : ℤ) _ _ htr_z' hr'_t
    have hν_eval : (ν_all j) (Units.mk0 (1 + z) hz) = (μ'_orb i) u' :=
      (hν_props j).2.2.2.2.2.2 (Units.mk0 (1 + z) hz)
    have hstat_i := (hc_orb_stat i).2 x' hx'_val hx'
    rw [hu'_mk0] at hstat_i
    rw [hν_eval, hstat_i, hx'_decomp, mul_add, AddChar.map_add_eq_mul]
    have hr'_psi : (traceChar F (D_orb.get i).le ψ)
        ((((c'_μ i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * r') = 1 := by
      apply hSpecFi
      have hc_inv_val : valL F (D_orb.get i).field
          ((((c'_μ i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field)) =
            -((k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ)) := by
        rw [hvalFi.2.2.2.2.2.1 (c'_μ i), (hc_orb_stat i).1]
      have hmul := hval_mul_ge (D_orb.get i).field
        (-((k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ))) (t + 1 : ℤ)
        ((((c'_μ i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field)) r'
        (Or.inr (le_of_eq hc_inv_val.symm)) hr'_t1
      rcases hmul with h0 | hge
      · exact Or.inl h0
      · right
        have hnFi := (hFi_unram i).2.2
        have hk_expand : (k : ℤ) * (1 + condExpChar F L ψ) =
            (k : ℤ) * condExpChar F L ψ + (k : ℤ) := by ring
        omega
    rw [hr'_psi, mul_one]
    have hc_all_inv_σ : IntermediateField.inclusion (hFiMC i)
        ((((c'_μ i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field)) =
          (σ_all j) ((((c_all j)⁻¹ : M_Cˣ) : M_C)) := by
      have hinv : (c_all j)⁻¹ =
          Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
            (Units.map (IntermediateField.inclusion (hFiMC i)).toMonoidHom ((c'_μ i)⁻¹)) := by
        rw [hc_all_def j, ← map_inv, ← map_inv]
      have hcoe : (((c_all j)⁻¹ : M_Cˣ) : M_C) =
          (σ_all j).symm (IntermediateField.inclusion (hFiMC i)
            ((((c'_μ i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field))) :=
        congrArg Units.val hinv
      rw [hcoe, AlgEquiv.apply_symm_apply]
    have htr_pull : traceLM F (D_orb.get i).le
        ((((c'_μ i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) *
          traceLM F (hFiMC i) z') =
        traceLM F hLM_C ((((c_all j)⁻¹ : M_Cˣ) : M_C) * z) := by
      have hle_eq : (D_orb.get i).le.trans (hFiMC i) = hLM_C := rfl
      rw [← htrace_mul_inclusion (hFiMC i),
        ← htrace_trans L (D_orb.get i).field M_C (D_orb.get i).le (hFiMC i),
        hle_eq, hc_all_inv_σ]
      dsimp only [z']
      rw [← map_mul (σ_all j), (hν_props j).2.2.2.2.1]
    change ψ (traceLM F (D_orb.get i).le _) = ψ (traceLM F hLM_C _)
    rw [htr_pull]

  have hψMC_call_triv : ∀ (j : Fin (q - 1)) (e : M_C),
      (e = 0 ∨ (t + 1 : ℤ) ≤ valL F M_C e) →
      (traceChar F hLM_C ψ) ((((c_all j)⁻¹ : M_Cˣ) : M_C) * e) = 1 := by
    intro j e he
    apply hSpecMC.1
    have hc_inv_val : valL F M_C ((((c_all j)⁻¹ : M_Cˣ) : M_C)) =
        -((k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ)) := by
      rw [hvalMC.2.2.2.2.2.1 (c_all j), hc_all_val j]
    have hmul := hval_mul_ge M_C
      (-((k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ))) (t + 1 : ℤ)
      ((((c_all j)⁻¹ : M_Cˣ) : M_C)) e
      (Or.inr (le_of_eq hc_inv_val.symm)) he
    rcases hmul with h0 | hge
    · exact Or.inl h0
    · right
      have hk_expand : (k : ℤ) * (1 + condExpChar F L ψ) =
          (k : ℤ) * condExpChar F L ψ + (k : ℤ) := by ring
      omega

  have hν_triv_t1 : ∀ j : Fin (q - 1), ∀ u ∈ unitGroup F M_C (t + 1), (ν_all j) u = 1 := by
    intro j u hu
    let z : M_C := (u : M_C) - 1
    have hz_1 : 1 + z = (u : M_C) := by dsimp only [z]; ring
    have hz : 1 + z ≠ 0 := by rw [hz_1]; exact Units.ne_zero u
    have hu_mk0 : Units.mk0 (1 + z) hz = u := Units.ext hz_1
    have hz_t1 : z = 0 ∨ (t + 1 : ℤ) ≤ valL F M_C z := by
      rcases (hvalMC.2.2.2.2.2.2.2.2.2.1 (t + 1) (by omega) u).mp hu with hu1 | hge
      · left; dsimp only [z]; rw [hu1, sub_self]
      · exact Or.inr hge
    have hz_t : z = 0 ∨ (t : ℤ) ≤ valL F M_C z := by
      rcases hz_t1 with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    apply Units.ext
    rw [← hu_mk0, hν_stat j z hz_t hz, hψMC_call_triv j z hz_t1, Units.val_one]

  have hν_nontriv_t : ∀ j : Fin (q - 1), ∃ u₀ ∈ unitGroup F M_C t, (ν_all j) u₀ ≠ 1 := by
    intro j
    obtain ⟨x₁, hx₁_ne, hx₁_val, hx₁_psi⟩ := hSpecMC.2.1
    let z₀ : M_C := ((c_all j : M_Cˣ) : M_C) * x₁
    have hz₀_val : (t : ℤ) ≤ valL F M_C z₀ := by
      dsimp only [z₀]
      rw [hvalMC.2.2.2.2.1 _ _ (Units.ne_zero (c_all j)) hx₁_ne, hc_all_val j]
      have hk_expand : (k : ℤ) * (1 + condExpChar F L ψ) =
          (k : ℤ) * condExpChar F L ψ + (k : ℤ) := by ring
      omega
    have hz₀_1_ne : 1 + z₀ ≠ 0 := by
      intro h0
      have hz₀_eq : z₀ = -1 := by linear_combination h0
      have hval_neg1 : valL F M_C z₀ = 0 := by rw [hz₀_eq, hvalMC.2.2.1]
      omega
    let u₀ : M_Cˣ := Units.mk0 (1 + z₀) hz₀_1_ne
    have hu₀_mem : u₀ ∈ unitGroup F M_C t := by
      rw [hvalMC.2.2.2.2.2.2.2.2.2.1 t ht_ge1 u₀]
      right
      have hsub : (u₀ : M_C) - 1 = z₀ := by change (1 + z₀) - 1 = z₀; ring
      rw [hsub]
      exact hz₀_val
    refine ⟨u₀, hu₀_mem, ?_⟩
    intro hu₀_eq1
    apply hx₁_psi
    have hstat := hν_stat j z₀ (Or.inr hz₀_val) hz₀_1_ne
    change ((ν_all j) u₀ : Ω F) = _ at hstat
    rw [hu₀_eq1, Units.val_one] at hstat
    have hcancel : ((((c_all j)⁻¹ : M_Cˣ) : M_C) * z₀) = x₁ := by
      dsimp only [z₀]
      rw [← mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul]
    rw [hcancel] at hstat
    exact hstat.symm

  have hvalMC_pow_int : ∀ (z : M_C) (n : ℕ),
      (z = 0 ∨ 0 ≤ valL F M_C z) → (z ^ n = 0 ∨ 0 ≤ valL F M_C (z ^ n)) := by
    intro z n hz
    induction' n with n ih
    · right; simp [hvalMC.2.1]
    · rw [pow_succ]
      have h := hval_mul_ge M_C 0 0 (z ^ n) z ih hz
      simpa using h

  have hvalMC_sum_int : ∀ (S : Finset (Fin r_exp)) (f : Fin r_exp → M_C),
      (∀ m ∈ S, f m = 0 ∨ 0 ≤ valL F M_C (f m)) →
      ((∑ m ∈ S, f m) = 0 ∨ 0 ≤ valL F M_C (∑ m ∈ S, f m)) := by
    intro S f hf
    induction' S using Finset.induction_on with a_s s ha ih
    · left; simp
    · rw [Finset.sum_insert ha]
      exact hvalMC.2.2.2.2.2.2.2.1 0 (f a_s) (∑ m ∈ s, f m)
        (hf a_s (Finset.mem_insert_self a_s s))
        (ih (fun m hm => hf m (Finset.mem_insert_of_mem hm)))

  have hPz_int : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      (P_poly z = 0 ∨ 0 ≤ valL F M_C (P_poly z)) := by
    intro z hz
    rw [hP_def z]
    apply hvalMC.2.2.2.2.2.2.2.1 0
    · exact hvalMC_pow_int z q hz
    · apply hvalMC_sum_int Finset.univ
      intro m _
      have h := hval_mul_ge M_C 0 0 (a_coeff m) (z ^ ((p F) ^ (m : ℕ)))
        (ha_int m) (hvalMC_pow_int z ((p F) ^ (m : ℕ)) hz)
      simpa using h

  have hu_all_P : ∀ j : Fin (q - 1), ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      (traceChar F hLM_C ψ)
        ((((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₁)⁻¹ : M_Cˣ) : M_C) *
          ((u_all j : M_C) * P_poly z)) = 1 := by
    intro j z hz_int
    let y_K : K := IntermediateField.inclusion hM_CK z * ((ϖ_K ^ t : Kˣ) : K)
    have hz_K_int : IntermediateField.inclusion hM_CK z = 0 ∨
        0 ≤ valL F K (IntermediateField.inclusion hM_CK z) := by
      rcases hz_int with rfl | hz_ge0
      · left; exact map_zero _
      · right
        rw [hValAlgK z]
        exact mul_nonneg (Nat.cast_nonneg q) hz_ge0
    have hy_K_val : y_K = 0 ∨ (t : ℤ) ≤ valL F K y_K := by
      have h := hval_mul_ge K 0 (t : ℤ)
        (IntermediateField.inclusion hM_CK z) ((ϖ_K ^ t : Kˣ) : K)
        hz_K_int (Or.inr (le_of_eq hϖ_K_pow_val.symm))
      simpa [y_K] using h
    have hy_K_ne : 1 + y_K ≠ 0 := by
      intro h0
      have hy_eq : y_K = -1 := by linear_combination h0
      have hval_neg1 : valL F K y_K = 0 := by rw [hy_eq, hvalK.2.2.1]
      rcases hy_K_val with hy0 | hy_ge
      · have h10 : (1 : K) = 0 := by linear_combination h0 - hy0
        exact one_ne_zero h10
      · omega
    let w_K : Kˣ := Units.mk0 (1 + y_K) hy_K_ne
    let u_norm : M_Cˣ := Units.map (normLM F hM_CK) w_K
    have hν_u_norm : ((ν_all j) u_norm : Ω F) = 1 := by
      rw [(hν_props j).2.2.2.2.2.1 u_norm ⟨w_K, rfl⟩, Units.val_one]
    let z_norm : M_C := normLM F hM_CK (1 + y_K) - 1
    let e_z : M_C :=
      normLM F hM_CK (1 + y_K) - (1 + P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C))
    have hz_norm_1 : 1 + z_norm = (u_norm : M_C) := by
      change 1 + (normLM F hM_CK (1 + y_K) - 1) = normLM F hM_CK (1 + y_K)
      ring
    have hz_norm_ne : 1 + z_norm ≠ 0 := by
      rw [hz_norm_1]; exact Units.ne_zero u_norm
    have hu_norm_mk0 : Units.mk0 (1 + z_norm) hz_norm_ne = u_norm := Units.ext hz_norm_1
    have hz_norm_decomp : z_norm = P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C) + e_z := by
      dsimp only [z_norm, e_z]; ring
    have hPϖ_val : P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C) = 0 ∨
        (t : ℤ) ≤ valL F M_C (P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C)) := by
      have h := hval_mul_ge M_C 0 (t : ℤ) (P_poly z) ((ϖ_MC ^ t : M_Cˣ) : M_C)
        (hPz_int z hz_int) (Or.inr (le_of_eq hϖ_MC_pow_val.symm))
      simpa using h
    have he_z_t1 : e_z = 0 ∨ (t + 1 : ℤ) ≤ valL F M_C e_z := hP_norm z hz_int
    have he_z_t : e_z = 0 ∨ (t : ℤ) ≤ valL F M_C e_z := by
      rcases he_z_t1 with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hz_norm_val : z_norm = 0 ∨ (t : ℤ) ≤ valL F M_C z_norm := by
      rw [hz_norm_decomp]
      exact hvalMC.2.2.2.2.2.2.2.1 (t : ℤ) _ _ hPϖ_val he_z_t
    have hstat := hν_stat j z_norm hz_norm_val hz_norm_ne
    rw [hu_norm_mk0, hν_u_norm, hz_norm_decomp, mul_add, AddChar.map_add_eq_mul,
      hψMC_call_triv j e_z he_z_t1, mul_one] at hstat
    rw [hu_all_mul j (P_poly z)]
    exact hstat.symm

  have hu_all_cong : ∀ j₁ j₂ : Fin (q - 1),
      ((u_all j₁ : M_C) - (u_all j₂ : M_C) = 0 ∨
        1 ≤ valL F M_C ((u_all j₁ : M_C) - (u_all j₂ : M_C))) →
      ∀ w ∈ unitGroup F M_C t, (ν_all j₁) w = (ν_all j₂) w := by
    intro j₁ j₂ hdiff w hw
    let z : M_C := (w : M_C) - 1
    have hz_1 : 1 + z = (w : M_C) := by dsimp only [z]; ring
    have hz : 1 + z ≠ 0 := by rw [hz_1]; exact Units.ne_zero w
    have hw_mk0 : Units.mk0 (1 + z) hz = w := Units.ext hz_1
    have hz_t : z = 0 ∨ (t : ℤ) ≤ valL F M_C z := by
      rcases (hvalMC.2.2.2.2.2.2.2.2.2.1 t ht_ge1 w).mp hw with hw1 | hge
      · left; dsimp only [z]; rw [hw1, sub_self]
      · exact Or.inr hge
    let z₁ : M_C := z * ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C))
    have hz₁_mul : z₁ * ((ϖ_MC ^ t : M_Cˣ) : M_C) = z := by
      dsimp only [z₁]
      rw [mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, mul_one]
    have hϖ_inv_val : valL F M_C ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C)) = -(t : ℤ) := by
      rw [hvalMC.2.2.2.2.2.1 (ϖ_MC ^ t), hϖ_MC_pow_val]
    have hz₁_int : z₁ = 0 ∨ 0 ≤ valL F M_C z₁ := by
      have h := hval_mul_ge M_C (t : ℤ) (-(t : ℤ)) z ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C))
        hz_t (Or.inr (le_of_eq hϖ_inv_val.symm))
      simpa [z₁] using h
    let δ : M_C := (((c₁_MC⁻¹ : M_Cˣ) : M_C) * (((u_all j₁ : M_C) - (u_all j₂ : M_C)) * z₁))
    have h_decomp : ((((c_all j₁)⁻¹ : M_Cˣ) : M_C) * z) =
        ((((c_all j₂)⁻¹ : M_Cˣ) : M_C) * z) + δ := by
      have hm1 := hu_all_mul j₁ z₁
      have hm2 := hu_all_mul j₂ z₁
      rw [hz₁_mul] at hm1 hm2
      change (((c₁_MC⁻¹ : M_Cˣ) : M_C) * ((u_all j₁ : M_C) * z₁)) = _ at hm1
      change (((c₁_MC⁻¹ : M_Cˣ) : M_C) * ((u_all j₂ : M_C) * z₁)) = _ at hm2
      rw [← hm1, ← hm2]
      dsimp only [δ]
      ring
    have hδ_psi : (traceChar F hLM_C ψ) δ = 1 := by
      apply hSpecMC.1
      have hc₁_inv_val : valL F M_C (((c₁_MC⁻¹ : M_Cˣ) : M_C)) =
          -((k : ℤ) * (1 + condExpChar F L ψ)) := by
        rw [hvalMC.2.2.2.2.2.1 c₁_MC, hc₁_MC_val]
      have hdu_z₁ := hval_mul_ge M_C 1 0
        ((u_all j₁ : M_C) - (u_all j₂ : M_C)) z₁ hdiff hz₁_int
      have hmul : δ = 0 ∨ -((k : ℤ) * (1 + condExpChar F L ψ)) + (1 + 0) ≤ valL F M_C δ :=
        hval_mul_ge M_C (-((k : ℤ) * (1 + condExpChar F L ψ))) (1 + 0)
          (((c₁_MC⁻¹ : M_Cˣ) : M_C)) (((u_all j₁ : M_C) - (u_all j₂ : M_C)) * z₁)
          (Or.inr (le_of_eq hc₁_inv_val.symm)) hdu_z₁
      rcases hmul with h0 | hge
      · exact Or.inl h0
      · right
        have hk_expand : (k : ℤ) * (1 + condExpChar F L ψ) =
            (k : ℤ) * condExpChar F L ψ + (k : ℤ) := by ring
        omega
    apply Units.ext
    rw [← hw_mk0, hν_stat j₁ z hz_t hz, hν_stat j₂ z hz_t hz,
      h_decomp, AddChar.map_add_eq_mul, hδ_psi, mul_one]

  
  obtain ⟨h_gen_vec, hh_gen⟩ :=
    ld_ch14_wild_tower_norm_coset_generators F r_exp hr_exp_pos M_C K hM_CK
      hGalMCK hq_pow hValNormK hValAlgK hFrobSurjMC (t + 1) (by omega)

  have hν_inj_t : ∀ j₁ j₂ : Fin (q - 1),
      (∀ w ∈ unitGroup F M_C t, (ν_all j₁) w = (ν_all j₂) w) → j₁ = j₂ := by
    have hp : Nat.Prime (p F) := CharP.prime_ringChar 𝓀[F]
    have hp_pos : 0 < p F := hp.pos
    have hp_gt1 : 1 < p F := hp.one_lt
    have hq_eq : q = (p F) ^ r_exp := hq_pow
    have hq_gt1 : 1 < q := by
      rw [hq_eq]
      exact one_lt_pow₀ hp_gt1 (by omega)
    let j₀ : Fin (q - 1) := ⟨0, by omega⟩
    have hex_x₀ : ∃ x₀ : M_Cˣ, (ν_all j₀) x₀ ≠ 1 := by
      by_contra hall
      push_neg at hall
      apply (hν_props j₀).1
      exact MonoidHom.ext hall
    obtain ⟨x₀, hx₀⟩ := hex_x₀
    let ζ₀ : (Ω F)ˣ := (ν_all j₀) x₀
    have hζ₀_pow : ζ₀ ^ (p F) = 1 := by
      change ((ν_all j₀) x₀) ^ (p F) = 1
      rw [← MonoidHom.pow_apply, (hν_props j₀).2.1, MonoidHom.one_apply]
    haveI : Fact (Nat.Prime (p F)) := ⟨hp⟩
    have hζ₀_ord : orderOf ζ₀ = p F := orderOf_eq_prime hζ₀_pow hx₀
    have hζ₀_inj : Function.Injective (fun i : Fin (p F) => (ζ₀ ^ (i : ℕ) : Ω F)) := by
      intro i₁ i₂ heq
      have hu : ζ₀ ^ (i₁ : ℕ) = ζ₀ ^ (i₂ : ℕ) := Units.ext heq
      have hi₁ : (i₁ : ℕ) ∈ Set.Iio (orderOf ζ₀) := by
        rw [Set.mem_Iio, hζ₀_ord]
        exact i₁.2
      have hi₂ : (i₂ : ℕ) ∈ Set.Iio (orderOf ζ₀) := by
        rw [Set.mem_Iio, hζ₀_ord]
        exact i₂.2
      exact Fin.ext (pow_injOn_Iio_orderOf hi₁ hi₂ hu)
    have hζ₀_roots : ∀ ξ : (Ω F)ˣ, ξ ^ (p F) = 1 → ∃ i : Fin (p F), ξ = ζ₀ ^ (i : ℕ) := by
      intro ξ hξ
      let P_X : Polynomial (Ω F) := Polynomial.X ^ (p F) - 1
      have hP_ne0 : P_X ≠ 0 := by
        simpa [P_X] using Polynomial.X_pow_sub_C_ne_zero hp_pos (1 : Ω F)
      have hP_deg : P_X.natDegree = p F := by
        simpa [P_X] using Polynomial.natDegree_X_pow_sub_C (n := p F) (r := (1 : Ω F))
      let S_ζ : Finset (Ω F) := Finset.univ.image (fun i : Fin (p F) => (ζ₀ ^ (i : ℕ) : Ω F))
      have hS_card : S_ζ.card = p F := by
        rw [Finset.card_image_of_injective _ hζ₀_inj, Finset.card_univ, Fintype.card_fin]
      have h_mem_roots : ∀ z : Ω F, z ^ (p F) = 1 → z ∈ P_X.roots := by
        intro z hz
        rw [Polynomial.mem_roots hP_ne0, Polynomial.IsRoot.def]
        simp [P_X, hz]
      have hξ_val : (ξ : Ω F) ^ (p F) = 1 := by
        rw [← Units.val_pow_eq_pow_val, hξ, Units.val_one]
      by_cases hmem : (ξ : Ω F) ∈ S_ζ
      · rw [Finset.mem_image] at hmem
        rcases hmem with ⟨i, _, hi⟩
        exact ⟨i, Units.ext hi.symm⟩
      · exfalso
        let S' : Finset (Ω F) := insert (ξ : Ω F) S_ζ
        have hS'_sub : S'.val ⊆ P_X.roots := by
          intro z hz
          rw [← Finset.mem_def, Finset.mem_insert] at hz
          rcases hz with rfl | hz
          · exact h_mem_roots (ξ : Ω F) hξ_val
          · rw [Finset.mem_image] at hz
            rcases hz with ⟨i, _, rfl⟩
            apply h_mem_roots
            rw [← pow_mul, mul_comm, pow_mul, ← Units.val_pow_eq_pow_val, hζ₀_pow, Units.val_one, one_pow]
        have hle := Polynomial.card_le_degree_of_subset_roots hS'_sub
        rw [Finset.card_insert_of_notMem hmem, hS_card, hP_deg] at hle
        omega
    have hθ_eq_of_h : ∀ (θ₁ θ₂ : M_Cˣ →* (Ω F)ˣ),
        (∀ w ∈ Set.range (Units.map (normLM F hM_CK)), θ₁ w = 1) →
        (∀ u ∈ unitGroup F M_C (t + 1), θ₁ u = 1) →
        (∀ w ∈ Set.range (Units.map (normLM F hM_CK)), θ₂ w = 1) →
        (∀ u ∈ unitGroup F M_C (t + 1), θ₂ u = 1) →
        (∀ s : Fin r_exp, θ₁ (h_gen_vec s) = θ₂ (h_gen_vec s)) →
        θ₁ = θ₂ := by
      intro θ₁ θ₂ hN₁ hU₁ hN₂ hU₂ h_eq
      apply MonoidHom.ext
      intro x
      obtain ⟨e, w, hu⟩ := hh_gen x
      set n := Units.map (normLM F hM_CK) w
      have hnN : n ∈ Set.range (Units.map (normLM F hM_CK)) := ⟨w, rfl⟩
      set P_e := (∏ s : Fin r_exp, (h_gen_vec s) ^ (e s : ℕ)) * n
      have h₁ : θ₁ (x * P_e⁻¹) = 1 := hU₁ (x * P_e⁻¹) hu
      have h₂ : θ₂ (x * P_e⁻¹) = 1 := hU₂ (x * P_e⁻¹) hu
      rw [map_mul, map_inv, mul_inv_eq_one] at h₁ h₂
      rw [h₁, h₂]
      dsimp only [P_e]
      rw [map_mul, map_mul, hN₁ n hnN, hN₂ n hnN, mul_one, mul_one, map_prod, map_prod]
      congr 1
      ext s
      rw [map_pow, map_pow, h_eq s]
    let θ_opt : Option (Fin (q - 1)) → (M_Cˣ →* (Ω F)ˣ) := fun o =>
      match o with
      | none => 1
      | some j => ν_all j
    have hθ_opt_pow : ∀ o s, ((θ_opt o) (h_gen_vec s)) ^ (p F) = 1 := by
      intro o s
      cases o with
      | none => simp [θ_opt]
      | some j =>
        change ((ν_all j) (h_gen_vec s)) ^ (p F) = 1
        rw [← MonoidHom.pow_apply, (hν_props j).2.1, MonoidHom.one_apply]
    have hθ_opt_N : ∀ o, ∀ w ∈ Set.range (Units.map (normLM F hM_CK)), (θ_opt o) w = 1 := by
      intro o w hw
      cases o with
      | none => rfl
      | some j => exact (hν_props j).2.2.2.2.2.1 w hw
    have hθ_opt_U : ∀ o, ∀ u ∈ unitGroup F M_C (t + 1), (θ_opt o) u = 1 := by
      intro o u hu
      cases o with
      | none => rfl
      | some j => exact hν_triv_t1 j u hu
    let d : Option (Fin (q - 1)) → (Fin r_exp → Fin (p F)) :=
      fun o s => Classical.choose (hζ₀_roots ((θ_opt o) (h_gen_vec s)) (hθ_opt_pow o s))
    have hd_spec : ∀ o s, (θ_opt o) (h_gen_vec s) = ζ₀ ^ (d o s : ℕ) :=
      fun o s => Classical.choose_spec (hζ₀_roots ((θ_opt o) (h_gen_vec s)) (hθ_opt_pow o s))
    have hd_inj : Function.Injective d := by
      intro o₁ o₂ hd_eq
      have hθ_eq : θ_opt o₁ = θ_opt o₂ := by
        apply hθ_eq_of_h (θ_opt o₁) (θ_opt o₂) (hθ_opt_N o₁) (hθ_opt_U o₁) (hθ_opt_N o₂) (hθ_opt_U o₂)
        intro s
        rw [hd_spec o₁ s, hd_spec o₂ s, congr_fun hd_eq s]
      cases o₁ with
      | none =>
        cases o₂ with
        | none => rfl
        | some j₂ =>
          exfalso
          exact (hν_props j₂).1 hθ_eq.symm
      | some j₁ =>
        cases o₂ with
        | none =>
          exfalso
          exact (hν_props j₁).1 hθ_eq
        | some j₂ =>
          exact congrArg some (hν_inj hθ_eq)
    have hcard_eq : Fintype.card (Option (Fin (q - 1))) = Fintype.card (Fin r_exp → Fin (p F)) := by
      rw [Fintype.card_option, Fintype.card_fin, Fintype.card_fun, Fintype.card_fin, Fintype.card_fin]
      omega
    have hd_bij : Function.Bijective d :=
      (Fintype.bijective_iff_injective_and_card d).mpr ⟨hd_inj, hcard_eq⟩
    intro j₁ j₂ hw_eq
    by_contra hne
    let θ : M_Cˣ →* (Ω F)ˣ := (ν_all j₁) * (ν_all j₂)⁻¹
    have hθ_ne1 : θ ≠ 1 := by
      intro h1
      apply hne
      apply hν_inj
      exact mul_inv_eq_one.mp h1
    have hθ_pow : ∀ s, (θ (h_gen_vec s)) ^ (p F) = 1 := by
      intro s
      change ((ν_all j₁) (h_gen_vec s) * ((ν_all j₂) (h_gen_vec s))⁻¹) ^ (p F) = 1
      rw [mul_pow, inv_pow, ← MonoidHom.pow_apply, ← MonoidHom.pow_apply,
        (hν_props j₁).2.1, (hν_props j₂).2.1, MonoidHom.one_apply, inv_one, mul_one]
    have hθ_N : ∀ w ∈ Set.range (Units.map (normLM F hM_CK)), θ w = 1 := by
      intro w hw
      change (ν_all j₁) w * ((ν_all j₂) w)⁻¹ = 1
      rw [(hν_props j₁).2.2.2.2.2.1 w hw, (hν_props j₂).2.2.2.2.2.1 w hw, inv_one, mul_one]
    have hθ_U : ∀ u ∈ unitGroup F M_C (t + 1), θ u = 1 := by
      intro u hu
      change (ν_all j₁) u * ((ν_all j₂) u)⁻¹ = 1
      rw [hν_triv_t1 j₁ u hu, hν_triv_t1 j₂ u hu, inv_one, mul_one]
    let d_θ : Fin r_exp → Fin (p F) :=
      fun s => Classical.choose (hζ₀_roots (θ (h_gen_vec s)) (hθ_pow s))
    have hd_θ_spec : ∀ s, θ (h_gen_vec s) = ζ₀ ^ (d_θ s : ℕ) :=
      fun s => Classical.choose_spec (hζ₀_roots (θ (h_gen_vec s)) (hθ_pow s))
    obtain ⟨o, ho⟩ := hd_bij.2 d_θ
    have hθ_opt_eq : θ_opt o = θ := by
      apply hθ_eq_of_h (θ_opt o) θ (hθ_opt_N o) (hθ_opt_U o) hθ_N hθ_U
      intro s
      rw [hd_spec o s, hd_θ_spec s, congr_fun ho s]
    cases o with
    | none =>
      exact hθ_ne1 hθ_opt_eq.symm
    | some j₃ =>
      obtain ⟨u₀, hu₀_mem, hu₀_ne1⟩ := hν_nontriv_t j₃
      apply hu₀_ne1
      have h_eval : (ν_all j₃) u₀ = θ u₀ := congrFun (congrArg DFunLike.coe hθ_opt_eq) u₀
      rw [h_eval]
      change (ν_all j₁) u₀ * ((ν_all j₂) u₀)⁻¹ = 1
      rw [hw_eq u₀ hu₀_mem, mul_inv_cancel]

  refine ⟨c'_χ', c'_μ, u_all, hc_L_val, hc₁_val, hc_L_half, hc_L_top, hc_μ_props,
    hu_all_def, hu_all_prod, hu_all_val, hu_all_P, ?_⟩
  intro j₁ j₂ hdiff
  exact hν_inj_t j₁ j₂ (hu_all_cong j₁ j₂ hdiff)

theorem ld_ch14_top_level_conductor_and_orbit_norm_filtration (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (σ_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      (M_C ≃ₐ[F] M_C))
    (idx_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      Fin D_orb.length)
    (hσ_val : ∀ j (z : M_C), valL F M_C ((σ_all j) z) = valL F M_C z)
    (hν_prod : ∀ (c_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ),
      ∏ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1),
        Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
          (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
            (c_orb (idx_all j))) =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
          (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c_orb i)))
    (k : ℕ) (hk_ge1 : 1 ≤ k)
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hValAlgFiMC : ∀ i : Fin D_orb.length, ∀ x : (D_orb.get i).field,
      valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
        valL F (D_orb.get i).field x)
    (hval_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
      (∀ u : Mˣ, u ∈ unitGroup F M 0 ↔ valL F M (u : M) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
      (∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0)) :
    (∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F))
      (hψM_triv : ∀ x : M, (x = 0 ∨ -condExpChar F M ψ_M ≤ valL F M x) → ψ_M x = 1)
      (hψM_nontriv : ∃ x₁ : M, x₁ ≠ 0 ∧ -(condExpChar F M ψ_M + 1) ≤ valL F M x₁ ∧ ψ_M x₁ ≠ 1)
      (θ : Mˣ →* (Ω F)ˣ)
      (hθ_cond : ∀ u ∈ unitGroup F M (condExp F M θ), θ u = 1)
      (m : ℕ) (hm_ge2 : 2 ≤ m) (c' : Mˣ)
      (hc'_val : valL F M (c' : M) = (m : ℤ) + condExpChar F M ψ_M)
      (hc'_top : ∀ x : M, (x = 0 ∨ ((m - 1 : ℕ) : ℤ) ≤ valL F M x) →
        ∀ hx : 1 + x ≠ 0,
          (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_M (((c'⁻¹ : Mˣ) : M) * x)),
      condExp F M θ = m) ∧
    (∀ (i : Fin D_orb.length) (m : ℕ), 1 ≤ m →
      ∀ u ∈ unitGroup F (D_orb.get i).field (k * (m - 1) + 1),
        Units.map (normLM F (D_orb.get i).le) u ∈ unitGroup F L m) :=
by
  refine ⟨?_, ?_⟩
  · intro M _ ψ_M hψM_triv hψM_nontriv θ hθ_cond m hm_ge2 c' hc'_val hc'_top
    obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, _,
      _, hunit0, hunit_ge1, hunit_val0⟩ := hval_all M
    have hunit_anti : ∀ {a₁ a₂ : ℕ}, a₁ ≤ a₂ → unitGroup F M a₂ ≤ unitGroup F M a₁ := by
      intro a₁ a₂ hle u hu
      by_cases ha₁ : a₁ = 0
      · rw [ha₁, hunit0]
        exact hunit_val0 a₂ u hu
      · have ha₁_pos : 1 ≤ a₁ := by omega
        have ha₂_pos : 1 ≤ a₂ := by omega
        rw [hunit_ge1 a₁ ha₁_pos]
        rcases (hunit_ge1 a₂ ha₂_pos u).mp hu with hu1 | hua₂
        · exact Or.inl hu1
        · exact Or.inr (by omega)
    have hθ_triv_m : ∀ u ∈ unitGroup F M m, θ u = 1 := by
      intro u hu
      rcases (hunit_ge1 m (by omega) u).mp hu with hu1 | hum
      · have hu_eq : u = 1 := Units.ext hu1
        rw [hu_eq, map_one]
      · by_cases hx0 : (u : M) - 1 = 0
        · have hu_eq : u = 1 := Units.ext (sub_eq_zero.mp hx0)
          rw [hu_eq, map_one]
        · set x : M := (u : M) - 1
          have hx1 : 1 + x ≠ 0 := by
            have heq : 1 + x = (u : M) := by dsimp [x]; ring
            rw [heq]
            exact Units.ne_zero u
          have hmk : Units.mk0 (1 + x) hx1 = u := by
            apply Units.ext
            change 1 + x = (u : M)
            dsimp [x]
            ring
          have htop := hc'_top x (Or.inr (by omega)) hx1
          rw [hmk] at htop
          have hcinv_ne : ((c'⁻¹ : Mˣ) : M) ≠ 0 := Units.ne_zero c'⁻¹
          have hval_prod : -condExpChar F M ψ_M ≤ valL F M (((c'⁻¹ : Mˣ) : M) * x) := by
            rw [hval_mul _ _ hcinv_ne hx0, hval_inv c', hc'_val]
            omega
          have hψ1 : ψ_M (((c'⁻¹ : Mˣ) : M) * x) = 1 := hψM_triv _ (Or.inr hval_prod)
          rw [hψ1] at htop
          exact Units.ext htop
    have hle_m : condExp F M θ ≤ m := Nat.sInf_le hθ_triv_m
    obtain ⟨x₁, hx₁_ne0, hx₁_val, hx₁_ψ⟩ := hψM_nontriv
    let x₀ : M := (c' : M) * x₁
    have hx₀_ne0 : x₀ ≠ 0 := mul_ne_zero (Units.ne_zero c') hx₁_ne0
    have hx₀_val : ((m - 1 : ℕ) : ℤ) ≤ valL F M x₀ := by
      dsimp [x₀]
      rw [hval_mul _ _ (Units.ne_zero c') hx₁_ne0, hc'_val]
      omega
    have hx₀_ge1 : (1 : ℤ) ≤ valL F M x₀ := by omega
    have h1x₀ : 1 + x₀ ≠ 0 := by
      intro h0
      have hx₀_eq : x₀ = -1 := eq_neg_of_add_eq_zero_right h0
      rw [hx₀_eq, hval_neg1] at hx₀_ge1
      omega
    let u₀ : Mˣ := Units.mk0 (1 + x₀) h1x₀
    have hu₀_mem : u₀ ∈ unitGroup F M (m - 1) := by
      rw [hunit_ge1 (m - 1) (by omega)]
      right
      have hsub : (u₀ : M) - 1 = x₀ := by change (1 + x₀) - 1 = x₀; ring
      rw [hsub]
      exact hx₀_val
    have hθ_u₀ : (θ u₀ : Ω F) ≠ 1 := by
      have htop := hc'_top x₀ (Or.inr hx₀_val) h1x₀
      change (θ u₀ : Ω F) = ψ_M (((c'⁻¹ : Mˣ) : M) * ((c' : M) * x₁)) at htop
      have hmul_c : ((c'⁻¹ : Mˣ) : M) * ((c' : M) * x₁) = x₁ := by
        rw [← mul_assoc, Units.inv_mul, one_mul]
      rw [hmul_c] at htop
      rw [htop]
      exact hx₁_ψ
    have hm_le : m ≤ condExp F M θ := by
      by_contra hlt
      have hle_m1 : condExp F M θ ≤ m - 1 := by omega
      have hu₀_cond : u₀ ∈ unitGroup F M (condExp F M θ) := hunit_anti hle_m1 hu₀_mem
      have h1 : θ u₀ = 1 := hθ_cond u₀ hu₀_cond
      exact hθ_u₀ (by rw [h1, Units.val_one])
    exact le_antisymm hle_m hm_le
  · intro i m hm u hu
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    obtain ⟨_, _, _, _, _, _, _, _, _, hunit_ge1_L, _⟩ := hval_all L
    obtain ⟨_, _, _, _, _, _, _, _, _, hunit_ge1_MC, _⟩ := hval_all M_C
    obtain ⟨_, _, _, _, _, _, _, _, _, hunit_ge1_Fi, _⟩ := hval_all (D_orb.get i).field
    set r : ℕ := k * (m - 1) + 1
    have hr : 1 ≤ r := by omega
    have hσ_symm_val : ∀ j (z : M_C), valL F M_C ((σ_all j).symm z) = valL F M_C z := by
      intro j z
      have h1 := hσ_val j ((σ_all j).symm z)
      rw [AlgEquiv.apply_symm_apply] at h1
      exact h1.symm
    let c_single : ∀ i' : Fin D_orb.length, ((D_orb.get i').field)ˣ :=
      fun i' => if h : i' = i then h ▸ u else 1
    have hc_single_mem : ∀ i' : Fin D_orb.length,
        Units.map (IntermediateField.inclusion (hFiMC i')).toMonoidHom (c_single i') ∈
          unitGroup F M_C r := by
      intro i'
      rcases eq_or_ne i' i with rfl | hne
      · have hcs : c_single i' = u := dif_pos rfl
        rw [hcs, hunit_ge1_MC r hr]
        rcases (hunit_ge1_Fi r hr u).mp hu with hu1 | hur
        · left
          change IntermediateField.inclusion (hFiMC i') (u : (D_orb.get i').field) = 1
          rw [hu1, map_one]
        · right
          change (r : ℤ) ≤ valL F M_C (IntermediateField.inclusion (hFiMC i') (u : (D_orb.get i').field) - 1)
          rw [← map_one (IntermediateField.inclusion (hFiMC i')), ← map_sub,
            hValAlgFiMC i' ((u : (D_orb.get i').field) - 1)]
          exact hur
      · have hcs : c_single i' = 1 := dif_neg hne
        rw [hcs, map_one]
        exact Subgroup.one_mem _
    have hσ_symm_mem : ∀ j (w : M_Cˣ), w ∈ unitGroup F M_C r →
        Units.map (σ_all j).symm.toRingEquiv.toMonoidHom w ∈ unitGroup F M_C r := by
      intro j w hw
      rw [hunit_ge1_MC r hr] at hw ⊢
      rcases hw with hw1 | hwr
      · left
        change (σ_all j).symm (w : M_C) = 1
        rw [hw1, map_one]
      · right
        change (r : ℤ) ≤ valL F M_C ((σ_all j).symm (w : M_C) - 1)
        rw [← map_one (σ_all j).symm, ← map_sub, hσ_symm_val j ((w : M_C) - 1)]
        exact hwr
    have hlhs_mem :
        (∏ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1),
          Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
            (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
              (c_single (idx_all j)))) ∈ unitGroup F M_C r :=
      Subgroup.prod_mem _ fun j _ => hσ_symm_mem j _ (hc_single_mem (idx_all j))
    have hprod_rhs :
        (∏ i' : Fin D_orb.length, Units.map (normLM F (D_orb.get i').le) (c_single i')) =
          Units.map (normLM F (D_orb.get i).le) u := by
      rw [Finset.prod_eq_single i]
      · have hcs : c_single i = u := dif_pos rfl
        rw [hcs]
      · intro i' _ hne
        have hcs : c_single i' = 1 := dif_neg hne
        rw [hcs, map_one]
      · intro hi
        exact False.elim (hi (Finset.mem_univ i))
    rw [hν_prod c_single, hprod_rhs] at hlhs_mem
    let v : Lˣ := Units.map (normLM F (D_orb.get i).le) u
    change Units.map (IntermediateField.inclusion hLM_C).toMonoidHom v ∈ unitGroup F M_C r at hlhs_mem
    rw [hunit_ge1_L m hm]
    rcases (hunit_ge1_MC r hr _).mp hlhs_mem with hv1 | hvr
    · left
      apply (IntermediateField.inclusion hLM_C).injective
      rw [map_one]
      exact hv1
    · right
      change (r : ℤ) ≤ valL F M_C (IntermediateField.inclusion hLM_C (v : L) - 1) at hvr
      rw [← map_one (IntermediateField.inclusion hLM_C), ← map_sub,
        hValAlgMCL ((v : L) - 1)] at hvr
      have hcast : (r : ℤ) = (k : ℤ) * ((m - 1 : ℕ) : ℤ) + 1 := by
        simp [r]
      rw [hcast] at hvr
      change (m : ℤ) ≤ valL F L ((v : L) - 1)
      by_contra hlt
      have hle_m1 : valL F L ((v : L) - 1) ≤ ((m - 1 : ℕ) : ℤ) := by omega
      have hmul_le : (k : ℤ) * valL F L ((v : L) - 1) ≤ (k : ℤ) * ((m - 1 : ℕ) : ℤ) :=
        mul_le_mul_of_nonneg_left hle_m1 (by omega)
      omega

theorem ld_ch14_twisted_orbit_norm_pullback_top_stat (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    (hLM_C : L ≤ M_C)
    (hGalMC : IsGaloisExt F L M_C)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hψFi : ∀ i : Fin D_orb.length,
      IsAdmissibleChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ))
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (hχ'_cond : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1)
    (k : ℕ) (hk_ge1 : 1 ≤ k)
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hTrBoundMCL : ∀ (m : ℤ) (z : M_C),
      (z = 0 ∨ (k : ℤ) * m - ((k : ℤ) - 1) ≤ valL F M_C z) →
      (traceLM F hLM_C z = 0 ∨ m ≤ valL F L (traceLM F hLM_C z)))
    (hnMC : condExpChar F M_C (traceChar F hLM_C ψ) =
      (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1))
    (hFi_ram_pull : ∀ i : Fin D_orb.length,
      (∀ x : (D_orb.get i).field,
        valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
          valL F (D_orb.get i).field x) ∧
      (∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
        (traceLM F (hFiMC i) z = 0 ∨ m ≤ valL F (D_orb.get i).field (traceLM F (hFiMC i) z))) ∧
      (∀ z : M_C, (z = 0 ∨ 1 ≤ valL F M_C z) →
        normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z) = 0 ∨
          2 * valL F M_C z ≤
            valL F (D_orb.get i).field
              (normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z))) ∧
      condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) =
        (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1))
    (c'_χ' : Lˣ)
    (hc_L_top : ∀ x : L, (x = 0 ∨ ((condExp F L χ' - 1 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c'_χ'⁻¹ : Lˣ) : L) * x))
    (hNormFilt_a : ∀ i : Fin D_orb.length,
      ∀ u ∈ unitGroup F (D_orb.get i).field (k * (condExp F L χ' - 1) + 1),
        Units.map (normLM F (D_orb.get i).le) u ∈ unitGroup F L (condExp F L χ'))
    (hval_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
      (∀ u : Mˣ, u ∈ unitGroup F M 0 ↔ valL F M (u : M) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
      (∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0))
    (hSpec_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      (∀ x : M, (x = 0 ∨ -condExpChar F M ψ_M ≤ valL F M x) → ψ_M x = 1) ∧
      (∃ x₁ : M, x₁ ≠ 0 ∧ -(condExpChar F M ψ_M + 1) ≤ valL F M x₁ ∧ ψ_M x₁ ≠ 1)) :
    ∀ (i : Fin D_orb.length),
      let F_i := (D_orb.get i).field
      let ψ_Fi := traceChar F (D_orb.get i).le ψ
      let c'_χ'_Fi : F_iˣ :=
        Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c'_χ'
      ∀ x : F_i, (x = 0 ∨ ((k * (condExp F L χ' - 1) : ℕ) : ℤ) ≤ valL F F_i x) →
        ∀ hx : 1 + x ≠ 0,
          ((χ'.comp (Units.map (normLM F (D_orb.get i).le))) (Units.mk0 (1 + x) hx) : Ω F) =
            ψ_Fi (((c'_χ'_Fi⁻¹ : F_iˣ) : F_i) * x) :=
by
  have htrace_inc_mul : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (hAB : A ≤ B) (x : A) (z : B),
      traceLM F hAB (IntermediateField.inclusion hAB x * z) = x * traceLM F hAB z := by
    intro A B hAB x z
    let B' := IntermediateField.extendScalars hAB
    letI : Module A A := Semiring.toModule
    have hsmul : toExtendScalars F hAB (IntermediateField.inclusion hAB x * z) =
        x • toExtendScalars F hAB z := by
      rw [map_mul, Algebra.smul_def]
      rfl
    change (Algebra.trace A B') (toExtendScalars F hAB (IntermediateField.inclusion hAB x * z)) =
      x * (Algebra.trace A B') (toExtendScalars F hAB z)
    rw [hsmul]
    exact (Algebra.trace A B').map_smul' x (toExtendScalars F hAB z)

  have htrace_trans_aux : ∀ (K₀ A B C : Type u) [Field K₀] [Field A] [Field B] [Field C]
      [Algebra K₀ A] [Algebra K₀ B] [Algebra K₀ C]
      (algAB : Algebra A B) (algBC : Algebra B C) (algAC : Algebra A C)
      (h1 : ∀ x : K₀, @algebraMap A B _ _ algAB (algebraMap K₀ A x) = algebraMap K₀ B x)
      (h2 : ∀ x : A, @algebraMap B C _ _ algBC (@algebraMap A B _ _ algAB x) =
        @algebraMap A C _ _ algAC x)
      [FiniteDimensional K₀ B] (z : C),
      @Algebra.trace A C _ _ algAC z =
        @Algebra.trace A B _ _ algAB (@Algebra.trace B C _ _ algBC z) := by
    intro K₀ A B C _ _ _ _ _ _ _ algAB algBC algAC h1 h2 _ z
    letI : Algebra A B := algAB
    letI : Algebra B C := algBC
    letI : Algebra A C := algAC
    haveI : IsScalarTower K₀ A B := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h1 x).symm)
    haveI : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h2 x).symm)
    haveI : FiniteDimensional A B := Module.Finite.of_restrictScalars_finite K₀ A B
    by_cases hFin : FiniteDimensional B C
    · exact (Algebra.trace_trace z).symm
    · have htr1 : Algebra.trace B C = 0 := by
        apply Algebra.trace_eq_zero_of_not_exists_basis
        rintro ⟨s, ⟨b⟩⟩
        exact hFin (Module.Finite.of_basis b)
      have htr2 : Algebra.trace A C = 0 := by
        apply Algebra.trace_eq_zero_of_not_exists_basis
        rintro ⟨s, ⟨b⟩⟩
        haveI : Module.Finite A C := Module.Finite.of_basis b
        exact hFin (Module.Finite.of_restrictScalars_finite A B C)
      simp [htr1, htr2]

  have htrace_eq_inclusion : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (h : A ≤ B) (y : B),
      @Algebra.trace A B _ _ (IntermediateField.inclusion h).toAlgebra y = traceLM F h y := by
    intro A B h y
    letI : Algebra A B := (IntermediateField.inclusion h).toAlgebra
    let e : B ≃ₐ[A] IntermediateField.extendScalars h := {
      toFun := toExtendScalars F h
      invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl
    }
    exact (Algebra.trace_eq_of_algEquiv e y).symm

  have htrace_trans : ∀ {A B C : IntermediateField F (AlgebraicClosure F)} [FiniteDimensional F B]
      (hAB : A ≤ B) (hBC : B ≤ C) (hAC : A ≤ C) (z : C),
      traceLM F hAC z = traceLM F hAB (traceLM F hBC z) := by
    intro A B C _ hAB hBC hAC z
    have hEq : hAC = hAB.trans hBC := Subsingleton.elim _ _
    subst hEq
    rw [← htrace_eq_inclusion (hAB.trans hBC) z,
        ← htrace_eq_inclusion hBC z,
        ← htrace_eq_inclusion hAB]
    exact htrace_trans_aux F A B C
      (IntermediateField.inclusion hAB).toAlgebra
      (IntermediateField.inclusion hBC).toAlgebra
      (IntermediateField.inclusion (hAB.trans hBC)).toAlgebra
      (fun _ => rfl)
      (fun _ => rfl)
      z

  have htraceChar_trans : ∀ {A B C : IntermediateField F (AlgebraicClosure F)} [FiniteDimensional F B]
      (hAB : A ≤ B) (hBC : B ≤ C) (hAC : A ≤ C) (ψA : AddChar A (Ω F)),
      traceChar F hAC ψA = traceChar F hBC (traceChar F hAB ψA) := by
    intro A B C _ hAB hBC hAC ψA
    ext z
    simp [traceChar, htrace_trans hAB hBC hAC z]

  have hnorm_trans_aux : ∀ (K₀ A B C : Type u) [Field K₀] [Field A] [Field B] [Field C]
      [Algebra K₀ A] [Algebra K₀ B] [Algebra K₀ C]
      (algAB : Algebra A B) (algBC : Algebra B C) (algAC : Algebra A C)
      (h1 : ∀ x : K₀, @algebraMap A B _ _ algAB (algebraMap K₀ A x) = algebraMap K₀ B x)
      (h2 : ∀ x : A, @algebraMap B C _ _ algBC (@algebraMap A B _ _ algAB x) =
        @algebraMap A C _ _ algAC x)
      (h3 : ∀ x : K₀, @algebraMap B C _ _ algBC (algebraMap K₀ B x) = algebraMap K₀ C x)
      [FiniteDimensional K₀ B] [FiniteDimensional K₀ C] (z : C),
      @Algebra.norm A C _ _ algAC z =
        @Algebra.norm A B _ _ algAB (@Algebra.norm B C _ _ algBC z) := by
    intro K₀ A B C _ _ _ _ _ _ _ algAB algBC algAC h1 h2 h3 _ _ z
    letI : Algebra A B := algAB
    letI : Algebra B C := algBC
    letI : Algebra A C := algAC
    haveI : IsScalarTower K₀ A B := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h1 x).symm)
    haveI : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h2 x).symm)
    haveI : IsScalarTower K₀ B C := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h3 x).symm)
    haveI : FiniteDimensional A B := Module.Finite.of_restrictScalars_finite K₀ A B
    haveI : FiniteDimensional B C := Module.Finite.of_restrictScalars_finite K₀ B C
    exact (Algebra.norm_norm (a := z)).symm

  have hnorm_eq_inclusion : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (h : A ≤ B) (y : B),
      @Algebra.norm A B _ _ (IntermediateField.inclusion h).toAlgebra y = normLM F h y := by
    intro A B h y
    letI : Algebra A B := (IntermediateField.inclusion h).toAlgebra
    let e : B ≃ₐ[A] IntermediateField.extendScalars h := {
      toFun := toExtendScalars F h
      invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl
    }
    exact (Algebra.norm_eq_of_algEquiv e y).symm

  have hnorm_units_trans : ∀ {A B C : IntermediateField F (AlgebraicClosure F)}
      [FiniteDimensional F B] [FiniteDimensional F C]
      (hAB : A ≤ B) (hBC : B ≤ C) (hAC : A ≤ C) (w : Cˣ),
      Units.map (normLM F hAC) w =
        Units.map (normLM F hAB) (Units.map (normLM F hBC) w) := by
    intro A B C _ _ hAB hBC hAC w
    apply Units.ext
    change normLM F hAC (w : C) = normLM F hAB (normLM F hBC (w : C))
    have hEq : hAC = hAB.trans hBC := Subsingleton.elim _ _
    subst hEq
    rw [← hnorm_eq_inclusion (hAB.trans hBC) (w : C),
        ← hnorm_eq_inclusion hBC (w : C),
        ← hnorm_eq_inclusion hAB]
    exact hnorm_trans_aux F A B C
      (IntermediateField.inclusion hAB).toAlgebra
      (IntermediateField.inclusion hBC).toAlgebra
      (IntermediateField.inclusion (hAB.trans hBC)).toAlgebra
      (fun _ => rfl)
      (fun _ => rfl)
      (fun _ => rfl)
      (w : C)

  obtain ⟨hval0_L, hval1_L, hval_neg1_L, _, hval_mul_L, hval_inv_L, _,
    hval_add_L, _, hunit_ge1_L, hunit_val0_L⟩ := hval_all L
  obtain ⟨hval0_MC, hval1_MC, hval_neg1_MC, _, hval_mul_MC, hval_inv_MC, _,
    hval_add_MC, _, hunit_ge1_MC, _⟩ := hval_all M_C

  let M_C_L : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLM_C
  let e_MC_L : M_C ≃ₐ[F] M_C_L :=
    { toExtendScalars F hLM_C with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hLM_C).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F M_C_L := Module.Finite.equiv e_MC_L.toLinearEquiv
  haveI : IsScalarTower F L M_C_L := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hFinLMC' : FiniteDimensional L M_C_L := Module.Finite.of_restrictScalars_finite F L M_C_L
  haveI : FiniteDimensional L M_C_L := hFinLMC'

  have hGalLMC' : IsGalois L ↥M_C_L := by
    have hSepLMC' : Algebra.IsSeparable L M_C_L := hGalMC.2.2.2 hLM_C
    haveI : Algebra.IsSeparable L M_C_L := hSepLMC'
    have helper_isGalois : ∀ (k₀ Ω_bar : Type u) [Field k₀] [Field Ω_bar] [Algebra k₀ Ω_bar]
        [Normal k₀ Ω_bar] (K₀ : IntermediateField k₀ Ω_bar) [hSepK₀ : Algebra.IsSeparable k₀ K₀],
        (∀ (σ τ : Ω_bar ≃ₐ[k₀] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
        IsGalois k₀ K₀ := by
      intro k₀ Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
      let N : IntermediateField k₀ Ω_bar := separableClosure k₀ Ω_bar
      haveI : IsGalois k₀ N := separableClosure.isGalois k₀ Ω_bar
      haveI : Normal k₀ N := IsGalois.to_normal
      have hK₀N : K₀ ≤ N := by
        intro z hz
        rw [mem_separableClosure_iff]
        let x : K₀ := ⟨z, hz⟩
        have hx : IsSeparable k₀ x := @Algebra.IsSeparable.isSeparable k₀ K₀ _ _ _ hSepK₀ x
        have hmin : minpoly k₀ z = minpoly k₀ x := minpoly.algHom_eq K₀.val K₀.val.injective x
        change (minpoly k₀ z).Separable
        rw [hmin]
        exact hx
      let K_N : IntermediateField k₀ N := K₀.comap N.val
      have hKN_map : K_N.map N.val = K₀ := by
        ext z
        refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
        rintro ⟨y, hy, rfl⟩
        exact hy
      have hKN_norm : K_N.fixingSubgroup.Normal := by
        refine ⟨fun h hh g => ?_⟩
        obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
        obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
        rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
        have hτ_fix : ∀ x ∈ K₀, τ x = x := by
          intro x hx
          let z : N := ⟨x, hK₀N hx⟩
          have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
          have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
          rwa [AlgEquiv.restrictNormalHom_apply] at h1
        intro y hy
        apply Subtype.ext
        rw [← map_inv, ← map_mul, ← map_mul]
        change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
        rw [AlgEquiv.restrictNormalHom_apply]
        exact h_norm_fix σ τ hτ_fix y.1 hy
      haveI : K_N.fixingSubgroup.Normal := hKN_norm
      haveI : IsGalois k₀ K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
      let e_KN : ↥K_N ≃ₐ[k₀] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
      exact IsGalois.of_algEquiv e_KN
    haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
    haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
    have hMC_norm_fix : ∀ (σ τ : AlgebraicClosure F ≃ₐ[L] AlgebraicClosure F),
        (∀ x ∈ M_C_L, τ x = x) → ∀ x ∈ M_C_L, (σ * τ * σ⁻¹) x = x := by
      intro σ τ hτ
      let σ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm σ
      let τ_F : L.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv L).symm τ
      have hτMC : τ_F.1 ∈ M_C.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hLM_C).mpr hx)
      have hconjMC : (σ_F * τ_F * σ_F⁻¹).1 ∈ M_C.fixingSubgroup :=
        hGalMC.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτMC
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjMC
      exact hconjMC x ((IntermediateField.mem_extendScalars hLM_C).mp hx)
    exact helper_isGalois L (AlgebraicClosure F) M_C_L hMC_norm_fix
  haveI : IsGalois L ↥M_C_L := hGalLMC'
  let G_MC : Type u := (M_C_L ≃ₐ[L] M_C_L)
  let fromExtendScalars_L : M_C_L →+* M_C := e_MC_L.symm.toRingHom
  let act_MC : G_MC → M_C → M_C := fun σ z => fromExtendScalars_L (σ (toExtendScalars F hLM_C z))
  have hact_MC_ring : ∀ σ : G_MC,
      act_MC σ 0 = 0 ∧ act_MC σ 1 = 1 ∧
      (∀ z₁ z₂ : M_C,
        act_MC σ (z₁ + z₂) = act_MC σ z₁ + act_MC σ z₂ ∧
        act_MC σ (z₁ * z₂) = act_MC σ z₁ * act_MC σ z₂) := by
    intro σ
    refine ⟨by change fromExtendScalars_L (σ 0) = 0; rw [map_zero, map_zero],
      by change fromExtendScalars_L (σ 1) = 1; rw [map_one, map_one],
      fun z₁ z₂ => ⟨?_, ?_⟩⟩
    · change fromExtendScalars_L (σ (toExtendScalars F hLM_C z₁ + toExtendScalars F hLM_C z₂)) = _
      rw [map_add, map_add]
    · change fromExtendScalars_L (σ (toExtendScalars F hLM_C z₁ * toExtendScalars F hLM_C z₂)) = _
      rw [map_mul, map_mul]
  have hact_MC_val : ∀ (σ : G_MC) (z : M_C), valL F M_C (act_MC σ z) = valL F M_C z := by
    intro σ z
    let φ_σ : M_C ≃ₐ[F] M_C := e_MC_L.trans ((σ.restrictScalars F).trans e_MC_L.symm)
    have hφ : φ_σ z = act_MC σ z := rfl
    unfold valL relVal
    rw [← hφ, Algebra.norm_eq_of_algEquiv φ_σ z]
  have hact_MC_trace : ∀ z : M_C,
      IntermediateField.inclusion hLM_C (traceLM F hLM_C z) = ∑ σ : G_MC, act_MC σ z := by
    intro z
    have h1 := congrArg fromExtendScalars_L
      (trace_eq_sum_automorphisms (K := L) (L := M_C_L) (toExtendScalars F hLM_C z))
    exact h1.trans (map_sum fromExtendScalars_L (fun σ : G_MC => σ (toExtendScalars F hLM_C z)) Finset.univ)
  have hact_MC_norm : ∀ z : M_C,
      IntermediateField.inclusion hLM_C (normLM F hLM_C z) = ∏ σ : G_MC, act_MC σ z := by
    intro z
    have h1 := congrArg fromExtendScalars_L
      (Algebra.norm_eq_prod_automorphisms L (toExtendScalars F hLM_C z))
    exact h1.trans (map_prod fromExtendScalars_L (fun σ : G_MC => σ (toExtendScalars F hLM_C z)) Finset.univ)
  have hinj_LMC : Function.Injective (IntermediateField.inclusion hLM_C) :=
    (IntermediateField.inclusion hLM_C).injective
  have hring_id : ∀ (a S_sum P : M_C),
      (1 + a) * P - (1 + (a + S_sum)) =
        (P - (1 + S_sum)) + a * S_sum + a * (P - (1 + S_sum)) :=
    fun _ _ _ => by ring
  have hNormRemMCL : ∀ z : M_C, 1 ≤ valL F M_C z →
      normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z) = 0 ∨
        2 * valL F M_C z ≤
          (k : ℤ) * valL F L (normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z)) := by
    intro z hd
    let d : ℤ := valL F M_C z
    have hz_act : ∀ σ : G_MC, act_MC σ z = 0 ∨ d ≤ valL F M_C (act_MC σ z) := by
      intro σ
      exact Or.inr (by rw [hact_MC_val σ z])
    have h_ind : ∀ S : Finset G_MC,
        ((∑ σ ∈ S, act_MC σ z) = 0 ∨ d ≤ valL F M_C (∑ σ ∈ S, act_MC σ z)) ∧
        ((∏ σ ∈ S, (1 + act_MC σ z)) - (1 + ∑ σ ∈ S, act_MC σ z) = 0 ∨
          2 * d ≤ valL F M_C ((∏ σ ∈ S, (1 + act_MC σ z)) - (1 + ∑ σ ∈ S, act_MC σ z))) := by
      intro S
      induction' S using Finset.induction_on with τ S' hτ ih
      · exact ⟨Or.inl Finset.sum_empty,
          Or.inl (by rw [Finset.prod_empty, Finset.sum_empty, add_zero, sub_self])⟩
      · rw [Finset.sum_insert hτ, Finset.prod_insert hτ]
        let a := act_MC τ z
        let S_sum := ∑ σ ∈ S', act_MC σ z
        let P := ∏ σ ∈ S', (1 + act_MC σ z)
        let R := P - (1 + S_sum)
        have ih1 : S_sum = 0 ∨ d ≤ valL F M_C S_sum := ih.1
        have ih2 : R = 0 ∨ 2 * d ≤ valL F M_C R := ih.2
        have ha : a = 0 ∨ d ≤ valL F M_C a := hz_act τ
        have hsum : a + S_sum = 0 ∨ d ≤ valL F M_C (a + S_sum) :=
          hval_add_MC d a S_sum ha ih1
        refine ⟨hsum, ?_⟩
        rw [hring_id a S_sum P]
        change (R + a * S_sum + a * R = 0) ∨ 2 * d ≤ valL F M_C (R + a * S_sum + a * R)
        have haS : a * S_sum = 0 ∨ 2 * d ≤ valL F M_C (a * S_sum) := by
          by_cases ha0 : a = 0
          · exact Or.inl (by rw [ha0, zero_mul])
          · by_cases hS0 : S_sum = 0
            · exact Or.inl (by rw [hS0, mul_zero])
            · right
              rw [hval_mul_MC a S_sum ha0 hS0]
              have h1 := ha.resolve_left ha0
              have h2 := ih1.resolve_left hS0
              omega
        have haR : a * R = 0 ∨ 2 * d ≤ valL F M_C (a * R) := by
          by_cases ha0 : a = 0
          · exact Or.inl (by rw [ha0, zero_mul])
          · by_cases hR0 : R = 0
            · exact Or.inl (by rw [hR0, mul_zero])
            · right
              rw [hval_mul_MC a R ha0 hR0]
              have h1 := ha.resolve_left ha0
              have h2 := ih2.resolve_left hR0
              omega
        exact hval_add_MC (2 * d) (R + a * S_sum) (a * R)
          (hval_add_MC (2 * d) R (a * S_sum) ih2 haS) haR
    have h_univ := (h_ind Finset.univ).2
    have hprod_eq : (∏ σ : G_MC, (1 + act_MC σ z)) =
        IntermediateField.inclusion hLM_C (normLM F hLM_C (1 + z)) := by
      rw [hact_MC_norm (1 + z)]
      refine Finset.prod_congr rfl fun σ _ => ?_
      rw [((hact_MC_ring σ).2.2 1 z).1, (hact_MC_ring σ).2.1]
    have h_diff_eq : (∏ σ : G_MC, (1 + act_MC σ z)) - (1 + ∑ σ : G_MC, act_MC σ z) =
        IntermediateField.inclusion hLM_C (normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z)) := by
      rw [hprod_eq, ← hact_MC_trace z]
      simp only [map_sub, map_add, map_one]
    rw [h_diff_eq] at h_univ
    rcases h_univ with h0 | hge
    · exact Or.inl ((map_eq_zero_iff (IntermediateField.inclusion hLM_C) hinj_LMC).mp h0)
    · rw [hValAlgMCL (normLM F hLM_C (1 + z) - (1 + traceLM F hLM_C z))] at hge
      exact Or.inr hge

  set a := condExp F L χ'
  have hχ'MC_top : ∀ z : M_C, ((k * (a - 1) : ℕ) : ℤ) ≤ valL F M_C z →
      ∀ hz : 1 + z ≠ 0,
        (χ' (Units.map (normLM F hLM_C) (Units.mk0 (1 + z) hz)) : Ω F) =
          (traceChar F hLM_C ψ)
            (IntermediateField.inclusion hLM_C ((c'_χ'⁻¹ : Lˣ) : L) * z) := by
    intro z hz_val hz
    have hka_cast : ((k * (a - 1) : ℕ) : ℤ) = (k : ℤ) * ((a - 1 : ℕ) : ℤ) := by
      simp [Nat.cast_mul]
    have hz_ge1 : 1 ≤ valL F M_C z := by
      have h1 : (1 : ℤ) ≤ ((k * (a - 1) : ℕ) : ℤ) := by
        exact_mod_cast Nat.mul_pos hk_ge1 (by omega)
      omega
    let t_z : L := traceLM F hLM_C z
    have htr_z : t_z = 0 ∨ ((a - 1 : ℕ) : ℤ) ≤ valL F L t_z := by
      apply hTrBoundMCL ((a - 1 : ℕ) : ℤ) z
      right
      rw [hka_cast] at hz_val
      omega
    have h1tz : 1 + t_z ≠ 0 := by
      intro h0
      have htz_neg1 : t_z = -1 := eq_neg_of_add_eq_zero_right h0
      rcases htr_z with htz0 | htz_ge
      · rw [htz0] at htz_neg1
        exact one_ne_zero (neg_eq_zero.mp htz_neg1.symm)
      · rw [htz_neg1, hval_neg1_L] at htz_ge
        omega
    let u_tz : Lˣ := Units.mk0 (1 + t_z) h1tz
    have hu_tz_mem : u_tz ∈ unitGroup F L (a - 1) := by
      rw [hunit_ge1_L (a - 1) (by omega)]
      rcases htr_z with htz0 | htz_ge
      · left
        change 1 + t_z = 1
        rw [htz0, add_zero]
      · right
        have hsub : (u_tz : L) - 1 = t_z := by change (1 + t_z) - 1 = t_z; ring
        rw [hsub]
        exact htz_ge
    have hu_tz_inv_val0 : valL F L ((u_tz⁻¹ : Lˣ) : L) = 0 := by
      rw [hval_inv_L u_tz, hunit_val0_L (a - 1) u_tz hu_tz_mem, neg_zero]
    let δ_L : L := normLM F hLM_C (1 + z) - (1 + t_z)
    have hδ_L_val : δ_L = 0 ∨ (a : ℤ) ≤ valL F L δ_L := by
      rcases hNormRemMCL z hz_ge1 with h0 | h2z
      · exact Or.inl h0
      · right
        change 2 * valL F M_C z ≤ (k : ℤ) * valL F L δ_L at h2z
        rw [hka_cast] at hz_val
        have h2a : (a : ℤ) ≤ 2 * ((a - 1 : ℕ) : ℤ) := by omega
        have hmul_ka : (k : ℤ) * (a : ℤ) ≤ 2 * ((k : ℤ) * ((a - 1 : ℕ) : ℤ)) := by
          calc (k : ℤ) * (a : ℤ) ≤ (k : ℤ) * (2 * ((a - 1 : ℕ) : ℤ)) :=
                mul_le_mul_of_nonneg_left h2a (by omega)
            _ = 2 * ((k : ℤ) * ((a - 1 : ℕ) : ℤ)) := by ring
        have hmul_le : (k : ℤ) * (a : ℤ) ≤ (k : ℤ) * valL F L δ_L := by linarith
        exact le_of_mul_le_mul_left hmul_le (by omega)
    let w_z : M_Cˣ := Units.mk0 (1 + z) hz
    let v_rem_L : Lˣ := Units.map (normLM F hLM_C) w_z * u_tz⁻¹
    have hv_rem_L_mem : v_rem_L ∈ unitGroup F L a := by
      rw [hunit_ge1_L a (by omega)]
      have hv_sub : (v_rem_L : L) - 1 = δ_L * ((u_tz⁻¹ : Lˣ) : L) := by
        have hinv : (u_tz : L) * ((u_tz⁻¹ : Lˣ) : L) = 1 := Units.mul_inv u_tz
        calc (v_rem_L : L) - 1 =
              normLM F hLM_C (1 + z) * ((u_tz⁻¹ : Lˣ) : L) -
                (u_tz : L) * ((u_tz⁻¹ : Lˣ) : L) := by
              rw [hinv]; rfl
          _ = δ_L * ((u_tz⁻¹ : Lˣ) : L) := by
              change normLM F hLM_C (1 + z) * ((u_tz⁻¹ : Lˣ) : L) -
                (1 + t_z) * ((u_tz⁻¹ : Lˣ) : L) = _
              dsimp [δ_L]
              ring
      rw [hv_sub]
      rcases hδ_L_val with hδ0 | hδ_ge
      · left
        have h0 : δ_L * ((u_tz⁻¹ : Lˣ) : L) = 0 := by rw [hδ0, zero_mul]
        exact sub_eq_zero.mp (by rw [hv_sub, h0])
      · right
        have hδ_ne0 : δ_L ≠ 0 := by
          intro h0
          rw [h0, hval0_L] at hδ_ge
          omega
        rw [hval_mul_L δ_L _ hδ_ne0 (Units.ne_zero u_tz⁻¹), hu_tz_inv_val0, add_zero]
        exact hδ_ge
    have hχ'_rem : χ' v_rem_L = 1 := hχ'_cond v_rem_L hv_rem_L_mem
    have hnw_eq : Units.map (normLM F hLM_C) w_z = v_rem_L * u_tz := by
      dsimp [v_rem_L]
      exact (inv_mul_cancel_right _ u_tz).symm
    have hχ'_eq : χ' (Units.map (normLM F hLM_C) w_z) = χ' u_tz := by
      rw [hnw_eq, map_mul, hχ'_rem, one_mul]
    rw [hχ'_eq, hc_L_top t_z htr_z h1tz]
    change ψ (((c'_χ'⁻¹ : Lˣ) : L) * traceLM F hLM_C z) =
      ψ (traceLM F hLM_C (IntermediateField.inclusion hLM_C ((c'_χ'⁻¹ : Lˣ) : L) * z))
    rw [htrace_inc_mul hLM_C ((c'_χ'⁻¹ : Lˣ) : L) z]

  intro i
  dsimp only
  set F_i := (D_orb.get i).field
  haveI : FiniteDimensional F F_i := hFinFi i
  set ψ_Fi := traceChar F (D_orb.get i).le ψ
  set ψ_MC := traceChar F hLM_C ψ
  set c'_χ'_Fi : F_iˣ :=
    Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c'_χ'
  obtain ⟨hval0_Fi, hval1_Fi, hval_neg1_Fi, _, hval_mul_Fi, hval_inv_Fi, _,
    hval_add_Fi, _, hunit_ge1_Fi, hunit_val0_Fi⟩ := hval_all F_i
  obtain ⟨hValAlgFiMC_i, hTrBoundFiMC_i, hNormLinFiMC_i, hnFi_i⟩ := hFi_ram_pull i
  have hn_eq : condExpChar F M_C ψ_MC = condExpChar F F_i ψ_Fi := hnMC.trans hnFi_i.symm
  set n₁ := condExpChar F M_C ψ_MC
  obtain ⟨_, ⟨z₁, hz₁_ne0, hz₁_val, hz₁_ψ⟩⟩ := hSpec_all M_C ψ_MC hψMC
  obtain ⟨hFi_triv, _⟩ := hSpec_all F_i ψ_Fi (hψFi i)
  have hψMC_eq_Fi : ψ_MC = traceChar F (hFiMC i) ψ_Fi :=
    htraceChar_trans (D_orb.get i).le (hFiMC i) hLM_C ψ
  let t₁ : F_i := traceLM F (hFiMC i) z₁
  have hψ_t₁ : ψ_Fi t₁ ≠ 1 := by
    have h1 : ψ_Fi t₁ = ψ_MC z₁ := by
      change ψ_Fi (traceLM F (hFiMC i) z₁) = ψ_MC z₁
      rw [hψMC_eq_Fi]
      rfl
    rw [h1]
    exact hz₁_ψ
  have ht₁_ne0 : t₁ ≠ 0 := by
    intro h0
    rw [h0, AddChar.map_zero_eq_one] at hψ_t₁
    exact hψ_t₁ rfl
  have ht₁_val_le : valL F F_i t₁ ≤ -(n₁ + 1) := by
    by_contra hgt
    have hge : -condExpChar F F_i ψ_Fi ≤ valL F F_i t₁ := by
      rw [← hn_eq]
      omega
    exact hψ_t₁ (hFi_triv t₁ (Or.inr hge))
  have ht₁_val_ge : -(n₁ + 1) ≤ valL F F_i t₁ :=
    (hTrBoundFiMC_i (-(n₁ + 1)) z₁ (Or.inr hz₁_val)).resolve_left ht₁_ne0
  have ht₁_val : valL F F_i t₁ = -(n₁ + 1) := le_antisymm ht₁_val_le ht₁_val_ge
  let u_t1 : F_iˣ := Units.mk0 t₁ ht₁_ne0
  let y_Fi : M_C := IntermediateField.inclusion (hFiMC i) ((u_t1⁻¹ : F_iˣ) : F_i) * z₁
  have hinc_t1_inv_ne0 : IntermediateField.inclusion (hFiMC i) ((u_t1⁻¹ : F_iˣ) : F_i) ≠ 0 :=
    (IntermediateField.inclusion (hFiMC i)).injective.ne (Units.ne_zero u_t1⁻¹)
  have hy_Fi_ne0 : y_Fi ≠ 0 := mul_ne_zero hinc_t1_inv_ne0 hz₁_ne0
  have hy_Fi_val0 : 0 ≤ valL F M_C y_Fi := by
    have hmul := hval_mul_MC (IntermediateField.inclusion (hFiMC i) ((u_t1⁻¹ : F_iˣ) : F_i)) z₁
      hinc_t1_inv_ne0 hz₁_ne0
    change valL F M_C y_Fi = _ at hmul
    rw [hmul, hValAlgFiMC_i ((u_t1⁻¹ : F_iˣ) : F_i), hval_inv_Fi u_t1]
    change 0 ≤ -valL F F_i t₁ + valL F M_C z₁
    omega
  have hy_Fi_tr : traceLM F (hFiMC i) y_Fi = 1 :=
    (htrace_inc_mul (hFiMC i) ((u_t1⁻¹ : F_iˣ) : F_i) z₁).trans (Units.inv_mul u_t1)

  intro x hx_val hx
  by_cases hx0 : x = 0
  · subst hx0
    have hmk1 : Units.mk0 (1 + (0 : F_i)) hx = 1 := by
      apply Units.ext
      change (1 : F_i) + 0 = 1
      ring
    rw [hmk1, map_one, Units.val_one, mul_zero, AddChar.map_zero_eq_one]
  · have hx_ge : ((k * (a - 1) : ℕ) : ℤ) ≤ valL F F_i x := hx_val.resolve_left hx0
    let x_MC : M_C := IntermediateField.inclusion (hFiMC i) x
    have hx_MC_ne0 : x_MC ≠ 0 := (IntermediateField.inclusion (hFiMC i)).injective.ne hx0
    let z : M_C := x_MC * y_Fi
    have hz_ne0 : z ≠ 0 := mul_ne_zero hx_MC_ne0 hy_Fi_ne0
    have hz_val : ((k * (a - 1) : ℕ) : ℤ) ≤ valL F M_C z := by
      have hmul := hval_mul_MC x_MC y_Fi hx_MC_ne0 hy_Fi_ne0
      change valL F M_C z = valL F M_C (IntermediateField.inclusion (hFiMC i) x) + valL F M_C y_Fi at hmul
      rw [hmul, hValAlgFiMC_i x]
      linarith [hx_ge, hy_Fi_val0]
    have hka_ge1 : (1 : ℤ) ≤ ((k * (a - 1) : ℕ) : ℤ) := by
      have h1 : 1 ≤ k * (a - 1) := Nat.mul_pos hk_ge1 (by omega)
      exact_mod_cast h1
    have hz_ge1 : 1 ≤ valL F M_C z := by omega
    have hz1 : 1 + z ≠ 0 := by
      intro h0
      have hz_neg1 : z = -1 := eq_neg_of_add_eq_zero_right h0
      rw [hz_neg1, hval_neg1_MC] at hz_ge1
      omega
    have htr_z : traceLM F (hFiMC i) z = x := by
      have h1 := htrace_inc_mul (hFiMC i) x y_Fi
      change traceLM F (hFiMC i) z = x * traceLM F (hFiMC i) y_Fi at h1
      rw [h1, hy_Fi_tr, mul_one]
    let u_x : F_iˣ := Units.mk0 (1 + x) hx
    have hu_x_mem : u_x ∈ unitGroup F F_i (k * (a - 1)) := by
      rw [hunit_ge1_Fi (k * (a - 1)) (by exact_mod_cast hka_ge1)]
      right
      have hsub : (u_x : F_i) - 1 = x := by change (1 + x) - 1 = x; ring
      rw [hsub]
      exact hx_ge
    have hu_x_inv_val0 : valL F F_i ((u_x⁻¹ : F_iˣ) : F_i) = 0 := by
      rw [hval_inv_Fi u_x, hunit_val0_Fi (k * (a - 1)) u_x hu_x_mem, neg_zero]
    let δ_Fi : F_i := normLM F (hFiMC i) (1 + z) - (1 + x)
    have hδ_Fi_val : δ_Fi = 0 ∨ ((k * (a - 1) + 1 : ℕ) : ℤ) ≤ valL F F_i δ_Fi := by
      have hlin := hNormLinFiMC_i z (Or.inr hz_ge1)
      rw [htr_z] at hlin
      rcases hlin with h0 | h2z
      · exact Or.inl h0
      · right
        change 2 * valL F M_C z ≤ valL F F_i δ_Fi at h2z
        omega
    let w_z : M_Cˣ := Units.mk0 (1 + z) hz1
    let v_rem_Fi : F_iˣ := Units.map (normLM F (hFiMC i)) w_z * u_x⁻¹
    have hv_rem_Fi_mem : v_rem_Fi ∈ unitGroup F F_i (k * (a - 1) + 1) := by
      rw [hunit_ge1_Fi (k * (a - 1) + 1) (by omega)]
      have hv_sub : (v_rem_Fi : F_i) - 1 = δ_Fi * ((u_x⁻¹ : F_iˣ) : F_i) := by
        have hinv : (u_x : F_i) * ((u_x⁻¹ : F_iˣ) : F_i) = 1 := Units.mul_inv u_x
        calc (v_rem_Fi : F_i) - 1 =
              normLM F (hFiMC i) (1 + z) * ((u_x⁻¹ : F_iˣ) : F_i) -
                (u_x : F_i) * ((u_x⁻¹ : F_iˣ) : F_i) := by
              rw [hinv]; rfl
          _ = δ_Fi * ((u_x⁻¹ : F_iˣ) : F_i) := by
              change normLM F (hFiMC i) (1 + z) * ((u_x⁻¹ : F_iˣ) : F_i) -
                (1 + x) * ((u_x⁻¹ : F_iˣ) : F_i) = _
              dsimp [δ_Fi]
              ring
      rw [hv_sub]
      rcases hδ_Fi_val with hδ0 | hδ_ge
      · left
        have h0 : δ_Fi * ((u_x⁻¹ : F_iˣ) : F_i) = 0 := by rw [hδ0, zero_mul]
        exact sub_eq_zero.mp (by rw [hv_sub, h0])
      · right
        have hδ_ne0 : δ_Fi ≠ 0 := by
          intro h0
          rw [h0, hval0_Fi] at hδ_ge
          omega
        rw [hval_mul_Fi δ_Fi _ hδ_ne0 (Units.ne_zero u_x⁻¹), hu_x_inv_val0, add_zero]
        exact hδ_ge
    have hχ'_rem_Fi : (χ'.comp (Units.map (normLM F (D_orb.get i).le))) v_rem_Fi = 1 :=
      hχ'_cond _ (hNormFilt_a i v_rem_Fi hv_rem_Fi_mem)
    have hu_x_eq : u_x = v_rem_Fi⁻¹ * Units.map (normLM F (hFiMC i)) w_z := by
      dsimp [v_rem_Fi]
      rw [mul_inv_rev, inv_inv, inv_mul_cancel_right]
    have hχ'_ux :
        (χ'.comp (Units.map (normLM F (D_orb.get i).le))) u_x =
          χ' (Units.map (normLM F hLM_C) w_z) := by
      rw [hu_x_eq, map_mul, map_inv, hχ'_rem_Fi, inv_one, one_mul]
      change χ' (Units.map (normLM F (D_orb.get i).le) (Units.map (normLM F (hFiMC i)) w_z)) = _
      rw [← hnorm_units_trans (D_orb.get i).le (hFiMC i) hLM_C w_z]
    change ((χ'.comp (Units.map (normLM F (D_orb.get i).le))) u_x : Ω F) = _
    rw [hχ'_ux, hχ'MC_top z hz_val hz1]
    have hinc_comp :
        IntermediateField.inclusion hLM_C ((c'_χ'⁻¹ : Lˣ) : L) * z =
          IntermediateField.inclusion (hFiMC i) (((c'_χ'_Fi⁻¹ : F_iˣ) : F_i) * x) * y_Fi := by
      have hinc_eq :
          IntermediateField.inclusion hLM_C ((c'_χ'⁻¹ : Lˣ) : L) =
            IntermediateField.inclusion (hFiMC i) ((c'_χ'_Fi⁻¹ : F_iˣ) : F_i) := rfl
      change IntermediateField.inclusion hLM_C ((c'_χ'⁻¹ : Lˣ) : L) *
          (IntermediateField.inclusion (hFiMC i) x * y_Fi) = _
      rw [hinc_eq, map_mul, mul_assoc]
    change ψ_MC (IntermediateField.inclusion hLM_C ((c'_χ'⁻¹ : Lˣ) : L) * z) = _
    rw [hinc_comp, hψMC_eq_Fi]
    change ψ_Fi (traceLM F (hFiMC i)
      (IntermediateField.inclusion (hFiMC i) (((c'_χ'_Fi⁻¹ : F_iˣ) : F_i) * x) * y_Fi)) = _
    rw [htrace_inc_mul (hFiMC i) (((c'_χ'_Fi⁻¹ : F_iˣ) : F_i) * x) y_Fi, hy_Fi_tr, mul_one]

theorem ld_ch14_twisted_orbit_regime_construction (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hψFi : ∀ i : Fin D_orb.length,
      IsAdmissibleChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ))
    (hLtFi : ∀ i : Fin D_orb.length, L < (D_orb.get i).field)
    (hDegSum : (∑ i : Fin D_orb.length,
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (hχ'_cond : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1)
    (hθ_cond : ∀ i : Fin D_orb.length,
      ∀ u ∈ unitGroup F (D_orb.get i).field
          (condExp F (D_orb.get i).field
            (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))),
        (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) u = 1)
    (σ_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      (M_C ≃ₐ[F] M_C))
    (idx_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      Fin D_orb.length)
    (hσ_props : ∀ j,
      (∀ x : L, (σ_all j) (IntermediateField.inclusion hLM_C x) =
        IntermediateField.inclusion hLM_C x) ∧
      (∀ z : M_C, valL F M_C ((σ_all j) z) = valL F M_C z))
    (hν_prod : ∀ (c_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ),
      ∏ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1),
        Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
          (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
            (c_orb (idx_all j))) =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
          (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c_orb i)))
    (t k : ℕ) (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k)
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hFi_ram_reg : ∀ i : Fin D_orb.length,
      condExp F (D_orb.get i).field (μ'_orb i) = t + 1 ∧
      (∀ x : (D_orb.get i).field,
        valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
          valL F (D_orb.get i).field x) ∧
      condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) =
        (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1))
    (ϖ_MC : M_Cˣ) (ϖ_L : Lˣ)
    (hϖ_valMC : valL F M_C (ϖ_MC : M_C) = 1)
    (hϖ_valL : valL F L (ϖ_L : L) = 1)
    (c'_χ' : Lˣ)
    (c'_μ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (hc_L_val : valL F L (c'_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_μ_props : ∀ i : Fin D_orb.length,
      let F_i := (D_orb.get i).field
      let ψ_Fi := traceChar F (D_orb.get i).le ψ
      2 ≤ condExp F F_i (μ'_orb i) ∧
      valL F F_i (c'_μ i : F_i) =
        (condExp F F_i (μ'_orb i) : ℤ) + condExpChar F F_i ψ_Fi ∧
      valL F F_i (c'_μ i : F_i) = (k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ) ∧
      (∀ x : F_i, (x = 0 ∨ ((condExp F F_i (μ'_orb i) - 1 : ℕ) : ℤ) ≤ valL F F_i x) →
        ∀ hx : 1 + x ≠ 0,
          (μ'_orb i (Units.mk0 (1 + x) hx) : Ω F) =
            ψ_Fi ((((c'_μ i)⁻¹ : F_iˣ) : F_i) * x)))
    (u_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) → M_Cˣ)
    (hu_all_def : ∀ j,
      u_all j =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
          ((ϖ_L ^ (condExp F L χ' - 1))⁻¹ * c'_χ') *
          (ϖ_MC ^ t) *
          (Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
            (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
              (c'_μ (idx_all j))))⁻¹)
    (hu_all_inj : ∀ j₁ j₂ : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1),
      ((u_all j₁ : M_C) - (u_all j₂ : M_C) = 0 ∨
        1 ≤ valL F M_C ((u_all j₁ : M_C) - (u_all j₂ : M_C))) →
      j₁ = j₂)
    (hTopCond : ∀ (i : Fin D_orb.length) (m : ℕ), 2 ≤ m →
      ∀ (c' : ((D_orb.get i).field)ˣ),
        valL F (D_orb.get i).field (c' : (D_orb.get i).field) =
          (m : ℤ) + condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) →
        (∀ x : (D_orb.get i).field,
          (x = 0 ∨ ((m - 1 : ℕ) : ℤ) ≤ valL F (D_orb.get i).field x) →
          ∀ hx : 1 + x ≠ 0,
            ((μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
              (Units.mk0 (1 + x) hx) : Ω F) =
              (traceChar F (D_orb.get i).le ψ)
                (((c'⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * x)) →
        condExp F (D_orb.get i).field
          (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) = m)
    (hNormFilt : ∀ (i : Fin D_orb.length) (m : ℕ), 1 ≤ m →
      ∀ u ∈ unitGroup F (D_orb.get i).field (k * (m - 1) + 1),
        Units.map (normLM F (D_orb.get i).le) u ∈ unitGroup F L m)
    (hχ'Fi_top : ∀ (i : Fin D_orb.length),
      let F_i := (D_orb.get i).field
      let ψ_Fi := traceChar F (D_orb.get i).le ψ
      let c'_χ'_Fi : F_iˣ :=
        Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c'_χ'
      ∀ x : F_i, (x = 0 ∨ ((k * (condExp F L χ' - 1) : ℕ) : ℤ) ≤ valL F F_i x) →
        ∀ hx : 1 + x ≠ 0,
          ((χ'.comp (Units.map (normLM F (D_orb.get i).le))) (Units.mk0 (1 + x) hx) : Ω F) =
            ψ_Fi (((c'_χ'_Fi⁻¹ : F_iˣ) : F_i) * x))
    (hval_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
      (∀ u : Mˣ, u ∈ unitGroup F M 0 ↔ valL F M (u : M) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
      (∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0)) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let a := condExp F L χ'
    let θ_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ :=
      fun i => μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
    ∃ (c'_θ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ),
      (∀ i : Fin D_orb.length,
        let F_i := (D_orb.get i).field
        let ψ_Fi := traceChar F (D_orb.get i).le ψ
        2 ≤ condExp F F_i (μ'_orb i) ∧
        2 ≤ condExp F F_i (θ_orb i) ∧
        valL F F_i (c'_μ i : F_i) =
          (condExp F F_i (μ'_orb i) : ℤ) + condExpChar F F_i ψ_Fi ∧
        (∀ x : F_i, (x = 0 ∨ ((condExp F F_i (μ'_orb i) - 1 : ℕ) : ℤ) ≤ valL F F_i x) →
          ∀ hx : 1 + x ≠ 0,
            (μ'_orb i (Units.mk0 (1 + x) hx) : Ω F) =
              ψ_Fi ((((c'_μ i)⁻¹ : F_iˣ) : F_i) * x)) ∧
        valL F F_i (c'_θ i : F_i) =
          (condExp F F_i (θ_orb i) : ℤ) + condExpChar F F_i ψ_Fi ∧
        (∀ x : F_i, (x = 0 ∨ ((condExp F F_i (θ_orb i) - 1 : ℕ) : ℤ) ≤ valL F F_i x) →
          ∀ hx : 1 + x ≠ 0,
            (θ_orb i (Units.mk0 (1 + x) hx) : Ω F) =
              ψ_Fi ((((c'_θ i)⁻¹ : F_iˣ) : F_i) * x))) ∧
      (k * (a - 1) < t →
        (∀ i : Fin D_orb.length, condExp F (D_orb.get i).field (θ_orb i) = t + 1) ∧
        (∀ i : Fin D_orb.length, c'_θ i = c'_μ i)) ∧
      (t < k * (a - 1) →
        (∀ i : Fin D_orb.length,
          condExp F (D_orb.get i).field (θ_orb i) = k * (a - 1) + 1) ∧
        (c'_χ' ^ q) *
          (c'_χ' *
            (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_θ i)))⁻¹ ∈
          unitGroup F L 1) ∧
      (k * (a - 1) = t →
        (∀ i : Fin D_orb.length, condExp F (D_orb.get i).field (θ_orb i) = t + 1) ∧
        ∃ (v_θ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ),
          (∀ i : Fin D_orb.length,
            let F_i := (D_orb.get i).field
            let α_i : F_iˣ :=
              Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c'_χ' *
                (c'_μ i)⁻¹
            valL F F_i (v_θ i : F_i) = 0 ∧
            (v_θ i : F_i) = 1 + ((α_i⁻¹ : F_iˣ) : F_i) ∧
            c'_θ i = c'_μ i * (v_θ i)⁻¹)) :=
by
  dsimp only
  let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  set a := condExp F L χ'
  let θ_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ :=
    fun i => μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, _,
    hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩ := hval_all L
  obtain ⟨hval0_MC, hval1_MC, hval_neg1_MC, hval_neg_MC, hval_mul_MC, hval_inv_MC, _,
    hval_add_MC, hunit0_MC, hunit_ge1_MC, hunit_val0_MC⟩ := hval_all M_C

  have hval_pow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (u : Mˣ) (n : ℕ), valL F M (((u ^ n : Mˣ) : M)) = (n : ℤ) * valL F M (u : M) := by
    intro M _ u n
    obtain ⟨_, hval1_M, _, _, hval_mul_M, _, _, _, _, _, _⟩ := hval_all M
    induction n with
    | zero => rw [pow_zero, Units.val_one, hval1_M, Nat.cast_zero, zero_mul]
    | succ n ih =>
      rw [pow_succ', Units.val_mul, hval_mul_M (u : M) _ (Units.ne_zero u) (Units.ne_zero _), ih]
      push_cast
      ring

  have hval_prod : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      {ι : Type} (S : Finset ι) (g : ι → Mˣ),
      valL F M (((∏ x ∈ S, g x : Mˣ) : M)) = ∑ x ∈ S, valL F M (g x : M) := by
    intro M _ ι S g
    obtain ⟨_, hval1_M, _, _, hval_mul_M, _, _, _, _, _, _⟩ := hval_all M
    induction S using Finset.induction_on with
    | empty => rw [Finset.prod_empty, Finset.sum_empty, Units.val_one, hval1_M]
    | @insert x s hx ih =>
      rw [Finset.prod_insert hx, Finset.sum_insert hx, Units.val_mul,
        hval_mul_M (g x : M) _ (Units.ne_zero (g x)) (Units.ne_zero _), ih]

  have hσ_symm_val : ∀ j (z : M_C), valL F M_C ((σ_all j).symm z) = valL F M_C z := by
    intro j z
    have h1 := (hσ_props j).2 ((σ_all j).symm z)
    rw [AlgEquiv.apply_symm_apply] at h1
    exact h1.symm

  have hσ_symm_incl : ∀ j (x : L),
      (σ_all j).symm (IntermediateField.inclusion hLM_C x) =
        IntermediateField.inclusion hLM_C x := by
    intro j x
    have h1 := congrArg (σ_all j).symm ((hσ_props j).1 x)
    rw [AlgEquiv.symm_apply_apply] at h1
    exact h1.symm

  
  have hnorm_unit_inc_LFi : ∀ (i : Fin D_orb.length) (u : Lˣ),
      Units.map (normLM F (D_orb.get i).le)
        (Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom u) =
        u ^ (Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) := by
    intro i u
    let F_i_L := IntermediateField.extendScalars (D_orb.get i).le
    apply Units.ext
    change Algebra.norm L (algebraMap L F_i_L (u : L)) =
      (u : L) ^ (Module.finrank L F_i_L)
    exact Algebra.norm_algebraMap (u : L)

  have hfiber_two : ∀ i : Fin D_orb.length,
      ∃ j₁ j₂ : Fin (q - 1), idx_all j₁ = i ∧ idx_all j₂ = i ∧ j₁ ≠ j₂ := by
    intro i
    set F_i := (D_orb.get i).field
    haveI : FiniteDimensional F F_i := hFinFi i
    let F_i_L := IntermediateField.extendScalars (D_orb.get i).le
    let d_i := Module.finrank L F_i_L
    let e_Fi_L : F_i ≃ₐ[F] F_i_L :=
      { toExtendScalars F (D_orb.get i).le with
        invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars (D_orb.get i).le).mp y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        commutes' := fun _ => rfl }
    haveI : FiniteDimensional F F_i_L := Module.Finite.equiv e_Fi_L.toLinearEquiv
    haveI : IsScalarTower F L F_i_L := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional L F_i_L := Module.Finite.of_restrictScalars_finite F L F_i_L
    have hd_pos : 0 < d_i := Module.finrank_pos
    have hd_ne1 : d_i ≠ 1 := by
      intro h1
      have hbot : F_i_L = ⊥ := IntermediateField.finrank_eq_one_iff.mp h1
      have hle : F_i ≤ L := by
        intro x hx
        have hmem : (x : AlgebraicClosure F) ∈ F_i_L :=
          (IntermediateField.mem_extendScalars (D_orb.get i).le).mpr hx
        rw [hbot, IntermediateField.mem_bot] at hmem
        obtain ⟨y, hy⟩ := hmem
        rw [← hy]
        exact y.2
      exact not_le_of_gt (hLtFi i) hle
    have hd_ge2 : 2 ≤ d_i := by omega
    let c_ϖ : ∀ i' : Fin D_orb.length, ((D_orb.get i').field)ˣ :=
      fun i' => if h : i' = i then
        h ▸ Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom ϖ_L
      else 1
    have hc_ϖ_val : ∀ i' : Fin D_orb.length,
        valL F M_C
          (((Units.map (IntermediateField.inclusion (hFiMC i')).toMonoidHom (c_ϖ i') : M_Cˣ) : M_C)) =
          if i' = i then (k : ℤ) else 0 := by
      intro i'
      rcases eq_or_ne i' i with rfl | hne
      · have hc : c_ϖ i' =
            Units.map (IntermediateField.inclusion (D_orb.get i').le).toMonoidHom ϖ_L :=
          dif_pos rfl
        rw [if_pos rfl, hc]
        change valL F M_C (IntermediateField.inclusion hLM_C (ϖ_L : L)) = (k : ℤ)
        rw [hValAlgMCL (ϖ_L : L), hϖ_valL, mul_one]
      · have hc : c_ϖ i' = 1 := dif_neg hne
        rw [if_neg hne, hc, map_one, Units.val_one, hval1_MC]
    have hlhs_val :
        valL F M_C
          (((∏ j : Fin (q - 1),
            Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
              (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
                (c_ϖ (idx_all j))) : M_Cˣ) : M_C)) =
          ((Finset.univ.filter (fun j : Fin (q - 1) => idx_all j = i)).card : ℤ) * (k : ℤ) := by
      rw [hval_prod M_C Finset.univ (fun j : Fin (q - 1) =>
        Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
          (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
            (c_ϖ (idx_all j))))]
      have hsum_eq :
          (∑ j : Fin (q - 1),
            valL F M_C
              (((Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
                (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
                  (c_ϖ (idx_all j))) : M_Cˣ) : M_C))) =
          ∑ j : Fin (q - 1), (if idx_all j = i then (k : ℤ) else 0) := by
        refine Finset.sum_congr rfl fun j _ => ?_
        change valL F M_C
          ((σ_all j).symm
            (((Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
              (c_ϖ (idx_all j)) : M_Cˣ) : M_C))) = _
        rw [hσ_symm_val j, hc_ϖ_val (idx_all j)]
      rw [hsum_eq, ← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
    have hprod_rhs :
        (∏ i' : Fin D_orb.length, Units.map (normLM F (D_orb.get i').le) (c_ϖ i')) =
          ϖ_L ^ d_i := by
      rw [Finset.prod_eq_single i]
      · have hc : c_ϖ i =
            Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom ϖ_L :=
          dif_pos rfl
        rw [hc, hnorm_unit_inc_LFi i ϖ_L]
      · intro i' _ hne
        have hc : c_ϖ i' = 1 := dif_neg hne
        rw [hc, map_one]
      · intro hi
        exact False.elim (hi (Finset.mem_univ i))
    have hrhs_val :
        valL F M_C
          (((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
            (∏ i' : Fin D_orb.length, Units.map (normLM F (D_orb.get i').le) (c_ϖ i')) : M_Cˣ) : M_C)) =
          (d_i : ℤ) * (k : ℤ) := by
      rw [hprod_rhs]
      change valL F M_C (IntermediateField.inclusion hLM_C (((ϖ_L ^ d_i : Lˣ) : L))) = _
      rw [hValAlgMCL, hval_pow L ϖ_L d_i, hϖ_valL, mul_one, mul_comm]
    have heq_val :
        valL F M_C
          (((∏ j : Fin (q - 1),
            Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
              (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
                (c_ϖ (idx_all j))) : M_Cˣ) : M_C)) =
        valL F M_C
          (((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
            (∏ i' : Fin D_orb.length, Units.map (normLM F (D_orb.get i').le) (c_ϖ i')) : M_Cˣ) : M_C)) :=
      congrArg (fun u : M_Cˣ => valL F M_C (u : M_C)) (hν_prod c_ϖ)
    rw [hlhs_val, hrhs_val] at heq_val
    have hcard_eq : (Finset.univ.filter (fun j : Fin (q - 1) => idx_all j = i)).card = d_i := by
      apply Nat.cast_injective (R := ℤ)
      exact mul_right_cancel₀ (by omega) heq_val
    have hcard_gt1 : 1 < (Finset.univ.filter (fun j : Fin (q - 1) => idx_all j = i)).card := by
      omega
    rw [Finset.one_lt_card_iff] at hcard_gt1
    obtain ⟨j₁, j₂, hj₁, hj₂, hne⟩ := hcard_gt1
    rw [Finset.mem_filter] at hj₁ hj₂
    exact ⟨j₁, j₂, hj₁.2, hj₂.2, hne⟩

  
  let c'_χ'_Fi : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ :=
    fun i => Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c'_χ'
  let α_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ :=
    fun i => c'_χ'_Fi i * (c'_μ i)⁻¹

  have hc'_χ'_Fi_val : ∀ i : Fin D_orb.length,
      valL F (D_orb.get i).field (c'_χ'_Fi i : (D_orb.get i).field) =
        (k : ℤ) * ((a : ℤ) + condExpChar F L ψ) := by
    intro i
    rw [← (hFi_ram_reg i).2.1]
    change valL F M_C (IntermediateField.inclusion hLM_C (c'_χ' : L)) = _
    rw [hValAlgMCL (c'_χ' : L), hc_L_val]

  have hα_val : ∀ i : Fin D_orb.length,
      valL F (D_orb.get i).field (α_orb i : (D_orb.get i).field) =
        (k : ℤ) * ((a - 1 : ℕ) : ℤ) - (t : ℤ) := by
    intro i
    set F_i := (D_orb.get i).field
    haveI : FiniteDimensional F F_i := hFinFi i
    obtain ⟨_, _, _, _, hval_mul_Fi, hval_inv_Fi, _, _, _, _, _⟩ := hval_all F_i
    change valL F F_i ((c'_χ'_Fi i : F_i) * (((c'_μ i)⁻¹ : F_iˣ) : F_i)) = _
    rw [hval_mul_Fi _ _ (Units.ne_zero _) (Units.ne_zero _),
      hc'_χ'_Fi_val i, hval_inv_Fi (c'_μ i), (hc_μ_props i).2.2.1]
    have ha_sub : ((a - 1 : ℕ) : ℤ) = (a : ℤ) - 1 := by omega
    rw [ha_sub]
    ring

  have hcrit_unit : k * (a - 1) = t →
      ∀ i : Fin D_orb.length,
        let F_i := (D_orb.get i).field
        let α_i := α_orb i
        1 + ((α_i⁻¹ : F_iˣ) : F_i) ≠ 0 ∧
        valL F F_i (1 + ((α_i⁻¹ : F_iˣ) : F_i)) = 0 := by
    intro hcrit i
    dsimp only
    set F_i := (D_orb.get i).field
    haveI : FiniteDimensional F F_i := hFinFi i
    obtain ⟨hval0_Fi, hval1_Fi, hval_neg1_Fi, hval_neg_Fi, hval_mul_Fi, hval_inv_Fi, _,
      hval_add_Fi, _, _, _⟩ := hval_all F_i
    have hα_val0 : valL F F_i (α_orb i : F_i) = 0 := by
      rw [hα_val i]
      have h1 : (k : ℤ) * ((a - 1 : ℕ) : ℤ) = (t : ℤ) := by exact_mod_cast hcrit
      omega
    have hα_inv_val0 : valL F F_i (((α_orb i)⁻¹ : F_iˣ) : F_i) = 0 := by
      rw [hval_inv_Fi (α_orb i), hα_val0, neg_zero]
    let u_ϖ1 : M_Cˣ := Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (ϖ_L ^ (a - 1))
    let u_ϖ2 : M_Cˣ := (ϖ_MC ^ t)⁻¹
    let u_ϖ : M_Cˣ := u_ϖ1 * u_ϖ2
    have hu_ϖ_val0 : valL F M_C (u_ϖ : M_C) = 0 := by
      change valL F M_C ((u_ϖ1 : M_C) * (u_ϖ2 : M_C)) = 0
      rw [hval_mul_MC _ _ (Units.ne_zero u_ϖ1) (Units.ne_zero u_ϖ2)]
      have h1 : valL F M_C (u_ϖ1 : M_C) = (k : ℤ) * ((a - 1 : ℕ) : ℤ) := by
        change valL F M_C (IntermediateField.inclusion hLM_C (((ϖ_L ^ (a - 1) : Lˣ) : L))) = _
        rw [hValAlgMCL, hval_pow L ϖ_L (a - 1), hϖ_valL, mul_one]
      have h2 : valL F M_C (u_ϖ2 : M_C) = -(t : ℤ) := by
        change valL F M_C ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C)) = _
        rw [hval_inv_MC (ϖ_MC ^ t), hval_pow M_C ϖ_MC t, hϖ_valMC, mul_one]
      rw [h1, h2]
      have h3 : (k : ℤ) * ((a - 1 : ℕ) : ℤ) = (t : ℤ) := by exact_mod_cast hcrit
      omega
    have hcomm_group : ∀ (wL wMC cMC mJ : M_Cˣ),
        (wL * wMC⁻¹) * ((wL⁻¹ * cMC) * wMC * mJ⁻¹) = cMC * mJ⁻¹ := by
      intro wL wMC cMC mJ
      calc (wL * wMC⁻¹) * ((wL⁻¹ * cMC) * wMC * mJ⁻¹) =
            (wL * wL⁻¹) * (wMC⁻¹ * wMC) * (cMC * mJ⁻¹) := by ac_rfl
        _ = cMC * mJ⁻¹ := by rw [mul_inv_cancel, inv_mul_cancel, one_mul, one_mul]
    have hu_ϖ_mul : ∀ j : Fin (q - 1),
        u_ϖ * u_all j =
          Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
            (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
              (α_orb (idx_all j))) := by
      intro j
      have hcomm :=
        hcomm_group
          (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (ϖ_L ^ (condExp F L χ' - 1)))
          (ϖ_MC ^ t)
          (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c'_χ')
          (Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
            (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
              (c'_μ (idx_all j))))
      have hu_j : u_ϖ * u_all j =
          Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c'_χ' *
            (Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
              (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
                (c'_μ (idx_all j))))⁻¹ := by
        rw [hu_all_def j]
        dsimp only [u_ϖ, u_ϖ1, u_ϖ2, a]
        rw [map_mul, map_inv]
        exact hcomm
      rw [hu_j]
      apply Units.ext
      have hinc_c :
          IntermediateField.inclusion (hFiMC (idx_all j))
            ((c'_χ'_Fi (idx_all j) : (D_orb.get (idx_all j)).field)) =
          IntermediateField.inclusion hLM_C (c'_χ' : L) := rfl
      change IntermediateField.inclusion hLM_C (c'_χ' : L) *
          ((σ_all j).symm
            (IntermediateField.inclusion (hFiMC (idx_all j))
              (((c'_μ (idx_all j))⁻¹ : ((D_orb.get (idx_all j)).field)ˣ) :
                (D_orb.get (idx_all j)).field))) =
        (σ_all j).symm
          (IntermediateField.inclusion (hFiMC (idx_all j))
            ((c'_χ'_Fi (idx_all j) : (D_orb.get (idx_all j)).field) *
              (((c'_μ (idx_all j))⁻¹ : ((D_orb.get (idx_all j)).field)ˣ) :
                (D_orb.get (idx_all j)).field)))
      rw [map_mul, map_mul, hinc_c, hσ_symm_incl j (c'_χ' : L)]
    have hnot_p1 : ¬ (1 + (α_orb i : F_i) = 0 ∨ 1 ≤ valL F F_i (1 + (α_orb i : F_i))) := by
      intro h1α
      obtain ⟨j₁, j₂, hj₁, hj₂, hne⟩ := hfiber_two i
      let z_i : M_C := IntermediateField.inclusion (hFiMC i) (1 + (α_orb i : F_i))
      have hz_i_val : z_i = 0 ∨ 1 ≤ valL F M_C z_i := by
        rcases h1α with h0 | hge
        · left
          change IntermediateField.inclusion (hFiMC i) (1 + (α_orb i : F_i)) = 0
          rw [h0, map_zero]
        · right
          change 1 ≤ valL F M_C (IntermediateField.inclusion (hFiMC i) (1 + (α_orb i : F_i)))
          rw [(hFi_ram_reg i).2.1 (1 + (α_orb i : F_i))]
          exact hge
      have hfib_eq : ∀ j : Fin (q - 1), idx_all j = i →
          (u_ϖ : M_C) * (u_all j : M_C) = (σ_all j).symm z_i - 1 := by
        intro j hj
        have h1 := congrArg (fun u : M_Cˣ => (u : M_C)) (hu_ϖ_mul j)
        change (u_ϖ : M_C) * (u_all j : M_C) =
          (σ_all j).symm
            (((Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
              (α_orb (idx_all j)) : M_Cˣ) : M_C)) at h1
        have hinc_eq :
            (((Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
              (α_orb (idx_all j)) : M_Cˣ) : M_C)) =
              z_i - 1 := by
          rcases eq_or_ne (idx_all j) i with h_eq | h_ne
          · cases h_eq
            dsimp [z_i]
            rw [map_add, map_one]
            ring
          · exact False.elim (h_ne hj)
        rw [h1, hinc_eq, map_sub, map_one]
      have hdiff_eq :
          (u_ϖ : M_C) * ((u_all j₁ : M_C) - (u_all j₂ : M_C)) =
            (σ_all j₁).symm z_i + (-(σ_all j₂).symm z_i) := by
        calc (u_ϖ : M_C) * ((u_all j₁ : M_C) - (u_all j₂ : M_C)) =
