    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let bE' := condExp F L νE'
    let bM₁' := condExp F L νM₁'
    let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
    let m₂ := bE' + bM₁' - 1
    let q₁ := (m₁ + p - 1) / p
    let q₂ := (m₂ + p - 1) / p
    let a := normLM F hE'K₁ (Δ : K₁)
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let α := ((c_νE'⁻¹ : Lˣ) : L)
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    let P_E' := fun x : E' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * x ^ j
    let P_M₁' := fun z : M₁' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j
    ∀ w : K₁, (w = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ w) →
      let u₁ := 1 - normLM F hM₁'K₁ (1 - w)
      let u₂ := 1 - normLM F hE'K₁ (1 - w)
      (u₁ = 0 ∨ (q₁ : ℤ) ≤ valL F M₁' u₁) ∧
      (u₂ = 0 ∨ (q₂ : ℤ) ≤ valL F E' u₂) ∧
      ψM₁' (2 * IntermediateField.inclusion hLM₁' α * b * P_M₁' u₁) =
        ψE' (2 * IntermediateField.inclusion hLE' α * a * P_E' u₂) :=
by
  intro p bE' bM₁' m₁ m₂ q₁ q₂ a b α ψE' ψM₁' P_E' P_M₁'
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ne2 : p ≠ 2 := by omega
  have hp_ge3 : 3 ≤ p := by omega
  set T₁ := (bM₁' - 1) + p * (bE' - bM₁') + 1
  set T₂ := bM₁'
  have hdiv₁ : p * q₁ + (m₁ + p - 1) % p = m₁ + p - 1 := Nat.div_add_mod (m₁ + p - 1) p
  have hmod₁ : (m₁ + p - 1) % p < p := Nat.mod_lt (m₁ + p - 1) hp_pos
  have hpq₁_bounds : m₁ ≤ p * q₁ ∧ p * q₁ ≤ m₁ + p - 1 := by omega
  have hdiv₂ : p * q₂ + (m₂ + p - 1) % p = m₂ + p - 1 := Nat.div_add_mod (m₂ + p - 1) p
  have hmod₂ : (m₂ + p - 1) % p < p := Nat.mod_lt (m₂ + p - 1) hp_pos
  have hpq₂_bounds : m₂ ≤ p * q₂ ∧ p * q₂ ≤ m₂ + p - 1 := by omega
  have hδ_le_pδ : bE' - bM₁' ≤ p * (bE' - bM₁') := by
    simpa using Nat.mul_le_mul_right (bE' - bM₁') hp_pos
  have hm₂_le_m₁ : m₂ ≤ m₁ := by omega
  have hq₂_ge1 : 1 ≤ q₂ := Nat.div_pos (by omega) hp_pos
  have hq₂_le_q₁ : q₂ ≤ q₁ := Nat.div_le_div_right (by omega)
  have hq₁_ge1 : 1 ≤ q₁ := le_trans hq₂_ge1 hq₂_le_q₁
  have hpm₁ : p + (m₁ - 1) ≤ p * m₁ := by
    calc p + (m₁ - 1) ≤ p + p * (m₁ - 1) :=
          Nat.add_le_add_left (by simpa using Nat.mul_le_mul_right (m₁ - 1) hp_pos) p
      _ = p * m₁ := by rw [Nat.add_comm, ← Nat.mul_succ]; congr 1; omega
  have hq₁_le_m₁ : q₁ ≤ m₁ := Nat.le_of_mul_le_mul_left (by omega) hp_pos
  have hpm₂ : p + (m₂ - 1) ≤ p * m₂ := by
    calc p + (m₂ - 1) ≤ p + p * (m₂ - 1) :=
          Nat.add_le_add_left (by simpa using Nat.mul_le_mul_right (m₂ - 1) hp_pos) p
      _ = p * m₂ := by rw [Nat.add_comm, ← Nat.mul_succ]; congr 1; omega
  have hq₂_le_m₂ : q₂ ≤ m₂ := Nat.le_of_mul_le_mul_left (by omega) hp_pos
  have hT₁_ge2 : 2 ≤ T₁ := by omega
  have hT₂_ge2 : 2 ≤ T₂ := hbM₁'_ge2
  have hT₁_mul : 2 * T₁ + (p - 3) * 2 ≤ (p - 1) * T₁ := by
    calc 2 * T₁ + (p - 3) * 2 ≤ 2 * T₁ + (p - 3) * T₁ :=
          Nat.add_le_add_left (Nat.mul_le_mul_left (p - 3) hT₁_ge2) _
      _ = (2 + (p - 3)) * T₁ := (Nat.right_distrib 2 (p - 3) T₁).symm
      _ = (p - 1) * T₁ := by congr 1; omega
  have hfilt₁ : p * q₁ ≤ q₁ + (p - 1) * T₁ := by omega
  have hexp₁ : p * (m₁ - 1) + 1 ≤ p * q₁ + 2 * (p - 1) * (T₁ - 1) := by
    have h1 : p * (m₁ - 1) + 1 = m₁ + (p - 1) * (m₁ - 1) := by
      calc p * (m₁ - 1) + 1 = (1 + (p - 1)) * (m₁ - 1) + 1 := by congr 2; omega
        _ = 1 * (m₁ - 1) + (p - 1) * (m₁ - 1) + 1 := by rw [Nat.right_distrib]
        _ = m₁ + (p - 1) * (m₁ - 1) := by omega
    have h2 : (p - 1) * (m₁ - 1) ≤ 2 * (p - 1) * (T₁ - 1) := by
      rw [Nat.mul_assoc 2 (p - 1) (T₁ - 1), Nat.mul_left_comm 2 (p - 1) (T₁ - 1)]
      exact Nat.mul_le_mul_left (p - 1) (by omega)
    omega
  have hT₂_mul : 2 * T₂ + (p - 3) * 2 ≤ (p - 1) * T₂ := by
    calc 2 * T₂ + (p - 3) * 2 ≤ 2 * T₂ + (p - 3) * T₂ :=
          Nat.add_le_add_left (Nat.mul_le_mul_left (p - 3) hT₂_ge2) _
      _ = (2 + (p - 3)) * T₂ := (Nat.right_distrib 2 (p - 3) T₂).symm
      _ = (p - 1) * T₂ := by congr 1; omega
  have hδ_q₁ : bE' - bM₁' + 1 ≤ q₁ := by
    have h1 : (bE' - bM₁' + 1) * p ≤ m₁ + p - 1 := by
      rw [Nat.right_distrib, Nat.one_mul, Nat.mul_comm]
      omega
    exact (Nat.le_div_iff_mul_le hp_pos).mpr h1
  have hfilt₂ : p * q₂ ≤ q₁ + (p - 1) * T₂ := by omega
  have hexp₂ : p * (m₂ - 1) + 1 ≤ p * q₁ + 2 * (p - 1) * (T₂ - 1) := by
    have h1 : m₂ - 1 = 2 * (T₂ - 1) + (bE' - bM₁') := by omega
    have h2 : p * (2 * (T₂ - 1)) = 2 * (T₂ - 1) + 2 * (p - 1) * (T₂ - 1) := by
      calc p * (2 * (T₂ - 1)) = (1 + (p - 1)) * (2 * (T₂ - 1)) := by congr 1; omega
        _ = 1 * (2 * (T₂ - 1)) + (p - 1) * (2 * (T₂ - 1)) := Nat.right_distrib 1 (p - 1) _
        _ = 2 * (T₂ - 1) + 2 * (p - 1) * (T₂ - 1) := by ring
    rw [h1, Nat.left_distrib, h2]
    omega
  obtain ⟨hExp_M₁', hDeep_M₁'⟩ :=
    ld_ch12_wild_odd_totally_ramified_upper_edge_trunc_log_norm_expansion
      F M₁' K₁ hM₁'K₁ hGalM₁'K₁ p hPrime hWild hp_odd hdegM₁'K₁
      T₁ q₁ q₁ m₁ hT₁_ge2 hq₁_ge1 le_rfl hq₁_le_m₁ hfilt₁ hexp₁
      hval_M₁'K₁ hval_norm_M₁'K₁ htr_M₁'K₁
  obtain ⟨hExp_E', hDeep_E'⟩ :=
    ld_ch12_wild_odd_totally_ramified_upper_edge_trunc_log_norm_expansion
      F E' K₁ hE'K₁ hGalE'K₁ p hPrime hWild hp_odd hdegE'K₁
      T₂ q₁ q₂ m₂ hT₂_ge2 hq₂_ge1 hq₂_le_q₁ hq₂_le_m₂ hfilt₂ hexp₂
      hval_E'K₁ hval_norm_E'K₁ htr_E'K₁
  have hpm₂_le_pm₁ : p * m₂ ≤ p * m₁ := Nat.mul_le_mul_left p hm₂_le_m₁
  have hFilt :
      (∀ w : K₁, (w = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ w) →
        let u₁ := 1 - normLM F hM₁'K₁ (1 - w)
        let u₂ := 1 - normLM F hE'K₁ (1 - w)
        (u₁ = 0 ∨ (q₁ : ℤ) ≤ valL F M₁' u₁) ∧
        (u₂ = 0 ∨ (q₂ : ℤ) ≤ valL F E' u₂)) ∧
      (∀ w : K₁, (w = 0 ∨ ((p * m₁ : ℕ) : ℤ) ≤ valL F K₁ w) →
        let u₁ := 1 - normLM F hM₁'K₁ (1 - w)
        let u₂ := 1 - normLM F hE'K₁ (1 - w)
        (P_M₁' u₁ = 0 ∨ (m₁ : ℤ) ≤ valL F M₁' (P_M₁' u₁)) ∧
        (P_E' u₂ = 0 ∨ (m₂ : ℤ) ≤ valL F E' (P_E' u₂))) := by
    refine ⟨fun w hw => ⟨(hExp_M₁' w hw).1, (hExp_E' w hw).1⟩, fun w hw => ⟨(hDeep_M₁' w hw).2, ?_⟩⟩
    have hw₂ : w = 0 ∨ ((p * m₂ : ℕ) : ℤ) ≤ valL F K₁ w :=
      hw.imp id (fun h => le_trans (by exact_mod_cast hpm₂_le_pm₁) h)
    exact (hDeep_E' w hw₂).2
  have hTeich_vanish :=
    ld_ch12_wild_odd_totally_ramified_teichmuller_weighted_sum_monomial_vanish
      F L E' M₁' K₁ hLE' hLM₁' hE'K₁ hM₁'K₁
      hPrime hWild hp_odd hdegM₁' hdegE'K₁ hdegM₁'K₁
      ψ hψ νE' νM₁' hbE'_ge2 hbM₁'_ge2 hb_le
      hval_LE' hval_LM₁' hval_E'K₁ hval_norm_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁
      htr_LE' htr_LM₁' htr_E'K₁ htr_M₁'K₁
      Δ hΔ_val ha_val hb_val c_νE' hc_νE'_val hMono_vanish hExp_M₁' hExp_E'
  exact ld_ch12_wild_odd_totally_ramified_unit_model_descending_induction
    F L E' M₁' K₁ hLE' hLM₁' hE'K₁ hM₁'K₁
    hPrime hWild hp_odd ψ hψ νE' νM₁' hbE'_ge2 hbM₁'_ge2 hb_le hp_valK₁
    hval_LE' hval_E'K₁ htr_LE' htr_LM₁'
    Δ hΔ_val ha_val hb_val hΔ_basis c_νE' hc_νE'_val hP_M₁' hP_E' hFilt hTeich_vanish

theorem ld_wild_odd_tot_ram_one_over_p_coboundary_char_and_twist_exp_p3 (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (ψ : AddChar L (Ω F))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣
      (condExp F L νM₁' - 1)))
    (hp_valE' : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : E') = 0 ∨
      (1 : ℤ) ≤ valL F E' ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : E'))
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          (condExp F L νE' : ℤ))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hGalLift_E' : ∀ σ : E' ≃ₐ[F] E',
      (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) →
      ∃ σ_lift : K₁ ≃ₐ[F] K₁,
        (∀ z : M₁', σ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ z) ∧
        (∀ y : E', σ_lift (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hE'K₁ (σ y)) ∧
        (∀ w : K₁, valL F K₁ (σ_lift w) = valL F K₁ w) ∧
        (∀ w : K₁,
          normLM F hM₁'K₁ (σ_lift w) = normLM F hM₁'K₁ w ∧
          normLM F hE'K₁ (σ_lift w) = σ (normLM F hE'K₁ w)))
    (χ₂ : E'ˣ →* (Ω F)ˣ)
    (hχ₂_twists : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
      let m₂ := condExp F L νE' + condExp F L νM₁' - 1
      condExp F E' (ξE' ^ j * χ₂) = m₂ ∧
      (∀ u ∈ unitGroup F E' m₂, (ξE' ^ j * χ₂) u = 1) ∧
      ∃ σ : E' ≃ₐ[F] E',
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
        ∀ y : E'ˣ, (ξE' ^ j * χ₂) y = χ₂ (Units.map σ.toRingEquiv.toMonoidHom y))
    (c_νE' : Lˣ)
    (hc_νE'_val : valL F L (c_νE' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (c₂₀ : E'ˣ)
    (hc₂₀_val : valL F E' (c₂₀ : E') =
      ((condExp F L νE' + condExp F L νM₁' - 1 : ℕ) : ℤ) +
        condExpChar F E' (traceChar F hLE' ψ))
    (hc₂₀_log :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₂ := condExp F L νE' + condExp F L νM₁' - 1
      let q₂ := (m₂ + p - 1) / p
      let P_E' := fun x : E' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * x ^ j
      ∀ x : E', (x = 0 ∨ (q₂ : ℤ) ≤ valL F E' x) →
        ∀ hx : 1 - x ≠ 0,
          (χ₂ (Units.mk0 (1 - x) hx) : Ω F) ^ 2 =
            (traceChar F hLE' ψ) (- 2 * ((c₂₀⁻¹ : E'ˣ) : E') * P_E' x))
    (hP_E' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₂ := condExp F L νE' + condExp F L νM₁' - 1
      let q₂ := (m₂ + p - 1) / p
      let P_E' := fun x : E' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * x ^ j
      ∀ x y : E',
        (x = 0 ∨ (q₂ : ℤ) ≤ valL F E' x) →
        (y = 0 ∨ (q₂ : ℤ) ≤ valL F E' y) →
        (x + y - x * y = 0 ∨ (q₂ : ℤ) ≤ valL F E' (x + y - x * y)) ∧
        (P_E' x = 0 ∨ (q₂ : ℤ) ≤ valL F E' (P_E' x)) ∧
        (P_E' (x + y - x * y) - P_E' x - P_E' y = 0 ∨
          (m₂ : ℤ) ≤ valL F E' (P_E' (x + y - x * y) - P_E' x - P_E' y)))
    (Δ₀ : K₁ˣ)
    (ha₀_val : valL F E' (normLM F hE'K₁ (Δ₀ : K₁)) = -((condExp F L νM₁' - 1 : ℕ) : ℤ))
    (hCompat_Δ₀ :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let bM₁' := condExp F L νM₁'
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      let m₂ := bE' + bM₁' - 1
      let q₁ := (m₁ + p - 1) / p
      let q₂ := (m₂ + p - 1) / p
      let α := ((c_νE'⁻¹ : Lˣ) : L)
      let ψE' := traceChar F hLE' ψ
      let ψM₁' := traceChar F hLM₁' ψ
      let P_E' := fun x : E' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * x ^ j
      let P_M₁' := fun z : M₁' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j
      ∀ w : K₁, (w = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ w) →
        let u₁ := 1 - normLM F hM₁'K₁ (1 - w)
        let u₂ := 1 - normLM F hE'K₁ (1 - w)
        (u₁ = 0 ∨ (q₁ : ℤ) ≤ valL F M₁' u₁) ∧
        (u₂ = 0 ∨ (q₂ : ℤ) ≤ valL F E' u₂) ∧
        ψM₁' (2 * IntermediateField.inclusion hLM₁' α * normLM F hM₁'K₁ (Δ₀ : K₁) * P_M₁' u₁) =
          ψE' (2 * IntermediateField.inclusion hLE' α * normLM F hE'K₁ (Δ₀ : K₁) * P_E' u₂))
    (hCoker_E' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := condExp F L νM₁' - 1
      let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
      ∀ (Φ₀ : E'ˣ →* (Ω F)ˣ),
        (∀ u ∈ unitGroup F E' (t₁ + 1), Φ₀ u = 1) →
        (∀ w : K₁ˣ, Φ₀ (Units.map (normLM F hE'K₁) w) = 1) →
        (∃ u₁ ∈ unitGroup F E' t₁, Φ₀ u₁ ≠ 1) →
        ∃ j < p, 0 < j ∧ ∀ y : E'ˣ, (ξE' y) ^ 2 = (Φ₀ y) ^ j)
    (hτ₀_exists : ∃ τ₀ : E' ≃ₐ[F] E',
      (∀ x : L, τ₀ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
      ∃ y₀ : E', τ₀ y₀ ≠ y₀)
    (hψE'_α_triv :
      let bE' := condExp F L νE'
      let α := ((c_νE'⁻¹ : Lˣ) : L)
      let ψE' := traceChar F hLE' ψ
      ∀ Z : E', (Z = 0 ∨ (bE' : ℤ) ≤ valL F E' Z) →
        ψE' (IntermediateField.inclusion hLE' α * Z) = 1)
    (hσ_props :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let bM₁' := condExp F L νM₁'
      let t₂ := bE' - 1
      let m₂ := bE' + bM₁' - 1
      let α := ((c_νE'⁻¹ : Lˣ) : L)
      let ψE' := traceChar F hLE' ψ
      ∀ σ : E' ≃ₐ[F] E',
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) →
        (∀ y : E',
          valL F E' (σ y) = valL F E' y ∧
          normLM F hLE' (σ y) = normLM F hLE' y ∧
          ψE' (σ y) = ψE' y) ∧
        (∀ y : E'ˣ,
          let w_y := ((((Units.map σ.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E')) - 1
          (w_y = 0 ∨ (t₂ : ℤ) ≤ valL F E' w_y) ∧
          normLM F hLE' (1 + w_y) - 1 = 0) ∧
        (∀ u ∈ unitGroup F E' bM₁',
          let w_u := ((((Units.map σ.toRingEquiv.toMonoidHom u) * u⁻¹ : E'ˣ) : E')) - 1
          w_u = 0 ∨ (m₂ : ℤ) ≤ valL F E' w_u) ∧
        ((∃ y₀ : E', σ y₀ ≠ y₀) →
          ∀ (r : ℕ), 1 ≤ r → ¬ (p ∣ r) →
            ∀ Y : E', (Y = 0 ∨ -(r : ℤ) ≤ valL F E' Y) →
              ¬ (Y = 0 ∨ -(r : ℤ) + 1 ≤ valL F E' Y) →
              ∃ u₁ ∈ unitGroup F E' r,
                let w₁ := ((((Units.map σ.toRingEquiv.toMonoidHom u₁) * u₁⁻¹ : E'ˣ) : E')) - 1
                ψE' (IntermediateField.inclusion hLE' α * Y * (2 * w₁ - w₁ ^ 2)) ≠ 1 ∧
                (ψE' (IntermediateField.inclusion hLE' α * Y * (2 * w₁ - w₁ ^ 2))) ^ p = 1))
    (hσ_lift_props :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let bM₁' := condExp F L νM₁'
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      let d₁ := m₁ / 2
      ∀ σ_lift : K₁ ≃ₐ[F] K₁,
        (∀ z : M₁', σ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ z) →
        (∀ w : K₁, valL F K₁ (σ_lift w) = valL F K₁ w) →
        ∀ v : K₁ˣ,
          let w_v := ((((Units.map σ_lift.toRingEquiv.toMonoidHom v) * v⁻¹ : K₁ˣ) : K₁)) - 1
          w_v = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ w_v) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let bM₁' := condExp F L νM₁'
    let t₁ := bM₁' - 1
    let α := ((c_νE'⁻¹ : Lˣ) : L)
    let ψE' := traceChar F hLE' ψ
    let P_E' := fun x : E' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * x ^ j
    let a₀ := normLM F hE'K₁ (Δ₀ : K₁)
    let B₂ := - (IntermediateField.inclusion hLE' (c_νE' : L) * ((c₂₀⁻¹ : E'ˣ) : E'))
    valL F E' B₂ = -(t₁ : ℤ) ∧
    (∀ (r : ℕ), 1 ≤ r → r ≤ t₁ → ¬ (p ∣ r) →
      ∀ (σ : E' ≃ₐ[F] E'),
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) →
        (∃ y₀ : E', σ y₀ ≠ y₀) →
        ∀ Y : E', (Y = 0 ∨ -(r : ℤ) ≤ valL F E' Y) →
          (∀ u₁ ∈ unitGroup F E' r,
            let x₁ := 1 - ((((Units.map σ.toRingEquiv.toMonoidHom u₁) * u₁⁻¹ : E'ˣ) : E'))
            ψE' (2 * IntermediateField.inclusion hLE' α * Y * P_E' x₁) = 1) →
          (Y = 0 ∨ -(r : ℤ) + 1 ≤ valL F E' Y)) ∧
    ∃ (j : ℕ) (σ : E' ≃ₐ[F] E'),
      0 < j ∧ j < p ∧
      (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
      (∃ y₀ : E', σ y₀ ≠ y₀) ∧
      (∀ y : E'ˣ,
        let x_y := 1 - ((((Units.map σ.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E'))
        ψE' (2 * IntermediateField.inclusion hLE' α * (B₂ - (j : E') * a₀) * P_E' x_y) = 1) :=
by
  classical
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  set bE' := condExp F L νE'
  set bM₁' := condExp F L νM₁'
  set t₁ := bM₁' - 1
  set t₂ := bE' - 1
  set m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
  set m₂ := bE' + bM₁' - 1
  set q₁ := (m₁ + p - 1) / p
  set q₂ := (m₂ + p - 1) / p
  set d₁ := m₁ / 2
  set α := ((c_νE'⁻¹ : Lˣ) : L)
  set ψE' := traceChar F hLE' ψ
  set ψM₁' := traceChar F hLM₁' ψ
  set ξE' := νM₁'.comp (Units.map (normLM F hLE'))
  set P_E' := fun x : E' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * x ^ j
  set P_M₁' := fun z : M₁' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j
  set a₀ := normLM F hE'K₁ (Δ₀ : K₁)
  set B₂ := - (IntermediateField.inclusion hLE' (c_νE' : L) * ((c₂₀⁻¹ : E'ˣ) : E'))

  
  obtain ⟨hval0_E', hval1_E', hval_neg1_E', hval_neg_E', hval_mul_E', hval_inv_E',
    _, hval_add_E', _, _, _⟩ := hvalE'_props
  obtain ⟨_, _, _, hval_neg_K₁, _, _, _, _, _, _, _⟩ := hvalK₁_props

  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_gt2 : 2 < p := lt_of_le_of_ne hp_ge2 (Ne.symm hp_odd)
  have hp_ge3 : 3 ≤ p := by omega

  have hq₂_le_t₂ : q₂ ≤ t₂ := by
    by_contra hlt
    have hge : t₂ + 1 ≤ q₂ := by omega
    have hdiv : p * q₂ + (m₂ + p - 1) % p = m₂ + p - 1 := Nat.div_add_mod (m₂ + p - 1) p
    have hm1 : p * t₂ + p * 1 ≤ p * q₂ := by
      rw [← Nat.mul_add]
      exact Nat.mul_le_mul_left p hge
    have hm2 : 3 * t₂ ≤ p * t₂ := Nat.mul_le_mul_right t₂ hp_ge3
    dsimp only [m₂, t₂] at hdiv hm1 hm2
    omega

  have hq₁_le_d₁ : q₁ ≤ d₁ := by
    by_contra hlt
    have hge : d₁ + 1 ≤ q₁ := by omega
    have hdiv1 : p * q₁ + (m₁ + p - 1) % p = m₁ + p - 1 := Nat.div_add_mod (m₁ + p - 1) p
    have hdiv2 : 2 * d₁ + m₁ % 2 = m₁ := Nat.div_add_mod m₁ 2
    have hm1 : p * d₁ + p * 1 ≤ p * q₁ := by
      rw [← Nat.mul_add]
      exact Nat.mul_le_mul_left p hge
    have hm2 : 3 * d₁ ≤ p * d₁ := Nat.mul_le_mul_right d₁ hp_ge3
    have hm₁_ge3 : 3 ≤ m₁ := by dsimp [m₁]; omega
    omega

  have hc_νE'_ne0 : IntermediateField.inclusion hLE' (c_νE' : L) ≠ 0 :=
    (IntermediateField.inclusion hLE').injective.ne (Units.ne_zero c_νE')
  have hc₂₀_inv_ne0 : ((c₂₀⁻¹ : E'ˣ) : E') ≠ 0 := Units.ne_zero c₂₀⁻¹
  have hB₂_val : valL F E' B₂ = -(t₁ : ℤ) := by
    dsimp only [B₂]
    rw [hval_neg_E', hval_mul_E' _ _ hc_νE'_ne0 hc₂₀_inv_ne0, hval_LE' (c_νE' : L),
      hc_νE'_val, hval_inv_E' c₂₀, hc₂₀_val, hnE'_eq]
    have hp_sub : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
    have hm₂_cast : ((bE' + bM₁' - 1 : ℕ) : ℤ) = (bE' : ℤ) + (bM₁' : ℤ) - 1 := by omega
    have ht₁_cast : (t₁ : ℤ) = (bM₁' : ℤ) - 1 := by omega
    rw [hp_sub, hm₂_cast, ht₁_cast]
    ring

  
  let u_ψE' : E' → (Ω F)ˣ := fun x =>
    ⟨ψE' x, ψE' (-x),
      by rw [← AddChar.map_add_eq_mul, add_neg_cancel, AddChar.map_zero_eq_one],
      by rw [← AddChar.map_add_eq_mul, neg_add_cancel, AddChar.map_zero_eq_one]⟩
  have hu_ψE'_zero : u_ψE' 0 = 1 := Units.ext (AddChar.map_zero_eq_one ψE')
  have hu_ψE'_add : ∀ x y : E', u_ψE' (x + y) = u_ψE' x * u_ψE' y :=
    fun x y => Units.ext (AddChar.map_add_eq_mul ψE' x y)
  have hu_ψE'_neg : ∀ x : E', u_ψE' (-x) = (u_ψE' x)⁻¹ := by
    intro x
    apply mul_left_cancel (a := u_ψE' x)
    rw [← hu_ψE'_add, add_neg_cancel, hu_ψE'_zero, mul_inv_cancel]
  have hu_ψE'_eq_one : ∀ x : E', u_ψE' x = 1 ↔ ψE' x = 1 :=
    fun x => ⟨fun h => congrArg Units.val h, fun h => Units.ext h⟩
  have hu_ψE'_pow : ∀ (k : ℕ) (x : E'), (u_ψE' x) ^ k = u_ψE' ((k : E') * x) := by
    intro k x
    induction k with
    | zero => simp [hu_ψE'_zero]
    | succ k ih =>
      rw [pow_succ, ih, Nat.cast_add, Nat.cast_one, right_distrib, one_mul, hu_ψE'_add]

  
  have hval_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : E'),
      (x = 0 ∨ k₁ ≤ valL F E' x) → (y = 0 ∨ k₂ ≤ valL F E' y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F E' (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        rcases hx with rfl | hx_ge
        · contradiction
        · rcases hy with rfl | hy_ge
          · contradiction
          · rw [hval_mul_E' x y hx0 hy0]
            linarith

  have hval_neg_ge : ∀ (k : ℤ) (x : E'),
      (x = 0 ∨ k ≤ valL F E' x) → (-x = 0 ∨ k ≤ valL F E' (-x)) := by
    intro k x hx
    rcases hx with rfl | hx_ge
    · exact Or.inl neg_zero
    · right
      rw [hval_neg_E' x]
      exact hx_ge

  have hval_sub_ge : ∀ (k : ℤ) (x y : E'),
      (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
        (x - y = 0 ∨ k ≤ valL F E' (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hval_add_E' k x (-y) hx (hval_neg_ge k y hy)

  have hval_ge_mono : ∀ (k₁ k₂ : ℤ) (x : E'),
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F E' x) → (x = 0 ∨ k₁ ≤ valL F E' x) := by
    intro k₁ k₂ x hle hx
    rcases hx with rfl | hx_ge
    · exact Or.inl rfl
    · exact Or.inr (le_trans hle hx_ge)

  have hval_pow_ge : ∀ (k : ℤ) (x : E'),
      (x = 0 ∨ k ≤ valL F E' x) →
        ∀ n : ℕ, x ^ n = 0 ∨ (n : ℤ) * k ≤ valL F E' (x ^ n) := by
    intro k x hx n
    induction n with
    | zero =>
      rw [pow_zero, Nat.cast_zero, zero_mul, hval1_E']
      exact Or.inr le_rfl
    | succ n ih =>
      rw [pow_succ]
      have hmul := hval_mul_ge ((n : ℤ) * k) k (x ^ n) x ih hx
      have heq : ((n + 1 : ℕ) : ℤ) * k = (n : ℤ) * k + k := by push_cast; ring
      rwa [heq]

  have hval_finset_sum_E' : ∀ (S : Finset ℕ) (f : ℕ → E') (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F E' (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F E' (∑ i ∈ S, f i)) := by
    intro S f k hS
    induction' S using Finset.induction_on with a s ha ih
    · rw [Finset.sum_empty]
      exact Or.inl rfl
    · rw [Finset.sum_insert ha]
      exact hval_add_E' k (f a) (∑ i ∈ s, f i)
        (hS a (Finset.mem_insert_self a s))
        (ih (fun i hi => hS i (Finset.mem_insert_of_mem hi)))

  have hval_strict_E' : ∀ (y₁ y₂ : E'),
      y₁ ≠ 0 → (y₂ = 0 ∨ valL F E' y₁ + 1 ≤ valL F E' y₂) →
        y₁ + y₂ ≠ 0 ∧ valL F E' (y₁ + y₂) = valL F E' y₁ := by
    intro y₁ y₂ hy₁ hy₂
    set v₁ : ℤ := valL F E' y₁
    have hy₂_ge : y₂ = 0 ∨ v₁ ≤ valL F E' y₂ := by
      rcases hy₂ with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum_ge : y₁ + y₂ = 0 ∨ v₁ ≤ valL F E' (y₁ + y₂) :=
      hval_add_E' v₁ y₁ y₂ (Or.inr le_rfl) hy₂_ge
    have hnot_gt : ¬ (y₁ + y₂ = 0 ∨ v₁ + 1 ≤ valL F E' (y₁ + y₂)) := by
      intro hgt
      have hneg_y₂ : -y₂ = 0 ∨ v₁ + 1 ≤ valL F E' (-y₂) := by
        rcases hy₂ with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right
          rw [hval_neg_E']
          exact hge
      have hy₁_gt := hval_add_E' (v₁ + 1) (y₁ + y₂) (-y₂) hgt hneg_y₂
      have heq_y₁ : (y₁ + y₂) + (-y₂) = y₁ := by ring
      rw [heq_y₁] at hy₁_gt
      rcases hy₁_gt with h10 | h1ge
      · exact hy₁ h10
      · omega
    have hsum_ne : y₁ + y₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
    have hsum_v₁ : v₁ ≤ valL F E' (y₁ + y₂) := hsum_ge.resolve_left hsum_ne
    have hsum_not1 : ¬ (v₁ + 1 ≤ valL F E' (y₁ + y₂)) := fun h1 => hnot_gt (Or.inr h1)
    exact ⟨hsum_ne, by omega⟩

  have hval_natCast_E' : ∀ n : ℕ, (n : E') = 0 ∨ (0 : ℤ) ≤ valL F E' (n : E') := by
    intro n
    induction n with
    | zero => exact Or.inl Nat.cast_zero
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hval_add_E' 0 (n : E') 1 ih (Or.inr (by rw [hval1_E']))

  have hval_intCast_E' : ∀ z : ℤ, (z : E') = 0 ∨ (0 : ℤ) ≤ valL F E' (z : E') := by
    intro z
    cases z with
    | ofNat n =>
      simpa using hval_natCast_E' n
    | negSucc n =>
      rw [Int.cast_negSucc]
      exact hval_neg_ge 0 ((n + 1 : ℕ) : E') (hval_natCast_E' (n + 1))

  have hval_neg_ge_K₁ : ∀ (k : ℤ) (w : K₁),
      (w = 0 ∨ k ≤ valL F K₁ w) → (-w = 0 ∨ k ≤ valL F K₁ (-w)) := by
    intro k w hw
    rcases hw with rfl | hw_ge
    · exact Or.inl neg_zero
    · right
      rw [hval_neg_K₁ w]
      exact hw_ge

  have hval_ge_mono_K₁ : ∀ (k₁ k₂ : ℤ) (w : K₁),
      k₁ ≤ k₂ → (w = 0 ∨ k₂ ≤ valL F K₁ w) → (w = 0 ∨ k₁ ≤ valL F K₁ w) := by
    intro k₁ k₂ w hle hw
    rcases hw with rfl | hw_ge
    · exact Or.inl rfl
    · exact Or.inr (le_trans hle hw_ge)

  
  have hcoprime_unit_E' : ∀ i : ℕ, 1 ≤ i → i < p →
      ((i : ℕ) : E') ≠ 0 ∧ valL F E' ((i : ℕ) : E') = 0 ∧ valL F E' (((i : ℕ) : E')⁻¹) = 0 := by
    intro i hi_ge1 hi_lt
    have hcop : Nat.Coprime i p :=
      ((Nat.Prime.coprime_iff_not_dvd hPrime).mpr (Nat.not_dvd_of_pos_of_lt (by omega) hi_lt)).symm
    have hbez : (i : E') * (Nat.gcdA i p : E') =
        (1 : E') + (- (((p : ℕ) : E') * (Nat.gcdB i p : E'))) := by
      have h := congrArg (Int.cast : ℤ → E') (Nat.gcd_eq_gcd_ab i p)
      rw [hcop.gcd_eq_one] at h
      push_cast at h
      linear_combination -h
    have hw₂_ge : - (((p : ℕ) : E') * (Nat.gcdB i p : E')) = 0 ∨
        valL F E' (1 : E') + 1 ≤ valL F E' (- (((p : ℕ) : E') * (Nat.gcdB i p : E'))) := by
      have hmul := hval_mul_ge 1 0 ((p : ℕ) : E') (Nat.gcdB i p : E')
        hp_valE' (hval_intCast_E' (Nat.gcdB i p))
      have hneg := hval_neg_ge (1 + 0) (((p : ℕ) : E') * (Nat.gcdB i p : E')) hmul
      rcases hneg with h0 | hge
      · exact Or.inl h0
      · right
        rw [hval1_E']
        omega
    have hstrict := hval_strict_E' (1 : E') (- (((p : ℕ) : E') * (Nat.gcdB i p : E')))
      one_ne_zero hw₂_ge
    rw [← hbez, hval1_E'] at hstrict
    have hi_ne0 : (i : E') ≠ 0 := left_ne_zero_of_mul hstrict.1
    have ha_ne0 : (Nat.gcdA i p : E') ≠ 0 := right_ne_zero_of_mul hstrict.1
    have hi_ge0 : 0 ≤ valL F E' (i : E') := (hval_natCast_E' i).resolve_left hi_ne0
    have ha_ge0 : 0 ≤ valL F E' (Nat.gcdA i p : E') :=
      (hval_intCast_E' (Nat.gcdA i p)).resolve_left ha_ne0
    have hmul_val := hstrict.2
    rw [hval_mul_E' (i : E') (Nat.gcdA i p : E') hi_ne0 ha_ne0] at hmul_val
    have hi_val0 : valL F E' ((i : ℕ) : E') = 0 := by omega
    have hi_inv_val0 : valL F E' (((i : ℕ) : E')⁻¹) = 0 := by
      have hu := hval_inv_E' (Units.mk0 ((i : ℕ) : E') hi_ne0)
      rw [Units.val_inv_eq_inv_val, Units.val_mk0, hi_val0, neg_zero] at hu
      exact hu
    exact ⟨hi_ne0, hi_val0, hi_inv_val0⟩

  have h2_unit := hcoprime_unit_E' 2 (by omega) hp_gt2
  have h2_ne0 : (2 : E') ≠ 0 := by simpa using h2_unit.1
  have h2_val0 : valL F E' (2 : E') = 0 := by simpa using h2_unit.2.1

  have hP_M₁'_zero : P_M₁' 0 = 0 := by
    dsimp only [P_M₁']
    apply Finset.sum_eq_zero
    intro j hj
    have hj_ge1 : 1 ≤ j := (Finset.mem_Icc.mp hj).1
    rw [zero_pow (by omega), mul_zero]

  have hP_E'_val_ge : ∀ (m : ℤ), 0 ≤ m → ∀ x : E',
      (x = 0 ∨ m ≤ valL F E' x) → (P_E' x = 0 ∨ m ≤ valL F E' (P_E' x)) := by
    intro m hm x hx
    dsimp only [P_E']
    apply hval_finset_sum_E'
    intro j hj
    have hj_bounds := Finset.mem_Icc.mp hj
    have hj_inv : (((j : ℕ) : E')⁻¹) = 0 ∨ 0 ≤ valL F E' (((j : ℕ) : E')⁻¹) :=
      Or.inr (by rw [(hcoprime_unit_E' j hj_bounds.1 (by omega)).2.2])
    have hx_pow := hval_pow_ge m x hx j
    have hterm := hval_mul_ge 0 ((j : ℤ) * m) (((j : ℕ) : E')⁻¹) (x ^ j) hj_inv hx_pow
    refine hval_ge_mono m (0 + (j : ℤ) * m) _ ?_ hterm
    have hj1 : (1 : ℤ) ≤ (j : ℤ) := by omega
    nlinarith

  have hP_E'_split2 : ∀ x : E',
      P_E' x = x + (2 : E')⁻¹ * x ^ 2 + ∑ j ∈ Finset.Icc 3 (p - 1), ((j : ℕ) : E')⁻¹ * x ^ j := by
    intro x
    have hIcc1 : Finset.Icc 1 (p - 1) = insert 1 (Finset.Icc 2 (p - 1)) := by
      ext j; simp only [Finset.mem_Icc, Finset.mem_insert]; omega
    have hIcc2 : Finset.Icc 2 (p - 1) = insert 2 (Finset.Icc 3 (p - 1)) := by
      ext j; simp only [Finset.mem_Icc, Finset.mem_insert]; omega
    have h1_not : 1 ∉ Finset.Icc 2 (p - 1) := by simp [Finset.mem_Icc]
    have h2_not : 2 ∉ Finset.Icc 3 (p - 1) := by simp [Finset.mem_Icc]
    dsimp only [P_E']
    rw [hIcc1, Finset.sum_insert h1_not, hIcc2, Finset.sum_insert h2_not,
      Nat.cast_one, inv_one, pow_one, one_mul, Nat.cast_two, add_assoc]

  have hP_E'_eq_quad : ∀ Y w : E',
      (Y = 0 ∨ -(t₁ : ℤ) ≤ valL F E' Y) →
      (w = 0 ∨ (t₂ : ℤ) ≤ valL F E' w) →
      ψE' (2 * IntermediateField.inclusion hLE' α * Y * P_E' (-w)) =
        ψE' (IntermediateField.inclusion hLE' α * (-Y) * (2 * w - w ^ 2)) := by
    intro Y w hY hw
    have h2_inv : (2 : E') * (2 : E')⁻¹ = 1 := mul_inv_cancel₀ h2_ne0
    set tail := ∑ j ∈ Finset.Icc 3 (p - 1), ((j : ℕ) : E')⁻¹ * (-w) ^ j
    have h_alg : 2 * IntermediateField.inclusion hLE' α * Y * P_E' (-w) =
        IntermediateField.inclusion hLE' α * (-Y) * (2 * w - w ^ 2) +
        IntermediateField.inclusion hLE' α * (2 * Y * tail) := by
      rw [hP_E'_split2 (-w)]
      change 2 * IntermediateField.inclusion hLE' α * Y *
          (-w + (2 : E')⁻¹ * (-w) ^ 2 + tail) = _
      calc 2 * IntermediateField.inclusion hLE' α * Y * (-w + (2 : E')⁻¹ * (-w) ^ 2 + tail)
          = IntermediateField.inclusion hLE' α * (-Y) *
              (2 * w - ((2 : E') * (2 : E')⁻¹) * w ^ 2) +
            IntermediateField.inclusion hLE' α * (2 * Y * tail) := by ring
        _ = IntermediateField.inclusion hLE' α * (-Y) * (2 * w - w ^ 2) +
            IntermediateField.inclusion hLE' α * (2 * Y * tail) := by rw [h2_inv, one_mul]
    have hnw : -w = 0 ∨ (t₂ : ℤ) ≤ valL F E' (-w) := hval_neg_ge (t₂ : ℤ) w hw
    have htail_val : tail = 0 ∨ 3 * (t₂ : ℤ) ≤ valL F E' tail := by
      dsimp only [tail]
      apply hval_finset_sum_E'
      intro j hj
      have hj_bounds := Finset.mem_Icc.mp hj
      have hj_inv : (((j : ℕ) : E')⁻¹) = 0 ∨ 0 ≤ valL F E' (((j : ℕ) : E')⁻¹) :=
        Or.inr (by rw [(hcoprime_unit_E' j (by omega) (by omega)).2.2])
      have hnw_pow := hval_pow_ge (t₂ : ℤ) (-w) hnw j
      have hterm := hval_mul_ge 0 ((j : ℤ) * (t₂ : ℤ)) (((j : ℕ) : E')⁻¹) ((-w) ^ j) hj_inv hnw_pow
      refine hval_ge_mono (3 * (t₂ : ℤ)) (0 + (j : ℤ) * (t₂ : ℤ)) _ ?_ hterm
      have hj3 : (3 : ℤ) ≤ (j : ℤ) := by omega
      have ht₂0 : (0 : ℤ) ≤ (t₂ : ℤ) := by omega
      nlinarith
    have h2Y_val : 2 * Y = 0 ∨ -(t₁ : ℤ) ≤ valL F E' (2 * Y) := by
      have hmul := hval_mul_ge 0 (-(t₁ : ℤ)) (2 : E') Y (Or.inr (by rw [h2_val0])) hY
      rwa [zero_add] at hmul
    have hrem_bE' : 2 * Y * tail = 0 ∨ (bE' : ℤ) ≤ valL F E' (2 * Y * tail) := by
      have hmul := hval_mul_ge (-(t₁ : ℤ)) (3 * (t₂ : ℤ)) (2 * Y) tail h2Y_val htail_val
      exact hval_ge_mono (bE' : ℤ) (-(t₁ : ℤ) + 3 * (t₂ : ℤ)) (2 * Y * tail) (by omega) hmul
    rw [h_alg, AddChar.map_add_eq_mul, hψE'_α_triv (2 * Y * tail) hrem_bE', mul_one]

  
  have hP_E'_nondiv_witness : ∀ (r : ℕ), 1 ≤ r → r ≤ t₁ → ¬ (p ∣ r) →
      ∀ (σ : E' ≃ₐ[F] E'),
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) →
        (∃ y₀ : E', σ y₀ ≠ y₀) →
        ∀ Y : E', (Y = 0 ∨ -(r : ℤ) ≤ valL F E' Y) →
          ¬ (Y = 0 ∨ -(r : ℤ) + 1 ≤ valL F E' Y) →
          ∃ u₁ ∈ unitGroup F E' r,
            let x₁ := 1 - ((((Units.map σ.toRingEquiv.toMonoidHom u₁) * u₁⁻¹ : E'ˣ) : E'))
            ψE' (2 * IntermediateField.inclusion hLE' α * Y * P_E' x₁) ≠ 1 ∧
            (ψE' (2 * IntermediateField.inclusion hLE' α * Y * P_E' x₁)) ^ p = 1 := by
    intro r hr_ge1 hr_le_t₁ hndvd σ hσ_L hσ_ne Y hY_ge hY_not
    have hnY_ge : -Y = 0 ∨ -(r : ℤ) ≤ valL F E' (-Y) := hval_neg_ge (-(r : ℤ)) Y hY_ge
    have hnY_not : ¬ (-Y = 0 ∨ -(r : ℤ) + 1 ≤ valL F E' (-Y)) := by
      rintro (h0 | hgt)
      · exact hY_not (Or.inl (neg_eq_zero.mp h0))
      · rw [hval_neg_E' Y] at hgt
        exact hY_not (Or.inr hgt)
    obtain ⟨u₁, hu₁_mem, hu₁_ne1, hu₁_pow_p⟩ :=
      (hσ_props σ hσ_L).2.2.2 hσ_ne r hr_ge1 hndvd (-Y) hnY_ge hnY_not
    set w₁ : E' := ((((Units.map σ.toRingEquiv.toMonoidHom u₁) * u₁⁻¹ : E'ˣ) : E')) - 1
    set x₁ : E' := 1 - ((((Units.map σ.toRingEquiv.toMonoidHom u₁) * u₁⁻¹ : E'ˣ) : E'))
    have hx₁_eq : x₁ = -w₁ := by dsimp [x₁, w₁]; ring
    have hY_t₁ : Y = 0 ∨ -(t₁ : ℤ) ≤ valL F E' Y :=
      hval_ge_mono (-(t₁ : ℤ)) (-(r : ℤ)) Y (by omega) hY_ge
    have hw₁_t₂ : w₁ = 0 ∨ (t₂ : ℤ) ≤ valL F E' w₁ := ((hσ_props σ hσ_L).2.1 u₁).1
    have hbridge : ψE' (2 * IntermediateField.inclusion hLE' α * Y * P_E' x₁) =
        ψE' (IntermediateField.inclusion hLE' α * (-Y) * (2 * w₁ - w₁ ^ 2)) := by
      rw [hx₁_eq]
      exact hP_E'_eq_quad Y w₁ hY_t₁ hw₁_t₂
    refine ⟨u₁, hu₁_mem, ?_, ?_⟩
    · change ψE' (2 * IntermediateField.inclusion hLE' α * Y * P_E' x₁) ≠ 1
      rw [hbridge]
      exact hu₁_ne1
    · change (ψE' (2 * IntermediateField.inclusion hLE' α * Y * P_E' x₁)) ^ p = 1
      rw [hbridge]
      exact hu₁_pow_p

  have hConj2 : ∀ (r : ℕ), 1 ≤ r → r ≤ t₁ → ¬ (p ∣ r) →
      ∀ (σ : E' ≃ₐ[F] E'),
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) →
        (∃ y₀ : E', σ y₀ ≠ y₀) →
        ∀ Y : E', (Y = 0 ∨ -(r : ℤ) ≤ valL F E' Y) →
          (∀ u₁ ∈ unitGroup F E' r,
            let x₁ := 1 - ((((Units.map σ.toRingEquiv.toMonoidHom u₁) * u₁⁻¹ : E'ˣ) : E'))
            ψE' (2 * IntermediateField.inclusion hLE' α * Y * P_E' x₁) = 1) →
          (Y = 0 ∨ -(r : ℤ) + 1 ≤ valL F E' Y) := by
    intro r hr_ge1 hr_le_t₁ hndvd σ hσ_L hσ_ne Y hY_ge htriv_all
    by_contra hY_not
    obtain ⟨u₁, hu₁_mem, hu₁_ne1, _⟩ :=
      hP_E'_nondiv_witness r hr_ge1 hr_le_t₁ hndvd σ hσ_L hσ_ne Y hY_ge hY_not
    exact hu₁_ne1 (htriv_all u₁ hu₁_mem)

  
  have ha₀_ge : a₀ = 0 ∨ -(t₁ : ℤ) ≤ valL F E' a₀ := Or.inr (le_of_eq ha₀_val.symm)
  have h2a₀_ge : 2 * a₀ = 0 ∨ -(t₁ : ℤ) ≤ valL F E' (2 * a₀) := by
    have hmul := hval_mul_ge 0 (-(t₁ : ℤ)) (2 : E') a₀ (Or.inr (by rw [h2_val0])) ha₀_ge
    rwa [zero_add] at hmul

  have hΦ_coker : ∀ τ : E' ≃ₐ[F] E',
      (∀ x : L, τ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) →
      (∃ y₀ : E', τ y₀ ≠ y₀) →
      let x_τ : E'ˣ → E' := fun y =>
        1 - ((((Units.map τ.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E'))
      let Φ_fn : E'ˣ → (Ω F)ˣ := fun y =>
        u_ψE' (2 * IntermediateField.inclusion hLE' α * a₀ * P_E' (x_τ y))
      (∃ u₁ ∈ unitGroup F E' t₁, Φ_fn u₁ ≠ 1 ∧ (Φ_fn u₁) ^ p = 1) ∧
      (∃ j < p, 0 < j ∧ ∀ y : E'ˣ, (ξE' y) ^ 2 = (Φ_fn y) ^ j) := by
    intro τ hτ_L hτ_ne
    dsimp only
    set w_τ : E'ˣ → E' := fun y =>
      ((((Units.map τ.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E')) - 1
    set x_τ : E'ˣ → E' := fun y =>
      1 - ((((Units.map τ.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E'))
    set Φ_fn : E'ˣ → (Ω F)ˣ := fun y =>
      u_ψE' (2 * IntermediateField.inclusion hLE' α * a₀ * P_E' (x_τ y))
    obtain ⟨_, hτ_w_t₂, hτ_w_m₂, _⟩ := hσ_props τ hτ_L
    have hx_τ_mul : ∀ y₁ y₂ : E'ˣ, x_τ (y₁ * y₂) = x_τ y₁ + x_τ y₂ - x_τ y₁ * x_τ y₂ := by
      intro y₁ y₂
      dsimp only [x_τ]
      have hmap : (((Units.map τ.toRingEquiv.toMonoidHom (y₁ * y₂)) * (y₁ * y₂)⁻¹ : E'ˣ) : E') =
          ((((Units.map τ.toRingEquiv.toMonoidHom y₁) * y₁⁻¹ : E'ˣ) : E')) *
            ((((Units.map τ.toRingEquiv.toMonoidHom y₂) * y₂⁻¹ : E'ˣ) : E')) := by
        rw [map_mul, mul_inv, mul_mul_mul_comm, Units.val_mul]
      rw [hmap]
      ring
    have hx_τ_q₂ : ∀ y : E'ˣ, x_τ y = 0 ∨ (q₂ : ℤ) ≤ valL F E' (x_τ y) := by
      intro y
      have hw_y : w_τ y = 0 ∨ (t₂ : ℤ) ≤ valL F E' (w_τ y) := (hτ_w_t₂ y).1
      have hx_eq : x_τ y = - w_τ y := by dsimp [x_τ, w_τ]; ring
      rw [hx_eq]
      exact hval_ge_mono (q₂ : ℤ) (t₂ : ℤ) (- w_τ y) (by exact_mod_cast hq₂_le_t₂)
        (hval_neg_ge (t₂ : ℤ) (w_τ y) hw_y)
    have hΦ_mul : ∀ y₁ y₂ : E'ˣ, Φ_fn (y₁ * y₂) = Φ_fn y₁ * Φ_fn y₂ := by
      intro y₁ y₂
      dsimp only [Φ_fn]
      rw [hx_τ_mul y₁ y₂]
      set x₁ := x_τ y₁
      set x₂ := x_τ y₂
      set R_P := P_E' (x₁ + x₂ - x₁ * x₂) - P_E' x₁ - P_E' x₂
      have hRP_val : R_P = 0 ∨ (m₂ : ℤ) ≤ valL F E' R_P :=
        (hP_E' x₁ x₂ (hx_τ_q₂ y₁) (hx_τ_q₂ y₂)).2.2
      have hrem_mul := hval_mul_ge (-(t₁ : ℤ)) (m₂ : ℤ) (2 * a₀) R_P h2a₀_ge hRP_val
      have hrem_bE' : 2 * a₀ * R_P = 0 ∨ (bE' : ℤ) ≤ valL F E' (2 * a₀ * R_P) :=
        hval_ge_mono (bE' : ℤ) (-(t₁ : ℤ) + (m₂ : ℤ)) (2 * a₀ * R_P) (by omega) hrem_mul
      have hring : 2 * IntermediateField.inclusion hLE' α * a₀ * P_E' (x₁ + x₂ - x₁ * x₂) =
          ((2 * IntermediateField.inclusion hLE' α * a₀ * P_E' x₁) +
            (2 * IntermediateField.inclusion hLE' α * a₀ * P_E' x₂)) +
          IntermediateField.inclusion hLE' α * (2 * a₀ * R_P) := by
        dsimp only [R_P]
        ring
      rw [hring, hu_ψE'_add, hu_ψE'_add]
      have hrem1 : u_ψE' (IntermediateField.inclusion hLE' α * (2 * a₀ * R_P)) = 1 :=
        (hu_ψE'_eq_one _).mpr (hψE'_α_triv (2 * a₀ * R_P) hrem_bE')
      rw [hrem1, mul_one]
    let Φ_τ : E'ˣ →* (Ω F)ˣ := MonoidHom.mk' Φ_fn hΦ_mul
    have hΦ_triv_t₁_add1 : ∀ u ∈ unitGroup F E' (t₁ + 1), Φ_τ u = 1 := by
      intro u hu
      have ht₁_add1 : t₁ + 1 = bM₁' := by omega
      rw [ht₁_add1] at hu
      have hw_u : w_τ u = 0 ∨ (m₂ : ℤ) ≤ valL F E' (w_τ u) := hτ_w_m₂ u hu
      have hx_u : x_τ u = 0 ∨ (m₂ : ℤ) ≤ valL F E' (x_τ u) := by
        have hx_eq : x_τ u = - w_τ u := by dsimp [x_τ, w_τ]; ring
        rw [hx_eq]
        exact hval_neg_ge (m₂ : ℤ) (w_τ u) hw_u
      have hP_u : P_E' (x_τ u) = 0 ∨ (m₂ : ℤ) ≤ valL F E' (P_E' (x_τ u)) :=
        hP_E'_val_ge (m₂ : ℤ) (by omega) (x_τ u) hx_u
      have hprod_u := hval_mul_ge (-(t₁ : ℤ)) (m₂ : ℤ) (2 * a₀) (P_E' (x_τ u)) h2a₀_ge hP_u
      have hge_bE' : 2 * a₀ * P_E' (x_τ u) = 0 ∨ (bE' : ℤ) ≤ valL F E' (2 * a₀ * P_E' (x_τ u)) :=
        hval_ge_mono (bE' : ℤ) (-(t₁ : ℤ) + (m₂ : ℤ)) (2 * a₀ * P_E' (x_τ u)) (by omega) hprod_u
      change u_ψE' (2 * IntermediateField.inclusion hLE' α * a₀ * P_E' (x_τ u)) = 1
      have hring_u : 2 * IntermediateField.inclusion hLE' α * a₀ * P_E' (x_τ u) =
          IntermediateField.inclusion hLE' α * (2 * a₀ * P_E' (x_τ u)) := by ring
      rw [hring_u, hu_ψE'_eq_one]
      exact hψE'_α_triv (2 * a₀ * P_E' (x_τ u)) hge_bE'
    have hΦ_triv_norm : ∀ v : K₁ˣ, Φ_τ (Units.map (normLM F hE'K₁) v) = 1 := by
      intro v
      obtain ⟨τ_lift, hτ_lift_M₁', _, hτ_lift_val, hτ_lift_norm⟩ := hGalLift_E' τ hτ_L
      set w_v : K₁ := ((((Units.map τ_lift.toRingEquiv.toMonoidHom v) * v⁻¹ : K₁ˣ) : K₁)) - 1
      set x_v : K₁ := 1 - ((((Units.map τ_lift.toRingEquiv.toMonoidHom v) * v⁻¹ : K₁ˣ) : K₁))
      have hw_v : w_v = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ w_v :=
        hσ_lift_props τ_lift hτ_lift_M₁' hτ_lift_val v
      have hx_v_d₁ : x_v = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ x_v := by
        have hx_eq : x_v = -w_v := by dsimp [x_v, w_v]; ring
        rw [hx_eq]
        exact hval_neg_ge_K₁ (d₁ : ℤ) w_v hw_v
      have hx_v_q₁ : x_v = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ x_v :=
        hval_ge_mono_K₁ (q₁ : ℤ) (d₁ : ℤ) x_v (by exact_mod_cast hq₁_le_d₁) hx_v_d₁
      have h1_xv : 1 - x_v = τ_lift (v : K₁) * ((v⁻¹ : K₁ˣ) : K₁) := by
        dsimp only [x_v]
        change 1 - (1 - (τ_lift (v : K₁) * ((v⁻¹ : K₁ˣ) : K₁))) =
          τ_lift (v : K₁) * ((v⁻¹ : K₁ˣ) : K₁)
        ring
      have hinv_v : (v : K₁) * ((v⁻¹ : K₁ˣ) : K₁) = 1 := v.val_inv
      have hu₁_zero : 1 - normLM F hM₁'K₁ (1 - x_v) = 0 := by
        rw [h1_xv, map_mul, (hτ_lift_norm (v : K₁)).1, ← map_mul, hinv_v, map_one, sub_self]
      have hu₂_eq : 1 - normLM F hE'K₁ (1 - x_v) = x_τ (Units.map (normLM F hE'K₁) v) := by
        rw [h1_xv, map_mul, (hτ_lift_norm (v : K₁)).2]
        rfl
      have hmc := (hCompat_Δ₀ x_v hx_v_q₁).2.2
      change ψM₁' (2 * IntermediateField.inclusion hLM₁' α * normLM F hM₁'K₁ (Δ₀ : K₁) *
          P_M₁' (1 - normLM F hM₁'K₁ (1 - x_v))) =
        ψE' (2 * IntermediateField.inclusion hLE' α * a₀ *
          P_E' (1 - normLM F hE'K₁ (1 - x_v))) at hmc
      rw [hu₁_zero, hu₂_eq, hP_M₁'_zero, mul_zero, AddChar.map_zero_eq_one] at hmc
      change u_ψE' (2 * IntermediateField.inclusion hLE' α * a₀ *
        P_E' (x_τ (Units.map (normLM F hE'K₁) v))) = 1
      exact (hu_ψE'_eq_one _).mpr hmc.symm
    have ha₀_not_gt : ¬ (a₀ = 0 ∨ -(t₁ : ℤ) + 1 ≤ valL F E' a₀) := by
      rintro (h0 | hgt)
      · have hval0 : valL F E' a₀ = 0 := by rw [h0, hval0_E']
        omega
      · omega
    obtain ⟨u₁, hu₁_mem, hu₁_ne1, hu₁_pow_p⟩ :=
      hP_E'_nondiv_witness t₁ (by omega) le_rfl ht₁_ndvd τ hτ_L hτ_ne a₀ ha₀_ge ha₀_not_gt
    have hΦ_u₁_ne1 : Φ_fn u₁ ≠ 1 := by
      intro h1
      exact hu₁_ne1 ((hu_ψE'_eq_one _).mp h1)
    have hΦ_u₁_pow_p : (Φ_fn u₁) ^ p = 1 := by
      apply Units.ext
      rw [Units.val_pow_eq_pow_val]
      exact hu₁_pow_p
    refine ⟨⟨u₁, hu₁_mem, hΦ_u₁_ne1, hΦ_u₁_pow_p⟩, ?_⟩
    exact hCoker_E' Φ_τ hΦ_triv_t₁_add1 hΦ_triv_norm ⟨u₁, hu₁_mem, hΦ_u₁_ne1⟩

  
  obtain ⟨τ₀, hτ₀_L, hτ₀_ne⟩ := hτ₀_exists
  obtain ⟨⟨u₁, _, hu₁_ne1, hu₁_pow_p⟩, ⟨j₀, hj₀_lt, hj₀_pos, hξ_τ₀⟩⟩ :=
    hΦ_coker τ₀ hτ₀_L hτ₀_ne
  set x_τ₀ : E'ˣ → E' := fun y =>
    1 - ((((Units.map τ₀.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E'))
  set Φ_τ₀_u₁ : (Ω F)ˣ :=
    u_ψE' (2 * IntermediateField.inclusion hLE' α * a₀ * P_E' (x_τ₀ u₁))
  have hΦ_pow_j₀_ne1 : Φ_τ₀_u₁ ^ j₀ ≠ 1 := by
    intro hpow_j₀
    have hdvd_j₀ : orderOf Φ_τ₀_u₁ ∣ j₀ := orderOf_dvd_of_pow_eq_one hpow_j₀
    have hdvd_p : orderOf Φ_τ₀_u₁ ∣ p := orderOf_dvd_of_pow_eq_one hu₁_pow_p
    have hdvd_gcd : orderOf Φ_τ₀_u₁ ∣ p.gcd j₀ := Nat.dvd_gcd hdvd_p hdvd_j₀
    have hcop : p.Coprime j₀ :=
      (Nat.Prime.coprime_iff_not_dvd hPrime).2 (Nat.not_dvd_of_pos_of_lt hj₀_pos hj₀_lt)
    rw [Nat.Coprime.gcd_eq_one hcop] at hdvd_gcd
    have hord1 : orderOf Φ_τ₀_u₁ = 1 := Nat.eq_one_of_dvd_one hdvd_gcd
    exact hu₁_ne1 (orderOf_eq_one_iff.mp hord1)
  have hξ_u₁_ne1 : ξE' u₁ ≠ 1 := by
    intro hξ1
    apply hΦ_pow_j₀_ne1
    have hsq := hξ_τ₀ u₁
    change (ξE' u₁) ^ 2 = Φ_τ₀_u₁ ^ j₀ at hsq
    rw [← hsq, hξ1, one_pow]
  obtain ⟨_, _, σ, hσ_L, hσ_twist⟩ := hχ₂_twists 1 hp_gt1
  have hσ_ne : ∃ y₀ : E', σ y₀ ≠ y₀ := by
    refine ⟨(u₁ : E'), ?_⟩
    intro hfix
    have hmap_eq : Units.map σ.toRingEquiv.toMonoidHom u₁ = u₁ := Units.ext hfix
    have htw := hσ_twist u₁
    change (ξE' u₁) ^ 1 * χ₂ u₁ = χ₂ (Units.map σ.toRingEquiv.toMonoidHom u₁) at htw
    rw [pow_one, hmap_eq] at htw
    have hξ1 : ξE' u₁ = 1 := by
      have hmul := congrArg (· * (χ₂ u₁)⁻¹) htw
      dsimp only at hmul
      rw [mul_inv_cancel_right, mul_inv_cancel] at hmul
      exact hmul
    exact hξ_u₁_ne1 hξ1

  
  obtain ⟨_, ⟨j, hj_lt, hj_pos, hξ_σ⟩⟩ := hΦ_coker σ hσ_L hσ_ne
  have hc₂₀_inv_eq : - 2 * ((c₂₀⁻¹ : E'ˣ) : E') =
      2 * IntermediateField.inclusion hLE' α * B₂ := by
    dsimp only [B₂, α]
    have hinv_mul : ((c_νE'⁻¹ : Lˣ) : L) * (c_νE' : L) = 1 := c_νE'.inv_val
    have hmap_inv : IntermediateField.inclusion hLE' ((c_νE'⁻¹ : Lˣ) : L) *
        IntermediateField.inclusion hLE' (c_νE' : L) = 1 := by
      rw [← map_mul, hinv_mul, map_one]
    calc - 2 * ((c₂₀⁻¹ : E'ˣ) : E')
        = - 2 * (1 * ((c₂₀⁻¹ : E'ˣ) : E')) := by ring
      _ = - 2 * ((IntermediateField.inclusion hLE' ((c_νE'⁻¹ : Lˣ) : L) *
            IntermediateField.inclusion hLE' (c_νE' : L)) * ((c₂₀⁻¹ : E'ˣ) : E')) := by
          rw [hmap_inv]
      _ = 2 * IntermediateField.inclusion hLE' ((c_νE'⁻¹ : Lˣ) : L) *
            (- (IntermediateField.inclusion hLE' (c_νE' : L) * ((c₂₀⁻¹ : E'ˣ) : E'))) := by ring

  refine ⟨hB₂_val, hConj2, j, σ, hj_pos, hj_lt, hσ_L, hσ_ne, ?_⟩
  intro y
  set u_y : E'ˣ := (Units.map σ.toRingEquiv.toMonoidHom y) * y⁻¹
  set w_y : E' := (u_y : E') - 1
  set x_y : E' := 1 - (u_y : E')
  have hξ_eq_χ₂ : ξE' y = χ₂ u_y := by
    have htw := hσ_twist y
    change (ξE' y) ^ 1 * χ₂ y = χ₂ (Units.map σ.toRingEquiv.toMonoidHom y) at htw
    rw [pow_one] at htw
    dsimp only [u_y]
    rw [map_mul, map_inv, ← htw, mul_inv_cancel_right]
  have hw_y_t₂ : w_y = 0 ∨ (t₂ : ℤ) ≤ valL F E' w_y :=
    ((hσ_props σ hσ_L).2.1 y).1
  have hx_y_t₂ : x_y = 0 ∨ (t₂ : ℤ) ≤ valL F E' x_y := by
    have hx_eq : x_y = -w_y := by dsimp [x_y, w_y]; ring
    rw [hx_eq]
    exact hval_neg_ge (t₂ : ℤ) w_y hw_y_t₂
  have hx_y_q₂ : x_y = 0 ∨ (q₂ : ℤ) ≤ valL F E' x_y :=
    hval_ge_mono (q₂ : ℤ) (t₂ : ℤ) x_y (by exact_mod_cast hq₂_le_t₂) hx_y_t₂
  have h1_sub_xy : 1 - x_y = (u_y : E') := by
    dsimp only [x_y]
    ring
  have hx : 1 - x_y ≠ 0 := by
    rw [h1_sub_xy]
    exact Units.ne_zero u_y
  have hmk0_eq : Units.mk0 (1 - x_y) hx = u_y := by
    apply Units.ext
    rw [Units.val_mk0, h1_sub_xy]
  have hlog := hc₂₀_log x_y hx_y_q₂ hx
  change (χ₂ (Units.mk0 (1 - x_y) hx) : Ω F) ^ 2 =
    ψE' (- 2 * ((c₂₀⁻¹ : E'ˣ) : E') * P_E' x_y) at hlog
  rw [hmk0_eq, ← hξ_eq_χ₂, hc₂₀_inv_eq] at hlog
  have hξ_sq_u : (ξE' y) ^ 2 =
      u_ψE' (2 * IntermediateField.inclusion hLE' α * B₂ * P_E' x_y) := by
    apply Units.ext
    rw [Units.val_pow_eq_pow_val]
    exact hlog
  have hξ_σ_y : (ξE' y) ^ 2 =
      (u_ψE' (2 * IntermediateField.inclusion hLE' α * a₀ * P_E' x_y)) ^ j :=
    hξ_σ y
  rw [hu_ψE'_pow, hξ_sq_u] at hξ_σ_y
  have hmul_eq := congrArg
    (· * u_ψE' (- (2 * IntermediateField.inclusion hLE' α * (j : E') * a₀ * P_E' x_y)))
    hξ_σ_y
  dsimp only at hmul_eq
  rw [← hu_ψE'_add, ← hu_ψE'_add] at hmul_eq
  have hring_lhs : 2 * IntermediateField.inclusion hLE' α * B₂ * P_E' x_y +
      (- (2 * IntermediateField.inclusion hLE' α * (j : E') * a₀ * P_E' x_y)) =
      2 * IntermediateField.inclusion hLE' α * (B₂ - (j : E') * a₀) * P_E' x_y := by ring
  have hring_rhs : (j : E') * (2 * IntermediateField.inclusion hLE' α * a₀ * P_E' x_y) +
      (- (2 * IntermediateField.inclusion hLE' α * (j : E') * a₀ * P_E' x_y)) = 0 := by ring
  rw [hring_lhs, hring_rhs, hu_ψE'_zero] at hmul_eq
  exact (hu_ψE'_eq_one _).mp hmul_eq

theorem ld_wild_odd_tot_ram_one_over_p_teichmuller_peeling_and_shift_p3 (F : Type u) [Field F]
