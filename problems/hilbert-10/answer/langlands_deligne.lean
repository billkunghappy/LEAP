        (W S = 0 ∨ (d : ℤ) ≤ valL F K₁ (W S)) ∧
        (W S - (∑ j ∈ S, z j) = 0 ∨ (2 * (d : ℤ)) ≤ valL F K₁ (W S - (∑ j ∈ S, z j))) ∧
        (Δ_quad (W S) - (∑ j ∈ S, Δ_quad (z j)) = 0 ∨
          (bE' : ℤ) ≤ valL F L (Δ_quad (W S) - (∑ j ∈ S, Δ_quad (z j)))) := by
      intro S
      induction' S using Finset.induction_on with j₀ s hj₀ ih
      · refine ⟨Or.inl (by simp [W]), Or.inl (by simp [W]), Or.inl (by simp [W, hΔ_quad_zero])⟩
      · rcases ih with ⟨ih_d, ih_lin, ih_quad⟩
        have hW_ins_fact : W (insert j₀ s) = (1 + z j₀) * (1 + W s) - 1 := by
          dsimp only [W]
          rw [Finset.prod_insert hj₀]
          ring
        have hW_ins_expand : W (insert j₀ s) = (z j₀ + W s) + z j₀ * W s := by
          rw [hW_ins_fact]
          ring
        have hzW_2d : z j₀ * W s = 0 ∨ (2 * (d : ℤ)) ≤ valL F K₁ (z j₀ * W s) := by
          have h := hvalK₁_mul_ge (d : ℤ) (d : ℤ) (z j₀) (W s) (hz_j j₀) ih_d
          rwa [← two_mul (d : ℤ)] at h
        have hW_ins_d : W (insert j₀ s) = 0 ∨ (d : ℤ) ≤ valL F K₁ (W (insert j₀ s)) := by
          rw [hW_ins_expand]
          apply hvalK₁_add (d : ℤ) (z j₀ + W s) (z j₀ * W s)
          · exact hvalK₁_add (d : ℤ) (z j₀) (W s) (hz_j j₀) ih_d
          · exact hvalK₁_mono (by omega : (d : ℤ) ≤ 2 * (d : ℤ)) hzW_2d
        have hW_ins_lin : W (insert j₀ s) - (∑ j ∈ insert j₀ s, z j) = 0 ∨
            (2 * (d : ℤ)) ≤ valL F K₁ (W (insert j₀ s) - (∑ j ∈ insert j₀ s, z j)) := by
          have hlin_eq : W (insert j₀ s) - (∑ j ∈ insert j₀ s, z j) =
              (W s - (∑ j ∈ s, z j)) + z j₀ * W s := by
            rw [Finset.sum_insert hj₀, hW_ins_expand]
            ring
          rw [hlin_eq]
          exact hvalK₁_add (2 * (d : ℤ)) _ _ ih_lin hzW_2d
        have hW_ins_quad : Δ_quad (W (insert j₀ s)) - (∑ j ∈ insert j₀ s, Δ_quad (z j)) = 0 ∨
            (bE' : ℤ) ≤ valL F L (Δ_quad (W (insert j₀ s)) - (∑ j ∈ insert j₀ s, Δ_quad (z j))) := by
          have hz_d1 : z j₀ = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ (z j₀) :=
            hvalK₁_mono (by omega : (d₁ : ℤ) ≤ (d : ℤ)) (hz_j j₀)
          have hWs_d1 : W s = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ (W s) :=
            hvalK₁_mono (by omega : (d₁ : ℤ) ≤ (d : ℤ)) ih_d
          have hmult_step := (hMultAdd (z j₀) (W s) hz_d1 hWs_d1).2
          rw [← hW_ins_fact] at hmult_step
          have hquad_eq : Δ_quad (W (insert j₀ s)) - (∑ j ∈ insert j₀ s, Δ_quad (z j)) =
              (Δ_quad (W (insert j₀ s)) - (Δ_quad (z j₀) + Δ_quad (W s))) +
                (Δ_quad (W s) - (∑ j ∈ s, Δ_quad (z j))) := by
            rw [Finset.sum_insert hj₀]
            ring
          rw [hquad_eq]
          exact hvalL_add (bE' : ℤ) _ _ hmult_step ih_quad
