          have hmul2 := hvalM₁'_mul_ge 0 (-(k : ℤ) * (t₁ : ℤ) + V_pert)
            ((k : ℕ) : R_M) (B_m ^ k * (ν_m - θ₀ * ξ m)) (hvalM₁'_natCast k) hmul1
          refine hvalM₁'_mono B_val _ _ ?_ hmul2
