      rw [map_sub]
      ring
    rw [hsplit]
    have hxr_K : IntermediateField.inclusion hLK (x - r_L) = 0 ∨
        1 ≤ valL F K (IntermediateField.inclusion hLK (x - r_L)) := by
      rcases hxr with h0 | hge1
      · rw [h0, map_zero]
        exact Or.inl rfl
      · right
        rw [hval_alg (x - r_L)]
        nlinarith
    exact hval_add_K 1 _ _ hyx hxr_K
  obtain ⟨hEpsL_even, hEpsL_odd⟩ :=
    ((hStat L ψ hψ χ' ha_ge2).2 c_χ' hc_χ'_val hc_χ'_stat).2
      R_L δ_a hRL_int hRL_sep hRL_surj hδa_val
  rcases Nat.mod_two_eq_zero_or_one a with ha_even | ha_odd
  · have haK_even : a_K % 2 = 0 := by omega
    have hd_even : d_K + k * b = p * d_a := by
      rw [hd_sum, ha_even, mul_zero, add_zero]
    set δ_K_even : Kˣ := ϖ_K ^ d_K
    have hδK_even_val : valL F K (δ_K_even : K) = (d_K : ℤ) := by
      change valL F K (((ϖ_K ^ d_K : Kˣ) : K)) = (d_K : ℤ)
      rw [Units.val_pow_eq_pow_val]
      exact hϖ_K_pow_val d_K
    obtain ⟨hEpsK_even, _⟩ :=
      ((hStat K ψ_K hψK χ'_K haK_ge2).2 c_K hc_K_val hc_K_stat).2
        R_K δ_K_even hRK_int hRK_sep hRK_surj hδK_even_val
    have hL := hEpsL_even ha_even
    have hK := hEpsK_even haK_even
    rw [hRL_card] at hL
    rw [hqK, hRK_card] at hK
    refine ⟨(Fintype.card k_L : Ω F) ^ (p * d_a), ?_, ?_⟩
    · change (tateEps F L χ' ψ) ^ p = _
      rw [hL]
      have hpow_da : ((Fintype.card k_L : Ω F) ^ d_a) ^ p =
          (Fintype.card k_L : Ω F) ^ (p * d_a) := by
        rw [← pow_mul, mul_comm d_a p]
      calc
        ((qL F L : Ω F) ^ condExpChar F L ψ * (Fintype.card k_L : Ω F) ^ d_a *
            (χ' c_χ' : Ω F) * ψ ((c_χ'⁻¹ : Lˣ) : L)) ^ p
        _ = ((qL F L : Ω F) ^ condExpChar F L ψ) ^ p *
              ((Fintype.card k_L : Ω F) ^ d_a) ^ p *
              ((χ' c_χ' : Ω F) ^ p * (ψ ((c_χ'⁻¹ : Lˣ) : L)) ^ p) := by
          repeat rw [mul_pow]
          ring
        _ = ((qL F L : Ω F) ^ condExpChar F L ψ) ^ p *
              (Fintype.card k_L : Ω F) ^ (p * d_a) *
              ((χ' c_χ' : Ω F) ^ p * (ψ ((c_χ'⁻¹ : Lˣ) : L)) ^ p) := by rw [hpow_da]
    · change tateEps F K χ'_K ψ_K * (Fintype.card k_L : Ω F) ^ (k * b) = _
      rw [hK]
      have hpow_card :
          (Fintype.card k_L : Ω F) ^ d_K * (Fintype.card k_L : Ω F) ^ (k * b) =
            (Fintype.card k_L : Ω F) ^ (p * d_a) := by
        rw [← pow_add, hd_even]
      calc
        ((qL F L : Ω F) ^ condExpChar F K ψ_K * (Fintype.card k_L : Ω F) ^ d_K *
            (χ'_K c_K : Ω F) * ψ_K ((c_K⁻¹ : Kˣ) : K)) *
          (Fintype.card k_L : Ω F) ^ (k * b)
        _ = (qL F L : Ω F) ^ condExpChar F K ψ_K *
              ((Fintype.card k_L : Ω F) ^ d_K * (Fintype.card k_L : Ω F) ^ (k * b)) *
              ((χ'_K c_K : Ω F) * ψ_K ((c_K⁻¹ : Kˣ) : K)) := by ring
        _ = (qL F L : Ω F) ^ condExpChar F K ψ_K *
              (Fintype.card k_L : Ω F) ^ (p * d_a) *
              ((χ'_K c_K : Ω F) * ψ_K ((c_K⁻¹ : Kˣ) : K)) := by rw [hpow_card]
  · have haK_odd : a_K % 2 = 1 := by omega
    have hd_odd : d_K + k * b = p * d_a + k := by
      rw [hd_sum, ha_odd, mul_one]
    have hδK_arith : 2 * d_K + (p - 1) * (t + 1) = p * (2 * d_a) + (p - 1) := by
      calc 2 * d_K + (p - 1) * (t + 1)
        _ = 2 * d_K + (2 * k) * b := by rw [hp_sub1, ← hb_eq]
        _ = 2 * (d_K + k * b) := by ring
        _ = 2 * (p * d_a + k) := by rw [hd_odd]
        _ = p * (2 * d_a) + 2 * k := by ring
        _ = p * (2 * d_a) + (p - 1) := by rw [← hp_sub1]
    obtain ⟨δ_K, hδK_val, hδK_tr2⟩ := hδK_ex d_a d_K hδK_arith
    obtain ⟨_, hEpsK_odd⟩ :=
      ((hStat K ψ_K hψK χ'_K haK_ge2).2 c_K hc_K_val hc_K_stat).2
        R_K δ_K hRK_int hRK_sep hRK_surj hδK_val
    have hL := hEpsL_odd ha_odd
    have hK := hEpsK_odd haK_odd
    rw [hRL_card] at hL
    rw [hqK, hRK_card] at hK
    have hRK_sum :
        (∑ r ∈ R_K,
          if hr : 1 + (δ_K : K) * r ≠ 0 then
            (χ'_K (Units.mk0 (1 + (δ_K : K) * r) hr) : Ω F)⁻¹ *
              ψ_K (((c_K⁻¹ : Kˣ) : K) * (δ_K : K) * r)
          else 0) =
        (∑ r ∈ R_L,
          if hr_K : 1 + (δ_K : K) * IntermediateField.inclusion hLK r ≠ 0 then
            (χ'_K (Units.mk0 (1 + (δ_K : K) * IntermediateField.inclusion hLK r) hr_K) : Ω F)⁻¹ *
              ψ_K (((c_K⁻¹ : Kˣ) : K) * (δ_K : K) * IntermediateField.inclusion hLK r)
          else 0) := by
      dsimp [R_K]
      exact Finset.sum_image (fun x _ y _ hxy => hinj hxy)
    rw [hRK_sum] at hK
    have hOdd := hOdd_sums ha_odd δ_K hδK_val hδK_tr2
    set S_K : Ω F :=
      ∑ r ∈ R_L,
        if hr_K : 1 + (δ_K : K) * IntermediateField.inclusion hLK r ≠ 0 then
          (χ'_K (Units.mk0 (1 + (δ_K : K) * IntermediateField.inclusion hLK r) hr_K) : Ω F)⁻¹ *
            ψ_K (((c_K⁻¹ : Kˣ) : K) * (δ_K : K) * IntermediateField.inclusion hLK r)
        else 0
    set S_L : Ω F :=
      ∑ r ∈ R_L,
        if hr_L : 1 + (δ_a : L) * r ≠ 0 then
          (χ' (Units.mk0 (1 + (δ_a : L) * r) hr_L) : Ω F)⁻¹ *
            ψ (((c_χ'⁻¹ : Lˣ) : L) * (δ_a : L) * r)
        else 0
    have hSL_pow : S_L ^ p = (Fintype.card k_L : Ω F) ^ k * S_K := hOdd
    refine ⟨(Fintype.card k_L : Ω F) ^ (p * d_a + k) * S_K, ?_, ?_⟩
    · change (tateEps F L χ' ψ) ^ p = _
      rw [hL]
      have hpow_da :
          ((Fintype.card k_L : Ω F) ^ d_a) ^ p * (Fintype.card k_L : Ω F) ^ k =
            (Fintype.card k_L : Ω F) ^ (p * d_a + k) := by
        rw [← pow_mul, mul_comm d_a p, ← pow_add]
      calc
        ((qL F L : Ω F) ^ condExpChar F L ψ * (Fintype.card k_L : Ω F) ^ d_a *
            (χ' c_χ' : Ω F) * ψ ((c_χ'⁻¹ : Lˣ) : L) * S_L) ^ p
        _ = ((qL F L : Ω F) ^ condExpChar F L ψ) ^ p *
              ((Fintype.card k_L : Ω F) ^ d_a) ^ p *
              (S_L ^ p) *
              ((χ' c_χ' : Ω F) ^ p * (ψ ((c_χ'⁻¹ : Lˣ) : L)) ^ p) := by
          repeat rw [mul_pow]
          ring
        _ = ((qL F L : Ω F) ^ condExpChar F L ψ) ^ p *
              (((Fintype.card k_L : Ω F) ^ d_a) ^ p * (Fintype.card k_L : Ω F) ^ k) *
              S_K *
              ((χ' c_χ' : Ω F) ^ p * (ψ ((c_χ'⁻¹ : Lˣ) : L)) ^ p) := by
          rw [hSL_pow]
          ring
        _ = ((qL F L : Ω F) ^ condExpChar F L ψ) ^ p *
              ((Fintype.card k_L : Ω F) ^ (p * d_a + k) * S_K) *
              ((χ' c_χ' : Ω F) ^ p * (ψ ((c_χ'⁻¹ : Lˣ) : L)) ^ p) := by
          rw [hpow_da]
          ring
    · change tateEps F K χ'_K ψ_K * (Fintype.card k_L : Ω F) ^ (k * b) = _
      rw [hK]
      have hpow_card :
          (Fintype.card k_L : Ω F) ^ d_K * (Fintype.card k_L : Ω F) ^ (k * b) =
            (Fintype.card k_L : Ω F) ^ (p * d_a + k) := by
        rw [← pow_add, hd_odd]
      calc
        ((qL F L : Ω F) ^ condExpChar F K ψ_K * (Fintype.card k_L : Ω F) ^ d_K *
            (χ'_K c_K : Ω F) * ψ_K ((c_K⁻¹ : Kˣ) : K) * S_K) *
          (Fintype.card k_L : Ω F) ^ (k * b)
        _ = (qL F L : Ω F) ^ condExpChar F K ψ_K *
              (((Fintype.card k_L : Ω F) ^ d_K * (Fintype.card k_L : Ω F) ^ (k * b)) * S_K) *
              ((χ'_K c_K : Ω F) * ψ_K ((c_K⁻¹ : Kˣ) : K)) := by ring
        _ = (qL F L : Ω F) ^ condExpChar F K ψ_K *
              ((Fintype.card k_L : Ω F) ^ (p * d_a + k) * S_K) *
              ((χ'_K c_K : Ω F) * ψ_K ((c_K⁻¹ : Kˣ) : K)) := by rw [hpow_card]

theorem ld_wild_mid_cond_odd_prime_K_summand_eval (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hba : condExp F L ν₁ < condExp F L χ')
    (ha_odd : condExp F L χ' % 2 = 1)
    (haK : condExp F K (χ'.comp (Units.map (normLM F hLK))) =
      condExp F L ν₁ +
        Module.finrank L (IntermediateField.extendScalars hLK) *
          (condExp F L χ' - condExp F L ν₁))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (ϖ_L : Lˣ) (hϖ_L : valL F L (ϖ_L : L) = 1)
    (t : ℕ) (hb_eq : condExp F L ν₁ = t + 1)
    (hp_val1 : (Module.finrank L (IntermediateField.extendScalars hLK) : L) = 0 ∨
      (1 : ℤ) ≤ valL F L (Module.finrank L (IntermediateField.extendScalars hLK) : L))
    (c_χ' c_ν₁ δ : Lˣ) (u_K u_corr c_K : Kˣ)
    (hc_χ'_val : valL F L (c_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_χ'_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ'⁻¹ : Lˣ) : L) * x))
    (hc_ν₁_val : valL F L (c_ν₁ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hδ_eq : δ = c_χ' * c_ν₁⁻¹)
    (hu_K_norm : Units.map (normLM F hLK) u_K = δ)
    (hu_K_val : valL F K (u_K : K) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hδ_val : valL F L (δ : L) = ((condExp F L χ' - condExp F L ν₁ : ℕ) : ℤ))
    (hnorm_to_tr : ∀ z : K, (z = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F K z) →
      ψ (((c_ν₁⁻¹ : Lˣ) : L) * normLM F hLK z) =
        ψ (- ((c_ν₁⁻¹ : Lˣ) : L) * traceLM F hLK z))
    (hu_corr_eq : (u_corr : K) = 1 - IntermediateField.inclusion hLK (δ : L) * ((u_K⁻¹ : Kˣ) : K))
    (hc_K_eq : c_K = (Units.map (IntermediateField.inclusion hLK) c_χ') * u_corr⁻¹)
    (s : K → ℕ → L)
    (hs1 : ∀ y : K, s y 1 = traceLM F hLK y)
    (hs2 : ∀ y : K, 2 * s y 2 = (traceLM F hLK y) ^ 2 - traceLM F hLK (y ^ 2))
    (hs_val : ∀ (y : K) (r : ℕ),
      r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1) →
      ∀ (q m : ℤ), (y = 0 ∨ q ≤ valL F K y) →
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ (r : ℤ) * q →
        (s y r = 0 ∨ m ≤ valL F L (s y r)))
    (hs_poly : ∀ (y : K) (c : L),
      normLM F hLK (1 + IntermediateField.inclusion hLK c * y) =
        1 +
          (∑ r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1),
            c ^ r * s y r) +
          c ^ (Module.finrank L (IntermediateField.extendScalars hLK)) * normLM F hLK y)
    (δ_K : Kˣ)
    (hδK_val : valL F K (δ_K : K) =
      ((condExp F K (χ'.comp (Units.map (normLM F hLK))) / 2 : ℕ) : ℤ))
    (hδK_tr2 : traceLM F hLK ((δ_K : K) ^ 2) -
        (-1 : L) ^ ((Module.finrank L (IntermediateField.extendScalars hLK) - 1) / 2) *
          ((ϖ_L : L) ^ (2 * (condExp F L χ' / 2))) = 0 ∨
      (2 * (condExp F L χ' / 2) + 1 : ℤ) ≤
        valL F L
          (traceLM F hLK ((δ_K : K) ^ 2) -
            (-1 : L) ^
              ((Module.finrank L (IntermediateField.extendScalars hLK) - 1) / 2) *
              ((ϖ_L : L) ^ (2 * (condExp F L χ' / 2)))))
    (r : L) (hr_int : r = 0 ∨ 0 ≤ valL F L r) :
    (if hr_K : 1 + (δ_K : K) * IntermediateField.inclusion hLK r ≠ 0 then
      ((χ'.comp (Units.map (normLM F hLK)))
        (Units.mk0 (1 + (δ_K : K) * IntermediateField.inclusion hLK r) hr_K) : Ω F)⁻¹ *
        (traceChar F hLK ψ)
          (((c_K⁻¹ : Kˣ) : K) * (δ_K : K) * IntermediateField.inclusion hLK r)
    else 0) =
    ψ (((c_χ'⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L χ' / 2) : Lˣ) : L) ^ 2 *
      ((-1 : L) ^ ((Module.finrank L (IntermediateField.extendScalars hLK) - 1) / 2) *
        (2 : L)⁻¹ * r ^ 2)) :=
by
  let K' := IntermediateField.extendScalars hLK
  set p : ℕ := Module.finrank L K'
  set k : ℕ := (p - 1) / 2
  set b : ℕ := condExp F L ν₁
  set a : ℕ := condExp F L χ'
  set d_a : ℕ := a / 2
  set r0_a : ℕ := (a + 1) / 2
  set r0_b : ℕ := (b + 1) / 2
  let χ'_K : Kˣ →* (Ω F)ˣ := χ'.comp (Units.map (normLM F hLK))
  set a_K : ℕ := condExp F K χ'_K
  set d_K : ℕ := a_K / 2
  set n : ℤ := condExpChar F L ψ
  let ι := IntermediateField.inclusion hLK
  set A_χ : L := ((c_χ'⁻¹ : Lˣ) : L)
  set A_ν : L := ((c_ν₁⁻¹ : Lˣ) : L)
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_odd' : Odd p := hPrime.odd_of_ne_two hp_odd
  have hp_eq : p = 2 * k + 1 := by
    rcases hp_odd' with ⟨m, hm⟩
    omega
  have hp_ge3 : 3 ≤ p := by omega
  have hk_ge1 : 1 ≤ k := by omega
  have hp1_ge1 : 1 ≤ p - 1 := by omega
  have hp2_ge2 : 2 ≤ p - 1 := by omega
  have ha_eq : a = 2 * d_a + 1 := by omega
  have hda_ge1 : 1 ≤ d_a := by omega
  have hr0a_eq : r0_a = d_a + 1 := by omega
  have hr0a_ge1 : 1 ≤ r0_a := by omega
  have ha_ne0 : a ≠ 0 := by omega
  have ha_ge1 : 1 ≤ a := by omega
  have haK_eq_exp : a_K = b + (2 * k + 1) * (a - b) := by
    rw [haK, ← hp_eq]
  have hdK_eq : d_K = d_a + k * (a - b) := by
    dsimp [d_K]
    have h1 : a_K = 2 * (d_a + k * (a - b)) + 1 := by
      have hmul : (2 * k + 1) * (a - b) = 2 * (k * (a - b)) + (a - b) := by ring
      omega
    omega
  have haK_eq : a_K = 2 * d_K + 1 := by
    have hmul : (2 * k + 1) * (a - b) = 2 * (k * (a - b)) + (a - b) := by ring
    omega
  have hdK_ge_r0a : r0_a ≤ d_K := by
    have hab_ge1 : 1 ≤ a - b := by omega
    have hk_ab : 1 ≤ k * (a - b) := Nat.mul_le_mul hk_ge1 hab_ge1
    omega
  have hdK_ge2 : 2 ≤ d_K := by omega
  have hdK_ge1 : 1 ≤ d_K := by omega
  have h_ineq_1 :
      (p : ℤ) * (r0_a : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ (1 : ℤ) * (d_K : ℤ) := by
    have hnat : p * r0_a ≤ d_K + (p - 1) * (t + 1) := by
      have h1 : p * r0_a = (2 * k + 1) * (d_a + 1) := by rw [hp_eq, hr0a_eq]
      have h2 : p - 1 = 2 * k := by omega
      have h3 : t + 1 = b := hb_eq.symm
      rw [h1, h2, h3, hdK_eq]
      have h4 : 2 * k * b = k * b + k * b := by ring
      have h5 : 2 * k ≤ k * b := by nlinarith
      have h6 : (2 * k + 1) * (d_a + 1) = d_a + 2 * k * d_a + 2 * k + 1 := by ring
      have h7 : k * (a - b) + k * b = k * a := by
        rw [← Nat.mul_add, Nat.sub_add_cancel (by omega)]
      have h8 : k * a = 2 * k * d_a + k := by
