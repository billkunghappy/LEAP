      exact h_norm_MC₁ (γ * α * γ⁻¹) hα_conj (γ * τ * γ⁻¹) hτ
    have h_comm_MC₀ : ∀ α ∈ M_C.fixingSubgroup, ∀ β ∈ M_C.fixingSubgroup,
        α * β * α⁻¹ * β⁻¹ ∈ E₀.fixingSubgroup := by
      intro α hα β hβ
      rw [h_fix_E₀]
      have hα_conj : γ * α * γ⁻¹ ∈ M_C.fixingSubgroup := hGalMC.2.2.1 γ hγL α hα
      have hβ_conj : γ * β * γ⁻¹ ∈ M_C.fixingSubgroup := hGalMC.2.2.1 γ hγL β hβ
      have h_grp : γ * (α * β * α⁻¹ * β⁻¹) * γ⁻¹ =
          (γ * α * γ⁻¹) * (γ * β * γ⁻¹) * (γ * α * γ⁻¹)⁻¹ * (γ * β * γ⁻¹)⁻¹ := by group
      rw [h_grp]
      exact h_comm_MC₁ (γ * α * γ⁻¹) hα_conj (γ * β * γ⁻¹) hβ_conj
    let S₀ := IntermediateField.extendScalars hM_CE₀
    let S₁ := IntermediateField.extendScalars hM_CE₁
    let e₁ : M_C ≃+* M_C := σ.toRingEquiv
    let e₂ : S₀ ≃+* S₁ :=
      { toFun := fun x =>
          ⟨γ x.1, (IntermediateField.mem_extendScalars hM_CE₁).mpr
            ((IntermediateField.mem_extendScalars hM_CE₀).mp x.2)⟩
        invFun := fun y =>
          ⟨γ⁻¹ y.1, (IntermediateField.mem_extendScalars hM_CE₀).mpr (by
            change γ (γ⁻¹ y.1) ∈ E₁
            rw [h_apply_inv γ]
            exact (IntermediateField.mem_extendScalars hM_CE₁).mp y.2)⟩
        left_inv := fun x => Subtype.ext (γ.symm_apply_apply x.1)
        right_inv := fun y => Subtype.ext (γ.apply_symm_apply y.1)
        map_mul' := fun x y => Subtype.ext (map_mul γ x.1 y.1)
        map_add' := fun x y => Subtype.ext (map_add γ x.1 y.1) }
    have h_comm_alg : (algebraMap M_C S₁).comp (e₁ : M_C →+* M_C) =
        (e₂ : S₀ →+* S₁).comp (algebraMap M_C S₀) :=
      RingHom.ext fun m => Subtype.ext (hσ m)
    have h_sep_MCE₀ : Algebra.IsSeparable M_C S₀ := by
      refine ⟨fun x => ?_⟩
      let y : S₁ := e₂ x
      have hy_sep : (minpoly M_C y).Separable :=
        @Algebra.IsSeparable.isSeparable M_C S₁ _ _ _ h_sep_MCE₁ y
      let p : Polynomial M_C := Polynomial.map (e₁.symm : M_C →+* M_C) (minpoly M_C y)
      have hp_sep : p.Separable := hy_sep.map
      have h_comp_symm : ((e₂ : S₀ →+* S₁).comp (algebraMap M_C S₀)).comp (e₁.symm : M_C →+* M_C) =
          algebraMap M_C S₁ := by
        rw [← h_comm_alg]
        exact RingHom.ext fun m => congrArg (algebraMap M_C S₁) (e₁.apply_symm_apply m)
      have h_eval_e₂ : e₂ (Polynomial.aeval x p) = 0 := by
        calc e₂ (Polynomial.aeval x p)
            = (e₂ : S₀ →+* S₁) (Polynomial.eval₂ (algebraMap M_C S₀) x
                (Polynomial.map (e₁.symm : M_C →+* M_C) (minpoly M_C y))) := by
              rw [Polynomial.aeval_def]
              rfl
          _ = (e₂ : S₀ →+* S₁) (Polynomial.eval₂
                ((algebraMap M_C S₀).comp (e₁.symm : M_C →+* M_C)) x (minpoly M_C y)) := by
              rw [Polynomial.eval₂_map]
          _ = Polynomial.eval₂
                (((e₂ : S₀ →+* S₁).comp (algebraMap M_C S₀)).comp (e₁.symm : M_C →+* M_C))
                (e₂ x) (minpoly M_C y) := by
              rw [Polynomial.hom_eval₂, RingHom.comp_assoc]
              rfl
          _ = Polynomial.aeval y (minpoly M_C y) := by
              rw [h_comp_symm, ← Polynomial.aeval_def]
          _ = 0 := minpoly.aeval M_C y
      have h_aeval : Polynomial.aeval x p = 0 :=
        e₂.injective (h_eval_e₂.trans (map_zero e₂).symm)
      exact hp_sep.of_dvd (minpoly.dvd M_C x h_aeval)
    have hAbM_CE₀ : IsAbelianExt F hM_CE₀ := ⟨h_norm_MC₀, h_comm_MC₀, h_sep_MCE₀⟩
    let u₀ : E₀ := e_F₀₁.symm u₁
    have hu₀_norm : normLM F hM_CE₀ u₀ = (z : M_C) := by
      let x₀ : S₀ := toExtendScalars F hM_CE₀ u₀
      have hx₀_e₂ : e₂ x₀ = toExtendScalars F hM_CE₁ u₁ :=
        Subtype.ext (γ.apply_symm_apply u₁.1)
      have h_norm_eq : Algebra.norm M_C x₀ = e₁.symm (Algebra.norm M_C (e₂ x₀)) :=
        Algebra.norm_eq_of_equiv_equiv e₁ e₂ h_comm_alg x₀
      change Algebra.norm M_C x₀ = (z : M_C)
      rw [h_norm_eq, hx₀_e₂]
      change σ.symm (normLM F hM_CE₁ u₁) = (z : M_C)
      rw [hu₁]
      exact σ.symm_apply_apply (z : M_C)
    have hz_fix_E₀ : (rec.recMap M_C z : AbsGal F) ∈ E₀.fixingSubgroup :=
      (rec.ker_rec M_C E₀ hM_CE₀ hAbM_CE₀ z).mpr ⟨u₀, hu₀_norm⟩
    have hγ₂_fix_E₁ : γ₂ ∈ E₁.fixingSubgroup :=
      (h_fix_E₀ (rec.recMap M_C z : AbsGal F)).mp hz_fix_E₀
    have hσ₂_mem : σ₂ ∈ H₁ := by
      rw [← h_fix_H₁, IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      apply Subtype.ext
      rw [hσ₂ x]
      exact (IntermediateField.mem_fixingSubgroup_iff _ _).mp hγ₂_fix_E₁ x.1 ((h_mem_E₁ x).mpr hx)
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hσ₂_mem
    have hγ₂_ζ : γ₂ ζ_N = γ₁ ζ_N := by
      have hγ₂_p : IsPrimeToPRootOfUnity F (γ₂ ζ_N) := h_primeToP_map γ₂ ζ_N hζ_p
      have h1 : γ₁⁻¹ (γ₂ ζ_N) = ζ_N := by
        rw [hγ₁_frob (γ₂ ζ_N) hγ₂_p, ← hγ₂_frob (γ₂ ζ_N) hγ₂_p, h_inv_apply γ₂ ζ_N]
      calc γ₂ ζ_N = γ₁ (γ₁⁻¹ (γ₂ ζ_N)) := (γ₁.apply_symm_apply (γ₂ ζ_N)).symm
        _ = γ₁ ζ_N := congrArg (⇑γ₁) h1
    have hk_ζ :
        (((σ₁ ^ k) ⟨ζ_N, (IntermediateField.mem_extendScalars hM_CM').mpr hζ_mem⟩ : M_ext') :
          AlgebraicClosure F) = γ₁ ζ_N := by
      rw [hk, hσ₂ ⟨ζ_N, (IntermediateField.mem_extendScalars hM_CM').mpr hζ_mem⟩, hγ₂_ζ]
    have h_eq_M₀ :=
      ld_frob_zpow_eq_on_subfield_of_primitiveRoot F M_C M_C M₀ M' le_rfl hM_CM₀ hM₀M' hGalM_CM₀
        (resDeg F M_C) hf_MC hq ζ_N hζ_prim hζ_p hζ_mem
        γ₁ hγ₁_MC hγ₁_frob σ₁ hσ₁ k hk_ζ
    change (QuotientGroup.mk (g₁ z) : Q) = QuotientGroup.mk (g₂ z)
    rw [QuotientGroup.eq, Subgroup.mem_subgroupOf, IntermediateField.mem_fixingSubgroup_iff]
    intro a ha
    have ha_M₀ : a ∈ M₀ := hKM₀ ha
    have ha_eq : γ₂ a = γ₁ a := by
      have h1 := h_eq_M₀ a ha_M₀
      rw [hk, hσ₂ ⟨a, (IntermediateField.mem_extendScalars hM_CM').mpr (hM₀M' ha_M₀)⟩] at h1
      exact h1
    change (γ₂⁻¹ * γ₁) a = a
    rw [AlgEquiv.mul_apply, ← ha_eq, h_inv_apply γ₂ a]
  obtain ⟨_, hval_one, _, _, hval_mul, hval_inv, hval_surj, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F M_C
  obtain ⟨ϖ_MC, hϖ_MC⟩ := hval_surj 1
  have hval_pow : ∀ n : ℕ, valL F M_C (((ϖ_MC ^ n : M_Cˣ) : M_C)) = (n : ℤ) := by
    intro n
    induction' n with n ih
    · simpa using hval_one
    · rw [pow_succ, Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
        ih, hϖ_MC, Nat.cast_add, Nat.cast_one]
  have hval_zpow : ∀ m : ℤ, valL F M_C (((ϖ_MC ^ m : M_Cˣ) : M_C)) = m := by
    intro m
    cases m with
    | ofNat n =>
      simpa using hval_pow n
    | negSucc n =>
      rw [zpow_negSucc, hval_inv, hval_pow (n + 1)]
      rfl
  set m_w : ℤ := valL F M_C (w : M_C)
  let u : M_Cˣ := w * ϖ_MC ^ (-m_w)
  have hval_u : valL F M_C (u : M_C) = 0 := by
    change valL F M_C ((w : M_C) * ((ϖ_MC ^ (-m_w) : M_Cˣ) : M_C)) = 0
    rw [hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _), hval_zpow (-m_w)]
    change m_w + -m_w = 0
    omega
  have hval_ϖu : valL F M_C (((ϖ_MC * u : M_Cˣ) : M_C)) = 1 := by
    rw [Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _), hϖ_MC, hval_u, add_zero]
  have hw_eq : w = (ϖ_MC * u) * ϖ_MC ^ (m_w - 1) := by
    have h1 : (ϖ_MC * u) * ϖ_MC ^ (m_w - 1) =
        w * (ϖ_MC ^ (1 : ℤ) * ϖ_MC ^ (-m_w) * ϖ_MC ^ (m_w - 1)) := by
      dsimp [u]
      rw [zpow_one]
      ac_rfl
    rw [h1, ← zpow_add, ← zpow_add, show (1 : ℤ) + -m_w + (m_w - 1) = 0 by omega,
      zpow_zero, mul_one]
  have hΦ_w : Φ₁ w = Φ₂ w := by
    rw [hw_eq, Φ₁.map_mul (ϖ_MC * u), Φ₁.map_zpow, Φ₂.map_mul (ϖ_MC * u), Φ₂.map_zpow,
      hΦ_unif (ϖ_MC * u) hval_ϖu, hΦ_unif ϖ_MC hϖ_MC]
  exact (Subgroup.mem_subgroupOf.mp (QuotientGroup.eq.mp hΦ_w))

theorem ld_ch14_wild_mackey_trace_and_coset_orthogonality (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hLM_C_lt : L < M_C)
    (hCore : ¬ ∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
      K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
      Module.finrank L (IntermediateField.extendScalars hLK₁) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (hGal : IsGaloisExt F L K)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (D_orb : List (MonomialTerm F L))
    (hD₁_sub : IsSubMonomialDecomp F L M_C E hLE (⟨1, L, le_rfl, 1⟩ :: D_orb))
    (hD_orb_props : ∀ t ∈ D_orb,
      t.coeff = 1 ∧
      L < t.field ∧
      t.field ≤ M_C ∧
      t.χ ^ (p F) = 1 ∧
      (∃ htK : t.field ≤ K, restrictWeilChar F htK t.χ = 1) ∧
      (∃ htE : t.field ≤ E ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
      (∀ htM : t.field ≤ M_C, restrictWeilChar F htM t.χ ≠ 1))
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (hDegSum : (∑ i : Fin D_orb.length,
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let r_orb := D_orb.length
    let K' := IntermediateField.extendScalars hLK
    let G := (K' ≃ₐ[L] K')
    ∃ (M_sub : Fin r_orb → Subgroup G)
      (idx_all : Fin (q - 1) → Fin r_orb)
      (u_all : ∀ j : Fin (q - 1), G ⧸ M_sub (idx_all j))
      (γ_all : Fin (q - 1) → relWeil F L),
      Function.Bijective (fun j : Fin (q - 1) =>
        (⟨idx_all j, u_all j⟩ : Σ i : Fin r_orb, G ⧸ M_sub i)) ∧
      (∀ i : Fin r_orb,
        Nat.card (G ⧸ M_sub i) =
          Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) ∧
        ∀ g : G, g ∈ M_sub i ↔
          ∀ (x : AlgebraicClosure F) (hx : x ∈ (D_orb.get i).field),
            ((g ⟨x, (IntermediateField.mem_extendScalars hLK).mpr
              (hM_CK (hFiMC i hx))⟩ : K') : AlgebraicClosure F) = x) ∧
      (∀ j : Fin (q - 1),
        (∀ x : K',
          (((cosetRep (u_all j))⁻¹ x : K') : AlgebraicClosure F) =
            (γ_all j : AbsGal F) (x : AlgebraicClosure F)) ∧
        (∀ z ∈ M_C, (γ_all j : AbsGal F) z ∈ M_C)) ∧
      (∀ j₁ j₂ : Fin (q - 1),
        (∀ (w : relWeil F M_C)
          (h₁ : (γ_all j₁ : AbsGal F) * (w : AbsGal F) * (γ_all j₁ : AbsGal F)⁻¹ ∈ relWeil F M_C)
          (h₂ : (γ_all j₂ : AbsGal F) * (w : AbsGal F) * (γ_all j₂ : AbsGal F)⁻¹ ∈ relWeil F M_C),
          (restrictWeilChar F (hFiMC (idx_all j₁)) (D_orb.get (idx_all j₁)).χ)
              ⟨(γ_all j₁ : AbsGal F) * (w : AbsGal F) * (γ_all j₁ : AbsGal F)⁻¹, h₁⟩ =
            (restrictWeilChar F (hFiMC (idx_all j₂)) (D_orb.get (idx_all j₂)).χ)
              ⟨(γ_all j₂ : AbsGal F) * (w : AbsGal F) * (γ_all j₂ : AbsGal F)⁻¹, h₂⟩) →
        j₁ = j₂) :=
by
  have h_s3 : ∀ (C₀ : Type u) [Group C₀] [Fintype C₀]
      (q₀ m : ℕ) (hq_pos : 0 < q₀) (hCard_C₀ : Fintype.card C₀ = q₀)
      (ψ : Fin m → (C₀ →* (Ω F)ˣ))
      (hψ_ne1 : ∀ j : Fin m, ψ j ≠ 1)
      (h_sum : ∀ c : C₀,
        1 + (∑ j : Fin m, (ψ j c : Ω F)) = if c = 1 then (q₀ : Ω F) else 0),
      Function.Injective ψ := by
    clear * -
    intro C₀ _ _ q₀ m hq_pos hCard_C₀ ψ hψ_ne1 h_sum
    have h_ortho : ∀ χ : C₀ →* (Ω F)ˣ,
        (∑ c : C₀, (χ c : Ω F)) = if χ = 1 then (q₀ : Ω F) else 0 := by
      intro χ
      by_cases hχ : χ = 1
      · simp [hχ, Finset.sum_const, Finset.card_univ, hCard_C₀]
      · rw [if_neg hχ]
        have hex_c₀ : ∃ c₀ : C₀, χ c₀ ≠ 1 := by
          by_contra hall
          push_neg at hall
          exact hχ (MonoidHom.ext hall)
        obtain ⟨c₀, hc₀⟩ := hex_c₀
        set S_sum : Ω F := ∑ c : C₀, (χ c : Ω F)
        have h_reidx : S_sum = (χ c₀ : Ω F) * S_sum := by
          dsimp [S_sum]
          conv_lhs =>
            rw [← Fintype.sum_equiv (Equiv.mulLeft c₀) (fun c => (χ (c₀ * c) : Ω F))
              (fun c => (χ c : Ω F)) (fun _ => rfl)]
          simp only [map_mul, Units.val_mul, ← Finset.mul_sum]
        have h_mul_zero : ((χ c₀ : Ω F) - 1) * S_sum = 0 := by
          linear_combination h_reidx.symm
        have hc₀_val : (χ c₀ : Ω F) ≠ 1 := fun h => hc₀ (Units.ext h)
        have h_sub_ne : (χ c₀ : Ω F) - 1 ≠ 0 := sub_ne_zero.mpr hc₀_val
        exact (mul_eq_zero.mp h_mul_zero).resolve_left h_sub_ne
    intro j₁ j₂ hψ_eq
    let ψ₀ : C₀ →* (Ω F)ˣ := ψ j₁
    have hψ₀_inv_ne1 : ψ₀⁻¹ ≠ 1 := by
      intro h
      apply hψ_ne1 j₁
      apply MonoidHom.ext
      intro c
      have h1 : (ψ₀ c)⁻¹ = 1 := by
        change ψ₀⁻¹ c = 1
        rw [h, MonoidHom.one_apply]
      exact inv_eq_one.mp h1
    have h_inner :
        (∑ c : C₀, (ψ₀⁻¹ c : Ω F) * (1 + ∑ j : Fin m, (ψ j c : Ω F))) =
        ∑ c : C₀, (ψ₀⁻¹ c : Ω F) * (if c = 1 then (q₀ : Ω F) else 0) :=
      Finset.sum_congr rfl (fun c _ => congrArg ((ψ₀⁻¹ c : Ω F) * ·) (h_sum c))
    have h_rhs :
        (∑ c : C₀, (ψ₀⁻¹ c : Ω F) * (if c = 1 then (q₀ : Ω F) else 0)) = (q₀ : Ω F) := by
      have h1 : ∀ c : C₀, (ψ₀⁻¹ c : Ω F) * (if c = 1 then (q₀ : Ω F) else 0) =
          if c = 1 then (ψ₀⁻¹ c : Ω F) * (q₀ : Ω F) else 0 :=
        fun c => by split_ifs <;> ring
      simp_rw [h1, Fintype.sum_ite_eq', map_one, Units.val_one, one_mul]
    have h_term_c : ∀ c : C₀,
        (ψ₀⁻¹ c : Ω F) * (1 + ∑ j : Fin m, (ψ j c : Ω F)) =
        (ψ₀⁻¹ c : Ω F) + ∑ j : Fin m, ((ψ₀⁻¹ * ψ j) c : Ω F) := by
      intro c
      rw [mul_add, mul_one, Finset.mul_sum]
      congr 1
    have h_lhs_step1 :
        (∑ c : C₀, (ψ₀⁻¹ c : Ω F) * (1 + ∑ j : Fin m, (ψ j c : Ω F))) =
        ∑ j : Fin m, ∑ c : C₀, ((ψ₀⁻¹ * ψ j) c : Ω F) := by
      simp_rw [h_term_c]
      rw [Finset.sum_add_distrib, h_ortho ψ₀⁻¹, if_neg hψ₀_inv_ne1, zero_add, Finset.sum_comm]
    have h_inv_mul_eq : ∀ χ : C₀ →* (Ω F)ˣ, ψ₀⁻¹ * χ = 1 ↔ χ = ψ₀ := by
      intro χ
      refine ⟨fun h => MonoidHom.ext fun c => ?_, fun h => MonoidHom.ext fun c => ?_⟩
      · have hc : (ψ₀ c)⁻¹ * χ c = 1 := congrArg (fun f : C₀ →* (Ω F)ˣ => f c) h
        exact (inv_mul_eq_one.mp hc).symm
      · subst h
        exact inv_mul_cancel (ψ₀ c)
    have h_inner_j : ∀ j : Fin m,
        (∑ c : C₀, ((ψ₀⁻¹ * ψ j) c : Ω F)) =
        (if ψ j = ψ₀ then (1 : Ω F) else 0) * (q₀ : Ω F) := by
      intro j
      rw [h_ortho (ψ₀⁻¹ * ψ j), if_congr (h_inv_mul_eq (ψ j)) rfl rfl]
      split_ifs <;> ring
    have h_lhs :
        (∑ c : C₀, (ψ₀⁻¹ c : Ω F) * (1 + ∑ j : Fin m, (ψ j c : Ω F))) =
        ((Finset.univ.filter (fun j : Fin m => ψ j = ψ₀)).card : Ω F) * (q₀ : Ω F) := by
      rw [h_lhs_step1]
      simp_rw [h_inner_j, ← Finset.sum_mul, Finset.sum_boole]
    have h_eq_card_q :
        ((Finset.univ.filter (fun j : Fin m => ψ j = ψ₀)).card : Ω F) * (q₀ : Ω F) =
        ((1 : ℕ) : Ω F) * (q₀ : Ω F) := by
      rw [← h_lhs, h_inner, h_rhs, Nat.cast_one, one_mul]
    have hq_ne0 : (q₀ : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr hq_pos.ne'
    have h_card_one :
        (Finset.univ.filter (fun j : Fin m => ψ j = ψ₀)).card = 1 :=
      Nat.cast_injective (mul_right_cancel₀ hq_ne0 h_eq_card_q)
    obtain ⟨j₀, hj₀⟩ := Finset.card_eq_one.mp h_card_one
    have hmem₁ : j₁ ∈ Finset.univ.filter (fun j : Fin m => ψ j = ψ₀) := by simp [ψ₀]
    have hmem₂ : j₂ ∈ Finset.univ.filter (fun j : Fin m => ψ j = ψ₀) := by simp [ψ₀, ← hψ_eq]
    rw [hj₀, Finset.mem_singleton] at hmem₁ hmem₂
    exact hmem₁.trans hmem₂.symm
  have h_s2 : ∀ (G₀ : Type u) [Group G₀] [Fintype G₀]
      (π : relWeil F L →* G₀)
      (C H : Subgroup G₀)
      (hC_conj : ∀ {x : G₀}, x ∈ C → ∀ g : G₀, g⁻¹ * x * g ∈ C)
      (M_sub : Fin D_orb.length → Subgroup G₀)
      (hC_le : ∀ i : Fin D_orb.length, C ≤ M_sub i)
      (bar_χ : ∀ i : Fin D_orb.length, M_sub i →* (Ω F)ˣ)
      (q₀ : ℕ)
      (hsurj : Function.Surjective π)
      (hCard_GH : Nat.card (G₀ ⧸ H) = q₀)
      (h_disj_HC : ∀ g : G₀, g ∈ H → g ∈ C → g = 1)
      (h_mem_H : ∀ w : relWeil F L, w ∈ (relWeil F E).subgroupOf (relWeil F L) ↔ π w ∈ H)
      (h_mem_Fi : ∀ (i : Fin D_orb.length) (w : relWeil F L),
        w ∈ (relWeil F (D_orb.get i).field).subgroupOf (relWeil F L) ↔ π w ∈ M_sub i)
      (hbar_χ : ∀ (i : Fin D_orb.length) (w : relWeil F (D_orb.get i).field)
        (hw : π (Subgroup.inclusion (relWeil_antitone F (D_orb.get i).le) w) ∈ M_sub i),
        (D_orb.get i).χ w =
          bar_χ i ⟨π (Subgroup.inclusion (relWeil_antitone F (D_orb.get i).le) w), hw⟩)
      (hD_orb_coeff : ∀ i : Fin D_orb.length, (D_orb.get i).coeff = 1)
      (c : C),
      1 + (∑ i : Fin D_orb.length,
        ∑ u₀ : G₀ ⧸ M_sub i,
          (bar_χ i ⟨(cosetRep u₀)⁻¹ * c.1 * cosetRep u₀,
            hC_le i (hC_conj c.2 (cosetRep u₀))⟩ : Ω F)) =
        if c = 1 then (q₀ : Ω F) else 0 := by
    clear * - hD₁_sub
    intro G₀ _ _ π C H hC_conj M_sub hC_le bar_χ q₀ hsurj hCard_GH h_disj_HC
      h_mem_H h_mem_Fi hbar_χ hD_orb_coeff c
    let G_L := relWeil F L
    have h_tr_coset : ∀ (E₁ : IntermediateField F (AlgebraicClosure F))
        (hLE₁ : L ≤ E₁) (M : Subgroup G₀)
        (h_mem : ∀ w : G_L, w ∈ (relWeil F E₁).subgroupOf G_L ↔ π w ∈ M)
        (χ_E₁ : relWeil F E₁ →* (Ω F)ˣ)
        (ψ : M →* (Ω F)ˣ)
        (hψ_eq : ∀ (w : relWeil F E₁)
          (hw : π (Subgroup.inclusion (relWeil_antitone F hLE₁) w) ∈ M),
          χ_E₁ w = ψ ⟨π (Subgroup.inclusion (relWeil_antitone F hLE₁) w), hw⟩)
        (w : G_L),
        (⟨1, E₁, hLE₁, χ_E₁⟩ : MonomialTerm F L).trace F L w =
          ∑ u₀ : G₀ ⧸ M,
            if hc : (cosetRep u₀)⁻¹ * π w * cosetRep u₀ ∈ M then
              (ψ ⟨(cosetRep u₀)⁻¹ * π w * cosetRep u₀, hc⟩ : Ω F)
            else 0 := by
      intro E₁ hLE₁ M h_mem χ_E₁ ψ hψ_eq w
      let H_E₁ : Subgroup G_L := (relWeil F E₁).subgroupOf G_L
      let W := ULift.{u} (Ω F)
      let e_sub : H_E₁ ≃* relWeil F E₁ := Subgroup.subgroupOfEquivOfLe (relWeil_antitone F hLE₁)
      let ρ_E₁ : Representation (Ω F) H_E₁ W := (charRep F E₁ χ_E₁).comp e_sub.toMonoidHom
      let s : G₀ ⧸ M → G_L := fun u₀ => (hsurj (cosetRep u₀)).choose
      have hs_spec : ∀ u₀ : G₀ ⧸ M, π (s u₀) = cosetRep u₀ :=
        fun u₀ => (hsurj (cosetRep u₀)).choose_spec
      let u : G_L → G₀ ⧸ M := fun x => QuotientGroup.mk (π x)⁻¹
      let r_map : G_L → G_L := fun x => s (u x)
      have h_xr_mem : ∀ x : G_L, x * r_map x ∈ H_E₁ := by
        intro x
        rw [h_mem]
        change π (x * s (u x)) ∈ M
        rw [map_mul, hs_spec (u x)]
        have hout : QuotientGroup.mk (s := M) (cosetRep (u x)) = QuotientGroup.mk (s := M) (π x)⁻¹ :=
          Quotient.out_eq (u x)
        have hrel : (cosetRep (u x))⁻¹ * (π x)⁻¹ ∈ M := QuotientGroup.eq.mp hout
        have hinv : (π x * cosetRep (u x))⁻¹ ∈ M := by
          have heq : (π x * cosetRep (u x))⁻¹ = (cosetRep (u x))⁻¹ * (π x)⁻¹ := mul_inv_rev _ _
          rw [heq]
          exact hrel
        exact M.inv_mem_iff.mp hinv
      have hu_mul : ∀ (h₀ : H_E₁) (x : G_L), u ((h₀ : G_L) * x) = u x := by
        intro h₀ x
        change QuotientGroup.mk (s := M) (π ((h₀ : G_L) * x))⁻¹ = QuotientGroup.mk (s := M) (π x)⁻¹
        rw [QuotientGroup.eq]
        have heq : ((π ((h₀ : G_L) * x))⁻¹)⁻¹ * (π x)⁻¹ = π (h₀ : G_L) := by
          rw [inv_inv, map_mul, mul_inv_cancel_right]
        rw [heq]
        exact (h_mem (h₀ : G_L)).mp h₀.2
      have hr_mul : ∀ (h₀ : H_E₁) (x : G_L), r_map ((h₀ : G_L) * x) = r_map x :=
        fun h₀ x => congrArg s (hu_mul h₀ x)
      have hu_rep_inv : ∀ u₀ : G₀ ⧸ M, u (s u₀)⁻¹ = u₀ := by
        intro u₀
        change QuotientGroup.mk (s := M) (π (s u₀)⁻¹)⁻¹ = u₀
        rw [map_inv, inv_inv, hs_spec u₀]
        exact Quotient.out_eq u₀
      have hr_rep_inv : ∀ u₀ : G₀ ⧸ M, r_map (s u₀)⁻¹ = s u₀ :=
        fun u₀ => congrArg s (hu_rep_inv u₀)
      have hu_iff : ∀ u₀ : G₀ ⧸ M,
          u ((s u₀)⁻¹ * w) = u₀ ↔ (cosetRep u₀)⁻¹ * π w * cosetRep u₀ ∈ M := by
        intro u₀
        have h1 : u ((s u₀)⁻¹ * w) = QuotientGroup.mk (s := M) (π ((s u₀)⁻¹ * w))⁻¹ := rfl
        have h2 : u₀ = QuotientGroup.mk (s := M) (cosetRep u₀) := (Quotient.out_eq u₀).symm
        rw [h1]
        conv_lhs => rhs; rw [h2]
        rw [QuotientGroup.eq, inv_inv, map_mul, map_inv, hs_spec u₀]
      let Φ : indSpace H_E₁ ρ_E₁ ≃ₗ[Ω F] ((G₀ ⧸ M) → Ω F) :=
        { toFun := fun f u₀ => (f.1 (s u₀)⁻¹).down
          map_add' := fun _ _ => funext fun _ => rfl
          map_smul' := fun _ _ => funext fun _ => rfl
          invFun := fun φ =>
            ⟨fun x => ρ_E₁ ⟨x * r_map x, h_xr_mem x⟩ (ULift.up (φ (u x))), by
              intro h₀ x
              dsimp only
              rw [hu_mul h₀ x]
              have hsub : (⟨((h₀ : G_L) * x) * r_map ((h₀ : G_L) * x), h_xr_mem ((h₀ : G_L) * x)⟩ : H_E₁) =
                  h₀ * ⟨x * r_map x, h_xr_mem x⟩ := by
                apply Subtype.ext
                change ((h₀ : G_L) * x) * r_map ((h₀ : G_L) * x) = (h₀ : G_L) * (x * r_map x)
                rw [hr_mul h₀ x, mul_assoc]
              rw [hsub, map_mul, Module.End.mul_apply]⟩
          left_inv := fun f => by
            apply Subtype.ext
            funext x
            dsimp only
            have h_eq : f.1 ((x * r_map x) * (r_map x)⁻¹) =
                ρ_E₁ ⟨x * r_map x, h_xr_mem x⟩ (f.1 (r_map x)⁻¹) :=
              f.2 ⟨x * r_map x, h_xr_mem x⟩ (r_map x)⁻¹
