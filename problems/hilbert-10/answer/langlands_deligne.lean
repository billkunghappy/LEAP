      dsimp [I_T4]
      rw [if_congr hdvd_iff rfl rfl]
      split_ifs <;> ring
    rw [Finset.sum_congr rfl hcongr,
      Finset.sum_ite_eq' I_q (p - r) (fun q => (-N_L) ^ q * ((p - 1 : ℕ) : L)),
      if_pos (Finset.mem_range.mpr (by omega))]
    have hneg_N : (-N_L) ^ (p - r) = - ((-1 : L) ^ r) * N_L ^ (p - r) := by
      have h1 : -N_L = (-1 : L) * N_L := by ring
      rw [h1, mul_pow]
      have hsign : (-1 : L) ^ (p - r) = - ((-1 : L) ^ r) := by
        have hprod : (-1 : L) ^ (p - r) * (-1 : L) ^ r = -1 := by
          rw [← pow_add, Nat.sub_add_cancel (by omega : r ≤ p), hp_odd.neg_one_pow]
        have hsq : (-1 : L) ^ r * (-1 : L) ^ r = 1 := by
          rw [← mul_pow, neg_one_mul, neg_neg, one_pow]
        linear_combination (-1 : L) ^ r * hprod - (-1 : L) ^ (p - r) * hsq
      rw [hsign]
    rw [hneg_N]
    ring
  have hMeval_eq_Bp : M_eval = B_p := by
    have hIr_split : I_r = insert 1 I_r2 := by
      dsimp [I_r, I_r2]
      exact (Finset.insert_Icc_add_one_left_eq_Icc (by omega : 1 ≤ p - 1)).symm
    have h1_not_mem : (1 : ℕ) ∉ I_r2 := by
      dsimp [I_r2]; rw [Finset.mem_Icc]; omega
    have hN_sum0 : N_L * sum0 = - N_L ^ (p - 1) * s_u 1 +
        ∑ r ∈ I_r2, (-1 : L) ^ r * N_L ^ (p - r) * s_u r := by
      dsimp [sum0]
      rw [Finset.mul_sum]
      have hN_congr : ∀ r ∈ I_r,
          N_L * ((-1 : L) ^ r * N_L ^ (p - 1 - r) * s_u r) =
            (-1 : L) ^ r * N_L ^ (p - r) * s_u r := by
        intro r hr
        have hr_le : r ≤ p - 1 := (Finset.mem_Icc.mp hr).2
        have hpr : p - r = (p - 1 - r) + 1 := by omega
        conv_rhs => rw [hpr, pow_succ']
        ring
      rw [Finset.sum_congr rfl hN_congr, hIr_split, Finset.sum_insert h1_not_mem]
      ring
    have hsum3 : (∑ r ∈ I_r, s_u r * (∑ q ∈ I_q, (-N_L) ^ q * I_T4 (2 * p - 1 - q - r))) =
        ((p - 1 : ℕ) : L) * s_u 1 -
          ((p - 1 : ℕ) : L) * (∑ r ∈ I_r2, (-1 : L) ^ r * N_L ^ (p - r) * s_u r) := by
      rw [hIr_split, Finset.sum_insert h1_not_mem, hq_r1]
      have hr2_congr : ∀ r ∈ I_r2,
          s_u r * (∑ q ∈ I_q, (-N_L) ^ q * I_T4 (2 * p - 1 - q - r)) =
            - ((p - 1 : ℕ) : L) * ((-1 : L) ^ r * N_L ^ (p - r) * s_u r) := by
        intro r hr
        rw [hq_r2 r hr]
        ring
      rw [Finset.sum_congr rfl hr2_congr, ← Finset.mul_sum]
      ring
    have hp_cast : (1 : L) + ((p - 1 : ℕ) : L) = (p : L) := by
      rw [← Nat.cast_one, ← Nat.cast_add, Nat.add_sub_of_le hp_pos]
    dsimp [M_eval, B_p]
    rw [hN_sum0, hsum3]
    linear_combination (s_u 1 - ∑ r ∈ I_r2, (-1 : L) ^ r * N_L ^ (p - r) * s_u r) * hp_cast
  have hBp_val : B_p = 0 ∨ (b : ℤ) ≤ valL F L B_p := by
    have h1_mem : 1 ∈ I_r := by dsimp [I_r]; rw [Finset.mem_Icc]; omega
    have hsum_r2 : (∑ r ∈ I_r2, (-1 : L) ^ r * N_L ^ (p - r) * s_u r) = 0 ∨
        (m_p : ℤ) ≤ valL F L (∑ r ∈ I_r2, (-1 : L) ^ r * N_L ^ (p - r) * s_u r) := by
      apply hval_finset_sum I_r2 _ (m_p : ℤ)
      intro r hr
      have hr_bounds := Finset.mem_Icc.mp hr
      have hr_Ir : r ∈ I_r := by dsimp [I_r]; rw [Finset.mem_Icc]; omega
      have hneg_r : (-1 : L) ^ r = 0 ∨ 0 ≤ valL F L ((-1 : L) ^ r) :=
        hval_pow_int (-1 : L) r (Or.inr (by omega))
      have hN_pr : N_L ^ (p - r) = 0 ∨ 0 ≤ valL F L (N_L ^ (p - r)) :=
        hval_pow_int N_L (p - r) hN_int
      have h1 := hval_mul_ge 0 0 ((-1 : L) ^ r) (N_L ^ (p - r)) hneg_r hN_pr
      rw [add_zero] at h1
      have h2 := hval_mul_ge 0 (m_p : ℤ)
        ((-1 : L) ^ r * N_L ^ (p - r)) (s_u r) h1 (hs_val r hr_Ir)
      rwa [zero_add] at h2
    have hinner := hval_sub (m_p : ℤ) (s_u 1) _ (hs_val 1 h1_mem) hsum_r2
    have hmul := hval_mul_ge (m_p : ℤ) (m_p : ℤ) (p : L) _ hp_val hinner
    exact hval_mono hb_le_2mp hmul
  have h1N_X_val : (1 - N_L ^ (p - 1)) * X = 0 ∨
      (b : ℤ) ≤ valL F L ((1 - N_L ^ (p - 1)) * X) := by
    have h1 : (1 - N_L ^ (p - 1)) * X - M_main = 0 ∨
        (b : ℤ) ≤ valL F L ((1 - N_L ^ (p - 1)) * X - M_main) :=
      hval_mono (by omega : (b : ℤ) ≤ (b + 1 : ℤ)) hX_sub_Mmain
    have h2 : M_main - B_p = 0 ∨ (b : ℤ) ≤ valL F L (M_main - B_p) := by
      rw [← hMeval_eq_Bp]
      exact hval_mono (by omega : (b : ℤ) ≤ (b + 1 : ℤ)) hMmain_sub_Meval
    have h3 := hval_add (b : ℤ) _ _ h1 h2
    have h4 := hval_add (b : ℤ) _ _ h3 hBp_val
    have hid : ((1 - N_L ^ (p - 1)) * X - M_main) + (M_main - B_p) + B_p =
        (1 - N_L ^ (p - 1)) * X := by ring
    rwa [hid] at h4
  let P_N : L := ∏ j ∈ S', (N_L + τ j)
  let Delta_P : L := P_N - (N_L ^ (p - 1) - 1)
  have hPN_prop : P_N ≠ 0 ∧ valL F L P_N = 0 :=
    hval_finset_prod_zero S' (fun j => N_L + τ j) (fun j hj => (hτ_int j hj).2)
  have h1N_prop : 1 - N_L ^ (p - 1) ≠ 0 ∧ valL F L (1 - N_L ^ (p - 1)) = 0 := by
    have hPN_inv : P_N⁻¹ = 0 ∨ 0 ≤ valL F L P_N⁻¹ :=
      Or.inr (le_of_eq (hval_inv_zero P_N hPN_prop.1 hPN_prop.2).symm)
    have hneg_DeltaP : -Delta_P = 0 ∨ (1 : ℤ) ≤ valL F L (-Delta_P) :=
      hval_mono (by omega : (1 : ℤ) ≤ (b + 1 : ℤ)) (hval_neg_iff (b + 1 : ℤ) Delta_P hTeich_3)
    have hquot : P_N⁻¹ * (-Delta_P) = 0 ∨ (1 : ℤ) ≤ valL F L (P_N⁻¹ * (-Delta_P)) := by
      have h := hval_mul_ge 0 1 P_N⁻¹ (-Delta_P) hPN_inv hneg_DeltaP
      rwa [zero_add] at h
    have hu := hunit_of_gt0 (P_N⁻¹ * (-Delta_P)) hquot
    have hfac : 1 - N_L ^ (p - 1) = - (P_N * (1 + P_N⁻¹ * (-Delta_P))) := by
      have hmul_inv : P_N * (P_N⁻¹ * (-Delta_P)) = -Delta_P :=
        mul_inv_cancel_left₀ hPN_prop.1 (-Delta_P)
      calc 1 - N_L ^ (p - 1)
        _ = - (P_N + (-Delta_P)) := by dsimp [Delta_P]; ring
        _ = - (P_N + P_N * (P_N⁻¹ * (-Delta_P))) := by rw [hmul_inv]
        _ = - (P_N * (1 + P_N⁻¹ * (-Delta_P))) := by ring
    rw [hfac]
    refine ⟨neg_ne_zero.mpr (mul_ne_zero hPN_prop.1 hu.1), ?_⟩
    rw [hval_neg, hval_mul P_N _ hPN_prop.1 hu.1, hPN_prop.2, hu.2, add_zero]
  have h1N_inv : (1 - N_L ^ (p - 1))⁻¹ = 0 ∨ 0 ≤ valL F L (1 - N_L ^ (p - 1))⁻¹ :=
    Or.inr (le_of_eq (hval_inv_zero (1 - N_L ^ (p - 1)) h1N_prop.1 h1N_prop.2).symm)
  have hX_eq : X = (1 - N_L ^ (p - 1))⁻¹ * ((1 - N_L ^ (p - 1)) * X) :=
    (inv_mul_cancel_left₀ h1N_prop.1 X).symm
  rw [hX_eq]
  have hfinal := hval_mul_ge 0 (b : ℤ) (1 - N_L ^ (p - 1))⁻¹
    ((1 - N_L ^ (p - 1)) * X) h1N_inv h1N_X_val
  rwa [zero_add] at hfinal

theorem ld_wild_low_cond_ge_two_mult_add_phase_match (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (ha_ge2 : 2 ≤ condExp F L χ')
    (hab : condExp F L χ' ≤ condExp F L ν₁)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL_triv : ∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1)
    (t : ℕ) (ht_ge1 : 1 ≤ t) (hb_eq : condExp F L ν₁ = t + 1)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (hp_val : (Module.finrank L (IntermediateField.extendScalars hLK) : L) = 0 ∨
      ((((Module.finrank L (IntermediateField.extendScalars hLK) - 1) * (t + 1) /
        Module.finrank L (IntermediateField.extendScalars hLK) : ℕ) : ℤ) ≤
        valL F L (Module.finrank L (IntermediateField.extendScalars hLK) : L)))
    (s : K → ℕ → L)
    (hs_one : ∀ y : K, s y 1 = traceLM F hLK y)
    (hs_val : ∀ (y : K) (r : ℕ),
      r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1) →
      ∀ (q m : ℤ), (y = 0 ∨ q ≤ valL F K y) →
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ (r : ℤ) * q →
        (s y r = 0 ∨ m ≤ valL F L (s y r)))
    (hs_poly : ∀ (y : K) (c ε : L),
      normLM F hLK
        (IntermediateField.inclusion hLK c + IntermediateField.inclusion hLK ε * y) =
        c ^ (Module.finrank L (IntermediateField.extendScalars hLK)) +
          (∑ r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1),
            c ^ (Module.finrank L (IntermediateField.extendScalars hLK) - r) * ε ^ r * s y r) +
          ε ^ (Module.finrank L (IntermediateField.extendScalars hLK)) * normLM F hLK y)
    (c_τ : Lˣ) (u : Kˣ) (N : Lˣ)
    (τ_unit τ_tilde c_ν c_twist : ℕ → Lˣ) (c_χ : Lˣ) (c_χK : Kˣ)
    (hc_τ_val : valL F L (c_τ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hu_norm : Units.map (normLM F hLK) u = N)
    (hu_val : valL F K (u : K) = (condExp F L ν₁ - condExp F L χ' : ℤ))
    (hN_val : valL F L (N : L) = (condExp F L ν₁ - condExp F L χ' : ℤ))
    (hc_χ_eq : c_χ = c_τ * N⁻¹)
    (hc_χK_inv : ((c_χK⁻¹ : Kˣ) : K) =
      IntermediateField.inclusion hLK (((c_τ⁻¹ : Lˣ) : L)) *
        (IntermediateField.inclusion hLK (N : L) - (u : K)))
    (hτ_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
      (τ_tilde j : L) = (j : L) ^ ((Module.finrank L (IntermediateField.extendScalars hLK)) ^ (condExp F L ν₁)) ∧
      τ_unit j = (τ_tilde j) ^ (Module.finrank L (IntermediateField.extendScalars hLK)) ∧
      Units.map (normLM F hLK) (Units.map (IntermediateField.inclusion hLK).toMonoidHom (τ_tilde j)) = τ_unit j ∧
      ν₁ (τ_unit j) = 1 ∧
      c_ν j = c_τ * (τ_unit j)⁻¹ ∧
      (N : L) + (τ_unit j : L) ≠ 0 ∧
      valL F L ((N : L) + (τ_unit j : L)) = 0 ∧
      (((c_twist j)⁻¹ : Lˣ) : L) = ((c_τ⁻¹ : Lˣ) : L) * ((N : L) + (τ_unit j : L)))
    (hc_χ_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ⁻¹ : Lˣ) : L) * x))
    (hc_ν_twist : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
      valL F L (c_ν j : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ ∧
      (∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          ((ν₁ ^ j) (Units.mk0 (1 + x) hx) : Ω F) = ψ ((((c_ν j)⁻¹ : Lˣ) : L) * x)) ∧
      valL F L (c_twist j : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ ∧
      (∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          ((ν₁ ^ j * χ') (Units.mk0 (1 + x) hx) : Ω F) =
            ψ ((((c_twist j)⁻¹ : Lˣ) : L) * x)))
    (hTeich : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2 →
      (∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
        (τ_tilde j : L) - (τ_unit j : L) = 0 ∨
          (condExp F L ν₁ + 1 : ℤ) ≤ valL F L ((τ_tilde j : L) - (τ_unit j : L))) ∧
      (∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
        (τ_unit j : L) ^ (Module.finrank L (IntermediateField.extendScalars hLK) - 1) - 1 = 0 ∨
          (condExp F L ν₁ + 1 : ℤ) ≤
            valL F L ((τ_unit j : L) ^ (Module.finrank L (IntermediateField.extendScalars hLK) - 1) - 1)) ∧
      ((∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
          ((N : L) + (τ_unit j : L))) -
        ((N : L) ^ (Module.finrank L (IntermediateField.extendScalars hLK) - 1) - 1) = 0 ∨
        (condExp F L ν₁ + 1 : ℤ) ≤
          valL F L
            ((∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
                ((N : L) + (τ_unit j : L))) -
              ((N : L) ^ (Module.finrank L (IntermediateField.extendScalars hLK) - 1) - 1))) ∧
      (∀ r ∈ Finset.Icc 1 (2 * (Module.finrank L (IntermediateField.extendScalars hLK) - 1)),
        (∑ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
            (τ_unit j : L) ^ r) -
          (if (Module.finrank L (IntermediateField.extendScalars hLK) - 1) ∣ r then
            ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : L)
           else 0) = 0 ∨
          (condExp F L ν₁ + 1 : ℤ) ≤
            valL F L
              ((∑ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
                  (τ_unit j : L) ^ r) -
                (if (Module.finrank L (IntermediateField.extendScalars hLK) - 1) ∣ r then
                  ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : L)
                 else 0))))
    (hNonDyadicBoundary : ¬ (Module.finrank L (IntermediateField.extendScalars hLK) = 2 ∧
      condExp F L χ' = condExp F L ν₁ ∧ condExp F L ν₁ % 2 = 1)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    let S' := (Finset.range p).erase 0
    (((χ'.comp (Units.map (normLM F hLK))) c_χK : Ω F) *
      (∏ j ∈ S', ((ν₁ ^ j) (c_ν j) : Ω F)) *
      (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K)) *
      (∏ j ∈ S', ψ ((((c_ν j)⁻¹ : Lˣ) : L)))) =
    ((χ' c_χ : Ω F) *
      (∏ j ∈ S', ((ν₁ ^ j * χ') (c_twist j) : Ω F)) *
      ψ (((c_χ⁻¹ : Lˣ) : L)) *
      (∏ j ∈ S', ψ ((((c_twist j)⁻¹ : Lˣ) : L)))) :=
by
  by_cases hp2 : Module.finrank L (IntermediateField.extendScalars hLK) = 2
  · have hNonDyadic : condExp F L χ' < condExp F L ν₁ ∨ condExp F L ν₁ % 2 = 0 := by
      omega
    have hτ_1 : (τ_tilde 1 : L) = 1 ∧ (τ_unit 1 : L) = 1 ∧
        (N : L) + (τ_unit 1 : L) ≠ 0 ∧ valL F L ((N : L) + (τ_unit 1 : L)) = 0 := by
      have h1 := hτ_props 1 (by omega) (by omega)
      have ht1 : (τ_tilde 1 : L) = 1 := by
        rw [h1.1, Nat.cast_one, one_pow]
      have hu1 : (τ_unit 1 : L) = 1 := by
        have hpow : (τ_unit 1 : L) = (τ_tilde 1 : L) ^
            (Module.finrank L (IntermediateField.extendScalars hLK)) :=
          congr_arg Units.val h1.2.1
        rw [hpow, ht1, one_pow]
      exact ⟨ht1, hu1, h1.2.2.2.2.2.1, h1.2.2.2.2.2.2.1⟩
    obtain ⟨z₀, z, hz₀_norm, hz₀_val, hz_norm, hz_val, hX_val⟩ :=
      ld_wild_low_cond_dyadic_correction_units F L K hLK hp2
        (condExp F L χ') (condExp F L ν₁) t ha_ge2 hab ht_ge1 hb_eq hNonDyadic
        hvalL_props hp_val s hs_val hs_poly u N τ_unit τ_tilde hu_norm hu_val hτ_1
    exact ld_wild_low_cond_phase_factor_reduction F L K hLK hPrime ψ ν₁ χ'
      hν₁_ker hvalL_props hSpecL_triv s hs_one c_τ u N τ_unit τ_tilde c_ν c_twist c_χ c_χK
      hc_τ_val hc_χ_eq hc_χK_inv hτ_props hc_χ_stat hc_ν_twist
      z₀ z hz₀_norm hz₀_val hz_norm hz_val hX_val
  · obtain ⟨hT1, hT2, hT3, hT4⟩ := hTeich hp2
    obtain ⟨hs_u, hτ_int0, z₀, z, hz₀_norm, hz₀_mp, hz₀_val, hz_norm, hz_mp, hz_val,
      hδ₀_cong, hδ_cong⟩ :=
      ld_wild_low_cond_odd_prime_correction_units F L K hLK hPrime hp2
        (condExp F L χ') (condExp F L ν₁) t ha_ge2 hab ht_ge1 hb_eq
        hvalL_props s hs_val hs_poly u N τ_unit τ_tilde hu_norm hu_val hN_val
        (fun j hj hj_pos => ⟨(hτ_props j hj hj_pos).1, (hτ_props j hj hj_pos).2.1,
          (hτ_props j hj hj_pos).2.2.2.2.2.1, (hτ_props j hj hj_pos).2.2.2.2.2.2.1⟩)
        hT1 hT3
    have hp_val' : (Module.finrank L (IntermediateField.extendScalars hLK) : L) = 0 ∨
        ((((Module.finrank L (IntermediateField.extendScalars hLK) - 1) * (condExp F L ν₁) /
          Module.finrank L (IntermediateField.extendScalars hLK) : ℕ) : ℤ) ≤
          valL F L (Module.finrank L (IntermediateField.extendScalars hLK) : L)) := by
      rw [hb_eq]; exact hp_val
    have hN_int : (N : L) = 0 ∨ 0 ≤ valL F L (N : L) := by
      right; rw [hN_val]; omega
    have hX_val :=
      ld_wild_low_cond_odd_prime_error_cancellation F L
        (Module.finrank L (IntermediateField.extendScalars hLK)) (condExp F L ν₁)
        hPrime hp2 hb_ge2 hvalL_props hp_val' (N : L) ((z₀ : L) - 1)
        (fun j => (τ_unit j : L)) (fun j => (z j : L) - 1) (s (u : K))
        hN_int
        (fun j hj => by
          have hj_lt : j < Module.finrank L (IntermediateField.extendScalars hLK) :=
            Finset.mem_range.mp (Finset.mem_erase.mp hj).2
          have hj_pos : 0 < j := Nat.pos_of_ne_zero (Finset.mem_erase.mp hj).1
          exact ⟨hτ_int0 j hj, (hτ_props j hj_lt hj_pos).2.2.2.2.2.1,
            (hτ_props j hj_lt hj_pos).2.2.2.2.2.2.1⟩)
        hs_u hz_mp hδ₀_cong hδ_cong
        (fun j hj => hT2 j (Finset.mem_range.mp (Finset.mem_erase.mp hj).2)
          (Nat.pos_of_ne_zero (Finset.mem_erase.mp hj).1))
        hT3 hT4
    exact ld_wild_low_cond_phase_factor_reduction F L K hLK hPrime ψ ν₁ χ'
      hν₁_ker hvalL_props hSpecL_triv s hs_one c_τ u N τ_unit τ_tilde c_ν c_twist c_χ c_χK
      hc_τ_val hc_χ_eq hc_χK_inv hτ_props hc_χ_stat hc_ν_twist
      z₀ z hz₀_norm hz₀_val hz_norm hz_val hX_val

theorem ld_wild_low_cond_ge_two_eps_product_assembly (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hν_cond_eq : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j) = condExp F L ν₁)
    (hqK : qL F K = qL F L)
    (ha_ge2 : 2 ≤ condExp F L χ')
    (hab : condExp F L χ' ≤ condExp F L ν₁)
    (haK : condExp F K (χ'.comp (Units.map (normLM F hLK))) = condExp F L χ')
    (htwist_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j * χ') = condExp F L ν₁)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (ϖ_K : Kˣ) (ϖ_L : Lˣ)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E)) *
                ∑ r ∈ R_E,
                  if hr : 1 + (δ : E) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                      ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                  else 0))))
    (R_L : Finset L) (R_K : Finset K)
    (c_ν c_twist : ℕ → Lˣ) (c_χ : Lˣ) (c_χK : Kˣ)
    (hcard_eq : R_K.card = R_L.card)
    (hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r)
    (hRL_sep : ∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0)
    (hRL_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → ∃ r ∈ R_L, x - r = 0 ∨ 1 ≤ valL F L (x - r))
    (hRK_int : ∀ r ∈ R_K, r = 0 ∨ 0 ≤ valL F K r)
    (hRK_sep : ∀ r₁ ∈ R_K, ∀ r₂ ∈ R_K, r₁ ≠ r₂ → valL F K (r₁ - r₂) = 0)
    (hRK_surj : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) → ∃ r ∈ R_K, y - r = 0 ∨ 1 ≤ valL F K (y - r))
    (hc_χ_val : valL F L (c_χ : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_χ_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ⁻¹ : Lˣ) : L) * x))
    (hc_χK_val : valL F K (c_χK : K) = (condExp F L χ' : ℤ) + condExpChar F K (traceChar F hLK ψ))
    (hc_χK_stat : ∀ y : K, (y = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F K y) →
      ∀ hy : 1 + y ≠ 0,
        ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + y) hy) : Ω F) =
          (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K) * y))
    (hc_ν_twist : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
      valL F L (c_ν j : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ ∧
      (∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          ((ν₁ ^ j) (Units.mk0 (1 + x) hx) : Ω F) = ψ ((((c_ν j)⁻¹ : Lˣ) : L) * x)) ∧
      valL F L (c_twist j : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ ∧
      (∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          ((ν₁ ^ j * χ') (Units.mk0 (1 + x) hx) : Ω F) =
            ψ ((((c_twist j)⁻¹ : Lˣ) : L) * x)))
    (hPhaseMatch :
      let p := Module.finrank L (IntermediateField.extendScalars hLK)
      let S' := (Finset.range p).erase 0
      (((χ'.comp (Units.map (normLM F hLK))) c_χK : Ω F) *
        (∏ j ∈ S', ((ν₁ ^ j) (c_ν j) : Ω F)) *
        (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K)) *
        (∏ j ∈ S', ψ ((((c_ν j)⁻¹ : Lˣ) : L)))) =
      ((χ' c_χ : Ω F) *
        (∏ j ∈ S', ((ν₁ ^ j * χ') (c_twist j) : Ω F)) *
        ψ (((c_χ⁻¹ : Lˣ) : L)) *
        (∏ j ∈ S', ψ ((((c_twist j)⁻¹ : Lˣ) : L)))))
    (hHasse_lt : condExp F L χ' < condExp F L ν₁ →
      (condExp F L χ' % 2 = 1 →
        (∑ r ∈ R_K,
          if hr : 1 + ((ϖ_K ^ (condExp F L χ' / 2) : Kˣ) : K) * r ≠ 0 then
            ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + ((ϖ_K ^ (condExp F L χ' / 2) : Kˣ) : K) * r) hr) : Ω F)⁻¹ *
              (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K) * ((ϖ_K ^ (condExp F L χ' / 2) : Kˣ) : K) * r)
          else 0) =
        (∑ r ∈ R_L,
          if hr : 1 + ((ϖ_L ^ (condExp F L χ' / 2) : Lˣ) : L) * r ≠ 0 then
            (χ' (Units.mk0 (1 + ((ϖ_L ^ (condExp F L χ' / 2) : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
              ψ (((c_χ⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L χ' / 2) : Lˣ) : L) * r)
          else 0)) ∧
      (condExp F L ν₁ % 2 = 1 →
        ∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
          (∑ r ∈ R_L,
            if hr : 1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r ≠ 0 then
              ((ν₁ ^ j * χ') (Units.mk0 (1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
                ψ ((((c_twist j)⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r)
            else 0) =
          (∑ r ∈ R_L,
            if hr : 1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r ≠ 0 then
              ((ν₁ ^ j) (Units.mk0 (1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
                ψ ((((c_ν j)⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r)
            else 0)))
    (hHasse_eq_odd : condExp F L χ' = condExp F L ν₁ → condExp F L ν₁ % 2 = 1 →
      Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2 →
      (∑ r ∈ R_K,
        if hr : 1 + ((ϖ_K ^ (condExp F L ν₁ / 2) : Kˣ) : K) * r ≠ 0 then
          ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + ((ϖ_K ^ (condExp F L ν₁ / 2) : Kˣ) : K) * r) hr) : Ω F)⁻¹ *
            (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K) * ((ϖ_K ^ (condExp F L ν₁ / 2) : Kˣ) : K) * r)
        else 0) *
        (∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
          (∑ r ∈ R_L,
            if hr : 1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r ≠ 0 then
              ((ν₁ ^ j) (Units.mk0 (1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
                ψ ((((c_ν j)⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r)
            else 0)) =
      (∑ r ∈ R_L,
        if hr : 1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r ≠ 0 then
          (χ' (Units.mk0 (1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
            ψ (((c_χ⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r)
        else 0) *
        (∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
          (∑ r ∈ R_L,
            if hr : 1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r ≠ 0 then
              ((ν₁ ^ j * χ') (Units.mk0 (1 + ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
                ψ ((((c_twist j)⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L ν₁ / 2) : Lˣ) : L) * r)
            else 0)))
    (hNonDyadicBoundary : ¬ (Module.finrank L (IntermediateField.extendScalars hLK) = 2 ∧
      condExp F L χ' = condExp F L ν₁ ∧ condExp F L ν₁ % 2 = 1)) :
    tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j) ψ) =
    tateEps F K 1 (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j * χ') ψ) :=
by
  set p := Module.finrank L (IntermediateField.extendScalars hLK)
  set S' := (Finset.range p).erase 0
  set a := condExp F L χ'
  set b := condExp F L ν₁
  set ψ_K := traceChar F hLK ψ
  set χ'_K := χ'.comp (Units.map (normLM F hLK))
  set n_L := condExpChar F L ψ
  set n_K := condExpChar F K ψ_K
  set q := (qL F L : Ω F)
  set C := (R_L.card : Ω F)
  have hcond_1L : condExp F L (1 : Lˣ →* (Ω F)ˣ) = 0 := by
    unfold condExp
    exact Nat.sInf_eq_zero.mpr (Or.inl fun _ _ => rfl)
  have hcond_1K : condExp F K (1 : Kˣ →* (Ω F)ˣ) = 0 := by
    unfold condExp
    exact Nat.sInf_eq_zero.mpr (Or.inl fun _ _ => rfl)
  have htate_1L : tateEps F L (1 : Lˣ →* (Ω F)ˣ) ψ = q ^ n_L := by
    unfold tateEps
    rw [if_pos hcond_1L]
    simp [q, n_L]
  have htate_1K : tateEps F K (1 : Kˣ →* (Ω F)ˣ) ψ_K = q ^ n_K := by
    unfold tateEps
    rw [if_pos hcond_1K, hqK]
    simp [q, n_K, ψ_K]
  have h0 : 0 ∈ Finset.range p := Finset.mem_range.mpr hPrime.pos
  have hprod_ν_range :
      (∏ j ∈ Finset.range p, tateEps F L (ν₁ ^ j) ψ) =
        q ^ n_L * (∏ j ∈ S', tateEps F L (ν₁ ^ j) ψ) := by
    rw [← Finset.mul_prod_erase (Finset.range p) (fun j => tateEps F L (ν₁ ^ j) ψ) h0,
      pow_zero ν₁, htate_1L]
  have hprod_twist_range :
      (∏ j ∈ Finset.range p, tateEps F L (ν₁ ^ j * χ') ψ) =
        tateEps F L χ' ψ * (∏ j ∈ S', tateEps F L (ν₁ ^ j * χ') ψ) := by
    rw [← Finset.mul_prod_erase (Finset.range p) (fun j => tateEps F L (ν₁ ^ j * χ') ψ) h0,
      pow_zero ν₁, one_mul]
  have hϖ_L_pow : ∀ k : ℕ, valL F L ((ϖ_L ^ k : Lˣ) : L) = (k : ℤ) := by
    intro k
    induction k with
    | zero =>
      rw [pow_zero, Units.val_one, hvalL_props.2.1, Nat.cast_zero]
    | succ k ih =>
      rw [pow_succ, Units.val_mul, hvalL_props.2.2.2.2.1 _ _ (Units.ne_zero _) (Units.ne_zero _),
        ih, hϖ_L, Nat.cast_add, Nat.cast_one]
  have hϖ_K_pow : ∀ k : ℕ, valL F K ((ϖ_K ^ k : Kˣ) : K) = (k : ℤ) := by
    intro k
    induction k with
    | zero =>
      rw [pow_zero, Units.val_one, hvalK_props.2.1, Nat.cast_zero]
    | succ k ih =>
      rw [pow_succ, Units.val_mul, hvalK_props.2.2.2.2.1 _ _ (Units.ne_zero _) (Units.ne_zero _),
        ih, hϖ_K, Nat.cast_add, Nat.cast_one]
  let S_χK : Ω F :=
    ∑ r ∈ R_K,
      if hr : 1 + ((ϖ_K ^ (a / 2) : Kˣ) : K) * r ≠ 0 then
        (χ'_K (Units.mk0 (1 + ((ϖ_K ^ (a / 2) : Kˣ) : K) * r) hr) : Ω F)⁻¹ *
          ψ_K (((c_χK⁻¹ : Kˣ) : K) * ((ϖ_K ^ (a / 2) : Kˣ) : K) * r)
      else 0
  let S_χ : Ω F :=
    ∑ r ∈ R_L,
      if hr : 1 + ((ϖ_L ^ (a / 2) : Lˣ) : L) * r ≠ 0 then
        (χ' (Units.mk0 (1 + ((ϖ_L ^ (a / 2) : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
          ψ (((c_χ⁻¹ : Lˣ) : L) * ((ϖ_L ^ (a / 2) : Lˣ) : L) * r)
      else 0
  let S_ν : ℕ → Ω F := fun j =>
    ∑ r ∈ R_L,
      if hr : 1 + ((ϖ_L ^ (b / 2) : Lˣ) : L) * r ≠ 0 then
        ((ν₁ ^ j) (Units.mk0 (1 + ((ϖ_L ^ (b / 2) : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
          ψ ((((c_ν j)⁻¹ : Lˣ) : L) * ((ϖ_L ^ (b / 2) : Lˣ) : L) * r)
      else 0
  let S_twist : ℕ → Ω F := fun j =>
    ∑ r ∈ R_L,
      if hr : 1 + ((ϖ_L ^ (b / 2) : Lˣ) : L) * r ≠ 0 then
        ((ν₁ ^ j * χ') (Units.mk0 (1 + ((ϖ_L ^ (b / 2) : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
          ψ ((((c_twist j)⁻¹ : Lˣ) : L) * ((ϖ_L ^ (b / 2) : Lˣ) : L) * r)
      else 0
  let H_χK : Ω F := if a % 2 = 1 then S_χK else 1
  let H_χ : Ω F := if a % 2 = 1 then S_χ else 1
  let H_ν : ℕ → Ω F := fun j => if b % 2 = 1 then S_ν j else 1
  let H_twist : ℕ → Ω F := fun j => if b % 2 = 1 then S_twist j else 1
  have htate_χ :
      tateEps F L χ' ψ =
        q ^ n_L * C ^ (a / 2) * (χ' c_χ : Ω F) * ψ (((c_χ⁻¹ : Lˣ) : L)) * H_χ := by
    have hstat := ((hStat L ψ hψ χ' ha_ge2).2 c_χ hc_χ_val hc_χ_stat).2
      R_L (ϖ_L ^ (a / 2)) hRL_int hRL_sep hRL_surj (hϖ_L_pow (a / 2))
    rcases Nat.mod_two_eq_zero_or_one a with ha0 | ha1
    · have h1 := hstat.1 ha0
      have ha_ne1 : a % 2 ≠ 1 := by omega
      dsimp only [H_χ]
      rw [if_neg ha_ne1, mul_one]
      exact h1
    · have h2 := hstat.2 ha1
      dsimp only [H_χ]
      rw [if_pos ha1]
      exact h2
  have htate_χK :
      tateEps F K χ'_K ψ_K =
        q ^ n_K * C ^ (a / 2) * (χ'_K c_χK : Ω F) * ψ_K (((c_χK⁻¹ : Kˣ) : K)) * H_χK := by
    have haK_ge2 : 2 ≤ condExp F K χ'_K := by rw [haK]; exact ha_ge2
    have hc_val' : valL F K (c_χK : K) = (condExp F K χ'_K : ℤ) + condExpChar F K ψ_K := by
      rw [haK]; exact hc_χK_val
    have hc_stat' : ∀ y : K, (y = 0 ∨ (((condExp F K χ'_K + 1) / 2 : ℕ) : ℤ) ≤ valL F K y) →
        ∀ hy : 1 + y ≠ 0,
          (χ'_K (Units.mk0 (1 + y) hy) : Ω F) = ψ_K (((c_χK⁻¹ : Kˣ) : K) * y) := by
      rw [haK]; exact hc_χK_stat
    have hδ_val' : valL F K ((ϖ_K ^ (a / 2) : Kˣ) : K) = ((condExp F K χ'_K / 2 : ℕ) : ℤ) := by
      rw [haK]; exact hϖ_K_pow (a / 2)
    have hstat := ((hStat K ψ_K hψK χ'_K haK_ge2).2 c_χK hc_val' hc_stat').2
      R_K (ϖ_K ^ (a / 2)) hRK_int hRK_sep hRK_surj hδ_val'
    rcases Nat.mod_two_eq_zero_or_one a with ha0 | ha1
    · have ha0' : condExp F K χ'_K % 2 = 0 := by rw [haK]; exact ha0
      have h1 := hstat.1 ha0'
      have ha_ne1 : a % 2 ≠ 1 := by omega
      dsimp only [H_χK]
      rw [if_neg ha_ne1, mul_one, h1, haK, hqK, hcard_eq]
    · have ha1' : condExp F K χ'_K % 2 = 1 := by rw [haK]; exact ha1
      have h2 := hstat.2 ha1'
      dsimp only [H_χK]
      rw [if_pos ha1, h2, haK, hqK, hcard_eq]
  have htate_ν : ∀ j ∈ S',
      tateEps F L (ν₁ ^ j) ψ =
        (q ^ n_L * C ^ (b / 2)) * ((ν₁ ^ j) (c_ν j) : Ω F) *
          ψ ((((c_ν j)⁻¹ : Lˣ) : L)) * H_ν j := by
    intro j hj
    have hj_ne0 : j ≠ 0 := (Finset.mem_erase.mp hj).1
    have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    have hj_pos : 0 < j := Nat.pos_of_ne_zero hj_ne0
    have hcond_j : condExp F L (ν₁ ^ j) = b := hν_cond_eq j hj_lt hj_pos
    have hj_ge2 : 2 ≤ condExp F L (ν₁ ^ j) := by rw [hcond_j]; exact hb_ge2
    have hc_val' : valL F L (c_ν j : L) = (condExp F L (ν₁ ^ j) : ℤ) + condExpChar F L ψ := by
      rw [hcond_j]; exact (hc_ν_twist j hj_lt hj_pos).1
    have hc_stat' : ∀ x : L, (x = 0 ∨ (((condExp F L (ν₁ ^ j) + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          ((ν₁ ^ j) (Units.mk0 (1 + x) hx) : Ω F) = ψ ((((c_ν j)⁻¹ : Lˣ) : L) * x) := by
      rw [hcond_j]; exact (hc_ν_twist j hj_lt hj_pos).2.1
    have hδ_val' : valL F L ((ϖ_L ^ (b / 2) : Lˣ) : L) = ((condExp F L (ν₁ ^ j) / 2 : ℕ) : ℤ) := by
      rw [hcond_j]; exact hϖ_L_pow (b / 2)
    have hstat := ((hStat L ψ hψ (ν₁ ^ j) hj_ge2).2 (c_ν j) hc_val' hc_stat').2
      R_L (ϖ_L ^ (b / 2)) hRL_int hRL_sep hRL_surj hδ_val'
    rcases Nat.mod_two_eq_zero_or_one b with hb0 | hb1
    · have hb0' : condExp F L (ν₁ ^ j) % 2 = 0 := by rw [hcond_j]; exact hb0
      have h1 := hstat.1 hb0'
      have hb_ne1 : b % 2 ≠ 1 := by omega
      dsimp only [H_ν]
      rw [if_neg hb_ne1, mul_one, h1, hcond_j]
    · have hb1' : condExp F L (ν₁ ^ j) % 2 = 1 := by rw [hcond_j]; exact hb1
      have h2 := hstat.2 hb1'
      dsimp only [H_ν]
      rw [if_pos hb1, h2, hcond_j]
  have htate_twist : ∀ j ∈ S',
      tateEps F L (ν₁ ^ j * χ') ψ =
        (q ^ n_L * C ^ (b / 2)) * ((ν₁ ^ j * χ') (c_twist j) : Ω F) *
          ψ ((((c_twist j)⁻¹ : Lˣ) : L)) * H_twist j := by
    intro j hj
    have hj_ne0 : j ≠ 0 := (Finset.mem_erase.mp hj).1
    have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    have hj_pos : 0 < j := Nat.pos_of_ne_zero hj_ne0
    have hcond_j : condExp F L (ν₁ ^ j * χ') = b := htwist_cond j hj_lt hj_pos
    have hj_ge2 : 2 ≤ condExp F L (ν₁ ^ j * χ') := by rw [hcond_j]; exact hb_ge2
    have hc_val' : valL F L (c_twist j : L) = (condExp F L (ν₁ ^ j * χ') : ℤ) + condExpChar F L ψ := by
      rw [hcond_j]; exact (hc_ν_twist j hj_lt hj_pos).2.2.1
    have hc_stat' : ∀ x : L, (x = 0 ∨ (((condExp F L (ν₁ ^ j * χ') + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          ((ν₁ ^ j * χ') (Units.mk0 (1 + x) hx) : Ω F) = ψ ((((c_twist j)⁻¹ : Lˣ) : L) * x) := by
      rw [hcond_j]; exact (hc_ν_twist j hj_lt hj_pos).2.2.2
    have hδ_val' : valL F L ((ϖ_L ^ (b / 2) : Lˣ) : L) = ((condExp F L (ν₁ ^ j * χ') / 2 : ℕ) : ℤ) := by
      rw [hcond_j]; exact hϖ_L_pow (b / 2)
    have hstat := ((hStat L ψ hψ (ν₁ ^ j * χ') hj_ge2).2 (c_twist j) hc_val' hc_stat').2
      R_L (ϖ_L ^ (b / 2)) hRL_int hRL_sep hRL_surj hδ_val'
    rcases Nat.mod_two_eq_zero_or_one b with hb0 | hb1
    · have hb0' : condExp F L (ν₁ ^ j * χ') % 2 = 0 := by rw [hcond_j]; exact hb0
      have h1 := hstat.1 hb0'
      have hb_ne1 : b % 2 ≠ 1 := by omega
      dsimp only [H_twist]
      rw [if_neg hb_ne1, mul_one, h1, hcond_j]
    · have hb1' : condExp F L (ν₁ ^ j * χ') % 2 = 1 := by rw [hcond_j]; exact hb1
      have h2 := hstat.2 hb1'
      dsimp only [H_twist]
      rw [if_pos hb1, h2, hcond_j]
  have hprod_ν_S' :
      (∏ j ∈ S', tateEps F L (ν₁ ^ j) ψ) =
        (q ^ n_L * C ^ (b / 2)) ^ S'.card *
          (∏ j ∈ S', ((ν₁ ^ j) (c_ν j) : Ω F)) *
          (∏ j ∈ S', ψ ((((c_ν j)⁻¹ : Lˣ) : L))) *
          (∏ j ∈ S', H_ν j) := by
    rw [Finset.prod_congr rfl htate_ν, Finset.prod_mul_distrib, Finset.prod_mul_distrib,
      Finset.prod_mul_distrib, Finset.prod_const]
  have hprod_twist_S' :
      (∏ j ∈ S', tateEps F L (ν₁ ^ j * χ') ψ) =
        (q ^ n_L * C ^ (b / 2)) ^ S'.card *
          (∏ j ∈ S', ((ν₁ ^ j * χ') (c_twist j) : Ω F)) *
          (∏ j ∈ S', ψ ((((c_twist j)⁻¹ : Lˣ) : L))) *
          (∏ j ∈ S', H_twist j) := by
    rw [Finset.prod_congr rfl htate_twist, Finset.prod_mul_distrib, Finset.prod_mul_distrib,
      Finset.prod_mul_distrib, Finset.prod_const]
  have hHasse_match : H_χK * (∏ j ∈ S', H_ν j) = H_χ * (∏ j ∈ S', H_twist j) := by
    rcases lt_or_eq_of_le hab with hab_lt | hab_eq
    · have hH1 : H_χK = H_χ := by
        dsimp only [H_χK, H_χ]
        by_cases ha_odd : a % 2 = 1
        · rw [if_pos ha_odd, if_pos ha_odd]
          exact (hHasse_lt hab_lt).1 ha_odd
        · rw [if_neg ha_odd, if_neg ha_odd]
      have hH2 : (∏ j ∈ S', H_ν j) = (∏ j ∈ S', H_twist j) := by
        apply Finset.prod_congr rfl
        intro j hj
        have hj_ne0 : j ≠ 0 := (Finset.mem_erase.mp hj).1
        have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
        have hj_pos : 0 < j := Nat.pos_of_ne_zero hj_ne0
        dsimp only [H_ν, H_twist]
        by_cases hb_odd : b % 2 = 1
        · rw [if_pos hb_odd, if_pos hb_odd]
          exact ((hHasse_lt hab_lt).2 hb_odd j hj_lt hj_pos).symm
        · rw [if_neg hb_odd, if_neg hb_odd]
      rw [hH1, hH2]
    · by_cases hb_odd : b % 2 = 1
      · have ha_odd : a % 2 = 1 := by rw [hab_eq]; exact hb_odd
        have hp_ne2 : p ≠ 2 := fun hp2 => hNonDyadicBoundary ⟨hp2, hab_eq, hb_odd⟩
        have h1 : H_χK = S_χK := if_pos ha_odd
        have h2 : H_χ = S_χ := if_pos ha_odd
        have h3 : (∏ j ∈ S', H_ν j) = (∏ j ∈ S', S_ν j) :=
          Finset.prod_congr rfl (fun j _ => if_pos hb_odd)
        have h4 : (∏ j ∈ S', H_twist j) = (∏ j ∈ S', S_twist j) :=
          Finset.prod_congr rfl (fun j _ => if_pos hb_odd)
        rw [h1, h2, h3, h4]
        dsimp only [S_χK, S_χ, S_ν, S_twist]
        rw [hab_eq]
        exact hHasse_eq_odd hab_eq hb_odd hp_ne2
      · have ha_even : ¬ (a % 2 = 1) := by rw [hab_eq]; exact hb_odd
        have h1 : H_χK = 1 := if_neg ha_even
        have h2 : H_χ = 1 := if_neg ha_even
        have h3 : (∏ j ∈ S', H_ν j) = 1 := by
          rw [Finset.prod_congr rfl (fun j _ => (if_neg hb_odd : H_ν j = 1)), Finset.prod_const_one]
        have h4 : (∏ j ∈ S', H_twist j) = 1 := by
          rw [Finset.prod_congr rfl (fun j _ => (if_neg hb_odd : H_twist j = 1)), Finset.prod_const_one]
        rw [h1, h2, h3, h4]
  have hPhase :
      (χ'_K c_χK : Ω F) * (∏ j ∈ S', ((ν₁ ^ j) (c_ν j) : Ω F)) *
        ψ_K (((c_χK⁻¹ : Kˣ) : K)) * (∏ j ∈ S', ψ ((((c_ν j)⁻¹ : Lˣ) : L))) =
      (χ' c_χ : Ω F) * (∏ j ∈ S', ((ν₁ ^ j * χ') (c_twist j) : Ω F)) *
        ψ (((c_χ⁻¹ : Lˣ) : L)) * (∏ j ∈ S', ψ ((((c_twist j)⁻¹ : Lˣ) : L))) := hPhaseMatch
  rw [hprod_ν_range, hprod_twist_range, htate_1K, htate_χ, htate_χK, hprod_ν_S', hprod_twist_S']
  calc
    (q ^ n_K * C ^ (a / 2) * (χ'_K c_χK : Ω F) * ψ_K (((c_χK⁻¹ : Kˣ) : K)) * H_χK) *
        (q ^ n_L * ((q ^ n_L * C ^ (b / 2)) ^ S'.card *
          (∏ j ∈ S', ((ν₁ ^ j) (c_ν j) : Ω F)) *
          (∏ j ∈ S', ψ ((((c_ν j)⁻¹ : Lˣ) : L))) *
          (∏ j ∈ S', H_ν j)))
      = (q ^ n_K * q ^ n_L * C ^ (a / 2) * (q ^ n_L * C ^ (b / 2)) ^ S'.card) *
          ((χ'_K c_χK : Ω F) * (∏ j ∈ S', ((ν₁ ^ j) (c_ν j) : Ω F)) *
            ψ_K (((c_χK⁻¹ : Kˣ) : K)) * (∏ j ∈ S', ψ ((((c_ν j)⁻¹ : Lˣ) : L)))) *
          (H_χK * (∏ j ∈ S', H_ν j)) := by ring
    _ = (q ^ n_K * q ^ n_L * C ^ (a / 2) * (q ^ n_L * C ^ (b / 2)) ^ S'.card) *
          ((χ' c_χ : Ω F) * (∏ j ∈ S', ((ν₁ ^ j * χ') (c_twist j) : Ω F)) *
            ψ (((c_χ⁻¹ : Lˣ) : L)) * (∏ j ∈ S', ψ ((((c_twist j)⁻¹ : Lˣ) : L)))) *
          (H_χ * (∏ j ∈ S', H_twist j)) := by rw [hPhase, hHasse_match]
    _ = q ^ n_K *
        ((q ^ n_L * C ^ (a / 2) * (χ' c_χ : Ω F) * ψ (((c_χ⁻¹ : Lˣ) : L)) * H_χ) *
          ((q ^ n_L * C ^ (b / 2)) ^ S'.card *
            (∏ j ∈ S', ((ν₁ ^ j * χ') (c_twist j) : Ω F)) *
            (∏ j ∈ S', ψ ((((c_twist j)⁻¹ : Lˣ) : L))) *
            (∏ j ∈ S', H_twist j))) := by ring

theorem ld_wild_low_cond_ge_two_norm_trace_error (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K) (hAb : IsAbelianExt F hLK)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hχ'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1)
    (hEqP : Module.finrank L (IntermediateField.extendScalars hLK) = p F)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hν_cond_eq : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j) = condExp F L ν₁)
    (hqK : qL F K = qL F L)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hfrob_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 0 ∨
          1 ≤ valL F L (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)))))
    (hnK : condExpChar F K (traceChar F hLK ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
          (condExp F L ν₁ : ℤ))
    (ha_ge2 : 2 ≤ condExp F L χ')
    (hab : condExp F L χ' ≤ condExp F L ν₁)
    (haK : condExp F K (χ'.comp (Units.map (normLM F hLK))) = condExp F L χ')
    (htwist_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j * χ') = condExp F L ν₁)
    (haddVal1 : addVal F 1 = 0)
    (halg1 : ∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
      (algebraMap F L a = 0 ∨ 1 ≤ valL F L (algebraMap F L a)))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (hSpecK : ∀ (θK : Kˣ →* (Ω F)ˣ),
      (∀ y : K, (y = 0 ∨ -condExpChar F K (traceChar F hLK ψ) ≤ valL F K y) →
        traceChar F hLK ψ y = 1) ∧
      (∃ y₁ : K, y₁ ≠ 0 ∧ -(condExpChar F K (traceChar F hLK ψ) + 1) ≤ valL F K y₁ ∧
        traceChar F hLK ψ y₁ ≠ 1) ∧
      (condExp F K θK ≠ 0 →
        (∀ w ∈ unitGroup F K (condExp F K θK), θK w = 1) ∧
        (∃ w₀ ∈ unitGroup F K (condExp F K θK - 1), θK w₀ ≠ 1)) ∧
      valL F K ((tateElt F K θK (traceChar F hLK ψ) : Kˣ) : K) =
        (condExp F K θK : ℤ) + condExpChar F K (traceChar F hLK ψ))
    (ϖ_K : Kˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLK) ϖ_K = ϖ_L)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hBasis : ∀ y : K, ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLK)) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
        IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F K y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
            c i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
                valL F L (c i) + (i : ℤ))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (t : ℕ) (w_star : Kˣ) (ht_ge1 : 1 ≤ t) (hb_eq : condExp F L ν₁ = t + 1)
    (hw_star_t : w_star ∈ unitGroup F K t)
    (hw_star_nt1 : w_star ∉ unitGroup F K (t + 1))
    (hw_star_norm : Units.map (normLM F hLK) w_star = 1)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (htr_surj : ∀ x : L, ∃ y_x : K,
      traceLM F hLK y_x = x ∧
      (x = 0 → y_x = 0) ∧
      (x ≠ 0 →
        y_x ≠ 0 ∧
        valL F K y_x =
          (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x +
            ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) -
            ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
              (t + 1 : ℤ)))
    (hnorm_exp : ∀ (m : ℕ), 1 ≤ m → ∀ y : K, (y = 0 ∨ (m : ℤ) ≤ valL F K y) →
      ∃ z : K, (z = 0 ∨ (2 * m : ℤ) ≤ valL F K z) ∧
        normLM F hLK (1 + y) = 1 + traceLM F hLK (y + z) + normLM F hLK y)
    (hnorm_le : ∀ m ≤ t + 1, ∀ w ∈ unitGroup F K m,
      Units.map (normLM F hLK) w ∈ unitGroup F L m)
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
