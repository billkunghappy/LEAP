        (D_orb.get i).trace F L w =
          ∑ u₀ : G₀ ⧸ M_sub i,
            (bar_χ i ⟨(cosetRep u₀)⁻¹ * c.1 * cosetRep u₀,
              hC_le i (hC_conj c.2 (cosetRep u₀))⟩ : Ω F) := by
      intro i
      have h_eq_term : (D_orb.get i).trace F L w =
