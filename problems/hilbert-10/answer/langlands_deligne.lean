    have hA_z₁ : A * (δ_b : L) ^ 2 * z₁ = x₁ := by
      have hc_inv : A * (c_ν₁ : L) = 1 := Units.inv_mul c_ν₁
      have hδ_inv : ((δ_b ^ 2 : Lˣ) : L) * (((δ_b ^ 2)⁻¹ : Lˣ) : L) = 1 :=
