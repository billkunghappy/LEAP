    rw [hh₂_eq, hnorm_E' (-1) (2 * d)]
    dsimp only [β₂]
    ring
  have hConj6 : normLM F hLM₁' Q₁ - β₁ * A =
      c₁ * (1 + 4 * f) * (1 + 4 * g) * (c₀ * d - c₁ * E) := by
    change normLM F hLM₁' (IntermediateField.inclusion hLM₁' (c₀ * d + 2 * c₁ * d * g) +
      IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * (1 + d + 4 * d * g)) * x) - β₁ * A =
      c₁ * (1 + 4 * f) * (1 + 4 * g) * (c₀ * d - c₁ * E)
    rw [hnorm_M₁' (c₀ * d + 2 * c₁ * d * g) (-2 * c₀ + c₁ * (1 + d + 4 * d * g))]
    dsimp only [β₁, A, h₀, E]
    ring
  exact ⟨hConj1, hConj2, hConj3, hConj4, hConj5, hConj6⟩

