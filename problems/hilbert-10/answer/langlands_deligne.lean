                  else 0)
    (K_t : Subgroup H)
    (M_Kt : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (hMKt_mem : ∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
      g ∈ M_Kt ↔ projH g ∈ K_t)
    (ψ'_t : M_Kt →* (Ω F)ˣ)
    (S_t : IntermediateField F (AlgebraicClosure F))
    (hLS_t : L ≤ S_t) (hM₁S_t : M₁ ≤ S_t) (hS_tMC : S_t ≤ M_C)
    (χ_St : relWeil F S_t →* (Ω F)ˣ)
    (hχ_St_weil : IsWeilRep F S_t (charRep F S_t χ_St))
    (hχ_St_pow : χ_St ^ (p F) = 1)
    (hχ_St_restK : restrictWeilChar F (hS_tMC.trans hM_CK) χ_St = 1)
    (hχ_St_restE : ∃ hStE : S_t ≤ E ⊔ S_t, restrictWeilChar F hStE χ_St = 1)
    (hχ_St_neMC : restrictWeilChar F hS_tMC χ_St ≠ 1)
    (hSt_fix_iff : ∀ h : H,
      (∀ x : IntermediateField.extendScalars hLK,
        (x : AlgebraicClosure F) ∈ S_t → h.1 x = x) ↔
      h ∈ K_t ⊓ N₁)
    (hχ_St_eq : ∀ (w_S : relWeil F S_t)
      (hm : π (Subgroup.inclusion (relWeil_antitone F hLS_t) w_S) ∈ M_Kt),
      χ_St w_S = ψ'_t ⟨π (Subgroup.inclusion (relWeil_antitone F hLS_t) w_S), hm⟩) :
    ∃ (s_L' : H → MonomialTerm F L')
      (s_F' : H → MonomialTerm F F'),
      (∀ γ : H,
        (s_L' γ).Wf F L' ∧
        (s_L' γ).coeff = 1 ∧
        (s_L' γ).field ≤ M_C ∧
        (s_L' γ).χ ^ (p F) = 1 ∧
        (∃ hsK : (s_L' γ).field ≤ K, restrictWeilChar F hsK (s_L' γ).χ = 1) ∧
        (∃ hsE : (s_L' γ).field ≤ E ⊔ (s_L' γ).field, restrictWeilChar F hsE (s_L' γ).χ = 1) ∧
