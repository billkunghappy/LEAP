      hTowerNormTr θ₁ Δ hΔ_val α β γ w₁ A₁ C₁
      hα_val hβ_val hγ_val hw₁_val hw₁_norm hA₁_eq hC₁_eq
      hθ₁_log hConv_M₁' hψ_triv hψM₁'_triv s_LM₁' hs_LM₁'_val hs_LM₁'_norm_one_add
