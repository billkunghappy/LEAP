  have hRL_card : R_L.card = Fintype.card k_L := by
    dsimp [R_L]
    rw [Finset.card_image_of_injective _ hliftL_inj, Finset.card_univ]
  have hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r := by
