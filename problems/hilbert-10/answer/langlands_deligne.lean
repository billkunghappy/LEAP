  obtain ⟨ϖ₀, hϖ₀⟩ := hval_surj_K 1
  set π : K := (ϖ₀ : K)
  set π_inv : K := ((ϖ₀⁻¹ : Kˣ) : K)
  have hπ_ne0 : π ≠ 0 := Units.ne_zero ϖ₀
  have hπ_inv_ne0 : π_inv ≠ 0 := Units.ne_zero ϖ₀⁻¹
  have hπ_mul : π * π_inv = 1 := by exact_mod_cast Units.mul_inv ϖ₀
  have hπ_inv_mul : π_inv * π = 1 := by exact_mod_cast Units.inv_mul ϖ₀
  have hP0_π : P 0 π := Or.inr (by omega)
  have hP1_π : P 1 π := Or.inr (by omega)
  have hπ_inv_val : valL F K π_inv = -1 := by
