  have hrc_ne1 : ringChar k_L ≠ 1 := by
    intro h1
    have h1_zero : ((1 : ℕ) : k_L) = 0 := (ringChar.spec k_L 1).mpr (by rw [h1])
    rw [Nat.cast_one] at h1_zero
    exact one_ne_zero h1_zero
  have hrc_eq : ringChar k_L = p :=
    (hPrime.eq_one_or_self_of_dvd (ringChar k_L) hdvd_p).resolve_left hrc_ne1
  haveI : CharP k_L p := ringChar.eq_iff.mp hrc_eq
  have hj_props : ∀ j < p, 0 < j → (j : L) ≠ 0 ∧ valL F L (j : L) = 0 := by
    intro j hj_lt hj_pos
    have hj_ndvd : ¬ p ∣ j := Nat.not_dvd_of_pos_of_lt hj_pos hj_lt
    have hj_kL : (j : k_L) ≠ 0 := by
      intro hj0
      exact hj_ndvd ((CharP.cast_eq_zero_iff k_L p j).mp hj0)
    have hj_res : resL (j : L) ≠ 0 := by
      rw [(hnat j).2]
      exact hj_kL
    have hj_not_ker : ¬ ((j : L) = 0 ∨ 1 ≤ valL F L (j : L)) := by
      intro hker
      exact hj_res ((hresL_ker (j : L) (hnat j).1).mpr hker)
    rcases (hnat j).1 with hj0 | hj_ge0
    · exact False.elim (hj_not_ker (Or.inl hj0))
    · refine ⟨fun hj0 => hj_not_ker (Or.inl hj0), ?_⟩
      have hlt1 : ¬ (1 ≤ valL F L (j : L)) := fun h1 => hj_not_ker (Or.inr h1)
      omega
  let u_nat : ℕ → Lˣ := fun j => if h : (j : L) ≠ 0 then Units.mk0 (j : L) h else 1
  let τ_tilde : ℕ → Lˣ := fun j => (u_nat j) ^ (p ^ b)
  let τ_unit : ℕ → Lˣ := fun j => (τ_tilde j) ^ p
  let c_ν : ℕ → Lˣ := fun j => c_τ * (τ_unit j)⁻¹
  have hτ_tilde_coe : ∀ j < p, 0 < j → (τ_tilde j : L) = (j : L) ^ (p ^ b) := by
    intro j hj hj0
    have hj_ne : (j : L) ≠ 0 := (hj_props j hj hj0).1
    dsimp [τ_tilde, u_nat]
    rw [dif_pos hj_ne, Units.val_mk0]
  have hτ_unit_coe : ∀ j < p, 0 < j → (τ_unit j : L) = (j : L) ^ (p ^ (b + 1)) := by
    intro j hj hj0
    change ((τ_tilde j : L) ^ p) = (j : L) ^ (p ^ (b + 1))
    rw [hτ_tilde_coe j hj hj0, ← pow_mul, ← pow_succ]
  have hτ_norm : ∀ j < p, 0 < j →
      Units.map (normLM F hLK)
        (Units.map (IntermediateField.inclusion hLK).toMonoidHom (τ_tilde j)) = τ_unit j := by
    intro j hj hj0
    apply Units.ext
    change normLM F hLK (IntermediateField.inclusion hLK (τ_tilde j : L)) =
      (((τ_tilde j) ^ p : Lˣ) : L)
    rw [Units.val_pow_eq_pow_val]
    change Algebra.norm L
      ((algebraMap L (IntermediateField.extendScalars hLK)) (τ_tilde j : L)) =
      (τ_tilde j : L) ^ p
    exact Algebra.norm_algebraMap (τ_tilde j : L)
  have hτ_ν₁ : ∀ j < p, 0 < j → ν₁ (τ_unit j) = 1 := by
    intro j hj hj0
    exact (hν₁_ker (τ_unit j)).mp
      ⟨Units.map (IntermediateField.inclusion hLK).toMonoidHom (τ_tilde j),
        hτ_norm j hj hj0⟩
  have hτ_unit_val : ∀ j < p, 0 < j → valL F L (τ_unit j : L) = 0 := by
    intro j hj hj0
    obtain ⟨hj_ne, hj_val0⟩ := hj_props j hj hj0
    rw [hτ_unit_coe j hj hj0, hval_pow_L (j : L) (p ^ (b + 1)) hj_ne, hj_val0, mul_zero]
  have hc_ν_val : ∀ j < p, 0 < j →
      valL F L (c_ν j : L) = (b : ℤ) + condExpChar F L ψ := by
    intro j hj hj0
    dsimp [c_ν]
    rw [hval_mul_L (c_τ : L) (((τ_unit j)⁻¹ : Lˣ) : L)
      (Units.ne_zero _) (Units.ne_zero _),
      hval_inv_L (τ_unit j), hτ_unit_val j hj hj0, neg_zero, add_zero, hc_τ_val]
  have hτ_diff_val : ∀ j < p, 0 < j →
      (τ_unit j : L) - (j : L) = 0 ∨
        (m_p : ℤ) ≤ valL F L ((τ_unit j : L) - (j : L)) := by
    intro j hj hj0
    have hzmod : ((((j : ℤ) ^ (p ^ (b + 1)) : ℤ) : ZMod p)) = ((j : ℤ) : ZMod p) := by
      rw [Int.cast_pow]
      exact ZMod.pow_card_pow (n := b + 1) ((j : ℤ) : ZMod p)
    have hdvd : (p : ℤ) ∣ ((j : ℤ) ^ (p ^ (b + 1)) - (j : ℤ)) :=
      (ZMod.intCast_eq_intCast_iff_dvd_sub (j : ℤ) ((j : ℤ) ^ (p ^ (b + 1))) p).mp hzmod.symm
    rcases hdvd with ⟨k, hk⟩
    have hcast_eq : (τ_unit j : L) - (j : L) = (p : L) * (k : L) := by
      rw [hτ_unit_coe j hj hj0]
      have hkL := congrArg (Int.cast : ℤ → L) hk
      push_cast at hkL
      exact hkL
    rw [hcast_eq]
    have hmul := hval_mul_ge_L (m_p : ℤ) 0 (p : L) (k : L) hp_val (hval_int_L k)
    rcases hmul with h0 | hge
    · exact Or.inl h0
    · right
      omega
  have hb_le_sum : b ≤ m_p + (b + 1) / 2 := by
    let d : ℕ := b / 2
    let r₀ : ℕ := (b + 1) / 2
    have hdr : d + r₀ = b := by omega
    have h2d : 2 * d ≤ b := by omega
    have hd_le_mp : d ≤ m_p := by
      rw [Nat.le_div_iff_mul_le hp_pos]
      have hp_eq : p = (p - 2) + 2 := by omega
      have hdp : d * p = d * (p - 2) + 2 * d := by
        conv_lhs => rw [hp_eq]
        ring
      have hbp : (p - 1) * b = b * (p - 2) + b := by
        have hp1_eq : p - 1 = (p - 2) + 1 := by omega
        rw [hp1_eq]
        ring
      have hle1 : d * (p - 2) ≤ b * (p - 2) := Nat.mul_le_mul_right (p - 2) (by omega)
      omega
    omega
  have hc_ν_stat : ∀ j < p, 0 < j →
      ∀ x : L, (x = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          ((ν₁ ^ j) (Units.mk0 (1 + x) hx) : Ω F) = ψ ((((c_ν j)⁻¹ : Lˣ) : L) * x) := by
    intro j hj hj0 x hx_val hx
    let Δ_x : L := ((τ_unit j : L) - (j : L)) * ((c_τ⁻¹ : Lˣ) : L) * x
    have hc_τ_inv_val : valL F L (((c_τ⁻¹ : Lˣ) : L)) = -((b : ℤ) + condExpChar F L ψ) := by
      rw [hval_inv_L c_τ, hc_τ_val]
    have hΔ_val : Δ_x = 0 ∨ -condExpChar F L ψ ≤ valL F L Δ_x := by
      have h1 := hval_mul_ge_L (m_p : ℤ) (-((b : ℤ) + condExpChar F L ψ))
        ((τ_unit j : L) - (j : L)) (((c_τ⁻¹ : Lˣ) : L))
        (hτ_diff_val j hj hj0) (Or.inr (le_of_eq hc_τ_inv_val.symm))
      have h2 := hval_mul_ge_L
        ((m_p : ℤ) + -((b : ℤ) + condExpChar F L ψ))
        ((((b + 1) / 2 : ℕ) : ℤ))
        (((τ_unit j : L) - (j : L)) * ((c_τ⁻¹ : Lˣ) : L)) x h1 hx_val
      rcases h2 with h0 | hge
      · exact Or.inl h0
      · right
        have hb_le_int : (b : ℤ) ≤ (m_p : ℤ) + (((b + 1) / 2 : ℕ) : ℤ) := by
          exact_mod_cast hb_le_sum
        dsimp [Δ_x]
        omega
    have hψ_Δ : ψ Δ_x = 1 := (hSpecL 1).1 Δ_x hΔ_val
    have hdecomp : (((c_ν j)⁻¹ : Lˣ) : L) * x =
        (j : L) * (((c_τ⁻¹ : Lˣ) : L) * x) + Δ_x := by
      have hinv : (((c_ν j)⁻¹ : Lˣ) : L) = (τ_unit j : L) * ((c_τ⁻¹ : Lˣ) : L) := by
        dsimp [c_ν]
        rw [mul_inv_rev, inv_inv, Units.val_mul]
      rw [hinv]
      dsimp [Δ_x]
      ring
    rw [hdecomp, AddChar.map_add_eq_mul, hψ_Δ, mul_one,
      ← nsmul_eq_mul, AddChar.map_nsmul_eq_pow, ← hc_τ_stat x hx_val hx,
      MonoidHom.pow_apply, Units.val_pow_eq_pow_val]
  refine ⟨R_L, R_K, τ_unit, τ_tilde, c_ν,
    hRL_card, hRK_card, hRK_eq, hRL_int, hRL_sep, hRL_surj,
    hRK_int, hRK_sep, hRK_surj, ?_⟩
  intro j hj hj0
  exact ⟨hτ_tilde_coe j hj hj0, rfl, hτ_norm j hj hj0, hτ_ν₁ j hj hj0,
    rfl, hτ_unit_val j hj hj0, hc_ν_val j hj hj0, hc_ν_stat j hj hj0⟩

theorem ld_wild_low_cond_subcritical_norm_and_twist_stat (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (ha_ge2 : 2 ≤ condExp F L χ')
    (hab : condExp F L χ' ≤ condExp F L ν₁)
    (htwist_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j * χ') = condExp F L ν₁)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (ϖ_K : Kˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLK) ϖ_K = ϖ_L)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (t : ℕ) (ht_ge1 : 1 ≤ t) (hb_eq : condExp F L ν₁ = t + 1)
    (hnorm_surj_lt : ∀ m < t, ∀ u ∈ unitGroup F L m,
      ∃ w ∈ unitGroup F K m,
        (Units.map (normLM F hLK) w) * u⁻¹ ∈ unitGroup F L (m + 1))
    (c_τ : Lˣ) (hc_τ_val : valL F L (c_τ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (c_χ0 : Lˣ) (hc_χ0_val : valL F L (c_χ0 : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_χ0_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ0⁻¹ : Lˣ) : L) * x))
    (τ_unit c_ν : ℕ → Lˣ)
    (hτ_c_ν : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
      c_ν j = c_τ * (τ_unit j)⁻¹ ∧
      valL F L (τ_unit j : L) = 0 ∧
      (∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          ((ν₁ ^ j) (Units.mk0 (1 + x) hx) : Ω F) = ψ ((((c_ν j)⁻¹ : Lˣ) : L) * x))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    let b := condExp F L ν₁
    let a := condExp F L χ'
    ∃ (u : Kˣ) (N : Lˣ) (c_χ : Lˣ) (c_twist : ℕ → Lˣ),
      Units.map (normLM F hLK) u = N ∧
      valL F K (u : K) = (b - a : ℤ) ∧
      valL F L (N : L) = (b - a : ℤ) ∧
      c_χ = c_τ * N⁻¹ ∧
      valL F L (c_χ : L) = (a : ℤ) + condExpChar F L ψ ∧
      (∀ x : L, (x = 0 ∨ (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ⁻¹ : Lˣ) : L) * x)) ∧
      (∀ j < p, 0 < j →
        (N : L) + (τ_unit j : L) ≠ 0 ∧
        valL F L ((N : L) + (τ_unit j : L)) = 0 ∧
        (((c_twist j)⁻¹ : Lˣ) : L) = ((c_τ⁻¹ : Lˣ) : L) * ((N : L) + (τ_unit j : L)) ∧
        valL F L (c_twist j : L) = (b : ℤ) + condExpChar F L ψ ∧
        (∀ x : L, (x = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
          ∀ hx : 1 + x ≠ 0,
            ((ν₁ ^ j * χ') (Units.mk0 (1 + x) hx) : Ω F) =
              ψ ((((c_twist j)⁻¹ : Lˣ) : L) * x))) :=
by
  intro p b a
  set n := condExpChar F L ψ
  have hb_ge2' : 2 ≤ b := hb_ge2
  have ha_ge2' : 2 ≤ a := ha_ge2
  have hab' : a ≤ b := hab
  have hb_eq' : b = t + 1 := hb_eq
  rcases hvalL_props with ⟨hvalL0, hvalL1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv,
    hvalL_surj, hvalL_add, hunitL0, hunitLa, hunitLa_val0⟩
  rcases hvalK_props with ⟨hvalK0, hvalK1, hvalK_neg1, hvalK_neg, hvalK_mul, hvalK_inv,
    hvalK_surj, hvalK_add, hunitK0, hunitKa, hunitKa_val0⟩
  have hψ_triv : ∀ x : L, (x = 0 ∨ -n ≤ valL F L x) → ψ x = 1 := (hSpecL 1).1
  have hvalL_pow : ∀ (w : Lˣ) (k : ℕ), valL F L (((w ^ k : Lˣ) : L)) = (k : ℤ) * valL F L (w : L) := by
    intro w k
    induction' k with k ih
    · simp [hvalL1]
    · rw [pow_succ, Units.val_mul, hvalL_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
      push_cast; ring
  have hvalK_pow : ∀ (w : Kˣ) (k : ℕ), valL F K (((w ^ k : Kˣ) : K)) = (k : ℤ) * valL F K (w : K) := by
    intro w k
    induction' k with k ih
    · simp [hvalK1]
    · rw [pow_succ, Units.val_mul, hvalK_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
      push_cast; ring
  have hnorm_approx : ∀ m ≤ t, ∀ u_star ∈ unitGroup F L 0,
      ∃ w_m ∈ unitGroup F K 0,
        (Units.map (normLM F hLK) w_m) * u_star⁻¹ ∈ unitGroup F L m := by
    intro m
    induction' m with m ih
    · intro _ u_star hu_star
      refine ⟨1, Subgroup.one_mem _, ?_⟩
      simp only [map_one, one_mul]
      exact Subgroup.inv_mem _ hu_star
    · intro hm u_star hu_star
      have hm_le : m ≤ t := by omega
      have hm_lt : m < t := by omega
      obtain ⟨w_m, hw_m0, hv_m⟩ := ih hm_le u_star hu_star
      set v_m : Lˣ := (Units.map (normLM F hLK) w_m) * u_star⁻¹
      have hvm_inv : v_m⁻¹ ∈ unitGroup F L m := Subgroup.inv_mem _ hv_m
      obtain ⟨δ_m, hδ_m, hδ_approx⟩ := hnorm_surj_lt m hm_lt v_m⁻¹ hvm_inv
      have hδ_m0 : δ_m ∈ unitGroup F K 0 := (hunitK0 δ_m).mpr (hunitKa_val0 m δ_m hδ_m)
      refine ⟨δ_m * w_m, Subgroup.mul_mem _ hδ_m0 hw_m0, ?_⟩
      have heq : (Units.map (normLM F hLK) (δ_m * w_m)) * u_star⁻¹ =
          (Units.map (normLM F hLK) δ_m) * (v_m⁻¹)⁻¹ := by
        simp only [v_m, map_mul, inv_inv, mul_assoc]
      rw [heq]
      exact hδ_approx
  set v : ℕ := b - a
  have hv_int : (v : ℤ) = (b : ℤ) - (a : ℤ) := Int.ofNat_sub hab'
  set u_star : Lˣ := c_τ * c_χ0⁻¹ * (ϖ_L ^ v)⁻¹
  have hu_star_val : valL F L (u_star : L) = 0 := by
    have h1 : (u_star : L) = ((c_τ * c_χ0⁻¹ : Lˣ) : L) * (((ϖ_L ^ v)⁻¹ : Lˣ) : L) := rfl
    rw [h1, hvalL_mul _ _ (Units.ne_zero _) (Units.ne_zero _)]
    have h2 : ((c_τ * c_χ0⁻¹ : Lˣ) : L) = (c_τ : L) * ((c_χ0⁻¹ : Lˣ) : L) := rfl
    rw [h2, hvalL_mul _ _ (Units.ne_zero _) (Units.ne_zero _)]
    rw [hvalL_inv c_χ0, hvalL_inv (ϖ_L ^ v), hvalL_pow ϖ_L v]
    rw [hc_τ_val, hc_χ0_val, hϖ_L]
    change (b : ℤ) + n + -((a : ℤ) + n) + -((v : ℤ) * 1) = 0
    omega
  have hu_star0 : u_star ∈ unitGroup F L 0 := (hunitL0 u_star).mpr hu_star_val
  obtain ⟨w_star, hw_star0, hη_mem⟩ := hnorm_approx t le_rfl u_star hu_star0
  set η : Lˣ := (Units.map (normLM F hLK) w_star) * u_star⁻¹
  set u : Kˣ := (ϖ_K ^ v) * w_star
  set N : Lˣ := Units.map (normLM F hLK) u
  set c_χ : Lˣ := c_τ * N⁻¹
  have hu_norm : Units.map (normLM F hLK) u = N := rfl
  have hw_star_val : valL F K (w_star : K) = 0 := (hunitK0 w_star).mp hw_star0
  have hu_val : valL F K (u : K) = (b - a : ℤ) := by
    have h1 : (u : K) = ((ϖ_K ^ v : Kˣ) : K) * (w_star : K) := rfl
    rw [h1, hvalK_mul _ _ (Units.ne_zero _) (Units.ne_zero _), hvalK_pow ϖ_K v, hϖ_K, hw_star_val]
    omega
  have hN_val : valL F L (N : L) = (b - a : ℤ) := by
    have h1 : (N : L) = normLM F hLK (u : K) := rfl
    rw [h1, hval_norm (u : K), hu_val]
  have hc_χ_eq : c_χ = c_τ * N⁻¹ := rfl
  have hc_χ_val : valL F L (c_χ : L) = (a : ℤ) + n := by
    have h1 : (c_χ : L) = (c_τ : L) * ((N⁻¹ : Lˣ) : L) := rfl
    rw [h1, hvalL_mul _ _ (Units.ne_zero _) (Units.ne_zero _), hvalL_inv N, hc_τ_val, hN_val]
    change (b : ℤ) + n + -((b : ℤ) - (a : ℤ)) = (a : ℤ) + n
    omega
  have hc_χ_inv_eq : c_χ⁻¹ = η * c_χ0⁻¹ := by
    have hN_eq : N = (ϖ_L ^ v) * Units.map (normLM F hLK) w_star := by
      simp only [N, u, map_mul, map_pow, hϖ_norm]
    calc c_χ⁻¹
      _ = (ϖ_L ^ v) * Units.map (normLM F hLK) w_star * c_τ⁻¹ := by
          simp only [c_χ, hN_eq, mul_inv_rev, inv_inv]
      _ = (ϖ_L ^ v) * Units.map (normLM F hLK) w_star * c_τ⁻¹ * (c_χ0 * c_χ0⁻¹) := by
          rw [mul_inv_cancel, mul_one]
      _ = η * c_χ0⁻¹ := by
          simp only [η, u_star, mul_inv_rev, inv_inv]
          ac_rfl
  have hc_χ_stat : ∀ x : L, (x = 0 ∨ (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ⁻¹ : Lˣ) : L) * x) := by
    have hη_prop : (η : L) = 1 ∨ (t : ℤ) ≤ valL F L ((η : L) - 1) :=
      (hunitLa t ht_ge1 η).mp hη_mem
    intro x hx_dom hx
    rw [hc_χ0_stat x hx_dom hx]
    set δ_x : L := ((c_χ0⁻¹ : Lˣ) : L) * ((η : L) - 1) * x
    have hdecomp : ((c_χ⁻¹ : Lˣ) : L) * x = ((c_χ0⁻¹ : Lˣ) : L) * x + δ_x := by
      rw [hc_χ_inv_eq, Units.val_mul]
      dsimp only [δ_x]
      ring
    rw [hdecomp, AddChar.map_add_eq_mul]
    have hψ_δ : ψ δ_x = 1 := by
      by_cases hη1 : (η : L) - 1 = 0
      · apply hψ_triv
        left
        dsimp only [δ_x]
        rw [hη1, mul_zero, zero_mul]
      · by_cases hx0 : x = 0
        · apply hψ_triv
          left
          dsimp only [δ_x]
          rw [hx0, mul_zero]
        · apply hψ_triv
          right
          have hη_val : (t : ℤ) ≤ valL F L ((η : L) - 1) := by
            rcases hη_prop with h1 | h2
            · exfalso; exact hη1 (sub_eq_zero.mpr h1)
            · exact h2
          have hx_val : (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F L x := by
            rcases hx_dom with h1 | h2
            · contradiction
            · exact h2
          have hmul1 : ((c_χ0⁻¹ : Lˣ) : L) * ((η : L) - 1) ≠ 0 :=
            mul_ne_zero (Units.ne_zero _) hη1
          have hval_δ : valL F L δ_x =
              valL F L ((c_χ0⁻¹ : Lˣ) : L) + valL F L ((η : L) - 1) + valL F L x := by
            dsimp only [δ_x]
            rw [hvalL_mul _ _ hmul1 hx0, hvalL_mul _ _ (Units.ne_zero _) hη1]
          rw [hval_δ, hvalL_inv c_χ0, hc_χ0_val]
          change -n ≤ -((a : ℤ) + n) + valL F L ((η : L) - 1) + valL F L x
          omega
    rw [hψ_δ, mul_one]
  have hs_props : ∀ j < p, 0 < j →
      (N : L) + (τ_unit j : L) ≠ 0 ∧
      valL F L ((N : L) + (τ_unit j : L)) = 0 ∧
      (∀ x : L, (x = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          ((ν₁ ^ j * χ') (Units.mk0 (1 + x) hx) : Ω F) =
            ψ (((c_τ⁻¹ : Lˣ) : L) * ((N : L) + (τ_unit j : L)) * x)) := by
    intro j hj hj0
    rcases hτ_c_ν j hj hj0 with ⟨hc_ν_eq, hτ_val, hc_ν_stat⟩
    have htwist_lin : ∀ x : L, (x = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          ((ν₁ ^ j * χ') (Units.mk0 (1 + x) hx) : Ω F) =
            ψ (((c_τ⁻¹ : Lˣ) : L) * ((N : L) + (τ_unit j : L)) * x) := by
      intro x hx_b hx
      have hx_a : x = 0 ∨ (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F L x := by
        rcases hx_b with h1 | h2
        · exact Or.inl h1
        · right; omega
      rw [MonoidHom.mul_apply, Units.val_mul, hc_ν_stat x hx_b hx, hc_χ_stat x hx_a hx,
        ← AddChar.map_add_eq_mul]
      have hc_ν_inv : (c_ν j)⁻¹ = c_τ⁻¹ * τ_unit j := by
        rw [hc_ν_eq, mul_inv_rev, inv_inv, mul_comm]
      have hc_χ_inv : c_χ⁻¹ = c_τ⁻¹ * N := by
        rw [hc_χ_eq, mul_inv_rev, inv_inv, mul_comm]
      have hsum_eq : (((c_ν j)⁻¹ : Lˣ) : L) * x + ((c_χ⁻¹ : Lˣ) : L) * x =
          ((c_τ⁻¹ : Lˣ) : L) * ((N : L) + (τ_unit j : L)) * x := by
        rw [hc_ν_inv, hc_χ_inv, Units.val_mul, Units.val_mul]
        ring
      rw [hsum_eq]
    set s_j : L := (N : L) + (τ_unit j : L)
    have hs_ge0 : s_j = 0 ∨ 0 ≤ valL F L s_j := by
      apply hvalL_add 0 (N : L) (τ_unit j : L)
      · right; rw [hN_val]; omega
      · right; rw [hτ_val]
    have hs_not_ge1 : ¬ (s_j = 0 ∨ 1 ≤ valL F L s_j) := by
      intro hs_ge1
      have hcond_j : condExp F L (ν₁ ^ j * χ') = b := htwist_cond j hj hj0
      have hcond_ne0 : condExp F L (ν₁ ^ j * χ') ≠ 0 := by omega
      obtain ⟨_, u₀, hu₀_mem, hu₀_ne1⟩ := (hSpecL (ν₁ ^ j * χ')).2.2.1 hcond_ne0
      rw [hcond_j] at hu₀_mem
      have hb1_ge1 : 1 ≤ b - 1 := by omega
      have hu₀_prop : (u₀ : L) = 1 ∨ ((b - 1 : ℕ) : ℤ) ≤ valL F L ((u₀ : L) - 1) :=
        (hunitLa (b - 1) hb1_ge1 u₀).mp hu₀_mem
      set x₀ : L := (u₀ : L) - 1
      have hx₀_dom_b1 : x₀ = 0 ∨ ((b - 1 : ℕ) : ℤ) ≤ valL F L x₀ := by
        rcases hu₀_prop with h1 | h2
        · left; dsimp only [x₀]; exact sub_eq_zero.mpr h1
        · right; exact h2
      have hx₀_dom_b : x₀ = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F L x₀ := by
        rcases hx₀_dom_b1 with h1 | h2
        · exact Or.inl h1
        · right; omega
      have hx₀_ne : 1 + x₀ ≠ 0 := by
        have h1 : 1 + x₀ = (u₀ : L) := by dsimp only [x₀]; ring
        rw [h1]
        exact Units.ne_zero u₀
      have hmk0_u₀ : Units.mk0 (1 + x₀) hx₀_ne = u₀ := by
        ext
        simp only [Units.val_mk0, x₀]
        ring
      have heval := htwist_lin x₀ hx₀_dom_b hx₀_ne
      rw [hmk0_u₀] at heval
      set z₀ : L := ((c_τ⁻¹ : Lˣ) : L) * s_j * x₀
      have hψ_z₀ : ψ z₀ = 1 := by
        by_cases hs0 : s_j = 0
        · apply hψ_triv
          left
          dsimp only [z₀]
          rw [hs0, mul_zero, zero_mul]
        · by_cases hx₀0 : x₀ = 0
          · apply hψ_triv
            left
            dsimp only [z₀]
            rw [hx₀0, mul_zero]
          · apply hψ_triv
            right
            have hs_val1 : 1 ≤ valL F L s_j := by
              rcases hs_ge1 with h1 | h2
              · contradiction
              · exact h2
            have hx₀_val : ((b - 1 : ℕ) : ℤ) ≤ valL F L x₀ := by
              rcases hx₀_dom_b1 with h1 | h2
              · contradiction
              · exact h2
            have hmul1 : ((c_τ⁻¹ : Lˣ) : L) * s_j ≠ 0 :=
              mul_ne_zero (Units.ne_zero _) hs0
            have hval_z₀ : valL F L z₀ =
                valL F L ((c_τ⁻¹ : Lˣ) : L) + valL F L s_j + valL F L x₀ := by
              dsimp only [z₀]
              rw [hvalL_mul _ _ hmul1 hx₀0, hvalL_mul _ _ (Units.ne_zero _) hs0]
            rw [hval_z₀, hvalL_inv c_τ, hc_τ_val]
            change -n ≤ -((b : ℤ) + n) + valL F L s_j + valL F L x₀
            omega
      have hu₀_eq1 : (ν₁ ^ j * χ') u₀ = 1 := by
        ext
        rw [heval, hψ_z₀, Units.val_one]
      exact hu₀_ne1 hu₀_eq1
    have hs_ne0 : s_j ≠ 0 := by
      intro hs0
      exact hs_not_ge1 (Or.inl hs0)
    have hs_val0 : valL F L s_j = 0 := by
      rcases hs_ge0 with h1 | h2
      · contradiction
      · have hnot1 : ¬ (1 ≤ valL F L s_j) := fun h => hs_not_ge1 (Or.inr h)
        omega
    exact ⟨hs_ne0, hs_val0, htwist_lin⟩
  let c_twist : ℕ → Lˣ := fun j =>
    if h : j < p ∧ 0 < j then
      c_τ * (Units.mk0 ((N : L) + (τ_unit j : L)) (hs_props j h.1 h.2).1)⁻¹
    else 1
  refine ⟨u, N, c_χ, c_twist, hu_norm, hu_val, hN_val, hc_χ_eq, hc_χ_val, hc_χ_stat, ?_⟩
  intro j hj hj0
  obtain ⟨hs_ne0, hs_val0, htwist_lin⟩ := hs_props j hj hj0
  have hc_twist_eq : c_twist j = c_τ * (Units.mk0 ((N : L) + (τ_unit j : L)) hs_ne0)⁻¹ :=
    dif_pos ⟨hj, hj0⟩
  have hc_twist_inv_val : (((c_twist j)⁻¹ : Lˣ) : L) =
      ((c_τ⁻¹ : Lˣ) : L) * ((N : L) + (τ_unit j : L)) := by
    have hinv : (c_twist j)⁻¹ = c_τ⁻¹ * Units.mk0 ((N : L) + (τ_unit j : L)) hs_ne0 := by
      rw [hc_twist_eq, mul_inv_rev, inv_inv, mul_comm]
    rw [hinv, Units.val_mul, Units.val_mk0]
  have hc_twist_val : valL F L (c_twist j : L) = (b : ℤ) + n := by
    rw [hc_twist_eq, Units.val_mul, hvalL_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
      hvalL_inv, Units.val_mk0, hc_τ_val, hs_val0]
    change (b : ℤ) + n + -0 = (b : ℤ) + n
    omega
  refine ⟨hs_ne0, hs_val0, hc_twist_inv_val, hc_twist_val, ?_⟩
  intro x hx_b hx
  rw [hc_twist_inv_val]
  exact htwist_lin x hx_b hx

theorem ld_wild_low_cond_norm_to_trace_and_c_chiK_stat (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hnK : condExpChar F K (traceChar F hLK ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
          (condExp F L ν₁ : ℤ))
    (ha_ge2 : 2 ≤ condExp F L χ')
    (hab : condExp F L χ' ≤ condExp F L ν₁)
    (haK : condExp F K (χ'.comp (Units.map (normLM F hLK))) = condExp F L χ')
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (hSpecK : ∀ (θK : Kˣ →* (Ω F)ˣ),
      (∀ y : K, (y = 0 ∨ -condExpChar F K (traceChar F hLK ψ) ≤ valL F K y) →
        traceChar F hLK ψ y = 1) ∧
      (∃ y₁ : K, y₁ ≠ 0 ∧ -(condExpChar F K (traceChar F hLK ψ) + 1) ≤ valL F K y₁ ∧
        traceChar F hLK ψ y₁ ≠ 1) ∧
      (condExp F K θK ≠ 0 →
        (∀ w ∈ unitGroup F K (condExp F K θK), θK w = 1) ∧
        (∃ w₀ ∈ unitGroup F K (condExp F K θK - 1), θK w₀ ≠ 1)) ∧
      valL F K ((tateElt F K θK (traceChar F hLK ψ) : Kˣ) : K) =
        (condExp F K θK : ℤ) + condExpChar F K (traceChar F hLK ψ))
    (ϖ_K : Kˣ) (hϖ_K : valL F K (ϖ_K : K) = 1)
    (t : ℕ) (hb_eq : condExp F L ν₁ = t + 1)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (hnorm_exp : ∀ (m : ℕ), 1 ≤ m → ∀ y : K, (y = 0 ∨ (m : ℤ) ≤ valL F K y) →
      ∃ z : K, (z = 0 ∨ (2 * m : ℤ) ≤ valL F K z) ∧
        normLM F hLK (1 + y) = 1 + traceLM F hLK (y + z) + normLM F hLK y)
    (c_τ : Lˣ) (hc_τ_val : valL F L (c_τ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hc_τ_stat : ∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_τ⁻¹ : Lˣ) : L) * x))
    (u : Kˣ) (N : Lˣ) (c_χ : Lˣ)
    (hu_norm : Units.map (normLM F hLK) u = N)
    (hu_val : valL F K (u : K) = (condExp F L ν₁ - condExp F L χ' : ℤ))
    (hN_val : valL F L (N : L) = (condExp F L ν₁ - condExp F L χ' : ℤ))
    (hc_χ_eq : c_χ = c_τ * N⁻¹)
    (hc_χ_val : valL F L (c_χ : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_χ_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ⁻¹ : Lˣ) : L) * x)) :
    let b := condExp F L ν₁
    let a := condExp F L χ'
    (∀ z : K, (z = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F K z) →
      ψ (((c_τ⁻¹ : Lˣ) : L) * normLM F hLK z) =
        ψ (- ((c_τ⁻¹ : Lˣ) : L) * traceLM F hLK z)) ∧
    ∃ c_χK : Kˣ,
      ((c_χK⁻¹ : Kˣ) : K) =
        IntermediateField.inclusion hLK (((c_τ⁻¹ : Lˣ) : L)) *
          (IntermediateField.inclusion hLK (N : L) - (u : K)) ∧
      valL F K (c_χK : K) = (a : ℤ) + condExpChar F K (traceChar F hLK ψ) ∧
      (∀ y : K, (y = 0 ∨ (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F K y) →
        ∀ hy : 1 + y ≠ 0,
          ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + y) hy) : Ω F) =
            (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K) * y)) :=
by
  intro b a
  let K' := IntermediateField.extendScalars hLK
  set p := Module.finrank L K'
  set n_L := condExpChar F L ψ
  set n_K := condExpChar F K (traceChar F hLK ψ)
  have hb_ge2' : 2 ≤ b := hb_ge2
  have ha_ge2' : 2 ≤ a := ha_ge2
  have hab' : a ≤ b := hab
  have hb_eq' : b = t + 1 := hb_eq
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_sub1_int : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  rcases hvalL_props with ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, _, hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩
  rcases hvalK_props with ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K,
    hval_inv_K, _, hval_add_K, hunit0_K, hunit_ge1_K, hunit_val0_K⟩
  have hψK_triv : ∀ y : K, (y = 0 ∨ -n_K ≤ valL F K y) → traceChar F hLK ψ y = 1 :=
    (hSpecK 1).1
  have hval_mul_ge_L : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F L x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F L y := hy.resolve_left hy0
        rw [hval_mul_L x y hx0 hy0]
        omega
  have hval_mul_ge_K : ∀ (k₁ k₂ : ℤ) (x y : K),
      (x = 0 ∨ k₁ ≤ valL F K x) → (y = 0 ∨ k₂ ≤ valL F K y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F K (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F K x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F K y := hy.resolve_left hy0
        rw [hval_mul_K x y hx0 hy0]
        omega
  have hval_sub_ge_L : ∀ (k : ℤ) (x y : L),
      (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
        (x - y = 0 ∨ k ≤ valL F L (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    have hny : -y = 0 ∨ k ≤ valL F L (-y) := by
      rcases hy with h0 | hge
      · exact Or.inl (neg_eq_zero.mpr h0)
      · right; rw [hval_neg_L]; exact hge
    exact hval_add_L k x (-y) hx hny
  have hval_sub_ge_K : ∀ (k : ℤ) (x y : K),
      (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
        (x - y = 0 ∨ k ≤ valL F K (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    have hny : -y = 0 ∨ k ≤ valL F K (-y) := by
      rcases hy with h0 | hge
      · exact Or.inl (neg_eq_zero.mpr h0)
      · right; rw [hval_neg_K]; exact hge
    exact hval_add_K k x (-y) hx hny
  have hval_le_L : ∀ {k₁ k₂ : ℤ} {x : L},
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F L x) → (x = 0 ∨ k₁ ≤ valL F L x) := by
    intro k₁ k₂ x hle hx
    rcases hx with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans hle hge)
  have hval_le_K : ∀ {k₁ k₂ : ℤ} {y : K},
      k₁ ≤ k₂ → (y = 0 ∨ k₂ ≤ valL F K y) → (y = 0 ∨ k₁ ≤ valL F K y) := by
    intro k₁ k₂ y hle hy
    rcases hy with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans hle hge)
  have h1_add_ne_zero_L : ∀ {x : L}, (x = 0 ∨ 1 ≤ valL F L x) → 1 + x ≠ 0 := by
    intro x hx h0
    have h1_eq : (1 : L) = -x := eq_neg_of_add_eq_zero_left h0
    rcases hx with hx0 | hge
    · rw [hx0, neg_zero] at h1_eq
      exact one_ne_zero h1_eq
    · have hv : valL F L (1 : L) = valL F L x := by rw [h1_eq, hval_neg_L]
      rw [hval1_L] at hv
      omega
  have h1_add_ne_zero_K : ∀ {y : K}, (y = 0 ∨ 1 ≤ valL F K y) → 1 + y ≠ 0 := by
    intro y hy h0
    have h1_eq : (1 : K) = -y := eq_neg_of_add_eq_zero_left h0
    rcases hy with hy0 | hge
    · rw [hy0, neg_zero] at h1_eq
      exact one_ne_zero h1_eq
    · have hv : valL F K (1 : K) = valL F K y := by rw [h1_eq, hval_neg_K]
      rw [hval1_K] at hv
      omega
  have hnorm_zero : normLM F hLK 0 = 0 := by
    by_contra h0
    have hϖ_norm_ne : normLM F hLK (ϖ_K : K) ≠ 0 :=
      Units.ne_zero (Units.map (normLM F hLK) ϖ_K)
    have h1 : normLM F hLK 0 = normLM F hLK 0 * normLM F hLK (ϖ_K : K) := by
      calc normLM F hLK 0
        _ = normLM F hLK (0 * (ϖ_K : K)) := by rw [zero_mul]
        _ = normLM F hLK 0 * normLM F hLK (ϖ_K : K) := map_mul (normLM F hLK) 0 (ϖ_K : K)
    have h2 : valL F L (normLM F hLK 0) = valL F L (normLM F hLK 0) + 1 := by
      conv_lhs => rw [h1]
      rw [hval_mul_L _ _ h0 hϖ_norm_ne, hval_norm (ϖ_K : K), hϖ_K]
    omega
  have hnorm_val_ge : ∀ (k : ℤ) (y : K),
      (y = 0 ∨ k ≤ valL F K y) →
        (normLM F hLK y = 0 ∨ k ≤ valL F L (normLM F hLK y)) := by
    intro k y hy
    rcases hy with hy0 | hge
    · exact Or.inl (by rw [hy0, hnorm_zero])
    · right; rw [hval_norm y]; exact hge
  have hto_inc : ∀ x : L,
      toExtendScalars F hLK (IntermediateField.inclusion hLK x) = algebraMap L K' x :=
    fun _ => rfl
  have htrace_smul : ∀ (x : L) (y : K),
      traceLM F hLK (IntermediateField.inclusion hLK x * y) = x * traceLM F hLK y := by
    intro x y
    letI : Module L L := Semiring.toModule
    change Algebra.trace L K' (toExtendScalars F hLK (IntermediateField.inclusion hLK x * y)) =
      x * Algebra.trace L K' (toExtendScalars F hLK y)
    rw [map_mul, hto_inc x, ← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]
  have hnorm_stat_eval : ∀ (θ : Lˣ →* (Ω F)ˣ) (c : Lˣ),
      2 ≤ condExp F L θ →
      condExp F L θ ≤ b →
      (∀ x : L, (x = 0 ∨ (((condExp F L θ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c⁻¹ : Lˣ) : L) * x)) →
      ∀ y : K, (y = 0 ∨ (((condExp F L θ + 1) / 2 : ℕ) : ℤ) ≤ valL F K y) →
        ∀ hy : 1 + y ≠ 0,
          (θ (Units.map (normLM F hLK) (Units.mk0 (1 + y) hy)) : Ω F) =
            ψ (((c⁻¹ : Lˣ) : L) * traceLM F hLK y) *
              ψ (((c⁻¹ : Lˣ) : L) * normLM F hLK y) := by
    intro θ c hm_ge2 hm_le_b hc_stat y hy_dom hy
    set m := condExp F L θ
    set r : ℕ := (m + 1) / 2
    have hr_ge1 : 1 ≤ r := by omega
    have hm_le_2r : (m : ℤ) ≤ (2 * r : ℤ) := by omega
    have hr_le_t1 : (r : ℤ) ≤ (t + 1 : ℤ) := by omega
    have hm_le_t1 : (m : ℤ) ≤ (t + 1 : ℤ) := by omega
    obtain ⟨z, hz_val, hnorm_eq⟩ := hnorm_exp r hr_ge1 y hy_dom
    set t_y : L := traceLM F hLK y
    set t_z : L := traceLM F hLK z
    set n_y : L := normLM F hLK y
    have hny_val : n_y = 0 ∨ (r : ℤ) ≤ valL F L n_y :=
      hnorm_val_ge (r : ℤ) y hy_dom
    have hy_tr_in : y = 0 ∨
        (p : ℤ) * (r : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K y := by
      apply hval_le_K _ hy_dom
      rw [hp_sub1_int]
      nlinarith
    have hty_val : t_y = 0 ∨ (r : ℤ) ≤ valL F L t_y :=
      htr_bound (r : ℤ) y hy_tr_in
    have hz_tr_in : z = 0 ∨
        (p : ℤ) * (m : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K z := by
      apply hval_le_K _ hz_val
      rw [hp_sub1_int]
      nlinarith
    have htz_val : t_z = 0 ∨ (m : ℤ) ≤ valL F L t_z :=
      htr_bound (m : ℤ) z hz_tr_in
    have h1ty_ne : 1 + t_y ≠ 0 :=
      h1_add_ne_zero_L (hval_le_L (by omega) hty_val)
    have h1ny_ne : 1 + n_y ≠ 0 :=
      h1_add_ne_zero_L (hval_le_L (by omega) hny_val)
    set w_norm : Lˣ := Units.map (normLM F hLK) (Units.mk0 (1 + y) hy)
    set u_tr : Lˣ := Units.mk0 (1 + t_y) h1ty_ne
    set u_nm : Lˣ := Units.mk0 (1 + n_y) h1ny_ne
    set w_err : Lˣ := w_norm * (u_tr * u_nm)⁻¹
    have hu_tr_mem : u_tr ∈ unitGroup F L r := by
      rw [hunit_ge1_L r hr_ge1 u_tr]
      have hsub : (u_tr : L) - 1 = t_y := by change (1 + t_y) - 1 = t_y; ring
      rw [hsub]
      rcases hty_val with h0 | hge
      · exact Or.inl (sub_eq_zero.mp (hsub.trans h0))
      · exact Or.inr hge
    have hu_nm_mem : u_nm ∈ unitGroup F L r := by
      rw [hunit_ge1_L r hr_ge1 u_nm]
      have hsub : (u_nm : L) - 1 = n_y := by change (1 + n_y) - 1 = n_y; ring
      rw [hsub]
      rcases hny_val with h0 | hge
      · exact Or.inl (sub_eq_zero.mp (hsub.trans h0))
      · exact Or.inr hge
    have hu_prod_inv_val0 : valL F L ((((u_tr * u_nm)⁻¹ : Lˣ) : L)) = 0 := by
      rw [hval_inv_L (u_tr * u_nm), Units.val_mul,
        hval_mul_L _ _ (Units.ne_zero u_tr) (Units.ne_zero u_nm),
        hunit_val0_L r u_tr hu_tr_mem, hunit_val0_L r u_nm hu_nm_mem]
      omega
    have hty_ny_val : t_y * n_y = 0 ∨ (m : ℤ) ≤ valL F L (t_y * n_y) := by
      have hmul := hval_mul_ge_L (r : ℤ) (r : ℤ) t_y n_y hty_val hny_val
      exact hval_le_L (by omega) hmul
    have hdiff_m : t_z - t_y * n_y = 0 ∨ (m : ℤ) ≤ valL F L (t_z - t_y * n_y) :=
      hval_sub_ge_L (m : ℤ) t_z (t_y * n_y) htz_val hty_ny_val
    have hw_err_sub : (w_err : L) - 1 =
        (t_z - t_y * n_y) * ((((u_tr * u_nm)⁻¹ : Lˣ) : L)) := by
      have hwn_coe : (w_norm : L) = 1 + t_y + t_z + n_y := by
        change normLM F hLK (1 + y) = 1 + t_y + t_z + n_y
        rw [hnorm_eq, map_add (traceLM F hLK) y z]
        dsimp [t_y, t_z, n_y]
        ring
      have hprod_coe : ((u_tr * u_nm : Lˣ) : L) = (1 + t_y) * (1 + n_y) := rfl
      have h1 : (w_err : L) - 1 =
          ((w_norm : L) - ((u_tr * u_nm : Lˣ) : L)) * ((((u_tr * u_nm)⁻¹ : Lˣ) : L)) := by
        change (w_norm : L) * ((((u_tr * u_nm)⁻¹ : Lˣ) : L)) - 1 = _
        rw [sub_mul, Units.mul_inv]
      rw [h1, hwn_coe, hprod_coe]
      ring
    have hw_err_mem : w_err ∈ unitGroup F L m := by
      rw [hunit_ge1_L m (by omega) w_err]
      have hmul := hval_mul_ge_L (m : ℤ) 0 (t_z - t_y * n_y)
        ((((u_tr * u_nm)⁻¹ : Lˣ) : L)) hdiff_m (Or.inr (by omega))
      rw [add_zero, ← hw_err_sub] at hmul
      rcases hmul with h0 | hge
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr hge
    have hθ_err : θ w_err = 1 :=
      ((hSpecL θ).2.2.1 (by omega)).1 w_err hw_err_mem
    have hwn_decomp : w_norm = w_err * u_tr * u_nm := by
      dsimp [w_err]
      group
    rw [hwn_decomp, map_mul, map_mul, hθ_err, one_mul, Units.val_mul,
      hc_stat t_y hty_val h1ty_ne, hc_stat n_y hny_val h1ny_ne]
  have hnorm_to_trace : ∀ z : K, (z = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F K z) →
      ψ (((c_τ⁻¹ : Lˣ) : L) * normLM F hLK z) =
        ψ (- ((c_τ⁻¹ : Lˣ) : L) * traceLM F hLK z) := by
    intro z hz_dom
    have hz1 : 1 + z ≠ 0 :=
      h1_add_ne_zero_K (hval_le_K (by omega) hz_dom)
    have heval := hnorm_stat_eval ν₁ c_τ hb_ge2' le_rfl hc_τ_stat z hz_dom hz1
    have hν₁_eq1 : ν₁ (Units.map (normLM F hLK) (Units.mk0 (1 + z) hz1)) = 1 :=
      (hν₁_ker _).mp ⟨Units.mk0 (1 + z) hz1, rfl⟩
    rw [hν₁_eq1, Units.val_one, ← AddChar.map_add_eq_mul] at heval
    set A_tr : L := ((c_τ⁻¹ : Lˣ) : L) * traceLM F hLK z
    set A_nm : L := ((c_τ⁻¹ : Lˣ) : L) * normLM F hLK z
    have hneg_eq : - ((c_τ⁻¹ : Lˣ) : L) * traceLM F hLK z = - A_tr := by
      dsimp [A_tr]; ring
    rw [hneg_eq]
    calc ψ A_nm
      _ = ψ (- A_tr + (A_tr + A_nm)) := by rw [neg_add_cancel_left]
      _ = ψ (- A_tr) * ψ (A_tr + A_nm) := AddChar.map_add_eq_mul ψ (- A_tr) (A_tr + A_nm)
      _ = ψ (- A_tr) * 1 := by rw [← heval]
      _ = ψ (- A_tr) := mul_one _
  set χ'_K : Kˣ →* (Ω F)ˣ := χ'.comp (Units.map (normLM F hLK))
  set β : K := IntermediateField.inclusion hLK (((c_τ⁻¹ : Lˣ) : L)) *
    (IntermediateField.inclusion hLK (N : L) - (u : K))
  have hc_χ_inv_coe : ((c_χ⁻¹ : Lˣ) : L) = ((c_τ⁻¹ : Lˣ) : L) * (N : L) := by
    have hinv : c_χ⁻¹ = c_τ⁻¹ * N := by
      rw [hc_χ_eq, mul_inv_rev, inv_inv, mul_comm]
    rw [hinv, Units.val_mul]
  have hu_norm_coe : normLM F hLK (u : K) = (N : L) :=
    congrArg Units.val hu_norm
  have hχK_lin : ∀ y : K, (y = 0 ∨ (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F K y) →
      ∀ hy : 1 + y ≠ 0,
        (χ'_K (Units.mk0 (1 + y) hy) : Ω F) =
          (traceChar F hLK ψ) (β * y) := by
    intro y hy_dom hy
    have heval := hnorm_stat_eval χ' c_χ ha_ge2' hab' hc_χ_stat y hy_dom hy
    change (χ' (Units.map (normLM F hLK) (Units.mk0 (1 + y) hy)) : Ω F) = _
    rw [heval]
    set z : K := (u : K) * y
    have hz_dom : z = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F K z := by
      have hmul := hval_mul_ge_K ((b : ℤ) - (a : ℤ)) (((a + 1) / 2 : ℕ) : ℤ)
        (u : K) y (Or.inr (by rw [hu_val])) hy_dom
      exact hval_le_K (by omega) hmul
    have hnm_z : ((c_χ⁻¹ : Lˣ) : L) * normLM F hLK y =
        ((c_τ⁻¹ : Lˣ) : L) * normLM F hLK z := by
      dsimp [z]
      rw [hc_χ_inv_coe, map_mul (normLM F hLK) (u : K) y, hu_norm_coe]
      ring
    rw [hnm_z, hnorm_to_trace z hz_dom, ← AddChar.map_add_eq_mul]
    change _ = ψ (traceLM F hLK (β * y))
    congr 1
    have hβy : β * y =
        IntermediateField.inclusion hLK (((c_χ⁻¹ : Lˣ) : L)) * y -
          IntermediateField.inclusion hLK (((c_τ⁻¹ : Lˣ) : L)) * z := by
      dsimp [β, z]
      rw [hc_χ_inv_coe, map_mul]
      ring
    rw [hβy, map_sub (traceLM F hLK), htrace_smul, htrace_smul]
    ring
  have hβ_ge0 : β = 0 ∨ -((a : ℤ) + n_K) ≤ valL F K β := by
    have hN_inc_val : IntermediateField.inclusion hLK (N : L) = 0 ∨
        (b : ℤ) - (a : ℤ) ≤ valL F K (IntermediateField.inclusion hLK (N : L)) := by
      right
      rw [hval_alg (N : L), hN_val]
      nlinarith
    have hdiff_val : IntermediateField.inclusion hLK (N : L) - (u : K) = 0 ∨
        (b : ℤ) - (a : ℤ) ≤ valL F K (IntermediateField.inclusion hLK (N : L) - (u : K)) :=
      hval_sub_ge_K ((b : ℤ) - (a : ℤ))
        (IntermediateField.inclusion hLK (N : L)) (u : K)
        hN_inc_val (Or.inr (by rw [hu_val]))
    have hc_τ_inc_val : IntermediateField.inclusion hLK (((c_τ⁻¹ : Lˣ) : L)) = 0 ∨
        -(p : ℤ) * ((b : ℤ) + n_L) ≤
          valL F K (IntermediateField.inclusion hLK (((c_τ⁻¹ : Lˣ) : L))) := by
      right
      rw [hval_alg (((c_τ⁻¹ : Lˣ) : L)), hval_inv_L c_τ, hc_τ_val]
      dsimp [b]
      linarith
    have hmul := hval_mul_ge_K (-(p : ℤ) * ((b : ℤ) + n_L)) ((b : ℤ) - (a : ℤ))
      (IntermediateField.inclusion hLK (((c_τ⁻¹ : Lˣ) : L)))
      (IntermediateField.inclusion hLK (N : L) - (u : K))
      hc_τ_inc_val hdiff_val
    apply hval_le_K _ hmul
    rw [hnK, hp_sub1_int]
    dsimp [b]
    linarith
  have hβ_not_ge1 : ¬ (β = 0 ∨ -((a : ℤ) + n_K) + 1 ≤ valL F K β) := by
    intro hβ_ge1
    have hcondK_ne0 : condExp F K χ'_K ≠ 0 := by omega
    obtain ⟨_, w₀, hw₀_mem, hw₀_ne1⟩ := (hSpecK χ'_K).2.2.1 hcondK_ne0
    rw [haK] at hw₀_mem
    have ha1_ge1 : 1 ≤ a - 1 := by omega
    have hw₀_prop : (w₀ : K) = 1 ∨ ((a - 1 : ℕ) : ℤ) ≤ valL F K ((w₀ : K) - 1) :=
      (hunit_ge1_K (a - 1) ha1_ge1 w₀).mp hw₀_mem
    set y₀ : K := (w₀ : K) - 1
    have hy₀_a1 : y₀ = 0 ∨ ((a - 1 : ℕ) : ℤ) ≤ valL F K y₀ := by
      rcases hw₀_prop with h1 | h2
      · exact Or.inl (sub_eq_zero.mpr h1)
      · exact Or.inr h2
    have hy₀_dom : y₀ = 0 ∨ (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F K y₀ :=
      hval_le_K (by omega) hy₀_a1
    have hy₀_ne : 1 + y₀ ≠ 0 := by
      have h1 : 1 + y₀ = (w₀ : K) := by dsimp [y₀]; ring
      rw [h1]
      exact Units.ne_zero w₀
    have hmk0_w₀ : Units.mk0 (1 + y₀) hy₀_ne = w₀ := by
      ext
      simp only [Units.val_mk0, y₀]
      ring
    have heval := hχK_lin y₀ hy₀_dom hy₀_ne
    rw [hmk0_w₀] at heval
    have hβy₀_val : β * y₀ = 0 ∨ -n_K ≤ valL F K (β * y₀) := by
      have hmul := hval_mul_ge_K (-((a : ℤ) + n_K) + 1) ((a - 1 : ℕ) : ℤ)
        β y₀ hβ_ge1 hy₀_a1
      exact hval_le_K (by omega) hmul
    have htr_triv : (traceChar F hLK ψ) (β * y₀) = 1 :=
      hψK_triv (β * y₀) hβy₀_val
    have hw₀_eq1 : χ'_K w₀ = 1 := by
      ext
      rw [heval, htr_triv, Units.val_one]
    exact hw₀_ne1 hw₀_eq1
  have hβ_ne0 : β ≠ 0 := fun h0 => hβ_not_ge1 (Or.inl h0)
  have hβ_val : valL F K β = -((a : ℤ) + n_K) := by
    have hge := hβ_ge0.resolve_left hβ_ne0
    have hnot1 : ¬ (-((a : ℤ) + n_K) + 1 ≤ valL F K β) :=
      fun h1 => hβ_not_ge1 (Or.inr h1)
    omega
  let c_χK : Kˣ := (Units.mk0 β hβ_ne0)⁻¹
  have hc_χK_inv : ((c_χK⁻¹ : Kˣ) : K) = β := by
    dsimp [c_χK]
    rw [inv_inv, Units.val_mk0]
  have hc_χK_val : valL F K (c_χK : K) = (a : ℤ) + n_K := by
    dsimp [c_χK]
    rw [hval_inv_K, Units.val_mk0, hβ_val, neg_neg]
  refine ⟨hnorm_to_trace, c_χK, hc_χK_inv, hc_χK_val, ?_⟩
  intro y hy_dom hy
  rw [hc_χK_inv]
  exact hχK_lin y hy_dom hy

theorem ld_wild_low_cond_lt_hasse_sum_matching (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hfrob_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 0 ∨
          1 ≤ valL F L (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)))))
    (ha_ge2 : 2 ≤ condExp F L χ')
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
