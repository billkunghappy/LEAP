    (∏ r ∈ Finset.range ℓ, F (δ r) = ∏ j ∈ Finset.range ℓ, F (γ j)) at h_perm
  obtain ⟨h_block_sum, h_block_prod⟩ := h_s1 ℓ δ hδ_lt
  obtain ⟨h_gamma_sum, h_vp_sum, h_ord_prod⟩ := h_s3 h a hq_eq ha_lt_pf
  change ∑ j ∈ Finset.range ℓ, γ j = a + ∑ j ∈ (Finset.range ℓ).erase 0, j * h at h_gamma_sum
  change ∑ j ∈ Finset.range ℓ, padicValNat p (γ j).factorial =
    padicValNat p a.factorial + ∑ j ∈ (Finset.range ℓ).erase 0, padicValNat p (j * h).factorial at h_vp_sum
  have h_leg : ∀ m : ℕ, (p - 1) * padicValNat p m.factorial + (p.digits m).sum = m := by
    intro m
    have h1 := sub_one_mul_padicValNat_factorial (p := p) m
    have h2 := Nat.digit_sum_le p m
    omega
  have h_digit_sum :
      (p.digits a_star).sum =
        (p.digits a).sum + ∑ j ∈ (Finset.range ℓ).erase 0, (p.digits (j * h)).sum := by
    have h_a_star_sum : (p.digits a_star).sum = ∑ j ∈ Finset.range ℓ, (p.digits (γ j)).sum := by
      rw [ha_star_eq, h_block_sum, (h_perm (fun m => (p.digits m).sum)).1]
    rw [h_a_star_sum]
    have h_lhs_leg :
        (p - 1) * (∑ j ∈ Finset.range ℓ, padicValNat p (γ j).factorial) +
