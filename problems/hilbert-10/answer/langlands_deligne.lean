    rcases (hresM_ker (u_all_0 j : M_C) (hU0_int (hu_all_0_val j))).mp h0 with h_zero | h_ge1
    · exact Units.ne_zero (u_all_0 j) h_zero
    · have hval0 := hu_all_0_val j
