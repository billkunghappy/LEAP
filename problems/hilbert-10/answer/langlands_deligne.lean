      change valL F B ((u_j⁻¹ : Bˣ) : B) = 0
      rw [hvalB_inv u_j]
      change - valL F B ((j : ℕ) : B) = 0
      omega
    exact ⟨hj_ne0, hinv_v⟩
  have huB_eq_all : ∀ w : K₁,
      1 - normLM F hBK (1 - w) =
        (∑ r ∈ Finset.Icc 1 (p - 1), (- s (-w) r)) + normLM F hBK w := by
    intro w
    have hnorm_neg : normLM F hBK (-w) = - normLM F hBK w := by
      have hneg_eq : -w = IntermediateField.inclusion hBK (-1 : B) * w := by simp
      rw [hneg_eq, hnorm_incl_mul (-1) w, Odd.neg_one_pow hp_odd_nat, neg_one_mul]
    have h1 := hs_norm_one_add (-w)
    have h1w : (1 : K₁) + (-w) = 1 - w := by ring
    rw [h1w, hnorm_neg] at h1
    rw [Finset.sum_neg_distrib]
    linear_combination -h1
  have htr_neg_pow : ∀ (w : K₁) (k : ℕ),
      traceLM F hBK ((-w) ^ k) = (-1 : B) ^ k * traceLM F hBK (w ^ k) := by
    intro w k
    have hneg_k : (-w) ^ k = IntermediateField.inclusion hBK ((-1 : B) ^ k) * w ^ k := by
      rw [map_pow, map_neg, map_one, ← mul_pow, neg_one_mul]
    rw [hneg_k, htr_incl_mul]
  have h_newton_all : ∀ (w : K₁), ∀ r ∈ Finset.Icc 1 (p - 1),
      traceLM F hBK (w ^ r) =
        ((r : ℕ) : B) * (- s (-w) r) +
          ∑ l ∈ Finset.Icc 1 (r - 1), (- s (-w) l) * traceLM F hBK (w ^ (r - l)) := by
    intro w r hr
    obtain ⟨hr1, _⟩ := Finset.mem_Icc.mp hr
    have hN := hs_newton1 (-w) r hr
    rw [htr_neg_pow w r] at hN
    have hsign1 : (-1 : B) ^ r * (-1 : B) ^ (r - 1) = -1 := by
      rw [← pow_add]
      have hodd : Odd (r + (r - 1)) := ⟨r - 1, by omega⟩
      exact Odd.neg_one_pow hodd
    have hsign2 : (-1 : B) ^ r * (-1 : B) ^ r = 1 := by
      rw [← pow_add]
      have heven : Even (r + r) := ⟨r, by omega⟩
      exact Even.neg_one_pow heven
    have hLHS : (-1 : B) ^ r * ((-1 : B) ^ (r - 1) * ((r : ℕ) : B) * s (-w) r -
        (-1 : B) ^ r * traceLM F hBK (w ^ r)) =
        ((r : ℕ) : B) * (- s (-w) r) - traceLM F hBK (w ^ r) := by
      calc
        (-1 : B) ^ r * ((-1 : B) ^ (r - 1) * ((r : ℕ) : B) * s (-w) r -
            (-1 : B) ^ r * traceLM F hBK (w ^ r)) =
            ((-1 : B) ^ r * (-1 : B) ^ (r - 1)) * ((r : ℕ) : B) * s (-w) r -
              ((-1 : B) ^ r * (-1 : B) ^ r) * traceLM F hBK (w ^ r) := by ring
        _ = ((r : ℕ) : B) * (- s (-w) r) - traceLM F hBK (w ^ r) := by
            rw [hsign1, hsign2]; ring
    have hRHS : (-1 : B) ^ r * (- ∑ l ∈ Finset.Icc 1 (r - 1),
        (-1 : B) ^ (l - 1) * s (-w) l * traceLM F hBK ((-w) ^ (r - l))) =
        - ∑ l ∈ Finset.Icc 1 (r - 1), (- s (-w) l) * traceLM F hBK (w ^ (r - l)) := by
      rw [mul_neg, neg_inj, Finset.mul_sum]
      refine Finset.sum_congr rfl fun l hl => ?_
      obtain ⟨hl1, hlr⟩ := Finset.mem_Icc.mp hl
      rw [htr_neg_pow w (r - l)]
      have hsign_l : (-1 : B) ^ r * (-1 : B) ^ (l - 1) * (-1 : B) ^ (r - l) = -1 := by
        rw [← pow_add, ← pow_add]
        have hodd : Odd (r + (l - 1) + (r - l)) := ⟨r - 1, by omega⟩
        exact Odd.neg_one_pow hodd
      calc
        (-1 : B) ^ r * ((-1 : B) ^ (l - 1) * s (-w) l * ((-1 : B) ^ (r - l) * traceLM F hBK (w ^ (r - l)))) =
            ((-1 : B) ^ r * (-1 : B) ^ (l - 1) * (-1 : B) ^ (r - l)) * s (-w) l * traceLM F hBK (w ^ (r - l)) := by ring
        _ = (- s (-w) l) * traceLM F hBK (w ^ (r - l)) := by
            rw [hsign_l]; ring
    have hmul := congrArg (fun x : B => (-1 : B) ^ r * x) hN
    dsimp only at hmul
    rw [hLHS, hRHS] at hmul
    linear_combination -hmul
  have hBridge : ∀ w : K₁, (w = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ w) →
      (1 - normLM F hBK (1 - w) =
        (∑ r ∈ Finset.Icc 1 (p - 1), (- s (-w) r)) + normLM F hBK w) ∧
      (∀ r ∈ Finset.Icc 1 (p - 1),
        traceLM F hBK (w ^ r) =
          ((r : ℕ) : B) * (- s (-w) r) +
            ∑ l ∈ Finset.Icc 1 (r - 1), (- s (-w) l) * traceLM F hBK (w ^ (r - l))) ∧
      (∀ r ∈ Finset.Icc 1 (p - 1),
        (- s (-w) r) = 0 ∨
          (((q₁ + (p - 1) * T) / p : ℕ) : ℤ) ≤ valL F B (- s (-w) r)) ∧
      (∀ r ∈ Finset.Icc 1 (p - 1),
        traceLM F hBK (w ^ r) = 0 ∨
          (((q₁ + (p - 1) * T) / p : ℕ) : ℤ) ≤ valL F B (traceLM F hBK (w ^ r))) ∧
      (∀ r ∈ Finset.Icc 1 (p - 1),
        (- s (-w) r) = 0 ∨
          (r : ℤ) * (q₁ : ℤ) + ((p - 1 : ℕ) : ℤ) * ((T - 1 : ℕ) : ℤ) ≤
            (p : ℤ) * valL F B (- s (-w) r)) ∧
      (normLM F hBK w = 0 ∨ (q₁ : ℤ) ≤ valL F B (normLM F hBK w)) := by
    intro w hw
    have hw_neg : -w = 0 ∨ (q₁ : ℤ) ≤ valL F K₁ (-w) := by
      rcases hw with rfl | hle
      · left; simp
      · right; rwa [hvalK₁_neg]
    let e₁ : ℕ := (q₁ + (p - 1) * T) / p
    have he1_ineq : ∀ r ∈ Finset.Icc 1 (p - 1),
        (p : ℤ) * (e₁ : ℤ) - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ (r : ℤ) * (q₁ : ℤ) := by
      intro r hr
      obtain ⟨hr1, _⟩ := Finset.mem_Icc.mp hr
      have hdiv_nat := Nat.div_add_mod (q₁ + (p - 1) * T) p
      have hpe1 : p * e₁ ≤ q₁ + (p - 1) * T := by dsimp [e₁]; omega
      have hrq1 : q₁ ≤ r * q₁ := by
        simpa [one_mul] using Nat.mul_le_mul_right q₁ hr1
      have hle_nat : p * e₁ ≤ r * q₁ + (p - 1) * T := by omega
      have hle_z : ((p * e₁ : ℕ) : ℤ) ≤ ((r * q₁ + (p - 1) * T : ℕ) : ℤ) := by
        exact_mod_cast hle_nat
      push_cast at hle_z
      linarith
    refine ⟨huB_eq_all w, h_newton_all w, ?_, ?_, ?_, ?_⟩
    · intro r hr
      rcases hs_val (-w) r hr (q₁ : ℤ) (e₁ : ℤ) hw_neg (he1_ineq r hr) with h0 | hle
      · left; rw [h0, neg_zero]
      · right; rw [hvalB_neg]; exact hle
    · intro r hr
      obtain ⟨hr1, _⟩ := Finset.mem_Icc.mp hr
      have hwr : w ^ r = 0 ∨ (r : ℤ) * (q₁ : ℤ) ≤ valL F K₁ (w ^ r) :=
        hvalK₁_pow_ge w (q₁ : ℤ) r hr1 (Nat.cast_nonneg q₁) hw
      apply htr_BK (e₁ : ℤ) (w ^ r)
      rcases hwr with h0 | hle
      · left; exact h0
      · right; linarith [he1_ineq r hr]
    · intro r hr
      let N_r : ℤ := (r : ℤ) * (q₁ : ℤ) + ((p - 1 : ℕ) : ℤ) * (T : ℤ)
      let m_r : ℤ := N_r / (p : ℤ)
      have hdiv := Int.mul_ediv_add_emod N_r (p : ℤ)
      have hmod_ge := Int.emod_nonneg N_r (by omega : (p : ℤ) ≠ 0)
      have hmod_lt := Int.emod_lt_of_pos N_r hp_pos_z
      have hmr_ineq : (p : ℤ) * m_r - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ (r : ℤ) * (q₁ : ℤ) := by
        dsimp [m_r, N_r] at hdiv ⊢
        linarith
      rcases hs_val (-w) r hr (q₁ : ℤ) m_r hw_neg hmr_ineq with h0 | hle
      · left; rw [h0, neg_zero]
      · right
        rw [hvalB_neg]
        have hpm_le : (p : ℤ) * m_r ≤ (p : ℤ) * valL F B (s (-w) r) :=
          mul_le_mul_of_nonneg_left hle (by omega)
        have hp1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
        have hT1 : ((T - 1 : ℕ) : ℤ) = (T : ℤ) - 1 := by omega
        have hNr_lb : (r : ℤ) * (q₁ : ℤ) + ((p - 1 : ℕ) : ℤ) * ((T - 1 : ℕ) : ℤ) ≤ (p : ℤ) * m_r := by
          dsimp [m_r, N_r] at hdiv hmod_lt ⊢
          have hrem_le : ((r : ℤ) * (q₁ : ℤ) + ((p - 1 : ℕ) : ℤ) * (T : ℤ)) % (p : ℤ) ≤ ((p - 1 : ℕ) : ℤ) := by
            omega
          have hsub : ((p - 1 : ℕ) : ℤ) * (T : ℤ) - ((p - 1 : ℕ) : ℤ) =
              ((p - 1 : ℕ) : ℤ) * ((T - 1 : ℕ) : ℤ) := by
            rw [hT1]; ring
          linarith
        linarith
    · rcases hw with rfl | hle
      · left; exact hnorm_zero
      · right; rwa [hval_norm_BK w]
  have hDeep : ∀ w : K₁, (w = 0 ∨ ((p * m_B : ℕ) : ℤ) ≤ valL F K₁ w) →
      let u_B := 1 - normLM F hBK (1 - w)
      (u_B = 0 ∨ (m_B : ℤ) ≤ valL F B u_B) ∧
      (P_B u_B = 0 ∨ (m_B : ℤ) ≤ valL F B (P_B u_B)) := by
    intro w hw u_B
    have hw_neg : -w = 0 ∨ ((p * m_B : ℕ) : ℤ) ≤ valL F K₁ (-w) := by
      rcases hw with rfl | hle
      · left; simp
      · right; rwa [hvalK₁_neg]
    have hb_deep : ∀ r ∈ Finset.Icc 1 (p - 1),
        (- s (-w) r) = 0 ∨ (m_B : ℤ) ≤ valL F B (- s (-w) r) := by
      intro r hr
      obtain ⟨hr1, _⟩ := Finset.mem_Icc.mp hr
      have hr_mul : p * m_B ≤ r * (p * m_B) := by
        simpa [one_mul] using Nat.mul_le_mul_right (p * m_B) hr1
      have hr_mul_z : (p : ℤ) * (m_B : ℤ) ≤ (r : ℤ) * ((p * m_B : ℕ) : ℤ) := by
        have h : ((p * m_B : ℕ) : ℤ) ≤ ((r * (p * m_B) : ℕ) : ℤ) := by exact_mod_cast hr_mul
        push_cast at h ⊢
        exact h
      have h_nonneg : (0 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (T : ℤ) := by positivity
      have hineq : (p : ℤ) * (m_B : ℤ) - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤
          (r : ℤ) * ((p * m_B : ℕ) : ℤ) := by linarith
      rcases hs_val (-w) r hr ((p * m_B : ℕ) : ℤ) (m_B : ℤ) hw_neg hineq with h0 | hle
      · left; rw [h0, neg_zero]
      · right; rw [hvalB_neg]; exact hle
    have hsum_deep : (∑ r ∈ Finset.Icc 1 (p - 1), (- s (-w) r)) = 0 ∨
        (m_B : ℤ) ≤ valL F B (∑ r ∈ Finset.Icc 1 (p - 1), (- s (-w) r)) :=
      hvalB_sum (Finset.Icc 1 (p - 1)) (fun r => - s (-w) r) (m_B : ℤ) hb_deep
    have hNw_deep : normLM F hBK w = 0 ∨ (m_B : ℤ) ≤ valL F B (normLM F hBK w) := by
      rcases hw with rfl | hle
      · left; exact hnorm_zero
      · right
        rw [hval_norm_BK w]
        have hm_le : m_B ≤ p * m_B := by
          simpa [one_mul] using Nat.mul_le_mul_right m_B hp_pos
        have hm_le_z : (m_B : ℤ) ≤ ((p * m_B : ℕ) : ℤ) := by exact_mod_cast hm_le
        omega
    have huB_deep : u_B = 0 ∨ (m_B : ℤ) ≤ valL F B u_B := by
      change (1 - normLM F hBK (1 - w)) = 0 ∨ (m_B : ℤ) ≤ valL F B (1 - normLM F hBK (1 - w))
      rw [huB_eq_all w]
      exact hvalB_add (m_B : ℤ) _ _ hsum_deep hNw_deep
    refine ⟨huB_deep, ?_⟩
    dsimp only [P_B]
    refine hvalB_sum (Finset.Icc 1 (p - 1)) (fun j => ((j : ℕ) : B)⁻¹ * u_B ^ j) (m_B : ℤ) fun j hj => ?_
    obtain ⟨hj1, _⟩ := Finset.mem_Icc.mp hj
    have hj_inv_v : ((j : ℕ) : B)⁻¹ = 0 ∨ (0 : ℤ) ≤ valL F B (((j : ℕ) : B)⁻¹) := by
      right
      rw [(hj_B j hj).2]
    have huBj_v : u_B ^ j = 0 ∨ (m_B : ℤ) ≤ valL F B (u_B ^ j) := by
      rcases hvalB_pow_ge u_B (m_B : ℤ) j hj1 (Nat.cast_nonneg m_B) huB_deep with h0 | hle
      · left; exact h0
      · right
        have hj_m : (1 : ℤ) * (m_B : ℤ) ≤ (j : ℤ) * (m_B : ℤ) :=
          mul_le_mul_of_nonneg_right (by omega) (Nat.cast_nonneg m_B)
        linarith
    dsimp only
    rcases hvalB_mul_bound (((j : ℕ) : B)⁻¹) (u_B ^ j) 0 (m_B : ℤ) hj_inv_v huBj_v with h0 | hle
    · left; exact h0
    · right; omega
  exact ⟨hj_B, hBridge, hDeep⟩

theorem ld_ch12_wild_odd_upper_edge_newton_girard_conv_poly_id (B : Type u) [Field B]
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (hj_ne0 : ∀ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : B) ≠ 0)
    (b t_pow : ℕ → B)
    (h_newton : ∀ r ∈ Finset.Icc 1 (p - 1),
      t_pow r = ((r : ℕ) : B) * b r +
        ∑ l ∈ Finset.Icc 1 (r - 1), b l * t_pow (r - l)) :
    ∃ c : ℕ → ℕ → B,
      (∀ m : ℕ, c 0 m = if m = 0 then 1 else 0) ∧
      (∀ (k m : ℕ),
        c (k + 1) m =
          ∑ r ∈ Finset.Icc 1 (p - 1), (if r ≤ m then b r * c k (m - r) else 0)) ∧
      (∀ m : ℕ, p ≤ m → c 1 m = 0) ∧
      (∀ k ∈ Finset.Icc 1 (p - 1),
        (∑ r ∈ Finset.Icc 1 (p - 1), b r) ^ k =
          (∑ m ∈ Finset.Icc 1 (p - 1), c k m) +
            (∑ s ∈ Finset.range ((p - 1) * (p - 1)), c k (p + s))) ∧
      (∑ k ∈ Finset.Icc 1 (p - 1),
        ((k : ℕ) : B)⁻¹ * (∑ m ∈ Finset.Icc 1 (p - 1), c k m) =
        ∑ m ∈ Finset.Icc 1 (p - 1), ((m : ℕ) : B)⁻¹ * t_pow m) :=
by
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  let c : ℕ → ℕ → B := fun k =>
    Nat.rec (fun m => if m = 0 then 1 else 0)
      (fun _ ck m => ∑ r ∈ Finset.Icc 1 (p - 1), (if r ≤ m then b r * ck (m - r) else 0)) k
  have hc_zero : ∀ m : ℕ, c 0 m = if m = 0 then 1 else 0 := fun _ => rfl
  have hc_succ : ∀ (k m : ℕ),
      c (k + 1) m =
        ∑ r ∈ Finset.Icc 1 (p - 1), (if r ≤ m then b r * c k (m - r) else 0) :=
    fun _ _ => rfl
  have hc_lt : ∀ (k m : ℕ), m < k → c k m = 0 := by
    intro k
    induction k with
    | zero =>
      intro m hm
      omega
    | succ k ih =>
      intro m hm
      rw [hc_succ k m]
      refine Finset.sum_eq_zero fun r hr => ?_
      split_ifs with hrm
      · have hr1 : 1 ≤ r := (Finset.mem_Icc.mp hr).1
        rw [ih (m - r) (by omega), mul_zero]
      · rfl
  have hc_gt : ∀ (k m : ℕ), k * (p - 1) < m → c k m = 0 := by
    intro k
    induction k with
    | zero =>
      intro m hm
      rw [hc_zero m, if_neg (by omega)]
    | succ k ih =>
      intro m hm
      rw [hc_succ k m]
      refine Finset.sum_eq_zero fun r hr => ?_
      split_ifs with hrm
      · have hr_ub : r ≤ p - 1 := (Finset.mem_Icc.mp hr).2
        have hgt : k * (p - 1) < m - r := by
          rw [Nat.add_mul, one_mul] at hm
          omega
        rw [ih (m - r) hgt, mul_zero]
      · rfl
  have hc_one_ge : ∀ m : ℕ, p ≤ m → c 1 m = 0 := by
    intro m hm
    exact hc_gt 1 m (by omega)
  let S : B := ∑ r ∈ Finset.Icc 1 (p - 1), b r
  have hc_sum_range : ∀ (k N : ℕ), k * (p - 1) ≤ N →
      (∑ m ∈ Finset.range (N + 1), c k m) = S ^ k := by
    intro k
    induction k with
    | zero =>
      intro N _
      rw [Finset.sum_range_succ', pow_zero, hc_zero 0, if_pos rfl]
      have h0 : (∑ x ∈ Finset.range N, c 0 (x + 1)) = 0 := by
        refine Finset.sum_eq_zero fun x _ => ?_
        rw [hc_zero, if_neg (by omega)]
      rw [h0, zero_add]
    | succ k ih =>
      intro N hN
      have h1 : (∑ m ∈ Finset.range (N + 1), c (k + 1) m) =
          ∑ r ∈ Finset.Icc 1 (p - 1),
            ∑ m ∈ Finset.range (N + 1), (if r ≤ m then b r * c k (m - r) else 0) := by
        conv_lhs =>
          arg 2
          ext m
          rw [hc_succ k m]
        exact Finset.sum_comm
      rw [h1]
      have hterm : ∀ r ∈ Finset.Icc 1 (p - 1),
          (∑ m ∈ Finset.range (N + 1), (if r ≤ m then b r * c k (m - r) else 0)) =
            b r * S ^ k := by
        intro r hr
        obtain ⟨hr1, hr_ub⟩ := Finset.mem_Icc.mp hr
        have hN_exp : k * (p - 1) + (p - 1) ≤ N := by
          have h := hN
          rw [Nat.add_mul, one_mul] at h
          exact h
        have hN_ge : k * (p - 1) ≤ N - r := by omega
        have hN_split : N + 1 = r + (N - r + 1) := by omega
        rw [hN_split, Finset.sum_range_add]
        have hlow : (∑ m ∈ Finset.range r, (if r ≤ m then b r * c k (m - r) else 0)) = 0 := by
          refine Finset.sum_eq_zero fun m hm => ?_
          rw [Finset.mem_range] at hm
          rw [if_neg (by omega)]
        have hhigh : (∑ s ∈ Finset.range (N - r + 1),
            (if r ≤ r + s then b r * c k (r + s - r) else 0)) =
            b r * (∑ s ∈ Finset.range (N - r + 1), c k s) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun s _ => ?_
          rw [if_pos (Nat.le_add_right r s), Nat.add_sub_cancel_left]
        rw [hlow, zero_add, hhigh, ih (N - r) hN_ge]
      rw [Finset.sum_congr rfl hterm, ← Finset.sum_mul, pow_succ']
  have hc_pow_split : ∀ k ∈ Finset.Icc 1 (p - 1),
      S ^ k =
        (∑ m ∈ Finset.Icc 1 (p - 1), c k m) +
          (∑ s ∈ Finset.range ((p - 1) * (p - 1)), c k (p + s)) := by
    intro k hk
    obtain ⟨hk1, hk_ub⟩ := Finset.mem_Icc.mp hk
    let N : ℕ := (p - 1) + (p - 1) * (p - 1)
    have hN_ge : k * (p - 1) ≤ N := by
      have hmul : k * (p - 1) ≤ (p - 1) * (p - 1) := Nat.mul_le_mul_right (p - 1) hk_ub
      dsimp [N]
      omega
    have hN_eq : N + 1 = p + (p - 1) * (p - 1) := by dsimp [N]; omega
    rw [← hc_sum_range k N hN_ge, hN_eq, Finset.sum_range_add (c k) p ((p - 1) * (p - 1))]
    congr 1
    have hp_eq : p = (p - 1) + 1 := by omega
    conv_lhs => rw [hp_eq, Finset.sum_range_succ']
    rw [hc_lt k 0 (by omega), add_zero]
    refine Finset.sum_bij (fun x _ => x + 1) ?_ ?_ ?_ ?_
    · intro x hx
      dsimp only
      rw [Finset.mem_range] at hx
      rw [Finset.mem_Icc]
      omega
    · intro x₁ _ x₂ _ h
      dsimp only at h
      omega
    · intro m hm
      rw [Finset.mem_Icc] at hm
      refine ⟨m - 1, ?_, by dsimp only; omega⟩
      rw [Finset.mem_range]
      omega
    · intro _ _
      rfl
  let A_sum : ℕ → ℕ → B := fun k m =>
    ∑ r ∈ Finset.Icc 1 (p - 1), (if r ≤ m then ((r : ℕ) : B) * b r * c k (m - r) else 0)
  let B_sum : ℕ → ℕ → B := fun k m =>
    ∑ r ∈ Finset.Icc 1 (p - 1), (if r ≤ m then b r * (((m - r : ℕ) : B) * c k (m - r)) else 0)
  have hc_m_split : ∀ (k m : ℕ),
      ((m : ℕ) : B) * c (k + 1) m = A_sum k m + B_sum k m := by
    intro k m
    dsimp only [A_sum, B_sum]
    rw [hc_succ k m, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun r _ => ?_
    split_ifs with hrm
    · have hm_eq : (m : B) = (r : B) + ((m - r : ℕ) : B) := by
        have hnat : m = r + (m - r) := (Nat.add_sub_of_le hrm).symm
        conv_lhs => rw [hnat]
        push_cast
        rfl
      rw [hm_eq]
      ring
    · simp
  have hc_weight : ∀ (k m : ℕ),
      ((m : ℕ) : B) * c (k + 1) m = ((k + 1 : ℕ) : B) * A_sum k m := by
    intro k
    induction k with
    | zero =>
      intro m
      dsimp only [A_sum]
      rw [hc_succ 0 m, Finset.mul_sum]
      push_cast
      rw [one_mul]
      refine Finset.sum_congr rfl fun r _ => ?_
      split_ifs with hrm
      · rw [hc_zero (m - r)]
        split_ifs with hmr0
        · have hmr : m = r := by omega
          rw [hmr]
          ring
        · ring
      · simp
    | succ k ih =>
      intro m
      rw [hc_m_split (k + 1) m]
      have hB_eq : B_sum (k + 1) m = ((k + 1 : ℕ) : B) * A_sum (k + 1) m := by
        dsimp only [B_sum, A_sum]
        have hB1 : (∑ r ∈ Finset.Icc 1 (p - 1),
            (if r ≤ m then b r * (((m - r : ℕ) : B) * c (k + 1) (m - r)) else 0)) =
            ∑ r ∈ Finset.Icc 1 (p - 1),
              ∑ s ∈ Finset.Icc 1 (p - 1),
                (if r ≤ m ∧ s ≤ m - r then
                  ((k + 1 : ℕ) : B) * ((s : ℕ) : B) * b r * b s * c k (m - r - s)
                else 0) := by
          refine Finset.sum_congr rfl fun r _ => ?_
          split_ifs with hrm
          · rw [ih (m - r)]
            dsimp only [A_sum]
            rw [Finset.mul_sum, Finset.mul_sum]
            refine Finset.sum_congr rfl fun s _ => ?_
            by_cases hsm : s ≤ m - r
            · rw [if_pos hsm, if_pos ⟨hrm, hsm⟩]
              ring
            · rw [if_neg hsm, if_neg (by tauto)]
              ring
          · symm
            refine Finset.sum_eq_zero fun s _ => ?_
            rw [if_neg (by tauto)]
        have hA1 : ((k + 1 : ℕ) : B) *
            (∑ s ∈ Finset.Icc 1 (p - 1),
              (if s ≤ m then ((s : ℕ) : B) * b s * c (k + 1) (m - s) else 0)) =
            ∑ s ∈ Finset.Icc 1 (p - 1),
              ∑ r ∈ Finset.Icc 1 (p - 1),
                (if s ≤ m ∧ r ≤ m - s then
                  ((k + 1 : ℕ) : B) * ((s : ℕ) : B) * b r * b s * c k (m - s - r)
                else 0) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun s _ => ?_
          split_ifs with hsm
          · rw [hc_succ k (m - s), Finset.mul_sum, Finset.mul_sum]
            refine Finset.sum_congr rfl fun r _ => ?_
            by_cases hrm : r ≤ m - s
            · rw [if_pos hrm, if_pos ⟨hsm, hrm⟩]
              ring
            · rw [if_neg hrm, if_neg (by tauto)]
              ring
          · rw [mul_zero]
            symm
            refine Finset.sum_eq_zero fun r _ => ?_
            rw [if_neg (by tauto)]
        rw [hB1, hA1, Finset.sum_comm]
        refine Finset.sum_congr rfl fun s _ => ?_
        refine Finset.sum_congr rfl fun r _ => ?_
        have hcond : (r ≤ m ∧ s ≤ m - r) ↔ (s ≤ m ∧ r ≤ m - s) := by omega
        by_cases h : s ≤ m ∧ r ≤ m - s
        · rw [if_pos (hcond.mpr h), if_pos h]
          have hsub : m - r - s = m - s - r := by omega
          rw [hsub]
        · rw [if_neg (mt hcond.mp h), if_neg h]
      rw [hB_eq]
      push_cast
      ring
  have hc_B_rel : ∀ (k m : ℕ),
      ((k : ℕ) : B) * (((m : ℕ) : B) * c (k + 1) m) = ((k + 1 : ℕ) : B) * B_sum k m := by
    intro k m
    have h1 := hc_m_split k m
    have h2 := hc_weight k m
    have hB : B_sum k m = ((k : ℕ) : B) * A_sum k m := by
      have h2' : ((k + 1 : ℕ) : B) * A_sum k m = ((k : ℕ) : B) * A_sum k m + A_sum k m := by
        push_cast; ring
      linear_combination (h2.trans h2') - h1
    rw [h2, hB]
    ring
  let W : ℕ → B := fun m => ∑ k ∈ Finset.Icc 1 (p - 1), ((k : ℕ) : B)⁻¹ * c k m
  have hc_one_eq : ∀ m ∈ Finset.Icc 1 (p - 1), c 1 m = b m := by
    intro m hm
    change c (0 + 1) m = b m
    rw [hc_succ 0 m]
    have hsub : (∑ r ∈ Finset.Icc 1 (p - 1), (if r ≤ m then b r * c 0 (m - r) else 0)) =
        ∑ r ∈ Finset.Icc 1 (p - 1), (if r = m then b m else 0) := by
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [hc_zero (m - r)]
      by_cases hrm : r = m
      · subst hrm
        simp
      · split_ifs with hle h0
        · exfalso; omega
        · ring
        · rfl
    rw [hsub, Finset.sum_ite_eq' (Finset.Icc 1 (p - 1)) m (fun _ => b m), if_pos hm]
  have hW_rec : ∀ m ∈ Finset.Icc 1 (p - 1),
      ((m : ℕ) : B) * W m =
        ((m : ℕ) : B) * b m +
          ∑ r ∈ Finset.Icc 1 (m - 1), b r * (((m - r : ℕ) : B) * W (m - r)) := by
    intro m hm
    obtain ⟨hm1, hm_ub⟩ := Finset.mem_Icc.mp hm
    have hIcc_split : Finset.Icc 1 (p - 1) = insert 1 (Finset.Icc 2 (p - 1)) := by
      ext k
      simp only [Finset.mem_Icc, Finset.mem_insert]
      omega
    have h1_not_mem : (1 : ℕ) ∉ Finset.Icc 2 (p - 1) := by simp
    conv_lhs =>
      dsimp only [W]
      rw [Finset.mul_sum, hIcc_split, Finset.sum_insert h1_not_mem]
    have hterm1 : (m : B) * (((1 : ℕ) : B)⁻¹ * c 1 m) = (m : B) * b m := by
      rw [Nat.cast_one, inv_one, one_mul, hc_one_eq m hm]
    rw [hterm1]
    congr 1
    have hshift : (∑ k ∈ Finset.Icc 2 (p - 1), (m : B) * (((k : ℕ) : B)⁻¹ * c k m)) =
        ∑ j ∈ Finset.Icc 1 (p - 2), (m : B) * (((j + 1 : ℕ) : B)⁻¹ * c (j + 1) m) := by
      refine Finset.sum_bij (fun k _ => k - 1) ?_ ?_ ?_ ?_
      · intro k hk
        dsimp only
        rw [Finset.mem_Icc] at hk ⊢
        omega
      · intro k₁ hk₁ k₂ hk₂ h
        dsimp only at h
        rw [Finset.mem_Icc] at hk₁ hk₂
        omega
      · intro j hj
        rw [Finset.mem_Icc] at hj
        refine ⟨j + 1, ?_, by dsimp only; omega⟩
        rw [Finset.mem_Icc]
        omega
      · intro k hk
        dsimp only
        rw [Finset.mem_Icc] at hk
        have hk_eq : k - 1 + 1 = k := by omega
        rw [hk_eq]
    rw [hshift]
    have hj_term : ∀ j ∈ Finset.Icc 1 (p - 2),
        (m : B) * (((j + 1 : ℕ) : B)⁻¹ * c (j + 1) m) =
          ∑ r ∈ Finset.Icc 1 (m - 1),
            b r * (((m - r : ℕ) : B) * (((j : ℕ) : B)⁻¹ * c j (m - r))) := by
      intro j hj
      obtain ⟨hj1, hj_ub⟩ := Finset.mem_Icc.mp hj
      have hj_ne : ((j : ℕ) : B) ≠ 0 := hj_ne0 j (Finset.mem_Icc.mpr ⟨hj1, by omega⟩)
      have hj1_ne : ((j + 1 : ℕ) : B) ≠ 0 := hj_ne0 (j + 1) (Finset.mem_Icc.mpr ⟨by omega, by omega⟩)
      have hrel := hc_B_rel j m
      have hdiv : (m : B) * (((j + 1 : ℕ) : B)⁻¹ * c (j + 1) m) =
          ((j : ℕ) : B)⁻¹ * B_sum j m := by
        apply mul_left_cancel₀ hj_ne
        apply mul_left_cancel₀ hj1_ne
        calc
          ((j + 1 : ℕ) : B) * (((j : ℕ) : B) * ((m : B) * (((j + 1 : ℕ) : B)⁻¹ * c (j + 1) m))) =
              (((j + 1 : ℕ) : B) * ((j + 1 : ℕ) : B)⁻¹) * (((j : ℕ) : B) * ((m : B) * c (j + 1) m)) := by ring
          _ = ((j : ℕ) : B) * ((m : B) * c (j + 1) m) := by rw [mul_inv_cancel₀ hj1_ne, one_mul]
          _ = ((j + 1 : ℕ) : B) * B_sum j m := hrel
          _ = ((j + 1 : ℕ) : B) * ((((j : ℕ) : B) * ((j : ℕ) : B)⁻¹) * B_sum j m) := by
              rw [mul_inv_cancel₀ hj_ne, one_mul]
          _ = ((j + 1 : ℕ) : B) * (((j : ℕ) : B) * (((j : ℕ) : B)⁻¹ * B_sum j m)) := by ring
      rw [hdiv]
      dsimp only [B_sum]
      rw [Finset.mul_sum]
      have hsub_dom : Finset.Icc 1 (m - 1) ⊆ Finset.Icc 1 (p - 1) :=
        Finset.Icc_subset_Icc_right (by omega)
      rw [← Finset.sum_subset hsub_dom]
      · refine Finset.sum_congr rfl fun r hr => ?_
        have hrm : r ≤ m := by
          rw [Finset.mem_Icc] at hr
          omega
        rw [if_pos hrm]
        ring
      · intro r hr hnot
        rw [Finset.mem_Icc] at hr hnot
        split_ifs with hrm
        · have hmr_lt : m - r < j := by omega
          rw [hc_lt j (m - r) hmr_lt, mul_zero, mul_zero, mul_zero]
        · ring
    rw [Finset.sum_congr rfl hj_term, Finset.sum_comm]
    refine Finset.sum_congr rfl fun r hr => ?_
    dsimp only [W]
    rw [← Finset.mul_sum, ← Finset.mul_sum]
    congr 2
    have hIcc_top : Finset.Icc 1 (p - 1) = insert (p - 1) (Finset.Icc 1 (p - 2)) := by
      ext k
      simp only [Finset.mem_Icc, Finset.mem_insert]
      omega
    have hp1_not_mem : p - 1 ∉ Finset.Icc 1 (p - 2) := by simp; omega
    rw [hIcc_top, Finset.sum_insert hp1_not_mem]
    have hmr_lt : m - r < p - 1 := by
      rw [Finset.mem_Icc] at hr
      omega
    rw [hc_lt (p - 1) (m - r) hmr_lt, mul_zero, zero_add]
  have hmW_eq : ∀ m ∈ Finset.Icc 1 (p - 1), ((m : ℕ) : B) * W m = t_pow m := by
    intro m hm
    induction' m using Nat.strong_induction_on with m ih
    rw [hW_rec m hm, h_newton m hm]
    congr 1
    refine Finset.sum_congr rfl fun r hr => ?_
    rw [Finset.mem_Icc] at hr hm
    have hmr_lt : m - r < m := by omega
    have hmr_mem : m - r ∈ Finset.Icc 1 (p - 1) := by
      rw [Finset.mem_Icc]
      omega
    rw [ih (m - r) hmr_lt hmr_mem]
  refine ⟨c, hc_zero, hc_succ, hc_one_ge, hc_pow_split, ?_⟩
  have hswap : (∑ k ∈ Finset.Icc 1 (p - 1),
      ((k : ℕ) : B)⁻¹ * (∑ m ∈ Finset.Icc 1 (p - 1), c k m)) =
      ∑ m ∈ Finset.Icc 1 (p - 1), W m := by
    dsimp only [W]
    conv_lhs =>
      arg 2
      ext k
      rw [Finset.mul_sum]
    exact Finset.sum_comm
  rw [hswap]
  refine Finset.sum_congr rfl fun m hm => ?_
  have hm_ne : ((m : ℕ) : B) ≠ 0 := hj_ne0 m hm
  rw [← hmW_eq m hm, ← mul_assoc, inv_mul_cancel₀ hm_ne, one_mul]

theorem ld_ch12_wild_odd_upper_edge_conv_tail_and_cross_term_bound (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (B : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B]
    (p T q₁ q_B m_B : ℕ)
    (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (hT_ge2 : 2 ≤ T) (hq_B_ge1 : 1 ≤ q_B) (hq_B_le_q₁ : q_B ≤ q₁) (hq_B_le_m_B : q_B ≤ m_B)
    (h_filt : p * q_B ≤ q₁ + (p - 1) * T)
    (h_exp : p * (m_B - 1) + 1 ≤ p * q₁ + 2 * (p - 1) * (T - 1))
    (hj_ne0 : ∀ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : B) ≠ 0)
    (hj_inv_val : ∀ j ∈ Finset.Icc 1 (p - 1), valL F B (((j : ℕ) : B)⁻¹) = 0)
    (b t_pow : ℕ → B) (N_w : B)
    (h_newton : ∀ r ∈ Finset.Icc 1 (p - 1),
      t_pow r = ((r : ℕ) : B) * b r +
        ∑ l ∈ Finset.Icc 1 (r - 1), b l * t_pow (r - l))
    (hb_e1 : ∀ r ∈ Finset.Icc 1 (p - 1),
      b r = 0 ∨ (((q₁ + (p - 1) * T) / p : ℕ) : ℤ) ≤ valL F B (b r))
    (ht_e1 : ∀ r ∈ Finset.Icc 1 (p - 1),
      t_pow r = 0 ∨ (((q₁ + (p - 1) * T) / p : ℕ) : ℤ) ≤ valL F B (t_pow r))
    (hb_scaled : ∀ r ∈ Finset.Icc 1 (p - 1),
      b r = 0 ∨
        (r : ℤ) * (q₁ : ℤ) + ((p - 1 : ℕ) : ℤ) * ((T - 1 : ℕ) : ℤ) ≤
          (p : ℤ) * valL F B (b r))
    (hNw_val : N_w = 0 ∨ (q₁ : ℤ) ≤ valL F B N_w)
    (c : ℕ → ℕ → B)
    (hc_zero : ∀ m : ℕ, c 0 m = if m = 0 then 1 else 0)
    (hc_succ : ∀ (k m : ℕ),
      c (k + 1) m =
        ∑ r ∈ Finset.Icc 1 (p - 1), (if r ≤ m then b r * c k (m - r) else 0))
    (hc_one_ge : ∀ m : ℕ, p ≤ m → c 1 m = 0)
    (hc_pow_split : ∀ k ∈ Finset.Icc 1 (p - 1),
      (∑ r ∈ Finset.Icc 1 (p - 1), b r) ^ k =
        (∑ m ∈ Finset.Icc 1 (p - 1), c k m) +
          (∑ s ∈ Finset.range ((p - 1) * (p - 1)), c k (p + s)))
    (hW_eq :
      ∑ k ∈ Finset.Icc 1 (p - 1),
        ((k : ℕ) : B)⁻¹ * (∑ m ∈ Finset.Icc 1 (p - 1), c k m) =
        ∑ m ∈ Finset.Icc 1 (p - 1), ((m : ℕ) : B)⁻¹ * t_pow m) :
    let S := ∑ r ∈ Finset.Icc 1 (p - 1), b r
    let P_B := fun z : B => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : B)⁻¹ * z ^ j
    let E_val :=
      (∑ m ∈ Finset.Icc 1 (p - 1), ((m : ℕ) : B)⁻¹ * (t_pow m + N_w ^ m)) +
      (∑ j ∈ Finset.Icc 1 (p - 2), ∑ r ∈ Finset.Icc 1 (p - 1),
        ((r : ℕ) : B)⁻¹ * t_pow r * N_w ^ j)
    (S + N_w = 0 ∨ (q_B : ℤ) ≤ valL F B (S + N_w)) ∧
    (P_B (S + N_w) - E_val = 0 ∨ (m_B : ℤ) ≤ valL F B (P_B (S + N_w) - E_val)) :=
by
  have hvalB_core :
      valL F B 1 = 0 ∧
      (∀ x : B, valL F B (-x) = valL F B x) ∧
      (∀ x y : B, x ≠ 0 → y ≠ 0 → valL F B (x * y) = valL F B x + valL F B y) ∧
      (∀ (k : ℤ) (x y : B),
        (x = 0 ∨ k ≤ valL F B x) → (y = 0 ∨ k ≤ valL F B y) →
          (x + y = 0 ∨ k ≤ valL F B (x + y))) := by
    clear p T q₁ q_B m_B hPrime hp_odd hT_ge2 hq_B_ge1 hq_B_le_q₁ hq_B_le_m_B
      h_filt h_exp hj_ne0 hj_inv_val b t_pow N_w h_newton hb_e1 ht_e1 hb_scaled
      hNw_val c hc_zero hc_succ hc_one_ge hc_pow_split hW_eq
    have halg : ∀ z : B,
        minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
        ∃ m : ℕ,
          Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
          Module.finrank F B = (minpoly F z).natDegree * m := by
      clear ‹IsNonarchimedeanLocalField F› ‹TopologicalSpace F› ‹ValuativeRel F›
      intro z
      have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
        minpoly.algHom_eq B.val B.val.injective z
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
        IntermediateField.adjoin.powerBasis_gen hz
      have hmin_gen : minpoly F pb.gen = minpoly F z := by
        have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
          rw [hpb_gen]
          rfl
        rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
          (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
      have hpb_dim : pb.dim = (minpoly F z).natDegree := by
        rw [IntermediateField.adjoin.powerBasis_dim hz]
      have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
      rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
      refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
      rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
        b ≠ 0 ∧ addVal F b ≤ addVal F a := by
      intro a b ha hab
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
      have hφb : φ (valuation F b) ≠ 0 := by
        intro h0
        rw [h0] at hφ_le
        exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
      have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
      have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
      refine ⟨hb, ?_⟩
      rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
      unfold addVal
      rw [dif_neg ha, dif_neg hb]
      exact neg_le_neg hφ_le
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
      have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
      have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
      have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
      unfold addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
      intro a n ha
      have han : a ^ n ≠ 0 := pow_ne_zero n ha
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
      have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
      unfold addVal
      rw [dif_neg han, dif_neg ha]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
