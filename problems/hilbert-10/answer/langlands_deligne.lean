by
  set ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
  haveI : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
  haveI : NeZero ℓ := ⟨hPrime.ne_zero⟩
  
  have h_rec_lift : ∀ (A : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F A]
      (hLA : L ≤ A), IsAbelianExt F hLA →
      0 < Module.finrank L (IntermediateField.extendScalars hLA) →
      ∀ (νA : Lˣ →* (Ω F)ˣ),
        νA ^ ℓ = 1 →
        (∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLA)) ↔ νA x = 1) →
        ∃ μA : relWeil F L →* (Ω F)ˣ,
          IsWeilRep F L (charRep F L μA) ∧
          (∀ w : relWeil F L, (w : AbsGal F) ∈ A.fixingSubgroup ↔ μA w = 1) ∧
          μA ^ ℓ = 1 ∧
          (∀ x : Lˣ, νA x = μA (rec.recMap L x)) := by
    intro A _ hLA hAbLA hposLA νA hνA_pow hνA_ker
    haveI : Module.Finite L (IntermediateField.extendScalars hLA) :=
      Module.finite_of_finrank_pos hposLA
    have hrec_ker : ∀ x : Lˣ, (rec.recMap L x : AbsGal F) ∈ A.fixingSubgroup ↔ νA x = 1 := by
      intro x
      rw [rec.ker_rec L A hLA hAbLA x, ← hνA_ker x]
      refine ⟨?_, ?_⟩
      · rintro ⟨y, hy⟩
        have hy_ne : y ≠ 0 := by
          intro h0
          have hnorm0 : normLM F hLA y = 0 := by
            rw [h0]
            exact Algebra.norm_zero (R := L) (S := IntermediateField.extendScalars hLA)
          rw [hnorm0] at hy
          exact Units.ne_zero x hy.symm
        exact ⟨Units.mk0 y hy_ne, Units.ext hy⟩
      · rintro ⟨y, rfl⟩
        exact ⟨(y : A), rfl⟩
    choose xw hxw using rec.surj_rec L A hLA hAbLA
    have h_indep : ∀ (w : relWeil F L) (x : Lˣ),
        (((rec.recMap L x)⁻¹ * w : relWeil F L) : AbsGal F) ∈ A.fixingSubgroup →
        νA (xw w) = νA x := by
      intro w x hx
      set x₁ := xw w
      set x₂ := x
      have h1 : (((rec.recMap L x₁ : AbsGal F)⁻¹ * (w : AbsGal F)) *
          ((rec.recMap L x₂ : AbsGal F)⁻¹ * (w : AbsGal F))⁻¹) ∈ A.fixingSubgroup :=
        A.fixingSubgroup.mul_mem (hxw w) (A.fixingSubgroup.inv_mem hx)
      have h2 : ((rec.recMap L x₂ : AbsGal F)⁻¹ *
          ((rec.recMap L x₁ : AbsGal F) * (rec.recMap L (x₁⁻¹ * x₂) : AbsGal F))) ∈
          A.fixingSubgroup := by
        have hmul := rec.mul_rec L A hLA hAbLA x₁ (x₁⁻¹ * x₂)
        rw [mul_inv_cancel_left] at hmul
        exact hmul
      have h3 : (rec.recMap L (x₁⁻¹ * x₂) : AbsGal F) ∈ A.fixingSubgroup := by
        have hprod := A.fixingSubgroup.mul_mem h1 h2
        have heq : (((rec.recMap L x₁ : AbsGal F)⁻¹ * (w : AbsGal F)) *
            ((rec.recMap L x₂ : AbsGal F)⁻¹ * (w : AbsGal F))⁻¹) *
            ((rec.recMap L x₂ : AbsGal F)⁻¹ *
              ((rec.recMap L x₁ : AbsGal F) * (rec.recMap L (x₁⁻¹ * x₂) : AbsGal F))) =
            (rec.recMap L (x₁⁻¹ * x₂) : AbsGal F) := by
          group
        rwa [heq] at hprod
      have hν_triv : νA (x₁⁻¹ * x₂) = 1 := (hrec_ker (x₁⁻¹ * x₂)).mp h3
      rw [map_mul, map_inv, inv_mul_eq_one] at hν_triv
      exact hν_triv
    let μA : relWeil F L →* (Ω F)ˣ :=
      { toFun := fun w => νA (xw w)
        map_one' := by
          have h1_fix : (rec.recMap L 1 : AbsGal F) ∈ A.fixingSubgroup :=
            (hrec_ker 1).mpr (map_one νA)
          have h1_inv : (((rec.recMap L 1)⁻¹ * 1 : relWeil F L) : AbsGal F) ∈
              A.fixingSubgroup := by
            change (rec.recMap L 1 : AbsGal F)⁻¹ * 1 ∈ A.fixingSubgroup
            rw [mul_one]
            exact A.fixingSubgroup.inv_mem h1_fix
          rw [h_indep 1 1 h1_inv, map_one]
        map_mul' := fun w₁ w₂ => by
          set x₁ := xw w₁
          set x₂ := xw w₂
          have hm1 : (((rec.recMap L (x₁ * x₂))⁻¹ * (rec.recMap L x₁ * rec.recMap L x₂) :
              relWeil F L) : AbsGal F) ∈ A.fixingSubgroup :=
            rec.mul_rec L A hLA hAbLA x₁ x₂
          have hm2 : (rec.recMap L x₂ : AbsGal F)⁻¹ *
              (((rec.recMap L x₁)⁻¹ * w₁ : relWeil F L) : AbsGal F) *
              ((rec.recMap L x₂ : AbsGal F)⁻¹)⁻¹ ∈ A.fixingSubgroup :=
            hAbLA.1 (rec.recMap L x₂ : AbsGal F)⁻¹
              (L.fixingSubgroup.inv_mem (rec.recMap L x₂).2.2) _ (hxw w₁)
          have hm3 : (((rec.recMap L x₂)⁻¹ * w₂ : relWeil F L) : AbsGal F) ∈
              A.fixingSubgroup :=
            hxw w₂
          have h_prod : (((rec.recMap L (x₁ * x₂))⁻¹ * (w₁ * w₂) : relWeil F L) : AbsGal F) ∈
              A.fixingSubgroup := by
            have h_eq : (((rec.recMap L (x₁ * x₂))⁻¹ * (w₁ * w₂) : relWeil F L) : AbsGal F) =
                (((rec.recMap L (x₁ * x₂))⁻¹ * (rec.recMap L x₁ * rec.recMap L x₂) :
                  relWeil F L) : AbsGal F) *
                ((rec.recMap L x₂ : AbsGal F)⁻¹ *
                  (((rec.recMap L x₁)⁻¹ * w₁ : relWeil F L) : AbsGal F) *
                  ((rec.recMap L x₂ : AbsGal F)⁻¹)⁻¹) *
                (((rec.recMap L x₂)⁻¹ * w₂ : relWeil F L) : AbsGal F) := by
              change (rec.recMap L (x₁ * x₂) : AbsGal F)⁻¹ * ((w₁ : AbsGal F) * (w₂ : AbsGal F)) =
                ((rec.recMap L (x₁ * x₂) : AbsGal F)⁻¹ *
                  ((rec.recMap L x₁ : AbsGal F) * (rec.recMap L x₂ : AbsGal F))) *
                ((rec.recMap L x₂ : AbsGal F)⁻¹ *
                  ((rec.recMap L x₁ : AbsGal F)⁻¹ * (w₁ : AbsGal F)) *
                  ((rec.recMap L x₂ : AbsGal F)⁻¹)⁻¹) *
                ((rec.recMap L x₂ : AbsGal F)⁻¹ * (w₂ : AbsGal F))
              group
            rw [h_eq]
            exact A.fixingSubgroup.mul_mem (A.fixingSubgroup.mul_mem hm1 hm2) hm3
          rw [h_indep (w₁ * w₂) (x₁ * x₂) h_prod, map_mul] }
    have hνA_rec : ∀ x : Lˣ, νA x = μA (rec.recMap L x) := by
      intro x
      have h_triv : (((rec.recMap L x)⁻¹ * rec.recMap L x : relWeil F L) : AbsGal F) ∈
          A.fixingSubgroup := by
        rw [inv_mul_cancel]
        exact A.fixingSubgroup.one_mem
      exact (h_indep (rec.recMap L x) x h_triv).symm
    have hμA_ker : ∀ w : relWeil F L, (w : AbsGal F) ∈ A.fixingSubgroup ↔ μA w = 1 := by
      intro w
      change (w : AbsGal F) ∈ A.fixingSubgroup ↔ νA (xw w) = 1
      rw [← hrec_ker (xw w)]
      have hdiff : ((rec.recMap L (xw w) : AbsGal F)⁻¹ * (w : AbsGal F)) ∈ A.fixingSubgroup :=
        hxw w
      refine ⟨fun hw => ?_, fun hrec => ?_⟩
      · have h1 := A.fixingSubgroup.mul_mem hw (A.fixingSubgroup.inv_mem hdiff)
        have heq : (w : AbsGal F) * ((rec.recMap L (xw w) : AbsGal F)⁻¹ * (w : AbsGal F))⁻¹ =
            (rec.recMap L (xw w) : AbsGal F) := by
          group
        rwa [heq] at h1
      · have h1 := A.fixingSubgroup.mul_mem hrec hdiff
        have heq : (rec.recMap L (xw w) : AbsGal F) *
            ((rec.recMap L (xw w) : AbsGal F)⁻¹ * (w : AbsGal F)) = (w : AbsGal F) := by
          group
        rwa [heq] at h1
    have hμA_pow : μA ^ ℓ = 1 := by
      apply MonoidHom.ext
      intro w
      change (νA (xw w)) ^ ℓ = 1
      rw [← MonoidHom.pow_apply, hνA_pow, MonoidHom.one_apply]
    have hμA_weil : IsWeilRep F L (charRep F L μA) := by
      refine ⟨inferInstance, (A.fixingSubgroup : Set (AbsGal F)),
        (krullTopology_mem_nhds_one_iff F (AlgebraicClosure F)
          (A.fixingSubgroup : Set (AbsGal F))).mpr ⟨A, inferInstance, Set.Subset.rfl⟩,
        fun w hwA _ => ?_⟩
      have h1 : μA w = 1 := (hμA_ker w).mp hwA
      apply LinearMap.ext
      intro v
      change (μA w : Ω F) • v = v
      rw [h1, Units.val_one, one_smul]
    exact ⟨μA, hμA_weil, hμA_ker, hμA_pow, hνA_rec⟩
  obtain ⟨μE, hμE_weil, hμE_ker, hμE_pow, hνE_rec⟩ :=
    h_rec_lift E hLE hAbLE hPrime.pos νE hνE_pow hνE_ker
  obtain ⟨μM₁, hμM₁_weil, hμM₁_ker, hμM₁_pow, hνM₁_rec⟩ :=
    h_rec_lift M₁ hLM₁ hAbLM₁ (hdegM₁.symm ▸ hPrime.pos) νM₁ hνM₁_pow hνM₁_ker
  
  have hFin_sub : ∀ {B : IntermediateField F (AlgebraicClosure F)},
      B ≤ K₁ → FiniteDimensional F B :=
    fun hBK₁ => Module.Finite.of_injective (IntermediateField.inclusion hBK₁).toLinearMap
      (IntermediateField.inclusion hBK₁).injective
  have hLK₁ : L ≤ K₁ := hLE.trans hEK₁
  have hSepLK₁ : Algebra.IsSeparable L (IntermediateField.extendScalars hLK₁) :=
    hGalLK₁.2.2.2 hLK₁
  have hSep_sub : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (hLA : L ≤ A) (hAB : A ≤ B) (hBK₁ : B ≤ K₁),
      Algebra.IsSeparable A (IntermediateField.extendScalars hAB) := by
    intro A B hLA hAB hBK₁
    refine ⟨fun x => ?_⟩
    let B_A := IntermediateField.extendScalars hAB
    let K_L := IntermediateField.extendScalars hLK₁
    have hxB : (x : AlgebraicClosure F) ∈ B := (IntermediateField.mem_extendScalars hAB).mp x.2
    let x_K : K_L := ⟨x.1, (IntermediateField.mem_extendScalars hLK₁).mpr (hBK₁ hxB)⟩
    have hsep_xK : IsSeparable L x_K := Algebra.IsSeparable.isSeparable L x_K
    have hmin_KL : minpoly L (x : AlgebraicClosure F) = minpoly L x_K :=
      minpoly.algHom_eq K_L.val K_L.val.injective x_K
    have hsep_L_bar : IsSeparable L (x : AlgebraicClosure F) := by
      change (minpoly L (x : AlgebraicClosure F)).Separable
      rw [hmin_KL]
      exact hsep_xK
    have hsep_A_bar : IsSeparable A (x : AlgebraicClosure F) :=
      IsSeparable.tower_top (↥(IntermediateField.extendScalars hLA)) hsep_L_bar
    have hmin_BA : minpoly A (x : AlgebraicClosure F) = minpoly A x :=
      minpoly.algHom_eq B_A.val B_A.val.injective x
    change (minpoly A x).Separable
    rw [← hmin_BA]
    exact hsep_A_bar
  have hFinrank_tower : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      [FiniteDimensional F A] [FiniteDimensional F B] (hAB : A ≤ B),
      Module.finrank F A * Module.finrank A (IntermediateField.extendScalars hAB) =
        Module.finrank F B := by
    intro A B _ _ hAB
    haveI : FiniteDimensional F (IntermediateField.extendScalars hAB) := ‹FiniteDimensional F B›
    haveI : IsScalarTower F A (IntermediateField.extendScalars hAB) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact Module.finrank_mul_finrank F A (IntermediateField.extendScalars hAB)
  have h_tower_finrank : ∀ (L₀ A₀ K₀ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F L₀] [FiniteDimensional F K₀]
      (hLK₀ : L₀ ≤ K₀) (hLA₀ : L₀ ≤ A₀) (hAK₀ : A₀ ≤ K₀),
      Module.finrank L₀ (IntermediateField.extendScalars hLA₀) *
        Module.finrank A₀ (IntermediateField.extendScalars hAK₀) =
        Module.finrank L₀ (IntermediateField.extendScalars hLK₀) ∧
      0 < Module.finrank L₀ (IntermediateField.extendScalars hLA₀) ∧
      Module.finrank F L₀ * Module.finrank L₀ (IntermediateField.extendScalars hLA₀) =
        Module.finrank F A₀ := by
    intro L₀ A₀ K₀ hFinL₀ hFinK₀ hLK₀ hLA₀ hAK₀
    haveI : FiniteDimensional F A₀ :=
      Module.Finite.of_injective (IntermediateField.inclusion hAK₀).toLinearMap
        (IntermediateField.inclusion hAK₀).injective
    have hF_LK := hFinrank_tower hLK₀
    have hF_LA := hFinrank_tower hLA₀
    have hF_AK := hFinrank_tower hAK₀
    have hF_pos : 0 < Module.finrank F L₀ := Module.finrank_pos
    haveI : FiniteDimensional F (IntermediateField.extendScalars hLA₀) := ‹FiniteDimensional F A₀›
    haveI : IsScalarTower F L₀ (IntermediateField.extendScalars hLA₀) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional L₀ (IntermediateField.extendScalars hLA₀) :=
      Module.Finite.of_restrictScalars_finite F L₀ (IntermediateField.extendScalars hLA₀)
    refine ⟨?_, Module.finrank_pos, hF_LA⟩
    apply Nat.eq_of_mul_eq_mul_left hF_pos
    rw [← mul_assoc, hF_LA, hF_AK, hF_LK]
  have helper_isGalois : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar] [Algebra k Ω_bar]
      [Normal k Ω_bar] (K₀ : IntermediateField k Ω_bar) [hSepK₀ : Algebra.IsSeparable k K₀],
      (∀ (σ τ : Ω_bar ≃ₐ[k] Ω_bar), (∀ x ∈ K₀, τ x = x) → ∀ x ∈ K₀, (σ * τ * σ⁻¹) x = x) →
      IsGalois k K₀ := by
    intro k Ω_bar _ _ _ _ K₀ hSepK₀ h_norm_fix
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK₀N : K₀ ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K₀ := ⟨z, hz⟩
      have hx : IsSeparable k x := @Algebra.IsSeparable.isSeparable k K₀ _ _ _ hSepK₀ x
      have hmin : minpoly k z = minpoly k x := minpoly.algHom_eq K₀.val K₀.val.injective x
      change (minpoly k z).Separable
      rw [hmin]
      exact hx
    let K_N : IntermediateField k N := K₀.comap N.val
    have hKN_map : K_N.map N.val = K₀ := by
      ext z
      refine ⟨?_, fun hz => ⟨⟨z, hK₀N hz⟩, hz, rfl⟩⟩
      rintro ⟨y, hy, rfl⟩
      exact hy
    have hKN_norm : K_N.fixingSubgroup.Normal := by
      refine ⟨fun h hh g => ?_⟩
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar g
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar h
      rw [IntermediateField.mem_fixingSubgroup_iff] at hh ⊢
      have hτ_fix : ∀ x ∈ K₀, τ x = x := by
        intro x hx
        let z : N := ⟨x, hK₀N hx⟩
        have hz : (AlgEquiv.restrictNormalHom ↥N τ) z = z := hh z hx
        have h1 : (((AlgEquiv.restrictNormalHom ↥N τ) z : ↥N) : Ω_bar) = x := congrArg Subtype.val hz
        rwa [AlgEquiv.restrictNormalHom_apply] at h1
      intro y hy
      apply Subtype.ext
      rw [← map_inv, ← map_mul, ← map_mul]
      change ((AlgEquiv.restrictNormalHom N (σ * τ * σ⁻¹) y : N) : Ω_bar) = y.1
      rw [AlgEquiv.restrictNormalHom_apply]
      exact h_norm_fix σ τ hτ_fix y.1 hy
    haveI : K_N.fixingSubgroup.Normal := hKN_norm
    haveI : IsGalois k K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  have hIsGalois_of_ext : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (hAB : A ≤ B), IsGaloisExt F A B → IsGalois A (IntermediateField.extendScalars hAB) := by
    intro A B hAB hGalAB
    let B' := IntermediateField.extendScalars hAB
    haveI : Algebra.IsSeparable A B' := hGalAB.2.2.2 hAB
    haveI : Normal A (AlgebraicClosure F) := Normal.tower_top_of_normal F A (AlgebraicClosure F)
    refine helper_isGalois A (AlgebraicClosure F) B' ?_
    intro σ τ hτ
    let σ_F : A.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv A).symm σ
    let τ_F : A.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv A).symm τ
    have hτB : τ_F.1 ∈ B.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      exact hτ x ((IntermediateField.mem_extendScalars hAB).mpr hx)
    have hconjB : (σ_F * τ_F * σ_F⁻¹).1 ∈ B.fixingSubgroup :=
      hGalAB.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτB
    intro x hx
    rw [IntermediateField.mem_fixingSubgroup_iff] at hconjB
    exact hconjB x ((IntermediateField.mem_extendScalars hAB).mp hx)
  let K₁' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK₁
  let G := (K₁' ≃ₐ[L] K₁')
  haveI : FiniteDimensional F K₁' := ‹FiniteDimensional F K₁›
  haveI : IsScalarTower F L K₁' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L K₁' := Module.Finite.of_restrictScalars_finite F L K₁'
  haveI : Algebra.IsSeparable L K₁' := hSepLK₁
  haveI : IsGalois L K₁' := hIsGalois_of_ext hLK₁ hGalLK₁
  haveI : Normal L K₁' := IsGalois.to_normal
  haveI : Normal L (AlgebraicClosure F) := Normal.tower_top_of_normal F L (AlgebraicClosure F)
  letI : Fintype G := AlgEquiv.fintype L K₁'
  let π : relWeil F L →* G :=
    (AlgEquiv.restrictNormalHom K₁').comp
      ((IntermediateField.fixingSubgroupEquiv L).toMonoidHom.comp
        (Subgroup.inclusion (inf_le_right : relWeil F L ≤ L.fixingSubgroup)))
  have hπ : ∀ (w : relWeil F L) (x : K₁'),
      ((π w x : K₁') : AlgebraicClosure F) = (w : AbsGal F) (x : AlgebraicClosure F) := by
    intro w x
    change ((AlgEquiv.restrictNormalHom K₁'
      ((IntermediateField.fixingSubgroupEquiv L) ⟨w.1, w.2.2⟩) x : K₁') : AlgebraicClosure F) =
      (w : AbsGal F) (x : AlgebraicClosure F)
    rw [AlgEquiv.restrictNormalHom_apply]
    rfl
  let H_K₁L : Subgroup (relWeil F L) := (relWeil F K₁).subgroupOf (relWeil F L)
  let bar_π : (relWeil F L ⧸ H_K₁L) → G := fun u => π (cosetRep u)
  have h_ker_π : ∀ w : relWeil F L, π w = 1 → w ∈ H_K₁L := by
    intro w hw
    rw [Subgroup.mem_subgroupOf]
    refine Subgroup.mem_inf.mpr ⟨w.2.1, ?_⟩
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro z hz
    let x : K₁' := ⟨z, (IntermediateField.mem_extendScalars hLK₁).mpr hz⟩
    have h1 := hπ w x
    rw [hw] at h1
    exact h1.symm
  have hbar_π_inj : Function.Injective bar_π := by
    intro u₁ u₂ h_eq
    change π (cosetRep u₁) = π (cosetRep u₂) at h_eq
    have h1 : π ((cosetRep u₁)⁻¹ * cosetRep u₂) = 1 := by
      rw [map_mul, map_inv, h_eq, inv_mul_cancel]
    have h2 : (cosetRep u₁)⁻¹ * cosetRep u₂ ∈ H_K₁L := h_ker_π _ h1
    have h3 : (QuotientGroup.mk (cosetRep u₁) : relWeil F L ⧸ H_K₁L) =
        QuotientGroup.mk (cosetRep u₂) := QuotientGroup.eq.mpr h2
    have h_out1 : (QuotientGroup.mk (cosetRep u₁) : relWeil F L ⧸ H_K₁L) = u₁ :=
      Quotient.out_eq u₁
    have h_out2 : (QuotientGroup.mk (cosetRep u₂) : relWeil F L ⧸ H_K₁L) = u₂ :=
      Quotient.out_eq u₂
    rw [h_out1, h_out2] at h3
    exact h3
  obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
  obtain ⟨hFin_quot, hCard_quot⟩ :=
    ld_relWeil_quotient_card_eq_finrank F hp hFrob L K₁ hLK₁ hSepLK₁
  letI : Finite (relWeil F L ⧸ H_K₁L) := hFin_quot
  letI : Fintype (relWeil F L ⧸ H_K₁L) := Fintype.ofFinite (relWeil F L ⧸ H_K₁L)
  have h_card_eq : Fintype.card (relWeil F L ⧸ H_K₁L) = Fintype.card G := by
    rw [← Nat.card_eq_fintype_card, hCard_quot, ← IsGalois.card_aut_eq_finrank L K₁',
      Nat.card_eq_fintype_card]
  have hbar_π_bij : Function.Bijective bar_π :=
    (Fintype.bijective_iff_injective_and_card bar_π).mpr ⟨hbar_π_inj, h_card_eq⟩
  have hsurj : Function.Surjective π := by
    intro g
    obtain ⟨u, hu⟩ := hbar_π_bij.2 g
    exact ⟨cosetRep u, hu⟩
  let toSub : ∀ (A : IntermediateField F (AlgebraicClosure F)), L ≤ A → IntermediateField L K₁' :=
    fun A hLA => (IntermediateField.extendScalars hLA).comap K₁'.val
  let fieldOf : Subgroup G → IntermediateField F (AlgebraicClosure F) :=
    fun M => (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F
  have h_mem_toSub : ∀ (A : IntermediateField F (AlgebraicClosure F)) (hLA : L ≤ A) (y : K₁'),
      y ∈ toSub A hLA ↔ y.1 ∈ A :=
    fun A hLA _ => IntermediateField.mem_extendScalars hLA
  have h_toSub_le : ∀ (A₁ A₂ : IntermediateField F (AlgebraicClosure F))
      (hLA₁ : L ≤ A₁) (hA₁K : A₁ ≤ K₁) (hLA₂ : L ≤ A₂),
      toSub A₁ hLA₁ ≤ toSub A₂ hLA₂ ↔ A₁ ≤ A₂ := by
    intro A₁ A₂ hLA₁ hA₁K hLA₂
    constructor
    · intro hle x hx
      have hy : (⟨x, (IntermediateField.mem_extendScalars hLK₁).mpr (hA₁K hx)⟩ : K₁') ∈
          toSub A₁ hLA₁ :=
        (h_mem_toSub A₁ hLA₁ _).mpr hx
      exact (h_mem_toSub A₂ hLA₂ _).mp (hle hy)
    · intro hle y hy
      exact (h_mem_toSub A₂ hLA₂ y).mpr (hle ((h_mem_toSub A₁ hLA₁ y).mp hy))
  have h_toSub_eq : ∀ (A₁ A₂ : IntermediateField F (AlgebraicClosure F))
      (hLA₁ : L ≤ A₁) (hA₁K : A₁ ≤ K₁) (hLA₂ : L ≤ A₂) (hA₂K : A₂ ≤ K₁),
      toSub A₁ hLA₁ = toSub A₂ hLA₂ ↔ A₁ = A₂ := by
    intro A₁ A₂ hLA₁ hA₁K hLA₂ hA₂K
    rw [le_antisymm_iff, le_antisymm_iff, h_toSub_le A₁ A₂ hLA₁ hA₁K hLA₂,
      h_toSub_le A₂ A₁ hLA₂ hA₂K hLA₁]
  have hL_fieldOf : ∀ M : Subgroup G, L ≤ fieldOf M := by
    intro M z hz
    rw [IntermediateField.mem_restrictScalars]
    exact (IntermediateField.lift (IntermediateField.fixedField M)).algebraMap_mem ⟨z, hz⟩
  have h_fieldOf_le_K : ∀ M : Subgroup G, fieldOf M ≤ K₁ := by
    intro M z hz
    rw [IntermediateField.mem_restrictScalars] at hz
    exact (IntermediateField.mem_extendScalars hLK₁).mp
      (IntermediateField.lift_le (IntermediateField.fixedField M) hz)
  have h_mem_fieldOf : ∀ (M : Subgroup G) (x : K₁'),
      (x : AlgebraicClosure F) ∈ fieldOf M ↔ x ∈ IntermediateField.fixedField M := by
    intro M x
    exact (IntermediateField.mem_restrictScalars F).trans (IntermediateField.mem_lift x)
  have h_toSub_fieldOf : ∀ M : Subgroup G,
      toSub (fieldOf M) (hL_fieldOf M) = IntermediateField.fixedField M := by
    intro M
    ext x
    exact (h_mem_toSub (fieldOf M) (hL_fieldOf M) x).trans (h_mem_fieldOf M x)
  have h_fixing_toSub_fieldOf : ∀ M : Subgroup G,
      (toSub (fieldOf M) (hL_fieldOf M)).fixingSubgroup = M := by
    intro M
    rw [h_toSub_fieldOf M, IntermediateField.fixingSubgroup_fixedField M]
  have h_fieldOf_fixing : ∀ (A : IntermediateField F (AlgebraicClosure F))
      (hLA : L ≤ A) (hAK : A ≤ K₁),
      fieldOf ((toSub A hLA).fixingSubgroup) = A := by
    intro A hLA hAK
    apply (h_toSub_eq (fieldOf ((toSub A hLA).fixingSubgroup)) A
      (hL_fieldOf _) (h_fieldOf_le_K _) hLA hAK).mp
    rw [h_toSub_fieldOf, IsGalois.fixedField_fixingSubgroup (toSub A hLA)]
  have h_le_iff : ∀ M₁' M₂' : Subgroup G, fieldOf M₁' ≤ fieldOf M₂' ↔ M₂' ≤ M₁' := by
    intro M₁' M₂'
    constructor
    · intro hle
      have h1 : toSub (fieldOf M₁') (hL_fieldOf M₁') ≤ toSub (fieldOf M₂') (hL_fieldOf M₂') :=
        (h_toSub_le (fieldOf M₁') (fieldOf M₂')
          (hL_fieldOf M₁') (h_fieldOf_le_K M₁') (hL_fieldOf M₂')).mpr hle
      have h2 := IntermediateField.fixingSubgroup_le h1
      rwa [h_fixing_toSub_fieldOf M₁', h_fixing_toSub_fieldOf M₂'] at h2
    · intro hle
      have h1 : IntermediateField.fixedField M₁' ≤ IntermediateField.fixedField M₂' :=
        IntermediateField.fixedField_antitone hle
      rw [← h_toSub_fieldOf M₁', ← h_toSub_fieldOf M₂'] at h1
      exact (h_toSub_le (fieldOf M₁') (fieldOf M₂')
        (hL_fieldOf M₁') (h_fieldOf_le_K M₁') (hL_fieldOf M₂')).mp h1
  have h_eq_iff : ∀ M₁' M₂' : Subgroup G, fieldOf M₁' = fieldOf M₂' ↔ M₁' = M₂' := by
    intro M₁' M₂'
    rw [le_antisymm_iff, h_le_iff M₁' M₂', h_le_iff M₂' M₁', and_comm, ← le_antisymm_iff]
  have h_inf_eq_sup : ∀ M₁' M₂' : Subgroup G, fieldOf (M₁' ⊓ M₂') = fieldOf M₁' ⊔ fieldOf M₂' := by
    intro M₁' M₂'
    apply le_antisymm
    · let A := fieldOf M₁' ⊔ fieldOf M₂'
      have hLA : L ≤ A := (hL_fieldOf M₁').trans le_sup_left
      have hAK : A ≤ K₁ := sup_le (h_fieldOf_le_K M₁') (h_fieldOf_le_K M₂')
      let M_A := (toSub A hLA).fixingSubgroup
      have hA : fieldOf M_A = A := h_fieldOf_fixing A hLA hAK
      have h1 : M_A ≤ M₁' := (h_le_iff M₁' M_A).mp (hA.symm ▸ le_sup_left)
      have h2 : M_A ≤ M₂' := (h_le_iff M₂' M_A).mp (hA.symm ▸ le_sup_right)
      have hinf : M_A ≤ M₁' ⊓ M₂' := le_inf h1 h2
      have h_le : fieldOf (M₁' ⊓ M₂') ≤ fieldOf M_A := (h_le_iff (M₁' ⊓ M₂') M_A).mpr hinf
      rwa [hA] at h_le
    · exact sup_le ((h_le_iff _ _).mpr inf_le_left) ((h_le_iff _ _).mpr inf_le_right)
  have h_mem_fixing : ∀ (A : IntermediateField F (AlgebraicClosure F))
      (hLA : L ≤ A) (hAK : A ≤ K₁) (w : relWeil F L),
      (w : AbsGal F) ∈ A.fixingSubgroup ↔ π w ∈ (toSub A hLA).fixingSubgroup := by
    intro A hLA hAK w
    rw [IntermediateField.mem_fixingSubgroup_iff, IntermediateField.mem_fixingSubgroup_iff]
