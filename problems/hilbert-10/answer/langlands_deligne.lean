            (x₀ ^ q) * (normLM F hLE (1 + δ_E) - 1) := by
        conv_lhs => rw [hy₀_eq, map_mul, hnorm_inc L E hLE x₀, hFinE_eq]
        ring
      have hx₀_pow_val0 : valL F L (x₀ ^ q) = 0 := by
        rw [hval_pow L x₀ q hx₀_ne, hx₀_val0, mul_zero]
      rw [hnorm_diff]
      have h := hval_mul_ge L 0 1 (x₀ ^ q) (normLM F hLE (1 + δ_E) - 1)
        (Or.inr (by rw [hx₀_pow_val0])) (hStab1_EL δ_E hδ_E)
      simpa using h

  · 
    intro hsub y hy
    let v : ℕ := k * (a - 1)
