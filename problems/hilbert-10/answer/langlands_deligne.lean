            ((u_zδ ^ q)⁻¹ * (u_ω ^ q)⁻¹ * (ι u_TE) ^ q) =
            (u_ω ^ q)⁻¹ * (C1_M⁻¹ * (ι c₁)⁻¹ * ι (ϖ_L ^ m_E) * (ι u_TE) ^ q) := by
        calc ((u_zδ ^ q) * C1_M⁻¹ * (ι c₁)⁻¹ * ι (ϖ_L ^ m_E)) *
              ((u_zδ ^ q)⁻¹ * (u_ω ^ q)⁻¹ * (ι u_TE) ^ q)
            = (C1_M⁻¹ * (ι c₁)⁻¹ * ι (ϖ_L ^ m_E) * (u_zδ ^ q)) *
                ((u_zδ ^ q)⁻¹ * ((u_ω ^ q)⁻¹ * (ι u_TE) ^ q)) := by
                dsimp only [ι, C1_M, c₁, q]; ac_rfl
          _ = C1_M⁻¹ * (ι c₁)⁻¹ * ι (ϖ_L ^ m_E) *
                ((u_zδ ^ q) * ((u_zδ ^ q)⁻¹ * ((u_ω ^ q)⁻¹ * (ι u_TE) ^ q))) := by
                dsimp only [ι, C1_M, c₁, q]; ac_rfl
          _ = C1_M⁻¹ * (ι c₁)⁻¹ * ι (ϖ_L ^ m_E) * ((u_ω ^ q)⁻¹ * (ι u_TE) ^ q) := by
                rw [mul_inv_cancel_left]
          _ = (u_ω ^ q)⁻¹ * (C1_M⁻¹ * (ι c₁)⁻¹ * ι (ϖ_L ^ m_E) * (ι u_TE) ^ q) := by
                dsimp only [ι, C1_M, c₁, q]; ac_rfl
      rw [mul_assoc (P_all * (ι (u_α ^ q))⁻¹ * (u_ω ^ q)), h_cancel_zδ,
        mul_assoc (P_all * (ι (u_α ^ q))⁻¹) (u_ω ^ q), mul_inv_cancel_left]
      dsimp only [ι, P_all, C1_M, c₁, q]
      ac_rfl
    have hι_mem : ι U_target ∈ unitGroup F M_C 1 := by
      rw [hι_target]
      exact Subgroup.mul_mem (unitGroup F M_C 1)
        (Subgroup.mul_mem (unitGroup F M_C 1) hVieta
          (Subgroup.inv_mem (unitGroup F M_C 1) hNorm_δ_cong))
        (Subgroup.pow_mem (unitGroup F M_C 1) hTE_cong q)
    change U_target ∈ unitGroup F L 1
    rw [hunit_ge1_L 1 le_rfl]
    rw [hunit_ge1_MC 1 le_rfl] at hι_mem
    rcases hι_mem with h1 | hge1
    · left
      apply (IntermediateField.inclusion hLM_C).injective
      rw [map_one]
      exact h1
    · right
      have hsub : ((ι U_target : M_Cˣ) : M_C) - 1 =
          IntermediateField.inclusion hLM_C ((U_target : L) - 1) := by
        rw [map_sub, map_one]
        rfl
      rw [hsub, hValAlgMCL ((U_target : L) - 1)] at hge1
      change (1 : ℤ) ≤ (k : ℤ) * valL F L ((U_target : L) - 1) at hge1
      change (1 : ℤ) ≤ valL F L ((U_target : L) - 1)
      have hk_pos : (0 : ℤ) < (k : ℤ) := by exact_mod_cast hk_ge1
      nlinarith
  have hc_E_psi : ∀ y₀ : E, (y₀ = 0 ∨ 0 ≤ valL F E y₀) →
      ∀ x₀ : L, (x₀ = 0 ∨ 0 ≤ valL F L x₀) →
        (y₀ - IntermediateField.inclusion hLE x₀ = 0 ∨
          1 ≤ valL F E (y₀ - IntermediateField.inclusion hLE x₀)) →
        ψ_E (((c_E⁻¹ : Eˣ) : E) * y₀) =
          ψ (((c₁⁻¹ : Lˣ) : L) * (x₀ ^ q)) := by
    intro y₀ _ x₀ hx₀ hyx
    let r_E : E := y₀ - IntermediateField.inclusion hLE x₀
    have hy_split : y₀ = IntermediateField.inclusion hLE x₀ + r_E := by
      dsimp only [r_E]
      ring
    have hc_E_inv :
        c_E⁻¹ =
          Units.map (IntermediateField.inclusion hLE).toMonoidHom (c₁⁻¹ * v₀⁻¹) * κ_E := by
      let ι_E : Lˣ →* Eˣ := Units.map (IntermediateField.inclusion hLE).toMonoidHom
      change (w_E * ι_E v₀)⁻¹ = ι_E (c₁⁻¹ * v₀⁻¹) * (ι_E c₁ * w_E⁻¹)
      rw [mul_comm c₁⁻¹ v₀⁻¹, map_mul ι_E v₀⁻¹ c₁⁻¹, map_inv ι_E v₀, map_inv ι_E c₁,
        mul_assoc (ι_E v₀)⁻¹, inv_mul_cancel_left (ι_E c₁) w_E⁻¹, ← mul_inv_rev w_E (ι_E v₀)]
    have hv₀_uTE : ((v₀⁻¹ : Lˣ) : L) * (u_TE : L) = (u_α : L) := by
      have h_unit : v₀⁻¹ * u_TE = u_α := by
        dsimp only [v₀]
        rw [mul_inv_rev, inv_inv, inv_mul_cancel_right]
      exact congrArg (fun u : Lˣ => (u : L)) h_unit
    let R_E : L := traceLM F hLE ((κ_E : E) * r_E)
    have htr_y :
        traceLM F hLE (((c_E⁻¹ : Eˣ) : E) * y₀) =
          (((c₁⁻¹ : Lˣ) : L) * ((u_α : L) * x₀)) +
            (((c₁⁻¹ * v₀⁻¹ : Lˣ) : L) * R_E) := by
      have hmul_y :
          ((c_E⁻¹ : Eˣ) : E) * y₀ =
            IntermediateField.inclusion hLE ((c₁⁻¹ * v₀⁻¹ : Lˣ) : L) *
              ((κ_E : E) * IntermediateField.inclusion hLE x₀ + (κ_E : E) * r_E) := by
        rw [hc_E_inv, hy_split, Units.val_mul, hcoe_inc_unit L E hLE (c₁⁻¹ * v₀⁻¹)]
        ring
      have htr_x :
          traceLM F hLE ((κ_E : E) * IntermediateField.inclusion hLE x₀) =
            (u_TE : L) * x₀ := by
        rw [mul_comm (κ_E : E) (IntermediateField.inclusion hLE x₀),
          htrace_smul L E hLE x₀ (κ_E : E), mul_comm x₀]
        rfl
      rw [hmul_y, htrace_smul L E hLE ((c₁⁻¹ * v₀⁻¹ : Lˣ) : L),
        map_add, htr_x]
      dsimp only [R_E]
      rw [mul_add, Units.val_mul, ← mul_assoc (((c₁⁻¹ : Lˣ) : L) * ((v₀⁻¹ : Lˣ) : L)),
        mul_assoc ((c₁⁻¹ : Lˣ) : L) ((v₀⁻¹ : Lˣ) : L) (u_TE : L), hv₀_uTE, mul_assoc]
    have hψ_rem : ψ (((c₁⁻¹ * v₀⁻¹ : Lˣ) : L) * R_E) = 1 := by
      apply hψ_triv
      rcases hRem_tr r_E hyx with hR0 | hR_ge1
      · left
        dsimp only [R_E]
        rw [hR0, mul_zero]
      · by_cases hR0 : R_E = 0
        · left
          rw [hR0, mul_zero]
        · right
          rw [hval_mul_L _ _ (Units.ne_zero _) hR0,
            hval_unit_mul L c₁⁻¹ v₀⁻¹, hval_unit_inv L c₁, hval_unit_inv L v₀,
            hc₁_val, hv₀_val]
          change 1 ≤ valL F L R_E at hR_ge1
          linarith
    change ψ (traceLM F hLE (((c_E⁻¹ : Eˣ) : E) * y₀)) = _
    rw [htr_y, AddChar.map_add_eq_mul, hψ_rem, mul_one, hu_α_frob x₀ hx₀]
  exact ⟨c_E, hc_E_val, hc_E_norm, hc_E_psi⟩

theorem ld_ch14_higher_cond_resDeg_exponent_balance (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M_C K E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hM_CK : M_C ≤ K) (hLE : L ≤ E)
    (ψ : AddChar L (Ω F))
    (D_orb : List (MonomialTerm F L))
    (hDegSum : (∑ i : Fin D_orb.length,
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (hresE : resDeg F E = resDeg F L)
    (t k : ℕ) (hk_ge1 : 1 ≤ k)
    (hk_dvd : k ∣ (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1))
    (hFi_deg : ∀ i : Fin D_orb.length,
      condExp F (D_orb.get i).field (μ'_orb i) = t + 1 ∧
      ∃ f_i : ℕ,
        Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_i ∧
        resDeg F (D_orb.get i).field = f_i * resDeg F L) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let a := condExp F L χ'
    let χ'_E := χ'.comp (Units.map (normLM F hLE))
    let ψ_E := traceChar F hLE ψ
    let θ_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ :=
      fun i => μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
    ((condExp F E χ'_E = a ∧ ∀ i : Fin D_orb.length, condExp F (D_orb.get i).field (θ_orb i) = t + 1) ∨
     (let a_E := q * a - ((q - 1) / k) * (t + k)
      a < a_E ∧ condExp F E χ'_E = a_E ∧
      ∀ i : Fin D_orb.length, condExp F (D_orb.get i).field (θ_orb i) = k * (a - 1) + 1)) →
    (2 * condExpChar F E ψ_E + (condExp F E χ'_E : ℤ)) * (resDeg F E : ℤ) +
      2 * condExpChar F L ψ * (resDeg F L : ℤ) +
      ∑ i : Fin D_orb.length,
        (2 * condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) +
          (condExp F (D_orb.get i).field (μ'_orb i) : ℤ)) *
          (resDeg F (D_orb.get i).field : ℤ) =
    2 * condExpChar F E ψ_E * (resDeg F E : ℤ) +
      (2 * condExpChar F L ψ + (condExp F L χ' : ℤ)) * (resDeg F L : ℤ) +
      ∑ i : Fin D_orb.length,
        (2 * condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) +
          (condExp F (D_orb.get i).field (θ_orb i) : ℤ)) *
          (resDeg F (D_orb.get i).field : ℤ) :=
by
  intro q a χ'_E ψ_E θ_orb hcases
  let K' := IntermediateField.extendScalars hM_CK
  haveI : FiniteDimensional F K' := ‹FiniteDimensional F K›
  haveI : IsScalarTower F M_C K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional M_C K' := Module.Finite.of_restrictScalars_finite F M_C K'
  have hq_pos : 0 < q := Module.finrank_pos
  have hq1_cast : ((q - 1 : ℕ) : ℤ) = (q : ℤ) - 1 := by omega
  have hdiv_nat : k * ((q - 1) / k) = q - 1 := Nat.mul_div_cancel' hk_dvd
  have hdiv_int : (k : ℤ) * (((q - 1) / k : ℕ) : ℤ) = (q : ℤ) - 1 := by
    calc (k : ℤ) * (((q - 1) / k : ℕ) : ℤ)
        = ((k * ((q - 1) / k) : ℕ) : ℤ) := (Nat.cast_mul k ((q - 1) / k)).symm
      _ = ((q - 1 : ℕ) : ℤ) := by rw [hdiv_nat]
      _ = (q : ℤ) - 1 := hq1_cast
  have hsum_split : ∀ (g : Fin D_orb.length → ℤ),
      (∑ i : Fin D_orb.length,
        (2 * condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) + g i) *
          (resDeg F (D_orb.get i).field : ℤ)) =
      (∑ i : Fin D_orb.length,
        2 * condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) *
          (resDeg F (D_orb.get i).field : ℤ)) +
      (∑ i : Fin D_orb.length, g i * (resDeg F (D_orb.get i).field : ℤ)) := by
    intro g
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    ring
  rw [hsum_split (fun i => (condExp F (D_orb.get i).field (μ'_orb i) : ℤ)),
    hsum_split (fun i => (condExp F (D_orb.get i).field (θ_orb i) : ℤ)), hresE]
  suffices hcore :
      (condExp F E χ'_E : ℤ) * (resDeg F L : ℤ) +
        ∑ i : Fin D_orb.length,
          (condExp F (D_orb.get i).field (μ'_orb i) : ℤ) *
            (resDeg F (D_orb.get i).field : ℤ) =
      (a : ℤ) * (resDeg F L : ℤ) +
        ∑ i : Fin D_orb.length,
          (condExp F (D_orb.get i).field (θ_orb i) : ℤ) *
            (resDeg F (D_orb.get i).field : ℤ) by
    dsimp only [a] at hcore
    linear_combination hcore
  rcases hcases with ⟨hcondE, hcondθ⟩ | ⟨ha_lt_aE, hcondE, hcondθ⟩
  · rw [hcondE]
    congr 1
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [(hFi_deg i).1, hcondθ i]
  · let f_fn : Fin D_orb.length → ℕ :=
      fun i => Classical.choose (hFi_deg i).2
    have hf_deg : ∀ i : Fin D_orb.length,
        Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_fn i :=
      fun i => (Classical.choose_spec (hFi_deg i).2).1
    have hf_res : ∀ i : Fin D_orb.length,
        resDeg F (D_orb.get i).field = f_fn i * resDeg F L :=
      fun i => (Classical.choose_spec (hFi_deg i).2).2
    have hsum_f : (∑ i : Fin D_orb.length, f_fn i) = (q - 1) / k := by
      have h1 : k * (∑ i : Fin D_orb.length, f_fn i) = q - 1 := by
        rw [Finset.mul_sum]
        calc ∑ i : Fin D_orb.length, k * f_fn i
            = ∑ i : Fin D_orb.length,
                Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) :=
              Finset.sum_congr rfl fun i _ => (hf_deg i).symm
          _ = q - 1 := hDegSum
      calc ∑ i : Fin D_orb.length, f_fn i
          = (k * ∑ i : Fin D_orb.length, f_fn i) / k := (Nat.mul_div_right _ hk_ge1).symm
        _ = (q - 1) / k := by rw [h1]
    have hsum_res :
        (∑ i : Fin D_orb.length, (resDeg F (D_orb.get i).field : ℤ)) =
          (((q - 1) / k : ℕ) : ℤ) * (resDeg F L : ℤ) := by
      calc ∑ i : Fin D_orb.length, (resDeg F (D_orb.get i).field : ℤ)
          = ∑ i : Fin D_orb.length, ((f_fn i : ℤ) * (resDeg F L : ℤ)) := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [hf_res i, Nat.cast_mul]
        _ = (∑ i : Fin D_orb.length, (f_fn i : ℤ)) * (resDeg F L : ℤ) :=
            (Finset.sum_mul _ _ _).symm
        _ = (((∑ i : Fin D_orb.length, f_fn i : ℕ) : ℤ)) * (resDeg F L : ℤ) := by
            rw [Nat.cast_sum]
        _ = (((q - 1) / k : ℕ) : ℤ) * (resDeg F L : ℤ) := by rw [hsum_f]
    have hsum_μ :
        (∑ i : Fin D_orb.length,
          (condExp F (D_orb.get i).field (μ'_orb i) : ℤ) *
            (resDeg F (D_orb.get i).field : ℤ)) =
        ((t : ℤ) + 1) * ((((q - 1) / k : ℕ) : ℤ) * (resDeg F L : ℤ)) := by
      calc ∑ i : Fin D_orb.length,
            (condExp F (D_orb.get i).field (μ'_orb i) : ℤ) *
              (resDeg F (D_orb.get i).field : ℤ)
          = ∑ i : Fin D_orb.length, ((t : ℤ) + 1) * (resDeg F (D_orb.get i).field : ℤ) := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [(hFi_deg i).1]
            push_cast
            ring
        _ = ((t : ℤ) + 1) * ∑ i : Fin D_orb.length, (resDeg F (D_orb.get i).field : ℤ) :=
            (Finset.mul_sum _ _ _).symm
        _ = ((t : ℤ) + 1) * ((((q - 1) / k : ℕ) : ℤ) * (resDeg F L : ℤ)) := by rw [hsum_res]
    have ha1_cast : ((a - 1 : ℕ) : ℤ) = (a : ℤ) - 1 := by
      have ha_ge2 : 2 ≤ a := h_ge2
      omega
    have hsum_θ :
        (∑ i : Fin D_orb.length,
          (condExp F (D_orb.get i).field (θ_orb i) : ℤ) *
            (resDeg F (D_orb.get i).field : ℤ)) =
        ((k : ℤ) * ((a : ℤ) - 1) + 1) * ((((q - 1) / k : ℕ) : ℤ) * (resDeg F L : ℤ)) := by
      calc ∑ i : Fin D_orb.length,
            (condExp F (D_orb.get i).field (θ_orb i) : ℤ) *
              (resDeg F (D_orb.get i).field : ℤ)
          = ∑ i : Fin D_orb.length,
              ((k : ℤ) * ((a : ℤ) - 1) + 1) * (resDeg F (D_orb.get i).field : ℤ) := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [hcondθ i]
            push_cast
            rw [ha1_cast]
        _ = ((k : ℤ) * ((a : ℤ) - 1) + 1) *
              ∑ i : Fin D_orb.length, (resDeg F (D_orb.get i).field : ℤ) :=
            (Finset.mul_sum _ _ _).symm
        _ = ((k : ℤ) * ((a : ℤ) - 1) + 1) *
              ((((q - 1) / k : ℕ) : ℤ) * (resDeg F L : ℤ)) := by rw [hsum_res]
    have haE_cast :
        ((q * a - ((q - 1) / k) * (t + k) : ℕ) : ℤ) =
          (q : ℤ) * (a : ℤ) - (((q - 1) / k : ℕ) : ℤ) * ((t : ℤ) + (k : ℤ)) := by
      change a < q * a - ((q - 1) / k) * (t + k) at ha_lt_aE
      have hle : ((q - 1) / k) * (t + k) ≤ q * a := by omega
      rw [Nat.cast_sub hle, Nat.cast_mul, Nat.cast_mul, Nat.cast_add]
    rw [hcondE, haE_cast, hsum_μ, hsum_θ]
    linear_combination -(a : ℤ) * (resDeg F L : ℤ) * hdiv_int

theorem ld_ch14_higher_cond_diamond_c_E_and_balance_assembly (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hDegSum : (∑ i : Fin D_orb.length,
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (hχ'_cond : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1)
    (hχ'E_cond : ∀ u ∈ unitGroup F E (condExp F E (χ'.comp (Units.map (normLM F hLE)))),
      (χ'.comp (Units.map (normLM F hLE))) u = 1)
    (hresE : resDeg F E = resDeg F L)
    (hValNormE : ∀ y : E, valL F L (normLM F hLE y) = valL F E y)
    (hValAlgE : ∀ x : L,
      valL F E (IntermediateField.inclusion hLE x) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F L x)
    (hResLiftE : ∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLE x = 0 ∨
          1 ≤ valL F E (y - IntermediateField.inclusion hLE x)))
    (hFrobSurjL : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 0 ∨
          1 ≤ valL F L (x - s ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))))
    (hValNormK : ∀ w : K, valL F M_C (normLM F hM_CK w) = valL F K w)
    (hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (hResLiftK : ∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (w - IntermediateField.inclusion hM_CK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hM_CK z)))
    (hDiamondTrNorm : ∀ y : E,
      IntermediateField.inclusion hLM_C (traceLM F hLE y) =
        traceLM F hM_CK (IntermediateField.inclusion hEK y) ∧
      IntermediateField.inclusion hLM_C (normLM F hLE y) =
        normLM F hM_CK (IntermediateField.inclusion hEK y))
    (t k : ℕ) (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k)
