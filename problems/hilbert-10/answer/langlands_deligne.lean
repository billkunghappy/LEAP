      hval_mul_bound_K₁ 0 (d_E : ℤ) (-(1 + y)⁻¹) y (Or.inr (by rw [hinv_val0])) hy
  set u_m := normLM F hM₁'K₁ (1 + y_m) - 1
  have hquad_um_dU : 2 * u_m - u_m ^ 2 = 0 ∨ (d_U : ℤ) ≤ valL F M₁' (2 * u_m - u_m ^ 2) :=
    (hquad_bound_any y_m hy_m_val).2
  have hy_prod_one : (1 + y) * (1 + y_m) = 1 := by
    have hmul_inv : (1 + y) * (1 + y)⁻¹ = 1 := mul_inv_cancel₀ hy_ne
    calc (1 + y) * (1 + y_m)
