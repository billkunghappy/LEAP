    simpa only [hdegM₁'] using hs_LM₁'_val_deg
  have hs_LM₁'_cayley : ∀ w : M₁',
      w ^ (Module.finrank L (IntermediateField.extendScalars hLE')) =
        IntermediateField.inclusion hLM₁' (normLM F hLM₁' w) +
          ∑ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
            (-1 : M₁') ^ (i - 1) * IntermediateField.inclusion hLM₁' (s_LM₁' w i) *
              w ^ (Module.finrank L (IntermediateField.extendScalars hLE') - i) := by
    simpa only [hdegM₁'] using hs_LM₁'_cayley_deg
  obtain ⟨h2_ne0, hj_unit, hp_valE', hUnits, huw₂_pow, hPstar_sub_D, hQE'_Pstar, hCp_QE'⟩ :=
    ld_ch12_wild_odd_tot_ram_rat_cancel_units_and_norm_pow_bounds F L E' K₁
      hLE' hE'K₁ hPrime hWild hp_odd ψ bE' bM₁' a_lam
      hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁ hp_valK₁
      hval_LE' hval_norm_LE' hval_E'K₁ hval_norm_E'K₁ Δ hΔ_val α γ w₂
      hα_val hγ_val hw₂_val hw₂_norm s_LE' hs_LE'_val hs_LE'_norm_one_add hs_LE'_cayley
  have hRE'_val :=
    ld_ch12_wild_odd_tot_ram_rat_and_add_stationary_cancel_on_E' F L E' K₁
      hLE' hE'K₁ hPrime hWild hp_odd ψ bE' bM₁' a_lam
      hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁
      hval_LE' hval_norm_E'K₁ Δ hΔ_val α γ w₂ hα_val hγ_val hw₂_val
      hj_unit hp_valE' hUnits huw₂_pow hQE'_Pstar hCp_QE'
  obtain ⟨hC_ne0, hC_val0, hPstar_ne0, hPstar_val0, hD_ne0, hD_val0, _⟩ := hUnits
  obtain ⟨hysT_c2, hysT_norm_congr⟩ :=
    ld_ch12_wild_odd_tot_ram_frobenius_norm_s0_and_ysT_congr F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hWild hp_odd ψ bE' bM₁' a_lam
      hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁ ht₁_ndvd hp_valK₁
      hval_LE' hval_norm_LE' hval_LM₁' hval_norm_LM₁' hval_E'K₁ hval_M₁'K₁
      Δ e_Δ s₀ he_Δ_val hs₀_val hs₀_approx α γ w₂ hα_val hγ_val hw₂_val hw₂_norm
      s_LE' hs_LE'_val hs_LE'_cayley s_LM₁' hs_LM₁'_val hs_LM₁'_cayley
      hC_ne0 hC_val0 hPstar_ne0 hPstar_val0 hD_ne0 hD_val0 hPstar_sub_D
  obtain ⟨hConj1, hConj3, hConj4⟩ :=
    ld_ch12_wild_odd_tot_ram_add_char_cond_and_final_L_cancel F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hPrime hWild hp_odd ψ bE' bM₁' a_lam
      hbE'_ge2 hbM₁'_ge2 hb_le hbE'_lt_lam hpm_gt_t₁ hnE'_eq hval_LE'
      Δ e_Δ s₀ α β γ w₂ hα_val hγ_val hConv_E' hH_congr
      hψ_triv hψE'_triv h2_ne0 hD_ne0 hD_val0 hysT_c2 hysT_norm_congr
  refine ⟨hConj1, ?_, hConj3, hConj4⟩
  have h := hConj1 _ 0 (by simpa only [sub_zero] using hRE'_val)
  rwa [mul_zero, AddChar.map_zero_eq_one] at h

theorem ld_ch12_wild_odd_totally_ramified_four_factor_phase_cancellation (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
