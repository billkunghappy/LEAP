  let P_L : ℤ → L → Prop := fun k y => y = 0 ∨ k ≤ valL F L y
  let P_U : ℤ → M₁' → Prop := fun k z => z = 0 ∨ k ≤ valL F M₁' z
  have hPL_zero : ∀ k : ℤ, P_L k 0 := fun _ => Or.inl rfl
  have hPU_zero : ∀ k : ℤ, P_U k 0 := fun _ => Or.inl rfl
  have hPL_mono : ∀ {k₁ k₂ : ℤ}, k₁ ≤ k₂ → ∀ {y : L}, P_L k₂ y → P_L k₁ y := by
    intro k₁ k₂ hk y hy
    rcases hy with rfl | hy
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have hPU_mono : ∀ {k₁ k₂ : ℤ}, k₁ ≤ k₂ → ∀ {z : M₁'}, P_U k₂ z → P_U k₁ z := by
    intro k₁ k₂ hk z hz
    rcases hz with rfl | hz
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have hPL_neg : ∀ {k : ℤ} {y : L}, P_L k y → P_L k (-y) := by
    intro k y hy
    rcases hy with rfl | hy
    · simp [P_L]
    · right; rw [hval_neg_L]; exact hy
  have hPU_neg : ∀ {k : ℤ} {z : M₁'}, P_U k z → P_U k (-z) := by
    intro k z hz
    rcases hz with rfl | hz
    · simp [P_U]
    · right; rw [hval_neg_U]; exact hz
  have hPL_add : ∀ {k : ℤ} {y₁ y₂ : L}, P_L k y₁ → P_L k y₂ → P_L k (y₁ + y₂) :=
    fun hy₁ hy₂ => hval_add_L _ _ _ hy₁ hy₂
  have hPU_add : ∀ {k : ℤ} {z₁ z₂ : M₁'}, P_U k z₁ → P_U k z₂ → P_U k (z₁ + z₂) :=
    fun hz₁ hz₂ => hval_add_U _ _ _ hz₁ hz₂
  have hPL_sub : ∀ {k : ℤ} {y₁ y₂ : L}, P_L k y₁ → P_L k y₂ → P_L k (y₁ - y₂) := by
    intro k y₁ y₂ hy₁ hy₂
    rw [sub_eq_add_neg]
    exact hPL_add hy₁ (hPL_neg hy₂)
  have hPU_sub : ∀ {k : ℤ} {z₁ z₂ : M₁'}, P_U k z₁ → P_U k z₂ → P_U k (z₁ - z₂) := by
    intro k z₁ z₂ hz₁ hz₂
    rw [sub_eq_add_neg]
    exact hPU_add hz₁ (hPU_neg hz₂)
