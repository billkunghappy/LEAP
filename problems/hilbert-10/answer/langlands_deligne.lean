    intro m hm_lt hm_pos
    dsimp only
    set ξ_m := ι₂ (ι₁ (τ_unit m : L))
    have hξ_val0 : valL F K₁ ξ_m = 0 := by
      dsimp [ξ_m]
      rw [hval_LK₁, hConj1 m hm_lt hm_pos, mul_zero, mul_zero]
    refine ⟨hξ_val0, ?_⟩
    let w_L : L := (τ_unit m : L) ^ p - (τ_unit m : L)
    have hw_fac : w_L = (τ_unit m : L) * ((τ_unit m : L) ^ (p - 1) - 1) := by
      have hp_eq : p = (p - 1) + 1 := by omega
      dsimp [w_L]
      conv_lhs => arg 1; rw [hp_eq, pow_succ]
      ring
    have hw_val : w_L = 0 ∨ (B : ℤ) + 1 ≤ valL F L w_L := by
      rw [hw_fac]
      have h := hval_mul_ge_L 0 ((B : ℤ) + 1) (τ_unit m : L) ((τ_unit m : L) ^ (p - 1) - 1)
        (Or.inr (le_of_eq (hConj1 m hm_lt hm_pos).symm)) (hT2_L m hm_lt hm_pos)
      simpa using h
    have hw_map : ξ_m ^ p - ξ_m = ι₂ (ι₁ w_L) := by
      dsimp [ξ_m, w_L]
      rw [map_sub, map_sub, map_pow, map_pow]
    rw [hw_map]
    rcases hw_val with h0 | hge
    · left; rw [h0, map_zero, map_zero]
    · right
      rw [hval_LK₁]
      have hp_int_ge3 : (3 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp_ge3
      have hB_cast : ((4 * p * p * m₁ : ℕ) : ℤ) = (B : ℤ) := rfl
      rw [hB_cast]
      have hB_nonneg : (0 : ℤ) ≤ (B : ℤ) := Nat.cast_nonneg B
      have h1 : (B : ℤ) + 1 ≤ (p : ℤ) * valL F L w_L := by
        nlinarith [hp_int_ge3, hge, hB_nonneg]
      nlinarith [hp_int_ge3, h1, hB_nonneg]
  have hτ_mod_p : ∀ m < p, 0 < m →
      (τ_unit m : L) - (m : L) = 0 ∨ (1 : ℤ) ≤ valL F L ((τ_unit m : L) - (m : L)) := by
    intro m hm_lt hm_pos
    have hpow_zmod : (((m : ℤ) ^ (p ^ (B + 1)) : ℤ) : ZMod p) = ((m : ℤ) : ZMod p) := by
      push_cast
      exact ZMod.pow_card_pow (m : ZMod p)
    have hdvd : (p : ℤ) ∣ ((m : ℤ) ^ (p ^ (B + 1)) - (m : ℤ)) :=
      (ZMod.intCast_eq_intCast_iff_dvd_sub (m : ℤ) ((m : ℤ) ^ (p ^ (B + 1))) p).mp hpow_zmod.symm
    rcases hdvd with ⟨k_m, hk_m⟩
    have hk_L : (τ_unit m : L) - (m : L) = ((p : ℕ) : L) * (k_m : L) := by
      rw [hτ_unit_coe m hm_lt hm_pos]
      have h1 := congrArg (Int.cast : ℤ → L) hk_m
      push_cast at h1
      exact h1
    rw [hk_L]
    have h := hval_mul_ge_L 1 0 ((p : ℕ) : L) (k_m : L) hp_val1_L (hint_int_L k_m)
    simpa using h
  have hdiff_lt_L : ∀ a b : ℕ, b < p → 0 < a → a < b →
      (τ_unit b : L) - (τ_unit a : L) ≠ 0 ∧ valL F L ((τ_unit b : L) - (τ_unit a : L)) = 0 := by
    intro a b hb_lt ha_pos hab
    have ha_lt : a < p := by omega
    have hba_lt : b - a < p := by omega
    have hba_pos : 0 < b - a := by omega
    let d : L := ((b - a : ℕ) : L)
    have hd_ne0 : d ≠ 0 := (hm_props (b - a) hba_lt hba_pos).1
    have hd_val0 : valL F L d = 0 := (hm_props (b - a) hba_lt hba_pos).2
    let u_d : Lˣ := Units.mk0 d hd_ne0
    have hud_inv_val0 : valL F L ((u_d⁻¹ : Lˣ) : L) = 0 := by
      rw [hval_inv_L u_d]
      change -valL F L d = 0
      rw [hd_val0, neg_zero]
    let ε : L := ((τ_unit b : L) - (b : L)) - ((τ_unit a : L) - (a : L))
    have hε_val : ε = 0 ∨ (1 : ℤ) ≤ valL F L ε :=
      hval_sub_L 1 ((τ_unit b : L) - (b : L)) ((τ_unit a : L) - (a : L))
