      hPrime hWild hp_odd hdegM₁' hdegE'K₁ hdegM₁'K₁
      ψ hψ hψE' hψM₁' νE' νM₁'
      hνE'_pow hνE'_ne hνE'_ker hνE'_cond
      hνM₁'_pow hνM₁'_ne hνM₁'_ker hνM₁'_cond
      hbE'_ge2 hbM₁'_ge2 hb_le ht₁_ndvd hp_valK₁
      hnE'_eq hnM₁'_eq hξE'_cond hξM₁'_cond
      hval_LE' hval_norm_LE' hval_LM₁' hval_norm_LM₁'
      hval_E'K₁ hval_norm_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁
      htr_LE' htr_LM₁' htr_E'K₁ htr_M₁'K₁
      hDiamond_E' hDiamond_M₁' hTowerNormTr hGalLift hGalLift_E'
      χ₁ χ₂ hχ_comp hχ_rest hm₁_χ₁ hm₂_χ₂ hχ₂_twists hχ₁_twists
      Δ₀ hΔ₀_val hΔ₀_as hΔ_univ
      c_νE' hc_νE'_val hc_νE'_log c₂₀ hc₂₀_val hc₂₀_log c₁₀ hc₁₀_val hc₁₀_log
      hP_M₁' hP_E' hShift_E' hModelCompat_all
  obtain ⟨ha_val, hb_val, hΔ_tr_low, hΔ_tr_top, hΔ_tr_pow, hΔ_basis, _⟩ :=
    hΔ_univ Δ hΔ_val hΔ_as
  have hSymm_Δ := hSymm_univ Δ hΔ_val hΔ_as
  have hThm8_16 :=
    ld_ch12_wild_odd_totally_ramified_symm_norm_char_congruence_p3
      F L E' M₁' K₁ hLE' hLM₁' hE'K₁ hM₁'K₁
      hGalLE' hGalLM₁' hGalE'K₁ hGalM₁'K₁ hAbLE' hAbLM₁'
      hPrime hWild hp_odd hdegM₁' hdegE'K₁ hdegM₁'K₁
      ψ hψ hψE' hψM₁' νE' νM₁'
      hνE'_pow hνE'_ne hνE'_ker hνE'_cond
      hνM₁'_pow hνM₁'_ne hνM₁'_ker hνM₁'_cond
      hbE'_ge2 hbM₁'_ge2 hb_le ht₁_ndvd hp_valK₁
      hnE'_eq hnM₁'_eq hξE'_cond hξM₁'_cond
      hval_LE' hval_norm_LE' hval_LM₁' hval_norm_LM₁'
      hval_E'K₁ hval_norm_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁
      htr_LE' htr_LM₁' htr_E'K₁ htr_M₁'K₁
      hDiamond_E' hDiamond_M₁' hTowerNormTr hGalLift hGalLift_E'
      χ₁ χ₂ hχ_comp hχ_rest hm₁_χ₁ hm₂_χ₂ hχ₂_twists hχ₁_twists
      Δ c_νE' hΔ_val hΔ_as ha_val hb_val hΔ_tr_low hΔ_tr_top hΔ_tr_pow hΔ_basis hSymm_Δ
      hc_νE'_val hc_νE'_log hConv_E'_2 hχ₂_log hχ₁_log hP_M₁' hNormLog_M₁'
  exact ⟨Δ, c_νE', hΔ_val, hΔ_as, hc_νE'_val, hc_νE'_log, hχ₂_log, hχ₁_log, hThm8_16⟩

theorem ld_ch12_wild_odd_totally_ramified_higher_cond_norm_reps_and_adjustments (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hAbLE' : IsAbelianExt F hLE') (hAbLM₁' : IsAbelianExt F hLM₁')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
    (χ₁ : M₁'ˣ →* (Ω F)ˣ) (χ₂ : E'ˣ →* (Ω F)ˣ) (lam_L : Lˣ →* (Ω F)ˣ)
    (hbE'_lt_lam : condExp F L νE' < condExp F L lam_L)
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          (condExp F L νE' : ℤ))
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          (condExp F L νM₁' : ℤ))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (htr_LM₁' : ∀ (m : ℤ) (z : M₁'),
      (z = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νM₁' : ℤ) ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (Δ : K₁ˣ) (c_νE'₀ c_νM₁'₀ c_lam : Lˣ)
    (ha_val : valL F E' (normLM F hE'K₁ (Δ : K₁)) = -((condExp F L νM₁' - 1 : ℕ) : ℤ))
    (hb_val : valL F M₁' (normLM F hM₁'K₁ (Δ : K₁)) = -((condExp F L νM₁' - 1 : ℕ) : ℤ))
    (hc_νE'₀_val : valL F L (c_νE'₀ : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_νE'₀_log :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let c₂ := (condExp F L νE' + p - 1) / p
      ∀ u : L, (u = 0 ∨ (c₂ : ℤ) ≤ valL F L u) →
        ∀ hu : 1 - u ≠ 0,
          (νE' (Units.mk0 (1 - u) hu) : Ω F) ^ 2 =
            ψ (- 2 * ((c_νE'₀⁻¹ : Lˣ) : L) *
              (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u ^ j)))
    (hc_νM₁'₀_val : valL F L (c_νM₁'₀ : L) = (condExp F L νM₁' : ℤ) + condExpChar F L ψ)
    (hc_νM₁'₀_log :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let q₀ := (condExp F L νM₁' + p - 1) / p
      ∀ u : L, (u = 0 ∨ (q₀ : ℤ) ≤ valL F L u) →
        ∀ hu : 1 - u ≠ 0,
          (νM₁' (Units.mk0 (1 - u) hu) : Ω F) ^ 2 =
            ψ (- 2 * ((c_νM₁'₀⁻¹ : Lˣ) : L) *
              (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u ^ j)))
    (hc_lam_val : valL F L (c_lam : L) = (condExp F L lam_L : ℤ) + condExpChar F L ψ)
    (hc_lam_log :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let q_lam := (condExp F L lam_L + p - 1) / p
      ∀ u : L, (u = 0 ∨ (q_lam : ℤ) ≤ valL F L u) →
        ∀ hu : 1 - u ≠ 0,
          (lam_L (Units.mk0 (1 - u) hu) : Ω F) ^ 2 =
            ψ (- 2 * ((c_lam⁻¹ : Lˣ) : L) *
              (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u ^ j)))
    (hχ₂_log :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₂ := condExp F L νE' + condExp F L νM₁' - 1
      let q₂ := (m₂ + p - 1) / p
      ∀ x : E', (x = 0 ∨ (q₂ : ℤ) ≤ valL F E' x) →
        ∀ hx : 1 - x ≠ 0,
          (χ₂ (Units.mk0 (1 - x) hx) : Ω F) ^ 2 =
            (traceChar F hLE' ψ) (2 * IntermediateField.inclusion hLE' (((c_νE'₀⁻¹ : Lˣ) : L)) *
              normLM F hE'K₁ (Δ : K₁) *
              (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * x ^ j)))
    (hχ₁_log :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * condExp F L νM₁' - 1 + p * (condExp F L νE' - condExp F L νM₁')
      let q₁ := (m₁ + p - 1) / p
      ∀ z : M₁', (z = 0 ∨ (q₁ : ℤ) ≤ valL F M₁' z) →
        ∀ hz : 1 - z ≠ 0,
          (χ₁ (Units.mk0 (1 - z) hz) : Ω F) ^ 2 =
            (traceChar F hLM₁' ψ) (2 * IntermediateField.inclusion hLM₁' (((c_νE'₀⁻¹ : Lˣ) : L)) *
              normLM F hM₁'K₁ (Δ : K₁) *
              (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j)))
    (hConv_E'_fn :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let c₂ := (bE' + p - 1) / p
      let P_L := fun u : L => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u ^ j
      ∀ c_νE' : Lˣ,
        valL F L (c_νE' : L) = (bE' : ℤ) + condExpChar F L ψ →
        (∀ u : L, (u = 0 ∨ (c₂ : ℤ) ≤ valL F L u) →
          ∀ hu : 1 - u ≠ 0,
            (νE' (Units.mk0 (1 - u) hu) : Ω F) ^ 2 =
              ψ (- 2 * ((c_νE'⁻¹ : Lˣ) : L) * P_L u)) →
        ∀ w : E', (w = 0 ∨ (c₂ : ℤ) ≤ valL F E' w) →
          ψ (- 2 * ((c_νE'⁻¹ : Lˣ) : L) * (traceLM F hLE' w + normLM F hLE' w)) = 1 ∧
          (traceChar F hLE' ψ) (2 * IntermediateField.inclusion hLE' (((c_νE'⁻¹ : Lˣ) : L)) * w) =
            ψ (- 2 * ((c_νE'⁻¹ : Lˣ) : L) * normLM F hLE' w))
    (hConv_M₁'_fn :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bM₁' := condExp F L νM₁'
      let q₀ := (bM₁' + p - 1) / p
      let P_L := fun u : L => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u ^ j
      ∀ c_νM₁' : Lˣ,
        valL F L (c_νM₁' : L) = (bM₁' : ℤ) + condExpChar F L ψ →
        (∀ u : L, (u = 0 ∨ (q₀ : ℤ) ≤ valL F L u) →
          ∀ hu : 1 - u ≠ 0,
            (νM₁' (Units.mk0 (1 - u) hu) : Ω F) ^ 2 =
              ψ (- 2 * ((c_νM₁'⁻¹ : Lˣ) : L) * P_L u)) →
        ∀ w : M₁', (w = 0 ∨ (q₀ : ℤ) ≤ valL F M₁' w) →
          ψ (- 2 * ((c_νM₁'⁻¹ : Lˣ) : L) * (traceLM F hLM₁' w + normLM F hLM₁' w)) = 1 ∧
          (traceChar F hLM₁' ψ) (2 * IntermediateField.inclusion hLM₁' (((c_νM₁'⁻¹ : Lˣ) : L)) * w) =
            ψ (- 2 * ((c_νM₁'⁻¹ : Lˣ) : L) * normLM F hLM₁' w))
    (e_Δ : ℕ → M₁')
    (hThm8_16 : ∀ c_νM₁' : Lˣ,
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let bM₁' := condExp F L νM₁'
      let t₁ := bM₁' - 1
      let ct := (t₁ + p - 1) / p
      valL F L (c_νM₁' : L) = (bM₁' : ℤ) + condExpChar F L ψ →
      (∀ u : L, (u = 0 ∨ (ct : ℤ) ≤ valL F L u) →
        ∀ hu : 1 - u ≠ 0,
          (νM₁' (Units.mk0 (1 - u) hu) : Ω F) ^ 2 =
            ψ (- 2 * ((c_νM₁'⁻¹ : Lˣ) : L) *
              (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u ^ j))) →
      let H := normLM F hLM₁' (- e_Δ (p - 1))
      let v := ((c_νM₁'⁻¹ : Lˣ) : L) * (c_νE'₀ : L)
      H - v ^ (p - 1) = 0 ∨
        ((t₁ + 1 - ct + (p - 1) * (bE' - bM₁') : ℕ) : ℤ) ≤ valL F L (H - v ^ (p - 1))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let bE' := condExp F L νE'
    let bM₁' := condExp F L νM₁'
    let t₁ := bM₁' - 1
    let a_lam := condExp F L lam_L
    let m := a_lam - bE'
    let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
    let m₂ := bE' + bM₁' - 1
    let q₁ := (m₁ + p - 1) / p
    let q₂ := (m₂ + p - 1) / p
    let q_lam := (a_lam + p - 1) / p
    let c₂ := (bE' + p - 1) / p
    let q₀ := (bM₁' + p - 1) / p
    let ct := (t₁ + p - 1) / p
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    let a := normLM F hE'K₁ (Δ : K₁)
    let b := normLM F hM₁'K₁ (Δ : K₁)
    ∃ (α β γ : Lˣ) (w₂ : E'ˣ) (w₁ : M₁'ˣ),
      valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ ∧
      valL F L (β : L) = -(bM₁' : ℤ) - condExpChar F L ψ ∧
      valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ ∧
      valL F E' (w₂ : E') = -(m : ℤ) ∧
      valL F M₁' (w₁ : M₁') = -((a_lam - bM₁' : ℕ) : ℤ) ∧
      Units.map (normLM F hLE') w₂ = γ * α⁻¹ ∧
      Units.map (normLM F hLM₁') w₁ = γ * β⁻¹ ∧
      (∀ u : L, (u = 0 ∨ (q_lam : ℤ) ≤ valL F L u) →
        ∀ hu : 1 - u ≠ 0,
          (lam_L (Units.mk0 (1 - u) hu) : Ω F) ^ 2 =
            ψ (2 * (γ : L) * (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u ^ j))) ∧
      (∀ x : E', (x = 0 ∨ (q₂ : ℤ) ≤ valL F E' x) →
        ∀ hx : 1 - x ≠ 0,
          (χ₂ (Units.mk0 (1 - x) hx) : Ω F) ^ 2 =
            ψE' (2 * IntermediateField.inclusion hLE' (α : L) * a *
              (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * x ^ j))) ∧
      (∀ z : M₁', (z = 0 ∨ (q₁ : ℤ) ≤ valL F M₁' z) →
        ∀ hz : 1 - z ≠ 0,
          (χ₁ (Units.mk0 (1 - z) hz) : Ω F) ^ 2 =
            ψM₁' (2 * IntermediateField.inclusion hLM₁' (α : L) * b *
              (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j))) ∧
      (∀ y : E', (y = 0 ∨ (c₂ : ℤ) ≤ valL F E' y) →
        ψE' (2 * IntermediateField.inclusion hLE' (α : L) * y) =
          ψ (- 2 * (α : L) * normLM F hLE' y)) ∧
      (∀ z : M₁', (z = 0 ∨ (q₀ : ℤ) ≤ valL F M₁' z) →
        ψM₁' (2 * IntermediateField.inclusion hLM₁' (β : L) * z) =
          ψ (- 2 * (β : L) * normLM F hLM₁' z)) ∧
      (q₀ ≤ ct →
        (∀ z : M₁', (z = 0 ∨ (ct : ℤ) ≤ valL F M₁' z) →
          ψM₁' (2 * IntermediateField.inclusion hLM₁' (β : L) * z) =
            ψ (- 2 * (β : L) * normLM F hLM₁' z)) ∧
        (normLM F hLM₁' (- e_Δ (p - 1)) - ((β : L) * ((α⁻¹ : Lˣ) : L)) ^ (p - 1) = 0 ∨
          ((t₁ + 1 - ct + (p - 1) * (bE' - bM₁') : ℕ) : ℤ) ≤
            valL F L (normLM F hLM₁' (- e_Δ (p - 1)) -
              ((β : L) * ((α⁻¹ : Lˣ) : L)) ^ (p - 1)))) :=
by
  intro p bE' bM₁' t₁ a_lam m m₁ m₂ q₁ q₂ q_lam c₂ q₀ ct ψE' ψM₁' a b
  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_odd' : p ≠ 2 := by omega
  have hp_ge3 : 3 ≤ p := by omega
  have hp_sub1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega

  
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalE'_props := ld_valL_and_unitGroup_props F E'
  have hvalM₁'_props := ld_valL_and_unitGroup_props F M₁'
  have hval0_L := hvalL_props.1
  have hval1_L := hvalL_props.2.1
  have hval_neg_L := hvalL_props.2.2.2.1
  have hval_mul_L := hvalL_props.2.2.2.2.1
  have hval_inv_L := hvalL_props.2.2.2.2.2.1
  have hval_add_L := hvalL_props.2.2.2.2.2.2.2.1
  have hUG0_L := hvalL_props.2.2.2.2.2.2.2.2.1
  have hUGa_L := hvalL_props.2.2.2.2.2.2.2.2.2.1
  have hUG_val0_L := hvalL_props.2.2.2.2.2.2.2.2.2.2

  have hψ_triv := (ld_condExp_and_condExpChar_spec F L ψ hψ 1).1
  have hψE'_triv := (ld_condExp_and_condExpChar_spec F E' ψE' hψE' 1).1
  have hψM₁'_triv := (ld_condExp_and_condExpChar_spec F M₁' ψM₁' hψM₁' 1).1

  have hval_sub : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (k : ℤ) (x y : M),
      (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
      (x - y = 0 ∨ k ≤ valL F M (x - y)) := by
    intro M _ k x y hx hy
    have hM := ld_valL_and_unitGroup_props F M
    rw [sub_eq_add_neg]
    apply hM.2.2.2.2.2.2.2.1 k x (-y) hx
    rcases hy with rfl | hy_ge
    · left; exact neg_zero
    · right; rw [hM.2.2.2.1]; exact hy_ge
  have hval_mul_bound : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (k₁ k₂ : ℤ) (x y : M),
      (x = 0 ∨ k₁ ≤ valL F M x) → (y = 0 ∨ k₂ ≤ valL F M y) →
      (x * y = 0 ∨ k₁ + k₂ ≤ valL F M (x * y)) := by
    intro M _ k₁ k₂ x y hx hy
    have hM := ld_valL_and_unitGroup_props F M
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hM.2.2.2.2.1 x y hx0 hy0]
        exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
  have hval_pow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (n : ℕ) (k : ℤ) (x : M),
      (x = 0 ∨ k ≤ valL F M x) → (x ^ n = 0 ∨ (n : ℤ) * k ≤ valL F M (x ^ n)) := by
    intro M _ n k x hx
    have hM := ld_valL_and_unitGroup_props F M
    induction n with
    | zero =>
      rw [pow_zero, Nat.cast_zero, zero_mul, hM.2.1]
      exact Or.inr le_rfl
    | succ n ih =>
      rw [pow_succ]
      have hmul := hval_mul_bound M ((n : ℤ) * k) k (x ^ n) x ih hx
      have heq : ((n + 1 : ℕ) : ℤ) * k = (n : ℤ) * k + k := by push_cast; ring
      rw [heq]
      exact hmul
  have hval_sum : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (S : Finset ℕ) (f : ℕ → M) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F M (f i)) →
      ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F M (∑ i ∈ S, f i)) := by
    intro M _ S f k hf
    have hM := ld_valL_and_unitGroup_props F M
    induction S using Finset.induction_on with
    | empty => left; exact Finset.sum_empty
    | @insert i s hi ih =>
      rw [Finset.sum_insert hi]
      exact hM.2.2.2.2.2.2.2.1 k (f i) (∑ j ∈ s, f j)
        (hf i (Finset.mem_insert_self i s))
        (ih (fun j hj => hf j (Finset.mem_insert_of_mem hj)))
  have hval_unit_pow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (u : Mˣ) (n : ℕ), valL F M ((u ^ n : Mˣ) : M) = (n : ℤ) * valL F M (u : M) := by
    intro M _ u n
    have hM := ld_valL_and_unitGroup_props F M
    induction n with
    | zero =>
      rw [pow_zero, Units.val_one, hM.2.1, Nat.cast_zero, zero_mul]
    | succ n ih =>
      rw [pow_succ, Units.val_mul, hM.2.2.2.2.1 _ _ (Units.ne_zero (u ^ n)) (Units.ne_zero u), ih]
      push_cast; ring
  have hval_natCast : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (n : ℕ), ((n : ℕ) : M) = 0 ∨ (0 : ℤ) ≤ valL F M ((n : ℕ) : M) := by
    intro M _ n
    have hM := ld_valL_and_unitGroup_props F M
    induction n with
    | zero => left; exact Nat.cast_zero
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hM.2.2.2.2.2.2.2.1 0 (n : M) 1 ih (Or.inr (by rw [hM.2.1]))
  have hval_intCast_L : ∀ z : ℤ, (z : L) = 0 ∨ (0 : ℤ) ≤ valL F L (z : L) := by
    intro z
    obtain ⟨n, rfl | rfl⟩ := Int.eq_nat_or_neg z
    · rw [Int.cast_natCast]; exact hval_natCast L n
    · rw [Int.cast_neg, Int.cast_natCast]
      rcases hval_natCast L n with h0 | hge
      · left; rw [h0, neg_zero]
      · right; rw [hval_neg_L]; exact hge

  have htr_one_E' : traceLM F hLE' (1 : E') = (p : L) := by
    change Algebra.trace L (IntermediateField.extendScalars hLE')
      (algebraMap L (IntermediateField.extendScalars hLE') (1 : L)) = (p : L)
    rw [Algebra.trace_algebraMap, nsmul_one]
  have hp_valL : (p : L) = 0 ∨ (1 : ℤ) ≤ valL F L (p : L) := by
    rw [← htr_one_E']
    apply htr_LE' 1 (1 : E')
    right
    rw [hvalE'_props.2.1, hp_sub1_cast]
    have : (3 : ℤ) ≤ p ∧ (2 : ℤ) ≤ bE' := by omega
    nlinarith
  have hj_L : ∀ j ∈ Finset.Icc 1 (p - 1),
      ((j : ℕ) : L) ≠ 0 ∧ valL F L ((j : ℕ) : L) = 0 := by
    intro j hj
    have hj_bounds := Finset.mem_Icc.mp hj
    have hcop : Nat.Coprime j p :=
      (hPrime.coprime_iff_not_dvd.mpr (Nat.not_dvd_of_pos_of_lt (by omega) (by omega))).symm
    have hbez_Z : ((j.gcd p : ℕ) : ℤ) = (j : ℤ) * Nat.gcdA j p + (p : ℤ) * Nat.gcdB j p :=
      Nat.gcd_eq_gcd_ab j p
    rw [hcop.gcd_eq_one, Nat.cast_one] at hbez_Z
    have hbez : (1 : L) = (j : L) * (Nat.gcdA j p : L) + (p : L) * (Nat.gcdB j p : L) := by
      have h := congrArg (Int.cast : ℤ → L) hbez_Z
      push_cast at h
      exact h
    have hp_term : (p : L) * (Nat.gcdB j p : L) = 0 ∨
        (1 : ℤ) ≤ valL F L ((p : L) * (Nat.gcdB j p : L)) := by
      rcases hval_mul_bound L 1 0 (p : L) (Nat.gcdB j p : L) hp_valL (hval_intCast_L _) with h0 | hge
      · left; exact h0
      · right; linarith
    have hj_not_pos : ¬ ((j : L) = 0 ∨ (1 : ℤ) ≤ valL F L (j : L)) := by
      intro hj_pos
      have hj_term : (j : L) * (Nat.gcdA j p : L) = 0 ∨
          (1 : ℤ) ≤ valL F L ((j : L) * (Nat.gcdA j p : L)) := by
        rcases hval_mul_bound L 1 0 (j : L) (Nat.gcdA j p : L) hj_pos (hval_intCast_L _) with h0 | hge
        · left; exact h0
        · right; linarith
      have h1_pos := hval_add_L 1 _ _ hj_term hp_term
      rw [← hbez, hval1_L] at h1_pos
      rcases h1_pos with h1_zero | h1_le
      · exact one_ne_zero h1_zero
      · omega
    have hj_ne0 : (j : L) ≠ 0 := fun h0 => hj_not_pos (Or.inl h0)
    have hj_ge0 : (0 : ℤ) ≤ valL F L (j : L) := (hval_natCast L j).resolve_left hj_ne0
    refine ⟨hj_ne0, ?_⟩
    by_contra hne0
    exact hj_not_pos (Or.inr (by omega))

  let P_L : L → L := fun u => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u ^ j
  let P_E' : E' → E' := fun x => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * x ^ j
  let P_M₁' : M₁' → M₁' := fun z => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M₁')⁻¹ * z ^ j

  have hPL_val : ∀ (r : ℤ) (u : L), 0 ≤ r →
      (u = 0 ∨ r ≤ valL F L u) → (P_L u = 0 ∨ r ≤ valL F L (P_L u)) := by
    intro r u hr hu
    apply hval_sum L (Finset.Icc 1 (p - 1)) (fun j => ((j : ℕ) : L)⁻¹ * u ^ j) r
    intro j hj
    have hj1 : 1 ≤ j := (Finset.mem_Icc.mp hj).1
    obtain ⟨hj_ne0, hj_val0⟩ := hj_L j hj
    let u_j : Lˣ := Units.mk0 ((j : ℕ) : L) hj_ne0
    have hinv_val : (((j : ℕ) : L)⁻¹) = 0 ∨ (0 : ℤ) ≤ valL F L (((j : ℕ) : L)⁻¹) := by
      right
      change (0 : ℤ) ≤ valL F L ((u_j⁻¹ : Lˣ) : L)
      rw [hval_inv_L u_j]
      change (0 : ℤ) ≤ - valL F L ((j : ℕ) : L)
      rw [hj_val0, neg_zero]
    have huj : u ^ j = 0 ∨ r ≤ valL F L (u ^ j) := by
      rcases hval_pow L j r u hu with h0 | hge
      · left; exact h0
      · right
        have h1 : r ≤ (j : ℤ) * r := le_mul_of_one_le_left hr (by omega)
        exact h1.trans hge
    rcases hval_mul_bound L 0 r (((j : ℕ) : L)⁻¹) (u ^ j) hinv_val huj with h0 | hge
    · left; exact h0
    · right; linarith

  have hPE'_val : ∀ (r : ℤ) (x : E'), 0 ≤ r →
      (x = 0 ∨ r ≤ valL F E' x) → (P_E' x = 0 ∨ r ≤ valL F E' (P_E' x)) := by
    intro r x hr hx
    apply hval_sum E' (Finset.Icc 1 (p - 1)) (fun j => ((j : ℕ) : E')⁻¹ * x ^ j) r
    intro j hj
    have hj1 : 1 ≤ j := (Finset.mem_Icc.mp hj).1
    obtain ⟨hj_ne0, hj_val0⟩ := hj_L j hj
    have hincl_j : IntermediateField.inclusion hLE' (j : L) = ((j : ℕ) : E') :=
      map_natCast (IntermediateField.inclusion hLE') j
    have hj_E'_ne0 : ((j : ℕ) : E') ≠ 0 := by
      rw [← hincl_j]
      exact (map_ne_zero (IntermediateField.inclusion hLE')).mpr hj_ne0
    have hj_E'_val0 : valL F E' ((j : ℕ) : E') = 0 := by
      rw [← hincl_j, hval_LE' (j : L), hj_val0, mul_zero]
    let u_j : E'ˣ := Units.mk0 ((j : ℕ) : E') hj_E'_ne0
    have hinv_val : (((j : ℕ) : E')⁻¹) = 0 ∨ (0 : ℤ) ≤ valL F E' (((j : ℕ) : E')⁻¹) := by
      right
      change (0 : ℤ) ≤ valL F E' ((u_j⁻¹ : E'ˣ) : E')
      rw [hvalE'_props.2.2.2.2.2.1 u_j]
      change (0 : ℤ) ≤ - valL F E' ((j : ℕ) : E')
      rw [hj_E'_val0, neg_zero]
    have hxj : x ^ j = 0 ∨ r ≤ valL F E' (x ^ j) := by
      rcases hval_pow E' j r x hx with h0 | hge
      · left; exact h0
      · right
        have h1 : r ≤ (j : ℤ) * r := le_mul_of_one_le_left hr (by omega)
        exact h1.trans hge
    rcases hval_mul_bound E' 0 r (((j : ℕ) : E')⁻¹) (x ^ j) hinv_val hxj with h0 | hge
    · left; exact h0
    · right; linarith

  have hPM₁'_val : ∀ (r : ℤ) (z : M₁'), 0 ≤ r →
      (z = 0 ∨ r ≤ valL F M₁' z) → (P_M₁' z = 0 ∨ r ≤ valL F M₁' (P_M₁' z)) := by
    intro r z hr hz
    apply hval_sum M₁' (Finset.Icc 1 (p - 1)) (fun j => ((j : ℕ) : M₁')⁻¹ * z ^ j) r
    intro j hj
    have hj1 : 1 ≤ j := (Finset.mem_Icc.mp hj).1
    obtain ⟨hj_ne0, hj_val0⟩ := hj_L j hj
    have hincl_j : IntermediateField.inclusion hLM₁' (j : L) = ((j : ℕ) : M₁') :=
      map_natCast (IntermediateField.inclusion hLM₁') j
    have hj_M₁'_ne0 : ((j : ℕ) : M₁') ≠ 0 := by
      rw [← hincl_j]
      exact (map_ne_zero (IntermediateField.inclusion hLM₁')).mpr hj_ne0
    have hj_M₁'_val0 : valL F M₁' ((j : ℕ) : M₁') = 0 := by
      rw [← hincl_j, hval_LM₁' (j : L), hj_val0, mul_zero]
    let u_j : M₁'ˣ := Units.mk0 ((j : ℕ) : M₁') hj_M₁'_ne0
    have hinv_val : (((j : ℕ) : M₁')⁻¹) = 0 ∨ (0 : ℤ) ≤ valL F M₁' (((j : ℕ) : M₁')⁻¹) := by
      right
      change (0 : ℤ) ≤ valL F M₁' ((u_j⁻¹ : M₁'ˣ) : M₁')
      rw [hvalM₁'_props.2.2.2.2.2.1 u_j]
      change (0 : ℤ) ≤ - valL F M₁' ((j : ℕ) : M₁')
      rw [hj_M₁'_val0, neg_zero]
    have hzj : z ^ j = 0 ∨ r ≤ valL F M₁' (z ^ j) := by
      rcases hval_pow M₁' j r z hz with h0 | hge
      · left; exact h0
      · right
        have h1 : r ≤ (j : ℤ) * r := le_mul_of_one_le_left hr (by omega)
        exact h1.trans hge
    rcases hval_mul_bound M₁' 0 r (((j : ℕ) : M₁')⁻¹) (z ^ j) hinv_val hzj with h0 | hge
    · left; exact h0
    · right; linarith

  let γ : Lˣ := Units.mk0 (-((c_lam⁻¹ : Lˣ) : L)) (neg_ne_zero.mpr (Units.ne_zero (c_lam⁻¹)))
  have hγ_coe : (γ : L) = -((c_lam⁻¹ : Lˣ) : L) := rfl
  have hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ := by
    rw [hγ_coe, hval_neg_L, hval_inv_L c_lam, hc_lam_val]
    ring
  have hlam_log : ∀ u : L, (u = 0 ∨ (q_lam : ℤ) ≤ valL F L u) →
      ∀ hu : 1 - u ≠ 0,
