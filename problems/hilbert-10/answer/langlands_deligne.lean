    have hconj_P1 : P 1 (η c' - (u σ) ^ t * η c) := by
      have hk_eq : (0 + (-((t + 1 : ℕ) : ℤ))) + ((t + 1 : ℤ) + 1) = 1 := by push_cast; ring
