      (IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L) * R)
  set z₃ : K₁ := (2 * IntermediateField.inclusion hM₁'K₁ x + 1) *
    IntermediateField.inclusion hE'K₁
      (IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L) * R)
  set X : K₁ := IntermediateField.inclusion (hLE'.trans hE'K₁) c₀ +
    IntermediateField.inclusion (hLE'.trans hE'K₁) c₁ * z₃
  set C : K₁ := Y - X
  set N₂ : E' := normLM F hE'K₁ C
  have hf_val' : valL F L f = 1 - 2 * (a : ℤ) := hf_val
  have hR_val' : valL F E' R = 2 * (e : ℤ) + 1 - 2 * (a : ℤ) := hR_val
  have hρ_val' : valL F L ρ = 2 * (e : ℤ) + 1 - 2 * (a : ℤ) := hρ_val
  have hE_val' : E = 0 ∨ 1 - (a : ℤ) ≤ valL F L E := hE_val
  obtain ⟨δ_E', hδ_E'_T0, hδ_E'_val_eh⟩ :=
    ld_ch12_wild_dyadic_odd_max_break_higher_cond_TYC_val_and_deltaE
      F L E' hLE' a e b₁ ha_ge1 he_ge hb₁_ge
      hvalL_props hvalE'_props hval_LE' ϖ_E' hϖ_E' h2_ne h2_val
      R f ρ E hR_ne hf_ne hρ_ne hf_val' hR_val' hρ_val' hE_val'
      c₀ c₁ hc₀_val hc₁_val hA_ne hA_val N₂ hN₂_ne hN₂_val
  have hδ_E'_val : valL F E' (δ_E' : E') = (d₂ : ℤ) := by
    rw [hδ_E'_val_eh, hd₂_eq]
  have hT0_eq :
      traceLM F hE'K₁ (Y * (IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ C) - C)) =
        IntermediateField.inclusion hLE' (c₀ - 2 * E) +
          IntermediateField.inclusion hLE'
            ((-2 * c₀ + c₁ * (1 + 4 * f) - 2) * ((u₂⁻¹ : Lˣ) : L)) * R :=
    (hShiftTable c₀ c₁).2.2.2.2.2.2.2
  have hδ_E'_eq :
      (δ_E' : E') =
        ((ϖ_E' ^ e : E'ˣ) : E') *
          traceLM F hE'K₁ (Y * (IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ C) - C)) *
            N₂⁻¹ := by
    rw [hδ_E'_T0, hT0_eq]
  refine ⟨δ_E', hδ_E'_val, ?_⟩
  apply ld_ch12_wild_dyadic_odd_max_break_higher_cond_crit_rec_from_perturbation
    F L E' hLE' hdeg2 ψ νE' θE' hνE'_ker hbE'_ge2 hT2_odd hm2_ge3 hm2_odd
    hQuadNorm hSpecL hSpecE' hvalL_props hvalE'_props hval_LE'
    ϖ_E' ϖ_L hϖ_norm hϖ_E' hϖ_L htr_LE' cE' cνE' δ_E'
    hcE'_val hcE'_stat hcνE'_val hcνE'_stat hδ_E'_val
  dsimp only
  intro r hr
  obtain ⟨hV_val, hz_V, hu_V_coe, hN_V_val⟩ :=
    ld_ch12_wild_dyadic_odd_max_break_higher_cond_cayley_hamilton_and_V_eval
      F L E' M₁' K₁ hLE' hLM₁' hE'K₁ hM₁'K₁ hdeg2_E'K₁
      a e b₁ ha_ge1 he_ge hb₁_ge hQuadNorm
      hvalL_props hvalE'_props hvalK₁_props hval_normK₁ hval_LE' hval_E'K₁
      ϖ_E' hϖ_E' h2_ne h2_val x R f ρ E hR_ne hR_val' hE_val'
      c₀ c₁ hShiftTable hC_ne hC_val hN₂_ne δ_E' hδ_E'_eq r hr
  set z_E : E' := ((ϖ_E' ^ e : E'ˣ) : E') * IntermediateField.inclusion hLE' r
  set V : K₁ := Y * IntermediateField.inclusion hE'K₁ z_E
  set C_u : K₁ˣ := Units.mk0 C hC_ne
  set W : K₁ := ((C_u⁻¹ : K₁ˣ) : K₁) * V
  set N_V : E' := normLM F hE'K₁ W
  obtain ⟨hu_V, hMP_eq⟩ := hMasterPerturb V hV_val
  let u_V : E'ˣ := Units.map (normLM F hE'K₁) (Units.mk0 (1 + W) hu_V)
  refine ⟨u_V, N_V, ?_, ?_, ?_⟩
  · change normLM F hE'K₁ (1 + W) = 1 + (δ_E' : E') * IntermediateField.inclusion hLE' r + N_V
    exact hu_V_coe
  · change N_V = 0 ∨ ((d₂ + 1 : ℕ) : ℤ) ≤ valL F E' N_V
    rw [hd₂_eq]
    exact hN_V_val
  · have hMP := hMP_eq hu_V
    dsimp only at hMP
    rw [hz_V] at hMP
    exact hMP

theorem ld_ch12_wild_dyadic_odd_max_break_higher_cond_res_finset_and_eps_assembly (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (χE' : relWeil F E' →* (Ω F)ˣ)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hmE'_ge2 : 2 ≤ condExp F E' (recChar F rec E' χE'))
    (hmM₁'_ge2 : 2 ≤ condExp F M₁' (recChar F rec M₁' χM₁'))
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E)) *
                ∑ r ∈ R_E,
                  if hr : 1 + (δ : E) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                      ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                  else 0))))
    (hqE' : qL F E' = qL F L)
    (hqM₁' : qL F M₁' = qL F L)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = 2 * valL F L x)
    (hnE' : condExpChar F E' (traceChar F hLE' ψ) =
      2 * condExpChar F L ψ + (condExp F L νE' : ℤ))
    (hnM₁' : condExpChar F M₁' (traceChar F hLM₁' ψ) =
      2 * condExpChar F L ψ + (condExp F L νM₁' : ℤ))
    (heps1_E' : tateEps F E' 1 (traceChar F hLE' ψ) =
      (qL F L : Ω F) ^ condExpChar F E' (traceChar F hLE' ψ))
    (heps1_M₁' : tateEps F M₁' 1 (traceChar F hLM₁' ψ) =
      (qL F L : Ω F) ^ condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_odd : condExp F L νE' % 2 = 1)
    (hm1_ge : 2 * condExp F L νE' ≤ condExp F M₁' (recChar F rec M₁' χM₁'))
    (hm1_even : condExp F M₁' (recChar F rec M₁' χM₁') % 2 = 0)
    (hm2_eq : condExp F E' (recChar F rec E' χE') =
      condExp F M₁' (recChar F rec M₁' χM₁') + condExp F L νM₁' - condExp F L νE')
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (hcard_kL : Fintype.card k_L = qL F L)
    (ϖ_E' : E'ˣ) (ϖ_L : Lˣ)
    (hϖ_E' : valL F E' (ϖ_E' : E') = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hBasis_E' : ∀ y : E', ∃ c : Fin 2 → L,
      y = ∑ i : Fin 2, IntermediateField.inclusion hLE' (c i) * ((ϖ_E' : E') ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F E' y) ↔
          ∀ i : Fin 2, c i = 0 ∨ m ≤ 2 * valL F L (c i) + (i : ℤ))
    (x : M₁') (hx_ne : x ≠ 0)
    (hx_val : valL F M₁' x = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hM₁'_coords : ∀ z : M₁', ∃ s₀ s₁ : L,
      z = IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x ∧
      ∀ m : ℤ, (z = 0 ∨ m ≤ valL F M₁' z) ↔
        ((s₀ = 0 ∨ m ≤ 2 * valL F L s₀) ∧
         (s₁ = 0 ∨ m ≤ 2 * valL F L s₁ + 1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ))))
    (cE' : E'ˣ) (cM₁' : M₁'ˣ) (cνE' cνM₁' : Lˣ) (δ_E' : E'ˣ)
    (hcE'_val : valL F E' (cE' : E') =
      (condExp F E' (recChar F rec E' χE') : ℤ) + condExpChar F E' (traceChar F hLE' ψ))
    (hcE'_stat : ∀ w : E',
      (w = 0 ∨ (((condExp F E' (recChar F rec E' χE') + 1) / 2 : ℕ) : ℤ) ≤ valL F E' w) →
      ∀ hw : 1 + w ≠ 0,
        ((recChar F rec E' χE') (Units.mk0 (1 + w) hw) : Ω F) =
          (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E') * w))
    (hcM₁'_val : valL F M₁' (cM₁' : M₁') =
      (condExp F M₁' (recChar F rec M₁' χM₁') : ℤ) + condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hcM₁'_stat : ∀ z : M₁',
      (z = 0 ∨ (((condExp F M₁' (recChar F rec M₁' χM₁') + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        ((recChar F rec M₁' χM₁') (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁') * z))
    (hcνE'_val : valL F L (cνE' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hcνE'_stat : ∀ u : L, (u = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((cνE'⁻¹ : Lˣ) : L) * u))
    (hcνM₁'_val : valL F L (cνM₁' : L) = (condExp F L νM₁' : ℤ) + condExpChar F L ψ)
    (hcνM₁'_stat : ∀ u : L, (u = 0 ∨ (((condExp F L νM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νM₁' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((cνM₁'⁻¹ : Lˣ) : L) * u))
    (hPrefactor :
      ((recChar F rec E' χE') cE' : Ω F) * (νE' cνE' : Ω F) *
          (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E')) * ψ (((cνE'⁻¹ : Lˣ) : L)) =
        ((recChar F rec M₁' χM₁') cM₁' : Ω F) * (νM₁' cνM₁' : Ω F) *
          (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁')) * ψ (((cνM₁'⁻¹ : Lˣ) : L)))
    (hδ_E'_val : valL F E' (δ_E' : E') = ((condExp F E' (recChar F rec E' χE') / 2 : ℕ) : ℤ))
    (hCritRec : ∀ r : L, (r = 0 ∨ 0 ≤ valL F L r) →
      ∀ (hr_E : 1 + (δ_E' : E') * IntermediateField.inclusion hLE' r ≠ 0)
        (hr_2 : 1 + ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r ^ 2 ≠ 0),
        ((recChar F rec E' χE')
            (Units.mk0 (1 + (δ_E' : E') * IntermediateField.inclusion hLE' r) hr_E) : Ω F)⁻¹ *
          (traceChar F hLE' ψ)
            (((cE'⁻¹ : E'ˣ) : E') * (δ_E' : E') * IntermediateField.inclusion hLE' r) =
        (νE' (Units.mk0 (1 + ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r ^ 2) hr_2) : Ω F) *
          (ψ (((cνE'⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r ^ 2))⁻¹)
    (hNuPolarInv : ∀ (R_L : Finset L),
      R_L.card = Fintype.card k_L →
      (∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r) →
      (∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0) →
      (∑ r ∈ R_L,
        if hr_2 : 1 + ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r ^ 2 ≠ 0 then
          (νE' (Units.mk0 (1 + ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r ^ 2) hr_2) : Ω F) *
            (ψ (((cνE'⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r ^ 2))⁻¹
        else 0) *
      (∑ r ∈ R_L,
        if hr_L : 1 + ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r ≠ 0 then
          (νE' (Units.mk0 (1 + ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r) hr_L) : Ω F)⁻¹ *
            ψ (((cνE'⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r)
        else 0) =
      (Fintype.card k_L : Ω F)) :
    tateEps F E' (recChar F rec E' χE') (traceChar F hLE' ψ) *
      tateEps F M₁' 1 (traceChar F hLM₁' ψ) *
      tateEps F L νE' ψ =
    tateEps F M₁' (recChar F rec M₁' χM₁') (traceChar F hLM₁' ψ) *
      tateEps F E' 1 (traceChar F hLE' ψ) *
      tateEps F L νM₁' ψ :=
by
  classical
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, hval_surj_L, hval_add_L, _, _, _⟩ := hvalL_props
  obtain ⟨hval0_E', hval1_E', hval_neg1_E', hval_neg_E', hval_mul_E',
    hval_inv_E', hval_surj_E', hval_add_E', _, _, _⟩ := hvalE'_props
