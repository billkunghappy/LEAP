          refine (Finset.sum_subset hsub ?_).symm
          intro i hi hni
          rw [Finset.mem_range] at hi hni
          have hgt : f.natDegree < i := by omega
          dsimp only [term]
          rw [Polynomial.coeff_eq_zero_of_natDegree_lt hgt, zero_mul]
        have hterm_m : term m = c₂ g := by
          dsimp only [term]
          have hkm : k - m = n - 2 := by omega
          have hfm_coeff : f.coeff m = 1 := hf.coeff_natDegree
