        rw [← hinc, hval_E'K₁ ((p : ℕ) : E')]
      rw [hv_eq] at hpv
      have hcast : ((p * (p - 1) * (bE' - 1) : ℕ) : ℤ) =
          (p : ℤ) * (((p - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ)) := by
        push_cast; ring
      rw [hcast] at hpv
      have hp_pos_z : (0 : ℤ) < (p : ℤ) := by exact_mod_cast hp_pos
      have hv_ge : ((p - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) ≤ valL F E' ((p : ℕ) : E') :=
        le_of_mul_le_mul_left hpv hp_pos_z
      have hge2 : (2 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) := by
