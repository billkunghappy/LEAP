theorem ld_ch14_wild_conductors_and_cond_zero_endpoint (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hψFi : ∀ i : Fin D_orb.length,
      IsAdmissibleChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ))
    (hDegSum : (∑ i : Fin D_orb.length,
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)
    (χ' : Lˣ →* (Ω F)ˣ)
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (hχ'_cond : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1)
    (hχ'E_cond : ∀ u ∈ unitGroup F E (condExp F E (χ'.comp (Units.map (normLM F hLE)))),
      (χ'.comp (Units.map (normLM F hLE))) u = 1)
    (hμ'_props : ∀ i : Fin D_orb.length,
      Algebra.IsSeparable (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)) ∧
      IsGaloisExt F (D_orb.get i).field M_C ∧
      (μ'_orb i) ^ (p F) = 1 ∧
      μ'_orb i ≠ 1 ∧
      (∀ u ∈ unitGroup F (D_orb.get i).field (condExp F (D_orb.get i).field (μ'_orb i)),
        (μ'_orb i) u = 1) ∧
      (∀ u ∈ unitGroup F (D_orb.get i).field
          (condExp F (D_orb.get i).field
            (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))),
        (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) u = 1) ∧
      ∃ (K_i : IntermediateField F (AlgebraicClosure F))
        (hFiKi : (D_orb.get i).field ≤ K_i) (hKiEi : K_i ≤ E ⊔ (D_orb.get i).field),
        IsGaloisExt F (D_orb.get i).field K_i ∧
        IsAbelianExt F hFiKi ∧
        Module.finrank (D_orb.get i).field (IntermediateField.extendScalars hFiKi) = p F ∧
        (∀ z : ((D_orb.get i).field)ˣ,
          z ∈ Set.range (Units.map (normLM F hFiKi)) ↔ (μ'_orb i) z = 1) ∧
        (∀ w : M_Cˣ,
          w ∈ Set.range (Units.map (normLM F hM_CK)) →
          ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) w = 1) ∧
        ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) ≠ 1)
    (hq_gt1 : 1 < Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hValNormE : ∀ y : E, valL F L (normLM F hLE y) = valL F E y)
    (hValNormK : ∀ w : K, valL F M_C (normLM F hM_CK w) = valL F K w)
    (hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (t k : ℕ) (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k)
    (hk_dvd : k ∣ (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1))
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hValAlgKE : ∀ y : E, valL F K (IntermediateField.inclusion hEK y) = (k : ℤ) * valL F E y)
    (hTrBoundMCL : ∀ (m : ℤ) (z : M_C),
      (z = 0 ∨ (k : ℤ) * m - ((k : ℤ) - 1) ≤ valL F M_C z) →
      (traceLM F hLM_C z = 0 ∨ m ≤ valL F L (traceLM F hLM_C z)))
    (hTrBoundKE : ∀ (m : ℤ) (w : K),
      (w = 0 ∨ (k : ℤ) * m - ((k : ℤ) - 1) ≤ valL F K w) →
      (traceLM F hEK w = 0 ∨ m ≤ valL F E (traceLM F hEK w)))
    (hy₁_MCL : ∃ y₁ : M_C, (y₁ = 0 ∨ 0 ≤ valL F M_C y₁) ∧ traceLM F hLM_C y₁ = 1)
    (hw₁_KE : ∃ w₁ : K, (w₁ = 0 ∨ 0 ≤ valL F K w₁) ∧ traceLM F hEK w₁ = 1)
    (htr_bound_K : ∀ (m : ℤ) (w : K),
      (w = 0 ∨
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * m -
          ((Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K w) →
      (traceLM F hM_CK w = 0 ∨ m ≤ valL F M_C (traceLM F hM_CK w)))
    (htr_surj_K : ∀ z : M_C, ∃ w_z : K,
      traceLM F hM_CK w_z = z ∧
      (z = 0 → w_z = 0) ∧
      (z ≠ 0 →
        w_z ≠ 0 ∧
        valL F K w_z =
          (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z +
            ((Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1 : ℕ) : ℤ) -
            ((Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1 : ℕ) : ℤ) *
              (t + 1 : ℤ)))
    (hnorm_surj_lt : ∀ m < t, ∀ u ∈ unitGroup F M_C m,
      ∃ w ∈ unitGroup F K m,
        (Units.map (normLM F hM_CK) w) * u⁻¹ ∈ unitGroup F M_C (m + 1))
    (hnorm_gt_surj : ∀ r ≥ t + 1, ∀ u ∈ unitGroup F M_C r,
      ∃ w : Kˣ,
        (Units.map (normLM F hM_CK) w) * u⁻¹ ∈ unitGroup F M_C (r + 1))
    (hValAlgFiMC : ∀ i : Fin D_orb.length, ∀ x : (D_orb.get i).field,
      valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
        valL F (D_orb.get i).field x)
    (hFi_unram : ∀ i : Fin D_orb.length,
      (∀ z : M_C,
        valL F (D_orb.get i).field (normLM F (hFiMC i) z) =
          (Module.finrank (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)) : ℤ) *
            valL F M_C z) ∧
      (∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
        (traceLM F (hFiMC i) z = 0 ∨ m ≤ valL F (D_orb.get i).field (traceLM F (hFiMC i) z))) ∧
      (∀ z : M_C, (z = 0 ∨ 1 ≤ valL F M_C z) →
        normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z) = 0 ∨
          2 * valL F M_C z ≤
            valL F (D_orb.get i).field
              (normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z))) ∧
      (∃ y_Fi : M_C, (y_Fi = 0 ∨ 0 ≤ valL F M_C y_Fi) ∧
        traceLM F (hFiMC i) y_Fi = 1) ∧
      ∃ f_i : ℕ,
        1 ≤ f_i ∧
        Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_i ∧
        resDeg F (D_orb.get i).field = f_i * resDeg F L ∧
        (∀ x : (D_orb.get i).field,
          valL F L (normLM F (D_orb.get i).le x) =
            (f_i : ℤ) * valL F (D_orb.get i).field x)) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let r_orb := D_orb.length
    condExpChar F M_C (traceChar F hLM_C ψ) =
      (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1) ∧
    condExpChar F E (traceChar F hLE ψ) =
      (q : ℤ) * condExpChar F L ψ + (((q - 1) / k : ℕ) : ℤ) * ((t : ℤ) + (k : ℤ)) ∧
    (∀ i : Fin r_orb,
      condExp F (D_orb.get i).field (μ'_orb i) = t + 1 ∧
      condExp F M_C ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) = t + 1 ∧
      condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) =
        (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1)) ∧
    (condExp F L χ' = 0 →
      tateEps F E (χ'.comp (Units.map (normLM F hLE))) (traceChar F hLE ψ) *
        tateEps F L 1 ψ *
        (∏ i : Fin r_orb,
          tateEps F (D_orb.get i).field (μ'_orb i) (traceChar F (D_orb.get i).le ψ)) =
      tateEps F E 1 (traceChar F hLE ψ) *
        tateEps F L χ' ψ *
        (∏ i : Fin r_orb,
          tateEps F (D_orb.get i).field
            (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
            (traceChar F (D_orb.get i).le ψ))) :=
by
  classical
  let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  let r_orb := D_orb.length

  
  
  
  have htrace_inc_mul : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (hAB : A ≤ B) (x : A) (z : B),
      traceLM F hAB (IntermediateField.inclusion hAB x * z) = x * traceLM F hAB z := by
    intro A B hAB x z
    let B' := IntermediateField.extendScalars hAB
    letI : Module A A := Semiring.toModule
    have hsmul : toExtendScalars F hAB (IntermediateField.inclusion hAB x * z) =
        x • toExtendScalars F hAB z := by
      rw [map_mul, Algebra.smul_def]
      rfl
    change (Algebra.trace A B') (toExtendScalars F hAB (IntermediateField.inclusion hAB x * z)) =
      x * (Algebra.trace A B') (toExtendScalars F hAB z)
    rw [hsmul]
    exact (Algebra.trace A B').map_smul' x (toExtendScalars F hAB z)

  have hk_mul_div : (k : ℤ) * (((q - 1) / k : ℕ) : ℤ) = (q : ℤ) - 1 := by
    have hnat : k * ((q - 1) / k) = q - 1 := Nat.mul_div_cancel' hk_dvd
    have hint : ((k * ((q - 1) / k) : ℕ) : ℤ) = ((q - 1 : ℕ) : ℤ) := by exact_mod_cast hnat
    rw [Nat.cast_mul] at hint
    omega

  obtain ⟨hnMC, hnE, hnFi⟩ :
      condExpChar F M_C (traceChar F hLM_C ψ) =
        (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1) ∧
      condExpChar F E (traceChar F hLE ψ) =
        (q : ℤ) * condExpChar F L ψ + (((q - 1) / k : ℕ) : ℤ) * ((t : ℤ) + (k : ℤ)) ∧
      (∀ i : Fin r_orb,
        condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) =
          (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1)) := by
    have htrace_trans_aux : ∀ (K₀ A B C : Type u) [Field K₀] [Field A] [Field B] [Field C]
        [Algebra K₀ A] [Algebra K₀ B] [Algebra K₀ C]
        (algAB : Algebra A B) (algBC : Algebra B C) (algAC : Algebra A C)
        (h1 : ∀ x : K₀, @algebraMap A B _ _ algAB (algebraMap K₀ A x) = algebraMap K₀ B x)
        (h2 : ∀ x : A, @algebraMap B C _ _ algBC (@algebraMap A B _ _ algAB x) =
          @algebraMap A C _ _ algAC x)
        [FiniteDimensional K₀ B] (z : C),
        @Algebra.trace A C _ _ algAC z =
          @Algebra.trace A B _ _ algAB (@Algebra.trace B C _ _ algBC z) := by
      intro K₀ A B C _ _ _ _ _ _ _ algAB algBC algAC h1 h2 _ z
      letI : Algebra A B := algAB
      letI : Algebra B C := algBC
      letI : Algebra A C := algAC
      haveI : IsScalarTower K₀ A B := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h1 x).symm)
      haveI : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h2 x).symm)
      haveI : FiniteDimensional A B := Module.Finite.of_restrictScalars_finite K₀ A B
      by_cases hFin : FiniteDimensional B C
      · exact (Algebra.trace_trace z).symm
      · have htr1 : Algebra.trace B C = 0 := by
          apply Algebra.trace_eq_zero_of_not_exists_basis
          rintro ⟨s, ⟨b⟩⟩
          exact hFin (Module.Finite.of_basis b)
        have htr2 : Algebra.trace A C = 0 := by
          apply Algebra.trace_eq_zero_of_not_exists_basis
          rintro ⟨s, ⟨b⟩⟩
          haveI : Module.Finite A C := Module.Finite.of_basis b
          exact hFin (Module.Finite.of_restrictScalars_finite A B C)
        simp [htr1, htr2]

    have htrace_eq_inclusion : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
        (h : A ≤ B) (y : B),
        @Algebra.trace A B _ _ (IntermediateField.inclusion h).toAlgebra y = traceLM F h y := by
      intro A B h y
      letI : Algebra A B := (IntermediateField.inclusion h).toAlgebra
      let e : B ≃ₐ[A] IntermediateField.extendScalars h := {
        toFun := toExtendScalars F h
        invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_mul' := fun _ _ => rfl
        map_add' := fun _ _ => rfl
        commutes' := fun _ => rfl
      }
      exact (Algebra.trace_eq_of_algEquiv e y).symm

    have htrace_trans : ∀ {A B C : IntermediateField F (AlgebraicClosure F)} [FiniteDimensional F B]
        (hAB : A ≤ B) (hBC : B ≤ C) (hAC : A ≤ C) (z : C),
        traceLM F hAC z = traceLM F hAB (traceLM F hBC z) := by
      intro A B C _ hAB hBC hAC z
      have hEq : hAC = hAB.trans hBC := Subsingleton.elim _ _
      subst hEq
      rw [← htrace_eq_inclusion (hAB.trans hBC) z,
          ← htrace_eq_inclusion hBC z,
          ← htrace_eq_inclusion hAB]
      exact htrace_trans_aux F A B C
        (IntermediateField.inclusion hAB).toAlgebra
        (IntermediateField.inclusion hBC).toAlgebra
        (IntermediateField.inclusion (hAB.trans hBC)).toAlgebra
        (fun _ => rfl)
        (fun _ => rfl)
        z

    have htraceChar_trans : ∀ {A B C : IntermediateField F (AlgebraicClosure F)} [FiniteDimensional F B]
        (hAB : A ≤ B) (hBC : B ≤ C) (hAC : A ≤ C) (ψA : AddChar A (Ω F)),
        traceChar F hAC ψA = traceChar F hBC (traceChar F hAB ψA) := by
      intro A B C _ hAB hBC hAC ψA
      ext z
      simp [traceChar, htrace_trans hAB hBC hAC z]

    have hTameCondChar : ∀ (A B : IntermediateField F (AlgebraicClosure F))
        [FiniteDimensional F A] [FiniteDimensional F B]
        (hAB : A ≤ B) (ψA : AddChar A (Ω F))
        (hψA : IsAdmissibleChar F A ψA)
        (hψB : IsAdmissibleChar F B (traceChar F hAB ψA))
        (e : ℕ) (he_ge1 : 1 ≤ e)
        (hValAlg : ∀ x : A, valL F B (IntermediateField.inclusion hAB x) = (e : ℤ) * valL F A x)
        (hTrBound : ∀ (m : ℤ) (z : B),
          (z = 0 ∨ (e : ℤ) * m - ((e : ℤ) - 1) ≤ valL F B z) →
          (traceLM F hAB z = 0 ∨ m ≤ valL F A (traceLM F hAB z)))
        (hy₁ : ∃ y₁ : B, (y₁ = 0 ∨ 0 ≤ valL F B y₁) ∧ traceLM F hAB y₁ = 1),
        condExpChar F B (traceChar F hAB ψA) =
          (e : ℤ) * condExpChar F A ψA + ((e : ℤ) - 1) := by
      intro A B _ _ hAB ψA hψA hψB e he_ge1 hValAlg hTrBound hy₁
      obtain ⟨_, _, _, _, hval_mul_B, _, _, _, _, _, _⟩ := ld_valL_and_unitGroup_props F B
      let ψB := traceChar F hAB ψA
      have hψB_app : ∀ z : B, ψB z = ψA (traceLM F hAB z) := fun _ => rfl
      obtain ⟨hA_triv, ⟨x₁, hx₁_ne0, hx₁_val, hx₁_ψ⟩, _, _⟩ :=
        ld_condExp_and_condExpChar_spec F A ψA hψA 1
      obtain ⟨hB_triv, ⟨z₂, hz₂_ne0, hz₂_val, hz₂_ψ⟩, _, _⟩ :=
        ld_condExp_and_condExpChar_spec F B ψB hψB 1
      let nA := condExpChar F A ψA
      let nB := condExpChar F B ψB
      let N_B : ℤ := (e : ℤ) * nA + ((e : ℤ) - 1)
      have hle1 : N_B ≤ nB := by
        by_contra hlt
        push_neg at hlt
        have hbound : (e : ℤ) * (-nA) - ((e : ℤ) - 1) ≤ valL F B z₂ := by
          have h1 : (e : ℤ) * (-nA) - ((e : ℤ) - 1) = -N_B := by dsimp [N_B]; ring
          change -(nB + 1) ≤ valL F B z₂ at hz₂_val
          omega
        have htr_val := hTrBound (-nA) z₂ (Or.inr hbound)
        have htriv : ψB z₂ = 1 := by
          rw [hψB_app]
          exact hA_triv (traceLM F hAB z₂) htr_val
        exact hz₂_ψ htriv
      have hle2 : nB ≤ N_B := by
        obtain ⟨y₁, hy₁_int, hy₁_tr⟩ := hy₁
        have hy₁_ne0 : y₁ ≠ 0 := by
          intro h0
          rw [h0, map_zero] at hy₁_tr
          exact zero_ne_one hy₁_tr
        have hy₁_val0 : 0 ≤ valL F B y₁ := hy₁_int.resolve_left hy₁_ne0
        have hinc_x₁_ne0 : IntermediateField.inclusion hAB x₁ ≠ 0 :=
          (IntermediateField.inclusion hAB).injective.ne hx₁_ne0
        let z₁ : B := IntermediateField.inclusion hAB x₁ * y₁
        have hz₁_ne0 : z₁ ≠ 0 := mul_ne_zero hinc_x₁_ne0 hy₁_ne0
        have hz₁_val : -(N_B + 1) ≤ valL F B z₁ := by
          dsimp [z₁]
          rw [hval_mul_B _ _ hinc_x₁_ne0 hy₁_ne0, hValAlg x₁]
          have hmul : (e : ℤ) * (-(nA + 1)) ≤ (e : ℤ) * valL F A x₁ :=
            mul_le_mul_of_nonneg_left hx₁_val (by omega)
          have heq : (e : ℤ) * (-(nA + 1)) = -(N_B + 1) := by dsimp [N_B]; ring
          linarith
        have hz₁_ψ : ψB z₁ ≠ 1 := by
          rw [hψB_app]
          dsimp [z₁]
          rw [htrace_inc_mul hAB x₁ y₁, hy₁_tr, mul_one]
          exact hx₁_ψ
        by_contra hlt
        push_neg at hlt
        have htriv : ψB z₁ = 1 :=
          hB_triv z₁ (Or.inr (by change -nB ≤ valL F B z₁; omega))
        exact hz₁_ψ htriv
      exact le_antisymm hle2 hle1

    have hnMC : condExpChar F M_C (traceChar F hLM_C ψ) =
        (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1) :=
      hTameCondChar L M_C hLM_C ψ hψ hψMC k hk_ge1 hValAlgMCL hTrBoundMCL hy₁_MCL

    have hψK_eq_E : traceChar F hLK ψ = traceChar F hEK (traceChar F hLE ψ) :=
      htraceChar_trans hLE hEK hLK ψ

    have hnK_E : condExpChar F K (traceChar F hLK ψ) =
        (k : ℤ) * condExpChar F E (traceChar F hLE ψ) + ((k : ℤ) - 1) := by
      have hψK' : IsAdmissibleChar F K (traceChar F hEK (traceChar F hLE ψ)) := hψK_eq_E ▸ hψK
      rw [hψK_eq_E]
      exact hTameCondChar E K hEK (traceChar F hLE ψ) hψE hψK' k hk_ge1 hValAlgKE hTrBoundKE hw₁_KE

    have hnFi : ∀ i : Fin r_orb,
        condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) =
          (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1) := by
      intro i
      haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
      have hψMC_eq_Fi : traceChar F hLM_C ψ =
          traceChar F (hFiMC i) (traceChar F (D_orb.get i).le ψ) :=
        htraceChar_trans (D_orb.get i).le (hFiMC i) hLM_C ψ
      have hψMC' : IsAdmissibleChar F M_C
          (traceChar F (hFiMC i) (traceChar F (D_orb.get i).le ψ)) :=
        hψMC_eq_Fi ▸ hψMC
      have h1 := hTameCondChar (D_orb.get i).field M_C (hFiMC i)
        (traceChar F (D_orb.get i).le ψ) (hψFi i) hψMC' 1 le_rfl
        (fun x => by rw [Nat.cast_one, one_mul]; exact hValAlgFiMC i x)
        (fun m z hz => (hFi_unram i).2.1 m z (by simpa using hz))
        (hFi_unram i).2.2.2.1
      rw [← hψMC_eq_Fi, hnMC] at h1
      push_cast at h1
      linarith

    have hψK_eq_MC : traceChar F hLK ψ = traceChar F hM_CK (traceChar F hLM_C ψ) :=
      htraceChar_trans hLM_C hM_CK hLK ψ

    have hnK_MC : condExpChar F K (traceChar F hLK ψ) =
        (q : ℤ) * condExpChar F M_C (traceChar F hLM_C ψ) +
          ((q - 1 : ℕ) : ℤ) * (t + 1 : ℤ) := by
      let ψMC := traceChar F hLM_C ψ
      let ψK := traceChar F hLK ψ
      have hψK_app : ∀ w : K, ψK w = ψMC (traceLM F hM_CK w) := by
        intro w
        change (traceChar F hLK ψ) w = _
        rw [hψK_eq_MC]
        rfl
      obtain ⟨hMC_triv, ⟨z₁, hz₁_ne0, hz₁_val, hz₁_ψ⟩, _, _⟩ :=
        ld_condExp_and_condExpChar_spec F M_C ψMC hψMC 1
      obtain ⟨hK_triv, ⟨w₂, hw₂_ne0, hw₂_val, hw₂_ψ⟩, _, _⟩ :=
        ld_condExp_and_condExpChar_spec F K ψK hψK 1
      let nMC := condExpChar F M_C ψMC
      let nK := condExpChar F K ψK
      let N_K : ℤ := (q : ℤ) * nMC + ((q - 1 : ℕ) : ℤ) * (t + 1 : ℤ)
      have hq_sub1 : ((q - 1 : ℕ) : ℤ) = (q : ℤ) - 1 := by omega
      have hle1 : nK ≤ N_K := by
        obtain ⟨w₁, hw₁_tr, _, hw₁_ne_prop⟩ := htr_surj_K z₁
        obtain ⟨hw₁_ne0, hw₁_val_eq⟩ := hw₁_ne_prop hz₁_ne0
        have hw₁_ψ : ψK w₁ ≠ 1 := by
          rw [hψK_app, hw₁_tr]
          exact hz₁_ψ
        have hw₁_val : -(N_K + 1) ≤ valL F K w₁ := by
          change valL F K w₁ =
            (q : ℤ) * valL F M_C z₁ + ((q - 1 : ℕ) : ℤ) - ((q - 1 : ℕ) : ℤ) * (t + 1 : ℤ) at hw₁_val_eq
          rw [hw₁_val_eq]
          have hmul : (q : ℤ) * (-(nMC + 1)) ≤ (q : ℤ) * valL F M_C z₁ :=
            mul_le_mul_of_nonneg_left hz₁_val (by omega)
          have hrhs_eq :
              (q : ℤ) * (-(nMC + 1)) + ((q - 1 : ℕ) : ℤ) - ((q - 1 : ℕ) : ℤ) * (t + 1 : ℤ) =
                -(N_K + 1) := by
            dsimp [N_K]
            rw [hq_sub1]
            ring
          linarith
        by_contra hlt
        push_neg at hlt
        have htriv : ψK w₁ = 1 :=
          hK_triv w₁ (Or.inr (by change -nK ≤ valL F K w₁; omega))
        exact hw₁_ψ htriv
      have hle2 : N_K ≤ nK := by
        by_contra hlt
        push_neg at hlt
        have hbound : (q : ℤ) * (-nMC) - ((q - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K w₂ := by
          have h1 : (q : ℤ) * (-nMC) - ((q - 1 : ℕ) : ℤ) * (t + 1 : ℤ) = -N_K := by
            dsimp [N_K]; ring
          change -(nK + 1) ≤ valL F K w₂ at hw₂_val
          omega
        have htr_val := htr_bound_K (-nMC) w₂ (Or.inr hbound)
        have htriv : ψK w₂ = 1 := by
          rw [hψK_app]
          exact hMC_triv (traceLM F hM_CK w₂) htr_val
        exact hw₂_ψ htriv
      exact le_antisymm hle1 hle2

    have hnE : condExpChar F E (traceChar F hLE ψ) =
        (q : ℤ) * condExpChar F L ψ + (((q - 1) / k : ℕ) : ℤ) * ((t : ℤ) + (k : ℤ)) := by
      have hq_sub1 : ((q - 1 : ℕ) : ℤ) = (q : ℤ) - 1 := by omega
      have hEq := hnK_E.symm.trans hnK_MC
      rw [hnMC, hq_sub1, ← hk_mul_div] at hEq
      have hk_ne0 : (k : ℤ) ≠ 0 := by omega
      apply mul_left_cancel₀ hk_ne0
      linear_combination hEq - ((k : ℤ) - 1) * hk_mul_div

    exact ⟨hnMC, hnE, hnFi⟩

  
  
  
  have hFi_mult : ∀ i : Fin r_orb,
      condExp F (D_orb.get i).field (μ'_orb i) = t + 1 ∧
      condExp F M_C ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) = t + 1 := by
    obtain ⟨hval0_MC, hval1_MC, hval_neg1_MC, hval_neg_MC, hval_mul_MC, hval_inv_MC, hval_surj_MC,
      hval_add_MC, hunit0_MC, hunit_ge1_MC, hunit_val0_MC⟩ := ld_valL_and_unitGroup_props F M_C
    have hval_surj_K := (ld_valL_and_unitGroup_props F K).2.2.2.2.2.2.1

    have hunit_anti_MC : ∀ {m₁ m₂ : ℕ}, m₁ ≤ m₂ → unitGroup F M_C m₂ ≤ unitGroup F M_C m₁ := by
      intro m₁ m₂ hle u hu
      by_cases hm₁ : m₁ = 0
      · subst hm₁
        exact (hunit0_MC u).mpr (hunit_val0_MC m₂ u hu)
      · rw [hunit_ge1_MC m₁ (by omega) u]
        rcases (hunit_ge1_MC m₂ (by omega) u).mp hu with h1 | hge
        · exact Or.inl h1
        · exact Or.inr (le_trans (by exact_mod_cast hle) hge)

    have hval_pow_MC : ∀ (u : M_Cˣ) (n : ℕ),
        valL F M_C (((u ^ n : M_Cˣ) : M_C)) = (n : ℤ) * valL F M_C (u : M_C) := by
      intro u n
      induction n with
      | zero => rw [pow_zero, Units.val_one, hval1_MC, Nat.cast_zero, zero_mul]
      | succ n ih =>
        rw [pow_succ', Units.val_mul, hval_mul_MC (u : M_C) _ (Units.ne_zero u) (Units.ne_zero _), ih]
        push_cast
        ring

    intro i
    let Fi := (D_orb.get i).field
    haveI : FiniteDimensional F Fi := hFinFi i
    obtain ⟨hval0_Fi, hval1_Fi, hval_neg1_Fi, hval_neg_Fi, hval_mul_Fi, hval_inv_Fi, _,
      hval_add_Fi, hunit0_Fi, hunit_ge1_Fi, hunit_val0_Fi⟩ := ld_valL_and_unitGroup_props F Fi
    have hunit_anti_Fi : ∀ {m₁ m₂ : ℕ}, m₁ ≤ m₂ → unitGroup F Fi m₂ ≤ unitGroup F Fi m₁ := by
      intro m₁ m₂ hle u hu
      by_cases hm₁ : m₁ = 0
      · subst hm₁
        exact (hunit0_Fi u).mpr (hunit_val0_Fi m₂ u hu)
      · rw [hunit_ge1_Fi m₁ (by omega) u]
        rcases (hunit_ge1_Fi m₂ (by omega) u).mp hu with h1 | hge
        · exact Or.inl h1
        · exact Or.inr (le_trans (by exact_mod_cast hle) hge)
    obtain ⟨_, _, _, _, hμ_triv, _, ⟨_, _, _, _, _, _, _, hν_norm_triv, hν_ne1⟩⟩ := hμ'_props i
    obtain ⟨hValNormFiMC, hTrBoundFiMC, hNormLinFiMC, ⟨y_Fi, hy_Fi_int, hy_Fi_tr⟩, _⟩ := hFi_unram i
    let μ' := μ'_orb i
    let ν := μ'.comp (Units.map (normLM F (hFiMC i)))
    let b := condExp F Fi μ'
    let c := condExp F M_C ν

    
    have hnorm_unit_FiMC : ∀ (m : ℕ), ∀ w ∈ unitGroup F M_C m,
        Units.map (normLM F (hFiMC i)) w ∈ unitGroup F Fi m := by
      intro m w hw
      by_cases hm : m = 0
      · subst hm
        rw [hunit0_Fi]
        have hw0 : valL F M_C (w : M_C) = 0 := (hunit0_MC w).mp hw
        change valL F Fi (normLM F (hFiMC i) (w : M_C)) = 0
        rw [hValNormFiMC (w : M_C), hw0, mul_zero]
      · have hm_ge1 : 1 ≤ m := by omega
        rw [hunit_ge1_Fi m hm_ge1]
        by_cases hw1 : (w : M_C) = 1
        · have hw_eq1 : w = 1 := Units.ext hw1
          rw [hw_eq1, map_one, Units.val_one]
          exact Or.inl rfl
        · have hw_ge : (m : ℤ) ≤ valL F M_C ((w : M_C) - 1) :=
            ((hunit_ge1_MC m hm_ge1 w).mp hw).resolve_left hw1
          let z : M_C := (w : M_C) - 1
          have hz_ge_m : (m : ℤ) ≤ valL F M_C z := hw_ge
          have hz_ge1 : 1 ≤ valL F M_C z := by omega
          have htr_m : traceLM F (hFiMC i) z = 0 ∨
              (m : ℤ) ≤ valL F Fi (traceLM F (hFiMC i) z) :=
            hTrBoundFiMC (m : ℤ) z (Or.inr hz_ge_m)
          let δ : Fi := normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z)
          have hδ_m : δ = 0 ∨ (m : ℤ) ≤ valL F Fi δ := by
            rcases hNormLinFiMC z (Or.inr hz_ge1) with h0 | h2z
            · exact Or.inl h0
            · right
              change 2 * valL F M_C z ≤ valL F Fi δ at h2z
              omega
          have hadd := hval_add_Fi (m : ℤ) (traceLM F (hFiMC i) z) δ htr_m hδ_m
          have hsum_eq : traceLM F (hFiMC i) z + δ =
              ((Units.map (normLM F (hFiMC i)) w : Fiˣ) : Fi) - 1 := by
            change traceLM F (hFiMC i) z +
              (normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z)) =
              normLM F (hFiMC i) (w : M_C) - 1
            have hw_z : 1 + z = (w : M_C) := by dsimp [z]; ring
            rw [hw_z]
            ring
          rw [hsum_eq] at hadd
          rcases hadd with h0 | hge
          · exact Or.inl (sub_eq_zero.mp h0)
          · exact Or.inr hge

    have hν_triv_b : ∀ w ∈ unitGroup F M_C b, ν w = 1 := by
      intro w hw
      exact hμ_triv (Units.map (normLM F (hFiMC i)) w) (hnorm_unit_FiMC b w hw)

    have hdesc_MC_step : ∀ (r : ℕ), t + 1 ≤ r →
        (∀ v ∈ unitGroup F M_C (r + 1), ν v = 1) →
        (∀ u ∈ unitGroup F M_C r, ν u = 1) := by
      intro r hr htriv u hu
      obtain ⟨w, hnorm_u⟩ := hnorm_gt_surj r hr u hu
      let v : M_Cˣ := (Units.map (normLM F hM_CK) w) * u⁻¹
      have hν_v : ν v = 1 := htriv v hnorm_u
      have hν_nw : ν (Units.map (normLM F hM_CK) w) = 1 :=
        hν_norm_triv _ ⟨w, rfl⟩
      have hu_eq : u = v⁻¹ * Units.map (normLM F hM_CK) w := by
        dsimp [v]
        rw [mul_inv_rev, inv_inv, inv_mul_cancel_right]
      rw [hu_eq, map_mul, map_inv, hν_v, hν_nw, inv_one, mul_one]

    have hdesc_MC : ∀ (d : ℕ),
        (∀ v ∈ unitGroup F M_C (t + 1 + d), ν v = 1) →
        (∀ u ∈ unitGroup F M_C (t + 1), ν u = 1) := by
      intro d
      induction d with
      | zero => intro h; simpa using h
      | succ d ih =>
        intro h
        apply ih
        exact hdesc_MC_step (t + 1 + d) (by omega) h

    have hν_triv_t1 : ∀ u ∈ unitGroup F M_C (t + 1), ν u = 1 := by
      by_cases hb_le : b ≤ t + 1
      · intro u hu
        exact hν_triv_b u (hunit_anti_MC hb_le hu)
      · apply hdesc_MC (b - (t + 1))
        intro v hv
        have heq : t + 1 + (b - (t + 1)) = b := by omega
        rw [heq] at hv
        exact hν_triv_b v hv

    have hc_le_t1 : c ≤ t + 1 := Nat.sInf_le hν_triv_t1
    have hν_triv_c : ∀ u ∈ unitGroup F M_C c, ν u = 1 :=
      Nat.sInf_mem (s := {a : ℕ | ∀ u ∈ unitGroup F M_C a, ν u = 1}) ⟨t + 1, hν_triv_t1⟩

    
    have hdesc_lt_step : ∀ (m : ℕ), m < t →
        (∀ v ∈ unitGroup F M_C (m + 1), ν v = 1) →
        (∀ u ∈ unitGroup F M_C m, ν u = 1) := by
      intro m hm htriv u hu
      obtain ⟨w, _, hnorm_u⟩ := hnorm_surj_lt m hm u hu
      let v : M_Cˣ := (Units.map (normLM F hM_CK) w) * u⁻¹
      have hν_v : ν v = 1 := htriv v hnorm_u
      have hν_nw : ν (Units.map (normLM F hM_CK) w) = 1 :=
        hν_norm_triv _ ⟨w, rfl⟩
      have hu_eq : u = v⁻¹ * Units.map (normLM F hM_CK) w := by
        dsimp [v]
        rw [mul_inv_rev, inv_inv, inv_mul_cancel_right]
      rw [hu_eq, map_mul, map_inv, hν_v, hν_nw, inv_one, mul_one]

    have hdesc_lt_MC : ∀ (d : ℕ), d ≤ t →
        (∀ v ∈ unitGroup F M_C t, ν v = 1) →
        (∀ u ∈ unitGroup F M_C (t - d), ν u = 1) := by
      intro d hd htriv_t
      induction d with
      | zero => simpa using htriv_t
      | succ d ih =>
        have hih := ih (by omega)
        have hstep := hdesc_lt_step (t - (d + 1)) (by omega)
        have hsub : t - (d + 1) + 1 = t - d := by omega
        rw [hsub] at hstep
        exact hstep hih

    have hν_not_triv_0 : ¬ (∀ u ∈ unitGroup F M_C 0, ν u = 1) := by
      intro htriv0
      apply hν_ne1
      ext z
      rw [MonoidHom.one_apply]
      obtain ⟨ϖ_K, hϖ_K_val⟩ := hval_surj_K 1
      let ϖ_MC : M_Cˣ := Units.map (normLM F hM_CK) ϖ_K
      have hϖ_MC_val : valL F M_C (ϖ_MC : M_C) = 1 := by
        change valL F M_C (normLM F hM_CK (ϖ_K : K)) = 1
        rw [hValNormK (ϖ_K : K), hϖ_K_val]
      have hν_ϖ : ν ϖ_MC = 1 := hν_norm_triv ϖ_MC ⟨ϖ_K, rfl⟩
      by_cases hz_nonneg : 0 ≤ valL F M_C (z : M_C)
      · let n : ℕ := (valL F M_C (z : M_C)).toNat
        have hn_eq : (n : ℤ) = valL F M_C (z : M_C) := Int.toNat_of_nonneg hz_nonneg
        let u : M_Cˣ := z * (ϖ_MC ^ n)⁻¹
        have hu_val0 : valL F M_C (u : M_C) = 0 := by
          change valL F M_C ((z : M_C) * (((ϖ_MC ^ n)⁻¹ : M_Cˣ) : M_C)) = 0
          rw [hval_mul_MC (z : M_C) _ (Units.ne_zero z) (Units.ne_zero _),
            hval_inv_MC (ϖ_MC ^ n), hval_pow_MC ϖ_MC n, hϖ_MC_val]
          omega
        have hν_u : ν u = 1 := htriv0 u ((hunit0_MC u).mpr hu_val0)
        have hz_eq : z = u * ϖ_MC ^ n := by
          dsimp [u]
          exact (inv_mul_cancel_right z (ϖ_MC ^ n)).symm
        rw [hz_eq, map_mul, map_pow, hν_u, hν_ϖ, one_pow, mul_one]
      · have hz_neg : valL F M_C (z : M_C) < 0 := lt_of_not_ge hz_nonneg
        let n : ℕ := (-valL F M_C (z : M_C)).toNat
        have hn_eq : (n : ℤ) = -valL F M_C (z : M_C) := Int.toNat_of_nonneg (by omega)
        let u : M_Cˣ := z * ϖ_MC ^ n
        have hu_val0 : valL F M_C (u : M_C) = 0 := by
          change valL F M_C ((z : M_C) * ((ϖ_MC ^ n : M_Cˣ) : M_C)) = 0
          rw [hval_mul_MC (z : M_C) _ (Units.ne_zero z) (Units.ne_zero _),
            hval_pow_MC ϖ_MC n, hϖ_MC_val]
          omega
        have hν_u : ν u = 1 := htriv0 u ((hunit0_MC u).mpr hu_val0)
        have hz_eq : z = u * (ϖ_MC ^ n)⁻¹ := by
          dsimp [u]
          exact (mul_inv_cancel_right z (ϖ_MC ^ n)).symm
        rw [hz_eq, map_mul, map_inv, map_pow, hν_u, hν_ϖ, one_pow, inv_one, mul_one]

    have ht1_le_c : t + 1 ≤ c := by
      by_contra hlt
      have hc_le_t : c ≤ t := by omega
      have hν_triv_t : ∀ v ∈ unitGroup F M_C t, ν v = 1 :=
        fun v hv => hν_triv_c v (hunit_anti_MC hc_le_t hv)
      have hν_triv_0 : ∀ u ∈ unitGroup F M_C 0, ν u = 1 := by
        have h := hdesc_lt_MC t le_rfl hν_triv_t
        rw [Nat.sub_self] at h
        exact h
      exact hν_not_triv_0 hν_triv_0

    have hc_eq : c = t + 1 := le_antisymm hc_le_t1 ht1_le_c

    
    have hy_Fi_ne0 : y_Fi ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hy_Fi_tr
      exact zero_ne_one hy_Fi_tr
    have hy_Fi_val0 : 0 ≤ valL F M_C y_Fi := hy_Fi_int.resolve_left hy_Fi_ne0

    have hunram_unit_surj : ∀ (r : ℕ), 1 ≤ r → ∀ u ∈ unitGroup F Fi r,
        ∃ w ∈ unitGroup F M_C r,
          (Units.map (normLM F (hFiMC i)) w) * u⁻¹ ∈ unitGroup F Fi (r + 1) := by
      intro r hr_ge1 u hu
      by_cases hu1 : (u : Fi) = 1
      · have hu_eq1 : u = 1 := Units.ext hu1
        refine ⟨1, Subgroup.one_mem _, ?_⟩
        rw [hu_eq1, map_one, inv_one, mul_one]
        exact Subgroup.one_mem _
      · have hu_ge : (r : ℤ) ≤ valL F Fi ((u : Fi) - 1) :=
          ((hunit_ge1_Fi r hr_ge1 u).mp hu).resolve_left hu1
        let x : Fi := (u : Fi) - 1
        have hx_ne0 : x ≠ 0 := sub_ne_zero.mpr hu1
        let x_MC : M_C := IntermediateField.inclusion (hFiMC i) x
        have hinc_x_ne0 : x_MC ≠ 0 :=
          (IntermediateField.inclusion (hFiMC i)).injective.ne hx_ne0
        let z : M_C := x_MC * y_Fi
        have hz_ne0 : z ≠ 0 := mul_ne_zero hinc_x_ne0 hy_Fi_ne0
        have hz_val_eq : valL F M_C z = valL F Fi x + valL F M_C y_Fi :=
          (hval_mul_MC x_MC y_Fi hinc_x_ne0 hy_Fi_ne0).trans
            (congrArg (· + valL F M_C y_Fi) (hValAlgFiMC i x))
        have hz_val : (r : ℤ) ≤ valL F M_C z := by
          have hx_ge : (r : ℤ) ≤ valL F Fi x := hu_ge
          linarith
        have hz_ge1 : 1 ≤ valL F M_C z := by omega
        have h1z_ne0 : 1 + z ≠ 0 := by
          intro h0
          have hz_eq_neg1 : z = -1 := eq_neg_of_add_eq_zero_right h0
          have hval_z0 : valL F M_C z = 0 := by rw [hz_eq_neg1, hval_neg1_MC]
          omega
        let w : M_Cˣ := Units.mk0 (1 + z) h1z_ne0
        have hw_mem : w ∈ unitGroup F M_C r := by
          rw [hunit_ge1_MC r hr_ge1 w]
          right
          have hw_sub : (w : M_C) - 1 = z := by
            change (1 + z) - 1 = z
            ring
          rw [hw_sub]
          exact hz_val
        have htr_z : traceLM F (hFiMC i) z = x :=
          (htrace_inc_mul (hFiMC i) x y_Fi).trans (by rw [hy_Fi_tr, mul_one])
        have h1tr_z : 1 + traceLM F (hFiMC i) z = (u : Fi) := by
          rw [htr_z]
          dsimp [x]
          ring
        let δ : Fi := normLM F (hFiMC i) (1 + z) - (u : Fi)
        have hδ_val : δ = 0 ∨ (r + 1 : ℤ) ≤ valL F Fi δ := by
          have hlin := hNormLinFiMC z (Or.inr hz_ge1)
          rw [h1tr_z] at hlin
          rcases hlin with h0 | h2z
          · exact Or.inl h0
          · right
            change 2 * valL F M_C z ≤ valL F Fi δ at h2z
            omega
        let v : Fiˣ := (Units.map (normLM F (hFiMC i)) w) * u⁻¹
        have hv_mem : v ∈ unitGroup F Fi (r + 1) := by
          rw [hunit_ge1_Fi (r + 1) (by omega) v]
          have hv_sub : (v : Fi) - 1 = δ * ((u⁻¹ : Fiˣ) : Fi) := by
            have hu_inv : (u : Fi) * ((u⁻¹ : Fiˣ) : Fi) = 1 := Units.mul_inv u
            calc (v : Fi) - 1 =
                  normLM F (hFiMC i) (1 + z) * ((u⁻¹ : Fiˣ) : Fi) -
                    (u : Fi) * ((u⁻¹ : Fiˣ) : Fi) := by
                  rw [hu_inv]; rfl
              _ = δ * ((u⁻¹ : Fiˣ) : Fi) := by
                  dsimp [δ]; ring
          rw [hv_sub]
          rcases hδ_val with hδ0 | hδ_ge
          · left
            have h0 : δ * ((u⁻¹ : Fiˣ) : Fi) = 0 := by rw [hδ0, zero_mul]
            exact sub_eq_zero.mp (by rw [hv_sub, h0])
          · right
            have hδ_ne0 : δ ≠ 0 := by
              intro h0
              rw [h0, hval0_Fi] at hδ_ge
              omega
            have hu_inv_val0 : valL F Fi ((u⁻¹ : Fiˣ) : Fi) = 0 := by
              rw [hval_inv_Fi u, hunit_val0_Fi r u hu, neg_zero]
            rw [hval_mul_Fi δ _ hδ_ne0 (Units.ne_zero u⁻¹), hu_inv_val0]
            omega
        exact ⟨w, hw_mem, hv_mem⟩

    have hdesc_Fi_step : ∀ (r : ℕ), t + 1 ≤ r →
        (∀ v ∈ unitGroup F Fi (r + 1), μ' v = 1) →
        (∀ u ∈ unitGroup F Fi r, μ' u = 1) := by
      intro r hr htriv u hu
      obtain ⟨w, hw_mem, hnorm_u⟩ := hunram_unit_surj r (by omega) u hu
      let v : Fiˣ := (Units.map (normLM F (hFiMC i)) w) * u⁻¹
      have hμ_v : μ' v = 1 := htriv v hnorm_u
      have hw_t1 : w ∈ unitGroup F M_C (t + 1) := hunit_anti_MC hr hw_mem
      have hμ_nw : μ' (Units.map (normLM F (hFiMC i)) w) = 1 := hν_triv_t1 w hw_t1
      have hu_eq : u = v⁻¹ * Units.map (normLM F (hFiMC i)) w := by
        dsimp [v]
        rw [mul_inv_rev, inv_inv, inv_mul_cancel_right]
      rw [hu_eq, map_mul, map_inv, hμ_v, hμ_nw, inv_one, mul_one]

    have hdesc_Fi : ∀ (d : ℕ),
        (∀ v ∈ unitGroup F Fi (t + 1 + d), μ' v = 1) →
        (∀ u ∈ unitGroup F Fi (t + 1), μ' u = 1) := by
      intro d
      induction d with
      | zero => intro h; simpa using h
      | succ d ih =>
        intro h
        apply ih
        exact hdesc_Fi_step (t + 1 + d) (by omega) h

    have hμ_triv_t1 : ∀ u ∈ unitGroup F Fi (t + 1), μ' u = 1 := by
      by_cases hb_le : b ≤ t + 1
      · intro u hu
        exact hμ_triv u (hunit_anti_Fi hb_le hu)
      · apply hdesc_Fi (b - (t + 1))
        intro v hv
        have heq : t + 1 + (b - (t + 1)) = b := by omega
        rw [heq] at hv
        exact hμ_triv v hv

    have hb_le_t1 : b ≤ t + 1 := Nat.sInf_le hμ_triv_t1
    have hc_le_b : c ≤ b := Nat.sInf_le hν_triv_b
    have hb_eq : b = t + 1 := by omega
    exact ⟨hb_eq, hc_eq⟩

  
  
  
  refine ⟨hnMC, hnE, fun i => ⟨(hFi_mult i).1, (hFi_mult i).2, hnFi i⟩, fun ha0 => ?_⟩
  obtain ⟨hval0_L, hval1_L, _, _, hval_mul_L, hval_inv_L, _,
    _, hunit0_L, _, _⟩ := ld_valL_and_unitGroup_props F L
  obtain ⟨_, _, _, _, _, _, _, _, hunit0_E, _, _⟩ := ld_valL_and_unitGroup_props F E

  have hχ'_triv0 : ∀ u ∈ unitGroup F L 0, χ' u = 1 := by
    intro u hu
    exact hχ'_cond u (by rw [ha0]; exact hu)
  have hχ'_val0 : ∀ u : Lˣ, valL F L (u : L) = 0 → χ' u = 1 :=
    fun u hu => hχ'_triv0 u ((hunit0_L u).mpr hu)

  let nL := condExpChar F L ψ
  let ψE := traceChar F hLE ψ
  let nE := condExpChar F E ψE
  let χ'E : Eˣ →* (Ω F)ˣ := χ'.comp (Units.map (normLM F hLE))

  have hcond_1L : condExp F L 1 = 0 :=
    Nat.eq_zero_of_le_zero (Nat.sInf_le (fun _ _ => rfl))
  have hcond_1E : condExp F E 1 = 0 :=
    Nat.eq_zero_of_le_zero (Nat.sInf_le (fun _ _ => rfl))
  have hcond_χ'E : condExp F E χ'E = 0 := by
    apply Nat.eq_zero_of_le_zero
    apply Nat.sInf_le
    intro w hw
    have hw0 : valL F E (w : E) = 0 := (hunit0_E w).mp hw
    have hnw0 : valL F L ((Units.map (normLM F hLE) w : Lˣ) : L) = 0 := by
      change valL F L (normLM F hLE (w : E)) = 0
      rw [hValNormE (w : E), hw0]
    exact hχ'_val0 (Units.map (normLM F hLE) w) hnw0

  let c₀ : Lˣ := tateElt F L 1 ψ
  have hc₀_val : valL F L (c₀ : L) = nL := by
    have h := (ld_condExp_and_condExpChar_spec F L ψ hψ 1).2.2.2
    rw [hcond_1L, Nat.cast_zero, zero_add] at h
    exact h
  have htate_L : tateEps F L χ' ψ = (χ' c₀ : Ω F) * tateEps F L 1 ψ := by
    have hc_χ' : tateElt F L χ' ψ = c₀ := by
      dsimp [c₀]; unfold tateElt; rw [ha0, hcond_1L]
    have h1 : tateEps F L χ' ψ = (qL F L : Ω F) ^ nL * (χ' c₀ : Ω F) := by
      unfold tateEps; rw [if_pos ha0, hc_χ']
    have h2 : tateEps F L 1 ψ = (qL F L : Ω F) ^ nL * 1 := by
      unfold tateEps; rw [if_pos hcond_1L, MonoidHom.one_apply, Units.val_one]
    rw [h1, h2]
    ring

  let cE : Eˣ := tateElt F E 1 ψE
  let vE : Lˣ := Units.map (normLM F hLE) cE
  have hcE_val : valL F E (cE : E) = nE := by
    have h := (ld_condExp_and_condExpChar_spec F E ψE hψE 1).2.2.2
    rw [hcond_1E, Nat.cast_zero, zero_add] at h
    exact h
  have hvE_val : valL F L (vE : L) = nE := by
    change valL F L (normLM F hLE (cE : E)) = nE
    rw [hValNormE (cE : E), hcE_val]
  have htate_E : tateEps F E χ'E ψE = (χ' vE : Ω F) * tateEps F E 1 ψE := by
    have hc_χ'E : tateElt F E χ'E ψE = cE := by
      dsimp [cE]; unfold tateElt; rw [hcond_χ'E, hcond_1E]
    have h1 : tateEps F E χ'E ψE = (qL F E : Ω F) ^ nE * (χ' vE : Ω F) := by
      unfold tateEps; rw [if_pos hcond_χ'E, hc_χ'E]; rfl
    have h2 : tateEps F E 1 ψE = (qL F E : Ω F) ^ nE * 1 := by
      unfold tateEps; rw [if_pos hcond_1E, MonoidHom.one_apply, Units.val_one]
    rw [h1, h2]
    ring

  let f_orb : Fin r_orb → ℕ := fun i => ((hFi_unram i).2.2.2.2).choose
  have hf_deg : ∀ i : Fin r_orb,
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_orb i :=
    fun i => ((hFi_unram i).2.2.2.2).choose_spec.2.1
  have hf_norm : ∀ i : Fin r_orb, ∀ x : (D_orb.get i).field,
      valL F L (normLM F (D_orb.get i).le x) =
        (f_orb i : ℤ) * valL F (D_orb.get i).field x :=
    fun i => ((hFi_unram i).2.2.2.2).choose_spec.2.2.2

  let c_orb : ∀ i : Fin r_orb, ((D_orb.get i).field)ˣ :=
    fun i => tateElt F (D_orb.get i).field (μ'_orb i) (traceChar F (D_orb.get i).le ψ)
  let v_orb : Fin r_orb → Lˣ :=
    fun i => Units.map (normLM F (D_orb.get i).le) (c_orb i)

  have htate_Fi : ∀ i : Fin r_orb,
      tateEps F (D_orb.get i).field
        (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
        (traceChar F (D_orb.get i).le ψ) =
      (χ' (v_orb i) : Ω F) *
        tateEps F (D_orb.get i).field (μ'_orb i) (traceChar F (D_orb.get i).le ψ) ∧
      valL F L (v_orb i : L) =
        (f_orb i : ℤ) * ((k : ℤ) * nL + (t : ℤ) + (k : ℤ)) := by
    intro i
    let Fi := (D_orb.get i).field
    haveI : FiniteDimensional F Fi := hFinFi i
    obtain ⟨_, _, _, _, _, _, _, _, hunit0_Fi, _, hunit_val0_Fi⟩ :=
      ld_valL_and_unitGroup_props F Fi
    obtain ⟨_, _, _, _, hμ_triv, hμχ_triv, _⟩ := hμ'_props i
    let ψFi := traceChar F (D_orb.get i).le ψ
    let nFi := condExpChar F Fi ψFi
    let μ' := μ'_orb i
    let χ'Fi : Fiˣ →* (Ω F)ˣ := χ'.comp (Units.map (normLM F (D_orb.get i).le))
    have hχ'Fi_val0 : ∀ u : Fiˣ, valL F Fi (u : Fi) = 0 → χ'Fi u = 1 := by
      intro u hu0
      apply hχ'_val0
      change valL F L (normLM F (D_orb.get i).le (u : Fi)) = 0
      rw [hf_norm i (u : Fi), hu0, mul_zero]
    have hχ'Fi_unit : ∀ (m : ℕ), ∀ u ∈ unitGroup F Fi m, χ'Fi u = 1 :=
      fun m u hu => hχ'Fi_val0 u (hunit_val0_Fi m u hu)
    have hcond_μ : condExp F Fi μ' = t + 1 := (hFi_mult i).1
    have hcond_μχ : condExp F Fi (μ' * χ'Fi) = t + 1 := by
      rw [← hcond_μ]
      apply le_antisymm
      · apply Nat.sInf_le
        intro u hu
        rw [MonoidHom.mul_apply, hμ_triv u hu, hχ'Fi_unit _ u hu, mul_one]
      · apply Nat.sInf_le
        intro u hu
        have h1 := hμχ_triv u hu
        rw [MonoidHom.mul_apply, hχ'Fi_unit _ u hu, mul_one] at h1
        exact h1
    have ht1_ge1 : 1 ≤ t + 1 := by omega
    have ht1_ne0 : t + 1 ≠ 0 := by omega
    have hFinFi_coset := ld_unitCoset_finite F Fi (t + 1) ht1_ge1
    have hfin_sum : ∀ (f : Fiˣ ⧸ unitGroup F Fi (t + 1) → Ω F),
        (∑ᶠ (u : Fiˣ ⧸ unitGroup F Fi (t + 1)) (_ : valL F Fi ((cosetRep u : Fiˣ) : Fi) = 0), f u) =
        ∑ u ∈ hFinFi_coset.toFinset, f u :=
      fun f => finsum_mem_eq_finite_toFinset_sum f hFinFi_coset
    have htateEps_eq_of_cond : ∀ (θ : Fiˣ →* (Ω F)ˣ) (m : ℕ) (c : Fiˣ),
        condExp F Fi θ = m → tateElt F Fi θ ψFi = c →
        tateEps F Fi θ ψFi =
          (qL F Fi : Ω F) ^ nFi *
            if m = 0 then (θ c : Ω F)
            else
              ∑ᶠ (u : Fiˣ ⧸ unitGroup F Fi m) (_ : valL F Fi ((cosetRep u : Fiˣ) : Fi) = 0),
                ((θ (c⁻¹ * (cosetRep u : Fiˣ)) : Ω F)⁻¹ *
                  ψFi (((c⁻¹ * (cosetRep u : Fiˣ) : Fiˣ) : Fi))) := by
      intro θ m c hm hc
      subst hm
      subst hc
      rfl
    let ci : Fiˣ := tateElt F Fi μ' ψFi
    have hci_eq : tateElt F Fi (μ' * χ'Fi) ψFi = ci := by
      dsimp [ci]
      unfold tateElt
      rw [hcond_μχ, hcond_μ]
    have hci_val : valL F Fi (ci : Fi) = (t + 1 : ℤ) + nFi := by
      have h := (ld_condExp_and_condExpChar_spec F Fi ψFi (hψFi i) μ').2.2.2
      rw [hcond_μ] at h
      exact_mod_cast h
    have hvi_val : valL F L (v_orb i : L) =
        (f_orb i : ℤ) * ((k : ℤ) * nL + (t : ℤ) + (k : ℤ)) := by
      change valL F L (normLM F (D_orb.get i).le (ci : Fi)) = _
      rw [hf_norm i (ci : Fi), hci_val]
      have hnFi_i : nFi = (k : ℤ) * nL + ((k : ℤ) - 1) := hnFi i
      rw [hnFi_i]
      ring
    refine ⟨?_, hvi_val⟩
    rw [htateEps_eq_of_cond (μ' * χ'Fi) (t + 1) ci hcond_μχ hci_eq,
      htateEps_eq_of_cond μ' (t + 1) ci hcond_μ rfl,
      if_neg ht1_ne0, if_neg ht1_ne0, hfin_sum, hfin_sum]
    have hsum_eq :
        ∑ u ∈ hFinFi_coset.toFinset,
          ((((μ' * χ'Fi) (ci⁻¹ * cosetRep u) : (Ω F)ˣ) : Ω F)⁻¹ *
            ψFi (((ci⁻¹ * cosetRep u : Fiˣ) : Fi))) =
        (χ' (v_orb i) : Ω F) *
          ∑ u ∈ hFinFi_coset.toFinset,
            (((μ' (ci⁻¹ * cosetRep u) : (Ω F)ˣ) : Ω F)⁻¹ *
              ψFi (((ci⁻¹ * cosetRep u : Fiˣ) : Fi))) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro u hu
      have hu_val0 : valL F Fi ((cosetRep u : Fiˣ) : Fi) = 0 :=
        (Set.Finite.mem_toFinset hFinFi_coset).mp hu
      have hχ'Fi_u : χ'Fi (cosetRep u) = 1 := hχ'Fi_val0 (cosetRep u) hu_val0
      have hterm : (μ' * χ'Fi) (ci⁻¹ * cosetRep u) =
          (χ' (v_orb i))⁻¹ * μ' (ci⁻¹ * cosetRep u) := by
        change μ' (ci⁻¹ * cosetRep u) * χ'Fi (ci⁻¹ * cosetRep u) =
          (χ'Fi ci)⁻¹ * μ' (ci⁻¹ * cosetRep u)
        rw [map_mul χ'Fi, hχ'Fi_u, mul_one, map_inv, mul_comm]
      rw [hterm, Units.val_mul, mul_inv, Units.val_inv_eq_inv_val, inv_inv]
      ring
    rw [hsum_eq]
    ring

  have hprod_Fi :
      (∏ i : Fin r_orb,
        tateEps F (D_orb.get i).field
          (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
          (traceChar F (D_orb.get i).le ψ)) =
      (χ' (∏ i : Fin r_orb, v_orb i) : Ω F) *
        (∏ i : Fin r_orb,
          tateEps F (D_orb.get i).field (μ'_orb i) (traceChar F (D_orb.get i).le ψ)) := by
    have hcongr :
        (∏ i : Fin r_orb,
          tateEps F (D_orb.get i).field
            (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
            (traceChar F (D_orb.get i).le ψ)) =
        (∏ i : Fin r_orb,
          ((χ' (v_orb i) : Ω F) *
            tateEps F (D_orb.get i).field (μ'_orb i) (traceChar F (D_orb.get i).le ψ))) :=
      Finset.prod_congr rfl (fun i _ => (htate_Fi i).1)
    have hcoe_prod : (∏ i : Fin r_orb, (χ' (v_orb i) : Ω F)) =
        (χ' (∏ i : Fin r_orb, v_orb i) : Ω F) := by
      rw [map_prod]
      exact (map_prod (Units.coeHom (Ω F)) (fun i => χ' (v_orb i)) Finset.univ).symm
    rw [hcongr, Finset.prod_mul_distrib, hcoe_prod]

  have hval_prod_L : ∀ (S : Finset (Fin r_orb)) (g : Fin r_orb → Lˣ),
      valL F L (((∏ i ∈ S, g i : Lˣ) : L)) = ∑ i ∈ S, valL F L (g i : L) := by
    intro S g
    induction S using Finset.induction_on with
    | empty =>
      rw [Finset.prod_empty, Finset.sum_empty, Units.val_one, hval1_L]
    | @insert a s ha ih =>
      rw [Finset.prod_insert ha, Finset.sum_insert ha, Units.val_mul,
        hval_mul_L (g a : L) _ (Units.ne_zero (g a)) (Units.ne_zero _), ih]

  have hsum_f : (∑ i : Fin r_orb, (f_orb i : ℤ)) = (((q - 1) / k : ℕ) : ℤ) := by
    have hsum_nat : ∑ i : Fin r_orb, f_orb i = (q - 1) / k := by
      apply Nat.eq_of_mul_eq_mul_left hk_ge1
      rw [Finset.mul_sum, Nat.mul_div_cancel' hk_dvd]
      calc (∑ i : Fin r_orb, k * f_orb i) =
            ∑ i : Fin r_orb,
              Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) :=
            Finset.sum_congr rfl (fun i _ => (hf_deg i).symm)
        _ = q - 1 := hDegSum
    exact_mod_cast hsum_nat

  have hval_c0_prod : valL F L (((c₀ * ∏ i : Fin r_orb, v_orb i : Lˣ) : L)) = nE := by
    rw [Units.val_mul, hval_mul_L (c₀ : L) _ (Units.ne_zero c₀) (Units.ne_zero _),
      hc₀_val, hval_prod_L Finset.univ v_orb]
    have hsum_v :
        (∑ i : Fin r_orb, valL F L (v_orb i : L)) =
        (((q - 1) / k : ℕ) : ℤ) * ((k : ℤ) * nL + (t : ℤ) + (k : ℤ)) := by
      calc (∑ i : Fin r_orb, valL F L (v_orb i : L)) =
            ∑ i : Fin r_orb, (f_orb i : ℤ) * ((k : ℤ) * nL + (t : ℤ) + (k : ℤ)) :=
            Finset.sum_congr rfl (fun i _ => (htate_Fi i).2)
        _ = (∑ i : Fin r_orb, (f_orb i : ℤ)) * ((k : ℤ) * nL + (t : ℤ) + (k : ℤ)) :=
            (Finset.sum_mul _ _ _).symm
        _ = (((q - 1) / k : ℕ) : ℤ) * ((k : ℤ) * nL + (t : ℤ) + (k : ℤ)) := by
            rw [hsum_f]
    rw [hsum_v]
    have hnE' : nE = (q : ℤ) * nL + (((q - 1) / k : ℕ) : ℤ) * ((t : ℤ) + (k : ℤ)) := hnE
    rw [hnE']
    linear_combination nL * hk_mul_div

  let u_ratio : Lˣ := vE * (c₀ * ∏ i : Fin r_orb, v_orb i)⁻¹
  have hu_ratio_val0 : valL F L (u_ratio : L) = 0 := by
    change valL F L ((vE : L) * (((c₀ * ∏ i : Fin r_orb, v_orb i)⁻¹ : Lˣ) : L)) = 0
    rw [hval_mul_L (vE : L) _ (Units.ne_zero vE) (Units.ne_zero _),
      hvE_val, hval_inv_L _, hval_c0_prod]
    ring
  have hχ'_ratio : χ' u_ratio = 1 := hχ'_val0 u_ratio hu_ratio_val0
  have hvE_eq : vE = u_ratio * (c₀ * ∏ i : Fin r_orb, v_orb i) := by
    dsimp [u_ratio]
    exact (inv_mul_cancel_right vE _).symm
  have hχ'_vE : (χ' vE : Ω F) =
      (χ' c₀ : Ω F) * (χ' (∏ i : Fin r_orb, v_orb i) : Ω F) := by
    have h1 : χ' vE = χ' c₀ * χ' (∏ i : Fin r_orb, v_orb i) := by
      conv_lhs => rw [hvE_eq]
      rw [map_mul, hχ'_ratio, one_mul, map_mul]
    rw [h1, Units.val_mul]

  rw [htate_E, htate_L, hprod_Fi, hχ'_vE]
  ring

theorem ld_ch14_wild_semidirect_ramification_and_cond_zero (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hLM_C_lt : L < M_C)
    (hCore : ¬ ∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
      K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
      Module.finrank L (IntermediateField.extendScalars hLK₁) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (hGal : IsGaloisExt F L K) (hGalMCK : IsGaloisExt F M_C K)
    (hSepLE : Algebra.IsSeparable L (IntermediateField.extendScalars hLE))
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (h_wild : p F ∣ Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (hψE : IsAdmissibleChar F E (traceChar F hLE ψ))
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hGalFiK : ∀ i : Fin D_orb.length, IsGaloisExt F (D_orb.get i).field K)
    (hSepLFi : ∀ i : Fin D_orb.length,
      Algebra.IsSeparable L (IntermediateField.extendScalars (D_orb.get i).le))
    (hψFi : ∀ i : Fin D_orb.length,
      IsAdmissibleChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ))
    (hDegSum : (∑ i : Fin D_orb.length,
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)
    (χ' : Lˣ →* (Ω F)ˣ)
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (hχ'_cond : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1)
    (hχ'E_cond : ∀ u ∈ unitGroup F E (condExp F E (χ'.comp (Units.map (normLM F hLE)))),
      (χ'.comp (Units.map (normLM F hLE))) u = 1)
    (hμ'_props : ∀ i : Fin D_orb.length,
      Algebra.IsSeparable (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)) ∧
      IsGaloisExt F (D_orb.get i).field M_C ∧
      (μ'_orb i) ^ (p F) = 1 ∧
      μ'_orb i ≠ 1 ∧
      (∀ u ∈ unitGroup F (D_orb.get i).field (condExp F (D_orb.get i).field (μ'_orb i)),
        (μ'_orb i) u = 1) ∧
      (∀ u ∈ unitGroup F (D_orb.get i).field
          (condExp F (D_orb.get i).field
            (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))),
        (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) u = 1) ∧
      ∃ (K_i : IntermediateField F (AlgebraicClosure F))
        (hFiKi : (D_orb.get i).field ≤ K_i) (hKiEi : K_i ≤ E ⊔ (D_orb.get i).field),
        IsGaloisExt F (D_orb.get i).field K_i ∧
        IsAbelianExt F hFiKi ∧
        Module.finrank (D_orb.get i).field (IntermediateField.extendScalars hFiKi) = p F ∧
        (∀ z : ((D_orb.get i).field)ˣ,
          z ∈ Set.range (Units.map (normLM F hFiKi)) ↔ (μ'_orb i) z = 1) ∧
        (∀ w : M_Cˣ,
          w ∈ Set.range (Units.map (normLM F hM_CK)) →
          ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) w = 1) ∧
        ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) ≠ 1) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let r_orb := D_orb.length
    (∃ r_exp : ℕ, 1 ≤ r_exp ∧ q = (p F) ^ r_exp) ∧
    qL F E = qL F L ∧
    resDeg F E = resDeg F L ∧
    (∀ y : E, valL F L (normLM F hLE y) = valL F E y) ∧
    (∀ x : L, valL F E (IntermediateField.inclusion hLE x) = (q : ℤ) * valL F L x) ∧
    (∀ y : E, (y = 0 ∨ 0 ≤ valL F E y) →
      ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧
        (y - IntermediateField.inclusion hLE x = 0 ∨
          1 ≤ valL F E (y - IntermediateField.inclusion hLE x))) ∧
    (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ q = 0 ∨ 1 ≤ valL F L (x - s ^ q))) ∧
    (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (p F) = 0 ∨ 1 ≤ valL F L (x - s ^ (p F)))) ∧
    (∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      ∃ s : M_C, (s = 0 ∨ 0 ≤ valL F M_C s) ∧
        (z - s ^ (p F) = 0 ∨ 1 ≤ valL F M_C (z - s ^ (p F)))) ∧
    qL F K = qL F M_C ∧
    resDeg F K = resDeg F M_C ∧
    (∀ w : K, valL F M_C (normLM F hM_CK w) = valL F K w) ∧
    (∀ z : M_C, valL F K (IntermediateField.inclusion hM_CK z) = (q : ℤ) * valL F M_C z) ∧
    (∀ w : K, (w = 0 ∨ 0 ≤ valL F K w) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (w - IntermediateField.inclusion hM_CK z = 0 ∨
          1 ≤ valL F K (w - IntermediateField.inclusion hM_CK z))) ∧
    (∀ y : E,
      IntermediateField.inclusion hLM_C (traceLM F hLE y) =
        traceLM F hM_CK (IntermediateField.inclusion hEK y) ∧
      IntermediateField.inclusion hLM_C (normLM F hLE y) =
        normLM F hM_CK (IntermediateField.inclusion hEK y)) ∧
    ∃ (t k : ℕ),
      1 ≤ t ∧
      1 ≤ k ∧
      k ∣ (q - 1) ∧
      (∀ y : E, valL F K (IntermediateField.inclusion hEK y) = (k : ℤ) * valL F E y) ∧
      (∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x) ∧
      (∀ (m : ℤ) (z : M_C),
        (z = 0 ∨ (k : ℤ) * m - ((k : ℤ) - 1) ≤ valL F M_C z) →
        (traceLM F hLM_C z = 0 ∨ m ≤ valL F L (traceLM F hLM_C z))) ∧
      (∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
        traceLM F hLM_C (z ^ (p F)) - (traceLM F hLM_C z) ^ (p F) = 0 ∨
          1 ≤ valL F L (traceLM F hLM_C (z ^ (p F)) - (traceLM F hLM_C z) ^ (p F))) ∧
      condExpChar F M_C (traceChar F hLM_C ψ) =
        (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1) ∧
      condExpChar F E (traceChar F hLE ψ) =
        (q : ℤ) * condExpChar F L ψ + (((q - 1) / k : ℕ) : ℤ) * ((t : ℤ) + (k : ℤ)) ∧
      (∀ (m : ℤ) (w : K),
        (w = 0 ∨ (q : ℤ) * m - ((q - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K w) →
        (traceLM F hM_CK w = 0 ∨ m ≤ valL F M_C (traceLM F hM_CK w))) ∧
      (∀ i : Fin r_orb,
        condExp F (D_orb.get i).field (μ'_orb i) = t + 1 ∧
        condExp F M_C ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) = t + 1 ∧
        (∀ x : (D_orb.get i).field,
          valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
            valL F (D_orb.get i).field x) ∧
        (∀ z : M_C,
          valL F (D_orb.get i).field (normLM F (hFiMC i) z) =
            (Module.finrank (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)) : ℤ) *
              valL F M_C z) ∧
        (∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
          (traceLM F (hFiMC i) z = 0 ∨ m ≤ valL F (D_orb.get i).field (traceLM F (hFiMC i) z))) ∧
        (∀ z : M_C, (z = 0 ∨ 1 ≤ valL F M_C z) →
          normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z) = 0 ∨
            2 * valL F M_C z ≤
              valL F (D_orb.get i).field
                (normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z))) ∧
        condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) =
          (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1) ∧
        ∃ f_i : ℕ,
          1 ≤ f_i ∧
          Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_i ∧
          resDeg F (D_orb.get i).field = f_i * resDeg F L ∧
          (∀ x : (D_orb.get i).field,
            valL F L (normLM F (D_orb.get i).le x) =
              (f_i : ℤ) * valL F (D_orb.get i).field x)) ∧
      (∃ (P_poly : M_C → M_C) (ϖ_K : Kˣ) (ϖ_MC : M_Cˣ) (ϖ_E : Eˣ) (ϖ_L : Lˣ),
        Units.map (normLM F hM_CK) ϖ_K = ϖ_MC ∧
        Units.map (normLM F hLE) ϖ_E = ϖ_L ∧
        valL F K (ϖ_K : K) = 1 ∧
        valL F M_C (ϖ_MC : M_C) = 1 ∧
        valL F E (ϖ_E : E) = 1 ∧
        valL F L (ϖ_L : L) = 1 ∧
        (∃ (r_exp : ℕ) (hr_exp_pos : 1 ≤ r_exp) (a_coeff : Fin r_exp → M_C),
          q = (p F) ^ r_exp ∧
          (∀ j : Fin r_exp, a_coeff j = 0 ∨ 0 ≤ valL F M_C (a_coeff j)) ∧
          (a_coeff ⟨0, hr_exp_pos⟩ -
            (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K) = 0 ∨
            1 ≤ valL F M_C (a_coeff ⟨0, hr_exp_pos⟩ -
              (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K))) ∧
          valL F M_C ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K)) = 0 ∧
          (∀ z : M_C,
            P_poly z = z ^ q + ∑ j : Fin r_exp, (a_coeff j) * (z ^ ((p F) ^ (j : ℕ)))) ∧
          (∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
            normLM F hM_CK (1 + IntermediateField.inclusion hM_CK z * ((ϖ_K ^ t : Kˣ) : K)) -
              (1 + P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C)) = 0 ∨
              (t + 1 : ℤ) ≤ valL F M_C
                (normLM F hM_CK (1 + IntermediateField.inclusion hM_CK z * ((ϖ_K ^ t : Kˣ) : K)) -
                  (1 + P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C)))))) ∧
      (condExp F L χ' = 0 →
        tateEps F E (χ'.comp (Units.map (normLM F hLE))) (traceChar F hLE ψ) *
          tateEps F L 1 ψ *
          (∏ i : Fin r_orb,
            tateEps F (D_orb.get i).field (μ'_orb i) (traceChar F (D_orb.get i).le ψ)) =
        tateEps F E 1 (traceChar F hLE ψ) *
          tateEps F L χ' ψ *
          (∏ i : Fin r_orb,
            tateEps F (D_orb.get i).field
              (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
              (traceChar F (D_orb.get i).le ψ))) :=
by
  obtain ⟨hp_prime, ⟨r_exp, hr_exp_pos, hq_eq⟩, hExpMCK, hFrobSurjL, hFrobSurjLp, hFrobSurjMC,
      hqK, hresK, hValNormK, hValAlgK, hResLiftK,
      t, k, ht_ge1, hk_ge1, hk_dvd, hValAlgMCL, hValAlgKE, hresE,
      hy₁_MCL, hw₁_KE, hValAlgFiMC, hJumpK⟩ :=
    ld_ch14_wild_semidirect_inertia_and_serre_jump F L K M_C E hLK hLM_C hM_CK hLE hEK
      h_inf h_sup hLM_C_lt hCore hGal hGalMCK hMin h_wild hFinE_eq
      D_orb hFinFi hGalFiK hFiMC μ'_orb
      (fun i => ⟨(hμ'_props i).1, (hμ'_props i).2.1, (hμ'_props i).2.2.1,
        (hμ'_props i).2.2.2.1, (hμ'_props i).2.2.2.2.1, fun _ _ => trivial,
        (hμ'_props i).2.2.2.2.2.2⟩)
  have hq_gt1 : 1 < Module.finrank M_C (IntermediateField.extendScalars hM_CK) := by
    rw [hq_eq]
    exact one_lt_pow₀ hp_prime.one_lt (by omega)
  obtain ⟨hqE, hValNormE, hValAlgE, hResLiftE, hDiamondTrNorm,
      hTrBoundMCL, hTrBoundKE, hTrFrobMCL, hFi_unram⟩ :=
    ld_ch14_wild_diamond_and_unramified_orbits F L K M_C E hLK hLM_C hM_CK hLE hEK
      hGal hMin hFinE_eq D_orb hFinFi hFiMC (fun i => (hμ'_props i).2.1)
      hp_prime hq_gt1 hValAlgK k hk_ge1 hk_dvd hValAlgMCL hValAlgKE hresE hValAlgFiMC
  obtain ⟨htr_bound_K, htr_surj_K, hnorm_surj_lt, hnorm_gt_surj, hPoly14_6⟩ :=
    ld_ch14_lemma_14_6_wild_tower_norm_poly_and_herbrand F L M_C E K hM_CK hLE
      hGalMCK hMin.2.1 hp_prime r_exp hr_exp_pos hq_eq hExpMCK
      hresK hValNormK hValAlgK hValNormE hFrobSurjMC t ht_ge1 hJumpK
  obtain ⟨hnMC, hnE, hFi_conds, hCond0⟩ :=
    ld_ch14_wild_conductors_and_cond_zero_endpoint F L K M_C E hLK hLM_C hM_CK hLE hEK
      hFinE_eq ψ hψ hψMC hψE hψK D_orb hFinFi hψFi hDegSum χ' hFiMC μ'_orb
      hχ'_cond hχ'E_cond hμ'_props hq_gt1 hValNormE hValNormK hValAlgK
      t k ht_ge1 hk_ge1 hk_dvd hValAlgMCL hValAlgKE hTrBoundMCL hTrBoundKE
      hy₁_MCL hw₁_KE htr_bound_K htr_surj_K hnorm_surj_lt hnorm_gt_surj
      hValAlgFiMC hFi_unram
  refine ⟨⟨r_exp, hr_exp_pos, hq_eq⟩, hqE, hresE, hValNormE, hValAlgE, hResLiftE,
    hFrobSurjL, hFrobSurjLp, hFrobSurjMC, hqK, hresK, hValNormK, hValAlgK, hResLiftK,
    hDiamondTrNorm, t, k, ht_ge1, hk_ge1, hk_dvd, hValAlgKE, hValAlgMCL,
    hTrBoundMCL, hTrFrobMCL, hnMC, hnE, htr_bound_K, ?_, hPoly14_6, hCond0⟩
  intro i
  exact ⟨(hFi_conds i).1, (hFi_conds i).2.1, hValAlgFiMC i,
    (hFi_unram i).1, (hFi_unram i).2.1, (hFi_unram i).2.2.1,
    (hFi_conds i).2.2, (hFi_unram i).2.2.2.2⟩

theorem ld_ch14_orbit_stationary_phase_and_stable_twist (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hψFi : ∀ i : Fin D_orb.length,
      IsAdmissibleChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ))
    (χ' : Lˣ →* (Ω F)ˣ) (ha1 : condExp F L χ' = 1)
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (hχ'_cond : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1)
    (hOrbitEnum : ∃ (ν_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
        (M_Cˣ →* (Ω F)ˣ))
      (σ_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
        (M_C ≃ₐ[F] M_C))
      (idx_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
        Fin D_orb.length),
      Function.Injective ν_all ∧
      (∀ j,
        ν_all j ≠ 1 ∧
        (ν_all j) ^ (p F) = 1 ∧
        (∀ x : L, (σ_all j) (IntermediateField.inclusion hLM_C x) = IntermediateField.inclusion hLM_C x) ∧
        (∀ z : M_C, valL F M_C ((σ_all j) z) = valL F M_C z) ∧
        (∀ z : M_C, traceLM F hLM_C ((σ_all j) z) = traceLM F hLM_C z) ∧
        (∀ w : M_Cˣ, w ∈ Set.range (Units.map (normLM F hM_CK)) → (ν_all j) w = 1) ∧
        ∀ w : M_Cˣ,
          (ν_all j) w =
            ((μ'_orb (idx_all j)).comp (Units.map (normLM F (hFiMC (idx_all j)))))
              (Units.map (σ_all j).toRingEquiv.toMonoidHom w)) ∧
      (∀ (c_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ),
        ∏ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1),
          Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
            (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
              (c_orb (idx_all j))) =
          Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
            (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c_orb i))))
    (t k : ℕ) (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k)
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hFi_ram : ∀ i : Fin D_orb.length,
      condExp F (D_orb.get i).field (μ'_orb i) = t + 1 ∧
      condExp F M_C ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) = t + 1 ∧
      (∀ x : (D_orb.get i).field,
        valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
          valL F (D_orb.get i).field x) ∧
      (∀ z : M_C,
        valL F (D_orb.get i).field (normLM F (hFiMC i) z) =
          (Module.finrank (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)) : ℤ) *
            valL F M_C z) ∧
      (∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
        (traceLM F (hFiMC i) z = 0 ∨ m ≤ valL F (D_orb.get i).field (traceLM F (hFiMC i) z))) ∧
      (∀ z : M_C, (z = 0 ∨ 1 ≤ valL F M_C z) →
        normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z) = 0 ∨
          2 * valL F M_C z ≤
            valL F (D_orb.get i).field
              (normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z))) ∧
      condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) =
        (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1) ∧
      ∃ f_i : ℕ,
        1 ≤ f_i ∧
        Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_i ∧
        resDeg F (D_orb.get i).field = f_i * resDeg F L ∧
        (∀ x : (D_orb.get i).field,
          valL F L (normLM F (D_orb.get i).le x) =
            (f_i : ℤ) * valL F (D_orb.get i).field x)) :
    ∃ (c_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ),
      (∀ i : Fin D_orb.length,
        tateEps F (D_orb.get i).field
          (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
          (traceChar F (D_orb.get i).le ψ) =
        (χ' (Units.map (normLM F (D_orb.get i).le) (c_orb i)) : Ω F) *
          tateEps F (D_orb.get i).field (μ'_orb i) (traceChar F (D_orb.get i).le ψ)) ∧
      (∀ i : Fin D_orb.length,
        valL F (D_orb.get i).field ((c_orb i : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) =
          (k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ) ∧
        ∀ x : (D_orb.get i).field,
          (x = 0 ∨ (t : ℤ) ≤ valL F (D_orb.get i).field x) →
          ∀ hx : 1 + x ≠ 0,
            ((μ'_orb i) (Units.mk0 (1 + x) hx) : Ω F) =
              (traceChar F (D_orb.get i).le ψ)
                ((((c_orb i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * x)) :=
by
  rcases hOrbitEnum with ⟨ν_all, σ_all, idx_all, _, hν_props, hProd⟩
  have hσ_val : ∀ j, ∀ z : M_C, valL F M_C ((σ_all j) z) = valL F M_C z :=
    fun j => (hν_props j).2.2.2.1
  have hValAlgFiMC : ∀ i : Fin D_orb.length, ∀ x : (D_orb.get i).field,
      valL F M_C (IntermediateField.inclusion (hFiMC i) x) = valL F (D_orb.get i).field x :=
    fun i => (hFi_ram i).2.2.1

  
  have hOrbit_norm_unit1 : ∀ (i : Fin D_orb.length) (u : ((D_orb.get i).field)ˣ),
      u ∈ unitGroup F (D_orb.get i).field 1 →
      Units.map (normLM F (D_orb.get i).le) u ∈ unitGroup F L 1 := by
    intro i u hu
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    have hvalL := ld_valL_and_unitGroup_props F L
    have hvalMC := ld_valL_and_unitGroup_props F M_C
    have hvalFi := ld_valL_and_unitGroup_props F (D_orb.get i).field
    have hunitL_1 := hvalL.2.2.2.2.2.2.2.2.2.1 1 le_rfl
    have hunitMC_1 := hvalMC.2.2.2.2.2.2.2.2.2.1 1 le_rfl
    have hunitFi_1 := hvalFi.2.2.2.2.2.2.2.2.2.1 1 le_rfl
    let c_single : ∀ i' : Fin D_orb.length, ((D_orb.get i').field)ˣ :=
      fun i' => if h : i' = i then h ▸ u else 1
    have hw_mem : ∀ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1),
        Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
          (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
            (c_single (idx_all j))) ∈ unitGroup F M_C 1 := by
      intro j
      by_cases hj : idx_all j = i
      · have h_eq : Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
            (c_single (idx_all j)) =
          Units.map (IntermediateField.inclusion (hFiMC i)).toMonoidHom u := by
          rcases hj with rfl
          dsimp only [c_single]
          rw [dif_pos rfl]
        rw [h_eq, hunitMC_1]
        change ((σ_all j).symm (IntermediateField.inclusion (hFiMC i) (u : (D_orb.get i).field)) = 1) ∨
          (1 : ℤ) ≤ valL F M_C
            ((σ_all j).symm (IntermediateField.inclusion (hFiMC i) (u : (D_orb.get i).field)) - 1)
        rcases (hunitFi_1 u).mp hu with hu1 | hu_ge1
        · left
          rw [hu1, map_one, map_one]
        · right
          have h_sub : (σ_all j).symm (IntermediateField.inclusion (hFiMC i) (u : (D_orb.get i).field)) - 1 =
              (σ_all j).symm (IntermediateField.inclusion (hFiMC i) ((u : (D_orb.get i).field) - 1)) := by
            rw [map_sub, map_one, map_sub, map_one]
          have h_symm_val : ∀ z : M_C, valL F M_C ((σ_all j).symm z) = valL F M_C z := by
            intro z
            have h1 := hσ_val j ((σ_all j).symm z)
            rw [AlgEquiv.apply_symm_apply] at h1
            exact h1.symm
          rw [h_sub, h_symm_val, hValAlgFiMC i ((u : (D_orb.get i).field) - 1)]
          exact hu_ge1
      · have h_one : c_single (idx_all j) = 1 := dif_neg hj
        rw [h_one, map_one, map_one]
        exact Subgroup.one_mem (unitGroup F M_C 1)
    have hprod_mem : Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
        (Units.map (normLM F (D_orb.get i).le) u) ∈ unitGroup F M_C 1 := by
      have h1 : (∏ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1),
          Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
            (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
              (c_single (idx_all j)))) ∈ unitGroup F M_C 1 :=
        Subgroup.prod_mem (unitGroup F M_C 1) (fun j _ => hw_mem j)
      rw [hProd c_single] at h1
      have h_single : (∏ i' : Fin D_orb.length, Units.map (normLM F (D_orb.get i').le) (c_single i')) =
          Units.map (normLM F (D_orb.get i).le) u := by
        rw [Finset.prod_eq_single i]
        · dsimp only [c_single]
          rw [dif_pos rfl]
        · intro i' _ hi'
          dsimp only [c_single]
          rw [dif_neg hi', map_one]
        · intro hi_absurd
          exact False.elim (hi_absurd (Finset.mem_univ i))
      rwa [h_single] at h1
    set v := Units.map (normLM F (D_orb.get i).le) u
    rw [hunitL_1]
    rcases (hunitMC_1 (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom v)).mp hprod_mem with hv1 | hv_ge1
    · left
      apply (IntermediateField.inclusion hLM_C).injective
      simpa using hv1
    · by_cases hv_eq1 : (v : L) = 1
      · exact Or.inl hv_eq1
      · right
        have h_sub : ((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom v : M_Cˣ) : M_C) - 1 =
            IntermediateField.inclusion hLM_C ((v : L) - 1) := by
          change IntermediateField.inclusion hLM_C (v : L) - 1 = _
          rw [map_sub, map_one]
        rw [h_sub, hValAlgMCL ((v : L) - 1)] at hv_ge1
        by_contra hlt
        have hle0 : valL F L ((v : L) - 1) ≤ 0 := by omega
        have hmul_le0 : (k : ℤ) * valL F L ((v : L) - 1) ≤ 0 :=
          mul_nonpos_of_nonneg_of_nonpos (by omega) hle0
        omega

  
  have hm_orb : ∀ i : Fin D_orb.length, 2 ≤ condExp F (D_orb.get i).field (μ'_orb i) := by
    intro i
    have hcond := (hFi_ram i).1
    omega
  have hStat_orb : ∀ i : Fin D_orb.length,
      letI := hFinFi i
      let E := (D_orb.get i).field
      let ψ_E := traceChar F (D_orb.get i).le ψ
      let θ := μ'_orb i
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        ∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) := by
    intro i
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    have h := ld_tame_stationary_phase_and_stable_twist F (D_orb.get i).field
      (traceChar F (D_orb.get i).le ψ) (hψFi i) (μ'_orb i) (hm_orb i)
    exact ⟨h.1, fun c hc_val hc_stat => (h.2 c hc_val hc_stat).1⟩
  let c_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ :=
    fun i => Classical.choose (hStat_orb i).1
  refine ⟨c_orb, ?_, ?_⟩
  · intro i
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    obtain ⟨hc_val, hc_stat⟩ := Classical.choose_spec (hStat_orb i).1
    set ν_i := χ'.comp (Units.map (normLM F (D_orb.get i).le))
    have hν_triv : ∀ u ∈ unitGroup F (D_orb.get i).field
        (condExp F (D_orb.get i).field (μ'_orb i) / 2), ν_i u = 1 := by
      intro u hu
      have hvalFi := ld_valL_and_unitGroup_props F (D_orb.get i).field
      have hunitFi := hvalFi.2.2.2.2.2.2.2.2.2.1
      have hd_ge1 : 1 ≤ condExp F (D_orb.get i).field (μ'_orb i) / 2 := by
        have := hm_orb i
        omega
      have hu1 : u ∈ unitGroup F (D_orb.get i).field 1 := by
        rw [hunitFi 1 le_rfl u]
        rcases (hunitFi _ hd_ge1 u).mp hu with h1 | hge
        · exact Or.inl h1
        · exact Or.inr (by omega)
      have hnorm_mem1 : Units.map (normLM F (D_orb.get i).le) u ∈ unitGroup F L 1 :=
        hOrbit_norm_unit1 i u hu1
      rw [← ha1] at hnorm_mem1
      exact hχ'_cond (Units.map (normLM F (D_orb.get i).le) u) hnorm_mem1
    have htwist := ((hStat_orb i).2 (c_orb i) hc_val hc_stat ν_i hν_triv).2
    rw [mul_comm (μ'_orb i) ν_i]
    exact htwist
  · intro i
    obtain ⟨hc_val, hc_stat⟩ := Classical.choose_spec (hStat_orb i).1
    have hcond_i := (hFi_ram i).1
    have hnFi := (hFi_ram i).2.2.2.2.2.2.1
    refine ⟨?_, ?_⟩
    · rw [hc_val, hcond_i, hnFi]
      push_cast
      ring
    · intro x hx_val hx
      apply hc_stat x _ hx
      rcases hx_val with rfl | hx_ge
      · exact Or.inl rfl
      · right
        have hr₀_le : (((condExp F (D_orb.get i).field (μ'_orb i) + 1) / 2 : ℕ) : ℤ) ≤ (t : ℤ) := by
          rw [hcond_i]
          omega
        exact le_trans hr₀_le hx_ge

theorem ld_ch14_pullback_stationary_phase_char_on_MC (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hSepLFi : ∀ i : Fin D_orb.length,
      Algebra.IsSeparable L (IntermediateField.extendScalars (D_orb.get i).le))
    (hψFi : ∀ i : Fin D_orb.length,
      IsAdmissibleChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ))
    (χ' : Lˣ →* (Ω F)ˣ) (ha1 : condExp F L χ' = 1)
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (hSepFiMC : ∀ i : Fin D_orb.length,
      Algebra.IsSeparable (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)))
    (ν_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      (M_Cˣ →* (Ω F)ˣ))
    (σ_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      (M_C ≃ₐ[F] M_C))
    (idx_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      Fin D_orb.length)
    (hν_props : ∀ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1),
      (∀ z : M_C, valL F M_C ((σ_all j) z) = valL F M_C z) ∧
      (∀ z : M_C, traceLM F hLM_C ((σ_all j) z) = traceLM F hLM_C z) ∧
      (∀ w : M_Cˣ, w ∈ Set.range (Units.map (normLM F hM_CK)) → (ν_all j) w = 1) ∧
      (∀ w : M_Cˣ,
        (ν_all j) w =
          ((μ'_orb (idx_all j)).comp (Units.map (normLM F (hFiMC (idx_all j)))))
            (Units.map (σ_all j).toRingEquiv.toMonoidHom w)))
    (hValNormK : ∀ w : K, valL F M_C (normLM F hM_CK w) = valL F K w)
    (hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (t k : ℕ) (ht_ge1 : 1 ≤ t)
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hnMC : condExpChar F M_C (traceChar F hLM_C ψ) =
      (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1))
    (hFi_unram : ∀ i : Fin D_orb.length,
      (∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
        (traceLM F (hFiMC i) z = 0 ∨ m ≤ valL F (D_orb.get i).field (traceLM F (hFiMC i) z))) ∧
      (∀ z : M_C, (z = 0 ∨ 1 ≤ valL F M_C z) →
        normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z) = 0 ∨
          2 * valL F M_C z ≤
            valL F (D_orb.get i).field
              (normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z))) ∧
      condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) =
        (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1))
    (P_poly : M_C → M_C) (ϖ_K : Kˣ) (ϖ_MC : M_Cˣ)
    (hϖ_valK : valL F K (ϖ_K : K) = 1)
    (hϖ_valMC : valL F M_C (ϖ_MC : M_C) = 1)
    (r_exp : ℕ) (a_coeff : Fin r_exp → M_C)
    (ha_int : ∀ j : Fin r_exp, a_coeff j = 0 ∨ 0 ≤ valL F M_C (a_coeff j))
    (hP_def : ∀ z : M_C,
      P_poly z =
        z ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) +
          ∑ j : Fin r_exp, (a_coeff j) * (z ^ ((p F) ^ (j : ℕ))))
    (hP_norm : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      normLM F hM_CK (1 + IntermediateField.inclusion hM_CK z * ((ϖ_K ^ t : Kˣ) : K)) -
        (1 + P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C)) = 0 ∨
        (t + 1 : ℤ) ≤ valL F M_C
          (normLM F hM_CK (1 + IntermediateField.inclusion hM_CK z * ((ϖ_K ^ t : Kˣ) : K)) -
            (1 + P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C))))
    (c_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (hc_orb_stat : ∀ i : Fin D_orb.length,
      valL F (D_orb.get i).field ((c_orb i : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) =
        (k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ) ∧
      ∀ x : (D_orb.get i).field,
        (x = 0 ∨ (t : ℤ) ≤ valL F (D_orb.get i).field x) →
        ∀ hx : 1 + x ≠ 0,
          ((μ'_orb i) (Units.mk0 (1 + x) hx) : Ω F) =
            (traceChar F (D_orb.get i).le ψ)
              ((((c_orb i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * x))
    (c_all u_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) → M_Cˣ)
    (hc_all_def : ∀ j,
      c_all j =
        Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
          (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
            (c_orb (idx_all j))))
    (hu_all_def : ∀ j,
      u_all j =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (tateElt F L χ' ψ) *
          (ϖ_MC ^ t) * (c_all j)⁻¹)
    (hc_all_val : ∀ j,
      valL F M_C ((c_all j : M_Cˣ) : M_C) =
        (k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ))
    (hu_all_mul : ∀ j, ∀ z : M_C,
      ((((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (tateElt F L χ' ψ))⁻¹ : M_Cˣ) : M_C) *
        ((u_all j : M_C) * z)) =
        ((((c_all j)⁻¹ : M_Cˣ) : M_C) * (z * ((ϖ_MC ^ t : M_Cˣ) : M_C)))) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let c₁ := tateElt F L χ' ψ
    (∀ j : Fin (q - 1), valL F M_C ((u_all j : M_Cˣ) : M_C) = 0) ∧
    (∀ j : Fin (q - 1), ∀ z : M_C, (z = 0 ∨ (t : ℤ) ≤ valL F M_C z) →
      ∀ hz : 1 + z ≠ 0,
        ((ν_all j) (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM_C ψ) ((((c_all j)⁻¹ : M_Cˣ) : M_C) * z)) ∧
    (∀ j : Fin (q - 1), ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      (traceChar F hLM_C ψ)
        ((((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₁)⁻¹ : M_Cˣ) : M_C) *
          ((u_all j : M_C) * P_poly z)) = 1) ∧
    (∀ j : Fin (q - 1), ∀ u ∈ unitGroup F M_C (t + 1), (ν_all j) u = 1) ∧
    (∀ j : Fin (q - 1), ∃ u₀ ∈ unitGroup F M_C t, (ν_all j) u₀ ≠ 1) ∧
    (∀ j₁ j₂ : Fin (q - 1),
      ((u_all j₁ : M_C) - (u_all j₂ : M_C) = 0 ∨
        1 ≤ valL F M_C ((u_all j₁ : M_C) - (u_all j₂ : M_C))) →
      ∀ w ∈ unitGroup F M_C t, (ν_all j₁) w = (ν_all j₂) w) :=
by
  let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  let c₁ := tateElt F L χ' ψ
  have hvalL := ld_valL_and_unitGroup_props F L
  have hvalMC := ld_valL_and_unitGroup_props F M_C
  have hvalK := ld_valL_and_unitGroup_props F K
  have hSpecL := ld_condExp_and_condExpChar_spec F L ψ hψ χ'
  have hSpecMC := ld_condExp_and_condExpChar_spec F M_C (traceChar F hLM_C ψ) hψMC 1
  have hk_expand : (k : ℤ) * (1 + condExpChar F L ψ) =
      (k : ℤ) * condExpChar F L ψ + (k : ℤ) := by ring

  have hval_mul_ge : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (m₁ m₂ : ℤ) (x y : M),
      (x = 0 ∨ m₁ ≤ valL F M x) → (y = 0 ∨ m₂ ≤ valL F M y) →
        (x * y = 0 ∨ m₁ + m₂ ≤ valL F M (x * y)) := by
    intro M _ m₁ m₂ x y hx hy
    by_cases hx0 : x = 0
    · left; simp [hx0]
    · by_cases hy0 : y = 0
      · left; simp [hy0]
      · right
        have hx' : m₁ ≤ valL F M x := hx.resolve_left hx0
        have hy' : m₂ ≤ valL F M y := hy.resolve_left hy0
        rw [(ld_valL_and_unitGroup_props F M).2.2.2.2.1 x y hx0 hy0]
        omega

  have hval_unit_pow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (u : Mˣ) (n : ℕ),
      valL F M ((u ^ n : Mˣ) : M) = (n : ℤ) * valL F M (u : M) := by
    intro M _ u n
    induction' n with n ih
    · simp [(ld_valL_and_unitGroup_props F M).2.1]
    · rw [pow_succ, Units.val_mul,
        (ld_valL_and_unitGroup_props F M).2.2.2.2.1 _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
      push_cast
      ring

  have htrace_smul_aux : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] (a : R) (x : S),
      Algebra.trace R S (algebraMap R S a * x) = a * Algebra.trace R S x := by
    intro R S _ _ _ a x
    rw [← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]

  have htrace_mul_inclusion : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (hAB : A ≤ B) (a : A) (w : B),
      traceLM F hAB (IntermediateField.inclusion hAB a * w) = a * traceLM F hAB w := by
    intro A B hAB a w
    exact htrace_smul_aux A (IntermediateField.extendScalars hAB) a (toExtendScalars F hAB w)

  have htrace_trans_aux : ∀ (K₀ L₀ M₀ E₀ : Type u) [Field K₀] [Field L₀] [Field M₀] [Field E₀]
      [Algebra K₀ L₀] [Algebra K₀ M₀] [Algebra K₀ E₀]
      (algLM : Algebra L₀ M₀) (algME : Algebra M₀ E₀) (algLE : Algebra L₀ E₀)
      (h1 : ∀ x : K₀, @algebraMap L₀ M₀ _ _ algLM (algebraMap K₀ L₀ x) = algebraMap K₀ M₀ x)
      (h2 : ∀ x : L₀, @algebraMap M₀ E₀ _ _ algME (@algebraMap L₀ M₀ _ _ algLM x) =
        @algebraMap L₀ E₀ _ _ algLE x)
      [FiniteDimensional K₀ M₀] (z : E₀),
      @Algebra.trace L₀ E₀ _ _ algLE z =
        @Algebra.trace L₀ M₀ _ _ algLM (@Algebra.trace M₀ E₀ _ _ algME z) := by
    intro K₀ L₀ M₀ E₀ _ _ _ _ _ _ _ algLM algME algLE h1 h2 _ z
    letI : Algebra L₀ M₀ := algLM
    letI : Algebra M₀ E₀ := algME
    letI : Algebra L₀ E₀ := algLE
    haveI : IsScalarTower K₀ L₀ M₀ := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h1 x).symm)
    haveI : IsScalarTower L₀ M₀ E₀ := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h2 x).symm)
    haveI : FiniteDimensional L₀ M₀ := Module.Finite.of_restrictScalars_finite K₀ L₀ M₀
    by_cases hFin : FiniteDimensional M₀ E₀
    · exact (Algebra.trace_trace z).symm
    · have htr1 : Algebra.trace M₀ E₀ = 0 := by
        apply Algebra.trace_eq_zero_of_not_exists_basis
        rintro ⟨s, ⟨b⟩⟩
        exact hFin (Module.Finite.of_basis b)
      have htr2 : Algebra.trace L₀ E₀ = 0 := by
        apply Algebra.trace_eq_zero_of_not_exists_basis
        rintro ⟨s, ⟨b⟩⟩
        haveI : Module.Finite L₀ E₀ := Module.Finite.of_basis b
        exact hFin (Module.Finite.of_restrictScalars_finite L₀ M₀ E₀)
      simp [htr1, htr2]

  have htrace_eq_inclusion : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (hAB : A ≤ B) (y : B),
      @Algebra.trace A B _ _ (IntermediateField.inclusion hAB).toAlgebra y = traceLM F hAB y := by
    intro A B hAB y
    letI : Algebra A B := (IntermediateField.inclusion hAB).toAlgebra
    let e : B ≃ₐ[A] IntermediateField.extendScalars hAB := {
      toFun := toExtendScalars F hAB
      invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hAB).mp z.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl
    }
    exact (Algebra.trace_eq_of_algEquiv e y).symm

  have htrace_trans : ∀ (A B C : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B]
      (hAB : A ≤ B) (hBC : B ≤ C) (z : C),
      traceLM F (hAB.trans hBC) z = traceLM F hAB (traceLM F hBC z) := by
    intro A B C _ hAB hBC z
    rw [← htrace_eq_inclusion (hAB.trans hBC) z,
        ← htrace_eq_inclusion hBC z,
        ← htrace_eq_inclusion hAB]
    exact htrace_trans_aux F A B C
      (IntermediateField.inclusion hAB).toAlgebra
      (IntermediateField.inclusion hBC).toAlgebra
      (IntermediateField.inclusion (hAB.trans hBC)).toAlgebra
      (fun _ => rfl)
      (fun _ => rfl)
      z

  let c₁_MC : M_Cˣ := Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₁
  have hc₁_val : valL F L (c₁ : L) = 1 + condExpChar F L ψ := by
    have h := hSpecL.2.2.2
    rw [ha1] at h
    exact_mod_cast h
  have hc₁_MC_val : valL F M_C (c₁_MC : M_C) = (k : ℤ) * (1 + condExpChar F L ψ) := by
    change valL F M_C (IntermediateField.inclusion hLM_C (c₁ : L)) = _
    rw [hValAlgMCL (c₁ : L), hc₁_val]
  have hϖ_MC_pow_val : valL F M_C ((ϖ_MC ^ t : M_Cˣ) : M_C) = (t : ℤ) := by
    rw [hval_unit_pow M_C ϖ_MC t, hϖ_valMC, mul_one]
  have hϖ_K_pow_val : valL F K ((ϖ_K ^ t : Kˣ) : K) = (t : ℤ) := by
    rw [hval_unit_pow K ϖ_K t, hϖ_valK, mul_one]

  
  have hu_all_val : ∀ j : Fin (q - 1), valL F M_C ((u_all j : M_Cˣ) : M_C) = 0 := by
    intro j
    rw [hu_all_def j]
    change valL F M_C (((c₁_MC * (ϖ_MC ^ t) * (c_all j)⁻¹ : M_Cˣ) : M_C)) = 0
    rw [Units.val_mul,
      hvalMC.2.2.2.2.1 _ _ (Units.ne_zero _) (Units.ne_zero _),
      Units.val_mul,
      hvalMC.2.2.2.2.1 _ _ (Units.ne_zero _) (Units.ne_zero _),
      hc₁_MC_val, hϖ_MC_pow_val,
      hvalMC.2.2.2.2.2.1 (c_all j), hc_all_val j]
    omega

  have hν_stat : ∀ j : Fin (q - 1), ∀ z : M_C, (z = 0 ∨ (t : ℤ) ≤ valL F M_C z) →
      ∀ hz : 1 + z ≠ 0,
        ((ν_all j) (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM_C ψ) ((((c_all j)⁻¹ : M_Cˣ) : M_C) * z) := by
    intro j z hz_val hz
    let i := idx_all j
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    have hvalFi := ld_valL_and_unitGroup_props F (D_orb.get i).field
    have hSpecFi := (ld_condExp_and_condExpChar_spec F (D_orb.get i).field
      (traceChar F (D_orb.get i).le ψ) (hψFi i) 1).1
    let z' : M_C := (σ_all j) z
    have hz'_val : z' = 0 ∨ (t : ℤ) ≤ valL F M_C z' := by
      rcases hz_val with rfl | hz_ge
      · left; exact map_zero (σ_all j)
      · right
        change (t : ℤ) ≤ valL F M_C ((σ_all j) z)
        rw [(hν_props j).1 z]
        exact hz_ge
    have hz'_ge1 : z' = 0 ∨ 1 ≤ valL F M_C z' := by
      rcases hz'_val with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    let w_σ : M_Cˣ := Units.map (σ_all j).toRingEquiv.toMonoidHom (Units.mk0 (1 + z) hz)
    have hw_σ_coe : (w_σ : M_C) = 1 + z' := by
      change (σ_all j) (1 + z) = 1 + (σ_all j) z
      rw [map_add, map_one]
    let u' : ((D_orb.get i).field)ˣ := Units.map (normLM F (hFiMC i)) w_σ
    have hu'_coe : (u' : (D_orb.get i).field) = normLM F (hFiMC i) (1 + z') := by
      change normLM F (hFiMC i) (w_σ : M_C) = _
      rw [hw_σ_coe]
    let x' : (D_orb.get i).field := (u' : (D_orb.get i).field) - 1
    let r' : (D_orb.get i).field :=
      normLM F (hFiMC i) (1 + z') - (1 + traceLM F (hFiMC i) z')
    have hx'_1 : 1 + x' = (u' : (D_orb.get i).field) := by
      dsimp only [x']; ring
    have hx' : 1 + x' ≠ 0 := by
      rw [hx'_1]; exact Units.ne_zero u'
    have hu'_mk0 : Units.mk0 (1 + x') hx' = u' := Units.ext hx'_1
    have hx'_decomp : x' = traceLM F (hFiMC i) z' + r' := by
      dsimp only [x', r']
      rw [hu'_coe]
      ring
    have htr_z' : traceLM F (hFiMC i) z' = 0 ∨
        (t : ℤ) ≤ valL F (D_orb.get i).field (traceLM F (hFiMC i) z') :=
      (hFi_unram i).1 (t : ℤ) z' hz'_val
    have hr'_t1 : r' = 0 ∨ (t + 1 : ℤ) ≤ valL F (D_orb.get i).field r' := by
      by_cases hz'0 : z' = 0
      · left
        dsimp only [r']
        rw [hz'0, add_zero, map_one, map_zero, add_zero, sub_self]
      · have hz'_ge_t : (t : ℤ) ≤ valL F M_C z' := hz'_val.resolve_left hz'0
        have hrem : r' = 0 ∨ 2 * valL F M_C z' ≤ valL F (D_orb.get i).field r' :=
          (hFi_unram i).2.1 z' hz'_ge1
        rcases hrem with hr0 | hr_ge
        · exact Or.inl hr0
        · right; omega
    have hr'_t : r' = 0 ∨ (t : ℤ) ≤ valL F (D_orb.get i).field r' := by
      rcases hr'_t1 with hr0 | hr_ge
      · exact Or.inl hr0
      · exact Or.inr (by omega)
    have hx'_val : x' = 0 ∨ (t : ℤ) ≤ valL F (D_orb.get i).field x' := by
      rw [hx'_decomp]
      exact hvalFi.2.2.2.2.2.2.2.1 (t : ℤ) _ _ htr_z' hr'_t
    have hν_eval : (ν_all j) (Units.mk0 (1 + z) hz) = (μ'_orb i) u' :=
      (hν_props j).2.2.2 (Units.mk0 (1 + z) hz)
    have hstat_i := (hc_orb_stat i).2 x' hx'_val hx'
    rw [hu'_mk0] at hstat_i
    rw [hν_eval, hstat_i, hx'_decomp, mul_add, AddChar.map_add_eq_mul]
    have hr'_psi : (traceChar F (D_orb.get i).le ψ)
        ((((c_orb i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * r') = 1 := by
      apply hSpecFi
      have hc_inv_val : valL F (D_orb.get i).field
          ((((c_orb i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field)) =
            -((k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ)) := by
        rw [hvalFi.2.2.2.2.2.1 (c_orb i), (hc_orb_stat i).1]
      have hmul := hval_mul_ge (D_orb.get i).field
        (-((k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ))) (t + 1 : ℤ)
        ((((c_orb i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field)) r'
        (Or.inr (le_of_eq hc_inv_val.symm)) hr'_t1
      rcases hmul with h0 | hge
      · exact Or.inl h0
      · right
        have hnFi := (hFi_unram i).2.2
        omega
    rw [hr'_psi, mul_one]
    have hc_all_inv_σ : IntermediateField.inclusion (hFiMC i)
        ((((c_orb i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field)) =
          (σ_all j) ((((c_all j)⁻¹ : M_Cˣ) : M_C)) := by
      have hinv : (c_all j)⁻¹ =
          Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
            (Units.map (IntermediateField.inclusion (hFiMC i)).toMonoidHom ((c_orb i)⁻¹)) := by
        rw [hc_all_def j, ← map_inv, ← map_inv]
      have hcoe : (((c_all j)⁻¹ : M_Cˣ) : M_C) =
          (σ_all j).symm (IntermediateField.inclusion (hFiMC i)
            ((((c_orb i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field))) :=
        congrArg Units.val hinv
      rw [hcoe, AlgEquiv.apply_symm_apply]
    have htr_pull : traceLM F (D_orb.get i).le
        ((((c_orb i)⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) *
          traceLM F (hFiMC i) z') =
        traceLM F hLM_C ((((c_all j)⁻¹ : M_Cˣ) : M_C) * z) := by
      have hle_eq : (D_orb.get i).le.trans (hFiMC i) = hLM_C := rfl
      rw [← htrace_mul_inclusion (hFiMC i),
        ← htrace_trans L (D_orb.get i).field M_C (D_orb.get i).le (hFiMC i),
        hle_eq, hc_all_inv_σ]
      dsimp only [z']
      rw [← map_mul (σ_all j), (hν_props j).2.1]
    change ψ (traceLM F (D_orb.get i).le _) = ψ (traceLM F hLM_C _)
    rw [htr_pull]

  have hψMC_call_triv : ∀ (j : Fin (q - 1)) (e : M_C),
      (e = 0 ∨ (t + 1 : ℤ) ≤ valL F M_C e) →
      (traceChar F hLM_C ψ) ((((c_all j)⁻¹ : M_Cˣ) : M_C) * e) = 1 := by
    intro j e he
    apply hSpecMC.1
    have hc_inv_val : valL F M_C ((((c_all j)⁻¹ : M_Cˣ) : M_C)) =
        -((k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ)) := by
      rw [hvalMC.2.2.2.2.2.1 (c_all j), hc_all_val j]
    have hmul := hval_mul_ge M_C
      (-((k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ))) (t + 1 : ℤ)
      ((((c_all j)⁻¹ : M_Cˣ) : M_C)) e
      (Or.inr (le_of_eq hc_inv_val.symm)) he
    rcases hmul with h0 | hge
    · exact Or.inl h0
    · right; omega

  have hν_triv_t1 : ∀ j : Fin (q - 1), ∀ u ∈ unitGroup F M_C (t + 1), (ν_all j) u = 1 := by
    intro j u hu
    let z : M_C := (u : M_C) - 1
    have hz_1 : 1 + z = (u : M_C) := by dsimp only [z]; ring
    have hz : 1 + z ≠ 0 := by rw [hz_1]; exact Units.ne_zero u
    have hu_mk0 : Units.mk0 (1 + z) hz = u := Units.ext hz_1
    have hz_t1 : z = 0 ∨ (t + 1 : ℤ) ≤ valL F M_C z := by
      rcases (hvalMC.2.2.2.2.2.2.2.2.2.1 (t + 1) (by omega) u).mp hu with hu1 | hge
      · left; dsimp only [z]; rw [hu1, sub_self]
      · exact Or.inr hge
    have hz_t : z = 0 ∨ (t : ℤ) ≤ valL F M_C z := by
      rcases hz_t1 with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    apply Units.ext
    rw [← hu_mk0, hν_stat j z hz_t hz, hψMC_call_triv j z hz_t1, Units.val_one]

  have hν_nontriv_t : ∀ j : Fin (q - 1), ∃ u₀ ∈ unitGroup F M_C t, (ν_all j) u₀ ≠ 1 := by
    intro j
    obtain ⟨x₁, hx₁_ne, hx₁_val, hx₁_psi⟩ := hSpecMC.2.1
    let z₀ : M_C := ((c_all j : M_Cˣ) : M_C) * x₁
    have hz₀_val : (t : ℤ) ≤ valL F M_C z₀ := by
      dsimp only [z₀]
      rw [hvalMC.2.2.2.2.1 _ _ (Units.ne_zero (c_all j)) hx₁_ne, hc_all_val j]
      omega
    have hz₀_1_ne : 1 + z₀ ≠ 0 := by
      intro h0
      have hz₀_eq : z₀ = -1 := by linear_combination h0
      have hval_neg1 : valL F M_C z₀ = 0 := by rw [hz₀_eq, hvalMC.2.2.1]
      omega
    let u₀ : M_Cˣ := Units.mk0 (1 + z₀) hz₀_1_ne
    have hu₀_mem : u₀ ∈ unitGroup F M_C t := by
      rw [hvalMC.2.2.2.2.2.2.2.2.2.1 t ht_ge1 u₀]
      right
      have hsub : (u₀ : M_C) - 1 = z₀ := by change (1 + z₀) - 1 = z₀; ring
      rw [hsub]
      exact hz₀_val
    refine ⟨u₀, hu₀_mem, ?_⟩
    intro hu₀_eq1
    apply hx₁_psi
    have hstat := hν_stat j z₀ (Or.inr hz₀_val) hz₀_1_ne
    change ((ν_all j) u₀ : Ω F) = _ at hstat
    rw [hu₀_eq1, Units.val_one] at hstat
    have hcancel : ((((c_all j)⁻¹ : M_Cˣ) : M_C) * z₀) = x₁ := by
      dsimp only [z₀]
      rw [← mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mul]
    rw [hcancel] at hstat
    exact hstat.symm

  
  have hvalMC_pow_int : ∀ (z : M_C) (n : ℕ),
      (z = 0 ∨ 0 ≤ valL F M_C z) → (z ^ n = 0 ∨ 0 ≤ valL F M_C (z ^ n)) := by
    intro z n hz
    induction' n with n ih
    · right; simp [hvalMC.2.1]
    · rw [pow_succ]
      have h := hval_mul_ge M_C 0 0 (z ^ n) z ih hz
      simpa using h

  have hvalMC_sum_int : ∀ (S : Finset (Fin r_exp)) (f : Fin r_exp → M_C),
      (∀ m ∈ S, f m = 0 ∨ 0 ≤ valL F M_C (f m)) →
      ((∑ m ∈ S, f m) = 0 ∨ 0 ≤ valL F M_C (∑ m ∈ S, f m)) := by
    intro S f hf
    induction' S using Finset.induction_on with a s ha ih
    · left; simp
    · rw [Finset.sum_insert ha]
      exact hvalMC.2.2.2.2.2.2.2.1 0 (f a) (∑ m ∈ s, f m)
        (hf a (Finset.mem_insert_self a s))
        (ih (fun m hm => hf m (Finset.mem_insert_of_mem hm)))

  have hPz_int : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      (P_poly z = 0 ∨ 0 ≤ valL F M_C (P_poly z)) := by
    intro z hz
    rw [hP_def z]
    apply hvalMC.2.2.2.2.2.2.2.1 0
    · exact hvalMC_pow_int z q hz
    · apply hvalMC_sum_int Finset.univ
      intro m _
      have h := hval_mul_ge M_C 0 0 (a_coeff m) (z ^ ((p F) ^ (m : ℕ)))
        (ha_int m) (hvalMC_pow_int z ((p F) ^ (m : ℕ)) hz)
      simpa using h

  have hu_all_P : ∀ j : Fin (q - 1), ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      (traceChar F hLM_C ψ)
        ((((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₁)⁻¹ : M_Cˣ) : M_C) *
          ((u_all j : M_C) * P_poly z)) = 1 := by
    intro j z hz_int
    let y_K : K := IntermediateField.inclusion hM_CK z * ((ϖ_K ^ t : Kˣ) : K)
    have hz_K_int : IntermediateField.inclusion hM_CK z = 0 ∨
        0 ≤ valL F K (IntermediateField.inclusion hM_CK z) := by
      rcases hz_int with rfl | hz_ge0
      · left; exact map_zero _
      · right
        rw [hValAlgK z]
        exact mul_nonneg (Nat.cast_nonneg q) hz_ge0
    have hy_K_val : y_K = 0 ∨ (t : ℤ) ≤ valL F K y_K := by
      have h := hval_mul_ge K 0 (t : ℤ)
        (IntermediateField.inclusion hM_CK z) ((ϖ_K ^ t : Kˣ) : K)
        hz_K_int (Or.inr (le_of_eq hϖ_K_pow_val.symm))
      simpa [y_K] using h
    have hy_K_ne : 1 + y_K ≠ 0 := by
      intro h0
      have hy_eq : y_K = -1 := by linear_combination h0
      have hval_neg1 : valL F K y_K = 0 := by rw [hy_eq, hvalK.2.2.1]
      rcases hy_K_val with hy0 | hy_ge
      · have h10 : (1 : K) = 0 := by linear_combination h0 - hy0
        exact one_ne_zero h10
      · omega
    let w_K : Kˣ := Units.mk0 (1 + y_K) hy_K_ne
    let u_norm : M_Cˣ := Units.map (normLM F hM_CK) w_K
    have hν_u_norm : ((ν_all j) u_norm : Ω F) = 1 := by
      rw [(hν_props j).2.2.1 u_norm ⟨w_K, rfl⟩, Units.val_one]
    let z_norm : M_C := normLM F hM_CK (1 + y_K) - 1
    let e_z : M_C :=
      normLM F hM_CK (1 + y_K) - (1 + P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C))
    have hz_norm_1 : 1 + z_norm = (u_norm : M_C) := by
      change 1 + (normLM F hM_CK (1 + y_K) - 1) = normLM F hM_CK (1 + y_K)
      ring
    have hz_norm_ne : 1 + z_norm ≠ 0 := by
      rw [hz_norm_1]; exact Units.ne_zero u_norm
    have hu_norm_mk0 : Units.mk0 (1 + z_norm) hz_norm_ne = u_norm := Units.ext hz_norm_1
    have hz_norm_decomp : z_norm = P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C) + e_z := by
      dsimp only [z_norm, e_z]; ring
    have hPϖ_val : P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C) = 0 ∨
        (t : ℤ) ≤ valL F M_C (P_poly z * ((ϖ_MC ^ t : M_Cˣ) : M_C)) := by
      have h := hval_mul_ge M_C 0 (t : ℤ) (P_poly z) ((ϖ_MC ^ t : M_Cˣ) : M_C)
        (hPz_int z hz_int) (Or.inr (le_of_eq hϖ_MC_pow_val.symm))
      simpa using h
    have he_z_t1 : e_z = 0 ∨ (t + 1 : ℤ) ≤ valL F M_C e_z := hP_norm z hz_int
    have he_z_t : e_z = 0 ∨ (t : ℤ) ≤ valL F M_C e_z := by
      rcases he_z_t1 with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hz_norm_val : z_norm = 0 ∨ (t : ℤ) ≤ valL F M_C z_norm := by
      rw [hz_norm_decomp]
      exact hvalMC.2.2.2.2.2.2.2.1 (t : ℤ) _ _ hPϖ_val he_z_t
    have hstat := hν_stat j z_norm hz_norm_val hz_norm_ne
    rw [hu_norm_mk0, hν_u_norm, hz_norm_decomp, mul_add, AddChar.map_add_eq_mul,
      hψMC_call_triv j e_z he_z_t1, mul_one] at hstat
    rw [hu_all_mul j (P_poly z)]
    exact hstat.symm

  have hu_all_cong : ∀ j₁ j₂ : Fin (q - 1),
      ((u_all j₁ : M_C) - (u_all j₂ : M_C) = 0 ∨
        1 ≤ valL F M_C ((u_all j₁ : M_C) - (u_all j₂ : M_C))) →
      ∀ w ∈ unitGroup F M_C t, (ν_all j₁) w = (ν_all j₂) w := by
    intro j₁ j₂ hdiff w hw
    let z : M_C := (w : M_C) - 1
    have hz_1 : 1 + z = (w : M_C) := by dsimp only [z]; ring
    have hz : 1 + z ≠ 0 := by rw [hz_1]; exact Units.ne_zero w
    have hw_mk0 : Units.mk0 (1 + z) hz = w := Units.ext hz_1
    have hz_t : z = 0 ∨ (t : ℤ) ≤ valL F M_C z := by
      rcases (hvalMC.2.2.2.2.2.2.2.2.2.1 t ht_ge1 w).mp hw with hw1 | hge
      · left; dsimp only [z]; rw [hw1, sub_self]
      · exact Or.inr hge
    let z₁ : M_C := z * ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C))
    have hz₁_mul : z₁ * ((ϖ_MC ^ t : M_Cˣ) : M_C) = z := by
      dsimp only [z₁]
      rw [mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, mul_one]
    have hϖ_inv_val : valL F M_C ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C)) = -(t : ℤ) := by
      rw [hvalMC.2.2.2.2.2.1 (ϖ_MC ^ t), hϖ_MC_pow_val]
    have hz₁_int : z₁ = 0 ∨ 0 ≤ valL F M_C z₁ := by
      have h := hval_mul_ge M_C (t : ℤ) (-(t : ℤ)) z ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C))
        hz_t (Or.inr (le_of_eq hϖ_inv_val.symm))
      simpa [z₁] using h
    let δ : M_C := (((c₁_MC⁻¹ : M_Cˣ) : M_C) * (((u_all j₁ : M_C) - (u_all j₂ : M_C)) * z₁))
    have h_decomp : ((((c_all j₁)⁻¹ : M_Cˣ) : M_C) * z) =
        ((((c_all j₂)⁻¹ : M_Cˣ) : M_C) * z) + δ := by
      have hm1 := hu_all_mul j₁ z₁
      have hm2 := hu_all_mul j₂ z₁
      rw [hz₁_mul] at hm1 hm2
      change (((c₁_MC⁻¹ : M_Cˣ) : M_C) * ((u_all j₁ : M_C) * z₁)) = _ at hm1
      change (((c₁_MC⁻¹ : M_Cˣ) : M_C) * ((u_all j₂ : M_C) * z₁)) = _ at hm2
      rw [← hm1, ← hm2]
      dsimp only [δ]
      ring
    have hδ_psi : (traceChar F hLM_C ψ) δ = 1 := by
      apply hSpecMC.1
      have hc₁_inv_val : valL F M_C (((c₁_MC⁻¹ : M_Cˣ) : M_C)) =
          -((k : ℤ) * (1 + condExpChar F L ψ)) := by
        rw [hvalMC.2.2.2.2.2.1 c₁_MC, hc₁_MC_val]
      have hdu_z₁ := hval_mul_ge M_C 1 0
        ((u_all j₁ : M_C) - (u_all j₂ : M_C)) z₁ hdiff hz₁_int
      have hmul : δ = 0 ∨ -((k : ℤ) * (1 + condExpChar F L ψ)) + (1 + 0) ≤ valL F M_C δ :=
        hval_mul_ge M_C (-((k : ℤ) * (1 + condExpChar F L ψ))) (1 + 0)
          (((c₁_MC⁻¹ : M_Cˣ) : M_C)) (((u_all j₁ : M_C) - (u_all j₂ : M_C)) * z₁)
          (Or.inr (le_of_eq hc₁_inv_val.symm)) hdu_z₁
      rcases hmul with h0 | hge
      · exact Or.inl h0
      · right; omega
    apply Units.ext
    rw [← hw_mk0, hν_stat j₁ z hz_t hz, hν_stat j₂ z hz_t hz,
      h_decomp, AddChar.map_add_eq_mul, hδ_psi, mul_one]

  exact ⟨hu_all_val, hν_stat, hu_all_P, hν_triv_t1, hν_nontriv_t, hu_all_cong⟩

theorem ld_ch14_wild_prime_power_basis (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (A B : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F A] [FiniteDimensional F B] (hAB : A ≤ B)
    (hp_pos : 0 < Module.finrank A (IntermediateField.extendScalars hAB))
    (hValNorm : ∀ y : B, valL F A (normLM F hAB y) = valL F B y)
    (hValAlg : ∀ x : A,
      valL F B (IntermediateField.inclusion hAB x) =
        (Module.finrank A (IntermediateField.extendScalars hAB) : ℤ) * valL F A x) :
    let p := Module.finrank A (IntermediateField.extendScalars hAB)
    ∃ (ϖ_B : Bˣ) (ϖ_A : Aˣ),
      Units.map (normLM F hAB) ϖ_B = ϖ_A ∧
      valL F B (ϖ_B : B) = 1 ∧
      valL F A (ϖ_A : A) = 1 ∧
      ∀ y : B, ∃ c : Fin p → A,
        y = ∑ i : Fin p, IntermediateField.inclusion hAB (c i) * ((ϖ_B : B) ^ (i : ℕ)) ∧
        ∀ (m : ℤ),
          (y = 0 ∨ m ≤ valL F B y) ↔
            ∀ i : Fin p, c i = 0 ∨ m ≤ (p : ℤ) * valL F A (c i) + (i : ℤ) :=
by
  set B' := IntermediateField.extendScalars hAB
  set p := Module.finrank A B'
  have hp_int_pos : (0 : ℤ) < (p : ℤ) := Nat.cast_pos.mpr hp_pos
  have hp_int_ne : (p : ℤ) ≠ 0 := ne_of_gt hp_int_pos

  
  have halg_B : ∀ z : B,
      minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
      ∃ m : ℕ,
        Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
        Module.finrank F B = (minpoly F z).natDegree * m := by
    clear hValNorm hValAlg ‹IsNonarchimedeanLocalField F› ‹TopologicalSpace F› ‹ValuativeRel F›
    intro z
    have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
      minpoly.algHom_eq B.val B.val.injective z
    have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
    let pb := IntermediateField.adjoin.powerBasis hz
    have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
      IntermediateField.adjoin.powerBasis_gen hz
    have hmin_gen : minpoly F pb.gen = minpoly F z := by
      have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
        rw [hpb_gen]
        rfl
      rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
        (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
    have hpb_dim : pb.dim = (minpoly F z).natDegree := by
      rw [IntermediateField.adjoin.powerBasis_dim hz]
    have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
    rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
    refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
    rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
  let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
      b ≠ 0 ∧ addVal F b ≤ addVal F a := by
    intro a b ha hab
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
    have hφb : φ (valuation F b) ≠ 0 := by
      intro h0
      rw [h0] at hφ_le
      exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
    have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
    have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
    refine ⟨hb, ?_⟩
    rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
    unfold addVal
    rw [dif_neg ha, dif_neg hb]
    exact neg_le_neg hφ_le
  have haddVal0 : addVal F 0 = 0 := dif_pos rfl
  have haddVal1 : addVal F 1 = 0 := by
    have h1 : (1 : F) ≠ 0 := one_ne_zero
    have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
    have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
    unfold addVal
    rw [dif_neg h1]
    have hunz : WithZero.unzero hφ1 = 1 := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
    rw [hunz, toAdd_one, neg_zero]
  have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
    have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
    have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
    have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
    unfold addVal
    rw [dif_neg hab, dif_neg ha, dif_neg hb]
    have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
        WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
    rw [hunz, toAdd_mul, neg_add]
  have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
    intro a n ha
    have han : a ^ n ≠ 0 := pow_ne_zero n ha
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
    have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
    unfold addVal
    rw [dif_neg han, dif_neg ha]
    have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
        WithZero.coe_pow, WithZero.coe_unzero]
    rw [hunz, toAdd_pow]
    simp
  have hrel0 : relVal F B 0 = 0 := by
    unfold relVal
    rw [Algebra.norm_zero, haddVal0]
  have hrel1 : relVal F B 1 = 0 := by
    unfold relVal
    rw [map_one, haddVal1]
  have hrel_mul : ∀ x y : B, x ≠ 0 → y ≠ 0 → relVal F B (x * y) = relVal F B x + relVal F B y := by
    intro x y hx hy
    unfold relVal
    rw [map_mul, haddVal_mul _ _ (Algebra.norm_ne_zero_iff.mpr hx) (Algebra.norm_ne_zero_iff.mpr hy)]
  have hrel_neg1 : relVal F B (-1) = 0 := by
    have hne : (-1 : B) ≠ 0 := neg_ne_zero.mpr one_ne_zero
    have hsq := hrel_mul (-1) (-1) hne hne
    have h1 : (-1 : B) * (-1 : B) = 1 := by ring
    rw [h1, hrel1] at hsq
    omega
  have hrel_neg : ∀ x : B, relVal F B (-x) = relVal F B x := by
    intro x
    by_cases hx : x = 0
    · simp [hx]
    · have hne1 : (-1 : B) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hneg_eq : (-x : B) = (-1 : B) * x := by ring
      rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
  have hrel_inv : ∀ u : Bˣ, relVal F B ((u⁻¹ : Bˣ) : B) = - relVal F B (u : B) := by
    intro u
    have hmul := hrel_mul (u : B) ((u⁻¹ : Bˣ) : B) (Units.ne_zero u) (Units.ne_zero u⁻¹)
    rw [Units.mul_inv, hrel1] at hmul
    omega
  have hrel_pow : ∀ (u : Bˣ) (n : ℕ),
      relVal F B (((u ^ n : Bˣ) : B)) = (n : ℤ) * relVal F B (u : B) := by
    intro u n
    induction n with
    | zero => simp [hrel1]
    | succ n ih =>
      rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
      push_cast
      ring
  have hrel_zpow : ∀ (u : Bˣ) (m : ℤ),
      relVal F B (((u ^ m : Bˣ) : B)) = m * relVal F B (u : B) := by
    intro u m
    cases m with
    | ofNat n =>
      change relVal F B (((u ^ (n : ℤ) : Bˣ) : B)) = (n : ℤ) * relVal F B (u : B)
      rw [zpow_natCast, hrel_pow]
    | negSucc n =>
      rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
      push_cast
      ring
  obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
    (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
  have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
    rw [hπ]
    exact φ.apply_symm_apply _
  have hφπ_ne : φ (valuation F π) ≠ 0 := by
    rw [hφπ]
    exact WithZero.coe_ne_zero
  have hπ_ne : π ≠ 0 := fun h0 => hφπ_ne (by simp [h0])
  have hadd_π : addVal F π = 1 := by
    unfold addVal
    rw [dif_neg hπ_ne]
    have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
    rw [hunz, toAdd_ofAdd, neg_neg]
  let x₀ : B := algebraMap F B π
  have hx₀_ne : x₀ ≠ 0 := by simp [x₀, hπ_ne]
  have hrel_x₀ : relVal F B x₀ = (Module.finrank F B : ℤ) := by
    unfold relVal
    rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F B) hπ_ne, hadd_π, mul_one]
  let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : B, x ≠ 0 ∧ relVal F B x = k}
  have hS_nonempty : S.Nonempty := ⟨Module.finrank F B, Module.finrank_pos, x₀, hx₀_ne, hrel_x₀⟩
  have hfB_mem : resDeg F B ∈ S := Nat.sInf_mem hS_nonempty
  obtain ⟨hfB_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfB_mem
  let ϖB₀ : Bˣ := Units.mk0 ϖ₀ hϖ₀_ne
  have hrel_ϖB₀ : relVal F B (ϖB₀ : B) = (resDeg F B : ℤ) := hrel_ϖ₀
  have hfB_int_pos : (0 : ℤ) < (resDeg F B : ℤ) := Nat.cast_pos.mpr hfB_pos
  have hfB_int_ne : (resDeg F B : ℤ) ≠ 0 := ne_of_gt hfB_int_pos
  have hdiv_B : ∀ x : B, relVal F B x = (resDeg F B : ℤ) * valL F B x := by
    intro x
    by_cases hx : x = 0
    · unfold valL
      rw [hx, hrel0, Int.zero_ediv, mul_zero]
    · set f : ℤ := (resDeg F B : ℤ)
      set q_x : ℤ := valL F B x
      set r_x : ℤ := relVal F B x % f
      have hediv : f * q_x + r_x = relVal F B x := Int.mul_ediv_add_emod (relVal F B x) f
      have hr_nonneg : 0 ≤ r_x := Int.emod_nonneg (relVal F B x) hfB_int_ne
      have hr_lt : r_x < f := Int.emod_lt_of_pos (relVal F B x) hfB_int_pos
      have hr_zero : r_x = 0 := by
        by_contra hr_ne
        let y : B := x * (((ϖB₀ ^ (-q_x) : Bˣ) : B))
        have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
        have hrel_y : relVal F B y = r_x := by
          dsimp [y]
          rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖB₀ (-q_x), hrel_ϖB₀]
          linarith
        let k : ℕ := r_x.toNat
        have hk_eq : (k : ℤ) = r_x := Int.toNat_of_nonneg hr_nonneg
        have hk_pos : 0 < k := by omega
        have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
        have hle : resDeg F B ≤ k := Nat.sInf_le hk_mem
        omega
      linarith
  have hval1_B : valL F B 1 = 0 := by
    have h := hdiv_B 1
    rw [hrel1] at h
    exact (mul_eq_zero.mp h.symm).resolve_left hfB_int_ne
  have hval_neg_B : ∀ x : B, valL F B (-x) = valL F B x := by
    intro x
    apply mul_left_cancel₀ hfB_int_ne
    rw [← hdiv_B (-x), ← hdiv_B x, hrel_neg]
  have hval_mul_B : ∀ x y : B, x ≠ 0 → y ≠ 0 → valL F B (x * y) = valL F B x + valL F B y := by
    intro x y hx hy
    apply mul_left_cancel₀ hfB_int_ne
    rw [mul_add, ← hdiv_B (x * y), ← hdiv_B x, ← hdiv_B y, hrel_mul x y hx hy]
  have hval_pow_B : ∀ (y : B) (n : ℕ), y ≠ 0 → valL F B (y ^ n) = (n : ℤ) * valL F B y := by
    intro y n hy
    induction n with
    | zero => simp [hval1_B]
    | succ n ih =>
      rw [pow_succ, hval_mul_B (y ^ n) y (pow_ne_zero n hy) hy, ih]
      push_cast
      ring
  have hval_add_B : ∀ (k : ℤ) (x y : B),
      (x = 0 ∨ k ≤ valL F B x) → (y = 0 ∨ k ≤ valL F B y) →
        (x + y = 0 ∨ k ≤ valL F B (x + y)) := by
    letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
    haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
    haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
      Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
    letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
    haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
    have hspec_pow : ∀ z : B,
        (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F B) =
          ‖Algebra.norm F z‖ := by
      intro z
      obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg_B z
      have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
          ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
        rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
      have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
        rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
        exact_mod_cast minpoly.natDegree_pos hz
      rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
         ← Real.rpow_natCast]
      congr 1
      push_cast
      rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
    have hspec_le : ∀ w z : B, w ≠ 0 →
        spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
          spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
        z ≠ 0 ∧ valL F B z ≤ valL F B w := by
      intro w z hw hle
      have hpow_le :
          (spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F)) ^ (Module.finrank F B) ≤
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F B) :=
        pow_le_pow_left₀ (spectralNorm_nonneg _) hle _
      rw [hspec_pow w, hspec_pow z] at hpow_le
      have hv_eq : ∀ a : F, ‖a‖ =
          ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
            (valuation F a) : ℝ) := fun _ => rfl
      rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hpow_le
      have hv_le : valuation F (Algebra.norm F w) ≤ valuation F (Algebra.norm F z) :=
        (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp
          hpow_le
      have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
      obtain ⟨hnz, hrel_le⟩ := hval_le (Algebra.norm F w) (Algebra.norm F z) hnw hv_le
      have hz : z ≠ 0 := Algebra.norm_ne_zero_iff.mp hnz
      refine ⟨hz, ?_⟩
      exact Int.ediv_le_ediv hfB_int_pos hrel_le
    intro k x y hx hy
    by_cases hxy : x + y = 0
    · exact Or.inl hxy
    · right
      have hcoe : ((x + y : B) : AlgebraicClosure F) =
          (x : AlgebraicClosure F) + (y : AlgebraicClosure F) := rfl
      have hna := isNonarchimedean_spectralNorm (K := F)
        (x : AlgebraicClosure F) (y : AlgebraicClosure F)
      rw [← hcoe, le_max_iff] at hna
      rcases hna with hle_x | hle_y
      · obtain ⟨hx_ne, hval_x⟩ := hspec_le (x + y) x hxy hle_x
        exact le_trans (hx.resolve_left hx_ne) hval_x
      · obtain ⟨hy_ne, hval_y⟩ := hspec_le (x + y) y hxy hle_y
        exact le_trans (hy.resolve_left hy_ne) hval_y

  
  let ϖ_B : Bˣ := ϖB₀
  have hϖ_B : valL F B (ϖ_B : B) = 1 := by
    apply mul_left_cancel₀ hfB_int_ne
    rw [← hdiv_B (ϖ_B : B), hrel_ϖB₀, mul_one]
  let ϖ_A : Aˣ := Units.map (normLM F hAB) ϖ_B
  have hϖ_norm : Units.map (normLM F hAB) ϖ_B = ϖ_A := rfl
  have hϖ_A : valL F A (ϖ_A : A) = 1 := by
    change valL F A (normLM F hAB (ϖ_B : B)) = 1
    rw [hValNorm (ϖ_B : B), hϖ_B]

  have hval_strict_B : ∀ (y₁ y₂ : B),
      y₁ ≠ 0 → (y₂ = 0 ∨ valL F B y₁ + 1 ≤ valL F B y₂) →
        y₁ + y₂ ≠ 0 ∧ valL F B (y₁ + y₂) = valL F B y₁ := by
    intro y₁ y₂ hy₁ hy₂
    set v₁ : ℤ := valL F B y₁
    have hy₂_ge : y₂ = 0 ∨ v₁ ≤ valL F B y₂ := by
      rcases hy₂ with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum_ge : y₁ + y₂ = 0 ∨ v₁ ≤ valL F B (y₁ + y₂) :=
      hval_add_B v₁ y₁ y₂ (Or.inr le_rfl) hy₂_ge
    have hnot_gt : ¬ (y₁ + y₂ = 0 ∨ v₁ + 1 ≤ valL F B (y₁ + y₂)) := by
      intro hgt
      have hneg_y₂ : -y₂ = 0 ∨ v₁ + 1 ≤ valL F B (-y₂) := by
        rcases hy₂ with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right
          rw [hval_neg_B]
          exact hge
      have hy₁_gt := hval_add_B (v₁ + 1) (y₁ + y₂) (-y₂) hgt hneg_y₂
      have heq_y₁ : (y₁ + y₂) + (-y₂) = y₁ := by ring
      rw [heq_y₁] at hy₁_gt
      rcases hy₁_gt with h10 | h1ge
      · exact hy₁ h10
      · omega
    have hsum_ne : y₁ + y₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
    have hsum_v₁ : v₁ ≤ valL F B (y₁ + y₂) := hsum_ge.resolve_left hsum_ne
    have hsum_not1 : ¬ (v₁ + 1 ≤ valL F B (y₁ + y₂)) := fun h1 => hnot_gt (Or.inr h1)
    exact ⟨hsum_ne, by omega⟩

  
  let t_term (c : Fin p → A) (i : Fin p) : B :=
    IntermediateField.inclusion hAB (c i) * ((ϖ_B : B) ^ (i : ℕ))
  let v_term (c : Fin p → A) (i : Fin p) : ℤ :=
    (p : ℤ) * valL F A (c i) + (i.1 : ℤ)

  have ht_term_zero : ∀ (c : Fin p → A) (i : Fin p), c i = 0 → t_term c i = 0 := by
    intro c i hci
    dsimp [t_term]
    rw [hci, map_zero, zero_mul]

  have ht_term_nz : ∀ (c : Fin p → A) (i : Fin p),
      c i ≠ 0 → t_term c i ≠ 0 ∧ valL F B (t_term c i) = v_term c i := by
    intro c i hci
    have hinc_ne : IntermediateField.inclusion hAB (c i) ≠ 0 :=
      (RingHom.injective (IntermediateField.inclusion hAB).toRingHom).ne hci
    have hpow_ne : ((ϖ_B : B) ^ (i : ℕ)) ≠ 0 := pow_ne_zero (i : ℕ) (Units.ne_zero ϖ_B)
    refine ⟨mul_ne_zero hinc_ne hpow_ne, ?_⟩
    dsimp [t_term, v_term]
    rw [hval_mul_B _ _ hinc_ne hpow_ne, hValAlg (c i),
      hval_pow_B (ϖ_B : B) (i : ℕ) (Units.ne_zero ϖ_B), hϖ_B, mul_one]

  have hv_term_inj : ∀ (c : Fin p → A) (i j : Fin p),
      v_term c i = v_term c j → i = j := by
    intro c i j hij
    have hmod : ∀ k : Fin p, v_term c k % (p : ℤ) = (k.1 : ℤ) := by
      intro k
      dsimp [v_term]
      have hcomm : (p : ℤ) * valL F A (c k) + (k.1 : ℤ) =
          (k.1 : ℤ) + (p : ℤ) * valL F A (c k) := by ring
      rw [hcomm, Int.add_mul_emod_self_left,
        Int.emod_eq_of_lt (Nat.cast_nonneg k.1) (Nat.cast_lt.mpr k.2)]
    have hmod_eq : (i.1 : ℤ) = (j.1 : ℤ) := by
      rw [← hmod i, ← hmod j, hij]
    exact Fin.ext (Nat.cast_injective hmod_eq)

  have hval_sum_ge : ∀ (c : Fin p → A) (S : Finset (Fin p)) (m : ℤ),
      (∀ i ∈ S, c i = 0 ∨ m ≤ v_term c i) →
        ((∑ i ∈ S, t_term c i) = 0 ∨ m ≤ valL F B (∑ i ∈ S, t_term c i)) := by
    intro c S m hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_t : t_term c a = 0 ∨ m ≤ valL F B (t_term c a) := by
        by_cases hca : c a = 0
        · exact Or.inl (ht_term_zero c a hca)
        · right
          rw [(ht_term_nz c a hca).2]
          exact (hS a (Finset.mem_insert_self a s)).resolve_left hca
      have hs_t := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_B m (t_term c a) (∑ i ∈ s, t_term c i) ha_t hs_t

  have hsum_min_nz : ∀ (c : Fin p → A) (i : Fin p),
      c i ≠ 0 →
        ∃ i₀ : Fin p, c i₀ ≠ 0 ∧ v_term c i₀ ≤ v_term c i ∧
          (∑ j : Fin p, t_term c j) ≠ 0 ∧
          valL F B (∑ j : Fin p, t_term c j) = v_term c i₀ := by
    intro c i hci
    let S_nz : Finset (Fin p) := (Finset.univ : Finset (Fin p)).filter (fun j => c j ≠ 0)
    have hi_mem : i ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hci⟩
    obtain ⟨i₀, hi₀_mem, hi₀_min⟩ := Finset.exists_min_image S_nz (v_term c) ⟨i, hi_mem⟩
    have hci₀ : c i₀ ≠ 0 := (Finset.mem_filter.mp hi₀_mem).2
    have hle_i : v_term c i₀ ≤ v_term c i := hi₀_min i hi_mem
    have herase_ge : ∀ j ∈ (Finset.univ : Finset (Fin p)).erase i₀,
        c j = 0 ∨ v_term c i₀ + 1 ≤ v_term c j := by
      intro j hj
      have hj_ne : j ≠ i₀ := (Finset.mem_erase.mp hj).1
      by_cases hcj : c j = 0
      · exact Or.inl hcj
      · right
        have hj_mem : j ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hcj⟩
        have hle_j : v_term c i₀ ≤ v_term c j := hi₀_min j hj_mem
        have hne_v : v_term c i₀ ≠ v_term c j := fun heq => hj_ne (hv_term_inj c i₀ j heq).symm
        omega
    have hrem := hval_sum_ge c ((Finset.univ : Finset (Fin p)).erase i₀)
      (v_term c i₀ + 1) herase_ge
    obtain ⟨hti₀_ne, hti₀_val⟩ := ht_term_nz c i₀ hci₀
    rw [← hti₀_val] at hrem
    have hstrict := hval_strict_B (t_term c i₀)
      (∑ j ∈ (Finset.univ : Finset (Fin p)).erase i₀, t_term c j) hti₀_ne hrem
    rw [Finset.add_sum_erase Finset.univ (t_term c) (Finset.mem_univ i₀), hti₀_val] at hstrict
    exact ⟨i₀, hci₀, hle_i, hstrict.1, hstrict.2⟩

  have hval_sum_iff : ∀ (c : Fin p → A) (m : ℤ),
      ((∑ i : Fin p, t_term c i) = 0 ∨ m ≤ valL F B (∑ i : Fin p, t_term c i)) ↔
        ∀ i : Fin p, c i = 0 ∨ m ≤ v_term c i := by
    intro c m
    refine ⟨?_, fun hall => hval_sum_ge c Finset.univ m (fun i _ => hall i)⟩
    intro hsum i
    by_cases hci : c i = 0
    · exact Or.inl hci
    · right
      obtain ⟨i₀, _, hle_i, hsum_ne, hsum_val⟩ := hsum_min_nz c i hci
      have hm_le : m ≤ valL F B (∑ j : Fin p, t_term c j) := hsum.resolve_left hsum_ne
      omega

  have hlin_zero : ∀ (c : Fin p → A),
      (∑ i : Fin p, t_term c i) = 0 → ∀ i : Fin p, c i = 0 := by
    intro c hsum0 i
    by_contra hci
    obtain ⟨_, _, _, hsum_ne, _⟩ := hsum_min_nz c i hci
    exact hsum_ne hsum0

  let eF : B ≃ₐ[F] B' :=
    { toExtendScalars F hAB with
      invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hAB).mp y.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  haveI : FiniteDimensional F B' := Module.Finite.equiv eF.toLinearEquiv
  haveI : IsScalarTower F A B' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional A B' := Module.Finite.of_restrictScalars_finite F A B'

  let b_vec : Fin p → B' := fun i => (toExtendScalars F hAB (ϖ_B : B)) ^ (i : ℕ)
  have hli : LinearIndependent A b_vec := by
    rw [Fintype.linearIndependent_iff]
    intro c hc
    have hsum_eq : toExtendScalars F hAB (∑ i : Fin p, t_term c i) =
        ∑ i : Fin p, c i • b_vec i := by
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro i _
      dsimp [t_term, b_vec]
      rw [map_mul, map_pow]
      rfl
    have hsum0 : (∑ i : Fin p, t_term c i) = 0 := by
      apply eF.injective
      change toExtendScalars F hAB (∑ i : Fin p, t_term c i) = 0
      rw [hsum_eq, hc]
    exact hlin_zero c hsum0

  haveI : Nonempty (Fin p) := ⟨⟨0, hp_pos⟩⟩
  have hcard : Fintype.card (Fin p) = Module.finrank A B' := Fintype.card_fin p
  let B_basis : Module.Basis (Fin p) A B' := basisOfLinearIndependentOfCardEqFinrank hli hcard

  refine ⟨ϖ_B, ϖ_A, hϖ_norm, hϖ_B, hϖ_A, fun y => ?_⟩
  let c : Fin p → A := fun i => B_basis.repr (toExtendScalars F hAB y) i
  have hy_eq : y = ∑ i : Fin p, t_term c i := by
    apply eF.injective
    change toExtendScalars F hAB y = toExtendScalars F hAB (∑ i : Fin p, t_term c i)
    have hrepr := (B_basis.sum_repr (toExtendScalars F hAB y)).symm
    rw [hrepr, map_sum]
    apply Finset.sum_congr rfl
    intro i _
    dsimp [B_basis, c, t_term, b_vec]
    rw [coe_basisOfLinearIndependentOfCardEqFinrank hli hcard, map_mul, map_pow]
    rfl
  refine ⟨c, hy_eq, fun m => ?_⟩
  rw [hy_eq]
  exact hval_sum_iff c m

theorem ld_ch14_finite_field_artin_schreier_coker_gen (k_A : Type u) [Field k_A] [Fintype k_A]
    (p : ℕ) (hp : Nat.Prime p) (hp_char : (p : k_A) = 0) (b₀ : k_A) :
    ∃ a₁ : k_A, ∀ c : k_A, ∃ (e₀ : Fin p) (a : k_A),
      c = ((e₀ : ℕ) : k_A) * a₁ + (a ^ p + b₀ * a) :=
by
  classical
  haveI : CharP k_A p := (CharP.charP_iff_prime_eq_zero hp).mpr hp_char
  haveI : Fact (Nat.Prime p) := ⟨hp⟩
  have hp_pos : 0 < p := hp.pos
  have hp_gt1 : 1 < p := hp.one_lt
  let φ : k_A →+ k_A :=
    { toFun := fun a => a ^ p + b₀ * a
      map_zero' := by simp [hp.ne_zero]
      map_add' := fun x y => by
        rw [add_pow_char]
        ring }
  have hφ_apply : ∀ a : k_A, φ a = a ^ p + b₀ * a := fun _ => rfl
  have hφ_int : ∀ (z : ℤ) (x : k_A), φ ((z : k_A) * x) = (z : k_A) * φ x := by
    intro z x
    rw [← zsmul_eq_mul, φ.map_zsmul, zsmul_eq_mul]
  let P : Polynomial k_A := Polynomial.X ^ p + Polynomial.C b₀ * Polynomial.X
  have hP_deg : P.degree = (p : WithBot ℕ) := by
    have h1 : (Polynomial.C b₀ * Polynomial.X).degree ≤ 1 := Polynomial.degree_C_mul_X_le b₀
    have h2 : (1 : WithBot ℕ) < (p : WithBot ℕ) := by exact_mod_cast hp_gt1
    have h3 : (Polynomial.X ^ p : Polynomial k_A).degree = (p : WithBot ℕ) := Polynomial.degree_X_pow p
    have hlt : (Polynomial.C b₀ * Polynomial.X).degree < (Polynomial.X ^ p : Polynomial k_A).degree := by
      rw [h3]
      exact lt_of_le_of_lt h1 h2
    rw [Polynomial.degree_add_eq_left_of_degree_lt hlt, h3]
  have hP_ne0 : P ≠ 0 := by
    intro h0
    rw [h0, Polynomial.degree_zero] at hP_deg
    exact WithBot.coe_ne_bot hP_deg.symm
  have hP_natDeg : P.natDegree = p := Polynomial.natDegree_eq_of_degree_eq_some hP_deg
  let K_φ : Finset k_A := Finset.univ.filter (fun a => φ a = 0)
  have hK_sub : K_φ.val ⊆ P.roots := by
    intro a ha
    rw [← Finset.mem_def, Finset.mem_filter] at ha
    rw [Polynomial.mem_roots hP_ne0, Polynomial.IsRoot.def]
    simp only [P, Polynomial.eval_add, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_mul,
      Polynomial.eval_C]
    exact ha.2
  have hK_card : K_φ.card ≤ p := by
    calc K_φ.card ≤ P.natDegree := Polynomial.card_le_degree_of_subset_roots hK_sub
      _ = p := hP_natDeg
  let I_φ : Finset k_A := Finset.univ.image φ
  have h_fiber_card : ∀ y ∈ I_φ, (Finset.univ.filter (fun a => φ a = y)).card = K_φ.card := by
    intro y hy
    rcases Finset.mem_image.mp hy with ⟨a_y, _, rfl⟩
    have h_eq : Finset.univ.filter (fun a => φ a = φ a_y) = K_φ.image (fun k => k + a_y) := by
      ext a
      simp only [K_φ, Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_image]
      constructor
      · intro ha
        refine ⟨a - a_y, ?_, sub_add_cancel a a_y⟩
        rw [map_sub, ha, sub_self]
      · rintro ⟨k, hk, rfl⟩
        rw [map_add, hk, zero_add]
    rw [h_eq]
    exact Finset.card_image_of_injective K_φ (add_left_injective a_y)
  have h_card_kA : Fintype.card k_A ≤ p * I_φ.card := by
    have h_sum : Fintype.card k_A = I_φ.card * K_φ.card := by
      calc Fintype.card k_A = (Finset.univ : Finset k_A).card := by simp
        _ = ∑ y ∈ I_φ, (Finset.univ.filter (fun a => φ a = y)).card :=
            Finset.card_eq_sum_card_image φ Finset.univ
        _ = ∑ y ∈ I_φ, K_φ.card := Finset.sum_congr rfl h_fiber_card
        _ = I_φ.card * K_φ.card := by simp [Finset.sum_const, smul_eq_mul]
    calc Fintype.card k_A = I_φ.card * K_φ.card := h_sum
      _ ≤ I_φ.card * p := Nat.mul_le_mul_left I_φ.card hK_card
      _ = p * I_φ.card := Nat.mul_comm _ _
  have hd_inv : ∀ d : ℕ, 0 < d → d < p → ∃ z : ℤ, (z : k_A) * (d : k_A) = 1 := by
    intro d hd_pos hd_lt
    have h_ndvd : ¬ (p ∣ d) := Nat.not_dvd_of_pos_of_lt hd_pos hd_lt
    have h_cop : d.Coprime p := ((Nat.Prime.coprime_iff_not_dvd hp).mpr h_ndvd).symm
    have h_gcd : (d.gcd p : ℤ) = 1 := by exact_mod_cast h_cop.gcd_eq_one
    have h_bez := Nat.gcd_eq_gcd_ab d p
    rw [h_gcd] at h_bez
    refine ⟨d.gcdA p, ?_⟩
    have h_cast := congrArg (Int.cast : ℤ → k_A) h_bez
    push_cast at h_cast
    rw [hp_char, zero_mul, add_zero, mul_comm] at h_cast
    exact h_cast.symm
  by_cases h_univ : I_φ = Finset.univ
  · refine ⟨0, fun c => ?_⟩
    have hc : c ∈ I_φ := by rw [h_univ]; exact Finset.mem_univ c
    rcases Finset.mem_image.mp hc with ⟨a, _, ha⟩
    refine ⟨⟨0, hp_pos⟩, a, ?_⟩
    rw [← hφ_apply a, ha]
    ring
  · have h_not_all : ¬ (∀ x : k_A, x ∈ I_φ) := by
      intro hall
      exact h_univ (Finset.eq_univ_iff_forall.mpr hall)
    push_neg at h_not_all
    rcases h_not_all with ⟨a₁, ha₁⟩
    refine ⟨a₁, ?_⟩
    let ψ : Fin p × I_φ → k_A := fun p_y => ((p_y.1 : ℕ) : k_A) * a₁ + p_y.2.1
    have he_lt : ∀ (e₁ e₂ : Fin p) (y₁ y₂ : I_φ),
        (e₂ : ℕ) < (e₁ : ℕ) → ψ (e₁, y₁) = ψ (e₂, y₂) → False := by
      intro e₁ e₂ y₁ y₂ h_lt h_eq
      rcases Finset.mem_image.mp y₁.2 with ⟨x₁, _, hx₁⟩
      rcases Finset.mem_image.mp y₂.2 with ⟨x₂, _, hx₂⟩
      set d : ℕ := (e₁ : ℕ) - (e₂ : ℕ)
      have hd_pos : 0 < d := Nat.sub_pos_of_lt h_lt
      have hd_lt : d < p := by
        have h1 : (e₁ : ℕ) < p := e₁.2
        omega
      have hd_add : (e₂ : ℕ) + d = (e₁ : ℕ) := Nat.add_sub_of_le (le_of_lt h_lt)
      have hd_cast : ((e₁ : ℕ) : k_A) - ((e₂ : ℕ) : k_A) = (d : k_A) := by
        rw [← hd_add, Nat.cast_add, add_sub_cancel_left]
      have h_lin : (d : k_A) * a₁ = φ (x₂ - x₁) := by
        have h1 : (((e₁ : ℕ) : k_A) - ((e₂ : ℕ) : k_A)) * a₁ = y₂.1 - y₁.1 := by
          dsimp [ψ] at h_eq
          linear_combination h_eq
        rw [hd_cast, ← hx₁, ← hx₂, ← map_sub] at h1
        exact h1
      rcases hd_inv d hd_pos hd_lt with ⟨z, hz⟩
      have ha₁_eq : φ ((z : k_A) * (x₂ - x₁)) = a₁ := by
        rw [hφ_int, ← h_lin, ← mul_assoc, hz, one_mul]
      apply ha₁
      rw [← ha₁_eq]
      exact Finset.mem_image_of_mem φ (Finset.mem_univ _)
    have hψ_inj : Function.Injective ψ := by
      rintro ⟨e₁, y₁⟩ ⟨e₂, y₂⟩ h_eq
      have he_eq : e₁ = e₂ := by
        rcases lt_trichotomy (e₁ : ℕ) (e₂ : ℕ) with h_lt | h_eq_nat | h_gt
        · exfalso; exact he_lt e₂ e₁ y₂ y₁ h_lt h_eq.symm
        · exact Fin.ext h_eq_nat
        · exfalso; exact he_lt e₁ e₂ y₁ y₂ h_gt h_eq
      subst he_eq
      have hy_eq : y₁ = y₂ := by
        apply Subtype.ext
        dsimp [ψ] at h_eq
        exact add_left_cancel h_eq
      exact Prod.ext rfl hy_eq
    have hcard_le : p * I_φ.card ≤ Fintype.card k_A := by
      have h1 := Fintype.card_le_of_injective ψ hψ_inj
      simp only [Fintype.card_prod, Fintype.card_fin, Fintype.card_coe] at h1
      exact h1
    have hcard_eq : Fintype.card (Fin p × I_φ) = Fintype.card k_A := by
      simp only [Fintype.card_prod, Fintype.card_fin, Fintype.card_coe]
      exact le_antisymm hcard_le h_card_kA
    have hψ_bij : Function.Bijective ψ :=
      (Fintype.bijective_iff_injective_and_card ψ).mpr ⟨hψ_inj, hcard_eq⟩
    intro c
    rcases hψ_bij.2 c with ⟨⟨e₀, y⟩, hψ_c⟩
    rcases Finset.mem_image.mp y.2 with ⟨a, _, ha⟩
    refine ⟨e₀, a, ?_⟩
    dsimp [ψ] at hψ_c
    rw [← hψ_c, ← ha, hφ_apply]

theorem ld_ch14_wild_prime_herbrand_filtration_and_level_t_poly (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (A B : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F A] [FiniteDimensional F B] (hAB : A ≤ B)
    (hp_prime : Nat.Prime (p F))
    (hq_eq : Module.finrank A (IntermediateField.extendScalars hAB) = p F)
    (hValNorm : ∀ y : B, valL F A (normLM F hAB y) = valL F B y)
    (hValAlg : ∀ x : A,
      valL F B (IntermediateField.inclusion hAB x) =
        (Module.finrank A (IntermediateField.extendScalars hAB) : ℤ) * valL F A x)
    (ϖ_B : Bˣ) (ϖ_A : Aˣ)
    (hϖ_norm : Units.map (normLM F hAB) ϖ_B = ϖ_A)
    (hϖ_B : valL F B (ϖ_B : B) = 1)
    (hϖ_A : valL F A (ϖ_A : A) = 1)
    (k_A : Type u) [Field k_A] [Fintype k_A] (resA : A → k_A)
    (hresA_0 : resA 0 = 0) (hresA_1 : resA 1 = 1)
    (hresA_ring : ∀ x₁ x₂ : A, (x₁ = 0 ∨ 0 ≤ valL F A x₁) → (x₂ = 0 ∨ 0 ≤ valL F A x₂) →
      resA (x₁ + x₂) = resA x₁ + resA x₂ ∧
      resA (x₁ * x₂) = resA x₁ * resA x₂ ∧
      resA (-x₁) = -resA x₁)
    (hresA_ker : ∀ x : A, (x = 0 ∨ 0 ≤ valL F A x) → (resA x = 0 ↔ (x = 0 ∨ 1 ≤ valL F A x)))
    (hresA_surj : ∀ a : k_A, ∃ x : A, (x = 0 ∨ 0 ≤ valL F A x) ∧ resA x = a)
    (t : ℕ) (ht_ge1 : 1 ≤ t)
    (htr_bound : ∀ (m : ℤ) (y : B),
      (y = 0 ∨
        (Module.finrank A (IntermediateField.extendScalars hAB) : ℤ) * m -
          ((Module.finrank A (IntermediateField.extendScalars hAB) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F B y) →
      (traceLM F hAB y = 0 ∨ m ≤ valL F A (traceLM F hAB y)))
    (htr_surj : ∀ x : A, ∃ y_x : B,
      traceLM F hAB y_x = x ∧
      (x = 0 → y_x = 0) ∧
      (x ≠ 0 →
        y_x ≠ 0 ∧
        valL F B y_x =
          (Module.finrank A (IntermediateField.extendScalars hAB) : ℤ) * valL F A x +
            ((Module.finrank A (IntermediateField.extendScalars hAB) - 1 : ℕ) : ℤ) -
            ((Module.finrank A (IntermediateField.extendScalars hAB) - 1 : ℕ) : ℤ) *
              (t + 1 : ℤ)))
    (hnorm_exp : ∀ (m : ℕ), 1 ≤ m → ∀ y : B, (y = 0 ∨ (m : ℤ) ≤ valL F B y) →
      ∃ z : B, (z = 0 ∨ (2 * m : ℤ) ≤ valL F B z) ∧
        normLM F hAB (1 + y) = 1 + traceLM F hAB (y + z) + normLM F hAB y) :
    let p := p F
    let b_tr : A := (((ϖ_A ^ t)⁻¹ : Aˣ) : A) * traceLM F hAB ((ϖ_B ^ t : Bˣ) : B)
    ((p : k_A) = 0) ∧
    (∀ m < t, ∀ u ∈ unitGroup F A m,
      ∃ w ∈ unitGroup F B m,
        (Units.map (normLM F hAB) w) * u⁻¹ ∈ unitGroup F A (m + 1)) ∧
    (∀ r ≥ t + 1, ∀ w ∈ unitGroup F B (t + 1 + p * (r - t)),
      Units.map (normLM F hAB) w ∈ unitGroup F A (r + 1)) ∧
    (∀ r ≥ t + 1, ∀ u ∈ unitGroup F A r,
      ∃ w ∈ unitGroup F B (t + p * (r - t)),
        (Units.map (normLM F hAB) w) * u⁻¹ ∈ unitGroup F A (r + 1)) ∧
    (b_tr = 0 ∨ 0 ≤ valL F A b_tr) ∧
    (∀ s : A, (s = 0 ∨ 0 ≤ valL F A s) →
      normLM F hAB (1 + IntermediateField.inclusion hAB s * ((ϖ_B ^ t : Bˣ) : B)) -
        (1 + (s ^ p + b_tr * s) * ((ϖ_A ^ t : Aˣ) : A)) = 0 ∨
        ((t + 1 : ℕ) : ℤ) ≤ valL F A
          (normLM F hAB (1 + IntermediateField.inclusion hAB s * ((ϖ_B ^ t : Bˣ) : B)) -
            (1 + (s ^ p + b_tr * s) * ((ϖ_A ^ t : Aˣ) : A)))) :=
by
  intro p b_tr
  have hvalL_props_gen : ∀ (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L],
      valL F L 0 = 0 ∧
      valL F L 1 = 0 ∧
      valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0) := by
    intro L _
    have halg_gen : ∀ (F₀ : Type u) [Field F₀]
        (L₀ : IntermediateField F₀ (AlgebraicClosure F₀)) [FiniteDimensional F₀ L₀] (z : L₀),
        minpoly F₀ (z : AlgebraicClosure F₀) = minpoly F₀ z ∧
        ∃ m : ℕ,
          Algebra.norm F₀ z = ((-1) ^ (minpoly F₀ z).natDegree * (minpoly F₀ z).coeff 0) ^ m ∧
          Module.finrank F₀ L₀ = (minpoly F₀ z).natDegree * m := by
      intro F₀ _ L₀ _ z
      have hmin_coe : minpoly F₀ (z : AlgebraicClosure F₀) = minpoly F₀ z :=
        minpoly.algHom_eq L₀.val L₀.val.injective z
      have hz : IsIntegral F₀ z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F₀ z :=
        IntermediateField.adjoin.powerBasis_gen hz
      have hmin_gen : minpoly F₀ pb.gen = minpoly F₀ z := by
        have hval : (IntermediateField.adjoin F₀ {z}).val pb.gen = z := by
          rw [hpb_gen]
          rfl
        rw [← minpoly.algHom_eq (IntermediateField.adjoin F₀ {z}).val
          (IntermediateField.adjoin F₀ {z}).val.injective pb.gen, hval]
      have hpb_dim : pb.dim = (minpoly F₀ z).natDegree := by
        rw [IntermediateField.adjoin.powerBasis_dim hz]
      have hnorm_adj := Algebra.norm_eq_norm_adjoin F₀ z
      rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
      refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
      rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
    have halg := halg_gen F L
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
        b ≠ 0 ∧ addVal F b ≤ addVal F a := by
      intro a b ha hab
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
      have hφb : φ (valuation F b) ≠ 0 := by
        intro h0
        rw [h0] at hφ_le
        exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
      have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
      have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
      refine ⟨hb, ?_⟩
      rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
      unfold addVal
      rw [dif_neg ha, dif_neg hb]
      exact neg_le_neg hφ_le
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
      have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
      have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
      have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
      unfold addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
      intro a n ha
      have han : a ^ n ≠ 0 := pow_ne_zero n ha
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
      have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
      unfold addVal
      rw [dif_neg han, dif_neg ha]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    have hrel0 : relVal F L 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F L 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → relVal F L (x * y) = relVal F L x + relVal F L y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
    have hrel_neg1 : relVal F L (-1) = 0 := by
      have hne : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hsq : relVal F L ((-1 : L) * (-1 : L)) = relVal F L (-1) + relVal F L (-1) :=
        hrel_mul (-1) (-1) hne hne
      have h1 : (-1 : L) * (-1 : L) = 1 := by ring
      rw [h1, hrel1] at hsq
      omega
    have hrel_neg : ∀ x : L, relVal F L (-x) = relVal F L x := by
      intro x
      by_cases hx : x = 0
      · simp [hx]
      · have hne1 : (-1 : L) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have hneg_eq : (-x : L) = (-1 : L) * x := by ring
        rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
    have hrel_inv : ∀ u : Lˣ, relVal F L ((u⁻¹ : Lˣ) : L) = - relVal F L (u : L) := by
      intro u
      have hmul : relVal F L ((u : L) * ((u⁻¹ : Lˣ) : L)) =
          relVal F L (u : L) + relVal F L ((u⁻¹ : Lˣ) : L) :=
        hrel_mul (u : L) ((u⁻¹ : Lˣ) : L) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Lˣ) (n : ℕ),
        relVal F L (((u ^ n : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L) := by
      intro u n
      induction n with
      | zero =>
        simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Lˣ) (m : ℤ),
        relVal F L (((u ^ m : Lˣ) : L)) = m * relVal F L (u : L) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F L (((u ^ (n : ℤ) : Lˣ) : L)) = (n : ℤ) * relVal F L (u : L)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := by
      intro h0
      apply hφπ_ne
      simp [h0]
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x₀ : L := algebraMap F L π
    have hx₀_ne : x₀ ≠ 0 := by
      simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F L x₀ = (Module.finrank F L : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F L) hπ_ne, hadd_π, mul_one]
    have hfin_pos : 0 < Module.finrank F L := Module.finrank_pos
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : L, x ≠ 0 ∧ relVal F L x = k}
    have hS_nonempty : S.Nonempty := ⟨Module.finrank F L, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfL_mem : resDeg F L ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfL_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfL_mem
    let ϖL : Lˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖL : relVal F L (ϖL : L) = (resDeg F L : ℤ) := hrel_ϖ₀
    have hfL_int_pos : (0 : ℤ) < (resDeg F L : ℤ) := Nat.cast_pos.mpr hfL_pos
    have hfL_int_ne : (resDeg F L : ℤ) ≠ 0 := ne_of_gt hfL_int_pos
    have hdiv : ∀ x : L, relVal F L x = (resDeg F L : ℤ) * valL F L x := by
      intro x
      by_cases hx : x = 0
      · unfold valL
        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F L : ℤ)
        set q : ℤ := valL F L x
        set r : ℤ := relVal F L x % f
        have hediv : f * q + r = relVal F L x := Int.mul_ediv_add_emod (relVal F L x) f
        have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F L x) hfL_int_ne
        have hr_lt : r < f := Int.emod_lt_of_pos (relVal F L x) hfL_int_pos
        have hr_zero : r = 0 := by
          by_contra hr_ne
          have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
          let y : L := x * (((ϖL ^ (-q) : Lˣ) : L))
          have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
          have hrel_y : relVal F L y = r := by
            dsimp [y]
            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖL (-q), hrel_ϖL]
            linarith
          let k : ℕ := r.toNat
          have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k := by omega
          have hk_lt : k < resDeg F L := by omega
          have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F L ≤ k := Nat.sInf_le hk_mem
          omega
        linarith
    have hval0 : valL F L 0 = 0 := by
      have h := hdiv 0
      rw [hrel0] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval1 : valL F L 1 = 0 := by
      have h := hdiv 1
      rw [hrel1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval_neg1 : valL F L (-1) = 0 := by
      have h := hdiv (-1)
      rw [hrel_neg1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfL_int_ne
    have hval_neg : ∀ x : L, valL F L (-x) = valL F L x := by
      intro x
      apply mul_left_cancel₀ hfL_int_ne
      rw [← hdiv (-x), ← hdiv x, hrel_neg]
    have hval_mul : ∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y := by
      intro x y hx hy
      apply mul_left_cancel₀ hfL_int_ne
      rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
    have hval_inv : ∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L) := by
      intro u
      apply mul_left_cancel₀ hfL_int_ne
      rw [mul_neg, ← hdiv, ← hdiv, hrel_inv]
    have hval_add : ∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y)) := by
      letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
      haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
      haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
        Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
      letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
      haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
      have hspec_pow : ∀ z : L,
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F L) =
            ‖Algebra.norm F z‖ := by
        intro z
        obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg z
