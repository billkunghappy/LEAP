      change σ (y₀ : A) = (y₀ : A)
      rw [hσ_act (y₀ : A), h1, hact_one]
    have htw := hσ_twist y₀
    rw [MonoidHom.mul_apply, hσ_y₀] at htw
    have htw1 : ξA y₀ * θA y₀ * (θA y₀)⁻¹ = θA y₀ * (θA y₀)⁻¹ :=
      congrArg (· * (θA y₀)⁻¹) htw
    rw [mul_inv_cancel_right, mul_inv_cancel] at htw1
    exact hy₀_ne htw1
  let z_y₀ : A := (y₀ : A) - 1
  have hzy₀_val : z_y₀ = 0 ∨ (uA : ℤ) ≤ valL F A z_y₀ := by
    rcases (hunit_ge1_A uA huA_ge1 y₀).mp hy₀_mem with h1 | hge
    · exact Or.inl (sub_eq_zero.mpr h1)
    · exact Or.inr hge
  have hshift_y₀ : act τ z_y₀ - z_y₀ = 0 ∨
      (uA : ℤ) + (t : ℤ) ≤ valL F A (act τ z_y₀ - z_y₀) :=
    hact_shift τ z_y₀ (uA : ℤ) hzy₀_val
  have hact_zy₀_eq : act τ z_y₀ - z_y₀ = σ (y₀ : A) - (y₀ : A) := by
    dsimp [z_y₀]
    rw [hσ_act (y₀ : A)]
    change φ_act τ ((y₀ : A) - 1) - ((y₀ : A) - 1) = act τ (y₀ : A) - (y₀ : A)
    rw [map_sub (φ_act τ), map_one (φ_act τ), hφ_act_apply]
    ring
  let w₀ : Aˣ := (Units.map σ.toRingEquiv.toMonoidHom y₀) * y₀⁻¹
  have hw₀_sub : (w₀ : A) - 1 = (act τ z_y₀ - z_y₀) * ((y₀⁻¹ : Aˣ) : A) := by
    change σ (y₀ : A) * ((y₀⁻¹ : Aˣ) : A) - 1 = _
    rw [hact_zy₀_eq, sub_mul, Units.mul_inv]
  have hy₀_inv_val0 : ((y₀⁻¹ : Aˣ) : A) = 0 ∨ 0 ≤ valL F A ((y₀⁻¹ : Aˣ) : A) := by
    right
    rw [hval_inv_A y₀, hunit_val0_A uA y₀ hy₀_mem, neg_zero]
  have hmA_sub1_eq : ((mA - 1 : ℕ) : ℤ) = (uA : ℤ) + (t : ℤ) := by omega
  have hmA_sub1_ge1 : 1 ≤ mA - 1 := by omega
  have hw₀_mem : w₀ ∈ unitGroup F A (mA - 1) := by
    rw [hunit_ge1_A (mA - 1) hmA_sub1_ge1 w₀, hw₀_sub]
    have hmul := hval_mul_ge_A ((uA : ℤ) + (t : ℤ)) 0
      (act τ z_y₀ - z_y₀) ((y₀⁻¹ : Aˣ) : A) hshift_y₀ hy₀_inv_val0
    rw [add_zero, ← hmA_sub1_eq] at hmul
    rcases hmul with h0 | hge
    · exact Or.inl (sub_eq_zero.mp (hw₀_sub.trans h0))
    · exact Or.inr hge
  have hθA_w₀ : θA w₀ = ξA y₀ := by
    change θA ((Units.map σ.toRingEquiv.toMonoidHom y₀) * y₀⁻¹) = ξA y₀
    rw [map_mul, map_inv, ← hσ_twist y₀, MonoidHom.mul_apply, mul_inv_cancel_right]
  have hmA_le : mA ≤ condExp F A θA := by
    by_contra hlt
    have hle : condExp F A θA ≤ mA - 1 := by omega
    have hw₀_cond : w₀ ∈ unitGroup F A (condExp F A θA) := hunit_anti_A hle hw₀_mem
    have h1 : θA w₀ = 1 := hθA_cond w₀ hw₀_cond
    rw [hθA_w₀] at h1
    exact hy₀_ne h1

  
  have hres_nat : ∀ n : ℕ, ((n : L) = 0 ∨ 0 ≤ valL F L (n : L)) ∧ resL (n : L) = (n : k_L) := by
    intro n
    induction n with
    | zero =>
      refine ⟨Or.inl Nat.cast_zero, ?_⟩
      rw [Nat.cast_zero, Nat.cast_zero, hresL_0]
    | succ n ih =>
      have h1 : (1 : L) = 0 ∨ 0 ≤ valL F L 1 := Or.inr (by rw [hval1_L])
      have hval_succ : ((n + 1 : ℕ) : L) = 0 ∨ 0 ≤ valL F L ((n + 1 : ℕ) : L) := by
        rw [Nat.cast_succ]
        exact hval_add_L 0 (n : L) 1 ih.1 h1
      refine ⟨hval_succ, ?_⟩
      rw [Nat.cast_succ, (hresL_ring (n : L) 1 ih.1 h1).1, ih.2, hresL_1, Nat.cast_succ]
  have hp_kL' : (p : k_L) = 0 := by
    rw [show p = EllipticRootNumber.p F from hWild]
    exact hp_kL
  have hringChar_kL : ringChar k_L = p := by
    have hdvd : ringChar k_L ∣ p := (ringChar.spec k_L p).mp hp_kL'
    rcases (Nat.dvd_prime hPrime).mp hdvd with h1 | hp_eq
    · exfalso
      have h1_zero : ((1 : ℕ) : k_L) = 0 := (ringChar.spec k_L 1).mpr (by rw [h1])
      rw [Nat.cast_one] at h1_zero
      exact one_ne_zero h1_zero
    · exact hp_eq
  have hi₀_L : ∀ i₀ : ℕ, 1 ≤ i₀ → i₀ < p → (i₀ : L) ≠ 0 ∧ valL F L (i₀ : L) = 0 := by
    intro i₀ hi₀_ge1 hi₀_lt
    have hi₀_kL_ne0 : (i₀ : k_L) ≠ 0 := by
      intro h0
      have hdvd : p ∣ i₀ := by
        rw [← hringChar_kL]
        exact (ringChar.spec k_L i₀).mp h0
      exact Nat.not_dvd_of_pos_of_lt (by omega) hi₀_lt hdvd
    have hres_ne0 : resL (i₀ : L) ≠ 0 := by
      rw [(hres_nat i₀).2]
      exact hi₀_kL_ne0
    have hnot_ge1 : ¬ ((i₀ : L) = 0 ∨ 1 ≤ valL F L (i₀ : L)) := by
      intro hge1
      exact hres_ne0 ((hresL_ker (i₀ : L) (hres_nat i₀).1).mpr hge1)
    have hi₀_ne0 : (i₀ : L) ≠ 0 := fun h0 => hnot_ge1 (Or.inl h0)
    have hge0 : 0 ≤ valL F L (i₀ : L) := ((hres_nat i₀).1).resolve_left hi₀_ne0
    have hnot1 : ¬ (1 ≤ valL F L (i₀ : L)) := fun h1 => hnot_ge1 (Or.inr h1)
    exact ⟨hi₀_ne0, by omega⟩
  have hi₀_A : ∀ i₀ : ℕ, 1 ≤ i₀ → i₀ < p → (i₀ : A) ≠ 0 ∧ valL F A (i₀ : A) = 0 := by
    intro i₀ hi₀_ge1 hi₀_lt
    obtain ⟨hne0_L, hval0_L_i⟩ := hi₀_L i₀ hi₀_ge1 hi₀_lt
    have hinc_eq : IntermediateField.inclusion hLA (i₀ : L) = (i₀ : A) :=
      map_natCast (IntermediateField.inclusion hLA) i₀
    refine ⟨?_, ?_⟩
    · rw [← hinc_eq]
      exact hinj_LA.ne hne0_L
    · rw [← hinc_eq, hval_alg (i₀ : L), hval0_L_i, mul_zero]

  let π : A := (ϖ_A : A)
  have hπ_ne0 : π ≠ 0 := Units.ne_zero ϖ_A
  let δ₁ : A := act τ π - π
  have hδ₁_ne0 : δ₁ ≠ 0 := by
    intro h0
    exact (hjump τ hτ_ne1).1 (sub_eq_zero.mpr (sub_eq_zero.mp h0).symm)
  have hδ₁_val : valL F A δ₁ = (t + 1 : ℤ) := by
    have hneg : δ₁ = -(π - act τ π) := by dsimp [δ₁]; ring
    rw [hneg, hval_neg_A, (hjump τ hτ_ne1).2]
  have hTelescopic : ∀ n : ℕ, 1 ≤ n →
      ∃ R : A, (R = 0 ∨ (n : ℤ) + 2 * (t : ℤ) ≤ valL F A R) ∧
        (act τ π) ^ n - π ^ n = (n : A) * π ^ (n - 1) * δ₁ + R := by
    intro n
    induction n with
    | zero => intro h; omega
    | succ n ih =>
      intro _
      by_cases hn0 : n = 0
      · subst hn0
        refine ⟨0, Or.inl rfl, ?_⟩
        dsimp [δ₁]
        simp
      · have hn1 : 1 ≤ n := Nat.one_le_iff_ne_zero.mpr hn0
        obtain ⟨R_n, hRn_val, hRn_eq⟩ := ih hn1
        let R_next : A := R_n * (act τ π) + (n : A) * π ^ (n - 1) * (δ₁ * δ₁)
        have hτπ_val : act τ π = 0 ∨ (1 : ℤ) ≤ valL F A (act τ π) :=
          Or.inr (by rw [hact_val τ π, hϖ_A])
        have h1_val := hval_mul_ge_A ((n : ℤ) + 2 * (t : ℤ)) 1 R_n (act τ π) hRn_val hτπ_val
        have h1_val' : R_n * (act τ π) = 0 ∨
            ((n + 1 : ℕ) : ℤ) + 2 * (t : ℤ) ≤ valL F A (R_n * (act τ π)) := by
          rcases h1_val with h0 | hge
          · exact Or.inl h0
          · right; push_cast; omega
        have hn_A_val : (n : A) = 0 ∨ 0 ≤ valL F A (n : A) := by
          have hinc : (n : A) = IntermediateField.inclusion hLA (n : L) :=
            (map_natCast (IntermediateField.inclusion hLA) n).symm
          rw [hinc]
          simpa using hval_inc_ge 0 (n : L) (hres_nat n).1
        have hπ_nm1_val : π ^ (n - 1) = 0 ∨ ((n - 1 : ℕ) : ℤ) ≤ valL F A (π ^ (n - 1)) := by
          right
          rw [hval_pow_A π (n - 1) hπ_ne0, hϖ_A, mul_one]
        have hδ₁_sq_val : δ₁ * δ₁ = 0 ∨ 2 * (t + 1 : ℤ) ≤ valL F A (δ₁ * δ₁) := by
          right
          rw [hval_mul_A δ₁ δ₁ hδ₁_ne0 hδ₁_ne0, hδ₁_val]
          omega
        have h2a := hval_mul_ge_A 0 ((n - 1 : ℕ) : ℤ) (n : A) (π ^ (n - 1)) hn_A_val hπ_nm1_val
        have h2b := hval_mul_ge_A (0 + ((n - 1 : ℕ) : ℤ)) (2 * (t + 1 : ℤ))
          ((n : A) * π ^ (n - 1)) (δ₁ * δ₁) h2a hδ₁_sq_val
        have h2_val' : (n : A) * π ^ (n - 1) * (δ₁ * δ₁) = 0 ∨
            ((n + 1 : ℕ) : ℤ) + 2 * (t : ℤ) ≤
              valL F A ((n : A) * π ^ (n - 1) * (δ₁ * δ₁)) := by
          rcases h2b with h0 | hge
          · exact Or.inl h0
          · right; push_cast; omega
        refine ⟨R_next, hval_add_A (((n + 1 : ℕ) : ℤ) + 2 * (t : ℤ)) _ _ h1_val' h2_val', ?_⟩
        have hact_π : act τ π = π + δ₁ := by dsimp [δ₁]; ring
        have hpow_step : (act τ π) ^ (n + 1) - π ^ (n + 1) =
            ((act τ π) ^ n - π ^ n) * (act τ π) + π ^ n * δ₁ := by
          rw [pow_succ (act τ π) n, pow_succ π n]
          dsimp [δ₁]
          ring
        have hπ_n : π ^ n = π ^ (n - 1) * π := by
          conv_lhs => rw [← Nat.sub_add_cancel hn1, pow_succ π (n - 1)]
        have halg : ((n : A) * π ^ (n - 1) * δ₁ + R_n) * (act τ π) + π ^ n * δ₁ =
            (n : A) * π ^ (n - 1) * δ₁ * (π + δ₁) + R_n * (act τ π) + π ^ n * δ₁ := by
          rw [add_mul, ← hact_π]
        rw [hpow_step, hRn_eq, halg, Nat.add_sub_cancel, hπ_n, Nat.cast_succ]
        dsimp [R_next]
        ring

  have hval_add_eq_left_A : ∀ (a b : A) (k : ℤ),
      a ≠ 0 → valL F A a = k → (b = 0 ∨ k + 1 ≤ valL F A b) →
      a + b ≠ 0 ∧ valL F A (a + b) = k := by
    intro a b k ha0 hak hb
    have ha_k : a = 0 ∨ k ≤ valL F A a := Or.inr (by omega)
    have hb_k : b = 0 ∨ k ≤ valL F A b := hval_le_A (by omega) hb
    have hab_ge : a + b = 0 ∨ k ≤ valL F A (a + b) := hval_add_A k a b ha_k hb_k
    have hnot_kp1 : ¬ (a + b = 0 ∨ k + 1 ≤ valL F A (a + b)) := by
      intro hab_kp1
      have hneg_b : -b = 0 ∨ k + 1 ≤ valL F A (-b) := by
        rcases hb with rfl | hge
        · exact Or.inl neg_zero
        · right; rw [hval_neg_A]; exact hge
      have ha_kp1 := hval_add_A (k + 1) (a + b) (-b) hab_kp1 hneg_b
      rw [add_neg_cancel_right] at ha_kp1
      have hge := ha_kp1.resolve_left ha0
      omega
    have hab_ne0 : a + b ≠ 0 := fun h0 => hnot_kp1 (Or.inl h0)
    have hge_k : k ≤ valL F A (a + b) := hab_ge.resolve_left hab_ne0
    have hnot_ge : ¬ (k + 1 ≤ valL F A (a + b)) := fun h1 => hnot_kp1 (Or.inr h1)
    exact ⟨hab_ne0, by omega⟩

  have hδ_pow : ∀ i₀ : ℕ, 1 ≤ i₀ → i₀ < p →
      act τ (π ^ i₀) - π ^ i₀ ≠ 0 ∧
      valL F A (act τ (π ^ i₀) - π ^ i₀) = (i₀ : ℤ) + (t : ℤ) := by
    intro i₀ hi₀_ge1 hi₀_lt
    obtain ⟨hi₀_ne0, hi₀_val0⟩ := hi₀_A i₀ hi₀_ge1 hi₀_lt
    obtain ⟨R, hR_val, hR_eq⟩ := hTelescopic i₀ hi₀_ge1
    have hact_pow : act τ (π ^ i₀) = (act τ π) ^ i₀ := map_pow (φ_act τ) π i₀
    let T₁ : A := (i₀ : A) * π ^ (i₀ - 1) * δ₁
    have hπ_pow_ne0 : π ^ (i₀ - 1) ≠ 0 := pow_ne_zero (i₀ - 1) hπ_ne0
    have hT₁_ne0 : T₁ ≠ 0 := mul_ne_zero (mul_ne_zero hi₀_ne0 hπ_pow_ne0) hδ₁_ne0
    have hT₁_val : valL F A T₁ = (i₀ : ℤ) + (t : ℤ) := by
      dsimp [T₁]
      rw [hval_mul_A _ _ (mul_ne_zero hi₀_ne0 hπ_pow_ne0) hδ₁_ne0,
        hval_mul_A _ _ hi₀_ne0 hπ_pow_ne0, hi₀_val0,
        hval_pow_A π (i₀ - 1) hπ_ne0, hϖ_A, mul_one, hδ₁_val]
      omega
    have hR_val' : R = 0 ∨ ((i₀ : ℤ) + (t : ℤ)) + 1 ≤ valL F A R :=
      hval_le_A (by omega) hR_val
    rw [hact_pow, hR_eq]
    exact hval_add_eq_left_A T₁ R ((i₀ : ℤ) + (t : ℤ)) hT₁_ne0 hT₁_val hR_val'

  have hStep : ∀ k ≥ mA, ∀ w ∈ unitGroup F A k,
      Units.map (normLM F hLA) w ∈ unitGroup F L (t + 1 + (k - t) / p) →
      ∃ w' ∈ unitGroup F A (k + 1),
        Units.map (normLM F hLA) w' = Units.map (normLM F hLA) w ∧
        θA w' = θA w := by
    intro k hk_ge w hw hnw
    let q : ℕ := k - t
    let m₀ : ℕ := q / p
    let i₀ : ℕ := q % p
    have hq_ge : bξ ≤ q := by omega
    have hq_ge2 : 2 ≤ q := by omega
    have hk_ge2 : 2 ≤ k := by omega
    have hk_ge1 : 1 ≤ k := by omega
    have hq_div : p * m₀ + i₀ = q := Nat.div_add_mod q p
    have hk_eq : p * m₀ + i₀ + t = k := by omega
    let z : A := (w : A) - 1
    have hz_val : z = 0 ∨ (k : ℤ) ≤ valL F A z := by
      rcases (hunit_ge1_A k hk_ge1 w).mp hw with h1 | hge
      · exact Or.inl (sub_eq_zero.mpr h1)
      · exact Or.inr hge
    by_cases hi₀_ne0 : i₀ ≠ 0
    · 
      have hi₀_ge1 : 1 ≤ i₀ := Nat.one_le_iff_ne_zero.mpr hi₀_ne0
      have hi₀_lt : i₀ < p := Nat.mod_lt q hp_pos
      let δ_i : A := act τ (π ^ i₀) - π ^ i₀
      obtain ⟨hδi_ne0, hδi_val⟩ := hδ_pow i₀ hi₀_ge1 hi₀_lt
      let u_δ : Aˣ := Units.mk0 δ_i hδi_ne0
      have huδ_coe : (u_δ : A) = δ_i := Units.val_mk0 hδi_ne0
      have huδ_inv_val : ((u_δ⁻¹ : Aˣ) : A) = 0 ∨
          -((i₀ : ℤ) + (t : ℤ)) ≤ valL F A ((u_δ⁻¹ : Aˣ) : A) := by
        right
        rw [hval_inv_A u_δ, huδ_coe, hδi_val]
      let ϖL_m : L := ((ϖ_L ^ m₀ : Lˣ) : L)
      let ϖL_m_inv : L := (((ϖ_L ^ m₀ : Lˣ)⁻¹ : Lˣ) : L)
      have hϖL_m_val : IntermediateField.inclusion hLA ϖL_m = 0 ∨
          (p : ℤ) * (m₀ : ℤ) ≤ valL F A (IntermediateField.inclusion hLA ϖL_m) := by
        right
        rw [hval_alg ϖL_m, hϖ_L_pow_val m₀]
      have hϖL_m_inv_val : IntermediateField.inclusion hLA ϖL_m_inv = 0 ∨
          -((p : ℤ) * (m₀ : ℤ)) ≤ valL F A (IntermediateField.inclusion hLA ϖL_m_inv) := by
        right
        rw [hval_alg ϖL_m_inv, hϖ_L_pow_inv_val m₀]
        linarith
      let z₀ : A := z * ((u_δ⁻¹ : Aˣ) : A) * IntermediateField.inclusion hLA ϖL_m_inv
      have hz₀_val : z₀ = 0 ∨ 0 ≤ valL F A z₀ := by
        have h1 := hval_mul_ge_A (k : ℤ) (-((i₀ : ℤ) + (t : ℤ))) z ((u_δ⁻¹ : Aˣ) : A)
          hz_val huδ_inv_val
        have h2 := hval_mul_ge_A ((k : ℤ) + (-((i₀ : ℤ) + (t : ℤ)))) (-((p : ℤ) * (m₀ : ℤ)))
          (z * ((u_δ⁻¹ : Aˣ) : A)) (IntermediateField.inclusion hLA ϖL_m_inv) h1 hϖL_m_inv_val
        have hsum0 : (k : ℤ) + (-((i₀ : ℤ) + (t : ℤ))) + (-((p : ℤ) * (m₀ : ℤ))) = 0 := by
          have hk_int : (p : ℤ) * (m₀ : ℤ) + (i₀ : ℤ) + (t : ℤ) = (k : ℤ) := by
            exact_mod_cast hk_eq
          linarith
        rwa [hsum0] at h2
      obtain ⟨x₀, hx₀_val, hdiff_z₀⟩ := hResSurj z₀ hz₀_val
      let y : A := IntermediateField.inclusion hLA (x₀ * ϖL_m) * (π ^ i₀)
      have hx₀_ϖ_val : x₀ * ϖL_m = 0 ∨ (m₀ : ℤ) ≤ valL F L (x₀ * ϖL_m) := by
        have h := hval_mul_ge_L 0 (m₀ : ℤ) x₀ ϖL_m hx₀_val
          (Or.inr (by rw [hϖ_L_pow_val m₀]))
        rwa [zero_add] at h
      have hinc_x₀_ϖ : IntermediateField.inclusion hLA (x₀ * ϖL_m) = 0 ∨
          (p : ℤ) * (m₀ : ℤ) ≤ valL F A (IntermediateField.inclusion hLA (x₀ * ϖL_m)) :=
        hval_inc_ge (m₀ : ℤ) (x₀ * ϖL_m) hx₀_ϖ_val
      have hπ_i₀_val : π ^ i₀ = 0 ∨ (i₀ : ℤ) ≤ valL F A (π ^ i₀) := by
        right
        rw [hval_pow_A π i₀ hπ_ne0, hϖ_A, mul_one]
      have hy_val : y = 0 ∨ (q : ℤ) ≤ valL F A y := by
        have h := hval_mul_ge_A ((p : ℤ) * (m₀ : ℤ)) (i₀ : ℤ)
          (IntermediateField.inclusion hLA (x₀ * ϖL_m)) (π ^ i₀) hinc_x₀_ϖ hπ_i₀_val
        have hq_int : (p : ℤ) * (m₀ : ℤ) + (i₀ : ℤ) = (q : ℤ) := by exact_mod_cast hq_div
        rwa [hq_int] at h
      have h1y_ne0 : 1 + y ≠ 0 := h1_add_ne_zero_A (hval_le_A (by omega) hy_val)
      let u : Aˣ := Units.mk0 (1 + y) h1y_ne0
      have hu_coe : (u : A) = 1 + y := Units.val_mk0 h1y_ne0
      have hu_q : u ∈ unitGroup F A q := by
        rw [hunit_ge1_A q (by omega) u]
        have hsub : (u : A) - 1 = y := by rw [hu_coe]; ring
        rw [hsub]
        rcases hy_val with h0 | hge
        · exact Or.inl (sub_eq_zero.mp (hsub.trans h0))
        · exact Or.inr hge
      have hξA_u : ξA u = 1 := hξA_cond u (hunit_anti_A hq_ge hu_q)
      have hσy_sub : σ y - y = IntermediateField.inclusion hLA (x₀ * ϖL_m) * δ_i := by
        rw [hσ_act y]
        change φ_act τ (IntermediateField.inclusion hLA (x₀ * ϖL_m) * (π ^ i₀)) -
          IntermediateField.inclusion hLA (x₀ * ϖL_m) * (π ^ i₀) = _
        rw [map_mul (φ_act τ), hφ_act_apply, hact_incl τ (x₀ * ϖL_m), hφ_act_apply, ← mul_sub]
      have hδi_val_ge : δ_i = 0 ∨ (i₀ : ℤ) + (t : ℤ) ≤ valL F A δ_i :=
        Or.inr (by rw [show valL F A δ_i = (i₀ : ℤ) + (t : ℤ) from hδi_val])
      have hσy_sub_val : σ y - y = 0 ∨ (k : ℤ) ≤ valL F A (σ y - y) := by
        rw [hσy_sub]
        have h := hval_mul_ge_A ((p : ℤ) * (m₀ : ℤ)) ((i₀ : ℤ) + (t : ℤ))
          (IntermediateField.inclusion hLA (x₀ * ϖL_m)) δ_i hinc_x₀_ϖ hδi_val_ge
        have hk_int : (p : ℤ) * (m₀ : ℤ) + ((i₀ : ℤ) + (t : ℤ)) = (k : ℤ) := by
          have h1 : (p : ℤ) * (m₀ : ℤ) + (i₀ : ℤ) + (t : ℤ) = (k : ℤ) := by
            exact_mod_cast hk_eq
          linarith
        rwa [hk_int] at h
      have hz_sub_σy : z - (σ y - y) =
          (z₀ - IntermediateField.inclusion hLA x₀) *
            IntermediateField.inclusion hLA ϖL_m * δ_i := by
        have hϖ_inv_mul : IntermediateField.inclusion hLA ϖL_m_inv *
            IntermediateField.inclusion hLA ϖL_m = 1 := by
          rw [← map_mul (IntermediateField.inclusion hLA)]
          change IntermediateField.inclusion hLA
            ((((ϖ_L ^ m₀ : Lˣ)⁻¹ * (ϖ_L ^ m₀ : Lˣ) : Lˣ) : L)) = 1
          rw [inv_mul_cancel, Units.val_one, map_one]
        have huδ_inv_mul : ((u_δ⁻¹ : Aˣ) : A) * δ_i = 1 := by
          rw [← huδ_coe]
          exact Units.inv_mul u_δ
        have hz_recover : z₀ * IntermediateField.inclusion hLA ϖL_m * δ_i = z := by
          calc z₀ * IntermediateField.inclusion hLA ϖL_m * δ_i
            _ = z * ((u_δ⁻¹ : Aˣ) : A) *
                (IntermediateField.inclusion hLA ϖL_m_inv *
                  IntermediateField.inclusion hLA ϖL_m) * δ_i := by
                dsimp [z₀]; ring
            _ = z * (((u_δ⁻¹ : Aˣ) : A) * δ_i) := by rw [hϖ_inv_mul]; ring
            _ = z := by rw [huδ_inv_mul, mul_one]
        have hσy_recover : IntermediateField.inclusion hLA x₀ *
            IntermediateField.inclusion hLA ϖL_m * δ_i = σ y - y := by
          rw [hσy_sub, map_mul (IntermediateField.inclusion hLA)]
        calc z - (σ y - y)
          _ = z₀ * IntermediateField.inclusion hLA ϖL_m * δ_i -
              IntermediateField.inclusion hLA x₀ *
                IntermediateField.inclusion hLA ϖL_m * δ_i := by
              rw [hz_recover, hσy_recover]
          _ = (z₀ - IntermediateField.inclusion hLA x₀) *
              IntermediateField.inclusion hLA ϖL_m * δ_i := by ring
      have hz_sub_σy_val : z - (σ y - y) = 0 ∨
          ((k + 1 : ℕ) : ℤ) ≤ valL F A (z - (σ y - y)) := by
        rw [hz_sub_σy]
        have h1 := hval_mul_ge_A 1 ((p : ℤ) * (m₀ : ℤ))
          (z₀ - IntermediateField.inclusion hLA x₀)
          (IntermediateField.inclusion hLA ϖL_m) hdiff_z₀ hϖL_m_val
        have h2 := hval_mul_ge_A (1 + (p : ℤ) * (m₀ : ℤ)) ((i₀ : ℤ) + (t : ℤ))
          ((z₀ - IntermediateField.inclusion hLA x₀) * IntermediateField.inclusion hLA ϖL_m)
          δ_i h1 hδi_val_ge
        have hkp1_int : 1 + (p : ℤ) * (m₀ : ℤ) + ((i₀ : ℤ) + (t : ℤ)) = ((k + 1 : ℕ) : ℤ) := by
          have hk_int : (p : ℤ) * (m₀ : ℤ) + (i₀ : ℤ) + (t : ℤ) = (k : ℤ) := by
            exact_mod_cast hk_eq
          push_cast
          linarith
        rwa [hkp1_int] at h2
      let v : Aˣ := (Units.map σ.toRingEquiv.toMonoidHom u) * u⁻¹
      let w' : Aˣ := w * v⁻¹
      have hu_inv_val0 : ((u⁻¹ : Aˣ) : A) = 0 ∨ 0 ≤ valL F A ((u⁻¹ : Aˣ) : A) := by
        right
        rw [hval_inv_A u, hunit_val0_A q u hu_q, neg_zero]
      have hquad_val : (σ y - y) * y * ((u⁻¹ : Aˣ) : A) = 0 ∨
          ((k + 1 : ℕ) : ℤ) ≤ valL F A ((σ y - y) * y * ((u⁻¹ : Aˣ) : A)) := by
        have h1 := hval_mul_ge_A (k : ℤ) (q : ℤ) (σ y - y) y hσy_sub_val hy_val
        have h2 := hval_mul_ge_A ((k : ℤ) + (q : ℤ)) 0 ((σ y - y) * y) ((u⁻¹ : Aˣ) : A)
          h1 hu_inv_val0
        exact hval_le_A (by push_cast; omega) h2
      have hw_sub_v : (w : A) - (v : A) =
          (z - (σ y - y)) + (σ y - y) * y * ((u⁻¹ : Aˣ) : A) := by
        have hw_eq : (w : A) = 1 + z := by dsimp [z]; ring
        have hv_eq : (v : A) = (1 + σ y) * ((u⁻¹ : Aˣ) : A) := by
          change σ (u : A) * ((u⁻¹ : Aˣ) : A) = _
          rw [hu_coe, map_add σ, map_one σ]
        have hu_inv_mul : (1 + y) * ((u⁻¹ : Aˣ) : A) = 1 := by
          rw [← hu_coe]
          exact Units.mul_inv u
        rw [hw_eq, hv_eq]
        linear_combination -(1 + (σ y - y)) * hu_inv_mul
      have hw_sub_v_val : (w : A) - (v : A) = 0 ∨
          ((k + 1 : ℕ) : ℤ) ≤ valL F A ((w : A) - (v : A)) := by
        rw [hw_sub_v]
        exact hval_add_A (((k + 1 : ℕ) : ℤ)) _ _ hz_sub_σy_val hquad_val
      have hv_inv_val0 : ((v⁻¹ : Aˣ) : A) = 0 ∨ 0 ≤ valL F A ((v⁻¹ : Aˣ) : A) := by
        right
        rw [hval_inv_A v]
        have hσu_ne0 : σ (u : A) ≠ 0 :=
          Units.ne_zero (Units.map σ.toRingEquiv.toMonoidHom u)
        have hu_val0 : valL F A (u : A) = 0 := hunit_val0_A q u hu_q
        have hσu_val0 : valL F A (σ (u : A)) = 0 := by
          rw [hσ_act (u : A), hact_val τ (u : A), hu_val0]
        change 0 ≤ - valL F A (σ (u : A) * ((u⁻¹ : Aˣ) : A))
        rw [hval_mul_A (σ (u : A)) ((u⁻¹ : Aˣ) : A) hσu_ne0 (Units.ne_zero u⁻¹),
          hσu_val0, hval_inv_A u, hu_val0]
        omega
      have hw'_sub : (w' : A) - 1 = ((w : A) - (v : A)) * ((v⁻¹ : Aˣ) : A) := by
        change (w : A) * ((v⁻¹ : Aˣ) : A) - 1 = _
        rw [sub_mul, Units.mul_inv]
      have hw'_mem : w' ∈ unitGroup F A (k + 1) := by
        rw [hunit_ge1_A (k + 1) (by omega) w', hw'_sub]
        have hmul := hval_mul_ge_A (((k + 1 : ℕ) : ℤ)) 0
          ((w : A) - (v : A)) ((v⁻¹ : Aˣ) : A) hw_sub_v_val hv_inv_val0
        rw [add_zero] at hmul
        rcases hmul with h0 | hge
        · exact Or.inl (sub_eq_zero.mp (hw'_sub.trans h0))
        · exact Or.inr hge
      have hnw' : Units.map (normLM F hLA) w' = Units.map (normLM F hLA) w := by
        have hnv : Units.map (normLM F hLA) v = 1 := by
          change Units.map (normLM F hLA) ((Units.map σ.toRingEquiv.toMonoidHom u) * u⁻¹) = 1
          rw [map_mul, map_inv, hσ_norm u, mul_inv_cancel]
        change Units.map (normLM F hLA) (w * v⁻¹) = Units.map (normLM F hLA) w
        rw [map_mul, map_inv, hnv, inv_one, mul_one]
      have hθw' : θA w' = θA w := by
        have hθv : θA v = 1 := by
          change θA ((Units.map σ.toRingEquiv.toMonoidHom u) * u⁻¹) = 1
          rw [map_mul, map_inv, ← hσ_twist u, MonoidHom.mul_apply, hξA_u, one_mul, mul_inv_cancel]
        change θA (w * v⁻¹) = θA w
        rw [map_mul, map_inv, hθv, inv_one, mul_one]
      exact ⟨w', hw'_mem, hnw', hθw'⟩
    · 
      push_neg at hi₀_ne0
      have hq_pm₀ : p * m₀ = q := by omega
      have hm₀_ge1 : 1 ≤ m₀ := by
        by_contra hlt
        have hm0 : m₀ = 0 := Nat.eq_zero_of_not_pos hlt
        rw [hm0, mul_zero] at hq_pm₀
        omega
      let r : ℕ := t + m₀
      have hr_ge1 : 1 ≤ r + 1 := by omega
      have hdiv_eq : t + 1 + (k - t) / p = r + 1 := by
        change t + 1 + m₀ = t + m₀ + 1
        omega
      rw [hdiv_eq] at hnw
      have hk_pm₀ : k = t + p * m₀ := by omega
      have htr_thresh : (p : ℤ) * ((r + 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) =
          ((k + 1 : ℕ) : ℤ) := by
        rw [hp_sub1_int]
        have hr_int : ((r + 1 : ℕ) : ℤ) = (t : ℤ) + (m₀ : ℤ) + 1 := by dsimp [r]
        have hk_int : ((k + 1 : ℕ) : ℤ) = (t : ℤ) + (p : ℤ) * (m₀ : ℤ) + 1 := by
          rw [hk_pm₀]; push_cast; rfl
        rw [hr_int, hk_int]
        ring
      obtain ⟨z', hz'_val, hnorm_z⟩ := hnorm_exp k hk_ge1 z hz_val
      have hz'_tr_in : z' = 0 ∨
          (p : ℤ) * ((r + 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F A z' := by
        rw [htr_thresh]
        exact hval_le_A (by push_cast; omega) hz'_val
      have htr_z' : traceLM F hLA z' = 0 ∨
          ((r + 1 : ℕ) : ℤ) ≤ valL F L (traceLM F hLA z') :=
        htr_bound ((r + 1 : ℕ) : ℤ) z' hz'_tr_in
      have hnz_val : normLM F hLA z = 0 ∨
          ((r + 1 : ℕ) : ℤ) ≤ valL F L (normLM F hLA z) := by
        apply hval_le_L _ (hnorm_val_ge (k : ℤ) z hz_val)
        have hle_nat : r + 1 ≤ k := by
          have h2m₀ : 2 * m₀ ≤ p * m₀ := Nat.mul_le_mul_right m₀ hp_ge2
          omega
        exact_mod_cast hle_nat
      have hnw_sub_val : normLM F hLA (w : A) - 1 = 0 ∨
          ((r + 1 : ℕ) : ℤ) ≤ valL F L (normLM F hLA (w : A) - 1) := by
        rcases (hunit_ge1_L (r + 1) hr_ge1 (Units.map (normLM F hLA) w)).mp hnw with h1 | hge
        · exact Or.inl (sub_eq_zero.mpr h1)
        · exact Or.inr hge
      have htr_z_eq : traceLM F hLA z =
          (normLM F hLA (w : A) - 1) + (-(traceLM F hLA z')) + (-(normLM F hLA z)) := by
        have hw_1z : (w : A) = 1 + z := by dsimp [z]; ring
        rw [hw_1z, hnorm_z, map_add (traceLM F hLA) z z']
        ring
      have hneg_trz' : -(traceLM F hLA z') = 0 ∨
          ((r + 1 : ℕ) : ℤ) ≤ valL F L (-(traceLM F hLA z')) := by
        rcases htr_z' with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right; rw [hval_neg_L]; exact hge
      have hneg_nz : -(normLM F hLA z) = 0 ∨
          ((r + 1 : ℕ) : ℤ) ≤ valL F L (-(normLM F hLA z)) := by
        rcases hnz_val with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right; rw [hval_neg_L]; exact hge
      have htr_z : traceLM F hLA z = 0 ∨
          ((r + 1 : ℕ) : ℤ) ≤ valL F L (traceLM F hLA z) := by
        rw [htr_z_eq]
        exact hval_add_L (((r + 1 : ℕ) : ℤ)) _ _
          (hval_add_L (((r + 1 : ℕ) : ℤ)) _ _ hnw_sub_val hneg_trz') hneg_nz
      let ϖL_r : L := ((ϖ_L ^ r : Lˣ) : L)
      have hϖL_r_ne0 : ϖL_r ≠ 0 := Units.ne_zero (ϖ_L ^ r)
      obtain ⟨y_r, htr_yr, _, hyr_spec⟩ := htr_surj ϖL_r
      obtain ⟨hyr_ne0, hyr_val⟩ := hyr_spec hϖL_r_ne0
      have hyr_val_k : valL F A y_r = (k : ℤ) := by
        rw [hyr_val, hϖ_L_pow_val r, hp_sub1_int]
        have hr_int : (r : ℤ) = (t : ℤ) + (m₀ : ℤ) := by dsimp [r]
        have hk_int : (k : ℤ) = (t : ℤ) + (p : ℤ) * (m₀ : ℤ) := by
          rw [hk_pm₀]; push_cast; rfl
        rw [hr_int, hk_int]
        ring
      let u_yr : Aˣ := Units.mk0 y_r hyr_ne0
      have huyr_coe : (u_yr : A) = y_r := Units.val_mk0 hyr_ne0
      have huyr_inv_val : ((u_yr⁻¹ : Aˣ) : A) = 0 ∨
          -(k : ℤ) ≤ valL F A ((u_yr⁻¹ : Aˣ) : A) := by
        right
        rw [hval_inv_A u_yr, huyr_coe, hyr_val_k]
      have hz_uyr_val : z * ((u_yr⁻¹ : Aˣ) : A) = 0 ∨
          0 ≤ valL F A (z * ((u_yr⁻¹ : Aˣ) : A)) := by
        have h := hval_mul_ge_A (k : ℤ) (-(k : ℤ)) z ((u_yr⁻¹ : Aˣ) : A) hz_val huyr_inv_val
        rwa [add_neg_cancel] at h
      obtain ⟨c, _, hdiff_c⟩ := hResSurj (z * ((u_yr⁻¹ : Aˣ) : A)) hz_uyr_val
      let z₁ : A := z - IntermediateField.inclusion hLA c * y_r
      have hz₁_prod : z₁ =
          (z * ((u_yr⁻¹ : Aˣ) : A) - IntermediateField.inclusion hLA c) * y_r := by
        have huyr_inv_mul : ((u_yr⁻¹ : Aˣ) : A) * y_r = 1 := by
          rw [← huyr_coe]
          exact Units.inv_mul u_yr
        dsimp [z₁]
        linear_combination -z * huyr_inv_mul
      have hz₁_val : z₁ = 0 ∨ ((k + 1 : ℕ) : ℤ) ≤ valL F A z₁ := by
        rw [hz₁_prod]
        have hyr_val_ge : y_r = 0 ∨ (k : ℤ) ≤ valL F A y_r := Or.inr (by omega)
        have h := hval_mul_ge_A 1 (k : ℤ)
          (z * ((u_yr⁻¹ : Aˣ) : A) - IntermediateField.inclusion hLA c) y_r hdiff_c hyr_val_ge
        have h1k : (1 : ℤ) + (k : ℤ) = ((k + 1 : ℕ) : ℤ) := by push_cast; ring
        rwa [h1k] at h
      have hz₁_tr_in : z₁ = 0 ∨
          (p : ℤ) * ((r + 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F A z₁ := by
        rwa [htr_thresh]
      have htr_z₁ : traceLM F hLA z₁ = 0 ∨
          ((r + 1 : ℕ) : ℤ) ≤ valL F L (traceLM F hLA z₁) :=
        htr_bound ((r + 1 : ℕ) : ℤ) z₁ hz₁_tr_in
      have hc_ϖ_eq : c * ϖL_r = traceLM F hLA z + (-(traceLM F hLA z₁)) := by
        have hsub_eq : IntermediateField.inclusion hLA c * y_r = z - z₁ := by
          dsimp [z₁]; ring
        have htr_sub := congrArg (traceLM F hLA) hsub_eq
        rw [htr_smul c y_r, htr_yr, map_sub (traceLM F hLA), sub_eq_add_neg] at htr_sub
        exact htr_sub
      have hneg_trz₁ : -(traceLM F hLA z₁) = 0 ∨
          ((r + 1 : ℕ) : ℤ) ≤ valL F L (-(traceLM F hLA z₁)) := by
        rcases htr_z₁ with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right; rw [hval_neg_L]; exact hge
      have hc_ϖ_val : c * ϖL_r = 0 ∨ ((r + 1 : ℕ) : ℤ) ≤ valL F L (c * ϖL_r) := by
        rw [hc_ϖ_eq]
        exact hval_add_L (((r + 1 : ℕ) : ℤ)) _ _ htr_z hneg_trz₁
      have hc_val1 : c = 0 ∨ 1 ≤ valL F L c := by
        let ϖL_r_inv : L := (((ϖ_L ^ r : Lˣ)⁻¹ : Lˣ) : L)
        have hinv_val : ϖL_r_inv = 0 ∨ -(r : ℤ) ≤ valL F L ϖL_r_inv :=
          Or.inr (by rw [hϖ_L_pow_inv_val r])
        have hmul := hval_mul_ge_L (((r + 1 : ℕ) : ℤ)) (-(r : ℤ))
          (c * ϖL_r) ϖL_r_inv hc_ϖ_val hinv_val
        have hc_recover : (c * ϖL_r) * ϖL_r_inv = c := by
          rw [mul_assoc]
          have h1 : ϖL_r * ϖL_r_inv = 1 := Units.mul_inv (ϖ_L ^ r)
          rw [h1, mul_one]
        have hsum1 : ((r + 1 : ℕ) : ℤ) + -(r : ℤ) = 1 := by push_cast; ring
        rwa [hc_recover, hsum1] at hmul
      have hinc_c_yr : IntermediateField.inclusion hLA c * y_r = 0 ∨
          ((k + 1 : ℕ) : ℤ) ≤ valL F A (IntermediateField.inclusion hLA c * y_r) := by
        have hinc_c := hval_inc_ge 1 c hc_val1
        have hyr_val_ge : y_r = 0 ∨ (k : ℤ) ≤ valL F A y_r := Or.inr (by omega)
        have hmul := hval_mul_ge_A ((p : ℤ) * 1) (k : ℤ)
          (IntermediateField.inclusion hLA c) y_r hinc_c hyr_val_ge
        exact hval_le_A (by push_cast; omega) hmul
      have hz_kp1 : z = 0 ∨ ((k + 1 : ℕ) : ℤ) ≤ valL F A z := by
        have hz_sum : z = IntermediateField.inclusion hLA c * y_r + z₁ := by
          dsimp [z₁]; ring
        rw [hz_sum]
        exact hval_add_A (((k + 1 : ℕ) : ℤ)) _ _ hinc_c_yr hz₁_val
      have hw_kp1 : w ∈ unitGroup F A (k + 1) := by
        rw [hunit_ge1_A (k + 1) (by omega) w]
        rcases hz_kp1 with h0 | hge
        · exact Or.inl (sub_eq_zero.mp h0)
        · exact Or.inr hge
      exact ⟨w, hw_kp1, rfl, rfl⟩

  
  let M_θ : ℕ := condExp F A θA
  let A_L : ℕ := bA + M_θ
  have hInd : ∀ d : ℕ, ∀ k : ℕ, mA ≤ k → k + d = M_θ →
      ∀ w ∈ unitGroup F A k,
        Units.map (normLM F hLA) w ∈ unitGroup F L A_L → θA w = 1 := by
    intro d
    induction d with
    | zero =>
      intro k _ hkd w hw _
      have hk_eq : k = M_θ := by omega
      rw [hk_eq] at hw
      exact hθA_cond w hw
    | succ d ih =>
      intro k hk_ge hkd w hw hnw
      have hdiv_le : t + 1 + (k - t) / p ≤ A_L := by
        have hq_le : (k - t) / p ≤ k - t := Nat.div_le_self (k - t) p
        omega
      have hnw_sub : Units.map (normLM F hLA) w ∈ unitGroup F L (t + 1 + (k - t) / p) :=
        hunit_anti_L hdiv_le hnw
      obtain ⟨w', hw'_mem, hnw', hθw'⟩ := hStep k hk_ge w hw hnw_sub
      rw [← hθw']
      apply ih (k + 1) (by omega) (by omega) w' hw'_mem
      rw [hnw']
      exact hnw
  have hConj2 : ∀ w ∈ unitGroup F A mA,
      Units.map (normLM F hLA) w ∈ unitGroup F L (bA + condExp F A θA) →
      θA w = 1 := by
    intro w hw hnw
    exact hInd (M_θ - mA) mA le_rfl (by omega) w hw hnw

  exact ⟨hmA_le, hConj2, hConj3, hConj4⟩

theorem ld_ch12_wild_odd_tot_ram_higher_cond_char_descent (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hAbLE' : IsAbelianExt F hLE') (hAbLM₁' : IsAbelianExt F hLM₁')
    (hAbE'K₁ : IsAbelianExt F hE'K₁) (hAbM₁'K₁ : IsAbelianExt F hM₁'K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
    (θE' : E'ˣ →* (Ω F)ˣ) (θM₁' : M₁'ˣ →* (Ω F)ˣ) (θK₁ : K₁ˣ →* (Ω F)ˣ)
    (hχE'_comp : θE'.comp (Units.map (normLM F hE'K₁)) = θK₁)
    (hχM₁'_comp : θM₁'.comp (Units.map (normLM F hM₁'K₁)) = θK₁)
    (hχK₁_cond : ∀ u ∈ unitGroup F K₁ (condExp F K₁ θK₁), θK₁ u = 1)
    (hξE'_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
      (∀ y : E'ˣ, y ∈ Set.range (Units.map (normLM F hE'K₁)) ↔ ξE' y = 1) ∧
      (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j)), (ξE' ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j * θE')),
        (ξE' ^ j * θE') u = 1) ∧
      condExp F E' (ξE' ^ j * θE') = condExp F E' θE')
    (hξM₁'_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
      (∀ z : M₁'ˣ, z ∈ Set.range (Units.map (normLM F hM₁'K₁)) ↔ ξM₁' z = 1) ∧
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j)), (ξM₁' ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j * θM₁')),
        (ξM₁' ^ j * θM₁') u = 1) ∧
      condExp F M₁' (ξM₁' ^ j * θM₁') = condExp F M₁' θM₁')
    (hCommonRest : ∀ x : Lˣ,
      θE' (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) =
      θM₁' (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x))
    (hξE'_cond : condExp F E' (νM₁'.comp (Units.map (normLM F hLE'))) = condExp F L νM₁')
    (hξM₁'_cond : condExp F M₁' (νE'.comp (Units.map (normLM F hLM₁'))) =
      condExp F L νM₁' +
        Module.finrank L (IntermediateField.extendScalars hLE') *
          (condExp F L νE' - condExp F L νM₁'))
    (hCondRel : condExp F E' θE' +
      (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * condExp F L νE' =
      condExp F M₁' θM₁' +
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * condExp F L νM₁')
    (hTwistsE' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∃ σ : E' ≃ₐ[F] E',
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
        (∀ y : E'ˣ,
          Units.map (normLM F hLE') (Units.map σ.toRingEquiv.toMonoidHom y) =
            Units.map (normLM F hLE') y) ∧
        ∀ y : E'ˣ,
          ((νM₁'.comp (Units.map (normLM F hLE'))) ^ j * θE') y =
            θE' (Units.map σ.toRingEquiv.toMonoidHom y))
    (hTwistsM₁' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∃ τ : M₁' ≃ₐ[F] M₁',
        (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) ∧
        (∀ z : M₁'ˣ,
          Units.map (normLM F hLM₁') (Units.map τ.toRingEquiv.toMonoidHom z) =
            Units.map (normLM F hLM₁') z) ∧
        ∀ z : M₁'ˣ,
          ((νE'.comp (Units.map (normLM F hLM₁'))) ^ j * θM₁') z =
            θM₁' (Units.map τ.toRingEquiv.toMonoidHom z))
    (hNormTrans : ∀ w : K₁ˣ,
      Units.map (normLM F hLE') (Units.map (normLM F hE'K₁) w) =
        Units.map (normLM F hLM₁') (Units.map (normLM F hM₁'K₁) w))
    (hNormInc : ∀ x : Lˣ,
      Units.map (normLM F hLE') (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) =
        x ^ (Module.finrank L (IntermediateField.extendScalars hLE')) ∧
      Units.map (normLM F hLM₁') (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x) =
        x ^ (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hm₂_lt : condExp F L νE' + condExp F L νM₁' - 1 < condExp F E' θE')
    (hDeepTriv_M₁' : ∀ w ∈ unitGroup F M₁'
        (2 * condExp F L νM₁' - 1 +
          Module.finrank L (IntermediateField.extendScalars hLE') *
            (condExp F L νE' - condExp F L νM₁')),
      Units.map (normLM F hLM₁') w ∈
        unitGroup F L (condExp F L νM₁' + condExp F M₁' θM₁') →
      θM₁' w = 1)
    (hNormLe_E' : ∀ w ∈ unitGroup F E' (condExp F L νE'),
      Units.map (normLM F hLE') w ∈ unitGroup F L (condExp F L νE'))
    (hNormGt_E' : ∀ r ≥ condExp F L νE',
      ∀ w ∈ unitGroup F E'
        (condExp F L νE' +
          Module.finrank L (IntermediateField.extendScalars hLE') *
            (r - (condExp F L νE' - 1))),
      Units.map (normLM F hLE') w ∈ unitGroup F L (r + 1))
    (hNormGt_M₁' : ∀ r ≥ condExp F L νM₁',
      ∀ w ∈ unitGroup F M₁'
        (condExp F L νM₁' +
          Module.finrank L (IntermediateField.extendScalars hLE') *
            (r - (condExp F L νM₁' - 1))),
      Units.map (normLM F hLM₁') w ∈ unitGroup F L (r + 1))
    (hMinBound_E' : ∀ χ₂ : E'ˣ →* (Ω F)ˣ,
      (∀ u ∈ unitGroup F E' (condExp F E' χ₂), χ₂ u = 1) →
      (∃ σ : E' ≃ₐ[F] E',
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
        ∀ y : E'ˣ,
          (νM₁'.comp (Units.map (normLM F hLE')) * χ₂) y =
            χ₂ (Units.map σ.toRingEquiv.toMonoidHom y)) →
      condExp F L νE' + condExp F L νM₁' - 1 ≤ condExp F E' χ₂)
    (hMinBound_M₁' : ∀ χ₁ : M₁'ˣ →* (Ω F)ˣ,
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' χ₁), χ₁ u = 1) →
      (∃ τ : M₁' ≃ₐ[F] M₁',
        (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) ∧
        ∀ z : M₁'ˣ,
          (νE'.comp (Units.map (normLM F hLM₁')) * χ₁) z =
            χ₁ (Units.map τ.toRingEquiv.toMonoidHom z)) →
      2 * condExp F L νM₁' - 1 +
        Module.finrank L (IntermediateField.extendScalars hLE') *
          (condExp F L νE' - condExp F L νM₁') ≤ condExp F M₁' χ₁) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLE')
    let bE' := condExp F L νE'
    let bM₁' := condExp F L νM₁'
    let m₁ := 2 * bM₁' - 1 + ℓ * (bE' - bM₁')
    let m₂ := bE' + bM₁' - 1
    let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
    let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
    ∃ (χ₁ : M₁'ˣ →* (Ω F)ˣ) (χ₂ : E'ˣ →* (Ω F)ˣ) (lam_L : Lˣ →* (Ω F)ˣ),
      θM₁' = χ₁ * lam_L.comp (Units.map (normLM F hLM₁')) ∧
      θE' = χ₂ * lam_L.comp (Units.map (normLM F hLE')) ∧
      χ₂.comp (Units.map (normLM F hE'K₁)) = χ₁.comp (Units.map (normLM F hM₁'K₁)) ∧
      (∀ x : Lˣ,
        χ₂ (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) =
          χ₁ (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x)) ∧
      condExp F M₁' χ₁ = m₁ ∧
      condExp F E' χ₂ = m₂ ∧
      (∀ u ∈ unitGroup F K₁ (condExp F K₁ (χ₂.comp (Units.map (normLM F hE'K₁)))),
        (χ₂.comp (Units.map (normLM F hE'K₁))) u = 1) ∧
      (∀ j < ℓ,
        condExp F E' (ξE' ^ j * χ₂) = m₂ ∧
        (∀ u ∈ unitGroup F E' m₂, (ξE' ^ j * χ₂) u = 1) ∧
        ∃ σ : E' ≃ₐ[F] E',
          (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
          ∀ y : E'ˣ, (ξE' ^ j * χ₂) y = χ₂ (Units.map σ.toRingEquiv.toMonoidHom y)) ∧
      (∀ j < ℓ,
        condExp F M₁' (ξM₁' ^ j * χ₁) = m₁ ∧
        (∀ u ∈ unitGroup F M₁' m₁, (ξM₁' ^ j * χ₁) u = 1) ∧
        ∃ τ : M₁' ≃ₐ[F] M₁',
          (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) ∧
          ∀ z : M₁'ˣ, (ξM₁' ^ j * χ₁) z = χ₁ (Units.map τ.toRingEquiv.toMonoidHom z)) ∧
      (lam_L = 1 ∨
        (bE' < condExp F L lam_L ∧
         bM₁' - 1 < ℓ * (condExp F L lam_L - bE') ∧
         (∀ j < ℓ,
           ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j * lam_L)), (νE' ^ j * lam_L) u = 1) ∧
         (∀ j < ℓ,
           ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * lam_L)), (νM₁' ^ j * lam_L) u = 1) ∧
         condExp F E' θE' = bE' + ℓ * (condExp F L lam_L - bE') ∧
         condExp F M₁' θM₁' = bM₁' + ℓ * (condExp F L lam_L - bM₁'))) :=
by
  
  intro ℓ bE' bM₁' m₁ m₂ ξE' ξM₁'
  have hℓ_pos : 0 < ℓ := hPrime.pos
  have hℓ_gt1 : 1 < ℓ := hPrime.one_lt
  set bξM₁' : ℕ := bM₁' + ℓ * (bE' - bM₁')
  set ψE' := traceChar F hLE' ψ
  set ψM₁' := traceChar F hLM₁' ψ
  have hbM₁'_lt_m₂ : bM₁' < m₂ := by
    clear *- hbE'_ge2 hbM₁'_ge2; dsimp [m₂]; omega
  have hbE'_lt_m₂ : bE' < m₂ := by
    clear *- hbE'_ge2 hbM₁'_ge2; dsimp [m₂]; omega
  have hbξM₁'_ge2 : 2 ≤ bξM₁' := by
    clear *- hbM₁'_ge2; dsimp [bξM₁']; omega
  have hbξM₁'_lt_m₁ : bξM₁' < m₁ := by
    clear *- hbM₁'_ge2; dsimp [bξM₁', m₁]; omega
  have hunit_anti : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      {a b : ℕ}, a ≤ b → ∀ u ∈ unitGroup F M b, u ∈ unitGroup F M a := by
    clear *-
    intro M _ a b hab u hu
    obtain ⟨_, _, _, _, _, _, _, _, hunit0_M, hunit_ge1_M, hunit_val0_M⟩ :=
      ld_valL_and_unitGroup_props F M
    rcases Nat.eq_zero_or_pos a with rfl | ha_pos
    · exact (hunit0_M u).mpr (hunit_val0_M b u hu)
    · have hb_ge1 : 1 ≤ b := le_trans ha_pos hab
      rw [hunit_ge1_M a ha_pos]
      rcases (hunit_ge1_M b hb_ge1 u).mp hu with h1 | hge
      · exact Or.inl h1
      · exact Or.inr (le_trans (by exact_mod_cast hab) hge)
  have hCondSpecFromBound : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (η : Mˣ →* (Ω F)ˣ) (B : ℕ),
      (∀ u ∈ unitGroup F M B, η u = 1) →
      condExp F M η ≤ B ∧ ∀ u ∈ unitGroup F M (condExp F M η), η u = 1 := by
    clear *-
    intro M _ η B hB
    let S : Set ℕ := {a : ℕ | ∀ u ∈ unitGroup F M a, η u = 1}
    have hBS : B ∈ S := hB
    have hne : S.Nonempty := ⟨B, hBS⟩
    exact ⟨Nat.sInf_le hBS, Nat.sInf_mem hne⟩
  have hCondOfTrivBelow : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (α β : Mˣ →* (Ω F)ˣ) (A : ℕ),
      (∀ u ∈ unitGroup F M A, α u = 1) →
      (∀ u ∈ unitGroup F M (condExp F M β), β u = 1) →
      A < condExp F M β →
      condExp F M (α * β) = condExp F M β ∧
      ∀ u ∈ unitGroup F M (condExp F M (α * β)), (α * β) u = 1 := by
    clear *- hunit_anti hCondSpecFromBound
    intro M _ α β A hα hβ hlt
    have htriv_β : ∀ u ∈ unitGroup F M (condExp F M β), (α * β) u = 1 := by
      intro u hu
      have huA : u ∈ unitGroup F M A := hunit_anti M (le_of_lt hlt) u hu
      change α u * β u = 1
      rw [hα u huA, hβ u hu, mul_one]
    obtain ⟨hle, hαβ_cond⟩ := hCondSpecFromBound M (α * β) (condExp F M β) htriv_β
    refine ⟨?_, hαβ_cond⟩
    by_contra hne
    have hlt_αβ : condExp F M (α * β) < condExp F M β := lt_of_le_of_ne hle hne
    set C : ℕ := max A (condExp F M (α * β))
    have hC_lt : C < condExp F M β := max_lt hlt hlt_αβ
    have hβ_C : ∀ u ∈ unitGroup F M C, β u = 1 := by
      intro u hu
      have huA : u ∈ unitGroup F M A := hunit_anti M (le_max_left _ _) u hu
      have huαβ : u ∈ unitGroup F M (condExp F M (α * β)) := hunit_anti M (le_max_right _ _) u hu
      have h1 : α u = 1 := hα u huA
      have h2 : α u * β u = 1 := hαβ_cond u huαβ
      rw [h1, one_mul] at h2
      exact h2
    have hβ_le_C : condExp F M β ≤ C :=
      Nat.sInf_le (show C ∈ {a : ℕ | ∀ u ∈ unitGroup F M a, β u = 1} from hβ_C)
    omega
  
  set A_L : ℕ := bM₁' + condExp F M₁' θM₁'
  have hex_lam : ∃ lam_L : Lˣ →* (Ω F)ˣ,
      (∀ u ∈ unitGroup F L A_L, lam_L u = 1) ∧
      (∀ w ∈ unitGroup F M₁' m₁, lam_L (Units.map (normLM F hLM₁') w) = θM₁' w) := by
    clear *- hDeepTriv_M₁'
    let U_AL : Subgroup Lˣ := unitGroup F L A_L
    let Q_L := Lˣ ⧸ U_AL
    let π_AL : Lˣ →* Q_L := QuotientGroup.mk' U_AL
    letI : CommGroup Q_L :=
      { (inferInstance : Group Q_L) with
        mul_comm := fun x y =>
          QuotientGroup.induction_on x fun a =>
            QuotientGroup.induction_on y fun b => by
              change π_AL a * π_AL b = π_AL b * π_AL a
              rw [← map_mul, ← map_mul, mul_comm] }
    let H_m₁ : Subgroup M₁'ˣ := unitGroup F M₁' m₁
    let Φ : H_m₁ →* Q_L := π_AL.comp ((Units.map (normLM F hLM₁')).comp H_m₁.subtype)
    let θ_H : H_m₁ →* (Ω F)ˣ := θM₁'.comp H_m₁.subtype
    have h_ker_Φ : Φ.ker ≤ θ_H.ker := by
      intro w hw
      rw [MonoidHom.mem_ker] at hw ⊢
      have hw_norm : Units.map (normLM F hLM₁') w.1 ∈ U_AL :=
        (QuotientGroup.eq_one_iff (Units.map (normLM F hLM₁') w.1)).mp hw
      exact hDeepTriv_M₁' w.1 w.2 hw_norm
    let M_Q : Subgroup Q_L := Φ.range
    let bar_lam₀ : M_Q →* (Ω F)ˣ :=
      (QuotientGroup.lift Φ.ker θ_H h_ker_Φ).comp
        (QuotientGroup.quotientKerEquivRange Φ).symm.toMonoidHom
    have h_bar_lam₀ : ∀ w : H_m₁, bar_lam₀ (Φ.rangeRestrict w) = θ_H w := by
      intro w
      have h1 : (QuotientGroup.quotientKerEquivRange Φ).symm (Φ.rangeRestrict w) =
          (w : H_m₁ ⧸ Φ.ker) :=
        (QuotientGroup.quotientKerEquivRange Φ).symm_apply_apply (w : H_m₁ ⧸ Φ.ker)
      change (QuotientGroup.lift Φ.ker θ_H h_ker_Φ)
        ((QuotientGroup.quotientKerEquivRange Φ).symm (Φ.rangeRestrict w)) = θ_H w
      rw [h1]
      rfl
    letI : DivisibleBy (Additive (Ω F)ˣ) ℕ :=
      { div := fun x n =>
          if hn : n = 0 then 0
          else
            let hpos : 0 < n := Nat.pos_of_ne_zero hn
            let z := (IsAlgClosed.exists_pow_nat_eq (Additive.toMul x).val hpos).choose
            have hz_pow : z ^ n = (Additive.toMul x).val :=
              (IsAlgClosed.exists_pow_nat_eq (Additive.toMul x).val hpos).choose_spec
            have hz_ne : z ≠ 0 := by
              intro h0
              have h1 : z ^ n = 0 := h0.symm ▸ zero_pow hn
              rw [hz_pow] at h1
              exact (Units.ne_zero (Additive.toMul x)) h1
            Additive.ofMul (Units.mk0 z hz_ne)
        div_zero := fun x => dif_pos rfl
        div_cancel := fun {n} x hn => by
          dsimp only
          rw [dif_neg hn]
          apply Additive.toMul.injective
          rw [toMul_nsmul, toMul_ofMul]
          ext
          rw [Units.val_pow_eq_pow_val, Units.val_mk0]
          exact (IsAlgClosed.exists_pow_nat_eq (Additive.toMul x).val
            (Nat.pos_of_ne_zero hn)).choose_spec }
    letI : DivisibleBy (Additive (Ω F)ˣ) ℤ :=
      AddGroup.divisibleByIntOfDivisibleByNat (Additive (Ω F)ˣ)
    have hBaer : Module.Baer ℤ (Additive (Ω F)ˣ) := Module.Baer.of_divisible (Additive (Ω F)ˣ)
    let f_add : Additive M_Q →+ Additive Q_L := MonoidHom.toAdditive M_Q.subtype
    let g_add : Additive M_Q →+ Additive (Ω F)ˣ := MonoidHom.toAdditive bar_lam₀
    have hf_inj : Function.Injective f_add := M_Q.subtype_injective
    obtain ⟨h_add, hh_add⟩ := hBaer.extension_property_addMonoidHom f_add hf_inj g_add
    let bar_lam : Q_L →* (Ω F)ˣ := MonoidHom.toAdditive.symm h_add
    let lam_L : Lˣ →* (Ω F)ˣ := bar_lam.comp π_AL
    refine ⟨lam_L, ?_, ?_⟩
    · intro u hu
      change bar_lam (π_AL u) = 1
      have h1 : π_AL u = 1 := (QuotientGroup.eq_one_iff u).mpr hu
      rw [h1, map_one]
    · intro w hw
      let w' : H_m₁ := ⟨w, hw⟩
      change bar_lam (Φ w') = θ_H w'
      have h1 : Φ w' = M_Q.subtype (Φ.rangeRestrict w') := rfl
      rw [h1]
      have h2 : bar_lam (M_Q.subtype (Φ.rangeRestrict w')) = bar_lam₀ (Φ.rangeRestrict w') :=
        DFunLike.congr_fun hh_add (Additive.ofMul (Φ.rangeRestrict w'))
      rw [h2, h_bar_lam₀ w']
  obtain ⟨lam_L, hlam_triv_AL, hlam_on_Hm₁⟩ := hex_lam
  let χ₁ : M₁'ˣ →* (Ω F)ˣ := θM₁' * (lam_L.comp (Units.map (normLM F hLM₁')))⁻¹
  let χ₂ : E'ˣ →* (Ω F)ˣ := θE' * (lam_L.comp (Units.map (normLM F hLE')))⁻¹
  have hθM₁'_eq : θM₁' = χ₁ * lam_L.comp (Units.map (normLM F hLM₁')) :=
    (inv_mul_cancel_right θM₁' (lam_L.comp (Units.map (normLM F hLM₁')))).symm
  have hθE'_eq : θE' = χ₂ * lam_L.comp (Units.map (normLM F hLE')) :=
    (inv_mul_cancel_right θE' (lam_L.comp (Units.map (normLM F hLE')))).symm
  have hχ_comp : χ₂.comp (Units.map (normLM F hE'K₁)) = χ₁.comp (Units.map (normLM F hM₁'K₁)) := by
    clear *- hχE'_comp hχM₁'_comp hNormTrans
    ext w
    have hE' : θE' (Units.map (normLM F hE'K₁) w) = θK₁ w := DFunLike.congr_fun hχE'_comp w
    have hM₁' : θM₁' (Units.map (normLM F hM₁'K₁) w) = θK₁ w := DFunLike.congr_fun hχM₁'_comp w
    have hN : Units.map (normLM F hLE') (Units.map (normLM F hE'K₁) w) =
        Units.map (normLM F hLM₁') (Units.map (normLM F hM₁'K₁) w) := hNormTrans w
