  set bM₁' := condExp F L νM₁'
  set t₁ := bM₁' - 1
  set t₂ := bE' - 1
  set h₀ := t₁ / p
  set m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
  set m₂ := bE' + bM₁' - 1
  set d₂ := m₂ / 2
  set α₀ := ((c_νE'⁻¹ : Lˣ) : L)
  set ψE' := traceChar F hLE' ψ
