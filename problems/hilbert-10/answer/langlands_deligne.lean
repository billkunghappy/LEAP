      have h6 := hneg_K₁ _ _ h5
      rcases h6 with h0 | hle
      · exact Or.inl h0
      · right
        apply le_trans _ hle
        rw [← sub_nonneg]
        have hid :
            v_wt + (p : ℤ) * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) + 0 +
                - 3 * (p : ℤ) * (p : ℤ) * (m : ℤ) +
                - ((p - 2 : ℕ) : ℤ) * (p : ℤ) * (p : ℤ) * (m : ℤ) +
                (p : ℤ) * (p : ℤ) * (p : ℤ) * (m : ℤ) - K =
              (a_p + 1) * a_pm + a_p + ((a_p + 1) * (p : ℤ) + a_p + 1) * (t₁ : ℤ) +
                (2 * a_p + 3) * (p : ℤ) * a_d := by
