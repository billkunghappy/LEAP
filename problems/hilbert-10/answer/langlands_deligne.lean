        have hnot1 : ¬ (1 ≤ valL F M s) := fun h1 => hs_not_ge1 (Or.inr h1)
        omega
      let u_s : Mˣ := Units.mk0 s hs_ne0
      let w : Kˣ := Units.map (IntermediateField.inclusion hMK).toMonoidHom u_s
      have hw_mem0 : w ∈ unitGroup F K 0 := by
        rw [hunit0_K]
        change valL F K (IntermediateField.inclusion hMK s) = 0
        rw [hval_alg s, hs_val0, mul_zero]
      have hnw_val : ((Units.map (normLM F hMK) w : Mˣ) : M) = s ^ p :=
        hnorm_inc s
      have hsub_eq : ((((Units.map (normLM F hMK) w) * u⁻¹ : Mˣ) : M)) - 1 =
          -(((u : M) - s ^ p) * (((u⁻¹ : Mˣ) : M))) := by
        change ((Units.map (normLM F hMK) w : Mˣ) : M) * (((u⁻¹ : Mˣ) : M)) - 1 = _
        rw [hnw_val, sub_mul, Units.mul_inv]
        ring
      refine ⟨w, hw_mem0, ?_⟩
      rw [hunit_ge1_M 1 le_rfl]
      have hmul := hval_mul_ge_M 1 0 ((u : M) - s ^ p) (((u⁻¹ : Mˣ) : M))
        hdiff (Or.inr (by omega))
      rw [add_zero] at hmul
      have hneg_mul : -(((u : M) - s ^ p) * (((u⁻¹ : Mˣ) : M))) = 0 ∨
          1 ≤ valL F M (-(((u : M) - s ^ p) * (((u⁻¹ : Mˣ) : M)))) := by
        rcases hmul with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right
          rw [hval_neg_M]
          exact hge
      rw [← hsub_eq] at hneg_mul
      rcases hneg_mul with h0 | hge
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr hge
    · have hm_ge1 : 1 ≤ m := Nat.one_le_iff_ne_zero.mpr hm0
      have hu_sub : (u : M) - 1 = 0 ∨ (m : ℤ) ≤ valL F M ((u : M) - 1) := by
        rcases (hunit_ge1_M m hm_ge1 u).mp hu with h1 | hge
        · exact Or.inl (sub_eq_zero.mpr h1)
        · exact Or.inr hge
      let x₀ : M := ((u : M) - 1) * ((((ϖ_M ^ m : Mˣ)⁻¹ : Mˣ) : M))
      have hx₀_val : x₀ = 0 ∨ 0 ≤ valL F M x₀ := by
        have hmul := hval_mul_ge_M (m : ℤ) (-(m : ℤ))
          ((u : M) - 1) ((((ϖ_M ^ m : Mˣ)⁻¹ : Mˣ) : M))
          hu_sub (Or.inr (by rw [hϖ_M_pow_inv_val m]))
        rwa [add_neg_cancel] at hmul
      have hu_x₀ : (u : M) - 1 = x₀ * (((ϖ_M ^ m : Mˣ) : M)) := by
        change (u : M) - 1 = ((u : M) - 1) * ((((ϖ_M ^ m : Mˣ)⁻¹ : Mˣ) : M)) * (((ϖ_M ^ m : Mˣ) : M))
        rw [mul_assoc, Units.inv_mul, mul_one]
      obtain ⟨s, hs_val, hdiff⟩ := hFrobSurjM x₀ hx₀_val
      let y : K := IntermediateField.inclusion hMK s * (((ϖ_K ^ m : Kˣ) : K))
      have hy_val : y = 0 ∨ (m : ℤ) ≤ valL F K y := by
        have hinc_s := hval_inc_ge 0 s hs_val
        rw [mul_zero] at hinc_s
        have hmul := hval_mul_ge_K 0 (m : ℤ)
          (IntermediateField.inclusion hMK s) (((ϖ_K ^ m : Kˣ) : K))
          hinc_s (Or.inr (by rw [hϖ_K_pow_val m]))
        rwa [zero_add] at hmul
      have h1y_ne : 1 + y ≠ 0 := h1_add_ne_zero_K (hval_le_K (by omega) hy_val)
      let w : Kˣ := Units.mk0 (1 + y) h1y_ne
      have hw_mem : w ∈ unitGroup F K m := by
        rw [hunit_ge1_K m hm_ge1 w]
        have hsub : (w : K) - 1 = y := by change (1 + y) - 1 = y; ring
        rw [hsub]
        rcases hy_val with h0 | hge
        · exact Or.inl (sub_eq_zero.mp (hsub.trans h0))
        · exact Or.inr hge
      have hny_eq : normLM F hMK y = s ^ p * (((ϖ_M ^ m : Mˣ) : M)) := by
        dsimp [y]
        rw [map_mul, hnorm_inc s]
        congr 1
        have hmap_pow : Units.map (normLM F hMK) (ϖ_K ^ m) = ϖ_M ^ m := by
          rw [map_pow, hϖ_norm]
        exact congrArg Units.val hmap_pow
      have hcong := hnorm_cong_lt m hm_ge1 hm_lt y hy_val
      have hrem_x₀ : (x₀ - s ^ p) * (((ϖ_M ^ m : Mˣ) : M)) = 0 ∨
          ((m + 1 : ℕ) : ℤ) ≤ valL F M ((x₀ - s ^ p) * (((ϖ_M ^ m : Mˣ) : M))) := by
        have hmul := hval_mul_ge_M 1 (m : ℤ) (x₀ - s ^ p) (((ϖ_M ^ m : Mˣ) : M))
          hdiff (Or.inr (by rw [hϖ_M_pow_val m]))
        have heq : (1 : ℤ) + (m : ℤ) = ((m + 1 : ℕ) : ℤ) := by push_cast; ring
        rwa [heq] at hmul
      have hnw_sub_u_eq : ((Units.map (normLM F hMK) w : Mˣ) : M) - (u : M) =
          (normLM F hMK (1 + y) - 1 - normLM F hMK y) -
            (x₀ - s ^ p) * (((ϖ_M ^ m : Mˣ) : M)) := by
        change normLM F hMK (1 + y) - (u : M) = _
        have hu_eq' : (u : M) = 1 + ((u : M) - 1) := by ring
        rw [hu_eq', hu_x₀, hny_eq]
        ring
      have hnw_sub_u := hval_sub_ge_M ((m + 1 : ℕ) : ℤ)
        (normLM F hMK (1 + y) - 1 - normLM F hMK y)
        ((x₀ - s ^ p) * (((ϖ_M ^ m : Mˣ) : M))) hcong hrem_x₀
      rw [← hnw_sub_u_eq] at hnw_sub_u
      have hprod_sub_eq : ((((Units.map (normLM F hMK) w) * u⁻¹ : Mˣ) : M)) - 1 =
          (((Units.map (normLM F hMK) w : Mˣ) : M) - (u : M)) * (((u⁻¹ : Mˣ) : M)) := by
        change ((Units.map (normLM F hMK) w : Mˣ) : M) * (((u⁻¹ : Mˣ) : M)) - 1 = _
        rw [sub_mul, Units.mul_inv]
      refine ⟨w, hw_mem, ?_⟩
      rw [hunit_ge1_M (m + 1) (by omega)]
      have hmul := hval_mul_ge_M ((m + 1 : ℕ) : ℤ) 0
        (((Units.map (normLM F hMK) w : Mˣ) : M) - (u : M)) (((u⁻¹ : Mˣ) : M))
        hnw_sub_u (Or.inr (by omega))
      rw [add_zero, ← hprod_sub_eq] at hmul
      rcases hmul with h0 | hge
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr hge
  have hnorm_gt_le : ∀ r ≥ t + 1, ∀ w ∈ unitGroup F K (t + 1 + p * (r - t)),
      Units.map (normLM F hMK) w ∈ unitGroup F M (r + 1) := by
    intro r hr_ge w hw
    set M_idx : ℕ := t + 1 + p * (r - t)
    have hM_ge1 : 1 ≤ M_idx := by omega
    have hr1_ge1 : 1 ≤ r + 1 := by omega
    have hM_int : (M_idx : ℤ) = (p : ℤ) * ((r + 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) := by
      dsimp [M_idx]
      have hrt : (r - t : ℕ) = (r : ℤ) - (t : ℤ) := by omega
      rw [hp_sub1_int]
      push_cast
      rw [hrt]
      ring
    have hr1_le_M : ((r + 1 : ℕ) : ℤ) ≤ (M_idx : ℤ) := by
      dsimp [M_idx]
      have hrt_ge1 : (1 : ℤ) ≤ ((r - t : ℕ) : ℤ) := by omega
      have hrt_eq : ((r - t : ℕ) : ℤ) = (r : ℤ) - (t : ℤ) := by omega
      push_cast
      nlinarith
    let y : K := (w : K) - 1
    have hy : y = 0 ∨ (M_idx : ℤ) ≤ valL F K y := by
      rcases (hunit_ge1_K M_idx hM_ge1 w).mp hw with h1 | hge
      · exact Or.inl (sub_eq_zero.mpr h1)
      · exact Or.inr hge
    have hw_eq : (w : K) = 1 + y := by dsimp [y]; ring
    obtain ⟨z, hz, hnorm_eq⟩ := hnorm_exp M_idx hM_ge1 y hy
    have hz_M : z = 0 ∨ (M_idx : ℤ) ≤ valL F K z := hval_le_K (by omega) hz
    have hyz_M : y + z = 0 ∨ (M_idx : ℤ) ≤ valL F K (y + z) := hval_add_K (M_idx : ℤ) y z hy hz_M
    have hyz_tr_in : y + z = 0 ∨
        (p : ℤ) * ((r + 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K (y + z) := by
      rwa [← hM_int]
    have htr_r1 := htr_bound_p ((r + 1 : ℕ) : ℤ) (y + z) hyz_tr_in
    have hny_r1 : normLM F hMK y = 0 ∨ ((r + 1 : ℕ) : ℤ) ≤ valL F M (normLM F hMK y) :=
      hnorm_val_ge ((r + 1 : ℕ) : ℤ) y (hval_le_K hr1_le_M hy)
    have hsum_r1 := hval_add_M ((r + 1 : ℕ) : ℤ)
      (traceLM F hMK (y + z)) (normLM F hMK y) htr_r1 hny_r1
    have hsub_eq : (((Units.map (normLM F hMK) w : Mˣ) : M)) - 1 =
        traceLM F hMK (y + z) + normLM F hMK y := by
      change normLM F hMK (w : K) - 1 = _
      rw [hw_eq, hnorm_eq]
      ring
    rw [hunit_ge1_M (r + 1) hr1_ge1, hsub_eq]
    rcases hsum_r1 with h0 | hge
    · left
      exact sub_eq_zero.mp (hsub_eq.trans h0)
    · exact Or.inr hge
  have hnorm_gt_surj : ∀ r ≥ t + 1, ∀ u ∈ unitGroup F M r,
      ∃ w ∈ unitGroup F K (t + p * (r - t)),
        (Units.map (normLM F hMK) w) * u⁻¹ ∈ unitGroup F M (r + 1) := by
    intro r hr_ge u hu
    set N : ℕ := t + p * (r - t)
    have hrt_ge1 : 1 ≤ r - t := by omega
    have hN_ge3 : 3 ≤ N := by
      dsimp [N]
      nlinarith
    have hN_ge1 : 1 ≤ N := by omega
    have hr_ge1 : 1 ≤ r := by omega
    by_cases hu1 : (u : M) = 1
    · have hu_eq1 : u = 1 := Units.ext hu1
      refine ⟨1, Subgroup.one_mem _, ?_⟩
      rw [hu_eq1, map_one, inv_one, mul_one]
      exact Subgroup.one_mem _
    · let x₀ : M := (u : M) - 1
      have hx₀_ne : x₀ ≠ 0 := sub_ne_zero.mpr hu1
      have hx₀_val : (r : ℤ) ≤ valL F M x₀ :=
        ((hunit_ge1_M r hr_ge1 u).mp hu).resolve_left hu1
      obtain ⟨y₀, hy₀_tr, _, hy₀_nz⟩ := htr_surj_p x₀
      obtain ⟨hy₀_ne, hy₀_val⟩ := hy₀_nz hx₀_ne
      have hN_int : (N : ℤ) =
          (p : ℤ) * (r : ℤ) + ((p - 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) := by
        dsimp [N]
        have hrt_eq : ((r - t : ℕ) : ℤ) = (r : ℤ) - (t : ℤ) := by omega
        rw [hp_sub1_int]
        push_cast
        rw [hrt_eq]
        ring
      have hy₀_geN : (N : ℤ) ≤ valL F K y₀ := by
        rw [hy₀_val, hN_int]
        nlinarith
      have h1y₀_ne : 1 + y₀ ≠ 0 :=
        h1_add_ne_zero_K (Or.inr (by omega))
      let w : Kˣ := Units.mk0 (1 + y₀) h1y₀_ne
      have hw_mem : w ∈ unitGroup F K N := by
        rw [hunit_ge1_K N hN_ge1 w]
        right
        have hsub : (w : K) - 1 = y₀ := by change (1 + y₀) - 1 = y₀; ring
        rw [hsub]
        exact hy₀_geN
      obtain ⟨z, hz, hnorm_eq⟩ := hnorm_exp N hN_ge1 y₀ (Or.inr hy₀_geN)
      have hz_tr_in : z = 0 ∨
          (p : ℤ) * ((r + 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K z := by
        apply hval_le_K _ hz
        have hM_eq : (p : ℤ) * ((r + 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) =
            (N : ℤ) + 1 := by
          rw [hN_int, hp_sub1_int]
          push_cast
          ring
        rw [hM_eq]
        omega
      have htr_z := htr_bound_p ((r + 1 : ℕ) : ℤ) z hz_tr_in
      have hr1_le_N : ((r + 1 : ℕ) : ℤ) ≤ (N : ℤ) := by
        dsimp [N]
        have hrt_eq : ((r - t : ℕ) : ℤ) = (r : ℤ) - (t : ℤ) := by omega
        have hrt_int : (1 : ℤ) ≤ ((r - t : ℕ) : ℤ) := by omega
        push_cast
        nlinarith
      have hny₀_r1 : normLM F hMK y₀ = 0 ∨
          ((r + 1 : ℕ) : ℤ) ≤ valL F M (normLM F hMK y₀) :=
        hnorm_val_ge ((r + 1 : ℕ) : ℤ) y₀ (Or.inr (le_trans hr1_le_N hy₀_geN))
      have hsum_r1 := hval_add_M ((r + 1 : ℕ) : ℤ)
        (traceLM F hMK z) (normLM F hMK y₀) htr_z hny₀_r1
      have hnw_sub_u : ((Units.map (normLM F hMK) w : Mˣ) : M) - (u : M) =
          traceLM F hMK z + normLM F hMK y₀ := by
        change normLM F hMK (1 + y₀) - (u : M) = _
        have hu_eq' : (u : M) = 1 + x₀ := by dsimp [x₀]; ring
        rw [hu_eq', hnorm_eq, map_add (traceLM F hMK) y₀ z, hy₀_tr]
        ring
      have hu_inv_val0 : valL F M (((u⁻¹ : Mˣ) : M)) = 0 := by
        rw [hval_inv_M u, hunit_val0_M r u hu, neg_zero]
      have hprod_sub : ((((Units.map (normLM F hMK) w) * u⁻¹ : Mˣ) : M)) - 1 =
          (((Units.map (normLM F hMK) w : Mˣ) : M) - (u : M)) * (((u⁻¹ : Mˣ) : M)) := by
        change ((Units.map (normLM F hMK) w : Mˣ) : M) * (((u⁻¹ : Mˣ) : M)) - 1 = _
        rw [sub_mul, Units.mul_inv]
      refine ⟨w, hw_mem, ?_⟩
      rw [hunit_ge1_M (r + 1) (by omega)]
      rw [← hnw_sub_u] at hsum_r1
      have hmul := hval_mul_ge_M ((r + 1 : ℕ) : ℤ) 0
        (((Units.map (normLM F hMK) w : Mˣ) : M) - (u : M)) (((u⁻¹ : Mˣ) : M))
        hsum_r1 (Or.inr (by omega))
      rw [add_zero, ← hprod_sub] at hmul
      rcases hmul with h0 | hge
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr hge
  have hP_poly : ∀ z : M, (z = 0 ∨ 0 ≤ valL F M z) →
      normLM F hMK (1 + IntermediateField.inclusion hMK z * ((ϖ_K ^ t : Kˣ) : K)) -
        (1 + (z ^ p + ((((ϖ_M ^ t)⁻¹ : Mˣ) : M) * traceLM F hMK ((ϖ_K ^ t : Kˣ) : K)) * z) *
          ((ϖ_M ^ t : Mˣ) : M)) = 0 ∨
        (t + 1 : ℤ) ≤ valL F M
          (normLM F hMK (1 + IntermediateField.inclusion hMK z * ((ϖ_K ^ t : Kˣ) : K)) -
            (1 + (z ^ p + ((((ϖ_M ^ t)⁻¹ : Mˣ) : M) * traceLM F hMK ((ϖ_K ^ t : Kˣ) : K)) * z) *
              ((ϖ_M ^ t : Mˣ) : M))) := by
    intro z hz
    let y : K := IntermediateField.inclusion hMK z * ((ϖ_K ^ t : Kˣ) : K)
    have hy : y = 0 ∨ (t : ℤ) ≤ valL F K y := by
      have hinc_z := hval_inc_ge 0 z hz
      rw [mul_zero] at hinc_z
      have hmul := hval_mul_ge_K 0 (t : ℤ)
        (IntermediateField.inclusion hMK z) (((ϖ_K ^ t : Kˣ) : K))
        hinc_z (Or.inr (by rw [hϖ_K_pow_val t]))
      rwa [zero_add] at hmul
    obtain ⟨z_rem, hz_rem, hnorm_eq⟩ := hnorm_exp t ht_ge1 y hy
    have htr_y : traceLM F hMK y = z * traceLM F hMK ((ϖ_K ^ t : Kˣ) : K) :=
      htr_smul z ((ϖ_K ^ t : Kˣ) : K)
    have hny : normLM F hMK y = z ^ p * ((ϖ_M ^ t : Mˣ) : M) := by
      dsimp [y]
      rw [map_mul, hnorm_inc z]
      congr 1
      have hmap_pow : Units.map (normLM F hMK) (ϖ_K ^ t) = ϖ_M ^ t := by
        rw [map_pow, hϖ_norm]
      exact congrArg Units.val hmap_pow
    have hϖ_M_inv_mul : ((((ϖ_M ^ t)⁻¹ : Mˣ) : M)) * ((ϖ_M ^ t : Mˣ) : M) = 1 :=
      Units.inv_mul (ϖ_M ^ t)
    have hdiff_eq :
        normLM F hMK (1 + y) -
          (1 + (z ^ p + ((((ϖ_M ^ t)⁻¹ : Mˣ) : M) * traceLM F hMK ((ϖ_K ^ t : Kˣ) : K)) * z) *
            ((ϖ_M ^ t : Mˣ) : M)) =
          traceLM F hMK z_rem := by
      rw [hnorm_eq, map_add (traceLM F hMK) y z_rem, htr_y, hny]
      linear_combination - (traceLM F hMK ((ϖ_K ^ t : Kˣ) : K) * z) * hϖ_M_inv_mul
    have hz_rem_tr_in : z_rem = 0 ∨
        (p : ℤ) * (t + 1 : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K z_rem := by
      apply hval_le_K _ hz_rem
      rw [hp_sub1_int]
      have ht_int : (1 : ℤ) ≤ (t : ℤ) := by omega
      nlinarith
    have htr_z_rem := htr_bound_p (t + 1 : ℤ) z_rem hz_rem_tr_in
    rwa [hdiff_eq]
  exact ⟨hnorm_le, hnorm_surj_lt, hnorm_gt_le, hnorm_gt_surj, hP_poly⟩

theorem ld_ch14_wild_elementary_abelian_subfield_step (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M_C K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hM_CK : M_C ≤ K)
    (hGalMCK : IsGaloisExt F M_C K) (hAbMCK : IsAbelianExt F hM_CK)
    (hp_prime : Nat.Prime (p F))
    (r : ℕ) (hr_pos : 1 ≤ r)
    (hq_eq : Module.finrank M_C (IntermediateField.extendScalars hM_CK) = (p F) ^ (r + 1))
    (hExpMCK : ∀ σ ∈ M_C.fixingSubgroup, σ ^ (p F) ∈ K.fixingSubgroup)
    (hValNormK : ∀ w : K, valL F M_C (normLM F hM_CK w) = valL F K w)
    (hValAlgK : ∀ z : M_C,
      valL F K (IntermediateField.inclusion hM_CK z) =
        (Module.finrank M_C (IntermediateField.extendScalars hM_CK) : ℤ) * valL F M_C z)
    (ϖ_K : Kˣ) (ϖ_MC : M_Cˣ)
    (hϖ_normK : Units.map (normLM F hM_CK) ϖ_K = ϖ_MC)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_MC : valL F M_C (ϖ_MC : M_C) = 1)
    (t : ℕ) (ht_ge1 : 1 ≤ t)
    (hJumpK : ∀ σ ∈ M_C.fixingSubgroup, σ ∉ K.fixingSubgroup →
      ∀ hσw : (σ : AbsGal F) (ϖ_K : AlgebraicClosure F) ∈ K,
        (ϖ_K : K) - (⟨(σ : AbsGal F) (ϖ_K : AlgebraicClosure F), hσw⟩ : K) ≠ 0 ∧
        valL F K ((ϖ_K : K) - (⟨(σ : AbsGal F) (ϖ_K : AlgebraicClosure F), hσw⟩ : K)) =
          (t + 1 : ℤ)) :
    ∃ (M_1 : IntermediateField F (AlgebraicClosure F)) (_ : FiniteDimensional F M_1)
      (hMC_M1 : M_C ≤ M_1) (hM1_K : M_1 ≤ K) (ϖ_M1 : M_1ˣ),
      IsGaloisExt F M_C M_1 ∧
      IsAbelianExt F hMC_M1 ∧
      IsGaloisExt F M_1 K ∧
      IsAbelianExt F hM1_K ∧
      Module.finrank M_1 (IntermediateField.extendScalars hM1_K) = p F ∧
      Module.finrank M_C (IntermediateField.extendScalars hMC_M1) = (p F) ^ r ∧
      (∀ σ ∈ M_C.fixingSubgroup, σ ^ (p F) ∈ M_1.fixingSubgroup) ∧
      Units.map (normLM F hM1_K) ϖ_K = ϖ_M1 ∧
      Units.map (normLM F hMC_M1) ϖ_M1 = ϖ_MC ∧
      valL F M_1 (ϖ_M1 : M_1) = 1 ∧
      (∀ w : K, valL F M_1 (normLM F hM1_K w) = valL F K w) ∧
      (∀ z : M_1,
        valL F K (IntermediateField.inclusion hM1_K z) = (p F : ℤ) * valL F M_1 z) ∧
      (∀ w : M_1, valL F M_C (normLM F hMC_M1 w) = valL F M_1 w) ∧
      (∀ z : M_C,
        valL F M_1 (IntermediateField.inclusion hMC_M1 z) =
          (((p F) ^ r : ℕ) : ℤ) * valL F M_C z) ∧
      (∀ w : M_1, (w = 0 ∨ 0 ≤ valL F M_1 w) →
        ∃ s : M_1, (s = 0 ∨ 0 ≤ valL F M_1 s) ∧
          (w - s ^ (p F) = 0 ∨ 1 ≤ valL F M_1 (w - s ^ (p F)))) ∧
      (∀ σ ∈ M_1.fixingSubgroup, σ ∉ K.fixingSubgroup →
        ∀ hσw : (σ : AbsGal F) (ϖ_K : AlgebraicClosure F) ∈ K,
