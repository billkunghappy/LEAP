theorem ld_ch12_tame_ff_addChar_shift_and_root_exhaustion (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M]
    (ℓ : ℕ) (hfinrank : Module.finrank k_L k_M = ℓ)
    (hQ : Fintype.card k_M = (Fintype.card k_L) ^ ℓ)
    (ψ_0L ψ_k : AddChar k_L (Ω F)) (hψ_0L : ψ_0L ≠ 1) (hψ_k : ψ_k ≠ 1)
    (χ_M : k_Mˣ →* (Ω F)ˣ) :
    let q := Fintype.card k_L
    let S := (q ^ ℓ - 1) / (q - 1)
    (∃ c : k_Lˣ,
      (∀ (α : k_Lˣ →* (Ω F)ˣ),
        (∑ x : k_Lˣ, (α x : Ω F) * ψ_k (x : k_L)) =
          ((α c)⁻¹ : Ω F) * (∑ x : k_Lˣ, (α x : Ω F) * ψ_0L (x : k_L))) ∧
      (∀ (j : ℕ), j ≤ ℓ → ∀ (α_M : k_Mˣ →* (Ω F)ˣ),
        (∀ y : k_Mˣ, χ_M y = (α_M (y ^ (q ^ j)))⁻¹) →
        (∑ y : k_Mˣ, (χ_M y : Ω F) * ψ_k (Algebra.trace k_L k_M (y : k_M))) =
          ((χ_M (Units.map (algebraMap k_L k_M).toMonoidHom c))⁻¹ : Ω F) *
            (∑ y : k_Mˣ, ((α_M y)⁻¹ : Ω F) * ψ_0L (Algebra.trace k_L k_M (y : k_M))))) ∧
    (∀ (n : ℕ), 0 < n → ∀ (ζ z : (Ω F)ˣ), orderOf ζ = n → z ^ n = 1 →
      ∃ m < n, ζ ^ m = z) ∧
    (∀ y : k_Mˣ,
      Units.map (algebraMap k_L k_M).toMonoidHom (Units.map (Algebra.norm k_L (S := k_M)) y) =
        y ^ S) :=
by
  dsimp only
  set q := Fintype.card k_L
  set S := (q ^ ℓ - 1) / (q - 1)
  refine ⟨?_, ?_, ?_⟩
  · have hPrim : ψ_0L.IsPrimitive := AddChar.IsPrimitive.of_ne_one hψ_0L
    have hex_c₀ : ∃ c₀ : k_L, ψ_k * ψ_0L.mulShift (-c₀) = 0 := by
      by_contra h_none
      push_neg at h_none
      have h_zero : (∑ c₀ : k_L, ∑ x : k_L, (ψ_k * ψ_0L.mulShift (-c₀)) x) = 0 := by
        apply Finset.sum_eq_zero
        intro c₀ _
        rw [AddChar.sum_eq_ite, if_neg (h_none c₀)]
      have h_card : (∑ c₀ : k_L, ∑ x : k_L, (ψ_k * ψ_0L.mulShift (-c₀)) x) =
          (Fintype.card k_L : Ω F) := by
        rw [Finset.sum_comm]
        have h_inner : ∀ x : k_L,
            (∑ c₀ : k_L, (ψ_k * ψ_0L.mulShift (-c₀)) x) =
              if x = 0 then (Fintype.card k_L : Ω F) else 0 := by
          intro x
          have h_term : ∀ c₀ : k_L,
              (ψ_k * ψ_0L.mulShift (-c₀)) x = ψ_k x * ψ_0L (c₀ * (-x)) := by
            intro c₀
            rw [AddChar.mul_apply, AddChar.mulShift_apply, neg_mul, ← mul_neg]
          simp_rw [h_term, ← Finset.mul_sum, AddChar.sum_mulShift (-x) hPrim, neg_eq_zero]
          split_ifs with hx
          · subst hx
            rw [AddChar.map_zero_eq_one, one_mul]
          · simp
        simp_rw [h_inner]
        rw [Finset.sum_ite_eq' Finset.univ (0 : k_L), if_pos (Finset.mem_univ _)]
      have h_ne : (Fintype.card k_L : Ω F) ≠ 0 :=
        Nat.cast_ne_zero.mpr Fintype.card_ne_zero
      exact h_ne (h_card.symm.trans h_zero)
    rcases hex_c₀ with ⟨c₀, hc₀_eq⟩
    rw [← AddChar.one_eq_zero] at hc₀_eq
    have hψ_eq : ψ_k = ψ_0L.mulShift c₀ := by
      calc ψ_k = ψ_k * 1 := (mul_one ψ_k).symm
        _ = ψ_k * ψ_0L.mulShift 0 := by rw [AddChar.mulShift_zero]
        _ = ψ_k * ψ_0L.mulShift (-c₀ + c₀) := by rw [neg_add_cancel]
        _ = (ψ_k * ψ_0L.mulShift (-c₀)) * ψ_0L.mulShift c₀ := by
            rw [← AddChar.mulShift_mul, mul_assoc]
        _ = ψ_0L.mulShift c₀ := by rw [hc₀_eq, one_mul]
    have hc₀_ne : c₀ ≠ 0 := by
      rintro rfl
      rw [AddChar.mulShift_zero] at hψ_eq
      exact hψ_k hψ_eq
    let c : k_Lˣ := Units.mk0 c₀ hc₀_ne
    have hψ_apply : ∀ x : k_L, ψ_k x = ψ_0L ((c : k_L) * x) := by
      intro x
      rw [hψ_eq, AddChar.mulShift_apply]
      rfl
    refine ⟨c, ?_, ?_⟩
    · intro α
      rw [← Equiv.sum_comp (Equiv.mulLeft c⁻¹)]
      have h_term : ∀ x : k_Lˣ,
          (α (Equiv.mulLeft c⁻¹ x) : Ω F) * ψ_k ((Equiv.mulLeft c⁻¹ x : k_Lˣ) : k_L) =
            ((α c)⁻¹ : Ω F) * ((α x : Ω F) * ψ_0L (x : k_L)) := by
        intro x
        change (α (c⁻¹ * x) : Ω F) * ψ_k (((c⁻¹ * x : k_Lˣ) : k_L)) = _
        rw [map_mul, map_inv, Units.val_mul, Units.val_inv_eq_inv_val, Units.val_mul,
          hψ_apply, ← mul_assoc, Units.mul_inv, one_mul, mul_assoc]
      simp_rw [h_term, ← Finset.mul_sum]
    · have htr_step : ∀ y : k_M,
          Algebra.trace k_L k_M (y ^ q) = Algebra.trace k_L k_M y := by
        intro y
        apply (algebraMap k_L k_M).injective
        rw [FiniteField.algebraMap_trace_eq_sum_pow k_L k_M,
          FiniteField.algebraMap_trace_eq_sum_pow k_L k_M,
          Nat.card_eq_fintype_card, hfinrank]
        rcases Nat.eq_zero_or_pos ℓ with rfl | hℓ_pos
        · simp
        · have hℓ : (ℓ - 1) + 1 = ℓ := Nat.sub_add_cancel hℓ_pos
          rw [← hℓ, Finset.sum_range_succ, Finset.sum_range_succ']
          have h_sum : (∑ i ∈ Finset.range (ℓ - 1), (y ^ q) ^ (q ^ i)) =
              ∑ i ∈ Finset.range (ℓ - 1), y ^ (q ^ (i + 1)) := by
            apply Finset.sum_congr rfl
            intro i _
            rw [← pow_mul, ← pow_succ']
          have h_end : (y ^ q) ^ (q ^ (ℓ - 1)) = y ^ (q ^ 0) := by
            rw [← pow_mul, ← pow_succ', hℓ, ← hQ, FiniteField.pow_card, pow_zero, pow_one]
          rw [h_sum, h_end]
      have htr_frob : ∀ (j : ℕ) (y : k_M),
          Algebra.trace k_L k_M (y ^ (q ^ j)) = Algebra.trace k_L k_M y := by
        intro j
        induction j with
        | zero =>
          intro y
          rw [pow_zero, pow_one]
        | succ j ih =>
          intro y
          rw [pow_succ, pow_mul, htr_step, ih]
      intro j hj α_M hχ
      let c_M : k_Mˣ := Units.map (algebraMap k_L k_M).toMonoidHom c
      rw [← Equiv.sum_comp (Equiv.mulLeft c_M⁻¹)]
      have h_shift : ∀ y : k_Mˣ,
          (χ_M (Equiv.mulLeft c_M⁻¹ y) : Ω F) *
            ψ_k (Algebra.trace k_L k_M ((Equiv.mulLeft c_M⁻¹ y : k_Mˣ) : k_M)) =
          ((χ_M c_M)⁻¹ : Ω F) *
            ((χ_M y : Ω F) * ψ_0L (Algebra.trace k_L k_M (y : k_M))) := by
        intro y
        change (χ_M (c_M⁻¹ * y) : Ω F) *
          ψ_k (Algebra.trace k_L k_M (((c_M⁻¹ * y : k_Mˣ) : k_M))) = _
        have h_tr : Algebra.trace k_L k_M (((c_M⁻¹ * y : k_Mˣ) : k_M)) =
            ((c⁻¹ : k_Lˣ) : k_L) * Algebra.trace k_L k_M (y : k_M) := by
          rw [Units.val_mul, Units.coe_map_inv, RingHom.toMonoidHom_eq_coe,
            MonoidHom.coe_coe, ← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]
        rw [map_mul, map_inv, Units.val_mul, Units.val_inv_eq_inv_val, h_tr, hψ_apply,
          ← mul_assoc, Units.mul_inv, one_mul, mul_assoc]
      simp_rw [h_shift, ← Finset.mul_sum]
      congr 1
      let e_frob : k_Mˣ ≃ k_Mˣ := {
        toFun := fun y => y ^ (q ^ j)
        invFun := fun y => y ^ (q ^ (ℓ - j))
        left_inv := fun y => Units.ext (by
          simp only [Units.val_pow_eq_pow_val, ← pow_mul, ← pow_add,
            Nat.add_sub_of_le hj, ← hQ, FiniteField.pow_card])
        right_inv := fun y => Units.ext (by
          simp only [Units.val_pow_eq_pow_val, ← pow_mul, ← pow_add,
            Nat.sub_add_cancel hj, ← hQ, FiniteField.pow_card])
      }
      have h_frob_term : ∀ y : k_Mˣ,
          (χ_M y : Ω F) * ψ_0L (Algebra.trace k_L k_M (y : k_M)) =
            (((α_M (e_frob y))⁻¹ : Ω F) *
              ψ_0L (Algebra.trace k_L k_M ((e_frob y : k_Mˣ) : k_M))) := by
        intro y
        change (χ_M y : Ω F) * ψ_0L (Algebra.trace k_L k_M (y : k_M)) =
          (((α_M (y ^ (q ^ j)))⁻¹ : Ω F) *
            ψ_0L (Algebra.trace k_L k_M (((y ^ (q ^ j) : k_Mˣ) : k_M))))
        rw [hχ y, Units.val_inv_eq_inv_val, Units.val_pow_eq_pow_val, htr_frob j (y : k_M)]
      simp_rw [h_frob_term]
      exact Equiv.sum_comp e_frob (fun z : k_Mˣ =>
        ((α_M z)⁻¹ : Ω F) * ψ_0L (Algebra.trace k_L k_M (z : k_M)))
  · intro n hn ζ z hord hz
    haveI : NeZero n := ⟨Nat.ne_of_gt hn⟩
    exact (IsPrimitiveRoot.iff_orderOf.mpr hord).eq_pow_of_mem_rootsOfUnity
      ((mem_rootsOfUnity n z).mpr hz)
  · intro y
    apply Units.ext
    simp only [Units.coe_map, MonoidHom.coe_coe, RingHom.toMonoidHom_eq_coe,
      Units.val_pow_eq_pow_val, FiniteField.algebraMap_norm_eq_pow,
      Nat.card_eq_fintype_card, hQ, S, q]

theorem ld_ch12_tame_ff_teichmuller_exponents_and_frob_conj (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M]
    (ℓ : ℕ) (hPrime : Nat.Prime ℓ) (hNeChar : (ℓ : k_L) ≠ 0)
    (hQ : Fintype.card k_M = (Fintype.card k_L) ^ ℓ)
    (hdvd : ℓ ∣ (Fintype.card k_L - 1))
    (g_M : k_Mˣ) (ω_M : k_Mˣ →* (Ω F)ˣ)
    (hgen_M : ∀ y : k_Mˣ, ∃ m < Fintype.card k_M - 1, g_M ^ m = y)
    (hord_gM : orderOf g_M = Fintype.card k_M - 1)
    (hord_ωgM : orderOf (ω_M g_M) = Fintype.card k_M - 1)
    (hNorm_pow : ∀ y : k_Mˣ,
      Units.map (algebraMap k_L k_M).toMonoidHom (Units.map (Algebra.norm k_L (S := k_M)) y) =
        y ^ (((Fintype.card k_L) ^ ℓ - 1) / (Fintype.card k_L - 1)))
    (hRootExh : ∀ (n : ℕ), 0 < n → ∀ (ζ z : (Ω F)ˣ), orderOf ζ = n → z ^ n = 1 →
      ∃ m < n, ζ ^ m = z)
    (ν_k χ_L : k_Lˣ →* (Ω F)ˣ) (χ_M : k_Mˣ →* (Ω F)ˣ)
    (hν_pow : ν_k ^ ℓ = 1) (hν_ne : ν_k ≠ 1)
    (hχM_pow : ∀ y : k_Mˣ,
      (χ_M y) ^ ℓ = χ_L (Units.map (Algebra.norm k_L (S := k_M)) y))
    (hχM_frob : χ_M ^ (Fintype.card k_L) ≠ χ_M) :
    let q := Fintype.card k_L
    let h := (q - 1) / ℓ
    let S := (q ^ ℓ - 1) / (q - 1)
    let ω_L := ω_M.comp (Units.map (algebraMap k_L k_M).toMonoidHom)
    ∃ a : ℕ,
      0 < a ∧
      a < q - 1 ∧
      ¬ (ℓ ∣ a) ∧
      ℓ ∣ (Fintype.card k_M - 1) ∧
      (∃ j₀ ≤ ℓ, ∀ y : k_Mˣ, χ_M y = ((ω_M ^ ((a * S) / ℓ)) (y ^ (q ^ j₀)))⁻¹) ∧
      (∀ (ψ_k ψ_0L : AddChar k_L (Ω F)) (c : k_Lˣ),
        (∀ (α : k_Lˣ →* (Ω F)ˣ),
          (∑ x : k_Lˣ, (α x : Ω F) * ψ_k (x : k_L)) =
            ((α c)⁻¹ : Ω F) * (∑ x : k_Lˣ, (α x : Ω F) * ψ_0L (x : k_L))) →
        ((χ_L (Units.mk0 (ℓ : k_L) hNeChar))⁻¹ : Ω F) *
          (∑ x : k_Lˣ, (χ_L x : Ω F) * ψ_k (x : k_L)) *
          (∏ j ∈ (Finset.range ℓ).erase 0,
            (∑ x : k_Lˣ, ((ν_k ^ j) x : Ω F) * ψ_k (x : k_L))) =
        ((χ_M (Units.map (algebraMap k_L k_M).toMonoidHom c))⁻¹ : Ω F) *
          (((ω_L ^ a) (Units.mk0 (ℓ : k_L) hNeChar) : Ω F) *
            (∑ x : k_Lˣ, (((ω_L ^ a) x)⁻¹ : Ω F) * ψ_0L (x : k_L)) *
            (∏ j ∈ (Finset.range ℓ).erase 0,
              (∑ x : k_Lˣ, (((ω_L ^ (j * h)) x)⁻¹ : Ω F) * ψ_0L (x : k_L))))) :=
by
  intro q h S ω_L
  set Q := Fintype.card k_M
  set D_Q := (q ^ ℓ - 1) / ℓ
  set J := (Finset.range ℓ).erase 0
  set ι_M := Units.map (algebraMap k_L k_M).toMonoidHom
  have hq : 1 < q := Fintype.one_lt_card
  have hq2 : 2 ≤ q := hq
  have hq1_pos : 0 < q - 1 := Nat.sub_pos_of_lt hq
  have hq1_dvd : (q - 1) ∣ (q ^ ℓ - 1) := by
    simpa using Nat.sub_dvd_pow_sub_pow q 1 ℓ
  have hS_mul : (q - 1) * S = q ^ ℓ - 1 := Nat.mul_div_cancel' hq1_dvd
  have hq_pow_gt1 : 1 < q ^ ℓ := Nat.one_lt_pow hPrime.ne_zero hq
  have hq_pow_sub_pos : 0 < q ^ ℓ - 1 := Nat.sub_pos_of_lt hq_pow_gt1
  have hS_pos : 0 < S := by
    by_contra h0
    have h0' : S = 0 := Nat.eq_zero_of_not_pos h0
    rw [h0', mul_zero] at hS_mul
    exact (ne_of_gt hq_pow_sub_pos) hS_mul.symm
  have hlh : ℓ * h = q - 1 := Nat.mul_div_cancel' hdvd
  have hh_pos : 0 < h := by
    by_contra h0
    have h0' : h = 0 := Nat.eq_zero_of_not_pos h0
    rw [h0', mul_zero] at hlh
    exact (ne_of_gt hq1_pos) hlh.symm
  have hdvd_Q' : ℓ ∣ (q ^ ℓ - 1) := ⟨h * S, by rw [← mul_assoc, hlh, hS_mul]⟩
  have hDQ_mul : ℓ * D_Q = q ^ ℓ - 1 := Nat.mul_div_cancel' hdvd_Q'
  have hDQ_eq : D_Q = h * S :=
    Nat.eq_of_mul_eq_mul_left hPrime.pos (by rw [hDQ_mul, ← mul_assoc, hlh, hS_mul])
  have hS_sum : ∑ i ∈ Finset.range ℓ, q ^ i = S := Nat.geomSum_eq hq2 ℓ
  have hq_eq : q = (q - 1) + 1 := (Nat.sub_add_cancel (le_of_lt hq)).symm
  have hBinom : ∀ i : ℕ, ∃ B : ℕ, q ^ i = 1 + i * (q - 1) + (q - 1) ^ 2 * B := by
    intro i
    induction' i with i ih
    · exact ⟨0, by simp⟩
    · rcases ih with ⟨B, hB⟩
      refine ⟨i + B * (q - 1) + B, ?_⟩
      calc q ^ (i + 1) = q ^ i * q := pow_succ q i
        _ = (1 + i * (q - 1) + (q - 1) ^ 2 * B) * ((q - 1) + 1) := by rw [hB, ← hq_eq]
        _ = 1 + (i + 1) * (q - 1) + (q - 1) ^ 2 * (i + B * (q - 1) + B) := by ring
  let B_fn : ℕ → ℕ := fun i => (hBinom i).choose
  have hB_fn : ∀ i : ℕ, q ^ i = 1 + i * (q - 1) + (q - 1) ^ 2 * B_fn i :=
    fun i => (hBinom i).choose_spec
  let B_tot : ℕ := ∑ i ∈ Finset.range ℓ, B_fn i
  have hS_exp : S = ℓ + (∑ i ∈ Finset.range ℓ, i) * (q - 1) + (q - 1) ^ 2 * B_tot := by
    rw [← hS_sum]
    have hcongr : ∑ i ∈ Finset.range ℓ, q ^ i =
        ∑ i ∈ Finset.range ℓ, (1 + i * (q - 1) + (q - 1) ^ 2 * B_fn i) :=
      Finset.sum_congr rfl fun i _ => hB_fn i
    rw [hcongr, Finset.sum_add_distrib, Finset.sum_add_distrib, Finset.sum_const,
      Finset.card_range, smul_eq_mul, mul_one, ← Finset.sum_mul, ← Finset.mul_sum]
  have hJ_sum : ∑ j ∈ J, j * h = (∑ i ∈ Finset.range ℓ, i) * h := by
    dsimp only [J]
    rw [Finset.sum_erase (Finset.range ℓ) (f := fun j => j * h) (zero_mul h), ← Finset.sum_mul]
  let S_quot : ℕ := 1 + (∑ j ∈ J, j * h) + (q - 1) * h * B_tot
  have hS_quot_eq : S = ℓ * S_quot := by
    dsimp only [S_quot]
    calc S = ℓ + (∑ i ∈ Finset.range ℓ, i) * (q - 1) + (q - 1) ^ 2 * B_tot := hS_exp
      _ = ℓ + (∑ i ∈ Finset.range ℓ, i) * (ℓ * h) + ((q - 1) * (ℓ * h)) * B_tot := by
        rw [hlh, sq]
      _ = ℓ * (1 + ((∑ i ∈ Finset.range ℓ, i) * h) + (q - 1) * h * B_tot) := by ring
      _ = ℓ * (1 + (∑ j ∈ J, j * h) + (q - 1) * h * B_tot) := by rw [hJ_sum]
  have hS_dvd : ℓ ∣ S := ⟨S_quot, hS_quot_eq⟩
  let g_L : k_Lˣ := Units.map (Algebra.norm k_L (S := k_M)) g_M
  have hg_L_map : ι_M g_L = g_M ^ S := hNorm_pow g_M
  have hS_ne0 : S ≠ 0 := Nat.ne_of_gt hS_pos
  have hQ_sub : Q - 1 = (q - 1) * S := by rw [hQ, ← hS_mul]
  have hS_dvd_ord_gM : S ∣ orderOf g_M := ⟨q - 1, by rw [hord_gM, hQ_sub, mul_comm]⟩
  have hord_gMS : orderOf (g_M ^ S) = q - 1 := by
    rw [orderOf_pow_of_dvd hS_ne0 hS_dvd_ord_gM, hord_gM, hQ_sub, Nat.mul_div_left _ hS_pos]
  have hι_inj : Function.Injective ι_M := Units.map_injective (algebraMap k_L k_M).injective
  have hord_gL : orderOf g_L = q - 1 := by
    rw [← orderOf_injective ι_M hι_inj g_L, hg_L_map, hord_gMS]
  have hωL_gL : ω_L g_L = (ω_M g_M) ^ S := by
    change ω_M (ι_M g_L) = (ω_M g_M) ^ S
    rw [hg_L_map, map_pow]
  have hS_dvd_ord_ωgM : S ∣ orderOf (ω_M g_M) := ⟨q - 1, by rw [hord_ωgM, hQ_sub, mul_comm]⟩
  have hord_ωLgL : orderOf (ω_L g_L) = q - 1 := by
    rw [hωL_gL, orderOf_pow_of_dvd hS_ne0 hS_dvd_ord_ωgM, hord_ωgM, hQ_sub,
      Nat.mul_div_left _ hS_pos]
  have hinj_gL : Set.InjOn (fun m => g_L ^ m) (Finset.range (q - 1)) := by
    intro m₁ hm₁ m₂ hm₂ heq
    rw [Finset.mem_coe, Finset.mem_range, ← hord_gL] at hm₁ hm₂
    exact pow_injOn_Iio_orderOf hm₁ hm₂ heq
  have hcard_kLx : Fintype.card k_Lˣ = q - 1 := Fintype.card_units k_L
  have hsurj_gL : (Finset.range (q - 1)).image (fun m => g_L ^ m) = Finset.univ :=
    Finset.eq_of_subset_of_card_le (Finset.subset_univ _)
      (by rw [Finset.card_image_of_injOn hinj_gL, Finset.card_range, Finset.card_univ, hcard_kLx])
  have hgen_L : ∀ x : k_Lˣ, ∃ m < q - 1, g_L ^ m = x := by
    intro x
    have hx : x ∈ (Finset.range (q - 1)).image (fun m => g_L ^ m) := by
      rw [hsurj_gL]
      exact Finset.mem_univ x
    rw [Finset.mem_image] at hx
    rcases hx with ⟨m, hm, rfl⟩
    exact ⟨m, Finset.mem_range.mp hm, rfl⟩
  have hωL_pow : ∀ x : k_Lˣ, (ω_L x) ^ (q - 1) = 1 := by
    intro x
    rcases hgen_L x with ⟨m, _, rfl⟩
    rw [map_pow, ← pow_mul, mul_comm m, pow_mul, ← hord_ωLgL, pow_orderOf_eq_one, one_pow]
  have hωM_pow : ∀ y : k_Mˣ, (ω_M y) ^ (q ^ ℓ - 1) = 1 := by
    intro y
    rcases hgen_M y with ⟨m, _, rfl⟩
    rw [map_pow, ← pow_mul, mul_comm m, pow_mul, ← hQ, ← hord_ωgM, pow_orderOf_eq_one, one_pow]
  have hgL_pow : g_L ^ (q - 1) = 1 := by rw [← hord_gL, pow_orderOf_eq_one]
  have hχL_gL_pow : ((χ_L g_L)⁻¹) ^ (q - 1) = 1 := by
    rw [inv_pow, ← map_pow, hgL_pow, map_one, inv_one]
  rcases hRootExh (q - 1) hq1_pos (ω_L g_L) ((χ_L g_L)⁻¹) hord_ωLgL hχL_gL_pow with
    ⟨a, ha_lt, ha_eq⟩
  have hχL_eq : ∀ x : k_Lˣ, χ_L x = ((ω_L ^ a) x)⁻¹ := by
    intro x
    rcases hgen_L x with ⟨m, _, rfl⟩
    change χ_L (g_L ^ m) = ((ω_L (g_L ^ m)) ^ a)⁻¹
    rw [map_pow, map_pow, ← pow_mul, mul_comm m a, pow_mul, ha_eq, inv_pow, inv_inv]
  let ζ_ℓ : (Ω F)ˣ := (ω_M g_M) ^ D_Q
  have hDQ_pos : 0 < D_Q := by
    rw [hDQ_eq]
    exact Nat.mul_pos hh_pos hS_pos
  have hDQ_ne0 : D_Q ≠ 0 := Nat.ne_of_gt hDQ_pos
  have hDQ_dvd : D_Q ∣ orderOf (ω_M g_M) := ⟨ℓ, by rw [hord_ωgM, hQ, ← hDQ_mul, mul_comm]⟩
  have hord_ζ : orderOf ζ_ℓ = ℓ := by
    dsimp only [ζ_ℓ]
    rw [orderOf_pow_of_dvd hDQ_ne0 hDQ_dvd, hord_ωgM, hQ, ← hDQ_mul, Nat.mul_div_cancel _ hDQ_pos]
  have ha_not_dvd : ¬ (ℓ ∣ a) := by
    rintro ⟨m₀, rfl⟩
    have hχM_gM_pow0 : ((χ_M g_M)⁻¹ * (((ω_M g_M) ^ (m₀ * S))⁻¹)) ^ ℓ = 1 := by
      rw [mul_pow, inv_pow, inv_pow, hχM_pow g_M, hχL_eq g_L]
      change ((((ω_L g_L) ^ (ℓ * m₀))⁻¹)⁻¹) * (((ω_M g_M) ^ (m₀ * S)) ^ ℓ)⁻¹ = 1
      rw [inv_inv, hωL_gL, ← pow_mul, ← pow_mul]
      have hexp : S * (ℓ * m₀) = m₀ * S * ℓ := by ring
      rw [hexp, mul_inv_cancel]
    rcases hRootExh ℓ hPrime.pos ζ_ℓ ((χ_M g_M)⁻¹ * (((ω_M g_M) ^ (m₀ * S))⁻¹))
      hord_ζ hχM_gM_pow0 with ⟨r₀, _, hr₀_eq⟩
    have hχM_gM_inv : (χ_M g_M)⁻¹ = ((ω_M g_M) ^ S) ^ (m₀ + r₀ * h) := by
      have h1 : (χ_M g_M)⁻¹ = ζ_ℓ ^ r₀ * (ω_M g_M) ^ (m₀ * S) := by
        rw [hr₀_eq, inv_mul_cancel_right]
      dsimp only [ζ_ℓ] at h1
      rw [h1, ← pow_mul, ← pow_add, ← pow_mul]
      congr 1
      rw [hDQ_eq]
      ring
    have hχM_gM : χ_M g_M = (((ω_M g_M) ^ S) ^ (m₀ + r₀ * h))⁻¹ :=
      inv_eq_iff_eq_inv.mp hχM_gM_inv
    have hSq : ((ω_M g_M) ^ S) ^ q = (ω_M g_M) ^ S := by
      have hSq_exp : S * q = (q ^ ℓ - 1) + S := by
        calc S * q = S * ((q - 1) + 1) := by rw [Nat.sub_add_cancel (le_of_lt hq)]
          _ = (q - 1) * S + S := by ring
          _ = (q ^ ℓ - 1) + S := by rw [hS_mul]
      rw [← pow_mul, hSq_exp, pow_add, hωM_pow g_M, one_mul]
    have hχM_q : χ_M ^ q = χ_M := by
      apply MonoidHom.ext
      intro y
      rcases hgen_M y with ⟨m, _, rfl⟩
      change (χ_M (g_M ^ m)) ^ q = χ_M (g_M ^ m)
      rw [map_pow, hχM_gM, inv_pow, inv_pow, ← pow_mul, ← pow_mul]
      congr 1
      rw [← pow_mul ((ω_M g_M) ^ S) (m₀ + r₀ * h) m]
      have hexp_q : (m₀ + r₀ * h) * (m * q) = q * ((m₀ + r₀ * h) * m) := by ring
      rw [hexp_q, pow_mul, hSq]
    exact hχM_frob hχM_q
  have ha_pos : 0 < a := by
    by_contra h0
    have h0' : a = 0 := Nat.eq_zero_of_not_pos h0
    rw [h0'] at ha_not_dvd
    exact ha_not_dvd (dvd_zero ℓ)
  set a_star := (a * S) / ℓ
  have haS_dvd : ℓ ∣ a * S := dvd_mul_of_dvd_right hS_dvd a
  have ha_star_mul : ℓ * a_star = a * S := Nat.mul_div_cancel' haS_dvd
  have ha_star_eq : a_star = a * S_quot :=
    Nat.eq_of_mul_eq_mul_left hPrime.pos (by rw [ha_star_mul, hS_quot_eq]; ring)
  have hDQ_quot : D_Q = (q - 1) * S_quot :=
    Nat.eq_of_mul_eq_mul_left hPrime.pos (by rw [hDQ_mul, ← hS_mul, hS_quot_eq]; ring)
  have ha_star_q1 : a_star * (q - 1) = a * D_Q := by
    rw [ha_star_eq, hDQ_quot]; ring
  have hχM_gM_pow : ((χ_M g_M)⁻¹ * (((ω_M g_M) ^ a_star)⁻¹)) ^ ℓ = 1 := by
    rw [mul_pow, inv_pow, inv_pow, hχM_pow g_M, hχL_eq g_L]
    change ((((ω_L g_L) ^ a)⁻¹)⁻¹) * (((ω_M g_M) ^ a_star) ^ ℓ)⁻¹ = 1
    rw [inv_inv, hωL_gL, ← pow_mul, ← pow_mul]
    have hexp : S * a = a_star * ℓ := by rw [mul_comm S a, ← ha_star_mul, mul_comm]
    rw [hexp, mul_inv_cancel]
  rcases hRootExh ℓ hPrime.pos ζ_ℓ ((χ_M g_M)⁻¹ * (((ω_M g_M) ^ a_star)⁻¹))
    hord_ζ hχM_gM_pow with ⟨r, hr_lt, hr_eq⟩
  have hχM_gM_inv : (χ_M g_M)⁻¹ = (ω_M g_M) ^ (a_star + r * D_Q) := by
    have h1 : (χ_M g_M)⁻¹ = ζ_ℓ ^ r * (ω_M g_M) ^ a_star := by
      rw [hr_eq, inv_mul_cancel_right]
    dsimp only [ζ_ℓ] at h1
    rw [h1, ← pow_mul, ← pow_add, add_comm, mul_comm D_Q r]
  have hχM_eq : ∀ y : k_Mˣ, χ_M y = ((ω_M ^ (a_star + r * D_Q)) y)⁻¹ := by
    intro y
    rcases hgen_M y with ⟨m, _, rfl⟩
    change χ_M (g_M ^ m) = ((ω_M (g_M ^ m)) ^ (a_star + r * D_Q))⁻¹
    rw [map_pow, map_pow, ← pow_mul, mul_comm m, pow_mul, ← hχM_gM_inv, inv_pow, inv_inv]
  let η_ℓ : (Ω F)ˣ := (ω_L g_L) ^ h
  have hh_ne0 : h ≠ 0 := Nat.ne_of_gt hh_pos
  have hh_dvd : h ∣ orderOf (ω_L g_L) := ⟨ℓ, by rw [hord_ωLgL, ← hlh, mul_comm]⟩
  have hord_η : orderOf η_ℓ = ℓ := by
    dsimp only [η_ℓ]
    rw [orderOf_pow_of_dvd hh_ne0 hh_dvd, hord_ωLgL, ← hlh, Nat.mul_div_cancel _ hh_pos]
  have hν_gL_pow : ((ν_k g_L)⁻¹) ^ ℓ = 1 := by
    rw [inv_pow]
    have h1 : (ν_k g_L) ^ ℓ = (ν_k ^ ℓ) g_L := rfl
    rw [h1, hν_pow, MonoidHom.one_apply, inv_one]
  rcases hRootExh ℓ hPrime.pos η_ℓ ((ν_k g_L)⁻¹) hord_η hν_gL_pow with ⟨s, hs_lt, hs_eq⟩
  have hν_eq : ∀ x : k_Lˣ, ν_k x = ((ω_L ^ (s * h)) x)⁻¹ := by
    intro x
    rcases hgen_L x with ⟨m, _, rfl⟩
    change ν_k (g_L ^ m) = ((ω_L (g_L ^ m)) ^ (s * h))⁻¹
    have hs_eq' : (ω_L g_L) ^ (s * h) = (ν_k g_L)⁻¹ := by
      rw [mul_comm s h, pow_mul]
      exact hs_eq
    rw [map_pow, map_pow, ← pow_mul, mul_comm m (s * h), pow_mul, hs_eq', inv_pow, inv_inv]
  have hs_pos : 0 < s := by
    by_contra h0
    have h0' : s = 0 := Nat.eq_zero_of_not_pos h0
    have hν1 : ν_k = 1 := by
      apply MonoidHom.ext
      intro x
      change ν_k x = 1
      rw [hν_eq x, h0', zero_mul]
      change ((ω_L x) ^ 0)⁻¹ = 1
      rw [pow_zero, inv_one]
    exact hν_ne hν1
  have hdvd_Q : ℓ ∣ (Fintype.card k_M - 1) := by
    change ℓ ∣ Q - 1
    rw [hQ]
    exact hdvd_Q'
  refine ⟨a, ha_pos, ha_lt, ha_not_dvd, hdvd_Q, ?_, ?_⟩
  · have hcop : ℓ.Coprime a := (hPrime.coprime_iff_not_dvd).mpr ha_not_dvd
    have hinj : Set.InjOn (fun j => (j * a) % ℓ) (Finset.range ℓ) := by
      intro j₁ hj₁ j₂ hj₂ heq
      rw [Finset.mem_coe, Finset.mem_range] at hj₁ hj₂
      have hmod : j₁ * a ≡ j₂ * a [MOD ℓ] := heq
      have hmod' : j₁ ≡ j₂ [MOD ℓ] := Nat.ModEq.cancel_right_of_coprime hcop hmod
      change j₁ % ℓ = j₂ % ℓ at hmod'
      rwa [Nat.mod_eq_of_lt hj₁, Nat.mod_eq_of_lt hj₂] at hmod'
    have hsub : (Finset.range ℓ).image (fun j => (j * a) % ℓ) ⊆ Finset.range ℓ := by
      intro x hx
      rw [Finset.mem_image] at hx
      rcases hx with ⟨j, _, rfl⟩
      exact Finset.mem_range.mpr (Nat.mod_lt _ hPrime.pos)
    have hsurj : (Finset.range ℓ).image (fun j => (j * a) % ℓ) = Finset.range ℓ :=
      Finset.eq_of_subset_of_card_le hsub (by rw [Finset.card_image_of_injOn hinj])
    have hr_mem : r ∈ (Finset.range ℓ).image (fun j => (j * a) % ℓ) := by
      rw [hsurj]
      exact Finset.mem_range.mpr hr_lt
    rw [Finset.mem_image] at hr_mem
    rcases hr_mem with ⟨j₀, hj₀_mem, hj₀_mod⟩
    have hj₀_lt : j₀ < ℓ := Finset.mem_range.mp hj₀_mem
    let q_div : ℕ := (j₀ * a) / ℓ
    have hj₀_div : j₀ * a = r + ℓ * q_div := by
      have h1 := (Nat.mod_add_div (j₀ * a) ℓ).symm
      rwa [hj₀_mod] at h1
    have hq_mod : ∀ k : ℕ, ∃ m : ℕ, q ^ k = 1 + ℓ * m := by
      intro k
      induction' k with k ih
      · exact ⟨0, by simp⟩
      · rcases ih with ⟨m, hm⟩
        refine ⟨m + h + ℓ * m * h, ?_⟩
        calc q ^ (k + 1) = q ^ k * q := pow_succ q k
          _ = (1 + ℓ * m) * ((ℓ * h) + 1) := by rw [hm, hlh, ← hq_eq]
          _ = 1 + ℓ * (m + h + ℓ * m * h) := by ring
    let m_fn : ℕ → ℕ := fun k => (hq_mod k).choose
    have hm_fn : ∀ k : ℕ, q ^ k = 1 + ℓ * m_fn k := fun k => (hq_mod k).choose_spec
    let M_j₀ : ℕ := ∑ k ∈ Finset.range j₀, m_fn k
    have hsum_j₀ : ∑ k ∈ Finset.range j₀, q ^ k = j₀ + ℓ * M_j₀ := by
      have hcongr : ∑ k ∈ Finset.range j₀, q ^ k =
          ∑ k ∈ Finset.range j₀, (1 + ℓ * m_fn k) :=
        Finset.sum_congr rfl fun k _ => hm_fn k
      rw [hcongr, Finset.sum_add_distrib, Finset.sum_const, Finset.card_range,
        smul_eq_mul, mul_one, ← Finset.mul_sum]
    have hgeom_j₀ : (q - 1) * (∑ k ∈ Finset.range j₀, q ^ k) = q ^ j₀ - 1 := by
      have hdvd_j₀ : (q - 1) ∣ (q ^ j₀ - 1) := by
        simpa using Nat.sub_dvd_pow_sub_pow q 1 j₀
      rw [Nat.geomSum_eq hq2 j₀, Nat.mul_div_cancel' hdvd_j₀]
    have hqj₀_pos : 1 ≤ q ^ j₀ := Nat.one_le_pow j₀ q (by omega)
    have hqj₀_eq : q ^ j₀ = 1 + (q - 1) * (j₀ + ℓ * M_j₀) := by
      rw [← hsum_j₀, hgeom_j₀]
      omega
    let M : ℕ := q_div + a * M_j₀
    have hFrob_exp : a_star * q ^ j₀ = (a_star + r * D_Q) + M * (q ^ ℓ - 1) := by
      dsimp only [M]
      calc a_star * q ^ j₀
        _ = a_star * (1 + (q - 1) * (j₀ + ℓ * M_j₀)) := by rw [hqj₀_eq]
        _ = a_star + (a_star * (q - 1)) * (j₀ + ℓ * M_j₀) := by ring
        _ = a_star + (a * D_Q) * (j₀ + ℓ * M_j₀) := by rw [ha_star_q1]
        _ = a_star + (j₀ * a) * D_Q + a * M_j₀ * (ℓ * D_Q) := by ring
        _ = a_star + (r + ℓ * q_div) * D_Q + a * M_j₀ * (q ^ ℓ - 1) := by
          rw [hj₀_div, hDQ_mul]
        _ = a_star + r * D_Q + q_div * (ℓ * D_Q) + a * M_j₀ * (q ^ ℓ - 1) := by ring
        _ = (a_star + r * D_Q) + (q_div + a * M_j₀) * (q ^ ℓ - 1) := by
          rw [hDQ_mul]; ring
    refine ⟨j₀, le_of_lt hj₀_lt, fun y => ?_⟩
    rw [hχM_eq y]
    congr 1
    change (ω_M y) ^ (a_star + r * D_Q) = (ω_M (y ^ (q ^ j₀))) ^ a_star
    rw [map_pow, ← pow_mul, mul_comm (q ^ j₀) a_star, hFrob_exp,
      pow_add (ω_M y) (a_star + r * D_Q), mul_comm M (q ^ ℓ - 1),
      pow_mul (ω_M y) (q ^ ℓ - 1), hωM_pow y, one_pow, mul_one]
  · intro ψ_k ψ_0L c hc_L
    have hsum_dvd : ℓ ∣ (a - 1) * (∑ i ∈ Finset.range ℓ, i) := by
      rcases hPrime.eq_two_or_odd with rfl | hodd
      · have ha_odd : 2 ∣ (a - 1) := ⟨(a - 1) / 2, by omega⟩
        exact dvd_mul_of_dvd_left ha_odd _
      · have hsum_two : (∑ i ∈ Finset.range ℓ, i) * 2 = ℓ * (ℓ - 1) :=
          Finset.sum_range_id_mul_two ℓ
        have h2_dvd : 2 ∣ (ℓ - 1) := ⟨(ℓ - 1) / 2, by omega⟩
        rcases h2_dvd with ⟨c₀, hc₀⟩
        have hsum_eq : ∑ i ∈ Finset.range ℓ, i = ℓ * c₀ := by
          apply Nat.eq_of_mul_eq_mul_right zero_lt_two
          rw [hsum_two, hc₀]
          ring
        exact ⟨(a - 1) * c₀, by rw [hsum_eq]; ring⟩
    rcases hsum_dvd with ⟨T, hT⟩
    have hJh_eq : (a - 1) * (∑ j ∈ J, j * h) = T * (q - 1) := by
      calc (a - 1) * (∑ j ∈ J, j * h)
        _ = (a - 1) * ((∑ i ∈ Finset.range ℓ, i) * h) := by rw [hJ_sum]
        _ = ((a - 1) * (∑ i ∈ Finset.range ℓ, i)) * h := by ring
        _ = (ℓ * T) * h := by rw [hT]
        _ = T * (ℓ * h) := by ring
        _ = T * (q - 1) := by rw [hlh]
    have ha_split : a = 1 + (a - 1) := by omega
    let K : ℕ := T + a * h * B_tot + r * S_quot
    have hScale_exp : a_star + r * D_Q = (a + ∑ j ∈ J, j * h) + K * (q - 1) := by
      dsimp only [K]
      calc a_star + r * D_Q
        _ = a * S_quot + r * ((q - 1) * S_quot) := by rw [ha_star_eq, hDQ_quot]
        _ = a * (1 + (∑ j ∈ J, j * h) + (q - 1) * h * B_tot) + r * ((q - 1) * S_quot) := rfl
        _ = a + a * (∑ j ∈ J, j * h) + (a * h * B_tot + r * S_quot) * (q - 1) := by ring
        _ = a + (1 + (a - 1)) * (∑ j ∈ J, j * h) + (a * h * B_tot + r * S_quot) * (q - 1) := by
          conv_lhs => enter [1, 2, 1]; rw [ha_split]
        _ = (a + ∑ j ∈ J, j * h) + (a - 1) * (∑ j ∈ J, j * h) +
            (a * h * B_tot + r * S_quot) * (q - 1) := by ring
        _ = (a + ∑ j ∈ J, j * h) + T * (q - 1) + (a * h * B_tot + r * S_quot) * (q - 1) := by
          rw [hJh_eq]
        _ = (a + ∑ j ∈ J, j * h) + (T + a * h * B_tot + r * S_quot) * (q - 1) := by ring
    have hs_not_dvd : ¬ (ℓ ∣ s) := Nat.not_dvd_of_pos_of_lt hs_pos hs_lt
    have hcop_s : ℓ.Coprime s := (hPrime.coprime_iff_not_dvd).mpr hs_not_dvd
    have hJ_maps : ∀ j ∈ J, (s * j) % ℓ ∈ J := by
      intro j hj
      rw [Finset.mem_erase, Finset.mem_range] at hj ⊢
      rcases hj with ⟨hj_ne0, hj_lt⟩
      refine ⟨?_, Nat.mod_lt _ hPrime.pos⟩
      intro hmod0
      have hdvd_sj : ℓ ∣ s * j := Nat.dvd_of_mod_eq_zero hmod0
      rcases hPrime.dvd_mul.mp hdvd_sj with hdvd_s | hdvd_j
      · exact hs_not_dvd hdvd_s
      · exact Nat.not_dvd_of_pos_of_lt (Nat.pos_of_ne_zero hj_ne0) hj_lt hdvd_j
    have hJ_inj : Set.InjOn (fun j => (s * j) % ℓ) J := by
      intro j₁ hj₁ j₂ hj₂ heq
      rw [Finset.mem_coe, Finset.mem_erase, Finset.mem_range] at hj₁ hj₂
      have hmod : s * j₁ ≡ s * j₂ [MOD ℓ] := heq
      have hmod' : j₁ ≡ j₂ [MOD ℓ] := Nat.ModEq.cancel_left_of_coprime hcop_s hmod
      change j₁ % ℓ = j₂ % ℓ at hmod'
      rwa [Nat.mod_eq_of_lt hj₁.2, Nat.mod_eq_of_lt hj₂.2] at hmod'
    have hJ_sub : J.image (fun j => (s * j) % ℓ) ⊆ J := by
      intro x hx
      rw [Finset.mem_image] at hx
      rcases hx with ⟨j, hj, rfl⟩
      exact hJ_maps j hj
    have hJ_surj : J.image (fun j => (s * j) % ℓ) = J :=
      Finset.eq_of_subset_of_card_le hJ_sub (by rw [Finset.card_image_of_injOn hJ_inj])
    have hνj_eq : ∀ (j : ℕ) (x : k_Lˣ),
        (ν_k ^ j) x = ((ω_L ^ (((s * j) % ℓ) * h)) x)⁻¹ := by
      intro j x
      change (ν_k x) ^ j = ((ω_L x) ^ (((s * j) % ℓ) * h))⁻¹
      rw [hν_eq x]
      change (((ω_L x) ^ (s * h))⁻¹) ^ j = ((ω_L x) ^ (((s * j) % ℓ) * h))⁻¹
      rw [inv_pow, ← pow_mul]
      congr 1
      have hdiv : s * h * j = ((s * j) % ℓ) * h + (q - 1) * ((s * j) / ℓ) := by
        have h1 := (Nat.mod_add_div (s * j) ℓ).symm
        calc s * h * j = (s * j) * h := by ring
          _ = ((s * j) % ℓ + ℓ * ((s * j) / ℓ)) * h := by conv_lhs => rw [h1]
          _ = ((s * j) % ℓ) * h + (ℓ * h) * ((s * j) / ℓ) := by ring
          _ = ((s * j) % ℓ) * h + (q - 1) * ((s * j) / ℓ) := by rw [hlh]
      rw [hdiv, pow_add, pow_mul (ω_L x) (q - 1), hωL_pow x, one_pow, mul_one]
    set u_ℓ : k_Lˣ := Units.mk0 (ℓ : k_L) hNeChar
    have hu_eq : ((χ_L u_ℓ)⁻¹ : Ω F) = ((ω_L ^ a) u_ℓ : Ω F) := by
      rw [hχL_eq u_ℓ, Units.val_inv_eq_inv_val, inv_inv]
    have hsum_a : (∑ x : k_Lˣ, (χ_L x : Ω F) * ψ_k (x : k_L)) =
        ((ω_L c : Ω F) ^ a) * (∑ x : k_Lˣ, (((ω_L ^ a) x)⁻¹ : Ω F) * ψ_0L (x : k_L)) := by
      rw [hc_L χ_L, hχL_eq c, Units.val_inv_eq_inv_val, inv_inv]
      have hpow_c : (((ω_L ^ a) c : (Ω F)ˣ) : Ω F) = (ω_L c : Ω F) ^ a := by
        change (((ω_L c) ^ a : (Ω F)ˣ) : Ω F) = (ω_L c : Ω F) ^ a
        exact Units.val_pow_eq_pow_val (ω_L c) a
      rw [hpow_c]
      congr 1
      refine Finset.sum_congr rfl fun x _ => ?_
      rw [hχL_eq x, Units.val_inv_eq_inv_val]
    have hprod_J : (∏ j ∈ J, (∑ x : k_Lˣ, ((ν_k ^ j) x : Ω F) * ψ_k (x : k_L))) =
        ((ω_L c : Ω F) ^ (∑ j ∈ J, j * h)) *
          (∏ j ∈ J, (∑ x : k_Lˣ, (((ω_L ^ (j * h)) x)⁻¹ : Ω F) * ψ_0L (x : k_L))) := by
      have hterm : ∀ j ∈ J,
          (∑ x : k_Lˣ, ((ν_k ^ j) x : Ω F) * ψ_k (x : k_L)) =
            ((ω_L c : Ω F) ^ (((s * j) % ℓ) * h)) *
              (∑ x : k_Lˣ, (((ω_L ^ (((s * j) % ℓ) * h)) x)⁻¹ : Ω F) * ψ_0L (x : k_L)) := by
        intro j _
        rw [hc_L (ν_k ^ j), hνj_eq j c, Units.val_inv_eq_inv_val, inv_inv]
        have hpow_jc : (((ω_L ^ (((s * j) % ℓ) * h)) c : (Ω F)ˣ) : Ω F) =
            (ω_L c : Ω F) ^ (((s * j) % ℓ) * h) := by
          change (((ω_L c) ^ (((s * j) % ℓ) * h) : (Ω F)ˣ) : Ω F) =
            (ω_L c : Ω F) ^ (((s * j) % ℓ) * h)
          exact Units.val_pow_eq_pow_val (ω_L c) (((s * j) % ℓ) * h)
        rw [hpow_jc]
        congr 1
        refine Finset.sum_congr rfl fun x _ => ?_
        rw [hνj_eq j x, Units.val_inv_eq_inv_val]
      have hbij : (∏ j ∈ J, (∑ x : k_Lˣ, ((ν_k ^ j) x : Ω F) * ψ_k (x : k_L))) =
          ∏ k ∈ J, (((ω_L c : Ω F) ^ (k * h)) *
            (∑ x : k_Lˣ, (((ω_L ^ (k * h)) x)⁻¹ : Ω F) * ψ_0L (x : k_L))) := by
        refine Finset.prod_bij (fun j _ => (s * j) % ℓ) hJ_maps ?_ ?_ ?_
        · intro j₁ hj₁ j₂ hj₂ heq
          exact hJ_inj hj₁ hj₂ heq
        · intro k hk
          rw [← hJ_surj, Finset.mem_image] at hk
          rcases hk with ⟨j, hj, rfl⟩
          exact ⟨j, hj, rfl⟩
        · intro j hj
          exact hterm j hj
      rw [hbij, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum]
    have hc_M_eq : ((χ_M (ι_M c))⁻¹ : Ω F) =
        ((ω_L c : Ω F) ^ a) * ((ω_L c : Ω F) ^ (∑ j ∈ J, j * h)) := by
      have hc_unit : χ_M (ι_M c) = ((ω_L c) ^ (a + ∑ j ∈ J, j * h))⁻¹ := by
        rw [hχM_eq (ι_M c)]
        congr 1
        change (ω_L c) ^ (a_star + r * D_Q) = (ω_L c) ^ (a + ∑ j ∈ J, j * h)
        rw [hScale_exp, pow_add, mul_comm K (q - 1), pow_mul (ω_L c) (q - 1),
          hωL_pow c, one_pow, mul_one]
      rw [hc_unit, Units.val_inv_eq_inv_val, inv_inv, Units.val_pow_eq_pow_val, pow_add]
    rw [hu_eq, hsum_a, hprod_J, hc_M_eq]
    ring

theorem ld_ch12_tame_ff_cyclotomic_polynomial_cancellation (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M]
    (p ℓ q Q a : ℕ) (hPrime : Nat.Prime ℓ)
    (hNeChar : (ℓ : k_L) ≠ 0)
    (hQ_gt1 : 1 < Q) (hdvd_Q : ℓ ∣ (Q - 1))
    (g_M : k_Mˣ) (ω_M : k_Mˣ →* (Ω F)ˣ)
    (hgen_M : ∀ y : k_Mˣ, ∃ m < Q - 1, g_M ^ m = y)
    (hord_gM : orderOf g_M = Q - 1)
    (hord_ωgM : orderOf (ω_M g_M) = Q - 1)
    (hRootExh : ∀ (n : ℕ), 0 < n → ∀ (ζ z : (Ω F)ˣ), orderOf ζ = n → z ^ n = 1 →
      ∃ m < n, ζ ^ m = z)
    (ψ_0L : AddChar k_L (Ω F)) (ϖ : Ω F) (hϖ_ne0 : ϖ ≠ 0)
    (Φ_Ω : Polynomial ℤ →+* Ω F) (Φ_M : Polynomial ℤ →+* k_M)
    (P_Z P_1L P_1M : Polynomial ℤ)
    (P_JL P_JM : ℕ → Polynomial ℤ)
    (hΦ_Ω_PZ : Φ_Ω P_Z = (ω_M g_M : Ω F))
    (hΦ_M_PZ : Φ_M P_Z = (g_M : k_M))
    (hTransfer : ∀ P₁ P₂ : Polynomial ℤ, Φ_Ω P₁ = Φ_Ω P₂ → Φ_M P₁ = Φ_M P₂)
    (hP_1L : Φ_M P_1L = -1)
    (hP_1M : Φ_M P_1M = -1)
    (hJL : ∀ m : ℕ, 0 < m → m < q - 1 →
      let ω_L := ω_M.comp (Units.map (algebraMap k_L k_M).toMonoidHom)
      let s_m := (p.digits m).sum
      Φ_Ω (P_JL m) *
        (∑ x : k_Lˣ, (((ω_L ^ m) x)⁻¹ : Ω F) * ψ_0L (x : k_L)) =
        (Φ_Ω P_1L * ϖ) ^ s_m ∧
      Φ_M (P_JL m) =
        (-1 : k_M) ^ (s_m - 1) * (((p.digits m).map Nat.factorial).prod : k_M) ∧
      Φ_M (P_JL m) ≠ 0)
    (hJM : ∀ b : ℕ, 0 < b → b < Q - 1 →
      let s_b := (p.digits b).sum
      Φ_Ω (P_JM b) *
        (∑ y : k_Mˣ, (((ω_M ^ b) y)⁻¹ : Ω F) *
          ψ_0L (Algebra.trace k_L k_M (y : k_M))) =
        (Φ_Ω P_1M * ϖ) ^ s_b ∧
      Φ_M (P_JM b) =
        (-1 : k_M) ^ (s_b - 1) * (((p.digits b).map Nat.factorial).prod : k_M) ∧
      Φ_M (P_JM b) ≠ 0)
    (ha_pos : 0 < a) (ha_lt : a < q - 1)
    (a_star : ℕ) (ha_star_pos : 0 < a_star) (ha_star_lt : a_star < Q - 1)
    (hjh_bounds : ∀ j ∈ (Finset.range ℓ).erase 0,
      0 < j * ((q - 1) / ℓ) ∧ j * ((q - 1) / ℓ) < q - 1)
    (hDigits_sum : (p.digits a_star).sum =
      (p.digits a).sum + ∑ j ∈ (Finset.range ℓ).erase 0, (p.digits (j * ((q - 1) / ℓ))).sum)
    (hFact_eq : (ℓ : k_M) ^ a * (((p.digits a_star).map Nat.factorial).prod : k_M) =
      (((p.digits a).map Nat.factorial).prod : k_M) *
        ∏ j ∈ (Finset.range ℓ).erase 0,
          (((p.digits (j * ((q - 1) / ℓ))).map Nat.factorial).prod : k_M)) :
    let ω_L := ω_M.comp (Units.map (algebraMap k_L k_M).toMonoidHom)
    let h := (q - 1) / ℓ
    let LHS_0 := (-1 : Ω F) ^ (ℓ - 1) *
      (∑ y : k_Mˣ, (((ω_M ^ a_star) y)⁻¹ : Ω F) * ψ_0L (Algebra.trace k_L k_M (y : k_M)))
    let RHS_0 := (((ω_L ^ a) (Units.mk0 (ℓ : k_L) hNeChar) : Ω F)) *
      (∑ x : k_Lˣ, (((ω_L ^ a) x)⁻¹ : Ω F) * ψ_0L (x : k_L)) *
      (∏ j ∈ (Finset.range ℓ).erase 0,
        (∑ x : k_Lˣ, (((ω_L ^ (j * h)) x)⁻¹ : Ω F) * ψ_0L (x : k_L)))
    RHS_0 ≠ 0 →
    LHS_0 ^ ℓ = RHS_0 ^ ℓ →
    LHS_0 = RHS_0 :=
by
  intro ω_L h LHS_0 RHS_0 hRHS0_ne0 hPow0
  have hRHS0_pow_ne0 : RHS_0 ^ ℓ ≠ 0 := pow_ne_zero ℓ hRHS0_ne0
  have hLHS0_ne0 : LHS_0 ≠ 0 := by
    intro h0
    apply hRHS0_pow_ne0
    rw [← hPow0, h0, zero_pow hPrime.ne_zero]
  set L_val : Ω F := LHS_0 * (RHS_0)⁻¹
  have hLHS_eq_mul : LHS_0 = L_val * RHS_0 := by
    dsimp only [L_val]
    rw [mul_assoc, inv_mul_cancel₀ hRHS0_ne0, mul_one]
  have hL_ne0 : L_val ≠ 0 := mul_ne_zero hLHS0_ne0 (inv_ne_zero hRHS0_ne0)
  have hL_pow : L_val ^ ℓ = 1 := by
    dsimp only [L_val]
    rw [mul_pow, inv_pow, hPow0, mul_inv_cancel₀ hRHS0_pow_ne0]
  let u_L : (Ω F)ˣ := Units.mk0 L_val hL_ne0
  have hu_L_pow : u_L ^ ℓ = 1 := by
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, Units.val_mk0, Units.val_one, hL_pow]
  set D_Q := (Q - 1) / ℓ
  have hQ1_pos : 0 < Q - 1 := Nat.sub_pos_of_lt hQ_gt1
  have hDQ_mul : ℓ * D_Q = Q - 1 := Nat.mul_div_cancel' hdvd_Q
  have hDQ_mul' : D_Q * ℓ = Q - 1 := Nat.div_mul_cancel hdvd_Q
  have hDQ_ne0 : D_Q ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at hDQ_mul
    exact (Nat.ne_of_gt hQ1_pos) hDQ_mul.symm
  have hDQ_pos : 0 < D_Q := Nat.pos_of_ne_zero hDQ_ne0
  let ζ_ℓ : (Ω F)ˣ := (ω_M g_M) ^ D_Q
  have hord_ζ : orderOf ζ_ℓ = ℓ := by
    dsimp only [ζ_ℓ]
    rw [orderOf_pow_of_dvd hDQ_ne0 ⟨ℓ, by rw [hord_ωgM, ← hDQ_mul']⟩,
      hord_ωgM, ← hDQ_mul', Nat.mul_div_right ℓ hDQ_pos]
  obtain ⟨k₀, hk₀_lt, hk₀_eq⟩ := hRootExh ℓ hPrime.pos ζ_ℓ u_L hord_ζ hu_L_pow
  have hL_val_eq : L_val = Φ_Ω (P_Z ^ (D_Q * k₀)) := by
    have hval := congrArg Units.val hk₀_eq.symm
    dsimp only [u_L, ζ_ℓ] at hval
    rw [Units.val_mk0, Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val, ← pow_mul,
      ← hΦ_Ω_PZ, ← map_pow] at hval
    exact hval
  let u_ℓ : k_Lˣ := Units.mk0 (ℓ : k_L) hNeChar
  let u_ℓM : k_Mˣ := Units.map (algebraMap k_L k_M).toMonoidHom u_ℓ
  obtain ⟨m_ℓ, _hm_ℓ_lt, hm_ℓ_eq⟩ := hgen_M u_ℓM
  have hωL_uℓ : (((ω_L ^ a) u_ℓ : (Ω F)ˣ) : Ω F) = Φ_Ω (P_Z ^ (m_ℓ * a)) := by
    change (((ω_M u_ℓM) ^ a : (Ω F)ˣ) : Ω F) = Φ_Ω (P_Z ^ (m_ℓ * a))
    rw [← hm_ℓ_eq, map_pow, ← pow_mul, Units.val_pow_eq_pow_val, ← hΦ_Ω_PZ, ← map_pow]
  have hΦM_uℓ : Φ_M (P_Z ^ (m_ℓ * a)) = (ℓ : k_M) ^ a := by
    rw [map_pow, hΦ_M_PZ, pow_mul, ← Units.val_pow_eq_pow_val, hm_ℓ_eq]
    simp [u_ℓM, u_ℓ]
  set J := (Finset.range ℓ).erase 0
  set G_M : Ω F :=
    ∑ y : k_Mˣ, (((ω_M ^ a_star) y)⁻¹ : Ω F) * ψ_0L (Algebra.trace k_L k_M (y : k_M))
  set G_L : ℕ → Ω F := fun m =>
    ∑ x : k_Lˣ, (((ω_L ^ m) x)⁻¹ : Ω F) * ψ_0L (x : k_L)
  set s : ℕ → ℕ := fun m => (p.digits m).sum
  set F_fact : ℕ → k_M := fun m => (((p.digits m).map Nat.factorial).prod : k_M)
  have hJM_Ω : Φ_Ω (P_JM a_star) * G_M = (Φ_Ω P_1M) ^ (s a_star) * ϖ ^ (s a_star) := by
    have h1 := (hJM a_star ha_star_pos ha_star_lt).1
    rw [← mul_pow]
    exact h1
  have hJL_a_Ω : Φ_Ω (P_JL a) * G_L a = (Φ_Ω P_1L) ^ (s a) * ϖ ^ (s a) := by
    have h1 := (hJL a ha_pos ha_lt).1
    rw [← mul_pow]
    exact h1
  have hJL_prod_Ω :
      Φ_Ω (∏ j ∈ J, P_JL (j * h)) * (∏ j ∈ J, G_L (j * h)) =
        (Φ_Ω P_1L) ^ (∑ j ∈ J, s (j * h)) * ϖ ^ (∑ j ∈ J, s (j * h)) := by
    rw [map_prod, ← Finset.prod_mul_distrib, ← Finset.prod_pow_eq_pow_sum,
      ← Finset.prod_pow_eq_pow_sum, ← Finset.prod_mul_distrib]
    apply Finset.prod_congr rfl
    intro j hj
    have hj_b := hjh_bounds j hj
    have h1 := (hJL (j * h) hj_b.1 hj_b.2).1
    rw [← mul_pow]
    exact h1
  have hJL_all_Ω :
      (Φ_Ω (P_JL a) * G_L a) * (Φ_Ω (∏ j ∈ J, P_JL (j * h)) * (∏ j ∈ J, G_L (j * h))) =
        (Φ_Ω P_1L) ^ (s a_star) * ϖ ^ (s a_star) := by
    have h_sum_eq : s a + ∑ j ∈ J, s (j * h) = s a_star := hDigits_sum.symm
    calc (Φ_Ω (P_JL a) * G_L a) * (Φ_Ω (∏ j ∈ J, P_JL (j * h)) * (∏ j ∈ J, G_L (j * h)))
      _ = ((Φ_Ω P_1L) ^ (s a) * ϖ ^ (s a)) *
            ((Φ_Ω P_1L) ^ (∑ j ∈ J, s (j * h)) * ϖ ^ (∑ j ∈ J, s (j * h))) := by
          rw [hJL_a_Ω, hJL_prod_Ω]
      _ = ((Φ_Ω P_1L) ^ (s a) * (Φ_Ω P_1L) ^ (∑ j ∈ J, s (j * h))) *
            (ϖ ^ (s a) * ϖ ^ (∑ j ∈ J, s (j * h))) := by ring
      _ = (Φ_Ω P_1L) ^ (s a_star) * ϖ ^ (s a_star) := by
          rw [← pow_add, ← pow_add, h_sum_eq]
  set P_LHS : Polynomial ℤ :=
    (-1 : Polynomial ℤ) ^ (ℓ - 1) * P_1M ^ (s a_star) * P_JL a * (∏ j ∈ J, P_JL (j * h))
  set P_RHS : Polynomial ℤ :=
    P_Z ^ (D_Q * k₀) * P_Z ^ (m_ℓ * a) * P_1L ^ (s a_star) * P_JM a_star
  have hP_Ω_mul : Φ_Ω P_LHS * ϖ ^ (s a_star) = Φ_Ω P_RHS * ϖ ^ (s a_star) := by
    have hLHS_def : LHS_0 = (-1 : Ω F) ^ (ℓ - 1) * G_M := rfl
    have hRHS_def : RHS_0 = (((ω_L ^ a) u_ℓ : (Ω F)ˣ) : Ω F) * G_L a * (∏ j ∈ J, G_L (j * h)) := rfl
    calc Φ_Ω P_LHS * ϖ ^ (s a_star)
      _ = (-1 : Ω F) ^ (ℓ - 1) * ((Φ_Ω P_1M) ^ (s a_star) * ϖ ^ (s a_star)) *
            Φ_Ω (P_JL a) * Φ_Ω (∏ j ∈ J, P_JL (j * h)) := by
          dsimp only [P_LHS]
          simp only [map_mul, map_pow, map_neg, map_one]
          ring
      _ = (-1 : Ω F) ^ (ℓ - 1) * (Φ_Ω (P_JM a_star) * G_M) *
            Φ_Ω (P_JL a) * Φ_Ω (∏ j ∈ J, P_JL (j * h)) := by
          rw [← hJM_Ω]
      _ = Φ_Ω (P_JM a_star) * Φ_Ω (P_JL a) * Φ_Ω (∏ j ∈ J, P_JL (j * h)) * LHS_0 := by
          rw [hLHS_def]
          ring
      _ = Φ_Ω (P_JM a_star) * Φ_Ω (P_JL a) * Φ_Ω (∏ j ∈ J, P_JL (j * h)) *
            (L_val * RHS_0) := by
          rw [hLHS_eq_mul]
      _ = L_val * (((ω_L ^ a) u_ℓ : (Ω F)ˣ) : Ω F) *
            ((Φ_Ω (P_JL a) * G_L a) *
              (Φ_Ω (∏ j ∈ J, P_JL (j * h)) * (∏ j ∈ J, G_L (j * h)))) *
            Φ_Ω (P_JM a_star) := by
          rw [hRHS_def]
          ring
      _ = Φ_Ω (P_Z ^ (D_Q * k₀)) * Φ_Ω (P_Z ^ (m_ℓ * a)) *
            ((Φ_Ω P_1L) ^ (s a_star) * ϖ ^ (s a_star)) * Φ_Ω (P_JM a_star) := by
          rw [hL_val_eq, hωL_uℓ, hJL_all_Ω]
      _ = Φ_Ω P_RHS * ϖ ^ (s a_star) := by
          dsimp only [P_RHS]
          simp only [map_mul, map_pow]
          ring
  have hP_Ω_eq : Φ_Ω P_LHS = Φ_Ω P_RHS :=
    mul_right_cancel₀ (pow_ne_zero (s a_star) hϖ_ne0) hP_Ω_mul
  have hP_M_eq : Φ_M P_LHS = Φ_M P_RHS := hTransfer P_LHS P_RHS hP_Ω_eq
  have h_s_pos : ∀ m : ℕ, 0 < m → 1 ≤ s m := by
    intro m hm
    have hm_ne0 : m ≠ 0 := Nat.ne_of_gt hm
    have h_nil : p.digits m ≠ [] := Nat.digits_ne_nil_iff_ne_zero.mpr hm_ne0
    have h_last_pos : 1 ≤ (p.digits m).getLast h_nil :=
      Nat.pos_of_ne_zero (Nat.getLast_digit_ne_zero p hm_ne0)
    exact Nat.le_trans h_last_pos (List.le_sum_of_mem (List.getLast_mem h_nil))
  have hJ_card : J.card = ℓ - 1 := by
    dsimp only [J]
    rw [Finset.card_erase_of_mem (Finset.mem_range.mpr hPrime.pos), Finset.card_range]
  have h_prod_J_M :
      (-1 : k_M) ^ (ℓ - 1) * (∏ j ∈ J, Φ_M (P_JL (j * h))) =
        (-1 : k_M) ^ (∑ j ∈ J, s (j * h)) * (∏ j ∈ J, F_fact (j * h)) := by
    rw [← hJ_card, ← Finset.prod_const (-1 : k_M), ← Finset.prod_mul_distrib,
      ← Finset.prod_pow_eq_pow_sum, ← Finset.prod_mul_distrib]
    apply Finset.prod_congr rfl
    intro j hj
    have hj_b := hjh_bounds j hj
    have h_PJL_M := (hJL (j * h) hj_b.1 hj_b.2).2.1
    have h_sjh_pos : 1 ≤ s (j * h) := h_s_pos (j * h) hj_b.1
    rw [h_PJL_M, ← mul_assoc, ← pow_succ', Nat.sub_add_cancel h_sjh_pos]
  have h_sa_pos : 1 ≤ s a := h_s_pos a ha_pos
  have h_exp_sign : (s a - 1) + ∑ j ∈ J, s (j * h) = s a_star - 1 := by
    have h_sum : s a_star = s a + ∑ j ∈ J, s (j * h) := hDigits_sum
    omega
  have h_PJL_a_M : Φ_M (P_JL a) = (-1 : k_M) ^ (s a - 1) * F_fact a :=
    (hJL a ha_pos ha_lt).2.1
  have h_PJM_M : Φ_M (P_JM a_star) = (-1 : k_M) ^ (s a_star - 1) * F_fact a_star :=
    (hJM a_star ha_star_pos ha_star_lt).2.1
  have hkM_prod :
      (-1 : k_M) ^ (ℓ - 1) * Φ_M (P_JL a) * (∏ j ∈ J, Φ_M (P_JL (j * h))) =
        (ℓ : k_M) ^ a * Φ_M (P_JM a_star) := by
    calc (-1 : k_M) ^ (ℓ - 1) * Φ_M (P_JL a) * (∏ j ∈ J, Φ_M (P_JL (j * h)))
      _ = Φ_M (P_JL a) * ((-1 : k_M) ^ (ℓ - 1) * (∏ j ∈ J, Φ_M (P_JL (j * h)))) := by ring
      _ = ((-1 : k_M) ^ (s a - 1) * F_fact a) *
            ((-1 : k_M) ^ (∑ j ∈ J, s (j * h)) * (∏ j ∈ J, F_fact (j * h))) := by
          rw [h_PJL_a_M, h_prod_J_M]
      _ = ((-1 : k_M) ^ (s a - 1) * (-1 : k_M) ^ (∑ j ∈ J, s (j * h))) *
            (F_fact a * ∏ j ∈ J, F_fact (j * h)) := by ring
      _ = (-1 : k_M) ^ (s a_star - 1) * ((ℓ : k_M) ^ a * F_fact a_star) := by
          rw [← pow_add, h_exp_sign, ← hFact_eq]
      _ = (ℓ : k_M) ^ a * ((-1 : k_M) ^ (s a_star - 1) * F_fact a_star) := by ring
      _ = (ℓ : k_M) ^ a * Φ_M (P_JM a_star) := by rw [← h_PJM_M]
  set C : k_M := (-1 : k_M) ^ (s a_star) * ((ℓ : k_M) ^ a * Φ_M (P_JM a_star))
  have hLHS_M_eval : Φ_M P_LHS = 1 * C := by
    dsimp only [P_LHS, C]
    simp only [map_mul, map_pow, map_neg, map_one, map_prod, hP_1M]
    calc (-1 : k_M) ^ (ℓ - 1) * (-1 : k_M) ^ s a_star * Φ_M (P_JL a) *
          (∏ x ∈ J, Φ_M (P_JL (x * h)))
      _ = (-1 : k_M) ^ s a_star *
            ((-1 : k_M) ^ (ℓ - 1) * Φ_M (P_JL a) * (∏ x ∈ J, Φ_M (P_JL (x * h)))) := by ring
      _ = 1 * ((-1 : k_M) ^ s a_star * ((ℓ : k_M) ^ a * Φ_M (P_JM a_star))) := by
          rw [hkM_prod, one_mul]
  have hRHS_M_eval : Φ_M P_RHS = (g_M : k_M) ^ (D_Q * k₀) * C := by
    dsimp only [P_RHS, C]
    rw [map_mul, map_mul, map_mul, hΦM_uℓ, map_pow, hΦ_M_PZ, map_pow, hP_1L]
    ring
  have hC_ne0 : C ≠ 0 := by
    dsimp only [C]
    apply mul_ne_zero
    · exact pow_ne_zero (s a_star) (neg_ne_zero.mpr one_ne_zero)
    · apply mul_ne_zero
      · have hℓ_kM_ne0 : (ℓ : k_M) ≠ 0 := by
          rw [← map_natCast (algebraMap k_L k_M) ℓ]
          exact (map_ne_zero (algebraMap k_L k_M)).mpr hNeChar
        exact pow_ne_zero a hℓ_kM_ne0
      · exact (hJM a_star ha_star_pos ha_star_lt).2.2
  have hg_pow_val : (g_M : k_M) ^ (D_Q * k₀) = 1 := by
    apply mul_right_cancel₀ hC_ne0
    rw [← hRHS_M_eval, ← hLHS_M_eval, hP_M_eq]
  have hg_pow : g_M ^ (D_Q * k₀) = 1 := by
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, Units.val_one, hg_pow_val]
  have hdvd_k₀ : (Q - 1) ∣ (D_Q * k₀) := by
    rw [← hord_gM]
    exact orderOf_dvd_iff_pow_eq_one.mpr hg_pow
  have hlt_k₀ : D_Q * k₀ < Q - 1 := by
    rw [← hDQ_mul']
    exact Nat.mul_lt_mul_of_pos_left hk₀_lt hDQ_pos
  have hDQk₀_zero : D_Q * k₀ = 0 := Nat.eq_zero_of_dvd_of_lt hdvd_k₀ hlt_k₀
  have hL_one : L_val = 1 := by
    rw [hL_val_eq, hDQk₀_zero, pow_zero, map_one]
  rw [hLHS_eq_mul, hL_one, one_mul]

theorem ld_ch12_tame_finite_field_gauss_identity (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M] [CharP k_L (p F)] [CharP k_M (p F)]
    (ℓ : ℕ) (hPrime : Nat.Prime ℓ) (hTame : ℓ ≠ p F)
    (hfinrank : Module.finrank k_L k_M = ℓ)
    (hNeChar : (ℓ : k_L) ≠ 0)
    (ψ_k : AddChar k_L (Ω F)) (hψ_k : ψ_k ≠ 1)
    (ν_k χ_L : k_Lˣ →* (Ω F)ˣ) (χ_M : k_Mˣ →* (Ω F)ˣ)
    (hν_pow : ν_k ^ ℓ = 1) (hν_ne : ν_k ≠ 1)
    (hχM_pow : ∀ y : k_Mˣ,
      (χ_M y) ^ ℓ = χ_L (Units.map (Algebra.norm k_L (S := k_M)) y))
    (hχM_frob : χ_M ^ (Fintype.card k_L) ≠ χ_M)
    (hBridge :
      let p := p F
      let q := Fintype.card k_L
      let Q := Fintype.card k_M
      ∃ (f : ℕ) (g_M : k_Mˣ) (ω_M : k_Mˣ →* (Ω F)ˣ)
        (ψ_0L : AddChar k_L (Ω F)) (ϖ : Ω F)
