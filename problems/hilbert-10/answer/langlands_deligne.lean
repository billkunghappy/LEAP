      { toFun := fun f =>
          ⟨fun l => (f.1 l).1 1, fun k l => by
            let k_ML : H_ML := ⟨(k : G_L), (relWeil_antitone F hF't) k.2⟩
            let k_EM : H_EM := ⟨e_ML k_ML, k.2⟩
            have hf1 : (f.1 ((k_ML : G_L) * l)).1 1 = (f.1 l).1 (1 * e_ML k_ML) :=
              congr_fun (Subtype.ext_iff.mp (f.2 k_ML l)) 1
            have hf2 : (f.1 l).1 ((k_EM : G_M) * 1) = τ (e_EM k_EM) ((f.1 l).1 1) :=
              (f.1 l).2 k_EM 1
            have h1 : (1 : G_M) * e_ML k_ML = (k_EM : G_M) * 1 :=
              (one_mul (e_ML k_ML)).trans (mul_one (e_ML k_ML)).symm
            exact (hf1.trans (congr_arg (f.1 l).1 h1)).trans hf2⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl
        invFun := fun F₀ =>
          ⟨fun l =>
            ⟨fun m => F₀.1 (ι_ML m * l), fun k m => by
              let k_EL : H_EL := ⟨ι_ML (k : G_M), k.2⟩
              exact (congr_arg F₀.1 (mul_assoc (ι_ML (k : G_M)) (ι_ML m) l)).trans
                (F₀.2 k_EL (ι_ML m * l))⟩,
            fun m₀ l => Subtype.ext (funext fun m =>
              congr_arg F₀.1 (mul_assoc (ι_ML m) (m₀ : G_L) l).symm)⟩
        left_inv := fun f => Subtype.ext (funext fun l => Subtype.ext (funext fun m => by
          let m_ML : H_ML := ⟨ι_ML m, m.2⟩
          have hf : (f.1 ((m_ML : G_L) * l)).1 1 = (f.1 l).1 (1 * m) :=
            congr_fun (Subtype.ext_iff.mp (f.2 m_ML l)) 1
          exact hf.trans (congr_arg (f.1 l).1 (one_mul m))))
        right_inv := fun F₀ => Subtype.ext (funext fun l =>
          congr_arg F₀.1 (one_mul l)) }
