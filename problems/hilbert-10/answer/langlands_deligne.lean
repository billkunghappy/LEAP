  have h2k₀_dom := hL_dom hk₀2_ne h2k₀_ge
  have h2k₀_eq : -((1 + d) ^ 2) + 2 * (1 + d) = 2 * (1 + d) - (1 + d) ^ 2 := by ring
  rw [h2k₀_eq, hk₀2_val] at h2k₀_dom
  have h2k₀_ne : 2 * (1 + d) - (1 + d) ^ 2 ≠ 0 := h2k₀_dom.1
  have h2k₀_val : valL F L (2 * (1 + d) - (1 + d) ^ 2) = 0 := h2k₀_dom.2
  have hmain_h₀_ne : (2 * (1 + d) - (1 + d) ^ 2) * g ≠ 0 := mul_ne_zero h2k₀_ne hg_ne
  have hmain_h₀_val : valL F L ((2 * (1 + d) - (1 + d) ^ 2) * g) = 1 - 2 * (r : ℤ) := by
    rw [hval_mul _ _ h2k₀_ne hg_ne, h2k₀_val, hg_val, zero_add]
  have hE_ge : f + d ^ 2 * g = 0 ∨ (1 - 2 * (r : ℤ)) + 1 ≤ valL F L (f + d ^ 2 * g) :=
    hL_mono (by omega) hE_val
  have h4fg_ge : 4 * f * g = 0 ∨ (1 - 2 * (r : ℤ)) + 1 ≤ valL F L (4 * f * g) := by
    have h4f := hL_mul h4_ge (Or.inr (by rw [hf_val] : 1 - 2 * (a : ℤ) ≤ valL F L f))
    have h4fg := hL_mul h4f (Or.inr (by rw [hg_val] : 1 - 2 * (r : ℤ) ≤ valL F L g))
    exact hL_mono (by omega) h4fg
  have herr_h₀ : (f + d ^ 2 * g) + 4 * f * g = 0 ∨
      valL F L ((2 * (1 + d) - (1 + d) ^ 2) * g) + 1 ≤ valL F L ((f + d ^ 2 * g) + 4 * f * g) := by
    rw [hmain_h₀_val]
    exact hL_add hE_ge h4fg_ge
  have hh₀_dom := hL_dom hmain_h₀_ne herr_h₀
  have hh₀_eq : (2 * (1 + d) - (1 + d) ^ 2) * g + ((f + d ^ 2 * g) + 4 * f * g) =
      f + g + 4 * f * g := by ring
  rw [hh₀_eq, hmain_h₀_val] at hh₀_dom
  have hh₀_ne : f + g + 4 * f * g ≠ 0 := hh₀_dom.1
  have hh₀_val : valL F L (f + g + 4 * f * g) = 1 - 2 * (r : ℤ) := hh₀_dom.2
  have h2d_raw : 2 * d = 0 ∨ (r : ℤ) + ((r : ℤ) - (a : ℤ)) ≤ valL F L (2 * d) :=
    hL_mul h2_val (Or.inr (by rw [hd_val]))
  have h2d_ge_β₁ : 2 * d = 0 ∨ 2 * ((r : ℤ) - (a : ℤ)) + 1 ≤ valL F L (2 * d) :=
    hL_mono (by omega) h2d_raw
  have h4f_ge_β₁ : 4 * f = 0 ∨ 2 * ((r : ℤ) - (a : ℤ)) + 1 ≤ valL F L (4 * f) := by
    have h4f := hL_mul h4_ge (Or.inr (by rw [hf_val] : 1 - 2 * (a : ℤ) ≤ valL F L f))
    exact hL_mono (by omega) h4f
  have herr_β₁ : 2 * d - 4 * f = 0 ∨ valL F L (d ^ 2) + 1 ≤ valL F L (2 * d - 4 * f) := by
    rw [hd2_val]
    exact hL_sub h2d_ge_β₁ h4f_ge_β₁
  have hβ₁_dom := hL_dom hd2_ne herr_β₁
  have hβ₁_eq : d ^ 2 + (2 * d - 4 * f) = d ^ 2 + 2 * d - 4 * f := by ring
  rw [hβ₁_eq, hd2_val] at hβ₁_dom
  have hβ₁_ne : d ^ 2 + 2 * d - 4 * f ≠ 0 := hβ₁_dom.1
  have hβ₁_val : valL F L (d ^ 2 + 2 * d - 4 * f) = 2 * ((r : ℤ) - (a : ℤ)) := hβ₁_dom.2
  have h2d_ge_β₂ : 2 * d = 0 ∨ (1 : ℤ) ≤ valL F L (2 * d) :=
    hL_mono (by omega) h2d_raw
  have h4d2g_ge_β₂ : 4 * d ^ 2 * g = 0 ∨ (1 : ℤ) ≤ valL F L (4 * d ^ 2 * g) := by
    have h4d2 := hL_mul h4_ge (Or.inr (by rw [hd2_val] : 2 * ((r : ℤ) - (a : ℤ)) ≤ valL F L (d ^ 2)))
    have h4d2g := hL_mul h4d2 (Or.inr (by rw [hg_val] : 1 - 2 * (r : ℤ) ≤ valL F L g))
    exact hL_mono (by omega) h4d2g
  have herr_β₂ : 2 * d - 4 * d ^ 2 * g = 0 ∨ valL F L 1 + 1 ≤ valL F L (2 * d - 4 * d ^ 2 * g) := by
    rw [hval1, zero_add]
    exact hL_sub h2d_ge_β₂ h4d2g_ge_β₂
  have hβ₂_dom := hL_dom (one_ne_zero : (1 : L) ≠ 0) herr_β₂
  have hβ₂_eq : 1 + (2 * d - 4 * d ^ 2 * g) = 1 + 2 * d - 4 * d ^ 2 * g := by ring
  rw [hβ₂_eq, hval1] at hβ₂_dom
  have hβ₂_ne : 1 + 2 * d - 4 * d ^ 2 * g ≠ 0 := hβ₂_dom.1
  have hβ₂_val : valL F L (1 + 2 * d - 4 * d ^ 2 * g) = 0 := hβ₂_dom.2
  exact ⟨hk₀_ne, hh₀_ne, hβ₁_ne, hβ₂_ne, hk₀_val, hh₀_val, hβ₁_val, hβ₂_val⟩

theorem ld_ch12_wild_dyadic_even_breaks_frob_alignment_and_k0_unit (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'E'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * νE')), (νM₁' ^ j * νE') u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE') ∧
      condExp F L (νM₁' ^ j * νE') = condExp F L νE')
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_even : condExp F L νE' % 2 = 0)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hfrob_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧ (x - s ^ 2 = 0 ∨ 1 ≤ valL F L (x - s ^ 2)))
    (τ₁ : M₁' ≃ₐ[F] M₁') (σ₂ : E' ≃ₐ[F] E')
    (hτ₁_L : ∀ x : L, τ₁ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hτ₁_norm : ∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) = z * τ₁ z)
    (hσ₂_L : ∀ x : L, σ₂ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x)
    (hσ₂_norm : ∀ y : E', IntermediateField.inclusion hLE' (normLM F hLE' y) = y * σ₂ y)
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (hAS_coker : ((2 : ℕ) : k_L) = 0 →
      ∃ a₁ : k_L, ∀ c : k_L, ∃ (e₀ : Fin 2) (a : k_L),
        c = ((e₀ : ℕ) : k_L) * a₁ + (a ^ 2 + (1 : k_L) * a))
    (h2_val : (2 : L) = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L (2 : L))
    (x₀ : M₁') (y : E') (f₀ g : L)
    (hf₀_ne : f₀ ≠ 0) (hg_ne : g ≠ 0)
    (hf₀_val : valL F L f₀ = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hg_val : valL F L g = (1 - 2 * ((condExp F L νE' / 2 : ℕ) : ℤ)))
    (hy_sq : y ^ 2 + y = IntermediateField.inclusion hLE' g)
    (hy_conj : σ₂ y = -1 - y)
    (hPerturb : ∀ w : L, (w = 0 ∨ (1 - ((condExp F L νM₁' / 2 : ℕ) : ℤ)) ≤ valL F L w) →
      let x : M₁' := x₀ + IntermediateField.inclusion hLM₁' w * (1 + 2 * x₀)
      let f : L := f₀ + (w + w ^ 2) * (1 + 4 * f₀)
      valL F L f = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)) ∧
      x ^ 2 + x = IntermediateField.inclusion hLM₁' f ∧
      τ₁ x = -1 - x) :
    let a := condExp F L νM₁' / 2
    let r := condExp F L νE' / 2
    ∃ (w d : L),
      let f := f₀ + (w + w ^ 2) * (1 + 4 * f₀)
      let k₀ := 1 + d
      let E := f + d ^ 2 * g
      let h₀ := f + g + 4 * f * g
      let β₁ := d ^ 2 + 2 * d - 4 * f
      let β₂ := 1 + 2 * d - 4 * d ^ 2 * g
      (w = 0 ∨ (1 - (a : ℤ)) ≤ valL F L w) ∧
      d ≠ 0 ∧ k₀ ≠ 0 ∧ h₀ ≠ 0 ∧ β₁ ≠ 0 ∧ β₂ ≠ 0 ∧
      valL F L d = ((r : ℤ) - (a : ℤ)) ∧
      valL F L k₀ = 0 ∧
      (E = 0 ∨ (1 - (a : ℤ)) ≤ valL F L E) ∧
      valL F L h₀ = (1 - 2 * (r : ℤ)) ∧
      valL F L β₁ = 2 * ((r : ℤ) - (a : ℤ)) ∧
      valL F L β₂ = 0 :=
by
  intro a r
  have ha_ge1 : 1 ≤ a := Nat.div_le_div_right (c := 2) hbM₁'_ge2
  have hr_ge1 : 1 ≤ r := Nat.div_le_div_right (c := 2) hbE'_ge2
  have h0_lt : 0 < Module.finrank L (IntermediateField.extendScalars hLE') :=
    hdeg2.symm ▸ Nat.zero_lt_two
  have h1_lt : 1 < Module.finrank L (IntermediateField.extendScalars hLE') :=
    hdeg2.symm ▸ Nat.one_lt_two
  have hb_le : condExp F L νM₁' ≤ condExp F L νE' :=
    (hMinM₁' 0 h0_lt).2 ▸ (hMinM₁' 0 h0_lt).1
  have hr_ge_a : a ≤ r := Nat.div_le_div_right (c := 2) hb_le
  obtain ⟨w, d, hw_val, hd_ne, hd_val, hE_val⟩ :=
    ld_ch12_wild_dyadic_even_breaks_frob_alignment_inductive F L a r ha_ge1 hr_ge_a
      hvalL_props hfrob_surj h2_val f₀ g hf₀_ne hg_ne hf₀_val hg_val
  let x : M₁' := x₀ + IntermediateField.inclusion hLM₁' w * (1 + 2 * x₀)
  let f : L := f₀ + (w + w ^ 2) * (1 + 4 * f₀)
  obtain ⟨hf_val, hx_sq, hx_conj⟩ := hPerturb w hw_val
  have h_not_bad : a = r → ¬ (1 + d = 0 ∨ (1 : ℤ) ≤ valL F L (1 + d)) := by
    intro h_ar hk0_bad
    have hf_val_r : valL F L f = (1 - 2 * ((condExp F L νE' / 2 : ℕ) : ℤ)) := by
      change valL F L f = 1 - 2 * (r : ℤ)
      rw [← h_ar]
      exact hf_val
    have hE_val_r : f + d ^ 2 * g = 0 ∨
        (1 - ((condExp F L νE' / 2 : ℕ) : ℤ)) ≤ valL F L (f + d ^ 2 * g) := by
      change f + d ^ 2 * g = 0 ∨ (1 - (r : ℤ)) ≤ valL F L (f + d ^ 2 * g)
      rw [← h_ar]
      exact hE_val
    obtain ⟨hf_ne, htriv_2r, hsq_one, hAS_ker⟩ :=
      ld_ch12_wild_dyadic_even_breaks_equal_cond_as_norm_vanishing F L E' M₁' hLE' hLM₁'
        hdeg2 νE' νM₁' hνE'_ker hνE'_cond hνM₁'_ker hνM₁'E'_cond hbE'_ge2 hMinM₁' hT2_even
        hvalL_props τ₁ σ₂ hτ₁_L hτ₁_norm hσ₂_L hσ₂_norm h2_val
        x y f g d hg_ne hf_val_r hg_val hx_sq hx_conj hy_sq hy_conj hE_val_r hk0_bad
    have hcond_E' : condExp F L νE' = 2 * r :=
      (Nat.mul_div_cancel' (Nat.dvd_of_mod_eq_zero hT2_even)).symm
    have hcond_M₁' : condExp F L νM₁' = 2 * r :=
      h_ar ▸ (Nat.mul_div_cancel' (Nat.dvd_of_mod_eq_zero hT1_even)).symm
    have hcond_prod : condExp F L (νM₁' * νE') = 2 * r := by
      have h1 := (hMinM₁' 1 h1_lt).2
      rw [pow_one νM₁'] at h1
      exact h1.trans hcond_E'
    exact ld_ch12_wild_dyadic_even_breaks_as_coker_unit_filter_contradiction F L r hr_ge1
      νE' νM₁' hcond_M₁' hcond_E' hcond_prod htriv_2r hsq_one hvalL_props
      k_L resL hresL_1 hresL_ring hresL_ker hresL_surj hAS_coker h2_val
      f hf_ne hf_val_r hAS_ker
  obtain ⟨hk₀_ne, hh₀_ne, hβ₁_ne, hβ₂_ne, hk₀_val, hh₀_val, hβ₁_val, hβ₂_val⟩ :=
    ld_ch12_wild_dyadic_even_breaks_k0_h0_beta1_beta2_valuations F L a r ha_ge1 hr_ge_a
      hvalL_props h2_val f g d hg_ne hd_ne hf_val hg_val hd_val h_not_bad hE_val
  exact ⟨w, d, hw_val, hd_ne, hk₀_ne, hh₀_ne, hβ₁_ne, hβ₂_ne,
    hd_val, hk₀_val, hE_val, hh₀_val, hβ₁_val, hβ₂_val⟩

theorem ld_ch12_wild_dyadic_even_breaks_biquad_shift_table_and_Q1_factorization (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y))
    (hDiamond_M₁' : ∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z))
    (τ₁ : M₁' ≃ₐ[F] M₁') (σ₂ : E' ≃ₐ[F] E')
    (hτ₁_L : ∀ x : L, τ₁ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hτ₁_norm : ∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) = z * τ₁ z)
    (hσ₂_L : ∀ x : L, σ₂ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x)
    (hσ₂_norm : ∀ y : E', IntermediateField.inclusion hLE' (normLM F hLE' y) = y * σ₂ y)
    (x : M₁') (y : E') (f g d : L)
    (hx_tr : traceLM F hLM₁' x = -1)
    (hx_sq : x ^ 2 + x = IntermediateField.inclusion hLM₁' f)
    (hx_conj : τ₁ x = -1 - x)
    (hy_tr : traceLM F hLE' y = -1)
    (hy_norm : normLM F hLE' y = -g)
    (hy_sq : y ^ 2 + y = IntermediateField.inclusion hLE' g)
    (hy_conj : σ₂ y = -1 - y) :
    ∀ (c₀ c₁ : L),
      let k₀ := 1 + d
      let E := f + d ^ 2 * g
      let h₀ := f + g + 4 * f * g
      let Y : K₁ := IntermediateField.inclusion hM₁'K₁ x +
        IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' d * y)
      let z₃ : K₁ := IntermediateField.inclusion hM₁'K₁ x +
        IntermediateField.inclusion hE'K₁ y +
        2 * IntermediateField.inclusion hM₁'K₁ x * IntermediateField.inclusion hE'K₁ y
      let h₁ : M₁' := 2 * x - IntermediateField.inclusion hLM₁' d
      let h₂ : E' := 2 * IntermediateField.inclusion hLE' d * y - 1
      let β₁ : L := d ^ 2 + 2 * d - 4 * f
      let β₂ : L := 1 + 2 * d - 4 * d ^ 2 * g
      let a₁ : M₁' := IntermediateField.inclusion hLM₁' (f - d ^ 2 * g) -
        IntermediateField.inclusion hLM₁' k₀ * x
      let p_X := 2 * c₀ - c₁
      let A := c₀ ^ 2 - c₀ * c₁ - c₁ ^ 2 * h₀
      let X : K₁ := IntermediateField.inclusion (hLE'.trans hE'K₁) c₀ +
        IntermediateField.inclusion (hLE'.trans hE'K₁) c₁ * z₃
      let C : K₁ := Y - X
      let Q₁ : M₁' := IntermediateField.inclusion hLM₁' (c₀ * d + 2 * c₁ * d * g) +
        IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * (1 + d + 4 * d * g)) * x
      traceLM F hM₁'K₁ C = h₁ - IntermediateField.inclusion hLM₁' p_X ∧
      traceLM F hE'K₁ C = h₂ - IntermediateField.inclusion hLE' p_X ∧
      normLM F hM₁'K₁ C = a₁ + IntermediateField.inclusion hLM₁' A + Q₁ ∧
      normLM F hLM₁' h₁ = β₁ ∧
      normLM F hLE' h₂ = β₂ ∧
      normLM F hLM₁' Q₁ - β₁ * A = c₁ * (1 + 4 * f) * (1 + 4 * g) * (c₀ * d - c₁ * E) :=
by
  have hdeg2_M₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') = 2 :=
    hdegM₁'.trans hdeg2
  have hdeg2_E'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) = 2 :=
    hdegE'K₁.trans hdeg2
  have hdeg2_M₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) = 2 :=
    hdegM₁'K₁.trans hdeg2
  have hinc_E'K₁ : ∀ c : L,
      IntermediateField.inclusion (hLE'.trans hE'K₁) c =
        IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' c) :=
    fun _ => rfl
  have hinc_M₁'K₁ : ∀ c : L,
      IntermediateField.inclusion (hLE'.trans hE'K₁) c =
        IntermediateField.inclusion hM₁'K₁ (IntermediateField.inclusion hLM₁' c) :=
    fun _ => rfl
  have hinc_d :
      IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' d) =
        IntermediateField.inclusion hM₁'K₁ (IntermediateField.inclusion hLM₁' d) :=
    rfl
  have hnorm_M₁' : ∀ s₀ s₁ : L,
      normLM F hLM₁' (IntermediateField.inclusion hLM₁' s₀ +
        IntermediateField.inclusion hLM₁' s₁ * x) =
      s₀ ^ 2 - s₀ * s₁ - s₁ ^ 2 * f := by
    intro s₀ s₁
    apply (IntermediateField.inclusion hLM₁').injective
    change IntermediateField.inclusion hLM₁'
        (normLM F hLM₁' (IntermediateField.inclusion hLM₁' s₀ +
          IntermediateField.inclusion hLM₁' s₁ * x)) =
      IntermediateField.inclusion hLM₁' (s₀ ^ 2 - s₀ * s₁ - s₁ ^ 2 * f)
    rw [hτ₁_norm, map_add, map_mul, hτ₁_L s₀, hτ₁_L s₁, hx_conj,
      map_sub, map_sub, map_pow, map_mul, map_mul, map_pow]
    linear_combination - (IntermediateField.inclusion hLM₁' s₁) ^ 2 * hx_sq
  have hnorm_E' : ∀ t₀ t₁ : L,
      normLM F hLE' (IntermediateField.inclusion hLE' t₀ +
        IntermediateField.inclusion hLE' t₁ * y) =
      t₀ ^ 2 - t₀ * t₁ - t₁ ^ 2 * g := by
    intro t₀ t₁
    apply (IntermediateField.inclusion hLE').injective
    change IntermediateField.inclusion hLE'
        (normLM F hLE' (IntermediateField.inclusion hLE' t₀ +
          IntermediateField.inclusion hLE' t₁ * y)) =
      IntermediateField.inclusion hLE' (t₀ ^ 2 - t₀ * t₁ - t₁ ^ 2 * g)
    rw [hσ₂_norm, map_add, map_mul, hσ₂_L t₀, hσ₂_L t₁, hy_conj,
      map_sub, map_sub, map_pow, map_mul, map_mul, map_pow]
    linear_combination - (IntermediateField.inclusion hLE' t₁) ^ 2 * hy_sq
  have hQuadAff : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂] (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      ∀ (u v : M₀) (w : M₂),
        traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ u +
          IntermediateField.inclusion hM₀M₂ v * w) =
          (2 : M₀) * u + v * traceLM F hM₀M₂ w ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ u +
          IntermediateField.inclusion hM₀M₂ v * w) =
          u ^ 2 + u * (v * traceLM F hM₀M₂ w) + v ^ 2 * normLM F hM₀M₂ w := by
    intro M₀ M₂ _ _ hM₀M₂ hdeg u v w
    letI : Module M₀ M₀ := Semiring.toModule
    have htr_smul : traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ v * w) =
        v * traceLM F hM₀M₂ w :=
      (Algebra.trace M₀ (IntermediateField.extendScalars hM₀M₂)).map_smul' v
        (toExtendScalars F hM₀M₂ w)
    have hnorm_inc : normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ v) = v ^ 2 := by
      have halg : toExtendScalars F hM₀M₂ (IntermediateField.inclusion hM₀M₂ v) =
          algebraMap M₀ (IntermediateField.extendScalars hM₀M₂) v := rfl
      change Algebra.norm M₀ (toExtendScalars F hM₀M₂ (IntermediateField.inclusion hM₀M₂ v)) =
        v ^ 2
      rw [halg, Algebra.norm_algebraMap, hdeg]
    obtain ⟨htr_base, hnorm_add⟩ := hQuadNorm M₀ M₂ hM₀M₂ hdeg
    refine ⟨?_, ?_⟩
    · rw [map_add, htr_base u, htr_smul]
    · rw [(hnorm_add u (IntermediateField.inclusion hM₀M₂ v * w)).1,
        htr_smul, map_mul (normLM F hM₀M₂), hnorm_inc]
  intro c₀ c₁ k₀ E h₀ Y z₃ h₁ h₂ β₁ β₂ a₁ p_X A X C Q₁
  have hyK₁_tr : traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) = -1 := by
    rw [(hDiamond_E' y).2, hy_tr, map_neg, map_one]
  have hyK₁_norm : normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
      -IntermediateField.inclusion hLM₁' g := by
    rw [(hDiamond_E' y).1, hy_norm, map_neg]
  have hxK₁_tr : traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ x) = -1 := by
    rw [(hDiamond_M₁' x).2, hx_tr, map_neg, map_one]
  let U₁ : M₁' := (1 - IntermediateField.inclusion hLM₁' c₁) * x -
    IntermediateField.inclusion hLM₁' c₀
  let V₁ : M₁' := IntermediateField.inclusion hLM₁' d -
    IntermediateField.inclusion hLM₁' c₁ * (1 + 2 * x)
  have hC_M₁' : C = IntermediateField.inclusion hM₁'K₁ U₁ +
      IntermediateField.inclusion hM₁'K₁ V₁ * IntermediateField.inclusion hE'K₁ y := by
    change (IntermediateField.inclusion hM₁'K₁ x +
      IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' d * y)) -
      (IntermediateField.inclusion (hLE'.trans hE'K₁) c₀ +
        IntermediateField.inclusion (hLE'.trans hE'K₁) c₁ *
          (IntermediateField.inclusion hM₁'K₁ x + IntermediateField.inclusion hE'K₁ y +
            2 * IntermediateField.inclusion hM₁'K₁ x * IntermediateField.inclusion hE'K₁ y)) =
      IntermediateField.inclusion hM₁'K₁ U₁ +
        IntermediateField.inclusion hM₁'K₁ V₁ * IntermediateField.inclusion hE'K₁ y
    rw [map_mul (IntermediateField.inclusion hE'K₁), hinc_d, hinc_M₁'K₁ c₀, hinc_M₁'K₁ c₁]
    dsimp only [U₁, V₁]
    simp only [map_sub, map_add, map_mul, map_one, map_ofNat]
