    rw [Polynomial.coeff_expand hPrime.pos]
    by_cases hdvd : ℓ ∣ n
    · rw [if_pos hdvd, Polynomial.coeff_contract hPrime.ne_zero, Nat.div_mul_cancel hdvd]
    · rw [if_neg hdvd, (hσ_prod d P hP).1 n hdvd]
