      rw [← Nat.card_congr (Equiv.ofBijective f_mul ⟨hf_inj, hf_surj⟩), Nat.card_prod]
    let Z_H : Subgroup G₀ :=
      { carrier := {g : G₀ | g ∈ H ∧ ∀ c ∈ C, g * c = c * g}
        one_mem' := ⟨H.one_mem, fun c _ => by group⟩
        mul_mem' := fun {a b} ha hb => ⟨H.mul_mem ha.1 hb.1, fun c hc => by
          rw [mul_assoc, hb.2 c hc, ← mul_assoc, ha.2 c hc, mul_assoc]⟩
