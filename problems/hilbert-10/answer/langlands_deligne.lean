        have hmul := hval_mul_ge_M₁' ((p : ℤ) * valL F L (c i)) (((i : ℕ) : ℤ) + (t₁ : ℤ))
          (IntermediateField.inclusion hLM₁' (c i))
          ((τ π) ^ (i : ℕ) - π ^ (i : ℕ)) hinc_val hdiff_val
        rcases hmul with h0 | hge
        · exact Or.inl h0
        · right
          change m ≤ (p : ℤ) * valL F L (c i) + ((i : ℕ) : ℤ) at hci_ge
          omega

  let w₀ : K₁ := IntermediateField.inclusion hM₁'K₁ π
  have hw₀_ne0 : w₀ ≠ 0 := by
    intro h0
    exact hπ_ne0 ((IntermediateField.inclusion hM₁'K₁).injective
      (h0.trans (map_zero (IntermediateField.inclusion hM₁'K₁)).symm))
  have hw₀_val : valL F K₁ w₀ = (p : ℤ) := by
    dsimp [w₀]
    rw [hval_M₁'K₁ π, hϖ_M₁']
    change (p : ℤ) * 1 = (p : ℤ)
    ring
  have hτ_w₀_sub : τ_lift w₀ - w₀ = IntermediateField.inclusion hM₁'K₁ (τ π - π) := by
    dsimp [w₀]
    rw [hτ_M₁' π, ← map_sub]
  have hτ_w₀_ne0 : τ_lift w₀ - w₀ ≠ 0 := by
    rw [hτ_w₀_sub]
    intro h0
    exact hτ_pi_diff.1 ((IntermediateField.inclusion hM₁'K₁).injective
      (h0.trans (map_zero (IntermediateField.inclusion hM₁'K₁)).symm))
  have hτ_w₀_val : valL F K₁ (τ_lift w₀ - w₀) = (p : ℤ) * (bM₁' : ℤ) := by
    rw [hτ_w₀_sub, hval_M₁'K₁ (τ π - π), hτ_pi_diff.2]

  exact ⟨hval_sum_iff, hcoprime_E',
    ⟨τ, τ_lift, w₀, hτ_E', hτ_M₁', hτ_val, hτ_shift, hw₀_ne0, hw₀_val, hτ_w₀_ne0, hτ_w₀_val⟩⟩

theorem ld_ch12_wild_odd_tot_ram_as_delta_shift_unit_decomp (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hE'K₁ : E' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣ (bM₁' - 1)))
