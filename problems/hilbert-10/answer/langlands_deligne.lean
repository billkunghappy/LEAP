      rcases hR_ge with hR0 | hR_val
      · rw [hR_eq, neg_eq_zero] at hR0
        exact hU₀_ne hR0
      · rw [hR_eq, hval_neg_M₁', hU₀_val] at hR_val
        omega
    refine ⟨hA_ne, ?_⟩
    have hA_ge : -(h : ℤ) ≤ valL F L A_star := by
      have h1 : U₀ = 0 ∨ -(h : ℤ) ≤ valL F M₁' U₀ := Or.inr (by rw [hU₀_val])
      have h2 : R = 0 ∨ -(h : ℤ) ≤ valL F M₁' R := hmono_val_M₁' (by omega) hR_ge
      have hsum := hval_add_M₁' (-(h : ℤ)) U₀ R h1 h2
      rw [← hA_star_id] at hsum
      have hincl_A_ne : IntermediateField.inclusion hLM₁' A_star ≠ 0 :=
        (hincl_eq_zero A_star).not.mpr hA_ne
      have hge := hsum.resolve_left hincl_A_ne
      rwa [hval_LM₁' A_star] at hge
    have hA_le : valL F L A_star ≤ -(h : ℤ) := by
      by_contra hlt
      have h1 : IntermediateField.inclusion hLM₁' A_star = 0 ∨
          -(h : ℤ) + 1 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' A_star) := by
        right; rw [hval_LM₁' A_star]; omega
      have hU_id : U₀ = IntermediateField.inclusion hLM₁' A_star - R := by
        rw [hA_star_id]; ring
      have hU_ge := hsub_val_ge_M₁' (-(h : ℤ) + 1) _ R h1 hR_ge
      rw [← hU_id] at hU_ge
      have hU_ge' := hU_ge.resolve_left hU₀_ne
      rw [hU₀_val] at hU_ge'
      omega
    omega
  
  by_cases hA_star0 : A_star = 0
  · refine ⟨c_ν₀, 0, hc_ν₀_val, hc_ν₀_stat, ?_, ?_, ?_⟩
    · dsimp only
      rw [hnorm_E'_0, ← hA_star0]
      exact hU₀_approx
    · intro _
      exact Or.inl rfl
    · intro hh_pos
      exact False.elim ((hA_star_pos hh_pos).1 hA_star0)
  · obtain ⟨u₁, hu₁_mem, hu₁_ne1⟩ := hu₁_exists
    let u_Astar : Lˣ := Units.mk0 A_star hA_star0
    let ξ : (Ω F)ˣ := (νE' u_Astar)⁻¹
    have hξ_pow : ξ ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1 := by
      dsimp [ξ]
      rw [inv_pow]
      have h1 : (νE' u_Astar) ^ (Module.finrank L (IntermediateField.extendScalars hLE')) =
          (νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE'))) u_Astar := by
        rw [MonoidHom.pow_apply]
      rw [h1, hνE'_pow, MonoidHom.one_apply, inv_one]
    obtain ⟨k, _, hk_eq⟩ := hu₁_pow u₁ hu₁_ne1 ξ hξ_pow
    let u_t : Lˣ := u₁ ^ k
    let c_ν : Lˣ := c_ν₀ * u_t
    let u_A : Lˣ := u_t * u_Astar
    have hut_mem : u_t ∈ unitGroup F L (T - 1) :=
      Subgroup.pow_mem (unitGroup F L (T - 1)) hu₁_mem k
    have hut_inv_mem : u_t⁻¹ ∈ unitGroup F L (T - 1) :=
      Subgroup.inv_mem (unitGroup F L (T - 1)) hut_mem
    have hut_val0 : valL F L (u_t : L) = 0 :=
      hunit_val0_L (T - 1) u_t hut_mem
    have hut_sub : (u_t : L) - 1 = 0 ∨ ((T - 1 : ℕ) : ℤ) ≤ valL F L ((u_t : L) - 1) := by
      rcases (hunit_pos_iff_L (T - 1) hT_sub1_ge1 u_t).mp hut_mem with h1 | hge
      · left; rw [h1, sub_self]
      · exact Or.inr hge
    have hut_inv_sub : ((u_t⁻¹ : Lˣ) : L) - 1 = 0 ∨
        ((T - 1 : ℕ) : ℤ) ≤ valL F L (((u_t⁻¹ : Lˣ) : L) - 1) := by
      rcases (hunit_pos_iff_L (T - 1) hT_sub1_ge1 u_t⁻¹).mp hut_inv_mem with h1 | hge
      · left; rw [h1, sub_self]
      · exact Or.inr hge
    have hν_uA : νE' u_A = 1 := by
      change νE' (u₁ ^ k * u_Astar) = 1
      rw [map_mul, map_pow, hk_eq]
      exact inv_mul_cancel (νE' u_Astar)
    obtain ⟨x_u, hx_u⟩ := (hνE'_ker u_A).mpr hν_uA
    set x : E' := (x_u : E')
    have hx_ne : x ≠ 0 := Units.ne_zero x_u
    have hA_eq : normLM F hLE' x = (u_t : L) * A_star := by
      have h1 := congrArg Units.val hx_u
      exact h1
    refine ⟨c_ν, x, ?_, ?_, ?_, ?_, ?_⟩
    · change valL F L ((c_ν₀ : L) * (u_t : L)) = (T : ℤ) + n
      rw [hval_mul_L (c_ν₀ : L) (u_t : L) (Units.ne_zero c_ν₀) (Units.ne_zero u_t),
        hc_ν₀_val, hut_val0, add_zero]
    · intro u hu_val hu_ne
      rw [hc_ν₀_stat u hu_val hu_ne]
      have hinv_coe : ((c_ν⁻¹ : Lˣ) : L) = ((u_t⁻¹ : Lˣ) : L) * ((c_ν₀⁻¹ : Lˣ) : L) := by
        change (((c_ν₀ * u_t)⁻¹ : Lˣ) : L) = _
        rw [mul_inv_rev, Units.val_mul]
      set δ_u : L := ((c_ν₀⁻¹ : Lˣ) : L) * (((u_t⁻¹ : Lˣ) : L) - 1) * u
      have hsplit : ((c_ν⁻¹ : Lˣ) : L) * u = ((c_ν₀⁻¹ : Lˣ) : L) * u + δ_u := by
        rw [hinv_coe]
        dsimp [δ_u]
        ring
      have hδ_val : δ_u = 0 ∨ -n ≤ valL F L δ_u := by
        have h1 : ((c_ν₀⁻¹ : Lˣ) : L) = 0 ∨ -((T : ℤ) + n) ≤ valL F L (((c_ν₀⁻¹ : Lˣ) : L)) :=
          Or.inr (by rw [hc_ν₀_inv_val_L])
        have h12 := hmul_val_ge_L (-((T : ℤ) + n)) ((T - 1 : ℕ) : ℤ) _ _ h1 hut_inv_sub
        have h123 := hmul_val_ge_L (-((T : ℤ) + n) + ((T - 1 : ℕ) : ℤ)) (r_T : ℤ) _ u h12 hu_val
        exact hmono_val_L (by omega) h123
      have hψ_δ : ψ δ_u = 1 := (hcondChar_props L ψ hψ).1 δ_u hδ_val
      rw [hsplit, AddChar.map_add_eq_mul, hψ_δ, mul_one]
    · dsimp only
      set U₁ : M₁' := IntermediateField.inclusion hLM₁' (c_ν : L) * ((c_U⁻¹ : M₁'ˣ) : M₁')
      have hU₁_id : U₁ - (IntermediateField.inclusion hLM₁' (normLM F hLE' x) + d ^ 2) =
          IntermediateField.inclusion hLM₁' (u_t : L) *
            (U₀ - (IntermediateField.inclusion hLM₁' A_star + d ^ 2)) +
          IntermediateField.inclusion hLM₁' ((u_t : L) - 1) * d ^ 2 := by
        have hU₁_eq : U₁ = IntermediateField.inclusion hLM₁' (u_t : L) * U₀ := by
          change IntermediateField.inclusion hLM₁' ((c_ν₀ : L) * (u_t : L)) *
            ((c_U⁻¹ : M₁'ˣ) : M₁') = _
          rw [map_mul]
          dsimp [U₀]
          ring
        have hA_incl : IntermediateField.inclusion hLM₁' (normLM F hLE' x) =
            IntermediateField.inclusion hLM₁' (u_t : L) *
              IntermediateField.inclusion hLM₁' A_star := by
          rw [hA_eq, map_mul]
        have hsub1 : IntermediateField.inclusion hLM₁' ((u_t : L) - 1) =
            IntermediateField.inclusion hLM₁' (u_t : L) - 1 := by
          rw [map_sub, map_one]
        rw [hU₁_eq, hA_incl, hsub1]
        ring
      rw [hU₁_id]
      have hut_int_M₁' : IntermediateField.inclusion hLM₁' (u_t : L) = 0 ∨
          0 ≤ valL F M₁' (IntermediateField.inclusion hLM₁' (u_t : L)) :=
        Or.inr (by rw [hval_LM₁', hut_val0])
      have hterm1 : IntermediateField.inclusion hLM₁' (u_t : L) *
            (U₀ - (IntermediateField.inclusion hLM₁' A_star + d ^ 2)) = 0 ∨
          (T : ℤ) - (r_U : ℤ) ≤
            valL F M₁' (IntermediateField.inclusion hLM₁' (u_t : L) *
              (U₀ - (IntermediateField.inclusion hLM₁' A_star + d ^ 2))) := by
        rw [mul_comm]
        exact hmul_int_M₁' ((T : ℤ) - (r_U : ℤ)) _ _ hU₀_approx hut_int_M₁'
      have hut_sub_M₁' : IntermediateField.inclusion hLM₁' ((u_t : L) - 1) = 0 ∨
          (T : ℤ) - (r_U : ℤ) ≤
            valL F M₁' (IntermediateField.inclusion hLM₁' ((u_t : L) - 1)) := by
        rcases hut_sub with h0 | hge
        · left; rw [h0, map_zero]
        · right; rw [hval_LM₁']; omega
      have hterm2 : IntermediateField.inclusion hLM₁' ((u_t : L) - 1) * d ^ 2 = 0 ∨
          (T : ℤ) - (r_U : ℤ) ≤
            valL F M₁' (IntermediateField.inclusion hLM₁' ((u_t : L) - 1) * d ^ 2) :=
        hmul_int_M₁' ((T : ℤ) - (r_U : ℤ)) _ (d ^ 2) hut_sub_M₁' hd2_int
      exact hval_add_M₁' ((T : ℤ) - (r_U : ℤ)) _ _ hterm1 hterm2
    · intro hh0
      right
      have hval_A : valL F L (normLM F hLE' x) = valL F L A_star := by
        rw [hA_eq, hval_mul_L (u_t : L) A_star (Units.ne_zero u_t) hA_star0, hut_val0, zero_add]
      rw [← hval_norm_LE' x, hval_A]
      exact (hA_star_zero hh0).resolve_left hA_star0
    · intro hh_pos
      have hval_A : valL F L (normLM F hLE' x) = -(h : ℤ) := by
        rw [hA_eq, hval_mul_L (u_t : L) A_star (Units.ne_zero u_t) hA_star0,
          hut_val0, zero_add, (hA_star_pos hh_pos).2]
      refine ⟨hx_ne, ?_, hval_A⟩
      rw [← hval_norm_LE' x, hval_A]

theorem ld_ch12_wild_dyadic_power_basis_trace_and_u_frak_val (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    (hLE' : L ≤ E')
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (T mM₁' : ℕ) (hT_ge2 : 2 ≤ T) (hT_le : T ≤ mM₁')
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (htr_bound_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨ 2 * m - (T : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (ϖ_E' : E'ˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLE') ϖ_E' = ϖ_L)
    (hϖ_E' : valL F E' (ϖ_E' : E') = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hBasis : ∀ y : E', ∃ c_fn : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
        IntermediateField.inclusion hLE' (c_fn i) * ((ϖ_E' : E') ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F E' y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
            c_fn i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) *
                valL F L (c_fn i) + (i : ℤ))
    (y_tr1 : E') (hy_tr1_ne : y_tr1 ≠ 0)
    (hy_tr1_tr : traceLM F hLE' y_tr1 = 1)
    (hy_tr1_val : valL F E' y_tr1 = 1 - (T : ℤ))
    (x : E')
    (hx_zero : mM₁' - T = 0 → (x = 0 ∨ 0 ≤ valL F E' x))
    (hx_pos : 0 < mM₁' - T → x ≠ 0 ∧ valL F E' x = -((mM₁' - T : ℕ) : ℤ)) :
    let h := mM₁' - T
    let A := normLM F hLE' x
    let b := traceLM F hLE' x
    let u_frak : L := if h = 0 then (4 : L) else b ^ 2 * A⁻¹
    (b = 0 ∨ (T : ℤ) - (((mM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F L b) ∧
    ((2 : L) = 0 ∨ ((T / 2 : ℕ) : ℤ) ≤ valL F L (2 : L)) ∧
    (mM₁' % 2 = 0 → (u_frak = 0 ∨ (T : ℤ) ≤ valL F L u_frak)) ∧
    (mM₁' % 2 = 1 → u_frak ≠ 0 ∧ valL F L u_frak = (T : ℤ) - 1) ∧
    (h = 0 → (4 * A - b ^ 2 = 0 ∨ (T : ℤ) ≤ valL F L (4 * A - b ^ 2))) :=
by
  intro h A b u_frak
  set d_T := T / 2
  set r_T := (T + 1) / 2
  set r_U := (mM₁' + 1) / 2
  set t_ϖ := traceLM F hLE' (ϖ_E' : E')
  
  obtain ⟨hvalL_0, hvalL_1, _, hvalL_neg, hvalL_mul, hvalL_inv, _, hvalL_add, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨_, hvalE'_1, _, _, _, _, _, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F E'
  have hvalL_mono : ∀ {k₁ k₂ : ℤ} {z : L}, k₁ ≤ k₂ →
      (z = 0 ∨ k₂ ≤ valL F L z) → (z = 0 ∨ k₁ ≤ valL F L z) := by
    intro k₁ k₂ z hk hz
    rcases hz with rfl | hz
    · exact Or.inl rfl
    · exact Or.inr (le_trans hk hz)
  have hvalL_sub : ∀ (k : ℤ) (z₁ z₂ : L),
      (z₁ = 0 ∨ k ≤ valL F L z₁) → (z₂ = 0 ∨ k ≤ valL F L z₂) →
      (z₁ - z₂ = 0 ∨ k ≤ valL F L (z₁ - z₂)) := by
    intro k z₁ z₂ hz₁ hz₂
    rw [sub_eq_add_neg]
    apply hvalL_add k z₁ (-z₂) hz₁
    rcases hz₂ with rfl | hz₂
    · left; exact neg_zero
    · right; rwa [hvalL_neg]
  have hvalL_mul_ge : ∀ (k₁ k₂ : ℤ) (z₁ z₂ : L),
      (z₁ = 0 ∨ k₁ ≤ valL F L z₁) → (z₂ = 0 ∨ k₂ ≤ valL F L z₂) →
      (z₁ * z₂ = 0 ∨ k₁ + k₂ ≤ valL F L (z₁ * z₂)) := by
    intro k₁ k₂ z₁ z₂ hz₁ hz₂
    by_cases hz₁0 : z₁ = 0
    · left; rw [hz₁0, zero_mul]
    · by_cases hz₂0 : z₂ = 0
      · left; rw [hz₂0, mul_zero]
      · right
        have hk₁ : k₁ ≤ valL F L z₁ := hz₁.resolve_left hz₁0
        have hk₂ : k₂ ≤ valL F L z₂ := hz₂.resolve_left hz₂0
        rw [hvalL_mul z₁ z₂ hz₁0 hz₂0]
        omega
  have hvalL_inv0 : ∀ (z : L) (hz : z ≠ 0), valL F L (z⁻¹) = - valL F L z := by
    intro z hz
    have hinv := hvalL_inv (Units.mk0 z hz)
    rwa [Units.val_inv_eq_inv_val] at hinv
  have hvalL_add_eq_left : ∀ (k : ℤ) (z₁ z₂ : L),
      z₁ ≠ 0 → valL F L z₁ = k → (z₂ = 0 ∨ k + 1 ≤ valL F L z₂) →
      z₁ + z₂ ≠ 0 ∧ valL F L (z₁ + z₂) = k := by
    intro k z₁ z₂ hz₁_ne hz₁_val hz₂
    have hge : z₁ + z₂ = 0 ∨ k ≤ valL F L (z₁ + z₂) :=
      hvalL_add k z₁ z₂ (Or.inr (le_of_eq hz₁_val.symm)) (hvalL_mono (by omega) hz₂)
    have hnot : ¬ (z₁ + z₂ = 0 ∨ k + 1 ≤ valL F L (z₁ + z₂)) := by
      intro hsum
      have hsub := hvalL_sub (k + 1) (z₁ + z₂) z₂ hsum hz₂
      rw [add_sub_cancel_right] at hsub
      rcases hsub with h0 | hle
      · exact hz₁_ne h0
      · omega
    have hne : z₁ + z₂ ≠ 0 := fun h0 => hnot (Or.inl h0)
    have hk_le : k ≤ valL F L (z₁ + z₂) := hge.resolve_left hne
    have hnot_le : ¬ (k + 1 ≤ valL F L (z₁ + z₂)) := fun hle => hnot (Or.inr hle)
    exact ⟨hne, by omega⟩
  
  obtain ⟨htr_incl, hnorm_quad⟩ := hQuadNorm L E' hLE' hdeg2
  have htr_smul : ∀ (a : L) (y : E'),
      traceLM F hLE' (IntermediateField.inclusion hLE' a * y) = a * traceLM F hLE' y := by
    intro a y
    letI : Module L L := Semiring.toModule
    exact (Algebra.trace L (IntermediateField.extendScalars hLE')).map_smul' a
      (toExtendScalars F hLE' y)
  have hnorm_E'_0 : normLM F hLE' 0 = 0 := by
    have h1 := (hnorm_quad 1 0).1
    rw [map_one, add_zero, map_one, map_zero] at h1
    linear_combination -h1
  have hnorm_incl : ∀ a : L, normLM F hLE' (IntermediateField.inclusion hLE' a) = a ^ 2 := by
    intro a
    have h1 := (hnorm_quad a 0).1
    rw [add_zero, map_zero, hnorm_E'_0, mul_zero, add_zero, add_zero] at h1
    exact h1
  have hϖ_norm_coe : normLM F hLE' (ϖ_E' : E') = (ϖ_L : L) :=
    congrArg Units.val hϖ_norm
  
  have h2_val : (2 : L) = 0 ∨ (d_T : ℤ) ≤ valL F L (2 : L) := by
    have htr1 : traceLM F hLE' (1 : E') = (2 : L) := by
      rw [← map_one (IntermediateField.inclusion hLE'), htr_incl 1, mul_one]
    rw [← htr1]
    exact htr_bound_LE' (d_T : ℤ) 1 (Or.inr (by rw [hvalE'_1]; omega))
  have ht_ϖ_val : t_ϖ = 0 ∨ (r_T : ℤ) ≤ valL F L t_ϖ := by
    exact htr_bound_LE' (r_T : ℤ) (ϖ_E' : E') (Or.inr (by rw [hϖ_E']; omega))
  have hb_val : b = 0 ∨ (T : ℤ) - (r_U : ℤ) ≤ valL F L b := by
    have hx_ge : x = 0 ∨ 2 * ((T : ℤ) - (r_U : ℤ)) - (T : ℤ) ≤ valL F E' x := by
      by_cases hh0 : h = 0
      · rcases hx_zero hh0 with rfl | hx0
        · exact Or.inl rfl
        · exact Or.inr (by omega)
      · have hx_val := (hx_pos (by omega)).2
        exact Or.inr (by omega)
    exact htr_bound_LE' ((T : ℤ) - (r_U : ℤ)) x hx_ge
  
  have hBasis2 : ∀ y : E', ∃ (c₀ c₁ : L),
      y = IntermediateField.inclusion hLE' c₀ +
        IntermediateField.inclusion hLE' c₁ * (ϖ_E' : E') ∧
      traceLM F hLE' y = (2 : L) * c₀ + c₁ * t_ϖ ∧
      normLM F hLE' y = c₀ ^ 2 + c₀ * (c₁ * t_ϖ) + c₁ ^ 2 * (ϖ_L : L) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F E' y) ↔
          (c₀ = 0 ∨ m ≤ 2 * valL F L c₀) ∧
          (c₁ = 0 ∨ m ≤ 2 * valL F L c₁ + 1) := by
    intro y
    have hB := hBasis y
    rw [hdeg2] at hB
    rcases hB with ⟨c_fn, hy_eq, hy_iff⟩
    have hy_eq' : y = IntermediateField.inclusion hLE' (c_fn 0) +
        IntermediateField.inclusion hLE' (c_fn 1) * (ϖ_E' : E') := by
      rw [Fin.sum_univ_two] at hy_eq
      simpa [pow_zero, pow_one, mul_one] using hy_eq
    refine ⟨c_fn 0, c_fn 1, hy_eq', ?_, ?_, ?_⟩
    · rw [hy_eq', map_add, htr_incl, htr_smul]
    · rw [hy_eq', (hnorm_quad (c_fn 0) (IntermediateField.inclusion hLE' (c_fn 1) * (ϖ_E' : E'))).1,
        htr_smul, map_mul (normLM F hLE'), hnorm_incl, hϖ_norm_coe]
    · intro m
      rw [hy_iff m, Fin.forall_fin_two]
      simp
  
  have hdisc_zero : h = 0 → (4 * A - b ^ 2 = 0 ∨ (T : ℤ) ≤ valL F L (4 * A - b ^ 2)) := by
    intro hh0
    obtain ⟨c₀, c₁, _, hx_tr, hx_norm, hx_iff⟩ := hBasis2 x
    have hpoly : 4 * A - b ^ 2 =
        (c₁ * c₁) * (((2 : L) * (2 : L)) * (ϖ_L : L) - t_ϖ * t_ϖ) := by
      change 4 * normLM F hLE' x - (traceLM F hLE' x) ^ 2 = _
      rw [hx_norm, hx_tr]
      ring
    have hc₁_int : c₁ = 0 ∨ 0 ≤ valL F L c₁ := by
      have hc₁_ge := ((hx_iff 0).mp (hx_zero hh0)).2
      rcases hc₁_ge with rfl | hle
      · exact Or.inl rfl
      · exact Or.inr (by omega)
    have hc₁_sq : c₁ * c₁ = 0 ∨ 0 ≤ valL F L (c₁ * c₁) := by
      simpa using hvalL_mul_ge 0 0 c₁ c₁ hc₁_int hc₁_int
    have h4ϖ_val : ((2 : L) * (2 : L)) * (ϖ_L : L) = 0 ∨
        (T : ℤ) ≤ valL F L (((2 : L) * (2 : L)) * (ϖ_L : L)) := by
      have h4 := hvalL_mul_ge (d_T : ℤ) (d_T : ℤ) (2 : L) (2 : L) h2_val h2_val
      have h4ϖ := hvalL_mul_ge ((d_T : ℤ) + (d_T : ℤ)) 1 ((2 : L) * (2 : L)) (ϖ_L : L) h4
        (Or.inr (le_of_eq hϖ_L.symm))
      exact hvalL_mono (by omega) h4ϖ
    have ht2_val : t_ϖ * t_ϖ = 0 ∨ (T : ℤ) ≤ valL F L (t_ϖ * t_ϖ) := by
      have ht2 := hvalL_mul_ge (r_T : ℤ) (r_T : ℤ) t_ϖ t_ϖ ht_ϖ_val ht_ϖ_val
      exact hvalL_mono (by omega) ht2
    have hdiff := hvalL_sub (T : ℤ) (((2 : L) * (2 : L)) * (ϖ_L : L)) (t_ϖ * t_ϖ) h4ϖ_val ht2_val
    have hprod := hvalL_mul_ge 0 (T : ℤ) (c₁ * c₁)
      (((2 : L) * (2 : L)) * (ϖ_L : L) - t_ϖ * t_ϖ) hc₁_sq hdiff
    rw [zero_add] at hprod
    rwa [hpoly]
  
  have hu_even : mM₁' % 2 = 0 → (u_frak = 0 ∨ (T : ℤ) ≤ valL F L u_frak) := by
    intro hm_even
    by_cases hh0 : h = 0
    · have hu_eq : u_frak = (2 : L) * (2 : L) := by
        change (if h = 0 then (4 : L) else b ^ 2 * A⁻¹) = _
        rw [if_pos hh0]
        ring
      rw [hu_eq]
      have h4 := hvalL_mul_ge (d_T : ℤ) (d_T : ℤ) (2 : L) (2 : L) h2_val h2_val
      exact hvalL_mono (by omega) h4
    · have hu_eq : u_frak = (b * b) * A⁻¹ := by
        change (if h = 0 then (4 : L) else b ^ 2 * A⁻¹) = _
        rw [if_neg hh0, sq]
      have hx_p := hx_pos (by omega)
      have hA_val : valL F L A = -(h : ℤ) := by
        change valL F L (normLM F hLE' x) = -(h : ℤ)
        rw [hval_norm_LE', hx_p.2]
      have hA_ne : A ≠ 0 := by
        intro h0
        rw [h0, hvalL_0] at hA_val
        omega
      have hA_inv_val : valL F L (A⁻¹) = (h : ℤ) := by
        rw [hvalL_inv0 A hA_ne, hA_val, neg_neg]
      have hb2 := hvalL_mul_ge ((T : ℤ) - (r_U : ℤ)) ((T : ℤ) - (r_U : ℤ)) b b hb_val hb_val
      have hprod := hvalL_mul_ge (((T : ℤ) - (r_U : ℤ)) + ((T : ℤ) - (r_U : ℤ))) (h : ℤ)
        (b * b) (A⁻¹) hb2 (Or.inr (le_of_eq hA_inv_val.symm))
      rw [hu_eq]
      exact hvalL_mono (by omega) hprod
  
  have hBasis_even : ∀ (y : E') (c₀ c₁ : L),
      (∀ m : ℤ, (y = 0 ∨ m ≤ valL F E' y) ↔
        (c₀ = 0 ∨ m ≤ 2 * valL F L c₀) ∧ (c₁ = 0 ∨ m ≤ 2 * valL F L c₁ + 1)) →
      ∀ (k : ℤ), y ≠ 0 → valL F E' y = 2 * k →
      c₀ ≠ 0 ∧ valL F L c₀ = k ∧ (c₁ = 0 ∨ k ≤ valL F L c₁) := by
    intro y c₀ c₁ hy_iff k hy_ne hy_val
    obtain ⟨hc₀_ge, hc₁_ge⟩ := (hy_iff (2 * k)).mp (Or.inr (le_of_eq hy_val.symm))
    have hc₁_k : c₁ = 0 ∨ k ≤ valL F L c₁ := by
      rcases hc₁_ge with rfl | hle
      · exact Or.inl rfl
      · exact Or.inr (by omega)
    have hc₁_succ : c₁ = 0 ∨ 2 * k + 1 ≤ 2 * valL F L c₁ + 1 := by
      rcases hc₁_ge with rfl | hle
      · exact Or.inl rfl
      · exact Or.inr (by omega)
    have hy_not : ¬ (y = 0 ∨ 2 * k + 1 ≤ valL F E' y) := by
      rintro (h0 | hle)
      · exact hy_ne h0
      · omega
    have hc₀_not : ¬ (c₀ = 0 ∨ 2 * k + 1 ≤ 2 * valL F L c₀) := by
      intro hc₀_s
      exact hy_not ((hy_iff (2 * k + 1)).mpr ⟨hc₀_s, hc₁_succ⟩)
    have hc₀_ne : c₀ ≠ 0 := fun h0 => hc₀_not (Or.inl h0)
    have hc₀_le : 2 * k ≤ 2 * valL F L c₀ := hc₀_ge.resolve_left hc₀_ne
    have hc₀_nle : ¬ (2 * k + 1 ≤ 2 * valL F L c₀) := fun hle => hc₀_not (Or.inr hle)
    exact ⟨hc₀_ne, by omega, hc₁_k⟩
  have hBasis_odd : ∀ (y : E') (c₀ c₁ : L),
      (∀ m : ℤ, (y = 0 ∨ m ≤ valL F E' y) ↔
        (c₀ = 0 ∨ m ≤ 2 * valL F L c₀) ∧ (c₁ = 0 ∨ m ≤ 2 * valL F L c₁ + 1)) →
      ∀ (k : ℤ), y ≠ 0 → valL F E' y = 2 * k + 1 →
      c₁ ≠ 0 ∧ valL F L c₁ = k ∧ (c₀ = 0 ∨ k + 1 ≤ valL F L c₀) := by
    intro y c₀ c₁ hy_iff k hy_ne hy_val
    obtain ⟨hc₀_ge, hc₁_ge⟩ := (hy_iff (2 * k + 1)).mp (Or.inr (le_of_eq hy_val.symm))
    have hc₀_k1 : c₀ = 0 ∨ k + 1 ≤ valL F L c₀ := by
      rcases hc₀_ge with rfl | hle
      · exact Or.inl rfl
      · exact Or.inr (by omega)
    have hc₀_succ : c₀ = 0 ∨ 2 * k + 2 ≤ 2 * valL F L c₀ := by
      rcases hc₀_ge with rfl | hle
      · exact Or.inl rfl
      · exact Or.inr (by omega)
    have hy_not : ¬ (y = 0 ∨ 2 * k + 2 ≤ valL F E' y) := by
      rintro (h0 | hle)
      · exact hy_ne h0
      · omega
    have hc₁_not : ¬ (c₁ = 0 ∨ 2 * k + 2 ≤ 2 * valL F L c₁ + 1) := by
      intro hc₁_s
      exact hy_not ((hy_iff (2 * k + 2)).mpr ⟨hc₀_succ, hc₁_s⟩)
    have hc₁_ne : c₁ ≠ 0 := fun h0 => hc₁_not (Or.inl h0)
    have hc₁_le : 2 * k + 1 ≤ 2 * valL F L c₁ + 1 := hc₁_ge.resolve_left hc₁_ne
    have hc₁_nle : ¬ (2 * k + 2 ≤ 2 * valL F L c₁ + 1) := fun hle => hc₁_not (Or.inr hle)
    exact ⟨hc₁_ne, by omega, hc₀_k1⟩
  
  obtain ⟨a₀, a₁, _, hy1_tr, _, hy1_iff⟩ := hBasis2 y_tr1
  rw [hy_tr1_tr] at hy1_tr
  have h2_odd : T % 2 = 1 → (2 : L) ≠ 0 ∧ valL F L (2 : L) = (d_T : ℤ) := by
    intro hT_odd
    have hy1_val_even : valL F E' y_tr1 = 2 * (-(d_T : ℤ)) := by
      rw [hy_tr1_val]; omega
    obtain ⟨ha₀_ne, ha₀_val, ha₁_ge⟩ :=
      hBasis_even y_tr1 a₀ a₁ hy1_iff (-(d_T : ℤ)) hy_tr1_ne hy1_val_even
    have ha₁t_ge : -(a₁ * t_ϖ) = 0 ∨ 0 + 1 ≤ valL F L (-(a₁ * t_ϖ)) := by
      have hm := hvalL_mul_ge (-(d_T : ℤ)) (r_T : ℤ) a₁ t_ϖ ha₁_ge ht_ϖ_val
      have hm' : a₁ * t_ϖ = 0 ∨ 0 + 1 ≤ valL F L (a₁ * t_ϖ) := hvalL_mono (by omega) hm
      rcases hm' with h0 | hle
      · left; rw [h0, neg_zero]
      · right; rwa [hvalL_neg]
    have h2a₀_eq : (2 : L) * a₀ = 1 + (-(a₁ * t_ϖ)) := by
      linear_combination hy1_tr.symm
    obtain ⟨h2a₀_ne, h2a₀_val⟩ :=
      hvalL_add_eq_left 0 1 (-(a₁ * t_ϖ)) one_ne_zero hvalL_1 ha₁t_ge
    rw [← h2a₀_eq] at h2a₀_ne h2a₀_val
    have h2_ne : (2 : L) ≠ 0 := left_ne_zero_of_mul h2a₀_ne
    rw [hvalL_mul (2 : L) a₀ h2_ne ha₀_ne, ha₀_val] at h2a₀_val
    exact ⟨h2_ne, by omega⟩
  have ht_ϖ_even : T % 2 = 0 → t_ϖ ≠ 0 ∧ valL F L t_ϖ = (d_T : ℤ) := by
    intro hT_even
    have hy1_val_odd : valL F E' y_tr1 = 2 * (-(d_T : ℤ)) + 1 := by
      rw [hy_tr1_val]; omega
    obtain ⟨ha₁_ne, ha₁_val, ha₀_ge⟩ :=
      hBasis_odd y_tr1 a₀ a₁ hy1_iff (-(d_T : ℤ)) hy_tr1_ne hy1_val_odd
    have h2a₀_ge : -((2 : L) * a₀) = 0 ∨ 0 + 1 ≤ valL F L (-((2 : L) * a₀)) := by
      have hm := hvalL_mul_ge (d_T : ℤ) (-(d_T : ℤ) + 1) (2 : L) a₀ h2_val ha₀_ge
      have hm' : (2 : L) * a₀ = 0 ∨ 0 + 1 ≤ valL F L ((2 : L) * a₀) := hvalL_mono (by omega) hm
      rcases hm' with h0 | hle
      · left; rw [h0, neg_zero]
      · right; rwa [hvalL_neg]
    have ha₁t_eq : a₁ * t_ϖ = 1 + (-((2 : L) * a₀)) := by
      linear_combination hy1_tr.symm
    obtain ⟨ha₁t_ne, ha₁t_val⟩ :=
      hvalL_add_eq_left 0 1 (-((2 : L) * a₀)) one_ne_zero hvalL_1 h2a₀_ge
    rw [← ha₁t_eq] at ha₁t_ne ha₁t_val
    have ht_ne : t_ϖ ≠ 0 := right_ne_zero_of_mul ha₁t_ne
    rw [hvalL_mul a₁ t_ϖ ha₁_ne ht_ne, ha₁_val] at ha₁t_val
    exact ⟨ht_ne, by omega⟩
  
  have hu_odd : mM₁' % 2 = 1 → u_frak ≠ 0 ∧ valL F L u_frak = (T : ℤ) - 1 := by
    intro hm_odd
    by_cases hh0 : h = 0
    · have hu_eq : u_frak = (2 : L) * (2 : L) := by
        change (if h = 0 then (4 : L) else b ^ 2 * A⁻¹) = _
        rw [if_pos hh0]
        ring
      obtain ⟨h2_ne, h2_val_eq⟩ := h2_odd (by omega)
      rw [hu_eq]
      refine ⟨mul_ne_zero h2_ne h2_ne, ?_⟩
      rw [hvalL_mul (2 : L) (2 : L) h2_ne h2_ne, h2_val_eq]
      omega
    · have hu_eq : u_frak = (b * b) * A⁻¹ := by
        change (if h = 0 then (4 : L) else b ^ 2 * A⁻¹) = _
        rw [if_neg hh0, sq]
      obtain ⟨hx_ne, hx_val⟩ := hx_pos (by omega)
      obtain ⟨c₀, c₁, _, hx_tr, _, hx_iff⟩ := hBasis2 x
      have hA_val : valL F L A = -(h : ℤ) := by
        change valL F L (normLM F hLE' x) = -(h : ℤ)
        rw [hval_norm_LE', hx_val]
      have hA_ne : A ≠ 0 := by
        intro h0
        rw [h0, hvalL_0] at hA_val
        omega
      have hA_inv_ne : A⁻¹ ≠ 0 := inv_ne_zero hA_ne
      have hA_inv_val : valL F L (A⁻¹) = (h : ℤ) := by
        rw [hvalL_inv0 A hA_ne, hA_val, neg_neg]
      have hb_exact : b ≠ 0 ∧ valL F L b = (T : ℤ) - (r_U : ℤ) := by
        by_cases hh_even : h % 2 = 0
        · obtain ⟨h2_ne, h2_val_eq⟩ := h2_odd (by omega)
          set k : ℤ := -((h / 2 : ℕ) : ℤ)
          have hx_val_even : valL F E' x = 2 * k := by
            rw [hx_val]; omega
          obtain ⟨hc₀_ne, hc₀_val, hc₁_ge⟩ :=
            hBasis_even x c₀ c₁ hx_iff k hx_ne hx_val_even
          have h2c₀_ne : (2 : L) * c₀ ≠ 0 := mul_ne_zero h2_ne hc₀_ne
          have h2c₀_val : valL F L ((2 : L) * c₀) = (T : ℤ) - (r_U : ℤ) := by
            rw [hvalL_mul (2 : L) c₀ h2_ne hc₀_ne, h2_val_eq, hc₀_val]
            omega
          have hc₁t_ge : c₁ * t_ϖ = 0 ∨ ((T : ℤ) - (r_U : ℤ)) + 1 ≤ valL F L (c₁ * t_ϖ) := by
            have hm := hvalL_mul_ge k (r_T : ℤ) c₁ t_ϖ hc₁_ge ht_ϖ_val
            exact hvalL_mono (by omega) hm
          have hb_eq : b = (2 : L) * c₀ + c₁ * t_ϖ := hx_tr
          rw [hb_eq]
          exact hvalL_add_eq_left ((T : ℤ) - (r_U : ℤ)) ((2 : L) * c₀) (c₁ * t_ϖ)
            h2c₀_ne h2c₀_val hc₁t_ge
        · obtain ⟨ht_ne, ht_val_eq⟩ := ht_ϖ_even (by omega)
          set k : ℤ := -(((h + 1) / 2 : ℕ) : ℤ)
          have hx_val_odd : valL F E' x = 2 * k + 1 := by
            rw [hx_val]; omega
          obtain ⟨hc₁_ne, hc₁_val, hc₀_ge⟩ :=
            hBasis_odd x c₀ c₁ hx_iff k hx_ne hx_val_odd
          have hc₁t_ne : c₁ * t_ϖ ≠ 0 := mul_ne_zero hc₁_ne ht_ne
          have hc₁t_val : valL F L (c₁ * t_ϖ) = (T : ℤ) - (r_U : ℤ) := by
            rw [hvalL_mul c₁ t_ϖ hc₁_ne ht_ne, hc₁_val, ht_val_eq]
            omega
          have h2c₀_ge : (2 : L) * c₀ = 0 ∨ ((T : ℤ) - (r_U : ℤ)) + 1 ≤ valL F L ((2 : L) * c₀) := by
            have hm := hvalL_mul_ge (d_T : ℤ) (k + 1) (2 : L) c₀ h2_val hc₀_ge
            exact hvalL_mono (by omega) hm
          have hb_eq : b = c₁ * t_ϖ + (2 : L) * c₀ := by
            change traceLM F hLE' x = _
            rw [hx_tr, add_comm]
          rw [hb_eq]
          exact hvalL_add_eq_left ((T : ℤ) - (r_U : ℤ)) (c₁ * t_ϖ) ((2 : L) * c₀)
            hc₁t_ne hc₁t_val h2c₀_ge
      obtain ⟨hb_ne, hb_val_eq⟩ := hb_exact
      have hb2_ne : b * b ≠ 0 := mul_ne_zero hb_ne hb_ne
      have hb2_val : valL F L (b * b) = ((T : ℤ) - (r_U : ℤ)) + ((T : ℤ) - (r_U : ℤ)) := by
        rw [hvalL_mul b b hb_ne hb_ne, hb_val_eq]
      rw [hu_eq]
      refine ⟨mul_ne_zero hb2_ne hA_inv_ne, ?_⟩
      rw [hvalL_mul (b * b) (A⁻¹) hb2_ne hA_inv_ne, hb2_val, hA_inv_val]
      omega
  exact ⟨hb_val, h2_val, hu_even, hu_odd, hdisc_zero⟩

theorem ld_ch12_wild_dyadic_unramified_k1_norm_and_cM1_stat (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (T : ℕ) (hT_ge2 : 2 ≤ T)
    (θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hT_le : T ≤ condExp F M₁' θM₁')
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) = condExpChar F L ψ)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = 2 * valL F K₁ w)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y))
    (hDiamond_M₁' : ∀ z : M₁',
      normLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (normLM F hLM₁' z) ∧
      traceLM F hE'K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hLE' (traceLM F hLM₁' z))
    (d : M₁') (c : L)
    (hd_val : valL F M₁' d = 0)
    (hd_tr : traceLM F hLM₁' d = 1) (hd_norm : normLM F hLM₁' d = -c)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (c_U : M₁'ˣ)
    (hc_U_val : valL F M₁' (c_U : M₁') =
      (condExp F M₁' θM₁' : ℤ) + condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hc_U_stat : ∀ z : M₁',
      (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (((c_U⁻¹ : M₁'ˣ) : M₁') * z))
    (c_ν : Lˣ) (x : E')
    (hc_ν_val : valL F L (c_ν : L) = (T : ℤ) + condExpChar F L ψ)
    (hU₁_approx :
      let U₁ := IntermediateField.inclusion hLM₁' (c_ν : L) * ((c_U⁻¹ : M₁'ˣ) : M₁')
      U₁ - (IntermediateField.inclusion hLM₁' (normLM F hLE' x) + d ^ 2) = 0 ∨
        (T : ℤ) - (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤
          valL F M₁' (U₁ - (IntermediateField.inclusion hLM₁' (normLM F hLE' x) + d ^ 2)))
    (hb_val : traceLM F hLE' x = 0 ∨
      (T : ℤ) - (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F L (traceLM F hLE' x)) :
    let mM₁' := condExp F M₁' θM₁'
    let h := mM₁' - T
    let ψM₁' := traceChar F hLM₁' ψ
    let A := normLM F hLE' x
    let b := traceLM F hLE' x
    ∃ (C : K₁ˣ) (cM₁' : M₁'ˣ),
      (C : K₁) = IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d ∧
      cM₁' = (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom c_ν) *
        (Units.map (normLM F hM₁'K₁) C)⁻¹ ∧
      ((Units.map (normLM F hM₁'K₁) C : M₁'ˣ) : M₁') =
