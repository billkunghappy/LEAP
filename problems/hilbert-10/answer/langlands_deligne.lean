    have hidx : (i : ℤ) + ((p - 1 - 1 - i : ℕ) : ℤ) = ((p - 2 : ℕ) : ℤ) := by omega
    rw [hidx]
  set u_K₁ := IntermediateField.inclusion hM₁'K₁ u_M₁'
  have hu_L_ne0 : u ≠ 0 := mul_ne_zero (Units.ne_zero α) (Units.ne_zero γ⁻¹)
  have hu_L_val : valL F L u = ((m_exp : ℕ) : ℤ) := by
    dsimp [u, m_exp]
    rw [hval_mul_L (α : L) ((γ⁻¹ : Lˣ) : L) (Units.ne_zero α) (Units.ne_zero γ⁻¹),
