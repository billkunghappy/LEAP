        rw [hval_χ]
        omega
      let Δ_i : F_i := (((c'_θ i)⁻¹ : F_iˣ) : F_i) -
        ((((c'_μ i)⁻¹ : F_iˣ) : F_i) + (((c'_χ'_Fi i)⁻¹ : F_iˣ) : F_i))
      have hdiff_eq : (((c'_θ i)⁻¹ : F_iˣ) : F_i) - (((c'_μ i)⁻¹ : F_iˣ) : F_i) =
          Δ_i + (((c'_χ'_Fi i)⁻¹ : F_iˣ) : F_i) := by
        dsimp [Δ_i]
        ring
      have hdiff_val :
          (((c'_θ i)⁻¹ : F_iˣ) : F_i) - (((c'_μ i)⁻¹ : F_iˣ) : F_i) = 0 ∨
            -((t : ℤ) + n_Fi) ≤ valL F F_i ((((c'_θ i)⁻¹ : F_iˣ) : F_i) - (((c'_μ i)⁻¹ : F_iˣ) : F_i)) := by
        rw [hdiff_eq]
        exact hval_add_Fi (-((t : ℤ) + n_Fi)) Δ_i (((c'_χ'_Fi i)⁻¹ : F_iˣ) : F_i) hΔ_val (Or.inr hχ_inv_val)
      exact hunit_from_inv_diff i t (c'_μ i) hc_θ_val hdiff_val
    · have hm₀_eq : max t (k * (a - 1)) = k * (a - 1) := max_eq_right (by omega)
      have h1 := (hFi_ultrametric i).1
      rw [hm₀_eq] at h1
      exact h1
    · set F_i := (D_orb.get i).field
      haveI : FiniteDimensional F F_i := hFinFi i
      set ψ_Fi := traceChar F (D_orb.get i).le ψ
      set n_Fi := condExpChar F F_i ψ_Fi
      obtain ⟨_, _, _, _, _, hval_inv_Fi, _, hval_add_Fi, _, _, _⟩ := hval_all F_i
      have hm₀_eq : max t (k * (a - 1)) = k * (a - 1) := max_eq_right (by omega)
      obtain ⟨hc_i_eq, hΔ_val⟩ := hFi_ultrametric i
      rw [hm₀_eq] at hc_i_eq hΔ_val
      have hc_θ_val : valL F F_i (c'_θ i : F_i) = ((k * (a - 1) + 1 : ℕ) : ℤ) + n_Fi := by
        rw [(hc_orb i).2.2.2.2.1, hc_i_eq]
      have hμ_inv_val : -(((k * (a - 1) : ℕ) : ℤ) + n_Fi) ≤ valL F F_i (((c'_μ i)⁻¹ : F_iˣ) : F_i) := by
        rw [hval_inv_Fi (c'_μ i)]
        have hval_μ := (hc_orb i).2.2.1
        change valL F F_i (c'_μ i : F_i) = (condExp F F_i (μ'_orb i) : ℤ) + n_Fi at hval_μ
        rw [hval_μ, (hFi_ram i).1]
        omega
      let Δ_i : F_i := (((c'_θ i)⁻¹ : F_iˣ) : F_i) -
        ((((c'_μ i)⁻¹ : F_iˣ) : F_i) + (((c'_χ'_Fi i)⁻¹ : F_iˣ) : F_i))
      have hdiff_eq : (((c'_θ i)⁻¹ : F_iˣ) : F_i) - (((c'_χ'_Fi i)⁻¹ : F_iˣ) : F_i) =
          Δ_i + (((c'_μ i)⁻¹ : F_iˣ) : F_i) := by
        dsimp [Δ_i]
        ring
      have hdiff_val :
          (((c'_θ i)⁻¹ : F_iˣ) : F_i) - (((c'_χ'_Fi i)⁻¹ : F_iˣ) : F_i) = 0 ∨
            -(((k * (a - 1) : ℕ) : ℤ) + n_Fi) ≤
              valL F F_i ((((c'_θ i)⁻¹ : F_iˣ) : F_i) - (((c'_χ'_Fi i)⁻¹ : F_iˣ) : F_i)) := by
        rw [hdiff_eq]
        exact hval_add_Fi (-(((k * (a - 1) : ℕ) : ℤ) + n_Fi)) Δ_i (((c'_μ i)⁻¹ : F_iˣ) : F_i)
          hΔ_val (Or.inr hμ_inv_val)
      exact hunit_from_inv_diff i (k * (a - 1)) (c'_χ'_Fi i) hc_θ_val hdiff_val

  dsimp only
  set q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  set a := condExp F L χ'
  set χ'_E := χ'.comp (Units.map (normLM F hLE))
  set a_E := condExp F E χ'_E
  set c₀ : Lˣ := ϖ_L ^ (1 + condExpChar F L ψ)
  set u_χ' : Lˣ := (ϖ_L ^ (a - 1) * c₀)⁻¹ * c'_χ'
  set u_E_norm : Lˣ :=
    (ϖ_L ^ (a_E - 1))⁻¹ * c₀⁻¹ * c'_χ' *
      (∏ i : Fin D_orb.length,
        Units.map (normLM F (D_orb.get i).le) (c'_θ i * (c'_μ i)⁻¹))
  let θ_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ :=
    fun i => μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, _,
    hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩ := hval_all L

  have hval_pow_L : ∀ (u : Lˣ) (n : ℕ),
      valL F L (((u ^ n : Lˣ) : L)) = (n : ℤ) * valL F L (u : L) := by
    intro u n
    induction n with
    | zero => rw [pow_zero, Units.val_one, hval1_L, Nat.cast_zero, zero_mul]
    | succ n ih =>
      rw [pow_succ', Units.val_mul, hval_mul_L (u : L) _ (Units.ne_zero u) (Units.ne_zero _), ih]
      push_cast
      ring

  have hval_zpow_L : ∀ (u : Lˣ) (m : ℤ),
      valL F L (((u ^ m : Lˣ) : L)) = m * valL F L (u : L) := by
    intro u m
    cases m with
    | ofNat n =>
      change valL F L (((u ^ n : Lˣ) : L)) = (n : ℤ) * valL F L (u : L)
      exact hval_pow_L u n
    | negSucc n =>
      change valL F L ((((u ^ (n + 1))⁻¹ : Lˣ) : L)) = (Int.negSucc n) * valL F L (u : L)
      rw [hval_inv_L, hval_pow_L u (n + 1), Int.negSucc_eq]
      push_cast
      ring

  have hval_prod_L : ∀ {ι : Type} (S : Finset ι) (g : ι → Lˣ),
      valL F L (((∏ x ∈ S, g x : Lˣ) : L)) = ∑ x ∈ S, valL F L (g x : L) := by
    intro ι S g
    induction S using Finset.induction_on with
    | empty => rw [Finset.prod_empty, Finset.sum_empty, Units.val_one, hval1_L]
    | @insert x s hx ih =>
      rw [Finset.prod_insert hx, Finset.sum_insert hx, Units.val_mul,
        hval_mul_L (g x : L) _ (Units.ne_zero (g x)) (Units.ne_zero _), ih]

  let K_MC := IntermediateField.extendScalars hM_CK
  let e_K_MC : K ≃ₐ[F] K_MC :=
    { toExtendScalars F hM_CK with
       invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hM_CK).mp y.2⟩
       left_inv := fun _ => rfl
       right_inv := fun _ => rfl
       commutes' := fun _ => rfl }
  haveI : FiniteDimensional F K_MC := Module.Finite.equiv e_K_MC.toLinearEquiv
  haveI : IsScalarTower F M_C K_MC := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional M_C K_MC := Module.Finite.of_restrictScalars_finite F M_C K_MC
  have hq_pos : 1 ≤ q := Module.finrank_pos

  have hresL_ne0 : (resDeg F L : ℤ) ≠ 0 := by
    intro h0
    have h1 := hϖ_L
    unfold valL at h1
    rw [h0, Int.ediv_zero] at h1
    exact one_ne_zero h1.symm

  let f_orb : Fin D_orb.length → ℕ := fun i => ((hFi_ram i).2.2.2.2.2.2.2).choose
  have hf_orb_spec : ∀ i : Fin D_orb.length,
      1 ≤ f_orb i ∧
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_orb i ∧
      resDeg F (D_orb.get i).field = f_orb i * resDeg F L ∧
      (∀ x : (D_orb.get i).field,
        valL F L (normLM F (D_orb.get i).le x) =
          (f_orb i : ℤ) * valL F (D_orb.get i).field x) :=
    fun i => ((hFi_ram i).2.2.2.2.2.2.2).choose_spec

  have hsum_f_mul : k * (∑ i : Fin D_orb.length, f_orb i) = q - 1 := by
    rw [Finset.mul_sum, ← hDegSum]
    exact Finset.sum_congr rfl fun i _ => ((hf_orb_spec i).2.1).symm

  have hsum_f : (∑ i : Fin D_orb.length, f_orb i) = (q - 1) / k := by
    have h1 : k * (∑ i : Fin D_orb.length, f_orb i) = k * ((q - 1) / k) := by
      rw [hsum_f_mul, Nat.mul_div_cancel' hk_dvd]
    exact Nat.eq_of_mul_eq_mul_left hk_ge1 h1

  have hsum_f_int : (∑ i : Fin D_orb.length, (f_orb i : ℤ)) = (((q - 1) / k : ℕ) : ℤ) := by
    exact_mod_cast hsum_f

  have hExpBal_red :
      (a_E : ℤ) + ∑ i : Fin D_orb.length, ((t + 1 : ℕ) : ℤ) * (f_orb i : ℤ) =
        (a : ℤ) + ∑ i : Fin D_orb.length,
          (condExp F (D_orb.get i).field (θ_orb i) : ℤ) * (f_orb i : ℤ) := by
    let S_char : ℤ := ∑ i : Fin D_orb.length,
      2 * condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) *
        (resDeg F (D_orb.get i).field : ℤ)
    let S_μ : ℤ := ∑ i : Fin D_orb.length,
      (condExp F (D_orb.get i).field (μ'_orb i) : ℤ) * (resDeg F (D_orb.get i).field : ℤ)
    let S_θ : ℤ := ∑ i : Fin D_orb.length,
      (condExp F (D_orb.get i).field (θ_orb i) : ℤ) * (resDeg F (D_orb.get i).field : ℤ)
    have hsum_lhs :
        (∑ i : Fin D_orb.length,
          (2 * condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) +
            (condExp F (D_orb.get i).field (μ'_orb i) : ℤ)) *
            (resDeg F (D_orb.get i).field : ℤ)) = S_char + S_μ := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun i _ => add_mul _ _ _
    have hsum_rhs :
        (∑ i : Fin D_orb.length,
          (2 * condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) +
            (condExp F (D_orb.get i).field (θ_orb i) : ℤ)) *
            (resDeg F (D_orb.get i).field : ℤ)) = S_char + S_θ := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun i _ => add_mul _ _ _
    have hbal1 := hExpBal
    rw [hsum_lhs, hsum_rhs, hresE] at hbal1
    have hbal2 : (a_E : ℤ) * (resDeg F L : ℤ) + S_μ = (a : ℤ) * (resDeg F L : ℤ) + S_θ := by
      linarith
    have hS_μ_eq : S_μ =
        (∑ i : Fin D_orb.length, ((t + 1 : ℕ) : ℤ) * (f_orb i : ℤ)) * (resDeg F L : ℤ) := by
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [(hFi_ram i).1, (hf_orb_spec i).2.2.1]
      push_cast
      ring
    have hS_θ_eq : S_θ =
        (∑ i : Fin D_orb.length, (condExp F (D_orb.get i).field (θ_orb i) : ℤ) * (f_orb i : ℤ)) *
          (resDeg F L : ℤ) := by
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [(hf_orb_spec i).2.2.1]
      push_cast
      ring
    rw [hS_μ_eq, hS_θ_eq, ← add_mul, ← add_mul] at hbal2
    exact mul_right_cancel₀ hresL_ne0 hbal2

  refine ⟨fun hle => ?_, fun hlt => ?_⟩
  · obtain ⟨hθ_cond, hθ_sub⟩ := hFi_regimes.1 hle
    refine ⟨hθ_cond, ?_, hθ_sub⟩
    have hsum_eq :
        (∑ i : Fin D_orb.length,
          (condExp F (D_orb.get i).field (θ_orb i) : ℤ) * (f_orb i : ℤ)) =
        ∑ i : Fin D_orb.length, ((t + 1 : ℕ) : ℤ) * (f_orb i : ℤ) := by
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [hθ_cond i]
    rw [hsum_eq] at hExpBal_red
    have ha_eq_int : (a_E : ℤ) = (a : ℤ) := by linarith
    exact_mod_cast ha_eq_int
  · obtain ⟨hθ_cond, hθ_unit⟩ := hFi_regimes.2 hlt
    set u_div : ℕ := (q - 1) / k
    have hsum_μ :
        (∑ i : Fin D_orb.length, ((t + 1 : ℕ) : ℤ) * (f_orb i : ℤ)) =
          ((t + 1 : ℕ) : ℤ) * (u_div : ℤ) := by
      rw [← Finset.mul_sum, hsum_f_int]
    have hsum_θ :
        (∑ i : Fin D_orb.length,
          (condExp F (D_orb.get i).field (θ_orb i) : ℤ) * (f_orb i : ℤ)) =
          ((k * (a - 1) + 1 : ℕ) : ℤ) * (u_div : ℤ) := by
      have hcongr :
          (∑ i : Fin D_orb.length,
            (condExp F (D_orb.get i).field (θ_orb i) : ℤ) * (f_orb i : ℤ)) =
          ∑ i : Fin D_orb.length, ((k * (a - 1) + 1 : ℕ) : ℤ) * (f_orb i : ℤ) := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [hθ_cond i]
      rw [hcongr, ← Finset.mul_sum, hsum_f_int]
    rw [hsum_μ, hsum_θ] at hExpBal_red
    have hmul_div : k * u_div = q - 1 := Nat.mul_div_cancel' hk_dvd
    have hmul_div_int : (k : ℤ) * (u_div : ℤ) = ((q - 1 : ℕ) : ℤ) := by
      exact_mod_cast hmul_div
    have h_ut_le : u_div * t ≤ q * (a - 1) := by
      calc u_div * t ≤ u_div * (k * (a - 1)) :=
            Nat.mul_le_mul_left _ (by omega)
        _ = (k * u_div) * (a - 1) := by ring
        _ = (q - 1) * (a - 1) := by rw [hmul_div]
        _ ≤ q * (a - 1) := Nat.mul_le_mul_right _ (by omega)
    have ha_E_int :
        (a_E : ℤ) = ((q * (a - 1) - u_div * t + 1 : ℕ) : ℤ) := by
      have h1 :
          ((k * (a - 1) + 1 : ℕ) : ℤ) * (u_div : ℤ) =
            ((k : ℤ) * (u_div : ℤ)) * ((a - 1 : ℕ) : ℤ) + (u_div : ℤ) := by
        have hcast : ((k * (a - 1) + 1 : ℕ) : ℤ) = (k : ℤ) * ((a - 1 : ℕ) : ℤ) + 1 := by
          simp [Nat.cast_mul]
        rw [hcast]
        ring
      have h2 : ((t + 1 : ℕ) : ℤ) * (u_div : ℤ) = (t : ℤ) * (u_div : ℤ) + (u_div : ℤ) := by
        have hcast : ((t + 1 : ℕ) : ℤ) = (t : ℤ) + 1 := by simp
        rw [hcast]
        ring
      rw [h1, h2, hmul_div_int] at hExpBal_red
      have hq_sub : ((q - 1 : ℕ) : ℤ) = (q : ℤ) - 1 := by omega
      have ha_sub : ((a - 1 : ℕ) : ℤ) = (a : ℤ) - 1 := by omega
      have hrhs_cast :
          ((q * (a - 1) - u_div * t + 1 : ℕ) : ℤ) =
            (q : ℤ) * ((a - 1 : ℕ) : ℤ) - (u_div : ℤ) * (t : ℤ) + 1 := by
        omega
      rw [hrhs_cast, ha_sub]
      rw [hq_sub, ha_sub] at hExpBal_red
      linear_combination hExpBal_red
    have ha_E_eq : a_E = q * (a - 1) - ((q - 1) / k) * t + 1 := by
      exact_mod_cast ha_E_int
    refine ⟨hθ_cond, ha_E_eq, hθ_unit, ?_⟩
    let c'_χ'_Fi : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ :=
      fun i => Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c'_χ'
    let u_θ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ :=
      fun i => c'_θ i * (c'_χ'_Fi i)⁻¹
    have hc'_θ_eq : ∀ i : Fin D_orb.length, c'_θ i = c'_χ'_Fi i * u_θ i := by
      intro i
      dsimp [u_θ]
      rw [mul_comm (c'_θ i), mul_inv_cancel_left]
    let U_θ : Lˣ := ∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (u_θ i)
    have hU_θ_mem : U_θ ∈ unitGroup F L 1 :=
      Subgroup.prod_mem _ fun i _ => hNormFilt i 1 le_rfl (u_θ i) (hθ_unit i)
    have hU_θ_val0 : valL F L (U_θ : L) = 0 := hunit_val0_L 1 U_θ hU_θ_mem
    have hnorm_unit_inc_LFi : ∀ (i : Fin D_orb.length) (u : Lˣ),
        Units.map (normLM F (D_orb.get i).le)
          (Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom u) =
          u ^ (Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) := by
      intro i u
      let F_i_L := IntermediateField.extendScalars (D_orb.get i).le
      apply Units.ext
      change Algebra.norm L (algebraMap L F_i_L (u : L)) =
        (u : L) ^ (Module.finrank L F_i_L)
      exact Algebra.norm_algebraMap (u : L)
    have hprod_ratio :
        (∏ i : Fin D_orb.length,
          Units.map (normLM F (D_orb.get i).le) (c'_θ i * (c'_μ i)⁻¹)) =
        (c'_χ' ^ (q - 1)) *
          (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_μ i))⁻¹ *
          U_θ := by
      have hcongr :
          (∏ i : Fin D_orb.length,
            Units.map (normLM F (D_orb.get i).le) (c'_θ i * (c'_μ i)⁻¹)) =
          ∏ i : Fin D_orb.length,
            ((c'_χ' ^ (Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) *
              (Units.map (normLM F (D_orb.get i).le) (c'_μ i))⁻¹) *
              Units.map (normLM F (D_orb.get i).le) (u_θ i)) := by
        refine Finset.prod_congr rfl fun i _ => ?_
        rw [hc'_θ_eq i, map_mul, map_mul, map_inv, hnorm_unit_inc_LFi i c'_χ']
        ac_rfl
      rw [hcongr, Finset.prod_mul_distrib, Finset.prod_mul_distrib,
        Finset.prod_pow_eq_pow_sum, hDegSum, Finset.prod_inv_distrib]
    let M_unit : Lˣ :=
      c₀ ^ (q - 1) * (ϖ_L ^ (((q - 1) / k) * t)) *
        (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_μ i))⁻¹
    have hc'_χ'_eq : c'_χ' = ϖ_L ^ (a - 1) * c₀ * u_χ' := by
      dsimp [u_χ']
      rw [mul_inv_cancel_left]
    have ha_E_add : (a_E - 1) + ((q - 1) / k) * t = q * (a - 1) := by
      rw [ha_E_eq]
      change (q * (a - 1) - u_div * t + 1 - 1) + u_div * t = q * (a - 1)
      omega
    have hϖ_pow_eq : (ϖ_L ^ (a_E - 1)) * (ϖ_L ^ (((q - 1) / k) * t)) = (ϖ_L ^ (a - 1)) ^ q := by
      rw [← pow_add, ha_E_add, mul_comm q (a - 1), pow_mul]
    have hcomm_group_L : ∀ (wA wAE wUT c0 uχ Pμ Uθ : Lˣ),
        wAE * wUT = wA ^ q →
        wAE⁻¹ * c0⁻¹ * (wA * c0 * uχ) *
          (((wA * c0 * uχ) ^ (q - 1)) * Pμ⁻¹ * Uθ) =
          (uχ ^ q * (c0 ^ (q - 1) * wUT * Pμ⁻¹)) * Uθ := by
      intro wA wAE wUT c0 uχ Pμ Uθ hw_eq
      have hpow_q : (wA * c0 * uχ) * ((wA * c0 * uχ) ^ (q - 1)) =
          (wA ^ q) * (c0 ^ q) * (uχ ^ q) := by
        rw [← pow_succ', Nat.sub_add_cancel hq_pos, mul_pow, mul_pow]
      have hc0_q : c0⁻¹ * (c0 ^ q) = c0 ^ (q - 1) := by
        conv_lhs => rw [← Nat.sub_add_cancel hq_pos, pow_succ', ← mul_assoc, inv_mul_cancel, one_mul]
      have hw_inv : wAE⁻¹ * (wA ^ q) = wUT := by
        rw [← hw_eq, inv_mul_cancel_left]
      calc wAE⁻¹ * c0⁻¹ * (wA * c0 * uχ) * (((wA * c0 * uχ) ^ (q - 1)) * Pμ⁻¹ * Uθ) =
            wAE⁻¹ * c0⁻¹ * ((wA * c0 * uχ) * ((wA * c0 * uχ) ^ (q - 1))) * Pμ⁻¹ * Uθ := by ac_rfl
        _ = (wAE⁻¹ * (wA ^ q)) * (c0⁻¹ * (c0 ^ q)) * (uχ ^ q) * Pμ⁻¹ * Uθ := by
            rw [hpow_q]; ac_rfl
        _ = (uχ ^ q * (c0 ^ (q - 1) * wUT * Pμ⁻¹)) * Uθ := by
            rw [hw_inv, hc0_q]; ac_rfl
    have hu_E_norm_eq : u_E_norm = (u_χ' ^ q * M_unit) * U_θ := by
      dsimp only [u_E_norm, M_unit]
      rw [hprod_ratio]
      conv_lhs => rw [hc'_χ'_eq]
      exact hcomm_group_L (ϖ_L ^ (a - 1)) (ϖ_L ^ (a_E - 1)) (ϖ_L ^ (((q - 1) / k) * t))
        c₀ u_χ' (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_μ i))
        U_θ hϖ_pow_eq
    have hc₀_val : valL F L (c₀ : L) = 1 + condExpChar F L ψ := by
      change valL F L ((ϖ_L ^ (1 + condExpChar F L ψ) : Lˣ) : L) = _
      rw [hval_zpow_L ϖ_L, hϖ_L, mul_one]
    have hu_χ'_val0 : valL F L (u_χ' : L) = 0 := by
      change valL F L ((((ϖ_L ^ (a - 1) * c₀)⁻¹ * c'_χ' : Lˣ) : L)) = 0
      rw [Units.val_mul, hval_mul_L _ _ (Units.ne_zero _) (Units.ne_zero _),
        hval_inv_L, Units.val_mul, hval_mul_L _ _ (Units.ne_zero _) (Units.ne_zero _),
        hval_pow_L ϖ_L (a - 1), hϖ_L, mul_one, hc₀_val, hc_L_val]
      omega
    have hM_unit_val0 : valL F L (M_unit : L) = 0 := by
      change valL F L (((c₀ ^ (q - 1) * (ϖ_L ^ (((q - 1) / k) * t)) *
        (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_μ i))⁻¹ : Lˣ) : L)) = 0
      rw [Units.val_mul, hval_mul_L _ _ (Units.ne_zero _) (Units.ne_zero _),
        Units.val_mul, hval_mul_L _ _ (Units.ne_zero _) (Units.ne_zero _),
        hval_pow_L c₀ (q - 1), hc₀_val,
        hval_pow_L ϖ_L (((q - 1) / k) * t), hϖ_L, mul_one,
        hval_inv_L, hval_prod_L Finset.univ]
      have hsum_norm_μ :
          (∑ i : Fin D_orb.length,
            valL F L (((Units.map (normLM F (D_orb.get i).le) (c'_μ i) : Lˣ) : L))) =
          ((q - 1 : ℕ) : ℤ) * (1 + condExpChar F L ψ) + (((q - 1) / k : ℕ) : ℤ) * (t : ℤ) := by
        have hcongr :
            (∑ i : Fin D_orb.length,
              valL F L (((Units.map (normLM F (D_orb.get i).le) (c'_μ i) : Lˣ) : L))) =
            ∑ i : Fin D_orb.length,
              (f_orb i : ℤ) * ((k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ)) := by
          refine Finset.sum_congr rfl fun i _ => ?_
          change valL F L (normLM F (D_orb.get i).le (c'_μ i : (D_orb.get i).field)) = _
          rw [(hf_orb_spec i).2.2.2 (c'_μ i : (D_orb.get i).field),
            (hc_orb i).2.2.1, (hFi_ram i).1, (hFi_ram i).2.2.2.2.2.2.1]
          push_cast
          ring
        rw [hcongr, ← Finset.sum_mul, hsum_f_int]
        linear_combination (1 + condExpChar F L ψ) * hmul_div_int
      rw [hsum_norm_μ]
      push_cast
      ring
    obtain ⟨hres0, hres1, hres_ring, hres_ker, _⟩ := hresL_props
    have hres_pow : ∀ (u : Lˣ) (n : ℕ), valL F L (u : L) = 0 →
        resL (((u ^ n : Lˣ) : L)) = (resL (u : L)) ^ n := by
      intro u n hu0
      induction n with
      | zero => rw [pow_zero, pow_zero, Units.val_one, hres1]
      | succ n ih =>
        have hun_val0 : valL F L (((u ^ n : Lˣ) : L)) = 0 := by
          rw [hval_pow_L u n, hu0, mul_zero]
        rw [pow_succ', pow_succ', Units.val_mul,
          (hres_ring (u : L) (((u ^ n : Lˣ) : L)) (Or.inr (by omega)) (Or.inr (by omega))).2.1, ih]
    have hres_U_θ : resL (U_θ : L) = 1 := by
      have hmem1 := (hunit_ge1_L 1 le_rfl U_θ).mp hU_θ_mem
      have hsub_int : (U_θ : L) - 1 = 0 ∨ 0 ≤ valL F L ((U_θ : L) - 1) := by
        rcases hmem1 with h1 | hge1
        · exact Or.inl (sub_eq_zero.mpr h1)
        · exact Or.inr (by omega)
      have hsub_p1 : (U_θ : L) - 1 = 0 ∨ 1 ≤ valL F L ((U_θ : L) - 1) := by
        rcases hmem1 with h1 | hge1
        · exact Or.inl (sub_eq_zero.mpr h1)
        · exact Or.inr hge1
      have hres_sub0 : resL ((U_θ : L) - 1) = 0 :=
        (hres_ker ((U_θ : L) - 1) hsub_int).mpr hsub_p1
      have hadd_eq : ((U_θ : L) - 1) + 1 = (U_θ : L) := sub_add_cancel (U_θ : L) 1
      have hres_add := (hres_ring ((U_θ : L) - 1) 1 hsub_int (Or.inr (by rw [hval1_L]))).1
