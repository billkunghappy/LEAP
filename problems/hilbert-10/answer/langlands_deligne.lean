    have hπw : π_F' w = 1 := (hπF'_eq_one w).mpr hwF'
    have hνw : ν₁ w = 1 := by
      change bar_ν₁ (π_F' w) = 1
      rw [hπw, map_one]
    change (ν₁ w : Ω F) • LinearMap.id = 1
    rw [hνw, Units.val_one, one_smul]
    rfl
  have hν₁_restF' : restrictWeilChar F hLF' ν₁ = 1 := by
    apply MonoidHom.ext
    intro w
    let w_L : G_L := Subgroup.inclusion (relWeil_antitone F hLF') w
    have hwF' : w_L ∈ H_F' := w.2
    have hπw : π_F' w_L = 1 := (hπF'_eq_one w_L).mpr hwF'
    change bar_ν₁ (π_F' w_L) = 1
    rw [hπw, map_one]
  have hν₁_restMC : restrictWeilChar F hLM_C ν₁ = 1 := by
    apply MonoidHom.ext
    intro w
    change restrictWeilChar F hLF' ν₁ (Subgroup.inclusion (relWeil_antitone F hF'MC) w) = 1
    rw [hν₁_restF', MonoidHom.one_apply]
