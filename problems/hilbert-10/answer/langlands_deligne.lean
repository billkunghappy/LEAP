  have hvalL_1 := hvalL_props.2.1
  have hvalL_neg := hvalL_props.2.2.2.1
  have hvalL_mul := hvalL_props.2.2.2.2.1
  have hvalL_inv := hvalL_props.2.2.2.2.2.1
  have hvalL_add := hvalL_props.2.2.2.2.2.2.2.1
