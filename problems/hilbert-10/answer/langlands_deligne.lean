      let u : relWeil F M_C := (rec.recMap M_C w)⁻¹ * w_M
      have hu_triv : (restrictWeilChar F hFtMC t.χ) u = 1 :=
        hχ_ker_K (Subgroup.inclusion (relWeil_antitone F hFtMC) u) hw
      rw [map_mul, map_inv, inv_mul_eq_one] at hu_triv
      rw [← hu_triv, ← hμ_t_MC_rec w, h_comp1, MonoidHom.one_apply, MonoidHom.one_apply]
    have hμ_t_ne1 : μ_t ≠ 1 := by
      intro h1
      apply hμ_t_MC_ne1
      rw [h1]
      exact MonoidHom.ext fun _ => rfl
    exact ⟨⟨hFin_t, hGal_tK, hGal_tMC, hSep_t, hψ_t, hμ_t_pow, hμ_t_ne1, hμ_t_cond,
      hμ_t_twist_cond, ⟨hFtMC, K_t, hFtKt, hKtEt, hSep_tMC, hGal_tKt, hAb_tKt, hFin_tKt,
        hμ_t_ker, hμ_t_MC_triv, hμ_t_MC_ne1⟩⟩,
      ⟨heps_t_untwist, heps_t_twist⟩⟩
  
  have heps_E_χ : (tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext))
      (traceChar F hLE ψ) : Ω F) =
      tateEps F E (χ'.comp (Units.map (normLM F hLE))) (traceChar F hLE ψ) :=
    (htateEps E (traceChar F hLE ψ) hψE (restrictWeilChar F hLE χL_ext)
      (hWeil_rest E hLE) (χ'.comp (Units.map (normLM F hLE))) hχ'E_rec).2
  have heps_E_1 : (tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) : Ω F) =
      tateEps F E 1 (traceChar F hLE ψ) :=
    (htateEps E (traceChar F hLE ψ) hψE 1 (hWeil_one E) 1 (fun _ => rfl)).2
  have heps_L_1 : (tateEpsUnit F L (recChar F rec L 1) ψ : Ω F) =
      tateEps F L 1 ψ :=
    (htateEps L ψ hψ 1 (hWeil_one L) 1 (fun _ => rfl)).2
  have heps_L_χ : (tateEpsUnit F L (recChar F rec L χL_ext) ψ : Ω F) =
      tateEps F L χ' ψ :=
    (htateEps L ψ hψ χL_ext hχL_ext χ' hχ'_rec).2
  have heval_list_untwist : ∀ (D : List (MonomialTerm F L)),
      (∀ t ∈ D, t.coeff = 1 ∧
        (tateEpsUnit F t.field (recChar F rec t.field t.χ) (traceChar F t.le ψ) : Ω F) =
          tateEps F t.field (recChar F rec t.field t.χ) (traceChar F t.le ψ)) →
      (evalMonomialList F rec (fun _ _ _ => 1) L ψ D : Ω F) =
        (D.map fun t => tateEps F t.field (recChar F rec t.field t.χ) (traceChar F t.le ψ)).prod := by
    intro D hD
    induction D with
    | nil => rfl
    | cons t tl ih =>
      obtain ⟨hc, heps⟩ := hD t List.mem_cons_self
      have htl := fun t' ht' => hD t' (List.mem_cons_of_mem t ht')
      have hterm : evalMonomialTerm F rec (fun _ _ _ => 1) L ψ t =
          tateEpsUnit F t.field (recChar F rec t.field t.χ) (traceChar F t.le ψ) := by
        simp only [evalMonomialTerm, hc, mul_one, zpow_one]
      change ((evalMonomialTerm F rec (fun _ _ _ => 1) L ψ t *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ tl : (Ω F)ˣ) : Ω F) = _
      simp only [List.map_cons, List.prod_cons, Units.val_mul]
      rw [hterm, heps, ih htl]
  have heval_list_twist : ∀ (D : List (MonomialTerm F L)),
      (∀ t ∈ D, t.coeff = 1 ∧
        (tateEpsUnit F t.field (recChar F rec t.field (t.χ * restrictWeilChar F t.le χL_ext))
            (traceChar F t.le ψ) : Ω F) =
          tateEps F t.field (recChar F rec t.field t.χ * χ'.comp (Units.map (normLM F t.le)))
            (traceChar F t.le ψ)) →
      (evalMonomialList F rec (fun _ _ _ => 1) L ψ (D.map (twistMonomialTerm F L χL_ext)) : Ω F) =
        (D.map fun t =>
          tateEps F t.field (recChar F rec t.field t.χ * χ'.comp (Units.map (normLM F t.le)))
            (traceChar F t.le ψ)).prod := by
    intro D hD
    induction D with
    | nil => rfl
    | cons t tl ih =>
      obtain ⟨hc, heps⟩ := hD t List.mem_cons_self
      have htl := fun t' ht' => hD t' (List.mem_cons_of_mem t ht')
      have hterm : evalMonomialTerm F rec (fun _ _ _ => 1) L ψ (twistMonomialTerm F L χL_ext t) =
          tateEpsUnit F t.field (recChar F rec t.field (t.χ * restrictWeilChar F t.le χL_ext))
            (traceChar F t.le ψ) := by
        simp only [twistMonomialTerm, evalMonomialTerm, hc, mul_one, zpow_one]
      change ((evalMonomialTerm F rec (fun _ _ _ => 1) L ψ (twistMonomialTerm F L χL_ext t) *
        evalMonomialList F rec (fun _ _ _ => 1) L ψ (tl.map (twistMonomialTerm F L χL_ext)) :
          (Ω F)ˣ) : Ω F) = _
      simp only [List.map_cons, List.prod_cons, Units.val_mul]
      rw [hterm, heps, ih htl]
  have hPowRed : ∀ N : ℕ,
      (tateEps F E (χ'.comp (Units.map (normLM F hLE))) (traceChar F hLE ψ) *
          tateEps F L 1 ψ *
          (D_orb.map fun t =>
            tateEps F t.field (recChar F rec t.field t.χ) (traceChar F t.le ψ)).prod) ^ N =
        (tateEps F E 1 (traceChar F hLE ψ) *
          tateEps F L χ' ψ *
          (D_orb.map fun t =>
            tateEps F t.field
              (recChar F rec t.field t.χ * χ'.comp (Units.map (normLM F t.le)))
              (traceChar F t.le ψ)).prod) ^ N →
      (tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) (traceChar F hLE ψ) *
          evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_orb)) ^ N =
        (tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
          evalMonomialList F rec (fun _ _ _ => 1) L ψ
            ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L χL_ext))) ^ N := by
    intro N hEps_pow
    have h_head_untwist : evalMonomialTerm F rec (fun _ _ _ => 1) L ψ ⟨1, L, le_rfl, 1⟩ =
        tateEpsUnit F L (recChar F rec L 1) ψ := by
      simp only [evalMonomialTerm, mul_one, zpow_one, htr_self]
    have h_one_mul_rest : (1 : relWeil F L →* (Ω F)ˣ) * restrictWeilChar F (le_rfl : L ≤ L) χL_ext =
        χL_ext :=
      MonoidHom.ext fun w => one_mul (χL_ext w)
    have h_head_twist : evalMonomialTerm F rec (fun _ _ _ => 1) L ψ
        (twistMonomialTerm F L χL_ext ⟨1, L, le_rfl, 1⟩) =
        tateEpsUnit F L (recChar F rec L χL_ext) ψ := by
      simp only [twistMonomialTerm, evalMonomialTerm, mul_one, zpow_one, htr_self, h_one_mul_rest]
    have h_orb_u := heval_list_untwist D_orb
      (fun t ht => ⟨(hD_orb_props t ht).1, (hOrb_all t ht).2.1⟩)
    have h_orb_t := heval_list_twist D_orb
      (fun t ht => ⟨(hD_orb_props t ht).1, (hOrb_all t ht).2.2⟩)
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val]
    have h_lhs :
        ((tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) (traceChar F hLE ψ) *
          evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_orb) : (Ω F)ˣ) : Ω F) =
        tateEps F E (χ'.comp (Units.map (normLM F hLE))) (traceChar F hLE ψ) *
          tateEps F L 1 ψ *
          (D_orb.map fun t =>
            tateEps F t.field (recChar F rec t.field t.χ) (traceChar F t.le ψ)).prod := by
      change (tateEpsUnit F E (recChar F rec E (restrictWeilChar F hLE χL_ext)) (traceChar F hLE ψ) : Ω F) *
        ((evalMonomialTerm F rec (fun _ _ _ => 1) L ψ ⟨1, L, le_rfl, 1⟩ *
          evalMonomialList F rec (fun _ _ _ => 1) L ψ D_orb : (Ω F)ˣ) : Ω F) = _
      rw [Units.val_mul, h_head_untwist, heps_E_χ, heps_L_1, h_orb_u, mul_assoc]
    have h_rhs :
        ((tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) *
          evalMonomialList F rec (fun _ _ _ => 1) L ψ
            ((⟨1, L, le_rfl, 1⟩ :: D_orb).map (twistMonomialTerm F L χL_ext)) : (Ω F)ˣ) : Ω F) =
        tateEps F E 1 (traceChar F hLE ψ) *
          tateEps F L χ' ψ *
          (D_orb.map fun t =>
            tateEps F t.field
              (recChar F rec t.field t.χ * χ'.comp (Units.map (normLM F t.le)))
              (traceChar F t.le ψ)).prod := by
      change (tateEpsUnit F E (recChar F rec E 1) (traceChar F hLE ψ) : Ω F) *
        ((evalMonomialTerm F rec (fun _ _ _ => 1) L ψ (twistMonomialTerm F L χL_ext ⟨1, L, le_rfl, 1⟩) *
          evalMonomialList F rec (fun _ _ _ => 1) L ψ (D_orb.map (twistMonomialTerm F L χL_ext)) :
            (Ω F)ˣ) : Ω F) = _
      rw [Units.val_mul, h_head_twist, heps_E_1, heps_L_χ, h_orb_t, mul_assoc]
    rw [h_lhs, h_rhs]
    exact hEps_pow
  exact ⟨hFinL, hFinMC, hFinE, hFinK, hGalMCK, hSepLE, hψMC, hψE, hψK,
    hLMC_gt1, hq_gt1, hr_pos, hDegSum, hχ'_cond, hχ'E_cond,
    fun t ht => (hOrb_all t ht).1, hPowRed⟩

theorem ld_valL_residue_field_card_eq_qL (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (hvalM_props : valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))))
    (haddVal_props : addVal F 1 = 0 ∧
      (∀ a : F, addVal F (-a) = addVal F a) ∧
      (∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b) ∧
      (∀ a : F, a ≠ 0 → addVal F a⁻¹ = - addVal F a) ∧
      (∀ a : F, (a = 0 ∨ 0 ≤ addVal F a) →
        (algebraMap F M a = 0 ∨ 0 ≤ valL F M (algebraMap F M a))) ∧
      (∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
        (algebraMap F M a = 0 ∨ 1 ≤ valL F M (algebraMap F M a))))
    (k_M : Type u) [Field k_M] [Fintype k_M] (resM : M → k_M)
    (hresM_0 : resM 0 = 0) (hresM_1 : resM 1 = 1)
    (hresM_ring : ∀ x₁ x₂ : M, (x₁ = 0 ∨ 0 ≤ valL F M x₁) → (x₂ = 0 ∨ 0 ≤ valL F M x₂) →
      resM (x₁ + x₂) = resM x₁ + resM x₂ ∧
      resM (x₁ * x₂) = resM x₁ * resM x₂ ∧
      resM (-x₁) = -resM x₁)
    (hresM_ker : ∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
      (resM x = 0 ↔ (x = 0 ∨ 1 ≤ valL F M x)))
    (hresM_surj : ∀ a : k_M, ∃ x : M, (x = 0 ∨ 0 ≤ valL F M x) ∧ resM x = a) :
    Fintype.card k_M = qL F M ∧
    ((p F : ℕ) : k_M) = 0 ∧
    (((p F : ℕ) : M) = 0 ∨ 1 ≤ valL F M ((p F : ℕ) : M)) :=
by
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add⟩ := hvalM_props
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1⟩ := haddVal_props
  let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hmem_O : ∀ a : F, a ∈ 𝒪[F] ↔ (a = 0 ∨ 0 ≤ addVal F a) := by
    intro a
    by_cases ha : a = 0
    · simp [ha]
    · have hφa : φ (valuation F a) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr ha)
      have hle_iff : valuation F a ≤ 1 ↔ 0 ≤ addVal F a := by
        rw [← map_le_map_iff φ, map_one, ← WithZero.coe_unzero hφa, ← WithZero.coe_one,
          WithZero.coe_le_coe, ← Multiplicative.toAdd_le, toAdd_one]
        unfold addVal
        rw [dif_neg ha]
        omega
      rw [Valuation.mem_integer_iff, hle_iff]
      simp [ha]
  have hres_zero : ∀ x : 𝒪[F],
      IsLocalRing.residue 𝒪[F] x = 0 ↔ ((x : F) = 0 ∨ 1 ≤ addVal F (x : F)) := by
    intro x
    have hker : IsLocalRing.residue 𝒪[F] x = 0 ↔ valuation F (x : F) < 1 := by
      rw [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one]
    by_cases hx : (x : F) = 0
    · rw [hker]
      simp [hx, zero_lt_one]
    · have hφx : φ (valuation F (x : F)) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hx)
      have hlt_iff : valuation F (x : F) < 1 ↔ 1 ≤ addVal F (x : F) := by
        rw [← map_lt_map_iff φ, map_one, ← WithZero.coe_unzero hφx, ← WithZero.coe_one,
          WithZero.coe_lt_coe, ← Multiplicative.toAdd_lt, toAdd_one]
        unfold addVal
        rw [dif_neg hx]
        omega
      rw [hker, hlt_iff]
      simp [hx]
  have hintM_0 : (0 : M) = 0 ∨ 0 ≤ valL F M 0 := Or.inl rfl
  have hintM_1 : (1 : M) = 0 ∨ 0 ≤ valL F M 1 := Or.inr (by rw [hval1])
  have hintM_neg : ∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) → (-x = 0 ∨ 0 ≤ valL F M (-x)) := by
    intro x hx
    rcases hx with rfl | hx
    · left; simp
    · right; rw [hval_neg]; exact hx
  have hintM_add : ∀ x y : M, (x = 0 ∨ 0 ≤ valL F M x) → (y = 0 ∨ 0 ≤ valL F M y) →
      (x + y = 0 ∨ 0 ≤ valL F M (x + y)) := hval_add 0
  have hintM_sub : ∀ x y : M, (x = 0 ∨ 0 ≤ valL F M x) → (y = 0 ∨ 0 ≤ valL F M y) →
      (x - y = 0 ∨ 0 ≤ valL F M (x - y)) := by
    intro x y hx hy
    rw [sub_eq_add_neg]
    exact hintM_add x (-y) hx (hintM_neg y hy)
  have hintM_mul : ∀ x y : M, (x = 0 ∨ 0 ≤ valL F M x) → (y = 0 ∨ 0 ≤ valL F M y) →
      (x * y = 0 ∨ 0 ≤ valL F M (x * y)) := by
    intro x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hval_mul x y hx0 hy0]
        have h1 := hx.resolve_left hx0
        have h2 := hy.resolve_left hy0
        omega
  have hresM_sub : ∀ x₁ x₂ : M, (x₁ = 0 ∨ 0 ≤ valL F M x₁) → (x₂ = 0 ∨ 0 ≤ valL F M x₂) →
      resM (x₁ - x₂) = resM x₁ - resM x₂ := by
    intro x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg, (hresM_ring x₁ (-x₂) hx₁ (hintM_neg x₂ hx₂)).1,
      (hresM_ring x₂ 0 hx₂ hintM_0).2.2, ← sub_eq_add_neg]
  have hresM_sum : ∀ {ι : Type} [DecidableEq ι] (S : Finset ι) (g : ι → M),
      (∀ i ∈ S, g i = 0 ∨ 0 ≤ valL F M (g i)) →
      ((∑ i ∈ S, g i) = 0 ∨ 0 ≤ valL F M (∑ i ∈ S, g i)) ∧
        resM (∑ i ∈ S, g i) = ∑ i ∈ S, resM (g i) := by
    intro ι _ S g hg
    induction S using Finset.induction_on with
    | empty =>
      simp [hresM_0]
    | @insert a s ha ih =>
      have ha_int : g a = 0 ∨ 0 ≤ valL F M (g a) := hg a (Finset.mem_insert_self a s)
      have hs_int : ∀ i ∈ s, g i = 0 ∨ 0 ≤ valL F M (g i) :=
        fun i hi => hg i (Finset.mem_insert_of_mem hi)
      obtain ⟨hsum_s_int, hsum_s_res⟩ := ih hs_int
      rw [Finset.sum_insert ha, Finset.sum_insert ha]
      refine ⟨hintM_add (g a) _ ha_int hsum_s_int, ?_⟩
      rw [(hresM_ring (g a) _ ha_int hsum_s_int).1, hsum_s_res]
  letI : Fintype 𝓀[F] := Fintype.ofFinite 𝓀[F]
  let s_F : 𝓀[F] → 𝒪[F] := Function.surjInv (IsLocalRing.residue_surjective (R := 𝒪[F]))
  have hs_F : ∀ c : 𝓀[F], IsLocalRing.residue 𝒪[F] (s_F c) = c :=
    Function.surjInv_eq (IsLocalRing.residue_surjective (R := 𝒪[F]))
  let i₀ : 𝓀[F] → k_M := fun c => resM (algebraMap F M ((s_F c : 𝒪[F]) : F))
  have hi₀_eq : ∀ x : 𝒪[F], i₀ (IsLocalRing.residue 𝒪[F] x) = resM (algebraMap F M (x : F)) := by
    intro x
    set c : 𝓀[F] := IsLocalRing.residue 𝒪[F] x
    let d : 𝒪[F] := x - s_F c
    have hd_res : IsLocalRing.residue 𝒪[F] d = 0 := by
      change IsLocalRing.residue 𝒪[F] (x - s_F c) = 0
      rw [map_sub, hs_F c, sub_self]
    have hd_val : (d : F) = 0 ∨ 1 ≤ addVal F (d : F) := (hres_zero d).mp hd_res
    have hd_val0 : (d : F) = 0 ∨ 0 ≤ addVal F (d : F) := (hmem_O (d : F)).mp d.2
    have hsc_val0 : ((s_F c : 𝒪[F]) : F) = 0 ∨ 0 ≤ addVal F ((s_F c : 𝒪[F]) : F) :=
      (hmem_O _).mp (s_F c).2
    have hd_M0 : algebraMap F M (d : F) = 0 ∨ 0 ≤ valL F M (algebraMap F M (d : F)) :=
      halg0 (d : F) hd_val0
    have hd_M1 : algebraMap F M (d : F) = 0 ∨ 1 ≤ valL F M (algebraMap F M (d : F)) :=
      halg1 (d : F) hd_val
    have hsc_M0 : algebraMap F M ((s_F c : 𝒪[F]) : F) = 0 ∨
        0 ≤ valL F M (algebraMap F M ((s_F c : 𝒪[F]) : F)) :=
      halg0 _ hsc_val0
    have hd_resM : resM (algebraMap F M (d : F)) = 0 :=
      (hresM_ker (algebraMap F M (d : F)) hd_M0).mpr hd_M1
    have hx_split : (x : F) = (d : F) + ((s_F c : 𝒪[F]) : F) := by
      change (x : F) = (x : F) - ((s_F c : 𝒪[F]) : F) + ((s_F c : 𝒪[F]) : F)
      ring
    rw [hx_split, map_add, (hresM_ring _ _ hd_M0 hsc_M0).1, hd_resM, zero_add]
  let ι_M : 𝓀[F] →+* k_M :=
    { toFun := i₀
      map_zero' := by
        rw [← map_zero (IsLocalRing.residue 𝒪[F]), hi₀_eq 0]
        simp [hresM_0]
      map_one' := by
        rw [← map_one (IsLocalRing.residue 𝒪[F]), hi₀_eq 1]
        simp [hresM_1]
      map_add' := fun a b => by
        have h1 : a + b = IsLocalRing.residue 𝒪[F] (s_F a + s_F b) := by
          rw [map_add, hs_F a, hs_F b]
        have ha_M0 : algebraMap F M ((s_F a : 𝒪[F]) : F) = 0 ∨
            0 ≤ valL F M (algebraMap F M ((s_F a : 𝒪[F]) : F)) :=
          halg0 _ ((hmem_O _).mp (s_F a).2)
        have hb_M0 : algebraMap F M ((s_F b : 𝒪[F]) : F) = 0 ∨
            0 ≤ valL F M (algebraMap F M ((s_F b : 𝒪[F]) : F)) :=
          halg0 _ ((hmem_O _).mp (s_F b).2)
        rw [h1, hi₀_eq (s_F a + s_F b), Subring.coe_add, map_add,
          (hresM_ring _ _ ha_M0 hb_M0).1]
      map_mul' := fun a b => by
        have h1 : a * b = IsLocalRing.residue 𝒪[F] (s_F a * s_F b) := by
          rw [map_mul, hs_F a, hs_F b]
        have ha_M0 : algebraMap F M ((s_F a : 𝒪[F]) : F) = 0 ∨
            0 ≤ valL F M (algebraMap F M ((s_F a : 𝒪[F]) : F)) :=
          halg0 _ ((hmem_O _).mp (s_F a).2)
        have hb_M0 : algebraMap F M ((s_F b : 𝒪[F]) : F) = 0 ∨
            0 ≤ valL F M (algebraMap F M ((s_F b : 𝒪[F]) : F)) :=
