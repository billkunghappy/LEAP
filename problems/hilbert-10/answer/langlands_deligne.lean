    exact htriv.symm
  let Ψ₁ : Aˣ →* (Ω F)ˣ := χA_g'.comp σ_g_u
  let Ψ₂ : Aˣ →* (Ω F)ˣ := χA'
  have hΨ_unif : ∀ z : Aˣ, valL F A (z : A) = 1 → Ψ₁ z = Ψ₂ z := by
    intro z hz
    change χA_g' (σ_g_u z) = χA' z
    rw [hχA_g'_rec (σ_g_u z), hχA'_rec z]
    change χA (conjHom_g (rec.recMap A (σ_g_u z))) = χA (rec.recMap A z)
    rw [hχA_eq, MonoidHom.mul_apply, MonoidHom.mul_apply, hω_rec_σg z, hχ_ab_unif z hz]
  obtain ⟨ϖ_A, hϖ_A⟩ := hval_surj 1
  have hval_pow : ∀ n : ℕ, valL F A (((ϖ_A ^ n : Aˣ) : A)) = (n : ℤ) := by
    intro n
    induction' n with n ih
    · simpa using hval_one
    · rw [pow_succ, Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
        ih, hϖ_A, Nat.cast_add, Nat.cast_one]
  have hval_zpow : ∀ m : ℤ, valL F A (((ϖ_A ^ m : Aˣ) : A)) = m := by
    intro m
    cases m with
    | ofNat n => simpa using hval_pow n
    | negSucc n =>
      rw [zpow_negSucc, hval_inv, hval_pow (n + 1)]
      rfl
  have hrec_eq : ∀ y : Aˣ, χA_g' (σ_g_u y) = χA' y := by
    intro y
    set m_y : ℤ := valL F A (y : A)
    let u : Aˣ := y * ϖ_A ^ (-m_y)
    have hval_u : valL F A (u : A) = 0 := by
      change valL F A ((y : A) * ((ϖ_A ^ (-m_y) : Aˣ) : A)) = 0
      rw [hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _), hval_zpow (-m_y)]
      change m_y + -m_y = 0
      omega
    have hval_ϖu : valL F A (((ϖ_A * u : Aˣ) : A)) = 1 := by
      rw [Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _), hϖ_A, hval_u, add_zero]
    have hy_eq : y = (ϖ_A * u) * ϖ_A ^ (m_y - 1) := by
      have h1 : (ϖ_A * u) * ϖ_A ^ (m_y - 1) =
          y * (ϖ_A ^ (1 : ℤ) * ϖ_A ^ (-m_y) * ϖ_A ^ (m_y - 1)) := by
        dsimp [u]
        rw [zpow_one]
        ac_rfl
      rw [h1, ← zpow_add, ← zpow_add, show (1 : ℤ) + -m_y + (m_y - 1) = 0 by omega,
        zpow_zero, mul_one]
    change Ψ₁ y = Ψ₂ y
    rw [hy_eq, Ψ₁.map_mul (ϖ_A * u), Ψ₁.map_zpow, Ψ₂.map_mul (ϖ_A * u), Ψ₂.map_zpow,
      hΨ_unif (ϖ_A * u) hval_ϖu, hΨ_unif ϖ_A hϖ_A]
  
  let e_u : Aˣ ≃* Aˣ := Units.mapEquiv σ_g.toRingEquiv.toMulEquiv
  have he_u_coe : ∀ z : Aˣ, ((e_u z : Aˣ) : A) = σ_g (z : A) := fun _ => rfl
  have hθ_eu : ∀ z : Aˣ, χA_g' (e_u z) = χA' z := hrec_eq
  have hθ_symm : ∀ w : Aˣ, χA' (e_u.symm w) = χA_g' w := by
    intro w
    rw [← hθ_eu (e_u.symm w), e_u.apply_symm_apply]
  have hUG_iff : ∀ (a : ℕ) (z : Aˣ),
      e_u z ∈ unitGroup F A a ↔ z ∈ unitGroup F A a := by
    intro a z
    by_cases ha0 : a = 0
    · subst ha0
      rw [hunit0_A, hunit0_A, he_u_coe, hval_σg]
    · have ha_ge1 : 1 ≤ a := Nat.one_le_iff_ne_zero.mpr ha0
      rw [hunit_ge1_A a ha_ge1, hunit_ge1_A a ha_ge1, he_u_coe]
      have h1 : (σ_g (z : A) = 1 ↔ (z : A) = 1) := by
        conv_lhs => rw [← map_one σ_g]
        exact σ_g.injective.eq_iff
      have hsub : valL F A (σ_g (z : A) - 1) = valL F A ((z : A) - 1) := by
        calc valL F A (σ_g (z : A) - 1)
            = valL F A (σ_g ((z : A) - 1)) := by rw [map_sub, map_one]
          _ = valL F A ((z : A) - 1) := hval_σg ((z : A) - 1)
      rw [h1, hsub]
  have hUG_symm_iff : ∀ (a : ℕ) (w : Aˣ),
      e_u.symm w ∈ unitGroup F A a ↔ w ∈ unitGroup F A a := by
    intro a w
    rw [← hUG_iff a (e_u.symm w), e_u.apply_symm_apply]
  have hcondExp_eq : condExp F A χA_g' = condExp F A χA' := by
    unfold condExp
    congr 1
    ext a
    simp only [Set.mem_setOf_eq]
    refine ⟨fun ha z hz => ?_, fun ha w hw => ?_⟩
    · rw [← hθ_eu z]
      exact ha (e_u z) ((hUG_iff a z).mpr hz)
    · rw [← hθ_symm w]
      exact ha (e_u.symm w) ((hUG_symm_iff a w).mpr hw)
  let σ_gL : IntermediateField.extendScalars hLA ≃ₐ[L] IntermediateField.extendScalars hLA :=
    { toFun := fun x =>
        ⟨(σ_g ⟨x.1, (IntermediateField.mem_extendScalars hLA).mp x.2⟩).1,
          (IntermediateField.mem_extendScalars hLA).mpr
            (σ_g ⟨x.1, (IntermediateField.mem_extendScalars hLA).mp x.2⟩).2⟩
      invFun := fun y =>
        ⟨(σ_g.symm ⟨y.1, (IntermediateField.mem_extendScalars hLA).mp y.2⟩).1,
          (IntermediateField.mem_extendScalars hLA).mpr
            (σ_g.symm ⟨y.1, (IntermediateField.mem_extendScalars hLA).mp y.2⟩).2⟩
      left_inv := fun x => Subtype.ext (congrArg Subtype.val (σ_g.symm_apply_apply ⟨x.1, _⟩))
      right_inv := fun y => Subtype.ext (congrArg Subtype.val (σ_g.apply_symm_apply ⟨y.1, _⟩))
      map_mul' := fun x y => Subtype.ext (congrArg Subtype.val (map_mul σ_g ⟨x.1, _⟩ ⟨y.1, _⟩))
      map_add' := fun x y => Subtype.ext (congrArg Subtype.val (map_add σ_g ⟨x.1, _⟩ ⟨y.1, _⟩))
      commutes' := fun r => Subtype.ext (by
        change ((σ_g ⟨r.1, hLA r.2⟩ : A) : AlgebraicClosure F) = r.1
        exact (IntermediateField.mem_fixingSubgroup_iff L γ).mp hγL r.1 r.2) }
  have htraceChar_σg : ∀ y : A,
      traceChar F hLA ψ (σ_g y) = traceChar F hLA ψ y := by
    intro y
    change ψ (Algebra.trace L (IntermediateField.extendScalars hLA) (toExtendScalars F hLA (σ_g y))) =
      ψ (Algebra.trace L (IntermediateField.extendScalars hLA) (toExtendScalars F hLA y))
    have h_app : toExtendScalars F hLA (σ_g y) = σ_gL (toExtendScalars F hLA y) := rfl
    rw [h_app, Algebra.trace_eq_of_algEquiv σ_gL (toExtendScalars F hLA y)]
  have htateEps_eq :
      tateEps F A χA_g' (traceChar F hLA ψ) = tateEps F A χA' (traceChar F hLA ψ) :=
    (ld_ch13_2_tateEpsUnit_algEquiv_invariance F A A σ_g
      (traceChar F hLA ψ) hψA (traceChar F hLA ψ) htraceChar_σg
      χA' hχA'_cond χA_g' hrec_eq).1
  exact ⟨σ_g, χA_g, hσ_g_coe, hσ_g_fixL, hχA_g_apply, hχA_g_weil,
    hrec_eq, hcondExp_eq, htateEps_eq⟩

theorem ld_ch12_bicyclic_branch_conjugate_twists_and_norm_eval (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E M₁ K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E]
    [FiniteDimensional F M₁] [FiniteDimensional F K₁]
    (hLE : L ≤ E) (hLM₁ : L ≤ M₁) (hEK₁ : E ≤ K₁) (hM₁K₁ : M₁ ≤ K₁)
    (hGalLE : IsGaloisExt F L E) (hGalEK₁ : IsGaloisExt F E K₁)
    (hAbLE : IsAbelianExt F hLE) (hAbLM₁ : IsAbelianExt F hLM₁)
    (hAbEK₁ : IsAbelianExt F hEK₁) (hAbM₁K₁ : IsAbelianExt F hM₁K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE)))
    (hdegM₁ : Module.finrank L (IntermediateField.extendScalars hLM₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (hdegEK₁ : Module.finrank E (IntermediateField.extendScalars hEK₁) =
      Module.finrank L (IntermediateField.extendScalars hLE))
    (h_sup : E ⊔ M₁ = K₁)
    (hDiamondNorm : ∀ y : Eˣ,
      Units.map (normLM F hM₁K₁) (Units.map (IntermediateField.inclusion hEK₁).toMonoidHom y) =
        Units.map (IntermediateField.inclusion hLM₁).toMonoidHom (Units.map (normLM F hLE) y) ∧
      Units.map (normLM F hEK₁) (Units.map (IntermediateField.inclusion hEK₁).toMonoidHom y) =
        y ^ (Module.finrank E (IntermediateField.extendScalars hEK₁)))
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁)
    (hneK₁ : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE.trans hEK₁) χL = χK₁)
    (χE : relWeil F E →* (Ω F)ˣ) (hχE_weil : IsWeilRep F E (charRep F E χE))
    (hχE_rest : restrictWeilChar F hEK₁ χE = χK₁)
    (χM₁ : relWeil F M₁ →* (Ω F)ˣ) (hχM₁_weil : IsWeilRep F M₁ (charRep F M₁ χM₁))
    (hχM₁_rest : restrictWeilChar F hM₁K₁ χM₁ = χK₁)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hAutInv : ∀ (g : relWeil F L),
      ∃ (σ_g : E ≃ₐ[F] E) (χE_g : relWeil F E →* (Ω F)ˣ),
        (∀ y : E, (σ_g y : AlgebraicClosure F) = (g : AbsGal F) (y : AlgebraicClosure F)) ∧
        (∀ x : L, σ_g (IntermediateField.inclusion hLE x) = IntermediateField.inclusion hLE x) ∧
        (∀ (w : relWeil F E)
          (hw : (g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F) ∈ relWeil F E),
          χE_g w = χE ⟨(g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F), hw⟩) ∧
        IsWeilRep F E (charRep F E χE_g) ∧
        (∀ y : Eˣ,
          (recChar F rec E χE_g) (Units.map σ_g.toRingEquiv.toMonoidHom y) =
            (recChar F rec E χE) y) ∧
        condExp F E (recChar F rec E χE_g) = condExp F E (recChar F rec E χE) ∧
        tateEps F E (recChar F rec E χE_g) (traceChar F hLE ψ) =
          tateEps F E (recChar F rec E χE) (traceChar F hLE ψ))
    (μE μM₁ : relWeil F L →* (Ω F)ˣ) (νE νM₁ : Lˣ →* (Ω F)ˣ)
    (hμE_weil : IsWeilRep F L (charRep F L μE))
    (hμE_ker : ∀ w : relWeil F L, (w : AbsGal F) ∈ E.fixingSubgroup ↔ μE w = 1)
    (hνE_rec : ∀ x : Lˣ, νE x = μE (rec.recMap L x))
    (hνE_pow : νE ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1)
    (hνE_ne : νE ≠ 1)
    (hνE_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE)) ↔ νE x = 1)
    (hμM₁_weil : IsWeilRep F L (charRep F L μM₁))
    (hμM₁_ker : ∀ w : relWeil F L, (w : AbsGal F) ∈ M₁.fixingSubgroup ↔ μM₁ w = 1)
    (hμM₁_pow : μM₁ ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1)
    (hνM₁_rec : ∀ x : Lˣ, νM₁ x = μM₁ (rec.recMap L x))
    (hνM₁_pow : νM₁ ^ (Module.finrank L (IntermediateField.extendScalars hLE)) = 1)
    (hνM₁_ne : νM₁ ≠ 1)
    (hνM₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁)) ↔ νM₁ x = 1) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
    let ψE := traceChar F hLE ψ
    let χE' := recChar F rec E χE
    let χM₁' := recChar F rec M₁ χM₁
    let χK₁' := recChar F rec K₁ χK₁
    let ξE := νM₁.comp (Units.map (normLM F hLE))
    (∀ x : Lˣ, ∃ (y : Eˣ) (z : M₁ˣ),
      x = Units.map (normLM F hLE) y * Units.map (normLM F hLM₁) z) ∧
    χE'.comp (Units.map (normLM F hEK₁)) = χK₁' ∧
    (∀ u ∈ unitGroup F K₁ (condExp F K₁ χK₁'), χK₁' u = 1) ∧
    1 ≤ condExp F E χE' ∧
    ξE ^ ℓ = 1 ∧
    ξE ≠ 1 ∧
    (∀ j < ℓ,
      (∀ y : Eˣ, y ∈ Set.range (Units.map (normLM F hEK₁)) ↔ ξE y = 1) ∧
      (∀ u ∈ unitGroup F E (condExp F E (ξE ^ j)), (ξE ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F E (condExp F E (ξE ^ j * χE')), (ξE ^ j * χE') u = 1) ∧
      condExp F E (ξE ^ j * χE') = condExp F E χE' ∧
      tateEps F E (ξE ^ j * χE') ψE = tateEps F E χE' ψE) ∧
    (∀ k < ℓ, ∀ j < ℓ,
      ∀ u ∈ unitGroup F L (condExp F L (νE ^ k * νM₁ ^ j)), (νE ^ k * νM₁ ^ j) u = 1) ∧
    (∀ y : Eˣ,
      let x := Units.map (normLM F hLE) y
      χE' (Units.map (IntermediateField.inclusion hLE).toMonoidHom x) *
        (∏ j ∈ Finset.range ℓ, (νE ^ j) x) =
      χM₁' (Units.map (IntermediateField.inclusion hLM₁).toMonoidHom x) *
        (∏ j ∈ Finset.range ℓ, (νM₁ ^ j) x)) :=
by
  set ℓ := Module.finrank L (IntermediateField.extendScalars hLE)
  set ψE := traceChar F hLE ψ
  set χE' := recChar F rec E χE
  set χM₁' := recChar F rec M₁ χM₁
  set χK₁' := recChar F rec K₁ χK₁
  set ξE := νM₁.comp (Units.map (normLM F hLE))
  haveI : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
  haveI : NeZero ℓ := ⟨hPrime.ne_zero⟩
  
  obtain ⟨htraceChar, htateEps⟩ := ld_tateEps_char_and_traceChar F rec
  obtain ⟨hWeil_unit_triv, hWeil_norm⟩ := ld_separable_weil_char_rec_and_norm F rec
  have hψE : IsAdmissibleChar F E ψE := ((htraceChar L E hLE hAbLE.2.2).2 ψ hψ).1
  have hψM₁ : IsAdmissibleChar F M₁ (traceChar F hLM₁ ψ) :=
    ((htraceChar L M₁ hLM₁ hAbLM₁.2.2).2 ψ hψ).1
  have hψK₁ : IsAdmissibleChar F K₁ (traceChar F hEK₁ ψE) :=
    ((htraceChar E K₁ hEK₁ hAbEK₁.2.2).2 ψE hψE).1
  have hWeil_one : ∀ (A : IntermediateField F (AlgebraicClosure F)),
      IsWeilRep F A (charRep F A 1) := by
    intro A
    refine ⟨inferInstance, Set.univ, Filter.univ_mem, fun w _ _ => ?_⟩
    apply LinearMap.ext
    intro v
    change ((1 : relWeil F A →* (Ω F)ˣ) w : Ω F) • v = v
    rw [MonoidHom.one_apply, Units.val_one, one_smul]
  have hWeil_mul : ∀ (A : IntermediateField F (AlgebraicClosure F))
      {χ₁ χ₂ : relWeil F A →* (Ω F)ˣ},
      IsWeilRep F A (charRep F A χ₁) → IsWeilRep F A (charRep F A χ₂) →
      IsWeilRep F A (charRep F A (χ₁ * χ₂)) := by
    rintro A χ₁ χ₂ ⟨hfin, U₁, hU₁, htriv₁⟩ ⟨_, U₂, hU₂, htriv₂⟩
    refine ⟨hfin, U₁ ∩ U₂, Filter.inter_mem hU₁ hU₂, fun w hw hwI => ?_⟩
    have hmul : charRep F A (χ₁ * χ₂) w = charRep F A χ₁ w * charRep F A χ₂ w := by
      apply LinearMap.ext
      intro v
      change ((χ₁ * χ₂) w : Ω F) • v = (χ₁ w : Ω F) • ((χ₂ w : Ω F) • v)
      rw [MonoidHom.mul_apply, Units.val_mul, mul_smul]
    rw [hmul, htriv₁ w hw.1 hwI, htriv₂ w hw.2 hwI, mul_one]
  have hWeil_pow : ∀ (A : IntermediateField F (AlgebraicClosure F))
      {χ : relWeil F A →* (Ω F)ˣ},
      IsWeilRep F A (charRep F A χ) → ∀ j : ℕ, IsWeilRep F A (charRep F A (χ ^ j)) := by
    intro A χ hχ j
    induction' j with j ih
    · have h0 : χ ^ (0 : ℕ) = 1 := MonoidHom.ext fun w => by
        rw [MonoidHom.pow_apply, pow_zero, MonoidHom.one_apply]
      rw [h0]
      exact hWeil_one A
    · have hs : χ ^ (j + 1) = χ ^ j * χ := MonoidHom.ext fun w => by
        rw [MonoidHom.pow_apply, pow_succ, MonoidHom.mul_apply, MonoidHom.pow_apply]
      rw [hs]
      exact hWeil_mul A ih hχ
  have hWeil_rest : ∀ {A B : IntermediateField F (AlgebraicClosure F)} (hAB : A ≤ B)
      {χ : relWeil F A →* (Ω F)ˣ},
      IsWeilRep F A (charRep F A χ) →
      IsWeilRep F B (charRep F B (restrictWeilChar F hAB χ)) := by
    rintro A B hAB χ ⟨hfin, U, hU, htriv⟩
    refine ⟨hfin, U, hU, fun w hwU hwI => ?_⟩
    exact htriv (Subgroup.inclusion (relWeil_antitone F hAB) w) hwU hwI
  have hrecChar_eval : ∀ (A : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F A]
      (ψA : AddChar A (Ω F)), IsAdmissibleChar F A ψA →
      ∀ (χ : relWeil F A →* (Ω F)ˣ), IsWeilRep F A (charRep F A χ) →
      (∀ x : Aˣ, (recChar F rec A χ) x = χ (rec.recMap A x)) ∧
      (∀ u ∈ unitGroup F A (condExp F A (recChar F rec A χ)), (recChar F rec A χ) u = 1) ∧
      (∀ (B : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B]
        (ψB : AddChar B (Ω F)), IsAdmissibleChar F B ψB →
        ∀ (hAB : A ≤ B), Algebra.IsSeparable A (IntermediateField.extendScalars hAB) →
        (recChar F rec A χ).comp (Units.map (normLM F hAB)) =
          recChar F rec B (restrictWeilChar F hAB χ)) := by
    intro A _ ψA hψA χ hχ
    obtain ⟨θ, hθ_rec, hθ_cond, hθ_norm⟩ := hWeil_norm A χ hχ
    have h_eq : recChar F rec A χ = θ := (htateEps A ψA hψA χ hχ θ hθ_rec).1
    rw [h_eq]
    refine ⟨hθ_rec, hθ_cond, ?_⟩
    intro B _ ψB hψB hAB hSep
    have hnorm := (hθ_norm B hAB hSep).1
    exact ((htateEps B ψB hψB (restrictWeilChar F hAB χ) (hWeil_rest hAB hχ)
      (θ.comp (Units.map (normLM F hAB))) hnorm).1).symm
  have hχE'_norm : χE'.comp (Units.map (normLM F hEK₁)) = χK₁' := by
    have h := (hrecChar_eval E ψE hψE χE hχE_weil).2.2 K₁ (traceChar F hEK₁ ψE) hψK₁ hEK₁ hAbEK₁.2.2
    rw [hχE_rest] at h
    exact h
  have hχM₁'_norm : χM₁'.comp (Units.map (normLM F hM₁K₁)) = χK₁' := by
    have h := (hrecChar_eval M₁ (traceChar F hLM₁ ψ) hψM₁ χM₁ hχM₁_weil).2.2
      K₁ (traceChar F hEK₁ ψE) hψK₁ hM₁K₁ hAbM₁K₁.2.2
    rw [hχM₁_rest] at h
    exact h
  have hχK₁'_cond : ∀ u ∈ unitGroup F K₁ (condExp F K₁ χK₁'), χK₁' u = 1 :=
    (hrecChar_eval K₁ (traceChar F hEK₁ ψE) hψK₁ χK₁ hInvK₁.1).2.1
  have hνE_νM₁_cond : ∀ k < ℓ, ∀ j < ℓ,
      ∀ u ∈ unitGroup F L (condExp F L (νE ^ k * νM₁ ^ j)), (νE ^ k * νM₁ ^ j) u = 1 := by
    intro k _ j _
    apply hWeil_unit_triv L (μE ^ k * μM₁ ^ j)
      (hWeil_mul L (hWeil_pow L hμE_weil k) (hWeil_pow L hμM₁_weil j))
    intro x
    rw [MonoidHom.mul_apply, MonoidHom.mul_apply, MonoidHom.pow_apply, MonoidHom.pow_apply,
      MonoidHom.pow_apply, MonoidHom.pow_apply, hνE_rec x, hνM₁_rec x]
  let μE_tilde : relWeil F E →* (Ω F)ˣ := restrictWeilChar F hLE μM₁
  have hμE_tilde_weil : IsWeilRep F E (charRep F E μE_tilde) := hWeil_rest hLE hμM₁_weil
  have hrec_μM₁ : recChar F rec L μM₁ = νM₁ :=
    (htateEps L ψ hψ μM₁ hμM₁_weil νM₁ hνM₁_rec).1
  have hξE_eq_rec : ξE = recChar F rec E μE_tilde := by
    have h := (hrecChar_eval L ψ hψ μM₁ hμM₁_weil).2.2 E ψE hψE hLE hAbLE.2.2
    rw [hrec_μM₁] at h
    exact h
