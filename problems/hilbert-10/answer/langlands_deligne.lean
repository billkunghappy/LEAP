        2 * ((condExp F L νE' : ℤ) + condExpChar F L ψ) := by
      change valL F E' (IntermediateField.inclusion hLE' (α : L)) = _
      rw [hval_LE', hα_val]
    have h2 : valL F E' ((Units.map (normLM F hE'K₁) C : E'ˣ) : E') = 1 - 2 * (a : ℤ) := by
      change valL F E' (normLM F hE'K₁ (C : K₁)) = _
      rw [(hval_normK₁ (C : K₁)).1, hC_val]
    change valL F E' (((Units.map (IntermediateField.inclusion hLE').toMonoidHom α : E'ˣ) : E') *
      (((Units.map (normLM F hE'K₁) C)⁻¹ : E'ˣ) : E')) = _
    rw [hmul, hinv, h1, h2]
    dsimp [m₂, ψE', a] at *
    omega
  have hcM₁'_val : valL F M₁' (cM₁' : M₁') = (m₁ : ℤ) + condExpChar F M₁' ψM₁' := by
    have hmul := hvalM₁'_props.2.2.2.2.1
      ((Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α : M₁'ˣ) : M₁')
      (((Units.map (normLM F hM₁'K₁) C)⁻¹ : M₁'ˣ) : M₁')
      (Units.ne_zero _) (Units.ne_zero _)
    have hinv := hvalM₁'_props.2.2.2.2.2.1 (Units.map (normLM F hM₁'K₁) C)
    have h1 : valL F M₁' ((Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α : M₁'ˣ) : M₁') =
        2 * ((condExp F L νE' : ℤ) + condExpChar F L ψ) := by
      change valL F M₁' (IntermediateField.inclusion hLM₁' (α : L)) = _
      rw [hval_LM₁', hα_val]
    have h2 : valL F M₁' ((Units.map (normLM F hM₁'K₁) C : M₁'ˣ) : M₁') = 1 - 2 * (a : ℤ) := by
      change valL F M₁' (normLM F hM₁'K₁ (C : K₁)) = _
      rw [(hval_normK₁ (C : K₁)).2, hC_val]
    change valL F M₁' (((Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α : M₁'ˣ) : M₁') *
      (((Units.map (normLM F hM₁'K₁) C)⁻¹ : M₁'ˣ) : M₁')) = _
    rw [hmul, hinv, h1, h2]
    dsimp [m₁, ψM₁', a] at *
    omega
  have hcM₁'_inv_coe : ((cM₁'⁻¹ : M₁'ˣ) : M₁') =
      IntermediateField.inclusion hLM₁' (((α⁻¹ : Lˣ) : L)) * N₁ := by
    have hinv_eq : cM₁'⁻¹ =
        Units.map (IntermediateField.inclusion hLM₁').toMonoidHom (α⁻¹) *
          Units.map (normLM F hM₁'K₁) C := by
      dsimp [cM₁']
      rw [mul_inv_rev, inv_inv, map_inv, mul_comm]
    rw [hinv_eq, Units.val_mul]
    change IntermediateField.inclusion hLM₁' (((α⁻¹ : Lˣ) : L)) * normLM F hM₁'K₁ (C : K₁) = _
    rw [hC_coe, hnormM₁'_eq]
  have hcM₁'_stat : ∀ z : M₁', (z = 0 ∨ (((m₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) = ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * z) := by
    intro z hz_val hz
    rw [hcM₁'_inv_coe]
    exact hcM₁'_stat_N₁ z hz_val hz
