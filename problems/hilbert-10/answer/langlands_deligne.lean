      (∀ (γ : H) (w : relWeil F L'),
        let g := π (Subgroup.inclusion (relWeil_antitone F hLL') w)
        (∀ y : H_L',
          (γ⁻¹ * y.1).1 * g * (γ⁻¹ * y.1).1⁻¹ ∈ M_Kt ↔
            γ⁻¹ * y.1 * (projH g) * y.1⁻¹ * γ ∈ K_t ⊓ N₁) →
        (s_L' γ).trace F L' w =
