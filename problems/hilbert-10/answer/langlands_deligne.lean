    have hmn_not_lt2 : ¬ (m + n < 2) := by omega
    have hc₂_fg : c₂ (f * g) = (f * g).coeff (m + n - 2) := by
      dsimp only [c₂]
      rw [hfg_deg, if_neg hmn_not_lt2]
