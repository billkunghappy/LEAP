      have hW2ξs_val : W_K₁ ^ 2 * ξ m' * s_K₁ = 0 ∨
          ((S : ℕ) : ℤ) - (((2 * p * p * m : ℕ) : ℤ)) ≤ valL F K₁ (W_K₁ ^ 2 * ξ m' * s_K₁) := by
        have h := hval_mul_ge_K₁ (-(((2 * p * p * m : ℕ) : ℤ))) ((S : ℕ) : ℤ)
          (W_K₁ ^ 2 * ξ m') s_K₁ hW2ξ_val hs_val
        rcases h with h0 | hge
        · exact Or.inl h0
        · exact Or.inr (by linarith)
      have hT₂_val : T₂ = 0 ∨
          ((p * t₂ : ℕ) : ℤ) - (((4 * p * p * m : ℕ) : ℤ)) ≤ valL F K₁ T₂ := by
        have h := hval_mul_ge_K₁ (((S : ℕ) : ℤ) - (((2 * p * p * m : ℕ) : ℤ)))
          (-(((p * p * m : ℕ) : ℤ)))
          (W_K₁ ^ 2 * ξ m' * s_K₁) (L_val * (N_m - b_K₁) + ξ m' * C_m)
          hW2ξs_val hsum_inner
        rcases h with h0 | hge
        · exact Or.inl h0
        · right
          have hle_z : ((p * t₂ : ℕ) : ℤ) ≤ ((p * p * m + S : ℕ) : ℤ) := by
            exact_mod_cast hpt₂_le_ppmS
          change ((S : ℕ) : ℤ) - (((2 * p * p * m : ℕ) : ℤ)) + -(((p * p * m : ℕ) : ℤ)) ≤
            valL F K₁ T₂ at hge
          push_cast at hle_z hge ⊢
          linarith
      have hT12_val : T₁ + T₂ = 0 ∨
          ((p * t₂ : ℕ) : ℤ) - (((4 * p * p * m : ℕ) : ℤ)) ≤ valL F K₁ (T₁ + T₂) :=
        hval_add_K₁ (((p * t₂ : ℕ) : ℤ) - (((4 * p * p * m : ℕ) : ℤ))) T₁ T₂ hT₁_val hT₂_val
      have hDinv_val : valL F K₁ D_m⁻¹ = (((4 * p * p * m : ℕ) : ℤ)) := by
        rw [hval_inv_elt_K₁ D_m hD_ne0, hval_mul_K₁ (C_m * A_m) (L_val ^ 2) hCA_ne0 hL2_ne0,
          hval_mul_K₁ C_m A_m hC_ne0 hA_ne0, hC_val, hA_val, hL2_val]
        push_cast; ring
      rw [hmaster]
      have hfinal := hval_mul_ge_K₁ (((p * t₂ : ℕ) : ℤ) - (((4 * p * p * m : ℕ) : ℤ)))
        (((4 * p * p * m : ℕ) : ℤ)) (T₁ + T₂) D_m⁻¹ hT12_val (Or.inr (by rw [hDinv_val]))
      rcases hfinal with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by linarith)
    set w₂_pow : K₁ := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E') ^ i)
    have hw₂_inv_ne0 : ((w₂⁻¹ : E'ˣ) : E') ≠ 0 := Units.ne_zero w₂⁻¹
    have hw₂_K₁_ne0 : IntermediateField.inclusion hE'K₁ ((w₂⁻¹ : E'ˣ) : E') ≠ 0 :=
      (map_ne_zero (IntermediateField.inclusion hE'K₁)).mpr hw₂_inv_ne0
    have hw₂_pow_ne0 : w₂_pow ≠ 0 := by
      dsimp [w₂_pow]; rw [map_pow]; exact pow_ne_zero i hw₂_K₁_ne0
    have hw₂_pow_val : valL F K₁ w₂_pow = (((i * p * m : ℕ) : ℤ)) := by
      dsimp [w₂_pow]
      rw [map_pow, hval_pow_K₁ _ i hw₂_K₁_ne0, hval_E'K₁, hval_inv_E' w₂, hw₂_val]
      dsimp [m]; push_cast; ring
    have hsum_eq : W_shift - W_teich =
        ∑ m' ∈ Finset.range p,
          w₂_pow * ((Δ : K₁) + ξ m') ^ i * (f_conj m' - f_teich m') := by
      dsimp [W_shift, W_teich, w₂_pow, f_teich, s_K₁]
      rw [hs_wt_rew s, Finset.mul_sum, Finset.mul_sum, ← sub_add, ← Finset.sum_sub_distrib,
        ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun m' _ => ?_)
      ring
    rw [hsum_eq]
    apply hval_sum_K₁ (Finset.range p) _ ((1 + p * t₂ : ℕ) : ℤ)
    intro m' hm'_mem
    have hm' : m' < p := Finset.mem_range.mp hm'_mem
    obtain ⟨hΔξ_ne0, hΔξ_val⟩ := hΔ_xi_val m' hm'
    have hΔξ_pow_ne0 : ((Δ : K₁) + ξ m') ^ i ≠ 0 := pow_ne_zero i hΔξ_ne0
    have hΔξ_pow_val : valL F K₁ (((Δ : K₁) + ξ m') ^ i) = -(((i * t₁ : ℕ) : ℤ)) := by
      rw [hval_pow_K₁ _ i hΔξ_ne0, hΔξ_val]; push_cast; ring
    have hpref_ne0 : w₂_pow * ((Δ : K₁) + ξ m') ^ i ≠ 0 :=
      mul_ne_zero hw₂_pow_ne0 hΔξ_pow_ne0
    have hpref_val : valL F K₁ (w₂_pow * ((Δ : K₁) + ξ m') ^ i) =
        (((i * p * m : ℕ) : ℤ)) - (((i * t₁ : ℕ) : ℤ)) := by
      rw [hval_mul_K₁ _ _ hw₂_pow_ne0 hΔξ_pow_ne0, hw₂_pow_val, hΔξ_pow_val]; ring
    have hterm := hval_mul_ge_K₁ ((((i * p * m : ℕ) : ℤ)) - (((i * t₁ : ℕ) : ℤ)))
      ((p * t₂ : ℕ) : ℤ) (w₂_pow * ((Δ : K₁) + ξ m') ^ i) (f_conj m' - f_teich m')
      (Or.inr (by rw [hpref_val])) (hf_diff_teich m' hm')
    rcases hterm with h0 | hge
    · exact Or.inl h0
    · right
      have hi_pm_gt : i * t₁ + 1 ≤ i * (p * m) := by
        have h1 : t₁ + 1 ≤ p * m := hpm_gt_t₁
        have h2 : i * (t₁ + 1) ≤ i * (p * m) := Nat.mul_le_mul_left i h1
        have h3 : 1 ≤ i := hi_bounds.1
        linarith
      have h_idx_eq : i * (p * m) = i * p * m := by ring
      have h_bound_nat : 1 + p * t₂ + i * t₁ ≤ i * p * m + p * t₂ := by linarith
      have h_bound_z : ((1 + p * t₂ : ℕ) : ℤ) ≤
          (((i * p * m : ℕ) : ℤ)) - (((i * t₁ : ℕ) : ℤ)) + ((p * t₂ : ℕ) : ℤ) := by
        push_cast; zify at h_bound_nat; linarith
      linarith

theorem ld_ch12_wild_odd_tot_ram_linear_conj_pow_to_shifted_sum (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (hΔ_tr_top :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E') = 0 ∨
        ((3 * p * p * m₁ : ℕ) : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E')))
    (e_Δ : ℕ → M₁')
    (α γ : Lˣ) (w₂ : E'ˣ)
    (hw₂_val : valL F E' (w₂ : E') = -((a_lam - bE' : ℕ) : ℤ))
    (ξ Δ_conj : ℕ → K₁)
    (hξ0 : ξ 0 = 0)
    (hξ_props : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'), 0 < m →
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      ξ m ≠ 0 ∧
      valL F K₁ (ξ m) = 0 ∧
      ((ξ m) ^ p - ξ m = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤ valL F K₁ ((ξ m) ^ p - ξ m)))
    (hξ_pow_sum : ∀ r ∈ Finset.Icc 1 (2 * (Module.finrank L (IntermediateField.extendScalars hLE') - 1)),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      (∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
        (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0) = 0 ∨
        ((p * p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
          valL F K₁
            ((∑ m ∈ (Finset.range p).erase 0, (ξ m) ^ r) -
              (if (p - 1) ∣ r then ((p - 1 : ℕ) : K₁) else 0)))
    (hΔ_conj_val : ∀ m < Module.finrank L (IntermediateField.extendScalars hLE'),
      Δ_conj m ≠ 0 ∧ valL F K₁ (Δ_conj m) = -((bM₁' - 1 : ℕ) : ℤ))
    (hW_conj_sum : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let b := normLM F hM₁'K₁ (Δ : K₁)
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
