    intro g h
    refine ⟨(weilGroup F).mul_mem ((weilGroup F).mul_mem ((weilGroup F).inv_mem ((weilGroup F).inv_mem g.2.1)) h.2.1) ((weilGroup F).inv_mem g.2.1), ?_⟩
