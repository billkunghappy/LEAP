    rw [hψE'_app, hid, map_add (traceLM F hLE'), htr_smul, htr_smul, AddChar.map_add_eq_mul]
    have h1 : α₀ * 2 * s * traceLM F hLE' x_star = β * s := by dsimp only [β]; ring
    have h2 : α₀ * s * traceLM F hLE' (- (x_star ^ 2)) =
