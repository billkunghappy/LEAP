            · exact Or.inl h0
            · right
              have hl_lt : (l : ℕ) < p := l.2
              have hi_le : i ≤ p - 1 := (Finset.mem_Icc.mp hi).2
              have h_diff : (i : ℤ) - (j : ℤ) = ((p - (l : ℕ) : ℕ) : ℤ) := by omega
              nlinarith
          · simp [B, hji, hleq]
        · simp [B, hji, hl_ne0]
    · rcases hR'_pos_val l (by omega) with h0 | hle
      · exact Or.inl h0
      · right; linarith
  exact ⟨Z, s₀, hb_sub_a, hs₀_val, hs₀_approx, hZ0, hZ1, hZl⟩

theorem ld_ch12_wild_odd_tot_ram_eprime_symm_and_val_bounds (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hE'K₁ : E' ≤ K₁)
    (hGalE'K₁ : IsGaloisExt F E' K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2)
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE')
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_norm_E'K₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w)
    (G_E' : Type u) [Group G_E'] [Fintype G_E'] (act_E' : G_E' → E' → E')
    (hcard_GE' : Fintype.card G_E' = Module.finrank L (IntermediateField.extendScalars hLE'))
    (hactE'_ring : ∀ σ : G_E',
      act_E' σ 0 = 0 ∧ act_E' σ 1 = 1 ∧
      (∀ y₁ y₂ : E',
        act_E' σ (y₁ + y₂) = act_E' σ y₁ + act_E' σ y₂ ∧
        act_E' σ (y₁ * y₂) = act_E' σ y₁ * act_E' σ y₂ ∧
        act_E' σ (-y₁) = -act_E' σ y₁))
    (hactE'_val : ∀ (σ : G_E') (y : E'), valL F E' (act_E' σ y) = valL F E' y)
    (hSymm_E'K₁ :
      ∀ (G : Type u) [Group G] [Fintype G] (act : G → K₁ → K₁),
        Fintype.card G = Module.finrank E' (IntermediateField.extendScalars hE'K₁) →
        (∀ w : K₁, act 1 w = w) →
        (∀ (σ τ : G) (w : K₁), act (σ * τ) w = act σ (act τ w)) →
        (∀ σ : G,
          act σ 0 = 0 ∧ act σ 1 = 1 ∧
          (∀ w₁ w₂ : K₁,
            act σ (w₁ + w₂) = act σ w₁ + act σ w₂ ∧
            act σ (w₁ * w₂) = act σ w₁ * act σ w₂ ∧
            act σ (-w₁) = -act σ w₁)) →
        (∀ (σ : G) (y : E'),
          act σ (IntermediateField.inclusion hE'K₁ y) = IntermediateField.inclusion hE'K₁ y) →
        (∀ (σ : G) (w : K₁), valL F K₁ (act σ w) = valL F K₁ w) →
        (∀ w : K₁,
          IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ w) = ∑ σ : G, act σ w) →
        (∀ w : K₁,
          IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ w) = ∏ σ : G, act σ w) →
        let p := Module.finrank E' (IntermediateField.extendScalars hE'K₁)
        ∃ s : K₁ → ℕ → E',
          (∀ w : K₁, s w 1 = traceLM F hE'K₁ w) ∧
          (∀ w : K₁, 2 * s w 2 = (traceLM F hE'K₁ w) ^ 2 - traceLM F hE'K₁ (w ^ 2)) ∧
          (∀ w : K₁, w ≠ 0 → s w (p - 1) = normLM F hE'K₁ w * traceLM F hE'K₁ (w⁻¹)) ∧
          (∀ (w : K₁) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
            ∀ (q m : ℤ), (w = 0 ∨ q ≤ valL F K₁ w) →
              (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ) ≤ (r : ℤ) * q →
              (s w r = 0 ∨ m ≤ valL F E' (s w r))) ∧
          (∀ (w : K₁) (c : E'),
            normLM F hE'K₁ (1 + IntermediateField.inclusion hE'K₁ c * w) =
              1 + (∑ r ∈ Finset.Icc 1 (p - 1), c ^ r * s w r) +
                c ^ p * normLM F hE'K₁ w))
    (hCayley_E'K₁ :
      ∀ (G : Type u) [Group G] [Fintype G] (act : G → K₁ → K₁) (s : K₁ → ℕ → E'),
        Fintype.card G = Module.finrank E' (IntermediateField.extendScalars hE'K₁) →
        (∀ w : K₁, act 1 w = w) →
        (∀ σ : G,
          act σ 0 = 0 ∧ act σ 1 = 1 ∧
          (∀ w₁ w₂ : K₁,
            act σ (w₁ + w₂) = act σ w₁ + act σ w₂ ∧
            act σ (w₁ * w₂) = act σ w₁ * act σ w₂ ∧
            act σ (-w₁) = -act σ w₁)) →
        (∀ (σ : G) (y : E'),
          act σ (IntermediateField.inclusion hE'K₁ y) = IntermediateField.inclusion hE'K₁ y) →
        (∀ w : K₁,
          IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ w) = ∏ σ : G, act σ w) →
        (∀ (w : K₁) (c : E'),
          normLM F hE'K₁ (1 + IntermediateField.inclusion hE'K₁ c * w) =
            1 + (∑ r ∈ Finset.Icc 1 (Module.finrank E' (IntermediateField.extendScalars hE'K₁) - 1),
              c ^ r * s w r) +
              c ^ (Module.finrank E' (IntermediateField.extendScalars hE'K₁)) * normLM F hE'K₁ w) →
        let p := Module.finrank E' (IntermediateField.extendScalars hE'K₁)
        (∀ (w : K₁) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
          IntermediateField.inclusion hE'K₁ (s w r) =
            ∑ S ∈ ((Finset.univ : Finset G).powerset.filter (fun S => S.card = r)),
              ∏ σ ∈ S, act σ w) ∧
        (∀ w : K₁,
          w ^ p =
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ w) +
              ∑ i ∈ Finset.Icc 1 (p - 1),
                (-1 : K₁) ^ (i - 1) * IntermediateField.inclusion hE'K₁ (s w i) * w ^ (p - i)))
    (Δ : K₁ˣ)
    (hΔ_tr_low_bE' : ∀ j ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 2),
      traceLM F hE'K₁ ((Δ : K₁) ^ j) = 0 ∨
        (bE' : ℤ) ≤ valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ j)))
    (hΔ_tr_top_bE' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E') = 0 ∨
        (bE' : ℤ) ≤
          valL F E' (traceLM F hE'K₁ ((Δ : K₁) ^ (p - 1)) - ((p - 1 : ℕ) : E'))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let a := normLM F hE'K₁ (Δ : K₁)
    ∃ e' : ℕ → E',
      e' 0 = 1 ∧
      e' p = a ∧
      (∀ c : E',
        normLM F hE'K₁ (1 + IntermediateField.inclusion hE'K₁ c * (Δ : K₁)) =
          ∑ i : Fin (p + 1), c ^ (i : ℕ) * e' (i : ℕ)) ∧
      (e' 1 = 0 ∨ (bE' : ℤ) ≤ valL F E' (e' 1)) ∧
      (∀ f : G_E' → Fin (p + 1),
        (∑ σ : G_E', (f σ : ℕ)) = p →
        (∀ σ : G_E', (f σ : ℕ) ≤ p - 1) →
        ¬ (∀ σ : G_E', f σ = f 1) →
        (∏ σ : G_E', act_E' σ (e' (f σ : ℕ))) = 0 ∨
          (p : ℤ) * (bE' : ℤ) - ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) ≤
            valL F E' (∏ σ : G_E', act_E' σ (e' (f σ : ℕ)))) :=
by
  intro p a
  have hp_def : p = Module.finrank L (IntermediateField.extendScalars hLE') := rfl
  have hp_pos : 1 ≤ p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by
    have : p ≠ 2 := hp_odd
    omega
  have hp_sub1_z : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have hbE'_nonneg : (0 : ℤ) ≤ (bE' : ℤ) := by positivity
  obtain ⟨hvalE'_0, hvalE'_1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv, _, hvalE'_add, _⟩ :=
    hvalE'_props

  
  have hmul_E' : ∀ (m₁ m₂ : ℤ) (x y : E'),
      (x = 0 ∨ m₁ ≤ valL F E' x) → (y = 0 ∨ m₂ ≤ valL F E' y) →
        (x * y = 0 ∨ m₁ + m₂ ≤ valL F E' (x * y)) := by
    intro m₁ m₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hvx : m₁ ≤ valL F E' x := hx.resolve_left hx0
        have hvy : m₂ ≤ valL F E' y := hy.resolve_left hy0
        rw [hvalE'_mul x y hx0 hy0]
        linarith
  have hsum_E' : ∀ {α : Type} (s : Finset α) (f : α → E') (k : ℤ),
      (∀ x ∈ s, f x = 0 ∨ k ≤ valL F E' (f x)) →
      ((∑ x ∈ s, f x) = 0 ∨ k ≤ valL F E' (∑ x ∈ s, f x)) := by
    intro α s f k hs
    induction s using Finset.induction_on with
    | empty => exact Or.inl Finset.sum_empty
    | @insert x s' hx ih =>
      rw [Finset.sum_insert hx]
      exact hvalE'_add k (f x) (∑ y ∈ s', f y)
        (hs x (Finset.mem_insert_self x s'))
        (ih (fun y hy => hs y (Finset.mem_insert_of_mem hy)))
