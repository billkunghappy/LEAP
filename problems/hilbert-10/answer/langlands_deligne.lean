        have h1 : (ξ_base m) ^ p * ((ξ_base m)⁻¹ ^ p * b) = b := by
          rw [← mul_assoc, ← mul_pow, hmul_inv, one_pow, one_mul]
        have hsum_eq :
            (ξ_base m) ^ p * (∑ i ∈ Finset.Icc 1 (p - 1), ((ξ_base m)⁻¹) ^ i * e_Δ i) =
              ∑ i ∈ Finset.Icc 1 (p - 1), (ξ_base m) ^ (p - i) * e_Δ i := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun i hi => ?_
          obtain ⟨hi1, hi2⟩ := Finset.mem_Icc.mp hi
          have hp_split : (ξ_base m) ^ p = (ξ_base m) ^ (p - i) * (ξ_base m) ^ i := by
            rw [← pow_add, show p - i + i = p by omega]
          have hi_cancel : (ξ_base m) ^ i * ((ξ_base m)⁻¹) ^ i = 1 := by
            rw [← mul_pow, hmul_inv, one_pow]
          calc (ξ_base m) ^ p * (((ξ_base m)⁻¹) ^ i * e_Δ i)
              = (ξ_base m) ^ (p - i) * ((ξ_base m) ^ i * ((ξ_base m)⁻¹) ^ i) * e_Δ i := by
                rw [hp_split]; ring
            _ = (ξ_base m) ^ (p - i) * e_Δ i := by rw [hi_cancel, mul_one]
        linear_combination h1 + hsum_eq
      have hB_diff_val : B_fn m - b = 0 ∨ (0 : ℤ) ≤ vM₁' (B_fn m - b) := by
        rw [hB_expand]
        have hξp := hvalM₁'_pow_ge (ξ_base m) p 0 (Or.inr (le_of_eq hξ_v0.symm))
        rw [mul_zero] at hξp
        have hsum_e :
            (∑ i ∈ Finset.Icc 1 (p - 1), (ξ_base m) ^ (p - i) * e_Δ i) = 0 ∨
