      ring
    have hu_inv_P : P 0 ((u⁻¹ : Lˣ) : L) := by
      apply hP_of_val
      rw [hval_inv u, hu_val, neg_zero]
    have hq_P : P (b : ℤ) (((q : Lˣ) : L) - 1) := by
      rw [hq_sub, ← zero_add (b : ℤ)]
