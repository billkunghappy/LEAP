      htr_bound_M₁'K₁ (d_U : ℤ) (2 * w - w ^ 2) htr_2w_cond
    have hquad_diff_dU :
        (2 * u - u ^ 2) - traceLM F hM₁'K₁ (2 * w - w ^ 2) = 0 ∨
          (d_U : ℤ) ≤ valL F M₁' ((2 * u - u ^ 2) - traceLM F hM₁'K₁ (2 * w - w ^ 2)) :=
      hquad_diff.imp id (fun h => le_trans hdU_le_mM₁' h)
    have hu_quad_dU : 2 * u - u ^ 2 = 0 ∨ (d_U : ℤ) ≤ valL F M₁' (2 * u - u ^ 2) := by
      have hadd_eq :
