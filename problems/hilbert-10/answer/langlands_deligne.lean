  let P_M₁' : ℤ → M₁' → Prop := fun k x => x = 0 ∨ k ≤ valL F M₁' x
  have hPL_mono : ∀ {k₁ k₂ : ℤ}, k₁ ≤ k₂ → ∀ {x : L}, P_L k₂ x → P_L k₁ x := by
    intro k₁ k₂ hk x hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have hPL_neg : ∀ {k : ℤ} {x : L}, P_L k x → P_L k (-x) := by
    intro k x hx
    rcases hx with rfl | hx
    · exact Or.inl neg_zero
    · right; rw [hval_neg_L]; exact hx
  have hPL_add : ∀ {k : ℤ} {x y : L}, P_L k x → P_L k y → P_L k (x + y) :=
    fun hx hy => hval_add_L _ _ _ hx hy
  have hPL_sub : ∀ {k : ℤ} {x y : L}, P_L k x → P_L k y → P_L k (x - y) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]; exact hPL_add hx (hPL_neg hy)
