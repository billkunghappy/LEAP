      have hs₀'_b₁ : s₀' = 0 ∨ (b₁_ceil : ℤ) ≤ valL F L s₀' := by
        have hp1 : (α' : L) * (1 + 4 * f)⁻¹ = 0 ∨
            2 * (e : ℤ) + 1 + condExpChar F L ψ ≤ valL F L ((α' : L) * (1 + 4 * f)⁻¹) := by
          have hα'_or : (α' : L) = 0 ∨ 2 * (e : ℤ) + 1 + condExpChar F L ψ ≤ valL F L (α' : L) := by
            right; rw [hα'_val, hcond_E']; push_cast; omega
          exact hvalL_mul_or (2 * (e : ℤ) + 1 + condExpChar F L ψ)
            (2 * (e : ℤ) + 1 + condExpChar F L ψ) 0 (α' : L) ((1 + 4 * f)⁻¹)
            hα'_or (Or.inr (le_of_eq h14f_inv_val.symm)) (by omega)
