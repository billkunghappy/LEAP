    have hδ_L_val : valL F L δ_L = (d_a : ℤ) := hϖ_L_pow_val d_a
    have hδ_K_val : valL F K δ_K = (d_a : ℤ) := hϖ_K_pow_val d_a
    let T_K : K → Ω F := fun r =>
      if hr : 1 + δ_K * r ≠ 0 then
        ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + δ_K * r) hr) : Ω F)⁻¹ *
          (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K) * δ_K * r)
      else 0
    let T_L : L → Ω F := fun x =>
      if hx : 1 + δ_L * x ≠ 0 then
        (χ' (Units.mk0 (1 + δ_L * x) hx) : Ω F)⁻¹ *
          ψ (((c_χ⁻¹ : Lˣ) : L) * δ_L * x)
      else 0
    have hTL_cong : ∀ (x₁ x₂ : L),
        (x₁ = 0 ∨ 0 ≤ valL F L x₁) →
        (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
        (x₁ - x₂ = 0 ∨ 1 ≤ valL F L (x₁ - x₂)) →
        T_L x₁ = T_L x₂ := by
      intro x₁ x₂ hx₁ hx₂ hx12
      have hδx₁ : δ_L * x₁ = 0 ∨ (d_a : ℤ) ≤ valL F L (δ_L * x₁) := by
        simpa using hval_mul_ge_L (d_a : ℤ) 0 δ_L x₁ (Or.inr (le_of_eq hδ_L_val.symm)) hx₁
      have hδx₂ : δ_L * x₂ = 0 ∨ (d_a : ℤ) ≤ valL F L (δ_L * x₂) := by
        simpa using hval_mul_ge_L (d_a : ℤ) 0 δ_L x₂ (Or.inr (le_of_eq hδ_L_val.symm)) hx₂
      have hx1_ne : 1 + δ_L * x₁ ≠ 0 :=
        h1_add_ne_zero_L (hval_le_L (by omega) hδx₁)
      have hx2_ne : 1 + δ_L * x₂ ≠ 0 :=
        h1_add_ne_zero_L (hval_le_L (by omega) hδx₂)
      dsimp [T_L]
      rw [dif_pos hx1_ne, dif_pos hx2_ne]
      set w₁ : Lˣ := Units.mk0 (1 + δ_L * x₁) hx1_ne
      set w₂ : Lˣ := Units.mk0 (1 + δ_L * x₂) hx2_ne
      have hw₂_mem1 : w₂ ∈ unitGroup F L 1 := by
        rw [hunit_ge1_L 1 le_rfl w₂]
        have hsub : (w₂ : L) - 1 = δ_L * x₂ := by change (1 + δ_L * x₂) - 1 = δ_L * x₂; ring
        rw [hsub]
        rcases hval_le_L (by omega : (1 : ℤ) ≤ (d_a : ℤ)) hδx₂ with h0 | hge1
        · exact Or.inl (sub_eq_zero.mp (hsub.trans h0))
        · exact Or.inr hge1
      have hw₂_inv_val0 : valL F L ((w₂⁻¹ : Lˣ) : L) = 0 := by
        rw [hval_inv_L w₂, hunit_val0_L 1 w₂ hw₂_mem1, neg_zero]
      have hw₂_inv_mul : ((w₂⁻¹ : Lˣ) : L) * (1 + δ_L * x₂) = 1 :=
        Units.inv_mul w₂
      have hw₂_inv_sub : ((w₂⁻¹ : Lˣ) : L) - 1 = - (((w₂⁻¹ : Lˣ) : L) * (δ_L * x₂)) := by
        calc ((w₂⁻¹ : Lˣ) : L) - 1
          _ = ((w₂⁻¹ : Lˣ) : L) - ((w₂⁻¹ : Lˣ) : L) * (1 + δ_L * x₂) := by rw [hw₂_inv_mul]
          _ = - (((w₂⁻¹ : Lˣ) : L) * (δ_L * x₂)) := by ring
      have hw₂_inv_sub_val : ((w₂⁻¹ : Lˣ) : L) - 1 = 0 ∨
          (d_a : ℤ) ≤ valL F L (((w₂⁻¹ : Lˣ) : L) - 1) := by
        rw [hw₂_inv_sub]
        have hmul := hval_mul_ge_L 0 (d_a : ℤ) ((w₂⁻¹ : Lˣ) : L) (δ_L * x₂)
          (Or.inr (le_of_eq hw₂_inv_val0.symm)) hδx₂
        rcases hmul with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right
          rw [hval_neg_L]
          omega
      set u_q : Lˣ := w₁ * w₂⁻¹
      set d_q : L := (u_q : L) - 1
      have hd_q_eq : d_q = ((w₂⁻¹ : Lˣ) : L) * (δ_L * (x₁ - x₂)) := by
        change (1 + δ_L * x₁) * ((w₂⁻¹ : Lˣ) : L) - 1 = _
        calc (1 + δ_L * x₁) * ((w₂⁻¹ : Lˣ) : L) - 1
          _ = (1 + δ_L * x₁) * ((w₂⁻¹ : Lˣ) : L) - ((w₂⁻¹ : Lˣ) : L) * (1 + δ_L * x₂) := by
            rw [hw₂_inv_mul]
          _ = ((w₂⁻¹ : Lˣ) : L) * (δ_L * (x₁ - x₂)) := by ring
      have hδx12 : δ_L * (x₁ - x₂) = 0 ∨
          ((d_a + 1 : ℕ) : ℤ) ≤ valL F L (δ_L * (x₁ - x₂)) := by
        have h1 := hval_mul_ge_L (d_a : ℤ) 1 δ_L (x₁ - x₂)
          (Or.inr (le_of_eq hδ_L_val.symm)) hx12
        rcases h1 with h0 | hge
        · exact Or.inl h0
        · right; omega
      have hd_q_val : d_q = 0 ∨ (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F L d_q := by
        rw [hd_q_eq, hra_eq]
        have h1 := hval_mul_ge_L 0 ((d_a + 1 : ℕ) : ℤ) ((w₂⁻¹ : Lˣ) : L) (δ_L * (x₁ - x₂))
          (Or.inr (le_of_eq hw₂_inv_val0.symm)) hδx12
        simpa using h1
      have hd_q_1_eq : 1 + d_q = (u_q : L) := by
        dsimp [d_q]
        ring
      have hd_q_1_ne : 1 + d_q ≠ 0 := by
        rw [hd_q_1_eq]
        exact Units.ne_zero u_q
      have hu_q_mk0 : Units.mk0 (1 + d_q) hd_q_1_ne = u_q := by
        apply Units.ext
        rw [Units.val_mk0, hd_q_1_eq]
      have hχ_uq : (χ' u_q : Ω F) = ψ (((c_χ⁻¹ : Lˣ) : L) * d_q) := by
        rw [← hu_q_mk0]
        exact hc_χ_stat d_q hd_q_val hd_q_1_ne
      have hd_q_diff_eq : d_q - δ_L * (x₁ - x₂) =
          (((w₂⁻¹ : Lˣ) : L) - 1) * (δ_L * (x₁ - x₂)) := by
        rw [hd_q_eq]
        ring
      have hd_q_diff_val : d_q - δ_L * (x₁ - x₂) = 0 ∨
          (a : ℤ) ≤ valL F L (d_q - δ_L * (x₁ - x₂)) := by
        rw [hd_q_diff_eq]
        have hmul := hval_mul_ge_L (d_a : ℤ) ((d_a + 1 : ℕ) : ℤ)
          (((w₂⁻¹ : Lˣ) : L) - 1) (δ_L * (x₁ - x₂)) hw₂_inv_sub_val hδx12
        exact hval_le_L (by omega) hmul
      set Δ_q : L := ((c_χ⁻¹ : Lˣ) : L) * (d_q - δ_L * (x₁ - x₂))
      have hΔ_q_val : Δ_q = 0 ∨ -condExpChar F L ψ ≤ valL F L Δ_q := by
        have hc_inv_val : valL F L ((c_χ⁻¹ : Lˣ) : L) = -((a : ℤ) + condExpChar F L ψ) := by
          rw [hval_inv_L c_χ, hc_χ_val]
        have hmul := hval_mul_ge_L (-((a : ℤ) + condExpChar F L ψ)) (a : ℤ)
          ((c_χ⁻¹ : Lˣ) : L) (d_q - δ_L * (x₁ - x₂))
          (Or.inr (le_of_eq hc_inv_val.symm)) hd_q_diff_val
        exact hval_le_L (by omega) hmul
      have hψ_Δq : ψ Δ_q = 1 := hψ_triv Δ_q hΔ_q_val
      have hadd_ψ : (((c_χ⁻¹ : Lˣ) : L) * δ_L * x₁) + Δ_q =
          (((c_χ⁻¹ : Lˣ) : L) * d_q) + (((c_χ⁻¹ : Lˣ) : L) * δ_L * x₂) := by
        dsimp [Δ_q]
        ring
      have hψ_x₁ : ψ (((c_χ⁻¹ : Lˣ) : L) * δ_L * x₁) =
          (χ' u_q : Ω F) * ψ (((c_χ⁻¹ : Lˣ) : L) * δ_L * x₂) := by
        calc ψ (((c_χ⁻¹ : Lˣ) : L) * δ_L * x₁)
          _ = ψ (((c_χ⁻¹ : Lˣ) : L) * δ_L * x₁) * 1 := (mul_one _).symm
          _ = ψ (((c_χ⁻¹ : Lˣ) : L) * δ_L * x₁) * ψ Δ_q := by rw [hψ_Δq]
          _ = ψ ((((c_χ⁻¹ : Lˣ) : L) * δ_L * x₁) + Δ_q) :=
            (AddChar.map_add_eq_mul ψ _ _).symm
          _ = ψ ((((c_χ⁻¹ : Lˣ) : L) * d_q) + (((c_χ⁻¹ : Lˣ) : L) * δ_L * x₂)) := by
            rw [hadd_ψ]
          _ = ψ (((c_χ⁻¹ : Lˣ) : L) * d_q) * ψ (((c_χ⁻¹ : Lˣ) : L) * δ_L * x₂) :=
            AddChar.map_add_eq_mul ψ _ _
          _ = (χ' u_q : Ω F) * ψ (((c_χ⁻¹ : Lˣ) : L) * δ_L * x₂) := by rw [hχ_uq]
      have hw₁_eq : w₁ = u_q * w₂ := by
        dsimp [u_q]
        exact (inv_mul_cancel_right w₁ w₂).symm
      have hχ_w₁ : (χ' w₁ : Ω F) = (χ' u_q : Ω F) * (χ' w₂ : Ω F) := by
        rw [hw₁_eq, map_mul, Units.val_mul]
      rw [hχ_w₁, hψ_x₁, mul_inv]
      set Q : Ω F := (χ' u_q : Ω F)
      set A₂ : Ω F := (χ' w₂ : Ω F)
      set B₂ : Ω F := ψ (((c_χ⁻¹ : Lˣ) : L) * δ_L * x₂)
      have hQ_ne : Q ≠ 0 := Units.ne_zero _
      calc (Q⁻¹ * A₂⁻¹) * (Q * B₂)
        _ = (Q⁻¹ * Q) * (A₂⁻¹ * B₂) := by ring
        _ = A₂⁻¹ * B₂ := by rw [inv_mul_cancel₀ hQ_ne, one_mul]
    have hTK_eq_TL_pow : ∀ r : L, (r = 0 ∨ 0 ≤ valL F L r) →
        T_K (IntermediateField.inclusion hLK r) = T_L (r ^ p) := by
      intro r hr_int
      set y : K := δ_K * IntermediateField.inclusion hLK r
      set x_r : L := δ_L * (r ^ p)
      have hinc_int : IntermediateField.inclusion hLK r = 0 ∨
          0 ≤ valL F K (IntermediateField.inclusion hLK r) := by
        rcases hr_int with rfl | hge0
        · exact Or.inl (map_zero _)
        · right
          rw [hval_alg r]
          exact mul_nonneg (Nat.cast_nonneg _) hge0
      have hrp_int : r ^ p = 0 ∨ 0 ≤ valL F L (r ^ p) := by
        simpa using hval_pow_ge_L p 0 r hr_int
      have hy_val : y = 0 ∨ (d_a : ℤ) ≤ valL F K y := by
        simpa [y] using hval_mul_ge_K (d_a : ℤ) 0 δ_K (IntermediateField.inclusion hLK r)
          (Or.inr (le_of_eq hδ_K_val.symm)) hinc_int
      have hxr_val : x_r = 0 ∨ (d_a : ℤ) ≤ valL F L x_r := by
        simpa [x_r] using hval_mul_ge_L (d_a : ℤ) 0 δ_L (r ^ p)
          (Or.inr (le_of_eq hδ_L_val.symm)) hrp_int
      have hy_ne : 1 + y ≠ 0 :=
        h1_add_ne_zero_K (hval_le_K (by omega) hy_val)
      have hxr_ne : 1 + x_r ≠ 0 :=
        h1_add_ne_zero_L (hval_le_L (by omega) hxr_val)
      dsimp [T_K, T_L]
      rw [dif_pos hy_ne, dif_pos hxr_ne]
      have hnorm_y : normLM F hLK y = x_r := by
        dsimp [y, x_r]
        have hδ : normLM F hLK δ_K = δ_L := hnorm_ϖ_pow d_a
        rw [map_mul, hδ, hnorm_inc r]
      obtain ⟨z, hz_val, hnorm_1y⟩ := hnorm_exp d_a hda_ge1 y hy_val
      set t_y : L := traceLM F hLK y
      set t_z : L := traceLM F hLK z
      have hy_tr_in : y = 0 ∨
          (p : ℤ) * (((a + 1) / 2 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K y := by
        apply hval_le_K _ hy_val
        rw [hp_sub1_int, hra_eq]
        push_cast
        nlinarith
      have hty_val : t_y = 0 ∨ (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F L t_y :=
        htr_bound (((a + 1) / 2 : ℕ) : ℤ) y hy_tr_in
      have hz_tr_in : z = 0 ∨
          (p : ℤ) * (a : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K z := by
        apply hval_le_K _ hz_val
        rw [hp_sub1_int]
        nlinarith
      have htz_val : t_z = 0 ∨ (a : ℤ) ≤ valL F L t_z :=
        htr_bound (a : ℤ) z hz_tr_in
      have hty_ne : 1 + t_y ≠ 0 :=
        h1_add_ne_zero_L (hval_le_L (by omega) hty_val)
      set w_y : Lˣ := Units.map (normLM F hLK) (Units.mk0 (1 + y) hy_ne)
      set u_xr : Lˣ := Units.mk0 (1 + x_r) hxr_ne
      set u_ty : Lˣ := Units.mk0 (1 + t_y) hty_ne
      set u_prod : Lˣ := u_xr * u_ty
      set w_err : Lˣ := w_y * u_prod⁻¹
      have hu_xr_mem1 : u_xr ∈ unitGroup F L 1 := by
        rw [hunit_ge1_L 1 le_rfl u_xr]
        have hsub : (u_xr : L) - 1 = x_r := by change (1 + x_r) - 1 = x_r; ring
        rw [hsub]
        rcases hval_le_L (by omega : (1 : ℤ) ≤ (d_a : ℤ)) hxr_val with h0 | hge1
        · exact Or.inl (sub_eq_zero.mp (hsub.trans h0))
        · exact Or.inr hge1
      have hu_ty_mem1 : u_ty ∈ unitGroup F L 1 := by
        rw [hunit_ge1_L 1 le_rfl u_ty]
        have hsub : (u_ty : L) - 1 = t_y := by change (1 + t_y) - 1 = t_y; ring
        rw [hsub]
        rcases hval_le_L (by omega : (1 : ℤ) ≤ (((a + 1) / 2 : ℕ) : ℤ)) hty_val with h0 | hge1
        · exact Or.inl (sub_eq_zero.mp (hsub.trans h0))
        · exact Or.inr hge1
      have hu_prod_inv_val0 : valL F L ((u_prod⁻¹ : Lˣ) : L) = 0 := by
        have hmem : u_prod ∈ unitGroup F L 1 := Subgroup.mul_mem _ hu_xr_mem1 hu_ty_mem1
        rw [hval_inv_L u_prod, hunit_val0_L 1 u_prod hmem, neg_zero]
      have hxr_ty_val : x_r * t_y = 0 ∨ (a : ℤ) ≤ valL F L (x_r * t_y) := by
        have hmul := hval_mul_ge_L (d_a : ℤ) (((a + 1) / 2 : ℕ) : ℤ) x_r t_y hxr_val hty_val
        exact hval_le_L (by omega) hmul
      have hdiff_a : t_z - x_r * t_y = 0 ∨ (a : ℤ) ≤ valL F L (t_z - x_r * t_y) :=
        hval_sub_L (a : ℤ) t_z (x_r * t_y) htz_val hxr_ty_val
      have hw_err_sub : (w_err : L) - 1 =
          (t_z - x_r * t_y) * ((u_prod⁻¹ : Lˣ) : L) := by
        have hwy_coe : (w_y : L) = 1 + t_y + t_z + x_r := by
          change normLM F hLK (1 + y) = 1 + t_y + t_z + x_r
          rw [hnorm_1y, map_add (traceLM F hLK) y z, hnorm_y]
          dsimp [t_y, t_z]
          ring
        have hprod_coe : (u_prod : L) = (1 + x_r) * (1 + t_y) := rfl
        have h1 : (w_err : L) - 1 =
            ((w_y : L) - (u_prod : L)) * ((u_prod⁻¹ : Lˣ) : L) := by
          change (w_y : L) * ((u_prod⁻¹ : Lˣ) : L) - 1 = _
          rw [sub_mul, Units.mul_inv]
        rw [h1, hwy_coe, hprod_coe]
        ring
      have hw_err_mem : w_err ∈ unitGroup F L a := by
        rw [hunit_ge1_L a (by omega) w_err, hw_err_sub]
        have hmul := hval_mul_ge_L (a : ℤ) 0 (t_z - x_r * t_y) ((u_prod⁻¹ : Lˣ) : L)
          hdiff_a (Or.inr (le_of_eq hu_prod_inv_val0.symm))
        rcases hmul with h0 | hge
        · exact Or.inl (sub_eq_zero.mp (hw_err_sub.trans h0))
        · right; omega
      have hχ_err : χ' w_err = 1 :=
        ((hSpecL χ').2.2.1 (by omega)).1 w_err hw_err_mem
      have hwy_eq : w_y = w_err * (u_xr * u_ty) := by
        dsimp [w_err, u_prod]
        exact (inv_mul_cancel_right w_y (u_xr * u_ty)).symm
      have hχ_wy : (χ' w_y : Ω F) = (χ' u_xr : Ω F) * (χ' u_ty : Ω F) := by
        have h1 : χ' w_y = χ' u_xr * χ' u_ty := by
          rw [hwy_eq, map_mul, hχ_err, one_mul, map_mul]
        exact_mod_cast h1
      have hχ_uty : (χ' u_ty : Ω F) = ψ (((c_χ⁻¹ : Lˣ) : L) * t_y) :=
        hc_χ_stat t_y hty_val hty_ne
      set z_u : K := (u : K) * y
      have hzu_val : z_u = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F K z_u := by
        have hmul := hval_mul_ge_K (b - a : ℤ) (d_a : ℤ) (u : K) y
          (Or.inr (le_of_eq hu_val.symm)) hy_val
        exact hval_le_K (by omega) hmul
      have hnorm_zu : normLM F hLK z_u = (N : L) * x_r := by
        dsimp [z_u]
        have hu_norm_coe : normLM F hLK (u : K) = (N : L) :=
          congrArg Units.val hu_norm
        rw [map_mul, hu_norm_coe, hnorm_y]
      have hψ_zu : ψ (- ((c_τ⁻¹ : Lˣ) : L) * traceLM F hLK z_u) =
          ψ (((c_χ⁻¹ : Lˣ) : L) * x_r) := by
        rw [← hnorm_to_trace z_u hzu_val, hnorm_zu, hc_χ_inv_coe, mul_assoc]
      have htr_cχK : (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K) * δ_K * IntermediateField.inclusion hLK r) =
          (χ' u_ty : Ω F) * ψ (((c_χ⁻¹ : Lˣ) : L) * x_r) := by
        have hmul_eq : ((c_χK⁻¹ : Kˣ) : K) * δ_K * IntermediateField.inclusion hLK r =
            IntermediateField.inclusion hLK (((c_χ⁻¹ : Lˣ) : L)) * y +
              IntermediateField.inclusion hLK (- ((c_τ⁻¹ : Lˣ) : L)) * z_u := by
          dsimp [y, z_u]
          rw [hc_χK_inv, hc_χ_inv_coe, map_mul, map_neg]
          ring
        change ψ (traceLM F hLK (((c_χK⁻¹ : Kˣ) : K) * δ_K * IntermediateField.inclusion hLK r)) = _
        rw [hmul_eq, map_add, htr_smul, htr_smul, AddChar.map_add_eq_mul, ← hχ_uty, hψ_zu]
      change (χ' w_y : Ω F)⁻¹ *
          (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K) * δ_K * IntermediateField.inclusion hLK r) =
        (χ' u_xr : Ω F)⁻¹ * ψ (((c_χ⁻¹ : Lˣ) : L) * δ_L * (r ^ p))
      have hψ_xr_eq : ψ (((c_χ⁻¹ : Lˣ) : L) * δ_L * (r ^ p)) = ψ (((c_χ⁻¹ : Lˣ) : L) * x_r) := by
        dsimp [x_r]
        rw [mul_assoc]
      rw [hχ_wy, htr_cχK, hψ_xr_eq, mul_inv]
      set A_xr : Ω F := (χ' u_xr : Ω F)
      set A_ty : Ω F := (χ' u_ty : Ω F)
      set B_xr : Ω F := ψ (((c_χ⁻¹ : Lˣ) : L) * x_r)
      have hAty_ne : A_ty ≠ 0 := Units.ne_zero _
      calc (A_xr⁻¹ * A_ty⁻¹) * (A_ty * B_xr)
        _ = A_xr⁻¹ * (A_ty⁻¹ * A_ty) * B_xr := by ring
        _ = A_xr⁻¹ * B_xr := by rw [inv_mul_cancel₀ hAty_ne, mul_one]
    let π : L → L := fun r =>
      if hr : r = 0 ∨ 0 ≤ valL F L r then
        (hRL_surj (r ^ p) (by simpa using hval_pow_ge_L p 0 r hr)).choose
      else 0
    have hπ_spec : ∀ r ∈ R_L,
        π r ∈ R_L ∧ (r ^ p - π r = 0 ∨ 1 ≤ valL F L (r ^ p - π r)) := by
      intro r hr_mem
      have hr_int : r = 0 ∨ 0 ≤ valL F L r := hRL_int r hr_mem
      dsimp [π]
      rw [dif_pos hr_int]
      exact (hRL_surj (r ^ p) (by simpa using hval_pow_ge_L p 0 r hr_int)).choose_spec
    have hπ_mem : ∀ r ∈ R_L, π r ∈ R_L := fun r hr => (hπ_spec r hr).1
    have hπ_cong : ∀ r ∈ R_L, r ^ p - π r = 0 ∨ 1 ≤ valL F L (r ^ p - π r) :=
      fun r hr => (hπ_spec r hr).2
    have hπ_sub : R_L.image π ⊆ R_L := Finset.image_subset_iff.mpr hπ_mem
    have hπ_sup : R_L ⊆ R_L.image π := by
      intro r' hr'
      obtain ⟨s, hs_int, hr'_sp⟩ := hfrob_surj r' (hRL_int r' hr')
      obtain ⟨r, hr_mem, hs_r⟩ := hRL_surj s hs_int
      have hsp_rp : s ^ p - r ^ p = 0 ∨ 1 ≤ valL F L (s ^ p - r ^ p) :=
        hpow_sub_ge1_L p s r hs_int (hRL_int r hr_mem) hs_r
      have hr'_rp : r' - r ^ p = 0 ∨ 1 ≤ valL F L (r' - r ^ p) := by
        have h1 : r' - r ^ p = (r' - s ^ p) + (s ^ p - r ^ p) := by ring
        rw [h1]
        exact hval_add_L 1 _ _ hr'_sp hsp_rp
      have hr'_πr : r' - π r = 0 ∨ 1 ≤ valL F L (r' - π r) := by
        have h1 : r' - π r = (r' - r ^ p) + (r ^ p - π r) := by ring
        rw [h1]
        exact hval_add_L 1 _ _ hr'_rp (hπ_cong r hr_mem)
      have hπr_eq : π r = r' := by
        by_contra hne
        have hv0 : valL F L (r' - π r) = 0 :=
          hRL_sep r' hr' (π r) (hπ_mem r hr_mem) (Ne.symm hne)
        rcases hr'_πr with h0 | hge1
        · exact hne (sub_eq_zero.mp h0).symm
        · omega
      exact Finset.mem_image.mpr ⟨r, hr_mem, hπr_eq⟩
    have hπ_img : R_L.image π = R_L := Finset.Subset.antisymm hπ_sub hπ_sup
    have hπ_inj : Set.InjOn π R_L :=
      Finset.injOn_of_card_image_eq (congrArg Finset.card hπ_img)
    change (∑ r ∈ R_K, T_K r) = ∑ r' ∈ R_L, T_L r'
    calc ∑ r ∈ R_K, T_K r
      _ = ∑ r ∈ R_L.image (IntermediateField.inclusion hLK), T_K r := by rw [hRK_eq]
      _ = ∑ r ∈ R_L, T_K (IntermediateField.inclusion hLK r) :=
        Finset.sum_image (IntermediateField.inclusion hLK).injective.injOn
      _ = ∑ r ∈ R_L, T_L (π r) := by
        apply Finset.sum_congr rfl
        intro r hr_mem
        have hrp_int : r ^ p = 0 ∨ 0 ≤ valL F L (r ^ p) := by
          simpa using hval_pow_ge_L p 0 r (hRL_int r hr_mem)
        rw [hTK_eq_TL_pow r (hRL_int r hr_mem),
          hTL_cong (r ^ p) (π r) hrp_int (hRL_int (π r) (hπ_mem r hr_mem)) (hπ_cong r hr_mem)]
      _ = ∑ r' ∈ R_L.image π, T_L r' := (Finset.sum_image hπ_inj).symm
      _ = ∑ r' ∈ R_L, T_L r' := by rw [hπ_img]
  exact ⟨hConj1, hConj2⟩

theorem ld_wild_low_cond_ge_two_stationary_and_hasse (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hν₁_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j)), (ν₁ ^ j) u = 1)
    (hχ'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ u ∈ unitGroup F L (condExp F L (ν₁ ^ j * χ')), (ν₁ ^ j * χ') u = 1)
    (hEqP : Module.finrank L (IntermediateField.extendScalars hLK) = p F)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hν_cond_eq : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j) = condExp F L ν₁)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) = valL F K y)
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (hfrob_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 0 ∨
          1 ≤ valL F L (x - s ^ (Module.finrank L (IntermediateField.extendScalars hLK)))))
    (hnK : condExpChar F K (traceChar F hLK ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
          (condExp F L ν₁ : ℤ))
    (ha_ge2 : 2 ≤ condExp F L χ')
    (hab : condExp F L χ' ≤ condExp F L ν₁)
    (haK : condExp F K (χ'.comp (Units.map (normLM F hLK))) = condExp F L χ')
    (htwist_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      0 < j → condExp F L (ν₁ ^ j * χ') = condExp F L ν₁)
    (haddVal1 : addVal F 1 = 0)
    (halg1 : ∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
      (algebraMap F L a = 0 ∨ 1 ≤ valL F L (algebraMap F L a)))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (hSpecK : ∀ (θK : Kˣ →* (Ω F)ˣ),
      (∀ y : K, (y = 0 ∨ -condExpChar F K (traceChar F hLK ψ) ≤ valL F K y) →
        traceChar F hLK ψ y = 1) ∧
      (∃ y₁ : K, y₁ ≠ 0 ∧ -(condExpChar F K (traceChar F hLK ψ) + 1) ≤ valL F K y₁ ∧
        traceChar F hLK ψ y₁ ≠ 1) ∧
      (condExp F K θK ≠ 0 →
        (∀ w ∈ unitGroup F K (condExp F K θK), θK w = 1) ∧
        (∃ w₀ ∈ unitGroup F K (condExp F K θK - 1), θK w₀ ≠ 1)) ∧
      valL F K ((tateElt F K θK (traceChar F hLK ψ) : Kˣ) : K) =
        (condExp F K θK : ℤ) + condExpChar F K (traceChar F hLK ψ))
    (ϖ_K : Kˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLK) ϖ_K = ϖ_L)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hBasis : ∀ y : K, ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLK)) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
        IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F K y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
            c i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
                valL F L (c i) + (i : ℤ))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (t : ℕ) (ht_ge1 : 1 ≤ t) (hb_eq : condExp F L ν₁ = t + 1)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (hnorm_exp : ∀ (m : ℕ), 1 ≤ m → ∀ y : K, (y = 0 ∨ (m : ℤ) ≤ valL F K y) →
      ∃ z : K, (z = 0 ∨ (2 * m : ℤ) ≤ valL F K z) ∧
        normLM F hLK (1 + y) = 1 + traceLM F hLK (y + z) + normLM F hLK y)
    (hnorm_le : ∀ m ≤ t + 1, ∀ w ∈ unitGroup F K m,
      Units.map (normLM F hLK) w ∈ unitGroup F L m)
    (hnorm_surj_lt : ∀ m < t, ∀ u ∈ unitGroup F L m,
      ∃ w ∈ unitGroup F K m,
        (Units.map (normLM F hLK) w) * u⁻¹ ∈ unitGroup F L (m + 1))
    (c_τ : Lˣ) (hc_τ_val : valL F L (c_τ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hc_τ_stat : ∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_τ⁻¹ : Lˣ) : L) * x))
    (c_χ0 : Lˣ) (hc_χ0_val : valL F L (c_χ0 : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_χ0_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ0⁻¹ : Lˣ) : L) * x)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    let b := condExp F L ν₁
    let a := condExp F L χ'
    ∃ (R_L : Finset L) (R_K : Finset K) (u : Kˣ) (N : Lˣ)
      (τ_unit τ_tilde : ℕ → Lˣ) (c_ν c_twist : ℕ → Lˣ) (c_χ : Lˣ) (c_χK : Kˣ),
      R_L.card = Fintype.card k_L ∧
      R_K.card = Fintype.card k_L ∧
      (∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r) ∧
      (∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0) ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → ∃ r ∈ R_L, x - r = 0 ∨ 1 ≤ valL F L (x - r)) ∧
      (∀ r ∈ R_K, r = 0 ∨ 0 ≤ valL F K r) ∧
      (∀ r₁ ∈ R_K, ∀ r₂ ∈ R_K, r₁ ≠ r₂ → valL F K (r₁ - r₂) = 0) ∧
      (∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) → ∃ r ∈ R_K, y - r = 0 ∨ 1 ≤ valL F K (y - r)) ∧
      Units.map (normLM F hLK) u = N ∧
      valL F K (u : K) = (b - a : ℤ) ∧
      valL F L (N : L) = (b - a : ℤ) ∧
      c_χ = c_τ * N⁻¹ ∧
      ((c_χK⁻¹ : Kˣ) : K) =
        IntermediateField.inclusion hLK (((c_τ⁻¹ : Lˣ) : L)) *
          (IntermediateField.inclusion hLK (N : L) - (u : K)) ∧
      (∀ j < p, 0 < j →
        (τ_tilde j : L) = (j : L) ^ (p ^ b) ∧
        τ_unit j = (τ_tilde j) ^ p ∧
        Units.map (normLM F hLK) (Units.map (IntermediateField.inclusion hLK).toMonoidHom (τ_tilde j)) = τ_unit j ∧
        ν₁ (τ_unit j) = 1 ∧
        c_ν j = c_τ * (τ_unit j)⁻¹ ∧
        (N : L) + (τ_unit j : L) ≠ 0 ∧
        valL F L ((N : L) + (τ_unit j : L)) = 0 ∧
        (((c_twist j)⁻¹ : Lˣ) : L) = ((c_τ⁻¹ : Lˣ) : L) * ((N : L) + (τ_unit j : L))) ∧
      valL F L (c_χ : L) = (a : ℤ) + condExpChar F L ψ ∧
      (∀ x : L, (x = 0 ∨ (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ⁻¹ : Lˣ) : L) * x)) ∧
      valL F K (c_χK : K) = (a : ℤ) + condExpChar F K (traceChar F hLK ψ) ∧
      (∀ y : K, (y = 0 ∨ (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F K y) →
        ∀ hy : 1 + y ≠ 0,
          ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + y) hy) : Ω F) =
            (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K) * y)) ∧
      (∀ j < p, 0 < j →
        valL F L (c_ν j : L) = (b : ℤ) + condExpChar F L ψ ∧
        (∀ x : L, (x = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
          ∀ hx : 1 + x ≠ 0,
            ((ν₁ ^ j) (Units.mk0 (1 + x) hx) : Ω F) = ψ ((((c_ν j)⁻¹ : Lˣ) : L) * x)) ∧
        valL F L (c_twist j : L) = (b : ℤ) + condExpChar F L ψ ∧
        (∀ x : L, (x = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
          ∀ hx : 1 + x ≠ 0,
            ((ν₁ ^ j * χ') (Units.mk0 (1 + x) hx) : Ω F) =
              ψ ((((c_twist j)⁻¹ : Lˣ) : L) * x))) ∧
      (a < b →
        (a % 2 = 1 →
          (∑ r ∈ R_K,
            if hr : 1 + ((ϖ_K ^ (a / 2) : Kˣ) : K) * r ≠ 0 then
              ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + ((ϖ_K ^ (a / 2) : Kˣ) : K) * r) hr) : Ω F)⁻¹ *
                (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K) * ((ϖ_K ^ (a / 2) : Kˣ) : K) * r)
            else 0) =
          (∑ r ∈ R_L,
            if hr : 1 + ((ϖ_L ^ (a / 2) : Lˣ) : L) * r ≠ 0 then
              (χ' (Units.mk0 (1 + ((ϖ_L ^ (a / 2) : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
                ψ (((c_χ⁻¹ : Lˣ) : L) * ((ϖ_L ^ (a / 2) : Lˣ) : L) * r)
            else 0)) ∧
        (b % 2 = 1 →
          ∀ j < p, 0 < j →
            (∑ r ∈ R_L,
              if hr : 1 + ((ϖ_L ^ (b / 2) : Lˣ) : L) * r ≠ 0 then
                ((ν₁ ^ j * χ') (Units.mk0 (1 + ((ϖ_L ^ (b / 2) : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
                  ψ ((((c_twist j)⁻¹ : Lˣ) : L) * ((ϖ_L ^ (b / 2) : Lˣ) : L) * r)
              else 0) =
            (∑ r ∈ R_L,
              if hr : 1 + ((ϖ_L ^ (b / 2) : Lˣ) : L) * r ≠ 0 then
                ((ν₁ ^ j) (Units.mk0 (1 + ((ϖ_L ^ (b / 2) : Lˣ) : L) * r) hr) : Ω F)⁻¹ *
                  ψ ((((c_ν j)⁻¹ : Lˣ) : L) * ((ϖ_L ^ (b / 2) : Lˣ) : L) * r)
              else 0))) :=
by
  obtain ⟨R_L, R_K, τ_unit, τ_tilde, c_ν,
    hRL_card, hRK_card, hRK_eq, hRL_int, hRL_sep, hRL_surj, hRK_int, hRK_sep, hRK_surj, hτ_c_ν_full⟩ :=
    ld_wild_low_cond_res_finsets_and_teichmuller_stat F L K hLK hPrime ψ ν₁
      hν₁_ker hb_ge2 hval_alg hvalL_props hvalK_props hSpecL ϖ_K hϖ_K hBasis
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj t hb_eq htr_bound
      c_τ hc_τ_val hc_τ_stat
  obtain ⟨u, N, c_χ, c_twist,
    hu_norm, hu_val, hN_val, hc_χ_eq, hc_χ_val, hc_χ_stat, htwist_full⟩ :=
    ld_wild_low_cond_subcritical_norm_and_twist_stat F L K hLK hPrime ψ ν₁ χ'
      hb_ge2 hval_norm ha_ge2 hab htwist_cond hvalL_props hvalK_props hSpecL
      ϖ_K ϖ_L hϖ_norm hϖ_K hϖ_L t ht_ge1 hb_eq hnorm_surj_lt
      c_τ hc_τ_val c_χ0 hc_χ0_val hc_χ0_stat τ_unit c_ν
      (fun j hj hj0 => ⟨(hτ_c_ν_full j hj hj0).2.2.2.2.1,
        (hτ_c_ν_full j hj hj0).2.2.2.2.2.1,
        (hτ_c_ν_full j hj hj0).2.2.2.2.2.2.2⟩)
  obtain ⟨hnorm_to_trace, c_χK, hc_χK_inv, hc_χK_val, hc_χK_stat⟩ :=
    ld_wild_low_cond_norm_to_trace_and_c_chiK_stat F L K hLK hPrime ψ ν₁ χ'
      hν₁_ker hb_ge2 hval_norm hval_alg hnK ha_ge2 hab haK
      hvalL_props hvalK_props hSpecL hSpecK ϖ_K hϖ_K t hb_eq htr_bound hnorm_exp
      c_τ hc_τ_val hc_τ_stat u N c_χ hu_norm hu_val hN_val hc_χ_eq hc_χ_val hc_χ_stat
  have hHasse_lt :=
    ld_wild_low_cond_lt_hasse_sum_matching F L K hLK hPrime ψ ν₁ χ'
      hb_ge2 hval_norm hval_alg hfrob_surj ha_ge2 hvalL_props hvalK_props hSpecL
      ϖ_K ϖ_L hϖ_norm hϖ_K hϖ_L t hb_eq htr_bound hnorm_exp
      c_τ R_L R_K u N τ_unit c_ν c_twist c_χ c_χK
      hRK_eq hRL_int hRL_sep hRL_surj hu_norm hu_val hc_χ_eq hc_χ_val hc_χ_stat
      hc_χK_inv hnorm_to_trace
      (fun j hj hj0 => ⟨(hτ_c_ν_full j hj hj0).2.2.2.2.1, (htwist_full j hj hj0).2.2.1⟩)
  refine ⟨R_L, R_K, u, N, τ_unit, τ_tilde, c_ν, c_twist, c_χ, c_χK,
    hRL_card, hRK_card, hRL_int, hRL_sep, hRL_surj, hRK_int, hRK_sep, hRK_surj,
    hu_norm, hu_val, hN_val, hc_χ_eq, hc_χK_inv,
    fun j hj hj0 => ⟨(hτ_c_ν_full j hj hj0).1, (hτ_c_ν_full j hj hj0).2.1,
      (hτ_c_ν_full j hj hj0).2.2.1, (hτ_c_ν_full j hj hj0).2.2.2.1,
      (hτ_c_ν_full j hj hj0).2.2.2.2.1, (htwist_full j hj hj0).1,
      (htwist_full j hj hj0).2.1, (htwist_full j hj hj0).2.2.1⟩,
    hc_χ_val, hc_χ_stat, hc_χK_val, hc_χK_stat,
    fun j hj hj0 => ⟨(hτ_c_ν_full j hj hj0).2.2.2.2.2.2.1,
      (hτ_c_ν_full j hj hj0).2.2.2.2.2.2.2,
      (htwist_full j hj hj0).2.2.2.1, (htwist_full j hj hj0).2.2.2.2⟩,
    hHasse_lt⟩

theorem ld_wild_galois_symm_poly_and_val_bound (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (t : ℕ) (ht_ge1 : 1 ≤ t)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (G : Type u) [Group G] [Fintype G] (act : G → K → K)
    (hcard_G : Fintype.card G = Module.finrank L (IntermediateField.extendScalars hLK))
    (hact_one : ∀ y : K, act 1 y = y)
    (hact_mul : ∀ (σ τ : G) (y : K), act (σ * τ) y = act σ (act τ y))
    (hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ y₁ y₂ : K,
        act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
        act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
        act σ (-y₁) = -act σ y₁))
    (hact_incl : ∀ (σ : G) (x : L), act σ (IntermediateField.inclusion hLK x) =
      IntermediateField.inclusion hLK x)
    (hact_val : ∀ (σ : G) (y : K), valL F K (act σ y) = valL F K y)
    (hact_trace : ∀ y : K, IntermediateField.inclusion hLK (traceLM F hLK y) = ∑ σ : G, act σ y)
    (hact_norm : ∀ y : K, IntermediateField.inclusion hLK (normLM F hLK y) = ∏ σ : G, act σ y) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    ((p : L) = 0 ∨ (((p - 1) * (t + 1) / p : ℕ) : ℤ) ≤ valL F L (p : L)) ∧
    ∃ s : K → ℕ → L,
      (∀ y : K, s y 1 = traceLM F hLK y) ∧
      (∀ (y : K) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
        ∀ (q m : ℤ), (y = 0 ∨ q ≤ valL F K y) →
          (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ (r : ℤ) * q →
          (s y r = 0 ∨ m ≤ valL F L (s y r))) ∧
      (∀ (y : K) (c ε : L),
        normLM F hLK
          (IntermediateField.inclusion hLK c + IntermediateField.inclusion hLK ε * y) =
          c ^ p +
            (∑ r ∈ Finset.Icc 1 (p - 1), c ^ (p - r) * ε ^ r * s y r) +
            ε ^ p * normLM F hLK y) :=
by
  rcases hvalK_props with
    ⟨hvalK0, hvalK1, _, _, hvalK_mul, _, _, hvalK_add, _⟩
  set p : ℕ := Module.finrank L (IntermediateField.extendScalars hLK)
  haveI : Fact (Nat.Prime p) := ⟨hPrime⟩
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hcard_univ : (Finset.univ : Finset G).card = p := Finset.card_univ.trans hcard_G
  
  have htr_one : traceLM F hLK (1 : K) = (p : L) := by
    apply (IntermediateField.inclusion hLK).injective
    change IntermediateField.inclusion hLK (traceLM F hLK (1 : K)) =
      IntermediateField.inclusion hLK (p : L)
    rw [hact_trace 1]
    have h1 : (∑ σ : G, act σ (1 : K)) = ∑ _σ ∈ (Finset.univ : Finset G), (1 : K) := by
      refine Finset.sum_congr rfl fun σ _ => ?_
      exact (hact_ring σ).2.1
    rw [h1, Finset.sum_const, hcard_univ, nsmul_one, map_natCast]
  have hp_val : (p : L) = 0 ∨ (((p - 1) * (t + 1) / p : ℕ) : ℤ) ≤ valL F L (p : L) := by
    let m_p : ℤ := (((p - 1) * (t + 1) / p : ℕ) : ℤ)
    have hdiv : ((p - 1) * (t + 1)) / p * p ≤ (p - 1) * (t + 1) :=
      Nat.div_mul_le_self ((p - 1) * (t + 1)) p
    have hbound1 :
        (p : ℤ) * m_p - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K (1 : K) := by
      rw [hvalK1]
      dsimp only [m_p]
      have hdivZ : (((p - 1) * (t + 1) / p : ℕ) : ℤ) * (p : ℤ) ≤
          ((p - 1 : ℕ) : ℤ) * ((t + 1 : ℕ) : ℤ) := by
        exact_mod_cast hdiv
      push_cast at hdivZ ⊢
      linarith
    have htr1 := htr_bound m_p (1 : K) (Or.inr hbound1)
    rwa [htr_one] at htr1
  
  let φ : G → (K →+* K) := fun σ =>
    { toFun := act σ
      map_one' := (hact_ring σ).2.1
      map_mul' := fun y₁ y₂ => ((hact_ring σ).2.2 y₁ y₂).2.1
      map_zero' := (hact_ring σ).1
      map_add' := fun y₁ y₂ => ((hact_ring σ).2.2 y₁ y₂).1 }
  let U_pow : Finset (Finset G) := (Finset.univ : Finset G).powerset
  let P_card : ℕ → Finset (Finset G) := fun r => U_pow.filter (fun S => S.card = r)
  let P : K → Finset G → K := fun y S => ∏ s ∈ S, act s y
  let trS : G → Finset G → Finset G := fun τ S => S.image (fun s => τ * s)
  have hmem_P : ∀ (r : ℕ) (S : Finset G), S ∈ P_card r ↔ S.card = r := by
    intro r S
    simp [P_card, U_pow]
  have trS_card : ∀ (τ : G) (S : Finset G), (trS τ S).card = S.card :=
    fun τ S => Finset.card_image_of_injective S (mul_right_injective τ)
  have trS_one : ∀ (S : Finset G), trS 1 S = S := by
    intro S
    ext x
    simp [trS]
  have trS_mul : ∀ (σ τ : G) (S : Finset G), trS (σ * τ) S = trS σ (trS τ S) := by
    intro σ τ S
    ext x
    simp [trS, mul_assoc]
  have trS_mem_P : ∀ {r : ℕ} {S : Finset G}, S ∈ P_card r → ∀ (τ : G), trS τ S ∈ P_card r := by
    intro r S hS τ
    rw [hmem_P, trS_card]
    exact (hmem_P r S).mp hS
  have P_trS : ∀ (y : K) (τ : G) (S : Finset G), P y (trS τ S) = act τ (P y S) := by
    intro y τ S
    change (∏ x ∈ S.image (fun s => τ * s), act x y) = φ τ (∏ s ∈ S, act s y)
    rw [Finset.prod_image (fun s₁ _ s₂ _ h => mul_right_injective τ h), map_prod (φ τ)]
    refine Finset.prod_congr rfl fun s _ => ?_
    exact hact_mul τ s y
  
  have trS_free : ∀ {r : ℕ}, r ∈ Finset.Icc 1 (p - 1) →
      ∀ {S : Finset G}, S ∈ P_card r → ∀ {τ : G}, trS τ S = S → τ = 1 := by
    intro r hr S hS τ hfix
    obtain ⟨hge1, hle⟩ := Finset.mem_Icc.mp hr
    have hcard_S : S.card = r := (hmem_P r S).mp hS
    by_contra hτ
    have hpow_p : τ ^ p = 1 := by
      rw [← hcard_G]
      exact pow_card_eq_one
    have hord : orderOf τ = p := orderOf_eq_prime hpow_p hτ
    have hS_pos : 0 < S.card := by omega
    obtain ⟨s₀, hs₀⟩ := Finset.card_pos.mp hS_pos
    have hpow_mem : ∀ k : ℕ, τ ^ k * s₀ ∈ S := by
      intro k
      induction k with
      | zero => simp [hs₀]
      | succ k ih =>
        have hstep : τ * (τ ^ k * s₀) ∈ trS τ S :=
          Finset.mem_image_of_mem (fun s => τ * s) ih
        rw [hfix, ← mul_assoc, ← pow_succ'] at hstep
        exact hstep
    let f : Fin p → G := fun k => τ ^ k.1 * s₀
    have hMaps : Set.MapsTo f ↑(Finset.univ : Finset (Fin p)) ↑S := by
      intro k _
      exact Finset.mem_coe.mpr (hpow_mem k.1)
    have hInj : Set.InjOn f ↑(Finset.univ : Finset (Fin p)) := by
      intro k₁ _ k₂ _ heq
      have hpow_eq : τ ^ k₁.1 = τ ^ k₂.1 := mul_left_injective s₀ heq
      have hk₁ : k₁.1 ∈ Set.Iio (orderOf τ) := by
        simp only [Set.mem_Iio, hord]
        exact k₁.2
      have hk₂ : k₂.1 ∈ Set.Iio (orderOf τ) := by
        simp only [Set.mem_Iio, hord]
        exact k₂.2
      exact Fin.ext (pow_injOn_Iio_orderOf hk₁ hk₂ hpow_eq)
    have hcard_le := Finset.card_le_card_of_injOn f hMaps hInj
    simp only [Finset.card_univ, Fintype.card_fin] at hcard_le
    omega
  have trS_inj : ∀ {r : ℕ}, r ∈ Finset.Icc 1 (p - 1) →
      ∀ {S : Finset G}, S ∈ P_card r → Function.Injective (fun τ : G => trS τ S) := by
    intro r hr S hS τ₁ τ₂ heq
    dsimp only at heq
    have hfix : trS (τ₁⁻¹ * τ₂) S = S := by
      rw [trS_mul, ← heq, ← trS_mul, inv_mul_cancel, trS_one]
    exact inv_mul_eq_one.mp (trS_free hr hS hfix)
  
  let orb : Finset G → Finset (Finset G) :=
    fun S => (Finset.univ : Finset G).image (fun τ => trS τ S)
  let chooseOrb : Finset (Finset G) → Finset G :=
    fun O => if h : ∃ T, T ∈ O then Classical.choose h else ∅
  let rep : Finset G → Finset G := fun S => chooseOrb (orb S)
  let R_card : ℕ → Finset (Finset G) := fun r => (P_card r).image rep
  have mem_orb_self : ∀ (S : Finset G), S ∈ orb S := by
    intro S
    refine Finset.mem_image.mpr ⟨1, Finset.mem_univ 1, trS_one S⟩
  have orb_trS : ∀ (σ : G) (S : Finset G), orb (trS σ S) = orb S := by
    intro σ S
    ext T
    simp only [orb, Finset.mem_image, Finset.mem_univ, true_and]
    constructor
    · rintro ⟨τ, rfl⟩
      exact ⟨τ * σ, trS_mul τ σ S⟩
    · rintro ⟨ρ, rfl⟩
      refine ⟨ρ * σ⁻¹, ?_⟩
      rw [← trS_mul, inv_mul_cancel_right]
  have orb_eq_of_mem : ∀ {S T : Finset G}, T ∈ orb S → orb T = orb S := by
    intro S T hT
    obtain ⟨σ, _, rfl⟩ := Finset.mem_image.mp hT
    exact orb_trS σ S
  have rep_mem_orb : ∀ (S : Finset G), rep S ∈ orb S := by
    intro S
    have hex : ∃ T, T ∈ orb S := ⟨S, mem_orb_self S⟩
    have hdef : rep S = Classical.choose hex := dif_pos hex
    rw [hdef]
    exact Classical.choose_spec hex
  have orb_rep : ∀ (S : Finset G), orb (rep S) = orb S :=
    fun S => orb_eq_of_mem (rep_mem_orb S)
  have rep_eq_iff : ∀ (S₁ S₂ : Finset G), rep S₁ = rep S₂ ↔ orb S₁ = orb S₂ := by
    intro S₁ S₂
    constructor
    · intro h
      rw [← orb_rep S₁, h, orb_rep S₂]
    · intro h
      exact congrArg chooseOrb h
  have R_sub_P : ∀ (r : ℕ), ∀ S₀ ∈ R_card r, S₀ ∈ P_card r ∧ rep S₀ = S₀ := by
    intro r S₀ hS₀
    obtain ⟨S, hS, rfl⟩ := Finset.mem_image.mp hS₀
    obtain ⟨τ, _, hτ⟩ := Finset.mem_image.mp (rep_mem_orb S)
    refine ⟨hτ ▸ trS_mem_P hS τ, ?_⟩
    exact (rep_eq_iff (rep S) S).mpr (orb_rep S)
  have hfiber : ∀ (r : ℕ), ∀ S₀ ∈ R_card r,
      (P_card r).filter (fun S => rep S = S₀) = orb S₀ := by
    intro r S₀ hS₀
    obtain ⟨hS₀_P, hS₀_rep⟩ := R_sub_P r S₀ hS₀
    ext S
    simp only [Finset.mem_filter]
    constructor
    · rintro ⟨_, hrep⟩
      have horb : orb S = orb S₀ := (rep_eq_iff S S₀).mp (hrep.trans hS₀_rep.symm)
      rw [← horb]
      exact mem_orb_self S
    · intro hmem
      obtain ⟨τ, _, rfl⟩ := Finset.mem_image.mp hmem
      refine ⟨trS_mem_P hS₀_P τ, ?_⟩
      have horb : orb (trS τ S₀) = orb S₀ := orb_trS τ S₀
      exact ((rep_eq_iff (trS τ S₀) S₀).mpr horb).trans hS₀_rep
  let z : K → ℕ → K := fun y r => ∑ S₀ ∈ R_card r, P y S₀
  let s : K → ℕ → L := fun y r => traceLM F hLK (z y r)
  have hs_incl : ∀ (y : K) {r : ℕ}, r ∈ Finset.Icc 1 (p - 1) →
      IntermediateField.inclusion hLK (s y r) = ∑ S ∈ P_card r, P y S := by
    intro y r hr
    symm
    rw [← Finset.sum_fiberwise_of_maps_to (fun S hS => Finset.mem_image_of_mem rep hS) (P y)]
    have h1 :
        (∑ S₀ ∈ R_card r, ∑ S ∈ P_card r with rep S = S₀, P y S) =
          ∑ S₀ ∈ R_card r, ∑ τ ∈ (Finset.univ : Finset G), act τ (P y S₀) := by
      refine Finset.sum_congr rfl fun S₀ hS₀ => ?_
      have hS₀_P : S₀ ∈ P_card r := (R_sub_P r S₀ hS₀).1
      rw [hfiber r S₀ hS₀]
      change (∑ S ∈ (Finset.univ : Finset G).image (fun τ => trS τ S₀), P y S) = _
      rw [Finset.sum_image (fun τ₁ _ τ₂ _ h => trS_inj hr hS₀_P h)]
      refine Finset.sum_congr rfl fun τ _ => ?_
      exact P_trS y τ S₀
    rw [h1, Finset.sum_comm]
    have h2 :
        (∑ τ ∈ (Finset.univ : Finset G), ∑ S₀ ∈ R_card r, act τ (P y S₀)) =
          ∑ τ : G, act τ (z y r) := by
      refine Finset.sum_congr rfl fun τ _ => ?_
      exact (map_sum (φ τ) (P y) (R_card r)).symm
    rw [h2, ← hact_trace (z y r)]
  have hP1_eq : P_card 1 = (Finset.univ : Finset G).image (fun σ : G => ({σ} : Finset G)) := by
    ext S
    simp only [hmem_P, Finset.mem_image, Finset.mem_univ, true_and]
    constructor
    · intro hcard1
      obtain ⟨σ, rfl⟩ := Finset.card_eq_one.mp hcard1
      exact ⟨σ, rfl⟩
    · rintro ⟨σ, rfl⟩
      exact Finset.card_singleton σ
  have hs_one : ∀ y : K, s y 1 = traceLM F hLK y := by
    intro y
    apply (IntermediateField.inclusion hLK).injective
    change IntermediateField.inclusion hLK (s y 1) =
      IntermediateField.inclusion hLK (traceLM F hLK y)
    have hr1 : 1 ∈ Finset.Icc 1 (p - 1) := by
      rw [Finset.mem_Icc]
      omega
    rw [hs_incl y hr1, hP1_eq, Finset.sum_image (fun σ₁ _ σ₂ _ h => Finset.singleton_injective h)]
    have h1 : (∑ σ ∈ (Finset.univ : Finset G), P y {σ}) = ∑ σ : G, act σ y := by
      refine Finset.sum_congr rfl fun σ _ => ?_
      exact Finset.prod_singleton (fun s => act s y) σ
    rw [h1, ← hact_trace y]
  
  have hs_val : ∀ (y : K) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
      ∀ (q m : ℤ), (y = 0 ∨ q ≤ valL F K y) →
        (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ (r : ℤ) * q →
        (s y r = 0 ∨ m ≤ valL F L (s y r)) := by
    intro y r _hr q m hy hqm
    have hy_act : ∀ σ : G, act σ y = 0 ∨ q ≤ valL F K (act σ y) := by
      intro σ
      rcases hy with rfl | hy_val
      · exact Or.inl (hact_ring σ).1
      · right
        rw [hact_val σ y]
        exact hy_val
    have hP_val : ∀ S : Finset G, P y S = 0 ∨ (S.card : ℤ) * q ≤ valL F K (P y S) := by
      intro S
      induction S using Finset.induction_on with
      | empty =>
        right
        change ((0 : ℕ) : ℤ) * q ≤ valL F K 1
        rw [hvalK1]
        simp
      | @insert σ S' hσ ih =>
        have hP_ins : P y (insert σ S') = act σ y * P y S' := Finset.prod_insert hσ
        have hcard_ins : (insert σ S').card = S'.card + 1 := Finset.card_insert_of_notMem hσ
        rw [hP_ins, hcard_ins]
        by_cases ha : act σ y = 0
        · left; rw [ha, zero_mul]
        · by_cases hb : P y S' = 0
          · left; rw [hb, mul_zero]
          · right
            have hva : q ≤ valL F K (act σ y) := (hy_act σ).resolve_left ha
            have hvb : (S'.card : ℤ) * q ≤ valL F K (P y S') := ih.resolve_left hb
            rw [hvalK_mul (act σ y) (P y S') ha hb]
            push_cast
            linarith
    have hz_term : ∀ S₀ ∈ R_card r, P y S₀ = 0 ∨ (r : ℤ) * q ≤ valL F K (P y S₀) := by
      intro S₀ hS₀
      have hcard_S₀ : S₀.card = r := (hmem_P r S₀).mp (R_sub_P r S₀ hS₀).1
      have hval_S₀ := hP_val S₀
      rwa [hcard_S₀] at hval_S₀
    have hz_val_rq : z y r = 0 ∨ (r : ℤ) * q ≤ valL F K (z y r) := by
      change (∑ S₀ ∈ R_card r, P y S₀) = 0 ∨ (r : ℤ) * q ≤ valL F K (∑ S₀ ∈ R_card r, P y S₀)
      have hsub : ∀ T : Finset (Finset G), T ⊆ R_card r →
          (∑ S₀ ∈ T, P y S₀) = 0 ∨ (r : ℤ) * q ≤ valL F K (∑ S₀ ∈ T, P y S₀) := by
        intro T
        induction T using Finset.induction_on with
        | empty =>
          intro _
          exact Or.inl Finset.sum_empty
        | @insert S₀ T' hS₀ ih =>
          intro hT
          rw [Finset.sum_insert hS₀]
          have h1 : P y S₀ = 0 ∨ (r : ℤ) * q ≤ valL F K (P y S₀) :=
            hz_term S₀ (hT (Finset.mem_insert_self S₀ T'))
          have h2 : (∑ S ∈ T', P y S) = 0 ∨ (r : ℤ) * q ≤ valL F K (∑ S ∈ T', P y S) :=
            ih (Finset.Subset.trans (Finset.subset_insert S₀ T') hT)
          exact hvalK_add ((r : ℤ) * q) (P y S₀) (∑ S ∈ T', P y S) h1 h2
      exact hsub (R_card r) (Finset.Subset.refl (R_card r))
    have hz_val_m :
        z y r = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K (z y r) := by
      rcases hz_val_rq with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (le_trans hqm hle)
    exact htr_bound m (z y r) hz_val_m
  
  have hs_poly : ∀ (y : K) (c ε : L),
      normLM F hLK
        (IntermediateField.inclusion hLK c + IntermediateField.inclusion hLK ε * y) =
        c ^ p +
          (∑ r ∈ Finset.Icc 1 (p - 1), c ^ (p - r) * ε ^ r * s y r) +
          ε ^ p * normLM F hLK y := by
    intro y c ε
    let ι := IntermediateField.inclusion hLK
    apply ι.injective
    change ι (normLM F hLK (ι c + ι ε * y)) =
      ι (c ^ p + (∑ r ∈ Finset.Icc 1 (p - 1), c ^ (p - r) * ε ^ r * s y r) + ε ^ p * normLM F hLK y)
    have hnorm_prod :
        ι (normLM F hLK (ι c + ι ε * y)) =
          ∏ σ ∈ (Finset.univ : Finset G), (ι ε * act σ y + ι c) := by
      rw [hact_norm (ι c + ι ε * y)]
      refine Finset.prod_congr rfl fun σ _ => ?_
      rw [((hact_ring σ).2.2 (ι c) (ι ε * y)).1, ((hact_ring σ).2.2 (ι ε) y).2.1,
        hact_incl σ c, hact_incl σ ε, add_comm]
    let Q : Finset G → K := fun S => (ι c) ^ (p - S.card) * (ι ε) ^ S.card * P y S
    have hprod_powerset :
        (∏ σ ∈ (Finset.univ : Finset G), (ι ε * act σ y + ι c)) =
          ∑ S ∈ U_pow, Q S := by
      rw [Finset.prod_add (fun σ => ι ε * act σ y) (fun _ => ι c) (Finset.univ : Finset G)]
      refine Finset.sum_congr rfl fun S _ => ?_
      dsimp only [Q, P]
      rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.prod_const,
        Finset.card_sdiff_of_subset (Finset.subset_univ S), hcard_univ]
      ring
    let F_term : ℕ → K := fun r => (ι c) ^ (p - r) * (ι ε) ^ r * (∑ S ∈ P_card r, P y S)
    have hmaps_card : ∀ S ∈ U_pow, S.card ∈ Finset.range (p + 1) := by
      intro S _
      rw [Finset.mem_range]
      have hle : S.card ≤ (Finset.univ : Finset G).card := Finset.card_le_univ S
      omega
    have hsum_fiber : (∑ S ∈ U_pow, Q S) = ∑ r ∈ Finset.range (p + 1), F_term r := by
      rw [← Finset.sum_fiberwise_of_maps_to hmaps_card Q]
      refine Finset.sum_congr rfl fun r _ => ?_
      change (∑ S ∈ P_card r, Q S) = F_term r
      have h1 : (∑ S ∈ P_card r, Q S) =
          ∑ S ∈ P_card r, ((ι c) ^ (p - r) * (ι ε) ^ r * P y S) := by
        refine Finset.sum_congr rfl fun S hS => ?_
        have hcard : S.card = r := (hmem_P r S).mp hS
        dsimp only [Q]
        rw [hcard]
      rw [h1, ← Finset.mul_sum]
    have hrange_split :
        (∑ r ∈ Finset.range (p + 1), F_term r) =
          F_term 0 + (∑ r ∈ Finset.Icc 1 (p - 1), F_term r) + F_term p := by
      rw [Finset.sum_range_succ F_term p]
      have h0_mem : 0 ∈ Finset.range p := Finset.mem_range.mpr hPrime.pos
      rw [← Finset.add_sum_erase (Finset.range p) F_term h0_mem]
      have herase_eq : (Finset.range p).erase 0 = Finset.Icc 1 (p - 1) := by
        ext r
        simp only [Finset.mem_erase, Finset.mem_range, Finset.mem_Icc]
        omega
      rw [herase_eq]
    have hP0_eq : P_card 0 = {∅} := by
      ext S
      simp [hmem_P, Finset.card_eq_zero]
    have hF0 : F_term 0 = ι (c ^ p) := by
      dsimp only [F_term]
      rw [hP0_eq, Finset.sum_singleton]
      have hP_empty : P y ∅ = 1 := Finset.prod_empty
      rw [hP_empty, Nat.sub_zero, pow_zero, mul_one, mul_one, map_pow]
    have hFIcc :
        (∑ r ∈ Finset.Icc 1 (p - 1), F_term r) =
          ι (∑ r ∈ Finset.Icc 1 (p - 1), c ^ (p - r) * ε ^ r * s y r) := by
      rw [map_sum]
      refine Finset.sum_congr rfl fun r hr => ?_
      dsimp only [F_term]
      rw [← hs_incl y hr]
      simp [ι, map_mul, map_pow]
    have hPp_eq : P_card p = {Finset.univ} := by
      ext S
      simp only [hmem_P, Finset.mem_singleton]
      constructor
      · intro h
        exact Finset.eq_univ_of_card S (h.trans hcard_G.symm)
      · rintro rfl
        exact hcard_univ
    have hFp : F_term p = ι (ε ^ p * normLM F hLK y) := by
      dsimp only [F_term]
      rw [hPp_eq, Finset.sum_singleton]
      have hP_univ : P y Finset.univ = ι (normLM F hLK y) := (hact_norm y).symm
      rw [hP_univ, Nat.sub_self, pow_zero, one_mul, map_mul, map_pow]
    rw [hnorm_prod, hprod_powerset, hsum_fiber, hrange_split, hF0, hFIcc, hFp,
      ← map_add, ← map_add]
  exact ⟨hp_val, s, hs_one, hs_val, hs_poly⟩

theorem ld_wild_odd_prime_teichmuller_power_congruences (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (p b : ℕ) (hPrime : Nat.Prime p) (hp_ne2 : p ≠ 2) (hb_ge2 : 2 ≤ b)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hp_val1 : (p : L) = 0 ∨ (1 : ℤ) ≤ valL F L (p : L))
    (N : L) (hN_int : N = 0 ∨ 0 ≤ valL F L N)
    (τ_unit τ_tilde : ℕ → Lˣ)
    (hτ_def : ∀ j < p, 0 < j →
      (τ_tilde j : L) = (j : L) ^ (p ^ b) ∧
      τ_unit j = (τ_tilde j) ^ p) :
    (∀ j < p, 0 < j →
      (τ_tilde j : L) - (τ_unit j : L) = 0 ∨
        (b + 1 : ℤ) ≤ valL F L ((τ_tilde j : L) - (τ_unit j : L))) ∧
    (∀ j < p, 0 < j →
      (τ_unit j : L) ^ (p - 1) - 1 = 0 ∨
        (b + 1 : ℤ) ≤ valL F L ((τ_unit j : L) ^ (p - 1) - 1)) ∧
    ((∏ j ∈ (Finset.range p).erase 0, (N + (τ_unit j : L))) - (N ^ (p - 1) - 1) = 0 ∨
      (b + 1 : ℤ) ≤
        valL F L
          ((∏ j ∈ (Finset.range p).erase 0, (N + (τ_unit j : L))) - (N ^ (p - 1) - 1))) ∧
    (∀ r ∈ Finset.Icc 1 (2 * (p - 1)),
      (∑ j ∈ (Finset.range p).erase 0, (τ_unit j : L) ^ r) -
        (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0) = 0 ∨
        (b + 1 : ℤ) ≤
          valL F L
            ((∑ j ∈ (Finset.range p).erase 0, (τ_unit j : L) ^ r) -
              (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0))) :=
by
  have _ := hb_ge2
  rcases hvalL_props with ⟨_, hval1, _, hval_neg, hval_mul,
    _, _, hval_add, _, _, _⟩
  haveI : Fact (Nat.Prime p) := ⟨hPrime⟩
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_odd_mod : p % 2 = 1 := hPrime.eq_two_or_odd.resolve_left hp_ne2
  have hp_odd : Odd p := Nat.odd_iff.mpr hp_odd_mod
  have hp_ge3 : 3 ≤ p := by omega
  let S' : Finset ℕ := (Finset.range p).erase 0
  have hval_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F L x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F L y := hy.resolve_left hy0
        rw [hval_mul x y hx0 hy0]
        omega
  have hval_finset_sum : ∀ (T : Finset ℕ) (f : ℕ → L) (k : ℤ),
      (∀ i ∈ T, f i = 0 ∨ k ≤ valL F L (f i)) →
        ((∑ i ∈ T, f i) = 0 ∨ k ≤ valL F L (∑ i ∈ T, f i)) := by
    intro T f k hT
    induction T using Finset.induction_on with
    | empty => exact Or.inl Finset.sum_empty
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact hval_add k (f a) (∑ i ∈ s, f i)
        (hT a (Finset.mem_insert_self a s))
        (ih (fun i hi => hT i (Finset.mem_insert_of_mem hi)))
  have hval_pow_ge : ∀ (k : ℤ) (x : L) (n : ℕ),
      (x = 0 ∨ k ≤ valL F L x) →
        (x ^ n = 0 ∨ (n : ℤ) * k ≤ valL F L (x ^ n)) := by
    intro k x n hx
    induction n with
    | zero =>
      right
      rw [pow_zero, hval1, Int.ofNat_zero, zero_mul]
    | succ n ih =>
      rw [pow_succ]
      have hmul := hval_mul_ge ((n : ℤ) * k) k (x ^ n) x ih hx
      rcases hmul with h0 | hge
      · exact Or.inl h0
      · right
        have heq : ((n + 1 : ℕ) : ℤ) * k = (n : ℤ) * k + k := by
          simp only [Nat.cast_add, Nat.cast_one, add_mul, one_mul]
        rw [heq]
        exact hge
  have h1_int : (1 : L) = 0 ∨ 0 ≤ valL F L 1 := Or.inr (by omega)
  have hnat_int : ∀ m : ℕ, (m : L) = 0 ∨ 0 ≤ valL F L (m : L) := by
    intro m
    induction m with
    | zero => exact Or.inl Nat.cast_zero
    | succ m ih =>
      rw [Nat.cast_succ]
      exact hval_add 0 (m : L) 1 ih h1_int
  have hint_int : ∀ z : ℤ, (z : L) = 0 ∨ 0 ≤ valL F L (z : L) := by
    intro z
    cases z with
    | ofNat n =>
      simp only [Int.ofNat_eq_natCast, Int.cast_natCast]
      exact hnat_int n
    | negSucc n =>
      rw [Int.cast_negSucc]
      rcases hnat_int (n + 1) with h0 | hge
      · exact Or.inl (neg_eq_zero.mpr h0)
      · exact Or.inr (by rw [hval_neg]; exact hge)
  let M : ℕ := p ^ (b + 1)
  haveI : NeZero M := ⟨pow_ne_zero (b + 1) hPrime.ne_zero⟩
  have hM_val : (M : L) = 0 ∨ (b + 1 : ℤ) ≤ valL F L (M : L) := by
    dsimp [M]
    rw [Nat.cast_pow]
    rcases hval_pow_ge 1 (p : L) (b + 1) hp_val1 with h0 | hge
    · exact Or.inl h0
    · right
      simp only [Nat.cast_add, Nat.cast_one, mul_one] at hge
      exact hge
  have hzmod_to_valL : ∀ z₁ z₂ : ℤ,
      ((z₁ : ZMod M) = (z₂ : ZMod M)) →
        ((z₁ : L) - (z₂ : L) = 0 ∨ (b + 1 : ℤ) ≤ valL F L ((z₁ : L) - (z₂ : L))) := by
    intro z₁ z₂ hz
    have hdvd : (M : ℤ) ∣ (z₁ - z₂) :=
      (ZMod.intCast_eq_intCast_iff_dvd_sub z₂ z₁ M).mp hz.symm
    rcases hdvd with ⟨c, hc⟩
    have hcast : (z₁ : L) - (z₂ : L) = (M : L) * (c : L) := by
      have h1 := congrArg (Int.cast : ℤ → L) hc
      simp only [Int.cast_sub, Int.cast_mul, Int.cast_natCast] at h1
      exact h1
    rw [hcast]
    rcases hval_mul_ge (b + 1 : ℤ) 0 (M : L) (c : L) hM_val (hint_int c) with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (by omega)
  have hτ_tilde_coe : ∀ j < p, 0 < j →
      (τ_tilde j : L) = (((j : ℤ) ^ (p ^ b) : ℤ) : L) := by
    intro j hj hj0
    rw [(hτ_def j hj hj0).1]
    simp only [Int.cast_pow, Int.cast_natCast]
  have hτ_unit_coe : ∀ j < p, 0 < j →
      (τ_unit j : L) = (((j : ℤ) ^ (p ^ (b + 1)) : ℤ) : L) := by
    intro j hj hj0
    rw [(hτ_def j hj hj0).2, Units.val_pow_eq_pow_val, (hτ_def j hj hj0).1,
      ← pow_mul, ← pow_succ]
    simp only [Int.cast_pow, Int.cast_natCast]
  have hcard_units_M : Fintype.card (ZMod M)ˣ = p ^ b * (p - 1) := by
    rw [ZMod.card_units_eq_totient M]
    dsimp [M]
    rw [Nat.totient_prime_pow hPrime (Nat.succ_pos b), Nat.succ_sub_one]
  have hj_cop_p : ∀ j < p, 0 < j → Nat.Coprime j p := by
    intro j hj hj0
    exact (hPrime.coprime_iff_not_dvd.mpr (Nat.not_dvd_of_pos_of_lt hj0 hj)).symm
  have hj_cop_M : ∀ j < p, 0 < j → Nat.Coprime j M := by
    intro j hj hj0
    exact (hj_cop_p j hj hj0).pow_right (b + 1)
  have hj_zmod_pow : ∀ j < p, 0 < j →
      ((j : ZMod M) ^ (p ^ b) = (j : ZMod M) ^ (p ^ (b + 1))) ∧
      (((j : ZMod M) ^ (p ^ (b + 1))) ^ (p - 1) = 1) := by
    intro j hj hj0
    let u : (ZMod M)ˣ := ZMod.unitOfCoprime j (hj_cop_M j hj hj0)
    have hu_coe : (u : ZMod M) = (j : ZMod M) := ZMod.coe_unitOfCoprime j _
    have hu_tot : u ^ (p ^ b * (p - 1)) = 1 := by
      rw [← hcard_units_M]
      exact pow_card_eq_one
    have hval_tot : (j : ZMod M) ^ (p ^ b * (p - 1)) = 1 := by
      rw [← hu_coe, ← Units.val_pow_eq_pow_val, hu_tot, Units.val_one]
    have hM_decomp : p ^ (b + 1) = p ^ b + p ^ b * (p - 1) := by
      have hp1 : p = 1 + (p - 1) := by omega
      calc p ^ (b + 1) = p ^ b * p := pow_succ p b
        _ = p ^ b * (1 + (p - 1)) := by rw [← hp1]
        _ = p ^ b + p ^ b * (p - 1) := by ring
    have h1 : (j : ZMod M) ^ (p ^ b) = (j : ZMod M) ^ (p ^ (b + 1)) := by
      rw [hM_decomp, pow_add, hval_tot, mul_one]
    have h2 : ((j : ZMod M) ^ (p ^ (b + 1))) ^ (p - 1) = 1 := by
      rw [← h1, ← pow_mul, hval_tot]
    exact ⟨h1, h2⟩
  have hConj1 : ∀ j < p, 0 < j →
      (τ_tilde j : L) - (τ_unit j : L) = 0 ∨
        (b + 1 : ℤ) ≤ valL F L ((τ_tilde j : L) - (τ_unit j : L)) := by
    intro j hj hj0
    rw [hτ_tilde_coe j hj hj0, hτ_unit_coe j hj hj0]
    apply hzmod_to_valL ((j : ℤ) ^ (p ^ b)) ((j : ℤ) ^ (p ^ (b + 1)))
    simp only [Int.cast_pow, Int.cast_natCast]
    exact (hj_zmod_pow j hj hj0).1
  have hConj2 : ∀ j < p, 0 < j →
      (τ_unit j : L) ^ (p - 1) - 1 = 0 ∨
        (b + 1 : ℤ) ≤ valL F L ((τ_unit j : L) ^ (p - 1) - 1) := by
    intro j hj hj0
    have h1 : (τ_unit j : L) ^ (p - 1) - 1 =
        ((((j : ℤ) ^ (p ^ (b + 1))) ^ (p - 1) : ℤ) : L) - ((1 : ℤ) : L) := by
      rw [hτ_unit_coe j hj hj0]
      simp only [Int.cast_pow, Int.cast_natCast, Int.cast_one]
    rw [h1]
    apply hzmod_to_valL (((j : ℤ) ^ (p ^ (b + 1))) ^ (p - 1)) 1
    simp only [Int.cast_pow, Int.cast_natCast, Int.cast_one]
    exact (hj_zmod_pow j hj hj0).2
  have h_dvd : p ∣ M := dvd_pow_self p (Nat.succ_ne_zero b)
  let π_U : (ZMod M)ˣ →* (ZMod p)ˣ := ZMod.unitsMap h_dvd
  have hπ_surj : Function.Surjective π_U := ZMod.unitsMap_surjective h_dvd
  have hker_index : π_U.ker.index = p - 1 := by
    rw [Subgroup.index_ker, MonoidHom.range_eq_top.mpr hπ_surj, Subgroup.card_top,
      Nat.card_eq_fintype_card, ZMod.card_units p]
  have hker_card : Fintype.card π_U.ker = p ^ b := by
    have hmul := Subgroup.card_mul_index π_U.ker
    simp only [Nat.card_eq_fintype_card, hker_index, hcard_units_M] at hmul
    exact Nat.eq_of_mul_eq_mul_right (Nat.sub_pos_of_lt hPrime.one_lt) hmul
  have hpow_M_eq_of_π_eq : ∀ u v : (ZMod M)ˣ, π_U u = π_U v →
      u ^ (p ^ (b + 1)) = v ^ (p ^ (b + 1)) := by
    intro u v huv
    have hmem : u * v⁻¹ ∈ π_U.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, huv, mul_inv_cancel]
    let k_elt : π_U.ker := ⟨u * v⁻¹, hmem⟩
    have hk_pow : k_elt ^ (p ^ b) = 1 := by
      rw [← hker_card]
      exact pow_card_eq_one
    have hu_pb : (u * v⁻¹) ^ (p ^ b) = 1 := congrArg Subtype.val hk_pow
    have hu_M : (u * v⁻¹) ^ (p ^ (b + 1)) = 1 := by
      rw [pow_succ, pow_mul, hu_pb, one_pow]
    rw [mul_pow, inv_pow, mul_inv_eq_one] at hu_M
    exact hu_M
  let ω : (ZMod p)ˣ →* (ZMod M)ˣ :=
    { toFun := fun x => ((hπ_surj x).choose) ^ (p ^ (b + 1))
      map_one' := by
        have h1 : π_U ((hπ_surj 1).choose) = π_U 1 := by
          rw [(hπ_surj 1).choose_spec, map_one]
        rw [hpow_M_eq_of_π_eq _ 1 h1, one_pow]
      map_mul' := fun x y => by
        have hxy : π_U ((hπ_surj (x * y)).choose) =
            π_U ((hπ_surj x).choose * (hπ_surj y).choose) := by
          rw [(hπ_surj (x * y)).choose_spec, map_mul,
            (hπ_surj x).choose_spec, (hπ_surj y).choose_spec]
        rw [hpow_M_eq_of_π_eq _ _ hxy, mul_pow] }
  have hπ_ω : ∀ x : (ZMod p)ˣ, π_U (ω x) = x := by
    intro x
    change π_U (((hπ_surj x).choose) ^ (p ^ (b + 1))) = x
    rw [map_pow, (hπ_surj x).choose_spec]
    apply Units.ext
    rw [Units.val_pow_eq_pow_val]
    exact ZMod.pow_card_pow (n := b + 1) (x : ZMod p)
  let val_emb : (ZMod p)ˣ ↪ ℕ :=
    ⟨fun x => (x : ZMod p).val, fun x₁ x₂ h => Units.ext (ZMod.val_injective p h)⟩
  let U_univ : Finset (ZMod p)ˣ := Finset.univ
  have huniv_card : U_univ.card = p - 1 := by
    change Finset.univ.card = p - 1
    rw [Finset.card_univ, ZMod.card_units p]
  have hS'_eq_map : S' = U_univ.map val_emb := by
    ext j
    simp only [S', U_univ, Finset.mem_erase, Finset.mem_range, Finset.mem_map, Finset.mem_univ,
      true_and, val_emb, Function.Embedding.coeFn_mk]
    constructor
    · rintro ⟨hj0, hjp⟩
      refine ⟨ZMod.unitOfCoprime j (hj_cop_p j hjp (Nat.pos_of_ne_zero hj0)), ?_⟩
      rw [ZMod.coe_unitOfCoprime, ZMod.val_natCast, Nat.mod_eq_of_lt hjp]
    · rintro ⟨x, rfl⟩
      refine ⟨?_, ZMod.val_lt (x : ZMod p)⟩
      intro h0
      have hx0 : (x : ZMod p) = 0 := by
        rw [← ZMod.natCast_zmod_val (x : ZMod p), h0, Nat.cast_zero]
      exact Units.ne_zero x hx0
  have hval_emb_mem : ∀ x : (ZMod p)ˣ, val_emb x < p ∧ 0 < val_emb x := by
    intro x
    have hj_mem : val_emb x ∈ S' := by
      rw [hS'_eq_map]
      exact Finset.mem_map_of_mem val_emb (Finset.mem_univ x)
    exact ⟨Finset.mem_range.mp (Finset.mem_erase.mp hj_mem).2,
      Nat.pos_of_ne_zero (Finset.mem_erase.mp hj_mem).1⟩
  have hω_val_emb : ∀ x : (ZMod p)ˣ,
      ((val_emb x : ℕ) : ZMod M) ^ (p ^ (b + 1)) = ((ω x : (ZMod M)ˣ) : ZMod M) := by
    intro x
    obtain ⟨hj_lt, hj_pos⟩ := hval_emb_mem x
    let u : (ZMod M)ˣ := ZMod.unitOfCoprime (val_emb x) (hj_cop_M (val_emb x) hj_lt hj_pos)
    have hπ_u : π_U ((hπ_surj x).choose) = π_U u := by
      rw [(hπ_surj x).choose_spec]
      apply Units.ext
      rw [ZMod.unitsMap_val, ZMod.coe_unitOfCoprime, ZMod.cast_natCast h_dvd]
      exact (ZMod.natCast_zmod_val (x : ZMod p)).symm
    have hω_eq : ω x = u ^ (p ^ (b + 1)) := hpow_M_eq_of_π_eq _ u hπ_u
    rw [hω_eq, Units.val_pow_eq_pow_val, ZMod.coe_unitOfCoprime]
  obtain ⟨g, hg_ord⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := (ZMod p)ˣ)
  rw [Nat.card_eq_fintype_card, ZMod.card_units p] at hg_ord
  have hω_pow_sub_one_isUnit : ∀ r : ℕ, ¬ ((p - 1) ∣ r) →
      IsUnit (((ω g : (ZMod M)ˣ) : ZMod M) ^ r - 1) := by
    intro r hr_ndvd
    have hgr_ne1 : g ^ r ≠ 1 := by
      intro h1
      exact hr_ndvd (hg_ord ▸ (orderOf_dvd_iff_pow_eq_one.mpr h1))
    let δ : ZMod M := ((ω g : (ZMod M)ˣ) : ZMod M) ^ r - 1
    let φ : ZMod M →+* ZMod p := ZMod.castHom h_dvd (ZMod p)
    have hφ_ωg : φ ((ω g : (ZMod M)ˣ) : ZMod M) = (g : ZMod p) := by
      change ((ω g : (ZMod M)ˣ) : ZMod M).cast = (g : ZMod p)
      rw [← ZMod.unitsMap_val h_dvd (ω g), hπ_ω g]
    have hφ_δ : φ δ ≠ 0 := by
      change φ (((ω g : (ZMod M)ˣ) : ZMod M) ^ r - 1) ≠ 0
      rw [map_sub, map_pow, map_one, hφ_ωg, ← Units.val_pow_eq_pow_val]
      exact sub_ne_zero.mpr (fun hval => hgr_ne1 (Units.ext hval))
    have hδ_val : ((δ.val : ZMod M)) = δ := ZMod.natCast_zmod_val δ
    have hφ_val : (δ.val : ZMod p) ≠ 0 := by
      intro h0
      apply hφ_δ
      rw [← hδ_val, map_natCast, h0]
    have hndvd_p : ¬ (p ∣ δ.val) := by
      intro hdvd
      exact hφ_val ((ZMod.natCast_eq_zero_iff δ.val p).mpr hdvd)
    have hcop_M : Nat.Coprime δ.val M :=
      ((hPrime.coprime_iff_not_dvd.mpr hndvd_p).symm).pow_right (b + 1)
    change IsUnit δ
    rw [← hδ_val]
    exact (ZMod.isUnit_iff_coprime δ.val M).mpr hcop_M
  have hpower_sum_zmod : ∀ r : ℕ,
      (∑ j ∈ S', ((j : ZMod M) ^ (p ^ (b + 1))) ^ r) =
        if (p - 1) ∣ r then ((p - 1 : ℕ) : ZMod M) else 0 := by
    intro r
    rw [hS'_eq_map, Finset.sum_map]
    simp only [U_univ, hω_val_emb]
    split_ifs with hdvd
    · rcases hdvd with ⟨q, rfl⟩
      have hterm1 : ∀ x : (ZMod p)ˣ, ((ω x : (ZMod M)ˣ) : ZMod M) ^ ((p - 1) * q) = 1 := by
        intro x
        rw [← Units.val_pow_eq_pow_val, ← map_pow, pow_mul]
        have hx1 : x ^ (p - 1) = 1 := by
          rw [← ZMod.card_units p]
          exact pow_card_eq_one
        rw [hx1, one_pow, map_one, Units.val_one]
      simp only [hterm1, Finset.sum_const, Finset.card_univ, ZMod.card_units p,
        nsmul_eq_mul, mul_one]
    · let S_r : ZMod M := ∑ x : (ZMod p)ˣ, ((ω x : (ZMod M)ˣ) : ZMod M) ^ r
      have hshift : S_r = (((ω g : (ZMod M)ˣ) : ZMod M) ^ r) * S_r := by
        dsimp [S_r]
        conv_lhs =>
          rw [← Fintype.sum_equiv (Equiv.mulLeft g)
            (fun x => ((ω (g * x) : (ZMod M)ˣ) : ZMod M) ^ r)
            (fun y => ((ω y : (ZMod M)ˣ) : ZMod M) ^ r)
            (fun x => rfl)]
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun x _ => ?_)
        rw [map_mul, Units.val_mul, mul_pow]
      have hmul0 : ((((ω g : (ZMod M)ˣ) : ZMod M) ^ r) - 1) * S_r = 0 := by
        rw [sub_mul, one_mul, ← hshift, sub_self]
      exact (IsUnit.mul_right_eq_zero (hω_pow_sub_one_isUnit r hdvd)).mp hmul0
  have hConj4 : ∀ r ∈ Finset.Icc 1 (2 * (p - 1)),
      (∑ j ∈ S', (τ_unit j : L) ^ r) -
        (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0) = 0 ∨
        (b + 1 : ℤ) ≤
          valL F L
            ((∑ j ∈ S', (τ_unit j : L) ^ r) -
              (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0)) := by
    intro r _
    let z₁ : ℤ := ∑ j ∈ S', ((j : ℤ) ^ (p ^ (b + 1))) ^ r
    let z₂ : ℤ := if (p - 1) ∣ r then ((p - 1 : ℕ) : ℤ) else 0
    have hz₁_L : (∑ j ∈ S', (τ_unit j : L) ^ r) = (z₁ : L) := by
      dsimp [z₁]
      simp only [Int.cast_sum, Int.cast_pow, Int.cast_natCast]
      refine Finset.sum_congr rfl (fun j hj => ?_)
      have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
      have hj_pos : 0 < j := Nat.pos_of_ne_zero (Finset.mem_erase.mp hj).1
      rw [hτ_unit_coe j hj_lt hj_pos]
      simp only [Int.cast_pow, Int.cast_natCast]
    have hz₂_L : (if (p - 1) ∣ r then ((p - 1 : ℕ) : L) else 0) = (z₂ : L) := by
      dsimp [z₂]
      split_ifs <;> simp only [Int.cast_natCast, Int.cast_zero]
    rw [hz₁_L, hz₂_L]
    apply hzmod_to_valL z₁ z₂
    dsimp [z₁, z₂]
    simp only [Int.cast_sum, Int.cast_pow, Int.cast_natCast]
    rw [hpower_sum_zmod r]
    split_ifs <;> simp only [Int.cast_natCast, Int.cast_zero]
  have helem_symm_lt : ∀ k : ℕ, 1 ≤ k → k < p - 1 →
      (∑ U ∈ U_univ.powersetCard k,
        ∏ x ∈ U, ((val_emb x : ℕ) : ZMod M) ^ (p ^ (b + 1))) = 0 := by
    intro k hk1 hk_lt
    have h_eq : (∑ U ∈ U_univ.powersetCard k,
        ∏ x ∈ U, ((val_emb x : ℕ) : ZMod M) ^ (p ^ (b + 1))) =
        ∑ U ∈ U_univ.powersetCard k,
          ∏ x ∈ U, ((ω x : (ZMod M)ˣ) : ZMod M) := by
      refine Finset.sum_congr rfl (fun U _ => Finset.prod_congr rfl (fun x _ => hω_val_emb x))
    rw [h_eq]
    let e_k : ZMod M :=
      ∑ U ∈ U_univ.powersetCard k,
        ∏ x ∈ U, ((ω x : (ZMod M)ˣ) : ZMod M)
    change e_k = 0
    have huniv_g : U_univ.map (Equiv.mulLeft g).toEmbedding = U_univ :=
      Finset.map_univ_equiv (Equiv.mulLeft g)
    have hpow_g : (U_univ.powersetCard k).map
        (Finset.mapEmbedding (Equiv.mulLeft g).toEmbedding).toEmbedding =
        U_univ.powersetCard k := by
      rw [← Finset.powersetCard_map, huniv_g]
    have hshift : e_k = (((ω g : (ZMod M)ˣ) : ZMod M) ^ k) * e_k := by
      dsimp [e_k]
      conv_lhs => rw [← hpow_g, Finset.sum_map]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun U hU => ?_)
      change (∏ x ∈ U.map (Equiv.mulLeft g).toEmbedding, ((ω x : (ZMod M)ˣ) : ZMod M)) = _
      rw [Finset.prod_map]
      have hcard_U : U.card = k := (Finset.mem_powersetCard.mp hU).2
      have hprod : (∏ x ∈ U, ((ω ((Equiv.mulLeft g).toEmbedding x) : (ZMod M)ˣ) : ZMod M)) =
          ∏ x ∈ U, (((ω g : (ZMod M)ˣ) : ZMod M) * ((ω x : (ZMod M)ˣ) : ZMod M)) := by
        refine Finset.prod_congr rfl (fun x _ => ?_)
        change ((ω (g * x) : (ZMod M)ˣ) : ZMod M) = _
        rw [map_mul, Units.val_mul]
      rw [hprod, Finset.prod_mul_distrib, Finset.prod_const, hcard_U]
    have hmul0 : ((((ω g : (ZMod M)ˣ) : ZMod M) ^ k) - 1) * e_k = 0 := by
      rw [sub_mul, one_mul, ← hshift, sub_self]
    have hndvd : ¬ ((p - 1) ∣ k) := Nat.not_dvd_of_pos_of_lt hk1 hk_lt
    exact (IsUnit.mul_right_eq_zero (hω_pow_sub_one_isUnit k hndvd)).mp hmul0
  have helem_symm_top :
      (∑ U ∈ U_univ.powersetCard (p - 1),
        ∏ x ∈ U, ((val_emb x : ℕ) : ZMod M) ^ (p ^ (b + 1))) = -1 := by
    have h_eq : (∑ U ∈ U_univ.powersetCard (p - 1),
        ∏ x ∈ U, ((val_emb x : ℕ) : ZMod M) ^ (p ^ (b + 1))) =
        ∑ U ∈ U_univ.powersetCard (p - 1),
          ∏ x ∈ U, ((ω x : (ZMod M)ˣ) : ZMod M) := by
      refine Finset.sum_congr rfl (fun U _ => Finset.prod_congr rfl (fun x _ => hω_val_emb x))
    rw [h_eq, ← huniv_card, Finset.powersetCard_self, Finset.sum_singleton]
    have hprod_val : (∏ x ∈ U_univ, ((ω x : (ZMod M)ˣ) : ZMod M)) =
        ((ω (∏ x ∈ U_univ, x) : (ZMod M)ˣ) : ZMod M) := by
      rw [map_prod, Units.coe_prod]
    rw [hprod_val]
    change ((ω (∏ x : (ZMod p)ˣ, x) : (ZMod M)ˣ) : ZMod M) = -1
    rw [FiniteField.prod_univ_units_id_eq_neg_one]
    have hπ_neg1 : π_U ((hπ_surj (-1)).choose) = π_U (-1) := by
      rw [(hπ_surj (-1)).choose_spec]
      apply Units.ext
      dsimp [π_U]
      rw [ZMod.unitsMap_val, Units.val_neg, Units.val_one,
        ZMod.cast_neg h_dvd, ZMod.cast_one h_dvd]
    have hω_neg1 : ω (-1) = (-1 : (ZMod M)ˣ) ^ (p ^ (b + 1)) := hpow_M_eq_of_π_eq _ (-1) hπ_neg1
    rw [hω_neg1, Units.val_pow_eq_pow_val, Units.val_neg, Units.val_one,
      (hp_odd.pow).neg_one_pow]
  have hConj3 :
      ((∏ j ∈ S', (N + (τ_unit j : L))) - (N ^ (p - 1) - 1) = 0 ∨
        (b + 1 : ℤ) ≤
          valL F L ((∏ j ∈ S', (N + (τ_unit j : L))) - (N ^ (p - 1) - 1))) := by
    let e_L : ℕ → L := fun k =>
      ∑ U ∈ U_univ.powersetCard k, ∏ x ∈ U, (τ_unit (val_emb x) : L)
    let e_Z : ℕ → ℤ := fun k =>
      ∑ U ∈ U_univ.powersetCard k, ∏ x ∈ U, (val_emb x : ℤ) ^ (p ^ (b + 1))
    have he_LZ : ∀ k : ℕ, e_L k = (e_Z k : L) := by
      intro k
      dsimp [e_L, e_Z]
      simp only [Int.cast_sum, Int.cast_prod, Int.cast_pow, Int.cast_natCast]
      refine Finset.sum_congr rfl (fun U _ => Finset.prod_congr rfl (fun x _ => ?_))
      obtain ⟨hj_lt, hj_pos⟩ := hval_emb_mem x
      rw [hτ_unit_coe (val_emb x) hj_lt hj_pos]
      simp only [Int.cast_pow, Int.cast_natCast]
    have he_L0 : e_L 0 = 1 := by
      dsimp [e_L]
      rw [Finset.powersetCard_zero, Finset.sum_singleton, Finset.prod_empty]
    have hprod_expand : (∏ j ∈ S', (N + (τ_unit j : L))) =
        ∑ k ∈ Finset.range (p - 1 + 1), e_L k * N ^ (p - 1 - k) := by
      rw [hS'_eq_map, Finset.prod_map]
      have hcomm : (∏ x ∈ U_univ, (N + (τ_unit (val_emb x) : L))) =
          ∏ x ∈ U_univ, ((τ_unit (val_emb x) : L) + N) :=
        Finset.prod_congr rfl (fun x _ => add_comm N _)
      rw [hcomm, Finset.prod_add, Finset.sum_powerset, huniv_card]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      dsimp [e_L]
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl (fun U hU => ?_)
      have hU_sub : U ⊆ U_univ := (Finset.mem_powersetCard.mp hU).1
      have hU_card : U.card = k := (Finset.mem_powersetCard.mp hU).2
      rw [Finset.prod_const, Finset.card_sdiff_of_subset hU_sub, huniv_card, hU_card]
    have hp1_eq : p - 1 = (p - 2) + 1 := by omega
    have hsum_split : (∏ j ∈ S', (N + (τ_unit j : L))) - (N ^ (p - 1) - 1) =
        (∑ i ∈ Finset.range (p - 2), e_L (i + 1) * N ^ (p - 1 - (i + 1))) +
          (e_L (p - 1) - (-1 : L)) := by
      rw [hprod_expand, Finset.sum_range_succ, Nat.sub_self, pow_zero, mul_one]
      conv_lhs =>
        arg 1
        arg 1
        rw [hp1_eq, Finset.sum_range_succ' (fun k => e_L k * N ^ ((p - 2) + 1 - k)) (p - 2)]
      rw [← hp1_eq, he_L0, Nat.sub_zero, one_mul]
      ring
    rw [hsum_split]
    have hmid_val : (∑ i ∈ Finset.range (p - 2), e_L (i + 1) * N ^ (p - 1 - (i + 1))) = 0 ∨
        (b + 1 : ℤ) ≤ valL F L
          (∑ i ∈ Finset.range (p - 2), e_L (i + 1) * N ^ (p - 1 - (i + 1))) := by
      apply hval_finset_sum
      intro i hi
      have hi_lt : i < p - 2 := Finset.mem_range.mp hi
      have hk1 : 1 ≤ i + 1 := by omega
      have hk_lt : i + 1 < p - 1 := by omega
      have he_val : e_L (i + 1) = 0 ∨ (b + 1 : ℤ) ≤ valL F L (e_L (i + 1)) := by
        have hsub0 : e_L (i + 1) = (e_Z (i + 1) : L) - ((0 : ℤ) : L) := by
          rw [he_LZ (i + 1), Int.cast_zero, sub_zero]
        rw [hsub0]
        apply hzmod_to_valL (e_Z (i + 1)) 0
        dsimp [e_Z]
        simp only [Int.cast_sum, Int.cast_prod, Int.cast_pow, Int.cast_natCast, Int.cast_zero]
        exact helem_symm_lt (i + 1) hk1 hk_lt
      have hN_pow : N ^ (p - 1 - (i + 1)) = 0 ∨ 0 ≤ valL F L (N ^ (p - 1 - (i + 1))) := by
        rcases hval_pow_ge 0 N (p - 1 - (i + 1)) hN_int with h0 | hge
        · exact Or.inl h0
        · exact Or.inr (by omega)
      rcases hval_mul_ge (b + 1 : ℤ) 0 (e_L (i + 1)) (N ^ (p - 1 - (i + 1))) he_val hN_pow
        with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have htop_val : e_L (p - 1) - (-1 : L) = 0 ∨
        (b + 1 : ℤ) ≤ valL F L (e_L (p - 1) - (-1 : L)) := by
      have hsub1 : e_L (p - 1) - (-1 : L) = (e_Z (p - 1) : L) - ((-1 : ℤ) : L) := by
        rw [he_LZ (p - 1), Int.cast_neg, Int.cast_one]
      rw [hsub1]
      apply hzmod_to_valL (e_Z (p - 1)) (-1)
      dsimp [e_Z]
      simp only [Int.cast_sum, Int.cast_prod, Int.cast_pow, Int.cast_natCast,
        Int.cast_neg, Int.cast_one]
      exact helem_symm_top
    exact hval_add (b + 1 : ℤ) _ _ hmid_val htop_val
  exact ⟨hConj1, hConj2, hConj3, hConj4⟩

theorem ld_wild_low_cond_phase_factor_reduction (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLK)) ↔ ν₁ x = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hSpecL_triv : ∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1)
    (s : K → ℕ → L)
    (hs_one : ∀ y : K, s y 1 = traceLM F hLK y)
    (c_τ : Lˣ) (u : Kˣ) (N : Lˣ)
    (τ_unit τ_tilde c_ν c_twist : ℕ → Lˣ) (c_χ : Lˣ) (c_χK : Kˣ)
    (hc_τ_val : valL F L (c_τ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hc_χ_eq : c_χ = c_τ * N⁻¹)
    (hc_χK_inv : ((c_χK⁻¹ : Kˣ) : K) =
      IntermediateField.inclusion hLK (((c_τ⁻¹ : Lˣ) : L)) *
        (IntermediateField.inclusion hLK (N : L) - (u : K)))
    (hτ_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
      (τ_tilde j : L) = (j : L) ^ ((Module.finrank L (IntermediateField.extendScalars hLK)) ^ (condExp F L ν₁)) ∧
      τ_unit j = (τ_tilde j) ^ (Module.finrank L (IntermediateField.extendScalars hLK)) ∧
      Units.map (normLM F hLK) (Units.map (IntermediateField.inclusion hLK).toMonoidHom (τ_tilde j)) = τ_unit j ∧
      ν₁ (τ_unit j) = 1 ∧
      c_ν j = c_τ * (τ_unit j)⁻¹ ∧
      (N : L) + (τ_unit j : L) ≠ 0 ∧
      valL F L ((N : L) + (τ_unit j : L)) = 0 ∧
      (((c_twist j)⁻¹ : Lˣ) : L) = ((c_τ⁻¹ : Lˣ) : L) * ((N : L) + (τ_unit j : L)))
    (hc_χ_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ⁻¹ : Lˣ) : L) * x))
    (hc_ν_twist : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
      valL F L (c_ν j : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ ∧
      (∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          ((ν₁ ^ j) (Units.mk0 (1 + x) hx) : Ω F) = ψ ((((c_ν j)⁻¹ : Lˣ) : L) * x)) ∧
      valL F L (c_twist j : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ ∧
      (∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
        ∀ hx : 1 + x ≠ 0,
          ((ν₁ ^ j * χ') (Units.mk0 (1 + x) hx) : Ω F) =
            ψ ((((c_twist j)⁻¹ : Lˣ) : L) * x)))
    (z₀ : Lˣ) (z : ℕ → Lˣ)
    (hz₀_norm : normLM F hLK (IntermediateField.inclusion hLK (N : L) - (u : K)) =
      (N : L) * (∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
        ((N : L) + (τ_unit j : L))) * (z₀ : L))
    (hz₀_val : (z₀ : L) - 1 = 0 ∨
      (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L ((z₀ : L) - 1))
    (hz_norm : ∀ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
      ∃ w_j : Kˣ, normLM F hLK (w_j : K) = ((N : L) + (τ_unit j : L)) * (z j : L))
    (hz_val : ∀ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
      (z j : L) - 1 = 0 ∨
        (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L ((z j : L) - 1))
    (hX_val :
      let S' := (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0
      let X := s (u : K) 1 + (N : L) * ((z₀ : L) - 1) +
        ∑ j ∈ S', (τ_unit j : L) * ((z j : L) - 1)
      X = 0 ∨ (condExp F L ν₁ : ℤ) ≤ valL F L X) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    let S' := (Finset.range p).erase 0
    (((χ'.comp (Units.map (normLM F hLK))) c_χK : Ω F) *
      (∏ j ∈ S', ((ν₁ ^ j) (c_ν j) : Ω F)) *
      (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K)) *
      (∏ j ∈ S', ψ ((((c_ν j)⁻¹ : Lˣ) : L)))) =
    ((χ' c_χ : Ω F) *
      (∏ j ∈ S', ((ν₁ ^ j * χ') (c_twist j) : Ω F)) *
      ψ (((c_χ⁻¹ : Lˣ) : L)) *
      (∏ j ∈ S', ψ ((((c_twist j)⁻¹ : Lˣ) : L)))) :=
by
  intro p S'
  let K' := IntermediateField.extendScalars hLK
  set A : L := ((c_τ⁻¹ : Lˣ) : L)
  set b : ℕ := condExp F L ν₁
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have h0_mem : 0 ∈ Finset.range p := Finset.mem_range.mpr hp_pos
  have hS'_card : S'.card = p - 1 := by
    dsimp [S']
    rw [Finset.card_erase_of_mem h0_mem, Finset.card_range]
  have hS'_mem : ∀ j ∈ S', j < p ∧ 0 < j := by
    intro j hj
    have hj_ne0 : j ≠ 0 := (Finset.mem_erase.mp hj).1
    have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    exact ⟨hj_lt, Nat.pos_of_ne_zero hj_ne0⟩
  have hto_inc : ∀ x : L,
      toExtendScalars F hLK (IntermediateField.inclusion hLK x) = algebraMap L K' x :=
    fun _ => rfl
  have htrace_incl : ∀ x : L,
      traceLM F hLK (IntermediateField.inclusion hLK x) = (p : L) * x := by
    intro x
    change Algebra.trace L K' (toExtendScalars F hLK (IntermediateField.inclusion hLK x)) =
      (Module.finrank L K' : L) * x
    rw [hto_inc x, Algebra.trace_algebraMap, nsmul_eq_mul]
  have htrace_smul : ∀ (x : L) (y : K),
      traceLM F hLK (IntermediateField.inclusion hLK x * y) = x * traceLM F hLK y := by
    intro x y
    letI : Module L L := Semiring.toModule
    change Algebra.trace L K' (toExtendScalars F hLK (IntermediateField.inclusion hLK x * y)) =
      x * Algebra.trace L K' (toExtendScalars F hLK y)
    rw [map_mul, hto_inc x, ← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]
  have hnorm_incl : ∀ x : L,
      normLM F hLK (IntermediateField.inclusion hLK x) = x ^ p := by
    intro x
    change Algebra.norm L (toExtendScalars F hLK (IntermediateField.inclusion hLK x)) =
      x ^ Module.finrank L K'
    rw [hto_inc x, Algebra.norm_algebraMap]
  have hψ_sum : ∀ (T : Finset ℕ) (f : ℕ → L),
      ψ (∑ j ∈ T, f j) = ∏ j ∈ T, ψ (f j) := by
    intro T f
    induction T using Finset.induction_on with
    | empty => simp [AddChar.map_zero_eq_one]
    | @insert j T hj ih =>
      rw [Finset.sum_insert hj, AddChar.map_add_eq_mul, ih, Finset.prod_insert hj]
  have hc_χ_inv_coe : ((c_χ⁻¹ : Lˣ) : L) = A * (N : L) := by
    have h1 : c_χ⁻¹ = c_τ⁻¹ * N := by
      rw [hc_χ_eq, mul_inv_rev, inv_inv, mul_comm]
    rw [h1, Units.val_mul]
  have hc_ν_inv_coe : ∀ j ∈ S', (((c_ν j)⁻¹ : Lˣ) : L) = A * (τ_unit j : L) := by
    intro j hj
    obtain ⟨hj_lt, hj_pos⟩ := hS'_mem j hj
    have h1 : (c_ν j)⁻¹ = c_τ⁻¹ * τ_unit j := by
      rw [(hτ_props j hj_lt hj_pos).2.2.2.2.1, mul_inv_rev, inv_inv, mul_comm]
    rw [h1, Units.val_mul]
  have hc_twist_inv_coe : ∀ j ∈ S',
      (((c_twist j)⁻¹ : Lˣ) : L) = A * ((N : L) + (τ_unit j : L)) := by
    intro j hj
    obtain ⟨hj_lt, hj_pos⟩ := hS'_mem j hj
    exact (hτ_props j hj_lt hj_pos).2.2.2.2.2.2.2
  have hν₁_c_ν : ∀ j ∈ S', ν₁ (c_ν j) = ν₁ c_τ := by
    intro j hj
    obtain ⟨hj_lt, hj_pos⟩ := hS'_mem j hj
    rw [(hτ_props j hj_lt hj_pos).2.2.2.2.1, map_mul, map_inv,
      (hτ_props j hj_lt hj_pos).2.2.2.1, inv_one, mul_one]
  set u_χK : Lˣ := Units.map (normLM F hLK) c_χK
  have hu_χK_inv : u_χK⁻¹ = c_χ⁻¹ * (∏ j ∈ S', (c_twist j)⁻¹) * z₀ := by
    apply Units.ext
    have hL : ((u_χK⁻¹ : Lˣ) : L) =
        A ^ p * ((N : L) * (∏ j ∈ S', ((N : L) + (τ_unit j : L))) * (z₀ : L)) := by
      have hmap : u_χK⁻¹ = Units.map (normLM F hLK) (c_χK⁻¹) :=
        (map_inv (Units.map (normLM F hLK)) c_χK).symm
      rw [hmap, Units.coe_map, hc_χK_inv, map_mul,
        hnorm_incl A, hz₀_norm]
    have hR : ((c_χ⁻¹ * (∏ j ∈ S', (c_twist j)⁻¹) * z₀ : Lˣ) : L) =
        (A * (N : L)) * (A ^ (p - 1) * (∏ j ∈ S', ((N : L) + (τ_unit j : L)))) * (z₀ : L) := by
      rw [Units.val_mul, Units.val_mul, hc_χ_inv_coe, Units.coe_prod,
        Finset.prod_congr rfl hc_twist_inv_coe, Finset.prod_mul_distrib,
        Finset.prod_const, hS'_card]
    have hp_pow : A ^ p = A * A ^ (p - 1) := by
      conv_lhs => rw [← Nat.sub_add_cancel hp_pos, pow_add, pow_one, mul_comm]
    rw [hL, hR, hp_pow]
    ring
  have hu_χK_z₀ : u_χK * z₀ = c_χ * (∏ j ∈ S', c_twist j) := by
    have h2 : (c_χ * ∏ j ∈ S', c_twist j) * u_χK⁻¹ = z₀ := by
      rw [hu_χK_inv, Finset.prod_inv_distrib, ← mul_inv, ← mul_assoc, mul_inv_cancel, one_mul]
    rw [← h2, mul_comm (c_χ * _), ← mul_assoc, mul_inv_cancel, one_mul]
  have hχ'_mult :
      ((χ'.comp (Units.map (normLM F hLK))) c_χK : Ω F) * (χ' z₀ : Ω F) =
        (χ' c_χ : Ω F) * (∏ j ∈ S', (χ' (c_twist j) : Ω F)) := by
    have h1 := congrArg (fun u : Lˣ => (χ' u : Ω F)) hu_χK_z₀
    dsimp only at h1
    rw [map_mul, Units.val_mul, map_mul, Units.val_mul, map_prod, Units.coe_prod] at h1
    exact h1
  have hν_twist_j : ∀ j ∈ S',
      ((ν₁ ^ j * χ') (c_twist j) : Ω F) =
        ((ν₁ ^ j) (c_ν j) : Ω F) * ((ν₁ ^ j) (z j) : Ω F) * (χ' (c_twist j) : Ω F) := by
    intro j hj
    obtain ⟨w_j, hw_j⟩ := hz_norm j hj
    have hunit_eq : c_τ * (c_twist j)⁻¹ * z j = Units.map (normLM F hLK) w_j := by
      apply Units.ext
      rw [Units.val_mul, Units.val_mul, hc_twist_inv_coe j hj, Units.coe_map, hw_j]
      calc (c_τ : L) * (A * ((N : L) + (τ_unit j : L))) * (z j : L)
        _ = ((c_τ : L) * A) * (((N : L) + (τ_unit j : L)) * (z j : L)) := by ring
        _ = 1 * (((N : L) + (τ_unit j : L)) * (z j : L)) := by
          rw [show (c_τ : L) * A = ((c_τ * c_τ⁻¹ : Lˣ) : L) from rfl,
            mul_inv_cancel, Units.val_one]
        _ = ((N : L) + (τ_unit j : L)) * (z j : L) := one_mul _
    have hν₁_one : ν₁ (c_τ * (c_twist j)⁻¹ * z j) = 1 := by
      rw [hunit_eq]
      exact (hν₁_ker _).mp ⟨w_j, rfl⟩
    have hν₁_eq : ν₁ (c_twist j) = ν₁ (c_ν j) * ν₁ (z j) := by
      rw [hν₁_c_ν j hj]
      calc ν₁ (c_twist j)
        _ = ν₁ (c_twist j) * ν₁ (c_τ * (c_twist j)⁻¹ * z j) := by
          rw [hν₁_one, mul_one]
        _ = ν₁ (c_twist j * (c_τ * (c_twist j)⁻¹ * z j)) := (map_mul _ _ _).symm
        _ = ν₁ (c_τ * z j) := by
          congr 1
          rw [mul_comm c_τ, ← mul_assoc, ← mul_assoc, mul_inv_cancel, one_mul]
        _ = ν₁ c_τ * ν₁ (z j) := map_mul _ _ _
    rw [MonoidHom.mul_apply, Units.val_mul, MonoidHom.pow_apply, MonoidHom.pow_apply,
      MonoidHom.pow_apply, hν₁_eq, mul_pow, Units.val_mul]
  have hMult_all :
      (χ' c_χ : Ω F) * (∏ j ∈ S', ((ν₁ ^ j * χ') (c_twist j) : Ω F)) =
        ((χ'.comp (Units.map (normLM F hLK))) c_χK : Ω F) *
          (∏ j ∈ S', ((ν₁ ^ j) (c_ν j) : Ω F)) *
          (χ' z₀ : Ω F) *
          (∏ j ∈ S', ((ν₁ ^ j) (z j) : Ω F)) := by
    rw [Finset.prod_congr rfl hν_twist_j, Finset.prod_mul_distrib, Finset.prod_mul_distrib]
    calc (χ' c_χ : Ω F) *
          (((∏ j ∈ S', ((ν₁ ^ j) (c_ν j) : Ω F)) *
            (∏ j ∈ S', ((ν₁ ^ j) (z j) : Ω F))) *
            (∏ j ∈ S', (χ' (c_twist j) : Ω F)))
      _ = ((χ' c_χ : Ω F) * (∏ j ∈ S', (χ' (c_twist j) : Ω F))) *
          (∏ j ∈ S', ((ν₁ ^ j) (c_ν j) : Ω F)) *
          (∏ j ∈ S', ((ν₁ ^ j) (z j) : Ω F)) := by ring
      _ = (((χ'.comp (Units.map (normLM F hLK))) c_χK : Ω F) * (χ' z₀ : Ω F)) *
          (∏ j ∈ S', ((ν₁ ^ j) (c_ν j) : Ω F)) *
          (∏ j ∈ S', ((ν₁ ^ j) (z j) : Ω F)) := by rw [← hχ'_mult]
      _ = ((χ'.comp (Units.map (normLM F hLK))) c_χK : Ω F) *
          (∏ j ∈ S', ((ν₁ ^ j) (c_ν j) : Ω F)) *
          (χ' z₀ : Ω F) *
          (∏ j ∈ S', ((ν₁ ^ j) (z j) : Ω F)) := by ring
  have hχ'_z₀ : (χ' z₀ : Ω F) = ψ (A * (N : L) * ((z₀ : L) - 1)) := by
    have hx₀ : 1 + ((z₀ : L) - 1) ≠ 0 := by
      rw [add_sub_cancel]; exact Units.ne_zero z₀
    have hmk0 : Units.mk0 (1 + ((z₀ : L) - 1)) hx₀ = z₀ := by
      ext; simp [add_sub_cancel]
    have hstat := hc_χ_stat ((z₀ : L) - 1) hz₀_val hx₀
    rw [hmk0, hc_χ_inv_coe] at hstat
    exact hstat
  have hν_zj : ∀ j ∈ S',
      ((ν₁ ^ j) (z j) : Ω F) = ψ (A * (τ_unit j : L) * ((z j : L) - 1)) := by
    intro j hj
    obtain ⟨hj_lt, hj_pos⟩ := hS'_mem j hj
    have hxj : 1 + ((z j : L) - 1) ≠ 0 := by
      rw [add_sub_cancel]; exact Units.ne_zero (z j)
    have hmk0 : Units.mk0 (1 + ((z j : L) - 1)) hxj = z j := by
      ext; simp [add_sub_cancel]
    have hstat := (hc_ν_twist j hj_lt hj_pos).2.1 ((z j : L) - 1) (hz_val j hj) hxj
    rw [hmk0, hc_ν_inv_coe j hj] at hstat
    exact hstat
  have htr_c_χK :
      traceLM F hLK (((c_χK⁻¹ : Kˣ) : K)) =
        A * ((p : L) * (N : L)) - A * s (u : K) 1 := by
    rw [hc_χK_inv, mul_sub, map_sub, htrace_smul A (IntermediateField.inclusion hLK (N : L)),
      htrace_incl (N : L), htrace_smul A (u : K), hs_one (u : K)]
  have hsum_ν :
      (∑ j ∈ S', (((c_ν j)⁻¹ : Lˣ) : L)) = ∑ j ∈ S', A * (τ_unit j : L) :=
    Finset.sum_congr rfl hc_ν_inv_coe
  have hsum_twist :
      (∑ j ∈ S', (((c_twist j)⁻¹ : Lˣ) : L)) =
        ((p - 1 : ℕ) : L) * (A * (N : L)) + ∑ j ∈ S', A * (τ_unit j : L) := by
    calc (∑ j ∈ S', (((c_twist j)⁻¹ : Lˣ) : L))
      _ = ∑ j ∈ S', (A * (N : L) + A * (τ_unit j : L)) := by
        apply Finset.sum_congr rfl
        intro j hj
        rw [hc_twist_inv_coe j hj, mul_add]
      _ = (∑ _j ∈ S', A * (N : L)) + ∑ j ∈ S', A * (τ_unit j : L) :=
        Finset.sum_add_distrib
      _ = ((p - 1 : ℕ) : L) * (A * (N : L)) + ∑ j ∈ S', A * (τ_unit j : L) := by
        rw [Finset.sum_const, hS'_card, nsmul_eq_mul]
  set X : L := s (u : K) 1 + (N : L) * ((z₀ : L) - 1) +
    ∑ j ∈ S', (τ_unit j : L) * ((z j : L) - 1)
  have hA_val : valL F L A = -((b : ℤ) + condExpChar F L ψ) := by
    dsimp [A, b]
    rw [hvalL_props.2.2.2.2.2.1 c_τ, hc_τ_val]
  have hAX_val : A * X = 0 ∨ -condExpChar F L ψ ≤ valL F L (A * X) := by
    rcases hX_val with hX0 | hX_ge
    · exact Or.inl (by rw [show X = 0 from hX0, mul_zero])
    · by_cases hAX0 : A * X = 0
      · exact Or.inl hAX0
      · right
        have hA_ne0 : A ≠ 0 := left_ne_zero_of_mul hAX0
        have hX_ne0 : X ≠ 0 := right_ne_zero_of_mul hAX0
        rw [hvalL_props.2.2.2.2.1 A X hA_ne0 hX_ne0, hA_val]
        have hX_ge' : (b : ℤ) ≤ valL F L X := hX_ge
        omega
  have hψ_AX : ψ (A * X) = 1 := hSpecL_triv (A * X) hAX_val
  set E_LHS : L := traceLM F hLK (((c_χK⁻¹ : Kˣ) : K)) + ∑ j ∈ S', (((c_ν j)⁻¹ : Lˣ) : L)
  set E_RHS : L :=
    A * (N : L) * ((z₀ : L) - 1) +
      (∑ j ∈ S', A * (τ_unit j : L) * ((z j : L) - 1)) +
      ((c_χ⁻¹ : Lˣ) : L) +
      (∑ j ∈ S', (((c_twist j)⁻¹ : Lˣ) : L))
  have hp_cast : ((p - 1 : ℕ) : L) + 1 = (p : L) := by
    calc ((p - 1 : ℕ) : L) + 1
      _ = ((p - 1 : ℕ) : L) + ((1 : ℕ) : L) := by rw [Nat.cast_one]
      _ = ((p - 1 + 1 : ℕ) : L) := (Nat.cast_add (p - 1) 1).symm
      _ = (p : L) := by rw [Nat.sub_add_cancel hp_pos]
  have hAX_expand :
      A * X = A * s (u : K) 1 + A * ((N : L) * ((z₀ : L) - 1)) +
        ∑ j ∈ S', A * (τ_unit j : L) * ((z j : L) - 1) := by
    dsimp [X]
    rw [mul_add, mul_add, Finset.mul_sum]
    congr 1
    exact Finset.sum_congr rfl (fun _ _ => (mul_assoc _ _ _).symm)
  have hE_eq : E_RHS = E_LHS + A * X := by
    rw [hAX_expand]
    dsimp [E_RHS, E_LHS]
    rw [htr_c_χK, hsum_ν, hc_χ_inv_coe, hsum_twist, ← hp_cast]
    ring
  have hψ_LHS :
      (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K)) *
        (∏ j ∈ S', ψ ((((c_ν j)⁻¹ : Lˣ) : L))) = ψ E_LHS := by
    change ψ (traceLM F hLK (((c_χK⁻¹ : Kˣ) : K))) *
      (∏ j ∈ S', ψ ((((c_ν j)⁻¹ : Lˣ) : L))) = ψ E_LHS
    rw [← hψ_sum, ← AddChar.map_add_eq_mul]
  have hψ_RHS :
      (χ' z₀ : Ω F) * (∏ j ∈ S', ((ν₁ ^ j) (z j) : Ω F)) *
        ψ (((c_χ⁻¹ : Lˣ) : L)) * (∏ j ∈ S', ψ ((((c_twist j)⁻¹ : Lˣ) : L))) =
        ψ E_RHS := by
    rw [hχ'_z₀, Finset.prod_congr rfl hν_zj, ← hψ_sum, ← hψ_sum,
      ← AddChar.map_add_eq_mul, ← AddChar.map_add_eq_mul, ← AddChar.map_add_eq_mul]
  have hψ_eq : ψ E_RHS = ψ E_LHS := by
    rw [hE_eq, AddChar.map_add_eq_mul, hψ_AX, mul_one]
  calc ((χ'.comp (Units.map (normLM F hLK))) c_χK : Ω F) *
        (∏ j ∈ S', ((ν₁ ^ j) (c_ν j) : Ω F)) *
        (traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K)) *
        (∏ j ∈ S', ψ ((((c_ν j)⁻¹ : Lˣ) : L)))
    _ = ((χ'.comp (Units.map (normLM F hLK))) c_χK : Ω F) *
        (∏ j ∈ S', ((ν₁ ^ j) (c_ν j) : Ω F)) *
        ((traceChar F hLK ψ) (((c_χK⁻¹ : Kˣ) : K)) *
          (∏ j ∈ S', ψ ((((c_ν j)⁻¹ : Lˣ) : L)))) := by ring
    _ = ((χ'.comp (Units.map (normLM F hLK))) c_χK : Ω F) *
        (∏ j ∈ S', ((ν₁ ^ j) (c_ν j) : Ω F)) *
        ((χ' z₀ : Ω F) * (∏ j ∈ S', ((ν₁ ^ j) (z j) : Ω F)) *
          ψ (((c_χ⁻¹ : Lˣ) : L)) * (∏ j ∈ S', ψ ((((c_twist j)⁻¹ : Lˣ) : L)))) := by
      rw [hψ_LHS, ← hψ_eq, ← hψ_RHS]
    _ = ((χ'.comp (Units.map (normLM F hLK))) c_χK : Ω F) *
        (∏ j ∈ S', ((ν₁ ^ j) (c_ν j) : Ω F)) *
        (χ' z₀ : Ω F) *
        (∏ j ∈ S', ((ν₁ ^ j) (z j) : Ω F)) *
        ψ (((c_χ⁻¹ : Lˣ) : L)) *
        (∏ j ∈ S', ψ ((((c_twist j)⁻¹ : Lˣ) : L))) := by ring
    _ = (χ' c_χ : Ω F) *
        (∏ j ∈ S', ((ν₁ ^ j * χ') (c_twist j) : Ω F)) *
        ψ (((c_χ⁻¹ : Lˣ) : L)) *
        (∏ j ∈ S', ψ ((((c_twist j)⁻¹ : Lˣ) : L))) := by rw [← hMult_all]

theorem ld_wild_low_cond_dyadic_correction_units (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hp2 : Module.finrank L (IntermediateField.extendScalars hLK) = 2)
    (a b t : ℕ) (ha_ge2 : 2 ≤ a) (hab : a ≤ b) (ht_ge1 : 1 ≤ t) (hb_eq : b = t + 1)
    (hNonDyadic : a < b ∨ b % 2 = 0)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hp_val : (Module.finrank L (IntermediateField.extendScalars hLK) : L) = 0 ∨
      ((((Module.finrank L (IntermediateField.extendScalars hLK) - 1) * (t + 1) /
        Module.finrank L (IntermediateField.extendScalars hLK) : ℕ) : ℤ) ≤
        valL F L (Module.finrank L (IntermediateField.extendScalars hLK) : L)))
    (s : K → ℕ → L)
    (hs_val : ∀ (y : K) (r : ℕ),
      r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1) →
      ∀ (q m : ℤ), (y = 0 ∨ q ≤ valL F K y) →
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ (r : ℤ) * q →
        (s y r = 0 ∨ m ≤ valL F L (s y r)))
    (hs_poly : ∀ (y : K) (c ε : L),
      normLM F hLK
        (IntermediateField.inclusion hLK c + IntermediateField.inclusion hLK ε * y) =
        c ^ (Module.finrank L (IntermediateField.extendScalars hLK)) +
          (∑ r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1),
            c ^ (Module.finrank L (IntermediateField.extendScalars hLK) - r) * ε ^ r * s y r) +
          ε ^ (Module.finrank L (IntermediateField.extendScalars hLK)) * normLM F hLK y)
    (u : Kˣ) (N : Lˣ) (τ_unit τ_tilde : ℕ → Lˣ)
    (hu_norm : Units.map (normLM F hLK) u = N)
    (hu_val : valL F K (u : K) = (b - a : ℤ))
    (hτ_1 : (τ_tilde 1 : L) = 1 ∧ (τ_unit 1 : L) = 1 ∧
      (N : L) + (τ_unit 1 : L) ≠ 0 ∧ valL F L ((N : L) + (τ_unit 1 : L)) = 0) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    let S' := (Finset.range p).erase 0
    ∃ (z₀ : Lˣ) (z : ℕ → Lˣ),
      normLM F hLK (IntermediateField.inclusion hLK (N : L) - (u : K)) =
        (N : L) * (∏ j ∈ S', ((N : L) + (τ_unit j : L))) * (z₀ : L) ∧
      ((z₀ : L) - 1 = 0 ∨ (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F L ((z₀ : L) - 1)) ∧
      (∀ j ∈ S', ∃ w_j : Kˣ, normLM F hLK (w_j : K) = ((N : L) + (τ_unit j : L)) * (z j : L)) ∧
      (∀ j ∈ S', (z j : L) - 1 = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F L ((z j : L) - 1)) ∧
      (let X := s (u : K) 1 + (N : L) * ((z₀ : L) - 1) + ∑ j ∈ S', (τ_unit j : L) * ((z j : L) - 1)
       X = 0 ∨ (b : ℤ) ≤ valL F L X) :=
by
  intro p S'
  have hp_eq : p = 2 := hp2
  have hS' : S' = {1} := by
    change (Finset.range p).erase 0 = {1}
    rw [hp_eq]
    decide
  have hIcc : Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1) = {1} := by
    rw [hp2]
    decide
  set m₁ : ℕ := (2 * b - a) / 2
  have hm₁_ge1 : 1 ≤ m₁ := by omega
  have ha_le_m₁ : (((a + 1) / 2 : ℕ) : ℤ) ≤ (m₁ : ℤ) := by omega
  have hb_le_m₁ : (((b + 1) / 2 : ℕ) : ℤ) ≤ (m₁ : ℤ) := by omega
  have hb_le_sum : (b : ℤ) ≤ ((b / 2 : ℕ) : ℤ) + (m₁ : ℤ) := by omega
  have h_hs_ineq :
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * (m₁ : ℤ) -
        ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤
      (1 : ℤ) * (b - a : ℤ) := by
    rw [hp2]
    omega
  set s₁ : L := s (u : K) 1
  set U₁ : L := (N : L) + (τ_unit 1 : L)
  have hs₁_val : s₁ = 0 ∨ (m₁ : ℤ) ≤ valL F L s₁ :=
    hs_val (u : K) 1 (by rw [hIcc]; simp) (b - a : ℤ) (m₁ : ℤ)
      (Or.inr (le_of_eq hu_val.symm)) h_hs_ineq
  have hτ_unit1 : (τ_unit 1 : L) = 1 := hτ_1.2.1
  have hU₁_ne : U₁ ≠ 0 := hτ_1.2.2.1
  have hU₁_val : valL F L U₁ = 0 := hτ_1.2.2.2
  have hU₁_eq : U₁ = (N : L) + 1 := by simp [U₁, hτ_unit1]
  have hU₁_inv : U₁ * U₁⁻¹ = 1 := mul_inv_cancel₀ hU₁_ne
  let u_U₁ : Lˣ := Units.mk0 U₁ hU₁_ne
  have hU₁_inv_val : valL F L U₁⁻¹ = 0 := by
    have h1 := hvalL_props.2.2.2.2.2.1 u_U₁
    have h2 : ((u_U₁⁻¹ : Lˣ) : L) = U₁⁻¹ := by simp [u_U₁]
    have h3 : (u_U₁ : L) = U₁ := by simp [u_U₁]
    rw [h2, h3, hU₁_val] at h1
    omega
  set δ₁ : L := s₁ * U₁⁻¹
  have hδ₁_val : δ₁ = 0 ∨ (m₁ : ℤ) ≤ valL F L δ₁ := by
    rcases hs₁_val with hs₁0 | hs₁_ge
    · left
      simp [δ₁, hs₁0]
    · by_cases hs₁_ne : s₁ = 0
      · left
        simp [δ₁, hs₁_ne]
      · right
        have hmul := hvalL_props.2.2.2.2.1 s₁ U₁⁻¹ hs₁_ne (inv_ne_zero hU₁_ne)
        change valL F L δ₁ = valL F L s₁ + valL F L U₁⁻¹ at hmul
        omega
  have hneg_δ₁_val : -δ₁ = 0 ∨ (m₁ : ℤ) ≤ valL F L (-δ₁) := by
    rcases hδ₁_val with h0 | hge
    · left
      simp [h0]
    · right
      rw [hvalL_props.2.2.2.1 δ₁]
      exact hge
  have h_one_sub_ne : 1 - δ₁ ≠ 0 := by
    intro h0
    have hδ₁_eq1 : δ₁ = 1 := (sub_eq_zero.mp h0).symm
    rcases hδ₁_val with hδ₁0 | hδ₁_ge
    · exact one_ne_zero (hδ₁_eq1.symm.trans hδ₁0)
    · rw [hδ₁_eq1, hvalL_props.2.1] at hδ₁_ge
      omega
  have h_one_add_ne : 1 + δ₁ ≠ 0 := by
    intro h0
    have hneg_eq1 : -δ₁ = 1 := by linear_combination -h0
    rcases hneg_δ₁_val with hneg0 | hneg_ge
    · exact one_ne_zero (hneg_eq1.symm.trans hneg0)
    · rw [hneg_eq1, hvalL_props.2.1] at hneg_ge
      omega
  let z₀ : Lˣ := Units.mk0 (1 - δ₁) h_one_sub_ne
  let z : ℕ → Lˣ := fun _ => Units.mk0 (1 + δ₁) h_one_add_ne
  have hz₀_coe : (z₀ : L) = 1 - δ₁ := Units.val_mk0 h_one_sub_ne
  have hz_coe : ∀ j, (z j : L) = 1 + δ₁ := fun _ => Units.val_mk0 h_one_add_ne
  have hz₀_sub : (z₀ : L) - 1 = -δ₁ := by rw [hz₀_coe]; ring
  have hz_sub : ∀ j, (z j : L) - 1 = δ₁ := fun j => by rw [hz_coe j]; ring
  have hnorm_u : normLM F hLK (u : K) = (N : L) := congr_arg Units.val hu_norm
  have hquad : ∀ c ε : L,
      normLM F hLK (IntermediateField.inclusion hLK c + IntermediateField.inclusion hLK ε * (u : K)) =
        c ^ 2 + c * ε * s₁ + ε ^ 2 * (N : L) := by
    intro c ε
    have hp_poly := hs_poly (u : K) c ε
    rw [hIcc, hp2, Finset.sum_singleton, hnorm_u] at hp_poly
    simpa [s₁] using hp_poly
  refine ⟨z₀, z, ?_, ?_, ?_, ?_, ?_⟩
  · have h_arg : IntermediateField.inclusion hLK (N : L) - (u : K) =
        IntermediateField.inclusion hLK (N : L) + IntermediateField.inclusion hLK (-1 : L) * (u : K) := by
      rw [map_neg, map_one]
      ring
    rw [h_arg, hquad (N : L) (-1 : L), hS', Finset.prod_singleton, hz₀_coe]
    change (N : L) ^ 2 + (N : L) * (-1) * s₁ + (-1) ^ 2 * (N : L) =
      (N : L) * U₁ * (1 - s₁ * U₁⁻¹)
    rw [hU₁_eq] at hU₁_inv ⊢
    linear_combination ((N : L) * s₁) * hU₁_inv
  · rw [hz₀_sub]
    rcases hneg_δ₁_val with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans ha_le_m₁ hge)
  · intro j hj
    rw [hS', Finset.mem_singleton] at hj
    subst hj
    set w_elem : K := IntermediateField.inclusion hLK 1 + IntermediateField.inclusion hLK 1 * (u : K)
    have hw_norm : normLM F hLK w_elem = U₁ * (z 1 : L) := by
      rw [hquad 1 1, hz_coe 1]
      change (1 : L) ^ 2 + 1 * 1 * s₁ + 1 ^ 2 * (N : L) = U₁ * (1 + s₁ * U₁⁻¹)
      rw [hU₁_eq] at hU₁_inv ⊢
      linear_combination (-s₁) * hU₁_inv
    have hw_norm_ne : normLM F hLK w_elem ≠ 0 := by
      rw [hw_norm, hz_coe 1]
      exact mul_ne_zero hU₁_ne h_one_add_ne
    have hw_ne : w_elem ≠ 0 := by
      intro hw0
      have h0 := hquad 0 0
      rw [map_zero, zero_mul, add_zero] at h0
      rw [hw0, h0] at hw_norm_ne
      exact hw_norm_ne (by ring)
    refine ⟨Units.mk0 w_elem hw_ne, ?_⟩
    simpa [U₁] using hw_norm
  · intro j _
    rw [hz_sub j]
    rcases hδ₁_val with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans hb_le_m₁ hge)
  · dsimp only
    rw [hS', Finset.sum_singleton, hτ_unit1, hz₀_sub, hz_sub 1]
    have hδ₁_eq : δ₁ = s₁ * ((N : L) + 1)⁻¹ := by simp [δ₁, hU₁_eq]
    have hX_eq : s₁ + (N : L) * (-δ₁) + 1 * δ₁ = (2 : L) * δ₁ := by
      rw [hδ₁_eq]
      rw [hU₁_eq] at hU₁_inv
      linear_combination (-s₁) * hU₁_inv
    rw [hX_eq]
    have hp_val2 : (2 : L) = 0 ∨ ((b / 2 : ℕ) : ℤ) ≤ valL F L (2 : L) := by
      have hp_v := hp_val
      rw [hp2, ← hb_eq] at hp_v
      simpa using hp_v
    by_cases h2_0 : (2 : L) = 0
    · left
      rw [h2_0, zero_mul]
    · by_cases hδ₁_0 : δ₁ = 0
      · left
        rw [hδ₁_0, mul_zero]
      · right
        have h2_ge : ((b / 2 : ℕ) : ℤ) ≤ valL F L (2 : L) := hp_val2.resolve_left h2_0
        have hδ₁_ge : (m₁ : ℤ) ≤ valL F L δ₁ := hδ₁_val.resolve_left hδ₁_0
        have hmul := hvalL_props.2.2.2.2.1 (2 : L) δ₁ h2_0 hδ₁_0
        omega

theorem ld_wild_low_cond_odd_prime_correction_units (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_ne2 : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (a b t : ℕ) (ha_ge2 : 2 ≤ a) (hab : a ≤ b) (ht_ge1 : 1 ≤ t) (hb_eq : b = t + 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (s : K → ℕ → L)
    (hs_val : ∀ (y : K) (r : ℕ),
      r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1) →
      ∀ (q m : ℤ), (y = 0 ∨ q ≤ valL F K y) →
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ (r : ℤ) * q →
        (s y r = 0 ∨ m ≤ valL F L (s y r)))
    (hs_poly : ∀ (y : K) (c ε : L),
      normLM F hLK
        (IntermediateField.inclusion hLK c + IntermediateField.inclusion hLK ε * y) =
        c ^ (Module.finrank L (IntermediateField.extendScalars hLK)) +
          (∑ r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLK) - 1),
            c ^ (Module.finrank L (IntermediateField.extendScalars hLK) - r) * ε ^ r * s y r) +
          ε ^ (Module.finrank L (IntermediateField.extendScalars hLK)) * normLM F hLK y)
    (u : Kˣ) (N : Lˣ) (τ_unit τ_tilde : ℕ → Lˣ)
    (hu_norm : Units.map (normLM F hLK) u = N)
    (hu_val : valL F K (u : K) = (b - a : ℤ))
    (hN_val : valL F L (N : L) = (b - a : ℤ))
    (hτ_basic : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
      (τ_tilde j : L) = (j : L) ^ ((Module.finrank L (IntermediateField.extendScalars hLK)) ^ b) ∧
      τ_unit j = (τ_tilde j) ^ (Module.finrank L (IntermediateField.extendScalars hLK)) ∧
      (N : L) + (τ_unit j : L) ≠ 0 ∧
      valL F L ((N : L) + (τ_unit j : L)) = 0)
    (hTeich_1 : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
      (τ_tilde j : L) - (τ_unit j : L) = 0 ∨
        (b + 1 : ℤ) ≤ valL F L ((τ_tilde j : L) - (τ_unit j : L)))
    (hTeich_3 : (∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
        ((N : L) + (τ_unit j : L))) -
      ((N : L) ^ (Module.finrank L (IntermediateField.extendScalars hLK) - 1) - 1) = 0 ∨
      (b + 1 : ℤ) ≤
        valL F L
          ((∏ j ∈ (Finset.range (Module.finrank L (IntermediateField.extendScalars hLK))).erase 0,
              ((N : L) + (τ_unit j : L))) -
            ((N : L) ^ (Module.finrank L (IntermediateField.extendScalars hLK) - 1) - 1))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    let S' := (Finset.range p).erase 0
    let m_p := (p - 1) * b / p
    (∀ r ∈ Finset.Icc 1 (p - 1), s (u : K) r = 0 ∨ (m_p : ℤ) ≤ valL F L (s (u : K) r)) ∧
    (∀ j ∈ S', (τ_unit j : L) = 0 ∨ 0 ≤ valL F L (τ_unit j : L)) ∧
    ∃ (z₀ : Lˣ) (z : ℕ → Lˣ),
      normLM F hLK (IntermediateField.inclusion hLK (N : L) - (u : K)) =
        (N : L) * (∏ j ∈ S', ((N : L) + (τ_unit j : L))) * (z₀ : L) ∧
      ((z₀ : L) - 1 = 0 ∨ (m_p : ℤ) ≤ valL F L ((z₀ : L) - 1)) ∧
      ((z₀ : L) - 1 = 0 ∨ (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F L ((z₀ : L) - 1)) ∧
      (∀ j ∈ S', ∃ w_j : Kˣ, normLM F hLK (w_j : K) = ((N : L) + (τ_unit j : L)) * (z j : L)) ∧
      (∀ j ∈ S', (z j : L) - 1 = 0 ∨ (m_p : ℤ) ≤ valL F L ((z j : L) - 1)) ∧
      (∀ j ∈ S', (z j : L) - 1 = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F L ((z j : L) - 1)) ∧
      (((N : L) ^ (p - 1) - 1) * ((z₀ : L) - 1) -
        (∑ r ∈ Finset.Icc 1 (p - 1), (-1 : L) ^ r * (N : L) ^ (p - 1 - r) * s (u : K) r) = 0 ∨
        (b + 1 : ℤ) ≤ valL F L
          (((N : L) ^ (p - 1) - 1) * ((z₀ : L) - 1) -
            (∑ r ∈ Finset.Icc 1 (p - 1), (-1 : L) ^ r * (N : L) ^ (p - 1 - r) * s (u : K) r))) ∧
      (∀ j ∈ S',
        ((N : L) + (τ_unit j : L)) * ((z j : L) - 1) -
          (∑ r ∈ Finset.Icc 1 (p - 1), (τ_unit j : L) ^ (p - r) * s (u : K) r) = 0 ∨
          (b + 1 : ℤ) ≤ valL F L
            (((N : L) + (τ_unit j : L)) * ((z j : L) - 1) -
              (∑ r ∈ Finset.Icc 1 (p - 1), (τ_unit j : L) ^ (p - r) * s (u : K) r))) :=
by
  intro p S' m_p
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_odd : Odd p := hPrime.odd_of_ne_two hp_ne2
  have hp_ge3 : 3 ≤ p := by
    rcases hp_odd with ⟨k, hk⟩
    omega
  have hb_ge2 : 2 ≤ b := le_trans ha_ge2 hab
  have ha_half_pos : 1 ≤ (a + 1) / 2 := by omega
  have ha_le_b_half : (a + 1) / 2 ≤ (b + 1) / 2 :=
    Nat.div_le_div_right (by omega)
  have hb_half_le_mp : (b + 1) / 2 ≤ m_p := by
    dsimp [m_p]
    rw [Nat.le_div_iff_mul_le hp_pos]
    have hdiv2 : 2 * ((b + 1) / 2) ≤ b + 1 := Nat.mul_div_le (b + 1) 2
    have hp_sub : p - 1 + 1 = p := Nat.sub_add_cancel hp_pos
    nlinarith
  have ha_half_le_mp : (a + 1) / 2 ≤ m_p := le_trans ha_le_b_half hb_half_le_mp
  have hmp_ge1 : 1 ≤ m_p := le_trans ha_half_pos ha_half_le_mp
  have hmp_le_b : m_p ≤ b := by
    dsimp [m_p]
    apply Nat.div_le_of_le_mul
    exact Nat.mul_le_mul_right b (Nat.sub_le p 1)
  rcases hvalL_props with ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul,
    hval_inv, _, hval_add, hunit0, hunit_ge1, hunit_val0⟩
  have hval_mul_ge : ∀ (k₁ k₂ : ℤ) (x y : L),
      (x = 0 ∨ k₁ ≤ valL F L x) → (y = 0 ∨ k₂ ≤ valL F L y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F L (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        rw [hval_mul x y hx0 hy0]
        have h1 := hx.resolve_left hx0
        have h2 := hy.resolve_left hy0
        omega
  have hval_sub : ∀ (k : ℤ) (x₁ x₂ : L),
      (x₁ = 0 ∨ k ≤ valL F L x₁) → (x₂ = 0 ∨ k ≤ valL F L x₂) →
        (x₁ - x₂ = 0 ∨ k ≤ valL F L (x₁ - x₂)) := by
    intro k x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg]
    have hneg2 : -x₂ = 0 ∨ k ≤ valL F L (-x₂) := by
      rcases hx₂ with rfl | hge
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hval_neg]; exact hge)
    exact hval_add k x₁ (-x₂) hx₁ hneg2
  have hval_mono : ∀ {k₁ k₂ : ℤ} {x : L}, k₁ ≤ k₂ →
      (x = 0 ∨ k₂ ≤ valL F L x) → (x = 0 ∨ k₁ ≤ valL F L x) := by
    intro k₁ k₂ x hle hx
    rcases hx with rfl | hge
    · exact Or.inl rfl
    · exact Or.inr (le_trans hle hge)
  have hval_finset_sum : ∀ (T : Finset ℕ) (f : ℕ → L) (k : ℤ),
      (∀ i ∈ T, f i = 0 ∨ k ≤ valL F L (f i)) →
        ((∑ i ∈ T, f i) = 0 ∨ k ≤ valL F L (∑ i ∈ T, f i)) := by
    intro T f k hT
    induction T using Finset.induction_on with
    | empty => exact Or.inl (by simp)
    | @insert c s hc ih =>
      rw [Finset.sum_insert hc]
      exact hval_add k (f c) (∑ i ∈ s, f i)
        (hT c (Finset.mem_insert_self c s))
        (ih (fun i hi => hT i (Finset.mem_insert_of_mem hi)))
  have hval_pow_ge : ∀ (k : ℤ) (x : L) (n : ℕ),
      (x = 0 ∨ k ≤ valL F L x) →
        (x ^ n = 0 ∨ (n : ℤ) * k ≤ valL F L (x ^ n)) := by
    intro k x n hx
    induction n with
    | zero => right; simp [hval1]
    | succ n ih =>
      rw [pow_succ]
      rcases hval_mul_ge ((n : ℤ) * k) k (x ^ n) x ih hx with h0 | hge
      · exact Or.inl h0
      · right
        have heq : ((n + 1 : ℕ) : ℤ) * k = (n : ℤ) * k + k := by push_cast; ring
        rw [heq]; exact hge
  have hval_pow_int : ∀ (x : L) (n : ℕ),
      (x = 0 ∨ 0 ≤ valL F L x) → (x ^ n = 0 ∨ 0 ≤ valL F L (x ^ n)) := by
    intro x n hx
    rcases hval_pow_ge 0 x n hx with h0 | hge
    · exact Or.inl h0
    · right; simpa using hge
  have hnat_int : ∀ m : ℕ, (m : L) = 0 ∨ 0 ≤ valL F L (m : L) := by
    intro m
    induction m with
    | zero => exact Or.inl Nat.cast_zero
    | succ m ih =>
      rw [Nat.cast_succ]
      exact hval_add 0 (m : L) 1 ih (Or.inr (by omega))
  have hval_inv_zero : ∀ x : L, x ≠ 0 → valL F L x = 0 → valL F L x⁻¹ = 0 := by
    intro x hx0 hx_val
    let u_x : Lˣ := Units.mk0 x hx0
    have h1 : valL F L ((u_x⁻¹ : Lˣ) : L) = - valL F L (u_x : L) := hval_inv u_x
    simpa [u_x, hx_val] using h1
  have hunit_of_gt0 : ∀ x : L, (x = 0 ∨ (1 : ℤ) ≤ valL F L x) →
      1 + x ≠ 0 ∧ valL F L (1 + x) = 0 := by
    intro x hx
    have h1x_ne0 : 1 + x ≠ 0 := by
      intro h0
      have hx_neg1 : x = -1 := by linear_combination h0
      rcases hx with hx0 | hx_ge1
      · have h10 : (1 : L) = 0 := by linear_combination h0 - hx0
        exact one_ne_zero h10
      · rw [hx_neg1, hval_neg1] at hx_ge1
        omega
    let u_x : Lˣ := Units.mk0 (1 + x) h1x_ne0
    have hu_mem : u_x ∈ unitGroup F L 1 := by
      rw [hunit_ge1 1 le_rfl u_x]
      have hsub : (u_x : L) - 1 = x := by dsimp [u_x]; ring
      rcases hx with rfl | hx_ge1
      · exact Or.inl (by dsimp [u_x]; ring)
      · exact Or.inr (by rw [hsub]; exact hx_ge1)
    exact ⟨h1x_ne0, hunit_val0 1 u_x hu_mem⟩
  have hval_finset_prod_zero : ∀ (T : Finset ℕ) (f : ℕ → L),
      (∀ i ∈ T, f i ≠ 0 ∧ valL F L (f i) = 0) →
        (∏ i ∈ T, f i) ≠ 0 ∧ valL F L (∏ i ∈ T, f i) = 0 := by
    intro T f hT
    induction T using Finset.induction_on with
    | empty =>
      simp [hval1]
    | @insert c s hc ih =>
      rw [Finset.prod_insert hc]
      have hc_prop := hT c (Finset.mem_insert_self c s)
      have hs_prop := ih (fun i hi => hT i (Finset.mem_insert_of_mem hi))
      refine ⟨mul_ne_zero hc_prop.1 hs_prop.1, ?_⟩
      rw [hval_mul (f c) (∏ i ∈ s, f i) hc_prop.1 hs_prop.1, hc_prop.2, hs_prop.2, add_zero]
  have hN_int : (N : L) = 0 ∨ 0 ≤ valL F L (N : L) := by
    right; rw [hN_val]; omega
  have hτ_tilde_int : ∀ j ∈ S', (τ_tilde j : L) = 0 ∨ 0 ≤ valL F L (τ_tilde j : L) := by
    intro j hj
    have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    have hj_pos : 0 < j := Nat.pos_of_ne_zero (Finset.mem_erase.mp hj).1
    rw [(hτ_basic j hj_lt hj_pos).1]
    exact hval_pow_int (j : L) (p ^ b) (hnat_int j)
  have hτ_int0 : ∀ j ∈ S', (τ_unit j : L) = 0 ∨ 0 ≤ valL F L (τ_unit j : L) := by
    intro j hj
    have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    have hj_pos : 0 < j := Nat.pos_of_ne_zero (Finset.mem_erase.mp hj).1
    have hpow : (τ_unit j : L) = (τ_tilde j : L) ^ p := by
      rw [(hτ_basic j hj_lt hj_pos).2.1, Units.val_pow_eq_pow_val]
    rw [hpow]
    exact hval_pow_int (τ_tilde j : L) p (hτ_tilde_int j hj)
  have hs_u : ∀ r ∈ Finset.Icc 1 (p - 1),
      s (u : K) r = 0 ∨ (m_p : ℤ) ≤ valL F L (s (u : K) r) := by
    intro r hr
    apply hs_val (u : K) r hr (b - a : ℤ) (m_p : ℤ)
    · exact Or.inr (le_of_eq hu_val.symm)
    · have hmul_le : p * m_p ≤ (p - 1) * (t + 1) := by
        dsimp [m_p]
        rw [← hb_eq, Nat.mul_comm p]
        exact Nat.div_mul_le_self ((p - 1) * b) p
      have hmul_le_Z : (p : ℤ) * (m_p : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) := by
        exact_mod_cast hmul_le
      have hrq_nonneg : (0 : ℤ) ≤ (r : ℤ) * (b - a : ℤ) :=
        mul_nonneg (Nat.cast_nonneg r) (by omega)
      linarith
  let P_N : L := ∏ j ∈ S', ((N : L) + (τ_unit j : L))
  let Δ_P : L := P_N - ((N : L) ^ (p - 1) - 1)
  have hPN_prop : P_N ≠ 0 ∧ valL F L P_N = 0 := by
    apply hval_finset_prod_zero S' (fun j => (N : L) + (τ_unit j : L))
    intro j hj
    have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    have hj_pos : 0 < j := Nat.pos_of_ne_zero (Finset.mem_erase.mp hj).1
    exact ⟨(hτ_basic j hj_lt hj_pos).2.2.1, (hτ_basic j hj_lt hj_pos).2.2.2⟩
  have hPN_inv_int : P_N⁻¹ = 0 ∨ 0 ≤ valL F L P_N⁻¹ :=
    Or.inr (le_of_eq (hval_inv_zero P_N hPN_prop.1 hPN_prop.2).symm)
  let sum0 : L := ∑ r ∈ Finset.Icc 1 (p - 1), (-1 : L) ^ r * (N : L) ^ (p - 1 - r) * s (u : K) r
  have hsum0_val : sum0 = 0 ∨ (m_p : ℤ) ≤ valL F L sum0 := by
    apply hval_finset_sum (Finset.Icc 1 (p - 1)) _ (m_p : ℤ)
    intro r hr
    have hneg_r : (-1 : L) ^ r = 0 ∨ 0 ≤ valL F L ((-1 : L) ^ r) :=
      hval_pow_int (-1 : L) r (Or.inr (by omega))
    have hN_pow : (N : L) ^ (p - 1 - r) = 0 ∨ 0 ≤ valL F L ((N : L) ^ (p - 1 - r)) :=
      hval_pow_int (N : L) (p - 1 - r) hN_int
    have h1 := hval_mul_ge 0 0 ((-1 : L) ^ r) ((N : L) ^ (p - 1 - r)) hneg_r hN_pow
    rw [add_zero] at h1
    have h2 := hval_mul_ge 0 (m_p : ℤ)
      ((-1 : L) ^ r * (N : L) ^ (p - 1 - r)) (s (u : K) r) h1 (hs_u r hr)
    rwa [zero_add] at h2
  have hΔP_mp : -Δ_P = 0 ∨ (m_p : ℤ) ≤ valL F L (-Δ_P) := by
    have hΔP_b1 : Δ_P = 0 ∨ (b + 1 : ℤ) ≤ valL F L Δ_P := hTeich_3
    have hΔP_mp0 : Δ_P = 0 ∨ (m_p : ℤ) ≤ valL F L Δ_P :=
      hval_mono (by omega : (m_p : ℤ) ≤ (b + 1 : ℤ)) hΔP_b1
    rcases hΔP_mp0 with h0 | hge
    · exact Or.inl (by rw [h0, neg_zero])
    · exact Or.inr (by rw [hval_neg]; exact hge)
  let δ₀ : L := P_N⁻¹ * (-Δ_P + sum0)
  have hδ₀_mp : δ₀ = 0 ∨ (m_p : ℤ) ≤ valL F L δ₀ := by
    have hsum := hval_add (m_p : ℤ) (-Δ_P) sum0 hΔP_mp hsum0_val
    have hmul := hval_mul_ge 0 (m_p : ℤ) P_N⁻¹ (-Δ_P + sum0) hPN_inv_int hsum
    rwa [zero_add] at hmul
  have hδ₀_ge1 : δ₀ = 0 ∨ (1 : ℤ) ≤ valL F L δ₀ :=
    hval_mono (by exact_mod_cast hmp_ge1) hδ₀_mp
  have hz₀_unit := hunit_of_gt0 δ₀ hδ₀_ge1
  let z₀ : Lˣ := Units.mk0 (1 + δ₀) hz₀_unit.1
  have hz₀_sub : (z₀ : L) - 1 = δ₀ := by dsimp [z₀]; ring
  have hz₀_mp_goal : (z₀ : L) - 1 = 0 ∨ (m_p : ℤ) ≤ valL F L ((z₀ : L) - 1) := by
    rw [hz₀_sub]; exact hδ₀_mp
  have hz₀_val_goal : (z₀ : L) - 1 = 0 ∨ (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F L ((z₀ : L) - 1) :=
    hval_mono (by exact_mod_cast ha_half_le_mp) hz₀_mp_goal
  have hu_norm_val : normLM F hLK (u : K) = (N : L) :=
    congrArg Units.val hu_norm
  have hPN_δ₀ : P_N * δ₀ = -Δ_P + sum0 := by
    dsimp [δ₀]
    rw [← mul_assoc, mul_inv_cancel₀ hPN_prop.1, one_mul]
  have hz₀_norm : normLM F hLK (IntermediateField.inclusion hLK (N : L) - (u : K)) =
      (N : L) * P_N * (z₀ : L) := by
    have hsub_eq : IntermediateField.inclusion hLK (N : L) - (u : K) =
        IntermediateField.inclusion hLK (N : L) +
          IntermediateField.inclusion hLK (-1 : L) * (u : K) := by
      simp [sub_eq_add_neg]
    rw [hsub_eq, hs_poly (u : K) (N : L) (-1 : L), hu_norm_val, hp_odd.neg_one_pow]
    have hp_pow : (N : L) ^ p = (N : L) * (N : L) ^ (p - 1) := by
      conv_lhs => rw [← Nat.sub_add_cancel hp_pos, pow_succ']
    have hsum_eq : (∑ r ∈ Finset.Icc 1 (p - 1),
        (N : L) ^ (p - r) * (-1 : L) ^ r * s (u : K) r) = (N : L) * sum0 := by
      dsimp [sum0]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun r hr => ?_)
      have hr_le : r ≤ p - 1 := (Finset.mem_Icc.mp hr).2
      have hpr : p - r = (p - 1 - r) + 1 := by omega
      rw [hpr, pow_succ']
      ring
    rw [hp_pow, hsum_eq]
    have hRHS : (N : L) * P_N * (z₀ : L) = (N : L) * (P_N + P_N * δ₀) := by
      change (N : L) * P_N * (1 + δ₀) = (N : L) * (P_N + P_N * δ₀)
      ring
    rw [hRHS, hPN_δ₀]
    dsimp [Δ_P]
    ring
  have hδ₀_cong : ((N : L) ^ (p - 1) - 1) * ((z₀ : L) - 1) - sum0 = 0 ∨
      (b + 1 : ℤ) ≤ valL F L (((N : L) ^ (p - 1) - 1) * ((z₀ : L) - 1) - sum0) := by
    rw [hz₀_sub]
    have hsum0_eq : sum0 = P_N * δ₀ + Δ_P := by
      rw [hPN_δ₀]
      ring
    have hid : ((N : L) ^ (p - 1) - 1) * δ₀ - sum0 = (-Δ_P) * (1 + δ₀) := by
      rw [hsum0_eq]
      dsimp [Δ_P]
      ring
    rw [hid]
    have hneg_ΔP : -Δ_P = 0 ∨ (b + 1 : ℤ) ≤ valL F L (-Δ_P) := by
      have hΔP_b1 : Δ_P = 0 ∨ (b + 1 : ℤ) ≤ valL F L Δ_P := hTeich_3
      rcases hΔP_b1 with h0 | hge
      · exact Or.inl (by rw [h0, neg_zero])
      · exact Or.inr (by rw [hval_neg]; exact hge)
    have h1 : (1 + δ₀ : L) = 0 ∨ 0 ≤ valL F L (1 + δ₀) :=
      Or.inr (le_of_eq hz₀_unit.2.symm)
    have hmul := hval_mul_ge (b + 1 : ℤ) 0 (-Δ_P) (1 + δ₀) hneg_ΔP h1
    rwa [add_zero] at hmul
  let U_j : ℕ → L := fun j => (N : L) + (τ_unit j : L)
  let sum_tilde : ℕ → L := fun j =>
    ∑ r ∈ Finset.Icc 1 (p - 1), (τ_tilde j : L) ^ (p - r) * s (u : K) r
  let δ : ℕ → L := fun j => if j ∈ S' then (U_j j)⁻¹ * sum_tilde j else 0
  have hsum_tilde_val : ∀ j ∈ S', sum_tilde j = 0 ∨ (m_p : ℤ) ≤ valL F L (sum_tilde j) := by
    intro j hj
    apply hval_finset_sum (Finset.Icc 1 (p - 1)) _ (m_p : ℤ)
    intro r hr
    have hpow := hval_pow_int (τ_tilde j : L) (p - r) (hτ_tilde_int j hj)
    have hmul := hval_mul_ge 0 (m_p : ℤ)
      ((τ_tilde j : L) ^ (p - r)) (s (u : K) r) hpow (hs_u r hr)
    rwa [zero_add] at hmul
  have hδ_mp_all : ∀ j : ℕ, δ j = 0 ∨ (m_p : ℤ) ≤ valL F L (δ j) := by
    intro j
    dsimp [δ]
    split_ifs with hj
    · have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
      have hj_pos : 0 < j := Nat.pos_of_ne_zero (Finset.mem_erase.mp hj).1
      have hUj_ne0 : U_j j ≠ 0 := (hτ_basic j hj_lt hj_pos).2.2.1
      have hUj_val0 : valL F L (U_j j) = 0 := (hτ_basic j hj_lt hj_pos).2.2.2
      have hUj_inv : (U_j j)⁻¹ = 0 ∨ 0 ≤ valL F L (U_j j)⁻¹ :=
        Or.inr (le_of_eq (hval_inv_zero (U_j j) hUj_ne0 hUj_val0).symm)
      have hmul := hval_mul_ge 0 (m_p : ℤ) (U_j j)⁻¹ (sum_tilde j) hUj_inv (hsum_tilde_val j hj)
      rwa [zero_add] at hmul
    · exact Or.inl rfl
  have hzj_unit : ∀ j : ℕ, 1 + δ j ≠ 0 ∧ valL F L (1 + δ j) = 0 := by
    intro j
    exact hunit_of_gt0 (δ j) (hval_mono (by exact_mod_cast hmp_ge1) (hδ_mp_all j))
  let z : ℕ → Lˣ := fun j => Units.mk0 (1 + δ j) (hzj_unit j).1
  have hz_sub : ∀ j : ℕ, (z j : L) - 1 = δ j := by
    intro j; dsimp [z]; ring
  have hz_mp : ∀ j ∈ S', (z j : L) - 1 = 0 ∨ (m_p : ℤ) ≤ valL F L ((z j : L) - 1) := by
    intro j _
    rw [hz_sub j]
    exact hδ_mp_all j
  have hz_val : ∀ j ∈ S',
      (z j : L) - 1 = 0 ∨ (((b + 1) / 2 : ℕ) : ℤ) ≤ valL F L ((z j : L) - 1) := by
    intro j hj
    exact hval_mono (by exact_mod_cast hb_half_le_mp) (hz_mp j hj)
  have hz_norm : ∀ j ∈ S', ∃ w_j : Kˣ,
      normLM F hLK (w_j : K) = ((N : L) + (τ_unit j : L)) * (z j : L) := by
    intro j hj
    have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    have hj_pos : 0 < j := Nat.pos_of_ne_zero (Finset.mem_erase.mp hj).1
    let y_j : K := IntermediateField.inclusion hLK (τ_tilde j : L) +
      IntermediateField.inclusion hLK (1 : L) * (u : K)
    have hτ_pow : (τ_tilde j : L) ^ p = (τ_unit j : L) := by
      rw [(hτ_basic j hj_lt hj_pos).2.1, Units.val_pow_eq_pow_val]
    have hUj_δj : U_j j * δ j = sum_tilde j := by
      dsimp [δ]
      rw [if_pos hj, mul_inv_cancel_left₀ (hτ_basic j hj_lt hj_pos).2.2.1]
    have hnorm_yj : normLM F hLK y_j = U_j j * (z j : L) := by
      dsimp [y_j]
      rw [hs_poly (u : K) (τ_tilde j : L) (1 : L), hτ_pow, one_pow, one_mul, hu_norm_val]
      have hsum_eq : (∑ r ∈ Finset.Icc 1 (p - 1),
          (τ_tilde j : L) ^ (p - r) * (1 : L) ^ r * s (u : K) r) = sum_tilde j := by
        dsimp [sum_tilde]
        refine Finset.sum_congr rfl (fun r _ => by simp)
      rw [hsum_eq]
      change (τ_unit j : L) + sum_tilde j + (N : L) = U_j j * (1 + δ j)
      dsimp [U_j]
      linear_combination -hUj_δj
    have hy_j_ne0 : y_j ≠ 0 := by
      intro h0
      have hn0 : normLM F hLK y_j = 0 := by
        have h0_eq : y_j = IntermediateField.inclusion hLK 0 +
            IntermediateField.inclusion hLK 0 * (0 : K) := by
          rw [h0]; simp
        rw [h0_eq, hs_poly 0 0 0, zero_pow hp_pos.ne', zero_mul, zero_add, add_zero]
        apply Finset.sum_eq_zero
        intro r hr
        have hr_pos : r ≠ 0 := by
          have hr1 := (Finset.mem_Icc.mp hr).1
          omega
        rw [zero_pow hr_pos, mul_zero, zero_mul]
      rw [hnorm_yj] at hn0
      exact mul_ne_zero (hτ_basic j hj_lt hj_pos).2.2.1 (hzj_unit j).1 hn0
    exact ⟨Units.mk0 y_j hy_j_ne0, hnorm_yj⟩
  have hδ_cong : ∀ j ∈ S',
      ((N : L) + (τ_unit j : L)) * ((z j : L) - 1) -
        (∑ r ∈ Finset.Icc 1 (p - 1), (τ_unit j : L) ^ (p - r) * s (u : K) r) = 0 ∨
        (b + 1 : ℤ) ≤ valL F L
          (((N : L) + (τ_unit j : L)) * ((z j : L) - 1) -
            (∑ r ∈ Finset.Icc 1 (p - 1), (τ_unit j : L) ^ (p - r) * s (u : K) r)) := by
    intro j hj
    have hj_lt : j < p := Finset.mem_range.mp (Finset.mem_erase.mp hj).2
    have hj_pos : 0 < j := Nat.pos_of_ne_zero (Finset.mem_erase.mp hj).1
    have hpow_diff : ∀ k : ℕ,
        (τ_tilde j : L) ^ k - (τ_unit j : L) ^ k = 0 ∨
          (b + 1 : ℤ) ≤ valL F L ((τ_tilde j : L) ^ k - (τ_unit j : L) ^ k) := by
      intro k
      induction k with
      | zero => exact Or.inl (by simp)
      | succ k ih =>
        have hid : (τ_tilde j : L) ^ (k + 1) - (τ_unit j : L) ^ (k + 1) =
            (τ_tilde j : L) ^ k * ((τ_tilde j : L) - (τ_unit j : L)) +
              ((τ_tilde j : L) ^ k - (τ_unit j : L) ^ k) * (τ_unit j : L) := by
          rw [pow_succ, pow_succ]; ring
        rw [hid]
        have h1 := hval_mul_ge 0 (b + 1 : ℤ)
          ((τ_tilde j : L) ^ k) ((τ_tilde j : L) - (τ_unit j : L))
          (hval_pow_int (τ_tilde j : L) k (hτ_tilde_int j hj))
          (hTeich_1 j hj_lt hj_pos)
        rw [zero_add] at h1
        have h2 := hval_mul_ge (b + 1 : ℤ) 0
          ((τ_tilde j : L) ^ k - (τ_unit j : L) ^ k) (τ_unit j : L)
          ih (hτ_int0 j hj)
        rw [add_zero] at h2
        exact hval_add (b + 1 : ℤ) _ _ h1 h2
    have hUj_δj : ((N : L) + (τ_unit j : L)) * ((z j : L) - 1) = sum_tilde j := by
      rw [hz_sub j]
      dsimp [δ, U_j]
      rw [if_pos hj, mul_inv_cancel_left₀ (hτ_basic j hj_lt hj_pos).2.2.1]
    rw [hUj_δj]
    have hdiff_eq : sum_tilde j -
        (∑ r ∈ Finset.Icc 1 (p - 1), (τ_unit j : L) ^ (p - r) * s (u : K) r) =
        ∑ r ∈ Finset.Icc 1 (p - 1),
          ((τ_tilde j : L) ^ (p - r) - (τ_unit j : L) ^ (p - r)) * s (u : K) r := by
      dsimp [sum_tilde]
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun r _ => by rw [sub_mul])
    rw [hdiff_eq]
    apply hval_finset_sum (Finset.Icc 1 (p - 1)) _ (b + 1 : ℤ)
    intro r hr
    have hs_int : s (u : K) r = 0 ∨ 0 ≤ valL F L (s (u : K) r) :=
      hval_mono (Nat.cast_nonneg m_p) (hs_u r hr)
    have hmul := hval_mul_ge (b + 1 : ℤ) 0
      ((τ_tilde j : L) ^ (p - r) - (τ_unit j : L) ^ (p - r)) (s (u : K) r)
      (hpow_diff (p - r)) hs_int
    rwa [add_zero] at hmul
  exact ⟨hs_u, hτ_int0, z₀, z, hz₀_norm, hz₀_mp_goal, hz₀_val_goal,
    hz_norm, hz_mp, hz_val, hδ₀_cong, hδ_cong⟩

theorem ld_wild_low_cond_odd_prime_error_cancellation (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (p b : ℕ) (hPrime : Nat.Prime p) (hp_ne2 : p ≠ 2) (hb_ge2 : 2 ≤ b)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hp_val : (p : L) = 0 ∨ (((p - 1) * b / p : ℕ) : ℤ) ≤ valL F L (p : L))
