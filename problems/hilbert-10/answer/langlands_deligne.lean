        IsGaloisExt F (D_orb.get i).field K_i ∧
        IsAbelianExt F hFiKi ∧
        Module.finrank (D_orb.get i).field (IntermediateField.extendScalars hFiKi) = p F ∧
        (∀ z : ((D_orb.get i).field)ˣ,
          z ∈ Set.range (Units.map (normLM F hFiKi)) ↔ (μ'_orb i) z = 1) ∧
        (∀ w : M_Cˣ,
          w ∈ Set.range (Units.map (normLM F hM_CK)) →
          ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) w = 1) ∧
        ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) ≠ 1 := by
    intro i
    obtain ⟨_, _, hGal_tMC, _, _, hpow, hne1, hcond1, hcond2,
      ⟨_, K_t, hFtKt, hKtEt, hSep_tMC, hGal_tKt, hAb_tKt, hFin_tKt, hker, htriv_MC, hne_MC⟩⟩ :=
      hOrb_rec (D_orb.get i) (List.get_mem D_orb i)
    exact ⟨hSep_tMC, hGal_tMC, hpow, hne1, hcond1, hcond2,
      ⟨K_t, hFtKt, hKtEt, hGal_tKt, hAb_tKt, hFin_tKt, hker, htriv_MC, hne_MC⟩⟩
  have hSepFiMC : ∀ i : Fin D_orb.length,
      Algebra.IsSeparable (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)) :=
    fun i => (hμ'_props i).1
  have hDegSum_fin :
      (∑ i : Fin D_orb.length,
        Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) =
        Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1 := by
    rw [← hDegSum]
    conv_rhs => rw [← List.ofFn_get D_orb, List.map_ofFn, List.sum_ofFn]
    rfl
  obtain ⟨hq_pow, hqE, hresE, hValNormE, hValAlgE, hResLiftE, hFrobSurjL,
      hFrobSurjLp, hFrobSurjMC,
      hqK, hresK, hValNormK, hValAlgK, hResLiftK, hDiamondTrNorm,
      t, k, ht_ge1, hk_ge1, hk_dvd, hValAlgKE, hValAlgMCL, hTrBoundMCL, hTrFrobMCL, hnMC, hnE,
      htr_bound_K, hFi_ram, hPoly14_6, _⟩ :=
    ld_ch14_wild_semidirect_ramification_and_cond_zero F L K M_C E hLK hLM_C hM_CK hLE hEK
      h_inf h_sup hLM_C_lt hCore hGal hGalMCK hSepLE hMin h_wild hFinE_eq
      ψ hψ hψMC hψE hψK D_orb hFinFi hGalFiK hSepLFi hψFi hDegSum_fin
      χ' hFiMC μ'_orb hχ'_cond hχ'E_cond hμ'_props
  have hOrbitEnum :=
    ld_ch14_wild_semidirect_orbit_enum_and_norm_prod F rec L K M_C E hLK hLM_C hM_CK hLE hEK
      h_inf h_sup hLM_C_lt hCore hGal hGalMCK hMin hFinE_eq D_orb hD₁_sub hD_orb_props
      hFinFi hSepLFi hFiMC hSepFiMC hDegSum_fin
  obtain ⟨c'_χ', c'_χ'E, c'_μ, c'_θ, hcond_E, hc_L_val, hc_L_top,
      hc_E_val, hc_E_top, hc_orb, hExpBal, hNormCong⟩ :=
    ld_ch14_wild_higher_cond_stationary_elements_and_norm_congruence F L K M_C E
      hLK hLM_C hM_CK hLE hEK h_inf h_sup hLM_C_lt hCore hGal hGalMCK hSepLE hMin h_wild hFinE_eq
      ψ hψ hψMC hψE hψK D_orb hFinFi hGalFiK hSepLFi hψFi hLtFi hDegSum_fin
      χ' h_ge2 hFiMC μ'_orb hχ'_cond hχ'E_cond hμ'_props hOrbitEnum
      hresE hValNormE hValAlgE hResLiftE hFrobSurjL hFrobSurjLp hFrobSurjMC
      hValNormK hValAlgK hResLiftK hDiamondTrNorm t k ht_ge1 hk_ge1 hk_dvd
      hValAlgKE hValAlgMCL hTrBoundMCL hTrFrobMCL hnMC hnE htr_bound_K hFi_ram hPoly14_6
  obtain ⟨P_poly, ϖ_K, ϖ_MC, ϖ_E, ϖ_L, hϖ_K_norm, hϖ_E_norm, hϖ_K, hϖ_MC, hϖ_E, hϖ_L,
      hPoly_spec⟩ := hPoly14_6
  have hFi_deg : ∀ i : Fin D_orb.length, ∃ f_i : ℕ, 1 ≤ f_i ∧
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_i := by
    intro i
    obtain ⟨_, _, _, _, _, _, _, f_i, hf_i_pos, hfin_eq, _, _⟩ := hFi_ram i
    exact ⟨f_i, hf_i_pos, hfin_eq⟩
  obtain ⟨hk_even_or1, k_L, k_E, hFieldL, hFinL_card, hFieldE, hFinE_card,
      resL, resE, ψ_0L, ψ_0E, k_Fi, hFieldFi, hFinFi_card,
      resFi, ϖ_Fi, ψ_0μ, ψ_0θ,
      hresL_props, hresE_props, hresFi_props⟩ :=
    ld_ch14_wild_odd_p_residue_fields_and_stationary_chars F L K M_C E hLM_C hM_CK hLE
      ψ hψ hψE D_orb hFinFi hFiMC hψFi hDegSum_fin hq_pow k hk_ge1 hk_dvd hFi_deg hBranch2
      χ' h_ge2 μ'_orb ϖ_L hϖ_L ϖ_E hϖ_E c'_χ' c'_χ'E c'_μ c'_θ
      hcond_E hc_L_val hc_E_val hc_orb
  letI : Field k_L := hFieldL
  letI : Fintype k_L := hFinL_card
  letI : Field k_E := hFieldE
  letI : Fintype k_E := hFinE_card
  letI : ∀ i, Field (k_Fi i) := hFieldFi
  letI : ∀ i, Fintype (k_Fi i) := hFinFi_card
  have hQuadBal :=
    ld_ch14_wild_odd_p_quadratic_gauss_product_balance F L K M_C E
      hLM_C hM_CK hLE hEK hMin.1 hGalMCK hSepLE
      hBranch2.1 ψ hψ hψMC hψE D_orb hFinFi hFiMC hSepLFi hSepFiMC hψFi hLtFi hDegSum_fin
      χ' h_ge2 μ'_orb hχ'_cond hμ'_pow hOrbitEnum
      hqE hresE hValNormE hValAlgE hResLiftE hFrobSurjL hFrobSurjLp hFrobSurjMC
      hDiamondTrNorm t k ht_ge1 hk_ge1 hk_even_or1 hk_dvd
      hValAlgKE hValAlgMCL hTrBoundMCL hTrFrobMCL hnMC hnE htr_bound_K hFi_ram
