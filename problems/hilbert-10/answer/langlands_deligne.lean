    | negSucc n =>
      rw [Int.cast_negSucc]
      exact val_neg_K₁ (val_natCast_K₁ (n + 1))
  have hval_cancel_unit : ∀ (k : ℤ) (u x : K₁),
      u ≠ 0 → valL F K₁ u = 0 →
      (u * x = 0 ∨ k ≤ valL F K₁ (u * x)) →
      (x = 0 ∨ k ≤ valL F K₁ x) := by
    intro k u x hu_ne hu_val hux
    by_cases hx : x = 0
    · exact Or.inl hx
    · right
      have hux_ne : u * x ≠ 0 := mul_ne_zero hu_ne hx
      rcases hux with h0 | hle
      · exact False.elim (hux_ne h0)
      · rw [hvalK₁_mul u x hu_ne hx, hu_val, zero_add] at hle
        exact hle
  have hval_unit_add_pos : ∀ (u z : K₁),
      u ≠ 0 → valL F K₁ u = 0 →
      (z = 0 ∨ (1 : ℤ) ≤ valL F K₁ z) →
      u + z ≠ 0 ∧ valL F K₁ (u + z) = 0 := by
    intro u z hu_ne hu_val hz
    have h_ne : u + z ≠ 0 := by
      intro h0
      have hz_eq : z = -u := by linear_combination h0
      have hz_ne : z ≠ 0 := by rw [hz_eq]; exact neg_ne_zero.mpr hu_ne
      have hz_val : valL F K₁ z = 0 := by rw [hz_eq, hvalK₁_neg, hu_val]
      rcases hz with rfl | hle
      · exact hz_ne rfl
      · omega
    have hu0 : u = 0 ∨ (0 : ℤ) ≤ valL F K₁ u := Or.inr (by omega)
    have hz0 : z = 0 ∨ (0 : ℤ) ≤ valL F K₁ z := val_mono_K₁ (by omega) hz
    have huz0 : (0 : ℤ) ≤ valL F K₁ (u + z) := (val_add_K₁ hu0 hz0).resolve_left h_ne
    have huz_le0 : valL F K₁ (u + z) ≤ 0 := by
      by_contra hlt
      have hge1 : (1 : ℤ) ≤ valL F K₁ (u + z) := by omega
      have hsub := val_sub_K₁ (Or.inr hge1) hz
      rw [add_sub_cancel_right] at hsub
      rcases hsub with h0 | hle
      · exact hu_ne h0
      · omega
    exact ⟨h_ne, by omega⟩
  have hprod_unit : ∀ (T : Finset ℕ) (f : ℕ → K₁),
      (∀ m ∈ T, f m ≠ 0 ∧ valL F K₁ (f m) = 0) →
      (∏ m ∈ T, f m) ≠ 0 ∧ valL F K₁ (∏ m ∈ T, f m) = 0 := by
    intro T f
    induction' T using Finset.cons_induction with a s ha ih
    · intro _; simp [hvalK₁_1]
    · intro hT
      rw [Finset.prod_cons]
      have ha_prop := hT a (Finset.mem_cons_self a s)
      have hs_prop := ih (fun m hm => hT m (Finset.mem_cons_of_mem hm))
      refine ⟨mul_ne_zero ha_prop.1 hs_prop.1, ?_⟩
      rw [hvalK₁_mul (f a) (∏ m ∈ s, f m) ha_prop.1 hs_prop.1, ha_prop.2, hs_prop.2, add_zero]
  have hprod_mem_pos : ∀ (T : Finset ℕ) (f : ℕ → K₁),
      ((∏ m ∈ T, f m) = 0 ∨ (1 : ℤ) ≤ valL F K₁ (∏ m ∈ T, f m)) →
      ∃ m ∈ T, f m = 0 ∨ (1 : ℤ) ≤ valL F K₁ (f m) := by
    intro T f
    induction' T using Finset.cons_induction with a s ha ih
    · intro h
      rw [Finset.prod_empty] at h
      rcases h with h0 | hle
      · exact False.elim (one_ne_zero h0)
      · rw [hvalK₁_1] at hle; omega
    · intro h
      rw [Finset.prod_cons] at h
      by_cases hfa : f a = 0 ∨ (1 : ℤ) ≤ valL F K₁ (f a)
      · exact ⟨a, Finset.mem_cons_self a s, hfa⟩
      · push_neg at hfa
        rcases hfa with ⟨hfa_ne, hfa_lt1⟩
        have hs_pos : (∏ m ∈ s, f m) = 0 ∨ (1 : ℤ) ≤ valL F K₁ (∏ m ∈ s, f m) := by
          by_cases hps : (∏ m ∈ s, f m) = 0
          · exact Or.inl hps
          · right
            have hmul_ne : f a * (∏ m ∈ s, f m) ≠ 0 := mul_ne_zero hfa_ne hps
            rcases h with h0 | hle
            · exact False.elim (hmul_ne h0)
            · rw [hvalK₁_mul (f a) (∏ m ∈ s, f m) hfa_ne hps] at hle
              omega
        rcases ih hs_pos with ⟨m, hm_s, hm_prop⟩
        exact ⟨m, Finset.mem_cons_of_mem hm_s, hm_prop⟩
  have val_add_M₁' : ∀ {k : ℤ} {x y : M₁'},
      (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
        (x + y = 0 ∨ k ≤ valL F M₁' (x + y)) := by
    intro k x y hx hy
    exact hvalM₁'_add k x y hx hy
  have val_mul_M₁' : ∀ {k₁ k₂ : ℤ} {x y : M₁'},
      (x = 0 ∨ k₁ ≤ valL F M₁' x) → (y = 0 ∨ k₂ ≤ valL F M₁' y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F M₁' (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by simp [hx0])
    · by_cases hy0 : y = 0
      · exact Or.inl (by simp [hy0])
      · right
        rw [hvalM₁'_mul x y hx0 hy0]
        exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
  have val_mono_M₁' : ∀ {k₁ k₂ : ℤ} {x : M₁'},
      k₁ ≤ k₂ → (x = 0 ∨ k₂ ≤ valL F M₁' x) → (x = 0 ∨ k₁ ≤ valL F M₁' x) := by
    intro k₁ k₂ x hk hx
    exact hx.imp_right (le_trans hk)
  have val_sum_M₁' : ∀ (S : Finset ℕ) (f : ℕ → M₁') (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F M₁' (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F M₁' (∑ i ∈ S, f i)) := by
    intro S f k hf
    induction S using Finset.induction_on with
    | empty => exact Or.inl (by simp)
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact val_add_M₁' (hf a (Finset.mem_insert_self a s))
        (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi)))

  
  have hcoprime_inv_mod_p : ∀ j : ℕ, 1 ≤ j → j < p → ∃ m : ℕ, j * j ^ (p - 2) = p * m + 1 := by
    intro j hj1 hj_lt
    have hj_ne0 : ((j : ℕ) : ZMod p) ≠ 0 := by
      rw [Ne, ZMod.natCast_eq_zero_iff]
      exact Nat.not_dvd_of_pos_of_lt (by omega) hj_lt
    have hpow_zmod : ((j * j ^ (p - 2) : ℕ) : ZMod p) = 1 := by
      push_cast
      have h1 : (j : ZMod p) * (j : ZMod p) ^ (p - 2) = (j : ZMod p) ^ (p - 1) := by
        calc (j : ZMod p) * (j : ZMod p) ^ (p - 2)
            = (j : ZMod p) ^ 1 * (j : ZMod p) ^ (p - 2) := by rw [pow_one]
          _ = (j : ZMod p) ^ (1 + (p - 2)) := by rw [← pow_add]
          _ = (j : ZMod p) ^ (p - 1) := by congr 1; omega
      rw [h1]
      exact ZMod.pow_card_sub_one_eq_one hj_ne0
    have hval_zmod := congrArg ZMod.val hpow_zmod
    rw [ZMod.val_natCast, ZMod.val_one p] at hval_zmod
    refine ⟨(j * j ^ (p - 2)) / p, ?_⟩
    have hdiv := Nat.div_add_mod (j * j ^ (p - 2)) p
    omega
  have hp_val1_K₁ : ((p : ℕ) : K₁) = 0 ∨ (1 : ℤ) ≤ valL F K₁ ((p : ℕ) : K₁) :=
    val_mono_K₁ (le_trans hB₀_ge1 hB₀_le_bteich) hp_valK₁
  have hj_unit_K₁ : ∀ j < p, 0 < j → (j : K₁) ≠ 0 ∧ valL F K₁ (j : K₁) = 0 := by
    intro j hj_lt hj_pos
    obtain ⟨m, hm⟩ := hcoprime_inv_mod_p j hj_pos hj_lt
    have hm_K₁ : (j : K₁) * ((j ^ (p - 2) : ℕ) : K₁) = 1 + ((p : ℕ) : K₁) * (m : K₁) := by
      have hcast := congrArg (Nat.cast : ℕ → K₁) hm
      simp only [Nat.cast_mul, Nat.cast_add, Nat.cast_one] at hcast
      linear_combination hcast
    have hpm_val : ((p : ℕ) : K₁) * (m : K₁) = 0 ∨
        (1 : ℤ) ≤ valL F K₁ (((p : ℕ) : K₁) * (m : K₁)) := by
      simpa using val_mul_K₁ hp_val1_K₁ (val_natCast_K₁ m)
    have hprod_u := hval_unit_add_pos 1 (((p : ℕ) : K₁) * (m : K₁)) one_ne_zero hvalK₁_1 hpm_val
    rw [← hm_K₁] at hprod_u
    have hj_ne : (j : K₁) ≠ 0 := left_ne_zero_of_mul hprod_u.1
    have hpow_ne : ((j ^ (p - 2) : ℕ) : K₁) ≠ 0 := right_ne_zero_of_mul hprod_u.1
    have hmul_val := hvalK₁_mul (j : K₁) ((j ^ (p - 2) : ℕ) : K₁) hj_ne hpow_ne
    rw [hprod_u.2] at hmul_val
    have hj_ge0 : (0 : ℤ) ≤ valL F K₁ (j : K₁) := (val_natCast_K₁ j).resolve_left hj_ne
    have hpow_ge0 : (0 : ℤ) ≤ valL F K₁ ((j ^ (p - 2) : ℕ) : K₁) :=
      (val_natCast_K₁ (j ^ (p - 2))).resolve_left hpow_ne
    exact ⟨hj_ne, by omega⟩
  have hj_diff_unit_K₁ : ∀ j₁ < p, ∀ j₂ < p, 0 < j₁ → 0 < j₂ → j₁ ≠ j₂ →
      (j₂ : K₁) - (j₁ : K₁) ≠ 0 ∧ valL F K₁ ((j₂ : K₁) - (j₁ : K₁)) = 0 := by
    intro j₁ hj₁_lt j₂ hj₂_lt hj₁_pos hj₂_pos hne
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · have hsub_cast : (j₂ : K₁) - (j₁ : K₁) = ((j₂ - j₁ : ℕ) : K₁) :=
        (Nat.cast_sub (le_of_lt hlt)).symm
      rw [hsub_cast]
      exact hj_unit_K₁ (j₂ - j₁) (by omega) (by omega)
    · have hsub_cast : (j₂ : K₁) - (j₁ : K₁) = -((j₁ - j₂ : ℕ) : K₁) := by
        rw [Nat.cast_sub (le_of_lt hgt)]
        ring
      obtain ⟨hd_ne, hd_val⟩ := hj_unit_K₁ (j₁ - j₂) (by omega) (by omega)
      rw [hsub_cast]
      exact ⟨neg_ne_zero.mpr hd_ne, by rw [hvalK₁_neg, hd_val]⟩

  
  let u_nat : ℕ → K₁ˣ := fun j => if h : (j : K₁) ≠ 0 then Units.mk0 (j : K₁) h else 1
  let τ_t : ℕ → K₁ˣ := fun j => (u_nat j) ^ (p ^ b_teich)
  let τ_u : ℕ → K₁ˣ := fun j => (τ_t j) ^ p
