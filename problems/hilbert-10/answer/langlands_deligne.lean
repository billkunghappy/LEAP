        rw [hk1, hc₂_g, add_zero]
      · have hn_ge2 : 2 ≤ n := by omega
        have hc₂_g : c₂ g = g.coeff (n - 2) := if_neg hn2
        have hsub : Finset.range (m + 1) ⊆ Finset.range (k + 1) :=
