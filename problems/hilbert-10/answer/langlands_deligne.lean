      · rw [hS_eq]; simp [Algebra.algebraMap_eq_smul_one, Matrix.smul_apply, Matrix.one_apply]
      · rw [hS_eq]; simp [Algebra.algebraMap_eq_smul_one, Matrix.smul_apply, Matrix.one_apply]
      · rw [hS_eq]; simp [Algebra.algebraMap_eq_smul_one, Matrix.smul_apply, Matrix.one_apply, h01]
      · rw [hS_eq]; simp [Algebra.algebraMap_eq_smul_one, Matrix.smul_apply, Matrix.one_apply, h10]
    let w' : K₁' := toExtendScalars F hE'K₁ w
    let M : Matrix (Fin 2) (Fin 2) E' := Algebra.leftMulMatrix b w'
    have htr_M : traceLM F hE'K₁ w = M 0 0 + M 1 1 := by
      change Algebra.trace E' K₁' w' = M 0 0 + M 1 1
      rw [Algebra.trace_eq_matrix_trace b w', Matrix.trace_fin_two M]
    have hnorm_M : normLM F hE'K₁ w = M 0 0 * M 1 1 - M 0 1 * M 1 0 := by
      change Algebra.norm E' w' = M 0 0 * M 1 1 - M 0 1 * M 1 0
      rw [Algebra.norm_eq_matrix_det b w', Matrix.det_fin_two M]
    apply hinj_ext
    apply Algebra.leftMulMatrix_injective b
    rw [map_mul, map_sub, halg_ext, halg_ext, map_mul, map_sub]
    let T_mat : Matrix (Fin 2) (Fin 2) E' :=
      Algebra.leftMulMatrix b (algebraMap E' K₁' (traceLM F hE'K₁ w))
    let N_mat : Matrix (Fin 2) (Fin 2) E' :=
      Algebra.leftMulMatrix b (algebraMap E' K₁' (normLM F hE'K₁ w))
    obtain ⟨hT00, hT11, hT01, hT10⟩ := hMat_scalar (traceLM F hE'K₁ w)
    obtain ⟨hN00, hN11, hN01, hN10⟩ := hMat_scalar (normLM F hE'K₁ w)
    change M * (T_mat - M) = N_mat
    apply Matrix.ext
    rw [Fin.forall_fin_two]
    simp only [Fin.forall_fin_two, Matrix.mul_apply, Fin.sum_univ_two, Matrix.sub_apply,
      T_mat, N_mat, hT00, hT11, hT01, hT10, hN00, hN11, hN01, hN10]
    simp only [htr_M, hnorm_M]
    refine ⟨⟨by ring, by ring⟩, ⟨by ring, by ring⟩⟩
  have hCH : C * (IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ C) - C) =
      IntermediateField.inclusion hE'K₁ N₂ := hCH_gen C
  have hN₂_inv_K₁ : IntermediateField.inclusion hE'K₁ N₂ *
      IntermediateField.inclusion hE'K₁ N₂⁻¹ = 1 := by
    rw [← map_mul, mul_inv_cancel₀ hN₂_ne, map_one]
  have hCu_mul_inv : C * ((C_u⁻¹ : K₁ˣ) : K₁) = 1 := Units.mul_inv C_u
  have hCu_inv : ((C_u⁻¹ : K₁ˣ) : K₁) =
      IntermediateField.inclusion hE'K₁ N₂⁻¹ *
        (IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ C) - C) := by
    linear_combination
      - ((C_u⁻¹ : K₁ˣ) : K₁) * IntermediateField.inclusion hE'K₁ N₂⁻¹ * hCH +
      IntermediateField.inclusion hE'K₁ N₂⁻¹ *
        (IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ C) - C) * hCu_mul_inv -
      ((C_u⁻¹ : K₁ˣ) : K₁) * hN₂_inv_K₁
  have htr_Y : traceLM F hE'K₁ Y = h₂ := by
    simpa only [map_zero, mul_zero, zero_mul, add_zero, zero_add, sub_zero] using
      (hShiftTable 0 0).2.1
  have hnorm_Y : normLM F hE'K₁ Y = a₂ := by
    simpa only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, mul_zero, zero_mul,
      sub_zero, map_zero, add_zero, zero_add] using (hShiftTable 0 0).2.2.2.1
  have hh₂_ne : h₂ ≠ 0 := by
    intro hh₂0
    have hR1 : R = 1 := sub_eq_zero.mp hh₂0
    exact hR_val_ne0 (by rw [← hR_val, hR1, hvalE'_props.2.1])
  let t_odd : E' := IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L) * R
  have hu₂_inv_E'_ne : IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L) ≠ 0 :=
    (map_ne_zero (IntermediateField.inclusion hLE')).mpr (Units.ne_zero _)
  have hu₂_inv_E'_val : valL F E' (IntermediateField.inclusion hLE' ((u₂⁻¹ : Lˣ) : L)) =
      -2 * (e : ℤ) := by
    rw [hval_LE', hvalL_props.2.2.2.2.2.1 u₂, Units.val_mk0, h2_val]
    ring
  have ht_odd_ne : t_odd ≠ 0 := mul_ne_zero hu₂_inv_E'_ne hR_ne
  have ht_odd_val : valL F E' t_odd = 1 - 2 * (a : ℤ) := by
    dsimp only [t_odd]
    rw [hvalE'_props.2.2.2.2.1 _ _ hu₂_inv_E'_ne hR_ne, hu₂_inv_E'_val, hR_val]
    ring
  have hE_E'_b : IntermediateField.inclusion hLE' E = 0 ∨
      2 - 2 * (a : ℤ) ≤ valL F E' (IntermediateField.inclusion hLE' E) := by
    rcases hE_val with rfl | hge
    · left; exact map_zero _
    · right; rw [hval_LE']; linarith
  have hnegE_E'_b : -IntermediateField.inclusion hLE' E = 0 ∨
      1 - 2 * (a : ℤ) ≤ valL F E' (-IntermediateField.inclusion hLE' E) := by
    rcases hE_E'_b with h0 | hge
    · left; rw [h0, neg_zero]
    · right; rw [hvalE'_props.2.2.2.1]; linarith
  have ha₂_b : a₂ = 0 ∨ 1 - 2 * (a : ℤ) ≤ valL F E' a₂ :=
    hE'_sub_b (1 - 2 * (a : ℤ)) (-IntermediateField.inclusion hLE' E) t_odd
      hnegE_E'_b (Or.inr (by rw [ht_odd_val]))
  have hY_b : Y = 0 ∨ 1 - 2 * (a : ℤ) ≤ valL F K₁ Y := by
    have ha₂_not_gt : ¬ (a₂ = 0 ∨ 2 - 2 * (a : ℤ) ≤ valL F E' a₂) := by
      intro ha₂_gt
      have hsum := hvalE'_props.2.2.2.2.2.2.2.1 (2 - 2 * (a : ℤ))
        a₂ (IntermediateField.inclusion hLE' E) ha₂_gt hE_E'_b
      have hsum_eq : a₂ + IntermediateField.inclusion hLE' E = -t_odd := by
        dsimp only [a₂, t_odd]; ring
      rw [hsum_eq, neg_eq_zero, hvalE'_props.2.2.2.1, ht_odd_val] at hsum
      rcases hsum with h0 | hge
      · exact ht_odd_ne h0
      · linarith
    rcases ha₂_b with h0 | hge
    · exact False.elim (ha₂_not_gt (Or.inl h0))
    · right
      rw [← (hval_normK₁ Y).1, hnorm_Y]
      exact hge
  intro r hr z_E V W N_V
  have hz_E_b : z_E = 0 ∨ (e : ℤ) ≤ valL F E' z_E := by
    have hϖe_b : ((ϖ_E' ^ e : E'ˣ) : E') = 0 ∨ (e : ℤ) ≤ valL F E' ((ϖ_E' ^ e : E'ˣ) : E') := by
      right; rw [hE'_pow ϖ_E' e, hϖ_E', mul_one]
    have hr_E_b : IntermediateField.inclusion hLE' r = 0 ∨
        0 ≤ valL F E' (IntermediateField.inclusion hLE' r) := by
      rcases hr with rfl | hge
      · left; exact map_zero _
      · right; rw [hval_LE']; linarith
    have h := hE'_mul_b (e : ℤ) 0 _ _ hϖe_b hr_E_b
    change z_E = 0 ∨ (e : ℤ) + 0 ≤ valL F E' z_E at h
    exact h.imp id (fun hge => by linarith)
  have hConj1 : V = 0 ∨ 2 * (e : ℤ) + 1 - 2 * (a : ℤ) ≤ valL F K₁ V := by
    have hz_K₁_b : IntermediateField.inclusion hE'K₁ z_E = 0 ∨
        2 * (e : ℤ) ≤ valL F K₁ (IntermediateField.inclusion hE'K₁ z_E) := by
      rcases hz_E_b with h0 | hge
      · left; rw [h0, map_zero]
      · right; rw [hval_E'K₁]; linarith
    have h := hK₁_mul_b (1 - 2 * (a : ℤ)) (2 * (e : ℤ)) Y (IntermediateField.inclusion hE'K₁ z_E)
      hY_b hz_K₁_b
    change V = 0 ∨ (1 - 2 * (a : ℤ)) + 2 * (e : ℤ) ≤ valL F K₁ V at h
    exact h.imp id (fun hge => by linarith)
  have hConj2 : h₂⁻¹ * traceLM F hE'K₁ V = z_E := by
    have hV_eq : V = IntermediateField.inclusion hE'K₁ z_E * Y :=
      mul_comm Y (IntermediateField.inclusion hE'K₁ z_E)
    have htr_V : traceLM F hE'K₁ V = z_E * h₂ := by
      rw [hV_eq, htr_E'K₁_smul, htr_Y]
    have hh₂_inv : h₂⁻¹ * h₂ = 1 := inv_mul_cancel₀ hh₂_ne
    rw [htr_V]
    linear_combination z_E * hh₂_inv
  have hConj3 : normLM F hE'K₁ (1 + W) =
      1 + (δ_E' : E') * IntermediateField.inclusion hLE' r + N_V := by
    let YC : K₁ := Y * (IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ C) - C)
    have hW_eq : W = IntermediateField.inclusion hE'K₁ (N₂⁻¹ * z_E) * YC := by
      change ((C_u⁻¹ : K₁ˣ) : K₁) * (Y * IntermediateField.inclusion hE'K₁ z_E) =
        IntermediateField.inclusion hE'K₁ (N₂⁻¹ * z_E) *
          (Y * (IntermediateField.inclusion hE'K₁ (traceLM F hE'K₁ C) - C))
      rw [hCu_inv, map_mul (IntermediateField.inclusion hE'K₁) N₂⁻¹ z_E]
      ring
    have htr_W : traceLM F hE'K₁ W = (δ_E' : E') * IntermediateField.inclusion hLE' r := by
      rw [hW_eq, htr_E'K₁_smul, hδ_E'_eq]
      dsimp only [z_E, YC]
      ring
    rw [hnorm_1add W, htr_W]
  have hConj4 : N_V = 0 ∨ ((d₂ + 1 : ℕ) : ℤ) ≤ valL F E' N_V := by
    have hCu_inv_b : ((C_u⁻¹ : K₁ˣ) : K₁) = 0 ∨
        2 * (h : ℤ) ≤ valL F K₁ ((C_u⁻¹ : K₁ˣ) : K₁) := by
      right
      rw [hvalK₁_props.2.2.2.2.2.1 C_u, Units.val_mk0, hC_val]
      exact le_of_eq (by ring)
    have hW_b := hK₁_mul_b (2 * (h : ℤ)) (2 * (e : ℤ) + 1 - 2 * (a : ℤ))
      ((C_u⁻¹ : K₁ˣ) : K₁) V hCu_inv_b hConj1
    change W = 0 ∨ 2 * (h : ℤ) + (2 * (e : ℤ) + 1 - 2 * (a : ℤ)) ≤ valL F K₁ W at hW_b
    rcases hW_b with hW0 | hW_ge
    · left
      change normLM F hE'K₁ W = 0
      rw [hW0, hnorm0]
    · right
      change ((d₂ + 1 : ℕ) : ℤ) ≤ valL F E' (normLM F hE'K₁ W)
      rw [(hval_normK₁ W).1]
      exact hd₂_le.trans hW_ge
  exact ⟨hConj1, hConj2, hConj3, hConj4⟩

theorem ld_ch12_wild_dyadic_odd_max_break_higher_cond_crit_rec_from_perturbation (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    (hLE' : L ≤ E')
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (ψ : AddChar L (Ω F))
    (νE' : Lˣ →* (Ω F)ˣ)
    (θE' : E'ˣ →* (Ω F)ˣ)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hT2_odd : condExp F L νE' % 2 = 1)
    (hm2_ge3 : 3 ≤ condExp F E' θE')
    (hm2_odd : condExp F E' θE' % 2 = 1)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hSpecL : ∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1)
    (hSpecE' : ∀ y : E',
      (y = 0 ∨ -condExpChar F E' (traceChar F hLE' ψ) ≤ valL F E' y) →
        (traceChar F hLE' ψ) y = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (ϖ_E' : E'ˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLE') ϖ_E' = ϖ_L)
    (hϖ_E' : valL F E' (ϖ_E' : E') = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨ 2 * m - (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (cE' : E'ˣ) (cνE' : Lˣ) (δ_E' : E'ˣ)
    (hcE'_val : valL F E' (cE' : E') =
      (condExp F E' θE' : ℤ) + condExpChar F E' (traceChar F hLE' ψ))
    (hcE'_stat : ∀ w : E', (w = 0 ∨ (((condExp F E' θE' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' w) →
      ∀ hw : 1 + w ≠ 0,
        (θE' (Units.mk0 (1 + w) hw) : Ω F) = (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E') * w))
    (hcνE'_val : valL F L (cνE' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hcνE'_stat : ∀ u : L, (u = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((cνE'⁻¹ : Lˣ) : L) * u))
    (hδ_E'_val : valL F E' (δ_E' : E') = ((condExp F E' θE' / 2 : ℕ) : ℤ))
    (hPerturbEval :
      let e := condExp F L νE' / 2
      let d₂ := condExp F E' θE' / 2
      let ψE' := traceChar F hLE' ψ
      ∀ r : L, (r = 0 ∨ 0 ≤ valL F L r) →
        let z_E : E' := ((ϖ_E' ^ e : E'ˣ) : E') * IntermediateField.inclusion hLE' r
        ∃ (u_V : E'ˣ) (N_V : E'),
          (u_V : E') = 1 + (δ_E' : E') * IntermediateField.inclusion hLE' r + N_V ∧
          (N_V = 0 ∨ ((d₂ + 1 : ℕ) : ℤ) ≤ valL F E' N_V) ∧
          (θE' u_V : Ω F) =
            ψE' (((cE'⁻¹ : E'ˣ) : E') * ((u_V : E') - 1)) *
              ψ (((cνE'⁻¹ : Lˣ) : L) * (traceLM F hLE' z_E + normLM F hLE' z_E))) :
    let e := condExp F L νE' / 2
    let ψE' := traceChar F hLE' ψ
    ∀ r : L, (r = 0 ∨ 0 ≤ valL F L r) →
      ∀ (hr_E : 1 + (δ_E' : E') * IntermediateField.inclusion hLE' r ≠ 0)
        (hr_2 : 1 + ((ϖ_L ^ e : Lˣ) : L) * r ^ 2 ≠ 0),
        (θE' (Units.mk0 (1 + (δ_E' : E') * IntermediateField.inclusion hLE' r) hr_E) : Ω F)⁻¹ *
          ψE' (((cE'⁻¹ : E'ˣ) : E') * (δ_E' : E') * IntermediateField.inclusion hLE' r) =
        (νE' (Units.mk0 (1 + ((ϖ_L ^ e : Lˣ) : L) * r ^ 2) hr_2) : Ω F) *
          (ψ (((cνE'⁻¹ : Lˣ) : L) * ((ϖ_L ^ e : Lˣ) : L) * r ^ 2))⁻¹ :=
by
  intro e ψE' r hr hr_E hr_2
  let T₂ : ℕ := condExp F L νE'
  let r₀L : ℕ := (T₂ + 1) / 2
  let m₂ : ℕ := condExp F E' θE'
  let d₂ : ℕ := m₂ / 2
  let r₀E : ℕ := (m₂ + 1) / 2
  have he_def : e = T₂ / 2 := rfl
  have hT₂_ge2 : 2 ≤ T₂ := hbE'_ge2
  have hT₂_odd' : T₂ % 2 = 1 := hT2_odd
  have hm₂_ge3' : 3 ≤ m₂ := hm2_ge3
  have hm₂_odd' : m₂ % 2 = 1 := hm2_odd
  have he_ge1 : 1 ≤ e := by omega
  have hT₂_eq : T₂ = 2 * e + 1 := by omega
  have hr₀L_eq : r₀L = e + 1 := by omega
  have hd₂_ge1 : 1 ≤ d₂ := by omega
  have hm₂_eq : m₂ = 2 * d₂ + 1 := by omega
  have hr₀E_eq : r₀E = d₂ + 1 := by omega
  rcases hvalL_props with ⟨hvalL_0, hvalL_1, _, hvalL_neg, hvalL_mul, hvalL_inv, _,
    hvalL_add, _, hunitL_mem, hunitL_val⟩
  rcases hvalE'_props with ⟨hvalE'_0, hvalE'_1, _, hvalE'_neg, hvalE'_mul, hvalE'_inv, _,
    hvalE'_add, _, hunitE'_mem, hunitE'_val⟩
  have hvalL_mul_bound : ∀ (k₁ k₂ : ℤ) (a₁ a₂ : L),
      (a₁ = 0 ∨ k₁ ≤ valL F L a₁) → (a₂ = 0 ∨ k₂ ≤ valL F L a₂) →
        (a₁ * a₂ = 0 ∨ k₁ + k₂ ≤ valL F L (a₁ * a₂)) := by
    intro k₁ k₂ a₁ a₂ ha₁ ha₂
    by_cases h1 : a₁ = 0
    · left; rw [h1, zero_mul]
    · by_cases h2 : a₂ = 0
      · left; rw [h2, mul_zero]
      · right
        rcases ha₁ with rfl | hle₁; · contradiction
        rcases ha₂ with rfl | hle₂; · contradiction
        rw [hvalL_mul a₁ a₂ h1 h2]
        omega
  have hvalE'_mul_bound : ∀ (k₁ k₂ : ℤ) (y₁ y₂ : E'),
      (y₁ = 0 ∨ k₁ ≤ valL F E' y₁) → (y₂ = 0 ∨ k₂ ≤ valL F E' y₂) →
        (y₁ * y₂ = 0 ∨ k₁ + k₂ ≤ valL F E' (y₁ * y₂)) := by
    intro k₁ k₂ y₁ y₂ hy₁ hy₂
    by_cases h1 : y₁ = 0
    · left; rw [h1, zero_mul]
    · by_cases h2 : y₂ = 0
      · left; rw [h2, mul_zero]
      · right
        rcases hy₁ with rfl | hle₁; · contradiction
        rcases hy₂ with rfl | hle₂; · contradiction
        rw [hvalE'_mul y₁ y₂ h1 h2]
        omega
  have hone_add_ne_zero_L : ∀ a : L, (a = 0 ∨ (1 : ℤ) ≤ valL F L a) → 1 + a ≠ 0 := by
    intro a ha h0
    have ha_eq : -a = 1 := by linear_combination -h0
    rcases ha with rfl | hle
    · norm_num at h0
    · have hval : valL F L a = 0 := by
        rw [← hvalL_neg, ha_eq, hvalL_1]
      omega
  have hone_add_ne_zero_E' : ∀ y : E', (y = 0 ∨ (1 : ℤ) ≤ valL F E' y) → 1 + y ≠ 0 := by
    intro y hy h0
    have hy_eq : -y = 1 := by linear_combination -h0
    rcases hy with rfl | hle
    · norm_num at h0
    · have hval : valL F E' y = 0 := by
        rw [← hvalE'_neg, hy_eq, hvalE'_1]
      omega
  have hvalL_one_add_eq_zero : ∀ (a : L) (ha : a = 0 ∨ (1 : ℤ) ≤ valL F L a)
      (ha1 : 1 + a ≠ 0), valL F L (1 + a) = 0 := by
    intro a ha ha1
    have hmem : Units.mk0 (1 + a) ha1 ∈ unitGroup F L 1 := by
      rw [hunitL_mem 1 (by omega)]
      rcases ha with rfl | hle
      · left; simp [Units.val_mk0]
      · right; simp [Units.val_mk0, hle]
    simpa [Units.val_mk0] using hunitL_val 1 (Units.mk0 (1 + a) ha1) hmem
  have hvalE'_one_add_eq_zero : ∀ (y : E') (hy : y = 0 ∨ (1 : ℤ) ≤ valL F E' y)
      (hy1 : 1 + y ≠ 0), valL F E' (1 + y) = 0 := by
    intro y hy hy1
    have hmem : Units.mk0 (1 + y) hy1 ∈ unitGroup F E' 1 := by
      rw [hunitE'_mem 1 (by omega)]
      rcases hy with rfl | hle
      · left; simp [Units.val_mk0]
      · right; simp [Units.val_mk0, hle]
    simpa [Units.val_mk0] using hunitE'_val 1 (Units.mk0 (1 + y) hy1) hmem
  have hψ_triv_T : ∀ a : L, (a = 0 ∨ (T₂ : ℤ) ≤ valL F L a) →
      ψ (((cνE'⁻¹ : Lˣ) : L) * a) = 1 := by
    intro a ha
    apply hSpecL
    have hbound := hvalL_mul_bound (-((T₂ : ℤ) + condExpChar F L ψ)) (T₂ : ℤ)
      ((cνE'⁻¹ : Lˣ) : L) a
      (Or.inr (by rw [hvalL_inv, hcνE'_val])) ha
    rcases hbound with h0 | hle
    · exact Or.inl h0
    · exact Or.inr (by omega)
  have hψ_congr_T : ∀ a₁ a₂ : L, (a₁ - a₂ = 0 ∨ (T₂ : ℤ) ≤ valL F L (a₁ - a₂)) →
      ψ (((cνE'⁻¹ : Lˣ) : L) * a₁) = ψ (((cνE'⁻¹ : Lˣ) : L) * a₂) := by
    intro a₁ a₂ hdiff
    have h1 : ((cνE'⁻¹ : Lˣ) : L) * a₁ =
        ((cνE'⁻¹ : Lˣ) : L) * (a₁ - a₂) + ((cνE'⁻¹ : Lˣ) : L) * a₂ := by ring
    rw [h1, AddChar.map_add_eq_mul, hψ_triv_T (a₁ - a₂) hdiff, one_mul]
  have hψE'_triv_m2 : ∀ z : E', (z = 0 ∨ (m₂ : ℤ) ≤ valL F E' z) →
      ψE' (((cE'⁻¹ : E'ˣ) : E') * z) = 1 := by
    intro z hz
    apply hSpecE'
    have hbound := hvalE'_mul_bound (-((m₂ : ℤ) + condExpChar F E' (traceChar F hLE' ψ))) (m₂ : ℤ)
      ((cE'⁻¹ : E'ˣ) : E') z
      (Or.inr (by rw [hvalE'_inv, hcE'_val])) hz
    rcases hbound with h0 | hle
    · exact Or.inl h0
    · exact Or.inr (by omega)
  have hψE'_congr_m2 : ∀ z₁ z₂ : E', (z₁ - z₂ = 0 ∨ (m₂ : ℤ) ≤ valL F E' (z₁ - z₂)) →
      ψE' (((cE'⁻¹ : E'ˣ) : E') * z₁) = ψE' (((cE'⁻¹ : E'ˣ) : E') * z₂) := by
    intro z₁ z₂ hdiff
    have h1 : ((cE'⁻¹ : E'ˣ) : E') * z₁ =
        ((cE'⁻¹ : E'ˣ) : E') * (z₁ - z₂) + ((cE'⁻¹ : E'ˣ) : E') * z₂ := by ring
    rw [h1, AddChar.map_add_eq_mul, hψE'_triv_m2 (z₁ - z₂) hdiff, one_mul]
  let y : E' := IntermediateField.inclusion hLE' r
  let z_E : E' := ((ϖ_E' ^ e : E'ˣ) : E') * y
  obtain ⟨u_V, N_V, hu_V_coe, hN_V_val, hPerturb_eq⟩ := hPerturbEval r hr
  have hy_bound : y = 0 ∨ (0 : ℤ) ≤ valL F E' y := by
    rcases hr with rfl | hle
    · left; dsimp only [y]; exact map_zero _
    · right; dsimp only [y]; rw [hval_LE' r]; omega
  let v_crit : E' := (δ_E' : E') * y
  let u_crit : E'ˣ := Units.mk0 (1 + v_crit) hr_E
  have hv_crit_bound : v_crit = 0 ∨ (d₂ : ℤ) ≤ valL F E' v_crit := by
    have hb0 := hvalE'_mul_bound (d₂ : ℤ) 0 (δ_E' : E') y
      (Or.inr (by rw [hδ_E'_val])) hy_bound
    change v_crit = 0 ∨ (d₂ : ℤ) + 0 ≤ valL F E' v_crit at hb0
    exact hb0.imp id (fun hle => by omega)
  have hu_crit_val : valL F E' (u_crit : E') = 0 := by
    simpa [u_crit, Units.val_mk0] using
      hvalE'_one_add_eq_zero v_crit (hv_crit_bound.imp id (fun hle => by omega)) hr_E
  have hu_crit_inv_val : valL F E' ((u_crit⁻¹ : E'ˣ) : E') = 0 := by
    rw [hvalE'_inv u_crit, hu_crit_val, neg_zero]
  have hu_crit_inv_sub :
      ((u_crit⁻¹ : E'ˣ) : E') - 1 = -v_crit * ((u_crit⁻¹ : E'ˣ) : E') := by
    have hmul : (1 + v_crit) * ((u_crit⁻¹ : E'ˣ) : E') = 1 := Units.mul_inv u_crit
    linear_combination hmul
  have hu_crit_inv_sub_bound :
      ((u_crit⁻¹ : E'ˣ) : E') - 1 = 0 ∨ (d₂ : ℤ) ≤ valL F E' (((u_crit⁻¹ : E'ˣ) : E') - 1) := by
    rw [hu_crit_inv_sub]
    have hneg : -v_crit = 0 ∨ (d₂ : ℤ) ≤ valL F E' (-v_crit) := by
      rcases hv_crit_bound with h0 | hle
      · left; rw [h0, neg_zero]
      · right; rw [hvalE'_neg]; exact hle
    have hb0 := hvalE'_mul_bound (d₂ : ℤ) 0 (-v_crit) ((u_crit⁻¹ : E'ˣ) : E')
      hneg (Or.inr (by rw [hu_crit_inv_val]))
    exact hb0.imp id (fun hle => by omega)
  let w_N : E' := ((u_crit⁻¹ : E'ˣ) : E') * N_V
  have hw_N_bound : w_N = 0 ∨ (r₀E : ℤ) ≤ valL F E' w_N := by
    have hb0 := hvalE'_mul_bound 0 ((d₂ + 1 : ℕ) : ℤ) ((u_crit⁻¹ : E'ˣ) : E') N_V
      (Or.inr (by rw [hu_crit_inv_val])) hN_V_val
    change w_N = 0 ∨ 0 + ((d₂ + 1 : ℕ) : ℤ) ≤ valL F E' w_N at hb0
    exact hb0.imp id (fun hle => by omega)
  have h1_w_N_eq : 1 + w_N = ((u_crit⁻¹ * u_V : E'ˣ) : E') := by
    rw [Units.val_mul]
    have hinv : ((u_crit⁻¹ : E'ˣ) : E') * (1 + v_crit) = 1 := Units.inv_mul u_crit
    have hu_V_eq : (u_V : E') = 1 + v_crit + N_V := hu_V_coe
    rw [hu_V_eq]
    dsimp only [w_N]
    linear_combination -hinv
  have hw_N1 : 1 + w_N ≠ 0 := by
    rw [h1_w_N_eq]
    exact Units.ne_zero (u_crit⁻¹ * u_V)
  have hu_V_factor : u_V = u_crit * Units.mk0 (1 + w_N) hw_N1 := by
    apply Units.ext
    rw [Units.val_mul, Units.val_mk0 hw_N1, h1_w_N_eq, ← Units.val_mul, mul_inv_cancel_left]
  have hθ_u_V :
      (θE' u_V : Ω F) =
        (θE' u_crit : Ω F) * ψE' (((cE'⁻¹ : E'ˣ) : E') * N_V) := by
    have h1 : (θE' u_V : Ω F) =
        (θE' u_crit : Ω F) * (θE' (Units.mk0 (1 + w_N) hw_N1) : Ω F) := by
      conv_lhs => rw [hu_V_factor]
      rw [map_mul, Units.val_mul]
    rw [h1, hcE'_stat w_N hw_N_bound hw_N1]
    have hdiff : w_N - N_V = 0 ∨ (m₂ : ℤ) ≤ valL F E' (w_N - N_V) := by
      have hsub : w_N - N_V = (((u_crit⁻¹ : E'ˣ) : E') - 1) * N_V := by
        dsimp only [w_N]; ring
      rw [hsub]
      have hb0 := hvalE'_mul_bound (d₂ : ℤ) ((d₂ + 1 : ℕ) : ℤ)
        (((u_crit⁻¹ : E'ˣ) : E') - 1) N_V hu_crit_inv_sub_bound hN_V_val
      exact hb0.imp id (fun hle => by omega)
    rw [hψE'_congr_m2 w_N N_V hdiff]
  have hψE'_u_V :
      ψE' (((cE'⁻¹ : E'ˣ) : E') * ((u_V : E') - 1)) =
        ψE' (((cE'⁻¹ : E'ˣ) : E') * (δ_E' : E') * y) *
          ψE' (((cE'⁻¹ : E'ˣ) : E') * N_V) := by
    have h1 : ((cE'⁻¹ : E'ˣ) : E') * ((u_V : E') - 1) =
        ((cE'⁻¹ : E'ˣ) : E') * (δ_E' : E') * y + ((cE'⁻¹ : E'ˣ) : E') * N_V := by
      rw [hu_V_coe]
      dsimp only [y]
      ring
    rw [h1, AddChar.map_add_eq_mul]
  have hvalE'_ϖ_pow : ∀ n : ℕ, valL F E' (((ϖ_E' ^ n : E'ˣ) : E')) = (n : ℤ) := by
    intro n
    induction n with
    | zero =>
      simp [hvalE'_1]
    | succ n ih =>
      rw [pow_succ, Units.val_mul,
        hvalE'_mul _ _ (Units.ne_zero (ϖ_E' ^ n)) (Units.ne_zero ϖ_E'), ih, hϖ_E']
      omega
  have hvalL_ϖ_pow : ∀ n : ℕ, valL F L (((ϖ_L ^ n : Lˣ) : L)) = (n : ℤ) := by
    intro n
    induction n with
    | zero =>
      simp [hvalL_1]
    | succ n ih =>
      rw [pow_succ, Units.val_mul,
        hvalL_mul _ _ (Units.ne_zero (ϖ_L ^ n)) (Units.ne_zero ϖ_L), ih, hϖ_L]
      omega
  have htr_1 : traceLM F hLE' 1 = 2 := by
    have hq := (hQuadNorm L E' hLE' hdeg2).1 1
    rw [map_one (IntermediateField.inclusion hLE')] at hq
    rw [hq, mul_one]
  have hnorm_0 : normLM F hLE' 0 = 0 := by
    have hq := ((hQuadNorm L E' hLE' hdeg2).2 1 1).2
    rw [map_one (IntermediateField.inclusion hLE'), sub_self, htr_1, map_one (normLM F hLE')] at hq
    linear_combination hq
  have hnorm_y : normLM F hLE' y = r ^ 2 := by
    have hq := ((hQuadNorm L E' hLE' hdeg2).2 r 0).1
    rw [add_zero, map_zero, hnorm_0] at hq
    dsimp only [y]
    linear_combination hq
  have hnorm_ϖ_pow : normLM F hLE' (((ϖ_E' ^ e : E'ˣ) : E')) = ((ϖ_L ^ e : Lˣ) : L) := by
    have h1 : Units.map (normLM F hLE') (ϖ_E' ^ e) = ϖ_L ^ e := by
      rw [map_pow, hϖ_norm]
    exact congrArg Units.val h1
  let t_E : L := traceLM F hLE' z_E
  let n_E : L := normLM F hLE' z_E
  have hn_E_eq : n_E = ((ϖ_L ^ e : Lˣ) : L) * r ^ 2 := by
    dsimp only [n_E, z_E]
    rw [map_mul, hnorm_ϖ_pow, hnorm_y]
  have hz_E_bound : z_E = 0 ∨ (e : ℤ) ≤ valL F E' z_E := by
    have hb0 := hvalE'_mul_bound (e : ℤ) 0 (((ϖ_E' ^ e : E'ˣ) : E')) y
      (Or.inr (by rw [hvalE'_ϖ_pow e])) hy_bound
    change z_E = 0 ∨ (e : ℤ) + 0 ≤ valL F E' z_E at hb0
    exact hb0.imp id (fun hle => by omega)
  have ht_E_bound : t_E = 0 ∨ (r₀L : ℤ) ≤ valL F L t_E :=
    htr_LE' (r₀L : ℤ) z_E (hz_E_bound.imp id (fun hle => by omega))
  have hn_E_bound : n_E = 0 ∨ (e : ℤ) ≤ valL F L n_E := by
    rw [hn_E_eq]
    have hr2_bound : r ^ 2 = 0 ∨ (0 : ℤ) ≤ valL F L (r ^ 2) := by
      have hb0 := hvalL_mul_bound 0 0 r r hr hr
      rw [← sq] at hb0
      exact hb0.imp id (fun hle => by omega)
    have hb0 := hvalL_mul_bound (e : ℤ) 0 (((ϖ_L ^ e : Lˣ) : L)) (r ^ 2)
      (Or.inr (by rw [hvalL_ϖ_pow e])) hr2_bound
    exact hb0.imp id (fun hle => by omega)
  have hz_E1 : 1 + z_E ≠ 0 :=
    hone_add_ne_zero_E' z_E (hz_E_bound.imp id (fun hle => by omega))
  let w_E : E'ˣ := Units.mk0 (1 + z_E) hz_E1
  let N_E : Lˣ := Units.map (normLM F hLE') w_E
  have hν_N_E : (νE' N_E : Ω F) = 1 := by
    have h1 : νE' N_E = 1 := by
      rw [← hνE'_ker]
      exact ⟨w_E, rfl⟩
    simpa only [Units.val_one] using congrArg Units.val h1
  have hN_E_coe : (N_E : L) = 1 + t_E + n_E := by
    change normLM F hLE' (1 + z_E) = 1 + t_E + n_E
    have hq := ((hQuadNorm L E' hLE' hdeg2).2 1 z_E).1
    rw [map_one] at hq
    rw [hq]
    dsimp only [t_E, n_E]
    ring
  have hr_2' : 1 + n_E ≠ 0 := by
    rw [hn_E_eq]; exact hr_2
  let u_r2 : Lˣ := Units.mk0 (1 + n_E) hr_2'
  have hu_r2_val : valL F L (u_r2 : L) = 0 := by
    simpa [u_r2, Units.val_mk0] using
      hvalL_one_add_eq_zero n_E (hn_E_bound.imp id (fun hle => by omega)) hr_2'
  have hu_r2_inv_val : valL F L ((u_r2⁻¹ : Lˣ) : L) = 0 := by
    rw [hvalL_inv u_r2, hu_r2_val, neg_zero]
  have hu_r2_inv_sub :
      ((u_r2⁻¹ : Lˣ) : L) - 1 = -n_E * ((u_r2⁻¹ : Lˣ) : L) := by
    have hmul : (1 + n_E) * ((u_r2⁻¹ : Lˣ) : L) = 1 := Units.mul_inv u_r2
    linear_combination hmul
  have hu_r2_inv_sub_bound :
      ((u_r2⁻¹ : Lˣ) : L) - 1 = 0 ∨ (e : ℤ) ≤ valL F L (((u_r2⁻¹ : Lˣ) : L) - 1) := by
    rw [hu_r2_inv_sub]
    have hneg : -n_E = 0 ∨ (e : ℤ) ≤ valL F L (-n_E) := by
      rcases hn_E_bound with h0 | hle
      · left; rw [h0, neg_zero]
      · right; rw [hvalL_neg]; exact hle
    have hb0 := hvalL_mul_bound (e : ℤ) 0 (-n_E) ((u_r2⁻¹ : Lˣ) : L)
      hneg (Or.inr (by rw [hu_r2_inv_val]))
    exact hb0.imp id (fun hle => by omega)
  let u_t : L := ((u_r2⁻¹ : Lˣ) : L) * t_E
  have hu_t_bound : u_t = 0 ∨ (r₀L : ℤ) ≤ valL F L u_t := by
    have hb0 := hvalL_mul_bound 0 (r₀L : ℤ) ((u_r2⁻¹ : Lˣ) : L) t_E
      (Or.inr (by rw [hu_r2_inv_val])) ht_E_bound
    change u_t = 0 ∨ 0 + (r₀L : ℤ) ≤ valL F L u_t at hb0
    exact hb0.imp id (fun hle => by omega)
  have h1_u_t_eq : 1 + u_t = ((u_r2⁻¹ * N_E : Lˣ) : L) := by
    rw [Units.val_mul, hN_E_coe]
    have hinv : ((u_r2⁻¹ : Lˣ) : L) * (1 + n_E) = 1 := Units.inv_mul u_r2
    dsimp only [u_t]
    linear_combination -hinv
  have hu_t1 : 1 + u_t ≠ 0 := by
    rw [h1_u_t_eq]
    exact Units.ne_zero (u_r2⁻¹ * N_E)
  have hN_E_factor : N_E = u_r2 * Units.mk0 (1 + u_t) hu_t1 := by
    apply Units.ext
    rw [Units.val_mul, Units.val_mk0 hu_t1, h1_u_t_eq, ← Units.val_mul, mul_inv_cancel_left]
  have hL_side :
      (νE' (Units.mk0 (1 + ((ϖ_L ^ e : Lˣ) : L) * r ^ 2) hr_2) : Ω F) *
        ψ (((cνE'⁻¹ : Lˣ) : L) * t_E) = 1 := by
    have hu_r2_eq : u_r2 = Units.mk0 (1 + ((ϖ_L ^ e : Lˣ) : L) * r ^ 2) hr_2 := by
      apply Units.ext
      simp [u_r2, Units.val_mk0, hn_E_eq]
    rw [← hu_r2_eq]
    have h1 : (νE' N_E : Ω F) =
        (νE' u_r2 : Ω F) * (νE' (Units.mk0 (1 + u_t) hu_t1) : Ω F) := by
      conv_lhs => rw [hN_E_factor]
      rw [map_mul, Units.val_mul]
    rw [hν_N_E, hcνE'_stat u_t hu_t_bound hu_t1] at h1
    have hdiff : u_t - t_E = 0 ∨ (T₂ : ℤ) ≤ valL F L (u_t - t_E) := by
      have hsub : u_t - t_E = (((u_r2⁻¹ : Lˣ) : L) - 1) * t_E := by
        dsimp only [u_t]; ring
      rw [hsub]
      have hb0 := hvalL_mul_bound (e : ℤ) (r₀L : ℤ)
        (((u_r2⁻¹ : Lˣ) : L) - 1) t_E hu_r2_inv_sub_bound ht_E_bound
      exact hb0.imp id (fun hle => by omega)
    rw [hψ_congr_T u_t t_E hdiff] at h1
    exact h1.symm
  let Θ : Ω F := (θE' u_crit : Ω F)
  let Ψ_crit : Ω F := ψE' (((cE'⁻¹ : E'ˣ) : E') * (δ_E' : E') * y)
  let Ψ_N : Ω F := ψE' (((cE'⁻¹ : E'ˣ) : E') * N_V)
  let Ψ_N_inv : Ω F := ψE' (-(((cE'⁻¹ : E'ˣ) : E') * N_V))
  let N₂ : Ω F := (νE' (Units.mk0 (1 + ((ϖ_L ^ e : Lˣ) : L) * r ^ 2) hr_2) : Ω F)
  let Ψ_t : Ω F := ψ (((cνE'⁻¹ : Lˣ) : L) * t_E)
  let Ψ_n : Ω F := ψ (((cνE'⁻¹ : Lˣ) : L) * ((ϖ_L ^ e : Lˣ) : L) * r ^ 2)
  have hψ_z_E :
      ψ (((cνE'⁻¹ : Lˣ) : L) * (traceLM F hLE' z_E + normLM F hLE' z_E)) =
        Ψ_t * Ψ_n := by
    change ψ (((cνE'⁻¹ : Lˣ) : L) * (t_E + n_E)) = Ψ_t * Ψ_n
    have h1 : ((cνE'⁻¹ : Lˣ) : L) * (t_E + n_E) =
        ((cνE'⁻¹ : Lˣ) : L) * t_E + ((cνE'⁻¹ : Lˣ) : L) * ((ϖ_L ^ e : Lˣ) : L) * r ^ 2 := by
      rw [hn_E_eq]; ring
    rw [h1, AddChar.map_add_eq_mul]
  have hΨ_N_mul : Ψ_N * Ψ_N_inv = 1 := by
    dsimp only [Ψ_N, Ψ_N_inv]
    rw [← AddChar.map_add_eq_mul, add_neg_cancel, AddChar.map_zero_eq_one]
  have h1 : Θ * Ψ_N = Ψ_crit * Ψ_N * (Ψ_t * Ψ_n) := by
    have hp := hPerturb_eq
    rw [hθ_u_V, hψE'_u_V, hψ_z_E] at hp
    exact hp
  have h1' : Θ = Ψ_crit * Ψ_t * Ψ_n := by
    linear_combination Ψ_N_inv * h1 - (Θ - Ψ_crit * Ψ_t * Ψ_n) * hΨ_N_mul
  have h2 : N₂ * Ψ_t = 1 := hL_side
  have h_N2_Θ : N₂ * Θ = Ψ_crit * Ψ_n := by
    linear_combination N₂ * h1' + Ψ_crit * Ψ_n * h2
  have hΘ_inv : Θ⁻¹ * Θ = 1 := inv_mul_cancel₀ (Units.ne_zero _)
  have hΨ_n_mul :
      Ψ_n * ψ (-(((cνE'⁻¹ : Lˣ) : L) * ((ϖ_L ^ e : Lˣ) : L) * r ^ 2)) = 1 := by
    dsimp only [Ψ_n]
    rw [← AddChar.map_add_eq_mul, add_neg_cancel, AddChar.map_zero_eq_one]
  have hΨ_n_ne : Ψ_n ≠ 0 := by
    apply left_ne_zero_of_mul (b := ψ (-(((cνE'⁻¹ : Lˣ) : L) * ((ϖ_L ^ e : Lˣ) : L) * r ^ 2)))
    rw [hΨ_n_mul]
    exact one_ne_zero
  have hΨ_n_inv : Ψ_n * Ψ_n⁻¹ = 1 := mul_inv_cancel₀ hΨ_n_ne
  change Θ⁻¹ * Ψ_crit = N₂ * Ψ_n⁻¹
  linear_combination
    -Θ⁻¹ * Ψ_n⁻¹ * h_N2_Θ + N₂ * Ψ_n⁻¹ * hΘ_inv - Θ⁻¹ * Ψ_crit * hΨ_n_inv

theorem ld_ch12_wild_dyadic_odd_max_break_higher_cond_deltaE_and_crit_rec (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
