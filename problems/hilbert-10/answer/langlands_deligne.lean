      ψ (((c_ν₁⁻¹ : Lˣ) : L) * normLM F hLK z) =
        ψ (- ((c_ν₁⁻¹ : Lˣ) : L) * traceLM F hLK z))
    (hu_corr_eq : (u_corr : K) = 1 - IntermediateField.inclusion hLK (δ : L) * ((u_K⁻¹ : Kˣ) : K))
    (hc_K_eq : c_K = (Units.map (IntermediateField.inclusion hLK) c_χ') * u_corr⁻¹)
    (hc_K_val : valL F K (c_K : K) =
      (condExp F K (χ'.comp (Units.map (normLM F hLK))) : ℤ) +
        condExpChar F K (traceChar F hLK ψ))
    (hc_K_stat : ∀ y : K,
      (y = 0 ∨ (((condExp F K (χ'.comp (Units.map (normLM F hLK))) + 1) / 2 : ℕ) : ℤ) ≤
        valL F K y) →
      ∀ hy : 1 + y ≠ 0,
        ((χ'.comp (Units.map (normLM F hLK))) (Units.mk0 (1 + y) hy) : Ω F) =
          (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K) * y))
    (hrhs_twist : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK),
      ∀ τ : L, (τ = 0 ∨ 0 ≤ valL F L τ) →
        (τ - (j : L) = 0 ∨
          ((((Module.finrank L (IntermediateField.extendScalars hLK) - 1) *
            condExp F L ν₁ /
            Module.finrank L (IntermediateField.extendScalars hLK) : ℕ) : ℤ) ≤
            valL F L (τ - (j : L)))) →
        ∃ u_τ : Lˣ,
          (u_τ : L) = 1 + τ * (δ : L) ∧
          tateEps F L (ν₁ ^ j * χ') ψ =
            (((ν₁ ^ j * χ') u_τ : Ω F)⁻¹) *
              ψ (((c_χ'⁻¹ : Lˣ) : L) * τ * (δ : L)) *
              tateEps F L χ' ψ)
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E)) *
                ∑ r ∈ R_E,
                  if hr : 1 + (δ : E) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                      ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                  else 0))))
    (hFF2 : ∀ (ψ₀ : AddChar k_L (Ω F)), ψ₀ ≠ 1 →
      (2 : k_L) = 0 →
      ∀ (Q : k_L → Ω F),
        Q 0 = 1 →
        (∀ x y : k_L, Q (x + y) = Q x * Q y * ψ₀ (x * y)) →
        ((∀ x : k_L, Q x ≠ 0) →
          (∑ x : k_L, Q x) * (∑ y : k_L, (Q y)⁻¹) = (Fintype.card k_L : Ω F)) ∧
        (∀ x₀ : k_L, (∀ y : k_L, (Q y) ^ 2 = ψ₀ (x₀ * y)) →
          (∑ x : k_L, Q x) ^ 2 = (Fintype.card k_L : Ω F) * Q x₀)) :
    tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j) ψ) =
    tateEps F K 1 (traceChar F hLK ψ) *
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j * χ') ψ) :=
by
  obtain ⟨hchar2, htr_incl, htr_smul, hnorm_incl, hnorm_add,
    x_0, z_0, hx0_val, hz0_coe, hw_sq, hRHS_prod⟩ :=
    ld_wild_mid_cond_dyadic_quad_norm_and_prefactor F L K hLK hp2 ψ ν₁ χ'
      hν₁_ker hb_ge2 hval_alg hba ha2b hvalL_props hvalK_props hSpecL
      k_L resL hresL_1 hresL_ring hresL_ker t hb_eq hp_val htr_bound
      c_χ' c_ν₁ δ u_K u_corr c_K hc_χ'_val hc_ν₁_val hc_ν₁_ν₁ hc_ν₁_stat
      hδ_eq hu_K_norm hu_K_val hδ_val hnorm_to_tr hu_corr_eq hc_K_eq hrhs_twist
  have ha_ge2 : 2 ≤ condExp F L χ' := by omega
  have hEps_χ'_sq :=
    ld_wild_mid_cond_dyadic_L_chi_sq_eval F L ψ hψ χ' ha_ge2 hvalL_props hSpecL
      ϖ_L hϖ_L k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj hchar2
      R_L c_χ' hRL_card hRL_int hRL_sep hRL_surj hc_χ'_val hc_χ'_stat
      x_0 z_0 hx0_val hz0_coe hw_sq hStat hFF2
  have hProd_χ' :=
    hRHS_prod
      (((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
        (Fintype.card k_L : Ω F) ^ (condExp F L χ'))
      hEps_χ'_sq
  have hProd_K_ν :=
    ld_wild_mid_cond_dyadic_K_and_nu_prod_eval F L K hLK hp2 ψ hψ hψK ν₁ χ'
      hν₁_ker hb_ge2 hval_alg hba haK hvalL_props hvalK_props hSpecL
      ϖ_K ϖ_L hϖ_norm hϖ_K hϖ_L hBasis k_L resL hresL_0 hresL_1 hresL_ring
      hresL_ker hresL_surj hchar2 t hb_eq htr_bound R_L c_χ' c_ν₁ δ u_K u_corr c_K
      hRL_card hRL_int hRL_sep hRL_surj hc_χ'_val hc_χ'_stat hc_ν₁_val hc_ν₁_stat
      hδ_eq hu_K_norm hu_K_val hδ_val hu_corr_eq hc_K_eq hc_K_val hc_K_stat
      htr_incl htr_smul hnorm_incl hnorm_add hStat hFF2
  have hcond_1L : condExp F L 1 = 0 :=
    Nat.sInf_eq_zero.mpr (Or.inl (fun _ _ => rfl))
  have hEps_1L : tateEps F L 1 ψ = (qL F L : Ω F) ^ condExpChar F L ψ := by
    unfold tateEps
    rw [if_pos hcond_1L]
    simp
  have hcond_1K : condExp F K 1 = 0 :=
    Nat.sInf_eq_zero.mpr (Or.inl (fun _ _ => rfl))
  have hEps_1K : tateEps F K 1 (traceChar F hLK ψ) =
      (qL F K : Ω F) ^ condExpChar F K (traceChar F hLK ψ) := by
    unfold tateEps
    rw [if_pos hcond_1K]
    simp
  have hProd_ν :
      (∏ j ∈ Finset.range (Module.finrank L (IntermediateField.extendScalars hLK)),
        tateEps F L (ν₁ ^ j) ψ) =
      (qL F L : Ω F) ^ condExpChar F L ψ * tateEps F L ν₁ ψ := by
    rw [hp2]
    simp [Finset.prod_range_succ, hEps_1L]
  rw [hProd_ν, hProd_χ', hEps_1K]
  calc tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
        ((qL F L : Ω F) ^ condExpChar F L ψ * tateEps F L ν₁ ψ)
      = (qL F L : Ω F) ^ condExpChar F L ψ *
          (tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) *
            tateEps F L ν₁ ψ) := by ring
    _ = (qL F L : Ω F) ^ condExpChar F L ψ *
          ((qL F K : Ω F) ^ condExpChar F K (traceChar F hLK ψ) *
            (qL F L : Ω F) ^ condExpChar F L ψ *
            (Fintype.card k_L : Ω F) ^ (condExp F L χ') *
            (((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) *
              (ν₁ c_ν₁ : Ω F) *
              (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K)) *
              ψ (((c_ν₁⁻¹ : Lˣ) : L)))) := by rw [hProd_K_ν]
    _ = (qL F K : Ω F) ^ condExpChar F K (traceChar F hLK ψ) *
          (((qL F L : Ω F) ^ condExpChar F L ψ) ^ 2 *
            (Fintype.card k_L : Ω F) ^ (condExp F L χ') *
            (((χ'.comp (Units.map (normLM F hLK))) c_K : Ω F) *
              (ν₁ c_ν₁ : Ω F) *
              (traceChar F hLK ψ) (((c_K⁻¹ : Kˣ) : K)) *
              ψ (((c_ν₁⁻¹ : Lˣ) : L)))) := by ring

theorem ld_wild_odd_free_orbit_symm_functions (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (t : ℕ)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (G : Type u) [Group G] [Fintype G] (act : G → K → K)
    (hcard_G : Fintype.card G = Module.finrank L (IntermediateField.extendScalars hLK))
    (hact_one : ∀ y : K, act 1 y = y)
    (hact_mul : ∀ (σ τ : G) (y : K), act (σ * τ) y = act σ (act τ y))
    (hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ y₁ y₂ : K,
        act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
        act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
        act σ (-y₁) = -act σ y₁))
    (hact_incl : ∀ (σ : G) (x : L), act σ (IntermediateField.inclusion hLK x) =
      IntermediateField.inclusion hLK x)
    (hact_val : ∀ (σ : G) (y : K), valL F K (act σ y) = valL F K y)
    (hact_trace : ∀ y : K, IntermediateField.inclusion hLK (traceLM F hLK y) = ∑ σ : G, act σ y)
    (hact_norm : ∀ y : K, IntermediateField.inclusion hLK (normLM F hLK y) = ∏ σ : G, act σ y) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    ∃ s : K → ℕ → L,
      (∀ y : K, s y 1 = traceLM F hLK y) ∧
      (∀ y : K, 2 * s y 2 = (traceLM F hLK y) ^ 2 - traceLM F hLK (y ^ 2)) ∧
      (∀ y : K, y ≠ 0 → s y (p - 1) = normLM F hLK y * traceLM F hLK (y⁻¹)) ∧
      (∀ (y : K) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
        ∀ (q m : ℤ), (y = 0 ∨ q ≤ valL F K y) →
          (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ (r : ℤ) * q →
          (s y r = 0 ∨ m ≤ valL F L (s y r))) ∧
      (∀ (y : K) (c : L),
        normLM F hLK (1 + IntermediateField.inclusion hLK c * y) =
          1 + (∑ r ∈ Finset.Icc 1 (p - 1), c ^ r * s y r) +
            c ^ p * normLM F hLK y) :=
by
  rcases hvalK_props with
    ⟨hvalK0, hvalK1, _, _, hvalK_mul, _, _, hvalK_add, _⟩
  set p : ℕ := Module.finrank L (IntermediateField.extendScalars hLK)
  haveI : Fact (Nat.Prime p) := ⟨hPrime⟩
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have hcard_univ : (Finset.univ : Finset G).card = p := Finset.card_univ.trans hcard_G
  
  let φ : G → (K →+* K) := fun σ =>
    { toFun := act σ
      map_one' := (hact_ring σ).2.1
      map_mul' := fun y₁ y₂ => ((hact_ring σ).2.2 y₁ y₂).2.1
      map_zero' := (hact_ring σ).1
      map_add' := fun y₁ y₂ => ((hact_ring σ).2.2 y₁ y₂).1 }
  let U_pow : Finset (Finset G) := (Finset.univ : Finset G).powerset
  let P_card : ℕ → Finset (Finset G) := fun r => U_pow.filter (fun S => S.card = r)
  let P : K → Finset G → K := fun y S => ∏ s ∈ S, act s y
  let trS : G → Finset G → Finset G := fun τ S => S.image (fun s => τ * s)
  have hmem_P : ∀ (r : ℕ) (S : Finset G), S ∈ P_card r ↔ S.card = r := by
    intro r S
    simp [P_card, U_pow]
  have trS_card : ∀ (τ : G) (S : Finset G), (trS τ S).card = S.card :=
    fun τ S => Finset.card_image_of_injective S (mul_right_injective τ)
  have trS_one : ∀ (S : Finset G), trS 1 S = S := by
    intro S
    ext x
    simp [trS]
  have trS_mul : ∀ (σ τ : G) (S : Finset G), trS (σ * τ) S = trS σ (trS τ S) := by
    intro σ τ S
    ext x
    simp [trS, mul_assoc]
  have trS_mem_P : ∀ {r : ℕ} {S : Finset G}, S ∈ P_card r → ∀ (τ : G), trS τ S ∈ P_card r := by
    intro r S hS τ
    rw [hmem_P, trS_card]
    exact (hmem_P r S).mp hS
  have P_trS : ∀ (y : K) (τ : G) (S : Finset G), P y (trS τ S) = act τ (P y S) := by
    intro y τ S
    change (∏ x ∈ S.image (fun s => τ * s), act x y) = φ τ (∏ s ∈ S, act s y)
    rw [Finset.prod_image (fun s₁ _ s₂ _ h => mul_right_injective τ h), map_prod (φ τ)]
    refine Finset.prod_congr rfl fun s _ => ?_
    exact hact_mul τ s y
  
  have trS_free : ∀ {r : ℕ}, r ∈ Finset.Icc 1 (p - 1) →
      ∀ {S : Finset G}, S ∈ P_card r → ∀ {τ : G}, trS τ S = S → τ = 1 := by
    intro r hr S hS τ hfix
    obtain ⟨hge1, hle⟩ := Finset.mem_Icc.mp hr
    have hcard_S : S.card = r := (hmem_P r S).mp hS
    by_contra hτ
    have hpow_p : τ ^ p = 1 := by
      rw [← hcard_G]
      exact pow_card_eq_one
    have hord : orderOf τ = p := orderOf_eq_prime hpow_p hτ
    have hS_pos : 0 < S.card := by omega
    obtain ⟨s₀, hs₀⟩ := Finset.card_pos.mp hS_pos
    have hpow_mem : ∀ k : ℕ, τ ^ k * s₀ ∈ S := by
      intro k
      induction k with
      | zero => simp [hs₀]
      | succ k ih =>
        have hstep : τ * (τ ^ k * s₀) ∈ trS τ S :=
          Finset.mem_image_of_mem (fun s => τ * s) ih
        rw [hfix, ← mul_assoc, ← pow_succ'] at hstep
        exact hstep
    let f : Fin p → G := fun k => τ ^ k.1 * s₀
    have hMaps : Set.MapsTo f ↑(Finset.univ : Finset (Fin p)) ↑S := by
      intro k _
      exact Finset.mem_coe.mpr (hpow_mem k.1)
    have hInj : Set.InjOn f ↑(Finset.univ : Finset (Fin p)) := by
      intro k₁ _ k₂ _ heq
      have hpow_eq : τ ^ k₁.1 = τ ^ k₂.1 := mul_left_injective s₀ heq
      have hk₁ : k₁.1 ∈ Set.Iio (orderOf τ) := by
        simp only [Set.mem_Iio, hord]
        exact k₁.2
      have hk₂ : k₂.1 ∈ Set.Iio (orderOf τ) := by
        simp only [Set.mem_Iio, hord]
        exact k₂.2
      exact Fin.ext (pow_injOn_Iio_orderOf hk₁ hk₂ hpow_eq)
    have hcard_le := Finset.card_le_card_of_injOn f hMaps hInj
    simp only [Finset.card_univ, Fintype.card_fin] at hcard_le
    omega
  have trS_inj : ∀ {r : ℕ}, r ∈ Finset.Icc 1 (p - 1) →
      ∀ {S : Finset G}, S ∈ P_card r → Function.Injective (fun τ : G => trS τ S) := by
    intro r hr S hS τ₁ τ₂ heq
    dsimp only at heq
    have hfix : trS (τ₁⁻¹ * τ₂) S = S := by
      rw [trS_mul, ← heq, ← trS_mul, inv_mul_cancel, trS_one]
    exact inv_mul_eq_one.mp (trS_free hr hS hfix)
  
  let orb : Finset G → Finset (Finset G) :=
    fun S => (Finset.univ : Finset G).image (fun τ => trS τ S)
  let chooseOrb : Finset (Finset G) → Finset G :=
    fun O => if h : ∃ T, T ∈ O then Classical.choose h else ∅
  let rep : Finset G → Finset G := fun S => chooseOrb (orb S)
  let R_card : ℕ → Finset (Finset G) := fun r => (P_card r).image rep
  have mem_orb_self : ∀ (S : Finset G), S ∈ orb S := by
    intro S
    refine Finset.mem_image.mpr ⟨1, Finset.mem_univ 1, trS_one S⟩
  have orb_trS : ∀ (σ : G) (S : Finset G), orb (trS σ S) = orb S := by
    intro σ S
    ext T
    simp only [orb, Finset.mem_image, Finset.mem_univ, true_and]
    constructor
    · rintro ⟨τ, rfl⟩
      exact ⟨τ * σ, trS_mul τ σ S⟩
    · rintro ⟨ρ, rfl⟩
      refine ⟨ρ * σ⁻¹, ?_⟩
      rw [← trS_mul, inv_mul_cancel_right]
  have orb_eq_of_mem : ∀ {S T : Finset G}, T ∈ orb S → orb T = orb S := by
    intro S T hT
    obtain ⟨σ, _, rfl⟩ := Finset.mem_image.mp hT
    exact orb_trS σ S
  have rep_mem_orb : ∀ (S : Finset G), rep S ∈ orb S := by
    intro S
    have hex : ∃ T, T ∈ orb S := ⟨S, mem_orb_self S⟩
    have hdef : rep S = Classical.choose hex := dif_pos hex
    rw [hdef]
    exact Classical.choose_spec hex
  have orb_rep : ∀ (S : Finset G), orb (rep S) = orb S :=
    fun S => orb_eq_of_mem (rep_mem_orb S)
  have rep_eq_iff : ∀ (S₁ S₂ : Finset G), rep S₁ = rep S₂ ↔ orb S₁ = orb S₂ := by
    intro S₁ S₂
    constructor
    · intro h
      rw [← orb_rep S₁, h, orb_rep S₂]
    · intro h
      exact congrArg chooseOrb h
  have R_sub_P : ∀ (r : ℕ), ∀ S₀ ∈ R_card r, S₀ ∈ P_card r ∧ rep S₀ = S₀ := by
    intro r S₀ hS₀
    obtain ⟨S, hS, rfl⟩ := Finset.mem_image.mp hS₀
    obtain ⟨τ, _, hτ⟩ := Finset.mem_image.mp (rep_mem_orb S)
    refine ⟨hτ ▸ trS_mem_P hS τ, ?_⟩
    exact (rep_eq_iff (rep S) S).mpr (orb_rep S)
  have hfiber : ∀ (r : ℕ), ∀ S₀ ∈ R_card r,
      (P_card r).filter (fun S => rep S = S₀) = orb S₀ := by
    intro r S₀ hS₀
    obtain ⟨hS₀_P, hS₀_rep⟩ := R_sub_P r S₀ hS₀
    ext S
    simp only [Finset.mem_filter]
    constructor
    · rintro ⟨_, hrep⟩
      have horb : orb S = orb S₀ := (rep_eq_iff S S₀).mp (hrep.trans hS₀_rep.symm)
      rw [← horb]
      exact mem_orb_self S
    · intro hmem
      obtain ⟨τ, _, rfl⟩ := Finset.mem_image.mp hmem
      refine ⟨trS_mem_P hS₀_P τ, ?_⟩
      have horb : orb (trS τ S₀) = orb S₀ := orb_trS τ S₀
      exact ((rep_eq_iff (trS τ S₀) S₀).mpr horb).trans hS₀_rep
  let z : K → ℕ → K := fun y r => ∑ S₀ ∈ R_card r, P y S₀
  let s : K → ℕ → L := fun y r => traceLM F hLK (z y r)
  have hs_incl : ∀ (y : K) {r : ℕ}, r ∈ Finset.Icc 1 (p - 1) →
      IntermediateField.inclusion hLK (s y r) = ∑ S ∈ P_card r, P y S := by
    intro y r hr
    symm
    rw [← Finset.sum_fiberwise_of_maps_to (fun S hS => Finset.mem_image_of_mem rep hS) (P y)]
    have h1 :
        (∑ S₀ ∈ R_card r, ∑ S ∈ P_card r with rep S = S₀, P y S) =
          ∑ S₀ ∈ R_card r, ∑ τ ∈ (Finset.univ : Finset G), act τ (P y S₀) := by
      refine Finset.sum_congr rfl fun S₀ hS₀ => ?_
      have hS₀_P : S₀ ∈ P_card r := (R_sub_P r S₀ hS₀).1
      rw [hfiber r S₀ hS₀]
      change (∑ S ∈ (Finset.univ : Finset G).image (fun τ => trS τ S₀), P y S) = _
      rw [Finset.sum_image (fun τ₁ _ τ₂ _ h => trS_inj hr hS₀_P h)]
      refine Finset.sum_congr rfl fun τ _ => ?_
      exact P_trS y τ S₀
    rw [h1, Finset.sum_comm]
    have h2 :
        (∑ τ ∈ (Finset.univ : Finset G), ∑ S₀ ∈ R_card r, act τ (P y S₀)) =
          ∑ τ : G, act τ (z y r) := by
      refine Finset.sum_congr rfl fun τ _ => ?_
      exact (map_sum (φ τ) (P y) (R_card r)).symm
    rw [h2, ← hact_trace (z y r)]
  have hP1_eq : P_card 1 = (Finset.univ : Finset G).image (fun σ : G => ({σ} : Finset G)) := by
    ext S
    simp only [hmem_P, Finset.mem_image, Finset.mem_univ, true_and]
    constructor
    · intro hcard1
      obtain ⟨σ, rfl⟩ := Finset.card_eq_one.mp hcard1
      exact ⟨σ, rfl⟩
    · rintro ⟨σ, rfl⟩
      exact Finset.card_singleton σ
  have hs_one : ∀ y : K, s y 1 = traceLM F hLK y := by
    intro y
    apply (IntermediateField.inclusion hLK).injective
    change IntermediateField.inclusion hLK (s y 1) =
      IntermediateField.inclusion hLK (traceLM F hLK y)
    have hr1 : 1 ∈ Finset.Icc 1 (p - 1) := by
      rw [Finset.mem_Icc]
      omega
    rw [hs_incl y hr1, hP1_eq, Finset.sum_image (fun σ₁ _ σ₂ _ h => Finset.singleton_injective h)]
    have h1 : (∑ σ ∈ (Finset.univ : Finset G), P y {σ}) = ∑ σ : G, act σ y := by
      refine Finset.sum_congr rfl fun σ _ => ?_
      exact Finset.prod_singleton (fun s => act s y) σ
    rw [h1, ← hact_trace y]
  
  have hpair_fiber : ∀ {a b : G}, a ≠ b →
      ((Finset.univ : Finset G).offDiag).filter
        (fun x : G × G => ({x.1, x.2} : Finset G) = {a, b}) = {(a, b), (b, a)} := by
    intro a b hab
    ext ⟨u, v⟩
    simp only [Finset.mem_filter, Finset.mem_offDiag, Finset.mem_univ, true_and,
      Finset.mem_insert, Finset.mem_singleton, Prod.mk.injEq]
    constructor
    · rintro ⟨huv, hset⟩
      have hu : u = a ∨ u = b := by
        have h1 : u ∈ ({u, v} : Finset G) := by simp
        rw [hset] at h1
        simpa using h1
      have hv : v = a ∨ v = b := by
        have h1 : v ∈ ({u, v} : Finset G) := by simp
        rw [hset] at h1
        simpa using h1
      rcases hu with rfl | rfl <;> rcases hv with rfl | rfl
      · exact False.elim (huv rfl)
      · exact Or.inl ⟨rfl, rfl⟩
      · exact Or.inr ⟨rfl, rfl⟩
      · exact False.elim (huv rfl)
    · rintro (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
      · exact ⟨hab, rfl⟩
      · exact ⟨hab.symm, Finset.pair_comm u v⟩
  have hs_two : ∀ y : K, 2 * s y 2 = (traceLM F hLK y) ^ 2 - traceLM F hLK (y ^ 2) := by
    intro y
    let ι := IntermediateField.inclusion hLK
    apply ι.injective
    change ι (2 * s y 2) = ι ((traceLM F hLK y) ^ 2 - traceLM F hLK (y ^ 2))
    have hr2 : 2 ∈ Finset.Icc 1 (p - 1) := by
      rw [Finset.mem_Icc]
      omega
    have htr_sq :
        (ι (traceLM F hLK y)) ^ 2 =
          (∑ x ∈ (Finset.univ : Finset G).diag, act x.1 y * act x.2 y) +
            (∑ x ∈ (Finset.univ : Finset G).offDiag, act x.1 y * act x.2 y) := by
      rw [hact_trace y, sq, Finset.sum_mul_sum, ← Finset.sum_product',
        ← Finset.diag_union_offDiag (Finset.univ : Finset G),
        Finset.sum_union (Finset.disjoint_diag_offDiag (Finset.univ : Finset G))]
    have hdiag_sum :
        (∑ x ∈ (Finset.univ : Finset G).diag, act x.1 y * act x.2 y) =
          ι (traceLM F hLK (y ^ 2)) := by
      rw [Finset.sum_diag]
      have h1 : (∑ σ ∈ (Finset.univ : Finset G), act σ y * act σ y) =
          ∑ σ : G, act σ (y ^ 2) := by
        refine Finset.sum_congr rfl fun σ _ => ?_
        rw [sq, ((hact_ring σ).2.2 y y).2.1]
      rw [h1, ← hact_trace (y ^ 2)]
    let g_pair : G × G → Finset G := fun x => {x.1, x.2}
    have hmaps_pair : ∀ x ∈ (Finset.univ : Finset G).offDiag, g_pair x ∈ P_card 2 := by
      intro x hx
      have hne : x.1 ≠ x.2 := (Finset.mem_offDiag.mp hx).2.2
      rw [hmem_P]
      exact Finset.card_pair hne
    have hoffDiag_sum :
        (∑ x ∈ (Finset.univ : Finset G).offDiag, act x.1 y * act x.2 y) =
          2 * ι (s y 2) := by
      rw [← Finset.sum_fiberwise_of_maps_to hmaps_pair (fun x : G × G => act x.1 y * act x.2 y)]
      have h1 :
          (∑ S ∈ P_card 2, ∑ x ∈ (Finset.univ : Finset G).offDiag with g_pair x = S,
              act x.1 y * act x.2 y) =
            ∑ S ∈ P_card 2, 2 * P y S := by
        refine Finset.sum_congr rfl fun S hS => ?_
        obtain ⟨a, b, hab, rfl⟩ := Finset.card_eq_two.mp ((hmem_P 2 S).mp hS)
        change (∑ x ∈ ((Finset.univ : Finset G).offDiag).filter
            (fun x : G × G => ({x.1, x.2} : Finset G) = {a, b}), act x.1 y * act x.2 y) =
          2 * P y {a, b}
        rw [hpair_fiber hab]
        have hpair_ne : ((a, b) : G × G) ≠ (b, a) := by
          intro h
          exact hab (Prod.ext_iff.mp h).1
        rw [Finset.sum_pair hpair_ne]
        have hprod_ab : P y {a, b} = act a y * act b y := Finset.prod_pair hab
        rw [hprod_ab]
        dsimp only
        ring
      rw [h1, ← Finset.mul_sum, ← hs_incl y hr2]
    rw [map_mul, map_ofNat, map_sub, map_pow, htr_sq, hdiag_sum, hoffDiag_sum]
    ring
  
  have hP_pm1_eq :
      P_card (p - 1) =
        (Finset.univ : Finset G).image (fun σ : G => (Finset.univ : Finset G).erase σ) := by
    ext S
    simp only [hmem_P, Finset.mem_image, Finset.mem_univ, true_and]
    constructor
    · intro hcard
      have hsdiff : ((Finset.univ : Finset G) \ S).card = 1 := by
        rw [Finset.card_sdiff_of_subset (Finset.subset_univ S), hcard_univ, hcard]
        omega
      obtain ⟨σ, hσ⟩ := Finset.card_eq_one.mp hsdiff
      refine ⟨σ, ?_⟩
      ext τ
      have hmem_sdiff : τ ∈ (Finset.univ : Finset G) \ S ↔ τ = σ := by
        rw [hσ, Finset.mem_singleton]
      simp only [Finset.mem_sdiff, Finset.mem_univ, true_and] at hmem_sdiff
      simp only [Finset.mem_erase, Finset.mem_univ, and_true]
      tauto
    · rintro ⟨σ, rfl⟩
      rw [Finset.card_erase_of_mem (Finset.mem_univ σ), hcard_univ]
  have herase_inj :
      Function.Injective (fun σ : G => (Finset.univ : Finset G).erase σ) := by
    intro σ₁ σ₂ h
    dsimp only at h
    by_contra hne
    have hmem : σ₁ ∈ (Finset.univ : Finset G).erase σ₂ :=
      Finset.mem_erase.mpr ⟨hne, Finset.mem_univ σ₁⟩
    rw [← h] at hmem
    exact Finset.notMem_erase σ₁ Finset.univ hmem
  have hs_pm1 : ∀ y : K, y ≠ 0 → s y (p - 1) = normLM F hLK y * traceLM F hLK (y⁻¹) := by
    intro y hy
    let ι := IntermediateField.inclusion hLK
    apply ι.injective
    change ι (s y (p - 1)) = ι (normLM F hLK y * traceLM F hLK (y⁻¹))
    have hr_pm1 : p - 1 ∈ Finset.Icc 1 (p - 1) := by
      rw [Finset.mem_Icc]
      omega
    rw [hs_incl y hr_pm1, hP_pm1_eq,
      Finset.sum_image (fun σ₁ _ σ₂ _ h => herase_inj h)]
    have h1 :
        (∑ σ ∈ (Finset.univ : Finset G), P y ((Finset.univ : Finset G).erase σ)) =
          ∑ σ ∈ (Finset.univ : Finset G), ι (normLM F hLK y) * act σ (y⁻¹) := by
      refine Finset.sum_congr rfl fun σ _ => ?_
      have hinv : act σ (y⁻¹) * act σ y = 1 := by
        rw [← ((hact_ring σ).2.2 (y⁻¹) y).2.1, inv_mul_cancel₀ hy, (hact_ring σ).2.1]
      have hprod : act σ y * P y ((Finset.univ : Finset G).erase σ) = ι (normLM F hLK y) := by
        change act σ y * ∏ s ∈ (Finset.univ : Finset G).erase σ, act s y =
          ι (normLM F hLK y)
        rw [Finset.mul_prod_erase (Finset.univ : Finset G) (fun s => act s y) (Finset.mem_univ σ),
          ← hact_norm y]
      calc
        P y ((Finset.univ : Finset G).erase σ)
          = (act σ (y⁻¹) * act σ y) * P y ((Finset.univ : Finset G).erase σ) := by
              rw [hinv, one_mul]
        _ = act σ (y⁻¹) * (act σ y * P y ((Finset.univ : Finset G).erase σ)) := by ring
        _ = ι (normLM F hLK y) * act σ (y⁻¹) := by
              rw [hprod, mul_comm]
    rw [h1, ← Finset.mul_sum, ← hact_trace (y⁻¹), map_mul]
  
  have hs_val : ∀ (y : K) (r : ℕ), r ∈ Finset.Icc 1 (p - 1) →
      ∀ (q m : ℤ), (y = 0 ∨ q ≤ valL F K y) →
        (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ (r : ℤ) * q →
        (s y r = 0 ∨ m ≤ valL F L (s y r)) := by
    intro y r _hr q m hy hqm
    have hy_act : ∀ σ : G, act σ y = 0 ∨ q ≤ valL F K (act σ y) := by
      intro σ
      rcases hy with rfl | hy_val
      · exact Or.inl (hact_ring σ).1
      · right
        rw [hact_val σ y]
        exact hy_val
    have hP_val : ∀ S : Finset G, P y S = 0 ∨ (S.card : ℤ) * q ≤ valL F K (P y S) := by
      intro S
      induction S using Finset.induction_on with
      | empty =>
        right
        change ((0 : ℕ) : ℤ) * q ≤ valL F K 1
        rw [hvalK1]
        simp
      | @insert σ S' hσ ih =>
        have hP_ins : P y (insert σ S') = act σ y * P y S' := Finset.prod_insert hσ
        have hcard_ins : (insert σ S').card = S'.card + 1 := Finset.card_insert_of_notMem hσ
        rw [hP_ins, hcard_ins]
        by_cases ha : act σ y = 0
        · left; rw [ha, zero_mul]
        · by_cases hb : P y S' = 0
          · left; rw [hb, mul_zero]
          · right
            have hva : q ≤ valL F K (act σ y) := (hy_act σ).resolve_left ha
            have hvb : (S'.card : ℤ) * q ≤ valL F K (P y S') := ih.resolve_left hb
            rw [hvalK_mul (act σ y) (P y S') ha hb]
            push_cast
            linarith
    have hz_term : ∀ S₀ ∈ R_card r, P y S₀ = 0 ∨ (r : ℤ) * q ≤ valL F K (P y S₀) := by
      intro S₀ hS₀
      have hcard_S₀ : S₀.card = r := (hmem_P r S₀).mp (R_sub_P r S₀ hS₀).1
      have hval_S₀ := hP_val S₀
      rwa [hcard_S₀] at hval_S₀
    have hz_val_rq : z y r = 0 ∨ (r : ℤ) * q ≤ valL F K (z y r) := by
      change (∑ S₀ ∈ R_card r, P y S₀) = 0 ∨ (r : ℤ) * q ≤ valL F K (∑ S₀ ∈ R_card r, P y S₀)
      have hsub : ∀ T : Finset (Finset G), T ⊆ R_card r →
          (∑ S₀ ∈ T, P y S₀) = 0 ∨ (r : ℤ) * q ≤ valL F K (∑ S₀ ∈ T, P y S₀) := by
        intro T
        induction T using Finset.induction_on with
        | empty =>
          intro _
          exact Or.inl Finset.sum_empty
        | @insert S₀ T' hS₀ ih =>
          intro hT
          rw [Finset.sum_insert hS₀]
          have h1 : P y S₀ = 0 ∨ (r : ℤ) * q ≤ valL F K (P y S₀) :=
            hz_term S₀ (hT (Finset.mem_insert_self S₀ T'))
          have h2 : (∑ S ∈ T', P y S) = 0 ∨ (r : ℤ) * q ≤ valL F K (∑ S ∈ T', P y S) :=
            ih (Finset.Subset.trans (Finset.subset_insert S₀ T') hT)
          exact hvalK_add ((r : ℤ) * q) (P y S₀) (∑ S ∈ T', P y S) h1 h2
      exact hsub (R_card r) (Finset.Subset.refl (R_card r))
    have hz_val_m :
        z y r = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F K (z y r) := by
      rcases hz_val_rq with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (le_trans hqm hle)
    exact htr_bound m (z y r) hz_val_m
  have hs_poly : ∀ (y : K) (c : L),
      normLM F hLK (1 + IntermediateField.inclusion hLK c * y) =
        1 + (∑ r ∈ Finset.Icc 1 (p - 1), c ^ r * s y r) +
          c ^ p * normLM F hLK y := by
    intro y c
    let ι := IntermediateField.inclusion hLK
    apply ι.injective
    change ι (normLM F hLK (1 + ι c * y)) =
      ι (1 + (∑ r ∈ Finset.Icc 1 (p - 1), c ^ r * s y r) + c ^ p * normLM F hLK y)
    have hnorm_prod :
        ι (normLM F hLK (1 + ι c * y)) =
          ∏ σ ∈ (Finset.univ : Finset G), (ι c * act σ y + 1) := by
      rw [hact_norm (1 + ι c * y)]
      refine Finset.prod_congr rfl fun σ _ => ?_
      rw [((hact_ring σ).2.2 1 (ι c * y)).1, (hact_ring σ).2.1,
        ((hact_ring σ).2.2 (ι c) y).2.1, hact_incl σ c, add_comm]
    let Q : Finset G → K := fun S => (ι c) ^ S.card * P y S
    have hprod_powerset :
        (∏ σ ∈ (Finset.univ : Finset G), (ι c * act σ y + 1)) =
          ∑ S ∈ U_pow, Q S := by
      rw [Finset.prod_add (fun σ => ι c * act σ y) (fun _ => 1) (Finset.univ : Finset G)]
      refine Finset.sum_congr rfl fun S _ => ?_
      dsimp only [Q, P]
      rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.prod_const, one_pow, mul_one]
    let F_term : ℕ → K := fun r => (ι c) ^ r * (∑ S ∈ P_card r, P y S)
    have hmaps_card : ∀ S ∈ U_pow, S.card ∈ Finset.range (p + 1) := by
      intro S _
      rw [Finset.mem_range]
      have hle : S.card ≤ (Finset.univ : Finset G).card := Finset.card_le_univ S
      omega
    have hsum_fiber : (∑ S ∈ U_pow, Q S) = ∑ r ∈ Finset.range (p + 1), F_term r := by
      rw [← Finset.sum_fiberwise_of_maps_to hmaps_card Q]
      refine Finset.sum_congr rfl fun r _ => ?_
      change (∑ S ∈ P_card r, Q S) = F_term r
      have h1 : (∑ S ∈ P_card r, Q S) =
          ∑ S ∈ P_card r, ((ι c) ^ r * P y S) := by
        refine Finset.sum_congr rfl fun S hS => ?_
        have hcard : S.card = r := (hmem_P r S).mp hS
        dsimp only [Q]
        rw [hcard]
      rw [h1, ← Finset.mul_sum]
    have hrange_split :
        (∑ r ∈ Finset.range (p + 1), F_term r) =
          F_term 0 + (∑ r ∈ Finset.Icc 1 (p - 1), F_term r) + F_term p := by
      rw [Finset.sum_range_succ F_term p]
      have h0_mem : 0 ∈ Finset.range p := Finset.mem_range.mpr hPrime.pos
      rw [← Finset.add_sum_erase (Finset.range p) F_term h0_mem]
      have herase_eq : (Finset.range p).erase 0 = Finset.Icc 1 (p - 1) := by
        ext r
        simp only [Finset.mem_erase, Finset.mem_range, Finset.mem_Icc]
        omega
      rw [herase_eq]
    have hP0_eq : P_card 0 = {∅} := by
      ext S
      simp [hmem_P, Finset.card_eq_zero]
    have hF0 : F_term 0 = ι 1 := by
      dsimp only [F_term]
      rw [hP0_eq, Finset.sum_singleton]
      have hP_empty : P y ∅ = 1 := Finset.prod_empty
      rw [hP_empty, pow_zero, mul_one, map_one]
    have hFIcc :
        (∑ r ∈ Finset.Icc 1 (p - 1), F_term r) =
          ι (∑ r ∈ Finset.Icc 1 (p - 1), c ^ r * s y r) := by
      rw [map_sum]
      refine Finset.sum_congr rfl fun r hr => ?_
      dsimp only [F_term]
      rw [← hs_incl y hr]
      simp [ι, map_mul, map_pow]
    have hPp_eq : P_card p = {Finset.univ} := by
      ext S
      simp only [hmem_P, Finset.mem_singleton]
      constructor
      · intro h
        exact Finset.eq_univ_of_card S (h.trans hcard_G.symm)
      · rintro rfl
        exact hcard_univ
    have hFp : F_term p = ι (c ^ p * normLM F hLK y) := by
      dsimp only [F_term]
      rw [hPp_eq, Finset.sum_singleton]
      have hP_univ : P y Finset.univ = ι (normLM F hLK y) := (hact_norm y).symm
      rw [hP_univ, map_mul, map_pow]
    rw [hnorm_prod, hprod_powerset, hsum_fiber, hrange_split, hF0, hFIcc, hFp,
      ← map_add, ← map_add]
  exact ⟨s, hs_one, hs_two, hs_pm1, hs_val, hs_poly⟩

theorem ld_wild_galois_action_shift_and_euler_top_trace (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (ϖ_K : Kˣ) (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hBasis : ∀ y : K, ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLK)) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
        IntermediateField.inclusion hLK (c i) * ((ϖ_K : K) ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F K y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLK)),
            c i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) *
                valL F L (c i) + (i : ℤ))
    (G : Type u) [Group G] [Fintype G] (act : G → K → K)
    (hcard_G : Fintype.card G = Module.finrank L (IntermediateField.extendScalars hLK))
    (hact_one : ∀ y : K, act 1 y = y)
    (hact_mul : ∀ (σ τ : G) (y : K), act (σ * τ) y = act σ (act τ y))
    (hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ y₁ y₂ : K,
        act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
        act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
        act σ (-y₁) = -act σ y₁))
    (hact_incl : ∀ (σ : G) (x : L), act σ (IntermediateField.inclusion hLK x) =
      IntermediateField.inclusion hLK x)
    (hact_val : ∀ (σ : G) (y : K), valL F K (act σ y) = valL F K y)
    (hact_trace : ∀ y : K, IntermediateField.inclusion hLK (traceLM F hLK y) = ∑ σ : G, act σ y)
    (t : ℕ)
    (hjump : ∀ τ : G, τ ≠ 1 →
      (ϖ_K : K) - act τ (ϖ_K : K) ≠ 0 ∧
      valL F K ((ϖ_K : K) - act τ (ϖ_K : K)) = (t + 1 : ℤ)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    let δ_diff : K := ∏ τ ∈ (Finset.univ : Finset G).erase 1, ((ϖ_K : K) - act τ (ϖ_K : K))
    (∀ (τ : G) (y : K) (m : ℤ),
      (y = 0 ∨ m ≤ valL F K y) →
      (act τ y - y = 0 ∨ m + (t : ℤ) ≤ valL F K (act τ y - y))) ∧
    δ_diff ≠ 0 ∧
    valL F K δ_diff = ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ∧
    traceLM F hLK (((ϖ_K : K) ^ (p - 1)) * δ_diff⁻¹) = 1 :=
by
  classical
  intro p δ_diff
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  obtain ⟨hvalK_0, hvalK_1, hvalK_neg1, hvalK_neg, hvalK_mul, hvalK_inv,
    hvalK_surj, hvalK_add, _⟩ := hvalK_props
  set π : K := (ϖ_K : K)
  have hπ_ne0 : π ≠ 0 := Units.ne_zero ϖ_K
  let φ : G → (K →+* K) := fun σ =>
    { toFun := act σ
      map_one' := (hact_ring σ).2.1
      map_mul' := fun x y => ((hact_ring σ).2.2 x y).2.1
      map_zero' := (hact_ring σ).1
      map_add' := fun x y => ((hact_ring σ).2.2 x y).1 }
  have hφ_apply : ∀ (σ : G) (y : K), φ σ y = act σ y := fun _ _ => rfl
  have hval_pi_pow : ∀ k : ℕ, π ^ k ≠ 0 ∧ valL F K (π ^ k) = (k : ℤ) := by
    intro k
    induction k with
    | zero =>
      refine ⟨by simp, ?_⟩
      rw [pow_zero, Nat.cast_zero, hvalK_1]
    | succ k ih =>
      refine ⟨pow_ne_zero (k + 1) hπ_ne0, ?_⟩
      rw [pow_succ, hvalK_mul (π ^ k) π ih.1 hπ_ne0, ih.2, hϖ_K]
      push_cast
      ring
  have hval_mul_ge_K : ∀ (k₁ k₂ : ℤ) (x y : K),
      (x = 0 ∨ k₁ ≤ valL F K x) → (y = 0 ∨ k₂ ≤ valL F K y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F K (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · exact Or.inl (by rw [hx0, zero_mul])
    · by_cases hy0 : y = 0
      · exact Or.inl (by rw [hy0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F K x := hx.resolve_left hx0
        have h2 : k₂ ≤ valL F K y := hy.resolve_left hy0
        rw [hvalK_mul x y hx0 hy0]
        omega
  have hval_finset_sum_K : ∀ {α : Type} (S : Finset α) (f : α → K) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F K (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F K (∑ i ∈ S, f i)) := by
    intro α S f k hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_val := hS a (Finset.mem_insert_self a s)
      have hs_val := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hvalK_add k (f a) (∑ i ∈ s, f i) ha_val hs_val
  have hact_pi_diff : ∀ τ : G,
      act τ π - π = 0 ∨ (t + 1 : ℤ) ≤ valL F K (act τ π - π) := by
    intro τ
    by_cases hτ1 : τ = 1
    · left
      rw [hτ1, hact_one π, sub_self]
    · right
      have hneg : act τ π - π = -(π - act τ π) := by ring
      rw [hneg, hvalK_neg, (hjump τ hτ1).2]
  have hact_pi_pow_diff : ∀ (τ : G) (n : ℕ), 1 ≤ n →
      (act τ π) ^ n - π ^ n = 0 ∨
        (n : ℤ) + (t : ℤ) ≤ valL F K ((act τ π) ^ n - π ^ n) := by
    intro τ n
    induction n with
    | zero =>
      intro h
      omega
    | succ n ih =>
      intro _
      by_cases hn0 : n = 0
      · subst hn0
        simpa [pow_one, add_comm] using hact_pi_diff τ
      · have hn1 : 1 ≤ n := Nat.one_le_iff_ne_zero.mpr hn0
        have h_id : (act τ π) ^ (n + 1) - π ^ (n + 1) =
            ((act τ π) ^ n - π ^ n) * act τ π + π ^ n * (act τ π - π) := by
          rw [pow_succ (act τ π) n, pow_succ π n]
          ring
        have hτπ_val : act τ π = 0 ∨ (1 : ℤ) ≤ valL F K (act τ π) :=
          Or.inr (by rw [hact_val τ π, hϖ_K])
        have hπn_val : π ^ n = 0 ∨ (n : ℤ) ≤ valL F K (π ^ n) :=
          Or.inr (by rw [(hval_pi_pow n).2])
        have ht1 := hval_mul_ge_K ((n : ℤ) + (t : ℤ)) 1
          ((act τ π) ^ n - π ^ n) (act τ π) (ih hn1) hτπ_val
        have ht2 := hval_mul_ge_K (n : ℤ) (t + 1 : ℤ)
          (π ^ n) (act τ π - π) hπn_val (hact_pi_diff τ)
        have ht1' : ((act τ π) ^ n - π ^ n) * act τ π = 0 ∨
            ((n + 1 : ℕ) : ℤ) + (t : ℤ) ≤
              valL F K (((act τ π) ^ n - π ^ n) * act τ π) := by
          rcases ht1 with h0 | hge
          · exact Or.inl h0
          · right; push_cast; omega
        have ht2' : π ^ n * (act τ π - π) = 0 ∨
            ((n + 1 : ℕ) : ℤ) + (t : ℤ) ≤
              valL F K (π ^ n * (act τ π - π)) := by
          rcases ht2 with h0 | hge
          · exact Or.inl h0
          · right; push_cast; omega
        rw [h_id]
        exact hvalK_add (((n + 1 : ℕ) : ℤ) + (t : ℤ)) _ _ ht1' ht2'
  have hact_shift : ∀ (τ : G) (y : K) (m : ℤ),
      (y = 0 ∨ m ≤ valL F K y) →
      (act τ y - y = 0 ∨ m + (t : ℤ) ≤ valL F K (act τ y - y)) := by
    intro τ y m hy
    obtain ⟨c, hy_eq, hval_iff⟩ := hBasis y
    have hc_bound := (hval_iff m).mp hy
    have hact_y_sub : act τ y - y =
        ∑ i : Fin p, IntermediateField.inclusion hLK (c i) *
          ((act τ π) ^ (i : ℕ) - π ^ (i : ℕ)) := by
      change φ τ y - y = _
      rw [hy_eq, map_sum (φ τ), ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul (φ τ), map_pow (φ τ), hφ_apply, hact_incl τ (c i), hφ_apply, ← mul_sub]
    rw [hact_y_sub]
    apply hval_finset_sum_K Finset.univ _ (m + (t : ℤ))
    intro i _
    by_cases hi0 : (i : ℕ) = 0
    · left
      rw [hi0, pow_zero, pow_zero, sub_self, mul_zero]
    · have hi1 : 1 ≤ (i : ℕ) := Nat.one_le_iff_ne_zero.mpr hi0
      rcases hc_bound i with hci0 | hci_ge
      · left
        rw [hci0, map_zero, zero_mul]
      · have hinc_val : IntermediateField.inclusion hLK (c i) = 0 ∨
            (p : ℤ) * valL F L (c i) ≤
              valL F K (IntermediateField.inclusion hLK (c i)) :=
          Or.inr (by rw [hval_alg (c i)])
        have hdiff_val := hact_pi_pow_diff τ (i : ℕ) hi1
        have hmul := hval_mul_ge_K ((p : ℤ) * valL F L (c i)) (((i : ℕ) : ℤ) + (t : ℤ))
          (IntermediateField.inclusion hLK (c i))
          ((act τ π) ^ (i : ℕ) - π ^ (i : ℕ)) hinc_val hdiff_val
        rcases hmul with h0 | hge
        · exact Or.inl h0
        · right
          change m ≤ (p : ℤ) * valL F L (c i) + ((i : ℕ) : ℤ) at hci_ge
          omega
  set U_G : Finset G := Finset.univ
  set S₁ : Finset G := U_G.erase 1
  have hprod_S : ∀ (S : Finset G), S ⊆ S₁ →
      (∏ τ ∈ S, (π - act τ π)) ≠ 0 ∧
      valL F K (∏ τ ∈ S, (π - act τ π)) = (S.card : ℤ) * (t + 1 : ℤ) := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
      intro _
      simp [hvalK_1]
    | @insert a s ha ih =>
      intro hsub
      have ha_S₁ : a ∈ S₁ := hsub (Finset.mem_insert_self a s)
      have ha_ne1 : a ≠ 1 := (Finset.mem_erase.mp ha_S₁).1
      have hs_sub : s ⊆ S₁ := fun x hx => hsub (Finset.mem_insert_of_mem hx)
      obtain ⟨hs_ne0, hs_val⟩ := ih hs_sub
      obtain ⟨ha_ne0, ha_val⟩ := hjump a ha_ne1
      rw [Finset.prod_insert ha, Finset.card_insert_of_notMem ha]
      refine ⟨mul_ne_zero ha_ne0 hs_ne0, ?_⟩
      rw [hvalK_mul _ _ ha_ne0 hs_ne0, ha_val, hs_val]
      push_cast
      ring
  have hS₁_card : S₁.card = p - 1 := by
    rw [Finset.card_erase_of_mem (Finset.mem_univ (1 : G)), Finset.card_univ, hcard_G]
  have hδ_ne0 : δ_diff ≠ 0 := (hprod_S S₁ (Finset.Subset.refl S₁)).1
  have hδ_val : valL F K δ_diff = ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) := by
    have h := (hprod_S S₁ (Finset.Subset.refl S₁)).2
    rwa [hS₁_card] at h
  let v : G → K := fun σ => act σ π
  have hInjOn : Set.InjOn v ↑U_G := by
    intro σ _ τ _ h_eq
    change act σ π = act τ π at h_eq
    by_contra hne
    have h_inv_ne1 : σ⁻¹ * τ ≠ 1 := by
      intro h1
      exact hne (inv_mul_eq_one.mp h1)
    have h_fix : act (σ⁻¹ * τ) π = π := by
      rw [hact_mul σ⁻¹ τ π, ← h_eq, ← hact_mul σ⁻¹ σ π, inv_mul_cancel, hact_one]
    exact (hjump (σ⁻¹ * τ) h_inv_ne1).1 (sub_eq_zero.mpr h_fix.symm)
  have hact_δ : ∀ σ : G, act σ δ_diff = ∏ γ ∈ U_G.erase σ, (v σ - v γ) := by
    intro σ
    have hmap : act σ δ_diff = ∏ ρ ∈ S₁, (v σ - v (σ * ρ)) := by
      change φ σ (∏ ρ ∈ S₁, (π - act ρ π)) = _
      rw [map_prod (φ σ)]
      refine Finset.prod_congr rfl (fun ρ _ => ?_)
      rw [map_sub (φ σ), hφ_apply, hφ_apply, ← hact_mul σ ρ π]
    rw [hmap]
    refine Finset.prod_bij (fun (ρ : G) _ => σ * ρ) ?_ ?_ ?_ ?_
    · intro ρ hρ
      have hρ_ne1 : ρ ≠ 1 := (Finset.mem_erase.mp hρ).1
      rw [Finset.mem_erase]
      refine ⟨?_, Finset.mem_univ _⟩
      intro h_eq
      have h1 : σ⁻¹ * (σ * ρ) = σ⁻¹ * σ := congrArg (σ⁻¹ * ·) h_eq
      rw [inv_mul_cancel_left, inv_mul_cancel] at h1
      exact hρ_ne1 h1
    · intro ρ₁ _ ρ₂ _ h_eq
      exact mul_left_cancel h_eq
    · intro γ hγ
      have hγ_ne : γ ≠ σ := (Finset.mem_erase.mp hγ).1
      refine ⟨σ⁻¹ * γ, ?_, mul_inv_cancel_left σ γ⟩
      rw [Finset.mem_erase]
      refine ⟨?_, Finset.mem_univ _⟩
      intro h1
      exact hγ_ne (inv_mul_eq_one.mp h1).symm
    · intro ρ _
      rfl
  have hact_term : ∀ σ : G,
      act σ (π ^ (p - 1) * δ_diff⁻¹) =
        (v σ) ^ (p - 1) / (∏ γ ∈ U_G.erase σ, (v σ - v γ)) := by
    intro σ
    change φ σ (π ^ (p - 1) * δ_diff⁻¹) = _
    rw [map_mul (φ σ), map_pow (φ σ), map_inv₀ (φ σ), hφ_apply, hφ_apply, hact_δ σ,
      div_eq_mul_inv]
  let Q : G → Polynomial K := fun σ =>
    ∏ γ ∈ U_G.erase σ, (Polynomial.X - Polynomial.C (v γ))
  have hQ_coeff : ∀ σ : G, (Q σ).coeff (p - 1) = 1 := by
    intro σ
    have hmonic_fac : ∀ γ ∈ U_G.erase σ, (Polynomial.X - Polynomial.C (v γ)).Monic :=
      fun γ _ => Polynomial.monic_X_sub_C (v γ)
    have hmonic : (Q σ).Monic :=
      Polynomial.monic_prod_of_monic (U_G.erase σ) _ hmonic_fac
    have hdeg : (Q σ).natDegree = p - 1 := by
      dsimp only [Q]
      rw [Polynomial.natDegree_prod_of_monic (U_G.erase σ) _ hmonic_fac]
      have hsum1 : (∑ γ ∈ U_G.erase σ, (Polynomial.X - Polynomial.C (v γ)).natDegree) =
          ∑ _γ ∈ U_G.erase σ, 1 := by
        refine Finset.sum_congr rfl (fun γ _ => Polynomial.natDegree_X_sub_C (v γ))
      rw [hsum1, Finset.sum_const, smul_eq_mul, mul_one,
        Finset.card_erase_of_mem (Finset.mem_univ σ), Finset.card_univ, hcard_G]
    rw [← hdeg]
    exact Polynomial.Monic.coeff_natDegree hmonic
  have htr_top : traceLM F hLK (π ^ (p - 1) * δ_diff⁻¹) = 1 := by
    have hk : p - 1 < p := Nat.sub_lt hp_pos zero_lt_one
    have hdeg : (Polynomial.X ^ (p - 1) : Polynomial K).degree < (U_G.card : WithBot ℕ) := by
      rw [Polynomial.degree_X_pow (p - 1), Finset.card_univ, hcard_G]
      exact WithBot.coe_lt_coe.mpr hk
    have hLag := @Lagrange.eq_interpolate K _ G _ U_G v (Polynomial.X ^ (p - 1)) hInjOn hdeg
    rw [Lagrange.interpolate_eq_sum] at hLag
    have hcoeff := congrArg (fun P : Polynomial K => P.coeff (p - 1)) hLag
    dsimp only at hcoeff
    rw [Polynomial.coeff_X_pow (p - 1) (p - 1), if_pos rfl, Polynomial.finset_sum_coeff] at hcoeff
    have hrhs : (∑ σ ∈ U_G,
        (Polynomial.C (Polynomial.eval (v σ) (Polynomial.X ^ (p - 1)) /
          ∏ γ ∈ U_G.erase σ, (v σ - v γ)) * Q σ).coeff (p - 1)) =
        IntermediateField.inclusion hLK (traceLM F hLK (π ^ (p - 1) * δ_diff⁻¹)) := by
      rw [hact_trace (π ^ (p - 1) * δ_diff⁻¹)]
      refine Finset.sum_congr rfl (fun σ _ => ?_)
      rw [Polynomial.coeff_C_mul, hQ_coeff σ, mul_one, Polynomial.eval_X_pow, hact_term σ]
    rw [hrhs] at hcoeff
    apply (IntermediateField.inclusion hLK).injective
    change IntermediateField.inclusion hLK (traceLM F hLK (π ^ (p - 1) * δ_diff⁻¹)) =
      IntermediateField.inclusion hLK 1
    rw [map_one (IntermediateField.inclusion hLK), ← hcoeff]
  exact ⟨hact_shift, hδ_ne0, hδ_val, htr_top⟩

theorem ld_wild_odd_euler_half_diff_element (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hp_odd : Module.finrank L (IntermediateField.extendScalars hLK) ≠ 2)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧ valL F K (-1) = 0 ∧
      (∀ x : K, valL F K (-x) = valL F K x) ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)) ∧
      (∀ m : ℤ, ∃ c : Kˣ, valL F K (c : K) = m) ∧
      (∀ (k : ℤ) (x y : K),
        (x = 0 ∨ k ≤ valL F K x) → (y = 0 ∨ k ≤ valL F K y) →
          (x + y = 0 ∨ k ≤ valL F K (x + y))) ∧
      (∀ u : Kˣ, u ∈ unitGroup F K 0 ↔ valL F K (u : K) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Kˣ,
        u ∈ unitGroup F K a ↔ ((u : K) = 1 ∨ (a : ℤ) ≤ valL F K ((u : K) - 1))) ∧
      (∀ (a : ℕ) (u : Kˣ), u ∈ unitGroup F K a → valL F K (u : K) = 0))
    (hval_alg : ∀ x : L,
      valL F K (IntermediateField.inclusion hLK x) =
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F L x)
    (ϖ_K : Kˣ) (ϖ_L : Lˣ)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (t : ℕ) (ht_ge1 : 1 ≤ t)
    (htr_bound : ∀ (m : ℤ) (y : K),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
            (t + 1 : ℤ) ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y)))
    (G : Type u) [Group G] [Fintype G] (act : G → K → K)
    (hcard_G : Fintype.card G = Module.finrank L (IntermediateField.extendScalars hLK))
    (hact_one : ∀ y : K, act 1 y = y)
    (hact_mul : ∀ (σ τ : G) (y : K), act (σ * τ) y = act σ (act τ y))
    (hact_ring : ∀ σ : G,
      act σ 0 = 0 ∧ act σ 1 = 1 ∧
      (∀ y₁ y₂ : K,
        act σ (y₁ + y₂) = act σ y₁ + act σ y₂ ∧
        act σ (y₁ * y₂) = act σ y₁ * act σ y₂ ∧
        act σ (-y₁) = -act σ y₁))
    (hact_incl : ∀ (σ : G) (x : L), act σ (IntermediateField.inclusion hLK x) =
      IntermediateField.inclusion hLK x)
    (hact_trace : ∀ y : K, IntermediateField.inclusion hLK (traceLM F hLK y) = ∑ σ : G, act σ y)
    (hjump : ∀ τ : G, τ ≠ 1 →
      (ϖ_K : K) - act τ (ϖ_K : K) ≠ 0 ∧
      valL F K ((ϖ_K : K) - act τ (ϖ_K : K)) = (t + 1 : ℤ))
    (hact_shift : ∀ (τ : G) (y : K) (m : ℤ),
      (y = 0 ∨ m ≤ valL F K y) →
      (act τ y - y = 0 ∨ m + (t : ℤ) ≤ valL F K (act τ y - y)))
    (heuler_top :
      let δ_diff : K := ∏ τ ∈ (Finset.univ : Finset G).erase 1, ((ϖ_K : K) - act τ (ϖ_K : K))
      δ_diff ≠ 0 ∧
      valL F K δ_diff =
        ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) *
          (t + 1 : ℤ) ∧
      traceLM F hLK
        (((ϖ_K : K) ^ (Module.finrank L (IntermediateField.extendScalars hLK) - 1)) *
          δ_diff⁻¹) = 1) :
    let p := Module.finrank L (IntermediateField.extendScalars hLK)
    ∀ (d_a d_K : ℕ),
