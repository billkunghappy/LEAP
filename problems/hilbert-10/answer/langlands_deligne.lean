      obtain ⟨_, _, _, hval_neg_Fi, hval_mul_Fi, _, _, _, _, hunit_ge1_Fi, _⟩ := hval_all F_i
      rw [hunit_ge1_Fi 1 le_rfl]
      let d : F_i := (((c'_θ i)⁻¹ : F_iˣ) : F_i) - ((c_ref⁻¹ : F_iˣ) : F_i)
      change d = 0 ∨ -((m₀ : ℤ) + n_Fi) ≤ valL F F_i d at hdiff
      have hsub_eq : (((c'_θ i * c_ref⁻¹ : F_iˣ) : F_i) - 1) = -(c'_θ i : F_i) * d := by
        have hmul : (c'_θ i : F_i) * (((c'_θ i)⁻¹ : F_iˣ) : F_i) = 1 := Units.mul_inv (c'_θ i)
        change (c'_θ i : F_i) * ((c_ref⁻¹ : F_iˣ) : F_i) - 1 =
          -(c'_θ i : F_i) * ((((c'_θ i)⁻¹ : F_iˣ) : F_i) - ((c_ref⁻¹ : F_iˣ) : F_i))
        linear_combination hmul
      rcases hdiff with hd0 | hd_ge
      · left
        apply sub_eq_zero.mp
        rw [hsub_eq, hd0, mul_zero]
      · by_cases hd0 : d = 0
        · left
