      · exact Or.inr (by omega)
    let u_r : Mˣ := Units.mk0 (1 + ζ_r) (hone_add_ne 1 le_rfl ζ_r hζ_r_1)
    have hu_r_mem : u_r ∈ unitGroup F M 1 := hunit_one_add 1 le_rfl ζ_r hζ_r_1
    have hu_r_val0 : valL F M (u_r : M) = 0 := hunit_val0 1 u_r hu_r_mem
    have hu_r_inv_val0 : valL F M ((u_r⁻¹ : Mˣ) : M) = 0 := by
      rw [hval_inv u_r, hu_r_val0, neg_zero]
    let c' : Mˣ := c * u_r⁻¹
    have hc'_val : valL F M (c' : M) = (m_M : ℤ) + n_M := by
      change valL F M ((c : M) * ((u_r⁻¹ : Mˣ) : M)) = _
      rw [hval_mul _ _ (Units.ne_zero c) (Units.ne_zero u_r⁻¹), hc_val, hu_r_inv_val0, add_zero]
    have hc'_inv : ((c'⁻¹ : Mˣ) : M) = ((c⁻¹ : Mˣ) : M) * (1 + ζ_r) := by
      have h : c'⁻¹ = c⁻¹ * u_r := by
        dsimp [c']
        rw [mul_inv_rev, inv_inv, mul_comm]
      rw [h, Units.val_mul]
      rfl
    refine ⟨c', hc'_val, ?_⟩
    intro x hx_val hx
    let u : M := (((ϖ_M ^ r)⁻¹ : Mˣ) : M) * x
    have hπr_mul_inv : ((ϖ_M ^ r : Mˣ) : M) * (((ϖ_M ^ r)⁻¹ : Mˣ) : M) = 1 := by
      exact_mod_cast Units.mul_inv (ϖ_M ^ r)
    have hx_eq_πu : ((ϖ_M ^ r : Mˣ) : M) * u = x := by
      change ((ϖ_M ^ r : Mˣ) : M) * ((((ϖ_M ^ r)⁻¹ : Mˣ) : M) * x) = x
      rw [← mul_assoc, hπr_mul_inv, one_mul]
    have hu_int : u = 0 ∨ 0 ≤ valL F M u := by
      change (((ϖ_M ^ r)⁻¹ : Mˣ) : M) * x = 0 ∨ 0 ≤ valL F M ((((ϖ_M ^ r)⁻¹ : Mˣ) : M) * x)
      have hπr_inv : (((ϖ_M ^ r)⁻¹ : Mˣ) : M) = 0 ∨ -(r : ℤ) ≤ valL F M (((ϖ_M ^ r)⁻¹ : Mˣ) : M) :=
        Or.inr (by rw [hval_inv (ϖ_M ^ r), hϖ_pow r])
      rcases hval_mul_bound (-(r : ℤ)) (r : ℤ) (((ϖ_M ^ r)⁻¹ : Mˣ) : M) x hπr_inv hx_val with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    let a : k_M := resM u
    have hφ_r_a : φ_r a =
        (θ (Units.mk0 (1 - x) hx) : Ω F) ^ 2 * ψ_M (2 * ((c⁻¹ : Mˣ) : M) * P_M x) := by
      dsimp only [a]
      rw [hφ_r_res u hu_int, hx_eq_πu]
      dsimp only [Φ]
      rw [dif_pos hx_val]
    have hz₀u_int : z₀ * u = 0 ∨ 0 ≤ valL F M (z₀ * u) := by
      rcases hval_mul_bound 0 0 z₀ u hz₀_int hu_int with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hres_z₀u : resM (z₀ * u) = b₀ * a := by
      dsimp only [a]
      rw [(hresM_ring z₀ u hz₀_int hu_int).2.1, hz₀_res]
    have hπ_split : ((ϖ_M ^ (m_M - 1) : Mˣ) : M) =
        ((ϖ_M ^ (m_M - 1 - r) : Mˣ) : M) * ((ϖ_M ^ r : Mˣ) : M) := by
      rw [← Units.val_mul, ← pow_add]
      have hexp : m_M - 1 - r + r = m_M - 1 := by omega
      rw [hexp]
    have hπ_z₀u : ((ϖ_M ^ (m_M - 1) : Mˣ) : M) * (z₀ * u) = ζ_r * x := by
      dsimp only [ζ_r]
      rw [hπ_split]
      calc (((ϖ_M ^ (m_M - 1 - r) : Mˣ) : M) * ((ϖ_M ^ r : Mˣ) : M)) * (z₀ * u)
          = (((ϖ_M ^ (m_M - 1 - r) : Mˣ) : M) * z₀) * (((ϖ_M ^ r : Mˣ) : M) * u) := by ring
        _ = (((ϖ_M ^ (m_M - 1 - r) : Mˣ) : M) * z₀) * x := by rw [hx_eq_πu]
    have hψ_0M_ba : ψ_0M (b₀ * a) = ψ_M (2 * ((c⁻¹ : Mˣ) : M) * (ζ_r * x)) := by
      rw [← hres_z₀u, hψ_0M_res (z₀ * u) hz₀u_int, hπ_z₀u]
    have hPM_lin_x := hPM_lin r hr_ge1 x hx_val
    have hζ_PM_diff : ζ_r * P_M x - ζ_r * x = 0 ∨ (m_M : ℤ) ≤ valL F M (ζ_r * P_M x - ζ_r * x) := by
      have hsub_mul : ζ_r * P_M x - ζ_r * x = ζ_r * (P_M x - x) := by ring
      rw [hsub_mul]
      rcases hval_mul_bound ((m_M - 1 - r : ℕ) : ℤ) (2 * (r : ℤ)) ζ_r (P_M x - x)
        hζ_r_val hPM_lin_x with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hψ_ζ_PM : ψ_M (2 * ((c⁻¹ : Mˣ) : M) * (ζ_r * P_M x)) = ψ_0M (b₀ * a) := by
      rw [hψ_2c_congr c hc_val (ζ_r * P_M x) (ζ_r * x) hζ_PM_diff, hψ_0M_ba]
    have h2c'_PM : 2 * ((c'⁻¹ : Mˣ) : M) * P_M x =
        2 * ((c⁻¹ : Mˣ) : M) * P_M x + 2 * ((c⁻¹ : Mˣ) : M) * (ζ_r * P_M x) := by
      rw [hc'_inv]
      ring
    have hprod_one :
        (θ (Units.mk0 (1 - x) hx) : Ω F) ^ 2 * ψ_M (2 * ((c'⁻¹ : Mˣ) : M) * P_M x) = 1 := by
      rw [h2c'_PM, ψ_M.map_add_eq_mul, hψ_ζ_PM, ← mul_assoc, ← hφ_r_a]
      exact hb₀ a
    calc (θ (Units.mk0 (1 - x) hx) : Ω F) ^ 2
        = (θ (Units.mk0 (1 - x) hx) : Ω F) ^ 2 * 1 := (mul_one _).symm
      _ = (θ (Units.mk0 (1 - x) hx) : Ω F) ^ 2 *
            (ψ_M (2 * ((c'⁻¹ : Mˣ) : M) * P_M x) * ψ_M (- 2 * ((c'⁻¹ : Mˣ) : M) * P_M x)) := by
          rw [← ψ_M.map_add_eq_mul]
          have hring0 : 2 * ((c'⁻¹ : Mˣ) : M) * P_M x + - 2 * ((c'⁻¹ : Mˣ) : M) * P_M x = 0 := by ring
          rw [hring0, ψ_M.map_zero_eq_one]
      _ = ((θ (Units.mk0 (1 - x) hx) : Ω F) ^ 2 * ψ_M (2 * ((c'⁻¹ : Mˣ) : M) * P_M x)) *
            ψ_M (- 2 * ((c'⁻¹ : Mˣ) : M) * P_M x) := by ring
      _ = 1 * ψ_M (- 2 * ((c'⁻¹ : Mˣ) : M) * P_M x) := by rw [hprod_one]
      _ = ψ_M (- 2 * ((c'⁻¹ : Mˣ) : M) * P_M x) := one_mul _
  have hInd : ∀ (k : ℕ), q_M ≤ d_M - k →
      ∃ c_k : Mˣ,
        valL F M (c_k : M) = (m_M : ℤ) + n_M ∧
        ∀ x : M, (x = 0 ∨ ((d_M - k : ℕ) : ℤ) ≤ valL F M x) →
          ∀ hx : 1 - x ≠ 0,
            (θ (Units.mk0 (1 - x) hx) : Ω F) ^ 2 =
              ψ_M (- 2 * ((c_k⁻¹ : Mˣ) : M) * P_M x) := by
    intro k
    induction k with
    | zero =>
      intro _
      rw [Nat.sub_zero]
      exact ⟨c₀, hc₀_val, hBase⟩
    | succ k ih =>
      intro hk
      let r : ℕ := d_M - (k + 1)
      have hk0 : q_M ≤ d_M - k := by omega
      have hr_ge : q_M ≤ r := hk
      have hr_lt : r < d_M := by omega
      have hr_succ : d_M - k = r + 1 := by omega
      obtain ⟨c_k, hc_k_val, hc_k_ih⟩ := ih hk0
      rw [hr_succ] at hc_k_ih
      exact hStep r hr_ge hr_lt c_k hc_k_val hc_k_ih
  have hdq : d_M - (d_M - q_M) = q_M := by omega
  have hq_le : q_M ≤ d_M - (d_M - q_M) := by omega
  obtain ⟨c_θ, hc_θ_val, hc_θ_log⟩ := hInd (d_M - q_M) hq_le
  rw [hdq] at hc_θ_log
  exact ⟨c_θ, hc_θ_val, hc_θ_log⟩

theorem ld_ch12_wild_odd_totally_ramified_single_field_trunc_log_and_stat_descent (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (p : ℕ) (hPrime : Nat.Prime p) (hWild : p = EllipticRootNumber.p F) (hp_odd : EllipticRootNumber.p F ≠ 2)
    (hLamp4 : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ (θ : Mˣ →* (Ω F)ˣ), 2 ≤ condExp F M θ →
      (∀ u ∈ unitGroup F M (condExp F M θ), θ u = 1) →
      let m := condExp F M θ
      let d := m / 2
      (∃ c_θ : Mˣ,
        valL F M (c_θ : M) = (m : ℤ) + condExpChar F M ψ_M ∧
        ∀ x : M, (x = 0 ∨ (d : ℤ) ≤ valL F M x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
              ψ_M (((c_θ⁻¹ : Mˣ) : M) * (2 * x - x ^ 2))) ∧
      (∀ (c : Mˣ) (η : M),
        valL F M (c : M) = (m : ℤ) + condExpChar F M ψ_M →
        (η = 0 ∨ (d : ℤ) ≤ valL F M η) →
        (∀ x : M, (x = 0 ∨ (d : ℤ) ≤ valL F M x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
              ψ_M (((c⁻¹ : Mˣ) : M) * (1 + η) * (2 * x - x ^ 2))) →
        (tateEps F M θ ψ_M) ^ 4 =
          ((qL F M : Ω F) ^ (4 * condExpChar F M ψ_M + 2 * (m : ℤ))) *
            (θ c : Ω F) ^ 4 *
            (ψ_M (((c⁻¹ : Mˣ) : M) * (2 - η ^ 2))) ^ 2)) :
    ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ (θ : Mˣ →* (Ω F)ˣ), 2 ≤ condExp F M θ →
      (∀ u ∈ unitGroup F M (condExp F M θ), θ u = 1) →
      let m_M := condExp F M θ
      let q_M := (m_M + p - 1) / p
      let P_M := fun z : M => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M)⁻¹ * z ^ j
      (∀ x y : M,
        (x = 0 ∨ (q_M : ℤ) ≤ valL F M x) →
        (y = 0 ∨ (q_M : ℤ) ≤ valL F M y) →
        (x + y - x * y = 0 ∨ (q_M : ℤ) ≤ valL F M (x + y - x * y)) ∧
        (P_M x = 0 ∨ (q_M : ℤ) ≤ valL F M (P_M x)) ∧
        (P_M (x + y - x * y) - P_M x - P_M y = 0 ∨
          (m_M : ℤ) ≤ valL F M (P_M (x + y - x * y) - P_M x - P_M y))) ∧
      (∃ c_θ : Mˣ,
        valL F M (c_θ : M) = (m_M : ℤ) + condExpChar F M ψ_M ∧
        ∀ x : M, (x = 0 ∨ (q_M : ℤ) ≤ valL F M x) →
          ∀ hx : 1 - x ≠ 0,
            (θ (Units.mk0 (1 - x) hx) : Ω F) ^ 2 =
              ψ_M (- 2 * ((c_θ⁻¹ : Mˣ) : M) * P_M x)) :=
by
  intro M _ ψ_M hψ_M θ hm_ge2 hθ_triv m_M q_M P_M
  have hp_ne2 : p ≠ 2 := hWild ▸ hp_odd
  have hvalM_full := ld_valL_and_unitGroup_props F M
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add,
      hunit0, hunit_ge1, hunit_val0⟩ := ld_valL_and_unitGroup_props F M
  have hvalM_8 : valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) :=
    ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add⟩
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F M
  have haddVal_6 : addVal F 1 = 0 ∧
      (∀ a : F, addVal F (-a) = addVal F a) ∧
      (∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b) ∧
      (∀ a : F, a ≠ 0 → addVal F a⁻¹ = - addVal F a) ∧
      (∀ a : F, (a = 0 ∨ 0 ≤ addVal F a) →
        (algebraMap F M a = 0 ∨ 0 ≤ valL F M (algebraMap F M a))) ∧
      (∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
        (algebraMap F M a = 0 ∨ 1 ≤ valL F M (algebraMap F M a))) :=
    ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1⟩
  obtain ⟨S₁, hS₁⟩ := ld_valL_mod_one_finset F M hval0 hval_neg hval_mul hval_add
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨k_M, hField_kM, hFin_kM, resM, hresM_0, hresM_1, hresM_ring, hresM_ker, hresM_surj⟩ :=
    ld_valL_residue_field_exists F M hval0 hval1 hval_neg1 hval_neg hval_mul hval_inv hval_add S₁ hS₁
  letI : Field k_M := hField_kM
  letI : Fintype k_M := hFin_kM
  obtain ⟨_, hp_char_F, _⟩ := ld_valL_residue_field_card_eq_qL F M hvalM_8 haddVal_6
    k_M resM hresM_0 hresM_1 hresM_ring hresM_ker hresM_surj
  have hp_char : ((p : ℕ) : k_M) = 0 := by
    rw [hWild]
    exact hp_char_F
  obtain ⟨hSpecM_triv, hSpecM_nontriv, _, _⟩ :=
    ld_condExp_and_condExpChar_spec F M ψ_M hψ_M θ
  obtain ⟨h2_ne0, hval_2, _, hPM_0, hPM_lin, hPM_bounds⟩ :=
    ld_ch12_single_field_coprime_inv_val_and_trunc_log_bounds F M p hPrime hp_ne2
      hvalM_8 k_M resM hresM_0 hresM_1 hresM_ring hresM_ker hp_char
      (fun hj x y => ld_trunc_log_binomial_tail_ring_identity M p hPrime hp_ne2 hj x y)
  obtain ⟨hPM_qM, hPM_dM⟩ := hPM_bounds m_M hm_ge2
  obtain ⟨⟨c₀, hc₀_val, hc₀_quad⟩, _⟩ := hLamp4 M ψ_M hψ_M θ hm_ge2 hθ_triv
  obtain ⟨c_θ, hc_θ_val, hc_θ_log⟩ :=
    ld_ch12_single_field_trunc_log_stat_descent F M p hPrime hp_ne2 ψ_M θ hm_ge2
      hSpecM_triv hSpecM_nontriv hvalM_full k_M resM hresM_0 hresM_1 hresM_ring hresM_ker hresM_surj
      h2_ne0 hval_2 P_M hPM_0 hPM_lin hPM_qM hPM_dM c₀ hc₀_val hc₀_quad
  exact ⟨hPM_qM, ⟨c_θ, hc_θ_val, hc_θ_log⟩⟩

theorem ld_ch12_wild_odd_totally_ramified_cyclic_ext_trunc_log_norm_congr (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L A : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F A]
    (hLA : L ≤ A) (hGalLA : IsGaloisExt F L A)
    (p : ℕ) (hPrime : Nat.Prime p) (hWild : p = EllipticRootNumber.p F) (hp_odd : EllipticRootNumber.p F ≠ 2)
    (hdegLA : Module.finrank L (IntermediateField.extendScalars hLA) = p)
    (T : ℕ) (hT_ge2 : 2 ≤ T)
    (hval_LA : ∀ x : L, valL F A (IntermediateField.inclusion hLA x) = (p : ℤ) * valL F L x)
    (hval_norm_LA : ∀ y : A, valL F L (normLM F hLA y) = valL F A y)
    (htr_LA : ∀ (m : ℤ) (y : A),
      (y = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ valL F A y) →
      (traceLM F hLA y = 0 ∨ m ≤ valL F L (traceLM F hLA y))) :
    let q₀ := (T + p - 1) / p
    let P_L := fun u : L => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u ^ j
    let P_A := fun z : A => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : A)⁻¹ * z ^ j
    (∀ (h : ℕ) (x y : A),
      (x = 0 ∨ ((q₀ + h : ℕ) : ℤ) ≤ valL F A x) →
      (y = 0 ∨ ((q₀ + h : ℕ) : ℤ) ≤ valL F A y) →
      normLM F hLA (x + y) - normLM F hLA x - normLM F hLA y = 0 ∨
        ((T + h : ℕ) : ℤ) ≤ valL F L (normLM F hLA (x + y) - normLM F hLA x - normLM F hLA y)) ∧
    (∀ (h : ℕ) (z : A), (z = 0 ∨ ((q₀ + h : ℕ) : ℤ) ≤ valL F A z) →
      let u_z := 1 - normLM F hLA (1 - z)
      (u_z = 0 ∨ (q₀ : ℤ) ≤ valL F L u_z) ∧
      (P_L u_z - (traceLM F hLA (P_A z) + normLM F hLA (P_A z)) = 0 ∨
        ((T + h : ℕ) : ℤ) ≤
          valL F L (P_L u_z - (traceLM F hLA (P_A z) + normLM F hLA (P_A z))))) :=
by
  intro q₀ P_L P_A
  have hp_odd' : p ≠ 2 := by rw [hWild]; exact hp_odd
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have hp_pos : 0 < p := hPrime.pos
  have hp_pos_z : (0 : ℤ) < (p : ℤ) := by omega
  letI : Module L L := Semiring.toModule
  haveI : FiniteDimensional L (IntermediateField.extendScalars hLA) := by
    haveI : FiniteDimensional F (IntermediateField.extendScalars hLA) := ‹FiniteDimensional F A›
    haveI : IsScalarTower F L (IntermediateField.extendScalars hLA) :=
      IsScalarTower.of_algebraMap_eq fun _ => rfl
    exact Module.Finite.of_restrictScalars_finite F L (IntermediateField.extendScalars hLA)
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalA_props := ld_valL_and_unitGroup_props F A
  obtain ⟨hvalL_0, hvalL_1, _, hvalL_neg, hvalL_mul, hvalL_inv, _, hvalL_add, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨hvalA_0, hvalA_1, _, hvalA_neg, hvalA_mul, hvalA_inv, _, hvalA_add, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F A
  
  have hPrime_LA : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLA)) := by
    rw [hdegLA]; exact hPrime
  have hp_odd_LA : Module.finrank L (IntermediateField.extendScalars hLA) ≠ 2 := by
    rw [hdegLA]; exact hp_odd'
  have hval_LA' : ∀ x : L,
      valL F A (IntermediateField.inclusion hLA x) =
        (Module.finrank L (IntermediateField.extendScalars hLA) : ℤ) * valL F L x := by
    intro x; rw [hdegLA]; exact hval_LA x
  have htr_LA' : ∀ (m : ℤ) (y : A),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLA) : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLA) - 1 : ℕ) : ℤ) *
            (T : ℤ) ≤ valL F A y) →
      (traceLM F hLA y = 0 ∨ m ≤ valL F L (traceLM F hLA y)) := by
    intro m y hy; rw [hdegLA] at hy; exact htr_LA m y hy
  obtain ⟨s, _, _, hs_val', hs_norm_one_add', _, hs_newton1'⟩ :=
    ld_ch12_wild_odd_tot_ram_galois_symm_and_one_step_newton F L A hLA hGalLA
      hPrime_LA hp_odd_LA hvalL_props hvalA_props hval_LA' hval_norm_LA
      T (by omega) htr_LA'
      (fun t htr G _ _ act => ld_wild_odd_free_orbit_symm_functions F L A hLA
        hPrime_LA hp_odd_LA hvalA_props t htr G act)
      (fun G _ _ act s hcard_G hact_one hact_ring hact_incl hact_norm hs_poly =>
        ld_wild_odd_symm_subset_sum_and_cayley_hamilton F L A hLA
