      exact hval_add_K₁ (2 * (r : ℤ) + 2 * ((k + 1 : ℕ) : ℤ) - 1) _ _
        (hP_mono (valL F K₁) (by push_cast; omega) hterm1)
        (hP_mono (valL F K₁) (by push_cast; omega) hterm2)
  have hAr_Br_P : A ^ r - B ^ r = 0 ∨ 4 * (r : ℤ) - 1 ≤ valL F K₁ (A ^ r - B ^ r) := by
    have h := hpow_diff_P r
    exact hP_mono (valL F K₁) (by omega) h
  set u₁ : M₁' := (-1 : M₁') ^ (r - 1) * (Pi₁ ^ r)⁻¹ * T₁'
  set Δ_u : K₁ := IntermediateField.inclusion hM₁'K₁ u₁ - IntermediateField.inclusion hE'K₁ u₂
  have hAr := hval_pow (valL F K₁) hval1_K₁ hval_mul_K₁ hA_ne r
  have hBr := hval_pow (valL F K₁) hval1_K₁ hval_mul_K₁ hB_ne r
  have hn1_K₁ := hval_neg1_pow (valL F K₁) hval1_K₁ hval_neg1_K₁ hval_mul_K₁ (r - 1)
  have hu₁_K₁ :
      IntermediateField.inclusion hM₁'K₁ u₁ =
        (-1 : K₁) ^ (r - 1) * (A ^ r)⁻¹ * IntermediateField.inclusion hM₁'K₁ T₁' := by
    dsimp [u₁, A]
    simp only [map_mul, map_inv₀, map_pow, map_neg, map_one]
  have hu₂_K₁ :
      IntermediateField.inclusion hE'K₁ u₂ =
        (-1 : K₁) ^ (r - 1) * (B ^ r)⁻¹ * IntermediateField.inclusion hE'K₁ T₂' := by
    dsimp [u₂, B]
    simp only [map_mul, map_inv₀, map_pow, map_neg, map_one]
  have hn1_sq : (-1 : K₁) ^ (r - 1) * (-1 : K₁) ^ (r - 1) = 1 := by
    rw [← mul_pow]
    norm_num
  have hclear_denom :
      ((-1 : K₁) ^ (r - 1) * A ^ r * B ^ r) * Δ_u =
        B ^ r * D_T + (-IntermediateField.inclusion hE'K₁ T₂' * (A ^ r - B ^ r)) := by
    dsimp [Δ_u, D_T]
    rw [hu₁_K₁, hu₂_K₁]
    have h1 : ((-1 : K₁) ^ (r - 1) * A ^ r * B ^ r) *
        ((-1 : K₁) ^ (r - 1) * (A ^ r)⁻¹ * IntermediateField.inclusion hM₁'K₁ T₁') =
        ((-1 : K₁) ^ (r - 1) * (-1 : K₁) ^ (r - 1)) * ((A ^ r)⁻¹ * A ^ r) *
          B ^ r * IntermediateField.inclusion hM₁'K₁ T₁' := by ring
    have h2 : ((-1 : K₁) ^ (r - 1) * A ^ r * B ^ r) *
        ((-1 : K₁) ^ (r - 1) * (B ^ r)⁻¹ * IntermediateField.inclusion hE'K₁ T₂') =
        ((-1 : K₁) ^ (r - 1) * (-1 : K₁) ^ (r - 1)) * ((B ^ r)⁻¹ * B ^ r) *
          A ^ r * IntermediateField.inclusion hE'K₁ T₂' := by ring
    rw [mul_sub, h1, h2, hn1_sq, inv_mul_cancel₀ hAr.1, inv_mul_cancel₀ hBr.1]
    ring
  have hBr_DT_ne : B ^ r * D_T ≠ 0 := mul_ne_zero hBr.1 hDT_ne
  have hBr_DT_val : valL F K₁ (B ^ r * D_T) = 4 * (r : ℤ) := by
    rw [hval_mul_K₁ (B ^ r) D_T hBr.1 hDT_ne, hBr.2, hB_val, hDT_val]
    ring
  have hrem_P :
      -IntermediateField.inclusion hE'K₁ T₂' * (A ^ r - B ^ r) = 0 ∨
      6 * (r : ℤ) - 1 ≤ valL F K₁ (-IntermediateField.inclusion hE'K₁ T₂' * (A ^ r - B ^ r)) := by
    have hneg_T₂' :
        -IntermediateField.inclusion hE'K₁ T₂' = 0 ∨
        2 * (r : ℤ) ≤ valL F K₁ (-IntermediateField.inclusion hE'K₁ T₂') :=
      hP_neg (valL F K₁) hval_neg_K₁ (Or.inr (le_of_eq htr_π_ultra.2.symm))
    have h := hP_mul (valL F K₁) hval_mul_K₁ hneg_T₂' hAr_Br_P
    exact hP_mono (valL F K₁) (by omega) h
  have hclear_ultra :
      ((-1 : K₁) ^ (r - 1) * A ^ r * B ^ r) * Δ_u ≠ 0 ∧
      valL F K₁ (((-1 : K₁) ^ (r - 1) * A ^ r * B ^ r) * Δ_u) = 4 * (r : ℤ) := by
    rw [hclear_denom]
    exact hUltra (valL F K₁) hval_neg_K₁ hval_add_K₁ hBr_DT_ne hBr_DT_val hrem_P (by omega)
  have hlam₁₂_ne : lam₁ ≠ lam₂ := by
    intro h_eq
    have hL_diamond : ∀ s : L,
        IntermediateField.inclusion hM₁'K₁ (IntermediateField.inclusion hLM₁' s) =
        IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' s) :=
      fun _ => Subtype.ext rfl
    set L_lam : K₁ := IntermediateField.inclusion hM₁'K₁ (IntermediateField.inclusion hLM₁' (liftL lam₁))
    have hL_lam_eq :
        IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' (liftL lam₂)) = L_lam := by
      dsimp [L_lam]
      rw [h_eq, hL_diamond]
    have hres₁_K₁ :
        L_lam - IntermediateField.inclusion hM₁'K₁ u₁ = 0 ∨
        2 ≤ valL F K₁ (L_lam - IntermediateField.inclusion hM₁'K₁ u₁) := by
      have h := hP_incl hM₁'K₁ hval_M₁'K₁ (k := 1) hlam₁_res
      rw [map_sub] at h
      exact hP_mono (valL F K₁) (by omega) h
    have hres₂_K₁ :
        L_lam - IntermediateField.inclusion hE'K₁ u₂ = 0 ∨
        2 ≤ valL F K₁ (L_lam - IntermediateField.inclusion hE'K₁ u₂) := by
      have h := hP_incl hE'K₁ hval_E'K₁ (k := 1) hlam₂_res
      rw [map_sub, hL_lam_eq] at h
      exact hP_mono (valL F K₁) (by omega) h
    have hΔ_decomp :
        Δ_u = (L_lam - IntermediateField.inclusion hE'K₁ u₂) +
          (-(L_lam - IntermediateField.inclusion hM₁'K₁ u₁)) := by
      dsimp [Δ_u]; ring
    have hΔ_P : Δ_u = 0 ∨ 2 ≤ valL F K₁ Δ_u := by
      rw [hΔ_decomp]
      exact hval_add_K₁ 2 _ _ hres₂_K₁ (hP_neg (valL F K₁) hval_neg_K₁ hres₁_K₁)
    have hfac_ne : (-1 : K₁) ^ (r - 1) * A ^ r * B ^ r ≠ 0 :=
      mul_ne_zero (mul_ne_zero hn1_K₁.1 hAr.1) hBr.1
    have hfac_val : valL F K₁ ((-1 : K₁) ^ (r - 1) * A ^ r * B ^ r) = 4 * (r : ℤ) := by
      rw [hval_mul_K₁ _ (B ^ r) (mul_ne_zero hn1_K₁.1 hAr.1) hBr.1,
        hval_mul_K₁ _ (A ^ r) hn1_K₁.1 hAr.1,
        hn1_K₁.2, hAr.2, hBr.2, hA_val, hB_val]
      ring
    have hclear_P :=
      hP_mul (valL F K₁) hval_mul_K₁ (Or.inr (le_of_eq hfac_val.symm)) hΔ_P
    rcases hclear_P with h0 | hge
    · exact hclear_ultra.1 h0
    · have hval_eq := hclear_ultra.2
      omega
  exact ⟨hlam₂_ne, hlam₁₂_ne⟩

