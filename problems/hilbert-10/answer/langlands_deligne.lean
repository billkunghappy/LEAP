  have hs₂_val : ∀ (w : K₁) (r : ℕ),
      r ∈ Finset.Icc 1 (p - 1) →
      ∀ (q m : ℤ), (w = 0 ∨ q ≤ valL F K₁ w) →
        (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (bM₁' : ℤ) ≤ (r : ℤ) * q →
        (s₂ w r = 0 ∨ m ≤ valL F E' (s₂ w r)) := by
    intro w r hr q m hw hle
    have hr' : r ∈ Finset.Icc 1 (Module.finrank E' (IntermediateField.extendScalars hE'K₁) - 1) := by
      rw [hdegE'K₁]; exact hr
    have hle' : (Module.finrank E' (IntermediateField.extendScalars hE'K₁) : ℤ) * m -
