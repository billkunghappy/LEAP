    have hSlow_val : S_low = 0 ∨ (ν₀ : ℤ) + (t₁ : ℤ) - (ct : ℤ) ≤ valL F M₁' S_low :=
      hvalM₁'_sum (Finset.Icc 1 (p - 2)) (fun i => s₁ z i) ((ν₀ : ℤ) + (t₁ : ℤ) - (ct : ℤ)) hs₁_low_val
    have hSlow_ν₀ : S_low = 0 ∨ (ν₀ : ℤ) ≤ valL F M₁' S_low := by
      rcases hSlow_val with h0 | hge
      · exact Or.inl h0
      · right
        have : (ct : ℤ) ≤ (t₁ : ℤ) := by exact_mod_cast hct_le_t₁
        linarith
    have hstop_ν₀ : s_top = 0 ∨ (ν₀ : ℤ) ≤ valL F M₁' s_top := hs₁_ν₀ (p - 1) hp1_mem
    have h2stop_ν₀ : 2 * s_top = 0 ∨ (ν₀ : ℤ) ≤ valL F M₁' (2 * s_top) := by
      have h2_v : (2 : M₁') = 0 ∨ (0 : ℤ) ≤ valL F M₁' (2 : M₁') := by simpa using hnat_M₁' 2
      have h := hmul_M₁' 0 (ν₀ : ℤ) (2 : M₁') s_top h2_v hstop_ν₀
      rwa [zero_add] at h
    have hSlow_2stop : S_low + 2 * s_top = 0 ∨ (ν₀ : ℤ) ≤ valL F M₁' (S_low + 2 * s_top) :=
      hvalM₁'_add (ν₀ : ℤ) S_low (2 * s_top) hSlow_ν₀ h2stop_ν₀
    have hterm1 : S_low * (S_low + 2 * s_top) = 0 ∨
        (m₁ : ℤ) ≤ valL F M₁' (S_low * (S_low + 2 * s_top)) := by
      rcases hmul_M₁' ((ν₀ : ℤ) + (t₁ : ℤ) - (ct : ℤ)) (ν₀ : ℤ)
        S_low (S_low + 2 * s_top) hSlow_val hSlow_2stop with h0 | hge
      · exact Or.inl h0
      · right; linarith [hm₁_le_quad]
    have hcp1_inv_sq_val0 : c_p1⁻¹ ^ 2 = 0 ∨ (0 : ℤ) ≤ valL F M₁' (c_p1⁻¹ ^ 2) := by
      have h1 : c_p1⁻¹ = 0 ∨ (0 : ℤ) ≤ valL F M₁' (c_p1⁻¹) := Or.inr (by rw [hcp1_inv_val0])
      have h := hmul_M₁' 0 0 (c_p1⁻¹) (c_p1⁻¹) h1 h1
      rwa [← sq, add_zero] at h
    have hT_plus_val : T + c_p1 * s_top = 0 ∨ (m₁ : ℤ) ≤ valL F M₁' (T + c_p1 * s_top) := by
      rcases hT_newt_p1 with h0 | hge
      · exact Or.inl h0
      · right
        have hBp1 : ((p - 1 : ℕ) : ℤ) * (m : ℤ) + ((p - 1 : ℕ) : ℤ) * ((t₁ + 2 * δ : ℕ) : ℤ) =
            B_z (p - 1) + ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) := by
          dsimp [B_z, t₂]
          have h1 : ((bE' - 1 : ℕ) : ℤ) = (t₁ : ℤ) + (δ : ℤ) := by dsimp [t₁, δ]; omega
          rw [h1]
          ring
        have hBp1_ge := hBz_ge_ν₀ (p - 1) hp1_mem
        have hm1_le : (m₁ : ℤ) ≤ (ν₀ : ℤ) + ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) := by
          exact_mod_cast hm₁_le_ν₀_t₂
        dsimp [c_p1, s_top]
        linarith
    have hcp1_stop_val0 : c_p1 * s_top = 0 ∨ (0 : ℤ) ≤ valL F M₁' (c_p1 * s_top) := by
      have h1 : c_p1 = 0 ∨ (0 : ℤ) ≤ valL F M₁' c_p1 := Or.inr (by rw [hcp1_val0])
      have h2 : s_top = 0 ∨ (0 : ℤ) ≤ valL F M₁' s_top := by
        rcases hstop_ν₀ with h0 | hge
        · exact Or.inl h0
        · right; linarith [show (0 : ℤ) ≤ (ν₀ : ℤ) by positivity]
      have h := hmul_M₁' 0 0 c_p1 s_top h1 h2
      rwa [add_zero] at h
    have hT_val0 : T = 0 ∨ (0 : ℤ) ≤ valL F M₁' T := by
      rcases hTr_z_val (p - 1) hp1_mem with h0 | hge
      · exact Or.inl h0
      · right
        have hBp1_ge := hBz_ge_ν₀ (p - 1) hp1_mem
        have hν0_nonneg : (0 : ℤ) ≤ (ν₀ : ℤ) := by positivity
        dsimp [T]
        linarith
    have hT_minus_val0 : c_p1 * s_top - T = 0 ∨ (0 : ℤ) ≤ valL F M₁' (c_p1 * s_top - T) :=
      hvalM₁'_sub 0 (c_p1 * s_top) T hcp1_stop_val0 hT_val0
    have hterm2 : c_p1⁻¹ ^ 2 * (T + c_p1 * s_top) * (c_p1 * s_top - T) = 0 ∨
        (m₁ : ℤ) ≤ valL F M₁' (c_p1⁻¹ ^ 2 * (T + c_p1 * s_top) * (c_p1 * s_top - T)) := by
      have h1 := hmul_M₁' 0 (m₁ : ℤ) (c_p1⁻¹ ^ 2) (T + c_p1 * s_top) hcp1_inv_sq_val0 hT_plus_val
      have h2 := hmul_M₁' (0 + (m₁ : ℤ)) 0 (c_p1⁻¹ ^ 2 * (T + c_p1 * s_top)) (c_p1 * s_top - T)
        h1 hT_minus_val0
      rcases h2 with h0 | hge
      · exact Or.inl h0
      · right; linarith
    have hsum12 := hvalM₁'_add (m₁ : ℤ) _ _ hterm1 hterm2
    have hprod1 := hmul_M₁' 0 (m₁ : ℤ) ((2 : M₁')⁻¹) _ h2_inv_val0 hsum12
    have hprod2 := hmul_M₁' (0 + (m₁ : ℤ)) 0 _ (((1 + n) ^ 2)⁻¹) hprod1 h1n_sq_inv_val0
    rcases hprod2 with h0 | hge
    · exact Or.inl h0
    · right; linarith
  have hS_diff_val : S_log - S_target = 0 ∨ (m₁ : ℤ) ≤ valL F M₁' (S_log - S_target) := by
    rw [hS_log_split]
    exact hvalM₁'_add (m₁ : ℤ) _ _ (hvalM₁'_add (m₁ : ℤ) _ _ hR_lin_val hR_quad_val) hR_tail_val
  have hψM₁'_log_eq_target :
      ψM₁' (2 * IntermediateField.inclusion hLM₁' (α : L) * b * S_log) =
        ψM₁' (2 * IntermediateField.inclusion hLM₁' (α : L) * b * S_target) := by
    have h_add_split :
        2 * IntermediateField.inclusion hLM₁' (α : L) * b * S_log =
          2 * IntermediateField.inclusion hLM₁' (α : L) * b * (S_log - S_target) +
            2 * IntermediateField.inclusion hLM₁' (α : L) * b * S_target := by ring
    rw [h_add_split, AddChar.map_add_eq_mul, hψM₁'_m1 (S_log - S_target) hS_diff_val, one_mul]
  
  let w_tot : K₁ :=
    (∑ i ∈ Finset.Icc 1 (p - 1),
      IntermediateField.inclusion hE'K₁
        (2 * IntermediateField.inclusion hLE' (α : L) * (-1 : E') ^ i * ((i : ℕ) : E')⁻¹) *
        (IntermediateField.inclusion hM₁'K₁ b * z ^ i *
          (IntermediateField.inclusion hM₁'K₁ (1 + n))⁻¹)) +
    IntermediateField.inclusion hE'K₁
      (2 * IntermediateField.inclusion hLE' (α : L) * (2 : E')⁻¹ * ((p - 1 : ℕ) : E')⁻¹ ^ 2) *
      (IntermediateField.inclusion hM₁'K₁ (b * T) * z ^ (p - 1) *
        (IntermediateField.inclusion hM₁'K₁ ((1 + n) ^ 2))⁻¹)
  have htr_E'_wtot :
      traceLM F hE'K₁ w_tot =
        2 * IntermediateField.inclusion hLE' (α : L) *
          ((∑ i ∈ Finset.Icc 1 (p - 1), (-1 : E') ^ i * ((i : ℕ) : E')⁻¹ * W_fn i) +
            (2 : E')⁻¹ * ((p - 1 : ℕ) : E')⁻¹ ^ 2 * Q_quad) := by
    dsimp only [w_tot, W_fn, Q_quad]
    rw [map_add, map_sum, htr_smul hE'K₁, mul_add, Finset.mul_sum]
    congr 1
    · refine Finset.sum_congr rfl fun i _ => ?_
      rw [htr_smul hE'K₁]
      ring
    · ring
  have hα_incl_eq :
      IntermediateField.inclusion hE'K₁ (IntermediateField.inclusion hLE' (α : L)) =
        IntermediateField.inclusion hM₁'K₁ (IntermediateField.inclusion hLM₁' (α : L)) :=
    Subtype.ext rfl
  have htr_M₁'_wtot :
      traceLM F hM₁'K₁ w_tot =
        2 * IntermediateField.inclusion hLM₁' (α : L) * b * S_target := by
    dsimp only [w_tot, S_target]
    rw [map_add, map_sum, mul_add, Finset.mul_sum]
    congr 1
    · refine Finset.sum_congr rfl fun i _ => ?_
      have hterm_i :
          IntermediateField.inclusion hE'K₁
            (2 * IntermediateField.inclusion hLE' (α : L) * (-1 : E') ^ i * ((i : ℕ) : E')⁻¹) *
            (IntermediateField.inclusion hM₁'K₁ b * z ^ i *
              (IntermediateField.inclusion hM₁'K₁ (1 + n))⁻¹) =
          IntermediateField.inclusion hM₁'K₁
            (2 * IntermediateField.inclusion hLM₁' (α : L) * b * (-1 : M₁') ^ i *
              ((i : ℕ) : M₁')⁻¹ * (1 + n)⁻¹) * z ^ i := by
        simp only [map_mul, map_pow, map_neg, map_one, map_ofNat, map_natCast, map_inv₀, hα_incl_eq]
        ring
      rw [hterm_i, htr_smul hM₁'K₁]
      ring
    · have hterm_quad :
          IntermediateField.inclusion hE'K₁
            (2 * IntermediateField.inclusion hLE' (α : L) * (2 : E')⁻¹ *
              ((p - 1 : ℕ) : E')⁻¹ ^ 2) *
            (IntermediateField.inclusion hM₁'K₁ (b * T) * z ^ (p - 1) *
              (IntermediateField.inclusion hM₁'K₁ ((1 + n) ^ 2))⁻¹) =
          IntermediateField.inclusion hM₁'K₁
            (2 * IntermediateField.inclusion hLM₁' (α : L) * b * (2 : M₁')⁻¹ *
              ((p - 1 : ℕ) : M₁')⁻¹ ^ 2 * T * ((1 + n) ^ 2)⁻¹) * z ^ (p - 1) := by
        simp only [map_mul, map_pow, map_ofNat, map_natCast, map_inv₀, hα_incl_eq]
        ring
      rw [hterm_quad, htr_smul hM₁'K₁]
      dsimp only [T]
      ring
  have htower_ψ : ψM₁' (traceLM F hM₁'K₁ w_tot) = ψE' (traceLM F hE'K₁ w_tot) := by
    change ψ (traceLM F hLM₁' (traceLM F hM₁'K₁ w_tot)) =
      ψ (traceLM F hLE' (traceLM F hE'K₁ w_tot))
    rw [(hTowerNormTr w_tot).2]
  have hConj3 : ∀ hE : 1 - (-E_norm) ≠ 0,
      (χ₁ (Units.mk0 (1 - (-E_norm)) hE) : Ω F) ^ 2 =
        ψE' (2 * IntermediateField.inclusion hLE' (α : L) *
          ((∑ i ∈ Finset.Icc 1 (p - 1), (-1 : E') ^ i * ((i : ℕ) : E')⁻¹ * W_fn i) +
            (2 : E')⁻¹ * ((p - 1 : ℕ) : E')⁻¹ ^ 2 * Q_quad)) := by
    intro hE
    have hlog := hχ₁_log' (-E_norm) hnegEnorm_q₁ hE
    change (χ₁ (Units.mk0 (1 - (-E_norm)) hE) : Ω F) ^ 2 =
      ψM₁' (2 * IntermediateField.inclusion hLM₁' (α : L) * b * S_log) at hlog
    rw [hlog, hψM₁'_log_eq_target, ← htr_M₁'_wtot, htower_ψ, htr_E'_wtot]
  exact ⟨hs₁_z_val, hT_newt_p1, hConj3⟩

theorem ld_ch12_wild_odd_tot_ram_trace_symm_comp_and_s0_approx (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F))
    (bE' bM₁' a_lam : ℕ)
    (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hbE'_lt_lam : bE' < a_lam)
    (hpm_gt_t₁ : bM₁' - 1 <
      Module.finrank L (IntermediateField.extendScalars hLE') * (a_lam - bE'))
    (hp_valK₁ : ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁) = 0 ∨
      ((Module.finrank L (IntermediateField.extendScalars hLE') *
        (Module.finrank L (IntermediateField.extendScalars hLE') - 1) * (bE' - 1) : ℕ) : ℤ) ≤
        valL F K₁ ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : K₁))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_E'K₁ : ∀ y : E',
      valL F K₁ (IntermediateField.inclusion hE'K₁ y) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F M₁' z)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y))
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (e_Δ : ℕ → M₁') (s₀ : E')
    (he_Δ_val : ∀ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
      e_Δ i = 0 ∨
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤ valL F M₁' (e_Δ i))
    (he_Δ_cayley :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ (Δ : K₁)) -
        ((Δ : K₁) ^ p +
          ∑ i ∈ Finset.Icc 1 (p - 1),
            (-1 : K₁) ^ i * IntermediateField.inclusion hM₁'K₁ (e_Δ i) * ((Δ : K₁) ^ (p - i))) = 0)
    (hs₀_approx :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      IntermediateField.inclusion hM₁'K₁ (- e_Δ (p - 1)) - IntermediateField.inclusion hE'K₁ s₀ = 0 ∨
        ((p * (p - 1) * (bE' - bM₁') + (p - 1) * (bM₁' - 1) : ℕ) : ℤ) ≤
          valL F K₁ (IntermediateField.inclusion hM₁'K₁ (- e_Δ (p - 1)) -
            IntermediateField.inclusion hE'K₁ s₀))
    (α γ : Lˣ) (w₂ : E'ˣ)
    (hα_val : valL F L (α : L) = -(bE' : ℤ) - condExpChar F L ψ)
    (hγ_val : valL F L (γ : L) = -(a_lam : ℤ) - condExpChar F L ψ)
    (hw₂_val : valL F E' (w₂ : E') = -((a_lam - bE' : ℕ) : ℤ))
    (hw₂_norm : Units.map (normLM F hLE') w₂ = γ * α⁻¹)
    (s₁ : K₁ → ℕ → M₁')
    (hs₁_cayley : ∀ w : K₁,
      w ^ (Module.finrank L (IntermediateField.extendScalars hLE')) =
        IntermediateField.inclusion hM₁'K₁ (normLM F hM₁'K₁ w) +
          ∑ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
            (-1 : K₁) ^ (i - 1) * IntermediateField.inclusion hM₁'K₁ (s₁ w i) *
              w ^ (Module.finrank L (IntermediateField.extendScalars hLE') - i))
    (huw₂_pow :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let u := (α : L) * ((γ⁻¹ : Lˣ) : L)
      IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) - 1 = 0 ∨
        ((p - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) ≤
          valL F E' (IntermediateField.inclusion hLE' u * ((w₂ : E') ^ p) - 1))
    (hs₁_z_val :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      let m := a_lam - bE'
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      ∀ i ∈ Finset.Icc 1 (p - 1),
        s₁ z i = 0 ∨
          ((p - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) +
            (i : ℤ) * ((m : ℤ) - (t₁ : ℤ)) ≤ valL F M₁' (s₁ z i))
    (hT_newt_p1 :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let t₁ := bM₁' - 1
      let δ := bE' - bM₁'
      let m := a_lam - bE'
      let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
      let T := traceLM F hM₁'K₁ (z ^ (p - 1))
      T + ((p - 1 : ℕ) : M₁') * s₁ z (p - 1) = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (m : ℤ) +
          ((p - 1 : ℕ) : ℤ) * ((t₁ + 2 * δ : ℕ) : ℤ) ≤
            valL F M₁' (T + ((p - 1 : ℕ) : M₁') * s₁ z (p - 1))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let t₁ := bM₁' - 1
    let δ := bE' - bM₁'
    let m := a_lam - bE'
    let z := IntermediateField.inclusion hE'K₁ (((w₂⁻¹ : E'ˣ) : E')) * (Δ : K₁)
    let T := traceLM F hM₁'K₁ (z ^ (p - 1))
    (T = 0 ∨ ((p - 1 : ℕ) : ℤ) * ((m + δ : ℕ) : ℤ) ≤ valL F M₁' T) ∧
    (IntermediateField.inclusion hM₁'K₁ T +
       IntermediateField.inclusion hE'K₁ ((((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) * s₀) = 0 ∨
      (((p - 1) * p * m + p * (p - 1) * δ + (p - 1) * t₁ : ℕ) : ℤ) ≤
        valL F K₁
          (IntermediateField.inclusion hM₁'K₁ T +
            IntermediateField.inclusion hE'K₁ ((((w₂⁻¹ : E'ˣ) : E') ^ (p - 1)) * s₀))) :=
by
  have hval_core : ∀ (B : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F B],
      valL F B 1 = 0 ∧
      valL F B (-1) = 0 ∧
      (∀ x : B, valL F B (-x) = valL F B x) ∧
      (∀ x y : B, x ≠ 0 → y ≠ 0 → valL F B (x * y) = valL F B x + valL F B y) ∧
      (∀ u : Bˣ, valL F B ((u⁻¹ : Bˣ) : B) = - valL F B (u : B)) ∧
      (∀ (k : ℤ) (x y : B),
        (x = 0 ∨ k ≤ valL F B x) → (y = 0 ∨ k ≤ valL F B y) →
          (x + y = 0 ∨ k ≤ valL F B (x + y))) := by
    clear hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hWild hp_odd ψ bE' bM₁' a_lam hbE'_ge2 hbM₁'_ge2
      hb_le hbE'_lt_lam hpm_gt_t₁ hp_valK₁ hval_LE' hval_LM₁' hval_E'K₁ hval_M₁'K₁
      hval_norm_M₁'K₁ hDiamond_E' Δ hΔ_val e_Δ s₀ he_Δ_val he_Δ_cayley hs₀_approx α γ w₂
      hα_val hγ_val hw₂_val hw₂_norm s₁ hs₁_cayley huw₂_pow hs₁_z_val hT_newt_p1
    intro B _
    have halg : ∀ z : B,
        minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
        ∃ m : ℕ,
          Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
          Module.finrank F B = (minpoly F z).natDegree * m := by
      clear ‹IsNonarchimedeanLocalField F› ‹TopologicalSpace F› ‹ValuativeRel F›
      intro z
      have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
        minpoly.algHom_eq B.val B.val.injective z
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
