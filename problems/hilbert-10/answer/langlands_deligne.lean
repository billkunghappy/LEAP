      apply Nat.eq_of_mul_eq_mul_left hF_pos
      rw [← mul_assoc, hF_LA, hF_AK, hF_LK]
    let hF'K : F' ≤ K := hF'E.trans hEK
    let K' : IntermediateField F' (AlgebraicClosure F) := IntermediateField.extendScalars hF'K
    let G' := K' ≃ₐ[F'] K'
    haveI : Algebra.IsSeparable F' K' := hGalF'K.2.2.2 hF'K
    haveI : Normal F' K' := IsGalois.to_normal
    haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
    haveI : Normal F' (AlgebraicClosure F) := Normal.tower_top_of_normal F F' (AlgebraicClosure F)
    letI : Fintype G' := AlgEquiv.fintype F' K'
    let ℓ := Module.finrank M (IntermediateField.extendScalars hMK)
    haveI : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
    haveI : NeZero ℓ := ⟨hPrime.ne_zero⟩
    have hSep_sub : ∀ {B : IntermediateField F (AlgebraicClosure F)}
        (hF'B : F' ≤ B) (hBK : B ≤ K),
        Algebra.IsSeparable F' (IntermediateField.extendScalars hF'B) := by
      intro B hF'B hBK
      refine ⟨fun x => ?_⟩
      let B_F' := IntermediateField.extendScalars hF'B
      have hxB : (x : AlgebraicClosure F) ∈ B := (IntermediateField.mem_extendScalars hF'B).mp x.2
      let x_K : K' := ⟨x.1, (IntermediateField.mem_extendScalars hF'K).mpr (hBK hxB)⟩
      have hsep_xK : IsSeparable F' x_K := Algebra.IsSeparable.isSeparable F' x_K
      have hmin_KF' : minpoly F' (x : AlgebraicClosure F) = minpoly F' x_K :=
        minpoly.algHom_eq K'.val K'.val.injective x_K
      have hmin_BF' : minpoly F' (x : AlgebraicClosure F) = minpoly F' x :=
        minpoly.algHom_eq B_F'.val B_F'.val.injective x
      change (minpoly F' x).Separable
      rw [← hmin_BF', hmin_KF']
      exact hsep_xK
    let π : relWeil F F' →* G' :=
      (AlgEquiv.restrictNormalHom K').comp
        ((IntermediateField.fixingSubgroupEquiv F').toMonoidHom.comp
          (Subgroup.inclusion (inf_le_right : relWeil F F' ≤ F'.fixingSubgroup)))
    have hπ : ∀ (w : relWeil F F') (x : K'),
        ((π w x : K') : AlgebraicClosure F) = (w : AbsGal F) (x : AlgebraicClosure F) := by
      intro w x
      change ((AlgEquiv.restrictNormalHom K'
        ((IntermediateField.fixingSubgroupEquiv F') ⟨w.1, w.2.2⟩) x : K') : AlgebraicClosure F) =
        (w : AbsGal F) (x : AlgebraicClosure F)
      rw [AlgEquiv.restrictNormalHom_apply]
      rfl
    have hπ_surj : Function.Surjective π := by
      intro g
      obtain ⟨w, hw⟩ := hSurj g
      refine ⟨w, AlgEquiv.ext fun x => Subtype.ext ?_⟩
      rw [hπ w x, hw x]
    let toSub : ∀ (A : IntermediateField F (AlgebraicClosure F)), F' ≤ A → IntermediateField F' K' :=
      fun A hF'A => (IntermediateField.extendScalars hF'A).comap K'.val
    let fieldOf : Subgroup G' → IntermediateField F (AlgebraicClosure F) :=
      fun M₀ => (IntermediateField.lift (IntermediateField.fixedField M₀)).restrictScalars F
    have h_mem_toSub : ∀ (A : IntermediateField F (AlgebraicClosure F)) (hF'A : F' ≤ A) (x : K'),
        x ∈ toSub A hF'A ↔ x.1 ∈ A :=
      fun A hF'A _ => IntermediateField.mem_extendScalars hF'A
    have h_toSub_le : ∀ (A₁ A₂ : IntermediateField F (AlgebraicClosure F))
        (hF'A₁ : F' ≤ A₁) (hA₁K : A₁ ≤ K) (hF'A₂ : F' ≤ A₂),
        toSub A₁ hF'A₁ ≤ toSub A₂ hF'A₂ ↔ A₁ ≤ A₂ := by
      intro A₁ A₂ hF'A₁ hA₁K hF'A₂
      constructor
      · intro hle x hx
        have hy : (⟨x, (IntermediateField.mem_extendScalars hF'K).mpr (hA₁K hx)⟩ : K') ∈ toSub A₁ hF'A₁ :=
          (h_mem_toSub A₁ hF'A₁ _).mpr hx
        exact (h_mem_toSub A₂ hF'A₂ _).mp (hle hy)
      · intro hle y hy
        exact (h_mem_toSub A₂ hF'A₂ y).mpr (hle ((h_mem_toSub A₁ hF'A₁ y).mp hy))
    have h_toSub_eq : ∀ (A₁ A₂ : IntermediateField F (AlgebraicClosure F))
        (hF'A₁ : F' ≤ A₁) (hA₁K : A₁ ≤ K) (hF'A₂ : F' ≤ A₂) (hA₂K : A₂ ≤ K),
        toSub A₁ hF'A₁ = toSub A₂ hF'A₂ ↔ A₁ = A₂ := by
      intro A₁ A₂ hF'A₁ hA₁K hF'A₂ hA₂K
      rw [le_antisymm_iff, le_antisymm_iff, h_toSub_le A₁ A₂ hF'A₁ hA₁K hF'A₂,
        h_toSub_le A₂ A₁ hF'A₂ hA₂K hF'A₁]
    have hF'_fieldOf : ∀ M₀ : Subgroup G', F' ≤ fieldOf M₀ := by
      intro M₀ z hz
      rw [IntermediateField.mem_restrictScalars]
      exact (IntermediateField.lift (IntermediateField.fixedField M₀)).algebraMap_mem ⟨z, hz⟩
    have h_fieldOf_le_K : ∀ M₀ : Subgroup G', fieldOf M₀ ≤ K := by
      intro M₀ z hz
      rw [IntermediateField.mem_restrictScalars] at hz
      exact (IntermediateField.mem_extendScalars hF'K).mp
        (IntermediateField.lift_le (IntermediateField.fixedField M₀) hz)
    have h_mem_fieldOf : ∀ (M₀ : Subgroup G') (x : K'),
        (x : AlgebraicClosure F) ∈ fieldOf M₀ ↔ x ∈ IntermediateField.fixedField M₀ := by
      intro M₀ x
      exact (IntermediateField.mem_restrictScalars F).trans (IntermediateField.mem_lift x)
    have h_toSub_fieldOf : ∀ M₀ : Subgroup G',
        toSub (fieldOf M₀) (hF'_fieldOf M₀) = IntermediateField.fixedField M₀ := by
      intro M₀
      ext x
      exact (h_mem_toSub (fieldOf M₀) (hF'_fieldOf M₀) x).trans (h_mem_fieldOf M₀ x)
    have h_fixing_toSub_fieldOf : ∀ M₀ : Subgroup G',
        (toSub (fieldOf M₀) (hF'_fieldOf M₀)).fixingSubgroup = M₀ := by
      intro M₀
      rw [h_toSub_fieldOf M₀, IntermediateField.fixingSubgroup_fixedField M₀]
    have h_fieldOf_fixing : ∀ (A : IntermediateField F (AlgebraicClosure F))
        (hF'A : F' ≤ A) (hAK : A ≤ K),
        fieldOf ((toSub A hF'A).fixingSubgroup) = A := by
      intro A hF'A hAK
      apply (h_toSub_eq (fieldOf ((toSub A hF'A).fixingSubgroup)) A
        (hF'_fieldOf _) (h_fieldOf_le_K _) hF'A hAK).mp
      rw [h_toSub_fieldOf, IsGalois.fixedField_fixingSubgroup (toSub A hF'A)]
    have h_le_iff : ∀ M₁ M₂ : Subgroup G', fieldOf M₁ ≤ fieldOf M₂ ↔ M₂ ≤ M₁ := by
      intro M₁ M₂
      constructor
      · intro hle
        have h1 : toSub (fieldOf M₁) (hF'_fieldOf M₁) ≤ toSub (fieldOf M₂) (hF'_fieldOf M₂) :=
          (h_toSub_le (fieldOf M₁) (fieldOf M₂) (hF'_fieldOf M₁) (h_fieldOf_le_K M₁) (hF'_fieldOf M₂)).mpr hle
        have h2 := IntermediateField.fixingSubgroup_le h1
        rwa [h_fixing_toSub_fieldOf M₁, h_fixing_toSub_fieldOf M₂] at h2
      · intro hle
        have h1 : IntermediateField.fixedField M₁ ≤ IntermediateField.fixedField M₂ :=
          IntermediateField.fixedField_antitone hle
        rw [← h_toSub_fieldOf M₁, ← h_toSub_fieldOf M₂] at h1
        exact (h_toSub_le (fieldOf M₁) (fieldOf M₂) (hF'_fieldOf M₁) (h_fieldOf_le_K M₁) (hF'_fieldOf M₂)).mp h1
    have h_inf_eq_sup : ∀ M₁ M₂ : Subgroup G', fieldOf (M₁ ⊓ M₂) = fieldOf M₁ ⊔ fieldOf M₂ := by
      intro M₁ M₂
      apply le_antisymm
      · let A := fieldOf M₁ ⊔ fieldOf M₂
        have hF'A : F' ≤ A := (hF'_fieldOf M₁).trans le_sup_left
        have hAK : A ≤ K := sup_le (h_fieldOf_le_K M₁) (h_fieldOf_le_K M₂)
        let M_A := (toSub A hF'A).fixingSubgroup
        have hA : fieldOf M_A = A := h_fieldOf_fixing A hF'A hAK
        have h1 : M_A ≤ M₁ := (h_le_iff M₁ M_A).mp (hA.symm ▸ le_sup_left)
        have h2 : M_A ≤ M₂ := (h_le_iff M₂ M_A).mp (hA.symm ▸ le_sup_right)
        have hinf : M_A ≤ M₁ ⊓ M₂ := le_inf h1 h2
        have h_le : fieldOf (M₁ ⊓ M₂) ≤ fieldOf M_A := (h_le_iff (M₁ ⊓ M₂) M_A).mpr hinf
        rwa [hA] at h_le
      · exact sup_le ((h_le_iff _ _).mpr inf_le_left) ((h_le_iff _ _).mpr inf_le_right)
    have h_finrank_F'_index : ∀ M₀ : Subgroup G',
        Module.finrank F' (IntermediateField.extendScalars (hF'_fieldOf M₀)) = M₀.index := by
      intro M₀
      let A_ext := IntermediateField.extendScalars (hF'_fieldOf M₀)
      have hmul : Module.finrank F' ↥A_ext * Nat.card ((toSub (fieldOf M₀) (hF'_fieldOf M₀)).fixingSubgroup) =
          Module.finrank F' ↥K' :=
        h_abs_finrank ↥F' ↥K' (AlgebraicClosure F) K'.val A_ext (fun z hz =>
          ⟨⟨z, (IntermediateField.mem_extendScalars hF'K).mpr
            (h_fieldOf_le_K M₀ ((IntermediateField.mem_extendScalars (hF'_fieldOf M₀)).mp hz))⟩, rfl⟩)
      rw [h_fixing_toSub_fieldOf M₀, ← IsGalois.card_aut_eq_finrank F' K',
        ← Subgroup.index_mul_card M₀] at hmul
      have hpos : 0 < Nat.card ↥M₀ := Nat.card_pos
      exact Nat.eq_of_mul_eq_mul_right hpos hmul
    let D_c : Subgroup G' := (toSub M hF'M).fixingSubgroup
    let H : Subgroup G' := (toSub E hF'E).fixingSubgroup
    let res_F' : F'.fixingSubgroup →* G' :=
      (AlgEquiv.restrictNormalHom K').comp (IntermediateField.fixingSubgroupEquiv F').toMonoidHom
    have h_res_apply : ∀ (σ : F'.fixingSubgroup) (x : K'),
        ((res_F' σ x : K') : AlgebraicClosure F) = σ.1 x.1 := by
      intro σ x
      change ((AlgEquiv.restrictNormalHom K'
        ((IntermediateField.fixingSubgroupEquiv F') σ) x : K') : AlgebraicClosure F) = σ.1 x.1
      rw [AlgEquiv.restrictNormalHom_apply]
      rfl
    have h_res_surj : Function.Surjective res_F' :=
      (AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F)).comp
        (IntermediateField.fixingSubgroupEquiv F').surjective
    have h_res_fix : ∀ (A : IntermediateField F (AlgebraicClosure F)) (hF'A : F' ≤ A) (hAK : A ≤ K)
        (σ : F'.fixingSubgroup),
        σ.1 ∈ A.fixingSubgroup ↔ res_F' σ ∈ (toSub A hF'A).fixingSubgroup := by
      intro A hF'A hAK σ
      rw [IntermediateField.mem_fixingSubgroup_iff, IntermediateField.mem_fixingSubgroup_iff]
      constructor
      · intro hσ y hy
        apply Subtype.ext
        rw [h_res_apply σ y]
        exact hσ y.1 ((h_mem_toSub A hF'A y).mp hy)
      · intro hσ x hx
        let y : K' := ⟨x, (IntermediateField.mem_extendScalars hF'K).mpr (hAK hx)⟩
        have hy : y ∈ toSub A hF'A := (h_mem_toSub A hF'A y).mpr hx
        have h1 := congrArg Subtype.val (hσ y hy)
        rwa [h_res_apply σ y] at h1
    have h_res_fieldOf : ∀ (M₀ : Subgroup G') (σ : F'.fixingSubgroup),
        σ.1 ∈ (fieldOf M₀).fixingSubgroup ↔ res_F' σ ∈ M₀ := by
      intro M₀ σ
      rw [h_res_fix (fieldOf M₀) (hF'_fieldOf M₀) (h_fieldOf_le_K M₀) σ, h_fixing_toSub_fieldOf M₀]
    have h_mem_A : ∀ (A : IntermediateField F (AlgebraicClosure F)) (hF'A : F' ≤ A) (hAK : A ≤ K)
        (w : relWeil F F'),
        w ∈ (relWeil F A).subgroupOf (relWeil F F') ↔ π w ∈ (toSub A hF'A).fixingSubgroup := by
      intro A hF'A hAK w
      change ((w : AbsGal F) ∈ weilGroup F ∧ (w : AbsGal F) ∈ A.fixingSubgroup) ↔
        π w ∈ (toSub A hF'A).fixingSubgroup
      have hw_weil : (w : AbsGal F) ∈ weilGroup F := w.2.1
      rw [and_iff_right hw_weil, IntermediateField.mem_fixingSubgroup_iff,
        IntermediateField.mem_fixingSubgroup_iff]
      constructor
      · intro hw x hx
        apply Subtype.ext
        rw [hπ w x]
        exact hw x.1 ((h_mem_toSub A hF'A x).mp hx)
      · intro hπw z hzA
        let x : K' := ⟨z, (IntermediateField.mem_extendScalars hF'K).mpr (hAK hzA)⟩
        have hxA : x ∈ toSub A hF'A := (h_mem_toSub A hF'A x).mpr hzA
        have h1 := hπ w x
        have h2 : π w x = x := hπw x hxA
        rw [h2] at h1
        exact h1.symm
    have h_weil_fieldOf : ∀ (M₀ : Subgroup G') (w : relWeil F F'),
        w ∈ (relWeil F (fieldOf M₀)).subgroupOf (relWeil F F') ↔ π w ∈ M₀ := by
      intro M₀ w
      rw [h_mem_A (fieldOf M₀) (hF'_fieldOf M₀) (h_fieldOf_le_K M₀) w, h_fixing_toSub_fieldOf M₀]
    have h_gal_fieldOf : ∀ (M₀ : Subgroup G') [hNorm : M₀.Normal],
        IsGaloisExt F F' (fieldOf M₀) := by
      intro M₀ hNorm
      haveI : FiniteDimensional F (fieldOf M₀) :=
        Module.Finite.of_injective (IntermediateField.inclusion (h_fieldOf_le_K M₀)).toLinearMap
          (IntermediateField.inclusion (h_fieldOf_le_K M₀)).injective
      refine ⟨hF'_fieldOf M₀, inferInstance, ?_, fun h => hSep_sub h (h_fieldOf_le_K M₀)⟩
      intro σ hσ τ hτ
      let σ' : F'.fixingSubgroup := ⟨σ, hσ⟩
      let τ' : F'.fixingSubgroup := ⟨τ, IntermediateField.fixingSubgroup_le (hF'_fieldOf M₀) hτ⟩
      have hτM₀ : res_F' τ' ∈ M₀ := (h_res_fieldOf M₀ τ').mp hτ
      have hconjM₀ : res_F' (σ' * τ' * σ'⁻¹) ∈ M₀ := by
        rw [map_mul, map_mul, map_inv]
        exact hNorm.conj_mem (res_F' τ') hτM₀ (res_F' σ')
      exact (h_res_fieldOf M₀ (σ' * τ' * σ'⁻¹)).mpr hconjM₀
    haveI hH_norm : H.Normal := ⟨by
      intro n hn g
      obtain ⟨σ, rfl⟩ := h_res_surj g
      obtain ⟨τ, rfl⟩ := h_res_surj n
      have hτE : τ.1 ∈ E.fixingSubgroup := (h_res_fix E hF'E hEK τ).mpr hn
      have hconjE : (σ * τ * σ⁻¹).1 ∈ E.fixingSubgroup := hGalF'E.2.2.1 σ.1 σ.2 τ.1 hτE
      have hres : res_F' (σ * τ * σ⁻¹) = res_F' σ * res_F' τ * (res_F' σ)⁻¹ := by
        rw [map_mul, map_mul, map_inv]
      rw [← hres]
      exact (h_res_fix E hF'E hEK (σ * τ * σ⁻¹)).mp hconjE⟩
    have h_field_E : fieldOf H = E := h_fieldOf_fixing E hF'E hEK
    have h_field_M : fieldOf D_c = M := h_fieldOf_fixing M hF'M hMK
    have hH_index : H.index = ℓ := by
      have hmul : Module.finrank F' ↥(IntermediateField.extendScalars hF'E) * Nat.card ↥H =
          Module.finrank F' ↥K' :=
        h_abs_finrank ↥F' ↥K' (AlgebraicClosure F) K'.val (IntermediateField.extendScalars hF'E)
          (fun z hz => ⟨⟨z, (IntermediateField.mem_extendScalars hF'K).mpr
            (hEK ((IntermediateField.mem_extendScalars hF'E).mp hz))⟩, rfl⟩)
      rw [← IsGalois.card_aut_eq_finrank F' K', ← Subgroup.index_mul_card H, hdegF'E] at hmul
      exact (Nat.eq_of_mul_eq_mul_right Nat.card_pos hmul).symm
    let ι_M : relWeil F M →* relWeil F F' := Subgroup.inclusion (relWeil_antitone F hF'M)
    let ι_E : relWeil F E →* relWeil F F' := Subgroup.inclusion (relWeil_antitone F hF'E)
    choose s_G' hs_G' using hπ_surj
    have hψ_ker_π : ∀ w : relWeil F F', π w = 1 → ψF' w = 1 := by
      intro w hw
      have hwM : (w : AbsGal F) ∈ M.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro z hz
        let x : K' := ⟨z, (IntermediateField.mem_extendScalars hF'K).mpr (hMK hz)⟩
        have h1 := hπ w x
        rw [hw] at h1
        exact h1.symm
      exact hψ_trivM w hwM
    have hψ_sG' : ∀ w : relWeil F F', ψF' (s_G' (π w)) = ψF' w := by
      intro w
      have h1 : π ((s_G' (π w))⁻¹ * w) = 1 := by
        rw [map_mul, map_inv, hs_G' (π w), inv_mul_cancel]
      have h2 := hψ_ker_π _ h1
      rw [map_mul, map_inv, inv_mul_eq_one] at h2
      exact h2
    let φ_G' : G' →* (Ω F)ˣ :=
      { toFun := fun g => ψF' (s_G' g)
        map_one' := by
          have h1 := hψ_sG' 1
          rw [map_one] at h1
          exact h1.trans (map_one ψF')
        map_mul' := fun g₁ g₂ => by
          have h1 := hψ_sG' (s_G' g₁ * s_G' g₂)
          rw [map_mul, hs_G' g₁, hs_G' g₂] at h1
          rw [h1, map_mul] }
    have hφ_π : ∀ w : relWeil F F', φ_G' (π w) = ψF' w := hψ_sG'
    let M1_sub : Subgroup G' := φ_G'.ker
    haveI : M1_sub.Normal := φ_G'.normal_ker
    let H1_sub : Subgroup G' := H ⊓ M1_sub
    haveI : H1_sub.Normal := Subgroup.normal_inf_normal H M1_sub
    have hDc_le_M1_sub : D_c ≤ M1_sub := by
      intro d hd
      change φ_G' d = 1
      have hd_π : π (s_G' d) ∈ D_c := by rw [hs_G' d]; exact hd
      have hwM : s_G' d ∈ (relWeil F M).subgroupOf (relWeil F F') :=
        (h_mem_A M hF'M hMK (s_G' d)).mpr hd_π
      exact hψ_trivM (s_G' d) hwM.2
    have hG'_decomp : ∀ g : G', ∃ d ∈ D_c, ∃ h ∈ H, g = d * h := by
      intro g
      obtain ⟨w₁, w₂, hw⟩ := hFactorF' (s_G' g)
      have hw_sub : s_G' g = ι_M w₂ * ι_E w₁ := Subtype.ext hw
      have hd : π (ι_M w₂) ∈ D_c := (h_mem_A M hF'M hMK (ι_M w₂)).mp w₂.2
      have hh : π (ι_E w₁) ∈ H := (h_mem_A E hF'E hEK (ι_E w₁)).mp w₁.2
      refine ⟨π (ι_M w₂), hd, π (ι_E w₁), hh, ?_⟩
      rw [← map_mul, ← hw_sub, hs_G' g]
    have h_sup_raw : E ⊔ fieldOf M1_sub = fieldOf H1_sub := by
      rw [← h_field_E, ← h_inf_eq_sup H M1_sub]
    have h_inf_raw : E ⊓ fieldOf M1_sub = F' := by
      apply le_antisymm
      · intro z hz
        let x : K' := ⟨z, (IntermediateField.mem_extendScalars hF'K).mpr (hEK hz.1)⟩
        have hxE : x ∈ toSub E hF'E := (h_mem_toSub E hF'E x).mpr hz.1
        have hxH : x ∈ IntermediateField.fixedField H := by
          rwa [IsGalois.fixedField_fixingSubgroup (toSub E hF'E)]
        have hxM₁ : x ∈ IntermediateField.fixedField M1_sub := (h_mem_fieldOf M1_sub x).mp hz.2
        have hx_top : x ∈ IntermediateField.fixedField (⊤ : Subgroup G') := by
          rw [IntermediateField.mem_fixedField_iff] at hxH hxM₁ ⊢
          intro g _
          obtain ⟨d, hd, h, hh, rfl⟩ := hG'_decomp g
          calc (d * h) x = d (h x) := rfl
            _ = d x := by rw [hxH h hh]
            _ = x := hxM₁ d (hDc_le_M1_sub hd)
        have hx_bot : x ∈ (⊥ : IntermediateField F' K') := by
          rw [← IsGalois.fixedField_fixingSubgroup (⊥ : IntermediateField F' K'),
            IntermediateField.fixingSubgroup_bot]
          exact hx_top
        rw [IntermediateField.mem_bot] at hx_bot
        rcases hx_bot with ⟨y, hy⟩
        have hy_val : (y : AlgebraicClosure F) = z := congrArg Subtype.val hy
        rw [← hy_val]
        exact y.2
      · exact le_inf hF'E (hF'_fieldOf M1_sub)
    let g₀ : G' := π (ι_E w₁₀)
    have hg₀H : g₀ ∈ H := (h_mem_A E hF'E hEK (ι_E w₁₀)).mp w₁₀.2
    have hφ_g₀_ne : φ_G' g₀ ≠ 1 := by
      rw [hφ_π (ι_E w₁₀)]
      exact hψ_ne
    have hφ_pow : ∀ g : G', φ_G' g ^ ℓ = 1 := fun g => hψ_pow (s_G' g)
    let ζ₀ : (Ω F)ˣ := φ_G' g₀
    have hζ₀_pow : ζ₀ ^ ℓ = 1 := hφ_pow g₀
    have h_ord_ζ₀ : orderOf ζ₀ = ℓ := orderOf_eq_prime hζ₀_pow hφ_g₀_ne
    have hζ₀_val_pow : (ζ₀ : Ω F) ^ ℓ = 1 := by
      rw [← Units.val_pow_eq_pow_val, hζ₀_pow, Units.val_one]
    have hζ₀_val_ne : (ζ₀ : Ω F) ≠ 1 := fun h1 => hφ_g₀_ne (Units.ext h1)
    have h_ord_val : orderOf (ζ₀ : Ω F) = ℓ := orderOf_eq_prime hζ₀_val_pow hζ₀_val_ne
    have hprim : IsPrimitiveRoot (ζ₀ : Ω F) ℓ := IsPrimitiveRoot.iff_orderOf.mpr h_ord_val
    have h_mem_zpow : ∀ g : G', φ_G' g ∈ Subgroup.zpowers ζ₀ := by
      intro g
      have hg_pow : (φ_G' g : Ω F) ^ ℓ = 1 := by
        rw [← Units.val_pow_eq_pow_val, hφ_pow g, Units.val_one]
      obtain ⟨i, _, hi⟩ := hprim.eq_pow_of_pow_eq_one hg_pow
      rw [Subgroup.mem_zpowers_iff]
      refine ⟨(i : ℤ), ?_⟩
      rw [zpow_natCast]
      apply Units.ext
      rw [Units.val_pow_eq_pow_val]
      exact hi
    let φ_H : H →* (Ω F)ˣ := φ_G'.comp H.subtype
    have h_range_G : φ_G'.range = Subgroup.zpowers ζ₀ := by
      apply le_antisymm
      · rintro _ ⟨g, rfl⟩
        exact h_mem_zpow g
      · rw [Subgroup.zpowers_le]
        exact ⟨g₀, rfl⟩
    have h_range_H : φ_H.range = Subgroup.zpowers ζ₀ := by
      apply le_antisymm
      · rintro _ ⟨h, rfl⟩
        exact h_mem_zpow h.1
      · rw [Subgroup.zpowers_le]
        exact ⟨⟨g₀, hg₀H⟩, rfl⟩
    have h_card_zpow : Nat.card (Subgroup.zpowers ζ₀) = ℓ := by
      rw [Nat.card_zpowers, h_ord_ζ₀]
    have h_idx_M1_sub : M1_sub.index = ℓ := by
      calc M1_sub.index
        _ = Nat.card (G' ⧸ φ_G'.ker) := rfl
        _ = Nat.card φ_G'.range := Nat.card_congr (QuotientGroup.quotientKerEquivRange φ_G').toEquiv
        _ = Nat.card (Subgroup.zpowers ζ₀) := by rw [h_range_G]
        _ = ℓ := h_card_zpow
    have h_ker_H : (H1_sub.subgroupOf H) = φ_H.ker := by
      ext h
      change (h.1 ∈ H ∧ φ_G' h.1 = 1) ↔ φ_G' h.1 = 1
      exact and_iff_right h.2
    have h_relIdx_H1_sub : H1_sub.relIndex H = ℓ := by
      change (H1_sub.subgroupOf H).index = ℓ
      rw [h_ker_H]
      calc φ_H.ker.index
        _ = Nat.card (H ⧸ φ_H.ker) := rfl
        _ = Nat.card φ_H.range := Nat.card_congr (QuotientGroup.quotientKerEquivRange φ_H).toEquiv
        _ = Nat.card (Subgroup.zpowers ζ₀) := by rw [h_range_H]
        _ = ℓ := h_card_zpow
    have h_idx_H1_sub : H1_sub.index = ℓ * ℓ := by
      rw [← Subgroup.relIndex_mul_index (inf_le_left : H1_sub ≤ H), h_relIdx_H1_sub, hH_index]
    have hdegF'M₁_raw : Module.finrank F' (IntermediateField.extendScalars (hF'_fieldOf M1_sub)) =
        Module.finrank F' (IntermediateField.extendScalars hF'E) := by
      rw [h_finrank_F'_index M1_sub, h_idx_M1_sub, hdegF'E]
    have hdegF'K₁_raw : Module.finrank F' (IntermediateField.extendScalars (hF'_fieldOf H1_sub)) =
        Module.finrank F' (IntermediateField.extendScalars hF'E) *
          Module.finrank F' (IntermediateField.extendScalars hF'E) := by
      rw [h_finrank_F'_index H1_sub, h_idx_H1_sub, hdegF'E]
    have hK₁_iff_raw : ∀ w₁ : relWeil F E,
        (w₁ : AbsGal F) ∈ (fieldOf H1_sub).fixingSubgroup ↔
          ψF' (Subgroup.inclusion (relWeil_antitone F hF'E) w₁) = 1 := by
      intro w₁
      have h1 : (w₁ : AbsGal F) ∈ (fieldOf H1_sub).fixingSubgroup ↔
          ι_E w₁ ∈ (relWeil F (fieldOf H1_sub)).subgroupOf (relWeil F F') := by
        change (w₁ : AbsGal F) ∈ (fieldOf H1_sub).fixingSubgroup ↔
          ((w₁ : AbsGal F) ∈ weilGroup F ∧ (w₁ : AbsGal F) ∈ (fieldOf H1_sub).fixingSubgroup)
        exact (and_iff_right w₁.2.1).symm
      have h2 : π (ι_E w₁) ∈ H := (h_mem_A E hF'E hEK (ι_E w₁)).mp w₁.2
      rw [h1, h_weil_fieldOf H1_sub (ι_E w₁), Subgroup.mem_inf, and_iff_right h2]
      change φ_G' (π (ι_E w₁)) = 1 ↔ ψF' (ι_E w₁) = 1
      rw [hφ_π (ι_E w₁)]
    have hM₁_weil_raw : ∀ w₁ : relWeil F E,
        (w₁ : AbsGal F) ∈ (fieldOf M1_sub).fixingSubgroup →
          ψF' (Subgroup.inclusion (relWeil_antitone F hF'E) w₁) = 1 := by
      intro w₁ hw₁_M₁
      have hw₁_sub : ι_E w₁ ∈ (relWeil F (fieldOf M1_sub)).subgroupOf (relWeil F F') :=
        ⟨w₁.2.1, hw₁_M₁⟩
      have hπ_M1_sub : π (ι_E w₁) ∈ M1_sub := (h_weil_fieldOf M1_sub (ι_E w₁)).mp hw₁_sub
      rw [← hφ_π (ι_E w₁)]
      exact hπ_M1_sub
    obtain ⟨M₁, hM₁_def⟩ : ∃ M₁ : IntermediateField F (AlgebraicClosure F), M₁ = fieldOf M1_sub := ⟨_, rfl⟩
    obtain ⟨K₁, hK₁_def⟩ : ∃ K₁ : IntermediateField F (AlgebraicClosure F), K₁ = fieldOf H1_sub := ⟨_, rfl⟩
    have hF'M₁ : F' ≤ M₁ := hM₁_def ▸ hF'_fieldOf M1_sub
    have hM₁M : M₁ ≤ M := by
      rw [hM₁_def, ← h_field_M]
      exact (h_le_iff M1_sub D_c).mpr hDc_le_M1_sub
    have hEK₁ : E ≤ K₁ := by
      rw [hK₁_def, ← h_field_E]
      exact (h_le_iff H H1_sub).mpr inf_le_left
    have hM₁K₁ : M₁ ≤ K₁ := by
      rw [hM₁_def, hK₁_def]
      exact (h_le_iff M1_sub H1_sub).mpr inf_le_right
    have hK₁K : K₁ ≤ K := hK₁_def ▸ h_fieldOf_le_K H1_sub
    have hGalF'K₁ : IsGaloisExt F F' K₁ := hK₁_def ▸ h_gal_fieldOf H1_sub
    have hGalF'M₁ : IsGaloisExt F F' M₁ := hM₁_def ▸ h_gal_fieldOf M1_sub
    have hGalEK₁ : IsGaloisExt F E K₁ :=
      ((ld_galois_closure_directed_system F).2.1 F' E K₁ hF'E hEK₁ hGalF'K₁).1
    have hGalM₁K₁ : IsGaloisExt F M₁ K₁ :=
      ((ld_galois_closure_directed_system F).2.1 F' M₁ K₁ hF'M₁ hM₁K₁ hGalF'K₁).1
    have h_sup : E ⊔ M₁ = K₁ := by rw [hM₁_def, hK₁_def, h_sup_raw]
    have h_inf : E ⊓ M₁ = F' := by rw [hM₁_def, h_inf_raw]
    have hdegF'M₁ : Module.finrank F' (IntermediateField.extendScalars hF'M₁) =
        Module.finrank F' (IntermediateField.extendScalars hF'E) := by
      subst hM₁_def
      exact hdegF'M₁_raw
    have hdegF'K₁ : Module.finrank F' (IntermediateField.extendScalars (hF'E.trans hEK₁)) =
        Module.finrank F' (IntermediateField.extendScalars hF'E) *
          Module.finrank F' (IntermediateField.extendScalars hF'E) := by
      subst hK₁_def
      exact hdegF'K₁_raw
    haveI : FiniteDimensional F K₁ := hGalF'K₁.2.1
    haveI : FiniteDimensional F M₁ := hGalF'M₁.2.1
    have hpos_F'E : 0 < Module.finrank F' (IntermediateField.extendScalars hF'E) :=
      hdegF'E.symm ▸ hPrime.pos
    have hdegEK₁ : Module.finrank E (IntermediateField.extendScalars hEK₁) =
        Module.finrank F' (IntermediateField.extendScalars hF'E) := by
      have hmul := h_tower_finrank F' E K₁ (hF'E.trans hEK₁) hF'E hEK₁
      rw [hdegF'K₁] at hmul
      exact Nat.eq_of_mul_eq_mul_left hpos_F'E hmul
    have hdegM₁K₁ : Module.finrank M₁ (IntermediateField.extendScalars hM₁K₁) =
        Module.finrank F' (IntermediateField.extendScalars hF'E) := by
      have hmul := h_tower_finrank F' M₁ K₁ (hF'E.trans hEK₁) hF'M₁ hM₁K₁
      rw [hdegF'M₁, hdegF'K₁] at hmul
      exact Nat.eq_of_mul_eq_mul_left hpos_F'E hmul
    have hK₁_iff : ∀ w₁ : relWeil F E,
        (w₁ : AbsGal F) ∈ K₁.fixingSubgroup ↔
          ψF' (Subgroup.inclusion (relWeil_antitone F hF'E) w₁) = 1 := by
      rw [hK₁_def]
      exact hK₁_iff_raw
    have hFactorM₁ : ∀ w : relWeil F M₁,
        ∃ (w₁ : relWeil F K₁) (w₂ : relWeil F M),
          (w : AbsGal F) = (w₁ : AbsGal F) * (w₂ : AbsGal F) := by
      intro w
      let w_F' : relWeil F F' := Subgroup.inclusion (relWeil_antitone F hF'M₁) w
      obtain ⟨u₁, u₂, hu⟩ := hFactorF' w_F'⁻¹
      let w₁_E : relWeil F E := u₁⁻¹
      let w₂ : relWeil F M := u₂⁻¹
      have hw_eq : (w : AbsGal F) = (w₁_E : AbsGal F) * (w₂ : AbsGal F) := by
        change (w : AbsGal F)⁻¹ = (u₂ : AbsGal F) * (u₁ : AbsGal F) at hu
        have h_inv := congrArg Inv.inv hu
        rw [mul_inv_rev, inv_inv] at h_inv
        exact h_inv
      have hw₁_M₁ : (w₁_E : AbsGal F) ∈ M₁.fixingSubgroup := by
        have h_eq_w₁ : (w₁_E : AbsGal F) = (w : AbsGal F) * (w₂ : AbsGal F)⁻¹ := by
          rw [hw_eq, mul_inv_cancel_right]
        rw [h_eq_w₁]
        exact M₁.fixingSubgroup.mul_mem w.2.2
          (M₁.fixingSubgroup.inv_mem (IntermediateField.fixingSubgroup_le hM₁M w₂.2.2))
      have hψ_w₁ : ψF' (ι_E w₁_E) = 1 := hM₁_weil_raw w₁_E (hM₁_def ▸ hw₁_M₁)
      have hw₁_K₁ : (w₁_E : AbsGal F) ∈ K₁.fixingSubgroup := (hK₁_iff w₁_E).mpr hψ_w₁
      exact ⟨⟨w₁_E.1, w₁_E.2.1, hw₁_K₁⟩, w₂, hw_eq⟩
    exact ⟨K₁, M₁, hF'M₁, hM₁M, hEK₁, hM₁K₁, hK₁K,
      hGalF'K₁, hGalF'M₁, hGalEK₁, hGalM₁K₁,
      hdegF'M₁, hdegEK₁, hdegM₁K₁, hdegF'K₁,
      h_inf, h_sup, hK₁_iff, hFactorM₁⟩
  obtain ⟨K₁, M₁, hF'M₁, hM₁M, hEK₁, hM₁K₁, hK₁K,
      hGalF'K₁, hGalF'M₁, hGalEK₁, hGalM₁K₁,
      hdegF'M₁, hdegEK₁, hdegM₁K₁, hdegF'K₁,
      h_inf, h_sup, hK₁_iff, hFactorM₁⟩ := h_stage3
  have hCommK₁ : ∀ (x w : relWeil F F'),
      (x : AbsGal F)⁻¹ * (w : AbsGal F) * (x : AbsGal F) * (w : AbsGal F)⁻¹ ∈ K₁.fixingSubgroup := by
    intro x w
    obtain ⟨w₁, w₂, hw⟩ := hFactorF' w
    have hw₂_comm_K : (x : AbsGal F)⁻¹ * (w₂ : AbsGal F) * (x : AbsGal F) * (w₂ : AbsGal F)⁻¹ ∈ K.fixingSubgroup := by
      have hx_inv_L : (x : AbsGal F)⁻¹ ∈ L.fixingSubgroup :=
        L.fixingSubgroup.inv_mem (IntermediateField.fixingSubgroup_le hLF' x.2.2)
      have h1 := hCent (x : AbsGal F)⁻¹ hx_inv_L (w₂ : AbsGal F) w₂.2.2
      rwa [inv_inv] at h1
    have hw₂_comm_E : (x : AbsGal F)⁻¹ * (w₂ : AbsGal F) * (x : AbsGal F) * (w₂ : AbsGal F)⁻¹ ∈ E.fixingSubgroup :=
      IntermediateField.fixingSubgroup_le hEK hw₂_comm_K
    have hw₁_conj_E : (x : AbsGal F)⁻¹ * (w₁ : AbsGal F) * (x : AbsGal F) * (w₁ : AbsGal F)⁻¹ ∈ E.fixingSubgroup := by
      have hx_inv_F' : (x : AbsGal F)⁻¹ ∈ F'.fixingSubgroup := F'.fixingSubgroup.inv_mem x.2.2
      have h1 := hGalF'E.2.2.1 (x : AbsGal F)⁻¹ hx_inv_F' (w₁ : AbsGal F) w₁.2.2
      rw [inv_inv] at h1
      exact E.fixingSubgroup.mul_mem h1 (E.fixingSubgroup.inv_mem w₁.2.2)
    have hw₂_w₁_E : (w₂ : AbsGal F) * ((x : AbsGal F)⁻¹ * (w₁ : AbsGal F) * (x : AbsGal F) * (w₁ : AbsGal F)⁻¹) *
        (w₂ : AbsGal F)⁻¹ ∈ E.fixingSubgroup :=
      hGalF'E.2.2.1 (w₂ : AbsGal F) (IntermediateField.fixingSubgroup_le hF'M w₂.2.2) _ hw₁_conj_E
    have hc_E : (x : AbsGal F)⁻¹ * (w : AbsGal F) * (x : AbsGal F) * (w : AbsGal F)⁻¹ ∈ E.fixingSubgroup := by
      have h_id : (x : AbsGal F)⁻¹ * (w : AbsGal F) * (x : AbsGal F) * (w : AbsGal F)⁻¹ =
          ((x : AbsGal F)⁻¹ * (w₂ : AbsGal F) * (x : AbsGal F) * (w₂ : AbsGal F)⁻¹) *
            ((w₂ : AbsGal F) * ((x : AbsGal F)⁻¹ * (w₁ : AbsGal F) * (x : AbsGal F) * (w₁ : AbsGal F)⁻¹) *
              (w₂ : AbsGal F)⁻¹) := by
        rw [hw]
        group
      rw [h_id]
      exact E.fixingSubgroup.mul_mem hw₂_comm_E hw₂_w₁_E
    let c_relE : relWeil F E :=
      ⟨(x : AbsGal F)⁻¹ * (w : AbsGal F) * (x : AbsGal F) * (w : AbsGal F)⁻¹,
        (x⁻¹ * w * x * w⁻¹).2.1, hc_E⟩
    have h_ιc : Subgroup.inclusion (relWeil_antitone F hF'E) c_relE = x⁻¹ * w * x * w⁻¹ := rfl
    apply (hK₁_iff c_relE).mpr
    rw [h_ιc, map_mul, map_mul, map_mul, map_inv, map_inv,
      mul_right_comm (ψF' x)⁻¹, mul_inv_cancel_right, inv_mul_cancel]
  
  have h_stage4 :
      IsInvariantWeilChar F F' K₁ (restrictWeilChar F hEK₁ χE) ∧
      restrictWeilChar F hK₁K (restrictWeilChar F hEK₁ χE) = χK ∧
      (∀ w : relWeil F E, (w : AbsGal F) ∉ K₁.fixingSubgroup →
        ∃ (g : relWeil F F')
          (hw : (g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F) ∈ relWeil F E),
          χE ⟨(g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F), hw⟩ ≠ χE w) ∧
      ∃ χM₁ : relWeil F M₁ →* (Ω F)ˣ,
        IsWeilRep F M₁ (charRep F M₁ χM₁) ∧
        restrictWeilChar F hM₁K₁ χM₁ = restrictWeilChar F hEK₁ χE ∧
        (∀ w : relWeil F M₁, (w : AbsGal F) ∉ K₁.fixingSubgroup →
          ∃ (g : relWeil F F')
            (hw : (g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F) ∈ relWeil F M₁),
            χM₁ ⟨(g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F), hw⟩ ≠ χM₁ w) := by
    clear hSurj hψ_trivM hψ_ne hψ_pow
    let χK₁ : relWeil F K₁ →* (Ω F)ˣ := restrictWeilChar F hEK₁ χE
    have hχK₁_rest : restrictWeilChar F hK₁K χK₁ = χK := by
      rw [← hχE_rest]
      ext w
      rfl
    have hχK₁_weil : IsWeilRep F K₁ (charRep F K₁ χK₁) := by
      rcases hχE_weil with ⟨hfin, U, hU, htriv⟩
      refine ⟨hfin, U, hU, fun w hwU hwI => ?_⟩
      exact htriv (Subgroup.inclusion (relWeil_antitone F hEK₁) w) hwU hwI
    have hInvK₁ : IsInvariantWeilChar F F' K₁ χK₁ := by
      refine ⟨hχK₁_weil, fun g w hgw => ?_⟩
      obtain ⟨w₁, w₂, hgw_fact⟩ := hFactorF' g
      have hw'_mem : (w₁ : AbsGal F) * (w : AbsGal F) * (w₁ : AbsGal F)⁻¹ ∈ relWeil F K₁ := by
        refine ⟨(weilGroup F).mul_mem ((weilGroup F).mul_mem w₁.2.1 w.2.1) ((weilGroup F).inv_mem w₁.2.1), ?_⟩
        exact hGalF'K₁.2.2.1 (w₁ : AbsGal F) (IntermediateField.fixingSubgroup_le hF'E w₁.2.2)
          (w : AbsGal F) w.2.2
      let w' : relWeil F K₁ := ⟨(w₁ : AbsGal F) * (w : AbsGal F) * (w₁ : AbsGal F)⁻¹, hw'_mem⟩
      let w'_E : relWeil F E := Subgroup.inclusion (relWeil_antitone F hEK₁) w'
      let w_E : relWeil F E := Subgroup.inclusion (relWeil_antitone F hEK₁) w
      have hw'_eq_E : w'_E = w₁ * w_E * w₁⁻¹ := rfl
      have hχ_w' : χK₁ w' = χK₁ w := by
        change χE w'_E = χE w_E
        rw [hw'_eq_E, map_mul, map_mul, map_inv, mul_right_comm, mul_inv_cancel, one_mul]
      have hψ_w' : ψF' (Subgroup.inclusion (relWeil_antitone F hF'E) w'_E) = 1 :=
        (hK₁_iff w'_E).mp w'.2.2
      have hw2_w'_mem : (w₂ : AbsGal F) * (w'_E : AbsGal F) * (w₂ : AbsGal F)⁻¹ ∈ relWeil F E := by
        refine ⟨(weilGroup F).mul_mem ((weilGroup F).mul_mem w₂.2.1 w'_E.2.1) ((weilGroup F).inv_mem w₂.2.1), ?_⟩
        exact hGalF'E.2.2.1 (w₂ : AbsGal F) (IntermediateField.fixingSubgroup_le hF'M w₂.2.2)
          (w'_E : AbsGal F) w'_E.2.2
      have hχ_w2 : χE ⟨(w₂ : AbsGal F) * (w'_E : AbsGal F) * (w₂ : AbsGal F)⁻¹, hw2_w'_mem⟩ = χE w'_E :=
        hψ_invE w'_E w₂ hw2_w'_mem hψ_w'
      have h_sub_eq : Subgroup.inclusion (relWeil_antitone F hEK₁)
          ⟨(g : AbsGal F) * (w : AbsGal F) * (g : AbsGal F)⁻¹, hgw⟩ =
          ⟨(w₂ : AbsGal F) * (w'_E : AbsGal F) * (w₂ : AbsGal F)⁻¹, hw2_w'_mem⟩ := by
        apply Subtype.ext
        change (g : AbsGal F) * (w : AbsGal F) * (g : AbsGal F)⁻¹ =
          (w₂ : AbsGal F) * ((w₁ : AbsGal F) * (w : AbsGal F) * (w₁ : AbsGal F)⁻¹) * (w₂ : AbsGal F)⁻¹
        rw [hgw_fact]
        group
      change χE (Subgroup.inclusion (relWeil_antitone F hEK₁)
        ⟨(g : AbsGal F) * (w : AbsGal F) * (g : AbsGal F)⁻¹, hgw⟩) = χK₁ w
      rw [h_sub_eq, hχ_w2]
      exact hχ_w'
    have hNonInvE : ∀ w : relWeil F E, (w : AbsGal F) ∉ K₁.fixingSubgroup →
        ∃ (g : relWeil F F')
          (hw : (g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F) ∈ relWeil F E),
          χE ⟨(g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F), hw⟩ ≠ χE w := by
      intro w hw_not
      have hψ_ne : ψF' (Subgroup.inclusion (relWeil_antitone F hF'E) w) ≠ 1 :=
        fun h1 => hw_not ((hK₁_iff w).mpr h1)
      let g : relWeil F F' := Subgroup.inclusion (relWeil_antitone F hF'M) w₂₀
      have hw_conj : (g : AbsGal F)⁻¹ * (w : AbsGal F) * (g : AbsGal F) ∈ relWeil F E := by
        refine ⟨(weilGroup F).mul_mem ((weilGroup F).mul_mem ((weilGroup F).inv_mem g.2.1) w.2.1) g.2.1, ?_⟩
        have hg_inv : (g : AbsGal F)⁻¹ ∈ F'.fixingSubgroup := F'.fixingSubgroup.inv_mem g.2.2
        have h1 := hGalF'E.2.2.1 (g : AbsGal F)⁻¹ hg_inv (w : AbsGal F) w.2.2
        rwa [inv_inv] at h1
      refine ⟨g, hw_conj, ?_⟩
      intro heq
      apply hψ_ne
      change χE ⟨(w₂₀ : AbsGal F)⁻¹ * (w : AbsGal F) * (w₂₀ : AbsGal F), hw_conj⟩ = χE w at heq
      rw [hψ_ratio w hw_conj, heq, mul_inv_cancel]
    have h_indep : ∀ (w₁ w₁' : relWeil F K₁) (w₂ w₂' : relWeil F M),
        (w₁ : AbsGal F) * (w₂ : AbsGal F) = (w₁' : AbsGal F) * (w₂' : AbsGal F) →
        χK₁ w₁ * χM w₂ = χK₁ w₁' * χM w₂' := by
      intro w₁ w₁' w₂ w₂' heq
      let δ_gal : AbsGal F := (w₁' : AbsGal F)⁻¹ * (w₁ : AbsGal F)
      have hδ_eq : δ_gal = (w₂' : AbsGal F) * (w₂ : AbsGal F)⁻¹ := by
        dsimp [δ_gal]
        calc (w₁' : AbsGal F)⁻¹ * (w₁ : AbsGal F)
