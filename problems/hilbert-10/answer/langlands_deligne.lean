            valL F M
              ((∏ j ∈ (Finset.range p).erase 0, (N + (τ_u j : M))) - (N ^ (p - 1) - 1))) ∧
        (∀ r ∈ Finset.Icc 1 (2 * (p - 1)),
          (∑ j ∈ (Finset.range p).erase 0, (τ_u j : M) ^ r) -
            (if (p - 1) ∣ r then ((p - 1 : ℕ) : M) else 0) = 0 ∨
            (b + 1 : ℤ) ≤
