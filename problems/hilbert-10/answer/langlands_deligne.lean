        exact mul_nonneg (by positivity) hge
    rcases hval_mul_ge_E' hci_E' (hπ_pow_val (i : ℕ)) with h0 | hge
    · exact Or.inl h0
    · right; omega

  have h2x_val : 2 * x_star - x_star ^ 2 = 0 ∨
      (t : ℤ) ≤ valL F E' (2 * x_star - x_star ^ 2) := by
    have h1 : (2 : E') = 0 ∨ 0 ≤ valL F E' (2 : E') := by
      have h2_E' : (2 : E') = (1 : E') + (1 : E') := one_add_one_eq_two.symm
      rw [h2_E']
      exact hval_add_E' 0 1 1 (Or.inr (le_of_eq hval1_E'.symm)) (Or.inr (le_of_eq hval1_E'.symm))
    have h2x : 2 * x_star = 0 ∨ (t : ℤ) ≤ valL F E' (2 * x_star) := by
      rcases hval_mul_ge_E' h1 (Or.inr (le_of_eq hx_star_val.symm)) with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hx2 : x_star ^ 2 = 0 ∨ (t : ℤ) ≤ valL F E' (x_star ^ 2) := by
      rw [sq]
      rcases hval_mul_ge_E' (Or.inr (le_of_eq hx_star_val.symm))
        (Or.inr (le_of_eq hx_star_val.symm)) with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    exact hval_sub_E' (t : ℤ) (2 * x_star) (x_star ^ 2) h2x hx2
  have hYge1_prod_tr :
      traceLM F hLE' (Y_ge1 * (2 * x_star - x_star ^ 2)) = 0 ∨
        (bE' : ℤ) ≤ valL F L (traceLM F hLE' (Y_ge1 * (2 * x_star - x_star ^ 2))) := by
    apply htr_LE' (bE' : ℤ) (Y_ge1 * (2 * x_star - x_star ^ 2))
    rcases hval_mul_ge_E' hY_ge1_val h2x_val with h0 | hge
    · exact Or.inl h0
    · right
      rw [hp_sub1_int]
      have ht_eq' : (t : ℤ) + 1 = (bE' : ℤ) := by exact_mod_cast ht_eq
      nlinarith
  have hψE'_Yge1 :
      ψE' (IntermediateField.inclusion hLE' α₀ * Y_ge1 * (2 * x_star - x_star ^ 2)) = 1 := by
    rw [hψE'_app, mul_assoc, htr_smul]
    exact hψ_α₀_triv _ hYge1_prod_tr
  have hψ_c₀ : ψ (β * c₀) = 1 := by
    have hsplit : IntermediateField.inclusion hLE' α₀ * Y₁ * (2 * x_star - x_star ^ 2) =
        IntermediateField.inclusion hLE' α₀ *
          IntermediateField.inclusion hLE' c₀ * (2 * x_star - x_star ^ 2) +
        IntermediateField.inclusion hLE' α₀ * Y_ge1 * (2 * x_star - x_star ^ 2) := by
      rw [hY₁_split]; ring
    rw [hsplit, AddChar.map_add_eq_mul, hψE'_incl_L c₀ hc₀_val, hψE'_Yge1, mul_one] at hY₁_char
    exact hY₁_char

  obtain ⟨hj_ne0, hj_val0⟩ := hcop_unit_L j hj_pos hj_lt
  let u_j : Lˣ := Units.mk0 (j : L) hj_ne0
  set b_L : L := -(((u_j⁻¹ : Lˣ) : L) * c₀)
  have hb_L_val : b_L = 0 ∨ 0 ≤ valL F L b_L := by
    have huj_inv : valL F L ((u_j⁻¹ : Lˣ) : L) = 0 := by
      rw [hval_inv_L u_j]
      change - valL F L (j : L) = 0
      rw [hj_val0, neg_zero]
    apply hval_neg_ge_L
    rcases hval_mul_ge_L (Or.inr (le_of_eq huj_inv.symm)) hc₀_val with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (by omega)
  obtain ⟨e₀, s₀, hs₀_val, hδ_bL⟩ := hcoker_L b_L hb_L_val
  have hψ_bL : ψ (β * b_L) = ζ ^ (e₀ : ℕ) :=
    hψ_eval_decomp b_L s₀ e₀ hs₀_val hδ_bL
  have hjb_L : (j : L) * b_L = -c₀ := by
    change (u_j : L) * (-(((u_j⁻¹ : Lˣ) : L) * c₀)) = -c₀
    rw [mul_neg, ← mul_assoc, Units.mul_inv, one_mul]
  have hψ_neg_c₀ : ψ (β * (-c₀)) = 1 := by
    have h0_eq : (0 : L) = β * c₀ + β * (-c₀) := by ring
    have h1 := congrArg ψ h0_eq
    rw [AddChar.map_zero_eq_one, AddChar.map_add_eq_mul, hψ_c₀, one_mul] at h1
    exact h1.symm
  have hζ_je₀ : ζ ^ (j * (e₀ : ℕ)) = 1 := by
    rw [mul_comm j (e₀ : ℕ), pow_mul, ← hψ_bL, ← hψ_nat_mul j b_L, hjb_L, hψ_neg_c₀]
  have he₀_zero : (e₀ : ℕ) = 0 := by
    by_contra he₀_ne0
    have he₀_pos : 0 < (e₀ : ℕ) := Nat.pos_of_ne_zero he₀_ne0
    have he₀_lt : (e₀ : ℕ) < p := e₀.isLt
    have hj_cop : j.Coprime p :=
      (hPrime.coprime_iff_not_dvd.mpr (Nat.not_dvd_of_pos_of_lt hj_pos hj_lt)).symm
    have he₀_cop : (e₀ : ℕ).Coprime p :=
      (hPrime.coprime_iff_not_dvd.mpr (Nat.not_dvd_of_pos_of_lt he₀_pos he₀_lt)).symm
    have hprod_cop : (j * (e₀ : ℕ)).Coprime p := Nat.Coprime.mul_left hj_cop he₀_cop
    set m_cop : ℕ := j * (e₀ : ℕ)
    have hζ_ne0 : ζ ≠ 0 := by
      intro h0
      rw [h0, zero_pow hPrime.ne_zero] at hζ_pow_p
      exact zero_ne_one hζ_pow_p
    let u_ζ : (Ω F)ˣ := Units.mk0 ζ hζ_ne0
    have huζ_m : u_ζ ^ (m_cop : ℤ) = 1 := by
      rw [zpow_natCast]
      exact Units.ext hζ_je₀
    have huζ_p : u_ζ ^ (p : ℤ) = 1 := by
      rw [zpow_natCast]
      exact Units.ext hζ_pow_p
    have hgcd_ab : ((m_cop.gcd p : ℕ) : ℤ) =
        (m_cop : ℤ) * m_cop.gcdA p + (p : ℤ) * m_cop.gcdB p :=
      Nat.gcd_eq_gcd_ab m_cop p
    rw [hprod_cop.gcd_eq_one] at hgcd_ab
    have huζ_1 : u_ζ ^ ((1 : ℕ) : ℤ) = 1 := by
      rw [hgcd_ab, zpow_add, zpow_mul, zpow_mul, huζ_m, huζ_p, one_zpow, one_zpow, mul_one]
    rw [Nat.cast_one, zpow_one] at huζ_1
    exact hζ_ne1 (congrArg Units.val huζ_1)

  rw [he₀_zero, Nat.cast_zero, zero_mul, zero_add] at hδ_bL
  have hc₀_peel : c₀ + (j : L) * (s₀ ^ p - s₀) = 0 ∨
      1 ≤ valL F L (c₀ + (j : L) * (s₀ ^ p - s₀)) := by
    have hid : c₀ + (j : L) * (s₀ ^ p - s₀) = -(j : L) * (b_L - (s₀ ^ p - s₀)) := by
      calc c₀ + (j : L) * (s₀ ^ p - s₀)
        _ = -((j : L) * b_L) + (j : L) * (s₀ ^ p - s₀) := by rw [hjb_L, neg_neg]
        _ = -(j : L) * (b_L - (s₀ ^ p - s₀)) := by ring
    rw [hid]
    have hneg_j : -(j : L) = 0 ∨ 0 ≤ valL F L (-(j : L)) :=
      hval_neg_ge_L (Or.inr (le_of_eq hj_val0.symm))
    rcases hval_mul_ge_L hneg_j hδ_bL with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (by omega)

  let w_zero : E' := IntermediateField.inclusion hLE' s₀
  refine ⟨w_zero, ?_, ?_⟩
  · rcases hs₀_val with rfl | hs₀_ge0
    · left; simp [w_zero]
    · right
      dsimp only [w_zero]
      rw [hval_LE' s₀]
      exact mul_nonneg (by positivity) hs₀_ge0
  · have hpeel_eq : Y₁ + (j : E') * (w_zero ^ p - w_zero) =
        IntermediateField.inclusion hLE' (c₀ + (j : L) * (s₀ ^ p - s₀)) + Y_ge1 := by
      dsimp only [w_zero]
      rw [hY₁_split, map_add, map_mul, map_natCast, map_sub, map_pow]
      ring
    rw [hpeel_eq]
    have hc₀_peel_E' :
        IntermediateField.inclusion hLE' (c₀ + (j : L) * (s₀ ^ p - s₀)) = 0 ∨
          1 ≤ valL F E' (IntermediateField.inclusion hLE' (c₀ + (j : L) * (s₀ ^ p - s₀))) := by
      rcases hc₀_peel with h0 | hge
      · left; rw [h0, map_zero]
      · right
        rw [hval_LE']
        have hp_int_ge2 : (2 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp_ge2
        nlinarith
    exact hval_add_E' 1 _ Y_ge1 hc₀_peel_E' hY_ge1_val

theorem ld_ch12_wild_odd_totally_ramified_neg_and_pos_as_peeling (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    (hLE' : L ≤ E')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (νE' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (h₀ : ℕ) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let bE' := condExp F L νE'
    (∀ (k j : ℕ), 1 ≤ k → k ≤ h₀ → 0 < j → j < p →
      ∀ Y : E', (Y = 0 ∨ -((p * k : ℕ) : ℤ) ≤ valL F E' Y) →
        ∃ w_k : E',
          (w_k = 0 ∨ -(k : ℤ) ≤ valL F E' w_k) ∧
          (Y + (j : E') * (w_k ^ p - w_k) = 0 ∨
            -((p * k : ℕ) : ℤ) + 1 ≤ valL F E' (Y + (j : E') * (w_k ^ p - w_k)))) ∧
    (∀ (j : ℕ), 0 < j → j < p →
      ∀ Y' : E', (Y' = 0 ∨ 1 ≤ valL F E' Y') →
        ∃ w_high : E',
          (w_high = 0 ∨ 1 ≤ valL F E' w_high) ∧
          (Y' + (j : E') * (w_high ^ p - w_high) = 0 ∨
            (bE' : ℤ) ≤ valL F E' (Y' + (j : E') * (w_high ^ p - w_high)))) :=
by
  intro p bE'
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_odd' : p ≠ 2 := by
    change Module.finrank L (IntermediateField.extendScalars hLE') ≠ 2
    rw [hWild]
    exact hp_odd
  have hp_ge3 : 3 ≤ p := by omega
  have hp_int_pos : (0 : ℤ) < (p : ℤ) := Nat.cast_pos.mpr hp_pos
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L,
    hval_inv_L, _, hval_add_L, _, _, _⟩ := ld_valL_and_unitGroup_props F L
  obtain ⟨hval0_E', hval1_E', hval_neg1_E', hval_neg_E', hval_mul_E',
    hval_inv_E', _, hval_add_E', _, _, _⟩ := ld_valL_and_unitGroup_props F E'
  have hRam : condExp F L νE' ≠ 0 := by omega
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨S₁, hS₁⟩ := ld_valL_mod_one_finset F L
    hval0_L hval_neg_L hval_mul_L hval_add_L
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
  obtain ⟨k_L, hField_kL, hFin_kL, resL, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ :=
    ld_valL_residue_field_exists F L
      hval0_L hval1_L hval_neg1_L hval_neg_L hval_mul_L hval_inv_L hval_add_L S₁ hS₁
  letI : Field k_L := hField_kL
  letI : Fintype k_L := hFin_kL
  obtain ⟨_, _, _, _, hval_LE', hfrob_surj, _, _, ϖ_E', ϖ_L, _, hϖ_E', _, hBasis⟩ :=
    ld_wild_total_ramification_and_power_basis F L E' hLE' hPrime νE'
      hνE'_pow hνE'_ne hνE'_ker hνE'_cond hRam hWild
      haddVal1 haddVal_mul halg1
      (ld_valL_and_unitGroup_props F L) (ld_valL_and_unitGroup_props F E')
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj

  
  have hval_le_E' : ∀ {k₁ k₂ : ℤ} {y : E'},
      k₁ ≤ k₂ → (y = 0 ∨ k₂ ≤ valL F E' y) → (y = 0 ∨ k₁ ≤ valL F E' y) := by
    intro k₁ k₂ y hle hy
    rcases hy with rfl | hy
    · exact Or.inl rfl
    · exact Or.inr (hle.trans hy)
  have hval_sub_E' : ∀ (k : ℤ) (a b : E'),
      (a = 0 ∨ k ≤ valL F E' a) → (b = 0 ∨ k ≤ valL F E' b) →
        (a - b = 0 ∨ k ≤ valL F E' (a - b)) := by
    intro k a b ha hb
    have hnb : -b = 0 ∨ k ≤ valL F E' (-b) := by
      rcases hb with rfl | hb
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hval_neg_E']; exact hb)
    simpa [sub_eq_add_neg] using hval_add_E' k a (-b) ha hnb
  have hval_mul_ge_E' : ∀ (k₁ k₂ : ℤ) (a b : E'),
      (a = 0 ∨ k₁ ≤ valL F E' a) → (b = 0 ∨ k₂ ≤ valL F E' b) →
        (a * b = 0 ∨ k₁ + k₂ ≤ valL F E' (a * b)) := by
    intro k₁ k₂ a b ha hb
    by_cases ha0 : a = 0
    · exact Or.inl (by rw [ha0, zero_mul])
    · by_cases hb0 : b = 0
      · exact Or.inl (by rw [hb0, mul_zero])
      · right
        have h1 : k₁ ≤ valL F E' a := ha.resolve_left ha0
        have h2 : k₂ ≤ valL F E' b := hb.resolve_left hb0
        rw [hval_mul_E' a b ha0 hb0]
        omega
  have hval_pow_E'_eq : ∀ (y : E') (n : ℕ), y ≠ 0 → valL F E' (y ^ n) = (n : ℤ) * valL F E' y := by
    intro y n hy
    induction n with
    | zero => simp [hval1_E']
    | succ n ih =>
      rw [pow_succ, hval_mul_E' (y ^ n) y (pow_ne_zero n hy) hy, ih]
      push_cast
      ring
  have hval_pow_ge_E' : ∀ (n : ℕ) (m : ℤ) (y : E'),
      (y = 0 ∨ m ≤ valL F E' y) → (y ^ n = 0 ∨ (n : ℤ) * m ≤ valL F E' (y ^ n)) := by
    intro n m y hy
    induction n with
    | zero =>
      right
      rw [pow_zero, hval1_E']
      simp
    | succ n ih =>
      rw [pow_succ]
      have hmul := hval_mul_ge_E' ((n : ℤ) * m) m (y ^ n) y ih hy
      rcases hmul with h0 | hge
      · exact Or.inl h0
      · right
        have heq : ((n + 1 : ℕ) : ℤ) * m = (n : ℤ) * m + m := by push_cast; ring
        rw [heq]
        exact hge
  have hval_finset_sum_E' : ∀ {ι : Type} (S : Finset ι) (f : ι → E') (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F E' (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F E' (∑ i ∈ S, f i)) := by
    intro ι S f k hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_val := hS a (Finset.mem_insert_self a s)
      have hs_val := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_E' k (f a) (∑ i ∈ s, f i) ha_val hs_val
  have hval_nat_E' : ∀ n : ℕ, (n : E') = 0 ∨ (0 : ℤ) ≤ valL F E' (n : E') := by
    intro n
    induction n with
    | zero => exact Or.inl Nat.cast_zero
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hval_add_E' 0 (n : E') 1 ih (Or.inr (by rw [hval1_E']))
  have hval_inc_ge : ∀ (k : ℤ) (x : L),
      (x = 0 ∨ k ≤ valL F L x) →
        (IntermediateField.inclusion hLE' x = 0 ∨
          (p : ℤ) * k ≤ valL F E' (IntermediateField.inclusion hLE' x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · exact Or.inl (map_zero _)
    · right
      rw [hval_LE' x]
      exact mul_le_mul_of_nonneg_left hx (le_of_lt hp_int_pos)

  
  have hp_valL : (p : L) = 0 ∨ 1 ≤ valL F L (p : L) := by
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hres0 : IsLocalRing.residue 𝒪[F] (p : 𝒪[F]) = 0 := by
      change IsLocalRing.residue 𝒪[F] ((Module.finrank L (IntermediateField.extendScalars hLE') : ℕ) : 𝒪[F]) = 0
      rw [hWild, map_natCast]
      exact CharP.cast_eq_zero 𝓀[F] (EllipticRootNumber.p F)
    have hker : valuation F ((p : 𝒪[F]) : F) < 1 := by
      rwa [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one] at hres0
    have hpF : (p : F) = 0 ∨ 1 ≤ addVal F (p : F) := by
      by_cases hp0 : (p : F) = 0
      · exact Or.inl hp0
      · right
        have hφp : φ (valuation F (p : F)) ≠ 0 :=
          (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hp0)
        have hlt : φ (valuation F (p : F)) < 1 := by
          rw [← map_one φ, map_lt_map_iff φ]
          exact hker
        rw [← WithZero.coe_unzero hφp, ← WithZero.coe_one, WithZero.coe_lt_coe,
          ← Multiplicative.toAdd_lt, toAdd_one] at hlt
        unfold addVal
        rw [dif_neg hp0]
        omega
    have halg_p := halg1 (p : F) hpF
    rwa [map_natCast (algebraMap F L) p] at halg_p
  have hres_nat : ∀ n : ℕ, ((n : L) = 0 ∨ 0 ≤ valL F L (n : L)) ∧ resL (n : L) = (n : k_L) := by
    intro n
    induction n with
    | zero =>
      refine ⟨Or.inl Nat.cast_zero, ?_⟩
      rw [Nat.cast_zero, Nat.cast_zero, hresL_0]
    | succ n ih =>
      have h1 : (1 : L) = 0 ∨ 0 ≤ valL F L 1 := Or.inr (by rw [hval1_L])
      have hval_succ : ((n + 1 : ℕ) : L) = 0 ∨ 0 ≤ valL F L ((n + 1 : ℕ) : L) := by
        rw [Nat.cast_succ]
        exact hval_add_L 0 (n : L) 1 ih.1 h1
      refine ⟨hval_succ, ?_⟩
      rw [Nat.cast_succ, (hresL_ring (n : L) 1 ih.1 h1).1, ih.2, hresL_1, Nat.cast_succ]
  have hp_kL : (p : k_L) = 0 := by
    rw [← (hres_nat p).2]
    exact (hresL_ker (p : L) (hres_nat p).1).mpr hp_valL
  have hj_unit : ∀ j : ℕ, 0 < j → j < p →
      (j : E') ≠ 0 ∧ valL F E' (j : E') = 0 ∧ (j : E')⁻¹ ≠ 0 ∧ valL F E' ((j : E')⁻¹) = 0 := by
    intro j hj_pos hj_lt
    have hcop : Nat.Coprime p j :=
      (Nat.Prime.coprime_iff_not_dvd hPrime).mpr (Nat.not_dvd_of_pos_of_lt hj_pos hj_lt)
    have hbez : ((p.gcd j : ℕ) : k_L) =
        (p : k_L) * (Nat.gcdA p j : k_L) + (j : k_L) * (Nat.gcdB p j : k_L) := by
      have h := congrArg (Int.cast : ℤ → k_L) (Nat.gcd_eq_gcd_ab p j)
      simpa using h
    rw [hcop.gcd_eq_one, Nat.cast_one, hp_kL, zero_mul, zero_add] at hbez
    have hj_kL_ne0 : (j : k_L) ≠ 0 := by
      intro hj0
      rw [hj0, zero_mul] at hbez
      exact one_ne_zero hbez
    have hres_j_ne0 : resL (j : L) ≠ 0 := by
      rw [(hres_nat j).2]
      exact hj_kL_ne0
    have hnot_ker : ¬ ((j : L) = 0 ∨ 1 ≤ valL F L (j : L)) :=
      fun h => hres_j_ne0 ((hresL_ker (j : L) (hres_nat j).1).mpr h)
    have hjL_ne0 : (j : L) ≠ 0 := fun h0 => hnot_ker (Or.inl h0)
    have hjL_ge0 : 0 ≤ valL F L (j : L) := ((hres_nat j).1).resolve_left hjL_ne0
    have hjL_not1 : ¬ (1 ≤ valL F L (j : L)) := fun h1 => hnot_ker (Or.inr h1)
    have hjL_val0 : valL F L (j : L) = 0 := by omega
    have hjE'_eq : (j : E') = IntermediateField.inclusion hLE' (j : L) :=
      (map_natCast (IntermediateField.inclusion hLE') j).symm
    have hjE'_ne0 : (j : E') ≠ 0 := by
      rw [hjE'_eq]
      exact (IntermediateField.inclusion hLE').injective.ne hjL_ne0
    have hjE'_val0 : valL F E' (j : E') = 0 := by
      rw [hjE'_eq, hval_LE' (j : L), hjL_val0, mul_zero]
    let u_j : E'ˣ := Units.mk0 (j : E') hjE'_ne0
    have hjE'_inv_val0 : valL F E' ((j : E')⁻¹) = 0 := by
      have hcoe : ((u_j⁻¹ : E'ˣ) : E') = (j : E')⁻¹ := Units.val_inv_eq_inv_val u_j
      rw [← hcoe, hval_inv_E' u_j]
      change - valL F E' (j : E') = 0
      rw [hjE'_val0, neg_zero]
    exact ⟨hjE'_ne0, hjE'_val0, inv_ne_zero hjE'_ne0, hjE'_inv_val0⟩

  refine ⟨?_, ?_⟩
  · 
    intro k j hk_ge1 _ hj_pos hj_lt Y hY
    obtain ⟨hjE'_ne0, hjE'_val0, hjE'_inv_ne0, hjE'_inv_val0⟩ := hj_unit j hj_pos hj_lt
    let π : E' := (ϖ_E' : E')
    let π_inv : E' := ((ϖ_E'⁻¹ : E'ˣ) : E')
    have hπ_ne0 : π ≠ 0 := Units.ne_zero ϖ_E'
    have hπ_inv_ne0 : π_inv ≠ 0 := Units.ne_zero ϖ_E'⁻¹
    have hπ_mul : π * π_inv = 1 := Units.mul_inv ϖ_E'
    have hπ_val : valL F E' π = 1 := hϖ_E'
    have hπ_inv_val : valL F E' π_inv = -1 := by
      change valL F E' ((ϖ_E'⁻¹ : E'ˣ) : E') = -1
      rw [hval_inv_E' ϖ_E', hϖ_E']
    have hπ_pow_val : ∀ m : ℕ, π ^ m = 0 ∨ (m : ℤ) ≤ valL F E' (π ^ m) := by
      intro m
      right
      rw [hval_pow_E'_eq π m hπ_ne0, hπ_val, mul_one]
    have hπ_inv_pow_val : ∀ m : ℕ, π_inv ^ m = 0 ∨ -(m : ℤ) ≤ valL F E' (π_inv ^ m) := by
      intro m
      right
      rw [hval_pow_E'_eq π_inv m hπ_inv_ne0, hπ_inv_val]
      omega
    let Y₀ : E' := -(j : E')⁻¹ * Y * π ^ (p * k)
    have hY₀_val : Y₀ = 0 ∨ (0 : ℤ) ≤ valL F E' Y₀ := by
      have h1 := hval_mul_ge_E' 0 (-((p * k : ℕ) : ℤ)) (-(j : E')⁻¹) Y
        (Or.inr (by rw [hval_neg_E', hjE'_inv_val0])) hY
      have h2 := hval_mul_ge_E' (0 + -((p * k : ℕ) : ℤ)) ((p * k : ℕ) : ℤ)
        (-(j : E')⁻¹ * Y) (π ^ (p * k)) h1 (hπ_pow_val (p * k))
      simpa [Y₀] using h2
    obtain ⟨c, hY₀_eq, hY₀_iff⟩ := hBasis Y₀
    have hc_all := (hY₀_iff 0).mp hY₀_val
    let i₀ : Fin p := ⟨0, hp_pos⟩
    let c₀ : L := c i₀
    have hc₀_val : c₀ = 0 ∨ (0 : ℤ) ≤ valL F L c₀ := by
      rcases hc_all i₀ with h0 | hge
      · exact Or.inl h0
      · right
        change (0 : ℤ) ≤ (p : ℤ) * valL F L c₀ + (0 : ℤ) at hge
        nlinarith
    have hY_ge1 : Y₀ - IntermediateField.inclusion hLE' c₀ = 0 ∨
        (1 : ℤ) ≤ valL F E' (Y₀ - IntermediateField.inclusion hLE' c₀) := by
      have hsum_split := (Finset.add_sum_erase Finset.univ
        (fun i : Fin p => IntermediateField.inclusion hLE' (c i) * (π ^ (i : ℕ)))
        (Finset.mem_univ i₀)).symm
      have hi₀_term : IntermediateField.inclusion hLE' (c i₀) * (π ^ (i₀ : ℕ)) =
          IntermediateField.inclusion hLE' c₀ := by
        change IntermediateField.inclusion hLE' c₀ * (π ^ 0) = IntermediateField.inclusion hLE' c₀
        rw [pow_zero, mul_one]
      have hsub_eq : Y₀ - IntermediateField.inclusion hLE' c₀ =
          ∑ i ∈ (Finset.univ : Finset (Fin p)).erase i₀,
            IntermediateField.inclusion hLE' (c i) * (π ^ (i : ℕ)) := by
        rw [hY₀_eq, hsum_split, hi₀_term, add_sub_cancel_left]
      rw [hsub_eq]
      apply hval_finset_sum_E' ((Finset.univ : Finset (Fin p)).erase i₀) _ 1
      intro i hi
      have hi_ne : i ≠ i₀ := (Finset.mem_erase.mp hi).1
      have hi_pos : 1 ≤ (i : ℕ) :=
        Nat.pos_of_ne_zero (fun h0 => hi_ne (Fin.ext h0))
      have hi_lt : (i : ℕ) < p := i.2
      rcases hc_all i with hci0 | hci_ge
      · left
        rw [hci0, map_zero, zero_mul]
      · have hci_val_ge0 : (0 : ℤ) ≤ valL F L (c i) := by
          have hi_lt_int : (i : ℤ) < (p : ℤ) := by exact_mod_cast hi_lt
          nlinarith
        have hinc_ci := hval_inc_ge 0 (c i) (Or.inr hci_val_ge0)
        have hmul_ci := hval_mul_ge_E' ((p : ℤ) * 0) (i : ℤ)
          (IntermediateField.inclusion hLE' (c i)) (π ^ (i : ℕ)) hinc_ci (hπ_pow_val (i : ℕ))
        apply hval_le_E' _ hmul_ci
        have hi_pos_int : (1 : ℤ) ≤ (i : ℤ) := by exact_mod_cast hi_pos
        linarith
    obtain ⟨s₀, hs₀_val, hc₀_s₀⟩ := hfrob_surj c₀ hc₀_val
    have hc₀_s₀_E' : IntermediateField.inclusion hLE' c₀ -
        (IntermediateField.inclusion hLE' s₀) ^ p = 0 ∨
        (1 : ℤ) ≤ valL F E' (IntermediateField.inclusion hLE' c₀ -
          (IntermediateField.inclusion hLE' s₀) ^ p) := by
      have hinc := hval_inc_ge 1 (c₀ - s₀ ^ p) hc₀_s₀
      rw [map_sub, map_pow] at hinc
      exact hval_le_E' (by nlinarith) hinc
    have hY₀_s₀ : Y₀ - (IntermediateField.inclusion hLE' s₀) ^ p = 0 ∨
        (1 : ℤ) ≤ valL F E' (Y₀ - (IntermediateField.inclusion hLE' s₀) ^ p) := by
      have h := hval_add_E' 1
        (Y₀ - IntermediateField.inclusion hLE' c₀)
        (IntermediateField.inclusion hLE' c₀ - (IntermediateField.inclusion hLE' s₀) ^ p)
        hY_ge1 hc₀_s₀_E'
      have heq : (Y₀ - IntermediateField.inclusion hLE' c₀) +
          (IntermediateField.inclusion hLE' c₀ - (IntermediateField.inclusion hLE' s₀) ^ p) =
          Y₀ - (IntermediateField.inclusion hLE' s₀) ^ p := by ring
      rwa [heq] at h
    let w_k : E' := IntermediateField.inclusion hLE' s₀ * π_inv ^ k
    have hw_k_val : w_k = 0 ∨ -(k : ℤ) ≤ valL F E' w_k := by
      have hinc_s₀ := hval_inc_ge 0 s₀ hs₀_val
      have h := hval_mul_ge_E' ((p : ℤ) * 0) (-(k : ℤ))
        (IntermediateField.inclusion hLE' s₀) (π_inv ^ k) hinc_s₀ (hπ_inv_pow_val k)
      simpa [w_k] using h
    have hπ_pow_mul : π ^ (p * k) * π_inv ^ (p * k) = 1 := by
      rw [← mul_pow, hπ_mul, one_pow]
    have hj_mul : (j : E') * (j : E')⁻¹ = 1 := mul_inv_cancel₀ hjE'_ne0
    have hY_recover : Y = -(j : E') * Y₀ * π_inv ^ (p * k) := by
      dsimp [Y₀]
      linear_combination -Y * hπ_pow_mul - (Y * π ^ (p * k) * π_inv ^ (p * k)) * hj_mul
    have hwk_pow : w_k ^ p = (IntermediateField.inclusion hLE' s₀) ^ p * π_inv ^ (p * k) := by
      dsimp [w_k]
      rw [mul_pow, ← pow_mul, mul_comm k p]
    have hpeel_eq : Y + (j : E') * (w_k ^ p - w_k) =
        -(j : E') * (Y₀ - (IntermediateField.inclusion hLE' s₀) ^ p) * π_inv ^ (p * k) +
          (-(j : E') * w_k) := by
      rw [hY_recover, hwk_pow]
      ring
    have hterm1 : -(j : E') * (Y₀ - (IntermediateField.inclusion hLE' s₀) ^ p) * π_inv ^ (p * k) = 0 ∨
        -((p * k : ℕ) : ℤ) + 1 ≤
          valL F E' (-(j : E') * (Y₀ - (IntermediateField.inclusion hLE' s₀) ^ p) * π_inv ^ (p * k)) := by
      have h1 := hval_mul_ge_E' 0 1 (-(j : E'))
        (Y₀ - (IntermediateField.inclusion hLE' s₀) ^ p)
        (Or.inr (by rw [hval_neg_E', hjE'_val0])) hY₀_s₀
      have h2 := hval_mul_ge_E' (0 + 1) (-((p * k : ℕ) : ℤ))
        (-(j : E') * (Y₀ - (IntermediateField.inclusion hLE' s₀) ^ p))
        (π_inv ^ (p * k)) h1 (hπ_inv_pow_val (p * k))
      apply hval_le_E' _ h2
      omega
    have hterm2 : -(j : E') * w_k = 0 ∨
        -((p * k : ℕ) : ℤ) + 1 ≤ valL F E' (-(j : E') * w_k) := by
      have h1 := hval_mul_ge_E' 0 (-(k : ℤ)) (-(j : E')) w_k
        (Or.inr (by rw [hval_neg_E', hjE'_val0])) hw_k_val
      apply hval_le_E' _ h1
      have hp_int_ge3 : (3 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp_ge3
      have hk_int_ge1 : (1 : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk_ge1
      push_cast
      nlinarith
    have hpeel_val : Y + (j : E') * (w_k ^ p - w_k) = 0 ∨
        -((p * k : ℕ) : ℤ) + 1 ≤ valL F E' (Y + (j : E') * (w_k ^ p - w_k)) := by
      rw [hpeel_eq]
      exact hval_add_E' (-((p * k : ℕ) : ℤ) + 1) _ _ hterm1 hterm2
    exact ⟨w_k, hw_k_val, hpeel_val⟩
  · 
    intro j hj_pos hj_lt Y' hY'
    obtain ⟨hjE'_ne0, hjE'_val0, hjE'_inv_ne0, hjE'_inv_val0⟩ := hj_unit j hj_pos hj_lt
    have hpos_peel : ∀ m : ℕ, ∃ w : E',
        (w = 0 ∨ (1 : ℤ) ≤ valL F E' w) ∧
        (Y' + (j : E') * (w ^ p - w) = 0 ∨
          ((m + 1 : ℕ) : ℤ) ≤ valL F E' (Y' + (j : E') * (w ^ p - w))) := by
      intro m
      induction m with
      | zero =>
        refine ⟨0, Or.inl rfl, ?_⟩
        rw [zero_pow hp_pos.ne', sub_self, mul_zero, add_zero, Nat.zero_add, Nat.cast_one]
        exact hY'
      | succ m ih =>
        obtain ⟨w, hw, hR⟩ := ih
        set R : E' := Y' + (j : E') * (w ^ p - w)
        set δ : E' := (j : E')⁻¹ * R
        set w' : E' := w + δ
        have hδ_m1 : δ = 0 ∨ ((m + 1 : ℕ) : ℤ) ≤ valL F E' δ := by
          have h := hval_mul_ge_E' 0 ((m + 1 : ℕ) : ℤ) ((j : E')⁻¹) R
            (Or.inr (by rw [hjE'_inv_val0])) hR
          simpa [δ] using h
        have hδ_1 : δ = 0 ∨ (1 : ℤ) ≤ valL F E' δ :=
          hval_le_E' (by omega) hδ_m1
        have hw' : w' = 0 ∨ (1 : ℤ) ≤ valL F E' w' :=
          hval_add_E' 1 w δ hw hδ_1
        have hj_δ : (j : E') * δ = R := mul_inv_cancel_left₀ hjE'_ne0 R
        have hpeel_w' : Y' + (j : E') * (w' ^ p - w') =
            (j : E') * ((w + δ) ^ p - w ^ p) := by
          dsimp [w', R] at hj_δ ⊢
          linear_combination -(hj_δ)
        have hbinom : (w + δ) ^ p - w ^ p =
            ∑ i ∈ Finset.range p, w ^ i * δ ^ (p - i) * (p.choose i : E') := by
          rw [add_pow w δ p, Finset.sum_range_succ, Nat.sub_self, pow_zero,
            Nat.choose_self, Nat.cast_one, mul_one, mul_one, add_sub_cancel_right]
        have hsum_val : (∑ i ∈ Finset.range p, w ^ i * δ ^ (p - i) * (p.choose i : E')) = 0 ∨
            ((m + 1 + 1 : ℕ) : ℤ) ≤
              valL F E' (∑ i ∈ Finset.range p, w ^ i * δ ^ (p - i) * (p.choose i : E')) := by
          apply hval_finset_sum_E' (Finset.range p) _ ((m + 1 + 1 : ℕ) : ℤ)
          intro i hi
          have hi_lt : i < p := Finset.mem_range.mp hi
          have hw_i := hval_pow_ge_E' i 1 w hw
          have hδ_pi := hval_pow_ge_E' (p - i) ((m + 1 : ℕ) : ℤ) δ hδ_m1
          have hch := hval_nat_E' (p.choose i)
          have h12 := hval_mul_ge_E' ((i : ℤ) * 1) (((p - i : ℕ) : ℤ) * ((m + 1 : ℕ) : ℤ))
            (w ^ i) (δ ^ (p - i)) hw_i hδ_pi
          have h123 := hval_mul_ge_E'
            ((i : ℤ) * 1 + ((p - i : ℕ) : ℤ) * ((m + 1 : ℕ) : ℤ)) 0
            (w ^ i * δ ^ (p - i)) (p.choose i : E') h12 hch
          apply hval_le_E' _ h123
          by_cases hi_eq : i = p - 1
          · subst hi_eq
            have hsub1 : p - (p - 1) = 1 := by omega
            rw [hsub1]
            omega
          · have hpi_ge2 : 2 ≤ p - i := by omega
            have hmul_ge : 2 * (m + 1) ≤ (p - i) * (m + 1) :=
              Nat.mul_le_mul_right (m + 1) hpi_ge2
            have hmul_int : (2 : ℤ) * ((m + 1 : ℕ) : ℤ) ≤
                ((p - i : ℕ) : ℤ) * ((m + 1 : ℕ) : ℤ) := by
              exact_mod_cast hmul_ge
            omega
        have hR'_val : Y' + (j : E') * (w' ^ p - w') = 0 ∨
            ((m + 1 + 1 : ℕ) : ℤ) ≤ valL F E' (Y' + (j : E') * (w' ^ p - w')) := by
          rw [hpeel_w', hbinom]
          have h := hval_mul_ge_E' 0 ((m + 1 + 1 : ℕ) : ℤ) (j : E') _
            (Or.inr (by rw [hjE'_val0])) hsum_val
          simpa using h
        exact ⟨w', hw', hR'_val⟩
    obtain ⟨w_high, hw_high, hR_high⟩ := hpos_peel (bE' - 1)
    have hb_eq : bE' - 1 + 1 = bE' := by omega
    rw [hb_eq] at hR_high
    exact ⟨w_high, hw_high, hR_high⟩

theorem ld_ch12_wild_odd_totally_ramified_artin_schreier_shift_char_eval (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    (hLE' : L ≤ E') (hGalLE' : IsGaloisExt F L E') (hAbLE' : IsAbelianExt F hLE')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (νE' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (bM₁' : ℕ) (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ condExp F L νE')
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣ (bM₁' - 1)))
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          (condExp F L νE' : ℤ))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (c_νE' : Lˣ)
    (hc_νE'_val : valL F L (c_νE' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_νE'_stat : ∀ u : L, (u = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) ^ 2 =
          ψ (((c_νE'⁻¹ : Lˣ) : L) * (2 * u - u ^ 2))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let bE' := condExp F L νE'
    let t₁ := bM₁' - 1
    let h₀ := t₁ / p
    let m₂ := bE' + bM₁' - 1
    let d₂ := m₂ / 2
    let α₀ := ((c_νE'⁻¹ : Lˣ) : L)
    let ψE' := traceChar F hLE' ψ
    (∀ w₀ : E', (w₀ = 0 ∨ -(h₀ : ℤ) ≤ valL F E' w₀) →
      ∀ x : E', (x = 0 ∨ (d₂ : ℤ) ≤ valL F E' x) →
        let u_x := normLM F hLE' (1 + x) - 1
        (u_x = 0 ∨ (d₂ : ℤ) ≤ valL F L u_x) ∧
        ψE' (IntermediateField.inclusion hLE' α₀ * (w₀ ^ p - w₀) * (2 * x - x ^ 2)) =
          ψ (α₀ * normLM F hLE' w₀ * (2 * u_x - u_x ^ 2))) ∧
    (∀ (k j : ℕ), 1 ≤ k → k ≤ h₀ → 0 < j → j < p →
      ∀ Y : E', (Y = 0 ∨ -((p * k : ℕ) : ℤ) ≤ valL F E' Y) →
        ∃ w_k : E',
          (w_k = 0 ∨ -(k : ℤ) ≤ valL F E' w_k) ∧
          (Y + (j : E') * (w_k ^ p - w_k) = 0 ∨
            -((p * k : ℕ) : ℤ) + 1 ≤ valL F E' (Y + (j : E') * (w_k ^ p - w_k)))) ∧
    (∀ (j : ℕ), 0 < j → j < p →
      ∀ (σ : E' ≃ₐ[F] E'),
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) →
        (∃ y : E', σ y ≠ y) →
        ∀ (ϖ_E' : E'ˣ), valL F E' (ϖ_E' : E') = 1 →
          let x_star := (σ (ϖ_E' : E')) * ((ϖ_E'⁻¹ : E'ˣ) : E') - 1
          ∀ Y₁ : E', (Y₁ = 0 ∨ 0 ≤ valL F E' Y₁) →
            ψE' (IntermediateField.inclusion hLE' α₀ * Y₁ * (2 * x_star - x_star ^ 2)) = 1 →
            ∃ w_zero : E',
              (w_zero = 0 ∨ 0 ≤ valL F E' w_zero) ∧
              (Y₁ + (j : E') * (w_zero ^ p - w_zero) = 0 ∨
                1 ≤ valL F E' (Y₁ + (j : E') * (w_zero ^ p - w_zero)))) ∧
    (∀ (j : ℕ), 0 < j → j < p →
      ∀ Y' : E', (Y' = 0 ∨ 1 ≤ valL F E' Y') →
        ∃ w_high : E',
          (w_high = 0 ∨ 1 ≤ valL F E' w_high) ∧
          (Y' + (j : E') * (w_high ^ p - w_high) = 0 ∨
            (bE' : ℤ) ≤ valL F E' (Y' + (j : E') * (w_high ^ p - w_high)))) :=
by
  intro p bE' t₁ h₀ m₂ d₂ α₀ ψE'
  have h1 := ld_ch12_wild_odd_totally_ramified_boxed_as_shift_formula F L E' hLE' hGalLE'
    hPrime hWild hp_odd ψ hψ hψE' νE' hνE'_pow hνE'_ne hνE'_ker hνE'_cond
    hbE'_ge2 bM₁' hbM₁'_ge2 hb_le ht₁_ndvd hnE'_eq hval_LE' hval_norm_LE' htr_LE'
    c_νE' hc_νE'_val hc_νE'_stat
  have h2 := ld_ch12_wild_odd_totally_ramified_residue_as_hyperplane_peeling F L E' hLE' hGalLE'
    hPrime hWild hp_odd ψ hψ hψE' νE' hνE'_ker hνE'_cond hbE'_ge2 bM₁' hbM₁'_ge2 hb_le
    hnE'_eq hval_LE' hval_norm_LE' htr_LE' c_νE' hc_νE'_val h1
  have h3 := ld_ch12_wild_odd_totally_ramified_neg_and_pos_as_peeling F L E' hLE'
    hPrime hWild hp_odd νE' hνE'_pow hνE'_ne hνE'_ker hνE'_cond hbE'_ge2 h₀
  exact ⟨h1, h3.1, h2, h3.2⟩

theorem ld_wild_odd_tot_ram_galois_aut_coboundary_and_nondiv_upgrade (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hM₁'K₁ : M₁' ≤ K₁)
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (hdegLE' : Module.finrank L (IntermediateField.extendScalars hLE') = p)
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) = p)
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hp_valE' : ((p : ℕ) : E') = 0 ∨ (1 : ℤ) ≤ valL F E' ((p : ℕ) : E'))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hvalK₁_props : valL F K₁ 0 = 0 ∧ valL F K₁ 1 = 0 ∧ valL F K₁ (-1) = 0 ∧
      (∀ x : K₁, valL F K₁ (-x) = valL F K₁ x) ∧
      (∀ x y : K₁, x ≠ 0 → y ≠ 0 → valL F K₁ (x * y) = valL F K₁ x + valL F K₁ y) ∧
      (∀ u : K₁ˣ, valL F K₁ ((u⁻¹ : K₁ˣ) : K₁) = - valL F K₁ (u : K₁)) ∧
      (∀ m : ℤ, ∃ c : K₁ˣ, valL F K₁ (c : K₁) = m) ∧
      (∀ (k : ℤ) (x y : K₁),
        (x = 0 ∨ k ≤ valL F K₁ x) → (y = 0 ∨ k ≤ valL F K₁ y) →
          (x + y = 0 ∨ k ≤ valL F K₁ (x + y))) ∧
      (∀ u : K₁ˣ, u ∈ unitGroup F K₁ 0 ↔ valL F K₁ (u : K₁) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : K₁ˣ,
        u ∈ unitGroup F K₁ a ↔ ((u : K₁) = 1 ∨ (a : ℤ) ≤ valL F K₁ ((u : K₁) - 1))) ∧
      (∀ (a : ℕ) (u : K₁ˣ), u ∈ unitGroup F K₁ a → valL F K₁ (u : K₁) = 0))
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = (p : ℤ) * valL F L x)
    (hval_M₁'K₁ : ∀ z : M₁', valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) = (p : ℤ) * valL F M₁' z)
    (ψ : AddChar L (Ω F)) (c_νE' : Lˣ)
    (hc_νE'_val : valL F L (c_νE' : L) = (bE' : ℤ) + condExpChar F L ψ)
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (p : ℤ) * condExpChar F L ψ + ((p - 1 : ℕ) : ℤ) * (bE' : ℤ))
    (hψE'_triv : ∀ x : E',
      (x = 0 ∨ -condExpChar F E' (traceChar F hLE' ψ) ≤ valL F E' x) →
      (traceChar F hLE' ψ) x = 1)
    (x₁ : E') (hx₁_ne0 : x₁ ≠ 0)
    (hx₁_val : -(condExpChar F E' (traceChar F hLE' ψ) + 1) ≤ valL F E' x₁)
    (hx₁_ψ : (traceChar F hLE' ψ) x₁ ≠ 1)
    (ϖ_E' : E'ˣ) (hϖ_E' : valL F E' (ϖ_E' : E') = 1)
    (hBasis_E' : ∀ y : E', ∃ c : Fin p → L,
      y = ∑ i : Fin p, IntermediateField.inclusion hLE' (c i) * ((ϖ_E' : E') ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (y = 0 ∨ m ≤ valL F E' y) ↔
          ∀ i : Fin p, c i = 0 ∨ m ≤ (p : ℤ) * valL F L (c i) + (i : ℤ))
    (G_E' : Type u) [Group G_E'] [Fintype G_E'] (act_E' : G_E' → E' → E')
    (hcard_GE' : Fintype.card G_E' = p)
    (hactE'_one : ∀ y : E', act_E' 1 y = y)
    (hactE'_mul : ∀ (σ τ : G_E') (y : E'), act_E' (σ * τ) y = act_E' σ (act_E' τ y))
    (hactE'_ring : ∀ σ : G_E',
      act_E' σ 0 = 0 ∧ act_E' σ 1 = 1 ∧
      (∀ y₁ y₂ : E',
        act_E' σ (y₁ + y₂) = act_E' σ y₁ + act_E' σ y₂ ∧
        act_E' σ (y₁ * y₂) = act_E' σ y₁ * act_E' σ y₂ ∧
        act_E' σ (-y₁) = -act_E' σ y₁))
    (hactE'_incl : ∀ (σ : G_E') (x : L),
      act_E' σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x)
    (hactE'_val : ∀ (σ : G_E') (y : E'), valL F E' (act_E' σ y) = valL F E' y)
    (hactE'_trace : ∀ y : E',
      IntermediateField.inclusion hLE' (traceLM F hLE' y) = ∑ σ : G_E', act_E' σ y)
    (hactE'_norm : ∀ y : E',
      IntermediateField.inclusion hLE' (normLM F hLE' y) = ∏ σ : G_E', act_E' σ y)
    (hjump_E' : ∀ τ : G_E', τ ≠ 1 →
      (ϖ_E' : E') - act_E' τ (ϖ_E' : E') ≠ 0 ∧
      valL F E' ((ϖ_E' : E') - act_E' τ (ϖ_E' : E')) = (bE' : ℤ))
    (hConstApprox_E' : ∀ (w : E') (τ : G_E') (M : ℤ),
      τ ≠ 1 →
      (act_E' τ w - w = 0 ∨ M + ((bE' - 1 : ℕ) : ℤ) ≤ valL F E' (act_E' τ w - w)) →
      ∃ c₀ : L,
        w - IntermediateField.inclusion hLE' c₀ = 0 ∨
          M ≤ valL F E' (w - IntermediateField.inclusion hLE' c₀))
    (ϖ_K₁ : K₁ˣ) (hϖ_K₁ : valL F K₁ (ϖ_K₁ : K₁) = 1)
    (hBasis_K₁ : ∀ w : K₁, ∃ c : Fin p → M₁',
      w = ∑ i : Fin p, IntermediateField.inclusion hM₁'K₁ (c i) * ((ϖ_K₁ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin p, c i = 0 ∨ m ≤ (p : ℤ) * valL F M₁' (c i) + (i : ℤ))
    (hσ_lift_filt : ∀ σ_lift : K₁ ≃ₐ[F] K₁,
      (∀ z : M₁', σ_lift (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hM₁'K₁ z) →
      (∃ w₀ : K₁, σ_lift w₀ ≠ w₀) →
      (Units.map σ_lift.toRingEquiv.toMonoidHom ϖ_K₁) * ϖ_K₁⁻¹ ∈
        unitGroup F K₁ ((2 * bM₁' - 1 + p * (bE' - bM₁')) / 2)) :
    let t₂ := bE' - 1
    let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
    let d₁ := m₁ / 2
    let m₂ := bE' + bM₁' - 1
    let α₀ := ((c_νE'⁻¹ : Lˣ) : L)
    let ψE' := traceChar F hLE' ψ
    (∃ τ₀ : E' ≃ₐ[F] E',
      (∀ x : L, τ₀ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
      ∃ y₀ : E', τ₀ y₀ ≠ y₀) ∧
    (∀ Z : E', (Z = 0 ∨ (bE' : ℤ) ≤ valL F E' Z) →
      ψE' (IntermediateField.inclusion hLE' α₀ * Z) = 1) ∧
    (∀ σ : E' ≃ₐ[F] E',
      (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) →
      (∀ y : E',
        valL F E' (σ y) = valL F E' y ∧
        normLM F hLE' (σ y) = normLM F hLE' y ∧
        ψE' (σ y) = ψE' y) ∧
      (∀ y : E'ˣ,
        let w_y := ((((Units.map σ.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E')) - 1
        (w_y = 0 ∨ (t₂ : ℤ) ≤ valL F E' w_y) ∧
        normLM F hLE' (1 + w_y) - 1 = 0) ∧
      (∀ u ∈ unitGroup F E' bM₁',
        let w_u := ((((Units.map σ.toRingEquiv.toMonoidHom u) * u⁻¹ : E'ˣ) : E')) - 1
        w_u = 0 ∨ (m₂ : ℤ) ≤ valL F E' w_u) ∧
      ((∃ y₀ : E', σ y₀ ≠ y₀) →
        ∀ (r : ℕ), 1 ≤ r → ¬ (p ∣ r) →
          ∀ Y : E', (Y = 0 ∨ -(r : ℤ) ≤ valL F E' Y) →
            ¬ (Y = 0 ∨ -(r : ℤ) + 1 ≤ valL F E' Y) →
            ∃ u₁ ∈ unitGroup F E' r,
              let w₁ := ((((Units.map σ.toRingEquiv.toMonoidHom u₁) * u₁⁻¹ : E'ˣ) : E')) - 1
              ψE' (IntermediateField.inclusion hLE' α₀ * Y * (2 * w₁ - w₁ ^ 2)) ≠ 1 ∧
              (ψE' (IntermediateField.inclusion hLE' α₀ * Y * (2 * w₁ - w₁ ^ 2))) ^ p = 1)) ∧
    (∀ σ_lift : K₁ ≃ₐ[F] K₁,
      (∀ z : M₁', σ_lift (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hM₁'K₁ z) →
      (∀ w : K₁, valL F K₁ (σ_lift w) = valL F K₁ w) →
      ∀ v : K₁ˣ,
        let w_v := ((((Units.map σ_lift.toRingEquiv.toMonoidHom v) * v⁻¹ : K₁ˣ) : K₁)) - 1
        w_v = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ w_v) :=
by
  classical
  intro t₂ m₁ d₁ m₂ α₀ ψE'
  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_gt2 : 2 < p := lt_of_le_of_ne hp_ge2 (Ne.symm hp_odd)
  have hp_sub1_int : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have ht₂_ge1 : 1 ≤ t₂ := by dsimp [t₂]; omega
  have ht₂_add1 : (t₂ : ℤ) + 1 = (bE' : ℤ) := by dsimp [t₂]; omega
  have hd₁_ge1 : 1 ≤ d₁ := by dsimp [d₁, m₁]; omega
  have hm₂_eq : (bM₁' : ℤ) + (t₂ : ℤ) = (m₂ : ℤ) := by dsimp [t₂, m₂]; omega

  
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L,
    hval_surj_L, hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩ := hvalL_props
  obtain ⟨hval0_E', hval1_E', hval_neg1_E', hval_neg_E', hval_mul_E', hval_inv_E',
    hval_surj_E', hval_add_E', hunit0_E', hunit_ge1_E', hunit_val0_E'⟩ := hvalE'_props
  obtain ⟨hval0_K₁, hval1_K₁, hval_neg1_K₁, hval_neg_K₁, hval_mul_K₁, hval_inv_K₁,
    hval_surj_K₁, hval_add_K₁, hunit0_K₁, hunit_ge1_K₁, hunit_val0_K₁⟩ := hvalK₁_props

  have hinj_LE' : Function.Injective (IntermediateField.inclusion hLE') :=
    (IntermediateField.inclusion hLE').injective

  have hval_neg_ge_E' : ∀ (k : ℤ) (y : E'),
      (y = 0 ∨ k ≤ valL F E' y) → (-y = 0 ∨ k ≤ valL F E' (-y)) := by
    intro k y hy
    rcases hy with rfl | hge
    · exact Or.inl neg_zero
    · right
      rwa [hval_neg_E']

  have hval_sub_ge_E' : ∀ (k : ℤ) (y₁ y₂ : E'),
      (y₁ = 0 ∨ k ≤ valL F E' y₁) → (y₂ = 0 ∨ k ≤ valL F E' y₂) →
        (y₁ - y₂ = 0 ∨ k ≤ valL F E' (y₁ - y₂)) := by
    intro k y₁ y₂ hy₁ hy₂
    rw [sub_eq_add_neg]
    exact hval_add_E' k y₁ (-y₂) hy₁ (hval_neg_ge_E' k y₂ hy₂)

  have hval_mul_ge_E' : ∀ (k₁ k₂ : ℤ) (y₁ y₂ : E'),
      (y₁ = 0 ∨ k₁ ≤ valL F E' y₁) → (y₂ = 0 ∨ k₂ ≤ valL F E' y₂) →
        (y₁ * y₂ = 0 ∨ k₁ + k₂ ≤ valL F E' (y₁ * y₂)) := by
    intro k₁ k₂ y₁ y₂ hy₁ hy₂
    by_cases h1 : y₁ = 0
    · exact Or.inl (by rw [h1, zero_mul])
    · by_cases h2 : y₂ = 0
      · exact Or.inl (by rw [h2, mul_zero])
      · right
        rw [hval_mul_E' y₁ y₂ h1 h2]
        have hg1 := hy₁.resolve_left h1
        have hg2 := hy₂.resolve_left h2
        omega

  have hval_finset_sum_E' : ∀ {α : Type} (S : Finset α) (f : α → E') (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F E' (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F E' (∑ i ∈ S, f i)) := by
    intro α S f k hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_val := hS a (Finset.mem_insert_self a s)
      have hs_val := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_E' k (f a) (∑ i ∈ s, f i) ha_val hs_val

  have hval_strict_E' : ∀ (y₁ y₂ : E'),
      y₁ ≠ 0 → (y₂ = 0 ∨ valL F E' y₁ + 1 ≤ valL F E' y₂) →
        y₁ + y₂ ≠ 0 ∧ valL F E' (y₁ + y₂) = valL F E' y₁ := by
    intro y₁ y₂ hy₁ hy₂
    set v₁ : ℤ := valL F E' y₁
    have hy₂_ge : y₂ = 0 ∨ v₁ ≤ valL F E' y₂ := by
      rcases hy₂ with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum_ge : y₁ + y₂ = 0 ∨ v₁ ≤ valL F E' (y₁ + y₂) :=
      hval_add_E' v₁ y₁ y₂ (Or.inr le_rfl) hy₂_ge
    have hnot_gt : ¬ (y₁ + y₂ = 0 ∨ v₁ + 1 ≤ valL F E' (y₁ + y₂)) := by
      intro hgt
      have hneg_y₂ : -y₂ = 0 ∨ v₁ + 1 ≤ valL F E' (-y₂) := by
        rcases hy₂ with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right
          rw [hval_neg_E']
          exact hge
      have hy₁_gt := hval_add_E' (v₁ + 1) (y₁ + y₂) (-y₂) hgt hneg_y₂
      have heq_y₁ : (y₁ + y₂) + (-y₂) = y₁ := by ring
      rw [heq_y₁] at hy₁_gt
      rcases hy₁_gt with h10 | h1ge
      · exact hy₁ h10
      · omega
    have hsum_ne : y₁ + y₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
    have hsum_v₁ : v₁ ≤ valL F E' (y₁ + y₂) := hsum_ge.resolve_left hsum_ne
    have hsum_not1 : ¬ (v₁ + 1 ≤ valL F E' (y₁ + y₂)) := fun h1 => hnot_gt (Or.inr h1)
    exact ⟨hsum_ne, by omega⟩

  have h1_add_ne_zero_E' : ∀ z : E', (z = 0 ∨ (1 : ℤ) ≤ valL F E' z) → 1 + z ≠ 0 := by
    intro z hz
    have hstrict := hval_strict_E' 1 z one_ne_zero (by
      rcases hz with h0 | hge
      · exact Or.inl h0
      · right; rw [hval1_E']; omega)
    exact hstrict.1

  have hval_mul_ge_K₁ : ∀ (k₁ k₂ : ℤ) (w₁ w₂ : K₁),
      (w₁ = 0 ∨ k₁ ≤ valL F K₁ w₁) → (w₂ = 0 ∨ k₂ ≤ valL F K₁ w₂) →
        (w₁ * w₂ = 0 ∨ k₁ + k₂ ≤ valL F K₁ (w₁ * w₂)) := by
    intro k₁ k₂ w₁ w₂ hw₁ hw₂
    by_cases h1 : w₁ = 0
    · exact Or.inl (by rw [h1, zero_mul])
    · by_cases h2 : w₂ = 0
      · exact Or.inl (by rw [h2, mul_zero])
      · right
        rw [hval_mul_K₁ w₁ w₂ h1 h2]
        have hg1 := hw₁.resolve_left h1
        have hg2 := hw₂.resolve_left h2
        omega

  have hval_finset_sum_K₁ : ∀ {α : Type} (S : Finset α) (f : α → K₁) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F K₁ (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F K₁ (∑ i ∈ S, f i)) := by
    intro α S f k hS
    induction S using Finset.induction_on with
    | empty =>
      left
      simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have ha_val := hS a (Finset.mem_insert_self a s)
      have hs_val := ih (fun i hi => hS i (Finset.mem_insert_of_mem hi))
      exact hval_add_K₁ k (f a) (∑ i ∈ s, f i) ha_val hs_val

  set πE' : E' := (ϖ_E' : E')
  have hπE'_ne0 : πE' ≠ 0 := Units.ne_zero ϖ_E'
  have hval_piE'_pow : ∀ k : ℕ, πE' ^ k ≠ 0 ∧ valL F E' (πE' ^ k) = (k : ℤ) := by
    intro k
    induction k with
    | zero =>
      refine ⟨by simp, ?_⟩
      rw [pow_zero, Nat.cast_zero, hval1_E']
    | succ k ih =>
      refine ⟨pow_ne_zero (k + 1) hπE'_ne0, ?_⟩
      rw [pow_succ, hval_mul_E' (πE' ^ k) πE' ih.1 hπE'_ne0, ih.2, hϖ_E']
      push_cast
      ring

  set πK₁ : K₁ := (ϖ_K₁ : K₁)
  have hπK₁_ne0 : πK₁ ≠ 0 := Units.ne_zero ϖ_K₁
  have hval_piK₁_pow : ∀ k : ℕ, πK₁ ^ k ≠ 0 ∧ valL F K₁ (πK₁ ^ k) = (k : ℤ) := by
    intro k
    induction k with
    | zero =>
      refine ⟨by simp, ?_⟩
      rw [pow_zero, Nat.cast_zero, hval1_K₁]
    | succ k ih =>
      refine ⟨pow_ne_zero (k + 1) hπK₁_ne0, ?_⟩
      rw [pow_succ, hval_mul_K₁ (πK₁ ^ k) πK₁ ih.1 hπK₁_ne0, ih.2, hϖ_K₁]
      push_cast
      ring

  
  have hcard_gt1 : 1 < Fintype.card G_E' := by rw [hcard_GE']; exact hp_gt1
  obtain ⟨γ₀, hγ₀⟩ := @Fintype.exists_ne_of_one_lt_card G_E' _ hcard_gt1 1
  let τ₀ : E' ≃ₐ[F] E' :=
    { toFun := act_E' γ₀
      invFun := act_E' γ₀⁻¹
      left_inv := fun y => by rw [← hactE'_mul, inv_mul_cancel, hactE'_one]
      right_inv := fun y => by rw [← hactE'_mul, mul_inv_cancel, hactE'_one]
      map_mul' := fun y₁ y₂ => ((hactE'_ring γ₀).2.2 y₁ y₂).2.1
      map_add' := fun y₁ y₂ => ((hactE'_ring γ₀).2.2 y₁ y₂).1
      commutes' := fun a => by
        change act_E' γ₀ (IntermediateField.inclusion hLE' (algebraMap F L a)) =
          IntermediateField.inclusion hLE' (algebraMap F L a)
        exact hactE'_incl γ₀ (algebraMap F L a) }
  have hτ₀_L : ∀ x : L, τ₀ (IntermediateField.inclusion hLE' x) =
      IntermediateField.inclusion hLE' x :=
    fun x => hactE'_incl γ₀ x
  have hτ₀_ne : τ₀ πE' ≠ πE' := by
    intro heq
    apply (hjump_E' γ₀ hγ₀).1
    change πE' - τ₀ πE' = 0
    rw [heq, sub_self]
  have hConj1 : ∃ τ₀ : E' ≃ₐ[F] E',
      (∀ x : L, τ₀ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) ∧
      ∃ y₀ : E', τ₀ y₀ ≠ y₀ :=
    ⟨τ₀, hτ₀_L, ⟨πE', hτ₀_ne⟩⟩

  
  have hc_νE'_inc_ne0 : IntermediateField.inclusion hLE' (c_νE' : L) ≠ 0 := by
    rw [map_ne_zero_iff _ hinj_LE']
    exact Units.ne_zero c_νE'
  have hc_νE'_inc_val : valL F E' (IntermediateField.inclusion hLE' (c_νE' : L)) =
      (bE' : ℤ) + condExpChar F E' ψE' := by
    rw [hval_LE' (c_νE' : L), hc_νE'_val]
    change (p : ℤ) * ((bE' : ℤ) + condExpChar F L ψ) =
      (bE' : ℤ) + condExpChar F E' (traceChar F hLE' ψ)
    rw [hnE'_eq, hp_sub1_int]
    ring
  have hα₀_inc_ne0 : IntermediateField.inclusion hLE' α₀ ≠ 0 := by
    rw [map_ne_zero_iff _ hinj_LE']
    exact Units.ne_zero (c_νE'⁻¹)
  have hα₀_inc_val : valL F E' (IntermediateField.inclusion hLE' α₀) =
      -(bE' : ℤ) - condExpChar F E' ψE' := by
    rw [hval_LE' α₀]
    change (p : ℤ) * valL F L ((c_νE'⁻¹ : Lˣ) : L) =
      -(bE' : ℤ) - condExpChar F E' (traceChar F hLE' ψ)
    rw [hval_inv_L c_νE', hc_νE'_val, hnE'_eq, hp_sub1_int]
    ring
  have hConj2 : ∀ Z : E', (Z = 0 ∨ (bE' : ℤ) ≤ valL F E' Z) →
      ψE' (IntermediateField.inclusion hLE' α₀ * Z) = 1 := by
    intro Z hZ
    have hmul := hval_mul_ge_E' (-(bE' : ℤ) - condExpChar F E' ψE') (bE' : ℤ)
      (IntermediateField.inclusion hLE' α₀) Z
      (Or.inr (by rw [hα₀_inc_val])) hZ
    apply hψE'_triv (IntermediateField.inclusion hLE' α₀ * Z)
    rcases hmul with h0 | hge
    · exact Or.inl h0
    · right
      change -condExpChar F E' ψE' ≤ valL F E' (IntermediateField.inclusion hLE' α₀ * Z)
      omega

  
  have hact_faithful : ∀ τ : G_E', (∀ y : E', act_E' τ y = y) → τ = 1 := by
    intro τ hτ
    by_contra hne
    apply (hjump_E' τ hne).1
    rw [hτ πE', sub_self]

  let E'' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLE'
  haveI : FiniteDimensional F E'' := ‹FiniteDimensional F E'›
  haveI : IsScalarTower F L E'' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L E'' := Module.Finite.of_restrictScalars_finite F L E''
  let fromExtendScalars : E'' →+* E' :=
    { toFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hLE').mp z.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let φ_act : G_E' → (E' →+* E') := fun γ =>
    { toFun := act_E' γ
      map_one' := (hactE'_ring γ).2.1
      map_mul' := fun y₁ y₂ => ((hactE'_ring γ).2.2 y₁ y₂).2.1
      map_zero' := (hactE'_ring γ).1
      map_add' := fun y₁ y₂ => ((hactE'_ring γ).2.2 y₁ y₂).1 }
  have hφ_act_apply : ∀ (γ : G_E') (y : E'), φ_act γ y = act_E' γ y := fun _ _ => rfl
  let φ_G : G_E' → (E'' →ₐ[L] E'') := fun γ =>
    { (toExtendScalars F hLE').comp ((φ_act γ).comp fromExtendScalars) with
      commutes' := fun x => by
        change toExtendScalars F hLE' (act_E' γ (IntermediateField.inclusion hLE' x)) =
          algebraMap L E'' x
        rw [hactE'_incl γ x]
        rfl }
  have hφG_inj : Function.Injective φ_G := by
    intro γ₁ γ₂ h_eq
    have h1 : γ₁ * γ₂⁻¹ = 1 := by
      apply hact_faithful (γ₁ * γ₂⁻¹)
      intro y
      have h_app : φ_G γ₁ (toExtendScalars F hLE' (act_E' γ₂⁻¹ y)) =
          φ_G γ₂ (toExtendScalars F hLE' (act_E' γ₂⁻¹ y)) :=
        congrArg (fun f : E'' →ₐ[L] E'' => f (toExtendScalars F hLE' (act_E' γ₂⁻¹ y))) h_eq
      have h_from : act_E' γ₁ (act_E' γ₂⁻¹ y) = act_E' γ₂ (act_E' γ₂⁻¹ y) :=
        congrArg fromExtendScalars h_app
      rw [← hactE'_mul, ← hactE'_mul, mul_inv_cancel, hactE'_one] at h_from
      exact h_from
    exact mul_inv_eq_one.mp h1
  have hcard_le1 : Fintype.card G_E' ≤ Fintype.card (E'' →ₐ[L] E'') :=
    Fintype.card_le_of_injective φ_G hφG_inj
  have hcard_le2 : Fintype.card (E'' →ₐ[L] E'') ≤ p := by
    rw [← hdegLE']
    exact @AlgHom.card_le L E'' _ _ _ _
  have hcard_eq : Fintype.card G_E' = Fintype.card (E'' →ₐ[L] E'') := by omega
  have hφG_bij : Function.Bijective φ_G :=
    (Fintype.bijective_iff_injective_and_card φ_G).mpr ⟨hφG_inj, hcard_eq⟩

  have hnorm_act : ∀ (τ : G_E') (y : E'), normLM F hLE' (act_E' τ y) = normLM F hLE' y := by
    intro τ y
    apply hinj_LE'
    rw [hactE'_norm (act_E' τ y), hactE'_norm y]
    have hmul_eq : (∏ ρ : G_E', act_E' ρ (act_E' τ y)) =
        ∏ ρ : G_E', act_E' (ρ * τ) y := by
      refine Finset.prod_congr rfl (fun ρ _ => ?_)
      rw [hactE'_mul]
    rw [hmul_eq]
    exact Equiv.prod_comp (Equiv.mulRight τ) (fun ρ => act_E' ρ y)

  have htr_act : ∀ (τ : G_E') (y : E'), traceLM F hLE' (act_E' τ y) = traceLM F hLE' y := by
    intro τ y
    apply hinj_LE'
    rw [hactE'_trace (act_E' τ y), hactE'_trace y]
    have hmul_eq : (∑ ρ : G_E', act_E' ρ (act_E' τ y)) =
        ∑ ρ : G_E', act_E' (ρ * τ) y := by
      refine Finset.sum_congr rfl (fun ρ _ => ?_)
      rw [hactE'_mul]
    rw [hmul_eq]
    exact Equiv.sum_comp (Equiv.mulRight τ) (fun ρ => act_E' ρ y)

  have hψE'_act : ∀ (τ : G_E') (y : E'), ψE' (act_E' τ y) = ψE' y := by
    intro τ y
    change ψ (traceLM F hLE' (act_E' τ y)) = ψ (traceLM F hLE' y)
    rw [htr_act τ y]

  
  have hact_piE'_diff : ∀ τ : G_E',
      act_E' τ πE' - πE' = 0 ∨ (t₂ + 1 : ℤ) ≤ valL F E' (act_E' τ πE' - πE') := by
    intro τ
    by_cases hτ1 : τ = 1
    · left
      rw [hτ1, hactE'_one πE', sub_self]
    · right
      have hneg : act_E' τ πE' - πE' = -(πE' - act_E' τ πE') := by ring
      rw [hneg, hval_neg_E', (hjump_E' τ hτ1).2, ht₂_add1]

  have hact_piE'_pow_diff : ∀ (τ : G_E') (n : ℕ), 1 ≤ n →
      (act_E' τ πE') ^ n - πE' ^ n = 0 ∨
        (n : ℤ) + (t₂ : ℤ) ≤ valL F E' ((act_E' τ πE') ^ n - πE' ^ n) := by
    intro τ n
    induction n with
    | zero =>
      intro h
      omega
    | succ n ih =>
      intro _
      by_cases hn0 : n = 0
      · subst hn0
        simpa [pow_one, add_comm] using hact_piE'_diff τ
      · have hn1 : 1 ≤ n := Nat.one_le_iff_ne_zero.mpr hn0
        have h_id : (act_E' τ πE') ^ (n + 1) - πE' ^ (n + 1) =
            ((act_E' τ πE') ^ n - πE' ^ n) * act_E' τ πE' +
              πE' ^ n * (act_E' τ πE' - πE') := by
          rw [pow_succ (act_E' τ πE') n, pow_succ πE' n]
          ring
        have hτπ_val : act_E' τ πE' = 0 ∨ (1 : ℤ) ≤ valL F E' (act_E' τ πE') :=
          Or.inr (by rw [hactE'_val τ πE', hϖ_E'])
        have hπn_val : πE' ^ n = 0 ∨ (n : ℤ) ≤ valL F E' (πE' ^ n) :=
          Or.inr (by rw [(hval_piE'_pow n).2])
        have ht1 := hval_mul_ge_E' ((n : ℤ) + (t₂ : ℤ)) 1
          ((act_E' τ πE') ^ n - πE' ^ n) (act_E' τ πE') (ih hn1) hτπ_val
        have ht2 := hval_mul_ge_E' (n : ℤ) (t₂ + 1 : ℤ)
          (πE' ^ n) (act_E' τ πE' - πE') hπn_val (hact_piE'_diff τ)
        have ht1' : ((act_E' τ πE') ^ n - πE' ^ n) * act_E' τ πE' = 0 ∨
            ((n + 1 : ℕ) : ℤ) + (t₂ : ℤ) ≤
              valL F E' (((act_E' τ πE') ^ n - πE' ^ n) * act_E' τ πE') := by
          rcases ht1 with h0 | hge
          · exact Or.inl h0
          · right; push_cast; omega
        have ht2' : πE' ^ n * (act_E' τ πE' - πE') = 0 ∨
            ((n + 1 : ℕ) : ℤ) + (t₂ : ℤ) ≤
              valL F E' (πE' ^ n * (act_E' τ πE' - πE')) := by
          rcases ht2 with h0 | hge
          · exact Or.inl h0
          · right; push_cast; omega
        rw [h_id]
        exact hval_add_E' (((n + 1 : ℕ) : ℤ) + (t₂ : ℤ)) _ _ ht1' ht2'

  have hact_shift_E' : ∀ (τ : G_E') (y : E') (m : ℤ),
      (y = 0 ∨ m ≤ valL F E' y) →
      (act_E' τ y - y = 0 ∨ m + (t₂ : ℤ) ≤ valL F E' (act_E' τ y - y)) := by
    intro τ y m hy
    obtain ⟨c, hy_eq, hval_iff⟩ := hBasis_E' y
    have hc_bound := (hval_iff m).mp hy
    have hact_y_sub : act_E' τ y - y =
        ∑ i : Fin p, IntermediateField.inclusion hLE' (c i) *
          ((act_E' τ πE') ^ (i : ℕ) - πE' ^ (i : ℕ)) := by
      change φ_act τ y - y = _
      rw [hy_eq, map_sum (φ_act τ), ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul (φ_act τ), map_pow (φ_act τ), hφ_act_apply,
        hactE'_incl τ (c i), hφ_act_apply, ← mul_sub]
    rw [hact_y_sub]
    apply hval_finset_sum_E' Finset.univ _ (m + (t₂ : ℤ))
    intro i _
    by_cases hi0 : (i : ℕ) = 0
    · left
      rw [hi0, pow_zero, pow_zero, sub_self, mul_zero]
    · have hi1 : 1 ≤ (i : ℕ) := Nat.one_le_iff_ne_zero.mpr hi0
      rcases hc_bound i with hci0 | hci_ge
      · left
        rw [hci0, map_zero, zero_mul]
      · have hinc_val : IntermediateField.inclusion hLE' (c i) = 0 ∨
            (p : ℤ) * valL F L (c i) ≤
              valL F E' (IntermediateField.inclusion hLE' (c i)) :=
          Or.inr (by rw [hval_LE' (c i)])
        have hdiff_val := hact_piE'_pow_diff τ (i : ℕ) hi1
        have hmul := hval_mul_ge_E' ((p : ℤ) * valL F L (c i)) (((i : ℕ) : ℤ) + (t₂ : ℤ))
          (IntermediateField.inclusion hLE' (c i))
          ((act_E' τ πE') ^ (i : ℕ) - πE' ^ (i : ℕ)) hinc_val hdiff_val
        rcases hmul with h0 | hge
        · exact Or.inl h0
        · right
          change m ≤ (p : ℤ) * valL F L (c i) + ((i : ℕ) : ℤ) at hci_ge
          omega

  
  have hval_natCast_E' : ∀ n : ℕ, (n : E') = 0 ∨ (0 : ℤ) ≤ valL F E' (n : E') := by
    intro n
    induction n with
    | zero => exact Or.inl Nat.cast_zero
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hval_add_E' 0 (n : E') 1 ih (Or.inr (by rw [hval1_E']))

  have hval_intCast_E' : ∀ z : ℤ, (z : E') = 0 ∨ (0 : ℤ) ≤ valL F E' (z : E') := by
    intro z
    cases z with
    | ofNat n =>
      simpa using hval_natCast_E' n
    | negSucc n =>
      rw [Int.cast_negSucc]
      exact hval_neg_ge_E' 0 ((n + 1 : ℕ) : E') (hval_natCast_E' (n + 1))

  have hcoprime_unit_E' : ∀ i : ℕ, 1 ≤ i → i < p → (i : E') ≠ 0 ∧ valL F E' (i : E') = 0 := by
    intro i hi_ge1 hi_lt
    have hcop : Nat.Coprime i p :=
      ((Nat.Prime.coprime_iff_not_dvd hPrime).mpr (Nat.not_dvd_of_pos_of_lt (by omega) hi_lt)).symm
    have hbez : (i : E') * (Nat.gcdA i p : E') =
        (1 : E') + (- (((p : ℕ) : E') * (Nat.gcdB i p : E'))) := by
      have h := congrArg (Int.cast : ℤ → E') (Nat.gcd_eq_gcd_ab i p)
      rw [hcop.gcd_eq_one] at h
      push_cast at h
      linear_combination -h
    have hw₂_ge : - (((p : ℕ) : E') * (Nat.gcdB i p : E')) = 0 ∨
        valL F E' (1 : E') + 1 ≤ valL F E' (- (((p : ℕ) : E') * (Nat.gcdB i p : E'))) := by
      have hmul := hval_mul_ge_E' 1 0 ((p : ℕ) : E') (Nat.gcdB i p : E')
        hp_valE' (hval_intCast_E' (Nat.gcdB i p))
      have hneg := hval_neg_ge_E' (1 + 0) (((p : ℕ) : E') * (Nat.gcdB i p : E')) hmul
      rcases hneg with h0 | hge
      · exact Or.inl h0
      · right
        rw [hval1_E']
        omega
    have hstrict := hval_strict_E' (1 : E') (- (((p : ℕ) : E') * (Nat.gcdB i p : E')))
      one_ne_zero hw₂_ge
    rw [← hbez, hval1_E'] at hstrict
    have hi_ne0 : (i : E') ≠ 0 := left_ne_zero_of_mul hstrict.1
    have ha_ne0 : (Nat.gcdA i p : E') ≠ 0 := right_ne_zero_of_mul hstrict.1
    have hi_ge0 : 0 ≤ valL F E' (i : E') := (hval_natCast_E' i).resolve_left hi_ne0
    have ha_ge0 : 0 ≤ valL F E' (Nat.gcdA i p : E') :=
      (hval_intCast_E' (Nat.gcdA i p)).resolve_left ha_ne0
    have hmul_val := hstrict.2
    rw [hval_mul_E' (i : E') (Nat.gcdA i p : E') hi_ne0 ha_ne0] at hmul_val
    exact ⟨hi_ne0, by omega⟩

  have h2_unit : (2 : E') ≠ 0 ∧ valL F E' (2 : E') = 0 := by
    simpa using hcoprime_unit_E' 2 (by omega) hp_gt2
  have h2_ne0 : (2 : E') ≠ 0 := h2_unit.1
  have h2_val0 : valL F E' (2 : E') = 0 := h2_unit.2

  have hψ_nsmul : ∀ n : ℕ, (ψE' x₁) ^ n = ψE' ((n : E') * x₁) := by
    intro n
    induction n with
    | zero =>
      rw [pow_zero, Nat.cast_zero, zero_mul, AddChar.map_zero_eq_one]
    | succ n ih =>
      rw [pow_succ, ih, Nat.cast_succ, add_mul, one_mul, AddChar.map_add_eq_mul]

  have hψ_pow_p : (ψE' x₁) ^ p = 1 := by
    rw [hψ_nsmul p]
    have hpx₁_val : ((p : ℕ) : E') * x₁ = 0 ∨
        -condExpChar F E' ψE' ≤ valL F E' (((p : ℕ) : E') * x₁) := by
      have hmul := hval_mul_ge_E' 1 (-(condExpChar F E' ψE' + 1))
        ((p : ℕ) : E') x₁ hp_valE' (Or.inr hx₁_val)
      rcases hmul with h0 | hge
      · exact Or.inl h0
      · right; omega
    exact hψE'_triv (((p : ℕ) : E') * x₁) hpx₁_val

  have hConj3 : ∀ σ : E' ≃ₐ[F] E',
      (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) →
      (∀ y : E',
        valL F E' (σ y) = valL F E' y ∧
        normLM F hLE' (σ y) = normLM F hLE' y ∧
        ψE' (σ y) = ψE' y) ∧
      (∀ y : E'ˣ,
        let w_y := ((((Units.map σ.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E')) - 1
        (w_y = 0 ∨ (t₂ : ℤ) ≤ valL F E' w_y) ∧
        normLM F hLE' (1 + w_y) - 1 = 0) ∧
      (∀ u ∈ unitGroup F E' bM₁',
        let w_u := ((((Units.map σ.toRingEquiv.toMonoidHom u) * u⁻¹ : E'ˣ) : E')) - 1
        w_u = 0 ∨ (m₂ : ℤ) ≤ valL F E' w_u) ∧
      ((∃ y₀ : E', σ y₀ ≠ y₀) →
        ∀ (r : ℕ), 1 ≤ r → ¬ (p ∣ r) →
          ∀ Y : E', (Y = 0 ∨ -(r : ℤ) ≤ valL F E' Y) →
            ¬ (Y = 0 ∨ -(r : ℤ) + 1 ≤ valL F E' Y) →
            ∃ u₁ ∈ unitGroup F E' r,
              let w₁ := ((((Units.map σ.toRingEquiv.toMonoidHom u₁) * u₁⁻¹ : E'ˣ) : E')) - 1
              ψE' (IntermediateField.inclusion hLE' α₀ * Y * (2 * w₁ - w₁ ^ 2)) ≠ 1 ∧
              (ψE' (IntermediateField.inclusion hLE' α₀ * Y * (2 * w₁ - w₁ ^ 2))) ^ p = 1) := by
    intro σ hσ_L
    let f_σ : E'' →ₐ[L] E'' :=
      { (toExtendScalars F hLE').comp (σ.toRingEquiv.toRingHom.comp fromExtendScalars) with
        commutes' := fun x => by
          change toExtendScalars F hLE' (σ (IntermediateField.inclusion hLE' x)) =
            algebraMap L E'' x
          rw [hσ_L x]
          rfl }
    obtain ⟨γ, hγ_eq⟩ := hφG_bij.2 f_σ
    have hσ_act : ∀ y : E', σ y = act_E' γ y := by
      intro y
      have h1 : φ_G γ (toExtendScalars F hLE' y) = f_σ (toExtendScalars F hLE' y) :=
        congrArg (fun f : E'' →ₐ[L] E'' => f (toExtendScalars F hLE' y)) hγ_eq
      exact (congrArg fromExtendScalars h1).symm

    
    have hunit_coboundary : ∀ (r : ℕ), 1 ≤ r → ∀ u ∈ unitGroup F E' r,
        let z := (u : E') - 1
        let w_u := ((((Units.map σ.toRingEquiv.toMonoidHom u) * u⁻¹ : E'ˣ) : E')) - 1
        (w_u = 0 ∨ (r : ℤ) + (t₂ : ℤ) ≤ valL F E' w_u) ∧
        (w_u - (σ z - z) = 0 ∨
          2 * (r : ℤ) + (t₂ : ℤ) ≤ valL F E' (w_u - (σ z - z))) := by
      intro r hr u hu
      intro z w_u
      have hz_val : z = 0 ∨ (r : ℤ) ≤ valL F E' z := by
        rcases (hunit_ge1_E' r hr u).mp hu with hu1 | hge
        · left; dsimp [z]; rw [hu1, sub_self]
        · exact Or.inr hge
      have hσz_val : σ z - z = 0 ∨ (r : ℤ) + (t₂ : ℤ) ≤ valL F E' (σ z - z) := by
        rw [hσ_act z]
        exact hact_shift_E' γ z (r : ℤ) hz_val
      have hu_inv_val0 : ((u⁻¹ : E'ˣ) : E') = 0 ∨
          (0 : ℤ) ≤ valL F E' ((u⁻¹ : E'ˣ) : E') := by
        right
        rw [hval_inv_E' u, hunit_val0_E' r u hu, neg_zero]
      have hw_u_eq : w_u = (σ z - z) * ((u⁻¹ : E'ˣ) : E') := by
        change σ (u : E') * ((u⁻¹ : E'ˣ) : E') - 1 = _
        have hu_z : (u : E') = z + 1 := by dsimp [z]; ring
        have hσu : σ (u : E') = σ z + 1 := by rw [hu_z, map_add, map_one]
        have h1 : (1 : E') = (u : E') * ((u⁻¹ : E'ˣ) : E') := (Units.mul_inv u).symm
        calc σ (u : E') * ((u⁻¹ : E'ˣ) : E') - 1
            = σ (u : E') * ((u⁻¹ : E'ˣ) : E') - (u : E') * ((u⁻¹ : E'ˣ) : E') := by rw [← h1]
          _ = (σ (u : E') - (u : E')) * ((u⁻¹ : E'ˣ) : E') := (sub_mul _ _ _).symm
          _ = (σ z - z) * ((u⁻¹ : E'ˣ) : E') := by rw [hσu, hu_z]; ring
      have hw_u_lin : w_u - (σ z - z) = -((σ z - z) * z * ((u⁻¹ : E'ˣ) : E')) := by
        rw [hw_u_eq]
