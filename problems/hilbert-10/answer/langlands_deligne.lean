        have hmul : (u_x₀E : E) * ((u_x₀E⁻¹ : Eˣ) : E) = 1 := Units.mul_inv u_x₀E
        change y₀ = (u_x₀E : E) * (1 + ((u_x₀E⁻¹ : Eˣ) : E) * (y₀ - (u_x₀E : E)))
        linear_combination - (y₀ - (u_x₀E : E)) * hmul
