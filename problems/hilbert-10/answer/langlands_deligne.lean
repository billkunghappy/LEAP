  obtain ⟨k₁, hk₁⟩ :=
    ld_ch14_stickelberger_p_power_assembly F L E hLE hBranch2.1 ψ hψ hψE D_orb hFinFi hψFi
      χ' h_ge2 hχ'_cond μ'_orb hμ'_pow hStatPowEven hStatPowOdd
      ϖ_L hϖ_L ϖ_E hϖ_E c'_χ' c'_χ'E c'_μ c'_θ
      hcond_E hc_L_val hc_L_top hc_E_val hc_E_top hc_orb hNormCong
      k_L k_E resL resE ψ_0L ψ_0E k_Fi resFi ϖ_Fi ψ_0μ ψ_0θ
