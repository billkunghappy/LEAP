        ((1 : ℤ) ≤ valL F M₁' ((pM : ℕ) : M₁') ∧
          (m₁ : ℤ) - 2 * (d₁ : ℤ) ≤ valL F M₁' ((pM : ℕ) : M₁')) := by
    dsimp only
    rw [hdegM₁'K₁]
