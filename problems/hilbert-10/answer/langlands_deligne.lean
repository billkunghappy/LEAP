    have he₀_cop : (e₀ : ℕ).Coprime p :=
      (hPrime.coprime_iff_not_dvd.mpr (Nat.not_dvd_of_pos_of_lt he₀_pos he₀_lt)).symm
    have hζ_ne0 : ζ ≠ 0 := by
      intro h0
      rw [h0, zero_pow hPrime.ne_zero] at hζ_pow_p
      exact zero_ne_one hζ_pow_p
    let u_ζ : (Ω F)ˣ := Units.mk0 ζ hζ_ne0
    have huζ_e₀ : u_ζ ^ ((e₀ : ℕ) : ℤ) = 1 := by
      rw [zpow_natCast]
      exact Units.ext hζ_e₀
    have huζ_p : u_ζ ^ (p : ℤ) = 1 := by
      rw [zpow_natCast]
      exact Units.ext hζ_pow_p
    have hgcd_ab : (((e₀ : ℕ).gcd p : ℕ) : ℤ) =
        ((e₀ : ℕ) : ℤ) * (e₀ : ℕ).gcdA p + (p : ℤ) * (e₀ : ℕ).gcdB p :=
      Nat.gcd_eq_gcd_ab (e₀ : ℕ) p
    rw [he₀_cop.gcd_eq_one] at hgcd_ab
    have huζ_1 : u_ζ ^ ((1 : ℕ) : ℤ) = 1 := by
      rw [hgcd_ab, zpow_add, zpow_mul, zpow_mul, huζ_e₀, huζ_p, one_zpow, one_zpow, mul_one]
    rw [Nat.cast_one, zpow_one] at huζ_1
    exact hζ_ne1 (congrArg Units.val huζ_1)

  rw [he₀_zero, Nat.cast_zero, zero_mul, zero_add] at hδ_c₀
  let w_zero : E' := IntermediateField.inclusion hLE' s₀
  refine ⟨w_zero, ?_, ?_⟩
  · rcases hs₀_val with rfl | hs₀_ge0
    · left; simp [w_zero]
    · right
      dsimp only [w_zero]
      rw [hval_LE' s₀]
      exact mul_nonneg (by positivity) hs₀_ge0
  · have hpeel_eq : Y₁ - (w_zero ^ p - w_zero) =
        IntermediateField.inclusion hLE' (c₀ - (s₀ ^ p - s₀)) + Y_ge1 := by
      dsimp only [w_zero]
      rw [hY₁_split, map_sub, map_sub, map_pow]
      ring
    rw [hpeel_eq]
    have hc₀_peel_E' :
        IntermediateField.inclusion hLE' (c₀ - (s₀ ^ p - s₀)) = 0 ∨
          1 ≤ valL F E' (IntermediateField.inclusion hLE' (c₀ - (s₀ ^ p - s₀))) := by
      rcases hδ_c₀ with h0 | hge
      · left; rw [h0, map_zero]
      · right
        rw [hval_LE']
        have hp_int_ge2 : (2 : ℤ) ≤ (p : ℤ) := by exact_mod_cast hp_ge2
        nlinarith
    exact hval_add_E' 1 _ Y_ge1 hc₀_peel_E' hY_ge1_val

theorem ld_ch12_wild_odd_totally_ramified_one_over_p_as_shift_and_peeling (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    (hLE' : L ≤ E') (hGalLE' : IsGaloisExt F L E')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (νE' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (bM₁' : ℕ) (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ condExp F L νE')
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣ (bM₁' - 1)))
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          (condExp F L νE' : ℤ))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (hNormBridge_E' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let c₂ := (bE' + p - 1) / p
      let P_L := fun u : L => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u ^ j
      let P_E' := fun z : E' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * z ^ j
      (∀ (h : ℕ) (z : E'), (z = 0 ∨ ((c₂ + h : ℕ) : ℤ) ≤ valL F E' z) →
        let u_z := 1 - normLM F hLE' (1 - z)
        (u_z = 0 ∨ (c₂ : ℤ) ≤ valL F L u_z) ∧
        (P_L u_z - (traceLM F hLE' (P_E' z) + normLM F hLE' (P_E' z)) = 0 ∨
          ((bE' + h : ℕ) : ℤ) ≤
            valL F L (P_L u_z - (traceLM F hLE' (P_E' z) + normLM F hLE' (P_E' z))))) ∧
      (∀ c_νE' : Lˣ,
        valL F L (c_νE' : L) = (bE' : ℤ) + condExpChar F L ψ →
        (∀ u : L, (u = 0 ∨ (c₂ : ℤ) ≤ valL F L u) →
          ∀ hu : 1 - u ≠ 0,
            (νE' (Units.mk0 (1 - u) hu) : Ω F) ^ 2 =
              ψ (- 2 * ((c_νE'⁻¹ : Lˣ) : L) * P_L u)) →
        ∀ w : E', (w = 0 ∨ (c₂ : ℤ) ≤ valL F E' w) →
          ψ (- 2 * ((c_νE'⁻¹ : Lˣ) : L) * (traceLM F hLE' w + normLM F hLE' w)) = 1 ∧
          (traceChar F hLE' ψ) (2 * IntermediateField.inclusion hLE' (((c_νE'⁻¹ : Lˣ) : L)) * w) =
            ψ (- 2 * ((c_νE'⁻¹ : Lˣ) : L) * normLM F hLE' w))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let bE' := condExp F L νE'
    let t₁ := bM₁' - 1
    let h₀ := t₁ / p
    let m₂ := bE' + bM₁' - 1
    let q₂ := (m₂ + p - 1) / p
    let c₂ := (bE' + p - 1) / p
    let ψE' := traceChar F hLE' ψ
    ∀ c_νE' : Lˣ,
      valL F L (c_νE' : L) = (bE' : ℤ) + condExpChar F L ψ →
      (∀ u : L, (u = 0 ∨ (c₂ : ℤ) ≤ valL F L u) →
        ∀ hu : 1 - u ≠ 0,
          (νE' (Units.mk0 (1 - u) hu) : Ω F) ^ 2 =
            ψ (- 2 * ((c_νE'⁻¹ : Lˣ) : L) *
              (∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u ^ j))) →
      let α := ((c_νE'⁻¹ : Lˣ) : L)
      let P_L := fun u : L => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u ^ j
      let P_E' := fun x : E' => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : E')⁻¹ * x ^ j
      (∀ w₀ : E', (w₀ = 0 ∨ -(h₀ : ℤ) ≤ valL F E' w₀) →
        ∀ x : E', (x = 0 ∨ (q₂ : ℤ) ≤ valL F E' x) →
          let u_x := 1 - normLM F hLE' (1 - x)
          (u_x = 0 ∨ ((h₀ + c₂ : ℕ) : ℤ) ≤ valL F L u_x) ∧
          ψE' (2 * IntermediateField.inclusion hLE' α * (w₀ ^ p - w₀) * P_E' x) =
            ψ (2 * α * normLM F hLE' w₀ * P_L u_x)) ∧
      (∀ k : ℕ, 1 ≤ k → k ≤ h₀ →
        ∀ Y : E', (Y = 0 ∨ -((p * k : ℕ) : ℤ) ≤ valL F E' Y) →
          ∃ w_k : E',
            (w_k = 0 ∨ -(k : ℤ) ≤ valL F E' w_k) ∧
            (Y - (w_k ^ p - w_k) = 0 ∨
              -((p * k : ℕ) : ℤ) + 1 ≤ valL F E' (Y - (w_k ^ p - w_k)))) ∧
      (∀ (σ : E' ≃ₐ[F] E'),
        (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) →
        (∃ y : E', σ y ≠ y) →
        ∀ (ϖ_E' : E'ˣ), valL F E' (ϖ_E' : E') = 1 →
          let x_star := 1 - (σ (ϖ_E' : E')) * ((ϖ_E'⁻¹ : E'ˣ) : E')
          ∀ Y₁ : E', (Y₁ = 0 ∨ 0 ≤ valL F E' Y₁) →
            ψE' (2 * IntermediateField.inclusion hLE' α * Y₁ * P_E' x_star) = 1 →
            ∃ w_zero : E',
              (w_zero = 0 ∨ 0 ≤ valL F E' w_zero) ∧
              (Y₁ - (w_zero ^ p - w_zero) = 0 ∨
                1 ≤ valL F E' (Y₁ - (w_zero ^ p - w_zero)))) ∧
      (∀ Y' : E', (Y' = 0 ∨ 1 ≤ valL F E' Y') →
        ∃ w_high : E',
          (w_high = 0 ∨ 1 ≤ valL F E' w_high) ∧
          (Y' - (w_high ^ p - w_high) = 0 ∨
            (bE' : ℤ) ≤ valL F E' (Y' - (w_high ^ p - w_high)))) :=
by
  intro p bE' t₁ h₀ m₂ q₂ c₂ ψE' c_νE' hc_νE'_val hc_νE'_log α P_L P_E'
  have hval_neg_E' : ∀ x : E', valL F E' (-x) = valL F E' x :=
    (ld_valL_and_unitGroup_props F E').2.2.2.1
  obtain ⟨hNegPeel, hPosPeel⟩ :=
    ld_ch12_wild_odd_totally_ramified_neg_and_pos_as_peeling F L E' hLE'
      hPrime hWild hp_odd νE' hνE'_pow hνE'_ne hνE'_ker hνE'_cond hbE'_ge2 h₀
  have h1 :=
    ld_ch12_wild_odd_totally_ramified_one_over_p_boxed_as_shift_formula F L E' hLE' hGalLE'
      hPrime hWild hp_odd ψ hψ bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le ht₁_ndvd
      hval_LE' hval_norm_LE' htr_LE' c_νE' hc_νE'_val
      hNormBridge_E'.1 (hNormBridge_E'.2 c_νE' hc_νE'_val hc_νE'_log)
  have h2 : ∀ k : ℕ, 1 ≤ k → k ≤ h₀ →
      ∀ Y : E', (Y = 0 ∨ -((p * k : ℕ) : ℤ) ≤ valL F E' Y) →
        ∃ w_k : E',
          (w_k = 0 ∨ -(k : ℤ) ≤ valL F E' w_k) ∧
          (Y - (w_k ^ p - w_k) = 0 ∨
            -((p * k : ℕ) : ℤ) + 1 ≤ valL F E' (Y - (w_k ^ p - w_k))) := by
    intro k hk1 hkh₀ Y hY
    have hnY : -Y = 0 ∨ -((p * k : ℕ) : ℤ) ≤ valL F E' (-Y) := by
      rcases hY with rfl | hY
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hval_neg_E']; exact hY)
    obtain ⟨w_k, hw_k, hpeel⟩ :=
      hNegPeel k 1 hk1 hkh₀ zero_lt_one hPrime.one_lt (-Y) hnY
    have heq : (-Y) + ((1 : ℕ) : E') * (w_k ^ p - w_k) = -(Y - (w_k ^ p - w_k)) := by
      push_cast; ring
    rw [heq, neg_eq_zero, hval_neg_E'] at hpeel
    exact ⟨w_k, hw_k, hpeel⟩
  have h3 :=
    ld_ch12_wild_odd_totally_ramified_one_over_p_residue_as_hyperplane_peeling F L E' hLE' hGalLE'
      hPrime hWild hp_odd ψ hψ hψE' νE' hνE'_ker hνE'_cond hbE'_ge2 bM₁' hbM₁'_ge2 hb_le
      hnE'_eq hval_LE' hval_norm_LE' htr_LE' c_νE' hc_νE'_val (hNormBridge_E'.1 0) h1
  have h4 : ∀ Y' : E', (Y' = 0 ∨ 1 ≤ valL F E' Y') →
      ∃ w_high : E',
        (w_high = 0 ∨ 1 ≤ valL F E' w_high) ∧
        (Y' - (w_high ^ p - w_high) = 0 ∨
          (bE' : ℤ) ≤ valL F E' (Y' - (w_high ^ p - w_high))) := by
    intro Y' hY'
    have hnY' : -Y' = 0 ∨ 1 ≤ valL F E' (-Y') := by
      rcases hY' with rfl | hY'
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hval_neg_E']; exact hY')
    obtain ⟨w_high, hw_high, hpeel⟩ :=
      hPosPeel 1 zero_lt_one hPrime.one_lt (-Y') hnY'
    have heq : (-Y') + ((1 : ℕ) : E') * (w_high ^ p - w_high) = -(Y' - (w_high ^ p - w_high)) := by
      push_cast; ring
    rw [heq, neg_eq_zero, hval_neg_E'] at hpeel
    exact ⟨w_high, hw_high, hpeel⟩
  exact ⟨h1, h2, h3, h4⟩

theorem ld_ch12_wild_odd_totally_ramified_one_over_p_trunc_log_and_norm_bridge (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    (hLE' : L ≤ E') (hGalLE' : IsGaloisExt F L E') (hAbLE' : IsAbelianExt F hLE')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (νE' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (bM₁' : ℕ) (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ condExp F L νE')
    (ht₁_ndvd : ¬ (Module.finrank L (IntermediateField.extendScalars hLE') ∣ (bM₁' - 1)))
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          (condExp F L νE' : ℤ))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (hLamp4 : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ (θ : Mˣ →* (Ω F)ˣ), 2 ≤ condExp F M θ →
      (∀ u ∈ unitGroup F M (condExp F M θ), θ u = 1) →
      let m := condExp F M θ
      let d := m / 2
      (∃ c_θ : Mˣ,
        valL F M (c_θ : M) = (m : ℤ) + condExpChar F M ψ_M ∧
        ∀ x : M, (x = 0 ∨ (d : ℤ) ≤ valL F M x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
              ψ_M (((c_θ⁻¹ : Mˣ) : M) * (2 * x - x ^ 2))) ∧
      (∀ (c : Mˣ) (η : M),
        valL F M (c : M) = (m : ℤ) + condExpChar F M ψ_M →
        (η = 0 ∨ (d : ℤ) ≤ valL F M η) →
        (∀ x : M, (x = 0 ∨ (d : ℤ) ≤ valL F M x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
              ψ_M (((c⁻¹ : Mˣ) : M) * (1 + η) * (2 * x - x ^ 2))) →
        (tateEps F M θ ψ_M) ^ 4 =
          ((qL F M : Ω F) ^ (4 * condExpChar F M ψ_M + 2 * (m : ℤ))) *
            (θ c : Ω F) ^ 4 *
            (ψ_M (((c⁻¹ : Mˣ) : M) * (2 - η ^ 2))) ^ 2)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let bE' := condExp F L νE'
    let t₁ := bM₁' - 1
    let h₀ := t₁ / p
    let m₂ := bE' + bM₁' - 1
    let q₂ := (m₂ + p - 1) / p
    let c₂ := (bE' + p - 1) / p
    let ψE' := traceChar F hLE' ψ
    (∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
       (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
       ∀ (θ : Mˣ →* (Ω F)ˣ), 2 ≤ condExp F M θ →
       (∀ u ∈ unitGroup F M (condExp F M θ), θ u = 1) →
       let m_M := condExp F M θ
       let q_M := (m_M + p - 1) / p
       let P_M := fun z : M => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : M)⁻¹ * z ^ j
       (∀ x y : M,
         (x = 0 ∨ (q_M : ℤ) ≤ valL F M x) →
         (y = 0 ∨ (q_M : ℤ) ≤ valL F M y) →
         (x + y - x * y = 0 ∨ (q_M : ℤ) ≤ valL F M (x + y - x * y)) ∧
         (P_M x = 0 ∨ (q_M : ℤ) ≤ valL F M (P_M x)) ∧
         (P_M (x + y - x * y) - P_M x - P_M y = 0 ∨
           (m_M : ℤ) ≤ valL F M (P_M (x + y - x * y) - P_M x - P_M y))) ∧
       (∃ c_θ : Mˣ,
         valL F M (c_θ : M) = (m_M : ℤ) + condExpChar F M ψ_M ∧
         ∀ x : M, (x = 0 ∨ (q_M : ℤ) ≤ valL F M x) →
           ∀ hx : 1 - x ≠ 0,
             (θ (Units.mk0 (1 - x) hx) : Ω F) ^ 2 =
               ψ_M (- 2 * ((c_θ⁻¹ : Mˣ) : M) * P_M x))) ∧
    (∀ (A : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F A]
       (hLA : L ≤ A), IsGaloisExt F L A → IsAbelianExt F hLA →
       Module.finrank L (IntermediateField.extendScalars hLA) = p →
       ∀ (ν_A : Lˣ →* (Ω F)ˣ),
       ν_A ^ p = 1 → ν_A ≠ 1 →
       (∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLA)) ↔ ν_A x = 1) →
       (∀ j < p, ∀ u ∈ unitGroup F L (condExp F L (ν_A ^ j)), (ν_A ^ j) u = 1) →
       2 ≤ condExp F L ν_A →
       (∀ x : L, valL F A (IntermediateField.inclusion hLA x) = (p : ℤ) * valL F L x) →
       (∀ y : A, valL F L (normLM F hLA y) = valL F A y) →
       (∀ (m : ℤ) (y : A),
         (y = 0 ∨ (p : ℤ) * m - ((p - 1 : ℕ) : ℤ) * (condExp F L ν_A : ℤ) ≤ valL F A y) →
         (traceLM F hLA y = 0 ∨ m ≤ valL F L (traceLM F hLA y))) →
       let T := condExp F L ν_A
       let q₀ := (T + p - 1) / p
       let P_L := fun u : L => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : L)⁻¹ * u ^ j
       let P_A := fun z : A => ∑ j ∈ Finset.Icc 1 (p - 1), ((j : ℕ) : A)⁻¹ * z ^ j
       (∀ (h : ℕ) (z : A), (z = 0 ∨ ((q₀ + h : ℕ) : ℤ) ≤ valL F A z) →
         let u_z := 1 - normLM F hLA (1 - z)
         (u_z = 0 ∨ (q₀ : ℤ) ≤ valL F L u_z) ∧
         (P_L u_z - (traceLM F hLA (P_A z) + normLM F hLA (P_A z)) = 0 ∨
           ((T + h : ℕ) : ℤ) ≤
             valL F L (P_L u_z - (traceLM F hLA (P_A z) + normLM F hLA (P_A z))))) ∧
       (∀ c_νA : Lˣ,
         valL F L (c_νA : L) = (T : ℤ) + condExpChar F L ψ →
         (∀ u : L, (u = 0 ∨ (q₀ : ℤ) ≤ valL F L u) →
           ∀ hu : 1 - u ≠ 0,
