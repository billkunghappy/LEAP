      let w_K₁ : relWeil F K₁ := e_N n
      have hgw : (g_L : AbsGal F) * (w_K₁ : AbsGal F) * (g_L : AbsGal F)⁻¹ ∈ relWeil F K₁ := by
        change (g : AbsGal F)⁻¹ * (n : AbsGal F) * ((g : AbsGal F)⁻¹)⁻¹ ∈ relWeil F K₁
        rw [inv_inv]
        exact hNorm.conj_mem' (n : W) n.2 g
      have h1 := hInvK₁.2 g_L w_K₁ hgw
      change χK₁ (e_N ⟨g⁻¹ * (n : W) * g, hNorm.conj_mem' (n : W) n.2 g⟩) = χK₁ w_K₁
      have heq : e_N ⟨g⁻¹ * (n : W) * g, hNorm.conj_mem' (n : W) n.2 g⟩ =
          ⟨(g_L : AbsGal F) * (w_K₁ : AbsGal F) * (g_L : AbsGal F)⁻¹, hgw⟩ := by
        apply Subtype.ext
        change (g : AbsGal F)⁻¹ * (n : AbsGal F) * (g : AbsGal F) =
          (g : AbsGal F)⁻¹ * (n : AbsGal F) * ((g : AbsGal F)⁻¹)⁻¹
        rw [inv_inv]
      rw [heq]
      exact h1
    obtain ⟨χU, hχU_ext⟩ := h_cyc_ext W N (Ω F) χ_N h_inv_N
    have hχU_rest : restrictWeilChar F hUK₁ χU = χK₁ := by
      apply MonoidHom.ext
      intro w_K₁
      let n_K₁ : N := ⟨⟨w_K₁.1, relWeil_antitone F hUK₁ w_K₁.2⟩, w_K₁.2⟩
      exact hχU_ext n_K₁
    have hχU_weil : IsWeilRep F U (charRep F U χU) := by
      refine ⟨Module.Finite.equiv (ULift.moduleEquiv (R := Ω F) (M := Ω F)).symm, ?_⟩
      rcases hInvK₁.1.2 with ⟨U₀, hU₀_nhds, hU₀_triv⟩
      have hK₁_nhds : (K₁.fixingSubgroup : Set (AbsGal F)) ∈ nhds (1 : AbsGal F) :=
        (krullTopology_mem_nhds_one_iff F (AlgebraicClosure F)
          (K₁.fixingSubgroup : Set (AbsGal F))).mpr ⟨K₁, inferInstance, Set.Subset.rfl⟩
      refine ⟨U₀ ∩ (K₁.fixingSubgroup : Set (AbsGal F)), Filter.inter_mem hU₀_nhds hK₁_nhds, ?_⟩
      intro w hwU hwI
      let w_K₁ : relWeil F K₁ := ⟨w.1, w.2.1, hwU.2⟩
      have hw_triv : charRep F K₁ χK₁ w_K₁ = 1 := hU₀_triv w_K₁ hwU.1 hwI
      have hχ_eq : χU w = χK₁ w_K₁ := by
        rw [← hχU_rest]
        rfl
      change (χU w : Ω F) • LinearMap.id = 1
      rw [hχ_eq]
      exact hw_triv
    exact ⟨hGalLU, hGalUK₁, hdegUK₁, χU, hχU_weil, hχU_rest⟩
  have hDiamondNorm_all : ∀ (A B : IntermediateField F (AlgebraicClosure F))
      (hLA : L ≤ A) (hLB : L ≤ B) (hAK₁ : A ≤ K₁) (hBK₁ : B ≤ K₁),
      IsGaloisExt F L A → IsGaloisExt F B K₁ →
      Module.finrank L (IntermediateField.extendScalars hLA) = ℓ →
      Module.finrank B (IntermediateField.extendScalars hBK₁) = ℓ →
      A ⊔ B = K₁ →
      ∀ y : Aˣ,
        Units.map (normLM F hBK₁) (Units.map (IntermediateField.inclusion hAK₁).toMonoidHom y) =
          Units.map (IntermediateField.inclusion hLB).toMonoidHom (Units.map (normLM F hLA) y) ∧
        Units.map (normLM F hAK₁) (Units.map (IntermediateField.inclusion hAK₁).toMonoidHom y) =
          y ^ (Module.finrank A (IntermediateField.extendScalars hAK₁)) := by
    intro A B hLA hLB hAK₁ hBK₁ hGalLA hGalBK₁ hdegLA hdegBK₁ h_supAB y
    have hNorm_self : Units.map (normLM F hAK₁)
        (Units.map (IntermediateField.inclusion hAK₁).toMonoidHom y) =
        y ^ (Module.finrank A (IntermediateField.extendScalars hAK₁)) := by
      apply Units.ext
      change normLM F hAK₁ (IntermediateField.inclusion hAK₁ y.1) =
        y.1 ^ (Module.finrank A (IntermediateField.extendScalars hAK₁))
      have h_alg : toExtendScalars F hAK₁ (IntermediateField.inclusion hAK₁ y.1) =
          algebraMap A (IntermediateField.extendScalars hAK₁) y.1 := rfl
      unfold normLM
      rw [MonoidHom.comp_apply, RingHom.toMonoidHom_eq_coe, MonoidHom.coe_coe, h_alg]
      exact Algebra.norm_algebraMap y.1
    let A' := IntermediateField.extendScalars hLA
    let K₁_B := IntermediateField.extendScalars hBK₁
    haveI : FiniteDimensional F A := hFin_sub hAK₁
    haveI : FiniteDimensional F B := hFin_sub hBK₁
    haveI : FiniteDimensional F A' := ‹FiniteDimensional F A›
    haveI : FiniteDimensional F K₁_B := hGalLK₁.2.1
    haveI : FiniteDimensional L A' := Module.Finite.of_restrictScalars_finite F L A'
    haveI : FiniteDimensional B K₁_B := Module.Finite.of_restrictScalars_finite F B K₁_B
    haveI : IsGalois L A' := hIsGalois_of_ext hLA hGalLA
    haveI : Normal L A' := IsGalois.to_normal
    haveI : IsGalois B K₁_B := hIsGalois_of_ext hBK₁ hGalBK₁
    haveI : Normal B K₁_B := IsGalois.to_normal
    haveI : Normal B (AlgebraicClosure F) := Normal.tower_top_of_normal F B (AlgebraicClosure F)
    let G_A := A' ≃ₐ[L] A'
    let G_B := K₁_B ≃ₐ[B] K₁_B
    letI : Fintype G_A := AlgEquiv.fintype L A'
    letI : Fintype G_B := AlgEquiv.fintype B K₁_B
    have hcard_GB_GA : Fintype.card G_B = Fintype.card G_A := by
      rw [← Nat.card_eq_fintype_card, IsGalois.card_aut_eq_finrank B K₁_B, hdegBK₁,
        ← hdegLA, ← IsGalois.card_aut_eq_finrank L A', Nat.card_eq_fintype_card]
    let Φ_BL : B.fixingSubgroup →* G_A :=
      (AlgEquiv.restrictNormalHom A').comp
        ((IntermediateField.fixingSubgroupEquiv L).toMonoidHom.comp
          (Subgroup.inclusion (IntermediateField.fixingSubgroup_le hLB)))
    let Ψ_B : B.fixingSubgroup →* G_B :=
      (AlgEquiv.restrictNormalHom K₁_B).comp
        (IntermediateField.fixingSubgroupEquiv B).toMonoidHom
    have hΦ_apply : ∀ (γ : B.fixingSubgroup) (x : A'),
        ((Φ_BL γ x : A') : AlgebraicClosure F) = γ.1 x.1 := by
      intro γ x
      change ((AlgEquiv.restrictNormalHom A'
        ((IntermediateField.fixingSubgroupEquiv L)
          ⟨γ.1, IntermediateField.fixingSubgroup_le hLB γ.2⟩) x : A') :
          AlgebraicClosure F) = γ.1 x.1
      rw [AlgEquiv.restrictNormalHom_apply]
      rfl
    have hΨ_apply : ∀ (γ : B.fixingSubgroup) (z : K₁_B),
        ((Ψ_B γ z : K₁_B) : AlgebraicClosure F) = γ.1 z.1 := by
      intro γ z
      change ((AlgEquiv.restrictNormalHom K₁_B
        ((IntermediateField.fixingSubgroupEquiv B) γ) z : K₁_B) :
          AlgebraicClosure F) = γ.1 z.1
      rw [AlgEquiv.restrictNormalHom_apply]
      rfl
    have hΨ_surj : Function.Surjective Ψ_B :=
      (AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F)).comp
        (IntermediateField.fixingSubgroupEquiv B).surjective
    choose lift_B hlift_B using hΨ_surj
    let ρ : G_B → G_A := fun τ => Φ_BL (lift_B τ)
    have hfix_sup_AB : A.fixingSubgroup ⊓ B.fixingSubgroup = K₁.fixingSubgroup := by
      rw [← IntermediateField.fixingSubgroup_sup, h_supAB]
    have hρ_inj : Function.Injective ρ := by
      intro τ₁ τ₂ hρ_eq
      let γ : B.fixingSubgroup := (lift_B τ₁)⁻¹ * lift_B τ₂
      have hΦ_γ : Φ_BL γ = 1 := by
        change Φ_BL ((lift_B τ₁)⁻¹ * lift_B τ₂) = 1
        rw [map_mul, map_inv]
        exact inv_mul_eq_one.mpr hρ_eq
      have hγ_A : γ.1 ∈ A.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro a ha
        let x : A' := ⟨a, (IntermediateField.mem_extendScalars hLA).mpr ha⟩
        have hx : Φ_BL γ x = x := by rw [hΦ_γ]; rfl
        have hx_val := congrArg Subtype.val hx
        rwa [hΦ_apply γ x] at hx_val
      have hγ_K₁ : γ.1 ∈ K₁.fixingSubgroup := by
        rw [← hfix_sup_AB]
        exact ⟨hγ_A, γ.2⟩
      have hΨ_γ : Ψ_B γ = 1 := by
        apply AlgEquiv.ext
        intro z
        apply Subtype.ext
        rw [hΨ_apply γ z]
        rw [IntermediateField.mem_fixingSubgroup_iff] at hγ_K₁
        exact hγ_K₁ z.1 ((IntermediateField.mem_extendScalars hBK₁).mp z.2)
      have hΨ_eq : Ψ_B (lift_B τ₁) = Ψ_B (lift_B τ₂) := by
        apply inv_mul_eq_one.mp
        rw [← map_inv, ← map_mul]
        exact hΨ_γ
      rwa [hlift_B τ₁, hlift_B τ₂] at hΨ_eq
    have hρ_bij : Function.Bijective ρ :=
      (Fintype.bijective_iff_injective_and_card ρ).mpr ⟨hρ_inj, hcard_GB_GA⟩
    let y_A : A' := toExtendScalars F hLA y.1
    let y_B : K₁_B := toExtendScalars F hBK₁ (IntermediateField.inclusion hAK₁ y.1)
    have hρ_act : ∀ τ : G_B,
        ((τ y_B : K₁_B) : AlgebraicClosure F) = ((ρ τ y_A : A') : AlgebraicClosure F) := by
      intro τ
      have h1 : ((ρ τ y_A : A') : AlgebraicClosure F) = (lift_B τ).1 y.1.1 :=
        hΦ_apply (lift_B τ) y_A
      have h2 : ((Ψ_B (lift_B τ) y_B : K₁_B) : AlgebraicClosure F) = (lift_B τ).1 y.1.1 :=
        hΨ_apply (lift_B τ) y_B
      rw [hlift_B τ] at h2
      exact h2.trans h1.symm
    have hNorm_B : (normLM F hBK₁ (IntermediateField.inclusion hAK₁ y.1) : AlgebraicClosure F) =
        ∏ τ : G_B, ((τ y_B : K₁_B) : AlgebraicClosure F) := by
      have h1 := congrArg K₁_B.val (Algebra.norm_eq_prod_automorphisms B y_B)
      rw [map_prod] at h1
      exact h1
    have hNorm_A : (normLM F hLA y.1 : AlgebraicClosure F) =
        ∏ σ : G_A, ((σ y_A : A') : AlgebraicClosure F) := by
      have h1 := congrArg A'.val (Algebra.norm_eq_prod_automorphisms L y_A)
      rw [map_prod] at h1
      exact h1
    have hProd_eq : (∏ τ : G_B, ((τ y_B : K₁_B) : AlgebraicClosure F)) =
        ∏ σ : G_A, ((σ y_A : A') : AlgebraicClosure F) :=
      Fintype.prod_bijective ρ hρ_bij _ _ hρ_act
    have hNorm_diamond : Units.map (normLM F hBK₁)
        (Units.map (IntermediateField.inclusion hAK₁).toMonoidHom y) =
        Units.map (IntermediateField.inclusion hLB).toMonoidHom
          (Units.map (normLM F hLA) y) := by
      apply Units.ext
      apply Subtype.ext
      change (normLM F hBK₁ (IntermediateField.inclusion hAK₁ y.1) : AlgebraicClosure F) =
        (normLM F hLA y.1 : AlgebraicClosure F)
      rw [hNorm_B, hNorm_A, hProd_eq]
    exact ⟨hNorm_diamond, hNorm_self⟩
  exact ⟨inferInstance, inferInstance, inferInstance, inferInstance,
    hAbLE, hAbLM₁, hAbEK₁, hAbM₁K₁, hThirdSubfield, hDiamondNorm_all⟩

theorem ld_ch12_prime_galois_monomial_f_elim_and_norm_char (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L A : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F A]
    (hLA : L ≤ A) (hGalLA : IsGaloisExt F L A) (hAbLA : IsAbelianExt F hLA)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLA)))
    (χA : relWeil F A →* (Ω F)ˣ) (hχA_weil : IsWeilRep F A (charRep F A χA))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (f : IntermediateField F (AlgebraicClosure F) → (Ω F)ˣ) (hfL : f L = 1)
    (hfA : ∀ D₀ : List (MonomialTerm F L),
      IsMonomialDecomp F L 0 D₀ → (∀ s ∈ D₀, s.field ≤ A) →
      evalMonomialList F rec (fun _ E' _ => f E') L ψ D₀ = 1) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLA)
    ∃ (μA : relWeil F L →* (Ω F)ˣ) (νA : Lˣ →* (Ω F)ˣ),
      IsWeilRep F L (charRep F L μA) ∧
      restrictWeilChar F hLA μA = 1 ∧
      (∀ w : relWeil F L, (w : AbsGal F) ∈ A.fixingSubgroup ↔ μA w = 1) ∧
      μA ^ ℓ = 1 ∧
      μA ≠ 1 ∧
      (∀ (ν : relWeil F L →* (Ω F)ˣ),
        restrictWeilChar F hLA ν = 1 → ∃ j ∈ Finset.range ℓ, ν = μA ^ j) ∧
      νA = recChar F rec L μA ∧
      (∀ x : Lˣ, νA x = μA (rec.recMap L x)) ∧
      νA ^ ℓ = 1 ∧
      νA ≠ 1 ∧
      (∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLA)) ↔ νA x = 1) ∧
      (∀ j < ℓ, ∀ u ∈ unitGroup F L (condExp F L (νA ^ j)), (νA ^ j) u = 1) ∧
      (evalMonomialTerm F rec (fun _ E' _ => f E') L ψ ⟨1, A, hLA, χA⟩ : Ω F) *
        tateEps F A 1 (traceChar F hLA ψ) =
      tateEps F A (recChar F rec A χA) (traceChar F hLA ψ) *
        (∏ j ∈ Finset.range ℓ, tateEps F L (νA ^ j) ψ) :=
by
  let ℓ := Module.finrank L (IntermediateField.extendScalars hLA)
  haveI : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
  haveI : NeZero ℓ := ⟨hPrime.ne_zero⟩
  let G_L := relWeil F L
  let N_A : Subgroup G_L := (relWeil F A).subgroupOf G_L
  have hNA_iff : ∀ w : G_L, w ∈ N_A ↔ (w : AbsGal F) ∈ A.fixingSubgroup := by
    intro w
    change ((w : AbsGal F) ∈ weilGroup F ∧ (w : AbsGal F) ∈ A.fixingSubgroup) ↔ _
    exact and_iff_right w.2.1
  haveI hNA_norm : N_A.Normal := ⟨by
    intro n hn g
    rw [hNA_iff] at hn ⊢
    exact hGalLA.2.2.1 (g : AbsGal F) g.2.2 (n : AbsGal F) hn⟩
  let Q_A := G_L ⧸ N_A
  let π_A : G_L →* Q_A := QuotientGroup.mk' N_A
  have hπA_surj : Function.Surjective π_A := QuotientGroup.mk'_surjective N_A
  have hπA_eq_one : ∀ w : G_L, π_A w = 1 ↔ w ∈ N_A :=
    fun w => QuotientGroup.eq_one_iff w
  obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
  obtain ⟨hFin_QA, hCard_QA⟩ :=
    ld_relWeil_quotient_card_eq_finrank F hp hFrob L A hLA (hGalLA.2.2.2 hLA)
  haveI : Finite Q_A := hFin_QA
  letI : Fintype Q_A := Fintype.ofFinite Q_A
  have hdvd_QA : ℓ ∣ Nat.card Q_A := dvd_of_eq hCard_QA.symm
  obtain ⟨σ₀, hσ₀_ord⟩ := exists_prime_orderOf_dvd_card' (G := Q_A) ℓ hdvd_QA
  have h_pow_eq_iff : ∀ k₁ k₂ : ℕ, k₂ ≤ k₁ → σ₀ ^ k₁ = σ₀ ^ k₂ → ℓ ∣ (k₁ - k₂) := by
    intro k₁ k₂ hle heq
    have hd : σ₀ ^ (k₁ - k₂) = 1 := by
      apply mul_right_cancel (b := σ₀ ^ k₂)
      rw [← pow_add, Nat.sub_add_cancel hle, one_mul, heq]
    rw [← hσ₀_ord]
    exact orderOf_dvd_iff_pow_eq_one.mpr hd
  let f_pow : Fin ℓ → Q_A := fun k => σ₀ ^ k.1
  have hf_pow_inj : Function.Injective f_pow := by
    intro k₁ k₂ heq
    ext
    rcases le_total k₂.1 k₁.1 with hle | hle
    · have hdvd := h_pow_eq_iff k₁.1 k₂.1 hle heq
      have hlt : k₁.1 - k₂.1 < ℓ := Nat.lt_of_le_of_lt (Nat.sub_le k₁.1 k₂.1) k₁.2
      have hsub0 : k₁.1 - k₂.1 = 0 := Nat.eq_zero_of_dvd_of_lt hdvd hlt
      omega
    · have hdvd := h_pow_eq_iff k₂.1 k₁.1 hle heq.symm
      have hlt : k₂.1 - k₁.1 < ℓ := Nat.lt_of_le_of_lt (Nat.sub_le k₂.1 k₁.1) k₂.2
      have hsub0 : k₂.1 - k₁.1 = 0 := Nat.eq_zero_of_dvd_of_lt hdvd hlt
      omega
  have hf_pow_bij : Function.Bijective f_pow := by
    rw [Fintype.bijective_iff_injective_and_card]
    refine ⟨hf_pow_inj, ?_⟩
    rw [Fintype.card_fin, ← Nat.card_eq_fintype_card, hCard_QA]
  choose kg hkg using hf_pow_bij.2
  have hkg' : ∀ b : Q_A, σ₀ ^ (kg b).1 = b := hkg
  have hdeg_pos : 0 < (Polynomial.cyclotomic ℓ (Ω F)).degree :=
    Polynomial.degree_cyclotomic_pos ℓ (Ω F) hPrime.pos
  obtain ⟨ζ₀, hζ₀_root⟩ :=
    IsAlgClosed.exists_root (Polynomial.cyclotomic ℓ (Ω F)) (ne_of_gt hdeg_pos)
  have hζ₀ : IsPrimitiveRoot ζ₀ ℓ :=
    (Polynomial.isRoot_cyclotomic_iff_charZero hPrime.pos).mp hζ₀_root
  have hζ₀_ne : ζ₀ ≠ 0 := hζ₀.ne_zero hPrime.ne_zero
  let ζ : (Ω F)ˣ := Units.mk0 ζ₀ hζ₀_ne
  have hζ_pow_ℓ : ζ ^ ℓ = 1 := by
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, Units.val_one]
    exact hζ₀.pow_eq_one
  have hζ_ne_one : ζ ≠ 1 := by
    intro h1
    exact hζ₀.ne_one hPrime.one_lt (congrArg Units.val h1)
  have hζ_indep_le : ∀ k₁ k₂ : ℕ, k₂ ≤ k₁ → σ₀ ^ k₁ = σ₀ ^ k₂ → ζ ^ k₁ = ζ ^ k₂ := by
    intro k₁ k₂ hle heq
    obtain ⟨m, hm⟩ := h_pow_eq_iff k₁ k₂ hle heq
    have hk₁ : k₁ = k₂ + ℓ * m := by omega
    rw [hk₁, pow_add, pow_mul, hζ_pow_ℓ, one_pow, mul_one]
  have hζ_indep : ∀ k₁ k₂ : ℕ, σ₀ ^ k₁ = σ₀ ^ k₂ → ζ ^ k₁ = ζ ^ k₂ := by
    intro k₁ k₂ heq
    rcases le_total k₂ k₁ with hle | hle
    · exact hζ_indep_le k₁ k₂ hle heq
    · exact (hζ_indep_le k₂ k₁ hle heq.symm).symm
  have h_eval_bar : ∀ (b : Q_A) (k : ℕ), σ₀ ^ k = b → ζ ^ (kg b).1 = ζ ^ k :=
    fun b k hk => hζ_indep (kg b).1 k ((hkg' b).trans hk.symm)
  let bar_μA : Q_A →* (Ω F)ˣ :=
    { toFun := fun b => ζ ^ (kg b).1
      map_one' := by rw [h_eval_bar 1 0 (pow_zero σ₀), pow_zero]
      map_mul' := fun b₁ b₂ => by
        have hmul : σ₀ ^ ((kg b₁).1 + (kg b₂).1) = b₁ * b₂ := by
          rw [pow_add, hkg' b₁, hkg' b₂]
        rw [h_eval_bar (b₁ * b₂) ((kg b₁).1 + (kg b₂).1) hmul, pow_add] }
  let μA : G_L →* (Ω F)ˣ := bar_μA.comp π_A
  obtain ⟨g₀, hg₀_π⟩ := hπA_surj σ₀
  have hμA_g₀ : μA g₀ = ζ := by
    change ζ ^ (kg (π_A g₀)).1 = ζ
    rw [hg₀_π, h_eval_bar σ₀ 1 (pow_one σ₀), pow_one]
  have hμA_weil : IsWeilRep F L (charRep F L μA) := by
    refine ⟨Module.Finite.equiv (ULift.moduleEquiv (R := Ω F) (M := Ω F)).symm, ?_⟩
    let U : Set (AbsGal F) := (A.fixingSubgroup : Set (AbsGal F))
    have hU_nhds : U ∈ nhds (1 : AbsGal F) :=
      (krullTopology_mem_nhds_one_iff F (AlgebraicClosure F) U).mpr
        ⟨A, inferInstance, Set.Subset.rfl⟩
    refine ⟨U, hU_nhds, fun w hwU _ => ?_⟩
    have hwA : w ∈ N_A := (hNA_iff w).mpr hwU
    have hπw : π_A w = 1 := (hπA_eq_one w).mpr hwA
    have hμw : μA w = 1 := by
      change bar_μA (π_A w) = 1
      rw [hπw, map_one]
    change (μA w : Ω F) • LinearMap.id = 1
    rw [hμw, Units.val_one, one_smul]
    rfl
  have hμA_rest : restrictWeilChar F hLA μA = 1 := by
    apply MonoidHom.ext
    intro w
    let w_L : G_L := Subgroup.inclusion (relWeil_antitone F hLA) w
    have hwA : w_L ∈ N_A := w.2
    have hπw : π_A w_L = 1 := (hπA_eq_one w_L).mpr hwA
    change bar_μA (π_A w_L) = 1
    rw [hπw, map_one]
  have hbar_μA_ne_one : ∀ b : Q_A, b ≠ 1 → (bar_μA b : Ω F) ≠ 1 := by
    intro b hb h1
    change ((ζ ^ (kg b).1 : (Ω F)ˣ) : Ω F) = 1 at h1
    rw [Units.val_pow_eq_pow_val] at h1
    have h_pow_eq : ζ₀ ^ (kg b).1 = ζ₀ ^ 0 := by rw [pow_zero]; exact h1
    have hk_zero : (kg b).1 = 0 :=
