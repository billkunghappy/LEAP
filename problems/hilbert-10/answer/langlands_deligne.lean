theorem ld_ch12_wild_dyadic_odd_max_break_two_val_and_base_generators (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_odd : condExp F L νE' % 2 = 1)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hval_normE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_normM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (ϖ_E' : E'ˣ)
    (hϖ_E' : valL F E' (ϖ_E' : E') = 1)
    (hBasis_E' : ∀ y : E', ∃ c : Fin 2 → L,
      y = ∑ i : Fin 2, IntermediateField.inclusion hLE' (c i) * ((ϖ_E' : E') ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F E' y) ↔
          ∀ i : Fin 2, c i = 0 ∨ m ≤ 2 * valL F L (c i) + (i : ℤ))
    (htr_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨ 2 * m - (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (htr_surj_E' : ∀ x : L, ∃ y_x : E',
      traceLM F hLE' y_x = x ∧
      (x = 0 → y_x = 0) ∧
      (x ≠ 0 → y_x ≠ 0 ∧ valL F E' y_x = 2 * valL F L x + 1 - (condExp F L νE' : ℤ)))
    (htr_surj_M₁' : ∀ x : L, ∃ z_x : M₁',
      traceLM F hLM₁' z_x = x ∧
      (x = 0 → z_x = 0) ∧
      (x ≠ 0 → z_x ≠ 0 ∧ valL F M₁' z_x = 2 * valL F L x + 1 - (condExp F L νM₁' : ℤ)))
    (τ₁ : M₁' ≃ₐ[F] M₁') (σ₂ : E' ≃ₐ[F] E')
    (hτ₁_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) = z + τ₁ z)
    (hτ₁_norm : ∀ z : M₁', IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) = z * τ₁ z)
    (hσ₂_tr : ∀ y : E', IntermediateField.inclusion hLE' (traceLM F hLE' y) = y + σ₂ y)
    (hσ₂_norm : ∀ y : E', IntermediateField.inclusion hLE' (normLM F hLE' y) = y * σ₂ y) :
    let a := condExp F L νM₁' / 2
    let e := condExp F L νE' / 2
    ∃ (h2_ne : (2 : L) ≠ 0) (x₀ : M₁') (R₀ : E') (f₀ ρ₀ : L),
      valL F L (2 : L) = (e : ℤ) ∧
      x₀ ≠ 0 ∧ R₀ ≠ 0 ∧ f₀ ≠ 0 ∧ ρ₀ ≠ 0 ∧
      valL F M₁' x₀ = (1 - 2 * (a : ℤ)) ∧
      valL F L f₀ = (1 - 2 * (a : ℤ)) ∧
      valL F E' R₀ = 1 ∧
      valL F L ρ₀ = 1 ∧
      traceLM F hLM₁' x₀ = -1 ∧
      normLM F hLM₁' x₀ = -f₀ ∧
      x₀ ^ 2 + x₀ = IntermediateField.inclusion hLM₁' f₀ ∧
      τ₁ x₀ = -1 - x₀ ∧
      traceLM F hLE' R₀ = 0 ∧
      normLM F hLE' R₀ = -ρ₀ ∧
      R₀ ^ 2 = IntermediateField.inclusion hLE' ρ₀ ∧
      σ₂ R₀ = -R₀ :=
by
  dsimp only
  set a : ℕ := condExp F L νM₁' / 2
  set e : ℕ := condExp F L νE' / 2
  have ha_ge1 : 1 ≤ a := by omega
  have he_ge1 : 1 ≤ e := by omega
  have hae_le : a ≤ e := by omega
  have hT1_eq : condExp F L νM₁' = 2 * a := by omega
  have hT2_eq : condExp F L νE' = 2 * e + 1 := by omega
  rcases hvalL_props with ⟨hvalL0, hvalL1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv,
    hvalL_surj, hvalL_add, _⟩
  rcases hvalE'_props with ⟨hvalE'0, hvalE'1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv,
