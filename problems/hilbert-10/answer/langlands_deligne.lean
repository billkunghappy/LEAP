  have hPE2_expand :
      P_E ^ 2 =
        IntermediateField.inclusion hLE' (a ^ 3 * A - 2 * a * b * A) +
          IntermediateField.inclusion hLE' (a ^ 2 * A - a ^ 3 * b + 2 * a * b ^ 2) * x +
          IntermediateField.inclusion hLE' (a ^ 4 - 3 * a ^ 2 * b + b ^ 2) * x ^ 2 := by
    dsimp only [P_E]
    simp only [map_sub, map_add, map_mul, map_pow, map_ofNat]
    linear_combination (norm := ring)
      (IntermediateField.inclusion hLE' a ^ 2 * x +
        IntermediateField.inclusion hLE' a ^ 3 -
        2 * IntermediateField.inclusion hLE' a * IntermediateField.inclusion hLE' b) * hx3_zero
  have htr_PE2 :
      traceLM F hLE' (P_E ^ 2) =
        3 * (a ^ 3 * A - 2 * a * b * A) +
          (a ^ 2 * A - a ^ 3 * b + 2 * a * b ^ 2) * traceLM F hLE' x +
          (a ^ 4 - 3 * a ^ 2 * b + b ^ 2) * traceLM F hLE' (x ^ 2) := by
    rw [hPE2_expand, map_add, map_add, htr_incl_E', htr_smul_E', htr_smul_E']
  have htr_x : traceLM F hLE' x = a := (hs1 x).symm
  have htr_x2 : traceLM F hLE' (x ^ 2) = a ^ 2 - 2 * b := by
    have h2 : 2 * b = (traceLM F hLE' x) ^ 2 - traceLM F hLE' (x ^ 2) := hs2 x
    rw [htr_x] at h2
    linear_combination (norm := ring) h2
  have hA_inv_mul : A⁻¹ * A = 1 := inv_mul_cancel₀ hA_ne
  have ha_mul_inv : A * A⁻¹ = 1 := mul_inv_cancel₀ hA_ne
  have hcubic_L :
      2 * (3 * a - a ^ 3 + 3 * a * b) - 2 * A⁻¹ * b ^ 2 + A⁻¹ * traceLM F hLE' (P_E ^ 2) =
        2 * (3 * a + a ^ 3) - 2 * A⁻¹ * (b ^ 2 + b ^ 3) +
          A⁻¹ * a ^ 2 * (a ^ 2 - 3 * b) ^ 2 := by
    rw [htr_PE2, htr_x, htr_x2]
    linear_combination (norm := ring) (4 * a ^ 3 - 6 * a * b) * hA_inv_mul
  set R_cub : L :=
    (Q_E - A⁻¹ * traceLM F hLE' (P_E ^ 2)) + A⁻¹ * a ^ 2 * (a ^ 2 - 3 * b) ^ 2
  have hR_cub_val : R_cub = 0 ∨ (T : ℤ) ≤ valL F L R_cub := by
    have ha2_val2 : a ^ 2 = 0 ∨ 2 ≤ valL F L (a ^ 2) := by
      have hmul := val_mul_ge ha_val1 ha_val1
      rw [← sq] at hmul
      exact val_mono (by omega) hmul
    have ha2_val1 : a ^ 2 = 0 ∨ 1 ≤ valL F L (a ^ 2) :=
      val_mono (by omega) ha2_val2
    have h3_val1 : (3 : L) = 0 ∨ 1 ≤ valL F L (3 : L) := by
      have hpv := hp_val
      rw [hp3, Nat.cast_ofNat] at hpv
      exact val_mono (by omega) hpv
    have h3b_val1 : 3 * b = 0 ∨ 1 ≤ valL F L (3 * b) :=
      val_mono (by omega) (val_mul_ge h3_val1 hb_int)
    have hdiff_val1 : a ^ 2 - 3 * b = 0 ∨ 1 ≤ valL F L (a ^ 2 - 3 * b) :=
      val_sub_ge ha2_val1 h3b_val1
    have hdiff2_val2 : (a ^ 2 - 3 * b) ^ 2 = 0 ∨ 2 ≤ valL F L ((a ^ 2 - 3 * b) ^ 2) := by
      have hmul := val_mul_ge hdiff_val1 hdiff_val1
      rw [← sq] at hmul
      exact val_mono (by omega) hmul
    have hm1 := val_mul_ge hA_inv_val ha2_val2
    have hm2 := val_mul_ge hm1 hdiff2_val2
    have hrem_T : A⁻¹ * a ^ 2 * (a ^ 2 - 3 * b) ^ 2 = 0 ∨
        (T : ℤ) ≤ valL F L (A⁻¹ * a ^ 2 * (a ^ 2 - 3 * b) ^ 2) :=
      val_mono (by omega) hm2
    exact val_add_ge hQE_approx hrem_T
  have hψ_R : ψ (((c_ν⁻¹ : Lˣ) : L) * R_cub) = 1 :=
    hψ_triv_T R_cub hR_cub_val
  set w₁ : E' := IntermediateField.inclusion hLE' a
  have hψ_w1 : ψ (((c_ν⁻¹ : Lˣ) : L) * (2 * (3 * a + a ^ 3))) = 1 := by
    have hw1 := hc_ν_tr_norm w₁ ha_E'_half
    rw [htr_incl_E' a, hnorm_incl_E' a,
      show 2 * (3 * a) + 2 * a ^ 3 = 2 * (3 * a + a ^ 3) by ring] at hw1
    exact hw1
  set w₂ : E' := IntermediateField.inclusion hLE' b * x⁻¹
  have hw2_half : w₂ = 0 ∨ ((T / 2 : ℕ) : ℤ) ≤ valL F E' w₂ := by
    have hmul := val_mul_ge hb_E'_int hx_inv_val
    exact val_mono (by omega) hmul
  have hsp1_eq : b = A * traceLM F hLE' (x⁻¹) := by
    have h := hsp1 x hx_ne
    change s x (p - 1) = A * traceLM F hLE' (x⁻¹) at h
    rw [hp3] at h
    exact h
  have htr_w2 : traceLM F hLE' w₂ = A⁻¹ * b ^ 2 := by
    dsimp only [w₂]
    rw [htr_smul_E' b (x⁻¹)]
    linear_combination (norm := ring)
      - (b * traceLM F hLE' (x⁻¹)) * ha_mul_inv - A⁻¹ * b * hsp1_eq
  have h_norm_inv : A * normLM F hLE' (x⁻¹) = 1 := by
    dsimp only [A]
    rw [← map_mul, mul_inv_cancel₀ hx_ne, map_one]
  have hnorm_w2 : normLM F hLE' w₂ = A⁻¹ * b ^ 3 := by
    dsimp only [w₂]
    rw [map_mul, hnorm_incl_E' b]
    linear_combination (norm := ring)
      A⁻¹ * b ^ 3 * h_norm_inv - b ^ 3 * normLM F hLE' (x⁻¹) * ha_mul_inv
  have hψ_w2 : ψ (((c_ν⁻¹ : Lˣ) : L) * (2 * A⁻¹ * (b ^ 2 + b ^ 3))) = 1 := by
    have hw2 := hc_ν_tr_norm w₂ hw2_half
    rw [htr_w2, hnorm_w2,
      show 2 * (A⁻¹ * b ^ 2) + 2 * (A⁻¹ * b ^ 3) = 2 * A⁻¹ * (b ^ 2 + b ^ 3) by ring] at hw2
    exact hw2
  have h_arg_split :
      ((c_ν⁻¹ : Lˣ) : L) * (2 * (3 * a - a ^ 3 + 3 * a * b) - 2 * A⁻¹ * b ^ 2 + Q_E) =
        ((c_ν⁻¹ : Lˣ) : L) * (2 * (3 * a + a ^ 3)) +
          (- (((c_ν⁻¹ : Lˣ) : L) * (2 * A⁻¹ * (b ^ 2 + b ^ 3))) +
            ((c_ν⁻¹ : Lˣ) : L) * R_cub) := by
    dsimp only [R_cub]
    linear_combination (norm := ring) ((c_ν⁻¹ : Lˣ) : L) * hcubic_L
  change ψ (((c_ν⁻¹ : Lˣ) : L) *
    (2 * (3 * a - a ^ 3 + 3 * a * b) - 2 * A⁻¹ * b ^ 2 + Q_E)) = 1
  rw [h_arg_split, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul, AddChar.map_neg_eq_inv,
    hψ_w1, hψ_w2, hψ_R, inv_one, mul_one, mul_one]

theorem ld_ch12_wild_odd_unramified_nonstable_additive_phase_cancel (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (T h : ℕ) (hT_ge2 : 2 ≤ T) (hh_lt : h < T)
    (hp_val : (Module.finrank L (IntermediateField.extendScalars hLE') : L) = 0 ∨
      ((T - T / 2 : ℕ) : ℤ) ≤
        valL F L (Module.finrank L (IntermediateField.extendScalars hLE') : L))
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (htr_bound_LM₁' : ∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (htr_bound_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (T : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (s : E' → ℕ → L)
    (hs1 : ∀ y : E', s y 1 = traceLM F hLE' y)
    (hs2 : ∀ y : E', 2 * s y 2 = (traceLM F hLE' y) ^ 2 - traceLM F hLE' (y ^ 2))
    (hsp1 : ∀ y : E', y ≠ 0 →
      s y (Module.finrank L (IntermediateField.extendScalars hLE') - 1) =
        normLM F hLE' y * traceLM F hLE' (y⁻¹))
    (hs_val : ∀ (y : E') (r : ℕ),
      r ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1) →
      ∀ (q m : ℤ), (y = 0 ∨ q ≤ valL F E' y) →
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * m -
          ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (T : ℤ) ≤ (r : ℤ) * q →
        (s y r = 0 ∨ m ≤ valL F L (s y r)))
    (hs_cayley : ∀ y : E',
      y ^ (Module.finrank L (IntermediateField.extendScalars hLE')) =
        IntermediateField.inclusion hLE' (normLM F hLE' y) +
          ∑ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
            (-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s y i) *
              y ^ (Module.finrank L (IntermediateField.extendScalars hLE') - i))
    (hs_newton2 : ∀ y : E',
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      traceLM F hLE' (y ^ p) - (p : L) * normLM F hLE' y =
        - (p : L) * (∑ r ∈ Finset.Icc 1 ((p - 1) / 2), s y r * s y (p - r)) +
          ∑ r ∈ Finset.Icc 1 (p - 1),
            ∑ j ∈ Finset.Icc 1 (p - r - 1),
              (-1 : L) ^ (r + j) * s y r * s y j * traceLM F hLE' (y ^ (p - r - j)))
    (c_ν : Lˣ) (c ε₀ : L) (d : M₁') (x : E') (Z_U : M₁'ˣ) (Z_E : E'ˣ)
    (hc_ν_val : valL F L (c_ν : L) = (T : ℤ) + condExpChar F L ψ)
    (hc_ν_tr_norm : ∀ w : E', (w = 0 ∨ ((T / 2 : ℕ) : ℤ) ≤ valL F E' w) →
      ψ (((c_ν⁻¹ : Lˣ) : L) * (2 * traceLM F hLE' w + 2 * normLM F hLE' w)) = 1)
    (hc_val : valL F L c = 0)
    (hd_val : valL F M₁' d = 0)
    (hd_tr_low : ∀ j ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 2),
      traceLM F hLM₁' (d ^ j) = 0 ∨ (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ j)))
    (hd_tr_top :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L) = 0 ∨
        (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ (p - 1)) - (p - 1 : L)))
    (hd_tr_pow :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      traceLM F hLM₁' (d ^ p) - (p : L) * c = 0 ∨
        (T : ℤ) ≤ valL F L (traceLM F hLM₁' (d ^ p) - (p : L) * c))
    (hε₀_int : ε₀ = 0 ∨ 0 ≤ valL F L ε₀)
    (hε₀_lt : h < T - 1 → ε₀ = 0)
    (hx_zero : h = 0 → (x = 0 ∨ 0 ≤ valL F E' x))
    (hx_pos : 0 < h → x ≠ 0 ∧ valL F E' x = -(h : ℤ) ∧ valL F L (normLM F hLE' x) = -(h : ℤ))
    (hZU_eq :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      (Z_U : M₁') =
        d ^ p + (∑ i ∈ Finset.Icc 1 (p - 1),
          IntermediateField.inclusion hLM₁' (s x i) * d ^ (p - i)) +
          IntermediateField.inclusion hLM₁' (normLM F hLE' x))
    (hZU_val : valL F M₁' (Z_U : M₁') = -(h : ℤ))
    (hZE_eq :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      (Z_E : E') - (x ^ p - x + IntermediateField.inclusion hLE' c) = 0 ∨
        (T : ℤ) ≤ valL F E' ((Z_E : E') - (x ^ p - x + IntermediateField.inclusion hLE' c)))
    (hZE_val :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      valL F E' (Z_E : E') = -((p * h : ℕ) : ℤ)) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let A := normLM F hLE' x
    let B_U := IntermediateField.inclusion hLM₁' (A + ε₀) + d ^ p
    let B_E := IntermediateField.inclusion hLE' (A + c) - x
    let cM₁' := (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom c_ν) * Z_U⁻¹
    let ηM₁' := (B_U - (Z_U : M₁')) * ((Z_U⁻¹ : M₁'ˣ) : M₁')
    let cE' := (Units.map (IntermediateField.inclusion hLE').toMonoidHom c_ν) * Z_E⁻¹
    let ηE' := (B_E - (Z_E : E')) * ((Z_E⁻¹ : E'ˣ) : E')
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    (ηM₁' = 0 ∨ (((T + h) / 2 : ℕ) : ℤ) ≤ valL F M₁' ηM₁') ∧
    (ηE' = 0 ∨ (((T + p * h) / 2 : ℕ) : ℤ) ≤ valL F E' ηE') ∧
    (ψE' (((cE'⁻¹ : E'ˣ) : E') * (2 - ηE' ^ 2))) ^ 2 =
      (ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (2 - ηM₁' ^ 2))) ^ 2 :=
by
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  set A := normLM F hLE' x
  set B_U := IntermediateField.inclusion hLM₁' (A + ε₀) + d ^ p
  set B_E := IntermediateField.inclusion hLE' (A + c) - x
  set cM₁' := (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom c_ν) * Z_U⁻¹
  set ηM₁' := (B_U - (Z_U : M₁')) * ((Z_U⁻¹ : M₁'ˣ) : M₁')
  set cE' := (Units.map (IntermediateField.inclusion hLE').toMonoidHom c_ν) * Z_E⁻¹
  set ηE' := (B_E - (Z_E : E')) * ((Z_E⁻¹ : E'ˣ) : E')
  set ψE' := traceChar F hLE' ψ
  set ψM₁' := traceChar F hLM₁' ψ
  have hp_ne2 : p ≠ 2 := hWild ▸ hp_odd
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  obtain ⟨hηM₁'_val, hηE'_val, hQE_triv, hQU_lt⟩ :=
    ld_ch12_wild_odd_unramified_nonstable_eta_val_bounds F L E' M₁' hLE' hLM₁'
      hPrime hp_ne2 T h hT_ge2 hh_lt hval_LM₁' hval_LE' htr_bound_LM₁' htr_bound_LE'
      s hs_val hs_cayley c ε₀ d x Z_U Z_E hd_val hε₀_int hε₀_lt hx_zero hx_pos
      hZU_eq hZU_val hZE_eq hZE_val
  obtain ⟨hS_triv, hS_p3⟩ :=
    ld_ch12_wild_odd_unramified_nonstable_zu_ze_trace_diff F L E' M₁' hLE' hLM₁'
      hPrime hp_ne2 hdegM₁' T h hT_ge2 hh_lt htr_bound_LE' s hs1 hs_val hs_newton2
      c d x Z_U Z_E hd_tr_low hd_tr_top hd_tr_pow hx_zero hx_pos hZU_eq hZE_eq
  refine ⟨hηM₁'_val, hηE'_val, ?_⟩
  obtain ⟨_, _, _, _, hvalL_mul, hvalL_inv, _⟩ := ld_valL_and_unitGroup_props F L
  have hψ_spec : ∀ y : L, (y = 0 ∨ -condExpChar F L ψ ≤ valL F L y) → ψ y = 1 :=
    (ld_condExp_and_condExpChar_spec F L ψ hψ 1).1
  have hψ_triv_T : ∀ r : L, (r = 0 ∨ (T : ℤ) ≤ valL F L r) →
      ψ (((c_ν⁻¹ : Lˣ) : L) * r) = 1 := by
    intro r hr
    by_cases hr0 : r = 0
    · rw [hr0, mul_zero]
      exact AddChar.map_zero_eq_one ψ
    · have hr_val : (T : ℤ) ≤ valL F L r := hr.resolve_left hr0
      apply hψ_spec
      right
      have hc_ne : ((c_ν⁻¹ : Lˣ) : L) ≠ 0 := Units.ne_zero _
      rw [hvalL_mul _ _ hc_ne hr0, hvalL_inv c_ν, hc_ν_val]
      omega
  letI : Module L L := Semiring.toModule
  have htr_smul_E' : ∀ (a : L) (y : E'),
      traceLM F hLE' (IntermediateField.inclusion hLE' a * y) = a * traceLM F hLE' y :=
    fun a y => (Algebra.trace L (IntermediateField.extendScalars hLE')).map_smul' a
      (toExtendScalars F hLE' y)
  have htr_smul_U : ∀ (a : L) (z : M₁'),
      traceLM F hLM₁' (IntermediateField.inclusion hLM₁' a * z) = a * traceLM F hLM₁' z :=
    fun a z => (Algebra.trace L (IntermediateField.extendScalars hLM₁')).map_smul' a
      (toExtendScalars F hLM₁' z)
  set Q_E := traceLM F hLE' (((Z_E : E') - B_E) ^ 2 * ((Z_E⁻¹ : E'ˣ) : E'))
  set Q_U := traceLM F hLM₁' (((Z_U : M₁') - B_U) ^ 2 * ((Z_U⁻¹ : M₁'ˣ) : M₁'))
  set S := traceLM F hLM₁' (Z_U : M₁') - traceLM F hLE' (Z_E : E')
  have hZE_arg : ((cE'⁻¹ : E'ˣ) : E') * (2 - ηE' ^ 2) =
      IntermediateField.inclusion hLE' (((c_ν⁻¹ : Lˣ) : L)) *
        (2 * (Z_E : E') - ((Z_E : E') - B_E) ^ 2 * ((Z_E⁻¹ : E'ˣ) : E')) := by
    have hz : (Z_E : E') * ((Z_E⁻¹ : E'ˣ) : E') = 1 := Units.mul_inv Z_E
    have hc : ((cE'⁻¹ : E'ˣ) : E') =
        IntermediateField.inclusion hLE' (((c_ν⁻¹ : Lˣ) : L)) * (Z_E : E') := by
      simp [cE', mul_comm]
    rw [hc]
    dsimp only [ηE']
    linear_combination (norm := ring)
      -IntermediateField.inclusion hLE' (((c_ν⁻¹ : Lˣ) : L)) *
        ((Z_E : E') - B_E) ^ 2 * ((Z_E⁻¹ : E'ˣ) : E') * hz
  have hZU_arg : ((cM₁'⁻¹ : M₁'ˣ) : M₁') * (2 - ηM₁' ^ 2) =
      IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L)) *
        (2 * (Z_U : M₁') - ((Z_U : M₁') - B_U) ^ 2 * ((Z_U⁻¹ : M₁'ˣ) : M₁')) := by
    have hz : (Z_U : M₁') * ((Z_U⁻¹ : M₁'ˣ) : M₁') = 1 := Units.mul_inv Z_U
    have hc : ((cM₁'⁻¹ : M₁'ˣ) : M₁') =
        IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L)) * (Z_U : M₁') := by
      simp [cM₁', mul_comm]
    rw [hc]
    dsimp only [ηM₁']
    linear_combination (norm := ring)
      -IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L)) *
        ((Z_U : M₁') - B_U) ^ 2 * ((Z_U⁻¹ : M₁'ˣ) : M₁') * hz
  have htr_E' : traceLM F hLE' (((cE'⁻¹ : E'ˣ) : E') * (2 - ηE' ^ 2)) =
      ((c_ν⁻¹ : Lˣ) : L) * (2 * traceLM F hLE' (Z_E : E') - Q_E) := by
    rw [hZE_arg, htr_smul_E', map_sub]
    have h2 : (2 : E') * (Z_E : E') = (Z_E : E') + (Z_E : E') := two_mul _
    rw [h2, map_add]
    ring
  have htr_U : traceLM F hLM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (2 - ηM₁' ^ 2)) =
      ((c_ν⁻¹ : Lˣ) : L) * (2 * traceLM F hLM₁' (Z_U : M₁') - Q_U) := by
    rw [hZU_arg, htr_smul_U, map_sub]
    have h2 : (2 : M₁') * (Z_U : M₁') = (Z_U : M₁') + (Z_U : M₁') := two_mul _
    rw [h2, map_add]
    ring
  suffices hPhase : ψE' (((cE'⁻¹ : E'ˣ) : E') * (2 - ηE' ^ 2)) =
      ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (2 - ηM₁' ^ 2)) by
    rw [hPhase]
  change ψ (traceLM F hLE' (((cE'⁻¹ : E'ˣ) : E') * (2 - ηE' ^ 2))) =
    ψ (traceLM F hLM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (2 - ηM₁' ^ 2)))
  rw [htr_E', htr_U]
  set Δ := 2 * S - Q_U + Q_E
  have hsplit_U : ((c_ν⁻¹ : Lˣ) : L) * (2 * traceLM F hLM₁' (Z_U : M₁') - Q_U) =
      ((c_ν⁻¹ : Lˣ) : L) * Δ +
        ((c_ν⁻¹ : Lˣ) : L) * (2 * traceLM F hLE' (Z_E : E') - Q_E) := by
    dsimp only [Δ, S]
    ring
  rw [hsplit_U, AddChar.map_add_eq_mul]
  suffices hΔ : ψ (((c_ν⁻¹ : Lˣ) : L) * Δ) = 1 by
    rw [hΔ, one_mul]
  by_cases hh : h < T - 1
  · have hψS : ψ (((c_ν⁻¹ : Lˣ) : L) * S) = 1 := hψ_triv_T S (hS_triv (Or.inl hh))
    have hψQU : ψ (((c_ν⁻¹ : Lˣ) : L) * Q_U) = 1 := hψ_triv_T Q_U (hQU_lt hh)
    have hψQE : ψ (((c_ν⁻¹ : Lˣ) : L) * Q_E) = 1 := hψ_triv_T Q_E (hQE_triv (Or.inl hh))
    have hΔ_eq : ((c_ν⁻¹ : Lˣ) : L) * Δ =
        (((c_ν⁻¹ : Lˣ) : L) * S + ((c_ν⁻¹ : Lˣ) : L) * S) +
          (-(((c_ν⁻¹ : Lˣ) : L) * Q_U) + ((c_ν⁻¹ : Lˣ) : L) * Q_E) := by
      dsimp only [Δ]
      ring
    rw [hΔ_eq, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul,
      AddChar.map_neg_eq_inv, hψS, hψQU, hψQE, mul_one, inv_one, mul_one, mul_one]
  · have hh_eq : h = T - 1 := by omega
    obtain ⟨hQU_gt3, hQU_p3⟩ :=
      ld_ch12_wild_odd_unramified_boundary_zu_quad_trace F L E' M₁' hLE' hLM₁'
        hPrime hp_ne2 hdegM₁' T h hT_ge2 hh_eq hp_val hval_LM₁' htr_bound_LM₁'
        s hs_val ε₀ d x Z_U hd_val hd_tr_low hd_tr_top hε₀_int hx_pos hZU_eq hZU_val
    by_cases hp3 : p = 3
    · set S₀ := 3 * s x 1 - (s x 1) ^ 3 + 3 * s x 1 * s x 2
      set Q_U₀ := 2 * A⁻¹ * (s x 2) ^ 2
      have hψS : ψ (((c_ν⁻¹ : Lˣ) : L) * (S - S₀)) = 1 := hψ_triv_T (S - S₀) (hS_p3 hp3)
      have hψQU : ψ (((c_ν⁻¹ : Lˣ) : L) * (Q_U - Q_U₀)) = 1 :=
        hψ_triv_T (Q_U - Q_U₀) (hQU_p3 hp3)
      have hψ_cubic : ψ (((c_ν⁻¹ : Lˣ) : L) * (2 * S₀ - Q_U₀ + Q_E)) = 1 :=
        ld_ch12_wild_odd_unramified_p3_boundary_cubic_cancel F L E' hLE' hp3 ψ hψ
          T h hT_ge2 hh_eq hp_val hval_LE' htr_bound_LE' s hs1 hs2 hsp1 hs_val hs_cayley
          c_ν c x Z_E hc_ν_val hc_ν_tr_norm hc_val hx_pos hZE_eq hZE_val
      have hΔ_eq : ((c_ν⁻¹ : Lˣ) : L) * Δ =
          (((c_ν⁻¹ : Lˣ) : L) * (S - S₀) + ((c_ν⁻¹ : Lˣ) : L) * (S - S₀)) +
            (-(((c_ν⁻¹ : Lˣ) : L) * (Q_U - Q_U₀)) +
              ((c_ν⁻¹ : Lˣ) : L) * (2 * S₀ - Q_U₀ + Q_E)) := by
        dsimp only [Δ]
        ring
      rw [hΔ_eq, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul,
        AddChar.map_neg_eq_inv, hψS, hψQU, hψ_cubic, mul_one, inv_one, mul_one, mul_one]
    · have hp_gt3 : 3 < p := by omega
      have hψS : ψ (((c_ν⁻¹ : Lˣ) : L) * S) = 1 := hψ_triv_T S (hS_triv (Or.inr hp_gt3))
      have hψQU : ψ (((c_ν⁻¹ : Lˣ) : L) * Q_U) = 1 := hψ_triv_T Q_U (hQU_gt3 hp_gt3)
      have hψQE : ψ (((c_ν⁻¹ : Lˣ) : L) * Q_E) = 1 := hψ_triv_T Q_E (hQE_triv (Or.inr hp_gt3))
      have hΔ_eq : ((c_ν⁻¹ : Lˣ) : L) * Δ =
          (((c_ν⁻¹ : Lˣ) : L) * S + ((c_ν⁻¹ : Lˣ) : L) * S) +
            (-(((c_ν⁻¹ : Lˣ) : L) * Q_U) + ((c_ν⁻¹ : Lˣ) : L) * Q_E) := by
        dsimp only [Δ]
        ring
      rw [hΔ_eq, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul,
        AddChar.map_neg_eq_inv, hψS, hψQU, hψQE, mul_one, inv_one, mul_one, mul_one]

theorem ld_ch12_wild_odd_unramified_subfield_branch_fourth_pow (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLK₁ : IsGaloisExt F L K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hAbLE' : IsAbelianExt F hLE') (hAbLM₁' : IsAbelianExt F hLM₁')
    (hAbE'K₁ : IsAbelianExt F hE'K₁) (hAbM₁'K₁ : IsAbelianExt F hM₁'K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (h_inf : E' ⊓ M₁' = L) (h_sup : E' ⊔ M₁' = K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ) (hInvK₁ : IsInvariantWeilChar F L K₁ χK₁)
    (hneK₁ : ¬ ∃ χL : relWeil F L →* (Ω F)ˣ,
      IsWeilRep F L (charRep F L χL) ∧ restrictWeilChar F (hLE'.trans hE'K₁) χL = χK₁)
    (χE' : relWeil F E' →* (Ω F)ˣ) (hχE'_weil : IsWeilRep F E' (charRep F E' χE'))
    (hχE'_rest : restrictWeilChar F hE'K₁ χE' = χK₁)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ) (hχM₁'_weil : IsWeilRep F M₁' (charRep F M₁' χM₁'))
    (hχM₁'_rest : restrictWeilChar F hM₁'K₁ χM₁' = χK₁)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (hψK₁ : IsAdmissibleChar F K₁ (traceChar F (hLE'.trans hE'K₁) ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hνM₁'E'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * νE')), (νM₁' ^ j * νE') u = 1)
    (hνE'M₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j * νM₁')), (νE' ^ j * νM₁') u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hUnramM₁' : condExp F L νM₁' = 0)
    (hMinM₁' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE') ∧
      condExp F L (νM₁' ^ j * νE') = condExp F L νE')
    (hMinE' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νE' ^ j * νM₁') ∧
      (0 < j → condExp F L (νE' ^ j * νM₁') = condExp F L νE'))
    (hNormFactor : ∀ x : Lˣ, ∃ (y : E'ˣ) (z : M₁'ˣ),
      x = Units.map (normLM F hLE') y * Units.map (normLM F hLM₁') z)
    (hχE'_comp : (recChar F rec E' χE').comp (Units.map (normLM F hE'K₁)) = recChar F rec K₁ χK₁)
    (hχM₁'_comp : (recChar F rec M₁' χM₁').comp (Units.map (normLM F hM₁'K₁)) = recChar F rec K₁ χK₁)
    (hχK₁_cond : ∀ u ∈ unitGroup F K₁ (condExp F K₁ (recChar F rec K₁ χK₁)),
      (recChar F rec K₁ χK₁) u = 1)
    (hmE'_ge2 : 2 ≤ condExp F E' (recChar F rec E' χE'))
    (hξE'_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
      (∀ y : E'ˣ, y ∈ Set.range (Units.map (normLM F hE'K₁)) ↔ ξE' y = 1) ∧
      (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j)), (ξE' ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j * recChar F rec E' χE')),
        (ξE' ^ j * recChar F rec E' χE') u = 1) ∧
      condExp F E' (ξE' ^ j * recChar F rec E' χE') =
        condExp F E' (recChar F rec E' χE'))
    (hmM₁'_ge2 : 2 ≤ condExp F M₁' (recChar F rec M₁' χM₁'))
    (hξM₁'_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
      (∀ z : M₁'ˣ, z ∈ Set.range (Units.map (normLM F hM₁'K₁)) ↔ ξM₁' z = 1) ∧
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j)), (ξM₁' ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j * recChar F rec M₁' χM₁')),
        (ξM₁' ^ j * recChar F rec M₁' χM₁') u = 1) ∧
      condExp F M₁' (ξM₁' ^ j * recChar F rec M₁' χM₁') =
        condExp F M₁' (recChar F rec M₁' χM₁'))
    (hCommonRest : ∀ x : Lˣ,
      (recChar F rec E' χE') (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) =
      (recChar F rec M₁' χM₁') (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x))
    (hLamp4 : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ (θ : Mˣ →* (Ω F)ˣ), 2 ≤ condExp F M θ →
      (∀ u ∈ unitGroup F M (condExp F M θ), θ u = 1) →
      let m := condExp F M θ
      let d := m / 2
      (∃ c_θ : Mˣ,
        valL F M (c_θ : M) = (m : ℤ) + condExpChar F M ψ_M ∧
        ∀ x : M, (x = 0 ∨ (d : ℤ) ≤ valL F M x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
              ψ_M (((c_θ⁻¹ : Mˣ) : M) * (2 * x - x ^ 2))) ∧
      (∀ (c : Mˣ) (η : M),
        valL F M (c : M) = (m : ℤ) + condExpChar F M ψ_M →
        (η = 0 ∨ (d : ℤ) ≤ valL F M η) →
        (∀ x : M, (x = 0 ∨ (d : ℤ) ≤ valL F M x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
              ψ_M (((c⁻¹ : Mˣ) : M) * (1 + η) * (2 * x - x ^ 2))) →
        (tateEps F M θ ψ_M) ^ 4 =
          ((qL F M : Ω F) ^ (4 * condExpChar F M ψ_M + 2 * (m : ℤ))) *
            (θ c : Ω F) ^ 4 *
            (ψ_M (((c⁻¹ : Mˣ) : M) * (2 - η ^ 2))) ^ 2)) :
    (tateEps F E' (recChar F rec E' χE') (traceChar F hLE' ψ)) ^ 4 *
        ((qL F L : Ω F) ^
          (2 * (((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νM₁' : ℤ)))) =
      (tateEps F M₁' (recChar F rec M₁' χM₁') (traceChar F hLM₁' ψ)) ^ 4 *
        ((qL F L : Ω F) ^
          (2 * (((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νE' : ℤ)))) :=
by
  obtain ⟨hT_le, hmE'_eq, hnM₁'_eq, hnE'_eq, hnK₁_eq, hξM₁'_pow, hξM₁'_ne, hξM₁'_cond_eq,
    hq_pow_eq, hval_LM₁', hval_norm_LM₁', hval_LE', hval_norm_LE',
    hval_E'K₁, hval_norm_E'K₁, hval_M₁'K₁, hval_norm_M₁'K₁,
    htr_bound_LM₁', htr_bound_E'K₁, hnorm_lin_E'K₁, hDiamond_E', hDiamond_M₁',
    ⟨y₁, w₁, σ₀, j₀, hy₁_int, hy₁_tr, hw₁_int, hw₁_tr, hj₀_pos, hj₀_lt,
     hσ₀_L, hσ₀_val, hσ₀_tr, hσ₀_norm, hFrobTwist⟩⟩ :=
    ld_ch12_wild_odd_unramified_diamond_cond_and_frob_twist F rec L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLK₁ hGalLE' hGalLM₁' hGalE'K₁ hGalM₁'K₁
      hAbLE' hAbLM₁' hAbE'K₁ hAbM₁'K₁ hPrime hWild hp_odd
      hdegM₁' hdegE'K₁ hdegM₁'K₁ h_inf h_sup
      χK₁ hInvK₁ hneK₁ χE' hχE'_weil hχE'_rest χM₁' hχM₁'_weil hχM₁'_rest
      ψ hψ hψE' hψM₁' hψK₁ νE' νM₁'
      hνE'_pow hνE'_ne hνE'_ker hνE'_cond hνM₁'_pow hνM₁'_ne hνM₁'_ker hνM₁'_cond
      hνM₁'E'_cond hνE'M₁'_cond hbE'_ge2 hUnramM₁' hMinM₁' hMinE'
      hχE'_comp hχM₁'_comp hχK₁_cond hξE'_props hξM₁'_props
  obtain ⟨hp_val, htr_bound_LE', hq_norm_tr_E', s, hs1, hs2, hsp1, hs_val, hs_poly,
    hs_cayley, hs_newton2⟩ :=
    ld_wild_odd_cayley_hamilton_and_two_step_newton F L E' hLE' hGalLE' hAbLE'
      hPrime hWild hp_odd ψ hψ νE' hνE'_pow hνE'_ne hνE'_ker hνE'_cond hbE'_ge2
  have hPrime_M₁'K₁ : Nat.Prime (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁)) :=
    hdegM₁'K₁.symm ▸ hPrime
  have hWild_M₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) = p F :=
    hdegM₁'K₁.trans hWild
  have hξM₁'_pow' : (νE'.comp (Units.map (normLM F hLM₁'))) ^
      (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁)) = 1 :=
    hdegM₁'K₁.symm ▸ hξM₁'_pow
  have hξM₁'_ker : ∀ z : M₁'ˣ, z ∈ Set.range (Units.map (normLM F hM₁'K₁)) ↔
      (νE'.comp (Units.map (normLM F hLM₁'))) z = 1 :=
    (hξM₁'_props 0 hPrime.pos).1
  have hξM₁'_cond : ∀ j < Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁),
      ∀ u ∈ unitGroup F M₁' (condExp F M₁' ((νE'.comp (Units.map (normLM F hLM₁'))) ^ j)),
        ((νE'.comp (Units.map (normLM F hLM₁'))) ^ j) u = 1 :=
    fun j hj => (hξM₁'_props j (hdegM₁'K₁ ▸ hj)).2.1
  have hb_ξM₁'_ge2 : 2 ≤ condExp F M₁' (νE'.comp (Units.map (normLM F hLM₁'))) :=
    hξM₁'_cond_eq.symm ▸ hbE'_ge2
  obtain ⟨_, _, hq_norm_tr_K₁_raw, _⟩ :=
    ld_wild_odd_cayley_hamilton_and_two_step_newton F M₁' K₁ hM₁'K₁ hGalM₁'K₁ hAbM₁'K₁
      hPrime_M₁'K₁ hWild_M₁'K₁ hp_odd (traceChar F hLM₁' ψ) hψM₁'
      (νE'.comp (Units.map (normLM F hLM₁')))
      hξM₁'_pow' hξM₁'_ne hξM₁'_ker hξM₁'_cond hb_ξM₁'_ge2
  have hq_norm_tr_K₁ : ∀ (h : ℕ) (w : K₁),
      (w = 0 ∨
        (((condExp F L νE' +
          Module.finrank L (IntermediateField.extendScalars hLE') * h) / 2 : ℕ) : ℤ) ≤
          valL F K₁ w) →
      let u := normLM F hM₁'K₁ (1 + w) - 1
      let q_w := (2 : K₁)⁻¹ * (2 * w - w ^ 2)
      (2 * u - u ^ 2) - (traceLM F hM₁'K₁ (2 * w - w ^ 2) + 2 * normLM F hM₁'K₁ q_w) = 0 ∨
        ((condExp F L νE' + h : ℕ) : ℤ) ≤
          valL F M₁' ((2 * u - u ^ 2) -
            (traceLM F hM₁'K₁ (2 * w - w ^ 2) + 2 * normLM F hM₁'K₁ q_w)) := by
    intro h w hw
    have h1 := hq_norm_tr_K₁_raw h w
    rw [hdegM₁'K₁, hξM₁'_cond_eq] at h1
    exact h1 hw
  have hθE'_triv : ∀ u ∈ unitGroup F E' (condExp F E' (recChar F rec E' χE')),
      (recChar F rec E' χE') u = 1 := by
    simpa [pow_zero, one_mul] using (hξE'_props 0 hPrime.pos).2.2.1
  have hθM₁'_triv : ∀ u ∈ unitGroup F M₁' (condExp F M₁' (recChar F rec M₁' χM₁')),
      (recChar F rec M₁' χM₁') u = 1 := by
    simpa [pow_zero, one_mul] using (hξM₁'_props 0 hPrime.pos).2.2.1
  obtain ⟨⟨c_E, hc_E_val, hc_E_stat⟩, hEvalE'⟩ :=
    hLamp4 E' (traceChar F hLE' ψ) hψE' (recChar F rec E' χE') hmE'_ge2 hθE'_triv
  obtain ⟨⟨c_U, hc_U_val, hc_U_stat⟩, hEvalM₁'⟩ :=
    hLamp4 M₁' (traceChar F hLM₁' ψ) hψM₁' (recChar F rec M₁' χM₁') hmM₁'_ge2 hθM₁'_triv
  by_cases hStable : 2 * condExp F L νE' ≤ condExp F M₁' (recChar F rec M₁' χM₁')
  · obtain ⟨cE', cM₁', hcE'_val, hcE'_stat, hcM₁'_val, hcM₁'_stat, hPhaseEq⟩ :=
      ld_ch12_wild_odd_unramified_stable_range_stat_match F L E' M₁' K₁
        hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime hWild hp_odd ψ hψ hψE' hψM₁' hψK₁
        (condExp F L νE') hbE'_ge2
        (recChar F rec E' χE') (recChar F rec M₁' χM₁') (recChar F rec K₁ χK₁)
        (νE'.comp (Units.map (normLM F hLM₁')))
        hχE'_comp hχM₁'_comp hCommonRest hξM₁'_cond_eq
        (by simpa [pow_one] using (hξM₁'_props 1 hPrime.one_lt).2.1)
        hθE'_triv hθM₁'_triv hStable hmE'_eq hnM₁'_eq hnE'_eq
        hval_LM₁' hval_LE' hval_E'K₁ hval_norm_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁
        htr_bound_LM₁' htr_bound_E'K₁ hnorm_lin_E'K₁
        (fun y => (hDiamond_E' y).2) (fun z => (hDiamond_M₁' z).2)
        y₁ hy₁_int hy₁_tr w₁ hw₁_int hw₁_tr σ₀ j₀ hσ₀_val hσ₀_tr hFrobTwist
        hq_norm_tr_K₁ c_U hc_U_val hc_U_stat c_E hc_E_val hc_E_stat
    rw [hEvalE' cE' 0 hcE'_val (Or.inl rfl) hcE'_stat,
        hEvalM₁' cM₁' 0 hcM₁'_val (Or.inl rfl) hcM₁'_stat]
    calc
      ((qL F E' : Ω F) ^ (4 * condExpChar F E' (traceChar F hLE' ψ) +
          2 * (condExp F E' (recChar F rec E' χE') : ℤ)) *
        ((recChar F rec E' χE') cE' : Ω F) ^ 4 *
        ((traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E') * (2 - (0 : E') ^ 2))) ^ 2) *
        (qL F L : Ω F) ^
          (2 * (((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νM₁' : ℤ)))
        = (((qL F E' : Ω F) ^ (4 * condExpChar F E' (traceChar F hLE' ψ) +
              2 * (condExp F E' (recChar F rec E' χE') : ℤ))) *
            ((qL F L : Ω F) ^
              (2 * (((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
                (condExp F L νM₁' : ℤ))))) *
          (((recChar F rec E' χE') cE' : Ω F) ^ 4 *
            ((traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E') * (2 - (0 : E') ^ 2))) ^ 2) := by ring
      _ = (((qL F M₁' : Ω F) ^ (4 * condExpChar F M₁' (traceChar F hLM₁' ψ) +
              2 * (condExp F M₁' (recChar F rec M₁' χM₁') : ℤ))) *
            ((qL F L : Ω F) ^
              (2 * (((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
                (condExp F L νE' : ℤ))))) *
          (((recChar F rec M₁' χM₁') cM₁' : Ω F) ^ 4 *
            ((traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (2 - (0 : M₁') ^ 2))) ^ 2) := by
          rw [hq_pow_eq, hPhaseEq]
      _ = _ := by ring
  · have hNonStable : condExp F M₁' (recChar F rec M₁' χM₁') < 2 * condExp F L νE' :=
      not_le.mp hStable
    have hνE'_triv : ∀ u ∈ unitGroup F L (condExp F L νE'), νE' u = 1 := by
      simpa [pow_one] using hνE'_cond 1 hPrime.one_lt
    obtain ⟨⟨c_ν₀, hc_ν₀_val, hc_ν₀_stat⟩, _⟩ :=
      hLamp4 L ψ hψ νE' hbE'_ge2 hνE'_triv
    obtain ⟨c_ν, c, ε₀, d, x, Z_U, Z_E,
      hc_ν_val, hc_ν_tr_norm, hc_val, hd_val, hd_tr_low, hd_tr_top, hd_tr_pow,
      hε₀_int, hε₀_lt, hx_zero, hx_pos, hZU_eq, hZU_val, hZE_eq, hZE_val,
      hcM₁'_val, hcM₁'_stat, hcE'_val, hcE'_stat, hMultEq⟩ :=
      ld_ch12_wild_odd_unramified_nonstable_common_norm_stat F L E' M₁' K₁
        hLE' hLM₁' hE'K₁ hM₁'K₁ hGalLE' hGalM₁'K₁ hPrime hWild hp_odd
        hdegM₁' hdegE'K₁ hdegM₁'K₁ ψ hψ hψE' hψM₁' hψK₁ νE'
        hνE'_pow hνE'_ne hνE'_ker hνE'_cond hbE'_ge2
        (recChar F rec E' χE') (recChar F rec M₁' χM₁') (recChar F rec K₁ χK₁)
        hχE'_comp hχM₁'_comp hCommonRest hθE'_triv hθM₁'_triv
        hT_le hNonStable hmE'_eq hnM₁'_eq hnE'_eq hp_val
        hval_LM₁' hval_norm_LM₁' hval_LE' hval_norm_LE'
        hval_E'K₁ hval_norm_E'K₁ hval_M₁'K₁ hval_norm_M₁'K₁
        htr_bound_LM₁' htr_bound_E'K₁ hnorm_lin_E'K₁ hDiamond_E' hDiamond_M₁'
        y₁ hy₁_int hy₁_tr w₁ hw₁_int hw₁_tr σ₀ j₀ hj₀_pos hj₀_lt
        hσ₀_L hσ₀_val hσ₀_tr hσ₀_norm hFrobTwist
        hq_norm_tr_E' hq_norm_tr_K₁ s hs_val hs_poly
        c_ν₀ hc_ν₀_val hc_ν₀_stat c_U hc_U_val hc_U_stat c_E hc_E_val hc_E_stat
    have hh_lt : condExp F M₁' (recChar F rec M₁' χM₁') - condExp F L νE' < condExp F L νE' := by
      omega
    obtain ⟨hηM₁'_val, hηE'_val, hAddEq⟩ :=
      ld_ch12_wild_odd_unramified_nonstable_additive_phase_cancel F L E' M₁'
        hLE' hLM₁' hPrime hWild hp_odd hdegM₁' ψ hψ
        (condExp F L νE') (condExp F M₁' (recChar F rec M₁' χM₁') - condExp F L νE')
        hbE'_ge2 hh_lt hp_val hval_LM₁' hval_LE' hval_norm_LE'
        htr_bound_LM₁' htr_bound_LE' s hs1 hs2 hsp1 hs_val hs_cayley hs_newton2
        c_ν c ε₀ d x Z_U Z_E
        hc_ν_val hc_ν_tr_norm hc_val hd_val hd_tr_low hd_tr_top hd_tr_pow
        hε₀_int hε₀_lt hx_zero hx_pos hZU_eq hZU_val hZE_eq hZE_val
    have hmM₁'_sub : condExp F L νE' +
        (condExp F M₁' (recChar F rec M₁' χM₁') - condExp F L νE') =
        condExp F M₁' (recChar F rec M₁' χM₁') := Nat.add_sub_of_le hT_le
    rw [hmM₁'_sub] at hηM₁'_val
    rw [← hmE'_eq] at hηE'_val
    set A := normLM F hLE' x
    set B_U := IntermediateField.inclusion hLM₁' (A + ε₀) + d ^
      (Module.finrank L (IntermediateField.extendScalars hLE'))
    set B_E := IntermediateField.inclusion hLE' (A + c) - x
    set cM₁' := (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom c_ν) * Z_U⁻¹
    set ηM₁' := (B_U - (Z_U : M₁')) * ((Z_U⁻¹ : M₁'ˣ) : M₁')
    set cE' := (Units.map (IntermediateField.inclusion hLE').toMonoidHom c_ν) * Z_E⁻¹
    set ηE' := (B_E - (Z_E : E')) * ((Z_E⁻¹ : E'ˣ) : E')
    rw [hEvalE' cE' ηE' hcE'_val hηE'_val hcE'_stat,
        hEvalM₁' cM₁' ηM₁' hcM₁'_val hηM₁'_val hcM₁'_stat]
    calc
      ((qL F E' : Ω F) ^ (4 * condExpChar F E' (traceChar F hLE' ψ) +
          2 * (condExp F E' (recChar F rec E' χE') : ℤ)) *
        ((recChar F rec E' χE') cE' : Ω F) ^ 4 *
        ((traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E') * (2 - ηE' ^ 2))) ^ 2) *
        (qL F L : Ω F) ^
          (2 * (((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
            (condExp F L νM₁' : ℤ)))
        = (((qL F E' : Ω F) ^ (4 * condExpChar F E' (traceChar F hLE' ψ) +
              2 * (condExp F E' (recChar F rec E' χE') : ℤ))) *
            ((qL F L : Ω F) ^
              (2 * (((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
                (condExp F L νM₁' : ℤ))))) *
          ((recChar F rec E' χE') cE' : Ω F) ^ 4 *
          ((traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E') * (2 - ηE' ^ 2))) ^ 2 := by ring
      _ = (((qL F M₁' : Ω F) ^ (4 * condExpChar F M₁' (traceChar F hLM₁' ψ) +
              2 * (condExp F M₁' (recChar F rec M₁' χM₁') : ℤ))) *
            ((qL F L : Ω F) ^
              (2 * (((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
                (condExp F L νE' : ℤ))))) *
          ((recChar F rec M₁' χM₁') cM₁' : Ω F) ^ 4 *
          ((traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (2 - ηM₁' ^ 2))) ^ 2 := by
          rw [hq_pow_eq, hMultEq, hAddEq]
      _ = _ := by ring

theorem ld_ch12_wild_odd_totally_ramified_herbrand_and_exponent_balance (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hGalLE' : IsGaloisExt F L E') (hGalLM₁' : IsGaloisExt F L M₁')
    (hGalE'K₁ : IsGaloisExt F E' K₁) (hGalM₁'K₁ : IsGaloisExt F M₁' K₁)
    (hAbLE' : IsAbelianExt F hLE') (hAbLM₁' : IsAbelianExt F hLM₁')
    (hAbE'K₁ : IsAbelianExt F hE'K₁) (hAbM₁'K₁ : IsAbelianExt F hM₁'K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegE'K₁ : Module.finrank E' (IntermediateField.extendScalars hE'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ)
    (χE' : relWeil F E' →* (Ω F)ˣ)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hνM₁'_pow : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνM₁'_ne : νM₁' ≠ 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hνM₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j)), (νM₁' ^ j) u = 1)
    (hνM₁'E'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νM₁' ^ j * νE')), (νM₁' ^ j * νE') u = 1)
    (hνE'M₁'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j * νM₁')), (νE' ^ j * νM₁') u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νM₁' ^ j * νE') ∧
      condExp F L (νM₁' ^ j * νE') = condExp F L νE')
    (hMinE' : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      condExp F L νM₁' ≤ condExp F L (νE' ^ j * νM₁') ∧
      (0 < j → condExp F L (νE' ^ j * νM₁') = condExp F L νE'))
    (hχE'_comp : (recChar F rec E' χE').comp (Units.map (normLM F hE'K₁)) = recChar F rec K₁ χK₁)
    (hχM₁'_comp : (recChar F rec M₁' χM₁').comp (Units.map (normLM F hM₁'K₁)) = recChar F rec K₁ χK₁)
    (hχK₁_cond : ∀ u ∈ unitGroup F K₁ (condExp F K₁ (recChar F rec K₁ χK₁)),
      (recChar F rec K₁ χK₁) u = 1)
    (hmE'_ge2 : 2 ≤ condExp F E' (recChar F rec E' χE'))
    (hξE'_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
      (∀ y : E'ˣ, y ∈ Set.range (Units.map (normLM F hE'K₁)) ↔ ξE' y = 1) ∧
      (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j)), (ξE' ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ j * recChar F rec E' χE')),
        (ξE' ^ j * recChar F rec E' χE') u = 1) ∧
      condExp F E' (ξE' ^ j * recChar F rec E' χE') =
        condExp F E' (recChar F rec E' χE'))
    (hmM₁'_ge2 : 2 ≤ condExp F M₁' (recChar F rec M₁' χM₁'))
    (hξM₁'_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
      (∀ z : M₁'ˣ, z ∈ Set.range (Units.map (normLM F hM₁'K₁)) ↔ ξM₁' z = 1) ∧
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j)), (ξM₁' ^ j) u = 1) ∧
      (∀ u ∈ unitGroup F M₁' (condExp F M₁' (ξM₁' ^ j * recChar F rec M₁' χM₁')),
        (ξM₁' ^ j * recChar F rec M₁' χM₁') u = 1) ∧
      condExp F M₁' (ξM₁' ^ j * recChar F rec M₁' χM₁') =
        condExp F M₁' (recChar F rec M₁' χM₁'))
    (hLamp4 : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ (θ : Mˣ →* (Ω F)ˣ), 2 ≤ condExp F M θ →
      (∀ u ∈ unitGroup F M (condExp F M θ), θ u = 1) →
      let m := condExp F M θ
      let d := m / 2
      (∃ c_θ : Mˣ,
        valL F M (c_θ : M) = (m : ℤ) + condExpChar F M ψ_M ∧
        ∀ x : M, (x = 0 ∨ (d : ℤ) ≤ valL F M x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
              ψ_M (((c_θ⁻¹ : Mˣ) : M) * (2 * x - x ^ 2))) ∧
      (∀ (c : Mˣ) (η : M),
        valL F M (c : M) = (m : ℤ) + condExpChar F M ψ_M →
        (η = 0 ∨ (d : ℤ) ≤ valL F M η) →
        (∀ x : M, (x = 0 ∨ (d : ℤ) ≤ valL F M x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
              ψ_M (((c⁻¹ : Mˣ) : M) * (1 + η) * (2 * x - x ^ 2))) →
        (tateEps F M θ ψ_M) ^ 4 =
          ((qL F M : Ω F) ^ (4 * condExpChar F M ψ_M + 2 * (m : ℤ))) *
            (θ c : Ω F) ^ 4 *
            (ψ_M (((c⁻¹ : Mˣ) : M) * (2 - η ^ 2))) ^ 2)) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLE')
    let bE' := condExp F L νE'
    let bM₁' := condExp F L νM₁'
    let ξE' := νM₁'.comp (Units.map (normLM F hLE'))
    let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
    let θE' := recChar F rec E' χE'
    let θM₁' := recChar F rec M₁' χM₁'
    let θK₁ := recChar F rec K₁ χK₁
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    bM₁' ≤ bE' ∧
    qL F E' = qL F L ∧
    qL F M₁' = qL F L ∧
    (∀ y : E', valL F L (normLM F hLE' y) = valL F E' y) ∧
    (∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z) ∧
    condExpChar F E' ψE' =
      (ℓ : ℤ) * condExpChar F L ψ + ((ℓ - 1 : ℕ) : ℤ) * (bE' : ℤ) ∧
    condExpChar F M₁' ψM₁' =
      (ℓ : ℤ) * condExpChar F L ψ + ((ℓ - 1 : ℕ) : ℤ) * (bM₁' : ℤ) ∧
    condExp F E' ξE' = bM₁' ∧
    condExp F M₁' ξM₁' = bM₁' + ℓ * (bE' - bM₁') ∧
    condExp F E' ξE' ≤ condExp F E' θE' ∧
    condExp F M₁' ξM₁' ≤ condExp F M₁' θM₁' ∧
    condExp F K₁ θK₁ =
      condExp F E' ξE' + ℓ * (condExp F E' θE' - condExp F E' ξE') ∧
    condExp F K₁ θK₁ =
      condExp F M₁' ξM₁' + ℓ * (condExp F M₁' θM₁' - condExp F M₁' ξM₁') ∧
    condExp F E' θE' + (ℓ - 1) * bE' = condExp F M₁' θM₁' + (ℓ - 1) * bM₁' ∧
    ((∃ (cE' : E'ˣ) (cM₁' : M₁'ˣ),
        valL F E' (cE' : E') = (condExp F E' θE' : ℤ) + condExpChar F E' ψE' ∧
        (∀ x : E', (x = 0 ∨ ((condExp F E' θE' / 2 : ℕ) : ℤ) ≤ valL F E' x) →
          ∀ hx : 1 + x ≠ 0,
            (θE' (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
              ψE' (((cE'⁻¹ : E'ˣ) : E') * (2 * x - x ^ 2))) ∧
        valL F M₁' (cM₁' : M₁') = (condExp F M₁' θM₁' : ℤ) + condExpChar F M₁' ψM₁' ∧
        (∀ z : M₁', (z = 0 ∨ ((condExp F M₁' θM₁' / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
          ∀ hz : 1 + z ≠ 0,
            (θM₁' (Units.mk0 (1 + z) hz) : Ω F) ^ 2 =
              ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (2 * z - z ^ 2))) ∧
        (θE' cE' : Ω F) ^ 4 * (ψE' (((cE'⁻¹ : E'ˣ) : E') * 2)) ^ 2 =
          (θM₁' cM₁' : Ω F) ^ 4 * (ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * 2)) ^ 2) →
      (tateEps F E' θE' ψE') ^ 4 *
          ((qL F L : Ω F) ^ (2 * (((ℓ - 1 : ℕ) : ℤ) * (bM₁' : ℤ)))) =
        (tateEps F M₁' θM₁' ψM₁') ^ 4 *
          ((qL F L : Ω F) ^ (2 * (((ℓ - 1 : ℕ) : ℤ) * (bE' : ℤ))))) :=
by
  set ℓ := Module.finrank L (IntermediateField.extendScalars hLE')
  set bE' := condExp F L νE'
  set bM₁' := condExp F L νM₁'
  set ξE' := νM₁'.comp (Units.map (normLM F hLE'))
  set ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
  set θE' := recChar F rec E' χE'
  set θM₁' := recChar F rec M₁' χM₁'
  set θK₁ := recChar F rec K₁ χK₁
  set ψE' := traceChar F hLE' ψ
  set ψM₁' := traceChar F hLM₁' ψ
  have h0_M₁' := hMinM₁' 0 hPrime.pos
  have hb_le : bM₁' ≤ bE' := h0_M₁'.2 ▸ h0_M₁'.1
  have hξE'_cond1 : ∀ u ∈ unitGroup F E' (condExp F E' ξE'), ξE' u = 1 := by
    have h1 : ∀ u ∈ unitGroup F E' (condExp F E' (ξE' ^ 1)), (ξE' ^ 1) u = 1 :=
      (hξE'_props 1 hPrime.one_lt).2.1
    intro u hu
    rw [← pow_one ξE'] at hu ⊢
    exact h1 u hu
  obtain ⟨_, _, hqE', hval_normE', hψE'_cond, hCond_leE', _, _⟩ :=
    ld_ch10_wild_ramification_and_cond_formulas F L E' hLE' hGalLE' hAbLE' hPrime ψ hψ
      νE' νM₁' hνE'_pow hνE'_ne hνE'_ker hνE'_cond hνE'M₁'_cond hξE'_cond1
      (fun j hj => (hMinE' j hj).1) (by omega) hWild
  have hξE'_cond : condExp F E' ξE' = bM₁' := (hCond_leE' hb_le).1
  have hPrimeM₁' : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLM₁')) :=
    hdegM₁'.symm ▸ hPrime
  have hWildM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') = p F :=
    hdegM₁'.trans hWild
  have hνM₁'_pow' : νM₁' ^ (Module.finrank L (IntermediateField.extendScalars hLM₁')) = 1 :=
