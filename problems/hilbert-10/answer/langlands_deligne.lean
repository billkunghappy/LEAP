    intro i m y hy
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    rcases hy with rfl | hy
    · rw [neg_zero]; exact Or.inl rfl
    · right
      rw [(ld_valL_and_unitGroup_props F (D_orb.get i).field).2.2.2.1]
      exact hy
  have hPFi_add : ∀ {i : Fin D_orb.length} {m : ℤ} {y₁ y₂ : (D_orb.get i).field},
      PFi i m y₁ → PFi i m y₂ → PFi i m (y₁ + y₂) := by
    intro i m y₁ y₂ hy₁ hy₂
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    exact (ld_valL_and_unitGroup_props F (D_orb.get i).field).2.2.2.2.2.2.2.1 m y₁ y₂ hy₁ hy₂
  have hPFi_sub : ∀ {i : Fin D_orb.length} {m : ℤ} {y₁ y₂ : (D_orb.get i).field},
      PFi i m y₁ → PFi i m y₂ → PFi i m (y₁ - y₂) := by
    intro i m y₁ y₂ hy₁ hy₂
    rw [sub_eq_add_neg]
    exact hPFi_add hy₁ (hPFi_neg hy₂)
  have hPFi_mul : ∀ {i : Fin D_orb.length} {m₁ m₂ : ℤ} {y₁ y₂ : (D_orb.get i).field},
      PFi i m₁ y₁ → PFi i m₂ y₂ → PFi i (m₁ + m₂) (y₁ * y₂) := by
    intro i m₁ m₂ y₁ y₂ hy₁ hy₂
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    by_cases hy₁0 : y₁ = 0
    · left; rw [hy₁0, zero_mul]
    · by_cases hy₂0 : y₂ = 0
      · left; rw [hy₂0, mul_zero]
      · right
        rw [(ld_valL_and_unitGroup_props F (D_orb.get i).field).2.2.2.2.1 y₁ y₂ hy₁0 hy₂0]
        have hy₁' := hy₁.resolve_left hy₁0
        have hy₂' := hy₂.resolve_left hy₂0
        omega

  have hresFi_sub_mem1 : ∀ (i : Fin D_orb.length) {y₁ y₂ : (D_orb.get i).field},
      PFi i 0 y₁ → PFi i 0 y₂ → resFi i y₁ = resFi i y₂ → PFi i 1 (y₁ - y₂) := by
    intro i y₁ y₂ hy₁ hy₂ hres
