        dsimp [D_deg]
        omega
      have halast_eq : a_last (Ψ_v d) = d (Fin.last v) := by
        ext
        dsimp [a_last]
        rw [if_pos ⟨by omega, by omega⟩]
        omega
      dsimp [Φ_v, Ψ_v]
      rw [halast_eq]
      exact Fin.snoc_init_self d
    · intro g hg
      simp only [U_v_mid, U_v_nz, U_v, P0_v, Pmid_v, Finset.mem_coe, Finset.mem_filter,
