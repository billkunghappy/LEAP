            refine ⟨h⁻¹, H.inv_mem hh, h * c⁻¹ * h⁻¹, hC_norm.conj_mem c⁻¹ (C.inv_mem hc) h, by group⟩ }
      have hH_le_S : H ≤ S := fun h hh => ⟨h, hh, 1, C.one_mem, (mul_one h).symm⟩
      have hC_le_S : C ≤ S := fun c hc => ⟨1, H.one_mem, c, hc, (one_mul c).symm⟩
      have h_top_le_S : (⊤ : Subgroup G₀) ≤ S := by
