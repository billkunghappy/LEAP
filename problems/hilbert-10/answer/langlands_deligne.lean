    set x₂ := liftL y₂
    have hx₁ : P 0 x₁ := hliftL_int y₁
    have hx₂ : P 0 x₂ := hliftL_int y₂
    have hx12 : P 0 (x₁ + x₂) := hP_add hx₁ hx₂
    have hmul12 : P 0 (x₁ * x₂) := hP_mono (by omega) (hP_mul hx₁ hx₂)
    have hu₁_ne : 1 + (δ_b : L) * x₁ ≠ 0 := h1_add_ne (hδx_P1 hx₁)
    have hu₂_ne : 1 + (δ_b : L) * x₂ ≠ 0 := h1_add_ne (hδx_P1 hx₂)
    have hu12_ne : 1 + (δ_b : L) * (x₁ + x₂) ≠ 0 := h1_add_ne (hδx_P1 hx12)
    have hδ2_stat : P (r₀ : ℤ) ((δ_b : L) ^ 2 * (x₁ * x₂)) :=
