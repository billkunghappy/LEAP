    dsimp [R_M₁']
    have hInj_M : Set.InjOn (ι_M : L → M₁') R_L := fun _ _ _ _ h => ι_M.injective h
    rw [Finset.sum_image hInj_M]
    refine Finset.sum_congr rfl ?_
    intro s hs
    dsimp only [ι_M]
    have hs_int : s = 0 ∨ 0 ≤ valL F L s := hRL_int s hs
    obtain ⟨r, hr_int, hsr⟩ := hfrob_surj s hs_int
    obtain ⟨hs_L, hs_M, hpt⟩ := hCritPointwise r s hr_int hs_int hsr
    rw [dif_pos hs_M, dif_pos hs_L]
    exact (hpt hs_L hs_M).symm
  have hq_pow :
      (qL F L : Ω F) ^ d₂ * (qL F L : Ω F) ^ e =
        (qL F L : Ω F) ^ d₁ * (qL F L : Ω F) ^ a := by
    rw [← pow_add, ← pow_add, hd_sum]
  rw [hEpsE', hEpsM₁', hEpsνE', hEpsνM₁', heps1_E', heps1_M₁', hqE', hqM₁',
    hRE'_card, hRM₁'_card, hRL_card, hSumEq]
  set S_crit :=
    ∑ r ∈ R_L,
      if hr : 1 + (δ_L : L) * r ≠ 0 then
        (νE' (Units.mk0 (1 + (δ_L : L) * r) hr) : Ω F)⁻¹ *
          ψ (((cνE'⁻¹ : Lˣ) : L) * (δ_L : L) * r)
      else 0
  calc ((qL F L : Ω F) ^ condExpChar F E' ψE' * (qL F L : Ω F) ^ d₂ *
          (θE' cE' : Ω F) * ψE' (((cE'⁻¹ : E'ˣ) : E'))) *
        ((qL F L : Ω F) ^ condExpChar F M₁' ψM₁') *
        ((qL F L : Ω F) ^ condExpChar F L ψ * (qL F L : Ω F) ^ e *
          (νE' cνE' : Ω F) * ψ (((cνE'⁻¹ : Lˣ) : L)) * S_crit)
    _ = (qL F L : Ω F) ^ condExpChar F E' ψE' *
          (qL F L : Ω F) ^ condExpChar F M₁' ψM₁' *
          (qL F L : Ω F) ^ condExpChar F L ψ *
          ((qL F L : Ω F) ^ d₂ * (qL F L : Ω F) ^ e) *
          ((θE' cE' : Ω F) * (νE' cνE' : Ω F) *
            ψE' (((cE'⁻¹ : E'ˣ) : E')) * ψ (((cνE'⁻¹ : Lˣ) : L))) *
          S_crit := by ring
    _ = (qL F L : Ω F) ^ condExpChar F E' ψE' *
          (qL F L : Ω F) ^ condExpChar F M₁' ψM₁' *
          (qL F L : Ω F) ^ condExpChar F L ψ *
          ((qL F L : Ω F) ^ d₁ * (qL F L : Ω F) ^ a) *
          ((θM₁' cM₁' : Ω F) * (νM₁' cνM₁' : Ω F) *
            ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁')) * ψ (((cνM₁'⁻¹ : Lˣ) : L))) *
          S_crit := by
        rw [hq_pow, hPrefactor]
    _ = ((qL F L : Ω F) ^ condExpChar F M₁' ψM₁' * (qL F L : Ω F) ^ d₁ *
          (θM₁' cM₁' : Ω F) * ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁')) * S_crit) *
        ((qL F L : Ω F) ^ condExpChar F E' ψE') *
        ((qL F L : Ω F) ^ condExpChar F L ψ * (qL F L : Ω F) ^ a *
          (νM₁' cνM₁' : Ω F) * ψ (((cνM₁'⁻¹ : Lˣ) : L))) := by ring

theorem ld_ch12_wild_dyadic_odd_max_break_min_cond_comparison (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (χK₁ : relWeil F K₁ →* (Ω F)ˣ)
    (χE' : relWeil F E' →* (Ω F)ˣ)
    (χM₁' : relWeil F M₁' →* (Ω F)ˣ)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνM₁'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLM₁')) ↔ νM₁' x = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hMinM₁' : condExp F L νM₁' ≤ condExp F L νE')
    (hmE'_ge2 : 2 ≤ condExp F E' (recChar F rec E' χE'))
    (hmM₁'_ge2 : 2 ≤ condExp F M₁' (recChar F rec M₁' χM₁'))
    (hθE'_triv : ∀ u ∈ unitGroup F E' (condExp F E' (recChar F rec E' χE')),
      (recChar F rec E' χE') u = 1)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hCommonOrigin :
      ∀ (α : Lˣ) (C : K₁ˣ)
        (htE' : traceLM F hE'K₁ (C : K₁) ≠ 0)
        (htM₁' : traceLM F hM₁'K₁ (C : K₁) ≠ 0),
        let ψE' := traceChar F hLE' ψ
        let ψM₁' := traceChar F hLM₁' ψ
        let θE' := recChar F rec E' χE'
        let θM₁' := recChar F rec M₁' χM₁'
        let cE' : E'ˣ :=
          Units.map (IntermediateField.inclusion hLE').toMonoidHom α *
            (Units.map (normLM F hE'K₁) C)⁻¹
        let cνE' : Lˣ :=
          α * (Units.map (normLM F hLE') (Units.mk0 (traceLM F hE'K₁ (C : K₁)) htE'))⁻¹
        let cM₁' : M₁'ˣ :=
          Units.map (IntermediateField.inclusion hLM₁').toMonoidHom α *
            (Units.map (normLM F hM₁'K₁) C)⁻¹
        let cνM₁' : Lˣ :=
          α * (Units.map (normLM F hLM₁') (Units.mk0 (traceLM F hM₁'K₁ (C : K₁)) htM₁'))⁻¹
        (θE' cE' : Ω F) * (νE' cνE' : Ω F) *
            ψE' (((cE'⁻¹ : E'ˣ) : E')) * ψ (((cνE'⁻¹ : Lˣ) : L)) =
          (θM₁' cM₁' : Ω F) * (νM₁' cνM₁' : Ω F) *
            ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁')) * ψ (((cνM₁'⁻¹ : Lˣ) : L)) ∧
        ∀ (C' : K₁ˣ)
          (htE'' : traceLM F hE'K₁ (C' : K₁) ≠ 0)
          (htM₁'' : traceLM F hM₁'K₁ (C' : K₁) ≠ 0),
          let uE' : E'ˣ := Units.map (normLM F hE'K₁) (C' * C⁻¹)
          let wE' : Lˣ :=
            Units.map (normLM F hLE')
              (Units.mk0 (traceLM F hE'K₁ (C' : K₁)) htE'' *
                (Units.mk0 (traceLM F hE'K₁ (C : K₁)) htE')⁻¹)
          let uM₁' : M₁'ˣ := Units.map (normLM F hM₁'K₁) (C' * C⁻¹)
          let wM₁' : Lˣ :=
            Units.map (normLM F hLM₁')
              (Units.mk0 (traceLM F hM₁'K₁ (C' : K₁)) htM₁'' *
                (Units.mk0 (traceLM F hM₁'K₁ (C : K₁)) htM₁')⁻¹)
          (θE' uE' : Ω F)⁻¹ * ψE' (((cE'⁻¹ : E'ˣ) : E') * ((uE' : E') - 1)) *
              (νE' wE' : Ω F)⁻¹ * ψ (((cνE'⁻¹ : Lˣ) : L) * ((wE' : L) - 1)) =
            (θM₁' uM₁' : Ω F)⁻¹ * ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * ((uM₁' : M₁') - 1)) *
              (νM₁' wM₁' : Ω F)⁻¹ * ψ (((cνM₁'⁻¹ : Lˣ) : L) * ((wM₁' : L) - 1)))
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E)) *
                ∑ r ∈ R_E,
                  if hr : 1 + (δ : E) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                      ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                  else 0))))
    (hqE' : qL F E' = qL F L)
    (hqM₁' : qL F M₁' = qL F L)
    (hval_normE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_normM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (hval_normK₁ : ∀ w : K₁, valL F E' (normLM F hE'K₁ w) = valL F K₁ w ∧
      valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = 2 * valL F L x)
    (hval_E'K₁ : ∀ y : E', valL F K₁ (IntermediateField.inclusion hE'K₁ y) = 2 * valL F E' y)
    (hval_M₁'K₁ : ∀ z : M₁', valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) = 2 * valL F M₁' z)
    (hnE' : condExpChar F E' (traceChar F hLE' ψ) =
      2 * condExpChar F L ψ + (condExp F L νE' : ℤ))
    (hnM₁' : condExpChar F M₁' (traceChar F hLM₁' ψ) =
      2 * condExpChar F L ψ + (condExp F L νM₁' : ℤ))
    (heps1_E' : tateEps F E' 1 (traceChar F hLE' ψ) =
      (qL F L : Ω F) ^ condExpChar F E' (traceChar F hLE' ψ))
    (heps1_M₁' : tateEps F M₁' 1 (traceChar F hLM₁' ψ) =
      (qL F L : Ω F) ^ condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hT1_even : condExp F L νM₁' % 2 = 0)
    (hT2_odd : condExp F L νE' % 2 = 1)
    (hm1_min : condExp F M₁' (recChar F rec M₁' χM₁') = 2 * condExp F L νE' - 1)
    (hm2_min : condExp F E' (recChar F rec E' χE') =
      condExp F L νM₁' + condExp F L νE' - 1)
    (hSpecL : (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1))
    (hSpecE' : ∀ y : E',
      (y = 0 ∨ -condExpChar F E' (traceChar F hLE' ψ) ≤ valL F E' y) →
        (traceChar F hLE' ψ) y = 1)
    (hSpecM₁' : ∀ z : M₁',
      (z = 0 ∨ -condExpChar F M₁' (traceChar F hLM₁' ψ) ≤ valL F M₁' z) →
        (traceChar F hLM₁' ψ) z = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
