    have hfinrank_k : Module.finrank k_L k_M = ℓ := hfinrank_res_M.trans hdegM
    have hχM_pow_ell : ∀ y : k_Mˣ, (χ_M y) ^ ℓ = χ_L (Units.map (Algebra.norm k_L (S := k_M)) y) := by
