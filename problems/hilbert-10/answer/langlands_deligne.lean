            have hy_K' : (cosetRep u₁) (ι_Fi' y) = (cosetRep u₂) (ι_Fi' y) := Subtype.ext hy
            have hy_inv : ((cosetRep u₁)⁻¹ * cosetRep u₂) (ι_Fi' y) = ι_Fi' y := by
              change (cosetRep u₁)⁻¹ ((cosetRep u₂) (ι_Fi' y)) = ι_Fi' y
              rw [← hy_K']
              change ((cosetRep u₁)⁻¹ * cosetRep u₁) (ι_Fi' y) = ι_Fi' y
              rw [inv_mul_cancel, AlgEquiv.one_apply]
            exact congrArg Subtype.val hy_inv
          have h_quot : (QuotientGroup.mk (cosetRep u₁) : G ⧸ M_sub i) =
              QuotientGroup.mk (cosetRep u₂) := QuotientGroup.eq.mpr h_mem
          have h_out1 : (QuotientGroup.mk (cosetRep u₁) : G ⧸ M_sub i) = u₁ :=
            Quotient.out_eq u₁
          have h_out2 : (QuotientGroup.mk (cosetRep u₂) : G ⧸ M_sub i) = u₂ :=
            Quotient.out_eq u₂
          rwa [h_out1, h_out2] at h_quot
        have h_card_Φ_i : Fintype.card (G ⧸ M_sub i) =
            Fintype.card (F_i' →ₐ[L] AlgebraicClosure F) := by
          rw [← Nat.card_eq_fintype_card, (hM_sub_props i).1,
            AlgHom.card L F_i' (AlgebraicClosure F)]
        have hΦ_i_bij : Function.Bijective Φ_i :=
          (Fintype.bijective_iff_injective_and_card Φ_i).mpr ⟨hΦ_i_inj, h_card_Φ_i⟩
        let e_Φ_i : (G ⧸ M_sub i) ≃ (F_i' →ₐ[L] AlgebraicClosure F) :=
          Equiv.ofBijective Φ_i hΦ_i_bij
        let c_i' : F_i' := toExtendScalars F (D_orb.get i).le (c_orb i).1
        have h_prod_eq :
            (∏ u₀ : G ⧸ M_sub i, Φ_i u₀ c_i') =
              ∏ σ : (F_i' →ₐ[L] AlgebraicClosure F), σ c_i' :=
          Fintype.prod_equiv e_Φ_i (fun u₀ => Φ_i u₀ c_i') (fun σ => σ c_i') (fun _ => rfl)
        have h_norm_emb : (algebraMap L (AlgebraicClosure F)) (Algebra.norm L c_i') =
            ∏ σ : (F_i' →ₐ[L] AlgebraicClosure F), σ c_i' :=
          Algebra.norm_eq_prod_embeddings L (AlgebraicClosure F) c_i'
        exact h_prod_eq.trans h_norm_emb.symm
      let toAlg : M_Cˣ →* AlgebraicClosure F :=
        (M_C.val.toMonoidHom).comp (Units.coeHom M_C)
      apply Units.ext
      apply Subtype.ext
      change toAlg (∏ j : Fin (q - 1),
          Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
            (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
              (c_orb (idx_all j)))) =
        toAlg (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
          (∏ i : Fin r_orb, Units.map (normLM F (D_orb.get i).le) (c_orb i)))
      rw [map_prod toAlg]
      have h_lhs_eq :
          (∏ j : Fin (q - 1),
            toAlg (Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
              (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
                (c_orb (idx_all j))))) =
          ∏ j : Fin (q - 1),
            (((cosetRep (u_all j))
              ⟨((c_orb (idx_all j) : (D_orb.get (idx_all j)).field) : AlgebraicClosure F),
                (IntermediateField.mem_extendScalars hLK).mpr
                  (hM_CK (hFiMC (idx_all j) (c_orb (idx_all j)).1.2))⟩ : K') :
              AlgebraicClosure F) :=
        Finset.prod_congr rfl fun j _ => h_term_coe j
      have h_reidx :
          (∏ j : Fin (q - 1),
            (((cosetRep (u_all j))
              ⟨((c_orb (idx_all j) : (D_orb.get (idx_all j)).field) : AlgebraicClosure F),
                (IntermediateField.mem_extendScalars hLK).mpr
                  (hM_CK (hFiMC (idx_all j) (c_orb (idx_all j)).1.2))⟩ : K') :
              AlgebraicClosure F)) =
          ∏ p : (Σ i : Fin r_orb, G ⧸ M_sub i),
            (((cosetRep p.2)
              ⟨((c_orb p.1 : (D_orb.get p.1).field) : AlgebraicClosure F),
                (IntermediateField.mem_extendScalars hLK).mpr
                  (hM_CK (hFiMC p.1 (c_orb p.1).1.2))⟩ : K') :
              AlgebraicClosure F) :=
        Fintype.prod_equiv e_orb _ _ (fun _ => rfl)
      have h_sigma :
          (∏ p : (Σ i : Fin r_orb, G ⧸ M_sub i),
            (((cosetRep p.2)
              ⟨((c_orb p.1 : (D_orb.get p.1).field) : AlgebraicClosure F),
                (IntermediateField.mem_extendScalars hLK).mpr
                  (hM_CK (hFiMC p.1 (c_orb p.1).1.2))⟩ : K') :
              AlgebraicClosure F)) =
          ∏ i : Fin r_orb, ∏ u₀ : G ⧸ M_sub i,
            (((cosetRep u₀)
              ⟨((c_orb i : (D_orb.get i).field) : AlgebraicClosure F),
                (IntermediateField.mem_extendScalars hLK).mpr
                  (hM_CK (hFiMC i (c_orb i).1.2))⟩ : K') :
              AlgebraicClosure F) := by
        simpa using (Finset.prod_sigma' (Finset.univ : Finset (Fin r_orb))
          (fun i => (Finset.univ : Finset (G ⧸ M_sub i)))
          (fun i u₀ => (((cosetRep u₀)
            ⟨((c_orb i : (D_orb.get i).field) : AlgebraicClosure F),
              (IntermediateField.mem_extendScalars hLK).mpr
                (hM_CK (hFiMC i (c_orb i).1.2))⟩ : K') : AlgebraicClosure F))).symm
      let toAlgL : Lˣ →* AlgebraicClosure F := (L.val.toMonoidHom).comp (Units.coeHom L)
      have h_rhs_eq :
          toAlg (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
            (∏ i : Fin r_orb, Units.map (normLM F (D_orb.get i).le) (c_orb i))) =
          ∏ i : Fin r_orb, ((normLM F (D_orb.get i).le (c_orb i).1 : L) : AlgebraicClosure F) := by
        change toAlgL (∏ i : Fin r_orb, Units.map (normLM F (D_orb.get i).le) (c_orb i)) = _
        rw [map_prod toAlgL]
        rfl
      rw [h_lhs_eq, h_reidx, h_sigma, h_rhs_eq]
      exact Finset.prod_congr rfl fun i _ => h_inner_norm i
    exact ⟨ν_all, σ_all, idx_all, hν_inj, hν_props, hNormProd⟩
  exact ⟨hFinL, hFinMC, hFinE, hFinK, hFinFi, hGalMCK, hGalFiK, hSepLE, hSepLFi,
    hψMC, hψE, hψK, hψFi, hLMC_gt1, hq_gt1, hr_pos, hDegSum,
    ⟨χ', hFiMC, μ'_orb, h_low, hχ'_cond, hχ'E_cond,
      fun i => (hOrb_all i).1, hOrbitEnum, hRed⟩⟩

theorem ld_ch14_wild_semidirect_galois_and_frob_package (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C E : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C]
    [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    (h_inf : E ⊓ M_C = L) (h_sup : E ⊔ M_C = K) (hLM_C_lt : L < M_C)
    (hCore : ¬ ∃ (K₁ : IntermediateField F (AlgebraicClosure F)) (hLK₁ : L ≤ K₁),
      K₁ ≤ K ∧ IsGaloisExt F L K₁ ∧ E ≤ K₁ ∧
      Module.finrank L (IntermediateField.extendScalars hLK₁) <
        Module.finrank L (IntermediateField.extendScalars hLK))
    (hGal : IsGaloisExt F L K) (hGalMCK : IsGaloisExt F M_C K)
    (hMin : IsMinimalAbelianNormalSubfield F L K hLK M_C hLM_C hM_CK)
    (h_wild : p F ∣ Module.finrank M_C (IntermediateField.extendScalars hM_CK))
    (hFinE_eq : Module.finrank L (IntermediateField.extendScalars hLE) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK)) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    Nat.Prime (p F) ∧
    (∃ r_exp : ℕ, 1 ≤ r_exp ∧ q = (p F) ^ r_exp) ∧
    (∀ σ ∈ M_C.fixingSubgroup, σ ^ (p F) ∈ K.fixingSubgroup) ∧
    (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ q = 0 ∨ 1 ≤ valL F L (x - s ^ q))) ∧
    (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (p F) = 0 ∨ 1 ≤ valL F L (x - s ^ (p F)))) ∧
    (∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      ∃ s : M_C, (s = 0 ∨ 0 ≤ valL F M_C s) ∧
        (z - s ^ (p F) = 0 ∨ 1 ≤ valL F M_C (z - s ^ (p F)))) ∧
    ∃ (G : Type u) (_ : Group G) (_ : Fintype G) (C H : Subgroup G)
      (act : G → K → K) (act_MC : H → M_C → M_C),
      C.Normal ∧
      (∀ a ∈ C, ∀ b ∈ C, a * b = b * a) ∧
      Nat.card C = q ∧
      Nat.card H = Module.finrank L (IntermediateField.extendScalars hLM_C) ∧
      1 < Nat.card H ∧
      (∀ c ∈ C, c ^ (p F) = 1) ∧
      (∀ g : G, ∃ h ∈ H, ∃ c ∈ C, g = h * c) ∧
      (∀ h ∈ H, (∀ c ∈ C, h * c = c * h) → h = 1) ∧
      (∀ N : Subgroup G, N.Normal → N = ⊥ ∨ C ≤ N) ∧
      (∀ w : K, act 1 w = w) ∧
      (∀ (g₁ g₂ : G) (w : K), act (g₁ * g₂) w = act g₁ (act g₂ w)) ∧
      (∀ g : G,
        act g 0 = 0 ∧ act g 1 = 1 ∧
        (∀ w₁ w₂ : K,
          act g (w₁ + w₂) = act g w₁ + act g w₂ ∧
          act g (w₁ * w₂) = act g w₁ * act g w₂ ∧
          act g (-w₁) = -act g w₁)) ∧
      (∀ (g : G) (x : L),
        act g (IntermediateField.inclusion hLK x) = IntermediateField.inclusion hLK x) ∧
      (∀ g : G, (∀ w : K, act g w = w) → g = 1) ∧
      (∀ (g : G) (w : K), valL F K (act g w) = valL F K w) ∧
      (∀ g : G,
        g ∈ C ↔ ∀ z : M_C,
          act g (IntermediateField.inclusion hM_CK z) =
            IntermediateField.inclusion hM_CK z) ∧
      (∀ w : K,
        (∀ c ∈ C, act c w = w) ↔
          w ∈ Set.range (IntermediateField.inclusion hM_CK)) ∧
      (∀ w : K,
        IntermediateField.inclusion hM_CK (traceLM F hM_CK w) = ∑ c : C, act c.1 w) ∧
      (∀ w : K,
        IntermediateField.inclusion hM_CK (normLM F hM_CK w) = ∏ c : C, act c.1 w) ∧
      (∀ w : K,
        IntermediateField.inclusion hEK (traceLM F hEK w) = ∑ h : H, act h.1 w) ∧
      (∀ (h : H) (y : E),
        act h.1 (IntermediateField.inclusion hEK y) = IntermediateField.inclusion hEK y) ∧
      (∀ z : M_C, act_MC 1 z = z) ∧
      (∀ (h₁ h₂ : H) (z : M_C), act_MC (h₁ * h₂) z = act_MC h₁ (act_MC h₂ z)) ∧
      (∀ h : H,
        act_MC h 0 = 0 ∧ act_MC h 1 = 1 ∧
        (∀ z₁ z₂ : M_C,
          act_MC h (z₁ + z₂) = act_MC h z₁ + act_MC h z₂ ∧
          act_MC h (z₁ * z₂) = act_MC h z₁ * act_MC h z₂ ∧
          act_MC h (-z₁) = -act_MC h z₁)) ∧
      (∀ (h : H) (x : L),
        act_MC h (IntermediateField.inclusion hLM_C x) = IntermediateField.inclusion hLM_C x) ∧
      (∀ (h : H) (z : M_C), valL F M_C (act_MC h z) = valL F M_C z) ∧
      (∀ (h : H) (z : M_C),
        IntermediateField.inclusion hM_CK (act_MC h z) =
          act h.1 (IntermediateField.inclusion hM_CK z)) ∧
      (∀ z : M_C,
        IntermediateField.inclusion hLM_C (traceLM F hLM_C z) = ∑ h : H, act_MC h z) ∧
      (∀ σ ∈ L.fixingSubgroup, ∃ g : G,
        (σ ∈ K.fixingSubgroup ↔ g = 1) ∧
        ∀ w : K, ∀ hσw : (σ : AbsGal F) (w : AlgebraicClosure F) ∈ K,
          act g w = ⟨(σ : AbsGal F) (w : AlgebraicClosure F), hσw⟩) ∧
      (∀ g : G, ∃ σ ∈ L.fixingSubgroup,
        ∀ w : K, ((act g w : K) : AlgebraicClosure F) = (σ : AbsGal F) (w : AlgebraicClosure F)) :=
by
  
  have hIterFrobSurj : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (hp_prime : Nat.Prime (p F))
      (hval1 : valL F M 1 = 0)
      (hval_neg : ∀ x : M, valL F M (-x) = valL F M x)
      (hval_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y)
      (hval_add : ∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y)))
      (halg1 : ∀ a : F, (a = 0 ∨ 1 ≤ addVal F a) →
        (algebraMap F M a = 0 ∨ 1 ≤ valL F M (algebraMap F M a)))
      (k_M : Type u) [Field k_M] [Fintype k_M] (resM : M → k_M)
      (hresM_0 : resM 0 = 0) (hresM_1 : resM 1 = 1)
      (hresM_ring : ∀ x₁ x₂ : M, (x₁ = 0 ∨ 0 ≤ valL F M x₁) → (x₂ = 0 ∨ 0 ≤ valL F M x₂) →
        resM (x₁ + x₂) = resM x₁ + resM x₂ ∧
        resM (x₁ * x₂) = resM x₁ * resM x₂ ∧
        resM (-x₁) = -resM x₁)
      (hresM_ker : ∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) → (resM x = 0 ↔ (x = 0 ∨ 1 ≤ valL F M x)))
      (hresM_surj : ∀ a : k_M, ∃ x : M, (x = 0 ∨ 0 ≤ valL F M x) ∧ resM x = a)
      (m : ℕ) (x : M), (x = 0 ∨ 0 ≤ valL F M x) →
      ∃ s : M, (s = 0 ∨ 0 ≤ valL F M s) ∧
        (x - s ^ ((p F) ^ m) = 0 ∨ 1 ≤ valL F M (x - s ^ ((p F) ^ m))) := by
    intro M _ hp_prime hval1 hval_neg hval_mul hval_add halg1
      k_M _ _ resM hresM_0 hresM_1 hresM_ring hresM_ker hresM_surj m x hx
    let PM (k : ℤ) (z : M) : Prop := z = 0 ∨ k ≤ valL F M z
    have hPM_zero : ∀ k : ℤ, PM k 0 := fun _ => Or.inl rfl
    have hPM_one : PM 0 1 := Or.inr (by rw [hval1])
    have hPM_neg : ∀ {k : ℤ} {z : M}, PM k z → PM k (-z) := by
      intro k z hz
      rcases hz with rfl | hz
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hval_neg]; exact hz)
    have hPM_add : ∀ {k : ℤ} {z₁ z₂ : M}, PM k z₁ → PM k z₂ → PM k (z₁ + z₂) :=
      fun hz₁ hz₂ => hval_add _ _ _ hz₁ hz₂
    have hPM_sub : ∀ {k : ℤ} {z₁ z₂ : M}, PM k z₁ → PM k z₂ → PM k (z₁ - z₂) := by
      intro k z₁ z₂ hz₁ hz₂
      rw [sub_eq_add_neg]
      exact hPM_add hz₁ (hPM_neg hz₂)
    have hPM_mul : ∀ {k₁ k₂ : ℤ} {z₁ z₂ : M}, PM k₁ z₁ → PM k₂ z₂ → PM (k₁ + k₂) (z₁ * z₂) := by
      intro k₁ k₂ z₁ z₂ hz₁ hz₂
      by_cases hz₁0 : z₁ = 0
      · left; rw [hz₁0, zero_mul]
      · by_cases hz₂0 : z₂ = 0
        · left; rw [hz₂0, mul_zero]
        · right
          rw [hval_mul z₁ z₂ hz₁0 hz₂0]
          have h1 := hz₁.resolve_left hz₁0
          have h2 := hz₂.resolve_left hz₂0
          omega
    have hresM_pow : ∀ (z : M) (n : ℕ), PM 0 z → PM 0 (z ^ n) ∧ resM (z ^ n) = (resM z) ^ n := by
      intro z n hz
      induction n with
      | zero =>
        rw [pow_zero, pow_zero, hresM_1]
        exact ⟨hPM_one, rfl⟩
      | succ n ih =>
        have hpow_int : PM 0 (z ^ (n + 1)) := by
          rw [pow_succ, ← zero_add (0 : ℤ)]
          exact hPM_mul ih.1 hz
        refine ⟨hpow_int, ?_⟩
        rw [pow_succ, (hresM_ring (z ^ n) z ih.1 hz).2.1, ih.2, pow_succ]
    have hresM_nat : ∀ n : ℕ, PM 0 (n : M) ∧ resM (n : M) = (n : k_M) := by
      intro n
      induction n with
      | zero =>
        refine ⟨Or.inl Nat.cast_zero, ?_⟩
        rw [Nat.cast_zero, Nat.cast_zero, hresM_0]
      | succ n ih =>
        have hval_succ : PM 0 ((n + 1 : ℕ) : M) := by
          rw [Nat.cast_succ]
          exact hPM_add ih.1 hPM_one
        refine ⟨hval_succ, ?_⟩
        rw [Nat.cast_succ, (hresM_ring (n : M) 1 ih.1 hPM_one).1, ih.2, hresM_1, Nat.cast_succ]
    have hp_valM : PM 1 ((p F : ℕ) : M) := by
      let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
      have hres0 : IsLocalRing.residue 𝒪[F] ((p F : ℕ) : 𝒪[F]) = 0 := by
        rw [map_natCast]
        exact CharP.cast_eq_zero 𝓀[F] (p F)
      have hker : valuation F (((p F : ℕ) : 𝒪[F]) : F) < 1 := by
        rwa [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
          mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one] at hres0
      have hpF : ((p F : ℕ) : F) = 0 ∨ 1 ≤ addVal F ((p F : ℕ) : F) := by
        by_cases hp0 : ((p F : ℕ) : F) = 0
        · exact Or.inl hp0
        · right
          have hφp : φ (valuation F ((p F : ℕ) : F)) ≠ 0 :=
            (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hp0)
          have hlt : φ (valuation F ((p F : ℕ) : F)) < 1 := by
            rw [← map_one φ, map_lt_map_iff φ]
            exact hker
          rw [← WithZero.coe_unzero hφp, ← WithZero.coe_one, WithZero.coe_lt_coe,
            ← Multiplicative.toAdd_lt, toAdd_one] at hlt
          unfold addVal
          rw [dif_neg hp0]
          omega
      have h := halg1 ((p F : ℕ) : F) hpF
      rwa [map_natCast (algebraMap F M) (p F)] at h
    have hp_kM : ((p F : ℕ) : k_M) = 0 := by
      rw [← (hresM_nat (p F)).2]
      exact (hresM_ker ((p F : ℕ) : M) (hresM_nat (p F)).1).mpr hp_valM
    have hfrob_p_inj : Function.Injective (fun a : k_M => a ^ (p F)) := by
      intro a₁ a₂ h
      change a₁ ^ (p F) = a₂ ^ (p F) at h
      set d : k_M := a₁ - a₂
      have ha₁_eq : a₁ = a₂ + d := by dsimp [d]; ring
      have h_exp : (a₂ + d) ^ (p F) =
          (∑ j ∈ Finset.range (p F), a₂ ^ j * d ^ (p F - j) * ((p F).choose j : k_M)) +
            a₂ ^ (p F) := by
        have h1 := add_pow a₂ d (p F)
        rw [Finset.sum_range_succ] at h1
        simp only [Nat.sub_self, pow_zero, mul_one, Nat.choose_self, Nat.cast_one] at h1
        exact h1
      have h_sum_single :
          (∑ j ∈ Finset.range (p F), a₂ ^ j * d ^ (p F - j) * ((p F).choose j : k_M)) =
            d ^ (p F) := by
        have h0 : (∑ j ∈ Finset.range (p F), a₂ ^ j * d ^ (p F - j) * ((p F).choose j : k_M)) =
            a₂ ^ 0 * d ^ (p F - 0) * ((p F).choose 0 : k_M) := by
          refine Finset.sum_eq_single 0 ?_ ?_
          · intro j hj hj0
            rw [Finset.mem_range] at hj
            rcases Nat.Prime.dvd_choose_self hp_prime hj0 hj with ⟨c, hc⟩
            have hch0 : ((p F).choose j : k_M) = 0 := by
              rw [hc, Nat.cast_mul, hp_kM, zero_mul]
            rw [hch0, mul_zero]
          · intro hnot
            exact False.elim (hnot (Finset.mem_range.mpr hp_prime.pos))
        simpa using h0
      have hd_pow : d ^ (p F) = 0 := by
        rw [ha₁_eq, h_exp, h_sum_single] at h
        linear_combination h
      exact sub_eq_zero.mp (eq_zero_of_pow_eq_zero hd_pow)
    have hfrob_p_surj : Function.Surjective (fun a : k_M => a ^ (p F)) :=
      Finite.surjective_of_injective hfrob_p_inj
    have hfrob_m_surj : ∀ n : ℕ, Function.Surjective (fun a : k_M => a ^ ((p F) ^ n)) := by
      intro n
      induction n with
      | zero =>
        intro b
        exact ⟨b, by simp⟩
      | succ n ih =>
        intro b
        obtain ⟨c, hc⟩ := ih b
        obtain ⟨a, ha⟩ := hfrob_p_surj c
