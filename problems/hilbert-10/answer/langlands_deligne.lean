theorem ld_ch12_wild_odd_tot_ram_pk_deficit_tuple_expansion (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLM₁' : L ≤ M₁') (hM₁'K₁ : M₁' ≤ K₁)
    (p : ℕ) (hPrime : Nat.Prime p) (hp_odd : p ≠ 2)
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) = p)
    (bE' bM₁' : ℕ) (hbE'_ge2 : 2 ≤ bE') (hbM₁'_ge2 : 2 ≤ bM₁') (hb_le : bM₁' ≤ bE')
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) = (p : ℤ) * valL F L x)
    (hval_norm_M₁'K₁ : ∀ w : K₁, valL F M₁' (normLM F hM₁'K₁ w) = valL F K₁ w)
    (Δ : K₁ˣ)
    (hΔ_val : valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ))
    (e_Δ : ℕ → M₁')
    (he_Δ_val : ∀ i ∈ Finset.Icc 1 (p - 1),
      e_Δ i = 0 ∨
        ((p - 1 : ℕ) : ℤ) * ((bE' - 1 : ℕ) : ℤ) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ) ≤
          valL F M₁' (e_Δ i))
    (he_Δ_poly : ∀ c : M₁',
      normLM F hM₁'K₁ (1 + IntermediateField.inclusion hM₁'K₁ c * (Δ : K₁)) =
        1 + (∑ i ∈ Finset.Icc 1 (p - 1), c ^ i * e_Δ i) +
          c ^ p * normLM F hM₁'K₁ (Δ : K₁))
    (τ_unit : ℕ → Lˣ)
    (hτ_val0 : ∀ m < p, 0 < m → valL F L (τ_unit m : L) = 0)
    (hτ_p1 : ∀ m < p, 0 < m →
      (τ_unit m : L) ^ (p - 1) - 1 = 0 ∨
        ((3 * p * (2 * bM₁' - 1 + p * (bE' - bM₁')) + 1 : ℕ) : ℤ) ≤
          valL F L ((τ_unit m : L) ^ (p - 1) - 1))
    (hτ_pow_sum : ∀ r ∈ Finset.Icc 1 (2 * (p - 1)),
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      (∑ m ∈ (Finset.range p).erase 0,
          IntermediateField.inclusion hLM₁' (τ_unit m : L) ^ r) -
        (if (p - 1) ∣ r then ((p - 1 : ℕ) : M₁') else 0) = 0 ∨
        ((p * (3 * p * m₁ + 1) : ℕ) : ℤ) ≤
          valL F M₁'
            ((∑ m ∈ (Finset.range p).erase 0,
                IntermediateField.inclusion hLM₁' (τ_unit m : L) ^ r) -
              (if (p - 1) ∣ r then ((p - 1 : ℕ) : M₁') else 0))) :
    let t₁ := bM₁' - 1
    let t₂ := bE' - 1
    let b := normLM F hM₁'K₁ (Δ : K₁)
    let e_fn : ℕ → M₁' := fun i => if i = p then b else (-1 : M₁') ^ (i - 1) * e_Δ i
    let e_def : Fin p → M₁' := fun a => e_fn (p - (a : ℕ))
    let S_prod : ℕ → ℕ → M₁' := fun v w =>
      ∑ d ∈ (Finset.univ : Finset (Fin (v + 1) → Fin p)).filter
          (fun d => (∑ s : Fin (v + 1), (d s : ℕ)) = w),
        ∏ s : Fin (v + 1), e_def (d s)
    ∀ k ∈ Finset.Icc 2 (p - 1),
      let P_k := b ^ k +
        ∑ m ∈ (Finset.range p).erase 0,
          normLM F hM₁'K₁
            ((Δ : K₁) + IntermediateField.inclusion hM₁'K₁
              (IntermediateField.inclusion hLM₁' (τ_unit m : L))) ^ k
      let P_main := ((p : ℕ) : M₁') * b ^ k +
        (if k = p - 1 then ((p - 1 : ℕ) : M₁') else 0) +
        ∑ v ∈ Finset.range (k + 1),
          (-1 : M₁') ^ (p - k + v) * ((p - 1 : ℕ) : M₁') *
            ((k.choose (v + 1) : ℕ) : M₁') * S_prod v (p - k + v)
      P_k - P_main = 0 ∨
        2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (k : ℤ) * (t₁ : ℤ) ≤
          valL F M₁' (P_k - P_main) :=
by
  intro t₁ t₂ b e_fn e_def S_prod
  have ht₁_def : t₁ = bM₁' - 1 := rfl
  have ht₂_def : t₂ = bE' - 1 := rfl
  have hb_def : b = normLM F hM₁'K₁ (Δ : K₁) := rfl
  have he_fn_def : ∀ i : ℕ, e_fn i = if i = p then b else (-1 : M₁') ^ (i - 1) * e_Δ i :=
    fun _ => rfl
  have he_def_def : ∀ a : Fin p, e_def a = e_fn (p - (a : ℕ)) := fun _ => rfl
  have hS_prod_def : ∀ v w : ℕ, S_prod v w =
      ∑ d ∈ (Finset.univ : Finset (Fin (v + 1) → Fin p)).filter
          (fun d => (∑ s : Fin (v + 1), (d s : ℕ)) = w),
        ∏ s : Fin (v + 1), e_def (d s) := fun _ _ => rfl
  obtain ⟨hvalM₁'_0, hvalM₁'_1, hvalM₁'_neg1, hvalM₁'_neg, hvalM₁'_mul, _, _, hvalM₁'_add, _, _, _⟩ :=
    hvalM₁'_props
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hp_ge3 : 3 ≤ p := by omega
  have hp_odd_nat : Odd p := Nat.Prime.odd_of_ne_two hPrime hp_odd
  have hp1_even : Even (p - 1) := Nat.Odd.sub_odd hp_odd_nat odd_one
  have hneg1_p1 : (-1 : M₁') ^ (p - 1) = 1 := Even.neg_one_pow hp1_even
  have ht₁_ge1 : 1 ≤ t₁ := by omega
  have ht₂_ge1 : 1 ≤ t₂ := by omega
  have ht_le : t₁ ≤ t₂ := by omega

  
  have hvalM₁'_sub : ∀ (q : ℤ) (x y : M₁'),
      (x = 0 ∨ q ≤ valL F M₁' x) → (y = 0 ∨ q ≤ valL F M₁' y) →
        (x - y = 0 ∨ q ≤ valL F M₁' (x - y)) := by
    intro q x y hx hy
    rw [sub_eq_add_neg]
    refine hvalM₁'_add q x (-y) hx ?_
    rcases hy with rfl | hy
    · exact Or.inl neg_zero
    · exact Or.inr (by rwa [hvalM₁'_neg])
  have hvalM₁'_mono : ∀ (q₁ q₂ : ℤ) (x : M₁'),
      q₁ ≤ q₂ → (x = 0 ∨ q₂ ≤ valL F M₁' x) → (x = 0 ∨ q₁ ≤ valL F M₁' x) := by
    intro q₁ q₂ x hle hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hle hx)
  have hvalM₁'_mul_ge : ∀ (q₁ q₂ : ℤ) (x y : M₁'),
      (x = 0 ∨ q₁ ≤ valL F M₁' x) → (y = 0 ∨ q₂ ≤ valL F M₁' y) →
        (x * y = 0 ∨ q₁ + q₂ ≤ valL F M₁' (x * y)) := by
    intro q₁ q₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hvalM₁'_mul x y hx0 hy0]
        exact add_le_add (hx.resolve_left hx0) (hy.resolve_left hy0)
  have hvalM₁'_pow_eq : ∀ (x : M₁') (hx : x ≠ 0) (n : ℕ),
      x ^ n ≠ 0 ∧ valL F M₁' (x ^ n) = (n : ℤ) * valL F M₁' x := by
    intro x hx n
    induction n with
    | zero =>
      rw [pow_zero]
      refine ⟨one_ne_zero, ?_⟩
      rw [hvalM₁'_1, Nat.cast_zero, zero_mul]
    | succ n ih =>
      refine ⟨pow_ne_zero (n + 1) hx, ?_⟩
      rw [pow_succ', hvalM₁'_mul x (x ^ n) hx ih.1, ih.2]
      push_cast
      ring
  have hvalM₁'_neg1_pow_mul : ∀ (n : ℕ) (x : M₁'),
      valL F M₁' ((-1 : M₁') ^ n * x) = valL F M₁' x := by
    intro n x
    induction n with
    | zero => rw [pow_zero, one_mul]
    | succ n ih => rw [pow_succ', mul_assoc, neg_one_mul, hvalM₁'_neg, ih]
  have hvalM₁'_neg1_pow_bound : ∀ (n : ℕ) (x : M₁') (q : ℤ),
      (x = 0 ∨ q ≤ valL F M₁' x) →
        ((-1 : M₁') ^ n * x = 0 ∨ q ≤ valL F M₁' ((-1 : M₁') ^ n * x)) := by
    intro n x q hx
    rcases hx with rfl | hx
    · left; rw [mul_zero]
    · right; rwa [hvalM₁'_neg1_pow_mul]
  have hvalM₁'_sum : ∀ {α : Type} (S : Finset α) (f : α → M₁') (q : ℤ),
      (∀ a ∈ S, f a = 0 ∨ q ≤ valL F M₁' (f a)) →
        ((∑ a ∈ S, f a) = 0 ∨ q ≤ valL F M₁' (∑ a ∈ S, f a)) := by
    intro α S f q hf
    induction' S using Finset.induction_on with a S ha ih
    · left; exact Finset.sum_empty
    · rw [Finset.sum_insert ha]
      exact hvalM₁'_add q (f a) (∑ x ∈ S, f x)
        (hf a (Finset.mem_insert_self a S))
        (ih (fun x hx => hf x (Finset.mem_insert_of_mem hx)))
  have hvalM₁'_prod : ∀ {α : Type} (S : Finset α) (f : α → M₁') (g : α → ℤ),
      (∀ a ∈ S, f a = 0 ∨ g a ≤ valL F M₁' (f a)) →
        ((∏ a ∈ S, f a) = 0 ∨ (∑ a ∈ S, g a) ≤ valL F M₁' (∏ a ∈ S, f a)) := by
    intro α S f g hf
    induction' S using Finset.induction_on with a S ha ih
    · right; simp [hvalM₁'_1]
    · rw [Finset.prod_insert ha, Finset.sum_insert ha]
      exact hvalM₁'_mul_ge (g a) (∑ x ∈ S, g x) (f a) (∏ x ∈ S, f x)
        (hf a (Finset.mem_insert_self a S))
        (ih (fun x hx => hf x (Finset.mem_insert_of_mem hx)))
  have hvalM₁'_natCast : ∀ n : ℕ, ((n : ℕ) : M₁') = 0 ∨ (0 : ℤ) ≤ valL F M₁' ((n : ℕ) : M₁') := by
    intro n
    induction n with
    | zero => left; exact Nat.cast_zero
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hvalM₁'_add 0 (n : M₁') 1 ih (Or.inr (by rw [hvalM₁'_1]))

  
  have hb_val : valL F M₁' b = -(t₁ : ℤ) := by
    rw [hb_def, hval_norm_M₁'K₁, hΔ_val, ← ht₁_def]
  have he_def_val_pos : ∀ a : Fin p, (a : ℕ) ≠ 0 →
      e_def a = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - ((p - (a : ℕ) : ℕ) : ℤ) * (t₁ : ℤ) ≤
          valL F M₁' (e_def a) := by
    intro a ha
    have ha_lt : (a : ℕ) < p := a.2
    have hpa_ne : p - (a : ℕ) ≠ p := by omega
    have hpa_mem : p - (a : ℕ) ∈ Finset.Icc 1 (p - 1) :=
      Finset.mem_Icc.mpr ⟨by omega, by omega⟩
    rw [he_def_def, he_fn_def, if_neg hpa_ne]
    have h := he_Δ_val (p - (a : ℕ)) hpa_mem
    rw [← ht₂_def, ← ht₁_def] at h
    exact hvalM₁'_neg1_pow_bound (p - (a : ℕ) - 1) (e_Δ (p - (a : ℕ))) _ h
  have he_def_val_pos' : ∀ a : Fin p, (a : ℕ) ≠ 0 →
      e_def a = 0 ∨
        (((a : ℕ) : ℤ) * (t₁ : ℤ) - (t₁ : ℤ)) +
          ((p - 1 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) ≤ valL F M₁' (e_def a) := by
    intro a ha
    apply hvalM₁'_mono _ _ _ _ (he_def_val_pos a ha)
    have ha_lt : (a : ℕ) < p := a.2
    have hpa : ((p - (a : ℕ) : ℕ) : ℤ) = (p : ℤ) - ((a : ℕ) : ℤ) :=
      Nat.cast_sub (by omega : (a : ℕ) ≤ p)
    have hp1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := Nat.cast_sub (by omega : 1 ≤ p)
    rw [hpa, hp1]
    linarith
  have he_def_val0 : ∀ a : Fin p,
      e_def a = 0 ∨ ((a : ℕ) : ℤ) * (t₁ : ℤ) - (t₁ : ℤ) ≤ valL F M₁' (e_def a) := by
    intro a
    by_cases ha : (a : ℕ) = 0
    · right
      have hpa : p - (a : ℕ) = p := by omega
      rw [he_def_def, hpa, he_fn_def, if_pos rfl, hb_val, ha]
      simp
    · apply hvalM₁'_mono _ _ _ _ (he_def_val_pos' a ha)
      have ht_z : (t₁ : ℤ) ≤ (t₂ : ℤ) := by exact_mod_cast ht_le
      have hdiff : (0 : ℤ) ≤ ((p - 1 : ℕ) : ℤ) * ((t₂ : ℤ) - (t₁ : ℤ)) :=
        mul_nonneg (by positivity) (by linarith)
      linarith

  
  have hnorm_incl : ∀ c : M₁',
      normLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ c) = c ^ p := by
    intro c
    have h1 : normLM F hM₁'K₁ (IntermediateField.inclusion hM₁'K₁ c) =
        (Algebra.norm M₁' (S := IntermediateField.extendScalars hM₁'K₁))
          ((algebraMap M₁' (IntermediateField.extendScalars hM₁'K₁)) c) := rfl
    rw [h1, Algebra.norm_algebraMap, hdegM₁'K₁]
  have hnorm_deficit : ∀ (ξ₀ : M₁'), ξ₀ ≠ 0 →
      normLM F hM₁'K₁ ((Δ : K₁) + IntermediateField.inclusion hM₁'K₁ ξ₀) =
        (∑ a : Fin p, (-1 : M₁') ^ (a : ℕ) * e_def a * ξ₀ ^ (a : ℕ)) + ξ₀ ^ p := by
    intro ξ₀ hξ₀
    have hmul_inv : ξ₀ * ξ₀⁻¹ = 1 := mul_inv_cancel₀ hξ₀
    have hfactor : (Δ : K₁) + IntermediateField.inclusion hM₁'K₁ ξ₀ =
        IntermediateField.inclusion hM₁'K₁ ξ₀ *
          (1 + IntermediateField.inclusion hM₁'K₁ (ξ₀⁻¹) * (Δ : K₁)) := by
      have h1 : IntermediateField.inclusion hM₁'K₁ ξ₀ *
          IntermediateField.inclusion hM₁'K₁ (ξ₀⁻¹) = 1 := by
        rw [← map_mul, hmul_inv, map_one]
      calc (Δ : K₁) + IntermediateField.inclusion hM₁'K₁ ξ₀
          = IntermediateField.inclusion hM₁'K₁ ξ₀ + 1 * (Δ : K₁) := by ring
        _ = IntermediateField.inclusion hM₁'K₁ ξ₀ +
              (IntermediateField.inclusion hM₁'K₁ ξ₀ *
                IntermediateField.inclusion hM₁'K₁ (ξ₀⁻¹)) * (Δ : K₁) := by rw [← h1]
        _ = IntermediateField.inclusion hM₁'K₁ ξ₀ *
              (1 + IntermediateField.inclusion hM₁'K₁ (ξ₀⁻¹) * (Δ : K₁)) := by ring
    have hpow_cancel : ∀ i : ℕ, i ≤ p → ξ₀ ^ p * (ξ₀⁻¹) ^ i = ξ₀ ^ (p - i) := by
      intro i hi
      calc ξ₀ ^ p * (ξ₀⁻¹) ^ i
          = ξ₀ ^ ((p - i) + i) * (ξ₀⁻¹) ^ i := by
              conv_lhs => rw [show p = (p - i) + i by omega]
        _ = ξ₀ ^ (p - i) * (ξ₀ ^ i * (ξ₀⁻¹) ^ i) := by rw [pow_add, mul_assoc]
        _ = ξ₀ ^ (p - i) * (ξ₀ * ξ₀⁻¹) ^ i := by rw [← mul_pow]
        _ = ξ₀ ^ (p - i) := by rw [hmul_inv, one_pow, mul_one]
    rw [hfactor, map_mul, hnorm_incl ξ₀, he_Δ_poly (ξ₀⁻¹), ← hb_def]
    have hsum_cancel :
        ξ₀ ^ p * (∑ i ∈ Finset.Icc 1 (p - 1), (ξ₀⁻¹) ^ i * e_Δ i) =
          ∑ i ∈ Finset.Icc 1 (p - 1), ξ₀ ^ (p - i) * e_Δ i := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun i hi => ?_
      have hi_le : i ≤ p := by
        have h := (Finset.mem_Icc.mp hi).2
        omega
      rw [← mul_assoc, hpow_cancel i hi_le]
    have htop_cancel : ξ₀ ^ p * ((ξ₀⁻¹) ^ p * b) = b := by
      rw [← mul_assoc, hpow_cancel p le_rfl, Nat.sub_self, pow_zero, one_mul]
    have hdef_sum :
        (∑ a : Fin p, (-1 : M₁') ^ (a : ℕ) * e_def a * ξ₀ ^ (a : ℕ)) =
          b + ∑ i ∈ Finset.Icc 1 (p - 1), ξ₀ ^ (p - i) * e_Δ i := by
      change (∑ a : Fin p, (-1 : M₁') ^ (a : ℕ) * e_fn (p - (a : ℕ)) * ξ₀ ^ (a : ℕ)) = _
      rw [Fin.sum_univ_eq_sum_range (fun a : ℕ => (-1 : M₁') ^ a * e_fn (p - a) * ξ₀ ^ a) p]
      have h0_mem : 0 ∈ Finset.range p := Finset.mem_range.mpr hp_pos
      rw [← Finset.add_sum_erase (Finset.range p)
        (fun a : ℕ => (-1 : M₁') ^ a * e_fn (p - a) * ξ₀ ^ a) h0_mem]
      have herase : (Finset.range p).erase 0 = Finset.Icc 1 (p - 1) := by
        ext a
        simp only [Finset.mem_erase, Finset.mem_range, Finset.mem_Icc]
        omega
      have h0_term : (-1 : M₁') ^ 0 * e_fn (p - 0) * ξ₀ ^ 0 = b := by
        rw [Nat.sub_zero, he_fn_def, if_pos rfl]
        ring
      rw [herase, h0_term]
      congr 1
      have hcongr :
          (∑ a ∈ Finset.Icc 1 (p - 1), (-1 : M₁') ^ a * e_fn (p - a) * ξ₀ ^ a) =
          ∑ a ∈ Finset.Icc 1 (p - 1), ξ₀ ^ a * e_Δ (p - a) := by
        refine Finset.sum_congr rfl fun a ha => ?_
        obtain ⟨ha1, ha2⟩ := Finset.mem_Icc.mp ha
        have hpa_ne : p - a ≠ p := by omega
        rw [he_fn_def, if_neg hpa_ne]
        have hsign : (-1 : M₁') ^ a * (-1 : M₁') ^ (p - a - 1) = 1 := by
          rw [← pow_add, show a + (p - a - 1) = p - 1 by omega, hneg1_p1]
        calc (-1 : M₁') ^ a * ((-1 : M₁') ^ (p - a - 1) * e_Δ (p - a)) * ξ₀ ^ a
            = ((-1 : M₁') ^ a * (-1 : M₁') ^ (p - a - 1)) * (ξ₀ ^ a * e_Δ (p - a)) := by ring
          _ = ξ₀ ^ a * e_Δ (p - a) := by rw [hsign, one_mul]
      rw [hcongr]
      refine Finset.sum_nbij' (fun a => p - a) (fun i => p - i) ?_ ?_ ?_ ?_ ?_
      · intro a ha
        simp only [Finset.mem_coe, Finset.mem_Icc] at ha ⊢
        omega
      · intro i hi
        simp only [Finset.mem_coe, Finset.mem_Icc] at hi ⊢
        omega
      · intro a ha
        simp only [Finset.mem_coe, Finset.mem_Icc] at ha
        dsimp only
        omega
      · intro i hi
        simp only [Finset.mem_coe, Finset.mem_Icc] at hi
        dsimp only
        omega
      · intro a ha
        simp only [Finset.mem_coe, Finset.mem_Icc] at ha
        dsimp only
        rw [show p - (p - a) = a by omega]
    calc ξ₀ ^ p * (1 + (∑ i ∈ Finset.Icc 1 (p - 1), (ξ₀⁻¹) ^ i * e_Δ i) + (ξ₀⁻¹) ^ p * b)
        = (ξ₀ ^ p * ((ξ₀⁻¹) ^ p * b) +
            ξ₀ ^ p * (∑ i ∈ Finset.Icc 1 (p - 1), (ξ₀⁻¹) ^ i * e_Δ i)) + ξ₀ ^ p := by ring
      _ = (b + ∑ i ∈ Finset.Icc 1 (p - 1), ξ₀ ^ (p - i) * e_Δ i) + ξ₀ ^ p := by
          rw [htop_cancel, hsum_cancel]
      _ = (∑ a : Fin p, (-1 : M₁') ^ (a : ℕ) * e_def a * ξ₀ ^ (a : ℕ)) + ξ₀ ^ p := by
          rw [← hdef_sum]

  
  let S_τ : Finset ℕ := (Finset.range p).erase 0
  let ξ : ℕ → M₁' := fun m => IntermediateField.inclusion hLM₁' (τ_unit m : L)
  let m₁ : ℕ := 2 * bM₁' - 1 + p * (bE' - bM₁')
  let M_τ : ℤ := ((p * (3 * p * m₁ + 1) : ℕ) : ℤ)
  let ind_τ : ℕ → M₁' := fun E => if (p - 1) ∣ E then ((p - 1 : ℕ) : M₁') else 0
  have hcard_S_τ : S_τ.card = p - 1 := by
    dsimp [S_τ]
    rw [Finset.card_erase_of_mem (Finset.mem_range.mpr hp_pos), Finset.card_range]
  have hξ_ne : ∀ m ∈ S_τ, ξ m ≠ 0 := by
    intro m _ h0
    exact Units.ne_zero (τ_unit m)
      ((IntermediateField.inclusion hLM₁').injective (h0.trans (map_zero _).symm))
  have hξ_pow_val0 : ∀ m ∈ S_τ, ∀ E : ℕ, ξ m ^ E = 0 ∨ (0 : ℤ) ≤ valL F M₁' (ξ m ^ E) := by
    intro m hm E
    have hm_pos : 0 < m := by
      have hne : m ≠ 0 := (Finset.mem_erase.mp hm).1
      omega
    have hm_lt : m < p := Finset.mem_range.mp (Finset.mem_erase.mp hm).2
    have hval0 : valL F M₁' (ξ m) = 0 := by
      dsimp [ξ]
      rw [hval_LM₁', hτ_val0 m hm_lt hm_pos, mul_zero]
    right
    rw [(hvalM₁'_pow_eq (ξ m) (hξ_ne m hm) E).2, hval0, mul_zero]
  have hξ_p1 : ∀ m ∈ S_τ,
      ξ m ^ (p - 1) - 1 = 0 ∨ M_τ ≤ valL F M₁' (ξ m ^ (p - 1) - 1) := by
    intro m hm
    have hm_pos : 0 < m := by
      have hne : m ≠ 0 := (Finset.mem_erase.mp hm).1
      omega
    have hm_lt : m < p := Finset.mem_range.mp (Finset.mem_erase.mp hm).2
    have hincl : ξ m ^ (p - 1) - 1 =
        IntermediateField.inclusion hLM₁' ((τ_unit m : L) ^ (p - 1) - 1) := by
      dsimp [ξ]
      rw [map_sub, map_pow, map_one]
    rw [hincl]
    rcases hτ_p1 m hm_lt hm_pos with h0 | hge
    · left; rw [h0, map_zero]
    · right
      rw [hval_LM₁']
      dsimp [M_τ, m₁] at hge ⊢
      calc ((p * (3 * p * (2 * bM₁' - 1 + p * (bE' - bM₁')) + 1) : ℕ) : ℤ)
          = (p : ℤ) * ((3 * p * (2 * bM₁' - 1 + p * (bE' - bM₁')) + 1 : ℕ) : ℤ) := by
            push_cast; ring
        _ ≤ (p : ℤ) * valL F L ((τ_unit m : L) ^ (p - 1) - 1) :=
            Int.mul_le_mul_of_nonneg_left hge (by omega)
  have hτ_pow_sum_all : ∀ E : ℕ,
      (∑ m ∈ S_τ, ξ m ^ E) - ind_τ E = 0 ∨
        M_τ ≤ valL F M₁' ((∑ m ∈ S_τ, ξ m ^ E) - ind_τ E) := by
    intro E
    induction' E using Nat.strong_induction_on with E ih
    rcases eq_or_ne E 0 with rfl | hE_ne0
    · left
      have hsum0 : (∑ m ∈ S_τ, ξ m ^ 0) = ((p - 1 : ℕ) : M₁') := by
        simp only [pow_zero, Finset.sum_const, hcard_S_τ, nsmul_eq_mul, mul_one]
      have hind0 : ind_τ 0 = ((p - 1 : ℕ) : M₁') := if_pos (dvd_zero (p - 1))
      rw [hsum0, hind0, sub_self]
    · by_cases hE_le : E ≤ p - 1
      · have hE_mem : E ∈ Finset.Icc 1 (2 * (p - 1)) :=
          Finset.mem_Icc.mpr ⟨by omega, by omega⟩
        exact hτ_pow_sum E hE_mem
      · set E' := E - (p - 1)
        have hE'_lt : E' < E := by omega
        have hE_eq : E = E' + (p - 1) := by omega
        have hind_eq : ind_τ E = ind_τ E' := by
          dsimp [ind_τ]
          have hdvd_iff : (p - 1) ∣ E ↔ (p - 1) ∣ E' := by
            conv_lhs => rw [hE_eq]
            exact Nat.dvd_add_self_right
          by_cases hdvd : (p - 1) ∣ E'
          · rw [if_pos (hdvd_iff.mpr hdvd), if_pos hdvd]
          · rw [if_neg (mt hdvd_iff.mp hdvd), if_neg hdvd]
        have hdiff_sum :
            (∑ m ∈ S_τ, ξ m ^ E) - (∑ m ∈ S_τ, ξ m ^ E') = 0 ∨
              M_τ ≤ valL F M₁' ((∑ m ∈ S_τ, ξ m ^ E) - (∑ m ∈ S_τ, ξ m ^ E')) := by
          rw [← Finset.sum_sub_distrib]
          apply hvalM₁'_sum S_τ (fun m => ξ m ^ E - ξ m ^ E') M_τ
          intro m hm
          have hterm : ξ m ^ E - ξ m ^ E' = ξ m ^ E' * (ξ m ^ (p - 1) - 1) := by
            conv_lhs => rw [hE_eq, pow_add]
            ring
          rw [hterm]
          have hmul := hvalM₁'_mul_ge 0 M_τ (ξ m ^ E') (ξ m ^ (p - 1) - 1)
            (hξ_pow_val0 m hm E') (hξ_p1 m hm)
          rwa [zero_add] at hmul
        have hcomb := hvalM₁'_add M_τ
          ((∑ m ∈ S_τ, ξ m ^ E) - (∑ m ∈ S_τ, ξ m ^ E'))
          ((∑ m ∈ S_τ, ξ m ^ E') - ind_τ E')
          hdiff_sum (ih E' hE'_lt)
        have hring :
            ((∑ m ∈ S_τ, ξ m ^ E) - (∑ m ∈ S_τ, ξ m ^ E')) +
              ((∑ m ∈ S_τ, ξ m ^ E') - ind_τ E') =
            (∑ m ∈ S_τ, ξ m ^ E) - ind_τ E := by
          rw [hind_eq]
          ring
        rwa [hring] at hcomb

  
  intro k hk P_k P_main
  obtain ⟨hk_ge2, hk_le_p1⟩ := Finset.mem_Icc.mp hk
  let B_k : ℤ := 2 * ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (k : ℤ) * (t₁ : ℤ)
  let wt : ∀ r : ℕ, (Fin r → Fin p) → ℕ := fun r d => ∑ s : Fin r, (d s : ℕ)
  let prod_e : ∀ r : ℕ, (Fin r → Fin p) → M₁' := fun r d => ∏ s : Fin r, e_def (d s)
  have hmultinom_pow : ∀ (m : ℕ) (r : ℕ),
      (∑ a : Fin p, (-1 : M₁') ^ (a : ℕ) * e_def a * (ξ m) ^ (a : ℕ)) ^ r =
        ∑ d : Fin r → Fin p, (-1 : M₁') ^ (wt r d) * prod_e r d * (ξ m) ^ (wt r d) := by
    intro m r
    have hpow_prod :
