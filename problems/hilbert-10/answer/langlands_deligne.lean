        ((Fintype.bijective_iff_injective_and_card f_pow).mpr ⟨hf_inj, rfl⟩).2
      obtain ⟨a₀, ha₀⟩ := hf_surj (-P.coeff 0)
      have h_root : P.IsRoot a₀ := by
        rw [Polynomial.IsRoot.def, hP_binom, Polynomial.eval_add, Polynomial.eval_pow,
          Polynomial.eval_X, Polynomial.eval_C]
        change f_pow a₀ + P.coeff 0 = 0
        rw [ha₀, neg_add_cancel]
      have h_dvd_lin : Polynomial.X - Polynomial.C a₀ ∣ P :=
        Polynomial.dvd_iff_isRoot.mpr h_root
      have h_assoc :=
        (Irreducible.dvd_irreducible_iff_associated (Polynomial.irreducible_X_sub_C a₀) hP_irr).mp
          h_dvd_lin
      have h_eq_lin : Polynomial.X - Polynomial.C a₀ = P :=
        Polynomial.eq_of_monic_of_associated (Polynomial.monic_X_sub_C a₀) hP_mon h_assoc
      have h_deg1 : (Polynomial.X - Polynomial.C a₀).natDegree = P.natDegree :=
        congr_arg Polynomial.natDegree h_eq_lin
      rw [Polynomial.natDegree_X_sub_C, hP_deg_ell] at h_deg1
      exact hPrime.ne_one h_deg1.symm
  have hNoShiftDvd : ∀ (d : ℕ), 1 ≤ d → d ≤ ℓ → ¬ (f_H ∣ d) →
      ∀ (P P₀ : Polynomial k_L),
        P.Monic → Irreducible P → P.natDegree ∣ d → P.coeff 0 ≠ 0 →
        P₀.Monic → Irreducible P₀ → P₀.natDegree ∣ d →
        ∀ (R : Polynomial k_M), R.Monic → Irreducible R →
          R ∣ Polynomial.map (algebraMap k_L k_M) P →
          ∀ m ∈ (Finset.range ℓ).erase 0,
            ¬ (R ∣ σ_M m (Polynomial.map (algebraMap k_L k_M) P₀)) := by
    intro d hd1 hd_le hndvd P P₀ hP_mon hP_irr hP_dvd_d hP_c0 hP₀_mon hP₀_irr hP₀_dvd_d
      R hR_mon hR_irr hR_dvd m hm_mem h_dvd
    have hm_ne0 : m ≠ 0 := (Finset.mem_erase.mp hm_mem).1
    have hm_lt : m < ℓ := Finset.mem_range.mp (Finset.mem_erase.mp hm_mem).2
    have hmapP₀_mon : (Polynomial.map (algebraMap k_L k_M) P₀).Monic :=
      hP₀_mon.map (algebraMap k_L k_M)
    have hσm_mon : (σ_M m (Polynomial.map (algebraMap k_L k_M) P₀)).Monic :=
      (hσ_mon_deg m _ hmapP₀_mon).1
    obtain ⟨B, hB_eq⟩ := h_dvd
    have hB_mon : B.Monic := by
      apply Polynomial.Monic.of_mul_monic_left hR_mon
      rw [← hB_eq]
      exact hσm_mon
    have h_inv_shift := congr_arg (σ_M (ℓ - m)) hB_eq
    rw [hσ_add (ℓ - m) m _ hmapP₀_mon, Nat.sub_add_cancel (le_of_lt hm_lt), Nat.mod_self,
      hσ_zero _ hmapP₀_mon, hσ_mul (ℓ - m) R B hR_mon hB_mon] at h_inv_shift
    set R' := σ_M (ℓ - m) R
    have hR'_mon : R'.Monic := (hσ_mon_deg (ℓ - m) R hR_mon).1
    have hR'_irr : Irreducible R' := hσ_irr (ℓ - m) R hR_mon hR_irr
    have hR'_dvd : R' ∣ Polynomial.map (algebraMap k_L k_M) P₀ :=
      ⟨σ_M (ℓ - m) B, h_inv_shift⟩
    have hR_fix_P : Polynomial.map (τ_L ^ P.natDegree).toRingHom R = R :=
      hIrrFrobFix P hP_mon hP_irr R hR_mon hR_irr hR_dvd
    have hR'_fix_P₀ : Polynomial.map (τ_L ^ P₀.natDegree).toRingHom R' = R' :=
      hIrrFrobFix P₀ hP₀_mon hP₀_irr R' hR'_mon hR'_irr hR'_dvd
    obtain ⟨u_P, hu_P⟩ := hP_dvd_d
    obtain ⟨u_P₀, hu_P₀⟩ := hP₀_dvd_d
    have hR_fix_d : Polynomial.map (τ_L ^ d).toRingHom R = R := by
      rw [hu_P]
      exact hτ_fix_mul P.natDegree R hR_fix_P u_P
    have hR'_fix_d : Polynomial.map (τ_L ^ d).toRingHom R' = R' := by
      rw [hu_P₀]
      exact hτ_fix_mul P₀.natDegree R' hR'_fix_P₀ u_P₀
    set d' := d % f_H
    have hτ_d_eq : τ_L ^ d = τ_L ^ d' := by
      conv_lhs => rw [← Nat.div_add_mod d f_H]
      rw [pow_add, pow_mul, hτ_pow_fH, one_pow, one_mul]
    have hR_fix_d' : Polynomial.map (τ_L ^ d').toRingHom R = R := by
      rwa [← hτ_d_eq]
    have hR'_fix_d' : Polynomial.map (τ_L ^ d').toRingHom R' = R' := by
      rwa [← hτ_d_eq]
    have hd'_ne0 : d' ≠ 0 := by
      intro h0
      exact hndvd (Nat.dvd_iff_mod_eq_zero.mpr h0)
    have hd'_ge1 : 1 ≤ d' := Nat.one_le_iff_ne_zero.mpr hd'_ne0
    have hd'_lt : d' < f_H := Nat.mod_lt d (by omega)
    set q_L := Fintype.card k_L
    have h_comm_eq : σ_M ((q_L ^ d' * (ℓ - m)) % ℓ) R = σ_M (ℓ - m) R := by
      calc σ_M ((q_L ^ d' * (ℓ - m)) % ℓ) R
          = σ_M ((q_L ^ d' * (ℓ - m)) % ℓ) (Polynomial.map (τ_L ^ d').toRingHom R) := by
            rw [hR_fix_d']
        _ = Polynomial.map (τ_L ^ d').toRingHom (σ_M (ℓ - m) R) :=
            (hτ_σ_comm d' (ℓ - m) R).symm
        _ = σ_M (ℓ - m) R := hR'_fix_d'
    have h_apply_m := congr_arg (σ_M m) h_comm_eq
    rw [hσ_add m ((q_L ^ d' * (ℓ - m)) % ℓ) R hR_mon,
      hσ_add m (ℓ - m) R hR_mon, Nat.add_sub_of_le (le_of_lt hm_lt),
      Nat.mod_self, hσ_zero R hR_mon] at h_apply_m
    set k₀ := (m + (q_L ^ d' * (ℓ - m)) % ℓ) % ℓ
    haveI : Fact (Nat.Prime ℓ) := ⟨hPrime⟩
    haveI : Fact (1 < ℓ) := ⟨hPrime.one_lt⟩
    have h_k₀_zmod : (k₀ : ZMod ℓ) = - (m : ZMod ℓ) * ((q_L ^ d' : ZMod ℓ) - 1) := by
      dsimp [k₀]
      rw [ZMod.natCast_mod, Nat.cast_add, ZMod.natCast_mod, Nat.cast_mul, Nat.cast_pow,
        Nat.cast_sub (le_of_lt hm_lt), ZMod.natCast_self]
      ring
    have hm_zmod_ne : (m : ZMod ℓ) ≠ 0 := by
      intro h0
      have hval := congr_arg ZMod.val h0
      rw [ZMod.val_natCast, Nat.mod_eq_of_lt hm_lt, ZMod.val_zero] at hval
      exact hm_ne0 hval
    have hq_ge1 : 1 ≤ q_L ^ d' := Nat.one_le_pow d' q_L Fintype.card_pos
    have hq_sub_ne : (q_L ^ d' : ZMod ℓ) - 1 ≠ 0 := by
      have h_cast_sub : ((q_L ^ d' - 1 : ℕ) : ZMod ℓ) = (q_L ^ d' : ZMod ℓ) - 1 := by
        rw [Nat.cast_sub hq_ge1, Nat.cast_pow, Nat.cast_one]
      rw [← h_cast_sub, ne_eq, ZMod.natCast_eq_zero_iff]
      exact hNotDvd d' hd'_ge1 hd'_lt
    have hk₀_zmod_ne : (k₀ : ZMod ℓ) ≠ 0 := by
      rw [h_k₀_zmod]
      exact mul_ne_zero (neg_ne_zero.mpr hm_zmod_ne) hq_sub_ne
    let u_inv := ((k₀ : ZMod ℓ)⁻¹).val
    have h_prod_zmod : ((u_inv * k₀ : ℕ) : ZMod ℓ) = 1 := by
      rw [Nat.cast_mul, ZMod.natCast_zmod_val, inv_mul_cancel₀ hk₀_zmod_ne]
    have h_mod_eq : (u_inv * k₀) % ℓ = 1 := by
      have hval := congr_arg ZMod.val h_prod_zmod
      rwa [ZMod.val_natCast, ZMod.val_one] at hval
    have h1_fix := hσ_km k₀ R hR_mon h_apply_m u_inv
    rw [h_mod_eq] at h1_fix
    have hP_deg_le_ell : P.natDegree ≤ ℓ := (Nat.le_of_dvd hd1 ⟨u_P, hu_P⟩).trans hd_le
    exact hNoShiftOne P hP_mon hP_irr hP_deg_le_ell hP_c0 R hR_mon hR_irr hR_dvd h1_fix
  have h_c0_iff : ∀ (d : ℕ) (P : Polynomial k_L), P ∈ M_L d →
      ((𝒩_ℓ_L P).coeff 0 ≠ 0 ↔ P.coeff 0 ≠ 0) := by
    intro d P hP
    have hrel := (h𝒩_L_prop d P hP).2
    have h_neg1 : (-1 : k_L) ^ d ≠ 0 := pow_ne_zero d (neg_ne_zero.mpr one_ne_zero)
    constructor
    · intro hN0 hP0
      apply hN0
      have h1 : (-1 : k_L) ^ d * (𝒩_ℓ_L P).coeff 0 = 0 := by
        rw [hrel, hP0, mul_zero, zero_pow hPrime.ne_zero]
      exact (mul_eq_zero.mp h1).resolve_left h_neg1
    · intro hP0 hN0
      have h1 : ((-1 : k_L) ^ d * P.coeff 0) ^ ℓ = 0 := by
        rw [← hrel, hN0, mul_zero]
      exact mul_ne_zero h_neg1 hP0 (eq_zero_of_pow_eq_zero h1)
  have hFiberLe : ∀ (d : ℕ), 1 ≤ d → d ≤ ℓ → ¬ (f_H ∣ d) →
      ∀ G ∈ (M_L d).filter (fun G => G.coeff 0 ≠ 0),
        (∑ P ∈ (M_L d).filter (fun P => 𝒩_ℓ_L P = G), Λ_L P) ≤ Λ_L G := by
    intro d hd1 hd_le hndvd G hG
    have hG_c0 : G.coeff 0 ≠ 0 := (Finset.mem_filter.mp hG).2
    set fib := (M_L d).filter (fun P => 𝒩_ℓ_L P = G)
    set S_G := fib.filter (fun P => Λ_L P ≠ 0)
    have h_sum_eq : (∑ P ∈ fib, Λ_L P) = ∑ P ∈ S_G, Λ_L P :=
      (Finset.sum_filter_of_ne (fun P _ hΛ => hΛ)).symm
    rw [h_sum_eq]
    by_cases hS_nonempty : S_G.Nonempty
    · obtain ⟨F₀, hF₀_mem⟩ := hS_nonempty
      have hF₀_fib : F₀ ∈ fib := (Finset.mem_filter.mp hF₀_mem).1
      have hF₀_Λ : Λ_L F₀ ≠ 0 := (Finset.mem_filter.mp hF₀_mem).2
      have hF₀_Md : F₀ ∈ M_L d := (Finset.mem_filter.mp hF₀_fib).1
      have hF₀_N : 𝒩_ℓ_L F₀ = G := (Finset.mem_filter.mp hF₀_fib).2
      have hF₀_deg : F₀.natDegree = d := ((hM_L_mem d F₀).mp hF₀_Md).2
      have hF₀_c0 : F₀.coeff 0 ≠ 0 := by
        rw [← h_c0_iff d F₀ hF₀_Md, hF₀_N]
        exact hG_c0
      obtain ⟨P₀, k₀, hP₀_mon, hP₀_irr, hk₀_pos, hF₀_eq⟩ := hΛ_L_ne_zero F₀ hF₀_Λ
      have hF₀_deg_mul : F₀.natDegree = k₀ * P₀.natDegree := by
        rw [hF₀_eq, Polynomial.natDegree_pow' (by rw [hP₀_mon.leadingCoeff, one_pow]; exact one_ne_zero)]
      have hP₀_dvd_d : P₀.natDegree ∣ d := ⟨k₀, by rw [← hF₀_deg, hF₀_deg_mul, mul_comm]⟩
      have hP₀_dvd_F₀ : P₀ ∣ F₀ := by
        rw [hF₀_eq]
        exact dvd_pow_self P₀ (by omega)
      have hP₀_c0 : P₀.coeff 0 ≠ 0 := by
        obtain ⟨C₀, hC₀_eq⟩ := hP₀_dvd_F₀
        have hc0 : F₀.coeff 0 = P₀.coeff 0 * C₀.coeff 0 := by
          rw [hC₀_eq, Polynomial.mul_coeff_zero]
        rw [hc0] at hF₀_c0
        exact left_ne_zero_of_mul hF₀_c0
      set N₀ := 𝒩_ℓ_L P₀
      have hP₀_M : P₀ ∈ M_L P₀.natDegree := (hM_L_mem P₀.natDegree P₀).mpr ⟨hP₀_mon, rfl⟩
      have hN₀_M : N₀ ∈ M_L P₀.natDegree := (h𝒩_L_prop P₀.natDegree P₀ hP₀_M).1
      have hN₀_mon : N₀.Monic := ((hM_L_mem P₀.natDegree N₀).mp hN₀_M).1
      have hN₀_deg : N₀.natDegree = P₀.natDegree := ((hM_L_mem P₀.natDegree N₀).mp hN₀_M).2
      have hN₀_deg_pos : 0 < N₀.natDegree := by
        rw [hN₀_deg]
        exact hP₀_irr.natDegree_pos
      have hN₀_exp : Polynomial.expand k_M ℓ (Polynomial.map (algebraMap k_L k_M) N₀) =
          ∏ m ∈ Finset.range ℓ, σ_M m (Polynomial.map (algebraMap k_L k_M) P₀) :=
        h𝒩_L_exp_map P₀ hP₀_mon
      have hP₀_dvd_exp : ∀ Q' : Polynomial k_L, Q'.Monic → Irreducible Q' → Q' ∣ N₀ →
          P₀ ∣ Polynomial.expand k_L ℓ Q' := by
        intro Q' hQ'_mon hQ'_irr hQ'_dvd
        have hmap_dvd : Polynomial.map (algebraMap k_L k_M) Q' ∣
            Polynomial.map (algebraMap k_L k_M) N₀ :=
          map_dvd (Polynomial.mapRingHom (algebraMap k_L k_M)) hQ'_dvd
        have hexp_dvd : Polynomial.expand k_M ℓ (Polynomial.map (algebraMap k_L k_M) Q') ∣
            ∏ m ∈ Finset.range ℓ, σ_M m (Polynomial.map (algebraMap k_L k_M) P₀) := by
          rw [← hN₀_exp]
          exact map_dvd (Polynomial.expand k_M ℓ) hmap_dvd
        have hexp_mon : (Polynomial.expand k_M ℓ (Polynomial.map (algebraMap k_L k_M) Q')).Monic :=
          (hQ'_mon.map (algebraMap k_L k_M)).expand hPrime.pos
        have hexp_deg : 0 < (Polynomial.expand k_M ℓ (Polynomial.map (algebraMap k_L k_M) Q')).natDegree := by
          rw [Polynomial.natDegree_expand,
            Polynomial.natDegree_map_eq_of_injective (algebraMap k_L k_M).injective Q']
          exact Nat.mul_pos hQ'_irr.natDegree_pos hPrime.pos
        obtain ⟨R₁, hR₁_mon, hR₁_irr, hR₁_dvd_exp⟩ := exists_monic_irr_dvd _ hexp_mon hexp_deg
        have hR₁_dvd_prod : R₁ ∣ ∏ m ∈ Finset.range ℓ, σ_M m (Polynomial.map (algebraMap k_L k_M) P₀) :=
          hR₁_dvd_exp.trans hexp_dvd
        have hR₁_prime : Prime R₁ := UniqueFactorizationMonoid.irreducible_iff_prime.mp hR₁_irr
        obtain ⟨m, hm_mem, hR₁_dvd_σm⟩ := (Prime.dvd_finset_prod_iff hR₁_prime _).mp hR₁_dvd_prod
        have hm_lt : m < ℓ := Finset.mem_range.mp hm_mem
        have hmapP₀_mon : (Polynomial.map (algebraMap k_L k_M) P₀).Monic :=
          hP₀_mon.map (algebraMap k_L k_M)
        have hσm_mon : (σ_M m (Polynomial.map (algebraMap k_L k_M) P₀)).Monic :=
          (hσ_mon_deg m _ hmapP₀_mon).1
        obtain ⟨B₁, hB₁_eq⟩ := hR₁_dvd_σm
        have hB₁_mon : B₁.Monic := by
          apply Polynomial.Monic.of_mul_monic_left hR₁_mon
          rw [← hB₁_eq]
          exact hσm_mon
        have h_apply1 := congr_arg (σ_M (ℓ - m)) hB₁_eq
        rw [hσ_add (ℓ - m) m _ hmapP₀_mon, Nat.sub_add_cancel (le_of_lt hm_lt), Nat.mod_self,
          hσ_zero _ hmapP₀_mon, hσ_mul (ℓ - m) R₁ B₁ hR₁_mon hB₁_mon] at h_apply1
        set R₀ := σ_M (ℓ - m) R₁
        have hR₀_irr : Irreducible R₀ := hσ_irr (ℓ - m) R₁ hR₁_mon hR₁_irr
        have hR₀_dvd_P₀ : R₀ ∣ Polynomial.map (algebraMap k_L k_M) P₀ :=
          ⟨σ_M (ℓ - m) B₁, h_apply1⟩
        obtain ⟨B₂, hB₂_eq⟩ := hR₁_dvd_exp
        have hB₂_mon : B₂.Monic := by
          apply Polynomial.Monic.of_mul_monic_left hR₁_mon
          rw [← hB₂_eq]
          exact hexp_mon
        have h_apply2 := congr_arg (σ_M (ℓ - m)) hB₂_eq
        rw [hσ_expand (ℓ - m) (Polynomial.map (algebraMap k_L k_M) Q') (hQ'_mon.map (algebraMap k_L k_M)),
          hσ_mul (ℓ - m) R₁ B₂ hR₁_mon hB₂_mon] at h_apply2
        have hR₀_dvd_exp : R₀ ∣ Polynomial.map (algebraMap k_L k_M) (Polynomial.expand k_L ℓ Q') := by
          rw [Polynomial.map_expand]
          exact ⟨σ_M (ℓ - m) B₂, h_apply2⟩
        by_contra h_not_dvd
        have hcop : IsCoprime P₀ (Polynomial.expand k_L ℓ Q') :=
          (Irreducible.coprime_iff_not_dvd hP₀_irr).mpr h_not_dvd
        have hcop_map : IsCoprime (Polynomial.map (algebraMap k_L k_M) P₀)
            (Polynomial.map (algebraMap k_L k_M) (Polynomial.expand k_L ℓ Q')) :=
          hcop.map (Polynomial.mapRingHom (algebraMap k_L k_M))
        exact hR₀_irr.not_isUnit (hcop_map.isUnit_of_dvd' hR₀_dvd_P₀ hR₀_dvd_exp)
      obtain ⟨Q₀, hQ₀_mon, hQ₀_irr, hQ₀_dvd_N₀⟩ := exists_monic_irr_dvd N₀ hN₀_mon hN₀_deg_pos
      have hP₀_dvd_expQ₀ : P₀ ∣ Polynomial.expand k_L ℓ Q₀ := hP₀_dvd_exp Q₀ hQ₀_mon hQ₀_irr hQ₀_dvd_N₀
      have hQ₀_unique : ∀ Q' : Polynomial k_L, Q'.Monic → Irreducible Q' → Q' ∣ N₀ → Q' = Q₀ := by
        intro Q' hQ'_mon hQ'_irr hQ'_dvd
        by_contra hne
        have hcop : IsCoprime Q₀ Q' := h_coprime_of_monic_irr_ne hQ₀_mon hQ₀_irr hQ'_mon hQ'_irr (Ne.symm hne)
        have hcop_exp : IsCoprime (Polynomial.expand k_L ℓ Q₀) (Polynomial.expand k_L ℓ Q') :=
          hcop.map (Polynomial.expand k_L ℓ).toRingHom
        have hP₀_dvd_expQ' : P₀ ∣ Polynomial.expand k_L ℓ Q' := hP₀_dvd_exp Q' hQ'_mon hQ'_irr hQ'_dvd
        exact hP₀_irr.not_isUnit (hcop_exp.isUnit_of_dvd' hP₀_dvd_expQ₀ hP₀_dvd_expQ')
      have h_pow_of_dvd : ∀ (n : ℕ) (B : Polynomial k_L),
          B.natDegree = n → B.Monic → B ∣ N₀ → ∃ e : ℕ, B = Q₀ ^ e := by
        intro n
        induction' n using Nat.strong_induction_on with n ih
        intro B hB_deg hB_mon hB_dvd
        by_cases hn0 : n = 0
        · refine ⟨0, ?_⟩
          rw [pow_zero]
          exact Polynomial.eq_one_of_monic_natDegree_zero hB_mon (hB_deg.trans hn0)
        · have hn_pos : 0 < B.natDegree := by rw [hB_deg]; exact Nat.pos_of_ne_zero hn0
          obtain ⟨Q', hQ'_mon, hQ'_irr, hQ'_dvd_B⟩ := exists_monic_irr_dvd B hB_mon hn_pos
          have hQ'_eq : Q' = Q₀ := hQ₀_unique Q' hQ'_mon hQ'_irr (hQ'_dvd_B.trans hB_dvd)
          rw [hQ'_eq] at hQ'_dvd_B
          obtain ⟨B', hB'_eq⟩ := hQ'_dvd_B
          have hB'_mon : B'.Monic := by
            apply Polynomial.Monic.of_mul_monic_left hQ₀_mon
            rw [← hB'_eq]
            exact hB_mon
          have hB'_dvd : B' ∣ N₀ := (dvd_mul_left B' Q₀).trans (hB'_eq ▸ hB_dvd)
          have h_deg_sum : B.natDegree = Q₀.natDegree + B'.natDegree := by
            rw [hB'_eq, hQ₀_mon.natDegree_mul hB'_mon]
          have hQ₀_deg_pos : 0 < Q₀.natDegree := hQ₀_irr.natDegree_pos
          have hB'_lt : B'.natDegree < n := by omega
          obtain ⟨e', he'⟩ := ih B'.natDegree hB'_lt B' rfl hB'_mon hB'_dvd
          refine ⟨e' + 1, ?_⟩
          rw [hB'_eq, he', pow_succ']
      obtain ⟨e₀, hN₀_eq⟩ := h_pow_of_dvd N₀.natDegree N₀ rfl hN₀_mon (dvd_refl N₀)
      have he₀_pos : 1 ≤ e₀ := by
        by_contra h_not
        have he0 : e₀ = 0 := by omega
        rw [he0, pow_zero] at hN₀_eq
        rw [hN₀_eq, Polynomial.natDegree_one] at hN₀_deg_pos
        exact lt_irrefl 0 hN₀_deg_pos
      have he₀_eq1 : e₀ = 1 := by
        by_contra he_ne1
        have he2 : 2 ≤ e₀ := by omega
        obtain ⟨C₀, hC₀_eq⟩ := hP₀_dvd_expQ₀
        have hmap_expQ₀ : Polynomial.expand k_M ℓ (Polynomial.map (algebraMap k_L k_M) Q₀) =
            Polynomial.map (algebraMap k_L k_M) P₀ * Polynomial.map (algebraMap k_L k_M) C₀ := by
          rw [← Polynomial.map_expand, hC₀_eq, Polynomial.map_mul]
        have hmapP₀_mon : (Polynomial.map (algebraMap k_L k_M) P₀).Monic :=
          hP₀_mon.map (algebraMap k_L k_M)
        have hexp_pow : (Polynomial.expand k_M ℓ (Polynomial.map (algebraMap k_L k_M) Q₀)) ^ e₀ =
            Polynomial.map (algebraMap k_L k_M) P₀ *
              ∏ m ∈ (Finset.range ℓ).erase 0, σ_M m (Polynomial.map (algebraMap k_L k_M) P₀) := by
          rw [← map_pow, ← Polynomial.map_pow, ← hN₀_eq, hN₀_exp,
            ← Finset.mul_prod_erase _ _ (Finset.mem_range.mpr hPrime.pos),
            hσ_zero _ hmapP₀_mon]
        have he_split : e₀ = (e₀ - 2) + 2 := (Nat.sub_add_cancel he2).symm
        have hexp2 : (Polynomial.expand k_M ℓ (Polynomial.map (algebraMap k_L k_M) Q₀)) ^ 2 =
            (Polynomial.map (algebraMap k_L k_M) P₀ * Polynomial.map (algebraMap k_L k_M) C₀) ^ 2 := by
          rw [hmap_expQ₀]
        have h_rhs_dvd : Polynomial.map (algebraMap k_L k_M) P₀ *
            (Polynomial.map (algebraMap k_L k_M) P₀ *
              ((Polynomial.map (algebraMap k_L k_M) C₀) ^ 2 *
                (Polynomial.expand k_M ℓ (Polynomial.map (algebraMap k_L k_M) Q₀)) ^ (e₀ - 2))) =
            Polynomial.map (algebraMap k_L k_M) P₀ *
              ∏ m ∈ (Finset.range ℓ).erase 0, σ_M m (Polynomial.map (algebraMap k_L k_M) P₀) := by
          rw [← hexp_pow]
          conv_rhs => rw [he_split, pow_add, hexp2]
          ring
        have h_cancel := mul_left_cancel₀ hmapP₀_mon.ne_zero h_rhs_dvd
        have h_dvd_erase : Polynomial.map (algebraMap k_L k_M) P₀ ∣
            ∏ m ∈ (Finset.range ℓ).erase 0, σ_M m (Polynomial.map (algebraMap k_L k_M) P₀) :=
          ⟨(Polynomial.map (algebraMap k_L k_M) C₀) ^ 2 *
            (Polynomial.expand k_M ℓ (Polynomial.map (algebraMap k_L k_M) Q₀)) ^ (e₀ - 2),
            h_cancel.symm⟩
        have hmapP₀_deg : 0 < (Polynomial.map (algebraMap k_L k_M) P₀).natDegree := by
          rw [Polynomial.natDegree_map_eq_of_injective (algebraMap k_L k_M).injective P₀]
          exact hP₀_irr.natDegree_pos
        obtain ⟨R₀, hR₀_mon, hR₀_irr, hR₀_dvd_P₀⟩ :=
          exists_monic_irr_dvd _ hmapP₀_mon hmapP₀_deg
        have hR₀_prime : Prime R₀ := UniqueFactorizationMonoid.irreducible_iff_prime.mp hR₀_irr
        obtain ⟨m, hm_mem, hR₀_dvd_σm⟩ :=
          (Prime.dvd_finset_prod_iff hR₀_prime _).mp (hR₀_dvd_P₀.trans h_dvd_erase)
        exact hNoShiftDvd d hd1 hd_le hndvd P₀ P₀ hP₀_mon hP₀_irr hP₀_dvd_d hP₀_c0
          hP₀_mon hP₀_irr hP₀_dvd_d R₀ hR₀_mon hR₀_irr hR₀_dvd_P₀ m hm_mem hR₀_dvd_σm
      rw [he₀_eq1, pow_one] at hN₀_eq
      have hQ₀_deg : Q₀.natDegree = P₀.natDegree := by
        rw [← hN₀_eq, hN₀_deg]
      have hG_eq : G = Q₀ ^ k₀ := by
        rw [← hF₀_N, hF₀_eq, h𝒩_L_pow P₀ hP₀_mon k₀, ← hN₀_eq]
      have hΛ_G : Λ_L G = P₀.natDegree := by
        rw [hG_eq, hΛ_L_prime_pow Q₀ k₀ hQ₀_mon hQ₀_irr hk₀_pos, hQ₀_deg]
      have hS_sub : S_G ⊆ {F₀} := by
        intro F hF
        rw [Finset.mem_singleton]
        have hF_fib : F ∈ fib := (Finset.mem_filter.mp hF).1
        have hF_Λ : Λ_L F ≠ 0 := (Finset.mem_filter.mp hF).2
        have hF_Md : F ∈ M_L d := (Finset.mem_filter.mp hF_fib).1
        have hF_N : 𝒩_ℓ_L F = G := (Finset.mem_filter.mp hF_fib).2
        have hF_mon : F.Monic := ((hM_L_mem d F).mp hF_Md).1
        have hF_deg : F.natDegree = d := ((hM_L_mem d F).mp hF_Md).2
        have hF_c0 : F.coeff 0 ≠ 0 := by
          rw [← h_c0_iff d F hF_Md, hF_N]
          exact hG_c0
        obtain ⟨P, k_exp, hP_mon, hP_irr, hk_exp_pos, hF_eq⟩ := hΛ_L_ne_zero F hF_Λ
        have hF_deg_mul : F.natDegree = k_exp * P.natDegree := by
          rw [hF_eq, Polynomial.natDegree_pow' (by rw [hP_mon.leadingCoeff, one_pow]; exact one_ne_zero)]
        have hP_dvd_d : P.natDegree ∣ d := ⟨k_exp, by rw [← hF_deg, hF_deg_mul, mul_comm]⟩
        have hP_dvd_F : P ∣ F := by
          rw [hF_eq]
          exact dvd_pow_self P (by omega)
        have hP_c0 : P.coeff 0 ≠ 0 := by
          obtain ⟨C_P, hC_P_eq⟩ := hP_dvd_F
          have hc0 : F.coeff 0 = P.coeff 0 * C_P.coeff 0 := by
            rw [hC_P_eq, Polynomial.mul_coeff_zero]
          rw [hc0] at hF_c0
          exact left_ne_zero_of_mul hF_c0
        have hmapP_mon : (Polynomial.map (algebraMap k_L k_M) P).Monic :=
          hP_mon.map (algebraMap k_L k_M)
        have hmapP_deg : 0 < (Polynomial.map (algebraMap k_L k_M) P).natDegree := by
          rw [Polynomial.natDegree_map_eq_of_injective (algebraMap k_L k_M).injective P]
          exact hP_irr.natDegree_pos
        obtain ⟨R, hR_mon, hR_irr, hR_dvd_P⟩ := exists_monic_irr_dvd _ hmapP_mon hmapP_deg
        have hmapP_dvd_F : Polynomial.map (algebraMap k_L k_M) P ∣
            Polynomial.map (algebraMap k_L k_M) F :=
          map_dvd (Polynomial.mapRingHom (algebraMap k_L k_M)) hP_dvd_F
        have hmapF_mon : (Polynomial.map (algebraMap k_L k_M) F).Monic :=
          hF_mon.map (algebraMap k_L k_M)
        have hmapF_dvd_expG : Polynomial.map (algebraMap k_L k_M) F ∣
            Polynomial.expand k_M ℓ (Polynomial.map (algebraMap k_L k_M) G) := by
          rw [← hF_N, h𝒩_L_exp_map F hF_mon]
          conv_lhs => rw [← hσ_zero _ hmapF_mon]
          exact Finset.dvd_prod_of_mem _ (Finset.mem_range.mpr hPrime.pos)
        have hexpG_eq : Polynomial.expand k_M ℓ (Polynomial.map (algebraMap k_L k_M) G) =
            (∏ m ∈ Finset.range ℓ, σ_M m (Polynomial.map (algebraMap k_L k_M) P₀)) ^ k₀ := by
          rw [← hF₀_N, hF₀_eq, h𝒩_L_pow P₀ hP₀_mon k₀, Polynomial.map_pow, map_pow, ← hN₀_exp]
        have hR_dvd_pow : R ∣ (∏ m ∈ Finset.range ℓ, σ_M m (Polynomial.map (algebraMap k_L k_M) P₀)) ^ k₀ := by
          rw [← hexpG_eq]
          exact hR_dvd_P.trans (hmapP_dvd_F.trans hmapF_dvd_expG)
        have hR_prime : Prime R := UniqueFactorizationMonoid.irreducible_iff_prime.mp hR_irr
        have hR_dvd_prod : R ∣ ∏ m ∈ Finset.range ℓ, σ_M m (Polynomial.map (algebraMap k_L k_M) P₀) :=
          hR_prime.dvd_of_dvd_pow hR_dvd_pow
        obtain ⟨m, hm_mem, hR_dvd_σm⟩ := (Prime.dvd_finset_prod_iff hR_prime _).mp hR_dvd_prod
        have hm_eq0 : m = 0 := by
          by_contra hm_ne0
          have hm_erase : m ∈ (Finset.range ℓ).erase 0 := Finset.mem_erase.mpr ⟨hm_ne0, hm_mem⟩
          exact hNoShiftDvd d hd1 hd_le hndvd P P₀ hP_mon hP_irr hP_dvd_d hP_c0
            hP₀_mon hP₀_irr hP₀_dvd_d R hR_mon hR_irr hR_dvd_P m hm_erase hR_dvd_σm
        rw [hm_eq0, hσ_zero _ (hP₀_mon.map (algebraMap k_L k_M))] at hR_dvd_σm
        have hP_eq_P₀ : P = P₀ := by
          by_contra hne
          have hcop : IsCoprime P P₀ := h_coprime_of_monic_irr_ne hP_mon hP_irr hP₀_mon hP₀_irr hne
          have hcop_map : IsCoprime (Polynomial.map (algebraMap k_L k_M) P)
              (Polynomial.map (algebraMap k_L k_M) P₀) :=
            hcop.map (Polynomial.mapRingHom (algebraMap k_L k_M))
          exact hR_irr.not_isUnit (hcop_map.isUnit_of_dvd' hR_dvd_P hR_dvd_σm)
        have hk_eq : k_exp = k₀ := by
          apply Nat.mul_right_cancel hP₀_irr.natDegree_pos
          calc k_exp * P₀.natDegree = k_exp * P.natDegree := by rw [hP_eq_P₀]
            _ = F.natDegree := hF_deg_mul.symm
            _ = d := hF_deg
            _ = F₀.natDegree := hF₀_deg.symm
            _ = k₀ * P₀.natDegree := hF₀_deg_mul
        rw [hF_eq, hF₀_eq, hP_eq_P₀, hk_eq]
      have h_sum_le : (∑ P ∈ S_G, Λ_L P) ≤ ∑ P ∈ ({F₀} : Finset (Polynomial k_L)), Λ_L P :=
        Finset.sum_le_sum_of_subset hS_sub
      rw [Finset.sum_singleton, hF₀_eq, hΛ_L_prime_pow P₀ k₀ hP₀_mon hP₀_irr hk₀_pos, ← hΛ_G] at h_sum_le
      exact h_sum_le
    · rw [Finset.not_nonempty_iff_eq_empty.mp hS_nonempty, Finset.sum_empty]
      exact Nat.zero_le _
  have hGlobalSumEq : ∀ (d : ℕ),
      (∑ G ∈ (M_L d).filter (fun G => G.coeff 0 ≠ 0),
        (∑ P ∈ (M_L d).filter (fun P => 𝒩_ℓ_L P = G), Λ_L P)) =
      ∑ G ∈ (M_L d).filter (fun G => G.coeff 0 ≠ 0), Λ_L G := by
    intro d
    set M_nz := (M_L d).filter (fun G => G.coeff 0 ≠ 0)
    have h_maps : ∀ P ∈ M_nz, 𝒩_ℓ_L P ∈ M_nz := by
      intro P hP
      rw [Finset.mem_filter] at hP ⊢
      exact ⟨(h𝒩_L_prop d P hP.1).1, (h_c0_iff d P hP.1).mpr hP.2⟩
    have h_filt_eq : ∀ G ∈ M_nz,
        (M_L d).filter (fun P => 𝒩_ℓ_L P = G) = M_nz.filter (fun P => 𝒩_ℓ_L P = G) := by
      intro G hG
      have hG_nz : G.coeff 0 ≠ 0 := (Finset.mem_filter.mp hG).2
      ext P
      simp only [M_nz, Finset.mem_filter]
      constructor
      · rintro ⟨hP1, hP2⟩
        refine ⟨⟨hP1, ?_⟩, hP2⟩
        rw [← h_c0_iff d P hP1, hP2]
        exact hG_nz
      · rintro ⟨⟨hP1, _⟩, hP2⟩
        exact ⟨hP1, hP2⟩
    calc (∑ G ∈ M_nz, ∑ P ∈ (M_L d).filter (fun P => 𝒩_ℓ_L P = G), Λ_L P)
        = ∑ G ∈ M_nz, ∑ P ∈ M_nz.filter (fun P => 𝒩_ℓ_L P = G), Λ_L P := by
          apply Finset.sum_congr rfl
          intro G hG
          rw [h_filt_eq G hG]
      _ = ∑ G ∈ M_nz, Λ_L G := Finset.sum_fiberwise_of_maps_to h_maps _
  intro d hd1 hd_le hndvd G hG
  exact (Finset.sum_eq_sum_iff_of_le (hFiberLe d hd1 hd_le hndvd)).mp (hGlobalSumEq d) G hG

theorem ld_ch13_orbit_gauss_frob_and_power_sums (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (k_L k_M : Type u) [Field k_L] [Fintype k_L] [Field k_M] [Fintype k_M]
    [Algebra k_L k_M]
    (ℓ f_H r : ℕ) (hPrime : Nat.Prime ℓ)
    (hf_H_gt1 : 1 < f_H) (hr_pos : 1 ≤ r)
    (hfinrank : Module.finrank k_L k_M = f_H)
    (hNotDvd : ∀ d : ℕ, 1 ≤ d → d < f_H → ¬ (ℓ ∣ ((Fintype.card k_L) ^ d - 1)))
    (hcard_Hf : ((Finset.range ℓ).filter (fun c : ℕ => c ≠ 0 ∧ c ^ f_H % ℓ = 1)).card = f_H)
    (ψ_k : AddChar k_L (Ω F)) (hψ_k : ψ_k ≠ 1)
    (μ_tilde : Fin r → (k_Mˣ →* (Ω F)ˣ))
    (hμ_props : ∀ i : Fin r, (μ_tilde i) ^ ℓ = 1 ∧ μ_tilde i ≠ 1)
    (hμ_orb_sum : ∀ y : k_Mˣ,
      1 + (∑ i : Fin r,
        ∑ c ∈ (Finset.range ℓ).filter (fun c : ℕ => c ≠ 0 ∧ c ^ f_H % ℓ = 1),
          (((μ_tilde i) ^ c) y : Ω F)) =
        ∑ j ∈ Finset.range ℓ, (((μ_tilde ⟨0, hr_pos⟩) ^ j) y : Ω F))
    (ζ : k_M) (hζ_ne : ζ ≠ 0) (hζ_pow : ζ ^ ℓ = 1)
    (hζ_prim : ∀ r : ℕ, 1 ≤ r → r < ℓ → ζ ^ r ≠ 1)
    (hν_orth : ∀ u : k_Mˣ,
      (∑ j ∈ Finset.range ℓ, (((μ_tilde ⟨0, hr_pos⟩) ^ j) u : Ω F)) =
        ((Finset.univ.filter (fun y : k_M => y ^ ℓ = (u : k_M))).card : Ω F) ∧
      ((∃ y : k_M, y ^ ℓ = (u : k_M)) →
        (Finset.univ.filter (fun y : k_M => y ^ ℓ = (u : k_M))).card = ℓ))
    (M_L : ℕ → Finset (Polynomial k_L)) (Λ_L : Polynomial k_L → ℕ)
    (hM_L_mem : ∀ (d : ℕ) (f : Polynomial k_L), f ∈ M_L d ↔ f.Monic ∧ f.natDegree = d)
    (hΛ_L_dh : ∀ (α : k_Lˣ →* (Ω F)ˣ) (ψ : AddChar k_L (Ω F)), ψ ≠ 1 →
      ∀ (d : ℕ), 1 ≤ d →
        (∑ G ∈ M_L d,
          (Λ_L G : Ω F) *
            ((if h : (-1 : k_L) ^ G.natDegree * G.coeff 0 ≠ 0 then
                (α (Units.mk0 ((-1 : k_L) ^ G.natDegree * G.coeff 0) h) : Ω F)
              else 0) *
              ψ (-G.nextCoeff))) =
          (-1 : Ω F) ^ (d - 1) *
            (∑ x : k_Lˣ, (α x : Ω F) * ψ (x : k_L)) ^ d)
    (M_M : ℕ → Finset (Polynomial k_M)) (Λ_M : Polynomial k_M → ℕ)
    (hM_M_mem : ∀ (d : ℕ) (f : Polynomial k_M), f ∈ M_M d ↔ f.Monic ∧ f.natDegree = d)
    (hΛ_M_dh : ∀ (α : k_Mˣ →* (Ω F)ˣ) (ψ : AddChar k_M (Ω F)), ψ ≠ 1 →
      ∀ (d : ℕ), 1 ≤ d →
        (∑ G ∈ M_M d,
          (Λ_M G : Ω F) *
            ((if h : (-1 : k_M) ^ G.natDegree * G.coeff 0 ≠ 0 then
                (α (Units.mk0 ((-1 : k_M) ^ G.natDegree * G.coeff 0) h) : Ω F)
              else 0) *
              ψ (-G.nextCoeff))) =
          (-1 : Ω F) ^ (d - 1) *
            (∑ y : k_Mˣ, (α y : Ω F) * ψ (y : k_M)) ^ d)
    (𝒩_ℓ_M : Polynomial k_M → Polynomial k_M)
    (h𝒩_M_prop : ∀ (d : ℕ) (P : Polynomial k_M), P ∈ M_M d →
      𝒩_ℓ_M P ∈ M_M d ∧
      (-1 : k_M) ^ d * (𝒩_ℓ_M P).coeff 0 = ((-1 : k_M) ^ d * P.coeff 0) ^ ℓ)
    (hFiber_M : ∀ (d : ℕ), 1 ≤ d → ∀ G ∈ (M_M d).filter (fun G => G.coeff 0 ≠ 0),
      (∑ P ∈ (M_M d).filter (fun P => 𝒩_ℓ_M P = G), Λ_M P) =
        Λ_M G * (Finset.univ.filter (fun y : k_M => y ^ ℓ = (-1 : k_M) ^ d * G.coeff 0)).card)
    (τ_L : k_M ≃ₐ[k_L] k_M) (𝒩_ℓ_L : Polynomial k_L → Polynomial k_L)
    (N_Γ : Polynomial k_M → Polynomial k_L)
    (hτ_pow : ∀ (s : ℕ) (y : k_M), (τ_L ^ s) y = y ^ ((Fintype.card k_L) ^ s))
    (hτ_pow_fH : τ_L ^ f_H = 1)
    (h𝒩_L_prop : ∀ (d : ℕ) (P : Polynomial k_L), P ∈ M_L d →
      𝒩_ℓ_L P ∈ M_L d ∧
      (-1 : k_L) ^ d * (𝒩_ℓ_L P).coeff 0 = ((-1 : k_L) ^ d * P.coeff 0) ^ ℓ)
    (hN_Gamma_prop : ∀ (m : ℕ) (Q : Polynomial k_M), Q ∈ M_M m →
      N_Γ Q ∈ M_L (f_H * m) ∧
      (-1 : k_L) ^ (f_H * m) * (N_Γ Q).coeff 0 =
        Algebra.norm k_L ((-1 : k_M) ^ m * Q.coeff 0) ∧
      -(N_Γ Q).nextCoeff = Algebra.trace k_L k_M (-Q.nextCoeff) ∧
      N_Γ (𝒩_ℓ_M Q) = 𝒩_ℓ_L (N_Γ Q))
    (hFiber_Gamma : ∀ (m : ℕ), 1 ≤ m →
      ∀ P ∈ (M_L (f_H * m)).filter (fun P => P.coeff 0 ≠ 0),
        (∑ Q ∈ (M_M m).filter (fun Q => N_Γ Q = P), Λ_M Q) = Λ_L P)
    (hFiber_L_nondiv : ∀ (d : ℕ), 1 ≤ d → d ≤ ℓ → ¬ (f_H ∣ d) →
      ∀ G ∈ (M_L d).filter (fun G => G.coeff 0 ≠ 0),
        (∑ P ∈ (M_L d).filter (fun P => 𝒩_ℓ_L P = G), Λ_L P) = Λ_L G) :
    ∀ (α : k_Lˣ →* (Ω F)ˣ) (d : ℕ), 1 ≤ d → d ≤ ℓ →
      (∑ P ∈ M_L d,
        (Λ_L P : Ω F) *
          ((if h : (-1 : k_L) ^ (𝒩_ℓ_L P).natDegree * (𝒩_ℓ_L P).coeff 0 ≠ 0 then
              (α (Units.mk0 ((-1 : k_L) ^ (𝒩_ℓ_L P).natDegree * (𝒩_ℓ_L P).coeff 0) h) : Ω F)
            else 0) *
            ψ_k (-(𝒩_ℓ_L P).nextCoeff))) =
        (-1 : Ω F) ^ (d - 1) * (∑ x : k_Lˣ, (α x : Ω F) * ψ_k (x : k_L)) ^ d +
          (if f_H ∣ d then
            (f_H : Ω F) *
              ∑ i : Fin r,
                (-1 : Ω F) ^ (d / f_H - 1) *
                  (∑ y : k_Mˣ,
                    ((μ_tilde i * α.comp (Units.map (Algebra.norm k_L (S := k_M)))) y : Ω F) *
                      ψ_k (Algebra.trace k_L k_M (y : k_M))) ^ (d / f_H)
           else 0) :=
by
  let ψ_M : AddChar k_M (Ω F) := ψ_k.compAddMonoidHom (Algebra.trace k_L k_M).toAddMonoidHom
  have hψ_M : ψ_M ≠ 1 := by
    haveI : Algebra.IsAlgebraic k_L k_M := Algebra.IsAlgebraic.of_finite k_L k_M
    have h_surj : Function.Surjective (Algebra.trace k_L k_M) := Algebra.trace_surjective k_L k_M
    intro h_eq
    apply hψ_k
    ext x
    obtain ⟨y, rfl⟩ := h_surj x
    exact DFunLike.congr_fun h_eq y
  have h_s1 : ∀ (α : k_Lˣ →* (Ω F)ˣ) (m : ℕ), 1 ≤ m →
      (∑ P ∈ M_L (f_H * m),
        (Λ_L P : Ω F) *
          ((if h : (-1 : k_L) ^ (𝒩_ℓ_L P).natDegree * (𝒩_ℓ_L P).coeff 0 ≠ 0 then
              (α (Units.mk0 ((-1 : k_L) ^ (𝒩_ℓ_L P).natDegree * (𝒩_ℓ_L P).coeff 0) h) : Ω F)
            else 0) *
            ψ_k (-(𝒩_ℓ_L P).nextCoeff))) =
        (∑ Q ∈ M_M m,
          (Λ_M Q : Ω F) *
            ((if h : (-1 : k_M) ^ (𝒩_ℓ_M Q).natDegree * (𝒩_ℓ_M Q).coeff 0 ≠ 0 then
                ((α.comp (Units.map (Algebra.norm k_L (S := k_M))))
                  (Units.mk0 ((-1 : k_M) ^ (𝒩_ℓ_M Q).natDegree * (𝒩_ℓ_M Q).coeff 0) h) : Ω F)
              else 0) *
              ψ_M (-(𝒩_ℓ_M Q).nextCoeff))) ∧
      (-1 : Ω F) ^ (m - 1) *
        (∑ y : k_Mˣ,
          ((α.comp (Units.map (Algebra.norm k_L (S := k_M)))) y : Ω F) *
            ψ_M (y : k_M)) ^ m =
        (-1 : Ω F) ^ (f_H * m - 1) *
          (∑ x : k_Lˣ, (α x : Ω F) * ψ_k (x : k_L)) ^ (f_H * m) := by
    intro α m hm
    let α_M : k_Mˣ →* (Ω F)ˣ := α.comp (Units.map (Algebra.norm k_L (S := k_M)))
    let lam_L : Polynomial k_L → Ω F := fun G =>
      (if h : (-1 : k_L) ^ G.natDegree * G.coeff 0 ≠ 0 then
        (α (Units.mk0 ((-1 : k_L) ^ G.natDegree * G.coeff 0) h) : Ω F)
      else 0) * ψ_k (-G.nextCoeff)
    let lam_M : Polynomial k_M → Ω F := fun G =>
      (if h : (-1 : k_M) ^ G.natDegree * G.coeff 0 ≠ 0 then
        (α_M (Units.mk0 ((-1 : k_M) ^ G.natDegree * G.coeff 0) h) : Ω F)
      else 0) * ψ_M (-G.nextCoeff)
    have hlam_L_c0_zero : ∀ G : Polynomial k_L, G.coeff 0 = 0 → lam_L G = 0 := by
      intro G hG0
      dsimp [lam_L]
      have h0 : (-1 : k_L) ^ G.natDegree * G.coeff 0 = 0 := by rw [hG0, mul_zero]
      rw [dif_neg (not_not.mpr h0), zero_mul]
    have hN_Gamma_c0_iff : ∀ Q ∈ M_M m, (N_Γ Q).coeff 0 ≠ 0 ↔ Q.coeff 0 ≠ 0 := by
      intro Q hQ
      have hrel := (hN_Gamma_prop m Q hQ).2.1
      have h_neg1_L : (-1 : k_L) ^ (f_H * m) ≠ 0 := pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)
      have h_neg1_M : (-1 : k_M) ^ m ≠ 0 := pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)
      constructor
      · intro hN0 hQ0
        apply hN0
        have h1 : (-1 : k_L) ^ (f_H * m) * (N_Γ Q).coeff 0 = 0 := by
          rw [hrel, hQ0, mul_zero, Algebra.norm_eq_zero_iff.mpr rfl]
        exact (mul_eq_zero.mp h1).resolve_left h_neg1_L
      · intro hQ0 hN0
        have h1 : Algebra.norm k_L ((-1 : k_M) ^ m * Q.coeff 0) = 0 := by
          rw [← hrel, hN0, mul_zero]
        exact mul_ne_zero h_neg1_M hQ0 (Algebra.norm_eq_zero_iff.mp h1)
    have hlam_N_Gamma : ∀ Q ∈ M_M m, lam_L (N_Γ Q) = lam_M Q := by
      intro Q hQ
      dsimp [lam_L, lam_M]
      have hQ_deg : Q.natDegree = m := ((hM_M_mem m Q).mp hQ).2
      have hNQ_mem : N_Γ Q ∈ M_L (f_H * m) := (hN_Gamma_prop m Q hQ).1
      have hNQ_deg : (N_Γ Q).natDegree = f_H * m := ((hM_L_mem (f_H * m) (N_Γ Q)).mp hNQ_mem).2
      have h_c0 := (hN_Gamma_prop m Q hQ).2.1
      have h_next := (hN_Gamma_prop m Q hQ).2.2.1
      have hψ_eq : ψ_k (-(N_Γ Q).nextCoeff) = ψ_M (-Q.nextCoeff) := by
        rw [h_next]
        rfl
      rw [hψ_eq]
      congr 1
      set c_L := (-1 : k_L) ^ (N_Γ Q).natDegree * (N_Γ Q).coeff 0
      set c_M := (-1 : k_M) ^ Q.natDegree * Q.coeff 0
      have hc_eq : c_L = Algebra.norm k_L c_M := by
        dsimp [c_L, c_M]
        rw [hNQ_deg, hQ_deg, h_c0]
      by_cases hcM : c_M = 0
      · have hcL : c_L = 0 := by rw [hc_eq, hcM, Algebra.norm_eq_zero_iff.mpr rfl]
        rw [dif_neg (not_not.mpr hcL), dif_neg (not_not.mpr hcM)]
      · have hcL : c_L ≠ 0 := by
          rw [hc_eq]
          exact mt Algebra.norm_eq_zero_iff.mp hcM
        rw [dif_pos hcL, dif_pos hcM]
        have hu : Units.mk0 c_L hcL = Units.map (Algebra.norm k_L (S := k_M)) (Units.mk0 c_M hcM) := by
          ext
          exact hc_eq
        rw [hu]
        rfl
    have hFiber_sum : ∀ f : Polynomial k_L → Ω F,
        (∀ P ∈ M_L (f_H * m), P.coeff 0 = 0 → f P = 0) →
        (∑ P ∈ M_L (f_H * m), (Λ_L P : Ω F) * f P) =
          ∑ Q ∈ M_M m, (Λ_M Q : Ω F) * f (N_Γ Q) := by
      intro f hf0
      set M_L_nz := (M_L (f_H * m)).filter (fun P => P.coeff 0 ≠ 0)
      set M_M_nz := (M_M m).filter (fun Q => Q.coeff 0 ≠ 0)
      have h_lhs : (∑ P ∈ M_L (f_H * m), (Λ_L P : Ω F) * f P) =
          ∑ P ∈ M_L_nz, (Λ_L P : Ω F) * f P := by
        rw [← Finset.sum_filter_add_sum_filter_not (M_L (f_H * m)) (fun P => P.coeff 0 ≠ 0)]
        have h_zero : ∑ P ∈ (M_L (f_H * m)).filter (fun P => ¬ P.coeff 0 ≠ 0),
            (Λ_L P : Ω F) * f P = 0 := by
          apply Finset.sum_eq_zero
          intro P hP
          rw [Finset.mem_filter] at hP
          rw [hf0 P hP.1 (not_not.mp hP.2), mul_zero]
        rw [h_zero, add_zero]
      have h_rhs : (∑ Q ∈ M_M m, (Λ_M Q : Ω F) * f (N_Γ Q)) =
          ∑ Q ∈ M_M_nz, (Λ_M Q : Ω F) * f (N_Γ Q) := by
        rw [← Finset.sum_filter_add_sum_filter_not (M_M m) (fun Q => Q.coeff 0 ≠ 0)]
        have h_zero : ∑ Q ∈ (M_M m).filter (fun Q => ¬ Q.coeff 0 ≠ 0),
            (Λ_M Q : Ω F) * f (N_Γ Q) = 0 := by
          apply Finset.sum_eq_zero
          intro Q hQ
          rw [Finset.mem_filter] at hQ
          have hNQ_mem : N_Γ Q ∈ M_L (f_H * m) := (hN_Gamma_prop m Q hQ.1).1
          have hNQ0 : (N_Γ Q).coeff 0 = 0 := by
            by_contra hNQ0
            exact hQ.2 ((hN_Gamma_c0_iff Q hQ.1).mp hNQ0)
          rw [hf0 (N_Γ Q) hNQ_mem hNQ0, mul_zero]
        rw [h_zero, add_zero]
      rw [h_lhs, h_rhs]
      have h_maps : ∀ Q ∈ M_M_nz, N_Γ Q ∈ M_L_nz := by
        intro Q hQ
        rw [Finset.mem_filter] at hQ ⊢
        exact ⟨(hN_Gamma_prop m Q hQ.1).1, (hN_Gamma_c0_iff Q hQ.1).mpr hQ.2⟩
      rw [← Finset.sum_fiberwise_of_maps_to h_maps]
      apply Finset.sum_congr rfl
      intro P hP
      have hP_nz : P.coeff 0 ≠ 0 := (Finset.mem_filter.mp hP).2
      have h_filt_eq : M_M_nz.filter (fun Q => N_Γ Q = P) = (M_M m).filter (fun Q => N_Γ Q = P) := by
        ext Q
        simp only [M_M_nz, Finset.mem_filter]
        constructor
        · rintro ⟨⟨hQ1, _⟩, hQ2⟩
          exact ⟨hQ1, hQ2⟩
        · rintro ⟨hQ1, hQ2⟩
          refine ⟨⟨hQ1, ?_⟩, hQ2⟩
          rw [← hN_Gamma_c0_iff Q hQ1, hQ2]
          exact hP_nz
      rw [h_filt_eq]
      have h_const : (∑ Q ∈ (M_M m).filter (fun Q => N_Γ Q = P), (Λ_M Q : Ω F) * f (N_Γ Q)) =
          (∑ Q ∈ (M_M m).filter (fun Q => N_Γ Q = P), (Λ_M Q : Ω F)) * f P := by
        rw [Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro Q hQ
        rw [(Finset.mem_filter.mp hQ).2]
      rw [h_const, ← Nat.cast_sum, hFiber_Gamma m hm P hP]
    constructor
    · change (∑ P ∈ M_L (f_H * m), (Λ_L P : Ω F) * lam_L (𝒩_ℓ_L P)) =
        ∑ Q ∈ M_M m, (Λ_M Q : Ω F) * lam_M (𝒩_ℓ_M Q)
      have hf0_N : ∀ P ∈ M_L (f_H * m), P.coeff 0 = 0 → lam_L (𝒩_ℓ_L P) = 0 := by
        intro P hP hP0
        apply hlam_L_c0_zero
        have hrel := (h𝒩_L_prop (f_H * m) P hP).2
        have h_neg1 : (-1 : k_L) ^ (f_H * m) ≠ 0 := pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)
        have h1 : (-1 : k_L) ^ (f_H * m) * (𝒩_ℓ_L P).coeff 0 = 0 := by
          rw [hrel, hP0, mul_zero, zero_pow hPrime.ne_zero]
        exact (mul_eq_zero.mp h1).resolve_left h_neg1
      rw [hFiber_sum (fun P => lam_L (𝒩_ℓ_L P)) hf0_N]
      apply Finset.sum_congr rfl
      intro Q hQ
      rw [← (hN_Gamma_prop m Q hQ).2.2.2, hlam_N_Gamma (𝒩_ℓ_M Q) (h𝒩_M_prop m Q hQ).1]
    · have h_dh_eq := (hFiber_sum lam_L (fun P _ hP0 => hlam_L_c0_zero P hP0)).symm
      have h_rhs_congr : (∑ Q ∈ M_M m, (Λ_M Q : Ω F) * lam_L (N_Γ Q)) =
          ∑ Q ∈ M_M m, (Λ_M Q : Ω F) * lam_M Q := by
        apply Finset.sum_congr rfl
        intro Q hQ
        rw [hlam_N_Gamma Q hQ]
      rw [h_rhs_congr] at h_dh_eq
      have h_fm_ge1 : 1 ≤ f_H * m := by nlinarith
      rw [hΛ_M_dh α_M ψ_M hψ_M m hm, hΛ_L_dh α ψ_k hψ_k (f_H * m) h_fm_ge1] at h_dh_eq
      exact h_dh_eq
  have h_s2 : ∀ (α : k_Lˣ →* (Ω F)ˣ) (i : Fin r) (m : ℕ),
      (∑ c ∈ (Finset.range ℓ).filter (fun c : ℕ => c ≠ 0 ∧ c ^ f_H % ℓ = 1),
        (-1 : Ω F) ^ (m - 1) *
          (∑ y : k_Mˣ,
