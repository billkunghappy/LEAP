    rw [hval_LM₁' (δ_L : L), hδL]
    omega
  obtain ⟨δE', hδE'⟩ := hval_surj_E' (d₂ : ℤ)
  obtain ⟨δνM₁', hδνM₁'⟩ := hval_surj_L (a : ℤ)
  have hEpsE' :=
    (((hStat E' ψE' hψE' θE' hmE'_ge2).2 cE' hcE'_val hcE'_stat).2
