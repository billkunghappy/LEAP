      rw [hw_add] at hadd_norm
      have hsum := hval_add_L (T : ℤ)
        (normLM F hLA w - normLM F hLA (P_A z) - normLM F hLA δ_w)
        (normLM F hLA δ_w) hadd_norm hnorm_δ
      have hcancel : (normLM F hLA w - normLM F hLA (P_A z) - normLM F hLA δ_w) +
          normLM F hLA δ_w = normLM F hLA w - normLM F hLA (P_A z) := by ring
      rwa [hcancel] at hsum
  have hcomb_diff :
      (traceLM F hLA w + normLM F hLA w) - (traceLM F hLA (P_A z) + normLM F hLA (P_A z)) = 0 ∨
        (T : ℤ) ≤ valL F L
          ((traceLM F hLA w + normLM F hLA w) - (traceLM F hLA (P_A z) + normLM F hLA (P_A z))) := by
    have hsum := hval_add_L (T : ℤ)
      (traceLM F hLA w - traceLM F hLA (P_A z))
      (normLM F hLA w - normLM F hLA (P_A z)) htr_diff hnorm_diff
    have heq : (traceLM F hLA w - traceLM F hLA (P_A z)) +
        (normLM F hLA w - normLM F hLA (P_A z)) =
        (traceLM F hLA w + normLM F hLA w) - (traceLM F hLA (P_A z) + normLM F hLA (P_A z)) := by
      ring
    rwa [heq] at hsum
  have hConj1 : ψ (- 2 * α * (traceLM F hLA w + normLM F hLA w)) = 1 := by
    rw [hψ_congr (traceLM F hLA w + normLM F hLA w)
      (traceLM F hLA (P_A z) + normLM F hLA (P_A z)) hcomb_diff]
    exact hPA_char_one z hz
  have hConj2 :
      (traceChar F hLA ψ) (2 * IntermediateField.inclusion hLA α * w) =
        ψ (- 2 * α * normLM F hLA w) := by
    have hincl : 2 * IntermediateField.inclusion hLA α * w =
        IntermediateField.inclusion hLA (2 * α) * w := by
      rw [map_mul, map_ofNat]
    have htr_lhs : (traceChar F hLA ψ) (2 * IntermediateField.inclusion hLA α * w) =
        ψ (2 * α * traceLM F hLA w) := by
      unfold traceChar
      rw [AddChar.compAddMonoidHom_apply, hincl, htr_smul (2 * α) w]
    have hrhs_split : - 2 * α * normLM F hLA w =
        (- 2 * α * (traceLM F hLA w + normLM F hLA w)) + (2 * α * traceLM F hLA w) := by ring
    rw [htr_lhs, hrhs_split, AddChar.map_add_eq_mul, hConj1, one_mul]
  exact ⟨hConj1, hConj2⟩

theorem ld_ch12_wild_odd_totally_ramified_one_over_p_boxed_as_shift_formula (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
