    have hx₂ : x₂ = 0 ∨ 0 ≤ valL F M x₂ := hscale_int hm hw₂
    have hx₁₂ : x₁ + x₂ = 0 ∨ 0 ≤ valL F M (x₁ + x₂) := hval_add 0 x₁ x₂ hx₁ hx₂
    have hcongr :
