        (x * y = 0 ∨ a + b ≤ valL F K₁ (x * y)) := by
    intro a b x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
