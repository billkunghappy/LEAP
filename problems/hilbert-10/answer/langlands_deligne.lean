      normLM F hMK (1 + w) - (1 + normLM F hMK w) = 0 ∨
        (v + 1 : ℤ) ≤ valL F M (normLM F hMK (1 + w) - (1 + normLM F hMK w))) ∧
    (∀ (m : ℕ), 1 ≤ m → m ≤ t + 1 → ∀ w : K, (w = 0 ∨ (m : ℤ) ≤ valL F K w) →
      normLM F hMK (1 + w) - 1 = 0 ∨
        (m : ℤ) ≤ valL F M (normLM F hMK (1 + w) - 1)) ∧
    (∀ (u : ℕ), t + 1 ≤ u →
      ∀ w : K, (w = 0 ∨ ((t + 1 + p * (u - t) : ℕ) : ℤ) ≤ valL F K w) →
        normLM F hMK (1 + w) - 1 = 0 ∨
          (u + 1 : ℤ) ≤ valL F M (normLM F hMK (1 + w) - 1)) ∧
