  have hResField_exists : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      ∃ (k_M : Type u) (hField : Field k_M) (hFintype : Fintype k_M) (resM : M → k_M) (ϖ_M : Mˣ),
        valL F M (ϖ_M : M) = 1 ∧
        @IsResidueFieldMap F _ _ _ _ M k_M hField hFintype resM := by
    intro M _
    obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add, _, _, _⟩ :=
      ld_valL_and_unitGroup_props F M
    obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0, halg1, R_F, hRF_0, hRF_mod1⟩ :=
      ld_addVal_finset_and_algebraMap_valL F M
    obtain ⟨S₁, hS₁⟩ :=
      ld_valL_mod_one_finset F M hval0 hval_neg hval_mul hval_add
        haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0 halg1 R_F hRF_0 hRF_mod1
    obtain ⟨k_M, hField, hFintype, resM, hres0, hres1, hres_ring, hres_ker, hres_surj⟩ :=
      ld_valL_residue_field_exists F M hval0 hval1 hval_neg1 hval_neg hval_mul hval_inv hval_add S₁ hS₁
    obtain ⟨ϖ_M, hϖ_M⟩ := hval_surj 1
    exact ⟨k_M, hField, hFintype, resM, ϖ_M, hϖ_M,
      ⟨hres0, hres1, hres_ring, hres_ker, hres_surj⟩⟩
  have hStatResChar_exists : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ (θ : Mˣ →* (Ω F)ˣ), 2 ≤ condExp F M θ →
      ∀ (ϖ_M c'_θ : Mˣ), valL F M (ϖ_M : M) = 1 →
        valL F M (c'_θ : M) = (condExp F M θ : ℤ) + condExpChar F M ψ_M →
      ∀ (k_M : Type u) [Field k_M] [Fintype k_M] (resM : M → k_M),
        IsResidueFieldMap F M k_M resM →
        ∃ ψ_0M : AddChar k_M (Ω F),
          IsStatResChar F M ψ_M θ ϖ_M c'_θ k_M resM ψ_0M := by
    intro M _ ψ_M hψM θ hm ϖ_M c'_θ hϖ_M hc_val k_M _ _ resM hresM
    obtain ⟨hresM_0, hresM_1, hresM_ring, hresM_ker, hresM_surj⟩ := hresM
    obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, _, hval_add, _, _, _⟩ :=
      ld_valL_and_unitGroup_props F M
    have hψ_triv : ∀ x : M, (x = 0 ∨ -condExpChar F M ψ_M ≤ valL F M x) → ψ_M x = 1 :=
      (ld_condExp_and_condExpChar_spec F M ψ_M hψM θ).1
    set m : ℕ := condExp F M θ
    set d : ℕ := m / 2
    have hd_ineq : m ≤ 2 * d + 1 := by dsimp only [d]; omega
    have hϖ_pow : ∀ n : ℕ, valL F M ((ϖ_M ^ n : Mˣ) : M) = (n : ℤ) := by
      intro n
      induction n with
      | zero =>
        rw [pow_zero, Units.val_one, Nat.cast_zero]
        exact hval1
      | succ n ih =>
        rw [pow_succ, Units.val_mul,
          hval_mul _ _ (Units.ne_zero (ϖ_M ^ n)) (Units.ne_zero ϖ_M), ih, hϖ_M]
        push_cast
        ring
    set w_scale : M := ((c'_θ⁻¹ : Mˣ) : M) * ((ϖ_M ^ (2 * d) : Mˣ) : M)
    have hw_scale_ne : w_scale ≠ 0 :=
      mul_ne_zero (Units.ne_zero c'_θ⁻¹) (Units.ne_zero (ϖ_M ^ (2 * d)))
    have hw_scale_val : valL F M w_scale = -((m : ℤ) + condExpChar F M ψ_M) + ((2 * d : ℕ) : ℤ) := by
      dsimp only [w_scale]
      rw [hval_mul _ _ (Units.ne_zero c'_θ⁻¹) (Units.ne_zero (ϖ_M ^ (2 * d))),
        hval_inv c'_θ, hc_val, hϖ_pow (2 * d)]
    have hψ_ker1 : ∀ δ : M, (δ = 0 ∨ 1 ≤ valL F M δ) →
        ψ_M (((c'_θ⁻¹ : Mˣ) : M) * (((ϖ_M ^ (2 * d) : Mˣ) : M) * δ)) = 1 := by
      intro δ hδ
      have h_assoc : ((c'_θ⁻¹ : Mˣ) : M) * (((ϖ_M ^ (2 * d) : Mˣ) : M) * δ) = w_scale * δ := by
        dsimp only [w_scale]; ring
      rw [h_assoc]
      apply hψ_triv
      by_cases hδ0 : δ = 0
      · left; rw [hδ0, mul_zero]
      · right
        have hδ_ge1 : 1 ≤ valL F M δ := hδ.resolve_left hδ0
        rw [hval_mul w_scale δ hw_scale_ne hδ0, hw_scale_val]
        omega
    set s_M : k_M → M := fun a => (hresM_surj a).choose
    have hs_M_int : ∀ a : k_M, s_M a = 0 ∨ 0 ≤ valL F M (s_M a) :=
      fun a => (hresM_surj a).choose_spec.1
    have hs_M_res : ∀ a : k_M, resM (s_M a) = a :=
      fun a => (hresM_surj a).choose_spec.2
    set ψ_0 : k_M → Ω F := fun a =>
      ψ_M (((c'_θ⁻¹ : Mˣ) : M) * (((ϖ_M ^ (2 * d) : Mˣ) : M) * s_M a))
    have hneg_int : ∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) → (-x = 0 ∨ 0 ≤ valL F M (-x)) := by
      intro x hx
      rcases hx with rfl | hge
      · left; exact neg_zero
      · right; rw [hval_neg]; exact hge
    have hψ_0_int : ∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
        ψ_0 (resM x) = ψ_M (((c'_θ⁻¹ : Mˣ) : M) * (((ϖ_M ^ (2 * d) : Mˣ) : M) * x)) := by
      intro x hx_int
      set a : k_M := resM x
      set δ : M := x - s_M a
      have hδ_int : δ = 0 ∨ 0 ≤ valL F M δ := by
        dsimp only [δ]
        rw [sub_eq_add_neg]
        exact hval_add 0 x (-(s_M a)) hx_int (hneg_int (s_M a) (hs_M_int a))
      have hδ_res : resM δ = 0 := by
        dsimp only [δ]
        rw [sub_eq_add_neg,
          (hresM_ring x (-(s_M a)) hx_int (hneg_int (s_M a) (hs_M_int a))).1,
          (hresM_ring (s_M a) (s_M a) (hs_M_int a) (hs_M_int a)).2.2,
          hs_M_res a]
        exact add_neg_cancel a
      have hδ1 : δ = 0 ∨ 1 ≤ valL F M δ := (hresM_ker δ hδ_int).mp hδ_res
      have h_decomp : ((c'_θ⁻¹ : Mˣ) : M) * (((ϖ_M ^ (2 * d) : Mˣ) : M) * x) =
          ((c'_θ⁻¹ : Mˣ) : M) * (((ϖ_M ^ (2 * d) : Mˣ) : M) * s_M a) +
            ((c'_θ⁻¹ : Mˣ) : M) * (((ϖ_M ^ (2 * d) : Mˣ) : M) * δ) := by
        dsimp only [δ]; ring
      dsimp only [ψ_0]
      rw [h_decomp, ψ_M.map_add_eq_mul, hψ_ker1 δ hδ1, mul_one]
    have hψ_0_zero : ψ_0 0 = 1 := by
      rw [← hresM_0, hψ_0_int 0 (Or.inl rfl), mul_zero, mul_zero, ψ_M.map_zero_eq_one]
    have hψ_0_add : ∀ a₁ a₂ : k_M, ψ_0 (a₁ + a₂) = ψ_0 a₁ * ψ_0 a₂ := by
      intro a₁ a₂
      have hab_int : s_M a₁ + s_M a₂ = 0 ∨ 0 ≤ valL F M (s_M a₁ + s_M a₂) :=
        hval_add 0 (s_M a₁) (s_M a₂) (hs_M_int a₁) (hs_M_int a₂)
      have hab_res : resM (s_M a₁ + s_M a₂) = a₁ + a₂ := by
        rw [(hresM_ring (s_M a₁) (s_M a₂) (hs_M_int a₁) (hs_M_int a₂)).1,
          hs_M_res a₁, hs_M_res a₂]
      rw [← hab_res, hψ_0_int (s_M a₁ + s_M a₂) hab_int, mul_add, mul_add, ψ_M.map_add_eq_mul]
    let ψ_0M : AddChar k_M (Ω F) :=
      { toFun := ψ_0
        map_zero_eq_one' := hψ_0_zero
        map_add_eq_mul' := hψ_0_add }
    exact ⟨ψ_0M, hψ_0_int⟩
  obtain ⟨k_L, hFieldL, hFinL_card, resL, _, _, hresL_map⟩ := hResField_exists L
  letI : Field k_L := hFieldL
  letI : Fintype k_L := hFinL_card
  obtain ⟨ψ_0L, hstatL⟩ :=
    hStatResChar_exists L ψ hψ χ' h_ge2 ϖ_L c'_χ' hϖ_L hc_L_val k_L resL hresL_map
  obtain ⟨k_E, hFieldE, hFinE_card, resE, _, _, hresE_map⟩ := hResField_exists E
  letI : Field k_E := hFieldE
  letI : Fintype k_E := hFinE_card
  obtain ⟨ψ_0E, hstatE⟩ :=
    hStatResChar_exists E (traceChar F hLE ψ) hψE
      (χ'.comp (Units.map (normLM F hLE))) hcond_E ϖ_E c'_χ'E hϖ_E hc_E_val k_E resE hresE_map
  have hResFi : ∀ i : Fin D_orb.length,
      let F_i := (D_orb.get i).field
      ∃ (k_i : Type u) (hField_i : Field k_i) (hFin_i : Fintype k_i)
        (res_i : F_i → k_i) (ϖ_i : F_iˣ),
        valL F F_i (ϖ_i : F_i) = 1 ∧
        @IsResidueFieldMap F _ _ _ _ F_i k_i hField_i hFin_i res_i := by
    intro i
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    exact hResField_exists (D_orb.get i).field
  let k_Fi : Fin D_orb.length → Type u := fun i => (hResFi i).choose
  let hFieldFi : ∀ i, Field (k_Fi i) := fun i => (hResFi i).choose_spec.choose
  letI : ∀ i, Field (k_Fi i) := hFieldFi
  let hFinFi_card : ∀ i, Fintype (k_Fi i) := fun i => (hResFi i).choose_spec.choose_spec.choose
  letI : ∀ i, Fintype (k_Fi i) := hFinFi_card
  let resFi : ∀ i : Fin D_orb.length, (D_orb.get i).field → k_Fi i :=
    fun i => (hResFi i).choose_spec.choose_spec.choose_spec.choose
  let ϖ_Fi : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ :=
    fun i => (hResFi i).choose_spec.choose_spec.choose_spec.choose_spec.choose
  have hϖ_Fi_val : ∀ i : Fin D_orb.length,
      valL F (D_orb.get i).field (ϖ_Fi i : (D_orb.get i).field) = 1 :=
    fun i => (hResFi i).choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.1
  have hresFi_map : ∀ i : Fin D_orb.length,
      IsResidueFieldMap F (D_orb.get i).field (k_Fi i) (resFi i) :=
    fun i => (hResFi i).choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.2
  have hStat_μ : ∀ i : Fin D_orb.length,
      let F_i := (D_orb.get i).field
      let ψ_Fi := traceChar F (D_orb.get i).le ψ
      ∃ ψ_0μ_i : AddChar (k_Fi i) (Ω F),
        IsStatResChar F F_i ψ_Fi (μ'_orb i) (ϖ_Fi i) (c'_μ i) (k_Fi i) (resFi i) ψ_0μ_i := by
    intro i
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    exact hStatResChar_exists (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) (hψFi i)
      (μ'_orb i) (hc_orb i).1 (ϖ_Fi i) (c'_μ i) (hϖ_Fi_val i) (hc_orb i).2.2.1
      (k_Fi i) (resFi i) (hresFi_map i)
  have hStat_θ : ∀ i : Fin D_orb.length,
      let F_i := (D_orb.get i).field
      let ψ_Fi := traceChar F (D_orb.get i).le ψ
      let θ_i := μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
      ∃ ψ_0θ_i : AddChar (k_Fi i) (Ω F),
        IsStatResChar F F_i ψ_Fi θ_i (ϖ_Fi i) (c'_θ i) (k_Fi i) (resFi i) ψ_0θ_i := by
    intro i
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    exact hStatResChar_exists (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) (hψFi i)
      (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) (hc_orb i).2.1
      (ϖ_Fi i) (c'_θ i) (hϖ_Fi_val i) (hc_orb i).2.2.2.2.1
      (k_Fi i) (resFi i) (hresFi_map i)
  let ψ_0μ : ∀ i : Fin D_orb.length, AddChar (k_Fi i) (Ω F) := fun i => (hStat_μ i).choose
  let ψ_0θ : ∀ i : Fin D_orb.length, AddChar (k_Fi i) (Ω F) := fun i => (hStat_θ i).choose
  have hFi_spec : ∀ i : Fin D_orb.length,
      let F_i := (D_orb.get i).field
      let ψ_Fi := traceChar F (D_orb.get i).le ψ
      let θ_i := μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
      valL F F_i (ϖ_Fi i : F_i) = 1 ∧
      IsResidueFieldMap F F_i (k_Fi i) (resFi i) ∧
      IsStatResChar F F_i ψ_Fi (μ'_orb i) (ϖ_Fi i) (c'_μ i) (k_Fi i) (resFi i) (ψ_0μ i) ∧
      IsStatResChar F F_i ψ_Fi θ_i (ϖ_Fi i) (c'_θ i) (k_Fi i) (resFi i) (ψ_0θ i) :=
    fun i => ⟨hϖ_Fi_val i, hresFi_map i, (hStat_μ i).choose_spec, (hStat_θ i).choose_spec⟩
  exact ⟨hk_even_or1, k_L, k_E, hFieldL, hFinL_card, hFieldE, hFinE_card,
    resL, resE, ψ_0L, ψ_0E, k_Fi, hFieldFi, hFinFi_card,
    resFi, ϖ_Fi, ψ_0μ, ψ_0θ,
    ⟨hresL_map, hstatL⟩, ⟨hresE_map, hstatE⟩, hFi_spec⟩

theorem ld_ch14_odd_p_finite_field_hasse_davenport_quad_gauss (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (hp : Nat.Prime (p F)) (hp_ne2 : p F ≠ 2)
    (k_L : Type u) [Field k_L] [Fintype k_L]
    (hp_char : ((p F : ℕ) : k_L) = 0)
    (ψ_ref : AddChar k_L (Ω F)) (hψ_ref : ψ_ref ≠ 1) :
    let G_L : Ω F :=
      ∑ x : k_L, ψ_ref ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ * (x ^ 2))
    G_L ^ 2 = ((quadraticChar k_L (-1) : ℤ) : Ω F) * (Fintype.card k_L : Ω F) ∧
    (∀ a : k_L, a ≠ 0 →
      (∑ x : k_L, ψ_ref ((-1 : k_L) ^ ((p F - 1) / 2) * (2 : k_L)⁻¹ * (a * (x ^ 2)))) =
        ((quadraticChar k_L a : ℤ) : Ω F) * G_L) ∧
    (∀ (k_M : Type u) [Field k_M] [Fintype k_M] [Algebra k_L k_M] (b : k_M),
      b ≠ 0 →
      (∑ y : k_M,
        ψ_ref (Algebra.trace k_L k_M
          ((-1 : k_M) ^ ((p F - 1) / 2) * (2 : k_M)⁻¹ * (b * (y ^ 2))))) =
        (((-1 : ℤ) ^ (Module.finrank k_L k_M - 1) *
          quadraticChar k_L (Algebra.norm k_L b) : ℤ) : Ω F) *
          G_L ^ (Module.finrank k_L k_M)) :=
by
  suffices h_gen : ∀ (R : Type) [Field R] [CharZero R]
      (p_F : ℕ) (hp : Nat.Prime p_F) (hp_ne2 : p_F ≠ 2)
      (hp_char : ((p_F : ℕ) : k_L) = 0)
      (ψ_ref : AddChar k_L R) (hψ_ref : ψ_ref ≠ 1),
      let G_L : R :=
        ∑ x : k_L, ψ_ref ((-1 : k_L) ^ ((p_F - 1) / 2) * (2 : k_L)⁻¹ * (x ^ 2))
      G_L ^ 2 = ((quadraticChar k_L (-1) : ℤ) : R) * (Fintype.card k_L : R) ∧
      (∀ a : k_L, a ≠ 0 →
        (∑ x : k_L, ψ_ref ((-1 : k_L) ^ ((p_F - 1) / 2) * (2 : k_L)⁻¹ * (a * (x ^ 2)))) =
          ((quadraticChar k_L a : ℤ) : R) * G_L) ∧
      (∀ (k_M : Type u) [Field k_M] [Fintype k_M] [Algebra k_L k_M] (b : k_M),
        b ≠ 0 →
        (∑ y : k_M,
          ψ_ref (Algebra.trace k_L k_M
            ((-1 : k_M) ^ ((p_F - 1) / 2) * (2 : k_M)⁻¹ * (b * (y ^ 2))))) =
          (((-1 : ℤ) ^ (Module.finrank k_L k_M - 1) *
            quadraticChar k_L (Algebra.norm k_L b) : ℤ) : R) *
            G_L ^ (Module.finrank k_L k_M)) by
    exact h_gen (Ω F) (p F) hp hp_ne2 hp_char ψ_ref hψ_ref
  clear * -
  intro R _ _ p_F hp hp_ne2 hp_char ψ_ref hψ_ref G_L
  have hring : ringChar k_L = p_F := CharP.ringChar_of_prime_eq_zero hp hp_char
  have hring_ne2 : ringChar k_L ≠ 2 := hring ▸ hp_ne2
  have hNe2 : (2 : k_L) ≠ 0 := Ring.two_ne_zero hring_ne2
  
  have h_1d : ∀ (ν_tilde ψ_1 : k_L → R)
      (hν_0 : ν_tilde 0 = 0)
      (hν_1 : ν_tilde 1 = 1)
      (hν_mul : ∀ a b : k_L, ν_tilde (a * b) = ν_tilde a * ν_tilde b)
      (hν_pow : ∀ a : k_L, a ≠ 0 → (ν_tilde a) ^ 2 = 1)
      (hν_ne : ∃ a₀ : k_L, a₀ ≠ 0 ∧ ν_tilde a₀ ≠ 1)
      (hψ1_0 : ψ_1 0 = 1)
      (hψ1_add : ∀ x y : k_L, ψ_1 (x + y) = ψ_1 x * ψ_1 y)
      (hψ1_ne : ∃ x₀ : k_L, ψ_1 x₀ ≠ 1),
      (∑ a : k_L, ν_tilde a * ψ_1 a) = (∑ x : k_L, ψ_1 (x ^ 2)) ∧
      (∑ x : k_L, ψ_1 (x ^ 2)) * (∑ a : k_L, ν_tilde a * ψ_1 a) =
        ν_tilde (-1) * (Fintype.card k_L : R) := by
    intro ν_tilde ψ_1 hν_0 hν_1 hν_mul hν_pow hν_ne hψ1_0 hψ1_add hψ1_ne
    have hν_pm1 : ∀ a : k_L, a ≠ 0 → (ν_tilde a = 1 ∨ ν_tilde a = -1) := by
      intro a ha
      exact sq_eq_one_iff.mp (hν_pow a ha)
    obtain ⟨x₀, hψ1_x₀⟩ := hψ1_ne
    have hψ1_orth : ∀ c : k_L,
        (∑ b : k_L, ψ_1 (c * b)) = if c = 0 then (Fintype.card k_L : R) else 0 := by
      intro c
      by_cases hc : c = 0
      · simp [hc, hψ1_0]
      · rw [if_neg hc]
        have hshift : (∑ b : k_L, ψ_1 (c * b)) = ∑ b : k_L, ψ_1 (c * (b + c⁻¹ * x₀)) := by
          exact (Fintype.sum_equiv (Equiv.addRight (c⁻¹ * x₀))
            (fun b => ψ_1 (c * (b + c⁻¹ * x₀)))
            (fun b => ψ_1 (c * b))
            (fun b => rfl)).symm
        have hterm : ∀ b : k_L, ψ_1 (c * (b + c⁻¹ * x₀)) = ψ_1 (c * b) * ψ_1 x₀ := by
          intro b
          have hcb : c * (b + c⁻¹ * x₀) = c * b + x₀ := by
            rw [mul_add, ← mul_assoc, mul_inv_cancel₀ hc, one_mul]
          rw [hcb, hψ1_add]
        have hmul : (∑ b : k_L, ψ_1 (c * b)) = (∑ b : k_L, ψ_1 (c * b)) * ψ_1 x₀ := by
          calc (∑ b : k_L, ψ_1 (c * b))
              = ∑ b : k_L, ψ_1 (c * (b + c⁻¹ * x₀)) := hshift
            _ = ∑ b : k_L, (ψ_1 (c * b) * ψ_1 x₀) := Finset.sum_congr rfl (fun b _ => hterm b)
            _ = (∑ b : k_L, ψ_1 (c * b)) * ψ_1 x₀ := (Finset.sum_mul _ _ _).symm
        have hsub : (∑ b : k_L, ψ_1 (c * b)) * (ψ_1 x₀ - 1) = 0 := by
          linear_combination -hmul
        exact (mul_eq_zero.mp hsub).resolve_right (sub_ne_zero.mpr hψ1_x₀)
    have hψ1_sum : (∑ a : k_L, ψ_1 a) = 0 := by
      have h1 := hψ1_orth 1
      simp only [one_mul, one_ne_zero, ↓reduceIte] at h1
      exact h1
    obtain ⟨a₀, ha₀, hν_a₀⟩ := hν_ne
    have hν_sum : (∑ u : k_L, ν_tilde u) = 0 := by
      have hshift : (∑ u : k_L, ν_tilde u) = ∑ u : k_L, ν_tilde (u * a₀) := by
        exact (Fintype.sum_equiv (Equiv.mulRight₀ a₀ ha₀)
          (fun u => ν_tilde (u * a₀)) (fun u => ν_tilde u) (fun u => rfl)).symm
      have hmul : (∑ u : k_L, ν_tilde u) = (∑ u : k_L, ν_tilde u) * ν_tilde a₀ := by
        calc (∑ u : k_L, ν_tilde u)
            = ∑ u : k_L, ν_tilde (u * a₀) := hshift
          _ = ∑ u : k_L, (ν_tilde u * ν_tilde a₀) := Finset.sum_congr rfl (fun u _ => hν_mul u a₀)
          _ = (∑ u : k_L, ν_tilde u) * ν_tilde a₀ := (Finset.sum_mul _ _ _).symm
      have hsub : (∑ u : k_L, ν_tilde u) * (ν_tilde a₀ - 1) = 0 := by
        linear_combination -hmul
      exact (mul_eq_zero.mp hsub).resolve_right (sub_ne_zero.mpr hν_a₀)
    set S₀ : Finset k_L := Finset.univ.erase 0
    set Q : Finset k_L := S₀.image (fun x : k_L => x ^ 2)
