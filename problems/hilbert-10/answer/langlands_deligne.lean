      exact hχK₁'_cond
    have hEq1₀ := ld_ch12_unshifted_cyclic_fml F E K₁ hEK₁ hGalEK₁ hAbEK₁ hPrime_EK₁ ψE hψE ξE χE'
      (hdegEK₁.symm ▸ hξE_pow) hξE_ne hξE_ker hξE_cond hχE'_cond hχE'K₁_cond
    have hEq1_prod : (∏ j ∈ Finset.range ℓ, tateEps F E (ξE ^ j * χE') ψE) =
