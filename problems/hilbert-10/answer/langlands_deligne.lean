        1 + (∑ i ∈ Finset.Icc 1 (Module.finrank L (IntermediateField.extendScalars hLE') - 1),
          c ^ i * e_Δ i) +
          c ^ (Module.finrank L (IntermediateField.extendScalars hLE')) * normLM F hM₁'K₁ (Δ : K₁)) :
    let a := normLM F hE'K₁ (Δ : K₁)
    let b := normLM F hM₁'K₁ (Δ : K₁)
    traceLM F hLM₁' b - traceLM F hLE' a = 0 ∨
      (bE' : ℤ) ≤ valL F L (traceLM F hLM₁' b - traceLM F hLE' a) :=
by
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  set a := normLM F hE'K₁ (Δ : K₁)
  set b := normLM F hM₁'K₁ (Δ : K₁)
  rcases hvalL_props with ⟨hvalL_0, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv,
    hvalL_surj, hvalL_add, hvalL_u0, hvalL_ua, hvalL_u_zero⟩
  obtain ⟨e', he'_0, he'_p, he'_poly, he'_1, he'_mixed⟩ :=
    ld_ch12_wild_odd_tot_ram_eprime_symm_and_val_bounds F L E' K₁ hLE' hE'K₁ hGalE'K₁ hPrime
