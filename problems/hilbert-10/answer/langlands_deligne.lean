    have hG_mul : ∀ g : G₀, ∃ h ∈ H, ∃ c ∈ C, g = h * c := by
      let S : Subgroup G₀ :=
        { carrier := {g : G₀ | ∃ h ∈ H, ∃ c ∈ C, g = h * c}
          one_mem' := ⟨1, H.one_mem, 1, C.one_mem, (mul_one 1).symm⟩
          mul_mem' := by
            rintro g₁ g₂ ⟨h₁, hh₁, c₁, hc₁, rfl⟩ ⟨h₂, hh₂, c₂, hc₂, rfl⟩
            refine ⟨h₁ * h₂, H.mul_mem hh₁ hh₂, h₂⁻¹ * c₁ * h₂ * c₂, ?_, by group⟩
            have hconj : h₂⁻¹ * c₁ * (h₂⁻¹)⁻¹ ∈ C := hC_norm.conj_mem c₁ hc₁ h₂⁻¹
            have heq : h₂⁻¹ * c₁ * h₂ = h₂⁻¹ * c₁ * (h₂⁻¹)⁻¹ := by group
            rw [heq]
            exact C.mul_mem hconj hc₂
