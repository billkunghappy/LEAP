            ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) * (t + 1 : ℤ) =
              1 := by
        rw [hp_eq2]
        omega
      rw [h_eq1]
      exact hge1
  have htr1 : traceLM F hLK (1 : K) = (2 : L) := by
    have h1 : (1 : K) = IntermediateField.inclusion hLK 1 := (map_one _).symm
    rw [h1, htr_incl 1, mul_one]
  have h2_ge_d : (2 : L) = 0 ∨ (d : ℤ) ≤ valL F L (2 : L) := by
    have h_ineq :
        (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * (d : ℤ) -
          ((Module.finrank L (IntermediateField.extendScalars hLK) - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤
            valL F K (1 : K) := by
      rw [hval1_K, hp_eq2]
      omega
    have htr := htr_bound (d : ℤ) (1 : K) (Or.inr h_ineq)
    rwa [htr1] at htr
  have h1_int : (1 : L) = 0 ∨ 0 ≤ valL F L 1 := Or.inr (by omega)
  have h2_int : (2 : L) = 0 ∨ 0 ≤ valL F L (2 : L) := by
    rcases h2_ge_d with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (by omega)
  have h2_ge1 : (2 : L) = 0 ∨ 1 ≤ valL F L (2 : L) := by
    rcases h2_ge_d with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (by omega)
  have hresL_2 : resL (2 : L) = (2 : k_L) := by
    have h2_eq : (2 : L) = 1 + 1 := by ring
    rw [h2_eq, (hresL_ring 1 1 h1_int h1_int).1, hresL_1]
    ring
  have hchar2 : (2 : k_L) = 0 := by
    rw [← hresL_2]
    exact (hresL_ker (2 : L) h2_int).mpr h2_ge1
  let x_d : L := ((ϖ_L ^ d : Lˣ) : L)
  have hx_d_ne : x_d ≠ 0 := Units.ne_zero (ϖ_L ^ d)
  have hx_d_val : valL F L x_d = (d : ℤ) := by
    dsimp [x_d]
    rw [hval_pow_L (ϖ_L : L) d (Units.ne_zero ϖ_L), hϖ_L, mul_one]
  obtain ⟨y_d, hy_d_tr, _, hy_d_nz⟩ := htr_surj x_d
  obtain ⟨hy_d_ne, hy_d_val⟩ := hy_d_nz hx_d_ne
  have hy_d_val0 : valL F K y_d = 0 := by
    rw [hy_d_val, hx_d_val, hp_eq2]
    omega
  obtain ⟨w_d, hw_d_int, _, htr_yd_approx⟩ :=
    hOK_decomp y_d (Or.inr (by omega))
  rw [hy_d_tr] at htr_yd_approx
  have h2_not_ge_r0 : ¬ ((2 : L) = 0 ∨ (r₀ : ℤ) ≤ valL F L (2 : L)) := by
    intro h2_r0
    have h2w_val : (2 : L) * w_d = 0 ∨ (r₀ : ℤ) ≤ valL F L ((2 : L) * w_d) := by
      have hmul := hval_mul_ge_L (r₀ : ℤ) 0 (2 : L) w_d h2_r0 hw_d_int
      rcases hmul with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hxd_ge_r0 : x_d = 0 ∨ (r₀ : ℤ) ≤ valL F L x_d := by
      have h_eq : x_d = (x_d - (2 : L) * w_d) + (2 : L) * w_d := by ring
      rw [h_eq]
      exact hval_add_L (r₀ : ℤ) (x_d - (2 : L) * w_d) ((2 : L) * w_d) htr_yd_approx h2w_val
    have hge : (r₀ : ℤ) ≤ valL F L x_d := hxd_ge_r0.resolve_left hx_d_ne
    rw [hx_d_val] at hge
    omega
  have h2_ne : (2 : L) ≠ 0 := fun h0 => h2_not_ge_r0 (Or.inl h0)
  have h2_val : valL F L (2 : L) = (d : ℤ) := by
    have hge : (d : ℤ) ≤ valL F L (2 : L) := h2_ge_d.resolve_left h2_ne
    have hnot : ¬ ((r₀ : ℤ) ≤ valL F L (2 : L)) := fun hr0 => h2_not_ge_r0 (Or.inr hr0)
    omega
  obtain ⟨ρ_tilde, hρ_int, hu_approx, htr_u⟩ :=
    hOK_decomp (u : K) (Or.inr (by omega))
  have hρ_not_ker : ¬ (ρ_tilde = 0 ∨ 1 ≤ valL F L ρ_tilde) := by
    intro hker
    have hinc_val : IntermediateField.inclusion hLK ρ_tilde = 0 ∨
        1 ≤ valL F K (IntermediateField.inclusion hLK ρ_tilde) := by
      rcases hker with rfl | hge1
      · exact Or.inl (map_zero _)
      · right
        rw [hval_alg ρ_tilde, hp_eq2]
        omega
    have hu_ge1 : (u : K) = 0 ∨ 1 ≤ valL F K (u : K) := by
      have h_eq : (u : K) = ((u : K) - IntermediateField.inclusion hLK ρ_tilde) +
          IntermediateField.inclusion hLK ρ_tilde := by ring
      rw [h_eq]
      exact hval_add_K 1 _ _ hu_approx hinc_val
    have hge1 : 1 ≤ valL F K (u : K) := hu_ge1.resolve_left (Units.ne_zero u)
    omega
  have hρ_ne0 : ρ_tilde ≠ 0 := fun h0 => hρ_not_ker (Or.inl h0)
  have hρ_val0 : valL F L ρ_tilde = 0 := by
    have hge0 : 0 ≤ valL F L ρ_tilde := hρ_int.resolve_left hρ_ne0
    have hnot1 : ¬ (1 ≤ valL F L ρ_tilde) := fun h1 => hρ_not_ker (Or.inr h1)
    omega
  let u_0 : Lˣ := Units.mk0 ρ_tilde hρ_ne0
  have hu0_coe : (u_0 : L) = ρ_tilde := Units.val_mk0 hρ_ne0
  have hu0_val : valL F L (u_0 : L) = 0 := by rw [hu0_coe, hρ_val0]
  let r_u : K := (u : K) - IntermediateField.inclusion hLK (u_0 : L)
  have hN_eq : (N : L) = normLM F hLK (u : K) := by
    have h := congrArg Units.val hu_norm
    exact h.symm
  have hN_u0_decomp : (N : L) - (u_0 : L) ^ 2 =
      (u_0 : L) * traceLM F hLK r_u + normLM F hLK r_u := by
    have hu_eq : (u : K) = IntermediateField.inclusion hLK (u_0 : L) + r_u := by
      dsimp [r_u]; ring
    rw [hN_eq, hu_eq, hnorm_add (u_0 : L) r_u]
    ring
  have htr_ru_val : traceLM F hLK r_u = 0 ∨ 1 ≤ valL F L (traceLM F hLK r_u) := by
    have htr_ru_eq : traceLM F hLK r_u = traceLM F hLK (u : K) - (2 : L) * (u_0 : L) := by
      dsimp [r_u]
      rw [map_sub, htr_incl (u_0 : L)]
    rw [htr_ru_eq, hu0_coe]
    rcases htr_u with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (by omega)
  have hu0_tr_ru_val : (u_0 : L) * traceLM F hLK r_u = 0 ∨
      1 ≤ valL F L ((u_0 : L) * traceLM F hLK r_u) := by
    have hmul := hval_mul_ge_L 0 1 (u_0 : L) (traceLM F hLK r_u)
      (Or.inr (by omega)) htr_ru_val
    rcases hmul with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (by omega)
  have hnorm_ru_val : normLM F hLK r_u = 0 ∨ 1 ≤ valL F L (normLM F hLK r_u) := by
    rcases hu_approx with h0 | hge1
    · left
      have hr0 : r_u = IntermediateField.inclusion hLK 0 := by
        dsimp [r_u]
        rw [hu0_coe, h0, map_zero]
      rw [hr0, hnorm_incl 0, sq, zero_mul]
    · right
      rw [hval_norm r_u]
      dsimp [r_u]
      rw [hu0_coe]
      exact hge1
  have hN_u0 : (N : L) - (u_0 : L) ^ 2 = 0 ∨ 1 ≤ valL F L ((N : L) - (u_0 : L) ^ 2) := by
    rw [hN_u0_decomp]
    exact hval_add_L 1 _ _ hu0_tr_ru_val hnorm_ru_val
  have hρ_res_ne0 : resL (u_0 : L) ≠ 0 := by
    rw [hu0_coe]
    intro h0
    exact hρ_not_ker ((hresL_ker ρ_tilde hρ_int).mp h0)
  have hρ_res_ne1 : 1 + resL (u_0 : L) ≠ 0 := by
    obtain ⟨hτ1_tilde, hτ1_unit, _, _, _, hN_τ1_ne, hN_τ1_val, _⟩ :=
      hτ_props 1 (by omega) (by omega)
    have hτ1_unit_coe : (τ_unit 1 : L) = 1 := by
      rw [hτ1_unit, Units.val_pow_eq_pow_val, hτ1_tilde, Nat.cast_one, one_pow, one_pow]
    rw [hτ1_unit_coe] at hN_τ1_ne hN_τ1_val
    have hN1_int : (N : L) + 1 = 0 ∨ 0 ≤ valL F L ((N : L) + 1) := Or.inr (by omega)
    have hres_N1_ne0 : resL ((N : L) + 1) ≠ 0 := by
      intro h0
      have hker := (hresL_ker ((N : L) + 1) hN1_int).mp h0
      rcases hker with h_eq0 | h_ge1
      · exact hN_τ1_ne h_eq0
      · omega
    have hN_int : (N : L) = 0 ∨ 0 ≤ valL F L (N : L) := Or.inr (by omega)
    have hu0_int : (u_0 : L) = 0 ∨ 0 ≤ valL F L (u_0 : L) := Or.inr (by omega)
    have hu0_sq_int : (u_0 : L) ^ 2 = 0 ∨ 0 ≤ valL F L ((u_0 : L) ^ 2) := by
      rw [sq]
      have hmul := hval_mul_ge_L 0 0 (u_0 : L) (u_0 : L) hu0_int hu0_int
      rcases hmul with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hN_u0_int : (N : L) - (u_0 : L) ^ 2 = 0 ∨ 0 ≤ valL F L ((N : L) - (u_0 : L) ^ 2) :=
      hval_sub_L 0 (N : L) ((u_0 : L) ^ 2) hN_int hu0_sq_int
    have hres_N_eq : resL (N : L) = (resL (u_0 : L)) ^ 2 := by
      have h0 := (hresL_ker ((N : L) - (u_0 : L) ^ 2) hN_u0_int).mpr hN_u0
      rw [hresL_sub (N : L) ((u_0 : L) ^ 2) hN_int hu0_sq_int] at h0
      rw [sub_eq_zero.mp h0, sq, (hresL_ring (u_0 : L) (u_0 : L) hu0_int hu0_int).2.1, ← sq]
    have hres_N1_eq : resL ((N : L) + 1) = (resL (u_0 : L)) ^ 2 + 1 := by
      rw [(hresL_ring (N : L) 1 hN_int h1_int).1, hres_N_eq, hresL_1]
    intro h1ρ
    apply hres_N1_ne0
    have h_ident : (resL (u_0 : L)) ^ 2 + 1 =
        (1 + resL (u_0 : L)) * (resL (u_0 : L) - 1) + (2 : k_L) := by ring
    rw [hres_N1_eq, h_ident, h1ρ, hchar2, zero_mul, add_zero]
  let u_2 : Lˣ := Units.mk0 (2 : L) h2_ne
  let v_δ : Lˣ := u_2 * u_0⁻¹ * (ϖ_L ^ d)⁻¹
  have hv_δ_val : valL F L (v_δ : L) = 0 := by
    change valL F L (((u_2 * u_0⁻¹ * (ϖ_L ^ d)⁻¹ : Lˣ) : L)) = 0
    rw [Units.val_mul, hval_mul_L _ _ (Units.ne_zero _) (Units.ne_zero _),
      Units.val_mul, hval_mul_L _ _ (Units.ne_zero _) (Units.ne_zero _),
      Units.val_mk0, h2_val, hval_inv_L u_0, hu0_val,
      hval_inv_L (ϖ_L ^ d), hx_d_val]
    omega
  obtain ⟨s_0, hs0_int, hs0_approx⟩ :=
    hfrob_surj (v_δ : L) (Or.inr (by omega))
  have hs0_approx2 : (v_δ : L) - s_0 ^ 2 = 0 ∨ 1 ≤ valL F L ((v_δ : L) - s_0 ^ 2) := by
    rwa [hp_eq2] at hs0_approx
  have hs0_not_ker : ¬ (s_0 = 0 ∨ 1 ≤ valL F L s_0) := by
    intro hker
    have hs0_sq_val : s_0 ^ 2 = 0 ∨ 1 ≤ valL F L (s_0 ^ 2) := by
      rw [sq]
      have hmul := hval_mul_ge_L 1 1 s_0 s_0 hker hker
      rcases hmul with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hv_ge1 : (v_δ : L) = 0 ∨ 1 ≤ valL F L (v_δ : L) := by
      have h_eq : (v_δ : L) = ((v_δ : L) - s_0 ^ 2) + s_0 ^ 2 := by ring
      rw [h_eq]
      exact hval_add_L 1 _ _ hs0_approx2 hs0_sq_val
    have hge1 : 1 ≤ valL F L (v_δ : L) := hv_ge1.resolve_left (Units.ne_zero v_δ)
    omega
  have hs0_ne : s_0 ≠ 0 := fun h0 => hs0_not_ker (Or.inl h0)
  have hs0_val0 : valL F L s_0 = 0 := by
    have hge0 : 0 ≤ valL F L s_0 := hs0_int.resolve_left hs0_ne
    have hnot1 : ¬ (1 ≤ valL F L s_0) := fun h1 => hs0_not_ker (Or.inr h1)
    omega
  let u_s0 : Lˣ := Units.mk0 s_0 hs0_ne
  let δ_K : Kˣ := (ϖ_K ^ d) * Units.map (IntermediateField.inclusion hLK).toMonoidHom u_s0
  have hδK_coe : (δ_K : K) = ((ϖ_K ^ d : Kˣ) : K) * IntermediateField.inclusion hLK s_0 := by
    dsimp [δ_K, u_s0]
  have hδK_val : valL F K (δ_K : K) = (d : ℤ) := by
    rw [hδK_coe]
    have hinc_s0_ne : IntermediateField.inclusion hLK s_0 ≠ 0 :=
      (RingHom.injective (IntermediateField.inclusion hLK).toRingHom).ne hs0_ne
    rw [hval_mul_K _ _ (Units.ne_zero (ϖ_K ^ d)) hinc_s0_ne,
      Units.val_pow_eq_pow_val, hval_pow_K (ϖ_K : K) d (Units.ne_zero ϖ_K),
      hϖ_K, mul_one, hval_alg s_0, hs0_val0, mul_zero, add_zero]
  have hnorm_ϖK_d : normLM F hLK ((ϖ_K ^ d : Kˣ) : K) = x_d := by
    have h1 : normLM F hLK (ϖ_K : K) = (ϖ_L : L) := congrArg Units.val hϖ_norm
    dsimp [x_d]
    rw [map_pow, h1]
  have hxd_vδ : x_d * (v_δ : L) = (2 : L) * ((u_0⁻¹ : Lˣ) : L) := by
    have hu : (ϖ_L ^ d) * v_δ = u_2 * u_0⁻¹ := by
      dsimp [v_δ]
      rw [mul_comm (ϖ_L ^ d) _, inv_mul_cancel_right]
    have hcoe := congrArg Units.val hu
    rw [Units.val_mul (ϖ_L ^ d) v_δ, Units.val_mul u_2 u_0⁻¹] at hcoe
    exact hcoe
  have hδK_norm_diff : normLM F hLK (δ_K : K) - (2 : L) * ((u_0⁻¹ : Lˣ) : L) =
      -(x_d * ((v_δ : L) - s_0 ^ 2)) := by
    rw [hδK_coe, map_mul, hnorm_ϖK_d, hnorm_incl s_0, ← hxd_vδ]
    ring
  have hδK_norm : normLM F hLK (δ_K : K) - (2 : L) * ((u_0⁻¹ : Lˣ) : L) = 0 ∨
      (r₀ : ℤ) ≤ valL F L (normLM F hLK (δ_K : K) - (2 : L) * ((u_0⁻¹ : Lˣ) : L)) := by
    rw [hδK_norm_diff]
    have hmul := hval_mul_ge_L (d : ℤ) 1 x_d ((v_δ : L) - s_0 ^ 2)
      (Or.inr (le_of_eq hx_d_val.symm)) hs0_approx2
    rcases hmul with h0 | hge
    · exact Or.inl (by rw [h0, neg_zero])
    · right
      rw [hval_neg_L]
      omega
  refine ⟨htr_incl, htr_smul, hnorm_incl, hnorm_add, hnorm_sub,
    h2_ne, h2_val, hchar2, hOK_decomp,
    u_0, δ_K, hu0_val, ?_, hN_u0, hρ_res_ne0, hρ_res_ne1, ?_, hδK_val, hδK_norm⟩
  · rw [hu0_coe]; exact hu_approx
  · rw [hu0_coe]; exact htr_u

theorem ld_dyadic_boundary_polar_functions_and_L_sums (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] (hLK : L ≤ K)
    (hp_eq2 : Module.finrank L (IntermediateField.extendScalars hLK) = 2)
    (ψ : AddChar L (Ω F))
    (ν₁ χ' : Lˣ →* (Ω F)ˣ)
    (hν₁_pow : ν₁ ^ (Module.finrank L (IntermediateField.extendScalars hLK)) = 1)
    (hb_ge2 : 2 ≤ condExp F L ν₁)
    (hab_eq : condExp F L χ' = condExp F L ν₁)
    (hb_odd : condExp F L ν₁ % 2 = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hSpecL : ∀ (θ : Lˣ →* (Ω F)ˣ),
      (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L θ ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L θ), θ u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L θ - 1), θ u₀ ≠ 1)) ∧
      valL F L ((tateElt F L θ ψ : Lˣ) : L) = (condExp F L θ : ℤ) + condExpChar F L ψ)
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (R_L : Finset L) (c_τ : Lˣ) (N : Lˣ) (τ_unit τ_tilde : ℕ → Lˣ) (c_ν c_twist : ℕ → Lˣ) (c_χ : Lˣ)
    (hRL_card : R_L.card = Fintype.card k_L)
    (hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r)
    (hRL_sep : ∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0)
    (hc_τ_val : valL F L (c_τ : L) = (condExp F L ν₁ : ℤ) + condExpChar F L ψ)
    (hc_τ_stat : ∀ x : L, (x = 0 ∨ (((condExp F L ν₁ + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (ν₁ (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_τ⁻¹ : Lˣ) : L) * x))
    (hN_val : valL F L (N : L) = 0)
    (hc_χ_eq : c_χ = c_τ * N⁻¹)
    (hτ_props : ∀ j < Module.finrank L (IntermediateField.extendScalars hLK), 0 < j →
      (τ_tilde j : L) = (j : L) ^ ((Module.finrank L (IntermediateField.extendScalars hLK)) ^ (condExp F L ν₁)) ∧
      τ_unit j = (τ_tilde j) ^ (Module.finrank L (IntermediateField.extendScalars hLK)) ∧
      Units.map (normLM F hLK) (Units.map (IntermediateField.inclusion hLK).toMonoidHom (τ_tilde j)) = τ_unit j ∧
      ν₁ (τ_unit j) = 1 ∧
      c_ν j = c_τ * (τ_unit j)⁻¹ ∧
      (N : L) + (τ_unit j : L) ≠ 0 ∧
      valL F L ((N : L) + (τ_unit j : L)) = 0 ∧
      (((c_twist j)⁻¹ : Lˣ) : L) = ((c_τ⁻¹ : Lˣ) : L) * ((N : L) + (τ_unit j : L)))
    (hc_χ_val : valL F L (c_χ : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_χ_stat : ∀ x : L, (x = 0 ∨ (((condExp F L χ' + 1) / 2 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c_χ⁻¹ : Lˣ) : L) * x))
    (h2_ne : (2 : L) ≠ 0)
    (h2_val : valL F L (2 : L) = ((condExp F L ν₁ / 2 : ℕ) : ℤ))
    (u_0 : Lˣ) (hu0_val : valL F L (u_0 : L) = 0)
    (hN_u0 : (N : L) - (u_0 : L) ^ 2 = 0 ∨ 1 ≤ valL F L ((N : L) - (u_0 : L) ^ 2)) :
    let δ_τ : Lˣ := Units.mk0 (2 : L) h2_ne
