    haveI : IsGalois k₀ K_N := (InfiniteGalois.normal_iff_isGalois K_N).mp hKN_norm
    let e_KN : ↥K_N ≃ₐ[k₀] ↥K₀ := (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hKN_map)
    exact IsGalois.of_algEquiv e_KN

  have hSep_iff : ∀ (A B : IntermediateField F (AlgebraicClosure F)) (hAB : A ≤ B),
      Algebra.IsSeparable A (IntermediateField.extendScalars hAB) ↔
        B ≤ IntermediateField.restrictScalars F (separableClosure A (AlgebraicClosure F)) := by
    intro A B hAB
    let S := IntermediateField.extendScalars hAB
    have hmin : ∀ x : S, IsSeparable A x.1 ↔ IsSeparable A x := by
      intro x
      change (minpoly A (S.val x)).Separable ↔ (minpoly A x).Separable
      rw [minpoly.algHom_eq S.val S.val.injective x]
    constructor
    · intro hSep z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      let x : S := ⟨z, (IntermediateField.mem_extendScalars hAB).mpr hz⟩
      exact (hmin x).mpr (@Algebra.IsSeparable.isSeparable A S _ _ _ hSep x)
    · intro hle
      refine ⟨fun x => (hmin x).mp ?_⟩
      have hz : x.1 ∈ B := (IntermediateField.mem_extendScalars hAB).mp x.2
      exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp (hle hz))

  have h_abs_finrank : ∀ (k E₀ Ω_bar : Type u) [Field k] [Field E₀] [Field Ω_bar]
      [Algebra k E₀] [Algebra k Ω_bar] [FiniteDimensional k E₀] [IsGalois k E₀]
      (f : E₀ →ₐ[k] Ω_bar) (A_ext : IntermediateField k Ω_bar),
      (∀ z ∈ A_ext, ∃ y : E₀, f y = z) →
      Module.finrank k ↥A_ext * Nat.card ((A_ext.comap f).fixingSubgroup) =
        Module.finrank k E₀ := by
    clear * -
    intro k E₀ Ω_bar _ _ _ _ _ _ _ f A_ext h_surj
    let A' : IntermediateField k E₀ := A_ext.comap f
    have hA'_map : A'.map f = A_ext := by
      ext z
      refine ⟨?_, fun hz => ?_⟩
      · rintro ⟨y, hy, rfl⟩
        exact hy
      · obtain ⟨y, rfl⟩ := h_surj z hz
        exact ⟨y, hz, rfl⟩
    have hfin_A' : Module.finrank k ↥A' = Module.finrank k ↥A_ext := by
      have h1 : Module.finrank k ↥A' = Module.finrank k ↥(A'.map f) :=
        LinearEquiv.finrank_eq (A'.equivMap f).toLinearEquiv
      rwa [hA'_map] at h1
    have hmul : Module.finrank k ↥(IntermediateField.fixedField A'.fixingSubgroup) *
        Module.finrank ↥(IntermediateField.fixedField A'.fixingSubgroup) E₀ =
        Module.finrank k E₀ :=
      Module.finrank_mul_finrank k ↥(IntermediateField.fixedField A'.fixingSubgroup) E₀
    rwa [IntermediateField.finrank_fixedField_eq_card A'.fixingSubgroup,
      IsGalois.fixedField_fixingSubgroup A', hfin_A'] at hmul

  have h_tower_finrank : ∀ (L₀ A₀ K₀ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F L₀] [FiniteDimensional F K₀]
      (hLK₀ : L₀ ≤ K₀) (hLA₀ : L₀ ≤ A₀) (hAK₀ : A₀ ≤ K₀),
      Module.finrank L₀ (IntermediateField.extendScalars hLA₀) *
        Module.finrank A₀ (IntermediateField.extendScalars hAK₀) =
        Module.finrank L₀ (IntermediateField.extendScalars hLK₀) ∧
      0 < Module.finrank L₀ (IntermediateField.extendScalars hLA₀) ∧
      Module.finrank F L₀ * Module.finrank L₀ (IntermediateField.extendScalars hLA₀) =
        Module.finrank F A₀ := by
    clear * -
    intro L₀ A₀ K₀ hFinL₀ hFinK₀ hLK₀ hLA₀ hAK₀
    let K' := IntermediateField.extendScalars hLK₀
    let A_ext := IntermediateField.extendScalars hLA₀
    let K_A := IntermediateField.extendScalars hAK₀
    haveI : FiniteDimensional F A₀ :=
      Module.Finite.of_injective (IntermediateField.inclusion hAK₀).toLinearMap
        (IntermediateField.inclusion hAK₀).injective
    haveI : FiniteDimensional F ↥A_ext := ‹FiniteDimensional F A₀›
    haveI : FiniteDimensional F ↥K' := hFinK₀
    haveI : FiniteDimensional F ↥K_A := hFinK₀
    haveI : IsScalarTower F L₀ ↥K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : IsScalarTower F L₀ ↥A_ext := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : IsScalarTower F A₀ ↥K_A := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional L₀ ↥A_ext := Module.Finite.of_restrictScalars_finite F L₀ ↥A_ext
    haveI : FiniteDimensional L₀ ↥K' := Module.Finite.of_restrictScalars_finite F L₀ ↥K'
    haveI : FiniteDimensional A₀ ↥K_A := Module.Finite.of_restrictScalars_finite F A₀ ↥K_A
    have hF_LK : Module.finrank F L₀ * Module.finrank L₀ ↥K' = Module.finrank F K₀ :=
      Module.finrank_mul_finrank F L₀ ↥K'
    have hF_LA : Module.finrank F L₀ * Module.finrank L₀ ↥A_ext = Module.finrank F A₀ :=
      Module.finrank_mul_finrank F L₀ ↥A_ext
    have hF_AK : Module.finrank F A₀ * Module.finrank A₀ ↥K_A = Module.finrank F K₀ :=
      Module.finrank_mul_finrank F A₀ ↥K_A
    have hF_pos : 0 < Module.finrank F L₀ := Module.finrank_pos
    refine ⟨?_, Module.finrank_pos, hF_LA⟩
    apply Nat.eq_of_mul_eq_mul_left hF_pos
    rw [← mul_assoc, hF_LA, hF_AK, hF_LK]

  
  set p := p F
  set q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  have hp_pos : 0 < p := hp_prime.pos
  have hp_gt1 : 1 < p := hp_prime.one_lt
  haveI : Fact (Nat.Prime p) := ⟨hp_prime⟩
  have hq_gt1 : 1 < q := by
    rw [hq_eq]
    exact one_lt_pow₀ hp_gt1 (by omega)
  let K' : IntermediateField M_C (AlgebraicClosure F) := IntermediateField.extendScalars hM_CK
  let e_MCK : K ≃ₐ[F] K' :=
    { toExtendScalars F hM_CK with
      invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hM_CK).mp z.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      commutes' := fun _ => rfl }
  let fromExtendScalars : K' →+* K := e_MCK.symm.toRingHom
  haveI : FiniteDimensional F K' := Module.Finite.equiv e_MCK.toLinearEquiv
  haveI : IsScalarTower F M_C K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional M_C K' := Module.Finite.of_restrictScalars_finite F M_C K'
  haveI : Normal F (AlgebraicClosure F) := IsAlgClosure.normal F (AlgebraicClosure F)
  haveI : Normal M_C (AlgebraicClosure F) := Normal.tower_top_of_normal F M_C (AlgebraicClosure F)
  haveI : Algebra.IsSeparable M_C K' := hGalMCK.2.2.2 hM_CK
  have hGalMCK' : IsGalois M_C ↥K' := by
    refine helper_isGalois M_C (AlgebraicClosure F) K' (fun σ τ hτ => ?_)
    let σ_F : M_C.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv M_C).symm σ
    let τ_F : M_C.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv M_C).symm τ
    have hτK : τ_F.1 ∈ K.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      exact hτ x ((IntermediateField.mem_extendScalars hM_CK).mpr hx)
    have hconjK : (σ_F * τ_F * σ_F⁻¹).1 ∈ K.fixingSubgroup :=
      hGalMCK.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτK
    intro x hx
    rw [IntermediateField.mem_fixingSubgroup_iff] at hconjK
    exact hconjK x ((IntermediateField.mem_extendScalars hM_CK).mp hx)
  haveI : IsGalois M_C ↥K' := hGalMCK'
  haveI : Normal M_C ↥K' := IsGalois.to_normal
  let C : Type u := (K' ≃ₐ[M_C] K')
  letI : Fintype C := AlgEquiv.fintype M_C K'
  have hcard_C : Nat.card C = q := IsGalois.card_aut_eq_finrank M_C K'
  have hcard_C_fintype : Fintype.card C = q := Fintype.card_eq_nat_card.trans hcard_C
  have hcard_C_gt1 : 1 < Fintype.card C := hcard_C_fintype.symm ▸ hq_gt1

  let act : C → K → K := fun γ w => fromExtendScalars (γ (toExtendScalars F hM_CK w))
  have hact_one : ∀ w : K, act 1 w = w := fun _ => rfl
  have hact_mul : ∀ (γ₁ γ₂ : C) (w : K), act (γ₁ * γ₂) w = act γ₁ (act γ₂ w) := fun _ _ _ => rfl
  have hact_ring : ∀ γ : C,
      act γ 0 = 0 ∧ act γ 1 = 1 ∧
      (∀ w₁ w₂ : K,
        act γ (w₁ + w₂) = act γ w₁ + act γ w₂ ∧
        act γ (w₁ * w₂) = act γ w₁ * act γ w₂ ∧
        act γ (-w₁) = -act γ w₁) := by
    intro γ
    refine ⟨by change fromExtendScalars (γ 0) = 0; rw [map_zero, map_zero],
      by change fromExtendScalars (γ 1) = 1; rw [map_one, map_one],
      fun w₁ w₂ => ⟨?_, ?_, ?_⟩⟩
    · change fromExtendScalars (γ (toExtendScalars F hM_CK w₁ + toExtendScalars F hM_CK w₂)) = _
      rw [map_add, map_add]
    · change fromExtendScalars (γ (toExtendScalars F hM_CK w₁ * toExtendScalars F hM_CK w₂)) = _
      rw [map_mul, map_mul]
    · change fromExtendScalars (γ (-toExtendScalars F hM_CK w₁)) = _
      rw [map_neg, map_neg]
  have hact_faithful : ∀ γ : C, (∀ w : K, act γ w = w) → γ = 1 := by
    intro γ h
    apply AlgEquiv.ext
    intro z
    exact congrArg (toExtendScalars F hM_CK) (h (fromExtendScalars z))
  have hact_val : ∀ (γ : C) (w : K), valL F K (act γ w) = valL F K w := by
    intro γ w
    let φ_γ : K ≃ₐ[F] K := e_MCK.trans ((γ.restrictScalars F).trans e_MCK.symm)
    have hφ : φ_γ w = act γ w := rfl
    unfold valL relVal
    rw [← hφ, Algebra.norm_eq_of_algEquiv φ_γ w]

  let res_MC : M_C.fixingSubgroup →* C :=
    (AlgEquiv.restrictNormalHom K').comp (IntermediateField.fixingSubgroupEquiv M_C).toMonoidHom
  have h_res_apply : ∀ (σ : M_C.fixingSubgroup) (w : K),
      ((act (res_MC σ) w : K) : AlgebraicClosure F) = (σ.1 : AbsGal F) (w : AlgebraicClosure F) := by
    intro σ w
    change ((AlgEquiv.restrictNormalHom K'
      ((IntermediateField.fixingSubgroupEquiv M_C) σ) (toExtendScalars F hM_CK w) : K') :
        AlgebraicClosure F) = (σ.1 : AbsGal F) (w : AlgebraicClosure F)
    rw [AlgEquiv.restrictNormalHom_apply]
    rfl
  have h_res_apply_K' : ∀ (σ : M_C.fixingSubgroup) (x : K'),
      ((res_MC σ x : K') : AlgebraicClosure F) = σ.1 x.1 := by
    intro σ x
    change ((AlgEquiv.restrictNormalHom K'
      ((IntermediateField.fixingSubgroupEquiv M_C) σ) x : K') : AlgebraicClosure F) = σ.1 x.1
    rw [AlgEquiv.restrictNormalHom_apply]
    rfl
  have h_res_surj : Function.Surjective res_MC :=
    (AlgEquiv.restrictNormalHom_surjective (AlgebraicClosure F)).comp
      (IntermediateField.fixingSubgroupEquiv M_C).surjective
  have h_res_ker : ∀ σ : M_C.fixingSubgroup, σ.1 ∈ K.fixingSubgroup ↔ res_MC σ = 1 := by
    intro σ
    rw [IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro hσ
      apply hact_faithful
      intro w
      apply Subtype.ext
      rw [h_res_apply σ w]
      exact hσ w.1 w.2
    · intro hg1 x hx
      let w : K := ⟨x, hx⟩
      have h1 := h_res_apply σ w
      rw [hg1, hact_one w] at h1
      exact h1.symm

  have hC_ab : ∀ γ₁ γ₂ : C, γ₁ * γ₂ = γ₂ * γ₁ := by
    intro γ₁ γ₂
    obtain ⟨σ₁, rfl⟩ := h_res_surj γ₁
    obtain ⟨σ₂, rfl⟩ := h_res_surj γ₂
    have hcommK : (σ₁ * σ₂ * σ₁⁻¹ * σ₂⁻¹).1 ∈ K.fixingSubgroup :=
      hAbMCK.2.1 σ₁.1 σ₁.2 σ₂.1 σ₂.2
    have hcomm1 : res_MC (σ₁ * σ₂ * σ₁⁻¹ * σ₂⁻¹) = 1 :=
      (h_res_ker (σ₁ * σ₂ * σ₁⁻¹ * σ₂⁻¹)).mp hcommK
    rw [map_mul, map_mul, map_mul, map_inv, map_inv] at hcomm1
    calc res_MC σ₁ * res_MC σ₂
      _ = (res_MC σ₁ * res_MC σ₂ * (res_MC σ₁)⁻¹ * (res_MC σ₂)⁻¹) * (res_MC σ₂ * res_MC σ₁) := by
        group
      _ = 1 * (res_MC σ₂ * res_MC σ₁) := by rw [hcomm1]
      _ = res_MC σ₂ * res_MC σ₁ := one_mul _

  have hC_exp : ∀ γ : C, γ ^ p = 1 := by
    intro γ
    obtain ⟨σ, rfl⟩ := h_res_surj γ
    have hpowK : (σ ^ p).1 ∈ K.fixingSubgroup := hExpMCK σ.1 σ.2
    have hpow1 : res_MC (σ ^ p) = 1 := (h_res_ker (σ ^ p)).mp hpowK
    rwa [map_pow] at hpow1

  have hjump_C : ∀ γ : C, γ ≠ 1 →
      (ϖ_K : K) - act γ (ϖ_K : K) ≠ 0 ∧
      valL F K ((ϖ_K : K) - act γ (ϖ_K : K)) = (t + 1 : ℤ) := by
    intro γ hγ_ne1
    obtain ⟨σ, rfl⟩ := h_res_surj γ
    have hnot_K : σ.1 ∉ K.fixingSubgroup := fun hmem => hγ_ne1 ((h_res_ker σ).mp hmem)
    have hσw : (σ.1 : AbsGal F) (ϖ_K : AlgebraicClosure F) ∈ K := by
      rw [← h_res_apply σ (ϖ_K : K)]
      exact (act (res_MC σ) (ϖ_K : K)).2
    have hσ_eq : (⟨(σ.1 : AbsGal F) (ϖ_K : AlgebraicClosure F), hσw⟩ : K) =
        act (res_MC σ) (ϖ_K : K) := by
      apply Subtype.ext
      exact (h_res_apply σ (ϖ_K : K)).symm
    have hj := hJumpK σ.1 σ.2 hnot_K hσw
    rwa [hσ_eq] at hj

  obtain ⟨τ₀, hτ₀⟩ := Fintype.exists_ne_of_one_lt_card hcard_C_gt1 (1 : C)
  let C_1 : Subgroup C := Subgroup.zpowers τ₀
  have horder_τ₀ : orderOf τ₀ = p := orderOf_eq_prime (hC_exp τ₀) hτ₀
  have hcard_C1_nat : Nat.card C_1 = p := (Nat.card_zpowers τ₀).trans horder_τ₀
  have hcard_C1 : Fintype.card C_1 = p := Fintype.card_eq_nat_card.trans hcard_C1_nat
  have hC1_norm : C_1.Normal := by
    refine ⟨fun c hc g => ?_⟩
    have h : g * c * g⁻¹ = c := by
      calc g * c * g⁻¹ = (c * g) * g⁻¹ := by rw [hC_ab g c]
        _ = c := mul_inv_cancel_right c g
    rwa [h]
  haveI : C_1.Normal := hC1_norm

  let toSub : ∀ (A : IntermediateField F (AlgebraicClosure F)), M_C ≤ A → IntermediateField M_C K' :=
    fun A hMCA => (IntermediateField.extendScalars hMCA).comap K'.val
  let fieldOf : Subgroup C → IntermediateField F (AlgebraicClosure F) :=
    fun M => (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F
  let M_1 : IntermediateField F (AlgebraicClosure F) := fieldOf C_1

  have h_mem_toSub : ∀ (A : IntermediateField F (AlgebraicClosure F)) (hMCA : M_C ≤ A) (y : K'),
      y ∈ toSub A hMCA ↔ y.1 ∈ A :=
    fun A hMCA _ => IntermediateField.mem_extendScalars hMCA
  have hMC_M1 : M_C ≤ M_1 := by
    intro z hz
    rw [IntermediateField.mem_restrictScalars]
    exact (IntermediateField.lift (IntermediateField.fixedField C_1)).algebraMap_mem ⟨z, hz⟩
  have hM1_K : M_1 ≤ K := by
    intro z hz
    rw [IntermediateField.mem_restrictScalars] at hz
    exact (IntermediateField.mem_extendScalars hM_CK).mp
      (IntermediateField.lift_le (IntermediateField.fixedField C_1) hz)
  have hFinM1 : FiniteDimensional F M_1 :=
    Module.Finite.of_injective (IntermediateField.inclusion hM1_K).toLinearMap
      (IntermediateField.inclusion hM1_K).injective
  haveI : FiniteDimensional F M_1 := hFinM1

  have h_mem_M1 : ∀ x : K',
      (x : AlgebraicClosure F) ∈ M_1 ↔ x ∈ IntermediateField.fixedField C_1 := by
    intro x
    exact (IntermediateField.mem_restrictScalars F).trans (IntermediateField.mem_lift x)
  have h_toSub_M1 : toSub M_1 hMC_M1 = IntermediateField.fixedField C_1 := by
    ext x
    exact (h_mem_toSub M_1 hMC_M1 x).trans (h_mem_M1 x)
  have h_fixing_toSub_M1 : (toSub M_1 hMC_M1).fixingSubgroup = C_1 := by
    rw [h_toSub_M1, IntermediateField.fixingSubgroup_fixedField C_1]

  have h_res_M1 : ∀ σ : M_C.fixingSubgroup,
      σ.1 ∈ M_1.fixingSubgroup ↔ res_MC σ ∈ C_1 := by
    intro σ
    rw [ ← h_fixing_toSub_M1, IntermediateField.mem_fixingSubgroup_iff,
      IntermediateField.mem_fixingSubgroup_iff]
    constructor
    · intro hσ y hy
      apply Subtype.ext
      rw [h_res_apply_K' σ y]
      exact hσ y.1 ((h_mem_toSub M_1 hMC_M1 y).mp hy)
    · intro hσ x hx
      let y : K' := ⟨x, (IntermediateField.mem_extendScalars hM_CK).mpr (hM1_K hx)⟩
      have hy : y ∈ toSub M_1 hMC_M1 := (h_mem_toSub M_1 hMC_M1 y).mpr hx
      have h1 := congrArg Subtype.val (hσ y hy)
      rwa [h_res_apply_K' σ y] at h1

  have hLift_not_M1 : ∀ σ ∈ M_C.fixingSubgroup, σ ∉ M_1.fixingSubgroup →
      ∃ γ_σ : C, γ_σ ∉ C_1 ∧
        ∀ w : K, ((act γ_σ w : K) : AlgebraicClosure F) =
          (σ : AbsGal F) (w : AlgebraicClosure F) := by
    intro σ hσMC hσ_not_M1
    let σ' : M_C.fixingSubgroup := ⟨σ, hσMC⟩
    have hnot_C1 : res_MC σ' ∉ C_1 := fun hmem => hσ_not_M1 ((h_res_M1 σ').mpr hmem)
    exact ⟨res_MC σ', hnot_C1, fun w => h_res_apply σ' w⟩

  have hGalMCM1 : IsGaloisExt F M_C M_1 := by
    refine ⟨hMC_M1, hFinM1, ?_, ?_⟩
    · intro σ hσ τ hτ
      have hτMC : τ ∈ M_C.fixingSubgroup := IntermediateField.fixingSubgroup_le hMC_M1 hτ
      let σ' : M_C.fixingSubgroup := ⟨σ, hσ⟩
      let τ' : M_C.fixingSubgroup := ⟨τ, hτMC⟩
      have hτC1 : res_MC τ' ∈ C_1 := (h_res_M1 τ').mp hτ
      have hconjC1 : res_MC (σ' * τ' * σ'⁻¹) ∈ C_1 := by
        rw [map_mul, map_mul, map_inv]
        exact hC1_norm.conj_mem (res_MC τ') hτC1 (res_MC σ')
      exact (h_res_M1 (σ' * τ' * σ'⁻¹)).mpr hconjC1
    · intro h
      let S_M1 := IntermediateField.extendScalars h
      refine ⟨fun x => ?_⟩
      have hxM1 : (x : AlgebraicClosure F) ∈ M_1 := (IntermediateField.mem_extendScalars h).mp x.2
      let x_K : K' := ⟨x.1, (IntermediateField.mem_extendScalars hM_CK).mpr (hM1_K hxM1)⟩
      have hmin1 : (minpoly M_C (S_M1.val x)).Separable ↔ (minpoly M_C x).Separable := by
        rw [minpoly.algHom_eq S_M1.val S_M1.val.injective x]
      have hmin2 : (minpoly M_C (K'.val x_K)).Separable ↔ (minpoly M_C x_K).Separable := by
        rw [minpoly.algHom_eq K'.val K'.val.injective x_K]
      exact hmin1.mp (hmin2.mpr (Algebra.IsSeparable.isSeparable M_C x_K))

  have hAbMCM1 : IsAbelianExt F hMC_M1 := by
    refine ⟨hGalMCM1.2.2.1, ?_, hGalMCM1.2.2.2 hMC_M1⟩
    intro σ hσ τ hτ
    exact IntermediateField.fixingSubgroup_le hM1_K (hAbMCK.2.1 σ hσ τ hτ)

  have hExpMCM1 : ∀ σ ∈ M_C.fixingSubgroup, σ ^ p ∈ M_1.fixingSubgroup := by
    intro σ hσ
    exact IntermediateField.fixingSubgroup_le hM1_K (hExpMCK σ hσ)

  have hGalM1K : IsGaloisExt F M_1 K := by
    refine ⟨hM1_K, inferInstance, ?_, ?_⟩
    · intro σ hσ τ hτ
      exact hGalMCK.2.2.1 σ (IntermediateField.fixingSubgroup_le hMC_M1 hσ) τ hτ
    · intro h
      rw [hSep_iff]
      intro z hz
      rw [IntermediateField.mem_restrictScalars, mem_separableClosure_iff]
      have hzMC : IsSeparable M_C z := by
        have hK_sep := (hSep_iff M_C K hM_CK).mp (hGalMCK.2.2.2 hM_CK) hz
        exact mem_separableClosure_iff.mp ((IntermediateField.mem_restrictScalars F).mp hK_sep)
      exact IsSeparable.tower_top (↥(IntermediateField.extendScalars hMC_M1)) hzMC

  have hAbM1K : IsAbelianExt F hM1_K := by
    refine ⟨hGalM1K.2.2.1, ?_, hGalM1K.2.2.2 hM1_K⟩
    intro σ hσ τ hτ
    exact hAbMCK.2.1 σ (IntermediateField.fixingSubgroup_le hMC_M1 hσ)
      τ (IntermediateField.fixingSubgroup_le hMC_M1 hτ)

  have hJump_M1K : ∀ σ ∈ M_1.fixingSubgroup, σ ∉ K.fixingSubgroup →
      ∀ hσw : (σ : AbsGal F) (ϖ_K : AlgebraicClosure F) ∈ K,
        (ϖ_K : K) - (⟨(σ : AbsGal F) (ϖ_K : AlgebraicClosure F), hσw⟩ : K) ≠ 0 ∧
        valL F K ((ϖ_K : K) - (⟨(σ : AbsGal F) (ϖ_K : AlgebraicClosure F), hσw⟩ : K)) =
          (t + 1 : ℤ) := by
    intro σ hσM1 hσK hσw
    exact hJumpK σ (IntermediateField.fixingSubgroup_le hMC_M1 hσM1) hσK hσw

  have hfin_mul_card :
      Module.finrank M_C (IntermediateField.extendScalars hMC_M1) * Nat.card C_1 = q ∧
      Module.finrank M_C (IntermediateField.extendScalars hMC_M1) *
        Module.finrank M_1 (IntermediateField.extendScalars hM1_K) = q ∧
      Nat.card C_1 = Module.finrank M_1 (IntermediateField.extendScalars hM1_K) := by
    let M1_ext : IntermediateField M_C (AlgebraicClosure F) :=
      IntermediateField.extendScalars hMC_M1
    have hmul_fix : Module.finrank M_C ↥M1_ext * Nat.card (toSub M_1 hMC_M1).fixingSubgroup = q :=
      h_abs_finrank ↥M_C ↥K' (AlgebraicClosure F) K'.val M1_ext (fun z hz =>
        ⟨⟨z, (IntermediateField.mem_extendScalars hM_CK).mpr
          (hM1_K ((IntermediateField.mem_extendScalars hMC_M1).mp hz))⟩, rfl⟩)
    rw [h_fixing_toSub_M1] at hmul_fix
    obtain ⟨hmul_tower, hMCM1_pos, _⟩ := h_tower_finrank M_C M_1 K hM_CK hMC_M1 hM1_K
    have hcard_eq : Nat.card C_1 = Module.finrank M_1 (IntermediateField.extendScalars hM1_K) := by
      apply Nat.eq_of_mul_eq_mul_left hMCM1_pos
      rw [hmul_fix, hmul_tower]
    exact ⟨hmul_fix, hmul_tower, hcard_eq⟩

  have hfin_M1K : Module.finrank M_1 (IntermediateField.extendScalars hM1_K) = p :=
    hfin_mul_card.2.2.symm.trans hcard_C1_nat
  have hfin_MCM1 : Module.finrank M_C (IntermediateField.extendScalars hMC_M1) = p ^ r := by
    apply Nat.eq_of_mul_eq_mul_right hp_pos
    calc Module.finrank M_C (IntermediateField.extendScalars hMC_M1) * p
      _ = Module.finrank M_C (IntermediateField.extendScalars hMC_M1) * Nat.card C_1 := by
        rw [hcard_C1_nat]
      _ = q := hfin_mul_card.1
      _ = p ^ (r + 1) := hq_eq
      _ = (p ^ r) * p := pow_succ p r

  have hC1_fix_M1 : ∀ (τ : C_1) (y : M_1),
      act τ.1 (IntermediateField.inclusion hM1_K y) = IntermediateField.inclusion hM1_K y := by
    intro τ y
    have hy_mem : toExtendScalars F hM_CK (IntermediateField.inclusion hM1_K y) ∈
        IntermediateField.fixedField C_1 := (h_mem_M1 _).mp y.2
    have h1 := (IntermediateField.mem_fixedField_iff C_1 _).mp hy_mem τ.1 τ.2
    exact congrArg fromExtendScalars h1

  have hact_norm_M1K : ∀ w : K,
      IntermediateField.inclusion hM1_K (normLM F hM1_K w) = ∏ τ : C_1, act τ.1 w := by
    let K_M1 : IntermediateField M_1 (AlgebraicClosure F) := IntermediateField.extendScalars hM1_K
    let e_KM1 : K ≃ₐ[F] K_M1 :=
      { toExtendScalars F hM1_K with
        invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars hM1_K).mp z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        commutes' := fun _ => rfl }
    let fromKM1 : K_M1 →+* K := e_KM1.symm.toRingHom
    haveI : FiniteDimensional F K_M1 := Module.Finite.equiv e_KM1.toLinearEquiv
    haveI : IsScalarTower F M_1 K_M1 := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional M_1 K_M1 := Module.Finite.of_restrictScalars_finite F M_1 K_M1
    haveI : Normal M_1 (AlgebraicClosure F) := Normal.tower_top_of_normal F M_1 (AlgebraicClosure F)
    haveI : Algebra.IsSeparable M_1 K_M1 := hGalM1K.2.2.2 hM1_K
    have hGalKM1' : IsGalois M_1 ↥K_M1 := by
      refine helper_isGalois M_1 (AlgebraicClosure F) K_M1 (fun σ τ hτ => ?_)
      let σ_F : M_1.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv M_1).symm σ
      let τ_F : M_1.fixingSubgroup := (IntermediateField.fixingSubgroupEquiv M_1).symm τ
      have hτK : τ_F.1 ∈ K.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro x hx
        exact hτ x ((IntermediateField.mem_extendScalars hM1_K).mpr hx)
      have hconjK : (σ_F * τ_F * σ_F⁻¹).1 ∈ K.fixingSubgroup :=
        hGalM1K.2.2.1 σ_F.1 σ_F.2 τ_F.1 hτK
      intro x hx
      rw [IntermediateField.mem_fixingSubgroup_iff] at hconjK
      exact hconjK x ((IntermediateField.mem_extendScalars hM1_K).mp hx)
    haveI : IsGalois M_1 ↥K_M1 := hGalKM1'
    let G_M1K := (K_M1 ≃ₐ[M_1] K_M1)
    letI : Fintype G_M1K := AlgEquiv.fintype M_1 K_M1
    let Φ : C_1 → G_M1K := fun s =>
      { toFun := fun x => toExtendScalars F hM1_K (act s.1 (fromKM1 x))
        invFun := fun x => toExtendScalars F hM1_K (act (s.1)⁻¹ (fromKM1 x))
        left_inv := fun x => by
          change toExtendScalars F hM1_K (act (s.1)⁻¹ (act s.1 (fromKM1 x))) = x
          rw [← hact_mul, inv_mul_cancel, hact_one]
          rfl
        right_inv := fun x => by
          change toExtendScalars F hM1_K (act s.1 (act (s.1)⁻¹ (fromKM1 x))) = x
          rw [← hact_mul, mul_inv_cancel, hact_one]
          rfl
        map_mul' := fun x y => by
          change toExtendScalars F hM1_K (act s.1 (fromKM1 x * fromKM1 y)) = _
          rw [((hact_ring s.1).2.2 (fromKM1 x) (fromKM1 y)).2.1, map_mul]
        map_add' := fun x y => by
          change toExtendScalars F hM1_K (act s.1 (fromKM1 x + fromKM1 y)) = _
          rw [((hact_ring s.1).2.2 (fromKM1 x) (fromKM1 y)).1, map_add]
        commutes' := fun y => by
          change toExtendScalars F hM1_K (act s.1 (IntermediateField.inclusion hM1_K y)) =
            toExtendScalars F hM1_K (IntermediateField.inclusion hM1_K y)
          rw [hC1_fix_M1 s y] }
    have hΦ_inj : Function.Injective Φ := by
      intro s₁ s₂ hs
      have h_eq : (s₁.1)⁻¹ * s₂.1 = 1 := by
        apply hact_faithful
        intro w
        have hw : act s₁.1 w = act s₂.1 w :=
          congrArg fromKM1 (AlgEquiv.congr_fun hs (toExtendScalars F hM1_K w))
        calc act ((s₁.1)⁻¹ * s₂.1) w = act (s₁.1)⁻¹ (act s₂.1 w) := hact_mul _ _ w
          _ = act (s₁.1)⁻¹ (act s₁.1 w) := by rw [hw]
          _ = act ((s₁.1)⁻¹ * s₁.1) w := (hact_mul _ _ w).symm
          _ = w := by rw [inv_mul_cancel, hact_one]
      apply Subtype.ext
      exact inv_mul_eq_one.mp h_eq
    have hΦ_card : Fintype.card C_1 = Fintype.card G_M1K := by
      rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, hfin_mul_card.2.2,
        IsGalois.card_aut_eq_finrank M_1 K_M1]
    let e_Φ : C_1 ≃ G_M1K := Equiv.ofBijective Φ
      ((Fintype.bijective_iff_injective_and_card Φ).mpr ⟨hΦ_inj, hΦ_card⟩)
    intro w
    have h1 := congrArg fromKM1
      (Algebra.norm_eq_prod_automorphisms M_1 (toExtendScalars F hM1_K w))
    have h2 : fromKM1 (∏ σ : G_M1K, σ (toExtendScalars F hM1_K w)) =
        ∏ σ : G_M1K, fromKM1 (σ (toExtendScalars F hM1_K w)) :=
      map_prod fromKM1 (fun σ : G_M1K => σ (toExtendScalars F hM1_K w)) Finset.univ
    rw [h2, ← Equiv.prod_comp e_Φ (fun σ : G_M1K => fromKM1 (σ (toExtendScalars F hM1_K w)))] at h1
    exact h1

  let ϖ_M1 : M_1ˣ := Units.map (normLM F hM1_K) ϖ_K
  have hϖ_norm1 : Units.map (normLM F hM1_K) ϖ_K = ϖ_M1 := rfl

  have hnorm_trans_aux : ∀ (L₀ M₀ E₀ : Type u) [Field L₀] [Field M₀] [Field E₀]
      (algLM : Algebra L₀ M₀) (algME : Algebra M₀ E₀) (algLE : Algebra L₀ E₀)
      (h1 : ∀ x : L₀, @algebraMap M₀ E₀ _ _ algME (@algebraMap L₀ M₀ _ _ algLM x) =
        @algebraMap L₀ E₀ _ _ algLE x)
      (z : E₀),
      @Algebra.norm L₀ E₀ _ _ algLE z =
        @Algebra.norm L₀ M₀ _ _ algLM (@Algebra.norm M₀ E₀ _ _ algME z) := by
    clear * -
    intro L₀ M₀ E₀ _ _ _ algLM algME algLE h1 z
    letI : Algebra L₀ M₀ := algLM
    letI : Algebra M₀ E₀ := algME
    letI : Algebra L₀ E₀ := algLE
    haveI : IsScalarTower L₀ M₀ E₀ := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x => (h1 x).symm)
    exact (Algebra.norm_norm (a := z)).symm

  have hnorm_eq_inclusion : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      (h : A ≤ B) (y : B),
      @Algebra.norm A B _ _ (IntermediateField.inclusion h).toAlgebra y = normLM F h y := by
    clear * -
    intro A B h y
    letI : Algebra A B := (IntermediateField.inclusion h).toAlgebra
    let e : B ≃ₐ[A] IntermediateField.extendScalars h := {
      toFun := toExtendScalars F h
      invFun := fun z => ⟨z.1, (IntermediateField.mem_extendScalars h).mp z.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl
    }
    exact (Algebra.norm_eq_of_algEquiv e y).symm

  have hnorm_trans : ∀ w : K,
      normLM F hM_CK w = normLM F hMC_M1 (normLM F hM1_K w) := by
    intro w
    rw [← hnorm_eq_inclusion hM_CK w,
        ← hnorm_eq_inclusion hM1_K w,
        ← hnorm_eq_inclusion hMC_M1]
    exact hnorm_trans_aux M_C M_1 K
      (IntermediateField.inclusion hMC_M1).toAlgebra
      (IntermediateField.inclusion hM1_K).toAlgebra
      (IntermediateField.inclusion hM_CK).toAlgebra
      (fun _ => rfl)
      w

  have hϖ_norm2 : Units.map (normLM F hMC_M1) ϖ_M1 = ϖ_MC := by
    rw [← hϖ_normK]
    apply Units.ext
    exact (hnorm_trans (ϖ_K : K)).symm

  
  obtain ⟨hval0_MC, hval1_MC, _, _, hval_mul_MC, _, hval_surj_MC, _, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F M_C
  obtain ⟨hval0_M1, hval1_M1, hval_neg1_M1, hval_neg_M1, hval_mul_M1, hval_inv_M1, hval_surj_M1,
    hval_add_M1, _, hunit_M1, _⟩ := ld_valL_and_unitGroup_props F M_1
  obtain ⟨hval0_K, hval1_K, _, hval_neg_K, hval_mul_K, hval_inv_K, hval_surj_K,
    hval_add_K, _, hunit_K, _⟩ := ld_valL_and_unitGroup_props F K
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0_M1, halg1_M1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F M_1

  have haddVal0 : addVal F 0 = 0 := dif_pos rfl
  have hrelVal_div : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) →
      0 < resDeg F M ∧ ∀ z : M, relVal F M z = (resDeg F M : ℤ) * valL F M z := by
    intro M _ hsurj
    have hrel0 : relVal F M 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F M 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → relVal F M (x * y) = relVal F M x + relVal F M y := by
      intro x y hx hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ (Algebra.norm_ne_zero_iff.mpr hx) (Algebra.norm_ne_zero_iff.mpr hy)]
    have hrel_inv : ∀ u : Mˣ, relVal F M ((u⁻¹ : Mˣ) : M) = - relVal F M (u : M) := by
      intro u
      have hmul := hrel_mul (u : M) ((u⁻¹ : Mˣ) : M) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Mˣ) (k : ℕ),
        relVal F M (((u ^ k : Mˣ) : M)) = (k : ℤ) * relVal F M (u : M) := by
      intro u k
      induction k with
      | zero => simp [hrel1]
      | succ k ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Mˣ) (m : ℤ),
        relVal F M (((u ^ m : Mˣ) : M)) = m * relVal F M (u : M) := by
      intro u m
      cases m with
      | ofNat k =>
        change relVal F M (((u ^ (k : ℤ) : Mˣ) : M)) = (k : ℤ) * relVal F M (u : M)
        rw [zpow_natCast, hrel_pow]
      | negSucc k =>
        rw [zpow_negSucc, hrel_inv (u ^ (k + 1)), hrel_pow u (k + 1), Int.negSucc_eq]
        push_cast
        ring
    let S_M : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : M, x ≠ 0 ∧ relVal F M x = k}
    have hres_ne : resDeg F M ≠ 0 := by
      intro h0
      obtain ⟨c₁, hc₁⟩ := hsurj 1
      unfold valL at hc₁
      rw [h0, Nat.cast_zero, Int.ediv_zero] at hc₁
      omega
    have hS_nonempty : S_M.Nonempty := by
      by_contra hne
      have hempty : S_M = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
      have h0 : resDeg F M = 0 := by
        unfold resDeg
        change sInf S_M = 0
        rw [hempty, Nat.sInf_empty]
      exact hres_ne h0
    have hfM_mem : resDeg F M ∈ S_M := Nat.sInf_mem hS_nonempty
    obtain ⟨hfM_pos, ϖM₀, hϖM₀_ne, hrel_ϖM₀⟩ := hfM_mem
    let ϖM : Mˣ := Units.mk0 ϖM₀ hϖM₀_ne
    have hrel_ϖM : relVal F M (ϖM : M) = (resDeg F M : ℤ) := hrel_ϖM₀
    have hfM_int_pos : (0 : ℤ) < (resDeg F M : ℤ) := Nat.cast_pos.mpr hfM_pos
    have hfM_int_ne : (resDeg F M : ℤ) ≠ 0 := ne_of_gt hfM_int_pos
    refine ⟨hfM_pos, fun z => ?_⟩
    by_cases hz : z = 0
    · unfold valL
      rw [hz, hrel0, Int.zero_ediv, mul_zero]
    · set f : ℤ := (resDeg F M : ℤ)
      set q_z : ℤ := valL F M z
      set r_z : ℤ := relVal F M z % f
      have hediv : f * q_z + r_z = relVal F M z := Int.mul_ediv_add_emod (relVal F M z) f
      have hr_nonneg : 0 ≤ r_z := Int.emod_nonneg (relVal F M z) hfM_int_ne
      have hr_lt : r_z < f := Int.emod_lt_of_pos (relVal F M z) hfM_int_pos
      have hr_zero : r_z = 0 := by
        by_contra hr_ne
        let y : M := z * (((ϖM ^ (-q_z) : Mˣ) : M))
        have hy_ne : y ≠ 0 := mul_ne_zero hz (Units.ne_zero _)
        have hrel_y : relVal F M y = r_z := by
          dsimp [y]
          rw [hrel_mul z _ hz (Units.ne_zero _), hrel_zpow ϖM (-q_z), hrel_ϖM]
          linarith
        let k : ℕ := r_z.toNat
        have hk_eq : (k : ℤ) = r_z := Int.toNat_of_nonneg hr_nonneg
        have hk_pos : 0 < k := by omega
        have hk_lt : k < resDeg F M := by omega
        have hk_mem : k ∈ S_M := ⟨hk_pos, y, hy_ne, by omega⟩
        have hle : resDeg F M ≤ k := Nat.sInf_le hk_mem
        omega
      linarith

  obtain ⟨hresDeg_MC_pos, hdiv_MC⟩ := hrelVal_div M_C hval_surj_MC
  obtain ⟨hresDeg_M1_pos, hdiv_M1⟩ := hrelVal_div M_1 hval_surj_M1
  obtain ⟨hresDeg_K_pos, hdiv_K⟩ := hrelVal_div K hval_surj_K
  have hfMC_int_pos : (0 : ℤ) < (resDeg F M_C : ℤ) := Nat.cast_pos.mpr hresDeg_MC_pos
  have hfMC_int_ne : (resDeg F M_C : ℤ) ≠ 0 := ne_of_gt hfMC_int_pos
  have hfM1_int_pos : (0 : ℤ) < (resDeg F M_1 : ℤ) := Nat.cast_pos.mpr hresDeg_M1_pos
  have hfM1_int_ne : (resDeg F M_1 : ℤ) ≠ 0 := ne_of_gt hfM1_int_pos
  have hfK_int_pos : (0 : ℤ) < (resDeg F K : ℤ) := Nat.cast_pos.mpr hresDeg_K_pos

  have hrelVal_norm_gen : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      [FiniteDimensional F B] (hAB : A ≤ B) (w : B),
      relVal F A (normLM F hAB w) = relVal F B w := by
    clear * -
    intro A B _ hAB w
    let B' := IntermediateField.extendScalars hAB
    let e_AB : B ≃ₐ[F] B' :=
      { toExtendScalars F hAB with
        invFun := fun y => ⟨y.1, (IntermediateField.mem_extendScalars hAB).mp y.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        commutes' := fun _ => rfl }
    haveI : FiniteDimensional F B' := Module.Finite.equiv e_AB.toLinearEquiv
    haveI : IsScalarTower F A B' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    change addVal F (Algebra.norm F (Algebra.norm A (toExtendScalars F hAB w))) =
      addVal F (Algebra.norm F w)
    have h1 : Algebra.norm F (Algebra.norm A (toExtendScalars F hAB w)) =
        Algebra.norm F (toExtendScalars F hAB w) := Algebra.norm_norm
    have h2 : Algebra.norm F w = Algebra.norm F (toExtendScalars F hAB w) :=
      Algebra.norm_eq_of_algEquiv e_AB w
    rw [h1, ← h2]

  obtain ⟨ϖ_1, hϖ_1⟩ := hval_surj_M1 1
  set f₁ : ℤ := valL F M_C (normLM F hMC_M1 (ϖ_1 : M_1))
  set f₂ : ℤ := valL F M_1 (normLM F hM1_K (ϖ_K : K))
  have hres_M1_MC : (resDeg F M_1 : ℤ) = (resDeg F M_C : ℤ) * f₁ := by
    have h1 := hrelVal_norm_gen hMC_M1 (ϖ_1 : M_1)
    rw [hdiv_MC, hdiv_M1, hϖ_1, mul_one] at h1
    exact h1.symm
  have hres_K_M1 : (resDeg F K : ℤ) = (resDeg F M_1 : ℤ) * f₂ := by
    have h1 := hrelVal_norm_gen hM1_K (ϖ_K : K)
    rw [hdiv_M1, hdiv_K, hϖ_K, mul_one] at h1
    exact h1.symm
  have hres_K_MC : (resDeg F K : ℤ) = (resDeg F M_C : ℤ) := by
    have h1 := hrelVal_norm_gen hM_CK (ϖ_K : K)
    rw [hdiv_MC, hdiv_K, hValNormK (ϖ_K : K), hϖ_K, mul_one, mul_one] at h1
    exact h1.symm
  have hf₁_ge1 : 1 ≤ f₁ := by
    by_contra hle
    have hf₁_le0 : f₁ ≤ 0 := by omega
    nlinarith [hres_M1_MC, hfMC_int_pos, hfM1_int_pos]
  have hf₂_ge1 : 1 ≤ f₂ := by
    by_contra hle
    have hf₂_le0 : f₂ ≤ 0 := by omega
    nlinarith [hres_K_M1, hfM1_int_pos, hfK_int_pos]
  have hres_M1_eq_MC : (resDeg F M_1 : ℤ) = (resDeg F M_C : ℤ) := by
    nlinarith [hres_M1_MC, hres_K_M1, hres_K_MC, hf₁_ge1, hf₂_ge1, hfMC_int_pos, hfM1_int_pos]
  have hres_K_eq_M1 : (resDeg F K : ℤ) = (resDeg F M_1 : ℤ) :=
    hres_K_MC.trans hres_M1_eq_MC.symm

  have hValNorm_M1K : ∀ w : K, valL F M_1 (normLM F hM1_K w) = valL F K w := by
    intro w
    apply mul_left_cancel₀ hfM1_int_ne
    have h1 := hrelVal_norm_gen hM1_K w
    rw [hdiv_M1, hdiv_K, hres_K_eq_M1] at h1
    exact h1
  have hϖ_M1 : valL F M_1 (ϖ_M1 : M_1) = 1 :=
    (hValNorm_M1K (ϖ_K : K)).trans hϖ_K
  have hValNorm_MCM1 : ∀ w : M_1, valL F M_C (normLM F hMC_M1 w) = valL F M_1 w := by
    intro w
    apply mul_left_cancel₀ hfMC_int_ne
    have h1 := hrelVal_norm_gen hMC_M1 w
    rw [hdiv_MC, hdiv_M1, hres_M1_eq_MC] at h1
    exact h1

  have hval_pow_M1 : ∀ (z : M_1) (n : ℕ), z ≠ 0 → valL F M_1 (z ^ n) = (n : ℤ) * valL F M_1 z := by
    intro z n hz
    induction n with
    | zero => simp [hval1_M1]
    | succ n ih =>
      rw [pow_succ, hval_mul_M1 (z ^ n) z (pow_ne_zero n hz) hz, ih]
      push_cast
      ring

  have hnorm_inc_M1K : ∀ z : M_1,
      normLM F hM1_K (IntermediateField.inclusion hM1_K z) = z ^ p := by
    intro z
    apply (IntermediateField.inclusion hM1_K).injective
    change IntermediateField.inclusion hM1_K (normLM F hM1_K (IntermediateField.inclusion hM1_K z)) =
      IntermediateField.inclusion hM1_K (z ^ p)
    rw [hact_norm_M1K (IntermediateField.inclusion hM1_K z), map_pow]
    have hprod : (∏ τ : C_1, act τ.1 (IntermediateField.inclusion hM1_K z)) =
        ∏ _τ : C_1, IntermediateField.inclusion hM1_K z :=
      Finset.prod_congr rfl (fun τ _ => hC1_fix_M1 τ z)
    rw [hprod, Finset.prod_const, Finset.card_univ, hcard_C1]

  have hValAlg_M1K : ∀ z : M_1,
      valL F K (IntermediateField.inclusion hM1_K z) = (p : ℤ) * valL F M_1 z := by
    intro z
    by_cases hz : z = 0
    · rw [hz, map_zero, hval0_K, hval0_M1, mul_zero]
    · rw [← hValNorm_M1K (IntermediateField.inclusion hM1_K z), hnorm_inc_M1K z,
        hval_pow_M1 z p hz]

  have hValAlg_MCM1 : ∀ z : M_C,
      valL F M_1 (IntermediateField.inclusion hMC_M1 z) = (((p ^ r : ℕ) : ℤ) * valL F M_C z) := by
    intro z
    have hcomp : IntermediateField.inclusion hM1_K (IntermediateField.inclusion hMC_M1 z) =
        IntermediateField.inclusion hM_CK z := rfl
    have h1 : valL F K (IntermediateField.inclusion hM1_K (IntermediateField.inclusion hMC_M1 z)) =
        (p : ℤ) * valL F M_1 (IntermediateField.inclusion hMC_M1 z) :=
      hValAlg_M1K (IntermediateField.inclusion hMC_M1 z)
    rw [hcomp, hValAlgK z] at h1
    have hq_cast : (q : ℤ) = (p : ℤ) * ((p ^ r : ℕ) : ℤ) := by
      rw [hq_eq, pow_succ']
      push_cast
      rfl
    rw [hq_cast, mul_assoc] at h1
    have hp_int_ne0 : (p : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hp_pos)
    exact mul_left_cancel₀ hp_int_ne0 h1.symm

  have hFrobSurjM1 : ∀ w : M_1, (w = 0 ∨ 0 ≤ valL F M_1 w) →
      ∃ s : M_1, (s = 0 ∨ 0 ≤ valL F M_1 s) ∧
        (w - s ^ p = 0 ∨ 1 ≤ valL F M_1 (w - s ^ p)) := by
    obtain ⟨S₁_M1, hS₁_M1⟩ := ld_valL_mod_one_finset F M_1 hval0_M1 hval_neg_M1 hval_mul_M1 hval_add_M1
      haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0_M1 halg1_M1 R_F hRF_0 hRF_mod1
    obtain ⟨k_M1, hField_kM1, hFin_kM1, resM1, hresM1_0, hresM1_1, hresM1_ring, hresM1_ker, hresM1_surj⟩ :=
      ld_valL_residue_field_exists F M_1 hval0_M1 hval1_M1 hval_neg1_M1 hval_neg_M1 hval_mul_M1
        hval_inv_M1 hval_add_M1 S₁_M1 hS₁_M1
    letI : Field k_M1 := hField_kM1
    letI : Fintype k_M1 := hFin_kM1
    intro w hw
    have h := hIterFrobSurj M_1 hp_prime hval1_M1 hval_neg_M1 hval_mul_M1
      hval_add_M1 halg1_M1 k_M1 resM1 hresM1_0 hresM1_1 hresM1_ring hresM1_ker hresM1_surj 1 w hw
    rwa [pow_one] at h

  
  refine ⟨M_1, hFinM1, hMC_M1, hM1_K, ϖ_M1,
    hGalMCM1, hAbMCM1, hGalM1K, hAbM1K, hfin_M1K, hfin_MCM1, hExpMCM1,
    hϖ_norm1, hϖ_norm2, hϖ_M1, hValNorm_M1K, hValAlg_M1K, hValNorm_MCM1, hValAlg_MCM1,
    hFrobSurjM1, hJump_M1K, ?_⟩
  intro hResLift_KM1 hnorm_le_KM1 b₀ hb₀_val hP_KM1 σ hσMC hσ_not_M1 hσw
  clear hIterFrobSurj helper_isGalois hSep_iff h_abs_finrank h_tower_finrank
    hnorm_trans_aux hnorm_eq_inclusion hrelVal_div hrelVal_norm_gen

  have hval_pow_K : ∀ (w : K) (n : ℕ), w ≠ 0 → valL F K (w ^ n) = (n : ℤ) * valL F K w := by
    intro w n hw
    induction n with
    | zero => simp [hval1_K]
    | succ n ih =>
      rw [pow_succ, hval_mul_K (w ^ n) w (pow_ne_zero n hw) hw, ih]
      push_cast
      ring

  have hval_sub_M1 : ∀ (k : ℤ) (x y : M_1),
      (x = 0 ∨ k ≤ valL F M_1 x) → (y = 0 ∨ k ≤ valL F M_1 y) →
        (x - y = 0 ∨ k ≤ valL F M_1 (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    have hny : -y = 0 ∨ k ≤ valL F M_1 (-y) := by
      rcases hy with rfl | hy
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hval_neg_M1]; exact hy)
    exact hval_add_M1 k x (-y) hx hny

  have hval_mul_ge_M1 : ∀ {k₁ k₂ : ℤ} {x y : M_1},
      (x = 0 ∨ k₁ ≤ valL F M_1 x) → (y = 0 ∨ k₂ ≤ valL F M_1 y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F M_1 (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hval_mul_M1 x y hx0 hy0]
        have h1 := hx.resolve_left hx0
        have h2 := hy.resolve_left hy0
        omega

  have hval_mul_ge_K : ∀ {k₁ k₂ : ℤ} {x y : K},
      (x = 0 ∨ k₁ ≤ valL F K x) → (y = 0 ∨ k₂ ≤ valL F K y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F K (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hval_mul_K x y hx0 hy0]
        have h1 := hx.resolve_left hx0
        have h2 := hy.resolve_left hy0
        omega

  have hval_finset_sum_M1 : ∀ {ι : Type u} [DecidableEq ι] (S : Finset ι) (f : ι → M_1) (k : ℤ),
      (∀ i ∈ S, f i = 0 ∨ k ≤ valL F M_1 (f i)) →
        ((∑ i ∈ S, f i) = 0 ∨ k ≤ valL F M_1 (∑ i ∈ S, f i)) := by
    intro ι _ S f k hS
    induction S using Finset.induction_on with
    | empty => left; simp
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact hval_add_M1 k (f a) (∑ i ∈ s, f i)
        (hS a (Finset.mem_insert_self a s))
        (ih (fun i hi => hS i (Finset.mem_insert_of_mem hi)))

  have hval_strict_M1 : ∀ (y₁ y₂ : M_1),
      y₁ ≠ 0 → (y₂ = 0 ∨ valL F M_1 y₁ + 1 ≤ valL F M_1 y₂) →
        y₁ + y₂ ≠ 0 ∧ valL F M_1 (y₁ + y₂) = valL F M_1 y₁ := by
    intro y₁ y₂ hy₁ hy₂
    set v₁ : ℤ := valL F M_1 y₁
    have hy₂_ge : y₂ = 0 ∨ v₁ ≤ valL F M_1 y₂ := by
      rcases hy₂ with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum_ge : y₁ + y₂ = 0 ∨ v₁ ≤ valL F M_1 (y₁ + y₂) :=
      hval_add_M1 v₁ y₁ y₂ (Or.inr le_rfl) hy₂_ge
    have hnot_gt : ¬ (y₁ + y₂ = 0 ∨ v₁ + 1 ≤ valL F M_1 (y₁ + y₂)) := by
      intro hgt
      have hneg_y₂ : -y₂ = 0 ∨ v₁ + 1 ≤ valL F M_1 (-y₂) := by
        rcases hy₂ with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right; rw [hval_neg_M1]; exact hge
      have hy₁_gt := hval_add_M1 (v₁ + 1) (y₁ + y₂) (-y₂) hgt hneg_y₂
      have heq_y₁ : (y₁ + y₂) + (-y₂) = y₁ := by ring
      rw [heq_y₁] at hy₁_gt
      rcases hy₁_gt with h10 | h1ge
      · exact hy₁ h10
      · omega
    have hsum_ne : y₁ + y₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
    have hsum_v₁ : v₁ ≤ valL F M_1 (y₁ + y₂) := hsum_ge.resolve_left hsum_ne
    have hsum_not1 : ¬ (v₁ + 1 ≤ valL F M_1 (y₁ + y₂)) := fun h1 => hnot_gt (Or.inr h1)
    exact ⟨hsum_ne, by omega⟩

  have hval_strict_K : ∀ (y₁ y₂ : K),
      y₁ ≠ 0 → (y₂ = 0 ∨ valL F K y₁ + 1 ≤ valL F K y₂) →
        y₁ + y₂ ≠ 0 ∧ valL F K (y₁ + y₂) = valL F K y₁ := by
    intro y₁ y₂ hy₁ hy₂
    set v₁ : ℤ := valL F K y₁
    have hy₂_ge : y₂ = 0 ∨ v₁ ≤ valL F K y₂ := by
      rcases hy₂ with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum_ge : y₁ + y₂ = 0 ∨ v₁ ≤ valL F K (y₁ + y₂) :=
      hval_add_K v₁ y₁ y₂ (Or.inr le_rfl) hy₂_ge
    have hnot_gt : ¬ (y₁ + y₂ = 0 ∨ v₁ + 1 ≤ valL F K (y₁ + y₂)) := by
      intro hgt
      have hneg_y₂ : -y₂ = 0 ∨ v₁ + 1 ≤ valL F K (-y₂) := by
        rcases hy₂ with h0 | hge
        · exact Or.inl (neg_eq_zero.mpr h0)
        · right; rw [hval_neg_K]; exact hge
      have hy₁_gt := hval_add_K (v₁ + 1) (y₁ + y₂) (-y₂) hgt hneg_y₂
      have heq_y₁ : (y₁ + y₂) + (-y₂) = y₁ := by ring
      rw [heq_y₁] at hy₁_gt
      rcases hy₁_gt with h10 | h1ge
      · exact hy₁ h10
      · omega
    have hsum_ne : y₁ + y₂ ≠ 0 := fun h0 => hnot_gt (Or.inl h0)
    have hsum_v₁ : v₁ ≤ valL F K (y₁ + y₂) := hsum_ge.resolve_left hsum_ne
    have hsum_not1 : ¬ (v₁ + 1 ≤ valL F K (y₁ + y₂)) := fun h1 => hnot_gt (Or.inr h1)
    exact ⟨hsum_ne, by omega⟩

  have hinj_M1K : Function.Injective (IntermediateField.inclusion hM1_K) :=
    (IntermediateField.inclusion hM1_K).injective

  have hnorm_act_C1 : ∀ (τ : C_1) (w : K),
      normLM F hM1_K (act τ.1 w) = normLM F hM1_K w := by
    intro τ w
    apply hinj_M1K
    rw [hact_norm_M1K (act τ.1 w), hact_norm_M1K w]
    have hmul : (∏ η : C_1, act η.1 (act τ.1 w)) = ∏ η : C_1, act (η * τ).1 w := by
      refine Finset.prod_congr rfl fun η _ => ?_
      rw [Subgroup.coe_mul, hact_mul]
    rw [hmul]
    exact Equiv.prod_comp (Equiv.mulRight τ) (fun η : C_1 => act η.1 w)

  obtain ⟨γ_σ, hγ_σ_not_C1, hγ_σ_apply⟩ := hLift_not_M1 σ hσMC hσ_not_M1
  let φ_act : C → (K →+* K) := fun γ =>
    { toFun := act γ
      map_one' := (hact_ring γ).2.1
      map_mul' := fun x y => ((hact_ring γ).2.2 x y).2.1
      map_zero' := (hact_ring γ).1
      map_add' := fun x y => ((hact_ring γ).2.2 x y).1 }

  have hnorm_act_γσ : normLM F hM1_K (act γ_σ (ϖ_K : K)) =
      (⟨(σ : AbsGal F) (ϖ_M1 : AlgebraicClosure F), hσw⟩ : M_1) := by
    have hincl : IntermediateField.inclusion hM1_K (normLM F hM1_K (act γ_σ (ϖ_K : K))) =
        act γ_σ (IntermediateField.inclusion hM1_K (ϖ_M1 : M_1)) := by
      rw [hact_norm_M1K (act γ_σ (ϖ_K : K))]
      have hcomm : (∏ τ : C_1, act τ.1 (act γ_σ (ϖ_K : K))) =
          ∏ τ : C_1, act γ_σ (act τ.1 (ϖ_K : K)) := by
        refine Finset.prod_congr rfl fun τ _ => ?_
        rw [← hact_mul, hC_ab τ.1 γ_σ, hact_mul]
      rw [hcomm]
      have hmap : (∏ τ : C_1, act γ_σ (act τ.1 (ϖ_K : K))) =
          act γ_σ (∏ τ : C_1, act τ.1 (ϖ_K : K)) :=
        (map_prod (φ_act γ_σ) (fun τ : C_1 => act τ.1 (ϖ_K : K)) Finset.univ).symm
      rw [hmap, ← hact_norm_M1K (ϖ_K : K)]
      rfl
    apply Subtype.ext
    have h1 := congrArg (fun x : K => (x : AlgebraicClosure F)) hincl
    change (normLM F hM1_K (act γ_σ (ϖ_K : K)) : AlgebraicClosure F) =
      ((act γ_σ (IntermediateField.inclusion hM1_K (ϖ_M1 : M_1)) : K) : AlgebraicClosure F) at h1
    rw [h1, hγ_σ_apply (IntermediateField.inclusion hM1_K (ϖ_M1 : M_1))]
    rfl

  have hdiff_K : ∀ γ₁ γ₂ : C, γ₁ ≠ γ₂ →
      act γ₁ (ϖ_K : K) - act γ₂ (ϖ_K : K) ≠ 0 ∧
      valL F K (act γ₁ (ϖ_K : K) - act γ₂ (ϖ_K : K)) = (t + 1 : ℤ) := by
    intro γ₁ γ₂ hne
    have h_inv_ne1 : γ₁⁻¹ * γ₂ ≠ 1 := fun h1 => hne (inv_mul_eq_one.mp h1)
    obtain ⟨hj_ne0, hj_val⟩ := hjump_C (γ₁⁻¹ * γ₂) h_inv_ne1
    have h_eq : act γ₁ (ϖ_K : K) - act γ₂ (ϖ_K : K) =
        act γ₁ ((ϖ_K : K) - act (γ₁⁻¹ * γ₂) (ϖ_K : K)) := by
      change _ = φ_act γ₁ ((ϖ_K : K) - act (γ₁⁻¹ * γ₂) (ϖ_K : K))
      rw [map_sub]
      change _ = act γ₁ (ϖ_K : K) - act γ₁ (act (γ₁⁻¹ * γ₂) (ϖ_K : K))
      rw [← hact_mul, mul_inv_cancel_left]
    rw [h_eq, hact_val γ₁, hj_val]
    refine ⟨?_, rfl⟩
    intro hact0
    have horig0 : (ϖ_K : K) - act (γ₁⁻¹ * γ₂) (ϖ_K : K) = 0 := by
      calc (ϖ_K : K) - act (γ₁⁻¹ * γ₂) (ϖ_K : K)
        _ = act (γ₁⁻¹ * γ₁) ((ϖ_K : K) - act (γ₁⁻¹ * γ₂) (ϖ_K : K)) := by
          rw [inv_mul_cancel, hact_one]
        _ = act γ₁⁻¹ (act γ₁ ((ϖ_K : K) - act (γ₁⁻¹ * γ₂) (ϖ_K : K))) := hact_mul _ _ _
        _ = 0 := by rw [hact0, (hact_ring γ₁⁻¹).1]
    exact hj_ne0 horig0

  have hact_ϖ_ne0 : ∀ γ : C, act γ (ϖ_K : K) ≠ 0 := by
    intro γ h0
    have hv : valL F K (act γ (ϖ_K : K)) = 1 := (hact_val γ (ϖ_K : K)).trans hϖ_K
    rw [h0, hval0_K] at hv
    omega

  let w_γ (γ : C) : Kˣ := Units.mk0 (act γ (ϖ_K : K)) (hact_ϖ_ne0 γ) * ϖ_K⁻¹
  let y_γ (γ : C) : K := ((w_γ γ : K) - 1) * (((ϖ_K ^ t)⁻¹ : Kˣ) : K)

  have hϖK_pow_val : ∀ k : ℕ, valL F K ((ϖ_K ^ k : Kˣ) : K) = (k : ℤ) := by
    intro k
    rw [Units.val_pow_eq_pow_val, hval_pow_K (ϖ_K : K) k (Units.ne_zero ϖ_K), hϖ_K, mul_one]
  have hϖM1_pow_val : ∀ k : ℕ, valL F M_1 ((ϖ_M1 ^ k : M_1ˣ) : M_1) = (k : ℤ) := by
    intro k
    rw [Units.val_pow_eq_pow_val, hval_pow_M1 (ϖ_M1 : M_1) k (Units.ne_zero ϖ_M1), hϖ_M1, mul_one]

  have hy_diff_eq : ∀ γ₁ γ₂ : C,
      (y_γ γ₁ - y_γ γ₂) * (((ϖ_K ^ t : Kˣ) : K) * (ϖ_K : K)) =
        act γ₁ (ϖ_K : K) - act γ₂ (ϖ_K : K) := by
    intro γ₁ γ₂
    dsimp [y_γ, w_γ]
    have h1 : (((ϖ_K ^ t)⁻¹ : Kˣ) : K) * ((ϖ_K ^ t : Kˣ) : K) = 1 := Units.inv_mul (ϖ_K ^ t)
    have h2 : ((ϖ_K⁻¹ : Kˣ) : K) * (ϖ_K : K) = 1 := Units.inv_mul ϖ_K
    calc ((((act γ₁ (ϖ_K : K) * ((ϖ_K⁻¹ : Kˣ) : K) - 1) * (((ϖ_K ^ t)⁻¹ : Kˣ) : K)) -
            ((act γ₂ (ϖ_K : K) * ((ϖ_K⁻¹ : Kˣ) : K) - 1) * (((ϖ_K ^ t)⁻¹ : Kˣ) : K))) *
            (((ϖ_K ^ t : Kˣ) : K) * (ϖ_K : K)))
      _ = (act γ₁ (ϖ_K : K) - act γ₂ (ϖ_K : K)) *
            (((ϖ_K⁻¹ : Kˣ) : K) * (ϖ_K : K)) *
            ((((ϖ_K ^ t)⁻¹ : Kˣ) : K) * ((ϖ_K ^ t : Kˣ) : K)) := by ring
      _ = act γ₁ (ϖ_K : K) - act γ₂ (ϖ_K : K) := by rw [h1, h2, mul_one, mul_one]

  have hy_diff_val0 : ∀ γ₁ γ₂ : C, γ₁ ≠ γ₂ →
      y_γ γ₁ - y_γ γ₂ ≠ 0 ∧ valL F K (y_γ γ₁ - y_γ γ₂) = 0 := by
    intro γ₁ γ₂ hne
    obtain ⟨hd_ne0, hd_val⟩ := hdiff_K γ₁ γ₂ hne
    set π_t1 : K := ((ϖ_K ^ t : Kˣ) : K) * (ϖ_K : K)
    have hπ_t1_ne0 : π_t1 ≠ 0 := mul_ne_zero (Units.ne_zero _) (Units.ne_zero _)
    have hπ_t1_val : valL F K π_t1 = (t + 1 : ℤ) := by
      change valL F K (((ϖ_K ^ t : Kˣ) : K) * (ϖ_K : K)) = (t + 1 : ℤ)
      rw [hval_mul_K _ _ (Units.ne_zero _) (Units.ne_zero _), hϖK_pow_val t, hϖ_K]
    have hy_ne0 : y_γ γ₁ - y_γ γ₂ ≠ 0 := by
      intro h0
      have hmul0 : (y_γ γ₁ - y_γ γ₂) * π_t1 = 0 := by rw [h0, zero_mul]
      rw [hy_diff_eq] at hmul0
      exact hd_ne0 hmul0
    have hval_eq : valL F K ((y_γ γ₁ - y_γ γ₂) * π_t1) = (t + 1 : ℤ) := by
      rw [hy_diff_eq, hd_val]
    rw [hval_mul_K (y_γ γ₁ - y_γ γ₂) π_t1 hy_ne0 hπ_t1_ne0, hπ_t1_val] at hval_eq
    exact ⟨hy_ne0, by omega⟩

  have hy_1 : y_γ 1 = 0 := by
    dsimp [y_γ, w_γ]
    change (act 1 (ϖ_K : K) * ((ϖ_K⁻¹ : Kˣ) : K) - 1) * (((ϖ_K ^ t)⁻¹ : Kˣ) : K) = 0
    rw [hact_one, Units.mul_inv, sub_self, zero_mul]

  have hy_int : ∀ γ : C, y_γ γ = 0 ∨ 0 ≤ valL F K (y_γ γ) := by
    intro γ
    by_cases hγ1 : γ = 1
    · subst hγ1
      exact Or.inl hy_1
    · right
      have hsub : y_γ γ = y_γ γ - y_γ 1 := by rw [hy_1, sub_zero]
      rw [hsub, (hy_diff_val0 γ 1 hγ1).2]

  let z (γ : C) : M_1 := (hResLift_KM1 (y_γ γ) (hy_int γ)).choose
  have hz_int : ∀ γ : C, z γ = 0 ∨ 0 ≤ valL F M_1 (z γ) :=
    fun γ => (hResLift_KM1 (y_γ γ) (hy_int γ)).choose_spec.1
  have hz_lift : ∀ γ : C,
      y_γ γ - IntermediateField.inclusion hM1_K (z γ) = 0 ∨
      1 ≤ valL F K (y_γ γ - IntermediateField.inclusion hM1_K (z γ)) :=
    fun γ => (hResLift_KM1 (y_γ γ) (hy_int γ)).choose_spec.2

  have hz_diff_val0 : ∀ γ₁ γ₂ : C, γ₁ ≠ γ₂ →
      z γ₁ - z γ₂ ≠ 0 ∧ valL F M_1 (z γ₁ - z γ₂) = 0 := by
    intro γ₁ γ₂ hne
    set r₁ : K := y_γ γ₁ - IntermediateField.inclusion hM1_K (z γ₁)
    set r₂ : K := y_γ γ₂ - IntermediateField.inclusion hM1_K (z γ₂)
    have hr₁ : r₁ = 0 ∨ 1 ≤ valL F K r₁ := hz_lift γ₁
    have hnr₁ : -r₁ = 0 ∨ 1 ≤ valL F K (-r₁) := by
      rcases hr₁ with h0 | hge
      · exact Or.inl (neg_eq_zero.mpr h0)
      · right; rw [hval_neg_K]; exact hge
    have hr₂ : r₂ = 0 ∨ 1 ≤ valL F K r₂ := hz_lift γ₂
    have hr_diff : -r₁ + r₂ = 0 ∨ 1 ≤ valL F K (-r₁ + r₂) := hval_add_K 1 (-r₁) r₂ hnr₁ hr₂
    obtain ⟨hy_ne0, hy_val0⟩ := hy_diff_val0 γ₁ γ₂ hne
    have h_decomp : IntermediateField.inclusion hM1_K (z γ₁ - z γ₂) =
        (y_γ γ₁ - y_γ γ₂) + (-r₁ + r₂) := by
      rw [map_sub]
      dsimp [r₁, r₂]
      ring
    have hr_diff' : -r₁ + r₂ = 0 ∨ valL F K (y_γ γ₁ - y_γ γ₂) + 1 ≤ valL F K (-r₁ + r₂) := by
      rw [hy_val0, zero_add]
      exact hr_diff
    obtain ⟨hinc_ne0, hinc_val0⟩ := hval_strict_K (y_γ γ₁ - y_γ γ₂) (-r₁ + r₂) hy_ne0 hr_diff'
    rw [← h_decomp] at hinc_ne0 hinc_val0
    rw [hy_val0] at hinc_val0
    have hz_ne0 : z γ₁ - z γ₂ ≠ 0 := fun h0 => hinc_ne0 (by rw [h0, map_zero])
    rw [hValAlg_M1K (z γ₁ - z γ₂)] at hinc_val0
    have hp_int_ne0 : (p : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr (ne_of_gt hp_pos)
    exact ⟨hz_ne0, (mul_eq_zero.mp hinc_val0).resolve_left hp_int_ne0⟩

  have h_norm_approx : ∀ γ : C,
      normLM F hM1_K (w_γ γ : K) -
        (1 + ((z γ) ^ p + b₀ * (z γ)) * ((ϖ_M1 ^ t : M_1ˣ) : M_1)) = 0 ∨
      (t + 1 : ℤ) ≤ valL F M_1
        (normLM F hM1_K (w_γ γ : K) -
          (1 + ((z γ) ^ p + b₀ * (z γ)) * ((ϖ_M1 ^ t : M_1ˣ) : M_1))) := by
    intro γ
    set w_tilde₀ : K := 1 + IntermediateField.inclusion hM1_K (z γ) * ((ϖ_K ^ t : Kˣ) : K)
    have hinc_z_int : IntermediateField.inclusion hM1_K (z γ) = 0 ∨
        0 ≤ valL F K (IntermediateField.inclusion hM1_K (z γ)) := by
      rcases hz_int γ with h0 | hge
      · exact Or.inl (by rw [h0, map_zero])
      · right; rw [hValAlg_M1K]; positivity
    have hterm_ge1 : IntermediateField.inclusion hM1_K (z γ) * ((ϖ_K ^ t : Kˣ) : K) = 0 ∨
        valL F K (1 : K) + 1 ≤
          valL F K (IntermediateField.inclusion hM1_K (z γ) * ((ϖ_K ^ t : Kˣ) : K)) := by
      rw [hval1_K, zero_add]
      have ht_term := hval_mul_ge_K hinc_z_int (Or.inr (le_of_eq (hϖK_pow_val t).symm))
      rcases ht_term with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    obtain ⟨hw_tilde_ne0, hw_tilde_val0⟩ := hval_strict_K 1
      (IntermediateField.inclusion hM1_K (z γ) * ((ϖ_K ^ t : Kˣ) : K)) one_ne_zero hterm_ge1
    change w_tilde₀ ≠ 0 at hw_tilde_ne0
    change valL F K w_tilde₀ = valL F K 1 at hw_tilde_val0
    rw [hval1_K] at hw_tilde_val0
    let w_tilde : Kˣ := Units.mk0 w_tilde₀ hw_tilde_ne0
    have hw_tilde_inv_val0 : valL F K ((w_tilde⁻¹ : Kˣ) : K) = 0 := by
      rw [hval_inv_K w_tilde, Units.val_mk0, hw_tilde_val0, neg_zero]
    have hdiff_w : (w_γ γ : K) - w_tilde₀ =
        (y_γ γ - IntermediateField.inclusion hM1_K (z γ)) * ((ϖ_K ^ t : Kˣ) : K) := by
      have h1 : (((ϖ_K ^ t)⁻¹ : Kˣ) : K) * ((ϖ_K ^ t : Kˣ) : K) = 1 := Units.inv_mul (ϖ_K ^ t)
      symm
      calc (((w_γ γ : K) - 1) * (((ϖ_K ^ t)⁻¹ : Kˣ) : K) -
              IntermediateField.inclusion hM1_K (z γ)) * ((ϖ_K ^ t : Kˣ) : K)
        _ = ((w_γ γ : K) - 1) * ((((ϖ_K ^ t)⁻¹ : Kˣ) : K) * ((ϖ_K ^ t : Kˣ) : K)) -
              IntermediateField.inclusion hM1_K (z γ) * ((ϖ_K ^ t : Kˣ) : K) := by ring
        _ = ((w_γ γ : K) - 1) * 1 -
              IntermediateField.inclusion hM1_K (z γ) * ((ϖ_K ^ t : Kˣ) : K) := by rw [h1]
        _ = (w_γ γ : K) - (1 + IntermediateField.inclusion hM1_K (z γ) * ((ϖ_K ^ t : Kˣ) : K)) := by
          ring
    have hdiff_w_val : (w_γ γ : K) - w_tilde₀ = 0 ∨ (t + 1 : ℤ) ≤ valL F K ((w_γ γ : K) - w_tilde₀) := by
      rw [hdiff_w]
      have h1 := hval_mul_ge_K (hz_lift γ) (Or.inr (le_of_eq (hϖK_pow_val t).symm))
      rcases h1 with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    let u_γ : Kˣ := w_γ γ * w_tilde⁻¹
    have hu_γ_sub1 : ((u_γ : Kˣ) : K) - 1 = ((w_γ γ : K) - w_tilde₀) * ((w_tilde⁻¹ : Kˣ) : K) := by
      change (w_γ γ : K) * ((w_tilde⁻¹ : Kˣ) : K) - 1 = _
      have h1 : w_tilde₀ * ((w_tilde⁻¹ : Kˣ) : K) = 1 := Units.mul_inv w_tilde
      calc (w_γ γ : K) * ((w_tilde⁻¹ : Kˣ) : K) - 1
        _ = (w_γ γ : K) * ((w_tilde⁻¹ : Kˣ) : K) - w_tilde₀ * ((w_tilde⁻¹ : Kˣ) : K) := by rw [h1]
        _ = ((w_γ γ : K) - w_tilde₀) * ((w_tilde⁻¹ : Kˣ) : K) := by ring
    have hu_γ_mem : u_γ ∈ unitGroup F K (t + 1) := by
      rw [hunit_K (t + 1) (by omega) u_γ]
      have h1 : ((u_γ : Kˣ) : K) - 1 = 0 ∨ ((t + 1 : ℕ) : ℤ) ≤ valL F K (((u_γ : Kˣ) : K) - 1) := by
        rw [hu_γ_sub1]
        have h2 := hval_mul_ge_K hdiff_w_val (Or.inr (le_of_eq hw_tilde_inv_val0.symm))
        rcases h2 with h0 | hge
        · exact Or.inl h0
        · exact Or.inr (by omega)
      rcases h1 with h0 | hge
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr hge
    have hnorm_u_mem : Units.map (normLM F hM1_K) u_γ ∈ unitGroup F M_1 (t + 1) :=
      hnorm_le_KM1 u_γ hu_γ_mem
    have hnorm_u_val : (((Units.map (normLM F hM1_K) u_γ : M_1ˣ) : M_1) - 1 = 0) ∨
        (t + 1 : ℤ) ≤ valL F M_1 (((Units.map (normLM F hM1_K) u_γ : M_1ˣ) : M_1) - 1) := by
      rcases (hunit_M1 (t + 1) (by omega) (Units.map (normLM F hM1_K) u_γ)).mp hnorm_u_mem with h1 | hge
      · exact Or.inl (sub_eq_zero.mpr h1)
      · exact Or.inr (by simpa using hge)
    have hnorm_w_tilde_val0 : valL F M_1 (normLM F hM1_K w_tilde₀) = 0 :=
      (hValNorm_M1K w_tilde₀).trans hw_tilde_val0
    have hnorm_diff1_eq : normLM F hM1_K (w_γ γ : K) - normLM F hM1_K w_tilde₀ =
        (((Units.map (normLM F hM1_K) u_γ : M_1ˣ) : M_1) - 1) * normLM F hM1_K w_tilde₀ := by
      have h1 : ((Units.map (normLM F hM1_K) u_γ : M_1ˣ) : M_1) * normLM F hM1_K w_tilde₀ =
          normLM F hM1_K (w_γ γ : K) := by
        change normLM F hM1_K ((w_γ γ : K) * ((w_tilde⁻¹ : Kˣ) : K)) * normLM F hM1_K w_tilde₀ = _
        rw [← map_mul, mul_assoc]
        have hinv : ((w_tilde⁻¹ : Kˣ) : K) * w_tilde₀ = 1 := Units.inv_mul w_tilde
        rw [hinv, mul_one]
      calc normLM F hM1_K (w_γ γ : K) - normLM F hM1_K w_tilde₀
        _ = ((Units.map (normLM F hM1_K) u_γ : M_1ˣ) : M_1) * normLM F hM1_K w_tilde₀ -
              1 * normLM F hM1_K w_tilde₀ := by rw [h1, one_mul]
        _ = (((Units.map (normLM F hM1_K) u_γ : M_1ˣ) : M_1) - 1) * normLM F hM1_K w_tilde₀ := by
          ring
    have hnorm_diff1 : normLM F hM1_K (w_γ γ : K) - normLM F hM1_K w_tilde₀ = 0 ∨
        (t + 1 : ℤ) ≤ valL F M_1 (normLM F hM1_K (w_γ γ : K) - normLM F hM1_K w_tilde₀) := by
      rw [hnorm_diff1_eq]
      have h2 := hval_mul_ge_M1 hnorm_u_val (Or.inr (le_of_eq hnorm_w_tilde_val0.symm))
      rcases h2 with h0 | hge
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hnorm_diff2 := hP_KM1 (z γ) (hz_int γ)
    have hsum := hval_add_M1 (t + 1 : ℤ)
      (normLM F hM1_K (w_γ γ : K) - normLM F hM1_K w_tilde₀)
      (normLM F hM1_K w_tilde₀ - (1 + ((z γ) ^ p + b₀ * (z γ)) * ((ϖ_M1 ^ t : M_1ˣ) : M_1)))
      hnorm_diff1 hnorm_diff2
    have hcancel : (normLM F hM1_K (w_γ γ : K) - normLM F hM1_K w_tilde₀) +
        (normLM F hM1_K w_tilde₀ - (1 + ((z γ) ^ p + b₀ * (z γ)) * ((ϖ_M1 ^ t : M_1ˣ) : M_1))) =
        normLM F hM1_K (w_γ γ : K) -
          (1 + ((z γ) ^ p + b₀ * (z γ)) * ((ϖ_M1 ^ t : M_1ˣ) : M_1)) := by ring
    rwa [hcancel] at hsum

  have h_root_C1 : ∀ τ : C_1,
      (z τ.1) ^ p + b₀ * (z τ.1) = 0 ∨ 1 ≤ valL F M_1 ((z τ.1) ^ p + b₀ * (z τ.1)) := by
    intro τ
    have hnorm1 : normLM F hM1_K (w_γ τ.1 : K) = 1 := by
      change normLM F hM1_K (act τ.1 (ϖ_K : K) * ((ϖ_K⁻¹ : Kˣ) : K)) = 1
      rw [map_mul, hnorm_act_C1 τ (ϖ_K : K)]
      exact Units.mul_inv ϖ_M1
    have happrox := h_norm_approx τ.1
    rw [hnorm1] at happrox
    have hneg_eq : (1 : M_1) - (1 + ((z τ.1) ^ p + b₀ * (z τ.1)) * ((ϖ_M1 ^ t : M_1ˣ) : M_1)) =
        - (((z τ.1) ^ p + b₀ * (z τ.1)) * ((ϖ_M1 ^ t : M_1ˣ) : M_1)) := by ring
    rw [hneg_eq] at happrox
    have hprod_ge : ((z τ.1) ^ p + b₀ * (z τ.1)) * ((ϖ_M1 ^ t : M_1ˣ) : M_1) = 0 ∨
        (t + 1 : ℤ) ≤ valL F M_1 (((z τ.1) ^ p + b₀ * (z τ.1)) * ((ϖ_M1 ^ t : M_1ˣ) : M_1)) := by
      rcases happrox with h0 | hge
      · exact Or.inl (neg_eq_zero.mp h0)
      · right; rwa [hval_neg_M1] at hge
    have hinv_val : valL F M_1 (((ϖ_M1 ^ t)⁻¹ : M_1ˣ) : M_1) = - (t : ℤ) := by
      rw [hval_inv_M1 (ϖ_M1 ^ t), hϖM1_pow_val t]
    have hmul_inv := hval_mul_ge_M1 hprod_ge (Or.inr (le_of_eq hinv_val.symm))
    have hcancel : (((z τ.1) ^ p + b₀ * (z τ.1)) * ((ϖ_M1 ^ t : M_1ˣ) : M_1)) *
        (((ϖ_M1 ^ t)⁻¹ : M_1ˣ) : M_1) = (z τ.1) ^ p + b₀ * (z τ.1) := by
      rw [mul_assoc, Units.mul_inv (ϖ_M1 ^ t), mul_one]
    rw [hcancel] at hmul_inv
    rcases hmul_inv with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (by omega)

  
  let U_C1 : Finset C_1 := Finset.univ
  have hUC1_card : U_C1.card = p := Finset.card_univ.trans hcard_C1
  let v : C_1 → M_1 := fun τ => z τ.1
  have hInjOn : Set.InjOn v ↑U_C1 := by
    intro τ₁ _ τ₂ _ h_eq
    change z τ₁.1 = z τ₂.1 at h_eq
    by_contra hne
    have hne_val : τ₁.1 ≠ τ₂.1 := fun h => hne (Subtype.ext h)
    exact (hz_diff_val0 τ₁.1 τ₂.1 hne_val).1 (sub_eq_zero.mpr h_eq)

  let Q_prod : Polynomial M_1 := ∏ τ ∈ U_C1, (Polynomial.X - Polynomial.C (v τ))
  let f_poly : Polynomial M_1 := (Polynomial.X ^ p - Q_prod) + Polynomial.C b₀ * Polynomial.X

  have hmonic_fac : ∀ τ ∈ U_C1, (Polynomial.X - Polynomial.C (v τ)).Monic :=
    fun τ _ => Polynomial.monic_X_sub_C (v τ)
  have hmonic_Xp : (Polynomial.X ^ p : Polynomial M_1).Monic := Polynomial.monic_X_pow p
  have hmonic_Q : Q_prod.Monic := Polynomial.monic_prod_of_monic U_C1 _ hmonic_fac
  have hnat_Xp : (Polynomial.X ^ p : Polynomial M_1).natDegree = p := Polynomial.natDegree_X_pow p
  have hnat_Q : Q_prod.natDegree = p := by
    dsimp [Q_prod]
    rw [Polynomial.natDegree_prod_of_monic U_C1 _ hmonic_fac]
    have hsum1 : (∑ τ ∈ U_C1, (Polynomial.X - Polynomial.C (v τ)).natDegree) = ∑ _τ ∈ U_C1, 1 :=
      Finset.sum_congr rfl (fun τ _ => Polynomial.natDegree_X_sub_C (v τ))
    rw [hsum1, Finset.sum_const, smul_eq_mul, mul_one, hUC1_card]
  have hdeg_Xp : (Polynomial.X ^ p : Polynomial M_1).degree = (p : WithBot ℕ) :=
    (Polynomial.degree_eq_natDegree hmonic_Xp.ne_zero).trans (congrArg WithBot.some hnat_Xp)
  have hdeg_Q : Q_prod.degree = (p : WithBot ℕ) :=
    (Polynomial.degree_eq_natDegree hmonic_Q.ne_zero).trans (congrArg WithBot.some hnat_Q)
  have hdeg_sub_lt : (Polynomial.X ^ p - Q_prod).degree < (p : WithBot ℕ) := by
    rw [← hdeg_Xp]
    exact Polynomial.degree_sub_lt (hdeg_Xp.trans hdeg_Q.symm) hmonic_Xp.ne_zero
      (hmonic_Xp.leadingCoeff.trans hmonic_Q.leadingCoeff.symm)
  have hdeg_lin_lt : (Polynomial.C b₀ * Polynomial.X).degree < (p : WithBot ℕ) :=
    lt_of_le_of_lt (Polynomial.degree_C_mul_X_le b₀) (WithBot.coe_lt_coe.mpr hp_gt1)
  have hdeg_f : f_poly.degree < (U_C1.card : WithBot ℕ) := by
    rw [hUC1_card]
    exact lt_of_le_of_lt (Polynomial.degree_add_le _ _) (max_lt hdeg_sub_lt hdeg_lin_lt)

  have hLag := @Lagrange.eq_interpolate M_1 _ C_1 _ U_C1 v f_poly hInjOn hdeg_f
  rw [Lagrange.interpolate_eq_sum] at hLag
  have heval_Lag := congrArg (Polynomial.eval (z γ_σ)) hLag
  dsimp only [f_poly] at heval_Lag
  rw [Polynomial.eval_add, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
    Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X,
    Polynomial.eval_finset_sum] at heval_Lag

  have heval_Q_at : ∀ x : M_1, Polynomial.eval x Q_prod = ∏ τ ∈ U_C1, (x - v τ) := by
    intro x
    dsimp [Q_prod]
    rw [Polynomial.eval_prod]
    refine Finset.prod_congr rfl fun τ _ => ?_
    rw [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]

  have heval_f_node : ∀ τ : C_1,
      Polynomial.eval (v τ) f_poly = (v τ) ^ p + b₀ * (v τ) := by
    intro τ
    dsimp [f_poly]
    rw [Polynomial.eval_add, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X, heval_Q_at (v τ)]
    have hprod0 : (∏ η ∈ U_C1, (v τ - v η)) = 0 := by
      rw [← Finset.mul_prod_erase U_C1 (fun η : C_1 => v τ - v η) (Finset.mem_univ τ),
        sub_self, zero_mul]
    rw [hprod0, sub_zero]

  have hprod_unit_val0 : ∀ (S : Finset C_1) (g : C_1 → M_1),
      (∀ η ∈ S, g η ≠ 0 ∧ valL F M_1 (g η) = 0) →
        (∏ η ∈ S, g η) ≠ 0 ∧ valL F M_1 (∏ η ∈ S, g η) = 0 := by
    intro S g
    induction S using Finset.induction_on with
    | empty =>
      intro _
      simp [hval1_M1]
    | @insert a s ha ih =>
      intro hS
      obtain ⟨ha_ne0, ha_val0⟩ := hS a (Finset.mem_insert_self a s)
      obtain ⟨hs_ne0, hs_val0⟩ := ih (fun η hη => hS η (Finset.mem_insert_of_mem hη))
      rw [Finset.prod_insert ha]
      refine ⟨mul_ne_zero ha_ne0 hs_ne0, ?_⟩
      rw [hval_mul_M1 _ _ ha_ne0 hs_ne0, ha_val0, hs_val0, add_zero]

  have h_out_factors : ∀ η ∈ U_C1,
      z γ_σ - v η ≠ 0 ∧ valL F M_1 (z γ_σ - v η) = 0 := by
    intro η _
    have hne : γ_σ ≠ η.1 := fun h => hγ_σ_not_C1 (h ▸ η.2)
    exact hz_diff_val0 γ_σ η.1 hne

  obtain ⟨hP_out_ne0, hP_out_val0⟩ := hprod_unit_val0 U_C1 (fun η => z γ_σ - v η) h_out_factors

  let term_Lag (τ : C_1) : M_1 :=
    Polynomial.eval (z γ_σ)
      (Polynomial.C (Polynomial.eval (v τ) f_poly / ∏ η ∈ U_C1.erase τ, (v τ - v η)) *
        ∏ η ∈ U_C1.erase τ, (Polynomial.X - Polynomial.C (v η)))

  have hterm_Lag_ge1 : ∀ τ ∈ U_C1, term_Lag τ = 0 ∨ 1 ≤ valL F M_1 (term_Lag τ) := by
    intro τ _
    dsimp [term_Lag]
    rw [Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_prod]
    have hnum_eval : (∏ η ∈ U_C1.erase τ,
        Polynomial.eval (z γ_σ) (Polynomial.X - Polynomial.C (v η))) =
        ∏ η ∈ U_C1.erase τ, (z γ_σ - v η) := by
      refine Finset.prod_congr rfl fun η _ => ?_
      rw [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
    rw [hnum_eval, heval_f_node τ, div_eq_mul_inv]
    obtain ⟨hden_ne0, hden_val0⟩ := hprod_unit_val0 (U_C1.erase τ) (fun η => v τ - v η) (by
      intro η hη
      have hne_sub : η ≠ τ := (Finset.mem_erase.mp hη).1
      have hne_val : τ.1 ≠ η.1 := fun h => hne_sub (Subtype.ext h.symm)
      exact hz_diff_val0 τ.1 η.1 hne_val)
    let u_den : M_1ˣ := Units.mk0 (∏ η ∈ U_C1.erase τ, (v τ - v η)) hden_ne0
    have hden_inv_val0 : valL F M_1 (∏ η ∈ U_C1.erase τ, (v τ - v η))⁻¹ = 0 := by
      have h1 : (∏ η ∈ U_C1.erase τ, (v τ - v η))⁻¹ = ((u_den⁻¹ : M_1ˣ) : M_1) := rfl
      rw [h1, hval_inv_M1 u_den, Units.val_mk0, hden_val0, neg_zero]
    obtain ⟨_, hnum_val0⟩ := hprod_unit_val0 (U_C1.erase τ) (fun η => z γ_σ - v η)
      (fun η hη => h_out_factors η (Finset.mem_univ η))
    have h_root_v : (v τ) ^ p + b₀ * (v τ) = 0 ∨ 1 ≤ valL F M_1 ((v τ) ^ p + b₀ * (v τ)) :=
      h_root_C1 τ
    have hm1 := hval_mul_ge_M1 h_root_v (Or.inr (le_of_eq hden_inv_val0.symm))
    have hm2 := hval_mul_ge_M1 hm1 (Or.inr (le_of_eq hnum_val0.symm))
    rcases hm2 with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (by omega)

  have hsum_Lag_ge1 : (∑ τ ∈ U_C1, term_Lag τ) = 0 ∨
      valL F M_1 (∏ τ ∈ U_C1, (z γ_σ - v τ)) + 1 ≤ valL F M_1 (∑ τ ∈ U_C1, term_Lag τ) := by
    rw [hP_out_val0, zero_add]
    exact hval_finset_sum_M1 U_C1 term_Lag 1 hterm_Lag_ge1

  have hP_γσ_decomp : (z γ_σ) ^ p + b₀ * (z γ_σ) =
      (∏ τ ∈ U_C1, (z γ_σ - v τ)) + ∑ τ ∈ U_C1, term_Lag τ := by
    have h1 := heval_Lag
    rw [heval_Q_at (z γ_σ)] at h1
    change ((z γ_σ) ^ p - ∏ τ ∈ U_C1, (z γ_σ - v τ)) + b₀ * (z γ_σ) =
      ∑ τ ∈ U_C1, term_Lag τ at h1
    linear_combination h1

  obtain ⟨hP_γσ_ne0, hP_γσ_val0⟩ := hval_strict_M1
    (∏ τ ∈ U_C1, (z γ_σ - v τ)) (∑ τ ∈ U_C1, term_Lag τ) hP_out_ne0 hsum_Lag_ge1
  rw [← hP_γσ_decomp] at hP_γσ_ne0 hP_γσ_val0
  rw [hP_out_val0] at hP_γσ_val0

  
  set A_σ : M_1 := ((z γ_σ) ^ p + b₀ * (z γ_σ)) * ((ϖ_M1 ^ t : M_1ˣ) : M_1)
  set R_σ : M_1 := normLM F hM1_K (w_γ γ_σ : K) - (1 + A_σ)
  have hA_σ_ne0 : A_σ ≠ 0 := mul_ne_zero hP_γσ_ne0 (Units.ne_zero _)
  have hA_σ_val : valL F M_1 A_σ = (t : ℤ) := by
    change valL F M_1 (((z γ_σ) ^ p + b₀ * (z γ_σ)) * ((ϖ_M1 ^ t : M_1ˣ) : M_1)) = (t : ℤ)
    rw [hval_mul_M1 _ _ hP_γσ_ne0 (Units.ne_zero _), hP_γσ_val0, hϖM1_pow_val t, zero_add]
  have hR_σ_ge : R_σ = 0 ∨ valL F M_1 A_σ + 1 ≤ valL F M_1 R_σ := by
    rw [hA_σ_val]
    exact h_norm_approx γ_σ
  have hnorm_sub1_eq : normLM F hM1_K (w_γ γ_σ : K) - 1 = A_σ + R_σ := by
    dsimp [R_σ]
    ring
  obtain ⟨hnorm_sub1_ne0, hnorm_sub1_val⟩ := hval_strict_M1 A_σ R_σ hA_σ_ne0 hR_σ_ge
  rw [← hnorm_sub1_eq] at hnorm_sub1_ne0 hnorm_sub1_val
  rw [hA_σ_val] at hnorm_sub1_val

  have hfinal_eq : (ϖ_M1 : M_1) - (⟨(σ : AbsGal F) (ϖ_M1 : AlgebraicClosure F), hσw⟩ : M_1) =
      - (ϖ_M1 : M_1) * (normLM F hM1_K (w_γ γ_σ : K) - 1) := by
    rw [← hnorm_act_γσ]
    change (ϖ_M1 : M_1) - normLM F hM1_K (act γ_σ (ϖ_K : K)) =
      - (ϖ_M1 : M_1) * (normLM F hM1_K (act γ_σ (ϖ_K : K) * ((ϖ_K⁻¹ : Kˣ) : K)) - 1)
    rw [map_mul]
    have hinv : ((ϖ_M1⁻¹ : M_1ˣ) : M_1) * (ϖ_M1 : M_1) = 1 := Units.inv_mul ϖ_M1
    have hmap_inv : normLM F hM1_K ((ϖ_K⁻¹ : Kˣ) : K) = ((ϖ_M1⁻¹ : M_1ˣ) : M_1) := by
      rw [← hϖ_norm1]
      rfl
    rw [hmap_inv]
    linear_combination normLM F hM1_K (act γ_σ (ϖ_K : K)) * hinv

  have hneg_ϖ_ne0 : - (ϖ_M1 : M_1) ≠ 0 := neg_ne_zero.mpr (Units.ne_zero ϖ_M1)
  have hneg_ϖ_val : valL F M_1 (- (ϖ_M1 : M_1)) = 1 := (hval_neg_M1 (ϖ_M1 : M_1)).trans hϖ_M1
  rw [hfinal_eq]
  refine ⟨mul_ne_zero hneg_ϖ_ne0 hnorm_sub1_ne0, ?_⟩
  rw [hval_mul_M1 (- (ϖ_M1 : M_1)) _ hneg_ϖ_ne0 hnorm_sub1_ne0, hneg_ϖ_val, hnorm_sub1_val]
  omega

theorem ld_ch14_wild_tower_step_poly_and_herbrand_comp (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M_C M_1 K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M_C] [FiniteDimensional F M_1] [FiniteDimensional F K]
    (hM_CK : M_C ≤ K) (hMC_M1 : M_C ≤ M_1) (hM1_K : M_1 ≤ K)
    (hp_prime : Nat.Prime (p F))
    (r : ℕ) (hr_pos : 1 ≤ r)
    (hq_eq : Module.finrank M_C (IntermediateField.extendScalars hM_CK) = (p F) ^ (r + 1))
    (ϖ_K : Kˣ) (ϖ_M1 : M_1ˣ) (ϖ_MC : M_Cˣ)
    (hϖ_norm1 : Units.map (normLM F hM1_K) ϖ_K = ϖ_M1)
    (hϖ_norm2 : Units.map (normLM F hMC_M1) ϖ_M1 = ϖ_MC)
    (hϖ_K : valL F K (ϖ_K : K) = 1)
    (hϖ_M1 : valL F M_1 (ϖ_M1 : M_1) = 1)
    (hϖ_MC : valL F M_C (ϖ_MC : M_C) = 1)
    (hValAlgM1 : ∀ z : M_C,
      valL F M_1 (IntermediateField.inclusion hMC_M1 z) =
        (((p F) ^ r : ℕ) : ℤ) * valL F M_C z)
    (hResLiftM1 : ∀ w : M_1, (w = 0 ∨ 0 ≤ valL F M_1 w) →
      ∃ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) ∧
        (w - IntermediateField.inclusion hMC_M1 z = 0 ∨
          1 ≤ valL F M_1 (w - IntermediateField.inclusion hMC_M1 z)))
    (t : ℕ) (ht_ge1 : 1 ≤ t)
    (htr_bound_M1 : ∀ (m : ℤ) (w : M_1),
      (w = 0 ∨
        (((p F) ^ r : ℕ) : ℤ) * m - ((((p F) ^ r - 1 : ℕ) : ℤ) * (t + 1 : ℤ)) ≤
          valL F M_1 w) →
      (traceLM F hMC_M1 w = 0 ∨ m ≤ valL F M_C (traceLM F hMC_M1 w)))
    (hnorm_le_KM1 : ∀ m ≤ t + 1, ∀ w ∈ unitGroup F K m,
      Units.map (normLM F hM1_K) w ∈ unitGroup F M_1 m)
    (hnorm_surj_lt_KM1 : ∀ m < t, ∀ u ∈ unitGroup F M_1 m,
      ∃ w ∈ unitGroup F K m,
        (Units.map (normLM F hM1_K) w) * u⁻¹ ∈ unitGroup F M_1 (m + 1))
    (hnorm_gt_le_KM1 : ∀ m ≥ t + 1, ∀ w ∈ unitGroup F K (t + 1 + (p F) * (m - t)),
      Units.map (normLM F hM1_K) w ∈ unitGroup F M_1 (m + 1))
    (hnorm_gt_surj_KM1 : ∀ m ≥ t + 1, ∀ u ∈ unitGroup F M_1 m,
      ∃ w ∈ unitGroup F K (t + (p F) * (m - t)),
        (Units.map (normLM F hM1_K) w) * u⁻¹ ∈ unitGroup F M_1 (m + 1))
    (hb₀_val : valL F M_1 ((((ϖ_M1 ^ t)⁻¹ : M_1ˣ) : M_1) * traceLM F hM1_K ((ϖ_K ^ t : Kˣ) : K)) = 0)
    (hP_KM1 : ∀ z : M_1, (z = 0 ∨ 0 ≤ valL F M_1 z) →
      normLM F hM1_K (1 + IntermediateField.inclusion hM1_K z * ((ϖ_K ^ t : Kˣ) : K)) -
        (1 + (z ^ (p F) + ((((ϖ_M1 ^ t)⁻¹ : M_1ˣ) : M_1) * traceLM F hM1_K ((ϖ_K ^ t : Kˣ) : K)) * z) *
          ((ϖ_M1 ^ t : M_1ˣ) : M_1)) = 0 ∨
        (t + 1 : ℤ) ≤ valL F M_1
          (normLM F hM1_K (1 + IntermediateField.inclusion hM1_K z * ((ϖ_K ^ t : Kˣ) : K)) -
            (1 + (z ^ (p F) + ((((ϖ_M1 ^ t)⁻¹ : M_1ˣ) : M_1) * traceLM F hM1_K ((ϖ_K ^ t : Kˣ) : K)) * z) *
              ((ϖ_M1 ^ t : M_1ˣ) : M_1))))
    (hnorm_le_M1MC : ∀ m ≤ t + 1, ∀ w ∈ unitGroup F M_1 m,
      Units.map (normLM F hMC_M1) w ∈ unitGroup F M_C m)
    (hnorm_surj_lt_M1MC : ∀ m < t, ∀ u ∈ unitGroup F M_C m,
      ∃ w ∈ unitGroup F M_1 m,
        (Units.map (normLM F hMC_M1) w) * u⁻¹ ∈ unitGroup F M_C (m + 1))
