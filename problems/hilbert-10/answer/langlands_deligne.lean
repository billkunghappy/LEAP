      have hn_eq : n = p * q₀ + r₀ := (Nat.div_add_mod n p).symm
      have h_vp_eq : padicValNat p n.factorial = padicValNat p q₀.factorial + q₀ := by
        rw [← padicValNat_mul_div_factorial n, padicValNat_factorial_mul]
