        rw [hA_num_def, hbE'_eq, ← hp1_cast]
        ring
      linarith [h_ediv, h_emod_le, hA_expand, hpm]

  
  have h_uw₂p :
      1 - IntermediateField.inclusion hLE' u * (w₂ : E') ^ p = 0 ∨
        ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) ≤
          valL F E' (1 - IntermediateField.inclusion hLE' u * (w₂ : E') ^ p) := by
    have hcayley := hs_LE'_cayley (w₂ : E')
    rw [← hp_def] at hcayley
    have h_id :
        1 - IntermediateField.inclusion hLE' u * (w₂ : E') ^ p =
          - (IntermediateField.inclusion hLE' u *
              ∑ i ∈ Finset.Icc 1 (p - 1),
                (-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i) *
                  (w₂ : E') ^ (p - i)) := by
      rw [hcayley, mul_add, hu_norm_E']
      ring
    rw [h_id]
    have hsum_val :
        (∑ i ∈ Finset.Icc 1 (p - 1),
          (-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i) *
            (w₂ : E') ^ (p - i)) = 0 ∨
          ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (p : ℤ) * (m : ℤ) ≤
            valL F E'
              (∑ i ∈ Finset.Icc 1 (p - 1),
                (-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i) *
                  (w₂ : E') ^ (p - i)) := by
      apply hvalE'_sum
      intro i hi
      have hi_le : i ≤ p := by
        have h := (Finset.mem_Icc.mp hi).2
        omega
      have hsi :
          (-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i) = 0 ∨
            ((p - 1 : ℕ) : ℤ) * (t₂ : ℤ) - (i : ℤ) * (m : ℤ) ≤
              valL F E' ((-1 : E') ^ (i - 1) * IntermediateField.inclusion hLE' (s_LE' (w₂ : E') i)) := by
        rcases hs_E'_val i hi with h0 | hge
        · left; rw [h0, mul_zero]
        · right; rwa [hvalE'_neg1_pow_mul]
