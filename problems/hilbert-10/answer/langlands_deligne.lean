  have hk_ne0 : k ≠ 0 := by
    intro hk0
    rw [hk0, zero_mul, Nat.cast_zero] at hkm₀_zmod
    exact zero_ne_one hkm₀_zmod
  have hk_lt : k < p := Nat.mod_lt _ hp_pos
