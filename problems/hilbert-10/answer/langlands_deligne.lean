      conv_lhs => rw [← List.ofFn_get D_orb]
      rw [List.map_ofFn, List.sum_ofFn]
      rfl
    rw [h_list_sum, h_tr_L, h_tr_E] at h_decomp_w
    rw [← h_decomp_w]
    congr 1
    exact Finset.sum_congr rfl fun i _ => (h_tr_Fi i).symm
