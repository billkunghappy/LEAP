  have hPA_0 : P_A 0 = 0 := by
    dsimp [P_A]
    apply Finset.sum_eq_zero
    intro j hj
    have hj1 : 1 ≤ j := (Finset.mem_Icc.mp hj).1
    have hj_ne0 : j ≠ 0 := by omega
    rw [zero_pow hj_ne0, mul_zero]
  have hPA_split : ∀ y : A,
      P_A y = y + ∑ j ∈ Finset.Icc 2 (p - 1), ((j : ℕ) : A)⁻¹ * y ^ j := by
    intro y
    have hIcc_eq : Finset.Icc 1 (p - 1) = insert 1 (Finset.Icc 2 (p - 1)) := by
      ext j
