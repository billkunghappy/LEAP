          have hyc_N₁ : y * c * y⁻¹ * c⁻¹ ∈ N₁ := hHL'_comm y hy c hc
          have hxyc_N₁ : x * (y * c * y⁻¹ * c⁻¹) * x⁻¹ ∈ N₁ :=
