      rw [add_zero, ← hprod_sub] at hmul
      rcases hmul with h0 | hge
      · exact Or.inl (sub_eq_zero.mp h0)
      · exact Or.inr hge
  have hb_tr_val : b_tr = 0 ∨ 0 ≤ valL F A b_tr := by
    have hϖBt_in : ((ϖ_B ^ t : Bˣ) : B) = 0 ∨
        (p : ℤ) * (t : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F B ((ϖ_B ^ t : Bˣ) : B) := by
      right
      rw [hϖ_B_pow_val t, hp_sub1_int]
      have ht_int : (1 : ℤ) ≤ (t : ℤ) := by omega
      nlinarith
    have htr_t : traceLM F hAB ((ϖ_B ^ t : Bˣ) : B) = 0 ∨
        (t : ℤ) ≤ valL F A (traceLM F hAB ((ϖ_B ^ t : Bˣ) : B)) :=
      htr_bound_p (t : ℤ) ((ϖ_B ^ t : Bˣ) : B) hϖBt_in
    have hmul := hval_mul_ge_A (-(t : ℤ)) (t : ℤ)
      ((((ϖ_A ^ t)⁻¹ : Aˣ) : A)) (traceLM F hAB ((ϖ_B ^ t : Bˣ) : B))
      (Or.inr (by rw [hϖ_A_pow_inv_val t])) htr_t
    rwa [neg_add_cancel] at hmul
  have hP_poly : ∀ s : A, (s = 0 ∨ 0 ≤ valL F A s) →
      normLM F hAB (1 + IntermediateField.inclusion hAB s * ((ϖ_B ^ t : Bˣ) : B)) -
        (1 + (s ^ p + b_tr * s) * ((ϖ_A ^ t : Aˣ) : A)) = 0 ∨
        ((t + 1 : ℕ) : ℤ) ≤ valL F A
          (normLM F hAB (1 + IntermediateField.inclusion hAB s * ((ϖ_B ^ t : Bˣ) : B)) -
            (1 + (s ^ p + b_tr * s) * ((ϖ_A ^ t : Aˣ) : A))) := by
    intro s hs
    let y : B := IntermediateField.inclusion hAB s * ((ϖ_B ^ t : Bˣ) : B)
    have hy : y = 0 ∨ (t : ℤ) ≤ valL F B y := by
      have hinc_s := hval_inc_ge 0 s hs
      rw [mul_zero] at hinc_s
      have hmul := hval_mul_ge_B 0 (t : ℤ)
        (IntermediateField.inclusion hAB s) (((ϖ_B ^ t : Bˣ) : B))
        hinc_s (Or.inr (by rw [hϖ_B_pow_val t]))
      rwa [zero_add] at hmul
    obtain ⟨z_rem, hz_rem, hnorm_eq⟩ := hnorm_exp t ht_ge1 y hy
    have htr_y : traceLM F hAB y = s * traceLM F hAB ((ϖ_B ^ t : Bˣ) : B) :=
      htr_smul s ((ϖ_B ^ t : Bˣ) : B)
    have hny : normLM F hAB y = s ^ p * ((ϖ_A ^ t : Aˣ) : A) := by
      dsimp [y]
      rw [map_mul, hnorm_inc s]
      congr 1
      have hmap_pow : Units.map (normLM F hAB) (ϖ_B ^ t) = ϖ_A ^ t := by
        rw [map_pow, hϖ_norm]
      exact congrArg Units.val hmap_pow
    have hϖ_A_inv_mul : ((((ϖ_A ^ t)⁻¹ : Aˣ) : A)) * ((ϖ_A ^ t : Aˣ) : A) = 1 :=
      Units.inv_mul (ϖ_A ^ t)
    have hdiff_eq :
        normLM F hAB (1 + y) -
          (1 + (s ^ p + b_tr * s) * ((ϖ_A ^ t : Aˣ) : A)) =
          traceLM F hAB z_rem := by
      have hb_tr_def : b_tr = (((ϖ_A ^ t)⁻¹ : Aˣ) : A) * traceLM F hAB ((ϖ_B ^ t : Bˣ) : B) := rfl
      rw [hb_tr_def, hnorm_eq, map_add (traceLM F hAB) y z_rem, htr_y, hny]
      linear_combination - (traceLM F hAB ((ϖ_B ^ t : Bˣ) : B) * s) * hϖ_A_inv_mul
    have hz_rem_tr_in : z_rem = 0 ∨
        (p : ℤ) * ((t + 1 : ℕ) : ℤ) - ((p - 1 : ℕ) : ℤ) * (t + 1 : ℤ) ≤ valL F B z_rem := by
      apply hval_le_B _ hz_rem
      rw [hp_sub1_int]
      have ht_int : (1 : ℤ) ≤ (t : ℤ) := by omega
      have ht1_eq : ((t + 1 : ℕ) : ℤ) = (t : ℤ) + 1 := by push_cast; ring
      rw [ht1_eq]
      nlinarith
    have htr_z_rem := htr_bound_p ((t + 1 : ℕ) : ℤ) z_rem hz_rem_tr_in
    rwa [hdiff_eq]
  exact ⟨hp_kA, hnorm_surj_lt, hnorm_gt_le, hnorm_gt_surj, hb_tr_val, hP_poly⟩

theorem ld_ch14_wild_prime_step_norm_coset_generator (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (A B : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F A] [FiniteDimensional F B] (hAB : A ≤ B)
    (hp_prime : Nat.Prime (p F))
    (ϖ_B : Bˣ) (ϖ_A : Aˣ)
    (hϖ_norm : Units.map (normLM F hAB) ϖ_B = ϖ_A)
    (hϖ_B : valL F B (ϖ_B : B) = 1)
    (hϖ_A : valL F A (ϖ_A : A) = 1)
    (k_A : Type u) [Field k_A] [Fintype k_A] (resA : A → k_A)
    (hresA_0 : resA 0 = 0) (hresA_1 : resA 1 = 1)
    (hresA_ring : ∀ x₁ x₂ : A, (x₁ = 0 ∨ 0 ≤ valL F A x₁) → (x₂ = 0 ∨ 0 ≤ valL F A x₂) →
      resA (x₁ + x₂) = resA x₁ + resA x₂ ∧
      resA (x₁ * x₂) = resA x₁ * resA x₂ ∧
      resA (-x₁) = -resA x₁)
    (hresA_ker : ∀ x : A, (x = 0 ∨ 0 ≤ valL F A x) → (resA x = 0 ↔ (x = 0 ∨ 1 ≤ valL F A x)))
    (hresA_surj : ∀ a : k_A, ∃ x : A, (x = 0 ∨ 0 ≤ valL F A x) ∧ resA x = a)
    (t : ℕ) (ht_ge1 : 1 ≤ t)
    (hnorm_surj_lt : ∀ m < t, ∀ u ∈ unitGroup F A m,
      ∃ w ∈ unitGroup F B m,
        (Units.map (normLM F hAB) w) * u⁻¹ ∈ unitGroup F A (m + 1))
    (hnorm_gt_le : ∀ r ≥ t + 1, ∀ w ∈ unitGroup F B (t + 1 + (p F) * (r - t)),
      Units.map (normLM F hAB) w ∈ unitGroup F A (r + 1))
    (hnorm_gt_surj : ∀ r ≥ t + 1, ∀ u ∈ unitGroup F A r,
      ∃ w ∈ unitGroup F B (t + (p F) * (r - t)),
        (Units.map (normLM F hAB) w) * u⁻¹ ∈ unitGroup F A (r + 1))
    (b_tr : A) (hb_tr_val : b_tr = 0 ∨ 0 ≤ valL F A b_tr)
    (hP_norm_t : ∀ s : A, (s = 0 ∨ 0 ≤ valL F A s) →
      normLM F hAB (1 + IntermediateField.inclusion hAB s * ((ϖ_B ^ t : Bˣ) : B)) -
        (1 + (s ^ (p F) + b_tr * s) * ((ϖ_A ^ t : Aˣ) : A)) = 0 ∨
        ((t + 1 : ℕ) : ℤ) ≤ valL F A
          (normLM F hAB (1 + IntermediateField.inclusion hAB s * ((ϖ_B ^ t : Bˣ) : B)) -
            (1 + (s ^ (p F) + b_tr * s) * ((ϖ_A ^ t : Aˣ) : A))))
    (hAS_coker : ∀ b₀ : k_A, ∃ a₁ : k_A, ∀ c : k_A, ∃ (e₀ : Fin (p F)) (a : k_A),
      c = ((e₀ : ℕ) : k_A) * a₁ + (a ^ (p F) + b₀ * a))
    (m_cut : ℕ) (hm_cut : 1 ≤ m_cut) :
    (∃ m₁ : ℕ, 1 ≤ m₁ ∧
      ∀ w ∈ unitGroup F B m₁,
        Units.map (normLM F hAB) w ∈ unitGroup F A m_cut) ∧
    (∃ g₀ : Aˣ, ∀ x : Aˣ, ∃ (e₀ : Fin (p F)) (w : Bˣ),
      x * (g₀ ^ (e₀ : ℕ) * Units.map (normLM F hAB) w)⁻¹ ∈ unitGroup F A m_cut) :=
by
  
  have hvalA_props :
      valL F A 0 = 0 ∧
      valL F A 1 = 0 ∧
      valL F A (-1) = 0 ∧
      (∀ x : A, valL F A (-x) = valL F A x) ∧
      (∀ x y : A, x ≠ 0 → y ≠ 0 → valL F A (x * y) = valL F A x + valL F A y) ∧
      (∀ u : Aˣ, valL F A ((u⁻¹ : Aˣ) : A) = - valL F A (u : A)) ∧
      (∀ (k : ℤ) (x y : A),
        (x = 0 ∨ k ≤ valL F A x) → (y = 0 ∨ k ≤ valL F A y) →
          (x + y = 0 ∨ k ≤ valL F A (x + y))) ∧
      (∀ u : Aˣ, u ∈ unitGroup F A 0 ↔ valL F A (u : A) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Aˣ,
        u ∈ unitGroup F A a ↔ ((u : A) = 1 ∨ (a : ℤ) ≤ valL F A ((u : A) - 1))) ∧
      (∀ (a : ℕ) (u : Aˣ), u ∈ unitGroup F A a → valL F A (u : A) = 0) := by
    have halg : ∀ z : A,
        minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
        ∃ m : ℕ,
          Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
          Module.finrank F A = (minpoly F z).natDegree * m := by
      clear hp_prime hϖ_norm hϖ_B hϖ_A hresA_0 hresA_1 hresA_ring hresA_ker hresA_surj
        hnorm_surj_lt hnorm_gt_le hnorm_gt_surj hb_tr_val hP_norm_t hAS_coker
        ‹IsNonarchimedeanLocalField F› ‹TopologicalSpace F› ‹ValuativeRel F›
      intro z
      have hmin_coe : minpoly F (z : AlgebraicClosure F) = minpoly F z :=
        minpoly.algHom_eq A.val A.val.injective z
      have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
      let pb := IntermediateField.adjoin.powerBasis hz
      have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen F z :=
        IntermediateField.adjoin.powerBasis_gen hz
      have hmin_gen : minpoly F pb.gen = minpoly F z := by
        have hval : (IntermediateField.adjoin F {z}).val pb.gen = z := by
          rw [hpb_gen]
          rfl
        rw [← minpoly.algHom_eq (IntermediateField.adjoin F {z}).val
          (IntermediateField.adjoin F {z}).val.injective pb.gen, hval]
      have hpb_dim : pb.dim = (minpoly F z).natDegree := by
        rw [IntermediateField.adjoin.powerBasis_dim hz]
      have hnorm_adj := Algebra.norm_eq_norm_adjoin F z
      rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
      refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
      rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hval_le : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
        b ≠ 0 ∧ addVal F b ≤ addVal F a := by
      intro a b ha hab
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
      have hφb : φ (valuation F b) ≠ 0 := by
        intro h0
        rw [h0] at hφ_le
        exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
      have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
      have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
      refine ⟨hb, ?_⟩
      rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
      unfold addVal
      rw [dif_neg ha, dif_neg hb]
      exact neg_le_neg hφ_le
    have haddVal0 : addVal F 0 = 0 := by
      unfold addVal
      exact dif_pos rfl
    have haddVal1 : addVal F 1 = 0 := by
      have h1 : (1 : F) ≠ 0 := one_ne_zero
      have hv1 : valuation F (1 : F) ≠ 0 := (Valuation.ne_zero_iff _).mpr h1
      have hφ1 : φ (valuation F (1 : F)) ≠ 0 := (map_ne_zero _).mpr hv1
      unfold addVal
      rw [dif_neg h1]
      have hunz : WithZero.unzero hφ1 = 1 := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_one, map_one, WithZero.coe_one]
      rw [hunz, toAdd_one, neg_zero]
    have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
      intro a b ha hb
      have hab : a * b ≠ 0 := mul_ne_zero ha hb
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
      have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
      have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
      have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
      unfold addVal
      rw [dif_neg hab, dif_neg ha, dif_neg hb]
      have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
          WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
      rw [hunz, toAdd_mul, neg_add]
    have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
      intro a n ha
      have han : a ^ n ≠ 0 := pow_ne_zero n ha
      have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
      have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
      have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
      have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
      unfold addVal
      rw [dif_neg han, dif_neg ha]
      have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
          WithZero.coe_pow, WithZero.coe_unzero]
      rw [hunz, toAdd_pow]
      simp
    have hrel0 : relVal F A 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F A 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : A, x ≠ 0 → y ≠ 0 → relVal F A (x * y) = relVal F A x + relVal F A y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
    have hrel_neg1 : relVal F A (-1) = 0 := by
      have hne : (-1 : A) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hsq : relVal F A ((-1 : A) * (-1 : A)) = relVal F A (-1) + relVal F A (-1) :=
        hrel_mul (-1) (-1) hne hne
      have h1 : (-1 : A) * (-1 : A) = 1 := by ring
      rw [h1, hrel1] at hsq
      omega
    have hrel_neg : ∀ x : A, relVal F A (-x) = relVal F A x := by
      intro x
      by_cases hx : x = 0
      · simp [hx]
      · have hne1 : (-1 : A) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have hneg_eq : (-x : A) = (-1 : A) * x := by ring
        rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
    have hrel_inv : ∀ u : Aˣ, relVal F A ((u⁻¹ : Aˣ) : A) = - relVal F A (u : A) := by
      intro u
      have hmul : relVal F A ((u : A) * ((u⁻¹ : Aˣ) : A)) =
          relVal F A (u : A) + relVal F A ((u⁻¹ : Aˣ) : A) :=
        hrel_mul (u : A) ((u⁻¹ : Aˣ) : A) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Aˣ) (n : ℕ),
        relVal F A (((u ^ n : Aˣ) : A)) = (n : ℤ) * relVal F A (u : A) := by
      intro u n
      induction n with
      | zero =>
        simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Aˣ) (m : ℤ),
        relVal F A (((u ^ m : Aˣ) : A)) = m * relVal F A (u : A) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F A (((u ^ (n : ℤ) : Aˣ) : A)) = (n : ℤ) * relVal F A (u : A)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
      (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
    have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
      rw [hπ]
      exact φ.apply_symm_apply _
    have hφπ_ne : φ (valuation F π) ≠ 0 := by
      rw [hφπ]
      exact WithZero.coe_ne_zero
    have hπ_ne : π ≠ 0 := by
      intro h0
      apply hφπ_ne
      simp [h0]
    have hadd_π : addVal F π = 1 := by
      unfold addVal
      rw [dif_neg hπ_ne]
      have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
        rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
      rw [hunz, toAdd_ofAdd, neg_neg]
    let x₀ : A := algebraMap F A π
    have hx₀_ne : x₀ ≠ 0 := by
      simp [x₀, hπ_ne]
    have hrel_x₀ : relVal F A x₀ = (Module.finrank F A : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F A) hπ_ne, hadd_π, mul_one]
    have hfin_pos : 0 < Module.finrank F A := Module.finrank_pos
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : A, x ≠ 0 ∧ relVal F A x = k}
    have hS_nonempty : S.Nonempty := ⟨Module.finrank F A, hfin_pos, x₀, hx₀_ne, hrel_x₀⟩
    have hfA_mem : resDeg F A ∈ S := Nat.sInf_mem hS_nonempty
    obtain ⟨hfA_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := hfA_mem
    let ϖL : Aˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖL : relVal F A (ϖL : A) = (resDeg F A : ℤ) := hrel_ϖ₀
    have hfA_int_pos : (0 : ℤ) < (resDeg F A : ℤ) := Nat.cast_pos.mpr hfA_pos
    have hfA_int_ne : (resDeg F A : ℤ) ≠ 0 := ne_of_gt hfA_int_pos
    have hdiv : ∀ x : A, relVal F A x = (resDeg F A : ℤ) * valL F A x := by
      intro x
      by_cases hx : x = 0
      · unfold valL
        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F A : ℤ)
        set q : ℤ := valL F A x
        set r : ℤ := relVal F A x % f
        have hediv : f * q + r = relVal F A x := Int.mul_ediv_add_emod (relVal F A x) f
        have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F A x) hfA_int_ne
        have hr_lt : r < f := Int.emod_lt_of_pos (relVal F A x) hfA_int_pos
        have hr_zero : r = 0 := by
          by_contra hr_ne
          have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
          let y : A := x * (((ϖL ^ (-q) : Aˣ) : A))
          have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
          have hrel_y : relVal F A y = r := by
            dsimp [y]
            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖL (-q), hrel_ϖL]
            linarith
          let k : ℕ := r.toNat
          have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k := by omega
          have hk_lt : k < resDeg F A := by omega
          have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F A ≤ k := Nat.sInf_le hk_mem
          omega
        linarith
    have hval0 : valL F A 0 = 0 := by
      have h := hdiv 0
      rw [hrel0] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfA_int_ne
    have hval1 : valL F A 1 = 0 := by
      have h := hdiv 1
      rw [hrel1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfA_int_ne
    have hval_neg1 : valL F A (-1) = 0 := by
      have h := hdiv (-1)
      rw [hrel_neg1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfA_int_ne
    have hval_neg : ∀ x : A, valL F A (-x) = valL F A x := by
      intro x
      apply mul_left_cancel₀ hfA_int_ne
      rw [← hdiv (-x), ← hdiv x, hrel_neg]
    have hval_mul : ∀ x y : A, x ≠ 0 → y ≠ 0 → valL F A (x * y) = valL F A x + valL F A y := by
      intro x y hx hy
      apply mul_left_cancel₀ hfA_int_ne
      rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
    have hval_inv : ∀ u : Aˣ, valL F A ((u⁻¹ : Aˣ) : A) = - valL F A (u : A) := by
      intro u
      apply mul_left_cancel₀ hfA_int_ne
      rw [mul_neg, ← hdiv, ← hdiv, hrel_inv]
    have hval_add : ∀ (k : ℤ) (x y : A),
        (x = 0 ∨ k ≤ valL F A x) → (y = 0 ∨ k ≤ valL F A y) →
          (x + y = 0 ∨ k ≤ valL F A (x + y)) := by
      letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
      haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
      haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
        Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
      letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
      haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
      have hspec_pow : ∀ z : A,
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F A) =
            ‖Algebra.norm F z‖ := by
        intro z
        obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg z
        have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
            ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
          rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
        have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
          rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
        have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
        have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
          exact_mod_cast minpoly.natDegree_pos hz
        rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
           ← Real.rpow_natCast]
        congr 1
        push_cast
        rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
      have hspec_le : ∀ w z : A, w ≠ 0 →
          spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
            spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
          z ≠ 0 ∧ valL F A z ≤ valL F A w := by
        intro w z hw hle
        have hpow_le :
            (spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F)) ^ (Module.finrank F A) ≤
            (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F A) :=
          pow_le_pow_left₀ (spectralNorm_nonneg _) hle _
        rw [hspec_pow w, hspec_pow z] at hpow_le
        have hv_eq : ∀ a : F, ‖a‖ =
            ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
              (valuation F a) : ℝ) := fun a => rfl
        rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hpow_le
        have hv_le : valuation F (Algebra.norm F w) ≤ valuation F (Algebra.norm F z) :=
          (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp
            hpow_le
        have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
        obtain ⟨hnz, hrel_le⟩ := hval_le (Algebra.norm F w) (Algebra.norm F z) hnw hv_le
        have hz : z ≠ 0 := Algebra.norm_ne_zero_iff.mp hnz
        refine ⟨hz, ?_⟩
        exact Int.ediv_le_ediv hfA_int_pos hrel_le
      intro k x y hx hy
      by_cases hxy : x + y = 0
      · exact Or.inl hxy
      · right
        have hcoe : ((x + y : A) : AlgebraicClosure F) =
            (x : AlgebraicClosure F) + (y : AlgebraicClosure F) := rfl
        have hna := isNonarchimedean_spectralNorm (K := F)
          (x : AlgebraicClosure F) (y : AlgebraicClosure F)
        rw [← hcoe, le_max_iff] at hna
        rcases hna with hle_x | hle_y
        · obtain ⟨hx_ne, hval_x⟩ := hspec_le (x + y) x hxy hle_x
          have hkx : k ≤ valL F A x := hx.resolve_left hx_ne
          exact le_trans hkx hval_x
        · obtain ⟨hy_ne, hval_y⟩ := hspec_le (x + y) y hxy hle_y
          have hky : k ≤ valL F A y := hy.resolve_left hy_ne
          exact le_trans hky hval_y
    have hgen_val0 : ∀ (a : ℕ), 1 ≤ a → ∀ u : Aˣ,
        ((u : A) = 1 ∨ (a : ℤ) ≤ valL F A ((u : A) - 1)) → valL F A (u : A) = 0 := by
      intro a ha u hu
      rcases hu with hu1 | hua
      · rw [hu1, hval1]
      · have h_ge0 : (0 : ℤ) ≤ valL F A (u : A) := by
          have hadd := hval_add 0 ((u : A) - 1) 1 (Or.inr (by omega)) (Or.inr (by rw [hval1]))
          have heq : ((u : A) - 1) + 1 = (u : A) := sub_add_cancel (u : A) 1
          rw [heq] at hadd
          exact hadd.resolve_left (Units.ne_zero u)
        have h_le0 : valL F A (u : A) ≤ 0 := by
          by_contra hlt
          have hge1 : (1 : ℤ) ≤ valL F A (-(u : A)) := by
            rw [hval_neg]
            omega
          have hadd := hval_add 1 ((u : A) - 1) (-(u : A)) (Or.inr (by omega)) (Or.inr hge1)
          have heq : ((u : A) - 1) + (-(u : A)) = -1 := by ring
          rw [heq, hval_neg1] at hadd
          have hne : (-1 : A) ≠ 0 := neg_ne_zero.mpr one_ne_zero
          have h10 : (1 : ℤ) ≤ 0 := hadd.resolve_left hne
          omega
        omega
    have hunit0 : ∀ u : Aˣ, u ∈ unitGroup F A 0 ↔ valL F A (u : A) = 0 := by
      let H₀ : Subgroup Aˣ := {
        carrier := {u : Aˣ | valL F A (u : A) = 0}
        one_mem' := by
          change valL F A ((1 : Aˣ) : A) = 0
          rw [Units.val_one, hval1]
        mul_mem' := by
          intro u v hu hv
          change valL F A ((u * v : Aˣ) : A) = 0
          rw [Units.val_mul, hval_mul _ _ (Units.ne_zero u) (Units.ne_zero v), hu, hv, add_zero]
        inv_mem' := by
          intro u hu
          change valL F A ((u⁻¹ : Aˣ) : A) = 0
          rw [hval_inv u, hu, neg_zero]
      }
      have hcl_le : unitGroup F A 0 ≤ H₀ := by
        unfold unitGroup
        rw [Subgroup.closure_le]
        intro u hu
        simpa [H₀] using hu
      have hle_cl : H₀ ≤ unitGroup F A 0 := by
        intro u hu
        unfold unitGroup
        apply Subgroup.subset_closure
        simpa [H₀] using hu
      intro u
      exact ⟨fun hu => hcl_le hu, fun hu => hle_cl hu⟩
    have hunit_ge1 : ∀ (a : ℕ), 1 ≤ a → ∀ u : Aˣ,
        u ∈ unitGroup F A a ↔ ((u : A) = 1 ∨ (a : ℤ) ≤ valL F A ((u : A) - 1)) := by
      intro a ha
      have ha0 : a ≠ 0 := by omega
      let Ha : Subgroup Aˣ := {
        carrier := {u : Aˣ | (u : A) = 1 ∨ (a : ℤ) ≤ valL F A ((u : A) - 1)}
        one_mem' := Or.inl Units.val_one
        mul_mem' := by
          intro u v hu hv
          change ((u * v : Aˣ) : A) = 1 ∨ (a : ℤ) ≤ valL F A (((u * v : Aˣ) : A) - 1)
          have hu0 : valL F A (u : A) = 0 := hgen_val0 a ha u hu
          have hterm1 : (u : A) * ((v : A) - 1) = 0 ∨
              (a : ℤ) ≤ valL F A ((u : A) * ((v : A) - 1)) := by
            by_cases hsub : (v : A) - 1 = 0
            · left
              rw [hsub, mul_zero]
            · right
              have hv1 : (v : A) ≠ 1 := sub_ne_zero.mp hsub
              have hva : (a : ℤ) ≤ valL F A ((v : A) - 1) := hv.resolve_left hv1
              rw [hval_mul (u : A) ((v : A) - 1) (Units.ne_zero u) hsub, hu0, zero_add]
              exact hva
          have hterm2 : (u : A) - 1 = 0 ∨ (a : ℤ) ≤ valL F A ((u : A) - 1) := by
            rcases hu with hu1 | hua
            · exact Or.inl (sub_eq_zero.mpr hu1)
            · exact Or.inr hua
          have hadd := hval_add (a : ℤ) ((u : A) * ((v : A) - 1)) ((u : A) - 1) hterm1 hterm2
          have hsplit : (u : A) * ((v : A) - 1) + ((u : A) - 1) = ((u * v : Aˣ) : A) - 1 := by
            rw [Units.val_mul]
            ring
          rw [hsplit] at hadd
          rcases hadd with h0 | hle
          · exact Or.inl (sub_eq_zero.mp h0)
          · exact Or.inr hle
        inv_mem' := by
          intro u hu
          change ((u⁻¹ : Aˣ) : A) = 1 ∨ (a : ℤ) ≤ valL F A (((u⁻¹ : Aˣ) : A) - 1)
          have hu0 : valL F A (u : A) = 0 := hgen_val0 a ha u hu
          have hu_inv0 : valL F A ((u⁻¹ : Aˣ) : A) = 0 := by
            rw [hval_inv u, hu0, neg_zero]
          have hinv_split : (((u⁻¹ : Aˣ) : A) - 1) = - (((u⁻¹ : Aˣ) : A) * ((u : A) - 1)) := by
            have hmul : ((u⁻¹ : Aˣ) : A) * (u : A) = 1 := Units.inv_mul u
            linear_combination hmul
          by_cases hsub : (u : A) - 1 = 0
          · left
            apply sub_eq_zero.mp
            rw [hinv_split, hsub, mul_zero, neg_zero]
          · right
            have hu1 : (u : A) ≠ 1 := sub_ne_zero.mp hsub
            have hua : (a : ℤ) ≤ valL F A ((u : A) - 1) := hu.resolve_left hu1
            rw [hinv_split, hval_neg,
              hval_mul ((u⁻¹ : Aˣ) : A) ((u : A) - 1) (Units.ne_zero u⁻¹) hsub,
              hu_inv0, zero_add]
            exact hua
      }
      have hcl_le : unitGroup F A a ≤ Ha := by
        unfold unitGroup
        rw [Subgroup.closure_le]
        intro u hu
        simpa [Ha, ha0] using hu
      have hle_cl : Ha ≤ unitGroup F A a := by
        intro u hu
        unfold unitGroup
        apply Subgroup.subset_closure
        simpa [Ha, ha0] using hu
      intro u
      exact ⟨fun hu => hcl_le hu, fun hu => hle_cl hu⟩
    have hunit_val0 : ∀ (a : ℕ) (u : Aˣ), u ∈ unitGroup F A a → valL F A (u : A) = 0 := by
      intro a u hu
      by_cases ha : a = 0
      · rw [ha] at hu
        exact (hunit0 u).mp hu
      · have ha1 : 1 ≤ a := Nat.one_le_iff_ne_zero.mpr ha
        exact hgen_val0 a ha1 u ((hunit_ge1 a ha1 u).mp hu)
    exact ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv,
      hval_add, hunit0, hunit_ge1, hunit_val0⟩

  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_add,
      hmem_u0, hmem_ua, hval_u0⟩ := hvalA_props

  set B' := IntermediateField.extendScalars hAB
  haveI : FiniteDimensional F B' := by
    change FiniteDimensional F B
    infer_instance
  haveI : FiniteDimensional A B' := FiniteDimensional.right F A B'
  have hnorm_zero : normLM F hAB 0 = 0 := by
    change Algebra.norm A (toExtendScalars F hAB 0) = 0
    rw [map_zero]
    exact Algebra.norm_zero

  
  have hunit_anti_A : ∀ {a b : ℕ}, a ≤ b → ∀ {u : Aˣ},
      u ∈ unitGroup F A b → u ∈ unitGroup F A a := by
    intro a b hab u hu
    rcases Nat.eq_zero_or_pos a with rfl | ha
    · exact (hmem_u0 u).mpr (hval_u0 b u hu)
    · have hb : 1 ≤ b := le_trans ha hab
      rw [hmem_ua a ha]
      rcases (hmem_ua b hb u).mp hu with hu1 | hub
      · exact Or.inl hu1
      · exact Or.inr (le_trans (by exact_mod_cast hab) hub)

  have hval_neg_ge_A : ∀ {k : ℤ} {x : A},
      (x = 0 ∨ k ≤ valL F A x) → (-x = 0 ∨ k ≤ valL F A (-x)) := by
    intro k x hx
    rcases hx with rfl | hx
    · simp
    · right
      rwa [hval_neg]

  have hval_sub_A : ∀ (k : ℤ) (x y : A),
      (x = 0 ∨ k ≤ valL F A x) → (y = 0 ∨ k ≤ valL F A y) →
        (x - y = 0 ∨ k ≤ valL F A (x - y)) := by
    intro k x y hx hy
    rw [sub_eq_add_neg]
    exact hval_add k x (-y) hx (hval_neg_ge_A hy)

  have hval_mul_ge_A : ∀ {k₁ k₂ : ℤ} {x y : A},
      (x = 0 ∨ k₁ ≤ valL F A x) → (y = 0 ∨ k₂ ≤ valL F A y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F A (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hval_mul x y hx0 hy0]
        have hx' := hx.resolve_left hx0
        have hy' := hy.resolve_left hy0
        omega

  have hval_pow_A : ∀ (u : Aˣ) (n : ℕ),
      valL F A ((u ^ n : Aˣ) : A) = (n : ℤ) * valL F A (u : A) := by
    intro u n
    induction n with
    | zero =>
      simp [hval1]
    | succ n ih =>
      rw [pow_succ, Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
      push_cast
      ring

  have hval_zpow_A : ∀ (u : Aˣ) (m : ℤ),
      valL F A ((u ^ m : Aˣ) : A) = m * valL F A (u : A) := by
    intro u m
    cases m with
    | ofNat n =>
      change valL F A ((u ^ (n : ℤ) : Aˣ) : A) = (n : ℤ) * valL F A (u : A)
      rw [zpow_natCast, hval_pow_A]
    | negSucc n =>
      rw [zpow_negSucc, hval_inv (u ^ (n + 1)), hval_pow_A u (n + 1), Int.negSucc_eq]
      push_cast
      ring

  set πA_t : A := ((ϖ_A ^ t : Aˣ) : A)
  set πB_t : B := ((ϖ_B ^ t : Bˣ) : B)
  have hπA_t_val : valL F A πA_t = (t : ℤ) := by
    dsimp only [πA_t]
    rw [hval_pow_A ϖ_A t, hϖ_A, mul_one]
  have hπA_t_inv_val : valL F A (((ϖ_A ^ t)⁻¹ : Aˣ) : A) = -(t : ℤ) := by
    rw [hval_inv (ϖ_A ^ t), hπA_t_val]
  have hπA_t_ge : πA_t = 0 ∨ (t : ℤ) ≤ valL F A πA_t :=
    Or.inr (le_of_eq hπA_t_val.symm)
  have hπA_t_ge0 : πA_t = 0 ∨ 0 ≤ valL F A πA_t :=
    Or.inr (by omega)
  have hπA_t_sq_ge : πA_t * πA_t = 0 ∨ ((t + 1 : ℕ) : ℤ) ≤ valL F A (πA_t * πA_t) := by
    rcases hval_mul_ge_A hπA_t_ge hπA_t_ge with h0 | hle
    · exact Or.inl h0
    · exact Or.inr (by omega)

  have h1_int_A : (1 : A) = 0 ∨ 0 ≤ valL F A (1 : A) :=
    Or.inr (le_of_eq hval1.symm)

  have hnat_val_A : ∀ n : ℕ, (n : A) = 0 ∨ 0 ≤ valL F A (n : A) := by
    intro n
    induction n with
    | zero =>
      left; simp
    | succ n ih =>
      rw [Nat.cast_succ]
      exact hval_add 0 (n : A) 1 ih h1_int_A

  have hpow_val_A : ∀ (s : A), (s = 0 ∨ 0 ≤ valL F A s) →
      ∀ n : ℕ, (s ^ n = 0 ∨ 0 ≤ valL F A (s ^ n)) := by
    intro s hs n
    induction n with
    | zero =>
      rw [pow_zero]
      exact h1_int_A
    | succ n ih =>
      rw [pow_succ]
      rcases hval_mul_ge_A ih hs with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)

  have hresA_sub : ∀ x₁ x₂ : A, (x₁ = 0 ∨ 0 ≤ valL F A x₁) → (x₂ = 0 ∨ 0 ≤ valL F A x₂) →
      resA (x₁ - x₂) = resA x₁ - resA x₂ := by
    intro x₁ x₂ hx₁ hx₂
    rw [sub_eq_add_neg, (hresA_ring x₁ (-x₂) hx₁ (hval_neg_ge_A hx₂)).1,
      (hresA_ring x₂ x₂ hx₂ hx₂).2.2, ← sub_eq_add_neg]

  have hresA_nat : ∀ n : ℕ, resA (n : A) = (n : k_A) := by
    intro n
    induction n with
    | zero =>
      simp [hresA_0]
    | succ n ih =>
      rw [Nat.cast_succ, (hresA_ring (n : A) 1 (hnat_val_A n) h1_int_A).1,
        ih, hresA_1, Nat.cast_succ]

  have hresA_pow : ∀ (s : A), (s = 0 ∨ 0 ≤ valL F A s) →
      ∀ n : ℕ, resA (s ^ n) = (resA s) ^ n := by
    intro s hs n
    induction n with
    | zero =>
      simp [hresA_1]
    | succ n ih =>
      rw [pow_succ, (hresA_ring (s ^ n) s (hpow_val_A s hs n) hs).2.1, ih, pow_succ]

  have hmk_unit_A : ∀ (m : ℕ), 1 ≤ m → ∀ z : A, (z = 0 ∨ (m : ℤ) ≤ valL F A z) →
      ∃ u : Aˣ, (u : A) = 1 + z ∧ u ∈ unitGroup F A m := by
    intro m hm z hz
    have h1z : 1 + z ≠ 0 := by
      intro h0
      have hz_eq : z = -1 := eq_neg_of_add_eq_zero_right h0
      have hz_ne0 : z ≠ 0 := by
        rw [hz_eq]
        exact neg_ne_zero.mpr one_ne_zero
      have hge : (m : ℤ) ≤ valL F A z := hz.resolve_left hz_ne0
      rw [hz_eq, hval_neg1] at hge
      omega
    let u : Aˣ := Units.mk0 (1 + z) h1z
    refine ⟨u, rfl, (hmem_ua m hm u).mpr ?_⟩
    have hsub : (u : A) - 1 = z := by
      change (1 + z) - 1 = z
      ring
    rw [hsub]
    rcases hz with rfl | hz
    · left
      change 1 + (0 : A) = 1
      ring
    · exact Or.inr hz

  have hcong_to_unit_A : ∀ (m : ℕ), 1 ≤ m → ∀ u₁ u₂ : Aˣ,
      valL F A (u₂ : A) = 0 →
      ((u₁ : A) - (u₂ : A) = 0 ∨ (m : ℤ) ≤ valL F A ((u₁ : A) - (u₂ : A))) →
      u₁ * u₂⁻¹ ∈ unitGroup F A m := by
    intro m hm u₁ u₂ hu₂_val hdiff
    rw [hmem_ua m hm (u₁ * u₂⁻¹)]
    have hsub : ((u₁ * u₂⁻¹ : Aˣ) : A) - 1 =
        ((u₁ : A) - (u₂ : A)) * ((u₂⁻¹ : Aˣ) : A) := by
      calc ((u₁ * u₂⁻¹ : Aˣ) : A) - 1
        _ = (u₁ : A) * ((u₂⁻¹ : Aˣ) : A) - (u₂ : A) * ((u₂⁻¹ : Aˣ) : A) := by
          rw [Units.val_mul, Units.mul_inv]
        _ = ((u₁ : A) - (u₂ : A)) * ((u₂⁻¹ : Aˣ) : A) := by ring
    have hu₂_inv_val : valL F A ((u₂⁻¹ : Aˣ) : A) = 0 := by
      rw [hval_inv u₂, hu₂_val, neg_zero]
    have hprod := hval_mul_ge_A hdiff (Or.inr (le_of_eq hu₂_inv_val.symm))
    rw [add_zero, ← hsub] at hprod
    rcases hprod with h0 | hle
    · exact Or.inl (sub_eq_zero.mp h0)
    · exact Or.inr hle

  
  have h_conj1 : ∃ m₁ : ℕ, 1 ≤ m₁ ∧
      ∀ w ∈ unitGroup F B m₁,
        Units.map (normLM F hAB) w ∈ unitGroup F A m_cut := by
    let r : ℕ := t + m_cut
    let m₁ : ℕ := t + 1 + (p F) * (r - t)
    refine ⟨m₁, by omega, ?_⟩
    intro w hw
    have h_in_r1 := hnorm_gt_le r (by omega) w hw
    exact hunit_anti_A (by omega : m_cut ≤ r + 1) h_in_r1

  
  let N : Bˣ →* Aˣ := Units.map (normLM F hAB)
  have h_below_t : ∀ m : ℕ, m ≤ t → ∀ u ∈ unitGroup F A 0,
      ∃ w₁ : Bˣ, u * (N w₁)⁻¹ ∈ unitGroup F A m := by
    intro m
    induction m with
    | zero =>
      intro _ u hu
      refine ⟨1, ?_⟩
      simpa using hu
    | succ m ih =>
      intro hm_le u hu
      obtain ⟨w₁, hw₁⟩ := ih (by omega) u hu
      set u_m : Aˣ := u * (N w₁)⁻¹
      obtain ⟨w', _, hw'⟩ := hnorm_surj_lt m (by omega) u_m hw₁
      refine ⟨w₁ * w', ?_⟩
      have h_inv : (N w' * u_m⁻¹)⁻¹ ∈ unitGroup F A (m + 1) :=
        (unitGroup F A (m + 1)).inv_mem hw'
      have h_eq : (N w' * u_m⁻¹)⁻¹ = u * (N (w₁ * w'))⁻¹ := by
        dsimp only [u_m]
        rw [map_mul, mul_inv_rev, inv_inv, mul_assoc, ← mul_inv]
      rwa [← h_eq]

  have h_above_t1 : ∀ k : ℕ, ∀ u ∈ unitGroup F A (t + 1),
      ∃ w₂ : Bˣ, u * (N w₂)⁻¹ ∈ unitGroup F A (t + 1 + k) := by
    intro k
    induction k with
    | zero =>
      intro u hu
      refine ⟨1, ?_⟩
      simpa using hu
    | succ k ih =>
      intro u hu
      obtain ⟨w₂, hw₂⟩ := ih u hu
      set u_k : Aˣ := u * (N w₂)⁻¹
      obtain ⟨w', _, hw'⟩ := hnorm_gt_surj (t + 1 + k) (by omega) u_k hw₂
      refine ⟨w₂ * w', ?_⟩
      have h_inv : (N w' * u_k⁻¹)⁻¹ ∈ unitGroup F A (t + 1 + (k + 1)) := by
        simpa [Nat.add_assoc] using (unitGroup F A (t + 1 + k + 1)).inv_mem hw'
      have h_eq : (N w' * u_k⁻¹)⁻¹ = u * (N (w₂ * w'))⁻¹ := by
        dsimp only [u_k]
        rw [map_mul, mul_inv_rev, inv_inv, mul_assoc, ← mul_inv]
      rwa [← h_eq]

  
  let b₀ : k_A := resA b_tr
  obtain ⟨a₁, ha₁⟩ := hAS_coker b₀
  obtain ⟨x₁, hx₁_val, hx₁_res⟩ := hresA_surj a₁
  have hx₁_π_val : x₁ * πA_t = 0 ∨ (t : ℤ) ≤ valL F A (x₁ * πA_t) := by
    rcases hval_mul_ge_A hx₁_val hπA_t_ge with h0 | hle
    · exact Or.inl h0
    · exact Or.inr (by omega)
  obtain ⟨g₀, hg₀_val, hg₀_mem⟩ := hmk_unit_A t ht_ge1 (x₁ * πA_t) hx₁_π_val
  have hg₀_val0 : valL F A (g₀ : A) = 0 := hval_u0 t g₀ hg₀_mem
  have hg₀_pow_mem : ∀ n : ℕ, g₀ ^ n ∈ unitGroup F A t :=
    fun n => (unitGroup F A t).pow_mem hg₀_mem n
  have hg₀_pow_val0 : ∀ n : ℕ, valL F A ((g₀ ^ n : Aˣ) : A) = 0 :=
    fun n => hval_u0 t (g₀ ^ n) (hg₀_pow_mem n)

  have hg₀_pow : ∀ n : ℕ,
      ((g₀ ^ n : Aˣ) : A) - (1 + (n : A) * x₁ * πA_t) = 0 ∨
        ((t + 1 : ℕ) : ℤ) ≤ valL F A (((g₀ ^ n : Aˣ) : A) - (1 + (n : A) * x₁ * πA_t)) := by
    intro n
    induction n with
    | zero =>
      left
      simp
    | succ n ih =>
      set D_n : A := ((g₀ ^ n : Aˣ) : A) - (1 + (n : A) * x₁ * πA_t)
      have h_id : ((g₀ ^ (n + 1) : Aˣ) : A) - (1 + ((n + 1 : ℕ) : A) * x₁ * πA_t) =
          D_n * (g₀ : A) + ((n : A) * x₁ * x₁) * (πA_t * πA_t) := by
        dsimp only [D_n]
        rw [pow_succ, Units.val_mul, hg₀_val]
        push_cast
        ring
      rw [h_id]
      have hterm1 : D_n * (g₀ : A) = 0 ∨ ((t + 1 : ℕ) : ℤ) ≤ valL F A (D_n * (g₀ : A)) := by
        rcases hval_mul_ge_A ih (Or.inr (le_of_eq hg₀_val0.symm)) with h0 | hle
        · exact Or.inl h0
        · exact Or.inr (by omega)
      have hnx₁ : (n : A) * x₁ = 0 ∨ 0 ≤ valL F A ((n : A) * x₁) := by
        rcases hval_mul_ge_A (hnat_val_A n) hx₁_val with h0 | hle
        · exact Or.inl h0
        · exact Or.inr (by omega)
      have hnx₁_sq : (n : A) * x₁ * x₁ = 0 ∨ 0 ≤ valL F A ((n : A) * x₁ * x₁) := by
        rcases hval_mul_ge_A hnx₁ hx₁_val with h0 | hle
        · exact Or.inl h0
        · exact Or.inr (by omega)
      have hterm2 : ((n : A) * x₁ * x₁) * (πA_t * πA_t) = 0 ∨
          ((t + 1 : ℕ) : ℤ) ≤ valL F A (((n : A) * x₁ * x₁) * (πA_t * πA_t)) := by
        rcases hval_mul_ge_A hnx₁_sq hπA_t_sq_ge with h0 | hle
        · exact Or.inl h0
        · exact Or.inr (by omega)
      exact hval_add ((t + 1 : ℕ) : ℤ) _ _ hterm1 hterm2

  have hprod_approx : ∀ (n : ℕ) (s : A), (s = 0 ∨ 0 ≤ valL F A s) →
      ∃ w_s : Bˣ,
        N w_s ∈ unitGroup F A t ∧
        (((g₀ ^ n * N w_s : Aˣ) : A) - (1 + ((n : A) * x₁ + (s ^ (p F) + b_tr * s)) * πA_t) = 0 ∨
          ((t + 1 : ℕ) : ℤ) ≤ valL F A
            (((g₀ ^ n * N w_s : Aˣ) : A) - (1 + ((n : A) * x₁ + (s ^ (p F) + b_tr * s)) * πA_t))) := by
    intro n s hs
    set Q_s : A := s ^ (p F) + b_tr * s
    set y_s : B := 1 + IntermediateField.inclusion hAB s * πB_t
    have hbs : b_tr * s = 0 ∨ 0 ≤ valL F A (b_tr * s) := by
      rcases hval_mul_ge_A hb_tr_val hs with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hQ_s_val : Q_s = 0 ∨ 0 ≤ valL F A Q_s :=
      hval_add 0 (s ^ (p F)) (b_tr * s) (hpow_val_A s hs (p F)) hbs
    set R_s : A := normLM F hAB y_s - (1 + Q_s * πA_t)
    have hR_s_val : R_s = 0 ∨ ((t + 1 : ℕ) : ℤ) ≤ valL F A R_s :=
      hP_norm_t s hs
    have hQπ_val : Q_s * πA_t = 0 ∨ (t : ℤ) ≤ valL F A (Q_s * πA_t) := by
      rcases hval_mul_ge_A hQ_s_val hπA_t_ge with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hQR_val : Q_s * πA_t + R_s = 0 ∨ (t : ℤ) ≤ valL F A (Q_s * πA_t + R_s) := by
      have hR_t : R_s = 0 ∨ (t : ℤ) ≤ valL F A R_s := by
        rcases hR_s_val with h0 | hle
        · exact Or.inl h0
        · exact Or.inr (by omega)
      exact hval_add (t : ℤ) (Q_s * πA_t) R_s hQπ_val hR_t
    obtain ⟨u_Ns, hu_Ns_val, hu_Ns_mem⟩ := hmk_unit_A t ht_ge1 (Q_s * πA_t + R_s) hQR_val
    have hnorm_ys_eq : normLM F hAB y_s = (u_Ns : A) := by
      rw [hu_Ns_val]
      dsimp only [R_s]
      ring
    have hy_s_ne0 : y_s ≠ 0 := by
      intro h0
      have hnorm0 : normLM F hAB y_s = 0 := by
        rw [h0, hnorm_zero]
      rw [hnorm_ys_eq] at hnorm0
      exact Units.ne_zero u_Ns hnorm0
    let w_s : Bˣ := Units.mk0 y_s hy_s_ne0
    have hN_ws_coe : ((N w_s : Aˣ) : A) = normLM F hAB y_s := rfl
    have hN_ws_eq : N w_s = u_Ns := Units.ext (by rw [hN_ws_coe, hnorm_ys_eq])
    have hN_ws_mem : N w_s ∈ unitGroup F A t := by
      rwa [hN_ws_eq]
    have hN_ws_val0 : valL F A ((N w_s : Aˣ) : A) = 0 := hval_u0 t (N w_s) hN_ws_mem
    refine ⟨w_s, hN_ws_mem, ?_⟩
    set D_n : A := ((g₀ ^ n : Aˣ) : A) - (1 + (n : A) * x₁ * πA_t)
    have h_id : ((g₀ ^ n * N w_s : Aˣ) : A) - (1 + ((n : A) * x₁ + Q_s) * πA_t) =
        D_n * ((N w_s : Aˣ) : A) + (1 + (n : A) * x₁ * πA_t) * R_s +
          ((n : A) * x₁ * Q_s) * (πA_t * πA_t) := by
      dsimp only [D_n, R_s]
      rw [Units.val_mul, hN_ws_coe]
      ring
    rw [h_id]
    have hterm1 : D_n * ((N w_s : Aˣ) : A) = 0 ∨
        ((t + 1 : ℕ) : ℤ) ≤ valL F A (D_n * ((N w_s : Aˣ) : A)) := by
      dsimp only [D_n]
      rcases hval_mul_ge_A (hg₀_pow n) (Or.inr (le_of_eq hN_ws_val0.symm)) with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hnx₁ : (n : A) * x₁ = 0 ∨ 0 ≤ valL F A ((n : A) * x₁) := by
      rcases hval_mul_ge_A (hnat_val_A n) hx₁_val with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hnx₁π : (n : A) * x₁ * πA_t = 0 ∨ 0 ≤ valL F A ((n : A) * x₁ * πA_t) := by
      rcases hval_mul_ge_A hnx₁ hπA_t_ge0 with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have h1nx₁π : 1 + (n : A) * x₁ * πA_t = 0 ∨ 0 ≤ valL F A (1 + (n : A) * x₁ * πA_t) :=
      hval_add 0 1 ((n : A) * x₁ * πA_t) h1_int_A hnx₁π
    have hterm2 : (1 + (n : A) * x₁ * πA_t) * R_s = 0 ∨
        ((t + 1 : ℕ) : ℤ) ≤ valL F A ((1 + (n : A) * x₁ * πA_t) * R_s) := by
      rcases hval_mul_ge_A h1nx₁π hR_s_val with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hnx₁Q : (n : A) * x₁ * Q_s = 0 ∨ 0 ≤ valL F A ((n : A) * x₁ * Q_s) := by
      rcases hval_mul_ge_A hnx₁ hQ_s_val with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hterm3 : ((n : A) * x₁ * Q_s) * (πA_t * πA_t) = 0 ∨
        ((t + 1 : ℕ) : ℤ) ≤ valL F A (((n : A) * x₁ * Q_s) * (πA_t * πA_t)) := by
      rcases hval_mul_ge_A hnx₁Q hπA_t_sq_ge with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    exact hval_add ((t + 1 : ℕ) : ℤ) _ _
      (hval_add ((t + 1 : ℕ) : ℤ) _ _ hterm1 hterm2) hterm3

  have h_level_t : ∀ u_t ∈ unitGroup F A t,
      ∃ (e₀ : Fin (p F)) (w_s : Bˣ),
        u_t * (g₀ ^ (e₀ : ℕ) * N w_s)⁻¹ ∈ unitGroup F A (t + 1) := by
    intro u_t hu_t
    have hu_t_sub : (u_t : A) - 1 = 0 ∨ (t : ℤ) ≤ valL F A ((u_t : A) - 1) := by
      rcases (hmem_ua t ht_ge1 u_t).mp hu_t with hu1 | hle
      · exact Or.inl (sub_eq_zero.mpr hu1)
      · exact Or.inr hle
    set z_t : A := ((u_t : A) - 1) * (((ϖ_A ^ t)⁻¹ : Aˣ) : A)
    have hz_t_val : z_t = 0 ∨ 0 ≤ valL F A z_t := by
      dsimp only [z_t]
      rcases hval_mul_ge_A hu_t_sub (Or.inr (le_of_eq hπA_t_inv_val.symm)) with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hu_t_decomp : (u_t : A) = 1 + z_t * πA_t := by
      dsimp only [z_t, πA_t]
      rw [mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, mul_one, add_sub_cancel]
    obtain ⟨e₀, a, hc_eq⟩ := ha₁ (resA z_t)
    obtain ⟨s, hs_val, hs_res⟩ := hresA_surj a
    obtain ⟨w_s, hw_s_mem, h_approx⟩ := hprod_approx (e₀ : ℕ) s hs_val
    refine ⟨e₀, w_s, ?_⟩
    set Q_s : A := s ^ (p F) + b_tr * s
    have hbs : b_tr * s = 0 ∨ 0 ≤ valL F A (b_tr * s) := by
      rcases hval_mul_ge_A hb_tr_val hs_val with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hQ_s_val : Q_s = 0 ∨ 0 ≤ valL F A Q_s :=
      hval_add 0 (s ^ (p F)) (b_tr * s) (hpow_val_A s hs_val (p F)) hbs
    have he₀x₁_val : ((e₀ : ℕ) : A) * x₁ = 0 ∨ 0 ≤ valL F A (((e₀ : ℕ) : A) * x₁) := by
      rcases hval_mul_ge_A (hnat_val_A (e₀ : ℕ)) hx₁_val with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hsum_val : ((e₀ : ℕ) : A) * x₁ + Q_s = 0 ∨ 0 ≤ valL F A (((e₀ : ℕ) : A) * x₁ + Q_s) :=
      hval_add 0 (((e₀ : ℕ) : A) * x₁) Q_s he₀x₁_val hQ_s_val
    set δ : A := z_t - (((e₀ : ℕ) : A) * x₁ + Q_s)
    have hδ_int : δ = 0 ∨ 0 ≤ valL F A δ := hval_sub_A 0 z_t _ hz_t_val hsum_val
    have hδ_res : resA δ = 0 := by
      dsimp only [δ, Q_s]
      rw [hresA_sub z_t _ hz_t_val hsum_val,
        (hresA_ring (((e₀ : ℕ) : A) * x₁) (s ^ (p F) + b_tr * s) he₀x₁_val hQ_s_val).1,
        (hresA_ring ((e₀ : ℕ) : A) x₁ (hnat_val_A (e₀ : ℕ)) hx₁_val).2.1,
        (hresA_ring (s ^ (p F)) (b_tr * s) (hpow_val_A s hs_val (p F)) hbs).1,
        (hresA_ring b_tr s hb_tr_val hs_val).2.1,
        hresA_nat (e₀ : ℕ), hx₁_res, hresA_pow s hs_val (p F), hs_res]
      exact sub_eq_zero.mpr hc_eq
    have hδ_val1 : δ = 0 ∨ 1 ≤ valL F A δ := (hresA_ker δ hδ_int).mp hδ_res
    have hδπ_val : δ * πA_t = 0 ∨ ((t + 1 : ℕ) : ℤ) ≤ valL F A (δ * πA_t) := by
      rcases hval_mul_ge_A hδ_val1 hπA_t_ge with h0 | hle
      · exact Or.inl h0
      · exact Or.inr (by omega)
    have hu_t_approx : (u_t : A) - (1 + (((e₀ : ℕ) : A) * x₁ + Q_s) * πA_t) = 0 ∨
        ((t + 1 : ℕ) : ℤ) ≤ valL F A ((u_t : A) - (1 + (((e₀ : ℕ) : A) * x₁ + Q_s) * πA_t)) := by
      have hid : (u_t : A) - (1 + (((e₀ : ℕ) : A) * x₁ + Q_s) * πA_t) = δ * πA_t := by
        rw [hu_t_decomp]
        dsimp only [δ]
        ring
      rwa [hid]
    have hdiff_u : (u_t : A) - ((g₀ ^ (e₀ : ℕ) * N w_s : Aˣ) : A) = 0 ∨
        ((t + 1 : ℕ) : ℤ) ≤ valL F A ((u_t : A) - ((g₀ ^ (e₀ : ℕ) * N w_s : Aˣ) : A)) := by
      have hid : (u_t : A) - ((g₀ ^ (e₀ : ℕ) * N w_s : Aˣ) : A) =
          ((u_t : A) - (1 + (((e₀ : ℕ) : A) * x₁ + Q_s) * πA_t)) -
            (((g₀ ^ (e₀ : ℕ) * N w_s : Aˣ) : A) - (1 + (((e₀ : ℕ) : A) * x₁ + Q_s) * πA_t)) := by
        ring
      rw [hid]
      exact hval_sub_A ((t + 1 : ℕ) : ℤ) _ _ hu_t_approx h_approx
    have hprod_mem_t : g₀ ^ (e₀ : ℕ) * N w_s ∈ unitGroup F A t :=
      (unitGroup F A t).mul_mem (hg₀_pow_mem (e₀ : ℕ)) hw_s_mem
    have hprod_val0 : valL F A ((g₀ ^ (e₀ : ℕ) * N w_s : Aˣ) : A) = 0 :=
      hval_u0 t _ hprod_mem_t
    exact hcong_to_unit_A (t + 1) (by omega) u_t (g₀ ^ (e₀ : ℕ) * N w_s) hprod_val0 hdiff_u

  
  refine ⟨h_conj1, ⟨g₀, fun x => ?_⟩⟩
  set v : ℤ := valL F A (x : A)
  set u₀ : Aˣ := x * (ϖ_A ^ v)⁻¹
  have hu₀_mem : u₀ ∈ unitGroup F A 0 := by
    rw [hmem_u0 u₀]
    dsimp only [u₀]
    rw [Units.val_mul, hval_mul _ _ (Units.ne_zero x) (Units.ne_zero _),
      hval_inv (ϖ_A ^ v), hval_zpow_A ϖ_A v, hϖ_A, mul_one]
    change v + -v = 0
    omega
  obtain ⟨w₁, hu_t⟩ := h_below_t t le_rfl u₀ hu₀_mem
  set u_t : Aˣ := u₀ * (N w₁)⁻¹
  obtain ⟨e₀, w_s, hu_t1⟩ := h_level_t u_t hu_t
  set u_t1 : Aˣ := u_t * (g₀ ^ (e₀ : ℕ) * N w_s)⁻¹
  obtain ⟨w₂, hu_final⟩ := h_above_t1 m_cut u_t1 hu_t1
  set u_final : Aˣ := u_t1 * (N w₂)⁻¹
  let w : Bˣ := ϖ_B ^ v * w₁ * w_s * w₂
  refine ⟨e₀, w, ?_⟩
  have hN_zpow : N (ϖ_B ^ v) = ϖ_A ^ v := by
    dsimp only [N]
    rw [map_zpow, hϖ_norm]
  have h_eq : x * (g₀ ^ (e₀ : ℕ) * N w)⁻¹ = u_final := by
    dsimp only [u_final, u_t1, u_t, u₀, w]
    rw [map_mul, map_mul, map_mul, hN_zpow]
    simp only [mul_inv]
    apply Units.ext
    simp only [Units.val_mul]
    ring
  change x * (g₀ ^ (e₀ : ℕ) * N w)⁻¹ ∈ unitGroup F A m_cut
  rw [h_eq]
  exact hunit_anti_A (by omega : m_cut ≤ t + 1 + m_cut) hu_final

theorem ld_ch14_wild_central_p_subfield_step (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M_C K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hM_CK : M_C ≤ K) (hGalMCK : IsGaloisExt F M_C K)
    (hp_prime : Nat.Prime (p F))
    (r : ℕ) (hr_pos : 1 ≤ r)
    (hq_eq : Module.finrank M_C (IntermediateField.extendScalars hM_CK) = (p F) ^ (r + 1))
    (hValNormK : ∀ w : K, valL F M_C (normLM F hM_CK w) = valL F K w)
    (hGalTower : ∀ (M_1 : IntermediateField F (AlgebraicClosure F))
      (h1 : M_C ≤ M_1) (h2 : M_1 ≤ K),
      IsGaloisExt F M_C K → IsGaloisExt F M_1 K) :
    ∃ (M_1 : IntermediateField F (AlgebraicClosure F)) (_ : FiniteDimensional F M_1)
      (hMC_M1 : M_C ≤ M_1) (hM1_K : M_1 ≤ K),
      IsGaloisExt F M_C M_1 ∧
      IsGaloisExt F M_1 K ∧
      Module.finrank M_1 (IntermediateField.extendScalars hM1_K) = p F ∧
      Module.finrank M_C (IntermediateField.extendScalars hMC_M1) = (p F) ^ r ∧
      (∀ w : K, normLM F hM_CK w = normLM F hMC_M1 (normLM F hM1_K w)) ∧
      (∀ w : K, valL F M_1 (normLM F hM1_K w) = valL F K w) ∧
      (∀ z : M_1,
        valL F K (IntermediateField.inclusion hM1_K z) =
          (Module.finrank M_1 (IntermediateField.extendScalars hM1_K) : ℤ) * valL F M_1 z) ∧
      (∀ w : M_1, valL F M_C (normLM F hMC_M1 w) = valL F M_1 w) ∧
      (∀ z : M_C,
        valL F M_1 (IntermediateField.inclusion hMC_M1 z) =
          (Module.finrank M_C (IntermediateField.extendScalars hMC_M1) : ℤ) * valL F M_C z) :=
by
  
  have h_isGalois_of_norm : ∀ (k Ω_bar : Type u) [Field k] [Field Ω_bar]
      [Algebra k Ω_bar] [Normal k Ω_bar]
      (K' : IntermediateField k Ω_bar) [Algebra.IsSeparable k K'],
      (∀ σ : Ω_bar ≃ₐ[k] Ω_bar, ∀ τ ∈ K'.fixingSubgroup, σ * τ * σ⁻¹ ∈ K'.fixingSubgroup) →
      IsGalois k K' := by
    intro k Ω_bar _ _ _ _ K' _ h_norm
    let N : IntermediateField k Ω_bar := separableClosure k Ω_bar
    haveI : IsGalois k N := separableClosure.isGalois k Ω_bar
    haveI : Normal k N := IsGalois.to_normal
    have hK'N : K' ≤ N := by
      intro z hz
      rw [mem_separableClosure_iff]
      let x : K' := ⟨z, hz⟩
      have hx : IsSeparable k x := Algebra.IsSeparable.isSeparable k x
      change (minpoly k (K'.val x)).Separable
      rw [minpoly.algHom_eq K'.val K'.val.injective x]
      exact hx
    let K_N : IntermediateField k N := K'.comap N.val
    have hmap_KN : K_N.map N.val = K' := by
      have hrange : N.val.fieldRange = N := by
        ext z
        exact ⟨fun ⟨y, hy⟩ => hy ▸ y.2, fun hz => ⟨⟨z, hz⟩, rfl⟩⟩
      rw [IntermediateField.map_comap_eq, hrange, inf_of_le_left hK'N]
    let e_KN : ↥K_N ≃ₐ[k] ↥K' :=
      (K_N.equivMap N.val).trans (IntermediateField.equivOfEq hmap_KN)
    haveI : K_N.fixingSubgroup.Normal := by
      refine ⟨fun sbar hsbar tbar => ?_⟩
      obtain ⟨τ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar tbar
      obtain ⟨σ, rfl⟩ := AlgEquiv.restrictNormalHom_surjective Ω_bar sbar
      rw [IntermediateField.mem_fixingSubgroup_iff] at hsbar ⊢
      intro y hy
      have hσK' : σ ∈ K'.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro z hz
        have hzN : z ∈ N := hK'N hz
