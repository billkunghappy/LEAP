        rw [← pow_succ', Nat.sub_add_cancel hq_pos]
      have hprod_eq :
          (c'_χ' ^ q) *
            (c'_χ' * (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_θ i)))⁻¹ =
            ∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (u_θ i) := by
        rw [hprod_θ, ← mul_assoc, hq_pow_eq, mul_inv_rev, inv_inv,
          mul_comm (c'_χ' ^ q), inv_mul_cancel_right]
      rw [hprod_eq]
      refine Subgroup.prod_mem _ fun i _ => ?_
      have hu_mem : u_θ i ∈ unitGroup F (D_orb.get i).field (k * (1 - 1) + 1) := by
        simpa using (hu_θ_exists i).2
      exact hNormFilt i 1 le_rfl (u_θ i) hu_mem

theorem ld_ch14_higher_cond_twisted_orbit_stationary_elements (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hGalMC : IsGaloisExt F L M_C)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (hSepLFi : ∀ i : Fin D_orb.length,
      Algebra.IsSeparable L (IntermediateField.extendScalars (D_orb.get i).le))
    (hψFi : ∀ i : Fin D_orb.length,
      IsAdmissibleChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ))
    (hLtFi : ∀ i : Fin D_orb.length, L < (D_orb.get i).field)
    (hDegSum : (∑ i : Fin D_orb.length,
      Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le)) =
      Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1)
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (hχ'_cond : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1)
    (hθ_cond : ∀ i : Fin D_orb.length,
      ∀ u ∈ unitGroup F (D_orb.get i).field
          (condExp F (D_orb.get i).field
            (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))),
        (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) u = 1)
    (ν_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      (M_Cˣ →* (Ω F)ˣ))
    (σ_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      (M_C ≃ₐ[F] M_C))
    (idx_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      Fin D_orb.length)
    (hν_inj : Function.Injective ν_all)
    (hν_props : ∀ j,
      ν_all j ≠ 1 ∧
      (ν_all j) ^ (p F) = 1 ∧
      (∀ x : L, (σ_all j) (IntermediateField.inclusion hLM_C x) =
        IntermediateField.inclusion hLM_C x) ∧
      (∀ z : M_C, valL F M_C ((σ_all j) z) = valL F M_C z) ∧
      (∀ z : M_C, traceLM F hLM_C ((σ_all j) z) = traceLM F hLM_C z) ∧
      (∀ w : M_Cˣ, w ∈ Set.range (Units.map (normLM F hM_CK)) → (ν_all j) w = 1) ∧
      ∀ w : M_Cˣ,
        (ν_all j) w =
          ((μ'_orb (idx_all j)).comp (Units.map (normLM F (hFiMC (idx_all j)))))
            (Units.map (σ_all j).toRingEquiv.toMonoidHom w))
    (hν_prod : ∀ (c_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ),
      ∏ j : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1),
        Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
          (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
            (c_orb (idx_all j))) =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
          (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c_orb i)))
    (t k : ℕ) (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k)
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hTrBoundMCL : ∀ (m : ℤ) (z : M_C),
      (z = 0 ∨ (k : ℤ) * m - ((k : ℤ) - 1) ≤ valL F M_C z) →
      (traceLM F hLM_C z = 0 ∨ m ≤ valL F L (traceLM F hLM_C z)))
    (hnMC : condExpChar F M_C (traceChar F hLM_C ψ) =
      (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1))
    (hFi_ram : ∀ i : Fin D_orb.length,
      condExp F (D_orb.get i).field (μ'_orb i) = t + 1 ∧
      condExp F M_C ((μ'_orb i).comp (Units.map (normLM F (hFiMC i)))) = t + 1 ∧
      (∀ x : (D_orb.get i).field,
        valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
          valL F (D_orb.get i).field x) ∧
      (∀ z : M_C,
        valL F (D_orb.get i).field (normLM F (hFiMC i) z) =
          (Module.finrank (D_orb.get i).field (IntermediateField.extendScalars (hFiMC i)) : ℤ) *
            valL F M_C z) ∧
      (∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
        (traceLM F (hFiMC i) z = 0 ∨ m ≤ valL F (D_orb.get i).field (traceLM F (hFiMC i) z))) ∧
      (∀ z : M_C, (z = 0 ∨ 1 ≤ valL F M_C z) →
        normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z) = 0 ∨
          2 * valL F M_C z ≤
            valL F (D_orb.get i).field
              (normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z))) ∧
      condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) =
        (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1) ∧
      ∃ f_i : ℕ,
        1 ≤ f_i ∧
        Module.finrank L (IntermediateField.extendScalars (D_orb.get i).le) = k * f_i ∧
        resDeg F (D_orb.get i).field = f_i * resDeg F L ∧
        (∀ x : (D_orb.get i).field,
          valL F L (normLM F (D_orb.get i).le x) =
            (f_i : ℤ) * valL F (D_orb.get i).field x))
    (ϖ_MC : M_Cˣ) (ϖ_L : Lˣ)
    (hϖ_valMC : valL F M_C (ϖ_MC : M_C) = 1)
    (hϖ_valL : valL F L (ϖ_L : L) = 1)
    (c'_χ' : Lˣ)
    (c'_μ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ)
    (hc_L_val : valL F L (c'_χ' : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hc_L_top : ∀ x : L, (x = 0 ∨ ((condExp F L χ' - 1 : ℕ) : ℤ) ≤ valL F L x) →
      ∀ hx : 1 + x ≠ 0,
        (χ' (Units.mk0 (1 + x) hx) : Ω F) = ψ (((c'_χ'⁻¹ : Lˣ) : L) * x))
    (hc_μ_props : ∀ i : Fin D_orb.length,
      let F_i := (D_orb.get i).field
      let ψ_Fi := traceChar F (D_orb.get i).le ψ
      2 ≤ condExp F F_i (μ'_orb i) ∧
      valL F F_i (c'_μ i : F_i) =
        (condExp F F_i (μ'_orb i) : ℤ) + condExpChar F F_i ψ_Fi ∧
      valL F F_i (c'_μ i : F_i) = (k : ℤ) * (1 + condExpChar F L ψ) + (t : ℤ) ∧
      (∀ x : F_i, (x = 0 ∨ ((condExp F F_i (μ'_orb i) - 1 : ℕ) : ℤ) ≤ valL F F_i x) →
        ∀ hx : 1 + x ≠ 0,
          (μ'_orb i (Units.mk0 (1 + x) hx) : Ω F) =
            ψ_Fi ((((c'_μ i)⁻¹ : F_iˣ) : F_i) * x)))
    (u_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) → M_Cˣ)
    (hu_all_def : ∀ j,
      u_all j =
        Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
          ((ϖ_L ^ (condExp F L χ' - 1))⁻¹ * c'_χ') *
          (ϖ_MC ^ t) *
          (Units.map (σ_all j).symm.toRingEquiv.toMonoidHom
            (Units.map (IntermediateField.inclusion (hFiMC (idx_all j))).toMonoidHom
              (c'_μ (idx_all j))))⁻¹)
    (hu_all_inj : ∀ j₁ j₂ : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1),
      ((u_all j₁ : M_C) - (u_all j₂ : M_C) = 0 ∨
        1 ≤ valL F M_C ((u_all j₁ : M_C) - (u_all j₂ : M_C))) →
      j₁ = j₂) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let a := condExp F L χ'
    let θ_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ :=
      fun i => μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))
    ∃ (c'_θ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ),
      (∀ i : Fin D_orb.length,
        let F_i := (D_orb.get i).field
        let ψ_Fi := traceChar F (D_orb.get i).le ψ
        2 ≤ condExp F F_i (μ'_orb i) ∧
        2 ≤ condExp F F_i (θ_orb i) ∧
        valL F F_i (c'_μ i : F_i) =
          (condExp F F_i (μ'_orb i) : ℤ) + condExpChar F F_i ψ_Fi ∧
        (∀ x : F_i, (x = 0 ∨ ((condExp F F_i (μ'_orb i) - 1 : ℕ) : ℤ) ≤ valL F F_i x) →
          ∀ hx : 1 + x ≠ 0,
            (μ'_orb i (Units.mk0 (1 + x) hx) : Ω F) =
              ψ_Fi ((((c'_μ i)⁻¹ : F_iˣ) : F_i) * x)) ∧
        valL F F_i (c'_θ i : F_i) =
          (condExp F F_i (θ_orb i) : ℤ) + condExpChar F F_i ψ_Fi ∧
        (∀ x : F_i, (x = 0 ∨ ((condExp F F_i (θ_orb i) - 1 : ℕ) : ℤ) ≤ valL F F_i x) →
          ∀ hx : 1 + x ≠ 0,
            (θ_orb i (Units.mk0 (1 + x) hx) : Ω F) =
              ψ_Fi ((((c'_θ i)⁻¹ : F_iˣ) : F_i) * x))) ∧
      (k * (a - 1) < t →
        (∀ i : Fin D_orb.length, condExp F (D_orb.get i).field (θ_orb i) = t + 1) ∧
        (∀ i : Fin D_orb.length, c'_θ i = c'_μ i)) ∧
      (t < k * (a - 1) →
        (∀ i : Fin D_orb.length,
          condExp F (D_orb.get i).field (θ_orb i) = k * (a - 1) + 1) ∧
        (c'_χ' ^ q) *
          (c'_χ' *
            (∏ i : Fin D_orb.length, Units.map (normLM F (D_orb.get i).le) (c'_θ i)))⁻¹ ∈
          unitGroup F L 1) ∧
      (k * (a - 1) = t →
        (∀ i : Fin D_orb.length, condExp F (D_orb.get i).field (θ_orb i) = t + 1) ∧
        ∃ (v_θ : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ),
          (∀ i : Fin D_orb.length,
            let F_i := (D_orb.get i).field
            let α_i : F_iˣ :=
              Units.map (IntermediateField.inclusion (D_orb.get i).le).toMonoidHom c'_χ' *
                (c'_μ i)⁻¹
            valL F F_i (v_θ i : F_i) = 0 ∧
            (v_θ i : F_i) = 1 + ((α_i⁻¹ : F_iˣ) : F_i) ∧
            c'_θ i = c'_μ i * (v_θ i)⁻¹)) :=
by
  have hσ_val : ∀ j (z : M_C), valL F M_C ((σ_all j) z) = valL F M_C z :=
    fun j => (hν_props j).2.2.2.1
  have hσ_props : ∀ j,
      (∀ x : L, (σ_all j) (IntermediateField.inclusion hLM_C x) =
        IntermediateField.inclusion hLM_C x) ∧
      (∀ z : M_C, valL F M_C ((σ_all j) z) = valL F M_C z) :=
    fun j => ⟨(hν_props j).2.2.1, (hν_props j).2.2.2.1⟩
  have hValAlgFiMC : ∀ i : Fin D_orb.length, ∀ x : (D_orb.get i).field,
      valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
        valL F (D_orb.get i).field x :=
    fun i => (hFi_ram i).2.2.1
  have hFi_ram_pull : ∀ i : Fin D_orb.length,
      (∀ x : (D_orb.get i).field,
        valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
          valL F (D_orb.get i).field x) ∧
      (∀ (m : ℤ) (z : M_C), (z = 0 ∨ m ≤ valL F M_C z) →
        (traceLM F (hFiMC i) z = 0 ∨ m ≤ valL F (D_orb.get i).field (traceLM F (hFiMC i) z))) ∧
      (∀ z : M_C, (z = 0 ∨ 1 ≤ valL F M_C z) →
        normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z) = 0 ∨
          2 * valL F M_C z ≤
            valL F (D_orb.get i).field
              (normLM F (hFiMC i) (1 + z) - (1 + traceLM F (hFiMC i) z))) ∧
      condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) =
        (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1) :=
    fun i => ⟨(hFi_ram i).2.2.1, (hFi_ram i).2.2.2.2.1, (hFi_ram i).2.2.2.2.2.1,
      (hFi_ram i).2.2.2.2.2.2.1⟩
  have hFi_ram_reg : ∀ i : Fin D_orb.length,
      condExp F (D_orb.get i).field (μ'_orb i) = t + 1 ∧
      (∀ x : (D_orb.get i).field,
        valL F M_C (IntermediateField.inclusion (hFiMC i) x) =
          valL F (D_orb.get i).field x) ∧
      condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) =
        (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1) :=
    fun i => ⟨(hFi_ram i).1, (hFi_ram i).2.2.1, (hFi_ram i).2.2.2.2.2.2.1⟩
  have hval_all := fun (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M] =>
    ld_valL_and_unitGroup_props F M
  have hSpec_all : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      (∀ x : M, (x = 0 ∨ -condExpChar F M ψ_M ≤ valL F M x) → ψ_M x = 1) ∧
      (∃ x₁ : M, x₁ ≠ 0 ∧ -(condExpChar F M ψ_M + 1) ≤ valL F M x₁ ∧ ψ_M x₁ ≠ 1) := by
    intro M _ ψ_M hψ_M
    have h := ld_condExp_and_condExpChar_spec F M ψ_M hψ_M 1
    exact ⟨h.1, h.2.1⟩
  obtain ⟨hTopCond_gen, hNormFilt⟩ :=
    ld_ch14_top_level_conductor_and_orbit_norm_filtration F L K M_C hLM_C hM_CK
      D_orb hFinFi hFiMC σ_all idx_all hσ_val hν_prod k hk_ge1 hValAlgMCL hValAlgFiMC hval_all
  have hTopCond : ∀ (i : Fin D_orb.length) (m : ℕ), 2 ≤ m →
      ∀ (c' : ((D_orb.get i).field)ˣ),
        valL F (D_orb.get i).field (c' : (D_orb.get i).field) =
          (m : ℤ) + condExpChar F (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) →
        (∀ x : (D_orb.get i).field,
          (x = 0 ∨ ((m - 1 : ℕ) : ℤ) ≤ valL F (D_orb.get i).field x) →
          ∀ hx : 1 + x ≠ 0,
            ((μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
              (Units.mk0 (1 + x) hx) : Ω F) =
              (traceChar F (D_orb.get i).le ψ)
                (((c'⁻¹ : ((D_orb.get i).field)ˣ) : (D_orb.get i).field) * x)) →
        condExp F (D_orb.get i).field
          (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) = m := by
    intro i m hm c' hc'_val hc'_top
    haveI : FiniteDimensional F (D_orb.get i).field := hFinFi i
    obtain ⟨hψ_triv, hψ_nontriv⟩ := hSpec_all (D_orb.get i).field
      (traceChar F (D_orb.get i).le ψ) (hψFi i)
    exact hTopCond_gen (D_orb.get i).field (traceChar F (D_orb.get i).le ψ)
      hψ_triv hψ_nontriv (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le)))
      (hθ_cond i) m hm c' hc'_val hc'_top
  have hχ'Fi_top :=
    ld_ch14_twisted_orbit_norm_pullback_top_stat F L M_C hLM_C hGalMC ψ hψ hψMC
      D_orb hFinFi hψFi χ' h_ge2 hFiMC hχ'_cond k hk_ge1 hValAlgMCL hTrBoundMCL hnMC
      hFi_ram_pull c'_χ' hc_L_top
      (fun i => hNormFilt i (condExp F L χ') (by omega))
      hval_all hSpec_all
  exact ld_ch14_twisted_orbit_regime_construction F L K M_C hLM_C hM_CK ψ hψ
    D_orb hFinFi hψFi hLtFi hDegSum χ' h_ge2 hFiMC μ'_orb hχ'_cond hθ_cond
    σ_all idx_all hσ_props hν_prod t k ht_ge1 hk_ge1 hValAlgMCL hFi_ram_reg
    ϖ_MC ϖ_L hϖ_valMC hϖ_valL c'_χ' c'_μ hc_L_val hc_μ_props u_all hu_all_def hu_all_inj
    hTopCond hNormFilt hχ'Fi_top hval_all

theorem ld_ch14_higher_cond_local_to_residue_frob_bridge (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψMC : IsAdmissibleChar F M_C (traceChar F hLM_C ψ))
    (χ' : Lˣ →* (Ω F)ˣ)
    (hFrobSurjL : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧
        (x - s ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) = 0 ∨
          1 ≤ valL F L (x - s ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)))))
    (t k : ℕ) (ht_ge1 : 1 ≤ t) (hk_ge1 : 1 ≤ k)
    (hValAlgMCL : ∀ x : L, valL F M_C (IntermediateField.inclusion hLM_C x) = (k : ℤ) * valL F L x)
    (hTrBoundMCL : ∀ (m : ℤ) (z : M_C),
      (z = 0 ∨ (k : ℤ) * m - ((k : ℤ) - 1) ≤ valL F M_C z) →
      (traceLM F hLM_C z = 0 ∨ m ≤ valL F L (traceLM F hLM_C z)))
    (hTrFrobMCL : ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      traceLM F hLM_C (z ^ (p F)) - (traceLM F hLM_C z) ^ (p F) = 0 ∨
        1 ≤ valL F L (traceLM F hLM_C (z ^ (p F)) - (traceLM F hLM_C z) ^ (p F)))
    (hnMC : condExpChar F M_C (traceChar F hLM_C ψ) =
      (k : ℤ) * condExpChar F L ψ + ((k : ℤ) - 1))
    (P_poly : M_C → M_C) (ϖ_K : Kˣ) (ϖ_MC : M_Cˣ) (ϖ_L : Lˣ)
    (r_exp : ℕ) (hr_exp_pos : 1 ≤ r_exp) (a_coeff : Fin r_exp → M_C)
    (hq_pow : Module.finrank M_C (IntermediateField.extendScalars hM_CK) = (p F) ^ r_exp)
    (ha_int : ∀ j : Fin r_exp, a_coeff j = 0 ∨ 0 ≤ valL F M_C (a_coeff j))
    (ha0_tr : a_coeff ⟨0, hr_exp_pos⟩ -
      (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K) = 0 ∨
      1 ≤ valL F M_C (a_coeff ⟨0, hr_exp_pos⟩ -
        (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K)))
    (hTr_val0 : valL F M_C ((((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K)) = 0)
    (hP_def : ∀ z : M_C,
      P_poly z =
        z ^ (Module.finrank M_C (IntermediateField.extendScalars hM_CK)) +
          ∑ j : Fin r_exp, (a_coeff j) * (z ^ ((p F) ^ (j : ℕ))))
    (c'_χ' : Lˣ)
    (hc₁_val : valL F L ((((ϖ_L ^ (condExp F L χ' - 1))⁻¹ * c'_χ' : Lˣ) : L)) =
      1 + condExpChar F L ψ)
    (u_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) → M_Cˣ)
    (hu_all_val : ∀ j, valL F M_C ((u_all j : M_Cˣ) : M_C) = 0)
    (hu_all_P : ∀ j, ∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) →
      (traceChar F hLM_C ψ)
        ((((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom
          ((ϖ_L ^ (condExp F L χ' - 1))⁻¹ * c'_χ'))⁻¹ : M_Cˣ) : M_C) *
          ((u_all j : M_C) * P_poly z)) = 1)
    (hu_all_inj : ∀ j₁ j₂,
      ((u_all j₁ : M_C) - (u_all j₂ : M_C) = 0 ∨
        1 ≤ valL F M_C ((u_all j₁ : M_C) - (u_all j₂ : M_C))) →
      j₁ = j₂) :
    let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
    let a := condExp F L χ'
    let c₁ : Lˣ := (ϖ_L ^ (a - 1))⁻¹ * c'_χ'
    ∃ (u_α : Lˣ)
      (k_L : Type u) (_ : Field k_L) (_ : Fintype k_L) (resL : L → k_L)
      (k_M : Type u) (_ : Field k_M) (_ : Fintype k_M) (resM : M_C → k_M)
      (ι_res : k_L →+* k_M)
      (ψ_L : k_L → Ω F) (ψ_M : k_M → Ω F) (α_L : k_L)
      (a_bar : Fin r_exp → k_M) (β : Fin (q - 1) → k_M),
      valL F L (u_α : L) = 0 ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        ψ (((c₁⁻¹ : Lˣ) : L) * ((u_α : L) * x)) =
          ψ (((c₁⁻¹ : Lˣ) : L) * (x ^ q))) ∧
      resL 0 = 0 ∧ resL 1 = 1 ∧
      (∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
        resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
        resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
        resL (-x₁) = -resL x₁) ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x))) ∧
      resM 0 = 0 ∧ resM 1 = 1 ∧
      (∀ z₁ z₂ : M_C, (z₁ = 0 ∨ 0 ≤ valL F M_C z₁) → (z₂ = 0 ∨ 0 ≤ valL F M_C z₂) →
        resM (z₁ + z₂) = resM z₁ + resM z₂ ∧
        resM (z₁ * z₂) = resM z₁ * resM z₂ ∧
        resM (-z₁) = -resM z₁) ∧
      (∀ z : M_C, (z = 0 ∨ 0 ≤ valL F M_C z) → (resM z = 0 ↔ (z = 0 ∨ 1 ≤ valL F M_C z))) ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        resM (IntermediateField.inclusion hLM_C x) = ι_res (resL x)) ∧
      (∀ j : Fin (q - 1), β j = resM ((u_all j : M_Cˣ) : M_C)) ∧
      ((p F : ℕ) : k_L) = 0 ∧
      ((p F : ℕ) : k_M) = 0 ∧
      ψ_L 0 = 1 ∧
      (∀ a₁ a₂ : k_L, ψ_L (a₁ + a₂) = ψ_L a₁ * ψ_L a₂) ∧
      (∃ a₀ : k_L, ψ_L a₀ ≠ 1) ∧
      ψ_M 0 = 1 ∧
      (∀ w₁ w₂ : k_M, ψ_M (w₁ + w₂) = ψ_M w₁ * ψ_M w₂) ∧
      (∃ w₀ : k_M, ψ_M w₀ ≠ 1) ∧
      α_L ≠ 0 ∧
      (∀ b : k_L, ψ_L (α_L * b) = ψ_L (b ^ q)) ∧
      (∀ (n : ℕ) (γ_L : k_L),
        (∀ b : k_L, ψ_L (γ_L * b ^ ((p F) ^ n)) = ψ_L b) →
        ∀ w : k_M, ψ_M (ι_res γ_L * w ^ ((p F) ^ n)) = ψ_M w) ∧
      Function.Injective β ∧
      (∀ j : Fin (q - 1), β j ≠ 0) ∧
      (∀ j : Fin (q - 1), ∀ z : k_M,
        ψ_M (β j * (z ^ q + ∑ m : Fin r_exp, a_bar m * (z ^ ((p F) ^ (m : ℕ))))) = 1) ∧
      ((a_bar ⟨0, hr_exp_pos⟩ ≠ 0 ∧
          (∏ j : Fin (q - 1), β j) * ((ι_res α_L) ^ q)⁻¹ * (a_bar ⟨0, hr_exp_pos⟩) ^ q = 1) →
        ∃ u_ω : M_Cˣ,
          valL F M_C (u_ω : M_C) = 0 ∧
          (u_ω : M_C) = (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K) ∧
          (∏ j : Fin (q - 1), u_all j) *
            (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (u_α ^ q))⁻¹ *
            (u_ω ^ q) ∈ unitGroup F M_C 1) ∧
      (∀ (U_θ : Lˣ) (u_ϖ z_η : M_Cˣ) (x₀ s₀ : L),
        valL F L (U_θ : L) = 0 →
        valL F M_C (u_ϖ : M_C) = 0 →
        valL F M_C (z_η : M_C) = 0 →
        (z_η ^ q) * u_ϖ⁻¹ ∈ unitGroup F M_C 1 →
        (x₀ = 0 ∨ 0 ≤ valL F L x₀) →
        (s₀ = 0 ∨ 0 ≤ valL F L s₀) →
        (IntermediateField.inclusion hLM_C s₀ * (u_ϖ : M_C) -
          P_poly (IntermediateField.inclusion hLM_C x₀ * (z_η : M_C)) = 0 ∨
          1 ≤ valL F M_C
            (IntermediateField.inclusion hLM_C s₀ * (u_ϖ : M_C) -
              P_poly (IntermediateField.inclusion hLM_C x₀ * (z_η : M_C)))) →
        (resM (z_η : M_C)) ^ q = resM (u_ϖ : M_C) ∧
        ι_res (resL s₀) * resM (u_ϖ : M_C) =
          (ι_res (resL x₀) * resM (z_η : M_C)) ^ q +
            ∑ m : Fin r_exp, a_bar m * (ι_res (resL x₀) * resM (z_η : M_C)) ^ ((p F) ^ (m : ℕ)) ∧
        (ψ_L (resL s₀) = ψ_L (resL (U_θ : L) * (resL x₀) ^ q) →
          ψ (((c₁⁻¹ : Lˣ) : L) * s₀) =
            ψ (((c₁⁻¹ : Lˣ) : L) * ((U_θ : L) * (x₀ ^ q))))) :=
by
  classical
  let q := Module.finrank M_C (IntermediateField.extendScalars hM_CK)
  let a := condExp F L χ'
  let c₁ : Lˣ := (ϖ_L ^ (a - 1))⁻¹ * c'_χ'
  
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, hval_surj_L,
    hval_add_L, hunit0_L, hunit_ge1_L, hunit_val0_L⟩ := ld_valL_and_unitGroup_props F L
  obtain ⟨hval0_M, hval1_M, hval_neg1_M, hval_neg_M, hval_mul_M, hval_inv_M, hval_surj_M,
    hval_add_M, hunit0_M, hunit_ge1_M, hunit_val0_M⟩ := ld_valL_and_unitGroup_props F M_C
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halg0_L, halg1_L, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨_, _, _, _, halg0_M, halg1_M, _, _, _⟩ :=
    ld_addVal_finset_and_algebraMap_valL F M_C
  obtain ⟨S₁_L, hS₁_L⟩ := ld_valL_mod_one_finset F L hval0_L hval_neg_L hval_mul_L hval_add_L
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0_L halg1_L R_F hRF_0 hRF_mod1
  obtain ⟨S₁_M, hS₁_M⟩ := ld_valL_mod_one_finset F M_C hval0_M hval_neg_M hval_mul_M hval_add_M
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halg0_M halg1_M R_F hRF_0 hRF_mod1
  obtain ⟨k_L, hField_kL, hFin_kL, resL, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ :=
    ld_valL_residue_field_exists F L hval0_L hval1_L hval_neg1_L hval_neg_L hval_mul_L
      hval_inv_L hval_add_L S₁_L hS₁_L
  obtain ⟨k_M, hField_kM, hFin_kM, resM, hresM_0, hresM_1, hresM_ring, hresM_ker, hresM_surj⟩ :=
    ld_valL_residue_field_exists F M_C hval0_M hval1_M hval_neg1_M hval_neg_M hval_mul_M
      hval_inv_M hval_add_M S₁_M hS₁_M
  letI : Field k_L := hField_kL
  letI : Fintype k_L := hFin_kL
  letI : Field k_M := hField_kM
  letI : Fintype k_M := hFin_kM
  have hSpecL := ld_condExp_and_condExpChar_spec F L ψ hψ χ'
  have hSpecMC := ld_condExp_and_condExpChar_spec F M_C (traceChar F hLM_C ψ) hψMC 1

  
  let PL (m : ℤ) (x : L) : Prop := x = 0 ∨ m ≤ valL F L x
  let PM (m : ℤ) (z : M_C) : Prop := z = 0 ∨ m ≤ valL F M_C z
  have hPL_zero : ∀ m : ℤ, PL m 0 := fun _ => Or.inl rfl
  have hPL_one : PL 0 1 := Or.inr (by rw [hval1_L])
  have hPL_of_val : ∀ {m : ℤ} {x : L}, valL F L x = m → PL m x := fun h => Or.inr (by omega)
  have hPL_mono : ∀ {m₁ m₂ : ℤ} {x : L}, m₁ ≤ m₂ → PL m₂ x → PL m₁ x := by
    intro m₁ m₂ x hm hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hm hx)
  have hPL_neg : ∀ {m : ℤ} {x : L}, PL m x → PL m (-x) := by
    intro m x hx
    rcases hx with rfl | hx
    · rw [neg_zero]; exact Or.inl rfl
    · right; rw [hval_neg_L]; exact hx
  have hPL_add : ∀ {m : ℤ} {x y : L}, PL m x → PL m y → PL m (x + y) :=
    fun hx hy => hval_add_L _ _ _ hx hy
  have hPL_sub : ∀ {m : ℤ} {x y : L}, PL m x → PL m y → PL m (x - y) := by
    intro m x y hx hy
    rw [sub_eq_add_neg]
    exact hPL_add hx (hPL_neg hy)
  have hPL_mul : ∀ {m₁ m₂ : ℤ} {x y : L}, PL m₁ x → PL m₂ y → PL (m₁ + m₂) (x * y) := by
    intro m₁ m₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        have hx' := hx.resolve_left hx0
        have hy' := hy.resolve_left hy0
        rw [hval_mul_L x y hx0 hy0]
        omega

  have hPM_zero : ∀ m : ℤ, PM m 0 := fun _ => Or.inl rfl
  have hPM_one : PM 0 1 := Or.inr (by rw [hval1_M])
  have hPM_of_val : ∀ {m : ℤ} {z : M_C}, valL F M_C z = m → PM m z := fun h => Or.inr (by omega)
  have hPM_mono : ∀ {m₁ m₂ : ℤ} {z : M_C}, m₁ ≤ m₂ → PM m₂ z → PM m₁ z := by
    intro m₁ m₂ z hm hz
    rcases hz with rfl | hz
    · exact Or.inl rfl
    · exact Or.inr (le_trans hm hz)
  have hPM_neg : ∀ {m : ℤ} {z : M_C}, PM m z → PM m (-z) := by
    intro m z hz
    rcases hz with rfl | hz
    · rw [neg_zero]; exact Or.inl rfl
    · right; rw [hval_neg_M]; exact hz
  have hPM_add : ∀ {m : ℤ} {z₁ z₂ : M_C}, PM m z₁ → PM m z₂ → PM m (z₁ + z₂) :=
    fun hz₁ hz₂ => hval_add_M _ _ _ hz₁ hz₂
  have hPM_sub : ∀ {m : ℤ} {z₁ z₂ : M_C}, PM m z₁ → PM m z₂ → PM m (z₁ - z₂) := by
    intro m z₁ z₂ hz₁ hz₂
    rw [sub_eq_add_neg]
    exact hPM_add hz₁ (hPM_neg hz₂)
  have hPM_mul : ∀ {m₁ m₂ : ℤ} {z₁ z₂ : M_C}, PM m₁ z₁ → PM m₂ z₂ → PM (m₁ + m₂) (z₁ * z₂) := by
    intro m₁ m₂ z₁ z₂ hz₁ hz₂
    by_cases hz₁0 : z₁ = 0
    · left; rw [hz₁0, zero_mul]
    · by_cases hz₂0 : z₂ = 0
      · left; rw [hz₂0, mul_zero]
      · right
        have hz₁' := hz₁.resolve_left hz₁0
        have hz₂' := hz₂.resolve_left hz₂0
        rw [hval_mul_M z₁ z₂ hz₁0 hz₂0]
        omega

  have hresL_sub_mem1 : ∀ {x₁ x₂ : L}, PL 0 x₁ → PL 0 x₂ → resL x₁ = resL x₂ → PL 1 (x₁ - x₂) := by
    intro x₁ x₂ hx₁ hx₂ hres
    have hsub_int : PL 0 (x₁ - x₂) := hPL_sub hx₁ hx₂
    have hres_sub : resL (x₁ - x₂) = 0 := by
      rw [sub_eq_add_neg, (hresL_ring x₁ (-x₂) hx₁ (hPL_neg hx₂)).1,
        (hresL_ring x₂ 0 hx₂ (hPL_zero 0)).2.2, hres, add_neg_cancel]
    exact (hresL_ker (x₁ - x₂) hsub_int).mp hres_sub
  have hresL_eq_of_mem1 : ∀ {x₁ x₂ : L}, PL 0 x₁ → PL 0 x₂ → PL 1 (x₁ - x₂) → resL x₁ = resL x₂ := by
    intro x₁ x₂ _ hx₂ h1
    have hsub0 : PL 0 (x₁ - x₂) := hPL_mono (by omega) h1
    have hres0 : resL (x₁ - x₂) = 0 := (hresL_ker (x₁ - x₂) hsub0).mpr h1
    have h_eq : x₁ = (x₁ - x₂) + x₂ := by ring
    rw [h_eq, (hresL_ring (x₁ - x₂) x₂ hsub0 hx₂).1, hres0, zero_add]

  have hresM_sub_mem1 : ∀ {z₁ z₂ : M_C}, PM 0 z₁ → PM 0 z₂ → resM z₁ = resM z₂ → PM 1 (z₁ - z₂) := by
    intro z₁ z₂ hz₁ hz₂ hres
    have hsub_int : PM 0 (z₁ - z₂) := hPM_sub hz₁ hz₂
    have hres_sub : resM (z₁ - z₂) = 0 := by
      rw [sub_eq_add_neg, (hresM_ring z₁ (-z₂) hz₁ (hPM_neg hz₂)).1,
        (hresM_ring z₂ 0 hz₂ (hPM_zero 0)).2.2, hres, add_neg_cancel]
    exact (hresM_ker (z₁ - z₂) hsub_int).mp hres_sub
  have hresM_eq_of_mem1 : ∀ {z₁ z₂ : M_C}, PM 0 z₁ → PM 0 z₂ → PM 1 (z₁ - z₂) → resM z₁ = resM z₂ := by
    intro z₁ z₂ _ hz₂ h1
    have hsub0 : PM 0 (z₁ - z₂) := hPM_mono (by omega) h1
    have hres0 : resM (z₁ - z₂) = 0 := (hresM_ker (z₁ - z₂) hsub0).mpr h1
    have h_eq : z₁ = (z₁ - z₂) + z₂ := by ring
    rw [h_eq, (hresM_ring (z₁ - z₂) z₂ hsub0 hz₂).1, hres0, zero_add]

  have hresL_pow : ∀ (x : L) (n : ℕ), PL 0 x → PL 0 (x ^ n) ∧ resL (x ^ n) = (resL x) ^ n := by
    intro x n hx
    induction n with
    | zero =>
      rw [pow_zero, pow_zero, hresL_1]
      exact ⟨hPL_one, rfl⟩
    | succ n ih =>
      have hpow_int : PL 0 (x ^ (n + 1)) := by
        rw [pow_succ, ← zero_add (0 : ℤ)]
        exact hPL_mul ih.1 hx
      refine ⟨hpow_int, ?_⟩
      rw [pow_succ, (hresL_ring (x ^ n) x ih.1 hx).2.1, ih.2, pow_succ]

  have hresM_pow : ∀ (z : M_C) (n : ℕ), PM 0 z → PM 0 (z ^ n) ∧ resM (z ^ n) = (resM z) ^ n := by
    intro z n hz
    induction n with
    | zero =>
      rw [pow_zero, pow_zero, hresM_1]
      exact ⟨hPM_one, rfl⟩
    | succ n ih =>
      have hpow_int : PM 0 (z ^ (n + 1)) := by
        rw [pow_succ, ← zero_add (0 : ℤ)]
        exact hPM_mul ih.1 hz
      refine ⟨hpow_int, ?_⟩
      rw [pow_succ, (hresM_ring (z ^ n) z ih.1 hz).2.1, ih.2, pow_succ]

  have hresM_sum : ∀ {ι : Type} (s : Finset ι) (f : ι → M_C),
      (∀ i ∈ s, PM 0 (f i)) →
      PM 0 (∑ i ∈ s, f i) ∧ resM (∑ i ∈ s, f i) = ∑ i ∈ s, resM (f i) := by
    intro ι s f hf
    induction s using Finset.induction_on with
    | empty =>
      rw [Finset.sum_empty, Finset.sum_empty, hresM_0]
      exact ⟨hPM_zero 0, rfl⟩
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha]
      have ha_int := hf a (Finset.mem_insert_self a s)
      have hs := ih (fun i hi => hf i (Finset.mem_insert_of_mem hi))
      refine ⟨hPM_add ha_int hs.1, ?_⟩
      rw [(hresM_ring (f a) (∑ i ∈ s, f i) ha_int hs.1).1, hs.2]

  
  let liftL : k_L → L := fun a => Classical.choose (hresL_surj a)
  have hliftL_int : ∀ a : k_L, PL 0 (liftL a) :=
    fun a => (Classical.choose_spec (hresL_surj a)).1
  have hliftL_res : ∀ a : k_L, resL (liftL a) = a :=
    fun a => (Classical.choose_spec (hresL_surj a)).2
  let liftM : k_M → M_C := fun w => Classical.choose (hresM_surj w)
  have hliftM_int : ∀ w : k_M, PM 0 (liftM w) :=
    fun w => (Classical.choose_spec (hresM_surj w)).1
  have hliftM_res : ∀ w : k_M, resM (liftM w) = w :=
    fun w => (Classical.choose_spec (hresM_surj w)).2

  have hinc_int : ∀ {x : L}, PL 0 x → PM 0 (IntermediateField.inclusion hLM_C x) := by
    intro x hx
    rcases hx with rfl | hx
    · left; exact map_zero _
    · right
      rw [hValAlgMCL x]
      exact mul_nonneg (by omega) hx
  have hinc_mem1 : ∀ {x : L}, PL 1 x → PM 1 (IntermediateField.inclusion hLM_C x) := by
    intro x hx
    rcases hx with rfl | hx
    · left; exact map_zero _
    · right
      rw [hValAlgMCL x]
      nlinarith

  let ι_fun : k_L → k_M := fun a => resM (IntermediateField.inclusion hLM_C (liftL a))
  have hι_fun_spec : ∀ x : L, PL 0 x →
      resM (IntermediateField.inclusion hLM_C x) = ι_fun (resL x) := by
    intro x hx
    dsimp only [ι_fun]
    apply hresM_eq_of_mem1 (hinc_int hx) (hinc_int (hliftL_int (resL x)))
    rw [← map_sub]
    exact hinc_mem1 (hresL_sub_mem1 hx (hliftL_int (resL x)) (hliftL_res (resL x)).symm)

  let ι_res : k_L →+* k_M :=
    { toFun := ι_fun
      map_zero' := by
        rw [← hresL_0, ← hι_fun_spec 0 (hPL_zero 0), map_zero, hresM_0]
      map_one' := by
        rw [← hresL_1, ← hι_fun_spec 1 hPL_one, map_one, hresM_1]
      map_add' := fun a₁ a₂ => by
        set x₁ := liftL a₁
        set x₂ := liftL a₂
        have hx₁ : PL 0 x₁ := hliftL_int a₁
        have hx₂ : PL 0 x₂ := hliftL_int a₂
        have hsum_res : a₁ + a₂ = resL (x₁ + x₂) := by
          rw [(hresL_ring x₁ x₂ hx₁ hx₂).1, hliftL_res a₁, hliftL_res a₂]
        rw [hsum_res, ← hι_fun_spec (x₁ + x₂) (hPL_add hx₁ hx₂),
          ← hliftL_res a₁, ← hliftL_res a₂,
          ← hι_fun_spec x₁ hx₁, ← hι_fun_spec x₂ hx₂, map_add,
          (hresM_ring _ _ (hinc_int hx₁) (hinc_int hx₂)).1]
      map_mul' := fun a₁ a₂ => by
        set x₁ := liftL a₁
        set x₂ := liftL a₂
        have hx₁ : PL 0 x₁ := hliftL_int a₁
        have hx₂ : PL 0 x₂ := hliftL_int a₂
        have hmul_res : a₁ * a₂ = resL (x₁ * x₂) := by
          rw [(hresL_ring x₁ x₂ hx₁ hx₂).2.1, hliftL_res a₁, hliftL_res a₂]
        rw [hmul_res, ← hι_fun_spec (x₁ * x₂) (by simpa using hPL_mul hx₁ hx₂),
          ← hliftL_res a₁, ← hliftL_res a₂,
          ← hι_fun_spec x₁ hx₁, ← hι_fun_spec x₂ hx₂, map_mul,
          (hresM_ring _ _ (hinc_int hx₁) (hinc_int hx₂)).2.1] }

  have hι_res : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      resM (IntermediateField.inclusion hLM_C x) = ι_res (resL x) :=
    fun x hx => hι_fun_spec x hx

  
  have hp_prime : Nat.Prime (p F) := CharP.prime_ringChar 𝓀[F]
  have hq_pow' : q = (p F) ^ r_exp := hq_pow
  have hq_ge2 : 2 ≤ q := by
    calc 2 = 2 ^ 1 := rfl
      _ ≤ (p F) ^ 1 := Nat.pow_le_pow_left hp_prime.two_le 1
      _ ≤ (p F) ^ r_exp := Nat.pow_le_pow_right hp_prime.pos hr_exp_pos
      _ = q := hq_pow'.symm
  have hq_ne0 : q ≠ 0 := by omega

  have hpF : ((p F : ℕ) : F) = 0 ∨ 1 ≤ addVal F ((p F : ℕ) : F) := by
    let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
    have hres0 : IsLocalRing.residue 𝒪[F] ((p F : ℕ) : 𝒪[F]) = 0 := by
      rw [map_natCast]
      exact CharP.cast_eq_zero 𝓀[F] (p F)
    have hker : valuation F (((p F : ℕ) : 𝒪[F]) : F) < 1 := by
      rwa [← RingHom.mem_ker, IsLocalRing.ker_residue, IsLocalRing.mem_maximalIdeal,
        mem_nonunits_iff, Valuation.Integer.not_isUnit_iff_valuation_lt_one] at hres0
    by_cases hp0 : ((p F : ℕ) : F) = 0
    · exact Or.inl hp0
    · right
      have hφp : φ (valuation F ((p F : ℕ) : F)) ≠ 0 :=
        (map_ne_zero _).mpr ((Valuation.ne_zero_iff _).mpr hp0)
      have hlt : φ (valuation F ((p F : ℕ) : F)) < 1 := by
        rw [← map_one φ, map_lt_map_iff φ]
        exact hker
      rw [← WithZero.coe_unzero hφp, ← WithZero.coe_one, WithZero.coe_lt_coe,
        ← Multiplicative.toAdd_lt, toAdd_one] at hlt
      unfold addVal
      rw [dif_neg hp0]
      omega

  have hp_valL : PL 1 ((p F : ℕ) : L) := by
    have h := halg1_L ((p F : ℕ) : F) hpF
    rwa [map_natCast (algebraMap F L) (p F)] at h
  have hp_valM : PM 1 ((p F : ℕ) : M_C) := by
    have h := halg1_M ((p F : ℕ) : F) hpF
    rwa [map_natCast (algebraMap F M_C) (p F)] at h

  have hresL_nat : ∀ n : ℕ, PL 0 (n : L) ∧ resL (n : L) = (n : k_L) := by
    intro n
    induction n with
    | zero =>
      refine ⟨Or.inl Nat.cast_zero, ?_⟩
      rw [Nat.cast_zero, Nat.cast_zero, hresL_0]
    | succ n ih =>
      have hval_succ : PL 0 ((n + 1 : ℕ) : L) := by
        rw [Nat.cast_succ]
        exact hPL_add ih.1 hPL_one
      refine ⟨hval_succ, ?_⟩
      rw [Nat.cast_succ, (hresL_ring (n : L) 1 ih.1 hPL_one).1, ih.2, hresL_1, Nat.cast_succ]

  have hresM_nat : ∀ n : ℕ, PM 0 (n : M_C) ∧ resM (n : M_C) = (n : k_M) := by
    intro n
    induction n with
    | zero =>
      refine ⟨Or.inl Nat.cast_zero, ?_⟩
      rw [Nat.cast_zero, Nat.cast_zero, hresM_0]
    | succ n ih =>
      have hval_succ : PM 0 ((n + 1 : ℕ) : M_C) := by
        rw [Nat.cast_succ]
        exact hPM_add ih.1 hPM_one
      refine ⟨hval_succ, ?_⟩
      rw [Nat.cast_succ, (hresM_ring (n : M_C) 1 ih.1 hPM_one).1, ih.2, hresM_1, Nat.cast_succ]

  have hp_kL : ((p F : ℕ) : k_L) = 0 := by
    rw [← (hresL_nat (p F)).2]
    exact (hresL_ker ((p F : ℕ) : L) (hresL_nat (p F)).1).mpr hp_valL
  have hp_kM : ((p F : ℕ) : k_M) = 0 := by
    rw [← (hresM_nat (p F)).2]
    exact (hresM_ker ((p F : ℕ) : M_C) (hresM_nat (p F)).1).mpr hp_valM

  have hchoose_kL : ∀ m : ℕ, 0 < m → m < q → (q.choose m : k_L) = 0 := by
    intro m hm0 hmq
    have hdvd : p F ∣ q.choose m := by
      rw [hq_pow']
      exact Nat.Prime.dvd_choose_pow hp_prime (ne_of_gt hm0) (hq_pow' ▸ ne_of_lt hmq)
    rcases hdvd with ⟨c, hc⟩
    rw [hc, Nat.cast_mul, hp_kL, zero_mul]

  have hfrob_add_kL : ∀ a b : k_L, (a + b) ^ q = a ^ q + b ^ q := by
    intro a b
    have hq_eq : q + 1 = (q - 1) + 1 + 1 := by omega
    have hq1 : (q - 1) + 1 = q := by omega
    rw [add_pow a b q, hq_eq, Finset.sum_range_succ, Finset.sum_range_succ']
    have hmid : (∑ m ∈ Finset.range (q - 1),
        a ^ (m + 1) * b ^ (q - (m + 1)) * (q.choose (m + 1) : k_L)) = 0 := by
      apply Finset.sum_eq_zero
      intro m hm
      have hlt : m < q - 1 := Finset.mem_range.mp hm
      rw [hchoose_kL (m + 1) (by omega) (by omega), mul_zero]
    simp only [hmid, zero_add, hq1, Nat.sub_self, Nat.sub_zero, pow_zero, mul_one, one_mul,
      Nat.choose_self, Nat.choose_zero_right, Nat.cast_one]
    exact add_comm (b ^ q) (a ^ q)

  
  set c₁_M : M_Cˣ := Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₁
  have hc₁_inv_val : valL F L ((c₁⁻¹ : Lˣ) : L) = -(1 + condExpChar F L ψ) := by
    rw [hval_inv_L c₁, hc₁_val]
  have hc₁_M_val : valL F M_C (c₁_M : M_C) = 1 + condExpChar F M_C (traceChar F hLM_C ψ) := by
    change valL F M_C (IntermediateField.inclusion hLM_C (c₁ : L)) = _
    rw [hValAlgMCL (c₁ : L), hc₁_val, hnMC]
    ring
  have hc₁_M_inv_val : valL F M_C ((c₁_M⁻¹ : M_Cˣ) : M_C) =
      -(1 + condExpChar F M_C (traceChar F hLM_C ψ)) := by
    rw [hval_inv_M c₁_M, hc₁_M_val]

  have hψ_congr : ∀ {x y : L}, PL (-condExpChar F L ψ) (x - y) → ψ x = ψ y := by
    intro x y hxy
    have h_eq : x = (x - y) + y := by ring
    rw [h_eq, ψ.map_add_eq_mul, hSpecL.1 (x - y) hxy, one_mul]
  have hψMC_congr : ∀ {z₁ z₂ : M_C},
      PM (-condExpChar F M_C (traceChar F hLM_C ψ)) (z₁ - z₂) →
      (traceChar F hLM_C ψ) z₁ = (traceChar F hLM_C ψ) z₂ := by
    intro z₁ z₂ hz
    have h_eq : z₁ = (z₁ - z₂) + z₂ := by ring
    rw [h_eq, (traceChar F hLM_C ψ).map_add_eq_mul, hSpecMC.1 (z₁ - z₂) hz, one_mul]

  let ψ_L : k_L → Ω F := fun a => ψ (((c₁⁻¹ : Lˣ) : L) * liftL a)
  let ψ_M : k_M → Ω F := fun w => (traceChar F hLM_C ψ) (((c₁_M⁻¹ : M_Cˣ) : M_C) * liftM w)

  have hψL_spec : ∀ x : L, PL 0 x → ψ_L (resL x) = ψ (((c₁⁻¹ : Lˣ) : L) * x) := by
    intro x hx
    dsimp only [ψ_L]
    symm
    apply hψ_congr
    have h_eq : ((c₁⁻¹ : Lˣ) : L) * x - ((c₁⁻¹ : Lˣ) : L) * liftL (resL x) =
        ((c₁⁻¹ : Lˣ) : L) * (x - liftL (resL x)) := by ring
    rw [h_eq]
    have hΔ1 : PL 1 (x - liftL (resL x)) :=
      hresL_sub_mem1 hx (hliftL_int (resL x)) (hliftL_res (resL x)).symm
    exact hPL_mono (by omega) (hPL_mul (hPL_of_val hc₁_inv_val) hΔ1)

  have hψL_0 : ψ_L 0 = 1 := by
    rw [← hresL_0, hψL_spec 0 (hPL_zero 0), mul_zero, ψ.map_zero_eq_one]
  have hψL_add : ∀ a b : k_L, ψ_L (a + b) = ψ_L a * ψ_L b := by
    intro a b
    set xa := liftL a
    set xb := liftL b
    have hxa : PL 0 xa := hliftL_int a
    have hxb : PL 0 xb := hliftL_int b
    have hab_res : a + b = resL (xa + xb) := by
      rw [(hresL_ring xa xb hxa hxb).1, hliftL_res a, hliftL_res b]
    rw [hab_res, hψL_spec (xa + xb) (hPL_add hxa hxb),
      ← hliftL_res a, ← hliftL_res b, hψL_spec xa hxa, hψL_spec xb hxb,
      ← ψ.map_add_eq_mul]
    congr 1
    ring
  have hψL_ne : ∃ a₀ : k_L, ψ_L a₀ ≠ 1 := by
    obtain ⟨x₁, _, hx₁_val, hx₁_ψ⟩ := hSpecL.2.1
    set y₁ : L := (c₁ : L) * x₁
    have hy₁_int : PL 0 y₁ := by
      dsimp only [y₁]
      exact hPL_mono (by omega) (hPL_mul (hPL_of_val hc₁_val) (Or.inr hx₁_val))
    have hy₁_cancel : ((c₁⁻¹ : Lˣ) : L) * y₁ = x₁ := by
      have hc_cancel : ((c₁⁻¹ : Lˣ) : L) * (c₁ : L) = 1 := by exact_mod_cast Units.inv_mul c₁
      calc ((c₁⁻¹ : Lˣ) : L) * ((c₁ : L) * x₁)
        _ = (((c₁⁻¹ : Lˣ) : L) * (c₁ : L)) * x₁ := by ring
        _ = 1 * x₁ := by rw [hc_cancel]
        _ = x₁ := one_mul x₁
    refine ⟨resL y₁, ?_⟩
    rw [hψL_spec y₁ hy₁_int, hy₁_cancel]
    exact hx₁_ψ

  have hψM_spec : ∀ z : M_C, PM 0 z →
      ψ_M (resM z) = (traceChar F hLM_C ψ) (((c₁_M⁻¹ : M_Cˣ) : M_C) * z) := by
    intro z hz
    dsimp only [ψ_M]
    symm
    apply hψMC_congr
    have h_eq : ((c₁_M⁻¹ : M_Cˣ) : M_C) * z - ((c₁_M⁻¹ : M_Cˣ) : M_C) * liftM (resM z) =
        ((c₁_M⁻¹ : M_Cˣ) : M_C) * (z - liftM (resM z)) := by ring
    rw [h_eq]
    have hΔ1 : PM 1 (z - liftM (resM z)) :=
      hresM_sub_mem1 hz (hliftM_int (resM z)) (hliftM_res (resM z)).symm
    exact hPM_mono (by omega) (hPM_mul (hPM_of_val hc₁_M_inv_val) hΔ1)

  have hψM_0 : ψ_M 0 = 1 := by
    rw [← hresM_0, hψM_spec 0 (hPM_zero 0), mul_zero, (traceChar F hLM_C ψ).map_zero_eq_one]
  have hψM_add : ∀ w₁ w₂ : k_M, ψ_M (w₁ + w₂) = ψ_M w₁ * ψ_M w₂ := by
    intro w₁ w₂
    set z₁ := liftM w₁
    set z₂ := liftM w₂
    have hz₁ : PM 0 z₁ := hliftM_int w₁
    have hz₂ : PM 0 z₂ := hliftM_int w₂
    have hw_res : w₁ + w₂ = resM (z₁ + z₂) := by
      rw [(hresM_ring z₁ z₂ hz₁ hz₂).1, hliftM_res w₁, hliftM_res w₂]
    rw [hw_res, hψM_spec (z₁ + z₂) (hPM_add hz₁ hz₂),
      ← hliftM_res w₁, ← hliftM_res w₂, hψM_spec z₁ hz₁, hψM_spec z₂ hz₂,
      ← (traceChar F hLM_C ψ).map_add_eq_mul]
    congr 1
    ring
  have hψM_ne : ∃ w₀ : k_M, ψ_M w₀ ≠ 1 := by
    obtain ⟨z₁, _, hz₁_val, hz₁_ψ⟩ := hSpecMC.2.1
    set y₁ : M_C := (c₁_M : M_C) * z₁
    have hy₁_int : PM 0 y₁ := by
      dsimp only [y₁]
      exact hPM_mono (by omega) (hPM_mul (hPM_of_val hc₁_M_val) (Or.inr hz₁_val))
    have hy₁_cancel : ((c₁_M⁻¹ : M_Cˣ) : M_C) * y₁ = z₁ := by
      have hc_cancel : ((c₁_M⁻¹ : M_Cˣ) : M_C) * (c₁_M : M_C) = 1 := by
        exact_mod_cast Units.inv_mul c₁_M
      calc ((c₁_M⁻¹ : M_Cˣ) : M_C) * ((c₁_M : M_C) * z₁)
        _ = (((c₁_M⁻¹ : M_Cˣ) : M_C) * (c₁_M : M_C)) * z₁ := by ring
        _ = 1 * z₁ := by rw [hc_cancel]
        _ = z₁ := one_mul z₁
    refine ⟨resM y₁, ?_⟩
    rw [hψM_spec y₁ hy₁_int, hy₁_cancel]
    exact hz₁_ψ

  
  obtain ⟨a₀, ha₀_ne1⟩ := hψL_ne
  have horth_L : ∀ u : k_L, (∑ a : k_L, ψ_L (u * a)) = if u = 0 then (Fintype.card k_L : Ω F) else 0 := by
    intro u
    by_cases hu : u = 0
    · simp [hu, hψL_0]
    · rw [if_neg hu]
      have hshift : (∑ a : k_L, ψ_L (u * a)) = (∑ a : k_L, ψ_L (u * a)) * ψ_L a₀ := by
        rw [Finset.sum_mul]
        refine (Fintype.sum_equiv (Equiv.addRight (u⁻¹ * a₀)) _ _ fun a => ?_).symm
        change ψ_L (u * a) * ψ_L a₀ = ψ_L (u * (a + u⁻¹ * a₀))
        have heq : u * (a + u⁻¹ * a₀) = u * a + a₀ := by
          rw [mul_add, ← mul_assoc, mul_inv_cancel₀ hu, one_mul]
        rw [heq, hψL_add]
      have hsub : (∑ a : k_L, ψ_L (u * a)) * (ψ_L a₀ - 1) = 0 := by
        calc (∑ a : k_L, ψ_L (u * a)) * (ψ_L a₀ - 1)
          _ = (∑ a : k_L, ψ_L (u * a)) * ψ_L a₀ - (∑ a : k_L, ψ_L (u * a)) := by ring
          _ = 0 := sub_eq_zero.mpr hshift.symm
      rcases mul_eq_zero.mp hsub with h | h
      · exact h
      · exact False.elim (ha₀_ne1 (sub_eq_zero.mp h))

  let g_L : k_L → Ω F := fun a => ψ_L (a ^ q)
  have hgL_0 : g_L 0 = 1 := by
    dsimp [g_L]
    rw [zero_pow hq_ne0, hψL_0]
  have hgL_add : ∀ a b : k_L, g_L (a + b) = g_L a * g_L b := by
    intro a b
    dsimp [g_L]
    rw [hfrob_add_kL a b, hψL_add]
  have hψL_neg : ∀ u : k_L, ψ_L (-u) * ψ_L u = 1 := by
    intro u
    rw [← hψL_add, neg_add_cancel, hψL_0]

  let T_L : k_L → Ω F := fun b => ∑ a : k_L, g_L a * ψ_L (-(b * a))
  have hsumT : (∑ b : k_L, T_L b) = (Fintype.card k_L : Ω F) := by
    dsimp [T_L]
    rw [Finset.sum_comm]
    have hinner : ∀ a : k_L, (∑ b : k_L, g_L a * ψ_L (-(b * a))) =
        g_L a * ∑ b : k_L, ψ_L ((-a) * b) := by
      intro a
      rw [← Finset.mul_sum]
      refine congrArg (g_L a * ·) (Finset.sum_congr rfl fun b _ => ?_)
      congr 1
      ring
    simp_rw [hinner, horth_L]
    rw [Finset.sum_eq_single (0 : k_L)]
    · simp [hgL_0]
    · intro a _ ha
      have hna : -a ≠ 0 := neg_ne_zero.mpr ha
      rw [if_neg hna, mul_zero]
    · intro habs
      exact False.elim (habs (Finset.mem_univ 0))

  have hcard_kL_ne : (Fintype.card k_L : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr Fintype.card_pos.ne'
  have hsumT_ne : (∑ b : k_L, T_L b) ≠ 0 := hsumT.symm ▸ hcard_kL_ne
  obtain ⟨α, _, hTα⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsumT_ne
  have hα_frob_kL : ∀ a : k_L, ψ_L (α * a) = ψ_L (a ^ q) := by
    intro a
    have hshift : T_L α = T_L α * (g_L a * ψ_L (-(α * a))) := by
      dsimp [T_L]
      rw [Finset.sum_mul]
      refine (Fintype.sum_equiv (Equiv.addRight a) _ _ fun x => ?_).symm
      change g_L x * ψ_L (-(α * x)) * (g_L a * ψ_L (-(α * a))) =
        g_L (x + a) * ψ_L (-(α * (x + a)))
      have halg : -(α * (x + a)) = -(α * x) + -(α * a) := by ring
      rw [hgL_add x a, halg, hψL_add]
      ring
    have hsub : T_L α * (g_L a * ψ_L (-(α * a)) - 1) = 0 := by
      calc T_L α * (g_L a * ψ_L (-(α * a)) - 1)
        _ = T_L α * (g_L a * ψ_L (-(α * a))) - T_L α := by ring
        _ = 0 := sub_eq_zero.mpr hshift.symm
    have h1 : g_L a * ψ_L (-(α * a)) = 1 := by
      rcases mul_eq_zero.mp hsub with h | h
      · exact False.elim (hTα h)
      · exact sub_eq_zero.mp h
    symm
    calc ψ_L (a ^ q) = g_L a * (ψ_L (-(α * a)) * ψ_L (α * a)) := by
          dsimp [g_L]; rw [hψL_neg, mul_one]
      _ = (g_L a * ψ_L (-(α * a))) * ψ_L (α * a) := by ring
      _ = ψ_L (α * a) := by rw [h1, one_mul]

  have hα_ne0 : α ≠ 0 := by
    intro hα0
    obtain ⟨s₀, hs₀_int, hs₀_mod1⟩ := hFrobSurjL (liftL a₀) (hliftL_int a₀)
    have ha₀_eq_pow : a₀ = (resL s₀) ^ q := by
      rw [← hliftL_res a₀,
        hresL_eq_of_mem1 (hliftL_int a₀) (hresL_pow s₀ q hs₀_int).1 hs₀_mod1,
        (hresL_pow s₀ q hs₀_int).2]
    have hψ_a₀ : ψ_L a₀ = 1 := by
      rw [ha₀_eq_pow, ← hα_frob_kL (resL s₀), hα0, zero_mul, hψL_0]
    exact ha₀_ne1 hψ_a₀

  set x_α : L := liftL α
  have hx_α_int : PL 0 x_α := hliftL_int α
  have hx_α_res : resL x_α = α := hliftL_res α
  have hx_α_not_mem1 : ¬ PL 1 x_α := by
    intro hmem1
    exact hα_ne0 (hx_α_res ▸ (hresL_ker x_α hx_α_int).mpr hmem1)
  have hx_α_ne0 : x_α ≠ 0 := fun h0 => hx_α_not_mem1 (Or.inl h0)
  have hx_α_val0 : valL F L x_α = 0 := by
    have hge0 : 0 ≤ valL F L x_α := hx_α_int.resolve_left hx_α_ne0
    have hnot_ge1 : ¬ (1 ≤ valL F L x_α) := fun h1 => hx_α_not_mem1 (Or.inr h1)
    omega

  let u_α : Lˣ := Units.mk0 x_α hx_α_ne0
  have hu_α_val : valL F L (u_α : L) = 0 := hx_α_val0
  have hu_α_int : PL 0 (u_α : L) := hx_α_int
  have hu_α_res : resL (u_α : L) = α := hx_α_res

  have hu_α_frob : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ψ (((c₁⁻¹ : Lˣ) : L) * ((u_α : L) * x)) = ψ (((c₁⁻¹ : Lˣ) : L) * (x ^ q)) := by
    intro x hx
    have hux_int : PL 0 ((u_α : L) * x) := by
      simpa using hPL_mul hu_α_int hx
    rw [← hψL_spec ((u_α : L) * x) hux_int, ← hψL_spec (x ^ q) (hresL_pow x q hx).1,
      (hresL_ring (u_α : L) x hu_α_int hx).2.1, hu_α_res, (hresL_pow x q hx).2]
    exact hα_frob_kL (resL x)

  
  set u_α_M : M_Cˣ := Units.map (IntermediateField.inclusion hLM_C).toMonoidHom u_α
  have hu_α_M_val : valL F M_C (u_α_M : M_C) = 0 := by
    change valL F M_C (IntermediateField.inclusion hLM_C (u_α : L)) = 0
    rw [hValAlgMCL (u_α : L), hu_α_val, mul_zero]
  have hu_α_M_res : resM (u_α_M : M_C) = ι_res α := by
    change resM (IntermediateField.inclusion hLM_C (u_α : L)) = ι_res α
    rw [hι_res (u_α : L) hu_α_int, hu_α_res]

  have htr_int : ∀ z : M_C, PM 0 z → PL 0 (traceLM F hLM_C z) := by
    intro z hz
    apply hTrBoundMCL 0 z
    exact hPM_mono (by omega) hz

  have htr_frob1 : ∀ z : M_C, PM 0 z →
      resL (traceLM F hLM_C (z ^ (p F))) = (resL (traceLM F hLM_C z)) ^ (p F) := by
    intro z hz
    have hzp_int : PM 0 (z ^ (p F)) := (hresM_pow z (p F) hz).1
    have htr_zp_int : PL 0 (traceLM F hLM_C (z ^ (p F))) := htr_int (z ^ (p F)) hzp_int
    have htr_z_int : PL 0 (traceLM F hLM_C z) := htr_int z hz
    have htr_z_pow := hresL_pow (traceLM F hLM_C z) (p F) htr_z_int
    rw [← htr_z_pow.2]
    exact hresL_eq_of_mem1 htr_zp_int htr_z_pow.1 (hTrFrobMCL z hz)

  have htr_frob_pow : ∀ (d : ℕ) (z : M_C), PM 0 z →
      resL (traceLM F hLM_C (z ^ ((p F) ^ d))) = (resL (traceLM F hLM_C z)) ^ ((p F) ^ d) := by
    intro d
    induction d with
    | zero =>
      intro z _
      rw [pow_zero, pow_one, pow_one]
    | succ d ih =>
      intro z hz
      have hzd_int : PM 0 (z ^ ((p F) ^ d)) := (hresM_pow z ((p F) ^ d) hz).1
      have hpow_eq : z ^ ((p F) ^ (d + 1)) = (z ^ ((p F) ^ d)) ^ (p F) := by
        rw [pow_succ, pow_mul]
      rw [hpow_eq, htr_frob1 (z ^ ((p F) ^ d)) hzd_int, ih z hz, ← pow_mul, ← pow_succ]

  have htr_smul : ∀ (x : L) (z : M_C),
      traceLM F hLM_C (IntermediateField.inclusion hLM_C x * z) = x * traceLM F hLM_C z := by
    intro x z
    letI : Module L L := Semiring.toModule
    change Algebra.trace L (IntermediateField.extendScalars hLM_C)
      (algebraMap L (IntermediateField.extendScalars hLM_C) x * toExtendScalars F hLM_C z) =
      x * Algebra.trace L (IntermediateField.extendScalars hLM_C) (toExtendScalars F hLM_C z)
    rw [← Algebra.smul_def]
    exact (Algebra.trace L (IntermediateField.extendScalars hLM_C)).map_smul' x
      (toExtendScalars F hLM_C z)

  have hψM_eq_ψL : ∀ z : M_C, PM 0 z →
      ψ_M (resM z) = ψ_L (resL (traceLM F hLM_C z)) := by
    intro z hz
    rw [hψM_spec z hz, hψL_spec (traceLM F hLM_C z) (htr_int z hz)]
    change ψ (traceLM F hLM_C (((c₁_M⁻¹ : M_Cˣ) : M_C) * z)) =
      ψ (((c₁⁻¹ : Lˣ) : L) * traceLM F hLM_C z)
    have hc_inv_inc : ((c₁_M⁻¹ : M_Cˣ) : M_C) =
        IntermediateField.inclusion hLM_C ((c₁⁻¹ : Lˣ) : L) := by
      change ((Units.map (IntermediateField.inclusion hLM_C).toMonoidHom c₁)⁻¹ : M_Cˣ).val = _
      rw [← map_inv]
      rfl
    rw [hc_inv_inc, htr_smul]

  have hFrob_lift : ∀ (n : ℕ) (γ_L : k_L),
      (∀ b : k_L, ψ_L (γ_L * b ^ ((p F) ^ n)) = ψ_L b) →
      ∀ w : k_M, ψ_M (ι_res γ_L * w ^ ((p F) ^ n)) = ψ_M w := by
    intro n γ_L hγ w
    set x_γ := liftL γ_L
    set z := liftM w
    have hx_γ : PL 0 x_γ := hliftL_int γ_L
    have hz : PM 0 z := hliftM_int w
    have hzn_pow := hresM_pow z ((p F) ^ n) hz
    have hinc_xγ : PM 0 (IntermediateField.inclusion hLM_C x_γ) := hinc_int hx_γ
    have hmul_int : PM 0 (IntermediateField.inclusion hLM_C x_γ * z ^ ((p F) ^ n)) := by
      simpa using hPM_mul hinc_xγ hzn_pow.1
    have hmul_res : ι_res γ_L * w ^ ((p F) ^ n) =
        resM (IntermediateField.inclusion hLM_C x_γ * z ^ ((p F) ^ n)) := by
      rw [(hresM_ring _ _ hinc_xγ hzn_pow.1).2.1, hι_res x_γ hx_γ, hliftL_res γ_L,
        hzn_pow.2, hliftM_res w]
    have hw_eq : ψ_M w = ψ_L (resL (traceLM F hLM_C z)) := by
      rw [← hliftM_res w]
      exact hψM_eq_ψL z hz
    rw [hmul_res, hw_eq, hψM_eq_ψL _ hmul_int, htr_smul x_γ (z ^ ((p F) ^ n)),
      (hresL_ring x_γ (traceLM F hLM_C (z ^ ((p F) ^ n))) hx_γ (htr_int _ hzn_pow.1)).2.1,
      hliftL_res γ_L, htr_frob_pow n z hz]
    exact hγ (resL (traceLM F hLM_C z))

  
  have hU0_int : ∀ {u : M_Cˣ}, valL F M_C (u : M_C) = 0 → PM 0 (u : M_C) :=
    fun h => hPM_of_val h
  have hU0_mul : ∀ {u v : M_Cˣ}, valL F M_C (u : M_C) = 0 → valL F M_C (v : M_C) = 0 →
      valL F M_C ((u * v : M_Cˣ) : M_C) = 0 ∧
        resM ((u * v : M_Cˣ) : M_C) = resM (u : M_C) * resM (v : M_C) := by
    intro u v hu hv
    have hval : valL F M_C ((u * v : M_Cˣ) : M_C) = 0 := by
      rw [Units.val_mul, hval_mul_M (u : M_C) (v : M_C) (Units.ne_zero u) (Units.ne_zero v),
        hu, hv, add_zero]
    refine ⟨hval, ?_⟩
    rw [Units.val_mul]
    exact (hresM_ring (u : M_C) (v : M_C) (hU0_int hu) (hU0_int hv)).2.1
  have hU0_inv : ∀ {u : M_Cˣ}, valL F M_C (u : M_C) = 0 →
      valL F M_C ((u⁻¹ : M_Cˣ) : M_C) = 0 ∧
        resM ((u⁻¹ : M_Cˣ) : M_C) = (resM (u : M_C))⁻¹ := by
    intro u hu
    have hval : valL F M_C ((u⁻¹ : M_Cˣ) : M_C) = 0 := by
      rw [hval_inv_M u, hu, neg_zero]
    have hres_ne0 : resM (u : M_C) ≠ 0 := by
      intro h0
      rcases (hresM_ker (u : M_C) (hU0_int hu)).mp h0 with h_zero | h_ge1
      · exact Units.ne_zero u h_zero
      · omega
    have hmul1 : resM (u : M_C) * resM ((u⁻¹ : M_Cˣ) : M_C) = 1 := by
      rw [← (hresM_ring (u : M_C) ((u⁻¹ : M_Cˣ) : M_C) (hU0_int hu) (hU0_int hval)).2.1,
        ← Units.val_mul, mul_inv_cancel, Units.val_one, hresM_1]
    refine ⟨hval, ?_⟩
    calc resM ((u⁻¹ : M_Cˣ) : M_C)
      _ = 1 * resM ((u⁻¹ : M_Cˣ) : M_C) := (one_mul _).symm
      _ = ((resM (u : M_C))⁻¹ * resM (u : M_C)) * resM ((u⁻¹ : M_Cˣ) : M_C) := by
          rw [inv_mul_cancel₀ hres_ne0]
      _ = (resM (u : M_C))⁻¹ * (resM (u : M_C) * resM ((u⁻¹ : M_Cˣ) : M_C)) := by ring
      _ = (resM (u : M_C))⁻¹ * 1 := by rw [hmul1]
      _ = (resM (u : M_C))⁻¹ := mul_one _
  have hU0_pow : ∀ (u : M_Cˣ) (n : ℕ), valL F M_C (u : M_C) = 0 →
      valL F M_C ((u ^ n : M_Cˣ) : M_C) = 0 ∧
        resM ((u ^ n : M_Cˣ) : M_C) = (resM (u : M_C)) ^ n := by
    intro u n hu
    induction n with
    | zero =>
      rw [pow_zero, pow_zero, Units.val_one, hval1_M, hresM_1]
      exact ⟨rfl, rfl⟩
    | succ n ih =>
      rw [pow_succ, pow_succ]
      have h := hU0_mul ih.1 hu
      exact ⟨h.1, by rw [h.2, ih.2]⟩
  have hU0_prod : ∀ {ι : Type} (s : Finset ι) (f : ι → M_Cˣ),
      (∀ i ∈ s, valL F M_C (f i : M_C) = 0) →
      valL F M_C ((∏ i ∈ s, f i : M_Cˣ) : M_C) = 0 ∧
        resM ((∏ i ∈ s, f i : M_Cˣ) : M_C) = ∏ i ∈ s, resM (f i : M_C) := by
    intro ι s f hf
    induction s using Finset.induction_on with
    | empty =>
      rw [Finset.prod_empty, Finset.prod_empty, Units.val_one, hval1_M, hresM_1]
      exact ⟨rfl, rfl⟩
    | @insert a s ha ih =>
      rw [Finset.prod_insert ha, Finset.prod_insert ha]
      have ha_val := hf a (Finset.mem_insert_self a s)
      have hs := ih (fun i hi => hf i (Finset.mem_insert_of_mem hi))
      have h := hU0_mul ha_val hs.1
      exact ⟨h.1, by rw [h.2, hs.2]⟩

  let a_bar : Fin r_exp → k_M := fun m => resM (a_coeff m)
  let β : Fin (q - 1) → k_M := fun j => resM ((u_all j : M_Cˣ) : M_C)

  have hβ_inj : Function.Injective β := by
    intro j₁ j₂ hβ_eq
    apply hu_all_inj j₁ j₂
    exact hresM_sub_mem1 (hU0_int (hu_all_val j₁)) (hU0_int (hu_all_val j₂)) hβ_eq

  have hβ_ne : ∀ j : Fin (q - 1), β j ≠ 0 := by
    intro j h0
    rcases (hresM_ker (u_all j : M_C) (hU0_int (hu_all_val j))).mp h0 with h_zero | h_ge1
    · exact Units.ne_zero (u_all j) h_zero
    · have hval0 := hu_all_val j
      omega

  have hP_res_gen : ∀ z₀ : M_C, PM 0 z₀ →
      PM 0 (P_poly z₀) ∧
        resM (P_poly z₀) =
          (resM z₀) ^ q + ∑ m : Fin r_exp, a_bar m * ((resM z₀) ^ ((p F) ^ (m : ℕ))) := by
    intro z₀ hz₀
    have hterm : ∀ m : Fin r_exp,
        PM 0 (a_coeff m * z₀ ^ ((p F) ^ (m : ℕ))) ∧
          resM (a_coeff m * z₀ ^ ((p F) ^ (m : ℕ))) =
            a_bar m * (resM z₀) ^ ((p F) ^ (m : ℕ)) := by
      intro m
      have hm_pow := hresM_pow z₀ ((p F) ^ (m : ℕ)) hz₀
      have hm_int : PM 0 (a_coeff m * z₀ ^ ((p F) ^ (m : ℕ))) := by
        simpa using hPM_mul (ha_int m) hm_pow.1
      refine ⟨hm_int, ?_⟩
      rw [(hresM_ring (a_coeff m) (z₀ ^ ((p F) ^ (m : ℕ))) (ha_int m) hm_pow.1).2.1, hm_pow.2]
    have hsum := @hresM_sum (Fin r_exp) Finset.univ
      (fun m : Fin r_exp => a_coeff m * z₀ ^ ((p F) ^ (m : ℕ)))
      (fun m _ => (hterm m).1)
    have hzq := hresM_pow z₀ q hz₀
    have hP_int : PM 0 (P_poly z₀) := by
      rw [hP_def z₀]
      exact hPM_add hzq.1 hsum.1
    refine ⟨hP_int, ?_⟩
    rw [hP_def z₀, (hresM_ring (z₀ ^ q) _ hzq.1 hsum.1).1, hzq.2, hsum.2]
    refine congrArg ((resM z₀) ^ q + ·) (Finset.sum_congr rfl fun m _ => (hterm m).2)

  have hβ_P : ∀ j : Fin (q - 1), ∀ z : k_M,
      ψ_M (β j * (z ^ q + ∑ m : Fin r_exp, a_bar m * (z ^ ((p F) ^ (m : ℕ))))) = 1 := by
    intro j z
    set z₀ := liftM z
    have hz₀ : PM 0 z₀ := hliftM_int z
    have hP := hP_res_gen z₀ hz₀
    have hu_int : PM 0 (u_all j : M_C) := hU0_int (hu_all_val j)
    have huP_int : PM 0 ((u_all j : M_C) * P_poly z₀) := by
      simpa using hPM_mul hu_int hP.1
    have huP_res : resM ((u_all j : M_C) * P_poly z₀) =
        β j * (z ^ q + ∑ m : Fin r_exp, a_bar m * (z ^ ((p F) ^ (m : ℕ)))) := by
      rw [(hresM_ring (u_all j : M_C) (P_poly z₀) hu_int hP.1).2.1, hP.2, hliftM_res z]
    rw [← huP_res, hψM_spec ((u_all j : M_C) * P_poly z₀) huP_int]
    exact hu_all_P j z₀ hz₀

  have hBridge_Y0 : (a_bar ⟨0, hr_exp_pos⟩ ≠ 0 ∧
      (∏ j : Fin (q - 1), β j) * ((ι_res α) ^ q)⁻¹ * (a_bar ⟨0, hr_exp_pos⟩) ^ q = 1) →
      ∃ u_ω : M_Cˣ,
        valL F M_C (u_ω : M_C) = 0 ∧
        (u_ω : M_C) = (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K) ∧
        (∏ j : Fin (q - 1), u_all j) *
          (Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (u_α ^ q))⁻¹ *
          (u_ω ^ q) ∈ unitGroup F M_C 1 := by
    rintro ⟨ha0_ne0, hVieta_eq⟩
    set w_ω : M_C := (((ϖ_MC ^ t)⁻¹ : M_Cˣ) : M_C) * traceLM F hM_CK ((ϖ_K ^ t : Kˣ) : K)
    have hw_ω_int : PM 0 w_ω := hPM_of_val hTr_val0
    have hw_ω_res : resM w_ω = a_bar ⟨0, hr_exp_pos⟩ :=
      (hresM_eq_of_mem1 (ha_int ⟨0, hr_exp_pos⟩) hw_ω_int ha0_tr).symm
    have hw_ω_ne0 : w_ω ≠ 0 := by
      intro h0
      apply ha0_ne0
      rw [← hw_ω_res, h0, hresM_0]
    let u_ω : M_Cˣ := Units.mk0 w_ω hw_ω_ne0
    have hu_ω_val : valL F M_C (u_ω : M_C) = 0 := hTr_val0
    have hu_ω_res : resM (u_ω : M_C) = a_bar ⟨0, hr_exp_pos⟩ := hw_ω_res
    refine ⟨u_ω, hu_ω_val, rfl, ?_⟩
    have hmap_pow : Units.map (IntermediateField.inclusion hLM_C).toMonoidHom (u_α ^ q) =
        u_α_M ^ q := map_pow _ u_α q
    rw [hmap_pow]
    set U : M_Cˣ := (∏ j : Fin (q - 1), u_all j) * (u_α_M ^ q)⁻¹ * (u_ω ^ q)
    have hprod_u := @hU0_prod (Fin (q - 1)) Finset.univ u_all (fun j _ => hu_all_val j)
    have huα_pow := hU0_pow u_α_M q hu_α_M_val
    have huα_inv := hU0_inv huα_pow.1
    have huω_pow := hU0_pow u_ω q hu_ω_val
    have hmul1 := hU0_mul hprod_u.1 huα_inv.1
    have hU := hU0_mul hmul1.1 huω_pow.1
    have hU_res1 : resM (U : M_C) = resM 1 := by
      rw [hU.2, hmul1.2, hprod_u.2, huα_inv.2, huα_pow.2, hu_α_M_res, huω_pow.2, hu_ω_res, hresM_1]
      exact hVieta_eq
    have hU_mem1 : PM 1 ((U : M_C) - 1) :=
      hresM_sub_mem1 (hU0_int hU.1) hPM_one hU_res1
    rw [hunit_ge1_M 1 le_rfl U]
    rcases hU_mem1 with h0 | hge1
    · left; exact sub_eq_zero.mp h0
    · right; exact hge1

  have hBridge_crit :
      ∀ (U_θ : Lˣ) (u_ϖ z_η : M_Cˣ) (x₀ s₀ : L),
        valL F L (U_θ : L) = 0 →
        valL F M_C (u_ϖ : M_C) = 0 →
        valL F M_C (z_η : M_C) = 0 →
        (z_η ^ q) * u_ϖ⁻¹ ∈ unitGroup F M_C 1 →
        (x₀ = 0 ∨ 0 ≤ valL F L x₀) →
        (s₀ = 0 ∨ 0 ≤ valL F L s₀) →
        (IntermediateField.inclusion hLM_C s₀ * (u_ϖ : M_C) -
          P_poly (IntermediateField.inclusion hLM_C x₀ * (z_η : M_C)) = 0 ∨
          1 ≤ valL F M_C
            (IntermediateField.inclusion hLM_C s₀ * (u_ϖ : M_C) -
              P_poly (IntermediateField.inclusion hLM_C x₀ * (z_η : M_C)))) →
        (resM (z_η : M_C)) ^ q = resM (u_ϖ : M_C) ∧
        ι_res (resL s₀) * resM (u_ϖ : M_C) =
          (ι_res (resL x₀) * resM (z_η : M_C)) ^ q +
            ∑ m : Fin r_exp, a_bar m * (ι_res (resL x₀) * resM (z_η : M_C)) ^ ((p F) ^ (m : ℕ)) ∧
        (ψ_L (resL s₀) = ψ_L (resL (U_θ : L) * (resL x₀) ^ q) →
          ψ (((c₁⁻¹ : Lˣ) : L) * s₀) =
            ψ (((c₁⁻¹ : Lˣ) : L) * ((U_θ : L) * (x₀ ^ q)))) := by
    intro U_θ u_ϖ z_η x₀ s₀ hU_θ_val hu_ϖ_val hz_η_val hz_η_pow hx₀ hs₀ hs₀_poly
    refine ⟨?_, ?_, ?_⟩
    · set W_η : M_Cˣ := (z_η ^ q) * u_ϖ⁻¹
      have hW_val0 : valL F M_C (W_η : M_C) = 0 := hunit_val0_M 1 W_η hz_η_pow
      have hW_mem1 : PM 1 ((W_η : M_C) - 1) := by
        rcases (hunit_ge1_M 1 le_rfl W_η).mp hz_η_pow with h1 | hge1
        · left; exact sub_eq_zero.mpr h1
        · right; exact hge1
      have hW_res1 : resM (W_η : M_C) = 1 := by
        rw [hresM_eq_of_mem1 (hU0_int hW_val0) hPM_one hW_mem1, hresM_1]
      have hW_eq : W_η * u_ϖ = z_η ^ q := inv_mul_cancel_right (z_η ^ q) u_ϖ
      have hzq := hU0_pow z_η q hz_η_val
      have hWu := hU0_mul hW_val0 hu_ϖ_val
      rw [← hzq.2, ← hW_eq, hWu.2, hW_res1, one_mul]
    · set z₀ : M_C := IntermediateField.inclusion hLM_C x₀ * (z_η : M_C)
      set lhs₀ : M_C := IntermediateField.inclusion hLM_C s₀ * (u_ϖ : M_C)
      have hx₀_M : PM 0 (IntermediateField.inclusion hLM_C x₀) := hinc_int hx₀
      have hs₀_M : PM 0 (IntermediateField.inclusion hLM_C s₀) := hinc_int hs₀
      have hz_η_int : PM 0 (z_η : M_C) := hU0_int hz_η_val
      have hu_ϖ_int : PM 0 (u_ϖ : M_C) := hU0_int hu_ϖ_val
      have hz₀_int : PM 0 z₀ := by simpa using hPM_mul hx₀_M hz_η_int
      have hlhs₀_int : PM 0 lhs₀ := by simpa using hPM_mul hs₀_M hu_ϖ_int
      have hz₀_res : resM z₀ = ι_res (resL x₀) * resM (z_η : M_C) := by
        rw [(hresM_ring _ _ hx₀_M hz_η_int).2.1, hι_res x₀ hx₀]
      have hlhs₀_res : resM lhs₀ = ι_res (resL s₀) * resM (u_ϖ : M_C) := by
        rw [(hresM_ring _ _ hs₀_M hu_ϖ_int).2.1, hι_res s₀ hs₀]
      have hP := hP_res_gen z₀ hz₀_int
      have h_eq_res : resM lhs₀ = resM (P_poly z₀) :=
        hresM_eq_of_mem1 hlhs₀_int hP.1 hs₀_poly
      rw [← hlhs₀_res, h_eq_res, hP.2, hz₀_res]
    · intro hψL_eq
      have hU_θ_int : PL 0 (U_θ : L) := hPL_of_val hU_θ_val
      have hx₀_pow := hresL_pow x₀ q hx₀
      have hUx₀_int : PL 0 ((U_θ : L) * (x₀ ^ q)) := by
        simpa using hPL_mul hU_θ_int hx₀_pow.1
      have hUx₀_res : resL ((U_θ : L) * (x₀ ^ q)) = resL (U_θ : L) * (resL x₀) ^ q := by
        rw [(hresL_ring (U_θ : L) (x₀ ^ q) hU_θ_int hx₀_pow.1).2.1, hx₀_pow.2]
      rw [← hψL_spec s₀ hs₀, ← hψL_spec ((U_θ : L) * (x₀ ^ q)) hUx₀_int, hUx₀_res]
      exact hψL_eq

  exact ⟨u_α, k_L, hField_kL, hFin_kL, resL, k_M, hField_kM, hFin_kM, resM,
    ι_res, ψ_L, ψ_M, α, a_bar, β,
    hu_α_val, hu_α_frob,
    hresL_0, hresL_1, hresL_ring, hresL_ker,
    hresM_0, hresM_1, hresM_ring, hresM_ker,
    hι_res, fun _ => rfl,
    hp_kL, hp_kM,
    hψL_0, hψL_add, ⟨a₀, ha₀_ne1⟩,
    hψM_0, hψM_add, hψM_ne,
    hα_ne0, hα_frob_kL, hFrob_lift,
    hβ_inj, hβ_ne, hβ_P, hBridge_Y0, hBridge_crit⟩

theorem ld_ch14_critical_orbit_lagrange_and_prod_bridge (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K M_C : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F M_C] [FiniteDimensional F K]
    (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (ψ : AddChar L (Ω F))
    (D_orb : List (MonomialTerm F L))
    (hFinFi : ∀ i : Fin D_orb.length, FiniteDimensional F (D_orb.get i).field)
    (χ' : Lˣ →* (Ω F)ˣ) (h_ge2 : 2 ≤ condExp F L χ')
    (hFiMC : ∀ i : Fin D_orb.length, (D_orb.get i).field ≤ M_C)
    (μ'_orb : ∀ i : Fin D_orb.length, ((D_orb.get i).field)ˣ →* (Ω F)ˣ)
    (ν_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      (M_Cˣ →* (Ω F)ˣ))
    (σ_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      (M_C ≃ₐ[F] M_C))
    (idx_all : Fin (Module.finrank M_C (IntermediateField.extendScalars hM_CK) - 1) →
      Fin D_orb.length)
    (hν_props : ∀ j,
      ν_all j ≠ 1 ∧
      (ν_all j) ^ (p F) = 1 ∧
      (∀ x : L, (σ_all j) (IntermediateField.inclusion hLM_C x) =
        IntermediateField.inclusion hLM_C x) ∧
