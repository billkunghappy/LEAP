  have hcν₁_inv_eq : ((c_ν₁⁻¹ : Lˣ) : L) = ((α⁻¹ : Lˣ) : L) * β₁ := by
    dsimp [c_ν₁]
    rw [mul_inv_rev, inv_inv, Units.val_mul, Units.val_mk0, mul_comm]
  
  have hginv_val : valL F L g⁻¹ = 2 * (r : ℤ) - 1 := by
    have := hval_inv (Units.mk0 g hg_ne)
    change valL F L g⁻¹ = - valL F L g at this
    rw [this, hg_val]; ring
  have hP_ginv : g⁻¹ = 0 ∨ (2 * (r : ℤ) - 1) ≤ valL F L g⁻¹ := Or.inr (le_of_eq hginv_val.symm)
  have hα_inv_val : valL F L ((α⁻¹ : Lˣ) : L) = -(2 * (r : ℤ) + condExpChar F L ψ) := by
    rw [hval_inv α, hα_val, hT2_eq]
  have hα_inv_ne : ((α⁻¹ : Lˣ) : L) ≠ 0 := Units.ne_zero _
  have hψ_triv_2r : ∀ z : L, (z = 0 ∨ 2 * (r : ℤ) ≤ valL F L z) →
      ψ (((α⁻¹ : Lˣ) : L) * z) = 1 := by
    intro z hz
    rcases hz with rfl | hz
    · rw [mul_zero, AddChar.map_zero_eq_one]
    · by_cases hz0 : z = 0
      · rw [hz0, mul_zero, AddChar.map_zero_eq_one]
      · apply hSpecL.1
        right
        rw [hval_mul _ _ hα_inv_ne hz0, hα_inv_val]
        omega
  have hψ_eq_2r : ∀ z₁ z₂ : L, (z₁ - z₂ = 0 ∨ 2 * (r : ℤ) ≤ valL F L (z₁ - z₂)) →
      ψ (((α⁻¹ : Lˣ) : L) * z₁) = ψ (((α⁻¹ : Lˣ) : L) * z₂) := by
    intro z₁ z₂ hsub
    have hsplit : ((α⁻¹ : Lˣ) : L) * z₁ = ((α⁻¹ : Lˣ) : L) * z₂ + ((α⁻¹ : Lˣ) : L) * (z₁ - z₂) := by ring
    rw [hsplit, AddChar.map_add_eq_mul, hψ_triv_2r _ hsub, mul_one]
  have hψ_neg_eq1 : ∀ z : L, ψ (-z) = 1 → ψ z = 1 := by
    intro z hz
    have h0 : ψ (z + -z) = 1 := by rw [add_neg_cancel, AddChar.map_zero_eq_one]
    rw [AddChar.map_add_eq_mul, hz, mul_one] at h0
    exact h0
  have hψ_sub_eq1 : ∀ z₁ z₂ : L, ψ z₁ = 1 → ψ z₂ = 1 → ψ (z₁ - z₂) = 1 := by
    intro z₁ z₂ h1 h2
    have h2' : ψ (-z₂) = 1 := by
      have h0 : ψ (z₂ + -z₂) = 1 := by rw [add_neg_cancel, AddChar.map_zero_eq_one]
      rw [AddChar.map_add_eq_mul, h2, one_mul] at h0
      exact h0
    rw [sub_eq_add_neg, AddChar.map_add_eq_mul, h1, h2', mul_one]
  have hνE'_pow2 : νE' ^ 2 = 1 := hdeg2 ▸ hνE'_pow
  have hE'_sq : ∀ t : L, (t = 0 ∨ (r : ℤ) ≤ 2 * valL F L t) →
      ψ (((α⁻¹ : Lˣ) : L) * (β₂ * (2 * t + t ^ 2))) = 1 := by
    intro t ht
