      change (k' : ℤ) * -(t : ℤ) +
        (t' : ℤ) * valL F (D_orb.get i).field (IntermediateField.inclusion (D_orb.get i).le (ϖ_L : L)) = 0
      rw [hValAlgFiL i (ϖ_L : L), hϖ_L, mul_one]
      have htk_z : (k' : ℤ) * (t : ℤ) = (t' : ℤ) * (k : ℤ) := by exact_mod_cast htk
      linarith
    refine ⟨hval0, ?_⟩
    intro hres0
    rcases ((hresFi_map i).2.2.2.1 _ (Or.inr (by omega))).mp hres0 with h_zero | h_ge1
    · exact Units.ne_zero (Θ_gen t' k' i) h_zero
    · omega

