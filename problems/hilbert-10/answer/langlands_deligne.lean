  have hquad_bound_any : ∀ w : K₁, (w = 0 ∨ (d_E : ℤ) ≤ valL F K₁ w) →
      let u := normLM F hM₁'K₁ (1 + w) - 1
      ((2 * u - u ^ 2) - traceLM F hM₁'K₁ (2 * w - w ^ 2) = 0 ∨
        (mM₁' : ℤ) ≤ valL F M₁' ((2 * u - u ^ 2) - traceLM F hM₁'K₁ (2 * w - w ^ 2))) ∧
      (2 * u - u ^ 2 = 0 ∨ (d_U : ℤ) ≤ valL F M₁' (2 * u - u ^ 2)) := by
    intro w hw
    dsimp only
    set u := normLM F hM₁'K₁ (1 + w) - 1
