      exact hval_add_L 0 1 ((2 : L) * c) (Or.inr (by rw [hval1_L])) h2c
    have hRy_val : R_y = 0 ∨ 2 * (r_U : ℤ) ≤ valL F L R_y := by
      have hty2 : t_y ^ 2 = 0 ∨ (r_U : ℤ) + (r_U : ℤ) ≤ valL F L (t_y ^ 2) := by
        rw [sq t_y]
        exact hmul_val_ge L (r_U : ℤ) (r_U : ℤ) t_y t_y ht_y_rU ht_y_rU
      have h12c_ny := hmul_int L (r_U : ℤ) n_y (1 + (2 : L) * c) hn_y_rU h12c_int_L
      rw [mul_comm] at h12c_ny
      have hc_ny := hmul_int L (r_U : ℤ) n_y c hn_y_rU hc_int_L
      rw [mul_comm] at hc_ny
      have hty_cny := hval_add_L (r_U : ℤ) t_y (c * n_y) ht_y_rU hc_ny
      have hprod := hmul_val_ge L (r_U : ℤ) (r_U : ℤ)
        ((1 + (2 : L) * c) * n_y) (t_y + c * n_y) h12c_ny hty_cny
      have hsum := hval_add_L ((r_U : ℤ) + (r_U : ℤ)) _ _ hty2 hprod
      have hR := hmul_int L ((r_U : ℤ) + (r_U : ℤ)) _ c hsum hc_int_L
      rw [mul_comm] at hR
      exact hmono_val L (by omega) hR
    have hψ_ARy : ψ (((c_ν⁻¹ : Lˣ) : L) * A * R_y) = 1 := by
      have hcA := hmul_val_ge L (-((T : ℤ) + n)) (-((h : ℕ) : ℤ)) _ A hc_ν_inv_val hA_bound
      have hcAR := hmul_val_ge L (-((T : ℤ) + n) + -((h : ℕ) : ℤ)) (2 * (r_U : ℤ))
        _ R_y hcA hRy_val
      exact hψ_triv _ (hmono_val L (by omega) hcAR)
    have hfactor_A : ψM₁' term_A = ψ (((c_ν⁻¹ : Lˣ) : L) * A * (t_y + n_y)) := by
      change ψ (traceLM F hLM₁' (IntermediateField.inclusion hLM₁' (((c_ν⁻¹ : Lˣ) : L) * A) * z₂)) = _
      rw [htr_smul L M₁' hLM₁' (((c_ν⁻¹ : Lˣ) : L) * A) z₂, htr_z₂, hcancel_L]
      have hsplit_A : ((c_ν⁻¹ : Lˣ) : L) * A * ((t_y + n_y) + R_y) =
          ((c_ν⁻¹ : Lˣ) : L) * A * (t_y + n_y) + ((c_ν⁻¹ : Lˣ) : L) * A * R_y := by
        ring
      rw [hsplit_A, AddChar.map_add_eq_mul, hψ_ARy, mul_one]
    
    change (θE' u_1y : Ω F) = ψ (((c_ν⁻¹ : Lˣ) : L) * ((A + c) * t_y + A * n_y))
    rw [hθ_step1, hθ_step2, hsplit_cM₁', AddChar.map_add_eq_mul, AddChar.map_add_eq_mul,
      hfactor_A, hfactor_b, hfactor_d2, mul_one, ← AddChar.map_add_eq_mul]
    congr 1
    ring

theorem ld_ch12_wild_dyadic_unramified_cE_stat_and_crit_deductions (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (ψ : AddChar L (Ω F))
    (hψ_triv : ∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1)
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hνM₁'_val : ∀ x : Lˣ, (νM₁' x : Ω F) = (-1 : Ω F) ^ (valL F L (x : L)))
    (θE' : E'ˣ →* (Ω F)ˣ) (θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hCommonRest : ∀ x : Lˣ,
      θE' (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) * νE' x =
      θM₁' (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x) * νM₁' x)
    (hT_le : condExp F L νE' ≤ condExp F M₁' θM₁')
    (hmE'_eq : condExp F E' θE' = condExp F L νE' + 2 * (condExp F M₁' θM₁' - condExp F L νE'))
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (htr_bound_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨ 2 * m - (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (c : L) (σ_E : E' ≃ₐ[F] E')
    (hc_val : valL F L c = 0)
    (hσ_E_val : ∀ y : E', valL F E' (σ_E y) = valL F E' y)
    (hσ_E_tr : ∀ y : E', IntermediateField.inclusion hLE' (traceLM F hLE' y) = y + σ_E y)
    (hσ_E_norm : ∀ y : E', IntermediateField.inclusion hLE' (normLM F hLE' y) = y * σ_E y)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (c_ν : Lˣ) (x : E') (cM₁' : M₁'ˣ) (cE' : E'ˣ)
    (hc_ν_val : valL F L (c_ν : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_ν_stat : ∀ u : L, (u = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((c_ν⁻¹ : Lˣ) : L) * u))
    (hcM₁'_stat : ∀ z : M₁',
      (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁') * z))
    (hb_val : traceLM F hLE' x = 0 ∨
      (condExp F L νE' : ℤ) - (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤
        valL F L (traceLM F hLE' x))
    (hx_zero : condExp F M₁' θM₁' - condExp F L νE' = 0 → (x = 0 ∨ 0 ≤ valL F E' x))
    (hx_pos : 0 < condExp F M₁' θM₁' - condExp F L νE' →
      x ≠ 0 ∧
      valL F E' x = -((condExp F M₁' θM₁' - condExp F L νE' : ℕ) : ℤ) ∧
      valL F L (normLM F hLE' x) = -((condExp F M₁' θM₁' - condExp F L νE' : ℕ) : ℤ))
    (hcE'_inv_zero : condExp F M₁' θM₁' - condExp F L νE' = 0 →
      ((cE'⁻¹ : E'ˣ) : E') =
        IntermediateField.inclusion hLE' ((c_ν⁻¹ : Lˣ) : L) *
          (x ^ 2 + x - IntermediateField.inclusion hLE' c))
    (hcE'_inv_pos : 0 < condExp F M₁' θM₁' - condExp F L νE' →
      ((cE'⁻¹ : E'ˣ) : E') =
        IntermediateField.inclusion hLE' ((c_ν⁻¹ : Lˣ) : L) *
          (σ_E x * x⁻¹ * (x ^ 2 + x - IntermediateField.inclusion hLE' c)))
    (hTrDiff_pos : 0 < condExp F M₁' θM₁' - condExp F L νE' →
      traceLM F hLM₁' (IntermediateField.inclusion hLM₁' (c_ν : L) * ((cM₁'⁻¹ : M₁'ˣ) : M₁')) -
        traceLM F hLE' (IntermediateField.inclusion hLE' (c_ν : L) * ((cE'⁻¹ : E'ˣ) : E')) - 1 =
        c * ((traceLM F hLE' x) ^ 2 * (normLM F hLE' x)⁻¹))
    (hMaster : ∀ y : E',
      (y = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' y) →
      (y = 0 ∨ (condExp F E' θE' : ℤ) ≤ 3 * valL F E' y) →
      (y = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' y) →
      (y = 0 ∨
        2 * (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) - (condExp F L νE' : ℤ) ≤ valL F E' y) →
      ∀ hy : 1 + y ≠ 0,
        (θE' (Units.mk0 (1 + y) hy) : Ω F) =
          ψ (((c_ν⁻¹ : Lˣ) : L) *
            ((normLM F hLE' x + c) * traceLM F hLE' y +
              normLM F hLE' x * normLM F hLE' y))) :
    let T := condExp F L νE'
    let mM₁' := condExp F M₁' θM₁'
    let mE' := condExp F E' θE'
    let h := mM₁' - T
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    (∀ y : E', (y = 0 ∨ (((mE' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' y) →
      ∀ hy : 1 + y ≠ 0,
        (θE' (Units.mk0 (1 + y) hy) : Ω F) = ψE' (((cE'⁻¹ : E'ˣ) : E') * y)) ∧
    (0 < h →
      (∀ u : L, (u = 0 ∨ ((mM₁' / 2 : ℕ) : ℤ) ≤ valL F L u) →
        ∀ hu : 1 + IntermediateField.inclusion hLM₁' u ≠ 0,
          (θM₁' (Units.mk0 (1 + IntermediateField.inclusion hLM₁' u) hu) : Ω F)⁻¹ *
            ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * IntermediateField.inclusion hLM₁' u) = 1) ∧
      (T % 2 = 1 →
        ∀ v : E', (v = 0 ∨ ((mE' / 2 : ℕ) : ℤ) ≤ valL F E' v) →
          ∀ (hv : 1 + v ≠ 0) (hw : 1 + normLM F hLE' (x * v) ≠ 0),
            (θE' (Units.mk0 (1 + v) hv) : Ω F)⁻¹ * ψE' (((cE'⁻¹ : E'ˣ) : E') * v) =
              ((νE' (Units.mk0 (1 + normLM F hLE' (x * v)) hw) : Ω F)⁻¹ *
                ψ (((c_ν⁻¹ : Lˣ) : L) * normLM F hLE' (x * v)))⁻¹)) :=
by
  intro T mM₁' mE' h ψE' ψM₁'
  let A : L := normLM F hLE' x
  let b : L := traceLM F hLE' x
  let r_T : ℕ := (T + 1) / 2
  let r_U : ℕ := (mM₁' + 1) / 2
  let r_E : ℕ := (mE' + 1) / 2
  have hT_ge2 : 2 ≤ T := hbE'_ge2
  have hT_le_mM : T ≤ mM₁' := hT_le
  have hmE'_def : mE' = T + 2 * h := hmE'_eq
  have hh_def : h = mM₁' - T := rfl
  have hr_T_def : r_T = (T + 1) / 2 := rfl
  have hr_U_def : r_U = (mM₁' + 1) / 2 := rfl
  have hr_E_def : r_E = (mE' + 1) / 2 := rfl
  have hb_val' : b = 0 ∨ (T : ℤ) - (r_U : ℤ) ≤ valL F L b := hb_val
  have hx_zero' : h = 0 → (x = 0 ∨ (0 : ℤ) ≤ valL F E' x) := hx_zero
  have hx_pos' : 0 < h →
      x ≠ 0 ∧ valL F E' x = -((h : ℕ) : ℤ) ∧ valL F L A = -((h : ℕ) : ℤ) := hx_pos
  obtain ⟨hvalL_0, hvalL_1, _, hvalL_neg, hvalL_mul, hvalL_inv, _, hvalL_add, _,
    hunitL_mem, hunitL_val⟩ := ld_valL_and_unitGroup_props F L
  obtain ⟨hvalE'_0, hvalE'_1, _, hvalE'_neg, hvalE'_mul, hvalE'_inv, _, hvalE'_add, _, _, _⟩ :=
    ld_valL_and_unitGroup_props F E'
  have hvalL_mul_bound : ∀ (k₁ k₂ : ℤ) (a₁ a₂ : L),
      (a₁ = 0 ∨ k₁ ≤ valL F L a₁) → (a₂ = 0 ∨ k₂ ≤ valL F L a₂) →
        (a₁ * a₂ = 0 ∨ k₁ + k₂ ≤ valL F L (a₁ * a₂)) := by
    intro k₁ k₂ a₁ a₂ ha₁ ha₂
    by_cases h1 : a₁ = 0
    · left; rw [h1, zero_mul]
    · by_cases h2 : a₂ = 0
      · left; rw [h2, mul_zero]
      · right
        rcases ha₁ with rfl | hle₁; · contradiction
        rcases ha₂ with rfl | hle₂; · contradiction
        rw [hvalL_mul a₁ a₂ h1 h2]
        omega
  have hvalE'_mul_bound : ∀ (k₁ k₂ : ℤ) (y₁ y₂ : E'),
      (y₁ = 0 ∨ k₁ ≤ valL F E' y₁) → (y₂ = 0 ∨ k₂ ≤ valL F E' y₂) →
        (y₁ * y₂ = 0 ∨ k₁ + k₂ ≤ valL F E' (y₁ * y₂)) := by
    intro k₁ k₂ y₁ y₂ hy₁ hy₂
    by_cases h1 : y₁ = 0
    · left; rw [h1, zero_mul]
    · by_cases h2 : y₂ = 0
      · left; rw [h2, mul_zero]
      · right
        rcases hy₁ with rfl | hle₁; · contradiction
        rcases hy₂ with rfl | hle₂; · contradiction
        rw [hvalE'_mul y₁ y₂ h1 h2]
        omega
  have hone_add_ne_zero_L : ∀ a : L, (a = 0 ∨ (1 : ℤ) ≤ valL F L a) → 1 + a ≠ 0 := by
    intro a ha h0
    have ha_eq : -a = 1 := by linear_combination -h0
    rcases ha with rfl | hle
    · norm_num at h0
    · have hval : valL F L a = 0 := by
        rw [← hvalL_neg, ha_eq, hvalL_1]
      omega
  have hone_add_ne_zero_E' : ∀ y : E', (y = 0 ∨ (1 : ℤ) ≤ valL F E' y) → 1 + y ≠ 0 := by
    intro y hy h0
    have hy_eq : -y = 1 := by linear_combination -h0
    rcases hy with rfl | hle
    · norm_num at h0
    · have hval : valL F E' y = 0 := by
        rw [← hvalE'_neg, hy_eq, hvalE'_1]
      omega
  have hvalL_one_add_eq_zero : ∀ (a : L) (ha : a = 0 ∨ (1 : ℤ) ≤ valL F L a)
      (ha1 : 1 + a ≠ 0), valL F L (1 + a) = 0 := by
    intro a ha ha1
    have hmem : Units.mk0 (1 + a) ha1 ∈ unitGroup F L 1 := by
      rw [hunitL_mem 1 (by omega)]
      rcases ha with rfl | hle
      · left; simp [Units.val_mk0]
      · right; simp [Units.val_mk0, hle]
    simpa [Units.val_mk0] using hunitL_val 1 (Units.mk0 (1 + a) ha1) hmem
  have hψ_triv_T : ∀ a : L, (a = 0 ∨ (T : ℤ) ≤ valL F L a) →
      ψ (((c_ν⁻¹ : Lˣ) : L) * a) = 1 := by
    intro a ha
    apply hψ_triv
    have hbound := hvalL_mul_bound (-((T : ℤ) + condExpChar F L ψ)) (T : ℤ)
      ((c_ν⁻¹ : Lˣ) : L) a
      (Or.inr (by rw [hvalL_inv, hc_ν_val])) ha
    rcases hbound with h0 | hle
    · exact Or.inl h0
    · exact Or.inr (by omega)
  have hψ_congr_T : ∀ a₁ a₂ : L, (a₁ - a₂ = 0 ∨ (T : ℤ) ≤ valL F L (a₁ - a₂)) →
      ψ (((c_ν⁻¹ : Lˣ) : L) * a₁) = ψ (((c_ν⁻¹ : Lˣ) : L) * a₂) := by
    intro a₁ a₂ hdiff
    have h1 : ((c_ν⁻¹ : Lˣ) : L) * a₁ =
        ((c_ν⁻¹ : Lˣ) : L) * (a₁ - a₂) + ((c_ν⁻¹ : Lˣ) : L) * a₂ := by ring
    rw [h1, AddChar.map_add_eq_mul, hψ_triv_T (a₁ - a₂) hdiff, one_mul]
  have htr_smul_E' : ∀ (a : L) (y : E'),
      traceLM F hLE' (IntermediateField.inclusion hLE' a * y) = a * traceLM F hLE' y := by
    intro a y
    letI : Module L L := Semiring.toModule
    exact (Algebra.trace L (IntermediateField.extendScalars hLE')).map_smul' a
      (toExtendScalars F hLE' y)
  have htr_smul_M₁' : ∀ (a : L) (z : M₁'),
      traceLM F hLM₁' (IntermediateField.inclusion hLM₁' a * z) = a * traceLM F hLM₁' z := by
    intro a z
    letI : Module L L := Semiring.toModule
    exact (Algebra.trace L (IntermediateField.extendScalars hLM₁')).map_smul' a
      (toExtendScalars F hLM₁' z)
  have hnorm_zero_E' : normLM F hLE' 0 = 0 := by
    apply (IntermediateField.inclusion hLE').injective
    change IntermediateField.inclusion hLE' (normLM F hLE' 0) = IntermediateField.inclusion hLE' 0
    rw [hσ_E_norm 0, zero_mul, map_zero]
  have hnorm_σx : normLM F hLE' (σ_E x) = A := by
    have hσx_eq : σ_E x = IntermediateField.inclusion hLE' b - x := by
      linear_combination (hσ_E_tr x).symm
    rw [hσx_eq, ((hQuadNorm L E' hLE' hdeg2).2 b x).2]
    dsimp only [A, b]
    ring
  have hνE'_sq : ∀ u : Lˣ, (νE' u : Ω F) ^ 2 = 1 := by
    intro u
    have h1 : (νE' u) ^ 2 = 1 := by
      change (νE' ^ 2) u = 1
      rw [← hdeg2, hνE'_pow, MonoidHom.one_apply]
    simpa only [Units.val_pow_eq_pow_val, Units.val_one] using congrArg Units.val h1
  have hψ_sq_rT : ∀ a : L, (a = 0 ∨ (r_T : ℤ) ≤ valL F L a) →
      (ψ (((c_ν⁻¹ : Lˣ) : L) * a)) ^ 2 = 1 := by
    intro a ha
    have ha1 : 1 + a ≠ 0 := hone_add_ne_zero_L a (ha.imp id (fun h => by omega))
    rw [← hc_ν_stat a ha ha1]
    exact hνE'_sq (Units.mk0 (1 + a) ha1)
  have hψ_neg_rT : ∀ a : L, (a = 0 ∨ (r_T : ℤ) ≤ valL F L a) →
      ψ (((c_ν⁻¹ : Lˣ) : L) * (-a)) = ψ (((c_ν⁻¹ : Lˣ) : L) * a) := by
    intro a ha
    have hprod : ψ (((c_ν⁻¹ : Lˣ) : L) * (-a)) * ψ (((c_ν⁻¹ : Lˣ) : L) * a) = 1 := by
      rw [← AddChar.map_add_eq_mul]
      have h0 : ((c_ν⁻¹ : Lˣ) : L) * (-a) + ((c_ν⁻¹ : Lˣ) : L) * a = 0 := by ring
      rw [h0, AddChar.map_zero_eq_one]
    have hsq := hψ_sq_rT a ha
    linear_combination
      ψ (((c_ν⁻¹ : Lˣ) : L) * a) * hprod - ψ (((c_ν⁻¹ : Lˣ) : L) * (-a)) * hsq
  have hnorm_eq_tr_rT : ∀ w : E', (w = 0 ∨ (r_T : ℤ) ≤ valL F E' w) →
      ψ (((c_ν⁻¹ : Lˣ) : L) * normLM F hLE' w) =
        ψ (((c_ν⁻¹ : Lˣ) : L) * traceLM F hLE' w) := by
    intro w hw
    have htr_w : traceLM F hLE' w = 0 ∨ (r_T : ℤ) ≤ valL F L (traceLM F hLE' w) :=
      htr_bound_LE' (r_T : ℤ) w (hw.imp id (fun h => by omega))
    have hnorm_w : normLM F hLE' w = 0 ∨ (r_T : ℤ) ≤ valL F L (normLM F hLE' w) := by
      rcases hw with rfl | hle
      · left; exact hnorm_zero_E'
      · right; rw [hval_norm_LE' w]; exact hle
    let u_w : L := traceLM F hLE' w + normLM F hLE' w
    have hu_w : u_w = 0 ∨ (r_T : ℤ) ≤ valL F L u_w :=
      hvalL_add (r_T : ℤ) (traceLM F hLE' w) (normLM F hLE' w) htr_w hnorm_w
    have hw1 : 1 + w ≠ 0 := hone_add_ne_zero_E' w (hw.imp id (fun h => by omega))
    have hu_w1 : 1 + u_w ≠ 0 := hone_add_ne_zero_L u_w (hu_w.imp id (fun h => by omega))
    have hnorm_1w : normLM F hLE' (1 + w) = 1 + u_w := by
      have hq := ((hQuadNorm L E' hLE' hdeg2).2 1 w).1
      rw [map_one] at hq
      rw [hq]
      dsimp only [u_w]
      ring
    have hunit_eq : Units.mk0 (1 + u_w) hu_w1 =
        Units.map (normLM F hLE') (Units.mk0 (1 + w) hw1) := by
      ext
      simp [Units.val_mk0, hnorm_1w]
    have hν_uw : (νE' (Units.mk0 (1 + u_w) hu_w1) : Ω F) = 1 := by
      have h1 : νE' (Units.mk0 (1 + u_w) hu_w1) = 1 := by
        rw [← hνE'_ker]
