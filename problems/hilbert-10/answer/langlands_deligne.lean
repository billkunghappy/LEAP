        ∀ b₀ : M_1, valL F M_1 b₀ = 0 →
          (∀ z : M_1, (z = 0 ∨ 0 ≤ valL F M_1 z) →
            normLM F hM1_K (1 + IntermediateField.inclusion hM1_K z * ((ϖ_K ^ t : Kˣ) : K)) -
              (1 + (z ^ (p F) + b₀ * z) * ((ϖ_M1 ^ t : M_1ˣ) : M_1)) = 0 ∨
              (t + 1 : ℤ) ≤ valL F M_1
                (normLM F hM1_K (1 + IntermediateField.inclusion hM1_K z * ((ϖ_K ^ t : Kˣ) : K)) -
                  (1 + (z ^ (p F) + b₀ * z) * ((ϖ_M1 ^ t : M_1ˣ) : M_1)))) →
          ∀ σ ∈ M_C.fixingSubgroup, σ ∉ M_1.fixingSubgroup →
