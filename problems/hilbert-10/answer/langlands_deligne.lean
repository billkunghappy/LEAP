    set u_scale : Lˣ := c_ν₁ * (δ_b ^ 2)⁻¹
    set z₁ : L := (u_scale : L) * x₁
    have hδb2_inv_val : valL F L (((δ_b ^ 2)⁻¹ : Lˣ) : L) = -((d_b : ℤ) + (d_b : ℤ)) := by
      rw [hval_inv (δ_b ^ 2), Units.val_pow_eq_pow_val, sq,
