      hStatPow2p (D_orb.get i).field (traceChar F (D_orb.get i).le ψ) (hψFi i)
        (μ'_orb i * χ'.comp (Units.map (normLM F (D_orb.get i).le))) hθ_ge2 (c'_θ i) hcθ_val hcθ_top⟩
  let k₀_μ : Fin D_orb.length → ℕ := fun i => (hOrb_stat i).1.choose
  let k₀_θ : Fin D_orb.length → ℕ := fun i => (hOrb_stat i).2.choose
