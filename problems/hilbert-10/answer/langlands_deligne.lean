        rw [Nat.factorial_succ, h_ordC_mul, Nat.cast_mul]
      refine ⟨?_, ?_, ?_⟩
      · have h1 := (Finset.add_sum_erase (Finset.range ℓ) (fun j => γ_fn (x + 1) j) hj₀_mem).symm
        have h2 := (Finset.add_sum_erase (Finset.range ℓ) (fun j => γ_fn x j) hj₀_mem).symm
        have h_er :
            ∑ j ∈ (Finset.range ℓ).erase j₀, γ_fn (x + 1) j =
