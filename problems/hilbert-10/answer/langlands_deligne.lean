      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (hval_normE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (hval_normM₁' : ∀ z : M₁', valL F L (normLM F hLM₁' z) = valL F M₁' z)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = 2 * valL F L x)
    (hfrob_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ∃ s : L, (s = 0 ∨ 0 ≤ valL F L s) ∧ (x - s ^ 2 = 0 ∨ 1 ≤ valL F L (x - s ^ 2)))
    (τ₁ : M₁' ≃ₐ[F] M₁')
    (hτ₁_L : ∀ x : L, τ₁ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (h2_val : (2 : L) = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L (2 : L))
    (x : M₁') (y : E') (f g d : L) (α : Lˣ)
    (hx_ne : x ≠ 0) (hf_ne : f ≠ 0) (hg_ne : g ≠ 0) (hd_ne : d ≠ 0)
    (hk₀_ne : 1 + d ≠ 0) (hh₀_ne : f + g + 4 * f * g ≠ 0)
    (hx_val : valL F M₁' x = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hf_val : valL F L f = (1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hg_val : valL F L g = (1 - 2 * ((condExp F L νE' / 2 : ℕ) : ℤ)))
    (hd_val : valL F L d = (((condExp F L νE' / 2 : ℕ) : ℤ) - ((condExp F L νM₁' / 2 : ℕ) : ℤ)))
    (hk₀_val : valL F L (1 + d) = 0)
    (hE_val : f + d ^ 2 * g = 0 ∨ (1 - ((condExp F L νM₁' / 2 : ℕ) : ℤ)) ≤ valL F L (f + d ^ 2 * g))
    (hh₀_val : valL F L (f + g + 4 * f * g) = (1 - 2 * ((condExp F L νE' / 2 : ℕ) : ℤ)))
    (hx_tr : traceLM F hLM₁' x = -1)
    (hx_norm : normLM F hLM₁' x = -f)
    (hx_sq : x ^ 2 + x = IntermediateField.inclusion hLM₁' f)
    (hx_conj : τ₁ x = -1 - x)
    (hy_tr : traceLM F hLE' y = -1)
    (hM₁'_coords : ∀ z : M₁', ∃ s₀ s₁ : L,
      z = IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x ∧
      ∀ m : ℤ, (z = 0 ∨ m ≤ valL F M₁' z) ↔
        ((s₀ = 0 ∨ m ≤ 2 * valL F L s₀) ∧
         (s₁ = 0 ∨ m ≤ 2 * valL F L s₁ + 1 - 2 * ((condExp F L νM₁' / 2 : ℕ) : ℤ))))
    (hα_val : valL F L (α : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hnorm_h₁ : normLM F hLM₁' (2 * x - IntermediateField.inclusion hLM₁' d) = d ^ 2 + 2 * d - 4 * f)
    (hnorm_h₂ : normLM F hLE' (2 * IntermediateField.inclusion hLE' d * y - 1) =
      1 + 2 * d - 4 * d ^ 2 * g) :
    let a := condExp F L νM₁' / 2
    let r := condExp F L νE' / 2
    let k₀ := 1 + d
    let h₀ := f + g + 4 * f * g
    let h₁ : M₁' := 2 * x - IntermediateField.inclusion hLM₁' d
    let h₂ : E' := 2 * IntermediateField.inclusion hLE' d * y - 1
    let β₁ : L := d ^ 2 + 2 * d - 4 * f
    let β₂ : L := 1 + 2 * d - 4 * d ^ 2 * g
    let a₁ : M₁' := IntermediateField.inclusion hLM₁' (f - d ^ 2 * g) -
      IntermediateField.inclusion hLM₁' k₀ * x
    let ψM₁' := traceChar F hLM₁' ψ
    (∀ s₀ s₁ : L,
      traceLM F hLM₁'
        (IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x) =
        2 * s₀ - s₁ ∧
      normLM F hLM₁'
        (IntermediateField.inclusion hLM₁' s₀ + IntermediateField.inclusion hLM₁' s₁ * x) =
        s₀ ^ 2 - s₀ * s₁ - f * s₁ ^ 2) ∧
    (∀ z : M₁',
      IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) = z + τ₁ z ∧
      IntermediateField.inclusion hLM₁' (normLM F hLM₁' z) = z * τ₁ z) ∧
    ∃ (c₀ c₁ : L) (c_θ₁ : M₁'ˣ) (Δ₀ Δ₁ : L),
      let p_X := 2 * c₀ - c₁
      let A := c₀ ^ 2 - c₀ * c₁ - c₁ ^ 2 * h₀
      let Q₁ : M₁' := IntermediateField.inclusion hLM₁' (c₀ * d + 2 * c₁ * d * g) +
        IntermediateField.inclusion hLM₁' (-2 * c₀ + c₁ * (1 + d + 4 * d * g)) * x
      valL F M₁' (c_θ₁ : M₁') = (condExp F M₁' θM₁' : ℤ) + condExpChar F M₁' ψM₁' ∧
      (∀ z : M₁',
        (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
        ∀ hz : 1 + z ≠ 0,
          (θM₁' (Units.mk0 (1 + z) hz) : Ω F) = ψM₁' (((c_θ₁⁻¹ : M₁'ˣ) : M₁') * z)) ∧
      (c₀ = 0 ∨ 1 - (((a + 1) / 2 : ℕ) : ℤ) ≤ valL F L c₀) ∧
      (c₁ = 0 ∨ (r : ℤ) - ((a / 2 : ℕ) : ℤ) ≤ valL F L c₁) ∧
      (Δ₀ = 0 ∨ (r : ℤ) - (a : ℤ) ≤ valL F L Δ₀) ∧
      (Δ₁ = 0 ∨ 0 ≤ valL F L Δ₁) ∧
      IntermediateField.inclusion hLM₁' (α : L) * ((c_θ₁⁻¹ : M₁'ˣ) : M₁') -
          (a₁ + IntermediateField.inclusion hLM₁' A + Q₁) =
        IntermediateField.inclusion hLM₁' Δ₀ + IntermediateField.inclusion hLM₁' Δ₁ * x ∧
      normLM F hLM₁' (h₁ - IntermediateField.inclusion hLM₁' p_X) =
        β₁ + 2 * k₀ * p_X + p_X ^ 2 ∧
      normLM F hLE' (h₂ - IntermediateField.inclusion hLE' p_X) =
        β₂ + 2 * k₀ * p_X + p_X ^ 2 :=
by
  intro a r k₀ h₀ h₁ h₂ β₁ β₂ a₁ ψM₁'
  have ha_ge1 : 1 ≤ a := by dsimp [a]; omega
  have hr_ge_a : a ≤ r := by dsimp [a, r]; omega
  have hbM₁'_eq : (condExp F L νM₁' : ℤ) = 2 * (a : ℤ) := by dsimp [a]; omega
  have hbE'_eq : (condExp F L νE' : ℤ) = 2 * (r : ℤ) := by dsimp [r]; omega
  have hQuad_gen : ∀ (K S : Type u) [Field K] [Field S] [Algebra K S] [FiniteDimensional K S],
      Module.finrank K S = 2 →
      (∀ (u v : K) (w : S),
        Algebra.trace K S (algebraMap K S u + algebraMap K S v * w) =
          (2 : K) * u + v * Algebra.trace K S w ∧
        Algebra.norm K (algebraMap K S u + algebraMap K S v * w) =
          u ^ 2 + u * v * Algebra.trace K S w + v ^ 2 * Algebra.norm K w) ∧
      (∀ (u : K) (w : S),
        Algebra.norm K (w - algebraMap K S u) =
          Algebra.norm K w - u * Algebra.trace K S w + u ^ 2) := by
    clear * -
    intro K S _ _ _ _ hdeg
    have htr_smul : ∀ (c : K) (z : S),
        Algebra.trace K S (algebraMap K S c * z) = c * Algebra.trace K S z := by
      intro c z
      rw [← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]
    have hnorm_add : ∀ (x : K) (y : S),
        Algebra.norm K (algebraMap K S x + y) =
          x ^ 2 + x * Algebra.trace K S y + Algebra.norm K y := by
      intro x y
      let b : Module.Basis (Fin 2) K S :=
        (Module.finBasis K S).reindex (finCongr hdeg)
      let A : Matrix (Fin 2) (Fin 2) K := Algebra.leftMulMatrix b y
      let X : Matrix (Fin 2) (Fin 2) K := Algebra.leftMulMatrix b (algebraMap K S x)
      have htr_y : Algebra.trace K S y = A 0 0 + A 1 1 := by
        rw [Algebra.trace_eq_matrix_trace b y, Matrix.trace_fin_two A]
      have hnorm_y : Algebra.norm K y = A 0 0 * A 1 1 - A 0 1 * A 1 0 := by
        rw [Algebra.norm_eq_matrix_det b y, Matrix.det_fin_two A]
      have hX_eq : X = algebraMap K (Matrix (Fin 2) (Fin 2) K) x :=
        AlgHom.commutes (Algebra.leftMulMatrix b) x
      have hX00 : X 0 0 = x := by
        rw [hX_eq]
        simp [Algebra.algebraMap_eq_smul_one, Matrix.smul_apply, Matrix.one_apply]
      have hX11 : X 1 1 = x := by
        rw [hX_eq]
        simp [Algebra.algebraMap_eq_smul_one, Matrix.smul_apply, Matrix.one_apply]
      have hX01 : X 0 1 = 0 := by
        have h01 : (0 : Fin 2) ≠ 1 := by decide
        rw [hX_eq]
        simp [Algebra.algebraMap_eq_smul_one, Matrix.smul_apply, Matrix.one_apply, h01]
      have hX10 : X 1 0 = 0 := by
        have h10 : (1 : Fin 2) ≠ 0 := by decide
        rw [hX_eq]
        simp [Algebra.algebraMap_eq_smul_one, Matrix.smul_apply, Matrix.one_apply, h10]
      rw [Algebra.norm_eq_matrix_det b (algebraMap K S x + y), map_add]
      change (X + A).det = _
      rw [Matrix.det_fin_two, htr_y, hnorm_y]
      simp only [Matrix.add_apply, hX00, hX11, hX01, hX10]
      ring
    refine ⟨?_, ?_⟩
    · intro u v w
      refine ⟨?_, ?_⟩
      · rw [map_add, Algebra.trace_algebraMap, hdeg, nsmul_eq_mul, Nat.cast_two, htr_smul]
      · rw [hnorm_add u (algebraMap K S v * w), htr_smul v w, map_mul,
          Algebra.norm_algebraMap, hdeg]
        ring
    · intro u w
      have heq : w - algebraMap K S u = algebraMap K S (-u) + w := by
        rw [map_neg]
        ring
      rw [heq, hnorm_add (-u) w]
