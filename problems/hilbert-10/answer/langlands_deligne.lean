  have hP_cs1_inner : P 0 ((1 + d - d ^ 2) + 2 * (1 + d) * (f + d ^ 2 * g) - 4 * d ^ 2 * g) := by
    have h1d : P 0 (1 + d - d ^ 2) :=
      hP_sub (hP_add hP_1 (hP_mono hP_d (by omega))) (hP_mono hP_d2 (by omega))
