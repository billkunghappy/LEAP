    have hEq2₀ := ld_ch12_unshifted_cyclic_fml F M₁ K₁ hM₁K₁ hGalM₁K₁ hAbM₁K₁ hPrime_M₁K₁ ψM₁ hψM₁
      ξM₁ χM₁' (hdegM₁K₁.symm ▸ hξM₁_pow) hξM₁_ne hξM₁_ker hξM₁_cond hχM₁'_cond hχM₁'K₁_cond
