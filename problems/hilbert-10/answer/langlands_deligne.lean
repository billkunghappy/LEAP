        (fun j hj => hνM_cond j (hdegM ▸ hj))
        hUnramM hcondM1 hχM_triv1
        (fun z => by rw [hdegM]; exact hχM_pow_NM z)
        hConj_M hqL_M hval_norm_M hval_alg_M htr_bound_M hcondChar_M
        k_L k_M resL resM hresM_0 hresM_1 hresM_ring hresM_ker hresM_surj hres_tr_norm_M
        σ_frob hσ_frob_L hσ_frob_ne hσ_frob_val hσ_frob_res ϖ_L hϖ_L_val c₁ rfl
