    let W₀ : K₁ := W Finset.univ
    obtain ⟨hW₀_d, hW₀_lin, hW₀_quad⟩ := hW_ind Finset.univ
    have hW₀_1 : W₀ = 0 ∨ (1 : ℤ) ≤ valL F K₁ W₀ :=
      hvalK₁_mono (by omega : (1 : ℤ) ≤ (d : ℤ)) hW₀_d
    have h1W₀_ne0 : 1 + W₀ ≠ 0 := by
      intro h0
      have hW₀_eq : W₀ = -1 := by linear_combination h0
      rcases hW₀_1 with hW0 | hle
      · rw [hW0] at hW₀_eq
        exact one_ne_zero (neg_eq_zero.mp hW₀_eq.symm)
      · rw [hW₀_eq, hvalK₁_neg1] at hle
        omega
    let u₀ : K₁ˣ := Units.mk0 (1 + W₀) h1W₀_ne0
    have hu₀_mem : u₀ ∈ unitGroup F K₁ 1 := by
      rw [hunitK₁_mem 1 (by omega) u₀]
      dsimp only [u₀, Units.val_mk0]
      rw [add_sub_cancel_left 1 W₀]
      rcases hW₀_1 with hW0 | hle
      · left; rw [hW0, add_zero]
      · right; exact_mod_cast hle
    have hu₀_val0 : valL F K₁ (1 + W₀) = 0 := hunitK₁_val0 1 u₀ hu₀_mem
    have hinv_val0_eq : valL F K₁ ((1 + W₀)⁻¹) = 0 := by
      have h := hvalK₁_inv u₀
      dsimp only [u₀] at h
      rw [Units.val_inv_eq_inv_val, Units.val_mk0, hu₀_val0, neg_zero] at h
      exact h
    have hinv_val0 : (1 + W₀)⁻¹ = 0 ∨ (0 : ℤ) ≤ valL F K₁ ((1 + W₀)⁻¹) :=
      Or.inr (by omega)
    have hw_sub_W₀ : w - W₀ = 0 ∨ (2 * (d : ℤ)) ≤ valL F K₁ (w - W₀) := by
      have heq : w - W₀ = - (W₀ - (∑ j ∈ Finset.univ, z j)) := by
        rw [hw_sum]
        dsimp only [z]
        ring
      rw [heq]
      exact hvalK₁_neg_ge (2 * (d : ℤ)) _ hW₀_lin
    let w' : K₁ := (w - W₀) * (1 + W₀)⁻¹
    have hw'_2d : w' = 0 ∨ (2 * (d : ℤ)) ≤ valL F K₁ w' := by
      have h := hvalK₁_mul_ge (2 * (d : ℤ)) 0 (w - W₀) ((1 + W₀)⁻¹) hw_sub_W₀ hinv_val0
      rwa [add_zero] at h
    have hW₀_d1 : W₀ = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ W₀ :=
      hvalK₁_mono (by omega : (d₁ : ℤ) ≤ (d : ℤ)) hW₀_d
    have hw'_d1 : w' = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ w' :=
      hvalK₁_mono (by omega : (d₁ : ℤ) ≤ 2 * (d : ℤ)) hw'_2d
    have hw_fact : (1 + W₀) * (1 + w') - 1 = w := by
      have hmul : (1 + W₀) * w' = w - W₀ := by
        dsimp only [w']
        rw [mul_comm (w - W₀), ← mul_assoc, mul_inv_cancel₀ h1W₀_ne0, one_mul]
      calc (1 + W₀) * (1 + w') - 1
        _ = W₀ + (1 + W₀) * w' := by ring
        _ = W₀ + (w - W₀) := by rw [hmul]
        _ = w := by ring
    have hmult_final := (hMultAdd W₀ w' hW₀_d1 hw'_d1).2
    rw [hw_fact] at hmult_final
    have hfinal_id :
        Δ_quad w - ((∑ j : Fin p, Δ_quad (z j)) + Δ_quad w') =
          (Δ_quad w - (Δ_quad W₀ + Δ_quad w')) +
            (Δ_quad W₀ - (∑ j : Fin p, Δ_quad (z j))) := by ring
    refine ⟨x, w', fun j => ⟨hx_j j, hz_j j⟩, hw'_2d, ?_⟩
    change Δ_quad w - ((∑ j : Fin p, Δ_quad (z j)) + Δ_quad w') = 0 ∨
      (bE' : ℤ) ≤ valL F L (Δ_quad w - ((∑ j : Fin p, Δ_quad (z j)) + Δ_quad w'))
    rw [hfinal_id]
    exact hvalL_add (bE' : ℤ) _ _ hmult_final hW₀_quad
  exact ⟨hMultAdd, hMonoDecomp⟩

