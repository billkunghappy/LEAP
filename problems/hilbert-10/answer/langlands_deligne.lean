          rw [hval_mul (w : M) ((k : M) - 1) (Units.ne_zero w) hk0, hw, zero_add]
          exact hka
    have hz_val : valL F M z = -((a : ℤ) + n) := hcr_val hc ((hmem_U u).mp hu)
    have hψ_eq : ψ_M (z * ((r_w : M) - 1)) = ψ_M (z * ((w : M) - 1)) := by
      rw [harg, AddChar.map_add_eq_mul,
        hψ_z_triv z y (Units.ne_zero _) hz_val hy_val, mul_one]
    rw [hχ_mk w, hψ_eq]
  have hT_mul : ∀ {c : Mˣ}, valL F M (c : M) = (a : ℤ) + n →
      ∀ {u v : Mˣ ⧸ unitGroup F M a}, u ∈ U → v ∈ U →
      T c (u * v) = T c u * Δ c u v := by
    intro c hc u v hu hv
    set r_u := cosetRep u
    set r_v := cosetRep v
    have huv : u * v = QuotientGroup.mk (s := unitGroup F M a) (r_u * r_v) := by
      rw [QuotientGroup.mk_mul, hout, hout]
    have hrv_val : valL F M ((r_u * r_v : Mˣ) : M) = 0 := by
      rw [Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
        (hmem_U u).mp hu, (hmem_U v).mp hv, add_zero]
    rw [huv, hT_mk hc (r_u * r_v) hrv_val]
    dsimp only [T, Δ]
    have hχ_eq : (χ_M (c⁻¹ * (r_u * r_v)) : Ω F)⁻¹ =
        (χ_M (c⁻¹ * r_u) : Ω F)⁻¹ * (χ_M r_v : Ω F)⁻¹ := by
      rw [← mul_assoc, map_mul, Units.val_mul, mul_inv]
    have hψ_arg : ((c⁻¹ * (r_u * r_v) : Mˣ) : M) =
        ((c⁻¹ * r_u : Mˣ) : M) + ((c⁻¹ * r_u : Mˣ) : M) * ((r_v : M) - 1) := by
      simp only [Units.val_mul]
      ring
    rw [hχ_eq, hψ_arg, AddChar.map_add_eq_mul]
    ring
  have hΔ_mul : ∀ {c : Mˣ}, valL F M (c : M) = (a : ℤ) + n →
      ∀ {u : Mˣ ⧸ unitGroup F M a}, u ∈ U →
      ∀ {h₁ h₂ : Mˣ ⧸ unitGroup F M a}, h₁ ∈ H_e → h₂ ∈ H_e →
      Δ c u (h₁ * h₂) = Δ c u h₁ * Δ c u h₂ := by
    intro c hc u hu h₁ h₂ hh₁ hh₂
    set w₁ := cosetRep h₁
    set w₂ := cosetRep h₂
    have hw₁_mem : w₁ ∈ unitGroup F M e := (hmem_He h₁).mp hh₁
    have hw₂_mem : w₂ ∈ unitGroup F M e := (hmem_He h₂).mp hh₂
    have hmul : h₁ * h₂ = QuotientGroup.mk (s := unitGroup F M a) (w₁ * w₂) := by
      rw [QuotientGroup.mk_mul, hout, hout]
    have hw₁₂_val : valL F M ((w₁ * w₂ : Mˣ) : M) = 0 :=
      hunit_val0 e (w₁ * w₂) (mul_mem hw₁_mem hw₂_mem)
    rw [hmul, hΔ_mk hc hu (w₁ * w₂) hw₁₂_val]
    dsimp only [Δ]
    set z : M := ((c⁻¹ * cosetRep u : Mˣ) : M)
    set d₁ : M := (w₁ : M) - 1
    set d₂ : M := (w₂ : M) - 1
    set y : M := d₁ * d₂
    have hy_val : y = 0 ∨ (a : ℤ) ≤ valL F M y := by
      rcases (hunit_ge1 e he_ge1 w₁).mp hw₁_mem with hw₁_1 | hw₁_e
      · left; dsimp only [y, d₁]; rw [hw₁_1, sub_self, zero_mul]
      · rcases (hunit_ge1 e he_ge1 w₂).mp hw₂_mem with hw₂_1 | hw₂_e
        · left; dsimp only [y, d₂]; rw [hw₂_1, sub_self, mul_zero]
        · by_cases hd₁0 : d₁ = 0
          · left; dsimp only [y]; rw [hd₁0, zero_mul]
          · by_cases hd₂0 : d₂ = 0
            · left; dsimp only [y]; rw [hd₂0, mul_zero]
            · right
              dsimp only [y]
              rw [hval_mul d₁ d₂ hd₁0 hd₂0]
              dsimp only [d₁, d₂]
              omega
    have hz_val : valL F M z = -((a : ℤ) + n) := hcr_val hc ((hmem_U u).mp hu)
    have harg : z * (((w₁ * w₂ : Mˣ) : M) - 1) = (z * d₁ + z * d₂) + z * y := by
      dsimp only [d₁, d₂, y]
      rw [Units.val_mul]
      ring
    have hψ_eq : ψ_M (z * (((w₁ * w₂ : Mˣ) : M) - 1)) = ψ_M (z * d₁) * ψ_M (z * d₂) := by
      rw [harg, AddChar.map_add_eq_mul, AddChar.map_add_eq_mul,
        hψ_z_triv z y (Units.ne_zero _) hz_val hy_val, mul_one]
    have hχ_eq : (χ_M (w₁ * w₂) : Ω F)⁻¹ = (χ_M w₁ : Ω F)⁻¹ * (χ_M w₂ : Ω F)⁻¹ := by
      rw [map_mul, Units.val_mul, mul_inv]
    rw [hχ_eq, hψ_eq]
    ring
  have hsum_Δ : ∀ {c : Mˣ}, valL F M (c : M) = (a : ℤ) + n →
      ∀ {u : Mˣ ⧸ unitGroup F M a}, u ∈ U →
      (∑ h ∈ H_e, Δ c u h) =
        if (∀ h ∈ H_e, Δ c u h = 1) then (H_e.card : Ω F) else 0 := by
    intro c hc u hu
    split_ifs with htriv
    · rw [Finset.sum_congr rfl htriv, Finset.sum_const, nsmul_one]
    · push_neg at htriv
      rcases htriv with ⟨h₀, hh₀, hh₀_ne⟩
      have hshift : (∑ h ∈ H_e, Δ c u h) = (∑ h ∈ H_e, Δ c u h) * Δ c u h₀ := by
        calc (∑ h ∈ H_e, Δ c u h)
          _ = ∑ h ∈ H_e, Δ c u (h * h₀) := by
              exact (Finset.sum_bij' (fun h _ => h * h₀) (fun h _ => h * h₀⁻¹)
                (fun h hh => hHe_mul hh hh₀) (fun h hh => hHe_mul hh (hHe_inv hh₀))
                (fun h _ => mul_inv_cancel_right h h₀) (fun h _ => inv_mul_cancel_right h h₀)
                (fun h _ => rfl)).symm
          _ = ∑ h ∈ H_e, (Δ c u h * Δ c u h₀) :=
              Finset.sum_congr rfl fun h hh => hΔ_mul hc hu hh hh₀
          _ = (∑ h ∈ H_e, Δ c u h) * Δ c u h₀ :=
              (Finset.sum_mul H_e (fun h => Δ c u h) (Δ c u h₀)).symm
      have hdiff : (∑ h ∈ H_e, Δ c u h) * (Δ c u h₀ - 1) = 0 := by
        linear_combination -hshift
      exact (mul_eq_zero.mp hdiff).resolve_right (sub_ne_zero.mpr hh₀_ne)
  have hsum_U_eq_filter : ∀ {c : Mˣ}, valL F M (c : M) = (a : ℤ) + n →
      (∑ u ∈ U, T c u) =
        ∑ u ∈ U.filter (fun u => ∀ h ∈ H_e, Δ c u h = 1), T c u := by
    intro c hc
    have hshift_U : ∀ {h : Mˣ ⧸ unitGroup F M a}, h ∈ H_e →
        (∑ u ∈ U, T c u) = ∑ u ∈ U, T c u * Δ c u h := by
      intro h hh
      have hhU : h ∈ U := hHe_sub_U hh
      calc (∑ u ∈ U, T c u)
        _ = ∑ u ∈ U, T c (u * h) := by
            exact (Finset.sum_bij' (fun u _ => u * h) (fun u _ => u * h⁻¹)
              (fun u hu => hU_mul hu hhU) (fun u hu => hU_mul hu (hU_inv hhU))
              (fun u _ => mul_inv_cancel_right u h) (fun u _ => inv_mul_cancel_right u h)
              (fun u _ => rfl)).symm
        _ = ∑ u ∈ U, T c u * Δ c u h :=
            Finset.sum_congr rfl fun u hu => hT_mul hc hu hhU
    have havg : (H_e.card : Ω F) * (∑ u ∈ U, T c u) =
        (H_e.card : Ω F) * (∑ u ∈ U.filter (fun u => ∀ h ∈ H_e, Δ c u h = 1), T c u) := by
      calc (H_e.card : Ω F) * (∑ u ∈ U, T c u)
        _ = ∑ _h ∈ H_e, (∑ u ∈ U, T c u) := by
            rw [Finset.sum_const, nsmul_eq_mul]
        _ = ∑ h ∈ H_e, (∑ u ∈ U, T c u * Δ c u h) :=
            Finset.sum_congr rfl fun h hh => hshift_U hh
        _ = ∑ u ∈ U, (∑ h ∈ H_e, T c u * Δ c u h) := Finset.sum_comm
        _ = ∑ u ∈ U, T c u * (∑ h ∈ H_e, Δ c u h) :=
            Finset.sum_congr rfl fun u _ => (Finset.mul_sum H_e (fun h => Δ c u h) (T c u)).symm
        _ = ∑ u ∈ U, T c u * (if (∀ h ∈ H_e, Δ c u h = 1) then (H_e.card : Ω F) else 0) :=
            Finset.sum_congr rfl fun u hu => by rw [hsum_Δ hc hu]
        _ = ∑ u ∈ U, (if (∀ h ∈ H_e, Δ c u h = 1) then (H_e.card : Ω F) * T c u else 0) :=
            Finset.sum_congr rfl fun u _ => by split_ifs <;> ring
        _ = ∑ u ∈ U.filter (fun u => ∀ h ∈ H_e, Δ c u h = 1), (H_e.card : Ω F) * T c u :=
            (Finset.sum_filter (fun u => ∀ h ∈ H_e, Δ c u h = 1)
              (fun u => (H_e.card : Ω F) * T c u)).symm
        _ = (H_e.card : Ω F) * (∑ u ∈ U.filter (fun u => ∀ h ∈ H_e, Δ c u h = 1), T c u) :=
            (Finset.mul_sum _ _ _).symm
    exact mul_left_cancel₀ hHe_card_ne havg
  refine ⟨?_, ?_⟩
  · intro hne
    have hsum_ne : (∑ u ∈ U, T c_tate u) ≠ 0 := by
      rw [htate_sum] at hne
      exact right_ne_zero_of_mul hne
    rw [hsum_U_eq_filter htate_val] at hsum_ne
    obtain ⟨u_star, hu_star_mem, _⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsum_ne
    obtain ⟨hu_star_U, hu_star_stat⟩ := Finset.mem_filter.mp hu_star_mem
    set r_star : Mˣ := cosetRep u_star
    set c_M : Mˣ := c_tate * r_star⁻¹
    refine ⟨c_M, ?_, ?_⟩
    · rw [Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
        htate_val, hval_inv r_star, (hmem_U u_star).mp hu_star_U, neg_zero, add_zero]
    · intro w hw
      have hw_val : valL F M (w : M) = 0 := hunit_val0 e w hw
      have hw_He : QuotientGroup.mk (s := unitGroup F M a) w ∈ H_e := (hHe_mk w).mpr hw
      have hstat_w := hu_star_stat (QuotientGroup.mk (s := unitGroup F M a) w) hw_He
      rw [hΔ_mk htate_val hu_star_U w hw_val] at hstat_w
      have hc_inv : c_M⁻¹ = c_tate⁻¹ * r_star := by
        dsimp only [c_M]
        rw [mul_inv, inv_inv]
      rw [← hc_inv] at hstat_w
      exact (inv_mul_eq_one₀ (Units.ne_zero (χ_M w))).mp hstat_w
  · intro c_M hc_M hc_stat
    set u₀ : Mˣ := c_tate * c_M⁻¹
    set v₀ : Mˣ ⧸ unitGroup F M a := QuotientGroup.mk (s := unitGroup F M a) u₀
    have hu₀_val : valL F M (u₀ : M) = 0 := by
      dsimp only [u₀]
      rw [Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
        hval_inv c_M, htate_val, hc_M, add_neg_cancel]
    have hv₀_U : v₀ ∈ U := by
      rw [hmem_U, hval_mk u₀, hu₀_val]
    have hsum_reindex : (∑ u ∈ U, T c_tate u) = ∑ u ∈ U, T c_M u := by
      calc (∑ u ∈ U, T c_tate u)
        _ = ∑ u ∈ U, T c_tate (v₀ * u) := by
            exact (Finset.sum_bij' (fun u _ => v₀ * u) (fun u _ => v₀⁻¹ * u)
              (fun u hu => hU_mul hv₀_U hu) (fun u hu => hU_mul (hU_inv hv₀_U) hu)
              (fun u _ => inv_mul_cancel_left v₀ u) (fun u _ => mul_inv_cancel_left v₀ u)
              (fun u _ => rfl)).symm
        _ = ∑ u ∈ U, T c_M u := by
            refine Finset.sum_congr rfl fun u hu => ?_
            have hvu : v₀ * u = QuotientGroup.mk (s := unitGroup F M a) (u₀ * cosetRep u) := by
              dsimp only [v₀]
              conv_rhs => rw [QuotientGroup.mk_mul, hout]
            have hu₀_ru_val : valL F M ((u₀ * cosetRep u : Mˣ) : M) = 0 := by
              rw [Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
                hu₀_val, (hmem_U u).mp hu, add_zero]
            rw [hvu, hT_mk htate_val (u₀ * cosetRep u) hu₀_ru_val]
            dsimp only [T]
            have hmul_eq : c_tate⁻¹ * (u₀ * cosetRep u) = c_M⁻¹ * cosetRep u := by
              dsimp only [u₀]
              rw [mul_assoc, inv_mul_cancel_left]
            rw [hmul_eq]
    have hΔ_cM : ∀ {u : Mˣ ⧸ unitGroup F M a}, u ∈ U →
        ∀ {w : Mˣ}, w ∈ unitGroup F M e →
        Δ c_M u (QuotientGroup.mk (s := unitGroup F M a) w) =
          ψ_M (((c_M⁻¹ : Mˣ) : M) * (((cosetRep u : Mˣ) : M) - 1) * ((w : M) - 1)) := by
      intro u hu w hw
      have hw_val : valL F M (w : M) = 0 := hunit_val0 e w hw
      rw [hΔ_mk hc_M hu w hw_val]
      have harg : ((c_M⁻¹ * cosetRep u : Mˣ) : M) * ((w : M) - 1) =
          ((c_M⁻¹ : Mˣ) : M) * ((w : M) - 1) +
            ((c_M⁻¹ : Mˣ) : M) * (((cosetRep u : Mˣ) : M) - 1) * ((w : M) - 1) := by
        rw [Units.val_mul]
        ring
      rw [harg, AddChar.map_add_eq_mul, ← mul_assoc, ← hc_stat w hw,
        inv_mul_cancel₀ (Units.ne_zero (χ_M w)), one_mul]
    have hfilter_eq_Hd : U.filter (fun u => ∀ h ∈ H_e, Δ c_M u h = 1) = H_d := by
      refine Finset.filter_congr fun u hu => ?_
      set r_u : Mˣ := cosetRep u
      constructor
      · intro htriv
        by_contra hnot_d
        have hnot_d' : ¬ ((r_u : M) = 1 ∨ (d : ℤ) ≤ valL F M ((r_u : M) - 1)) :=
          fun h => hnot_d ((hunit_ge1 d hd_ge1 r_u).mpr h)
        push_neg at hnot_d'
        obtain ⟨hr_u_ne1, hr_u_lt_d⟩ := hnot_d'
        have hdr_ne : (r_u : M) - 1 ≠ 0 := sub_ne_zero.mpr hr_u_ne1
        set z_u : M := ((c_M⁻¹ : Mˣ) : M) * ((r_u : M) - 1)
        have hz_u_ne : z_u ≠ 0 := mul_ne_zero (Units.ne_zero c_M⁻¹) hdr_ne
        have hz_u_val : valL F M z_u = -((a : ℤ) + n) + valL F M ((r_u : M) - 1) := by
          dsimp only [z_u]
          rw [hval_mul _ _ (Units.ne_zero _) hdr_ne, hval_inv c_M, hc_M]
        set u_z : Mˣ := Units.mk0 z_u hz_u_ne
        have huz_inv_val : valL F M z_u⁻¹ = -valL F M z_u := by
          have h1 : ((u_z⁻¹ : Mˣ) : M) = z_u⁻¹ := by
            rw [Units.val_inv_eq_inv_val, Units.val_mk0]
          have h2 : (u_z : M) = z_u := Units.val_mk0 hz_u_ne
          rw [← h1, hval_inv u_z, h2]
        set y : M := z_u⁻¹ * x₁
        have hy_ne0 : y ≠ 0 := mul_ne_zero (inv_ne_zero hz_u_ne) hx₁_ne
        have hy_val : (e : ℤ) ≤ valL F M y := by
          dsimp only [y]
          rw [hval_mul z_u⁻¹ x₁ (inv_ne_zero hz_u_ne) hx₁_ne, huz_inv_val, hz_u_val]
          omega
        have hy1_ne : 1 + y ≠ 0 := by
          intro h1y
          have hy_eq : y = -1 := eq_neg_of_add_eq_zero_right h1y
          have hy_val0 : valL F M y = 0 := by rw [hy_eq, hval_neg1]
          omega
        set w_y : Mˣ := Units.mk0 (1 + y) hy1_ne
        have hwy_sub : (w_y : M) - 1 = y := by
          change (1 + y) - 1 = y
          ring
        have hwy_mem : w_y ∈ unitGroup F M e := by
          rw [hunit_ge1 e he_ge1 w_y, hwy_sub]
          exact Or.inr hy_val
        have hhy_He : QuotientGroup.mk (s := unitGroup F M a) w_y ∈ H_e :=
          (hHe_mk w_y).mpr hwy_mem
        have h1 := htriv (QuotientGroup.mk (s := unitGroup F M a) w_y) hhy_He
        rw [hΔ_cM hu hwy_mem, hwy_sub] at h1
        have hzx : ((c_M⁻¹ : Mˣ) : M) * ((r_u : M) - 1) * y = x₁ :=
          mul_inv_cancel_left₀ hz_u_ne x₁
        rw [hzx] at h1
        exact hx₁_ne1 h1
      · intro hr_u_d h hh
        set w : Mˣ := cosetRep h
        have hw_e : w ∈ unitGroup F M e := (hmem_He h).mp hh
        rw [← hout h, hΔ_cM hu hw_e]
        set y : M := ((r_u : M) - 1) * ((w : M) - 1)
        have hy_val : y = 0 ∨ (a : ℤ) ≤ valL F M y := by
          rcases (hunit_ge1 d hd_ge1 r_u).mp hr_u_d with hr1 | hrd
          · left; dsimp only [y]; rw [hr1, sub_self, zero_mul]
          · rcases (hunit_ge1 e he_ge1 w).mp hw_e with hw1 | hwe
            · left; dsimp only [y]; rw [hw1, sub_self, mul_zero]
            · by_cases hdr0 : (r_u : M) - 1 = 0
              · left; dsimp only [y]; rw [hdr0, zero_mul]
              · by_cases hdw0 : (w : M) - 1 = 0
                · left; dsimp only [y]; rw [hdw0, mul_zero]
                · right
                  dsimp only [y]
                  rw [hval_mul _ _ hdr0 hdw0]
                  omega
        have hcinv_val : valL F M ((c_M⁻¹ : Mˣ) : M) = -((a : ℤ) + n) := by
          rw [hval_inv c_M, hc_M]
        rw [mul_assoc]
        exact hψ_z_triv ((c_M⁻¹ : Mˣ) : M) y (Units.ne_zero c_M⁻¹) hcinv_val hy_val
    have hT_factor : ∀ u ∈ H_d,
        T c_M u = ((χ_M c_M : Ω F) * ψ_M (((c_M⁻¹ : Mˣ) : M))) *
          ((χ_M (cosetRep u) : Ω F)⁻¹ *
            ψ_M (((c_M⁻¹ : Mˣ) : M) * (((cosetRep u : Mˣ) : M) - 1))) := by
      intro u _
      dsimp only [T]
      have hχ_eq : (χ_M (c_M⁻¹ * cosetRep u) : Ω F)⁻¹ =
          (χ_M c_M : Ω F) * (χ_M (cosetRep u) : Ω F)⁻¹ := by
        rw [map_mul, map_inv, Units.val_mul, Units.val_inv_eq_inv_val, mul_inv, inv_inv]
      have hψ_arg : ((c_M⁻¹ * cosetRep u : Mˣ) : M) =
          ((c_M⁻¹ : Mˣ) : M) + ((c_M⁻¹ : Mˣ) : M) * (((cosetRep u : Mˣ) : M) - 1) := by
        rw [Units.val_mul]
        ring
      rw [hχ_eq, hψ_arg, AddChar.map_add_eq_mul]
      ring
    rw [htate_sum, hsum_reindex, hsum_U_eq_filter hc_M, hfilter_eq_Hd,
      Finset.sum_congr rfl hT_factor, ← Finset.mul_sum]
    dsimp only [n, H_d, U, d, a]
    ring

theorem ld_cond_ge_two_filtration_card_and_eval (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (ψ_M : AddChar M (Ω F)) (χ_M : Mˣ →* (Ω F)ˣ)
    (hcond_ge2 : 2 ≤ condExp F M χ_M)
    (hSpecM_triv : ∀ x : M, (x = 0 ∨ -condExpChar F M ψ_M ≤ valL F M x) → ψ_M x = 1)
    (hSpecM_χ : ∀ u ∈ unitGroup F M (condExp F M χ_M), χ_M u = 1)
    (hFinM : Set.Finite {u : Mˣ ⧸ unitGroup F M (condExp F M χ_M) |
      valL F M ((cosetRep u : Mˣ) : M) = 0})
    (hvalM_props : valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
      (∀ u : Mˣ, u ∈ unitGroup F M 0 ↔ valL F M (u : M) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
      (∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0))
    (k_M : Type u) [Field k_M] [Fintype k_M] (resM : M → k_M)
    (hresM_0 : resM 0 = 0) (hresM_1 : resM 1 = 1)
    (hresM_ring : ∀ x₁ x₂ : M, (x₁ = 0 ∨ 0 ≤ valL F M x₁) → (x₂ = 0 ∨ 0 ≤ valL F M x₂) →
      resM (x₁ + x₂) = resM x₁ + resM x₂ ∧
      resM (x₁ * x₂) = resM x₁ * resM x₂ ∧
      resM (-x₁) = -resM x₁)
    (hresM_ker : ∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
      (resM x = 0 ↔ (x = 0 ∨ 1 ≤ valL F M x)))
    (hresM_surj : ∀ a : k_M, ∃ x : M, (x = 0 ∨ 0 ≤ valL F M x) ∧ resM x = a)
    (ϖ_M c_M : Mˣ) (hϖ_M : valL F M (ϖ_M : M) = 1)
    (hc_M_val : valL F M (c_M : M) = (condExp F M χ_M : ℤ) + condExpChar F M ψ_M)
    (hc_M_stat : ∀ w ∈ unitGroup F M (condExp F M χ_M - condExp F M χ_M / 2),
      (χ_M w : Ω F) = ψ_M (((c_M⁻¹ : Mˣ) : M) * ((w : M) - 1))) :
    let a := condExp F M χ_M
    let d := a / 2
    (a = 2 * d →
      (∑ u ∈ hFinM.toFinset.filter (fun u => cosetRep u ∈ unitGroup F M d),
        ((χ_M (cosetRep u) : Ω F)⁻¹ *
          ψ_M (((c_M⁻¹ : Mˣ) : M) * (((cosetRep u : Mˣ) : M) - 1)))) =
        (Fintype.card k_M : Ω F) ^ d) ∧
    (a = 2 * d + 1 →
      ∀ (Q_M : k_M → Ω F),
        (∀ (y : M) (hy_int : y = 0 ∨ 0 ≤ valL F M y)
          (hy_ne : 1 + ((ϖ_M ^ d : Mˣ) : M) * y ≠ 0),
          Q_M (resM y) =
            (χ_M (Units.mk0 (1 + ((ϖ_M ^ d : Mˣ) : M) * y) hy_ne) : Ω F)⁻¹ *
              ψ_M (((c_M⁻¹ : Mˣ) : M) * ((ϖ_M ^ d : Mˣ) : M) * y)) →
        (∑ u ∈ hFinM.toFinset.filter (fun u => cosetRep u ∈ unitGroup F M d),
          ((χ_M (cosetRep u) : Ω F)⁻¹ *
            ψ_M (((c_M⁻¹ : Mˣ) : M) * (((cosetRep u : Mˣ) : M) - 1)))) =
          (Fintype.card k_M : Ω F) ^ d * (∑ b : k_M, Q_M b)) :=
by
  classical
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add,
    hunit0, hunit_ge1, hunit_val0⟩ := hvalM_props
  dsimp only
  set a : ℕ := condExp F M χ_M
  set d : ℕ := a / 2
  set e : ℕ := a - d
  set n : ℤ := condExpChar F M ψ_M
  have ha_ge1 : 1 ≤ a := by omega
  have hd_ge1 : 1 ≤ d := by omega
  have hd_lt_a : d < a := by omega
  have hd_le_a : d ≤ a := by omega
  have he_ge1 : 1 ≤ e := by omega
  have he_le_a : e ≤ a := by omega
  have hde_add : d + e = a := by omega
  set U : Finset (Mˣ ⧸ unitGroup F M a) := hFinM.toFinset
  let H : ℕ → Finset (Mˣ ⧸ unitGroup F M a) := fun m =>
    U.filter (fun u => cosetRep u ∈ unitGroup F M m)
  have hmem_U : ∀ u : Mˣ ⧸ unitGroup F M a,
      u ∈ U ↔ valL F M ((cosetRep u : Mˣ) : M) = 0 := by
    intro u
    simp [U, Set.Finite.mem_toFinset]
  have hout : ∀ u : Mˣ ⧸ unitGroup F M a,
      QuotientGroup.mk (s := unitGroup F M a) (cosetRep u) = u :=
    fun u => QuotientGroup.out_eq' u
  have hcoset_mk : ∀ x : Mˣ,
      x⁻¹ * cosetRep (QuotientGroup.mk (s := unitGroup F M a) x) ∈ unitGroup F M a := by
    intro x
    exact QuotientGroup.eq.mp (hout _).symm
  have hsub_unit : ∀ {m₁ m₂ : ℕ}, 1 ≤ m₁ → m₁ ≤ m₂ →
      unitGroup F M m₂ ≤ unitGroup F M m₁ := by
    intro m₁ m₂ hm₁ hm₁₂ u hu
    have hm₂ : 1 ≤ m₂ := by omega
    rw [hunit_ge1 m₁ hm₁]
    rcases (hunit_ge1 m₂ hm₂ u).mp hu with hu1 | hum₂
    · exact Or.inl hu1
    · right; omega
  have hmem_unit_mk : ∀ {m : ℕ}, 1 ≤ m → m ≤ a → ∀ x : Mˣ,
      cosetRep (QuotientGroup.mk (s := unitGroup F M a) x) ∈ unitGroup F M m ↔
        x ∈ unitGroup F M m := by
    intro m hm hma x
    set r := cosetRep (QuotientGroup.mk (s := unitGroup F M a) x)
    set k := x⁻¹ * r
    have hk : k ∈ unitGroup F M m := hsub_unit hm hma (hcoset_mk x)
    have hr_eq : r = x * k := by simp [k]
    rw [hr_eq]
    exact Subgroup.mul_mem_cancel_right (unitGroup F M m) hk
  have hmem_H : ∀ {m : ℕ} (u : Mˣ ⧸ unitGroup F M a),
      u ∈ H m ↔ cosetRep u ∈ unitGroup F M m := by
    intro m u
    dsimp only [H]
    rw [Finset.mem_filter, hmem_U]
    exact ⟨fun h => h.2, fun h => ⟨hunit_val0 m (cosetRep u) h, h⟩⟩
  have hH_mk : ∀ {m : ℕ}, 1 ≤ m → m ≤ a → ∀ w : Mˣ,
      QuotientGroup.mk (s := unitGroup F M a) w ∈ H m ↔ w ∈ unitGroup F M m := by
    intro m hm hma w
    rw [hmem_H, hmem_unit_mk hm hma]
  have hH_mul : ∀ {m : ℕ}, 1 ≤ m → m ≤ a →
      ∀ {u₁ u₂ : Mˣ ⧸ unitGroup F M a}, u₁ ∈ H m → u₂ ∈ H m → u₁ * u₂ ∈ H m := by
    intro m hm hma u₁ u₂ hu₁ hu₂
    rw [hmem_H] at hu₁ hu₂ ⊢
    have hmul : u₁ * u₂ = QuotientGroup.mk (s := unitGroup F M a) (cosetRep u₁ * cosetRep u₂) := by
      rw [QuotientGroup.mk_mul, hout, hout]
    rw [hmul, hmem_unit_mk hm hma]
    exact mul_mem hu₁ hu₂
  have hH_inv : ∀ {m : ℕ}, 1 ≤ m → m ≤ a →
      ∀ {u : Mˣ ⧸ unitGroup F M a}, u ∈ H m → u⁻¹ ∈ H m := by
    intro m hm hma u hu
    rw [hmem_H] at hu ⊢
    have hinv : u⁻¹ = QuotientGroup.mk (s := unitGroup F M a) (cosetRep u)⁻¹ := by
      rw [QuotientGroup.mk_inv, hout]
    rw [hinv, hmem_unit_mk hm hma]
    exact inv_mem hu
  have hH_mono : ∀ {m₁ m₂ : ℕ}, 1 ≤ m₁ → m₁ ≤ m₂ →
      ∀ {u : Mˣ ⧸ unitGroup F M a}, u ∈ H m₂ → u ∈ H m₁ := by
    intro m₁ m₂ hm₁ hm₁₂ u hu
    rw [hmem_H] at hu ⊢
    exact hsub_unit hm₁ hm₁₂ hu
  have hHa_eq : H a = {1} := by
    ext u
    rw [hmem_H, Finset.mem_singleton, ← QuotientGroup.eq_one_iff (cosetRep u), hout u]
  have hHa_card : (H a).card = 1 := by
    rw [hHa_eq, Finset.card_singleton]
  have hϖ_pow_val : ∀ k : ℕ, valL F M ((ϖ_M ^ k : Mˣ) : M) = (k : ℤ) := by
    intro k
    induction k with
    | zero => simp [hval1]
    | succ k ih =>
      rw [pow_succ', Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _), hϖ_M, ih]
      omega
  have hϖ_pow_inv_val : ∀ k : ℕ, valL F M (((ϖ_M ^ k)⁻¹ : Mˣ) : M) = - (k : ℤ) := by
    intro k
    rw [hval_inv (ϖ_M ^ k), hϖ_pow_val k]
  have hval_mul_ge : ∀ {k₁ k₂ : ℤ} {x y : M},
      (x = 0 ∨ k₁ ≤ valL F M x) → (y = 0 ∨ k₂ ≤ valL F M y) →
        (x * y = 0 ∨ k₁ + k₂ ≤ valL F M (x * y)) := by
    intro k₁ k₂ x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rcases hx with rfl | hx_ge
        · contradiction
        · rcases hy with rfl | hy_ge
          · contradiction
          · rw [hval_mul x y hx0 hy0]; omega
  have hresM_congr : ∀ {x y : M},
      (x = 0 ∨ 0 ≤ valL F M x) → (y = 0 ∨ 0 ≤ valL F M y) →
      (x - y = 0 ∨ 1 ≤ valL F M (x - y)) → resM x = resM y := by
    intro x y hx hy hdiff
    have hnegy : -y = 0 ∨ 0 ≤ valL F M (-y) := by
      rcases hy with rfl | hy0
      · left; ring
      · right; rw [hval_neg]; exact hy0
    have hxy_int : x - y = 0 ∨ 0 ≤ valL F M (x - y) := by
      rcases hdiff with h0 | h1
      · exact Or.inl h0
      · right; omega
    have hker0 : resM (x - y) = 0 := (hresM_ker (x - y) hxy_int).mpr hdiff
    have hsub_eq : resM (x - y) = resM x - resM y := by
      rw [sub_eq_add_neg, (hresM_ring x (-y) hx hnegy).1, (hresM_ring y y hy hy).2.2,
        ← sub_eq_add_neg]
    rw [hsub_eq] at hker0
    exact sub_eq_zero.mp hker0
  let s_M : k_M → M := fun b => (hresM_surj b).choose
  have hs_M_int : ∀ b : k_M, s_M b = 0 ∨ 0 ≤ valL F M (s_M b) :=
    fun b => (hresM_surj b).choose_spec.1
  have hs_M_res : ∀ b : k_M, resM (s_M b) = b :=
    fun b => (hresM_surj b).choose_spec.2
  have hone_add_ne_zero : ∀ {m : ℕ}, 1 ≤ m → ∀ {y : M},
      (y = 0 ∨ 0 ≤ valL F M y) → 1 + ((ϖ_M ^ m : Mˣ) : M) * y ≠ 0 := by
    intro m hm y hy hzero
    set z : M := ((ϖ_M ^ m : Mˣ) : M) * y
    have hz_val : z = 0 ∨ (m : ℤ) ≤ valL F M z := by
      have h1 : ((ϖ_M ^ m : Mˣ) : M) = 0 ∨ (m : ℤ) ≤ valL F M ((ϖ_M ^ m : Mˣ) : M) := by
        right; rw [hϖ_pow_val m]
      simpa [z] using hval_mul_ge h1 hy
    have hz_neg1 : z = -1 := eq_neg_of_add_eq_zero_right hzero
    rcases hz_val with hz0 | hzm
    · rw [hz_neg1] at hz0
      exact (neg_ne_zero.mpr one_ne_zero) hz0
    · rw [hz_neg1, hval_neg1] at hzm
      omega
  let w_m : (m : ℕ) → 1 ≤ m → k_M → Mˣ := fun m hm b =>
    Units.mk0 (1 + ((ϖ_M ^ m : Mˣ) : M) * s_M b) (hone_add_ne_zero hm (hs_M_int b))
  let γ_m : (m : ℕ) → 1 ≤ m → k_M → Mˣ ⧸ unitGroup F M a := fun m hm b =>
    QuotientGroup.mk (s := unitGroup F M a) (w_m m hm b)
  have hw_m_sub : ∀ (m : ℕ) (hm : 1 ≤ m) (b : k_M),
      ((w_m m hm b : Mˣ) : M) - 1 = ((ϖ_M ^ m : Mˣ) : M) * s_M b := by
    intro m hm b
