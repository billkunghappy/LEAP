      hbE'_ge2 hbM₁'_ge2 hb_le hT1_even hT2_odd hQuadNorm hStatL hSpecL.1
      hvalL_props hvalE'_props hvalM₁'_props
      hval_normE' hval_normM₁' hval_LE' hval_LM₁' htr_LE'
      hnorm_iff_le_M₁' hnorm_surj_lt_M₁'
      τ₁ hτ₁_L hτ₁_tr hτ₁_norm hτ₁_twist
