      change (1 : ℤ) ≤ valL F M_C (normLM F hM_CK (w₁ : K) - 1)
      have hq_pos_int : (0 : ℤ) < (q : ℤ) := by exact_mod_cast hq_pos
      nlinarith

  
  let r_δ : K := (δ : K) - IntermediateField.inclusion hM_CK (u_zδ : M_C)
  let w_δ : K := r_δ * ((ϖ_K ^ t : Kˣ) : K)
