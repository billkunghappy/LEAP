    intro m₁' m₂' x hm hx
    rcases hx with rfl | hx
    · exact Or.inl rfl
    · exact Or.inr (le_trans hm hx)
  have hvalM₁'_mul_ge : ∀ (m₁' m₂' : ℤ) (x y : M₁'),
