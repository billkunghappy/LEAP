    have hE'E₁ : E' ≤ E₁ := (h_le_iff M_E' M_E₁).mpr (Subgroup.map_mono hN₁_le_HF')
    have hL'E_L' : L' ≤ E_L' := (h_le_iff M_L' M_EL').mpr (h_map_le_comap H_L')
    have hF'E' : F' ≤ E' := (h_le_iff M_F' M_E').mpr (h_map_le_comap H_F')
    have hE_L'K : E_L' ≤ K := (h_bounds M_EL').2
    have hE'K : E' ≤ K := (h_bounds M_E').2
    have hF'L'_inf : F' ⊓ L' = L :=
      (h_sup_eq_inf M_F' M_L').symm.trans ((congrArg fieldOf hMF'_sup_ML').trans h_field_top)
    have hF'L'_sup : F' ⊔ L' = M₁ :=
      (h_inf_eq_sup M_F' M_L').symm.trans (congrArg fieldOf hMF'_inf_ML')
    have hE'EL'_inf : E' ⊓ E_L' = E :=
      (h_sup_eq_inf M_E' M_EL').symm.trans ((congrArg fieldOf hME'_sup_MEL').trans h_field_H)
    have hE'EL'_sup : E' ⊔ E_L' = E₁ :=
      (h_inf_eq_sup M_E' M_EL').symm.trans (congrArg fieldOf hME'_inf_MEL')
    have h_E_sup_comap : ∀ S : Subgroup H,
        E ⊔ fieldOf (S.comap proj_H) = fieldOf (S.map H.subtype) :=
      fun S => (congrArg (· ⊔ fieldOf (S.comap proj_H)) h_field_H.symm).trans
        ((h_inf_eq_sup H (S.comap proj_H)).symm.trans (congrArg fieldOf (h_inf_comap_eq_map S)))
    have hEL'_sup : E ⊔ L' = E_L' := h_E_sup_comap H_L'
    have hEF'_sup : E ⊔ F' = E' := h_E_sup_comap H_F'
    have hEM₁_sup : E ⊔ M₁ = E₁ := h_E_sup_comap N₁
    have h_finrank_of_eq : ∀ (M₁ M₂ : Subgroup G₀) (A : ℒ),
        fieldOf M₂ = A → ∀ (h : A ≤ fieldOf M₁), deg h = M₁.relIndex M₂ := by
      rintro M₁ M₂ A ⟨⟩ h
      exact h_finrank_relIndex M₁ M₂ h
    have hFinL'M₁ : deg hL'M₁ = q₀ :=
      (h_finrank_relIndex M_M₁ M_L' hL'M₁).trans h_idx_MM₁_ML'
    have hFinLF' : deg hLF' = q₀ :=
      (h_finrank_of_eq M_F' ⊤ L h_field_top hLF').trans h_idx_MF'_top
    have hFinLL' : deg hLL' = H_L'.index :=
      (h_finrank_of_eq M_L' ⊤ L h_field_top hLL').trans h_idx_ML'_top
    have hFinEL'E₁ : deg hE_L'E₁ = q₀ :=
      (h_finrank_relIndex M_E₁ M_EL' hE_L'E₁).trans h_idx_ME₁_MEL'
    have hFinEE' : deg hEE' = q₀ :=
      (h_finrank_of_eq M_E' H E h_field_H hEE').trans h_idx_ME'_H
    have hFinEEL' : deg hEE_L' = H_L'.index :=
      (h_finrank_of_eq M_EL' H E h_field_H hEE_L').trans h_idx_MEL'_H
    have h_lt_of_relIndex : ∀ {M₁ M₂ : Subgroup G₀},
        M₁ ≤ M₂ → 1 < M₁.relIndex M₂ → fieldOf M₂ < fieldOf M₁ := by
      intro M₁ M₂ hle hgt
      rw [h_lt_iff]
      refine lt_of_le_of_ne hle ?_
      rintro rfl
      exact lt_irrefl 1 (lt_of_lt_of_eq hgt M₁.relIndex_self)
    have hLL'_lt : L < L' :=
      lt_of_eq_of_lt h_field_top.symm
        (h_lt_of_relIndex le_top (lt_of_lt_of_eq hHL'_idx_gt1 h_idx_ML'_top.symm))
    have hLF'_lt : L < F' :=
      lt_of_eq_of_lt h_field_top.symm
        (h_lt_of_relIndex le_top (lt_of_lt_of_eq hq₀_prime.one_lt h_idx_MF'_top.symm))
    have hEEL'_lt : E < E_L' :=
      lt_of_eq_of_lt h_field_H.symm
        (h_lt_of_relIndex (h_map_le_H H_L') (lt_of_lt_of_eq hHL'_idx_gt1 h_idx_MEL'_H.symm))
    have h_conj_comap : ∀ (S : Subgroup H) [S.Normal] (g : G₀),
        g ∈ (⊤ : Subgroup G₀) → ∀ n ∈ S.comap proj_H, g * n * g⁻¹ ∈ S.comap proj_H := by
      intro S hS_norm g _ n hn
      haveI : (S.comap proj_H).Normal := Subgroup.Normal.comap hS_norm proj_H
      exact ‹(S.comap proj_H).Normal›.conj_mem n hn g
    have h_conj_map_H : ∀ (S : Subgroup H) [S.Normal] (g : G₀),
        g ∈ H → ∀ n ∈ S.map H.subtype, g * n * g⁻¹ ∈ S.map H.subtype := by
      intro S hS_norm g hgH n hn
      rcases Subgroup.mem_map.mp hn with ⟨s, hsS, rfl⟩
      exact Subgroup.mem_map.mpr ⟨⟨g, hgH⟩ * s * ⟨g, hgH⟩⁻¹, hS_norm.conj_mem s hsS ⟨g, hgH⟩, rfl⟩
    have hGalLM₁ : GalExt L M₁ :=
      h_field_top ▸ h_gal_fieldOf ⊤ M_M₁ le_top (h_conj_comap N₁)
    have hGalLL' : GalExt L L' :=
      h_field_top ▸ h_gal_fieldOf ⊤ M_L' le_top (h_conj_comap H_L')
    have hGalEE₁ : GalExt E E₁ :=
      h_field_H ▸ h_gal_fieldOf H M_E₁ (h_map_le_H N₁) (h_conj_map_H N₁)
    have hGalEEL' : GalExt E E_L' :=
      h_field_H ▸ h_gal_fieldOf H M_EL' (h_map_le_H H_L') (h_conj_map_H H_L')
    have hAbL'M₁ : AbExt hL'M₁ := by
      apply h_ab_fieldOf M_L' M_M₁ hL'M₁
      · intro g _ n hn
        haveI : M_M₁.Normal := Subgroup.Normal.comap hN₁_norm proj_H
        exact ‹M_M₁.Normal›.conj_mem n hn g
      · intro a ha b hb
        rw [Subgroup.mem_comap] at ha hb ⊢
        simp only [map_mul, map_inv]
        exact hHL'_comm (proj_H a) ha (proj_H b) hb
    have hAbEL'E₁ : AbExt hE_L'E₁ := by
      apply h_ab_fieldOf M_EL' M_E₁ hE_L'E₁
      · intro g hg n hn
        exact h_conj_map_H N₁ g (h_map_le_H H_L' hg) n hn
      · intro a ha b hb
        rcases Subgroup.mem_map.mp ha with ⟨x, hx, rfl⟩
        rcases Subgroup.mem_map.mp hb with ⟨y, hy, rfl⟩
        exact Subgroup.mem_map.mpr ⟨x * y * x⁻¹ * y⁻¹, hHL'_comm x hx y hy, rfl⟩
    have hMinLM₁ : MinSub L M₁ (hLL'.trans hL'M₁) L' hLL' hL'M₁ :=
      h_min_of_prime L L' M₁ hLL' hL'M₁ (h_bounds M_M₁).2 hGalLL' hAbL'M₁
        (hFinL'M₁.symm ▸ hq₀_prime)
    have hMinEE₁ : MinSub E E₁ (hEE_L'.trans hE_L'E₁) E_L' hEE_L' hE_L'E₁ :=
      h_min_of_prime E E_L' E₁ hEE_L' hE_L'E₁ (h_bounds M_E₁).2 hGalEEL' hAbEL'E₁
        (hFinEL'E₁.symm ▸ hq₀_prime)
    have hCore_M₁ : ¬ ∃ (K₁ : ℒ) (hLK₁ : L ≤ K₁),
        K₁ ≤ M₁ ∧ GalExt L K₁ ∧ F' ≤ K₁ ∧ deg hLK₁ < deg (hLL'.trans hL'M₁) := by
      rintro ⟨K₁, hLK₁, hK₁M₁, hGalK₁, hF'K₁, h_lt⟩
      have hK₁K : K₁ ≤ K := hK₁M₁.trans (h_bounds M_M₁).2
      obtain ⟨M_K₁, hMK₁_norm, hMK₁_field⟩ := h_exists_norm_sub K₁ hLK₁ hK₁K hGalK₁
      have hMM₁_le_MK₁ : M_M₁ ≤ M_K₁ :=
        (h_le_iff M_K₁ M_M₁).mp (le_of_eq_of_le hMK₁_field hK₁M₁)
      have hMK₁_le_MF' : M_K₁ ≤ M_F' :=
        (h_le_iff M_F' M_K₁).mp (le_of_le_of_eq hF'K₁ hMK₁_field.symm)
      have hMK₁_le_MM₁ : M_K₁ ≤ M_M₁ := by
        intro g hg
        rw [Subgroup.mem_comap]
        have hhF' : proj_H g ∈ H_F' := hMK₁_le_MF' hg
        apply hZ_HF' (proj_H g) hhF'
        intro c hc
        have hk_MK₁ : g * c.1 * g⁻¹ * c.1⁻¹ ∈ M_K₁ := by
          have hconj : c.1 * g⁻¹ * c.1⁻¹ ∈ M_K₁ :=
            hMK₁_norm.conj_mem g⁻¹ (M_K₁.inv_mem hg) c.1
          have heq : g * c.1 * g⁻¹ * c.1⁻¹ = g * (c.1 * g⁻¹ * c.1⁻¹) := by simp only [mul_assoc]
          rw [heq]
          exact M_K₁.mul_mem hg hconj
        have hk_MF' : g * c.1 * g⁻¹ * c.1⁻¹ ∈ M_F' := hMK₁_le_MF' hk_MK₁
        rw [Subgroup.mem_comap] at hk_MF'
        have hproj_k : proj_H (g * c.1 * g⁻¹ * c.1⁻¹) = proj_H g * c * (proj_H g)⁻¹ * c⁻¹ := by
          simp only [map_mul, map_inv, hproj_id c]
        rw [hproj_k] at hk_MF'
        have hk_HL' : proj_H g * c * (proj_H g)⁻¹ * c⁻¹ ∈ H_L' :=
          H_L'.mul_mem (hHL'_norm.conj_mem c hc (proj_H g)) (H_L'.inv_mem hc)
        exact hHF'_HL'_inf _ hk_MF' hk_HL'
      have hMK₁_eq : M_K₁ = M_M₁ := le_antisymm hMK₁_le_MM₁ hMM₁_le_MK₁
      have hK₁_eq : K₁ = M₁ := hMK₁_field.symm.trans (congrArg fieldOf hMK₁_eq)
      subst hK₁_eq
      exact lt_irrefl _ h_lt
    have hWeil_comap : ∀ (S : Subgroup H) (w : W₀),
        weilPred (fieldOf (S.comap proj_H)) w ↔ ∃ h ∈ S, ∃ c ∈ C, π w = h.1 * c :=
      fun S w => (h_weil_fieldOf (S.comap proj_H) w).trans (hcomap_mem S (π w))
    have hFix_comap : ∀ (S : Subgroup H) (x : X₀),
        fixPred (fieldOf (S.comap proj_H)) x ↔ ∀ h ∈ S, ∀ c ∈ C, actX (h.1 * c) x = x := by
      intro S x
      rw [h_fix_fieldOf (S.comap proj_H) x]
      constructor
      · intro hx h hhS c hcC
        exact hx (h.1 * c) ((hcomap_mem S (h.1 * c)).mpr ⟨h, hhS, c, hcC, rfl⟩)
      · intro hx g hg
        obtain ⟨h, hhS, c, hcC, rfl⟩ := (hcomap_mem S g).mp hg
        exact hx h hhS c hcC
    exact ⟨L', F', M₁, E_L', E', E₁, hLL', hL'M₁, hM₁MC, hLF', hF'M₁,
      hEE_L', hE_L'E₁, hEE', hE'E₁, hL'E_L', hF'E', hE_L'K, hE'K,
      hLL'_lt, hLF'_lt, hF'L'_inf, hF'L'_sup, hE'EL'_inf, hE'EL'_sup,
      hEEL'_lt, hEL'_sup, hEF'_sup, hEM₁_sup,
      hGalLM₁, hGalEE₁, hMinLM₁, hMinEE₁,
      hFinL'M₁, hFinLF', hFinLL', hFinEL'E₁, hFinEE', hFinEEL',
      hCore_M₁,
      hWeil_comap H_L', hWeil_comap H_F', hWeil_comap N₁,
      hFix_comap H_L', hFix_comap H_F', hFix_comap N₁⟩
  exact h_abs L K M_C E q₀ hq₀_prime
    (fun M => (IntermediateField.lift (IntermediateField.fixedField M)).restrictScalars F)
    (fun {A B} h => Module.finrank A (IntermediateField.extendScalars h))
    (IsGaloisExt F)
    (fun {A B} h => IsAbelianExt F h)
    (IsMinimalAbelianNormalSubfield F)
    (fun A w => w ∈ (relWeil F A).subgroupOf (relWeil F L))
    (fun A (x : IntermediateField.extendScalars hLK) => (x : AlgebraicClosure F) ∈ A)
    (fun (g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK)
      (x : IntermediateField.extendScalars hLK) => g x)
    π C H h_sub_MC h_field_top proj_H hproj_id hproj_surj hproj_ker hcomap_mem h_field_H
    h_bounds h_le_iff h_lt_iff h_sup_eq_inf h_inf_eq_sup h_finrank_relIndex h_weil_fieldOf
    h_fix_fieldOf h_gal_fieldOf h_ab_fieldOf h_exists_norm_sub h_min_of_prime
    N₁ H_L' H_F' hN₁_norm hHL'_norm hN₁_le_HL' hN₁_le_HF' hHF'_HL'_inf hHF'_HL'_mul
    hHL'_idx_gt1 hHF'_idx_eq hN₁_HL'_idx_eq hHL'_comm hZ_HF'

theorem ld_ch14_tame_subdiamond_Dtame_E_and_eval_prod (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (rec : LocalReciprocity F)
    (L K M_C E L' F' M₁ E_L' E' E₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E] [FiniteDimensional F K]
    (hLK : L ≤ K) (hLM_C : L ≤ M_C) (hM_CK : M_C ≤ K)
    (hLE : L ≤ E) (hEK : E ≤ K)
    [FiniteDimensional L (IntermediateField.extendScalars hLK)]
    [IsGalois L (IntermediateField.extendScalars hLK)]
    (hLL' : L ≤ L') (hL'M₁ : L' ≤ M₁) (hM₁MC : M₁ ≤ M_C)
    (hLF' : L ≤ F') (hF'M₁ : F' ≤ M₁)
    (hEE_L' : E ≤ E_L') (hE_L'E₁ : E_L' ≤ E₁)
    (hEE' : E ≤ E') (hE'E₁ : E' ≤ E₁)
    (hL'E_L' : L' ≤ E_L') (hF'E' : F' ≤ E') (hE_L'K : E_L' ≤ K) (hE'K : E' ≤ K)
    (hEL'_sup : E ⊔ L' = E_L') (hEF'_sup : E ⊔ F' = E')
    (hGal : IsGaloisExt F L K) (ψ : AddChar L (Ω F))
    (htr_self_L : traceChar F (le_rfl : L ≤ L) ψ = ψ)
    (htr_EL' : traceChar F hEE_L' (traceChar F hLE ψ) = traceChar F (hLL'.trans hL'E_L') ψ)
    (χL_ext : relWeil F L →* (Ω F)ˣ)
    (q₀ : ℕ) (hq₀_prime : Nat.Prime q₀)
    (hFinL'M₁ : Module.finrank L' (IntermediateField.extendScalars hL'M₁) = q₀)
    (hFinEL'E₁ : Module.finrank E_L' (IntermediateField.extendScalars hE_L'E₁) = q₀)
    (hFinEEL' : Module.finrank E (IntermediateField.extendScalars hEE_L') =
      Module.finrank L (IntermediateField.extendScalars hLL'))
    (π : relWeil F L →* (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (C H : Subgroup (IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK))
    (hsurj : Function.Surjective π)
    (hG_mul : ∀ g : IntermediateField.extendScalars hLK ≃ₐ[L] IntermediateField.extendScalars hLK,
      ∃ h ∈ H, ∃ c ∈ C, g = h * c)
    (h_mem_H : ∀ w : relWeil F L, w ∈ (relWeil F E).subgroupOf (relWeil F L) ↔ π w ∈ H)
    (h_mem_C : ∀ w : relWeil F L, w ∈ (relWeil F M_C).subgroupOf (relWeil F L) ↔ π w ∈ C)
    (D_tame : List (MonomialTerm F L))
    (hr_mul : D_tame.length * Module.finrank L (IntermediateField.extendScalars hLL') = q₀ - 1)
    (μ_orb : Fin D_tame.length → (relWeil F L' →* (Ω F)ˣ))
    (hμ_props : ∀ i : Fin D_tame.length,
      IsWeilRep F L' (charRep F L' (μ_orb i)) ∧
      restrictWeilChar F hL'M₁ (μ_orb i) = 1 ∧
      (μ_orb i) ^ (Module.finrank L' (IntermediateField.extendScalars hL'M₁)) = 1 ∧
      μ_orb i ≠ 1)
    (hμ_trace : ∀ w : relWeil F L,
      (⟨1, F', hLF', 1⟩ : MonomialTerm F L).trace F L w =
        (⟨1, L, le_rfl, 1⟩ : MonomialTerm F L).trace F L w +
          ∑ i : Fin D_tame.length, (⟨1, L', hLL', μ_orb i⟩ : MonomialTerm F L).trace F L w)
    (hμ_eval_un : evalMonomialList F rec (fun _ _ _ => 1) L ψ (⟨1, L, le_rfl, 1⟩ :: D_tame) =
      tateEpsUnit F L (recChar F rec L 1) ψ *
        (∏ i : Fin D_tame.length,
          tateEpsUnit F L' (recChar F rec L' (μ_orb i)) (traceChar F hLL' ψ)))
    (hμ_eval_tw : evalMonomialList F rec (fun _ _ _ => 1) L ψ
        ((⟨1, L, le_rfl, 1⟩ :: D_tame).map (twistMonomialTerm F L χL_ext)) =
      tateEpsUnit F L (recChar F rec L χL_ext) ψ *
        (∏ i : Fin D_tame.length,
          tateEpsUnit F L'
            (recChar F rec L' (μ_orb i * restrictWeilChar F hLL' χL_ext))
            (traceChar F hLL' ψ))) :
    let hL'MC : L' ≤ M_C := hL'M₁.trans hM₁MC
    ∃ (D_tame_E : List (MonomialTerm F E))
      (ν_list : List (relWeil F L' →* (Ω F)ˣ)),
      D_tame_E.length = D_tame.length ∧
      ν_list.length = D_tame.length ∧
      IsSubMonomialDecomp F E E_L' E' hEE' (⟨1, E, le_rfl, 1⟩ :: D_tame_E) ∧
      monomialListDeg F E D_tame_E =
        (Module.finrank E_L' (IntermediateField.extendScalars hE_L'E₁) : ℤ) - 1 ∧
      (∀ t ∈ D_tame_E,
        t.coeff = 1 ∧
        t.field = E_L' ∧
        t.χ ^ (Module.finrank E_L' (IntermediateField.extendScalars hE_L'E₁)) = 1 ∧
        (∃ htK : t.field ≤ E₁, restrictWeilChar F htK t.χ = 1) ∧
        (∃ htE : t.field ≤ E' ⊔ t.field, restrictWeilChar F htE t.χ = 1) ∧
        (∀ htM : t.field ≤ E_L', restrictWeilChar F htM t.χ ≠ 1)) ∧
      (∀ ν' ∈ ν_list, restrictWeilChar F hL'MC ν' = 1 ∧ ν' ^ q₀ = 1) ∧
      evalMonomialList F rec (fun _ _ _ => 1) L ψ D_tame =
        (ν_list.map (fun ν' =>
          tateEpsUnit F L' (recChar F rec L' ν') (traceChar F hLL' ψ))).prod ∧
      evalMonomialList F rec (fun _ _ _ => 1) L ψ
          (D_tame.map (twistMonomialTerm F L χL_ext)) =
        (ν_list.map (fun ν' =>
          tateEpsUnit F L'
            (recChar F rec L' (ν' * restrictWeilChar F hLL' χL_ext))
            (traceChar F hLL' ψ))).prod ∧
      evalMonomialList F rec (fun _ _ _ => 1) E (traceChar F hLE ψ) D_tame_E =
        (ν_list.map (fun ν' =>
          tateEpsUnit F E_L'
            (recChar F rec E_L' (restrictWeilChar F hL'E_L' ν'))
            (traceChar F (hLL'.trans hL'E_L') ψ))).prod ∧
      evalMonomialList F rec (fun _ _ _ => 1) E (traceChar F hLE ψ)
          (D_tame_E.map (twistMonomialTerm F E (restrictWeilChar F hLE χL_ext))) =
        (ν_list.map (fun ν' =>
          tateEpsUnit F E_L'
            (recChar F rec E_L'
              (restrictWeilChar F hL'E_L' (ν' * restrictWeilChar F hLL' χL_ext)))
            (traceChar F (hLL'.trans hL'E_L') ψ))).prod :=
by
  intro hL'MC
  obtain ⟨hp, hFrob⟩ := ld_frob_pow_on_primeToP_roots F
  have hFin_sub : ∀ {A : IntermediateField F (AlgebraicClosure F)},
      A ≤ K → FiniteDimensional F A := by
    intro A hAK
    exact Module.Finite.of_injective (IntermediateField.inclusion hAK).toLinearMap
      (IntermediateField.inclusion hAK).injective
  have h_sep_sub : ∀ (B A : IntermediateField F (AlgebraicClosure F))
      (hLB : L ≤ B) (hBA : B ≤ A),
      A ≤ K → Algebra.IsSeparable B (IntermediateField.extendScalars hBA) := by
    intro B A hLB hBA hAK
    have hBK : B ≤ K := hBA.trans hAK
    have hGalBK : IsGaloisExt F B K :=
      ((ld_galois_closure_directed_system F).2.1 L B K hLB hBK hGal).1
    haveI : Algebra.IsSeparable B (IntermediateField.extendScalars hBK) := hGalBK.2.2.2 hBK
    let S_A := IntermediateField.extendScalars hBA
    let S_K := IntermediateField.extendScalars hBK
    refine ⟨fun x => ?_⟩
    have hxA : (x : AlgebraicClosure F) ∈ A := (IntermediateField.mem_extendScalars hBA).mp x.2
    let x_K : S_K := ⟨x.1, (IntermediateField.mem_extendScalars hBK).mpr (hAK hxA)⟩
    have hmin1 : (minpoly B (S_A.val x)).Separable ↔ (minpoly B x).Separable := by
      rw [minpoly.algHom_eq S_A.val S_A.val.injective x]
    have hmin2 : (minpoly B (S_K.val x_K)).Separable ↔ (minpoly B x_K).Separable := by
      rw [minpoly.algHom_eq S_K.val S_K.val.injective x_K]
    exact hmin1.mp (hmin2.mpr (Algebra.IsSeparable.isSeparable B x_K))
  have hFinrank_tower : ∀ {A B : IntermediateField F (AlgebraicClosure F)}
      [FiniteDimensional F A] [FiniteDimensional F B] (hAB : A ≤ B),
      Module.finrank F A * Module.finrank A (IntermediateField.extendScalars hAB) =
        Module.finrank F B := by
    intro A B _ _ hAB
    let B_A := IntermediateField.extendScalars hAB
    haveI : FiniteDimensional F ↥B_A := ‹FiniteDimensional F B›
    haveI : IsScalarTower F A ↥B_A := IsScalarTower.of_algebraMap_eq fun _ => rfl
