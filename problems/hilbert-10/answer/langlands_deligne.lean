        exact mul_right_cancel₀ hψ_ne0 (h1.symm.trans (one_mul _).symm)
      obtain ⟨_, ⟨x₁, hx₁_ne0, hx₁_val, hx₁_ψ⟩⟩ := hSpec_all F_i ψ_Fi (hψFi i)
      have hΔ_val : Δ_i = 0 ∨ -((M : ℤ) + n_Fi) ≤ valL F F_i Δ_i := by
        by_cases hΔ0 : Δ_i = 0
        · exact Or.inl hΔ0
        · right
          by_contra hlt
          let u_Δ : F_iˣ := Units.mk0 Δ_i hΔ0
          let x : F_i := ((u_Δ⁻¹ : F_iˣ) : F_i) * x₁
          have hx_ne0 : x ≠ 0 := mul_ne_zero (Units.ne_zero u_Δ⁻¹) hx₁_ne0
