      rcases htr1_bound with h20 | h2_ge1
      · exact h2_M₁'_ne h20
      · rw [h2_M₁'_val] at h2_ge1
        omega
    omega
  
  set h := mM₁' - T
  set d_U := mM₁' / 2
  set d_E := mE' / 2
  have hT_le_mM₁' : T ≤ mM₁' := by omega
  have hTh_eq : T + h = mM₁' := Nat.add_sub_of_le hT_le_mM₁'
  have hdE_def : (T + p * h) / 2 = d_E := by
    rw [← hmE'_eq]
  have h3h_le_ph : 3 * h ≤ p * h := Nat.mul_le_mul_right h hp_ge3
  have hmM₁'_le_dE_nat : mM₁' ≤ d_E := by omega
  have hmM₁'_le_dE : (mM₁' : ℤ) ≤ (d_E : ℤ) := by omega
  have hdU_le_mM₁' : (d_U : ℤ) ≤ (mM₁' : ℤ) := by omega
  have hdE_ge4 : (4 : ℤ) ≤ (d_E : ℤ) := by omega
  have htr_cond_dU :
      (p : ℤ) * (d_U : ℤ) - ((p - 1 : ℕ) : ℤ) * (T : ℤ) ≤ (d_E : ℤ) := by
    have hmE'_int : (mE' : ℤ) = (T : ℤ) + (p : ℤ) * ((mM₁' : ℤ) - (T : ℤ)) := by
      have h1 : mE' = T + p * (mM₁' - T) := hmE'_eq
      rw [h1, Nat.cast_add, Nat.cast_mul, Nat.cast_sub hT_le_mM₁']
    have hp_sub1 : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by
      rw [Nat.cast_sub hp_ge1, Nat.cast_one]
    have hnonneg1 : (0 : ℤ) ≤ (p : ℤ) * ((mM₁' : ℤ) - 2 * (d_U : ℤ)) :=
      mul_nonneg (by omega) (by omega)
    have hnonneg2 : (0 : ℤ) ≤ ((p : ℤ) - 2) * (T : ℤ) :=
      mul_nonneg (by omega) (by omega)
    have hid : (mE' : ℤ) - 2 * ((p : ℤ) * (d_U : ℤ) - ((p : ℤ) - 1) * (T : ℤ)) =
        (p : ℤ) * ((mM₁' : ℤ) - 2 * (d_U : ℤ)) + ((p : ℤ) - 2) * (T : ℤ) + (T : ℤ) := by
      rw [hmE'_int]
      ring
    rw [hp_sub1]
    omega
  have hval_mul_bound_M₁' : ∀ (a b : ℤ) (x y : M₁'),
      (x = 0 ∨ a ≤ valL F M₁' x) → (y = 0 ∨ b ≤ valL F M₁' y) →
        (x * y = 0 ∨ a + b ≤ valL F M₁' (x * y)) := by
    intro a b x y hx hy
    by_cases hx0 : x = 0
    · left; rw [hx0, zero_mul]
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right
        rw [hval_mul_M₁' x y hx0 hy0]
