          rcases mul_eq_zero.mp h_mul with hS0 | hψ0
          · exact hS0
          · exact False.elim (hy₀_ne1 (sub_eq_zero.mp hψ0))
        rw [hS_zero, mul_zero]
    have hSum_RM₁' : ∑ w ∈ R_M₁', H_M₁' w = (qL F L : Ω F) := by
      have hRM₁'_inj' : Set.InjOn ϕ_U ↑(R_L ×ˢ R_L) := by
        rw [Finset.coe_product]
        exact hRM₁'_inj
      dsimp only [R_M₁']
      rw [Finset.sum_image hRM₁'_inj', Finset.sum_product, Finset.sum_comm]
      trans ∑ r₂ ∈ R_L, (if resL r₂ = 0 then (qL F L : Ω F) else 0)
      · refine Finset.sum_congr rfl (fun r₂ hr₂ => hInnerTerm r₂ hr₂)
      · rw [hRL_sum_bij (fun y : k_L => if y = 0 then (qL F L : Ω F) else 0)]
        exact Fintype.sum_ite_eq' (0 : k_L) (fun _ => (qL F L : Ω F))
    have hSum_eq : (∑ r ∈ R_M₁',
        if hr : 1 + (δ_M₁' : M₁') * r ≠ 0 then
          (θM₁' (Units.mk0 (1 + (δ_M₁' : M₁') * r) hr) : Ω F)⁻¹ *
            ψ_U (cM_inv * (δ_M₁' : M₁') * r)
        else 0) = (qL F L : Ω F) := hSum_RM₁'
    rw [hEps_odd hm_odd, hCardPow, hSum_eq]
    have hq_pow : (qL F L : Ω F) ^ (2 * d_U) * (qL F L : Ω F) = (qL F L : Ω F) ^ m := by
      rw [← pow_succ, ← hm_eq]
    calc (qL F M₁' : Ω F) ^ n_U * (qL F L : Ω F) ^ (2 * d_U) *
          (θM₁' cM₁' : Ω F) * ψ_U cM_inv * (qL F L : Ω F)
      _ = (qL F M₁' : Ω F) ^ n_U * ((qL F L : Ω F) ^ (2 * d_U) * (qL F L : Ω F)) *
          (θM₁' cM₁' : Ω F) * ψ_U cM_inv := by ring
      _ = (qL F M₁' : Ω F) ^ n_U * (qL F L : Ω F) ^ m *
          (θM₁' cM₁' : Ω F) * ψ_U cM_inv := by rw [hq_pow]

theorem ld_ch12_wild_dyadic_pos_shift_E_and_nu_prod_eval (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    (hLE' : L ≤ E')
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (νE' : Lˣ →* (Ω F)ˣ) (hbE'_ge2 : 2 ≤ condExp F L νE')
    (θE' : E'ˣ →* (Ω F)ˣ) (θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hmE'_ge2 : 2 ≤ condExp F E' θE')
    (hPosShift : condExp F L νE' < condExp F M₁' θM₁')
    (hmE'_eq : condExp F E' θE' = condExp F L νE' + 2 * (condExp F M₁' θM₁' - condExp F L νE'))
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (c_ν : Lˣ) (x : E') (cE' : E'ˣ)
    (hc_ν_val : valL F L (c_ν : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_ν_stat : ∀ u : L, (u = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((c_ν⁻¹ : Lˣ) : L) * u))
    (hcE'_val : valL F E' (cE' : E') =
      (condExp F E' θE' : ℤ) + condExpChar F E' (traceChar F hLE' ψ))
    (hcE'_stat : ∀ y : E',
      (y = 0 ∨ (((condExp F E' θE' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' y) →
      ∀ hy : 1 + y ≠ 0,
        (θE' (Units.mk0 (1 + y) hy) : Ω F) =
          (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E') * y))
    (hx_ne : x ≠ 0)
    (hx_val : valL F E' x = -((condExp F M₁' θM₁' - condExp F L νE' : ℕ) : ℤ))
    (hCritE'_rec : condExp F L νE' % 2 = 1 →
      ∀ v : E', (v = 0 ∨ ((condExp F E' θE' / 2 : ℕ) : ℤ) ≤ valL F E' v) →
        ∀ (hv : 1 + v ≠ 0) (hw : 1 + normLM F hLE' (x * v) ≠ 0),
          (θE' (Units.mk0 (1 + v) hv) : Ω F)⁻¹ *
            (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E') * v) =
            ((νE' (Units.mk0 (1 + normLM F hLE' (x * v)) hw) : Ω F)⁻¹ *
              ψ (((c_ν⁻¹ : Lˣ) : L) * normLM F hLE' (x * v)))⁻¹)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (R_L : Finset L) (ϖ_E' : E'ˣ) (ϖ_L : Lˣ)
    (hRL_card : R_L.card = qL F L)
    (hRL_int : ∀ r ∈ R_L, r = 0 ∨ 0 ≤ valL F L r)
    (hRL_sep : ∀ r₁ ∈ R_L, ∀ r₂ ∈ R_L, r₁ ≠ r₂ → valL F L (r₁ - r₂) = 0)
    (hRL_surj : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → ∃ r ∈ R_L, x - r = 0 ∨ 1 ≤ valL F L (x - r))
    (hRE'_card : (R_L.image (IntermediateField.inclusion hLE')).card = qL F L)
    (hRE'_int : ∀ r ∈ R_L.image (IntermediateField.inclusion hLE'), r = 0 ∨ 0 ≤ valL F E' r)
    (hRE'_sep : ∀ r₁ ∈ R_L.image (IntermediateField.inclusion hLE'),
      ∀ r₂ ∈ R_L.image (IntermediateField.inclusion hLE'),
      r₁ ≠ r₂ → valL F E' (r₁ - r₂) = 0)
    (hRE'_surj : ∀ y : E', (y = 0 ∨ 0 ≤ valL F E' y) →
      ∃ r ∈ R_L.image (IntermediateField.inclusion hLE'), y - r = 0 ∨ 1 ≤ valL F E' (y - r))
    (hϖ_norm : Units.map (normLM F hLE') ϖ_E' = ϖ_L)
    (hϖ_E' : valL F E' (ϖ_E' : E') = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hnorm_incl : ∀ r : L, normLM F hLE' (IntermediateField.inclusion hLE' r) = r ^ 2)
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E)) *
                ∑ r ∈ R_E,
                  if hr : 1 + (δ : E) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                      ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                  else 0))))
    (hNuPolarInv : condExp F L νE' % 2 = 1 →
      (∑ r ∈ R_L,
        if hr_2 : 1 + ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r ^ 2 ≠ 0 then
          (νE' (Units.mk0 (1 + ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r ^ 2) hr_2) : Ω F) *
            (ψ (((c_ν⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r ^ 2))⁻¹
        else 0) *
      (∑ r ∈ R_L,
        if hr_L : 1 + ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r ≠ 0 then
          (νE' (Units.mk0 (1 + ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r) hr_L) : Ω F)⁻¹ *
            ψ (((c_ν⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r)
        else 0) =
      (qL F L : Ω F)) :
    tateEps F E' θE' (traceChar F hLE' ψ) *
      tateEps F L νE' ψ =
    (qL F E' : Ω F) ^ (condExpChar F E' (traceChar F hLE' ψ)) *
      (qL F L : Ω F) ^ (condExpChar F L ψ) *
      (qL F L : Ω F) ^ (condExp F M₁' θM₁') *
      (θE' cE' : Ω F) *
      (νE' c_ν : Ω F) *
      (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E')) *
      ψ (((c_ν⁻¹ : Lˣ) : L)) :=
by
  classical
  obtain ⟨hvalL0, hvalL1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_surj, hvalL_add,
    hunitL0, hunitL_ge1, hunitL_val0⟩ := hvalL_props
  obtain ⟨hvalE'0, hvalE'1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv, hvalE'_surj,
    hvalE'_add, hunitE'0, hunitE'_ge1, hunitE'_val0⟩ := hvalE'_props
  set T : ℕ := condExp F L νE'
  set mM₁' : ℕ := condExp F M₁' θM₁'
  set mE' : ℕ := condExp F E' θE'
  set d_T : ℕ := T / 2
  set d_E' : ℕ := mE' / 2
  set ψE' : AddChar E' (Ω F) := traceChar F hLE' ψ
  set ι_E := IntermediateField.inclusion hLE'
  set R_E' : Finset E' := R_L.image ι_E
  have hd_T_ge1 : 1 ≤ d_T := by omega
  have hd_E'_ge1 : 1 ≤ d_E' := by omega
  have hd_E'_eq : d_E' = (mM₁' - T) + d_T := by omega
  have h1_add_ne_L : ∀ {u : L}, (u = 0 ∨ (1 : ℤ) ≤ valL F L u) → 1 + u ≠ 0 := by
    intro u hu h0
    have hu_eq : u = -1 := eq_neg_of_add_eq_zero_right h0
    rw [hu_eq] at hu
    rcases hu with h_neg1_0 | h_val
    · exact one_ne_zero (neg_eq_zero.mp h_neg1_0)
    · rw [hvalL_neg1] at h_val
      omega
  have h1_add_ne_E' : ∀ {v : E'}, (v = 0 ∨ (1 : ℤ) ≤ valL F E' v) → 1 + v ≠ 0 := by
    intro v hv h0
    have hv_eq : v = -1 := eq_neg_of_add_eq_zero_right h0
    rw [hv_eq] at hv
    rcases hv with h_neg1_0 | h_val
    · exact one_ne_zero (neg_eq_zero.mp h_neg1_0)
    · rw [hvalE'_neg1] at h_val
      omega
  have hϖ_L_pow_val : ∀ k : ℕ, valL F L (((ϖ_L ^ k : Lˣ) : L)) = (k : ℤ) := by
    intro k
    induction k with
    | zero => simp [hvalL1]
    | succ k ih =>
      rw [pow_succ, Units.val_mul, hvalL_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih, hϖ_L]
      push_cast
      ring
  have hϖ_E'_pow_val : ∀ k : ℕ, valL F E' (((ϖ_E' ^ k : E'ˣ) : E')) = (k : ℤ) := by
    intro k
    induction k with
    | zero => simp [hvalE'1]
    | succ k ih =>
      rw [pow_succ, Units.val_mul, hvalE'_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih, hϖ_E']
      push_cast
      ring
  set δ_T : Lˣ := ϖ_L ^ d_T
  have hδ_T_val : valL F L (δ_T : L) = (d_T : ℤ) := hϖ_L_pow_val d_T
  set x_u : E'ˣ := Units.mk0 x hx_ne
  set δ_E' : E'ˣ := x_u⁻¹ * ϖ_E' ^ d_T
  have hδ_E'_val : valL F E' (δ_E' : E') = (d_E' : ℤ) := by
    dsimp only [δ_E', x_u]
    rw [Units.val_mul, hvalE'_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
      hvalE'_inv (Units.mk0 x hx_ne), Units.val_mk0, hx_val, hϖ_E'_pow_val d_T]
    omega
  obtain ⟨hEpsE'_even, hEpsE'_odd⟩ :=
    ((hStat E' ψE' hψE' θE' hmE'_ge2).2 cE' hcE'_val hcE'_stat).2
      R_E' δ_E' hRE'_int hRE'_sep hRE'_surj hδ_E'_val
  obtain ⟨hEpsL_even, hEpsL_odd⟩ :=
    ((hStat L ψ hψ νE' hbE'_ge2).2 c_ν hc_ν_val hc_ν_stat).2
      R_L δ_T hRL_int hRL_sep hRL_surj hδ_T_val
  rcases Nat.mod_two_eq_zero_or_one T with hT_even | hT_odd
  · have hmE'_even : mE' % 2 = 0 := by omega
    have hd_sum_even : d_E' + d_T = mM₁' := by omega
    have hpow_even : (qL F L : Ω F) ^ d_E' * (qL F L : Ω F) ^ d_T = (qL F L : Ω F) ^ mM₁' := by
      rw [← pow_add, hd_sum_even]
    rw [hEpsE'_even hmE'_even, hEpsL_even hT_even, hRE'_card, hRL_card]
    calc ((qL F E' : Ω F) ^ condExpChar F E' ψE' * (qL F L : Ω F) ^ d_E' *
            (θE' cE' : Ω F) * ψE' (((cE'⁻¹ : E'ˣ) : E'))) *
          ((qL F L : Ω F) ^ condExpChar F L ψ * (qL F L : Ω F) ^ d_T *
            (νE' c_ν : Ω F) * ψ (((c_ν⁻¹ : Lˣ) : L)))
      _ = (qL F E' : Ω F) ^ condExpChar F E' ψE' *
            (qL F L : Ω F) ^ condExpChar F L ψ *
            ((qL F L : Ω F) ^ d_E' * (qL F L : Ω F) ^ d_T) *
            (θE' cE' : Ω F) * (νE' c_ν : Ω F) *
            ψE' (((cE'⁻¹ : E'ˣ) : E')) * ψ (((c_ν⁻¹ : Lˣ) : L)) := by ring
      _ = (qL F E' : Ω F) ^ condExpChar F E' ψE' *
            (qL F L : Ω F) ^ condExpChar F L ψ *
            (qL F L : Ω F) ^ mM₁' *
            (θE' cE' : Ω F) * (νE' c_ν : Ω F) *
            ψE' (((cE'⁻¹ : E'ˣ) : E')) * ψ (((c_ν⁻¹ : Lˣ) : L)) := by rw [hpow_even]
  · have hmE'_odd : mE' % 2 = 1 := by omega
    have hd_sum_odd : d_E' + d_T + 1 = mM₁' := by omega
    have hpow_odd :
        (qL F L : Ω F) ^ d_E' * (qL F L : Ω F) ^ d_T * (qL F L : Ω F) =
          (qL F L : Ω F) ^ mM₁' := by
      rw [← pow_add, ← pow_succ, hd_sum_odd]
    have hnorm_ϖ_pow : normLM F hLE' ((ϖ_E' ^ d_T : E'ˣ) : E') = (δ_T : L) := by
      have h1 : Units.map (normLM F hLE') (ϖ_E' ^ d_T) = δ_T := by
        rw [map_pow, hϖ_norm]
      exact congrArg Units.val h1
    have hx_δE' : x * (δ_E' : E') = ((ϖ_E' ^ d_T : E'ˣ) : E') := by
      have hx_inv : x * (((x_u⁻¹ : E'ˣ) : E')) = 1 := Units.mul_inv x_u
      dsimp only [δ_E']
      rw [Units.val_mul, ← mul_assoc, hx_inv, one_mul]
    have hι_injOn : Set.InjOn ι_E R_L := fun _ _ _ _ h => ι_E.injective h
    have hSE'_eq :
        (∑ r_E ∈ R_E',
          if hr : 1 + (δ_E' : E') * r_E ≠ 0 then
            (θE' (Units.mk0 (1 + (δ_E' : E') * r_E) hr) : Ω F)⁻¹ *
              ψE' (((cE'⁻¹ : E'ˣ) : E') * (δ_E' : E') * r_E)
          else 0) =
        ∑ r ∈ R_L,
          if hr_2 : 1 + (δ_T : L) * r ^ 2 ≠ 0 then
            (νE' (Units.mk0 (1 + (δ_T : L) * r ^ 2) hr_2) : Ω F) *
              (ψ (((c_ν⁻¹ : Lˣ) : L) * (δ_T : L) * r ^ 2))⁻¹
          else 0 := by
      dsimp only [R_E']
      rw [Finset.sum_image hι_injOn]
      refine Finset.sum_congr rfl (fun r hr => ?_)
      set v : E' := (δ_E' : E') * ι_E r
      set w : L := (δ_T : L) * r ^ 2
      have hr_int : r = 0 ∨ 0 ≤ valL F L r := hRL_int r hr
      have hv_dom : v = 0 ∨ (d_E' : ℤ) ≤ valL F E' v := by
        rcases eq_or_ne r 0 with rfl | hr0
        · left
          dsimp only [v]
          rw [map_zero, mul_zero]
        · right
          have hr_ge0 : 0 ≤ valL F L r := hr_int.resolve_left hr0
          have hιr_ne0 : ι_E r ≠ 0 := (map_ne_zero_iff ι_E ι_E.injective).mpr hr0
          dsimp only [v]
          rw [hvalE'_mul (δ_E' : E') (ι_E r) (Units.ne_zero δ_E') hιr_ne0,
            hδ_E'_val, hval_LE' r]
          omega
      have hv_P1 : v = 0 ∨ (1 : ℤ) ≤ valL F E' v := by
        rcases hv_dom with h0 | hge
        · exact Or.inl h0
        · exact Or.inr (by omega)
      have hv_ne : 1 + v ≠ 0 := h1_add_ne_E' hv_P1
      have hw_P1 : w = 0 ∨ (1 : ℤ) ≤ valL F L w := by
        rcases eq_or_ne r 0 with rfl | hr0
        · left
          dsimp only [w]
          rw [sq, zero_mul, mul_zero]
        · right
          have hr_ge0 : 0 ≤ valL F L r := hr_int.resolve_left hr0
          have hr2_ne0 : r ^ 2 ≠ 0 := by
            rw [sq]
            exact mul_ne_zero hr0 hr0
          have hr2_val : valL F L (r ^ 2) = valL F L r + valL F L r := by
            rw [sq]
            exact hvalL_mul r r hr0 hr0
          dsimp only [w]
          rw [hvalL_mul (δ_T : L) (r ^ 2) (Units.ne_zero δ_T) hr2_ne0, hδ_T_val, hr2_val]
          omega
      have hr_2 : 1 + w ≠ 0 := h1_add_ne_L hw_P1
      have hxv_eq : x * v = ((ϖ_E' ^ d_T : E'ˣ) : E') * ι_E r := by
        dsimp only [v]
        rw [← mul_assoc, hx_δE']
      have hnorm_xv : normLM F hLE' (x * v) = w := by
        rw [hxv_eq, map_mul, hnorm_ϖ_pow, hnorm_incl r]
      have hw_ne : 1 + normLM F hLE' (x * v) ≠ 0 := by
        rw [hnorm_xv]
        exact hr_2
      have hrec := hCritE'_rec hT_odd v hv_dom hv_ne hw_ne
      have hmk_eq : Units.mk0 (1 + normLM F hLE' (x * v)) hw_ne = Units.mk0 (1 + w) hr_2 := by
        apply Units.ext
        exact congrArg (1 + ·) hnorm_xv
      have hψ_arg : ((c_ν⁻¹ : Lˣ) : L) * normLM F hLE' (x * v) =
          ((c_ν⁻¹ : Lˣ) : L) * (δ_T : L) * r ^ 2 := by
        rw [hnorm_xv]
        dsimp only [w]
        ring
      have hψE'_arg : ((cE'⁻¹ : E'ˣ) : E') * (δ_E' : E') * ι_E r =
          ((cE'⁻¹ : E'ˣ) : E') * v := by
        dsimp only [v]
        ring
      rw [dif_pos hv_ne, dif_pos hr_2, hψE'_arg, hrec, hmk_eq, hψ_arg, mul_inv, inv_inv]
    have hNuProd := hNuPolarInv hT_odd
    rw [hEpsE'_odd hmE'_odd, hEpsL_odd hT_odd, hRE'_card, hRL_card, hSE'_eq]
    calc ((qL F E' : Ω F) ^ condExpChar F E' ψE' * (qL F L : Ω F) ^ d_E' *
            (θE' cE' : Ω F) * ψE' (((cE'⁻¹ : E'ˣ) : E')) *
            (∑ r ∈ R_L,
              if hr_2 : 1 + (δ_T : L) * r ^ 2 ≠ 0 then
                (νE' (Units.mk0 (1 + (δ_T : L) * r ^ 2) hr_2) : Ω F) *
                  (ψ (((c_ν⁻¹ : Lˣ) : L) * (δ_T : L) * r ^ 2))⁻¹
              else 0)) *
          ((qL F L : Ω F) ^ condExpChar F L ψ * (qL F L : Ω F) ^ d_T *
            (νE' c_ν : Ω F) * ψ (((c_ν⁻¹ : Lˣ) : L)) *
            (∑ r ∈ R_L,
              if hr_L : 1 + (δ_T : L) * r ≠ 0 then
                (νE' (Units.mk0 (1 + (δ_T : L) * r) hr_L) : Ω F)⁻¹ *
                  ψ (((c_ν⁻¹ : Lˣ) : L) * (δ_T : L) * r)
              else 0))
      _ = (qL F E' : Ω F) ^ condExpChar F E' ψE' *
            (qL F L : Ω F) ^ condExpChar F L ψ *
            ((qL F L : Ω F) ^ d_E' * (qL F L : Ω F) ^ d_T *
              ((∑ r ∈ R_L,
                  if hr_2 : 1 + (δ_T : L) * r ^ 2 ≠ 0 then
                    (νE' (Units.mk0 (1 + (δ_T : L) * r ^ 2) hr_2) : Ω F) *
                      (ψ (((c_ν⁻¹ : Lˣ) : L) * (δ_T : L) * r ^ 2))⁻¹
                  else 0) *
                (∑ r ∈ R_L,
                  if hr_L : 1 + (δ_T : L) * r ≠ 0 then
                    (νE' (Units.mk0 (1 + (δ_T : L) * r) hr_L) : Ω F)⁻¹ *
                      ψ (((c_ν⁻¹ : Lˣ) : L) * (δ_T : L) * r)
                  else 0))) *
            (θE' cE' : Ω F) * (νE' c_ν : Ω F) *
            ψE' (((cE'⁻¹ : E'ˣ) : E')) * ψ (((c_ν⁻¹ : Lˣ) : L)) := by ring
      _ = (qL F E' : Ω F) ^ condExpChar F E' ψE' *
            (qL F L : Ω F) ^ condExpChar F L ψ *
            (qL F L : Ω F) ^ mM₁' *
            (θE' cE' : Ω F) * (νE' c_ν : Ω F) *
            ψE' (((cE'⁻¹ : E'ˣ) : E')) * ψ (((c_ν⁻¹ : Lˣ) : L)) := by
          rw [hNuProd, hpow_odd]

theorem ld_ch12_wild_dyadic_unramified_positive_shift_branch (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp2 : p F = 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hνE'_pow : νE' ^ (Module.finrank L (IntermediateField.extendScalars hLE')) = 1)
    (hνE'_ne : νE' ≠ 1)
    (hνE'_ker : ∀ x : Lˣ, x ∈ Set.range (Units.map (normLM F hLE')) ↔ νE' x = 1)
    (hνE'_cond : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      ∀ u ∈ unitGroup F L (condExp F L (νE' ^ j)), (νE' ^ j) u = 1)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (θE' : E'ˣ →* (Ω F)ˣ) (θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hmE'_ge2 : 2 ≤ condExp F E' θE')
    (hmM₁'_ge2 : 2 ≤ condExp F M₁' θM₁')
    (hPosShift : condExp F L νE' < condExp F M₁' θM₁')
    (hmE'_eq : condExp F E' θE' = condExp F L νE' + 2 * (condExp F M₁' θM₁' - condExp F L νE'))
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) = condExpChar F L ψ)
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      2 * condExpChar F L ψ + (condExp F L νE' : ℤ))
    (hqM₁' : qL F M₁' = (qL F L) ^ 2)
    (hqE' : qL F E' = qL F L)
    (heps_M₁'_1 : tateEps F M₁' 1 (traceChar F hLM₁' ψ) =
      (qL F M₁' : Ω F) ^ (condExpChar F M₁' (traceChar F hLM₁' ψ)))
    (heps_E'_1 : tateEps F E' 1 (traceChar F hLE' ψ) =
      (qL F E' : Ω F) ^ (condExpChar F E' (traceChar F hLE' ψ)))
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (hval_norm_LE' : ∀ y : E', valL F L (normLM F hLE' y) = valL F E' y)
    (htr_bound_LM₁' : ∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (d : M₁') (σ_U : M₁' ≃ₐ[F] M₁')
    (hd_val : valL F M₁' d = 0) (hd_tr : traceLM F hLM₁' d = 1)
    (hσ_U_L : ∀ x : L,
      σ_U (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x)
    (hσ_U_val : ∀ z : M₁', valL F M₁' (σ_U z) = valL F M₁' z)
    (hσ_U_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) = z + σ_U z)
    (c_ν : Lˣ) (x : E') (cM₁' : M₁'ˣ) (cE' : E'ˣ)
    (hc_ν_val : valL F L (c_ν : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_ν_stat : ∀ u : L, (u = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((c_ν⁻¹ : Lˣ) : L) * u))
    (heps_νM₁' : tateEps F L νM₁' ψ =
      (qL F L : Ω F) ^ (condExpChar F L ψ) * (-1 : Ω F) ^ (condExp F L νE') * (νM₁' c_ν : Ω F))
    (hcM₁'_val : valL F M₁' (cM₁' : M₁') =
      (condExp F M₁' θM₁' : ℤ) + condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hcM₁'_stat : ∀ z : M₁',
      (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁') * z))
    (hcE'_val : valL F E' (cE' : E') =
      (condExp F E' θE' : ℤ) + condExpChar F E' (traceChar F hLE' ψ))
    (hcE'_stat : ∀ y : E',
      (y = 0 ∨ (((condExp F E' θE' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' y) →
      ∀ hy : 1 + y ≠ 0,
        (θE' (Units.mk0 (1 + y) hy) : Ω F) =
          (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E') * y))
    (hPrefactor :
      (θE' cE' : Ω F) * (νE' c_ν : Ω F) *
          (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E')) * ψ (((c_ν⁻¹ : Lˣ) : L)) =
        (-1 : Ω F) ^ (condExp F L νE') * (θM₁' cM₁' : Ω F) * (νM₁' c_ν : Ω F) *
          (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁')))
    (hx_ne : x ≠ 0)
    (hx_val : valL F E' x = -((condExp F M₁' θM₁' - condExp F L νE' : ℕ) : ℤ))
    (hA_val : valL F L (normLM F hLE' x) = -((condExp F M₁' θM₁' - condExp F L νE' : ℕ) : ℤ))
    (hCritM₁'_base : ∀ u : L, (u = 0 ∨ ((condExp F M₁' θM₁' / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + IntermediateField.inclusion hLM₁' u ≠ 0,
        (θM₁' (Units.mk0 (1 + IntermediateField.inclusion hLM₁' u) hu) : Ω F)⁻¹ *
          (traceChar F hLM₁' ψ)
            (((cM₁'⁻¹ : M₁'ˣ) : M₁') * IntermediateField.inclusion hLM₁' u) = 1)
    (hCritM₁'_polar : ∀ (δ_U : Lˣ) (r₁ r₂ : L),
      valL F L (δ_U : L) = ((condExp F M₁' θM₁' / 2 : ℕ) : ℤ) →
      (r₁ = 0 ∨ 0 ≤ valL F L r₁) →
      (r₂ = 0 ∨ 0 ≤ valL F L r₂) →
      (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁') *
        IntermediateField.inclusion hLM₁' (((δ_U : L) ^ 2) * r₁ * r₂) * d) =
        ψ (((c_ν⁻¹ : Lˣ) : L) * normLM F hLE' x * ((δ_U : L) ^ 2) * r₁ * r₂))
    (hCritE'_rec : condExp F L νE' % 2 = 1 →
      ∀ v : E', (v = 0 ∨ ((condExp F E' θE' / 2 : ℕ) : ℤ) ≤ valL F E' v) →
        ∀ (hv : 1 + v ≠ 0) (hw : 1 + normLM F hLE' (x * v) ≠ 0),
          (θE' (Units.mk0 (1 + v) hv) : Ω F)⁻¹ *
            (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E') * v) =
            ((νE' (Units.mk0 (1 + normLM F hLE' (x * v)) hw) : Ω F)⁻¹ *
              ψ (((c_ν⁻¹ : Lˣ) : L) * normLM F hLE' (x * v)))⁻¹) :
    tateEps F E' θE' (traceChar F hLE' ψ) *
      tateEps F M₁' 1 (traceChar F hLM₁' ψ) *
      tateEps F L νE' ψ =
    tateEps F M₁' θM₁' (traceChar F hLM₁' ψ) *
      tateEps F E' 1 (traceChar F hLE' ψ) *
      tateEps F L νM₁' ψ :=
by
  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalE'_props := ld_valL_and_unitGroup_props F E'
  have hvalM₁'_props := ld_valL_and_unitGroup_props F M₁'
  have hSpecL := ld_condExp_and_condExpChar_spec F L ψ hψ
  have hSpecM₁' := ld_condExp_and_condExpChar_spec F M₁' (traceChar F hLM₁' ψ) hψM₁'
  have hStat := ld_tame_stationary_phase_and_stable_twist F
  obtain ⟨k_L, hField_kL, hFin_kL, resL, R_L, ϖ_E', ϖ_L,
    hkL_card, hchar2, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj,
    hRL_card, hRL_int, hRL_sep, hRL_surj,
    hRE'_card, hRE'_int, hRE'_sep, hRE'_surj,
    hRM₁'_inj, hRM₁'_card, hRM₁'_int, hRM₁'_sep, hRM₁'_surj,
    hϖ_norm, hϖ_E', hϖ_L, hnorm_incl⟩ :=
    ld_ch12_wild_dyadic_pos_shift_res_finset_and_uniformizers F L E' M₁'
      hLE' hLM₁' hPrime hWild hp2 νE' hνE'_pow hνE'_ne hνE'_ker hνE'_cond hbE'_ge2
      hval_LM₁' hval_LE' htr_bound_LM₁' d σ_U hd_val hd_tr hσ_U_L hσ_U_val hσ_U_tr
  letI : Field k_L := hField_kL
  letI : Fintype k_L := hFin_kL
  have hM₁'_eval :=
    ld_ch12_wild_dyadic_pos_shift_M1_eps_eval F L E' M₁' hLE' hLM₁' ψ hψM₁'
      νE' θM₁' hmM₁'_ge2 hPosShift hval_LM₁' d hd_val c_ν x cM₁'
      hc_ν_val hcM₁'_val hcM₁'_stat hA_val hCritM₁'_base hCritM₁'_polar
      hvalL_props hvalM₁'_props hSpecL hSpecM₁'
      k_L resL R_L ϖ_L hkL_card hresL_0 hresL_ring hresL_ker hresL_surj
      hRL_card hRL_int hRL_sep hϖ_L
      hRM₁'_inj hRM₁'_card hRM₁'_int hRM₁'_sep hRM₁'_surj hStat
  have hNuPolarInv : condExp F L νE' % 2 = 1 →
      (∑ r ∈ R_L,
        if hr_2 : 1 + ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r ^ 2 ≠ 0 then
          (νE' (Units.mk0 (1 + ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r ^ 2) hr_2) : Ω F) *
            (ψ (((c_ν⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r ^ 2))⁻¹
        else 0) *
      (∑ r ∈ R_L,
        if hr_L : 1 + ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r ≠ 0 then
          (νE' (Units.mk0 (1 + ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r) hr_L) : Ω F)⁻¹ *
            ψ (((c_ν⁻¹ : Lˣ) : L) * ((ϖ_L ^ (condExp F L νE' / 2) : Lˣ) : L) * r)
        else 0) =
      (qL F L : Ω F) := by
    intro hT_odd
    have h1 :=
      ld_wild_mid_cond_dyadic_nu_polar_and_hasse_inv F L ψ νE' hbE'_ge2 hT_odd
        hvalL_props hSpecL ϖ_L hϖ_L k_L resL hresL_0 hresL_1 hresL_ring hresL_ker
        hresL_surj hchar2 R_L c_ν hRL_card hRL_int hRL_sep hc_ν_val hc_ν_stat
        (fun ψ₀ hψ₀ => (ld_wild_finite_field_hasse_power_identities F k_L ψ₀ hψ₀).1)
    rwa [hkL_card] at h1
  have hE'_ν_eval :=
    ld_ch12_wild_dyadic_pos_shift_E_and_nu_prod_eval F L E' M₁' hLE' ψ hψ hψE'
      νE' hbE'_ge2 θE' θM₁' hmE'_ge2 hPosShift hmE'_eq hval_LE' hval_norm_LE'
      c_ν x cE' hc_ν_val hc_ν_stat hcE'_val hcE'_stat hx_ne hx_val hCritE'_rec
      hvalL_props hvalE'_props R_L ϖ_E' ϖ_L
      (hRL_card.trans hkL_card) hRL_int hRL_sep hRL_surj
      hRE'_card hRE'_int hRE'_sep hRE'_surj hϖ_norm hϖ_E' hϖ_L hnorm_incl
      hStat hNuPolarInv
  calc tateEps F E' θE' (traceChar F hLE' ψ) *
        tateEps F M₁' 1 (traceChar F hLM₁' ψ) *
        tateEps F L νE' ψ
      = (tateEps F E' θE' (traceChar F hLE' ψ) * tateEps F L νE' ψ) *
          tateEps F M₁' 1 (traceChar F hLM₁' ψ) := by ring
    _ = ((qL F E' : Ω F) ^ (condExpChar F E' (traceChar F hLE' ψ)) *
          (qL F L : Ω F) ^ (condExpChar F L ψ) *
          (qL F L : Ω F) ^ (condExp F M₁' θM₁') *
          ((θE' cE' : Ω F) * (νE' c_ν : Ω F) *
            (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E')) *
            ψ (((c_ν⁻¹ : Lˣ) : L)))) *
          ((qL F M₁' : Ω F) ^ (condExpChar F M₁' (traceChar F hLM₁' ψ))) := by
        rw [hE'_ν_eval, heps_M₁'_1]
        ring
    _ = ((qL F E' : Ω F) ^ (condExpChar F E' (traceChar F hLE' ψ)) *
          (qL F L : Ω F) ^ (condExpChar F L ψ) *
          (qL F L : Ω F) ^ (condExp F M₁' θM₁') *
          ((-1 : Ω F) ^ (condExp F L νE') * (θM₁' cM₁' : Ω F) * (νM₁' c_ν : Ω F) *
            (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁')))) *
          ((qL F M₁' : Ω F) ^ (condExpChar F M₁' (traceChar F hLM₁' ψ))) := by
        rw [hPrefactor]
    _ = ((qL F M₁' : Ω F) ^ (condExpChar F M₁' (traceChar F hLM₁' ψ)) *
          (qL F L : Ω F) ^ (condExp F M₁' θM₁') *
          (θM₁' cM₁' : Ω F) *
          (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁'))) *
        ((qL F E' : Ω F) ^ (condExpChar F E' (traceChar F hLE' ψ))) *
        ((qL F L : Ω F) ^ (condExpChar F L ψ) *
          (-1 : Ω F) ^ (condExp F L νE') * (νM₁' c_ν : Ω F)) := by ring
    _ = tateEps F M₁' θM₁' (traceChar F hLM₁' ψ) *
          tateEps F E' 1 (traceChar F hLE' ψ) *
          tateEps F L νM₁' ψ := by
        rw [← hM₁'_eval, ← heps_E'_1, ← heps_νM₁']

theorem ld_ch12_wild_dyadic_unramified_min_cond_res_setup_and_even_reduction (F : Type u)
    [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E'] [FiniteDimensional F M₁']
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁')
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (θE' : E'ˣ →* (Ω F)ˣ) (θM₁' : M₁'ˣ →* (Ω F)ˣ)
    (hmE'_ge2 : 2 ≤ condExp F E' θE')
    (hmM₁'_ge2 : 2 ≤ condExp F M₁' θM₁')
    (hMinEq : condExp F M₁' θM₁' = condExp F L νE')
    (hmE'_eq : condExp F E' θE' = condExp F L νE' + 2 * (condExp F M₁' θM₁' - condExp F L νE'))
    (heps_M₁'_1 : tateEps F M₁' 1 (traceChar F hLM₁' ψ) =
      (qL F M₁' : Ω F) ^ (condExpChar F M₁' (traceChar F hLM₁' ψ)))
    (heps_E'_1 : tateEps F E' 1 (traceChar F hLE' ψ) =
      (qL F E' : Ω F) ^ (condExpChar F E' (traceChar F hLE' ψ)))
    (hval_LM₁' : ∀ x : L, valL F M₁' (IntermediateField.inclusion hLM₁' x) = valL F L x)
    (hval_LE' : ∀ x : L, valL F E' (IntermediateField.inclusion hLE' x) = 2 * valL F L x)
    (htr_bound_LM₁' : ∀ (m : ℤ) (z : M₁'), (z = 0 ∨ m ≤ valL F M₁' z) →
      (traceLM F hLM₁' z = 0 ∨ m ≤ valL F L (traceLM F hLM₁' z)))
    (htr_bound_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨ 2 * m - (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (d : M₁') (σ_U : M₁' ≃ₐ[F] M₁')
    (hd_val : valL F M₁' d = 0) (hd_tr : traceLM F hLM₁' d = 1)
    (hσ_U_val : ∀ z : M₁', valL F M₁' (σ_U z) = valL F M₁' z)
    (hσ_U_tr : ∀ z : M₁', IntermediateField.inclusion hLM₁' (traceLM F hLM₁' z) = z + σ_U z)
    (c_ν : Lˣ) (x : E') (cM₁' : M₁'ˣ) (cE' : E'ˣ)
    (hx_int : x = 0 ∨ 0 ≤ valL F E' x)
    (hc_ν_val : valL F L (c_ν : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_ν_stat : ∀ u : L, (u = 0 ∨ (((condExp F L νE' + 1) / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) = ψ (((c_ν⁻¹ : Lˣ) : L) * u))
    (heps_νM₁' : tateEps F L νM₁' ψ =
      (qL F L : Ω F) ^ (condExpChar F L ψ) * (-1 : Ω F) ^ (condExp F L νE') * (νM₁' c_ν : Ω F))
    (hcM₁'_val : valL F M₁' (cM₁' : M₁') =
      (condExp F M₁' θM₁' : ℤ) + condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hcM₁'_stat : ∀ z : M₁',
      (z = 0 ∨ (((condExp F M₁' θM₁' + 1) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (θM₁' (Units.mk0 (1 + z) hz) : Ω F) =
          (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁') * z))
    (hcE'_val : valL F E' (cE' : E') =
      (condExp F E' θE' : ℤ) + condExpChar F E' (traceChar F hLE' ψ))
    (hcE'_stat : ∀ y : E',
      (y = 0 ∨ (((condExp F E' θE' + 1) / 2 : ℕ) : ℤ) ≤ valL F E' y) →
      ∀ hy : 1 + y ≠ 0,
        (θE' (Units.mk0 (1 + y) hy) : Ω F) =
          (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E') * y))
    (hPrefactor :
      (θE' cE' : Ω F) * (νE' c_ν : Ω F) *
          (traceChar F hLE' ψ) (((cE'⁻¹ : E'ˣ) : E')) * ψ (((c_ν⁻¹ : Lˣ) : L)) =
        (-1 : Ω F) ^ (condExp F L νE') * (θM₁' cM₁' : Ω F) * (νM₁' c_ν : Ω F) *
          (traceChar F hLM₁' ψ) (((cM₁'⁻¹ : M₁'ˣ) : M₁')))
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hvalM₁'_props : valL F M₁' 0 = 0 ∧ valL F M₁' 1 = 0 ∧ valL F M₁' (-1) = 0 ∧
      (∀ x : M₁', valL F M₁' (-x) = valL F M₁' x) ∧
      (∀ x y : M₁', x ≠ 0 → y ≠ 0 → valL F M₁' (x * y) = valL F M₁' x + valL F M₁' y) ∧
      (∀ u : M₁'ˣ, valL F M₁' ((u⁻¹ : M₁'ˣ) : M₁') = - valL F M₁' (u : M₁')) ∧
      (∀ m : ℤ, ∃ c : M₁'ˣ, valL F M₁' (c : M₁') = m) ∧
      (∀ (k : ℤ) (x y : M₁'),
        (x = 0 ∨ k ≤ valL F M₁' x) → (y = 0 ∨ k ≤ valL F M₁' y) →
          (x + y = 0 ∨ k ≤ valL F M₁' (x + y))) ∧
      (∀ u : M₁'ˣ, u ∈ unitGroup F M₁' 0 ↔ valL F M₁' (u : M₁') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : M₁'ˣ,
        u ∈ unitGroup F M₁' a ↔ ((u : M₁') = 1 ∨ (a : ℤ) ≤ valL F M₁' ((u : M₁') - 1))) ∧
      (∀ (a : ℕ) (u : M₁'ˣ), u ∈ unitGroup F M₁' a → valL F M₁' (u : M₁') = 0))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (ϖ_E' : E'ˣ) (ϖ_L : Lˣ)
    (hϖ_norm : Units.map (normLM F hLE') ϖ_E' = ϖ_L)
    (hϖ_E' : valL F E' (ϖ_E' : E') = 1)
    (hϖ_L : valL F L (ϖ_L : L) = 1)
    (hBasis : ∀ y : E', ∃ c : Fin (Module.finrank L (IntermediateField.extendScalars hLE')) → L,
      y = ∑ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
        IntermediateField.inclusion hLE' (c i) * ((ϖ_E' : E') ^ (i : ℕ)) ∧
      ∀ (m : ℤ),
        (y = 0 ∨ m ≤ valL F E' y) ↔
          ∀ i : Fin (Module.finrank L (IntermediateField.extendScalars hLE')),
            c i = 0 ∨
              m ≤ (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) *
                valL F L (c i) + (i : ℤ))
    (hStat : ∀ (E : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F E]
      (ψ_E : AddChar E (Ω F)), IsAdmissibleChar F E ψ_E →
      ∀ (θ : Eˣ →* (Ω F)ˣ), 2 ≤ condExp F E θ →
      let m := condExp F E θ
      let d := m / 2
      let r₀ := (m + 1) / 2
      (∃ c_θ : Eˣ,
        valL F E (c_θ : E) = (m : ℤ) + condExpChar F E ψ_E ∧
        ∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c_θ⁻¹ : Eˣ) : E) * x)) ∧
      (∀ (c : Eˣ),
        valL F E (c : E) = (m : ℤ) + condExpChar F E ψ_E →
        (∀ x : E, (x = 0 ∨ (r₀ : ℤ) ≤ valL F E x) →
          ∀ hx : 1 + x ≠ 0,
            (θ (Units.mk0 (1 + x) hx) : Ω F) = ψ_E (((c⁻¹ : Eˣ) : E) * x)) →
        (∀ (ν : Eˣ →* (Ω F)ˣ),
          (∀ u ∈ unitGroup F E d, ν u = 1) →
          condExp F E (ν * θ) = m ∧
          tateEps F E (ν * θ) ψ_E = (ν c : Ω F) * tateEps F E θ ψ_E) ∧
        (∀ (R_E : Finset E) (δ : Eˣ),
          (∀ r ∈ R_E, r = 0 ∨ 0 ≤ valL F E r) →
          (∀ r₁ ∈ R_E, ∀ r₂ ∈ R_E, r₁ ≠ r₂ → valL F E (r₁ - r₂) = 0) →
          (∀ x : E, (x = 0 ∨ 0 ≤ valL F E x) →
            ∃ r ∈ R_E, x - r = 0 ∨ 1 ≤ valL F E (x - r)) →
          valL F E (δ : E) = (d : ℤ) →
          (m % 2 = 0 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E))) ∧
          (m % 2 = 1 →
            tateEps F E θ ψ_E =
              (qL F E : Ω F) ^ condExpChar F E ψ_E *
                (R_E.card : Ω F) ^ d *
                (θ c : Ω F) *
                ψ_E (((c⁻¹ : Eˣ) : E)) *
                ∑ r ∈ R_E,
                  if hr : 1 + (δ : E) * r ≠ 0 then
                    (θ (Units.mk0 (1 + (δ : E) * r) hr) : Ω F)⁻¹ *
                      ψ_E (((c⁻¹ : Eˣ) : E) * (δ : E) * r)
                  else 0)))) :
    let T := condExp F L νE'
    let d_T := T / 2
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    (2 : k_L) = 0 ∧
    ((2 : L) = 0 ∨ (d_T : ℤ) ≤ valL F L (2 : L)) ∧
    ∃ (x_0 : L) (δ_T : Lˣ) (δ_E : E'ˣ) (δ_U : M₁'ˣ) (liftL : k_L → L),
      (x_0 = 0 ∨ 0 ≤ valL F L x_0) ∧
      (x - IntermediateField.inclusion hLE' x_0 = 0 ∨
        1 ≤ valL F E' (x - IntermediateField.inclusion hLE' x_0)) ∧
      valL F L (δ_T : L) = (d_T : ℤ) ∧
      valL F E' (δ_E : E') = (d_T : ℤ) ∧
      valL F M₁' (δ_U : M₁') = (d_T : ℤ) ∧
      Units.map (normLM F hLE') δ_E = δ_T ∧
      δ_U = Units.map (IntermediateField.inclusion hLM₁').toMonoidHom δ_T ∧
      (∀ a : k_L, (liftL a = 0 ∨ 0 ≤ valL F L (liftL a)) ∧ resL (liftL a) = a) ∧
      ((T % 2 = 1 →
        (∑ p : k_L × k_L,
          let w := IntermediateField.inclusion hLM₁' (liftL p.1) +
            IntermediateField.inclusion hLM₁' (liftL p.2) * d
          if hw : 1 + (δ_U : M₁') * w ≠ 0 then
            (θM₁' (Units.mk0 (1 + (δ_U : M₁') * w) hw) : Ω F)⁻¹ *
              ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (δ_U : M₁') * w)
          else 0) =
        (∑ a : k_L,
          let r := IntermediateField.inclusion hLE' (liftL a)
          if hr : 1 + (δ_E : E') * r ≠ 0 then
            (θE' (Units.mk0 (1 + (δ_E : E') * r) hr) : Ω F)⁻¹ *
              ψE' (((cE'⁻¹ : E'ˣ) : E') * (δ_E : E') * r)
          else 0) *
        (∑ a : k_L,
          let r := liftL a
          if hr : 1 + (δ_T : L) * r ≠ 0 then
            (νE' (Units.mk0 (1 + (δ_T : L) * r) hr) : Ω F)⁻¹ *
              ψ (((c_ν⁻¹ : Lˣ) : L) * (δ_T : L) * r)
          else 0)) →
      tateEps F E' θE' ψE' * tateEps F M₁' 1 ψM₁' * tateEps F L νE' ψ =
        tateEps F M₁' θM₁' ψM₁' * tateEps F E' 1 ψE' * tateEps F L νM₁' ψ) :=
by
  intro T d_T ψE' ψM₁'
  rcases hvalL_props with
    ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L,
      _, hval_add_L, _, _, _⟩
  rcases hvalE'_props with
    ⟨hval0_E', hval1_E', hval_neg1_E', hval_neg_E', hval_mul_E', hval_inv_E',
      _, hval_add_E', _, _, _⟩
  rcases hvalM₁'_props with
    ⟨hval0_M₁', hval1_M₁', hval_neg1_M₁', hval_neg_M₁', hval_mul_M₁', hval_inv_M₁',
      _, hval_add_M₁', _, _, _⟩
  have hd_T_ge1 : 1 ≤ d_T := by omega
  have hmM₁'_T : condExp F M₁' θM₁' = T := hMinEq
  have hmE'_T : condExp F E' θE' = T := by omega
  have hval_sub_ge_L : ∀ (k : ℤ) (a b : L),
      (a = 0 ∨ k ≤ valL F L a) → (b = 0 ∨ k ≤ valL F L b) →
        (a - b = 0 ∨ k ≤ valL F L (a - b)) := by
    intro k a b ha hb
    rw [sub_eq_add_neg]
    have hnb : -b = 0 ∨ k ≤ valL F L (-b) := by
      rcases hb with h0 | hge
      · exact Or.inl (neg_eq_zero.mpr h0)
      · right; rw [hval_neg_L]; exact hge
    exact hval_add_L k a (-b) ha hnb
  have hval_sub_ge_E' : ∀ (k : ℤ) (a b : E'),
      (a = 0 ∨ k ≤ valL F E' a) → (b = 0 ∨ k ≤ valL F E' b) →
        (a - b = 0 ∨ k ≤ valL F E' (a - b)) := by
    intro k a b ha hb
    rw [sub_eq_add_neg]
    have hnb : -b = 0 ∨ k ≤ valL F E' (-b) := by
      rcases hb with h0 | hge
      · exact Or.inl (neg_eq_zero.mpr h0)
      · right; rw [hval_neg_E']; exact hge
    exact hval_add_E' k a (-b) ha hnb
  have hval_sub_ge_M₁' : ∀ (k : ℤ) (a b : M₁'),
      (a = 0 ∨ k ≤ valL F M₁' a) → (b = 0 ∨ k ≤ valL F M₁' b) →
        (a - b = 0 ∨ k ≤ valL F M₁' (a - b)) := by
    intro k a b ha hb
    rw [sub_eq_add_neg]
    have hnb : -b = 0 ∨ k ≤ valL F M₁' (-b) := by
      rcases hb with h0 | hge
      · exact Or.inl (neg_eq_zero.mpr h0)
      · right; rw [hval_neg_M₁']; exact hge
    exact hval_add_M₁' k a (-b) ha hnb
  have hval_mul_ge_L : ∀ (k₁ k₂ : ℤ) (a b : L),
      (a = 0 ∨ k₁ ≤ valL F L a) → (b = 0 ∨ k₂ ≤ valL F L b) →
        (a * b = 0 ∨ k₁ + k₂ ≤ valL F L (a * b)) := by
    intro k₁ k₂ a b ha hb
    by_cases ha0 : a = 0
    · exact Or.inl (by rw [ha0, zero_mul])
    · by_cases hb0 : b = 0
      · exact Or.inl (by rw [hb0, mul_zero])
      · right
        rw [hval_mul_L a b ha0 hb0]
        have h1 := ha.resolve_left ha0
        have h2 := hb.resolve_left hb0
        omega
  have hval_mul_ge_M₁' : ∀ (k₁ k₂ : ℤ) (a b : M₁'),
      (a = 0 ∨ k₁ ≤ valL F M₁' a) → (b = 0 ∨ k₂ ≤ valL F M₁' b) →
        (a * b = 0 ∨ k₁ + k₂ ≤ valL F M₁' (a * b)) := by
    intro k₁ k₂ a b ha hb
    by_cases ha0 : a = 0
    · exact Or.inl (by rw [ha0, zero_mul])
    · by_cases hb0 : b = 0
      · exact Or.inl (by rw [hb0, mul_zero])
      · right
        rw [hval_mul_M₁' a b ha0 hb0]
        have h1 := ha.resolve_left ha0
        have h2 := hb.resolve_left hb0
        omega
  have hval_le_L : ∀ {k₁ k₂ : ℤ} {a : L},
      k₁ ≤ k₂ → (a = 0 ∨ k₂ ≤ valL F L a) → (a = 0 ∨ k₁ ≤ valL F L a) := by
    intro k₁ k₂ a hle ha
    rcases ha with h0 | hge
    · exact Or.inl h0
    · exact Or.inr (le_trans hle hge)
  have hresL_sub : ∀ x₁ x₂ : L,
      (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
        resL (x₁ - x₂) = resL x₁ - resL x₂ := by
    intro x₁ x₂ hx₁ hx₂
    have hneg2 : -x₂ = 0 ∨ 0 ≤ valL F L (-x₂) := by
      rcases hx₂ with rfl | hge
      · exact Or.inl neg_zero
      · exact Or.inr (by rw [hval_neg_L]; exact hge)
    have hadd := (hresL_ring x₁ (-x₂) hx₁ hneg2).1
    have hneg := (hresL_ring x₂ x₂ hx₂ hx₂).2.2
    rw [sub_eq_add_neg, hadd, hneg, ← sub_eq_add_neg]
  have htr1_E' : traceLM F hLE' (1 : E') = (2 : L) := by
    have h1 := (hQuadNorm L E' hLE' hdeg2).1 (1 : L)
    rw [map_one, mul_one] at h1
    exact h1
  have h2_val : (2 : L) = 0 ∨ (d_T : ℤ) ≤ valL F L (2 : L) := by
    have hineq : 2 * (d_T : ℤ) - (T : ℤ) ≤ valL F E' (1 : E') := by
      rw [hval1_E']
      omega
    have htr := htr_bound_LE' (d_T : ℤ) (1 : E') (Or.inr hineq)
    rwa [htr1_E'] at htr
  have h2_ge1 : (2 : L) = 0 ∨ 1 ≤ valL F L (2 : L) := hval_le_L (by omega) h2_val
  have h2_int : (2 : L) = 0 ∨ 0 ≤ valL F L (2 : L) := hval_le_L (by omega) h2_val
  have h1_int_L : (1 : L) = 0 ∨ 0 ≤ valL F L (1 : L) := Or.inr (by rw [hval1_L])
  have hchar2 : (2 : k_L) = 0 := by
    have hres0 : resL (2 : L) = 0 := (hresL_ker (2 : L) h2_int).mpr h2_ge1
    have hres2 : resL (2 : L) = (2 : k_L) := by
      rw [← one_add_one_eq_two, (hresL_ring 1 1 h1_int_L h1_int_L).1, hresL_1,
        one_add_one_eq_two]
    exact hres2.symm.trans hres0
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  have hp_pos : 0 < p := by omega
  have hp_cast : (p : ℤ) = 2 := by exact_mod_cast hdeg2
  have hinj_E' : Function.Injective (IntermediateField.inclusion hLE') :=
    (IntermediateField.inclusion hLE').injective
  have hinj_M₁' : Function.Injective (IntermediateField.inclusion hLM₁') :=
    (IntermediateField.inclusion hLM₁').injective
  have hϖ_L_pow_ne_zero : ∀ n : ℕ, ((ϖ_L : L) ^ n) ≠ 0 :=
    fun n => pow_ne_zero n (Units.ne_zero ϖ_L)
  have hϖ_L_pow_val : ∀ n : ℕ, valL F L ((ϖ_L : L) ^ n) = (n : ℤ) := by
    intro n
    induction' n with n ih
    · simp [hval1_L]
    · rw [pow_succ, hval_mul_L _ _ (hϖ_L_pow_ne_zero n) (Units.ne_zero ϖ_L), ih, hϖ_L]
      push_cast; ring
  have hϖ_E'_pow_ne_zero : ∀ n : ℕ, ((ϖ_E' : E') ^ n) ≠ 0 :=
    fun n => pow_ne_zero n (Units.ne_zero ϖ_E')
  have hϖ_E'_pow_val : ∀ n : ℕ, valL F E' ((ϖ_E' : E') ^ n) = (n : ℤ) := by
    intro n
    induction' n with n ih
    · simp [hval1_E']
    · rw [pow_succ, hval_mul_E' _ _ (hϖ_E'_pow_ne_zero n) (Units.ne_zero ϖ_E'), ih, hϖ_E']
      push_cast; ring
  have hval_finset_sum_E' : ∀ {α : Type} (S : Finset α) (f : α → E') (k : ℤ),
