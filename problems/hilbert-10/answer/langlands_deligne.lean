  obtain ⟨hvalM₁'_0, hvalM₁'_1, hvalM₁'_neg1, hvalM₁'_neg, hvalM₁'_mul, hvalM₁'_inv,
    _, hvalM₁'_add, hunitM₁'_0, hunitM₁'_mem, hunitM₁'_val⟩ := hvalM₁'_props
  have hvalL_mul_bound : ∀ (k₁ k₂ : ℤ) (a₁ a₂ : L),
      (a₁ = 0 ∨ k₁ ≤ valL F L a₁) → (a₂ = 0 ∨ k₂ ≤ valL F L a₂) →
