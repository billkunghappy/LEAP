    rw [hval_alg, hvalL_pow d]
  have hπ_d : π_d = 0 ∨ (d : ℤ) ≤ valL F K π_d := Or.inr (le_of_eq hπ_d_val.symm)
  have hπ_d2 : π_d ^ 2 = 0 ∨ (d + d : ℤ) ≤ valL F K (π_d ^ 2) := by
    rw [sq]
    exact hvalK_mul_ge d d π_d π_d hπ_d hπ_d
  have hπ_d3 : π_d ^ 3 = 0 ∨ (d + d + d : ℤ) ≤ valL F K (π_d ^ 3) := by
    have hpow3 : π_d ^ 3 = π_d ^ 2 * π_d := by ring
    rw [hpow3]
    exact hvalK_mul_ge (d + d) d (π_d ^ 2) π_d hπ_d2 hπ_d
  have hquad_S : ∀ S : Finset G,
      ∃ sig2 : K, (sig2 = 0 ∨ 0 ≤ valL F K sig2) ∧
        (S.card ≤ 1 → sig2 = 0) ∧
        (2 ≤ S.card →
          (∏ σ ∈ S, (Polynomial.X - Polynomial.C (resK (z σ)))).coeff (S.card - 2) =
            resK sig2) ∧
        ((∏ σ ∈ S, (1 + π_d * z σ)) - (1 + π_d * (∑ σ ∈ S, z σ) + π_d ^ 2 * sig2) = 0 ∨
          (2 * d + 1 : ℤ) ≤ valL F K
            ((∏ σ ∈ S, (1 + π_d * z σ)) - (1 + π_d * (∑ σ ∈ S, z σ) + π_d ^ 2 * sig2))) := by
    intro S
    induction' S using Finset.induction_on with τ S' hτ ih
    · refine ⟨0, Or.inl rfl, fun _ => rfl, fun h2 => by simp at h2, ?_⟩
      left
      simp
    · rcases ih with ⟨sig2', hsig2'_int, hsig2'_le1, hsig2'_coeff, hsig2'_rem⟩
      set sig1' : K := ∑ σ ∈ S', z σ
      have hsig1'_int : sig1' = 0 ∨ 0 ≤ valL F K sig1' := (hsum_T S').1
      let sig2 : K := z τ * sig1' + sig2'
      have hsig2_int : sig2 = 0 ∨ 0 ≤ valL F K sig2 :=
        hIntK_add _ _ (hIntK_mul _ _ (hz_int τ) hsig1'_int) hsig2'_int
      refine ⟨sig2, hsig2_int, ?_, ?_, ?_⟩
      · intro hcard_le1
        rw [Finset.card_insert_of_notMem hτ] at hcard_le1
        have hS'0 : S'.card = 0 := by omega
        have hS'_empty : S' = ∅ := Finset.card_eq_zero.mp hS'0
        have hsig1'0 : sig1' = 0 := by simp [sig1', hS'_empty]
        have hsig2'0 : sig2' = 0 := hsig2'_le1 (by omega)
        simp [sig2, hsig1'0, hsig2'0]
      · intro hcard_ge2
        rw [Finset.card_insert_of_notMem hτ] at hcard_ge2 ⊢
        have hcases : S'.card = 1 ∨ 2 ≤ S'.card := by omega
        rcases hcases with hS'1 | hS'2
        · have hsub : S'.card + 1 - 2 = 0 := by omega
          rw [hsub, Finset.prod_insert hτ, Polynomial.mul_coeff_zero]
          have h0_eq : (0 : ℕ) = S'.card - 1 := by omega
          have hf_S'0 : (∏ σ ∈ S', (Polynomial.X - Polynomial.C (resK (z σ)))).coeff 0 =
              - resK sig1' := by
            rw [h0_eq]
            exact hf_coeff_sub1 S' (by omega)
          have hX_0 : (Polynomial.X - Polynomial.C (resK (z τ))).coeff 0 = - resK (z τ) := by
            simp
          have hsig2'0 : sig2' = 0 := hsig2'_le1 (by omega)
          have hres_sig2 : resK sig2 = resK (z τ) * resK sig1' := by
            change resK (z τ * sig1' + sig2') = _
            rw [hsig2'0, add_zero, (hresK_ring (z τ) sig1' (hz_int τ) hsig1'_int).2.1]
          rw [hX_0, hf_S'0, hres_sig2]
          ring
        · set a := S'.card - 2
          have hsub : S'.card + 1 - 2 = a + 1 := by omega
          have ha1 : S'.card - 1 = a + 1 := by omega
          rw [hsub, Finset.prod_insert hτ,
            mul_comm (Polynomial.X - Polynomial.C (resK (z τ))),
            Polynomial.coeff_mul_X_sub_C]
          have hf_a : (∏ σ ∈ S', (Polynomial.X - Polynomial.C (resK (z σ)))).coeff a =
              resK sig2' := hsig2'_coeff hS'2
          have hf_a1 : (∏ σ ∈ S', (Polynomial.X - Polynomial.C (resK (z σ)))).coeff (a + 1) =
              - resK sig1' := by
            rw [← ha1]
            exact hf_coeff_sub1 S' (by omega)
          have hres_sig2 : resK sig2 = resK (z τ) * resK sig1' + resK sig2' := by
            change resK (z τ * sig1' + sig2') = _
            rw [(hresK_ring (z τ * sig1') sig2' (hIntK_mul _ _ (hz_int τ) hsig1'_int) hsig2'_int).1,
              (hresK_ring (z τ) sig1' (hz_int τ) hsig1'_int).2.1]
          rw [hf_a, hf_a1, hres_sig2]
          ring
      · set P' : K := ∏ σ ∈ S', (1 + π_d * z σ)
        set R' : K := P' - (1 + π_d * sig1' + π_d ^ 2 * sig2')
        rw [Finset.prod_insert hτ, Finset.sum_insert hτ]
        have hring : (1 + π_d * z τ) * P' - (1 + π_d * (z τ + sig1') + π_d ^ 2 * sig2) =
            R' + (π_d ^ 3 * (z τ * sig2') + π_d * z τ * R') := by
          change (1 + π_d * z τ) * P' -
              (1 + π_d * (z τ + sig1') + π_d ^ 2 * (z τ * sig1' + sig2')) =
            (P' - (1 + π_d * sig1' + π_d ^ 2 * sig2')) +
              (π_d ^ 3 * (z τ * sig2') + π_d * z τ * (P' - (1 + π_d * sig1' + π_d ^ 2 * sig2')))
          ring
        rw [hring]
        have hterm2 : π_d ^ 3 * (z τ * sig2') = 0 ∨
            (2 * d + 1 : ℤ) ≤ valL F K (π_d ^ 3 * (z τ * sig2')) := by
          have h := hvalK_mul_ge (d + d + d) 0 (π_d ^ 3) (z τ * sig2')
            hπ_d3 (hIntK_mul _ _ (hz_int τ) hsig2'_int)
          rcases h with h0 | hge
          · exact Or.inl h0
          · right; omega
        have hterm3 : π_d * z τ * R' = 0 ∨
            (2 * d + 1 : ℤ) ≤ valL F K (π_d * z τ * R') := by
          have hπz : π_d * z τ = 0 ∨ (d + 0 : ℤ) ≤ valL F K (π_d * z τ) :=
            hvalK_mul_ge d 0 π_d (z τ) hπ_d (hz_int τ)
          have h := hvalK_mul_ge (d + 0) (2 * d + 1) (π_d * z τ) R' hπz hsig2'_rem
          rcases h with h0 | hge
          · exact Or.inl h0
          · right; omega
        exact hvalK_add (2 * d + 1) R' _ hsig2'_rem
          (hvalK_add (2 * d + 1) _ _ hterm2 hterm3)
  rcases hquad_S Finset.univ with ⟨sig2, hsig2_int, _, hsig2_coeff, hsig2_rem⟩
  have hsig2_res : algebraMap k_L k_K (F_y.coeff (ℓ - 2)) = resK sig2 := by
    have hcard_univ : (Finset.univ : Finset G).card = ℓ := by
      rw [Finset.card_univ, hcard_G_res]
    have h2 : 2 ≤ (Finset.univ : Finset G).card := by
      rw [hcard_univ]
      exact hPrime_res.two_le
    have hc := hsig2_coeff h2
    rw [hcard_univ, ← hmap_Fz, Polynomial.coeff_map] at hc
    exact hc
  rcases hresL_surj (F_y.coeff (ℓ - 2)) with ⟨s₂, hs₂_int, hs₂_res⟩
  refine ⟨s₂, hs₂_int, hs₂_res, ?_⟩
  set s₂K : K := IntermediateField.inclusion hLK s₂
  have hs₂K_int : s₂K = 0 ∨ 0 ≤ valL F K s₂K := by
    rcases hs₂_int with rfl | hs₂_ge
    · exact Or.inl (map_zero _)
    · exact Or.inr (by rw [hval_alg]; exact hs₂_ge)
  have hdiff_int : sig2 - s₂K = 0 ∨ 0 ≤ valL F K (sig2 - s₂K) := by
    rw [sub_eq_add_neg]
    exact hIntK_add _ _ hsig2_int (hIntK_neg _ hs₂K_int)
  have hdiff_res : resK (sig2 - s₂K) = 0 := by
    rw [sub_eq_add_neg,
      (hresK_ring sig2 (-s₂K) hsig2_int (hIntK_neg _ hs₂K_int)).1,
      (hresK_ring s₂K 0 hs₂K_int hIntK_0).2.2,
      hres_alg s₂ hs₂_int, hs₂_res, hsig2_res, add_neg_cancel]
  have hdiff_val1 : sig2 - s₂K = 0 ∨ 1 ≤ valL F K (sig2 - s₂K) :=
    (hresK_ker (sig2 - s₂K) hdiff_int).mp hdiff_res
  have hshift_val : π_d ^ 2 * (sig2 - s₂K) = 0 ∨
      (2 * d + 1 : ℤ) ≤ valL F K (π_d ^ 2 * (sig2 - s₂K)) := by
    have h := hvalK_mul_ge (d + d) 1 (π_d ^ 2) (sig2 - s₂K) hπ_d2 hdiff_val1
    rcases h with h0 | hge
    · exact Or.inl h0
    · right; omega
  have hcomb := hvalK_add (2 * d + 1)
    ((∏ σ : G, (1 + π_d * z σ)) - (1 + π_d * (∑ σ : G, z σ) + π_d ^ 2 * sig2))
    (π_d ^ 2 * (sig2 - s₂K)) hsig2_rem hshift_val
  have hcomb_ring :
      ((∏ σ : G, (1 + π_d * z σ)) - (1 + π_d * (∑ σ : G, z σ) + π_d ^ 2 * sig2)) +
        π_d ^ 2 * (sig2 - s₂K) =
      (∏ σ : G, (1 + π_d * z σ)) - (1 + π_d * (∑ σ : G, z σ) + π_d ^ 2 * s₂K) := by
    ring
  rw [hcomb_ring] at hcomb
  have hact_lin : ∀ σ : G, act σ (1 + π_d * y) = 1 + π_d * z σ := by
    intro σ
    rw [((hact_ring σ).2.2 1 (π_d * y)).1, (hact_ring σ).2.1,
      ((hact_ring σ).2.2 π_d y).2.1, hact_incl σ π_dL]
  have hϖ_2d : (((ϖ ^ (2 * d) : Lˣ) : L)) = π_dL ^ 2 := by
    change (((ϖ ^ (2 * d) : Lˣ) : L)) = (((ϖ ^ d : Lˣ) : L)) ^ 2
    rw [Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val]
    ring
  have hincl_rem : IntermediateField.inclusion hLK
      (normLM F hLK (1 + π_d * y) -
        (1 + π_dL * traceLM F hLK y + (((ϖ ^ (2 * d) : Lˣ) : L)) * s₂)) =
      (∏ σ : G, (1 + π_d * z σ)) -
        (1 + π_d * (∑ σ : G, z σ) + π_d ^ 2 * s₂K) := by
    rw [hϖ_2d, map_sub, hact_norm (1 + π_d * y), map_add, map_add, map_one,
      map_mul, map_mul, map_pow, hact_trace y]
    simp_rw [hact_lin]
    rfl
  rw [← hincl_rem] at hcomb
  rcases hcomb with h0 | hge
  · left
    exact (map_eq_zero_iff (IntermediateField.inclusion hLK)
      (IntermediateField.inclusion hLK).injective).mp h0
  · right
    rwa [hval_alg] at hge

theorem ld_ch10_unramified_residue_galois_bridge (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L] (hLK : L ≤ K)
    (hGal : IsGaloisExt F L K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F K y)
    (hval_alg : ∀ x : L, valL F K (IntermediateField.inclusion hLK x) = valL F L x) :
    (∀ (m : ℤ) (y : K), (y = 0 ∨ m ≤ valL F K y) →
      (traceLM F hLK y = 0 ∨ m ≤ valL F L (traceLM F hLK y))) ∧
    (∃ y₁ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) ∧ traceLM F hLK y₁ = 1) ∧
    (∀ (d : ℕ), 1 ≤ d → ∀ y : K, (y = 0 ∨ (d : ℤ) ≤ valL F K y) →
      (normLM F hLK (1 + y) - (1 + traceLM F hLK y) = 0 ∨
        (2 * d : ℤ) ≤ valL F L (normLM F hLK (1 + y) - (1 + traceLM F hLK y)))) ∧
    ∃ (k_L k_K : Type u) (_ : Field k_L) (_ : Fintype k_L) (_ : Field k_K) (_ : Fintype k_K)
      (_ : Algebra k_L k_K) (resL : L → k_L) (resK : K → k_K),
      Module.finrank k_L k_K = Module.finrank L (IntermediateField.extendScalars hLK) ∧
      resL 0 = 0 ∧ resL 1 = 1 ∧
      (∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
        resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
        resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
        resL (-x₁) = -resL x₁) ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) → (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x))) ∧
      (∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a) ∧
      resK 0 = 0 ∧ resK 1 = 1 ∧
      (∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
        resK (y₁ + y₂) = resK y₁ + resK y₂ ∧
        resK (y₁ * y₂) = resK y₁ * resK y₂ ∧
        resK (-y₁) = -resK y₁) ∧
      (∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) → (resK y = 0 ↔ (y = 0 ∨ 1 ≤ valL F K y))) ∧
      (∀ b : k_K, ∃ y : K, (y = 0 ∨ 0 ≤ valL F K y) ∧ resK y = b) ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        resK (IntermediateField.inclusion hLK x) = algebraMap k_L k_K (resL x)) ∧
      (∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
        let F_y : Polynomial k_L :=
          (minpoly k_L (resK y)) ^
            (Module.finrank k_L k_K / (minpoly k_L (resK y)).natDegree)
        resL (traceLM F hLK y) = -F_y.nextCoeff ∧
        resL (normLM F hLK y) = (-1 : k_L) ^ (Module.finrank k_L k_K) * F_y.coeff 0 ∧
        ∀ (ϖ : Lˣ) (d : ℕ), valL F L (ϖ : L) = 1 → 1 ≤ d →
          ∃ s₂ : L, (s₂ = 0 ∨ 0 ≤ valL F L s₂) ∧
            resL s₂ = F_y.coeff (Module.finrank k_L k_K - 2) ∧
            (normLM F hLK (1 + IntermediateField.inclusion hLK (((ϖ ^ d : Lˣ) : L)) * y) -
              (1 + (((ϖ ^ d : Lˣ) : L)) * traceLM F hLK y +
                (((ϖ ^ (2 * d) : Lˣ) : L)) * s₂) = 0 ∨
              (2 * d + 1 : ℤ) ≤ valL F L
                (normLM F hLK (1 + IntermediateField.inclusion hLK (((ϖ ^ d : Lˣ) : L)) * y) -
                  (1 + (((ϖ ^ d : Lˣ) : L)) * traceLM F hLK y +
                    (((ϖ ^ (2 * d) : Lˣ) : L)) * s₂)))) :=
by
  haveI : FiniteDimensional F K := hGal.2.1
  obtain ⟨hvalL0, hvalL1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_surj, hvalL_add, _⟩ :=
    ld_valL_and_unitGroup_props F L
  obtain ⟨hvalK0, hvalK1, hvalK_neg1, hvalK_neg, hvalK_mul, hvalK_inv, hvalK_surj, hvalK_add, _⟩ :=
    ld_valL_and_unitGroup_props F K
  obtain ⟨haddVal1, haddVal_neg, haddVal_mul, haddVal_inv, halgL0, halgL1, R_F, hRF_0, hRF_mod1⟩ :=
    ld_addVal_finset_and_algebraMap_valL F L
  obtain ⟨_, _, _, _, halgK0, halgK1, _⟩ :=
    ld_addVal_finset_and_algebraMap_valL F K
  obtain ⟨S₁_L, hS₁_L⟩ := ld_valL_mod_one_finset F L hvalL0 hvalL_neg hvalL_mul hvalL_add
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halgL0 halgL1 R_F hRF_0 hRF_mod1
  obtain ⟨S₁_K, hS₁_K⟩ := ld_valL_mod_one_finset F K hvalK0 hvalK_neg hvalK_mul hvalK_add
    haddVal1 haddVal_neg haddVal_mul haddVal_inv halgK0 halgK1 R_F hRF_0 hRF_mod1
  obtain ⟨k_L, hField_kL, hFin_kL, resL, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj⟩ :=
    ld_valL_residue_field_exists F L hvalL0 hvalL1 hvalL_neg1 hvalL_neg hvalL_mul hvalL_inv
      hvalL_add S₁_L hS₁_L
  obtain ⟨k_K, hField_kK, hFin_kK, resK, hresK_0, hresK_1, hresK_ring, hresK_ker, hresK_surj⟩ :=
    ld_valL_residue_field_exists F K hvalK0 hvalK1 hvalK_neg1 hvalK_neg hvalK_mul hvalK_inv
      hvalK_add S₁_K hS₁_K
  obtain ⟨hFinLK', htr_bound, hnorm_lin1, G, hGroupG, hFinG, act, hcard_G, hact_one, hact_mul,
      hact_ring, hact_incl, hact_faithful, hact_val, hact_trace, hact_norm⟩ :=
    ld_unramified_galois_aut_trace_norm_and_lin F L K hLK hGal hPrime hval_norm hval_alg
      ⟨hvalL0, hvalL1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_surj, hvalL_add⟩
      ⟨hvalK0, hvalK1, hvalK_neg1, hvalK_neg, hvalK_mul, hvalK_inv, hvalK_surj, hvalK_add⟩
  haveI : FiniteDimensional L (IntermediateField.extendScalars hLK) := hFinLK'
  letI : Group G := hGroupG
  letI : Fintype G := hFinG
  letI : Field k_L := hField_kL
  letI : Fintype k_L := hFin_kL
  letI : Field k_K := hField_kK
  letI : Fintype k_K := hFin_kK
  obtain ⟨hy₁, hAlg_k, π_res, hfinrank_res, hres_alg, hπ_inj, hπ_res⟩ :=
    ld_unramified_residue_algebra_and_galois_inj F L K hLK hPrime hval_alg htr_bound
      ⟨hvalL0, hvalL1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_surj, hvalL_add⟩
      ⟨hvalK0, hvalK1, hvalK_neg1, hvalK_neg, hvalK_mul, hvalK_inv, hvalK_surj, hvalK_add⟩
      G act hcard_G hact_one hact_mul hact_ring hact_incl hact_faithful hact_val hact_trace
      k_L k_K resL resK hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      hresK_0 hresK_1 hresK_ring hresK_ker hresK_surj
  letI : Algebra k_L k_K := hAlg_k
  have hres_Fy_all :=
    ld_unramified_charpoly_trace_norm_and_quad_expansion F L K hLK hPrime hval_norm hval_alg
      htr_bound
      ⟨hvalL0, hvalL1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv, hvalL_add⟩
      ⟨hvalK0, hvalK1, hvalK_neg1, hvalK_neg, hvalK_mul, hvalK_inv, hvalK_add⟩
      G act hcard_G hact_ring hact_incl hact_val hact_trace hact_norm
      k_L k_K resL resK hfinrank_res hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
      hresK_0 hresK_1 hresK_ring hresK_ker hres_alg π_res hπ_inj hπ_res
  exact ⟨htr_bound, hy₁, hnorm_lin1, k_L, k_K, hField_kL, hFin_kL, hField_kK, hFin_kK,
    hAlg_k, resL, resK, hfinrank_res, hresL_0, hresL_1, hresL_ring, hresL_ker, hresL_surj,
    hresK_0, hresK_1, hresK_ring, hresK_ker, hresK_surj, hres_alg, hres_Fy_all⟩

theorem ld_cond_one_tateEps_eq_residue_gauss_sum (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (ψ_M : AddChar M (Ω F)) (χ_M : Mˣ →* (Ω F)ˣ)
    (hcond_M : condExp F M χ_M = 1)
    (htate_val : valL F M ((tateElt F M χ_M ψ_M : Mˣ) : M) =
      (condExp F M χ_M : ℤ) + condExpChar F M ψ_M)
    (hFinM : Set.Finite {u : Mˣ ⧸ unitGroup F M (condExp F M χ_M) |
      valL F M ((cosetRep u : Mˣ) : M) = 0})
    (hvalM_props : valL F M 0 = 0 ∧ valL F M 1 = 0 ∧ valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
      (∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0))
    (k_M : Type u) [Field k_M] [Fintype k_M] (resM : M → k_M)
    (hresM_0 : resM 0 = 0) (hresM_1 : resM 1 = 1)
    (hresM_ring : ∀ x₁ x₂ : M, (x₁ = 0 ∨ 0 ≤ valL F M x₁) → (x₂ = 0 ∨ 0 ≤ valL F M x₂) →
      resM (x₁ + x₂) = resM x₁ + resM x₂ ∧
      resM (x₁ * x₂) = resM x₁ * resM x₂ ∧
      resM (-x₁) = -resM x₁)
    (hresM_ker : ∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
      (resM x = 0 ↔ (x = 0 ∨ 1 ≤ valL F M x)))
    (hresM_surj : ∀ a : k_M, ∃ x : M, (x = 0 ∨ 0 ≤ valL F M x) ∧ resM x = a)
    (c_M : Mˣ) (hc_M : valL F M (c_M : M) = 1 + condExpChar F M ψ_M)
    (χ_tilde : k_M → Ω F) (ψ_tilde : k_M → Ω F)
    (hχ_zero : χ_tilde 0 = 0)
    (hχ_unit : ∀ u : Mˣ, valL F M (u : M) = 0 → χ_tilde (resM (u : M)) = (χ_M u : Ω F)⁻¹)
    (hψ_int : ∀ x : M, (x = 0 ∨ 0 ≤ valL F M x) →
      ψ_tilde (resM x) = ψ_M (((c_M⁻¹ : Mˣ) : M) * x)) :
    tateEps F M χ_M ψ_M =
      (qL F M : Ω F) ^ condExpChar F M ψ_M * (χ_M c_M : Ω F) *
        (∑ a : k_M, χ_tilde a * ψ_tilde a) :=
by
  classical
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_add,
    hunit_ge1, hunit_val0⟩ := hvalM_props
  set c_tate : Mˣ := tateElt F M χ_M ψ_M
  set U : Finset (Mˣ ⧸ unitGroup F M (condExp F M χ_M)) := hFinM.toFinset
  have hmem_U : ∀ u : Mˣ ⧸ unitGroup F M (condExp F M χ_M),
      u ∈ U ↔ valL F M ((cosetRep u : Mˣ) : M) = 0 := by
    intro u
    simp [U, Set.Finite.mem_toFinset]
  have hcond_ne0 : condExp F M χ_M ≠ 0 := by omega
  have htate_sum : tateEps F M χ_M ψ_M =
      (qL F M : Ω F) ^ condExpChar F M ψ_M *
        ∑ u ∈ U, ((χ_M (c_tate⁻¹ * cosetRep u) : Ω F)⁻¹ *
          ψ_M (((c_tate⁻¹ * cosetRep u : Mˣ) : M))) := by
    dsimp only [tateEps, c_tate]
    rw [if_neg hcond_ne0]
    congr 1
    exact finsum_mem_eq_finite_toFinset_sum
      (fun u => (χ_M (c_tate⁻¹ * cosetRep u) : Ω F)⁻¹ *
        ψ_M (((c_tate⁻¹ * cosetRep u : Mˣ) : M))) hFinM
  set u₀ : Mˣ := c_M * c_tate⁻¹
  set b₀ : k_M := resM (u₀ : M)
  have hu₀_val : valL F M (u₀ : M) = 0 := by
    have hmul : (u₀ : M) = (c_M : M) * ((c_tate⁻¹ : Mˣ) : M) := Units.val_mul c_M c_tate⁻¹
    rw [hmul, hval_mul (c_M : M) ((c_tate⁻¹ : Mˣ) : M) (Units.ne_zero c_M) (Units.ne_zero c_tate⁻¹),
      hval_inv c_tate, hc_M, htate_val, hcond_M]
    omega
  have hb₀_ne : b₀ ≠ 0 := by
    intro hb₀0
    have hker := (hresM_ker (u₀ : M) (Or.inr (by omega))).mp hb₀0
    rcases hker with h0 | h1
    · exact Units.ne_zero u₀ h0
    · omega
  set i : (Mˣ ⧸ unitGroup F M (condExp F M χ_M)) → k_M :=
    fun u => b₀ * resM ((cosetRep u : Mˣ) : M)
  have hterm_eq : ∀ u ∈ U,
      (χ_M (c_tate⁻¹ * cosetRep u) : Ω F)⁻¹ * ψ_M (((c_tate⁻¹ * cosetRep u : Mˣ) : M)) =
        (χ_M c_M : Ω F) * (χ_tilde (i u) * ψ_tilde (i u)) := by
    intro u hu
    set r_u : Mˣ := cosetRep u
    have hr_val : valL F M (r_u : M) = 0 := (hmem_U u).mp hu
    have hu₀_ru_val : valL F M ((u₀ * r_u : Mˣ) : M) = 0 := by
      rw [Units.val_mul, hval_mul (u₀ : M) (r_u : M) (Units.ne_zero u₀) (Units.ne_zero r_u),
        hu₀_val, hr_val]
      omega
    have hu₀_ru_res : resM ((u₀ * r_u : Mˣ) : M) = i u := by
      rw [Units.val_mul]
      exact (hresM_ring (u₀ : M) (r_u : M) (Or.inr (by omega)) (Or.inr (by omega))).2.1
    have hmul_shift : c_tate⁻¹ * r_u = c_M⁻¹ * (u₀ * r_u) := by
      dsimp only [u₀]
      group
    have hχ_term : (χ_M (c_tate⁻¹ * r_u) : Ω F)⁻¹ = (χ_M c_M : Ω F) * χ_tilde (i u) := by
      rw [hmul_shift, map_mul, map_inv, Units.val_mul, mul_inv_rev,
        Units.val_inv_eq_inv_val, inv_inv, mul_comm ((χ_M (u₀ * r_u) : Ω F)⁻¹),
        ← hχ_unit (u₀ * r_u) hu₀_ru_val, hu₀_ru_res]
    have hψ_term : ψ_M (((c_tate⁻¹ * r_u : Mˣ) : M)) = ψ_tilde (i u) := by
      rw [hmul_shift, Units.val_mul,
        ← hψ_int ((u₀ * r_u : Mˣ) : M) (Or.inr (by omega)), hu₀_ru_res]
    rw [hχ_term, hψ_term, mul_assoc]
  have hi_mem : ∀ u ∈ U, i u ∈ (Finset.univ : Finset k_M).erase 0 := by
    intro u hu
    have hr_val : valL F M ((cosetRep u : Mˣ) : M) = 0 := (hmem_U u).mp hu
    have hres_ne : resM ((cosetRep u : Mˣ) : M) ≠ 0 := by
      intro h0
      rcases (hresM_ker ((cosetRep u : Mˣ) : M) (Or.inr (by omega))).mp h0 with h1 | h2
      · exact Units.ne_zero (cosetRep u) h1
      · omega
    exact Finset.mem_erase.mpr ⟨mul_ne_zero hb₀_ne hres_ne, Finset.mem_univ _⟩
  have hi_inj : ∀ u₁ ∈ U, ∀ u₂ ∈ U, i u₁ = i u₂ → u₁ = u₂ := by
    intro u₁ hu₁ u₂ hu₂ hi_eq
    set r₁ : Mˣ := cosetRep u₁
    set r₂ : Mˣ := cosetRep u₂
    have hr₁_val : valL F M (r₁ : M) = 0 := (hmem_U u₁).mp hu₁
    have hr₂_val : valL F M (r₂ : M) = 0 := (hmem_U u₂).mp hu₂
    have hres_eq : resM (r₁ : M) = resM (r₂ : M) := mul_left_cancel₀ hb₀_ne hi_eq
    set d : M := (r₂ : M) - (r₁ : M)
    have hd_add : d = (r₂ : M) + -(r₁ : M) := sub_eq_add_neg (r₂ : M) (r₁ : M)
    have hnr₁_val : valL F M (-(r₁ : M)) = 0 := by rw [hval_neg, hr₁_val]
    have hd_int : d = 0 ∨ 0 ≤ valL F M d := by
      rw [hd_add]
      exact hval_add 0 (r₂ : M) (-(r₁ : M)) (Or.inr (by omega)) (Or.inr (by omega))
    have hres_d : resM d = 0 := by
      have hring := hresM_ring (r₂ : M) (-(r₁ : M)) (Or.inr (by omega)) (Or.inr (by omega))
      have hring_neg := (hresM_ring (r₁ : M) (r₁ : M) (Or.inr (by omega)) (Or.inr (by omega))).2.2
      rw [hd_add, hring.1, hring_neg, ← hres_eq, add_neg_cancel]
    have hd1 : d = 0 ∨ (1 : ℤ) ≤ valL F M d := (hresM_ker d hd_int).mp hres_d
    set h : Mˣ := r₁⁻¹ * r₂
    have hr₁_inv_mul : ((r₁⁻¹ : Mˣ) : M) * (r₁ : M) = 1 := by
      exact_mod_cast Units.inv_mul r₁
    have hh_sub : (h : M) - 1 = ((r₁⁻¹ : Mˣ) : M) * d := by
      change ((r₁⁻¹ * r₂ : Mˣ) : M) - 1 = ((r₁⁻¹ : Mˣ) : M) * ((r₂ : M) - (r₁ : M))
      rw [Units.val_mul, mul_sub, hr₁_inv_mul]
    have hh_cond : (h : M) = 1 ∨ (condExp F M χ_M : ℤ) ≤ valL F M ((h : M) - 1) := by
      by_cases hd0 : d = 0
      · left
        have hsub0 : (h : M) - 1 = 0 := by rw [hh_sub, hd0, mul_zero]
        exact sub_eq_zero.mp hsub0
      · right
        have hd_ge1 : (1 : ℤ) ≤ valL F M d := hd1.resolve_left hd0
        rw [hh_sub, hval_mul ((r₁⁻¹ : Mˣ) : M) d (Units.ne_zero r₁⁻¹) hd0,
          hval_inv r₁, hr₁_val, hcond_M]
        omega
    have hh_mem : r₁⁻¹ * r₂ ∈ unitGroup F M (condExp F M χ_M) :=
      (hunit_ge1 (condExp F M χ_M) (by omega) h).mpr hh_cond
    have hmk_eq :
        (QuotientGroup.mk r₁ : Mˣ ⧸ unitGroup F M (condExp F M χ_M)) = QuotientGroup.mk r₂ :=
      QuotientGroup.eq.mpr hh_mem
    have hout₁ : (QuotientGroup.mk r₁ : Mˣ ⧸ unitGroup F M (condExp F M χ_M)) = u₁ :=
      QuotientGroup.out_eq' u₁
    have hout₂ : (QuotientGroup.mk r₂ : Mˣ ⧸ unitGroup F M (condExp F M χ_M)) = u₂ :=
      QuotientGroup.out_eq' u₂
    rw [← hout₁, ← hout₂, hmk_eq]
  have hi_surj : ∀ b ∈ (Finset.univ : Finset k_M).erase 0, ∃ u, ∃ (_ : u ∈ U), i u = b := by
    intro b hb
    have hb_ne : b ≠ 0 := (Finset.mem_erase.mp hb).1
    set a : k_M := b₀⁻¹ * b
    have ha_ne : a ≠ 0 := mul_ne_zero (inv_ne_zero hb₀_ne) hb_ne
    obtain ⟨x, hx_int, hx_res⟩ := hresM_surj a
    have hx_ne : x ≠ 0 := by
      intro hx0
      apply ha_ne
      rw [← hx_res, hx0, hresM_0]
    have hx_val : valL F M x = 0 := by
      have hx_ge0 : 0 ≤ valL F M x := hx_int.resolve_left hx_ne
      by_contra hx_ne0
      have hx_ge1 : 1 ≤ valL F M x := by omega
      have hres0 : resM x = 0 := (hresM_ker x hx_int).mpr (Or.inr hx_ge1)
      rw [hx_res] at hres0
      exact ha_ne hres0
    set v : Mˣ := Units.mk0 x hx_ne
    set u : Mˣ ⧸ unitGroup F M (condExp F M χ_M) := QuotientGroup.mk v
    set r : Mˣ := cosetRep u
    set h : Mˣ := v⁻¹ * r
    have hmk_r : (QuotientGroup.mk r : Mˣ ⧸ unitGroup F M (condExp F M χ_M)) = QuotientGroup.mk v :=
      QuotientGroup.out_eq' u
    have hh_mem : h ∈ unitGroup F M (condExp F M χ_M) :=
      QuotientGroup.eq.mp hmk_r.symm
    have hh_val : valL F M (h : M) = 0 := hunit_val0 (condExp F M χ_M) h hh_mem
    have hvh : v * h = r := mul_inv_cancel_left v r
    have hr_eq : (r : M) = x * (h : M) := by
      calc (r : M) = ((v * h : Mˣ) : M) := by rw [hvh]
        _ = (v : M) * (h : M) := Units.val_mul v h
        _ = x * (h : M) := by simp [v]
    have hr_val : valL F M (r : M) = 0 := by
      rw [hr_eq, hval_mul x (h : M) hx_ne (Units.ne_zero h), hx_val, hh_val]
      omega
    have hu_U : u ∈ U := (hmem_U u).mpr hr_val
    have hh_cond : (h : M) = 1 ∨ (condExp F M χ_M : ℤ) ≤ valL F M ((h : M) - 1) :=
      (hunit_ge1 (condExp F M χ_M) (by omega) h).mp hh_mem
    set d_h : M := (h : M) - 1
    have hdh_add : d_h = (h : M) + (-1 : M) := sub_eq_add_neg (h : M) 1
    have hdh_int : d_h = 0 ∨ 0 ≤ valL F M d_h := by
      rw [hdh_add]
      exact hval_add 0 (h : M) (-1 : M) (Or.inr (by omega)) (Or.inr (by omega))
    have hdh_ge1 : d_h = 0 ∨ 1 ≤ valL F M d_h := by
      rcases hh_cond with hh1 | hh1
      · left
        exact sub_eq_zero.mpr hh1
      · right
        change (condExp F M χ_M : ℤ) ≤ valL F M d_h at hh1
        omega
    have hres_dh : resM d_h = 0 := (hresM_ker d_h hdh_int).mpr hdh_ge1
    have hres_h : resM (h : M) = 1 := by
      have hring1 := hresM_ring (h : M) (-1 : M) (Or.inr (by omega)) (Or.inr (by omega))
      have hring_neg1 := (hresM_ring (1 : M) (1 : M) (Or.inr (by omega)) (Or.inr (by omega))).2.2
      have hadd0 : resM (h : M) + -1 = 0 := by
        rw [← hresM_1, ← hring_neg1, ← hring1.1, ← hdh_add, hres_dh]
      exact eq_of_sub_eq_zero (by simpa [sub_eq_add_neg] using hadd0)
    have hres_r : resM (r : M) = a := by
      rw [hr_eq, (hresM_ring x (h : M) hx_int (Or.inr (by omega))).2.1, hx_res, hres_h, mul_one]
    refine ⟨u, hu_U, ?_⟩
    dsimp only [i, r, a] at hres_r ⊢
    rw [hres_r, mul_inv_cancel_left₀ hb₀_ne b]
  have hsum_U :
      ∑ u ∈ U, ((χ_M (c_tate⁻¹ * cosetRep u) : Ω F)⁻¹ *
        ψ_M (((c_tate⁻¹ * cosetRep u : Mˣ) : M))) =
      (χ_M c_M : Ω F) * ∑ u ∈ U, (χ_tilde (i u) * ψ_tilde (i u)) := by
    rw [Finset.sum_congr rfl hterm_eq, ← Finset.mul_sum]
  have hsum_bij :
      ∑ u ∈ U, (χ_tilde (i u) * ψ_tilde (i u)) =
        ∑ a ∈ (Finset.univ : Finset k_M).erase 0, (χ_tilde a * ψ_tilde a) := by
    exact Finset.sum_bij (fun u _ => i u) hi_mem hi_inj hi_surj (fun _ _ => rfl)
  have hsum_erase :
      ∑ a ∈ (Finset.univ : Finset k_M).erase 0, (χ_tilde a * ψ_tilde a) =
        ∑ a : k_M, (χ_tilde a * ψ_tilde a) := by
    exact Finset.sum_erase Finset.univ (by rw [hχ_zero, zero_mul])
  rw [htate_sum, hsum_U, hsum_bij, hsum_erase, mul_assoc]

theorem ld_cond_one_residue_chars_and_poly_lam (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F L]
    (ψ : AddChar L (Ω F)) (χ' : Lˣ →* (Ω F)ˣ)
    (hcond_L : condExp F L χ' = 1)
    (hSpecL : (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L χ' ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L χ' - 1), χ' u₀ ≠ 1)) ∧
      valL F L ((tateElt F L χ' ψ : Lˣ) : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))))
    (k_L : Type u) [Field k_L] [Fintype k_L] (resL : L → k_L)
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a) :
    ∃ (χ_tilde : k_L → Ω F) (ψ_tilde : k_L → Ω F) (lam₁ : Polynomial k_L → Ω F),
      χ_tilde 0 = 0 ∧
      χ_tilde 1 = 1 ∧
      (∀ a b : k_L, χ_tilde (a * b) = χ_tilde a * χ_tilde b) ∧
      (∀ u : Lˣ, valL F L (u : L) = 0 → χ_tilde (resL (u : L)) = (χ' u : Ω F)⁻¹) ∧
      (∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
        ψ_tilde (resL x) = ψ ((((tateElt F L χ' ψ)⁻¹ : Lˣ) : L) * x)) ∧
      (∀ f : Polynomial k_L, lam₁ f = χ_tilde (f.coeff 0) * ψ_tilde (-f.nextCoeff)) ∧
      (∀ x : k_L, χ_tilde x * ψ_tilde x = χ_tilde (-1) * lam₁ (Polynomial.X - Polynomial.C x)) ∧
      lam₁ 1 = 1 ∧
      (∀ f g : Polynomial k_L, f.Monic → g.Monic → lam₁ (f * g) = lam₁ f * lam₁ g) ∧
      (∀ (d : ℕ), 2 ≤ d →
        (∑ c : Fin d → k_L,
          lam₁ (Polynomial.X ^ d + ∑ i : Fin d, Polynomial.C (c i) * Polynomial.X ^ (i : ℕ))) = 0) :=
by
  classical
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_add, hunit_ge1⟩ := hvalL_props
  obtain ⟨hψ_triv, ⟨x₁, hx₁_ne, hx₁_val, hx₁_ψ⟩, hχ'_spec, hc_L_val⟩ := hSpecL
  have hχ'_triv : ∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1 :=
    (hχ'_spec (by omega)).1
  set s_L : k_L → L := fun a => (hresL_surj a).choose
  have hs_L_int : ∀ a : k_L, s_L a = 0 ∨ 0 ≤ valL F L (s_L a) :=
    fun a => (hresL_surj a).choose_spec.1
  have hs_L_res : ∀ a : k_L, resL (s_L a) = a :=
    fun a => (hresL_surj a).choose_spec.2
  have hs_L_ne : ∀ a : k_L, a ≠ 0 → s_L a ≠ 0 := by
    intro a ha h0
    apply ha
    rw [← hs_L_res a, h0, hresL_0]
  have hs_L_val0 : ∀ a : k_L, a ≠ 0 → valL F L (s_L a) = 0 := by
    intro a ha
    have hge0 : 0 ≤ valL F L (s_L a) := (hs_L_int a).resolve_left (hs_L_ne a ha)
    by_contra hne
    have hge1 : 1 ≤ valL F L (s_L a) := by omega
    have hres0 : resL (s_L a) = 0 := (hresL_ker (s_L a) (hs_L_int a)).mpr (Or.inr hge1)
    rw [hs_L_res a] at hres0
    exact ha hres0
  set c_L : Lˣ := tateElt F L χ' ψ
  set χ_tilde : k_L → Ω F := fun a =>
    if ha : a = 0 then 0 else (χ' (Units.mk0 (s_L a) (hs_L_ne a ha)) : Ω F)⁻¹
  set ψ_tilde : k_L → Ω F := fun a =>
    ψ (((c_L⁻¹ : Lˣ) : L) * s_L a)
  set lam₁ : Polynomial k_L → Ω F := fun f =>
    χ_tilde (f.coeff 0) * ψ_tilde (-f.nextCoeff)
  have hχ_zero : χ_tilde 0 = 0 := dif_pos rfl
  have hχ_unit : ∀ u : Lˣ, valL F L (u : L) = 0 → χ_tilde (resL (u : L)) = (χ' u : Ω F)⁻¹ := by
    intro u hu_val
    set a : k_L := resL (u : L)
    have hu_int : (u : L) = 0 ∨ 0 ≤ valL F L (u : L) := Or.inr (by omega)
    have ha : a ≠ 0 := by
      intro h0
      have hker := (hresL_ker (u : L) hu_int).mp h0
      rcases hker with hu0 | hu1
      · exact Units.ne_zero u hu0
      · omega
    set v_a : Lˣ := Units.mk0 (s_L a) (hs_L_ne a ha)
    have hv_val : valL F L (v_a : L) = 0 := hs_L_val0 a ha
    have hv_int : (v_a : L) = 0 ∨ 0 ≤ valL F L (v_a : L) := Or.inr (by omega)
    have hneg_v_int : -(v_a : L) = 0 ∨ 0 ≤ valL F L (-(v_a : L)) := by
      right
      rw [hval_neg]
      omega
    set d : L := (u : L) - (v_a : L)
    have hd_int : d = 0 ∨ 0 ≤ valL F L d := by
      dsimp only [d]
      rw [sub_eq_add_neg]
      exact hval_add 0 (u : L) (-(v_a : L)) hu_int hneg_v_int
    have hd_res : resL d = 0 := by
      dsimp only [d]
      rw [sub_eq_add_neg, (hresL_ring (u : L) (-(v_a : L)) hu_int hneg_v_int).1,
        (hresL_ring (v_a : L) (v_a : L) hv_int hv_int).2.2]
      change a + -resL (s_L a) = 0
      rw [hs_L_res a, add_neg_cancel]
    have hd1 : d = 0 ∨ 1 ≤ valL F L d := (hresL_ker d hd_int).mp hd_res
    set h : Lˣ := v_a⁻¹ * u
    have hh_sub : (h : L) - 1 = ((v_a⁻¹ : Lˣ) : L) * d := by
      have hinv : ((v_a⁻¹ : Lˣ) : L) * (v_a : L) = 1 := by exact_mod_cast Units.inv_mul v_a
      calc (h : L) - 1 = ((v_a⁻¹ : Lˣ) : L) * (u : L) - ((v_a⁻¹ : Lˣ) : L) * (v_a : L) := by
            rw [Units.val_mul, hinv]
        _ = ((v_a⁻¹ : Lˣ) : L) * d := by dsimp only [d]; ring
    have hh_mem : h ∈ unitGroup F L (condExp F L χ') := by
      rw [hunit_ge1 (condExp F L χ') (by omega) h]
      by_cases hd0 : d = 0
      · left
        have hsub0 : (h : L) - 1 = 0 := by rw [hh_sub, hd0, mul_zero]
        exact sub_eq_zero.mp hsub0
      · right
        have hd_ge1 : 1 ≤ valL F L d := hd1.resolve_left hd0
        rw [hh_sub, hval_mul ((v_a⁻¹ : Lˣ) : L) d (Units.ne_zero v_a⁻¹) hd0,
          hval_inv v_a, hv_val]
        omega
    have hχ'_h : χ' h = 1 := hχ'_triv h hh_mem
    have hχ'_u : χ' u = χ' v_a := by
      have huv : v_a * h = u := mul_inv_cancel_left v_a u
      rw [← huv, map_mul, hχ'_h, mul_one]
    change (if ha' : a = 0 then (0 : Ω F) else (χ' (Units.mk0 (s_L a) (hs_L_ne a ha')) : Ω F)⁻¹) =
      (χ' u : Ω F)⁻¹
    rw [dif_neg ha, hχ'_u]
  have hχ_one : χ_tilde 1 = 1 := by
    have h1_val : valL F L ((1 : Lˣ) : L) = 0 := by
      rw [Units.val_one]
      exact hval1
    have h1 := hχ_unit 1 h1_val
    rw [Units.val_one, hresL_1, map_one, Units.val_one, inv_one] at h1
    exact h1
  have hχ_mul : ∀ a b : k_L, χ_tilde (a * b) = χ_tilde a * χ_tilde b := by
    intro a b
    by_cases ha : a = 0
    · rw [ha, zero_mul, hχ_zero, zero_mul]
    · by_cases hb : b = 0
      · rw [hb, mul_zero, hχ_zero, mul_zero]
      · set v_a : Lˣ := Units.mk0 (s_L a) (hs_L_ne a ha)
        set v_b : Lˣ := Units.mk0 (s_L b) (hs_L_ne b hb)
        have hva_val : valL F L (v_a : L) = 0 := hs_L_val0 a ha
        have hvb_val : valL F L (v_b : L) = 0 := hs_L_val0 b hb
        have hvab_val : valL F L ((v_a * v_b : Lˣ) : L) = 0 := by
          rw [Units.val_mul, hval_mul (v_a : L) (v_b : L) (Units.ne_zero v_a) (Units.ne_zero v_b),
            hva_val, hvb_val, add_zero]
        have hvab_res : resL ((v_a * v_b : Lˣ) : L) = a * b := by
          rw [Units.val_mul, (hresL_ring (v_a : L) (v_b : L) (hs_L_int a) (hs_L_int b)).2.1]
          change resL (s_L a) * resL (s_L b) = a * b
          rw [hs_L_res a, hs_L_res b]
        have h1 := hχ_unit (v_a * v_b) hvab_val
        have h2 := hχ_unit v_a hva_val
        have h3 := hχ_unit v_b hvb_val
        have hva_res : resL (v_a : L) = a := hs_L_res a
        have hvb_res : resL (v_b : L) = b := hs_L_res b
        rw [hvab_res] at h1
        rw [hva_res] at h2
        rw [hvb_res] at h3
        rw [h1, h2, h3, map_mul, Units.val_mul, mul_inv]
  have hψ_int : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ψ_tilde (resL x) = ψ (((c_L⁻¹ : Lˣ) : L) * x) := by
    intro x hx_int
    set a : k_L := resL x
    have hneg_s_int : -(s_L a) = 0 ∨ 0 ≤ valL F L (-(s_L a)) := by
      rcases hs_L_int a with hs0 | hsge
      · left
        rw [hs0, neg_zero]
      · right
        rw [hval_neg]
        exact hsge
    set d : L := x - s_L a
    have hd_int : d = 0 ∨ 0 ≤ valL F L d := by
      dsimp only [d]
      rw [sub_eq_add_neg]
      exact hval_add 0 x (-(s_L a)) hx_int hneg_s_int
    have hd_res : resL d = 0 := by
      dsimp only [d]
      rw [sub_eq_add_neg, (hresL_ring x (-(s_L a)) hx_int hneg_s_int).1,
        (hresL_ring (s_L a) (s_L a) (hs_L_int a) (hs_L_int a)).2.2, hs_L_res a]
      exact add_neg_cancel a
    have hd1 : d = 0 ∨ 1 ≤ valL F L d := (hresL_ker d hd_int).mp hd_res
    set w : L := ((c_L⁻¹ : Lˣ) : L) * d
    have hw_cond : w = 0 ∨ -condExpChar F L ψ ≤ valL F L w := by
      by_cases hd0 : d = 0
      · left
        dsimp only [w]
        rw [hd0, mul_zero]
      · right
        have hd_ge1 : 1 ≤ valL F L d := hd1.resolve_left hd0
        dsimp only [w]
        rw [hval_mul ((c_L⁻¹ : Lˣ) : L) d (Units.ne_zero c_L⁻¹) hd0,
          hval_inv c_L, hc_L_val, hcond_L]
        omega
    have hψ_w : ψ w = 1 := hψ_triv w hw_cond
    have hx_decomp : ((c_L⁻¹ : Lˣ) : L) * x = ((c_L⁻¹ : Lˣ) : L) * s_L a + w := by
      dsimp only [w, d]
      ring
    rw [hx_decomp, ψ.map_add_eq_mul, hψ_w, mul_one]
  have hψ_zero : ψ_tilde 0 = 1 := by
    rw [← hresL_0, hψ_int 0 (Or.inl rfl), mul_zero, ψ.map_zero_eq_one]
  have hψ_add : ∀ a b : k_L, ψ_tilde (a + b) = ψ_tilde a * ψ_tilde b := by
    intro a b
    have hab_int : s_L a + s_L b = 0 ∨ 0 ≤ valL F L (s_L a + s_L b) :=
      hval_add 0 (s_L a) (s_L b) (hs_L_int a) (hs_L_int b)
    have hab_res : resL (s_L a + s_L b) = a + b := by
      rw [(hresL_ring (s_L a) (s_L b) (hs_L_int a) (hs_L_int b)).1, hs_L_res a, hs_L_res b]
    rw [← hab_res, hψ_int (s_L a + s_L b) hab_int, mul_add, ψ.map_add_eq_mul]
  have hlam₁_def : ∀ f : Polynomial k_L, lam₁ f = χ_tilde (f.coeff 0) * ψ_tilde (-f.nextCoeff) :=
    fun _ => rfl
  have hlam₁_lin : ∀ x : k_L,
      χ_tilde x * ψ_tilde x = χ_tilde (-1) * lam₁ (Polynomial.X - Polynomial.C x) := by
    intro x
    have hcoeff0 : (Polynomial.X - Polynomial.C x).coeff 0 = -x := by
      rw [Polynomial.coeff_sub, Polynomial.coeff_X_zero, Polynomial.coeff_C_zero, zero_sub]
    have hnext : (Polynomial.X - Polynomial.C x).nextCoeff = -x :=
      Polynomial.nextCoeff_X_sub_C x
    have hneg1_mul : (-1 : k_L) * (-x) = x := by ring
    dsimp only [lam₁]
    rw [hcoeff0, hnext, neg_neg, ← mul_assoc, ← hχ_mul (-1) (-x), hneg1_mul]
  have hlam₁_1 : lam₁ 1 = 1 := by
    have hnext1 : (1 : Polynomial k_L).nextCoeff = 0 :=
      Polynomial.nextCoeff_eq_zero.mpr (Or.inl Polynomial.natDegree_one)
    dsimp only [lam₁]
    rw [Polynomial.coeff_one_zero, hnext1, neg_zero, hχ_one, hψ_zero, mul_one]
  have hlam₁_mul : ∀ f g : Polynomial k_L, f.Monic → g.Monic → lam₁ (f * g) = lam₁ f * lam₁ g := by
    intro f g hf hg
    dsimp only [lam₁]
    rw [Polynomial.mul_coeff_zero f g, Polynomial.Monic.nextCoeff_mul hf hg,
      neg_add, hχ_mul, hψ_add]
    ring
  have hlam₁_van : ∀ (d : ℕ), 2 ≤ d →
      (∑ c : Fin d → k_L,
        lam₁ (Polynomial.X ^ d + ∑ i : Fin d, Polynomial.C (c i) * Polynomial.X ^ (i : ℕ))) = 0 := by
    intro d hd
    set P : (Fin d → k_L) → Polynomial k_L :=
      fun c => ∑ i : Fin d, Polynomial.C (c i) * Polynomial.X ^ (i : ℕ)
    set f : (Fin d → k_L) → Polynomial k_L :=
      fun c => Polynomial.X ^ d + P c
    have hf_coeff : ∀ (c : Fin d → k_L) (j : Fin d), (f c).coeff (j : ℕ) = c j := by
      intro c j
      have hj_ne : (j : ℕ) ≠ d := by
        have := j.isLt
        omega
      dsimp only [f, P]
      rw [Polynomial.coeff_add, Polynomial.coeff_X_pow, if_neg hj_ne, zero_add,
        Polynomial.finset_sum_coeff]
      rw [Finset.sum_eq_single j]
      · rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_pos rfl, mul_one]
      · intro i _ hij
        have hij_val : (j : ℕ) ≠ (i : ℕ) := fun h => hij (Fin.ext h.symm)
        rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, if_neg hij_val, mul_zero]
      · intro hj_mem
        exact absurd (Finset.mem_univ j) hj_mem
    have hf_deg : ∀ c : Fin d → k_L, (f c).natDegree = d := by
      intro c
      have hP_le : (P c).natDegree ≤ d - 1 := by
        dsimp only [P]
        apply Polynomial.natDegree_sum_le_of_forall_le
        intro i _
        have h1 : (Polynomial.C (c i) * Polynomial.X ^ (i : ℕ)).natDegree ≤ (i : ℕ) :=
          Polynomial.natDegree_C_mul_X_pow_le (c i) (i : ℕ)
        have h2 : (i : ℕ) < d := i.isLt
        omega
      have hXd_deg : (Polynomial.X ^ d : Polynomial k_L).natDegree = d :=
        Polynomial.natDegree_X_pow d
      have hlt : (P c).natDegree < (Polynomial.X ^ d : Polynomial k_L).natDegree := by
        rw [hXd_deg]
        omega
      dsimp only [f]
      rw [Polynomial.natDegree_add_eq_left_of_natDegree_lt hlt, hXd_deg]
    set i₀ : Fin d := ⟨0, by omega⟩
    set i_top : Fin d := ⟨d - 1, by omega⟩
    have hlam₁_fc : ∀ c : Fin d → k_L,
        lam₁ (f c) = χ_tilde (c i₀) * ψ_tilde (- c i_top) := by
      intro c
      have h0 : (f c).coeff 0 = c i₀ := hf_coeff c i₀
      have hdeg_pos : 0 < (f c).natDegree := by
        rw [hf_deg c]
        omega
      have hnext : (f c).nextCoeff = c i_top := by
        rw [Polynomial.nextCoeff_of_natDegree_pos hdeg_pos, hf_deg c]
        exact hf_coeff c i_top
      dsimp only [lam₁]
      rw [h0, hnext]
    set z₁ : L := (c_L : L) * x₁
    have hz₁_val : 0 ≤ valL F L z₁ := by
      dsimp only [z₁]
      rw [hval_mul (c_L : L) x₁ (Units.ne_zero c_L) hx₁_ne, hc_L_val, hcond_L]
      omega
    set a₁ : k_L := resL z₁
    have hψ_a₁_ne1 : ψ_tilde a₁ ≠ 1 := by
      have hinv_c : ((c_L⁻¹ : Lˣ) : L) * (c_L : L) = 1 := by exact_mod_cast Units.inv_mul c_L
      have hψ_a₁ : ψ_tilde a₁ = ψ x₁ := by
        dsimp only [a₁, z₁]
        rw [hψ_int ((c_L : L) * x₁) (Or.inr hz₁_val), ← mul_assoc, hinv_c, one_mul]
      rw [hψ_a₁]
      exact hx₁_ψ
    have hi_ne : i₀ ≠ i_top := by
      intro h
      have hval := congrArg Fin.val h
      dsimp only [i₀, i_top] at hval
      omega
    set e : (Fin d → k_L) ≃ (Fin d → k_L) :=
      { toFun := fun c => Function.update c i_top (c i_top - a₁)
        invFun := fun c => Function.update c i_top (c i_top + a₁)
        left_inv := fun c => by
          simp only [Function.update_self, sub_add_cancel, Function.update_idem,
            Function.update_eq_self]
        right_inv := fun c => by
          simp only [Function.update_self, add_sub_cancel_right, Function.update_idem,
            Function.update_eq_self] }
    have hshift : ∀ c : Fin d → k_L, lam₁ (f (e c)) = ψ_tilde a₁ * lam₁ (f c) := by
      intro c
      have he0 : e c i₀ = c i₀ := Function.update_of_ne hi_ne (c i_top - a₁) c
      have he_top : e c i_top = c i_top - a₁ := Function.update_self i_top (c i_top - a₁) c
      have hneg_sub : -(c i_top - a₁) = a₁ + -c i_top := by ring
      rw [hlam₁_fc (e c), hlam₁_fc c, he0, he_top, hneg_sub, hψ_add]
      ring
    set S : Ω F := ∑ c : Fin d → k_L, lam₁ (f c)
    have hS_eq : ψ_tilde a₁ * S = S := by
      calc ψ_tilde a₁ * S = ∑ c : Fin d → k_L, ψ_tilde a₁ * lam₁ (f c) := by
            dsimp only [S]
            rw [Finset.mul_sum]
        _ = ∑ c : Fin d → k_L, lam₁ (f (e c)) := by
            refine Finset.sum_congr rfl fun c _ => ?_
            exact (hshift c).symm
        _ = S := Fintype.sum_equiv e (fun c => lam₁ (f (e c))) (fun c => lam₁ (f c)) (fun _ => rfl)
    have hsub0 : (ψ_tilde a₁ - 1) * S = 0 := by
      calc (ψ_tilde a₁ - 1) * S = ψ_tilde a₁ * S - S := by ring
        _ = 0 := sub_eq_zero.mpr hS_eq
    exact (mul_eq_zero.mp hsub0).resolve_left (sub_ne_zero.mpr hψ_a₁_ne1)
  exact ⟨χ_tilde, ψ_tilde, lam₁, hχ_zero, hχ_one, hχ_mul, hχ_unit, hψ_int,
    hlam₁_def, hlam₁_lin, hlam₁_1, hlam₁_mul, hlam₁_van⟩

theorem ld_cond_one_extension_trace_norm_bridge (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (χ' : Lˣ →* (Ω F)ˣ)
    (hcond_L : condExp F L χ' = 1)
    (hcondChar_eq : condExpChar F K (traceChar F hLK ψ) = condExpChar F L ψ)
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F K y)
    (hval_alg : ∀ x : L, valL F K (IntermediateField.inclusion hLK x) = valL F L x)
    (hSpecL : (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L χ' ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L χ' - 1), χ' u₀ ≠ 1)) ∧
      valL F L ((tateElt F L χ' ψ : Lˣ) : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hSpecK_triv : ∀ y : K, (y = 0 ∨ -condExpChar F K (traceChar F hLK ψ) ≤ valL F K y) →
      traceChar F hLK ψ y = 1)
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)))
    (hvalK_props : valL F K 0 = 0 ∧ valL F K 1 = 0 ∧
      (∀ x y : K, x ≠ 0 → y ≠ 0 → valL F K (x * y) = valL F K x + valL F K y) ∧
      (∀ u : Kˣ, valL F K ((u⁻¹ : Kˣ) : K) = - valL F K (u : K)))
    (k_L k_K : Type u) [Field k_L] [Fintype k_L] [Field k_K] [Fintype k_K]
    [Algebra k_L k_K] (resL : L → k_L) (resK : K → k_K)
    (hfinrank_res : Module.finrank k_L k_K =
      Module.finrank L (IntermediateField.extendScalars hLK))
    (hres_Fy : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      let F_y : Polynomial k_L :=
        (minpoly k_L (resK y)) ^
          (Module.finrank k_L k_K / (minpoly k_L (resK y)).natDegree)
      resL (traceLM F hLK y) = -F_y.nextCoeff ∧
      resL (normLM F hLK y) = (-1 : k_L) ^ (Module.finrank k_L k_K) * F_y.coeff 0)
    (χ_tilde : k_L → Ω F) (ψ_tilde : k_L → Ω F) (lam₁ : Polynomial k_L → Ω F)
    (hχ_zero : χ_tilde 0 = 0)
    (hχ_one : χ_tilde 1 = 1)
    (hχ_mul : ∀ a b : k_L, χ_tilde (a * b) = χ_tilde a * χ_tilde b)
    (hχ_unit : ∀ u : Lˣ, valL F L (u : L) = 0 → χ_tilde (resL (u : L)) = (χ' u : Ω F)⁻¹)
    (hψ_int : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      ψ_tilde (resL x) = ψ ((((tateElt F L χ' ψ)⁻¹ : Lˣ) : L) * x))
    (hlam₁_def : ∀ f : Polynomial k_L, lam₁ f = χ_tilde (f.coeff 0) * ψ_tilde (-f.nextCoeff)) :
    ∃ (c_K' : Kˣ) (χ_tilde_K : k_K → Ω F) (ψ_tilde_K : k_K → Ω F),
      valL F K (c_K' : K) = 1 + condExpChar F K (traceChar F hLK ψ) ∧
      (((χ'.comp (Units.map (normLM F hLK))) c_K' : Ω F) =
        (χ' (tateElt F L χ' ψ) : Ω F) ^ (Module.finrank L (IntermediateField.extendScalars hLK))) ∧
      χ_tilde_K 0 = 0 ∧
      (∀ w : Kˣ, valL F K (w : K) = 0 →
        χ_tilde_K (resK (w : K)) = ((χ'.comp (Units.map (normLM F hLK))) w : Ω F)⁻¹) ∧
      (∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
        ψ_tilde_K (resK y) = (traceChar F hLK ψ) (((c_K'⁻¹ : Kˣ) : K) * y)) ∧
      (∀ b : k_K,
        χ_tilde_K b * ψ_tilde_K b =
          (χ_tilde (-1)) ^ (Module.finrank k_L k_K) *
            lam₁ ((minpoly k_L b) ^ (Module.finrank k_L k_K / (minpoly k_L b).natDegree))) :=
by
  obtain ⟨hval0_L, hval1_L, hval_mul_L, hval_inv_L⟩ := hvalL_props
  obtain ⟨hval0_K, hval1_K, hval_mul_K, hval_inv_K⟩ := hvalK_props
  let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
  set ℓ := Module.finrank L K'
  set ℓ_k := Module.finrank k_L k_K
  have hto_inc : ∀ x : L,
      toExtendScalars F hLK (IntermediateField.inclusion hLK x) = algebraMap L K' x :=
    fun _ => rfl
  have hnorm_inc : ∀ x : L,
      normLM F hLK (IntermediateField.inclusion hLK x) = x ^ ℓ := by
    intro x
    change Algebra.norm L (toExtendScalars F hLK (IntermediateField.inclusion hLK x)) = x ^ ℓ
    rw [hto_inc x]
    exact Algebra.norm_algebraMap x
  have htrace_smul : ∀ (x : L) (y : K),
      traceLM F hLK (IntermediateField.inclusion hLK x * y) = x * traceLM F hLK y := by
    letI : Module L L := Semiring.toModule
    intro x y
    change Algebra.trace L K' (toExtendScalars F hLK (IntermediateField.inclusion hLK x * y)) =
      x * Algebra.trace L K' (toExtendScalars F hLK y)
    rw [map_mul, hto_inc x, ← Algebra.smul_def, (Algebra.trace L K').map_smul, smul_eq_mul]
  let c_L : Lˣ := tateElt F L χ' ψ
  let c_K' : Kˣ := Units.map (IntermediateField.inclusion hLK).toMonoidHom c_L
  have hc_K'_coe : (c_K' : K) = IntermediateField.inclusion hLK (c_L : L) := rfl
  have hc_K'_inv_coe : ((c_K'⁻¹ : Kˣ) : K) =
      IntermediateField.inclusion hLK ((c_L⁻¹ : Lˣ) : L) := by
    rw [← map_inv]
    rfl
  have hc_K'_val : valL F K (c_K' : K) = 1 + condExpChar F K (traceChar F hLK ψ) := by
    rw [hc_K'_coe, hval_alg, hSpecL.2.2.2, hcond_L, hcondChar_eq]
    norm_num
  have hnorm_cK' : Units.map (normLM F hLK) c_K' = c_L ^ ℓ := by
    apply Units.ext
    change normLM F hLK (IntermediateField.inclusion hLK (c_L : L)) = ((c_L ^ ℓ : Lˣ) : L)
    rw [hnorm_inc, Units.val_pow_eq_pow_val]
  have hc_K'_χ : (((χ'.comp (Units.map (normLM F hLK))) c_K' : Ω F) =
      (χ' c_L : Ω F) ^ ℓ) := by
    rw [MonoidHom.comp_apply, hnorm_cK', map_pow, Units.val_pow_eq_pow_val]
  let F_poly : k_K → Polynomial k_L := fun b =>
    (minpoly k_L b) ^ (ℓ_k / (minpoly k_L b).natDegree)
  let χ_tilde_K : k_K → Ω F := fun b =>
    χ_tilde ((-1 : k_L) ^ ℓ_k * (F_poly b).coeff 0)
  let ψ_tilde_K : k_K → Ω F := fun b =>
    ψ_tilde (-(F_poly b).nextCoeff)
  have hℓ_k_ne : ℓ_k ≠ 0 := by
    rw [hfinrank_res]
    exact hPrime.ne_zero
  have hχK_zero : χ_tilde_K 0 = 0 := by
    dsimp only [χ_tilde_K, F_poly]
    rw [minpoly.zero k_L k_K, Polynomial.natDegree_X, Nat.div_one,
      Polynomial.coeff_X_pow, if_neg (Ne.symm hℓ_k_ne), mul_zero, hχ_zero]
  have hχK_unit : ∀ w : Kˣ, valL F K (w : K) = 0 →
      χ_tilde_K (resK (w : K)) = ((χ'.comp (Units.map (normLM F hLK))) w : Ω F)⁻¹ := by
    intro w hw
    have hw_int : (w : K) = 0 ∨ 0 ≤ valL F K (w : K) := Or.inr (by omega)
    have hres_norm : resL (normLM F hLK (w : K)) =
        (-1 : k_L) ^ ℓ_k * (F_poly (resK (w : K))).coeff 0 :=
      (hres_Fy (w : K) hw_int).2
    let u_w : Lˣ := Units.map (normLM F hLK) w
    have hu_w_coe : (u_w : L) = normLM F hLK (w : K) := rfl
    have hu_w_val : valL F L (u_w : L) = 0 := by
      rw [hu_w_coe, hval_norm, hw, mul_zero]
    dsimp only [χ_tilde_K]
    rw [← hres_norm, ← hu_w_coe, hχ_unit u_w hu_w_val]
    rfl
  have htr_int : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      traceLM F hLK y = 0 ∨ 0 ≤ valL F L (traceLM F hLK y) := by
    intro y hy
    set t := traceLM F hLK y
    by_cases ht0 : t = 0
    · exact Or.inl ht0
    · right
      by_contra hlt
      push_neg at hlt
      have hy_ne : y ≠ 0 := by
        intro hy0
        apply ht0
        dsimp only [t]
        rw [hy0, map_zero]
      have hy_val : 0 ≤ valL F K y := hy.resolve_left hy_ne
      obtain ⟨x₁, hx₁_ne, hx₁_val, hx₁_ψ⟩ := hSpecL.2.1
      let u_t : Lˣ := Units.mk0 t ht0
      have hu_t_coe : (u_t : L) = traceLM F hLK y := rfl
      have hu_t_inv_ne : ((u_t⁻¹ : Lˣ) : L) ≠ 0 := Units.ne_zero u_t⁻¹
      let x : L := x₁ * ((u_t⁻¹ : Lˣ) : L)
      have hx_ne : x ≠ 0 := mul_ne_zero hx₁_ne hu_t_inv_ne
      have hx_val : -condExpChar F L ψ ≤ valL F L x := by
        have hmul := hval_mul_L x₁ ((u_t⁻¹ : Lˣ) : L) hx₁_ne hu_t_inv_ne
        have hinv := hval_inv_L u_t
        rw [hu_t_coe] at hinv
        dsimp only [x, t] at *
        omega
      let z : K := IntermediateField.inclusion hLK x * y
      have hinc_ne : IntermediateField.inclusion hLK x ≠ 0 := by
        intro hinc0
        apply hx_ne
        exact (IntermediateField.inclusion hLK).injective (hinc0.trans (map_zero _).symm)
      have hz_val : -condExpChar F K (traceChar F hLK ψ) ≤ valL F K z := by
        have hmul_z := hval_mul_K (IntermediateField.inclusion hLK x) y hinc_ne hy_ne
        have halg_x := hval_alg x
        dsimp only [z]
        omega
      have htriv : traceChar F hLK ψ z = 1 := hSpecK_triv z (Or.inr hz_val)
      have htr_z : traceLM F hLK z = x₁ := by
        dsimp only [z]
        rw [htrace_smul]
        dsimp only [x]
        rw [mul_assoc, ← hu_t_coe, ← Units.val_mul, inv_mul_cancel, Units.val_one, mul_one]
      have htriv' : ψ x₁ = 1 := by
        rw [← htr_z]
        exact htriv
      exact hx₁_ψ htriv'
  have hψK_int : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      ψ_tilde_K (resK y) = (traceChar F hLK ψ) (((c_K'⁻¹ : Kˣ) : K) * y) := by
    intro y hy
    have hres_tr : resL (traceLM F hLK y) = -(F_poly (resK y)).nextCoeff :=
      (hres_Fy y hy).1
    dsimp only [ψ_tilde_K]
    rw [← hres_tr, hψ_int (traceLM F hLK y) (htr_int y hy)]
    change ψ (((c_L⁻¹ : Lˣ) : L) * traceLM F hLK y) =
      ψ (traceLM F hLK (((c_K'⁻¹ : Kˣ) : K) * y))
    rw [hc_K'_inv_coe, htrace_smul]
  have hχ_pow : ∀ (a : k_L) (m : ℕ), χ_tilde (a ^ m) = (χ_tilde a) ^ m := by
    intro a m
    induction m with
    | zero => rw [pow_zero, pow_zero, hχ_one]
    | succ m ih => rw [pow_succ, pow_succ, hχ_mul, ih]
  have hK_prod : ∀ b : k_K,
      χ_tilde_K b * ψ_tilde_K b =
        (χ_tilde (-1)) ^ ℓ_k * lam₁ (F_poly b) := by
    intro b
    dsimp only [χ_tilde_K, ψ_tilde_K]
    rw [hχ_mul, hχ_pow, mul_assoc, ← hlam₁_def]
  exact ⟨c_K', χ_tilde_K, ψ_tilde_K, hc_K'_val, hc_K'_χ, hχK_zero, hχK_unit, hψK_int, hK_prod⟩

theorem ld_ch10_unramified_hd_loc_cond_one (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L K : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F K] (hLK : L ≤ K)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLK)))
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψK : IsAdmissibleChar F K (traceChar F hLK ψ))
    (χ' : Lˣ →* (Ω F)ˣ)
    (hcond_L : condExp F L χ' = 1)
    (hcond_K : condExp F K (χ'.comp (Units.map (normLM F hLK))) = 1)
    (hcondChar_eq : condExpChar F K (traceChar F hLK ψ) = condExpChar F L ψ)
    (hqL_eq : qL F K = (qL F L) ^ (Module.finrank L (IntermediateField.extendScalars hLK)))
    (hval_norm : ∀ y : K, valL F L (normLM F hLK y) =
      (Module.finrank L (IntermediateField.extendScalars hLK) : ℤ) * valL F K y)
    (hval_alg : ∀ x : L, valL F K (IntermediateField.inclusion hLK x) = valL F L x)
    (hSpecL : (∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1) ∧
      (∃ x₁ : L, x₁ ≠ 0 ∧ -(condExpChar F L ψ + 1) ≤ valL F L x₁ ∧ ψ x₁ ≠ 1) ∧
      (condExp F L χ' ≠ 0 →
        (∀ u ∈ unitGroup F L (condExp F L χ'), χ' u = 1) ∧
        (∃ u₀ ∈ unitGroup F L (condExp F L χ' - 1), χ' u₀ ≠ 1)) ∧
      valL F L ((tateElt F L χ' ψ : Lˣ) : L) = (condExp F L χ' : ℤ) + condExpChar F L ψ)
    (hSpecK : (∀ y : K, (y = 0 ∨ -condExpChar F K (traceChar F hLK ψ) ≤ valL F K y) →
        traceChar F hLK ψ y = 1) ∧
      (∃ y₁ : K, y₁ ≠ 0 ∧ -(condExpChar F K (traceChar F hLK ψ) + 1) ≤ valL F K y₁ ∧
        traceChar F hLK ψ y₁ ≠ 1) ∧
      (condExp F K (χ'.comp (Units.map (normLM F hLK))) ≠ 0 →
        (∀ w ∈ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))),
          (χ'.comp (Units.map (normLM F hLK))) w = 1) ∧
        (∃ w₀ ∈ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK))) - 1),
          (χ'.comp (Units.map (normLM F hLK))) w₀ ≠ 1)) ∧
      valL F K ((tateElt F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) : Kˣ) : K) =
        (condExp F K (χ'.comp (Units.map (normLM F hLK))) : ℤ) +
          condExpChar F K (traceChar F hLK ψ))
    (hFinL : Set.Finite {u : Lˣ ⧸ unitGroup F L (condExp F L χ') |
      valL F L ((cosetRep u : Lˣ) : L) = 0})
    (hFinK : Set.Finite {w : Kˣ ⧸ unitGroup F K (condExp F K (χ'.comp (Units.map (normLM F hLK)))) |
      valL F K ((cosetRep w : Kˣ) : K) = 0})
    (k_L k_K : Type u) [Field k_L] [Fintype k_L] [Field k_K] [Fintype k_K]
    [Algebra k_L k_K] (resL : L → k_L) (resK : K → k_K)
    (hfinrank_res : Module.finrank k_L k_K =
      Module.finrank L (IntermediateField.extendScalars hLK))
    (hresL_0 : resL 0 = 0) (hresL_1 : resL 1 = 1)
    (hresL_ring : ∀ x₁ x₂ : L, (x₁ = 0 ∨ 0 ≤ valL F L x₁) → (x₂ = 0 ∨ 0 ≤ valL F L x₂) →
      resL (x₁ + x₂) = resL x₁ + resL x₂ ∧
      resL (x₁ * x₂) = resL x₁ * resL x₂ ∧
      resL (-x₁) = -resL x₁)
    (hresL_ker : ∀ x : L, (x = 0 ∨ 0 ≤ valL F L x) →
      (resL x = 0 ↔ (x = 0 ∨ 1 ≤ valL F L x)))
    (hresL_surj : ∀ a : k_L, ∃ x : L, (x = 0 ∨ 0 ≤ valL F L x) ∧ resL x = a)
    (hresK_0 : resK 0 = 0) (hresK_1 : resK 1 = 1)
    (hresK_ring : ∀ y₁ y₂ : K, (y₁ = 0 ∨ 0 ≤ valL F K y₁) → (y₂ = 0 ∨ 0 ≤ valL F K y₂) →
      resK (y₁ + y₂) = resK y₁ + resK y₂ ∧
      resK (y₁ * y₂) = resK y₁ * resK y₂ ∧
      resK (-y₁) = -resK y₁)
    (hresK_ker : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      (resK y = 0 ↔ (y = 0 ∨ 1 ≤ valL F K y)))
    (hresK_surj : ∀ b : k_K, ∃ y : K, (y = 0 ∨ 0 ≤ valL F K y) ∧ resK y = b)
    (hres_Fy : ∀ y : K, (y = 0 ∨ 0 ≤ valL F K y) →
      let F_y : Polynomial k_L :=
        (minpoly k_L (resK y)) ^
          (Module.finrank k_L k_K / (minpoly k_L (resK y)).natDegree)
      resL (traceLM F hLK y) = -F_y.nextCoeff ∧
      resL (normLM F hLK y) = (-1 : k_L) ^ (Module.finrank k_L k_K) * F_y.coeff 0)
    (hPolyLift : ∀ (lam : Polynomial k_L → Ω F),
      lam 1 = 1 →
      (∀ f g : Polynomial k_L, f.Monic → g.Monic → lam (f * g) = lam f * lam g) →
      (∀ (d : ℕ), 2 ≤ d → d ≤ Module.finrank k_L k_K →
        (∑ c : Fin d → k_L,
          lam (Polynomial.X ^ d + ∑ i : Fin d, Polynomial.C (c i) * Polynomial.X ^ (i : ℕ))) = 0) →
      (∑ y : k_K,
        lam ((minpoly k_L y) ^ (Module.finrank k_L k_K / (minpoly k_L y).natDegree))) =
        (-1 : Ω F) ^ (Module.finrank k_L k_K - 1) *
          (∑ x : k_L, lam (Polynomial.X - Polynomial.C x)) ^ (Module.finrank k_L k_K)) :
    tateEps F K (χ'.comp (Units.map (normLM F hLK))) (traceChar F hLK ψ) =
      (-1 : Ω F) ^ (condExp F L χ' *
        (Module.finrank L (IntermediateField.extendScalars hLK) - 1)) *
        (tateEps F L χ' ψ) ^ (Module.finrank L (IntermediateField.extendScalars hLK)) :=
by
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, _, hval_add_L,
    _, hunit_ge1_L, hunit_val0_L⟩ := ld_valL_and_unitGroup_props F L
  obtain ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K, hval_inv_K, _, hval_add_K,
    _, hunit_ge1_K, hunit_val0_K⟩ := ld_valL_and_unitGroup_props F K
  obtain ⟨χ_tilde, ψ_tilde, lam₁, hχ_zero, hχ_one, hχ_mul, hχ_unit, hψ_int,
    hlam₁_def, hlam₁_lin, hlam₁_1, hlam₁_mul, hlam₁_van⟩ :=
    ld_cond_one_residue_chars_and_poly_lam F L ψ χ' hcond_L hSpecL
      ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, hval_add_L, hunit_ge1_L⟩
      k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
  have hc_L_val : valL F L ((tateElt F L χ' ψ : Lˣ) : L) = 1 + condExpChar F L ψ := by
    rw [hSpecL.2.2.2, hcond_L]
    norm_num
  have htate_L := ld_cond_one_tateEps_eq_residue_gauss_sum F L ψ χ' hcond_L hSpecL.2.2.2 hFinL
    ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, hval_add_L,
      hunit_ge1_L, hunit_val0_L⟩
    k_L resL hresL_0 hresL_1 hresL_ring hresL_ker hresL_surj
    (tateElt F L χ' ψ) hc_L_val χ_tilde ψ_tilde hχ_zero hχ_unit hψ_int
  obtain ⟨c_K', χ_tilde_K, ψ_tilde_K, hc_K'_val, hc_K'_χ, hχK_zero, hχK_unit, hψK_int, hK_prod⟩ :=
    ld_cond_one_extension_trace_norm_bridge F L K hLK hPrime ψ χ' hcond_L hcondChar_eq
      hval_norm hval_alg hSpecL hSpecK.1
      ⟨hval0_L, hval1_L, hval_mul_L, hval_inv_L⟩
      ⟨hval0_K, hval1_K, hval_mul_K, hval_inv_K⟩
      k_L k_K resL resK hfinrank_res hres_Fy
      χ_tilde ψ_tilde lam₁ hχ_zero hχ_one hχ_mul hχ_unit hψ_int hlam₁_def
  have htate_K := ld_cond_one_tateEps_eq_residue_gauss_sum F K (traceChar F hLK ψ)
    (χ'.comp (Units.map (normLM F hLK))) hcond_K hSpecK.2.2.2 hFinK
    ⟨hval0_K, hval1_K, hval_neg1_K, hval_neg_K, hval_mul_K, hval_inv_K, hval_add_K,
      hunit_ge1_K, hunit_val0_K⟩
    k_K resK hresK_0 hresK_1 hresK_ring hresK_ker hresK_surj
    c_K' hc_K'_val χ_tilde_K ψ_tilde_K hχK_zero hχK_unit hψK_int
  have hPoly := hPolyLift lam₁ hlam₁_1 hlam₁_mul (fun d hd2 _ => hlam₁_van d hd2)
  have hsum_K : (∑ b : k_K, χ_tilde_K b * ψ_tilde_K b) =
      (-1 : Ω F) ^ (Module.finrank k_L k_K - 1) *
        (∑ x : k_L, χ_tilde x * ψ_tilde x) ^ (Module.finrank k_L k_K) := by
    simp_rw [hK_prod, ← Finset.mul_sum, hPoly, hlam₁_lin, ← Finset.mul_sum, mul_pow]
    ring
  set ℓ := Module.finrank L (IntermediateField.extendScalars hLK)
  have hqL_pow : (qL F K : Ω F) ^ condExpChar F K (traceChar F hLK ψ) =
      ((qL F L : Ω F) ^ condExpChar F L ψ) ^ ℓ := by
    rw [hqL_eq, hcondChar_eq, Nat.cast_pow, ← zpow_natCast (qL F L : Ω F),
      ← zpow_natCast ((qL F L : Ω F) ^ condExpChar F L ψ), ← zpow_mul, ← zpow_mul,
      mul_comm (ℓ : ℤ)]
  rw [htate_K, htate_L, hsum_K, hfinrank_res, hqL_pow, hc_K'_χ, hcond_L, one_mul]
  ring

theorem ld_cond_ge_two_stationary_phase_sum_reduction (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M]
    (ψ_M : AddChar M (Ω F)) (χ_M : Mˣ →* (Ω F)ˣ)
    (hcond_ge2 : 2 ≤ condExp F M χ_M)
    (hSpecM : (∀ x : M, (x = 0 ∨ -condExpChar F M ψ_M ≤ valL F M x) → ψ_M x = 1) ∧
      (∃ x₁ : M, x₁ ≠ 0 ∧ -(condExpChar F M ψ_M + 1) ≤ valL F M x₁ ∧ ψ_M x₁ ≠ 1) ∧
      (condExp F M χ_M ≠ 0 →
        (∀ u ∈ unitGroup F M (condExp F M χ_M), χ_M u = 1) ∧
        (∃ u₀ ∈ unitGroup F M (condExp F M χ_M - 1), χ_M u₀ ≠ 1)) ∧
      valL F M ((tateElt F M χ_M ψ_M : Mˣ) : M) =
        (condExp F M χ_M : ℤ) + condExpChar F M ψ_M)
    (hFinM : Set.Finite {u : Mˣ ⧸ unitGroup F M (condExp F M χ_M) |
      valL F M ((cosetRep u : Mˣ) : M) = 0})
    (hvalM_props : valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ m : ℤ, ∃ c : Mˣ, valL F M (c : M) = m) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
      (∀ u : Mˣ, u ∈ unitGroup F M 0 ↔ valL F M (u : M) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) ∧
      (∀ (a : ℕ) (u : Mˣ), u ∈ unitGroup F M a → valL F M (u : M) = 0)) :
    (tateEps F M χ_M ψ_M ≠ 0 →
      ∃ c_M : Mˣ,
        valL F M (c_M : M) = (condExp F M χ_M : ℤ) + condExpChar F M ψ_M ∧
        ∀ w ∈ unitGroup F M (condExp F M χ_M - condExp F M χ_M / 2),
          (χ_M w : Ω F) = ψ_M (((c_M⁻¹ : Mˣ) : M) * ((w : M) - 1))) ∧
    (∀ c_M : Mˣ,
      valL F M (c_M : M) = (condExp F M χ_M : ℤ) + condExpChar F M ψ_M →
      (∀ w ∈ unitGroup F M (condExp F M χ_M - condExp F M χ_M / 2),
        (χ_M w : Ω F) = ψ_M (((c_M⁻¹ : Mˣ) : M) * ((w : M) - 1))) →
      tateEps F M χ_M ψ_M =
        (qL F M : Ω F) ^ condExpChar F M ψ_M * (χ_M c_M : Ω F) *
          ψ_M (((c_M⁻¹ : Mˣ) : M)) *
          (∑ u ∈ hFinM.toFinset.filter
              (fun u => cosetRep u ∈ unitGroup F M (condExp F M χ_M / 2)),
            ((χ_M (cosetRep u) : Ω F)⁻¹ *
              ψ_M (((c_M⁻¹ : Mˣ) : M) * (((cosetRep u : Mˣ) : M) - 1))))) :=
by
  classical
  obtain ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_surj, hval_add,
    hunit0, hunit_ge1, hunit_val0⟩ := hvalM_props
  set a : ℕ := condExp F M χ_M
  set d : ℕ := a / 2
  set e : ℕ := a - d
  set n : ℤ := condExpChar F M ψ_M
  set c_tate : Mˣ := tateElt F M χ_M ψ_M
  have ha_ne0 : a ≠ 0 := by omega
  have ha_ge1 : 1 ≤ a := by omega
  have hd_ge1 : 1 ≤ d := by omega
  have hd_le_a : d ≤ a := by omega
  have he_ge1 : 1 ≤ e := by omega
  have he_le_a : e ≤ a := by omega
  have hde_add : d + e = a := by omega
  have h2e_ge_a : a ≤ e + e := by omega
  obtain ⟨hψ_triv, ⟨x₁, hx₁_ne, hx₁_val, hx₁_ne1⟩, hχ_spec, htate_val⟩ := hSpecM
  have hχ_triv : ∀ u ∈ unitGroup F M a, χ_M u = 1 := (hχ_spec ha_ne0).1
  set U : Finset (Mˣ ⧸ unitGroup F M a) := hFinM.toFinset
  set H_d : Finset (Mˣ ⧸ unitGroup F M a) :=
    U.filter (fun u => cosetRep u ∈ unitGroup F M d)
  set H_e : Finset (Mˣ ⧸ unitGroup F M a) :=
    U.filter (fun h => cosetRep h ∈ unitGroup F M e)
  have hmem_U : ∀ u : Mˣ ⧸ unitGroup F M a,
      u ∈ U ↔ valL F M ((cosetRep u : Mˣ) : M) = 0 := by
    intro u
    simp [U, Set.Finite.mem_toFinset]
  have hout : ∀ u : Mˣ ⧸ unitGroup F M a,
      QuotientGroup.mk (s := unitGroup F M a) (cosetRep u) = u :=
    fun u => QuotientGroup.out_eq' u
  have hcoset_mk : ∀ x : Mˣ,
      x⁻¹ * cosetRep (QuotientGroup.mk (s := unitGroup F M a) x) ∈ unitGroup F M a := by
    intro x
    exact QuotientGroup.eq.mp (hout _).symm
  have hval_mk : ∀ x : Mˣ,
      valL F M ((cosetRep (QuotientGroup.mk (s := unitGroup F M a) x) : Mˣ) : M) =
        valL F M (x : M) := by
    intro x
    set r := cosetRep (QuotientGroup.mk (s := unitGroup F M a) x)
    set k := x⁻¹ * r
    have hk_val : valL F M (k : M) = 0 := hunit_val0 a k (hcoset_mk x)
    have hr_eq : (r : M) = (x : M) * (k : M) := by
      have : r = x * k := by simp [k]
      exact congrArg Units.val this
    rw [hr_eq, hval_mul (x : M) (k : M) (Units.ne_zero x) (Units.ne_zero k), hk_val, add_zero]
  have hχ_mk : ∀ x : Mˣ,
      χ_M (cosetRep (QuotientGroup.mk (s := unitGroup F M a) x)) = χ_M x := by
    intro x
    set r := cosetRep (QuotientGroup.mk (s := unitGroup F M a) x)
    set k := x⁻¹ * r
    have hk_χ : χ_M k = 1 := hχ_triv k (hcoset_mk x)
    have hr_eq : r = x * k := by simp [k]
    rw [hr_eq, map_mul, hk_χ, mul_one]
  have hU_mul : ∀ {v w : Mˣ ⧸ unitGroup F M a}, v ∈ U → w ∈ U → v * w ∈ U := by
    intro v w hv hw
    rw [hmem_U] at hv hw ⊢
    have hvw : v * w = QuotientGroup.mk (s := unitGroup F M a) (cosetRep v * cosetRep w) := by
      rw [QuotientGroup.mk_mul, hout, hout]
    rw [hvw, hval_mk (cosetRep v * cosetRep w), Units.val_mul,
      hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _), hv, hw, add_zero]
  have hU_inv : ∀ {v : Mˣ ⧸ unitGroup F M a}, v ∈ U → v⁻¹ ∈ U := by
    intro v hv
    rw [hmem_U] at hv ⊢
    have hvinv : v⁻¹ = QuotientGroup.mk (s := unitGroup F M a) (cosetRep v)⁻¹ := by
      rw [QuotientGroup.mk_inv, hout]
    rw [hvinv, hval_mk (cosetRep v)⁻¹, hval_inv (cosetRep v), hv, neg_zero]
  have hsub_unit : ∀ {k : ℕ}, 1 ≤ k → k ≤ a → unitGroup F M a ≤ unitGroup F M k := by
    intro k hk hka u hu
    rw [hunit_ge1 k hk]
    rcases (hunit_ge1 a ha_ge1 u).mp hu with hu1 | hua
    · exact Or.inl hu1
    · right; omega
  have hmem_unit_mk : ∀ {k : ℕ}, 1 ≤ k → k ≤ a → ∀ x : Mˣ,
      cosetRep (QuotientGroup.mk (s := unitGroup F M a) x) ∈ unitGroup F M k ↔
        x ∈ unitGroup F M k := by
    intro k hk hka x
    set r := cosetRep (QuotientGroup.mk (s := unitGroup F M a) x)
    set h := x⁻¹ * r
    have hh : h ∈ unitGroup F M k := hsub_unit hk hka (hcoset_mk x)
    have hr_eq : r = x * h := by simp [h]
    rw [hr_eq]
    exact Subgroup.mul_mem_cancel_right (unitGroup F M k) hh
  have hmem_Hd : ∀ u : Mˣ ⧸ unitGroup F M a,
      u ∈ H_d ↔ cosetRep u ∈ unitGroup F M d := by
    intro u
    rw [Finset.mem_filter, hmem_U]
    exact ⟨fun h => h.2, fun h => ⟨hunit_val0 d (cosetRep u) h, h⟩⟩
  have hmem_He : ∀ h : Mˣ ⧸ unitGroup F M a,
      h ∈ H_e ↔ cosetRep h ∈ unitGroup F M e := by
    intro h
    rw [Finset.mem_filter, hmem_U]
    exact ⟨fun hh => hh.2, fun hh => ⟨hunit_val0 e (cosetRep h) hh, hh⟩⟩
  have hHe_mk : ∀ w : Mˣ,
      QuotientGroup.mk (s := unitGroup F M a) w ∈ H_e ↔ w ∈ unitGroup F M e := by
    intro w
    rw [hmem_He, hmem_unit_mk he_ge1 he_le_a]
  have hHe_one : (1 : Mˣ ⧸ unitGroup F M a) ∈ H_e :=
    (hHe_mk 1).mpr (one_mem _)
  have hHe_mul : ∀ {h₁ h₂ : Mˣ ⧸ unitGroup F M a}, h₁ ∈ H_e → h₂ ∈ H_e → h₁ * h₂ ∈ H_e := by
    intro h₁ h₂ hh₁ hh₂
    rw [hmem_He] at hh₁ hh₂ ⊢
    have hmul : h₁ * h₂ = QuotientGroup.mk (s := unitGroup F M a) (cosetRep h₁ * cosetRep h₂) := by
      rw [QuotientGroup.mk_mul, hout, hout]
    rw [hmul, hmem_unit_mk he_ge1 he_le_a]
    exact mul_mem hh₁ hh₂
  have hHe_inv : ∀ {h : Mˣ ⧸ unitGroup F M a}, h ∈ H_e → h⁻¹ ∈ H_e := by
    intro h hh
    rw [hmem_He] at hh ⊢
    have hinv : h⁻¹ = QuotientGroup.mk (s := unitGroup F M a) (cosetRep h)⁻¹ := by
      rw [QuotientGroup.mk_inv, hout]
    rw [hinv, hmem_unit_mk he_ge1 he_le_a]
    exact inv_mem hh
  have hHe_sub_U : ∀ {h : Mˣ ⧸ unitGroup F M a}, h ∈ H_e → h ∈ U :=
    fun hh => (Finset.mem_filter.mp hh).1
  have hHe_card_pos : 0 < H_e.card := Finset.card_pos.mpr ⟨1, hHe_one⟩
  have hHe_card_ne : (H_e.card : Ω F) ≠ 0 := Nat.cast_ne_zero.mpr hHe_card_pos.ne'
  let T : Mˣ → (Mˣ ⧸ unitGroup F M a) → Ω F := fun c u =>
    (χ_M (c⁻¹ * cosetRep u) : Ω F)⁻¹ * ψ_M (((c⁻¹ * cosetRep u : Mˣ) : M))
  let Δ : Mˣ → (Mˣ ⧸ unitGroup F M a) → (Mˣ ⧸ unitGroup F M a) → Ω F := fun c u h =>
    (χ_M (cosetRep h) : Ω F)⁻¹ *
      ψ_M (((c⁻¹ * cosetRep u : Mˣ) : M) * (((cosetRep h : Mˣ) : M) - 1))
  have htate_sum : tateEps F M χ_M ψ_M =
      (qL F M : Ω F) ^ n * ∑ u ∈ U, T c_tate u := by
    dsimp only [tateEps, a, n, c_tate, T]
    rw [if_neg ha_ne0]
    congr 1
    exact finsum_mem_eq_finite_toFinset_sum
      (fun u => (χ_M (c_tate⁻¹ * cosetRep u) : Ω F)⁻¹ *
        ψ_M (((c_tate⁻¹ * cosetRep u : Mˣ) : M))) hFinM
  have hψ_z_triv : ∀ (z y : M), z ≠ 0 → valL F M z = -((a : ℤ) + n) →
      (y = 0 ∨ (a : ℤ) ≤ valL F M y) → ψ_M (z * y) = 1 := by
    intro z y hz_ne hz_val hy
    apply hψ_triv (z * y)
    rcases hy with rfl | hy_ge
    · left; exact mul_zero z
    · by_cases hy0 : y = 0
      · left; rw [hy0, mul_zero]
      · right; rw [hval_mul z y hz_ne hy0, hz_val]; omega
  have hcr_val : ∀ {c r : Mˣ}, valL F M (c : M) = (a : ℤ) + n → valL F M (r : M) = 0 →
      valL F M ((c⁻¹ * r : Mˣ) : M) = -((a : ℤ) + n) := by
    intro c r hc hr
    rw [Units.val_mul, hval_mul _ _ (Units.ne_zero _) (Units.ne_zero _),
      hval_inv c, hc, hr, add_zero]
  have hT_mk : ∀ {c : Mˣ}, valL F M (c : M) = (a : ℤ) + n →
      ∀ (r : Mˣ), valL F M (r : M) = 0 →
      T c (QuotientGroup.mk (s := unitGroup F M a) r) =
        (χ_M (c⁻¹ * r) : Ω F)⁻¹ * ψ_M (((c⁻¹ * r : Mˣ) : M)) := by
    intro c hc r hr
    dsimp only [T]
    set u := QuotientGroup.mk (s := unitGroup F M a) r
    set r_u := cosetRep u
    set k := r⁻¹ * r_u
    have hk_mem : k ∈ unitGroup F M a := hcoset_mk r
    have hχ_eq : χ_M (c⁻¹ * r_u) = χ_M (c⁻¹ * r) := by
      rw [map_mul, map_mul, hχ_mk r]
    have hr_u_eq : (r_u : M) = (r : M) * (k : M) := by
      have : r_u = r * k := by simp [k]
      exact congrArg Units.val this
    have hψ_arg : ((c⁻¹ * r_u : Mˣ) : M) =
        ((c⁻¹ * r : Mˣ) : M) + ((c⁻¹ * r : Mˣ) : M) * ((k : M) - 1) := by
      simp only [Units.val_mul, hr_u_eq]
      ring
    have hk_val : (k : M) - 1 = 0 ∨ (a : ℤ) ≤ valL F M ((k : M) - 1) := by
      rcases (hunit_ge1 a ha_ge1 k).mp hk_mem with hk1 | hka
      · left; rw [hk1, sub_self]
      · right; exact hka
    have hψ_eq : ψ_M (((c⁻¹ * r_u : Mˣ) : M)) = ψ_M (((c⁻¹ * r : Mˣ) : M)) := by
      rw [hψ_arg, AddChar.map_add_eq_mul,
        hψ_z_triv ((c⁻¹ * r : Mˣ) : M) ((k : M) - 1) (Units.ne_zero _) (hcr_val hc hr) hk_val,
        mul_one]
    rw [hχ_eq, hψ_eq]
  have hΔ_mk : ∀ {c : Mˣ}, valL F M (c : M) = (a : ℤ) + n →
      ∀ {u : Mˣ ⧸ unitGroup F M a}, u ∈ U →
      ∀ (w : Mˣ), valL F M (w : M) = 0 →
      Δ c u (QuotientGroup.mk (s := unitGroup F M a) w) =
        (χ_M w : Ω F)⁻¹ *
          ψ_M (((c⁻¹ * cosetRep u : Mˣ) : M) * ((w : M) - 1)) := by
    intro c hc u hu w hw
    dsimp only [Δ]
    set r_w := cosetRep (QuotientGroup.mk (s := unitGroup F M a) w)
    set k := w⁻¹ * r_w
    have hk_mem : k ∈ unitGroup F M a := hcoset_mk w
    have hr_w_eq : (r_w : M) = (w : M) * (k : M) := by
      have : r_w = w * k := by simp [k]
      exact congrArg Units.val this
    set z : M := ((c⁻¹ * cosetRep u : Mˣ) : M)
    set y : M := (w : M) * ((k : M) - 1)
    have harg : z * ((r_w : M) - 1) = z * ((w : M) - 1) + z * y := by
      dsimp only [y]
      rw [hr_w_eq]
      ring
    have hy_val : y = 0 ∨ (a : ℤ) ≤ valL F M y := by
      rcases (hunit_ge1 a ha_ge1 k).mp hk_mem with hk1 | hka
      · left; dsimp only [y]; rw [hk1, sub_self, mul_zero]
      · by_cases hk0 : (k : M) - 1 = 0
        · left; dsimp only [y]; rw [hk0, mul_zero]
        · right
