  have hχE'_cond_self : ∀ u ∈ unitGroup F E (condExp F E χE'), χE' u = 1 := by
    have h0 : ∀ u ∈ unitGroup F E (condExp F E (ξE ^ 0 * χE')), (ξE ^ 0 * χE') u = 1 :=
