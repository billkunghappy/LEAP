          ∃ w_k : E',
            (w_k = 0 ∨ -(k : ℤ) ≤ valL F E' w_k) ∧
            (Y + (j : E') * (w_k ^ p - w_k) = 0 ∨
              -((p * k : ℕ) : ℤ) + 1 ≤ valL F E' (Y + (j : E') * (w_k ^ p - w_k)))) ∧
      (∀ (j : ℕ), 0 < j → j < p →
        ∀ (σ : E' ≃ₐ[F] E'),
          (∀ x : L, σ (IntermediateField.inclusion hLE' x) = IntermediateField.inclusion hLE' x) →
          (∃ y : E', σ y ≠ y) →
          ∀ (ϖ_E' : E'ˣ), valL F E' (ϖ_E' : E') = 1 →
            let x_star := (σ (ϖ_E' : E')) * ((ϖ_E'⁻¹ : E'ˣ) : E') - 1
            ∀ Y₁ : E', (Y₁ = 0 ∨ 0 ≤ valL F E' Y₁) →
              ψE' (IntermediateField.inclusion hLE' α₀ * Y₁ * (2 * x_star - x_star ^ 2)) = 1 →
              ∃ w_zero : E',
                (w_zero = 0 ∨ 0 ≤ valL F E' w_zero) ∧
                (Y₁ + (j : E') * (w_zero ^ p - w_zero) = 0 ∨
                  1 ≤ valL F E' (Y₁ + (j : E') * (w_zero ^ p - w_zero)))) ∧
      (∀ (j : ℕ), 0 < j → j < p →
        ∀ Y' : E', (Y' = 0 ∨ 1 ≤ valL F E' Y') →
          ∃ w_high : E',
            (w_high = 0 ∨ 1 ≤ valL F E' w_high) ∧
            (Y' + (j : E') * (w_high ^ p - w_high) = 0 ∨
              (bE' : ℤ) ≤ valL F E' (Y' + (j : E') * (w_high ^ p - w_high))))) :
    let p := Module.finrank L (IntermediateField.extendScalars hLE')
    let bE' := condExp F L νE'
    let bM₁' := condExp F L νM₁'
    let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
    let m₂ := bE' + bM₁' - 1
    let d₂ := m₂ / 2
    let α₀ := ((c_νE'⁻¹ : Lˣ) : L)
    let ψE' := traceChar F hLE' ψ
    ∃ (j : ℕ) (Δ' : K₁ˣ),
      0 < j ∧ j < p ∧
      valL F K₁ (Δ' : K₁) = -((bM₁' - 1 : ℕ) : ℤ) ∧
      ((Δ' : K₁) ^ p - (Δ' : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ' : K₁)) = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤
          valL F K₁ ((Δ' : K₁) ^ p - (Δ' : K₁) -
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ' : K₁)))) ∧
      (∀ x : E', (x = 0 ∨ (d₂ : ℤ) ≤ valL F E' x) →
        ∀ hx : 1 + x ≠ 0,
          (χ₂ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
            ψE' (- IntermediateField.inclusion hLE' α₀ * (j : E') *
              normLM F hE'K₁ (Δ' : K₁) * (2 * x - x ^ 2))) :=
by
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  set bE' := condExp F L νE'
  set bM₁' := condExp F L νM₁'
  set t₁ := bM₁' - 1
  set t₂ := bE' - 1
  set m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
  set m₂ := bE' + bM₁' - 1
  set d₁ := m₁ / 2
  set d₂ := m₂ / 2
  set α₀ := ((c_νE'⁻¹ : Lˣ) : L)
  set ψE' := traceChar F hLE' ψ
  set ψM₁' := traceChar F hLM₁' ψ
  set ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
  have hp_pos : 0 < p := hPrime.pos
  have hp_gt1 : 1 < p := hPrime.one_lt
  have hp_odd' : p ≠ 2 := hWild ▸ hp_odd

  have hvalL_props := ld_valL_and_unitGroup_props F L
  have hvalE'_props := ld_valL_and_unitGroup_props F E'
  have hvalM₁'_props := ld_valL_and_unitGroup_props F M₁'
  have hvalK₁_props := ld_valL_and_unitGroup_props F K₁
  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L,
    _, hval_add_L, _, _, _⟩ := ld_valL_and_unitGroup_props F L
  obtain ⟨hval0_E', hval1_E', hval_neg1_E', hval_neg_E', hval_mul_E', hval_inv_E',
    _, hval_add_E', _, _, _⟩ := ld_valL_and_unitGroup_props F E'

  obtain ⟨hψE'_triv, ⟨x₁, hx₁_ne0, hx₁_val, hx₁_ψ⟩, _, _⟩ :=
    ld_condExp_and_condExpChar_spec F E' ψE' hψE' 1

  obtain ⟨ϖ_E', _, _, hϖ_E', _, hBasis_E'⟩ :=
    ld_ch14_wild_prime_power_basis F L E' hLE' hp_pos hval_norm_LE' hval_LE'

  have hdeg_p : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) = p := hdegM₁'K₁
  have hp_pos_M₁'K₁ : 0 < Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) := by
    rw [hdeg_p]
    exact hp_pos
  have hval_M₁'K₁' : ∀ z : M₁',
      valL F K₁ (IntermediateField.inclusion hM₁'K₁ z) =
        (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) : ℤ) * valL F M₁' z := by
    intro z
    rw [hdeg_p]
    exact hval_M₁'K₁ z
  obtain ⟨ϖ_K₁, _, _, hϖ_K₁, _, hBasis_K₁_raw⟩ :=
    ld_ch14_wild_prime_power_basis F M₁' K₁ hM₁'K₁ hp_pos_M₁'K₁ hval_norm_M₁'K₁ hval_M₁'K₁'
  have hBasis_K₁ : ∀ w : K₁, ∃ c : Fin p → M₁',
      w = ∑ i : Fin p, IntermediateField.inclusion hM₁'K₁ (c i) * ((ϖ_K₁ : K₁) ^ (i : ℕ)) ∧
      ∀ m : ℤ,
        (w = 0 ∨ m ≤ valL F K₁ w) ↔
          ∀ i : Fin p, c i = 0 ∨ m ≤ (p : ℤ) * valL F M₁' (c i) + (i : ℤ) := by
    rw [← hdeg_p]
    exact hBasis_K₁_raw

  have hνE'_triv : ∀ u ∈ unitGroup F L (condExp F L νE'), νE' u = 1 := by
    intro u hu
    have hpow1 : νE' ^ 1 = νE' := MonoidHom.ext fun x => pow_one (νE' x)
    have h1 := hνE'_cond 1 hp_gt1
    rw [hpow1] at h1
    exact h1 u hu
  have hνE'_norm : ∀ y : E'ˣ, νE' (Units.map (normLM F hLE') y) = 1 := by
    intro y
    exact (hνE'_ker (Units.map (normLM F hLE') y)).mp ⟨y, rfl⟩
  obtain ⟨u₂, G_E', instGroupGE', instFintypeGE', act_E', y₁_E',
    hu₂_ge1, hcard_GE', hactE'_one, hactE'_mul, hactE'_ring,
    hactE'_incl, hactE'_val, hactE'_trace, hactE'_norm, hjump_E'_raw,
    hy₁E'_tr, hy₁E'_ne0, hy₁E'_val_raw, _, hnE'_u₂, _, _, _⟩ :=
    ld_wild_tot_ram_jump_trace_cond_and_norm_filtration F L E' hLE' hGalLE'
      hPrime hWild hval_norm_LE' hval_LE' ϖ_E' hϖ_E' hBasis_E'
      ψ hψ νE' hνE'_triv hνE'_norm
  letI : Group G_E' := instGroupGE'
  letI : Fintype G_E' := instFintypeGE'
  have hu₂_eq : u₂ = t₂ := by
    have heq : (p : ℤ) * condExpChar F L ψ + ((p - 1 : ℕ) : ℤ) * ((u₂ + 1 : ℕ) : ℤ) =
        (p : ℤ) * condExpChar F L ψ + ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) :=
      hnE'_u₂.symm.trans hnE'_eq
    have hmul_eq : ((p - 1 : ℕ) : ℤ) * ((u₂ + 1 : ℕ) : ℤ) =
        ((p - 1 : ℕ) : ℤ) * (bE' : ℤ) := by linarith
    have hp_sub1_ne : ((p - 1 : ℕ) : ℤ) ≠ 0 := by omega
    have hu₂_add1 : ((u₂ + 1 : ℕ) : ℤ) = (bE' : ℤ) :=
      mul_left_cancel₀ hp_sub1_ne hmul_eq
    omega
  have hjump_E' : ∀ τ : G_E', τ ≠ 1 →
      (ϖ_E' : E') - act_E' τ (ϖ_E' : E') ≠ 0 ∧
      valL F E' ((ϖ_E' : E') - act_E' τ (ϖ_E' : E')) = (bE' : ℤ) := by
    intro τ hτ
    obtain ⟨hne, hval⟩ := hjump_E'_raw τ hτ
    refine ⟨hne, ?_⟩
    have hbE'_eq : (u₂ + 1 : ℤ) = (bE' : ℤ) := by omega
    exact hval.trans hbE'_eq

  have hPrime_M₁'K₁ : Nat.Prime (Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁)) := by
    rw [hdeg_p]
    exact hPrime
  have hWild_M₁'K₁ :
      Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) = EllipticRootNumber.p F := by
    rw [hdeg_p]
    exact hWild
  have hξM₁'_norm : ∀ w : K₁ˣ, ξM₁' (Units.map (normLM F hM₁'K₁) w) = 1 := by
    intro w
    change νE' (Units.map (normLM F hLM₁') (Units.map (normLM F hM₁'K₁) w)) = 1
    rw [← hνE'_ker]
    refine ⟨Units.map (normLM F hE'K₁) w, ?_⟩
    exact Units.ext ((hTowerNormTr (w : K₁)).1)
  obtain ⟨u₁, _, _, _, _, _,
    _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, hcond_le_u₁, _, hσ_lift_filt_raw⟩ :=
    ld_wild_tot_ram_jump_trace_cond_and_norm_filtration F M₁' K₁ hM₁'K₁ hGalM₁'K₁
      hPrime_M₁'K₁ hWild_M₁'K₁ hval_norm_M₁'K₁ hval_M₁'K₁' ϖ_K₁ hϖ_K₁ hBasis_K₁_raw
      ψM₁' hψM₁' ξM₁' hξM₁'_triv hξM₁'_norm
  have hd₁_le_u₁ : d₁ ≤ u₁ := by
    have hcond_eq : condExp F M₁' ξM₁' = bM₁' + p * (bE' - bM₁') := hξM₁'_cond
    omega
  have hσ_lift_filt : ∀ σ_lift : K₁ ≃ₐ[F] K₁,
      (∀ z : M₁', σ_lift (IntermediateField.inclusion hM₁'K₁ z) =
        IntermediateField.inclusion hM₁'K₁ z) →
      (∃ w₀ : K₁, σ_lift w₀ ≠ w₀) →
      (Units.map σ_lift.toRingEquiv.toMonoidHom ϖ_K₁) * ϖ_K₁⁻¹ ∈ unitGroup F K₁ d₁ := by
    intro σ_lift hσ_M₁' hσ_ne
    exact hσ_lift_filt_raw σ_lift hσ_M₁' hσ_ne d₁ hd₁_le_u₁

  obtain ⟨hp_valE'_raw, _, hConstApprox_E'_raw⟩ :=
    ld_wild_tot_ram_const_free_jump_shift_and_telescoping F L E' hLE' p hPrime u₂ hu₂_ge1
      ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L, hval_add_L⟩
      ⟨hval0_E', hval1_E', hval_neg1_E', hval_neg_E', hval_mul_E', hval_inv_E', hval_add_E'⟩
      hval_LE' ϖ_E' G_E' act_E' y₁_E' hϖ_E' hBasis_E' hcard_GE'
      hactE'_one hactE'_mul hactE'_ring hactE'_incl hactE'_val hactE'_trace
      hjump_E'_raw hy₁E'_tr hy₁E'_ne0 hy₁E'_val_raw
  have hp_valE' : ((p : ℕ) : E') = 0 ∨ (1 : ℤ) ≤ valL F E' ((p : ℕ) : E') := by
    rcases hp_valE'_raw with h0 | hge
    · exact Or.inl h0
    · right
      have hge1 : 1 ≤ (p - 1) * u₂ := Nat.mul_pos (by omega) hu₂_ge1
      exact le_trans (by exact_mod_cast hge1) hge
  have hConstApprox_E' : ∀ (w : E') (τ : G_E') (M : ℤ),
      τ ≠ 1 →
      (act_E' τ w - w = 0 ∨ M + (t₂ : ℤ) ≤ valL F E' (act_E' τ w - w)) →
      ∃ c₀ : L,
        w - IntermediateField.inclusion hLE' c₀ = 0 ∨
          M ≤ valL F E' (w - IntermediateField.inclusion hLE' c₀) := by
    rw [← hu₂_eq]
    exact hConstApprox_E'_raw

  obtain ⟨hτ₀_exists, hψE'_α₀_triv, hσ_props, hσ_lift_props⟩ :=
    ld_wild_odd_tot_ram_galois_aut_coboundary_and_nondiv_upgrade F L E' M₁' K₁
      hLE' hM₁'K₁ p hPrime hp_odd' rfl hdegM₁'K₁
      bE' bM₁' hbE'_ge2 hbM₁'_ge2 hb_le hp_valE'
      hvalL_props hvalE'_props hvalM₁'_props hvalK₁_props
      hval_LE' hval_M₁'K₁
      ψ c_νE' hc_νE'_val hnE'_eq hψE'_triv
      x₁ hx₁_ne0 hx₁_val hx₁_ψ
      ϖ_E' hϖ_E' hBasis_E'
      G_E' act_E' hcard_GE' hactE'_one hactE'_mul hactE'_ring
      hactE'_incl hactE'_val hactE'_trace hactE'_norm hjump_E' hConstApprox_E'
      ϖ_K₁ hϖ_K₁ hBasis_K₁ hσ_lift_filt

  obtain ⟨hB₂_val, j, σ, hj_pos, hj_lt, hσ_L, hσ_ne, hY₀_coboundary⟩ :=
    ld_wild_odd_tot_ram_coboundary_char_and_twist_exp_exists F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hPrime ψ νE' νM₁'
      hbE'_ge2 hbM₁'_ge2 hb_le ht₁_ndvd hnE'_eq
      hvalE'_props hval_LE' hGalLift_E'
      χ₂ hχ₂_twists c_νE' hc_νE'_val c₂₀ hc₂₀_val hc₂₀_stat
      Δ₀ hModelCompat_Δ₀ hCoker_E'
      hτ₀_exists hψE'_α₀_triv hσ_props hσ_lift_props

  obtain ⟨_, hσ_w_t₂, _, hσ_nondiv_ex⟩ := hσ_props σ hσ_L
  have hσ_w_prop : ∀ y : E'ˣ,
      let w_y := ((((Units.map σ.toRingEquiv.toMonoidHom y) * y⁻¹ : E'ˣ) : E')) - 1
      (w_y = 0 ∨ (d₂ : ℤ) ≤ valL F E' w_y) ∧
      normLM F hLE' (1 + w_y) - 1 = 0 := by
    intro y
    obtain ⟨hw_val, hw_norm⟩ := hσ_w_t₂ y
    refine ⟨?_, hw_norm⟩
    rcases hw_val with h0 | hge
    · exact Or.inl h0
    · right
      have hd₂_le_t₂ : (d₂ : ℤ) ≤ (t₂ : ℤ) := by omega
      exact le_trans hd₂_le_t₂ hge

  have hσ_nondiv_upgrade : ∀ (r : ℕ), 1 ≤ r → ¬ (p ∣ r) →
      ∀ Y : E', (Y = 0 ∨ -(r : ℤ) ≤ valL F E' Y) →
        (∀ u₁ ∈ unitGroup F E' r,
          let w₁ := ((((Units.map σ.toRingEquiv.toMonoidHom u₁) * u₁⁻¹ : E'ˣ) : E')) - 1
          ψE' (IntermediateField.inclusion hLE' α₀ * Y * (2 * w₁ - w₁ ^ 2)) = 1) →
        (Y = 0 ∨ -(r : ℤ) + 1 ≤ valL F E' Y) := by
    intro r hr_ge1 hndvd Y hY hall
    by_contra hnot
    obtain ⟨u₁, hu₁, hne1, _⟩ := hσ_nondiv_ex hσ_ne r hr_ge1 hndvd Y hY hnot
    exact hne1 (hall u₁ hu₁)

  obtain ⟨Δ', hΔ'_val, hΔ'_as, hΔ'_stat⟩ :=
    ld_wild_odd_tot_ram_as_peeling_descent_and_shift_realization F L E' K₁
      hLE' hE'K₁ hPrime hp_odd' ψ νE' νM₁'
      hbE'_ge2 hbM₁'_ge2 hb_le ht₁_ndvd hp_valK₁
      hvalE'_props hval_E'K₁ χ₂ c_νE' c₂₀ hc₂₀_stat
      Δ₀ hModelCompat_Δ₀.1 hAS_shift hShift_E' hψE'_α₀_triv
      ϖ_E' hϖ_E' j σ hj_pos hj_lt hσ_L hσ_ne
      hσ_w_prop hσ_nondiv_upgrade hB₂_val hY₀_coboundary

  exact ⟨j, Δ', hj_pos, hj_lt, hΔ'_val, hΔ'_as, hΔ'_stat⟩

theorem ld_ch12_wild_odd_totally_ramified_second_branch_conjugation_and_match_scaled (F : Type u) [Field F]
    [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hPrime : Nat.Prime (Module.finrank L (IntermediateField.extendScalars hLE')))
    (hWild : Module.finrank L (IntermediateField.extendScalars hLE') = p F)
    (hp_odd : p F ≠ 2)
    (ψ : AddChar L (Ω F)) (hψ : IsAdmissibleChar F L ψ)
    (hψE' : IsAdmissibleChar F E' (traceChar F hLE' ψ))
    (hψM₁' : IsAdmissibleChar F M₁' (traceChar F hLM₁' ψ))
    (νE' νM₁' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hbM₁'_ge2 : 2 ≤ condExp F L νM₁')
    (hb_le : condExp F L νM₁' ≤ condExp F L νE')
    (hnE'_eq : condExpChar F E' (traceChar F hLE' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          (condExp F L νE' : ℤ))
    (hnM₁'_eq : condExpChar F M₁' (traceChar F hLM₁' ψ) =
      (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * condExpChar F L ψ +
        ((Module.finrank L (IntermediateField.extendScalars hLE') - 1 : ℕ) : ℤ) *
          (condExp F L νM₁' : ℤ))
    (hval_LE' : ∀ x : L,
      valL F E' (IntermediateField.inclusion hLE' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hval_LM₁' : ∀ x : L,
      valL F M₁' (IntermediateField.inclusion hLM₁' x) =
        (Module.finrank L (IntermediateField.extendScalars hLE') : ℤ) * valL F L x)
    (hGalLift : ∀ τ : M₁' ≃ₐ[F] M₁',
      (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) →
      ∃ τ_lift : K₁ ≃ₐ[F] K₁,
        (∀ y : E', τ_lift (IntermediateField.inclusion hE'K₁ y) =
          IntermediateField.inclusion hE'K₁ y) ∧
        (∀ z : M₁', τ_lift (IntermediateField.inclusion hM₁'K₁ z) =
          IntermediateField.inclusion hM₁'K₁ (τ z)) ∧
        (∀ w : K₁, valL F K₁ (τ_lift w) = valL F K₁ w) ∧
        (∀ w : K₁,
          normLM F hE'K₁ (τ_lift w) = normLM F hE'K₁ w ∧
          normLM F hM₁'K₁ (τ_lift w) = τ (normLM F hM₁'K₁ w)))
    (χ₁ : M₁'ˣ →* (Ω F)ˣ) (χ₂ : E'ˣ →* (Ω F)ˣ)
    (hχ_comp : χ₂.comp (Units.map (normLM F hE'K₁)) = χ₁.comp (Units.map (normLM F hM₁'K₁)))
    (hχ_rest : ∀ x : Lˣ,
      χ₂ (Units.map (IntermediateField.inclusion hLE').toMonoidHom x) =
        χ₁ (Units.map (IntermediateField.inclusion hLM₁').toMonoidHom x))
    (hχ₁_twists : ∀ j < Module.finrank L (IntermediateField.extendScalars hLE'),
      let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
      let m₁ := 2 * condExp F L νM₁' - 1 +
        Module.finrank L (IntermediateField.extendScalars hLE') *
          (condExp F L νE' - condExp F L νM₁')
      condExp F M₁' (ξM₁' ^ j * χ₁) = m₁ ∧
      (∀ u ∈ unitGroup F M₁' m₁, (ξM₁' ^ j * χ₁) u = 1) ∧
      ∃ τ : M₁' ≃ₐ[F] M₁',
        (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) ∧
        ∀ z : M₁'ˣ, (ξM₁' ^ j * χ₁) z = χ₁ (Units.map τ.toRingEquiv.toMonoidHom z))
    (c_νE' : Lˣ)
    (hc_νE'_val : valL F L (c_νE' : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hc_νE'_stat : ∀ u : L, (u = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L u) →
      ∀ hu : 1 + u ≠ 0,
        (νE' (Units.mk0 (1 + u) hu) : Ω F) ^ 2 =
          ψ (((c_νE'⁻¹ : Lˣ) : L) * (2 * u - u ^ 2)))
    (c₁₀ : M₁'ˣ)
    (hc₁₀_val : valL F M₁' (c₁₀ : M₁') =
      ((2 * condExp F L νM₁' - 1 +
        Module.finrank L (IntermediateField.extendScalars hLE') *
          (condExp F L νE' - condExp F L νM₁') : ℕ) : ℤ) +
        condExpChar F M₁' (traceChar F hLM₁' ψ))
    (hc₁₀_stat : ∀ z : M₁',
      (z = 0 ∨ (((2 * condExp F L νM₁' - 1 +
        Module.finrank L (IntermediateField.extendScalars hLE') *
          (condExp F L νE' - condExp F L νM₁')) / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
      ∀ hz : 1 + z ≠ 0,
        (χ₁ (Units.mk0 (1 + z) hz) : Ω F) ^ 2 =
          (traceChar F hLM₁' ψ) (((c₁₀⁻¹ : M₁'ˣ) : M₁') * (2 * z - z ^ 2)))
    (hModelCompat_all : ∀ Δ : K₁ˣ,
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let bM₁' := condExp F L νM₁'
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      let m₂ := bE' + bM₁' - 1
      let d₁ := m₁ / 2
      let d₂ := m₂ / 2
      valL F K₁ (Δ : K₁) = -((bM₁' - 1 : ℕ) : ℤ) →
      ((Δ : K₁) ^ p - (Δ : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)) = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤
          valL F K₁ ((Δ : K₁) ^ p - (Δ : K₁) -
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ : K₁)))) →
      (valL F E' (normLM F hE'K₁ (Δ : K₁)) = -((bM₁' - 1 : ℕ) : ℤ) ∧
       valL F M₁' (normLM F hM₁'K₁ (Δ : K₁)) = -((bM₁' - 1 : ℕ) : ℤ) ∧
       (∀ w : K₁, ∃ Y : Fin p → E',
         w = ∑ i : Fin p, IntermediateField.inclusion hE'K₁ (Y i) * ((Δ : K₁) ^ (i : ℕ)) ∧
         ∀ m : ℤ,
           (w = 0 ∨ m ≤ valL F K₁ w) ↔
             ∀ i : Fin p,
               Y i = 0 ∨ m ≤ (p : ℤ) * valL F E' (Y i) - (i : ℤ) * ((bM₁' - 1 : ℕ) : ℤ)) ∧
       (traceLM F hLM₁' (normLM F hM₁'K₁ (Δ : K₁)) -
         traceLM F hLE' (normLM F hE'K₁ (Δ : K₁)) = 0 ∨
         (bE' : ℤ) ≤
           valL F L (traceLM F hLM₁' (normLM F hM₁'K₁ (Δ : K₁)) -
             traceLM F hLE' (normLM F hE'K₁ (Δ : K₁)))) ∧
       ∀ c_νE' : Lˣ,
         valL F L (c_νE' : L) = (bE' : ℤ) + condExpChar F L ψ →
         (∀ u : L, (u = 0 ∨ ((bE' / 2 : ℕ) : ℤ) ≤ valL F L u) →
           ∀ hu : 1 + u ≠ 0,
             (νE' (Units.mk0 (1 + u) hu) : Ω F) ^ 2 =
               ψ (((c_νE'⁻¹ : Lˣ) : L) * (2 * u - u ^ 2))) →
         ∀ w : K₁, (w = 0 ∨ (d₁ : ℤ) ≤ valL F K₁ w) →
           let u₁ := normLM F hM₁'K₁ (1 + w) - 1
           let u₂ := normLM F hE'K₁ (1 + w) - 1
           (u₁ = 0 ∨ (d₁ : ℤ) ≤ valL F M₁' u₁) ∧
           (u₂ = 0 ∨ (d₂ : ℤ) ≤ valL F E' u₂) ∧
           (traceChar F hLM₁' ψ) (IntermediateField.inclusion hLM₁' (((c_νE'⁻¹ : Lˣ) : L)) *
             normLM F hM₁'K₁ (Δ : K₁) * (2 * u₁ - u₁ ^ 2)) =
           (traceChar F hLE' ψ) (IntermediateField.inclusion hLE' (((c_νE'⁻¹ : Lˣ) : L)) *
             normLM F hE'K₁ (Δ : K₁) * (2 * u₂ - u₂ ^ 2))))
    (hCoker_M₁' :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let bE' := condExp F L νE'
      let bM₁' := condExp F L νM₁'
      let m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
      let d₁ := m₁ / 2
      let ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
      ∀ (Φ : M₁'ˣ → (Ω F)ˣ),
        (∀ u₁ ∈ unitGroup F M₁' d₁, ∀ u₂ ∈ unitGroup F M₁' d₁, Φ (u₁ * u₂) = Φ u₁ * Φ u₂) →
        (∀ u ∈ unitGroup F M₁' m₁, Φ u = 1) →
        (∀ w ∈ unitGroup F K₁ d₁, Φ (Units.map (normLM F hM₁'K₁) w) = 1) →
        ∃ r < p, ∀ u ∈ unitGroup F M₁' d₁, Φ u = ((ξM₁' ^ 2) u) ^ r)
    (j : ℕ) (Δ' : K₁ˣ) (hj_pos : 0 < j)
    (hj_lt : j < Module.finrank L (IntermediateField.extendScalars hLE'))
    (hΔ'_val : valL F K₁ (Δ' : K₁) = -((condExp F L νM₁' - 1 : ℕ) : ℤ))
    (hΔ'_as :
      let p := Module.finrank L (IntermediateField.extendScalars hLE')
      let m₁ := 2 * condExp F L νM₁' - 1 + p * (condExp F L νE' - condExp F L νM₁')
      (Δ' : K₁) ^ p - (Δ' : K₁) -
        IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ' : K₁)) = 0 ∨
        ((4 * p * p * m₁ : ℕ) : ℤ) ≤
          valL F K₁ ((Δ' : K₁) ^ p - (Δ' : K₁) -
            IntermediateField.inclusion hE'K₁ (normLM F hE'K₁ (Δ' : K₁))))
    (hΔ'_stat₂ :
      let bE' := condExp F L νE'
      let bM₁' := condExp F L νM₁'
      let m₂ := bE' + bM₁' - 1
      let d₂ := m₂ / 2
      let α₀ := ((c_νE'⁻¹ : Lˣ) : L)
      let ψE' := traceChar F hLE' ψ
      ∀ x : E', (x = 0 ∨ (d₂ : ℤ) ≤ valL F E' x) →
        ∀ hx : 1 + x ≠ 0,
          (χ₂ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
            ψE' (- IntermediateField.inclusion hLE' α₀ * (j : E') *
              normLM F hE'K₁ (Δ' : K₁) * (2 * x - x ^ 2))) :
    let ℓ := Module.finrank L (IntermediateField.extendScalars hLE')
    let bE' := condExp F L νE'
    let bM₁' := condExp F L νM₁'
    let m₁ := 2 * bM₁' - 1 + ℓ * (bE' - bM₁')
    let m₂ := bE' + bM₁' - 1
    let ψE' := traceChar F hLE' ψ
    let ψM₁' := traceChar F hLM₁' ψ
    ∃ (cE' : E'ˣ) (cM₁' : M₁'ˣ),
      valL F E' (cE' : E') = (m₂ : ℤ) + condExpChar F E' ψE' ∧
      (∀ x : E', (x = 0 ∨ ((m₂ / 2 : ℕ) : ℤ) ≤ valL F E' x) →
        ∀ hx : 1 + x ≠ 0,
          (χ₂ (Units.mk0 (1 + x) hx) : Ω F) ^ 2 =
            ψE' (((cE'⁻¹ : E'ˣ) : E') * (2 * x - x ^ 2))) ∧
      valL F M₁' (cM₁' : M₁') = (m₁ : ℤ) + condExpChar F M₁' ψM₁' ∧
      (∀ z : M₁', (z = 0 ∨ ((m₁ / 2 : ℕ) : ℤ) ≤ valL F M₁' z) →
        ∀ hz : 1 + z ≠ 0,
          (χ₁ (Units.mk0 (1 + z) hz) : Ω F) ^ 2 =
            ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * (2 * z - z ^ 2))) ∧
      (χ₂ cE' : Ω F) ^ 4 * (ψE' (((cE'⁻¹ : E'ˣ) : E') * 2)) ^ 2 =
        (χ₁ cM₁' : Ω F) ^ 4 * (ψM₁' (((cM₁'⁻¹ : M₁'ˣ) : M₁') * 2)) ^ 2 :=
by
  set p := Module.finrank L (IntermediateField.extendScalars hLE')
  set bE' := condExp F L νE'
  set bM₁' := condExp F L νM₁'
  set m₁ := 2 * bM₁' - 1 + p * (bE' - bM₁')
  set m₂ := bE' + bM₁' - 1
  set d₁ := m₁ / 2
  set d₂ := m₂ / 2
  set α₀ := ((c_νE'⁻¹ : Lˣ) : L)
  set ψE' := traceChar F hLE' ψ
  set ψM₁' := traceChar F hLM₁' ψ
  set ξM₁' := νE'.comp (Units.map (normLM F hLM₁'))
  have hp_pos : 0 < p := hPrime.pos
  have hp_ge2 : 2 ≤ p := hPrime.two_le
  have hm₁_ge3 : 3 ≤ m₁ := by omega
  have hd₁_ge1 : 1 ≤ d₁ := by omega
  have hm₁_ge1 : 1 ≤ m₁ := by omega
  have h3d₁_ge_m₁ : (m₁ : ℤ) ≤ 3 * (d₁ : ℤ) := by omega
  have hp_sub1_cast : ((p - 1 : ℕ) : ℤ) = (p : ℤ) - 1 := by omega
  have hbM₁'_sub1_cast : ((bM₁' - 1 : ℕ) : ℤ) = (bM₁' : ℤ) - 1 := by omega
  have hm₁_cast : (m₁ : ℤ) = 2 * (bM₁' : ℤ) - 1 + (p : ℤ) * ((bE' : ℤ) - (bM₁' : ℤ)) := by
    have h1 : m₁ = (2 * bM₁' - 1) + p * (bE' - bM₁') := rfl
    have h2 : ((2 * bM₁' - 1 : ℕ) : ℤ) = 2 * (bM₁' : ℤ) - 1 := by omega
    have h3 : ((bE' - bM₁' : ℕ) : ℤ) = (bE' : ℤ) - (bM₁' : ℤ) := by omega
    rw [h1, Nat.cast_add, h2, Nat.cast_mul, h3]
  have hm₂_cast : (m₂ : ℤ) = (bE' : ℤ) + (bM₁' : ℤ) - 1 := by omega

  
  have halg_all : ∀ (K₀ : Type u) [Field K₀]
      (M : IntermediateField K₀ (AlgebraicClosure K₀)) [FiniteDimensional K₀ M] (z : M),
      minpoly K₀ (z : AlgebraicClosure K₀) = minpoly K₀ z ∧
      ∃ m : ℕ,
        Algebra.norm K₀ z = ((-1) ^ (minpoly K₀ z).natDegree * (minpoly K₀ z).coeff 0) ^ m ∧
        Module.finrank K₀ M = (minpoly K₀ z).natDegree * m := by
    intro K₀ _ M _ z
    have hmin_coe : minpoly K₀ (z : AlgebraicClosure K₀) = minpoly K₀ z :=
      minpoly.algHom_eq M.val M.val.injective z
    have hz : IsIntegral K₀ z := Algebra.IsIntegral.isIntegral z
    let pb := IntermediateField.adjoin.powerBasis hz
    have hpb_gen : pb.gen = IntermediateField.AdjoinSimple.gen K₀ z :=
      IntermediateField.adjoin.powerBasis_gen hz
    have hmin_gen : minpoly K₀ pb.gen = minpoly K₀ z := by
      have hval : (IntermediateField.adjoin K₀ {z}).val pb.gen = z := by
        rw [hpb_gen]
        rfl
      rw [← minpoly.algHom_eq (IntermediateField.adjoin K₀ {z}).val
        (IntermediateField.adjoin K₀ {z}).val.injective pb.gen, hval]
    have hpb_dim : pb.dim = (minpoly K₀ z).natDegree := by
      rw [IntermediateField.adjoin.powerBasis_dim hz]
    have hnorm_adj := Algebra.norm_eq_norm_adjoin K₀ z
    rw [← hpb_gen, Algebra.PowerBasis.norm_gen_eq_coeff_zero_minpoly pb, hpb_dim, hmin_gen] at hnorm_adj
    refine ⟨hmin_coe, _, hnorm_adj, ?_⟩
    rw [← IntermediateField.adjoin.finrank hz, Module.finrank_mul_finrank]

  let φ := IsNonarchimedeanLocalField.valueGroupWithZeroIsoInt F
  have hval_le_F : ∀ a b : F, a ≠ 0 → valuation F a ≤ valuation F b →
      b ≠ 0 ∧ addVal F b ≤ addVal F a := by
    intro a b ha hab
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hφ_le : φ (valuation F a) ≤ φ (valuation F b) := (map_le_map_iff φ).mpr hab
    have hφb : φ (valuation F b) ≠ 0 := by
      intro h0
      rw [h0] at hφ_le
      exact hφa (le_antisymm hφ_le (WithZero.zero_le _))
    have hvb : valuation F b ≠ 0 := fun h0 => hφb (by simp [h0])
    have hb : b ≠ 0 := (Valuation.ne_zero_iff _).mp hvb
    refine ⟨hb, ?_⟩
    rw [← WithZero.coe_unzero hφa, ← WithZero.coe_unzero hφb, WithZero.coe_le_coe] at hφ_le
    unfold addVal
    rw [dif_neg ha, dif_neg hb]
    exact neg_le_neg hφ_le
  have haddVal0 : addVal F 0 = 0 := by
    unfold addVal
    exact dif_pos rfl
  have haddVal_of_val_eq_one : ∀ a : F, valuation F a = 1 → addVal F a = 0 := by
    intro a hva
    have ha : a ≠ 0 := by
      intro h0
      rw [h0, map_zero] at hva
      exact zero_ne_one hva
    have hv1 : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφ1 : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hv1
    unfold addVal
    rw [dif_neg ha]
    have hunz : WithZero.unzero hφ1 = 1 := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, hva, map_one, WithZero.coe_one]
    rw [hunz, toAdd_one, neg_zero]
  have haddVal1 : addVal F 1 = 0 := haddVal_of_val_eq_one 1 (map_one (valuation F))
  have haddVal_mul : ∀ a b : F, a ≠ 0 → b ≠ 0 → addVal F (a * b) = addVal F a + addVal F b := by
    intro a b ha hb
    have hab : a * b ≠ 0 := mul_ne_zero ha hb
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvb : valuation F b ≠ 0 := (Valuation.ne_zero_iff _).mpr hb
    have hφb : φ (valuation F b) ≠ 0 := (map_ne_zero _).mpr hvb
    have hvab : valuation F (a * b) ≠ 0 := (Valuation.ne_zero_iff _).mpr hab
    have hφab : φ (valuation F (a * b)) ≠ 0 := (map_ne_zero _).mpr hvab
    unfold addVal
    rw [dif_neg hab, dif_neg ha, dif_neg hb]
    have hunz : WithZero.unzero hφab = WithZero.unzero hφa * WithZero.unzero hφb := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_mul, map_mul,
        WithZero.coe_mul, WithZero.coe_unzero, WithZero.coe_unzero]
    rw [hunz, toAdd_mul, neg_add]
  have haddVal_pow : ∀ (a : F) (n : ℕ), a ≠ 0 → addVal F (a ^ n) = (n : ℤ) * addVal F a := by
    intro a n ha
    have han : a ^ n ≠ 0 := pow_ne_zero n ha
    have hva : valuation F a ≠ 0 := (Valuation.ne_zero_iff _).mpr ha
    have hφa : φ (valuation F a) ≠ 0 := (map_ne_zero _).mpr hva
    have hvan : valuation F (a ^ n) ≠ 0 := (Valuation.ne_zero_iff _).mpr han
    have hφan : φ (valuation F (a ^ n)) ≠ 0 := (map_ne_zero _).mpr hvan
    unfold addVal
    rw [dif_neg han, dif_neg ha]
    have hunz : WithZero.unzero hφan = (WithZero.unzero hφa) ^ n := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, map_pow, map_pow,
        WithZero.coe_pow, WithZero.coe_unzero]
    rw [hunz, toAdd_pow]
    simp
  obtain ⟨π, hπ⟩ := ValuativeRel.valuation_surjective
    (φ.symm (WithZero.coe (Multiplicative.ofAdd (-1 : ℤ))))
  have hφπ : φ (valuation F π) = WithZero.coe (Multiplicative.ofAdd (-1 : ℤ)) := by
    rw [hπ]
    exact φ.apply_symm_apply _
  have hφπ_ne : φ (valuation F π) ≠ 0 := by
    rw [hφπ]
    exact WithZero.coe_ne_zero
  have hπ_ne : π ≠ 0 := fun h0 => hφπ_ne (by simp [h0])
  have hadd_π : addVal F π = 1 := by
    unfold addVal
    rw [dif_neg hπ_ne]
    have hunz : WithZero.unzero hφπ_ne = Multiplicative.ofAdd (-1 : ℤ) := by
      rw [← WithZero.coe_inj, WithZero.coe_unzero, hφπ]
    rw [hunz, toAdd_ofAdd, neg_neg]

  have hval_props : ∀ (M : IntermediateField F (AlgebraicClosure F)) [FiniteDimensional F M],
      valL F M 0 = 0 ∧
      valL F M 1 = 0 ∧
      valL F M (-1) = 0 ∧
      (∀ x : M, valL F M (-x) = valL F M x) ∧
      (∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y) ∧
      (∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M)) ∧
      (∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y))) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1))) := by
    intro M _
    have halg : ∀ z : M,
        minpoly F (z : AlgebraicClosure F) = minpoly F z ∧
        ∃ m : ℕ,
          Algebra.norm F z = ((-1) ^ (minpoly F z).natDegree * (minpoly F z).coeff 0) ^ m ∧
          Module.finrank F M = (minpoly F z).natDegree * m := halg_all F M
    have hrel0 : relVal F M 0 = 0 := by
      unfold relVal
      rw [Algebra.norm_zero, haddVal0]
    have hrel1 : relVal F M 1 = 0 := by
      unfold relVal
      rw [map_one, haddVal1]
    have hrel_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → relVal F M (x * y) = relVal F M x + relVal F M y := by
      intro x y hx hy
      have hnx : Algebra.norm F x ≠ 0 := Algebra.norm_ne_zero_iff.mpr hx
      have hny : Algebra.norm F y ≠ 0 := Algebra.norm_ne_zero_iff.mpr hy
      unfold relVal
      rw [map_mul, haddVal_mul _ _ hnx hny]
    have hrel_neg1 : relVal F M (-1) = 0 := by
      have hne : (-1 : M) ≠ 0 := neg_ne_zero.mpr one_ne_zero
      have hsq : relVal F M ((-1 : M) * (-1 : M)) = relVal F M (-1) + relVal F M (-1) :=
        hrel_mul (-1) (-1) hne hne
      have h1 : (-1 : M) * (-1 : M) = 1 := by ring
      rw [h1, hrel1] at hsq
      omega
    have hrel_neg : ∀ x : M, relVal F M (-x) = relVal F M x := by
      intro x
      by_cases hx : x = 0
      · simp [hx]
      · have hne1 : (-1 : M) ≠ 0 := neg_ne_zero.mpr one_ne_zero
        have hneg_eq : (-x : M) = (-1 : M) * x := by ring
        rw [hneg_eq, hrel_mul (-1) x hne1 hx, hrel_neg1, zero_add]
    have hrel_inv : ∀ u : Mˣ, relVal F M ((u⁻¹ : Mˣ) : M) = - relVal F M (u : M) := by
      intro u
      have hmul : relVal F M ((u : M) * ((u⁻¹ : Mˣ) : M)) =
          relVal F M (u : M) + relVal F M ((u⁻¹ : Mˣ) : M) :=
        hrel_mul (u : M) ((u⁻¹ : Mˣ) : M) (Units.ne_zero u) (Units.ne_zero u⁻¹)
      rw [Units.mul_inv, hrel1] at hmul
      omega
    have hrel_pow : ∀ (u : Mˣ) (n : ℕ),
        relVal F M (((u ^ n : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M) := by
      intro u n
      induction n with
      | zero => simp [hrel1]
      | succ n ih =>
        rw [pow_succ, Units.val_mul, hrel_mul _ _ (Units.ne_zero _) (Units.ne_zero _), ih]
        push_cast
        ring
    have hrel_zpow : ∀ (u : Mˣ) (m : ℤ),
        relVal F M (((u ^ m : Mˣ) : M)) = m * relVal F M (u : M) := by
      intro u m
      cases m with
      | ofNat n =>
        change relVal F M (((u ^ (n : ℤ) : Mˣ) : M)) = (n : ℤ) * relVal F M (u : M)
        rw [zpow_natCast, hrel_pow]
      | negSucc n =>
        rw [zpow_negSucc, hrel_inv (u ^ (n + 1)), hrel_pow u (n + 1), Int.negSucc_eq]
        push_cast
        ring
    let x_π : M := algebraMap F M π
    have hx_π_ne : x_π ≠ 0 := by simp [x_π, hπ_ne]
    have hrel_x_π : relVal F M x_π = (Module.finrank F M : ℤ) := by
      unfold relVal
      rw [Algebra.norm_algebraMap, haddVal_pow π (Module.finrank F M) hπ_ne, hadd_π, mul_one]
    let S : Set ℕ := {k : ℕ | 0 < k ∧ ∃ x : M, x ≠ 0 ∧ relVal F M x = k}
    have hS_nonempty : S.Nonempty := ⟨Module.finrank F M, Module.finrank_pos, x_π, hx_π_ne, hrel_x_π⟩
    obtain ⟨hfM_pos, ϖ₀, hϖ₀_ne, hrel_ϖ₀⟩ := Nat.sInf_mem hS_nonempty
    let ϖM : Mˣ := Units.mk0 ϖ₀ hϖ₀_ne
    have hrel_ϖM : relVal F M (ϖM : M) = (resDeg F M : ℤ) := hrel_ϖ₀
    have hfM_int_pos : (0 : ℤ) < (resDeg F M : ℤ) := Nat.cast_pos.mpr hfM_pos
    have hfM_int_ne : (resDeg F M : ℤ) ≠ 0 := ne_of_gt hfM_int_pos
    have hdiv : ∀ x : M, relVal F M x = (resDeg F M : ℤ) * valL F M x := by
      intro x
      by_cases hx : x = 0
      · unfold valL
        rw [hx, hrel0, Int.zero_ediv, mul_zero]
      · set f : ℤ := (resDeg F M : ℤ)
        set q : ℤ := valL F M x
        set r : ℤ := relVal F M x % f
        have hediv : f * q + r = relVal F M x := Int.mul_ediv_add_emod (relVal F M x) f
        have hr_nonneg : 0 ≤ r := Int.emod_nonneg (relVal F M x) hfM_int_ne
        have hr_lt : r < f := Int.emod_lt_of_pos (relVal F M x) hfM_int_pos
        have hr_zero : r = 0 := by
          by_contra hr_ne
          have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne)
          let y : M := x * (((ϖM ^ (-q) : Mˣ) : M))
          have hy_ne : y ≠ 0 := mul_ne_zero hx (Units.ne_zero _)
          have hrel_y : relVal F M y = r := by
            dsimp [y]
            rw [hrel_mul x _ hx (Units.ne_zero _), hrel_zpow ϖM (-q), hrel_ϖM]
            linarith
          let k : ℕ := r.toNat
          have hk_eq : (k : ℤ) = r := Int.toNat_of_nonneg hr_nonneg
          have hk_pos : 0 < k := by omega
          have hk_lt : k < resDeg F M := by omega
          have hk_mem : k ∈ S := ⟨hk_pos, y, hy_ne, by omega⟩
          have hle : resDeg F M ≤ k := Nat.sInf_le hk_mem
          omega
        linarith
    have hval0 : valL F M 0 = 0 := by
      have h := hdiv 0
      rw [hrel0] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfM_int_ne
    have hval1 : valL F M 1 = 0 := by
      have h := hdiv 1
      rw [hrel1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfM_int_ne
    have hval_neg1 : valL F M (-1) = 0 := by
      have h := hdiv (-1)
      rw [hrel_neg1] at h
      exact (mul_eq_zero.mp h.symm).resolve_left hfM_int_ne
    have hval_neg : ∀ x : M, valL F M (-x) = valL F M x := by
      intro x
      apply mul_left_cancel₀ hfM_int_ne
      rw [← hdiv (-x), ← hdiv x, hrel_neg]
    have hval_mul : ∀ x y : M, x ≠ 0 → y ≠ 0 → valL F M (x * y) = valL F M x + valL F M y := by
      intro x y hx hy
      apply mul_left_cancel₀ hfM_int_ne
      rw [mul_add, ← hdiv (x * y), ← hdiv x, ← hdiv y, hrel_mul x y hx hy]
    have hval_inv : ∀ u : Mˣ, valL F M ((u⁻¹ : Mˣ) : M) = - valL F M (u : M) := by
      intro u
      apply mul_left_cancel₀ hfM_int_ne
      rw [mul_neg, ← hdiv, ← hdiv, hrel_inv]
    have hval_add : ∀ (k : ℤ) (x y : M),
        (x = 0 ∨ k ≤ valL F M x) → (y = 0 ∨ k ≤ valL F M y) →
          (x + y = 0 ∨ k ≤ valL F M (x + y)) := by
      letI : UniformSpace F := IsTopologicalAddGroup.rightUniformSpace F
      haveI : IsUniformAddGroup F := isUniformAddGroup_of_addCommGroup
      haveI : (Valued.v : Valuation F (ValueGroupWithZero F)).RankOne :=
        Valuation.RankOne.ofRankLeOneStruct (Classical.choice IsRankLeOne.nonempty)
      letI : NontriviallyNormedField F := Valued.toNontriviallyNormedField
      haveI : IsUltrametricDist F := Valued.instIsUltrametricDist F _
      have hspec_pow : ∀ z : M,
          (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F M) =
            ‖Algebra.norm F z‖ := by
        intro z
        obtain ⟨hmin_coe, m, hnorm_adj, hfinrank⟩ := halg z
        have hspec : spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) =
            ‖(minpoly F z).coeff 0‖ ^ (1 / ((minpoly F z).natDegree : ℝ)) := by
          rw [spectralNorm.spectralNorm_eq_norm_coeff_zero_rpow, hmin_coe]
        have hnorm_eq : ‖Algebra.norm F z‖ = ‖(minpoly F z).coeff 0‖ ^ m := by
          rw [hnorm_adj, norm_pow, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul]
        have hz : IsIntegral F z := Algebra.IsIntegral.isIntegral z
        have hd_pos : 0 < ((minpoly F z).natDegree : ℝ) := by
          exact_mod_cast minpoly.natDegree_pos hz
        rw [hspec, hnorm_eq, hfinrank, ← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _),
           ← Real.rpow_natCast]
        congr 1
        push_cast
        rw [← mul_assoc, one_div_mul_cancel (ne_of_gt hd_pos), one_mul]
      have hspec_le : ∀ w z : M, w ≠ 0 →
          spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F) ≤
            spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F) →
          z ≠ 0 ∧ valL F M z ≤ valL F M w := by
        intro w z hw hle
        have hpow_le :
            (spectralNorm F (AlgebraicClosure F) (w : AlgebraicClosure F)) ^ (Module.finrank F M) ≤
            (spectralNorm F (AlgebraicClosure F) (z : AlgebraicClosure F)) ^ (Module.finrank F M) :=
          pow_le_pow_left₀ (spectralNorm_nonneg _) hle _
        rw [hspec_pow w, hspec_pow z] at hpow_le
        have hv_eq : ∀ a : F, ‖a‖ =
            ((Valuation.RankOne.hom (Valued.v : Valuation F (ValueGroupWithZero F)))
              (valuation F a) : ℝ) := fun a => rfl
        rw [hv_eq, hv_eq, NNReal.coe_le_coe] at hpow_le
        have hv_le : valuation F (Algebra.norm F w) ≤ valuation F (Algebra.norm F z) :=
          (Valuation.RankOne.strictMono (Valued.v : Valuation F (ValueGroupWithZero F))).le_iff_le.mp
            hpow_le
        have hnw : Algebra.norm F w ≠ 0 := Algebra.norm_ne_zero_iff.mpr hw
        obtain ⟨hnz, hrel_le⟩ := hval_le_F (Algebra.norm F w) (Algebra.norm F z) hnw hv_le
        have hz : z ≠ 0 := Algebra.norm_ne_zero_iff.mp hnz
        refine ⟨hz, ?_⟩
        exact Int.ediv_le_ediv hfM_int_pos hrel_le
      intro k x y hx hy
      by_cases hxy : x + y = 0
      · exact Or.inl hxy
      · right
        have hcoe : ((x + y : M) : AlgebraicClosure F) =
            (x : AlgebraicClosure F) + (y : AlgebraicClosure F) := rfl
        have hna := isNonarchimedean_spectralNorm (K := F)
          (x : AlgebraicClosure F) (y : AlgebraicClosure F)
        rw [← hcoe, le_max_iff] at hna
        rcases hna with hle_x | hle_y
        · obtain ⟨hx_ne, hval_x⟩ := hspec_le (x + y) x hxy hle_x
          exact le_trans (hx.resolve_left hx_ne) hval_x
        · obtain ⟨hy_ne, hval_y⟩ := hspec_le (x + y) y hxy hle_y
          exact le_trans (hy.resolve_left hy_ne) hval_y
    have hgen_val0 : ∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1)) → valL F M (u : M) = 0 := by
      intro a ha u hu
      rcases hu with hu1 | hua
      · rw [hu1, hval1]
      · have h_ge0 : (0 : ℤ) ≤ valL F M (u : M) := by
          have hadd := hval_add 0 ((u : M) - 1) 1 (Or.inr (by omega)) (Or.inr (by rw [hval1]))
          have heq : ((u : M) - 1) + 1 = (u : M) := sub_add_cancel (u : M) 1
          rw [heq] at hadd
          exact hadd.resolve_left (Units.ne_zero u)
        have h_le0 : valL F M (u : M) ≤ 0 := by
          by_contra hlt
          have hge1 : (1 : ℤ) ≤ valL F M (-(u : M)) := by
            rw [hval_neg]
            omega
          have hadd := hval_add 1 ((u : M) - 1) (-(u : M)) (Or.inr (by omega)) (Or.inr hge1)
          have heq : ((u : M) - 1) + (-(u : M)) = -1 := by ring
          rw [heq, hval_neg1] at hadd
          have hne : (-1 : M) ≠ 0 := neg_ne_zero.mpr one_ne_zero
          have h10 : (1 : ℤ) ≤ 0 := hadd.resolve_left hne
          omega
        omega
    have hunit_ge1 : ∀ (a : ℕ), 1 ≤ a → ∀ u : Mˣ,
        u ∈ unitGroup F M a ↔ ((u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1)) := by
      intro a ha
      have ha0 : a ≠ 0 := by omega
      let Ha : Subgroup Mˣ := {
        carrier := {u : Mˣ | (u : M) = 1 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1)}
        one_mem' := Or.inl Units.val_one
        mul_mem' := by
          intro u v hu hv
          change ((u * v : Mˣ) : M) = 1 ∨ (a : ℤ) ≤ valL F M (((u * v : Mˣ) : M) - 1)
          have hu0 : valL F M (u : M) = 0 := hgen_val0 a ha u hu
          have hterm1 : (u : M) * ((v : M) - 1) = 0 ∨
              (a : ℤ) ≤ valL F M ((u : M) * ((v : M) - 1)) := by
            by_cases hsub : (v : M) - 1 = 0
            · left; rw [hsub, mul_zero]
            · right
              have hv1 : (v : M) ≠ 1 := sub_ne_zero.mp hsub
              have hva : (a : ℤ) ≤ valL F M ((v : M) - 1) := hv.resolve_left hv1
              rw [hval_mul (u : M) ((v : M) - 1) (Units.ne_zero u) hsub, hu0, zero_add]
              exact hva
          have hterm2 : (u : M) - 1 = 0 ∨ (a : ℤ) ≤ valL F M ((u : M) - 1) := by
            rcases hu with hu1 | hua
            · exact Or.inl (sub_eq_zero.mpr hu1)
            · exact Or.inr hua
          have hadd := hval_add (a : ℤ) ((u : M) * ((v : M) - 1)) ((u : M) - 1) hterm1 hterm2
          have hsplit : (u : M) * ((v : M) - 1) + ((u : M) - 1) = ((u * v : Mˣ) : M) - 1 := by
            rw [Units.val_mul]; ring
          rw [hsplit] at hadd
          rcases hadd with h0 | hle
          · exact Or.inl (sub_eq_zero.mp h0)
          · exact Or.inr hle
        inv_mem' := by
          intro u hu
          change ((u⁻¹ : Mˣ) : M) = 1 ∨ (a : ℤ) ≤ valL F M (((u⁻¹ : Mˣ) : M) - 1)
          have hu0 : valL F M (u : M) = 0 := hgen_val0 a ha u hu
          have hu_inv0 : valL F M ((u⁻¹ : Mˣ) : M) = 0 := by
            rw [hval_inv u, hu0, neg_zero]
          have hinv_split : (((u⁻¹ : Mˣ) : M) - 1) = - (((u⁻¹ : Mˣ) : M) * ((u : M) - 1)) := by
            have hmul : ((u⁻¹ : Mˣ) : M) * (u : M) = 1 := Units.inv_mul u
            linear_combination hmul
          by_cases hsub : (u : M) - 1 = 0
          · left
            apply sub_eq_zero.mp
            rw [hinv_split, hsub, mul_zero, neg_zero]
          · right
            have hu1 : (u : M) ≠ 1 := sub_ne_zero.mp hsub
            have hua : (a : ℤ) ≤ valL F M ((u : M) - 1) := hu.resolve_left hu1
            rw [hinv_split, hval_neg,
              hval_mul ((u⁻¹ : Mˣ) : M) ((u : M) - 1) (Units.ne_zero u⁻¹) hsub,
              hu_inv0, zero_add]
            exact hua
      }
      have hcl_le : unitGroup F M a ≤ Ha := by
        unfold unitGroup
        rw [Subgroup.closure_le]
        intro u hu
        simpa [Ha, ha0] using hu
      have hle_cl : Ha ≤ unitGroup F M a := by
        intro u hu
        unfold unitGroup
        apply Subgroup.subset_closure
        simpa [Ha, ha0] using hu
      intro u
      exact ⟨fun hu => hcl_le hu, fun hu => hle_cl hu⟩
    exact ⟨hval0, hval1, hval_neg1, hval_neg, hval_mul, hval_inv, hval_add, hunit_ge1⟩

  obtain ⟨hval0_L, hval1_L, hval_neg1_L, hval_neg_L, hval_mul_L, hval_inv_L,
    hval_add_L, _⟩ := hval_props L
  obtain ⟨hval0_E', hval1_E', hval_neg1_E', hval_neg_E', hval_mul_E', hval_inv_E',
    hval_add_E', _⟩ := hval_props E'
  obtain ⟨hval0_M₁', hval1_M₁', hval_neg1_M₁', hval_neg_M₁', hval_mul_M₁', hval_inv_M₁',
    hval_add_M₁', hunit_ge1_M₁'⟩ := hval_props M₁'
  obtain ⟨_, _, _, _, _, _, _, hunit_ge1_K₁⟩ := hval_props K₁

  have hval_sub_M₁' : ∀ (k : ℤ) (a b : M₁'),
      (a = 0 ∨ k ≤ valL F M₁' a) → (b = 0 ∨ k ≤ valL F M₁' b) →
      (a - b = 0 ∨ k ≤ valL F M₁' (a - b)) := by
    intro k a b ha hb
    rw [sub_eq_add_neg]
    apply hval_add_M₁' k a (-b) ha
    rcases hb with rfl | hb_ge
    · left; exact neg_zero
    · right; rw [hval_neg_M₁']; exact hb_ge
  have hval_mul_bound_M₁' : ∀ (k₁ k₂ : ℤ) (a b : M₁'),
      (a = 0 ∨ k₁ ≤ valL F M₁' a) → (b = 0 ∨ k₂ ≤ valL F M₁' b) →
      (a * b = 0 ∨ k₁ + k₂ ≤ valL F M₁' (a * b)) := by
    intro k₁ k₂ a b ha hb
    by_cases ha0 : a = 0
    · left; rw [ha0, zero_mul]
    · by_cases hb0 : b = 0
      · left; rw [hb0, mul_zero]
      · right
        rw [hval_mul_M₁' a b ha0 hb0]
        exact add_le_add (ha.resolve_left ha0) (hb.resolve_left hb0)

  
  have hcondExpChar_triv : ∀ (M : IntermediateField F (AlgebraicClosure F))
      (ψ_M : AddChar M (Ω F)), IsAdmissibleChar F M ψ_M →
      ∀ x : M, (x = 0 ∨ -condExpChar F M ψ_M ≤ valL F M x) → ψ_M x = 1 := by
    intro M ψ_M hψ_M
    let Sψ : Set ℤ := {d : ℤ | ∀ x : M, -d ≤ valL F M x → ψ_M x = 1}
    have hne_ψ : Sψ.Nonempty := by
      obtain ⟨d₀, hd₀⟩ := hψ_M.2
      refine ⟨-d₀, fun x hx => hd₀ x ?_⟩
      simpa using hx
    have hbdd_ψ : BddAbove Sψ := by
      rcases DFunLike.ne_iff.mp hψ_M.1 with ⟨x₀, hx₀⟩
      have hx₀' : ψ_M x₀ ≠ 1 := by simpa [AddChar.one_apply] using hx₀
      refine ⟨-valL F M x₀ - 1, fun d hd => ?_⟩
      by_contra hlt
      exact hx₀' (hd x₀ (by omega))
    have hmem_ψ : condExpChar F M ψ_M ∈ Sψ := Int.csSup_mem hne_ψ hbdd_ψ
    intro x hx
    rcases hx with rfl | hx_ge
    · exact AddChar.map_zero_eq_one ψ_M
    · exact hmem_ψ x hx_ge
  have hψ_triv := hcondExpChar_triv L ψ hψ
  have hψM₁'_triv := hcondExpChar_triv M₁' ψM₁' hψM₁'

  have hψE'_lin : ∀ (x : L) (y : E'),
      ψE' (IntermediateField.inclusion hLE' x * y) = ψ (x * traceLM F hLE' y) := by
    intro x y
    letI : Module L L := Semiring.toModule
    have htr : traceLM F hLE' (IntermediateField.inclusion hLE' x * y) = x * traceLM F hLE' y :=
      (Algebra.trace L (IntermediateField.extendScalars hLE')).map_smul' x (toExtendScalars F hLE' y)
    change ψ (traceLM F hLE' (IntermediateField.inclusion hLE' x * y)) = ψ (x * traceLM F hLE' y)
    rw [htr]
  have hψM₁'_lin : ∀ (x : L) (z : M₁'),
      ψM₁' (IntermediateField.inclusion hLM₁' x * z) = ψ (x * traceLM F hLM₁' z) := by
    intro x z
    letI : Module L L := Semiring.toModule
    have htr : traceLM F hLM₁' (IntermediateField.inclusion hLM₁' x * z) = x * traceLM F hLM₁' z :=
      (Algebra.trace L (IntermediateField.extendScalars hLM₁')).map_smul' x (toExtendScalars F hLM₁' z)
    change ψ (traceLM F hLM₁' (IntermediateField.inclusion hLM₁' x * z)) = ψ (x * traceLM F hLM₁' z)
    rw [htr]

  have hGalM₁'_inv : ∀ τ : M₁' ≃ₐ[F] M₁',
      (∀ x : L, τ (IntermediateField.inclusion hLM₁' x) = IntermediateField.inclusion hLM₁' x) →
      (∀ z : M₁', valL F M₁' (τ z) = valL F M₁' z) ∧
      (∀ z : M₁', valL F M₁' (τ.symm z) = valL F M₁' z) ∧
      (∀ z : M₁', ψM₁' (τ z) = ψM₁' z) := by
    intro τ hτ_L
    refine ⟨?_, ?_, ?_⟩
    · intro z
      unfold valL relVal
      rw [Algebra.norm_eq_of_algEquiv τ z]
    · intro z
      unfold valL relVal
      rw [Algebra.norm_eq_of_algEquiv τ.symm z]
    · intro z
      let τ_M₁'' : (IntermediateField.extendScalars hLM₁') ≃ₐ[L]
          (IntermediateField.extendScalars hLM₁') :=
        { toFun := fun w =>
            ⟨(τ ⟨w.1, (IntermediateField.mem_extendScalars hLM₁').mp w.2⟩).1,
              (IntermediateField.mem_extendScalars hLM₁').mpr
                (τ ⟨w.1, (IntermediateField.mem_extendScalars hLM₁').mp w.2⟩).2⟩
          invFun := fun w =>
            ⟨(τ.symm ⟨w.1, (IntermediateField.mem_extendScalars hLM₁').mp w.2⟩).1,
              (IntermediateField.mem_extendScalars hLM₁').mpr
                (τ.symm ⟨w.1, (IntermediateField.mem_extendScalars hLM₁').mp w.2⟩).2⟩
          left_inv := fun w => Subtype.ext (congrArg Subtype.val (τ.left_inv _))
          right_inv := fun w => Subtype.ext (congrArg Subtype.val (τ.right_inv _))
          map_mul' := fun w₁ w₂ => Subtype.ext (congrArg Subtype.val (map_mul τ _ _))
          map_add' := fun w₁ w₂ => Subtype.ext (congrArg Subtype.val (map_add τ _ _))
          commutes' := fun x => Subtype.ext (congrArg Subtype.val (hτ_L x)) }
      have htr_τ : traceLM F hLM₁' (τ z) = traceLM F hLM₁' z :=
        Algebra.trace_eq_of_algEquiv τ_M₁'' (toExtendScalars F hLM₁' z)
      change ψ (traceLM F hLM₁' (τ z)) = ψ (traceLM F hLM₁' z)
      rw [htr_τ]

  
  have hj_lt_pF : j < ringChar 𝓀[F] := by
    change j < EllipticRootNumber.p F
    omega
  have hj_ndvd : ¬ (ringChar 𝓀[F] ∣ j) := Nat.not_dvd_of_pos_of_lt hj_pos hj_lt_pF
  have hj_res_ne : ((j : ℕ) : 𝓀[F]) ≠ 0 :=
    fun h0 => hj_ndvd ((ringChar.spec 𝓀[F] j).mp h0)
  let x_j : 𝒪[F] := (j : 𝒪[F])
  have hx_j_res : IsLocalRing.residue 𝒪[F] x_j ≠ 0 := by
    rw [show x_j = (j : 𝒪[F]) from rfl, map_natCast]
    exact hj_res_ne
