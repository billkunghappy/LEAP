      _ = (ν₁ u₂ : Ω F)⁻¹ * ψ (A * (δ_b : L) * x₂) *
          ((ν₁ w : Ω F)⁻¹ * (ν₁ w : Ω F)) := by
        rw [inv_mul_cancel₀ (Units.ne_zero (ν₁ w))]
      _ = (ν₁ u₂ : Ω F)⁻¹ * (ν₁ w : Ω F)⁻¹ *
