  set u_rem : Lˣ := u_NU * (u_v1 * u_qL)⁻¹
  have hu_rem_sub : (u_rem : L) - 1 = -(v_1 * q_L) * (((u_v1 * u_qL)⁻¹ : Lˣ) : L) := by
    have hinv : (1 + v_1) * (1 + q_L) * (((u_v1 * u_qL)⁻¹ : Lˣ) : L) = 1 := by
      change ((u_v1 * u_qL : Lˣ) : L) * (((u_v1 * u_qL)⁻¹ : Lˣ) : L) = 1
      rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
    have hcoe : (u_rem : L) = (1 + v_1 + q_L) * (((u_v1 * u_qL)⁻¹ : Lˣ) : L) := by
      simp [u_rem, u_NU, u_U, Units.val_mk0, hnorm_Uz]
    rw [hcoe]
    linear_combination hinv
  have hval_uv1 : valL F L (u_v1 : L) = 0 := by
    simpa [u_v1, Units.val_mk0] using
      hvalL_one_add_eq_zero v_1 (hv_1_dT.imp id (fun hle => by omega)) hs
  have hval_uqL : valL F L (u_qL : L) = 0 := by
    simpa [u_qL, Units.val_mk0] using
      hvalL_one_add_eq_zero q_L (hq_L_rT.imp id (fun hle => by omega)) hq_L1
  have hval_prod_inv : valL F L (((u_v1 * u_qL)⁻¹ : Lˣ) : L) = 0 := by
    rw [hvalL_inv (u_v1 * u_qL), Units.val_mul,
      hvalL_mul (u_v1 : L) (u_qL : L) u_v1.ne_zero u_qL.ne_zero, hval_uv1, hval_uqL]
    omega
  have hv1_qL_T : -(v_1 * q_L) = 0 ∨ (T : ℤ) ≤ valL F L (-(v_1 * q_L)) := by
    have h := hvalL_mul_bound (d_T : ℤ) (r_T : ℤ) v_1 q_L hv_1_dT hq_L_rT
    rcases h with h0 | hle
    · left; rw [h0, neg_zero]
    · right; rw [hvalL_neg]; omega
  have hu_rem_mem : u_rem ∈ unitGroup F L T := by
    rw [hunitL_mem T (by omega)]
    have h := hvalL_mul_bound (T : ℤ) 0 (-(v_1 * q_L)) (((u_v1 * u_qL)⁻¹ : Lˣ) : L)
      hv1_qL_T (Or.inr (by rw [hval_prod_inv]))
    rcases h with h0 | hle
    · left; linear_combination hu_rem_sub + h0
    · right; rw [hu_rem_sub]; omega
  have hν_rem : νE' u_rem = 1 := hSpecL_ν u_rem hu_rem_mem
  have hν_NU : νE' u_NU = 1 := (hνE'_ker u_NU).mp ⟨u_U, rfl⟩
  have hν_prod : νE' u_v1 * νE' u_qL = 1 := by
    have h1 : νE' (u_NU * (u_v1 * u_qL)⁻¹) = 1 := hν_rem
    rw [map_mul, hν_NU, one_mul, map_inv, inv_eq_one, map_mul] at h1
    exact h1
  have hν_qL_eq : (νE' u_qL : Ω F) = (νE' u_v1 : Ω F)⁻¹ := by
    have h2 : (νE' u_v1)⁻¹ * (νE' u_v1 * νE' u_qL) = (νE' u_v1)⁻¹ * 1 :=
      congrArg ((νE' u_v1)⁻¹ * ·) hν_prod
    rw [inv_mul_cancel_left, mul_one] at h2
    exact (congrArg Units.val h2).trans (Units.val_inv_eq_inv_val (νE' u_v1))
  have hψ_qL : ψ (((c_ν⁻¹ : Lˣ) : L) * q_L) = (νE' u_v1 : Ω F)⁻¹ := by
    have hstat := hc_ν_stat q_L hq_L_rT hq_L1
    change (νE' u_qL : Ω F) = ψ (((c_ν⁻¹ : Lˣ) : L) * q_L) at hstat
    exact hstat.symm.trans hν_qL_eq
  change ψ (((c_ν⁻¹ : Lˣ) : L) * Δ₂) = _
  rw [hψ_Δ₂, hψ_qL, mul_comm, dif_pos hs]
  dsimp only [u_v1, v_1]
  rw [← mul_assoc (((c_ν⁻¹ : Lˣ) : L)) (δ_T : L) s_sq]

theorem ld_ch12_wild_dyadic_unramified_min_cond_odd_biquad_trace_M1_term (F : Type u)
    [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (L E' M₁' K₁ : IntermediateField F (AlgebraicClosure F))
    [FiniteDimensional F L] [FiniteDimensional F E']
    [FiniteDimensional F M₁'] [FiniteDimensional F K₁]
    (hLE' : L ≤ E') (hLM₁' : L ≤ M₁') (hE'K₁ : E' ≤ K₁) (hM₁'K₁ : M₁' ≤ K₁)
    (hdeg2 : Module.finrank L (IntermediateField.extendScalars hLE') = 2)
    (hdegM₁' : Module.finrank L (IntermediateField.extendScalars hLM₁') =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (hdegM₁'K₁ : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) =
      Module.finrank L (IntermediateField.extendScalars hLE'))
    (ψ : AddChar L (Ω F))
    (νE' : Lˣ →* (Ω F)ˣ)
    (hbE'_ge2 : 2 ≤ condExp F L νE')
    (hT_odd : condExp F L νE' % 2 = 1)
    (htr_bound_LE' : ∀ (m : ℤ) (y : E'),
      (y = 0 ∨ 2 * m - (condExp F L νE' : ℤ) ≤ valL F E' y) →
      (traceLM F hLE' y = 0 ∨ m ≤ valL F L (traceLM F hLE' y)))
    (hDiamond_E' : ∀ y : E',
      normLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (normLM F hLE' y) ∧
      traceLM F hM₁'K₁ (IntermediateField.inclusion hE'K₁ y) =
        IntermediateField.inclusion hLM₁' (traceLM F hLE' y))
    (d : M₁') (c : L)
    (hc_val : valL F L c = 0)
    (hd_tr : traceLM F hLM₁' d = 1) (hd_norm : normLM F hLM₁' d = -c)
    (hd_sq : d ^ 2 - d = IntermediateField.inclusion hLM₁' c)
    (c_ν : Lˣ) (x : E') (C : K₁ˣ)
    (hC_eq : (C : K₁) =
      IntermediateField.inclusion hE'K₁ x + IntermediateField.inclusion hM₁'K₁ d)
    (hx_int : x = 0 ∨ 0 ≤ valL F E' x)
    (hc_ν_val : valL F L (c_ν : L) = (condExp F L νE' : ℤ) + condExpChar F L ψ)
    (hQuadNorm : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂]
      (hM₀M₂ : M₀ ≤ M₂),
      Module.finrank M₀ (IntermediateField.extendScalars hM₀M₂) = 2 →
      (∀ x : M₀, traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x) = (2 : M₀) * x) ∧
      (∀ (x : M₀) (y : M₂),
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x + y) =
          x ^ 2 + x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y ∧
        normLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ x - y) =
          x ^ 2 - x * traceLM F hM₀M₂ y + normLM F hM₀M₂ y))
    (hvalL_props : valL F L 0 = 0 ∧ valL F L 1 = 0 ∧ valL F L (-1) = 0 ∧
      (∀ x : L, valL F L (-x) = valL F L x) ∧
      (∀ x y : L, x ≠ 0 → y ≠ 0 → valL F L (x * y) = valL F L x + valL F L y) ∧
      (∀ u : Lˣ, valL F L ((u⁻¹ : Lˣ) : L) = - valL F L (u : L)) ∧
      (∀ m : ℤ, ∃ c : Lˣ, valL F L (c : L) = m) ∧
      (∀ (k : ℤ) (x y : L),
        (x = 0 ∨ k ≤ valL F L x) → (y = 0 ∨ k ≤ valL F L y) →
          (x + y = 0 ∨ k ≤ valL F L (x + y))) ∧
      (∀ u : Lˣ, u ∈ unitGroup F L 0 ↔ valL F L (u : L) = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : Lˣ,
        u ∈ unitGroup F L a ↔ ((u : L) = 1 ∨ (a : ℤ) ≤ valL F L ((u : L) - 1))) ∧
      (∀ (a : ℕ) (u : Lˣ), u ∈ unitGroup F L a → valL F L (u : L) = 0))
    (hvalE'_props : valL F E' 0 = 0 ∧ valL F E' 1 = 0 ∧ valL F E' (-1) = 0 ∧
      (∀ x : E', valL F E' (-x) = valL F E' x) ∧
      (∀ x y : E', x ≠ 0 → y ≠ 0 → valL F E' (x * y) = valL F E' x + valL F E' y) ∧
      (∀ u : E'ˣ, valL F E' ((u⁻¹ : E'ˣ) : E') = - valL F E' (u : E')) ∧
      (∀ m : ℤ, ∃ c : E'ˣ, valL F E' (c : E') = m) ∧
      (∀ (k : ℤ) (x y : E'),
        (x = 0 ∨ k ≤ valL F E' x) → (y = 0 ∨ k ≤ valL F E' y) →
          (x + y = 0 ∨ k ≤ valL F E' (x + y))) ∧
      (∀ u : E'ˣ, u ∈ unitGroup F E' 0 ↔ valL F E' (u : E') = 0) ∧
      (∀ (a : ℕ), 1 ≤ a → ∀ u : E'ˣ,
        u ∈ unitGroup F E' a ↔ ((u : E') = 1 ∨ (a : ℤ) ≤ valL F E' ((u : E') - 1))) ∧
      (∀ (a : ℕ) (u : E'ˣ), u ∈ unitGroup F E' a → valL F E' (u : E') = 0))
    (hSpecL_ψ : ∀ x : L, (x = 0 ∨ -condExpChar F L ψ ≤ valL F L x) → ψ x = 1)
    (h2_val : (2 : L) = 0 ∨ ((condExp F L νE' / 2 : ℕ) : ℤ) ≤ valL F L (2 : L))
    (δ_E : E'ˣ)
    (hδ_E_val : valL F E' (δ_E : E') = ((condExp F L νE' / 2 : ℕ) : ℤ))
    (r₁ r₂ : L)
    (hr₁_int : r₁ = 0 ∨ 0 ≤ valL F L r₁)
    (hr₂_int : r₂ = 0 ∨ 0 ≤ valL F L r₂) :
    let z := IntermediateField.inclusion hLM₁' r₁ + IntermediateField.inclusion hLM₁' r₂ * d
    let C_z : K₁ := (C : K₁) *
      (1 + IntermediateField.inclusion hE'K₁ (δ_E : E') * IntermediateField.inclusion hM₁'K₁ z)
    ψ (((c_ν⁻¹ : Lˣ) : L) *
      (normLM F hLM₁' (traceLM F hM₁'K₁ C_z) -
        normLM F hLM₁' (traceLM F hM₁'K₁ (C : K₁)))) = 1 :=
by
  classical
  intro z C_z
  set T : ℕ := condExp F L νE'
  set d_T : ℕ := T / 2
  set r_T : ℕ := (T + 1) / 2
  have hd_T_ge1 : 1 ≤ d_T := by omega
  have hr_T_eq : r_T = d_T + 1 := by omega
  have hT_eq : (r_T : ℤ) + (d_T : ℤ) = (T : ℤ) := by omega
  have h2d_T_sub_T : 2 * (d_T : ℤ) - (T : ℤ) ≤ 0 := by omega
  have h2r_T_sub_T : 2 * (r_T : ℤ) - (T : ℤ) ≤ (d_T : ℤ) := by omega
  have hdegLM₁'_2 : Module.finrank L (IntermediateField.extendScalars hLM₁') = 2 :=
    hdegM₁'.trans hdeg2
  have hdegM₁'K₁_2 : Module.finrank M₁' (IntermediateField.extendScalars hM₁'K₁) = 2 :=
    hdegM₁'K₁.trans hdeg2
  rcases hvalL_props with
    ⟨hvalL_0, hvalL_1, hvalL_neg1, hvalL_neg, hvalL_mul, hvalL_inv,
      _, hvalL_add, _, _, _⟩
  rcases hvalE'_props with
    ⟨hvalE'_0, hvalE'_1, hvalE'_neg1, hvalE'_neg, hvalE'_mul, hvalE'_inv,
      _, hvalE'_add, _, _, _⟩
  let PL : ℤ → L → Prop := fun k a => a = 0 ∨ k ≤ valL F L a
  let PE' : ℤ → E' → Prop := fun k y => y = 0 ∨ k ≤ valL F E' y
  have hPL_mono : ∀ {k₁ k₂ : ℤ}, k₁ ≤ k₂ → ∀ {a : L}, PL k₂ a → PL k₁ a := by
    intro k₁ k₂ hk a ha
    rcases ha with rfl | ha
    · exact Or.inl rfl
    · exact Or.inr (by omega)
  have hPL_neg : ∀ {k : ℤ} {a : L}, PL k a → PL k (-a) := by
    intro k a ha
    rcases ha with rfl | ha
    · left; simp
    · right; rw [hvalL_neg]; exact ha
  have hPL_add : ∀ {k : ℤ} {a b : L}, PL k a → PL k b → PL k (a + b) :=
    fun {k} {a} {b} ha hb => hvalL_add k a b ha hb
  have hPL_sub : ∀ {k : ℤ} {a b : L}, PL k a → PL k b → PL k (a - b) := by
    intro k a b ha hb
    rw [sub_eq_add_neg]
    exact hPL_add ha (hPL_neg hb)
  have hPL_mul : ∀ {k₁ k₂ : ℤ} {a b : L}, PL k₁ a → PL k₂ b → PL (k₁ + k₂) (a * b) := by
    intro k₁ k₂ a b ha hb
    by_cases ha0 : a = 0
    · left; rw [ha0, zero_mul]
    · by_cases hb0 : b = 0
      · left; rw [hb0, mul_zero]
      · right
        rw [hvalL_mul a b ha0 hb0]
        have h1 := ha.resolve_left ha0
        have h2 := hb.resolve_left hb0
        omega
  have hPL_mul0_left : ∀ {k : ℤ} {a b : L}, PL 0 a → PL k b → PL k (a * b) := by
    intro k a b ha hb
    have h := hPL_mul ha hb
    rwa [zero_add] at h
  have hPE'_mul : ∀ {k₁ k₂ : ℤ} {y₁ y₂ : E'}, PE' k₁ y₁ → PE' k₂ y₂ → PE' (k₁ + k₂) (y₁ * y₂) := by
    intro k₁ k₂ y₁ y₂ hy₁ hy₂
    by_cases h1 : y₁ = 0
    · left; rw [h1, zero_mul]
    · by_cases h2 : y₂ = 0
      · left; rw [h2, mul_zero]
      · right
        rw [hvalE'_mul y₁ y₂ h1 h2]
        have hle₁ := hy₁.resolve_left h1
        have hle₂ := hy₂.resolve_left h2
        omega
  set b_x : L := traceLM F hLE' x
  set t_δ : L := traceLM F hLE' (δ_E : E')
  set t_xδ : L := traceLM F hLE' (x * (δ_E : E'))
  have hb_x_PdT : PL (d_T : ℤ) b_x :=
    htr_bound_LE' (d_T : ℤ) x (hx_int.imp id (fun h => by omega))
  have hb_x_P0 : PL 0 b_x := hPL_mono (by omega) hb_x_PdT
  have hδ_E_PdT : PE' (d_T : ℤ) (δ_E : E') := Or.inr (by omega)
  have ht_δ_PrT : PL (r_T : ℤ) t_δ :=
    htr_bound_LE' (r_T : ℤ) (δ_E : E') (hδ_E_PdT.imp id (fun h => by omega))
  have hxδ_PdT : PE' (d_T : ℤ) (x * (δ_E : E')) := by
    have h := hPE'_mul hx_int hδ_E_PdT
    rwa [zero_add] at h
  have ht_xδ_PrT : PL (r_T : ℤ) t_xδ :=
    htr_bound_LE' (r_T : ℤ) (x * (δ_E : E')) (hxδ_PdT.imp id (fun h => by omega))
  have htr_smul : ∀ (M₀ M₂ : IntermediateField F (AlgebraicClosure F))
      [FiniteDimensional F M₀] [FiniteDimensional F M₂] (hM₀M₂ : M₀ ≤ M₂)
      (a : M₀) (w : M₂),
      traceLM F hM₀M₂ (IntermediateField.inclusion hM₀M₂ a * w) =
        a * traceLM F hM₀M₂ w := by
    intro M₀ M₂ _ _ hM₀M₂ a w
    letI : Module M₀ M₀ := Semiring.toModule
    exact (Algebra.trace M₀ (IntermediateField.extendScalars hM₀M₂)).map_smul' a
      (toExtendScalars F hM₀M₂ w)
  have htr_C : traceLM F hM₁'K₁ (C : K₁) =
      IntermediateField.inclusion hLM₁' b_x +
        IntermediateField.inclusion hLM₁' (2 : L) * d := by
    rw [hC_eq, map_add, (hDiamond_E' x).2,
      (hQuadNorm M₁' K₁ hM₁'K₁ hdegM₁'K₁_2).1 d, map_ofNat]
  set δ₁ : L := r₁ * t_xδ + c * r₂ * t_δ
  set δ₂ : L := r₁ * t_δ + r₂ * t_xδ + r₂ * t_δ
  have hCz_decomp : C_z = (C : K₁) +
      IntermediateField.inclusion hM₁'K₁ z *
        IntermediateField.inclusion hE'K₁ (x * (δ_E : E')) +
      IntermediateField.inclusion hM₁'K₁ (d * z) *
        IntermediateField.inclusion hE'K₁ (δ_E : E') := by
    dsimp only [C_z]
    rw [hC_eq]
    simp only [map_mul]
    ring
  have htr_Cz : traceLM F hM₁'K₁ C_z =
      IntermediateField.inclusion hLM₁' (b_x + δ₁) +
        IntermediateField.inclusion hLM₁' ((2 : L) + δ₂) * d := by
    rw [hCz_decomp, map_add, map_add, htr_C,
      htr_smul M₁' K₁ hM₁'K₁ z (IntermediateField.inclusion hE'K₁ (x * (δ_E : E'))),
      htr_smul M₁' K₁ hM₁'K₁ (d * z) (IntermediateField.inclusion hE'K₁ (δ_E : E')),
      (hDiamond_E' (x * (δ_E : E'))).2, (hDiamond_E' (δ_E : E')).2]
    dsimp only [b_x, t_δ, t_xδ, z, δ₁, δ₂]
    simp only [map_add, map_mul, map_ofNat]
    linear_combination
      (IntermediateField.inclusion hLM₁' r₂ * IntermediateField.inclusion hLM₁' t_δ) * hd_sq
  have hnorm_zero_LM₁' : normLM F hLM₁' 0 = 0 := by
    have h1 := ((hQuadNorm L M₁' hLM₁' hdegLM₁'_2).2 1 0).1
    rw [map_one, add_zero, map_one, map_zero] at h1
    linear_combination -h1
  have hnorm_incl_LM₁' : ∀ a : L,
      normLM F hLM₁' (IntermediateField.inclusion hLM₁' a) = a ^ 2 := by
    intro a
    have h1 := ((hQuadNorm L M₁' hLM₁' hdegLM₁'_2).2 a 0).1
    rw [add_zero, map_zero, hnorm_zero_LM₁', mul_zero, add_zero, add_zero] at h1
    exact h1
  have hnorm_basis : ∀ u₀ u₁ : L,
      normLM F hLM₁' (IntermediateField.inclusion hLM₁' u₀ +
        IntermediateField.inclusion hLM₁' u₁ * d) =
      u₀ ^ 2 + u₀ * u₁ - c * u₁ ^ 2 := by
    intro u₀ u₁
    have hq := ((hQuadNorm L M₁' hLM₁' hdegLM₁'_2).2 u₀
      (IntermediateField.inclusion hLM₁' u₁ * d)).1
    rw [hq, htr_smul L M₁' hLM₁' u₁ d, hd_tr, mul_one,
      map_mul, hnorm_incl_LM₁' u₁, hd_norm]
    ring
  set Δ₄ : L := normLM F hLM₁' (traceLM F hM₁'K₁ C_z) -
    normLM F hLM₁' (traceLM F hM₁'K₁ (C : K₁))
  set F₁ : L := (2 : L) * b_x + δ₁ + (2 : L) + δ₂
  set F₂ : L := b_x - (2 : L) * (c * (2 : L)) - c * δ₂
  have hΔ₄_eq : Δ₄ = δ₁ * F₁ + δ₂ * F₂ := by
    dsimp only [Δ₄, F₁, F₂]
    rw [htr_Cz, htr_C, hnorm_basis (b_x + δ₁) ((2 : L) + δ₂), hnorm_basis b_x (2 : L)]
    ring
  have hc_P0 : PL 0 c := Or.inr (by omega)
  have h2_PdT : PL (d_T : ℤ) (2 : L) := h2_val
  have h2_P0 : PL 0 (2 : L) := hPL_mono (by omega) h2_PdT
  have hδ₁_PrT : PL (r_T : ℤ) δ₁ :=
    hPL_add (hPL_mul0_left hr₁_int ht_xδ_PrT)
      (hPL_mul0_left (hPL_mul0_left hc_P0 hr₂_int) ht_δ_PrT)
  have hδ₂_PrT : PL (r_T : ℤ) δ₂ :=
    hPL_add
      (hPL_add (hPL_mul0_left hr₁_int ht_δ_PrT) (hPL_mul0_left hr₂_int ht_xδ_PrT))
      (hPL_mul0_left hr₂_int ht_δ_PrT)
  have hδ₁_PdT : PL (d_T : ℤ) δ₁ := hPL_mono (by omega) hδ₁_PrT
  have hδ₂_PdT : PL (d_T : ℤ) δ₂ := hPL_mono (by omega) hδ₂_PrT
  have hF₁_PdT : PL (d_T : ℤ) F₁ :=
    hPL_add (hPL_add (hPL_add (hPL_mul0_left h2_P0 hb_x_PdT) hδ₁_PdT) h2_PdT) hδ₂_PdT
  have hF₂_PdT : PL (d_T : ℤ) F₂ :=
    hPL_sub
      (hPL_sub hb_x_PdT (hPL_mul0_left h2_P0 (hPL_mul0_left hc_P0 h2_PdT)))
      (hPL_mul0_left hc_P0 hδ₂_PdT)
  have hΔ₄_PT : PL (T : ℤ) Δ₄ := by
    rw [hΔ₄_eq, ← hT_eq]
    exact hPL_add (hPL_mul hδ₁_PrT hF₁_PdT) (hPL_mul hδ₂_PrT hF₂_PdT)
  have hc_ν_inv_P : PL (-((T : ℤ) + condExpChar F L ψ)) ((c_ν⁻¹ : Lˣ) : L) := by
    right
    rw [hvalL_inv c_ν, hc_ν_val]
  have h_arg_P : PL (-condExpChar F L ψ) (((c_ν⁻¹ : Lˣ) : L) * Δ₄) :=
    hPL_mono (by omega) (hPL_mul hc_ν_inv_P hΔ₄_PT)
