        have hid :
            v_wt + - 3 * (p : ℤ) * (p : ℤ) * (m : ℤ) +
                (4 * (p : ℤ) * (p : ℤ) * (m₁ : ℤ) + 2 * (p : ℤ) * (p : ℤ) * (m : ℤ) -
                  ((p - 1 : ℕ) : ℤ) * (t₁ : ℤ)) - K =
              (a_p + 1) * a_pm + a_p + (8 * a_p ^ 2 + 47 * a_p + 68) * (t₁ : ℤ) +
                (4 * (p : ℤ) ^ 2 + a_p + 1) * (p : ℤ) * a_d + 4 * (p : ℤ) ^ 2 := by
          dsimp [v_wt]
