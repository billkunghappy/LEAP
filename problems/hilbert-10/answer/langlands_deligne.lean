            (σ (τ x) - τ (σ x) = 0 ∨ (1 : ℤ) ≤ v (σ (τ x) - τ (σ x)))) ∧
        (∀ x : E, (x = 0 ∨ 0 ≤ v x) →
          ∃ s : E, (s = 0 ∨ 0 ≤ v s) ∧
            (x - s ^ p₀ = 0 ∨ (1 : ℤ) ≤ v (x - s ^ p₀))) ∧
        (∀ a d : E, (a = 0 ∨ 0 ≤ v a) → (d = 0 ∨ (1 : ℤ) ≤ v d) →
          ((a + d) ^ p₀ - a ^ p₀ = 0 ∨ (2 : ℤ) ≤ v ((a + d) ^ p₀ - a ^ p₀))) ∧
        (∀ (α : Type u) [Fintype α] (m : ℕ), 0 < m →
          ∀ u : α → E,
            (∀ a : α, u a = 0 ∨ 0 ≤ v (u a)) →
            (∀ a : α, (u a) ^ m - 1 = 0 ∨ (1 : ℤ) ≤ v ((u a) ^ m - 1)) →
            (∀ a₁ a₂ : α, (u a₁ - u a₂ = 0 ∨ (1 : ℤ) ≤ v (u a₁ - u a₂)) → a₁ = a₂) →
            Fintype.card α ≤ m) ∧
        (∀ ℓ : ℕ, Nat.Prime ℓ → ℓ ≠ p₀ →
          ∃ inv_ℓ : E, (inv_ℓ = 0 ∨ 0 ≤ v inv_ℓ) ∧ inv_ℓ * (ℓ : E) = 1) := by
    clear! F L K C H
    intro E _ v p₀ hp _ hv1 hv_neg hv_mul hv_inv hv_add hP_p S₁ hS₁
    let P : ℤ → E → Prop := fun k x => x = 0 ∨ k ≤ v x
    have hP_map : ∀ (k : ℤ) (φ : E →+* E), (∀ x : E, v (φ x) = v x) →
        ∀ x : E, P k (φ x) ↔ P k x := by
      intro k φ hφ x
      dsimp [P]
      rw [map_eq_zero, hφ x]
    have hP_zero : ∀ k : ℤ, P k 0 := fun _ => Or.inl rfl
    have hP_one : P 0 1 := Or.inr (by omega)
    have hP_neg : ∀ (k : ℤ) {x : E}, P k x → P k (-x) := by
      intro k x hx
      rcases hx with rfl | hx
      · left; exact neg_zero
      · right; rw [hv_neg]; exact hx
    have hP_add : ∀ (k : ℤ) {x y : E}, P k x → P k y → P k (x + y) :=
      fun k {x y} hx hy => hv_add k x y hx hy
    have hP_sub : ∀ (k : ℤ) {x y : E}, P k x → P k y → P k (x - y) := by
      intro k x y hx hy
      rw [sub_eq_add_neg]
      exact hP_add k hx (hP_neg k hy)
    have hP_mul : ∀ {k₁ k₂ : ℤ} {x y : E}, P k₁ x → P k₂ y → P (k₁ + k₂) (x * y) := by
      intro k₁ k₂ x y hx hy
      by_cases hx0 : x = 0
      · left; rw [hx0, zero_mul]
      · by_cases hy0 : y = 0
        · left; rw [hy0, mul_zero]
        · right
          have hx' : k₁ ≤ v x := hx.resolve_left hx0
          have hy' : k₂ ≤ v y := hy.resolve_left hy0
          rw [hv_mul x y hx0 hy0]
          omega
    have hP_mono : ∀ {k₁ k₂ : ℤ} {x : E}, k₁ ≤ k₂ → P k₂ x → P k₁ x := by
      intro k₁ k₂ x hle hx
      rcases hx with rfl | hx
      · exact Or.inl rfl
      · exact Or.inr (le_trans hle hx)
    have hP_pow : ∀ (n : ℕ) {x : E}, P 0 x → P 0 (x ^ n) := by
      intro n x hx
      induction n with
      | zero =>
        rw [pow_zero]
        exact hP_one
      | succ n ih =>
        rw [pow_succ]
        simpa using hP_mul ih hx
    have hP_natCast : ∀ n : ℕ, P 0 (n : E) := by
      intro n
      induction n with
      | zero =>
        rw [Nat.cast_zero]
        exact hP_zero 0
      | succ n ih =>
        rw [Nat.cast_succ]
        exact hP_add 0 ih hP_one
    have hP_intCast : ∀ z : ℤ, P 0 (z : E) := by
      intro z
      cases z with
      | ofNat n =>
        rw [Int.ofNat_eq_coe, Int.cast_natCast]
        exact hP_natCast n
      | negSucc n =>
        rw [Int.cast_negSucc]
        exact hP_neg 0 (hP_natCast (n + 1))
    let O_E : Subring E :=
      { carrier := {x : E | P 0 x}
        mul_mem' := fun {a b} ha hb => by simpa using hP_mul ha hb
        one_mem' := hP_one
        add_mem' := fun {a b} ha hb => hP_add 0 ha hb
        zero_mem' := hP_zero 0
        neg_mem' := fun {a} ha => hP_neg 0 ha }
    let P_E : Ideal O_E :=
      { carrier := {x : O_E | P 1 x.1}
        add_mem' := fun {a b} ha hb => hP_add 1 ha hb
        zero_mem' := hP_zero 1
        smul_mem' := fun c {x} hx => by
          change P 1 (c.1 * x.1)
          simpa using hP_mul c.2 hx }
    haveI : P_E.IsMaximal := by
      rw [Ideal.isMaximal_iff]
      refine ⟨?_, ?_⟩
      · intro h1
        change (1 : E) = 0 ∨ (1 : ℤ) ≤ v 1 at h1
        rcases h1 with h10 | h1_le
        · exact one_ne_zero h10
        · rw [hv1] at h1_le
          omega
      · intro J x _ hxP hxJ
        change ¬ ((x.1 : E) = 0 ∨ (1 : ℤ) ≤ v x.1) at hxP
        push_neg at hxP
        rcases hxP with ⟨hx_ne, hx_lt⟩
        have hx_ge : (0 : ℤ) ≤ v x.1 := x.2.resolve_left hx_ne
        have hx_val0 : v x.1 = 0 := by omega
        let u : Eˣ := Units.mk0 x.1 hx_ne
        have hu_inv_val : v ((u⁻¹ : Eˣ) : E) = 0 := by
          rw [hv_inv u, Units.val_mk0, hx_val0, neg_zero]
        let y : O_E := ⟨((u⁻¹ : Eˣ) : E), Or.inr (by omega)⟩
        have hyx : y * x = 1 := by
          apply Subtype.ext
          exact Units.inv_mul u
        rw [← hyx]
        exact J.mul_mem_left y hxJ
    let k_E := O_E ⧸ P_E
    letI : Field k_E := Ideal.Quotient.field P_E
    let f_S : S₁ → k_E := fun s =>
      if hs : P 0 s.1 then Ideal.Quotient.mk P_E ⟨s.1, hs⟩ else 0
    have hf_surj : Function.Surjective f_S := by
      intro q
      refine Quotient.inductionOn' q fun x => ?_
      obtain ⟨s, hs_mem, hxs⟩ := hS₁ x.1 x.2
      have hs_P0 : P 0 s := by
        have h1 : P 0 (x.1 - (x.1 - s)) := hP_sub 0 x.2 (hP_mono (by omega) hxs)
        rwa [sub_sub_cancel] at h1
      refine ⟨⟨s, hs_mem⟩, ?_⟩
      dsimp [f_S]
      rw [dif_pos hs_P0]
      change Ideal.Quotient.mk P_E ⟨s, hs_P0⟩ = Ideal.Quotient.mk P_E x
      rw [Ideal.Quotient.eq]
      change P 1 (s - x.1)
      have hneg : P 1 (-(x.1 - s)) := hP_neg 1 hxs
      rwa [neg_sub] at hneg
    haveI : Finite k_E := Finite.of_surjective f_S hf_surj
    haveI : Finite k_Eˣ := Finite.of_injective (Units.val : k_Eˣ → k_E) (fun _ _ h => Units.ext h)
    let σ_O : ∀ (σ : E →+* E), (∀ x : E, v (σ x) = v x) → (O_E →+* O_E) := fun σ hσ =>
      { toFun := fun x => ⟨σ x.1, (hP_map 0 σ hσ x.1).mpr x.2⟩
        map_one' := Subtype.ext (map_one σ)
        map_mul' := fun x y => Subtype.ext (map_mul σ x.1 y.1)
        map_zero' := Subtype.ext (map_zero σ)
        map_add' := fun x y => Subtype.ext (map_add σ x.1 y.1) }
    let res_end : ∀ (σ : E →+* E), (∀ x : E, v (σ x) = v x) → (k_E →+* k_E) := fun σ hσ =>
      Ideal.Quotient.lift P_E ((Ideal.Quotient.mk P_E).comp (σ_O σ hσ)) (by
        intro x hx
        change Ideal.Quotient.mk P_E (σ_O σ hσ x) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem]
        exact (hP_map 1 σ hσ x.1).mpr hx)
    obtain ⟨g₀, hg₀⟩ := IsCyclic.exists_monoid_generator (α := k_Eˣ)
    have h_pow_gen : ∀ w : k_E, w ≠ 0 → ∃ m : ℕ, w = (g₀ : k_E) ^ m := by
      intro w hw
      obtain ⟨m, hm⟩ := hg₀ (Units.mk0 w hw)
      exact ⟨m, (congrArg Units.val hm).symm⟩
    have h_res_comm : ∀ (σ τ : E →+* E) (hσ : ∀ x : E, v (σ x) = v x)
        (hτ : ∀ x : E, v (τ x) = v x) (x : E),
        P 0 x → P 1 (σ (τ x) - τ (σ x)) := by
      intro σ τ hσ hτ x hx
      have hg₀_ne : (g₀ : k_E) ≠ 0 := Units.ne_zero g₀
      have hσg_ne : res_end σ hσ (g₀ : k_E) ≠ 0 :=
        (map_ne_zero (res_end σ hσ)).mpr hg₀_ne
      have hτg_ne : res_end τ hτ (g₀ : k_E) ≠ 0 :=
        (map_ne_zero (res_end τ hτ)).mpr hg₀_ne
      obtain ⟨j, hj⟩ := h_pow_gen (res_end σ hσ (g₀ : k_E)) hσg_ne
      obtain ⟨k, hk⟩ := h_pow_gen (res_end τ hτ (g₀ : k_E)) hτg_ne
      set q : k_E := Ideal.Quotient.mk P_E ⟨x, hx⟩
      have hq_comm : res_end σ hσ (res_end τ hτ q) = res_end τ hτ (res_end σ hσ q) := by
        by_cases hq0 : q = 0
        · simp [hq0]
        · obtain ⟨m, hm⟩ := h_pow_gen q hq0
          rw [hm, map_pow, hk, ← pow_mul, map_pow, hj, ← pow_mul,
            map_pow, hj, ← pow_mul, map_pow, hk, ← pow_mul]
          congr 1
          ring
      change Ideal.Quotient.mk P_E ⟨σ (τ x), _⟩ = Ideal.Quotient.mk P_E ⟨τ (σ x), _⟩ at hq_comm
      exact Ideal.Quotient.eq.mp hq_comm
    have hP_sum : ∀ (S : Finset ℕ) (f : ℕ → E) (k : ℤ),
        (∀ i ∈ S, P k (f i)) → P k (∑ i ∈ S, f i) := by
      intro S f k hS
      induction S using Finset.induction_on with
      | empty =>
        rw [Finset.sum_empty]
        exact hP_zero k
      | @insert a s ha ih =>
        rw [Finset.sum_insert ha]
        exact hP_add k (hS a (Finset.mem_insert_self a s))
          (ih (fun i hi => hS i (Finset.mem_insert_of_mem hi)))
    have h_pow_diff : ∀ a d : E, P 0 a → P 1 d →
        P 2 ((a + d) ^ p₀ - a ^ p₀) := by
      intro a d ha hd
      have h_exp : (a + d) ^ p₀ - a ^ p₀ =
          ∑ m ∈ Finset.range p₀, a ^ m * d ^ (p₀ - m) * (p₀.choose m : E) := by
        have h1 := add_pow a d p₀
        rw [Finset.sum_range_succ] at h1
        simp only [Nat.sub_self, pow_zero, mul_one, Nat.choose_self, Nat.cast_one] at h1
        linear_combination h1
      rw [h_exp]
      apply hP_sum (Finset.range p₀) _ 2
      intro m hm
      rw [Finset.mem_range] at hm
      by_cases hm0 : m = 0
      · subst hm0
        simp only [pow_zero, one_mul, Nat.sub_zero, Nat.choose_zero_right, Nat.cast_one, mul_one]
        have hp2 : 2 ≤ p₀ := hp.two_le
        have hsplit : p₀ = (p₀ - 2) + 2 := by omega
        rw [hsplit, pow_add, sq]
        have hd0 : P 0 d := hP_mono (by omega) hd
        have h1 : P 0 (d ^ (p₀ - 2)) := hP_pow (p₀ - 2) hd0
        have h2 : P (1 + 1) (d * d) := hP_mul hd hd
        simpa using hP_mul h1 h2
      · have hd0 : P 0 d := hP_mono (by omega) hd
        have h_am : P 0 (a ^ m) := hP_pow m ha
        have hsplit_d : p₀ - m = (p₀ - m - 1) + 1 := by omega
        have h_dm : P 1 (d ^ (p₀ - m)) := by
          rw [hsplit_d, pow_add, pow_one]
          simpa using hP_mul (hP_pow (p₀ - m - 1) hd0) hd
        have hdvd : p₀ ∣ p₀.choose m := Nat.Prime.dvd_choose_self hp hm0 hm
        rcases hdvd with ⟨c, hc⟩
        have h_ch : P 1 ((p₀.choose m : ℕ) : E) := by
          rw [hc, Nat.cast_mul]
          simpa using hP_mul hP_p (hP_natCast c)
        have h_prod1 : P (0 + 1) (a ^ m * d ^ (p₀ - m)) := hP_mul h_am h_dm
        simpa using hP_mul h_prod1 h_ch
    have hp_kE : (p₀ : k_E) = 0 := by
      have hmk : (p₀ : k_E) = Ideal.Quotient.mk P_E (p₀ : O_E) :=
        (map_natCast (Ideal.Quotient.mk P_E) p₀).symm
      rw [hmk, Ideal.Quotient.eq_zero_iff_mem]
      change P 1 ((p₀ : O_E) : E)
      simpa using hP_p
    have hfrob_inj : Function.Injective (fun z : k_E => z ^ p₀) := by
      intro z₁ z₂ hz
      change z₁ ^ p₀ = z₂ ^ p₀ at hz
      set d : k_E := z₁ - z₂
      have hz₁_eq : z₁ = z₂ + d := by dsimp [d]; ring
      have h_exp : (z₂ + d) ^ p₀ =
          (∑ m ∈ Finset.range p₀, z₂ ^ m * d ^ (p₀ - m) * (p₀.choose m : k_E)) +
            z₂ ^ p₀ := by
        have h1 := add_pow z₂ d p₀
        rw [Finset.sum_range_succ] at h1
        simp only [Nat.sub_self, pow_zero, mul_one, Nat.choose_self, Nat.cast_one] at h1
        exact h1
      have h_sum_single :
          (∑ m ∈ Finset.range p₀, z₂ ^ m * d ^ (p₀ - m) * (p₀.choose m : k_E)) =
            d ^ p₀ := by
        have h0 : (∑ m ∈ Finset.range p₀, z₂ ^ m * d ^ (p₀ - m) * (p₀.choose m : k_E)) =
            z₂ ^ 0 * d ^ (p₀ - 0) * (p₀.choose 0 : k_E) := by
          refine Finset.sum_eq_single 0 ?_ ?_
          · intro m hm hm0
            rw [Finset.mem_range] at hm
            have hdvd : p₀ ∣ p₀.choose m := Nat.Prime.dvd_choose_self hp hm0 hm
            rcases hdvd with ⟨c, hc⟩
            have hch0 : (p₀.choose m : k_E) = 0 := by
              rw [hc, Nat.cast_mul, hp_kE, zero_mul]
            rw [hch0, mul_zero]
          · intro hnot
            exact False.elim (hnot (Finset.mem_range.mpr hp.pos))
        simpa using h0
      have hd_pow : d ^ p₀ = 0 := by
        rw [hz₁_eq, h_exp, h_sum_single] at hz
        linear_combination hz
      have hd0 : d = 0 := eq_zero_of_pow_eq_zero hd_pow
      exact sub_eq_zero.mp hd0
    have hfrob_surj_kE : Function.Surjective (fun z : k_E => z ^ p₀) :=
      Finite.surjective_of_injective hfrob_inj
    have h_frob_surj : ∀ x : E, P 0 x →
        ∃ s : E, P 0 s ∧ P 1 (x - s ^ p₀) := by
      intro x hx
      obtain ⟨z, hz⟩ := hfrob_surj_kE (Ideal.Quotient.mk P_E ⟨x, hx⟩)
      refine Quotient.inductionOn' z (fun s_O hs_O => ?_) hz
      refine ⟨s_O.1, s_O.2, ?_⟩
      change (Ideal.Quotient.mk P_E s_O) ^ p₀ = Ideal.Quotient.mk P_E ⟨x, hx⟩ at hs_O
      rw [← map_pow] at hs_O
      have hdiff : P 1 ((s_O ^ p₀).1 - x) := Ideal.Quotient.eq.mp hs_O
      have hneg : P 1 (-((s_O ^ p₀).1 - x)) := hP_neg 1 hdiff
      have hval_pow : (s_O ^ p₀).1 = s_O.1 ^ p₀ := O_E.coe_pow s_O p₀
      rw [hval_pow, neg_sub] at hneg
      exact hneg
    have h_roots_bound : ∀ (α : Type u) [Fintype α] (m : ℕ), 0 < m →
        ∀ u : α → E,
          (∀ a : α, P 0 (u a)) →
          (∀ a : α, P 1 ((u a) ^ m - 1)) →
          (∀ a₁ a₂ : α, P 1 (u a₁ - u a₂) → a₁ = a₂) →
          Fintype.card α ≤ m := by
      intro α _ m hm_pos u hu0 hu_pow hu_inj
      let q : α → k_E := fun a => Ideal.Quotient.mk P_E ⟨u a, hu0 a⟩
      have hq_inj : Function.Injective q := by
        intro a₁ a₂ hq
        have hdiff : P 1 (u a₁ - u a₂) := Ideal.Quotient.eq.mp hq
        exact hu_inj a₁ a₂ hdiff
      let f_poly : Polynomial k_E := Polynomial.X ^ m - Polynomial.C 1
      have hf_ne : f_poly ≠ 0 := Polynomial.X_pow_sub_C_ne_zero hm_pos (1 : k_E)
      have hf_deg : f_poly.natDegree = m := Polynomial.natDegree_X_pow_sub_C
      have hq_mem : ∀ a : α, q a ∈ f_poly.roots.toFinset := by
        intro a
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hf_ne, Polynomial.IsRoot.def]
        dsimp [f_poly]
        rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C]
        change (Ideal.Quotient.mk P_E ⟨u a, hu0 a⟩) ^ m - 1 = 0
        have hmk : (Ideal.Quotient.mk P_E ⟨u a, hu0 a⟩) ^ m - 1 =
            Ideal.Quotient.mk P_E ⟨(u a) ^ m - 1, hP_sub 0 (hP_pow m (hu0 a)) hP_one⟩ := by
          rw [← map_pow, ← map_one (Ideal.Quotient.mk P_E), ← map_sub]
          rfl
        rw [hmk, Ideal.Quotient.eq_zero_iff_mem]
        exact hu_pow a
      let q_sub : α → f_poly.roots.toFinset := fun a => ⟨q a, hq_mem a⟩
      have hq_sub_inj : Function.Injective q_sub :=
        fun a₁ a₂ h => hq_inj (congrArg Subtype.val h)
      calc Fintype.card α ≤ Fintype.card f_poly.roots.toFinset :=
            Fintype.card_le_of_injective q_sub hq_sub_inj
        _ = f_poly.roots.toFinset.card := Fintype.card_coe _
        _ ≤ f_poly.roots.card := Multiset.toFinset_card_le _
        _ ≤ f_poly.natDegree := Polynomial.card_roots' f_poly
        _ = m := hf_deg
    have h_inv_ℓ : ∀ ℓ : ℕ, Nat.Prime ℓ → ℓ ≠ p₀ →
        ∃ inv_ℓ : E, P 0 inv_ℓ ∧ inv_ℓ * (ℓ : E) = 1 := by
      intro ℓ hPrime_ℓ hℓ_ne_p
      have h_ndvd : ¬ (ℓ ∣ p₀) := by
        intro hdvd
        have heq := ((Nat.dvd_prime hp).mp hdvd).resolve_left hPrime_ℓ.ne_one
        exact hℓ_ne_p heq
      have hcop : Nat.Coprime ℓ p₀ := (Nat.Prime.coprime_iff_not_dvd hPrime_ℓ).mpr h_ndvd
      have hbez_Z : (1 : ℤ) = (ℓ : ℤ) * ℓ.gcdA p₀ + (p₀ : ℤ) * ℓ.gcdB p₀ := by
        have h1 := Nat.gcd_eq_gcd_ab ℓ p₀
        rw [hcop.gcd_eq_one, Nat.cast_one] at h1
        exact h1
      have hbez_E : (1 : E) = (ℓ : E) * (ℓ.gcdA p₀ : E) + (p₀ : E) * (ℓ.gcdB p₀ : E) := by
        have h1 := congrArg (Int.cast : ℤ → E) hbez_Z
        push_cast at h1
        exact h1
      have h_not_P1 : ¬ P 1 (ℓ : E) := by
        intro hP1_ℓ
        have ht1 : P (1 + 0) ((ℓ : E) * (ℓ.gcdA p₀ : E)) :=
          hP_mul hP1_ℓ (hP_intCast (ℓ.gcdA p₀))
        have ht2 : P (1 + 0) ((p₀ : E) * (ℓ.gcdB p₀ : E)) :=
          hP_mul hP_p (hP_intCast (ℓ.gcdB p₀))
        have hsum : P 1 ((ℓ : E) * (ℓ.gcdA p₀ : E) + (p₀ : E) * (ℓ.gcdB p₀ : E)) :=
          hP_add 1 (by simpa using ht1) (by simpa using ht2)
        rw [← hbez_E] at hsum
        rcases hsum with h10 | h1_le
        · exact one_ne_zero h10
        · rw [hv1] at h1_le
          omega
      change ¬ ((ℓ : E) = 0 ∨ (1 : ℤ) ≤ v (ℓ : E)) at h_not_P1
      push_neg at h_not_P1
      rcases h_not_P1 with ⟨hℓ_ne0, hℓ_lt1⟩
      have hℓ_ge0 : (0 : ℤ) ≤ v (ℓ : E) := (hP_natCast ℓ).resolve_left hℓ_ne0
      have hℓ_val0 : v (ℓ : E) = 0 := by omega
      let u_ℓ : Eˣ := Units.mk0 (ℓ : E) hℓ_ne0
      set inv_ℓ : E := ((u_ℓ⁻¹ : Eˣ) : E)
      have hinv_val0 : v inv_ℓ = 0 := by
        dsimp [inv_ℓ]
        rw [hv_inv u_ℓ, Units.val_mk0, hℓ_val0, neg_zero]
      refine ⟨inv_ℓ, Or.inr (by omega), ?_⟩
      exact_mod_cast Units.inv_mul u_ℓ
    exact ⟨h_res_comm, h_frob_surj, h_pow_diff, h_roots_bound, h_inv_ℓ⟩
  let K' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars hLK
  let G := (K' ≃ₐ[L] K')
  have hFinK : FiniteDimensional F K := hGal.2.1
  haveI : FiniteDimensional F K := hFinK
  haveI : FiniteDimensional F K' := hFinK
  haveI : IsScalarTower F L K' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : FiniteDimensional L K' := Module.Finite.of_restrictScalars_finite F L K'
  letI : Fintype G := AlgEquiv.fintype L K'
