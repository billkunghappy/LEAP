          ∏ j ∈ (Finset.range ℓ).erase 0, (((p.digits (j * h)).map Nat.factorial).prod : k_M) := by
    have h_a_star_prod :
        (((p.digits a_star).map Nat.factorial).prod : k_M) =
          ∏ j ∈ Finset.range ℓ, (((p.digits (γ j)).map Nat.factorial).prod : k_M) := by
      rw [ha_star_eq, h_block_prod, (h_perm (fun m => ((p.digits m).map Nat.factorial).prod)).2,
