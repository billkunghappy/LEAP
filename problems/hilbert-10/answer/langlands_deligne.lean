        push_cast
        ring
    let M₂' : IntermediateField L (AlgebraicClosure F) := IntermediateField.extendScalars h
    haveI : FiniteDimensional F M₂' := ‹FiniteDimensional F M₂›
    haveI : IsScalarTower F L M₂' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : FiniteDimensional L M₂' := Module.Finite.of_restrictScalars_finite F L M₂'
    have hnorm_ϖ : normLM F h (IntermediateField.inclusion h (ϖ : L)) =
