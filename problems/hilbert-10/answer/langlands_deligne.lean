        ring
      have hrem_b : ((α⁻¹ : Lˣ) : L) * δ_tr * u = 0 ∨
          -condExpChar F L ψ ≤ valL F L (((α⁻¹ : Lˣ) : L) * δ_tr * u) := by
        have hα_inv_b : ((α⁻¹ : Lˣ) : L) = 0 ∨
            -(2 * (e : ℤ) + 1 + condExpChar F L ψ) ≤ valL F L ((α⁻¹ : Lˣ) : L) := by
          right; rw [hinv α, hα_val, hT2_eq]; push_cast; omega
        have h1 := hL_mul_b _ _ _ _ hα_inv_b hδ_val
