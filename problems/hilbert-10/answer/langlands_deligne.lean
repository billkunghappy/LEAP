      h2_val x_0 hx0_int hx_x0 δ_T δ_E hδ_T_val hδ_E_val hδ_norm r₁ r₂ hr₁_int hr₂_int
  have hTraceM₁ :=
    ld_ch12_wild_dyadic_unramified_min_cond_odd_biquad_trace_M1_term F L E' M₁' K₁
      hLE' hLM₁' hE'K₁ hM₁'K₁ hdeg2 hdegM₁' hdegM₁'K₁
      ψ νE' hbE'_ge2 hT_odd htr_bound_LE' hDiamond_E'
      d c hc_val hd_tr hd_norm hd_sq c_ν x C hC_eq hx_int hc_ν_val
      hQuadNorm hvalL_props hvalE'_props hSpecL_ψ h2_val δ_E hδ_E_val r₁ r₂ hr₁_int hr₂_int
  set Δ₁ : L := traceLM F hLE' (normLM F hE'K₁ C_z) - traceLM F hLE' (normLM F hE'K₁ (C : K₁))
  set Δ₂ : L := normLM F hLE' (traceLM F hE'K₁ C_z) - normLM F hLE' (traceLM F hE'K₁ (C : K₁))
  set Δ₃ : L := traceLM F hLM₁' (normLM F hM₁'K₁ C_z) - traceLM F hLM₁' (normLM F hM₁'K₁ (C : K₁))
  set Δ₄ : L := normLM F hLM₁' (traceLM F hM₁'K₁ C_z) - normLM F hLM₁' (traceLM F hM₁'K₁ (C : K₁))
  have hBiquad_diff :
      ((c_ν⁻¹ : Lˣ) : L) * Δ₁ + ((c_ν⁻¹ : Lˣ) : L) * Δ₂ =
